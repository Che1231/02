[{"question": "\ucd08\ubcf4\uc790\ub97c \uc704\ud55c \uac8c\uc784 \ud50c\ub808\uc774 \ucd5c\uc801\ud654\ub97c \uc704\ud574 \uc5b4\ub5bb\uac8c \uacf5\uaca9 \ub85c\ubd07 \ud6c8\ub828 \uc138\ud2b8\ub97c \ub9de\ucda4 \uc124\uc815\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ucd08\ubcf4\uc790\ub97c \uc704\ud55c \uac8c\uc784 \ud50c\ub808\uc774 \ucd5c\uc801\ud654\ub97c \uc704\ud574 \uacf5\uaca9 \ub85c\ubd07 \ud6c8\ub828 \uc138\ud2b8\ub97c \ub9de\ucda4 \uc124\uc815\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. \ub2e8\uacc4 1: \ud654\ub825\uacfc \ubc29\uc5b4\ub825\uc758 \uade0\ud615\uc744 \uac16\ucd98 '\uc13c\ud2f0\ub12c'\uacfc \uac19\uc740 \uade0\ud615 \uc7a1\ud78c \ub85c\ubd07\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc0dd\uc874\ub825\uc744 \ud655\ubcf4\ud558\uae30 \uc704\ud574 \uae30\ubcf8 \uacf5\uaca9 \uc18c\ucd1d\uacfc \ubc29\ud328 \uc0dd\uc131\uae30\ub97c \uc7a5\ucc29\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ud0c0\uac9f\ud305\uc744 \ubcf4\uc870\ud558\uae30 \uc704\ud574 '\uc790\ub3d9 \uc870\uc900' \ubaa8\ub4c8\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud6c8\ub828\uc7a5' \ubbf8\uc158\uc5d0\uc11c \uc774\ub7ec\ud55c \uc124\uc815\uc744 \uac00\uc9c4 '\uc13c\ud2f0\ub12c'\uc740 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \uc774\ub3d9\uacfc \uc804\ub7b5\uc5d0 \uc9d1\uc911\ud560 \uc218 \uc788\ub3c4\ub85d \uc798 \uc218\ud589\ub418\uc5c8\uc2b5\ub2c8\ub2e4."}, {"question": "\uac8c\uc784 \uba54\ucee4\ub2c8\uc998 \uce21\uba74\uc5d0\uc11c '\uacf5\uaca9 \ub85c\ubd07'\uacfc '\uc815\ucc30 \ub85c\ubd07'\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "'\uacf5\uaca9 \ub85c\ubd07'\uacfc '\uc815\ucc30 \ub85c\ubd07'\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. 1. **\uc5ed\ud560**: \uacf5\uaca9 \ub85c\ubd07\uc740 \ub192\uc740 \ub0b4\uad6c\ub825\uc744 \uc9c0\ub2cc \uc804\ubc29 \uc804\ud22c\uc6d0\uc774\uba70, \uc815\ucc30 \ub85c\ubd07\uc740 \uc740\ubc00\uc131\uacfc \uc815\ubcf4 \uc218\uc9d1\uc5d0 \ub6f0\uc5b4\ub0a9\ub2c8\ub2e4. 2. **\uc18d\ub3c4**: \uc815\ucc30 \ub85c\ubd07\uc740 \ub354 \ube60\ub974\ubbc0\ub85c \uc815\ucc30 \uc784\ubb34\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4. 3. **\ubb34\uae30**: \uacf5\uaca9 \ub85c\ubd07\uc740 \ub85c\ucf13 \ubc1c\uc0ac\uae30\uc640 \uac19\uc740 \uc911\ud654\uae30\ub97c \uc7a5\ucc29\ud558\ub294 \ubc18\uba74, \uc815\ucc30 \ub85c\ubd07\uc740 \uc18c\uc74c\uc774 \uc801\uc740 \ubb34\uae30\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc554\uc2dc\uc7a5 \uc815\ucc30' \ubbf8\uc158\uc5d0\uc11c \uc815\ucc30 \ub85c\ubd07\uc744 \uc0ac\uc6a9\ud558\uba74 \uc801\uc758 \uc21c\ucc30\uc744 \uac10\uc9c0\ud558\uc9c0 \uc54a\uace0 \uc6b0\ud68c\ud560 \uc218 \uc788\uc5c8\uc2b5\ub2c8\ub2e4."}, {"question": "'\uc5d0\ub108\uc9c0 \uad00\ub9ac \uc2dc\uc2a4\ud15c'\uc774 \uacf5\uaca9 \ub85c\ubd07\uc5d0\uc11c \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc804\ud22c\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\uacf5\uaca9 \ub85c\ubd07\uc758 '\uc5d0\ub108\uc9c0 \uad00\ub9ac \uc2dc\uc2a4\ud15c'\uc740 \ub2a5\ub825 \ubc0f \ubb34\uae30\uc758 \uc0ac\uc6a9\uc744 \uad00\ub9ac\ud558\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc791\ub3d9 \ubc29\uc2dd\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. 1. **\uc5d0\ub108\uc9c0 \ubc30\ubd84**: \uac01 \uc791\uc5c5\uc5d0\ub294 \uc5d0\ub108\uc9c0\uac00 \uc18c\ubaa8\ub418\ubbc0\ub85c \ud544\uc694\ud560 \ub54c \ub2a5\ub825\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub3c4\ub85d \uad00\ub9ac\ud574\uc57c \ud569\ub2c8\ub2e4. 2. **\uc7ac\ucda9\uc804 \uc18d\ub3c4**: \uc7ac\ucda9\uc804 \uc18d\ub3c4\uac00 \ube60\ub97c\uc218\ub85d \ub2a5\ub825 \uc0ac\uc6a9 \ube48\ub3c4\uac00 \ub192\uc544\uc9d1\ub2c8\ub2e4. 3. **\uc804\ud22c \uc601\ud5a5**: \uc5d0\ub108\uc9c0\uac00 \ubc14\ub2e5\ub098\uba74 \uc704\ud5d8\uc5d0 \ub178\ucd9c\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc5d0\ub108\uc9c0 \uc704\uae30' \ubbf8\uc158\uc5d0\uc11c \uc800\ub294 \ubcf4\ud638\ub9c9\uc744 \ubc30\uce58\ud558\uace0 \uc911\uc694\ud55c \uc21c\uac04\uc5d0 \ud654\ub825\uc744 \ubc1c\ud718\ud558\uae30 \uc704\ud574 \ub85c\ubd07\uc758 \uc5d0\ub108\uc9c0\ub97c \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud574\uc57c \ud588\uc2b5\ub2c8\ub2e4."}, {"question": "\uacf5\uaca9 \ub85c\ubd07\uc5d0\uc11c '\uc804\uc220 \uc624\ubc84\ub808\uc774' \uae30\ub2a5\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc5ec \uc804\ub7b5\uc801 \uc6b0\uc704\ub97c \uc5bb\uc73c\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\uacf5\uaca9 \ub85c\ubd07\uc5d0\uc11c '\uc804\uc220 \uc624\ubc84\ub808\uc774' \uae30\ub2a5\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc2ed\uc2dc\uc624. \ub2e8\uacc4 1: \uc801\uc758 \uc704\uce58\uc640 \uccb4\ub825 \ud45c\uc2dc\uae30\ub97c \ubcf4\ub824\uba74 \uc624\ubc84\ub808\uc774\ub97c \ud65c\uc131\ud654\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc57d\ud55c \uc801\uc744 \ud3ec\uc704\ud558\ub294 \ub4f1 \uc790\uc2e0\uc758 \uc811\uadfc \ubc29\uc2dd\uc744 \uacc4\ud68d\ud558\ub294 \ub370 \uc815\ubcf4\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc2e4\uc2dc\uac04 \ub370\uc774\ud130\uc5d0 \ub530\ub77c \uc804\ub7b5\uc744 \uc870\uc815\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub3c4\uc2dc \uacf5\uaca9' \ubbf8\uc158\uc5d0\uc11c \uc624\ubc84\ub808\uc774\ub97c \ud1b5\ud574 \uc800\uaca9\uc218\uc758 \uc740\uc2e0\ucc98\ub97c \uc2dd\ubcc4\ud560 \uc218 \uc788\uc5c8\uace0, \uc704\ud611\uc774 \ub418\uae30 \uc804\uc5d0 \uc81c\uac70\ud560 \uc218 \uc788\uc5c8\uc2b5\ub2c8\ub2e4."}, {"question": "\uacf5\uaca9 \ub85c\ubd07\uc5d0\uc11c '\uac70\ub300 \uae09' \uc801\uc744 \ubb3c\ub9ac\uce58\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uacf5\uaca9 \ub85c\ubd07\uc5d0\uc11c '\uac70\ub300 \uae09' \uc801\uc744 \ubb3c\ub9ac\uce58\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. 1. **\uc57d\uc810**: \uba38\ub9ac\ub098 \ub4f1\uacfc \uac19\uc740 \ub178\ucd9c\ub41c \uc57d\uc810\uc744 \ubaa9\ud45c\ub85c \ud569\ub2c8\ub2e4. 2. **\ud300 \ud611\ub825**: \ud300\uc758 \ub2a5\ub825\uc744 \uc0ac\uc6a9\ud558\uc5ec \uac70\ub300 \uae09 \uc801\uc744 \uc720\uc778\ud558\uace0 \uacf5\uaca9\ud569\ub2c8\ub2e4. 3. **\uc77c\ubc1c \uc77c\ud1f4**: \ube60\ub978 \uc774\ub3d9\uc131\uc744 \ud65c\uc6a9\ud558\uc5ec \uac70\ub300 \uae09 \uc801\uc758 \uac15\ub825\ud55c \uacf5\uaca9\uc744 \ud53c\ud558\uace0 \uac74\uac15\uc744 \uae4e\uc544 \ub098\uac11\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uac70\ub300 \ub85c\ubd07 \uc804\ud22c' \ubbf8\uc158\uc5d0\uc11c \uc6b0\ub9ac \ud300\uc740 \uac70\ub300 \ub85c\ubd07\uc758 \uba38\ub9ac\uc5d0 \uc9d1\uc911\ud558\uc5ec \uce58\uba85\uc801\uc778 \ud53c\ud574\ub97c \uc785\ud788\uace0 \uadf8 \ud30c\uad34\uc801\uc778 \uc9c0\uc0c1 \uac15\uc2b5\uc744 \ud53c\ud588\uc2b5\ub2c8\ub2e4."}, {"question": "\uacf5\uaca9 \ub85c\ubd07\uc758 '\ud53c\ud574 \uc800\ud56d\ub825' \uc9c0\ud45c\uac00 \ub85c\ubd07\uc758 \uc0dd\uc874\ub825\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\uba70, \uc5b4\ub5bb\uac8c \uadf9\ub300\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uacf5\uaca9 \ub85c\ubd07\uc758 '\ud53c\ud574 \uc800\ud56d\ub825' \uc9c0\ud45c\ub294 \ub4e4\uc5b4\uc624\ub294 \ud53c\ud574\ub97c \uc904\uc5ec \uc0dd\uc874\ub825\uc5d0 \uc0c1\ub2f9\ud55c \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \ub2e4\uc74c\uc744 \uc218\ud589\ud558\uc2ed\uc2dc\uc624. 1. **\uc7a5\uac11 \uc5c5\uadf8\ub808\uc774\ub4dc**: \ub85c\ubd07\uc5d0 \ub192\uc740 \uc800\ud56d\ub825 \uc7a5\uac11\uc744 \uc7a5\ucc29\ud569\ub2c8\ub2e4. 2. **\ubc29\ud328 \ubaa8\ub4c8**: \ubc29\ud328 \uc0dd\uc131\uae30\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud53c\ud574\ub97c \ud761\uc218\ud569\ub2c8\ub2e4. 3. **\uc2a4\ud0ac \ud2b8\ub9ac**: \uc800\ud56d\ub825\uc744 \ub192\uc774\ub294 \uc2a4\ud0ac\uc5d0 \ud22c\uc790\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud3ec\uc704 \ubc29\uc5b4' \ubbf8\uc158\uc5d0\uc11c \uc800\ud56d\ub825\uc774 \ucd5c\ub300\ud654\ub41c \ub85c\ubd07\uc740 \uc801\uc758 \uc218\ucc28\ub840 \uacf5\uaca9\uc744 \uacac\ub38c\ub0b4\uace0 \ubc29\uc5b4\uc120\uc744 \uc720\uc9c0\ud560 \uc218 \uc788\uc5c8\uc2b5\ub2c8\ub2e4."}, {"question": "'\ud0c4\uc57d \uc885\ub958'\uac00 \uacf5\uaca9 \ub85c\ubd07\uc5d0\uc11c \uc5b4\ub5a4 \uc5ed\ud560\uc744 \ud558\uba70, \uc11c\ub85c \ub2e4\ub978 \uc801 \uc720\ud615\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "'\ud0c4\uc57d \uc885\ub958'\ub294 \uacf5\uaca9 \ub85c\ubd07\uc5d0\uc11c \uc11c\ub85c \ub2e4\ub978 \uc801 \uc720\ud615\uc5d0 \ub300\ud574 \ud2b9\ud654\ub41c \ud53c\ud574\ub97c \uc81c\uacf5\ud558\ub294 \uc5ed\ud560\uc744 \ud569\ub2c8\ub2e4. \uc791\ub3d9 \ubc29\uc2dd\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. 1. **\uc7a5\uac11 \uad00\ud1b5**: \uc7a5\uac11\uc774 \ub450\uaebc\uc6b4 \uc801\uc5d0\uac8c \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. 2. **\ud3ed\ubc1c**: \uc9d1\ub2e8\uc73c\ub85c \ubab0\ub824 \uc788\ub294 \uc801\uc5d0\uac8c \uc801\ud569\ud569\ub2c8\ub2e4. 3. **\uc5d0\ub108\uc9c0**: \ubc29\ud328\uac00 \uc788\ub294 \ud0c0\uac9f\uc5d0\uac8c \uac00\uc7a5 \uc88b\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud0c4\uc57d \ucc3d\uace0' \ubbf8\uc158\uc5d0\uc11c \uc7a5\uac11 \uad00\ud1b5 \ud0c4\uc57d\uc73c\ub85c \uc804\ud658\ud558\uba74 \uac11\uc637\uc744 \ucc29\uc6a9\ud55c \ub4dc\ub860 \uc9d1\ub2e8\uc744 \uc2e0\uc18d\ud558\uac8c \uc81c\uc555\ud560 \uc218 \uc788\uc5c8\uc2b5\ub2c8\ub2e4."}, {"question": "PC\uc5d0\uc11c \ucf58\uc194\ub85c \uacf5\uaca9 \ub85c\ubd07\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc774\uc804\ud560 \uc218 \uc788\uc73c\uba70, \uc5b4\ub5a4 \uc7a0\uc7ac\uc801\uc778 \ud568\uc815\uc774 \uc788\uc2b5\ub2c8\uae4c?", "answer": "PC\uc5d0\uc11c \ucf58\uc194\ub85c \uacf5\uaca9 \ub85c\ubd07\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\ub824\uba74 \ub2e4\uc74c\uc744 \uc218\ud589\ud558\uc2ed\uc2dc\uc624. 1. **\ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5**: \uc9c4\ud589 \uc0c1\ud669\uc774 \ud074\ub77c\uc6b0\ub4dc\uc5d0 \uc800\uc7a5\ub418\uc5c8\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. 2. **\uacc4\uc815 \uc5f0\uacb0**: \uac8c\uc784 \uacc4\uc815\uc744 \uc5ec\ub7ec \ud50c\ub7ab\ud3fc\uc5d0 \uc5f0\uacb0\ud569\ub2c8\ub2e4. 3. **\ub370\uc774\ud130 \ub3d9\uae30\ud654**: \uc0c8 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub370\uc774\ud130\ub97c \ub3d9\uae30\ud654\ud569\ub2c8\ub2e4. \uc7a0\uc7ac\uc801\uc778 \ud568\uc815\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. 1. **\ud638\ud658\uc131 \ubb38\uc81c**: \uc77c\ubd80 \uc544\uc774\ud15c\uc774\ub098 \uc131\ucde8\uac00 \uc774\uc804\ub418\uc9c0 \uc54a\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 2. **\uc800\uc7a5 \ud30c\uc77c \uc190\uc0c1**: \ub370\uc774\ud130\ub97c \ud56d\uc0c1 \ubc31\uc5c5\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc800\ub294 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc131\uacf5\uc801\uc73c\ub85c \uc774\uc804\ud588\uc9c0\ub9cc, \ud50c\ub7ab\ud3fc \ucc28\uc774\ub85c \uc778\ud574 \uba87 \uac00\uc9c0 \uc131\ucde8\ub97c \ub2e4\uc2dc \ud68d\ub4dd\ud574\uc57c \ud588\uc2b5\ub2c8\ub2e4."}, {"question": "\uacf5\uaca9 \ub85c\ubd07\uc5d0\uc11c \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uacf5\uaca9 \ub85c\ubd07\uc740 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub85c \uac00\ub4dd\ud569\ub2c8\ub2e4. \uc774\ub97c \ucc3e\ub294 \ubc29\ubc95\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. 1. **\ud658\uacbd \ub2e8\uc11c**: \uac8c\uc784 \uc138\uacc4\uc5d0\uc11c \ud2b9\uc774\ud55c \ud328\ud134\uc774\ub098 \ubb3c\uccb4\ub97c \ucc3e\uc2b5\ub2c8\ub2e4. 2. **\ub85c\ubd07 \uc0c1\ud638 \uc791\uc6a9**: \uc77c\ubd80 \ub85c\ubd07\uc740 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ud2b8\ub9ac\uac70\ud558\ub294 \ub3c5\ud2b9\ud55c \uc0c1\ud638 \uc791\uc6a9\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. 3. **\ubbf8\uc158 \ube44\ubc00**: \ud2b9\uc815 \ubbf8\uc158\uc5d0\ub294 \uc228\uaca8\uc9c4 \uacbd\ub85c\ub098 \uc544\uc774\ud15c\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud3d0\ud5c8\uac00 \ub41c \uae30\uc9c0' \ubbf8\uc158\uc5d0\uc11c \uae5c\ubc15\uc774\ub294 \uc77c\ub828\uc758 \ubd88\ube5b\uc744 \ub530\ub77c \uc228\uaca8\uc9c4 \ubc29\uc744 \ucc3e\uc558\uace0, \uac70\uae30\uc5d0\ub294 \ud76c\uadc0\ud55c \ub85c\ubd07 \uc2a4\ud0a8\uc774 \uc788\uc5c8\uc2b5\ub2c8\ub2e4."}]
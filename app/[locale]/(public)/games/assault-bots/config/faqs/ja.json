[{"question": "\u521d\u5fc3\u8005\u5411\u3051\u30d7\u30ec\u30a4\u3092\u6700\u9069\u5316\u3059\u308bAssault Bots\u306e\u30ed\u30fc\u30c9\u30a2\u30a6\u30c8\u3092\u3069\u306e\u3088\u3046\u306b\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u521d\u5fc3\u8005\u5411\u3051\u30d7\u30ec\u30a4\u3092\u6700\u9069\u5316\u3059\u308b\u305f\u3081\u306b\u3001Assault Bots\u306e\u30ed\u30fc\u30c9\u30a2\u30a6\u30c8\u3092\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u706b\u529b\u3068\u9632\u5fa1\u529b\u306e\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u300e\u30bb\u30f3\u30c8\u30cd\u30eb\u300f\u306e\u3088\u3046\u306a\u30dc\u30c3\u30c8\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u751f\u5b58\u6027\u3092\u78ba\u4fdd\u3059\u308b\u305f\u3081\u306b\u3001\u57fa\u672c\u7684\u306a\u30a2\u30b5\u30eb\u30c8\u30e9\u30a4\u30d5\u30eb\u3068\u30b7\u30fc\u30eb\u30c9\u30b8\u30a7\u30cd\u30ec\u30fc\u30bf\u30fc\u3092\u88c5\u5099\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30bf\u30fc\u30b2\u30c6\u30a3\u30f3\u30b0\u3092\u652f\u63f4\u3059\u308b\u305f\u3081\u306b\u300e\u81ea\u52d5\u7167\u6e96\u300f\u30e2\u30b8\u30e5\u30fc\u30eb\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u8a13\u7df4\u5834\u300f\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u3053\u308c\u3089\u306e\u8a2d\u5b9a\u3092\u3057\u305f\u300e\u30bb\u30f3\u30c8\u30cd\u30eb\u300f\u306f\u3001\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u79fb\u52d5\u3068\u6226\u7565\u306b\u96c6\u4e2d\u3067\u304d\u308b\u3088\u3046\u306b\u826f\u597d\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u767a\u63ee\u3057\u307e\u3057\u305f\u3002"}, {"question": "\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u95a2\u3057\u3066\u3001\u300e\u30a2\u30b5\u30eb\u30c8\u30dc\u30c3\u30c8\u300f\u3068\u300e\u5075\u5bdf\u30dc\u30c3\u30c8\u300f\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30a2\u30b5\u30eb\u30c8\u30dc\u30c3\u30c8\u306b\u304a\u3051\u308b\u300e\u30a2\u30b5\u30eb\u30c8\u30dc\u30c3\u30c8\u300f\u3068\u300e\u5075\u5bdf\u30dc\u30c3\u30c8\u300f\u306e\u4e3b\u306a\u9055\u3044\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\u30021. **\u5f79\u5272**\uff1a\u30a2\u30b5\u30eb\u30c8\u30dc\u30c3\u30c8\u306f\u3001\u9ad8\u3044\u8010\u4e45\u6027\u3092\u5099\u3048\u305f\u524d\u7dda\u6226\u95d8\u54e1\u3067\u3042\u308a\u3001\u5075\u5bdf\u30dc\u30c3\u30c8\u306f\u30b9\u30c6\u30eb\u30b9\u3068\u60c5\u5831\u53ce\u96c6\u306b\u512a\u308c\u3066\u3044\u307e\u3059\u30022. **\u901f\u5ea6**\uff1a\u5075\u5bdf\u30dc\u30c3\u30c8\u306f\u3088\u308a\u9ad8\u901f\u3067\u3042\u308a\u3001\u5075\u5bdf\u30df\u30c3\u30b7\u30e7\u30f3\u306b\u6700\u9069\u3067\u3059\u30023. **\u6b66\u5668**\uff1a\u30a2\u30b5\u30eb\u30c8\u30dc\u30c3\u30c8\u306f\u30ed\u30b1\u30c3\u30c8\u30e9\u30f3\u30c1\u30e3\u30fc\u306a\u3069\u306e\u91cd\u706b\u5668\u3092\u88c5\u5099\u3057\u3066\u3044\u307e\u3059\u304c\u3001\u5075\u5bdf\u30dc\u30c3\u30c8\u306f\u30b5\u30a4\u30ec\u30f3\u30b5\u30fc\u4ed8\u304d\u306e\u6b66\u5668\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30b7\u30e3\u30c9\u30a6\u30ea\u30b3\u30f3\u300f\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u5075\u5bdf\u30dc\u30c3\u30c8\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u6575\u306e\u8b66\u6212\u3092\u3059\u308a\u629c\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3057\u305f\u3002"}, {"question": "Assault Bots\u306b\u304a\u3051\u308b\u300e\u30a8\u30cd\u30eb\u30ae\u30fc\u7ba1\u7406\u30b7\u30b9\u30c6\u30e0\u300f\u304c\u91cd\u8981\u3067\u3042\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u6226\u95d8\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "Assault Bots\u306b\u304a\u3051\u308b\u300e\u30a8\u30cd\u30eb\u30ae\u30fc\u7ba1\u7406\u30b7\u30b9\u30c6\u30e0\u300f\u306f\u91cd\u8981\u3067\u3059\u3002\u306a\u305c\u306a\u3089\u3001\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u30a2\u30d3\u30ea\u30c6\u30a3\u3068\u6b66\u5668\u306e\u4f7f\u7528\u3092\u7ba1\u7406\u3059\u308b\u304b\u3089\u3067\u3059\u3002\u305d\u306e\u3057\u304f\u307f\u306f\u4ee5\u4e0b\u306e\u901a\u308a\u3067\u3059\u30021. **\u30a8\u30cd\u30eb\u30ae\u30fc\u306e\u5272\u308a\u5f53\u3066**\uff1a\u5404\u30a2\u30af\u30b7\u30e7\u30f3\u306f\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u6d88\u8cbb\u3059\u308b\u305f\u3081\u3001\u5fc5\u8981\u306b\u5fdc\u3058\u3066\u30a2\u30d3\u30ea\u30c6\u30a3\u3092\u4f7f\u7528\u3059\u308b\u305f\u3081\u306b\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u7ba1\u7406\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u30022. **\u30ea\u30c1\u30e3\u30fc\u30b8\u30ec\u30fc\u30c8**\uff1a\u30ea\u30c1\u30e3\u30fc\u30b8\u901f\u5ea6\u304c\u901f\u3044\u307b\u3069\u3001\u30a2\u30d3\u30ea\u30c6\u30a3\u3092\u983b\u7e41\u306b\u4f7f\u7528\u3067\u304d\u307e\u3059\u30023. **\u6226\u95d8\u3078\u306e\u5f71\u97ff**\uff1a\u30a8\u30cd\u30eb\u30ae\u30fc\u5207\u308c\u306b\u306a\u308b\u3068\u3001\u5371\u967a\u306a\u72b6\u614b\u306b\u306a\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30a8\u30cd\u30eb\u30ae\u30fc\u5371\u6a5f\u300f\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u30dc\u30c3\u30c8\u306e\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u6226\u7565\u7684\u306b\u4f7f\u7528\u3057\u3066\u3001\u91cd\u8981\u306a\u77ac\u9593\u306b\u30b7\u30fc\u30eb\u30c9\u3068\u706b\u529b\u3092\u5c55\u958b\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3057\u305f\u3002"}, {"question": "Assault Bots\u306b\u304a\u3051\u308b\u300e\u6226\u8853\u30aa\u30fc\u30d0\u30fc\u30ec\u30a4\u300f\u6a5f\u80fd\u3092\u52b9\u679c\u7684\u306b\u4f7f\u7528\u3057\u3066\u6226\u7565\u7684\u512a\u4f4d\u6027\u3092\u3069\u306e\u3088\u3046\u306b\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Assault Bots\u306b\u304a\u3051\u308b\u300e\u6226\u8853\u30aa\u30fc\u30d0\u30fc\u30ec\u30a4\u300f\u6a5f\u80fd\u3092\u52b9\u679c\u7684\u306b\u4f7f\u3046\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30aa\u30fc\u30d0\u30fc\u30ec\u30a4\u3092\u30a2\u30af\u30c6\u30a3\u30d6\u306b\u3057\u3066\u3001\u6575\u306e\u4f4d\u7f6e\u3068\u4f53\u529b\u30d0\u30fc\u3092\u8868\u793a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u60c5\u5831\u3092\u7528\u3044\u3066\u3001\u5f31\u3044\u6575\u3092\u5074\u9762\u653b\u6483\u306a\u3069\u306e\u653b\u6483\u8a08\u753b\u3092\u7acb\u3066\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u30c7\u30fc\u30bf\u306b\u57fa\u3065\u3044\u3066\u6226\u7565\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u90fd\u5e02\u653b\u6483\u300f\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u30aa\u30fc\u30d0\u30fc\u30ec\u30a4\u306b\u3088\u3063\u3066\u72d9\u6483\u624b\u306e\u5de3\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u3001\u8105\u5a01\u306b\u306a\u308b\u524d\u306b\u6392\u9664\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3057\u305f\u3002"}, {"question": "Assault Bots\u3067\u300e\u30bf\u30a4\u30bf\u30f3\u7d1a\u300f\u306e\u6575\u3092\u5012\u3059\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Assault Bots\u3067\u300e\u30bf\u30a4\u30bf\u30f3\u7d1a\u300f\u306e\u6575\u3092\u5012\u3059\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\u30021. **\u5f31\u70b9**\uff1a\u982d\u90e8\u3084\u80cc\u9762\u306a\u3069\u306e\u9732\u51fa\u3057\u305f\u5f31\u70b9\u3092\u72d9\u3044\u307e\u3059\u30022. **\u30c1\u30fc\u30e0\u9023\u643a**\uff1a\u30c1\u30fc\u30e0\u306e\u30a2\u30d3\u30ea\u30c6\u30a3\u3092\u4f7f\u7528\u3057\u3066\u3001\u30bf\u30a4\u30bf\u30f3\u3092\u6df7\u4e71\u3055\u305b\u3001\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u307e\u3059\u30023. **\u5947\u8972\u653b\u6483**\uff1a\u9ad8\u3044\u6a5f\u52d5\u6027\u3092\u4f7f\u7528\u3057\u3066\u3001\u6575\u306e\u5f37\u529b\u306a\u653b\u6483\u3092\u907f\u3051\u306a\u304c\u3089\u3001\u5c11\u3057\u305a\u3064\u30bf\u30a4\u30bf\u30f3\u306e\u4f53\u529b\u306b\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30bf\u30a4\u30bf\u30f3\u30d5\u30a9\u30fc\u30eb\u300f\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u30c1\u30fc\u30e0\u306f\u30bf\u30a4\u30bf\u30f3\u306e\u982d\u90e8\u306b\u96c6\u4e2d\u3057\u3066\u81f4\u547d\u7684\u306a\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u3001\u305d\u306e\u7834\u58ca\u7684\u306a\u30b0\u30e9\u30a6\u30f3\u30c9\u30b9\u30e9\u30e0\u3092\u56de\u907f\u3057\u307e\u3057\u305f\u3002"}, {"question": "Assault Bots\u306b\u304a\u3051\u308b\u300e\u30c0\u30e1\u30fc\u30b8\u62b5\u6297\u300f\u30b9\u30c6\u30fc\u30bf\u30b9\u304c\u30dc\u30c3\u30c8\u306e\u751f\u5b58\u6027\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "Assault Bots\u306b\u304a\u3051\u308b\u300e\u30c0\u30e1\u30fc\u30b8\u62b5\u6297\u300f\u30b9\u30c6\u30fc\u30bf\u30b9\u306f\u3001\u53d7\u3051\u308b\u30c0\u30e1\u30fc\u30b8\u3092\u6e1b\u3089\u3059\u3053\u3068\u3067\u751f\u5b58\u6027\u306b\u5927\u304d\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u305d\u308c\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\uff1a1. **\u30a2\u30fc\u30de\u30fc\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9**\uff1a\u9ad8\u3044\u9632\u5fa1\u529b\u306e\u30a2\u30fc\u30de\u30fc\u3092\u88c5\u5099\u3057\u307e\u3059\u30022. **\u30b7\u30fc\u30eb\u30c9\u30e2\u30b8\u30e5\u30fc\u30eb**\uff1a\u30b7\u30fc\u30eb\u30c9\u30b8\u30a7\u30cd\u30ec\u30fc\u30bf\u30fc\u3092\u4f7f\u7528\u3057\u3066\u30c0\u30e1\u30fc\u30b8\u3092\u8efd\u6e1b\u3057\u307e\u3059\u30023. **\u30b9\u30ad\u30eb\u30c4\u30ea\u30fc**\uff1a\u9632\u5fa1\u529b\u5411\u4e0a\u30b9\u30ad\u30eb\u306b\u6295\u8cc7\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u5305\u56f2\u9632\u5fa1\u300f\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u6700\u5927\u5f37\u5316\u3055\u308c\u305f\u9632\u5fa1\u529b\u306e\u30dc\u30c3\u30c8\u306f\u3001\u6575\u306e\u653b\u6483\u3092\u4f55\u5ea6\u304b\u751f\u304d\u5ef6\u3073\u308b\u3053\u3068\u304c\u3067\u304d\u3001\u6211\u3005\u304c\u6226\u7dda\u3092\u7dad\u6301\u3059\u308b\u52a9\u3051\u3068\u306a\u308a\u307e\u3057\u305f\u3002"}, {"question": "Assault Bots\u306b\u304a\u3051\u308b\u300e\u5f3e\u85ac\u306e\u7a2e\u985e\u300f\u306f\u3069\u306e\u3088\u3046\u306a\u5f79\u5272\u3092\u679c\u305f\u3057\u3001\u6575\u306e\u7a2e\u985e\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "Assault Bots\u306b\u304a\u3051\u308b\u300e\u5f3e\u85ac\u306e\u7a2e\u985e\u300f\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u6575\u30bf\u30a4\u30d7\u306b\u5bfe\u3057\u3066\u7279\u6b8a\u306a\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u5f79\u5272\u3092\u679c\u305f\u3057\u307e\u3059\u3002\u305d\u306e\u3057\u304f\u307f\u306f\u4ee5\u4e0b\u306e\u901a\u308a\u3067\u3059\u30021. **\u8cab\u901a\u5f3e**\uff1a\u88c5\u7532\u304c\u975e\u5e38\u306b\u539a\u3044\u6575\u306b\u5bfe\u3057\u3066\u52b9\u679c\u7684\u3067\u3059\u30022. **\u7206\u767a\u5f3e**\uff1a\u6575\u304c\u5bc6\u96c6\u3057\u3066\u3044\u308b\u5834\u5408\u306b\u6700\u9069\u3067\u3059\u30023. **\u30a8\u30cd\u30eb\u30ae\u30fc\u5f3e**\uff1a\u30b7\u30fc\u30eb\u30c9\u3092\u5099\u3048\u305f\u30bf\u30fc\u30b2\u30c3\u30c8\u306b\u6700\u9069\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u5f3e\u85ac\u5eab\u300f\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u88c5\u7532\u8cab\u901a\u5f3e\u306b\u5207\u308a\u66ff\u3048\u308b\u3053\u3068\u3067\u3001\u3059\u3050\u306b\u88c5\u7532\u30c9\u30ed\u30fc\u30f3\u306e\u30b0\u30eb\u30fc\u30d7\u3092\u6483\u7834\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3057\u305f\u3002"}, {"question": "PC\u304b\u3089\u306eAssault Bots\u306e\u9032\u884c\u72b6\u6cc1\u3092\u30b3\u30f3\u30bd\u30fc\u30eb\u306b\u79fb\u884c\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u6f5c\u5728\u7684\u306a\u843d\u3068\u3057\u7a74\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "PC\u304b\u3089\u306eAssault Bots\u306e\u9032\u884c\u72b6\u6cc1\u3092\u30b3\u30f3\u30bd\u30fc\u30eb\u306b\u79fb\u884c\u3059\u308b\u306b\u306f\u3001\u6b21\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\u30021. **\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58**\uff1a\u9032\u884c\u72b6\u6cc1\u3092\u30af\u30e9\u30a6\u30c9\u306b\u4fdd\u5b58\u3057\u3066\u304f\u3060\u3055\u3044\u30022. **\u30a2\u30ab\u30a6\u30f3\u30c8\u9023\u643a**\uff1a\u30b2\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u5168\u4f53\u3067\u9023\u643a\u3055\u305b\u307e\u3059\u30023. **\u30c7\u30fc\u30bf\u540c\u671f**\uff1a\u65b0\u3057\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u30c7\u30fc\u30bf\u3092\u540c\u671f\u3057\u307e\u3059\u3002\u6f5c\u5728\u7684\u306a\u843d\u3068\u3057\u7a74\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\u30021. **\u4e92\u63db\u6027**\uff1a\u4e00\u90e8\u306e\u30a2\u30a4\u30c6\u30e0\u3084\u5b9f\u7e3e\u306f\u79fb\u884c\u3055\u308c\u306a\u3044\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u30022. **\u4fdd\u5b58\u30c7\u30fc\u30bf\u306e\u7834\u640d**\uff1a\u5e38\u306b\u30c7\u30fc\u30bf\u306e\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u3092\u3068\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u79c1\u306f\u7121\u4e8b\u306b\u9032\u884c\u72b6\u6cc1\u3092\u79fb\u884c\u3057\u307e\u3057\u305f\u304c\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u9055\u3044\u306b\u3088\u308a\u3001\u3044\u304f\u3064\u304b\u306e\u5b9f\u7e3e\u3092\u518d\u7372\u5f97\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3057\u305f\u3002"}, {"question": "Assault Bots\u306e\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u3092\u898b\u3064\u3051\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "Assault Bots\u306b\u306f\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u305f\u304f\u3055\u3093\u3042\u308a\u307e\u3059\u3002\u305d\u308c\u3089\u3092\u898b\u3064\u3051\u308b\u65b9\u6cd5\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\u30021. **\u74b0\u5883\u306e\u30d2\u30f3\u30c8**\uff1a\u30b2\u30fc\u30e0\u4e16\u754c\u306e\u4e2d\u306b\u3001\u901a\u5e38\u3068\u306f\u7570\u306a\u308b\u30d1\u30bf\u30fc\u30f3\u3084\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u63a2\u3057\u3066\u304f\u3060\u3055\u3044\u30022. **\u30dc\u30c3\u30c8\u306e\u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3**\uff1a\u4e00\u90e8\u306e\u30dc\u30c3\u30c8\u306b\u306f\u3001\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u5b9f\u884c\u3059\u308b\u72ec\u81ea\u306e\u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3\u304c\u3042\u308a\u307e\u3059\u30023. **\u30df\u30c3\u30b7\u30e7\u30f3\u306e\u79d8\u5bc6**\uff1a\u7279\u5b9a\u306e\u30df\u30c3\u30b7\u30e7\u30f3\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u30d1\u30b9\u3084\u30a2\u30a4\u30c6\u30e0\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u5ec3\u68c4\u3055\u308c\u305f\u57fa\u5730\u300f\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u70b9\u6ec5\u3059\u308b\u4e00\u9023\u306e\u30e9\u30a4\u30c8\u306b\u5f93\u3063\u3066\u96a0\u3055\u308c\u305f\u90e8\u5c4b\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u3001\u307e\u308c\u306a\u30dc\u30c3\u30c8\u30b9\u30ad\u30f3\u304c\u5165\u3063\u3066\u3044\u307e\u3057\u305f\u3002"}]
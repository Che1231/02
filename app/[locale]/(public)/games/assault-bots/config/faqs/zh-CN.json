[{"question": "\u5982\u4f55\u81ea\u5b9a\u4e49\u6211\u7684\u7a81\u51fb\u673a\u5668\u4eba\u8f7d\u5177\uff0c\u4ee5\u4f18\u5316\u521d\u5b66\u8005\u53cb\u597d\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u4e3a\u4e86\u4f18\u5316\u7a81\u51fb\u673a\u5668\u4eba\u8f7d\u5177\uff0c\u4f7f\u5176\u66f4\u9002\u5408\u521d\u5b66\u8005\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u9009\u62e9\u5e73\u8861\u578b\u673a\u5668\u4eba\uff0c\u4f8b\u5982\u201c\u54e8\u5175\u201d\uff0c\u5b83\u517c\u5177\u706b\u529b\u548c\u9632\u5fa1\u80fd\u529b\u3002\u6b65\u9aa42\uff1a\u914d\u5907\u57fa\u672c\u7684\u7a81\u51fb\u6b65\u67aa\u548c\u62a4\u76fe\u53d1\u751f\u5668\uff0c\u4ee5\u786e\u4fdd\u751f\u5b58\u80fd\u529b\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u201c\u81ea\u52a8\u7784\u51c6\u201d\u6a21\u5757\u8f85\u52a9\u76ee\u6807\u9501\u5b9a\u3002\u4f8b\u5982\uff0c\u5728\u201c\u8bad\u7ec3\u573a\u201d\u4efb\u52a1\u4e2d\uff0c\u201c\u54e8\u5175\u201d\u4f7f\u7528\u8fd9\u4e9b\u8bbe\u7f6e\u8868\u73b0\u51fa\u8272\uff0c\u8ba9\u65b0\u73a9\u5bb6\u80fd\u591f\u4e13\u6ce8\u4e8e\u79fb\u52a8\u548c\u7b56\u7565\u3002"}, {"question": "\u5728\u6e38\u620f\u673a\u5236\u65b9\u9762\uff0c'\u7a81\u51fb\u673a\u5668\u4eba'\u548c'\u4fa6\u5bdf\u673a\u5668\u4eba'\u4e4b\u95f4\u6709\u4ec0\u4e48\u4e3b\u8981\u533a\u522b\uff1f", "answer": "\u5728\u7a81\u51fb\u673a\u5668\u4eba\u4e2d\uff0c'\u7a81\u51fb\u673a\u5668\u4eba' \u548c '\u4fa6\u5bdf\u673a\u5668\u4eba' \u7684\u4e3b\u8981\u533a\u522b\u5728\u4e8e\uff1a1. **\u89d2\u8272**:\u7a81\u51fb\u673a\u5668\u4eba\u662f\u575a\u56fa\u8010\u7528\u7684\u524d\u7ebf\u6218\u58eb\uff0c\u800c\u4fa6\u5bdf\u673a\u5668\u4eba\u64c5\u957f\u9690\u853d\u548c\u60c5\u62a5\u6536\u96c6\u30022. **\u901f\u5ea6**:\u4fa6\u5bdf\u673a\u5668\u4eba\u901f\u5ea6\u66f4\u5feb\uff0c\u975e\u5e38\u9002\u5408\u4fa6\u5bdf\u4efb\u52a1\u30023. **\u6b66\u5668**:\u7a81\u51fb\u673a\u5668\u4eba\u914d\u5907\u4e86\u706b\u7bad\u53d1\u5c04\u5668\u7b49\u91cd\u578b\u6b66\u5668\uff0c\u800c\u4fa6\u5bdf\u673a\u5668\u4eba\u4f7f\u7528\u6d88\u97f3\u6b66\u5668\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5f71\u5b50\u4fa6\u5bdf\u201d\u4efb\u52a1\u4e2d\uff0c\u4f7f\u7528\u4fa6\u5bdf\u673a\u5668\u4eba\u53ef\u4ee5\u6084\u65e0\u58f0\u606f\u5730\u7ed5\u8fc7\u654c\u65b9\u5de1\u903b\u961f\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u7a81\u51fb\u673a\u5668\u4eba\u7684'\u80fd\u6e90\u7ba1\u7406\u7cfb\u7edf'\u81f3\u5173\u91cd\u8981\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u54cd\u6218\u6597\uff1f", "answer": "\u7a81\u51fb\u673a\u5668\u4eba\u4e2d\u7684'\u80fd\u6e90\u7ba1\u7406\u7cfb\u7edf'\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u63a7\u5236\u7740\u6280\u80fd\u548c\u6b66\u5668\u7684\u4f7f\u7528\u3002\u5176\u5de5\u4f5c\u539f\u7406\u5982\u4e0b\uff1a1. **\u80fd\u91cf\u5206\u914d**: \u6bcf\u4e2a\u52a8\u4f5c\u90fd\u4f1a\u6d88\u8017\u80fd\u91cf\uff0c\u56e0\u6b64\u7ba1\u7406\u80fd\u91cf\u53ef\u4ee5\u786e\u4fdd\u5728\u9700\u8981\u65f6\u4f7f\u7528\u6280\u80fd\u30022. **\u80fd\u91cf\u56de\u590d\u901f\u5ea6**: \u66f4\u5feb\u7684\u56de\u590d\u901f\u5ea6\u610f\u5473\u7740\u66f4\u9891\u7e41\u5730\u4f7f\u7528\u6280\u80fd\u30023. **\u6218\u6597\u5f71\u54cd**: \u8017\u5c3d\u80fd\u6e90\u4f1a\u4f7f\u4f60\u5904\u4e8e\u5371\u9669\u5883\u5730\u3002\u4f8b\u5982\uff0c\u5728\u201c\u80fd\u6e90\u5371\u673a\u201d\u4efb\u52a1\u4e2d\uff0c\u6211\u5fc5\u987b\u6218\u7565\u6027\u5730\u4f7f\u7528\u673a\u5668\u4eba\u7684\u80fd\u91cf\u90e8\u7f72\u9632\u5fa1\u62a4\u76fe\u548c\u706b\u529b\uff0c\u4ee5\u5e94\u5bf9\u5173\u952e\u65f6\u523b\u7684\u5a01\u80c1\u3002"}, {"question": "\u5982\u4f55\u6709\u6548\u5730\u4f7f\u7528\u7a81\u51fb\u673a\u5668\u4eba\u7684'\u6218\u672f\u8986\u76d6'\u529f\u80fd\u6765\u83b7\u5f97\u6218\u7565\u4f18\u52bf\uff1f", "answer": "\u4e3a\u4e86\u6709\u6548\u5730\u4f7f\u7528\u7a81\u51fb\u673a\u5668\u4eba\u7684\u201c\u6218\u672f\u8986\u76d6\u201d\u529f\u80fd\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u6fc0\u6d3b\u8986\u76d6\u5c42\uff0c\u67e5\u770b\u654c\u4eba\u7684\u4f4d\u7f6e\u548c\u751f\u547d\u503c\u3002\u6b65\u9aa42\uff1a\u5229\u7528\u8fd9\u4e9b\u4fe1\u606f\u89c4\u5212\u4f60\u7684\u653b\u51fb\u65b9\u9488\uff0c\u4f8b\u5982\u653b\u51fb\u8f83\u5f31\u7684\u654c\u4eba\u3002\u6b65\u9aa43\uff1a\u6839\u636e\u5b9e\u65f6\u6570\u636e\u8c03\u6574\u4f60\u7684\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u5728\u201c\u57ce\u5e02\u7a81\u51fb\u201d\u4efb\u52a1\u4e2d\uff0c\u8986\u76d6\u5c42\u5e2e\u52a9\u6211\u8bc6\u522b\u4e86\u4e00\u4e2a\u72d9\u51fb\u624b\u5de2\u7a74\uff0c\u8ba9\u6211\u80fd\u591f\u5728\u5b83\u6210\u4e3a\u5a01\u80c1\u4e4b\u524d\u5c06\u5176\u6e05\u9664\u3002"}, {"question": "\u5728\u7a81\u51fb\u673a\u5668\u4eba\u4e2d\uff0c\u51fb\u8d25\u201c\u6cf0\u5766\u7ea7\u201d\u654c\u4eba\u6709\u54ea\u4e9b\u6700\u4f73\u7b56\u7565\uff1f", "answer": "\u5728\u7a81\u51fb\u673a\u5668\u4eba\u4e2d\u51fb\u8d25\u201c\u6cf0\u5766\u7ea7\u201d\u654c\u4eba\u7684\u6700\u4f73\u7b56\u7565\u662f\uff1a1. **\u5f31\u70b9**: \u7784\u51c6\u5176\u66b4\u9732\u7684\u5f31\u70b9\uff0c\u4f8b\u5982\u5934\u90e8\u6216\u80cc\u90e8\u30022. **\u56e2\u961f\u914d\u5408**: \u5229\u7528\u56e2\u961f\u7684\u6280\u80fd\u6765\u5206\u6563\u548c\u524a\u5f31\u6cf0\u5766\u7684\u9632\u5fa1\u30023. **\u88ad\u6270\u653b\u51fb**: \u5229\u7528\u673a\u52a8\u6027\u89c4\u907f\u6cf0\u5766\u7684\u91cd\u51fb\uff0c\u540c\u65f6\u4e00\u70b9\u4e00\u70b9\u5730\u524a\u51cf\u5176\u751f\u547d\u503c\u3002\u4f8b\u5982\uff0c\u5728\u201c\u6cf0\u5766\u4e4b\u6218\u201d\u4efb\u52a1\u4e2d\uff0c\u6211\u7684\u56e2\u961f\u4e13\u6ce8\u4e8e\u6cf0\u5766\u7684\u5934\u90e8\uff0c\u9020\u6210\u91cd\u5927\u4f24\u5bb3\uff0c\u540c\u65f6\u89c4\u907f\u5176\u6bc1\u706d\u6027\u7684\u5730\u9762\u51b2\u51fb\u3002"}, {"question": "\u7a81\u51fb\u673a\u5668\u4eba\u4e2d\u7684'\u4f24\u5bb3\u62b5\u6297'\u5c5e\u6027\u5982\u4f55\u5f71\u54cd\u673a\u5668\u4eba\u7684\u751f\u5b58\u80fd\u529b\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u5927\u5316\u5b83\uff1f", "answer": "\u7a81\u51fb\u673a\u5668\u4eba\u4e2d\u7684\u201c\u4f24\u5bb3\u62b5\u6297\u201d\u5c5e\u6027\u663e\u8457\u5730\u5f71\u54cd\u751f\u5b58\u80fd\u529b\uff0c\u901a\u8fc7\u964d\u4f4e\u53d7\u5230\u7684\u4f24\u5bb3\u3002\u4e3a\u4e86\u6700\u5927\u5316\u5b83\uff1a1. **\u88c5\u7532\u5347\u7ea7**: \u4e3a\u4f60\u7684\u673a\u5668\u4eba\u914d\u5907\u9ad8\u6297\u6027\u88c5\u7532\u30022. **\u62a4\u76fe\u6a21\u5757**: \u4f7f\u7528\u62a4\u76fe\u53d1\u751f\u5668\u6765\u5438\u6536\u4f24\u5bb3\u30023. **\u6280\u80fd\u6811**: \u5728\u589e\u5f3a\u6297\u6027\u7684\u6280\u80fd\u4e0a\u6295\u8d44\u3002\u4f8b\u5982\uff0c\u5728\u201c\u56f4\u653b\u9632\u5fa1\u201d\u4efb\u52a1\u4e2d\uff0c\u6211\u88c5\u5907\u4e86\u6700\u5927\u5316\u62b5\u6297\u529b\u7684\u673a\u5668\u4eba\uff0c\u5728\u591a\u6b21\u654c\u65b9\u706b\u529b\u653b\u51fb\u4e2d\u5e78\u5b58\u4e0b\u6765\uff0c\u4f7f\u6211\u80fd\u591f\u575a\u5b88\u9635\u5730\u3002"}, {"question": "\u7a81\u51fb\u673a\u5668\u4eba\u4e2d'\u5f39\u836f\u7c7b\u578b'\u7684\u4f5c\u7528\u662f\u4ec0\u4e48\uff0c\u5b83\u4eec\u5982\u4f55\u5f71\u54cd\u4e0d\u540c\u7684\u654c\u4eba\u7c7b\u578b\uff1f", "answer": "\u7a81\u51fb\u673a\u5668\u4eba\u4e2d'\u5f39\u836f\u7c7b\u578b'\u7684\u4f5c\u7528\u662f\u9488\u5bf9\u4e0d\u540c\u654c\u4eba\u7c7b\u578b\u63d0\u4f9b\u4e13\u95e8\u7684\u4f24\u5bb3\u3002\u5176\u5de5\u4f5c\u539f\u7406\u5982\u4e0b\uff1a1. **\u7a7f\u7532\u5f39**: \u7528\u4e8e\u5bf9\u6297\u91cd\u88c5\u7532\u654c\u4eba\u30022. **\u7206\u70b8\u5f39**: \u7528\u4e8e\u5bf9\u6297\u6210\u7fa4\u7684\u654c\u4eba\u30023. **\u80fd\u91cf\u5f39**: \u7528\u4e8e\u5bf9\u6297\u88c5\u6709\u62a4\u76fe\u7684\u76ee\u6807\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5f39\u836f\u5e93\u201d\u4efb\u52a1\u4e2d\uff0c\u5207\u6362\u5230\u7a7f\u7532\u5f39\u5141\u8bb8\u6211\u8fc5\u901f\u51fb\u6e83\u4e00\u7fa4\u88c5\u7532\u65e0\u4eba\u673a\u3002"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684PC\u7248\u7a81\u51fb\u673a\u5668\u4eba\u6e38\u620f\u8fdb\u5ea6\u8f6c\u79fb\u5230\u4e3b\u673a\u5e73\u53f0\uff0c\u4ee5\u53ca\u6f5c\u5728\u7684\u9677\u9631\u662f\u4ec0\u4e48\uff1f", "answer": "\u8981\u5c06\u4f60\u7684PC\u7248\u7a81\u51fb\u673a\u5668\u4eba\u6e38\u620f\u8fdb\u5ea6\u8f6c\u79fb\u5230\u4e3b\u673a\u5e73\u53f0\uff0c\u8bf7\u6267\u884c\u4ee5\u4e0b\u64cd\u4f5c\uff1a1. **\u4e91\u7aef\u4fdd\u5b58**: \u786e\u4fdd\u4f60\u7684\u8fdb\u5ea6\u5df2\u4fdd\u5b58\u5230\u4e91\u7aef\u30022. **\u8d26\u6237\u5173\u8054**: \u5728\u5404\u5e73\u53f0\u4e0a\u94fe\u63a5\u4f60\u7684\u6e38\u620f\u8d26\u6237\u30023. **\u6570\u636e\u540c\u6b65**: \u5728\u65b0\u5e73\u53f0\u4e0a\u540c\u6b65\u4f60\u7684\u6570\u636e\u3002\u6f5c\u5728\u7684\u9677\u9631\u5305\u62ec\uff1a1. **\u4e0d\u517c\u5bb9**: \u4e00\u4e9b\u7269\u54c1\u6216\u6210\u5c31\u53ef\u80fd\u65e0\u6cd5\u8f6c\u79fb\u30022. **\u4fdd\u5b58\u6570\u636e\u635f\u574f**: \u59cb\u7ec8\u5907\u4efd\u4f60\u7684\u6570\u636e\u3002\u4f8b\u5982\uff0c\u6211\u6210\u529f\u5730\u8f6c\u79fb\u4e86\u6211\u7684\u8fdb\u5ea6\uff0c\u4f46\u662f\u7531\u4e8e\u5e73\u53f0\u5dee\u5f02\uff0c\u6211\u4e0d\u5f97\u4e0d\u91cd\u65b0\u83b7\u5f97\u4e00\u4e9b\u6210\u5c31\u3002"}, {"question": "\u7a81\u51fb\u673a\u5668\u4eba\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u5f69\u86cb\uff0c\u4ee5\u53ca\u5982\u4f55\u627e\u5230\u5b83\u4eec\uff1f", "answer": "\u7a81\u51fb\u673a\u5668\u4eba\u4e2d\u5145\u6ee1\u4e86\u9690\u85cf\u5f69\u86cb\u3002\u4ee5\u4e0b\u662f\u627e\u5230\u5b83\u4eec\u7684\u65b9\u6cd5\uff1a1. **\u73af\u5883\u7ebf\u7d22**: \u5728\u6e38\u620f\u4e16\u754c\u4e2d\u5bfb\u627e\u5f02\u5e38\u7684\u56fe\u6848\u6216\u7269\u4f53\u30022. **\u673a\u5668\u4eba\u4e92\u52a8**: \u4e00\u4e9b\u673a\u5668\u4eba\u6709\u72ec\u7279\u7684\u4e92\u52a8\uff0c\u4f1a\u89e6\u53d1\u5f69\u86cb\u30023. **\u4efb\u52a1\u79d8\u5bc6**: \u4e00\u4e9b\u4efb\u52a1\u4e2d\u9690\u85cf\u7740\u9690\u85cf\u8def\u5f84\u6216\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5e9f\u5f03\u57fa\u5730\u201d\u4efb\u52a1\u4e2d\uff0c\u6211\u901a\u8fc7\u8ffd\u8e2a\u4e00\u7cfb\u5217\u95ea\u70c1\u7684\u706f\u5149\u627e\u5230\u4e86\u4e00\u4e2a\u9690\u85cf\u623f\u95f4\uff0c\u5176\u4e2d\u5305\u542b\u4e00\u4e2a\u7a00\u6709\u7684\u673a\u5668\u4eba\u76ae\u80a4\u3002"}]
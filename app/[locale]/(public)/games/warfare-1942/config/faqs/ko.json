[{"question": "1942\ub144 \uc804\uc7c1 \ucd08\ubcf4 \uc548\ub0b4: Warfare1942\uc5d0\uc11c \uae30\ubcf8 \uc870\uc791\uacfc \ubd80\ub300\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec \ucd08\ubc18 \uc190\uc2e4\uc744 \ud53c\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Warfare 1942\uc5d0 \uc624\uc2e0 \uac83\uc744 \ud658\uc601\ud569\ub2c8\ub2e4! \uae30\ubcf8 \uc870\uc791\uc740 \ub9c8\uc6b0\uc2a4\ub85c \uc720\ub2db\uc744 \uc120\ud0dd\ud558\uace0 \uc624\ub978\ucabd \ud074\ub9ad\ud558\uc5ec \uc774\ub3d9\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \ud6a8\uacfc\uc801\uc73c\ub85c \uc774\ub3d9\ud558\ub824\uba74 \uc720\ub2db \uc720\ud615\uc744 \uace0\ub824\ud558\uc2ed\uc2dc\uc624. \ubcf4\ubcd1\uc740 \ub3c4\uc2dc \uc810\ub839\uc5d0 \uc88b\uace0, \uc804\ucc28\ub294 \uac1c\ubc29\uc804\uc5d0 \uc88b\uc73c\uba70, \ud3ec\ubcd1\uc740 \uc6d0\uac70\ub9ac \uc9c0\uc6d0\uc5d0 \uc88b\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 \uacf5\uaca9\ud560 \ub54c: 1\ub2e8\uacc4: \uc800\ub834\ud55c \uc720\ub2db\uc73c\ub85c \uc9c0\uc5ed\uc744 \uc815\ucc30\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \uc9c0\uc6d0\uc744 \uc704\ud574 \ud3ec\ubcd1\uc744 \ubc30\uce58\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \uc804\ucc28\uc640 \ubcf4\ubcd1\uc744 \uc774\ub3d9\ud558\uc5ec \ucc38\uc5ec\ud569\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc778 \uc2e4\uc218\ub294 \ubcf4\ubcd1\ub9cc\uc73c\ub85c \uc804\ucc28\ub97c \uc0c1\ub300\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \ud56d\uc0c1 \uc5f0\ud569 \uc791\uc804 \uc804\ub7b5\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \uc774\ub97c \uc554\uc11d-\uc885\uc774-\uac00\uc704\ucc98\ub7fc \uc0dd\uac01\ud558\uc2ed\uc2dc\uc624. \ubcf4\ubcd1\uc740 \ud3ec\ubcd1\uc744 \ubb3c\ub9ac\uce58\uace0, \uc804\ucc28\ub294 \ubcf4\ubcd1\uc744 \ubb3c\ub9ac\uce58\uace0, \ud3ec\ubcd1\uc740 \uc804\ucc28\ub97c \ubb3c\ub9ac\uce69\ub2c8\ub2e4."}, {"question": "1942\ub144 \uc804\uc7c1\uc5d0\uc11c \uc790\uc6d0 \uad00\ub9ac\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c? Warfare1942 \ucd08\ubc18\uc5d0 \uc790\uc6d0\uc744 \uac00\uc7a5 \ube60\ub974\uac8c \uc5bb\uace0 \uc790\uc6d0 \ubd80\uc871\uc744 \ud53c\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "1942\ub144 \uc804\uc7c1\uc5d0\uc11c \uc790\uc6d0 \uad00\ub9ac\uac00 \uc804\uc7c1 \ub178\ub825\uc744 \uc9c0\uc18d\ud558\ub294 \ub370 \uc911\uc694\ud569\ub2c8\ub2e4. \uc790\uc6d0\uc774 \uc5c6\uc73c\uba74 \uc720\ub2db\uc744 \uac74\uc124\ud558\uac70\ub098 \uae30\uc220\uc744 \uc5f0\uad6c\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ucd08\ubc18\uc5d0\ub294 \uc6d0\uc720 \uc9c0\uc5ed\uacfc \uc0b0\uc5c5 \uc9c0\uc5ed\uacfc \uac19\uc740 \uc790\uc6d0\uc774 \ud48d\ubd80\ud55c \uc601\ud1a0\ub97c \uc810\ub839\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \uc804\ub7b5\uc801\uc73c\ub85c \uc911\uc694\ud558\uc9c0\ub9cc \uc790\uc6d0\uc774 \ubd80\uc871\ud55c \uc9c0\uc5ed\ubcf4\ub2e4 \uc6b0\uc120\ud558\uc2ed\uc2dc\uc624. \uc790\uc6d0 \uc0dd\uc131 \uac74\ubb3c\ub3c4 \uc9c0\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc810\ub839\ud55c \uc601\ud1a0 \uadfc\ucc98\uc5d0 \ubcf4\uae09 \ucc3d\uace0\ub97c \uc124\uce58\ud558\ub294 \uac83\uc740 \ub9e4\uc6b0 \uc720\ub9ac\ud569\ub2c8\ub2e4. \ucd08\ubc18\uc5d0 \ub108\ubb34 \ub9ce\uc740 \uc720\ub2db\uc5d0 \uc790\uc6d0\uc744 \uacfc\ub3c4\ud558\uac8c \uc0ac\uc6a9\ud558\uc9c0 \ub9c8\uc2ed\uc2dc\uc624. \uade0\ud615 \uc7a1\ud78c \uacbd\uc81c\ub97c \uc720\uc9c0\ud558\uc2ed\uc2dc\uc624. \uc774 \ube44\uad50\ub97c \uace0\ub824\ud558\uc2ed\uc2dc\uc624. \ucd08\ubc18\uc5d0 \uc804\ucc28\uc5d0 \ubaa8\ub4e0 \uc790\uc6d0\uc744 \uc0ac\uc6a9\ud558\ub294 \uac83\uacfc \uade0\ud615 \uc7a1\ud78c \uc811\uadfc \ubc29\uc2dd\uc744 \uc120\ud0dd\ud558\ub294 \uac83 \uc0ac\uc774\uc5d0\uc11c \ub098\uc911\uc5d0 \ub300\uacf5 \ubc29\uc5b4\uc5d0 \ud22c\uc790\ud558\uc9c0 \uc54a\uc73c\uba74 \uacf5\uc2b5\uc5d0 \ucde8\uc57d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc9d1\uc744 \uc9d3\ub294 \uac83\ucc98\ub7fc \uc7a5\uae30\uc801\uc778 \uc131\uacf5\uc744 \uc704\ud55c \uacac\uace0\ud55c \ud1a0\ub300\uac00 \ud544\uc694\ud569\ub2c8\ub2e4."}, {"question": "1942\ub144 \uc804\uc7c1\uc5d0\uc11c \uac74\ubb3c\uc740 \uc5b4\ub5bb\uac8c \uc9c0\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c? Warfare1942\uc5d0\uc11c \uac01 \uac74\ubb3c\uc758 \ubcf4\ub108\uc2a4\ub97c \ucd5c\ub300\ud55c \uc5bb\uae30 \uc704\ud574 \uc5b4\ub5a4 \uc885\ub958\uc758 \uac74\ubb3c\uc744 \uc5b4\ub514\uc5d0 \uc9c0\uc744 \uc218 \uc788\ub294 \uac83\uc774 \uac00\uc7a5 \uc88b\uc2b5\ub2c8\uae4c?", "answer": "Warfare 1942\uc5d0\uc11c \uac74\ubb3c\uc744 \uc9c0\uc73c\ub824\uba74 \uac74\uc124 \uc720\ub2db(\uc608: \uc5d4\uc9c0\ub2c8\uc5b4)\uc744 \uc120\ud0dd\ud558\uace0, \ud1b5\uc81c \uc601\uc5ed \ub0b4\uc5d0\uc11c \uc0ac\uc6a9 \uac00\ub2a5\ud55c \uac74\ubb3c \uc2ac\ub86f\uc744 \ud074\ub9ad\ud558\uc2ed\uc2dc\uc624. \ub2e4\ub978 \uc601\ud1a0\ub294 \ub2e4\ub978 \uc790\uc6d0\uc5d0 \ubcf4\ub108\uc2a4\ub97c \uc81c\uacf5\ud558\ubbc0\ub85c \uac74\ubb3c\uc744 \uc801\uc808\ud558\uac8c \uac74\uc124\ud574\uc57c \ud569\ub2c8\ub2e4. \uac74\uc124 \uc720\ub2db\uc740 \uc790\uc2e0\uc774 \uc18c\uc720\ud55c \uc601\ud1a0 \uadfc\ucc98\uc5d0 \uc788\uc5b4\uc57c \ud558\uba70, \uc720\ub2db\uc744 \uc120\ud0dd\ud558\uace0 \uac74\uc124 \uba54\ub274\ub97c \uc120\ud0dd\ud574\uc57c \ud569\ub2c8\ub2e4. \ubcf4\ub108\uc2a4\ub97c \uadf9\ub300\ud654\ud558\ub824\uba74 \uac74\uc124\ud558\uae30 \uc804\uc5d0 \uc601\ud1a0 \uc138\ubd80 \uc815\ubcf4\ub97c \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \ub192\uc740 \uc6d0\uc720 \ucc44\uad74\ub7c9\uc744 \uac00\uc9c4 \uc601\ud1a0\ub97c \uace0\ub824\ud558\uace0 \uc815\uc720\uc18c\ub97c \uadf8\uacf3\uc5d0 \uac74\uc124\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc601\ud1a0\uc5d0\uc11c \uc5bb\uc744 \uc218 \uc788\ub294 \uac00\uc7a5 \ub9ce\uc740 \uc6d0\uc720 \uc0dd\uc0b0\ub7c9\uc744 \uc6d0\ud558\uae30 \ub54c\ubb38\uc5d0 \uc801\uc808\ud55c \uc7a5\uc18c\uc785\ub2c8\ub2e4. \ub2e4\ub978 \uad6c\uc870\ubb3c\uc5d0\ub294 \ub2e4\ub978 \ubcf4\ub108\uc2a4\uac00 \uc788\uc73c\ubbc0\ub85c \ud574\ub2f9 \ub0b4\uc6a9\uc5d0 \ub530\ub77c \uac74\uc124\ud558\uc2ed\uc2dc\uc624."}, {"question": "Warfare 1942\uc5d0\uc11c \uace0\uae09 \uc804\ucc28 \uc804\uc220\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c? Warfare1942\uc5d0\uc11c \uc9c0\ud615, \uce21\uba74 \uacf5\uaca9, \uc5f0\ud569 \uc791\uc804\uc744 \uc804\ucc28\uc640 \ud568\uaed8 \uc0ac\uc6a9\ud558\uc5ec \uc804\uc7a5\uc744 \uc9c0\ubc30\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc804\ucc28 \uc804\uc220\uc740 \uc2b9\ub9ac\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc9c0\ud615\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc2dc\uc57c \ud655\ubcf4 \ubc0f \uc740\ud3d0\ub97c \uc704\ud574 \uc5b8\ub355\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \uce21\uba74 \uacf5\uaca9\uc740 \ud30c\uad34\uc801\uc785\ub2c8\ub2e4. \uc801\uc744 \ud3ec\uc704\ud558\uc5ec \uc5ec\ub7ec \uba74\uc5d0\uc11c \uacf5\uaca9\ud558\uc2ed\uc2dc\uc624. \uc5f0\ud569 \uc791\uc804\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \ud3ec\ubcd1 \ud3ec\uaca9\uc73c\ub85c \uc801\uc744 \uc5b5\uc81c\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \ubcf4\ubcd1\uc744 \uc9c4\uc785\uc2dc\ucf1c \uc0ac\uaca9\uc744 \uc720\ub3c4\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \uadf8\ub7f0 \ub2e4\uc74c \uc57d\ud654\ub41c \ubc29\uc5b4\ub97c \ud65c\uc6a9\ud558\uae30 \uc704\ud574 \uc804\ucc28\ub97c \ud480\uc5b4\uc90d\ub2c8\ub2e4. \uc608: \uc232 \uc9c0\ub3c4\uc5d0\uc11c \uc804\ucc28\ub97c \uc9c1\uc811 \uc9c4\uc785\uc2dc\ud0a4\uc9c0 \ub9c8\uc2ed\uc2dc\uc624. \uba3c\uc800 \ubcf4\ubcd1\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc232\uc744 \uc815\ub9ac\ud55c \ub2e4\uc74c \uc804\ucc28\ub97c \ud22c\uc785\ud558\uc5ec \uacb0\uc815\uc801\uc778 \ud0c0\uaca9\uc744 \uac00\ud558\uc2ed\uc2dc\uc624. \uc804\ucc28\ub97c \ub9dd\uce58\uc640 \ub9dd\uce58 \uc804\uc220\uc5d0\uc11c \ub9dd\uce58\ub85c \uc0dd\uac01\ud558\uace0, \ubcf4\ubcd1\uc740 \uc801\uc744 \uc81c\uc790\ub9ac\uc5d0 \uc720\uc9c0\ud569\ub2c8\ub2e4."}, {"question": "1942\ub144 \uc804\uc7c1\uc5d0\uc11c \uae30\uc220 \uc5f0\uad6c\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c? \uacf5\uaca9\uc801 \ubc0f \ubc29\uc5b4\uc801 \uc804\ub7b5\uacfc \uac19\uc740 \ub2e4\ub978 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc744 \uc704\ud574 \uc5b4\ub5a4 \uae30\uc220\uc744 \uc6b0\uc120 \uc21c\uc704\ub85c \uc0bc\uc544\uc57c \ud569\ub2c8\uae4c?", "answer": "\uae30\uc220\uc740 \uad70\uc0ac\ub825\uc758 \ud575\uc2ec\uc785\ub2c8\ub2e4. \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub530\ub77c \uae30\uc220\uc744 \uc6b0\uc120 \uc21c\uc704\ub85c \uc124\uc815\ud558\uc2ed\uc2dc\uc624. \uacf5\uaca9\uc801\uc778 \ud50c\ub808\uc774\uc5b4\ub294 \uac1c\uc120\ub41c \uc804\ucc28 \uc7a5\uac11 \ubc0f \ud3ec\ubcd1 \uc0ac\uac70\ub9ac\uc640 \uac19\uc740 \uc720\ub2db \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. \ubc29\uc5b4\uc801\uc778 \ud50c\ub808\uc774\uc5b4\ub294 \ubc29\uc5b4 \uad6c\uc870, \uc800\ub834\ud55c \uac74\uc124 \ube44\uc6a9 \ubc0f \uc694\uc0c8\ud654\ub41c \uc704\uce58\ub97c \ud65c\uc6a9\ud569\ub2c8\ub2e4. \uacf5\uaca9\uc801\uc778 \uc804\ub7b5\uc5d0\uc11c\ub294 \ucd08\uae30\uc5d0 \uace0\uae09 \uc804\ucc28 \uc7a5\uac11\uc744 \uc5f0\uad6c\ud558\uc2ed\uc2dc\uc624. \ubc29\uc5b4 \uc804\ub7b5\uc5d0\uc11c\ub294 \ub808\uc774\ub354 \ubc0f \ub300\uacf5 \uae30\uc220\uc5d0 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \uae30\uc220 \ud2b8\ub9ac\ub97c \uac08\ub77c\uc9c0\ub294 \uae38\ub85c \uc0c1\uc0c1\ud574\ubcf4\uc2ed\uc2dc\uc624. \ucd08\uae30\uc5d0 \uc804\ucc28 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc120\ud0dd\ud558\uba74 \uc804\ucc28 \uc911\uc2ec \uc804\ub7b5\uc5d0 \uac07\ud788\uac8c \ub429\ub2c8\ub2e4. \uacf5\uc911 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc120\ud0dd\ud558\uba74 \uacf5\uc911 \uc6b0\uc138\ub97c \ud5a5\ud55c \uc0c8\ub85c\uc6b4 \uae38\uc774 \uc5f4\ub9bd\ub2c8\ub2e4."}, {"question": "1942\ub144 \uc804\uc7c1\uc5d0\uc11c \ud611\uc870\uc801\uc778 \uacf5\uc2b5 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c? Warfare1942\uc5d0\uc11c \uc804\ub7b5\uc801 \ud3ed\uaca9\uc744 \uc9c0\uc0c1 \uacf5\uaca9\uacfc \uacb0\ud569\ud558\uc5ec \ud53c\ud574\ub97c \ucd5c\ub300\ud654\ud558\uace0 \uc190\uc2e4\uc744 \ucd5c\uc18c\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud611\uc870\uc801\uc778 \uacf5\uc2b5\uc740 \ud30c\uad34\uc801\uc785\ub2c8\ub2e4. \uba3c\uc800, \uc6b0\uc8fc \uc9c0\ubc30\ub97c \ud655\ub9bd\ud558\uc2ed\uc2dc\uc624. \uadf8\ub7f0 \ub2e4\uc74c, \ubaa9\ud45c\ub97c \uc6b0\uc120\uc2dc\ud558\uc2ed\uc2dc\uc624. \uc804\ub7b5\uc801 \ud3ed\uaca9\uc740 \uacf5\uc7a5 \ubc0f \uc790\uc6d0 \ub178\ub4dc\uc640 \uac19\uc740 \uae30\ubc18 \uc2dc\uc124\uc744 \ub300\uc0c1\uc73c\ub85c \ud574\uc57c \ud569\ub2c8\ub2e4. \uc804\uc220\uc801 \ud3ed\uaca9\uc740 \uc801 \uc720\ub2db\uc744 \ub300\uc0c1\uc73c\ub85c \ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \uc804\ud22c\uae30\ub85c \uc801 \ub300\uacf5 \ubc29\uc5b4\ub97c \uc5b5\uc81c\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \ud3ed\uaca9\uae30\ub97c \ubcf4\ub0b4 \uc801 \uc0dd\uc0b0\uc744 \ub9c8\ube44\uc2dc\ud0b5\ub2c8\ub2e4. 3\ub2e8\uacc4: \ud63c\ub780\uc744 \ud2c8\ud0c0 \uc9c0\uc0c1 \uacf5\uaca9\uc744 \uc2dc\uc791\ud569\ub2c8\ub2e4. \uc608: \uc804\uc220 \ud3ed\uaca9\uae30\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc801 \uc804\ucc28 \ud3b8\ub300\uac00 \uc804\uc120\uc5d0 \ub3c4\ub2ec\ud558\uae30 \uc804\uc5d0 \ud30c\uad34\ud55c \ub2e4\uc74c, \uc804\ucc28\ub85c \ubc18\uaca9\ud558\uc2ed\uc2dc\uc624. \uc774\ub294 \ubcf5\uc2f1 \uc120\uc218\uac00 \ub109\uc544\uc6c3\ud380\uce58\ub97c \uc704\ud574 \uc7bd\uc744 \uc0ac\uc6a9\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4."}, {"question": "1942\ub144 \uc804\uc7c1\uc758 \uc804\ud22c \uacc4\uc0b0 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c? \uc5b4\ub5a4 \ud1b5\uacc4\uac00 \uc804\ud22c\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\uace0 Warfare1942\ub294 \uc5b4\ub5bb\uac8c \ud53c\ud574\ub97c \uacc4\uc0b0\ud569\ub2c8\uae4c? \uc2e4\uc81c \uc22b\uc790\ub97c \uc81c\uacf5\ud558\uc2ed\uc2dc\uc624.", "answer": "Warfare 1942\uc758 \uc804\ud22c \uc2dc\uc2a4\ud15c\uc5d0\ub294 \uc5ec\ub7ec \uc694\uc18c\uac00 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc720\ub2db \uacf5\uaca9, \ubc29\uc5b4, \uc7a5\uac11 \ubc0f \uc9c0\ud615 \ubcf4\uc815\uc774 \ubaa8\ub450 \uc5ed\ud560\uc744 \ud569\ub2c8\ub2e4. \ud53c\ud574\ub294 \uc77c\ubc18\uc801\uc73c\ub85c (\uacf5\uaca9\uc790\uc758 \uacf5\uaca9 - \uc218\ube44\uc790\uc758 \uc7a5\uac11) * \uc218\uc815\uc790\ub85c \uacc4\uc0b0\ub429\ub2c8\ub2e4. \uacf5\uaca9\uc774 \uc7a5\uac11\uacfc \uac19\uac70\ub098 \uc791\uc73c\uba74 \ucd5c\uc18c \ud53c\ud574\uac00 \uc801\uc6a9\ub429\ub2c8\ub2e4. \uc9c0\ud615\uc740 \uc9c0\ud615\uc5d0 \ub530\ub77c \ud53c\ud574\ub97c 20-50% \uac10\uc18c \ub610\ub294 \uc99d\uac00\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc804\ucc28(\uacf5\uaca9 50, \uc7a5\uac11 30)\uac00 \ud3c9\uc6d0\uc5d0\uc11c \ubcf4\ubcd1(\ubc29\uc5b4 20, \uc7a5\uac11 10)\uc744 \uacf5\uaca9\ud558\uba74 (50-10) * 1 = 40\uc758 \ud53c\ud574\uac00 \ubc1c\uc0dd\ud569\ub2c8\ub2e4. \uc774\uc81c \uac19\uc740 \uc804\ucc28\uac00 \uc0b0\uc545 \uc9c0\ud615\uc5d0\uc11c \uac19\uc740 \ubcf4\ubcd1 \uc720\ub2db\uc744 \uacf5\uaca9\ud558\uba74 (50-10) * 0.5 = 20\uc758 \ud53c\ud574\uac00 \ubc1c\uc0dd\ud569\ub2c8\ub2e4. \ubc29\uc5b4 \uc720\ub2db\uc758 \uccb4\ub825\uc774 \ub0ae\uc744\uc218\ub85d \ud53c\ud574\ub97c \ubc1b\uc73c\uba74\uc11c \ub354 \ube68\ub9ac \uc8fd\uc2b5\ub2c8\ub2e4."}, {"question": "1942\ub144 \uc804\uc7c1\uc5d0\uc11c \uc0ac\uae30\uc758 \uc601\ud5a5\uc740 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \uc99d\uac00 \ub610\ub294 \uac10\uc18c\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\uae4c? \uc22b\uc790 \ud6a8\uacfc\ub294 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c Warfare1942 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ubcc0\uacbd\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc0ac\uae30\ub294 \uc720\ub2db \ud6a8\uc728\uc131\uc5d0 \ud070 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ub192\uc740 \uc0ac\uae30\ub294 \uacf5\uaca9\uacfc \ubc29\uc5b4\ub97c \ub192\uc774\uace0, \ub0ae\uc740 \uc0ac\uae30\ub294 \uc774\ub97c \uc904\uc785\ub2c8\ub2e4. \uc0ac\uae30\ub294 \ucd5c\uadfc \uc2b9\ub9ac, \ud328\ubc30 \ubc0f \ubcf4\uae09 \ub77c\uc778\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \uc720\ub2db\uc744 \ubcf4\uae09\ud558\uace0 \uc804\ud22c\uc5d0\uc11c \uc774\uae30\uba74 \uc0ac\uae30\ub97c \ub192\uc785\ub2c8\ub2e4. \uc804\ud22c\uc5d0\uc11c \uc9c0\uace0 \ubcf4\uae09 \ub77c\uc778\uc774 \ub04a\uc5b4\uc9c0\uba74 \uc0ac\uae30\uac00 \ub0ae\uc544\uc9d1\ub2c8\ub2e4. \ud6a8\uacfc\ub294 \ud1b5\uacc4 \uc99d\uac00 \ub610\ub294 \uac10\uc18c\uc5d0 \ub530\ub77c 10~30%\uc758 \ubc94\uc704\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc0ac\uae30\uac00 30% \uc99d\uac00\ud55c \uc720\ub2db\uc740 \uac70\uc758 \ub450 \uac1c\uc758 \uc720\ub2db\uacfc \uac19\uc73c\uba70 \ub354 \ud6a8\uacfc\uc801\uc73c\ub85c \ub2e4\ub978 \uad70\ub300\ub97c \ub6ab\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubc18\ub300\ub85c, \uc0ac\uae30\uac00 \ub0ae\uc544\uc9c4 \uad70\ub300\ub294 \ubb34\uc6a9\ud558\uace0 \ucca0\uc218\ud558\ub294 \uac83\uc774 \uc88b\uc744 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "PC \uc0ac\uc6a9\uc790\uc785\ub2c8\ub2e4. \ud734\ub300\ud3f0\uc73c\ub85c Warfare 1942\ub97c \ud50c\ub808\uc774\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c? Warfare1942\uc758 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \uc635\uc158\uacfc \uacc4\uc815 \ub3d9\uae30\ud654 \uac00\ub2a5\uc131\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Warfare 1942\ub294 \ud604\uc7ac PC \ubc0f \ube0c\ub77c\uc6b0\uc800\uc5d0\uc11c\ub9cc \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubaa8\ubc14\uc77c \ubc84\uc804\uc740 \uac1c\ubc1c \uc911\uc774\uc9c0\ub9cc \ud604\uc7ac \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \uc635\uc158\uc740 \uc5c6\uc2b5\ub2c8\ub2e4. PC\uc640 \ubaa8\ubc14\uc77c \uae30\uae30\uc5d0\uc11c \uac8c\uc784\uc744 \ud50c\ub808\uc774\ud558\uace0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uacc4\uc18d\ud560 \uc218 \uc788\ub3c4\ub85d \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud638\ud658\uc131\uc774 \uacc4\ud68d\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uacc4\uc815\uc744 \ud1b5\ud574 \ub370\uc774\ud130, \uc9c4\ud589 \uc0c1\ud669 \ubc0f \uad6c\ub9e4\ub97c \uc7a5\uce58 \uac04\uc5d0 \ub3d9\uae30\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubaa8\ubc14\uc77c \ucd9c\uc2dc \ubc0f \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \uae30\ub2a5\uc5d0 \ub300\ud55c \ubc1c\ud45c\ub97c \uae30\ub300\ud558\uc2ed\uc2dc\uc624!"}, {"question": "Warfare 1942\uc5d0 \ube44\ubc00 \uc720\ub2db \ub610\ub294 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\uae4c? Warfare1942\uc5d0\uc11c \uc5b4\ub5bb\uac8c \ud574\uc81c \ub610\ub294 \ucc3e\uc544\uc11c \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Warfare 1942\uc5d0\ub294 \ud5cc\uc2e0\uc801\uc778 \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc720\ub2db \ubc0f \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4! \ud55c \uc608\uac00 \ucea0\ud398\uc778 \ud6c4\ubc18\uc5d0 \ud2b9\uc815 \uc12c \uc601\ud1a0\ub97c \uc810\ub839\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc774\ub807\uac8c \ud558\uba74 \ub3c5\ud2b9\ud55c \ub2a5\ub825\uc744 \uac00\uc9c4 \ub4dc\ubb38 \uc2e4\ud5d8\uc6a9 \ud56d\uacf5\uae30\uac00 \ud574\uc81c\ub429\ub2c8\ub2e4. \ub2e4\ub978 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ud2b9\uc815 \uc131\ucde8\ub3c4\ub97c \ub2ec\uc131\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc774\uac83\uc740 \uac15\ub825\ud55c \uc9c0\ub3c4\ub825 \uae30\uc220\uc744 \uac00\uc9c4 \uc228\uaca8\uc9c4 \uc7a5\uad70\uc5d0\uac8c \uc811\uadfc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ube44\ubc00\uc740 \uc804\ub7b5\uc801 \uc635\uc158\uc744 \uac15\ud654\ud558\uace0 \uc5b4\ub824\uc6b4 \uc0c1\ud669\uc5d0\uc11c \uc6b0\uc704\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uc744 \ucc3e\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc131\uacf5\ud558\uba74 \ub3c5\ud2b9\ud55c \ubcf4\uc0c1\uacfc \uc790\ub791\uac70\ub9ac\uac00 \uc8fc\uc5b4\uc9d1\ub2c8\ub2e4!"}]
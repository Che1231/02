[{"question": "\u6230\u722d 1942 \u65b0\u624b\u5165\u9580\uff1a\u5982\u4f55\u63a7\u5236\u57fa\u672c\u64cd\u4f5c\u4e26\u6709\u6548\u79fb\u52d5\u6211\u7684\u90e8\u968a\uff0c\u4ee5\u907f\u514d\u904a\u6232\u521d\u671f\u640d\u5931\uff1f", "answer": "\u6b61\u8fce\u4f86\u5230\u6230\u722d 1942\uff01\u57fa\u672c\u63a7\u5236\u5305\u62ec\u4f7f\u7528\u6ed1\u9f20\u9078\u53d6\u90e8\u968a\uff0c\u7136\u5f8c\u9ede\u64ca\u53f3\u9375\u79fb\u52d5\u5b83\u5011\u3002\u8981\u6709\u6548\u79fb\u52d5\uff0c\u8acb\u8003\u616e\u4e0d\u540c\u5175\u7a2e\u7684\u7279\u6027\u3002\u6b65\u5175\u9069\u5408\u653b\u4f54\u57ce\u5e02\uff0c\u5766\u514b\u9069\u5408\u91ce\u5916\u4f5c\u6230\uff0c\u800c\u7832\u5175\u5247\u9069\u5408\u9060\u7a0b\u652f\u63f4\u3002\u4f8b\u5982\uff0c\u5728\u653b\u64ca\u6642\uff1a\u6b65\u9a5f 1\uff1a\u5229\u7528\u5ec9\u50f9\u55ae\u4f4d\u5075\u5bdf\u5340\u57df\uff0c\u6b65\u9a5f 2\uff1a\u5c07\u7832\u5175\u90e8\u7f72\u65bc\u652f\u63f4\u4f4d\u7f6e\uff0c\u6b65\u9a5f 3\uff1a\u6d3e\u9063\u5766\u514b\u548c\u6b65\u5175\u5be6\u65bd\u653b\u64ca\u3002\u5e38\u898b\u932f\u8aa4\u662f\u55ae\u7368\u6d3e\u9063\u6b65\u5175\u5c0d\u6297\u5766\u514b\u3002\u52d9\u5fc5\u904b\u7528\u7d9c\u5408\u5175\u7a2e\u6230\u8853\u3002\u60f3\u50cf\u4e00\u4e0b\uff0c\u5c31\u50cf\u77f3\u982d\u526a\u5200\u5e03\uff1a\u6b65\u5175\u6230\u52dd\u7832\u5175\uff0c\u5766\u514b\u6230\u52dd\u6b65\u5175\uff0c\u7832\u5175\u6230\u52dd\u5766\u514b\u3002"}, {"question": "\u8cc7\u6e90\u7ba1\u7406\u5728\u6230\u722d 1942 \u4e2d\u70ba\u4f55\u81f3\u95dc\u91cd\u8981\uff1f\u5728\u6230\u722d 1942 \u7684\u904a\u6232\u521d\u671f\uff0c\u5982\u4f55\u5feb\u901f\u7372\u5f97\u8cc7\u6e90\uff0c\u4e26\u907f\u514d\u8cc7\u6e90\u5331\u4e4f\uff1f", "answer": "\u5728\u6230\u722d 1942 \u4e2d\uff0c\u8cc7\u6e90\u7ba1\u7406\u5c0d\u65bc\u7dad\u6301\u6230\u722d\u52aa\u529b\u81f3\u95dc\u91cd\u8981\u3002\u6c92\u6709\u8cc7\u6e90\uff0c\u60a8\u5c31\u7121\u6cd5\u5efa\u9020\u90e8\u968a\u6216\u7814\u7a76\u79d1\u6280\u3002\u904a\u6232\u521d\u671f\uff0c\u61c9\u512a\u5148\u4f54\u9818\u5bcc\u542b\u8cc7\u6e90\u7684\u9818\u571f\uff0c\u4f8b\u5982\u6cb9\u7530\u548c\u5de5\u696d\u5340\u3002\u512a\u5148\u65bc\u6230\u7565\u50f9\u503c\u9ad8\u4f46\u8cc7\u6e90\u8ca7\u4e4f\u7684\u5730\u5340\u3002\u60a8\u9084\u53ef\u4ee5\u5efa\u9020\u7522\u751f\u8cc7\u6e90\u7684\u5efa\u7bc9\u7269\u3002\u5728\u5df2\u4f54\u9818\u7684\u9818\u571f\u9644\u8fd1\u5efa\u7acb\u88dc\u7d66\u7ad9\u975e\u5e38\u6709\u5229\u3002\u521d\u671f\u4e0d\u8981\u904e\u5ea6\u6295\u5165\u592a\u591a\u55ae\u4f4d\uff0c\u61c9\u81f4\u529b\u65bc\u5e73\u8861\u7684\u7d93\u6fdf\u3002\u8003\u616e\u4ee5\u4e0b\u6bd4\u8f03\uff1a\u521d\u671f\u5c07\u6240\u6709\u8cc7\u6e90\u6295\u5165\u5766\u514b\u8207\u5e73\u8861\u7684\u7b56\u7565\uff0c\u5982\u679c\u672a\u6295\u8cc7\u9632\u7a7a\u88dd\u5099\uff0c\u5247\u5f8c\u8005\u53ef\u80fd\u6703\u5728\u5f8c\u7e8c\u968e\u6bb5\u5bb9\u6613\u53d7\u5230\u7a7a\u8972\u7684\u5f71\u97ff\u3002\u5c31\u50cf\u84cb\u623f\u5b50\u4e00\u6a23\uff0c\u5805\u5be6\u7684\u57fa\u790e\u5c0d\u65bc\u9577\u671f\u7684\u6210\u529f\u662f\u5fc5\u8981\u7684\u3002"}, {"question": "\u5728\u6230\u722d 1942 \u4e2d\uff0c\u5982\u4f55\u5efa\u9020\u5efa\u7bc9\u7269\uff1f\u5728\u6230\u722d 1942 \u4e2d\uff0c\u5982\u4f55\u5c07\u6bcf\u5ea7\u5efa\u7bc9\u7269\u653e\u7f6e\u5728\u6700\u4f73\u5730\u9ede\uff0c\u4ee5\u7372\u5f97\u6700\u5927\u7684\u734e\u52f5\uff1f", "answer": "\u8981\u5728\u6230\u722d 1942 \u4e2d\u5efa\u9020\u5efa\u7bc9\u7269\uff0c\u8acb\u9078\u64c7\u5efa\u9020\u55ae\u4f4d\uff08\u4f8b\u5982\u5de5\u7a0b\u5e2b\uff09\uff0c\u7136\u5f8c\u9ede\u64ca\u60a8\u63a7\u5236\u7bc4\u570d\u5167\u7684\u53ef\u7528\u5efa\u7bc9\u4f4d\u7f6e\u3002\u4e0d\u540c\u9818\u571f\u70ba\u4e0d\u540c\u8cc7\u6e90\u63d0\u4f9b\u734e\u52f5\uff0c\u56e0\u6b64\u61c9\u6839\u64da\u5be6\u969b\u60c5\u6cc1\u5efa\u9020\u5efa\u7bc9\u7269\u3002\u5efa\u9020\u55ae\u4f4d\u9700\u8981\u9760\u8fd1\u60a8\u64c1\u6709\u7684\u9818\u571f\uff0c\u9078\u64c7\u8a72\u55ae\u4f4d\uff0c\u7136\u5f8c\u9078\u64c7\u5efa\u9020\u9078\u55ae\u3002\u8981\u6700\u5927\u5316\u734e\u52f5\uff0c\u8acb\u5728\u5efa\u9020\u524d\u6aa2\u67e5\u9818\u571f\u8cc7\u8a0a\u3002\u8003\u616e\u4e00\u500b\u77f3\u6cb9\u958b\u63a1\u91cf\u9ad8\u7684\u9818\u571f\uff0c\u4e26\u8a08\u5283\u5728\u6b64\u5efa\u9020\u7149\u6cb9\u5ee0\u3002\u60a8\u9700\u8981\u7372\u5f97\u8a72\u9818\u571f\u6240\u80fd\u63d0\u4f9b\u7684\u6700\u5927\u77f3\u6cb9\u7522\u91cf\uff0c\u4f7f\u5176\u6210\u70ba\u7406\u60f3\u7684\u5efa\u9020\u5730\u9ede\u3002\u4e0d\u540c\u5efa\u7bc9\u7269\u6709\u4e0d\u540c\u7684\u734e\u52f5\uff0c\u56e0\u6b64\u61c9\u76f8\u61c9\u5efa\u9020\u3002"}, {"question": "\u6230\u722d 1942 \u4e2d\u6709\u54ea\u4e9b\u5148\u9032\u7684\u5766\u514b\u6230\u8853\uff1f\u5982\u4f55\u5728\u6230\u722d 1942 \u4e2d\u5229\u7528\u5730\u5f62\u3001\u5074\u7ffc\u653b\u64ca\u548c\u7d9c\u5408\u5175\u7a2e\u4f86\u4e3b\u5bb0\u6230\u5834\uff1f", "answer": "\u5766\u514b\u6230\u8853\u5c0d\u65bc\u52dd\u5229\u81f3\u95dc\u91cd\u8981\u3002\u5730\u5f62\u81f3\u95dc\u91cd\u8981\uff1a\u5229\u7528\u4e18\u9675\u7372\u5f97\u8996\u91ce\u548c\u63a9\u8b77\u3002\u5074\u7ffc\u653b\u64ca\u6975\u5177\u7834\u58de\u6027\uff1b\u5c07\u6575\u4eba\u5305\u570d\uff0c\u5f9e\u591a\u500b\u5074\u9762\u653b\u64ca\u3002\u7d9c\u5408\u5175\u7a2e\u81f3\u95dc\u91cd\u8981\u3002\u6b65\u9a5f 1\uff1a\u4f7f\u7528\u7832\u5175\u8f5f\u70b8\u58d3\u5236\u6575\u4eba\uff0c\u6b65\u9a5f 2\uff1a\u6d3e\u9063\u6b65\u5175\u5438\u5f15\u706b\u529b\uff0c\u6b65\u9a5f 3\uff1a\u7136\u5f8c\uff0c\u767c\u52d5\u5766\u514b\u653b\u64ca\uff0c\u5229\u7528\u524a\u5f31\u7684\u9632\u79a6\u3002\u4f8b\u5982\uff1a\u5728\u68ee\u6797\u5730\u5716\u4e2d\uff0c\u4e0d\u8981\u8b93\u5766\u514b\u76f4\u63a5\u885d\u5165\u3002\u9996\u5148\u5229\u7528\u6b65\u5175\u6e05\u9664\u68ee\u6797\uff0c\u7136\u5f8c\u6d3e\u9063\u5766\u514b\u767c\u8d77\u6c7a\u5b9a\u6027\u653b\u64ca\u3002\u60f3\u50cf\u4e00\u4e0b\uff0c\u5766\u514b\u5c31\u50cf\u9318\u5b50\uff0c\u800c\u6b65\u5175\u5247\u626e\u6f14\u7827\u7684\u4f5c\u7528\uff0c\u5c07\u6575\u4eba\u56fa\u5b9a\u5728\u539f\u5730\u3002"}, {"question": "\u5728\u6230\u722d 1942 \u4e2d\uff0c\u70ba\u4f55\u7814\u7a76\u79d1\u6280\u5f88\u91cd\u8981\uff1f\u5c0d\u65bc\u4e0d\u540c\u7684\u904a\u6232\u98a8\u683c\uff08\u4f8b\u5982\u9032\u653b\u8207\u9632\u5b88\u7b56\u7565\uff09\uff0c\u6211\u61c9\u8a72\u512a\u5148\u7814\u7a76\u54ea\u4e9b\u79d1\u6280\uff1f", "answer": "\u79d1\u6280\u662f\u8ecd\u4e8b\u529b\u91cf\u7684\u652f\u67f1\u3002\u6839\u64da\u60a8\u7684\u904a\u6232\u98a8\u683c\u512a\u5148\u9078\u64c7\u79d1\u6280\u3002\u9032\u653b\u578b\u73a9\u5bb6\u61c9\u5c08\u6ce8\u65bc\u63d0\u5347\u55ae\u4f4d\u80fd\u529b\uff0c\u4f8b\u5982\u6539\u9032\u5766\u514b\u88dd\u7532\u548c\u7832\u5175\u5c04\u7a0b\u3002\u9632\u5b88\u578b\u73a9\u5bb6\u5247\u53d7\u76ca\u65bc\u9632\u79a6\u6027\u5efa\u7bc9\u7269\u3001\u8f03\u4f4e\u7684\u5efa\u9020\u6210\u672c\u548c\u5805\u56fa\u7684\u9632\u79a6\u9663\u5730\u3002\u5c0d\u65bc\u9032\u653b\u7b56\u7565\uff0c\u61c9\u8457\u91cd\u65bc\u65e9\u671f\u7814\u7a76\u5148\u9032\u5766\u514b\u88dd\u7532\u3002\u5c0d\u65bc\u9632\u5b88\u7b56\u7565\uff0c\u5247\u61c9\u5c08\u6ce8\u65bc\u96f7\u9054\u548c\u9632\u7a7a\u6280\u8853\u3002\u60f3\u50cf\u4e00\u4e0b\uff0c\u79d1\u6280\u6a39\u50cf\u4e00\u689d\u5206\u5c94\u7684\u9053\u8def\u3002\u9078\u64c7\u65e9\u671f\u7814\u7a76\u5766\u514b\u5347\u7d1a\u6703\u5c07\u60a8\u9396\u5b9a\u5728\u4ee5\u5766\u514b\u70ba\u4e3b\u7684\u7b56\u7565\u4e0a\u3002\u9078\u64c7\u7a7a\u4e2d\u5347\u7d1a\u6703\u958b\u555f\u901a\u5f80\u5236\u7a7a\u6b0a\u7684\u65b0\u8def\u3002"}, {"question": "\u5728\u6230\u722d 1942 \u4e2d\uff0c\u5354\u8abf\u7a7a\u8972\u6700\u6709\u6548\u7684\u7b56\u7565\u6709\u54ea\u4e9b\uff1f\u5982\u4f55\u5728\u6230\u722d 1942 \u4e2d\u5c07\u6230\u7565\u8f5f\u70b8\u8207\u5730\u9762\u653b\u64ca\u7d50\u5408\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u640d\u5bb3\u4e26\u5c07\u640d\u5931\u964d\u81f3\u6700\u4f4e\uff1f", "answer": "\u5354\u8abf\u7a7a\u8972\u5177\u6709\u6bc0\u6ec5\u6027\u3002\u9996\u5148\uff0c\u5efa\u7acb\u5236\u7a7a\u6b0a\u3002\u7136\u5f8c\uff0c\u512a\u5148\u8003\u616e\u76ee\u6a19\u3002\u6230\u7565\u8f5f\u70b8\u61c9\u91dd\u5c0d\u57fa\u790e\u8a2d\u65bd\uff0c\u4f8b\u5982\u5de5\u5ee0\u548c\u8cc7\u6e90\u7bc0\u9ede\u3002\u6230\u8853\u8f5f\u70b8\u61c9\u91dd\u5c0d\u6575\u65b9\u55ae\u4f4d\u3002\u6b65\u9a5f 1\uff1a\u4f7f\u7528\u5c08\u9580\u7684\u6230\u9b25\u6a5f\u58d3\u5236\u6575\u65b9\u9632\u7a7a\uff0c\u6b65\u9a5f 2\uff1a\u6d3e\u9063\u8f5f\u70b8\u6a5f\u7834\u58de\u6575\u65b9\u751f\u7522\uff0c\u6b65\u9a5f 3\uff1a\u767c\u52d5\u5730\u9762\u653b\u64ca\uff0c\u4e58\u8457\u6df7\u4e82\u4e4b\u6a5f\u3002\u4f8b\u5982\uff1a\u4f7f\u7528\u6230\u8853\u8f5f\u70b8\u6a5f\u6467\u6bc0\u6575\u65b9\u5766\u514b\u7de8\u968a\uff0c\u4f7f\u5176\u7121\u6cd5\u62b5\u9054\u60a8\u7684\u9632\u7dda\uff0c\u7136\u5f8c\u4f7f\u7528\u60a8\u81ea\u5df1\u7684\u5766\u514b\u9032\u884c\u53cd\u64ca\u3002\u9019\u5c31\u50cf\u62f3\u64ca\u624b\u7528\u52fe\u62f3\u8a2d\u7f6e\u64ca\u5012\u62f3\u4e00\u6a23\u3002"}, {"question": "\u6230\u722d 1942 \u7684\u6230\u9b25\u8a08\u7b97\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff1f\u54ea\u4e9b\u7d71\u8a08\u6578\u64da\u6703\u5f71\u97ff\u6230\u9b25\uff0c\u4ee5\u53ca\u6230\u722d 1942 \u5982\u4f55\u8a08\u7b97\u50b7\u5bb3\uff1f\u8acb\u63d0\u4f9b\u5be6\u969b\u6578\u5b57\u3002", "answer": "\u6230\u722d 1942 \u7684\u6230\u9b25\u7cfb\u7d71\u5305\u542b\u591a\u500b\u56e0\u7d20\u3002\u55ae\u4f4d\u7684\u653b\u64ca\u529b\u3001\u9632\u79a6\u529b\u3001\u88dd\u7532\u548c\u5730\u5f62\u4fee\u6b63\u90fd\u6703\u767c\u63ee\u4f5c\u7528\u3002\u50b7\u5bb3\u901a\u5e38\u8a08\u7b97\u70ba (\u653b\u64ca\u65b9\u653b\u64ca\u529b - \u9632\u79a6\u65b9\u88dd\u7532) * \u4fee\u6b63\u503c\u3002\u5982\u679c\u653b\u64ca\u529b\u5c0f\u65bc\u6216\u7b49\u65bc\u88dd\u7532\u503c\uff0c\u5247\u6703\u5957\u7528\u6700\u4f4e\u50b7\u5bb3\u3002\u5730\u5f62\u53ef\u80fd\u6703\u964d\u4f4e\u6216\u63d0\u9ad8\u50b7\u5bb3 20-50%\uff0c\u53d6\u6c7a\u65bc\u5730\u5f62\u985e\u578b\u3002\u4f8b\u5982\uff0c\u4e00\u8f1b\u5766\u514b (\u653b\u64ca\u529b 50\uff0c\u88dd\u7532 30) \u5728\u5e73\u539f\u653b\u64ca\u4e00\u8f1b\u6b65\u5175 (\u9632\u79a6\u529b 20\uff0c\u88dd\u7532 10)\uff0c\u5c07\u9020\u6210 (50-10)*1 = 40 \u9ede\u50b7\u5bb3\u3002\u73fe\u5728\uff0c\u540c\u4e00\u8f1b\u5766\u514b\u5728\u5c71\u5730\u653b\u64ca\u76f8\u540c\u7684\u6b65\u5175\u55ae\u4f4d\uff0c\u5c07\u9020\u6210 (50-10)*0.5 = 20 \u9ede\u50b7\u5bb3\u3002\u9632\u5b88\u55ae\u4f4d\u751f\u547d\u503c\u8d8a\u4f4e\uff0c\u6536\u5230\u7684\u50b7\u5bb3\u8d8a\u9ad8\uff0c\u8d8a\u5bb9\u6613\u9020\u6210\u6bba\u50b7\u3002"}, {"question": "\u58eb\u6c23\u5728\u6230\u722d 1942 \u4e2d\u7684\u5f71\u97ff\u662f\u4ec0\u9ebc\uff1f\u6211\u5982\u4f55\u63d0\u5347\u6216\u964d\u4f4e\u58eb\u6c23\uff1f\u6578\u503c\u6548\u679c\u70ba\u4f55\uff1f\u5982\u4f55\u6539\u8b8a\u6230\u722d 1942 \u7684\u904a\u6232\uff1f", "answer": "\u58eb\u6c23\u6703\u986f\u8457\u5f71\u97ff\u55ae\u4f4d\u7684\u6230\u9b25\u529b\u3002\u58eb\u6c23\u9ad8\u6642\uff0c\u653b\u64ca\u529b\u548c\u9632\u79a6\u529b\u6703\u63d0\u5347\uff0c\u800c\u58eb\u6c23\u4f4e\u6642\u5247\u6703\u4e0b\u964d\u3002\u58eb\u6c23\u53d7\u8fd1\u671f\u52dd\u5229\u3001\u640d\u5931\u548c\u88dc\u7d66\u7dda\u7684\u5f71\u97ff\u3002\u7dad\u6301\u90e8\u968a\u7684\u88dc\u7d66\u4e26\u7372\u52dd\uff0c\u5c07\u63d0\u5347\u58eb\u6c23\u3002\u5931\u6557\u7684\u6230\u9b25\u548c\u4e2d\u65b7\u7684\u88dc\u7d66\u7dda\u6703\u964d\u4f4e\u58eb\u6c23\u3002\u5f71\u97ff\u7bc4\u570d\u53ef\u4ee5\u662f 10-30% \u7684\u63d0\u5347\u6216\u964d\u4f4e\u72c0\u614b\u52a0\u6210\uff0c\u53d6\u6c7a\u65bc\u58eb\u6c23\u7684\u597d\u58de\u3002\u4f8b\u5982\uff0c\u4e00\u500b\u58eb\u6c23\u63d0\u5347 30% \u7684\u55ae\u4f4d\u5c31\u5982\u540c\u5169\u500b\u55ae\u4f4d\u7684\u7d44\u5408\uff0c\u653b\u64ca\u529b\u4ee5\u53ca\u9632\u79a6\u529b\u6703\u66f4\u6709\u6548\u7387\u3002\u53cd\u4e4b\uff0c\u58eb\u6c23\u4f4e\u843d\u7684\u90e8\u968a\u5c07\u8b8a\u5f97\u7121\u7528\uff0c\u64a4\u9000\u5c07\u6703\u66f4\u597d\u3002"}, {"question": "\u6211\u4f7f\u7528\u96fb\u8166\u3002\u6211\u53ef\u4ee5\u4f7f\u7528\u624b\u6a5f\u73a9\u6230\u722d 1942 \u55ce\uff1f\u6230\u722d 1942 \u7684\u8de8\u5e73\u53f0\u9078\u9805\u548c\u5e33\u6236\u540c\u6b65\u53ef\u80fd\u6027\u70ba\u4f55\uff1f", "answer": "\u76ee\u524d\uff0c\u6230\u722d 1942 \u50c5\u9650\u65bc\u96fb\u8166\u548c\u700f\u89bd\u5668\u5e73\u53f0\u3002\u76ee\u524d\u5c1a\u7121\u79fb\u52d5\u7aef\u7248\u672c\u3002\u9810\u8a08\u5c07\u652f\u6301\u8de8\u5e73\u53f0\u517c\u5bb9\u6027\uff0c\u8b93\u60a8\u53ef\u4ee5\u5728\u96fb\u8166\u548c\u884c\u52d5\u88dd\u7f6e\u4e0a\u904a\u73a9\uff0c\u4e26\u7e7c\u7e8c\u60a8\u7684\u9032\u5ea6\u3002\u5c07\u6fc0\u6d3b\u8de8\u5e73\u53f0\u7279\u6027\uff0c\u8b93\u60a8\u900f\u904e\u904a\u6232\u5e33\u865f\u540c\u6b65\u8de8\u8a2d\u5099\u7684\u6578\u64da\u3001\u9032\u5ea6\u548c\u8cfc\u8cb7\u9805\u76ee\u3002\u656c\u8acb\u95dc\u6ce8\u6709\u95dc\u79fb\u52d5\u7248\u672c\u767c\u5e03\u548c\u8de8\u5e73\u53f0\u529f\u80fd\u7684\u516c\u544a\uff01"}, {"question": "\u6230\u722d 1942 \u6709\u4efb\u4f55\u79d8\u5bc6\u55ae\u4f4d\u6216\u5f69\u86cb\u55ce\uff1f\u5b83\u5011\u662f\u4ec0\u9ebc\uff1f\u5982\u4f55\u5728\u6230\u722d 1942 \u4e2d\u89e3\u9396\u6216\u627e\u5230\u5b83\u5011\uff0c\u4ee5\u7372\u5f97\u512a\u52e2\uff1f", "answer": "\u6230\u722d 1942 \u4e2d\u78ba\u5be6\u6709\u4e00\u4e9b\u96b1\u85cf\u55ae\u4f4d\u548c\u5f69\u86cb\uff0c\u4f9b\u71b1\u8877\u73a9\u5bb6\u63a2\u7d22\uff01\u5176\u4e2d\u4e00\u500b\u4f8b\u5b50\u662f\u904a\u6232\u5f8c\u671f\u4f54\u9818\u7279\u5b9a\u5cf6\u5dbc\u9818\u571f\u3002\u9019\u5c07\u89e3\u9396\u4e00\u7a2e\u7a00\u6709\u5be6\u9a57\u6027\u98db\u6a5f\uff0c\u64c1\u6709\u7368\u7279\u7684\u6280\u80fd\u3002\u53e6\u4e00\u500b\u5f69\u86cb\u662f\u9054\u6210\u7279\u5b9a\u6210\u5c31\u3002\u9019\u5c07\u7372\u5f97\u4e00\u500b\u64c1\u6709\u5f37\u5927\u9818\u5c0e\u6280\u80fd\u7684\u96b1\u85cf\u5c07\u8ecd\u3002\u9019\u4e9b\u79d8\u5bc6\u53ef\u4ee5\u64f4\u5c55\u60a8\u7684\u7b56\u7565\u9078\u64c7\uff0c\u4e26\u5728\u5177\u6709\u6311\u6230\u6027\u7684\u60c5\u6cc1\u4e0b\u63d0\u4f9b\u512a\u52e2\u3002\u60f3\u50cf\u4e00\u4e0b\uff0c\u5c0b\u627e\u96b1\u85cf\u5bf6\u85cf\uff1b\u6210\u529f\u5e36\u4f86\u4e86\u7368\u7279\u7684\u734e\u52f5\u548c\u70ab\u8000\u7684\u6b0a\u5229\uff01"}]
[{"question": "Warfare 1942\u521d\u5fc3\u8005\u306e\u305f\u3081\u306e\u5165\u9580\uff1a\u57fa\u672c\u64cd\u4f5c\u3068\u3001Warfare1942\u3067\u521d\u671f\u306e\u640d\u5931\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u90e8\u968a\u3092\u52b9\u679c\u7684\u306b\u79fb\u52d5\u3059\u308b\u65b9\u6cd5\u3092\u6559\u3048\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "Warfare 1942\u3078\u3088\u3046\u3053\u305d\uff01\u57fa\u672c\u64cd\u4f5c\u306f\u3001\u30de\u30a6\u30b9\u3067\u90e8\u968a\u3092\u9078\u629e\u3057\u3001\u53f3\u30af\u30ea\u30c3\u30af\u3067\u79fb\u52d5\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u52b9\u679c\u7684\u306b\u79fb\u52d5\u3059\u308b\u306b\u306f\u3001\u90e8\u968a\u306e\u7a2e\u985e\u3092\u8003\u616e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6b69\u5175\u306f\u90fd\u5e02\u306e\u5360\u9818\u306b\u9069\u3057\u3066\u304a\u308a\u3001\u6226\u8eca\u306f\u958b\u3051\u305f\u6226\u3001\u7832\u5175\u306f\u9060\u8ddd\u96e2\u652f\u63f4\u306b\u9069\u3057\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u653b\u6483\u3059\u308b\u5834\u5408\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u5b89\u4fa1\u306a\u90e8\u968a\u3067\u30a8\u30ea\u30a2\u3092\u5075\u5bdf\u3059\u308b\u3001\u30b9\u30c6\u30c3\u30d72\uff1a\u652f\u63f4\u306e\u305f\u3081\u306b\u7832\u5175\u3092\u914d\u7f6e\u3059\u308b\u3001\u30b9\u30c6\u30c3\u30d73\uff1a\u6226\u8eca\u3068\u6b69\u5175\u3092\u6295\u5165\u3057\u3066\u653b\u6483\u3092\u59cb\u3081\u308b\u3002\u3088\u304f\u3042\u308b\u9593\u9055\u3044\u306f\u3001\u6226\u8eca\u306b\u5bfe\u3057\u3066\u6b69\u5175\u3060\u3051\u3092\u9001\u308a\u8fbc\u3080\u3053\u3068\u3067\u3059\u3002\u5e38\u306b\u7d71\u5408\u6226\u8853\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u306f\u3001\u3058\u3083\u3093\u3051\u3093\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u6b69\u5175\u306f\u7832\u5175\u306b\u52dd\u3064\u3001\u6226\u8eca\u306f\u6b69\u5175\u306b\u52dd\u3064\u3001\u7832\u5175\u306f\u6226\u8eca\u306b\u52dd\u3064\u3002"}, {"question": "Warfare 1942\u3067\u8cc7\u6e90\u7ba1\u7406\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1fWarfare1942\u3067\u521d\u671f\u306b\u8cc7\u6e90\u3092\u5f97\u308b\u6700\u901f\u306e\u65b9\u6cd5\u3068\u3001\u8cc7\u6e90\u4e0d\u8db3\u3092\u907f\u3051\u308b\u65b9\u6cd5\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Warfare 1942\u3067\u6226\u4e89\u3092\u7d99\u7d9a\u3059\u308b\u306b\u306f\u3001\u8cc7\u6e90\u7ba1\u7406\u304c\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u8cc7\u6e90\u304c\u306a\u3051\u308c\u3070\u3001\u90e8\u968a\u3092\u5efa\u9020\u3057\u305f\u308a\u3001\u6280\u8853\u3092\u7814\u7a76\u3057\u305f\u308a\u3067\u304d\u307e\u305b\u3093\u3002\u521d\u671f\u6bb5\u968e\u3067\u306f\u3001\u77f3\u6cb9\u7530\u3084\u5de5\u696d\u5730\u5e2f\u306a\u3069\u306e\u8cc7\u6e90\u8c4a\u5bcc\u306a\u5730\u57df\u3092\u5360\u9818\u3059\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6226\u7565\u7684\u306b\u4fa1\u5024\u306e\u3042\u308b\u304c\u8cc7\u6e90\u306e\u5c11\u306a\u3044\u5730\u57df\u3088\u308a\u3082\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u8cc7\u6e90\u3092\u751f\u307f\u51fa\u3059\u5efa\u9020\u7269\u3082\u5efa\u8a2d\u3067\u304d\u307e\u3059\u3002\u5360\u9818\u3057\u305f\u5730\u57df\u8fd1\u304f\u306b\u88dc\u7d66\u57fa\u5730\u3092\u5efa\u8a2d\u3059\u308b\u3068\u975e\u5e38\u306b\u6709\u5229\u3067\u3059\u3002\u521d\u671f\u6bb5\u968e\u3067\u305f\u304f\u3055\u3093\u306e\u90e8\u968a\u306b\u591a\u984d\u306e\u8cc7\u91d1\u3092\u8cbb\u3084\u3055\u306a\u3044\u3067\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u53d6\u308c\u305f\u7d4c\u6e08\u3092\u7dad\u6301\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u521d\u671f\u306b\u6226\u8eca\u306b\u5168\u8cc7\u6e90\u3092\u8cbb\u3084\u3059\u3053\u3068\u3068\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u30a2\u30d7\u30ed\u30fc\u30c1\u3092\u6bd4\u8f03\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u822a\u7a7a\u6a5f\u9632\u885b\u306b\u6295\u8cc7\u3057\u3066\u3044\u306a\u3044\u5834\u5408\u3001\u5f8c\u3067\u7a7a\u8972\u3092\u53d7\u3051\u3084\u3059\u304f\u306a\u308a\u307e\u3059\u3002\u5bb6\u306f\u5efa\u3066\u308b\u6642\u3001\u3057\u3063\u304b\u308a\u3068\u3057\u305f\u57fa\u790e\u304c\u9577\u671f\u7684\u306a\u6210\u529f\u306b\u3068\u3063\u3066\u91cd\u8981\u3067\u3042\u308b\u3088\u3046\u306b\u3002"}, {"question": "Warfare 1942\u3067\u69cb\u9020\u7269\u3092\u3069\u306e\u3088\u3046\u306b\u5efa\u8a2d\u3057\u307e\u3059\u304b\uff1fWarfare1942\u3067\u3069\u306e\u3088\u3046\u306a\u69cb\u9020\u7269\u3092\u3069\u306e\u5834\u6240\u306b\u5efa\u8a2d\u3059\u308b\u3053\u3068\u3067\u3001\u5404\u5efa\u9020\u7269\u306b\u6700\u5927\u306e\u30dc\u30fc\u30ca\u30b9\u3092\u5f97\u3089\u308c\u307e\u3059\u304b\uff1f", "answer": "Warfare 1942\u3067\u69cb\u9020\u7269\u3092\u5efa\u8a2d\u3059\u308b\u306b\u306f\u3001\u5efa\u8a2d\u90e8\u968a\uff08\u30a8\u30f3\u30b8\u30cb\u30a2\u306a\u3069\uff09\u3092\u9078\u629e\u3057\u3001\u81ea\u5206\u306e\u652f\u914d\u5730\u57df\u5185\u306e\u7a7a\u304d\u5efa\u9020\u7269\u30b9\u30ed\u30c3\u30c8\u3092\u30af\u30ea\u30c3\u30af\u3057\u307e\u3059\u3002\u7570\u306a\u308b\u5730\u57df\u306f\u7570\u306a\u308b\u8cc7\u6e90\u306b\u30dc\u30fc\u30ca\u30b9\u3092\u4e0e\u3048\u307e\u3059\u306e\u3067\u3001\u9069\u5207\u306b\u69cb\u9020\u7269\u3092\u5efa\u8a2d\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u5efa\u8a2d\u90e8\u968a\u306f\u81ea\u5206\u304c\u6240\u6709\u3057\u3066\u3044\u308b\u5730\u57df\u306b\u8fd1\u304f\u306a\u3051\u308c\u3070\u306a\u308a\u307e\u305b\u3093\u3002\u305d\u306e\u90e8\u968a\u3092\u9078\u629e\u3057\u3001\u5efa\u8a2d\u30e1\u30cb\u30e5\u30fc\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u30dc\u30fc\u30ca\u30b9\u306e\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u5efa\u8a2d\u3059\u308b\u524d\u306e\u5730\u57df\u306e\u72b6\u6cc1\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u77f3\u6cb9\u306e\u63a1\u6398\u91cf\u304c\u5927\u304d\u3044\u5730\u57df\u3092\u60f3\u5b9a\u3057\u3001\u305d\u306e\u5730\u57df\u306b\u7cbe\u88fd\u30d7\u30e9\u30f3\u30c8\u3092\u5efa\u8a2d\u3059\u308b\u8a08\u753b\u3092\u7acb\u3066\u3066\u304f\u3060\u3055\u3044\u3002\u305d\u3053\u304b\u3089\u5f97\u3089\u308c\u308b\u77f3\u6cb9\u751f\u7523\u91cf\u3092\u6700\u5927\u5316\u3057\u305f\u3044\u306e\u3067\u3001\u6700\u9069\u306a\u5834\u6240\u3067\u3059\u3002\u3055\u307e\u3056\u307e\u306a\u69cb\u9020\u7269\u306b\u306f\u3055\u307e\u3056\u307e\u306a\u30dc\u30fc\u30ca\u30b9\u304c\u3042\u308b\u306e\u3067\u3001\u305d\u308c\u306b\u5fdc\u3058\u3066\u9069\u5b9c\u5efa\u9020\u7269\u3092\u4f5c\u6210\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "Warfare 1942\u3067\u9ad8\u5ea6\u306a\u6226\u8eca\u6226\u8853\u306f\u4f55\u3067\u3059\u304b\uff1fWarfare1942\u3067\u5730\u5f62\u3001\u5074\u9762\u653b\u6483\u3001\u304a\u3088\u3073\u7d71\u5408\u6226\u8853\u3092\u6226\u8eca\u3068\u3068\u3082\u306b\u4f7f\u7528\u3057\u3066\u6226\u5834\u3067\u512a\u4f4d\u306b\u7acb\u3064\u65b9\u6cd5\u306f\uff1f", "answer": "\u6226\u8eca\u306f\u52dd\u5229\u306e\u305f\u3081\u306e\u91cd\u8981\u306a\u8981\u7d20\u3067\u3059\u3002\u5730\u5f62\u304c\u91cd\u8981\u3067\u3059\uff1a\u8996\u754c\u3068\u96a0\u853d\u306e\u305f\u3081\u306b\u4e18\u9675\u3092\u5229\u7528\u3057\u307e\u3059\u3002\u5074\u9762\u653b\u6483\u306f\u7834\u58ca\u7684\u3067\u3059\u3002\u6575\u3092\u5305\u56f2\u3057\u3066\u8907\u6570\u306e\u5074\u9762\u304b\u3089\u653b\u6483\u3057\u307e\u3059\u3002\u7d71\u5408\u6226\u8853\u306f\u91cd\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u7832\u5175\u3067\u6575\u3092\u6291\u5236\u3059\u308b\u3001\u30b9\u30c6\u30c3\u30d72\uff1a\u6b69\u5175\u3092\u6295\u5165\u3057\u3066\u6575\u306e\u653b\u6483\u3092\u5f15\u304d\u3064\u3051\u3001\u30b9\u30c6\u30c3\u30d73\uff1a\u305d\u306e\u5f8c\u3001\u6226\u8eca\u3092\u6295\u5165\u3057\u3066\u5f31\u4f53\u5316\u3057\u305f\u9632\u5fa1\u3092\u653b\u7565\u3059\u308b\u3002\u4f8b\uff1a\u68ee\u306e\u30de\u30c3\u30d7\u3067\u306f\u3001\u6226\u8eca\u3092\u307e\u3063\u3059\u3050\u9001\u308a\u8fbc\u3080\u306e\u3067\u306f\u306a\u304f\u3001\u307e\u305a\u306f\u6b69\u5175\u3092\u4f7f\u3063\u3066\u68ee\u3092\u30af\u30ea\u30a2\u3057\u3001\u305d\u306e\u5f8c\u3001\u6c7a\u5b9a\u7684\u6253\u6483\u3092\u4e0e\u3048\u308b\u305f\u3081\u306b\u6226\u8eca\u3092\u6295\u5165\u3057\u307e\u3059\u3002\u6226\u8eca\u306f\u69cc\u3001\u6b69\u5175\u306f\u7827\u306e\u3088\u3046\u306a\u6226\u8853\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u6b69\u5175\u306f\u6575\u3092\u4e00\u5b9a\u306e\u4f4d\u7f6e\u306b\u7559\u3081\u3066\u304a\u304f\u3002"}, {"question": "Warfare 1942\u3067\u6280\u8853\u306e\u7814\u7a76\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u7a4d\u6975\u7684\u306a\u6226\u7565\u3084\u9632\u5fa1\u7684\u306a\u6226\u7565\u306a\u3069\u3001\u3055\u307e\u3056\u307e\u306a\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u3067\u3069\u306e\u6280\u8853\u3092\u512a\u5148\u3059\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u6280\u8853\u306f\u3042\u306a\u305f\u306e\u8ecd\u4e8b\u529b\u306e\u57fa\u76e4\u3067\u3059\u3002\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u57fa\u3065\u3044\u3066\u6280\u8853\u3092\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u7a4d\u6975\u7684\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u6539\u826f\u3055\u308c\u305f\u6226\u8eca\u88c5\u7532\u3084\u7832\u5175\u5c04\u7a0b\u306a\u3069\u306e\u90e8\u968a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3079\u304d\u3067\u3059\u3002\u9632\u5fa1\u7684\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u9632\u5fa1\u69cb\u9020\u7269\u3001\u5b89\u4fa1\u306a\u5efa\u8a2d\u30b3\u30b9\u30c8\u3001\u5f37\u5316\u3055\u308c\u305f\u9663\u5730\u304b\u3089\u6069\u6075\u3092\u53d7\u3051\u307e\u3059\u3002\u7a4d\u6975\u7684\u306a\u5834\u5408\u306f\u3001\u521d\u671f\u306b\u9ad8\u5ea6\u306a\u6226\u8eca\u88c5\u7532\u3092\u7814\u7a76\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u9632\u5fa1\u7684\u306a\u6226\u7565\u306e\u5834\u5408\u306f\u3001\u30ec\u30fc\u30c0\u30fc\u3084\u5bfe\u7a7a\u6280\u8853\u306b\u91cd\u70b9\u3092\u7f6e\u3044\u3066\u304f\u3060\u3055\u3044\u3002\u6280\u8853\u30c4\u30ea\u30fc\u3092\u679d\u5206\u304b\u308c\u3059\u308b\u9053\u3060\u3068\u60f3\u50cf\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u521d\u671f\u306b\u6226\u8eca\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u9078\u629e\u3059\u308b\u3068\u3001\u6226\u8eca\u4e2d\u5fc3\u306e\u6226\u7565\u306b\u56fa\u5b9a\u3055\u308c\u307e\u3059\u3002\u822a\u7a7a\u6a5f\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u9078\u629e\u3059\u308b\u3068\u3001\u822a\u7a7a\u512a\u52e2\u3078\u306e\u65b0\u3057\u3044\u9053\u304c\u958b\u304b\u308c\u307e\u3059\u3002"}, {"question": "Warfare 1942\u3067\u9023\u643a\u3057\u305f\u7a7a\u7206\u306e\u6700\u3082\u52b9\u679c\u7684\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f\u6226\u4e891942\u3067\u6226\u7565\u7206\u6483\u3068\u5730\u4e0a\u653b\u6483\u3092\u3069\u306e\u3088\u3046\u306b\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3001\u30c0\u30e1\u30fc\u30b8\u3092\u6700\u5927\u5316\u3057\u3001\u640d\u5931\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u9023\u643a\u3057\u305f\u7a7a\u7206\u306f\u7834\u58ca\u7684\u3067\u3059\u3002\u307e\u305a\u3001\u822a\u7a7a\u512a\u52e2\u3092\u78ba\u7acb\u3057\u307e\u3059\u3002\u6b21\u306b\u3001\u76ee\u6a19\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u6226\u7565\u7206\u6483\u306f\u5de5\u5834\u3084\u8cc7\u6e90\u62e0\u70b9\u306a\u3069\u306e\u30a4\u30f3\u30d5\u30e9\u3092\u6a19\u7684\u306b\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u6226\u8853\u7206\u6483\u306f\u6575\u90e8\u968a\u3092\u6a19\u7684\u306b\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5c02\u7528\u306e\u6226\u95d8\u6a5f\u3067\u6575\u306e\u822a\u7a7a\u6a5f\u9632\u885b\u3092\u6291\u5236\u3059\u308b\u3001\u30b9\u30c6\u30c3\u30d72\uff1a\u7206\u6483\u6a5f\u3092\u6d3e\u9063\u3057\u3066\u6575\u306e\u751f\u7523\u529b\u3092\u5f31\u4f53\u5316\u3055\u305b\u308b\u3001\u30b9\u30c6\u30c3\u30d73\uff1a\u6df7\u4e71\u306b\u4e57\u3058\u3066\u5730\u4e0a\u653b\u6483\u3092\u958b\u59cb\u3059\u308b\u3002\u4f8b\uff1a\u6226\u8853\u7206\u6483\u6a5f\u3067\u6575\u306e\u6226\u8eca\u90e8\u968a\u304c\u3042\u306a\u305f\u306e\u6226\u7dda\u306b\u5230\u9054\u3059\u308b\u524d\u306b\u7834\u58ca\u3057\u3001\u305d\u306e\u5f8c\u3001\u3042\u306a\u305f\u306e\u6226\u8eca\u3092\u4f7f\u3063\u3066\u53cd\u6483\u3059\u308b\u3002\u30dc\u30af\u30b5\u30fc\u304c\u30b8\u30e3\u30d6\u3092\u4f7f\u3063\u3066\u30ce\u30c3\u30af\u30a2\u30a6\u30c8\u30d1\u30f3\u30c1\u3092\u4ed5\u639b\u3051\u308b\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002"}, {"question": "Warfare 1942\u306e\u6226\u95d8\u8a08\u7b97\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f\u6226\u95d8\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u7d71\u8a08\u306f\u4f55\u3067\u3059\u304b\uff1fWarfare1942\u3067\u306f\u30c0\u30e1\u30fc\u30b8\u306f\u3069\u306e\u3088\u3046\u306b\u8a08\u7b97\u3055\u308c\u307e\u3059\u304b\uff1f\u5177\u4f53\u7684\u306a\u6570\u5b57\u3067\u6559\u3048\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "Warfare 1942\u306e\u6226\u95d8\u30b7\u30b9\u30c6\u30e0\u306b\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u8981\u7d20\u304c\u3042\u308a\u307e\u3059\u3002\u90e8\u968a\u653b\u6483\u529b\u3001\u9632\u5fa1\u529b\u3001\u88c5\u7532\u3001\u5730\u5f62\u4fee\u6b63\u304c\u3059\u3079\u3066\u5f79\u5272\u3092\u679c\u305f\u3057\u307e\u3059\u3002\u30c0\u30e1\u30fc\u30b8\u306f\u4e00\u822c\u7684\u306b\u3001\uff08\u653b\u6483\u8005\u306e\u653b\u6483\u529b - \u9632\u5fa1\u8005\u306e\u88c5\u7532\uff09\u00d7\u4fee\u6b63\u4fc2\u6570\u3067\u8a08\u7b97\u3055\u308c\u307e\u3059\u3002\u653b\u6483\u529b\u304c\u88c5\u7532\u4ee5\u4e0b\u306e\u5834\u5408\u3001\u6700\u5c0f\u30c0\u30e1\u30fc\u30b8\u304c\u9069\u7528\u3055\u308c\u307e\u3059\u3002\u5730\u5f62\u306f\u3001\u5730\u5f62\u306b\u3088\u3063\u306620\uff5e50\uff05\u306e\u30c0\u30e1\u30fc\u30b8\u8efd\u6e1b\u307e\u305f\u306f\u5897\u52a0\u52b9\u679c\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6226\u8eca\uff08\u653b\u6483\u529b50\u3001\u88c5\u753230\uff09\u304c\u5e73\u91ce\u3067\u6b69\u5175\uff08\u9632\u5fa1\u529b20\u3001\u88c5\u753210\uff09\u3092\u653b\u6483\u3059\u308b\u3068\u3001\uff0850-10\uff09\u00d71\uff1d40\u306e\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u307e\u3059\u3002\u540c\u3058\u6226\u8eca\u304c\u540c\u3058\u6b69\u5175\u90e8\u968a\u3092\u5c71\u4e0a\u3067\u653b\u6483\u3059\u308b\u3068\u3001\uff0850-10\uff09\u00d70.5\uff1d20\u306e\u30c0\u30e1\u30fc\u30b8\u306b\u306a\u308a\u307e\u3059\u3002\u9632\u5fa1\u5074\u306e\u90e8\u968a\u306e\u4f53\u529b\u307b\u3069\u3001\u30c0\u30e1\u30fc\u30b8\u3092\u53d7\u3051\u305f\u901f\u5ea6\u304c\u65e9\u304f\u3001\u6bba\u5bb3\u3057\u307e\u3059\u3002"}, {"question": "Warfare 1942\u3067\u58eb\u6c17\u306e\u5f71\u97ff\u306f\u4f55\u3067\u3059\u304b\uff1f\u3069\u306e\u3088\u3046\u306b\u5897\u6e1b\u3055\u305b\u307e\u3059\u304b\uff1f\u6570\u5024\u7684\u306a\u5f71\u97ff\u306f\u4f55\u3067\u3059\u304b\uff1f\u3069\u306e\u3088\u3046\u306bWarfare1942\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5909\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u58eb\u6c17\u306f\u3001\u90e8\u968a\u306e\u6709\u52b9\u6027\u306b\u5927\u304d\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u58eb\u6c17\u304c\u9ad8\u3044\u3068\u653b\u6483\u529b\u3068\u9632\u5fa1\u529b\u304c\u5411\u4e0a\u3057\u3001\u58eb\u6c17\u304c\u4f4e\u3044\u3068\u653b\u6483\u529b\u3068\u9632\u5fa1\u529b\u304c\u4f4e\u4e0b\u3057\u307e\u3059\u3002\u58eb\u6c17\u306f\u6700\u8fd1\u306e\u52dd\u5229\u3001\u6557\u5317\u3001\u88dc\u7d66\u30e9\u30a4\u30f3\u306b\u5f71\u97ff\u3092\u53d7\u3051\u307e\u3059\u3002\u90e8\u968a\u306e\u88dc\u7d66\u3092\u7dad\u6301\u3057\u3001\u6226\u3044\u3092\u52dd\u5229\u3059\u308b\u3053\u3068\u3067\u58eb\u6c17\u3092\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u6557\u5317\u3057\u3001\u88dc\u7d66\u30e9\u30a4\u30f3\u3092\u906e\u65ad\u3059\u308b\u3053\u3068\u3067\u58eb\u6c17\u304c\u4f4e\u4e0b\u3057\u307e\u3059\u3002\u52b9\u679c\u306f\u3001\u58eb\u6c17\u306e\u826f\u3057\u60aa\u3057\u306b\u3088\u3063\u306610\u301c30\uff05\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u30d0\u30d5\u306e\u5897\u6e1b\u306e\u7bc4\u56f2\u3067\u3059\u3002\u4f8b\u3048\u3070+30\uff05\u58eb\u6c17\u306e\u90e8\u968a\u306f\u3001\u4e8b\u5b9f\u4e0a2\u3064\u306e\u90e8\u968a\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3042\u308a\u3001\u3088\u308a\u52b9\u679c\u7684\u306b\u4ed6\u306e\u8ecd\u968a\u3092\u5207\u308a\u88c2\u304f\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u9006\u306b\u3001\u58eb\u6c17\u304c\u4f4e\u4e0b\u3057\u305f\u8ecd\u968a\u306f\u7121\u529b\u3067\u3042\u308a\u3001\u64a4\u9000\u3057\u305f\u65b9\u304c\u826f\u3044\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "PC\u3067\u30d7\u30ec\u30a4\u3057\u3066\u3044\u307e\u3059\u3002\u30b9\u30de\u30fc\u30c8\u30d5\u30a9\u30f3\u3067Warfare 1942\u3092\u30d7\u30ec\u30a4\u3067\u304d\u307e\u3059\u304b\uff1fWarfare1942\u306e\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u30aa\u30d7\u30b7\u30e7\u30f3\u3068\u30a2\u30ab\u30a6\u30f3\u30c8\u540c\u671f\u6a5f\u80fd\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Warfare 1942\u306f\u73fe\u5728\u3001PC\u3068\u30d6\u30e9\u30a6\u30b6\u3067\u306e\u307f\u5229\u7528\u53ef\u80fd\u3067\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u7248\u306f\u958b\u767a\u4e2d\u3067\u3059\u304c\u3001\u73fe\u6642\u70b9\u3067\u306f\u5229\u7528\u53ef\u80fd\u306a\u30aa\u30d7\u30b7\u30e7\u30f3\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u4e92\u63db\u6027\u306f\u4e88\u5b9a\u3055\u308c\u3066\u304a\u308a\u3001PC\u3067\u30d7\u30ec\u30a4\u3057\u3001\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u3067\u9032\u6357\u72b6\u6cc1\u3092\u7d99\u7d9a\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u4f7f\u7528\u3057\u3066\u30c7\u30fc\u30bf\u3001\u9032\u6357\u72b6\u6cc1\u3001\u8cfc\u5165\u5185\u5bb9\u3092\u8907\u6570\u306e\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u540c\u671f\u3057\u307e\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u30ea\u30ea\u30fc\u30b9\u304a\u3088\u3073\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u6a5f\u80fd\u306b\u95a2\u3059\u308b\u767a\u8868\u306b\u3054\u671f\u5f85\u304f\u3060\u3055\u3044\u3002"}, {"question": "Warfare 1942\u306b\u79d8\u5bc6\u306e\u90e8\u968a\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f\u305d\u308c\u3089\u306f\u4f55\u3067\u3059\u304b\uff1fWarfare1942\u3067\u305d\u308c\u3089\u3092\u958b\u653e\u307e\u305f\u306f\u767a\u898b\u3057\u3066\u3001\u81ea\u5206\u306b\u3068\u3063\u3066\u306e\u5229\u70b9\u3092\u3069\u306e\u3088\u3046\u306b\u5f97\u3089\u308c\u307e\u3059\u304b\uff1f", "answer": "Warfare 1942\u306b\u306f\u3001\u71b1\u5fc3\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u767a\u898b\u3067\u304d\u308b\u3044\u304f\u3064\u304b\u306e\u96a0\u3057\u90e8\u968a\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3068\u3057\u3066\u3001\u30ad\u30e3\u30f3\u30da\u30fc\u30f3\u5f8c\u534a\u306b\u7279\u5b9a\u306e\u5cf6\u3092\u5360\u9818\u3059\u308b\u3068\u3001\u72ec\u7279\u306e\u80fd\u529b\u3092\u6301\u3064\u73cd\u3057\u3044\u5b9f\u9a13\u6a5f\u304c\u89e3\u653e\u3055\u308c\u307e\u3059\u3002\u5225\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3001\u7279\u5b9a\u306e\u9054\u6210\u76ee\u6a19\u3092\u9054\u6210\u3059\u308b\u3068\u767a\u751f\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u5f37\u529b\u306a\u30ea\u30fc\u30c0\u30fc\u30b9\u30ad\u30eb\u3092\u6301\u3064\u96a0\u3055\u308c\u305f\u5c06\u8ecd\u3078\u306e\u30a2\u30af\u30bb\u30b9\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u79d8\u5bc6\u306f\u3042\u306a\u305f\u306e\u6226\u7565\u7684\u306a\u9078\u629e\u80a2\u3092\u5f37\u5316\u3057\u3001\u56f0\u96e3\u306a\u72b6\u6cc1\u3067\u512a\u4f4d\u306b\u7acb\u3064\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u96a0\u3055\u308c\u305f\u5b9d\u3092\u63a2\u3059\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u6210\u529f\u3059\u308c\u3070\u3001\u30e6\u30cb\u30fc\u30af\u306a\u5831\u916c\u3068\u81ea\u6162\u3067\u304d\u308b\u6a29\u5229\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}]
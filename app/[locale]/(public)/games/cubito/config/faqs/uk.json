[{"question": "\u042f\u043a \u0432\u0438\u043a\u043e\u043d\u0430\u0442\u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0456 \u0440\u0443\u0445\u0438 \u0432 Cubito \u044f\u043a \u043d\u043e\u0432\u0438\u0439 \u0433\u0440\u0430\u0432\u0435\u0446\u044c?", "answer": "\u0423 Cubito \u043e\u0441\u043d\u043e\u0432\u043d\u0456 \u0440\u0443\u0445\u0438 \u0454 \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u0438\u043c\u0438 \u0434\u043b\u044f \u043d\u0430\u0432\u0456\u0433\u0430\u0446\u0456\u0457 \u043f\u043e \u0456\u0433\u0440\u043e\u0432\u0456\u0439 \u043a\u0430\u0440\u0442\u0456. \u0429\u043e\u0431 \u043f\u0435\u0440\u0435\u043c\u0456\u0441\u0442\u0438\u0442\u0438 \u0441\u0432\u043e\u0433\u043e \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0430, \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u043a\u043b\u0430\u0432\u0456\u0448\u0456 WASD: W \u2014 \u0432\u043f\u0435\u0440\u0435\u0434, A \u2014 \u043b\u0456\u0432\u043e\u0440\u0443\u0447, S \u2014 \u043d\u0430\u0437\u0430\u0434, D \u2014 \u043f\u0440\u0430\u0432\u043e\u0440\u0443\u0447. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0449\u043e\u0431 \u0434\u043e\u0441\u043b\u0456\u0434\u0438\u0442\u0438 \u043d\u043e\u0432\u0443 \u043e\u0431\u043b\u0430\u0441\u0442\u044c, \u043d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c W, \u0449\u043e\u0431 \u0440\u0443\u0445\u0430\u0442\u0438\u0441\u044f \u0432\u043f\u0435\u0440\u0435\u0434. \u041a\u0440\u0456\u043c \u0442\u043e\u0433\u043e, \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u043f\u0440\u043e\u0431\u0456\u043b \u0434\u043b\u044f \u0441\u0442\u0440\u0438\u0431\u043a\u0430 \u0447\u0435\u0440\u0435\u0437 \u043f\u0435\u0440\u0435\u0448\u043a\u043e\u0434\u0438. \u0414\u043b\u044f \u0431\u0456\u043b\u044c\u0448 \u043f\u043b\u0430\u0432\u043d\u043e\u0433\u043e \u0434\u043e\u0441\u0432\u0456\u0434\u0443 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0439\u0442\u0435 \u0447\u0443\u0442\u043b\u0438\u0432\u0456\u0441\u0442\u044c \u043c\u0438\u0448\u0456 \u0432 \u043c\u0435\u043d\u044e \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u043e \u0434\u043e \u0432\u0430\u0448\u0438\u0445 \u0443\u043f\u043e\u0434\u043e\u0431\u0430\u043d\u044c."}, {"question": "\u042f\u043a\u0456 \u043a\u043b\u044e\u0447\u043e\u0432\u0456 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0457 \u0434\u043b\u044f \u043e\u0432\u043e\u043b\u043e\u0434\u0456\u043d\u043d\u044f \u0431\u043e\u0439\u043e\u0432\u043e\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u044e Cubito?", "answer": "\u041e\u0432\u043e\u043b\u043e\u0434\u0456\u043d\u043d\u044f \u0431\u043e\u0439\u043e\u0432\u043e\u044e \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u044e Cubito \u0432\u0438\u043c\u0430\u0433\u0430\u0454 \u043a\u043e\u043c\u0431\u0456\u043d\u0430\u0446\u0456\u0457 \u0447\u0430\u0441\u0443, \u043f\u043e\u0437\u0438\u0446\u0456\u043e\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u0430 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0440\u0435\u0441\u0443\u0440\u0441\u0430\u043c\u0438. \u041a\u0420\u041e\u041a 1: \u0417\u0430\u0432\u0436\u0434\u0438 \u0441\u0442\u0435\u0436\u0442\u0435 \u0437\u0430 \u0448\u043a\u0430\u043b\u043e\u044e \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043b\u043e\u0441\u0442\u0456; \u043d\u0430\u0434\u043c\u0456\u0440\u043d\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u043c\u043e\u0436\u0435 \u0437\u0430\u043b\u0438\u0448\u0438\u0442\u0438 \u0432\u0430\u0441 \u0432\u0440\u0430\u0437\u043b\u0438\u0432\u0438\u043c\u0438. \u041a\u0420\u041e\u041a 2: \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0435 \u043d\u0430 \u0441\u0432\u043e\u044e \u043a\u043e\u0440\u0438\u0441\u0442\u044c, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0441\u0442\u0456\u043d \u0434\u043b\u044f \u0443\u043a\u0440\u0438\u0442\u0442\u044f. \u041a\u0420\u041e\u041a 3: \u041f\u0440\u0430\u043a\u0442\u0438\u043a\u0443\u0439\u0442\u0435 \u043a\u043e\u043c\u0431\u043e \u0432 \u0442\u0440\u0435\u043d\u0443\u0432\u0430\u043b\u044c\u043d\u0456\u0439 \u0437\u043e\u043d\u0456, \u0449\u043e\u0431 \u043f\u0456\u0434\u0432\u0438\u0449\u0438\u0442\u0438 \u0441\u0432\u043e\u044e \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0434\u043e\u0431\u0440\u0435 \u0432\u0447\u0430\u0441\u043d\u043e \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u0438\u0439 \u0443\u0445\u0438\u043b, \u0437\u0430 \u044f\u043a\u0438\u043c \u0439\u0434\u0435 \u043a\u043e\u043d\u0442\u0440-\u0430\u0442\u0430\u043a\u0430, \u043c\u043e\u0436\u0435 \u0437\u043c\u0456\u043d\u0438\u0442\u0438 \u0445\u0456\u0434 \u0431\u0438\u0442\u0432\u0438. \u0420\u043e\u0437\u0433\u043b\u044f\u043d\u044c\u0442\u0435 \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u0442\u0430\u0431\u043b\u0438\u0446\u0456 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c \u0434\u043b\u044f \u0432\u0456\u0434\u0441\u0442\u0435\u0436\u0435\u043d\u043d\u044f \u0432\u0430\u0448\u0438\u0445 \u043d\u0430\u0439\u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0456\u0448\u0438\u0445 \u043a\u043e\u043c\u0431\u043e."}, {"question": "\u0427\u043e\u043c\u0443 \u0440\u043e\u0437\u0443\u043c\u0456\u043d\u043d\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0438 \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f Cubito \u0454 \u0432\u0430\u0436\u043b\u0438\u0432\u0438\u043c \u0434\u043b\u044f \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u0438\u0445 \u0433\u0440\u0430\u0432\u0446\u0456\u0432?", "answer": "\u0420\u043e\u0437\u0443\u043c\u0456\u043d\u043d\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0438 \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f Cubito \u0454 \u0432\u0430\u0436\u043b\u0438\u0432\u0438\u043c \u0434\u043b\u044f \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u0438\u0445 \u0433\u0440\u0430\u0432\u0446\u0456\u0432, \u043e\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u0432\u043e\u043d\u0430 \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u0454 \u0441\u0442\u0432\u043e\u0440\u044e\u0432\u0430\u0442\u0438 \u043f\u043e\u0442\u0443\u0436\u043d\u0456 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0438 \u0442\u0430 \u0435\u043a\u0456\u043f\u0456\u0440\u0443\u0432\u0430\u043d\u043d\u044f. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0432\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0437\u0431\u0440\u043e\u0457 \u0432\u0438\u0441\u043e\u043a\u043e\u0433\u043e \u0440\u0456\u0432\u043d\u044f \u043c\u043e\u0436\u0435 \u0437\u043d\u0430\u0447\u043d\u043e \u043f\u0456\u0434\u0432\u0438\u0449\u0438\u0442\u0438 \u0432\u0430\u0448\u0443 \u0431\u043e\u0439\u043e\u0432\u0443 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c. \u0414\u043b\u044f \u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u0437\u0456\u0431\u0435\u0440\u0456\u0442\u044c \u0440\u0435\u0441\u0443\u0440\u0441\u0438, \u0442\u0430\u043a\u0456 \u044f\u043a \u0440\u0443\u0434\u0438 \u0442\u0430 \u0442\u0440\u0430\u0432\u0438. \u041f\u043e\u0442\u0456\u043c \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u043c\u0435\u043d\u044e \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f, \u0449\u043e\u0431 \u043e\u0431'\u0454\u0434\u043d\u0430\u0442\u0438 \u0446\u0456 \u043c\u0430\u0442\u0435\u0440\u0456\u0430\u043b\u0438. \u0414\u0456\u0430\u0433\u0440\u0430\u043c\u0430 \u043f\u043e\u0442\u043e\u043a\u0443 \u043c\u043e\u0436\u0435 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0442\u0438 \u0432\u0456\u0437\u0443\u0430\u043b\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u043f\u0440\u043e\u0446\u0435\u0441 \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f, \u0433\u0430\u0440\u0430\u043d\u0442\u0443\u044e\u0447\u0438, \u0449\u043e \u0432\u0438 \u043d\u0435 \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u0442\u0435 \u0436\u043e\u0434\u043d\u043e\u0433\u043e \u043a\u0440\u043e\u043a\u0443. \u0417\u0430\u0432\u0436\u0434\u0438 \u0441\u0442\u0435\u0436\u0442\u0435 \u0437\u0430 \u0434\u043e\u0432\u0433\u043e\u0432\u0456\u0447\u043d\u0456\u0441\u0442\u044e \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u0438\u0445 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0456\u0432, \u0449\u043e\u0431 \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0457\u0445\u043d\u044e \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c."}, {"question": "\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0440\u0456\u0432\u043d\u0456\u0432 Cubito \u0456 \u044f\u043a\u0456 \u043a\u043b\u044e\u0447\u043e\u0432\u0456 \u0435\u0442\u0430\u043f\u0438?", "answer": "\u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u0440\u0456\u0432\u043d\u0456\u0432 Cubito \u0440\u043e\u0437\u0440\u043e\u0431\u043b\u0435\u043d\u0430 \u0434\u043b\u044f \u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0436\u0435\u043d\u043d\u044f \u0433\u0440\u0430\u0432\u0446\u0456\u0432 \u0437\u0430 \u0457\u0445\u043d\u0456\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441. \u041e\u0442\u0440\u0438\u043c\u0443\u044e\u0447\u0438 \u0434\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u0456 \u043e\u0447\u043a\u0438 (\u0414\u041e) \u0447\u0435\u0440\u0435\u0437 \u043a\u0432\u0435\u0441\u0442\u0438 \u0442\u0430 \u0431\u0438\u0442\u0432\u0438, \u0432\u0438 \u043f\u0456\u0434\u0432\u0438\u0449\u0443\u0454\u0442\u0435 \u0440\u0456\u0432\u0435\u043d\u044c, \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u044e\u0447\u0438 \u043d\u043e\u0432\u0456 \u0437\u0434\u0456\u0431\u043d\u043e\u0441\u0442\u0456 \u0442\u0430 \u0437\u0431\u0456\u043b\u044c\u0448\u0443\u044e\u0447\u0438 \u0441\u0432\u043e\u0457 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438. \u041a\u043b\u044e\u0447\u043e\u0432\u0438\u043c\u0438 \u0435\u0442\u0430\u043f\u0430\u043c\u0438 \u0454 \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u0440\u0456\u0432\u043d\u044f 10, \u0449\u043e \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u0454 \u043d\u043e\u0432\u0435 \u0434\u0435\u0440\u0435\u0432\u043e \u043d\u0430\u0432\u0438\u0447\u043e\u043a, \u0456 \u0440\u0456\u0432\u043d\u044f 20, \u0449\u043e \u043d\u0430\u0434\u0430\u0454 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u0440\u043e\u0437\u0448\u0438\u0440\u0435\u043d\u0438\u0445 \u0440\u0435\u0446\u0435\u043f\u0442\u0456\u0432 \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f \u0433\u043e\u043b\u043e\u0432\u043d\u043e\u0433\u043e \u043a\u0432\u0435\u0441\u0442\u0443 \u043d\u0430 \u0440\u0456\u0432\u043d\u0456 15 \u043c\u043e\u0436\u0435 \u0434\u0430\u0442\u0438 \u0437\u043d\u0430\u0447\u043d\u0438\u0439 \u043f\u0440\u0438\u0440\u0456\u0441\u0442 \u0414\u041e. \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0442\u0430\u0431\u043b\u0438\u0446\u044e \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c, \u0449\u043e\u0431 \u0432\u0456\u0434\u0441\u0442\u0435\u0436\u0443\u0432\u0430\u0442\u0438 \u0441\u0432\u0456\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441 \u0442\u0430 \u043f\u043b\u0430\u043d\u0443\u0432\u0430\u0442\u0438 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u044e \u0434\u043b\u044f \u043f\u0456\u0434\u0432\u0438\u0449\u0435\u043d\u043d\u044f \u0440\u0456\u0432\u043d\u044f."}, {"question": "\u042f\u043a\u0456 \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0456 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0438 \u0434\u043b\u044f \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0440\u0435\u0441\u0443\u0440\u0441\u0430\u043c\u0438 \u0432 Cubito?", "answer": "\u0415\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0435 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0440\u0435\u0441\u0443\u0440\u0441\u0430\u043c\u0438 \u0432 Cubito \u0454 \u0436\u0438\u0442\u0442\u0454\u0432\u043e \u0432\u0430\u0436\u043b\u0438\u0432\u0438\u043c \u0434\u043b\u044f \u0434\u043e\u0432\u0433\u043e\u0441\u0442\u0440\u043e\u043a\u043e\u0432\u043e\u0433\u043e \u0443\u0441\u043f\u0456\u0445\u0443. \u041a\u0420\u041e\u041a 1: \u041f\u0440\u0438\u043e\u0440\u0456\u0442\u0435\u0442\u0456\u0437\u0443\u0439\u0442\u0435 \u0437\u0431\u0456\u0440 \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u0438\u0445 \u043c\u0430\u0442\u0435\u0440\u0456\u0430\u043b\u0456\u0432, \u0442\u0430\u043a\u0438\u0445 \u044f\u043a \u0440\u0443\u0434\u0438 \u0442\u0430 \u0442\u0440\u0430\u0432\u0438. \u041a\u0420\u041e\u041a 2: \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u043a\u043e\u043d\u0442\u0435\u0439\u043d\u0435\u0440\u0438 \u0434\u043b\u044f \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u043d\u043d\u044f, \u0449\u043e\u0431 \u0443\u043f\u043e\u0440\u044f\u0434\u043a\u0443\u0432\u0430\u0442\u0438 \u0441\u0432\u0456\u0439 \u0456\u043d\u0432\u0435\u043d\u0442\u0430\u0440. \u041a\u0420\u041e\u041a 3: \u0420\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u043e \u043f\u0440\u043e\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0430\u0431\u043e \u043e\u0431\u043c\u0456\u043d\u044e\u0439\u0442\u0435 \u0437\u0430\u0439\u0432\u0456 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0438, \u0449\u043e\u0431 \u0437\u0432\u0456\u043b\u044c\u043d\u0438\u0442\u0438 \u043c\u0456\u0441\u0446\u0435. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043f\u0440\u043e\u0434\u0430\u0436 \u043d\u0435\u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u0438\u0445 \u0437\u0456\u043b\u043b\u044f \u043c\u043e\u0436\u0435 \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0438\u0442\u0438 \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u0443 \u0437\u043e\u043b\u043e\u0442\u0443 \u043c\u043e\u043d\u0435\u0442\u0443 \u0434\u043b\u044f \u043a\u0440\u0430\u0449\u043e\u0433\u043e \u043e\u0431\u043b\u0430\u0434\u043d\u0430\u043d\u043d\u044f. \u041f\u043e\u0440\u0456\u0432\u043d\u044f\u043d\u043d\u044f \u0431\u0430\u0433\u0430\u0442\u043e\u0441\u0445\u0435\u043c\u043d\u0438\u0445 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0439 \u043c\u043e\u0436\u0435 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0442\u0438 \u0432\u0430\u043c \u0432\u0438\u0440\u0456\u0448\u0438\u0442\u0438 \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0432\u0430\u0448\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432, \u0447\u0438 \u0442\u043e \u0432\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u043d\u044f, \u043f\u0440\u043e\u0434\u0430\u0436 \u0447\u0438 \u0442\u043e\u0440\u0433\u0456\u0432\u043b\u044f."}, {"question": "\u042f\u043a \u044f \u043c\u043e\u0436\u0443 \u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0441\u0432\u043e\u044e \u0431\u0443\u0434\u043e\u0432\u0443 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0430 Cubito \u0434\u043b\u044f \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u0443 \u043a\u0456\u043d\u0446\u0435\u0432\u043e\u0457 \u0433\u0440\u0438?", "answer": "\u041e\u043f\u0442\u0438\u043c\u0456\u0437\u0430\u0446\u0456\u044f \u0432\u0430\u0448\u043e\u0457 \u0431\u0443\u0434\u043e\u0432\u0438 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0430 Cubito \u0434\u043b\u044f \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u0443 \u043a\u0456\u043d\u0446\u0435\u0432\u043e\u0457 \u0433\u0440\u0438 \u043f\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0430\u0454 \u0440\u0435\u0442\u0435\u043b\u044c\u043d\u0435 \u043f\u043b\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u0430 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f. \u041a\u0420\u041e\u041a 1: \u0417\u043e\u0441\u0435\u0440\u0435\u0434\u044c\u0442\u0435\u0441\u044f \u043d\u0430 \u043c\u0430\u043a\u0441\u0438\u043c\u0456\u0437\u0430\u0446\u0456\u0457 \u0432\u0430\u0448\u0438\u0445 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u0445 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a, \u0442\u0430\u043a\u0438\u0445 \u044f\u043a \u0441\u0438\u043b\u0430 \u0447\u0438 \u0456\u043d\u0442\u0435\u043b\u0435\u043a\u0442, \u0437\u0430\u043b\u0435\u0436\u043d\u043e \u0432\u0456\u0434 \u0432\u0430\u0448\u043e\u0433\u043e \u0441\u0442\u0438\u043b\u044e \u0433\u0440\u0438. \u041a\u0420\u041e\u041a 2: \u041e\u0434\u044f\u0433\u043d\u0456\u0442\u044c \u043e\u0431\u043b\u0430\u0434\u043d\u0430\u043d\u043d\u044f, \u044f\u043a\u0435 \u0434\u043e\u043f\u043e\u0432\u043d\u044e\u0454 \u0432\u0430\u0448\u0456 \u043e\u0431\u0440\u0430\u043d\u0456 \u0437\u0434\u0456\u0431\u043d\u043e\u0441\u0442\u0456. \u041a\u0420\u041e\u041a 3: \u0420\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u043e \u043e\u043d\u043e\u0432\u043b\u044e\u0439\u0442\u0435 \u0441\u0432\u043e\u0454 \u043e\u0431\u043b\u0430\u0434\u043d\u0430\u043d\u043d\u044f, \u0449\u043e\u0431 \u0437\u0430\u043b\u0438\u0448\u0430\u0442\u0438\u0441\u044f \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0442\u043e\u0441\u043f\u0440\u043e\u043c\u043e\u0436\u043d\u0438\u043c. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0447\u0430\u0440\u0456\u0432\u043d\u0438\u043a\u0443 \u043a\u043e\u0440\u0438\u0441\u043d\u043e \u043c\u0430\u0442\u0438 \u0432\u0438\u0441\u043e\u043a\u0438\u0439 \u0456\u043d\u0442\u0435\u043b\u0435\u043a\u0442 \u0456 \u043e\u0431\u043b\u0430\u0434\u043d\u0430\u043d\u043d\u044f \u0437 \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u043c\u0430\u0433\u0456\u0457. \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0442\u0430\u0431\u043b\u0438\u0446\u044e \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c, \u0449\u043e\u0431 \u043f\u043e\u0440\u0456\u0432\u043d\u044f\u0442\u0438 \u0440\u0456\u0437\u043d\u0456 \u0431\u0443\u0434\u043e\u0432\u0438 \u0442\u0430 \u0457\u0445\u043d\u044e \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c \u0443 \u0440\u0456\u0437\u043d\u0438\u0445 \u0441\u0446\u0435\u043d\u0430\u0440\u0456\u044f\u0445."}, {"question": "\u042f\u043a\u0456 \u0442\u0435\u0445\u043d\u0456\u0447\u043d\u0456 \u0432\u0438\u043c\u043e\u0433\u0438 \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u0456 \u0434\u043b\u044f \u0437\u0430\u043f\u0443\u0441\u043a\u0443 Cubito \u043d\u0430 \u0440\u0456\u0437\u043d\u0438\u0445 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430\u0445?", "answer": "Cubito \u0440\u043e\u0437\u0440\u043e\u0431\u043b\u0435\u043d\u0438\u0439 \u0434\u043b\u044f \u043f\u043b\u0430\u0432\u043d\u043e\u0433\u043e \u0437\u0430\u043f\u0443\u0441\u043a\u0443 \u043d\u0430 \u0440\u0456\u0437\u043d\u0438\u0445 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430\u0445, \u0430\u043b\u0435 \u0442\u0435\u0445\u043d\u0456\u0447\u043d\u0456 \u0432\u0438\u043c\u043e\u0433\u0438 \u0437\u043c\u0456\u043d\u044e\u044e\u0442\u044c\u0441\u044f. \u0414\u043b\u044f \u041f\u041a \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0454\u0442\u044c\u0441\u044f \u043c\u0456\u043d\u0456\u043c\u0443\u043c 8 \u0413\u0411 \u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0457 \u043f\u0430\u043c'\u044f\u0442\u0456 \u0442\u0430 \u0432\u0456\u0434\u0435\u043e\u043a\u0430\u0440\u0442\u0430 GTX 1050. \u041d\u0430 \u043a\u043e\u043d\u0441\u043e\u043b\u044f\u0445, \u0442\u0430\u043a\u0438\u0445 \u044f\u043a PlayStation 5, \u043f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e \u0443 \u0432\u0430\u0441 \u0454 \u043e\u0441\u0442\u0430\u043d\u043d\u0456 \u043e\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0438. \u0414\u043b\u044f \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0438\u0445 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u0457\u0432 \u0456\u0434\u0435\u0430\u043b\u044c\u043d\u0438\u043c \u0432\u0430\u0440\u0456\u0430\u043d\u0442\u043e\u043c \u0454 \u043f\u0440\u0438\u0441\u0442\u0440\u0456\u0439 \u0437 \u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u044e \u043f\u0430\u043c'\u044f\u0442\u0442\u044e \u043d\u0435 \u043c\u0435\u043d\u0448\u0435 4 \u0413\u0411 \u0442\u0430 Android 10 \u0430\u0431\u043e iOS 13. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0437\u0430\u043f\u0443\u0441\u043a Cubito \u043d\u0430 \u0432\u0438\u0441\u043e\u043a\u043e\u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u043c\u0443 \u041f\u041a \u0437 RTX 3080 \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0438\u0442\u044c \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u0439 \u0433\u0440\u0430\u0444\u0456\u0447\u043d\u0438\u0439 \u0434\u043e\u0441\u0432\u0456\u0434. \u0422\u0430\u0431\u043b\u0438\u0446\u044f \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c \u043c\u043e\u0436\u0435 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0442\u0438 \u0432\u0430\u043c \u043f\u043e\u0440\u0456\u0432\u043d\u044f\u0442\u0438 \u0432\u0438\u043c\u043e\u0433\u0438 \u043d\u0430 \u0440\u0456\u0437\u043d\u0438\u0445 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430\u0445."}, {"question": "\u042f\u043a \u044f \u043c\u043e\u0436\u0443 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0442\u0438 \u0434\u0430\u043d\u0456 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f Cubito \u043c\u0456\u0436 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044f\u043c\u0438?", "answer": "\u041f\u0435\u0440\u0435\u0441\u0438\u043b\u0430\u043d\u043d\u044f \u0434\u0430\u043d\u0438\u0445 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f Cubito \u043c\u0456\u0436 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044f\u043c\u0438 \u2014 \u043f\u0440\u043e\u0441\u0442\u0435 \u043f\u0438\u0442\u0430\u043d\u043d\u044f. \u041a\u0420\u041e\u041a 1: \u041f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e \u0432\u0438 \u0443\u0432\u0456\u0439\u0448\u043b\u0438 \u0432 \u043e\u0434\u043d\u0443 \u0439 \u0442\u0443 \u0436 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441 \u043d\u0430 \u043e\u0431\u043e\u0445 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044f\u0445. \u041a\u0420\u041e\u041a 2: \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0444\u0443\u043d\u043a\u0446\u0456\u044e \u0445\u043c\u0430\u0440\u043d\u043e\u0433\u043e \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f, \u0449\u043e\u0431 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438 \u0441\u0432\u0456\u0439 \u043f\u043e\u0442\u043e\u0447\u043d\u0438\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441. \u041a\u0420\u041e\u041a 3: \u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0442\u0435 \u0444\u0430\u0439\u043b \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f \u043d\u0430 \u043d\u043e\u0432\u0438\u0439 \u043f\u0440\u0438\u0441\u0442\u0440\u0456\u0439. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u044f\u043a\u0449\u043e \u0432\u0438 \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0438\u0442\u0435 \u0437 \u041f\u041a \u043d\u0430 \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0438\u0439 \u043f\u0440\u0438\u0441\u0442\u0440\u0456\u0439, \u0443\u0432\u0456\u0439\u0434\u0456\u0442\u044c \u0434\u043e \u0441\u0432\u043e\u0433\u043e \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u043e\u0433\u043e \u0437\u0430\u043f\u0438\u0441\u0443 \u0442\u0430 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0442\u0435 \u043e\u0441\u0442\u0430\u043d\u043d\u0456\u0439 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u0439 \u0444\u0430\u0439\u043b. \u0414\u0456\u0430\u0433\u0440\u0430\u043c\u0430 \u043f\u043e\u0442\u043e\u043a\u0443 \u043c\u043e\u0436\u0435 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0442\u0438 \u0432\u0456\u0437\u0443\u0430\u043b\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0446\u0456 \u043a\u0440\u043e\u043a\u0438, \u0449\u043e\u0431 \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0438\u0442\u0438 \u043f\u043b\u0430\u0432\u043d\u0438\u0439 \u043f\u0435\u0440\u0435\u0445\u0456\u0434."}, {"question": "\u042f\u043a\u0456 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 \u043c\u0435\u0445\u0430\u043d\u0456\u043a\u0438 \u0432 Cubito, \u044f\u043a\u0456 \u0431\u0456\u043b\u044c\u0448\u0456\u0441\u0442\u044c \u0433\u0440\u0430\u0432\u0446\u0456\u0432 \u043d\u0435 \u043f\u043e\u043c\u0456\u0447\u0430\u0454?", "answer": "Cubito \u043c\u0430\u0454 \u043a\u0456\u043b\u044c\u043a\u0430 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0438\u0445 \u043c\u0435\u0445\u0430\u043d\u0456\u043a, \u044f\u043a\u0456 \u043c\u043e\u0436\u0443\u0442\u044c \u0434\u0430\u0442\u0438 \u0432\u0430\u043c \u043f\u0435\u0440\u0435\u0432\u0430\u0433\u0443 \u0432 \u0433\u0440\u0456. \u041e\u0434\u043d\u0438\u043c \u0456\u0437 \u0442\u0430\u043a\u0438\u0445 \u043c\u0435\u0445\u0430\u043d\u0456\u0437\u043c\u0456\u0432 \u0454 \"\u043f\u0456\u0434\u0432\u0438\u0449\u0435\u043d\u043d\u044f \u0456\u043c\u043f\u0443\u043b\u044c\u0441\u0443\", \u0449\u043e \u0437\u0431\u0456\u043b\u044c\u0448\u0443\u0454 \u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c \u043f\u0456\u0441\u043b\u044f \u043f\u043e\u0441\u043b\u0456\u0434\u043e\u0432\u043d\u0438\u0445 \u0441\u0442\u0440\u0438\u0431\u043a\u0456\u0432. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f \u0442\u0440\u044c\u043e\u0445 \u0441\u0442\u0440\u0438\u0431\u043a\u0456\u0432 \u043f\u0456\u0434\u0440\u044f\u0434 \u043c\u043e\u0436\u0435 \u0434\u0430\u0442\u0438 \u0442\u0438\u043c\u0447\u0430\u0441\u043e\u0432\u0435 \u043f\u0456\u0434\u0432\u0438\u0449\u0435\u043d\u043d\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0441\u0442\u0456, \u0449\u043e \u043a\u043e\u0440\u0438\u0441\u043d\u043e \u0434\u043b\u044f \u0443\u043d\u0438\u043a\u043d\u0435\u043d\u043d\u044f \u0432\u043e\u0440\u043e\u0433\u0456\u0432 \u0430\u0431\u043e \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u0432\u0456\u0434\u0434\u0430\u043b\u0435\u043d\u0438\u0445 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c. \u0429\u0435 \u043e\u0434\u043d\u0456\u0454\u044e \u0447\u0430\u0441\u0442\u043e \u043d\u0435\u043f\u043e\u043c\u0456\u0447\u0435\u043d\u043e\u044e \u0444\u0443\u043d\u043a\u0446\u0456\u0454\u044e \u0454 \"\u0432\u0437\u0430\u0454\u043c\u043e\u0434\u0456\u044f \u0437 \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0435\u043c\", \u0434\u0435 \u0434\u0435\u044f\u043a\u0456 \u043e\u0431'\u0454\u043a\u0442\u0438 \u043c\u043e\u0436\u043d\u0430 \u043c\u0430\u043d\u0456\u043f\u0443\u043b\u044e\u0432\u0430\u0442\u0438, \u0449\u043e\u0431 \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0441\u043a\u043e\u0440\u043e\u0447\u0435\u043d\u043d\u044f \u0430\u0431\u043e \u043f\u0430\u0441\u0442\u043a\u0438. \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u043f\u043e\u0440\u0456\u0432\u043d\u044f\u043d\u043d\u044f \u0431\u0430\u0433\u0430\u0442\u043e\u0441\u0445\u0435\u043c\u043d\u0438\u0445 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0439, \u0449\u043e\u0431 \u0434\u043e\u0441\u043b\u0456\u0434\u0438\u0442\u0438 \u0446\u0456 \u043c\u0435\u0445\u0430\u043d\u0456\u043a\u0438 \u0442\u0430 \u0456\u043d\u0442\u0435\u0433\u0440\u0443\u0432\u0430\u0442\u0438 \u0457\u0445 \u0434\u043e \u0441\u0432\u043e\u0454\u0457 \u0433\u0440\u0438."}, {"question": "\u042f\u043a \u044f \u043c\u043e\u0436\u0443 \u0440\u043e\u0437\u043a\u0440\u0438\u0442\u0438 \u0442\u0430\u0454\u043c\u043d\u0438\u0447\u0456 \u043b\u0435\u0433\u0435\u043d\u0434\u0438 \u0432 Cubito?", "answer": "\u0420\u043e\u0437\u043a\u0440\u0438\u0442\u0442\u044f \u0442\u0430\u0454\u043c\u043d\u0438\u0447\u0438\u0445 \u043b\u0435\u0433\u0435\u043d\u0434 \u0443 Cubito \u043f\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0430\u0454 \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u044f \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0438\u0445 \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439 \u0442\u0430 \u0441\u043a\u043b\u0430\u0434\u0430\u043d\u043d\u044f \u0440\u0435\u0431\u0443\u0441\u0456\u0432. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f \u043d\u0438\u0437\u043a\u0438 \u0441\u0442\u0430\u0440\u043e\u0434\u0430\u0432\u043d\u0456\u0445 \u0442\u0430\u0431\u043b\u0438\u0447\u043e\u043a, \u0440\u043e\u0437\u043a\u0438\u0434\u0430\u043d\u0438\u0445 \u043f\u043e \u0456\u0433\u0440\u043e\u0432\u0456\u0439 \u043a\u0430\u0440\u0442\u0456, \u043c\u043e\u0436\u0435 \u0440\u043e\u0437\u043a\u0440\u0438\u0442\u0438 \u0456\u0441\u0442\u043e\u0440\u0456\u044e \u0437\u0430\u0431\u0443\u0442\u043e\u0457 \u0446\u0438\u0432\u0456\u043b\u0456\u0437\u0430\u0446\u0456\u0457. \u0414\u043b\u044f \u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u0440\u0435\u0442\u0435\u043b\u044c\u043d\u043e \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0443\u0439\u0442\u0435 \u043a\u043e\u0436\u043d\u0443 \u043c\u0456\u0441\u0446\u0435\u0432\u0456\u0441\u0442\u044c \u0442\u0430 \u0432\u0437\u0430\u0454\u043c\u043e\u0434\u0456\u0439\u0442\u0435 \u0437 \u0443\u0441\u0456\u043c\u0430 \u043e\u0431'\u0454\u043a\u0442\u0430\u043c\u0438. \u0412\u0435\u0434\u0456\u0442\u044c \u0449\u043e\u0434\u0435\u043d\u043d\u0438\u043a, \u0449\u043e\u0431 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0443\u0432\u0430\u0442\u0438 \u0441\u0432\u043e\u0457 \u0437\u043d\u0430\u0445\u0456\u0434\u043a\u0438 \u0442\u0430 \u0437'\u0454\u0434\u043d\u0430\u0442\u0438 \u0432\u0441\u0456 \u0442\u043e\u0447\u043a\u0438. \u0414\u0456\u0430\u0433\u0440\u0430\u043c\u0430 \u043f\u043e\u0442\u043e\u043a\u0443 \u043c\u043e\u0436\u0435 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0442\u0438 \u0432\u0456\u0437\u0443\u0430\u043b\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0437\u0432'\u044f\u0437\u043a\u0438 \u043c\u0456\u0436 \u0440\u0456\u0437\u043d\u0438\u043c\u0438 \u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442\u0430\u043c\u0438 \u0456\u0441\u0442\u043e\u0440\u0456\u0457, \u0449\u043e\u0431 \u0432\u0438 \u043d\u0435 \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u043b\u0438 \u0436\u043e\u0434\u043d\u043e\u0457 \u0432\u0430\u0436\u043b\u0438\u0432\u043e\u0457 \u0434\u0435\u0442\u0430\u043b\u0456."}]
[{"question": "\ud050\ube44\ud1a0 \uc2e0\uaddc \ud50c\ub808\uc774\uc5b4\ub85c\uc11c \uae30\ubcf8 \uc774\ub3d9\uc740 \uc5b4\ub5bb\uac8c \ud558\ub098\uc694?", "answer": "\ud050\ube44\ud1a0\uc5d0\uc11c \uae30\ubcf8 \uc774\ub3d9\uc740 \uac8c\uc784 \uc138\uacc4\ub97c \ud0d0\uc0c9\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uce90\ub9ad\ud130\ub97c \uc774\ub3d9\ud558\ub824\uba74 WASD \ud0a4\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. W\ub294 \uc55e\uc73c\ub85c, A\ub294 \uc67c\ucabd, S\ub294 \ub4a4\ub85c, D\ub294 \uc624\ub978\ucabd\uc73c\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc0c8\ub85c\uc6b4 \uc9c0\uc5ed\uc744 \ud0d0\ud5d8\ud558\ub824\uba74 W \ud0a4\ub97c \ub20c\ub7ec \uc55e\uc73c\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4. \ub610\ud55c, \uacf5\uac04 \ud0a4\ub97c \ub20c\ub7ec \uc7a5\uc560\ubb3c\uc744 \ub6f0\uc5b4\ub118\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub354\uc6b1 \uc6d0\ud65c\ud55c \uacbd\ud5d8\uc744 \uc704\ud574 \uc124\uc815 \uba54\ub274\uc5d0\uc11c \ub9c8\uc6b0\uc2a4 \ubbfc\uac10\ub3c4\ub97c \ud3b8\uc548\ud55c \uc218\uc900\uc73c\ub85c \uc870\uc815\ud558\uc138\uc694."}, {"question": "\ud050\ube44\ud1a0 \uc804\ud22c \uc2dc\uc2a4\ud15c\uc744 \ub9c8\uc2a4\ud130\ud558\ub294 \uc8fc\uc694 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud050\ube44\ud1a0 \uc804\ud22c \uc2dc\uc2a4\ud15c\uc744 \ub9c8\uc2a4\ud130\ud558\ub824\uba74 \ud0c0\uc774\ubc0d, \uc704\uce58 \uc120\uc815, \uc790\uc6d0 \uad00\ub9ac\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc41: \ud56d\uc0c1 \uc2a4\ud0dc\ubbf8\ub098 \uac8c\uc774\uc9c0\ub97c \uc8fc\uc2dc\ud558\uc2ed\uc2dc\uc624. \uacfc\ub3c4\ud55c \uacf5\uaca9\uc740 \ucde8\uc57d\ud558\uac8c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc42: \ubcbd\uacfc \uac19\uc740 \ud658\uacbd\uc744 \ud65c\uc6a9\ud558\uc5ec \ubcf4\ud638\ub9c9\uc73c\ub85c \uc0bc\uc73c\uc138\uc694. \ub2e8\uacc43: \ud6c8\ub828 \uad6c\uc5ed\uc5d0\uc11c \uc5f0\uacc4 \uacf5\uaca9\uc744 \uc5f0\uc2b5\ud558\uc5ec \ud6a8\uc728\uc131\uc744 \ub192\uc774\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc801\uc808\ud55c \ud68c\ud53c \ud6c4 \uc5ed\uc2b5\uc740 \uc804\ud22c \uc0c1\ud669\uc744 \ubc14\uafc0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud6a8\uacfc\uc801\uc778 \uc5f0\uacc4 \uacf5\uaca9\uc744 \ucd94\uc801\ud558\uae30 \uc704\ud55c \uad6c\uc131\ud45c\ub97c \ub9cc\ub4e4\uc5b4\ubcf4\uc138\uc694."}, {"question": "\ud050\ube44\ud1a0\uc758 \uc81c\uc791 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc65c \uc911\uc694\ud55c\uac00\uc694?", "answer": "\ud050\ube44\ud1a0\uc758 \uc81c\uc791 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uac15\ub825\ud55c \uc544\uc774\ud15c\uacfc \uc7a5\ube44\ub97c \uc81c\uc791\ud560 \uc218 \uc788\ub3c4\ub85d \ud574\uc8fc\uae30 \ub54c\ubb38\uc5d0 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uace0\uae09 \ubb34\uae30\ub97c \uc81c\uc791\ud558\uba74 \uc804\ud22c \ud6a8\uc728\uc744 \ud06c\uac8c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uba3c\uc800 \uad11\uc11d\uacfc \uc57d\ucd08\uc640 \uac19\uc740 \uc790\uc6d0\uc744 \uc218\uc9d1\ud558\uc138\uc694. \uadf8\ub7f0 \ub2e4\uc74c \uc81c\uc791 \uba54\ub274\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc774\ub7ec\ud55c \uc7ac\ub8cc\ub4e4\uc744 \uacb0\ud569\ud558\uc138\uc694. \ud50c\ub85c\uc6b0\ucc28\ud2b8\ub294 \uc81c\uc791 \uacfc\uc815\uc744 \uc2dc\uac01\uc801\uc73c\ub85c \ubcf4\uc5ec\uc8fc\uc5b4 \ub2e8\uacc4\ub97c \ub193\uce58\uc9c0 \uc54a\ub3c4\ub85d \ub3c4\uc640\uc90d\ub2c8\ub2e4. \uc81c\uc791\ud55c \uc544\uc774\ud15c\uc758 \ub0b4\uad6c\ub3c4\ub97c \ud56d\uc0c1 \ud655\uc778\ud558\uc5ec \ud6a8\uc728\uc744 \uc720\uc9c0\ud558\uc138\uc694."}, {"question": "\ud050\ube44\ud1a0\uc758 \ub808\ubca8\ub9c1 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \uc8fc\uc694 \uc774\uc815\ud45c\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud050\ube44\ud1a0\uc758 \ub808\ubca8\ub9c1 \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uc758 \uc9c4\ucc99\ub3c4\ub97c \ubcf4\uc0c1\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ud018\uc2a4\ud2b8\uc640 \uc804\ud22c\ub97c \ud1b5\ud574 \uacbd\ud5d8\uce58(XP)\ub97c \uc5bb\uc73c\uba74 \ub808\ubca8\uc5c5\uc774 \ub418\uba70, \uc0c8\ub85c\uc6b4 \ub2a5\ub825\uc744 \ud574\uc81c\ud558\uace0 \ub2a5\ub825\uce58\ub97c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc8fc\uc694 \uc774\uc815\ud45c\ub294 \ub808\ubca8 10 \ub2ec\uc131\uc73c\ub85c \uc0c8\ub85c\uc6b4 \uc2a4\ud0ac \ud2b8\ub9ac\ub97c \ud574\uc81c\ud558\uace0, \ub808\ubca8 20 \ub2ec\uc131\uc73c\ub85c \uace0\uae09 \uc81c\uc791 \ub808\uc2dc\ud53c\ub97c \uc5f4 \uc218 \uc788\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 15\uc5d0\uc11c \uba54\uc778 \ud018\uc2a4\ud2b8\ub97c \uc644\ub8cc\ud558\uba74 \uc0c1\ub2f9\ud55c \uacbd\ud5d8\uce58 \ubcf4\ub108\uc2a4\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uad6c\uc131\ud45c\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc9c4\ucc99\ub3c4\ub97c \ucd94\uc801\ud558\uace0 \ub808\ubca8\ub9c1 \uc804\ub7b5\uc744 \uacc4\ud68d\ud558\uc138\uc694."}, {"question": "\ud050\ube44\ud1a0\uc5d0\uc11c \uc790\uc6d0\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \ucd5c\uace0\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud050\ube44\ud1a0\uc5d0\uc11c \ud6a8\uacfc\uc801\uc778 \uc790\uc6d0 \uad00\ub9ac\uac00 \uc7a5\uae30\uc801\uc778 \uc131\uacf5\uc744 \uc704\ud55c \ud544\uc218 \uc694\uc18c\uc785\ub2c8\ub2e4. \ub2e8\uacc41: \uad11\uc11d\uacfc \uc57d\ucd08\uc640 \uac19\uc740 \ud544\uc218\uc801\uc778 \uc7ac\ub8cc\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \uc218\uc9d1\ud558\uc138\uc694. \ub2e8\uacc42: \ubcf4\uad00\ud568\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc778\ubca4\ud1a0\ub9ac\ub97c \uc815\ub9ac\ud558\uc138\uc694. \ub2e8\uacc43: \uc608\ube44 \uc544\uc774\ud15c\uc744 \uc815\uae30\uc801\uc73c\ub85c \ud310\ub9e4\ud558\uac70\ub098 \uac70\ub798\ud558\uc5ec \uacf5\uac04\uc744 \ud655\ubcf4\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc0ac\uc6a9\ud558\uc9c0 \uc54a\ub294 \ud3ec\uc158\uc744 \ud310\ub9e4\ud558\uba74 \ub354 \uc88b\uc740 \uc7a5\ube44\ub97c \uc704\ud55c \ucd94\uac00 \uace8\ub4dc\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc5ec\ub7ec \uacc4\ud68d\uc744 \ube44\uad50\ud558\ub294 \ud45c\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc790\uc6d0\uc744 \uc81c\uc791, \ud310\ub9e4 \ub610\ub294 \uac70\ub798\ud558\ub294 \ub370 \uac00\uc7a5 \uc801\ud569\ud55c \ubc29\ubc95\uc744 \ud310\ub2e8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc5d4\ub4dc \uac8c\uc784 \ucf58\ud150\uce20\uc5d0 \ub9de\ucdb0 \ud050\ube44\ud1a0 \uce90\ub9ad\ud130\ub97c \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc5d4\ub4dc \uac8c\uc784 \ucf58\ud150\uce20\uc5d0 \ub9de\ucdb0 \ud050\ube44\ud1a0 \uce90\ub9ad\ud130\ub97c \ucd5c\uc801\ud654\ud558\ub294 \uac83\uc740 \uc2e0\uc911\ud55c \uacc4\ud68d\uacfc \uc2e4\ud589\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc41: \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub530\ub77c \ud798 \ub610\ub294 \uc9c0\ub2a5\uacfc \uac19\uc740 \uc8fc\uc694 \ub2a5\ub825\uce58\ub97c \uadf9\ub300\ud654\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \ub2e8\uacc42: \uc120\ud0dd\ud55c \ub2a5\ub825\uc5d0 \ub9de\ub294 \uc7a5\ube44\ub97c \ucc29\uc6a9\ud558\uc138\uc694. \ub2e8\uacc43: \uacbd\uc7c1\ub825\uc744 \uc720\uc9c0\ud558\uae30 \uc704\ud574 \uc7a5\ube44\ub97c \uc815\uae30\uc801\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub9c8\ubc95\uc0ac \ube4c\ub4dc\ub294 \ub192\uc740 \uc9c0\ub2a5\uacfc \ub9c8\ub098 \ud68c\ubcf5 \uc7a5\ube44\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e4\uc591\ud55c \ube4c\ub4dc\uc640 \uac01 \uc2dc\ub098\ub9ac\uc624\uc5d0\uc11c\uc758 \ud6a8\uc728\uc131\uc744 \ube44\uad50\ud558\uae30 \uc704\ud55c \uad6c\uc131\ud45c\ub97c \uc0ac\uc6a9\ud558\uc138\uc694."}, {"question": "\ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ud050\ube44\ud1a0\ub97c \uc2e4\ud589\ud558\ub294 \ub370 \ud544\uc694\ud55c \uae30\uc220 \uc0ac\uc591\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud050\ube44\ud1a0\ub294 \ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ub418\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc9c0\ub9cc, \uae30\uc220 \uc0ac\uc591\uc740 \ub2e4\ub985\ub2c8\ub2e4. PC\uc758 \uacbd\uc6b0 \ucd5c\uc18c 8GB RAM\uacfc GTX 1050 GPU\uac00 \uad8c\uc7a5\ub429\ub2c8\ub2e4. PlayStation 5\uc640 \uac19\uc740 \ucf58\uc194\uc5d0\uc11c\ub294 \ucd5c\uc2e0 \uc2dc\uc2a4\ud15c \uc5c5\ub370\uc774\ud2b8\ub97c \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4. \ubaa8\ubc14\uc77c \uae30\uae30\uc758 \uacbd\uc6b0 \ucd5c\uc18c 4GB RAM\uacfc Android 10 \ub610\ub294 iOS 13 \uc774\uc0c1\uc758 \uae30\uae30\uc5d0 \uc124\uce58\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, RTX 3080\uc774 \uc7a5\ucc29\ub41c \uace0\uc131\ub2a5 PC\uc5d0\uc11c \ud050\ube44\ud1a0\ub97c \uc2e4\ud589\ud558\uba74 \ucd5c\uace0\uc758 \uadf8\ub798\ud53d \ud658\uacbd\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc5ec\ub7ec \ud50c\ub7ab\ud3fc\uc758 \uc694\uad6c \uc0ac\ud56d\uc744 \ube44\uad50\ud560 \uc218 \uc788\ub294 \uad6c\uc131 \ud45c\ub97c \uc0ac\uc6a9\ud558\uba74 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4."}, {"question": "\ud050\ube44\ud1a0 \uc800\uc7a5 \ub370\uc774\ud130\ub97c \ub2e4\ub978 \uae30\uae30\ub85c \uc804\uc1a1\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud050\ube44\ud1a0 \uc800\uc7a5 \ub370\uc774\ud130\ub97c \ub2e4\ub978 \uae30\uae30\ub85c \uc804\uc1a1\ud558\ub294 \uac83\uc740 \uac04\ub2e8\ud569\ub2c8\ub2e4. \ub2e8\uacc41: \ub450 \uae30\uae30 \ubaa8\ub450 \uac19\uc740 \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\ub3c4\ub85d \ud558\uc138\uc694. \ub2e8\uacc42: \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud604\uc7ac \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5c5\ub85c\ub4dc\ud558\uc138\uc694. \ub2e8\uacc43: \uc0c8 \uae30\uae30\uc5d0\uc11c \uc800\uc7a5 \ud30c\uc77c\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ubaa8\ubc14\uc77c \uae30\uae30\ub85c \uc774\ub3d9\ud558\ub294 \uacbd\uc6b0 \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uace0 \ucd5c\uc2e0 \uc800\uc7a5 \ud30c\uc77c\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uba74 \ub429\ub2c8\ub2e4. \uc6d0\ud65c\ud55c \uc804\ud658\uc744 \uc704\ud574 \ud50c\ub85c\uc6b0\ucc28\ud2b8\uac00 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4."}, {"question": "\ub300\ubd80\ubd84\uc758 \ud50c\ub808\uc774\uc5b4\uac00 \uac04\uacfc\ud558\ub294 \ud050\ube44\ud1a0\uc758 \uc228\uaca8\uc9c4 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud050\ube44\ud1a0\uc5d0\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uba54\ucee4\ub2c8\uc998\uc774 \uc788\uc5b4 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc774\uc810\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uadf8 \uc911 \ud558\ub098\ub294 \uc5f0\uc18d \uc810\ud504 \ud6c4 \uc18d\ub3c4\uac00 \uc99d\uac00\ud558\ub294 '\ucd94\uc9c4\ub825 \ubd80\uc2a4\ud2b8' \uba54\ucee4\ub2c8\uc998\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5f0\uc18d \uc138 \ubc88\uc758 \uc810\ud504\ub97c \ud558\uba74 \uc77c\uc2dc\uc801\uc778 \uc18d\ub3c4 \ubd80\uc2a4\ud2b8\uac00 \ubc1c\uc0dd\ud558\uc5ec \uc801\uc744 \ud53c\ud558\uac70\ub098 \uba3c \uac70\ub9ac\uc758 \ud50c\ub7ab\ud3fc\uc5d0 \ub3c4\ub2ec\ud558\ub294 \ub370 \uc720\uc6a9\ud569\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uac04\uacfc\ub41c \uae30\ub2a5\uc740 '\ud658\uacbd \uc0c1\ud638\uc791\uc6a9'\uc73c\ub85c, \ud2b9\uc815 \ubb3c\uccb4\ub97c \uc870\uc791\ud558\uc5ec \ub2e8\ucd95\ud0a4\ub098 \ud568\uc815\uc744 \ub9cc\ub4dc\ub294 \uac83\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \ud0d0\uc0c9\ud558\uace0 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \ud1b5\ud569\ud558\uae30 \uc704\ud55c \uc5ec\ub7ec \uacc4\ud68d\uc744 \ube44\uad50\ud558\ub294 \ud45c\ub97c \uc0ac\uc6a9\ud558\uc138\uc694."}, {"question": "\ud050\ube44\ud1a0\uc758 \ube44\ubc00\uc2a4\ub7ec\uc6b4 \uc5ed\uc0ac\ub97c \uc5b4\ub5bb\uac8c \ubc1d\ud600\ub0bc \uc218 \uc788\ub098\uc694?", "answer": "\ud050\ube44\ud1a0\uc758 \ube44\ubc00\uc2a4\ub7ec\uc6b4 \uc5ed\uc0ac\ub97c \ubc1d\ud788\ub824\uba74 \uc228\uaca8\uc9c4 \uc9c0\uc5ed\uc744 \ud0d0\ud5d8\ud558\uace0 \ub2e8\uc11c\ub4e4\uc744 \uc870\ud569\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac8c\uc784 \uc138\uacc4 \uacf3\uacf3\uc5d0 \ud769\uc5b4\uc838 \uc788\ub294 \uace0\ub300\uc758 \ud310\uc11d\uc744 \ucc3e\uc73c\uba74 \uc78a\ud600\uc9c4 \ubb38\uba85\uc758 \uc5ed\uc0ac\ub97c \uc54c\uc544\ub0bc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uba3c\uc800 \uac01 \uc9c0\uc5ed\uc744 \ucca0\uc800\ud788 \ud0d0\ud5d8\ud558\uace0 \ubaa8\ub4e0 \ubb3c\uccb4\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\uc138\uc694. \ubc1c\uacac\ud55c \ub0b4\uc6a9\uc744 \uae30\ub85d\ud558\uc5ec \uc5f0\uacb0\uace0\ub9ac\ub97c \ucc3e\uc73c\uc138\uc694. \ub2e4\uc591\ud55c \ub2e8\uc11c \uac04\uc758 \uc5f0\uacb0\uc744 \uc2dc\uac01\ud654\ud558\uace0 \uc911\uc694\ud55c \uc138\ubd80 \uc0ac\ud56d\uc744 \ub193\uce58\uc9c0 \uc54a\ub3c4\ub85d \ud50c\ub85c\uc6b0\ucc28\ud2b8\uac00 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4."}]
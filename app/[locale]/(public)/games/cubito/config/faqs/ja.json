[{"question": "Cubito\u306e\u65b0\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u3057\u3066\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u65b9\u6cd5\u3092\u8aac\u660e\u3057\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "Cubito\u3067\u306f\u3001\u30b2\u30fc\u30e0\u306e\u4e16\u754c\u3092\u79fb\u52d5\u3059\u308b\u305f\u3081\u306b\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u306f\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u79fb\u52d5\u3059\u308b\u306b\u306f\u3001WASD\u30ad\u30fc\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002W\u30ad\u30fc\u306f\u524d\u9032\u3001A\u30ad\u30fc\u306f\u5de6\u3001S\u30ad\u30fc\u306f\u5f8c\u9000\u3001D\u30ad\u30fc\u306f\u53f3\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u65b0\u3057\u3044\u30a8\u30ea\u30a2\u3092\u63a2\u691c\u3059\u308b\u306b\u306f\u3001W\u30ad\u30fc\u3092\u62bc\u3057\u3066\u524d\u9032\u3057\u307e\u3059\u3002\u307e\u305f\u3001\u969c\u5bb3\u7269\u3092\u30b8\u30e3\u30f3\u30d7\u3059\u308b\u306b\u306f\u3001\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u3088\u308a\u30b9\u30e0\u30fc\u30ba\u306a\u64cd\u4f5c\u306e\u305f\u3081\u306b\u3001\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u3067\u30de\u30a6\u30b9\u306e\u611f\u5ea6\u3092\u81ea\u5206\u306e\u597d\u307f\u306b\u5408\u308f\u305b\u3066\u8abf\u6574\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "Cubito\u306e\u6226\u95d8\u30b7\u30b9\u30c6\u30e0\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u305f\u3081\u306e\u91cd\u8981\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Cubito\u306e\u6226\u95d8\u30b7\u30b9\u30c6\u30e0\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3001\u4f4d\u7f6e\u53d6\u308a\u3001\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u306e\u7d44\u307f\u5408\u308f\u305b\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5e38\u306b\u30b9\u30bf\u30df\u30ca\u30d0\u30fc\u3092\u78ba\u8a8d\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30bf\u30df\u30ca\u3092\u4f7f\u3044\u3059\u304e\u308b\u3068\u3001\u6575\u306e\u653b\u6483\u306b\u5f31\u304f\u306a\u3063\u3066\u3057\u307e\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u58c1\u306a\u3069\u306e\u74b0\u5883\u3092\u6709\u52b9\u6d3b\u7528\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7df4\u7fd2\u30a8\u30ea\u30a2\u3067\u30b3\u30f3\u30dc\u3092\u7df4\u7fd2\u3057\u3066\u52b9\u7387\u3092\u9ad8\u3081\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u306e\u826f\u3044\u56de\u907f\u306e\u5f8c\u3001\u30ab\u30a6\u30f3\u30bf\u30fc\u653b\u6483\u3067\u6226\u6cc1\u3092\u6709\u5229\u306b\u5909\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u6700\u3082\u52b9\u679c\u7684\u306a\u30b3\u30f3\u30dc\u3092\u8ffd\u8de1\u3059\u308b\u305f\u3081\u306e\u69cb\u6210\u8868\u3092\u4f5c\u6210\u3059\u308b\u3053\u3068\u3092\u691c\u8a0e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u9ad8\u5ea6\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u3001Cubito\u306e\u30af\u30e9\u30d5\u30c8\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "Cubito\u306e\u30af\u30e9\u30d5\u30c8\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u9ad8\u5ea6\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u91cd\u8981\u306a\u3053\u3068\u3067\u3059\u3002\u5f37\u529b\u306a\u30a2\u30a4\u30c6\u30e0\u3084\u88c5\u5099\u3092\u4f5c\u6210\u3067\u304d\u308b\u304b\u3089\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u9ad8\u30ec\u30d9\u30eb\u306e\u6b66\u5668\u3092\u4f5c\u6210\u3059\u308b\u3068\u3001\u6226\u95d8\u80fd\u529b\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002\u307e\u305a\u3001\u9271\u77f3\u3084\u30cf\u30fc\u30d6\u306a\u3069\u306e\u8cc7\u6e90\u3092\u96c6\u3081\u307e\u3057\u3087\u3046\u3002\u6b21\u306b\u3001\u30af\u30e9\u30d5\u30c8\u30e1\u30cb\u30e5\u30fc\u3092\u4f7f\u7528\u3057\u3066\u3053\u308c\u3089\u306e\u7d20\u6750\u3092\u7d44\u307f\u5408\u308f\u305b\u307e\u3059\u3002\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u306f\u3001\u4f5c\u6210\u30d7\u30ed\u30bb\u30b9\u3092\u8996\u899a\u5316\u3057\u3001\u624b\u9806\u3092\u9003\u3055\u306a\u3044\u3088\u3046\u306b\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u4f5c\u6210\u3057\u305f\u30a2\u30a4\u30c6\u30e0\u306e\u8010\u4e45\u6027\u3092\u5e38\u306b\u78ba\u8a8d\u3057\u3066\u3001\u52b9\u7387\u3092\u7dad\u6301\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "Cubito\u306e\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u3069\u306e\u3088\u3046\u306a\u91cd\u8981\u306a\u30de\u30a4\u30eb\u30b9\u30c8\u30fc\u30f3\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "Cubito\u306e\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u9032\u6b69\u3092\u5831\u3044\u308b\u8a2d\u8a08\u3067\u3059\u3002\u30af\u30a8\u30b9\u30c8\u3084\u6226\u95d8\u3092\u901a\u3058\u3066\u7d4c\u9a13\u5024\u3092\u7372\u5f97\u3059\u308b\u3068\u3001\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u3057\u3001\u65b0\u3057\u3044\u80fd\u529b\u304c\u89e3\u7981\u3055\u308c\u3001\u30b9\u30c6\u30fc\u30bf\u30b9\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002\u91cd\u8981\u306a\u30de\u30a4\u30eb\u30b9\u30c8\u30fc\u30f3\u306b\u306f\u3001\u30ec\u30d9\u30eb10\u5230\u9054\u3067\u65b0\u3057\u3044\u30b9\u30ad\u30eb\u30c4\u30ea\u30fc\u304c\u89e3\u7981\u3055\u308c\u3001\u30ec\u30d9\u30eb20\u5230\u9054\u3067\u9ad8\u5ea6\u306a\u30af\u30e9\u30d5\u30c8\u30ec\u30b7\u30d4\u304c\u5229\u7528\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308b\u3053\u3068\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb15\u3067\u30e1\u30a4\u30f3\u30af\u30a8\u30b9\u30c8\u3092\u5b8c\u4e86\u3059\u308b\u3068\u3001\u7d4c\u9a13\u5024\u304c\u5927\u5e45\u306b\u5897\u52a0\u3057\u307e\u3059\u3002\u9032\u6357\u72b6\u6cc1\u3092\u8ffd\u8de1\u3057\u3001\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u6226\u7565\u3092\u8a08\u753b\u3059\u308b\u305f\u3081\u306e\u69cb\u6210\u8868\u3092\u6d3b\u7528\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "Cubito\u3067\u30ea\u30bd\u30fc\u30b9\u3092\u7ba1\u7406\u3059\u308b\u305f\u3081\u306e\u30d9\u30b9\u30c8\u30d7\u30e9\u30af\u30c6\u30a3\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Cubito\u3067\u306e\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u306f\u3001\u9577\u671f\u7684\u306a\u6210\u529f\u306b\u3068\u3063\u3066\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u9271\u77f3\u3084\u30cf\u30fc\u30d6\u306a\u3069\u306e\u5fc5\u9808\u7d20\u6750\u3092\u96c6\u3081\u308b\u3053\u3068\u3092\u512a\u5148\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u4fdd\u7ba1\u5bb9\u5668\u3092\u4f7f\u7528\u3057\u3066\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u3092\u6574\u7406\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u4f59\u5270\u30a2\u30a4\u30c6\u30e0\u3092\u5b9a\u671f\u7684\u306b\u58f2\u5374\u307e\u305f\u306f\u53d6\u5f15\u3057\u3066\u3001\u30b9\u30da\u30fc\u30b9\u3092\u78ba\u4fdd\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u4f7f\u7528\u3055\u308c\u3066\u3044\u306a\u3044\u30dd\u30fc\u30b7\u30e7\u30f3\u3092\u58f2\u5374\u3059\u308b\u3068\u3001\u3088\u308a\u826f\u3044\u88c5\u5099\u306e\u305f\u3081\u306b\u8ffd\u52a0\u306e\u30b4\u30fc\u30eb\u30c9\u3092\u5165\u624b\u3067\u304d\u307e\u3059\u3002\u30de\u30eb\u30c1\u30b9\u30ad\u30fc\u30e0\u6bd4\u8f03\u306f\u3001\u30af\u30e9\u30d5\u30c8\u3001\u8ca9\u58f2\u3001\u53d6\u5f15\u306a\u3069\u3055\u307e\u3056\u307e\u306a\u7528\u9014\u306e\u8cc7\u6e90\u3092\u6c7a\u5b9a\u3059\u308b\u969b\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30a8\u30f3\u30c9\u30b3\u30f3\u30c6\u30f3\u30c4\u5411\u3051\u306eCubito\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30d3\u30eb\u30c9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30a8\u30f3\u30c9\u30b3\u30f3\u30c6\u30f3\u30c4\u5411\u3051\u306eCubito\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30d3\u30eb\u30c9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u7dbf\u5bc6\u306a\u8a08\u753b\u3068\u5b9f\u884c\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u5fdc\u3058\u3066\u3001\u529b\u3084\u77e5\u6027\u306a\u3069\u306e\u4e3b\u8981\u306a\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u6700\u5927\u9650\u306b\u9ad8\u3081\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u9078\u629e\u3057\u305f\u80fd\u529b\u306b\u88dc\u5b8c\u7684\u306a\u88c5\u5099\u3092\u88c5\u5099\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7af6\u4e89\u529b\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u3001\u88c5\u5099\u3092\u5b9a\u671f\u7684\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u9b54\u6cd5\u4f7f\u3044\u30d3\u30eb\u30c9\u306f\u9ad8\u3044\u77e5\u6027\u3068\u9b54\u529b\u56de\u5fa9\u88c5\u5099\u3092\u6d3b\u304b\u3057\u307e\u3059\u3002\u3055\u307e\u3056\u307e\u306a\u30d3\u30eb\u30c9\u3068\u3001\u3055\u307e\u3056\u307e\u306a\u30b7\u30ca\u30ea\u30aa\u3067\u306e\u6709\u52b9\u6027\u3092\u6bd4\u8f03\u3059\u308b\u305f\u3081\u306e\u69cb\u6210\u8868\u3092\u5229\u7528\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067Cubito\u3092\u5b9f\u884c\u3059\u308b\u305f\u3081\u306b\u5fc5\u8981\u306a\u6280\u8853\u4ed5\u69d8\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Cubito\u306f\u3055\u307e\u3056\u307e\u306a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u30b9\u30e0\u30fc\u30ba\u306b\u52d5\u4f5c\u3059\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u304c\u3001\u6280\u8853\u4ed5\u69d8\u306f\u7570\u306a\u308a\u307e\u3059\u3002PC\u306e\u5834\u5408\u306f\u3001\u6700\u5c0f\u30678GB\u306eRAM\u3068GTX 1050\u306eGPU\u304c\u63a8\u5968\u3055\u308c\u307e\u3059\u3002PlayStation 5\u306a\u3069\u306e\u30b3\u30f3\u30bd\u30fc\u30eb\u3067\u306f\u3001\u6700\u65b0\u306e\u30b7\u30b9\u30c6\u30e0\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3092\u9069\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u306e\u5834\u5408\u306f\u3001\u5c11\u306a\u304f\u3068\u30824GB\u306eRAM\u3068Android 10\u307e\u305f\u306fiOS 13\u3092\u642d\u8f09\u3057\u305f\u30c7\u30d0\u30a4\u30b9\u304c\u7406\u60f3\u7684\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001RTX 3080\u3092\u642d\u8f09\u3057\u305f\u30cf\u30a4\u30a8\u30f3\u30c9PC\u3067Cubito\u3092\u5b9f\u884c\u3059\u308b\u3068\u3001\u6700\u9ad8\u306e\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u4f53\u9a13\u304c\u5f97\u3089\u308c\u307e\u3059\u3002\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u306e\u8981\u4ef6\u3092\u6bd4\u8f03\u3059\u308b\u305f\u3081\u306e\u69cb\u6210\u8868\u3092\u6d3b\u7528\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "Cubito\u306e\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u3092\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Cubito\u306e\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u3092\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u8ee2\u9001\u3059\u308b\u65b9\u6cd5\u306f\u7c21\u5358\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30af\u30e9\u30a6\u30c9\u30bb\u30fc\u30d6\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u73fe\u5728\u306e\u9032\u6357\u72b6\u6cc1\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u30bb\u30fc\u30d6\u30d5\u30a1\u30a4\u30eb\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001PC\u304b\u3089\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u306b\u79fb\u884c\u3059\u308b\u5834\u5408\u3001\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3001\u6700\u65b0\u306e\u30bb\u30fc\u30d6\u30d5\u30a1\u30a4\u30eb\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u30b9\u30e0\u30fc\u30ba\u306a\u79fb\u884c\u3092\u78ba\u5b9f\u306b\u3059\u308b\u305f\u3081\u306e\u624b\u9806\u3092\u8996\u899a\u5316\u3059\u308b\u305f\u3081\u306e\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u591a\u304f\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u898b\u904e\u3054\u3057\u3066\u3057\u307e\u3046Cubito\u306e\u96a0\u3055\u308c\u305f\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Cubito\u306b\u306f\u3001\u6709\u5229\u306b\u6226\u3048\u308b\u3088\u3046\u306b\u3059\u308b\u96a0\u3055\u308c\u305f\u30e1\u30ab\u30cb\u30ba\u30e0\u304c\u3044\u304f\u3064\u304b\u3042\u308a\u307e\u3059\u3002\u305d\u306e1\u3064\u306f\u3001\u9023\u7d9a\u30b8\u30e3\u30f3\u30d7\u5f8c\u3001\u30b9\u30d4\u30fc\u30c9\u304c\u5411\u4e0a\u3059\u308b\u300c\u30e2\u30fc\u30e1\u30f3\u30bf\u30e0\u30d6\u30fc\u30b9\u30c8\u300d\u3067\u3059\u3002\u4f8b\u3048\u3070\u30013\u56de\u7d9a\u3051\u3066\u30b8\u30e3\u30f3\u30d7\u3059\u308b\u3068\u3001\u4e00\u6642\u7684\u306b\u30b9\u30d4\u30fc\u30c9\u304c\u4e0a\u304c\u308a\u3001\u6575\u304b\u3089\u9003\u3052\u308b\u304b\u3001\u9060\u304f\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u79fb\u52d5\u3059\u308b\u969b\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u3082\u30461\u3064\u306e\u898b\u904e\u3054\u3055\u308c\u304c\u3061\u306a\u6a5f\u80fd\u306f\u3001\u300c\u74b0\u5883\u3068\u306e\u76f8\u4e92\u4f5c\u7528\u300d\u3067\u3059\u3002\u7279\u5b9a\u306e\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u64cd\u4f5c\u3059\u308b\u3068\u3001\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u3084\u30c8\u30e9\u30c3\u30d7\u3092\u4f5c\u6210\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u63a2\u7d22\u3057\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u7d44\u307f\u8fbc\u3080\u305f\u3081\u306b\u306f\u3001\u30de\u30eb\u30c1\u30b9\u30ad\u30fc\u30e0\u6bd4\u8f03\u3092\u6d3b\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "Cubito\u306e\u79d8\u3081\u3089\u308c\u305f\u30ed\u30a2\u3092\u767a\u898b\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Cubito\u306e\u79d8\u5bc6\u306e\u30ed\u30a2\u3092\u767a\u898b\u3059\u308b\u306b\u306f\u3001\u96a0\u308c\u305f\u30a8\u30ea\u30a2\u3092\u63a2\u691c\u3057\u3001\u624b\u304c\u304b\u308a\u3092\u7d44\u307f\u5408\u308f\u305b\u3066\u3044\u304f\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b2\u30fc\u30e0\u4e16\u754c\u306e\u81f3\u308b\u3068\u3053\u308d\u306b\u6563\u3089\u3070\u3063\u3066\u3044\u308b\u53e4\u4ee3\u306e\u677f\u3092\u898b\u3064\u3051\u308b\u3068\u3001\u5fd8\u308c\u3089\u308c\u305f\u6587\u660e\u306e\u904e\u53bb\u304c\u660e\u3089\u304b\u306b\u306a\u308a\u307e\u3059\u3002\u307e\u305a\u3001\u5404\u5730\u57df\u3092\u5fb9\u5e95\u7684\u306b\u63a2\u7d22\u3057\u3001\u3059\u3079\u3066\u306e\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3068\u5bfe\u8a71\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u898b\u3064\u3051\u305f\u5185\u5bb9\u3092\u8a18\u9332\u3057\u3001\u95a2\u9023\u6027\u3092\u7d50\u3073\u4ed8\u3051\u308b\u305f\u3081\u306e\u30b8\u30e3\u30fc\u30ca\u30eb\u3092\u4fdd\u7ba1\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u3001\u3055\u307e\u3056\u307e\u306a\u30ed\u30a2\u306e\u3064\u306a\u304c\u308a\u3092\u8996\u899a\u5316\u3057\u3001\u91cd\u8981\u306a\u8a73\u7d30\u3092\u9003\u3055\u306a\u3044\u3088\u3046\u306b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}]
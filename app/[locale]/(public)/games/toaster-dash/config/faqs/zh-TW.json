[{"question": "\u5982\u4f55\u5728\u300e\u70e4\u9eb5\u5305\u6a5f\u885d\u523a\u300f\u904a\u6232\u4e2d\u57f7\u884c\u8df3\u8e8d\u548c\u885d\u523a\u7b49\u57fa\u672c\u52d5\u4f5c\uff1f", "answer": "\u5728\u300e\u70e4\u9eb5\u5305\u6a5f\u885d\u523a\u300f\u904a\u6232\u4e2d\uff0c\u57fa\u672c\u63a7\u5236\u96d6\u7136\u7c21\u55ae\u537b\u81f3\u95dc\u91cd\u8981\u3002\u8981\u8df3\u8e8d\uff0c\u8acb\u6309\u4e0b\u300e\u7a7a\u683c\u9375\u300f\u6216\u63a7\u5236\u5668\u4e0a\u7684\u300eA\u300f\u6309\u9215\u3002\u8981\u885d\u523a\uff0c\u8acb\u4f7f\u7528\u300eShift\u300f\u9375\u6216\u63a7\u5236\u5668\u4e0a\u7684\u300eB\u300f\u6309\u9215\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u95dc\uff0c\u4f60\u9700\u8981\u8df3\u904e\u4e00\u500b\u70e4\u9eb5\u5305\u6a5f\uff0c\u7136\u5f8c\u885d\u904e\u4e00\u500b\u72f9\u7a84\u7684\u7a7a\u9699\u3002\u9019\u4e9b\u52d5\u4f5c\u662f\u99d5\u99ad\u904a\u6232\u969c\u7919\u4e26\u63a8\u9032\u95dc\u5361\u7684\u57fa\u790e\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4e00\u4e0b\uff0c\u8df3\u8e8d\u5c31\u50cf\u8df3\u904e\u4e00\u500b\u5c0f\u7c6c\u7b06\uff0c\u885d\u523a\u5c31\u50cf\u885d\u904e\u4e00\u500b\u72f9\u7a84\u7684\u5df7\u9053\u3002]"}, {"question": "\u5728\u300e\u70e4\u9eb5\u5305\u6a5f\u885d\u523a\u300f\u904a\u6232\u4e2d\uff0c\u5982\u4f55\u624d\u80fd\u5728\u55ae\u4e00\u95dc\u5361\u6536\u96c6\u6240\u6709\u786c\u5e63\uff1f", "answer": "\u5728\u300e\u70e4\u9eb5\u5305\u6a5f\u885d\u523a\u300f\u904a\u6232\u4e2d\uff0c\u6536\u96c6\u6240\u6709\u786c\u5e63\u9700\u8981\u7cbe\u6e96\u5ea6\u548c\u898f\u5283\u3002\u6b65\u9a5f1\uff1a\u4ed4\u7d30\u89c0\u5bdf\u95dc\u5361\u4f48\u5c40\uff0c\u627e\u51fa\u786c\u5e63\u4f4d\u7f6e\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u8df3\u8e8d\u548c\u885d\u523a\u4f86\u5230\u9054\u9ad8\u8655\u6216\u96b1\u85cf\u5340\u57df\u3002\u6b65\u9a5f3\uff1a\u6e96\u78ba\u63a7\u5236\u4f60\u7684\u52d5\u4f5c\u4f86\u907f\u514d\u969c\u7919\u4e26\u6536\u96c6\u786c\u5e63\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e09\u95dc\uff0c\u786c\u5e63\u6563\u843d\u5728\u9700\u8981\u7cbe\u78ba\u8df3\u8e8d\u7684\u5e73\u53f0\u4e0a\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u6709\u4e9b\u73a9\u5bb6\u559c\u6b61\u5728\u7b2c\u4e00\u904d\u5c31\u6536\u96c6\u6240\u6709\u786c\u5e63\uff0c\u800c\u53e6\u4e00\u4e9b\u73a9\u5bb6\u5247\u5728\u638c\u63e1\u904a\u6232\u6a5f\u5236\u5f8c\u91cd\u73a9\u95dc\u5361\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u7684\u89d2\u8272\u5728\u300e\u70e4\u9eb5\u5305\u6a5f\u885d\u523a\u300f\u904a\u6232\u4e2d\u885d\u523a\u6642\u6709\u6642\u6703\u5361\u4f4f\uff1f", "answer": "\u5728\u300e\u70e4\u9eb5\u5305\u6a5f\u885d\u523a\u300f\u904a\u6232\u4e2d\uff0c\u885d\u523a\u6642\u5361\u4f4f\u901a\u5e38\u662f\u78b0\u649e\u6aa2\u6e2c\u554f\u984c\u9020\u6210\u7684\u3002\u5982\u679c\u6642\u9593\u4e0d\u6e96\u78ba\uff0c\u904a\u6232\u7684\u7269\u7406\u5f15\u64ce\u53ef\u80fd\u6703\u5c07\u885d\u523a\u8996\u70ba\u8207\u969c\u7919\u7269\u78b0\u649e\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e94\u95dc\uff0c\u904e\u65e9\u5730\u885d\u5411\u7246\u58c1\u6703\u5c0e\u81f4\u89d2\u8272\u5361\u4f4f\u3002\u70ba\u907f\u514d\u6b64\u554f\u984c\uff0c\u8acb\u78ba\u4fdd\u4f60\u5728\u6b63\u78ba\u7684\u6642\u9593\u548c\u89d2\u5ea6\u885d\u523a\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u9375\u76e4\u548c\u63a7\u5236\u5668\u7684\u885d\u523a\u6642\u9593\u53ef\u80fd\u7565\u6709\u4e0d\u540c\uff0c\u6240\u4ee5\u8acb\u4f7f\u7528\u4f60\u504f\u597d\u7684\u8f38\u5165\u65b9\u5f0f\u7df4\u7fd2\u3002]"}, {"question": "\u5982\u4f55\u5728\u300e\u70e4\u9eb5\u5305\u6a5f\u885d\u523a\u300f\u904a\u6232\u4e2d\u4f7f\u7528\u9023\u64ca\u500d\u6578\u4f86\u6700\u4f73\u5316\u6211\u7684\u5f97\u5206\uff1f", "answer": "\u8981\u5728\u300e\u70e4\u9eb5\u5305\u6a5f\u885d\u523a\u300f\u904a\u6232\u4e2d\u6700\u5927\u5316\u4f60\u7684\u5f97\u5206\uff0c\u61c9\u5c08\u6ce8\u65bc\u9023\u7e8c\u52d5\u4f5c\u4f86\u5efa\u7acb\u9023\u64ca\u500d\u6578\u3002\u6b65\u9a5f1\uff1a\u5728\u4e0d\u63a5\u89f8\u5730\u9762\u60c5\u6cc1\u4e0b\u57f7\u884c\u9023\u7e8c\u8df3\u8e8d\u548c\u885d\u523a\u3002\u6b65\u9a5f2\uff1a\u5728\u9023\u64ca\u671f\u9593\u6536\u96c6\u786c\u5e63\u548c\u589e\u76ca\u9053\u5177\u3002\u6b65\u9a5f3\uff1a\u5feb\u901f\u5b8c\u6210\u95dc\u5361\u4ee5\u7372\u5f97\u984d\u5916\u6642\u9593\u734e\u52f5\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e03\u95dc\uff0c\u4e00\u500b\u7cbe\u6e96\u7684\u9023\u64ca\u53ef\u4ee5\u8b93\u4f60\u7ffb\u500d\u5f97\u5206\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u5f9e\u8df3\u8e8d\u958b\u59cb\uff0c\u6536\u96c6\u786c\u5e63\uff0c\u885d\u904e\u6575\u4eba\uff0c\u4e26\u5b89\u5168\u8457\u9678\u4ee5\u7dad\u6301\u9023\u64ca\u3002]"}, {"question": "\u300e\u70e4\u9eb5\u5305\u6a5f\u885d\u523a\u300f\u904a\u6232\u4e2d\u7684\u6a19\u6e96\u6a21\u5f0f\u548c\u786c\u6838\u6a21\u5f0f\u6709\u4ec0\u9ebc\u5340\u5225\uff1f", "answer": "\u300e\u70e4\u9eb5\u5305\u6a5f\u885d\u523a\u300f\u904a\u6232\u4e2d\u7684\u6a19\u6e96\u6a21\u5f0f\u548c\u786c\u6838\u6a21\u5f0f\u5728\u96e3\u5ea6\u548c\u904a\u6232\u6a5f\u5236\u4e0a\u6709\u986f\u8457\u5dee\u7570\u3002\u5728\u786c\u6838\u6a21\u5f0f\u4e2d\uff0c\u969c\u7919\u7269\u79fb\u52d5\u66f4\u5feb\uff0c\u4e26\u4e14\u6aa2\u67e5\u9ede\u66f4\u5c11\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u5341\u95dc\uff0c\u70e4\u9eb5\u5305\u6a5f\u5728\u786c\u6838\u6a21\u5f0f\u4e0b\u79fb\u52d5\u901f\u5ea6\u7ffb\u500d\u3002\u6b64\u5916\uff0c\u786c\u6838\u6a21\u5f0f\u5f15\u5165\u4e86\u65b0\u7684\u6575\u4eba\u985e\u578b\uff0c\u9700\u8981\u66f4\u5148\u9032\u7684\u7b56\u7565\u4f86\u907f\u514d\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u6a19\u6e96\u6a21\u5f0f\u9069\u5408\u8f15\u9b06\u904a\u73a9\uff0c\u800c\u786c\u6838\u6a21\u5f0f\u5247\u6311\u6230\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u3002]"}, {"question": "\u300e\u70e4\u9eb5\u5305\u6a5f\u885d\u523a\u300f\u904a\u6232\u7684\u8a08\u5206\u7cfb\u7d71\u5982\u4f55\u8a08\u7b97\u6700\u7d42\u95dc\u5361\u5f97\u5206\uff1f", "answer": "\u300e\u70e4\u9eb5\u5305\u6a5f\u885d\u523a\u300f\u904a\u6232\u7684\u8a08\u5206\u7cfb\u7d71\u7d50\u5408\u4e86\u591a\u500b\u56e0\u7d20\uff1a\u6536\u96c6\u7684\u786c\u5e63\u3001\u9023\u64ca\u500d\u6578\u548c\u5269\u9918\u6642\u9593\u3002\u6bcf\u679a\u786c\u5e63\u90fd\u6703\u589e\u52a0\u4f60\u7684\u57fa\u672c\u5206\u6578\uff0c\u800c\u9023\u64ca\u6703\u5c07\u5176\u500d\u589e\u3002\u5269\u9918\u6642\u9593\u6703\u8f49\u63db\u6210\u734e\u52f5\u5206\u6578\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u56db\u95dc\uff0c\u6536\u96c6\u6240\u6709\u786c\u5e63\u4e26\u7372\u5f97 2 \u500d\u9023\u64ca\u734e\u52f5\uff0c\u4e26\u5728\u5269\u9918 10 \u79d2\u6642\u5b8c\u6210\u95dc\u5361\uff0c\u53ef\u4ee5\u7372\u5f97\u9ad8\u5206\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u786c\u5e63\u50f9\u503c\u70ba 10 \u5206\uff0c\u9023\u64ca\u500d\u6578\u5f9e 1 \u500d\u5230 5 \u500d\u4e0d\u7b49\uff0c\u6642\u9593\u734e\u52f5\u70ba\u6bcf\u79d2 1 \u5206\u3002]"}, {"question": "\u6211\u53ef\u4ee5\u5c07\u6211\u7684\u300e\u70e4\u9eb5\u5305\u6a5f\u885d\u523a\u300f\u904a\u6232\u9032\u5ea6\u5f9e\u96fb\u8166\u8f49\u79fb\u5230\u624b\u6a5f\u55ce\uff1f", "answer": "\u662f\u7684\uff0c\u4f60\u53ef\u4ee5\u5c07\u4f60\u7684\u300e\u70e4\u9eb5\u5305\u6a5f\u885d\u523a\u300f\u904a\u6232\u9032\u5ea6\u5f9e\u96fb\u8166\u8f49\u79fb\u5230\u624b\u6a5f\uff0c\u65b9\u6cd5\u662f\u9023\u7d50\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u3002\u6b65\u9a5f1\uff1a\u5728\u5169\u53f0\u88dd\u7f6e\u4e0a\u767b\u5165\u4f60\u7684\u5e33\u6236\u3002\u6b65\u9a5f2\uff1a\u5728\u8a2d\u5b9a\u9078\u55ae\u4e2d\u555f\u7528\u96f2\u7aef\u5132\u5b58\u3002\u6b65\u9a5f3\uff1a\u540c\u6b65\u4f60\u7684\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u96fb\u8166\u4e0a\u5b8c\u6210\u4e86\u7b2c\u516d\u95dc\uff0c\u540c\u6b65\u5f8c\u5b83\u5c07\u6703\u5728\u624b\u6a5f\u4e0a\u89e3\u9396\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4e00\u4e0b\uff0c\u96f2\u7aef\u5132\u5b58\u5c31\u50cf\u4e00\u500b\u80cc\u5305\uff0c\u53ef\u4ee5\u5c07\u4f60\u7684\u9032\u5ea6\u5e36\u5230\u4efb\u4f55\u5730\u65b9\u3002]"}, {"question": "\u6211\u5728\u300e\u70e4\u9eb5\u5305\u6a5f\u885d\u523a\u300f\u904a\u6232\u4e2d\u53ef\u4ee5\u627e\u5230\u54ea\u4e9b\u96b1\u85cf\u5f69\u86cb\uff0c\u5b83\u5011\u4f4d\u65bc\u54ea\u88e1\uff1f", "answer": "\u300e\u70e4\u9eb5\u5305\u6a5f\u885d\u523a\u300f\u904a\u6232\u4e2d\u5145\u6eff\u4e86\u96b1\u85cf\u5f69\u86cb\uff0c\u734e\u52f5\u63a2\u7d22\u3002\u4e00\u500b\u986f\u8457\u7684\u5f69\u86cb\u662f\u7b2c\u516b\u95dc\u96b1\u85cf\u7684\u300e\u9ec3\u91d1\u70e4\u9eb5\u5305\u6a5f\u300f\u3002\u8981\u627e\u5230\u5b83\uff0c\u4f60\u9700\u8981\u5728\u96b1\u85cf\u5340\u57df\u57f7\u884c\u7279\u5b9a\u9806\u5e8f\u7684\u8df3\u8e8d\u548c\u885d\u523a\u3002\u767c\u73fe\u9019\u4e9b\u5f69\u86cb\u901a\u5e38\u6703\u89e3\u9396\u7279\u6b8a\u6210\u5c31\u6216\u984d\u5916\u5167\u5bb9\u3002[\u5f69\u86cb\u6316\u6398\uff1a\u9ec3\u91d1\u70e4\u9eb5\u5305\u6a5f\u662f\u5bf9\u7d93\u5178\u5e73\u53f0\u904a\u6232\u7684\u81f4\u656c\uff0c\u5c0d\u71b1\u8877\u73a9\u5bb6\u4f86\u8aaa\u662f\u4e00\u500b\u6709\u8da3\u7684\u6311\u6230\u3002]"}, {"question": "\u5728\u300e\u70e4\u9eb5\u5305\u6a5f\u885d\u523a\u300f\u904a\u6232\u4e2d\uff0c\u54ea\u4e9b\u589e\u76ca\u9053\u5177\u6700\u6709\u6548\u5730\u5e6b\u52a9\u4f60\u5728\u56f0\u96e3\u95dc\u5361\u4e2d\u751f\u5b58\uff1f", "answer": "\u67d0\u4e9b\u589e\u76ca\u9053\u5177\u5c0d\u65bc\u5728\u300e\u70e4\u9eb5\u5305\u6a5f\u885d\u523a\u300f\u904a\u6232\u4e2d\u7684\u56f0\u96e3\u95dc\u5361\u81f3\u95dc\u91cd\u8981\u3002\u300c\u9632\u79a6\u76fe\u724c\u300d\u589e\u76ca\u9053\u5177\u53ef\u4ee5\u4fdd\u8b77\u4f60\u514d\u53d7\u4e00\u6b21\u653b\u64ca\uff0c\u800c\u300c\u901f\u5ea6\u52a0\u6210\u300d\u589e\u76ca\u9053\u5177\u5247\u6709\u52a9\u65bc\u4f60\u8d85\u8d8a\u5feb\u901f\u79fb\u52d5\u7684\u969c\u7919\u7269\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e5d\u95dc\uff0c\u9632\u79a6\u76fe\u724c\u53ef\u4ee5\u8b93\u4f60\u514d\u53d7\u610f\u5916\u7684\u70e4\u9eb5\u5305\u6a5f\u653b\u64ca\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u9632\u79a6\u76fe\u724c\u6700\u9069\u5408\u65b0\u624b\uff0c\u800c\u901f\u5ea6\u52a0\u6210\u6700\u53d7\u901f\u901a\u73a9\u5bb6\u9752\u775e\u3002]"}, {"question": "\u5982\u4f55\u5728\u300e\u70e4\u9eb5\u5305\u6a5f\u885d\u523a\u300f\u904a\u6232\u4e2d\u89e3\u9396\u79d8\u5bc6\u89d2\u8272\uff0c\u4ee5\u53ca\u5176\u7368\u7279\u7684\u6280\u80fd\u662f\u4ec0\u9ebc\uff1f", "answer": "\u8981\u89e3\u9396\u300e\u70e4\u9eb5\u5305\u6a5f\u885d\u523a\u300f\u904a\u6232\u4e2d\u7684\u79d8\u5bc6\u89d2\u8272\uff0c\u4f60\u9700\u8981\u4ee5\u5b8c\u7f8e\u7684\u6210\u7e3e\u5b8c\u6210\u6240\u6709\u95dc\u5361\u3002\u79d8\u5bc6\u89d2\u8272\u300c\u5410\u53f8\u5927\u5e2b\u300d\u64c1\u6709\u7368\u7279\u7684\u6280\u80fd\uff0c\u4f8b\u5982\u96d9\u91cd\u8df3\u8e8d\u548c\u5ef6\u9577\u885d\u523a\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u5341\u4e8c\u95dc\uff0c\u96d9\u91cd\u8df3\u8e8d\u5141\u8a31\u4f60\u5230\u9054\u5176\u4ed6\u7121\u6cd5\u5230\u9054\u7684\u5e73\u53f0\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4e00\u4e0b\uff0c\u5410\u53f8\u5927\u5e2b\u5c31\u50cf\u4e00\u500b\u64c1\u6709\u589e\u5f37\u79fb\u52d5\u6027\u548c\u654f\u6377\u6027\u7684\u8d85\u7d1a\u82f1\u96c4\u3002]"}]
[{"question": "\u5982\u4f55\u5728\u300a\u70e4\u9762\u5305\u673a\u51b2\u523a\u300b\u4e2d\u6267\u884c\u8df3\u8dc3\u548c\u51b2\u523a\u7b49\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u5728\u300a\u70e4\u9762\u5305\u673a\u51b2\u523a\u300b\u4e2d\uff0c\u57fa\u672c\u64cd\u4f5c\u7b80\u5355\u800c\u81f3\u5173\u91cd\u8981\u3002\u8981\u8df3\u8dc3\uff0c\u8bf7\u6309\u7a7a\u683c\u952e\u6216\u63a7\u5236\u5668\u4e0a\u7684'A'\u952e\u3002\u8981\u51b2\u523a\uff0c\u8bf7\u6309'Shift'\u952e\u6216\u63a7\u5236\u5668\u4e0a\u7684'B'\u952e\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u5173\uff0c\u4f60\u9700\u8981\u8df3\u8fc7\u70e4\u9762\u5305\u673a\uff0c\u7136\u540e\u51b2\u523a\u7a7f\u8fc7\u72ed\u7a84\u7684\u7f1d\u9699\u3002\u8fd9\u4e9b\u52a8\u4f5c\u662f\u6e38\u620f\u73a9\u5bb6\u5728\u6e38\u620f\u4e2d\u7a7f\u68ad\u3001\u8fc7\u5173\u7684\u6839\u672c\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u8df3\u8dc3\u60f3\u8c61\u4e3a\u8df3\u8fc7\u4e00\u4e2a\u5c0f\u6805\u680f\uff0c\u800c\u5c06\u51b2\u523a\u60f3\u8c61\u4e3a\u5728\u72ed\u7a84\u7684\u5df7\u5b50\u91cc\u5954\u8dd1\u3002]"}, {"question": "\u5728\u300a\u70e4\u9762\u5305\u673a\u51b2\u523a\u300b\u7684\u5355\u7ea7\u6e38\u620f\u4e2d\uff0c\u6536\u96c6\u6240\u6709\u786c\u5e01\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300a\u70e4\u9762\u5305\u673a\u51b2\u523a\u300b\u4e2d\u6536\u96c6\u6240\u6709\u786c\u5e01\u9700\u8981\u7cbe\u786e\u6027\u548c\u8ba1\u5212\u6027\u3002\u6b65\u9aa41\uff1a\u7814\u7a76\u5173\u5361\u5e03\u5c40\uff0c\u786e\u5b9a\u786c\u5e01\u4f4d\u7f6e\u3002\u6b65\u9aa42\uff1a\u5229\u7528\u8df3\u8dc3\u548c\u51b2\u523a\u5230\u8fbe\u9ad8\u5904\u6216\u9690\u85cf\u533a\u57df\u3002\u6b65\u9aa43\uff1a\u5728\u6536\u96c6\u786c\u5e01\u7684\u540c\u65f6\u8c03\u6574\u4f60\u7684\u52a8\u4f5c\u4ee5\u907f\u5f00\u969c\u788d\u7269\u3002\u4f8b\u5982\uff0c\u5728\u7b2c3\u5173\uff0c\u786c\u5e01\u5206\u6563\u5728\u9700\u8981\u7cbe\u786e\u8df3\u8dc3\u7684\u5e73\u53f0\u4e0a\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u4e00\u4e9b\u73a9\u5bb6\u559c\u6b22\u5728\u7b2c\u4e00\u6b21\u8fd0\u884c\u65f6\u6536\u96c6\u786c\u5e01\uff0c\u800c\u53e6\u4e00\u4e9b\u73a9\u5bb6\u5219\u5728\u638c\u63e1\u4e86\u6e38\u620f\u673a\u5236\u540e\u91cd\u73a9\u5173\u5361\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u7684\u89d2\u8272\u6709\u65f6\u5728\u300a\u70e4\u9762\u5305\u673a\u51b2\u523a\u300b\u4e2d\u51b2\u523a\u65f6\u4f1a\u5361\u4f4f\uff1f", "answer": "\u5728\u300a\u70e4\u9762\u5305\u673a\u51b2\u523a\u300b\u4e2d\u51b2\u523a\u65f6\u5361\u4f4f\u901a\u5e38\u662f\u7531\u4e8e\u78b0\u649e\u68c0\u6d4b\u95ee\u9898\u3002\u5982\u679c\u65f6\u95f4\u4e0d\u5bf9\uff0c\u6e38\u620f\u7684\u7269\u7406\u5f15\u64ce\u53ef\u80fd\u4f1a\u5c06\u51b2\u523a\u89e3\u91ca\u4e3a\u4e0e\u969c\u788d\u7269\u53d1\u751f\u78b0\u649e\u3002\u4f8b\u5982\uff0c\u5728\u7b2c5\u5173\uff0c\u8fc7\u65e9\u5730\u51b2\u523a\u649e\u5230\u5899\u4e0a\u4f1a\u5bfc\u81f4\u89d2\u8272\u5361\u4f4f\u3002\u4e3a\u4e86\u907f\u514d\u8fd9\u79cd\u60c5\u51b5\uff0c\u8bf7\u786e\u4fdd\u5728\u6b63\u786e\u7684\u65f6\u95f4\u548c\u89d2\u5ea6\u51b2\u523a\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u952e\u76d8\u548c\u63a7\u5236\u5668\u7684\u51b2\u523a\u65f6\u95f4\u53ef\u80fd\u7565\u6709\u4e0d\u540c\uff0c\u56e0\u6b64\u8bf7\u7ec3\u4e60\u4f7f\u7528\u4f60\u559c\u6b22\u7684\u8f93\u5165\u65b9\u6cd5\u3002]"}, {"question": "\u5982\u4f55\u901a\u8fc7\u4f7f\u7528\u7ec4\u5408\u500d\u589e\u5668\u4f18\u5316\u300a\u70e4\u9762\u5305\u673a\u51b2\u523a\u300b\u4e2d\u7684\u5f97\u5206\uff1f", "answer": "\u8981\u5728\u300a\u70e4\u9762\u5305\u673a\u51b2\u523a\u300b\u4e2d\u6700\u5927\u5316\u5f97\u5206\uff0c\u8bf7\u4e13\u6ce8\u4e8e\u8fde\u9501\u52a8\u4f5c\u4ee5\u6784\u5efa\u7ec4\u5408\u500d\u589e\u5668\u3002\u6b65\u9aa41\uff1a\u5728\u4e0d\u63a5\u89e6\u5730\u9762\u7684\u60c5\u51b5\u4e0b\u8fde\u7eed\u6267\u884c\u8df3\u8dc3\u548c\u51b2\u523a\u3002\u6b65\u9aa42\uff1a\u5728\u7ec4\u5408\u8fc7\u7a0b\u4e2d\u6536\u96c6\u786c\u5e01\u548c\u9053\u5177\u3002\u6b65\u9aa43\uff1a\u5feb\u901f\u5b8c\u6210\u5173\u5361\u4ee5\u589e\u52a0\u65f6\u95f4\u5956\u52b1\u3002\u4f8b\u5982\uff0c\u5728\u7b2c7\u5173\uff0c\u4e00\u4e2a\u65f6\u673a\u826f\u597d\u7684\u7ec4\u5408\u53ef\u4ee5\u4f7f\u4f60\u7684\u5f97\u5206\u7ffb\u500d\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u4ece\u8df3\u8dc3\u5f00\u59cb\uff0c\u6536\u96c6\u786c\u5e01\uff0c\u51b2\u523a\u7a7f\u8fc7\u654c\u4eba\uff0c\u5e76\u5b89\u5168\u7740\u9646\u4ee5\u4fdd\u6301\u7ec4\u5408\u3002]"}, {"question": "\u300a\u70e4\u9762\u5305\u673a\u51b2\u523a\u300b\u4e2d\u7684\u6807\u51c6\u6a21\u5f0f\u548c\u786c\u6838\u6a21\u5f0f\u6709\u4ec0\u4e48\u533a\u522b\uff1f", "answer": "\u300a\u70e4\u9762\u5305\u673a\u51b2\u523a\u300b\u4e2d\u7684\u6807\u51c6\u6a21\u5f0f\u548c\u786c\u6838\u6a21\u5f0f\u5728\u96be\u5ea6\u548c\u673a\u5236\u4e0a\u5b58\u5728\u663e\u8457\u5dee\u5f02\u3002\u5728\u786c\u6838\u6a21\u5f0f\u4e0b\uff0c\u969c\u788d\u7269\u79fb\u52a8\u901f\u5ea6\u66f4\u5feb\uff0c\u68c0\u67e5\u70b9\u66f4\u5c11\u3002\u4f8b\u5982\uff0c\u5728\u7b2c10\u5173\uff0c\u786c\u6838\u6a21\u5f0f\u4e0b\u70e4\u9762\u5305\u673a\u7684\u79fb\u52a8\u901f\u5ea6\u662f\u6807\u51c6\u6a21\u5f0f\u7684\u4e24\u500d\u3002\u6b64\u5916\uff0c\u786c\u6838\u6a21\u5f0f\u5f15\u5165\u4e86\u65b0\u7684\u654c\u4eba\u7c7b\u578b\uff0c\u9700\u8981\u66f4\u9ad8\u7ea7\u7684\u7b56\u7565\u624d\u80fd\u907f\u514d\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6807\u51c6\u6a21\u5f0f\u975e\u5e38\u9002\u5408\u4f11\u95f2\u5a31\u4e50\uff0c\u800c\u786c\u6838\u6a21\u5f0f\u5219\u6311\u6218\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u3002]"}, {"question": "\u300a\u70e4\u9762\u5305\u673a\u51b2\u523a\u300b\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u5982\u4f55\u8ba1\u7b97\u6700\u7ec8\u5173\u5361\u5f97\u5206\uff1f", "answer": "\u300a\u70e4\u9762\u5305\u673a\u51b2\u523a\u300b\u7684\u8bc4\u5206\u7cfb\u7edf\u7ed3\u5408\u4e86\u51e0\u4e2a\u56e0\u7d20\uff1a\u6536\u96c6\u7684\u786c\u5e01\u3001\u7ec4\u5408\u500d\u589e\u5668\u548c\u5269\u4f59\u65f6\u95f4\u3002\u6bcf\u679a\u786c\u5e01\u90fd\u4f1a\u589e\u52a0\u4f60\u7684\u57fa\u7840\u5f97\u5206\uff0c\u800c\u7ec4\u5408\u4f1a\u5c06\u5176\u4e58\u4ee5\u3002\u5269\u4f59\u65f6\u95f4\u4f1a\u8f6c\u6362\u6210\u5956\u52b1\u5206\u6570\u3002\u4f8b\u5982\uff0c\u5728\u7b2c4\u5173\uff0c\u6536\u96c6\u6240\u6709\u786c\u5e01\uff0c\u4f7f\u75282\u500d\u7ec4\u5408\uff0c\u5e76\u5269\u4f5910\u79d2\u7684\u65f6\u95f4\uff0c\u53ef\u4ee5\u83b7\u5f97\u9ad8\u5206\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u786c\u5e01\u4ef7\u503c\u4e3a10\u5206\uff0c\u7ec4\u5408\u500d\u589e\u5668\u8303\u56f4\u4e3a1\u500d\u81f35\u500d\uff0c\u65f6\u95f4\u5956\u52b1\u4e3a\u6bcf\u79d21\u5206\u3002]"}, {"question": "\u6211\u53ef\u4ee5\u5728PC\u548c\u624b\u673a\u4e4b\u95f4\u4f20\u8f93\u300a\u70e4\u9762\u5305\u673a\u51b2\u523a\u300b\u7684\u6e38\u620f\u8fdb\u5ea6\u5417\uff1f", "answer": "\u662f\u7684\uff0c\u4f60\u53ef\u4ee5\u901a\u8fc7\u5c06\u4f60\u7684\u5e10\u6237\u94fe\u63a5\u5230\u4e91\u4fdd\u5b58\u529f\u80fd\u6765\u5728PC\u548c\u624b\u673a\u4e4b\u95f4\u4f20\u8f93\u300a\u70e4\u9762\u5305\u673a\u51b2\u523a\u300b\u7684\u6e38\u620f\u8fdb\u5ea6\u3002\u6b65\u9aa41\uff1a\u767b\u5f55\u4f60\u5728\u8fd9\u4e24\u4e2a\u8bbe\u5907\u4e0a\u7684\u5e10\u6237\u3002\u6b65\u9aa42\uff1a\u5728\u8bbe\u7f6e\u83dc\u5355\u4e2d\u542f\u7528\u4e91\u4fdd\u5b58\u3002\u6b65\u9aa43\uff1a\u540c\u6b65\u4f60\u7684\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728PC\u4e0a\u5b8c\u6210\u4e86\u7b2c6\u5173\uff0c\u540c\u6b65\u540e\u5b83\u5c06\u5728\u624b\u673a\u4e0a\u89e3\u9501\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u4e91\u4fdd\u5b58\u60f3\u8c61\u6210\u4e00\u4e2a\u80cc\u5305\uff0c\u53ef\u4ee5\u5c06\u4f60\u7684\u8fdb\u5ea6\u5e26\u5230\u4efb\u4f55\u5730\u65b9\u3002]"}, {"question": "\u6211\u5728\u300a\u70e4\u9762\u5305\u673a\u51b2\u523a\u300b\u4e2d\u53ef\u4ee5\u627e\u5230\u54ea\u4e9b\u9690\u85cf\u7684\u5f69\u86cb\uff0c\u5b83\u4eec\u5728\u54ea\u91cc\uff1f", "answer": "\u300a\u70e4\u9762\u5305\u673a\u51b2\u523a\u300b\u4e2d\u5145\u6ee1\u4e86\u9690\u85cf\u7684\u5f69\u86cb\uff0c\u5956\u52b1\u63a2\u7d22\u3002\u4e00\u4e2a\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\u7b2c8\u5173\u9690\u85cf\u7684\u300e\u9ec4\u91d1\u70e4\u9762\u5305\u673a\u300f\u3002\u8981\u627e\u5230\u5b83\uff0c\u4f60\u9700\u8981\u5728\u9690\u85cf\u533a\u57df\u6267\u884c\u7279\u5b9a\u987a\u5e8f\u7684\u8df3\u8dc3\u548c\u51b2\u523a\u3002\u53d1\u73b0\u8fd9\u4e9b\u5f69\u86cb\u901a\u5e38\u4f1a\u89e3\u9501\u7279\u6b8a\u6210\u5c31\u6216\u989d\u5916\u5185\u5bb9\u3002[\u5f69\u86cb\u6316\u6398\uff1a\u9ec4\u91d1\u70e4\u9762\u5305\u673a\u662f\u5bf9\u7ecf\u5178\u5e73\u53f0\u6e38\u620f\u7684\u4e00\u79cd\u81f4\u656c\uff0c\u5bf9\u4e8e\u70ed\u8877\u7684\u73a9\u5bb6\u6765\u8bf4\u662f\u4e00\u4e2a\u6709\u8da3\u7684\u6311\u6218\u3002]"}, {"question": "\u5728\u300a\u70e4\u9762\u5305\u673a\u51b2\u523a\u300b\u4e2d\uff0c\u54ea\u4e9b\u9053\u5177\u6700\u6709\u6548\u5730\u5e2e\u52a9\u73a9\u5bb6\u5728\u56f0\u96be\u5173\u5361\u4e2d\u751f\u5b58\uff1f", "answer": "\u67d0\u4e9b\u9053\u5177\u5bf9\u4e8e\u5728\u300a\u70e4\u9762\u5305\u673a\u51b2\u523a\u300b\u7684\u56f0\u96be\u5173\u5361\u4e2d\u751f\u5b58\u81f3\u5173\u91cd\u8981\u3002\u2018\u62a4\u76fe\u2019\u9053\u5177\u53ef\u4ee5\u4fdd\u62a4\u4f60\u514d\u53d7\u4e00\u6b21\u653b\u51fb\uff0c\u800c\u2018\u52a0\u901f\u2019\u9053\u5177\u5219\u6709\u52a9\u4e8e\u4f60\u8eb2\u907f\u9ad8\u901f\u79fb\u52a8\u7684\u969c\u788d\u7269\u3002\u4f8b\u5982\uff0c\u5728\u7b2c9\u5173\uff0c\u62a4\u76fe\u53ef\u4ee5\u6551\u4f60\u4e8e\u610f\u5916\u7684\u70e4\u9762\u5305\u673a\u653b\u51fb\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u62a4\u76fe\u6700\u9002\u5408\u65b0\u624b\uff0c\u800c\u52a0\u901f\u5219\u66f4\u53d7\u901f\u5ea6\u8dd1\u8005\u9752\u7750\u3002]"}, {"question": "\u5982\u4f55\u89e3\u9501\u300a\u70e4\u9762\u5305\u673a\u51b2\u523a\u300b\u4e2d\u7684\u79d8\u5bc6\u89d2\u8272\uff0c\u4ee5\u53ca\u5176\u72ec\u7279\u7684\u6280\u80fd\u662f\u4ec0\u4e48\uff1f", "answer": "\u8981\u89e3\u9501\u300a\u70e4\u9762\u5305\u673a\u51b2\u523a\u300b\u4e2d\u7684\u79d8\u5bc6\u89d2\u8272\uff0c\u4f60\u9700\u8981\u4ee5\u5b8c\u7f8e\u7684\u5206\u6570\u5b8c\u6210\u6240\u6709\u5173\u5361\u3002\u79d8\u5bc6\u89d2\u8272\u300e\u70e4\u9762\u5305\u5927\u5e08\u300f\u62e5\u6709\u72ec\u7279\u7684\u6280\u80fd\uff0c\u4f8b\u5982\u53cc\u8df3\u548c\u5ef6\u957f\u51b2\u523a\u3002\u4f8b\u5982\uff0c\u5728\u7b2c12\u5173\uff0c\u53cc\u8df3\u53ef\u4ee5\u8ba9\u73a9\u5bb6\u5230\u8fbe\u5426\u5219\u65e0\u6cd5\u5230\u8fbe\u7684\u5e73\u53f0\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u70e4\u9762\u5305\u5927\u5e08\u60f3\u8c61\u6210\u4e00\u4e2a\u62e5\u6709\u589e\u5f3a\u79fb\u52a8\u6027\u548c\u7075\u6d3b\u6027\u80fd\u529b\u7684\u8d85\u7ea7\u82f1\u96c4\u3002]"}]
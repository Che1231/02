[{"question": "\u30c8\u30fc\u30b9\u30bf\u30fc\u30c0\u30c3\u30b7\u30e5\u3067\u30b8\u30e3\u30f3\u30d7\u3084\u30c0\u30c3\u30b7\u30e5\u306a\u3069\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u306f\u3069\u306e\u3088\u3046\u306b\u5b9f\u884c\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30c8\u30fc\u30b9\u30bf\u30fc\u30c0\u30c3\u30b7\u30e5\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u306f\u30b7\u30f3\u30d7\u30eb\u3067\u3042\u308a\u306a\u304c\u3089\u91cd\u8981\u3067\u3059\u3002\u30b8\u30e3\u30f3\u30d7\u3059\u308b\u306b\u306f\u3001'\u30b9\u30da\u30fc\u30b9'\u30ad\u30fc\u307e\u305f\u306f\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u306e'A'\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u307e\u3059\u3002\u30c0\u30c3\u30b7\u30e5\u3059\u308b\u306b\u306f\u3001'Shift'\u30ad\u30fc\u307e\u305f\u306f'B'\u30dc\u30bf\u30f3\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30c8\u30fc\u30b9\u30bf\u30fc\u3092\u30b8\u30e3\u30f3\u30d7\u3057\u3066\u3001\u72ed\u3044\u9699\u9593\u3092\u30c0\u30c3\u30b7\u30e5\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u64cd\u4f5c\u306f\u3001\u30b2\u30fc\u30e0\u306e\u969c\u5bb3\u7269\u3092\u56de\u907f\u3057\u3001\u30ec\u30d9\u30eb\u3092\u9032\u3081\u308b\u305f\u3081\u306e\u57fa\u790e\u3068\u306a\u308a\u307e\u3059\u3002[\u4f8b\uff1a\u30b8\u30e3\u30f3\u30d7\u306f\u5c0f\u3055\u306a\u67f5\u3092\u98db\u3073\u8d8a\u3048\u308b\u3053\u3068\u3001\u30c0\u30c3\u30b7\u30e5\u306f\u72ed\u3044\u8def\u5730\u3092\u99c6\u3051\u629c\u3051\u308b\u3053\u3068\u3068\u60f3\u50cf\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30c8\u30fc\u30b9\u30bf\u30fc\u30c0\u30c3\u30b7\u30e5\u306e\u5358\u4e00\u30ec\u30d9\u30eb\u3067\u3059\u3079\u3066\u306e\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30c8\u30fc\u30b9\u30bf\u30fc\u30c0\u30c3\u30b7\u30e5\u3067\u3059\u3079\u3066\u306e\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u308b\u306b\u306f\u3001\u6b63\u78ba\u3055\u3068\u8a08\u753b\u306e\u4e21\u65b9\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b3\u30a4\u30f3\u306e\u4f4d\u7f6e\u3092\u7279\u5b9a\u3059\u308b\u305f\u3081\u306b\u3001\u30ec\u30d9\u30eb\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u7814\u7a76\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b8\u30e3\u30f3\u30d7\u3084\u30c0\u30c3\u30b7\u30e5\u3092\u4f7f\u7528\u3057\u3066\u3001\u9ad8\u3044\u5834\u6240\u3084\u96a0\u308c\u305f\u5834\u6240\u306e\u30b3\u30a4\u30f3\u306b\u5230\u9054\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u306a\u304c\u3089\u969c\u5bb3\u7269\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u3001\u64cd\u4f5c\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5408\u308f\u305b\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb3\u3067\u306f\u3001\u6b63\u78ba\u306a\u30b8\u30e3\u30f3\u30d7\u304c\u5fc5\u8981\u306a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u30b3\u30a4\u30f3\u304c\u6563\u3089\u3070\u3063\u3066\u3044\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u4e00\u90e8\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u6700\u521d\u306e\u30d7\u30ec\u30a4\u3067\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u308b\u3053\u3068\u3092\u597d\u307f\u307e\u3059\u304c\u3001\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u30de\u30b9\u30bf\u30fc\u3057\u305f\u5f8c\u306b\u30ec\u30d9\u30eb\u3092\u7e70\u308a\u8fd4\u3057\u30d7\u30ec\u30a4\u3057\u307e\u3059\u3002]"}, {"question": "\u30c8\u30fc\u30b9\u30bf\u30fc\u30c0\u30c3\u30b7\u30e5\u3067\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u30c0\u30c3\u30b7\u30e5\u4e2d\u306b\u6642\u3005\u30b9\u30bf\u30c3\u30af\u3059\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u30c8\u30fc\u30b9\u30bf\u30fc\u30c0\u30c3\u30b7\u30e5\u3067\u30c0\u30c3\u30b7\u30e5\u4e2d\u306b\u30b9\u30bf\u30c3\u30af\u3059\u308b\u73fe\u8c61\u306f\u3001\u591a\u304f\u306e\u5834\u5408\u3001\u885d\u7a81\u691c\u77e5\u306e\u554f\u984c\u306b\u3088\u308b\u3082\u306e\u3067\u3059\u3002\u30b2\u30fc\u30e0\u306e\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u306f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u305a\u308c\u3066\u3044\u308b\u5834\u5408\u3001\u30c0\u30c3\u30b7\u30e5\u304c\u969c\u5bb3\u7269\u3068\u885d\u7a81\u3057\u3066\u3044\u308b\u3068\u89e3\u91c8\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb5\u3067\u3001\u58c1\u306b\u65e9\u3059\u304e\u308b\u30c0\u30c3\u30b7\u30e5\u306f\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u30b9\u30bf\u30c3\u30af\u3059\u308b\u539f\u56e0\u3068\u306a\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3092\u9632\u3050\u305f\u3081\u306b\u3001\u9069\u5207\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u89d2\u5ea6\u3067\u30c0\u30c3\u30b7\u30e5\u3059\u308b\u3088\u3046\u306b\u3057\u307e\u3057\u3087\u3046\u3002[\u8a2d\u5b9a\u6bd4\u8f03\uff1a\u30ad\u30fc\u30dc\u30fc\u30c9\u3068\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u306e\u30c0\u30c3\u30b7\u30e5\u30bf\u30a4\u30df\u30f3\u30b0\u306b\u306f\u308f\u305a\u304b\u306a\u9055\u3044\u304c\u3042\u308b\u305f\u3081\u3001\u4f7f\u7528\u3057\u3066\u3044\u308b\u5165\u529b\u65b9\u6cd5\u3067\u7df4\u7fd2\u3057\u307e\u3057\u3087\u3046\u3002]"}, {"question": "\u30b3\u30f3\u30dc\u500d\u7387\u3092\u4f7f\u7528\u3057\u3066\u30c8\u30fc\u30b9\u30bf\u30fc\u30c0\u30c3\u30b7\u30e5\u3067\u30b9\u30b3\u30a2\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30c8\u30fc\u30b9\u30bf\u30fc\u30c0\u30c3\u30b7\u30e5\u3067\u30b9\u30b3\u30a2\u3092\u6700\u5927\u9650\u306b\u9ad8\u3081\u308b\u306b\u306f\u3001\u30b3\u30f3\u30dc\u500d\u7387\u3092\u69cb\u7bc9\u3059\u308b\u305f\u3081\u306b\u3001\u4e00\u9023\u306e\u884c\u52d5\u3092\u7e4b\u3052\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5730\u9762\u306b\u89e6\u308c\u305a\u306b\u9023\u7d9a\u3057\u3066\u30b8\u30e3\u30f3\u30d7\u3068\u30c0\u30c3\u30b7\u30e5\u3092\u5b9f\u884c\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b3\u30f3\u30dc\u4e2d\u306b\u30b3\u30a4\u30f3\u3084\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u96c6\u3081\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u8fc5\u901f\u306b\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3057\u3001\u6642\u9593\u30dc\u30fc\u30ca\u30b9\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb7\u3067\u306f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u306e\u826f\u3044\u30b3\u30f3\u30dc\u306f\u30b9\u30b3\u30a2\u30922\u500d\u306b\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30b8\u30e3\u30f3\u30d7\u304b\u3089\u59cb\u307e\u308a\u3001\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u3001\u6575\u3092\u30c0\u30c3\u30b7\u30e5\u3067\u907f\u3051\u3066\u5b89\u5168\u306b\u7740\u5730\u3057\u3001\u30b3\u30f3\u30dc\u3092\u7dad\u6301\u3057\u307e\u3059\u3002]"}, {"question": "\u30c8\u30fc\u30b9\u30bf\u30fc\u30c0\u30c3\u30b7\u30e5\u306e\u6a19\u6e96\u30e2\u30fc\u30c9\u3068\u30cf\u30fc\u30c9\u30b3\u30a2\u30e2\u30fc\u30c9\u306e\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30c8\u30fc\u30b9\u30bf\u30fc\u30c0\u30c3\u30b7\u30e5\u306e\u6a19\u6e96\u30e2\u30fc\u30c9\u3068\u30cf\u30fc\u30c9\u30b3\u30a2\u30e2\u30fc\u30c9\u306f\u3001\u96e3\u6613\u5ea6\u3068\u30e1\u30ab\u30cb\u30ba\u30e0\u304c\u5927\u304d\u304f\u7570\u306a\u308a\u307e\u3059\u3002\u30cf\u30fc\u30c9\u30b3\u30a2\u30e2\u30fc\u30c9\u3067\u306f\u3001\u969c\u5bb3\u7269\u304c\u901f\u304f\u306a\u308a\u3001\u30c1\u30a7\u30c3\u30af\u30dd\u30a4\u30f3\u30c8\u306f\u5c11\u306a\u304f\u306a\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb10\u3067\u306f\u3001\u30c8\u30fc\u30b9\u30bf\u30fc\u306f\u30cf\u30fc\u30c9\u30b3\u30a2\u30e2\u30fc\u30c9\u30672\u500d\u306e\u901f\u5ea6\u3067\u79fb\u52d5\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30cf\u30fc\u30c9\u30b3\u30a2\u30e2\u30fc\u30c9\u3067\u306f\u3001\u56de\u907f\u3059\u308b\u305f\u3081\u306b\u9ad8\u5ea6\u306a\u6226\u7565\u304c\u5fc5\u8981\u306a\u3001\u65b0\u3057\u3044\u6575\u306e\u7a2e\u985e\u3082\u767b\u5834\u3057\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u6a19\u6e96\u30e2\u30fc\u30c9\u306f\u30ab\u30b8\u30e5\u30a2\u30eb\u306a\u30d7\u30ec\u30a4\u306b\u6700\u9069\u3067\u3059\u304c\u3001\u30cf\u30fc\u30c9\u30b3\u30a2\u30e2\u30fc\u30c9\u306f\u7d4c\u9a13\u8c4a\u5bcc\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u6311\u6226\u3057\u307e\u3059\u3002]"}, {"question": "\u30c8\u30fc\u30b9\u30bf\u30fc\u30c0\u30c3\u30b7\u30e5\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6700\u7d42\u30ec\u30d9\u30eb\u306e\u30b9\u30b3\u30a2\u3092\u3069\u306e\u3088\u3046\u306b\u8a08\u7b97\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30c8\u30fc\u30b9\u30bf\u30fc\u30c0\u30c3\u30b7\u30e5\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u53ce\u96c6\u3057\u305f\u30b3\u30a4\u30f3\u3001\u30b3\u30f3\u30dc\u500d\u7387\u3001\u6b8b\u308a\u6642\u9593\u3068\u3044\u3046\u8907\u6570\u306e\u8981\u7d20\u3092\u7d44\u307f\u5408\u308f\u305b\u307e\u3059\u3002\u5404\u30b3\u30a4\u30f3\u306f\u57fa\u672c\u30b9\u30b3\u30a2\u306b\u52a0\u7b97\u3055\u308c\u3001\u30b3\u30f3\u30dc\u306f\u305d\u308c\u3092\u4e57\u7b97\u3057\u307e\u3059\u3002\u6b8b\u308a\u6642\u9593\u306f\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u306b\u5909\u63db\u3055\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb4\u3067\u306f\u3001\u3059\u3079\u3066\u306e\u30b3\u30a4\u30f3\u30922\u500d\u306e\u30b3\u30f3\u30dc\u3067\u96c6\u3081\u3001\u6b8b\u308a\u6642\u9593\u304c10\u79d2\u306e\u5834\u5408\u3001\u9ad8\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002[\u8a2d\u5b9a\u6bd4\u8f03\uff1a\u30b3\u30a4\u30f3\u306e\u4fa1\u5024\u306f10\u30dd\u30a4\u30f3\u30c8\u3001\u30b3\u30f3\u30dc\u500d\u7387\u306f1\u500d\u304b\u30895\u500d\u3001\u6642\u9593\u30dc\u30fc\u30ca\u30b9\u306f1\u79d2\u3042\u305f\u308a1\u30dd\u30a4\u30f3\u30c8\u3067\u3059\u3002]"}, {"question": "PC\u7248\u306e\u30c8\u30fc\u30b9\u30bf\u30fc\u30c0\u30c3\u30b7\u30e5\u306e\u9032\u884c\u72b6\u6cc1\u3092\u30e2\u30d0\u30a4\u30eb\u7248\u306b\u79fb\u884c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4ecb\u3057\u3066\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u9023\u643a\u3059\u308b\u3053\u3068\u3067\u3001PC\u7248\u306e\u30c8\u30fc\u30b9\u30bf\u30fc\u30c0\u30c3\u30b7\u30e5\u306e\u9032\u884c\u72b6\u6cc1\u3092\u30e2\u30d0\u30a4\u30eb\u7248\u306b\u79fb\u884c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u3067\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u6709\u52b9\u306b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u9032\u884c\u72b6\u6cc1\u3092\u540c\u671f\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001PC\u3067\u30ec\u30d9\u30eb6\u3092\u30af\u30ea\u30a2\u3057\u305f\u5834\u5408\u306f\u3001\u540c\u671f\u5f8c\u3001\u30e2\u30d0\u30a4\u30eb\u7248\u3067\u3082\u30ec\u30d9\u30eb6\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002[\u4f8b\uff1a\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u306f\u3001\u3069\u3053\u306b\u3044\u3066\u3082\u9032\u884c\u72b6\u6cc1\u3092\u6301\u3061\u904b\u3076\u30d0\u30c3\u30af\u30d1\u30c3\u30af\u3060\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30c8\u30fc\u30b9\u30bf\u30fc\u30c0\u30c3\u30b7\u30e5\u3067\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u4f55\u304b\u3001\u305d\u3057\u3066\u305d\u308c\u3089\u306e\u5834\u6240\u306f\u3069\u3053\u3067\u3059\u304b\uff1f", "answer": "\u30c8\u30fc\u30b9\u30bf\u30fc\u30c0\u30c3\u30b7\u30e5\u306b\u306f\u3001\u63a2\u7d22\u3092\u4fc3\u3059\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u6e80\u8f09\u3067\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306e1\u3064\u306f\u3001\u30ec\u30d9\u30eb8\u306b\u96a0\u3055\u308c\u305f\u300e\u30b4\u30fc\u30eb\u30c7\u30f3\u30fb\u30c8\u30fc\u30b9\u30bf\u30fc\u300f\u3067\u3059\u3002\u305d\u308c\u3092\u767a\u898b\u3059\u308b\u306b\u306f\u3001\u96a0\u308c\u305f\u5834\u6240\u306b\u7279\u5b9a\u306e\u30b8\u30e3\u30f3\u30d7\u3068\u30c0\u30c3\u30b7\u30e5\u306e\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u5b9f\u884c\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u3067\u3001\u7279\u5225\u306a\u5b9f\u7e3e\u3084\u30dc\u30fc\u30ca\u30b9\u30b3\u30f3\u30c6\u30f3\u30c4\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002[\u63a2\u6c42\uff1a\u30b4\u30fc\u30eb\u30c7\u30f3\u30fb\u30c8\u30fc\u30b9\u30bf\u30fc\u306f\u3001\u30af\u30e9\u30b7\u30c3\u30af\u306a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30de\u30fc\u30b2\u30fc\u30e0\u3078\u306e\u30aa\u30de\u30fc\u30b8\u30e5\u3067\u3042\u308a\u3001\u71b1\u5fc3\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u697d\u3057\u3044\u6311\u6226\u3067\u3059\u3002]"}, {"question": "\u30c8\u30fc\u30b9\u30bf\u30fc\u30c0\u30c3\u30b7\u30e5\u3067\u3001\u96e3\u3057\u3044\u30ec\u30d9\u30eb\u3092\u751f\u304d\u6b8b\u308b\u305f\u3081\u306b\u6700\u3082\u52b9\u679c\u7684\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30c8\u30fc\u30b9\u30bf\u30fc\u30c0\u30c3\u30b7\u30e5\u3067\u96e3\u3057\u3044\u30ec\u30d9\u30eb\u3092\u751f\u304d\u6b8b\u308b\u305f\u3081\u306b\u306f\u3001\u7279\u5b9a\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u304c\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u300e\u30b7\u30fc\u30eb\u30c9\u300f\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u30011\u56de\u306e\u653b\u6483\u304b\u3089\u5b88\u3063\u3066\u304f\u308c\u307e\u3059\u3002\u4e00\u65b9\u3001\u300e\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u300f\u306f\u3001\u9ad8\u901f\u306a\u969c\u5bb3\u7269\u3092\u56de\u907f\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb9\u3067\u306f\u3001\u30b7\u30fc\u30eb\u30c9\u306f\u4e88\u671f\u305b\u306c\u30c8\u30fc\u30b9\u30bf\u30fc\u306e\u653b\u6483\u304b\u3089\u3042\u306a\u305f\u3092\u5b88\u3063\u3066\u304f\u308c\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u30b7\u30fc\u30eb\u30c9\u306f\u521d\u5fc3\u8005\u306b\u3068\u3063\u3066\u6700\u9069\u3067\u3059\u304c\u3001\u30b9\u30d4\u30fc\u30c9\u30e9\u30f3\u30ca\u30fc\u306f\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u3092\u597d\u3080\u3053\u3068\u304c\u591a\u3044\u3067\u3059\u3002]"}, {"question": "\u30c8\u30fc\u30b9\u30bf\u30fc\u30c0\u30c3\u30b7\u30e5\u306e\u79d8\u5bc6\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u306e\u30e6\u30cb\u30fc\u30af\u306a\u80fd\u529b\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30c8\u30fc\u30b9\u30bf\u30fc\u30c0\u30c3\u30b7\u30e5\u306e\u79d8\u5bc6\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u306b\u306f\u3001\u3059\u3079\u3066\u306e\u30ec\u30d9\u30eb\u3092\u30d1\u30fc\u30d5\u30a7\u30af\u30c8\u30b9\u30b3\u30a2\u3067\u30af\u30ea\u30a2\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u79d8\u5bc6\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u300e\u30c8\u30fc\u30b9\u30c8\u30de\u30b9\u30bf\u30fc\u300f\u306f\u30012\u6bb5\u30b8\u30e3\u30f3\u30d7\u3084\u5ef6\u9577\u30c0\u30c3\u30b7\u30e5\u3068\u3044\u3063\u305f\u30e6\u30cb\u30fc\u30af\u306a\u80fd\u529b\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb12\u3067\u306f\u30012\u6bb5\u30b8\u30e3\u30f3\u30d7\u306b\u3088\u308a\u3001\u305d\u3046\u3067\u306a\u3051\u308c\u3070\u5230\u9054\u3067\u304d\u306a\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u5230\u9054\u3067\u304d\u307e\u3059\u3002[\u4f8b\uff1a\u30c8\u30fc\u30b9\u30c8\u30de\u30b9\u30bf\u30fc\u306f\u3001\u5f37\u5316\u3055\u308c\u305f\u79fb\u52d5\u6027\u3068\u6a5f\u654f\u3055\u3092\u6301\u3064\u30b9\u30fc\u30d1\u30fc\u30d2\u30fc\u30ed\u30fc\u3060\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}]
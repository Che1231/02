[{"question": "\ud1a0\uc2a4\ud130 \ub7f0\uc5d0\uc11c \uc810\ud504\uc640 \ub3cc\uc9c4\uacfc \uac19\uc740 \uae30\ubcf8 \ub3d9\uc791\uc740 \uc5b4\ub5bb\uac8c \uc218\ud589\ud569\ub2c8\uae4c?", "answer": "\ud1a0\uc2a4\ud130 \ub7f0\uc5d0\uc11c \uae30\ubcf8 \uc81c\uc5b4\ub294 \uac04\ub2e8\ud558\uc9c0\ub9cc \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc810\ud504\ud558\ub824\uba74 '\uc2a4\ud398\uc774\uc2a4' \ud0a4 \ub610\ub294 \ucee8\ud2b8\ub864\ub7ec\uc758 'A' \ubc84\ud2bc\uc744 \ub204\ub974\uc2ed\uc2dc\uc624. \ub3cc\uc9c4\ud558\ub824\uba74 'Shift' \ud0a4 \ub610\ub294 'B' \ubc84\ud2bc\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c\ub294 \ud1a0\uc2a4\ud130 \uc704\ub85c \uc810\ud504\ud55c \ub2e4\uc74c \uc881\uc740 \ud2c8\uc0c8\ub97c \ub3cc\uc9c4\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ub3d9\uc791\uc740 \uac8c\uc784\uc758 \uc7a5\uc560\ubb3c\uc744 \uadf9\ubcf5\ud558\uace0 \ub808\ubca8\uc744 \uc9c4\ud589\ud558\ub294 \ub370 \uae30\ubcf8\uc774 \ub429\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc810\ud504\ub294 \uc791\uc740 \uc6b8\ud0c0\ub9ac \uc704\ub85c \ub6f0\uc5b4\uc624\ub974\ub294 \uac83\uacfc \uac19\uace0, \ub3cc\uc9c4\uc740 \uc881\uc740 \uace8\ubaa9\uae38\uc744 \uc9c8\uc8fc\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ud1a0\uc2a4\ud130 \ub7f0\uc758 \ud55c \ub808\ubca8\uc5d0\uc11c \ubaa8\ub4e0 \ub3d9\uc804\uc744 \uc218\uc9d1\ud558\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud1a0\uc2a4\ud130 \ub7f0\uc5d0\uc11c \ubaa8\ub4e0 \ub3d9\uc804\uc744 \uc218\uc9d1\ud558\ub824\uba74 \uc815\ud655\uc131\uacfc \uacc4\ud68d\uc758 \uc870\ud569\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \ub3d9\uc804 \uc704\uce58\ub97c \ud30c\uc545\ud558\uae30 \uc704\ud574 \ub808\ubca8 \ub808\uc774\uc544\uc6c3\uc744 \uc5f0\uad6c\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc810\ud504\uc640 \ub3cc\uc9c4\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub192\uc740 \uc704\uce58 \ub610\ub294 \uc228\uaca8\uc9c4 \uc601\uc5ed\uc5d0 \ub3c4\ub2ec\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ub3d9\uc804\uc744 \uc218\uc9d1\ud558\uba74\uc11c \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\uae30 \uc704\ud574 \ub3d9\uc791\uc758 \ud0c0\uc774\ubc0d\uc744 \ub9de\ucda5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 3\ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c \ub3d9\uc804\uc740 \uc815\ud655\ud55c \uc810\ud504\uac00 \ud544\uc694\ud55c \ud50c\ub7ab\ud3fc\uc5d0 \ud769\uc5b4\uc838 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\ub294 \uccab \ubc88\uc9f8 \uc2e4\ud589\uc5d0\uc11c \ub3d9\uc804\uc744 \uc218\uc9d1\ud558\ub294 \uac83\uc744 \uc120\ud638\ud558\uc9c0\ub9cc, \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub294 \uba54\ucee4\ub2c8\uc998\uc744 \uc219\ub2ec\ud55c \ud6c4 \ub808\ubca8\uc744 \ub2e4\uc2dc \ubc18\ubcf5\ud569\ub2c8\ub2e4.]"}, {"question": "\uc65c \ud1a0\uc2a4\ud130 \ub7f0\uc5d0\uc11c \ub3cc\uc9c4\ud560 \ub54c \uce90\ub9ad\ud130\uac00 \ub54c\ub54c\ub85c \uac07\ud788\ub294 \uac83\uc785\ub2c8\uae4c?", "answer": "\ud1a0\uc2a4\ud130 \ub7f0\uc5d0\uc11c \ub3cc\uc9c4 \uc911\uc5d0 \uac07\ud788\ub294 \uac83\uc740 \uc885\uc885 \ucda9\ub3cc \uac10\uc9c0 \ubb38\uc81c\ub85c \uc778\ud574 \ubc1c\uc0dd\ud569\ub2c8\ub2e4. \uac8c\uc784\uc758 \ubb3c\ub9ac \uc5d4\uc9c4\uc740 \ud0c0\uc774\ubc0d\uc774 \ub9de\uc9c0 \uc54a\uc73c\uba74 \ub3cc\uc9c4\uc774 \uc7a5\uc560\ubb3c\uacfc \ucda9\ub3cc\ud558\ub294 \uac83\uc73c\ub85c \ud574\uc11d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 5\ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c \ubcbd\uc5d0 \ub108\ubb34 \uc77c\ucc0d \ub3cc\uc9c4\ud558\uba74 \uce90\ub9ad\ud130\uac00 \uac07\ud790 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub97c \ubc29\uc9c0\ud558\ub824\uba74 \uc801\uc808\ud55c \uc2dc\uc810\uacfc \uac01\ub3c4\ub85c \ub3cc\uc9c4\ud558\uc2ed\uc2dc\uc624. [\uc124\uc815 \ube44\uad50\ud45c: \ud0a4\ubcf4\ub4dc\uc640 \ucee8\ud2b8\ub864\ub7ec\uc758 \ub3cc\uc9c4 \ud0c0\uc774\ubc0d\uc740 \uc57d\uac04 \ub2e4\ub97c \uc218 \uc788\uc73c\ubbc0\ub85c \uc120\ud638\ud558\ub294 \uc785\ub825 \ubc29\uc2dd\uc73c\ub85c \uc5f0\uc2b5\ud558\uc2ed\uc2dc\uc624.]"}, {"question": "\ud1a0\uc2a4\ud130 \ub7f0\uc5d0\uc11c \ucf64\ubcf4 \ubc30\uc218\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc810\uc218\ub97c \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud1a0\uc2a4\ud130 \ub7f0\uc5d0\uc11c \uc810\uc218\ub97c \uadf9\ub300\ud654\ud558\ub824\uba74 \ucf64\ubcf4 \ubc30\uc218\ub97c \uad6c\ucd95\ud558\uae30 \uc704\ud574 \uc5f0\uc18d\uc801\uc778 \ub3d9\uc791\uc744 \uc5f0\uacb0\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 1: \uc9c0\uba74\uc5d0 \ub2ff\uc9c0 \uc54a\uace0 \uc5f0\uc18d\uc801\uc778 \uc810\ud504\uc640 \ub3cc\uc9c4\uc744 \uc218\ud589\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \ucf64\ubcf4 \uc911\uc5d0 \ub3d9\uc804\uacfc \uac15\ud654 \uc544\uc774\ud15c\uc744 \uc218\uc9d1\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \ub808\ubca8\uc744 \ube60\ub974\uac8c \uc644\ub8cc\ud558\uc5ec \uc2dc\uac04 \ubcf4\ub108\uc2a4\ub97c \ucd94\uac00\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, 7\ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c \ud0c0\uc774\ubc0d\uc774 \uc798 \ub9de\ub294 \ucf64\ubcf4\ub294 \uc810\uc218\ub97c \ub450 \ubc30\ub85c \ub298\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4 \uc124\uba85: \uc810\ud504\ub85c \uc2dc\uc791\ud558\uc5ec \ub3d9\uc804\uc744 \uc218\uc9d1\ud558\uace0 \uc801\uc744 \ub3cc\uc9c4\ud558\uace0 \uc548\uc804\ud558\uac8c \ucc29\uc9c0\ud558\uc5ec \ucf64\ubcf4\ub97c \uc720\uc9c0\ud558\uc2ed\uc2dc\uc624.]"}, {"question": "\ud1a0\uc2a4\ud130 \ub7f0\uc5d0\uc11c \ud45c\uc900 \ubaa8\ub4dc\uc640 \ud558\ub4dc\ucf54\uc5b4 \ubaa8\ub4dc\uc758 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud1a0\uc2a4\ud130 \ub7f0\uc758 \ud45c\uc900 \ubaa8\ub4dc\uc640 \ud558\ub4dc\ucf54\uc5b4 \ubaa8\ub4dc\ub294 \uc5b4\ub824\uc6c0\uacfc \uba54\ucee4\ub2c8\uc998\uc774 \ud604\uc800\ud788 \ub2e4\ub985\ub2c8\ub2e4. \ud558\ub4dc\ucf54\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uc7a5\uc560\ubb3c\uc774 \ub354 \ube68\ub9ac \uc6c0\uc9c1\uc774\uace0 \uccb4\ud06c\ud3ec\uc778\ud2b8\uac00 \uc801\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 10\ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c\ub294 \ud558\ub4dc\ucf54\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c \ud1a0\uc2a4\ud130\uac00 \ub450 \ubc30\uc758 \uc18d\ub3c4\ub85c \uc6c0\uc9c1\uc785\ub2c8\ub2e4. \ub610\ud55c \ud558\ub4dc\ucf54\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \ud53c\ud558\uae30 \uc704\ud574 \uace0\uae09 \uc804\ub7b5\uc774 \ud544\uc694\ud55c \uc0c8\ub85c\uc6b4 \uc801 \uc720\ud615\uc774 \ucd94\uac00\ub429\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: \ud45c\uc900 \ubaa8\ub4dc\ub294 \uce90\uc8fc\uc5bc \ud50c\ub808\uc774\uc5d0 \uc801\ud569\ud558\uba70, \ud558\ub4dc\ucf54\uc5b4 \ubaa8\ub4dc\ub294 \uacbd\ud5d8 \ub9ce\uc740 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \ub3c4\uc804\uc785\ub2c8\ub2e4.]"}, {"question": "\ud1a0\uc2a4\ud130 \ub7f0\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ucd5c\uc885 \ub808\ubca8 \uc810\uc218\ub97c \uc5b4\ub5bb\uac8c \uacc4\uc0b0\ud569\ub2c8\uae4c?", "answer": "\ud1a0\uc2a4\ud130 \ub7f0\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5ec\ub7ec \uc694\uc18c\ub97c \uacb0\ud569\ud569\ub2c8\ub2e4. \uc218\uc9d1\ud55c \ub3d9\uc804, \ucf64\ubcf4 \ubc30\uc218 \ubc0f \ub0a8\uc740 \uc2dc\uac04\uc785\ub2c8\ub2e4. \uac01 \ub3d9\uc804\uc740 \uae30\ubcf8 \uc810\uc218\uc5d0 \ucd94\uac00\ub418\uace0, \ucf64\ubcf4\ub294 \uadf8\uac83\uc744 \uacf1\ud569\ub2c8\ub2e4. \ub0a8\uc740 \uc2dc\uac04\uc740 \ubcf4\ub108\uc2a4 \uc810\uc218\ub85c \uc804\ud658\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 4\ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c \ubaa8\ub4e0 \ub3d9\uc804\uc744 2\ubc30 \ucf64\ubcf4\ub85c \uc218\uc9d1\ud558\uace0 10\ucd08\uac00 \ub0a8\uc740 \uc0c1\ud0dc\ub85c \uc644\ub8cc\ud558\uba74 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \ub3d9\uc804 \uac00\uce58\ub294 10\uc810, \ucf64\ubcf4 \ubc30\uc218\ub294 1\ubc30\uc5d0\uc11c 5\ubc30\uae4c\uc9c0\uc774\uba70, \uc2dc\uac04 \ubcf4\ub108\uc2a4\ub294 1\ucd08\ub2f9 1\uc810\uc785\ub2c8\ub2e4.]"}, {"question": "PC\uc5d0\uc11c \ubaa8\ubc14\uc77c\ub85c \ud1a0\uc2a4\ud130 \ub7f0\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub124, \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc5d0 \uacc4\uc815\uc744 \uc5f0\uacb0\ud558\uc5ec PC\uc5d0\uc11c \ubaa8\ubc14\uc77c\ub85c \ud1a0\uc2a4\ud130 \ub7f0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \ub450 \ub514\ubc14\uc774\uc2a4 \ubaa8\ub450\uc5d0\uc11c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc124\uc815 \uba54\ub274\uc5d0\uc11c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c 6\ubc88\uc9f8 \ub808\ubca8\uc744 \uc644\ub8cc\ud588\ub2e4\uba74 \ub3d9\uae30\ud654 \ud6c4 \ubaa8\ubc14\uc77c\uc5d0\ub3c4 \ud574\uc81c\ub429\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc740 \uc5b4\ub514\ub4e0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uac00\uc9c0\uace0 \ub2e4\ub2c8\ub294 \ubc30\ub0ad\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ud1a0\uc2a4\ud130 \ub7f0\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uc640 \uc704\uce58\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud1a0\uc2a4\ud130 \ub7f0\uc5d0\ub294 \ud0d0\ud5d8\uc744 \ubcf4\uc0c1\ud558\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uac00\ub4dd\ud569\ub2c8\ub2e4. \ud55c \uac00\uc9c0 \uc8fc\ubaa9\ud560 \ub9cc\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 8\ubc88\uc9f8 \ub808\ubca8\uc5d0 \uc228\uaca8\uc9c4 '\uace8\ub4e0 \ud1a0\uc2a4\ud130'\uc785\ub2c8\ub2e4. \uc774\uac83\uc744 \ucc3e\uc73c\ub824\uba74 \uc228\uaca8\uc9c4 \uc601\uc5ed\uc5d0\uc11c \ud2b9\uc815 \uc810\ud504 \ubc0f \ub3cc\uc9c4 \uc21c\uc11c\ub97c \uc218\ud589\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ubc1c\uacac\ud558\uba74 \uc885\uc885 \ud2b9\ubcc4\ud55c \uc131\ucde8\ub3c4 \ub610\ub294 \ubcf4\ub108\uc2a4 \ucf58\ud150\uce20\uac00 \ud574\uc81c\ub429\ub2c8\ub2e4. [\uc774\uc2a4\ud130 \uc5d0\uadf8 \ucc3e\uae30: \uace8\ub4e0 \ud1a0\uc2a4\ud130\ub294 \ud074\ub798\uc2dd \ud50c\ub7ab\ud3ec\uba38 \uac8c\uc784\uc5d0 \ub300\ud55c \uc624\ub9c8\uc8fc\uc774\uba70, \uc5f4\uc815\uc801\uc778 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \uc7ac\ubbf8\uc788\ub294 \ub3c4\uc804\uc785\ub2c8\ub2e4.]"}, {"question": "\ud1a0\uc2a4\ud130 \ub7f0\uc5d0\uc11c \uc5b4\ub824\uc6b4 \ub808\ubca8\uc744 \uc0b4\uc544\ub0a8\ub294\ub370 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \uac15\ud654 \uc544\uc774\ud15c\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud1a0\uc2a4\ud130 \ub7f0\uc5d0\uc11c \uc5b4\ub824\uc6b4 \ub808\ubca8\uc744 \uc0b4\uc544\ub0a8\ub294 \ub370 \ud2b9\uc815\ud55c \uac15\ud654 \uc544\uc774\ud15c\uc774 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. '\ubc29\ud328' \uac15\ud654 \uc544\uc774\ud15c\uc740 \ud55c \ubc88\uc758 \ud0c0\uaca9\uc73c\ub85c\ubd80\ud130 \ub2f9\uc2e0\uc744 \ubcf4\ud638\ud558\uace0, '\uc18d\ub3c4 \ubd80\uc2a4\ud130'\ub294 \ube60\ub974\uac8c \uc6c0\uc9c1\uc774\ub294 \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 9\ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c \ubc29\ud328\ub294 \uc608\uc0c1\uce58 \ubabb\ud55c \ud1a0\uc2a4\ud130 \uacf5\uaca9\uc73c\ub85c\ubd80\ud130 \ub2f9\uc2e0\uc744 \uad6c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: \ubc29\ud328\ub294 \ucd08\ubcf4\uc790\uc5d0\uac8c \uac00\uc7a5 \uc88b\uace0, \uc18d\ub3c4 \ubd80\uc2a4\ud130\ub294 \uc2a4\ud53c\ub4dc\ub7ec\ub108\uc5d0\uac8c \uc120\ud638\ub429\ub2c8\ub2e4.]"}, {"question": "\ud1a0\uc2a4\ud130 \ub7f0\uc5d0\uc11c \ube44\ubc00 \uce90\ub9ad\ud130\ub97c \uc5b4\ub5bb\uac8c \ud574\uc81c\ud558\uace0, \uadf8 \ub3c5\ud2b9\ud55c \ub2a5\ub825\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud1a0\uc2a4\ud130 \ub7f0\uc5d0\uc11c \ube44\ubc00 \uce90\ub9ad\ud130\ub97c \ud574\uc81c\ud558\ub824\uba74 \ubaa8\ub4e0 \ub808\ubca8\uc744 \uc644\ubcbd\ud55c \uc810\uc218\ub85c \uc644\ub8cc\ud574\uc57c \ud569\ub2c8\ub2e4. \ube44\ubc00 \uce90\ub9ad\ud130\uc778 '\ud1a0\uc2a4\ud2b8 \ub9c8\uc2a4\ud130'\ub294 \ub354\ube14 \uc810\ud504\uc640 \ud655\uc7a5\ub41c \ub3cc\uc9c4\uacfc \uac19\uc740 \uace0\uc720\ud55c \ub2a5\ub825\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 12\ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c \ub354\ube14 \uc810\ud504\ub97c \uc0ac\uc6a9\ud558\uba74 \uadf8\ub807\uc9c0 \uc54a\uc73c\uba74 \uc811\uadfc\ud560 \uc218 \uc5c6\ub294 \ud50c\ub7ab\ud3fc\uc5d0 \ub3c4\ub2ec\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud1a0\uc2a4\ud2b8 \ub9c8\uc2a4\ud130\ub294 \uac15\ud654\ub41c \uc774\ub3d9\uc131\uacfc \ubbfc\ucca9\uc131\uc744 \uac00\uc9c4 \uc288\ud37c\ud788\uc5b4\ub85c\uc640 \uac19\uc2b5\ub2c8\ub2e4.]"}]
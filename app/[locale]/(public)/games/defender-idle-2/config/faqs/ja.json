[{"question": "\u521d\u5fc3\u8005\u306e\u65b9\u3001Defender Idle 2\u3092\u52b9\u679c\u7684\u306b\u59cb\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Defender Idle 2\u3067\u52b9\u679c\u7684\u306b\u59cb\u3081\u308b\u306b\u306f\u3001\u57fa\u672c\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6700\u521d\u306b\u914d\u7f6e\u3059\u308b\u9632\u885b\u5175\u58eb\u3092\u8907\u6570\u306e\u7d4c\u8def\u3092\u30ab\u30d0\u30fc\u3059\u308b\u3088\u3046\u306b\u6226\u7565\u7684\u306a\u5834\u6240\u306b\u914d\u7f6e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u9632\u885b\u5175\u58eb\u3092\u5b9a\u671f\u7684\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u3066\u3001\u30c0\u30e1\u30fc\u30b8\u3068\u5c04\u7a0b\u3092\u5f37\u5316\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30ea\u30bd\u30fc\u30b9\u3092\u52b9\u7387\u7684\u306b\u7ba1\u7406\u3059\u308b\u305f\u3081\u306b\u300c\u81ea\u52d5\u6226\u95d8\u300d\u6a5f\u80fd\u3092\u6d3b\u7528\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30b9\u30ca\u30a4\u30d1\u30fc\u300d\u3092\u30ab\u30fc\u30d6\u8fd1\u304f\u306b\u914d\u7f6e\u3059\u308b\u3068\u3001\u5c04\u7a0b\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u53d6\u308c\u305f\u30b9\u30bf\u30fc\u30c8\u3068\u6bb5\u968e\u7684\u306a\u9032\u6b69\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002"}, {"question": "Defender Idle 2\u306e\u4e2d\u76e4\u30b9\u30c6\u30fc\u30b8\u3067\u91cd\u8981\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Defender Idle 2\u306e\u4e2d\u76e4\u30b9\u30c6\u30fc\u30b8\u3067\u306e\u9032\u6b69\u306b\u306f\u3001\u6226\u7565\u7684\u306a\u914d\u7f6e\u3068\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u306e\u4e21\u65b9\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30a8\u30ea\u30a2\u30c0\u30e1\u30fc\u30b8\u7528\u306e\u300c\u5927\u7832\u300d\u306a\u3069\u3001\u6700\u3082\u52b9\u679c\u7684\u306a\u9632\u885b\u5175\u58eb\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u7dcf\u5408\u7684\u306a\u52b9\u7387\u3092\u9ad8\u3081\u308b\u305f\u3081\u306e\u7814\u7a76\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u6295\u8cc7\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u3088\u308a\u56f0\u96e3\u306a\u6ce2\u306e\u9593\u3001\u614e\u91cd\u306b\u300c\u7279\u6b8a\u80fd\u529b\u300d\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u96c6\u4e2d\u7832\u706b\u300d\u3092\u8d77\u52d5\u3059\u308b\u3068\u3001\u6575\u3092\u7d20\u65e9\u304f\u4e00\u6383\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u6226\u7565\u306f\u3001\u6301\u7d9a\u7684\u306a\u9032\u6b69\u3068\u30ea\u30bd\u30fc\u30b9\u306e\u6700\u9069\u5316\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002"}, {"question": "Defender Idle 2\u306e\u7d42\u76e4\u30b9\u30c6\u30fc\u30b8\u3067\u3001\u3069\u306e\u9632\u885b\u5175\u58eb\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "Defender Idle 2\u306e\u7d42\u76e4\u30b9\u30c6\u30fc\u30b8\u3067\u306f\u3001\u9ad8\u30c0\u30e1\u30fc\u30b8\u3068\u30a8\u30ea\u30a2\u52b9\u679c\u3092\u6301\u3064\u9632\u885b\u5175\u58eb\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u9ad8\u3044\u30c0\u30e1\u30fc\u30b8\u51fa\u529b\u306e\u305f\u3081\u306b\u300c\u9b54\u6cd5\u4f7f\u3044\u300d\u3068\u300c\u7206\u5f3e\u9b54\u300d\u306e\u9632\u885b\u5175\u58eb\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u6700\u5927\u9650\u306b\u6d3b\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u524d\u7dda\u3092\u652f\u3048\u308b\u300c\u56de\u5fa9\u5f79\u300d\u306a\u3069\u306e\u300c\u652f\u63f4\u300d\u9632\u885b\u5175\u58eb\u3067\u9632\u5fa1\u3092\u30d0\u30e9\u30f3\u30b9\u3055\u305b\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30dc\u30b9\u6226\u306b\u5bfe\u5fdc\u3059\u308b\u305f\u3081\u306b\u300c\u7a76\u6975\u80fd\u529b\u300d\u3092\u6226\u7565\u7684\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u9b54\u6cd5\u4f7f\u3044\u300d\u306e\u300c\u9396\u96f7\u6483\u300d\u306f\u8907\u6570\u306e\u6575\u306b\u58ca\u6ec5\u7684\u306a\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u307e\u3059\u3002\u3053\u306e\u7126\u70b9\u306f\u3001\u7d42\u76e4\u30b9\u30c6\u30fc\u30b8\u306e\u6ce2\u306e\u5897\u52a0\u3059\u308b\u96e3\u6613\u5ea6\u306b\u5bfe\u5fdc\u3067\u304d\u308b\u3053\u3068\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002"}, {"question": "Defender Idle 2\u3067\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u306a\u305c\u91cd\u8981\u3067\u3059\u304b\uff1f", "answer": "Defender Idle 2\u3067\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u52b9\u7387\u3068\u80fd\u529b\u3092\u6700\u5927\u5316\u3059\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30c0\u30e1\u30fc\u30b8\u3084\u5c04\u7a0b\u306a\u3069\u306e\u7d71\u8a08\u5024\u3092\u5f37\u5316\u3059\u308b\u305f\u3081\u306b\u3001\u5b9a\u671f\u7684\u306b\u9632\u885b\u5175\u58eb\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b4\u30fc\u30eb\u30c9\u53ce\u5165\u306e\u5897\u52a0\u306a\u3069\u3001\u30b0\u30ed\u30fc\u30d0\u30eb\u306a\u30dc\u30fc\u30ca\u30b9\u3092\u63d0\u4f9b\u3059\u308b\u7814\u7a76\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u300c\u540d\u58f0\u300d\u3092\u6d3b\u7528\u3057\u3066\u30ea\u30bb\u30c3\u30c8\u3057\u3001\u6c38\u7d9a\u7684\u306a\u30d6\u30fc\u30b9\u30c8\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u653b\u6483\u901f\u5ea6\u3092\u9ad8\u3081\u308b\u305f\u3081\u306b\u300c\u30a2\u30fc\u30c1\u30e3\u30fc\u300d\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3068\u3001\u9632\u5fa1\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u7406\u89e3\u306f\u3001\u6301\u7d9a\u7684\u306a\u9032\u6b69\u3068\u30ea\u30bd\u30fc\u30b9\u6700\u9069\u5316\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002"}, {"question": "\u81ea\u52d5\u6226\u95d8\u6a5f\u80fd\u306f\u3001Defender Idle 2\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u3069\u306e\u3088\u3046\u306b\u5f37\u5316\u3057\u307e\u3059\u304b\uff1f", "answer": "Defender Idle 2\u306e\u81ea\u52d5\u6226\u95d8\u6a5f\u80fd\u306f\u3001\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u3068\u9632\u885b\u5175\u58eb\u306e\u884c\u52d5\u3092\u81ea\u52d5\u5316\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5f37\u5316\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u81ea\u52d5\u6226\u95d8\u3092\u6709\u52b9\u306b\u3057\u3066\u3001\u9632\u885b\u5175\u58eb\u306e\u81ea\u52d5\u914d\u7f6e\u3068\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u884c\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u3053\u306e\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u3001\u30df\u30af\u30ed\u30de\u30cd\u30b8\u30e1\u30f3\u30c8\u3067\u306f\u306a\u304f\u6226\u7565\u7684\u306a\u6c7a\u5b9a\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7279\u5b9a\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3084\u80fd\u529b\u3092\u512a\u5148\u3059\u308b\u3088\u3046\u306b\u8a2d\u5b9a\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u81ea\u52d5\u6226\u95d8\u3092\u300c\u30b9\u30ca\u30a4\u30d1\u30fc\u300d\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u96c6\u4e2d\u3059\u308b\u3088\u3046\u306b\u8a2d\u5b9a\u3059\u308b\u3068\u3001\u9577\u8ddd\u96e2\u30c0\u30e1\u30fc\u30b8\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u6a5f\u80fd\u306f\u3001\u3088\u308a\u30b9\u30e0\u30fc\u30ba\u3067\u52b9\u7387\u7684\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4f53\u9a13\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002"}, {"question": "Defender Idle 2\u306e\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u306e\u30d9\u30b9\u30c8\u30d7\u30e9\u30af\u30c6\u30a3\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Defender Idle 2\u3067\u52b9\u679c\u7684\u306a\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u3092\u884c\u3046\u306b\u306f\u3001\u6226\u7565\u7684\u306a\u8a08\u753b\u3068\u512a\u5148\u9806\u4f4d\u4ed8\u3051\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u307e\u305a\u3001\u6700\u5927\u306e\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u9632\u885b\u5175\u58eb\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u30ea\u30bd\u30fc\u30b9\u3092\u5272\u308a\u5f53\u3066\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5373\u6642\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3068\u9577\u671f\u7684\u306a\u7814\u7a76\u306e\u652f\u51fa\u3092\u30d0\u30e9\u30f3\u30b9\u3055\u305b\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u300c\u540d\u58f0\u300d\u3092\u8ce2\u304f\u4f7f\u3063\u3066\u3001\u30ea\u30bd\u30fc\u30b9\u3092\u4f7f\u3044\u3059\u304e\u305a\u306b\u6c38\u7d9a\u7684\u306a\u30d6\u30fc\u30b9\u30c8\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30b4\u30fc\u30eb\u30c9\u53ce\u5165\u300d\u306e\u7814\u7a76\u306b\u6295\u8cc7\u3059\u308b\u3068\u3001\u5b89\u5b9a\u3057\u305f\u30ea\u30bd\u30fc\u30b9\u30d5\u30ed\u30fc\u304c\u5f97\u3089\u308c\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u65b9\u6cd5\u306f\u3001\u6301\u7d9a\u7684\u306a\u9032\u6b69\u3068\u52b9\u7387\u7684\u306a\u30ea\u30bd\u30fc\u30b9\u6d3b\u7528\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002"}, {"question": "Defender Idle 2\u306e\u540d\u58f0\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "Defender Idle 2\u306e\u540d\u58f0\u30b7\u30b9\u30c6\u30e0\u3067\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u9032\u6357\u72b6\u6cc1\u3092\u30ea\u30bb\u30c3\u30c8\u3057\u3066\u6c38\u7d9a\u7684\u306a\u30d6\u30fc\u30b9\u30c8\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6ce2\u3092\u9032\u3081\u308b\u3053\u3068\u3067\u5341\u5206\u306a\u300c\u540d\u58f0\u30dd\u30a4\u30f3\u30c8\u300d\u3092\u84c4\u7a4d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u3053\u308c\u3089\u306e\u30dd\u30a4\u30f3\u30c8\u3092\u4f7f\u7528\u3057\u3066\u3001\u9632\u885b\u5175\u58eb\u306e\u80fd\u529b\u3092\u9ad8\u3081\u308b\u6c38\u7d9a\u7684\u306a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u8cfc\u5165\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u5408\u308f\u305b\u305f\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3001\u305f\u3068\u3048\u3070\u30c0\u30e1\u30fc\u30b8\u5897\u52a0\u3084\u30ea\u30bd\u30fc\u30b9\u751f\u6210\u306e\u9ad8\u901f\u5316\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u653b\u6483\u901f\u5ea6\u300d\u3092\u9078\u629e\u3059\u308b\u3068\u3001\u9632\u885b\u5175\u58eb\u306e\u52b9\u7387\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u7d99\u7d9a\u7684\u306a\u9032\u6b69\u3068\u80fd\u529b\u306e\u5411\u4e0a\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002"}, {"question": "Defender Idle 2\u306e\u9632\u885b\u5175\u58eb\u306e\u7a2e\u985e\u9593\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Defender Idle 2\u306e\u9632\u885b\u5175\u58eb\u306e\u7a2e\u985e\u306f\u3001\u5f79\u5272\u3068\u6709\u52b9\u6027\u306b\u5927\u304d\u306a\u9055\u3044\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u300c\u30a2\u30fc\u30c1\u30e3\u30fc\u300d\u306f\u9577\u8ddd\u96e2\u653b\u6483\u306b\u6709\u52b9\u3067\u3042\u308a\u3001\u300c\u9a0e\u58eb\u300d\u306f\u8fd1\u63a5\u6226\u95d8\u306b\u512a\u308c\u3066\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u300c\u9b54\u6cd5\u4f7f\u3044\u300d\u306f\u30a8\u30ea\u30a2\u653b\u6483\u3092\u63d0\u4f9b\u3057\u3001\u300c\u56de\u5fa9\u5f79\u300d\u306a\u3069\u306e\u300c\u652f\u63f4\u300d\u9632\u885b\u5175\u58eb\u306f\u524d\u7dda\u3092\u652f\u3048\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u3055\u307e\u3056\u307e\u306a\u6575\u306e\u7d4c\u8def\u3092\u30ab\u30d0\u30fc\u3059\u308b\u305f\u3081\u306b\u3001\u6226\u7565\u7684\u306b\u3055\u307e\u3056\u307e\u306a\u7a2e\u985e\u3092\u914d\u7f6e\u3057\u3066\u9632\u5fa1\u3092\u30d0\u30e9\u30f3\u30b9\u3055\u305b\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u9b54\u6cd5\u4f7f\u3044\u300d\u3092\u9698\u8def\u8fd1\u304f\u306b\u914d\u7f6e\u3059\u308b\u3068\u3001\u30a8\u30ea\u30a2\u653b\u6483\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u9055\u3044\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u53d6\u308c\u305f\u9632\u5fa1\u6226\u7565\u304c\u4fdd\u8a3c\u3055\u308c\u307e\u3059\u3002"}, {"question": "Defender Idle 2\u3067\u3001\u9032\u6357\u72b6\u6cc1\u3092\u5225\u306e\u30c7\u30d0\u30a4\u30b9\u306b\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Defender Idle 2\u306e\u9032\u6357\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b2\u30fc\u30e0\u3092Google Play\u3084\u30b2\u30fc\u30e0\u30bb\u30f3\u30bf\u30fc\u306a\u3069\u306e\u30af\u30e9\u30a6\u30c9\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ea\u30f3\u30af\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3001\u4fdd\u5b58\u3055\u308c\u305f\u9032\u6357\u72b6\u6cc1\u306b\u30a2\u30af\u30bb\u30b9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u9632\u885b\u5175\u58eb\u3084\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306a\u3069\u3001\u3059\u3079\u3066\u306e\u30c7\u30fc\u30bf\u304c\u6b63\u3057\u304f\u8ee2\u9001\u3055\u308c\u305f\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u65b0\u3057\u3044Android\u30c7\u30d0\u30a4\u30b9\u3067Google Play\u306b\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3068\u3001\u30b2\u30fc\u30e0\u306e\u9032\u6357\u72b6\u6cc1\u304c\u30b7\u30fc\u30e0\u30ec\u30b9\u306b\u540c\u671f\u3055\u308c\u308b\u306f\u305a\u3067\u3059\u3002\u3053\u306e\u30d7\u30ed\u30bb\u30b9\u306b\u3088\u308a\u3001\u3055\u307e\u3056\u307e\u306a\u30c7\u30d0\u30a4\u30b9\u3067\u7d99\u7d9a\u6027\u78ba\u4fdd\u3055\u308c\u307e\u3059\u3002"}, {"question": "Defender Idle 2\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u30e1\u30ab\u30cb\u30ba\u30e0\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "Defender Idle 2\u306b\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5f37\u5316\u3059\u308b\u96a0\u3055\u308c\u305f\u30e1\u30ab\u30cb\u30ba\u30e0\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u7279\u5b9a\u306e\u30c1\u30e3\u30ec\u30f3\u30b8\u3084\u9054\u6210\u4e8b\u9805\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3067\u3001\u79d8\u5bc6\u306e\u9632\u885b\u5175\u58eb\u3092\u767a\u898b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u4e00\u5b9a\u306e\u6761\u4ef6\u3092\u6e80\u305f\u3059\u3053\u3068\u3067\u3001\u96a0\u3055\u308c\u305f\u30ec\u30d9\u30eb\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30dc\u30b9\u3092\u6642\u9593\u5236\u9650\u5185\u3067\u5012\u3059\u3053\u3068\u306a\u3069\u304c\u8a72\u5f53\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30e6\u30cb\u30fc\u30af\u306a\u5831\u916c\u3092\u63d0\u4f9b\u3059\u308b\u30ec\u30a2\u306a\u30a4\u30d9\u30f3\u30c8\u3092\u30b2\u30fc\u30e0\u3067\u63a2\u6c42\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30b4\u30fc\u30eb\u30c7\u30f3\u30fb\u30c7\u30a3\u30d5\u30a7\u30f3\u30c0\u30fc\u300d\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u3067\u3001\u9632\u5fa1\u529b\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u96a0\u3055\u308c\u305f\u8981\u7d20\u306f\u3001\u30b2\u30fc\u30e0\u306b\u5965\u884c\u304d\u3068\u8208\u596e\u3092\u52a0\u3048\u307e\u3059\u3002"}]
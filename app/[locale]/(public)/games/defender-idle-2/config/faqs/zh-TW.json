[{"question": "\u5982\u4f55\u8b93\u65b0\u624b\u5728\u300a\u634d\u885b\u8005\u9592\u7f6e 2\u300b\u4e2d\u6709\u6548\u5165\u9580\uff1f", "answer": "\u8981\u5728\u300a\u634d\u885b\u8005\u9592\u7f6e 2\u300b\u4e2d\u6709\u6548\u5165\u9580\uff0c\u91cd\u9ede\u5728\u65bc\u4e86\u89e3\u57fa\u672c\u6a5f\u5236\u3002\u6b65\u9a5f\u4e00\uff1a\u9996\u5148\u5c07\u521d\u59cb\u634d\u885b\u8005\u653e\u7f6e\u5728\u6230\u7565\u4f4d\u7f6e\uff0c\u4ee5\u8986\u84cb\u591a\u500b\u8def\u5f91\u3002\u6b65\u9a5f\u4e8c\uff1a\u5b9a\u671f\u5347\u7d1a\u60a8\u7684\u634d\u885b\u8005\uff0c\u4ee5\u589e\u5f37\u5176\u50b7\u5bb3\u548c\u5c04\u7a0b\u3002\u6b65\u9a5f\u4e09\uff1a\u5584\u7528\u300e\u81ea\u52d5\u6230\u9b25\u300f\u529f\u80fd\u4f86\u6709\u6548\u7ba1\u7406\u8cc7\u6e90\u3002\u4f8b\u5982\uff0c\u5c07\u300e\u72d9\u64ca\u624b\u300f\u653e\u7f6e\u5728\u5f4e\u9053\u9644\u8fd1\uff0c\u53ef\u4ee5\u6700\u5927\u5316\u5176\u5c04\u7a0b\u3002\u9019\u7a2e\u65b9\u6cd5\u78ba\u4fdd\u4e86\u5e73\u8861\u7684\u958b\u59cb\u548c\u6f38\u9032\u7684\u9032\u5c55\u3002"}, {"question": "\u904a\u6232\u4e2d\u671f\u5728\u300a\u634d\u885b\u8005\u9592\u7f6e 2\u300b\u4e2d\u7684\u95dc\u9375\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u300a\u634d\u885b\u8005\u9592\u7f6e 2\u300b\u904a\u6232\u4e2d\u671f\u9032\u5c55\u9700\u8981\u7b56\u7565\u6027\u7684\u4f48\u9663\u548c\u8cc7\u6e90\u7ba1\u7406\u7684\u7d50\u5408\u3002\u6b65\u9a5f\u4e00\uff1a\u512a\u5148\u5347\u7d1a\u60a8\u7684\u6700\u5f37\u634d\u885b\u8005\uff0c\u4f8b\u5982\u300e\u706b\u7832\u300f\uff0c\u4ee5\u63d0\u5347\u5340\u57df\u50b7\u5bb3\u3002\u6b65\u9a5f\u4e8c\uff1a\u6295\u8cc7\u7814\u7a76\u5347\u7d1a\u4ee5\u63d0\u5347\u6574\u9ad4\u6548\u7387\u3002\u6b65\u9a5f\u4e09\uff1a\u5728\u8f03\u56f0\u96e3\u7684\u6ce2\u6b21\u4e2d\u8b39\u614e\u4f7f\u7528\u300e\u7279\u6b8a\u80fd\u529b\u300f\u3002\u4f8b\u5982\uff0c\u555f\u52d5\u300e\u6301\u7e8c\u653b\u64ca\u300f\u53ef\u4ee5\u5feb\u901f\u6e05\u9664\u805a\u96c6\u7684\u6575\u4eba\u3002\u6b64\u7b56\u7565\u78ba\u4fdd\u4e86\u6301\u7e8c\u7684\u9032\u5c55\u548c\u8cc7\u6e90\u512a\u5316\u3002"}, {"question": "\u5728\u300a\u634d\u885b\u8005\u9592\u7f6e 2\u300b\u7684\u5f8c\u671f\u904a\u6232\u4e2d\uff0c\u6211\u61c9\u8a72\u5c08\u6ce8\u65bc\u54ea\u4e9b\u634d\u885b\u8005\uff1f", "answer": "\u5728\u300a\u634d\u885b\u8005\u9592\u7f6e 2\u300b\u7684\u5f8c\u671f\u904a\u6232\u4e2d\uff0c\u91cd\u9ede\u662f\u9ad8\u50b7\u5bb3\u548c\u5340\u57df\u6548\u61c9\u7684\u634d\u885b\u8005\u3002\u6b65\u9a5f\u4e00\uff1a\u6700\u5927\u5316\u300e\u6cd5\u5e2b\u300f\u548c\u300e\u70b8\u5f48\u4eba\u300f\u634d\u885b\u8005\u7684\u5347\u7d1a\uff0c\u4ee5\u7372\u5f97\u5176\u512a\u7570\u7684\u50b7\u5bb3\u8f38\u51fa\u3002\u6b65\u9a5f\u4e8c\uff1a\u7528\u300e\u652f\u63f4\u300f\u634d\u885b\u8005\uff08\u4f8b\u5982\u300e\u6cbb\u7642\u5e2b\u300f\uff09\u5e73\u8861\u60a8\u7684\u9632\u79a6\uff0c\u4ee5\u7dad\u6301\u524d\u7dda\u3002\u6b65\u9a5f\u4e09\uff1a\u7b56\u7565\u6027\u5730\u4f7f\u7528\u300e\u7d42\u6975\u80fd\u529b\u300f\u4f86\u7ba1\u7406\u5927\u578b\u6ce2\u6b21\u6575\u4eba\u3002\u4f8b\u5982\uff0c\u300e\u6cd5\u5e2b\u300f\u7684\u300e\u9023\u9396\u9583\u96fb\u300f\u53ef\u4ee5\u6467\u6bc0\u591a\u500b\u6575\u4eba\u3002\u9019\u7a2e\u91cd\u9ede\u78ba\u4fdd\u60a8\u80fd\u5920\u61c9\u5c0d\u5f8c\u671f\u904a\u6232\u6ce2\u6b21\u7684\u65e5\u76ca\u63d0\u5347\u7684\u96e3\u5ea6\u3002"}, {"question": "\u5728\u300a\u634d\u885b\u8005\u9592\u7f6e 2\u300b\u4e2d\uff0c\u70ba\u4ec0\u9ebc\u4e86\u89e3\u5347\u7d1a\u7cfb\u7d71\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u5728\u300a\u634d\u885b\u8005\u9592\u7f6e 2\u300b\u4e2d\uff0c\u4e86\u89e3\u5347\u7d1a\u7cfb\u7d71\u5c0d\u65bc\u6700\u5927\u5316\u6548\u7387\u548c\u529b\u91cf\u81f3\u95dc\u91cd\u8981\u3002\u6b65\u9a5f\u4e00\uff1a\u5b9a\u671f\u5347\u7d1a\u634d\u885b\u8005\u4ee5\u589e\u5f37\u5176\u8af8\u5982\u50b7\u5bb3\u548c\u5c04\u7a0b\u7b49\u5c6c\u6027\u3002\u6b65\u9a5f\u4e8c\uff1a\u5c08\u6ce8\u65bc\u63d0\u4f9b\u5168\u57df\u734e\u52f5\u7684\u7814\u7a76\u5347\u7d1a\uff0c\u4f8b\u5982\u589e\u52a0\u9ec3\u91d1\u6536\u5165\u3002\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u300e\u8072\u671b\u300f\u4f86\u91cd\u7f6e\u4e26\u7372\u5f97\u6c38\u4e45\u589e\u76ca\u3002\u4f8b\u5982\uff0c\u5347\u7d1a\u300e\u5f13\u7bad\u624b\u300f\u4ee5\u63d0\u9ad8\u5176\u653b\u64ca\u901f\u5ea6\uff0c\u53ef\u4ee5\u986f\u8457\u6539\u5584\u60a8\u7684\u9632\u79a6\u3002\u9019\u7a2e\u7406\u89e3\u78ba\u4fdd\u4e86\u6301\u7e8c\u7684\u9032\u5c55\u548c\u8cc7\u6e90\u512a\u5316\u3002"}, {"question": "\u81ea\u52d5\u6230\u9b25\u529f\u80fd\u5982\u4f55\u5728\u300a\u634d\u885b\u8005\u9592\u7f6e 2\u300b\u4e2d\u63d0\u5347\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u300a\u634d\u885b\u8005\u9592\u7f6e 2\u300b\u4e2d\u7684\u81ea\u52d5\u6230\u9b25\u529f\u80fd\u900f\u904e\u81ea\u52d5\u5316\u8cc7\u6e90\u7ba1\u7406\u548c\u634d\u885b\u8005\u884c\u52d5\u4f86\u63d0\u5347\u904a\u6232\u9ad4\u9a57\u3002\u6b65\u9a5f\u4e00\uff1a\u555f\u7528\u81ea\u52d5\u6230\u9b25\u4ee5\u81ea\u52d5\u653e\u7f6e\u548c\u5347\u7d1a\u634d\u885b\u8005\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u6b64\u529f\u80fd\u5c07\u91cd\u9ede\u653e\u5728\u6230\u7565\u6c7a\u7b56\u800c\u975e\u5fae\u89c0\u7ba1\u7406\u3002\u6b65\u9a5f\u4e09\uff1a\u8abf\u6574\u8a2d\u5b9a\u4ee5\u512a\u5148\u8003\u616e\u67d0\u4e9b\u5347\u7d1a\u6216\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u8a2d\u5b9a\u81ea\u52d5\u6230\u9b25\u4ee5\u5c08\u6ce8\u65bc\u300e\u72d9\u64ca\u624b\u300f\u5347\u7d1a\u53ef\u4ee5\u6700\u5927\u5316\u9060\u7a0b\u50b7\u5bb3\u3002\u6b64\u529f\u80fd\u78ba\u4fdd\u66f4\u9806\u66a2\u548c\u66f4\u9ad8\u6548\u7684\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u300a\u634d\u885b\u8005\u9592\u7f6e 2\u300b\u4e2d\u8cc7\u6e90\u7ba1\u7406\u7684\u6700\u4f73\u5be6\u52d9\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u300a\u634d\u885b\u8005\u9592\u7f6e 2\u300b\u4e2d\uff0c\u6709\u6548\u7684\u8cc7\u6e90\u7ba1\u7406\u9700\u8981\u6230\u7565\u898f\u5283\u548c\u512a\u5148\u9806\u5e8f\u3002\u6b65\u9a5f\u4e00\uff1a\u9996\u5148\u5c07\u8cc7\u6e90\u5206\u914d\u7d66\u7522\u751f\u6700\u5927\u5f71\u97ff\u7684\u634d\u885b\u8005\u5347\u7d1a\u3002\u6b65\u9a5f\u4e8c\uff1a\u5728\u5373\u6642\u5347\u7d1a\u548c\u9577\u671f\u7814\u7a76\u4e4b\u9593\u53d6\u5f97\u5e73\u8861\u3002\u6b65\u9a5f\u4e09\uff1a\u660e\u667a\u5730\u4f7f\u7528\u300e\u8072\u671b\u300f\u4f86\u7372\u5f97\u6c38\u4e45\u7684\u589e\u76ca\uff0c\u800c\u4e0d\u6703\u904e\u5ea6\u6d88\u8017\u8cc7\u6e90\u3002\u4f8b\u5982\uff0c\u6295\u8cc7\u65bc\u300e\u9ec3\u91d1\u6536\u5165\u300f\u7814\u7a76\u53ef\u4ee5\u63d0\u4f9b\u7a69\u5b9a\u7684\u8cc7\u6e90\u6d41\u3002\u9019\u4e9b\u5be6\u52d9\u78ba\u4fdd\u6301\u7e8c\u9032\u5c55\u548c\u8cc7\u6e90\u6709\u6548\u5229\u7528\u3002"}, {"question": "\u300a\u634d\u885b\u8005\u9592\u7f6e 2\u300b\u4e2d\u7684\u8072\u671b\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u300a\u634d\u885b\u8005\u9592\u7f6e 2\u300b\u4e2d\u7684\u8072\u671b\u7cfb\u7d71\u5141\u8a31\u73a9\u5bb6\u91cd\u7f6e\u9032\u5ea6\u4ee5\u7372\u5f97\u6c38\u4e45\u589e\u76ca\u3002\u6b65\u9a5f\u4e00\uff1a\u900f\u904e\u6ce2\u6b21\u9032\u5c55\u7d2f\u7a4d\u8db3\u5920\u7684\u300e\u8072\u671b\u9ede\u300f\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u9019\u4e9b\u9ede\u6578\u8cfc\u8cb7\u6c38\u4e45\u5347\u7d1a\uff0c\u589e\u5f37\u60a8\u7684\u634d\u885b\u8005\u80fd\u529b\u3002\u6b65\u9a5f\u4e09\uff1a\u7b56\u7565\u6027\u5730\u9078\u64c7\u8207\u60a8\u7684\u904a\u6232\u98a8\u683c\u4e00\u81f4\u7684\u5347\u7d1a\uff0c\u4f8b\u5982\u589e\u52a0\u50b7\u5bb3\u6216\u66f4\u5feb\u5730\u7522\u751f\u8cc7\u6e90\u3002\u4f8b\u5982\uff0c\u9078\u64c7\u300e\u653b\u64ca\u901f\u5ea6\u300f\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u60a8\u7684\u634d\u885b\u8005\u6548\u7387\u3002\u6b64\u7cfb\u7d71\u78ba\u4fdd\u4e86\u6301\u7e8c\u7684\u9032\u5c55\u548c\u529b\u91cf\u63d0\u5347\u3002"}, {"question": "\u300a\u634d\u885b\u8005\u9592\u7f6e 2\u300b\u4e2d\u634d\u885b\u8005\u985e\u578b\u4e4b\u9593\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "\u300a\u634d\u885b\u8005\u9592\u7f6e 2\u300b\u4e2d\u7684\u634d\u885b\u8005\u985e\u578b\u5728\u89d2\u8272\u548c\u6709\u6548\u6027\u65b9\u9762\u5dee\u7570\u5f88\u5927\u3002\u6b65\u9a5f\u4e00\uff1a\u300e\u5f13\u7bad\u624b\u300f\u9069\u5408\u9060\u7a0b\u50b7\u5bb3\uff0c\u800c\u300e\u9a0e\u58eb\u300f\u5247\u64c5\u9577\u8fd1\u6230\u3002\u6b65\u9a5f\u4e8c\uff1a\u300e\u6cd5\u5e2b\u300f\u63d0\u4f9b\u5340\u57df\u50b7\u5bb3\uff0c\u800c\u300e\u652f\u63f4\u300f\u634d\u885b\u8005\uff08\u4f8b\u5982\u300e\u6cbb\u7642\u5e2b\u300f\uff09\u5247\u7dad\u6301\u524d\u7dda\u3002\u6b65\u9a5f\u4e09\uff1a\u900f\u904e\u7b56\u7565\u6027\u5730\u653e\u7f6e\u4e0d\u540c\u985e\u578b\u4f86\u8986\u84cb\u5404\u7a2e\u6575\u4eba\u8def\u5f91\uff0c\u5e73\u8861\u60a8\u7684\u9632\u79a6\u3002\u4f8b\u5982\uff0c\u5c07\u300e\u6cd5\u5e2b\u300f\u653e\u7f6e\u5728\u9698\u53e3\u9644\u8fd1\u53ef\u4ee5\u6700\u5927\u5316\u5176\u5340\u57df\u50b7\u5bb3\u3002\u4e86\u89e3\u9019\u4e9b\u5dee\u7570\u78ba\u4fdd\u4e86\u5168\u9762\u7684\u9632\u79a6\u7b56\u7565\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u634d\u885b\u8005\u9592\u7f6e 2\u300b\u4e2d\u5c07\u9032\u5ea6\u5f9e\u4e00\u500b\u88dd\u7f6e\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u88dd\u7f6e\uff1f", "answer": "\u5728\u300a\u634d\u885b\u8005\u9592\u7f6e 2\u300b\u4e2d\uff0c\u8f49\u79fb\u9032\u5ea6\u6d89\u53ca\u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u3002\u6b65\u9a5f\u4e00\uff1a\u78ba\u4fdd\u60a8\u7684\u904a\u6232\u5df2\u9023\u7d50\u5230\u96f2\u7aef\u5e33\u6236\uff0c\u4f8b\u5982 Google Play \u6216 Game Center\u3002\u6b65\u9a5f\u4e8c\uff1a\u5728\u60a8\u7684\u65b0\u88dd\u7f6e\u4e0a\u767b\u5165\u540c\u4e00\u5e33\u6236\u4ee5\u5b58\u53d6\u60a8\u7684\u5132\u5b58\u9032\u5ea6\u3002\u6b65\u9a5f\u4e09\uff1a\u9a57\u8b49\u6240\u6709\u8cc7\u6599\uff0c\u5305\u62ec\u634d\u885b\u8005\u548c\u5347\u7d1a\uff0c\u5747\u5df2\u6b63\u78ba\u8f49\u79fb\u3002\u4f8b\u5982\uff0c\u5728\u65b0\u7684 Android \u88dd\u7f6e\u4e0a\u767b\u5165 Google Play \u61c9\u8a72\u53ef\u4ee5\u7121\u7e2b\u540c\u6b65\u60a8\u7684\u904a\u6232\u9032\u5ea6\u3002\u6b64\u904e\u7a0b\u78ba\u4fdd\u4e86\u4e0d\u540c\u88dd\u7f6e\u4e4b\u9593\u7684\u9023\u7e8c\u6027\u3002"}, {"question": "\u300a\u634d\u885b\u8005\u9592\u7f6e 2\u300b\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u6a5f\u5236\u6216\u5f69\u86cb\uff1f", "answer": "\u300a\u634d\u885b\u8005\u9592\u7f6e 2\u300b\u5305\u542b\u96b1\u85cf\u6a5f\u5236\u548c\u5f69\u86cb\uff0c\u4ee5\u63d0\u5347\u904a\u6232\u9ad4\u9a57\u3002\u6b65\u9a5f\u4e00\uff1a\u900f\u904e\u5b8c\u6210\u7279\u5b9a\u6311\u6230\u6216\u6210\u5c31\u4f86\u767c\u73fe\u79d8\u5bc6\u634d\u885b\u8005\u3002\u6b65\u9a5f\u4e8c\uff1a\u900f\u904e\u6eff\u8db3\u7279\u5b9a\u689d\u4ef6\uff08\u4f8b\u5982\u5728\u9650\u6642\u5167\u64ca\u6557\u9996\u9818\uff09\u4f86\u89e3\u9396\u96b1\u85cf\u95dc\u5361\u3002\u6b65\u9a5f\u4e09\uff1a\u63a2\u7d22\u904a\u6232\u4ee5\u5c0b\u627e\u63d0\u4f9b\u7368\u7279\u734e\u52f5\u7684\u7a00\u6709\u4e8b\u4ef6\u3002\u4f8b\u5982\uff0c\u627e\u5230\u300e\u9ec3\u91d1\u634d\u885b\u8005\u300f\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u60a8\u7684\u9632\u79a6\u3002\u9019\u4e9b\u96b1\u85cf\u5143\u7d20\u70ba\u904a\u6232\u589e\u6dfb\u6df1\u5ea6\u548c\u8da3\u5473\u3002"}]
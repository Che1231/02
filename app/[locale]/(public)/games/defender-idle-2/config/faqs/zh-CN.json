[{"question": "\u65b0\u624b\u5982\u4f55\u5728\u300a\u5b88\u536b\u7a7a\u95f22\u300b\u4e2d\u6709\u6548\u5165\u95e8\uff1f", "answer": "\u5728\u300a\u5b88\u536b\u7a7a\u95f22\u300b\u4e2d\u6709\u6548\u5165\u95e8\uff0c\u5173\u952e\u5728\u4e8e\u7406\u89e3\u6e38\u620f\u57fa\u672c\u673a\u5236\u3002\u6b65\u9aa4\u4e00\uff1a\u5c06\u521d\u59cb\u9632\u5fa1\u5355\u4f4d\u653e\u7f6e\u5728\u6218\u7565\u4f4d\u7f6e\uff0c\u8986\u76d6\u591a\u6761\u8def\u5f84\u3002\u6b65\u9aa4\u4e8c\uff1a\u5b9a\u671f\u5347\u7ea7\u9632\u5fa1\u5355\u4f4d\uff0c\u63d0\u5347\u5176\u4f24\u5bb3\u548c\u653b\u51fb\u8303\u56f4\u3002\u6b65\u9aa4\u4e09\uff1a\u6709\u6548\u5229\u7528\"\u81ea\u52a8\u6218\u6597\"\u529f\u80fd\uff0c\u9ad8\u6548\u7ba1\u7406\u8d44\u6e90\u3002\u4f8b\u5982\uff0c\u5c06\"\u72d9\u51fb\u624b\"\u653e\u7f6e\u5728\u62d0\u89d2\u5904\uff0c\u53ef\u6700\u5927\u5316\u5176\u5c04\u7a0b\u3002\u8fd9\u79cd\u65b9\u6cd5\u786e\u4fdd\u4e86\u5e73\u8861\u7684\u5f00\u59cb\u548c\u6e10\u8fdb\u7684\u63d0\u5347\u3002"}, {"question": "\u300a\u5b88\u536b\u7a7a\u95f22\u300b\u4e2d\u671f\u53d1\u5c55\u7684\u4e3b\u8981\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u5b88\u536b\u7a7a\u95f22\u300b\u4e2d\u671f\u53d1\u5c55\u9700\u8981\u7ed3\u5408\u6218\u7565\u90e8\u7f72\u548c\u8d44\u6e90\u7ba1\u7406\u3002\u6b65\u9aa4\u4e00\uff1a\u4f18\u5148\u5347\u7ea7\u6700\u6709\u6548\u7684\u9632\u5fa1\u5355\u4f4d\uff0c\u4f8b\u5982\"\u70ae\u5854\"\uff0c\u4ee5\u83b7\u5f97\u533a\u57df\u4f24\u5bb3\u3002\u6b65\u9aa4\u4e8c\uff1a\u6295\u5165\u7814\u7a76\u5347\u7ea7\uff0c\u63d0\u5347\u6574\u4f53\u6548\u7387\u3002\u6b65\u9aa4\u4e09\uff1a\u5728\u8270\u96be\u7684\u6ce2\u6b21\u4e2d\u8c28\u614e\u4f7f\u7528\"\u7279\u6b8a\u6280\u80fd\"\u3002\u4f8b\u5982\uff0c\u6fc0\u6d3b\"\u5bc6\u96c6\u70ae\u706b\"\u53ef\u4ee5\u5feb\u901f\u6e05\u9664\u805a\u96c6\u7684\u654c\u4eba\u3002\u6b64\u7b56\u7565\u786e\u4fdd\u6301\u7eed\u8fdb\u6b65\u548c\u8d44\u6e90\u4f18\u5316\u3002"}, {"question": "\u300a\u5b88\u536b\u7a7a\u95f22\u300b\u540e\u671f\u5e94\u8be5\u91cd\u70b9\u57f9\u517b\u54ea\u4e9b\u9632\u5fa1\u5355\u4f4d\uff1f", "answer": "\u5728\u300a\u5b88\u536b\u7a7a\u95f22\u300b\u540e\u671f\uff0c\u91cd\u70b9\u57f9\u517b\u9ad8\u4f24\u5bb3\u548c\u533a\u57df\u6548\u679c\u7684\u9632\u5fa1\u5355\u4f4d\u3002\u6b65\u9aa4\u4e00\uff1a\u6700\u5927\u5316\u5347\u7ea7\"\u6cd5\u5e08\"\u548c\"\u8f70\u70b8\u673a\"\u7b49\u9632\u5fa1\u5355\u4f4d\uff0c\u4ee5\u83b7\u5f97\u66f4\u9ad8\u7684\u4f24\u5bb3\u8f93\u51fa\u3002\u6b65\u9aa4\u4e8c\uff1a\u7528\"\u8f85\u52a9\"\u9632\u5fa1\u5355\u4f4d\uff0c\u4f8b\u5982\"\u6cbb\u7597\u5e08\"\uff0c\u6765\u5e73\u8861\u9632\u5fa1\uff0c\u7ef4\u6301\u524d\u7ebf\u7684\u751f\u5b58\u80fd\u529b\u3002\u6b65\u9aa4\u4e09\uff1a\u6218\u7565\u6027\u5730\u4f7f\u7528\"\u7ec8\u6781\u6280\u80fd\"\u6765\u5e94\u5bf9\u6700\u7ec8\u6ce2\u6b21\u7684\u654c\u4eba\u3002\u4f8b\u5982\uff0c\"\u6cd5\u5e08\"\u7684\"\u8fde\u9501\u95ea\u7535\"\u53ef\u4ee5\u6bc1\u706d\u591a\u4e2a\u654c\u4eba\u3002\u8fd9\u79cd\u91cd\u70b9\u5173\u6ce8\u786e\u4fdd\u4f60\u53ef\u4ee5\u5e94\u5bf9\u540e\u671f\u6ce2\u6b21\u7684\u65e5\u76ca\u589e\u52a0\u7684\u96be\u5ea6\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u7406\u89e3\u300a\u5b88\u536b\u7a7a\u95f22\u300b\u7684\u5347\u7ea7\u7cfb\u7edf\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u7406\u89e3\u300a\u5b88\u536b\u7a7a\u95f22\u300b\u7684\u5347\u7ea7\u7cfb\u7edf\u5bf9\u4e8e\u6700\u5927\u5316\u6548\u7387\u548c\u529b\u91cf\u81f3\u5173\u91cd\u8981\u3002\u6b65\u9aa4\u4e00\uff1a\u5b9a\u671f\u5347\u7ea7\u9632\u5fa1\u5355\u4f4d\uff0c\u4ee5\u63d0\u5347\u5176\u5c5e\u6027\uff0c\u4f8b\u5982\u4f24\u5bb3\u548c\u5c04\u7a0b\u3002\u6b65\u9aa4\u4e8c\uff1a\u4e13\u6ce8\u4e8e\u7814\u7a76\u5347\u7ea7\uff0c\u83b7\u5f97\u5168\u5c40\u52a0\u6210\uff0c\u4f8b\u5982\u589e\u52a0\u91d1\u5e01\u6536\u5165\u3002\u6b65\u9aa4\u4e09\uff1a\u5229\u7528\"\u58f0\u671b\"\u6765\u91cd\u7f6e\u5e76\u83b7\u5f97\u6c38\u4e45\u63d0\u5347\u3002\u4f8b\u5982\uff0c\u5347\u7ea7\"\u5f13\u7bad\u624b\"\u4ee5\u589e\u52a0\u5176\u653b\u51fb\u901f\u5ea6\uff0c\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u9632\u5fa1\u529b\u3002\u8fd9\u79cd\u7406\u89e3\u786e\u4fdd\u6301\u7eed\u8fdb\u6b65\u548c\u8d44\u6e90\u4f18\u5316\u3002"}, {"question": "\u81ea\u52a8\u6218\u6597\u529f\u80fd\u5982\u4f55\u589e\u5f3a\u300a\u5b88\u536b\u7a7a\u95f22\u300b\u7684\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u300a\u5b88\u536b\u7a7a\u95f22\u300b\u7684\u81ea\u52a8\u6218\u6597\u529f\u80fd\u901a\u8fc7\u81ea\u52a8\u5316\u8d44\u6e90\u7ba1\u7406\u548c\u9632\u5fa1\u5355\u4f4d\u884c\u52a8\u6765\u589e\u5f3a\u6e38\u620f\u4f53\u9a8c\u3002\u6b65\u9aa4\u4e00\uff1a\u542f\u7528\u81ea\u52a8\u6218\u6597\uff0c\u81ea\u52a8\u653e\u7f6e\u548c\u5347\u7ea7\u9632\u5fa1\u5355\u4f4d\u3002\u6b65\u9aa4\u4e8c\uff1a\u5229\u7528\u6b64\u529f\u80fd\u4e13\u6ce8\u4e8e\u6218\u7565\u51b3\u7b56\uff0c\u800c\u975e\u5fae\u89c2\u7ba1\u7406\u3002\u6b65\u9aa4\u4e09\uff1a\u8c03\u6574\u8bbe\u7f6e\uff0c\u4f18\u5148\u8003\u8651\u67d0\u4e9b\u5347\u7ea7\u6216\u6280\u80fd\u3002\u4f8b\u5982\uff0c\u8bbe\u7f6e\u81ea\u52a8\u6218\u6597\u4ee5\u4e13\u6ce8\u4e8e\"\u72d9\u51fb\u624b\"\u5347\u7ea7\uff0c\u53ef\u4ee5\u6700\u5927\u5316\u8fdc\u7a0b\u4f24\u5bb3\u3002\u6b64\u529f\u80fd\u786e\u4fdd\u66f4\u6d41\u7545\u3001\u66f4\u9ad8\u6548\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u300a\u5b88\u536b\u7a7a\u95f22\u300b\u4e2d\u6709\u6548\u7684\u8d44\u6e90\u7ba1\u7406\u6700\u4f73\u5b9e\u8df5\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u5b88\u536b\u7a7a\u95f22\u300b\u4e2d\u6709\u6548\u7684\u8d44\u6e90\u7ba1\u7406\u9700\u8981\u6218\u7565\u89c4\u5212\u548c\u4f18\u5148\u7ea7\u6392\u5e8f\u3002\u6b65\u9aa4\u4e00\uff1a\u9996\u5148\u5c06\u8d44\u6e90\u5206\u914d\u7ed9\u5bf9\u63d0\u5347\u5f71\u54cd\u6700\u5927\u7684\u9632\u5fa1\u5355\u4f4d\u8fdb\u884c\u5347\u7ea7\u3002\u6b65\u9aa4\u4e8c\uff1a\u5728\u5373\u65f6\u5347\u7ea7\u548c\u957f\u671f\u7814\u7a76\u4e4b\u95f4\u53d6\u5f97\u5e73\u8861\u3002\u6b65\u9aa4\u4e09\uff1a\u660e\u667a\u5730\u4f7f\u7528\"\u58f0\u671b\"\u6765\u83b7\u5f97\u6c38\u4e45\u63d0\u5347\uff0c\u800c\u4e0d\u4f1a\u8fc7\u5ea6\u6d88\u8017\u8d44\u6e90\u3002\u4f8b\u5982\uff0c\u6295\u8d44\u4e8e\"\u91d1\u5e01\u6536\u5165\"\u7814\u7a76\u53ef\u4ee5\u63d0\u4f9b\u7a33\u5b9a\u7684\u8d44\u6e90\u6d41\u3002\u8fd9\u4e9b\u5b9e\u8df5\u786e\u4fdd\u6301\u7eed\u8fdb\u6b65\u548c\u9ad8\u6548\u7684\u8d44\u6e90\u5229\u7528\u3002"}, {"question": "\u300a\u5b88\u536b\u7a7a\u95f22\u300b\u4e2d\u7684\u58f0\u671b\u7cfb\u7edf\u5982\u4f55\u8fd0\u4f5c\uff1f", "answer": "\u300a\u5b88\u536b\u7a7a\u95f22\u300b\u7684\u58f0\u671b\u7cfb\u7edf\u5141\u8bb8\u73a9\u5bb6\u91cd\u7f6e\u6e38\u620f\u8fdb\u5ea6\u4ee5\u83b7\u5f97\u6c38\u4e45\u63d0\u5347\u3002\u6b65\u9aa4\u4e00\uff1a\u901a\u8fc7\u5b8c\u6210\u6ce2\u6b21\u79ef\u7d2f\u8db3\u591f\u7684\"\u58f0\u671b\u70b9\u6570\"\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u8fd9\u4e9b\u70b9\u6570\u8d2d\u4e70\u6c38\u4e45\u5347\u7ea7\uff0c\u589e\u5f3a\u9632\u5fa1\u5355\u4f4d\u7684\u80fd\u529b\u3002\u6b65\u9aa4\u4e09\uff1a\u6218\u7565\u6027\u5730\u9009\u62e9\u4e0e\u4f60\u7684\u6e38\u620f\u98ce\u683c\u4e00\u81f4\u7684\u5347\u7ea7\uff0c\u4f8b\u5982\u589e\u52a0\u4f24\u5bb3\u6216\u52a0\u901f\u8d44\u6e90\u751f\u6210\u3002\u4f8b\u5982\uff0c\u9009\u62e9\"\u653b\u51fb\u901f\u5ea6\"\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u9632\u5fa1\u5355\u4f4d\u7684\u6548\u7387\u3002\u6b64\u7cfb\u7edf\u786e\u4fdd\u6301\u7eed\u8fdb\u6b65\u548c\u5b9e\u529b\u63d0\u5347\u3002"}, {"question": "\u300a\u5b88\u536b\u7a7a\u95f22\u300b\u4e2d\u4e0d\u540c\u9632\u5fa1\u5355\u4f4d\u7c7b\u578b\u4e4b\u95f4\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u300a\u5b88\u536b\u7a7a\u95f22\u300b\u4e2d\u4e0d\u540c\u9632\u5fa1\u5355\u4f4d\u7c7b\u578b\u5728\u4f5c\u7528\u548c\u6709\u6548\u6027\u65b9\u9762\u5dee\u5f02\u5f88\u5927\u3002\u6b65\u9aa4\u4e00\uff1a\"\u5f13\u7bad\u624b\"\u64c5\u957f\u8fdc\u7a0b\u4f24\u5bb3\uff0c\u800c\"\u9a91\u58eb\"\u64c5\u957f\u8fd1\u8ddd\u79bb\u6218\u6597\u3002\u6b65\u9aa4\u4e8c\uff1a\"\u6cd5\u5e08\"\u63d0\u4f9b\u533a\u57df\u4f24\u5bb3\uff0c\u800c\"\u8f85\u52a9\"\u9632\u5fa1\u5355\u4f4d\uff08\u4f8b\u5982\"\u6cbb\u7597\u5e08\"\uff09\u80fd\u591f\u7ef4\u6301\u524d\u7ebf\u7684\u751f\u5b58\u80fd\u529b\u3002\u6b65\u9aa4\u4e09\uff1a\u901a\u8fc7\u6218\u7565\u6027\u5730\u90e8\u7f72\u4e0d\u540c\u7c7b\u578b\u7684\u5355\u4f4d\u6765\u8986\u76d6\u5404\u79cd\u654c\u4eba\u7684\u8def\u5f84\uff0c\u4ece\u800c\u5e73\u8861\u9632\u5fa1\u3002\u4f8b\u5982\uff0c\u5c06\"\u6cd5\u5e08\"\u653e\u7f6e\u5728\u9698\u53e3\u9644\u8fd1\u53ef\u4ee5\u6700\u5927\u5316\u5176\u533a\u57df\u4f24\u5bb3\u3002\u4e86\u89e3\u8fd9\u4e9b\u5dee\u5f02\u6709\u52a9\u4e8e\u786e\u4fdd\u5b8c\u5584\u7684\u9632\u5fa1\u7b56\u7565\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u5b88\u536b\u7a7a\u95f22\u300b\u4e2d\u5c06\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u8bbe\u5907\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u8bbe\u5907\uff1f", "answer": "\u5728\u300a\u5b88\u536b\u7a7a\u95f22\u300b\u4e2d\u8f6c\u79fb\u8fdb\u5ea6\u6d89\u53ca\u4f7f\u7528\u4e91\u7aef\u4fdd\u5b58\u529f\u80fd\u3002\u6b65\u9aa4\u4e00\uff1a\u786e\u4fdd\u4f60\u7684\u6e38\u620f\u8fde\u63a5\u5230\u4e91\u7aef\u8d26\u6237\uff0c\u4f8b\u5982 Google Play \u6216 Game Center\u3002\u6b65\u9aa4\u4e8c\uff1a\u5728\u65b0\u7684\u8bbe\u5907\u4e0a\u767b\u5f55\u540c\u4e00\u8d26\u6237\u4ee5\u8bbf\u95ee\u4f60\u7684\u4fdd\u5b58\u8fdb\u5ea6\u3002\u6b65\u9aa4\u4e09\uff1a\u9a8c\u8bc1\u6240\u6709\u6570\u636e\uff08\u5305\u62ec\u9632\u5fa1\u5355\u4f4d\u548c\u5347\u7ea7\uff09\u5df2\u6b63\u786e\u8f6c\u79fb\u3002\u4f8b\u5982\uff0c\u5728\u65b0\u7684 Android \u8bbe\u5907\u4e0a\u767b\u5f55 Google Play \u5e94\u8be5\u53ef\u4ee5\u65e0\u7f1d\u540c\u6b65\u4f60\u7684\u6e38\u620f\u8fdb\u5ea6\u3002\u8be5\u8fc7\u7a0b\u53ef\u786e\u4fdd\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u4fdd\u6301\u6e38\u620f\u8fde\u7eed\u6027\u3002"}, {"question": "\u300a\u5b88\u536b\u7a7a\u95f22\u300b\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u673a\u5236\u6216\u5f69\u86cb\uff1f", "answer": "\u300a\u5b88\u536b\u7a7a\u95f22\u300b\u5305\u542b\u9690\u85cf\u7684\u673a\u5236\u548c\u5f69\u86cb\uff0c\u589e\u5f3a\u4e86\u6e38\u620f\u4f53\u9a8c\u3002\u6b65\u9aa4\u4e00\uff1a\u901a\u8fc7\u5b8c\u6210\u7279\u5b9a\u6311\u6218\u6216\u6210\u5c31\u6765\u53d1\u73b0\u9690\u85cf\u7684\u9632\u5fa1\u5355\u4f4d\u3002\u6b65\u9aa4\u4e8c\uff1a\u901a\u8fc7\u6ee1\u8db3\u7279\u5b9a\u6761\u4ef6\uff0c\u4f8b\u5982\u5728\u9650\u5b9a\u65f6\u95f4\u5185\u51fb\u8d25\u6700\u7ec8\u6ce2\u6b21\u7684\u654c\u4eba\uff0c\u89e3\u9501\u9690\u85cf\u5173\u5361\u3002\u6b65\u9aa4\u4e09\uff1a\u63a2\u7d22\u6e38\u620f\uff0c\u5bfb\u627e\u63d0\u4f9b\u72ec\u7279\u5956\u52b1\u7684\u7a00\u6709\u4e8b\u4ef6\u3002\u4f8b\u5982\uff0c\u627e\u5230\"\u9ec4\u91d1\u9632\u5fa1\u5355\u4f4d\"\u53ef\u4ee5\u4e3a\u4f60\u7684\u9632\u5fa1\u5e26\u6765\u663e\u8457\u63d0\u5347\u3002\u8fd9\u4e9b\u9690\u85cf\u5143\u7d20\u4e3a\u6e38\u620f\u589e\u6dfb\u4e86\u6df1\u5ea6\u548c\u8da3\u5473\u3002"}]
[{"question": "\ucd08\uc2ec\uc790\uac00 \ub514\ud39c\ub354 \uc544\uc774\ub4e4 2\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc2dc\uc791\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub514\ud39c\ub354 \uc544\uc774\ub4e4 2\uc5d0\uc11c \ud6a8\uacfc\uc801\uc73c\ub85c \uc2dc\uc791\ud558\ub824\uba74 \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. STEP1: \ucc98\uc74c \ubc30\uce58\ud558\ub294 \uc218\ud638\uc790\ub4e4\uc744 \uc5ec\ub7ec \uacbd\ub85c\ub97c \ucee4\ubc84\ud560 \uc218 \uc788\ub3c4\ub85d \uc804\ub7b5\uc801\uc778 \uc704\uce58\uc5d0 \ubc30\uce58\ud558\uc138\uc694. STEP2: \uc218\ud638\uc790\ub97c \uc815\uae30\uc801\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc5ec \ub370\ubbf8\uc9c0\uc640 \uc0ac\uc815\uac70\ub9ac\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\uc138\uc694. STEP3: '\uc790\ub3d9 \uc804\ud22c' \uae30\ub2a5\uc744 \ud65c\uc6a9\ud558\uc5ec \uc790\uc6d0\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uc2a4\ub098\uc774\ud37c'\ub97c \ucf54\ub108 \uadfc\ucc98\uc5d0 \ubc30\uce58\ud558\uba74 \uc0ac\uc815\uac70\ub9ac\ub97c \uadf9\ub300\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc811\uadfc \ubc29\uc2dd\uc740 \uade0\ud615 \uc7a1\ud78c \uc2dc\uc791\uacfc \uc810\uc9c4\uc801\uc778 \uc9c4\ud589\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "\ub514\ud39c\ub354 \uc544\uc774\ub4e4 2\uc758 \uc911\ubc18 \uac8c\uc784 \uc9c4\ud589\uc744 \uc704\ud55c \uc8fc\uc694 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub514\ud39c\ub354 \uc544\uc774\ub4e4 2\uc758 \uc911\ubc18 \uac8c\uc784 \uc9c4\ud589\uc740 \uc804\ub7b5\uc801\uc778 \ubc30\uce58\uc640 \uc790\uc6d0 \uad00\ub9ac\uc758 \uc870\ud654\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \uc9c0\uc5ed \ub370\ubbf8\uc9c0\uc778 '\ub300\ud3ec'\uc640 \uac19\uc740 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \uc218\ud638\uc790\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc138\uc694. STEP2: \uc804\ubc18\uc801\uc778 \ud6a8\uc728\uc131\uc744 \ub192\uc774\uae30 \uc704\ud574 \uc5f0\uad6c \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0 \ud22c\uc790\ud558\uc138\uc694. STEP3: \uc5b4\ub824\uc6b4 \uc6e8\uc774\ube0c \ub3d9\uc548 '\ud2b9\uc218 \ub2a5\ub825'\uc744 \uc801\uc808\ud558\uac8c \uc0ac\uc6a9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4 '\ud3ec\uaca9'\uc744 \ud65c\uc131\ud654\ud558\uba74 \uc9d1\uc911\ub41c \uc801\uc744 \ube60\ub974\uac8c \uc81c\uac70\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc804\ub7b5\uc740 \uc9c0\uc18d\uc801\uc778 \uc9c4\ud589\uacfc \uc790\uc6d0 \ucd5c\uc801\ud654\ub97c \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "\ub514\ud39c\ub354 \uc544\uc774\ub4e4 2\uc758 \ud6c4\ubc18 \uac8c\uc784\uc5d0\uc11c \uc5b4\ub5a4 \uc218\ud638\uc790\uc5d0 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\ub514\ud39c\ub354 \uc544\uc774\ub4e4 2\uc758 \ud6c4\ubc18 \uac8c\uc784\uc5d0\uc11c\ub294 \ub192\uc740 \ud53c\ud574\ub7c9\uacfc \uc9c0\uc5ed \ud6a8\uacfc \uc218\ud638\uc790\uc5d0 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. STEP1: \uc6b0\uc218\ud55c \ud53c\ud574\ub7c9\uc744 \uc9c0\ub2cc '\ub9c8\ubc95\uc0ac'\uc640 '\ud3ed\ud0c4 \ud22c\ucc99\uc790' \uc218\ud638\uc790\uc758 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uadf9\ub300\ud654\ud558\uc138\uc694. STEP2: \uc804\ubc29 \ub77c\uc778\uc744 \uc720\uc9c0\ud558\uae30 \uc704\ud574 '\ud790\ub7ec'\uc640 \uac19\uc740 '\uc9c0\uc6d0' \uc218\ud638\uc790\ub85c \ubc29\uc5b4\ub97c \uade0\ud615 \uc788\uac8c \uc720\uc9c0\ud558\uc138\uc694. STEP3: \ubcf4\uc2a4 \uc6e8\uc774\ube0c\ub97c \uad00\ub9ac\ud558\uae30 \uc704\ud574 '\uad81\uadf9\uc801\uc778 \ub2a5\ub825'\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\ub9c8\ubc95\uc0ac'\uc758 '\uc5f0\uc1c4 \ubc88\uac1c'\ub294 \uc5ec\ub7ec \uc801\uc744 \ud30c\uad34\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ucd08\uc810\uc740 \ud6c4\ubc18 \uac8c\uc784 \uc6e8\uc774\ube0c\uc758 \uc99d\uac00\ud558\ub294 \ub09c\uc774\ub3c4\ub97c \ucc98\ub9ac\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4."}, {"question": "\ub514\ud39c\ub354 \uc544\uc774\ub4e4 2\uc5d0\uc11c \uc5c5\uadf8\ub808\uc774\ub4dc \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub514\ud39c\ub354 \uc544\uc774\ub4e4 2\uc5d0\uc11c \uc5c5\uadf8\ub808\uc774\ub4dc \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \ud6a8\uc728\uc131\uacfc \uac15\ub825\ud568\uc744 \uadf9\ub300\ud654\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. STEP1: \uc218\ud638\uc790\uc758 \uc2a4\ud15f(\ub370\ubbf8\uc9c0, \uc0ac\uc815\uac70\ub9ac \ub4f1)\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uae30 \uc704\ud574 \uc8fc\uae30\uc801\uc73c\ub85c \uc218\ud638\uc790\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc138\uc694. STEP2: \uace8\ub4dc \uc218\uc785 \uc99d\uac00\uc640 \uac19\uc740 \uc804\uc5ed \ubcf4\ub108\uc2a4\ub97c \uc81c\uacf5\ud558\ub294 \uc5f0\uad6c \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0 \uc9d1\uc911\ud558\uc138\uc694. STEP3: '\uba85\uc131'\uc744 \ud65c\uc6a9\ud558\uc5ec \ub9ac\uc14b\ud558\uace0 \uc601\uad6c\uc801\uc778 \ubd80\uc2a4\ud2b8\ub97c \uc5bb\uc73c\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uad81\uc218'\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc5ec \uacf5\uaca9 \uc18d\ub3c4\ub97c \ub192\uc774\uba74 \ubc29\uc5b4\ub825\uc774 \ud06c\uac8c \ud5a5\uc0c1\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc774\ud574\ub294 \uc9c0\uc18d\uc801\uc778 \uc9c4\ud589\uacfc \uc790\uc6d0 \ucd5c\uc801\ud654\ub97c \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "\uc790\ub3d9 \uc804\ud22c \uae30\ub2a5\uc740 \ub514\ud39c\ub354 \uc544\uc774\ub4e4 2\uc758 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0a4\ub098\uc694?", "answer": "\ub514\ud39c\ub354 \uc544\uc774\ub4e4 2\uc758 \uc790\ub3d9 \uc804\ud22c \uae30\ub2a5\uc740 \uc790\uc6d0 \uad00\ub9ac\uc640 \uc218\ud638\uc790 \ud589\ub3d9\uc744 \uc790\ub3d9\ud654\ud558\uc5ec \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4. STEP1: \uc218\ud638\uc790\ub97c \uc790\ub3d9\uc73c\ub85c \ubc30\uce58\ud558\uace0 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uae30 \uc704\ud574 \uc790\ub3d9 \uc804\ud22c\ub97c \ud65c\uc131\ud654\ud558\uc138\uc694. STEP2: \uc774 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ubbf8\uc138 \uc870\uc815 \ub300\uc2e0 \uc804\ub7b5\uc801\uc778 \uacb0\uc815\uc5d0 \uc9d1\uc911\ud558\uc138\uc694. STEP3: \ud2b9\uc815 \uc5c5\uadf8\ub808\uc774\ub4dc \ub610\ub294 \ub2a5\ub825\uc5d0 \uc6b0\uc120\uc21c\uc704\ub97c \uc9c0\uc815\ud558\ub3c4\ub85d \uc124\uc815\uc744 \uc870\uc815\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc790\ub3d9 \uc804\ud22c\ub97c '\uc2a4\ub098\uc774\ud37c' \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0 \uc9d1\uc911\ud558\ub3c4\ub85d \uc124\uc815\ud558\uba74 \uc7a5\uac70\ub9ac \ub370\ubbf8\uc9c0\ub97c \uadf9\ub300\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uae30\ub2a5\uc740 \ub354 \ubd80\ub4dc\ub7fd\uace0 \ud6a8\uc728\uc801\uc778 \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "\ub514\ud39c\ub354 \uc544\uc774\ub4e4 2\uc5d0\uc11c \uc790\uc6d0 \uad00\ub9ac\ub97c \uc704\ud55c \ucd5c\uace0\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub514\ud39c\ub354 \uc544\uc774\ub4e4 2\uc5d0\uc11c \ud6a8\uacfc\uc801\uc778 \uc790\uc6d0 \uad00\ub9ac\uc5d0\ub294 \uc804\ub7b5\uc801\uc778 \uacc4\ud68d\uacfc \uc6b0\uc120\uc21c\uc704 \uc9c0\uc815\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \uac00\uc7a5 \ud070 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc218\ud638\uc790\ub97c \uba3c\uc800 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \ub370 \uc790\uc6d0\uc744 \ud560\ub2f9\ud558\uc138\uc694. STEP2: \uc989\uac01\uc801\uc778 \uc5c5\uadf8\ub808\uc774\ub4dc\uc640 \uc7a5\uae30\uc801\uc778 \uc5f0\uad6c \uc0ac\uc774\uc758 \uc9c0\ucd9c\uc744 \uade0\ud615 \uc788\uac8c \uc720\uc9c0\ud558\uc138\uc694. STEP3: '\uba85\uc131'\uc744 \ud604\uba85\ud558\uac8c \uc0ac\uc6a9\ud558\uc5ec \uc790\uc6d0\uc744 \uacfc\ub3c4\ud558\uac8c \uc18c\ubaa8\ud558\uc9c0 \uc54a\uace0 \uc601\uad6c\uc801\uc778 \ubd80\uc2a4\ud2b8\ub97c \uc5bb\uc73c\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uace8\ub4dc \uc218\uc785' \uc5f0\uad6c\uc5d0 \ud22c\uc790\ud558\uba74 \uc9c0\uc18d\uc801\uc778 \uc790\uc6d0 \uc720\uc785\uc744 \uc81c\uacf5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uad00\ud589\uc740 \uc9c0\uc18d\uc801\uc778 \uc9c4\ud589\uacfc \ud6a8\uc728\uc801\uc778 \uc790\uc6d0 \ud65c\uc6a9\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "\ub514\ud39c\ub354 \uc544\uc774\ub4e4 2\uc5d0\uc11c \uba85\uc131 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "\ub514\ud39c\ub354 \uc544\uc774\ub4e4 2\uc758 \uba85\uc131 \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc7ac\uc124\uc815\ud558\uc5ec \uc601\uad6c\uc801\uc778 \ubd80\uc2a4\ud2b8\ub97c \uc5bb\uc744 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. STEP1: \uc6e8\uc774\ube0c\ub97c \ud1b5\ud574 \ucda9\ubd84\ud55c '\uba85\uc131 \ud3ec\uc778\ud2b8'\ub97c \ucd95\uc801\ud558\uc138\uc694. STEP2: \uc774 \ud3ec\uc778\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc218\ud638\uc790\uc758 \ub2a5\ub825\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \uc601\uad6c\uc801\uc778 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uad6c\ub9e4\ud558\uc138\uc694. STEP3: \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\ucdb0 \ub370\ubbf8\uc9c0 \uc99d\uac00 \ub610\ub294 \uc790\uc6d0 \uc0dd\uc131 \uc18d\ub3c4 \uc99d\uac00\uc640 \uac19\uc740 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc804\ub7b5\uc801\uc73c\ub85c \uc120\ud0dd\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uacf5\uaca9 \uc18d\ub3c4'\ub97c \uc120\ud0dd\ud558\uba74 \uc218\ud638\uc790\uc758 \ud6a8\uc728\uc131\uc774 \ud06c\uac8c \ud5a5\uc0c1\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \uc9c0\uc18d\uc801\uc778 \uc9c4\ud589\uacfc \ud30c\uc6cc \uc2a4\ucf00\uc77c\ub9c1\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "\ub514\ud39c\ub354 \uc544\uc774\ub4e4 2\uc5d0\uc11c \uc218\ud638\uc790 \uc720\ud615 \uac04\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub514\ud39c\ub354 \uc544\uc774\ub4e4 2\uc758 \uc218\ud638\uc790 \uc720\ud615\uc740 \uc5ed\ud560\uacfc \ud6a8\uacfc\uac00 \ud06c\uac8c \ub2e4\ub985\ub2c8\ub2e4. STEP1: '\uad81\uc218'\ub294 \uc7a5\uac70\ub9ac \ud53c\ud574\uc5d0 \ud6a8\uacfc\uc801\uc774\uace0, '\uae30\uc0ac'\ub294 \uadfc\uc811 \uc804\ud22c\uc5d0\uc11c \ub6f0\uc5b4\ub0a9\ub2c8\ub2e4. STEP2: '\ub9c8\ubc95\uc0ac'\ub294 \uc9c0\uc5ed \ud53c\ud574\ub97c \uc81c\uacf5\ud558\uace0, '\ud790\ub7ec'\uc640 \uac19\uc740 '\uc9c0\uc6d0' \uc218\ud638\uc790\ub294 \uc804\ubc29 \ub77c\uc778\uc744 \uc720\uc9c0\ud569\ub2c8\ub2e4. STEP3: \ub2e4\uc591\ud55c \uc801\uc758 \uacbd\ub85c\ub97c \ucee4\ubc84\ud558\uae30 \uc704\ud574 \uc804\ub7b5\uc801\uc73c\ub85c \uc11c\ub85c \ub2e4\ub978 \uc720\ud615\uc744 \ubc30\uce58\ud558\uc5ec \ubc29\uc5b4\ub97c \uade0\ud615 \uc788\uac8c \uc720\uc9c0\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uad50\ucc28 \uc9c0\uc810' \uadfc\ucc98\uc5d0 '\ub9c8\ubc95\uc0ac'\ub97c \ubc30\uce58\ud558\uba74 \uc9c0\uc5ed \ud53c\ud574\ub97c \uadf9\ub300\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ucc28\uc774\uc810\uc744 \uc774\ud574\ud558\uba74 \uc798 \uac16\ucdb0\uc9c4 \ubc29\uc5b4 \uc804\ub7b5\uc744 \uc138\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub514\ud39c\ub354 \uc544\uc774\ub4e4 2\uc5d0\uc11c \ud55c \uae30\uae30\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub514\ud39c\ub354 \uc544\uc774\ub4e4 2\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub824\uba74 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. STEP1: Google Play \ub610\ub294 Game Center\uc640 \uac19\uc740 \ud074\ub77c\uc6b0\ub4dc \uacc4\uc815\uc5d0 \uac8c\uc784\uc744 \uc5f0\uacb0\ud558\uc138\uc694. STEP2: \uc0c8 \uae30\uae30\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uc5ec \uc800\uc7a5\ub41c \uc9c4\ud589 \uc0c1\ud669\uc5d0 \uc561\uc138\uc2a4\ud558\uc138\uc694. STEP3: \uc218\ud638\uc790\uc640 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \ud3ec\ud568\ud55c \ubaa8\ub4e0 \ub370\uc774\ud130\uac00 \uc62c\ubc14\ub974\uac8c \uc804\uc1a1\ub418\uc5c8\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc0c8\ub85c\uc6b4 \uc548\ub4dc\ub85c\uc774\ub4dc \uae30\uae30\uc5d0\uc11c Google Play\uc5d0 \ub85c\uadf8\uc778\ud558\uba74 \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc6d0\ud65c\ud558\uac8c \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. \uc774 \ud504\ub85c\uc138\uc2a4\ub97c \ud1b5\ud574 \ub2e4\ub978 \uae30\uae30\uc5d0\uc11c\ub3c4 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc774\uc5b4\uc9d1\ub2c8\ub2e4."}, {"question": "\ub514\ud39c\ub354 \uc544\uc774\ub4e4 2\uc5d0\ub294 \uc228\uaca8\uc9c4 \uba54\ucee4\ub2c8\uc998\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc5b4\ub514\uc5d0 \uc788\ub098\uc694?", "answer": "\ub514\ud39c\ub354 \uc544\uc774\ub4e4 2\uc5d0\ub294 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \uc228\uaca8\uc9c4 \uba54\ucee4\ub2c8\uc998 \ubc0f \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \ud2b9\uc815 \ucc4c\ub9b0\uc9c0 \ub610\ub294 \uc131\ucde8\ub3c4\ub97c \uc644\ub8cc\ud558\uc5ec \ube44\ubc00 \uc218\ud638\uc790\ub97c \ubc1c\uacac\ud558\uc138\uc694. STEP2: \ud2b9\uc815 \uc870\uac74\uc744 \ucda9\uc871\ud558\uc5ec \uc228\uaca8\uc9c4 \ub808\ubca8\uc744 \ud574\uc81c\ud558\uc138\uc694(\uc608: \uc2dc\uac04 \uc81c\ud55c \ub0b4\uc5d0 \ubcf4\uc2a4\ub97c \ubb3c\ub9ac\uce58\uae30). STEP3: \ub3c5\ud2b9\ud55c \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud558\ub294 \ud76c\uadc0 \uc774\ubca4\ud2b8\ub97c \uac8c\uc784\uc5d0\uc11c \uac80\uc0c9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\ud669\uae08 \uc218\ud638\uc790'\ub97c \ucc3e\uc73c\uba74 \ubc29\uc5b4\ub825\uc774 \ud06c\uac8c \ud5a5\uc0c1\ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uc694\uc18c\ub294 \uac8c\uc784\uc5d0 \uae4a\uc774\uc640 \ud765\ubd84\uc744 \ub354\ud569\ub2c8\ub2e4."}]
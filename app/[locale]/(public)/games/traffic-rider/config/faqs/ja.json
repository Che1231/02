[{"question": "\u4ea4\u901a\u30e9\u30a4\u30c0\u30fc\u306e\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u52a0\u901f\u3084\u30d6\u30ec\u30fc\u30ad\u306a\u3069\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u3069\u306e\u3088\u3046\u306b\u7fd2\u5f97\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u4ea4\u901a\u30e9\u30a4\u30c0\u30fc\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u7fd2\u5f97\u3059\u308b\u306b\u306f\u3001\u307e\u305a\u753b\u9762\u4e0a\u306e\u64cd\u4f5c\u306b\u6163\u308c\u308b\u3053\u3068\u304b\u3089\u59cb\u3081\u307e\u3057\u3087\u3046\u3002\u52a0\u901f\u306f\u753b\u9762\u53f3\u5074\u3001\u30d6\u30ec\u30fc\u30ad\u306f\u5de6\u5074\u3092\u5229\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u64cd\u4f5c\u611f\u3092\u63b4\u3080\u305f\u3081\u3001\u300e\u30ad\u30e3\u30ea\u30a2\u30e2\u30fc\u30c9\u300f\u3067\u7df4\u7fd2\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u300e\u9ad8\u901f\u9053\u8def\u300f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u4ea4\u901a\u3092\u907f\u3051\u306a\u304c\u3089\u4e00\u5b9a\u306e\u901f\u5ea6\u3092\u7dad\u6301\u3059\u308b\u7df4\u7fd2\u3092\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u6ed1\u3089\u304b\u306a\u64cd\u4f5c\u304c\u3001\u3088\u308a\u826f\u3044\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002\u307e\u305f\u3001\u300e\u30aa\u30d7\u30b7\u30e7\u30f3\u300f\u30e1\u30cb\u30e5\u30fc\u3067\u3001\u81ea\u5206\u306b\u5408\u3063\u305f\u611f\u5ea6\u8a2d\u5b9a\u3092\u8abf\u6574\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u4ea4\u901a\u30e9\u30a4\u30c0\u30fc\u3067\u8907\u6570\u306e\u8eca\u4e21\u3092\u30af\u30e9\u30c3\u30b7\u30e5\u3059\u308b\u3053\u3068\u306a\u304f\u8ffd\u3044\u629c\u304f\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u4ea4\u901a\u30e9\u30a4\u30c0\u30fc\u3067\u8907\u6570\u306e\u8eca\u4e21\u3092\u8ffd\u3044\u629c\u304f\u306b\u306f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u6b63\u78ba\u3055\u306e\u4e21\u65b9\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff11\uff1a\u4ea4\u901a\u306e\u6d41\u308c\u306e\u9699\u9593\u3092\u898b\u3064\u3051\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff12\uff1a\u5148\u884c\u8eca\u4e21\u306e\u901f\u5ea6\u306b\u5408\u308f\u305b\u308b\u3088\u3046\u306b\u6ed1\u3089\u304b\u306b\u52a0\u901f\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff13\uff1a\u72ed\u3044\u5834\u6240\u3092\u9032\u3080\u305f\u3081\u306b\u300e\u50be\u3051\u308b\u300f\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u5e02\u8857\u5730\u300f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u8eca\u306e\u52d5\u304d\u3092\u4e88\u6e2c\u3057\u3001\u300e\u50be\u3051\u308b\u300f\u6a5f\u80fd\u3092\u4f7f\u3063\u3066\u8eca\u306e\u9593\u306b\u6ed1\u308a\u8fbc\u3080\u3088\u3046\u306b\u64cd\u4f5c\u3057\u307e\u3059\u3002\u5e38\u306b\u30df\u30cb\u30de\u30c3\u30d7\u3092\u78ba\u8a8d\u3057\u3001\u4ed6\u306e\u8eca\u4e21\u306b\u3088\u308b\u7a81\u7136\u306e\u8eca\u7dda\u5909\u66f4\u3092\u907f\u3051\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u4ea4\u901a\u30e9\u30a4\u30c0\u30fc\u3067\u3001\u306a\u305c\u30d0\u30a4\u30af\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3042\u308a\u3001\u3069\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u512a\u5148\u3059\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u4ea4\u901a\u30e9\u30a4\u30c0\u30fc\u3067\u30d0\u30a4\u30af\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3053\u3068\u306f\u3001\u6027\u80fd\u3068\u30cf\u30f3\u30c9\u30ea\u30f3\u30b0\u3092\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u306b\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u8ffd\u3044\u629c\u304d\u3084\u30ec\u30d9\u30eb\u30af\u30ea\u30a2\u3092\u65e9\u304f\u884c\u3046\u305f\u3081\u306b\u3001\u901f\u5ea6\u3068\u52a0\u901f\u3092\u9ad8\u3081\u308b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u512a\u5148\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u300e\u30a8\u30f3\u30b8\u30f3\u300f\u3068\u300e\u30de\u30d5\u30e9\u30fc\u300f\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u3001\u30d0\u30a4\u30af\u306e\u6700\u9ad8\u901f\u5ea6\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u307e\u305f\u3001\u9ad8\u901f\u3067\u306e\u64cd\u4f5c\u6027\u3092\u9ad8\u3081\u308b\u305f\u3081\u306b\u300e\u30d6\u30ec\u30fc\u30ad\u300f\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3082\u8003\u616e\u3057\u307e\u3057\u3087\u3046\u3002\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3055\u308c\u305f\u30d0\u30a4\u30af\u306f\u3001\u300e\u5c71\u5cb3\u30d1\u30b9\u300f\u306e\u3088\u3046\u306a\u96e3\u6613\u5ea6\u306e\u9ad8\u3044\u30ec\u30d9\u30eb\u3067\u5927\u304d\u306a\u9055\u3044\u3092\u751f\u307f\u307e\u3059\u3002"}, {"question": "\u4ea4\u901a\u30e9\u30a4\u30c0\u30fc\u306e\u5404\u30ec\u30d9\u30eb\u3067\u306e\u4ea4\u901a\u91cf\u5bc6\u5ea6\u306f\u3069\u306e\u3088\u3046\u306b\u5909\u5316\u3057\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u6226\u7565\u3092\u3069\u306e\u3088\u3046\u306b\u9069\u5fdc\u3055\u305b\u308b\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u4ea4\u901a\u30e9\u30a4\u30c0\u30fc\u306e\u4ea4\u901a\u91cf\u5bc6\u5ea6\u306f\u3001\u30ec\u30d9\u30eb\u306b\u3088\u3063\u3066\u5927\u304d\u304f\u5909\u5316\u3057\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u6226\u7565\u306b\u5f71\u97ff\u3057\u307e\u3059\u3002\u300e\u9ad8\u901f\u9053\u8def\u300f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u4ea4\u901a\u91cf\u306f\u5c11\u306a\u3044\u3082\u306e\u306e\u901f\u5ea6\u304c\u901f\u304f\u3001\u7d20\u65e9\u3044\u53cd\u5fdc\u304c\u6c42\u3081\u3089\u308c\u307e\u3059\u3002\u4e00\u65b9\u3001\u300e\u5e02\u8857\u5730\u300f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u5bc6\u96c6\u3057\u305f\u4ea4\u901a\u306e\u305f\u3081\u3001\u614e\u91cd\u306a\u64cd\u4f5c\u304c\u5fc5\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u591c\u306e\u5e02\u8857\u5730\u300f\u3067\u306f\u3001\u8eca\u7dda\u3092\u5b88\u308a\u3001\u300e\u50be\u3051\u308b\u300f\u6a5f\u80fd\u3092\u4f7f\u3063\u3066\u4ea4\u901a\u306e\u9593\u3092\u7e2b\u3046\u3088\u3046\u306b\u64cd\u4f5c\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4ea4\u901a\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u4e88\u6e2c\u3057\u3001\u305d\u308c\u306b\u5408\u308f\u305b\u3066\u901f\u5ea6\u3092\u8abf\u6574\u3059\u308b\u3053\u3068\u3067\u6226\u7565\u3092\u9069\u5fdc\u3055\u305b\u307e\u3057\u3087\u3046\u3002"}, {"question": "'\u30ad\u30e3\u30ea\u30a2\u30e2\u30fc\u30c9'\u3068'\u30a8\u30f3\u30c9\u30ec\u30b9\u30e2\u30fc\u30c9'\u306e\u4ea4\u901a\u30e9\u30a4\u30c0\u30fc\u306b\u304a\u3051\u308b\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3042\u308a\u3001\u3069\u3061\u3089\u304c\u30b9\u30ad\u30eb\u958b\u767a\u306b\u9069\u3057\u3066\u3044\u307e\u3059\u304b\uff1f", "answer": "\u4ea4\u901a\u30e9\u30a4\u30c0\u30fc\u306e\u300e\u30ad\u30e3\u30ea\u30a2\u30e2\u30fc\u30c9\u300f\u3068\u300e\u30a8\u30f3\u30c9\u30ec\u30b9\u30e2\u30fc\u30c9\u300f\u306f\u3001\u7570\u306a\u308b\u7d4c\u9a13\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u300e\u30ad\u30e3\u30ea\u30a2\u30e2\u30fc\u30c9\u300f\u306f\u3001\u7279\u5b9a\u306e\u76ee\u6a19\u3068\u30ec\u30d9\u30eb\u304c\u8a2d\u5b9a\u3055\u308c\u3066\u3044\u308b\u305f\u3081\u3001\u30b9\u30ad\u30eb\u958b\u767a\u306b\u6700\u9069\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u7530\u820e\u9053\u300f\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u3053\u3068\u3067\u3001\u3055\u307e\u3056\u307e\u306a\u4ea4\u901a\u91cf\u304c\u3042\u308b\u9577\u8ddd\u96e2\u306e\u9053\u8def\u3092\u3069\u306e\u3088\u3046\u306b\u64cd\u4f5c\u3059\u308b\u304b\u3092\u5b66\u3073\u307e\u3059\u3002\u300e\u30a8\u30f3\u30c9\u30ec\u30b9\u30e2\u30fc\u30c9\u300f\u306f\u3001\u751f\u5b58\u3068\u8ddd\u96e2\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u304a\u308a\u3001\u3042\u306a\u305f\u306e\u6301\u4e45\u529b\u3068\u9069\u5fdc\u529b\u3092\u8a66\u3057\u307e\u3059\u3002\u30b9\u30ad\u30eb\u958b\u767a\u306e\u305f\u3081\u306b\u306f\u3001\u300e\u30ad\u30e3\u30ea\u30a2\u30e2\u30fc\u30c9\u300f\u304c\u63a8\u5968\u3055\u308c\u307e\u3059\u3002\u306a\u305c\u306a\u3089\u3001\u6bb5\u968e\u7684\u306a\u5b66\u7fd2\u66f2\u7dda\u3092\u63d0\u4f9b\u3059\u308b\u304b\u3089\u3067\u3059\u3002"}, {"question": "\u4ea4\u901a\u30e9\u30a4\u30c0\u30fc\u3067\u3001\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3057\u3001\u6642\u9593\u3092\u6700\u5c0f\u9650\u306b\u3059\u308b\u305f\u3081\u306b\u3001\u30eb\u30fc\u30c8\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u4ea4\u901a\u30e9\u30a4\u30c0\u30fc\u3067\u30eb\u30fc\u30c8\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u6226\u7565\u7684\u306a\u8a08\u753b\u3068\u5b9f\u884c\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff11\uff1a\u30de\u30c3\u30d7\u3092\u8abf\u3079\u3066\u3001\u6700\u901f\u306e\u8eca\u7dda\u3092\u898b\u3064\u3051\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff12\uff1a\u300e\u50be\u3051\u308b\u300f\u6a5f\u80fd\u3092\u4f7f\u3063\u3066\u3001\u901f\u5ea6\u3092\u843d\u3068\u3055\u305a\u306b\u4ea4\u901a\u3092\u3059\u308a\u629c\u3051\u3066\u3044\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff13\uff1a\u7121\u99c4\u306a\u8eca\u7dda\u5909\u66f4\u3092\u907f\u3051\u3001\u9ad8\u901f\u3092\u7dad\u6301\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u9ad8\u901f\u9053\u8def\u300f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u5de6\u5074\u8eca\u7dda\u3092\u8d70\u884c\u3059\u308b\u3053\u3068\u3067\u3001\u969c\u5bb3\u7269\u304c\u5c11\u306a\u304f\u3001\u30b9\u30b3\u30a2\u304c\u4e0a\u304c\u308a\u3084\u3059\u3044\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u307e\u305f\u3001\u72b6\u6cc1\u306b\u5fdc\u3058\u3066\u300e\u30d6\u30fc\u30b9\u30c8\u300f\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u6226\u7565\u7684\u306b\u4f7f\u7528\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u4ea4\u901a\u30e9\u30a4\u30c0\u30fc\u306e\u300e\u30d6\u30fc\u30b9\u30c8\u300f\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3042\u308a\u3001\u3069\u306e\u3088\u3046\u306b\u52b9\u679c\u7684\u306b\u4f7f\u7528\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u4ea4\u901a\u30e9\u30a4\u30c0\u30fc\u306e\u300e\u30d6\u30fc\u30b9\u30c8\u300f\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u3001\u30d0\u30a4\u30af\u306e\u901f\u5ea6\u3092\u4e00\u6642\u7684\u306b\u5897\u52a0\u3055\u305b\u3001\u7d20\u65e9\u3044\u8ffd\u3044\u629c\u304d\u3084\u8ddd\u96e2\u306e\u77ed\u7e2e\u3092\u53ef\u80fd\u306b\u3057\u307e\u3059\u3002\u52b9\u679c\u7684\u306b\u4f7f\u3046\u305f\u3081\u306b\u306f\u3001\u9053\u304c\u958b\u3051\u3066\u3044\u308b\u6642\u3084\u3001\u8eca\u4e21\u306e\u30b0\u30eb\u30fc\u30d7\u3092\u629c\u3051\u308b\u5fc5\u8981\u304c\u3042\u308b\u3068\u304d\u306b\u300e\u30d6\u30fc\u30b9\u30c8\u300f\u3092\u30a2\u30af\u30c6\u30a3\u30d6\u306b\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u5c71\u5cb3\u30d1\u30b9\u300f\u30ec\u30d9\u30eb\u3067\u3001\u4e00\u9023\u306e\u6025\u30ab\u30fc\u30d6\u3092\u7d20\u65e9\u304f\u901a\u904e\u3059\u308b\u305f\u3081\u306b\u300e\u30d6\u30fc\u30b9\u30c8\u300f\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u300e\u30d6\u30fc\u30b9\u30c8\u300f\u306b\u306f\u30af\u30fc\u30eb\u30c0\u30a6\u30f3\u6642\u9593\u304c\u3042\u308b\u306e\u3067\u3001\u52b9\u679c\u3092\u6700\u5927\u9650\u306b\u6d3b\u304b\u3059\u305f\u3081\u306b\u9069\u5207\u306b\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u4ea4\u901a\u30e9\u30a4\u30c0\u30fc\u306e\u30b2\u30fc\u30e0\u306e\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u306f\u3001\u30cf\u30f3\u30c9\u30ea\u30f3\u30b0\u3068\u885d\u7a81\u691c\u51fa\u306b\u3069\u306e\u3088\u3046\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u304b\uff1f", "answer": "\u4ea4\u901a\u30e9\u30a4\u30c0\u30fc\u306e\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u306f\u3001\u30cf\u30f3\u30c9\u30ea\u30f3\u30b0\u3068\u885d\u7a81\u691c\u51fa\u306b\u91cd\u8981\u306a\u5f79\u5272\u3092\u679c\u305f\u3057\u307e\u3059\u3002\u73fe\u5b9f\u4e16\u754c\u306e\u7269\u7406\u5b66\u3092\u30b7\u30df\u30e5\u30ec\u30fc\u30b7\u30e7\u30f3\u3057\u3001\u30d0\u30a4\u30af\u304c\u52a0\u901f\u3001\u30d6\u30ec\u30fc\u30ad\u3001\u50be\u304d\u306b\u3069\u306e\u3088\u3046\u306b\u53cd\u5fdc\u3059\u308b\u304b\u3092\u5de6\u53f3\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u5e02\u8857\u5730\u300f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u7a81\u7136\u306e\u505c\u6b62\u3084\u6025\u306a\u30bf\u30fc\u30f3\u306b\u3088\u3063\u3066\u3001\u73fe\u5b9f\u7684\u306a\u30b9\u30ea\u30c3\u30d7\u304c\u767a\u751f\u3059\u308b\u3088\u3046\u306b\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u304c\u52d5\u4f5c\u3057\u307e\u3059\u3002\u885d\u7a81\u691c\u51fa\u306f\u6b63\u78ba\u3067\u3042\u308a\u3001\u4ed6\u306e\u8eca\u4e21\u3068\u306e\u8efd\u5fae\u306a\u63a5\u89e6\u3067\u3082\u3001\u52e2\u3044\u304c\u9014\u5207\u308c\u307e\u3059\u3002\u3053\u3046\u3057\u305f\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u52b9\u679c\u7684\u306b\u64cd\u4f5c\u3057\u3001\u30af\u30e9\u30c3\u30b7\u30e5\u3092\u56de\u907f\u3067\u304d\u308b\u3067\u3057\u3087\u3046\u3002"}, {"question": "\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u4ea4\u901a\u30e9\u30a4\u30c0\u30fc\u306e\u9032\u884c\u72b6\u6cc1\u3092\u79fb\u884c\u3059\u308b\u5834\u5408\u3001\u4e92\u63db\u6027\u306e\u554f\u984c\u306f\u4f55\u3067\u3042\u308a\u3001\u3069\u306e\u3088\u3046\u306b\u89e3\u6c7a\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u4ea4\u901a\u30e9\u30a4\u30c0\u30fc\u306e\u9032\u884c\u72b6\u6cc1\u3092\u79fb\u884c\u3059\u308b\u5834\u5408\u3001\u30a2\u30ab\u30a6\u30f3\u30c8\u30b7\u30b9\u30c6\u30e0\u3068\u30c7\u30fc\u30bf\u4fdd\u5b58\u65b9\u6cd5\u306e\u9055\u3044\u304b\u3089\u3001\u4e92\u63db\u6027\u306e\u554f\u984c\u304c\u767a\u751f\u3059\u308b\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3092\u89e3\u6c7a\u3059\u308b\u306b\u306f\u3001\u4e21\u65b9\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001Android\u304b\u3089iOS\u306b\u79fb\u884c\u3059\u308b\u5834\u5408\u306f\u3001\u540c\u3058Google Play\u3042\u308b\u3044\u306fApple ID\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u307e\u305f\u3001\u30c7\u30fc\u30bf\u306e\u8ee2\u9001\u306b\u5f71\u97ff\u3059\u308b\u53ef\u80fd\u6027\u306e\u3042\u308b\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u56fa\u6709\u306e\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3084\u30d1\u30c3\u30c1\u3092\u30c1\u30a7\u30c3\u30af\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u5834\u5408\u306b\u3088\u3063\u3066\u306f\u3001\u624b\u52d5\u306b\u3088\u308b\u30c7\u30fc\u30bf\u306e\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u3068\u5fa9\u5143\u304c\u5fc5\u8981\u3068\u306a\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u4ea4\u901a\u30e9\u30a4\u30c0\u30fc\u3067\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3084\u79d8\u5bc6\u6a5f\u80fd\u306f\u4f55\u3067\u3042\u308a\u3001\u305d\u308c\u3089\u306f\u3069\u306e\u3088\u3046\u306b\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4f53\u9a13\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u304b\uff1f", "answer": "\u4ea4\u901a\u30e9\u30a4\u30c0\u30fc\u306b\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u5965\u884c\u304d\u3092\u4e0e\u3048\u308b\u3001\u3044\u304f\u3064\u304b\u306e\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3084\u79d8\u5bc6\u6a5f\u80fd\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u7530\u820e\u9053\u300f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30b3\u30fc\u30b9\u306e\u5927\u304d\u306a\u90e8\u5206\u3092\u8fc2\u56de\u3059\u308b\u96a0\u308c\u305f\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u307e\u305f\u3001\u7279\u5b9a\u306e\u30d0\u30a4\u30af\u306b\u306f\u3001\u3059\u3050\u306b\u6c17\u3065\u304b\u306a\u3044\u30e6\u30cb\u30fc\u30af\u306a\u30b5\u30a6\u30f3\u30c9\u30a8\u30d5\u30a7\u30af\u30c8\u3084\u8996\u899a\u7684\u306a\u8abf\u6574\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u96a0\u308c\u8981\u7d20\u306f\u3001\u63a2\u6c42\u3092\u4fc3\u3057\u3001\u304a\u99b4\u67d3\u307f\u306e\u30ec\u30d9\u30eb\u306b\u65b0\u3057\u3044\u8996\u70b9\u3092\u4e0e\u3048\u3001\u71b1\u5fc3\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u5168\u4f53\u7684\u306a\u4f53\u9a13\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002"}]
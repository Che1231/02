[{"question": "\u4ea4\u901a\u98c6\u5ba2\u65b0\u73a9\u5bb6\u5982\u4f55\u638c\u63e1\u57fa\u672c\u7684\u52a0\u901f\u548c\u715e\u8eca\u63a7\u5236\uff1f", "answer": "\u8981\u5728\u4ea4\u901a\u98c6\u5ba2\u4e2d\u638c\u63e1\u57fa\u672c\u63a7\u5236\uff0c\u9996\u5148\u8981\u719f\u6089\u87a2\u5e55\u4e0a\u7684\u63a7\u5236\u6309\u9215\u3002\u4f7f\u7528\u87a2\u5e55\u53f3\u5074\u9032\u884c\u52a0\u901f\uff0c\u5de6\u5074\u9032\u884c\u715e\u8eca\u3002\u5728\u300e\u8077\u696d\u6a21\u5f0f\u300f\u4e2d\u7df4\u7fd2\uff0c\u611f\u53d7\u63a7\u5236\u65b9\u5f0f\u3002\u4f8b\u5982\uff0c\u5728\u300e\u9ad8\u901f\u516c\u8def\u300f\u7b49\u7d1a\uff0c\u5617\u8a66\u4fdd\u6301\u7a69\u5b9a\u7684\u901f\u5ea6\u4e26\u907f\u958b\u4ea4\u901a\u3002\u8a18\u4f4f\uff0c\u5e73\u7a69\u7684\u8f38\u5165\u53ef\u4ee5\u63d0\u5347\u63a7\u5236\u7cbe\u6e96\u5ea6\u3002\u6b64\u5916\uff0c\u53ef\u5728\u300e\u9078\u9805\u300f\u9078\u55ae\u4e2d\u8abf\u6574\u654f\u611f\u5ea6\u8a2d\u5b9a\uff0c\u4ee5\u7b26\u5408\u60a8\u7684\u8212\u9069\u5ea6\u3002"}, {"question": "\u5728\u4ea4\u901a\u98c6\u5ba2\u4e2d\u8d85\u8d8a\u591a\u8f1b\u8eca\u8f1b\u800c\u4e0d\u767c\u751f\u78b0\u649e\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u4ea4\u901a\u98c6\u5ba2\u4e2d\u8d85\u8d8a\u591a\u8f1b\u8eca\u8f1b\u9700\u8981\u7d50\u5408\u6642\u6a5f\u548c\u7cbe\u6e96\u5ea6\u3002\u6b65\u9a5f\u4e00\uff1a\u5728\u4ea4\u901a\u6d41\u4e2d\u627e\u5230\u7a7a\u9699\u3002\u6b65\u9a5f\u4e8c\uff1a\u5e73\u7a69\u52a0\u901f\uff0c\u4ee5\u5339\u914d\u524d\u65b9\u8eca\u8f1b\u7684\u901f\u5ea6\u3002\u6b65\u9a5f\u4e09\uff1a\u5229\u7528\u300e\u50be\u659c\u300f\u529f\u80fd\u5728\u72f9\u7a84\u7a7a\u9593\u4e2d\u7a7f\u68ad\u3002\u4f8b\u5982\uff0c\u5728\u300e\u57ce\u5e02\u300f\u7b49\u7d1a\uff0c\u9810\u6e2c\u6c7d\u8eca\u7684\u79fb\u52d5\uff0c\u4e26\u5229\u7528\u300e\u50be\u659c\u300f\u529f\u80fd\u5728\u8eca\u8f1b\u4e4b\u9593\u6ed1\u884c\u3002\u96a8\u6642\u89c0\u5bdf\u8ff7\u4f60\u5730\u5716\uff0c\u907f\u514d\u5176\u4ed6\u8eca\u8f1b\u7a81\u7136\u8b8a\u63db\u8eca\u9053\u3002"}, {"question": "\u5728\u4ea4\u901a\u98c6\u5ba2\u4e2d\u5347\u7d1a\u6a5f\u8eca\u7684\u91cd\u8981\u6027\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u61c9\u8a72\u512a\u5148\u5347\u7d1a\u54ea\u4e9b\u90e8\u4ef6\uff1f", "answer": "\u5728\u4ea4\u901a\u98c6\u5ba2\u4e2d\u5347\u7d1a\u6a5f\u8eca\u5c0d\u65bc\u63d0\u5347\u6027\u80fd\u548c\u64cd\u63a7\u81f3\u95dc\u91cd\u8981\u3002\u512a\u5148\u5347\u7d1a\u80fd\u63d0\u5347\u901f\u5ea6\u548c\u52a0\u901f\u7684\u90e8\u4ef6\uff0c\u56e0\u70ba\u9019\u4e9b\u5c0d\u65bc\u8d85\u8eca\u548c\u66f4\u5feb\u5b8c\u6210\u95dc\u5361\u81f3\u95dc\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5347\u7d1a\u300e\u5f15\u64ce\u300f\u548c\u300e\u6392\u6c23\u7ba1\u300f\u7cfb\u7d71\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u6a5f\u8eca\u7684\u6700\u9ad8\u901f\u5ea6\u3002\u6b64\u5916\uff0c\u8003\u616e\u5347\u7d1a\u300e\u715e\u8eca\u300f\u7cfb\u7d71\uff0c\u4ee5\u5728\u9ad8\u901f\u64cd\u4f5c\u6642\u7372\u5f97\u66f4\u597d\u7684\u63a7\u5236\u3002\u5347\u7d1a\u5f8c\u7684\u6a5f\u8eca\u80fd\u5728\u50cf\u300e\u5c71\u8def\u300f\u9019\u6a23\u7684\u5177\u6709\u6311\u6230\u6027\u7684\u95dc\u5361\u4e2d\u5e36\u4f86\u660e\u986f\u7684\u5dee\u7570\u3002"}, {"question": "\u4ea4\u901a\u98c6\u5ba2\u4e0d\u540c\u7b49\u7d1a\u7684\u8eca\u6d41\u91cf\u5982\u4f55\u8b8a\u5316\uff0c\u73a9\u5bb6\u61c9\u8a72\u5982\u4f55\u8abf\u6574\u7b56\u7565\uff1f", "answer": "\u4ea4\u901a\u98c6\u5ba2\u4e0d\u540c\u7b49\u7d1a\u7684\u8eca\u6d41\u91cf\u8b8a\u5316\u5f88\u5927\uff0c\u6703\u5f71\u97ff\u904a\u6232\u7b56\u7565\u3002\u5728\u300e\u9ad8\u901f\u516c\u8def\u300f\u7b49\u7d1a\uff0c\u8eca\u6d41\u91cf\u7a00\u758f\uff0c\u4f46\u901f\u5ea6\u5f88\u5feb\uff0c\u9700\u8981\u5feb\u901f\u53cd\u61c9\u3002\u76f8\u53cd\u5730\uff0c\u300e\u57ce\u5e02\u300f\u7b49\u7d1a\u8eca\u6d41\u91cf\u5bc6\u96c6\uff0c\u9700\u8981\u8b39\u614e\u99d5\u99db\u3002\u4f8b\u5982\uff0c\u5728\u300e\u57ce\u5e02\u591c\u665a\u300f\uff0c\u73a9\u5bb6\u61c9\u8a72\u5c08\u6ce8\u65bc\u8eca\u9053\u898f\u7bc4\uff0c\u4e26\u4f7f\u7528\u300e\u50be\u659c\u300f\u529f\u80fd\u7a7f\u68ad\u65bc\u8eca\u8f1b\u4e4b\u9593\u3002\u9810\u6e2c\u4ea4\u901a\u6a21\u5f0f\u4e26\u76f8\u61c9\u8abf\u6574\u901f\u5ea6\uff0c\u4f86\u8abf\u6574\u4f60\u7684\u7b56\u7565\u3002"}, {"question": "\u4ea4\u901a\u98c6\u5ba2\u4e2d\u7684\u300e\u8077\u696d\u6a21\u5f0f\u300f\u548c\u300e\u7121\u9650\u6a21\u5f0f\u300f\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff0c\u54ea\u7a2e\u6a21\u5f0f\u66f4\u9069\u5408\u6280\u80fd\u63d0\u5347\uff1f", "answer": "\u4ea4\u901a\u98c6\u5ba2\u4e2d\u7684\u300e\u8077\u696d\u6a21\u5f0f\u300f\u548c\u300e\u7121\u9650\u6a21\u5f0f\u300f\u63d0\u4f9b\u4e0d\u540c\u7684\u904a\u6232\u9ad4\u9a57\u3002\u300e\u8077\u696d\u6a21\u5f0f\u300f\u5177\u6709\u7279\u5b9a\u7684\u76ee\u6a19\u548c\u95dc\u5361\uff0c\u975e\u5e38\u9069\u5408\u6280\u80fd\u63d0\u5347\u3002\u4f8b\u5982\uff0c\u5b8c\u6210\u300e\u9109\u9593\u300f\u95dc\u5361\u53ef\u4ee5\u6559\u5c0e\u73a9\u5bb6\u5982\u4f55\u61c9\u5c0d\u4e0d\u540c\u8eca\u6d41\u91cf\u7684\u9577\u8def\u6bb5\u3002\u800c\u300e\u7121\u9650\u6a21\u5f0f\u300f\u5247\u8457\u91cd\u65bc\u751f\u5b58\u548c\u8ddd\u96e2\uff0c\u6e2c\u8a66\u4f60\u7684\u8010\u529b\u548c\u9069\u61c9\u529b\u3002\u5c31\u6280\u80fd\u63d0\u5347\u800c\u8a00\uff0c\u300e\u8077\u696d\u6a21\u5f0f\u300f\u6bd4\u8f03\u63a8\u85a6\uff0c\u56e0\u70ba\u5b83\u63d0\u4f9b\u5faa\u5e8f\u6f38\u9032\u7684\u5b78\u7fd2\u66f2\u7dda\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u4ea4\u901a\u98c6\u5ba2\u4e2d\u6700\u4f73\u5316\u8def\u7dda\uff0c\u4ee5\u6700\u5927\u5316\u5f97\u5206\u4e26\u6700\u5c0f\u5316\u6642\u9593\uff1f", "answer": "\u5728\u4ea4\u901a\u98c6\u5ba2\u4e2d\u6700\u4f73\u5316\u8def\u7dda\u9700\u8981\u7b56\u7565\u6027\u898f\u5283\u548c\u57f7\u884c\u3002\u6b65\u9a5f\u4e00\uff1a\u7814\u7a76\u5730\u5716\uff0c\u627e\u51fa\u6700\u5feb\u7684\u8eca\u9053\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u300e\u50be\u659c\u300f\u529f\u80fd\u7a7f\u904e\u8eca\u6d41\uff0c\u800c\u4e0d\u6e1b\u6162\u901f\u5ea6\u3002\u6b65\u9a5f\u4e09\uff1a\u4fdd\u6301\u9ad8\u901f\uff0c\u907f\u514d\u4e0d\u5fc5\u8981\u7684\u8eca\u9053\u8b8a\u63db\u3002\u4f8b\u5982\uff0c\u5728\u300e\u9ad8\u901f\u516c\u8def\u300f\u7b49\u7d1a\uff0c\u4fdd\u6301\u5728\u5de6\u5074\u8eca\u9053\u901a\u5e38\u6703\u9047\u5230\u8f03\u5c11\u7684\u969c\u7919\u7269\u4e26\u7372\u5f97\u8f03\u9ad8\u7684\u5206\u6578\u3002\u6b64\u5916\uff0c\u5728\u7dca\u8feb\u60c5\u6cc1\u4e0b\uff0c\u7b56\u7565\u6027\u5730\u4f7f\u7528\u300e\u52a0\u901f\u300f\u9053\u5177\uff0c\u4ee5\u7372\u5f97\u512a\u52e2\u3002"}, {"question": "\u4ea4\u901a\u98c6\u5ba2\u4e2d\u7684\u300e\u52a0\u901f\u300f\u9053\u5177\u80cc\u5f8c\u7684\u6a5f\u5236\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5982\u4f55\u6709\u6548\u4f7f\u7528\uff1f", "answer": "\u4ea4\u901a\u98c6\u5ba2\u4e2d\u7684\u300e\u52a0\u901f\u300f\u9053\u5177\u6703\u66ab\u6642\u63d0\u5347\u6a5f\u8eca\u901f\u5ea6\uff0c\u5141\u8a31\u5feb\u901f\u8d85\u8eca\u548c\u7e2e\u77ed\u8ddd\u96e2\u3002\u8981\u6709\u6548\u4f7f\u7528\u5b83\uff0c\u5728\u9047\u5230\u958b\u95ca\u8def\u6bb5\u6216\u9700\u8981\u8d85\u8d8a\u8eca\u8f1b\u7fa4\u6642\uff0c\u555f\u52d5\u300e\u52a0\u901f\u300f\u529f\u80fd\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5c71\u8def\u300f\u7b49\u7d1a\uff0c\u5229\u7528\u300e\u52a0\u901f\u300f\u529f\u80fd\u5feb\u901f\u901a\u904e\u4e00\u7cfb\u5217\u6025\u5f4e\u3002\u8a18\u4f4f\uff0c\u300e\u52a0\u901f\u300f\u9053\u5177\u6709\u51b7\u537b\u6642\u9593\uff0c\u56e0\u6b64\u660e\u667a\u5730\u4f7f\u7528\u5b83\uff0c\u4ee5\u6700\u5927\u5316\u5176\u5f71\u97ff\u3002"}, {"question": "\u904a\u6232\u7684\u7269\u7406\u5f15\u64ce\u5728\u4ea4\u901a\u98c6\u5ba2\u4e2d\u5982\u4f55\u5f71\u97ff\u64cd\u63a7\u548c\u78b0\u649e\u5075\u6e2c\uff1f", "answer": "\u4ea4\u901a\u98c6\u5ba2\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u5728\u64cd\u63a7\u548c\u78b0\u649e\u5075\u6e2c\u65b9\u9762\u626e\u6f14\u8457\u95dc\u9375\u89d2\u8272\u3002\u5b83\u6a21\u64ec\u73fe\u5be6\u7269\u7406\uff0c\u5f71\u97ff\u6a5f\u8eca\u5982\u4f55\u97ff\u61c9\u52a0\u901f\u3001\u715e\u8eca\u548c\u50be\u659c\u3002\u4f8b\u5982\uff0c\u5728\u300e\u57ce\u5e02\u300f\u7d1a\u5225\uff0c\u7269\u7406\u5f15\u64ce\u78ba\u4fdd\u7a81\u7136\u505c\u6b62\u6216\u6025\u8f49\u5f4e\u6703\u7522\u751f\u771f\u5be6\u7684\u6253\u6ed1\u6548\u679c\u3002\u78b0\u649e\u5075\u6e2c\u5f88\u7cbe\u78ba\uff0c\u610f\u5473\u8457\u8207\u5176\u4ed6\u8eca\u8f1b\u7684\u8f15\u5fae\u63a5\u89f8\u4e5f\u6703\u5f71\u97ff\u4f60\u7684\u52d5\u91cf\u3002\u4e86\u89e3\u9019\u4e9b\u6a5f\u5236\u53ef\u4ee5\u5e6b\u52a9\u4f60\u66f4\u6709\u6548\u5730\u99d5\u99db\u4e26\u907f\u514d\u78b0\u649e\u3002"}, {"question": "\u5728\u5c07\u4ea4\u901a\u98c6\u5ba2\u7684\u9032\u5ea6\u5f9e\u4e00\u500b\u5e73\u53f0\u9077\u79fb\u5230\u53e6\u4e00\u500b\u5e73\u53f0\u6642\uff0c\u6709\u54ea\u4e9b\u76f8\u5bb9\u6027\u554f\u984c\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u6c7a\uff1f", "answer": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u9593\u9077\u79fb\u4ea4\u901a\u98c6\u5ba2\u7684\u9032\u5ea6\u53ef\u80fd\u6703\u9047\u5230\u76f8\u5bb9\u6027\u554f\u984c\uff0c\u4e3b\u8981\u7531\u65bc\u5e33\u6236\u7cfb\u7d71\u548c\u8cc7\u6599\u5132\u5b58\u65b9\u5f0f\u7684\u5dee\u7570\u3002\u89e3\u6c7a\u6b64\u554f\u984c\uff0c\u52d9\u5fc5\u5728\u5169\u500b\u5e73\u53f0\u4e0a\u767b\u5165\u540c\u4e00\u5e33\u6236\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5f9e Android \u8f49\u79fb\u5230 iOS\uff0c\u8acb\u4f7f\u7528\u76f8\u540c\u7684 Google Play \u6216 Apple ID\u3002\u6b64\u5916\uff0c\u6aa2\u67e5\u662f\u5426\u6709\u4efb\u4f55\u7279\u5b9a\u5e73\u53f0\u7684\u66f4\u65b0\u6216\u4fee\u88dc\u7a0b\u5f0f\u6703\u5f71\u97ff\u8cc7\u6599\u8f49\u79fb\u3002\u5728\u67d0\u4e9b\u60c5\u6cc1\u4e0b\uff0c\u53ef\u80fd\u9700\u8981\u624b\u52d5\u5099\u4efd\u548c\u9084\u539f\u8cc7\u6599\u4ee5\u78ba\u4fdd\u9806\u5229\u8f49\u63db\u3002"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728\u4ea4\u901a\u98c6\u5ba2\u4e2d\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\u6216\u79d8\u5bc6\u529f\u80fd\uff0c\u4ee5\u53ca\u5b83\u5011\u5982\u4f55\u63d0\u5347\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u4ea4\u901a\u98c6\u5ba2\u5305\u542b\u4e00\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\u548c\u79d8\u5bc6\u529f\u80fd\uff0c\u70ba\u904a\u6232\u589e\u6dfb\u6df1\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u300e\u9109\u9593\u300f\u7b49\u7d1a\uff0c\u73a9\u5bb6\u53ef\u4ee5\u767c\u73fe\u4e00\u689d\u96b1\u85cf\u7684\u6377\u5f91\uff0c\u53ef\u4ee5\u7e5e\u904e\u76f8\u7576\u4e00\u90e8\u5206\u8cfd\u9053\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u6a5f\u8eca\u6709\u7368\u7279\u7684\u97f3\u6548\u6216\u8996\u89ba\u8abf\u6574\uff0c\u4e26\u975e\u7acb\u523b\u660e\u986f\u3002\u9019\u4e9b\u96b1\u85cf\u5143\u7d20\u9f13\u52f5\u63a2\u7d22\uff0c\u4e26\u53ef\u4ee5\u63d0\u4f9b\u5c0d\u719f\u6089\u95dc\u5361\u7684\u65b0\u8996\u89d2\uff0c\u63d0\u5347\u71b1\u8877\u73a9\u5bb6\u7684\u6574\u9ad4\u9ad4\u9a57\u3002"}]
[{"question": "\u4ea4\u901a\u8d5b\u8f66\u624b\u65b0\u73a9\u5bb6\u5982\u4f55\u638c\u63e1\u57fa\u7840\u63a7\u5236\uff0c\u4f8b\u5982\u52a0\u901f\u548c\u5239\u8f66\uff1f", "answer": "\u8981\u638c\u63e1\u4ea4\u901a\u8d5b\u8f66\u624b\u4e2d\u7684\u57fa\u7840\u63a7\u5236\uff0c\u9996\u5148\u8981\u719f\u6089\u5c4f\u5e55\u4e0a\u7684\u63a7\u5236\u3002\u4f7f\u7528\u5c4f\u5e55\u53f3\u4fa7\u8fdb\u884c\u52a0\u901f\uff0c\u5de6\u4fa7\u8fdb\u884c\u5239\u8f66\u3002\u5728\"\u804c\u4e1a\u6a21\u5f0f\"\u4e2d\u7ec3\u4e60\uff0c\u611f\u53d7\u63a7\u5236\u624b\u611f\u3002\u4f8b\u5982\uff0c\u5728\"\u9ad8\u901f\u516c\u8def\"\u5173\u5361\u4e2d\uff0c\u5c1d\u8bd5\u4fdd\u6301\u7a33\u5b9a\u7684\u901f\u5ea6\uff0c\u540c\u65f6\u907f\u514d\u4e0e\u8f66\u8f86\u78b0\u649e\u3002\u8bb0\u4f4f\uff0c\u5e73\u7a33\u7684\u64cd\u4f5c\u80fd\u591f\u66f4\u597d\u5730\u63a7\u5236\u8f66\u8f86\u3002\u6b64\u5916\uff0c\u8fd8\u53ef\u4ee5\u8c03\u6574\"\u9009\u9879\"\u83dc\u5355\u4e2d\u7684\u7075\u654f\u5ea6\u8bbe\u7f6e\uff0c\u4f7f\u5176\u66f4\u7b26\u5408\u4f60\u7684\u64cd\u4f5c\u4e60\u60ef\u3002"}, {"question": "\u5728\u4ea4\u901a\u8d5b\u8f66\u624b\u4e2d\u8d85\u8f66\u591a\u8f86\u8f66\u8f86\u800c\u4e0d\u53d1\u751f\u78b0\u649e\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u4ea4\u901a\u8d5b\u8f66\u624b\u4e2d\u8d85\u8f66\u591a\u8f86\u8f66\u8f86\u9700\u8981\u7ed3\u5408\u65f6\u673a\u548c\u7cbe\u51c6\u5ea6\u3002\u6b65\u9aa4\u4e00\uff1a\u627e\u5230\u4ea4\u901a\u6d41\u4e2d\u7684\u7a7a\u9699\u3002\u6b65\u9aa4\u4e8c\uff1a\u5e73\u7a33\u52a0\u901f\uff0c\u5339\u914d\u524d\u65b9\u8f66\u8f86\u7684\u901f\u5ea6\u3002\u6b65\u9aa4\u4e09\uff1a\u4f7f\u7528\"\u503e\u659c\"\u529f\u80fd\u6765\u7a7f\u68ad\u4e8e\u72ed\u7a84\u7684\u7a7a\u95f4\u3002\u4f8b\u5982\uff0c\u5728\"\u57ce\u5e02\"\u5173\u5361\u4e2d\uff0c\u9884\u5224\u8f66\u8f86\u7684\u79fb\u52a8\uff0c\u5229\u7528\"\u503e\u659c\"\u529f\u80fd\u5728\u8f66\u8f86\u4e4b\u95f4\u7a7f\u68ad\u3002\u65f6\u523b\u5173\u6ce8\u8ff7\u4f60\u5730\u56fe\uff0c\u907f\u514d\u5176\u4ed6\u8f66\u8f86\u7a81\u7136\u53d8\u9053\u3002"}, {"question": "\u5728\u4ea4\u901a\u8d5b\u8f66\u624b\u4e2d\u5347\u7ea7\u6469\u6258\u8f66\u6709\u4ec0\u4e48\u91cd\u8981\u6027\uff0c\u5e94\u8be5\u4f18\u5148\u5347\u7ea7\u54ea\u4e9b\u90e8\u4ef6\uff1f", "answer": "\u5728\u4ea4\u901a\u8d5b\u8f66\u624b\u4e2d\u5347\u7ea7\u6469\u6258\u8f66\u5bf9\u4e8e\u63d0\u5347\u6027\u80fd\u548c\u64cd\u63a7\u81f3\u5173\u91cd\u8981\u3002\u4f18\u5148\u5347\u7ea7\u80fd\u591f\u589e\u5f3a\u901f\u5ea6\u548c\u52a0\u901f\u7684\u90e8\u4ef6\uff0c\u56e0\u4e3a\u8fd9\u4e9b\u90e8\u4ef6\u5bf9\u4e8e\u8d85\u8f66\u548c\u66f4\u5feb\u5730\u5b8c\u6210\u5173\u5361\u81f3\u5173\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5347\u7ea7\"\u5f15\u64ce\"\u548c\"\u6392\u6c14\"\u7cfb\u7edf\u53ef\u4ee5\u663e\u8457\u63d0\u5347\u6469\u6258\u8f66\u7684\u6700\u9ad8\u901f\u5ea6\u3002\u6b64\u5916\uff0c\u53ef\u4ee5\u8003\u8651\u5347\u7ea7\"\u5239\u8f66\"\u7cfb\u7edf\uff0c\u4ee5\u4fbf\u5728\u9ad8\u901f\u64cd\u4f5c\u4e2d\u66f4\u597d\u5730\u63a7\u5236\u3002\u5347\u7ea7\u540e\u7684\u6469\u6258\u8f66\u53ef\u4ee5\u5728\u6311\u6218\u6027\u5173\u5361\uff0c\u4f8b\u5982\"\u5c71\u8def\"\u4e2d\u5e26\u6765\u663e\u8457\u7684\u63d0\u5347\u3002"}, {"question": "\u4ea4\u901a\u8d5b\u8f66\u624b\u4e0d\u540c\u5173\u5361\u4e2d\u7684\u4ea4\u901a\u5bc6\u5ea6\u5982\u4f55\u53d8\u5316\uff0c\u73a9\u5bb6\u5e94\u8be5\u5982\u4f55\u8c03\u6574\u7b56\u7565\uff1f", "answer": "\u4ea4\u901a\u8d5b\u8f66\u624b\u4e0d\u540c\u5173\u5361\u4e2d\u7684\u4ea4\u901a\u5bc6\u5ea6\u5dee\u5f02\u5f88\u5927\uff0c\u8fd9\u4f1a\u5f71\u54cd\u6e38\u620f\u7b56\u7565\u3002\u5728\"\u9ad8\u901f\u516c\u8def\"\u5173\u5361\u4e2d\uff0c\u8f66\u8f86\u7a00\u5c11\u4f46\u901f\u5ea6\u5f88\u5feb\uff0c\u9700\u8981\u5feb\u901f\u53cd\u5e94\u3002\u76f8\u6bd4\u4e4b\u4e0b\uff0c\"\u57ce\u5e02\"\u5173\u5361\u4e2d\u7684\u4ea4\u901a\u5bc6\u5ea6\u5f88\u9ad8\uff0c\u9700\u8981\u4ed4\u7ec6\u9a7e\u9a76\u3002\u4f8b\u5982\uff0c\u5728\"\u57ce\u5e02\u591c\u665a\"\u4e2d\uff0c\u73a9\u5bb6\u5e94\u8be5\u6ce8\u91cd\u8f66\u9053\u89c4\u8303\uff0c\u5e76\u4f7f\u7528\"\u503e\u659c\"\u529f\u80fd\u7a7f\u68ad\u4e8e\u8f66\u8f86\u4e4b\u95f4\u3002\u6839\u636e\u4ea4\u901a\u6a21\u5f0f\u5e76\u76f8\u5e94\u5730\u8c03\u6574\u901f\u5ea6\uff0c\u8c03\u6574\u4f60\u7684\u7b56\u7565\u3002"}, {"question": "\u4ea4\u901a\u8d5b\u8f66\u624b\u4e2d\u7684\"\u804c\u4e1a\u6a21\u5f0f\"\u548c\"\u65e0\u5c3d\u6a21\u5f0f\"\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff0c\u54ea\u79cd\u6a21\u5f0f\u66f4\u9002\u5408\u6280\u80fd\u63d0\u5347\uff1f", "answer": "\"\u804c\u4e1a\u6a21\u5f0f\"\u548c\"\u65e0\u5c3d\u6a21\u5f0f\"\u5728\u4ea4\u901a\u8d5b\u8f66\u624b\u4e2d\u63d0\u4f9b\u4e86\u4e0d\u540c\u7684\u4f53\u9a8c\u3002\"\u804c\u4e1a\u6a21\u5f0f\"\u5305\u542b\u5177\u4f53\u7684\u76ee\u6807\u548c\u5173\u5361\uff0c\u975e\u5e38\u9002\u5408\u6280\u80fd\u63d0\u5347\u3002\u4f8b\u5982\uff0c\u5b8c\u6210\"\u4e61\u6751\"\u5173\u5361\u6559\u4f1a\u73a9\u5bb6\u5982\u4f55\u5e94\u5bf9\u5404\u79cd\u4ea4\u901a\u72b6\u51b5\u7684\u6f2b\u957f\u9053\u8def\u3002\"\u65e0\u5c3d\u6a21\u5f0f\"\u5219\u4e13\u6ce8\u4e8e\u751f\u5b58\u548c\u8ddd\u79bb\uff0c\u6d4b\u8bd5\u73a9\u5bb6\u7684\u8010\u529b\u548c\u9002\u5e94\u80fd\u529b\u3002\u5982\u679c\u60f3\u8981\u63d0\u5347\u6280\u80fd\uff0c\"\u804c\u4e1a\u6a21\u5f0f\"\u66f4\u63a8\u8350\uff0c\u56e0\u4e3a\u5176\u63d0\u4f9b\u4e86\u4e00\u4e2a\u6e10\u8fdb\u7684\u5b66\u4e60\u66f2\u7ebf\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u4ea4\u901a\u8d5b\u8f66\u624b\u4e2d\u4f18\u5316\u8def\u7ebf\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u5206\u6570\u548c\u6700\u5c0f\u5316\u65f6\u95f4\uff1f", "answer": "\u5728\u4ea4\u901a\u8d5b\u8f66\u624b\u4e2d\u4f18\u5316\u4f60\u7684\u8def\u7ebf\u9700\u8981\u6218\u7565\u89c4\u5212\u548c\u6267\u884c\u3002\u6b65\u9aa4\u4e00\uff1a\u7814\u7a76\u5730\u56fe\uff0c\u8bc6\u522b\u6700\u5feb\u7684\u8f66\u9053\u3002\u6b65\u9aa4\u4e8c\uff1a\u5229\u7528\"\u503e\u659c\"\u529f\u80fd\u5728\u4e0d\u51cf\u901f\u7684\u60c5\u51b5\u4e0b\u7a7f\u68ad\u4e8e\u8f66\u8f86\u4e4b\u95f4\u3002\u6b65\u9aa4\u4e09\uff1a\u4fdd\u6301\u9ad8\u901f\uff0c\u907f\u514d\u4e0d\u5fc5\u8981\u7684\u53d8\u9053\u3002\u4f8b\u5982\uff0c\u5728\"\u9ad8\u901f\u516c\u8def\"\u5173\u5361\u4e2d\uff0c\u4fdd\u6301\u5728\u5de6\u4fa7\u8f66\u9053\u901a\u5e38\u53ef\u4ee5\u51cf\u5c11\u969c\u788d\u7269\uff0c\u5e76\u83b7\u5f97\u66f4\u9ad8\u5206\u6570\u3002\u6b64\u5916\uff0c\u5728\u72ed\u7a84\u60c5\u51b5\u4e0b\uff0c\u6218\u7565\u6027\u5730\u4f7f\u7528\"\u52a0\u901f\"\u9053\u5177\uff0c\u4ee5\u83b7\u5f97\u4f18\u52bf\u3002"}, {"question": "\u4ea4\u901a\u8d5b\u8f66\u624b\u4e2d\u7684\"\u52a0\u901f\"\u9053\u5177\u7684\u673a\u5236\u662f\u4ec0\u4e48\uff0c\u5982\u4f55\u6709\u6548\u5730\u4f7f\u7528\u5b83\uff1f", "answer": "\u4ea4\u901a\u8d5b\u8f66\u624b\u4e2d\u7684\"\u52a0\u901f\"\u9053\u5177\u53ef\u4ee5\u6682\u65f6\u589e\u52a0\u6469\u6258\u8f66\u7684\u901f\u5ea6\uff0c\u4ee5\u4fbf\u5feb\u901f\u8d85\u8f66\u548c\u5feb\u901f\u901a\u8fc7\u8def\u6bb5\u3002\u8981\u6709\u6548\u5730\u4f7f\u7528\u5b83\uff0c\u8bf7\u5728\u9047\u5230\u7a7a\u65f7\u9053\u8def\u6216\u9700\u8981\u8d85\u8d8a\u591a\u8f86\u8f66\u8f86\u65f6\u6fc0\u6d3b\"\u52a0\u901f\"\u3002\u4f8b\u5982\uff0c\u5728\"\u5c71\u8def\"\u5173\u5361\u4e2d\uff0c\u53ef\u4ee5\u4f7f\u7528\"\u52a0\u901f\"\u8fc5\u901f\u901a\u8fc7\u4e00\u7cfb\u5217\u6025\u5f2f\u3002\u8bb0\u4f4f\uff0c\"\u52a0\u901f\"\u9053\u5177\u6709\u4e00\u4e2a\u51b7\u5374\u65f6\u95f4\uff0c\u6240\u4ee5\u8981\u8c28\u614e\u4f7f\u7528\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u53d1\u6325\u5176\u4f5c\u7528\u3002"}, {"question": "\u4ea4\u901a\u8d5b\u8f66\u624b\u6e38\u620f\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u5982\u4f55\u5f71\u54cd\u64cd\u63a7\u548c\u78b0\u649e\u68c0\u6d4b\uff1f", "answer": "\u4ea4\u901a\u8d5b\u8f66\u624b\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u5728\u64cd\u63a7\u548c\u78b0\u649e\u68c0\u6d4b\u4e2d\u8d77\u7740\u81f3\u5173\u91cd\u8981\u7684\u4f5c\u7528\u3002\u5b83\u6a21\u62df\u73b0\u5b9e\u4e16\u754c\u7684\u7269\u7406\uff0c\u5f71\u54cd\u6469\u6258\u8f66\u5982\u4f55\u54cd\u5e94\u52a0\u901f\u3001\u5239\u8f66\u548c\u503e\u659c\u3002\u4f8b\u5982\uff0c\u5728\"\u57ce\u5e02\"\u5173\u5361\u4e2d\uff0c\u7269\u7406\u5f15\u64ce\u786e\u4fdd\u7a81\u7136\u5239\u8f66\u6216\u6025\u8f6c\u5f2f\u4f1a\u4ea7\u751f\u73b0\u5b9e\u7684\u6253\u6ed1\u6548\u679c\u3002\u78b0\u649e\u68c0\u6d4b\u975e\u5e38\u7cbe\u51c6\uff0c\u8fd9\u610f\u5473\u7740\u4e0e\u5176\u4ed6\u8f66\u8f86\u7684\u8f7b\u5fae\u63a5\u89e6\u4e5f\u4f1a\u5f71\u54cd\u4f60\u7684\u901f\u5ea6\u3002\u4e86\u89e3\u8fd9\u4e9b\u673a\u5236\u6709\u52a9\u4e8e\u4f60\u66f4\u6709\u6548\u5730\u9a7e\u9a76\u5e76\u907f\u514d\u78b0\u649e\u3002"}, {"question": "\u5728\u5c06\u4ea4\u901a\u8d5b\u8f66\u624b\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u5e73\u53f0\u8fc1\u79fb\u5230\u53e6\u4e00\u4e2a\u5e73\u53f0\u65f6\uff0c\u4f1a\u51fa\u73b0\u54ea\u4e9b\u517c\u5bb9\u6027\u95ee\u9898\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u51b3\uff1f", "answer": "\u5728\u4e0d\u540c\u5e73\u53f0\u95f4\u8fc1\u79fb\u4ea4\u901a\u8d5b\u8f66\u624b\u8fdb\u5ea6\u53ef\u80fd\u4f1a\u51fa\u73b0\u517c\u5bb9\u6027\u95ee\u9898\uff0c\u4e3b\u8981\u662f\u56e0\u4e3a\u8d26\u6237\u7cfb\u7edf\u548c\u6570\u636e\u5b58\u50a8\u65b9\u5f0f\u7684\u4e0d\u540c\u3002\u8981\u89e3\u51b3\u8fd9\u4e9b\u95ee\u9898\uff0c\u8bf7\u786e\u4fdd\u5728\u4e24\u4e2a\u5e73\u53f0\u4e0a\u767b\u5f55\u540c\u4e00\u4e2a\u8d26\u53f7\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4eceAndroid\u8fc1\u79fb\u5230iOS\uff0c\u8bf7\u4f7f\u7528\u76f8\u540c\u7684Google Play\u6216Apple ID\u3002\u6b64\u5916\uff0c\u68c0\u67e5\u4efb\u4f55\u7279\u5b9a\u5e73\u53f0\u7684\u66f4\u65b0\u6216\u8865\u4e01\uff0c\u5b83\u4eec\u53ef\u80fd\u4f1a\u5f71\u54cd\u6570\u636e\u4f20\u8f93\u3002\u5728\u67d0\u4e9b\u60c5\u51b5\u4e0b\uff0c\u53ef\u80fd\u9700\u8981\u624b\u52a8\u5907\u4efd\u548c\u6062\u590d\u6570\u636e\uff0c\u4ee5\u786e\u4fdd\u5e73\u7a33\u8fc7\u6e21\u3002"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728\u4ea4\u901a\u8d5b\u8f66\u624b\u6e38\u620f\u4e2d\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u7684\u5f69\u86cb\u6216\u79d8\u5bc6\u529f\u80fd\uff0c\u4ee5\u53ca\u5b83\u4eec\u5982\u4f55\u63d0\u5347\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u4ea4\u901a\u8d5b\u8f66\u624b\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u7684\u5f69\u86cb\u548c\u79d8\u5bc6\u529f\u80fd\uff0c\u4e3a\u6e38\u620f\u589e\u6dfb\u4e86\u6df1\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\"\u4e61\u6751\"\u5173\u5361\u4e2d\uff0c\u73a9\u5bb6\u53ef\u4ee5\u53d1\u73b0\u4e00\u6761\u9690\u85cf\u7684\u6377\u5f84\uff0c\u7ed5\u8fc7\u4e00\u6bb5\u76f8\u5f53\u957f\u7684\u8def\u7a0b\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u6469\u6258\u8f66\u62e5\u6709\u72ec\u7279\u7684\u97f3\u6548\u6216\u89c6\u89c9\u6548\u679c\uff0c\u5e76\u975e\u4e00\u5f00\u59cb\u5c31\u80fd\u53d1\u73b0\u3002\u8fd9\u4e9b\u9690\u85cf\u5143\u7d20\u9f13\u52b1\u73a9\u5bb6\u8fdb\u884c\u63a2\u7d22\uff0c\u5e76\u4e3a\u719f\u6089\u7684\u5173\u5361\u63d0\u4f9b\u65b0\u7684\u89c6\u89d2\uff0c\u8fdb\u4e00\u6b65\u63d0\u5347\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}]
[{"question": "\ud2b8\ub798\ud53d \ub77c\uc774\ub354\uc758 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \uac00\uc18d \ubc0f \uc81c\ub3d9\uacfc \uac19\uc740 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc5b4\ub5bb\uac8c \uc219\ub2ec\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud2b8\ub798\ud53d \ub77c\uc774\ub354\uc5d0\uc11c \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc219\ub2ec\ud558\ub824\uba74 \ud654\uba74 \ucee8\ud2b8\ub864\uc5d0 \uc775\uc219\ud574\uc9c0\ub294 \uac83\uc73c\ub85c \uc2dc\uc791\ud558\uc2ed\uc2dc\uc624. \uac00\uc18d\uc740 \ud654\uba74 \uc624\ub978\ucabd, \uc81c\ub3d9\uc740 \ud654\uba74 \uc67c\ucabd\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \"\uacbd\ub825 \ubaa8\ub4dc\"\uc5d0\uc11c \uc5f0\uc2b5\ud558\uc5ec \ucee8\ud2b8\ub864\uc5d0 \ub300\ud55c \uac10\uac01\uc744 \uc775\ud788\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \"\uace0\uc18d\ub3c4\ub85c\" \ub808\ubca8\uc5d0\uc11c \ucc28\ub7c9\uc744 \ud53c\ud558\uba74\uc11c \uafb8\uc900\ud55c \uc18d\ub3c4\ub97c \uc720\uc9c0\ud574 \ubcf4\uc2ed\uc2dc\uc624. \ubd80\ub4dc\ub7ec\uc6b4 \uc785\ub825\uc774 \ucee8\ud2b8\ub864\uc758 \ud5a5\uc0c1\uc73c\ub85c \uc5f0\uacb0\ub428\uc744 \uae30\uc5b5\ud558\uc2ed\uc2dc\uc624. \ub610\ud55c \"\uc635\uc158\" \uba54\ub274\uc5d0\uc11c \uc801\uc808\ud55c \ud3b8\uc758 \uc218\uc900\uc5d0 \ub9de\ucdb0 \uac10\ub3c4 \uc124\uc815\uc744 \uc870\uc815\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ud2b8\ub798\ud53d \ub77c\uc774\ub354\uc5d0\uc11c \uc5ec\ub7ec \ub300\uc758 \ucc28\ub7c9\uc744 \ucd94\uc6d4\ud558\uc5ec \ucda9\ub3cc \uc5c6\uc774 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud2b8\ub798\ud53d \ub77c\uc774\ub354\uc5d0\uc11c \uc5ec\ub7ec \ub300\uc758 \ucc28\ub7c9\uc744 \ucd94\uc6d4\ud558\ub824\uba74 \ud0c0\uc774\ubc0d\uacfc \uc815\ubc00\uc131\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \uad50\ud1b5 \ud750\ub984\uc758 \ube48\ud2c8\uc744 \ud30c\uc545\ud569\ub2c8\ub2e4. STEP2: \uc55e \ucc28\ub7c9\uc758 \uc18d\ub3c4\uc5d0 \ub9de\ucdb0 \ubd80\ub4dc\ub7fd\uac8c \uac00\uc18d\ud569\ub2c8\ub2e4. STEP3: \uc881\uc740 \uacf5\uac04\uc744 \uc6c0\uc9c1\uc774\uae30 \uc704\ud574 \"\uae30\uc6b8\uae30\" \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ub3c4\uc2dc\" \ub808\ubca8\uc5d0\uc11c \uc790\ub3d9\ucc28\uc758 \uc6c0\uc9c1\uc784\uc744 \uc608\uce21\ud558\uace0 \"\uae30\uc6b8\uae30\"\ub97c \uc0ac\uc6a9\ud558\uc5ec \ucc28\ub7c9 \uc0ac\uc774\ub97c \ubbf8\ub044\ub7ec\uc9c0\ub4ef \uc9c0\ub098\uac00\uc2ed\uc2dc\uc624. \ub2e4\ub978 \ucc28\ub7c9\uc758 \uac11\uc791\uc2a4\ub7ec\uc6b4 \ucc28\uc120 \ubcc0\uacbd\uc744 \ud53c\ud558\uae30 \uc704\ud574 \ubbf8\ub2c8\ub9f5\uc744 \ud56d\uc0c1 \uc8fc\uc2dc\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ud2b8\ub798\ud53d \ub77c\uc774\ub354\uc5d0\uc11c \uc624\ud1a0\ubc14\uc774\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5a4 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc6b0\uc120\uc2dc\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\ud2b8\ub798\ud53d \ub77c\uc774\ub354\uc5d0\uc11c \uc624\ud1a0\ubc14\uc774\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \uac83\uc740 \uc131\ub2a5\uacfc \uc870\uc791\uc131\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uae30 \uc704\ud574 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \ucd94\uc6d4 \ubc0f \ub808\ubca8 \uc644\ub8cc\ub97c \ube60\ub974\uac8c \ud558\uae30 \uc704\ud574 \uc18d\ub3c4\uc640 \uac00\uc18d\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc6b0\uc120\uc2dc\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \"\uc5d4\uc9c4\" \ubc0f \"\ubc30\uae30\" \uc2dc\uc2a4\ud15c\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uba74 \uc624\ud1a0\ubc14\uc774\uc758 \ucd5c\uace0 \uc18d\ub3c4\uac00 \ud06c\uac8c \ud5a5\uc0c1\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \uace0\uc18d \uc870\uc791 \uc2dc \ub354 \ub098\uc740 \uc81c\uc5b4\ub97c \uc704\ud574 \"\ube0c\ub808\uc774\ud06c\"\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \uac83\ub3c4 \uace0\ub824\ud558\uc2ed\uc2dc\uc624. \uc798 \uc5c5\uadf8\ub808\uc774\ub4dc\ub41c \uc624\ud1a0\ubc14\uc774\ub294 \"\uc0b0\uc545 \ud1b5\uacfc\"\uc640 \uac19\uc740 \uae4c\ub2e4\ub85c\uc6b4 \ub808\ubca8\uc5d0\uc11c \ub208\uc5d0 \ub744\ub294 \ucc28\uc774\ub97c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud2b8\ub798\ud53d \ub77c\uc774\ub354\uc5d0\uc11c \ub808\ubca8\ubcc4 \uad50\ud1b5\ub7c9 \ubc00\ub3c4\ub294 \uc5b4\ub5bb\uac8c \ub2ec\ub77c\uc9c0\uba70, \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5a4 \uc804\ub7b5\uc744 \uc801\uc6a9\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\ud2b8\ub798\ud53d \ub77c\uc774\ub354\uc758 \uad50\ud1b5 \ubc00\ub3c4\ub294 \ub808\ubca8\ubcc4\ub85c \ud06c\uac8c \ub2ec\ub77c\uc9c0\uba70, \uac8c\uc784 \ud50c\ub808\uc774 \uc804\ub7b5\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \"\uace0\uc18d\ub3c4\ub85c\" \ub808\ubca8\uc5d0\uc11c\ub294 \ucc28\ub7c9 \uac04\uaca9\uc774 \ub113\uc9c0\ub9cc \uc18d\ub3c4\uac00 \ube60\ub974\uae30 \ub54c\ubb38\uc5d0 \ube60\ub978 \ubc18\uc751\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ubc18\ub300\ub85c, \"\ub3c4\uc2dc\" \ub808\ubca8\uc5d0\uc11c\ub294 \ubc00\uc9d1\ub41c \uad50\ud1b5 \ub54c\ubb38\uc5d0 \uc2e0\uc911\ud55c \uc6b4\uc804\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ubc24 \ub3c4\uc2dc\"\uc5d0\uc11c\ub294 \ucc28\uc120 \uc900\uc218\uc5d0 \uc9d1\uc911\ud558\uace0 \"\uae30\uc6b8\uae30\" \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uad50\ud1b5\ub7c9 \uc18d\uc744 \uc6c0\uc9c1\uc5ec\uc57c \ud569\ub2c8\ub2e4. \uad50\ud1b5 \ud328\ud134\uc744 \uc608\uce21\ud558\uace0 \uc18d\ub3c4\ub97c \uc870\uc815\ud558\uc5ec \uc804\ub7b5\uc744 \uc801\uc751\uc2dc\ud0a4\uc2ed\uc2dc\uc624."}, {"question": "\"\uacbd\ub825 \ubaa8\ub4dc\"\uc640 \"\ubb34\ud55c \ubaa8\ub4dc\"\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub290 \ubaa8\ub4dc\uac00 \uae30\uc220 \uac1c\ubc1c\uc5d0 \ub354 \uc801\ud569\ud569\ub2c8\uae4c?", "answer": "\ud2b8\ub798\ud53d \ub77c\uc774\ub354\uc758 \"\uacbd\ub825 \ubaa8\ub4dc\"\uc640 \"\ubb34\ud55c \ubaa8\ub4dc\"\ub294 \uc11c\ub85c \ub2e4\ub978 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \"\uacbd\ub825 \ubaa8\ub4dc\"\ub294 \uad6c\uccb4\uc801\uc778 \ubaa9\ud45c\uc640 \ub808\ubca8\ub85c \uad6c\uc131\ub418\uc5b4 \uc788\uc5b4 \uae30\uc220 \uac1c\ubc1c\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc2dc\uace8\" \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uba74 \ub2e4\uc591\ud55c \uad50\ud1b5\ub7c9\uc774 \uc788\ub294 \uae34 \ub3c4\ub85c \uad6c\uac04\uc744 \ucc98\ub9ac\ud558\ub294 \ubc29\ubc95\uc744 \ubc30\uc6b0\uac8c \ub429\ub2c8\ub2e4. \ubc18\uba74 \"\ubb34\ud55c \ubaa8\ub4dc\"\ub294 \uc0dd\uc874 \ubc0f \uac70\ub9ac\uc5d0 \ucd08\uc810\uc744 \ub9de\ucd94\uba70, \uc778\ub0b4\uc2ec\uacfc \uc801\uc751\ub825\uc744 \uc2dc\ud5d8\ud569\ub2c8\ub2e4. \uae30\uc220 \uac1c\ubc1c\uc744 \uc704\ud574\uc11c\ub294 \"\uacbd\ub825 \ubaa8\ub4dc\"\uac00 \uc810\uc9c4\uc801\uc778 \ud559\uc2b5 \uace1\uc120\uc744 \uc81c\uacf5\ud558\uae30 \ub54c\ubb38\uc5d0 \ucd94\ucc9c\ub429\ub2c8\ub2e4."}, {"question": "\ud2b8\ub798\ud53d \ub77c\uc774\ub354\uc5d0\uc11c \ucd5c\uace0 \uc810\uc218\uc640 \ucd5c\uc18c \uc2dc\uac04\uc744 \ub2ec\uc131\ud558\uae30 \uc704\ud574 \uacbd\ub85c\ub97c \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud2b8\ub798\ud53d \ub77c\uc774\ub354\uc5d0\uc11c \uacbd\ub85c\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc804\ub7b5\uc801\uc778 \uacc4\ud68d\uacfc \uc2e4\ud589\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \uc9c0\ub3c4\ub97c \uc5f0\uad6c\ud558\uc5ec \uac00\uc7a5 \ube60\ub978 \ucc28\uc120\uc744 \ud30c\uc545\ud569\ub2c8\ub2e4. STEP2: \"\uae30\uc6b8\uae30\" \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc18d\ub3c4\ub97c \ub2a6\ucd94\uc9c0 \uc54a\uace0 \uad50\ud1b5\ub7c9\uc744 \ud1b5\uacfc\ud569\ub2c8\ub2e4. STEP3: \ubd88\ud544\uc694\ud55c \ucc28\uc120 \ubcc0\uacbd\uc744 \ud53c\ud558\uba74\uc11c \uace0\uc18d\uc744 \uc720\uc9c0\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uace0\uc18d\ub3c4\ub85c\" \ub808\ubca8\uc5d0\uc11c\ub294 \uc67c\ucabd \ucc28\uc120\uc744 \uc720\uc9c0\ud558\uba74 \uc885\uc885 \uc7a5\uc560\ubb3c\uc774 \uc801\uace0 \uc810\uc218\uac00 \ub192\uc544\uc9d1\ub2c8\ub2e4. \ub610\ud55c \uae34\uae09\ud55c \uc0c1\ud669\uc5d0\uc11c \"\ubd80\uc2a4\ud2b8\" \uac15\ud654 \uc544\uc774\ud15c\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc5ec \uc774\uc810\uc744 \uc5bb\uc73c\uc2ed\uc2dc\uc624."}, {"question": "\ud2b8\ub798\ud53d \ub77c\uc774\ub354\uc758 \"\ubd80\uc2a4\ud2b8\" \uac15\ud654 \uc544\uc774\ud15c\uc758 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud2b8\ub798\ud53d \ub77c\uc774\ub354\uc758 \"\ubd80\uc2a4\ud2b8\" \uac15\ud654 \uc544\uc774\ud15c\uc740 \uc624\ud1a0\ubc14\uc774\uc758 \uc18d\ub3c4\ub97c \uc77c\uc2dc\uc801\uc73c\ub85c \uc99d\uac00\uc2dc\ucf1c \ube60\ub978 \ucd94\uc6d4\uacfc \uac70\ub9ac \ud655\ubcf4\ub97c \uac00\ub2a5\ud558\uac8c \ud569\ub2c8\ub2e4. \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub824\uba74 \ub3c4\ub85c\uac00 \ub9c9\ud788\uc9c0 \uc54a\uc740 \uad6c\uac04\uc774\ub098 \uc5ec\ub7ec \ub300\uc758 \ucc28\ub7c9\uc744 \ucd94\uc6d4\ud574\uc57c \ud560 \ub54c \"\ubd80\uc2a4\ud2b8\"\ub97c \ud65c\uc131\ud654\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \"\uc0b0\uc545 \ud1b5\uacfc\" \ub808\ubca8\uc5d0\uc11c \"\ubd80\uc2a4\ud2b8\"\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc77c\ub828\uc758 \uc881\uc740 \ucf54\ub108\ub97c \ube60\ub974\uac8c \ud1b5\uacfc\ud558\uc2ed\uc2dc\uc624. \"\ubd80\uc2a4\ud2b8\"\uc5d0\ub294 \uc7ac\ucda9\uc804 \uc2dc\uac04\uc774 \uc788\uc73c\ubbc0\ub85c \ucd5c\ub300 \ud6a8\uacfc\ub97c \ub0b4\uae30 \uc704\ud574 \uc2e0\uc911\ud558\uac8c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ud2b8\ub798\ud53d \ub77c\uc774\ub354\uc758 \uac8c\uc784 \ubb3c\ub9ac \uc5d4\uc9c4\uc740 \uc870\uc791\uc131\uacfc \ucda9\ub3cc \uac10\uc9c0\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ud2b8\ub798\ud53d \ub77c\uc774\ub354\uc758 \ubb3c\ub9ac \uc5d4\uc9c4\uc740 \uc870\uc791\uc131\uacfc \ucda9\ub3cc \uac10\uc9c0\uc5d0 \uc911\uc694\ud55c \uc5ed\ud560\uc744 \ud569\ub2c8\ub2e4. \uc2e4\uc81c \ubb3c\ub9ac\ud559\uc744 \uc2dc\ubbac\ub808\uc774\uc158\ud558\uc5ec \uc624\ud1a0\ubc14\uc774\uac00 \uac00\uc18d, \uc81c\ub3d9 \ubc0f \uae30\uc6b8\uae30\uc5d0 \uc5b4\ub5bb\uac8c \ubc18\uc751\ud558\ub294\uc9c0\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ub3c4\uc2dc\" \ub808\ubca8\uc5d0\uc11c\ub294 \ubb3c\ub9ac \uc5d4\uc9c4\uc774 \uac11\uc791\uc2a4\ub7ec\uc6b4 \uc815\uc9c0\ub098 \uae09\uaca9\ud55c \ud68c\uc804\uc73c\ub85c \uc778\ud574 \ud604\uc2e4\uc801\uc778 \ubbf8\ub044\ub7ec\uc9d0\uc774 \ubc1c\uc0dd\ud569\ub2c8\ub2e4. \ucda9\ub3cc \uac10\uc9c0\ub294 \uc815\ud655\ud558\uba70, \ub2e4\ub978 \ucc28\ub7c9\uacfc\uc758 \ubbf8\uc138\ud55c \uc811\ucd09\ub3c4 \uc6c0\uc9c1\uc784\uc744 \ubc29\ud574\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\uba74 \ub354\uc6b1 \ud6a8\uacfc\uc801\uc73c\ub85c \uc8fc\ud589\ud558\uace0 \ucda9\ub3cc\uc744 \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \ud2b8\ub798\ud53d \ub77c\uc774\ub354\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \ub54c \ud638\ud658\uc131 \ubb38\uc81c\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud574\uacb0\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \ud2b8\ub798\ud53d \ub77c\uc774\ub354\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\ub294 \ub370\ub294 \ud638\ud658\uc131 \ubb38\uc81c\uac00 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc73c\uba70, \uc8fc\ub85c \uacc4\uc815 \uc2dc\uc2a4\ud15c \ubc0f \ub370\uc774\ud130 \uc800\uc7a5 \ubc29\uc2dd\uc758 \ucc28\uc774 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc774 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\ub824\uba74 \ub450 \ud50c\ub7ab\ud3fc \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc548\ub4dc\ub85c\uc774\ub4dc\uc5d0\uc11c iOS\ub85c \uc774\ub3d9\ud558\ub294 \uacbd\uc6b0 \ub3d9\uc77c\ud55c \uad6c\uae00 \ud50c\ub808\uc774 \ub610\ub294 \uc560\ud50c ID\ub97c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \ub610\ud55c \ub370\uc774\ud130 \uc804\uc1a1\uc5d0 \uc601\ud5a5\uc744 \uc904 \uc218 \uc788\ub294 \ud50c\ub7ab\ud3fc\ubcc4 \uc5c5\ub370\uc774\ud2b8 \ub610\ub294 \ud328\uce58\ub97c \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uacbd\uc6b0\uc5d0 \ub530\ub77c \uc218\ub3d9 \ub370\uc774\ud130 \ubc31\uc5c5 \ubc0f \ubcf5\uc6d0\uc774 \uc6d0\ud65c\ud55c \uc804\ud658\uc744 \ubcf4\uc7a5\ud558\ub294 \ub370 \ud544\uc694\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud2b8\ub798\ud53d \ub77c\uc774\ub354\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8 \ub610\ub294 \ube44\ubc00 \uae30\ub2a5\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub098\uc694?", "answer": "\ud2b8\ub798\ud53d \ub77c\uc774\ub354\uc5d0\ub294 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uae4a\uc774\ub97c \ub354\ud558\ub294 \uc5ec\ub7ec \uac1c\uc758 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uc640 \ube44\ubc00 \uae30\ub2a5\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc2dc\uace8\" \ub808\ubca8\uc5d0\uc11c\ub294 \uacbd\ub85c\uc758 \uc0c1\ub2f9 \ubd80\ubd84\uc744 \uc6b0\ud68c\ud558\ub294 \uc228\uaca8\uc9c4 \uc9c0\ub984\uae38\uc744 \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \ud2b9\uc815 \uc624\ud1a0\ubc14\uc774\uc5d0\ub294 \uc989\uc2dc \uba85\ud655\ud558\uc9c0 \uc54a\uc740 \uace0\uc720\ud55c \uc0ac\uc6b4\ub4dc \ud6a8\uacfc \ub610\ub294 \uc2dc\uac01\uc801 \uc870\uc815\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uc694\uc18c\ub294 \ud0d0\ud5d8\uc744 \uc7a5\ub824\ud558\uace0 \uc775\uc219\ud55c \ub808\ubca8\uc5d0 \ub300\ud55c \uc0c8\ub85c\uc6b4 \uc2dc\uac01\uc744 \uc81c\uacf5\ud558\uc5ec \uc5f4\uc815\uc801\uc778 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ub354\uc6b1 \ud48d\ubd80\ud55c \uacbd\ud5d8\uc744 \uc120\uc0ac\ud569\ub2c8\ub2e4."}]
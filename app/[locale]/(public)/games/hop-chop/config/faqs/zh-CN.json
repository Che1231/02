[{"question": "\u65b0\u624b\u95ee\u9898\uff1a\u5982\u4f55\u5728\u300a\u8df3\u780d\u65b0\u661f\u300b\u4e2d\u8fdb\u884c\u57fa\u672c\u8df3\u780d\uff1f", "answer": "\u6b22\u8fce\u6765\u5230\u300a\u8df3\u780d\u65b0\u661f\u300b\uff01\u8fdb\u884c\u8df3\u8dc3\u5f88\u7b80\u5355\uff1a\u6309\u7a7a\u683c\u952e\uff08\u6216\u63a7\u5236\u5668\u4e0a\u7684A\u952e\uff09\u3002\u8981\u6267\u884c\u780d\u51fb\uff0c\u8bf7\u5728\u7a7a\u4e2d\u6309C\u952e\uff08\u6216\u63a7\u5236\u5668\u4e0a\u7684X\u952e\uff09\u3002\u4f8b\u5982\uff0c\u5728\u6559\u7a0b\u5173\u5361\u4e2d\uff0c\u8df3\u8fc7\u7b2c\u4e00\u4e2a\u95f4\u9699\uff0c\u7136\u540e\u7acb\u5373\u6309C\u952e\u780d\u6389\u6728\u677f\uff0c\u8fd9\u6837\u4f60\u5c31\u53ef\u4ee5\u7ee7\u7eed\u524d\u8fdb\u3002\u8fd9\u4e2a\u57fa\u672c\u7ec4\u5408\u5bf9\u4e8e\u901a\u5173\u65e9\u671f\u5173\u5361\u81f3\u5173\u91cd\u8981\u3002\n\u6539\u8fdb\u5efa\u8bae\uff1a\u5229\u7528\u6e38\u620f\u4e2d\u7684\u6559\u7a0b\u63d0\u793a\u4f5c\u4e3a\u89c6\u89c9\u53c2\u8003\u3002\u5b83\u4eec\u4f1a\u663e\u793a\u6240\u9700\u7684\u7cbe\u786e\u6309\u952e\u3002\u53ef\u4ee5\u628a\u5b83\u770b\u4f5c\u662f\u5d4c\u5165\u5230\u6e38\u620f\u73a9\u6cd5\u4e2d\u7684\u8ff7\u4f60\u8bfe\u7a0b\u3002"}, {"question": "\u300a\u8df3\u780d\u65b0\u661f\u300b\u4e2d\u7684\u654c\u4eba\u7c7b\u578b\u6709\u54ea\u4e9b\uff1f\u4f5c\u4e3a\u65b0\u624b\uff0c\u6211\u5e94\u8be5\u5982\u4f55\u5e94\u5bf9\u5b83\u4eec\uff1f", "answer": "\u300a\u8df3\u780d\u65b0\u661f\u300b\u7684\u65e9\u671f\u5173\u5361\u4e2d\u6709\u51e0\u79cd\u654c\u4eba\u7c7b\u578b\uff0c\u5305\u62ec\"\u8df3\u8dc3\u8005\"\u3001\"\u722c\u884c\u8005\"\u548c\"\u5c16\u523a\u8005\"\u3002\u8df3\u8dc3\u8005\u53ef\u4ee5\u901a\u8fc7\u76f4\u63a5\u780d\u51fb\u5b83\u4eec\u4e0a\u65b9\u8f7b\u677e\u51fb\u8d25\u3002\u722c\u884c\u8005\u5728\u5730\u9762\u4e0a\u7f13\u6162\u79fb\u52a8\uff1b\u8df3\u8fc7\u5b83\u4eec\u6216\u4ece\u5b89\u5168\u8ddd\u79bb\u780d\u51fb\u3002\u5c16\u523a\u8005\u662f\u9759\u6b62\u7684\uff0c\u4f46\u6709\u5c16\u523a\uff1b\u901a\u8fc7\u8c28\u614e\u5730\u4ece\u4fa7\u9762\u8fdb\u884c\u780d\u51fb\u6765\u907f\u514d\u76f4\u63a5\u63a5\u89e6\u3002\u4f8b\u5982\uff0c\u57282\u53f7\u5173\u5361\u4e2d\uff0c\u4f60\u5c06\u9047\u5230\u6240\u6709\u4e09\u79cd\u7c7b\u578b\uff0c\u9700\u8981\u5728\u8df3\u8dc3\u3001\u780d\u51fb\u548c\u8c28\u614e\u5b9a\u4f4d\u4e4b\u95f4\u8fdb\u884c\u5207\u6362\u3002\u4f18\u5148\u5904\u7406\u5c16\u523a\u8005\uff0c\u7136\u540e\u5904\u7406\u8df3\u8dc3\u8005\u548c\u722c\u884c\u8005\u3002\n\u6539\u8fdb\u5efa\u8bae\uff1a\u5c06\u6bcf\u79cd\u654c\u4eba\u7c7b\u578b\u89c6\u4e3a\u62fc\u56fe\u7684\u4e00\u90e8\u5206\uff1b\u5f04\u6e05\u695a\u5b83\u4eec\u7684\u5f31\u70b9\u662f\u5173\u952e\u3002\u8bf7\u53c2\u8003\u6e38\u620f\u4e2d\u7684\u654c\u4eba\u56fe\u9274\u4ee5\u83b7\u53d6\u8be6\u7ec6\u4fe1\u606f\u3002"}, {"question": "\u300a\u8df3\u780d\u65b0\u661f\u300b\u8981\u6c42\u7ec4\u5408\uff01\u5bf9\u4e8e\u65b0\u624b\u6765\u8bf4\uff0c\u5982\u4f55\u6700\u7b80\u5355\u5730\u7ec4\u5408\u8df3\u8dc3\u548c\u780d\u51fb\uff1f", "answer": "\u7ec4\u5408\u6700\u7b80\u5355\u7684\u65b9\u6cd5\u662f\u7ec3\u4e60\"\u8df3\u780d\u843d\u5730\"\u5e8f\u5217\u3002\u9996\u5148\uff0c\u8df3\u8dc3\uff08\u7a7a\u683c\u952e/A\u952e\uff09\uff0c\u7136\u540e\u7acb\u5373\u5728\u7a7a\u4e2d\u6309\u780d\u51fb\u952e\uff08C\u952e/X\u952e\uff09\uff0c\u786e\u4fdd\u5b89\u5168\u7740\u9646\u5728\u76ee\u6807\u7269\u6216\u5730\u9762\u4e0a\u3002\u5e73\u7a33\u5730\u91cd\u590d\u6b64\u64cd\u4f5c\u3002\u4f8b\u5982\uff0c\u5c1d\u8bd5\u57283\u53f7\u5173\u5361\u7684\u5e73\u53f0\u4e0a\u7ec3\u4e60\uff0c\u5b83\u4e13\u95e8\u4e3a\u77ed\u7ec4\u5408\u7ec3\u4e60\u800c\u8bbe\u8ba1\u3002\u7ee7\u7eed\u7ec3\u4e60\u8fd9\u4e9b\u6b65\u9aa4\uff0c\u76f4\u5230\u5b83\u6210\u4e3a\u7b2c\u4e8c\u5929\u6027\u3002\n\u6539\u8fdb\u5efa\u8bae\uff1a\u5c06\u52a8\u4f5c\u60f3\u8c61\u4e3a\u4e00\u4e2a\u8fde\u7eed\u7684\u52a8\u4f5c\uff0c\u800c\u4e0d\u662f\u72ec\u7acb\u7684\u6307\u4ee4\u3002\u5c1d\u8bd5\u4fee\u6539\u8df3\u8dc3\u9ad8\u5ea6\u4ee5\u8fdb\u884c\u66f4\u56f0\u96be\u7684\u7ec4\u5408\u3002"}, {"question": "\u300a\u8df3\u780d\u65b0\u661f\u300b\u7b56\u7565\uff1a\u5373\u4f7f\u5728\u66f4\u9ad8\u7ea7\u522b\uff08\u6211\u5df2\u7ecf\u66f4\u5bcc\u6709\u7ecf\u9a8c\uff09\u7684\u60c5\u51b5\u4e0b\uff0c\u5982\u4f55\u6700\u5927\u5316\u300a\u8df3\u780d\u65b0\u661f\u300b\u4e2d\u7684\u5f97\u5206\u500d\u6570\uff1f", "answer": "\u6700\u5927\u5316\u5f97\u5206\u500d\u6570\u9700\u8981\u6218\u7565\u89c4\u5212\u548c\u6267\u884c\u3002\u4ee5\u4e0b\u662f\u4e00\u4e2a\u591a\u6b65\u9aa4\u5206\u89e3:\n\u6b65\u9aa41\uff1a\u8fde\u6740\uff1a\u5feb\u901f\u8fde\u7eed\u51fb\u8d25\u654c\u4eba\u4ee5\u63d0\u5347\u500d\u6570\u3002\n\u6b65\u9aa42\uff1a\u5229\u7528\u73af\u5883\uff1a\u67d0\u4e9b\u5173\u5361\u5305\u542b\u73af\u5883\u9677\u9631\uff08\u4f8b\u5982\u6389\u843d\u7684\u51b0\u9525\uff09\uff0c\u5f53\u4e0e\u4f60\u7684\u780d\u51fb\u7b56\u7565\u7ed3\u5408\u4f7f\u7528\u65f6\uff0c\u8fd9\u4e9b\u9677\u9631\u4f1a\u5956\u52b1\u989d\u5916\u5206\u6570\uff0c\u4ece\u800c\u500d\u589e\u4f60\u7684\u5f97\u5206\u3002\n\u6b65\u9aa43\uff1a\u6536\u96c6\u54c1\uff1a\u6536\u96c6\u5173\u5361\u4e2d\u6563\u843d\u7684\u5206\u6570\u788e\u7247\u3002\n\u6b65\u9aa44\uff1a\u96f6\u4f24\u5bb3\u6a21\u5f0f\uff1a\u5728\u4e0d\u53d7\u5230\u4f24\u5bb3\u7684\u60c5\u51b5\u4e0b\u6e05\u9664\u533a\u57df\u4f1a\u663e\u8457\u63d0\u5347\u5206\u6570\u3002\u4f8b\u5982\uff0c\u57287\u53f7\u5173\u5361\u4e2d\uff0c\u8fde\u6740\u4e09\u53ea\"\u98de\u7fd4\u63a0\u593a\u8005\"\u5e76\u6536\u96c6\u9644\u8fd1\u7684\u4e09\u5757\u788e\u7247\uff0c\u800c\u4e14\u5728\u5b8c\u6210\u780d\u6740\u671f\u95f4\u4e0d\u53d7\u5230\u4f24\u5bb3\uff0c\u53ef\u4ee5\u8f7b\u677e\u5c06\u4f60\u7684\u5206\u6570\u7ffb\u500d\u3002\u8bf7\u8003\u8651\uff0c\u96f6\u4f24\u5bb3\u662f\u9996\u8981\u56e0\u7d20\uff0c\u5176\u6b21\u662f\u654c\u4eba\u7684\u6570\u91cf\u3002", "Enhancement": "\u5728\u4f60\u7684\u8111\u6d77\u4e2d\u60f3\u8c61\u4e00\u4e2a\u5f97\u5206\u500d\u6570\u7684\"\u70ed\u529b\u56fe\"\uff0c\u4ee5\u8bc6\u522b\u6700\u4f73\u7684\u8fde\u6740\u8def\u7ebf\u3002"}, {"question": "\u9ad8\u7ea7\u300a\u8df3\u780d\u65b0\u661f\u300b\uff1a\u4e3a\u4ec0\u4e48\u7406\u89e3\u654c\u4eba\u5f31\u70b9\u6a21\u5f0f\u5bf9\u4e8e\u300a\u8df3\u780d\u65b0\u661f\u300b\u7684\u5feb\u901f\u901a\u5173\u81f3\u5173\u91cd\u8981\uff1f\u54ea\u79cd\u654c\u4eba\u4f1a\u63d0\u4f9b\u6700\u4f73\u7684\u7701\u65f6\u673a\u4f1a\uff1f", "answer": "\u7406\u89e3\u654c\u4eba\u5f31\u70b9\u6a21\u5f0f\u5bf9\u4e8e\u5feb\u901f\u901a\u5173\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u5141\u8bb8\u9ad8\u6548\u4e14\u6700\u5927\u9650\u5ea6\u51cf\u5c11\u98ce\u9669\u7684\u64cd\u4f5c\u3002\u77e5\u9053\u4f55\u65f6\u780d\u51fb\u3001\u8df3\u8dc3\u6216\u8eb2\u907f\u53ef\u4ee5\u8282\u7701\u5b9d\u8d35\u7684\u65f6\u95f4\u3002\"\u4f20\u9001\u8005\"\u654c\u4eba\u63d0\u4f9b\u4e86\u6700\u597d\u7684\u673a\u4f1a\u3002\u5982\u679c\u4f60\u80fd\u780d\u51fb\u6765\u6253\u65ad\u4ed6\u4eec\u7684\u4f20\u9001\u5e8f\u5217\uff0c\u4f60\u53ef\u4ee5\u5728\u4ed6\u4eec\u91cd\u65b0\u5b9a\u4f4d\u4e4b\u524d\u51fb\u8d25\u4ed6\u4eec\uff0c\u4ece\u800c\u8282\u7701\u51e0\u79d2\u949f\u3002\u4ee5\u4e0b\u662f\u64cd\u4f5c\u65b9\u6cd5\uff1a\u4f60\u5e0c\u671b\u9884\u6d4b\u524d\u4e09\u6b21\u4f20\u9001\u9636\u6bb5\uff0c\u4ee5\u4fbf\u5728\u4f20\u9001\u4e4b\u524d\u6d88\u9664\u5b83\u3002\u7136\u540e\uff0c\u5728\u4ed6\u4eec\u77ed\u6682\u7684\u5f31\u70b9\u671f\u95f4\u780d\u51fb\uff0c\u5b8c\u5168\u907f\u514d\u4f20\u9001\u3002\u591a\u52a0\u7ec3\u4e60\uff0c\u8fd9\u5c06\u6210\u4e3a\u7b2c\u4e8c\u5929\u6027\u3002\u901f\u5ea6\u662f\u5173\u952e\uff0c\u4f46\u8d44\u6e90\u7ba1\u7406\u4e5f\u5f88\u91cd\u8981\u3002", "Enhancement": "\u8bb0\u5f55\u4f60\u7684\u5c1d\u8bd5\uff0c\u5e76\u9010\u5e27\u5206\u6790\u4ee5\u8bc6\u522b\u5fae\u4f18\u5316\u3002"}, {"question": "\u300a\u8df3\u780d\u65b0\u661f\u300b\u6280\u672f\uff1a\u4e3a\u4e86\u89e3\u9501\u6240\u6709\u53ef\u7528\u7684\u76ae\u80a4\uff0c\u5728\u300a\u8df3\u780d\u65b0\u661f\u300b\u4e2d\u83b7\u5f97\"\u780d\u51fb\u786c\u5e01\"\u7684\u6700\u6709\u6548\u65b9\u6cd5\u662f\u4ec0\u4e48\uff1f\u96be\u5ea6\u8bbe\u7f6e\u5982\u4f55\u5f71\u54cd\u6389\u843d\u7387\uff1f", "answer": "\u83b7\u5f97\"\u780d\u51fb\u786c\u5e01\"\u7684\u6700\u6709\u6548\u65b9\u6cd5\u662f\u91cd\u73a94\u53f7\u5173\u5361\u7684\"\u56f0\u96be\"\u96be\u5ea6\u3002\"\u56f0\u96be\"\u96be\u5ea6\u4e0b\"\u780d\u51fb\u786c\u5e01\"\u7684\u6389\u843d\u7387\u66f4\u9ad8\u3002\u4e13\u6ce8\u4e8e\u6700\u5927\u5316\u5f97\u5206\u500d\u6570\uff0c\u901a\u8fc7\u8fde\u6740\u548c\u6536\u96c6\u6240\u6709\u786c\u5e01\u3002\u5ffd\u7565\u989d\u5916\u76ee\u6807\uff0c\u4f18\u5148\u6536\u96c6\u786c\u5e01\u5e76\u5feb\u901f\u5b8c\u6210\u5173\u5361\u3002\u5e73\u5747\u800c\u8a00\uff0c\u57284\u53f7\u5173\u5361\u7684\u5b8c\u7f8e\u901a\u5173\u4e2d\u4f1a\u83b7\u5f97\u5927\u7ea650\u679a\u780d\u51fb\u786c\u5e01\u3002\u4f60\u4f1a\u6ce8\u610f\u5230\uff0c\u96be\u5ea6\u589e\u52a0\u4f7f\u901a\u5e38\u7684\u786c\u5e01\u6389\u843d\u7387\u589e\u52a0\u4e86\u4e00\u500d\u4ee5\u4e0a\u3002\u8fd9\u4e0e\u5feb\u901f\u5173\u5361\u5b8c\u6210\u76f8\u4e58\uff0c\u6548\u7387\u5f88\u9ad8\u3002\n\u6539\u8fdb\u5efa\u8bae\uff1a\u521b\u5efa\"\u786c\u5e01\u6536\u96c6\u8def\u7ebf\"\u5730\u56fe\u4ee5\u786e\u4fdd\u6709\u6548\u5bfc\u822a\u3002"}, {"question": "\u300a\u8df3\u780d\u65b0\u661f\u300b\u673a\u5236\uff1a\u300a\u8df3\u780d\u65b0\u661f\u300b\u4e2d\u7684\"\u52a8\u91cf\"\u673a\u5236\u5982\u4f55\u5f71\u54cd\u73a9\u5bb6\u7684\u8df3\u8dc3\u8ddd\u79bb\u548c\u780d\u51fb\u5f3a\u5ea6\uff1f\u5176\u80cc\u540e\u7684\u516c\u5f0f\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u8df3\u780d\u65b0\u661f\u300b\u4e2d\u7684\"\u52a8\u91cf\"\u673a\u5236\u76f4\u63a5\u5f71\u54cd\u8df3\u8dc3\u8ddd\u79bb\u548c\u780d\u51fb\u5f3a\u5ea6\u3002\u5f53\u4ee5\u9ad8\u901f\u5ea6\u79fb\u52a8\u65f6\uff0c\u4f60\u7684\u8df3\u8dc3\u8ddd\u79bb\u4f1a\u6210\u6bd4\u4f8b\u589e\u52a0\u3002\u4f60\u7684\u780d\u51fb\u529b\u4e5f\u4f1a\u589e\u5f3a\u3002\u8df3\u8dc3\u8ddd\u79bb\u7684\u516c\u5f0f\u662fd = v * t + 0.5 * a * t^2\u3002\u780d\u51fb\u5f3a\u5ea6\u4f1a\u968f\u7740\u52a8\u91cf\u7684\u589e\u52a0\u800c\u6bcf5\u4e2a\u5355\u4f4d\u589e\u52a01\u3002\u80cc\u540e\u516c\u5f0f\u5f88\u590d\u6742\u3002\u4f60\u53ef\u4ee5\u901a\u8fc7\u5b9e\u9a8c\u73af\u5883\u6765\u5224\u65ad\u8fd9\u4e00\u70b9\u3002\n\u6539\u8fdb\u5efa\u8bae\uff1a\u5728\u503e\u659c\u9762\u4e0a\u7ec3\u4e60\"\u52a8\u91cf\u51b2\u6d6a\"\uff0c\u611f\u53d7\u5230\u4e0d\u540c\u901f\u5ea6\u4e0b\u7684\u533a\u522b\u3002"}, {"question": "\u300a\u8df3\u780d\u65b0\u661f\u300b\u6df1\u5165\u63a2\u8ba8\uff1a\"\u9002\u5e94\u6027\u96be\u5ea6\"\u7cfb\u7edf\u5982\u4f55\u5f71\u54cd\u300a\u8df3\u780d\u65b0\u661f\u300b\u4e2d\u591a\u4e2a\u6e38\u620f\u8fc7\u7a0b\u4e2d\u7684\u654c\u4eba\u884c\u4e3a\u6a21\u5f0f\uff0c\u5c24\u5176\u662f\u5728\u5148\u524d\u5c1d\u8bd5\u4e2d\u83b7\u5f97\u66f4\u9ad8\u5206\u6570\u4e4b\u540e\uff1f", "answer": "\"\u9002\u5e94\u6027\u96be\u5ea6\"\u7cfb\u7edf\u4f1a\u6839\u636e\u4f60\u4e4b\u524d\u7684\u6700\u9ad8\u5206\u6570\u8c03\u6574\u654c\u4eba\u7684\u653b\u51fb\u6027\u548c\u5237\u65b0\u901f\u5ea6\u3002\u968f\u7740\u4f60\u7684\u5206\u6570\u63d0\u9ad8\uff0c\u654c\u4eba\u5c06\u7f29\u77ed\u63d0\u793a\u65f6\u95f4\uff0c\u6574\u4f53\u884c\u52a8\u901f\u5ea6\u4e5f\u4f1a\u52a0\u5feb\u3002\u4f8b\u5982\uff0c\u5728\u83b7\u5f9710\u4e07\u5206\u540e\uff0c\"\u8df3\u8dc3\u8005\"\u4f1a\u589e\u52a0\u4e00\u6b21\u8df3\u8dc3\uff0c\"\u722c\u884c\u8005\"\u7684\u79fb\u52a8\u901f\u5ea6\u4f1a\u63d0\u9ad8\u4e24\u500d\u3002\u8fd9\u610f\u5473\u7740\u4f60\u9700\u8981\u66f4\u52a0\u5c0f\u5fc3\u548c\u6218\u672f\u5316\u5730\u5bf9\u4ed8\u654c\u4eba\u3002\u8fd9\u79cd\u9002\u5e94\u6027\u8c03\u6574\u786e\u4fdd\u4e86\u6301\u7eed\u5177\u6709\u6311\u6218\u6027\u7684\u6e38\u620f\u4f53\u9a8c\u3002\n\u6539\u8fdb\u5efa\u8bae\uff1a\u8bb0\u5f55\u4e0d\u540c\u5206\u6570\u7b49\u7ea7\u4e0b\u7684\u654c\u4eba\u79fb\u52a8\u901f\u5ea6\u548c\u9891\u7387\u3002"}, {"question": "\u300a\u8df3\u780d\u65b0\u661f\u300b\u8de8\u5e73\u53f0\u95ee\u9898\uff1aPC\u7248\u548c\u4efb\u5929\u5802Switch\u7248\u300a\u8df3\u780d\u65b0\u661f\u300b\u4e4b\u95f4\u662f\u5426\u6709\u8de8\u5e73\u53f0\u6e38\u620f\u6216\u8de8\u5e73\u53f0\u8fdb\u5ea6\u652f\u6301\uff1f", "answer": "\u4e0d\u5e78\u7684\u662f\uff0c\u300a\u8df3\u780d\u65b0\u661f\u300b\u76ee\u524d\u4e0d\u652f\u6301PC\u7248\u548c\u4efb\u5929\u5802Switch\u7248\u4e4b\u95f4\u7684\u8de8\u5e73\u53f0\u6e38\u620f\u6216\u8de8\u8fdb\u5ea6\u652f\u6301\uff0c\u8fd9\u662f\u7531\u4e8e\u67b6\u6784\u5dee\u5f02\u9020\u6210\u7684\u3002\u4e0d\u540c\u5e73\u53f0\u7684\u5b58\u6863\u6570\u636e\u683c\u5f0f\u4e0d\u540c\uff0c\u8fd9\u4f7f\u5f97\u540c\u6b65\u5f88\u56f0\u96be\u3002\u4f60\u5728PC\u4e0a\u4f1a\u83b7\u5f97\u6700\u4f73\u6027\u80fd\uff1b\u56e0\u6b64\u8fd9\u53d6\u51b3\u4e8e\u4f60\u7684\u4f18\u5148\u7ea7\u3002\u6240\u4ee5\uff0c\u5982\u679c\u4f60\u5728\u4e00\u4e2a\u5e73\u53f0\u4e0a\u5f00\u59cb\uff0c\u4e0d\u540c\u7684\u5e73\u53f0\u5c06\u6ca1\u6709\u8de8\u5b58\u6863\u517c\u5bb9\u6027\u3002\n\u6539\u8fdb\u5efa\u8bae\uff1a\u67e5\u770b\u5b98\u65b9\u300a\u8df3\u780d\u65b0\u661f\u300b\u7f51\u7ad9\u548c\u793e\u4ea4\u5a92\u4f53\uff0c\u4e86\u89e3\u6709\u5173\u8de8\u5e73\u53f0\u529f\u80fd\u7684\u6f5c\u5728\u672a\u6765\u66f4\u65b0\u3002"}, {"question": "\u300a\u8df3\u780d\u65b0\u661f\u300b\u5f69\u86cb\uff1a\u5728\u300a\u8df3\u780d\u65b0\u661f\u300b\u4e2d\u662f\u5426\u5b58\u5728\u4efb\u4f55\u9690\u85cf\u7684\"\u780d\u51fb\u4ea4\u6362\"\u6311\u6218\u6216\u901a\u8fc7\u7279\u5b9a\u52a8\u4f5c\u89e3\u9501\u7684\u9690\u85cf\u89d2\u8272\uff0c\u8fd9\u4e9b\u89d2\u8272\u53ef\u80fd\u4e0e\u9690\u85cf\u7684\u5f69\u86cb\u7269\u54c1\u6709\u5173\uff1f\u4f60\u80fd\u63d0\u4f9b\u6709\u5173\u5982\u4f55\u89e6\u53d1\u6b64\u7c7b\u5185\u5bb9\u7684\u5177\u4f53\u8bf4\u660e\u5417\uff1f", "answer": "\u662f\u7684\uff01\u901a\u8fc7\u627e\u5230\u5e76\u6fc0\u6d3b\u7b2c\u4e00\u5230\u4e09\u5173\u4e2d\u6563\u5e03\u7684\u4e09\u4e2a\u9690\u85cf\u7684\"\u50cf\u7d20\u788e\u7247\"\uff0c\u53ef\u4ee5\u89e3\u9501\u9690\u85cf\u89d2\u8272\"\u590d\u53e4\u780d\u624b\"\u3002\u6bcf\u4e2a\u788e\u7247\u90fd\u4f4d\u4e8e\u7a0d\u504f\u79bb\u6b63\u8f68\u7684\u533a\u57df\uff0c\u9700\u8981\u7cbe\u786e\u7684\u8df3\u8dc3\u548c\u73af\u5883\u4e92\u52a8\u3002\u50cf\u7d20\u788e\u72471\u9690\u85cf\u5728\u4e00\u4e2a\u9700\u8981\u7279\u5b9a\u7ec4\u5408\u624d\u80fd\u6253\u5f00\u7684\u53ef\u7834\u574f\u5899\u540e\u9762\u3002\u50cf\u7d20\u788e\u72472\u4f4d\u4e8e\u4e00\u68f5\u5927\u6811\u7684\u9876\u7aef\uff0c\u4f60\u9700\u8981\u780d\u50125\u68f5\u8f83\u5c0f\u7684\u6811\u6728\u624d\u80fd\u83b7\u5f97\u8db3\u591f\u7684\u9ad8\u5ea6\u3002\u50cf\u7d20\u788e\u72473\u4f4d\u4e8e\u5730\u4e0b\u88c2\u7f1d\u4e2d\uff0c\u4f60\u9700\u8981\u4f7f\u7528\u66f4\u5f3a\u529b\u7684\u8fde\u7eed\u780d\u51fb\u654c\u4eba\u3002\u6fc0\u6d3b\u540e\uff0c\u8bbf\u95ee\u4e3b\u83dc\u5355\uff0c\u4f60\u5c06\u770b\u5230\"\u590d\u53e4\u780d\u624b\"\u53ef\u4f9b\u9009\u62e9\u3002\n\u6539\u8fdb\u5efa\u8bae\uff1a\"\u590d\u53e4\u780d\u624b\"\u4f7f\u75288\u4f4d\u97f3\u6548\u548c\u590d\u53e4\u50cf\u7d20\u827a\u672f\u76ae\u80a4\u3002"}]
[{"question": "\ud638\ud504-\ucc39 \ucd08\ubcf4\uc790 \uc9c8\ubb38: \ud638\ud504-\ucc39\uc5d0\uc11c \uae30\ubcf8 \uc810\ud504\uc640 \ucabc\uac1c\uae30 \uae30\uc220\uc744 \uc5b4\ub5bb\uac8c \uc218\ud589\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud638\ud504-\ucc39\uc5d0 \uc624\uc2e0 \uac83\uc744 \ud658\uc601\ud569\ub2c8\ub2e4! \uc810\ud504\ub294 \uac04\ub2e8\ud569\ub2c8\ub2e4. '\uc2a4\ud398\uc774\uc2a4\ubc14' (\ub610\ub294 \ucee8\ud2b8\ub864\ub7ec\uc758 'A' \ud0a4)\ub97c \ub204\ub974\uc138\uc694. \ucabc\uac1c\uae30\ub97c \ud558\ub824\uba74 \uacf5\uc911\uc5d0 \uc788\ub294 \ub3d9\uc548 'C' \ud0a4 (\ub610\ub294 \ucee8\ud2b8\ub864\ub7ec\uc758 'X' \ud0a4)\ub97c \ub204\ub974\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud29c\ud1a0\ub9ac\uc5bc \ub808\ubca8\uc5d0\uc11c \uccab \ubc88\uc9f8 \ud2c8\uc0c8\ub97c \uc810\ud504\ud558\uace0 \ubc14\ub85c 'C' \ud0a4\ub97c \ub20c\ub7ec \ub098\ubb34 \ud310\uc790\ub97c \ucabc\uac1c\uba74 \uc9c4\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uae30\ubcf8 \uc870\ud569\uc740 \ucd08\uae30 \ub808\ubca8\uc744 \ud0d0\uc0c9\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4.\n\uac1c\uc120 \uc0ac\ud56d: \uac8c\uc784 \ub0b4 \ud29c\ud1a0\ub9ac\uc5bc \uc548\ub0b4\ub97c \uc2dc\uac01\uc801 \ub2e8\uc11c\ub85c \ud65c\uc6a9\ud558\uc138\uc694. \ud544\uc694\ud55c \ud0a4 \uc785\ub825\uc744 \uc815\ud655\ud788 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4. \uc774\uac83\uc740 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc9c1\uc811 \ud3ec\ud568\ub41c \ubbf8\ub2c8 \uac15\uc88c\uc640 \uac19\uc2b5\ub2c8\ub2e4."}, {"question": "\ud638\ud504-\ucc39\uc5d0\uc11c \uc801\uc758 \uc885\ub958\ub294 \ubb34\uc5c7\uc774\uba70, \ucd08\ubcf4 \ud50c\ub808\uc774\uc5b4\uac00 \ud638\ud504-\ucc39\uc5d0\uc11c \uc5b4\ub5bb\uac8c \uc811\uadfc\ud574\uc57c \ud558\ub098\uc694?", "answer": "\ud638\ud504-\ucc39\uc5d0\ub294 '\ubc18\uc9dd\uc774', '\ud30c\uad34\uc790', '\uac00\uc2dc' \ub4f1 \uc5ec\ub7ec \uac00\uc9c0 \ucd08\uae30 \uac8c\uc784 \uc801\uc758 \uc720\ud615\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ubc18\uc9dd\uc774\ub294 \uc801\uc740 \ubc14\ub85c \uadf8 \uc704\uc5d0 \ucabc\uac1c\uc11c \uc27d\uac8c \uc81c\uc555\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud30c\uad34\uc790\ub294 \uc9c0\uc0c1\uc744 \ub530\ub77c \ucc9c\ucc9c\ud788 \uc774\ub3d9\ud569\ub2c8\ub2e4. \uadf8 \uc704\ub85c \uc810\ud504\ud558\uac70\ub098 \uc548\uc804\ud55c \uac70\ub9ac\uc5d0\uc11c \ucabc\uac1c\uc138\uc694. \uac00\uc2dc\ub4e4\uc740 \uace0\uc815\ub418\uc5b4 \uc788\uc9c0\ub9cc \uac00\uc2dc\ub97c \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uce21\uba74\uc5d0\uc11c \uc870\uc2ec\uc2a4\ub7fd\uac8c \ucabc\uac1c\ub294 \ud0c0\uc774\ubc0d\uc744 \ub9de\ucdb0 \uc9c1\uc811\uc801\uc778 \uc811\ucd09\uc744 \ud53c\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 2\uc5d0\uc11c\ub294 \uc774 \uc138 \uac00\uc9c0 \uc720\ud615\uc758 \uc801\ub4e4\uc774 \ubaa8\ub450 \ub4f1\uc7a5\ud558\uc5ec \uc810\ud504, \ucabc\uac1c\uae30 \uadf8\ub9ac\uace0 \uc2e0\uc911\ud55c \uc704\uce58 \uc120\uc815\uc744 \ubc88\uac08\uc544 \uc0ac\uc6a9\ud574\uc57c \ud569\ub2c8\ub2e4. \uc6b0\uc120 \uac00\uc2dc \uc801\uc744 \uc81c\uac70\ud558\uace0 \uadf8\ub2e4\uc74c \ubc18\uc9dd\uc774\uc640 \ud30c\uad34\uc790\ub97c \ucc98\ub9ac\ud558\uc138\uc694.\n\uac1c\uc120 \uc0ac\ud56d: \uac01 \uc801 \uc720\ud615\uc744 \ud37c\uc990 \uc870\uac01\uc73c\ub85c \uc0dd\uac01\ud558\uc138\uc694. \uadf8\ub4e4\uc758 \uc57d\uc810\uc744 \ud30c\uc545\ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uac8c\uc784 \ub0b4 \ubaac\uc2a4\ud130 \ub3c4\uac10\uc744 \ucc38\uace0\ud558\uc138\uc694."}, {"question": "\ud638\ud504-\ucc39\uc740 \uc870\ud569\uc744 \uc694\uad6c\ud569\ub2c8\ub2e4! \ud638\ud504-\ucc39 \ucd08\ubcf4\uc790\uac00 \uc810\ud504\uc640 \ucabc\uac1c\uae30 \uae30\uc220\uc744 \uc5f0\uacb0\ud558\ub294 \uac00\uc7a5 \uac04\ub2e8\ud55c \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00?", "answer": "\uc870\ud569\uc744 \uc5f0\uacb0\ud558\ub294 \uac00\uc7a5 \uc26c\uc6b4 \ubc29\ubc95\uc740 '\uc810\ud504-\ucabc\uac1c\uae30-\ucc29\uc9c0' \uc2dc\ud000\uc2a4\ub97c \uc5f0\uc2b5\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uba3c\uc800 \uc810\ud504(\uc2a4\ud398\uc774\uc2a4\ubc14/A), \uadf8\ub9ac\uace0 \uacf5\uc911\uc5d0 \uc788\ub294 \ub3d9\uc548 \ubc14\ub85c \ucabc\uac1c\uae30(C/X) \ubc84\ud2bc\uc744 \ub204\ub974\uace0 \ub300\uc0c1\uc774\ub098 \uc9c0\uba74\uc5d0 \uc548\uc804\ud558\uac8c \ucc29\uc9c0\ud558\uc138\uc694. \uc774\ub7ec\ud55c \ub3d9\uc791\uc744 \uc6d0\ud65c\ud558\uac8c \ubc18\ubcf5\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud2b9\ud788 \uc9e7\uc740 \uc870\ud569 \uc5f0\uc2b5\uc744 \uc704\ud55c \ub808\ubca8 3 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc774\uac83\uc744 \uc2dc\ub3c4\ud558\uc138\uc694. \uc774 \ub2e8\uacc4\ub97c \uc790\uc5f0\uc2a4\ub7ec\uc6cc\uc9c8 \ub54c\uae4c\uc9c0 \uacc4\uc18d \uc5f0\uc2b5\ud558\uc138\uc694.\n\uac1c\uc120 \uc0ac\ud56d: \uc6c0\uc9c1\uc784\uc744 \ubcc4\ub3c4 \uba85\ub839\uc774 \uc544\ub2cc \ud558\ub098\uc758 \ud750\ub984 \uc788\ub294 \ub3d9\uc791\uc73c\ub85c \uc2dc\uac01\ud654\ud574\ubcf4\uc138\uc694. \uc810\ud504 \ub192\uc774\ub97c \uc870\uc815\ud558\uc5ec \ub354 \uc5b4\ub824\uc6b4 \uc870\ud569\uc744 \uc2dc\ub3c4\ud574 \ubcf4\uc138\uc694."}, {"question": "\ud638\ud504-\ucc39 \uc804\ub7b5: \ud638\ud504-\ucc39\uc5d0\uc11c, \ud2b9\ud788 \ud6c4\ubc18 \ub808\ubca8\uc5d0\uc11c \uacbd\ud5d8\uc774 \uc313\uc600\uc744 \ub54c \uc810\uc218 \uac00\uc911\uce58\ub97c \uadf9\ub300\ud654\ud558\uae30 \uc704\ud55c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc810\uc218 \uac00\uc911\uce58\ub97c \uadf9\ub300\ud654\ud558\ub824\uba74 \uc804\ub7b5\uc801 \uacc4\ud68d\uacfc \uc2e4\ud589\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc774\ub294 \uc5ec\ub7ec \ub2e8\uacc4\ub85c \ub098\ub20c \uc218 \uc788\uc2b5\ub2c8\ub2e4:\n\ub2e8\uacc4 1: \uc5f0\uc1c4 \uacf5\uaca9: \uc801\uc744 \ube60\ub974\uac8c \uc81c\uac70\ud558\uc5ec \uac00\uc911\uce58\ub97c \ub192\uc774\uc138\uc694.\n\ub2e8\uacc4 2: \ud658\uacbd \ud65c\uc6a9: \uc77c\ubd80 \ub808\ubca8\uc5d0\uc11c\ub294 \ucabc\uac1c\uae30\uc640 \ud568\uaed8 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uba74 \ucd94\uac00 \uc810\uc218\ub97c \uc5bb\ub294 \ud658\uacbd\uc801 \uc704\ud5d8 \uc694\uc18c(\uc608: \ub5a8\uc5b4\uc9c0\ub294 \uc5bc\uc74c \uc870\uac01)\uac00 \uc788\uc2b5\ub2c8\ub2e4.\n\ub2e8\uacc4 3: \uc218\uc9d1\ud488: \ub808\ubca8 \uacf3\uacf3\uc5d0 \ud769\uc5b4\uc838 \uc788\ub294 \uc810\uc218 \ub4dc\ub86d\uc744 \uc218\uc9d1\ud558\uc138\uc694.\n\ub2e8\uacc4 4: \ud53c\ud574 \uc5c6\uc774 \ud074\ub9ac\uc5b4: \ud53c\ud574 \uc5c6\uc774 \uc139\uc158\uc744 \ud074\ub9ac\uc5b4\ud558\uba74 \uc0c1\ub2f9\ud55c \uc810\uc218 \ubcf4\ub108\uc2a4\uac00 \uc8fc\uc5b4\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 7\uc5d0\uc11c \uc138 \uba85\uc758 '\ub0a0\uc544\ub2e4\ub2c8\ub294 \uad34\ubb3c'\uc744 \uc81c\uac70\ud558\uace0 \uc778\uadfc \ub4dc\ub86d 3\uac1c\ub97c \ubaa8\ub450 \uc218\uc9d1\ud558\uace0 \ub9de\uc9c0 \uc54a\uc73c\uba74 \uc810\uc218\uac00 \uc27d\uac8c \ub450 \ubc30\uac00 \ub429\ub2c8\ub2e4. \ud53c\ud574\ub97c \uc785\uc9c0 \uc54a\ub294 \uac83\uc774 \uac00\uc7a5 \uc911\uc694\ud55c \uc694\uc18c\uc774\uba70, \uadf8 \ub2e4\uc74c \uc801\uc218\uc5d0 \ub530\ub77c \uc810\uc218 \uc99d\uac00\uac00 \uac00\ub2a5\ud569\ub2c8\ub2e4.", "Enhancement": "\ucd5c\uc801\uc758 \uc5f0\uc1c4 \uacbd\ub85c\ub97c \ucc3e\uae30 \uc704\ud574 \ub9c8\uc74c\uc18d\uc5d0 \uac00\uc911\uce58 '\ud788\ud2b8\ub9f5'\uc744 \uc2dc\uac01\ud654\ud558\uc138\uc694."}, {"question": "\uace0\uae09 \ud638\ud504-\ucc39: \uc801\uc758 \uc57d\uc810 \ud328\ud134\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \ud638\ud504-\ucc39 \uc2a4\ud53c\ub4dc\ub7f0\uc5d0 \ud544\uc218\uc801\uc778 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \ud2b9\uc815 \uc801\uc740 \uc5b4\ub5a4 \uc2dc\uac04 \uc808\uc57d \uae30\ud68c\ub97c \uc81c\uacf5\ud558\ub098\uc694?", "answer": "\uc801\uc758 \uc57d\uc810 \ud328\ud134\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \uc2a4\ud53c\ub4dc\ub7f0\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc65c\ub0d0\ud558\uba74 \ud6a8\uc728\uc801\uc774\uace0 \uc704\ud5d8\uc744 \ucd5c\uc18c\ud654\ud558\ub294 \uc870\uc791\uc744 \uac00\ub2a5\ud558\uac8c \ud558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \ucabc\uac1c\uae30, \uc810\ud504 \ub610\ub294 \ud68c\ud53c \uc2dc\uae30\ub97c \uc544\ub294 \uac83\uc740 \uc18c\uc911\ud55c \uc2dc\uac04\uc744 \uc808\uc57d\ud569\ub2c8\ub2e4. '\ud154\ub808\ud3ec\ud130' \uc801\uc740 \ucd5c\uace0\uc758 \uc2dc\uac04 \uc808\uc57d \uae30\ud68c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ud154\ub808\ud3ec\ud2b8 \uc21c\uc11c\ub97c \ubc29\ud574\ud558\uae30 \uc704\ud574 \ucabc\uac1c\uba74 \uc774\ub3d9\ud558\uae30 \uc804\uc5d0 \uc81c\uac70\ud560 \uc218 \uc788\uace0, \uc5ec\ub7ec \ucd08\ub97c \uc808\uc57d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc5b4\ub5bb\uac8c \ud558\ub294\uc9c0 \uc124\uba85\ud558\uaca0\uc2b5\ub2c8\ub2e4. \ucc98\uc74c \uc138 \uac1c\uc758 \ud154\ub808\ud3ec\ud2b8 \ub2e8\uacc4\ub97c \uc608\uc0c1\ud558\uc5ec \uadf8\uac83\uc744 \uc81c\uac70\ud558\uace0, \uadf8 \ud6c4\uc5d0 \uc9e7\uc740 \ucde8\uc57d\uc131 \ub3d9\uc548 \ucabc\uac1c\uc5b4 \ud154\ub808\ud3ec\ud2b8\ub97c \uc644\uc804\ud788 \ud53c\ud558\uc2ed\uc2dc\uc624. \uc5f0\uc2b5\ud558\uba74 \uc790\uc5f0\uc2a4\ub7ec\uc6cc\uc9d1\ub2c8\ub2e4. \uc18d\ub3c4\ub294 \uc911\uc694\ud558\uc9c0\ub9cc \uc790\uc6d0 \uad00\ub9ac\ub3c4 \uc911\uc694\ud569\ub2c8\ub2e4.", "Enhancement": "\uc2dc\ub3c4\ub97c \uae30\ub85d\ud558\uace0 \ud504\ub808\uc784 \ub2e8\uc704\ub85c \ubd84\uc11d\ud558\uc5ec \ubbf8\uc138 \ucd5c\uc801\ud654\ub97c \uc2dd\ubcc4\ud558\uc138\uc694."}, {"question": "\ud638\ud504-\ucc39 \uae30\uc220: \ubaa8\ub4e0 \uc0ac\uc6a9 \uac00\ub2a5\ud55c \uc2a4\ud0a8\uc744 \ud574\uc81c\ud558\uae30 \uc704\ud574 \ud638\ud504-\ucc39\uc5d0\uc11c '\ucabc\uac1c\uae30 \ucf54\uc778'\uc744 \uac00\uc7a5 \ud6a8\uc728\uc801\uc73c\ub85c \uc218\uc9d1\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc774\uba70, \ub09c\uc774\ub3c4 \uc124\uc815\uc740 \ub4dc\ub78d\ub960\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "'\ucabc\uac1c\uae30 \ucf54\uc778'\uc744 \uac00\uc7a5 \ud6a8\uc728\uc801\uc73c\ub85c \uc218\uc9d1\ud558\ub294 \ubc29\ubc95\uc740 \ub808\ubca8 4\ub97c '\uc5b4\ub824\uc6c0' \ub09c\uc774\ub3c4\ub85c \ubc18\ubcf5\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. '\uc5b4\ub824\uc6c0' \ub09c\uc774\ub3c4\uc5d0\uc11c\ub294 '\ucabc\uac1c\uae30 \ucf54\uc778'\uc758 \ub4dc\ub78d\ub960\uc774 \ub192\uc2b5\ub2c8\ub2e4. \uc5f0\uc1c4 \uacf5\uaca9\uacfc \ubaa8\ub4e0 \ucf54\uc778 \uc218\uc9d1\uc744 \ud1b5\ud574 \uc810\uc218 \uac00\uc911\uce58\ub97c \uadf9\ub300\ud654\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \ubcf4\ub108\uc2a4 \ubaa9\ud45c\ub294 \ubb34\uc2dc\ud558\uace0, \ucf54\uc778 \uc218\uc9d1\uacfc \ube60\ub978 \ub808\ubca8 \uc644\ub8cc\uc5d0 \uc6b0\uc120\uc21c\uc704\ub97c \ub450\uc138\uc694. \ud3c9\uade0\uc801\uc73c\ub85c \ub808\ubca8 4\uc758 \uc644\ubcbd\ud55c \ud50c\ub808\uc774\uc5d0\uc11c \uc57d 50\uac1c\uc758 \ucabc\uac1c\uae30 \ucf54\uc778\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub09c\uc774\ub3c4\uac00 \uc99d\uac00\ud558\uba74 \ud3c9\uc18c\ubcf4\ub2e4 \ucf54\uc778 \ub4dc\ub86d\ub960\uc774 \ub450 \ubc30 \uc774\uc0c1 \uc99d\uac00\ud558\ub294 \uac83\uc744 \uc54c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub294 \ube60\ub978 \ub808\ubca8 \ud074\ub9ac\uc5b4\uc5d0 \uc758\ud574 \uacf1\ud574\uc838 \ud6a8\uc728\uc801\uc785\ub2c8\ub2e4.\n\uac1c\uc120 \uc0ac\ud56d: \ud6a8\uc728\uc801\uc778 \ud0d0\uc0c9\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 '\ucf54\uc778 \ub18d\uc7a5 \uacbd\ub85c' \uc9c0\ub3c4\ub97c \ub9cc\ub4dc\uc138\uc694."}, {"question": "\ud638\ud504-\ucc39 \uba54\ucee4\ub2c8\uc998: \ud638\ud504-\ucc39\uc758 '\uad00\uc131' \uba54\ucee4\ub2c8\uc998\uc740 \ud50c\ub808\uc774\uc5b4\uc758 \uc810\ud504 \uac70\ub9ac\uc640 \ucabc\uac1c\uae30 \uac15\ub3c4\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\uba70, \uae30\ubcf8 \uacf5\uc2dd\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud638\ud504-\ucc39\uc758 '\uad00\uc131' \uba54\ucee4\ub2c8\uc998\uc740 \uc810\ud504 \uac70\ub9ac\uc640 \ucabc\uac1c\uae30 \uac15\ub3c4\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ub192\uc740 \uc18d\ub3c4\ub85c \uc774\ub3d9\ud558\uba74 \uc810\ud504 \uac70\ub9ac\uac00 \ube44\ub840\uc801\uc73c\ub85c \uc99d\uac00\ud569\ub2c8\ub2e4. \ucabc\uac1c\uae30\ub3c4 \ub354 \uac15\ub825\ud574\uc9d1\ub2c8\ub2e4. \uc810\ud504 \uac70\ub9ac\uc758 \uacf5\uc2dd\uc740 d = v * t + 0.5 * a * t^2\uc785\ub2c8\ub2e4. \ucabc\uac1c\uae30 \uac15\ub3c4\ub294 \uad00\uc131\uc774 5 \ub2e8\uc704 \uc99d\uac00\ud560 \ub54c\ub9c8\ub2e4 +1\uc529 \uc99d\uac00\ud569\ub2c8\ub2e4. \uae30\ubcf8 \uacf5\uc2dd\uc740 \ubcf5\uc7a1\ud569\ub2c8\ub2e4. \ud658\uacbd\uc744 \ud1b5\ud574 \uc774\ub97c \ud30c\uc545\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\uac1c\uc120 \uc0ac\ud56d: \ub2e4\uc591\ud55c \uc18d\ub3c4\uc5d0\uc11c \ucc28\uc774\ub97c \ub290\ub07c\uae30 \uc704\ud574 \uacbd\uc0ac\uba74\uc5d0\uc11c \uad00\uc131 \uc9c8\uc8fc\ub97c \uc5f0\uc2b5\ud558\uc138\uc694."}, {"question": "\ud638\ud504-\ucc39 \uc2ec\uce35 \ubd84\uc11d: '\uc801\uc751\ud615 \ub09c\uc774\ub3c4' \uc2dc\uc2a4\ud15c\uc774 \uc5ec\ub7ec \ubc88\uc758 \ud50c\ub808\uc774 \ub3d9\uc548, \ud2b9\ud788 \uc774\uc804 \uc2dc\ub3c4\uc5d0\uc11c \ub354 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc740 \ud6c4 \ud638\ud504-\ucc39\uc758 \uc801 \ud589\ub3d9 \ud328\ud134\uc5d0 \uc5b4\ub5a4 \uad6c\uccb4\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "'\uc801\uc751\ud615 \ub09c\uc774\ub3c4' \uc2dc\uc2a4\ud15c\uc740 \uc774\uc804 \uace0\ub4dd\uc810\uc5d0 \ub530\ub77c \uc801\uc758 \uacf5\uaca9\uc131\uacfc \uc0dd\uc131 \uc18d\ub3c4\ub97c \uc870\uc815\ud569\ub2c8\ub2e4. \uc801\uc758 \uc804\ub2ec \uc2dc\uac04\uc774 \uc904\uc5b4\ub4e4\uace0, \uc810\uc218\uac00 \ub192\uc544\uc9d0\uc5d0 \ub530\ub77c \uc6c0\uc9c1\uc784\uc774 \uc804\ubc18\uc801\uc73c\ub85c \ube68\ub77c\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 10\ub9cc \uc810\uc744 \ub118\uc5b4\uc11c\uba74 '\ubc18\uc9dd\uc774'\uac00 \ucd94\uac00 \uc810\ud504\ub97c \ud558\uace0 '\ud30c\uad34\uc790'\uc758 \uc6c0\uc9c1\uc784\uc774 \ub450 \ubc30\uac00 \ub429\ub2c8\ub2e4. \uc774\ub294 \uc801\ub4e4\uacfc \ub300\ucc98\ud558\ub294 \ub370 \ub354\uc6b1 \uc8fc\uc758\ud558\uace0 \uc804\uc220\uc801\uc73c\ub85c \uc811\uadfc\ud574\uc57c \ud568\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc801\uc751\ud615 \uc870\uc815\uc740 \uc9c0\uc18d\uc801\uc778 \ub3c4\uc804 \uacbd\ud5d8\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4.\n\uac1c\uc120 \uc0ac\ud56d: \uac01 \uc810\uc218 \uacc4\uce35\uc758 \uc801 \uc774\ub3d9 \uc18d\ub3c4\uc640 \ube48\ub3c4\ub97c \uae30\ub85d\ud558\uc138\uc694."}, {"question": "\ud638\ud504-\ucc39 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \uc9c8\ubb38: PC\uc640 \ub2cc\ud150\ub3c4 \uc2a4\uc704\uce58 \ubc84\uc804\uc758 \ud638\ud504-\ucc39 \uc0ac\uc774\uc5d0 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774 \ub610\ub294 \ud06c\ub85c\uc2a4 \uc9c4\ud589 \uc9c0\uc6d0\uc774 \uc788\ub098\uc694?", "answer": "\uc8c4\uc1a1\ud569\ub2c8\ub2e4. \ud604\uc7ac PC\uc640 \ub2cc\ud150\ub3c4 \uc2a4\uc704\uce58 \ubc84\uc804\uc758 \ud638\ud504-\ucc39 \uac04\uc5d0 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774 \ub610\ub294 \ud06c\ub85c\uc2a4 \uc9c4\ud589 \uc9c0\uc6d0\uc740 \uc5c6\uc2b5\ub2c8\ub2e4. \uc544\ud0a4\ud14d\ucc98 \ucc28\uc774\ub85c \uc778\ud574 \uc800\uc7a5 \ub370\uc774\ud130 \ud3ec\ub9f7\uc774 \ud50c\ub7ab\ud3fc\ub9c8\ub2e4 \ub2ec\ub77c \ub3d9\uae30\ud654\uac00 \uc5b4\ub835\uc2b5\ub2c8\ub2e4. PC\uc5d0\uc11c \uac00\uc7a5 \ucd5c\uc801\ud654 \ub41c \uc131\ub2a5\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub530\ub77c\uc11c \uc6b0\uc120\uc21c\uc704\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4. \ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc2dc\uc791\ud558\uba74 \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uacfc\uc758 \uc800\uc7a5 \ud30c\uc77c \ud638\ud658\uc131\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.\n\uac1c\uc120 \uc0ac\ud56d: \ud638\ud504-\ucc39 \uacf5\uc2dd \uc6f9\uc0ac\uc774\ud2b8\uc640 \uc18c\uc15c \ubbf8\ub514\uc5b4\ub97c \ud655\uc778\ud558\uc5ec \ud5a5\ud6c4 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \uae30\ub2a5 \uc5c5\ub370\uc774\ud2b8\uac00 \uac00\ub2a5\ud55c\uc9c0 \ud655\uc778\ud558\uc138\uc694."}, {"question": "\ud638\ud504-\ucc39 \uc774\uc2a4\ud130 \uc5d0\uadf8: \ud638\ud504-\ucc39\uc5d0\ub294 \ud2b9\uc815 \ud589\ub3d9\uc744 \ud1b5\ud574 \ud574\uc81c\ub418\ub294 \uc228\uaca8\uc9c4 '\ucabc\uac1c\uae30 \uad50\ud658' \ub3c4\uc804 \uacfc\uc81c \ub610\ub294 \ube44\ubc00 \uce90\ub9ad\ud130\uac00 \uc788\ub098\uc694? \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8 \uc544\uc774\ud15c\uacfc \uad00\ub828\uc774 \uc788\uace0 \ud574\ub2f9 \ucf58\ud150\uce20\ub97c \uc2dc\uc791\ud558\ub294 \uad6c\uccb4\uc801\uc778 \uc9c0\uce68\uc744 \uc81c\uacf5\ud574 \uc8fc\uc138\uc694?", "answer": "\ub124! \ube44\ubc00 \uce90\ub9ad\ud130 '\ub808\ud2b8\ub85c-\ucabc\uac1c\uae30'\ub294 \ucc98\uc74c \uc138 \ub808\ubca8\uc5d0 \ud769\uc5b4\uc838 \uc788\ub294 \uc138 \uac1c\uc758 \uc228\uaca8\uc9c4 '\ud53d\uc140 \uc870\uac01'\uc744 \ucc3e\uc544 \ud65c\uc131\ud654\ud574\uc11c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac01 \uc870\uac01\uc740 \uc815\ud655\ud55c \uc810\ud504\uc640 \ud658\uacbd \uc0c1\ud638 \uc791\uc6a9\uc774 \ud544\uc694\ud574\uc11c \ud754\ud788 \uac00\uc9c0 \uc54a\ub294 \uae38\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \ud53d\uc140 \uc870\uac01 1\uc740 \ud2b9\uc815 \uc870\ud569\uc73c\ub85c \ud30c\uad34 \uac00\ub2a5\ud55c \ubcbd \ub4a4\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \ud53d\uc140 \uc870\uac01 2\ub294 \ub192\uc740 \uacf3\uc5d0 \uc788\ub294 \ud070 \ub098\ubb34 \uc704\uc5d0 \uc788\uc73c\uba70 5\uac1c\uc758 \uc791\uc740 \ub098\ubb34\ub97c \ucabc\uac1c\uc11c \ucda9\ubd84\ud55c \ub192\uc774\ub97c \uc5bb\uc5b4\uc57c \ud569\ub2c8\ub2e4. \ud53d\uc140 \uc870\uac01 3\uc740 \uade0\uc5f4\uc774 \uc788\ub294 \uc9c0\ud558\uc5d0 \uc788\uc73c\uba70 \uc5f0\uc18d\ub41c \uc801\ub4e4\uc744 \uac15\ub825\ud558\uac8c \ucabc\uac1c\uc57c \ud569\ub2c8\ub2e4. \ud65c\uc131\ud654\ub418\uba74 \uba54\uc778 \uba54\ub274\ub85c \uc774\ub3d9\ud558\uc5ec '\ub808\ud2b8\ub85c-\ucabc\uac1c\uae30'\ub97c \uc120\ud0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\uac1c\uc120 \uc0ac\ud56d: '\ub808\ud2b8\ub85c-\ucabc\uac1c\uae30'\ub294 8\ube44\ud2b8 \uc0ac\uc6b4\ub4dc \ud6a8\uacfc\uc640 \ub808\ud2b8\ub85c \ud53d\uc140 \uc544\ud2b8 \uc2a4\ud0a8\uacfc \ud568\uaed8 \uc0ac\uc6a9\ub429\ub2c8\ub2e4."}]
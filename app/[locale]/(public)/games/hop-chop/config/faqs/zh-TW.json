[{"question": "\u8df3\u65ac\u65b0\u624b\u554f\u984c\uff1a\u5982\u4f55\u5728\u8df3\u65ac\u904a\u6232\u4e2d\u57f7\u884c\u57fa\u672c\u8df3\u8e8d\u548c\u65ac\u64ca\uff1f", "answer": "\u6b61\u8fce\u4f86\u5230\u8df3\u65ac\uff01\u57f7\u884c\u8df3\u8e8d\u975e\u5e38\u7c21\u55ae\uff1a\u6309\u4e0b\"\u7a7a\u683c\u9375\"\uff08\u6216\u63a7\u5236\u5668\u4e0a\u7684\"A\"\u9375\uff09\u3002\u8981\u57f7\u884c\u65ac\u64ca\uff0c\u8acb\u5728\u7a7a\u4e2d\u6642\u6309\u4e0b\"C\"\u9375\uff08\u6216\u63a7\u5236\u5668\u4e0a\u7684\"X\"\u9375\uff09\u3002\u4f8b\u5982\uff0c\u5728\u6559\u5b78\u95dc\u5361\u4e2d\uff0c\u8df3\u904e\u7b2c\u4e00\u9053\u7e2b\u9699\uff0c\u4e26\u7acb\u5373\u6309\u4e0b\"C\"\u9375\u65ac\u64ca\u6728\u677f\uff0c\u8b93\u60a8\u7e7c\u7e8c\u524d\u9032\u3002\u9019\u500b\u57fa\u672c\u7684\u9023\u64ca\u5c0d\u65bc\u99d5\u99ad\u65e9\u671f\u95dc\u5361\u81f3\u95dc\u91cd\u8981\u3002\n\u6539\u9032\uff1a\u4f7f\u7528\u904a\u6232\u5167\u6559\u5b78\u63d0\u793a\u4f5c\u70ba\u8996\u89ba\u63d0\u793a\u3002\u5b83\u5011\u986f\u793a\u4e86\u6240\u9700\u7684\u7cbe\u78ba\u9375\u76e4\u6309\u9375\u3002\u628a\u5b83\u60f3\u50cf\u6210\u5d4c\u5165\u904a\u6232\u73a9\u6cd5\u4e2d\u7684\u8ff7\u4f60\u8ab2\u7a0b\u3002"}, {"question": "\u8df3\u65ac\u904a\u6232\u4e2d\u6709\u54ea\u4e9b\u4e0d\u540c\u7684\u6575\u4eba\u985e\u578b\uff1f\u4f5c\u70ba\u8df3\u65ac\u904a\u6232\u7684\u65b0\u624b\uff0c\u6211\u61c9\u8a72\u5982\u4f55\u61c9\u5c0d\u9019\u4e9b\u6575\u4eba\uff1f", "answer": "\u8df3\u65ac\u904a\u6232\u4e2d\u6709\u5e7e\u7a2e\u65e9\u671f\u904a\u6232\u6575\u4eba\u985e\u578b\uff0c\u5305\u62ec\"\u53cd\u5f48\u602a\"\u3001\"\u722c\u884c\u8005\"\u548c\"\u5c16\u523a\u602a\"\u3002\u53cd\u5f48\u602a\u5f88\u5bb9\u6613\u88ab\u76f4\u63a5\u780d\u5728\u5b83\u5011\u4e0a\u65b9\u6253\u6557\u3002\u722c\u884c\u8005\u5728\u5730\u9762\u4e0a\u7de9\u6162\u79fb\u52d5\uff1b\u8df3\u904e\u5b83\u5011\u6216\u5f9e\u5b89\u5168\u8ddd\u96e2\u65ac\u64ca\u5b83\u5011\u3002\u5c16\u523a\u602a\u662f\u975c\u6b62\u4e0d\u52d5\u7684\uff0c\u4f46\u6709\u5c16\u523a\uff1b\u901a\u904e\u5c0f\u5fc3\u5730\u5f9e\u5074\u9762\u8a08\u6642\u65ac\u64ca\u4f86\u907f\u514d\u76f4\u63a5\u63a5\u89f8\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e8c\u95dc\u4e2d\uff0c\u4f60\u6703\u9047\u5230\u6240\u6709\u4e09\u7a2e\u985e\u578b\u7684\u6575\u4eba\uff0c\u9700\u8981\u5728\u8df3\u8e8d\u3001\u65ac\u64ca\u548c\u8b39\u614e\u7684\u5b9a\u4f4d\u4e4b\u9593\u4ea4\u66ff\u3002\u512a\u5148\u8655\u7406\u5c16\u523a\u602a\uff0c\u7136\u5f8c\u518d\u8655\u7406\u53cd\u5f48\u602a\u548c\u722c\u884c\u8005\u3002\n\u6539\u9032\uff1a\u628a\u6bcf\u7a2e\u6575\u4eba\u985e\u578b\u90fd\u60f3\u50cf\u6210\u4e00\u500b\u62fc\u5716\u7684\u4e00\u90e8\u5206\uff1b\u5f04\u6e05\u695a\u5b83\u5011\u7684\u5f31\u9ede\u662f\u95dc\u9375\u3002\u8acb\u53c3\u8003\u904a\u6232\u5167\u7684\u602a\u7269\u5716\u9451\u4ee5\u7372\u53d6\u66f4\u591a\u8a73\u7d30\u4fe1\u606f\u3002"}, {"question": "\u8df3\u65ac\u9700\u8981\u9023\u64ca\uff01\u5c0d\u8df3\u65ac\u904a\u6232\u7684\u65b0\u624b\u4f86\u8aaa\uff0c\u5c07\u8df3\u8e8d\u548c\u65ac\u64ca\u7d44\u5408\u5728\u4e00\u8d77\u7684\u6700\u7c21\u55ae\u65b9\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5c07\u9023\u64ca\u7d44\u5408\u5728\u4e00\u8d77\u6700\u7c21\u55ae\u7684\u65b9\u6cd5\u662f\u7df4\u7fd2\"\u8df3\u8e8d\u65ac\u64ca\u843d\u5730\"\u5e8f\u5217\u3002\u9996\u5148\uff0c\u8df3\u8e8d\uff08\u7a7a\u683c\u9375/A\uff09\uff0c\u7136\u5f8c\u7acb\u5373\u5728\u7a7a\u4e2d\u6309\u4e0b\u65ac\u64ca\uff08C/X\uff09\uff0c\u4e26\u78ba\u4fdd\u5b89\u5168\u5730\u843d\u5728\u76ee\u6a19\u7269\u6216\u5730\u9762\u4e0a\u3002\u9806\u66a2\u5730\u91cd\u8907\u9019\u500b\u52d5\u4f5c\u3002\u4f8b\u5982\uff0c\u5617\u8a66\u5728\u7b2c\u4e09\u95dc\u5e73\u53f0\u4e0a\u9032\u884c\u6b64\u7df4\u7fd2\uff0c\u5b83\u5c08\u9580\u70ba\u77ed\u9023\u64ca\u7df4\u7fd2\u800c\u8a2d\u8a08\u3002\u7e7c\u7e8c\u7df4\u7fd2\u9019\u4e9b\u6b65\u9a5f\uff0c\u76f4\u5230\u5b83\u6210\u70ba\u7b2c\u4e8c\u5929\u6027\u3002\n\u6539\u9032\uff1a\u5c07\u52d5\u4f5c\u8996\u89ba\u5316\u70ba\u4e00\u500b\u9023\u8cab\u7684\u52d5\u4f5c\uff0c\u800c\u4e0d\u662f\u5206\u958b\u7684\u6307\u4ee4\u3002\u5617\u8a66\u8abf\u6574\u8df3\u8e8d\u9ad8\u5ea6\u4ee5\u9032\u884c\u66f4\u96e3\u7684\u9023\u64ca\u3002"}, {"question": "\u8df3\u65ac\u7b56\u7565\uff1a\u5728\u7d93\u9a57\u66f4\u8c50\u5bcc\u7684\u5f8c\u671f\u95dc\u5361\u4e2d\uff0c\u5982\u4f55\u6700\u5927\u5316\u8df3\u65ac\u904a\u6232\u4e2d\u7684\u5f97\u5206\u500d\u6578\uff1f", "answer": "\u6700\u5927\u5316\u5f97\u5206\u500d\u6578\u9700\u8981\u7b56\u7565\u898f\u5283\u548c\u57f7\u884c\u3002\u4ee5\u4e0b\u662f\u4e00\u500b\u591a\u6b65\u9a5f\u5206\u89e3\uff1a\n\u6b65\u9a5f 1\uff1a\u9023\u6bba\uff1a\u5feb\u901f\u64ca\u6557\u6575\u4eba\u4ee5\u5efa\u7acb\u4f60\u7684\u500d\u6578\u3002\n\u6b65\u9a5f 2\uff1a\u5229\u7528\u74b0\u5883\uff1a\u4e00\u4e9b\u95dc\u5361\u5177\u6709\u74b0\u5883\u9677\u9631\uff08\u4f8b\u5982\u6389\u843d\u7684\u51b0\u9310\uff09\uff0c\u7576\u8207\u4f60\u7684\u65ac\u64ca\u7b56\u7565\u6027\u5730\u7d50\u5408\u4f7f\u7528\u6642\uff0c\u6703\u7372\u5f97\u984d\u5916\u5206\u6578\uff0c\u5f9e\u800c\u5c07\u5206\u6578\u500d\u589e\u3002\n\u6b65\u9a5f 3\uff1a\u6536\u96c6\u54c1\uff1a\u6536\u96c6\u6563\u4f48\u5728\u5404\u95dc\u5361\u4e2d\u7684\u5f97\u5206\u6db2\u6ef4\u3002\n\u6b65\u9a5f 4\uff1a\u7121\u640d\u901a\u95dc\uff1a\u5728\u6c92\u6709\u53d7\u5230\u640d\u5bb3\u7684\u60c5\u6cc1\u4e0b\u6e05\u9664\u5340\u57df\u5c07\u63d0\u4f9b\u986f\u8457\u7684\u5206\u6578\u63d0\u5347\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e03\u95dc\u4e2d\uff0c\u5728\u4e0d\u53d7\u5230\u4efb\u4f55\u50b7\u5bb3\u7684\u60c5\u6cc1\u4e0b\uff0c\u9023\u7e8c\u64ca\u6557\u4e09\u500b\"\u98db\u884c\u63a0\u98df\u8005\"\u4e26\u6536\u96c6\u9644\u8fd1\u7684\u4e09\u500b\u6db2\u6ef4\uff0c\u53ef\u4ee5\u8f15\u9b06\u5c07\u60a8\u7684\u5206\u6578\u52a0\u500d\u3002\u8acb\u8003\u616e\u5230\uff0c\u4e0d\u53d7\u5230\u50b7\u5bb3\u662f\u6700\u91cd\u8981\u7684\u56e0\u7d20\uff0c\u5176\u6b21\u662f\u6575\u4eba\u7684\u6578\u91cf\u3002", "Enhancement": "\u5728\u5fc3\u4e2d\u60f3\u50cf\u4e00\u500b\u5f97\u5206\u500d\u6578\u7684\"\u71b1\u529b\u5716\"\uff0c\u4ee5\u8b58\u5225\u6700\u4f73\u7684\u9023\u64ca\u8def\u7dda\u3002"}, {"question": "\u9ad8\u7d1a\u8df3\u65ac\uff1a\u70ba\u4ec0\u9ebc\u7406\u89e3\u6575\u4eba\u7684\u5f31\u9ede\u6a21\u5f0f\u5c0d\u65bc\u8df3\u65ac\u7684\u5feb\u901f\u901a\u95dc\u81f3\u95dc\u91cd\u8981\uff1f\u54ea\u4e00\u7a2e\u6575\u4eba\u7279\u5225\u63d0\u4f9b\u4e86\u6700\u4f73\u7684\u7bc0\u7701\u6642\u9593\u6a5f\u6703\uff1f", "answer": "\u4e86\u89e3\u6575\u4eba\u7684\u5f31\u9ede\u6a21\u5f0f\u5c0d\u65bc\u5feb\u901f\u901a\u95dc\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u5141\u8a31\u9ad8\u6548\u4e14\u98a8\u96aa\u964d\u81f3\u6700\u4f4e\u7684\u52d5\u4f5c\u3002\u77e5\u9053\u4f55\u6642\u65ac\u64ca\u3001\u8df3\u8e8d\u6216\u8eb2\u907f\u53ef\u4ee5\u7bc0\u7701\u5bf6\u8cb4\u7684\u6642\u9593\u3002\"\u50b3\u9001\u8005\"\u6575\u4eba\u63d0\u4f9b\u4e86\u6700\u597d\u7684\u6a5f\u6703\u3002\u5982\u679c\u4f60\u80fd\u65ac\u64ca\u4f86\u4e2d\u65b7\u4ed6\u5011\u7684\u50b3\u9001\u5e8f\u5217\uff0c\u4f60\u53ef\u4ee5\u5728\u4ed6\u5011\u91cd\u65b0\u5b9a\u4f4d\u4e4b\u524d\u64ca\u6557\u4ed6\u5011\uff0c\u5f9e\u800c\u7bc0\u7701\u5e7e\u79d2\u9418\u7684\u6642\u9593\u3002\u4ee5\u4e0b\u662f\u5982\u4f55\u5b8c\u6210\u7684\uff1a\u4f60\u60f3\u9810\u6e2c\u524d\u4e09\u500b\u50b3\u9001\u968e\u6bb5\uff0c\u4ee5\u4fbf\u5728\u5b83\u5011\u4e4b\u524d\u6d88\u6ec5\u5b83\u3002\u7136\u5f8c\uff0c\u5728\u4ed6\u5011\u77ed\u66ab\u7684\u8106\u5f31\u6642\u671f\u65ac\u64ca\uff0c\u5b8c\u5168\u907f\u514d\u50b3\u9001\u3002\u7df4\u7fd2\u4e4b\u5f8c\uff0c\u9019\u5c07\u6703\u6210\u70ba\u7b2c\u4e8c\u5929\u6027\u3002\u901f\u5ea6\u662f\u95dc\u9375\uff0c\u4f46\u8cc7\u6e90\u7ba1\u7406\u4e5f\u662f\u95dc\u9375\u3002", "Enhancement": "\u8a18\u9304\u4f60\u7684\u5617\u8a66\uff0c\u4e26\u9010\u5e40\u5206\u6790\u4ee5\u8b58\u5225\u5fae\u512a\u5316\u3002"}, {"question": "\u8df3\u65ac\u6280\u8853\uff1a\u5982\u4f55\u4ee5\u6700\u6709\u6548\u7684\u65b9\u5f0f\u5728\u8df3\u65ac\u904a\u6232\u4e2d\u6536\u96c6\"\u65ac\u64ca\u786c\u5e63\"\u4f86\u89e3\u9396\u6240\u6709\u53ef\u7528\u7684\u76ae\u819a\uff1f\u96e3\u5ea6\u8a2d\u5b9a\u5982\u4f55\u5f71\u97ff\u6389\u843d\u7387\uff1f", "answer": "\u6536\u96c6\"\u65ac\u64ca\u786c\u5e63\"\u7684\u6700\u6709\u6548\u65b9\u6cd5\u662f\u91cd\u8907\u5728\"\u56f0\u96e3\"\u96e3\u5ea6\u4e0b\u73a9\u7b2c\u56db\u95dc\u3002\"\u56f0\u96e3\"\u96e3\u5ea6\u4e0b\"\u65ac\u64ca\u786c\u5e63\"\u7684\u6389\u843d\u7387\u66f4\u9ad8\u3002\u5c08\u6ce8\u65bc\u901a\u904e\u9023\u7e8c\u64ca\u6bba\u548c\u6536\u96c6\u6240\u6709\u786c\u5e63\u4f86\u6700\u5927\u5316\u5206\u6578\u500d\u6578\u3002\u5ffd\u7565\u984d\u5916\u76ee\u6a19\uff0c\u512a\u5148\u6536\u96c6\u786c\u5e63\u548c\u5feb\u901f\u5b8c\u6210\u95dc\u5361\u3002\u5e73\u5747\u800c\u8a00\uff0c\u5728\u7b2c\u56db\u95dc\u7684\u5b8c\u7f8e\u901a\u95dc\u4e2d\u53ef\u4ee5\u7372\u5f97\u5927\u7d04 50 \u500b\u65ac\u64ca\u786c\u5e63\u3002\u60a8\u6703\u6ce8\u610f\u5230\u96e3\u5ea6\u589e\u52a0\u4f7f\u901a\u5e38\u7684\u786c\u5e63\u6389\u843d\u7387\u589e\u52a0\u4e86\u4e00\u500d\u4ee5\u4e0a\u3002\u9019\u4e58\u4ee5\u5feb\u901f\u95dc\u5361\u6e05\u9664\u6548\u7387\u5f88\u9ad8\u3002\n\u6539\u9032\uff1a\u88fd\u4f5c\u4e00\u5f35\"\u786c\u5e63\u6536\u96c6\u8def\u7dda\"\u5716\uff0c\u4ee5\u78ba\u4fdd\u9ad8\u6548\u7684\u5c0e\u822a\u3002"}, {"question": "\u8df3\u65ac\u6a5f\u5236\uff1a\u8df3\u65ac\u904a\u6232\u4e2d\u7684\"\u52d5\u91cf\"\u6a5f\u5236\u5982\u4f55\u5f71\u97ff\u73a9\u5bb6\u7684\u8df3\u8e8d\u8ddd\u96e2\u548c\u65ac\u64ca\u529b\uff1f\u5176\u80cc\u5f8c\u7684\u516c\u5f0f\u662f\u4ec0\u9ebc\uff1f", "answer": "\u8df3\u65ac\u904a\u6232\u4e2d\u7684\"\u52d5\u91cf\"\u6a5f\u5236\u76f4\u63a5\u5f71\u97ff\u8df3\u8e8d\u8ddd\u96e2\u548c\u65ac\u64ca\u529b\u3002\u7576\u4ee5\u9ad8\u901f\u5ea6\u79fb\u52d5\u6642\uff0c\u60a8\u7684\u8df3\u8e8d\u8ddd\u96e2\u6703\u6210\u6bd4\u4f8b\u589e\u52a0\u3002\u60a8\u7684\u65ac\u64ca\u529b\u4e5f\u6703\u589e\u52a0\u3002\u8df3\u8e8d\u8ddd\u96e2\u7684\u516c\u5f0f\u70ba d = v * t + 0.5 * a * t^2\u3002\u65ac\u64ca\u529b\u6703\u96a8\u8457\u52d5\u91cf\u7684\u6bcf5\u500b\u55ae\u4f4d\u589e\u52a0 +1\u3002\u5176\u80cc\u5f8c\u7684\u516c\u5f0f\u5f88\u8907\u96dc\u3002\u60a8\u53ef\u4ee5\u901a\u904e\u5be6\u9a57\u74b0\u5883\u4f86\u8fa8\u5225\u9019\u4e00\u9ede\u3002\n\u6539\u9032\uff1a\u7df4\u7fd2\u5728\u50be\u659c\u9762\u4e0a\"\u52d5\u91cf\u885d\u6d6a\"\uff0c\u4ee5\u611f\u53d7\u5230\u4e0d\u540c\u901f\u5ea6\u4e0b\u7684\u5dee\u7570\u3002"}, {"question": "\u8df3\u65ac\u6df1\u5165\u63a2\u8a0e\uff1a\"\u81ea\u9069\u61c9\u96e3\u5ea6\"\u7cfb\u7d71\u5982\u4f55\u5728\u8df3\u65ac\u904a\u6232\u4e2d\u5f71\u97ff\u6575\u4eba\u884c\u70ba\u6a21\u5f0f\uff0c\u7279\u5225\u662f\u5728\u5148\u524d\u5617\u8a66\u4e2d\u7372\u5f97\u66f4\u9ad8\u5206\u6578\u4e4b\u5f8c\uff1f", "answer": "\u6839\u64da\u60a8\u4e4b\u524d\u7684\u6700\u9ad8\u5206\u6578\uff0c\"\u81ea\u9069\u61c9\u96e3\u5ea6\"\u7cfb\u7d71\u6703\u8abf\u6574\u6575\u4eba\u7684\u653b\u64ca\u6027\u548c\u751f\u6210\u7387\u3002\u96a8\u8457\u60a8\u7684\u5206\u6578\u589e\u52a0\uff0c\u6575\u4eba\u7684\u52d5\u4f5c\u901f\u5ea6\u6703\u66f4\u5feb\uff0c\u4e14\u4fe1\u865f\u6642\u9593\u6703\u6e1b\u5c11\u3002\u4f8b\u5982\uff0c\u5728\u5f97\u5206 10 \u842c\u5206\u4e4b\u5f8c\uff0c\"\u53cd\u5f48\u602a\"\u6703\u591a\u8df3\u4e00\u6b21\uff0c\u800c\"\u722c\u884c\u8005\"\u7684\u79fb\u52d5\u901f\u5ea6\u6703\u5feb\u5169\u500d\u3002\u9019\u610f\u5473\u8457\u60a8\u5728\u61c9\u5c0d\u6575\u4eba\u6642\u5fc5\u9808\u66f4\u52a0\u8b39\u614e\u548c\u6709\u7b56\u7565\u3002\u9019\u7a2e\u81ea\u9069\u61c9\u8abf\u6574\u78ba\u4fdd\u4e86\u6301\u7e8c\u5177\u6709\u6311\u6230\u6027\u7684\u904a\u6232\u9ad4\u9a57\u3002\n\u6539\u9032\uff1a\u8a18\u4e0b\u4e0d\u540c\u5206\u6578\u5c64\u7d1a\u7684\u6575\u4eba\u79fb\u52d5\u901f\u5ea6\u548c\u983b\u7387\u3002"}, {"question": "\u8df3\u65ac\u8de8\u5e73\u53f0\u554f\u984c\uff1aPC \u7248\u548c\u4efb\u5929\u5802 Switch \u7248\u7684\u8df3\u65ac\u904a\u6232\u4e4b\u9593\u662f\u5426\u652f\u63f4\u8de8\u5e73\u53f0\u904a\u6232\u6216\u8de8\u9032\u5ea6\uff1f", "answer": "\u907a\u61be\u7684\u662f\uff0c\u7531\u65bc\u67b6\u69cb\u5dee\u7570\uff0c\u8df3\u65ac\u904a\u6232\u76ee\u524d\u4e0d\u652f\u63f4 PC \u7248\u548c\u4efb\u5929\u5802 Switch \u7248\u4e4b\u9593\u7684\u8de8\u5e73\u53f0\u904a\u6232\u6216\u8de8\u9032\u5ea6\u3002\u5132\u5b58\u8cc7\u6599\u683c\u5f0f\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u6709\u6240\u4e0d\u540c\uff0c\u9019\u4f7f\u5f97\u540c\u6b65\u8b8a\u5f97\u56f0\u96e3\u3002PC \u7248\u7684\u6027\u80fd\u6703\u5f97\u5230\u6700\u4f73\u5316\uff1b\u56e0\u6b64\uff0c\u9019\u53d6\u6c7a\u65bc\u4f60\u7684\u512a\u5148\u9806\u5e8f\u3002\u6240\u4ee5\uff0c\u5982\u679c\u4f60\u5728\u4e00\u7a2e\u5e73\u53f0\u958b\u59cb\uff0c\u4e0d\u540c\u5e73\u53f0\u4e4b\u9593\u5c07\u6c92\u6709\u8de8\u5132\u5b58\u76f8\u5bb9\u6027\u3002\n\u6539\u9032\uff1a\u8acb\u67e5\u770b\u8df3\u65ac\u904a\u6232\u7684\u5b98\u65b9\u7db2\u7ad9\u548c\u793e\u7fa4\u5a92\u9ad4\uff0c\u4e86\u89e3\u672a\u4f86\u53ef\u80fd\u51fa\u73fe\u7684\u8de8\u5e73\u53f0\u529f\u80fd\u3002"}, {"question": "\u8df3\u65ac\u5f69\u86cb\uff1a\u8df3\u65ac\u904a\u6232\u4e2d\u662f\u5426\u6709\u4efb\u4f55\u96b1\u85cf\u7684\"\u5207\u63db\u6311\u6230\"\u6216\u900f\u904e\u7279\u5b9a\u52d5\u4f5c\u89e3\u9396\u7684\u79d8\u5bc6\u89d2\u8272\uff0c\u9019\u4e9b\u52d5\u4f5c\u53ef\u80fd\u8207\u96b1\u85cf\u7684\u5f69\u86cb\u7269\u54c1\u6709\u95dc\uff1f\u60a8\u80fd\u5426\u63d0\u4f9b\u6709\u95dc\u5982\u4f55\u89f8\u767c\u6b64\u985e\u5167\u5bb9\u7684\u5177\u9ad4\u8aaa\u660e\uff1f", "answer": "\u662f\u7684\uff01\u4e00\u500b\u79d8\u5bc6\u89d2\u8272\"\u5fa9\u53e4\u65ac\u64ca\u8005\"\uff0c\u5c07\u900f\u904e\u5728\u7b2c\u4e00\u95dc\u81f3\u7b2c\u4e09\u95dc\u627e\u5230\u4e26\u6fc0\u6d3b\u4e09\u500b\u96b1\u85cf\u7684\"\u50cf\u7d20\u788e\u7247\"\u4f86\u89e3\u9396\u3002\u6bcf\u500b\u788e\u7247\u90fd\u4f4d\u65bc\u672a\u88ab\u6253\u901a\u7684\u9053\u8def\u4e0a\uff0c\u9700\u8981\u7cbe\u78ba\u7684\u8df3\u8e8d\u548c\u74b0\u5883\u4e92\u52d5\u3002\u50cf\u7d20\u788e\u7247 1 \u4f4d\u65bc\u53ef\u88ab\u7279\u5b9a\u9023\u64ca\u6467\u6bc0\u7684\u7246\u5f8c\u3002\u50cf\u7d20\u788e\u7247 2 \u4f4d\u65bc\u5927\u6a39\u9802\u7aef\uff0c\u4f60\u9700\u8981\u780d\u4f10 5 \u68f5\u8f03\u5c0f\u7684\u6a39\u6728\u624d\u80fd\u7372\u5f97\u8db3\u5920\u7684\u9ad8\u5ea6\u3002\u50cf\u7d20\u788e\u7247 3 \u4f4d\u65bc\u5730\u4e0b\u7684\u4e00\u500b\u88c2\u7e2b\u4e2d\uff0c\u4f60\u9700\u8981\u4f7f\u7528\u66f4\u5f37\u7684\u9023\u7e8c\u65ac\u64ca\u64ca\u6557\u6575\u4eba\u3002\u6fc0\u6d3b\u5f8c\uff0c\u9032\u5165\u4e3b\u9078\u55ae\uff0c\u60a8\u5c07\u6703\u770b\u5230\"\u5fa9\u53e4\u65ac\u64ca\u8005\"\u53ef\u4ee5\u9078\u64c7\u3002\n\u6539\u9032\uff1a\"\u5fa9\u53e4\u65ac\u64ca\u8005\"\u4f7f\u7528 8 \u4f4d\u97f3\u6548\u548c\u5fa9\u53e4\u50cf\u7d20\u85dd\u8853\u76ae\u819a\u3002"}]
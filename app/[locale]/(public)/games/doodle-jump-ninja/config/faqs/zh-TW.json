[{"question": "\u5982\u4f55\u5728Doodle Jump Ninja\u4e2d\u57f7\u884c\u57fa\u672c\u8df3\u8e8d\uff1f", "answer": "\u5728Doodle Jump Ninja\u4e2d\uff0c\u57fa\u672c\u8df3\u8e8d\u662f\u900f\u904e\u9ede\u64ca\u87a2\u5e55\u4f7f\u4f60\u7684\u5fcd\u8005\u5411\u4e0a\u8df3\u8e8d\u4f86\u5b8c\u6210\u7684\u3002\u4f8b\u5982\uff0c\u7576\u4f60\u9047\u5230\u5e73\u53f0\u6642\uff0c\u9ede\u64ca\u87a2\u5e55\u5373\u53ef\u8457\u9678\u3002\u5982\u679c\u9ede\u64ca\u4e26\u6309\u4f4f\uff0c\u4f60\u7684\u5fcd\u8005\u5c07\u8df3\u5f97\u66f4\u9ad8\u3002\u7df4\u7fd2\u8df3\u8e8d\u6642\u9593\uff0c\u907f\u514d\u5f9e\u87a2\u5e55\u4e0a\u6389\u4e0b\u4f86\u3002[\u6bd4\u55bb\u8aaa\u660e: \u60f3\u60f3\u770b\uff0c\u5c31\u50cf\u5728\u6cb3\u4e0a\u7528\u8df3\u77f3\u8df3\u8e8d\u3002]"}, {"question": "\u5728Doodle Jump Ninja\u4e2d\u9054\u6210\u9ad8\u5206\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u8981\u5728Doodle Jump Ninja\u4e2d\u7372\u5f97\u9ad8\u5206\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u5c08\u6ce8\u65bc\u8457\u9678\u65bc\u5e73\u53f0\u4e2d\u5fc3\u4ee5\u4fdd\u6301\u5e73\u8861\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u5674\u5c04\u80cc\u5305\u7b49\u9053\u5177\u5feb\u901f\u7372\u5f97\u984d\u5916\u9ad8\u5ea6\u3002\u6b65\u9a5f3\uff1a\u4ed4\u7d30\u8abf\u6574\u8df3\u8e8d\u6642\u9593\uff0c\u907f\u514d\u6575\u4eba\u548c\u969c\u7919\u7269\u3002\u4f8b\u5982\uff0c\u7576\u4f60\u770b\u5230\u79fb\u52d5\u7684\u5e73\u53f0\u6642\uff0c\u7b49\u5f85\u5408\u9069\u7684\u6642\u523b\u8df3\u8e8d\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u9053\u5177 | \u6548\u679c | \u5674\u5c04\u80cc\u5305 | \u5feb\u901f\u7372\u5f97\u9ad8\u5ea6 | \u9632\u76fe | \u4fdd\u8b77\u514d\u53d7\u4e00\u6b21\u653b\u64ca]"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u5728Doodle Jump Ninja\u4e2d\u4e0d\u65b7\u8f38\u6389\uff1f", "answer": "\u5728Doodle Jump Ninja\u4e2d\u8f38\u6389\u904a\u6232\uff0c\u901a\u5e38\u662f\u56e0\u70ba\u8df3\u8e8d\u6642\u9593\u4e0d\u6e96\u78ba\u6216\u5f9e\u5e73\u53f0\u4e0a\u6389\u4e0b\u4f86\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u8df3\u8e8d\u904e\u65e9\u6216\u904e\u665a\uff0c\u4f60\u53ef\u80fd\u6703\u932f\u904e\u5e73\u53f0\u3002\u6b64\u5916\uff0c\u50cf\u65cb\u8f49\u5200\u7247\u9019\u6a23\u7684\u6575\u4eba\uff0c\u5982\u679c\u4e0d\u907f\u958b\uff0c\u53ef\u80fd\u4e5f\u6703\u628a\u4f60\u64ca\u5012\u3002\u7df4\u7fd2\u4f60\u7684\u6642\u9593\u5224\u65b7\u4e26\u4fdd\u6301\u8b66\u60d5\uff0c\u4ee5\u63d0\u5347\u4f60\u7684\u904a\u6232\u8868\u73fe\u3002[\u6d41\u7a0b\u5716\u89e3: \u8df3\u8e8d\u6642\u9593 -> \u8457\u9678\u65bc\u5e73\u53f0 -> \u907f\u958b\u6575\u4eba -> \u7e7c\u7e8c\u524d\u9032]"}, {"question": "Doodle Jump Ninja\u4e2d\u54ea\u4e9b\u9053\u5177\u6700\u6709\u6548\uff1f", "answer": "Doodle Jump Ninja\u4e2d\uff0c\u6700\u6709\u6548\u7684\u9053\u5177\u5305\u62ec\u5674\u5c04\u80cc\u5305\uff08\u53ef\u5feb\u901f\u7372\u5f97\u9ad8\u5ea6\uff09\u548c\u9632\u76fe\uff08\u53ef\u4fdd\u8b77\u4f60\u514d\u53d7\u4e00\u6b21\u653b\u64ca\uff09\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u5674\u5c04\u80cc\u5305\u53ef\u4ee5\u5e6b\u52a9\u4f60\u7e5e\u904e\u56f0\u96e3\u7684\u90e8\u5206\uff0c\u800c\u9632\u76fe\u53ef\u4ee5\u4fdd\u8b77\u4f60\u514d\u53d7\u6575\u4eba\u653b\u64ca\u3002\u7b56\u7565\u6027\u5730\u4f7f\u7528\u9019\u4e9b\u9053\u5177\u4ee5\u6700\u5927\u5316\u5176\u597d\u8655\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u9053\u5177 | \u4f7f\u7528\u6848\u4f8b | \u5674\u5c04\u80cc\u5305 | \u5feb\u901f\u7372\u5f97\u9ad8\u5ea6 | \u9632\u76fe | \u4fdd\u8b77\u514d\u53d7\u4e00\u6b21\u653b\u64ca | \u78c1\u9435 | \u5438\u5f15\u786c\u5e63]"}, {"question": "Doodle Jump Ninja\u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "Doodle Jump Ninja\u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u4f60\u9054\u5230\u7684\u9ad8\u5ea6\u548c\u4f60\u6536\u96c6\u7684\u786c\u5e63\u3002\u4f8b\u5982\uff0c\u6bcf\u500b\u4f60\u8457\u9678\u7684\u5e73\u53f0\u90fd\u6703\u589e\u52a0\u4f60\u7684\u5f97\u5206\uff0c\u800c\u6536\u96c6\u786c\u5e63\u5247\u6703\u984d\u5916\u52a0\u5206\u3002\u6b64\u5916\uff0c\u5b8c\u6210\u6311\u6230\u548c\u907f\u514d\u969c\u7919\u7269\u4e5f\u6703\u63d0\u5347\u4f60\u7684\u5f97\u5206\u3002\u4f60\u722c\u5f97\u8d8a\u9ad8\uff0c\u7372\u5f97\u7684\u5206\u6578\u5c31\u8d8a\u591a\u3002[\u6bd4\u55bb\u8aaa\u660e: \u60f3\u60f3\u770b\uff0c\u5c31\u50cf\u722c\u5c71\u4e00\u6a23\uff0c\u722c\u5f97\u8d8a\u9ad8\uff0c\u734e\u52f5\u8d8a\u5927\u3002]"}, {"question": "Doodle Jump Ninja\u4e2d\u7684\u96b1\u85cf\u6210\u5c31\u6709\u54ea\u4e9b\uff1f", "answer": "Doodle Jump Ninja\u6709\u591a\u500b\u96b1\u85cf\u6210\u5c31\uff0c\u4f8b\u5982\u300c\u5fcd\u8005\u5927\u5e2b\u300d\uff0c\u9019\u9700\u8981\u4f60\u5728\u4e0d\u4f7f\u7528\u4efb\u4f55\u9053\u5177\u7684\u60c5\u6cc1\u4e0b\u9054\u5230\u7279\u5b9a\u9ad8\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u4e0d\u4f7f\u7528\u9053\u5177\u7684\u60c5\u6cc1\u4e0b\u9054\u5230 10,000 \u5206\u6578\uff0c\u5373\u53ef\u89e3\u9396\u6b64\u6210\u5c31\u3002\u63a2\u7d22\u4e0d\u540c\u7684\u7b56\u7565\u548c\u6311\u6230\uff0c\u4ee5\u767c\u73fe\u6240\u6709\u96b1\u85cf\u6210\u5c31\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u6210\u5c31 | \u9700\u6c42 | \u5fcd\u8005\u5927\u5e2b | \u5728\u4e0d\u4f7f\u7528\u9053\u5177\u7684\u60c5\u6cc1\u4e0b\u9054\u5230 10,000 \u5206\u6578 | \u786c\u5e63\u6536\u96c6\u5bb6 | \u5728\u4e00\u5c40\u904a\u6232\u4e2d\u6536\u96c6 500 \u679a\u786c\u5e63]"}, {"question": "\u5982\u4f55\u5c07\u6211\u5728Doodle Jump Ninja\u4e2d\u7684\u9032\u5ea6\u8f49\u79fb\u5230\u65b0\u7684\u88dd\u7f6e\uff1f", "answer": "\u8981\u5c07\u4f60\u5728Doodle Jump Ninja\u4e2d\u7684\u9032\u5ea6\u8f49\u79fb\u5230\u65b0\u7684\u88dd\u7f6e\uff0c\u8acb\u78ba\u4fdd\u4f60\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u90fd\u767b\u5165\u76f8\u540c\u7684\u5e33\u6236\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4f7f\u7528 Google Play Games\uff0c\u8acb\u5728\u65b0\u7684\u88dd\u7f6e\u4e0a\u4f7f\u7528\u76f8\u540c\u7684\u5e33\u6236\u767b\u5165\u3002\u4f60\u7684\u9032\u5ea6\u61c9\u8a72\u6703\u81ea\u52d5\u540c\u6b65\u3002\u5982\u679c\u6c92\u6709\uff0c\u8acb\u6aa2\u67e5\u4f60\u7684\u7db2\u8def\u9023\u7dda\u4e26\u91cd\u8a66\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u5e33\u6236\u985e\u578b | \u540c\u6b65\u65b9\u6cd5 | Google Play Games | \u81ea\u52d5 | Apple Game Center | \u81ea\u52d5]"}, {"question": "\u5728Doodle Jump Ninja\u4e2d\u907f\u514d\u6575\u4eba\u7684\u6700\u4f73\u6280\u5de7\u662f\u4ec0\u9ebc\uff1f", "answer": "\u8981\u5728Doodle Jump Ninja\u4e2d\u907f\u958b\u6575\u4eba\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u89c0\u5bdf\u6575\u4eba\u7684\u6a21\u5f0f\uff0c\u4f8b\u5982\u65cb\u8f49\u5200\u7247\u7684\u65cb\u8f49\u65b9\u5f0f\u3002\u6b65\u9a5f2\uff1a\u8abf\u6574\u4f60\u7684\u8df3\u8e8d\u6642\u9593\uff0c\u5728\u6575\u4eba\u4e0d\u5728\u6642\u901a\u904e\u9593\u9699\u3002\u6b65\u9a5f3\uff1a\u4f7f\u7528\u9632\u76fe\u7b49\u9053\u5177\u4f5c\u70ba\u4fdd\u8b77\u3002\u4f8b\u5982\uff0c\u7576\u9762\u5c0d\u4e00\u7fa4\u6575\u4eba\u6642\uff0c\u7b49\u5f85\u5408\u9069\u7684\u6642\u523b\u8df3\u8e8d\u901a\u904e\u5b89\u5168\u5730\u5e36\u3002[\u6d41\u7a0b\u5716\u89e3: \u89c0\u5bdf\u6575\u4eba -> \u8abf\u6574\u8df3\u8e8d\u6642\u9593 -> \u4f7f\u7528\u9053\u5177 -> \u7e7c\u7e8c\u524d\u9032]"}, {"question": "\u5982\u4f55\u89e3\u9396Doodle Jump Ninja\u4e2d\u7684\u7279\u6b8a\u5fcd\u8005\u76ae\u819a\uff1f", "answer": "Doodle Jump Ninja\u4e2d\u7684\u7279\u6b8a\u5fcd\u8005\u76ae\u819a\u662f\u900f\u904e\u5b8c\u6210\u7279\u5b9a\u6311\u6230\u6216\u6536\u96c6\u8db3\u5920\u786c\u5e63\u4f86\u89e3\u9396\u7684\u3002\u4f8b\u5982\uff0c\u6536\u96c6 1,000 \u679a\u786c\u5e63\u53ef\u89e3\u9396\u300c\u9ec3\u91d1\u5fcd\u8005\u300d\u76ae\u819a\u3002\u6b64\u5916\uff0c\u6709\u4e9b\u76ae\u819a\u53ef\u900f\u904e\u61c9\u7528\u5167\u8cfc\u8cb7\u7372\u5f97\u3002\u7e7c\u7e8c\u904a\u6232\u4e26\u6536\u96c6\u786c\u5e63\u5373\u53ef\u89e3\u9396\u9019\u4e9b\u7279\u6b8a\u76ae\u819a\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u670d\u88dd | \u89e3\u9396\u65b9\u6cd5 | \u9ec3\u91d1\u5fcd\u8005 | \u6536\u96c6 1,000 \u679a\u786c\u5e63 | \u9670\u5f71\u5fcd\u8005 | \u5b8c\u6210\u300c\u5fcd\u8005\u5927\u5e2b\u300d\u6210\u5c31]"}, {"question": "Doodle Jump Ninja\u4e2d\u6709\u54ea\u4e9b\u79d8\u5bc6\u95dc\u5361\uff1f", "answer": "Doodle Jump Ninja\u5305\u542b\u79d8\u5bc6\u95dc\u5361\uff0c\u9019\u4e9b\u95dc\u5361\u662f\u900f\u904e\u6eff\u8db3\u7279\u5b9a\u689d\u4ef6\u4f86\u89e3\u9396\u7684\uff0c\u4f8b\u5982\u9054\u5230\u7279\u5b9a\u9ad8\u5ea6\u6216\u6536\u96c6\u4e00\u5b9a\u6578\u91cf\u7684\u786c\u5e63\u3002\u4f8b\u5982\uff0c\u9054\u5230 15,000 \u5206\u6578\u53ef\u89e3\u9396\u300c\u5929\u7a7a\u795e\u5edf\u300d\u95dc\u5361\u3002\u4ed4\u7d30\u63a2\u7d22\u904a\u6232\uff0c\u4ee5\u767c\u73fe\u6240\u6709\u79d8\u5bc6\u95dc\u5361\u4e26\u4eab\u53d7\u65b0\u7684\u6311\u6230\u3002[\u6bd4\u55bb\u8aaa\u660e: \u60f3\u60f3\u770b\uff0c\u5c31\u50cf\u5c0b\u627e\u96b1\u85cf\u7684\u5bf6\u85cf\u4e00\u6a23\uff0c\u4f60\u63a2\u7d22\u5f97\u8d8a\u591a\uff0c\u767c\u73fe\u7684\u5c31\u8d8a\u591a\u3002]"}]
[{"question": "\ub3c4\ub4e4 \u30b8\u30e3\u30f3\u30d7\u30cb\u30f3\u30b8\u30e3\uc5d0\uc11c \uae30\ubcf8 \uc810\ud504\ub294 \uc5b4\ub5bb\uac8c \uc218\ud589\ud569\ub2c8\uae4c?", "answer": "\ub3c4\ub4e4 \u30b8\u30e3\u30f3\u30d7\u30cb\u30f3\u30b8\u30e3\uc5d0\uc11c \uae30\ubcf8 \uc810\ud504\ub294 \ud654\uba74\uc744 \ud0ed\ud558\uc5ec \ub2c8\ub098\uac00 \uc704\ub85c \uc810\ud504\ud558\ub3c4\ub85d \ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud50c\ub7ab\ud3fc\uc5d0 \ubd80\ub52a\ud788\uba74 \ud654\uba74\uc744 \ud0ed\ud558\uc5ec \ud50c\ub7ab\ud3fc\uc5d0 \ucc29\uc9c0\ud569\ub2c8\ub2e4. \ud0ed\uc744 \uae38\uac8c \ub204\ub974\uba74 \ub2c8\ub098\uac00 \ub354 \ub192\uc774 \uc810\ud504\ud569\ub2c8\ub2e4. \ud654\uba74\uc5d0\uc11c \ub5a8\uc5b4\uc9c0\uc9c0 \uc54a\ub3c4\ub85d \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uc5f0\uc2b5\ud558\uc138\uc694. [\ube44\uc720 \uc124\uba85: \uac15\ubb3c \uac74\ub108 \ub3cc\uba69\uc774 \uc704\uc5d0 \ub6f0\uc5b4\uc624\ub974\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ub3c4\ub4e4 \u30b8\u30e3\u30f3\u30d7\u30cb\u30f3\u30b8\u30e3\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub3c4\ub4e4 \u30b8\u30e3\u30f3\u30d7\u30cb\u30f3\u30b8\u30e3\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc73c\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc2ed\uc2dc\uc624. 1\ub2e8\uacc4: \uade0\ud615\uc744 \uc720\uc9c0\ud558\uae30 \uc704\ud574 \ud50c\ub7ab\ud3fc \uc911\uc559\uc5d0 \ucc29\uc9c0\ud558\ub294 \ub370 \uc9d1\uc911\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \uc81c\ud2b8\ud329\uacfc \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ube60\ub974\uac8c \ub192\uc774\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. 3\ub2e8\uacc4: \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uc2e0\uc911\ud558\uac8c \uc870\uc808\ud558\uc5ec \uc801\uacfc \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uc744 \ubcf4\uba74 \uc801\uc808\ud55c \uc21c\uac04\uc5d0 \uc810\ud504\ud558\uc2ed\uc2dc\uc624. [\uc124\uc815 \ub300\uc870\ud45c: \ud30c\uc6cc\uc5c5 | \ud6a8\uacfc | \uc81c\ud2b8\ud329 | \ub192\uc774 \ube60\ub974\uac8c \uc5bb\uc74c | \ubc29\ud328 | \ud55c \ubc88\uc758 \uacf5\uaca9 \ubc29\uc5b4]"}, {"question": "\ub3c4\ub4e4 \u30b8\u30e3\u30f3\u30d7\u30cb\u30f3\u30b8\u30e3\uc5d0\uc11c \uacc4\uc18d\ud574\uc11c \uc65c \ud328\ubc30\ud569\ub2c8\uae4c?", "answer": "\ub3c4\ub4e4 \u30b8\u30e3\u30f3\u30d7\u30cb\u30f3\u30b8\u30e3\uc5d0\uc11c \ud328\ubc30\ud558\ub294 \uac83\uc740 \uc885\uc885 \uc810\ud504 \ud0c0\uc774\ubc0d\uc774 \uc798\ubabb\ub418\uc5c8\uac70\ub098 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub5a8\uc5b4\uc9c0\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub108\ubb34 \uc77c\ucc0d \ub610\ub294 \ub108\ubb34 \ub2a6\uac8c \uc810\ud504\ud558\uba74 \ud50c\ub7ab\ud3fc\uc744 \ub193\uce60 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \ud68c\uc804\ub0a0\uac1c\uc640 \uac19\uc740 \uc801\ub4e4\uc740 \ud53c\ud558\uc9c0 \uc54a\uc73c\uba74 \ub5a8\uc5b4\uc9c0\uac8c \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\uae30 \uc704\ud574 \ud0c0\uc774\ubc0d \uc5f0\uc2b5 \ubc0f \uc8fc\uc758\ub97c \uae30\uc6b8\uc774\uc138\uc694. [\ud750\ub984\ub3c4: \uc810\ud504 \ud0c0\uc774\ubc0d -> \ud50c\ub7ab\ud3fc \ucc29\uc9c0 -> \uc801 \ud53c\ud558\uae30 -> \uc9c4\ud589 \uacc4\uc18d]"}, {"question": "\ub3c4\ub4e4 \u30b8\u30e3\u30f3\u30d7\u30cb\u30f3\u30b8\u30e3\uc5d0\uc11c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ud30c\uc6cc\uc5c5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub3c4\ub4e4 \u30b8\u30e3\u30f3\u30d7\u30cb\u30f3\u30b8\u30e3\uc5d0\uc11c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ud30c\uc6cc\uc5c5\uc5d0\ub294 \ub192\uc774\ub97c \ube60\ub974\uac8c \uc5bb\uc744 \uc218 \uc788\ub294 \uc81c\ud2b8\ud329\uacfc \ud55c \ubc88\uc758 \uacf5\uaca9\uc73c\ub85c\ubd80\ud130 \ubcf4\ud638\ud558\ub294 \ubc29\ud328\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc81c\ud2b8\ud329\uc744 \uc0ac\uc6a9\ud558\uba74 \uc5b4\ub824\uc6b4 \uc139\uc158\uc744 \uc6b0\ud68c\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\uace0, \ubc29\ud328\ub294 \uc801\uc758 \uacf5\uaca9\uc73c\ub85c\ubd80\ud130 \ub2f9\uc2e0\uc744 \uad6c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud30c\uc6cc\uc5c5\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc5ec \ucd5c\ub300 \ud6a8\uacfc\ub97c \uc5bb\uc73c\uc2ed\uc2dc\uc624. [\ub2e4\uc911 \uc194\ub8e8\uc158 \ube44\uad50: \ud30c\uc6cc\uc5c5 | \uc0ac\uc6a9 \uc0ac\ub840 | \uc81c\ud2b8\ud329 | \ub192\uc774 \ube60\ub974\uac8c \uc5bb\uc74c | \ubc29\ud328 | \ud55c \ubc88\uc758 \uacf5\uaca9 \ubc29\uc5b4 | \uc790\uc11d | \ub3d9\uc804 \uc720\uc778]"}, {"question": "\ub3c4\ub4e4 \u30b8\u30e3\u30f3\u30d7\u30cb\u30f3\u30b8\u30e3\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "\ub3c4\ub4e4 \u30b8\u30e3\u30f3\u30d7\u30cb\u30f3\u30b8\u30e3\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ub2ec\uc131\ud55c \ub192\uc774\uc640 \uc218\uc9d1\ud55c \ub3d9\uc804\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucc29\uc9c0\ud558\ub294 \uac01 \ud50c\ub7ab\ud3fc\uc740 \uc810\uc218\ub97c \uc99d\uac00\uc2dc\ud0a4\uace0, \ub3d9\uc804\uc744 \uc218\uc9d1\ud558\uba74 \ubcf4\ub108\uc2a4 \uc810\uc218\ub97c \ucd94\uac00\ud569\ub2c8\ub2e4. \ub610\ud55c, \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\uace0 \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\ub294 \uac83\ub3c4 \uc810\uc218\ub97c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub192\uc774\uac00 \ub192\uc544\uc9c8\uc218\ub85d \uc5bb\ub294 \uc810\uc218\uac00 \ub9ce\uc544\uc9d1\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc0b0\uc744 \uc624\ub974\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ub192\uc774\uac00 \ub192\uc544\uc9c8\uc218\ub85d \ubcf4\uc0c1\uc774 \ucee4\uc9d1\ub2c8\ub2e4.]"}, {"question": "\ub3c4\ub4e4 \u30b8\u30e3\u30f3\u30d7\u30cb\u30f3\u30b8\u30e3\uc758 \uc228\uaca8\uc9c4 \uc5c5\uc801\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub3c4\ub4e4 \u30b8\u30e3\u30f3\u30d7\u30cb\u30f3\u30b8\u30e3\uc5d0\ub294 \ud2b9\uc815 \ub192\uc774\uc5d0 \ub3c4\ub2ec\ud558\uac70\ub098 \ud2b9\uc815 \uc218\uc758 \ub3d9\uc804\uc744 \uc218\uc9d1\ud558\ub294 \ub4f1 \ud2b9\uc815 \uc870\uac74\uc744 \ucda9\uc871\ud568\uc73c\ub85c\uc368 \uc7a0\uae08 \ud574\uc81c\ub418\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uc5c5\uc801\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud30c\uc6cc\uc5c5 \uc5c6\uc774 10,000\uc810\uc5d0 \ub3c4\ub2ec\ud558\uba74 \uc774 \uc5c5\uc801\uc774 \uc7a0\uae08 \ud574\uc81c\ub429\ub2c8\ub2e4. \ub2e4\uc591\ud55c \uc804\ub7b5\uacfc \ucc4c\ub9b0\uc9c0\ub97c \ud0d0\uad6c\ud558\uc5ec \ubaa8\ub4e0 \uc228\uaca8\uc9c4 \uc5c5\uc801\uc744 \ubc1c\uacac\ud558\uc2ed\uc2dc\uc624. [\ub2e4\uc911 \uc194\ub8e8\uc158 \ube44\uad50: \uc5c5\uc801 | \uc694\uad6c \uc0ac\ud56d | \ub2cc\uc790 \ub9c8\uc2a4\ud130 | \ud30c\uc6cc\uc5c5 \uc5c6\uc774 10,000\uc810 \ub3c4\ub2ec | \ub3d9\uc804 \uc218\uc9d1\uac00 | \ud55c \uac8c\uc784\uc5d0\uc11c 500\uac1c \ub3d9\uc804 \uc218\uc9d1]"}, {"question": "\ub3c4\ub4e4 \u30b8\u30e3\u30f3\u30d7\u30cb\u30f3\u30b8\u30e3\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc0c8\ub85c\uc6b4 \uae30\uae30\uc5d0 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub3c4\ub4e4 \u30b8\u30e3\u30f3\u30d7\u30cb\u30f3\u30b8\u30e3\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc0c8\ub85c\uc6b4 \uae30\uae30\uc5d0 \uc804\uc1a1\ud558\ub824\uba74 \ub450 \uae30\uae30 \ubaa8\ub450\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uad6c\uae00 \ud50c\ub808\uc774 \uac8c\uc784\uc744 \uc0ac\uc6a9\ud558\ub294 \uacbd\uc6b0, \uc0c8\ub85c\uc6b4 \uae30\uae30\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uc2ed\uc2dc\uc624. \uc9c4\ud589 \uc0c1\ud669\uc774 \uc790\ub3d9\uc73c\ub85c \ub3d9\uae30\ud654\ub418\uc5b4\uc57c \ud569\ub2c8\ub2e4. \uadf8\ub807\uc9c0 \uc54a\uc73c\uba74 \uc778\ud130\ub137 \uc5f0\uacb0\uc744 \ud655\uc778\ud558\uace0 \ub2e4\uc2dc \uc2dc\ub3c4\ud558\uc2ed\uc2dc\uc624. [\uc124\uc815 \ub300\uc870\ud45c: \uacc4\uc815 \uc720\ud615 | \ub3d9\uae30\ud654 \ubc29\ubc95 | \uad6c\uae00 \ud50c\ub808\uc774 \uac8c\uc784 | \uc790\ub3d9 | \uc571 \uac8c\uc784 \uc13c\ud130 | \uc790\ub3d9]"}, {"question": "\ub3c4\ub4e4 \u30b8\u30e3\u30f3\u30d7\u30cb\u30f3\u30b8\u30e3\uc5d0\uc11c \uc801\uc744 \ud53c\ud558\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uae30\uc220\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub3c4\ub4e4 \u30b8\u30e3\u30f3\u30d7\u30cb\u30f3\u30b8\u30e3\uc5d0\uc11c \uc801\uc744 \ud53c\ud558\uae30 \uc704\ud574 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc2ed\uc2dc\uc624. 1\ub2e8\uacc4: \ud68c\uc804\ub0a0\uac1c\uc640 \uac19\uc740 \uc801\uc758 \ud328\ud134\uc744 \uad00\ucc30\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \uc801\uc774 \uc5c6\uc744 \ub54c \ud2c8\uc0c8\ub97c \uc9c0\ub098\uac08 \uc218 \uc788\ub3c4\ub85d \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uc870\uc808\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \ubc29\ud328\uc640 \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ubcf4\ud638\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5ec\ub7ec \uc801\uacfc \ub9c8\uc8fc\ud558\uba74 \uc548\uc804\ud558\uac8c \uc9c0\ub098\uac08 \uc218 \uc788\ub294 \uc801\uc808\ud55c \uc21c\uac04\uc5d0 \uc810\ud504\ud558\uc2ed\uc2dc\uc624. [\ud750\ub984\ub3c4: \uc801 \uad00\ucc30 -> \uc810\ud504 \ud0c0\uc774\ubc0d -> \ud30c\uc6cc\uc5c5 \uc0ac\uc6a9 -> \uc9c4\ud589 \uacc4\uc18d]"}, {"question": "\ub3c4\ub4e4 \u30b8\u30e3\u30f3\u30d7\u30cb\u30f3\u30b8\u30e3\uc5d0\uc11c \ud2b9\ubcc4\ud55c \ub2cc\uc790 \uc2a4\ud0a8\uc744 \uc5b4\ub5bb\uac8c \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\uae4c?", "answer": "\ub3c4\ub4e4 \u30b8\u30e3\u30f3\u30d7\u30cb\u30f3\u30b8\u30e3\uc758 \ud2b9\ubcc4\ud55c \ub2cc\uc790 \uc2a4\ud0a8\uc740 \ud2b9\uc815 \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\uac70\ub098 \ucda9\ubd84\ud55c \ub3d9\uc804\uc744 \uc218\uc9d1\ud558\uc5ec \uc7a0\uae08 \ud574\uc81c\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 1,000\uac1c\uc758 \ub3d9\uc804\uc744 \uc218\uc9d1\ud558\uba74 \"\uace8\ub4e0 \ub2cc\uc790\" \uc2a4\ud0a8\uc774 \uc7a0\uae08 \ud574\uc81c\ub429\ub2c8\ub2e4. \ub610\ud55c, \uc77c\ubd80 \uc2a4\ud0a8\uc740 \uc571 \ub0b4 \uad6c\ub9e4\ub97c \ud1b5\ud574 \uc774\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\ubcc4\ud55c \uc2a4\ud0a8\uc744 \uc7a0\uae08 \ud574\uc81c\ud558\uae30 \uc704\ud574 \uacc4\uc18d \uac8c\uc784\ud558\uace0 \ub3d9\uc804\uc744 \uc218\uc9d1\ud558\uc2ed\uc2dc\uc624. [\ub2e4\uc911 \uc194\ub8e8\uc158 \ube44\uad50: \uc2a4\ud0a8 | \uc7a0\uae08 \ud574\uc81c \ubc29\ubc95 | \uace8\ub4e0 \ub2cc\uc790 | 1,000\uac1c \ub3d9\uc804 \uc218\uc9d1 | \uadf8\ub9bc\uc790 \ub2cc\uc790 | \"\ub2cc\uc790 \ub9c8\uc2a4\ud130\" \uc5c5\uc801 \uc644\ub8cc]"}, {"question": "\ub3c4\ub4e4 \u30b8\u30e3\u30f3\u30d7\u30cb\u30f3\u30b8\u30e3\uc758 \ube44\ubc00 \ub808\ubca8\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub3c4\ub4e4 \u30b8\u30e3\u30f3\u30d7\u30cb\u30f3\u30b8\u30e3\uc5d0\ub294 \ud2b9\uc815 \uae30\uc900\uc744 \ucda9\uc871\ud568\uc73c\ub85c\uc368 \uc7a0\uae08 \ud574\uc81c\ub418\ub294 \ube44\ubc00 \ub808\ubca8\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 15,000\uc810\uc5d0 \ub3c4\ub2ec\ud558\uba74 \"\uc2a4\uce74\uc774 \ud15c\ud50c\" \ub808\ubca8\uc774 \uc7a0\uae08 \ud574\uc81c\ub429\ub2c8\ub2e4. \ubaa8\ub4e0 \ube44\ubc00 \ub808\ubca8\uc744 \ubc1c\uacac\ud558\uace0 \uc0c8\ub85c\uc6b4 \ucc4c\ub9b0\uc9c0\ub97c \uc990\uae30\uae30 \uc704\ud574 \uac8c\uc784\uc744 \ucda9\ubd84\ud788 \ud0d0\uc0c9\ud558\uc2ed\uc2dc\uc624. [\ube44\uc720 \uc124\uba85: \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uc744 \ucc3e\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ub354 \ub9ce\uc774 \ud0d0\ud5d8\ud560\uc218\ub85d \ub354 \ub9ce\uc774 \ubc1c\uacac\ud569\ub2c8\ub2e4.]"}]
[{"question": "\u5982\u4f55\u5728\u300a\u8df3\u8dc3\u5fcd\u8005Doodle Jump\u300b\u4e2d\u8fdb\u884c\u57fa\u672c\u8df3\u8dc3\uff1f", "answer": "\u5728\u300a\u8df3\u8dc3\u5fcd\u8005Doodle Jump\u300b\u4e2d\uff0c\u53ef\u4ee5\u901a\u8fc7\u70b9\u51fb\u5c4f\u5e55\u4f7f\u4f60\u7684\u5fcd\u8005\u5411\u4e0a\u8df3\u8dc3\u6765\u8fdb\u884c\u57fa\u672c\u8df3\u8dc3\u3002\u4f8b\u5982\uff0c\u5f53\u4f60\u9047\u5230\u4e00\u4e2a\u5e73\u53f0\u65f6\uff0c\u70b9\u51fb\u5c4f\u5e55\u5373\u53ef\u843d\u5728\u4e0a\u9762\u3002\u5982\u679c\u6309\u4f4f\u4e0d\u653e\uff0c\u4f60\u7684\u5fcd\u8005\u5c06\u8df3\u5f97\u66f4\u9ad8\u3002\u7ec3\u4e60\u8df3\u8dc3\u65f6\u673a\uff0c\u907f\u514d\u6389\u51fa\u5c4f\u5e55\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u60f3\u8c61\u4e00\u4e0b\u5728\u6cb3\u4e0a\u8df3\u7740\u77f3\u5757\u8fc7\u6cb3\u3002]"}, {"question": "\u5728\u300a\u8df3\u8dc3\u5fcd\u8005Doodle Jump\u300b\u4e2d\u83b7\u5f97\u9ad8\u5206\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u8981\u5728\u300a\u8df3\u8dc3\u5fcd\u8005Doodle Jump\u300b\u4e2d\u83b7\u5f97\u9ad8\u5206\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u4e13\u6ce8\u4e8e\u843d\u5728\u5e73\u53f0\u7684\u4e2d\u5fc3\u4ee5\u4fdd\u6301\u5e73\u8861\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u55b7\u5c04\u80cc\u5305\u7b49\u9053\u5177\u5feb\u901f\u83b7\u5f97\u989d\u5916\u9ad8\u5ea6\u3002\u6b65\u9aa43\uff1a\u4ed4\u7ec6\u8c03\u6574\u8df3\u8dc3\u65f6\u673a\uff0c\u907f\u514d\u654c\u4eba\u548c\u969c\u788d\u7269\u3002\u4f8b\u5982\uff0c\u5f53\u4f60\u770b\u5230\u4e00\u4e2a\u79fb\u52a8\u7684\u5e73\u53f0\u65f6\uff0c\u7b49\u5f85\u5408\u9002\u7684\u65f6\u673a\u8df3\u8dc3\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u9053\u5177 | \u6548\u679c | \u55b7\u5c04\u80cc\u5305 | \u5feb\u901f\u83b7\u5f97\u9ad8\u5ea6 | \u62a4\u76fe | \u9632\u5fa1\u4e00\u6b21\u6253\u51fb]"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u5728\u300a\u8df3\u8dc3\u5fcd\u8005Doodle Jump\u300b\u4e2d\u603b\u662f\u8f93\uff1f", "answer": "\u5728\u300a\u8df3\u8dc3\u5fcd\u8005Doodle Jump\u300b\u4e2d\u8f93\u6389\u6e38\u620f\u901a\u5e38\u662f\u56e0\u4e3a\u8df3\u8dc3\u65f6\u673a\u4e0d\u5f53\u6216\u6389\u843d\u5e73\u53f0\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u8df3\u5f97\u592a\u65e9\u6216\u592a\u665a\uff0c\u4f60\u53ef\u80fd\u4f1a\u9519\u8fc7\u5e73\u53f0\u3002\u6b64\u5916\uff0c\u50cf\u65cb\u8f6c\u5200\u7247\u8fd9\u6837\u7684\u654c\u4eba\u5982\u679c\u6ca1\u6709\u8eb2\u907f\uff0c\u53ef\u80fd\u4f1a\u628a\u4f60\u51fb\u843d\u3002\u7ec3\u4e60\u4f60\u7684\u8df3\u8dc3\u65f6\u673a\u5e76\u4fdd\u6301\u8b66\u60d5\uff0c\u4ee5\u6b64\u6765\u63d0\u9ad8\u4f60\u7684\u6e38\u620f\u6c34\u5e73\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u8df3\u8dc3\u65f6\u673a -> \u843d\u5728\u5e73\u53f0\u4e0a -> \u8eb2\u907f\u654c\u4eba -> \u7ee7\u7eed\u524d\u8fdb]"}, {"question": "\u300a\u8df3\u8dc3\u5fcd\u8005Doodle Jump\u300b\u4e2d\u54ea\u4e9b\u9053\u5177\u6700\u6709\u6548\uff1f", "answer": "\u300a\u8df3\u8dc3\u5fcd\u8005Doodle Jump\u300b\u4e2d\u6700\u6709\u6548\u7684\u9053\u5177\u5305\u62ec\u55b7\u5c04\u80cc\u5305\uff08\u53ef\u4ee5\u8ba9\u4f60\u5feb\u901f\u83b7\u5f97\u9ad8\u5ea6\uff09\u548c\u62a4\u76fe\uff08\u53ef\u4ee5\u4fdd\u62a4\u4f60\u514d\u53d7\u4e00\u6b21\u6253\u51fb\uff09\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u55b7\u5c04\u80cc\u5305\u53ef\u4ee5\u5e2e\u52a9\u4f60\u8f7b\u677e\u901a\u8fc7\u56f0\u96be\u533a\u57df\uff0c\u800c\u62a4\u76fe\u53ef\u4ee5\u8ba9\u4f60\u8eb2\u907f\u654c\u4eba\u7684\u653b\u51fb\u3002\u8bf7\u6839\u636e\u5b9e\u9645\u60c5\u51b5\u7b56\u7565\u6027\u5730\u4f7f\u7528\u8fd9\u4e9b\u9053\u5177\uff0c\u4ee5\u6700\u5927\u5316\u5176\u6548\u76ca\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u9053\u5177 | \u4f7f\u7528\u6848\u4f8b | \u55b7\u5c04\u80cc\u5305 | \u5feb\u901f\u83b7\u5f97\u9ad8\u5ea6 | \u62a4\u76fe | \u9632\u5fa1\u4e00\u6b21\u6253\u51fb | \u78c1\u94c1 | \u5438\u5f15\u91d1\u5e01]"}, {"question": "\u300a\u8df3\u8dc3\u5fcd\u8005Doodle Jump\u300b\u4e2d\u7684\u5f97\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u300a\u8df3\u8dc3\u5fcd\u8005Doodle Jump\u300b\u4e2d\u7684\u5f97\u5206\u7cfb\u7edf\u57fa\u4e8e\u4f60\u8fbe\u5230\u7684\u9ad8\u5ea6\u548c\u6536\u96c6\u7684\u91d1\u5e01\u3002\u4f8b\u5982\uff0c\u4f60\u843d\u5230\u6bcf\u4e2a\u5e73\u53f0\u4e0a\u90fd\u4f1a\u589e\u52a0\u4f60\u7684\u5206\u6570\uff0c\u6536\u96c6\u91d1\u5e01\u4f1a\u989d\u5916\u52a0\u5206\u3002\u6b64\u5916\uff0c\u5b8c\u6210\u6311\u6218\u548c\u907f\u514d\u969c\u788d\u7269\u4e5f\u53ef\u4ee5\u63d0\u5347\u4f60\u7684\u5206\u6570\u3002\u4f60\u5f80\u4e0a\u8df3\u5f97\u8d8a\u9ad8\uff0c\u83b7\u5f97\u7684\u5206\u6570\u5c31\u8d8a\u591a\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u60f3\u8c61\u4e00\u4e0b\u6500\u767b\u4e00\u5ea7\u5c71\uff1b\u4f60\u722c\u5f97\u8d8a\u9ad8\uff0c\u5956\u52b1\u5c31\u8d8a\u5927\u3002]"}, {"question": "\u300a\u8df3\u8dc3\u5fcd\u8005Doodle Jump\u300b\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u6210\u5c31\uff1f", "answer": "\u300a\u8df3\u8dc3\u5fcd\u8005Doodle Jump\u300b\u4e2d\u6709\u4e00\u4e9b\u9690\u85cf\u6210\u5c31\uff0c\u4f8b\u5982\u201c\u5fcd\u8005\u5927\u5e08\u201d\uff0c\u5b83\u8981\u6c42\u4f60\u65e0\u9700\u4f7f\u7528\u4efb\u4f55\u9053\u5177\u8fbe\u5230\u7279\u5b9a\u9ad8\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u4e0d\u4f7f\u7528\u9053\u5177\u7684\u60c5\u51b5\u4e0b\u8fbe\u5230 10000 \u5206\u53ef\u4ee5\u89e3\u9501\u6b64\u6210\u5c31\u3002\u63a2\u7d22\u4e0d\u540c\u7684\u7b56\u7565\u548c\u6311\u6218\uff0c\u4ee5\u53d1\u73b0\u6240\u6709\u9690\u85cf\u6210\u5c31\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6210\u5c31 | \u9700\u6c42 | \u5fcd\u8005\u5927\u5e08 | \u5728\u4e0d\u4f7f\u7528\u9053\u5177\u7684\u60c5\u51b5\u4e0b\u8fbe\u5230 10000 \u5206 | \u91d1\u5e01\u6536\u96c6\u8005 | \u5728\u4e00\u573a\u6e38\u620f\u4e2d\u6536\u96c6 500 \u4e2a\u91d1\u5e01]"}, {"question": "\u5982\u4f55\u5728\u300a\u8df3\u8dc3\u5fcd\u8005Doodle Jump\u300b\u4e2d\u5c06\u6211\u7684\u6e38\u620f\u8fdb\u5ea6\u8f6c\u79fb\u5230\u65b0\u8bbe\u5907\uff1f", "answer": "\u8981\u5c06\u300a\u8df3\u8dc3\u5fcd\u8005Doodle Jump\u300b\u4e2d\u7684\u6e38\u620f\u8fdb\u5ea6\u8f6c\u79fb\u5230\u65b0\u8bbe\u5907\uff0c\u8bf7\u786e\u4fdd\u4f60\u5728\u4e24\u53f0\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u540c\u4e00\u4e2a\u8d26\u6237\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4f7f\u7528 Google Play \u6e38\u620f\uff0c\u8bf7\u5728\u65b0\u8bbe\u5907\u4e0a\u4f7f\u7528\u540c\u4e00\u4e2a\u8d26\u6237\u767b\u5f55\u3002\u4f60\u7684\u8fdb\u5ea6\u5e94\u8be5\u4f1a\u81ea\u52a8\u540c\u6b65\u3002\u5982\u679c\u6ca1\u6709\uff0c\u8bf7\u68c0\u67e5\u4f60\u7684\u4e92\u8054\u7f51\u8fde\u63a5\u5e76\u91cd\u8bd5\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u8d26\u6237\u7c7b\u578b | \u540c\u6b65\u65b9\u6cd5 | Google Play \u6e38\u620f | \u81ea\u52a8\u540c\u6b65 | Apple \u6e38\u620f\u4e2d\u5fc3 | \u81ea\u52a8\u540c\u6b65]"}, {"question": "\u5728\u300a\u8df3\u8dc3\u5fcd\u8005Doodle Jump\u300b\u4e2d\u8eb2\u907f\u654c\u4eba\u7684\u6700\u4f73\u6280\u5de7\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300a\u8df3\u8dc3\u5fcd\u8005Doodle Jump\u300b\u4e2d\u8eb2\u907f\u654c\u4eba\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u89c2\u5bdf\u654c\u4eba\u7684\u6a21\u5f0f\uff0c\u4f8b\u5982\u65cb\u8f6c\u5200\u7247\u7684\u65cb\u8f6c\u3002\u6b65\u9aa42\uff1a\u8c03\u6574\u4f60\u7684\u8df3\u8dc3\u65f6\u673a\uff0c\u5728\u654c\u4eba\u4e0d\u5728\u65f6\u7a7f\u8fc7\u7a7a\u9699\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u62a4\u76fe\u7b49\u9053\u5177\u8fdb\u884c\u4fdd\u62a4\u3002\u4f8b\u5982\uff0c\u5f53\u9762\u5bf9\u4e00\u7fa4\u654c\u4eba\u65f6\uff0c\u7b49\u5f85\u5408\u9002\u7684\u65f6\u673a\u5b89\u5168\u5730\u8df3\u8dc3\u8fc7\u53bb\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u89c2\u5bdf\u654c\u4eba -> \u8c03\u6574\u8df3\u8dc3\u65f6\u673a -> \u4f7f\u7528\u9053\u5177 -> \u7ee7\u7eed\u524d\u8fdb]"}, {"question": "\u5982\u4f55\u5728\u300a\u8df3\u8dc3\u5fcd\u8005Doodle Jump\u300b\u4e2d\u89e3\u9501\u7279\u6b8a\u5fcd\u8005\u76ae\u80a4\uff1f", "answer": "\u5728\u300a\u8df3\u8dc3\u5fcd\u8005Doodle Jump\u300b\u4e2d\uff0c\u901a\u8fc7\u5b8c\u6210\u7279\u5b9a\u6311\u6218\u6216\u6536\u96c6\u8db3\u591f\u7684\u91d1\u5e01\u6765\u89e3\u9501\u7279\u6b8a\u5fcd\u8005\u76ae\u80a4\u3002\u4f8b\u5982\uff0c\u6536\u96c6 1000 \u679a\u91d1\u5e01\u53ef\u4ee5\u89e3\u9501\u201c\u9ec4\u91d1\u5fcd\u8005\u201d\u76ae\u80a4\u3002\u6b64\u5916\uff0c\u8fd8\u6709\u4e00\u4e9b\u76ae\u80a4\u53ef\u4ee5\u901a\u8fc7\u5e94\u7528\u5185\u8d2d\u4e70\u83b7\u5f97\u3002\u7ee7\u7eed\u6e38\u620f\u5e76\u6536\u96c6\u91d1\u5e01\u4ee5\u89e3\u9501\u8fd9\u4e9b\u7279\u6b8a\u76ae\u80a4\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u76ae\u80a4 | \u89e3\u9501\u65b9\u6cd5 | \u9ec4\u91d1\u5fcd\u8005 | \u6536\u96c6 1000 \u679a\u91d1\u5e01 | \u6697\u5f71\u5fcd\u8005 | \u5b8c\u6210\u201c\u5fcd\u8005\u5927\u5e08\u201d\u6210\u5c31]"}, {"question": "\u300a\u8df3\u8dc3\u5fcd\u8005Doodle Jump\u300b\u4e2d\u6709\u54ea\u4e9b\u79d8\u5bc6\u5173\u5361\uff1f", "answer": "\u300a\u8df3\u8dc3\u5fcd\u8005Doodle Jump\u300b\u4e2d\u6709\u51e0\u4e2a\u79d8\u5bc6\u5173\u5361\uff0c\u8fd9\u4e9b\u5173\u5361\u53ef\u4ee5\u901a\u8fc7\u6ee1\u8db3\u7279\u5b9a\u6761\u4ef6\u6765\u89e3\u9501\uff0c\u4f8b\u5982\u8fbe\u5230\u7279\u5b9a\u9ad8\u5ea6\u6216\u6536\u96c6\u4e00\u5b9a\u6570\u91cf\u7684\u91d1\u5e01\u3002\u4f8b\u5982\uff0c\u8fbe\u5230 15000 \u5206\u53ef\u4ee5\u89e3\u9501\u201c\u5929\u7a7a\u795e\u5e99\u201d\u5173\u5361\u3002\u5f7b\u5e95\u63a2\u7d22\u6e38\u620f\uff0c\u4ee5\u53d1\u73b0\u6240\u6709\u79d8\u5bc6\u5173\u5361\u5e76\u4eab\u53d7\u65b0\u7684\u6311\u6218\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u60f3\u8c61\u4e00\u4e0b\u5bfb\u627e\u9690\u85cf\u5b9d\u85cf\uff1b\u4f60\u63a2\u7d22\u5f97\u8d8a\u591a\uff0c\u53d1\u73b0\u7684\u5c31\u8d8a\u591a\u3002]"}]
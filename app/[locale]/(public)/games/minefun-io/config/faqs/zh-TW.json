[{"question": "\u5982\u4f55\u6709\u6548\u5730\u8b93\u65b0\u624b\u958b\u59cb\u5728MineFun.io\u904a\u6232\u4e2d\u904a\u73a9\uff1f", "answer": "\u8981\u5728MineFun.io\u904a\u6232\u4e2d\u6709\u6548\u4e0a\u624b\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u5b8c\u6210\u6559\u5b78\u4ee5\u4e86\u89e3\u57fa\u672c\u64cd\u4f5c\u3002\u6b65\u9a5f2\uff1a\u5c08\u6ce8\u65bc\u6536\u96c6\u57fa\u672c\u8cc7\u6e90\uff0c\u4f8b\u5982\u6728\u6750\u548c\u77f3\u982d\u3002\u6b65\u9a5f3\uff1a\u5efa\u9020\u7c21\u6613\u7684\u5e87\u8b77\u6240\u4f86\u62b5\u79a6\u591c\u9593\u602a\u7269\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u6728\u6750\u88fd\u4f5c\u93df\u5b50\uff0c\u9019\u5c0d\u65bc\u6316\u6398\u81f3\u95dc\u91cd\u8981\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u4f60\u7b2c\u4e00\u500b\u5e87\u8b77\u6240\u60f3\u6210\u5192\u96aa\u4e2d\u7684\u57fa\u5730\u71df\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u8cc7\u6e90\u7ba1\u7406\u5c0d\u65bc\u9032\u968e\u73a9\u5bb6\u5728MineFun.io\u904a\u6232\u4e2d\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u8cc7\u6e90\u7ba1\u7406\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u78ba\u4fdd\u4e86\u53ef\u6301\u7e8c\u6027\u548c\u6548\u7387\u3002\u9032\u968e\u73a9\u5bb6\u61c9\u8a72\uff1a\u6b65\u9a5f1\uff1a\u512a\u5148\u8003\u616e\u7a00\u6709\u8cc7\u6e90\uff0c\u4f8b\u5982\u947d\u77f3\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u81ea\u52d5\u8fb2\u5834\u6301\u7e8c\u6536\u96c6\u98df\u7269\u3002\u6b65\u9a5f3\uff1a\u5206\u914d\u8cc7\u6e90\u7528\u65bc\u88fd\u4f5c\u9ad8\u7d1a\u5de5\u5177\u548c\u88dd\u7532\u3002\u4f8b\u5982\uff0c\u81ea\u52d5\u5316\u9ea5\u7530\u8fb2\u5834\u53ef\u4ee5\u63d0\u4f9b\u7a69\u5b9a\u7684\u98df\u7269\u4f86\u6e90\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u624b\u52d5\u8015\u7a2e\u8207\u81ea\u52d5\u5316\u8015\u7a2e\u7684\u6548\u7387\u3002]"}, {"question": "MineFun.io\u55ae\u4eba\u6a21\u5f0f\u8207\u591a\u4eba\u6a21\u5f0f\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "\u4e3b\u8981\u5dee\u7570\u5305\u62ec\uff1a1)\u4e92\u52d5\uff1a\u591a\u4eba\u6a21\u5f0f\u5141\u8a31\u5408\u4f5c\u8207\u7af6\u722d\u30022)\u8cc7\u6e90\u5171\u4eab\uff1a\u73a9\u5bb6\u53ef\u4ee5\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\u4ea4\u6613\u8cc7\u6e90\u30023)\u904a\u6232\u7bc0\u594f\uff1a\u7531\u65bc\u5171\u6709\u76ee\u6a19\uff0c\u591a\u4eba\u6a21\u5f0f\u7684\u7bc0\u594f\u901a\u5e38\u8f03\u5feb\u3002\u4f8b\u5982\uff0c\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f60\u5011\u53ef\u4ee5\u7d44\u968a\u66f4\u5feb\u5730\u64ca\u6557\u672b\u5f71\u9f8d\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u55ae\u4eba\u6a21\u5f0f\u8207\u591a\u4eba\u6a21\u5f0f\u8cc7\u6e90\u6536\u96c6\u901f\u5ea6\u5c0d\u7167\u8868\u3002]"}, {"question": "MineFun.io\u7684\u88fd\u4f5c\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff0c\u4ee5\u53ca\u4e00\u4e9b\u5fc5\u8981\u7684\u88fd\u4f5c\u914d\u65b9\u662f\u4ec0\u9ebc\uff1f", "answer": "\u88fd\u4f5c\u7cfb\u7d71\u6d89\u53ca\u4f7f\u7528\u7db2\u683c\u4f86\u7d44\u5408\u8cc7\u6e90\u3002\u5fc5\u8981\u7684\u914d\u65b9\u5305\u62ec\uff1a1) \u6728\u8cea\u93df\u5b50\uff1a3\u584a\u6728\u677f + 2\u6839\u6728\u68cd\u30022) \u7194\u7210\uff1a8\u584a\u77f3\u78da\u30023) \u7194\u7210\uff1a1\u6839\u6728\u68cd + 1\u584a\u7164\u70ad\u3002\u4f8b\u5982\uff0c\u88fd\u4f5c\u7194\u7210\u53ef\u4ee5\u8b93\u4f60\u5c07\u7926\u77f3\u7194\u7149\u6210\u91d1\u5c6c\u9320\u3002[\u6d41\u7a0b\u5716\u89e3: \u5f9e\u539f\u6750\u6599\u5230\u6700\u7d42\u7522\u54c1\u7684\u88fd\u4f5c\u6d41\u7a0b\u5716\u3002]"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u53ef\u4ee5\u5e6b\u52a9\u73a9\u5bb6\u5728MineFun.io\u904a\u6232\u4e2d\u64ca\u6557\u672b\u5f71\u9f8d\uff1f", "answer": "\u8981\u64ca\u6557\u672b\u5f71\u9f8d\uff1a\u6b65\u9a5f1\uff1a\u6e96\u5099\u597d\u947d\u77f3\u76d4\u7532\u548c\u9644\u9b54\u5f13\u7bad\u3002\u6b65\u9a5f2\uff1a\u6467\u6bc0\u672b\u5f71\u6676\u9ad4\u4ee5\u9632\u6b62\u5b83\u75ca\u7652\u3002\u6b65\u9a5f3\uff1a\u7576\u9f8d\u505c\u68f2\u6642\u653b\u64ca\u5b83\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u9644\u6709\u529b\u91cf\u9644\u9b54\u7684\u5f13\u53ef\u4ee5\u589e\u52a0\u50b7\u5bb3\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u8fd1\u6230\u8207\u9060\u7a0b\u653b\u64ca\u7684\u6709\u6548\u6027\u5c0d\u6bd4\u3002]"}, {"question": "MineFun.io\u904a\u6232\u4e2d\u7684\u96b1\u85cf\u5f69\u86cb\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u73a9\u5bb6\u5982\u4f55\u627e\u5230\u5b83\u5011\uff1f", "answer": "\u96b1\u85cf\u5f69\u86cb\u5305\u62ec\uff1a1) \"\u8d6b\u863f\u5e03\u6797\"\u7684\u795e\u8a71\uff0c\u9019\u6d89\u53ca\u5230\u5c0b\u627e\u7279\u5b9a\u7d50\u69cb\u30022) \u7a00\u6709\u7684\u751f\u7269\u7fa4\u7cfb\u7279\u5b9a\u6230\u5229\u54c1\u30023) \u904a\u6232\u7a0b\u5f0f\u78bc\u4e2d\u7684\u79d8\u5bc6\u8a0a\u606f\u3002\u4f8b\u5982\uff0c\u63a2\u7d22\u5ee2\u68c4\u7684\u7926\u4e95\u53ef\u4ee5\u767c\u73fe\u7a00\u6709\u7269\u54c1\u3002[\u5f69\u86cb\u6316\u6398: \u627e\u5230\u5f69\u86cb\u7684\u5730\u9ede\u548c\u63d0\u793a\u3002]"}, {"question": "\u5982\u4f55\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e0a\u512a\u5316MineFun.io\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u8981\u8de8\u5e73\u53f0\u512a\u5316\uff1a1) \u78ba\u4fdd\u4f60\u7684\u5e33\u6236\u5df2\u9023\u7d50\uff0c\u4ee5\u4fbf\u9032\u884c\u8de8\u5e73\u53f0\u904a\u73a9\u30022) \u8abf\u6574\u8a2d\u5b9a\uff0c\u4ee5\u7372\u5f97\u6bcf\u500b\u88dd\u7f6e\u6700\u4f73\u7684\u6548\u80fd\u30023) \u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u4f86\u9806\u66a2\u5730\u7e7c\u7e8c\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u96fb\u8166\u4e0a\u904a\u73a9\u53ef\u4ee5\u5141\u8a31\u66f4\u9ad8\u7684\u5716\u5f62\u8a2d\u5b9a\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u96fb\u8166\u3001\u4e3b\u6a5f\u548c\u884c\u52d5\u88dd\u7f6e\u7684\u6548\u80fd\u8a2d\u5b9a\u5c0d\u7167\u8868\u3002]"}, {"question": "MineFun.io\u904a\u6232\u4e2d\u602a\u7269\u7522\u751f\u7684\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "\u602a\u7269\u7522\u751f\u7684\u6a5f\u5236\u5305\u62ec\uff1a1) \u5149\u7dda\u7b49\u7d1a\uff1a\u602a\u7269\u5728\u9ed1\u6697\u5340\u57df\u751f\u6210\u30022) \u751f\u7269\u7fa4\u7cfb\u7279\u5b9a\u602a\u7269\uff1a\u7279\u5b9a\u602a\u7269\u51fa\u73fe\u5728\u7279\u5b9a\u751f\u7269\u7fa4\u7cfb\u4e2d\u30023) \u751f\u6210\u9650\u5236\uff1a\u5340\u57df\u53ea\u80fd\u652f\u63f4\u7279\u5b9a\u6578\u91cf\u7684\u602a\u7269\u3002\u4f8b\u5982\uff0c\u53f2\u840a\u59c6\u5728\u9ed1\u6697\u3001\u68ee\u6797\u5730\u5340\u751f\u6210\u3002[\u7cfb\u7d71\u89e3\u6790: \u5149\u7dda\u7b49\u7d1a\u548c\u751f\u7269\u7fa4\u7cfb\u5728\u602a\u7269\u7522\u751f\u7684\u4e92\u52d5\u3002]"}, {"question": "\u5982\u4f55\u5728MineFun.io\u904a\u6232\u4e2d\u6709\u6548\u5730\u958b\u63a1\u947d\u77f3\uff1f", "answer": "\u8981\u6709\u6548\u5730\u958b\u63a1\u947d\u77f3\uff1a\u6b65\u9a5f1\uff1a\u5f80\u4e0b\u6316\u5230Y\u7b49\u7d1a 11-15\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u5206\u652f\u958b\u63a1\u6cd5\u8986\u84cb\u66f4\u591a\u5340\u57df\u3002\u6b65\u9a5f3\uff1a\u4f7f\u7528\u9644\u6709\u5e78\u904b\u7684\u93df\u5b50\u4f86\u589e\u52a0\u7522\u91cf\u3002\u4f8b\u5982\uff0c\u5206\u652f\u958b\u63a1\u6cd5\u6d89\u53ca\u6bcf\u96942\u683c\u5275\u9020\u96a7\u9053\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u5206\u652f\u958b\u63a1\u6cd5\u60f3\u6210\u5728\u5730\u7403\u4e0a\u5275\u9020\u4e00\u689d\u8108\u7d61\u7db2\u8def\u3002]"}, {"question": "\u52a0\u5165MineFun.io\u793e\u7fa4\u6216\u4f3a\u670d\u5668\u6709\u4ec0\u9ebc\u597d\u8655\uff1f", "answer": "\u597d\u8655\u5305\u62ec\uff1a1) \u5408\u4f5c\u5c08\u6848\uff1a\u4e00\u8d77\u5efa\u9020\u5927\u578b\u5efa\u7bc9\u7269\u30022) \u5206\u4eab\u77e5\u8b58\uff1a\u5411\u4ed6\u4eba\u5b78\u7fd2\u5148\u9032\u7b56\u7565\u30023) \u793e\u4ea4\u4e92\u52d5\uff1a\u4ea4\u670b\u53cb\u4e26\u53c3\u52a0\u6d3b\u52d5\u3002\u4f8b\u5982\uff0c\u52a0\u5165\u4f3a\u670d\u5668\u53ef\u4ee5\u5e6b\u52a9\u4f60\u66f4\u5feb\u5b8c\u6210\u904a\u6232\u6210\u5c31\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u55ae\u4eba\u904a\u73a9\u8207\u793e\u7fa4\u904a\u73a9\u7684\u512a\u52e2\u6bd4\u8f03\u3002]"}]
[{"question": "MineFun.io\u3092\u52b9\u679c\u7684\u306b\u59cb\u3081\u308b\u306b\u306f\u3001\u521d\u5fc3\u8005\u306e\u65b9\u306b\u3068\u3063\u3066\u3069\u306e\u3088\u3046\u306a\u65b9\u6cd5\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "MineFun.io\u3067\u52b9\u679c\u7684\u306b\u59cb\u3081\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u624b\u98061\uff1a\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u7406\u89e3\u3059\u308b\u305f\u3081\u306b\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3092\u5b8c\u4e86\u3059\u308b\u3002\u624b\u98062\uff1a\u6728\u6750\u3084\u77f3\u306a\u3069\u306e\u57fa\u672c\u7684\u306a\u8cc7\u6e90\u3092\u53ce\u96c6\u3059\u308b\u306e\u306b\u96c6\u4e2d\u3059\u308b\u3002\u624b\u98063\uff1a\u591c\u9593\u306e\u30e2\u30d6\u304b\u3089\u8eab\u3092\u5b88\u308b\u305f\u3081\u306e\u7c21\u5358\u306a\u30b7\u30a7\u30eb\u30bf\u30fc\u3092\u5efa\u8a2d\u3059\u308b\u3002\u305f\u3068\u3048\u3070\u3001\u6728\u3092\u4f7f\u3063\u3066\u30d4\u30c3\u30b1\u30eb\u3092\u4f5c\u6210\u3059\u308b\u3068\u3001\u63a1\u6398\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002[\u4f8b\u3048\uff1a\u6700\u521d\u306e\u30b7\u30a7\u30eb\u30bf\u30fc\u3092\u5192\u967a\u3067\u306e\u62e0\u70b9\u3068\u8003\u3048\u308b\u3002]"}, {"question": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u3001MineFun.io\u306b\u304a\u3051\u308b\u8cc7\u6e90\u7ba1\u7406\u306f\u306a\u305c\u91cd\u8981\u306a\u306e\u3067\u3059\u304b\uff1f", "answer": "\u8cc7\u6e90\u7ba1\u7406\u306f\u3001\u6301\u7d9a\u6027\u3068\u52b9\u7387\u6027\u3092\u78ba\u4fdd\u3059\u308b\u305f\u3081\u91cd\u8981\u3067\u3059\u3002\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u4ee5\u4e0b\u306e\u70b9\u3092\u8003\u616e\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u624b\u98061\uff1a\u30c0\u30a4\u30e4\u30e2\u30f3\u30c9\u306a\u3069\u306e\u5e0c\u5c11\u306a\u8cc7\u6e90\u3092\u512a\u5148\u3059\u308b\u3002\u624b\u98062\uff1a\u81ea\u52d5\u8fb2\u5834\u3092\u4f7f\u7528\u3057\u3066\u3001\u7d99\u7d9a\u7684\u306b\u98df\u6599\u3092\u53ce\u96c6\u3059\u308b\u3002\u624b\u98063\uff1a\u9ad8\u5ea6\u306a\u30c4\u30fc\u30eb\u3068\u30a2\u30fc\u30de\u30fc\u3092\u88fd\u4f5c\u3059\u308b\u305f\u3081\u306e\u8cc7\u6e90\u3092\u5272\u308a\u5f53\u3066\u308b\u3002\u4f8b\u3048\u3070\u3001\u5c0f\u9ea6\u306e\u81ea\u52d5\u8fb2\u5834\u3092\u69cb\u7bc9\u3059\u308b\u3068\u3001\u5b89\u5b9a\u3057\u305f\u98df\u6599\u4f9b\u7d66\u3092\u5f97\u3089\u308c\u307e\u3059\u3002[\u8907\u6570\u306e\u89e3\u6c7a\u7b56\u6bd4\u8f03\uff1a\u624b\u52d5\u8fb2\u696d\u3068\u81ea\u52d5\u8fb2\u696d\u306e\u52b9\u7387\u6027\u3002]"}, {"question": "MineFun.io\u306b\u304a\u3051\u308b\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u4e3b\u306a\u9055\u3044\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\u30021\uff09\u76f8\u4e92\u4f5c\u7528\uff1a\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u306f\u3001\u5354\u529b\u3068\u7af6\u4e89\u304c\u53ef\u80fd\u306b\u306a\u308a\u307e\u3059\u30022\uff09\u8cc7\u6e90\u5171\u6709\uff1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u8cc7\u6e90\u3092\u4ea4\u63db\u3067\u304d\u307e\u3059\u30023\uff09\u30b2\u30fc\u30e0\u30da\u30fc\u30b9\uff1a\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u5171\u6709\u306e\u76ee\u6a19\u306e\u305f\u3081\u306b\u901a\u5e38\u3001\u30da\u30fc\u30b9\u304c\u901f\u304f\u306a\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u306f\u3001\u30c1\u30fc\u30e0\u3092\u7d44\u3093\u3067\u30a8\u30f3\u30c0\u30fc\u30c9\u30e9\u30b4\u30f3\u3092\u8fc5\u901f\u306b\u5012\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u8a2d\u5b9a\u6bd4\u8f03\u8868\uff1a\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u8cc7\u6e90\u53ce\u96c6\u901f\u5ea6\u3002]"}, {"question": "MineFun.io\u306e\u30af\u30e9\u30d5\u30c8\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u91cd\u8981\u306a\u30ec\u30b7\u30d4\u306f\u3069\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u304b\uff1f", "answer": "\u30af\u30e9\u30d5\u30c8\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b0\u30ea\u30c3\u30c9\u3092\u4f7f\u7528\u3057\u3066\u8cc7\u6e90\u3092\u7d44\u307f\u5408\u308f\u305b\u3066\u3044\u307e\u3059\u3002\u91cd\u8981\u306a\u30ec\u30b7\u30d4\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\u30021\uff09\u6728\u88fd\u306e\u30d4\u30c3\u30b1\u30eb\uff1a\u6728\u6750\u306e\u677f3\u679a+\u6728\u306e\u68d22\u672c\u30022\uff09\u6eb6\u9271\u7089\uff1a\u77f3\u70ad8\u500b\u30023\uff09\u305f\u3044\u307e\u3064\uff1a\u6728\u306e\u68d21\u672c+\u77f3\u70ad1\u500b\u3002\u305f\u3068\u3048\u3070\u3001\u6eb6\u9271\u7089\u3092\u4f5c\u6210\u3059\u308b\u3068\u3001\u9271\u77f3\u3092\u9271\u77f3\u306e\u30a4\u30f3\u30b4\u30c3\u30c8\u306b\u5909\u63db\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u539f\u6750\u6599\u304b\u3089\u6700\u7d42\u88fd\u54c1\u307e\u3067\u306e\u30af\u30e9\u30d5\u30c8\u30d7\u30ed\u30bb\u30b9\u3002]"}, {"question": "MineFun.io\u3067\u30a8\u30f3\u30c0\u30fc\u30c9\u30e9\u30b4\u30f3\u3092\u5012\u3059\u306e\u306b\u5f79\u7acb\u3064\u6226\u7565\u306f\u3001\u3069\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u304b\uff1f", "answer": "\u30a8\u30f3\u30c0\u30fc\u30c9\u30e9\u30b4\u30f3\u3092\u5012\u3059\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u624b\u98061\uff1a\u30c0\u30a4\u30e4\u30e2\u30f3\u30c9\u30a2\u30fc\u30de\u30fc\u3068\u30a8\u30f3\u30c1\u30e3\u30f3\u30c8\u3055\u308c\u305f\u5f13\u3067\u6e96\u5099\u3059\u308b\u3002\u624b\u98062\uff1a\u30a8\u30f3\u30c9\u30af\u30ea\u30b9\u30bf\u30eb\u3092\u7834\u58ca\u3057\u3066\u56de\u5fa9\u3092\u9632\u3050\u3002\u624b\u98063\uff1a\u30c9\u30e9\u30b4\u30f3\u304c\u7559\u307e\u3063\u3066\u3044\u308b\u3068\u304d\u306b\u653b\u6483\u3059\u308b\u3002\u305f\u3068\u3048\u3070\u3001\u529b\u30a8\u30f3\u30c1\u30e3\u30f3\u30c8\u304c\u65bd\u3055\u308c\u305f\u5f13\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u30c0\u30e1\u30fc\u30b8\u304c\u5897\u52a0\u3057\u307e\u3059\u3002[\u8907\u6570\u306e\u89e3\u6c7a\u7b56\u6bd4\u8f03\uff1a\u8fd1\u63a5\u653b\u6483\u3068\u9060\u9694\u653b\u6483\u306e\u52b9\u679c\u3002]"}, {"question": "MineFun.io\u306e\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u4f55\u3067\u3042\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u305d\u308c\u3089\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306b\u306f\u6b21\u306e\u3088\u3046\u306a\u3082\u306e\u304c\u3042\u308a\u307e\u3059\u30021\uff09\u7279\u5b9a\u306e\u69cb\u9020\u7269\u3092\u767a\u898b\u3059\u308b\u300c\u30d2\u30fc\u30ed\u30fc\u30d6\u30e9\u30a4\u30f3\u300d\u306e\u4f1d\u8aac\u30022\uff09\u5e0c\u5c11\u306a\u30d0\u30a4\u30aa\u30fc\u30e0\u56fa\u6709\u306e\u6226\u5229\u54c1\u30023\uff09\u30b2\u30fc\u30e0\u30b3\u30fc\u30c9\u306e\u79d8\u5bc6\u306e\u30e1\u30c3\u30bb\u30fc\u30b8\u3002\u305f\u3068\u3048\u3070\u3001\u653e\u68c4\u3055\u308c\u305f\u9271\u5c71\u3092\u63a2\u7d22\u3059\u308b\u3068\u3001\u5e0c\u5c11\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u3002[\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u63a2\u7d22\uff1a\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u898b\u3064\u3051\u308b\u5834\u6240\u3068\u30d2\u30f3\u30c8\u3002]"}, {"question": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u30d7\u30ec\u30a4\u30e4\u30fc\u306fMineFun.io\u306e\u7d4c\u9a13\u3092\u3069\u306e\u3088\u3046\u306b\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u6b21\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u30021\uff09\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u305f\u3081\u306b\u30ea\u30f3\u30af\u3059\u308b\u30022\uff09\u5404\u30c7\u30d0\u30a4\u30b9\u3067\u6700\u9069\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306e\u305f\u3081\u306b\u8a2d\u5b9a\u3092\u8abf\u6574\u3059\u308b\u30023\uff09\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u4f7f\u7528\u3057\u3066\u3001\u30b7\u30fc\u30e0\u30ec\u30b9\u306b\u9032\u884c\u72b6\u6cc1\u3092\u7d99\u7d9a\u3059\u308b\u3002\u305f\u3068\u3048\u3070\u3001PC\u3067\u30d7\u30ec\u30a4\u3059\u308b\u3068\u3001\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3092\u3088\u308a\u9ad8\u304f\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u8a2d\u5b9a\u6bd4\u8f03\u8868\uff1aPC\u3001\u30b3\u30f3\u30bd\u30fc\u30eb\u3001\u30e2\u30d0\u30a4\u30eb\u3067\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u8a2d\u5b9a\u3002]"}, {"question": "MineFun.io\u306e\u30e2\u30d6\u51fa\u73fe\u30b7\u30b9\u30c6\u30e0\u306e\u4ed5\u7d44\u307f\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30e2\u30d6\u51fa\u73fe\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u306f\u3001\u6b21\u306e\u3082\u306e\u304c\u3042\u308a\u307e\u3059\u30021\uff09\u5149\u30ec\u30d9\u30eb\uff1a\u30e2\u30d6\u306f\u6697\u3044\u5834\u6240\u306b\u51fa\u73fe\u3059\u308b\u30022\uff09\u30d0\u30a4\u30aa\u30fc\u30e0\u56fa\u6709\u306e\u30e2\u30d6\uff1a\u7279\u5b9a\u306e\u30e2\u30d6\u306f\u7279\u5b9a\u306e\u30d0\u30a4\u30aa\u30fc\u30e0\u306b\u51fa\u73fe\u3059\u308b\u30023\uff09\u51fa\u73fe\u5236\u9650\uff1a\u9818\u57df\u306f\u4e00\u5b9a\u6570\u306e\u30e2\u30d6\u3057\u304b\u30b5\u30dd\u30fc\u30c8\u3067\u304d\u307e\u305b\u3093\u3002\u305f\u3068\u3048\u3070\u3001\u30af\u30ea\u30fc\u30d1\u30fc\u306f\u6697\u3044\u68ee\u6797\u5730\u5e2f\u3067\u51fa\u73fe\u3057\u307e\u3059\u3002[\u30b7\u30b9\u30c6\u30e0\u89e3\u6790\uff1a\u30e2\u30d6\u51fa\u73fe\u306b\u304a\u3051\u308b\u5149\u30ec\u30d9\u30eb\u3068\u30d0\u30a4\u30aa\u30fc\u30e0\u306e\u76f8\u4e92\u4f5c\u7528\u3002]"}, {"question": "MineFun.io\u3067\u52b9\u7387\u7684\u306b\u30c0\u30a4\u30e4\u30e2\u30f3\u30c9\u3092\u63a1\u6398\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u52b9\u7387\u7684\u306b\u30c0\u30a4\u30e4\u30e2\u30f3\u30c9\u3092\u63a1\u6398\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u624b\u98061\uff1aY\u30ec\u30d9\u30eb11\uff5e15\u307e\u3067\u6398\u308a\u9032\u3080\u3002\u624b\u98062\uff1a\u5206\u5c90\u63a1\u6398\u3092\u4f7f\u7528\u3057\u3066\u3001\u3088\u308a\u591a\u304f\u306e\u30a8\u30ea\u30a2\u3092\u30ab\u30d0\u30fc\u3059\u308b\u3002\u624b\u98063\uff1a\u30d5\u30a9\u30fc\u30c1\u30e5\u30f3\u30a8\u30f3\u30c1\u30e3\u30f3\u30c8\u3055\u308c\u305f\u30d4\u30c3\u30b1\u30eb\u3092\u4f7f\u7528\u3057\u3066\u3001\u53ce\u91cf\u3092\u5897\u3084\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5206\u5c90\u63a1\u6398\u3067\u306f\u30012\u30d6\u30ed\u30c3\u30af\u3054\u3068\u306b\u30c8\u30f3\u30cd\u30eb\u3092\u4f5c\u6210\u3057\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u5206\u5c90\u63a1\u6398\u3092\u3001\u5730\u9762\u306b\u8108\u7d61\u306e\u30cd\u30c3\u30c8\u30ef\u30fc\u30af\u3092\u4f5c\u6210\u3059\u308b\u3053\u3068\u3068\u8003\u3048\u308b\u3002]"}, {"question": "MineFun.io\u306e\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u307e\u305f\u306f\u30b5\u30fc\u30d0\u30fc\u306b\u53c2\u52a0\u3059\u308b\u3053\u3068\u306e\u5229\u70b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u5229\u70b9\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\u30021\uff09\u5171\u540c\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\uff1a\u4e00\u7dd2\u306b\u5927\u304d\u306a\u69cb\u9020\u7269\u3092\u5efa\u8a2d\u3059\u308b\u30022\uff09\u5171\u6709\u306e\u77e5\u8b58\uff1a\u4ed6\u306e\u4eba\u304b\u3089\u9ad8\u5ea6\u306a\u6226\u7565\u3092\u5b66\u3076\u30023\uff09\u793e\u4f1a\u7684\u4ea4\u6d41\uff1a\u53cb\u4eba\u3092\u4f5c\u308b\u53c2\u52a0\u30a4\u30d9\u30f3\u30c8\u3002\u305f\u3068\u3048\u3070\u3001\u30b5\u30fc\u30d0\u30fc\u306b\u53c2\u52a0\u3059\u308b\u3068\u3001\u30b2\u30fc\u30e0\u306e\u9054\u6210\u76ee\u6a19\u3092\u3088\u308a\u65e9\u304f\u9054\u6210\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002[\u8907\u6570\u306e\u89e3\u6c7a\u7b56\u6bd4\u8f03\uff1a\u30bd\u30ed\u30d7\u30ec\u30a4\u3068\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u30d7\u30ec\u30a4\u306e\u5229\u70b9\u3002]"}]
[{"question": "\u521d\u5b66\u8005\u5982\u4f55\u6709\u6548\u5730\u5f00\u59cb\u73a9MineFun.io\uff1f", "answer": "\u5728MineFun.io\u4e2d\u6709\u6548\u5165\u95e8\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41\uff1a\u5b8c\u6210\u6559\u7a0b\uff0c\u4e86\u89e3\u57fa\u672c\u64cd\u4f5c\u3002\u6b65\u9aa42\uff1a\u4e13\u6ce8\u4e8e\u6536\u96c6\u57fa\u672c\u8d44\u6e90\uff0c\u4f8b\u5982\u6728\u6750\u548c\u77f3\u5934\u3002\u6b65\u9aa43\uff1a\u5efa\u9020\u4e00\u4e2a\u7b80\u5355\u7684\u5e87\u62a4\u6240\uff0c\u4ee5\u62b5\u5fa1\u591c\u95f4\u7684\u602a\u7269\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u6728\u6750\u5236\u4f5c\u9550\uff0c\u8fd9\u5bf9\u4e8e\u91c7\u77ff\u81f3\u5173\u91cd\u8981\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u4f60\u7684\u7b2c\u4e00\u4e2a\u5e87\u62a4\u6240\u60f3\u8c61\u6210\u5192\u9669\u4e2d\u7684\u57fa\u5730\u8425\u3002]"}, {"question": "\u5bf9\u4e8e\u9ad8\u7ea7\u73a9\u5bb6\u6765\u8bf4\uff0cMineFun.io\u4e2d\u7684\u8d44\u6e90\u7ba1\u7406\u4e3a\u4ec0\u4e48\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u8d44\u6e90\u7ba1\u7406\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u4fdd\u8bc1\u4e86\u53ef\u6301\u7eed\u6027\u548c\u6548\u7387\u3002\u9ad8\u7ea7\u73a9\u5bb6\u5e94\uff1a\u6b65\u9aa41\uff1a\u4f18\u5148\u8003\u8651\u7a00\u6709\u8d44\u6e90\uff0c\u4f8b\u5982\u94bb\u77f3\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u81ea\u52a8\u519c\u573a\u6301\u7eed\u6536\u96c6\u98df\u7269\u3002\u6b65\u9aa43\uff1a\u5206\u914d\u8d44\u6e90\u7528\u4e8e\u5236\u4f5c\u9ad8\u7ea7\u5de5\u5177\u548c\u76d4\u7532\u3002\u4f8b\u5982\uff0c\u81ea\u52a8\u5316\u5c0f\u9ea6\u519c\u573a\u53ef\u4ee5\u63d0\u4f9b\u7a33\u5b9a\u7684\u98df\u7269\u4f9b\u5e94\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u624b\u52a8\u8015\u4f5c\u4e0e\u81ea\u52a8\u5316\u8015\u4f5c\u6548\u7387\u5bf9\u6bd4\u3002]"}, {"question": "MineFun.io\u4e2d\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u4e3b\u8981\u533a\u522b\u5305\u62ec\uff1a1\uff09\u4e92\u52a8\uff1a\u591a\u4eba\u6a21\u5f0f\u5141\u8bb8\u5408\u4f5c\u548c\u7ade\u4e89\u30022\uff09\u8d44\u6e90\u5171\u4eab\uff1a\u73a9\u5bb6\u53ef\u4ee5\u5728\u591a\u4eba\u6a21\u5f0f\u4e0b\u4ea4\u6613\u8d44\u6e90\u30023\uff09\u6e38\u620f\u8282\u594f\uff1a\u7531\u4e8e\u5171\u4eab\u76ee\u6807\uff0c\u591a\u4eba\u6a21\u5f0f\u901a\u5e38\u8282\u594f\u66f4\u5feb\u3002\u4f8b\u5982\uff0c\u5728\u591a\u4eba\u6a21\u5f0f\u4e0b\uff0c\u4f60\u4eec\u53ef\u4ee5\u7ec4\u961f\u66f4\u5feb\u5730\u51fb\u8d25\u672b\u5f71\u9f99\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u5355\u4eba\u6a21\u5f0f\u4e0e\u591a\u4eba\u6a21\u5f0f\u8d44\u6e90\u6536\u96c6\u901f\u5ea6\u5bf9\u6bd4\u3002]"}, {"question": "MineFun.io\u4e2d\u7684\u5236\u4f5c\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u4e00\u4e9b\u5fc5\u8981\u7684\u914d\u65b9\u662f\u4ec0\u4e48\uff1f", "answer": "\u5236\u4f5c\u7cfb\u7edf\u6d89\u53ca\u4f7f\u7528\u7f51\u683c\u7ec4\u5408\u8d44\u6e90\u3002\u5fc5\u8981\u7684\u914d\u65b9\u5305\u62ec\uff1a1\uff09\u6728\u5236\u9550\uff1a3\u5757\u6728\u677f+ 2\u6839\u6728\u68cd\u30022\uff09\u7194\u7089\uff1a8\u5757\u77f3\u7816\u30023\uff09\u706b\u628a\uff1a1\u6839\u6728\u68cd+ 1\u5757\u7164\u3002\u4f8b\u5982\uff0c\u5236\u4f5c\u7194\u7089\u53ef\u4ee5\u5c06\u77ff\u77f3\u51b6\u70bc\u6210\u952d\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u4ece\u539f\u6750\u6599\u5230\u6700\u7ec8\u4ea7\u54c1\u7684\u5236\u4f5c\u6d41\u7a0b\u3002]"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u53ef\u4ee5\u5e2e\u52a9\u73a9\u5bb6\u5728MineFun.io\u4e2d\u51fb\u8d25\u672b\u5f71\u9f99\uff1f", "answer": "\u4e3a\u4e86\u51fb\u8d25\u672b\u5f71\u9f99\uff1a\u6b65\u9aa41\uff1a\u51c6\u5907\u94bb\u77f3\u76d4\u7532\u548c\u9644\u9b54\u5f13\u7bad\u3002\u6b65\u9aa42\uff1a\u6467\u6bc1\u672b\u5f71\u6c34\u6676\u4ee5\u9632\u6b62\u6cbb\u7597\u3002\u6b65\u9aa43\uff1a\u5728\u9f99\u6816\u606f\u65f6\u653b\u51fb\u5b83\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u9644\u9b54\u4e86\u529b\u91cf\u6548\u679c\u7684\u5f13\u7bad\u53ef\u4ee5\u589e\u52a0\u4f24\u5bb3\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u8fd1\u6218\u653b\u51fb\u4e0e\u8fdc\u7a0b\u653b\u51fb\u7684\u6709\u6548\u6027\u6bd4\u8f83\u3002]"}, {"question": "MineFun.io\u4e2d\u7684\u9690\u85cf\u5f69\u86cb\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u73a9\u5bb6\u5982\u4f55\u627e\u5230\u5b83\u4eec\uff1f", "answer": "\u9690\u85cf\u5f69\u86cb\u5305\u62ec\uff1a1\uff09\u201c\u8d6b\u7f57\u5e03\u6797\u201d\u4f20\u8bf4\uff0c\u5b83\u6d89\u53ca\u5bfb\u627e\u7279\u5b9a\u7ed3\u6784\u30022\uff09\u7a00\u6709\u7684\u751f\u7269\u7fa4\u843d\u7279\u5b9a\u6218\u5229\u54c1\u30023\uff09\u6e38\u620f\u4ee3\u7801\u4e2d\u7684\u79d8\u5bc6\u4fe1\u606f\u3002\u4f8b\u5982\uff0c\u63a2\u7d22\u5e9f\u5f03\u7684\u77ff\u4e95\u53ef\u4ee5\u53d1\u73b0\u7a00\u6709\u7269\u54c1\u3002[\u5f69\u86cb\u6316\u6398\uff1a\u627e\u5230\u5f69\u86cb\u7684\u4f4d\u7f6e\u548c\u63d0\u793a\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e0a\u4f18\u5316\u4ed6\u4eec\u7684MineFun.io\u4f53\u9a8c\uff1f", "answer": "\u4e3a\u4e86\u8de8\u5e73\u53f0\u4f18\u5316\uff1a1\uff09\u786e\u4fdd\u4f60\u7684\u5e10\u6237\u5df2\u94fe\u63a5\u4ee5\u8fdb\u884c\u8de8\u5e73\u53f0\u6e38\u620f\u30022\uff09\u8c03\u6574\u6bcf\u4e2a\u8bbe\u5907\u4e0a\u7684\u8bbe\u7f6e\u4ee5\u83b7\u5f97\u6700\u4f73\u6027\u80fd\u30023\uff09\u4f7f\u7528\u4e91\u4fdd\u5b58\u4ee5\u65e0\u7f1d\u5730\u7ee7\u7eed\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u5728PC\u4e0a\u73a9\u6e38\u620f\u53ef\u4ee5\u83b7\u5f97\u66f4\u9ad8\u7684\u56fe\u5f62\u8bbe\u7f6e\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1aPC\u3001\u4e3b\u673a\u548c\u79fb\u52a8\u8bbe\u5907\u4e0a\u7684\u6027\u80fd\u8bbe\u7f6e\u5bf9\u6bd4\u3002]"}, {"question": "MineFun.io\u4e2d\u7684\u602a\u7269\u751f\u6210\u7cfb\u7edf\u80cc\u540e\u7684\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "\u602a\u7269\u751f\u6210\u673a\u5236\u5305\u62ec\uff1a1\uff09\u5149\u7167\u7b49\u7ea7\uff1a\u602a\u7269\u4f1a\u5728\u9ed1\u6697\u533a\u57df\u751f\u6210\u30022\uff09\u751f\u7269\u7fa4\u843d\u7279\u5b9a\u602a\u7269\uff1a\u67d0\u4e9b\u602a\u7269\u4f1a\u51fa\u73b0\u5728\u7279\u5b9a\u751f\u7269\u7fa4\u843d\u4e2d\u30023\uff09\u751f\u6210\u9650\u5236\uff1a\u533a\u57df\u53ea\u80fd\u652f\u6301\u4e00\u5b9a\u6570\u91cf\u7684\u602a\u7269\u3002\u4f8b\u5982\uff0c\u82e6\u529b\u6015\u4f1a\u5728\u9ed1\u6697\u7684\u68ee\u6797\u533a\u57df\u751f\u6210\u3002[\u7cfb\u7edf\u89e3\u6790\uff1a\u5149\u7167\u7b49\u7ea7\u548c\u751f\u7269\u7fa4\u843d\u7684\u602a\u7269\u751f\u6210\u4e92\u52a8\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728MineFun.io\u4e2d\u9ad8\u6548\u5730\u6316\u6398\u94bb\u77f3\uff1f", "answer": "\u4e3a\u4e86\u9ad8\u6548\u5730\u6316\u6398\u94bb\u77f3\uff1a\u6b65\u9aa41\uff1a\u5411\u4e0b\u6316\u6398\u5230Y\u7ea7 11-15\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u5206\u652f\u6316\u6398\u6cd5\u8986\u76d6\u66f4\u591a\u533a\u57df\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u9644\u9b54\u4e86\u5e78\u8fd0\u6548\u679c\u7684\u9550\u6765\u589e\u52a0\u4ea7\u91cf\u3002\u4f8b\u5982\uff0c\u5206\u652f\u6316\u6398\u6cd5\u5305\u62ec\u6bcf 2 \u4e2a\u65b9\u5757\u521b\u5efa\u4e00\u4e2a\u96a7\u9053\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u5206\u652f\u6316\u6398\u6cd5\u60f3\u8c61\u6210\u5728\u5730\u4e0b\u521b\u5efa\u7f51\u7edc\u72b6\u7684\u77ff\u8109\u3002]"}, {"question": "\u52a0\u5165MineFun.io\u793e\u533a\u6216\u670d\u52a1\u5668\u6709\u4ec0\u4e48\u597d\u5904\uff1f", "answer": "\u597d\u5904\u5305\u62ec\uff1a1\uff09\u5408\u4f5c\u9879\u76ee\uff1a\u4e00\u8d77\u5efa\u9020\u5927\u578b\u7ed3\u6784\u30022\uff09\u5171\u4eab\u77e5\u8bc6\uff1a\u5411\u5176\u4ed6\u4eba\u5b66\u4e60\u9ad8\u7ea7\u7b56\u7565\u30023\uff09\u793e\u4ea4\u4e92\u52a8\uff1a\u7ed3\u4ea4\u670b\u53cb\u5e76\u53c2\u4e0e\u6d3b\u52a8\u3002\u4f8b\u5982\uff0c\u52a0\u5165\u670d\u52a1\u5668\u53ef\u4ee5\u5e2e\u52a9\u4f60\u66f4\u5feb\u5730\u5b8c\u6210\u6e38\u620f\u6210\u5c31\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u5355\u4eba\u6e38\u620f\u4e0e\u793e\u533a\u6e38\u620f\u7684\u597d\u5904\u3002]"}]
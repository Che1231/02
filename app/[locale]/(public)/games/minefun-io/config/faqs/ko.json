[{"question": "\ucd08\ubcf4\uc790\uac00 MineFun.io\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \ud50c\ub808\uc774\ud558\uae30 \uc704\ud574\uc11c\ub294 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud558\ub098\uc694?", "answer": "MineFun.io\uc5d0\uc11c \ud6a8\uacfc\uc801\uc73c\ub85c \uc2dc\uc791\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: \ub2e8\uacc4 1: \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc774\ud574\ud558\uae30 \uc704\ud574 \ud29c\ud1a0\ub9ac\uc5bc\uc744 \uc644\ub8cc\ud558\uc138\uc694. \ub2e8\uacc4 2: \ub098\ubb34\uc640 \ub3cc\uacfc \uac19\uc740 \uae30\ubcf8 \uc790\uc6d0\uc744 \ubaa8\uc73c\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \ub2e8\uacc4 3: \uc57c\uac04 \ubaac\uc2a4\ud130\ub85c\ubd80\ud130 \ubcf4\ud638\ud560 \uc218 \uc788\ub294 \uac04\ub2e8\ud55c \ubcf4\ud638 \uc2dc\uc124\uc744 \uac74\uc124\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub098\ubb34\ub97c \uc0ac\uc6a9\ud558\uc5ec \ucc44\uad11\uc5d0 \ud544\uc218\uc801\uc778 \uace1\uad2d\uc774\ub97c \ub9cc\ub4dc\uc138\uc694. [\ube44\uc720 \uc124\uba85: \uccab \ubc88\uc9f8 \ubcf4\ud638 \uc2dc\uc124\uc744 \ubaa8\ud5d8\uc758 \uae30\uc9c0\ub85c \uc0dd\uac01\ud558\uc138\uc694.]"}, {"question": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\uac00 MineFun.io\uc5d0\uc11c \uc790\uc6d0 \uad00\ub9ac\ub97c \uc911\uc694\ud558\uac8c \uc0dd\uac01\ud574\uc57c \ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc790\uc6d0 \uad00\ub9ac\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \uc9c0\uc18d \uac00\ub2a5\uc131\uacfc \ud6a8\uc728\uc131\uc744 \ubcf4\uc7a5\ud558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \ub2e4\uc74c\uc744 \ud574\uc57c \ud569\ub2c8\ub2e4: \ub2e8\uacc4 1: \ub2e4\uc774\uc544\ubaac\ub4dc\uc640 \uac19\uc740 \ud76c\uadc0 \uc790\uc6d0\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \ud655\ubcf4\ud558\uc138\uc694. \ub2e8\uacc4 2: \uc790\ub3d9 \ub18d\uc7a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc9c0\uc18d\uc801\uc73c\ub85c \uc74c\uc2dd\uc744 \uc218\uc9d1\ud558\uc138\uc694. \ub2e8\uacc4 3: \uace0\uae09 \ub3c4\uad6c\uc640 \ubc29\uc5b4\uad6c\ub97c \ub9cc\ub4dc\ub294 \ub370 \uc790\uc6d0\uc744 \ud560\ub2f9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ubc00 \ub18d\uc7a5\uc744 \uc790\ub3d9\ud654\ud558\uba74 \uc548\uc815\uc801\uc778 \uc2dd\ub7c9 \uacf5\uae09\uc744 \ud655\ubcf4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\ubc95 \ube44\uad50: \uc218\ub3d9 \ub18d\uc5c5 \ub300 \uc790\ub3d9 \ub18d\uc5c5\uc758 \ud6a8\uc728\uc131 \ube44\uad50.]"}, {"question": "MineFun.io\uc758 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: 1) \uc0c1\ud638 \uc791\uc6a9: \uba40\ud2f0\ud50c\ub808\uc774\uc5b4\ub294 \ud611\ub825\uacfc \uacbd\uc7c1\uc744 \uac00\ub2a5\ud558\uac8c \ud569\ub2c8\ub2e4. 2) \uc790\uc6d0 \uacf5\uc720: \ud50c\ub808\uc774\uc5b4\ub294 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4\uc5d0\uc11c \uc790\uc6d0\uc744 \uac70\ub798\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 3) \uac8c\uc784 \uc18d\ub3c4: \uacf5\uc720 \ubaa9\ud45c\ub85c \uc778\ud574 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4\ub294 \uc885\uc885 \ub354 \ube60\ub978 \uc18d\ub3c4\ub97c \uac16\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uba40\ud2f0\ud50c\ub808\uc774\uc5b4\uc5d0\uc11c \ud568\uaed8 \ud611\ub825\ud558\uc5ec \uc5d4\ub354 \ub4dc\ub798\uace4\uc744 \ub354 \ube60\ub974\uac8c \ubb3c\ub9ac\uce60 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ub300 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \uc790\uc6d0 \uc218\uc9d1 \ube44\uc728.]"}, {"question": "MineFun.io\uc758 \uc81c\uc791 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \ud544\uc218\uc801\uc778 \ub808\uc2dc\ud53c\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc81c\uc791 \uc2dc\uc2a4\ud15c\uc740 \uc790\uc6d0\uc744 \uacb0\ud569\ud558\uae30 \uc704\ud574 \uadf8\ub9ac\ub4dc\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ud544\uc218 \ub808\uc2dc\ud53c\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: 1) \ub098\ubb34 \uace1\uad2d\uc774: 3\uac1c\uc758 \ub098\ubb34 \ud310\uc790 + 2\uac1c\uc758 \ub098\ubb34\ub9c9\ub300. 2) \uc6a9\uad11\ub85c: 8\uac1c\uc758 \uc790\uac08. 3) \ub4f1\ubd88: 1\uac1c\uc758 \ub098\ubb34\ub9c9\ub300 + 1\uac1c\uc758 \uc22f. \uc608\ub97c \ub4e4\uc5b4, \uc6a9\uad11\ub85c\ub97c \uc81c\uc791\ud558\uba74 \uad11\uc11d\uc744 \uc778\uad34\ub85c \uc81c\ub828\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc6d0\ub8cc\uc5d0\uc11c \ucd5c\uc885 \uc81c\ud488\uae4c\uc9c0\uc758 \uc81c\uc791 \uacf5\uc815.]"}, {"question": "MineFun.io\uc5d0\uc11c \uc5d4\ub354 \ub4dc\ub798\uace4\uc744 \ubb3c\ub9ac\uce58\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ub294 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc5d4\ub354 \ub4dc\ub798\uace4\uc744 \ubb3c\ub9ac\uce58\ub824\uba74 \ub2e4\uc74c\uc744 \ud574\uc57c \ud569\ub2c8\ub2e4: \ub2e8\uacc4 1: \ub2e4\uc774\uc544\ubaac\ub4dc \uc7a5\ube44\uc640 \ub9c8\ubc95 \ubd80\uc5ec\ub41c \ud65c\ub85c \uc900\ube44\ud558\uc138\uc694. \ub2e8\uacc4 2: \uce58\uc720\ub97c \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \uc5d4\ub4dc \uacb0\uc815\uccb4\ub97c \ud30c\uad34\ud558\uc138\uc694. \ub2e8\uacc4 3: \ub4dc\ub798\uace4\uc774 \uc549\uc544 \uc788\uc744 \ub54c \uacf5\uaca9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uac15\ub825 \ub9c8\ubc95 \ubd80\uc5ec\ub41c \ud65c\uc744 \uc0ac\uc6a9\ud558\uba74 \ud53c\ud574\ub7c9\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\ubc95 \ube44\uad50: \uadfc\uc811 \uacf5\uaca9 \ub300 \uc6d0\uac70\ub9ac \uacf5\uaca9\uc758 \ud6a8\uacfc \ube44\uad50.]"}, {"question": "MineFun.io\uc758 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc774\uba70, \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\ub098\uc694?", "answer": "\uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: 1) \ud2b9\uc815 \uad6c\uc870\ubb3c\uc744 \ucc3e\ub294 \uac83\uc774 \uad00\ub828\ub41c \"\ud788\uc5b4\ube0c\ub77c\uc778\" \uc2e0\ud654. 2) \ud76c\uadc0\ud55c \uc0dd\ubb3c \uad70\uacc4 \ud2b9\uc815 \uc544\uc774\ud15c. 3) \uac8c\uc784 \ucf54\ub4dc\uc5d0 \uc228\uaca8\uc9c4 \ube44\ubc00 \uba54\uc2dc\uc9c0. \uc608\ub97c \ub4e4\uc5b4, \ubc84\ub824\uc9c4 \uad11\uc0b0\uc744 \ud0d0\ud5d8\ud558\uba74 \ud76c\uadc0\ud55c \uc544\uc774\ud15c\uc744 \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc774\uc2a4\ud130 \uc5d0\uadf8 \ud0d0\ud5d8: \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ucc3e\ub294 \uc704\uce58\uc640 \ud78c\ud2b8.]"}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 \ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c MineFun.io \uacbd\ud5d8\uc744 \ucd5c\uc801\ud654\ud560 \uc218 \uc788\ub3c4\ub85d \uc5b4\ub5bb\uac8c \ud574\uc57c \ud558\ub098\uc694?", "answer": "\ud50c\ub7ab\ud3fc \uac04 \ucd5c\uc801\ud654\ub97c \uc704\ud574 \ub2e4\uc74c\uc744 \uc218\ud589\ud558\uc138\uc694: 1) \uacc4\uc815\uc744 \uc5f0\uacb0\ud558\uc5ec \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774\ub97c \ubcf4\uc7a5\ud558\uc138\uc694. 2) \uac01 \uae30\uae30\uc5d0\uc11c \ucd5c\uc801\uc758 \uc131\ub2a5\uc744 \uc704\ud574 \uc124\uc815\uc744 \uc870\uc815\ud558\uc138\uc694. 3) \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \uc6d0\ud65c\ud558\uac8c \uc774\uc5b4\ub098\uac00\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ud50c\ub808\uc774\ud558\uba74 \uadf8\ub798\ud53d \uc124\uc815\uc744 \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: PC, \ucf58\uc194 \ubc0f \ubaa8\ubc14\uc77c \ud50c\ub7ab\ud3fc\uc5d0\uc11c\uc758 \uc131\ub2a5 \uc124\uc815 \ube44\uad50.]"}, {"question": "MineFun.io\uc758 \ubaac\uc2a4\ud130 \uc0dd\uc131 \uc2dc\uc2a4\ud15c\uc758 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ubaac\uc2a4\ud130 \uc0dd\uc131 \uba54\ucee4\ub2c8\uc998\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: 1) \ubc1d\uae30 \uc218\uc900: \ubaac\uc2a4\ud130\ub294 \uc5b4\ub450\uc6b4 \uc9c0\uc5ed\uc5d0\uc11c \uc0dd\uc131\ub429\ub2c8\ub2e4. 2) \uc0dd\ubb3c \uad70\uacc4\ubcc4 \ubaac\uc2a4\ud130: \ud2b9\uc815 \ubaac\uc2a4\ud130\ub294 \ud2b9\uc815 \uc0dd\ubb3c \uad70\uacc4\uc5d0 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. 3) \uc0dd\uc131 \uc81c\ud55c: \uc9c0\uc5ed\uc740 \ud2b9\uc815 \uc218\uc758 \ubaac\uc2a4\ud130\ub9cc \uc9c0\uc6d0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud06c\ub9ac\ud37c\ub294 \uc5b4\ub461\uace0 \uc232\uc774 \uc6b0\uac70\uc9c4 \uc9c0\uc5ed\uc5d0\uc11c \uc0dd\uc131\ub429\ub2c8\ub2e4. [\uc2dc\uc2a4\ud15c \ubd84\uc11d: \ubaac\uc2a4\ud130 \uc0dd\uc131\uc5d0\uc11c \ubc1d\uae30 \uc218\uc900\uacfc \uc0dd\ubb3c \uad70\uacc4\uc758 \uc0c1\ud638 \uc791\uc6a9.]"}, {"question": "MineFun.io\uc5d0\uc11c \ub2e4\uc774\uc544\ubaac\ub4dc\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \ucc44\uad74\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub2e4\uc774\uc544\ubaac\ub4dc\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \ucc44\uad74\ud558\ub824\uba74 \ub2e4\uc74c\uc744 \uc218\ud589\ud558\uc138\uc694: \ub2e8\uacc4 1: Y \uc88c\ud45c 11-15\uae4c\uc9c0 \ud30c\uc138\uc694. \ub2e8\uacc4 2: \uac00\uc9c0 \ucc44\uad74\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub354 \ub9ce\uc740 \uc9c0\uc5ed\uc744 \ucee4\ubc84\ud558\uc138\uc694. \ub2e8\uacc4 3: \ud589\uc6b4 \ubd80\uc801\uc774 \ubd80\uc5ec\ub41c \uace1\uad2d\uc774\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc218\ud655\ub7c9\uc744 \ub192\uc774\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uac00\uc9c0 \ucc44\uad74\uc740 2\ube14\ub85d \uac04\uaca9\uc73c\ub85c \ud130\ub110\uc744 \ub9cc\ub4dc\ub294 \uac83\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uac00\uc9c0 \ucc44\uad74\uc744 \uc9c0\ud558\uc5d0 \ubed7\uc740 \uc815\ub9e5\ub9dd\uc73c\ub85c \uc0dd\uac01\ud558\uc138\uc694.]"}, {"question": "MineFun.io \ucee4\ubba4\ub2c8\ud2f0\ub098 \uc11c\ubc84\uc5d0 \ucc38\uc5ec\ud558\ub294 \uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc774\uc810\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: 1) \ud611\uc5c5 \ud504\ub85c\uc81d\ud2b8: \ud568\uaed8 \ud070 \uad6c\uc870\ubb3c\uc744 \uac74\uc124\ud558\uc138\uc694. 2) \uacf5\uc720 \uc9c0\uc2dd: \ub2e4\ub978 \uc0ac\ub78c\ub4e4\ub85c\ubd80\ud130 \uace0\uae09 \uc804\ub7b5\uc744 \ubc30\uc6b0\uc138\uc694. 3) \uc0ac\ud68c\uc801 \uc0c1\ud638 \uc791\uc6a9: \uce5c\uad6c\ub97c \uc0ac\uadc0\uace0 \uc774\ubca4\ud2b8\uc5d0 \ucc38\uc5ec\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc11c\ubc84\uc5d0 \uac00\uc785\ud558\uba74 \uac8c\uc784\uc758 \uc5c5\uc801\uc744 \ub354 \ube68\ub9ac \uc644\ub8cc\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\ubc95 \ube44\uad50: \uc194\ub85c \ud50c\ub808\uc774 \ub300 \ucee4\ubba4\ub2c8\ud2f0 \ud50c\ub808\uc774\uc758 \uc774\uc810.]"}]
[{"question": "FNF Week 6 \u5982\u4f55\u958b\u59cb\uff1f\u4f5c\u70ba\u65b0\u624b\uff0c\u6211\u61c9\u8a72\u5148\u4e86\u89e3\u54ea\u4e9b\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u4f5c\u70ba FNF Week 6 \u7684\u65b0\u624b\u73a9\u5bb6\uff0c\u9996\u5148\u4f60\u9700\u8981\u4e86\u89e3\u904a\u6232\u7684\u57fa\u672c\u64cd\u4f5c\u3002\u9032\u5165\u904a\u6232\u5f8c\uff0c\u9078\u64c7\u6545\u4e8b\u6a21\u5f0f\uff0c\u627e\u5230 Week 6 \u4e26\u9ede\u64ca\u958b\u59cb\u3002\u904a\u6232\u7684\u6838\u5fc3\u73a9\u6cd5\u662f\u6839\u64da\u87a2\u5e55\u4e0a\u65b9\u51fa\u73fe\u7684\u7bad\u982d\uff0c\u6309\u4e0b\u5c0d\u61c9\u7684\u65b9\u5411\u9375\u3002\u65b0\u624b\u73a9\u5bb6\u61c9\u5148\u719f\u6089\u56db\u500b\u65b9\u5411\u9375\uff08\u2191\u2193\u2190\u2192\uff09\u7684\u6e96\u78ba\u6309\u9375\u6642\u6a5f\uff0c\u5c24\u5176\u8981\u6ce8\u610f\u7bc0\u594f\u611f\u3002\u904a\u6232\u5167\u7bc4\u4f8b\uff1a\u5728 Senpai \u7684\u7b2c\u4e00\u9996\u6b4c\u4e2d\uff0c\u5617\u8a66\u8ddf\u8457\u7bc0\u594f\u6e96\u78ba\u6309\u4e0b\u65b9\u5411\u9375\uff0c\u521d\u671f\u53ef\u4ee5\u653e\u6162\u901f\u5ea6\u7df4\u7fd2\uff0c\u9010\u6b65\u638c\u63e1\u7bc0\u594f\u611f\u3002\n[\u6bd4\u55bb\u8aaa\u660e]\uff1a\u4f60\u53ef\u4ee5\u628a\u65b9\u5411\u9375\u60f3\u50cf\u6210\u92fc\u7434\u7684\u7434\u9375\uff0c\u800c\u7bad\u982d\u5c31\u662f\u6a02\u8b5c\uff0c\u4f60\u9700\u8981\u6839\u64da\u6a02\u8b5c\u6e96\u78ba\u5730\u5f48\u594f\u51fa\u4f86\u3002\n[\u914d\u7f6e\u5c0d\u7167\u8868]\uff1a\u5efa\u8b70\u65b0\u624b\u73a9\u5bb6\u5c07\u6309\u9375\u8a2d\u5b9a\u70ba\u81ea\u5df1\u6700\u8212\u9069\u7684\u4f4d\u7f6e\uff0c\u4f8b\u5982 WASD \u6216\u65b9\u5411\u9375\uff0c\u4ee5\u4fbf\u5feb\u901f\u53cd\u61c9\u3002"}, {"question": "\u70ba\u4ec0\u9ebc FNF Week 6 \u7684\u50cf\u7d20\u98a8\u683c\u5982\u6b64\u7368\u7279\uff1f\u9019\u7a2e\u98a8\u683c\u5c0d\u904a\u6232\u9ad4\u9a57\u6709\u4ec0\u9ebc\u5f71\u97ff\uff1f", "answer": "FNF Week 6 \u63a1\u7528\u4e86\u5fa9\u53e4\u7684\u50cf\u7d20\u98a8\u683c\uff0c\u9019\u4e3b\u8981\u662f\u70ba\u4e86\u81f4\u656c\u7d93\u5178\u7684\u8857\u6a5f\u904a\u6232\u548c\u65e9\u671f\u7db2\u969b\u7db2\u8def\u6587\u5316\u3002\u9019\u7a2e\u98a8\u683c\u4e0d\u50c5\u5e36\u4f86\u4e86\u8996\u89ba\u4e0a\u7684\u61f7\u820a\u611f\uff0c\u4e5f\u964d\u4f4e\u4e86\u904a\u6232\u7684\u786c\u9ad4\u8981\u6c42\uff0c\u4f7f\u5f97\u66f4\u591a\u73a9\u5bb6\u80fd\u5920\u9806\u66a2\u9ad4\u9a57\u3002\u50cf\u7d20\u98a8\u683c\u9084\u589e\u5f37\u4e86\u904a\u6232\u7684\u85dd\u8853\u8868\u73fe\u529b\uff0c\u6bcf\u500b\u50cf\u7d20\u90fd\u7d93\u904e\u7cbe\u5fc3\u8a2d\u8a08\uff0c\u71df\u9020\u51fa\u7368\u7279\u7684\u6c1b\u570d\u3002\n[\u904a\u6232\u5167\u7bc4\u4f8b]\uff1a\u89c0\u5bdf Week 6 \u7684\u80cc\u666f\u548c\u4eba\u7269\uff0c\u4f60\u53ef\u4ee5\u767c\u73fe\u50cf\u7d20\u98a8\u683c\u7684\u9b45\u529b\u6240\u5728\uff0c\u6bcf\u500b\u89d2\u8272\u7684\u8868\u60c5\u548c\u52d5\u4f5c\u90fd\u900f\u904e\u50cf\u7d20\u5316\u7684\u65b9\u5f0f\u7d30\u81a9\u5730\u8868\u9054\u51fa\u4f86\u3002\n[\u591a\u65b9\u6848\u6bd4\u8f03]\uff1a\u5982\u679c\u63a1\u7528\u9ad8\u6e05\u756b\u8cea\uff0c\u53ef\u80fd\u6703\u5931\u53bb Week 6 \u7684\u7368\u7279\u97fb\u5473\uff0c\u4e5f\u6703\u63d0\u9ad8\u904a\u6232\u7684\u904b\u884c\u9580\u6abb\u3002"}, {"question": "\u5728 FNF Week 6 \u4e2d\uff0c\u5982\u4f55\u63d0\u9ad8\u6309\u9375\u7684\u6e96\u78ba\u7387\uff1f\u6709\u4ec0\u9ebc\u6280\u5de7\u53ef\u4ee5\u5e6b\u52a9\u6211\u9806\u5229\u901a\u95dc\uff1f", "answer": "\u63d0\u9ad8 FNF Week 6 \u6309\u9375\u6e96\u78ba\u7387\u7684\u95dc\u9375\u5728\u65bc\u7bc0\u594f\u611f\u548c\u53cd\u61c9\u901f\u5ea6\u3002\u4ee5\u4e0b\u4e09\u500b\u6b65\u9a5f\uff1a\n\u6b65\u9a5f\u4e00\uff1a\u7df4\u7fd2\u7bc0\u594f\u611f\u3002\u8ddf\u8457\u97f3\u6a02\u7684\u7bc0\u62cd\uff0c\u5617\u8a66\u8f15\u62cd\u684c\u9762\u6216\u6572\u64ca\u9375\u76e4\uff0c\u611f\u53d7\u7bc0\u594f\u7684\u898f\u5f8b\u3002\n\u6b65\u9a5f\u4e8c\uff1a\u719f\u6089\u6b4c\u66f2\u7684\u6a21\u5f0f\u3002\u5728\u958b\u59cb\u904a\u6232\u524d\uff0c\u5148\u807d\u4e00\u904d\u6b4c\u66f2\uff0c\u4e86\u89e3\u6b4c\u66f2\u7684\u7bc0\u594f\u8b8a\u5316\u548c\u6309\u9375\u6a21\u5f0f\u3002\u904a\u6232\u5167\u7bc4\u4f8b\uff1a\u5728 Rose \u9019\u9996\u6b4c\u4e2d\uff0c\u7bc0\u594f\u8b8a\u5316\u8f03\u591a\uff0c\u9700\u8981\u63d0\u524d\u9810\u5224\u3002\n\u6b65\u9a5f\u4e09\uff1a\u8abf\u6574\u904a\u6232\u96e3\u5ea6\u3002\u5982\u679c\u89ba\u5f97\u56f0\u96e3\uff0c\u53ef\u4ee5\u5617\u8a66\u964d\u4f4e\u904a\u6232\u96e3\u5ea6\uff0c\u6216\u8005\u4f7f\u7528\u7df4\u7fd2\u6a21\u5f0f\uff0c\u53cd\u8986\u7df4\u7fd2\u96e3\u4ee5\u638c\u63e1\u7684\u90e8\u5206\u3002\n[\u6d41\u7a0b\u5716\u89e3]\uff1a\u904a\u6232\u5931\u6557\u2192\u5206\u6790\u539f\u56e0(\u7bc0\u594f\u554f\u984c/\u53cd\u61c9\u554f\u984c/\u64cd\u4f5c\u554f\u984c)\u2192\u91dd\u5c0d\u6027\u7df4\u7fd2\u2192\u518d\u6b21\u5617\u8a66\u2192\u6210\u529f\u3002\n[\u914d\u7f6e\u5c0d\u7167\u8868]\uff1a\u8abf\u6574\u904a\u6232\u7684\u97f3\u8a0a\u5ef6\u9072\u8a2d\u5b9a\u53ef\u80fd\u6709\u52a9\u65bc\u63d0\u9ad8\u6309\u9375\u7684\u540c\u6b65\u6027\u3002"}, {"question": "FNF Week 6 \u7684\u96e3\u5ea6\u7b49\u7d1a\u662f\u5982\u4f55\u8a2d\u5b9a\u7684\uff1f\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u6b4c\u66f2\u7684\u96e3\u5ea6\uff1f", "answer": "FNF Week 6 \u7684\u96e3\u5ea6\u4e3b\u8981\u7531\u6b4c\u66f2\u7684 BPM\uff08\u6bcf\u5206\u9418\u62cd\u6578\uff09\u3001\u6309\u9375\u901f\u5ea6\u3001\u6309\u9375\u6578\u91cf\u548c\u9023\u7e8c\u6027\u6c7a\u5b9a\u3002BPM \u8d8a\u9ad8\uff0c\u6309\u9375\u901f\u5ea6\u8d8a\u5feb\uff0c\u96e3\u5ea6\u8d8a\u9ad8\u3002\u6b64\u5916\uff0c\u4e00\u4e9b\u6b4c\u66f2\u9084\u6703\u52a0\u5165\u7279\u6b8a\u7684\u6309\u9375\u6a21\u5f0f\uff0c\u4f8b\u5982\u9577\u6309\u6216\u9023\u7e8c\u5feb\u901f\u6309\u9375\uff0c\u4e5f\u6703\u589e\u52a0\u96e3\u5ea6\u3002\n[\u904a\u6232\u5167\u7bc4\u4f8b]\uff1aThorns \u9019\u9996\u6b4c\u7684 BPM \u8f03\u9ad8\uff0c\u800c\u4e14\u9023\u7e8c\u6309\u9375\u8f03\u591a\uff0c\u56e0\u6b64\u96e3\u5ea6\u8f03\u9ad8\u3002\n[\u591a\u65b9\u6848\u6bd4\u8f03]\uff1a\u4e0d\u540c\u96e3\u5ea6\u7b49\u7d1a\u7684\u4e3b\u8981\u5340\u5225\u5728\u65bc\u6309\u9375\u901f\u5ea6\u548c\u6309\u9375\u6578\u91cf\uff0c\u96e3\u5ea6\u8d8a\u9ad8\uff0c\u6309\u9375\u901f\u5ea6\u8d8a\u5feb\uff0c\u6309\u9375\u6578\u91cf\u8d8a\u591a\u3002"}, {"question": "\u8003\u616e\u5230\u9375\u76e4\u8f38\u5165\u5ef6\u9072\uff0c\u5b8c\u6210 FNF Week 6 \u7684\u786c\u96e3\u5ea6\u6a21\u5f0f\u6709\u54ea\u4e9b\u6700\u4f73\u7b56\u7565\uff1f", "answer": "\u5728 FNF Week 6 \u7684\u786c\u96e3\u5ea6\u6a21\u5f0f\u4e0b\uff0c\u5b8c\u6210\u904a\u6232\u9700\u8981\u7cbe\u78ba\u7684\u6642\u6a5f\u63a7\u5236\u548c\u7b56\u7565\u3002\u9375\u76e4\u8f38\u5165\u5ef6\u9072\u6703\u986f\u8457\u5f71\u97ff\u904a\u6232\u8868\u73fe\u3002\u4ee5\u4e0b\u6b65\u9a5f\uff1a\n\u6b65\u9a5f\u4e00\uff1a\u6821\u6e96\u8f38\u5165\u5ef6\u9072\uff1a\u4f7f\u7528\u904a\u6232\u5167\u7684\u8a2d\u5b9a\u6821\u6e96\u8f38\u5165\u5ef6\u9072\u3002\u9019\u80fd\u4f7f\u8996\u89ba\u63d0\u793a\u8207\u5be6\u969b\u6309\u9375\u6309\u58d3\u5c0d\u9f4a\u3002\n\u6b65\u9a5f\u4e8c\uff1a\u7df4\u7fd2\u7bc0\u594f\uff1a\u786c\u96e3\u5ea6\u6a21\u5f0f\u7684\u7bc0\u594f\u66f4\u5feb\uff0c\u4e14\u6a21\u5f0f\u66f4\u8907\u96dc\u3002\u53cd\u8986\u7df4\u7fd2\u6bcf\u4e00\u9996\u6b4c\uff0c\u5167\u5316\u7bc0\u594f\uff0c\u4e26\u9810\u6e2c\u97f3\u7b26\u3002\n\u6b65\u9a5f\u4e09\uff1a\u512a\u5316\u9375\u76e4\u7d81\u5b9a\uff1a\u4f7f\u7528\u8212\u9069\u7684\u9375\u76e4\u7d81\u5b9a\uff0c\u6e1b\u5c11\u624b\u6307\u79fb\u52d5\uff0c\u63d0\u5347\u53cd\u61c9\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u300cZ\u300d\u9375\u7684\u53cd\u61c9\u5f88\u5feb\uff0c\u8acb\u5c07\u5b83\u8a2d\u5b9a\u5230\u91cd\u8981\u7684\u4f4d\u7f6e\u3002\n[\u8a2d\u5b9a\u8868\u683c]\uff1a\u8003\u616e\u6539\u8b8a\u97f3\u8a0a\u5ef6\u9072\u8a2d\u5b9a\uff0c\u4ee5\u7b26\u5408\u4f60\u7684\u74b0\u5883\uff0c\u8b93\u540c\u6b65\u66f4\u4f73\u3002\u4e5f\u5617\u8a66\u4f7f\u7528\u4e0d\u540c\u7684\u8072\u5361\uff0c\u770b\u770b\u662f\u5426\u80fd\u6e1b\u5c11\u8f38\u5165\u5ef6\u9072\u3002\n[\u6bd4\u8f03\u8868\u683c]\uff1a\u6bd4\u8f03\u4f60\u7684\u904a\u6232\u756b\u9762\u8207\u9ad8\u5206\u56de\u653e\uff0c\u5206\u6790\u6709\u6548\u7684\u624b\u6307\u79fb\u52d5\u3002"}, {"question": "FNF Week 6 \u662f\u5426\u6709\u96b1\u85cf\u5f69\u86cb\u6216\u79d8\u5bc6\uff1f\u5982\u4f55\u89f8\u767c\u5b83\u5011\uff1f", "answer": "FNF Week 6 \u4e2d\u96b1\u85cf\u4e86\u4e00\u4e9b\u5f69\u86cb\uff0c\u4f8b\u5982\u5728\u67d0\u4e9b\u6b4c\u66f2\u4e2d\uff0c\u80cc\u666f\u6703\u51fa\u73fe\u4e00\u4e9b\u7d30\u5fae\u7684\u8b8a\u5316\uff0c\u6216\u8005 Senpai \u7684\u8868\u60c5\u6703\u6539\u8b8a\u3002\u96d6\u7136\u6c92\u6709\u660e\u78ba\u7684\u89f8\u767c\u689d\u4ef6\uff0c\u4f46\u6709\u50b3\u805e\u8aaa\u5728\u7279\u5b9a\u7684\u6642\u9593\u9ede\u64ca\u7279\u5b9a\u7684\u4f4d\u7f6e\u53ef\u80fd\u6703\u89f8\u767c\u9019\u4e9b\u5f69\u86cb\u3002\u9019\u4e9b\u5f69\u86cb\u4e3b\u8981\u70ba\u4e86\u589e\u52a0\u904a\u6232\u7684\u8da3\u5473\u6027\u548c\u63a2\u7d22\u6027\u3002\n[\u904a\u6232\u5167\u7bc4\u4f8b]\uff1a\u5728 Senpai \u7684\u6700\u5f8c\u968e\u6bb5 Thorns\uff0c\u6ce8\u610f\u80cc\u666f\u4e2d\u53ef\u80fd\u4e00\u9583\u800c\u904e\u7684\u50cf\u7d20\u5716\u6848\u3002\n[\u6bd4\u55bb\u8aaa\u660e]\uff1a\u5c0b\u627e\u5f69\u86cb\u5c31\u50cf\u5c0b\u5bf6\uff0c\u9700\u8981\u7d30\u5fc3\u89c0\u5bdf\u548c\u4e0d\u65b7\u5617\u8a66\u3002"}, {"question": "FNF Week 6 \u7684\u89d2\u8272\u8a2d\u5b9a\u548c\u6545\u4e8b\u80cc\u666f\u662f\u600e\u6a23\u7684\uff1f\u9019\u4e9b\u8a2d\u5b9a\u5c0d\u904a\u6232\u9ad4\u9a57\u6709\u4ec0\u9ebc\u5f71\u97ff\uff1f", "answer": "FNF Week 6 \u4ee5\u4e00\u4f4d\u88ab\u56f0\u5728\u96fb\u5b50\u904a\u6232\u4e2d\u7684\u865b\u64ec\u89d2\u8272 Senpai \u70ba\u4e3b\u89d2\uff0c\u8b1b\u8ff0\u4e86\u4ed6\u88ab\u56f0\u5728\u904a\u6232\u4e16\u754c\u4e2d\u7684\u6545\u4e8b\u3002Senpai \u6e34\u671b\u81ea\u7531\uff0c\u4f46\u53c8\u4e0d\u5f97\u4e0d\u9762\u5c0d\u4e3b\u89d2\u7684\u6311\u6230\u3002\u9019\u7a2e\u8a2d\u5b9a\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u4e00\u5c64\u60c5\u611f\u8272\u5f69\uff0c\u4f7f\u5f97\u73a9\u5bb6\u4e0d\u50c5\u662f\u5728\u73a9\u904a\u6232\uff0c\u4e5f\u5728\u9ad4\u9a57\u4e00\u500b\u6545\u4e8b\u3002\n[\u904a\u6232\u5167\u7bc4\u4f8b]\uff1aSenpai \u7684\u5c0d\u8a71\u548c\u8868\u60c5\u90fd\u6697\u793a\u4e86\u4ed6\u5167\u5fc3\u7684\u6399\u624e\u548c\u6e34\u671b\u3002\n[\u6bd4\u55bb\u8aaa\u660e]\uff1aSenpai \u5c31\u597d\u50cf\u4e00\u500b\u88ab\u56f0\u5728\u7c60\u5b50\u88e1\u7684\u9ce5\uff0c\u6e34\u671b\u81ea\u7531\uff0c\u537b\u53c8\u7121\u529b\u6399\u812b\u3002"}, {"question": "FNF Week 6 \u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u7279\u5225\u662f\u8003\u616e\u5230\u5b8c\u7f8e\u3001\u512a\u79c0\u548c\u5176\u4ed6\u64ca\u6253\u985e\u578b\uff1f", "answer": "\u5728 FNF Week 6 \u4e2d\uff0c\u8a08\u5206\u7cfb\u7d71\u734e\u52f5\u7cbe\u78ba\u5ea6\u548c\u6642\u6a5f\u3002\u4e0d\u540c\u7684\u64ca\u6253\u985e\u578b\u8ca2\u737b\u4e0d\u540c\u7684\u5206\u6578\u3002\n\u5b8c\u7f8e\u64ca\u6253\uff1a\u9019\u4e9b\u662f\u6700\u6e96\u78ba\u7684\u64ca\u6253\uff0c\u5728\u7bc0\u62cd\u4e0a\u5b8c\u7f8e\u5730\u57f7\u884c\uff0c\u4e26\u7372\u5f97\u6700\u9ad8\u5206\u6578\u3002\n\u512a\u79c0\u64ca\u6253\uff1a\u7565\u5fae\u504f\u96e2\u7bc0\u62cd\u7684\u64ca\u6253\uff0c\u4ecd\u7136\u80fd\u7372\u5f97\u5927\u91cf\u7684\u5206\u6578\u3002\n\u826f\u597d\u64ca\u6253\uff1a\u6e96\u78ba\u5ea6\u8f03\u4f4e\u7684\u64ca\u6253\uff0c\u7372\u5f97\u7684\u5206\u6578\u5c11\u65bc\u512a\u79c0\u64ca\u6253\u3002\n\u7cdf\u7cd5\u64ca\u6253\uff1a\u9019\u4e9b\u662f\u975e\u5e38\u4e0d\u6e96\u78ba\u7684\u64ca\u6253\u3002\n\u672a\u64ca\u4e2d\uff1a\u5b8c\u5168\u932f\u904e\u3002\n\u8a08\u5206\u7cfb\u7d71\u9f13\u52f5\u73a9\u5bb6\u52aa\u529b\u8ffd\u6c42\u5b8c\u7f8e\u7684\u6642\u6a5f\uff0c\u4ee5\u6700\u5927\u5316\u5206\u6578\u3002\u9023\u7e8c\u64ca\u4e2d\u800c\u6c92\u6709\u932f\u904e\u7684\u7d44\u5408\u500d\u6578\u9032\u4e00\u6b65\u653e\u5927\u5206\u6578\u3002\n[\u7bc4\u4f8b]\uff1a\u8a66\u8457\u5728\u6c92\u6709\u4efb\u4f55\u5931\u8aa4\u7684\u60c5\u6cc1\u4e0b\u4fdd\u6301\u9023\u64ca\uff0c\u5373\u4f7f\u5728\u4e2d\u7b49\u96e3\u5ea6\u4e0b\u4e5f\u80fd\u7372\u5f97\u9ad8\u5206\u3002\n[\u6bd4\u8f03]\uff1a\u4e0d\u540c\u96e3\u5ea6\u7b49\u7d1a\u7684\u734e\u52f5\u5206\u6578\u6709\u6240\u4e0d\u540c\u3002"}, {"question": "FNF Week 6 \u6709\u624b\u6a5f\u7248\u672c\u55ce\uff1f\u6216\u8005\u6709\u8a08\u5283\u63a8\u51fa\u624b\u6a5f\u7248\u672c\u55ce\uff1f\u5982\u679c\u4e0d\u662f\uff0c\u662f\u5426\u6709\u5176\u4ed6\u985e\u4f3c\u7684\u904a\u6232\u53ef\u4ee5\u5728\u624b\u6a5f\u4e0a\u73a9\uff1f", "answer": "\u76ee\u524d FNF Week 6 \u5b98\u65b9\u4e26\u6c92\u6709\u624b\u6a5f\u7248\u672c\u3002\u4f46\u7531\u65bc FNF \u662f\u4e00\u6b3e\u958b\u653e\u539f\u59cb\u78bc\u904a\u6232\uff0c\u56e0\u6b64\u6709\u4e00\u4e9b\u7b2c\u4e09\u65b9\u958b\u767c\u8005\u88fd\u4f5c\u4e86\u975e\u5b98\u65b9\u7684\u624b\u6a5f\u7248\u672c\uff0c\u53ef\u4ee5\u5728\u4e00\u4e9b\u61c9\u7528\u7a0b\u5f0f\u5546\u5e97\u6216\u7db2\u7ad9\u4e0a\u627e\u5230\u3002\u4f46\u8acb\u6ce8\u610f\uff0c\u9019\u4e9b\u975e\u5b98\u65b9\u7248\u672c\u53ef\u80fd\u5b58\u5728\u5b89\u5168\u98a8\u96aa\uff0c\u8acb\u8b39\u614e\u4e0b\u8f09\u3002\u6b64\u5916\uff0c\u624b\u6a5f\u4e0a\u4e5f\u6709\u8a31\u591a\u985e\u4f3c\u7684\u97f3\u6a02\u7bc0\u594f\u904a\u6232\uff0c\u4f8b\u5982\u300aCytus\u300b\u3001\u300aDeemo\u300b\u7b49\uff0c\u53ef\u4ee5\u5617\u8a66\u9ad4\u9a57\u3002\n[\u591a\u65b9\u6848\u6bd4\u8f03]\uff1a\u5b98\u65b9\u7248\u672c\u901a\u5e38\u66f4\u7a69\u5b9a\u548c\u5b89\u5168\uff0c\u4f46\u975e\u5b98\u65b9\u7248\u672c\u53ef\u80fd\u63d0\u4f9b\u66f4\u591a\u81ea\u8a02\u9078\u9805\u548c\u6a21\u7d44\u3002\n[\u8a2d\u5b9a\u5c0d\u7167\u8868]\uff1a\u5728\u4e0b\u8f09\u975e\u5b98\u65b9\u7248\u672c\u4e4b\u524d\uff0c\u8acb\u52d9\u5fc5\u67e5\u770b\u61c9\u7528\u7684\u6b0a\u9650\u8acb\u6c42\uff0c\u4e26\u78ba\u4fdd\u4f86\u6e90\u53ef\u9760\u3002"}, {"question": "\u9664\u4e86\u6a19\u6e96\u6a21\u5f0f\uff0cFNF Week 6 \u662f\u5426\u652f\u63f4\u81ea\u8a02\u6a21\u7d44\uff1f\u5982\u4f55\u5b89\u88dd\u548c\u4f7f\u7528\u9019\u4e9b\u6a21\u7d44\uff1f", "answer": "FNF Week 6 \u53ca\u5176\u884d\u751f\u7248\u672c\u901a\u5e38\u652f\u63f4\u81ea\u8a02\u6a21\u7d44\uff0c\u9019\u4f7f\u5f97\u73a9\u5bb6\u53ef\u4ee5\u9ad4\u9a57\u5404\u7a2e\u5404\u6a23\u7684\u6b4c\u66f2\u3001\u89d2\u8272\u548c\u904a\u6232\u6a5f\u5236\u3002\u5b89\u88dd\u6a21\u7d44\u901a\u5e38\u9700\u8981\u5c07\u6a21\u7d44\u6a94\u6848\u89e3\u58d3\u7e2e\u5230\u904a\u6232\u7684\u6307\u5b9a\u8cc7\u6599\u593e\u4e2d\uff0c\u4f8b\u5982\u300cmods\u300d\u8cc7\u6599\u593e\u3002\u7136\u5f8c\uff0c\u5728\u904a\u6232\u555f\u52d5\u6642\u9078\u64c7\u8981\u8f09\u5165\u7684\u6a21\u7d44\u3002\u8acb\u6ce8\u610f\uff0c\u5b89\u88dd\u6a21\u7d44\u53ef\u80fd\u6703\u5c0e\u81f4\u904a\u6232\u4e0d\u7a69\u5b9a\uff0c\u5efa\u8b70\u5099\u4efd\u904a\u6232\u6a94\u6848\u3002\n[\u904a\u6232\u5167\u7bc4\u4f8b]\uff1a\u5b89\u88dd\u4e86\u65b0\u7684\u6b4c\u66f2\u6a21\u7d44\u5f8c\uff0c\u904a\u6232\u7684\u6b4c\u66f2\u9078\u64c7\u4ecb\u9762\u6703\u65b0\u589e\u65b0\u7684\u6b4c\u66f2\u9078\u9805\u3002\n[\u6d41\u7a0b\u5716\u89e3]\uff1a\u4e0b\u8f09\u6a21\u7d44\u2192\u89e3\u58d3\u7e2e\u6a94\u6848\u2192\u8907\u88fd\u5230 mods \u8cc7\u6599\u593e\u2192\u555f\u52d5\u904a\u6232\u2192\u9078\u64c7\u6a21\u7d44\u3002"}]
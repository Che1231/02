[{"question": "\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u5728Skribbl.io\u6e38\u620f\u4e2d\u5f00\u59cb\u4ed6\u4eec\u7684\u7b2c\u4e00\u4e2a\u6e38\u620f\uff1f", "answer": "\u8981\u5728 Skribbl.io \u4e2d\u5f00\u59cb\u4f60\u7684\u7b2c\u4e00\u4e2a\u6e38\u620f\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u8bbf\u95ee\u5b98\u65b9 Skribbl.io \u7f51\u7ad9\u3002\u6b65\u9aa42 - \u70b9\u51fb\u201c\u6e38\u620f\u201d\u6309\u94ae\u8fdb\u5165\u516c\u5171\u5927\u5385\u6216\u521b\u5efa\u79c1\u4eba\u623f\u95f4\u3002\u6b65\u9aa43 - \u9009\u62e9\u4e00\u4e2a\u6635\u79f0\u5e76\u9009\u62e9\u4f60\u559c\u6b22\u7684\u8bed\u8a00\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u662f\u4e00\u4f4d\u897f\u73ed\u7259\u8bed\u4f7f\u7528\u8005\uff0c\u8bf7\u9009\u62e9\u201cEspa\u00f1ol\u201d\u4ee5\u83b7\u5f97\u897f\u73ed\u7259\u8bed\u5355\u8bcd\u3002\u6e38\u620f\u5f00\u59cb\u540e\uff0c\u7cfb\u7edf\u4f1a\u63d0\u793a\u4f60\u753b\u4e00\u4e2a\u5355\u8bcd\uff0c\u5176\u4ed6\u4eba\u731c\u6d4b\u5b83\uff0c\u6216\u8005\u731c\u6d4b\u5176\u4ed6\u4eba\u753b\u7684\u662f\u4ec0\u4e48\u3002"}, {"question": "Skribbl.io \u4e2d\u7ed8\u753b\u7684\u57fa\u672c\u63a7\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "Skribbl.io \u4e2d\u7ed8\u753b\u7684\u57fa\u672c\u63a7\u5236\u5f88\u7b80\u5355\uff1a\u4f7f\u7528\u9f20\u6807\u6216\u89e6\u6478\u677f\u5728\u753b\u5e03\u4e0a\u7ed8\u753b\u3002\u4f60\u53ef\u4ee5\u70b9\u51fb\u753b\u7b14\u56fe\u6807\u5e76\u9009\u62e9\u7c97\u7ec6\u6765\u66f4\u6539\u753b\u7b14\u5927\u5c0f\u3002\u8981\u66f4\u6539\u989c\u8272\uff0c\u8bf7\u70b9\u51fb\u8c03\u8272\u677f\u5e76\u9009\u62e9\u4f60\u60f3\u8981\u7684\u8272\u8c03\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u6b63\u5728\u753b\u4e00\u4e2a\u82f9\u679c\uff0c\u4f60\u53ef\u80fd\u4f1a\u4ece\u8c03\u8272\u677f\u4e2d\u9009\u62e9\u7ea2\u8272\u3002\u6b64\u5916\uff0c\u4f60\u8fd8\u53ef\u4ee5\u70b9\u51fb\u6a61\u76ae\u64e6\u56fe\u6807\u4f7f\u7528\u6a61\u76ae\u64e6\u5de5\u5177\u6765\u7ea0\u6b63\u9519\u8bef\u3002"}, {"question": "\u5728 Skribbl.io \u4e2d\u9009\u62e9\u5408\u9002\u7684\u8bcd\u8bed\u4e3a\u4ec0\u4e48\u91cd\u8981\uff1f", "answer": "\u5728 Skribbl.io \u4e2d\u9009\u62e9\u6b63\u786e\u7684\u8bcd\u8bed\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u76f4\u63a5\u5f71\u54cd\u5176\u4ed6\u4eba\u731c\u6d4b\u8be5\u8bcd\u8bed\u7684\u901f\u5ea6\u548c\u51c6\u786e\u6027\u3002\u4f8b\u5982\uff0c\u9009\u62e9\u201c\u732b\u201d\u6bd4\u9009\u62e9\u201c\u5947\u7f8e\u62c9\u201d\u66f4\u5bb9\u6613\u7ed8\u753b\u548c\u731c\u6d4b\u3002\u4e00\u4e2a\u597d\u7684\u8bcd\u8bed\u5728\u7b80\u5355\u6027\u548c\u53ef\u8bc6\u522b\u6027\u4e4b\u95f4\u53d6\u5f97\u5e73\u8861\uff0c\u786e\u4fdd\u6e38\u620f\u4f53\u9a8c\u66f4\u6d41\u7545\u3002\u8fd9\u5bf9\u4ecd\u5728\u719f\u6089\u6e38\u620f\u673a\u5236\u7684\u65b0\u73a9\u5bb6\u5c24\u5176\u91cd\u8981\u3002"}, {"question": "\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u5982\u4f55\u5728 Skribbl.io \u4e2d\u63d0\u9ad8\u731c\u8bcd\u901f\u5ea6\uff1f", "answer": "\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u5173\u6ce8\u5e38\u89c1\u7684\u56fe\u6848\u548c\u5f62\u72b6\u6765\u63d0\u9ad8\u4ed6\u4eec\u7684\u731c\u8bcd\u901f\u5ea6\u3002\u6b65\u9aa4 1 - \u6ce8\u610f\u521d\u59cb\u7b14\u89e6\uff1b\u5b83\u4eec\u901a\u5e38\u6697\u793a\u7269\u4f53\u7684\u8f6e\u5ed3\u3002\u6b65\u9aa4 2 - \u4f7f\u7528\u804a\u5929\u529f\u80fd\u63d0\u51fa\u6f84\u6e05\u95ee\u9898\u6216\u505a\u51fa\u5408\u7406\u7684\u731c\u6d4b\u3002\u6b65\u9aa4 3 - \u719f\u6089\u4f60\u6240\u9009\u8bed\u8a00\u4e2d\u5e38\u7528\u7684\u8bcd\u6c47\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u6ce8\u610f\u5230\u4e00\u540d\u73a9\u5bb6\u6b63\u5728\u753b\u4e00\u4e2a\u5e26\u6709\u830e\u7684\u5706\u5708\uff0c\u90a3\u4e48\u201c\u82f9\u679c\u201d\u53ef\u80fd\u662f\u4e00\u4e2a\u5408\u7406\u7684\u731c\u6d4b\u3002\u8fd9\u79cd\u7b56\u7565\u53ef\u4ee5\u663e\u8457\u51cf\u5c11\u731c\u8bcd\u65f6\u95f4\u3002"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u4f7f\u7528\u54ea\u4e9b\u7b56\u7565\u6700\u5927\u5316\u4ed6\u4eec\u5728 Skribbl.io \u4e2d\u7684\u5f97\u5206\uff1f", "answer": "\u4e3a\u4e86\u5728 Skribbl.io \u4e2d\u6700\u5927\u5316\u5f97\u5206\uff0c\u73a9\u5bb6\u5e94\u8be5\u91c7\u7528\u53cc\u91cd\u7b56\u7565\uff1a\u6e05\u6670\u5730\u7ed8\u753b\u548c\u5feb\u901f\u5730\u731c\u6d4b\u3002\u6b65\u9aa4 1 - \u5728\u7ed8\u753b\u65f6\uff0c\u4f7f\u7528\u7b80\u5355\u6613\u8bc6\u522b\u7684\u5f62\u72b6\u3002\u4f8b\u5982\uff0c\u4e00\u4e2a\u7b80\u5355\u7684\u5361\u901a\u4eba\u6bd4\u4e00\u5f20\u8be6\u7ec6\u7684\u8096\u50cf\u66f4\u5bb9\u6613\u8fa8\u8ba4\u3002\u6b65\u9aa4 2 - \u5728\u731c\u6d4b\u65f6\uff0c\u952e\u5165\u90e8\u5206\u5355\u8bcd\u4ee5\u67e5\u770b\u5b83\u4eec\u662f\u5426\u4e0e\u7ed8\u753b\u76f8\u7b26\u3002\u6b65\u9aa4 3 - \u4fdd\u6301\u5728\u804a\u5929\u4e2d\u6d3b\u8dc3\u6c9f\u901a\uff0c\u4e0e\u4ed6\u4eba\u534f\u4f5c\u3002\u901a\u8fc7\u5e73\u8861\u8fd9\u4e9b\u65b9\u6cd5\uff0c\u73a9\u5bb6\u53ef\u4ee5\u66f4\u9ad8\u6548\u5730\u7d2f\u79ef\u5206\u6570\u3002"}, {"question": "Skribbl.io \u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "Skribbl.io \u7684\u8bc4\u5206\u7cfb\u7edf\u5956\u52b1\u7ed8\u753b\u548c\u731c\u6d4b\u3002\u5f53\u73a9\u5bb6\u6b63\u786e\u731c\u6d4b\u4e00\u4e2a\u5355\u8bcd\u65f6\uff0c\u731c\u8bcd\u8005\u548c\u753b\u8bcd\u8005\u90fd\u4f1a\u83b7\u5f97\u5206\u6570\u3002\u731c\u6d4b\u901f\u5ea6\u8d8a\u5feb\uff0c\u5206\u6570\u8d8a\u9ad8\u3002\u4f8b\u5982\uff0c\u5728 5 \u79d2\u5185\u731c\u6d4b\u201c\u72d7\u201d\u53ef\u80fd\u4f1a\u83b7\u5f97 100 \u5206\uff0c\u800c\u5728 10 \u79d2\u540e\u731c\u6d4b\u5b83\u53ef\u80fd\u53ea\u83b7\u5f97 50 \u5206\u3002\u753b\u8bcd\u8005\u8fd8\u4f1a\u6839\u636e\u6b63\u786e\u731c\u6d4b\u7684\u6570\u91cf\u83b7\u5f97\u5206\u6570\u3002\u8be5\u7cfb\u7edf\u9f13\u52b1\u521b\u9020\u529b\u548c\u5feb\u901f\u601d\u7ef4\u3002"}, {"question": "\u5728 Skribbl.io \u4e2d\u6d41\u7545\u8fd0\u884c\u7684\u6280\u672f\u8981\u6c42\u662f\u4ec0\u4e48\uff1f", "answer": "\u4e3a\u4e86\u5728 Skribbl.io \u4e2d\u6d41\u7545\u8fd0\u884c\uff0c\u8bf7\u786e\u4fdd\u4f60\u7684\u8bbe\u5907\u6ee1\u8db3\u4ee5\u4e0b\u6280\u672f\u8981\u6c42\uff1a\u5177\u6709\u542f\u7528 JavaScript \u7684\u73b0\u4ee3\u7f51\u7edc\u6d4f\u89c8\u5668\uff08\u4f8b\u5982 Chrome\u3001Firefox\uff09\uff0c\u7a33\u5b9a\u7684\u4e92\u8054\u7f51\u8fde\u63a5\u4ee5\u53ca\u54cd\u5e94\u7075\u654f\u7684\u8f93\u5165\u8bbe\u5907\uff08\u9f20\u6807\u6216\u89e6\u6478\u677f\uff09\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u8fc7\u65f6\u7684\u6d4f\u89c8\u5668\u53ef\u80fd\u4f1a\u5bfc\u81f4\u5ef6\u8fdf\u6216\u6e32\u67d3\u95ee\u9898\u3002\u6b64\u5916\uff0c\u5173\u95ed\u4e0d\u5fc5\u8981\u7684\u6807\u7b7e\u53ef\u4ee5\u91ca\u653e\u7cfb\u7edf\u8d44\u6e90\uff0c\u786e\u4fdd\u7ed8\u753b\u548c\u731c\u6d4b\u4f53\u9a8c\u66f4\u6d41\u7545\u3002"}, {"question": "\u73a9\u5bb6\u80fd\u5426\u5728\u4e0d\u540c\u7684\u8bbe\u5907\u4e4b\u95f4\u4f20\u8f93\u4ed6\u4eec\u7684 Skribbl.io \u6570\u636e\uff1f", "answer": "\u76ee\u524d\uff0cSkribbl.io \u4e0d\u652f\u6301\u8bbe\u5907\u4e4b\u95f4\u7684\u8de8\u8bbe\u5907\u6570\u636e\u4f20\u8f93\u3002\u6bcf\u6b21\u4f1a\u8bdd\u90fd\u662f\u72ec\u7acb\u7684\uff0c\u8fdb\u5ea6\uff08\u4f8b\u5982\u5206\u6570\u548c\u6392\u540d\uff09\u4e0d\u4f1a\u8de8\u8bbe\u5907\u4fdd\u5b58\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u7b14\u8bb0\u672c\u7535\u8111\u4e0a\u73a9\u6e38\u620f\uff0c\u7136\u540e\u5207\u6362\u5230\u5e73\u677f\u7535\u8111\uff0c\u4f60\u5728\u65b0\u4f1a\u8bdd\u4e2d\u5c06\u4ece\u5934\u5f00\u59cb\u3002\u4f46\u662f\uff0c\u4f60\u53ef\u4ee5\u4f7f\u7528\u76f8\u540c\u7684\u6635\u79f0\u548c\u8bbe\u7f6e\u6765\u4fdd\u6301\u4e00\u81f4\u7684\u8eab\u4efd\u3002"}, {"question": "Skribbl.io \u4e2d\u662f\u5426\u5b58\u5728\u4efb\u4f55\u9690\u85cf\u7684\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "\u662f\u7684\uff0cSkribbl.io \u5305\u542b\u9690\u85cf\u7684\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u589e\u52a0\u4e86\u4e50\u8da3\u3002\u4f8b\u5982\uff0c\u5728\u804a\u5929\u4e2d\u8f93\u5165\u201c/flip\u201d\u4f1a\u5c06\u4f60\u7684\u753b\u5e03\u7ffb\u8f6c\uff0c\u8fd9\u662f\u4e00\u79cd\u5e7d\u9ed8\u7684\u65b9\u5f0f\u6765\u6311\u6218\u5176\u4ed6\u73a9\u5bb6\u3002\u53e6\u4e00\u4e2a\u9690\u85cf\u529f\u80fd\u662f\u4f7f\u7528\u952e\u76d8\u5feb\u6377\u952e\u6765\u4f7f\u7528\u7ed8\u753b\u5de5\u5177\uff0c\u4f8b\u5982\u6309\u201cE\u201d\u6765\u4f7f\u7528\u6a61\u76ae\u64e6\u3002\u8fd9\u4e9b\u5c0f\u60ca\u559c\u4e3a\u65b0\u8001\u73a9\u5bb6\u90fd\u63d0\u5347\u4e86\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u5728 Skribbl.io \u4e2d\u521b\u5efa\u79c1\u4eba\u623f\u95f4\u7684\u6700\u4f73\u5b9e\u8df5\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728 Skribbl.io \u4e2d\u521b\u5efa\u79c1\u4eba\u623f\u95f4\u9700\u8981\u4e00\u4e9b\u6700\u4f73\u5b9e\u8df5\uff1a\u6b65\u9aa4 1 - \u70b9\u51fb\u201c\u521b\u5efa\u79c1\u4eba\u623f\u95f4\u201d\u5e76\u8bbe\u7f6e\u4e00\u4e2a\u72ec\u7279\u7684\u5bc6\u7801\u4ee5\u9650\u5236\u8bbf\u95ee\u3002\u6b65\u9aa4 2 - \u9009\u62e9\u6240\u6709\u53c2\u4e0e\u8005\u90fd\u80fd\u7406\u89e3\u7684\u8bed\u8a00\uff0c\u4ee5\u786e\u4fdd\u6e38\u620f\u987a\u5229\u8fdb\u884c\u3002\u6b65\u9aa4 3 - \u6839\u636e\u4f60\u56e2\u961f\u7684\u559c\u597d\u8bbe\u7f6e\u8f6e\u6570\u548c\u65f6\u95f4\u9650\u5236\u3002\u4f8b\u5982\uff0c\u8f83\u77ed\u7684\u65f6\u95f4\u9650\u5236\uff08\u4f8b\u5982 60 \u79d2\uff09\u53ef\u4ee5\u4f7f\u6e38\u620f\u66f4\u5177\u6311\u6218\u6027\u548c\u8da3\u5473\u6027\u3002\u8fd9\u4e9b\u6b65\u9aa4\u6709\u52a9\u4e8e\u4e3a\u4f60\u7684\u56e2\u961f\u521b\u9020\u5b9a\u5236\u4e14\u6109\u5feb\u7684\u4f53\u9a8c\u3002"}]
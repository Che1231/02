[{"question": "Skribbl.io\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \uccab \ubc88\uc9f8 \uac8c\uc784\uc744 \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Skribbl.io\uc5d0\uc11c \uccab \ubc88\uc9f8 \uac8c\uc784\uc744 \uc2dc\uc791\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. STEP1 - \uacf5\uc2dd Skribbl.io \uc6f9\uc0ac\uc774\ud2b8\uc5d0 \uc811\uc18d\ud569\ub2c8\ub2e4. STEP2 - \uacf5\uac1c \ub85c\ube44\uc5d0 \ub4e4\uc5b4\uac00\uac70\ub098 \uac1c\uc778 \ub8f8\uc744 \uc0dd\uc131\ud558\ub824\uba74 '\ud50c\ub808\uc774' \ubc84\ud2bc\uc744 \ud074\ub9ad\ud569\ub2c8\ub2e4. STEP3 - \ub2c9\ub124\uc784\uc744 \uc120\ud0dd\ud558\uace0 \uc6d0\ud558\ub294 \uc5b8\uc5b4\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc2a4\ud398\uc778\uc5b4\ub97c \uc0ac\uc6a9\ud558\ub294 \uacbd\uc6b0 'Espa\u00f1ol'\uc744 \uc120\ud0dd\ud558\uc5ec \uc2a4\ud398\uc778\uc5b4 \ub2e8\uc5b4\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. \uac8c\uc784\uc774 \uc2dc\uc791\ub418\uba74 \ub2e4\ub978 \uc0ac\ub78c\ub4e4\uc774 \uadf8\uac83\uc744 \ub9de\ucd94\ub294 \ub3d9\uc548 \ub2e8\uc5b4\ub97c \uadf8\ub9ac\uac70\ub098 \ub2e4\ub978 \uc0ac\ub78c\ub4e4\uc774 \uadf8\ub9ac\ub294 \uac83\uc744 \ub9de\ucd94\ub77c\ub294 \uba54\uc2dc\uc9c0\uac00 \ud45c\uc2dc\ub429\ub2c8\ub2e4."}, {"question": "Skribbl.io\uc5d0\uc11c \uadf8\ub9bc \uadf8\ub9ac\ub294 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Skribbl.io\uc5d0\uc11c \uadf8\ub9bc \uadf8\ub9ac\ub294 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc740 \uac04\ub2e8\ud569\ub2c8\ub2e4. \ub9c8\uc6b0\uc2a4 \ub610\ub294 \ud130\uce58\ud328\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \uce94\ubc84\uc2a4\uc5d0 \uadf8\ub9bc\uc744 \uadf8\ub9bd\ub2c8\ub2e4. \ube0c\ub7ec\uc2dc \uc544\uc774\ucf58\uc744 \ud074\ub9ad\ud558\uace0 \ub450\uaed8\ub97c \uc120\ud0dd\ud558\uc5ec \ube0c\ub7ec\uc2dc \ud06c\uae30\ub97c \ubcc0\uacbd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc0c9\uc0c1\uc744 \ubcc0\uacbd\ud558\ub824\uba74 \uc0c9\uc0c1 \ud314\ub808\ud2b8\ub97c \ud074\ub9ad\ud558\uace0 \uc6d0\ud558\ub294 \uc0c9\uc0c1\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc0ac\uacfc\ub97c \uadf8\ub9b0\ub2e4\uba74 \ud314\ub808\ud2b8\uc5d0\uc11c \ube68\uac04\uc0c9\uc744 \uc120\ud0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \uc9c0\uc6b0\uac1c \uc544\uc774\ucf58\uc744 \ud074\ub9ad\ud558\uc5ec \uc9c0\uc6b0\uac1c \ub3c4\uad6c\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc2e4\uc218\ub97c \uc218\uc815\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Skribbl.io\uc5d0\uc11c \uc801\uc808\ud55c \ub2e8\uc5b4\ub97c \uc120\ud0dd\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Skribbl.io\uc5d0\uc11c \uc801\uc808\ud55c \ub2e8\uc5b4\ub97c \uc120\ud0dd\ud558\ub294 \uac83\uc740 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc65c\ub0d0\ud558\uba74 \ub2e4\ub978 \uc0ac\ub78c\ub4e4\uc774 \uc5bc\ub9c8\ub098 \ube68\ub9ac \uadf8\ub9ac\uace0 \uc815\ud655\ud558\uac8c \ub2e8\uc5b4\ub97c \ub9de\ucd9c \uc218 \uc788\ub294\uc9c0\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uace0\uc591\uc774'\ub294 '\ud0a4\uba54\ub77c'\ubcf4\ub2e4 \uadf8\ub9ac\uae30\uc640 \ub9de\ucd94\uae30\uac00 \ub354 \uc27d\uc2b5\ub2c8\ub2e4. \uc798 \uc120\ud0dd\ub41c \ub2e8\uc5b4\ub294 \ub2e8\uc21c\uc131\uacfc \uc778\uc2dd\uc131\uc744 \uade0\ud615 \uc788\uac8c \uc720\uc9c0\ud558\uc5ec \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \ub354\uc6b1 \uc6d0\ud65c\ud558\uac8c \ud569\ub2c8\ub2e4. \uc774\ub294 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc5d0 \uc544\uc9c1 \uc775\uc219\ud558\uc9c0 \uc54a\uc740 \uc2e0\uaddc \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ud2b9\ud788 \uc911\uc694\ud569\ub2c8\ub2e4."}, {"question": "\uacbd\ud5d8 \ub9ce\uc740 \ud50c\ub808\uc774\uc5b4\ub294 Skribbl.io\uc5d0\uc11c \ucd94\uce21 \uc18d\ub3c4\ub97c \uc5b4\ub5bb\uac8c \ub192\uc77c \uc218 \uc788\ub098\uc694?", "answer": "\uacbd\ud5d8 \ub9ce\uc740 \ud50c\ub808\uc774\uc5b4\ub294 \uc77c\ubc18\uc801\uc778 \ud328\ud134\uacfc \ubaa8\uc591\uc5d0 \uc9d1\uc911\ud558\uc5ec Skribbl.io\uc5d0\uc11c \ucd94\uce21 \uc18d\ub3c4\ub97c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1 - \ucc98\uc74c \uadf8\ub824\uc9c0\ub294 \uc120\uc5d0 \uc8fc\uc758\ud558\uc2ed\uc2dc\uc624. \uc774 \uc120\ub4e4\uc740 \uc885\uc885 \ubb3c\uccb4\uc758 \uc724\uacfd\uc744 \uc554\uc2dc\ud569\ub2c8\ub2e4. STEP2 - \ub300\ud654\ucc3d\uc744 \uc0ac\uc6a9\ud558\uc5ec \uba85\ud655\ud55c \uc9c8\ubb38\uc744 \ud558\uac70\ub098 \ucd94\uce21\uc744 \ud569\ub2c8\ub2e4. STEP3 - \uc120\ud0dd\ud55c \uc5b8\uc5b4\uc5d0\uc11c \uc790\uc8fc \uc0ac\uc6a9\ub418\ub294 \ub2e8\uc5b4\uc5d0 \uc775\uc219\ud574\uc9c0\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ud50c\ub808\uc774\uc5b4\uac00 \uc6d0\uacfc \uc904\uae30\ub97c \uadf8\ub9ac\ub294 \uac83\uc744 \ubcf4\uba74 '\uc0ac\uacfc'\uac00 \uadf8\ub7f4\ub4ef\ud55c \ucd94\uce21\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc804\ub7b5\uc740 \ucd94\uce21 \uc2dc\uac04\uc744 \ud06c\uac8c \uc904\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud50c\ub808\uc774\uc5b4\uac00 Skribbl.io\uc5d0\uc11c \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud558\uae30 \uc704\ud574 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Skribbl.io\uc5d0\uc11c \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud558\ub824\uba74 \ud50c\ub808\uc774\uc5b4\ub294 \uba85\ud655\ud558\uace0 \ube60\ub974\uac8c \ucd94\uce21\ud558\ub294 \uc774\uc911 \uc804\ub7b5\uc744 \ucc44\ud0dd\ud574\uc57c \ud569\ub2c8\ub2e4. STEP1 - \uadf8\ub9bc\uc744 \uadf8\ub9b4 \ub54c \uac04\ub2e8\ud558\uace0 \uc778\uc2dd\ud558\uae30 \uc26c\uc6b4 \ubaa8\uc591\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ub9c9\ub300 \uc778\ubb3c\uc740 \uc0c1\uc138\ud55c \ucd08\uc0c1\ud654\ubcf4\ub2e4 \uc2dd\ubcc4\ud558\uae30\uac00 \ub354 \uc27d\uc2b5\ub2c8\ub2e4. STEP2 - \ucd94\uce21\ud560 \ub54c, \ubd80\ubd84\uc801\uc778 \ub2e8\uc5b4\ub97c \uc785\ub825\ud558\uc5ec \uadf8\ub9bc\uacfc \uc77c\uce58\ud558\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. STEP3 - \ub2e4\ub978 \uc0ac\uc6a9\uc790\uc640 \ud611\ub825\ud558\uae30 \uc704\ud574 \ucc44\ud305\uc5d0 \uc801\uadf9\uc801\uc73c\ub85c \ucc38\uc5ec\ud558\uc2ed\uc2dc\uc624. \uc774\ub7ec\ud55c \uc811\uadfc \ubc29\uc2dd\uc744 \uade0\ud615 \uc788\uac8c \ud65c\uc6a9\ud558\uba74 \ud50c\ub808\uc774\uc5b4\ub294 \uc810\uc218\ub97c \ub354 \ud6a8\uc728\uc801\uc73c\ub85c \ud68d\ub4dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Skribbl.io\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "Skribbl.io\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uadf8\ub9bc\uacfc \ucd94\uce21 \ubaa8\ub450\ub97c \ubcf4\uc0c1\ud569\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\uac00 \ub2e8\uc5b4\ub97c \uc815\ud655\ud558\uac8c \ucd94\uce21\ud558\uba74 \ucd94\uce21\uc790\uc640 \uadf8\ub9bc \uadf8\ub9ac\ub294 \uc0ac\ub78c \ubaa8\ub450 \uc810\uc218\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. \ucd94\uce21\uc774 \ube60\ub97c\uc218\ub85d \uc810\uc218\uac00 \ub192\uc544\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 5\ucd08 \uc548\uc5d0 '\uac15\uc544\uc9c0'\ub97c \ub9de\ucd94\uba74 100\uc810\uc774 \ub420 \uc218 \uc788\uc9c0\ub9cc, 10\ucd08 \ud6c4\uc5d0 \ub9de\ucd94\uba74 50\uc810\ubc16\uc5d0 \uc5bb\uc9c0 \ubabb\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub9bc \uadf8\ub9ac\ub294 \uc0ac\ub78c\ub3c4 \uc815\ud655\ud55c \ucd94\uce21 \ud69f\uc218\uc5d0 \ub530\ub77c \uc810\uc218\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \ucc3d\uc758\ub825\uacfc \ube60\ub978 \uc0ac\uace0\ub97c \ubaa8\ub450 \uc7a5\ub824\ud569\ub2c8\ub2e4."}, {"question": "Skribbl.io\ub97c \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ud558\uae30 \uc704\ud55c \uae30\uc220\uc801 \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Skribbl.io\ub97c \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ud558\ub824\uba74 \uc7a5\uce58\uac00 \ub2e4\uc74c \uae30\uc220\uc801 \uc694\uad6c \uc0ac\ud56d\uc744 \ucda9\uc871\ud558\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uc790\ubc14\uc2a4\ud06c\ub9bd\ud2b8\uac00 \ud65c\uc131\ud654\ub41c \ucd5c\uc2e0 \uc6f9 \ube0c\ub77c\uc6b0\uc800(\uc608: Chrome, Firefox), \uc548\uc815\uc801\uc778 \uc778\ud130\ub137 \uc5f0\uacb0, \ubc18\uc751\uc131 \uc788\ub294 \uc785\ub825 \uc7a5\uce58(\ub9c8\uc6b0\uc2a4 \ub610\ub294 \ud130\uce58\ud328\ub4dc)\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc624\ub798\ub41c \ube0c\ub77c\uc6b0\uc800\ub97c \uc0ac\uc6a9\ud558\uba74 \uc9c0\uc5f0 \ub610\ub294 \ub80c\ub354\ub9c1 \ubb38\uc81c\uac00 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \ubd88\ud544\uc694\ud55c \ud0ed\uc744 \ub2eb\uc73c\uba74 \uc2dc\uc2a4\ud15c \ub9ac\uc18c\uc2a4\uac00 \ud655\ubcf4\ub418\uc5b4 \ub354\uc6b1 \uc6d0\ud65c\ud558\uac8c \uadf8\ub9bc\uc744 \uadf8\ub9ac\uac70\ub098 \ucd94\uce21\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 Skribbl.io \ub370\uc774\ud130\ub97c \uc7a5\uce58 \uac04\uc5d0 \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud604\uc7ac Skribbl.io\ub294 \uc7a5\uce58 \uac04 \ub370\uc774\ud130 \uc804\uc1a1\uc744 \uc9c0\uc6d0\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uac01 \uc138\uc158\uc740 \ub3c5\ub9bd\uc801\uc774\uba70 \uc810\uc218\ub098 \uc21c\uc704\uc640 \uac19\uc740 \uc9c4\ud589 \uc0c1\ud669\uc740 \uc7a5\uce58 \uac04\uc5d0 \uc800\uc7a5\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub178\ud2b8\ubd81\uc5d0\uc11c \ud50c\ub808\uc774\ud55c \ud6c4 \ud0dc\ube14\ub9bf\uc73c\ub85c \uc804\ud658\ud558\uba74 \uc0c8 \uc138\uc158\uc5d0\uc11c \ucc98\uc74c\ubd80\ud130 \uc2dc\uc791\ud558\uac8c \ub429\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \ub3d9\uc77c\ud55c \ub2c9\ub124\uc784\uacfc \uc124\uc815\uc744 \uc0ac\uc6a9\ud558\uba74 \uc77c\uad00\ub41c \uc544\uc774\ub374\ud2f0\ud2f0\ub97c \uc720\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Skribbl.io\uc5d0\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\ub098\uc694?", "answer": "\ub124, Skribbl.io\uc5d0\ub294 \uc990\uac70\uc6c0\uc744 \ub354\ud558\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucc44\ud305\ucc3d\uc5d0 '/flip'\uc744 \uc785\ub825\ud558\uba74 \uce94\ubc84\uc2a4\uac00 \ub4a4\uc9d1\ud788\ubbc0\ub85c \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub97c \ub2a5\uae00\ub9de\uac8c \ub3c4\uc804\ud558\ub294 \ubc29\ubc95\uc774 \ub429\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc740 \uc9c0\uc6b0\uac1c \ub3c4\uad6c\uc640 \uac19\uc740 \uadf8\ub9bc \ub3c4\uad6c\uc5d0 \ub300\ud55c \ud0a4\ubcf4\ub4dc \ub2e8\ucd95\ud0a4\ub97c \uc0ac\uc6a9\ud560 \uc218 \uc788\ub2e4\ub294 \uac83\uc785\ub2c8\ub2e4(\uc608: \uc9c0\uc6b0\uac1c\ub97c \uc704\ud574 'E'\ub97c \ub204\ub985\ub2c8\ub2e4). \uc774\ub7ec\ud55c \uc791\uc740 \ub180\ub77c\uc6c0\uc740 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uc640 \uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4 \ubaa8\ub450\uc5d0\uac8c \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4."}, {"question": "Skribbl.io\uc5d0\uc11c \uac1c\uc778 \ub8f8\uc744 \ub9cc\ub4dc\ub294 \ucd5c\uc120\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Skribbl.io\uc5d0\uc11c \uac1c\uc778 \ub8f8\uc744 \ub9cc\ub4dc\ub294 \ub370\ub294 \uba87 \uac00\uc9c0 \ucd5c\uc120\uc758 \ubc29\ubc95\uc774 \uc788\uc2b5\ub2c8\ub2e4. STEP1 - '\uac1c\uc778 \ub8f8 \uc0dd\uc131'\uc744 \ud074\ub9ad\ud558\uace0 \uace0\uc720\ud55c \uc554\ud638\ub97c \uc124\uc815\ud558\uc5ec \uc561\uc138\uc2a4\ub97c \uc81c\ud55c\ud569\ub2c8\ub2e4. STEP2 - \ubaa8\ub4e0 \ucc38\uac00\uc790\uac00 \uc774\ud574\ud558\ub294 \uc5b8\uc5b4\ub97c \uc120\ud0dd\ud558\uc5ec \uc6d0\ud65c\ud55c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ubcf4\uc7a5\ud569\ub2c8\ub2e4. STEP3 - \uadf8\ub8f9\uc758 \uc120\ud638\ub3c4\uc5d0 \ub530\ub77c \ub77c\uc6b4\ub4dc \uc218\uc640 \uc2dc\uac04 \uc81c\ud55c\uc744 \uc124\uc815\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc9e7\uc740 \uc2dc\uac04 \uc81c\ud55c(\uc608: 60\ucd08)\uc740 \uac8c\uc784\uc744 \ub354\uc6b1 \uc5b4\ub835\uace0 \ud765\ubbf8\ub86d\uac8c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ub2e8\uacc4\ub294 \uadf8\ub8f9\uc5d0 \ub9de\ucda4\ud654\ub418\uace0 \uc990\uac70\uc6b4 \uacbd\ud5d8\uc744 \ub9cc\ub4dc\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}]
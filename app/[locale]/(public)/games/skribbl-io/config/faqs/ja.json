[{"question": "Skribbl.io\u3067\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u6700\u521d\u306e\u30b2\u30fc\u30e0\u3092\u59cb\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Skribbl.io\u3067\u6700\u521d\u306e\u30b2\u30fc\u30e0\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71-\u516c\u5f0f\u30b5\u30a4\u30c8\u306eSkribbl.io\u306b\u30a2\u30af\u30bb\u30b9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72-\u30d1\u30d6\u30ea\u30c3\u30af\u30ed\u30d3\u30fc\u306b\u53c2\u52a0\u3059\u308b\u304b\u3001\u30d7\u30e9\u30a4\u30d9\u30fc\u30c8\u30eb\u30fc\u30e0\u3092\u4f5c\u6210\u3059\u308b\u306b\u306f\u3001\u300c\u30d7\u30ec\u30a4\u300d\u30dc\u30bf\u30f3\u3092\u30af\u30ea\u30c3\u30af\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73-\u30cb\u30c3\u30af\u30cd\u30fc\u30e0\u3092\u9078\u629e\u3057\u3001\u304a\u597d\u307f\u306e\u8a00\u8a9e\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30b9\u30da\u30a4\u30f3\u8a9e\u3092\u8a71\u3059\u5834\u5408\u306f\u3001\u300cEspa\u00f1ol\u300d\u3092\u9078\u629e\u3059\u308b\u3068\u3001\u30b9\u30da\u30a4\u30f3\u8a9e\u3067\u5358\u8a9e\u3092\u53d6\u5f97\u3067\u304d\u307e\u3059\u3002\u30b2\u30fc\u30e0\u304c\u59cb\u307e\u308b\u3068\u3001\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u305d\u308c\u3092\u63a8\u6e2c\u3059\u308b\u9593\u306b\u5358\u8a9e\u3092\u63cf\u753b\u3059\u308b\u304b\u3001\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u63cf\u3044\u3066\u3044\u308b\u3082\u306e\u3092\u63a8\u6e2c\u3059\u308b\u3088\u3046\u306b\u6c42\u3081\u3089\u308c\u307e\u3059\u3002"}, {"question": "Skribbl.io\u3067\u306e\u63cf\u753b\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Skribbl.io\u3067\u306e\u63cf\u753b\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u306f\u7c21\u5358\u3067\u3059\u3002\u30de\u30a6\u30b9\u307e\u305f\u306f\u30bf\u30c3\u30c1\u30d1\u30c3\u30c9\u309
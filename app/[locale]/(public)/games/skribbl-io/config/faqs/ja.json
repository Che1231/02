5\u306f\u3001\u63a8\u6e2c\u6642\u9593\u3092\u5927\u5e45\u306b\u77ed\u7e2e\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306fSkribbl.io\u3067\u30dd\u30a4\u30f3\u30c8\u3092\u6700\u5927\u5316\u3059\u308b\u305f\u3081\u306b\u3069\u306e\u3088\u3046\u306a\u6226\u7565\u3092\u5229\u7528\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Skribbl.io\u3067\u30dd\u30a4\u30f3\u30c8\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u660e\u78ba\u306b\u63cf\u753b\u3057\u3066\u3001\u7d20\u65e9\u304f\u63a8\u6e2c\u3059\u308b\u3068\u3044\u30462\u3064\u306e\u6226\u7565\u3092\u63a1\u7528\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71-\u63cf\u753b\u3059\u308b\u969b\u306f\u3001\u30b7\u30f3\u30d7\u30eb\u3067\u8a8d\u8b58\u3057\u3084\u3059\u3044\u5f62\u72b6\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u3001\u68d2\u4eba\u9593\u306f\u8a73\u7d30\u306a\u8096\u50cf\u753b\u3088\u308a\u3082\u8b58\u5225\u3057\u3084\u3059\u3044\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d72-\u63a8\u6e2c\u3059\u308b\u3068\u304d\u306f\u3001\u90e8\u5206\u7684\u306a\u5358\u8a9e\u3092\u5165\u529b\u3057\u3066\u3001\u63cf\u753b\u3068\u4e00\u81f4\u3059\u308b\u304b\u3069\u3046\u304b\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73-\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u5354\u529b\u3059\u308b\u305f\u3081\u306b\u30c1\u30e3\u30c3\u30c8\u306b\u7a4d\u6975\u7684\u306b\u53c2\u52a0\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u3089\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u3092\u30d0\u30e9\u30f3\u30b9\u3055\u305b\u308b\u3053\u3068\u3067\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3088\u308a\u52b9\u7387\u7684\u306b\u30dd\u30a4\u30f3\u30c8\u3092\u84c4\u7a4d\u3067\u304d\u307e\u3059\u3002"}, {"question": "Skribbl.io\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306e\u4ed5\u7d44\u307f\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Skribbl.io\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30
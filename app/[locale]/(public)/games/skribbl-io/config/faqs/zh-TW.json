[{"question": "Skribbl.io\u65b0\u624b\u5982\u4f55\u958b\u59cb\u7b2c\u4e00\u5834\u904a\u6232\uff1f", "answer": "\u8981\u958b\u59cb\u60a8\u5728 Skribbl.io \u7684\u7b2c\u4e00\u5834\u904a\u6232\uff0c\u8acb\u9075\u5faa\u4e0b\u5217\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u700f\u89bd\u5b98\u65b9 Skribbl.io \u7db2\u7ad9\u3002\u6b65\u9a5f2 - \u9ede\u64ca\u300c\u904a\u6232\u300d\u6309\u9215\uff0c\u5373\u53ef\u9032\u5165\u516c\u5171\u5927\u5ef3\u6216\u5efa\u7acb\u79c1\u4eba\u623f\u9593\u3002\u6b65\u9a5f3 - \u9078\u64c7\u66b1\u7a31\u4e26\u9078\u64c7\u60a8\u7684\u504f\u597d\u8a9e\u8a00\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u662f\u897f\u73ed\u7259\u8a9e\u4f7f\u7528\u8005\uff0c\u8acb\u9078\u64c7\u300cEspa\u00f1ol\u300d\u4ee5\u7372\u5f97\u897f\u73ed\u7259\u8a9e\u55ae\u5b57\u3002\u904a\u6232\u958b\u59cb\u5f8c\uff0c\u7cfb\u7d71\u6703\u63d0\u793a\u60a8\u7e6a\u88fd\u4e00\u500b\u55ae\u5b57\uff0c\u800c\u5176\u4ed6\u4eba\u5247\u731c\u6e2c\u5b83\uff0c\u6216\u8005\u731c\u6e2c\u5176\u4ed6\u4eba\u6b63\u5728\u7e6a\u88fd\u7684\u55ae\u5b57\u3002"}, {"question": "Skribbl.io\u4e2d\u7e6a\u5716\u7684\u57fa\u672c\u63a7\u5236\u6309\u9375\u662f\u4ec0\u9ebc\uff1f", "answer": "Skribbl.io \u4e2d\u7e6a\u5716\u7684\u57fa\u672c\u63a7\u5236\u6309\u9375\u975e\u5e38\u7c21\u55ae\uff1a\u4f7f\u7528\u6ed1\u9f20\u6216\u89f8\u63a7\u677f\u5728\u756b\u5e03\u4e0a\u7e6a\u5716\u3002\u60a8\u53ef\u4ee5\u9ede\u64ca\u756b\u7b46\u5716\u793a\uff0c\u7136\u5f8c\u9078\u64c7\u7c97\u7d30\u4f86\u66f4\u6539\u756b\u7b46\u5927\u5c0f\u3002\u8981\u66f4\u6539\u984f\u8272\uff0c\u8acb\u9ede\u64ca\u8abf\u8272\u76e4\u4e26\u9078\u64c7\u60a8\u60f3\u8981\u7684\u984f\u8272\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u6b63\u5728\u7e6a\u88fd\u860b\u679c\uff0c\u5247\u53ef\u4ee5\u5f9e\u8abf\u8272\u76e4\u4e2d\u9078\u64c7\u7d05\u8272\u3002\u6b64\u5916\uff0c\u60a8\u53ef\u4ee5\u9ede\u64ca\u6a61\u76ae\u64e6\u5716\u793a\u4f7f\u7528\u6a61\u76ae\u64e6\u5de5\u5177\u4f86\u66f4\u6b63\u932f\u8aa4\u3002"}, {"question": "\u5728 Skribbl.io \u4e2d\u9078\u64c7\u6b63\u78ba\u7684\u55ae\u5b57\u70ba\u4ec0\u9ebc\u5f88\u91cd\u8981\uff1f", "answer": "\u5728 Skribbl.io \u4e2d\u9078\u64c7\u6b63\u78ba\u7684\u55ae\u5b57\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6703\u76f4\u63a5\u5f71\u97ff\u5176\u4ed6\u4eba\u731c\u6e2c\u55ae\u5b57\u7684\u901f\u5ea6\u548c\u6e96\u78ba\u6027\u3002\u4f8b\u5982\uff0c\u300c\u8c93\u300d\u6bd4\u300c\u5947\u7f8e\u62c9\u300d\u66f4\u5bb9\u6613\u7e6a\u88fd\u548c\u731c\u6e2c\u3002\u4e00\u500b\u7cbe\u5fc3\u9078\u64c7\u7684\u55ae\u5b57\u5728\u7c21\u55ae\u6027\u548c\u8fa8\u8b58\u5ea6\u4e0a\u53d6\u5f97\u5e73\u8861\uff0c\u78ba\u4fdd\u904a\u6232\u904e\u7a0b\u66f4\u9806\u66a2\u3002\u9019\u5c0d\u4ecd\u5728\u719f\u6089\u904a\u6232\u6a5f\u5236\u7684\u65b0\u73a9\u5bb6\u4f86\u8aaa\u5c24\u5176\u91cd\u8981\u3002"}, {"question": "\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u5982\u4f55\u5728 Skribbl.io \u4e2d\u63d0\u9ad8\u731c\u5b57\u901f\u5ea6\uff1f", "answer": "\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u53ef\u4ee5\u900f\u904e\u95dc\u6ce8\u5e38\u898b\u7684\u6a21\u5f0f\u548c\u5f62\u72c0\u4f86\u63d0\u9ad8\u731c\u5b57\u901f\u5ea6\u3002\u6b65\u9a5f1 - \u6ce8\u610f\u521d\u59cb\u7b46\u89f8\uff0c\u5b83\u5011\u901a\u5e38\u6697\u793a\u7269\u9ad4\u7684\u8f2a\u5ed3\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u804a\u5929\u529f\u80fd\u63d0\u554f\u6216\u63d0\u51fa\u5408\u7406\u7684\u731c\u6e2c\u3002\u6b65\u9a5f3 - \u719f\u6089\u60a8\u9078\u64c7\u7684\u8a9e\u8a00\u4e2d\u5e38\u7528\u7684\u55ae\u5b57\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u6ce8\u610f\u5230\u73a9\u5bb6\u6b63\u5728\u7e6a\u88fd\u4e00\u500b\u5e36\u8396\u7684\u5713\u5708\uff0c\u300c\u860b\u679c\u300d\u53ef\u80fd\u662f\u4e00\u500b\u5408\u7406\u7684\u731c\u6e2c\u3002\u6b64\u7b56\u7565\u53ef\u4ee5\u986f\u8457\u7e2e\u77ed\u731c\u5b57\u6642\u9593\u3002"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u4f7f\u7528\u54ea\u4e9b\u7b56\u7565\u4f86\u6700\u5927\u5316 Skribbl.io \u4e2d\u7684\u5f97\u5206\uff1f", "answer": "\u70ba\u4e86\u5728 Skribbl.io \u4e2d\u6700\u5927\u5316\u5f97\u5206\uff0c\u73a9\u5bb6\u61c9\u8a72\u63a1\u7528\u96d9\u91cd\u7b56\u7565\uff1a\u6e05\u6670\u7e6a\u5716\u548c\u5feb\u901f\u731c\u5b57\u3002\u6b65\u9a5f1 - \u5728\u7e6a\u5716\u6642\uff0c\u4f7f\u7528\u7c21\u55ae\u4e14\u6613\u65bc\u8fa8\u8a8d\u7684\u5f62\u72c0\u3002\u4f8b\u5982\uff0c\u4e00\u500b\u7c21\u7b46\u5716\u6bd4\u8a73\u7d30\u7684\u4eba\u50cf\u66f4\u5bb9\u6613\u8fa8\u8a8d\u3002\u6b65\u9a5f2 - \u5728\u731c\u5b57\u6642\uff0c\u8f38\u5165\u90e8\u5206\u55ae\u5b57\u4ee5\u67e5\u770b\u662f\u5426\u7b26\u5408\u7e6a\u5716\u3002\u6b65\u9a5f3 - \u4fdd\u6301\u5728\u804a\u5929\u4e2d\u6d3b\u8e8d\uff0c\u8207\u4ed6\u4eba\u5408\u4f5c\u3002\u900f\u904e\u5e73\u8861\u9019\u4e9b\u65b9\u6cd5\uff0c\u73a9\u5bb6\u53ef\u4ee5\u66f4\u6709\u6548\u5730\u7d2f\u7a4d\u5206\u6578\u3002"}, {"question": "Skribbl.io \u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "Skribbl.io \u7684\u8a08\u5206\u7cfb\u7d71\u734e\u52f5\u7e6a\u5716\u548c\u731c\u5b57\u5169\u8005\u3002\u7576\u73a9\u5bb6\u731c\u5c0d\u55ae\u5b57\u6642\uff0c\u731c\u6e2c\u8005\u548c\u7e6a\u5716\u8005\u90fd\u6703\u7372\u5f97\u5206\u6578\u3002\u731c\u6e2c\u5f97\u8d8a\u5feb\uff0c\u5206\u6578\u8d8a\u9ad8\u3002\u4f8b\u5982\uff0c\u5728 5 \u79d2\u5167\u731c\u51fa\u300c\u72d7\u300d\u53ef\u80fd\u6703\u7372\u5f97 100 \u5206\uff0c\u800c\u5728 10 \u79d2\u5f8c\u731c\u51fa\u5247\u53ef\u80fd\u53ea\u7372\u5f97 50 \u5206\u3002\u7e6a\u5716\u8005\u4e5f\u6703\u6839\u64da\u6b63\u78ba\u731c\u6e2c\u7684\u6578\u91cf\u7372\u5f97\u5206\u6578\u3002\u6b64\u7cfb\u7d71\u9f13\u52f5\u5275\u9020\u6027\u548c\u5feb\u901f\u601d\u8003\u3002"}, {"question": "\u5728 Skribbl.io \u4e2d\u9806\u5229\u904b\u884c\u9700\u8981\u54ea\u4e9b\u6280\u8853\u8981\u6c42\uff1f", "answer": "\u8981\u4f7f Skribbl.io \u9806\u5229\u904b\u884c\uff0c\u8acb\u78ba\u4fdd\u60a8\u7684\u8a2d\u5099\u7b26\u5408\u9019\u4e9b\u6280\u8853\u8981\u6c42\uff1a\u5177\u6709\u555f\u7528 JavaScript \u7684\u73fe\u4ee3\u7db2\u7d61\u700f\u89bd\u5668\uff08\u4f8b\u5982 Chrome\u3001Firefox\uff09\uff0c\u7a69\u5b9a\u7684\u4e92\u806f\u7db2\u9023\u63a5\u4ee5\u53ca\u53cd\u61c9\u9748\u654f\u7684\u8f38\u5165\u8a2d\u5099\uff08\u6ed1\u9f20\u6216\u89f8\u63a7\u677f\uff09\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u904e\u6642\u7684\u700f\u89bd\u5668\u53ef\u80fd\u6703\u9020\u6210\u5ef6\u9072\u6216\u5448\u73fe\u554f\u984c\u3002\u6b64\u5916\uff0c\u95dc\u9589\u4e0d\u5fc5\u8981\u7684\u6a19\u7c64\u53ef\u4ee5\u91cb\u653e\u7cfb\u7d71\u8cc7\u6e90\uff0c\u78ba\u4fdd\u7e6a\u88fd\u548c\u731c\u6e2c\u9ad4\u9a57\u66f4\u9806\u66a2\u3002"}, {"question": "\u73a9\u5bb6\u662f\u5426\u53ef\u4ee5\u5728\u4e0d\u540c\u88dd\u7f6e\u4e4b\u9593\u8f49\u79fb\u4ed6\u5011\u7684 Skribbl.io \u8cc7\u6599\uff1f", "answer": "\u76ee\u524d\uff0cSkribbl.io \u4e0d\u652f\u63f4\u5728\u4e0d\u540c\u88dd\u7f6e\u4e4b\u9593\u8f49\u79fb\u8cc7\u6599\u3002\u6bcf\u6b21\u904a\u6232\u90fd\u662f\u7368\u7acb\u7684\uff0c\u9032\u5ea6\uff08\u4f8b\u5982\u5206\u6578\u548c\u6392\u540d\uff09\u4e0d\u6703\u5132\u5b58\u5728\u4e0d\u540c\u8a2d\u5099\u4e0a\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u7b46\u8a18\u578b\u96fb\u8166\u4e0a\u904a\u6232\uff0c\u7136\u5f8c\u5207\u63db\u5230\u5e73\u677f\u96fb\u8166\uff0c\u60a8\u5c07\u6703\u5728\u65b0\u7684\u904a\u6232\u6703\u8a71\u4e2d\u91cd\u65b0\u958b\u59cb\u3002\u4f46\u662f\uff0c\u60a8\u53ef\u4ee5\u4f7f\u7528\u76f8\u540c\u7684\u66b1\u7a31\u548c\u8a2d\u5b9a\u4f86\u4fdd\u6301\u4e00\u81f4\u7684\u8b58\u5225\u3002"}, {"question": "Skribbl.io \u4e2d\u662f\u5426\u6709\u4efb\u4f55\u96b1\u85cf\u7684\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "\u662f\u7684\uff0cSkribbl.io \u5305\u542b\u96b1\u85cf\u7684\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u8b93\u904a\u6232\u66f4\u52a0\u6709\u8da3\u3002\u4f8b\u5982\uff0c\u5728\u804a\u5929\u4e2d\u8f38\u5165\u300c/flip\u300d\u6703\u5c07\u60a8\u7684\u756b\u5e03\u7ffb\u8f49\u904e\u4f86\uff0c\u9019\u662f\u4e00\u7a2e\u6311\u6230\u5176\u4ed6\u73a9\u5bb6\u7684\u6709\u8da3\u65b9\u5f0f\u3002\u53e6\u4e00\u500b\u96b1\u85cf\u529f\u80fd\u662f\u4f7f\u7528\u9375\u76e4\u5feb\u6377\u9375\u4f86\u4f7f\u7528\u7e6a\u5716\u5de5\u5177\uff0c\u4f8b\u5982\u6309\u300cE\u300d\u4f7f\u7528\u6a61\u76ae\u64e6\u3002\u9019\u4e9b\u5c0f\u9a5a\u559c\u589e\u5f37\u4e86\u65b0\u73a9\u5bb6\u548c\u8001\u73a9\u5bb6\u7684\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u5728 Skribbl.io \u4e2d\u5efa\u7acb\u79c1\u4eba\u623f\u9593\u7684\u6700\u4f73\u5be6\u52d9\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728 Skribbl.io \u4e2d\u5efa\u7acb\u79c1\u4eba\u623f\u9593\u9700\u8981\u4e00\u4e9b\u6700\u4f73\u5be6\u52d9\uff1a\u6b65\u9a5f1 - \u9ede\u64ca\u300c\u5efa\u7acb\u79c1\u4eba\u623f\u9593\u300d\u4e26\u8a2d\u5b9a\u7368\u7279\u7684\u5bc6\u78bc\u4ee5\u9650\u5236\u5b58\u53d6\u6b0a\u3002\u6b65\u9a5f2 - \u9078\u64c7\u6240\u6709\u53c3\u8207\u8005\u90fd\u80fd\u7406\u89e3\u7684\u8a9e\u8a00\uff0c\u4ee5\u78ba\u4fdd\u904a\u6232\u9806\u5229\u9032\u884c\u3002\u6b65\u9a5f3 - \u6839\u64da\u60a8\u7fa4\u7d44\u7684\u559c\u597d\u8a2d\u5b9a\u56de\u5408\u6578\u548c\u6642\u9593\u9650\u5236\u3002\u4f8b\u5982\uff0c\u8f03\u77ed\u7684\u6642\u9593\u9650\u5236\uff08\u4f8b\u5982 60 \u79d2\uff09\u53ef\u4ee5\u4f7f\u904a\u6232\u66f4\u5177\u6311\u6230\u6027\u548c\u523a\u6fc0\u6027\u3002\u9019\u4e9b\u6b65\u9a5f\u6709\u52a9\u65bc\u70ba\u60a8\u7684\u7fa4\u7d44\u5275\u9020\u91cf\u8eab\u5b9a\u5236\u7684\u6109\u6085\u9ad4\u9a57\u3002"}]
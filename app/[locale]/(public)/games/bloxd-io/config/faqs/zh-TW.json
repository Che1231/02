[{"question": "Bloxd.io\uff1a\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u9032\u884c\u57fa\u672c\u79fb\u52d5\u548c\u8207\u65b9\u584a\u4e92\u52d5\uff1f", "answer": "\u5728 Bloxd.io \u4e2d\uff0c\u4f5c\u70ba\u65b0\u624b\u73a9\u5bb6\uff0c\u60a8\u4e3b\u8981\u6703\u4f7f\u7528 WASD \u9375\u9032\u884c\u79fb\u52d5\uff1aW \u5411\u524d\u79fb\u52d5\uff0cA \u5411\u5de6\u79fb\u52d5\uff0cS \u5411\u5f8c\u79fb\u52d5\uff0cD \u5411\u53f3\u79fb\u52d5\u3002\u7a7a\u683c\u9375\u5141\u8a31\u60a8\u8df3\u8e8d\u3002\u8981\u8207\u65b9\u584a\u4e92\u52d5\uff0c\u8acb\u9ede\u64ca\u5de6\u9375\u4ee5\u6253\u7834\u5b83\u5011\uff0c\u9ede\u64ca\u53f3\u9375\u4ee5\u653e\u7f6e\u65b9\u584a\u3002\u4f8b\u5982\uff0c\u5728\u5275\u610f\u6a21\u5f0f\u4e2d\uff0c\u60a8\u53ef\u4ee5\u901a\u904e\u5f9e\u5eab\u5b58\u4e2d\u9ede\u64ca\u53f3\u9375\u7acb\u5373\u5efa\u9020\u4e00\u500b\u5e87\u8b77\u6240\u3002\u8acb\u8a18\u4f4f\uff0c\u5728\u8a2d\u5b9a\u4e2d\u6aa2\u67e5\u60a8\u7684\u9375\u76e4\u7d81\u5b9a\u4ee5\u9032\u884c\u81ea\u5b9a\u7fa9\u3002\u60f3\u60f3\u5b78\u7fd2\u8d70\u8def\u624d\u80fd\u8dd1\u6b65\u4e00\u6a23\u2014\u2014\u638c\u63e1\u9019\u4e9b\u57fa\u672c\u63a7\u5236\u5c07\u89e3\u9396\u904a\u6232\u4e2d\u7684\u7121\u9650\u53ef\u80fd\u6027\u3002\u70ba\u4e86\u8b93\u9019\u66f4\u5bb9\u6613\uff0c\u60a8\u53ef\u4ee5\u67e5\u770b\u4e0b\u9762\u7684\u8868\u683c\n\n| \u52d5\u4f5c       | \u9375       |\n|--------------|-----------|\n| \u524d\u9032        | W         |\n| \u5411\u5de6\u79fb\u52d5    | A         |\n| \u5f8c\u9000        | S         |\n| \u5411\u53f3\u79fb\u52d5   | D         |\n| \u8df3\u8e8d        | \u7a7a\u683c\u9375  |\n| \u7834\u58de\u65b9\u584a  | \u5de6\u9375\u9ede\u64ca|\n| \u653e\u7f6e\u65b9\u584a  | \u53f3\u9375\u9ede\u64ca"}, {"question": "Bloxd.io \u4e2d\u6709\u54ea\u4e9b\u4e0d\u540c\u7684\u904a\u6232\u6a21\u5f0f\uff0c\u54ea\u500b\u6700\u9069\u5408\u521d\u5b78\u8005\u5b78\u7fd2\u904a\u6232\uff1f", "answer": "Bloxd.io \u63d0\u4f9b\u591a\u7a2e\u904a\u6232\u6a21\u5f0f\uff0c\u5305\u62ec\u5275\u610f\u6a21\u5f0f\u3001\u751f\u5b58\u6a21\u5f0f\u3001\u548c\u5e73\u6a21\u5f0f\u7b49\u7b49\u3002\u5c0d\u65bc\u521d\u5b78\u8005\u4f86\u8aaa\uff0c\"\u5275\u610f\"\u6a21\u5f0f\u975e\u5e38\u63a8\u85a6\u3002\u5728\u5275\u610f\u6a21\u5f0f\u4e2d\uff0c\u60a8\u64c1\u6709\u7121\u9650\u7684\u8cc7\u6e90\uff0c\u4e26\u4e14\u4e0d\u6703\u53d7\u5230\u50b7\u5bb3\uff0c\u9019\u8b93\u60a8\u80fd\u5920\u81ea\u7531\u5730\u5617\u8a66\u5efa\u9020\u548c\u63a2\u7d22\u904a\u6232\u6a5f\u5236\u3002\u4f8b\u5982\uff0c\u60a8\u53ef\u4ee5\u5f9e\u7c21\u55ae\u5730\u5efa\u9020\u623f\u5c4b\u958b\u59cb\uff0c\u800c\u7121\u9700\u64d4\u5fc3\u6536\u96c6\u6750\u6599\u6216\u61c9\u5c0d\u6575\u4eba\u3002\u9019\u6d88\u9664\u4e86\u65e9\u671f\u7684\u632b\u6298\u611f\uff0c\u4e26\u8b93\u60a8\u80fd\u5920\u5c08\u6ce8\u65bc\u5b78\u7fd2\u57fa\u790e\u6a5f\u5236\u7684\u5de5\u4f5c\u65b9\u5f0f\u3002\u6b64\u6a21\u5f0f\u985e\u4f3c\u65bc\u4e00\u500b\u958b\u653e\u5f0f\u6c99\u76d2\uff0c\u64c1\u6709\u7121\u9650\u7684\u6a02\u9ad8\u7a4d\u6728\u3002"}, {"question": "Bloxd.io \u5ef6\u9072\u4e86\uff01\u6211\u5728\u4f4e\u7aef\u96fb\u8166\u4e0a\u5982\u4f55\u6539\u5584 Bloxd.io \u7684\u6548\u80fd\uff1f", "answer": "\u5728 Bloxd.io \u4e2d\u9047\u5230\u5ef6\u9072\u53ef\u80fd\u6703\u4ee4\u4eba\u6d29\u6c23\u3002\u4ee5\u4e0b\u662f\u5982\u4f55\u63d0\u9ad8\u4f4e\u7aef\u96fb\u8166\u7684\u6548\u80fd\uff1a\u9996\u5148\uff0c\u5728\u904a\u6232\u9078\u55ae\uff08\u9078\u9805->\u5716\u5f62\uff09\u4e2d\u964d\u4f4e\u5716\u5f62\u8a2d\u5b9a\u3002\u964d\u4f4e\u6e32\u67d3\u8ddd\u96e2\u5c24\u5176\u6709\u5e6b\u52a9\u3002\u63a5\u4e0b\u4f86\uff0c\u95dc\u9589\u4e0d\u5fc5\u8981\u7684\u5f8c\u81fa\u61c9\u7528\u7a0b\u5f0f\u4ee5\u91cb\u653e\u7cfb\u7d71\u8cc7\u6e90\u3002\u6700\u5f8c\uff0c\u5617\u8a66\u5728\u8f03\u5c11\u73a9\u5bb6\u7684\u4f3a\u670d\u5668\u4e2d\u73a9\u904a\u6232\uff0c\u56e0\u70ba\u5927\u91cf\u7684\u73a9\u5bb6\u6703\u589e\u52a0\u7cfb\u7d71\u7684\u8ca0\u64d4\u3002\u5f9e\u672c\u8cea\u4e0a\u8b1b\uff0c\u964d\u4f4e\u8996\u89ba\u9700\u6c42\u4e26\u91cb\u653e\u8655\u7406\u80fd\u529b\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u97ff\u61c9\u80fd\u529b\u3002"}, {"question": "Bloxd.io \u4e2d\u7684\u74b0\u5883\u5851\u9020\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u4ee5\u53ca\u5851\u9020\u666f\u89c0\u7684\u4e00\u4e9b\u9ad8\u7d1a\u6280\u5de7\u662f\u4ec0\u9ebc\uff1f", "answer": "Bloxd.io \u4e2d\u7684\u74b0\u5883\u5851\u9020\u6d89\u53ca\u4f7f\u7528\u5de5\u5177\u548c\u65b9\u584a\u91cd\u5851\u73fe\u6709\u5730\u5f62\u3002\u9ad8\u7d1a\u6280\u5de7\u5305\u62ec\u901a\u904e\u4ed4\u7d30\u653e\u7f6e\u9ad8\u5ea6\u4e0d\u540c\u7684\u65b9\u584a\u4f86\u5275\u9020\u5e73\u6ed1\u7684\u659c\u5761\uff0c\u4f7f\u7528\u6316\u6398\u5de5\u5177\u8a2d\u8a08\u8907\u96dc\u7684\u96a7\u9053\u7cfb\u7d71\uff0c\u4ee5\u53ca\u5229\u7528\u6c34\u4f86\u5275\u9020\u81ea\u7136\u6e56\u6cca\u548c\u6cb3\u6d41\u3002\u4f8b\u5982\uff0c\u60a8\u53ef\u4ee5\u5148\u5c07\u4e00\u5927\u7247\u5340\u57df\u5f04\u5e73\uff0c\u7136\u5f8c\u4f7f\u7528\u659c\u5761\u4f86\u5275\u9020\u5c64\u72c0\u82b1\u5712\u3002\u9ad8\u7d1a\u74b0\u5883\u5851\u9020\u5c31\u50cf\u865b\u64ec\u5712\u85dd\uff0c\u9010\u584a\u5efa\u9020\u98a8\u666f\u512a\u7f8e\u7684\u666f\u8272\u3002\u9019\u9700\u8981\u6642\u9593\u548c\u8010\u5fc3\uff01\n\n\u6b65\u9a5f 1\uff1a\u8a08\u5283\u60a8\u7684\u8a2d\u8a08\u3002\u5982\u6709\u5fc5\u8981\uff0c\u8acb\u7e6a\u88fd\u8349\u5716\u3002\n\u6b65\u9a5f 2\uff1a\u4f7f\u7528\u5e73\u6574\u5de5\u5177\u5efa\u7acb\u57fa\u790e\u3002\n\u6b65\u9a5f 3\uff1a\u4f7f\u7528\u659c\u5761\u548c\u6c34\u9032\u884c\u96d5\u523b\u3002"}, {"question": "\u70ba\u4ec0\u9ebc Bloxd.io \u4e2d\u7684\u5b9a\u5236\u6a21\u578b\u548c\u6750\u8cea\u5305\u5982\u6b64\u53d7\u6b61\u8fce\uff0c\u5b83\u5011\u5982\u4f55\u986f\u8457\u6539\u8b8a\u904a\u6232\u73a9\u6cd5\uff1f", "answer": "Bloxd.io \u4e2d\u7684\u5b9a\u5236\u6a21\u578b\u548c\u6750\u8cea\u5305\u4e4b\u6240\u4ee5\u53d7\u6b61\u8fce\uff0c\u662f\u56e0\u70ba\u5b83\u5011\u70ba\u73a9\u5bb6\u63d0\u4f9b\u4e86\u4e00\u7a2e\u986f\u8457\u500b\u6027\u5316\u904a\u6232\u9ad4\u9a57\u7684\u65b9\u5f0f\u3002\u6750\u8cea\u5305\u53ef\u4ee5\u5fb9\u5e95\u6539\u9020\u6574\u500b\u8996\u89ba\u6c1b\u570d\uff0c\u8b93\u904a\u6232\u770b\u8d77\u4f86\u66f4\u903c\u771f\uff0c\u6216\u8ce6\u4e88\u5176\u5b8c\u5168\u4e0d\u540c\u7684\u4e3b\u984c\u2014\u2014\u5f9e\u672a\u4f86\u6d3e\u5230\u4e2d\u4e16\u7d00\u3002\u5b9a\u5236\u6a21\u578b\u5141\u8a31\u5f15\u5165\u65b0\u7684\u5f62\u72c0\u548c\u7269\u4ef6\uff0c\u986f\u8457\u64f4\u5c55\u5efa\u7bc9\u80fd\u529b\u548c\u5275\u9020\u529b\u8868\u9054\u3002\u4f8b\u5982\uff0c\u4e00\u500b\u4e2d\u4e16\u7d00\u6750\u8cea\u5305\u53ef\u4ee5\u5c07\u9ed8\u8a8d\u65b9\u584a\u8b8a\u6210\u9d5d\u5375\u77f3\u548c\u6728\u6750\uff0c\u5f9e\u800c\u5fb9\u5e95\u6539\u8b8a\u60a8\u7684\u5efa\u7bc9\u7269\u7684\u611f\u89ba\u3002\u5b83\u63d0\u4f9b\u4e86\u4e00\u500b\u5c0d\u719f\u6089\u904a\u6232\u7684\u65b0\u8996\u89d2\u3002"}, {"question": "\u5728 Bloxd.io \u7684\u9577\u671f\u751f\u5b58\u6a21\u5f0f\u904a\u6232\u4e2d\uff0c\u8cc7\u6e90\u7ba1\u7406\u548c\u57fa\u5730\u9632\u79a6\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728 Bloxd.io \u7684\u9577\u671f\u751f\u5b58\u6a21\u5f0f\u4e2d\uff0c\u6709\u6548\u7684\u8cc7\u6e90\u7ba1\u7406\u548c\u57fa\u5730\u9632\u79a6\u81f3\u95dc\u91cd\u8981\u3002\u6b65\u9a5f 1\uff1a\u76e1\u65e9\u512a\u5148\u6536\u96c6\u53ef\u518d\u751f\u8cc7\u6e90\uff08\u6728\u6750\u3001\u8fb2\u4f5c\u7269\uff09\u3002\u6b65\u9a5f 2\uff1a\u5728\u60a8\u7684\u57fa\u5730\u5468\u570d\u5efa\u9020\u9632\u79a6\u5de5\u4e8b\uff0c\u4f8b\u5982\u7246\u58c1\u3001\u58d5\u6e9d\u548c\u9677\u9631\u3002\u6b65\u9a5f 3\uff1a\u9010\u6b65\u4f7f\u7528\u88dd\u7f6e\u81ea\u52d5\u6536\u96c6\u8cc7\u6e90\u3002\u4f8b\u5982\uff0c\u70ba\u9632\u79a6\u5efa\u7bc9\u5efa\u7acb\u4e00\u500b\u81ea\u52d5\u5316\u7684\u6a39\u6728\u8fb2\u5834\u914d\u5099\u9d5d\u5375\u77f3\u751f\u6210\u5668\u3002\u5e73\u8861\u64f4\u5f35\u7684\u9700\u6c42\u8207\u78ba\u4fdd\u60a8\u7684\u8cc7\u6e90\uff0c\u8b93\u60a8\u5728\u904a\u6232\u4e2d\u4fdd\u6301\u9818\u5148\u512a\u52e2\u3002"}, {"question": "\u54ea\u4e9b\u6a5f\u5236\u6c7a\u5b9a\u4e86 Bloxd.io \u4e2d\u73a9\u5bb6\u5c0d\u6230 (PvP) \u4f5c\u6230\u7684\u6709\u6548\u6027\uff0c\u4f8b\u5982\u50b7\u5bb3\u8a08\u7b97\u548c\u76d4\u7532\u7a7f\u900f\uff1f", "answer": "Bloxd.io \u4e2d\u7684 PvP \u4f5c\u6230\u6709\u6548\u6027\u53d6\u6c7a\u65bc\u591a\u500b\u56e0\u7d20\u3002\u50b7\u5bb3\u8a08\u7b97\u53d6\u6c7a\u65bc\u60a8\u7684\u6b66\u5668\u3001\u76ee\u6a19\u7684\u76d4\u7532\u548c\u95dc\u9375\u547d\u4e2d\u3002\u76d4\u7532\u7a7f\u900f\u6703\u964d\u4f4e\u5c0d\u624b\u76d4\u7532\u7684\u6709\u6548\u6027\uff0c\u5141\u8a31\u66f4\u591a\u50b7\u5bb3\u7a7f\u900f\u3002\u95dc\u9375\u547d\u4e2d\u6703\u4f7f\u9020\u6210\u7684\u50b7\u5bb3\u6210\u500d\u589e\u52a0\u3002\u5617\u8a66\u4e0d\u540c\u7684\u6b66\u5668-\u76d4\u7532\u7d44\u5408\u5c0d\u65bc\u627e\u5230\u6700\u4f73\u8a2d\u5b9a\u81f3\u95dc\u91cd\u8981\u3002\u60f3\u60f3\u5ca9\u77f3-\u7d19-\u526a\u5200\uff0c\u67d0\u4e9b\u6b66\u5668\u985e\u578b\u5c0d\u7279\u5b9a\u76d4\u7532\u985e\u578b\u66f4\u6709\u6548\u3002\u9019\u5c07\u5e6b\u52a9\u60a8\u4e86\u89e3\u5728\u67d0\u4e9b\u985e\u578b\u73a9\u5bb6\u8eab\u4e0a\u4f7f\u7528\u54ea\u4e9b\u6b66\u5668\u3002\u60a8\u751a\u81f3\u53ef\u4ee5\u78ba\u5b9a\u9700\u8981\u4ec0\u9ebc\u76d4\u7532\u624d\u80fd\u627f\u53d7\u67d0\u4e9b\u653b\u64ca\u3002"}, {"question": "Bloxd.io \u5982\u4f55\u8655\u7406\u8de8\u5e73\u53f0\u904a\u6232\uff0c\u700f\u89bd\u5668\u548c\u79fb\u52d5\u7248\u672c\u4e4b\u9593\u662f\u5426\u5b58\u5728\u4efb\u4f55\u95dc\u9375\u5dee\u7570\uff1f", "answer": "Bloxd.io \u53ef\u80fd\u6703\u63d0\u4f9b\u8de8\u5e73\u53f0\u904a\u6232\uff0c\u4f46\u9019\u9700\u8981\u9a57\u8b49\u3002\u700f\u89bd\u5668\u548c\u79fb\u52d5\u7248\u672c\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u901a\u5e38\u5305\u62ec\u63a7\u5236\u65b9\u6848\uff08\u9375\u76e4/\u6ed1\u9f20\u8207\u89f8\u6478\uff09\u3001\u5716\u5f62\u8a2d\u5b9a\u4ee5\u53ca\u6f5b\u5728\u7684\u67d0\u4e9b\u4f3a\u670d\u5668\u53ef\u7528\u6027\u3002\u96d6\u7136\u904a\u6232\u6a5f\u5236\u4fdd\u6301\u4e0d\u8b8a\uff0c\u4f46\u7528\u6236\u9ad4\u9a57\u53ef\u80fd\u5b58\u5728\u5f88\u5927\u5dee\u7570\u3002\u79fb\u52d5\u7528\u6236\u61c9\u4ed4\u7d30\u8003\u616e\u7531\u65bc\u87a2\u5e55\u5c3a\u5bf8\u8f03\u5c0f\u548c\u89f8\u6478\u63a7\u5236\u53ef\u80fd\u9020\u6210\u7684\u6f5b\u5728\u9650\u5236\uff0c\u5c24\u5176\u662f\u7531\u65bc\u7cbe\u78ba\u653e\u7f6e\u65b9\u584a\u5f88\u91cd\u8981\u3002\u4ee5\u4e0b\u662f\u4e00\u4efd\u5feb\u901f\u53c3\u8003\u8868\uff0c\u9069\u7528\u65bc\u9019\u5169\u7a2e\u5e73\u53f0\uff1a\n\n| \u529f\u80fd | \u700f\u89bd\u5668 | \u79fb\u52d5\u7aef |\n|---|---|---|\n| \u63a7\u5236 | \u9375\u76e4\u548c\u6ed1\u9f20 | \u89f8\u6478 |\n| \u5716\u5f62\u9078\u9805 | \u66f4\u8a73\u7d30 | \u7c21\u5316 |\n| \u8f38\u5165\u7cbe\u78ba\u5ea6 | \u9ad8 | \u4f4e |"}, {"question": "Bloxd.io \u4e2d\u7684\u5df2\u5efa\u7acb\u5730\u5716\u662f\u5426\u5305\u542b\u4efb\u4f55\u5f69\u86cb\u6216\u96b1\u85cf\u4f4d\u7f6e\uff0c\u73a9\u5bb6\u5982\u4f55\u767c\u73fe\u5b83\u5011\uff1f", "answer": "Bloxd.io \u662f\u4e00\u500b\u4e0d\u65b7\u66f4\u65b0\u7684\u904a\u6232\uff0c\u9019\u4e9b\u66f4\u65b0\u4e2d\u901a\u5e38\u6703\u5305\u542b\u5df2\u5efa\u7acb\u5730\u5716\u4e2d\u7684\u5f69\u86cb\u6216\u96b1\u85cf\u4f4d\u7f6e\u3002\u5fb9\u5e95\u63a2\u7d22\u4e26\u6ce8\u610f\u74b0\u5883\u4e2d\u7684\u7d30\u5fae\u8b8a\u5316\u662f\u627e\u5230\u5b83\u5011\u7684\u65b9\u6cd5\u3002\u50be\u807d\u7570\u5e38\u7684\u8072\u97f3\u6216\u5c0b\u627e\u4e0d\u5c0b\u5e38\u7684\u7269\u4ef6\u3002\u4f8b\u5982\uff0c\u67d0\u4e9b\u5730\u5716\u53ef\u80fd\u5305\u542b\u901a\u904e\u79d8\u5bc6\u901a\u9053\u9032\u5165\u7684\u96b1\u85cf\u623f\u9593\u3002\u901a\u5e38\u6709\u8ad6\u58c7\u548c\u90e8\u843d\u683c\u6587\u7ae0\u5305\u542b\u4efb\u4f55\u5f69\u86cb\u8cc7\u8a0a\u3002\u628a\u5b83\u7576\u6210\u4e00\u500b\u865b\u64ec\u5c0b\u5bf6\u904a\u6232\uff01"}, {"question": "Bloxd.io \u4e2d\u54ea\u4e9b\u9ad8\u7d1a\u5efa\u7bc9\u6280\u5de7\u5141\u8a31\u5275\u5efa\u5177\u6709\u903c\u771f\u7269\u7406\u7684\u8907\u96dc\u7d50\u69cb\u8a2d\u8a08\uff0c\u70ba\u4ec0\u9ebc\u5b83\u5011\u5c0d\u7d93\u9a57\u8c50\u5bcc\u7684\u5efa\u9020\u8005\u5f88\u91cd\u8981\uff1f", "answer": "Bloxd.io \u4e2d\u5be6\u73fe\u8907\u96dc\u7d50\u69cb\u7684\u9ad8\u7d1a\u5efa\u7bc9\u6280\u8853\u53d6\u6c7a\u65bc\u7406\u89e3\u904a\u6232\u7684\u6709\u9650\u7269\u7406\u6a21\u578b\u3002\u4f7f\u7528\u652f\u6490\u7d50\u69cb\uff0c\u7406\u89e3\u65b9\u584a\u4f9d\u8cf4\u95dc\u4fc2\u4ee5\u53ca\u5275\u9020\u91cd\u91cf\u5206\u914d\u5c0d\u65bc\u770b\u8d77\u4f86\u903c\u771f\u7684\u8a2d\u8a08\u81f3\u95dc\u91cd\u8981\u3002\u7d93\u9a57\u8c50\u5bcc\u7684\u5efa\u9020\u8005\u512a\u5148\u8003\u616e\u9019\u4e9b\u6280\u8853\uff0c\u56e0\u70ba\u5b83\u5011\u89e3\u9396\u4e86\u5efa\u7bc9\u53ef\u80fd\u6027\uff0c\u5141\u8a31\u4ed6\u5011\u91cd\u73fe\u73fe\u5be6\u4e16\u754c\u7684\u7d50\u69cb\u6216\u767c\u660e\u5b8c\u5168\u65b0\u7684\u5947\u5e7b\u8a2d\u8a08\u3002\u60f3\u50cf\u4e00\u4e0b\u5728 Bloxd.io \u4e2d\u91cd\u73fe\u57c3\u83f2\u723e\u9435\u5854\u2014\u2014\u7406\u89e3\u91cd\u91cf\u5206\u4f48\u539f\u7406\u4e26\u4f7f\u7528\u9069\u7576\u7684\u652f\u6490\u65b9\u584a\u975e\u5e38\u91cd\u8981\u3002\u5275\u9020\u7d50\u69cb\u5805\u56fa\u4e14\u7f8e\u89c0\u7684\u5efa\u7bc9\u662f\u5efa\u9020\u8005\u5c08\u9577\u7684\u6a19\u8a8c\u3002"}]
[{"question": "Bloxd.io: \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub85c\uc11c \uae30\ubcf8\uc801\uc778 \uc6c0\uc9c1\uc784\uacfc \ube14\ub85d\uacfc\uc758 \uc0c1\ud638 \uc791\uc6a9\uc740 \uc5b4\ub5bb\uac8c \ud558\ub098\uc694?", "answer": "Bloxd.io\uc758 \uc2e0\uaddc \ud50c\ub808\uc774\uc5b4\ub294 \uc8fc\ub85c WASD \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc774\ub3d9\ud569\ub2c8\ub2e4. \uc55e\uc73c\ub85c \uc774\ub3d9\ud558\ub824\uba74 W\ud0a4, \uc67c\ucabd\uc73c\ub85c \uc774\ub3d9\ud558\ub824\uba74 A\ud0a4, \ub4a4\ub85c \uc774\ub3d9\ud558\ub824\uba74 S\ud0a4, \uc624\ub978\ucabd\uc73c\ub85c \uc774\ub3d9\ud558\ub824\uba74 D\ud0a4\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \ub204\ub974\uba74 \uc810\ud504\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ube14\ub85d\uacfc \uc0c1\ud638 \uc791\uc6a9\ud558\ub824\uba74 \uc67c\ucabd \ud074\ub9ad\uc73c\ub85c \ube14\ub85d\uc744 \ubd80\uc218\uace0 \uc624\ub978\ucabd \ud074\ub9ad\uc73c\ub85c \ube14\ub85d\uc744 \ubc30\uce58\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud06c\ub9ac\uc5d0\uc774\ud2f0\ube0c \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uc778\ubca4\ud1a0\ub9ac\uc758 \ube14\ub85d\uc73c\ub85c \uc624\ub978\ucabd \ud074\ub9ad\ud558\uc5ec \uc989\uc2dc \uc258\ud130\ub97c \uc9c0\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc0ac\uc6a9\uc790 \uc815\uc758\ub97c \uc704\ud574 \uc124\uc815\uc5d0\uc11c \ud0a4 \ubc14\uc778\ub529\uc744 \ud655\uc778\ud558\ub294 \uac83\uc744 \uc78a\uc9c0 \ub9c8\uc138\uc694. \ub2ec\ub9ac\uae30 \uc804\uc5d0 \uac77\ub294 \ubc95\uc744 \ubc30\uc6b0\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uae30\ubcf8 \uc81c\uc5b4\ub97c \uc219\ub2ec\ud558\uba74 \uac8c\uc784\uc5d0\uc11c \ubb34\ud55c\ud55c \uac00\ub2a5\uc131\uc774 \uc5f4\ub9bd\ub2c8\ub2e4. \uc774\ub97c \ub354 \uc27d\uac8c \ud558\uae30 \uc704\ud574 \uc544\ub798 \ud45c\ub97c \ucc38\uc870\ud558\uc2ed\uc2dc\uc624.\n\n| \ub3d9\uc791       | \ud0a4       |\n|--------------|-----------|\n| \uc804\uc9c4       | W         |\n| \uc88c\uce21 \uc774\ub3d9    | A         |\n| \ud6c4\uc9c4       | S         |\n| \uc6b0\uce21 \uc774\ub3d9   | D         |\n| \uc810\ud504       | \uc2a4\ud398\uc774\uc2a4\ubc14  |\n| \ube14\ub85d \ud30c\uad34  | \uc67c\ucabd \ud074\ub9ad|\n| \ube14\ub85d \ubc30\uce58  | \uc624\ub978\ucabd \ud074\ub9ad|"}, {"question": "Bloxd.io\uc758 \ub2e4\ub978 \uac8c\uc784 \ubaa8\ub4dc\ub294 \ubb34\uc5c7\uc774\uba70, \uac8c\uc784\uc744 \ubc30\uc6b0\ub824\ub294 \ucd08\ubcf4\uc790\uc5d0\uac8c \uac00\uc7a5 \uc801\ud569\ud55c \ubaa8\ub4dc\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Bloxd.io\ub294 \ud06c\ub9ac\uc5d0\uc774\ud2f0\ube0c, \uc11c\ubc14\uc774\ubc8c, \ud3c9\ud654\ub85c\uc6b4 \ub4f1 \uc5ec\ub7ec \uac8c\uc784 \ubaa8\ub4dc\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ucd08\ubcf4\uc790\uc5d0\uac8c\ub294 '\ud06c\ub9ac\uc5d0\uc774\ud2f0\ube0c' \ubaa8\ub4dc\uac00 \uac15\ub825\ud788 \uad8c\uc7a5\ub429\ub2c8\ub2e4. \ud06c\ub9ac\uc5d0\uc774\ud2f0\ube0c \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uc790\uc6d0\uc774 \ubb34\uc81c\ud55c\uc774\uba70, \ud53c\ud574\ub97c \uc785\uc9c0 \uc54a\uc544 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc744 \uc790\uc720\ub86d\uac8c \uc2e4\ud5d8\ud558\uace0 \ud0d0\uad6c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc7ac\ub8cc\ub97c \ubaa8\uc73c\uac70\ub098 \uc801\uacfc \uc2f8\uc6b0\ub294 \uac71\uc815 \uc5c6\uc774 \uc9d1\uc744 \uc9d3\ub294 \uac83\uc73c\ub85c \uc2dc\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub294 \ucd08\uae30\uc758 \uc88c\uc808\uac10\uc744 \uc81c\uac70\ud558\uace0 \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc744 \ubc30\uc6b0\ub294 \ub370 \uc9d1\uc911\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. \uc774 \ubaa8\ub4dc\ub294 \ubb34\uc81c\ud55c \ub808\uace0 \ube14\ub85d\uc774 \uc788\ub294 \uc624\ud508 \uc5d4\ub4dc \uc0cc\ub4dc\ubc15\uc2a4\uc640 \uac19\uc2b5\ub2c8\ub2e4."}, {"question": "Bloxd.io\uac00 \ub04a\uae40 \ud604\uc0c1\uc774 \ubc1c\uc0dd\ud569\ub2c8\ub2e4! \uc800\uc0ac\uc591 PC\uc5d0\uc11c Bloxd.io\uc758 \uc131\ub2a5\uc744 \uac1c\uc120\ud560 \uc218 \uc788\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Bloxd.io\uc5d0\uc11c \ub04a\uae40 \ud604\uc0c1\uc744 \uacbd\ud5d8\ud558\ub294 \uac83\uc740 \uc88c\uc808\uc2a4\ub7ec\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc800\uc0ac\uc591 PC\uc5d0\uc11c \uc131\ub2a5\uc744 \ub192\uc774\ub294 \ubc29\ubc95\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uba3c\uc800 \uac8c\uc784 \uba54\ub274(\uc635\uc158 -> \uadf8\ub798\ud53d)\uc5d0\uc11c \uadf8\ub798\ud53d \uc124\uc815\uc744 \uc904\uc785\ub2c8\ub2e4. \ud2b9\ud788 \ub80c\ub354\ub9c1 \uac70\ub9ac\ub97c \uc904\uc774\ub294 \uac83\uc774 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \ub2e4\uc74c\uc73c\ub85c \ubd88\ud544\uc694\ud55c \ubc31\uadf8\ub77c\uc6b4\ub4dc \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc744 \ub2eb\uc544 \uc2dc\uc2a4\ud15c \ub9ac\uc18c\uc2a4\ub97c \ud655\ubcf4\ud569\ub2c8\ub2e4. \ub9c8\uc9c0\ub9c9\uc73c\ub85c, \ud50c\ub808\uc774\uc5b4 \uc218\uac00 \ub9ce\uc73c\uba74 \uc2dc\uc2a4\ud15c\uc5d0 \ubd80\ub2f4\uc774 \ucee4\uc9c0\ubbc0\ub85c \ub35c \ubd90\ube44\ub294 \uc11c\ubc84\uc5d0\uc11c \uac8c\uc784\uc744 \ud50c\ub808\uc774\ud574 \ubcf4\uc138\uc694. \ubcf8\uc9c8\uc801\uc73c\ub85c, \uc2dc\uac01\uc801\uc778 \uc694\uad6c \uc0ac\ud56d\uc744 \uc904\uc774\uace0 \ucc98\ub9ac \ub2a5\ub825\uc744 \ud655\ubcf4\ud558\uba74 \uc751\ub2f5\uc131\uc744 \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Bloxd.io\uc5d0\uc11c \uc9c0\ud615 \ubcc0\ud615\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \ud48d\uacbd\uc744 \uc870\uac01\ud558\ub294 \uace0\uae09 \uae30\uc220\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Bloxd.io\uc5d0\uc11c \uc9c0\ud615 \ubcc0\ud615\uc740 \ub3c4\uad6c\uc640 \ube14\ub85d\uc744 \uc0ac\uc6a9\ud558\uc5ec \uae30\uc874 \uc9c0\ud615\uc744 \uc7ac\uad6c\uc131\ud558\ub294 \uac83\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4. \uace0\uae09 \uae30\uc220\uc5d0\ub294 \ub2e4\uc591\ud55c \ub192\uc774\uc5d0 \ube14\ub85d\uc744 \uc2e0\uc911\ud558\uac8c \ubc30\uce58\ud558\uc5ec \ubd80\ub4dc\ub7ec\uc6b4 \uacbd\uc0ac\ub97c \ub9cc\ub4dc\ub294 \uac83, \uad74\ucc29 \ub3c4\uad6c\ub97c \uc0ac\uc6a9\ud558\uc5ec \ubcf5\uc7a1\ud55c \ud130\ub110 \uc2dc\uc2a4\ud15c\uc744 \uc124\uacc4\ud558\ub294 \uac83, \ubb3c\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \ud638\uc218\uc640 \uac15\uc744 \ub9cc\ub4dc\ub294 \uac83\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud070 \uc9c0\uc5ed\uc744 \ud3c9\ud3c9\ud558\uac8c \ub9cc\ub4e4\uace0 \uadf8 \ud6c4 \uacbd\uc0ac\ub97c \uc0ac\uc6a9\ud558\uc5ec \uacc4\ub2e8\uc2dd \uc815\uc6d0\uc744 \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uace0\uae09 \uc9c0\ud615 \ubcc0\ud615\uc740 \ube14\ub85d \ub2e8\uc704\ub85c \uc7a5\uad00\uc744 \uc870\uc131\ud558\ub294 \uac00\uc0c1 \uc870\uacbd\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uae30\uc220\uc5d0\ub294 \uc2dc\uac04\uacfc \uc778\ub0b4\uc2ec\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.\n\n1\ub2e8\uacc4: \ub514\uc790\uc778\uc744 \uacc4\ud68d\ud569\ub2c8\ub2e4. \ud544\uc694\uc5d0 \ub530\ub77c \uc2a4\ucf00\uce58\ud569\ub2c8\ub2e4.\n2\ub2e8\uacc4: \ud3c9\ud0c4\ud654 \ub3c4\uad6c\ub97c \uc0ac\uc6a9\ud558\uc5ec \uae30\ubc18\uc744 \ub9cc\ub4ed\ub2c8\ub2e4.\n3\ub2e8\uacc4: \uacbd\uc0ac\uc640 \ubb3c\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc870\uac01\ud569\ub2c8\ub2e4."}, {"question": "Bloxd.io\uc5d0\uc11c \uc0ac\uc6a9\uc790 \uc9c0\uc815 \ubaa8\ub378\uacfc \ud14d\uc2a4\ucc98 \ud329\uc774 \uc778\uae30 \uc788\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc5b4\ub5bb\uac8c \ud06c\uac8c \ubc14\uafc0 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Bloxd.io\uc5d0\uc11c \uc0ac\uc6a9\uc790 \uc9c0\uc815 \ubaa8\ub378\uacfc \ud14d\uc2a4\ucc98 \ud329\uc774 \uc778\uae30 \uc788\ub294 \uc774\uc720\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uacbd\ud5d8\uc744 \ud06c\uac8c \uac1c\uc778\ud654\ud560 \uc218 \uc788\ub294 \ubc29\ubc95\uc744 \uc81c\uacf5\ud558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \ud14d\uc2a4\ucc98 \ud329\uc740 \uc804\uccb4 \uc2dc\uac01\uc801 \ubbf8\ud559\uc744 \uac1c\uc120\ud558\uc5ec \uac8c\uc784\uc744 \ub354 \ud604\uc2e4\uc801\uc73c\ub85c \ubcf4\uc774\uac8c \ud558\uac70\ub098 \uc804\ud600 \ub2e4\ub978 \ud14c\ub9c8(\uc608: \ubbf8\ub798 \ub3c4\uc2dc\uc5d0\uc11c \uc911\uc138 \uc2dc\ub300\uae4c\uc9c0)\ub97c \uc81c\uacf5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc0ac\uc6a9\uc790 \uc9c0\uc815 \ubaa8\ub378\uc5d0\uc11c\ub294 \uc0c8\ub85c\uc6b4 \ubaa8\uc591\uacfc \ubb3c\uccb4\ub97c \ub3c4\uc785\ud558\uc5ec \uac74\ubb3c \uae30\ub2a5\uacfc \ucc3d\uc758\uc801\uc778 \ud45c\ud604\uc744 \ud06c\uac8c \ud655\uc7a5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc911\uc138 \ud14d\uc2a4\ucc98 \ud329\uc740 \uae30\ubcf8 \ube14\ub85d\uc744 \uc790\uac08\uacfc \ub098\ubb34\ub85c \ubc14\uafd4\uc11c \uac74\ubb3c\uc758 \uc804\uccb4 \ubd84\uc704\uae30\ub97c \ubc14\uafc0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc775\uc219\ud55c \uac8c\uc784\uc5d0 \ub300\ud55c \uc0c8\ub85c\uc6b4 \uad00\uc810\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}, {"question": "\uc7a5\uae30\uac04 \uc11c\ubc14\uc774\ubc8c \ubaa8\ub4dc \uac8c\uc784\uc5d0\uc11c \uc790\uc6d0 \uad00\ub9ac \ubc0f \uae30\uc9c0 \ubc29\uc5b4\uc5d0 \ucd5c\uc801\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc7a5\uae30\uac04 Bloxd.io \uc11c\ubc14\uc774\ubc8c \ubaa8\ub4dc\uc5d0\uc11c \ud6a8\uacfc\uc801\uc778 \uc790\uc6d0 \uad00\ub9ac \ubc0f \uae30\uc9c0 \ubc29\uc5b4\ub294 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. 1\ub2e8\uacc4: \ucd08\uae30\uc5d0\ub294 \uc7ac\uc0dd \uac00\ub2a5\ud55c \uc790\uc6d0(\ub098\ubb34, \ub18d\uc791\ubb3c)\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uc218\uc9d1\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \ubcbd, \ucc38\ud638, \ud568\uc815\uacfc \uac19\uc740 \ubc29\uc5b4 \uc2dc\uc124\uc744 \uae30\uc9c0 \uc8fc\ubcc0\uc5d0 \uad6c\ucd95\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \uc7a5\uce58\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc810\ucc28\uc801\uc73c\ub85c \uc790\uc6d0 \uc218\uc9d1\uc744 \uc790\ub3d9\ud654\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubc29\uc5b4\uc6a9 \uac74\ubb3c\uc744 \uc704\ud55c \uc790\ub3d9 \ub098\ubb34 \ub18d\uc7a5\uacfc \uc790\uac08 \uc0dd\uc131\uae30\ub97c \ub9cc\ub4ed\ub2c8\ub2e4. \ud655\uc7a5\ud560 \ud544\uc694\uc131\uacfc \uc790\uc6d0\uc744 \ud655\ubcf4\ud558\ub294 \uade0\ud615\uc740 \uac8c\uc784\uc5d0\uc11c \uc55e\uc11c \ub098\uac08 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4."}, {"question": "Bloxd.io\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4 \ub300 \ud50c\ub808\uc774\uc5b4(PvP) \uc804\ud22c \ud6a8\uc728\uc131\uc744 \uc9c0\ubc30\ud558\ub294 \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998(\uc608: \ud53c\ud574 \uacc4\uc0b0 \ubc0f \uc7a5\uac11 \uad00\ud1b5)\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Bloxd.io\uc758 PvP \uc804\ud22c \ud6a8\uc728\uc131\uc740 \uc5ec\ub7ec \uc694\uc778\uc5d0 \ub2ec\ub824 \uc788\uc2b5\ub2c8\ub2e4. \ud53c\ud574 \uacc4\uc0b0\uc740 \ubb34\uae30, \uc0c1\ub300\uc758 \uc7a5\uac11, \uce58\uba85\ud0c0\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4. \uc7a5\uac11 \uad00\ud1b5\uc740 \uc0c1\ub300\uc758 \uc7a5\uac11 \ud6a8\uacfc\ub97c \uc904\uc5ec \ub354 \ub9ce\uc740 \ud53c\ud574\uac00 \ud1b5\uacfc\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. \uce58\uba85\ud0c0\ub294 \uc785\ud788\ub294 \ud53c\ud574\ub97c \uacf1\ud569\ub2c8\ub2e4. \ub2e4\uc591\ud55c \ubb34\uae30-\uc7a5\uac11 \uc870\ud569\uc744 \uc2e4\ud5d8\ud558\uc5ec \ucd5c\uc801\uc758 \uc124\uc815\uc744 \ucc3e\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \ub9c8\uce58 \uc554\uc11d-\uc885\uc774-\uac00\uc704\uc640 \uac19\uc544\uc11c \ud2b9\uc815 \ubb34\uae30 \uc720\ud615\uc774 \ud2b9\uc815 \uc7a5\uac11 \uc720\ud615\uc5d0 \ub300\ud574 \ub354 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. \uc774\ub294 \ud2b9\uc815 \uc720\ud615\uc758 \ud50c\ub808\uc774\uc5b4\ub97c \uc0c1\ub300\ub85c \uc5b4\ub5a4 \ubb34\uae30\ub97c \uc0ac\uc6a9\ud574\uc57c \ud558\ub294\uc9c0 \uc774\ud574\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4. \uc5b4\ub5a4 \ubb34\uae30\uac00 \uc5b4\ub5a4 \uc7a5\uac11 \uc720\ud615\uc5d0 \ud6a8\uacfc\uc801\uc778\uc9c0 \ud30c\uc545\ud560 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Bloxd.io\ub294 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774\ub97c \uc5b4\ub5bb\uac8c \ucc98\ub9ac\ud558\uba70, \ube0c\ub77c\uc6b0\uc800 \ubc0f \ubaa8\ubc14\uc77c \ubc84\uc804 \uac04\uc5d0 \uc911\uc694\ud55c \ucc28\uc774\uc810(\uc788\ub294 \uacbd\uc6b0)\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Bloxd.io\ub294 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774\ub97c \uc81c\uacf5\ud560 \uc218\ub3c4 \uc788\uc9c0\ub9cc, \ud655\uc778\ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \ube0c\ub77c\uc6b0\uc800 \ubc0f \ubaa8\ubc14\uc77c \ubc84\uc804 \uac04\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc5d0\ub294 \uc81c\uc5b4 \ubc29\uc2dd(\ud0a4\ubcf4\ub4dc/\ub9c8\uc6b0\uc2a4 \ub300 \ud130\uce58), \uadf8\ub798\ud53d \uc124\uc815 \ubc0f \uc11c\ubc84 \uac00\uc6a9\uc131\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc740 \ub3d9\uc77c\ud558\uc9c0\ub9cc \uc0ac\uc6a9\uc790 \uacbd\ud5d8\uc740 \ud06c\uac8c \ub2e4\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubaa8\ubc14\uc77c \uc0ac\uc6a9\uc790\ub294 \uc791\uc740 \ud654\uba74 \ud06c\uae30\uc640 \ud130\uce58 \uc81c\uc5b4\ub85c \uc778\ud55c \uc7a0\uc7ac\uc801\uc778 \uc81c\ud55c \uc0ac\ud56d\uc744 \uc2e0\uc911\ud558\uac8c \uace0\ub824\ud574\uc57c \ud569\ub2c8\ub2e4. \ud2b9\ud788, \uc815\ud655\ud55c \ube14\ub85d \ubc30\uce58\uac00 \uc911\uc694\ud569\ub2c8\ub2e4. \ub2e4\uc74c\uc740 \ub450 \ud50c\ub7ab\ud3fc\uc758 \uac04\ub7b5\ud55c \ucc38\uc870\ud45c\uc785\ub2c8\ub2e4.\n\n| \uae30\ub2a5 | \ube0c\ub77c\uc6b0\uc800 | \ubaa8\ubc14\uc77c |\n|---|---|---|\n| \uc81c\uc5b4 | \ud0a4\ubcf4\ub4dc \ubc0f \ub9c8\uc6b0\uc2a4 | \ud130\uce58 |\n| \uadf8\ub798\ud53d \uc635\uc158 | \ub354 \uc138\ubd80\uc801\uc778 \ub0b4\uc6a9 | \uac04\uc18c\ud654\ub41c \ub0b4\uc6a9 |\n| \uc785\ub825 \uc815\ud655\ub3c4 | \ub192\uc74c | \ub0ae\uc74c |"}, {"question": "Bloxd.io\uc5d0\ub294 \uae30\uc874 \uc9c0\ub3c4 \ub0b4\uc5d0 \uc774\uc2a4\ud130 \uc5d0\uadf8 \ub610\ub294 \uc228\uaca8\uc9c4 \uc704\uce58\uac00 \uc788\uc2b5\ub2c8\uae4c? \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Bloxd.io\ub294 \uc9c0\uc18d\uc801\uc73c\ub85c \uc5c5\ub370\uc774\ud2b8\ub418\uace0 \uc788\uc73c\uba70, \uc774\ub7ec\ud55c \uc5c5\ub370\uc774\ud2b8\uc640 \ud568\uaed8 \uae30\uc874 \uc9c0\ub3c4 \ub0b4\uc5d0 \uc885\uc885 \uc774\uc2a4\ud130 \uc5d0\uadf8 \ub610\ub294 \uc228\uaca8\uc9c4 \uc704\uce58\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ud658\uacbd\uc758 \ubbf8\ubb18\ud55c \ubcc0\ud654\uc5d0 \uc8fc\uc758\ud558\uace0 \uc644\uc804\ud788 \ud0d0\uc0c9\ud558\ub294 \uac83\uc774 \ubc29\ubc95\uc785\ub2c8\ub2e4. \ud2b9\uc774\ud55c \uc18c\ub9ac\uc5d0 \uadc0 \uae30\uc6b8\uc774\uac70\ub098 \uc774\uc0c1\ud55c \ubb3c\uccb4\ub97c \ucc3e\uc73c\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc77c\ubd80 \uc9c0\ub3c4\uc5d0\ub294 \ube44\ubc00 \ud1b5\ub85c\ub97c \ud1b5\ud574 \uc811\uadfc\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ubc29\uc774 \uc788\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc73c\ub85c \uc774\uc2a4\ud130 \uc5d0\uadf8 \uc815\ubcf4\ub97c \ub2f4\uc740 \ud3ec\ub7fc \ubc0f \ube14\ub85c\uadf8 \uac8c\uc2dc\ubb3c\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uac00\uc0c1 \ubcf4\ubb3c \ucc3e\uae30\uc640 \uac19\uc774 \uc0dd\uac01\ud574\ubcf4\uc138\uc694!"}, {"question": "Bloxd.io\uc5d0\uc11c \ud604\uc2e4\uc801\uc778 \ubb3c\ub9ac\ud559\uc744 \uac00\uc9c4 \ubcf5\uc7a1\ud55c \uad6c\uc870 \ub514\uc790\uc778\uc744 \ub9cc\ub4dc\ub294 \uace0\uae09 \uac74\ucd95 \uae30\uc220\uc740 \ubb34\uc5c7\uc774\uba70, \uc219\ub828\ub41c \uac74\ucd95\uac00\uc5d0\uac8c \uc65c \uc911\uc694\ud55c\uac00\uc694?", "answer": "Bloxd.io\uc5d0\uc11c \ubcf5\uc7a1\ud55c \uad6c\uc870\ubb3c\uc744 \uad6c\ud604\ud558\ub294 \uace0\uae09 \uac74\ucd95 \uae30\uc220\uc740 \uac8c\uc784\uc758 \uc81c\ud55c\ub41c \ubb3c\ub9ac \ubaa8\ub378\uc744 \uc774\ud574\ud558\ub294 \ub370 \ub2ec\ub824 \uc788\uc2b5\ub2c8\ub2e4. \uc9c0\uc9c0 \uad6c\uc870\ub97c \uc0ac\uc6a9\ud558\uace0, \ube14\ub85d \uc758\uc874\uc131\uc744 \uc774\ud574\ud558\uba70, \ubb34\uac8c \ubd84\ubc30\ub97c \ub9cc\ub4dc\ub294 \uac83\uc740 \ud604\uc2e4\uc801\uc778 \ub514\uc790\uc778\uc744 \uc704\ud574 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc219\ub828\ub41c \uac74\ucd95\uac00\ub294 \uc774\ub7ec\ud55c \uae30\uc220\uc744 \uc6b0\uc120\uc2dc\ud569\ub2c8\ub2e4. \uc65c\ub0d0\ud558\uba74 \uc774\ub97c \ud1b5\ud574 \uac74\ucd95 \uac00\ub2a5\uc131\uc774 \uc5f4\ub9ac\uace0 \uc2e4\uc81c \uad6c\uc870\ub97c \uc7ac\ud604\ud558\uac70\ub098 \uc644\uc804\ud788 \uc0c8\ub85c\uc6b4 \ud658\uc0c1\uc801\uc778 \ub514\uc790\uc778\uc744 \uace0\uc548\ud560 \uc218 \uc788\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. Bloxd.io\uc5d0\uc11c \uc5d0\ud3a0\ud0d1\uc744 \uc7ac\ud604\ud558\ub294 \uac83\uc744 \uc0c1\uc0c1\ud574\ubcf4\uc138\uc694. \ubb34\uac8c \ubd84\ubc30 \uc6d0\uce59\uc744 \uc774\ud574\ud558\uace0 \uc801\uc808\ud55c \uc9c0\uc9c0 \ube14\ub85d\uc744 \uc0ac\uc6a9\ud558\ub294 \uac83\uc774 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uad6c\uc870\uc801\uc73c\ub85c \uc548\uc804\ud558\uace0 \ubbf8\uc801\uc73c\ub85c \ub9cc\uc871\uc2a4\ub7ec\uc6b4 \uac74\ubb3c\uc744 \ub9cc\ub4dc\ub294 \uac83\uc740 \uac74\ucd95\uac00\uc758 \uc804\ubb38\uc131\uc744 \ubcf4\uc5ec\uc8fc\ub294 \ud45c\uc2dc\uc785\ub2c8\ub2e4."}]
[{"question": "Bloxd.io\uff1a\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u8fdb\u884c\u57fa\u672c\u79fb\u52a8\u548c\u4e0e\u65b9\u5757\u4e92\u52a8\uff1f", "answer": "\u5728 Bloxd.io \u4e2d\uff0c\u65b0\u624b\u73a9\u5bb6\u4e3b\u8981\u4f7f\u7528 WASD \u952e\u8fdb\u884c\u79fb\u52a8\uff1aW \u952e\u5411\u524d\u79fb\u52a8\uff0cA \u952e\u5411\u5de6\u79fb\u52a8\uff0cS \u952e\u5411\u540e\u79fb\u52a8\uff0cD \u952e\u5411\u53f3\u79fb\u52a8\u3002\u7a7a\u683c\u952e\u7528\u4e8e\u8df3\u8dc3\u3002\u8981\u4e0e\u65b9\u5757\u4e92\u52a8\uff0c\u8bf7\u5de6\u952e\u5355\u51fb\u4ee5\u7834\u574f\u5b83\u4eec\uff0c\u53f3\u952e\u5355\u51fb\u4ee5\u653e\u7f6e\u65b9\u5757\u3002\u4f8b\u5982\uff0c\u5728\u521b\u9020\u6a21\u5f0f\u4e2d\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u4ece\u5e93\u5b58\u4e2d\u53f3\u952e\u5355\u51fb\u65b9\u5757\u7acb\u5373\u5efa\u9020\u4e00\u4e2a\u907f\u96be\u6240\u3002\u8bf7\u8bb0\u5f97\u5728\u8bbe\u7f6e\u4e2d\u68c0\u67e5\u60a8\u7684\u6309\u952e\u7ed1\u5b9a\u4ee5\u8fdb\u884c\u5b9a\u5236\u3002\u53ef\u4ee5\u628a\u5b83\u60f3\u8c61\u6210\u5b66\u4e60\u8d70\u8def\u624d\u80fd\u8dd1\u8d77\u6765\u2014\u2014\u638c\u63e1\u8fd9\u4e9b\u57fa\u672c\u63a7\u5236\u53ef\u4ee5\u89e3\u9501\u6e38\u620f\u4e2d\u65e0\u9650\u7684\u53ef\u80fd\u6027\u3002\u4e3a\u4e86\u8ba9\u8fd9\u4e2a\u8fc7\u7a0b\u66f4\u5bb9\u6613\uff0c\u60a8\u53ef\u4ee5\u67e5\u770b\u4e0b\u9762\u7684\u8868\u683c\n\n| \u64cd\u4f5c | \u952e |\n|---|---| \n| \u524d\u8fdb | W |\n| \u5411\u5de6 | A |\n| \u5411\u540e | S |\n| \u5411\u53f3 | D |\n| \u8df3\u8dc3 | \u7a7a\u683c\u952e |\n| \u7834\u574f\u65b9\u5757 | \u5de6\u952e\u5355\u51fb |\n| \u653e\u7f6e\u65b9\u5757 | \u53f3\u952e\u5355\u51fb|"}, {"question": "Bloxd.io \u4e2d\u6709\u54ea\u4e9b\u4e0d\u540c\u7684\u6e38\u620f\u6a21\u5f0f\uff0c\u54ea\u79cd\u6a21\u5f0f\u6700\u9002\u5408\u521d\u5b66\u8005\u5b66\u4e60\u6e38\u620f\uff1f", "answer": "Bloxd.io \u63d0\u4f9b\u4e86\u51e0\u79cd\u6e38\u620f\u6a21\u5f0f\uff0c\u5305\u62ec\u521b\u9020\u6a21\u5f0f\u3001\u751f\u5b58\u6a21\u5f0f\u3001\u548c\u5e73\u6a21\u5f0f\u7b49\u7b49\u3002\u5bf9\u4e8e\u521d\u5b66\u8005\u6765\u8bf4\uff0c\"\u521b\u9020\" \u6a21\u5f0f\u975e\u5e38\u63a8\u8350\u3002\u5728\u521b\u9020\u6a21\u5f0f\u4e2d\uff0c\u60a8\u62e5\u6709\u65e0\u9650\u7684\u8d44\u6e90\uff0c\u5e76\u4e14\u4e0d\u4f1a\u53d7\u5230\u4f24\u5bb3\uff0c\u56e0\u6b64\u60a8\u53ef\u4ee5\u81ea\u7531\u5730\u5c1d\u8bd5\u6784\u5efa\u548c\u63a2\u7d22\u6e38\u620f\u673a\u5236\u3002\u4f8b\u5982\uff0c\u60a8\u53ef\u4ee5\u4ece\u7b80\u5355\u5730\u5efa\u9020\u623f\u5c4b\u5f00\u59cb\uff0c\u800c\u4e0d\u5fc5\u62c5\u5fc3\u6536\u96c6\u6750\u6599\u6216\u5904\u7406\u654c\u4eba\u3002\u8fd9\u6d88\u9664\u4e86\u65e9\u671f\u7684\u632b\u8d25\u611f\uff0c\u5e76\u8ba9\u60a8\u4e13\u6ce8\u4e8e\u5b66\u4e60\u57fa\u672c\u673a\u5236\u7684\u5de5\u4f5c\u539f\u7406\u3002\u8fd9\u4e2a\u6a21\u5f0f\u7c7b\u4f3c\u4e8e\u4e00\u4e2a\u5f00\u653e\u5f0f\u7684\u6c99\u76d2\uff0c\u62e5\u6709\u65e0\u9650\u7684\u4e50\u9ad8\u79ef\u6728\u3002"}, {"question": "Bloxd.io \u6301\u7eed\u5361\u987f\uff01\u6211\u53ef\u4ee5\u5728\u4f4e\u7aef\u7535\u8111\u4e0a\u5982\u4f55\u63d0\u9ad8 Bloxd.io \u7684\u6027\u80fd\uff1f", "answer": "\u5728 Bloxd.io \u4e2d\u9047\u5230\u5361\u987f\u53ef\u80fd\u4f1a\u8ba9\u4eba\u5f88\u6cae\u4e27\u3002\u4ee5\u4e0b\u662f\u5982\u4f55\u5728\u4f4e\u7aef PC \u4e0a\u63d0\u9ad8\u6027\u80fd\u7684\u65b9\u6cd5\uff1a\u9996\u5148\uff0c\u5728\u6e38\u620f\u83dc\u5355\uff08\u9009\u9879 -> \u56fe\u5f62\uff09\u4e2d\u964d\u4f4e\u56fe\u5f62\u8bbe\u7f6e\u3002\u7279\u522b\u662f\u964d\u4f4e\u6e32\u67d3\u8ddd\u79bb\u4f1a\u5f88\u6709\u5e2e\u52a9\u3002\u63a5\u4e0b\u6765\uff0c\u5173\u95ed\u4e0d\u5fc5\u8981\u7684\u540e\u53f0\u5e94\u7528\u7a0b\u5e8f\u4ee5\u91ca\u653e\u7cfb\u7edf\u8d44\u6e90\u3002\u6700\u540e\uff0c\u5c1d\u8bd5\u5728\u4eba\u6d41\u91cf\u8f83\u5c11\u7684\u670d\u52a1\u5668\u4e2d\u73a9\u6e38\u620f\uff0c\u56e0\u4e3a\u73a9\u5bb6\u6570\u91cf\u591a\u4f1a\u589e\u52a0\u7cfb\u7edf\u8d1f\u62c5\u3002\u4ece\u672c\u8d28\u4e0a\u8bb2\uff0c\u964d\u4f4e\u89c6\u89c9\u9700\u6c42\u5e76\u91ca\u653e\u5904\u7406\u80fd\u529b\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u54cd\u5e94\u901f\u5ea6\u3002"}, {"question": "Bloxd.io \u4e2d\u7684\u5730\u5f62\u6539\u9020\u662f\u5982\u4f55\u5de5\u4f5c\u7684\uff0c\u4ee5\u53ca\u5851\u9020\u666f\u89c2\u7684\u4e00\u4e9b\u9ad8\u7ea7\u6280\u5de7\u662f\u4ec0\u4e48\uff1f", "answer": "Bloxd.io \u4e2d\u7684\u5730\u5f62\u6539\u9020\u5305\u62ec\u4f7f\u7528\u5de5\u5177\u548c\u65b9\u5757\u91cd\u5851\u73b0\u6709\u5730\u5f62\u3002\u9ad8\u7ea7\u6280\u5de7\u5305\u62ec\u901a\u8fc7\u4ed4\u7ec6\u653e\u7f6e\u4e0d\u540c\u9ad8\u5ea6\u7684\u65b9\u5757\u6765\u521b\u5efa\u5e73\u6ed1\u7684\u659c\u5761\uff0c\u4f7f\u7528\u6316\u6398\u5de5\u5177\u8bbe\u8ba1\u590d\u6742\u7684\u96a7\u9053\u7cfb\u7edf\uff0c\u4ee5\u53ca\u5229\u7528\u6c34\u6765\u521b\u5efa\u81ea\u7136\u6e56\u6cca\u548c\u6cb3\u6d41\u3002\u4f8b\u5982\uff0c\u60a8\u53ef\u4ee5\u5148\u5c06\u4e00\u4e2a\u5927\u533a\u57df\u53d8\u5e73\uff0c\u7136\u540e\u4f7f\u7528\u659c\u5761\u6765\u521b\u5efa\u4e00\u4e2a\u68af\u5f62\u82b1\u56ed\u3002\u9ad8\u7ea7\u5730\u5f62\u6539\u9020\u5c31\u50cf\u865a\u62df\u666f\u89c2\u8bbe\u8ba1\uff0c\u9010\u5757\u6784\u5efa\u98ce\u666f\u4f18\u7f8e\u7684\u666f\u8272\u3002\u8fd9\u4e9b\u9700\u8981\u65f6\u95f4\u548c\u8010\u5fc3\uff01\n\n\u6b65\u9aa4 1\uff1a\u8ba1\u5212\u60a8\u7684\u8bbe\u8ba1\u3002\u5982\u6709\u5fc5\u8981\uff0c\u8bf7\u5c06\u5176\u7ed8\u5236\u51fa\u6765\u3002\n\u6b65\u9aa4 2\uff1a\u4f7f\u7528\u5e73\u6574\u5de5\u5177\u521b\u5efa\u57fa\u7840\u3002\n\u6b65\u9aa4 3\uff1a\u4f7f\u7528\u659c\u5761\u548c\u6c34\u8fdb\u884c\u96d5\u523b\u3002"}, {"question": "\u4e3a\u4ec0\u4e48 Bloxd.io \u4e2d\u7684\u81ea\u5b9a\u4e49\u6a21\u578b\u548c\u7eb9\u7406\u5305\u5982\u6b64\u53d7\u6b22\u8fce\uff0c\u4ee5\u53ca\u5b83\u4eec\u5982\u4f55\u80fd\u591f\u6781\u5927\u5730\u6539\u53d8\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "Bloxd.io \u4e2d\u7684\u81ea\u5b9a\u4e49\u6a21\u578b\u548c\u7eb9\u7406\u5305\u53d7\u6b22\u8fce\u662f\u56e0\u4e3a\u5b83\u4eec\u4e3a\u73a9\u5bb6\u63d0\u4f9b\u4e86\u4e00\u79cd\u6781\u5927\u5730\u4e2a\u6027\u5316\u6e38\u620f\u4f53\u9a8c\u7684\u65b9\u5f0f\u3002\u7eb9\u7406\u5305\u53ef\u4ee5\u5f7b\u5e95\u6539\u53d8\u6574\u4e2a\u89c6\u89c9\u7f8e\u611f\uff0c\u8ba9\u6e38\u620f\u770b\u8d77\u6765\u66f4\u903c\u771f\uff0c\u6216\u8005\u8d4b\u4e88\u5b83\u5b8c\u5168\u4e0d\u540c\u7684\u4e3b\u9898\u2014\u2014\u4ece\u672a\u6765\u6d3e\u5230\u4e2d\u4e16\u7eaa\u3002\u81ea\u5b9a\u4e49\u6a21\u578b\u5141\u8bb8\u5f15\u5165\u65b0\u7684\u5f62\u72b6\u548c\u7269\u4f53\uff0c\u663e\u7740\u6269\u5c55\u6784\u5efa\u80fd\u529b\u548c\u521b\u9020\u529b\u8868\u8fbe\u3002\u4f8b\u5982\uff0c\u4e00\u4e2a\u4e2d\u4e16\u7eaa\u7eb9\u7406\u5305\u53ef\u4ee5\u5c06\u9ed8\u8ba4\u65b9\u5757\u53d8\u6210\u9e45\u5375\u77f3\u548c\u6728\u6750\uff0c\u4ece\u800c\u5b8c\u5168\u6539\u53d8\u60a8\u6784\u5efa\u7684\u6574\u4f53\u611f\u89c9\u3002\u5b83\u4e3a\u4e00\u4e2a\u719f\u6089\u7684\u6e38\u63d0\u4f9b\u4e86\u4e00\u4e2a\u65b0\u7684\u89c6\u89d2\u3002"}, {"question": "Bloxd.io \u957f\u671f\u751f\u5b58\u6a21\u5f0f\u4e2d\u6709\u6548\u7684\u8d44\u6e90\u7ba1\u7406\u548c\u57fa\u5730\u9632\u5fa1\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728 Bloxd.io \u7684\u957f\u671f\u751f\u5b58\u6a21\u5f0f\u4e2d\uff0c\u6709\u6548\u7684\u8d44\u6e90\u7ba1\u7406\u548c\u57fa\u5730\u9632\u5fa1\u81f3\u5173\u91cd\u8981\u3002\u6b65\u9aa4 1\uff1a\u4f18\u5148\u5728\u65e9\u671f\u6536\u96c6\u53ef\u518d\u751f\u8d44\u6e90\uff08\u6728\u6750\u3001\u519c\u4f5c\u7269\uff09\u3002\u6b65\u9aa4 2\uff1a\u5728\u60a8\u7684\u57fa\u5730\u5468\u56f4\u5efa\u9020\u9632\u5fa1\u5de5\u4e8b\uff0c\u4f8b\u5982\u5899\u58c1\u3001\u58d5\u6c9f\u548c\u9677\u9631\u3002\u6b65\u9aa4 3\uff1a\u9010\u6b65\u4f7f\u7528\u88c5\u7f6e\u81ea\u52a8\u5316\u8d44\u6e90\u6536\u96c6\u3002\u4f8b\u5982\uff0c\u521b\u5efa\u914d\u6709\u9e45\u5375\u77f3\u53d1\u751f\u5668\u7684\u81ea\u52a8\u6811\u6728\u519c\u573a\uff0c\u7528\u4e8e\u9632\u5fa1\u5efa\u7b51\u3002\u5e73\u8861\u6269\u5f20\u9700\u6c42\u4e0e\u4fdd\u969c\u8d44\u6e90\u9700\u6c42\uff0c\u8ba9\u60a8\u5728\u6e38\u620f\u4e2d\u4fdd\u6301\u9886\u5148\u3002"}, {"question": "\u54ea\u4e9b\u57fa\u672c\u673a\u5236\u63a7\u5236\u7740 Bloxd.io \u4e2d\u73a9\u5bb6\u5bf9\u73a9\u5bb6 (PvP) \u6218\u6597\u7684\u6709\u6548\u6027\uff0c\u4f8b\u5982\u4f24\u5bb3\u8ba1\u7b97\u548c\u62a4\u7532\u7a7f\u900f\uff1f", "answer": "Bloxd.io \u4e2d\u7684 PvP \u6218\u6597\u6709\u6548\u6027\u4f9d\u8d56\u4e8e\u591a\u79cd\u56e0\u7d20\u3002\u4f24\u5bb3\u8ba1\u7b97\u53d6\u51b3\u4e8e\u60a8\u7684\u6b66\u5668\u3001\u76ee\u6807\u7684\u62a4\u7532\u548c\u7206\u51fb\u3002\u62a4\u7532\u7a7f\u900f\u964d\u4f4e\u4e86\u5bf9\u624b\u62a4\u7532\u7684\u6709\u6548\u6027\uff0c\u4ece\u800c\u5141\u8bb8\u66f4\u591a\u7684\u4f24\u5bb3\u7a7f\u900f\u3002\u7206\u51fb\u4f1a\u4f7f\u9020\u6210\u7684\u4f24\u5bb3\u6210\u500d\u589e\u52a0\u3002\u5c1d\u8bd5\u4e0d\u540c\u7684\u6b66\u5668\u2014\u62a4\u7532\u7ec4\u5408\u5bf9\u4e8e\u627e\u5230\u6700\u4f73\u8bbe\u7f6e\u81f3\u5173\u91cd\u8981\u3002\u53ef\u4ee5\u628a\u5b83\u60f3\u8c61\u6210\u77f3\u5934-\u526a\u5200-\u5e03\uff0c\u67d0\u4e9b\u6b66\u5668\u7c7b\u578b\u5bf9\u6297\u7279\u5b9a\u62a4\u7532\u7c7b\u578b\u66f4\u6709\u6548\u3002\u8fd9\u5c06\u5e2e\u52a9\u4f60\u4e86\u89e3\u5e94\u8be5\u4f7f\u7528\u4ec0\u4e48\u6b66\u5668\u5bf9\u6297\u4e0d\u540c\u7c7b\u578b\u7684\u73a9\u5bb6\u3002\u4f60\u751a\u81f3\u53ef\u4ee5\u786e\u5b9a\u4f60\u9700\u8981\u4ec0\u4e48\u62a4\u7532\u624d\u80fd\u627f\u53d7\u67d0\u4e9b\u653b\u51fb\u3002"}, {"question": "Bloxd.io \u5982\u4f55\u5904\u7406\u8de8\u5e73\u53f0\u6e38\u620f\uff0c\u6d4f\u89c8\u5668\u7248\u548c\u79fb\u52a8\u7248\u4e4b\u95f4\u662f\u5426\u5b58\u5728\u5173\u952e\u5dee\u5f02\uff1f", "answer": "Bloxd.io \u53ef\u80fd\u63d0\u4f9b\u8de8\u5e73\u53f0\u6e38\u620f\uff0c\u4f46\u8fd9\u9700\u8981\u9a8c\u8bc1\u3002\u6d4f\u89c8\u5668\u7248\u548c\u79fb\u52a8\u7248\u4e4b\u95f4\u7684\u5173\u952e\u5dee\u5f02\u901a\u5e38\u5305\u62ec\u63a7\u5236\u65b9\u6848\uff08\u952e\u76d8/\u9f20\u6807\u4e0e\u89e6\u6478\uff09\u3001\u56fe\u5f62\u8bbe\u7f6e\u4ee5\u53ca\u6f5c\u5728\u7684\u670d\u52a1\u5668\u53ef\u7528\u6027\u3002\u867d\u7136\u6e38\u620f\u673a\u5236\u4fdd\u6301\u4e0d\u53d8\uff0c\u4f46\u7528\u6237\u4f53\u9a8c\u53ef\u80fd\u4f1a\u5b58\u5728\u5f88\u5927\u5dee\u5f02\u3002\u79fb\u52a8\u7528\u6237\u5e94\u8be5\u4ed4\u7ec6\u8003\u8651\u7531\u4e8e\u5c4f\u5e55\u5c3a\u5bf8\u8f83\u5c0f\u548c\u89e6\u6478\u63a7\u5236\u800c\u53ef\u80fd\u5b58\u5728\u7684\u9650\u5236\uff0c\u7279\u522b\u662f\u7531\u4e8e\u7cbe\u786e\u7684\u65b9\u5757\u653e\u7f6e\u5bf9\u4e8e\u79fb\u52a8\u7248\u81f3\u5173\u91cd\u8981\u3002\u4ee5\u4e0b\u662f\u4e00\u4efd\u5feb\u901f\u53c2\u8003\u8868\uff0c\u4f9b\u4e24\u6b3e\u5e73\u53f0\u53c2\u8003\uff1a\n\n| \u7279\u6027 | \u6d4f\u89c8\u5668 | \u79fb\u52a8\u7aef |\n|---|---|---|\n| \u63a7\u5236 | \u952e\u76d8\u548c\u9f20\u6807 | \u89e6\u63a7 |\n| \u56fe\u5f62\u9009\u9879 | \u66f4\u8be6\u7ec6 | \u7b80\u5316 |\n| \u8f93\u5165\u7cbe\u5ea6 | \u9ad8 | \u4f4e |"}, {"question": "Bloxd.io \u7684\u73b0\u6709\u5730\u56fe\u4e2d\u662f\u5426\u5b58\u5728\u4efb\u4f55\u5f69\u86cb\u6216\u9690\u85cf\u4f4d\u7f6e\uff0c\u73a9\u5bb6\u5982\u4f55\u53d1\u73b0\u5b83\u4eec\uff1f", "answer": "Bloxd.io \u662f\u4e00\u6b3e\u4e0d\u65ad\u66f4\u65b0\u7684\u6e38\u620f\uff0c\u6bcf\u6b21\u66f4\u65b0\u540e\uff0c\u73b0\u6709\u5730\u56fe\u4e2d\u901a\u5e38\u90fd\u4f1a\u51fa\u73b0\u5f69\u86cb\u6216\u9690\u85cf\u4f4d\u7f6e\u3002\u5f7b\u5e95\u63a2\u7d22\u5e76\u6ce8\u610f\u73af\u5883\u4e2d\u7684\u7ec6\u5fae\u53d8\u5316\uff0c\u5c31\u662f\u627e\u5230\u5b83\u4eec\u7684\u65b9\u6cd5\u3002\u503e\u542c\u4e0d\u5bfb\u5e38\u7684\u58f0\u97f3\uff0c\u5bfb\u627e\u4f4d\u7f6e\u4e0d\u534f\u8c03\u7684\u7269\u4f53\u3002\u4f8b\u5982\uff0c\u67d0\u4e9b\u5730\u56fe\u53ef\u80fd\u5305\u542b\u901a\u8fc7\u79d8\u5bc6\u901a\u9053\u8fdb\u5165\u7684\u9690\u85cf\u623f\u95f4\u3002\u901a\u5e38\u5728\u8bba\u575b\u548c\u535a\u5ba2\u6587\u7ae0\u4e2d\u4f1a\u53d1\u5e03\u6709\u5173\u4efb\u4f55\u5f69\u86cb\u7684\u4fe1\u606f\u3002\u628a\u5b83\u5f53\u6210\u865a\u62df\u5bfb\u5b9d\u6e38\u620f\u5427\uff01"}, {"question": "Bloxd.io \u4e2d\u54ea\u4e9b\u9ad8\u7ea7\u5efa\u7b51\u6280\u672f\u5141\u8bb8\u521b\u5efa\u5177\u6709\u903c\u771f\u7269\u7406\u6548\u679c\u7684\u590d\u6742\u7ed3\u6784\u8bbe\u8ba1\uff0c\u4e3a\u4ec0\u4e48\u5b83\u4eec\u5bf9\u7ecf\u9a8c\u4e30\u5bcc\u7684\u5efa\u7b51\u5e08\u5f88\u91cd\u8981\uff1f", "answer": "Bloxd.io \u4e2d\u5b9e\u73b0\u590d\u6742\u7ed3\u6784\u7684\u9ad8\u7ea7\u5efa\u7b51\u6280\u672f\u4f9d\u8d56\u4e8e\u7406\u89e3\u6e38\u620f\u7684\u6709\u9650\u7269\u7406\u6a21\u578b\u3002\u4f7f\u7528\u652f\u6491\u7ed3\u6784\uff0c\u7406\u89e3\u65b9\u5757\u4f9d\u8d56\u5173\u7cfb\u4ee5\u53ca\u521b\u5efa\u91cd\u91cf\u5206\u5e03\u5bf9\u4e8e\u770b\u8d77\u6765\u903c\u771f\u7684\u8bbe\u8ba1\u81f3\u5173\u91cd\u8981\u3002\u7ecf\u9a8c\u4e30\u5bcc\u7684\u5efa\u7b51\u5e08\u4f18\u5148\u8003\u8651\u8fd9\u4e9b\u6280\u672f\uff0c\u56e0\u4e3a\u5b83\u4eec\u53ef\u4ee5\u89e3\u9501\u5efa\u7b51\u53ef\u80fd\u6027\uff0c\u5141\u8bb8\u4ed6\u4eec\u91cd\u5efa\u73b0\u5b9e\u4e16\u754c\u7684\u7ed3\u6784\u6216\u53d1\u660e\u5b8c\u5168\u5168\u65b0\u7684\u5947\u5e7b\u8bbe\u8ba1\u3002\u60f3\u8c61\u4e00\u4e0b\u5728 Bloxd.io \u4e2d\u91cd\u5efa\u57c3\u83f2\u5c14\u94c1\u5854\u2014\u2014\u7406\u89e3\u91cd\u91cf\u5206\u5e03\u7684\u539f\u7406\u4ee5\u53ca\u4f7f\u7528\u5408\u9002\u7684\u652f\u6491\u65b9\u5757\u5c06\u81f3\u5173\u91cd\u8981\u3002\u521b\u5efa\u7ed3\u6784\u7a33\u56fa\u4e14\u7f8e\u89c2\u7684\u5efa\u7b51\u662f\u5efa\u7b51\u5e08\u4e13\u4e1a\u6280\u80fd\u7684\u6807\u5fd7\u3002"}]
[{"question": "Can Your Pet!\u3092\u521d\u3081\u3066\u30d7\u30ec\u30a4\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Can Your Pet!\u3092\u30d7\u30ec\u30a4\u3059\u308b\u306b\u306f\u3001\u307e\u305a\u304a\u597d\u307f\u306e\u30a2\u30d7\u30ea\u30b9\u30c8\u30a2\u304b\u3089\u30b2\u30fc\u30e0\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u5f8c\u3001\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\u3092\u4f5c\u6210\u3057\u3001\u6700\u521d\u306e\u30da\u30c3\u30c8\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306f\u3001\u990c\u3084\u308a\u3084\u904a\u3073\u306a\u3069\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u6848\u5185\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30da\u30c3\u30c8\u306b\u990c\u3092\u3042\u3052\u308b\u306b\u306f\u3001\u990c\u306e\u30a2\u30a4\u30b3\u30f3\u3092\u30bf\u30c3\u30d7\u3057\u307e\u3059\u3002\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3092\u4f7f\u3063\u3066\u3001\u91cd\u8981\u306a\u30b3\u30de\u30f3\u30c9\u3084\u30b8\u30a7\u30b9\u30c1\u30e3\u30fc\u3092\u5b66\u3073\u307e\u3059\u3002"}, {"question": "Can Your Pet!\u3067100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u3059\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Can Your Pet!\u3067100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u52b9\u7387\u7684\u306b\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u3059\u308b\u305f\u3081\u306e\u9ad8\u5ea6\u306a\u6226\u7565\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff11\uff1a\u30dc\u30fc\u30ca\u30b9XP\u3092\u5f97\u308b\u305f\u3081\u306b\u6bce\u65e5\u306e\u8ab2\u984c\u3092\u5b8c\u4e86\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff12\uff1a\u9ad8\u5831\u916c\u3092\u63d0\u4f9b\u3059\u308b\u30df\u30cb\u30b2\u30fc\u30e0\u306b\u53c2\u52a0\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff13\uff1a\u91cd\u8981\u306a\u30bf\u30b9\u30af\u4e2d\u306b\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u990c\u3084\u308a\u30bb\u30c3\u30b7\u30e7\u30f3\u4e2d\u306b\u300c\u30c0\u30d6\u30ebXP\u300d\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u5927\u5e45\u306b\u9032\u6b69\u3067\u304d\u307e\u3059\u3002\u3055\u307e\u3056\u307e\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u6bd4\u8f03\u3057\u3066\u3001\u52b9\u7387\u3092\u6700\u5927\u5316\u3057\u307e\u3059\u3002"}, {"question": "\u306a\u305cCan Your Pet!\u306f\u72ec\u81ea\u306e\u30da\u30c3\u30c8\u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3\u30b7\u30b9\u30c6\u30e0\u3092\u6301\u3064\u306e\u3067\u3059\u304b\uff1f", "answer": "Can Your Pet!\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30a8\u30f3\u30b2\u30fc\u30b8\u30e1\u30f3\u30c8\u3092\u9ad8\u3081\u308b\u305f\u3081\u306e\u72ec\u81ea\u306e\u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3\u30b7\u30b9\u30c6\u30e0\u3092\u5099\u3048\u3066\u3044\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u884c\u52d5\u306b\u57fa\u3065\u3044\u3066\u30da\u30c3\u30c8\u306e\u884c\u52d5\u3092AI\u3067\u8abf\u6574\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u983b\u7e41\u306b\u30ad\u30e3\u30c3\u30c1\u30b6\u30dc\u30fc\u30eb\u3092\u30d7\u30ec\u30a4\u3059\u308b\u3068\u3001\u30da\u30c3\u30c8\u304c\u3088\u308a\u983b\u7e41\u306b\u305d\u306e\u30b2\u30fc\u30e0\u3092\u958b\u59cb\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u306e\u30c0\u30a4\u30ca\u30df\u30c3\u30af\u306a\u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3\u306b\u3088\u308a\u3001\u3088\u308a\u6ca1\u5165\u578b\u3067\u30d1\u30fc\u30bd\u30ca\u30e9\u30a4\u30ba\u3055\u308c\u305f\u7d4c\u9a13\u304c\u751f\u307e\u308c\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u73fe\u5b9f\u306e\u30da\u30c3\u30c8\u306e\u98fc\u3044\u65b9\u3092\u30b7\u30df\u30e5\u30ec\u30fc\u30c8\u3059\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002"}, {"question": "Can Your Pet!\u3067\u6700\u3082\u5831\u916c\u306e\u9ad8\u3044\u30a4\u30f3\u30b2\u30fc\u30e0\u30a4\u30d9\u30f3\u30c8\u306f\u3069\u308c\u3067\u3059\u304b\uff1f", "answer": "Can Your Pet! \u3067\u306f\u3001\u5b63\u7bc0\u306e\u30a4\u30d9\u30f3\u30c8\u3068\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u30c1\u30e3\u30ec\u30f3\u30b8\u304c\u6700\u3082\u5831\u916c\u306e\u9ad8\u3044\u30a4\u30d9\u30f3\u30c8\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30a6\u30a3\u30f3\u30bf\u30fc\u30d5\u30a7\u30b9\u30c6\u30a3\u30d0\u30eb\u300d\u30a4\u30d9\u30f3\u30c8\u306f\u3001\u9650\u5b9a\u30a2\u30a4\u30c6\u30e0\u3068\u9ad8\u3044XP\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u7a4d\u6975\u7684\u306b\u53c2\u52a0\u3057\u3001\u30a4\u30d9\u30f3\u30c8\u5c02\u7528\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u4f7f\u3063\u3066\u5229\u76ca\u3092\u6700\u5927\u5316\u3057\u307e\u3059\u3002\u30a4\u30d9\u30f3\u30c8\u30b9\u30b1\u30b8\u30e5\u30fc\u30eb\u3092\u6bd4\u8f03\u3057\u3066\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u52b9\u679c\u7684\u306b\u8a08\u753b\u3057\u307e\u3059\u3002"}, {"question": "Can Your Pet!\u306e\u30c7\u30fc\u30bf\u3092\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u79fb\u884c\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Can Your Pet!\u306e\u30c7\u30fc\u30bf\u3092\u79fb\u884c\u3059\u308b\u306b\u306f\u3001\u30ea\u30f3\u30af\u3055\u308c\u305f\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u6301\u3063\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff11\uff1a\u8a2d\u5b9a\u306b\u79fb\u52d5\u3057\u3001\u300c\u30a2\u30ab\u30a6\u30f3\u30c8\u300d\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff12\uff1a\u30b2\u30fc\u30e0\u3092\u30e1\u30fc\u30eb\u307e\u305f\u306f\u30bd\u30fc\u30b7\u30e3\u30eb\u30e1\u30c7\u30a3\u30a2\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ea\u30f3\u30af\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff13\uff1a\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u30b2\u30fc\u30e0\u3092\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u3001\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u3067\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u3042\u306a\u305f\u306e\u9032\u6357\u72b6\u6cc1\u306f\u81ea\u52d5\u7684\u306b\u540c\u671f\u3055\u308c\u307e\u3059\u3002\u8a2d\u5b9a\u8868\u3092\u4f7f\u7528\u3057\u3066\u3001\u30ea\u30f3\u30af\u3055\u308c\u305f\u30a2\u30ab\u30a6\u30f3\u30c8\u306e\u72b6\u614b\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u74b0\u5883\u3092\u63a2\u691c\u3059\u308b\u3053\u3068\u3067Can Your Pet!\u3067\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Can Your Pet!\u306e\u74b0\u5883\u3092\u63a2\u691c\u3059\u308b\u3053\u3068\u3067\u3001\u79d8\u5bc6\u306e\u30df\u30cb\u30b2\u30fc\u30e0\u3084\u30ec\u30a2\u30a2\u30a4\u30c6\u30e0\u306a\u3069\u306e\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u516c\u5712\u306b\u3042\u308b\u7279\u5b9a\u306e\u6728\u3092\u30bf\u30c3\u30d7\u3059\u308b\u3068\u3001\u96a0\u3055\u308c\u305f\u30ad\u30e3\u30c3\u30c1\u30b6\u30dc\u30fc\u30eb\u30b2\u30fc\u30e0\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u3053\u308c\u3089\u306e\u6a5f\u80fd\u306f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5145\u5b9f\u3055\u305b\u3001\u30e6\u30cb\u30fc\u30af\u306a\u5831\u916c\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u4f7f\u7528\u3057\u3066\u3001\u767a\u898b\u3055\u308c\u305f\u6a5f\u80fd\u3068\u305d\u306e\u5834\u6240\u3092\u8ffd\u8de1\u3057\u307e\u3059\u3002"}, {"question": "Can Your Pet!\u306e\u990c\u3084\u308a\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u30da\u30c3\u30c8\u306e\u6210\u9577\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "Can Your Pet!\u306e\u990c\u30
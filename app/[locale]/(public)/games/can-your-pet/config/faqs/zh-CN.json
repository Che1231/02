[{"question": "\u5982\u4f55\u4f5c\u4e3a\u65b0\u624b\u5f00\u59cb\u73a9\u5ba0\u7269\u517b\u6210\u6e38\u620fCan Your Pet\uff1f", "answer": "\u8981\u5f00\u59cb\u73a9Can Your Pet\uff0c\u9996\u5148\u9700\u8981\u4ece\u4f60\u559c\u6b22\u7684\u5e94\u7528\u5546\u5e97\u4e0b\u8f7d\u6e38\u620f\u3002\u5b89\u88c5\u540e\uff0c\u521b\u5efa\u4e2a\u4eba\u8d44\u6599\u5e76\u9009\u62e9\u4f60\u7684\u7b2c\u4e00\u53ea\u5ba0\u7269\u3002\u6e38\u620f\u5c06\u6307\u5bfc\u4f60\u5b8c\u6210\u57fa\u672c\u7684\u4e92\u52a8\uff0c\u4f8b\u5982\u5582\u98df\u548c\u73a9\u800d\u3002\u4f8b\u5982\uff0c\u70b9\u51fb\u98df\u7269\u56fe\u6807\u6765\u5582\u517b\u4f60\u7684\u5ba0\u7269\u3002\u4f7f\u7528\u6559\u7a0b\u5b66\u4e60\u5fc5\u8981\u7684\u547d\u4ee4\u548c\u624b\u52bf\u3002"}, {"question": "\u5728\u73a9\u4e86100\u4e2a\u5c0f\u65f6\u540e\uff0cCan Your Pet\u4e2d\u63d0\u5347\u7b49\u7ea7\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728Can Your Pet\u6e38\u620f\u4e2d\u73a9\u4e86100\u4e2a\u5c0f\u65f6\u540e\uff0c\u4e13\u6ce8\u4e8e\u9ad8\u7ea7\u7b56\u7565\u4ee5\u63d0\u9ad8\u6548\u7387\u3002\u6b65\u9aa4\u4e00\uff1a\u5b8c\u6210\u6bcf\u65e5\u6311\u6218\u4ee5\u83b7\u5f97\u989d\u5916\u7ecf\u9a8c\u503c\uff1b\u6b65\u9aa4\u4e8c\uff1a\u53c2\u4e0e\u63d0\u4f9b\u9ad8\u5956\u52b1\u7684\u5c0f\u6e38\u620f\uff1b\u6b65\u9aa4\u4e09\uff1a\u5728\u5173\u952e\u4efb\u52a1\u4e2d\u4f7f\u7528\u9053\u5177\u3002\u4f8b\u5982\uff0c\u5728\u5582\u98df\u73af\u8282\u4f7f\u7528\u201c\u53cc\u500d\u7ecf\u9a8c\u201d\u9053\u5177\u53ef\u4ee5\u663e\u8457\u63d0\u5347\u4f60\u7684\u8fdb\u5ea6\u3002\u6bd4\u8f83\u4e0d\u540c\u7684\u9053\u5177\u4ee5\u6700\u5927\u5316\u6548\u7387\u3002"}, {"question": "\u4e3a\u4ec0\u4e48Can Your Pet\u62e5\u6709\u72ec\u7279\u7684\u5ba0\u7269\u4e92\u52a8\u7cfb\u7edf\uff1f", "answer": "Can Your Pet\u62e5\u6709\u72ec\u7279\u7684\u4e92\u52a8\u7cfb\u7edf\uff0c\u4ee5\u589e\u5f3a\u73a9\u5bb6\u7684\u53c2\u4e0e\u5ea6\u3002\u8be5\u7cfb\u7edf\u4f7f\u7528\u4eba\u5de5\u667a\u80fd\u6839\u636e\u73a9\u5bb6\u7684\u884c\u4e3a\u8c03\u6574\u5ba0\u7269\u7684\u884c\u4e3a\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u7ecf\u5e38\u73a9\u6349\u8ff7\u85cf\u6e38\u620f\uff0c\u4f60\u7684\u5ba0\u7269\u53ef\u80fd\u4f1a\u66f4\u9891\u7e41\u5730\u53d1\u8d77\u6e38\u620f\u3002\u8fd9\u79cd\u52a8\u6001\u7684\u4e92\u52a8\u521b\u9020\u4e86\u4e00\u79cd\u66f4\u8eab\u4e34\u5176\u5883\u548c\u4e2a\u6027\u5316\u7684\u4f53\u9a8c\u3002\u8be5\u7cfb\u7edf\u65e8\u5728\u6a21\u62df\u771f\u5b9e\u7684\u5ba0\u7269\u9972\u517b\u3002"}, {"question": "Can Your Pet\u4e2d\u7684\u54ea\u4e9b\u6e38\u620f\u6d3b\u52a8\u63d0\u4f9b\u6700\u591a\u7684\u5956\u52b1\uff1f", "answer": "\u5728Can Your Pet\u4e2d\uff0c\u5b63\u8282\u6027\u6d3b\u52a8\u548c\u793e\u533a\u6311\u6218\u63d0\u4f9b\u4e86\u6700\u591a\u7684\u5956\u52b1\u3002\u4f8b\u5982\uff0c\u201c\u51ac\u5b63\u8282\u65e5\u201d\u6d3b\u52a8\u63d0\u4f9b\u72ec\u5bb6\u7269\u54c1\u548c\u9ad8\u7ecf\u9a8c\u503c\u3002\u79ef\u6781\u53c2\u4e0e\u5e76\u4f7f\u7528\u7279\u5b9a\u4e8e\u6d3b\u52a8\u7684\u9053\u5177\u6765\u6700\u5927\u5316\u6536\u76ca\u3002\u6bd4\u8f83\u6d3b\u52a8\u65f6\u95f4\u8868\u4ee5\u6709\u6548\u5730\u89c4\u5212\u4f60\u7684\u6e38\u620f\u3002"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684Can Your Pet\u6570\u636e\u8fc1\u79fb\u5230\u65b0\u7684\u8bbe\u5907\uff1f", "answer": "\u8981\u8fc1\u79fb\u4f60\u7684Can Your Pet\u6570\u636e\uff0c\u8bf7\u786e\u4fdd\u4f60\u5df2\u94fe\u63a5\u8d26\u6237\u3002\u6b65\u9aa4\u4e00\uff1a\u8fdb\u5165\u8bbe\u7f6e\u5e76\u9009\u62e9\u201c\u8d26\u6237\u201d\uff1b\u6b65\u9aa4\u4e8c\uff1a\u5c06\u4f60\u7684\u6e38\u620f\u94fe\u63a5\u5230\u7535\u5b50\u90ae\u4ef6\u6216\u793e\u4ea4\u5a92\u4f53\u8d26\u6237\uff1b\u6b65\u9aa4\u4e09\uff1a\u5728\u65b0\u8bbe\u5907\u4e0a\u5b89\u88c5\u6e38\u620f\u5e76\u4f7f\u7528\u76f8\u540c\u7684\u8d26\u6237\u767b\u5f55\u3002\u4f60\u7684\u8fdb\u5ea6\u5c06\u81ea\u52a8\u540c\u6b65\u3002\u4f7f\u7528\u914d\u7f6e\u8868\u9a8c\u8bc1\u94fe\u63a5\u7684\u8d26\u6237\u72b6\u6001\u3002"}, {"question": "\u901a\u8fc7\u63a2\u7d22\u73af\u5883\uff0c\u6211\u53ef\u4ee5\u5728Can Your Pet\u4e2d\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u529f\u80fd\uff1f", "answer": "\u5728Can Your Pet\u4e2d\u63a2\u7d22\u73af\u5883\u4f1a\u63ed\u793a\u9690\u85cf\u529f\u80fd\uff0c\u4f8b\u5982\u9690\u85cf\u7684\u5c0f\u6e38\u620f\u548c\u7a00\u6709\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u70b9\u51fb\u516c\u56ed\u91cc\u7279\u5b9a\u6811\u6728\u53ef\u80fd\u4f1a\u89e3\u9501\u9690\u85cf\u7684\u6349\u8ff7\u85cf\u6e38\u620f\u3002\u8fd9\u4e9b\u529f\u80fd\u589e\u5f3a\u4e86\u6e38\u620f\u4f53\u9a8c\u5e76\u63d0\u4f9b\u4e86\u72ec\u7279\u7684\u5956\u52b1\u3002\u4f7f\u7528\u6d41\u7a0b\u56fe\u8ddf\u8e2a\u53d1\u73b0\u7684\u529f\u80fd\u53ca\u5176\u4f4d\u7f6e\u3002"}, {"question": "Can Your Pet\u4e2d\u7684\u5582\u517b\u673a\u5236\u5982\u4f55\u5f71\u54cd\u5ba0\u7269\u7684\u6210\u957f\uff1f", "answer": "Can Your Pet\u4e2d\u7684\u5582\u517b\u673a\u5236\u76f4\u63a5\u5f71\u54cd\u5ba0\u7269\u7684\u6210\u957f\u548c\u5feb\u4e50\u3002\u5b9a\u671f\u5582\u517b\u4f60\u7684\u5ba0\u7269\u4f1a\u63d0\u9ad8\u5b83\u7684\u5065\u5eb7\u548c\u80fd\u91cf\u6c34\u5e73\u3002\u4f8b\u5982\uff0c\u5747\u8861\u7684\u996e\u98df\u4f1a\u63d0\u9ad8\u6210\u957f\u901f\u5ea6\u3002\u4f7f\u7528\u6bd4\u8f83\u8868\u8bc4\u4f30\u4e0d\u540c\u98df\u7269\u7c7b\u578b\u53ca\u5176\u5bf9\u5ba0\u7269\u5c5e\u6027\u7684\u5f71\u54cd\u3002"}, {"question": "Can Your Pet\u548c\u5176\u4ed6\u5ba0\u7269\u517b\u6210\u6e38\u620f\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "Can Your Pet\u51ed\u501f\u5176\u4eba\u5de5\u667a\u80fd\u9a71\u52a8\u7684\u4e92\u52a8\u7cfb\u7edf\u548c\u52a8\u6001\u7684\u5ba0\u7269\u884c\u4e3a\u8131\u9896\u800c\u51fa\u3002\u4e0e\u5176\u4ed6\u6e38\u620f\u4e0d\u540c\uff0c\u5b83\u63d0\u4f9b\u5b9e\u65f6\u54cd\u5e94\u548c\u81ea\u9002\u5e94\u5b66\u4e60\u3002\u4f8b\u5982\uff0cCan Your Pet\u4e2d\u7684\u5ba0\u7269\u4f1a\u8bb0\u4f4f\u73a9\u5bb6\u7684\u884c\u4e3a\u5e76\u76f8\u5e94\u5730\u8c03\u6574\u5176\u884c\u4e3a\u3002\u8fd9\u521b\u9020\u4e86\u4e00\u79cd\u66f4\u4e2a\u6027\u5316\u548c\u66f4\u5f15\u4eba\u5165\u80dc\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u5982\u4f55\u4f18\u5316\u6211\u7684Can Your Pet\u6e38\u620f\u4ee5\u6700\u5927\u5316\u6548\u7387\uff1f", "answer": "\u8981\u4f18\u5316\u4f60\u7684Can Your Pet\u6e38\u620f\uff0c\u8bf7\u5173\u6ce8\u9ad8\u6548\u7684\u4efb\u52a1\u7ba1\u7406\u548c\u8d44\u6e90\u5206\u914d\u3002\u6b65\u9aa4\u4e00\uff1a\u4f18\u5148\u8003\u8651\u9ad8\u5956\u52b1\u6d3b\u52a8\uff0c\u4f8b\u5982\u6bcf\u65e5\u6311\u6218\uff1b\u6b65\u9aa4\u4e8c\uff1a\u5728\u5173\u952e\u4efb\u52a1\u4e2d\u7b56\u7565\u6027\u5730\u4f7f\u7528\u9053\u5177\uff1b\u6b65\u9aa4\u4e09\uff1a\u5b9a\u671f\u68c0\u67e5\u4e8b\u4ef6\u66f4\u65b0\uff0c\u53c2\u4e0e\u9ad8\u5956\u52b1\u4e8b\u4ef6\u3002\u4f8b\u5982\uff0c\u5728\u793e\u533a\u6311\u6218\u4e2d\u4f7f\u7528\u201c\u53cc\u500d\u7ecf\u9a8c\u201d\u9053\u5177\u53ef\u4ee5\u663e\u8457\u63d0\u5347\u4f60\u7684\u8fdb\u5ea6\u3002"}, {"question": "\u65b0\u73a9\u5bb6\u5728Can Your Pet\u4e2d\u5e38\u72af\u54ea\u4e9b\u9519\u8bef\u4ee5\u53ca\u5982\u4f55\u907f\u514d\uff1f", "answer": "Can Your Pet\u7684\u65b0\u73a9\u5bb6\u7ecf\u5e38\u4f1a\u5ffd\u7565\u6bcf\u65e5\u4efb\u52a1\uff0c\u5e76\u4e14\u672a\u80fd\u6709\u6548\u5229\u7528\u9053\u5177\u3002\u4e3a\u4e86\u907f\u514d\u8fd9\u4e9b\u9519\u8bef\uff0c\u8bf7\u5b9a\u671f\u5b8c\u6210\u6bcf\u65e5\u6311\u6218\uff0c\u5e76\u5728\u9ad8\u5956\u52b1\u6d3b\u52a8\u4e2d\u4f7f\u7528\u9053\u5177\u3002\u4f8b\u5982\uff0c\u5728\u5f00\u59cb\u5c0f\u6e38\u620f\u4e4b\u524d\uff0c\u8bf7\u52a1\u5fc5\u68c0\u67e5\u662f\u5426\u6709\u53ef\u7528\u7684\u9053\u5177\u3002\u4f7f\u7528\u6bd4\u8f83\u8868\u6765\u8ddf\u8e2a\u4efb\u52a1\u4f18\u5148\u7ea7\u548c\u5956\u52b1\u3002"}]
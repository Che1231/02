[{"question": "\u5982\u4f55\u958b\u59cb\u73a9\u5bf5\u7269\u5927\u8cfd\u65b0\u624b\u5165\u9580\uff1f", "answer": "\u8981\u958b\u59cb\u73a9\u5bf5\u7269\u5927\u8cfd\uff0c\u8acb\u5148\u5f9e\u60a8\u559c\u611b\u7684\u61c9\u7528\u7a0b\u5f0f\u5546\u5e97\u4e0b\u8f09\u904a\u6232\u3002\u5b89\u88dd\u5f8c\uff0c\u5efa\u7acb\u500b\u4eba\u6a94\u6848\u4e26\u9078\u64c7\u60a8\u7684\u7b2c\u4e00\u96bb\u5bf5\u7269\u3002\u904a\u6232\u5c07\u5f15\u5c0e\u60a8\u5b8c\u6210\u57fa\u672c\u7684\u4e92\u52d5\uff0c\u4f8b\u5982\u9935\u98df\u548c\u904a\u6232\u3002\u4f8b\u5982\uff0c\u9ede\u64ca\u98df\u7269\u5716\u793a\u4f86\u9935\u98df\u60a8\u7684\u5bf5\u7269\u3002\u4f7f\u7528\u6559\u5b78\u4f86\u5b78\u7fd2\u5fc5\u8981\u7684\u6307\u4ee4\u548c\u624b\u52e2\u3002"}, {"question": "\u5728\u73a9\u4e86100\u5c0f\u6642\u5f8c\uff0c\u5bf5\u7269\u5927\u8cfd\u7684\u6700\u4f73\u5347\u7d1a\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u5bf5\u7269\u5927\u8cfd\u73a9\u4e86100\u5c0f\u6642\u5f8c\uff0c\u8acb\u8457\u91cd\u65bc\u5148\u9032\u7684\u7b56\u7565\uff0c\u4ee5\u6709\u6548\u63d0\u5347\u7b49\u7d1a\u3002\u6b65\u9a5f\u4e00\uff1a\u5b8c\u6210\u6bcf\u65e5\u6311\u6230\u4ee5\u7372\u5f97\u984d\u5916\u7d93\u9a57\u503c\u3002\u6b65\u9a5f\u4e8c\uff1a\u53c3\u8207\u63d0\u4f9b\u9ad8\u56de\u5831\u7684\u5c0f\u904a\u6232\u3002\u6b65\u9a5f\u4e09\uff1a\u5728\u95dc\u9375\u4efb\u52d9\u4e2d\u4f7f\u7528\u589e\u5f37\u9053\u5177\u3002\u4f8b\u5982\uff0c\u5728\u9935\u98df\u904e\u7a0b\u4e2d\u4f7f\u7528\u300c\u96d9\u500d\u7d93\u9a57\u503c\u300d\u589e\u5f37\u9053\u5177\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u60a8\u7684\u9032\u5ea6\u3002\u6bd4\u8f03\u4e0d\u540c\u7684\u589e\u5f37\u9053\u5177\u4ee5\u6700\u5927\u5316\u6548\u7387\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u5bf5\u7269\u5927\u8cfd\u64c1\u6709\u7368\u7279\u7684\u5bf5\u7269\u4e92\u52d5\u7cfb\u7d71\uff1f", "answer": "\u5bf5\u7269\u5927\u8cfd\u5177\u6709\u7368\u7279\u7684\u4e92\u52d5\u7cfb\u7d71\uff0c\u4ee5\u589e\u5f37\u73a9\u5bb6\u7684\u53c3\u8207\u5ea6\u3002\u8a72\u7cfb\u7d71\u4f7f\u7528\u4eba\u5de5\u667a\u6167\u4f86\u6839\u64da\u73a9\u5bb6\u7684\u884c\u70ba\u8abf\u6574\u5bf5\u7269\u7684\u884c\u70ba\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u7d93\u5e38\u73a9\u6349\u8ff7\u85cf\uff0c\u60a8\u7684\u5bf5\u7269\u53ef\u80fd\u6703\u66f4\u983b\u7e41\u5730\u767c\u8d77\u904a\u6232\u3002\u9019\u7a2e\u52d5\u614b\u4e92\u52d5\u5275\u9020\u4e86\u66f4\u8eab\u81e8\u5176\u5883\u4e14\u500b\u6027\u5316\u7684\u9ad4\u9a57\u3002\u8a72\u7cfb\u7d71\u65e8\u5728\u6a21\u64ec\u73fe\u5be6\u751f\u6d3b\u4e2d\u7684\u5bf5\u7269\u98fc\u990a\u3002"}, {"question": "\u5bf5\u7269\u5927\u8cfd\u54ea\u4e9b\u904a\u6232\u6d3b\u52d5\u63d0\u4f9b\u6700\u591a\u7684\u734e\u52f5\uff1f", "answer": "\u5728\u5bf5\u7269\u5927\u8cfd\u4e2d\uff0c\u5b63\u7bc0\u6027\u6d3b\u52d5\u548c\u793e\u7fa4\u6311\u6230\u63d0\u4f9b\u6700\u591a\u7684\u734e\u52f5\u3002\u4f8b\u5982\uff0c\u300c\u51ac\u5b63\u7bc0\u6176\u300d\u6d3b\u52d5\u63d0\u4f9b\u7368\u5bb6\u7269\u54c1\u548c\u9ad8\u7d93\u9a57\u503c\u3002\u7a4d\u6975\u53c3\u8207\u4e26\u4f7f\u7528\u7279\u5b9a\u65bc\u6d3b\u52d5\u7684\u589e\u5f37\u9053\u5177\u4ee5\u6700\u5927\u5316\u6536\u76ca\u3002\u6bd4\u8f03\u6d3b\u52d5\u6642\u9593\u8868\u4ee5\u6709\u6548\u5730\u898f\u5283\u60a8\u7684\u904a\u6232\u3002"}, {"question": "\u5982\u4f55\u5c07\u6211\u7684\u5bf5\u7269\u5927\u8cfd\u8cc7\u6599\u9077\u79fb\u5230\u65b0\u88dd\u7f6e\uff1f", "answer": "\u8981\u9077\u79fb\u60a8\u7684\u5bf5\u7269\u5927\u8cfd\u8cc7\u6599\uff0c\u8acb\u78ba\u4fdd\u60a8\u5df2\u9023\u7d50\u5e33\u6236\u3002\u6b65\u9a5f\u4e00\uff1a\u524d\u5f80\u8a2d\u5b9a\u4e26\u9078\u64c7\u300c\u5e33\u6236\u300d\u3002\u6b65\u9a5f\u4e8c\uff1a\u5c07\u60a8\u7684\u904a\u6232\u9023\u7d50\u5230\u96fb\u5b50\u90f5\u4ef6\u6216\u793e\u4ea4\u5a92\u9ad4\u5e33\u6236\u3002\u6b65\u9a5f\u4e09\uff1a\u5728\u65b0\u88dd\u7f6e\u4e0a\u5b89\u88dd\u904a\u6232\u4e26\u4f7f\u7528\u76f8\u540c\u7684\u5e33\u6236\u767b\u5165\u3002\u60a8\u7684\u9032\u5ea6\u5c07\u81ea\u52d5\u540c\u6b65\u3002\u4f7f\u7528\u914d\u7f6e\u8868\u4f86\u9a57\u8b49\u9023\u7d50\u7684\u5e33\u6236\u72c0\u614b\u3002"}, {"question": "\u900f\u904e\u63a2\u7d22\u74b0\u5883\uff0c\u6211\u5728\u5bf5\u7269\u5927\u8cfd\u4e2d\u53ef\u4ee5\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\uff1f", "answer": "\u5728\u5bf5\u7269\u5927\u8cfd\u4e2d\u63a2\u7d22\u74b0\u5883\u6703\u767c\u73fe\u96b1\u85cf\u529f\u80fd\uff0c\u4f8b\u5982\u79d8\u5bc6\u5c0f\u904a\u6232\u548c\u7a00\u6709\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u9ede\u64ca\u516c\u5712\u4e2d\u7279\u5b9a\u6a39\u6728\u53ef\u80fd\u6703\u89e3\u9396\u96b1\u85cf\u7684\u6349\u8ff7\u85cf\u904a\u6232\u3002\u9019\u4e9b\u529f\u80fd\u589e\u5f37\u904a\u6232\u6027\uff0c\u4e26\u63d0\u4f9b\u7368\u7279\u7684\u734e\u52f5\u3002\u4f7f\u7528\u6d41\u7a0b\u5716\u4f86\u8ffd\u8e64\u767c\u73fe\u7684\u529f\u80fd\u53ca\u5176\u4f4d\u7f6e\u3002"}, {"question": "\u5bf5\u7269\u5927\u8cfd\u4e2d\u7684\u9935\u98df\u6a5f\u5236\u5982\u4f55\u5f71\u97ff\u5bf5\u7269\u6210\u9577\uff1f", "answer": "\u5bf5\u7269\u5927\u8cfd\u4e2d\u7684\u9935\u98df\u6a5f\u5236\u76f4\u63a5\u5f71\u97ff\u5bf5\u7269\u7684\u6210\u9577\u548c\u5feb\u6a02\u3002\u5b9a\u671f\u9935\u98df\u5bf5\u7269\u6703\u589e\u52a0\u5176\u5065\u5eb7\u548c\u6d3b\u529b\u3002\u4f8b\u5982\uff0c\u9935\u98df\u5747\u8861\u7684\u98f2\u98df\u6703\u4fc3\u9032\u6210\u9577\u901f\u5ea6\u3002\u4f7f\u7528\u6bd4\u8f03\u8868\u683c\u8a55\u4f30\u4e0d\u540c\u98df\u7269\u985e\u578b\u53ca\u5176\u5c0d\u5bf5\u7269\u5c6c\u6027\u7684\u5f71\u97ff\u3002"}, {"question": "\u5bf5\u7269\u5927\u8cfd\u8207\u5176\u4ed6\u5bf5\u7269\u6a21\u64ec\u904a\u6232\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5bf5\u7269\u5927\u8cfd\u4ee5\u5176\u57fa\u65bc\u4eba\u5de5\u667a\u6167\u7684\u4e92\u52d5\u7cfb\u7d71\u548c\u52d5\u614b\u5bf5\u7269\u884c\u70ba\u800c\u812b\u7a4e\u800c\u51fa\u3002\u8207\u5176\u4ed6\u904a\u6232\u4e0d\u540c\u7684\u662f\uff0c\u5b83\u63d0\u4f9b\u5373\u6642\u53cd\u61c9\u548c\u9069\u61c9\u6027\u5b78\u7fd2\u3002\u4f8b\u5982\uff0c\u5bf5\u7269\u5927\u8cfd\u4e2d\u7684\u5bf5\u7269\u6703\u8a18\u4f4f\u73a9\u5bb6\u7684\u52d5\u4f5c\u4e26\u76f8\u61c9\u5730\u8abf\u6574\u5176\u884c\u70ba\u3002\u9019\u5275\u9020\u4e86\u66f4\u500b\u6027\u5316\u548c\u66f4\u5f15\u4eba\u5165\u52dd\u7684\u9ad4\u9a57\u3002"}, {"question": "\u5982\u4f55\u512a\u5316\u6211\u7684\u5bf5\u7269\u5927\u8cfd\u904a\u6232\u4ee5\u9054\u5230\u6700\u5927\u6548\u7387\uff1f", "answer": "\u8981\u512a\u5316\u60a8\u7684\u5bf5\u7269\u5927\u8cfd\u904a\u6232\uff0c\u8acb\u96c6\u4e2d\u65bc\u9ad8\u6548\u7684\u4efb\u52d9\u7ba1\u7406\u548c\u8cc7\u6e90\u5206\u914d\u3002\u6b65\u9a5f\u4e00\uff1a\u512a\u5148\u8003\u616e\u9ad8\u56de\u5831\u6d3b\u52d5\uff0c\u4f8b\u5982\u6bcf\u65e5\u6311\u6230\u3002\u6b65\u9a5f\u4e8c\uff1a\u5728\u95dc\u9375\u4efb\u52d9\u4e2d\u7b56\u7565\u6027\u5730\u4f7f\u7528\u589e\u5f37\u9053\u5177\u3002\u6b65\u9a5f\u4e09\uff1a\u5b9a\u671f\u6aa2\u67e5\u6d3b\u52d5\u66f4\u65b0\u4ee5\u53c3\u8207\u9ad8\u56de\u5831\u6d3b\u52d5\u3002\u4f8b\u5982\uff0c\u5728\u793e\u7fa4\u6311\u6230\u4e2d\u4f7f\u7528\u300c\u96d9\u500d\u7d93\u9a57\u503c\u300d\u589e\u5f37\u9053\u5177\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u60a8\u7684\u9032\u5ea6\u3002"}, {"question": "\u5bf5\u7269\u5927\u8cfd\u65b0\u73a9\u5bb6\u6700\u5e38\u72af\u7684\u932f\u8aa4\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5982\u4f55\u907f\u514d\u5b83\u5011\uff1f", "answer": "\u5bf5\u7269\u5927\u8cfd\u7684\u65b0\u73a9\u5bb6\u7d93\u5e38\u5ffd\u7565\u6bcf\u65e5\u4efb\u52d9\uff0c\u4e26\u672a\u80fd\u6709\u6548\u5730\u5229\u7528\u589e\u5f37\u9053\u5177\u3002\u70ba\u907f\u514d\u9019\u4e9b\u932f\u8aa4\uff0c\u8acb\u5b9a\u671f\u5b8c\u6210\u6bcf\u65e5\u6311\u6230\uff0c\u4e26\u5728\u9ad8\u56de\u5831\u6d3b\u52d5\u4e2d\u4f7f\u7528\u589e\u5f37\u9053\u5177\u3002\u4f8b\u5982\uff0c\u5728\u958b\u59cb\u5c0f\u904a\u6232\u4e4b\u524d\uff0c\u59cb\u7d42\u6aa2\u67e5\u662f\u5426\u6709\u53ef\u7528\u7684\u589e\u5f37\u9053\u5177\u3002\u4f7f\u7528\u6bd4\u8f03\u8868\u683c\u4f86\u8ffd\u8e64\u4efb\u52d9\u512a\u5148\u9806\u5e8f\u548c\u734e\u52f5\u3002"}]
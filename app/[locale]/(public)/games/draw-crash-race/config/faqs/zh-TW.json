[{"question": "\u5982\u4f55\u958b\u59cb\u73a9\u7e6a\u88fd\u649e\u8eca\u8cfd\uff0c\u4f5c\u70ba\u5b8c\u5168\u7684\u65b0\u624b\uff1f", "answer": "\u8981\u958b\u59cb\u73a9\u7e6a\u88fd\u649e\u8eca\u8cfd\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a1. \u5f9e\u60a8\u7684\u61c9\u7528\u7a0b\u5f0f\u5546\u5e97\u4e0b\u8f09\u904a\u6232\u30022. \u958b\u555f\u904a\u6232\u4e26\u5b8c\u6210\u6559\u5b78\u8ab2\u7a0b\uff0c\u6559\u5b78\u8ab2\u7a0b\u5c07\u6307\u5c0e\u60a8\u5b78\u7fd2\u57fa\u672c\u7684\u63a7\u5236\u65b9\u5f0f\uff0c\u4f8b\u5982\u7e6a\u88fd\u8def\u7dda\u548c\u907f\u514d\u969c\u7919\u7269\u30023. \u5f9e\u7b2c\u4e00\u95dc\u958b\u59cb\uff0c\u611f\u53d7\u904a\u6232\u7684\u6a5f\u5236\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u95dc\u4e2d\uff0c\u60a8\u9700\u8981\u7e6a\u88fd\u4e00\u689d\u7c21\u55ae\u7684\u8def\u7dda\uff0c\u8b93\u60a8\u7684\u6c7d\u8eca\u99db\u5411\u7d42\u9ede\u7dda\u3002\u8acb\u8a18\u4f4f\uff0c\u719f\u80fd\u751f\u5de7\uff01 [\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u60f3\u770b\uff0c\u5b78\u7fd2\u9a0e\u81ea\u884c\u8eca\u4e5f\u662f\u4e00\u6a23\u7684\u2014\u5f9e\u6162\u800c\u7a69\u5730\u958b\u59cb\u3002]"}, {"question": "\u5728\u7e6a\u88fd\u649e\u8eca\u8cfd\u4e2d\uff0c\u53d6\u5f97\u9ad8\u5206\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u7e6a\u88fd\u649e\u8eca\u8cfd\u4e2d\uff0c\u53d6\u5f97\u9ad8\u5206\u9700\u8981\u7cbe\u6e96\u5ea6\u548c\u5275\u9020\u529b\u7684\u7d50\u5408\u3002\u6b65\u9a5f 1\uff1a\u4ed4\u7d30\u898f\u5283\u60a8\u7684\u8def\u7dda\uff0c\u907f\u514d\u78b0\u649e\u4e26\u6536\u96c6\u786c\u5e63\u3002\u6b65\u9a5f 2\uff1a\u4f7f\u7528\u52a0\u901f\u5668\u7b49\u9053\u5177\uff0c\u66f4\u5feb\u5730\u5b8c\u6210\u95dc\u5361\u3002\u6b65\u9a5f 3\uff1a\u81f4\u529b\u65bc\u9054\u6210\u734e\u52f5\u76ee\u6a19\uff0c\u4f8b\u5982\u5728\u7279\u5b9a\u6642\u9593\u9650\u5236\u5167\u5b8c\u6210\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 10 \u95dc\u4e2d\uff0c\u7e6a\u88fd\u4e4b\u5b57\u5f62\u8def\u7dda\u53ef\u4ee5\u5e6b\u52a9\u60a8\u8eb2\u907f\u969c\u7919\u7269\uff0c\u540c\u6642\u6536\u96c6\u6240\u6709\u786c\u5e63\u3002 [\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u4e00\u689d\u76f4\u7dda\u8def\u7dda\u53ef\u80fd\u901f\u5ea6\u8f03\u5feb\uff0c\u4f46\u66f2\u7dda\u8def\u7dda\u5247\u53ef\u4ee5\u7372\u5f97\u66f4\u591a\u786c\u5e63\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u7684\u8eca\u5b50\u5728\u7e6a\u88fd\u649e\u8eca\u8cfd\u4e2d\uff0c\u5373\u4f7f\u7e6a\u88fd\u4e86\u8def\u7dda\uff0c\u9084\u662f\u6703\u4e0d\u65b7\u5730\u649e\u8eca\uff1f", "answer": "\u7e6a\u88fd\u649e\u8eca\u8cfd\u4e2d\u649e\u8eca\u7684\u60c5\u6cc1\u7d93\u5e38\u662f\u7531\u65bc\u4e09\u500b\u5e38\u898b\u932f\u8aa4\uff1a1. \u8def\u7dda\u7e6a\u88fd\u5f97\u592a\u9760\u8fd1\u969c\u7919\u7269\u30022. \u5f4e\u9053\u592a\u6025\u4fc3\uff0c\u8eca\u8f1b\u7121\u6cd5\u9806\u5229\u901a\u904e\u30023. \u5ffd\u7565\u79fb\u52d5\u4e2d\u7684\u969c\u7919\u7269\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e94\u95dc\u4e2d\uff0c\u5728\u6416\u64fa\u9318\u9644\u8fd1\u7e6a\u88fd\u6642\u9593\u4e0d\u4f73\u7684\u8def\u7dda\u5c07\u6703\u5c0e\u81f4\u649e\u8eca\u3002 [\u6d41\u7a0b\u5716\u89e3\uff1a\u5728\u79fb\u52d5\u7684\u969c\u7919\u7269\u5468\u570d\u756b\u51fa\u5bec\u5ee3\u7684\u66f2\u7dda\u4ee5\u78ba\u4fdd\u5b89\u5168\u3002]"}, {"question": "\u5728\u7e6a\u88fd\u649e\u8eca\u8cfd\u4e2d\uff0c\u54ea\u4e9b\u904a\u6232\u6a5f\u5236\u5c0d\u65bc\u9ad8\u7d1a\u73a9\u5bb6\u4f86\u8aaa\u6700\u91cd\u8981\uff1f", "answer": "\u9ad8\u7d1a\u73a9\u5bb6\u61c9\u8a72\u5c08\u6ce8\u65bc\u9019\u4e9b\u904a\u6232\u6a5f\u5236\uff1a1. \u8def\u7dda\u6700\u4f73\u5316\u2014\u627e\u5230\u6700\u77ed\u4e14\u6700\u5b89\u5168\u7684\u8def\u7dda\u30022. \u6642\u9593\u63a7\u5236\u2014\u9810\u6e2c\u79fb\u52d5\u969c\u7919\u7269\u548c\u9053\u5177\u30023. \u8cc7\u6e90\u7ba1\u7406\u2014\u7b56\u7565\u6027\u5730\u4f7f\u7528\u786c\u5e63\u89e3\u9396\u5347\u7d1a\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 20 \u95dc\u4e2d\uff0c\u719f\u7df4\u638c\u63e1\u9019\u4e9b\u6a5f\u5236\u53ef\u4ee5\u5e6b\u52a9\u60a8\u5728\u6700\u77ed\u6642\u9593\u5167\u5b8c\u6210\u95dc\u5361\u3002 [\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6bd4\u8f03\u8def\u7dda\u9577\u5ea6\u548c\u969c\u7919\u7269\u4f48\u5c40\u4ee5\u627e\u5230\u6700\u4f73\u8def\u7dda\u3002]"}, {"question": "\u7e6a\u88fd\u649e\u8eca\u8cfd\u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u5927\u5316\u8a08\u5206\uff1f", "answer": "\u7e6a\u88fd\u649e\u8eca\u8cfd\u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u4e09\u500b\u56e0\u7d20\uff1a1. \u5b8c\u6210\u6642\u9593\u2014\u5b8c\u6210\u6642\u9593\u8d8a\u5feb\uff0c\u5f97\u5206\u8d8a\u9ad8\u30022. \u786c\u5e63\u6536\u96c6\u2014\u6bcf\u500b\u786c\u5e63\u90fd\u6703\u589e\u52a0\u60a8\u7684\u5f97\u5206\u30023. \u734e\u52f5\u76ee\u6a19\u2014\u5b8c\u6210\u9019\u4e9b\u76ee\u6a19\u6703\u7372\u5f97\u984d\u5916\u5206\u6578\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 15 \u95dc\u4e2d\uff0c\u5728 30 \u79d2\u5167\u5b8c\u6210\u904a\u6232\u4e26\u6536\u96c6\u6240\u6709\u786c\u5e63\u5c07\u6703\u6700\u5927\u5316\u60a8\u7684\u5f97\u5206\u3002 [\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u6bd4\u8f03\u4e0d\u540c\u7684\u8def\u7dda\u4ee5\u67e5\u770b\u54ea\u689d\u8def\u7dda\u80fd\u7372\u5f97\u6700\u9ad8\u5206\u3002]"}, {"question": "\u7e6a\u88fd\u649e\u8eca\u8cfd\u7684\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "\u55ae\u4eba\u6a21\u5f0f\u91cd\u9ede\u5728\u65bc\u500b\u4eba\u6280\u5de7\u548c\u9032\u5ea6\uff0c\u800c\u591a\u4eba\u6a21\u5f0f\u5247\u5f15\u5165\u4e86\u7af6\u722d\u3002\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u60a8\u9700\u8981\u8207\u4ed6\u4eba\u9032\u884c\u5373\u6642\u7af6\u8cfd\uff0c\u60a8\u7e6a\u88fd\u7684\u8def\u7dda\u6703\u5f71\u97ff\u60a8\u7684\u8eca\u8f1b\u548c\u5c0d\u624b\u3002\u4f8b\u5982\uff0c\u5728\u591a\u4eba\u5c0d\u6230\u4e2d\uff0c\u7e6a\u88fd\u969c\u7919\u7269\u53ef\u4ee5\u6e1b\u6162\u5c0d\u624b\u7684\u901f\u5ea6\u3002 [\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u55ae\u4eba\u6a21\u5f0f\u60f3\u50cf\u6210\u7368\u81ea\u99ac\u62c9\u677e\uff0c\u5c07\u591a\u4eba\u6a21\u5f0f\u60f3\u50cf\u6210\u77ed\u8dd1\u7af6\u8cfd\u3002]"}, {"question": "\u5982\u4f55\u5c07\u6211\u7684\u7e6a\u88fd\u649e\u8eca\u8cfd\u9032\u5ea6\u8f49\u79fb\u5230\u65b0\u7684\u88dd\u7f6e\uff1f", "answer": "\u8981\u8f49\u79fb\u9032\u5ea6\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a1. \u78ba\u4fdd\u60a8\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u90fd\u767b\u5165\u76f8\u540c\u7684\u5e33\u6236 (\u4f8b\u5982\uff0cGoogle Play \u6216 Apple ID)\u30022. \u5728\u820a\u88dd\u7f6e\u4e0a\u958b\u555f\u904a\u6232\u4e26\u901a\u904e\u96f2\u7aef\u5132\u5b58\u9078\u9805\u540c\u6b65\u60a8\u7684\u9032\u5ea6\u30023. \u5728\u65b0\u88dd\u7f6e\u4e0a\u5b89\u88dd\u904a\u6232\u4e26\u767b\u5165\u76f8\u540c\u7684\u5e33\u6236\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5df2\u5728\u820a\u624b\u6a5f\u4e0a\u5b8c\u6210\u7b2c 25 \u95dc\uff0c\u5247\u6703\u81ea\u52d5\u540c\u6b65\u5230\u60a8\u7684\u65b0\u88dd\u7f6e\u3002 [\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6bd4\u8f03\u4e0d\u540c\u5e73\u53f0\u7684\u96f2\u7aef\u5132\u5b58\u9078\u9805\u3002]"}, {"question": "\u7e6a\u88fd\u649e\u8eca\u8cfd\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\uff0c\u4ee5\u53ca\u5982\u4f55\u627e\u5230\u5b83\u5011\uff1f", "answer": "\u7e6a\u88fd\u649e\u8eca\u8cfd\u5305\u542b\u4e00\u4e9b\u5f69\u86cb\uff0c\u4f8b\u5982\u79d8\u5bc6\u95dc\u5361\u548c\u7a00\u6709\u9053\u5177\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 12 \u95dc\u4e2d\uff0c\u7e6a\u88fd\u7279\u5b9a\u5716\u6848 (\u4f8b\u5982\u661f\u661f) \u53ef\u4ee5\u89e3\u9396\u96b1\u85cf\u7684\u984d\u5916\u95dc\u5361\u3002\u8acb\u5bc6\u5207\u6ce8\u610f\u904a\u6232\u74b0\u5883\u4e2d\u4e0d\u5c0b\u5e38\u7684\u7b26\u865f\u6216\u5716\u6848\u3002 [\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c0b\u627e\u5f69\u86cb\u5c31\u50cf\u89e3\u8b0e\u5c0b\u5bf6\u4e00\u6a23\u2014\u8010\u5fc3\u548c\u597d\u5947\u5fc3\u662f\u95dc\u9375\u3002]"}, {"question": "\u7e6a\u88fd\u649e\u8eca\u8cfd\u7684\u96e3\u5ea6\u66f2\u7dda\u662f\u5982\u4f55\u6f14\u8b8a\u7684\uff0c\u6211\u61c9\u8a72\u5728\u5f8c\u7e8c\u95dc\u5361\u4e2d\u671f\u5f85\u4ec0\u9ebc\uff1f", "answer": "\u7e6a\u88fd\u649e\u8eca\u8cfd\u7684\u96e3\u5ea6\u6703\u9010\u6f38\u589e\u52a0\u3002\u65e9\u671f\u95dc\u5361\u91cd\u9ede\u5728\u65bc\u57fa\u672c\u8def\u7dda\u7e6a\u88fd\uff0c\u800c\u5f8c\u7e8c\u95dc\u5361\u5247\u6703\u5f15\u9032\u8907\u96dc\u7684\u969c\u7919\u7269\u548c\u6642\u9593\u9650\u5236\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 30 \u95dc\u4e2d\uff0c\u60a8\u5c07\u6703\u9762\u5c0d\u591a\u500b\u79fb\u52d5\u969c\u7919\u7269\uff0c\u4ee5\u53ca\u6709\u9650\u7684\u6642\u9593\u4f86\u5b8c\u6210\u95dc\u5361\u3002 [\u6d41\u7a0b\u5716\u89e3\uff1a\u5c07\u5f9e\u7c21\u55ae\u5230\u8907\u96dc\u7684\u95dc\u5361\u9032\u5ea6\u53ef\u8996\u5316\u3002]"}, {"question": "\u65b0\u624b\u73a9\u5bb6\u5728\u7e6a\u88fd\u649e\u8eca\u8cfd\u4e2d\uff0c\u6700\u5e38\u72af\u7684\u932f\u8aa4\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5982\u4f55\u907f\u514d\u9019\u4e9b\u932f\u8aa4\uff1f", "answer": "\u65b0\u624b\u73a9\u5bb6\u7d93\u5e38\u72af\u9019\u4e9b\u932f\u8aa4\uff1a1. \u7e6a\u88fd\u8def\u7dda\u592a\u5feb\uff0c\u5c0e\u81f4\u649e\u8eca\u30022. \u5ffd\u7565\u786c\u5e63\u6536\u96c6\uff0c\u9019\u6703\u9650\u5236\u9032\u5ea6\u30023. \u5ffd\u7565\u6559\u5b78\u8ab2\u7a0b\uff0c\u6559\u5b78\u8ab2\u7a0b\u63d0\u4f9b\u4e86\u5fc5\u8981\u7684\u6280\u5de7\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 3 \u95dc\u4e2d\uff0c\u5728\u6c92\u6709\u898f\u5283\u7684\u60c5\u6cc1\u4e0b\u5306\u5fd9\u7e6a\u88fd\u8def\u7dda\u6703\u5c0e\u81f4\u649e\u8eca\u3002 [\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u6bd4\u8f03\u5306\u4fc3\u8207\u898f\u5283\u7684\u8def\u7dda\uff0c\u770b\u770b\u7d50\u679c\u7684\u5dee\u7570\u3002]"}]
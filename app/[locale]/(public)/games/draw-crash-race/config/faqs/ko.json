[{"question": "\ucd08\ubcf4\uc790\uac00 \ub4dc\ub85c\uc6b0 \ud06c\ub798\uc2dc \ub808\uc774\uc2a4\ub97c \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud574\uc57c \ud558\ub098\uc694?", "answer": "\ub4dc\ub85c\uc6b0 \ud06c\ub798\uc2dc \ub808\uc774\uc2a4\ub97c \uc2dc\uc791\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: 1. \uc571 \uc2a4\ud1a0\uc5b4\uc5d0\uc11c \uac8c\uc784\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc138\uc694. 2. \uac8c\uc784\uc744 \uc5f4\uace0 \ud29c\ud1a0\ub9ac\uc5bc\uc744 \uc644\ub8cc\ud558\uc138\uc694. \ud29c\ud1a0\ub9ac\uc5bc\uc740 \uacbd\ub85c \uadf8\ub9ac\uae30 \ubc0f \uc7a5\uc560\ubb3c \ud68c\ud53c\uc640 \uac19\uc740 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc548\ub0b4\ud569\ub2c8\ub2e4. 3. \uccab \ubc88\uc9f8 \ub808\ubca8\ubd80\ud130 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc744 \ud30c\uc545\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 1\uc5d0\uc11c\ub294 \uc790\ub3d9\ucc28\ub97c \uacb0\uc2b9\uc120\uae4c\uc9c0 \uc548\ub0b4\ud558\ub294 \uac04\ub2e8\ud55c \uacbd\ub85c\ub97c \uadf8\ub824\uc57c \ud569\ub2c8\ub2e4. \uae30\uc5b5\ud558\uc138\uc694, \uc5f0\uc2b5\uc774 \uc644\ubcbd\uc744 \ub9cc\ub4ed\ub2c8\ub2e4! [\ube44\uc720 \uc124\uba85: \uc790\uc804\uac70 \ud0c0\ub294 \ubc95\uc744 \ubc30\uc6b0\ub294 \uac83\ucc98\ub7fc \ucc9c\ucc9c\ud788 \uadf8\ub9ac\uace0 \uc548\uc815\uc801\uc73c\ub85c \uc2dc\uc791\ud558\uc138\uc694.]"}, {"question": "\ub4dc\ub85c\uc6b0 \ud06c\ub798\uc2dc \ub808\uc774\uc2a4\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub4dc\ub85c\uc6b0 \ud06c\ub798\uc2dc \ub808\uc774\uc2a4\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc73c\ub824\uba74 \uc815\ud655\uc131\uacfc \ucc3d\uc758\uc131\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \ucda9\ub3cc\uc744 \ud53c\ud558\uace0 \ub3d9\uc804\uc744 \ubaa8\uc73c\uae30 \uc704\ud574 \uacbd\ub85c\ub97c \uc2e0\uc911\ud558\uac8c \uacc4\ud68d\ud558\uc138\uc694. \ub2e8\uacc4 2: \uc18d\ub3c4 \ubd80\uc2a4\ud130\uc640 \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub808\ubca8\uc744 \ub354 \ube60\ub974\uac8c \uc644\ub8cc\ud558\uc138\uc694. \ub2e8\uacc4 3: \ud2b9\uc815 \uc2dc\uac04 \uc81c\ud55c \ub0b4\uc5d0 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\ub294 \uac83\uacfc \uac19\uc740 \ubcf4\ub108\uc2a4 \ubaa9\ud45c\ub97c \ub178\ub9ac\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 10\uc5d0\uc11c\ub294 \uc9c0\uadf8\uc7ac\uadf8 \uacbd\ub85c\ub97c \uadf8\ub9ac\uba74 \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\uba74\uc11c \ubaa8\ub4e0 \ub3d9\uc804\uc744 \ubaa8\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\ubc95 \ube44\uad50: \uc9c1\uc120 \uacbd\ub85c\ub294 \ub354 \ube60\ub97c \uc218 \uc788\uc9c0\ub9cc, \uace1\uc120 \uacbd\ub85c\ub294 \ub354 \ub9ce\uc740 \ub3d9\uc804\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "\uacbd\ub85c\ub97c \uadf8\ub9b0 \ud6c4\uc5d0\ub3c4 \ub4dc\ub85c\uc6b0 \ud06c\ub798\uc2dc \ub808\uc774\uc2a4\uc5d0\uc11c \uc790\ub3d9\ucc28\uac00 \uacc4\uc18d\ud574\uc11c \ucda9\ub3cc\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub4dc\ub85c\uc6b0 \ud06c\ub798\uc2dc \ub808\uc774\uc2a4\uc5d0\uc11c \ucda9\ub3cc\uc740 \uc8fc\ub85c \uc138 \uac00\uc9c0 \uc77c\ubc18\uc801\uc778 \uc2e4\uc218\ub85c \ubc1c\uc0dd\ud569\ub2c8\ub2e4. 1. \uc7a5\uc560\ubb3c\uacfc \ub108\ubb34 \uac00\uae4c\uc6b4 \uacbd\ub85c\ub97c \uadf8\ub9b0\ub2e4. 2. \uc790\ub3d9\ucc28\uac00 \ubd80\ub4dc\ub7fd\uac8c \ud1b5\uacfc\ud560 \uc218 \uc5c6\ub294 \uae09\uaca9\ud55c \ud68c\uc804\uc744 \ud55c\ub2e4. 3. \uc774\ub3d9 \uc911\uc778 \uc7a5\uc560\ubb3c\uc744 \uac04\uacfc\ud55c\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 5\uc5d0\uc11c \ud754\ub4e4\ub9ac\ub294 \ub9dd\uce58 \uadfc\ucc98\uc5d0 \uc2dc\uae30\ub97c \ub193\uce5c \uacbd\ub85c\ub97c \uadf8\ub9ac\uba74 \ucda9\ub3cc\uc774 \ubc1c\uc0dd\ud569\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc774\ub3d9 \uc911\uc778 \uc7a5\uc560\ubb3c \uc8fc\ubcc0\uc73c\ub85c \ub113\uc740 \uace1\uc120\uc744 \uadf8\ub824 \uc548\uc804\uc744 \ud655\ubcf4\ud558\uc138\uc694.]"}, {"question": "\ub4dc\ub85c\uc6b0 \ud06c\ub798\uc2dc \ub808\uc774\uc2a4\uc5d0\uc11c \uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uac00\uc7a5 \uc911\uc694\ud55c \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\ub294 \ub2e4\uc74c\uacfc \uac19\uc740 \uba54\ucee4\ub2c8\uc998\uc5d0 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. 1. \uacbd\ub85c \ucd5c\uc801\ud654-\uac00\uc7a5 \uc9e7\uace0 \uc548\uc804\ud55c \uacbd\ub85c \ucc3e\uae30. 2. \ud0c0\uc774\ubc0d-\uc774\ub3d9 \uc7a5\uc560\ubb3c\uacfc \ud30c\uc6cc\uc5c5 \uc608\uce21. 3. \uc790\uc6d0 \uad00\ub9ac-\ub3d9\uc804\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0 \uc0ac\uc6a9. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 20\uc5d0\uc11c\ub294 \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \ub9c8\uc2a4\ud130\ud558\uba74 \uae30\ub85d\uc801\uc778 \uc2dc\uac04 \ub0b4\uc5d0 \ub808\ubca8\uc744 \uc644\ub8cc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \uacbd\ub85c \uae38\uc774\uc640 \uc7a5\uc560\ubb3c \ubc30\uce58\ub97c \ube44\uad50\ud558\uc5ec \ucd5c\uc0c1\uc758 \uacbd\ub85c\ub97c \ucc3e\uc73c\uc138\uc694.]"}, {"question": "\ub4dc\ub85c\uc6b0 \ud06c\ub798\uc2dc \ub808\uc774\uc2a4\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \uc5b4\ub5bb\uac8c \ucd5c\ub300\ud654\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub4dc\ub85c\uc6b0 \ud06c\ub798\uc2dc \ub808\uc774\uc2a4\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc138 \uac00\uc9c0 \uc694\uc18c\ub97c \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. 1. \uc644\ub8cc \uc2dc\uac04-\ub354 \ube60\ub978 \uc2dc\uac04\uc740 \ub354 \ub192\uc740 \uc810\uc218\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. 2. \ub3d9\uc804 \uc218\uc9d1-\uac01 \ub3d9\uc804\uc740 \uc810\uc218\uc5d0 \ub354\ud574\uc9d1\ub2c8\ub2e4. 3. \ubcf4\ub108\uc2a4 \ubaa9\ud45c-\uc774\ub7ec\ud55c \ubaa9\ud45c\ub97c \ub2ec\uc131\ud558\uba74 \ucd94\uac00 \uc810\uc218\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 15\uc5d0\uc11c 30\ucd08 \uc774\ub0b4\uc5d0 \ubaa8\ub4e0 \ub3d9\uc804\uc744 \uc218\uc9d1\ud558\uba74 \uc810\uc218\ub97c \uadf9\ub300\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\ubc95 \ube44\uad50: \uc11c\ub85c \ub2e4\ub978 \uacbd\ub85c\ub97c \ube44\uad50\ud558\uc5ec \ucd5c\uace0 \uc810\uc218\ub97c \uc5bb\ub294 \uacbd\ub85c\ub97c \ud30c\uc545\ud558\uc138\uc694.]"}, {"question": "\ub4dc\ub85c\uc6b0 \ud06c\ub798\uc2dc \ub808\uc774\uc2a4\uc758 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \uac1c\ubcc4\uc801\uc778 \uae30\uc220\uacfc \uc9c4\ud589\uc5d0 \ucd08\uc810\uc744 \ub9de\ucd94\ub294 \ubc18\uba74, \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \uacbd\uc7c1\uc744 \ub3c4\uc785\ud569\ub2c8\ub2e4. \uba40\ud2f0\ud50c\ub808\uc774\uc5b4\uc5d0\uc11c \uc2e4\uc2dc\uac04\uc73c\ub85c \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uc640 \uacbd\uc8fc\ud558\uace0, \uacbd\ub85c\ub97c \uadf8\ub9ac\ub294 \uac83\uc740 \ub2f9\uc2e0\uc758 \uc790\ub3d9\ucc28\uc640 \uc0c1\ub300\ubc29 \ubaa8\ub450\uc5d0\uac8c \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ub9e4\uce58\uc5d0\uc11c \uc7a5\uc560\ubb3c \uacbd\ub85c\ub97c \uadf8\ub9ac\uba74 \uc0c1\ub300\ubc29\uc758 \uc18d\ub3c4\ub97c \ub2a6\ucd9c \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4\ub294 \ub2e8\ub3c5 \ub9c8\ub77c\ud1a4\uc774\uace0, \uba40\ud2f0\ud50c\ub808\uc774\uc5b4\ub294 \uc9e7\uc740 \ub808\uc774\uc2a4\uc785\ub2c8\ub2e4.]"}, {"question": "\uc0c8\ub85c\uc6b4 \uae30\uae30\ub85c \ub4dc\ub85c\uc6b0 \ud06c\ub798\uc2dc \ub808\uc774\uc2a4 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: 1. \ub450 \uae30\uae30 \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815(\uc608: Google Play \ub610\ub294 Apple ID)\uc5d0 \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. 2. \uc774\uc804 \uae30\uae30\uc5d0\uc11c \uac8c\uc784\uc744 \uc5f4\uace0 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uc635\uc158\uc744 \ud1b5\ud574 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud558\uc138\uc694. 3. \uc0c8\ub85c\uc6b4 \uae30\uae30\uc5d0\uc11c \uac8c\uc784\uc744 \uc124\uce58\ud558\uace0 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc774\uc804 \ud734\ub300\uc804\ud654\uc5d0\uc11c \ub808\ubca8 25\ub97c \uc644\ub8cc\ud588\uc73c\uba74 \uc0c8\ub85c\uc6b4 \uae30\uae30\ub85c \uc790\ub3d9\uc73c\ub85c \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc758 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uc635\uc158\uc744 \ube44\uad50\ud574\ubcf4\uc138\uc694.]"}, {"question": "\ub4dc\ub85c\uc6b0 \ud06c\ub798\uc2dc \ub808\uc774\uc2a4\uc758 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\ub098\uc694?", "answer": "\ub4dc\ub85c\uc6b0 \ud06c\ub798\uc2dc \ub808\uc774\uc2a4\uc5d0\ub294 \uc228\uaca8\uc9c4 \ub808\ubca8\uacfc \ud76c\uadc0\ud55c \ud30c\uc6cc\uc5c5\uacfc \uac19\uc740 \uc5ec\ub7ec \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 12\uc5d0\uc11c \ud2b9\uc815 \ud328\ud134(\ubcc4\uacfc \uac19\uc740)\uc744 \uadf8\ub9ac\uba74 \uc228\uaca8\uc9c4 \ubcf4\ub108\uc2a4 \ub808\ubca8\uc744 \uc5f4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784 \ud658\uacbd\uc758 \ud2b9\uc774\ud55c \uae30\ud638\ub098 \ud328\ud134\uc744 \uc8fc\uc758 \uae4a\uac8c \uc0b4\ud3b4\ubcf4\uc138\uc694. [\ube44\uc720 \uc124\uba85: \uc774\uc2a4\ud130 \uc5d0\uadf8 \ucc3e\uae30\ub294 \ubcf4\ubb3c\ucc3e\uae30\uc640 \uac19\uc2b5\ub2c8\ub2e4. \uc778\ub0b4\uc2ec\uacfc \ud638\uae30\uc2ec\uc774 \uc911\uc694\ud569\ub2c8\ub2e4.]"}, {"question": "\ub4dc\ub85c\uc6b0 \ud06c\ub798\uc2dc \ub808\uc774\uc2a4\uc758 \ub09c\uc774\ub3c4 \uace1\uc120\uc740 \uc5b4\ub5bb\uac8c \uc9c4\ud589\ub418\uba70, \ud6c4\ubc18 \ub808\ubca8\uc5d0\uc11c\ub294 \uc5b4\ub5a4 \uc810\uc774 \uc608\uc0c1\ub418\ub098\uc694?", "answer": "\ub4dc\ub85c\uc6b0 \ud06c\ub798\uc2dc \ub808\uc774\uc2a4\uc758 \ub09c\uc774\ub3c4\ub294 \uc810\uc9c4\uc801\uc73c\ub85c \uc99d\uac00\ud569\ub2c8\ub2e4. \ucd08\ubc18 \ub808\ubca8\uc740 \uae30\ubcf8\uc801\uc778 \uacbd\ub85c \uadf8\ub9ac\uae30\uc5d0 \ucd08\uc810\uc744 \ub9de\ucd94\ub294 \ubc18\uba74, \ud6c4\ubc18 \ub808\ubca8\uc5d0\uc11c\ub294 \ubcf5\uc7a1\ud55c \uc7a5\uc560\ubb3c\uacfc \uc2dc\uac04 \uc81c\uc57d\uc774 \ucd94\uac00\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 30\uc5d0\uc11c\ub294 \uc5ec\ub7ec \uc774\ub3d9 \uc7a5\uc560\ubb3c\uacfc \ub808\ubca8 \uc644\ub8cc \uc2dc\uac04 \uc81c\uc57d\uc5d0 \uc9c1\uba74\ud558\uac8c \ub429\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \ub2e8\uc21c\ud55c \ub808\ubca8\uc5d0\uc11c \ubcf5\uc7a1\ud55c \ub808\ubca8\ub85c\uc758 \uc9c4\ud589\uc744 \uc2dc\uac01\ud654\ud574\ubcf4\uc138\uc694.]"}, {"question": "\ub4dc\ub85c\uc6b0 \ud06c\ub798\uc2dc \ub808\uc774\uc2a4\uc5d0\uc11c \uc2e0\uaddc \ud50c\ub808\uc774\uc5b4\ub4e4\uc774 \ud754\ud788 \uc800\uc9c0\ub974\ub294 \uc2e4\uc218\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud53c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc2e0\uaddc \ud50c\ub808\uc774\uc5b4\ub4e4\uc740 \ud754\ud788 \ub2e4\uc74c\uacfc \uac19\uc740 \uc2e4\uc218\ub97c \ud569\ub2c8\ub2e4. 1. \uacbd\ub85c\ub97c \ub108\ubb34 \ube68\ub9ac \uadf8\ub824 \ucda9\ub3cc\ud569\ub2c8\ub2e4. 2. \ub3d9\uc804 \uc218\uc9d1\uc744 \ubb34\uc2dc\ud558\uc5ec \uc9c4\ud589\uc744 \uc81c\ud55c\ud569\ub2c8\ub2e4. 3. \ud544\uc218 \ud301\uc744 \uc81c\uacf5\ud558\ub294 \ud29c\ud1a0\ub9ac\uc5bc\uc744 \ubb34\uc2dc\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 3\uc5d0\uc11c \uacc4\ud68d \uc5c6\uc774 \uacbd\ub85c\ub97c \uadf8\ub9ac\ub824\uace0 \uc11c\ub450\ub974\uba74 \ucda9\ub3cc\uc774 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\ubc95 \ube44\uad50: \uc11c\ub450\ub974\ub294 \uacbd\ub85c\uc640 \uacc4\ud68d\ub41c \uacbd\ub85c\ub97c \ube44\uad50\ud558\uc5ec \uadf8 \ucc28\uc774\uc810\uc744 \uc54c\uc544\ubcf4\uc138\uc694.]"}]
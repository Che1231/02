[{"question": "\u5982\u4f55\u4f5c\u4e3a\u5b8c\u5168\u65b0\u624b\u5f00\u59cb\u73a9Draw Crash Race\uff1f", "answer": "\u8981\u5f00\u59cb\u73a9Draw Crash Race\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a1. \u4ece\u5e94\u7528\u5546\u5e97\u4e0b\u8f7d\u6e38\u620f\u30022. \u6253\u5f00\u6e38\u620f\u5e76\u5b8c\u6210\u6559\u7a0b\uff0c\u6559\u7a0b\u5c06\u6307\u5bfc\u4f60\u5b8c\u6210\u57fa\u672c\u7684\u63a7\u5236\u64cd\u4f5c\uff0c\u4f8b\u5982\u7ed8\u5236\u8def\u5f84\u548c\u907f\u5f00\u969c\u788d\u7269\u30023. \u4ece\u7b2c\u4e00\u4e2a\u5173\u5361\u5f00\u59cb\uff0c\u611f\u53d7\u6e38\u620f\u673a\u5236\u3002\u4f8b\u5982\uff0c\u57281\u7ea7\u4e2d\uff0c\u4f60\u9700\u8981\u7ed8\u5236\u4e00\u6761\u7b80\u5355\u7684\u8def\u5f84\u6765\u5f15\u5bfc\u4f60\u7684\u6c7d\u8f66\u5230\u8fbe\u7ec8\u70b9\u7ebf\u3002\u8bb0\u4f4f\uff0c\u719f\u80fd\u751f\u5de7\uff01[\u6bd4\u55bb\u8bf4\u660e\uff1a\u628a\u5b83\u60f3\u8c61\u6210\u5b66\u4e60\u9a91\u81ea\u884c\u8f66\u2014\u2014\u8981\u6162\u6162\u6765\uff0c\u7a33\u624e\u7a33\u6253\u3002]"}, {"question": "\u5728Draw Crash Race\u4e2d\u83b7\u5f97\u9ad8\u5206\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728Draw Crash Race\u4e2d\u83b7\u5f97\u9ad8\u5206\u9700\u8981\u7cbe\u51c6\u548c\u521b\u610f\u7684\u7ed3\u5408\u3002\u6b65\u9aa41\uff1a\u4ed4\u7ec6\u89c4\u5212\u4f60\u7684\u8def\u5f84\uff0c\u4ee5\u907f\u514d\u78b0\u649e\u5e76\u6536\u96c6\u786c\u5e01\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u52a0\u901f\u5668\u7b49\u9053\u5177\uff0c\u66f4\u5feb\u5730\u5b8c\u6210\u5173\u5361\u3002\u6b65\u9aa43\uff1a\u4e89\u53d6\u989d\u5916\u76ee\u6807\uff0c\u4f8b\u5982\u5728\u89c4\u5b9a\u7684\u65f6\u95f4\u5185\u5b8c\u6210\u5173\u5361\u3002\u4f8b\u5982\uff0c\u572810\u7ea7\u4e2d\uff0c\u7ed8\u5236\u4e00\u6761\u952f\u9f7f\u72b6\u7684\u8def\u5f84\u53ef\u4ee5\u5e2e\u52a9\u4f60\u8eb2\u907f\u969c\u788d\u7269\uff0c\u540c\u65f6\u6536\u96c6\u6240\u6709\u786c\u5e01\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u76f4\u7ebf\u8def\u5f84\u53ef\u80fd\u66f4\u5feb\uff0c\u4f46\u66f2\u7ebf\u8def\u5f84\u53ef\u4ee5\u83b7\u5f97\u66f4\u591a\u786c\u5e01\u3002]"}, {"question": "\u5373\u4f7f\u7ed8\u5236\u4e86\u8def\u5f84\uff0c\u4e3a\u4ec0\u4e48\u6211\u7684\u8f66\u5728Draw Crash Race\u4e2d\u8fd8\u662f\u4f1a\u4e0d\u65ad\u5730\u649e\u8f66\uff1f", "answer": "Draw Crash Race\u4e2d\u649e\u8f66\u901a\u5e38\u662f\u7531\u4e09\u4e2a\u5e38\u89c1\u9519\u8bef\u5f15\u8d77\u7684\uff1a1. \u7ed8\u5236\u7684\u8def\u5f84\u4e0e\u969c\u788d\u7269\u592a\u63a5\u8fd1\u30022. \u8f66\u8f86\u65e0\u6cd5\u5e73\u7a33\u901a\u8fc7\u7684\u6025\u8f6c\u5f2f\u30023. \u5ffd\u89c6\u79fb\u52a8\u7684\u969c\u788d\u7269\u3002\u4f8b\u5982\uff0c\u57285\u7ea7\u4e2d\uff0c\u9760\u8fd1\u6446\u9524\u7684\u8def\u5f84\u65f6\u673a\u628a\u63e1\u4e0d\u597d\u4f1a\u5bfc\u81f4\u649e\u8f66\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u5728\u79fb\u52a8\u969c\u788d\u7269\u5468\u56f4\u753b\u4e00\u4e2a\u5bbd\u9614\u7684\u66f2\u7ebf\uff0c\u4ee5\u786e\u4fdd\u5b89\u5168\u3002]"}, {"question": "\u5bf9\u4e8e\u9ad8\u7ea7\u73a9\u5bb6\u800c\u8a00\uff0cDraw Crash Race\u4e2d\u54ea\u4e9b\u6e38\u620f\u673a\u5236\u6700\u91cd\u8981\uff1f", "answer": "\u9ad8\u7ea7\u73a9\u5bb6\u5e94\u8be5\u4e13\u6ce8\u4e8e\u8fd9\u4e9b\u673a\u5236\uff1a1. \u8def\u5f84\u4f18\u5316\u2014\u2014\u627e\u5230\u6700\u77ed\u4e14\u6700\u5b89\u5168\u7684\u8def\u7ebf\u30022. \u65f6\u673a\u2014\u2014\u9884\u6d4b\u79fb\u52a8\u7684\u969c\u788d\u548c\u9053\u5177\u30023. \u8d44\u6e90\u7ba1\u7406\u2014\u2014\u6218\u7565\u6027\u5730\u4f7f\u7528\u786c\u5e01\u89e3\u9501\u5347\u7ea7\u3002\u4f8b\u5982\uff0c\u572820\u7ea7\u4e2d\uff0c\u638c\u63e1\u8fd9\u4e9b\u673a\u5236\u53ef\u4ee5\u5e2e\u52a9\u4f60\u6253\u7834\u8bb0\u5f55\u65f6\u95f4\u5b8c\u6210\u5173\u5361\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6bd4\u8f83\u8def\u5f84\u957f\u5ea6\u548c\u969c\u788d\u7269\u4f4d\u7f6e\uff0c\u627e\u5230\u6700\u4f73\u8def\u7ebf\u3002]"}, {"question": "Draw Crash Race\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u5de5\u4f5c\u7684\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u5927\u5316\u5f97\u5206\uff1f", "answer": "Draw Crash Race\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u4e09\u4e2a\u56e0\u7d20\uff1a1. \u5b8c\u6210\u65f6\u95f4\u2014\u2014\u66f4\u5feb\u7684\u5b8c\u6210\u65f6\u95f4\u610f\u5473\u7740\u66f4\u9ad8\u7684\u5206\u6570\u30022. \u786c\u5e01\u6536\u96c6\u2014\u2014\u6bcf\u4e2a\u786c\u5e01\u90fd\u4f1a\u589e\u52a0\u4f60\u7684\u5206\u6570\u30023. \u989d\u5916\u76ee\u6807\u2014\u2014\u5b8c\u6210\u8fd9\u4e9b\u76ee\u6807\u4f1a\u83b7\u5f97\u989d\u5916\u5206\u6570\u3002\u4f8b\u5982\uff0c\u572815\u7ea7\u4e2d\uff0c\u572830\u79d2\u5185\u5b8c\u6210\u5173\u5361\u5e76\u6536\u96c6\u6240\u6709\u786c\u5e01\u5c06\u6700\u5927\u5316\u4f60\u7684\u5f97\u5206\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6bd4\u8f83\u4e0d\u540c\u7684\u8def\u5f84\uff0c\u770b\u770b\u54ea\u6761\u8def\u5f84\u80fd\u83b7\u5f97\u6700\u9ad8\u5206\u6570\u3002]"}, {"question": "Draw Crash Race\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u5355\u4eba\u6a21\u5f0f\u4fa7\u91cd\u4e8e\u4e2a\u4eba\u6280\u80fd\u548c\u8fdb\u6b65\uff0c\u800c\u591a\u4eba\u6a21\u5f0f\u5f15\u5165\u4e86\u7ade\u4e89\u3002\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f60\u5c06\u5b9e\u65f6\u4e0e\u4ed6\u4eba\u7ade\u901f\uff0c\u4f60\u7ed8\u5236\u7684\u8def\u5f84\u4f1a\u5f71\u54cd\u4f60\u7684\u6c7d\u8f66\u548c\u5bf9\u624b\u3002\u4f8b\u5982\uff0c\u5728\u591a\u4eba\u5bf9\u6218\u4e2d\uff0c\u7ed8\u5236\u8def\u969c\u53ef\u4ee5\u51cf\u7f13\u5bf9\u624b\u7684\u901f\u5ea6\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u628a\u5355\u4eba\u6a21\u5f0f\u60f3\u8c61\u6210\u4e2a\u4eba\u9a6c\u62c9\u677e\uff0c\u591a\u4eba\u6a21\u5f0f\u5219\u50cf\u77ed\u8dd1\u6bd4\u8d5b\u3002]"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684Draw Crash Race\u8fdb\u5ea6\u8f6c\u79fb\u5230\u65b0\u8bbe\u5907\uff1f", "answer": "\u8981\u8f6c\u79fb\u8fdb\u5ea6\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a1. \u786e\u4fdd\u4f60\u5728\u4e24\u53f0\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u540c\u4e00\u4e2a\u5e10\u6237\uff08\u4f8b\u5982\uff0cGoogle Play\u6216Apple ID\uff09\u30022. \u5728\u65e7\u8bbe\u5907\u4e0a\u6253\u5f00\u6e38\u620f\uff0c\u5e76\u901a\u8fc7\u4e91\u7aef\u5b58\u6863\u9009\u9879\u540c\u6b65\u8fdb\u5ea6\u30023. \u5728\u65b0\u8bbe\u5907\u4e0a\u5b89\u88c5\u6e38\u620f\uff0c\u5e76\u767b\u5f55\u540c\u4e00\u4e2a\u5e10\u6237\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5df2\u7ecf\u5728\u65e7\u624b\u673a\u4e0a\u5b8c\u6210\u4e8625\u7ea7\uff0c\u5b83\u5c06\u81ea\u52a8\u540c\u6b65\u5230\u65b0\u8bbe\u5907\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6bd4\u8f83\u4e0d\u540c\u5e73\u53f0\u7684\u4e91\u5b58\u6863\u9009\u9879\u3002]"}, {"question": "Draw Crash Race\u4e2d\u7684\u9690\u85cf\u5f69\u86cb\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5982\u4f55\u627e\u5230\u5b83\u4eec\uff1f", "answer": "Draw Crash Race\u5305\u542b\u4e00\u4e9b\u5f69\u86cb\uff0c\u4f8b\u5982\u79d8\u5bc6\u5173\u5361\u548c\u7a00\u6709\u9053\u5177\u3002\u4f8b\u5982\uff0c\u572812\u7ea7\u4e2d\uff0c\u7ed8\u5236\u7279\u5b9a\u56fe\u6848\uff08\u4f8b\u5982\u661f\u661f\uff09\u53ef\u4ee5\u89e3\u9501\u9690\u85cf\u7684\u989d\u5916\u5173\u5361\u3002\u5bc6\u5207\u5173\u6ce8\u6e38\u620f\u4e2d\u73af\u5883\u4e2d\u7684\u4e0d\u5bfb\u5e38\u7b26\u53f7\u6216\u56fe\u6848\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5bfb\u627e\u5f69\u86cb\u5c31\u50cf\u89e3\u8c1c\u5bfb\u5b9d\u2014\u2014\u8010\u5fc3\u548c\u597d\u5947\u5fc3\u662f\u5173\u952e\u3002]"}, {"question": "Draw Crash Race\u7684\u96be\u5ea6\u66f2\u7ebf\u662f\u5982\u4f55\u6f14\u53d8\u7684\uff0c\u6211\u5e94\u8be5\u5728\u540e\u9762\u7684\u5173\u5361\u4e2d\u671f\u5f85\u4ec0\u4e48\uff1f", "answer": "Draw Crash Race\u7684\u96be\u5ea6\u4f1a\u9010\u6b65\u589e\u52a0\u3002\u65e9\u671f\u5173\u5361\u4fa7\u91cd\u4e8e\u57fa\u7840\u8def\u5f84\u7ed8\u5236\uff0c\u800c\u540e\u671f\u5173\u5361\u5219\u5f15\u5165\u4e86\u590d\u6742\u7684\u969c\u788d\u7269\u548c\u65f6\u95f4\u9650\u5236\u3002\u4f8b\u5982\uff0c\u572830\u7ea7\u4e2d\uff0c\u4f60\u5c06\u9762\u4e34\u591a\u91cd\u79fb\u52a8\u969c\u788d\u7269\u548c\u5b8c\u6210\u5173\u5361\u7684\u65f6\u95f4\u9650\u5236\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u5c06\u7b80\u5355\u7684\u5173\u5361\u8fc7\u6e21\u5230\u590d\u6742\u7684\u5173\u5361\u53ef\u89c6\u5316\u3002]"}, {"question": "\u65b0\u624b\u73a9\u5bb6\u5728Draw Crash Race\u4e2d\u6700\u5e38\u89c1\u7684\u9519\u8bef\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5982\u4f55\u907f\u514d\u5b83\u4eec\uff1f", "answer": "\u65b0\u624b\u73a9\u5bb6\u7ecf\u5e38\u72af\u8fd9\u4e9b\u9519\u8bef\uff1a1. \u7ed8\u5236\u8def\u5f84\u592a\u5feb\uff0c\u5bfc\u81f4\u649e\u8f66\u30022. \u5ffd\u7565\u786c\u5e01\u6536\u96c6\uff0c\u8fd9\u4f1a\u9650\u5236\u8fdb\u5ea6\u30023. \u5ffd\u7565\u6559\u7a0b\uff0c\u6559\u7a0b\u63d0\u4f9b\u4e86\u91cd\u8981\u7684\u6280\u5de7\u3002\u4f8b\u5982\uff0c\u57283\u7ea7\u4e2d\uff0c\u5728\u6ca1\u6709\u8ba1\u5212\u7684\u60c5\u51b5\u4e0b\u5306\u5fd9\u7ed8\u5236\u8def\u5f84\u4f1a\u5bfc\u81f4\u649e\u8f66\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6bd4\u8f83\u5306\u5fd9\u7684\u8def\u5f84\u4e0e\u8ba1\u5212\u7684\u8def\u5f84\uff0c\u89c2\u5bdf\u7ed3\u679c\u5dee\u5f02\u3002]"}]
[{"question": "\u521d\u5fc3\u8005\u5411\u3051\u306b\u3001\u30c9\u30ed\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u30ec\u30fc\u30b9\u3092\u59cb\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30c9\u30ed\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u30ec\u30fc\u30b9\u3092\u59cb\u3081\u308b\u624b\u9806\u306f\u4ee5\u4e0b\u306e\u3068\u304a\u308a\u3067\u3059\u30021. \u30a2\u30d7\u30ea\u30b9\u30c8\u30a2\u304b\u3089\u30b2\u30fc\u30e0\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u30022. \u30b2\u30fc\u30e0\u3092\u958b\u304d\u3001\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3092\u5b8c\u4e86\u3057\u307e\u3059\u3002\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3067\u306f\u3001\u30d1\u30b9\u3092\u63cf\u304f\u3053\u3068\u3084\u969c\u5bb3\u7269\u3092\u907f\u3051\u308b\u3053\u3068\u306a\u3069\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u304c\u8aac\u660e\u3055\u308c\u307e\u3059\u30023. \u6700\u521d\u306e\u30ec\u30d9\u30eb\u304b\u3089\u59cb\u3081\u3066\u3001\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u63b4\u307f\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb1\u3067\u306f\u3001\u8eca\u3092\u30b4\u30fc\u30eb\u30e9\u30a4\u30f3\u307e\u3067\u5c0e\u304f\u7c21\u5358\u306a\u30d1\u30b9\u3092\u63cf\u304d\u307e\u3059\u3002\u7df4\u7fd2\u3042\u308b\u306e\u307f\u3067\u3059\uff01[\u6bd4\u55a9\u8aac\u660e\uff1a\u81ea\u8ee2\u8eca\u306b\u4e57\u308b\u3053\u3068\u3092\u5b66\u3076\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u3086\u3063\u304f\u308a\u3068\u614e\u91cd\u306b\u59cb\u3081\u307e\u3057\u3087\u3046\u3002]"}, {"question": "\u30c9\u30ed\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u30ec\u30fc\u30b9\u3067\u9ad8\u5f97\u70b9\u3092\u53d6\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30c9\u30ed\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u30ec\u30fc\u30b9\u3067\u9ad8\u5f97\u70b9\u3092\u7372\u5f97\u3059\u308b\u306b\u306f\u3001\u6b63\u78ba\u3055\u3068\u5275\u9020\u6027\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30af\u30e9\u30c3\u30b7\u30e5\u3092\u907f\u3051\u3001\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u308b\u305f\u3081\u306b\u3001\u30d1\u30b9\u3092\u614e\u91cd\u306b\u8a08\u753b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u306a\u3069\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u3063\u3066\u3001\u30ec\u30d9\u30eb\u3092\u3088\u308a\u65e9\u304f\u30af\u30ea\u30a2\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6642\u9593\u5236\u9650\u306a\u3069\u306e\u30dc\u30fc\u30ca\u30b9\u76ee\u6a19\u3092\u76ee\u6307\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb10\u3067\u306f\u3001\u30b8\u30b0\u30b6\u30b0\u306e\u30d1\u30b9\u3092\u63cf\u304f\u3053\u3068\u3067\u969c\u5bb3\u7269\u3092\u907f\u3051\u306a\u304c\u3089\u3059\u3079\u3066\u306e\u786c\u8ca8\u3092\u96c6\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u307e\u3063\u3059\u3050\u306a\u9053\u306e\u65b9\u304c\u901f\u3044\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u304c\u3001\u30ab\u30fc\u30d6\u3092\u63cf\u304f\u3053\u3068\u3067\u3088\u308a\u591a\u304f\u306e\u786c\u8ca8\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u305d\u3046\u3067\u3059\u3002]"}, {"question": "\u30d1\u30b9\u3092\u63cf\u3044\u305f\u5f8c\u3067\u3082\u3001\u306a\u305c\u79c1\u306e\u8eca\u306f\u30c9\u30ed\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u30ec\u30fc\u30b9\u3067\u4f55\u5ea6\u3082\u30af\u30e9\u30c3\u30b7\u30e5\u3057\u3066\u3057\u307e\u3046\u306e\u3067\u3059\u304b\uff1f", "answer": "\u30c9\u30ed\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u30ec\u30fc\u30b9\u3067\u30af\u30e9\u30c3\u30b7\u30e5\u3059\u308b\u4e3b\u306a\u539f\u56e0\u306f3\u3064\u3042\u308a\u307e\u3059\u30021. \u969c\u5bb3\u7269\u306b\u8fd1\u3065\u304d\u3059\u304e\u3066\u3044\u308b\u30d1\u30b9\u30022. \u8eca\u304c\u30b9\u30e0\u30fc\u30ba\u306b\u4e57\u308a\u8d8a\u3048\u3089\u308c\u306a\u3044\u6025\u306a\u30ab\u30fc\u30d6\u30023. \u79fb\u52d5\u4e2d\u306e\u969c\u5bb3\u7269\u3092\u7121\u8996\u3057\u3066\u3044\u308b\u3053\u3068\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb5\u3067\u306f\u3001\u63fa\u308c\u308b\u30cf\u30f3\u30de\u30fc\u306e\u8fd1\u304f\u306b\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u60aa\u304f\u30d1\u30b9\u3092\u63cf\u304f\u3068\u3001\u30af\u30e9\u30c3\u30b7\u30e5\u3057\u307e\u3059\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u79fb\u52d5\u3059\u308b\u969c\u5bb3\u7269\u306e\u5468\u308a\u3092\u5e45\u5e83\u3044\u30ab\u30fc\u30d6\u3092\u63cf\u304f\u3088\u3046\u306b\u3057\u307e\u3057\u3087\u3046\u3002]"}, {"question": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u3001\u30c9\u30ed\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u30ec\u30fc\u30b9\u3067\u6700\u3082\u91cd\u8981\u306a\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u6b21\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u304f\u3060\u3055\u3044\u30021. \u30d1\u30b9\u6700\u9069\u5316\uff1a\u6700\u77ed\u3067\u5b89\u5168\u306a\u30eb\u30fc\u30c8\u3092\u898b\u3064\u3051\u308b\u30022. \u30bf\u30a4\u30df\u30f3\u30b0\uff1a\u79fb\u52d5\u4e2d\u306e\u969c\u5bb3\u7269\u3084\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4e88\u6e2c\u3059\u308b\u30023. \u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\uff1a\u786c\u8ca8\u3092\u4f7f\u3063\u3066\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u6226\u7565\u7684\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb20\u3067\u306f\u3001\u3053\u308c\u3089\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u3067\u3001\u6700\u77ed\u6642\u9593\u3067\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u30d1\u30b9\u9577\u3068\u969c\u5bb3\u7269\u306e\u914d\u7f6e\u3092\u6bd4\u8f03\u3057\u3066\u3001\u6700\u9ad8\u306e\u30eb\u30fc\u30c8\u3092\u898b\u3064\u3051\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30c9\u30ed\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u30ec\u30fc\u30b9\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306e\u4ed5\u7d44\u307f\u3068\u3001\u305d\u308c\u3092\u6700\u5927\u9650\u306b\u6d3b\u7528\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30c9\u30ed\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u30ec\u30fc\u30b9\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u30013\u3064\u306e\u8981\u56e0\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u30021. \u30af\u30ea\u30a2\u30fc\u30bf\u30a4\u30e0\uff1a\u30bf\u30a4\u30e0\u304c\u901f\u3044\u307b\u3069\u3001\u9ad8\u5f97\u70b9\u30022. \u30b3\u30a4\u30f3\u53ce\u96c6\uff1a\u5404\u30b3\u30a4\u30f3\u306f\u30b9\u30b3\u30a2\u306b\u53cd\u6620\u3055\u308c\u307e\u3059\u30023. \u30dc\u30fc\u30ca\u30b9\u76ee\u6a19\uff1a\u3053\u308c\u3089\u3092\u9054\u6210\u3059\u308b\u3068\u3001\u8ffd\u52a0\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb15\u3067\u306f\u300130\u79d2\u4ee5\u5185\u306b\u3059\u3079\u3066\u306e\u786c\u8ca8\u3092\u96c6\u3081\u308b\u3068\u3001\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u3055\u307e\u3056\u307e\u306a\u30d1\u30b9\u3092\u6bd4\u8f03\u3057\u3066\u3001\u3069\u306e\u30d1\u30b9\u3067\u6700\u3082\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u5f97\u3089\u308c\u308b\u304b\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30c9\u30ed\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u30ec\u30fc\u30b9\u306e\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u3001\u500b\u3005\u306e\u30b9\u30ad\u30eb\u3068\u9032\u6b69\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u3044\u308b\u306e\u306b\u5bfe\u3057\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u7af6\u4e89\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3067\u306f\u3001\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u3067\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u7af6\u3063\u3066\u30ec\u30fc\u30b9\u3092\u884c\u3044\u3001\u3042\u306a\u305f\u304c\u63cf\u304f\u30d1\u30b9\u306f\u81ea\u5206\u306e\u8eca\u3060\u3051\u3067\u306a\u304f\u3001\u5bfe\u6226\u76f8\u624b\u306b\u3082\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30de\u30c3\u30c1\u3067\u306f\u3001\u30d6\u30ed\u30c3\u30af\u3092\u7f6e\u304f\u3053\u3068\u3067\u76f8\u624b\u3092\u9045\u304f\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u30bd\u30ed\u30de\u30e9\u30bd\u30f3\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u30b9\u30d7\u30ea\u30f3\u30c8\u30ec\u30fc\u30b9\u3068\u8003\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002]"}, {"question": "\u3069\u306e\u3088\u3046\u306b\u30c9\u30ed\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u30ec\u30fc\u30b9\u306e\u9032\u6357\u72b6\u6cc1\u3092\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u9032\u6357\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\u30021. \u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\uff08\u4f8b\uff1aGoogle Play\u307e\u305f\u306fApple ID\uff09\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u30022. \u53e4\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u30b2\u30fc\u30e0\u3092\u958b\u304d\u3001\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u4f7f\u7528\u3057\u3066\u9032\u6357\u72b6\u6cc1\u3092\u540c\u671f\u3057\u307e\u3059\u30023. \u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u30b2\u30fc\u30e0\u3092\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u3001\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u53e4\u3044\u643a\u5e2f\u96fb\u8a71\u3067\u30ec\u30d9\u30eb25\u3092\u30af\u30ea\u30a2\u3057\u3066\u3044\u305f\u5834\u5408\u3001\u305d\u308c\u306f\u81ea\u52d5\u7684\u306b\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u540c\u671f\u3055\u308c\u307e\u3059\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u3055\u307e\u3056\u307e\u306a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u6bd4\u8f03\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30c9\u30ed\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u30ec\u30fc\u30b9\u306e\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u308c\u3089\u3092\u898b\u3064\u3051\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30c9\u30ed\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u30ec\u30fc\u30b9\u306b\u306f\u3001\u79d8\u5bc6\u306e\u30ec\u30d9\u30eb\u3084\u30ec\u30a2\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306a\u3069\u306e\u3001\u3044\u304f\u3064\u304b\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb12\u3067\u306f\u3001\u7279\u5b9a\u306e\u30d1\u30bf\u30fc\u30f3\uff08\u661f\u306a\u3069\uff09\u3092\u63cf\u304f\u3053\u3068\u3067\u3001\u96a0\u3055\u308c\u305f\u30dc\u30fc\u30ca\u30b9\u30ec\u30d9\u30eb\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u3002\u30b2\u30fc\u30e0\u74b0\u5883\u306b\u3042\u308b\u73cd\u3057\u3044\u30b7\u30f3\u30dc\u30eb\u3084\u30d1\u30bf\u30fc\u30f3\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u306f\u3001\u5b9d\u63a2\u3057\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u5fcd\u8010\u3068\u597d\u5947\u5fc3\u304c\u5927\u5207\u3067\u3059\u3002]"}, {"question": "\u30c9\u30ed\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u30ec\u30fc\u30b9\u306e\u96e3\u6613\u5ea6\u66f2\u7dda\u306f\u3069\u306e\u3088\u3046\u306b\u5909\u5316\u3057\u307e\u3059\u304b\uff1f \u5f8c\u306e\u30ec\u30d9\u30eb\u3067\u306f\u4f55\u306b\u671f\u5f85\u3059\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u30c9\u30ed\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u30ec\u30fc\u30b9\u306e\u96e3\u6613\u5ea6\u306f\u5f90\u3005\u306b\u4e0a\u6607\u3057\u307e\u3059\u3002\u521d\u671f\u306e\u30ec\u30d9\u30eb\u306f\u3001\u57fa\u672c\u7684\u306a\u30d1\u30b9\u4f5c\u6210\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u3044\u308b\u306e\u306b\u5bfe\u3057\u3001\u5f8c\u306e\u30ec\u30d9\u30eb\u3067\u306f\u8907\u96d1\u306a\u969c\u5bb3\u7269\u3084\u6642\u9593\u5236\u9650\u304c\u8ffd\u52a0\u3055\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u30ec\u30d9\u30eb30\u3067\u306f\u3001\u8907\u6570\u306e\u79fb\u52d5\u969c\u5bb3\u7269\u3068\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u305f\u3081\u306e\u5236\u9650\u6642\u9593\u3068\u76f4\u9762\u3059\u308b\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u30b7\u30f3\u30d7\u30eb\u306a\u30ec\u30d9\u30eb\u304b\u3089\u8907\u96d1\u306a\u30ec\u30d9\u30eb\u3078\u306e\u79fb\u884c\u3092\u8996\u899a\u5316\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30c9\u30ed\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u30ec\u30fc\u30b9\u3067\u3001\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u6700\u3082\u3088\u304f\u72af\u3059\u9593\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u308c\u3089\u3092\u907f\u3051\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u591a\u304f\u306e\u5834\u5408\u3001\u3053\u308c\u3089\u306e\u9593\u9055\u3044\u3092\u72af\u3057\u307e\u3059\u30021. \u30d1\u30b9\u3092\u7d20\u65e9\u304f\u63cf\u304f\u3068\u3001\u30af\u30e9\u30c3\u30b7\u30e5\u306b\u3064\u306a\u304c\u308b\u30022. \u30b3\u30a4\u30f3\u53ce\u96c6\u3092\u7121\u8996\u3059\u308b\u3068\u3001\u9032\u6b69\u304c\u5236\u9650\u3055\u308c\u308b\u30023. \u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3092\u7121\u8996\u3059\u308b\u3068\u3001\u91cd\u8981\u306a\u30d2\u30f3\u30c8\u304c\u5f97\u3089\u308c\u306a\u3044\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb3\u3067\u30d1\u30b9\u3092\u8a08\u753b\u305b\u305a\u306b\u6025\u3044\u3067\u63cf\u304f\u3068\u3001\u30af\u30e9\u30c3\u30b7\u30e5\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6025\u3044\u3067\u63cf\u3044\u305f\u30d1\u30b9\u3068\u8a08\u753b\u7684\u306b\u63cf\u3044\u305f\u30d1\u30b9\u3092\u6bd4\u8f03\u3057\u3066\u3001\u7d50\u679c\u306e\u9055\u3044\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}]
[{"question": "\ucd08\uc2ec\uc790\ub85c\uc11c Taming.io \uac8c\uc784\uc744 \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Taming.io \uac8c\uc784\uc744 \uc2dc\uc791\ud558\ub824\uba74 \uba3c\uc800 \uacf5\uc2dd \uc6f9\uc0ac\uc774\ud2b8\ub098 \uc120\ud638\ud558\ub294 \uac8c\uc784 \ud50c\ub7ab\ud3fc\uc5d0 \uc811\uc18d\ud558\uc5ec \uacc4\uc815\uc744 \ub9cc\ub4dc\uc138\uc694. \ub85c\uadf8\uc778 \ud6c4 \uc11c\ubc84\ub97c \uc120\ud0dd\ud558\ub77c\ub294 \uba54\uc2dc\uc9c0\uac00 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \ucd08\uc2ec\uc790\ub294 \uacbd\uc7c1\uc744 \ud53c\ud558\uae30 \uc704\ud574 \ud50c\ub808\uc774\uc5b4 \uc218\uac00 \uc801\uc740 \uc11c\ubc84\ub97c \uc120\ud0dd\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \uac8c\uc784\uc5d0 \uc811\uc18d\ud55c \ud6c4\uc5d0\ub294 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc219\uc9c0\ud558\uc138\uc694. WASD \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc774\ub3d9\ud558\uace0, \ub9c8\uc6b0\uc2a4\ub85c \uc870\uc900 \ubc0f \uacf5\uaca9\ud558\uace0, \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \uc0ac\uc6a9\ud558\uc5ec \ubb3c\uccb4\uc640 \uc0c1\ud638 \uc791\uc6a9\ud569\ub2c8\ub2e4. \uc2dc\uc791 \uc804\ub7b5\uc73c\ub85c\ub294 \ub098\ubb34\uc640 \ub3cc\uacfc \uac19\uc740 \uc790\uc6d0\uc744 \ubaa8\uc544 \uae30\ubcf8 \ub3c4\uad6c\uc640 \ubb34\uae30\ub97c \uc81c\uc791\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ucd08\uae30 \ub2e8\uacc4\uc5d0\uc11c \ub098\ubb34 \uac80\uc744 \uc81c\uc791\ud558\uba74 \uc57c\uc0dd \ub3d9\ubb3c\uacfc\uc758 \uc0dd\uc874 \uac00\ub2a5\uc131\uc774 \ud06c\uac8c \ud5a5\uc0c1\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Taming.io\uc5d0\uc11c \ub3d9\ubb3c\uc744 \uae38\ub4e4\uc774\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Taming.io\uc5d0\uc11c \ub3d9\ubb3c\uc744 \uae38\ub4e4\uc774\ub294 \uac83\uc740 \uc778\ub0b4\uc640 \uc804\ub7b5\uc758 \uc870\ud569\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \uae38\ub4e4\uc774\uace0 \uc2f6\uc740 \ub3d9\ubb3c\uc744 \ud655\uc778\ud558\uace0 \ud574\ub2f9 \ub3d9\ubb3c\uc774 \uc120\ud638\ud558\ub294 \uc74c\uc2dd\uacfc \uac19\uc740 \ud544\uc694\ud55c \uc790\uc6d0\uc744 \ud655\ubcf4\ud558\uc138\uc694. 2\ub2e8\uacc4: \ub3d9\ubb3c\uc744 \ub180\ub77c\uac8c \ud558\uc9c0 \uc54a\ub3c4\ub85d \uc870\uc2ec\uc2a4\ub7fd\uac8c \uc811\uadfc\ud558\uc138\uc694. \uc0c1\ud638 \uc791\uc6a9 \ud0a4(\uc2a4\ud398\uc774\uc2a4\ubc14)\ub97c \uc0ac\uc6a9\ud558\uc5ec \uba39\uc774\ub97c \uc81c\uacf5\ud558\uc138\uc694. 3\ub2e8\uacc4: \uae38\ub4e4\uc774\uae30 \uacfc\uc815\uc774 \uc644\ub8cc\ub420 \ub54c\uae4c\uc9c0 \uc9c0\uc18d\uc801\uc73c\ub85c \uba39\uc774\ub97c \uc81c\uacf5\ud558\uba74\uc11c \uc810\uc9c4\uc801\uc73c\ub85c \ub3d9\ubb3c\uacfc\uc758 \uac70\ub9ac\ub97c \uc904\uc774\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub291\ub300\ub97c \uae38\ub4e4\uc774\ub824\uba74 \ub0a0\uace0\uae30\ub97c \ud544\uc694\ub85c \ud558\uace0, \uc9c0\uc18d\uc801\uc73c\ub85c \ub0a0\uace0\uae30\ub97c \uc8fc\uba74 \uacb0\uad6d \ub291\ub300\ub97c \uc790\uc2e0\uc758 \ub3d9\ubc18\uc790\ub85c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uae30\uc5b5\ud558\uc138\uc694, \ub2e4\ub978 \ub3d9\ubb3c\ub4e4\uc740 \uac01\uae30 \ub2e4\ub978 \uae38\ub4e4\uc774\uae30 \uc694\uad6c\uc0ac\ud56d\uc744 \uac00\uc9c0\uace0 \uc788\uc73c\ubbc0\ub85c \ud56d\uc0c1 \uc801\uc808\ud55c \uc790\uc6d0\uc744 \uc900\ube44\ud558\uc138\uc694."}, {"question": "Taming.io\uc5d0\uc11c \uc790\uc6d0 \uad00\ub9ac\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Taming.io\uc5d0\uc11c \uc790\uc6d0 \uad00\ub9ac\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \uac8c\uc784 \uc0dd\uc874, \uc81c\uc791 \ubc0f \uc9c4\ud589\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc790\uc6d0 \uad00\ub9ac\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc6b0\uc120 \ub098\ubb34, \ub3cc, \uc74c\uc2dd\uacfc \uac19\uc740 \ud544\uc218 \uc790\uc6d0 \uc218\uc9d1\uc5d0 \uc6b0\uc120\uc21c\uc704\ub97c \ub450\uc138\uc694. \uc778\ubca4\ud1a0\ub9ac \ucd94\uc801\uc744 \uc704\ud55c \uad6c\uc131\ud45c\ub97c \uc0ac\uc6a9\ud558\uc5ec \uade0\ud615 \uc7a1\ud78c \uc790\uc6d0 \uc7ac\uace0\ub97c \ud655\ubcf4\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub3c4\uad6c\uc640 \ubb34\uae30\ub97c \uc81c\uc791\ud558\ub294 \ub370 \ud544\uc694\ud55c \ub098\ubb34\uc640 \uac74\ubb3c\uc744 \uc704\ud55c \ub3cc\uc744 \ud56d\uc0c1 \uc608\ube44\ub85c \ubcf4\uad00\ud558\uc138\uc694. \ub610\ud55c, \uc778\ubca4\ud1a0\ub9ac\uc5d0 \ubd88\ud544\uc694\ud55c \ubb3c\ud488\uc744 \uacfc\ub3c4\ud558\uac8c \uc218\uc9d1\ud558\uc5ec \ud63c\ub780\uc2a4\ub7fd\uac8c \ub9cc\ub4dc\ub294 \uac83\uc744 \ud53c\ud558\uc138\uc694. \ud6a8\uc728\uc801\uc778 \uc790\uc6d0 \uad00\ub9ac\ub97c \ud1b5\ud574 \uc0dd\uc874\ub825\uc740 \ud5a5\uc0c1\ub418\uace0 \uac8c\uc784 \uc9c4\ud589\ub3c4 \uc6d0\ud65c\ud558\uac8c \uc774\ub8e8\uc5b4\uc9d1\ub2c8\ub2e4."}, {"question": "Taming.io\uc5d0\uc11c \uc5b4\ub5a4 \ub3c4\uad6c\uc640 \ubb34\uae30\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \uc81c\uc791\ud574\uc57c \ud558\ub098\uc694?", "answer": "Taming.io\uc5d0\uc11c \uc0dd\uc874\uacfc \uc9c4\ud589\uc744 \uc704\ud574 \ub3c4\uad6c\uc640 \ubb34\uae30 \uc81c\uc791\uc5d0 \uc6b0\uc120\uc21c\uc704\ub97c \ub450\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc6b0\uc120 \ub098\ubb34 \uace1\uad2d\uc774\uc640 \ub3c4\ub07c\ub97c \uc81c\uc791\ud558\uc138\uc694. \uc774\ub294 \ub098\ubb34\uc640 \ub3cc\uc744 \uc218\uc9d1\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uadf8\ub2e4\uc74c\uc5d0\ub294 \uc57c\uc0dd \ub3d9\ubb3c\uc5d0 \ub300\ud55c \uae30\ubcf8\uc801\uc778 \ubc29\uc5b4\ub97c \uc704\ud574 \ub098\ubb34 \uac80\uc744 \uc81c\uc791\ud558\uc138\uc694. \uc9c4\ud589\ud558\uba74\uc11c \ub3cc \ub3c4\uad6c\uc640 \ubb34\uae30\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc5ec \ud6a8\uc728\uc131\uacfc \ub0b4\uad6c\uc131\uc744 \ub192\uc774\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub3cc \uac80\uc740 \ub098\ubb34 \uac80\ubcf4\ub2e4 \uacf5\uaca9\ub825\uc774 \ub192\uc544 \uc804\ud22c\uc5d0\uc11c \ub354 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. \ud56d\uc0c1 \ud544\uc694\ud55c \uc790\uc6d0\uc744 \ud655\ubcf4\ud558\uace0, \uac8c\uc784 \ub0b4\uc5d0\uc11c \ud6a8\uc728\uc131\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \uc81c\uc791 \uc21c\uc11c\ub97c \uacc4\ud68d\ud558\uc138\uc694."}, {"question": "Taming.io\uc5d0\uc11c \uae38\ub4e4\uc774\uae30 \uba54\ucee4\ub2c8\uc998\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uc5b4\ub5a4 \uc774\uc810\uc774 \uc788\ub098\uc694?", "answer": "Taming.io\uc758 \uae38\ub4e4\uc774\uae30 \uba54\ucee4\ub2c8\uc998\uc744 \ud1b5\ud574 \ud50c\ub808\uc774\uc5b4\ub294 \uc57c\uc0dd \ub3d9\ubb3c\uc744 \uae38\ub4e4\uc5ec \ub2e4\uc591\ud55c \uc791\uc5c5\uc744 \ub3c4\uc640\uc8fc\ub294 \ub3d9\ubc18\uc790\ub85c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub3d9\ubb3c\uc744 \uae38\ub4e4\uc774\ub824\uba74 \uae38\ub4e4\uc774\uae30 \uacfc\uc815\uc774 \uc644\ub8cc\ub420 \ub54c\uae4c\uc9c0 \ubc18\ubcf5\uc801\uc73c\ub85c \uc120\ud638\ud558\ub294 \uba39\uc774\ub97c \uc81c\uacf5\ud574\uc57c \ud569\ub2c8\ub2e4. \uae38\ub4e4\uc778 \ud6c4\uc5d0\ub294 \ub3d9\ubb3c\uc774 \ub2f9\uc2e0\uc744 \ub530\ub77c\uc624\uba70, \uc801\uc744 \uacf5\uaca9\ud558\uac70\ub098 \uc790\uc6d0\uc744 \uc218\uc9d1\ud558\ub294 \ub4f1\uc758 \uba85\ub839\uc744 \uc218\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uae38\ub4e4\uc778 \ub291\ub300\ub294 \uc801\ub300\uc801\uc778 \uc0dd\ubb3c\uccb4\ub97c \ubc29\uc5b4\ud558\ub294 \ub370 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc73c\uba70, \uae38\ub4e4\uc778 \uacf0\uc740 \ub098\ubb34\ub97c \ub354 \ud6a8\uc728\uc801\uc73c\ub85c \uc218\uc9d1\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub3d9\ubb3c\uc744 \uae38\ub4e4\uc774\ub294 \uac83\uc740 \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uace0 \uc0dd\uc874 \ubc0f \uc790\uc6d0 \uad00\ub9ac\uc5d0 \uc804\ub7b5\uc801\uc778 \uc774\uc810\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}, {"question": "Taming.io\uc758 \uc5ec\ub7ec \uc11c\ubc84 \uac04 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Taming.io\uc758 \uc5ec\ub7ec \uc11c\ubc84 \uac04 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ud50c\ub808\uc774\uc5b4 \uc218, \uc790\uc6d0 \uc720\ubb34 \ubc0f \uacbd\uc7c1 \uc218\uc900\uc785\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4 \uc218\uac00 \uc801\uc740 \uc11c\ubc84\ub294 \ucd08\uc2ec\uc790\uc5d0\uac8c \uc774\uc0c1\uc801\uc785\ub2c8\ub2e4. \uc65c\ub0d0\ud558\uba74 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc744 \ubc30\uc6b0\uace0 \ubc29\ud574 \uc5c6\uc774 \uc790\uc6d0\uc744 \uc218\uc9d1\ud558\uae30 \uc704\ud55c \ub354\uc6b1 \ud3b8\uc548\ud55c \ud658\uacbd\uc744 \uc81c\uacf5\ud558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \ubc18\uba74, \uc778\uad6c\uac00 \ub9ce\uc740 \uc11c\ubc84\ub294 \ub354\uc6b1 \uacbd\uc7c1\uc801\uc774\uba70, \uc0dd\uc874\ud558\uace0 \ubc88\uc131\ud558\uae30 \uc704\ud574 \uace0\uae09 \uc804\ub7b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub610\ud55c, \uc77c\ubd80 \uc11c\ubc84\ub294 \ub2e4\ub978 \uc11c\ubc84\uc640 \uad6c\ubcc4\ub418\ub294 \ud2b9\ubcc4\ud55c \uc774\ubca4\ud2b8\ub098 \uace0\uc720\ud55c \uae30\ub2a5\uc744 \uac00\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc11c\ubc84\uc5d0\uc11c\ub294 \ud2b9\ubcc4 \uc774\ubca4\ud2b8\uac00 \uac1c\ucd5c\ub418\uc5b4 \ud76c\uadc0 \uc790\uc6d0\uc774 \ub354 \ud48d\ubd80\ud574\uc838 \ud50c\ub808\uc774\uc5b4\uac00 \uadc0\uc911\ud55c \uc790\uc6d0\uc744 \ub354 \ud6a8\uc728\uc801\uc73c\ub85c \uc218\uc9d1\ud560 \uc218 \uc788\ub294 \uae30\ud68c\ub97c \uc81c\uacf5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Taming.io\uc5d0\uc11c \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub85c\ubd80\ud130 \uae30\uc9c0\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \ubc29\uc5b4\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Taming.io\uc5d0\uc11c \uae30\uc9c0\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \ubc29\uc5b4\ud558\ub824\uba74 \uc804\ub7b5\uc801 \uacc4\ud68d\uacfc \uc790\uc6d0 \uad00\ub9ac\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ub420 \uac00\ub2a5\uc131\uc744 \ucd5c\uc18c\ud654\ud558\uae30 \uc704\ud574 \ud55c\uc801\ud55c \uc9c0\uc5ed\uc5d0 \uae30\uc9c0\ub97c \uac74\uc124\ud558\uc138\uc694. 2\ub2e8\uacc4: \uce68\uc785\uc790\ub97c \ub9c9\uae30 \uc704\ud574 \ubcbd\uacfc \ud568\uc815\uacfc \uac19\uc740 \ubc29\uc5b4 \uad6c\uc870\ubb3c\uc744 \uc124\uce58\ud558\uc138\uc694. 3\ub2e8\uacc4: \uc5b4\ub5a0\ud55c \uacf5\uaca9 \uac00\ub2a5\uc131\uc5d0 \ub300\ube44\ud558\uc5ec \uae30\uc9c0 \ub0b4\ubd80\uc5d0 \uc790\uc6d0\uacfc \ubb34\uae30\ub97c \uc800\uc7a5\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uae30\uc9c0 \uc8fc\ubcc0\uc5d0 \ubabb \ud568\uc815\uc744 \uc124\uce58\ud558\uba74 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uac00 \ubc29\uc5b4\ub97c \ub3cc\ud30c\ud560 \uc704\ud5d8\uc744 \ud06c\uac8c \uc904\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uc8fc\ubcc0\uc744 \ud56d\uc0c1 \uacbd\uacc4\ud558\uace0 \uc704\ud611\uc774 \ub2e4\uac00\uc624\ub294 \uc9d5\ud6c4\ub97c \uc8fc\uc2dc\ud558\uc138\uc694."}, {"question": "Taming.io\uc5d0\uc11c \ub300\ubd80\ubd84\uc758 \ud50c\ub808\uc774\uc5b4\uac00 \uac04\uacfc\ud558\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\ub098\uc694?", "answer": "Taming.io\uc5d0\ub294 \ub300\ubd80\ubd84\uc758 \ud50c\ub808\uc774\uc5b4\uac00 \uac04\uacfc\ud558\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uae30\ub2a5\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub7ec\ud55c \uae30\ub2a5 \uc911 \ud558\ub098\ub294 \ud2b9\uc815 \ubc14\uc774\uc634\uc5d0\uc11c \uc77c\ubc18\uc801\uc73c\ub85c \ubc1c\uacac\ub418\uc9c0 \uc54a\ub294 \ud76c\uadc0\ud558\uace0 \ub3c5\ud2b9\ud55c \ub3d9\ubb3c\uc744 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uae30\ub2a5\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub208\ub36e\uc778 \ubc14\uc774\uc634\uc744 \ud0d0\ud5d8\ud558\uba74 \uace0\uc720\ud55c \ub2a5\ub825\uc744 \uac00\uc9c4 \ud76c\uadc0\ud55c \ubd81\uadf9\uacf0\uc744 \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uc9c0\ub3c4 \uacf3\uacf3\uc5d0 \uc228\uaca8\uc9c4 \ub3d9\uad74\uc774 \uc788\ub294\ub370, \uc774\uacf3\uc5d0\ub294 \uadc0\uc911\ud55c \uc790\uc6d0\uacfc \ud76c\uadc0\ud55c \uc544\uc774\ud15c\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ub3d9\uad74\uc740 \ucc3e\uae30 \uc5b4\ub835\uc9c0\ub9cc, \uc2dc\uac04\uc744 \ub4e4\uc5ec \ud0d0\ud5d8\ud558\ub294 \uc0ac\ub78c\ub4e4\uc5d0\uac8c \uc0c1\ub2f9\ud55c \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uae30\ub2a5\uc744 \uc8fc\uc2dc\ud558\uba74 \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc774 \ud06c\uac8c \ud5a5\uc0c1\ub429\ub2c8\ub2e4."}, {"question": "Taming.io\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uc5b4\ub5bb\uac8c \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Taming.io\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uc774\uc804\ud558\ub294 \uac83\uc740 \uac04\ub2e8\ud569\ub2c8\ub2e4. \uba3c\uc800 \uac8c\uc784 \uacc4\uc815\uc744 Google \ub610\ub294 Facebook \uacc4\uc815\uacfc \uac19\uc740 \ubcf4\ud3b8\uc801\uc778 \ub85c\uadf8\uc778 \ubc29\uc2dd\uc5d0 \uc5f0\uacb0\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uc774\ub807\uac8c \ud558\uba74 \uc5ec\ub7ec \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\uc804\ud558\ub824\uba74 \uc0c8 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub3d9\uc77c\ud55c \uc790\uaca9 \uc99d\uba85\uc73c\ub85c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uc138\uc694. \uae38\ub4e4\uc778 \ub3d9\ubb3c, \uc790\uc6d0 \ubc0f \uc81c\uc791\ub41c \uc544\uc774\ud15c\uc744 \ud3ec\ud568\ud55c \uc9c4\ud589 \uc0c1\ud669\uc774 \uc790\ub3d9\uc73c\ub85c \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ubaa8\ubc14\uc77c\ub85c \ud50c\ub808\uc774\ub97c \uc804\ud658\ud560 \uacbd\uc6b0 \uc5f0\uacb0\ub41c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uba74 \ubaa8\ub4e0 \uac8c\uc784 \ub370\uc774\ud130\uac00 \uc6d0\ud65c\ud558\uac8c \uc804\uc1a1\ub418\uc5b4 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc783\uc9c0 \uc54a\uace0 \ubaa8\ud5d8\uc744 \uacc4\uc18d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Taming.io\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ubc14\uc774\uc634\uc744 \ud0d0\ud5d8\ud558\ub294 \ucd5c\uc120\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Taming.io\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ubc14\uc774\uc634\uc744 \ud0d0\ud5d8\ud558\ub824\uba74 \uc2e0\uc911\ud55c \uc900\ube44\uc640 \uc804\ub7b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \ubc1c\uc0dd\ud560 \uc218 \uc788\ub294 \uc5b4\ub824\uc6c0\uc5d0 \ub300\ube44\ud558\uc5ec \ud544\uc218 \ub3c4\uad6c\uc640 \ubb34\uae30\ub85c \ubb34\uc7a5\ud558\uc138\uc694. 2\ub2e8\uacc4: \uc7a5\uc2dc\uac04 \ud0d0\ud5d8 \ub3c4\uc911 \uc0dd\uc874\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 \uc74c\uc2dd\uacfc \uce58\ub8cc \uc544\uc774\ud15c\uc744 \ucda9\ubd84\ud788 \uc900\ube44\ud558\uc138\uc694. 3\ub2e8\uacc4: \uac01 \ubc14\uc774\uc634\uc774 \uc81c\uacf5\ud558\ub294 \uace0\uc720\ud55c \uc704\ud5d8\uacfc \uc790\uc6d0\uc5d0 \ub300\ud574 \uc778\uc9c0\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc0ac\ub9c9 \ubc14\uc774\uc634\uc5d0\ub294 \ubb3c\uc774 \ubd80\uc871\ud558\uc9c0\ub9cc \uad11\ubb3c\uc774 \ud48d\ubd80\ud560 \uc218 \uc788\uc73c\uba70, \uc815\uae00 \ubc14\uc774\uc634\uc740 \uc2dd\ubb3c\uc774 \ud48d\ubd80\ud558\uc9c0\ub9cc \uc704\ud5d8\ud55c \ud3ec\uc2dd\uc790\ub4e4\ub3c4 \ub9ce\uc2b5\ub2c8\ub2e4. \ud750\ub984\ub3c4\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud0d0\ud5d8 \uacbd\ub85c\ub97c \uacc4\ud68d\ud558\uba74 \ud6a8\uc728\uc801\uc73c\ub85c \ud0d0\uc0c9\ud558\uace0 \uac01 \ubc14\uc774\uc634\uc758 \uc774\uc810\uc744 \uadf9\ub300\ud654\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4. \uc608\uc0c1\uce58 \ubabb\ud55c \ub9cc\ub0a8\uc5d0 \ud56d\uc0c1 \uc8fc\uc758\ud558\uace0 \uc900\ube44\ud558\uc5ec \ud0d0\ud5d8\uc758 \ucd5c\ub300 \ud6a8\uacfc\ub97c \uc5bb\uc73c\uc138\uc694."}]
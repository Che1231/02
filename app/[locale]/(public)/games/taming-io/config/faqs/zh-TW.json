[{"question": "\u5982\u4f55\u8b93\u5b8c\u5168\u6c92\u6709\u7d93\u9a57\u7684\u65b0\u624b\u958b\u59cb\u73a9 Taming.io \u904a\u6232\uff1f", "answer": "\u8981\u958b\u59cb\u73a9 Taming.io\uff0c\u9996\u5148\uff0c\u8acb\u9020\u8a2a\u5b98\u65b9\u7db2\u7ad9\u6216\u60a8\u559c\u611b\u7684\u904a\u6232\u5e73\u53f0\uff0c\u4e26\u5efa\u7acb\u5e33\u6236\u3002\u767b\u5165\u5f8c\uff0c\u60a8\u5c07\u6703\u88ab\u8981\u6c42\u9078\u64c7\u4f3a\u670d\u5668\u3002\u5c0d\u65bc\u65b0\u624b\u4f86\u8aaa\uff0c\u9078\u64c7\u73a9\u5bb6\u4eba\u6578\u8f03\u5c11\u7684\u4f3a\u670d\u5668\u8f03\u70ba\u7406\u60f3\uff0c\u4ee5\u514d\u4e00\u958b\u59cb\u5c31\u9762\u81e8\u6fc0\u70c8\u7684\u7af6\u722d\u3002\u9032\u5165\u904a\u6232\u5f8c\uff0c\u8acb\u719f\u6089\u57fa\u672c\u64cd\u4f5c\uff1a\u4f7f\u7528 WASD \u9375\u79fb\u52d5\uff0c\u4f7f\u7528\u6ed1\u9f20\u7784\u6e96\u548c\u653b\u64ca\uff0c\u4e26\u4f7f\u7528\u7a7a\u683c\u9375\u8207\u7269\u4ef6\u4e92\u52d5\u3002\u4f5c\u70ba\u958b\u59cb\u7684\u7b56\u7565\uff0c\u5c08\u6ce8\u65bc\u6536\u96c6\u6728\u6750\u548c\u77f3\u982d\u7b49\u8cc7\u6e90\uff0c\u4ee5\u88fd\u4f5c\u57fa\u672c\u5de5\u5177\u548c\u6b66\u5668\u3002\u4f8b\u5982\uff0c\u5728\u904a\u6232\u521d\u671f\u88fd\u4f5c\u6728\u528d\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u60a8\u5c0d\u6297\u91ce\u7378\u7684\u751f\u5b58\u6a5f\u6703\u3002"}, {"question": "\u5728 Taming.io \u4e2d\u99b4\u670d\u52d5\u7269\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728 Taming.io \u4e2d\u99b4\u670d\u52d5\u7269\u9700\u8981\u8010\u5fc3\u548c\u7b56\u7565\u7684\u7d50\u5408\u3002\u6b65\u9a5f\u4e00\uff1a\u78ba\u8a8d\u60a8\u60f3\u99b4\u670d\u7684\u52d5\u7269\uff0c\u4e26\u78ba\u4fdd\u60a8\u64c1\u6709\u5fc5\u8981\u7684\u8cc7\u6e90\uff0c\u4f8b\u5982\u8a72\u52d5\u7269\u559c\u6b61\u7684\u98fc\u6599\u3002\u6b65\u9a5f\u4e8c\uff1a\u8b39\u614e\u5730\u9760\u8fd1\u52d5\u7269\uff0c\u907f\u514d\u9a5a\u5687\u7260\u5011\u3002\u4f7f\u7528\u4e92\u52d5\u9375\uff08\u7a7a\u683c\u9375\uff09\u63d0\u4f9b\u98df\u7269\u3002\u6b65\u9a5f\u4e09\uff1a\u9010\u6f38\u7e2e\u77ed\u8207\u52d5\u7269\u7684\u8ddd\u96e2\uff0c\u6301\u7e8c\u63d0\u4f9b\u98df\u7269\uff0c\u76f4\u5230\u99b4\u670d\u904e\u7a0b\u5b8c\u6210\u3002\u4f8b\u5982\uff0c\u99b4\u670d\u72fc\u9700\u8981\u751f\u8089\uff0c\u6301\u7e8c\u63d0\u4f9b\u751f\u8089\u6700\u7d42\u5c07\u6703\u4f7f\u72fc\u6210\u70ba\u60a8\u7684\u5925\u4f34\u3002\u8acb\u8a18\u4f4f\uff0c\u4e0d\u540c\u7684\u52d5\u7269\u6709\u4e0d\u540c\u7684\u99b4\u670d\u9700\u6c42\uff0c\u56e0\u6b64\u8acb\u52d9\u5fc5\u6e96\u5099\u597d\u6b63\u78ba\u7684\u8cc7\u6e90\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u8cc7\u6e90\u7ba1\u7406\u5728 Taming.io \u4e2d\u81f3\u95dc\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u512a\u5316\u5b83\uff1f", "answer": "\u8cc7\u6e90\u7ba1\u7406\u5728 Taming.io \u4e2d\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u76f4\u63a5\u5f71\u97ff\u60a8\u5728\u904a\u6232\u4e2d\u7684\u751f\u5b58\u3001\u88fd\u4f5c\u548c\u9032\u5ea6\u3002\u8981\u512a\u5316\u8cc7\u6e90\u7ba1\u7406\uff0c\u9996\u5148\u61c9\u512a\u5148\u6536\u96c6\u6728\u6750\u3001\u77f3\u982d\u548c\u98df\u7269\u7b49\u5fc5\u9700\u6750\u6599\u3002\u4f7f\u7528\u914d\u7f6e\u8868\u4f86\u8ffd\u8e64\u60a8\u7684\u5eab\u5b58\uff0c\u78ba\u4fdd\u60a8\u64c1\u6709\u5e73\u8861\u7684\u8cc7\u6e90\u5132\u5099\u3002\u4f8b\u5982\uff0c\u59cb\u7d42\u4fdd\u7559\u4e00\u4e9b\u6728\u6750\u7528\u65bc\u88fd\u4f5c\u5de5\u5177\u548c\u6b66\u5668\uff0c\u4e26\u4fdd\u7559\u77f3\u982d\u7528\u65bc\u5efa\u9020\u5efa\u7bc9\u7269\u3002\u6b64\u5916\uff0c\u907f\u514d\u904e\u5ea6\u6536\u96c6\u4e0d\u5fc5\u8981\u7684\u7269\u54c1\uff0c\u4ee5\u514d\u5806\u6eff\u5eab\u5b58\u3002\u6709\u6548\u7684\u8cc7\u6e90\u7ba1\u7406\u4e0d\u50c5\u80fd\u589e\u5f37\u60a8\u7684\u751f\u5b58\u80fd\u529b\uff0c\u9084\u80fd\u8b93\u904a\u6232\u9032\u5ea6\u66f4\u52a0\u9806\u66a2\u3002"}, {"question": "\u5728 Taming.io \u4e2d\uff0c\u61c9\u8a72\u512a\u5148\u88fd\u4f5c\u54ea\u4e9b\u5de5\u5177\u548c\u6b66\u5668\uff1f", "answer": "\u5728 Taming.io \u4e2d\uff0c\u512a\u5148\u88fd\u4f5c\u5de5\u5177\u548c\u6b66\u5668\u5c0d\u65bc\u751f\u5b58\u548c\u9032\u5ea6\u81f3\u95dc\u91cd\u8981\u3002\u9996\u5148\u88fd\u4f5c\u6728\u982d\u7684\u65a7\u982d\u548c\u9435\u9318\uff0c\u56e0\u70ba\u5b83\u5011\u662f\u6536\u96c6\u6728\u6750\u548c\u77f3\u982d\u7684\u57fa\u672c\u5de5\u5177\u3002\u63a5\u4e0b\u4f86\uff0c\u5c08\u6ce8\u65bc\u88fd\u4f5c\u6728\u528d\uff0c\u7528\u65bc\u5c0d\u6297\u91ce\u7378\u7684\u57fa\u672c\u9632\u79a6\u3002\u96a8\u8457\u60a8\u7684\u9032\u5c55\uff0c\u5347\u7d1a\u5230\u77f3\u982d\u5de5\u5177\u548c\u6b66\u5668\uff0c\u4ee5\u63d0\u9ad8\u6548\u7387\u548c\u8010\u4e45\u6027\u3002\u4f8b\u5982\uff0c\u77f3\u528d\u7684\u653b\u64ca\u529b\u6bd4\u6728\u528d\u9ad8\uff0c\u4f7f\u5176\u5728\u6230\u9b25\u4e2d\u66f4\u6709\u6548\u3002\u52d9\u5fc5\u78ba\u4fdd\u60a8\u64c1\u6709\u5fc5\u8981\u7684\u8cc7\u6e90\uff0c\u4e26\u898f\u5283\u60a8\u7684\u88fd\u4f5c\u9806\u5e8f\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u904a\u6232\u6548\u7387\u3002"}, {"question": "Taming.io \u4e2d\u7684\u99b4\u670d\u6a5f\u5236\u5982\u4f55\u904b\u4f5c\uff0c\u4ee5\u53ca\u5176\u512a\u9ede\u662f\u4ec0\u9ebc\uff1f", "answer": "Taming.io \u7684\u99b4\u670d\u6a5f\u5236\u5141\u8a31\u73a9\u5bb6\u99b4\u670d\u91ce\u7378\uff0c\u5c07\u5176\u8b8a\u6210\u5354\u52a9\u57f7\u884c\u5404\u7a2e\u4efb\u52d9\u7684\u5925\u4f34\u3002\u8981\u99b4\u670d\u52d5\u7269\uff0c\u60a8\u9700\u8981\u53cd\u8986\u63d0\u4f9b\u5176\u559c\u6b61\u7684\u98fc\u6599\uff0c\u76f4\u5230\u99b4\u670d\u904e\u7a0b\u5b8c\u6210\u3002\u99b4\u670d\u5f8c\uff0c\u8a72\u52d5\u7269\u6703\u8ddf\u96a8\u60a8\uff0c\u4e26\u53ef\u4ee5\u63a5\u53d7\u547d\u4ee4\u57f7\u884c\u653b\u64ca\u6575\u4eba\u6216\u6536\u96c6\u8cc7\u6e90\u7b49\u52d5\u4f5c\u3002\u4f8b\u5982\uff0c\u99b4\u670d\u7684\u72fc\u53ef\u4ee5\u7528\u4f86\u62b5\u6297\u6575\u5c0d\u751f\u7269\uff0c\u800c\u99b4\u670d\u7684\u718a\u5247\u53ef\u4ee5\u7528\u65bc\u66f4\u6709\u6548\u5730\u6536\u96c6\u6728\u6750\u3002\u99b4\u670d\u52d5\u7269\u4e0d\u50c5\u80fd\u63d0\u5347\u60a8\u7684\u904a\u6232\u9ad4\u9a57\uff0c\u9084\u80fd\u589e\u5f37\u751f\u5b58\u548c\u8cc7\u6e90\u7ba1\u7406\u7684\u7b56\u7565\u512a\u52e2\u3002"}, {"question": "Taming.io \u4e2d\u7684\u5404\u7a2e\u4f3a\u670d\u5668\u4e4b\u9593\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u5225\uff1f", "answer": "Taming.io \u4e2d\u7684\u5404\u7a2e\u4f3a\u670d\u5668\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u5728\u65bc\u73a9\u5bb6\u6578\u91cf\u3001\u8cc7\u6e90\u8c50\u5ea6\u548c\u7af6\u722d\u7a0b\u5ea6\u3002\u73a9\u5bb6\u6578\u91cf\u8f03\u5c11\u7684\u4f3a\u670d\u5668\u975e\u5e38\u9069\u5408\u65b0\u624b\uff0c\u56e0\u70ba\u5b83\u5011\u63d0\u4f9b\u66f4\u8f15\u9b06\u7684\u74b0\u5883\uff0c\u8b93\u73a9\u5bb6\u5b78\u7fd2\u904a\u6232\u6a5f\u5236\u4e26\u6536\u96c6\u8cc7\u6e90\uff0c\u800c\u4e0d\u6703\u53d7\u5230\u592a\u591a\u5e72\u64fe\u3002\u9ad8\u73a9\u5bb6\u4eba\u6578\u7684\u4f3a\u670d\u5668\u5247\u66f4\u5177\u7af6\u722d\u6027\uff0c\u9700\u8981\u66f4\u5148\u9032\u7684\u7b56\u7565\u624d\u80fd\u751f\u5b58\u548c\u8301\u58ef\u6210\u9577\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u4f3a\u670d\u5668\u53ef\u80fd\u6709\u7279\u5b9a\u7684\u6d3b\u52d5\u6216\u7368\u7279\u7684\u529f\u80fd\uff0c\u4f7f\u5176\u8207\u5176\u4ed6\u4f3a\u670d\u5668\u6709\u6240\u5340\u5225\u3002\u4f8b\u5982\uff0c\u4f3a\u670d\u5668\u53ef\u80fd\u8209\u8fa6\u7279\u5b9a\u6d3b\u52d5\uff0c\u4f7f\u7a00\u6709\u8cc7\u6e90\u66f4\u591a\uff0c\u63d0\u4f9b\u73a9\u5bb6\u66f4\u6709\u6548\u7387\u5730\u6536\u96c6\u73cd\u8cb4\u6750\u6599\u7684\u6a5f\u6703\u3002"}, {"question": "\u5982\u4f55\u5728 Taming.io \u4e2d\u6709\u6548\u9632\u79a6\u73a9\u5bb6\u5c0d\u6211\u7684\u57fa\u5730\u7684\u653b\u64ca\uff1f", "answer": "\u5728 Taming.io \u4e2d\u6709\u6548\u5730\u9632\u79a6\u73a9\u5bb6\u5c0d\u60a8\u7684\u57fa\u5730\u7684\u653b\u64ca\u9700\u8981\u7b56\u7565\u898f\u5283\u548c\u8cc7\u6e90\u7ba1\u7406\u7684\u7d50\u5408\u3002\u6b65\u9a5f\u4e00\uff1a\u5c07\u60a8\u7684\u57fa\u5730\u5efa\u5728\u504f\u9060\u5730\u5340\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u6e1b\u5c11\u88ab\u5176\u4ed6\u73a9\u5bb6\u767c\u73fe\u7684\u6a5f\u7387\u3002\u6b65\u9a5f\u4e8c\uff1a\u5efa\u9020\u9632\u79a6\u7d50\u69cb\uff0c\u4f8b\u5982\u7246\u58c1\u548c\u9677\u9631\uff0c\u4ee5\u963b\u6b62\u5165\u4fb5\u8005\u3002\u6b65\u9a5f\u4e09\uff1a\u5728\u57fa\u5730\u5167\u5132\u5b58\u8cc7\u6e90\u548c\u6b66\u5668\uff0c\u4ee5\u78ba\u4fdd\u60a8\u5728\u4efb\u4f55\u6f5b\u5728\u653b\u64ca\u4e2d\u505a\u597d\u6e96\u5099\u3002\u4f8b\u5982\uff0c\u5728\u57fa\u5730\u5468\u570d\u8a2d\u7f6e\u5c16\u523a\u9677\u9631\u53ef\u4ee5\u986f\u8457\u964d\u4f4e\u5176\u4ed6\u73a9\u5bb6\u7a81\u7834\u9632\u79a6\u7684\u98a8\u96aa\u3002\u6b64\u5916\uff0c\u59cb\u7d42\u4fdd\u6301\u8b66\u60d5\u4e26\u76e3\u63a7\u5468\u570d\u74b0\u5883\uff0c\u4ee5\u4fbf\u53ca\u6642\u767c\u73fe\u4efb\u4f55\u5373\u5c07\u5230\u4f86\u7684\u5a01\u8105\u3002"}, {"question": "\u5728 Taming.io \u4e2d\uff0c\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\u6216\u5f69\u86cb\u662f\u5927\u591a\u6578\u73a9\u5bb6\u5ffd\u7565\u7684\uff1f", "answer": "Taming.io \u5305\u542b\u4e00\u4e9b\u96b1\u85cf\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u8a31\u591a\u73a9\u5bb6\u90fd\u6703\u5ffd\u7565\u3002\u5176\u4e2d\u4e00\u500b\u529f\u80fd\u662f\u80fd\u5920\u5728\u7279\u5b9a\u751f\u7269\u7fa4\u7cfb\u4e2d\u627e\u5230\u7a00\u6709\u4e14\u7368\u7279\u7684\u52d5\u7269\uff0c\u9019\u4e9b\u52d5\u7269\u901a\u5e38\u4e0d\u5bb9\u6613\u9047\u5230\u3002\u4f8b\u5982\uff0c\u63a2\u7d22\u51b0\u96ea\u751f\u7269\u7fa4\u7cfb\u53ef\u80fd\u6703\u8b93\u60a8\u767c\u73fe\u7f55\u898b\u7684\u5317\u6975\u718a\uff0c\u4e26\u80fd\u85c9\u6b64\u7372\u5f97\u7368\u7279\u7684\u6280\u80fd\u3002\u6b64\u5916\uff0c\u5730\u5716\u4e0a\u6563\u4f48\u8457\u96b1\u85cf\u7684\u5c71\u6d1e\uff0c\u5176\u4e2d\u5305\u542b\u73cd\u8cb4\u7684\u8cc7\u6e90\u548c\u7a00\u6709\u7269\u54c1\u3002\u9019\u4e9b\u6d1e\u7a74\u901a\u5e38\u5f88\u96e3\u627e\u5230\uff0c\u4f46\u5c0d\u65bc\u90a3\u4e9b\u82b1\u6642\u9593\u63a2\u7d22\u7684\u4eba\u4f86\u8aaa\uff0c\u6703\u7372\u5f97\u8c50\u539a\u7684\u56de\u5831\u3002\u7559\u610f\u9019\u4e9b\u96b1\u85cf\u529f\u80fd\u53ef\u4ee5\u5927\u5927\u63d0\u5347\u60a8\u7684\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u5982\u4f55\u5728 Taming.io \u4e2d\u5c07\u6211\u7684\u904a\u6232\u9032\u5ea6\u5f9e\u4e00\u500b\u5e73\u53f0\u9077\u79fb\u5230\u53e6\u4e00\u500b\u5e73\u53f0\uff1f", "answer": "\u5728 Taming.io \u4e2d\u5c07\u60a8\u7684\u904a\u6232\u9032\u5ea6\u5f9e\u4e00\u500b\u5e73\u53f0\u9077\u79fb\u5230\u53e6\u4e00\u500b\u5e73\u53f0\uff0c\u662f\u4e00\u500b\u7c21\u55ae\u7684\u904e\u7a0b\u3002\u9996\u5148\uff0c\u78ba\u4fdd\u60a8\u5df2\u5c07\u904a\u6232\u5e33\u6236\u9023\u7d50\u5230\u901a\u7528\u767b\u5165\u65b9\u5f0f\uff0c\u4f8b\u5982 Google \u6216 Facebook \u5e33\u6236\u3002\u9019\u8b93\u60a8\u53ef\u4ee5\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u5b58\u53d6\u60a8\u7684\u9032\u5ea6\u3002\u8981\u9077\u79fb\uff0c\u53ea\u9700\u4f7f\u7528\u76f8\u540c\u7684\u6191\u8b49\u767b\u5165\u65b0\u5e73\u53f0\u7684\u5e33\u6236\u5373\u53ef\u3002\u60a8\u7684\u9032\u5ea6\uff0c\u5305\u62ec\u99b4\u670d\u7684\u52d5\u7269\u3001\u8cc7\u6e90\u548c\u88fd\u4f5c\u7684\u7269\u54c1\uff0c\u5c07\u6703\u81ea\u52d5\u540c\u6b65\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9e\u96fb\u8166\u5207\u63db\u5230\u884c\u52d5\u88dd\u7f6e\u904a\u6232\uff0c\u4f7f\u7528\u5df2\u9023\u7d50\u7684\u5e33\u6236\u767b\u5165\u5c07\u6703\u9806\u5229\u5730\u8f49\u79fb\u6240\u6709\u904a\u6232\u8cc7\u6599\uff0c\u8b93\u60a8\u5728\u6c92\u6709\u4efb\u4f55\u9032\u5ea6\u640d\u5931\u7684\u60c5\u6cc1\u4e0b\u7e7c\u7e8c\u5192\u96aa\u3002"}, {"question": "\u5728 Taming.io \u4e2d\u63a2\u7d22\u65b0\u751f\u7269\u7fa4\u7cfb\u7684\u6700\u4f73\u5be6\u52d9\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728 Taming.io \u4e2d\u63a2\u7d22\u65b0\u751f\u7269\u7fa4\u7cfb\u9700\u8981\u4ed4\u7d30\u7684\u6e96\u5099\u548c\u7b56\u7565\u3002\u6b65\u9a5f\u4e00\uff1a\u6e96\u5099\u597d\u5fc5\u8981\u7684\u5de5\u5177\u548c\u6b66\u5668\u4ee5\u61c9\u5c0d\u53ef\u80fd\u9047\u5230\u7684\u4efb\u4f55\u6311\u6230\u3002\u6b65\u9a5f\u4e8c\uff1a\u5132\u5099\u98df\u7269\u548c\u6cbb\u7642\u7269\u54c1\uff0c\u4ee5\u78ba\u4fdd\u60a8\u7684\u5b89\u5168\uff0c\u9632\u6b62\u5728\u9577\u9014\u63a2\u96aa\u4e2d\u906d\u9047\u72c0\u6cc1\u3002\u6b65\u9a5f\u4e09\uff1a\u7559\u610f\u6bcf\u500b\u751f\u7269\u7fa4\u7cfb\u7368\u7279\u7684\u5371\u96aa\u548c\u8cc7\u6e90\u3002\u4f8b\u5982\uff0c\u6c99\u6f20\u751f\u7269\u7fa4\u7cfb\u53ef\u80fd\u6c34\u6e90\u7a00\u5c11\uff0c\u4f46\u7926\u7269\u8c50\u5bcc\uff1b\u800c\u53e2\u6797\u751f\u7269\u7fa4\u7cfb\u5247\u5bcc\u542b\u52d5\u690d\u7269\uff0c\u4f46\u4e5f\u6709\u5371\u96aa\u7684\u63a0\u98df\u52d5\u7269\u3002\u4f7f\u7528\u6d41\u7a0b\u5716\u898f\u5283\u60a8\u7684\u63a2\u7d22\u8def\u7dda\uff0c\u53ef\u4ee5\u5e6b\u52a9\u60a8\u6709\u6548\u5730\u5c0e\u822a\u4e26\u6700\u5927\u9650\u5ea6\u5730\u5229\u7528\u6bcf\u500b\u751f\u7269\u7fa4\u7cfb\u7684\u76ca\u8655\u3002\u59cb\u7d42\u4fdd\u6301\u8b39\u614e\uff0c\u4e26\u6e96\u5099\u597d\u61c9\u5c0d\u610f\u60f3\u4e0d\u5230\u7684\u906d\u9047\uff0c\u4ee5\u4fbf\u5145\u5206\u767c\u63ee\u60a8\u7684\u63a2\u7d22\u6f5b\u529b\u3002"}]
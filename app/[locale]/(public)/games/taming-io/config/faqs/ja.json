[{"question": "\u521d\u3081\u3066Taming.io\u3092\u59cb\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "Taming.io\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u307e\u305a\u516c\u5f0f\u30a6\u30a7\u30d6\u30b5\u30a4\u30c8\u307e\u305f\u306f\u304a\u597d\u307f\u306e\u30b2\u30fc\u30e0\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u30a2\u30af\u30bb\u30b9\u3057\u3001\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u4f5c\u6210\u3057\u307e\u3059\u3002\u30ed\u30b0\u30a4\u30f3\u5f8c\u3001\u30b5\u30fc\u30d0\u30fc\u3092\u9078\u629e\u3059\u308b\u3088\u3046\u306b\u6c42\u3081\u3089\u308c\u307e\u3059\u3002\u521d\u5fc3\u8005\u306e\u65b9\u306b\u306f\u3001\u521d\u671f\u306e\u7af6\u4e89\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u6570\u304c\u5c11\u306a\u3044\u30b5\u30fc\u30d0\u30fc\u3092\u9078\u629e\u3059\u308b\u3053\u3068\u3092\u304a\u52e7\u3081\u3057\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306b\u5165\u3063\u305f\u3089\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u899a\u3048\u307e\u3059\u3002\u79fb\u52d5\u306b\u306fWASD\u30ad\u30fc\u3001\u7167\u6e96\u3068\u653b\u6483\u306b\u306f\u30de\u30a6\u30b9\u3001\u30a2\u30a4\u30c6\u30e0\u3068\u306e\u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3\u306b\u306f\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u6700\u521d\u306e\u6226\u7565\u3068\u3057\u3066\u3001\u6728\u3084\u77f3\u306a\u3069\u306e\u8cc7\u6e90\u3092\u96c6\u3081\u3001\u57fa\u672c\u7684\u306a\u30c4\u30fc\u30eb\u3084\u6b66\u5668\u3092\u30af\u30e9\u30d5\u30c8\u3059\u308b\u306e\u306b\u96c6\u4e2d\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u521d\u671f\u306b\u6728\u306e\u5263\u3092\u30af\u30e9\u30d5\u30c8\u3059\u308b\u3068\u3001\u91ce\u751f\u52d5\u7269\u3068\u306e\u751f\u5b58\u7387\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002"}, {"question": "Taming.io\u3067\u52d5\u7269\u3092\u8abf\u6559\u3059\u308b\u6700\u9069\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Taming.io\u3067\u52d5\u7269\u3092\u8abf\u6559\u3059\u308b\u306b\u306f\u3001\u5fcd\u8010\u3068\u6226\u7565\u306e\u4e21\u65b9\u304c\u5fc5\u8981\u3067\u3059\u3002STEP1\uff1a\u8abf\u6559\u3057\u305f\u3044\u52d5\u7269\u3092\u7279\u5b9a\u3057\u3001\u305d\u306e\u52d5\u7269\u304c\u597d\u3080\u98df\u3079\u7269\u306a\u3069\u306e\u5fc5\u8981\u306a\u8cc7\u6e90\u3092\u78ba\u4fdd\u3057\u307e\u3059\u3002STEP2\uff1a\u52d5\u7269\u3092\u9a5a\u304b\u305b\u306a\u3044\u3088\u3046\u306b\u6ce8\u610f\u3057\u3066\u8fd1\u3065\u304d\u307e\u3059\u3002\u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3\u30ad\u30fc\uff08\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\uff09\u3092\u4f7f\u7528\u3057\u3066\u3001\u98df\u3079\u7269\u3092\u4e0e\u3048\u307e\u3059\u3002STEP3\uff1a\u52d5\u7269\u3068\u9593\u306e\u8ddd\u96e2\u3092\u5f90\u3005\u306b\u7e2e\u3081\u306a\u304c\u3089\u3001\u8abf\u6559\u304c\u5b8c\u4e86\u3059\u308b\u307e\u3067\u3001\u7d99\u7d9a\u3057\u3066\u98df\u3079\u7269\u3092\u4e0e\u3048\u7d9a\u3051\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u72fc\u3092\u8abf\u6559\u3059\u308b\u306b\u306f\u751f\u8089\u304c\u5fc5\u8981\u3067\u3042\u308a\u3001\u7d99\u7d9a\u7684\u306b\u4e0e\u3048\u308b\u3053\u3068\u3067\u3001\u3084\u304c\u3066\u72fc\u3092\u4ef2\u9593\u306b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u7570\u306a\u308b\u52d5\u7269\u306b\u306f\u305d\u308c\u305e\u308c\u7570\u306a\u308b\u8abf\u6559\u8981\u4ef6\u304c\u3042\u308b\u305f\u3081\u3001\u5e38\u306b\u9069\u5207\u306a\u8cc7\u6e90\u3092\u7528\u610f\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "Taming.io\u3067\u8cc7\u6e90\u7ba1\u7406\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u3069\u306e\u3088\u3046\u306b\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Taming.io\u3067\u8cc7\u6e90\u7ba1\u7406\u304c\u91cd\u8981\u306a\u306e\u306f\u3001\u751f\u5b58\u3001\u30af\u30e9\u30d5\u30c8\u3001\u30b2\u30fc\u30e0\u306e\u9032\u5c55\u306b\u76f4\u63a5\u5f71\u97ff\u3059\u308b\u305f\u3081\u3067\u3059\u3002\u8cc7\u6e90\u7ba1\u7406\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u307e\u305a\u3001\u6728\u6750\u3001\u77f3\u3001\u98df\u6599\u306a\u3069\u306e\u5fc5\u9808\u6750\u6599\u306e\u53ce\u96c6\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u3092\u8ffd\u8de1\u3057\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u8cc7\u6e90\u306e\u5728\u5eab\u3092\u78ba\u4fdd\u3059\u308b\u305f\u3081\u306b\u3001\u69cb\u6210\u8868\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30c4\u30fc\u30eb\u3084\u6b66\u5668\u306e\u30af\u30e9\u30d5\u30c8\u306b\u5fc5\u8981\u306a\u6728\u6750\u3001\u69cb\u9020\u7269\u306e\u5efa\u8a2d\u306b\u5fc5\u8981\u306a\u77f3\u3092\u5e38\u306b\u78ba\u4fdd\u3057\u3066\u304a\u304d\u307e\u3057\u3087\u3046\u3002\u307e\u305f\u3001\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u3092\u5727\u8feb\u3059\u308b\u975e\u5fc5\u9808\u30a2\u30a4\u30c6\u30e0\u306e\u904e\u5270\u306a\u53ce\u96c6\u3092\u907f\u3051\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u52b9\u7387\u7684\u306a\u8cc7\u6e90\u7ba1\u7406\u306f\u3001\u751f\u5b58\u3092\u5f37\u5316\u3059\u308b\u3060\u3051\u3067\u306a\u304f\u3001\u30b2\u30fc\u30e0\u5185\u3067\u306e\u30b9\u30e0\u30fc\u30ba\u306a\u9032\u884c\u3082\u53ef\u80fd\u306b\u3057\u307e\u3059\u3002"}, {"question": "Taming.io\u3067\u512a\u5148\u7684\u306b\u30af\u30e9\u30d5\u30c8\u3059\u3079\u304d\u30c4\u30fc\u30eb\u3068\u6b66\u5668\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Taming.io\u3067\u306f\u3001\u751f\u5b58\u3068\u9032\u5c55\u306e\u305f\u3081\u306b\u3001\u30c4\u30fc\u30eb\u3068\u6b66\u5668\u306e\u30af\u30e9\u30d5\u30c8\u3092\u512a\u5148\u3059\u308b\u306e\u306f\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u307e\u305a\u3001\u6728\u6750\u3068\u77f3\u306e\u63a1\u53d6\u306b\u4e0d\u53ef\u6b20\u306a\u6728\u306e\u30c4\u30eb\u30cf\u30b7\u3068\u65a7\u3092\u30af\u30e9\u30d5\u30c8\u3057\u307e\u3059\u3002\u6b21\u306b\u3001\u91ce\u751f\u52d5\u7269\u3078\u306e\u57fa\u672c\u7684
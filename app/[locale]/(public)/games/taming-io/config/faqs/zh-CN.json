[{"question": "\u65b0\u624b\u5982\u4f55\u5f00\u59cb\u5728Taming.io\u4e2d\u6e38\u620f\uff1f", "answer": "\u8981\u5f00\u59cb\u5728Taming.io\u4e2d\u6e38\u620f\uff0c\u9996\u5148\uff0c\u8bbf\u95ee\u5b98\u65b9\u7f51\u7ad9\u6216\u4f60\u504f\u597d\u7684\u6e38\u620f\u5e73\u53f0\uff0c\u521b\u5efa\u4e00\u4e2a\u8d26\u6237\u3002\u767b\u5f55\u540e\uff0c\u7cfb\u7edf\u4f1a\u63d0\u793a\u4f60\u9009\u62e9\u4e00\u4e2a\u670d\u52a1\u5668\u3002\u5bf9\u4e8e\u65b0\u624b\u6765\u8bf4\uff0c\u9009\u62e9\u73a9\u5bb6\u6570\u91cf\u8f83\u5c11\u7684\u670d\u52a1\u5668\u662f\u660e\u667a\u4e4b\u4e3e\uff0c\u53ef\u4ee5\u907f\u514d\u65e9\u671f\u7ade\u4e89\u3002\u8fdb\u5165\u6e38\u620f\u540e\uff0c\u719f\u6089\u57fa\u672c\u63a7\u5236\uff1a\u4f7f\u7528WASD\u952e\u79fb\u52a8\uff0c\u9f20\u6807\u7784\u51c6\u548c\u653b\u51fb\uff0c\u7a7a\u683c\u952e\u4e0e\u7269\u4f53\u4e92\u52a8\u3002\u4f5c\u4e3a\u5165\u95e8\u7b56\u7565\uff0c\u4e13\u6ce8\u4e8e\u6536\u96c6\u6728\u6750\u548c\u77f3\u5934\u7b49\u8d44\u6e90\uff0c\u6765\u5236\u4f5c\u57fa\u7840\u5de5\u5177\u548c\u6b66\u5668\u3002\u4f8b\u5982\uff0c\u65e9\u671f\u5236\u4f5c\u4e00\u628a\u6728\u5251\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u5bf9\u6297\u91ce\u517d\u7684\u751f\u5b58\u673a\u4f1a\u3002"}, {"question": "\u5728Taming.io\u4e2d\u9a6f\u670d\u52a8\u7269\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728Taming.io\u4e2d\u9a6f\u670d\u52a8\u7269\u9700\u8981\u8010\u5fc3\u548c\u7b56\u7565\u7684\u7ed3\u5408\u3002\u6b65\u9aa4\u4e00\uff1a\u786e\u5b9a\u4f60\u60f3\u9a6f\u670d\u7684\u52a8\u7269\uff0c\u5e76\u786e\u4fdd\u4f60\u62e5\u6709\u5fc5\u8981\u7684\u8d44\u6e90\uff0c\u4f8b\u5982\u52a8\u7269\u559c\u6b22\u7684\u98df\u7269\u3002\u6b65\u9aa4\u4e8c\uff1a\u8c28\u614e\u5730\u63a5\u8fd1\u52a8\u7269\uff0c\u907f\u514d\u60ca\u5413\u5b83\u3002\u4f7f\u7528\u4e92\u52a8\u952e\uff08\u7a7a\u683c\u952e\uff09\u63d0\u4f9b\u98df\u7269\u3002\u6b65\u9aa4\u4e09\uff1a\u9010\u6e10\u7f29\u77ed\u4f60\u548c\u52a8\u7269\u4e4b\u95f4\u7684\u8ddd\u79bb\uff0c\u540c\u65f6\u6301\u7eed\u63d0\u4f9b\u98df\u7269\uff0c\u76f4\u5230\u9a6f\u670d\u8fc7\u7a0b\u7ed3\u675f\u3002\u4f8b\u5982\uff0c\u9a6f\u670d\u72fc\u9700\u8981\u751f\u8089\uff0c\u6301\u7eed\u63d0\u4f9b\u751f\u8089\u6700\u7ec8\u4f1a\u8ba9\u72fc\u6210\u4e3a\u4f60\u7684\u4f19\u4f34\u3002\u8bb0\u4f4f\uff0c\u4e0d\u540c\u7684\u52a8\u7269\u6709\u4e0d\u540c\u7684\u9a6f\u670d\u8981\u6c42\uff0c\u6240\u4ee5\u4e00\u5b9a\u8981\u51c6\u5907\u597d\u6b63\u786e\u7684\u8d44\u6e90\u3002"}, {"question": "\u5728Taming.io\u4e2d\uff0c\u4e3a\u4ec0\u4e48\u8d44\u6e90\u7ba1\u7406\u81f3\u5173\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u4f18\u5316\uff1f", "answer": "\u5728Taming.io\u4e2d\uff0c\u8d44\u6e90\u7ba1\u7406\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u76f4\u63a5\u5f71\u54cd\u4f60\u7684\u751f\u5b58\u80fd\u529b\u3001\u5236\u4f5c\u80fd\u529b\u548c\u6e38\u620f\u8fdb\u5ea6\u3002\u8981\u4f18\u5316\u8d44\u6e90\u7ba1\u7406\uff0c\u9996\u5148\u8981\u4f18\u5148\u6536\u96c6\u50cf\u6728\u6750\u3001\u77f3\u5934\u548c\u98df\u7269\u7b49\u5fc5\u8981\u6750\u6599\u3002\u4f7f\u7528\u6e05\u5355\u8868\u8ddf\u8e2a\u4f60\u7684\u5e93\u5b58\uff0c\u786e\u4fdd\u4f60\u62e5\u6709\u5e73\u8861\u7684\u8d44\u6e90\u50a8\u5907\u3002\u4f8b\u5982\uff0c\u59cb\u7ec8\u4fdd\u7559\u6728\u6750\u7528\u4e8e\u5236\u4f5c\u5de5\u5177\u548c\u6b66\u5668\uff0c\u4fdd\u7559\u77f3\u5934\u7528\u4e8e\u5efa\u9020\u5efa\u7b51\u7269\u3002\u6b64\u5916\uff0c\u907f\u514d\u8fc7\u5ea6\u6536\u96c6\u4e0d\u5fc5\u8981\u7684\u7269\u54c1\uff0c\u8fd9\u4f1a\u4f7f\u4f60\u7684\u80cc\u5305\u6742\u4e71\u65e0\u7ae0\u3002\u6709\u6548\u7684\u8d44\u6e90\u7ba1\u7406\u4e0d\u4ec5\u589e\u5f3a\u4f60\u7684\u751f\u5b58\u80fd\u529b\uff0c\u8fd8\u80fd\u4f7f\u6e38\u620f\u8fdb\u5ea6\u66f4\u52a0\u987a\u5229\u3002"}, {"question": "\u5728Taming.io\u4e2d\uff0c\u6211\u5e94\u8be5\u4f18\u5148\u5236\u4f5c\u54ea\u4e9b\u5de5\u5177\u548c\u6b66\u5668\uff1f", "answer": "\u5728Taming.io\u4e2d\uff0c\u4f18\u5148\u5236\u4f5c\u5de5\u5177\u548c\u6b66\u5668\u5bf9\u4e8e\u751f\u5b58\u548c\u6e38\u620f\u8fdb\u5ea6\u81f3\u5173\u91cd\u8981\u3002\u9996\u5148\u5236\u4f5c\u6728\u5236\u9550\u548c\u65a7\u5934\uff0c\u56e0\u4e3a\u8fd9\u4e9b\u662f\u6536\u96c6\u6728\u6750\u548c\u77f3\u5934\u7684\u57fa\u7840\u3002\u63a5\u4e0b\u6765\uff0c\u4e13\u6ce8\u4e8e\u5236\u4f5c\u6728\u5251\uff0c\u7528\u4e8e\u5bf9\u6297\u91ce\u517d\u7684\u57fa\u672c\u9632\u5fa1\u3002\u968f\u7740\u4f60\u7684\u8fdb\u6b65\uff0c\u5347\u7ea7\u5230\u77f3\u5236\u5de5\u5177\u548c\u6b66\u5668\uff0c\u4ee5\u63d0\u9ad8\u6548\u7387\u548c\u8010\u4e45\u6027\u3002\u4f8b\u5982\uff0c\u77f3\u5251\u6bd4\u6728\u5251\u5177\u6709\u66f4\u597d\u7684\u653b\u51fb\u529b\uff0c\u4f7f\u5176\u5728\u6218\u6597\u4e2d\u66f4\u6709\u6548\u3002\u786e\u4fdd\u4f60\u62e5\u6709\u5fc5\u8981\u7684\u8d44\u6e90\uff0c\u5e76\u89c4\u5212\u4f60\u7684\u5236\u4f5c\u987a\u5e8f\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u4f60\u5728\u6e38\u620f\u4e2d\u7684\u6548\u7387\u3002"}, {"question": "Taming.io\u4e2d\u7684\u9a6f\u670d\u673a\u5236\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u5176\u597d\u5904\u662f\u4ec0\u4e48\uff1f", "answer": "Taming.io\u7684\u9a6f\u670d\u673a\u5236\u5141\u8bb8\u73a9\u5bb6\u9a6f\u670d\u91ce\u517d\uff0c\u5c06\u5b83\u4eec\u53d8\u6210\u52a9\u624b\uff0c\u5e2e\u52a9\u5b8c\u6210\u5404\u79cd\u4efb\u52a1\u3002\u8981\u9a6f\u670d\u52a8\u7269\uff0c\u4f60\u9700\u8981\u4e0d\u65ad\u5730\u63d0\u4f9b\u5b83\u559c\u6b22\u7684\u98df\u7269\uff0c\u76f4\u5230\u9a6f\u670d\u8fc7\u7a0b\u5b8c\u6210\u3002\u9a6f\u670d\u540e\uff0c\u52a8\u7269\u4f1a\u8ddf\u968f\u4f60\uff0c\u5e76\u53ef\u4ee5\u88ab\u547d\u4ee4\u6267\u884c\u653b\u51fb\u654c\u4eba\u6216\u6536\u96c6\u8d44\u6e90\u7b49\u884c\u52a8\u3002\u4f8b\u5982\uff0c\u9a6f\u670d\u7684\u72fc\u53ef\u4ee5\u7528\u6765\u9632\u5fa1\u654c\u5bf9\u751f\u7269\uff0c\u800c\u9a6f\u670d\u7684\u718a\u53ef\u4ee5\u5e2e\u52a9\u66f4\u6709\u6548\u5730\u6536\u96c6\u6728\u6750\u3002\u9a6f\u670d\u52a8\u7269\u4e0d\u4ec5\u589e\u5f3a\u4e86\u4f60\u7684\u6e38\u620f\u4f53\u9a8c\uff0c\u8fd8\u5728\u751f\u5b58\u548c\u8d44\u6e90\u7ba1\u7406\u4e2d\u63d0\u4f9b\u4e86\u6218\u7565\u4f18\u52bf\u3002"}, {"question": "Taming.io\u4e2d\u4e0d\u540c\u7684\u670d\u52a1\u5668\u4e4b\u95f4\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "Taming.io\u4e2d\u4e0d\u540c\u670d\u52a1\u5668\u7684\u5173\u952e\u533a\u522b\u5728\u4e8e\u73a9\u5bb6\u6570\u91cf\u3001\u8d44\u6e90\u4e30\u5bcc\u7a0b\u5ea6\u548c\u7ade\u4e89\u6fc0\u70c8\u7a0b\u5ea6\u3002\u73a9\u5bb6\u6570\u91cf\u8f83\u5c11\u7684\u670d\u52a1\u5668\u975e\u5e38\u9002\u5408\u65b0\u624b\uff0c\u56e0\u4e3a\u5b83\u4eec\u63d0\u4f9b\u4e86\u4e00\u4e2a\u66f4\u8f7b\u677e\u7684\u73af\u5883\uff0c\u53ef\u4ee5\u5b66\u4e60\u6e38\u620f\u673a\u5236\uff0c\u6536\u96c6\u8d44\u6e90\uff0c\u800c\u4e0d\u4f1a\u53d7\u5230\u592a\u591a\u5e72\u6270\u3002\u9ad8\u4eba\u6c14\u7684\u670d\u52a1\u5668\u5219\u66f4\u5177\u7ade\u4e89\u6027\uff0c\u9700\u8981\u66f4\u9ad8\u7ea7\u7684\u7b56\u7565\u624d\u80fd\u751f\u5b58\u548c\u53d1\u5c55\u3002\u6b64\u5916\uff0c\u4e00\u4e9b\u670d\u52a1\u5668\u53ef\u80fd\u62e5\u6709\u7279\u5b9a\u6d3b\u52a8\u6216\u72ec\u7279\u7684\u7279\u8272\u4f7f\u5176\u4e0e\u4f17\u4e0d\u540c\u3002\u4f8b\u5982\uff0c\u67d0\u4e2a\u670d\u52a1\u5668\u53ef\u80fd\u4e3e\u529e\u4e00\u4e2a\u7279\u6b8a\u6d3b\u52a8\uff0c\u4f7f\u5f97\u7a00\u6709\u8d44\u6e90\u66f4\u52a0\u4e30\u5bcc\uff0c\u8ba9\u73a9\u5bb6\u66f4\u5bb9\u6613\u5730\u6536\u96c6\u6709\u4ef7\u503c\u7684\u6750\u6599\u3002"}, {"question": "\u5982\u4f55\u5728Taming.io\u4e2d\u6709\u6548\u9632\u5fa1\u73a9\u5bb6\u7684\u653b\u51fb\uff1f", "answer": "\u5728Taming.io\u4e2d\u6709\u6548\u9632\u5fa1\u73a9\u5bb6\u653b\u51fb\u9700\u8981\u7ed3\u5408\u6218\u7565\u89c4\u5212\u548c\u8d44\u6e90\u7ba1\u7406\u3002\u6b65\u9aa4\u4e00\uff1a\u5c06\u4f60\u7684\u57fa\u5730\u5efa\u5728\u504f\u50fb\u5730\u5e26\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u88ab\u5176\u4ed6\u73a9\u5bb6\u53d1\u73b0\u7684\u673a\u4f1a\u3002\u6b65\u9aa4\u4e8c\uff1a\u5efa\u9020\u9632\u5fa1\u6027\u5efa\u7b51\u7269\uff0c\u4f8b\u5982\u56f4\u5899\u548c\u9677\u9631\uff0c\u4ee5\u963b\u6b62\u5165\u4fb5\u8005\u3002\u6b65\u9aa4\u4e09\uff1a\u5728\u4f60\u7684\u57fa\u5730\u4e2d\u50a8\u5b58\u8d44\u6e90\u548c\u6b66\u5668\uff0c\u4ee5\u786e\u4fdd\u4f60\u51c6\u5907\u597d\u5e94\u5bf9\u4efb\u4f55\u6f5c\u5728\u7684\u653b\u51fb\u3002\u4f8b\u5982\uff0c\u5728\u4f60\u7684\u57fa\u5730\u5468\u56f4\u653e\u7f6e\u9525\u5f62\u9677\u9631\u53ef\u4ee5\u663e\u8457\u964d\u4f4e\u5176\u4ed6\u73a9\u5bb6\u7a81\u7834\u4f60\u9632\u5fa1\u7684\u98ce\u9669\u3002\u6b64\u5916\uff0c\u4fdd\u6301\u8b66\u60d5\uff0c\u6ce8\u610f\u5468\u56f4\u4efb\u4f55\u6f5c\u5728\u5a01\u80c1\u7684\u8ff9\u8c61\u3002"}, {"question": "Taming.io\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u7684\u529f\u80fd\u6216\u5f69\u86cb\uff0c\u5927\u591a\u6570\u73a9\u5bb6\u90fd\u4f1a\u5ffd\u7565\uff1f", "answer": "Taming.io\u5305\u542b\u8bb8\u591a\u9690\u85cf\u7684\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u8bb8\u591a\u73a9\u5bb6\u90fd\u4f1a\u5ffd\u7565\u3002\u5176\u4e2d\u4e00\u4e2a\u529f\u80fd\u662f\u80fd\u591f\u5728\u7279\u5b9a\u751f\u7269\u7fa4\u7cfb\u4e2d\u53d1\u73b0\u7a00\u6709\u4e14\u72ec\u7279\u7684\u52a8\u7269\uff0c\u8fd9\u4e9b\u52a8\u7269\u5e76\u4e0d\u5e38\u89c1\u3002\u4f8b\u5982\uff0c\u63a2\u7d22\u96ea\u5730\u751f\u7269\u7fa4\u7cfb\u53ef\u80fd\u4f1a\u8ba9\u4f60\u53d1\u73b0\u53ef\u4ee5\u88ab\u9a6f\u670d\u7684\u7a00\u6709\u5317\u6781\u718a\uff0c\u62e5\u6709\u72ec\u7279\u7684\u6280\u80fd\u3002\u6b64\u5916\uff0c\u5730\u56fe\u4e0a\u6563\u5e03\u7740\u4e00\u4e9b\u9690\u85cf\u6d1e\u7a74\uff0c\u5176\u4e2d\u5305\u542b\u6709\u4ef7\u503c\u7684\u8d44\u6e90\u548c\u7a00\u6709\u7269\u54c1\u3002\u8fd9\u4e9b\u6d1e\u7a74\u901a\u5e38\u5f88\u96be\u627e\u5230\uff0c\u4f46\u5bf9\u4e8e\u90a3\u4e9b\u82b1\u65f6\u95f4\u63a2\u7d22\u7684\u4eba\u6765\u8bf4\u63d0\u4f9b\u4e86\u4e30\u539a\u7684\u56de\u62a5\u3002\u6ce8\u610f\u5bfb\u627e\u8fd9\u4e9b\u9690\u85cf\u7684\u529f\u80fd\uff0c\u53ef\u4ee5\u6781\u5927\u5730\u589e\u5f3a\u4f60\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684Taming.io\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u5e73\u53f0\u8fc1\u79fb\u5230\u53e6\u4e00\u4e2a\u5e73\u53f0\uff1f", "answer": "\u5c06\u4f60\u7684Taming.io\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u5e73\u53f0\u8fc1\u79fb\u5230\u53e6\u4e00\u4e2a\u5e73\u53f0\u662f\u4e00\u4e2a\u7b80\u5355\u7684\u8fc7\u7a0b\u3002\u9996\u5148\uff0c\u786e\u4fdd\u4f60\u5df2\u7ecf\u5c06\u4f60\u7684\u6e38\u620f\u8d26\u6237\u94fe\u63a5\u5230\u4e00\u4e2a\u901a\u7528\u7684\u767b\u5f55\u65b9\u6cd5\uff0c\u4f8b\u5982Google\u6216Facebook\u8d26\u6237\u3002\u8fd9\u5141\u8bb8\u4f60\u8de8\u4e0d\u540c\u5e73\u53f0\u8bbf\u95ee\u4f60\u7684\u8fdb\u5ea6\u3002\u8981\u8fc1\u79fb\uff0c\u53ea\u9700\u4f7f\u7528\u76f8\u540c\u7684\u51ed\u636e\u767b\u5f55\u65b0\u5e73\u53f0\u7684\u8d26\u6237\u3002\u4f60\u7684\u8fdb\u5ea6\uff0c\u5305\u62ec\u9a6f\u670d\u7684\u52a8\u7269\u3001\u8d44\u6e90\u548c\u5236\u4f5c\u7684\u7269\u54c1\uff0c\u5c06\u4f1a\u81ea\u52a8\u540c\u6b65\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4ecePC\u5e73\u53f0\u5207\u6362\u5230\u79fb\u52a8\u8bbe\u5907\uff0c\u4f7f\u7528\u4f60\u7684\u94fe\u63a5\u8d26\u6237\u767b\u5f55\u5c06\u65e0\u7f1d\u5730\u4f20\u8f93\u6240\u6709\u4f60\u7684\u6e38\u620f\u6570\u636e\uff0c\u8ba9\u4f60\u80fd\u591f\u7ee7\u7eed\u4f60\u7684\u5192\u9669\uff0c\u800c\u4e0d\u4f1a\u6709\u4efb\u4f55\u8fdb\u5ea6\u4e22\u5931\u3002"}, {"question": "\u5728Taming.io\u4e2d\u63a2\u7d22\u65b0\u751f\u7269\u7fa4\u7cfb\u7684\u6700\u4f73\u505a\u6cd5\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728Taming.io\u4e2d\u63a2\u7d22\u65b0\u751f\u7269\u7fa4\u7cfb\u9700\u8981\u4ed4\u7ec6\u7684\u51c6\u5907\u548c\u7b56\u7565\u3002\u6b65\u9aa4\u4e00\uff1a\u88c5\u5907\u5fc5\u8981\u7684\u5de5\u5177\u548c\u6b66\u5668\u6765\u5e94\u5bf9\u4f60\u53ef\u80fd\u9047\u5230\u7684\u4efb\u4f55\u6311\u6218\u3002\u6b65\u9aa4\u4e8c\uff1a\u50a8\u5b58\u98df\u7269\u548c\u6cbb\u7597\u7269\u54c1\uff0c\u4ee5\u786e\u4fdd\u4f60\u5728\u957f\u65f6\u95f4\u7684\u63a2\u7d22\u65c5\u7a0b\u4e2d\u751f\u5b58\u3002\u6b65\u9aa4\u4e09\uff1a\u4e86\u89e3\u6bcf\u4e2a\u751f\u7269\u7fa4\u7cfb\u63d0\u4f9b\u7684\u72ec\u7279\u5371\u9669\u548c\u8d44\u6e90\u3002\u4f8b\u5982\uff0c\u6c99\u6f20\u751f\u7269\u7fa4\u7cfb\u53ef\u80fd\u62e5\u6709\u7a00\u7f3a\u7684\u6c34\u6e90\uff0c\u4f46\u77ff\u7269\u4e30\u5bcc\uff0c\u800c\u4e1b\u6797\u751f\u7269\u7fa4\u7cfb\u5bcc\u542b\u690d\u7269\uff0c\u4f46\u4e5f\u5c45\u4f4f\u7740\u5371\u9669\u7684\u63a0\u98df\u8005\u3002\u4f7f\u7528\u6d41\u7a0b\u56fe\u8ba1\u5212\u4f60\u7684\u63a2\u7d22\u8def\u7ebf\u53ef\u4ee5\u5e2e\u52a9\u4f60\u6709\u6548\u5730\u5bfc\u822a\u5e76\u6700\u5927\u9650\u5ea6\u5730\u5229\u7528\u6bcf\u4e2a\u751f\u7269\u7fa4\u7cfb\u7684\u4f18\u52bf\u3002\u59cb\u7ec8\u4fdd\u6301\u8c28\u614e\uff0c\u5e76\u4e3a\u610f\u5916\u4e8b\u4ef6\u505a\u597d\u51c6\u5907\uff0c\u4ee5\u5145\u5206\u5229\u7528\u4f60\u7684\u63a2\u7d22\u3002"}]
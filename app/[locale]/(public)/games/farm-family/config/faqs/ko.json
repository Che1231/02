[{"question": "Farm Family\ub294 \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud558\uba70, \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub294 \uac00\uc774\ub4dc\ub77c\uc778(\ucd08\uc2ec\uc790 \uad00\uc810)\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Farm Family \uc2dc\uc791\uc740 \ub9e4\uc6b0 \uac04\ub2e8\ud574\uc694! \uba3c\uc800, \uac8c\uc784\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uace0 \uc124\uce58\ud558\uc138\uc694. STEP1: \uac8c\uc784\uc744 \uc2e4\ud589\ud558\uba74 \uc528\uc557 \uc2ec\uae30, \ubb3c\uc8fc\uae30, \uc218\ud655\ud558\uae30 \ub4f1 \uae30\ubcf8\uc801\uc778 \uc870\uc791\uc744 \uc548\ub0b4\ud558\ub294 \ucd08\uc2ec\uc790 \uac00\uc774\ub4dc\ub97c \ub530\ub77c\uc8fc\uc138\uc694. STEP2: \ucd08\uc2ec\uc790 \ubbf8\uc158\uc744 \uc644\ub8cc\ud558\uba74 \uace8\ub4dc\uc640 \uc528\uc557\uacfc \uac19\uc740 \uc911\uc694\ud55c \uc790\uc6d0\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP3: \uc774\ub7ec\ud55c \uc790\uc6d0\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\uc5ec \ub18d\uc7a5\uacfc \uac74\ubb3c\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc138\uc694. \uac8c\uc784 \ub0b4 \"\ubbf8\uc158\" \ubc84\ud2bc\uc744 \ud074\ub9ad\ud558\uc5ec \ud604\uc7ac \uc644\ub8cc\ud560 \uc218 \uc788\ub294 \ubbf8\uc158\uc744 \ud655\uc778\ud558\uace0, \uc774\ub97c \uc644\ub8cc\ud558\uc5ec \ube60\ub974\uac8c \ub808\ubca8\uc744 \ub192\uc774\uc138\uc694. \uc774\ub294 \ub2f9\uc2e0\uc5d0\uac8c \ub9de\ucda4\ud654\ub41c \ub808\ubca8\uc5c5 \ub85c\ub4dc\ub9f5\uacfc \uac19\uc2b5\ub2c8\ub2e4!"}, {"question": "Farm Family\uc758 \uc791\ubb3c \uc218\ud655\ub7c9\uc774 \ub108\ubb34 \ub0ae\uc740 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \uc791\ubb3c \uc218\ud655\ub7c9\uc744 \ub192\uc77c \uc218 \uc788\uc744\uae4c\uc694? (\ucd08\uc2ec\uc790 \uad00\uc810)", "answer": "\uc791\ubb3c \uc218\ud655\ub7c9\uc774 \ub0ae\uc740 \uac83\uc740 \uba87 \uac00\uc9c0 \uc77c\ubc18\uc801\uc778 \uc6d0\uc778 \ub54c\ubb38\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac00\uc7a5 \uc911\uc694\ud55c \uc6d0\uc778\uc740 \ud1a0\uc591 \ube44\uc625\ub3c4\uac00 \ubd80\uc871\ud55c \uac83\uc785\ub2c8\ub2e4. \uc815\uae30\uc801\uc73c\ub85c \ube44\ub8cc\ub97c \uc8fc\uc154\uc11c \ud1a0\uc591 \ube44\uc625\ub3c4 \ub808\ubca8\uc744 \ub192\uc5ec\uc57c \ud569\ub2c8\ub2e4. STEP1: \ub18d\uc7a5\uc758 \ud1a0\uc591 \ube44\uc625\ub3c4 \ub808\ubca8\uc744 \ud655\uc778\ud569\ub2c8\ub2e4. STEP2: \ube44\ub8cc\ub97c \uad6c\uc785\ud558\uc5ec \uc0ac\uc6a9\ud558\uc5ec \ud1a0\uc591 \ube44\uc625\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4. STEP3: \uace0\uae09 \uc528\uc557\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uace0\uae09 \uc528\uc557\uc740 \ub354 \ub192\uc740 \uc218\ud655\ub7c9 \uc7a0\uc7ac\ub825\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \ub18d\uc7a5\uc744 \uae68\ub057\ud558\uac8c \uc720\uc9c0\ud558\ub294 \uac83\ub3c4 \uc911\uc694\ud569\ub2c8\ub2e4. \uc7a1\ucd08\uc640 \ud574\ucda9\uc744 \uc81c\uac70\ud558\uba74 \uc791\ubb3c \ud53c\ud574\ub97c \uc608\ubc29\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub18d\uc7a5\uc744 \uadc0\ud558\uc758 \uc790\ub140\ucc98\ub7fc \uc0dd\uac01\ud558\uace0, \uc815\uc131\uc744 \ub2e4\ud558\uc5ec \ub3cc\ubcf4\uba74 \uac74\uac15\ud558\uac8c \uc131\uc7a5\ud560 \uac83\uc785\ub2c8\ub2e4!"}, {"question": "Farm Family\uc5d0\uc11c \uce5c\uad6c \uc2dc\uc2a4\ud15c\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694? \uce5c\uad6c\ub4e4\uacfc \uc0c1\ud638 \uc791\uc6a9\ud558\uc5ec \uc5bb\uc744 \uc218 \uc788\ub294 \uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694? (\ucd08\uc2ec\uc790 \uad00\uc810)", "answer": "Farm Family\uc5d0\uc11c \uce5c\uad6c \uc2dc\uc2a4\ud15c\uc740 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc11c\ub85c \ub3d5\ub294 \uac83\uc744 \ud1b5\ud574 \ucd94\uac00\uc801\uc778 \ubcf4\uc0c1\uc744 \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uce5c\uad6c\uc5d0\uac8c \ubb3c\uc744 \uc8fc\uac70\ub098 \uc7a1\ucd08\ub97c \uc81c\uac70\ud558\ub294 \ub370 \ub3c4\uc6c0\uc744 \uc8fc\uba74 \uacbd\ud5d8\uce58\uc640 \uace8\ub4dc\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \ud65c\ubc1c\ud55c \uce5c\uad6c\ub97c \ucd5c\ub300\ud55c \ub9ce\uc774 \ucd94\uac00\ud558\uc138\uc694. STEP2: \ub9e4\uc77c \uce5c\uad6c\uc758 \ub18d\uc7a5\uc744 \ubc29\ubb38\ud558\uace0 \uc0c1\ud638 \uc791\uc6a9\ud558\uc138\uc694. STEP3: \uce5c\uad6c \uc0c1\uc810\uc5d0\uc11c \ub3c5\ud2b9\ud55c \uc0c1\ud488\uc744 \uad6c\ub9e4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uce5c\uad6c\ub4e4\uacfc\uc758 \uc0c1\ud638 \uc791\uc6a9\uc740 \uc778\ub9e5 \uad6c\ucd95\uacfc \uac19\uc73c\uba70, \ub18d\uc7a5\uc744 \ub354 \ube60\ub974\uac8c \ubc1c\uc804\uc2dc\ud0a4\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4!"}, {"question": "Farm Family\uc758 \uc560\uc644\ub3d9\ubb3c \uc2dc\uc2a4\ud15c\uc5d0\ub294 \uc5b4\ub5a4 \uc228\uaca8\uc9c4 \uba54\ucee4\ub2c8\uc998\uc774 \uc788\ub098\uc694?  \uc560\uc644\ub3d9\ubb3c \uc2dc\uc2a4\ud15c\uc758 \uc774\uc810\uc744 \ucd5c\ub300\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694? (\uc911\uae09 \ud50c\ub808\uc774\uc5b4)", "answer": "Farm Family\uc758 \uc560\uc644\ub3d9\ubb3c \uc2dc\uc2a4\ud15c\uc740 \ud45c\uba74\uc801\uc73c\ub85c \ubcf4\uc774\ub294 \uac83 \uc774\uc0c1\uc785\ub2c8\ub2e4. \uac01 \uc560\uc644\ub3d9\ubb3c\uc740 \uace0\uc720\ud55c \uae30\uc220\uacfc \uc18d\uc131 \uc99d\uac00\ub97c \uac00\uc9c0\uace0 \uc788\uc73c\uba70, \uc774\ub294 \ub18d\uc7a5 \ud6a8\uc728\uc744 \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc560\uc644\ub3d9\ubb3c \ub808\ubca8\uc774 \ub2e4\ub974\uba74 \uc99d\uac00\ud558\ub294 \ud6a8\uacfc\uac00 \ud06c\uac8c \ucc28\uc774\uac00 \ub0a9\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud76c\uadc0 \uc560\uc644\ub3d9\ubb3c\uc740 \uc218\ud655\ub7c9\uc744 20% \uc99d\uac00\uc2dc\ud0ac \uc218 \uc788\ub294 \ubc18\uba74, \uc77c\ubc18 \uc560\uc644\ub3d9\ubb3c\uc740 5% \uc99d\uac00\ub9cc \uc81c\uacf5\ud569\ub2c8\ub2e4. STEP1: \uc774\ubca4\ud2b8 \ub610\ub294 \uc0c1\uc810\uc744 \ud1b5\ud574 \uc560\uc644\ub3d9\ubb3c\uc744 \uc5bb\uc73c\uc138\uc694. STEP2: \uc560\uc644\ub3d9\ubb3c\uc744 \uba39\uc5ec \ub808\ubca8\uacfc \uae30\uc220\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uc138\uc694. STEP3: \ub18d\uc7a5 \uac1c\ubc1c \uc804\ub7b5\uc5d0 \ub530\ub77c \uc801\ud569\ud55c \uc560\uc644\ub3d9\ubb3c\uc744 \uc870\ud569\ud558\uc138\uc694. \uc11c\ub85c \ub2e4\ub978 \uc560\uc644\ub3d9\ubb3c \uc870\ud569\uc740 \uc608\uc0c1\uce58 \ubabb\ud55c \ub180\ub77c\uc6b4 \uacb0\uacfc\ub97c \uac00\uc838\uc62c \uc218 \uc788\ub294 \ud654\ud559 \ubc18\uc751\uacfc \uac19\uc2b5\ub2c8\ub2e4!"}, {"question": "Farm Family\uc5d0\uc11c \uace0\uae09 \uc791\ubb3c \uc7ac\ubc30 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694? Farm Family\uc5d0\uc11c \uc218\uc775\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud55c \uace0\uae09 \uc791\ubb3c \uc7ac\ubc30 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694? (\uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4)", "answer": "\uace0\uae09 \uc791\ubb3c \uc7ac\ubc30\ub294 \uc804\ub7b5\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc6b0\uc120, \uac01 \uc791\ubb3c\uc758 \uc131\uc7a5 \uc8fc\uae30\uc640 \uc2dc\uc7a5 \uac00\uaca9 \ubcc0\ub3d9\uc744 \uc774\ud574\ud574\uc57c \ud569\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc73c\ub85c \uc131\uc7a5 \uc8fc\uae30\uac00 \uae34 \uc791\ubb3c\uc740 \uc218\uc775\uc774 \ub354 \ub192\uc9c0\ub9cc, \ub354 \ub9ce\uc740 \uc778\ub0b4\uc2ec\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub458\uc9f8, \uacc4\uc808\uacfc \uc2dc\uc7a5 \uc218\uc694\uc5d0 \ub530\ub77c \uc7ac\ubc30 \uacc4\ud68d\uc744 \uc870\uc815\ud574\uc57c \ud569\ub2c8\ub2e4. \ud1a0\uc591 \ube44\uc625\ub3c4\ub97c \uc720\uc9c0\ud558\uae30 \uc704\ud574 \"\uc21c\ud658 \uc7ac\ubc30\" \ubc29\ubc95\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub294 \ub2e8\uc77c \uc791\ubb3c\ub85c \uc778\ud55c \ud1a0\uc591 \uace0\uac08\uc744 \ubc29\uc9c0\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. STEP1: \uc2dc\uc7a5 \uac00\uaca9 \ucd94\uc138\ub97c \uc870\uc0ac\ud569\ub2c8\ub2e4. STEP2: \uacc4\uc808\uc5d0 \ub530\ub77c \uc791\ubb3c \uc7ac\ubc30\ub97c \uc870\uc815\ud569\ub2c8\ub2e4. STEP3: \uc21c\ud658 \uc7ac\ubc30\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud1a0\uc591 \ube44\uc625\ub3c4\ub97c \uc720\uc9c0\ud569\ub2c8\ub2e4. \uc8fc\uc2dd \ud22c\uc790\uc640 \uac19\uc774 \ub54c\ub97c \uc798 \ub9de\ucd94\uace0 \ub2e4\uc591\ud558\uac8c \ud3ec\ud2b8\ud3f4\ub9ac\uc624\ub97c \uad6c\uc131\ud574\uc57c \ucd5c\ub300 \uc218\uc775\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4!"}, {"question": "Farm Family\uc758 \ud6c4\uae30 \ub18d\uc9c0 \uacc4\ud68d \uc2dc \uace0\ub824\ud574\uc57c \ud560 \uc138\ubd80 \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc778\uac00\uc694? Farm Family \ud6c4\uae30 \ub2e8\uacc4\uc5d0\uc11c \ub18d\uc9c0\ub97c \uacc4\ud68d\ud560 \ub54c \uace0\ub824\ud574\uc57c \ud560 \uc8fc\uc694 \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc778\uac00\uc694? (\uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4)", "answer": "\ud6c4\uae30 \ub18d\uc9c0 \uacc4\ud68d\uc740 \ud6a8\uc728\uc131\uacfc \ubbf8\uc801 \uc694\uc18c\ub97c \uace0\ub824\ud574\uc57c \ud569\ub2c8\ub2e4. \ub3d9\uc77c\ud55c \uc720\ud615\uc758 \uac74\ubb3c\uc774\ub098 \ub18d\uc7a5\uc744 \ubaa8\uc544 \ub193\uc73c\uba74 \uad00\ub9ac \ubc0f \uc870\uc791\uc774 \uc6a9\uc774\ud574\uc9d1\ub2c8\ub2e4. \ub610\ud55c, \ubbf8\ub798 \ud655\uc7a5\uc744 \uc704\ud55c \ucda9\ubd84\ud55c \uacf5\uac04\uc744 \ud655\ubcf4\ud574\uc57c \ud569\ub2c8\ub2e4. \"\uaca9\uc790\ud615 \ub808\uc774\uc544\uc6c3\"\uc774\ub098 \"\ubc29\uc0ac\ud615 \ub808\uc774\uc544\uc6c3\"\uacfc \uac19\uc740 \uba87 \uac00\uc9c0 \uc804\ud615\uc801\uc778 \ub18d\uc7a5 \ub808\uc774\uc544\uc6c3\uc744 \ucc38\uace0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \uac8c\uc784 \ubaa9\ud45c \ubc0f \uac1c\ubc1c \uc804\ub7b5\uc5d0 \ub530\ub77c \ub18d\uc7a5\uc758 \ud575\uc2ec \uc9c0\uc5ed\uc744 \uacb0\uc815\ud569\ub2c8\ub2e4. STEP2: \ub3d9\uc77c \uc720\ud615\uc758 \uac74\ubb3c\uc774\ub098 \ub18d\uc7a5\uc744 \ubaa8\uc544 \ub193\uc544 \ud6a8\uc728\uc131\uc744 \ub192\uc785\ub2c8\ub2e4. STEP3: \ubbf8\ub798 \ud655\uc7a5\uc744 \uc704\ud55c \ucda9\ubd84\ud55c \uacf5\uac04\uc744 \ud655\ubcf4\ud569\ub2c8\ub2e4. \ube4c\ub529\uc744 \uc124\uacc4\ud558\uac70\ub098 \ud1a0\uc9c0\ub97c \uac1c\ubc1c\ud560 \ub54c\uc640 \uac19\uc774, \uc801\uc808\ud55c \uacc4\ud68d\uc744 \uc138\uc6b0\uba74 \ub18d\uc7a5\uc774 \ub354\uc6b1 \uc548\uc815\uc801\uc774\uace0 \ud6a8\uc728\uc801\uc77c \uac83\uc785\ub2c8\ub2e4!"}, {"question": "Farm Family\uc5d0\uc11c \uce5c\uad6c \uc0c1\ud638 \uc9c0\uc6d0 \ubcf4\uc0c1 \uae08\uc561\uc740 \uc5b4\ub5bb\uac8c \uacc4\uc0b0\ub418\ub098\uc694? Farm Family\uc5d0\uc11c \uce5c\uad6c \uc0c1\ud638 \uc9c0\uc6d0 \ubcf4\uc0c1\uc744 \uacc4\uc0b0\ud558\ub294 \uadfc\ubcf8\uc801\uc778 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc778\uac00\uc694? (\uc2dc\uc2a4\ud15c \ubd84\uc11d)", "answer": "Farm Family\uc5d0\uc11c \uce5c\uad6c \uc0c1\ud638 \uc9c0\uc6d0 \ubcf4\uc0c1\uc740 \ubb34\uc791\uc704\ub85c \uc0dd\uc131\ub418\ub294 \uac83\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uce5c\uad6c\uc758 \ub808\ubca8, \ub18d\uc7a5 \uaddc\ubaa8 \ubc0f \uc0c1\ud638 \uc791\uc6a9 \ud589\uc704\uc5d0 \ub530\ub77c \ubcf5\uc7a1\ud55c \uc54c\uace0\ub9ac\uc998\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uace0\ub808\ubca8\uc758 \uce5c\uad6c\uc5d0\uac8c \ub3c4\uc6c0\uc744 \uc8fc\uba74 \ub354 \ub192\uc740 \ubcf4\uc0c1\uc744 \ubc1b\uc744 \uc218 \uc788\uc73c\uba70, \uc9c0\uc18d\uc801\uc778 \uc0c1\ud638 \uc791\uc6a9\uc740 \ubcf4\uc0c1 \ubc30\uc728\uc744 \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4. \uc54c\uace0\ub9ac\uc998 \uacf5\uc2dd\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: \ubcf4\uc0c1 = \uae30\ubcf8\uac12 * (1 + \uce5c\uad6c \ub808\ubca8 \uacc4\uc218 + \uc0c1\ud638 \uc791\uc6a9 \uacc4\uc218). \uc774 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\uba74 \uce5c\uad6c \uc0c1\ud638 \uc791\uc6a9\uc744 \ub354\uc6b1 \uc804\ub7b5\uc801\uc73c\ub85c \uc218\ud589\ud558\uc5ec \ucd5c\ub300 \uc774\uc775\uc744 \ub0bc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc11c\ub85c \ub2e4\ub978 \uc0c1\ud669\uc5d0\uc11c\uc758 \uc218\uc775\ub960\uc744 \uae30\ub85d\ud558\ub294 \ud45c\ub97c \ub9cc\ub4e4\uc5b4 \uc18c\uc15c \uc804\ub7b5\uc744 \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4!"}, {"question": "Farm Family\uc758 \"\ub7ed\ud0a4 \uc2a4\ud540\" \uae30\ub2a5\uc758 \ud655\ub960 \ubd84\ud3ec\ub294 \uc5b4\ub5bb\uac8c \uc124\uc815\ub418\ub098\uc694? Farm Family\uc5d0\uc11c \"\ub7ed\ud0a4 \uc2a4\ud540\" \uae30\ub2a5\uc758 \ud655\ub960 \ubd84\ud3ec\ub294 \uc5b4\ub5bb\uac8c \uacb0\uc815\ub418\ub098\uc694? (\uc2dc\uc2a4\ud15c \ubd84\uc11d)", "answer": " \"\ub7ed\ud0a4 \uc2a4\ud540\"\uc758 \ud655\ub960 \uc124\uc815\uc740 \ud50c\ub808\uc774\uc5b4\uc758 \ud765\ubd84\uacfc \uac8c\uc784 \uc218\uc775\uc744 \uc870\ud654\uc2dc\ud0a4\ub294 \ubcf5\uc7a1\ud55c \uc124\uacc4 \uacfc\uc815\uc785\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc73c\ub85c, \ud76c\uadc0 \uc544\uc774\ud15c\uc758 \ud655\ub960\uc740 \uc77c\ubc18 \uc544\uc774\ud15c\ubcf4\ub2e4 \ud6e8\uc52c \ub0ae\uc73c\uba70, \ud68c\uc218 \ud69f\uc218\uac00 \ub9ce\uc544\uc9c8\uc218\ub85d \ud76c\uadc0 \uc544\uc774\ud15c\uc758 \ud655\ub960\uc740 \uc57d\uac04 \uc99d\uac00\ud558\uc9c0\ub9cc \uc0c1\ud55c\uc120\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784 \uac1c\ubc1c\uc0ac\ub294 \uc77c\ubc18\uc801\uc73c\ub85c \uacf5\uc815\uc131\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 \uc758\uc0ac \ub09c\uc218 \uc0dd\uc131\uae30\ub97c \uc0ac\uc6a9\ud558\uc5ec \ucd94\ucca8 \uacfc\uc815\uc744 \uc2dc\ubbac\ub808\uc774\uc158\ud569\ub2c8\ub2e4. \ub9ce\uc740 \ub370\uc774\ud130 \ubd84\uc11d\uc744 \ud1b5\ud574 \ud655\ub960 \ubd84\ud3ec\ub97c \ucd94\ub860\ud558\uace0 \ub354 \ud569\ub9ac\uc801\uc778 \ucd94\ucca8 \uc804\ub7b5\uc744 \uc218\ub9bd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac01 \ud68c\uc804\uc740 \ud655\ub960 \uc0ac\uac74\uc774\uba70, \ud569\ub9ac\uc801\uc778 \ucc38\uc5ec\uc640 \uc801\uc808\ud55c \uc5d4\ud130\ud14c\uc778\uba3c\ud2b8\ub97c \uc990\uae30\uc138\uc694!"}, {"question": "Farm Family\uc758 \ub370\uc774\ud130\ub294 \ub2e4\ub978 \ud50c\ub7ab\ud3fc(iOS, Android, PC)\uc5d0\uc11c \ub3d9\uae30\ud654\ub418\ub098\uc694? (\ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc)", "answer": "Farm Family\ub294 \uc77c\ubc18\uc801\uc73c\ub85c \ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc \uac04 \ub370\uc774\ud130 \ub3d9\uae30\ud654\ub97c \uc9c0\uc6d0\ud569\ub2c8\ub2e4. \uc989, \ud55c \uacc4\uc815\uc73c\ub85c \ub2e4\ub978 \uae30\uae30\uc5d0\uc11c \ub85c\uadf8\uc778\ud558\uc5ec \uac8c\uc784 \uc9c4\ud589\uc744 \uacc4\uc18d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \uad6c\uccb4\uc801\uc778 \ub3d9\uae30\ud654 \ubc29\uc2dd\uc740 \ub2e4\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc73c\ub85c, \uac8c\uc784 \uacc4\uc815\uc744 \uc18c\uc15c \ubbf8\ub514\uc5b4 \uacc4\uc815 \ub610\ub294 \uac8c\uc784 \uc13c\ud130 \uacc4\uc815\uc5d0 \uc5f0\uacb0\ud574\uc57c \ud569\ub2c8\ub2e4. \ub370\uc774\ud130 \ub3d9\uae30\ud654 \ubb38\uc81c\uac00 \ubc1c\uc0dd\ud558\uba74 \ub2e4\uc2dc \ub85c\uadf8\uc778\ud558\uac70\ub098 \uace0\uac1d\uc13c\ud130\uc5d0 \ubb38\uc758\ud558\uc138\uc694. \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uacfc \uac19\uc774, \uac8c\uc784 \ub370\uc774\ud130\uac00 \uc11c\ubc84\uc5d0 \uc548\uc804\ud558\uac8c \uc800\uc7a5\ub418\uc5b4 \uc5b8\uc81c \uc5b4\ub514\uc11c\ub098 \uc561\uc138\uc2a4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Farm Family\uc758 \uc228\uaca8\uc9c4 \"\uc2e0\ube44 \uc815\uc6d0\"\uc740 \uc5b4\ub5bb\uac8c \uc7a0\uae08 \ud574\uc81c\ub418\uba70, \uc5b4\ub5a4 \uace0\uc720\ud55c \ud61c\ud0dd\uc744 \uc81c\uacf5\ud558\ub098\uc694? (\uc228\uaca8\uc9c4 \ub0b4\uc6a9)", "answer": "Farm Family\uc5d0\ub294 \ud2b9\uc815 \uc870\uac74\uc744 \ucda9\uc871\ud574\uc57c \uc7a0\uae08 \ud574\uc81c\ub418\ub294 \uc228\uaca8\uc9c4 \"\uc2e0\ube44 \uc815\uc6d0\"\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc73c\ub85c, \uc77c\ub828\uc758 \ud2b9\uc815 \ubbf8\uc158\uc744 \uc644\ub8cc\ud558\uace0 \ud2b9\uc815 \uc544\uc774\ud15c\uc744 \uc218\uc9d1\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubaa8\ub4e0 \uc8fc\uc694 \ubbf8\uc158\uc744 \uc644\ub8cc\ud558\uace0 5\uac1c\uc758 \"\ub9c8\ubc95 \uc528\uc557\"\uc744 \uc218\uc9d1\ud574\uc57c \ud560 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. \"\uc2e0\ube44 \uc815\uc6d0\"\uc744 \uc7a0\uae08 \ud574\uc81c\ud558\uba74 \ud2b9\ubcc4\ud55c \uc791\ubb3c\uc744 \uc7ac\ubc30\ud558\uace0 \ucd94\uac00\uc801\uc778 \ubcf4\uc0c1\uc744 \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \"\uc2e0\ube44 \uc815\uc6d0\"\uc740 \uac8c\uc784 \ub0b4\uc5d0 \uc788\ub294 \uc228\uc740 \ubcf4\uc11d\uacfc \uac19\uc73c\uba70, \ud0d0\uc0c9\ud558\uc5ec \ubc1c\uacac\ud574\uc57c \ud569\ub2c8\ub2e4. \"\uc2e0\ube44 \uc815\uc6d0\"\uc5d0\ub294 \ud2b9\ubcc4\ud55c \uc560\uc644\ub3d9\ubb3c\uacfc \uc7a5\uc2dd\ud488\uc774 \uc788\uc73c\uba70, \ub18d\uc7a5 \uc0dd\ud65c\uc744 \ub354\uc6b1 \ud48d\uc131\ud558\uac8c \ub9cc\ub4e4\uc5b4 \uc904 \uac83\uc785\ub2c8\ub2e4!"}]
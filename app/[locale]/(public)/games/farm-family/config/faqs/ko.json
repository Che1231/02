[{"question": "\ucd08\ubcf4\uc790\ub85c\uc11c Farm Family\uc5d0\uc11c \uc791\ubb3c\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uc7ac\ubc30\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Farm Family\uc5d0\uc11c \uc791\ubb3c\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uc7ac\ubc30\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. \ub2e8\uacc41: \uacc4\uc808\uacfc \ud1a0\uc591 \ube44\uc625\ub3c4\ub97c \uae30\ubc18\uc73c\ub85c \uc791\ubb3c \uc720\ud615\uc744 \uc120\ud0dd\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ubd04\uc5d0 \ubc00\uc744 \uc2ec\uc73c\uba74 \ub354 \ub098\uc740 \uacb0\uacfc\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc42: \uacf5\uac04 \ud65c\uc6a9\ub3c4\ub97c \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \uadf8\ub9ac\ub4dc \uc7ac\ubc30 \ubc29\ubc95\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc43: \uc131\uc7a5 \uc9c4\ucc99 \uc0c1\ud669\uc744 \uc815\uae30\uc801\uc73c\ub85c \ud655\uc778\ud558\uace0 \uc791\ubb3c\uc5d0 \ubb3c\uc744 \uc8fc\uc2ed\uc2dc\uc624. \uad6c\uc131\ud45c\ub294 \uc791\ubb3c\uacfc \ucd5c\uc801\uc758 \uacc4\uc808 \ubc0f \ud1a0\uc591 \uc720\ud615\uc744 \uc77c\uce58\uc2dc\ud0a4\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Farm Family\uc5d0\uc11c \uc791\ubb3c \uc21c\ud658\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \uc218\ud589\ud569\ub2c8\uae4c?", "answer": "Farm Family\uc5d0\uc11c \uc791\ubb3c \uc21c\ud658\uc740 \ud1a0\uc591 \ube44\uc625\ub3c4\ub97c \uc720\uc9c0\ud558\uace0 \ud574\ucda9 \ubc1c\uc0dd\uc744 \uc608\ubc29\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \ub2e8\uacc41: \ud55c \uc791\ubb3c\uc744 \uc218\ud655\ud55c \ud6c4 \uac19\uc740 \uc9c0\uc5ed\uc5d0 \ub2e4\ub978 \uc720\ud615\uc758 \uc791\ubb3c\uc744 \uc2ec\uc73c\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ubc00 \ub2e4\uc74c\uc5d0 \ucf69\uacfc \uc2dd\ubb3c\uc744 \uc2ec\uc73c\uc2ed\uc2dc\uc624. \ub2e8\uacc42: \uac01 \uad6c\ud68d\uc5d0 \ub2e4\uc591\ud55c \uc791\ubb3c\uc774 \uc2ec\uc5b4\uc9c0\ub3c4\ub85d \ud750\ub984\ub3c4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc21c\ud658 \uc8fc\uae30\ub97c \ucd94\uc801\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc43: \ube44\ub8cc\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc601\uc591\uc18c\ub97c \ubcf4\ucda9\ud558\uc2ed\uc2dc\uc624. \uc774 \ubc29\ubc95\uc740 \uc218\ud655\ub7c9\uc744 \ub192\uc77c \ubfd0\ub9cc \uc544\ub2c8\ub77c \uc2dc\uac04\uc774 \uc9c0\ub0a8\uc5d0 \ub530\ub77c \ud1a0\uc591 \uac74\uac15\uc744 \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4."}, {"question": "\uac8c\uc784 \ud50c\ub808\uc774 \uc2dc\uac04 100\uc2dc\uac04\uc774 \uc9c0\ub09c \ud6c4 Farm Family\uc5d0\uc11c \uc790\uc6d0\uc744 \uad00\ub9ac\ud558\ub294 \ucd5c\uc0c1\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Farm Family\uc5d0\uc11c 100\uc2dc\uac04\uc774 \uc9c0\ub098\uba74 \uc790\uc6d0 \uad00\ub9ac\uac00 \uc911\uc694\ud574\uc9d1\ub2c8\ub2e4. \ub2e8\uacc41: \uc6b0\uc720 \uc18c\ucc98\ub7fc \uc548\uc815\uc801\uc778 \uc218\uc785\uc744 \uc81c\uacf5\ud558\ub294 \uace0\uac00\uce58 \uc791\ubb3c\uacfc \uac00\ucd95\uc5d0 \uc6b0\uc120\uc21c\uc704\ub97c \ub450\uc2ed\uc2dc\uc624. \ub2e8\uacc42: \uc789\uc5ec \ub18d\uc0b0\ubb3c\uc744 \ubcf4\uad00\ud558\uae30 \uc704\ud574 \uc800\uc7a5 \uc2dc\uc124\uc5d0 \ud22c\uc790\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc43: \ub2e8\uae30\uc801 \uc774\uc775\uacfc \uc7a5\uae30\uc801 \ud22c\uc790(\uc608: \ub3c4\uad6c \uc5c5\uadf8\ub808\uc774\ub4dc)\ub97c \uade0\ud615 \uc788\uac8c \uc720\uc9c0\ud558\ub294 \ub2e4\uc911 \uacc4\ud68d \uc811\uadfc \ubc29\uc2dd\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \ube44\uad50\ud45c\ub294 \uc5b4\ub5a4 \uc5c5\uadf8\ub808\uc774\ub4dc\uac00 \ucd5c\uace0\uc758 \ud22c\uc790 \uc218\uc775\ub960\uc744 \uc81c\uacf5\ud558\ub294\uc9c0 \uacb0\uc815\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Farm Family\uc5d0\uc11c \ud6a8\uc728\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \uc9d1\uc911\ud574\uc57c \ud560 \ub3c4\uad6c\uc640 \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Farm Family\uc5d0\uc11c \uc62c\ubc14\ub978 \ub3c4\uad6c\uc640 \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0 \uc9d1\uc911\ud558\uba74 \ud6a8\uc728\uc131\uc744 \ud06c\uac8c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc41: \uae30\ubcf8\uc801\uc778 \uad2d\uc774 \ubc0f \ubb3c\uc8fc\ub294 \uc0bd\uc73c\ub85c \uc2dc\uc791\ud55c \ud6c4 \uc790\ub3d9\ud654 \uc2dc\uc2a4\ud15c\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc42: \ub300\uaddc\ubaa8 \ub18d\uc5c5\uc744 \uc704\ud574 \ud2b8\ub799\ud130\uc5d0 \ud22c\uc790\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc43: \uc81c\ucd08\uae30\ub97c \uc218\ud655 \uc791\uc5c5\uacfc \uac19\uc774 \ud2b9\uc815 \uc791\uc5c5\uacfc \uc77c\uce58\uc2dc\ud0a4\ub294 \uad6c\uc131\ud45c\ub97c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \ub3c4\uad6c\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uba74 \uc2dc\uac04\uc744 \uc808\uc57d\ud560 \ubfd0\ub9cc \uc544\ub2c8\ub77c \uc7a5\uae30\uc801\uc73c\ub85c \ub178\ub3d9 \ube44\uc6a9\uc744 \uc904\uc785\ub2c8\ub2e4."}, {"question": "Farm Family\uc758 \ub0a0\uc528 \uc2dc\uc2a4\ud15c\uc740 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\uba70, \uc5b4\ub5bb\uac8c \uc801\uc751\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Farm Family\uc758 \ub0a0\uc528 \uc2dc\uc2a4\ud15c\uc740 \uc791\ubb3c \uc131\uc7a5\uacfc \uac00\ucd95 \uac74\uac15\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uacfc\ub3c4\ud55c \ube44\ub294 \ub4e4\ud310\uc744 \ubb3c\uc5d0 \uc7a0\uae30\uac8c \ud560 \uc218 \uc788\uace0, \uac00\ubb44\uc740 \uc131\uc7a5\uc744 \uc800\ud574\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc41: \ub0a0\uc528 \uc608\ubcf4\ub97c \uc815\uae30\uc801\uc73c\ub85c \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc42: \uc720\ub9ac\ud55c \uc870\uac74\uc5d0 \ub530\ub77c \ud30c\uc885 \ubc0f \uc218\ud655 \uacc4\ud68d\uc744 \uc138\uc6b0\uc2ed\uc2dc\uc624. \ub2e8\uacc43: \ub09c\ucd08 \uc791\ubb3c\uc758 \uacbd\uc6b0 \uc628\uc2e4\uacfc \uac19\uc740 \ubcf4\ud638 \uc870\uce58\ub97c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \ud750\ub984\ub3c4\ub294 \ub0a0\uc528 \ud328\ud134\uc5d0 \ub530\ub77c \ud30c\uc885 \ubc0f \uc218\ud655\ud558\ub294 \ucd5c\uc801\uc758 \uc2dc\uae30\ub97c \uc2dc\uac01\uc801\uc73c\ub85c \ubcf4\uc5ec\uc8fc\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Farm Family\uc5d0\uc11c \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Farm Family\uc758 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \uc11c\ub85c \ub2e4\ub978 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4\uc5d0\uc11c\ub294 \ub18d\uc7a5\uc758 \ubaa8\ub4e0 \uba74\uc744 \ub3c5\ub9bd\uc801\uc73c\ub85c \uad00\ub9ac\ud569\ub2c8\ub2e4. \uba40\ud2f0\ud50c\ub808\uc774\uc5b4\uc5d0\uc11c\ub294 \uce5c\uad6c\ub4e4\uacfc \ud611\ub825\ud558\uace0, \uc790\uc6d0\uc744 \uacf5\uc720\ud558\uace0, \uc791\uc5c5\uc744 \ubd84\ub2f4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud55c \ud50c\ub808\uc774\uc5b4\ub294 \uc791\ubb3c\uc5d0 \uc9d1\uc911\ud558\ub294 \ubc18\uba74 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub294 \uac00\ucd95\uc744 \ub3cc\ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ube44\uad50\ud45c\ub294 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4\uc5d0\uc11c \uc99d\uac00\ud55c \ubcf5\uc7a1\uc131\uacfc \uc0ac\ud68c\uc801 \uc0c1\ud638 \uc791\uc6a9\uacfc \uac19\uc774 \uac01 \ubaa8\ub4dc\uc758 \uc7a5\ub2e8\uc810\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4."}, {"question": "Farm Family\uc758 \uacbd\uc81c \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \ub3d9\uc804\uc744 \ubc84\ub294 \ucd5c\uc0c1\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Farm Family\uc758 \uacbd\uc81c \uc2dc\uc2a4\ud15c\uc740 \uc0c1\ud488\uc744 \uad6c\ub9e4, \ud310\ub9e4 \ubc0f \uac70\ub798\ud558\ub294 \uac83\uc744 \uc911\uc2ec\uc73c\ub85c \ud569\ub2c8\ub2e4. \ub2e8\uacc41: \uc6b0\uc720 \uc18c\uc5d0\uc11c \uc0dd\uc0b0\ub418\ub294 \uce58\uc988\uc640 \uac19\uc774 \uc218\uc694\uac00 \ub192\uc740 \uc791\ubb3c\uacfc \uc81c\ud488\uc5d0 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc42: \uacc4\uc808 \uc774\ubca4\ud2b8\uc5d0 \ucc38\uc5ec\ud558\uc5ec \ubcf4\ub108\uc2a4 \ub3d9\uc804\uc744 \uc5bb\uc73c\uc2ed\uc2dc\uc624. \ub2e8\uacc43: \uc791\ubb3c\uacfc \uc81c\uc791\ub41c \ud488\ubaa9\uc744 \ubaa8\ub450 \ud310\ub9e4\ud558\ub294 \uac83\uacfc \uac19\uc740 \ub2e4\uc591\ud55c \uc18c\ub4dd\uc6d0\uc744 \uc720\uc9c0\ud558\ub294 \ub2e4\uc911 \uacc4\ud68d \uc811\uadfc \ubc29\uc2dd\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \ud750\ub984\ub3c4\ub294 \uc5f0\uc911 \uac00\uc7a5 \uc218\uc775\uc131\uc774 \ub192\uc740 \uc0ac\uc5c5\uc744 \ucd94\uc801\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc \uac04\uc5d0 Farm Family\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c? \uc5b4\ub5bb\uac8c \ud569\ub2c8\uae4c?", "answer": "\ub124, \ub2e4\ub978 \ud50c\ub7ab\ud3fc \uac04\uc5d0 Farm Family\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc41: \uac8c\uc784\uc744 Google Play \ub610\ub294 Apple Game Center\uc640 \uac19\uc740 \ud074\ub77c\uc6b0\ub4dc \uacc4\uc815\uc5d0 \uc5f0\uacb0\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc42: \uac8c\uc784 \ub0b4 \ub3d9\uae30\ud654 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5c5\ub85c\ub4dc\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc43: \uc0c8 \ud50c\ub7ab\ud3fc\uc5d0 \ub85c\uadf8\uc778\ud558\uc5ec \ub370\uc774\ud130\ub97c \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc2ed\uc2dc\uc624. \uad6c\uc131\ud45c\ub294 \uac01 \ud50c\ub7ab\ud3fc\uc5d0 \ub300\ud55c \ud2b9\uc815 \ub2e8\uacc4\ub97c \uc548\ub0b4\ud558\uc5ec \uc6d0\ud65c\ud55c \uc804\ud658\uc744 \ubcf4\uc7a5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Farm Family\uc758 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Farm Family\ub294 \uc7ac\ubbf8\uc640 \uc2e0\ube44\uac10\uc744 \ub354\ud558\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub85c \uac00\ub4dd\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud5db\uac04 \ub4a4\uc5d0 \ud37c\uc990\uc744 \ud480\uba74 \uc811\uadfc\ud560 \uc218 \uc788\ub294 \ube44\ubc00 \uc601\uc5ed\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc41: \uc9c0\ub3c4\uc758 \ubaa8\ub4e0 \uad6c\uc11d\uc744 \ucca0\uc800\ud788 \ud0d0\ud5d8\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc42: \ud2b9\uc815 \ub098\ubb34\ub098 \ubc14\uc704\uc640 \uac19\uc740 \ud2b9\uc774\ud55c \ubb3c\uccb4\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc43: \ucee4\ubba4\ub2c8\ud2f0 \ud3ec\ub7fc\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud78c\ud2b8\ub97c \uacf5\uc720\ud558\uace0 \ubc1c\uacac\ud558\uc2ed\uc2dc\uc624. \ud750\ub984\ub3c4\ub294 \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ubcf4\uc11d\uc744 \ubc1c\uacac\ud558\uae30 \uc704\ud55c \ub2e8\uacc4\ub97c \uc548\ub0b4\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Farm Family\uc5d0\uc11c \ub18d\uc7a5 \ub808\uc774\uc544\uc6c3\uc744 \ucd5c\ub300 \uc0dd\uc0b0\uc131\uc744 \uc704\ud574 \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Farm Family\uc5d0\uc11c \ub18d\uc7a5 \ub808\uc774\uc544\uc6c3\uc744 \ucd5c\uc801\ud654\ud558\ub294 \uac83\uc740 \uc804\ub7b5\uc801\uc778 \uacc4\ud68d\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \ub2e8\uacc41: \ub18d\uc7a5\uc744 \uc791\ubb3c, \uac00\ucd95 \ubc0f \uc800\uc7a5\uc18c\uc758 \uad6c\uc5ed\uc73c\ub85c \ub098\ub204\uc2ed\uc2dc\uc624. \ub2e8\uacc42: \uadf8\ub9ac\ub4dc \uc2dc\uc2a4\ud15c\uc744 \uc0ac\uc6a9\ud558\uc5ec \uacf5\uac04\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc43: \ud5db\uac04 \ubc0f \uc2dc\uc7a5\uacfc \uac19\uc774 \uc790\uc8fc \uc0ac\uc6a9\ud558\ub294 \uc2dc\uc124\uc740 \uc27d\uac8c \uc811\uadfc\ud560 \uc218 \uc788\ub3c4\ub85d \uc911\uc559\uc5d0 \ubc30\uce58\ud558\uc2ed\uc2dc\uc624. \ube44\uad50\ud45c\ub294 \uc0dd\uc0b0\uc131\uacfc \ud3b8\uc758\uc131\uc744 \uae30\uc900\uc73c\ub85c \uc11c\ub85c \ub2e4\ub978 \ub808\uc774\uc544\uc6c3 \uc635\uc158\uc744 \ud3c9\uac00\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
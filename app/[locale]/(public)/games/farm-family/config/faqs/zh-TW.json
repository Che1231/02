[{"question": "\u65b0\u624b\u5982\u4f55\u6709\u6548\u5730\u5728\u8fb2\u5834\u5bb6\u65cf\u7a2e\u690d\u4f5c\u7269\uff1f", "answer": "\u5728\u8fb2\u5834\u5bb6\u65cf\u4e2d\u6709\u6548\u7a2e\u690d\u4f5c\u7269\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u6839\u64da\u5b63\u7bc0\u548c\u571f\u58e4\u80a5\u529b\u9078\u64c7\u4f5c\u7269\u985e\u578b\u3002\u4f8b\u5982\uff0c\u6625\u5929\u7a2e\u690d\u5c0f\u9ea5\u80fd\u7372\u5f97\u66f4\u597d\u7684\u7d50\u679c\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u7db2\u683c\u7a2e\u690d\u65b9\u6cd5\u6700\u5927\u5316\u7a7a\u9593\u5229\u7528\u7387\u3002\u6b65\u9a5f3\uff1a\u5b9a\u671f\u6aa2\u67e5\u751f\u9577\u9032\u5ea6\u4e26\u6f86\u6c34\u3002\u914d\u7f6e\u8868\u53ef\u4ee5\u5e6b\u52a9\u60a8\u5c07\u4f5c\u7269\u8207\u6700\u4f73\u5b63\u7bc0\u548c\u571f\u58e4\u985e\u578b\u5339\u914d\u3002"}, {"question": "\u5728\u8fb2\u5834\u5bb6\u65cf\u4e2d\uff0c\u70ba\u4ec0\u9ebc\u4f5c\u7269\u8f2a\u4f5c\u5f88\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u9032\u884c\uff1f", "answer": "\u8fb2\u5834\u5bb6\u65cf\u4e2d\u7684\u4f5c\u7269\u8f2a\u4f5c\u5c0d\u65bc\u7dad\u6301\u571f\u58e4\u80a5\u529b\u4e26\u9810\u9632\u5bb3\u87f2\u4fb5\u8972\u81f3\u95dc\u91cd\u8981\u3002\u6b65\u9a5f1\uff1a\u6536\u7a6b\u5b8c\u4e00\u7a2e\u4f5c\u7269\u5f8c\uff0c\u5728\u540c\u4e00\u5340\u57df\u7a2e\u690d\u53e6\u4e00\u7a2e\u4e0d\u540c\u7684\u4f5c\u7269\u3002\u4f8b\u5982\uff0c\u5728\u5c0f\u9ea5\u5f8c\u7a2e\u690d\u8c46\u79d1\u690d\u7269\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u6d41\u7a0b\u5716\u8ffd\u8e2a\u8f2a\u4f5c\u9031\u671f\uff0c\u4ee5\u78ba\u4fdd\u6bcf\u500b\u7530\u584a\u90fd\u6709\u4e0d\u540c\u7684\u4f5c\u7269\u3002\u6b65\u9a5f3\uff1a\u4f7f\u7528\u80a5\u6599\u88dc\u5145\u71df\u990a\u3002\u9019\u7a2e\u65b9\u6cd5\u4e0d\u50c5\u53ef\u4ee5\u63d0\u9ad8\u7522\u91cf\uff0c\u800c\u4e14\u9084\u80fd\u96a8\u8457\u6642\u9593\u589e\u5f37\u571f\u58e4\u5065\u5eb7\u3002"}, {"question": "\u5728\u8fb2\u5834\u5bb6\u65cf\u904a\u6232\u9032\u884c 100 \u5c0f\u6642\u5f8c\uff0c\u5982\u4f55\u6700\u4f73\u5316\u7ba1\u7406\u8cc7\u6e90\uff1f", "answer": "\u5728\u8fb2\u5834\u5bb6\u65cf\u904a\u6232\u9032\u884c 100 \u5c0f\u6642\u5f8c\uff0c\u8cc7\u6e90\u7ba1\u7406\u8b8a\u5f97\u81f3\u95dc\u91cd\u8981\u3002\u6b65\u9a5f1\uff1a\u512a\u5148\u8003\u616e\u9ad8\u50f9\u503c\u4f5c\u7269\u548c\u7272\u755c\uff0c\u4f8b\u5982\u5976\u725b\uff0c\u5b83\u5011\u63d0\u4f9b\u7a69\u5b9a\u6536\u5165\u3002\u6b65\u9a5f2\uff1a\u6295\u8cc7\u5132\u85cf\u8a2d\u65bd\u4ee5\u4fdd\u5b58\u904e\u5269\u7684\u8fb2\u7522\u54c1\u3002\u6b65\u9a5f3\uff1a\u904b\u7528\u591a\u65b9\u6848\u65b9\u6cd5\u5e73\u8861\u77ed\u671f\u6536\u76ca\u8207\u9577\u671f\u6295\u8cc7\uff0c\u4f8b\u5982\u5347\u7d1a\u5de5\u5177\u3002\u6bd4\u8f03\u8868\u53ef\u4ee5\u5e6b\u52a9\u60a8\u6c7a\u5b9a\u54ea\u4e9b\u5347\u7d1a\u80fd\u63d0\u4f9b\u6700\u4f73\u6295\u8cc7\u5831\u916c\u3002"}, {"question": "\u70ba\u4e86\u5728\u8fb2\u5834\u5bb6\u65cf\u4e2d\u6700\u5927\u5316\u6548\u7387\uff0c\u6211\u61c9\u8a72\u95dc\u6ce8\u54ea\u4e9b\u5de5\u5177\u548c\u5347\u7d1a\uff1f", "answer": "\u5728\u8fb2\u5834\u5bb6\u65cf\u4e2d\uff0c\u95dc\u6ce8\u6b63\u78ba\u7684\u5de5\u5177\u548c\u5347\u7d1a\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u6548\u7387\u3002\u6b65\u9a5f1\uff1a\u5f9e\u57fa\u672c\u7684\u92e4\u982d\u548c\u6f86\u6c34\u58fa\u958b\u59cb\uff0c\u7136\u5f8c\u5347\u7d1a\u5230\u81ea\u52d5\u5316\u7cfb\u7d71\u3002\u6b65\u9a5f2\uff1a\u6295\u8cc7\u62d6\u62c9\u6a5f\u9032\u884c\u5927\u898f\u6a21\u8015\u4f5c\u3002\u6b65\u9a5f3\uff1a\u4f7f\u7528\u914d\u7f6e\u8868\u5c07\u5de5\u5177\u8207\u7279\u5b9a\u4efb\u52d9\u5339\u914d\uff0c\u4f8b\u5982\u942e\u5200\u7528\u65bc\u6536\u7a6b\u3002\u5347\u7d1a\u5de5\u5177\u4e0d\u50c5\u53ef\u4ee5\u7bc0\u7701\u6642\u9593\uff0c\u800c\u4e14\u5f9e\u9577\u9060\u4f86\u770b\u4e5f\u80fd\u964d\u4f4e\u4eba\u5de5\u6210\u672c\u3002"}, {"question": "\u8fb2\u5834\u5bb6\u65cf\u4e2d\u7684\u5929\u6c23\u7cfb\u7d71\u5982\u4f55\u5f71\u97ff\u904a\u6232\uff0c\u4ee5\u53ca\u5982\u4f55\u9069\u61c9\uff1f", "answer": "\u8fb2\u5834\u5bb6\u65cf\u4e2d\u7684\u5929\u6c23\u7cfb\u7d71\u76f4\u63a5\u5f71\u97ff\u4f5c\u7269\u751f\u9577\u548c\u7272\u755c\u5065\u5eb7\u3002\u4f8b\u5982\uff0c\u904e\u591a\u7684\u96e8\u6c34\u6703\u4f7f\u7530\u5730\u7a4d\u6c34\uff0c\u800c\u4e7e\u65f1\u5247\u6703\u963b\u7919\u751f\u9577\u3002\u6b65\u9a5f1\uff1a\u5b9a\u671f\u76e3\u63a7\u5929\u6c23\u9810\u5831\u3002\u6b65\u9a5f2\uff1a\u6839\u64da\u6709\u5229\u689d\u4ef6\u8a08\u5283\u7a2e\u690d\u548c\u6536\u7a6b\u3002\u6b65\u9a5f3\uff1a\u4f7f\u7528\u4fdd\u8b77\u63aa\u65bd\uff0c\u4f8b\u5982\u6eab\u5ba4\uff0c\u4ee5\u4fdd\u8b77\u6613\u640d\u4f5c\u7269\u3002\u6d41\u7a0b\u5716\u53ef\u4ee5\u5e6b\u52a9\u60a8\u6839\u64da\u5929\u6c23\u6a21\u5f0f\u4e86\u89e3\u6700\u4f73\u7a2e\u690d\u548c\u6536\u7a6b\u6642\u9593\u3002"}, {"question": "\u8fb2\u5834\u5bb6\u65cf\u4e2d\u7684\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "\u8fb2\u5834\u5bb6\u65cf\u4e2d\u7684\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u63d0\u4f9b\u4e0d\u540c\u7684\u904a\u6232\u9ad4\u9a57\u3002\u5728\u55ae\u4eba\u6a21\u5f0f\u4e2d\uff0c\u60a8\u7368\u7acb\u7ba1\u7406\u8fb2\u5834\u7684\u5404\u500b\u65b9\u9762\u3002\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u60a8\u53ef\u4ee5\u8207\u670b\u53cb\u5408\u4f5c\uff0c\u5206\u4eab\u8cc7\u6e90\u4e26\u5206\u914d\u4efb\u52d9\u3002\u4f8b\u5982\uff0c\u4e00\u4f4d\u73a9\u5bb6\u53ef\u4ee5\u5c08\u6ce8\u65bc\u4f5c\u7269\uff0c\u800c\u53e6\u4e00\u4f4d\u5247\u7167\u9867\u7272\u755c\u3002\u6bd4\u8f03\u8868\u7a81\u986f\u4e86\u6bcf\u7a2e\u6a21\u5f0f\u7684\u512a\u7f3a\u9ede\uff0c\u4f8b\u5982\u591a\u4eba\u6a21\u5f0f\u7684\u8907\u96dc\u7a0b\u5ea6\u548c\u793e\u4ea4\u4e92\u52d5\u589e\u52a0\u3002"}, {"question": "\u8fb2\u5834\u5bb6\u65cf\u4e2d\u7684\u7d93\u6fdf\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff0c\u4ee5\u53ca\u8cfa\u53d6\u786c\u5e63\u7684\u6700\u4f73\u65b9\u6cd5\u6709\u54ea\u4e9b\uff1f", "answer": "\u8fb2\u5834\u5bb6\u65cf\u4e2d\u7684\u7d93\u6fdf\u7cfb\u7d71\u570d\u7e5e\u8cfc\u8cb7\u3001\u92b7\u552e\u548c\u4ea4\u6613\u5546\u54c1\u904b\u8f49\u3002\u6b65\u9a5f1\uff1a\u5c08\u6ce8\u65bc\u9ad8\u9700\u6c42\u4f5c\u7269\u548c\u7522\u54c1\uff0c\u4f8b\u5982\u5976\u725b\u7522\u751f\u7684\u5976\u916a\u3002\u6b65\u9a5f2\uff1a\u53c3\u8207\u5b63\u7bc0\u6027\u6d3b\u52d5\u4ee5\u8cfa\u53d6\u984d\u5916\u786c\u5e63\u3002\u6b65\u9a5f3\uff1a\u904b\u7528\u591a\u65b9\u6848\u65b9\u6cd5\u5c07\u6536\u5165\u4f86\u6e90\u591a\u5143\u5316\uff0c\u4f8b\u5982\u540c\u6642\u92b7\u552e\u4f5c\u7269\u548c\u624b\u5de5\u85dd\u54c1\u3002\u6d41\u7a0b\u5716\u53ef\u4ee5\u5e6b\u52a9\u60a8\u8ffd\u8e2a\u5168\u5e74\u6700\u6709\u5229\u7684\u5546\u696d\u6d3b\u52d5\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5c07\u6211\u7684\u8fb2\u5834\u5bb6\u65cf\u9032\u5ea6\u8f49\u79fb\u5230\u4e0d\u540c\u7684\u5e73\u53f0\u55ce\uff1f\u5982\u4f55\u8f49\u79fb\uff1f", "answer": "\u662f\u7684\uff0c\u60a8\u53ef\u4ee5\u5c07\u60a8\u7684\u8fb2\u5834\u5bb6\u65cf\u9032\u5ea6\u8f49\u79fb\u5230\u4e0d\u540c\u7684\u5e73\u53f0\u3002\u6b65\u9a5f1\uff1a\u78ba\u4fdd\u60a8\u7684\u904a\u6232\u5df2\u9023\u7d50\u5230\u96f2\u7aef\u5e33\u6236\uff0c\u4f8b\u5982 Google Play \u6216 Apple Game Center\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u904a\u6232\u5167\u540c\u6b65\u529f\u80fd\u4e0a\u50b3\u60a8\u7684\u9032\u5ea6\u3002\u6b65\u9a5f3\uff1a\u767b\u5165\u65b0\u7684\u5e73\u53f0\u4e26\u4e0b\u8f09\u60a8\u7684\u8cc7\u6599\u3002\u914d\u7f6e\u8868\u53ef\u4ee5\u6307\u5c0e\u60a8\u5b8c\u6210\u6bcf\u500b\u5e73\u53f0\u7684\u5177\u9ad4\u6b65\u9a5f\uff0c\u78ba\u4fdd\u9806\u5229\u8f49\u63db\u3002"}, {"question": "\u8fb2\u5834\u5bb6\u65cf\u4e2d\u6709\u4ec0\u9ebc\u96b1\u85cf\u7684\u5f69\u86cb\uff0c\u4ee5\u53ca\u5982\u4f55\u627e\u5230\u5b83\u5011\uff1f", "answer": "\u8fb2\u5834\u5bb6\u65cf\u4e2d\u5145\u6eff\u4e86\u96b1\u85cf\u7684\u5f69\u86cb\uff0c\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u6a02\u8da3\u548c\u795e\u79d8\u611f\u3002\u4f8b\u5982\uff0c\u7a40\u5009\u5f8c\u9762\u6709\u4e00\u500b\u79d8\u5bc6\u5340\u57df\uff0c\u53ef\u4ee5\u900f\u904e\u89e3\u958b\u8b0e\u984c\u4f86\u9032\u5165\u3002\u6b65\u9a5f1\uff1a\u5fb9\u5e95\u63a2\u7d22\u5730\u5716\u7684\u6bcf\u500b\u89d2\u843d\u3002\u6b65\u9a5f2\uff1a\u8207\u4e0d\u5c0b\u5e38\u7684\u7269\u54c1\u4e92\u52d5\uff0c\u4f8b\u5982\u7279\u5b9a\u7684\u6a39\u6728\u6216\u5ca9\u77f3\u3002\u6b65\u9a5f3\uff1a\u4f7f\u7528\u793e\u7fa4\u8ad6\u58c7\u5206\u4eab\u548c\u767c\u73fe\u63d0\u793a\u3002\u6d41\u7a0b\u5716\u53ef\u4ee5\u5e6b\u52a9\u60a8\u4e86\u89e3\u63ed\u958b\u9019\u4e9b\u96b1\u85cf\u5bf6\u7269\u6240\u9700\u7684\u6b65\u9a5f\u3002"}, {"question": "\u5982\u4f55\u5728\u8fb2\u5834\u5bb6\u65cf\u4e2d\u6700\u4f73\u5316\u8fb2\u5834\u4f48\u5c40\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u751f\u7522\u529b\uff1f", "answer": "\u5728\u8fb2\u5834\u5bb6\u65cf\u4e2d\u6700\u4f73\u5316\u8fb2\u5834\u4f48\u5c40\u9700\u8981\u7b56\u7565\u6027\u898f\u5283\u3002\u6b65\u9a5f1\uff1a\u5c07\u8fb2\u5834\u5283\u5206\u70ba\u4f5c\u7269\u5340\u3001\u7272\u755c\u5340\u548c\u5132\u85cf\u5340\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u7db2\u683c\u7cfb\u7d71\u78ba\u4fdd\u6709\u6548\u5229\u7528\u7a7a\u9593\u3002\u6b65\u9a5f3\uff1a\u5c07\u5e38\u7528\u7684\u8a2d\u65bd\uff0c\u4f8b\u5982\u7a40\u5009\u548c\u5e02\u5834\uff0c\u653e\u7f6e\u5728\u4e2d\u5fc3\u9644\u8fd1\uff0c\u65b9\u4fbf\u53d6\u5f97\u3002\u6bd4\u8f03\u8868\u53ef\u4ee5\u5e6b\u52a9\u60a8\u6839\u64da\u751f\u7522\u529b\u8207\u4fbf\u5229\u6027\u8a55\u4f30\u4e0d\u540c\u7684\u4f48\u5c40\u9078\u9805\u3002"}]
[{"question": "\u65b0\u624b\u5982\u4f55\u5728\u300a\u519c\u573a\u5bb6\u65cf\u300b\u4e2d\u6709\u6548\u79cd\u690d\u4f5c\u7269\uff1f", "answer": "\u5728\u300a\u519c\u573a\u5bb6\u65cf\u300b\u4e2d\u6709\u6548\u79cd\u690d\u4f5c\u7269\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa4\u4e00\uff1a\u6839\u636e\u5b63\u8282\u548c\u571f\u58e4\u80a5\u529b\u9009\u62e9\u4f5c\u7269\u7c7b\u578b\u3002\u4f8b\u5982\uff0c\u6625\u5b63\u79cd\u690d\u5c0f\u9ea6\u53ef\u4ee5\u83b7\u5f97\u66f4\u597d\u7684\u7ed3\u679c\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u7f51\u683c\u79cd\u690d\u65b9\u6cd5\u6700\u5927\u5316\u7a7a\u95f4\u5229\u7528\u7387\u3002\u6b65\u9aa4\u4e09\uff1a\u5b9a\u671f\u68c0\u67e5\u751f\u957f\u8fdb\u5ea6\u5e76\u7ed9\u4f5c\u7269\u6d47\u6c34\u3002\u914d\u7f6e\u8868\u53ef\u4ee5\u5e2e\u52a9\u4f60\u5c06\u4f5c\u7269\u4e0e\u6700\u4f73\u5b63\u8282\u548c\u571f\u58e4\u7c7b\u578b\u5339\u914d\u3002"}, {"question": "\u5728\u300a\u519c\u573a\u5bb6\u65cf\u300b\u4e2d\uff0c\u8f6e\u4f5c\u4f5c\u7269\u4e3a\u4ec0\u4e48\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u8fdb\u884c\uff1f", "answer": "\u300a\u519c\u573a\u5bb6\u65cf\u300b\u4e2d\u7684\u4f5c\u7269\u8f6e\u4f5c\u5bf9\u4e8e\u4fdd\u6301\u571f\u58e4\u80a5\u529b\u548c\u9884\u9632\u75c5\u866b\u5bb3\u81f3\u5173\u91cd\u8981\u3002\u6b65\u9aa4\u4e00\uff1a\u6536\u5272\u5b8c\u4e00\u79cd\u4f5c\u7269\u540e\uff0c\u5728\u540c\u4e00\u533a\u57df\u79cd\u690d\u53e6\u4e00\u79cd\u4f5c\u7269\u3002\u4f8b\u5982\uff0c\u5728\u5c0f\u9ea6\u540e\u79cd\u690d\u8c46\u79d1\u4f5c\u7269\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u6d41\u7a0b\u56fe\u8ddf\u8e2a\u8f6e\u4f5c\u5468\u671f\uff0c\u4ee5\u786e\u4fdd\u6bcf\u4e2a\u7530\u5757\u79cd\u690d\u4e0d\u540c\u4f5c\u7269\u3002\u6b65\u9aa4\u4e09\uff1a\u4f7f\u7528\u80a5\u6599\u8865\u5145\u517b\u5206\u3002\u8fd9\u79cd\u65b9\u6cd5\u4e0d\u4ec5\u63d0\u9ad8\u4ea7\u91cf\uff0c\u800c\u4e14\u8fd8\u80fd\u957f\u671f\u589e\u5f3a\u571f\u58e4\u5065\u5eb7\u3002"}, {"question": "\u5728\u300a\u519c\u573a\u5bb6\u65cf\u300b\u6e38\u620f\u4e2d\u73a9\u6ee1100\u5c0f\u65f6\u540e\uff0c\u5982\u4f55\u6700\u4f73\u5730\u7ba1\u7406\u8d44\u6e90\uff1f", "answer": "\u5728\u300a\u519c\u573a\u5bb6\u65cf\u300b\u4e2d\u73a9\u6ee1100\u5c0f\u65f6\u540e\uff0c\u8d44\u6e90\u7ba1\u7406\u53d8\u5f97\u81f3\u5173\u91cd\u8981\u3002\u6b65\u9aa4\u4e00\uff1a\u4f18\u5148\u79cd\u690d\u9ad8\u4ef7\u503c\u4f5c\u7269\u548c\u7272\u755c\uff0c\u4f8b\u5982\u5976\u725b\uff0c\u5b83\u4eec\u63d0\u4f9b\u7a33\u5b9a\u7684\u6536\u5165\u3002\u6b65\u9aa4\u4e8c\uff1a\u6295\u8d44\u50a8\u5b58\u8bbe\u65bd\u4ee5\u4fdd\u5b58\u5269\u4f59\u519c\u4ea7\u54c1\u3002\u6b65\u9aa4\u4e09\uff1a\u91c7\u7528\u591a\u65b9\u6848\u65b9\u6cd5\u5e73\u8861\u77ed\u671f\u6536\u76ca\u4e0e\u957f\u671f\u6295\u8d44\uff0c\u4f8b\u5982\u5347\u7ea7\u5de5\u5177\u3002\u6bd4\u8f83\u8868\u53ef\u4ee5\u5e2e\u52a9\u4f60\u51b3\u5b9a\u54ea\u4e9b\u5347\u7ea7\u80fd\u63d0\u4f9b\u6700\u4f73\u6295\u8d44\u56de\u62a5\u3002"}, {"question": "\u4e3a\u4e86\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u6548\u7387\uff0c\u5728\u300a\u519c\u573a\u5bb6\u65cf\u300b\u4e2d\u5e94\u8be5\u5173\u6ce8\u54ea\u4e9b\u5de5\u5177\u548c\u5347\u7ea7\uff1f", "answer": "\u5728\u300a\u519c\u573a\u5bb6\u65cf\u300b\u4e2d\uff0c\u4e13\u6ce8\u4e8e\u6b63\u786e\u7684\u5de5\u5177\u548c\u5347\u7ea7\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u6548\u7387\u3002\u6b65\u9aa4\u4e00\uff1a\u4ece\u57fa\u672c\u7684\u9504\u5934\u548c\u6d47\u6c34\u58f6\u5f00\u59cb\uff0c\u7136\u540e\u5347\u7ea7\u5230\u81ea\u52a8\u5316\u7cfb\u7edf\u3002\u6b65\u9aa4\u4e8c\uff1a\u6295\u8d44\u62d6\u62c9\u673a\u8fdb\u884c\u5927\u89c4\u6a21\u8015\u4f5c\u3002\u6b65\u9aa4\u4e09\uff1a\u4f7f\u7528\u914d\u7f6e\u8868\u5c06\u5de5\u5177\u4e0e\u7279\u5b9a\u4efb\u52a1\u5339\u914d\uff0c\u4f8b\u5982\u4f7f\u7528\u9570\u5200\u6536\u5272\u3002\u5347\u7ea7\u5de5\u5177\u4e0d\u4ec5\u8282\u7701\u65f6\u95f4\uff0c\u800c\u4e14\u4ece\u957f\u8fdc\u6765\u770b\u8fd8\u80fd\u964d\u4f4e\u4eba\u5de5\u6210\u672c\u3002"}, {"question": "\u300a\u519c\u573a\u5bb6\u65cf\u300b\u4e2d\u7684\u5929\u6c14\u7cfb\u7edf\u5982\u4f55\u5f71\u54cd\u6e38\u620f\uff0c\u6211\u8be5\u5982\u4f55\u9002\u5e94\uff1f", "answer": "\u300a\u519c\u573a\u5bb6\u65cf\u300b\u4e2d\u7684\u5929\u6c14\u7cfb\u7edf\u76f4\u63a5\u5f71\u54cd\u4f5c\u7269\u751f\u957f\u548c\u7272\u755c\u5065\u5eb7\u3002\u4f8b\u5982\uff0c\u8fc7\u591a\u7684\u96e8\u6c34\u4f1a\u5bfc\u81f4\u7530\u5730\u79ef\u6c34\uff0c\u800c\u5e72\u65f1\u4f1a\u5bfc\u81f4\u751f\u957f\u53d7\u963b\u3002\u6b65\u9aa4\u4e00\uff1a\u5b9a\u671f\u76d1\u6d4b\u5929\u6c14\u9884\u62a5\u3002\u6b65\u9aa4\u4e8c\uff1a\u6839\u636e\u6709\u5229\u7684\u6c14\u8c61\u6761\u4ef6\u89c4\u5212\u79cd\u690d\u548c\u6536\u5272\u3002\u6b65\u9aa4\u4e09\uff1a\u4e3a\u5a07\u5ae9\u7684\u4f5c\u7269\u4f7f\u7528\u4fdd\u62a4\u63aa\u65bd\uff0c\u4f8b\u5982\u6e29\u5ba4\u3002\u6d41\u7a0b\u56fe\u53ef\u4ee5\u5e2e\u52a9\u4f60\u6839\u636e\u5929\u6c14\u6a21\u5f0f\u53ef\u89c6\u5316\u6700\u4f73\u7684\u79cd\u690d\u548c\u6536\u5272\u65f6\u95f4\u3002"}, {"question": "\u300a\u519c\u573a\u5bb6\u65cf\u300b\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u300a\u519c\u573a\u5bb6\u65cf\u300b\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u63d0\u4f9b\u4e0d\u540c\u7684\u4f53\u9a8c\u3002\u5728\u5355\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f60\u72ec\u7acb\u7ba1\u7406\u519c\u573a\u7684\u6240\u6709\u65b9\u9762\u3002\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f60\u53ef\u4ee5\u4e0e\u670b\u53cb\u5408\u4f5c\uff0c\u5171\u4eab\u8d44\u6e90\u5e76\u5206\u62c5\u4efb\u52a1\u3002\u4f8b\u5982\uff0c\u4e00\u4f4d\u73a9\u5bb6\u53ef\u4ee5\u4e13\u6ce8\u4e8e\u4f5c\u7269\uff0c\u800c\u53e6\u4e00\u4f4d\u73a9\u5bb6\u5219\u53ef\u4ee5\u7167\u6599\u7272\u755c\u3002\u6bd4\u8f83\u8868\u7a81\u51fa\u663e\u793a\u4e86\u6bcf\u79cd\u6a21\u5f0f\u7684\u4f18\u7f3a\u70b9\uff0c\u4f8b\u5982\u591a\u4eba\u6a21\u5f0f\u4e2d\u589e\u52a0\u4e86\u590d\u6742\u6027\u548c\u793e\u4ea4\u4e92\u52a8\u3002"}, {"question": "\u300a\u519c\u573a\u5bb6\u65cf\u300b\u7684\u7ecf\u6d4e\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u83b7\u5f97\u91d1\u5e01\u7684\u6700\u4f73\u65b9\u6cd5\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u519c\u573a\u5bb6\u65cf\u300b\u7684\u7ecf\u6d4e\u7cfb\u7edf\u56f4\u7ed5\u8d2d\u4e70\u3001\u51fa\u552e\u548c\u4ea4\u6613\u5546\u54c1\u5c55\u5f00\u3002\u6b65\u9aa4\u4e00\uff1a\u4e13\u6ce8\u4e8e\u9ad8\u9700\u6c42\u7684\u4f5c\u7269\u548c\u4ea7\u54c1\uff0c\u4f8b\u5982\u5976\u725b\u7684\u5976\u916a\u3002\u6b65\u9aa4\u4e8c\uff1a\u53c2\u4e0e\u5b63\u8282\u6027\u6d3b\u52a8\u4ee5\u83b7\u5f97\u989d\u5916\u91d1\u5e01\u3002\u6b65\u9aa4\u4e09\uff1a\u4f7f\u7528\u591a\u65b9\u6848\u65b9\u6cd5\u4f7f\u6536\u5165\u6765\u6e90\u591a\u6837\u5316\uff0c\u4f8b\u5982\u51fa\u552e\u4f5c\u7269\u548c\u624b\u5de5\u5236\u4f5c\u7684\u7269\u54c1\u3002\u6d41\u7a0b\u56fe\u53ef\u4ee5\u5e2e\u52a9\u4f60\u8ffd\u8e2a\u5168\u5e74\u6700\u76c8\u5229\u7684\u9879\u76ee\u3002"}, {"question": "\u6211\u80fd\u5426\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u300a\u519c\u573a\u5bb6\u65cf\u300b\u7684\u6e38\u620f\u8fdb\u5ea6\uff0c\u4ee5\u53ca\u5982\u4f55\u8f6c\u79fb\uff1f", "answer": "\u662f\u7684\uff0c\u4f60\u53ef\u4ee5\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u300a\u519c\u573a\u5bb6\u65cf\u300b\u7684\u6e38\u620f\u8fdb\u5ea6\u3002\u6b65\u9aa4\u4e00\uff1a\u786e\u4fdd\u4f60\u7684\u6e38\u620f\u5df2\u94fe\u63a5\u5230\u4e91\u7aef\u8d26\u6237\uff0c\u4f8b\u5982 Google Play \u6216 Apple \u6e38\u620f\u4e2d\u5fc3\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u6e38\u620f\u5185\u540c\u6b65\u529f\u80fd\u4e0a\u4f20\u4f60\u7684\u8fdb\u5ea6\u3002\u6b65\u9aa4\u4e09\uff1a\u767b\u5f55\u65b0\u7684\u5e73\u53f0\u5e76\u4e0b\u8f7d\u4f60\u7684\u6570\u636e\u3002\u914d\u7f6e\u8868\u53ef\u4ee5\u6307\u5bfc\u4f60\u5728\u6bcf\u4e2a\u5e73\u53f0\u4e0a\u5b8c\u6210\u7279\u5b9a\u7684\u6b65\u9aa4\uff0c\u786e\u4fdd\u5e73\u7a33\u8fc7\u6e21\u3002"}, {"question": "\u300a\u519c\u573a\u5bb6\u65cf\u300b\u4e2d\u9690\u85cf\u7684\u5f69\u86cb\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5982\u4f55\u627e\u5230\u5b83\u4eec\uff1f", "answer": "\u300a\u519c\u573a\u5bb6\u65cf\u300b\u5145\u6ee1\u4e86\u9690\u85cf\u7684\u5f69\u86cb\uff0c\u4e3a\u6e38\u620f\u589e\u6dfb\u4e50\u8da3\u548c\u795e\u79d8\u611f\u3002\u4f8b\u5982\uff0c\u5728\u8c37\u4ed3\u540e\u9762\u6709\u4e00\u4e2a\u79d8\u5bc6\u533a\u57df\uff0c\u53ef\u4ee5\u901a\u8fc7\u89e3\u8c1c\u6765\u8bbf\u95ee\u3002\u6b65\u9aa4\u4e00\uff1a\u5f7b\u5e95\u63a2\u7d22\u5730\u56fe\u7684\u6bcf\u4e2a\u89d2\u843d\u3002\u6b65\u9aa4\u4e8c\uff1a\u4e0e\u4e0d\u5bfb\u5e38\u7684\u7269\u54c1\u4e92\u52a8\uff0c\u4f8b\u5982\u7279\u5b9a\u7684\u6811\u6728\u6216\u5ca9\u77f3\u3002\u6b65\u9aa4\u4e09\uff1a\u4f7f\u7528\u793e\u533a\u8bba\u575b\u5206\u4eab\u548c\u53d1\u73b0\u63d0\u793a\u3002\u6d41\u7a0b\u56fe\u53ef\u4ee5\u5e2e\u52a9\u4f60\u4e86\u89e3\u53d1\u73b0\u8fd9\u4e9b\u9690\u85cf\u73cd\u5b9d\u7684\u6b65\u9aa4\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u519c\u573a\u5bb6\u65cf\u300b\u4e2d\u4f18\u5316\u519c\u573a\u5e03\u5c40\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u751f\u4ea7\u529b\uff1f", "answer": "\u4f18\u5316\u300a\u519c\u573a\u5bb6\u65cf\u300b\u4e2d\u7684\u519c\u573a\u5e03\u5c40\u9700\u8981\u6218\u7565\u89c4\u5212\u3002\u6b65\u9aa4\u4e00\uff1a\u5c06\u519c\u573a\u5212\u5206\u4e3a\u4f5c\u7269\u533a\u3001\u7272\u755c\u533a\u548c\u50a8\u5b58\u533a\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u7f51\u683c\u7cfb\u7edf\u786e\u4fdd\u9ad8\u6548\u5229\u7528\u7a7a\u95f4\u3002\u6b65\u9aa4\u4e09\uff1a\u5c06\u5e38\u7528\u8bbe\u65bd\uff08\u4f8b\u5982\u8c37\u4ed3\u548c\u5e02\u573a\uff09\u653e\u7f6e\u5728\u4e2d\u5fc3\u9644\u8fd1\uff0c\u65b9\u4fbf\u4f7f\u7528\u3002\u6bd4\u8f83\u8868\u53ef\u4ee5\u5e2e\u52a9\u4f60\u6839\u636e\u751f\u4ea7\u529b\u548c\u4fbf\u5229\u6027\u8bc4\u4f30\u4e0d\u540c\u7684\u5e03\u5c40\u65b9\u6848\u3002"}]
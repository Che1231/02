[{"question": "Farm Family\u306f\u3069\u306e\u3088\u3046\u306b\u59cb\u3081\u307e\u3059\u304b\uff1f\u8fc5\u901f\u306b\u59cb\u3081\u308b\u305f\u3081\u306e\u30ac\u30a4\u30c9\uff08\u521d\u5fc3\u8005\u5411\u3051\uff09\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Farm Family\u3092\u59cb\u3081\u308b\u306e\u306f\u3068\u3066\u3082\u7c21\u5358\u3067\u3059\uff01\u307e\u305a\u3001\u30b2\u30fc\u30e0\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3066\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u307e\u3059\u3002STEP1\uff1a\u30b2\u30fc\u30e0\u3092\u958b\u3044\u305f\u3089\u3001\u65b0\u624b\u30ac\u30a4\u30c9\u306b\u5f93\u3063\u3066\u57fa\u672c\u64cd\u4f5c\uff08\u7a2e\u307e\u304d\u3001\u6c34\u3084\u308a\u3001\u53ce\u7a6b\u306a\u3069\uff09\u3092\u5b8c\u4e86\u3057\u307e\u3059\u3002STEP2\uff1a\u65b0\u624b\u30df\u30c3\u30b7\u30e7\u30f3\u3092\u5b8c\u4e86\u3059\u308b\u3068\u3001\u30b4\u30fc\u30eb\u30c9\u3084\u7a2e\u306a\u3069\u91cd\u8981\u306a\u30ea\u30bd\u30fc\u30b9\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002STEP3\uff1a\u3053\u308c\u3089\u306e\u30ea\u30bd\u30fc\u30b9\u3092\u52b9\u679c\u7684\u306b\u6d3b\u7528\u3057\u3001\u307e\u305a\u8fb2\u5730\u3068\u5efa\u7269\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u307e\u3059\u3002\u30b2\u30fc\u30e0\u5185\u306b\u306f\u300c\u30df\u30c3\u30b7\u30e7\u30f3\u300d\u30dc\u30bf\u30f3\u304c\u3042\u308a\u3001\u73fe\u5728\u5b8c\u4e86\u53ef\u80fd\u306a\u30df\u30c3\u30b7\u30e7\u30f3\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002\u305d\u308c\u3089\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3067\u3001\u8fc5\u901f\u306b\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u3067\u304d\u307e\u3059\u3002\u307e\u308b\u3067\u3042\u306a\u305f\u306b\u3074\u3063\u305f\u308a\u306e\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u30de\u30c3\u30d7\u3067\u3059\uff01"}, {"question": "Farm Family\u306e\u4f5c\u7269\u53ce\u7a6b\u91cf\u304c\u4f4e\u3044\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1fFarm Family\u306e\u4f5c\u7269\u53ce\u7a6b\u91cf\u3092\u4e0a\u3052\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f\uff08\u521d\u5fc3\u8005\u5411\u3051\uff09", "answer": "\u4f5c\u7269\u53ce\u7a6b\u91cf\u304c\u4f4e\u3044\u306e\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u4e00\u822c\u7684\u306a\u539f\u56e0\u304c\u8003\u3048\u3089\u308c\u307e\u3059\u3002\u4e3b\u306a\u539f\u56e0\u306f\u3001\u571f\u58cc\u306e\u80a5\u6c83\u5ea6\u4e0d\u8db3\u3067\u3059\u3002\u5b9a\u671f\u7684\u306b\u80a5\u6599\u3092\u65bd\u3057\u3066\u571f\u58cc\u306e\u80a5\u6c83\u5ea6\u30ec\u30d9\u30eb\u3092\u9ad8\u3081\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002STEP1\uff1a\u8fb2\u5730\u306e\u571f\u58cc\u80a5\u6c83\u5ea6\u30ec\u30d9\u30eb\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002STEP2\uff1a\u80a5\u6599\u3092\u8cfc\u5165\u3057\u3066\u4f7f\u7528\u3057\u3066\u3001\u571f\u58cc\u306e\u80a5\u6c83\u5ea6\u3092\u9ad8\u3081\u307e\u3059\u3002STEP3\uff1a\u9ad8\u54c1\u8cea\u306e\u7a2e\u5b50\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u3088\u308a\u9ad8\u3044\u53ce\u7a6b\u91cf\u3092\u5f97\u3089\u308c\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u8fb2\u5730\u3092\u6e05\u6f54\u306b\u4fdd\u3064\u3053\u3068\u3082\u91cd\u8981\u3067\u3059\u3002\u96d1\u8349\u3084\u5bb3\u866b\u3092\u9664\u53bb\u3059\u308b\u3053\u3068\u3067\u3001\u4f5c\u7269\u304c\u640d\u50b7\u3059\u308b\u306e\u3092\u9632\u3050\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u8fb2\u5730\u306f\u3042\u306a\u305f\u306e\u5b50\u4f9b\u306e\u3088\u3046\u306b\u3001\u611b\u60c5\u3092\u304b\u3051\u3066\u80b2\u3066\u308c\u3070\u5927\u304d\u304f\u6210\u9577\u3059\u308b\u3067\u3057\u3087\u3046\uff01"}, {"question": "Farm Family\u3067\u3001\u53cb\u4eba\u30b7\u30b9\u30c6\u30e0\u3092\u52b9\u679c\u7684\u306b\u5229\u7528\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1fFarm Family\u3067\u53cb\u9054\u3068\u4ea4\u6d41\u3059\u308b\u3053\u3068\u3067\u5f97\u3089\u308c\u308b\u30e1\u30ea\u30c3\u30c8\u306f\u4f55\u3067\u3059\u304b\uff1f\uff08\u521d\u5fc3\u8005\u5411\u3051\uff09", "answer": "Farm Family\u3067\u306f\u3001\u53cb\u4eba\u30b7\u30b9\u30c6\u30e0\u304c\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u4e92\u3044\u306b\u52a9\u3051\u5408\u3046\u3053\u3068\u3067\u3001\u8ffd\u52a0\u306e\u5831\u916c\u3092\u5f97\u3089\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u53cb\u3060\u3061\u306e\u6c34\u3084\u308a\u3084\u8349\u53d6\u308a\u306a\u3069\u3092\u624b\u4f1d\u3046\u3053\u3068\u3067\u3001\u7d4c\u9a13\u5024\u3084\u30b4\u30fc\u30eb\u30c9\u3092\u5f97\u3089\u308c\u307e\u3059\u3002STEP1\uff1a\u53ef\u80fd\u306a\u9650\u308a\u591a\u304f\u306e\u6d3b\u52d5\u7684\u306a\u53cb\u4eba\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002STEP2\uff1a\u6bce\u65e5\u53cb\u4eba\u306e\u8fb2\u5834\u3092\u8a2a\u308c\u3066\u4ea4\u6d41\u3057\u307e\u3059\u3002STEP3\uff1a\u53cb\u4eba\u306e\u30b7\u30e7\u30c3\u30d7\u3067\u3001\u7279\u5225\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u8cfc\u5165\u3067\u304d\u307e\u3059\u3002\u53cb\u3060\u3061\u3068\u306e\u4ea4\u6d41\u306f\u4eba\u8108\u306e\u69cb\u7bc9\u3068\u540c\u69d8\u306b\u3001\u3042\u306a\u305f\u306e\u8fb2\u5834\u3092\u3088\u308a\u8fc5\u901f\u306b\u767a\u5c55\u3055\u305b\u308b\u304a\u624b\u4f1d\u3044\u3092\u3057\u3066\u304f\u308c\u307e\u3059\uff01"}, {"question": "Farm Family\u306e\u30da\u30c3\u30c8\u30b7\u30b9\u30c6\u30e0\u306b\u306f\u3001\u3069\u306e\u3088\u3046\u306a\u96a0\u3055\u308c\u305f\u4ed5\u7d44\u307f\u304c\u3042\u308a\u307e\u3059\u304b\uff1fFarm Family\u306e\u30da\u30c3\u30c8\u30b7\u30b9\u30c6\u30e0\u3092\u6700\u5927\u9650\u306b\u6d3b\u7528\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f(\u4e0a\u7d1a\u8005)", "answer": "Farm Family\u306e\u30da\u30c3\u30c8\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u8868\u9762\u4e0a\u898b\u3048\u308b\u3082\u306e\u3060\u3051\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u305d\u308c\u305e\u308c\u306e\u30da\u30c3\u30c8\u306f\u3001\u72ec\u81ea\u306e\u30b9\u30ad\u30eb\u3068\u5c5e\u6027\u30dc\u30fc\u30ca\u30b9\u3092\u6301\u3061\u3001\u8fb2\u5834\u306e\u52b9\u7387\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30da\u30c3\u30c8\u306e\u30ec\u30d9\u30eb\u306b\u3088\u3063\u3066\u3001\u5f97\u3089\u308c\u308b\u6069\u6075\u3082\u5927\u304d\u304f\u7570\u306a\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5e0c\u5c11\u306a\u30da\u30c3\u30c8\u306f\u53ce\u7a6b\u91cf\u309220%\u5897\u52a0\u3055\u305b\u307e\u3059\u304c\u3001\u4e00\u822c\u7684\u306a\u30da\u30c3\u30c8\u306f5%\u3057\u304b\u5897\u52a0\u3055\u305b\u307e\u305b\u3093\u3002STEP1\uff1a\u30a4\u30d9\u30f3\u30c8\u3084\u30b7\u30e7\u30c3\u30d7\u3067\u30da\u30c3\u30c8\u3092\u5165\u624b\u3057\u307e\u3059\u3002STEP2\uff1a\u30da\u30c3\u30c8\u3092\u990c\u3067\u80b2\u3066\u3066\u30ec\u30d9\u30eb\u3068\u30b9\u30ad\u30eb\u3092\u9ad8\u3081\u307e\u3059\u3002STEP3\uff1a\u3042\u306a\u305f\u306e\u8fb2\u5834\u958b\u767a\u6226\u7565\u306b\u5408\u308f\u305b\u3066\u3001\u9069\u5207\u306a\u30da\u30c3\u30c8\u3092\u7d44\u307f\u5408\u308f\u305b\u307e\u3059\u3002\u69d8\u3005\u306a\u30da\u30c3\u30c8\u306e\u7d44\u307f\u5408\u308f\u305b\u306f\u5316\u5b66\u53cd\u5fdc\u306e\u3088\u3046\u306b\u3001\u4e88\u60f3\u5916\u306e\u9a5a\u304d\u3092\u3082\u305f\u3089\u3059\u3067\u3057\u3087\u3046\uff01"}, {"question": "Farm Family\u3067\u9ad8\u7d1a\u4f5c\u7269\u3092\u683d\u57f9\u3059\u308b\u30b3\u30c4\u306f\uff1fFarm Family\u3067\u5229\u76ca\u3092\u6700\u5927\u5316\u3059\u308b\u9ad8\u5ea6\u306a\u4f5c\u7269\u683d\u57f9\u6226\u7565\u306f\uff1f(\u30d9\u30c6\u30e9\u30f3)", "answer": "\u9ad8\u7d1a\u4f5c\u7269\u683d\u57f9\u306b\u306f\u6226\u7565\u304c\u5fc5\u8981\u3067\u3059\u3002\u307e\u305a\u3001\u5404\u4f5c\u7269\u306e\u751f\u80b2\u671f\u9593\u3068\u5e02\u5834\u4fa1\u683c\u306e\u5909\u52d5\u3092\u628a\u63e1\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4e00\u822c\u7684\u306b\u3001\u751f\u80b2\u671f\u9593\u304c\u9577\u3044\u4f5c\u7269\u306f\u5229\u76ca\u7387\u304c\u9ad8\u3044\u3067\u3059\u304c\u3001\u3088\u308a\u591a\u304f\u306e\u5fcd\u8010\u304c\u5fc5\u8981\u3067\u3059\u3002\u6b21\u306b\u3001\u8fb2\u5730\u3092\u52b9\u679c\u7684\u306b\u8a08\u753b\u3057\u3001\u5b63\u7bc0\u3068\u5e02\u5834\u9700\u8981\u306b\u5408\u308f\u305b\u3066\u683d\u57f9\u8a08\u753b\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u300c\u8f2a\u4f5c\u300d\u3092\u4f7f\u3063\u3066\u571f\u58cc\u306e\u80a5\u6c83\u5ea6\u3092\u7dad\u6301\u3057\u3001\u5358\u4e00\u4f5c\u7269\u306b\u3088\u308b\u571f\u58cc\u306e\u904e\u5ea6\u306e\u6d88\u8017\u3092\u9632\u304e\u307e\u3059\u3002STEP1\uff1a\u5e02\u5834\u306e\u4fa1\u683c\u52d5\u5411\u3092\u8abf\u3079\u307e\u3059\u3002STEP2\uff1a\u5b63\u7bc0\u306b\u5408\u308f\u305b\u3066\u4f5c\u7269\u3092\u683d\u57f9\u3057\u307e\u3059\u3002STEP3\uff1a\u8f2a\u4f5c\u3092\u4f7f\u3063\u3066\u571f\u58cc\u306e\u80a5\u6c83\u5ea6\u3092\u7dad\u6301\u3057\u307e\u3059\u3002\u682a\u5f0f\u6295\u8cc7\u3068\u540c\u69d8\u306b\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u6349\u3048\u3001\u591a\u69d8\u306a\u69cb\u6210\u3092\u63a1\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u6700\u5927\u9650\u306e\u53ce\u76ca\u3092\u5f97\u3089\u308c\u308b\u3067\u3057\u3087\u3046\uff01"}, {"question": "Farm Family\u306e\u5f8c\u671f\u306b\u304a\u3051\u308b\u571f\u5730\u8a08\u753b\u3067\u8003\u616e\u3059\u3079\u304d\u70b9\u306f\uff1fFarm Family\u306e\u6700\u7d42\u6bb5\u968e\u3067\u571f\u5730\u3092\u8a08\u753b\u3059\u308b\u3068\u304d\u306b\u8003\u616e\u3059\u3079\u304d\u91cd\u8981\u306a\u70b9\u306f\uff1f(\u30d9\u30c6\u30e9\u30f3)", "answer": "\u5f8c\u671f\u306e\u571f\u5730\u8a08\u753b\u306f\u52b9\u7387\u6027\u3068\u7f8e\u89b3\u306e\u4e21\u65b9\u3092\u8003\u616e\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u540c\u3058\u7a2e\u985e\u306e\u5efa\u7269\u3084\u8fb2\u5730\u3092\u307e\u3068\u3081\u3066\u914d\u7f6e\u3059\u308b\u3068\u3001\u7ba1\u7406\u3068\u64cd\u4f5c\u304c\u5bb9\u6613\u306b\u306a\u308a\u307e\u3059\u3002\u540c\u6642\u306b\u3001\u5c06\u6765\u306e\u62e1\u5f35\u306e\u305f\u3081\u306b\u5341\u5206\u306a\u30b9\u30da\u30fc\u30b9\u3092\u78ba\u4fdd\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u300c\u30b0\u30ea\u30c3\u30c9\u30ec\u30a4\u30a2\u30a6\u30c8\u300d\u3084\u300c\u653e\u5c04\u72b6\u30ec\u30a4\u30a2\u30a6\u30c8\u300d\u306e\u3088\u3046\u306a\u53e4\u5178\u7684\u306a\u8fb2\u5834\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u53c2\u7167\u306b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002STEP1\uff1a\u30b2\u30fc\u30e0\u76ee\u6a19\u3068\u958b\u767a\u6226\u7565\u306b\u57fa\u3065\u3044\u3066\u8fb2\u5834\u306e\u4e3b\u8981\u306a\u30a8\u30ea\u30a2\u3092\u6c7a\u5b9a\u3057\u307e\u3059\u3002STEP2\uff1a\u540c\u3058\u7a2e\u985e\u306e\u5efa\u7269\u3092\u307e\u3068\u3081\u3066\u914d\u7f6e\u3059\u308b\u3053\u3068\u3067\u52b9\u7387\u3092\u9ad8\u3081\u307e\u3059\u3002STEP3\uff1a\u5c06\u6765\u306e\u62e1\u5f35\u306e\u305f\u3081\u306b\u5341\u5206\u306a\u30b9\u30da\u30fc\u30b9\u3092\u78ba\u4fdd\u3057\u307e\u3059\u3002\u8a08\u753b\u306f\u5efa\u7269\u3092\u5efa\u3066\u308b\u305f\u3081\u306e\u571f\u53f0\u3092\u4f5c\u308b\u3088\u3046\u306a\u3082\u306e\u3067\u3001\u7dbf\u5bc6\u306a\u8a08\u753b\u3067\u8fb2\u5834\u306f\u3088\u308a\u5b89\u5b9a\u3057\u3066\u52b9\u7387\u7684\u306b\u904b\u55b6\u3055\u308c\u307e\u3059\uff01"}, {"question": "Farm Family\u3067\u3001\u53cb\u4eba\u4e92\u52a9\u306e\u5831\u916c\u306f\u3069\u306e\u3088\u3046\u306b\u7b97\u51fa\u3055\u308c\u307e\u3059\u304b\uff1fFarm Family\u3067\u53cb\u60c5\u63f4\u52a9\u5831\u916c\u3092\u8a08\u7b97\u3059\u308b\u6839\u5e95\u306b\u3042\u308b\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f(\u30b7\u30b9\u30c6\u30e0\u5206\u6790)", "answer": "Farm Family\u3067\u306f\u3001\u53cb\u4eba\u4e92\u52a9\u306e\u5831\u916c\u306f\u30e9\u30f3\u30c0\u30e0\u306b\u751f\u6210\u3055\u308c\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u8907\u96d1\u306a\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306b\u57fa\u3065\u3044\u3066\u7b97\u51fa\u3055\u308c\u307e\u3059\u3002\u5831\u916c\u306f\u3001\u53cb\u4eba\u306e\u30ec\u30d9\u30eb\u3001\u8fb2\u5834\u306e\u898f\u6a21\u3001\u305d\u3057\u3066\u3042\u306a\u305f\u306e\u76f8\u4e92\u4f5c\u7528\u884c\u52d5\u306b\u95a2\u9023\u3057\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u9ad8\u30ec\u30d9\u30eb\u306e\u53cb\u4eba\u3092\u30b5\u30dd\u30fc\u30c8\u3059\u308b\u3068\u3001\u3088\u308a\u9ad8\u3044\u5831\u916c\u3092\u5f97\u3089\u308c\u307e\u3059\u3002\u9023\u7d9a\u7684\u306a\u76f8\u4e92\u4f5c\u7528\u306f\u3001\u5831\u916c\u500d\u7387\u306e\u5897\u52a0\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306e\u5f0f\u306f\u6982\u306d\u6b21\u306e\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002\u5831\u916c\uff1d\u57fa\u672c\u5024\uff0a\uff081\uff0b\u53cb\u4eba\u30ec\u30d9\u30eb\u4fc2\u6570\uff0b\u76f8\u4e92\u4f5c\u7528\u4fc2\u6570\uff09\u3002\u3053\u306e\u4ed5\u7d44\u307f\u3092\u7406\u89e3\u3057\u305f\u4e0a\u3067\u3001\u3088\u308a\u6226\u7565\u7684\u306b\u53cb\u3060\u3061\u3068\u4ea4\u6d41\u3057\u3001\u6700\u5927\u9650\u306e\u5229\u76ca\u3092\u5f97\u3089\u308c\u307e\u3059\u3002\u3055\u307e\u3056\u307e\u306a\u72b6\u6cc1\u3067\u306e\u53ce\u76ca\u7387\u3092\u8a18\u9332\u3059\u308b\u8868\u3092\u4f5c\u6210\u3059\u308b\u3053\u3068\u3067\u3001\u3042\u306a\u305f\u306e\u30bd\u30fc\u30b7\u30e3\u30eb\u6226\u7565\u3092\u6700\u9069\u5316\u3067\u304d\u307e\u3059\uff01"}, {"question": "Farm Family\u306e\u300c\u5e78\u904b\u306e\u56de\u8ee2\u76e4\u300d\u306e\u78ba\u7387\u306f\u3069\u306e\u3088\u3046\u306b\u8a2d\u5b9a\u3055\u308c\u3066\u3044\u307e\u3059\u304b\uff1fFarm Family\u306e\u300c\u5e78\u904b\u306e\u56de\u8ee2\u76e4\u300d\u6a5f\u80fd\u306e\u78ba\u7387\u5206\u5e03\u306f\u3069\u306e\u3088\u3046\u306b\u6c7a\u5b9a\u3055\u308c\u3066\u3044\u307e\u3059\u304b\uff1f(\u30b7\u30b9\u30c6\u30e0\u89e3\u6790)", "answer": "\u300c\u5e78\u904b\u306e\u56de\u8ee2\u76e4\u300d\u306e\u78ba\u7387\u8a2d\u5b9a\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u8208\u596e\u611f\u3068\u30b2\u30fc\u30e0\u306e\u53ce\u76ca\u3092\u30d0\u30e9\u30f3\u30b9\u3055\u305b\u308b\u3001\u8907\u96d1\u306a\u8a2d\u8a08\u30d7\u30ed\u30bb\u30b9\u3067\u3059\u3002\u4e00\u822c\u7684\u306b\u3001\u5e0c\u5c11\u30a2\u30a4\u30c6\u30e0\u306e\u78ba\u7387\u306f\u4e00\u822c\u7684\u306a\u30a2\u30a4\u30c6\u30e0\u3088\u308a\u3082\u306f\u308b\u304b\u306b\u4f4e\u304f\u306a\u308a\u307e\u3059\u3002\u307e\u305f\u3001\u5f15\u304d\u63db\u3048\u56de\u6570\u304c\u591a\u304f\u306a\u308b\u307b\u3069\u3001\u5e0c\u5c11\u30a2\u30a4\u30c6\u30e0\u3092\u7372\u5f97\u3059\u308b\u78ba\u7387\u306f\u308f\u305a\u304b\u306b\u5411\u4e0a\u3057\u307e\u3059\u304c\u3001\u4e0a\u9650\u304c\u3042\u308a\u307e\u3059\u3002\u30b2\u30fc\u30e0\u958b\u767a\u8005\u306f\u901a\u5e38\u3001\u507d\u4e71\u6570\u30b8\u30a7\u30cd\u30ec\u30fc\u30bf\u3092\u4f7f\u7528\u3057\u3066\u62bd\u9078\u30d7\u30ed\u30bb\u30b9\u3092\u30b7\u30df\u30e5\u30ec\u30fc\u30c8\u3057\u3001\u516c\u5e73\u6027\u3092\u78ba\u4fdd\u3057\u307e\u3059\u3002\u5927\u91cf\u306e\u30c7\u30fc\u30bf\u5206\u6790\u304b\u3089\u78ba\u7387\u5206\u5e03\u3092\u63a8\u6e2c\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u5408\u7406\u7684\u306a\u62bd\u9078\u6226\u7565\u3092\u7acb\u3066\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u6bce\u56de\u306f\u78ba\u7387\u7684\u306a\u51fa\u6765\u4e8b\u3067\u3042\u308b\u3053\u3068\u3092\u7406\u89e3\u3057\u3001\u51b7\u9759\u306b\u53c2\u52a0\u3057\u3001\u9069\u5207\u306b\u697d\u3057\u307f\u307e\u3057\u3087\u3046\uff01"}, {"question": "Farm Family\u306f\u3001\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u30c7\u30fc\u30bf\u3092\u540c\u671f\u3057\u307e\u3059\u304b\uff1fFarm Family\u306e\u30c7\u30fc\u30bf\u540c\u671f\u6a5f\u80fd\u306f\u3001\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0(iOS\u3001Android\u3001PC)\u9593\u3067\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f(\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0)", "answer": "Farm Family\u306f\u901a\u5e38\u3001\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30c7\u30fc\u30bf\u540c\u671f\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u307e\u3059\u3002\u3064\u307e\u308a\u3001\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3001\u30b2\u30fc\u30e0\u306e\u9032\u884c\u3092\u7d9a\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305f\u3060\u3057\u3001\u5177\u4f53\u7684\u306a\u540c\u671f\u65b9\u6cd5\u304c\u7570\u306a\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u901a\u5e38\u3001\u3042\u306a\u305f\u306e\u30b2\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30bd\u30fc\u30b7\u30e3\u30eb\u30e1\u30c7\u30a3\u30a2\u30a2\u30ab\u30a6\u30f3\u30c8\u307e\u305f\u306f\u30b2\u30fc\u30e0\u30bb\u30f3\u30bf\u30fc\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u7d10\u4ed8\u3051\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30c7\u30fc\u30bf\u540c\u671f\u306e\u554f\u984c\u304c\u767a\u751f\u3057\u305f\u5834\u5408\u306f\u3001\u518d\u30ed\u30b0\u30a4\u30f3\u307e\u305f\u306f\u30ab\u30b9\u30bf\u30de\u30fc\u30b5\u30fc\u30d3\u30b9\u306b\u9023\u7d61\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30af\u30e9\u30a6\u30c9\u30b9\u30c8\u30ec\u30fc\u30b8\u3068\u540c\u69d8\u306b\u3001\u30b2\u30fc\u30e0\u30c7\u30fc\u30bf\u306f\u30b5\u30fc\u30d0\u30fc\u306b\u5b89\u5168\u306b\u4fdd\u5b58\u3055\u308c\u3066\u3044\u308b\u305f\u3081\u3001\u3044\u3064\u3067\u3082\u3069\u3053\u304b\u3089\u3067\u3082\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059\uff01"}, {"question": "Farm Family\u306e\u96a0\u3055\u308c\u305f\u300c\u795e\u79d8\u5ead\u5712\u300d\u3092\u3069\u306e\u3088\u3046\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u304b\uff1fFarm Family\u306e\u96a0\u3055\u308c\u305f\u300c\u795e\u79d8\u5ead\u5712\u300d\u30a8\u30ea\u30a2\u3092\u3069\u306e\u3088\u3046\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u304b\u3001\u3069\u306e\u3088\u3046\u306a\u30e6\u30cb\u30fc\u30af\u306a\u30e1\u30ea\u30c3\u30c8\u304c\u3042\u308a\u307e\u3059\u304b\uff1f(\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4)", "answer": "Farm Family\u306b\u306f\u96a0\u3055\u308c\u305f\u300c\u795e\u79d8\u5ead\u5712\u300d\u304c\u3042\u308a\u307e\u3059\u3002\u7279\u5b9a\u306e\u6761\u4ef6\u3092\u6e80\u305f\u3059\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u3002\u901a\u5e38\u3001\u7279\u5b9a\u306e\u30bf\u30b9\u30af\u3092\u5b8c\u4e86\u3057\u3001\u7279\u5b9a\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u96c6\u3081\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u3059\u3079\u3066\u306e\u30e1\u30a4\u30f3\u30df\u30c3\u30b7\u30e7\u30f3\u3092\u5b8c\u4e86\u3057\u30015\u3064\u306e\u300c\u9b54\u6cd5\u306e\u7a2e\u300d\u3092\u96c6\u3081\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u300c\u795e\u79d8\u5ead\u5712\u300d\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u3068\u3001\u7279\u5225\u306a\u4f5c\u7269\u3092\u683d\u57f9\u3057\u3001\u8ffd\u52a0\u306e\u5831\u916c\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u300c\u795e\u79d8\u5ead\u5712\u300d\u306f\u3001\u30b2\u30fc\u30e0\u5185\u306e\u5f69\u86cb\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3001\u771f\u5263\u306b\u63a2\u6c42\u3057\u3001\u767a\u898b\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u3067\u3057\u3087\u3046\u3002\u300c\u795e\u79d8\u5ead\u5712\u300d\u306b\u306f\u3001\u3055\u3089\u306b\u306f\u7279\u5225\u306a\u30da\u30c3\u30c8\u3084\u88c5\u98fe\u54c1\u304c\u3042\u308a\u3001\u8fb2\u5834\u751f\u6d3b\u3092\u3055\u3089\u306b\u8c4a\u304b\u306b\u3057\u307e\u3059\uff01"}]
[{"question": "\u521d\u5fc3\u8005\u5411\u3051\u306b\u3001\u8fb2\u5834\u30d5\u30a1\u30df\u30ea\u30fc\u3067\u52b9\u7387\u7684\u306b\u4f5c\u7269\u3092\u683d\u57f9\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u8fb2\u5834\u30d5\u30a1\u30df\u30ea\u30fc\u3067\u52b9\u7387\u7684\u306b\u4f5c\u7269\u3092\u683d\u57f9\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5b63\u7bc0\u3068\u571f\u58cc\u306e\u80a5\u6c83\u5ea6\u306b\u57fa\u3065\u3044\u3066\u4f5c\u7269\u306e\u7a2e\u985e\u3092\u9078\u3073\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6625\u306b\u5c0f\u9ea6\u3092\u690d\u3048\u308b\u3068\u826f\u3044\u7d50\u679c\u304c\u5f97\u3089\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b0\u30ea\u30c3\u30c9\u683d\u57f9\u6cd5\u3092\u4f7f\u7528\u3057\u3001\u30b9\u30da\u30fc\u30b9\u3092\u6700\u5927\u9650\u306b\u6d3b\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u751f\u80b2\u72b6\u6cc1\u3092\u5b9a\u671f\u7684\u306b\u78ba\u8a8d\u3057\u3001\u4f5c\u7269\u306b\u6c34\u3092\u3084\u308a\u307e\u3057\u3087\u3046\u3002\u8a2d\u5b9a\u8868\u306f\u4f5c\u7269\u3068\u6700\u9069\u306a\u5b63\u7bc0\u3084\u571f\u58cc\u306e\u7a2e\u985e\u3092\u30de\u30c3\u30c1\u3055\u305b\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u8fb2\u5834\u30d5\u30a1\u30df\u30ea\u30fc\u3067\u4f5c\u7269\u3092\u56de\u8ee2\u3055\u305b\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u307e\u305f\u3001\u3069\u306e\u3088\u3046\u306b\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u8fb2\u5834\u30d5\u30a1\u30df\u30ea\u30fc\u3067\u4f5c\u7269\u3092\u56de\u8ee2\u3055\u305b\u308b\u3053\u3068\u306f\u3001\u571f\u58cc\u306e\u80a5\u6c83\u5ea6\u3092\u7dad\u6301\u3057\u3001\u5bb3\u866b\u306e\u767a\u751f\u3092\u9632\u3050\u305f\u3081\u306b\u91cd\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u3042\u308b\u4f5c\u7269\u3092\u53ce\u7a6b\u3057\u305f\u3089\u3001\u540c\u3058\u5834\u6240\u306b\u5225\u306e\u7a2e\u985e\u306e\u4f5c\u7269\u3092\u690d\u3048\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5c0f\u9ea6\u306e\u5f8c\u306b\u30de\u30e1\u79d1\u306e\u690d\u7269\u3092\u690d\u3048\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u4f7f\u7528\u3057\u3066\u56de\u8ee2\u30b5\u30a4\u30af\u30eb\u3092\u8ffd\u8de1\u3057\u3001\u5404\u533a\u753b\u306b\u69d8\u3005\u306a\u4f5c\u7269\u304c\u690d\u3048\u3089\u308c\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u80a5\u6599\u3092\u4f7f\u7528\u3057\u3066\u6804\u990a\u5206\u3092\u88dc\u5145\u3057\u307e\u3059\u3002\u3053\u306e\u65b9\u6cd5\u306f\u3001\u53ce\u91cf\u3092\u9ad8\u3081\u308b\u3060\u3051\u3067\u306a\u304f\u3001\u6642\u9593\u306e\u7d4c\u904e\u3068\u3068\u3082\u306b\u571f\u58cc\u306e\u5065\u5eb7\u3092\u9ad8\u3081\u307e\u3059\u3002"}, {"question": "\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4100\u6642\u9593\u5f8c\u3001\u8fb2\u5834\u30d5\u30a1\u30df\u30ea\u30fc\u3067\u8cc7\u6e90\u3092\u7ba1\u7406\u3059\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u8fb2\u5834\u30d5\u30a1\u30df\u30ea\u30fc\u3067100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u8cc7\u6e90\u7ba1\u7406\u306f\u91cd\u8981\u306b\u306a\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u53ce\u76ca\u304c\u5b89\u5b9a\u3057\u3066\u3044\u308b\u4e73\u725b\u306a\u3069\u3001\u9ad8\u4fa1\u5024\u306e\u4f5c\u7269\u3084\u5bb6\u755c\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u4f59\u5270\u4f5c\u7269\u3092\u4fdd\u5b58\u3059\u308b\u305f\u3081\u306b\u8caf\u8535\u65bd\u8a2d\u306b\u6295\u8cc7\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u77ed\u671f\u7684\u306a\u5229\u76ca\u3068\u9577\u671f\u7684\u306a\u6295\u8cc7\uff08\u30c4\u30fc\u30eb\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306a\u3069\uff09\u306e\u30d0\u30e9\u30f3\u30b9\u3092\u53d6\u308b\u591a\u69d8\u306a\u65b9\u6cd5\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u6bd4\u8f03\u8868\u306f\u3001\u3069\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u304c\u6295\u8cc7\u53ce\u76ca\u7387\u304c\u6700\u3082\u9ad8\u3044\u304b\u3092\u5224\u65ad\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u8fb2\u5834\u30d5\u30a1\u30df\u30ea\u30fc\u3067\u52b9\u7387\u3092\u6700\u5927\u5316\u3059\u308b\u305f\u3081\u306b\u3001\u3069\u306e\u30c4\u30fc\u30eb\u3068\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u91cd\u70b9\u3092\u7f6e\u304f\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u8fb2\u5834\u30d5\u30a1\u30df\u30ea\u30fc\u3067\u306f\u3001\u9069\u5207\u306a\u30c4\u30fc\u30eb\u3068\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3053\u3068\u3067\u3001\u52b9\u7387\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u57fa\u672c\u7684\u306a\u92e4\u3068\u6c34\u3084\u308a\u7f36\u304b\u3089\u59cb\u3081\u3066\u3001\u81ea\u52d5\u5316\u30b7\u30b9\u30c6\u30e0\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5927\u898f\u6a21\u306a\u8fb2\u696d\u306e\u305f\u3081\u306b\u30c8\u30e9\u30af\u30bf\u30fc\u306b\u6295\u8cc7\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u8a2d\u5b9a\u8868\u3092\u4f7f\u7528\u3057\u3066\u3001\u5208\u308a\u53d6\u308a\u7528\u306e\u938c\u306a\u3069\u3001\u7279\u5b9a\u306e\u30bf\u30b9\u30af\u306b\u5408\u3063\u305f\u30c4\u30fc\u30eb\u3092\u30de\u30c3\u30c1\u3055\u305b\u307e\u3059\u3002\u30c4\u30fc\u30eb\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3053\u3068\u3067\u3001\u6642\u9593\u3060\u3051\u3067\u306a\u304f\u3001\u9577\u671f\u7684\u306a\u52b4\u52d9\u30b3\u30b9\u30c8\u3082\u524a\u6e1b\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u8fb2\u5834\u30d5\u30a1\u30df\u30ea\u30fc\u306e\u5929\u5019\u30b7\u30b9\u30c6\u30e0\u306f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u304b\uff1f\u3069\u306e\u3088\u3046\u306b\u9069\u5fdc\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u8fb2\u5834\u30d5\u30a1\u30df\u30ea\u30fc\u306e\u5929\u5019\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u4f5c\u7269\u306e\u6210\u9577\u3068\u5bb6\u755c\u306e\u5065\u5eb7\u306b\u76f4\u63a5\u5f71\u97ff\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u904e\u5270\u306a\u96e8\u306f\u7551\u3092\u6c34\u6ca1\u3055\u305b\u3001\u5e72\u3070\u3064\u306f\u6210\u9577\u3092\u963b\u5bb3\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5929\u5019\u306e\u4e88\u6e2c\u3092\u5b9a\u671f\u7684\u306b\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u597d\u6761\u4ef6\u306b\u5408\u308f\u305b\u3066\u690d\u3048\u4ed8\u3051\u3068\u53ce\u7a6b\u3092\u8a08\u753b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30c7\u30ea\u30b1\u30fc\u30c8\u306a\u4f5c\u7269\u306b\u306f\u6e29\u5ba4\u306a\u3069\u306e\u4fdd\u8b77\u7b56\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u306f\u3001\u5929\u5019\u306e\u30d1\u30bf\u30fc\u30f3\u306b\u57fa\u3065\u3044\u3066\u690d\u3048\u4ed8\u3051\u3068\u53ce\u7a6b\u306e\u6700\u9069\u306a\u6642\u671f\u3092\u8996\u899a\u5316\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u8fb2\u5834\u30d5\u30a1\u30df\u30ea\u30fc\u306e\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u8fb2\u5834\u30d5\u30a1\u30df\u30ea\u30fc\u306e\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u3001\u7570\u306a\u308b\u4f53\u9a13\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u306f\u3001\u8fb2\u5834\u306e\u3042\u3089\u3086\u308b\u5074\u9762\u3092\u72ec\u7acb\u3057\u3066\u7ba1\u7406\u3057\u307e\u3059\u3002\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u306f\u3001\u53cb\u9054\u3068\u5354\u529b\u3057\u3001\u8cc7\u6e90\u3092\u5171\u6709\u3057\u3001\u30bf\u30b9\u30af\u3092\u5206\u62c5\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u3042\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u4f5c\u7269\u306b\u96c6\u4e2d\u3057\u3001\u5225\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u5bb6\u755c\u3092\u4e16\u8a71\u3067\u304d\u307e\u3059\u3002\u6bd4\u8f03\u8868\u306f\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u8907\u96d1\u3055\u3068\u793e\u4f1a\u7684\u4ea4\u6d41\u306e\u5897\u52a0\u306a\u3069\u3001\u305d\u308c\u305e\u308c\u306e\u30e2\u30fc\u30c9\u306e\u5229\u70b9\u3068\u6b20\u70b9\u3092\u793a\u3057\u3066\u3044\u307e\u3059\u3002"}, {"question": "\u8fb2\u5834\u30d5\u30a1\u30df\u30ea\u30fc\u306e\u7d4c\u6e08\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u30b3\u30a4\u30f3\u3092\u7a3c\u3050\u305f\u3081\u306e\u6700\u826f\u306e\u65b9\u6cd5\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u8fb2\u5834\u30d5\u30a1\u30df\u30ea\u30fc\u306e\u7d4c\u6e08\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u5546\u54c1\u306e\u8cfc\u5165\u3001\u8ca9\u58f2\u3001\u53d6\u5f15\u3092\u4e2d\u5fc3\u3068\u3057\u3066\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u9ad8\u9700\u8981\u306e\u4f5c\u7269\u3084\u88fd\u54c1\uff08\u4e73\u725b\u306e\u30c1\u30fc\u30ba\u306a\u3069\uff09\u306b\u96c6\u4e2d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5b63\u7bc0\u30a4\u30d9\u30f3\u30c8\u306b\u53c2\u52a0\u3057\u3066\u30dc\u30fc\u30ca\u30b9\u30b3\u30a4\u30f3\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u4f5c\u7269\u3068\u52a0\u5de5\u54c1\u4e21\u65b9\u306e\u8ca9\u58f2\u306a\u3069\u3001\u53ce\u5165\u6e90\u3092\u591a\u69d8\u5316\u3055\u305b\u308b\u591a\u69d8\u306a\u8a08\u753b\u3092\u4f7f\u3044\u307e\u3059\u3002\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u306f\u3001\u5e74\u9593\u3092\u901a\u3057\u3066\u6700\u3082\u53ce\u76ca\u6027\u306e\u9ad8\u3044\u4e8b\u696d\u3092\u8ffd\u8de1\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u8fb2\u5834\u30d5\u30a1\u30df\u30ea\u30fc\u306e\u9032\u884c\u72b6\u6cc1\u3092\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f\u3069\u306e\u3088\u3046\u306b\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u8fb2\u5834\u30d5\u30a1\u30df\u30ea\u30fc\u306e\u9032\u884c\u72b6\u6cc1\u3092\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u8ee2\u9001\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b2\u30fc\u30e0\u304cGoogle Play\u3084Apple Game Center\u306e\u3088\u3046\u306a\u30af\u30e9\u30a6\u30c9\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ea\u30f3\u30af\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b2\u30fc\u30e0\u5185\u306e\u540c\u671f\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u3001\u9032\u884c\u72b6\u6cc1\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u65b0\u3057\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u30c7\u30fc\u30bf\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u8a2d\u5b9a\u8868\u306f\u3001\u5404\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u5177\u4f53\u7684\u306a\u624b\u9806\u3092\u793a\u3057\u3001\u30b9\u30e0\u30fc\u30ba\u306a\u79fb\u884c\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002"}, {"question": "\u8fb2\u5834\u30d5\u30a1\u30df\u30ea\u30fc\u306e\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u4f55\u3067\u3059\u304b\uff1f\u3069\u306e\u3088\u3046\u306b\u767a\u898b\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u8fb2\u5834\u30d5\u30a1\u30df\u30ea\u30fc\u306b\u306f\u3001\u697d\u3057\u307f\u3068\u8b0e\u3092\u52a0\u3048\u308b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u305f\u304f\u3055\u3093\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u7d0d\u5c4b\u306e\u88cf\u306b\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u3053\u3068\u3067\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u79d8\u5bc6\u306e\u30a8\u30ea\u30a2\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30de\u30c3\u30d7\u306e\u9685\u3005\u307e\u3067\u5fb9\u5e95\u7684\u306b\u63a2\u7d22\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u7279\u5b9a\u306e\u6728\u3084\u5ca9\u306a\u3069\u3001\u73cd\u3057\u3044\u7269\u4f53\u306e\u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3\u3092\u8a66\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u30d5\u30a9\u30fc\u30e9\u30e0\u3092\u4f7f\u7528\u3057\u3066\u30d2\u30f3\u30c8\u3092\u5171\u6709\u3057\u3001\u767a\u898b\u3057\u307e\u3059\u3002\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u306f\u3001\u3053\u308c\u3089\u306e\u96a0\u3055\u308c\u305f\u5b9d\u77f3\u3092\u767a\u898b\u3059\u308b\u305f\u3081\u306e\u624b\u9806\u3092\u30ca\u30d3\u30b2\u30fc\u30c8\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u8fb2\u5834\u30d5\u30a1\u30df\u30ea\u30fc\u3067\u3001\u751f\u7523\u6027\u3092\u6700\u5927\u5316\u3059\u308b\u305f\u3081\u306b\u3001\u8fb2\u5834\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u8fb2\u5834\u30d5\u30a1\u30df\u30ea\u30fc\u3067\u8fb2\u5834\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u6226\u7565\u7684\u306a\u8a08\u753b\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u8fb2\u5834\u3092\u4f5c\u7269\u3001\u5bb6\u755c\u3001\u8caf\u8535\u306e\u305f\u3081\u306e\u30be\u30fc\u30f3\u306b\u5206\u3051\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b0\u30ea\u30c3\u30c9\u30b7\u30b9\u30c6\u30e0\u3092\u4f7f\u7528\u3057\u3066\u30b9\u30da\u30fc\u30b9\u3092\u52b9\u7387\u7684\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7d0d\u5c4b\u3084\u5e02\u5834\u306a\u3069\u306e\u983b\u7e41\u306b\u4f7f\u7528\u3055\u308c\u308b\u65bd\u8a2d\u3092\u3001\u30a2\u30af\u30bb\u30b9\u3057\u3084\u3059\u3044\u4e2d\u592e\u4ed8\u8fd1\u306b\u914d\u7f6e\u3057\u307e\u3059\u3002\u6bd4\u8f03\u8868\u306f\u3001\u751f\u7523\u6027\u3068\u5229\u4fbf\u6027\u306e\u89b3\u70b9\u304b\u3089\u3001\u3055\u307e\u3056\u307e\u306a\u30ec\u30a4\u30a2\u30a6\u30c8\u306e\u9078\u629e\u80a2\u3092\u8a55\u4fa1\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}]
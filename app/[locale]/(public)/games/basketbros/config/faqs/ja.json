[{"question": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30d6\u30ed\u30b9\u521d\u5fc3\u8005\u306b\u3068\u3063\u3066\u3001\u57fa\u672c\u30c0\u30f3\u30af\u3092\u52b9\u679c\u7684\u306b\u5b9f\u884c\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30d6\u30ed\u30b9\u3067\u57fa\u672c\u30c0\u30f3\u30af\u3092\u884c\u3046\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71 - \u30d0\u30b9\u30b1\u30c3\u30c8\u306e\u8fd1\u304f\u306b\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u914d\u7f6e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - \u30b8\u30e3\u30f3\u30d7\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u7d9a\u3051\u3001\u30b8\u30e3\u30f3\u30d7\u3092\u30c1\u30e3\u30fc\u30b8\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u30b8\u30e3\u30f3\u30d7\u306e\u9802\u70b9\u3067\u30dc\u30bf\u30f3\u3092\u96e2\u3057\u3066\u30c0\u30f3\u30af\u3092\u5b9f\u884c\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ea\u30f3\u30b0\u306e\u8fd1\u304f\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u300cDunkMaster\u300d\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u6210\u529f\u7387\u304c\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u30ea\u30a2\u30eb\u30d0\u30b9\u30b1\u30c3\u30c8\u306e\u5b8c\u74a7\u306a\u30b8\u30e3\u30f3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u60f3\u50cf\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30d6\u30ed\u30b9\u3067\u30b9\u30da\u30b7\u30e3\u30eb\u30e0\u30fc\u30d6\u3092\u5b9f\u884c\u3059\u308b\u305f\u3081\u306b\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30d6\u30ed\u30b9\u3067\u306f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u3067\u3059\u3002\u3053\u308c\u306f\u3001\u30b9\u30da\u30b7\u30e3\u30eb\u30e0\u30fc\u30d6\u306e\u6210\u529f\u7387\u3068\u52b9\u679c\u3092\u6c7a\u3081\u308b\u304b\u3089\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30b9\u30fc\u30d1\u30fc\u30b7\u30e5\u30fc\u30c8\u300d\u30e0\u30fc\u30d6\u306f\u3001\u30c0\u30e1\u30fc\u30b8\u3068\u76f8\u624b\u3092\u30b9\u30bf\u30f3\u3055\u305b\u308b\u52b9\u679c\u3092\u6700\u5927\u9650\u306b\u9ad8\u3081\u308b\u305f\u3081\u306b\u7cbe\u5bc6\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71 - \u76f8\u624b\u304c\u30d0\u30e9\u30f3\u30b9\u3092\u5d29\u308c\u3066\u3044\u308b\u306e\u3092\u5f85\u3061\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - \u5f7c\u3089\u304c\u56de\u5fa9\u3057\u3088\u3046\u3068\u3057\u3066\u3044\u308b\u3068\u304d\u306b\u30e0\u30fc\u30d6\u3092\u30a2\u30af\u30c6\u30a3\u30d6\u306b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u30b9\u30bf\u30f3\u306e\u6a5f\u4f1a\u3092\u9003\u3055\u306a\u3044\u3088\u3046\u306b\u3001\u7d20\u65e9\u3044\u653b\u6483\u3092\u7d9a\u3051\u307e\u3059\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u901a\u5e38\u306e\u30e0\u30fc\u30d6\u3068\u7570\u306a\u308a\u3001\u30b9\u30da\u30b7\u30e3\u30eb\u30e0\u30fc\u30d6\u306b\u306f\u30af\u30fc\u30eb\u30c0\u30a6\u30f3\u304c\u3042\u308a\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u3055\u3089\u306b\u91cd\u8981\u306b\u306a\u308a\u307e\u3059\u3002]"}, {"question": "\u3059\u3079\u3066\u306e\u65b0\u3057\u3044\u30d0\u30b9\u30b1\u30c3\u30c8\u30d6\u30ed\u30b9\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u7fd2\u5f97\u3059\u3079\u304d\u5fc5\u9808\u306e\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u79fb\u52d5\u3001\u30b8\u30e3\u30f3\u30d7\u3001\u30b7\u30e5\u30fc\u30c8\u3068\u3044\u3046\u5fc5\u9808\u306e\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3092\u7fd2\u5f97\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u65b9\u5411\u30d1\u30c3\u30c9\u3092\u4f7f\u3063\u3066\u79fb\u52d5\u3057\u3001\u300cA\u300d\u30dc\u30bf\u30f3\u3067\u30b8\u30e3\u30f3\u30d7\u3001\u300cB\u300d\u30dc\u30bf\u30f3\u3067\u30b7\u30e5\u30fc\u30c8\u3057\u307e\u3059\u3002\u300c\u30eb\u30fc\u30ad\u30fc\u300d\u3068\u3044\u3046\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u4f7f\u3063\u3066\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u30e2\u30fc\u30c9\u3067\u3053\u308c\u3089\u306e\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3092\u7df4\u7fd2\u3059\u308b\u3068\u3001\u7b4b\u8089\u306e\u8a18\u61b6\u304c\u5f37\u5316\u3055\u308c\u307e\u3059\u3002[\u8a2d\u5b9a\u5bfe\u7167\u8868\uff1a\u79fb\u52d5 - \u65b9\u5411\u30d1\u30c3\u30c9\u3001\u30b8\u30e3\u30f3\u30d7 - A\u3001\u30b7\u30e5\u30fc\u30c8 - B\u3002]"}, {"question": "\u7d4c\u9a13\u8c4a\u5bcc\u306a\u30d0\u30b9\u30b1\u30c3\u30c8\u30d6\u30ed\u30b9\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u8a66\u5408\u3092\u652f\u914d\u3059\u308b\u305f\u3081\u306b\u4f7f\u3048\u308b\u9ad8\u5ea6\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u7d4c\u9a13\u8c4a\u5bcc\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u3053\u308c\u3089\u306e\u6226\u7565\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u3067\u8a66\u5408\u3092\u652f\u914d\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71 - \u76f8\u624b\u306e\u52d5\u304d\u3092\u8aad\u3093\u3067\u3001\u884c\u52d5\u3092\u4e88\u6e2c\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - \u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u56fa\u6709\u306e\u80fd\u529b\u3092\u4f7f\u7528\u3057\u3066\u3001\u30e6\u30cb\u30fc\u30af\u306a\u30b3\u30f3\u30dc\u3092\u4f5c\u6210\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u30b9\u30bf\u30df\u30ca\u3092\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3057\u3066\u3001\u610f\u8868\u3092\u7a81\u304b\u308c\u306a\u3044\u3088\u3046\u306b\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30b7\u30e3\u30c9\u30a6\u30b9\u30c8\u30e9\u30a4\u30ab\u30fc\u300d\u306e\u30c6\u30ec\u30dd\u30fc\u30c8\u80fd\u529b\u3092\u4f7f\u7528\u3057\u3066\u3001\u5bfe\u6226\u76f8\u624b\u3092\u51fa\u3057\u629c\u304f\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u76f8\u624b\u306e\u52d5\u304d\u2192\u4e88\u6e2c\u2192\u80fd\u529b\u3092\u4f7f\u3063\u305f\u53cd\u6483\u2192\u30b3\u30f3\u30dc\u3002]"}, {"question": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30d6\u30ed\u30b9\u306b\u304a\u3051\u308b\u30b9\u30bf\u30df\u30ca\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30d6\u30ed\u30b9\u306b\u304a\u3051\u308b\u30b9\u30bf\u30df\u30ca\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u884c\u3048\u308b\u9023\u7d9a\u3057\u305f\u30a2\u30af\u30b7\u30e7\u30f3\u6570\u3092\u5236\u9650\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u5927\u304d\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30d1\u30ef\u30fc\u30d7\u30ec\u30a4\u30e4\u30fc\u300d\u306f\u3001\u56de\u5fa9\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u524d\u306b3\u56de\u306e\u9023\u7d9a\u300c\u30d1\u30ef\u30fc\u30b9\u30e9\u30e0\u300d\u3057\u304b\u5b9f\u884c\u3067\u304d\u307e\u305b\u3093\u3002\u30b9\u30c6\u30c3\u30d71 - \u6fc0\u3057\u3044\u8a66\u5408\u4e2d\u306b\u30b9\u30bf\u30df\u30ca\u30b2\u30fc\u30b8\u3092\u76e3\u8996\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - \u30b9\u30bf\u30df\u30ca\u6d88\u8cbb\u304c\u5c11\u306a\u3044\u30e0\u30fc\u30d6\u3092\u4f7f\u7528\u3057\u3066\u30d7\u30ec\u30c3\u30b7\u30e3\u30fc\u3092\u304b\u3051\u7d9a\u3051\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u30b9\u30bf\u30df\u30ca\u3092\u56de\u5fa9\u3059\u308b\u305f\u3081\u306b\u3001\u77ed\u3044\u4f11\u61a9\u3092\u53d6\u308a\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u30b9\u30bf\u30df\u30ca\u306f\u4f7f\u7528\u3068\u3068\u3082\u306b\u6d88\u8cbb\u3055\u308c\u3001\u5145\u96fb\u304c\u5fc5\u8981\u306a\u30d0\u30c3\u30c6\u30ea\u30fc\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002]"}, {"question": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30d6\u30ed\u30b9\u3067\u7d20\u65e9\u3044\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u3069\u3046\u30ab\u30a6\u30f3\u30bf\u30fc\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u7d20\u65e9\u3044\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u30ab\u30a6\u30f3\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71 - \u300c\u30ac\u30fc\u30c7\u30a3\u30a2\u30f3\u300d\u306e\u3088\u3046\u306a\u5f37\u529b\u306a\u9632\u5fa1\u80fd\u529b\u3092\u6301\u3064\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u9078\u3073\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - \u79fb\u52d5\u306e\u9078\u629e\u80a2\u3092\u5236\u9650\u3059\u308b\u3088\u3046\u306b\u4f4d\u7f6e\u3092\u53d6\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u6575\u3092\u610f\u8868\u3092\u7a81\u304f\u305f\u3081\u306b\u3001\u7bc4\u56f2\u653b\u6483\u306e\u30e0\u30fc\u30d6\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30ac\u30fc\u30c7\u30a3\u30a2\u30f3\u300d\u306e\u300c\u30b7\u30fc\u30eb\u30c9\u30d6\u30c3\u30b7\u30e5\u300d\u3067\u3001\u5f7c\u3089\u306e\u30b9\u30d4\u30fc\u30c9\u30d9\u30fc\u30b9\u306e\u653b\u6483\u3092\u4e2d\u65ad\u3067\u304d\u307e\u3059\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u9632\u5fa1\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u5bfe\u7d20\u65e9\u3044\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3001\u5f37\u307f\u3068\u5f31\u307f\u3092\u5f37\u8abf\u3002]"}, {"question": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30d6\u30ed\u30b9\u306b\u304a\u3051\u308b\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u30e0\u30fc\u30d6\u306b\u5bfe\u3057\u3066\u3069\u306e\u3088\u3046\u306b\u30dd\u30a4\u30f3\u30c8\u3092\u8a08\u7b97\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30d6\u30ed\u30b9\u306b\u304a\u3051\u308b\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30e0\u30fc\u30d6\u306e\u8907\u96d1\u3055\u3068\u52b9\u679c\u306b\u57fa\u3065\u3044\u3066\u30dd\u30a4\u30f3\u30c8\u3092\u8a08\u7b97\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u57fa\u672c\u30c0\u30f3\u30af\u306f2\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u307e\u3059\u304c\u3001\u300c\u30b9\u30fc\u30d1\u30fc\u30b7\u30e5\u30fc\u30c8\u300d\u306f5\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71 - \u4e00\u8cab\u3057\u305f\u5f97\u70b9\u306e\u305f\u3081\u306b\u3001\u3088\u308a\u5358\u7d14\u306a\u30e0\u30fc\u30d6\u3092\u5b9f\u884c\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - \u3088\u308a\u9ad8\u3044\u30dd\u30a4\u30f3\u30c8\u306e\u305f\u3081\u306b\u3001\u91cd\u8981\u306a\u77ac\u9593\u306b\u30b9\u30da\u30b7\u30e3\u30eb\u30e0\u30fc\u30d6\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u30e0\u30fc\u30d6\u3092\u7d44\u307f\u5408\u308f\u305b\u3066\u3001\u30dc\u30fc\u30ca\u30b9\u500d\u7387\u3092\u7372\u5f97\u3057\u307e\u3059\u3002[\u8a2d\u5b9a\u5bfe\u7167\u8868\uff1a\u57fa\u672c\u30c0\u30f3\u30af - 2\u30dd\u30a4\u30f3\u30c8\u3001\u30b9\u30fc\u30d1\u30fc\u30b7\u30e5\u30fc\u30c8 - 5\u30dd\u30a4\u30f3\u30c8\u3001\u30b3\u30f3\u30dc - \u30e0\u30fc\u30d6\u3054\u3068+1\u30dd\u30a4\u30f3\u30c8\u3002]"}, {"question": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30d6\u30ed\u30b9\u306e\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u4e3b\u306a\u9055\u3044\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\u3002\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306fAI\u30c1\u30e3\u30ec\u30f3\u30b8\u3068\u30b9\u30c8\u30fc\u30ea\u30fc\u9032\u884c\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u304c\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u306e\u7af6\u4e89\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3067\u306f\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u3053\u3068\u3067\u65b0\u3057\u3044\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u304c\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306e\u5831\u916c\u306f\u8a66\u5408\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc - AI\u3001\u30b9\u30c8\u30fc\u30ea\u30fc\u3001\u30a2\u30f3\u30ed\u30c3\u30af; \u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc - \u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u3001\u7af6\u4e89\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3002]"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u30d0\u30b9\u30b1\u30c3\u30c8\u30d6\u30ed\u30b9\u306e\u9032\u884c\u72b6\u6cc1\u3092\u3069\u306e\u3088\u3046\u306b\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71 - \u4e21\u65b9\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - \u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u3001\u73fe\u5728\u306e\u9032\u884c\u72b6\u6cc1\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u65b0\u3057\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u4fdd\u5b58\u30d5\u30a1\u30a4\u30eb\u3092\u8aad\u307f\u8fbc\u307f\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001PC\u304b\u3089\u30e2\u30d0\u30a4\u30eb\u306b\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3092\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ea\u30f3\u30af\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u643a\u5e2f\u96fb\u8a71\u306e\u9023\u7d61\u5148\u3092\u540c\u671f\u3059\u308b\u306e\u3068\u540c\u3058\u3067\u3059\u3002]"}, {"question": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30d6\u30ed\u30b9\u306b\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u767a\u6398\u3067\u304d\u308b\u96a0\u3057\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30b2\u30fc\u30e0\u5185\u306e\u7279\u5b9a\u306e\u5834\u6240\u306b\u63a2\u691c\u3059\u308b\u3053\u3068\u3067\u3001\u96a0\u3057\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30e1\u30a4\u30f3\u30e1\u30cb\u30e5\u30fc\u3067\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30923\u56de\u30bf\u30c3\u30d7\u3059\u308b\u3068\u3001\u79d8\u533f\u30ad\u30e3\u30e9\u30af\u30bf\u300cEasterEgg\u30de\u30b9\u30bf\u30fc\u300d\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002[\u5f69\u86cb\u767a\u898b\uff1a\u3053\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306f\u3001\u901a\u5e38\u306e\u30ed\u30b9\u30bf\u30fc\u306b\u306f\u306a\u3044\u30e6\u30cb\u30fc\u30af\u306a\u80fd\u529b\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002]"}]
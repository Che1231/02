[{"question": "BasketBros \ucd08\ubcf4\uc790\uac00 \uae30\ubcf8 \ub369\ud06c\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc218\ud589\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "BasketBros\uc5d0\uc11c \uae30\ubcf8 \ub369\ud06c\ub97c \uc218\ud589\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. STEP1 - \ubc14\uc2a4\ucf13 \uadfc\ucc98\uc5d0 \ud50c\ub808\uc774\uc5b4\ub97c \ubc30\uce58\ud569\ub2c8\ub2e4. STEP2 - \uc810\ud504 \ubc84\ud2bc\uc744 \ub204\ub974\uace0 \uc810\ud504\ub97c \ucda9\uc804\ud569\ub2c8\ub2e4. STEP3 - \uc810\ud504 \ucd5c\uace0\uc810\uc5d0\uc11c \ubc84\ud2bc\uc744 \ub193\uc544 \ub369\ud06c\ub97c \uc2e4\ud589\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud638\ud551 \uadfc\ucc98\uc5d0 \uc788\ub294 'DunkMaster' \uce90\ub9ad\ud130\ub97c \uc0ac\uc6a9\ud558\uba74 \uc131\uacf5\ub960\uc774 \ub192\uc544\uc9d1\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc2e4\uc81c \ub18d\uad6c\uc5d0\uc11c \uc644\ubcbd\ud55c \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \ub9de\ucd94\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "BasketBros\uc5d0\uc11c \ud2b9\uc218 \ub3d9\uc791\uc744 \uc2e4\ud589\ud558\ub294 \ub370 \ud0c0\uc774\ubc0d\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "BasketBros\uc5d0\uc11c \ud0c0\uc774\ubc0d\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ud2b9\uc218 \ub3d9\uc791\uc758 \uc131\uacf5\ub960\uacfc \ud6a8\uacfc\ub97c \uacb0\uc815\ud558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc288\ud37c \uc2ac\ub7a8' \ub3d9\uc791\uc744 \uc218\ud589\ud558\ub824\uba74 \uc0c1\ub300\ubc29\uc744 \ucd5c\ub300\ud55c \ub109\ub2e4\uc6b4\uc2dc\ud0a4\uace0 \uae30\uc808\uc2dc\ud0a4\ub294 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1 - \uc0c1\ub300\ubc29\uc774 \uade0\ud615\uc744 \uc783\ub3c4\ub85d \uae30\ub2e4\ub9bd\ub2c8\ub2e4. STEP2 - \ud68c\ubcf5\ud558\ub824\ub294 \ucc30\ub098\uc5d0 \ub3d9\uc791\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4. STEP3 - \uae30\uc808 \uc0c1\ud0dc\ub97c \uc774\uc6a9\ud558\uc5ec \ube60\ub978 \uacf5\uaca9\uc73c\ub85c \uc774\uc5b4\ub098\uac11\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\ubc95 \ube44\uad50: \uc77c\ubc18 \ub3d9\uc791\uacfc \ub2ec\ub9ac \ud2b9\uc218 \ub3d9\uc791\uc740 \uc7ac\uc0ac\uc6a9 \ub300\uae30 \uc2dc\uac04\uc774 \uc788\uc5b4 \ud0c0\uc774\ubc0d\uc774 \ub354\uc6b1 \uc911\uc694\ud569\ub2c8\ub2e4.]"}, {"question": "\ubaa8\ub4e0 BasketBros \uc2e0\uaddc \ud50c\ub808\uc774\uc5b4\uac00 \uc219\ub2ec\ud574\uc57c \ud558\ub294 \ud544\uc218 \ucee8\ud2b8\ub864\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc2e0\uaddc \ud50c\ub808\uc774\uc5b4\ub294 \uc774\ub3d9, \uc810\ud504 \ubc0f \uc29b \ub4f1\uc758 \ud544\uc218 \ucee8\ud2b8\ub864\uc744 \uc219\ub2ec\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubc29\ud5a5 \ud328\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc774\ub3d9\ud558\uace0, 'A' \ubc84\ud2bc\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc810\ud504\ud558\uace0, 'B' \ubc84\ud2bc\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc29b\ud569\ub2c8\ub2e4. 'Rookie' \uce90\ub9ad\ud130\ub85c \uc5f0\uc2b5 \ubaa8\ub4dc\uc5d0\uc11c \uc774\ub7ec\ud55c \ucee8\ud2b8\ub864\uc744 \uc5f0\uc2b5\ud558\uba74 \uadfc\uc721 \uae30\uc5b5\ub825\uc774 \ud5a5\uc0c1\ub429\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \uc774\ub3d9 - \ubc29\ud5a5 \ud328\ub4dc, \uc810\ud504 - A, \uc29b - B.]"}, {"question": "\uacbd\ud5d8\uc774 \ud48d\ubd80\ud55c BasketBros \ud50c\ub808\uc774\uc5b4\uac00 \uacbd\uae30\uc5d0 \uc2b9\ub9ac\ud560 \uc218 \uc788\ub3c4\ub85d \ub3c4\uc640\uc8fc\ub294 \uace0\uae09 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uacbd\ud5d8\uc774 \ud48d\ubd80\ud55c \ud50c\ub808\uc774\uc5b4\ub294 \ub2e4\uc74c \uc804\ub7b5\uc744 \uc219\ub2ec\ud558\uc5ec \uacbd\uae30\uc5d0 \uc2b9\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1 - \uc0c1\ub300\ubc29\uc758 \ub3d9\uc791\uc744 \ud30c\uc545\ud558\uace0 \ud589\ub3d9\uc744 \uc608\uce21\ud569\ub2c8\ub2e4. STEP2 - \uce90\ub9ad\ud130 \uace0\uc720\uc758 \ub2a5\ub825\uc744 \ud65c\uc6a9\ud558\uc5ec \ub3c5\ud2b9\ud55c \uc5f0\uacc4 \uacf5\uaca9\uc744 \ub9cc\ub4ed\ub2c8\ub2e4. STEP3 - \uac11\uc791\uc2a4\ub7ec\uc6b4 \uc0c1\ud669\uc5d0 \ub300\ube44\ud558\uae30 \uc704\ud574 \uccb4\ub825\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'ShadowStriker'\uc758 \uc21c\uac04 \uc774\ub3d9 \ub2a5\ub825\uc740 \uc0c1\ub300\ubc29\uc744 \uc81c\uc555\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc0c1\ub300\ubc29\uc758 \ub3d9\uc791 -> \uc608\uce21 -> \ub2a5\ub825\uc73c\ub85c \uc0c1\ub300 \uacf5\uaca9 -> \uc5f0\uacc4 \uacf5\uaca9.]"}, {"question": "BasketBros\uc758 \uccb4\ub825 \uc2dc\uc2a4\ud15c\uc740 \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uc758 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "BasketBros\uc758 \uccb4\ub825 \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc5f0\uc18d\uc801\uc73c\ub85c \uc218\ud589\ud560 \uc218 \uc788\ub294 \ub3d9\uc791\uc758 \uc218\ub97c \uc81c\ud55c\ud558\uc5ec \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc0c1\ub2f9\ud55c \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'PowerPlayer'\ub294 \ud68c\ubcf5\ud558\uae30 \uc804\uae4c\uc9c0 \uc5f0\uc18d 3\ubc88\uc758 'PowerSlams'\ub9cc \uc218\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1 - \uaca9\ub82c\ud55c \uacbd\uae30 \uc911 \uccb4\ub825 \uac8c\uc774\uc9c0\ub97c \uacc4\uc18d \ud655\uc778\ud569\ub2c8\ub2e4. STEP2 - \uccb4\ub825 \uc18c\ubaa8\uac00 \uc801\uc740 \ub3d9\uc791\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc555\ubc15\uc744 \uc720\uc9c0\ud569\ub2c8\ub2e4. STEP3 - \uccb4\ub825\uc744 \ud68c\ubcf5\ud558\uae30 \uc704\ud574 \uc7a0\uc2dc \ud734\uc2dd\uc744 \ucde8\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uccb4\ub825\uc740 \uc0ac\uc6a9\ud558\uba74 \uc18c\ubaa8\ub418\uace0 \uc7ac\ucda9\uc804\uc774 \ud544\uc694\ud55c \ubc30\ud130\ub9ac\uc640 \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "BasketBros\uc5d0\uc11c \ube60\ub978 \uce90\ub9ad\ud130\ub97c \uc5b4\ub5bb\uac8c \uc0c1\ub300\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ube60\ub978 \uce90\ub9ad\ud130\ub97c \uc0c1\ub300\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. STEP1 - 'Guardian'\uacfc \uac19\uc774 \uac15\ub825\ud55c \ubc29\uc5b4 \ub2a5\ub825\uc744 \uac00\uc9c4 \uce90\ub9ad\ud130\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. STEP2 - \uadf8\ub4e4\uc758 \uc774\ub3d9 \uc635\uc158\uc744 \uc81c\ud55c\ud560 \uc218 \uc788\ub3c4\ub85d \uc704\uce58\ub97c \uc7a1\uc2b5\ub2c8\ub2e4. STEP3 - \uc9c0\uc5ed \ud6a8\uacfc \ub3d9\uc791\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc0c1\ub300\ub97c \ud63c\ub780\uc2a4\ub7fd\uac8c \ub9cc\ub4ed\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'Guardian'\uc758 '\ubc29\ud328 \uac15\ud0c0'\ub294 \uadf8\ub4e4\uc758 \uc18d\ub3c4 \uae30\ubc18 \uacf5\uaca9\uc744 \ubc29\ud574\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\ubc95 \ube44\uad50: \ubc29\uc5b4\uc801\uc778 \uce90\ub9ad\ud130 \ub300 \ube60\ub978 \uce90\ub9ad\ud130, \uac15\uc810\uacfc \uc57d\uc810 \uac15\uc870.]"}, {"question": "BasketBros\uc758 \ub4dd\uc810 \uc2dc\uc2a4\ud15c\uc740 \uc11c\ub85c \ub2e4\ub978 \ub3d9\uc791\uc5d0 \ub300\ud55c \uc810\uc218\ub97c \uc5b4\ub5bb\uac8c \uacc4\uc0b0\ud569\ub2c8\uae4c?", "answer": "BasketBros\uc758 \ub4dd\uc810 \uc2dc\uc2a4\ud15c\uc740 \ub3d9\uc791\uc758 \ubcf5\uc7a1\uc131\uacfc \ud6a8\uacfc\uc131\uc744 \uae30\ubc18\uc73c\ub85c \uc810\uc218\ub97c \uacc4\uc0b0\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uae30\ubcf8 \ub369\ud06c\ub294 2\uc810\uc744 \uc5bb\uace0, '\uc288\ud37c \uc2ac\ub7a8'\uc740 5\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1 - \uc77c\uad00\ub41c \ub4dd\uc810\uc744 \uc704\ud574 \ub2e8\uc21c\ud55c \ub3d9\uc791\uc744 \uc218\ud589\ud569\ub2c8\ub2e4. STEP2 - \uc911\uc694\ud55c \uc21c\uac04\uc5d0 \ud2b9\uc218 \ub3d9\uc791\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub354 \ub9ce\uc740 \uc810\uc218\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. STEP3 - \ub3d9\uc791\uc744 \uacb0\ud569\ud558\uc5ec \ubcf4\ub108\uc2a4 \uacf1\uc148 \ud6a8\uacfc\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \uae30\ubcf8 \ub369\ud06c - 2\uc810, \uc288\ud37c \uc2ac\ub7a8 - 5\uc810, \uc5f0\uacc4 \uacf5\uaca9 - \ub3d9\uc791\ub2f9 1\uc810 \ucd94\uac00.]"}, {"question": "BasketBros\uc758 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc8fc\uc694 \ucc28\uc774\uc810\uc740 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4\ub294 AI \ucc4c\ub9b0\uc9c0\uc640 \uc2a4\ud1a0\ub9ac \uc9c4\ud589\uc5d0 \ucd08\uc810\uc744 \ub9de\ucd94\uace0, \uba40\ud2f0 \ud50c\ub808\uc774\uc5b4\ub294 \uc2e4\uc2dc\uac04 \uacbd\uc7c1\uc5d0 \ucd08\uc810\uc744 \ub9de\ucda5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4\uc5d0\uc11c\ub294 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uc5ec \uc0c8\ub85c\uc6b4 \uce90\ub9ad\ud130\ub97c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc9c0\ub9cc, \uba40\ud2f0 \ud50c\ub808\uc774\uc5b4\uc5d0\uc11c\ub294 \uacbd\uae30 \uc131\uc801\uc5d0 \ub530\ub77c \ubcf4\uc0c1\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\ubc95 \ube44\uad50: \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 - AI, \uc2a4\ud1a0\ub9ac, \uc7a0\uae08 \ud574\uc81c; \uba40\ud2f0 \ud50c\ub808\uc774\uc5b4 - \uc2e4\uc2dc\uac04, \uacbd\uc7c1, \uc131\uc801.]"}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \ub2e4\ub978 \ud50c\ub7ab\ud3fc \uac04\uc5d0 BasketBros\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. STEP1 - \ub450 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. STEP2 - \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud604\uc7ac \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5c5\ub85c\ub4dc\ud569\ub2c8\ub2e4. STEP3 - \uc0c8 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc800\uc7a5 \ud30c\uc77c\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ubaa8\ubc14\uc77c\ub85c \uc774\uc804\ud558\ub824\uba74 \ub450 \uae30\uae30\ub97c \ub3d9\uc77c\ud55c \uacc4\uc815\uacfc \uc5f0\uacb0\ud574\uc57c \ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc5ec\ub7ec \uae30\uae30\uc5d0\uc11c \ud734\ub300\uc804\ud654 \uc5f0\ub77d\ucc98\ub97c \ub3d9\uae30\ud654\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "BasketBros\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud50c\ub808\uc774\uc5b4\ub294 \uac8c\uc784 \ub0b4 \ud2b9\uc815 \uc704\uce58\ub97c \ud0d0\ud5d8\ud558\uc5ec \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uba54\uc778 \uba54\ub274\uc5d0\uc11c \ub18d\uad6c\uacf5\uc744 \uc138 \ubc88 \ub204\ub974\uba74 \ube44\ubc00 \uce90\ub9ad\ud130 'EasterEggMaster'\uac00 \uc7a0\uae08 \ud574\uc81c\ub429\ub2c8\ub2e4. [\uc774\uc2a4\ud130 \uc5d0\uadf8 \ud0d0\ud5d8: \uc774 \uce90\ub9ad\ud130\ub294 \uc77c\ubc18 \ub85c\uc2a4\ud130\uc5d0 \uc5c6\ub294 \uace0\uc720\ud55c \ub2a5\ub825\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4.]"}]
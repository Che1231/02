[{"question": "BasketBros\u65b0\u624b\u5982\u4f55\u6709\u6548\u5730\u5b8c\u6210\u57fa\u672c\u6263\u7bee\uff1f", "answer": "\u5728BasketBros\u4e2d\u5b8c\u6210\u57fa\u672c\u6263\u7bee\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 \u2013 \u5c06\u4f60\u7684\u7403\u5458\u9760\u8fd1\u7bee\u7b50\u3002\u6b65\u9aa42 \u2013 \u6309\u4f4f\u8df3\u8dc3\u6309\u94ae\u6765\u84c4\u529b\u8df3\u8dc3\u3002\u6b65\u9aa43 \u2013 \u5728\u8df3\u8dc3\u8fbe\u5230\u6700\u9ad8\u70b9\u65f6\u91ca\u653e\u6309\u94ae\u6765\u5b8c\u6210\u6263\u7bee\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u89d2\u8272\"\u6263\u7bee\u5927\u5e08\"\u9760\u8fd1\u7bee\u7b50\u5c06\u63d0\u9ad8\u6210\u529f\u7387\u3002[\u6bd4\u55bb\u8bf4\u660e: \u60f3\u8c61\u4e00\u4e0b\uff0c\u5c31\u50cf\u5728\u771f\u6b63\u7684\u7bee\u7403\u6bd4\u8d5b\u4e2d\u8c03\u6574\u5b8c\u7f8e\u8df3\u8dc3\u4e00\u6837\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48BasketBros\u4e2d\u6267\u884c\u7279\u6b8a\u52a8\u4f5c\u9700\u8981\u7cbe\u51c6\u7684\u65f6\u673a\uff1f", "answer": "\u5728BasketBros\u4e2d\uff0c\u65f6\u673a\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u51b3\u5b9a\u4e86\u7279\u6b8a\u52a8\u4f5c\u7684\u6210\u529f\u7387\u548c\u6709\u6548\u6027\u3002\u4f8b\u5982\uff0c\"\u8d85\u7ea7\u6263\u7bee\"\u52a8\u4f5c\u9700\u8981\u7cbe\u786e\u7684\u65f6\u673a\u624d\u80fd\u6700\u5927\u9650\u5ea6\u5730\u9020\u6210\u4f24\u5bb3\u5e76\u51fb\u6655\u5bf9\u624b\u3002\u6b65\u9aa41 \u2013 \u7b49\u5bf9\u624b\u5931\u53bb\u5e73\u8861\u3002\u6b65\u9aa42 \u2013 \u5728\u5bf9\u624b\u5373\u5c06\u6062\u590d\u5e73\u8861\u65f6\u6fc0\u6d3b\u8be5\u52a8\u4f5c\u3002\u6b65\u9aa43 \u2013 \u7d27\u8ddf\u7740\u5feb\u901f\u653b\u51fb\uff0c\u5229\u7528\u51fb\u6655\u6548\u679c\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u4e0e\u666e\u901a\u52a8\u4f5c\u4e0d\u540c\uff0c\u7279\u6b8a\u52a8\u4f5c\u6709\u51b7\u5374\u65f6\u95f4\uff0c\u8fd9\u4f7f\u5f97\u65f6\u673a\u53d8\u5f97\u66f4\u52a0\u5173\u952e\u3002]"}, {"question": "\u6bcf\u4e2a\u65b0BasketBros\u73a9\u5bb6\u90fd\u5e94\u8be5\u638c\u63e1\u54ea\u4e9b\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u65b0\u73a9\u5bb6\u5e94\u8be5\u638c\u63e1\u4ee5\u4e0b\u57fa\u672c\u63a7\u5236\uff1a\u79fb\u52a8\u3001\u8df3\u8dc3\u548c\u6295\u7bee\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u65b9\u5411\u952e\u79fb\u52a8\uff0c\"A\"\u952e\u8df3\u8dc3\uff0c\"B\"\u952e\u6295\u7bee\u3002\u5728\u8bad\u7ec3\u6a21\u5f0f\u4e0b\u4f7f\u7528\u89d2\u8272\"\u83dc\u9e1f\"\u7ec3\u4e60\u8fd9\u4e9b\u63a7\u5236\uff0c\u5c06\u6709\u52a9\u4e8e\u5efa\u7acb\u808c\u8089\u8bb0\u5fc6\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u79fb\u52a8 \u2013 \u65b9\u5411\u952e\uff0c\u8df3\u8dc3 \u2013 A\u952e\uff0c\u6295\u7bee \u2013 B\u952e\u3002]"}, {"question": "\u54ea\u4e9b\u9ad8\u7ea7\u7b56\u7565\u80fd\u591f\u5e2e\u52a9\u7ecf\u9a8c\u4e30\u5bcc\u7684BasketBros\u73a9\u5bb6\u5728\u6bd4\u8d5b\u4e2d\u5360\u636e\u4f18\u52bf\uff1f", "answer": "\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u638c\u63e1\u4ee5\u4e0b\u7b56\u7565\u6765\u5360\u636e\u4f18\u52bf\uff1a\u6b65\u9aa41 \u2013 \u5b66\u4e60\u9605\u8bfb\u5bf9\u624b\u7684\u52a8\u4f5c\u5e76\u9884\u6d4b\u4ed6\u4eec\u7684\u884c\u52a8\u3002\u6b65\u9aa42 \u2013 \u5229\u7528\u89d2\u8272\u7684\u7279\u5b9a\u80fd\u529b\u521b\u9020\u72ec\u7279\u7684\u8fde\u62db\u3002\u6b65\u9aa43 \u2013 \u5145\u5206\u5229\u7528\u4f60\u7684\u4f53\u529b\uff0c\u907f\u514d\u63aa\u624b\u4e0d\u53ca\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\"\u5f71\u5b50\u7a81\u51fb\u8005\"\u7684\u4f20\u9001\u80fd\u529b\u53ef\u4ee5\u6446\u8131\u5bf9\u624b\u7684\u653b\u51fb\u3002[\u6d41\u7a0b\u56fe\u89e3: \u5bf9\u624b\u52a8\u4f5c -> \u9884\u6d4b -> \u4f7f\u7528\u6280\u80fd\u53cd\u51fb -> \u8fde\u62db\u3002]"}, {"question": "BasketBros\u4e2d\u7684\u4f53\u529b\u7cfb\u7edf\u4f1a\u5982\u4f55\u5f71\u54cd\u9ad8\u7ea7\u73a9\u5bb6\u7684\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "BasketBros\u4e2d\u7684\u4f53\u529b\u7cfb\u7edf\u4f1a\u663e\u8457\u5f71\u54cd\u6e38\u620f\u4f53\u9a8c\uff0c\u56e0\u4e3a\u5b83\u9650\u5236\u4e86\u73a9\u5bb6\u53ef\u4ee5\u8fde\u7eed\u6267\u884c\u7684\u52a8\u4f5c\u6570\u91cf\u3002\u4f8b\u5982\uff0c\"\u529b\u91cf\u578b\u7403\u5458\"\u53ea\u80fd\u5728\u9700\u8981\u6062\u590d\u4f53\u529b\u4e4b\u524d\u8fde\u7eed\u6267\u884c\u4e09\u6b21\"\u529b\u91cf\u6263\u7bee\"\u3002\u6b65\u9aa41 \u2013 \u5728\u7d27\u5f20\u7684\u6bd4\u8d5b\u4e2d\u76d1\u63a7\u4f60\u7684\u4f53\u529b\u6761\u3002\u6b65\u9aa42 \u2013 \u4f7f\u7528\u7701\u4f53\u529b\u7684\u52a8\u4f5c\u4fdd\u6301\u538b\u529b\u3002\u6b65\u9aa43 \u2013 \u4f11\u606f\u7247\u523b\u6765\u6062\u590d\u4f53\u529b\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u4f53\u529b\u60f3\u8c61\u6210\u4e00\u4e2a\u968f\u7740\u4f7f\u7528\u800c\u6d88\u8017\u5e76\u9700\u8981\u91cd\u65b0\u5145\u7535\u7684\u7535\u6c60\u3002]"}, {"question": "\u5728BasketBros\u4e2d\uff0c\u5982\u4f55\u53cd\u5236\u901f\u5ea6\u578b\u89d2\u8272\uff1f", "answer": "\u8981\u53cd\u5236\u901f\u5ea6\u578b\u89d2\u8272\uff0c\u8bf7\u6267\u884c\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 \u2013 \u9009\u62e9\u62e5\u6709\u5f3a\u5927\u9632\u5fa1\u80fd\u529b\u7684\u89d2\u8272\uff0c\u4f8b\u5982\"\u5b88\u62a4\u8005\"\u3002\u6b65\u9aa42 \u2013 \u63a7\u5236\u597d\u4f4d\u7f6e\uff0c\u9650\u5236\u4ed6\u4eec\u7684\u884c\u52a8\u7a7a\u95f4\u3002\u6b65\u9aa43 \u2013 \u4f7f\u7528\u8303\u56f4\u653b\u51fb\u6765\u51fa\u5176\u4e0d\u610f\u5730\u51fb\u4e2d\u4ed6\u4eec\u3002\u4f8b\u5982\uff0c\"\u5b88\u62a4\u8005\"\u7684\"\u76fe\u724c\u51b2\u51fb\"\u53ef\u4ee5\u6253\u65ad\u4ed6\u4eec\u7684\u901f\u5ea6\u578b\u653b\u51fb\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u9632\u5b88\u578b\u89d2\u8272\u4e0e\u901f\u5ea6\u578b\u89d2\u8272\uff0c\u7a81\u51fa\u5404\u81ea\u7684\u4f18\u52bf\u548c\u52a3\u52bf\u3002]"}, {"question": "BasketBros\u7684\u5f97\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8ba1\u7b97\u4e0d\u540c\u52a8\u4f5c\u7684\u5f97\u5206\u7684\uff1f", "answer": "BasketBros\u7684\u5f97\u5206\u7cfb\u7edf\u6839\u636e\u52a8\u4f5c\u7684\u590d\u6742\u6027\u548c\u6709\u6548\u6027\u6765\u8ba1\u7b97\u5f97\u5206\u3002\u4f8b\u5982\uff0c\u57fa\u672c\u6263\u7bee\u5f972\u5206\uff0c\u800c\"\u8d85\u7ea7\u6263\u7bee\"\u53ef\u4ee5\u5f975\u5206\u3002\u6b65\u9aa41 \u2013 \u6267\u884c\u66f4\u7b80\u5355\u7684\u52a8\u4f5c\u4ee5\u83b7\u5f97\u7a33\u5b9a\u5f97\u5206\u3002\u6b65\u9aa42 \u2013 \u5728\u5173\u952e\u65f6\u523b\u4f7f\u7528\u7279\u6b8a\u52a8\u4f5c\u4ee5\u83b7\u5f97\u66f4\u9ad8\u5f97\u5206\u3002\u6b65\u9aa43 \u2013 \u7ed3\u5408\u52a8\u4f5c\u4ee5\u83b7\u5f97\u989d\u5916\u500d\u6570\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u57fa\u672c\u6263\u7bee \u2013 2\u5206\uff0c\u8d85\u7ea7\u6263\u7bee \u2013 5\u5206\uff0c\u8fde\u62db \u2013 \u6bcf\u4e2a\u52a8\u4f5c\u52a01\u5206\u3002]"}, {"question": "BasketBros\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u5173\u952e\u5dee\u5f02\u5305\u62ec\uff1a\u5355\u4eba\u6a21\u5f0f\u4e13\u6ce8\u4e8eAI\u6311\u6218\u548c\u5267\u60c5\u63a8\u8fdb\uff0c\u800c\u591a\u4eba\u6a21\u5f0f\u4fa7\u91cd\u4e8e\u5b9e\u65f6\u7ade\u4e89\u3002\u4f8b\u5982\uff0c\u5728\u5355\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f60\u53ef\u4ee5\u901a\u8fc7\u5b8c\u6210\u5173\u5361\u6765\u89e3\u9501\u65b0\u89d2\u8272\uff0c\u800c\u591a\u4eba\u6a21\u5f0f\u7684\u5956\u52b1\u5219\u57fa\u4e8e\u6bd4\u8d5b\u8868\u73b0\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u5355\u4eba\u6a21\u5f0f \u2013 AI\uff0c\u5267\u60c5\uff0c\u89e3\u9501\uff1b\u591a\u4eba\u6a21\u5f0f \u2013 \u5b9e\u65f6\uff0c\u7ade\u4e89\uff0c\u8868\u73b0\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fbBasketBros\u7684\u8fdb\u5ea6\uff1f", "answer": "\u8981\u8f6c\u79fb\u8fdb\u5ea6\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 \u2013 \u786e\u4fdd\u4f60\u5728\u4e24\u4e2a\u5e73\u53f0\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u8d26\u6237\u3002\u6b65\u9aa42 \u2013 \u4f7f\u7528\u4e91\u4fdd\u5b58\u529f\u80fd\u4e0a\u4f20\u5f53\u524d\u8fdb\u5ea6\u3002\u6b65\u9aa43 \u2013 \u5728\u65b0\u5e73\u53f0\u4e0a\u4e0b\u8f7d\u5b58\u6863\u6587\u4ef6\u3002\u4f8b\u5982\uff0c\u4ecePC\u79fb\u690d\u5230\u79fb\u52a8\u8bbe\u5907\u9700\u8981\u5c06\u4e24\u4e2a\u8bbe\u5907\u94fe\u63a5\u5230\u540c\u4e00\u4e2a\u5e10\u6237\u3002[\u6bd4\u55bb\u8bf4\u660e: \u60f3\u8c61\u4e00\u4e0b\uff0c\u5c31\u50cf\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u540c\u6b65\u4f60\u7684\u624b\u673a\u901a\u8baf\u5f55\u4e00\u6837\u3002]"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728BasketBros\u4e2d\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u5f69\u86cb\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u63a2\u7d22\u6e38\u620f\u4e2d\u7684\u7279\u5b9a\u5730\u70b9\u6765\u53d1\u73b0\u9690\u85cf\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u5728\u4e3b\u83dc\u5355\u4e2d\u4e09\u6b21\u70b9\u51fb\u7bee\u7403\u53ef\u4ee5\u89e3\u9501\u4e00\u4e2a\u79d8\u5bc6\u89d2\u8272\uff0c\"\u5f69\u86cb\u5927\u5e08\"\u3002[\u5f69\u86cb\u6316\u6398: \u8fd9\u4e2a\u89d2\u8272\u5177\u6709\u5728\u5e38\u89c4\u9635\u5bb9\u4e2d\u627e\u4e0d\u5230\u7684\u72ec\u7279\u80fd\u529b\u3002]"}]
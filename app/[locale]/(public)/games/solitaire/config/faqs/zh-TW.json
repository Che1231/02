[{"question": "\u7d19\u724c\u904a\u6232\u57fa\u672c\u898f\u5247\uff1a\u5982\u4f55\u6b63\u78ba\u5730\u767c\u724c\uff0c\u4ee5\u53ca\u521d\u5b78\u8005\u61c9\u8a72\u4e86\u89e3\u7684\u4e0d\u540c\u724c\u5806\uff1f", "answer": "\u5728\u7d19\u724c\u904a\u6232\u4e2d\u767c\u724c\u5305\u62ec\u5efa\u7acb\u4e03\u500b\u724c\u5806\u3002\u7b2c\u4e00\u500b\u724c\u5806\u6709\u4e00\u5f35\u724c\uff0c\u7b2c\u4e8c\u500b\u724c\u5806\u6709\u5169\u5f35\u724c\uff0c\u4ee5\u6b64\u985e\u63a8\u3002\u8d77\u521d\uff0c\u6bcf\u500b\u724c\u5806\u53ea\u9732\u51fa\u6700\u4e0a\u9762\u7684\u724c\u3002\u5176\u9918\u7684\u724c\u5f62\u6210\u724c\u5eab\u3002\u76ee\u6a19\u662f\u5c07\u6240\u6709\u724c\u79fb\u5230\u57fa\u790e\u724c\u5806\uff0c\u4e26\u6309\u82b1\u8272\u548c\u5927\u5c0f\u6392\u5e8f\u3002\u60f3\u50cf\u4e00\u4e0b\uff0c\u724c\u5806\u5c31\u50cf\u4f60\u7684\u4e3b\u8981\u986f\u793a\u5340\u3002\u6b65\u9a5f\u4e00\uff1a\u5efa\u7acb7\u500b\u7011\u5e03\u724c\u5806\uff1b\u6b65\u9a5f\u4e8c\uff1a\u7ffb\u958b\u724c\u5806\u7684\u9802\u90e8\u5361\u7247\uff1b\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u724c\u5eab\u9032\u884c\u984d\u5916\u79fb\u52d5\u3002\u4e86\u89e3\u724c\u5806\u4f48\u5c40\u662f\u638c\u63e1\u7d19\u724c\u904a\u6232\u7684\u95dc\u9375\u3002\u9019\u5c31\u50cf\u5728\u6f14\u51fa\u958b\u59cb\u524d\u4f48\u7f6e\u821e\u53f0\u3002"}, {"question": "\u5728\u7d19\u724c\u904a\u6232\u4e2d\uff0c\u70ba\u4ec0\u9ebc\u6709\u4e9b\u52d5\u4f5c\u6bd4\u5176\u4ed6\u52d5\u4f5c\u66f4\u597d\uff0c\u4ee5\u53ca\u5982\u4f55\u6539\u5584\u6211\u4e00\u958b\u59cb\u7684\u7d19\u724c\u904a\u6232\u8a2d\u5b9a\u8a55\u4f30\u4ee5\u627e\u5230\u66f4\u597d\u7684\u89e3\u6c7a\u65b9\u6848\uff1f", "answer": "\u5728\u7d19\u724c\u904a\u6232\u4e2d\uff0c\u8f03\u4f73\u7684\u52d5\u4f5c\u8457\u91cd\u65bc\u5361\u7247\u7684\u53ef\u53ca\u6027\u548c\u57fa\u790e\u5806\u7684\u6f5b\u529b\u3002\u901a\u5e38\uff0c\u63ed\u9732\u4e00\u5f35\u80cc\u9762\u671d\u4e0a\u7684\u5361\u7247\u662f\u4e00\u500b\u597d\u52d5\u4f5c\u3002\u512a\u5148\u8003\u616e\u5728\u724c\u5806\u4e2d\u4ee5\u4e0d\u540c\u984f\u8272\u5efa\u7acb\u9806\u5e8f\u3002\u6539\u9032\u8a55\u4f30\u5305\u62ec\uff1a\u512a\u5148\u8003\u616e\u53ef\u53d6\u5f97\u7684\u5361\u7247\u3001\u6253\u958b\u7a7a\u7684\u5217\u3001\u4e26\u8b58\u5225\u6240\u9700\u7684\u95dc\u9375\u5361\u7247\u3002\u63d0\u65e9\u6253\u958b\u7a7a\u5217\u53ef\u80fd\u6703\u8b93\u60a8\u80fd\u5920\u5c07\u738b\u724c\u548c\u76f8\u95dc\u5361\u7247\u79fb\u5230\u90a3\u4e9b\u7a7a\u4f4d\u3002\u4ed4\u7d30\u9010\u6b65\u8a55\u4f30\u521d\u59cb\u8a2d\u5b9a\uff0c\u5c07\u6709\u52a9\u65bc\u505a\u51fa\u66f4\u597d\u7684\u7b56\u7565\u9078\u64c7\u3002\u5c31\u50cf\u95b1\u8b80\u5075\u63a2\u5c0f\u8aaa\u4e00\u6a23\uff0c\u5f9e\u4e00\u958b\u59cb\u5c31\u8981\u5c0b\u627e\u7dda\u7d22\u3002\u7a7a\u7684\u5217\u63d0\u4f9b\u4e86\u5f88\u5927\u7684\u9748\u6d3b\u6027\uff0c\u5c31\u50cf\u64c1\u6709\u738b\u724c\u3002"}, {"question": "\u300e\u514b\u9686\u8fea\u514b\u300f\u7d19\u724c\u904a\u6232\u7684\u52dd\u7387\u662f\u591a\u5c11\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u6703\u986f\u8457\u5f71\u97ff\u9019\u500b\u6a5f\u7387\uff1f", "answer": "\u6a19\u6e96\u514b\u9686\u8fea\u514b\u7d19\u724c\u904a\u6232\u7684\u9810\u4f30\u52dd\u7387\u7d04\u70ba 43%\uff0c\u4f46\u9019\u6703\u6839\u64da\u60c5\u6cc1\u800c\u6709\u5f88\u5927\u5dee\u7570\u3002\u986f\u8457\u5f71\u97ff\u52dd\u7387\u7684\u56e0\u7d20\u5305\u62ec\uff1a\u521d\u59cb\u724c\u7684\u5206\u914d\uff08\u67d0\u4e9b\u8a2d\u5b9a\u6839\u672c\u7121\u6cd5\u8d0f\u5f97\uff09\uff0c\u73a9\u5bb6\u7684\u6280\u5de7\uff08\u7b56\u7565\u9078\u64c7\u5f71\u97ff\u6210\u529f\u7387\uff09\u4ee5\u53ca\u898f\u5247\u8b8a\u9ad4\uff08\u4f8b\u5982\uff0c\u62bd\u4e00\u5f35\u724c\u8207\u62bd\u4e09\u5f35\u724c\uff09\u3002\u6a5f\u7387\u53d6\u6c7a\u65bc\u724c\u7d44\u3002\u6709\u5229\u7684\u724c\u7d44\u5206\u914d\u6709\u52a9\u65bc\u63d0\u9ad8\u6210\u529f\u7387\u3002\u4e00\u500b\u7c21\u55ae\u7684\u8b8a\u9ad4\u662f\u5141\u8a31\u73a9\u5bb6\u591a\u6b21\u901a\u904e\u724c\u5eab\uff0c\u8b93\u904a\u6232\u66f4\u516c\u5e73\u4e14\u8f15\u9b06\u3002"}, {"question": "\u7d19\u724c\u904a\u6232\u7684\u300c\u5fa9\u539f\u300d\u7b56\u7565\uff1a\u73a9\u5bb6\u4f55\u6642\u6700\u6709\u6548\u5730\u4f7f\u7528\u300c\u5fa9\u539f\u300d\u529f\u80fd\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5728\u8907\u96dc\u7684\u904a\u6232\u60c5\u5883\u4e2d\u6709\u6240\u5e6b\u52a9\uff1f", "answer": "\u5728\u7d19\u724c\u904a\u6232\u4e2d\uff0c\u300c\u5fa9\u539f\u300d\u529f\u80fd\u53ef\u7528\u65bc\u4fee\u6b63\u932f\u8aa4\u6216\u63a2\u7d22\u4e0d\u540c\u7684\u52d5\u4f5c\u5e8f\u5217\u3002\u73a9\u5bb6\u61c9\u5be9\u614e\u4f7f\u7528\u6b64\u529f\u80fd\uff0c\u4ee5\u907f\u514d\u7fd2\u6163\u6027\u4f9d\u8cf4\u3002\u6709\u6548\u4f7f\u7528\u300c\u5fa9\u539f\u300d\u529f\u80fd\u5305\u62ec\uff1a\u53cd\u8f49\u963b\u7919\u9032\u5ea6\u7684\u52d5\u4f5c\u3001\u5617\u8a66\u5176\u4ed6\u52d5\u4f5c\u4ee5\u63ed\u9732\u80cc\u9762\u7684\u5361\u7247\u3001\u4ee5\u53ca\u5f9e\u610f\u5916\u9ede\u64ca\u4e2d\u6062\u5fa9\u3002\u300c\u5fa9\u539f\u300d\u529f\u80fd\u53ef\u4ee5\u907f\u514d\u4e0d\u53ef\u9006\u7684\u52d5\u4f5c\u3002\u5047\u8a2d\u4f60\u79fb\u52d5\u4e86\u963b\u7919\u91cd\u8981\u738b\u724c\u5230\u57fa\u790e\u724c\u5806\u7684\u5361\u7247\uff0c\u300c\u5fa9\u539f\u300d\u53ef\u4ee5\u62ef\u6551\u4f60\u7684\u904a\u6232\u3002\u60f3\u50cf\u300c\u5fa9\u539f\u300d\u529f\u80fd\u5c31\u50cf\u6642\u9593\u8ff4\u8f49\u5668\uff0c\u8b93\u4f60\u7372\u5f97\u7b2c\u4e8c\u6b21\u5617\u8a66\u3002"}, {"question": "\u7d19\u724c\u904a\u6232\u8a08\u5206\u7cfb\u7d71\uff1a\u4e0d\u540c\u7684\u7d19\u724c\u904a\u6232\u8a08\u5206\u7cfb\u7d71\uff08\u6a19\u6e96\u3001\u62c9\u65af\u7dad\u52a0\u65af\uff09\u5982\u4f55\u5f71\u97ff\u904a\u6232\u7b56\u7565\u4ee5\u53ca\u6574\u9ad4\u73a9\u5bb6\u9ad4\u9a57\uff1f", "answer": "\u7d19\u724c\u904a\u6232\u4e2d\u7684\u4e0d\u540c\u8a08\u5206\u7cfb\u7d71\u6703\u5fb9\u5e95\u6539\u8b8a\u904a\u6232\u7b56\u7565\u3002\u6a19\u6e96\u8a08\u5206\u734e\u52f5\u901f\u5ea6\u548c\u6548\u7387\uff0c\u800c\u62c9\u65af\u7dad\u52a0\u65af\u8a08\u5206\u5247\u8457\u91cd\u65bc\u907f\u514d\u8ca0\u5206\u3002\u5c0d\u73a9\u5bb6\u9ad4\u9a57\u7684\u5f71\u97ff\uff1a\u6a19\u6e96\u8a08\u5206\u9f13\u52f5\u5feb\u901f\u904a\u6232\uff0c\u62c9\u65af\u7dad\u52a0\u65af\u8a08\u5206\u5247\u63a8\u5ee3\u8b39\u614e\u7684\u904a\u6232\uff0c\u642d\u914d\u9ad8\u98a8\u96aa\uff0f\u9ad8\u56de\u5831\u7684\u7b56\u7565\u3002\u5728\u6a19\u6e96\u8a08\u5206\u4e2d\uff0c\u5feb\u901f\u5c07\u5361\u7247\u79fb\u5230\u57fa\u790e\u724c\u5806\u3002\u5728\u62c9\u65af\u7dad\u52a0\u65af\u8a08\u5206\u4e2d\uff0c\u5c08\u6ce8\u65bc\u8d0f\u5f97\u6bd4\u8cfd\u4ee5\u907f\u514d\u5de8\u5927\u7684\u6263\u5206\u3002\u4e86\u89e3\u4e0d\u540c\u8a08\u5206\u7cfb\u7d71\u7684\u904b\u4f5c\u65b9\u5f0f\u975e\u5e38\u6709\u8da3\u4e26\u80fd\u512a\u5316\u5f97\u5206\u3002\u9019\u7a2e\u5dee\u7570\u5c31\u50cf\u9078\u64c7\u5728\u885d\u523a\u548c\u99ac\u62c9\u677e\u4e4b\u9593\u505a\u51fa\u9078\u64c7\u3002"}, {"question": "\u7d19\u724c\u904a\u6232\u5f15\u64ce\uff1a\u7d19\u724c\u904a\u6232\u5f15\u64ce\u4e2d\u4f7f\u7528\u7684\u6f14\u7b97\u6cd5\u5982\u4f55\u7522\u751f\u53ef\u89e3\u7684\u904a\u6232\uff0c\u4ee5\u53ca\u5b83\u5011\u904b\u4f5c\u7684\u9650\u5236\u6709\u54ea\u4e9b\uff1f", "answer": "\u7d19\u724c\u904a\u6232\u5f15\u64ce\u4f7f\u7528\u6f14\u7b97\u6cd5\u5617\u8a66\u7522\u751f\u53ef\u89e3\u7684\u904a\u6232\uff0c\u4f46\u7d55\u5c0d\u7684\u80af\u5b9a\u662f\u4e0d\u53ef\u80fd\u7684\u3002\u9650\u5236\u5305\u62ec\uff1a\u78ba\u4fdd\u5408\u7406\u7684\u724c\u7d44\u5206\u914d\u3001\u9075\u5faa\u767c\u724c\u898f\u5247\u3001\u4ee5\u53ca\u907f\u514d\u4e00\u958b\u59cb\u5c31\u78ba\u5b9a\u8f38\u6389\u7684\u8a2d\u5b9a\u3002\u53ef\u89e3\u6027\u6f14\u7b97\u6cd5\u53ef\u80fd\u6703\u5f9e\u89e3\u6c7a\u72c0\u614b\u9006\u5411\u6d17\u724c\u4ee5\u7522\u751f\u65b0\u7684\u904a\u6232\u3002\u9019\u6a23\u7684\u6f14\u7b97\u6cd5\u5c31\u50cf\u8b0e\u984c\u8a2d\u8a08\u5e2b\uff0c\u5728\u65e2\u5b9a\u904a\u6232\u898f\u5247\u5167\u5275\u9020\u6311\u6230\u3002"}, {"question": "\u8d85\u8d8a\u300e\u514b\u9686\u8fea\u514b\u300f\uff1a\u54ea\u4e9b\u6700\u6709\u8da3\u7684\u7d19\u724c\u904a\u6232\u8b8a\u9ad4\uff0c\u4ee5\u53ca\u5b83\u5011\u7368\u7279\u7684\u898f\u5247\u5982\u4f55\u5f71\u97ff\u904a\u6232\u548c\u7b56\u7565\u6c7a\u7b56\uff1f", "answer": "\u9664\u4e86\u514b\u9686\u8fea\u514b\u4e4b\u5916\uff0c\u6709\u8da3\u7684\u7d19\u724c\u904a\u6232\u8b8a\u9ad4\u5305\u62ec\u8718\u86db\u7d19\u724c\u3001\u81ea\u7531\u55ae\u5143\u7d19\u724c\u548c\u91d1\u5b57\u5854\u7d19\u724c\u3002\u9019\u4e9b\u8b8a\u9ad4\u5728\u4ee5\u4e0b\u65b9\u9762\u6709\u6240\u4e0d\u540c\uff1a\u724c\u5806\u4f48\u5c40\u3001\u4f7f\u7528\u7684\u724c\u6578\u91cf\u3001\u79fb\u52d5\u5361\u7247\u7684\u898f\u5247\u4ee5\u53ca\u52dd\u5229\u689d\u4ef6\u3002\u8718\u86db\u7d19\u724c\u9700\u8981\u5efa\u9020\u76f8\u540c\u82b1\u8272\u7684\u5e8f\u5217\uff08\u96e3\u5ea6\u66f4\u5927\uff09\uff0c\u800c\u81ea\u7531\u55ae\u5143\u7d19\u724c\u5247\u63d0\u4f9b\u7a7a\u55ae\u5143\u4f86\u64cd\u4f5c\u5361\u7247\u3002\u6539\u8b8a\u898f\u5247\u6703\u986f\u8457\u5f71\u97ff\u96e3\u5ea6\u3002\u73a9\u8b8a\u9ad4\u904a\u6232\u6703\u5e36\u4f86\u65b0\u7684\u601d\u8003\u65b9\u5f0f\u3002\u6bcf\u4e00\u7a2e\u8b8a\u9ad4\u90fd\u6703\u6e2c\u8a66\u4f60\u4e0d\u540c\u7684\u89e3\u8b0e\u6280\u80fd\u3002\u53ef\u4ee5\u628a\u5b83\u60f3\u6210\u5b78\u7fd2\u4e0d\u540c\u8a9e\u8a00\uff0c\u6bcf\u7a2e\u8a9e\u8a00\u90fd\u6709\u5176\u7368\u7279\u7684\u7d50\u69cb\u3002"}, {"question": "\u8de8\u5e73\u53f0\u904a\u6232\uff1a\u662f\u5426\u53ef\u4ee5\u5728\u4e0d\u540c\u7684\u4f5c\u696d\u7cfb\u7d71\uff08iOS\u3001Android\u3001Windows\uff09\u4e4b\u9593\u8f49\u79fb\u7d19\u724c\u904a\u6232\u7684\u9032\u5ea6\uff0c\u4ee5\u53ca\u9700\u8981\u54ea\u4e9b\u6b65\u9a5f\uff1f", "answer": "\u5728\u4e0d\u540c\u7684\u4f5c\u696d\u7cfb\u7d71\u5e73\u53f0\uff08iOS\u3001Android\u3001Windows\uff09\u4e4b\u9593\u8f49\u79fb\u7d19\u724c\u904a\u6232\u9032\u5ea6\uff0c\u53d6\u6c7a\u65bc\u7279\u5b9a\u7684\u7d19\u724c\u904a\u6232\u800c\u6709\u6240\u4e0d\u540c\u3002\u5b83\u901a\u5e38\u9700\u8981\uff1a\u64c1\u6709\u5df2\u9023\u7d50\u5230\u904a\u6232\u7684\u96f2\u7aef\u540c\u6b65\u5e33\u6236\u3001\u78ba\u4fdd\u5728\u5169\u90e8\u88dd\u7f6e\u4e0a\u4f7f\u7528\u76f8\u540c\u7684\u904a\u6232\u5ba2\u6236\u7aef\u4ee5\u53ca\u9075\u5faa\u61c9\u7528\u7a0b\u5f0f\u5167\u90e8\u95dc\u65bc\u8cc7\u6599\u8f49\u79fb\u7684\u8aaa\u660e\u3002\u67d0\u4e9b\u904a\u6232\u7684\u9032\u5ea6\u540c\u6b65\u4f7f\u7528 Google Play Games \u5e33\u6236\u3002\u8acb\u6aa2\u67e5\u60a8\u7684\u5e33\u6236\u8a2d\u5b9a\u3002\u904a\u6232\u540c\u6b65\u5c31\u50cf\u5728\u96f2\u7aef\u64c1\u6709\u4e00\u500b\u5168\u7403\u5132\u5b58\u6a94\u3002"}, {"question": "\u7d19\u724c\u904a\u6232\u7684\u96b1\u85cf\u6a21\u5f0f\uff1a\u7d19\u724c\u904a\u6232\u4e2d\u662f\u5426\u6709\u4efb\u4f55\u96b1\u85cf\u7684\u904a\u6232\u6a21\u5f0f\u6216\u5f69\u86cb\u6703\u986f\u8457\u6539\u8b8a\u904a\u6232\u9ad4\u9a57\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9396\u5b83\u5011\uff1f", "answer": "\u67d0\u4e9b\u7248\u672c\u7684\u7d19\u724c\u904a\u6232\u5305\u542b\u96b1\u85cf\u7684\u904a\u6232\u6a21\u5f0f\u6216\u5f69\u86cb\uff0c\u4f46\u9019\u4e9b\u5f88\u5c11\u898b\u3002\u89e3\u9396\u5b83\u5011\u901a\u5e38\u9700\u8981\uff1a\u5728\u904a\u6232\u4e2d\u57f7\u884c\u7279\u5b9a\u52d5\u4f5c\u3001\u8f38\u5165\u5bc6\u78bc\u6216\u5728\u7279\u5b9a\u689d\u4ef6\u4e0b\u5b8c\u6210\u6311\u6230\u3002\u4f8b\u5982\uff0c\u8f03\u820a Windows \u7248\u672c\u900f\u904e\u547d\u4ee4\u5217\u53c3\u6578\u5373\u53ef\u5b58\u53d6\u96b1\u85cf\u6a21\u5f0f\u3002\u96b1\u85cf\u7684\u904a\u6232\u6a21\u5f0f/\u5f69\u86cb\u89e3\u9396\u4ee4\u4eba\u8208\u596e\u7684\u8b8a\u9ad4\u3002\u9019\u5c31\u50cf\u5728\u7d93\u5178\u5e73\u53f0\u904a\u6232\u4e2d\u627e\u5230\u79d8\u5bc6\u95dc\u5361\uff01"}, {"question": "\u6df1\u5165\u63a2\u8a0e\u7d19\u724c\u904a\u6232\u7b56\u7565\uff1a\u70ba\u4ec0\u9ebc\u5148\u9032\u7684\u7d19\u724c\u904a\u6232\u7b56\u7565\u6703\u512a\u5148\u91cb\u653e\u57fa\u790e\u724c\u5806\u63d2\u69fd\uff0c\u4ee5\u53ca\u9019\u8207\u6574\u9ad4\u7372\u52dd\u7d50\u679c\u6709\u4f55\u95dc\u806f\uff1f", "answer": "\u5148\u9032\u7684\u7d19\u724c\u904a\u6232\u7b56\u7565\u5f37\u8abf\u76e1\u65e9\u5229\u7528\u57fa\u790e\u724c\u5806\u63d2\u69fd\uff0c\u56e0\u70ba\u5b83\u70ba\u66f4\u9577\u7684\u9023\u9396\u63d0\u4f9b\u4e86\u7a7a\u9593\u4e26\u589e\u52a0\u4e86\u79fb\u52d5\u5361\u7247\u7684\u9748\u6d3b\u6027\u3002\u539f\u56e0\u5728\u65bc\u63d2\u69fd\u8d8a\u591a\uff0c\u66f4\u5bb9\u6613\u7ba1\u7406\u5361\u7247\u5e8f\u5217\u3002\u6b65\u9a5f\u4e00\uff1a\u63ed\u9732\u76e1\u53ef\u80fd\u591a\u7684\u96b1\u85cf\u5361\u7247\u3002\u6b65\u9a5f\u4e8c\uff1a\u512a\u5148\u79fb\u52d5 Ace \u548c\u5c0f\u503c\u5361\u7247\u5230\u57fa\u790e\u724c\u5806\u3002\u6b65\u9a5f\u4e09\uff1a\u8a08\u756b\u52d5\u4f5c\u4ee5\u91cb\u653e\u53ef\u4ee5\u4f7f\u7528\u6240\u9700\u5361\u7247\u7684\u7a7a\u9593\u3002\u91cb\u653e\u57fa\u790e\u724c\u5806\u63d2\u69fd\u7b49\u540c\u65bc\u5c0d\u624b\u4e2d\u5361\u7247\u9032\u884c\u66f4\u7b56\u7565\u6027\u7684\u7ba1\u7406\u3002\u9019\u5c31\u50cf\u5efa\u7acb\u7269\u6d41\u7db2\u8def\uff0c\u4f60\u9700\u8981\u66f4\u591a\u8def\u5f91\u4f86\u79fb\u52d5\u8ca8\u7269\u3002"}]
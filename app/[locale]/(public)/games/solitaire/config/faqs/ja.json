[{"question": "\u30bd\u30ed\u306e\u57fa\u672c\uff1a\u30ab\u30fc\u30c9\u3092\u6b63\u3057\u304f\u914d\u308b\u65b9\u6cd5\u3068\u3001\u521d\u5fc3\u8005\u306e\u305f\u3081\u306e\u3055\u307e\u3056\u307e\u306a\u30bf\u30d6\u30ed\u30a5\u5c71\u306b\u3064\u3044\u3066\u6559\u3048\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u3067\u30ab\u30fc\u30c9\u3092\u914d\u308b\u306b\u306f\u3001\u30bf\u30d6\u30ed\u30a5\u30927\u3064\u306e\u5c71\u306b\u4f5c\u6210\u3057\u307e\u3059\u3002\u6700\u521d\u306e\u5c71\u306b\u306f1\u679a\u30012\u756a\u76ee\u306e\u5c71\u306b\u306f2\u679a\u3001\u3068\u7d9a\u304d\u307e\u3059\u3002\u6700\u521d\u306f\u5404\u5c71\u306e\u5148\u982d\u30ab\u30fc\u30c9\u3060\u3051\u8868\u5411\u304d\u3067\u3059\u3002\u6b8b\u308a\u306e\u30ab\u30fc\u30c9\u306f\u30b9\u30c8\u30c3\u30af\u5c71\u306b\u306a\u308a\u307e\u3059\u3002\u76ee\u6a19\u306f\u3001\u3059\u3079\u3066\u30ab\u30fc\u30c9\u3092\u3001\u9806\u5e8f\u306b\u4e26\u3079\u3066\u3001\u30b9\u30fc\u30c4\u3068\u30e9\u30f3\u30af\u3067\u30bd\u30fc\u30c8\u3055\u308c\u305f\u30d5\u30a1\u30a6\u30f3\u30c7\u30fc\u30b7\u30e7\u30f3\u5c71\u306b\u79fb\u52d5\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u30bf\u30d6\u30ed\u30a5\u306f\u30e1\u30a4\u30f3\u306e\u8868\u793a\u753b\u9762\u3060\u3068\u601d\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u624b\u98061\uff1a7\u3064\u306e\u30ab\u30b9\u30b1\u30fc\u30c9\u3092\u4f5c\u6210\u3057\u307e\u3059\u3002\u624b\u98062\uff1a\u4e0a\u90e8\u306e\u30ab\u30fc\u30c9\u3092\u3072\u3063\u304f\u308a\u8fd4\u3057\u307e\u3059\u3002\u624b\u98063\uff1a\u30b9\u30c8\u30c3\u30af\u5c71\u3092\u4f7f\u7528\u3057\u3066\u3001\u79fb\u52d5\u3092\u62e1\u5f35\u3057\u307e\u3059\u3002\u30bf\u30d6\u30ed\u30a5\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u77e5\u3063\u3066\u3044\u308c\u3070\u3001\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u3092\u30de\u30b9\u30bf\u30fc\u3067\u304d\u307e\u3059\u3002\u305d\u308c\u306f\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306e\u524d\u306b\u821e\u53f0\u3092\u8a2d\u5b9a\u3059\u308b\u3053\u3068\u3068\u4e00\u7dd2\u3067\u3059\u3002"}, {"question": "\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u3067\u3001\u306a\u305c\u4e00\u90e8\u306e\u52d5\u304d\u306f\u4ed6\u306e\u52d5\u304d\u3088\u308a\u3082\u512a\u308c\u3066\u3044\u308b\u3068\u898b\u306a\u3055\u308c\u3001\u521d\u671f\u306e\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u306e\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7\u8a55\u4fa1\u3092\u3069\u306e\u3088\u3046\u306b\u6539\u5584\u3057\u3066\u3001\u3088\u308a\u826f\u3044\u30bd\u30ea\u30e5\u30fc\u30b7\u30e7\u30f3\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u3067\u3088\u308a\u512a\u308c\u305f\u52d5\u304d\u306f\u3001\u30ab\u30fc\u30c9\u306e\u30a2\u30af\u30bb\u30b9\u53ef\u80fd\u6027\u3068\u30d5\u30a1\u30a6\u30f3\u30c7\u30fc\u30b7\u30e7\u30f3\u3078\u306e\u53ef\u80fd\u6027\u3092\u8003\u616e\u3057\u307e\u3059\u3002\u88cf\u5411\u304d\u306e\u30ab\u30fc\u30c9\u3092\u516c\u958b\u3059\u308b\u3053\u3068\u306f\u3001\u4e00\u822c\u7684\u306b\u826f\u3044\u52d5\u304d\u3067\u3059\u3002\u4ea4\u4e92\u306e\u8272\u306e\u30bf\u30d6\u30ed\u30a5\u306b\u69cb\u7bc9\u3059\u308b\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u8a55\u4fa1\u3092\u6539\u5584\u3059\u308b\u306b\u306f\u3001\u512a\u5148\u7684\u306b\u30a2\u30af\u30bb\u30b9\u53ef\u80fd\u306a\u30ab\u30fc\u30c9\u3001\u7a7a\u306e\u5217\u3092\u958b\u304f\u3053\u3068\u3001\u304a\u3088\u3073\u5fc5\u8981\u306a\u30ad\u30fc\u30ab\u30fc\u30c9\u3092\u7279\u5b9a\u3059\u308b\u3053\u3068\u306a\u3069\u304c\u3042\u308a\u307e\u3059\u3002\u521d\u671f\u306e\u6bb5\u968e\u3067\u7a7a\u306e\u5217\u3092\u958b\u304f\u3068\u3001\u30ad\u30f3\u30b0\u3068\u305d\u306e\u95a2\u9023\u30ab\u30fc\u30c9\u3092\u305d\u306e\u7a7a\u306e\u5834\u6240\u3078\u79fb\u52d5\u3059\u308b\u3053\u3068\u304c\u53ef\u80fd\u306b\u306a\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u521d\u671f\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7\u3092\u7dbf\u5bc6\u306b\u6bb5\u968e\u7684\u306b\u8a55\u4fa1\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u6226\u7565\u7684\u306a\u9078\u629e\u80a2\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002\u63a2\u5075\u5c0f\u8aac\u3092\u8aad\u3080\u3088\u3046\u306b\u3001\u6700\u521d\u306b\u624b\u304c\u304b\u308a\u3092\u63a2\u3057\u307e\u3059\u3002\u7a7a\u306e\u5217\u306f\u3001\u5927\u304d\u306a\u67d4\u8edf\u6027\u3092\u63d0\u4f9b\u3057\u3001\u30ef\u30a4\u30eb\u30c9\u30ab\u30fc\u30c9\u3092\u6301\u3063\u3066\u3044\u308b\u306e\u306b\u4f3c\u3066\u3044\u307e\u3059\u3002"}, {"question": "\u300c\u30af\u30ed\u30f3\u30c0\u30a4\u30af\u300d\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u3067\u52dd\u5229\u3059\u308b\u78ba\u7387\u306e\u7d71\u8a08\u306f\u4f55\u3067\u3042\u308a\u3001\u4f55\u306e\u8981\u56e0\u304c\u3053\u306e\u78ba\u7387\u306b\u5927\u304d\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u304b\uff1f", "answer": "\u6a19\u6e96\u7684\u306a\u30af\u30ed\u30f3\u30c0\u30a4\u30af\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u306e\u52dd\u5229\u7387\u306f43%\u3068\u63a8\u5b9a\u3055\u308c\u3066\u3044\u307e\u3059\u304c\u3001\u3053\u308c\u306f\u5927\u304d\u304f\u7570\u306a\u308a\u307e\u3059\u3002\u3053\u306e\u78ba\u7387\u306b\u5927\u304d\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u8981\u56e0\u306b\u306f\u3001\u521d\u671f\u306e\u30ab\u30fc\u30c9\u306e\u914d\u5206\uff08\u7279\u5b9a\u306e\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7\u306f\u307e\u3063\u305f\u304f\u52dd\u3066\u306a\u3044\uff09\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b9\u30ad\u30eb\uff08\u6226\u7565\u7684\u306a\u9078\u629e\u80a2\u306f\u6210\u529f\u306b\u5f71\u97ff\u3059\u308b\uff09\u3001\u30eb\u30fc\u30eb\u30d0\u30ea\u30a2\u30f3\u30c8\uff08\u305f\u3068\u3048\u3070\u30011\u679a\u306e\u30ab\u30fc\u30c9\u3092\u5f15\u304f\u5bfe3\u679a\u306e\u30ab\u30fc\u30c9\u3092\u5f15\u304f\uff09\u306a\u3069\u304c\u3042\u308a\u307e\u3059\u3002\u30aa\u30c3\u30ba\u306f\u30c7\u30c3\u30ad\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u3002\u6709\u5229\u306a\u30c7\u30c3\u30ad\u306e\u914d\u5206\u306f\u6210\u529f\u7387\u3092\u4e0a\u3052\u307e\u3059\u3002\u7c21\u5358\u306a\u30d0\u30ea\u30a2\u30f3\u30c8\u306f\u3001\u30b9\u30c8\u30c3\u30af\u3092\u901a\u308b\u8907\u6570\u306e\u30d1\u30b9\u3092\u8a31\u53ef\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u3088\u308a\u516c\u6b63\u3067\u3001\u3088\u308a\u30ea\u30e9\u30c3\u30af\u30b9\u3057\u305f\u30b2\u30fc\u30e0\u306b\u306a\u308a\u307e\u3059\u3002"}, {"question": "\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u306e\u300c\u3084\u308a\u76f4\u3057\u300d\u6226\u7565\uff1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u3069\u306e\u6642\u70b9\u3067\u300c\u3084\u308a\u76f4\u3057\u300d\u6a5f\u80fd\u3092\u6700\u3082\u52b9\u679c\u7684\u306b\u4f7f\u7528\u3059\u3079\u304d\u3067\u3042\u308a\u3001\u305d\u308c\u306f\u8907\u96d1\u306a\u30b2\u30fc\u30e0\u72b6\u6cc1\u3067\u3069\u306e\u3088\u3046\u306b\u5f79\u7acb\u3061\u307e\u3059\u304b\uff1f", "answer": "\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u306e\u300c\u3084\u308a\u76f4\u3057\u300d\u6a5f\u80fd\u306f\u3001\u9593\u9055\u3044\u3092\u4fee\u6b63\u3057\u305f\u308a\u3001\u3055\u307e\u3056\u307e\u306a\u79fb\u52d5\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u691c\u8a0e\u3057\u305f\u308a\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u7fd2\u6163\u7684\u306b\u983c\u3089\u306a\u3044\u3088\u3046\u306b\u3001\u305d\u308c\u3092\u614e\u91cd\u306b\u4f7f\u7528\u3059\u308b\u306e\u304c\u91cd\u8981\u3067\u3059\u3002\u52b9\u679c\u7684\u306a\u4f7f\u7528\u6cd5\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\u3002\u9032\u6357\u3092\u30d6\u30ed\u30c3\u30af\u3059\u308b\u52d5\u304d\u3092\u5143\u306b\u623b\u3059\u3001\u88cf\u5411\u304d\u306e\u30ab\u30fc\u30c9\u3092\u516c\u958b\u3059\u308b\u305f\u3081\u306b\u4ee3\u66ff\u306e\u52d5\u304d\u3092\u8a66\u3059\u3001\u5076\u767a\u7684\u306a\u30af\u30ea\u30c3\u30af\u304b\u3089\u56de\u5fa9\u3059\u308b\u306a\u3069\u3067\u3059\u3002\u300c\u3084\u308a\u76f4\u3057\u300d\u306f\u3001\u53d6\u308a\u8fd4\u3057\u306e\u3064\u304b\u306a\u3044\u52d5\u304d\u3092\u9632\u3050\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u91cd\u8981\u306a\u30ad\u30f3\u30b0\u3092\u30d5\u30a1\u30a6\u30f3\u30c7\u30fc\u30b7\u30e7\u30f3\u306b\u79fb\u52d5\u3059\u308b\u30ab\u30fc\u30c9\u3092\u52d5\u304b\u305b\u306a\u304f\u306a\u308b\u72b6\u6cc1\u3092\u60f3\u50cf\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u300c\u3084\u308a\u76f4\u3057\u300d\u6a5f\u80fd\u3067\u30b2\u30fc\u30e0\u3092\u6551\u3046\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u300c\u3084\u308a\u76f4\u3057\u300d\u306f\u30012\u56de\u76ee\u306e\u8a66\u884c\u3092\u63d0\u4f9b\u3059\u308b\u30bf\u30a4\u30e0\u30bf\u30fc\u30ca\u30fc\u3060\u3068\u601d\u3063\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\uff1a\u3055\u307e\u3056\u307e\u306a\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\uff08\u6a19\u6e96\u3001\u30d9\u30ac\u30b9\uff09\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u6226\u7565\u3068\u5168\u4f53\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u4f53\u9a13\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u306e\u7570\u306a\u308b\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u6226\u7565\u3092\u6839\u672c\u7684\u306b\u5909\u3048\u307e\u3059\u3002\u6a19\u6e96\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u901f\u5ea6\u3068\u52b9\u7387\u3092\u91cd\u8996\u3059\u308b\u306e\u306b\u5bfe\u3057\u3001\u30d9\u30ac\u30b9\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30de\u30a4\u30ca\u30b9\u306e\u30b9\u30b3\u30a2\u3092\u56de\u907f\u3059\u308b\u3053\u3068\u306b\u91cd\u70b9\u3092\u7f6e\u3044\u3066\u3044\u307e\u3059\u3002\u30d7\u30ec\u30a4\u30e4\u30fc\u4f53\u9a13\u3078\u306e\u5f71\u97ff\uff1a\u6a19\u6e96\u306f\u8fc5\u901f\u306a\u30d7\u30ec\u30a4\u3092\u4fc3\u9032\u3057\u3001\u30d9\u30ac\u30b9\u306f\u30ea\u30b9\u30af\u306e\u9ad8\u3044/\u30ea\u30bf\u30fc\u30f3\u304c\u9ad8\u3044\u6226\u7565\u3067\u3001\u614e\u91cd\u306a\u30d7\u30ec\u30a4\u3092\u4fc3\u9032\u3057\u307e\u3059\u3002\u6a19\u6e96\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u3067\u306f\u3001\u95a2\u4fc2\u306a\u304f\u30ab\u30fc\u30c9\u3092\u3059\u3070\u3084\u304f\u30d5\u30a1\u30a6\u30f3\u30c7\u30fc\u30b7\u30e7\u30f3\u306b\u79fb\u52d5\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30d9\u30ac\u30b9\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u3067\u306f\u3001\u5927\u304d\u306a\u6e1b\u70b9\u3055\u308c\u306a\u3044\u3088\u3046\u306b\u3001\u52dd\u5229\u306b\u306e\u307f\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u3055\u307e\u3056\u307e\u306a\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306e\u52d5\u4f5c\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u30b9\u30b3\u30a2\u3092\u6700\u9069\u5316\u3059\u308b\u969b\u306b\u975e\u5e38\u306b\u697d\u3057\u3044\u3067\u3059\u3002\u305d\u306e\u9055\u3044\u306f\u3001\u30b9\u30d7\u30ea\u30f3\u30c8\u3068\u30de\u30e9\u30bd\u30f3\u3092\u9078\u629e\u3059\u308b\u3053\u3068\u3068\u4e00\u7dd2\u3067\u3059\u3002"}, {"question": "\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u306e\u30b2\u30fc\u30e0\u30a8\u30f3\u30b8\u30f3\uff1a\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u306e\u30b2\u30fc\u30e0\u30a8\u30f3\u30b8\u30f3\u3067\u4f7f\u7528\u3055\u308c\u308b\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u89e3\u6c7a\u53ef\u80fd\u306a\u30b2\u30fc\u30e0\u3092\u3069\u306e\u3088\u3046\u306b\u751f\u6210\u3057\u3001\u3069\u306e\u3088\u3046\u306a\u5236\u7d04\u306e\u4e0b\u3067\u52d5\u4f5c\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u306e\u30b2\u30fc\u30e0\u30a8\u30f3\u30b8\u30f3\u306f\u3001\u89e3\u6c7a\u53ef\u80fd\u306a\u30b2\u30fc\u30e0\u3092\u751f\u6210\u3057\u3088\u3046\u3068\u3057\u307e\u3059\u304c\u3001\u5b8c\u5168\u306a\u78ba\u5b9f\u6027\u306f\u4e0d\u53ef\u80fd\u3067\u3059\u3002\u5236\u7d04\u306f\u6b21\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\uff1a\u30ab\u30fc\u30c9\u306e\u59a5\u5f53\u306a\u5206\u5e03\u3092\u4fdd\u8a3c\u3059\u308b\u3001\u30ab\u30fc\u30c9\u306e\u914d\u5206\u306b\u304a\u3051\u308b\u30b2\u30fc\u30e0\u30eb\u30fc\u30eb\u306b\u5f93\u3046\u3001\u6700\u521d\u304b\u3089\u640d\u5931\u304c\u4fdd\u8a3c\u3055\u308c\u3066\u3044\u308b\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7\u3092\u56de\u907f\u3059\u308b\u306a\u3069\u3067\u3059\u3002\u30bd\u30ea\u30e5\u30fc\u30b7\u30e7\u30f3\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u89e3\u6c7a\u6e08\u307f\u306e\u72b6\u614b\u304b\u3089\u9006\u65b9\u5411\u306b\u30ab\u30fc\u30c9\u3092\u30b7\u30e3\u30c3\u30d5\u30eb\u3057\u3066\u3001\u65b0\u3057\u3044\u30b2\u30fc\u30e0\u3092\u751f\u6210\u3059\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u305d\u306e\u3088\u3046\u306a\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u4e8b\u524d\u306b\u5b9a\u7fa9\u3055\u308c\u305f\u30b2\u30fc\u30e0\u30eb\u30fc\u30eb\u5185\u3067\u8ab2\u984c\u3092\u4f5c\u6210\u3059\u308b\u30d1\u30ba\u30eb\u30e1\u30fc\u30ab\u30fc\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002"}, {"question": "\u300c\u30af\u30ed\u30f3\u30c0\u30a4\u30af\u300d\u3092\u8d85\u3048\u3066\uff1a\u6700\u3082\u8208\u5473\u6df1\u3044\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u306e\u5909\u7a2e\u306f\u4f55\u3067\u3042\u308a\u3001\u305d\u308c\u3089\u306e\u72ec\u81ea\u306e\u30eb\u30fc\u30eb\u30bb\u30c3\u30c8\u306f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3068\u6226\u7565\u7684\u306a\u6c7a\u5b9a\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30af\u30ed\u30f3\u30c0\u30a4\u30af\u3092\u8d85\u3048\u3066\u3001\u8208\u5473\u6df1\u3044\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u306e\u5909\u7a2e\u306b\u306f\u3001\u30b9\u30e9\u30a4\u30c0\u30fc\u3001\u30d5\u30ea\u30fc\u30bb\u30eb\u3001\u30d4\u30e9\u30df\u30c3\u30c9\u306a\u3069\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u5909\u7a2e\u306f\u3001\u30bf\u30d6\u30ed\u30a5\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3001\u4f7f\u7528\u3055\u308c\u308b\u30c7\u30c3\u30ad\u306e\u6570\u3001\u30ab\u30fc\u30c9\u306e\u79fb\u52d5\u30eb\u30fc\u30eb\u3001\u52dd\u5229\u6761\u4ef6\u306a\u3069\u306b\u304a\u3044\u3066\u7570\u306a\u308a\u307e\u3059\u3002\u30b9\u30e9\u30a4\u30c0\u30fc\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u3067\u306f\u3001\u540c\u3058\u8272\u306e\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u69cb\u7bc9\u3059\u308b\uff08\u3088\u308a\u96e3\u3057\u304f\u306a\u308b\uff09\u306e\u306b\u5bfe\u3057\u3001\u30d5\u30ea\u30fc\u30bb\u30eb\u306f\u30ab\u30fc\u30c9\u3092\u64cd\u4f5c\u3059\u308b\u305f\u3081\u306e\u30d5\u30ea\u30fc\u30bb\u30eb\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u30eb\u30fc\u30eb\u3092\u5909\u66f4\u3059\u308b\u3068\u3001\u96e3\u6613\u5ea6\u304c\u5927\u304d\u304f\u5909\u308f\u308a\u307e\u3059\u3002\u30d0\u30ea\u30a2\u30f3\u30c8\u3092\u30d7\u30ec\u30a4\u3059\u308b\u3068\u3001\u65b0\u3057\u3044\u8003\u3048\u65b9\u3092\u958b\u304d\u307e\u3059\u3002\u5404\u30d0\u30ea\u30a8\u30fc\u30b7\u30e7\u30f3\u306f\u3001\u30d1\u30ba\u30eb\u89e3\u6c7a\u30b9\u30ad\u30eb\u3092\u7570\u306a\u308b\u5074\u9762\u3067\u8a66\u3057\u307e\u3059\u3002\u305d\u308c\u306f\u3001\u72ec\u81ea\u306e\u72ec\u7279\u306a\u69cb\u9020\u3092\u6301\u3064\u7570\u306a\u308b\u8a00\u8a9e\u3092\u5b66\u3076\u3053\u3068\u3068\u898b\u306a\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u306e\u30d7\u30ec\u30a4\uff1a\u7570\u306a\u308b\u30aa\u30da\u30ec\u30fc\u30c6\u30a3\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\uff08iOS\u3001Android\u3001Windows\uff09\u9593\u3067\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u306e\u30b2\u30fc\u30e0\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u3053\u3068\u306f\u53ef\u80fd\u3067\u3042\u308a\u3001\u3069\u306e\u3088\u3046\u306a\u624b\u9806\u304c\u5fc5\u8981\u3067\u3059\u304b\uff1f", "answer": "\u7570\u306a\u308bOS\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\uff08iOS\u3001Android\u3001Windows\uff09\u9593\u3067\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3067\u304d\u308b\u304b\u3069\u3046\u304b\u306f\u3001\u7279\u5b9a\u306e\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u30b2\u30fc\u30e0\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u3002\u901a\u5e38\u3001\u6b21\u306e\u624b\u9806\u304c\u5fc5\u8981\u3067\u3059\uff1a\u30b2\u30fc\u30e0\u306b\u30ea\u30f3\u30af\u3055\u308c\u305f\u30af\u30e9\u30a6\u30c9\u540c\u671f\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u6301\u3064\u3001\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30b2\u30fc\u30e0\u30af\u30e9\u30a4\u30a2\u30f3\u30c8\u3092\u4f7f\u7528\u3059\u308b\u3001\u30c7\u30fc\u30bf\u8ee2\u9001\u306e\u305f\u3081\u306e\u30a2\u30d7\u30ea\u5185\u6307\u793a\u306b\u5f93\u3046\u306a\u3069\u3067\u3059\u3002\u4e00\u90e8\u306e\u30b2\u30fc\u30e0\u3067\u306f\u3001Google Play Games\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u4f7f\u7528\u3057\u3066\u9032\u884c\u72b6\u6cc1\u3092\u540c\u671f\u3057\u3066\u3044\u307e\u3059\u3002\u30a2\u30ab\u30a6\u30f3\u30c8\u8a2d\u5b9a\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b2\u30fc\u30e0\u306e\u540c\u671f\u306f\u3001\u30af\u30e9\u30a6\u30c9\u4e0a\u306e\u30b0\u30ed\u30fc\u30d0\u30eb\u30bb\u30fc\u30d6\u30d5\u30a1\u30a4\u30eb\u3092\u6301\u3063\u3066\u3044\u308b\u306e\u3068\u540c\u3058\u3067\u3059\u3002"}, {"question": "\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u306e\u96a0\u3055\u308c\u305f\u30e2\u30fc\u30c9\uff1a\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u306e\u4e2d\u306b\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4f53\u9a13\u3092\u5927\u304d\u304f\u5909\u3048\u308b\u96a0\u3055\u308c\u305f\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u307e\u305f\u306f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\u3001\u305d\u308c\u3089\u306f\u3069\u306e\u3088\u3046\u306b\u30ed\u30c3\u30af\u3092\u89e3\u9664\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u306e\u3042\u308b\u30d0\u30fc\u30b8\u30e7\u30f3\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u307e\u305f\u306f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u304c\u3001\u3053\u308c\u3089\u306e\u30e2\u30fc\u30c9\u306f\u307e\u308c\u3067\u3059\u3002\u305d\u308c\u3089\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u306b\u306f\u3001\u901a\u5e38\u306f\u6b21\u306e\u624b\u9806\u304c\u3042\u308a\u307e\u3059\u3002\u7279\u5b9a\u306e\u52d5\u4f5c\u3092\u5b9f\u884c\u3059\u308b\u3001\u79d8\u5bc6\u306e\u30b3\u30fc\u30c9\u3092\u5165\u529b\u3059\u308b\u3001\u7279\u5b9a\u306e\u6761\u4ef6\u4e0b\u3067\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u5b8c\u4e86\u3059\u308b\u306a\u3069\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u53e4\u3044Windows\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u306b\u306f\u3001\u30b3\u30de\u30f3\u30c9\u30e9\u30a4\u30f3\u5f15\u6570\u3067\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u96a0\u3057\u30e2\u30fc\u30c9\u304c\u3042\u308a\u307e\u3057\u305f\u3002\u96a0\u3057\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9/\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3001\u30a8\u30ad\u30b5\u30a4\u30c6\u30a3\u30f3\u30b0\u306a\u30d0\u30ea\u30a2\u30f3\u30c8\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u307e\u3059\u3002\u305d\u308c\u306f\u3001\u30af\u30e9\u30b7\u30c3\u30af\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30de\u30fc\u306e\u79d8\u5bc6\u30ec\u30d9\u30eb\u3092\u898b\u3064\u3051\u308b\u3088\u3046\u306a\u3082\u306e\u3067\u3059\uff01"}, {"question": "\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u6226\u7565\u306e\u6df1\u3044\u63a2\u6c42\uff1a\u306a\u305c\u4e0a\u7d1a\u306e\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u6226\u7565\u306f\u3001\u521d\u671f\u6bb5\u968e\u3067\u30d5\u30a1\u30a6\u30f3\u30c7\u30fc\u30b7\u30e7\u30f3\u30b9\u30ed\u30c3\u30c8\u3092\u958b\u653e\u3059\u308b\u3053\u3068\u3092\u91cd\u8996\u3057\u3001\u3053\u308c\u306f\u5168\u4f53\u7684\u306a\u52dd\u5229\u306e\u7d50\u679c\u3068\u3069\u306e\u3088\u3046\u306b\u95a2\u9023\u3057\u3066\u3044\u307e\u3059\u304b\uff1f", "answer": "\u4e0a\u7d1a\u306e\u30bd\u30ed\u30da\u30a4\u30f3\u30c8\u6226\u7565\u306f\u3001\u521d\u671f\u6bb5\u968e\u3067\u30d5\u30a1\u30a6\u30f3\u30c7\u30fc\u30b7\u30e7\u30f3\u30b9\u30ed\u30c3\u30c8\u3092\u6d3b\u7528\u3059\u308b\u3053\u3068\u3092\u91cd\u8996\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u3088\u308a\u9577\u3044\u30e9\u30f3\u306e\u305f\u3081\u306e\u30b9\u30da\u30fc\u30b9\u3092\u4f5c\u308a\u51fa\u3057\u3001\u30ab\u30fc\u30c9\u306e\u79fb\u52d5\u306b\u304a\u3051\u308b\u67d4\u8edf\u6027\u3092\u9ad8\u3081\u307e\u3059\u3002\u7406\u7531\u306f\u3001\u5229\u7528\u53ef\u80fd\u306a\u30b9\u30ed\u30c3\u30c8\u304c\u591a\u3044\u307b\u3069\u3001\u30ab\u30fc\u30c9\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u7ba1\u7406\u3057\u3084\u3059\u304f\u306a\u308b\u304b\u3089\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u53ef\u80fd\u306a\u9650\u308a\u591a\u304f\u306e\u96a0\u3055\u308c\u305f\u30ab\u30fc\u30c9\u3092\u516c\u958b\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30a8\u30fc\u30b9\u3068\u4f4e\u3044\u4fa1\u5024\u306e\u30ab\u30fc\u30c9\u3092\u30d5\u30a1\u30a6\u30f3\u30c7\u30fc\u30b7\u30e7\u30f3\u306b\u79fb\u52d5\u3059\u308b\u3053\u3068\u3092\u512a\u5148\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5fc5\u8981\u306a\u30ab\u30fc\u30c9\u3067\u57cb\u3081\u3089\u308c\u308b\u30b9\u30da\u30fc\u30b9\u3092\u958b\u3051\u308b\u305f\u3081\u306e\u79fb\u52d5\u3092\u8a08\u753b\u3059\u308b\u3002\u30d5\u30a1\u30a6\u30f3\u30c7\u30fc\u30b7\u30e7\u30f3\u30b9\u30ed\u30c3\u30c8\u3092\u958b\u653e\u3059\u308b\u3053\u3068\u306f\u3001\u624b\u672d\u306e\u3088\u308a\u6226\u7565\u7684\u306a\u7ba1\u7406\u306b\u7ffb\u8a33\u3055\u308c\u307e\u3059\u3002\u305d\u308c\u306f\u3001\u7269\u8cc7\u3092\u79fb\u52d5\u3059\u308b\u305f\u3081\u306e\u7269\u6d41\u30cd\u30c3\u30c8\u30ef\u30fc\u30af\u3092\u69cb\u7bc9\u3059\u308b\u306e\u3068\u540c\u3058\u3067\u3059\u3002\u5fc5\u8981\u306a\u7d4c\u7531\u5730\u3092\u305f\u304f\u3055\u3093\u6301\u3064\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}]
[{"question": "\u7eb8\u724c\u6e38\u620f\u57fa\u672c\u89c4\u5219\uff1a\u521d\u5b66\u8005\u5982\u4f55\u6b63\u786e\u53d1\u724c\u4ee5\u53ca\u4e0d\u540c\u7684\u724c\u5806\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u7eb8\u724c\u6e38\u620f\u4e2d\uff0c\u53d1\u724c\u5305\u62ec\u521b\u5efa\u4e03\u4e2a\u724c\u5806\u3002\u7b2c\u4e00\u4e2a\u724c\u5806\u6709\u4e00\u5f20\u724c\uff0c\u7b2c\u4e8c\u4e2a\u724c\u5806\u6709\u4e24\u5f20\u724c\uff0c\u4ee5\u6b64\u7c7b\u63a8\u3002\u6700\u521d\uff0c\u6bcf\u4e2a\u724c\u5806\u53ea\u6709\u6700\u4e0a\u9762\u7684\u724c\u662f\u6b63\u9762\u671d\u4e0a\u7684\u3002\u5269\u4f59\u7684\u724c\u5f62\u6210\u5e93\u5b58\u724c\u5806\u3002\u76ee\u6807\u662f\u5c06\u6240\u6709\u724c\u6309\u7167\u82b1\u8272\u548c\u70b9\u6570\u79fb\u5230\u57fa\u7840\u724c\u5806\u3002\u5c06\u724c\u5806\u89c6\u4e3a\u60a8\u7684\u4e3b\u8981\u663e\u793a\u533a\u57df\u3002\u6b65\u9aa41\uff1a\u521b\u5efa7\u4e2a\u724c\u5806\uff1b\u6b65\u9aa42\uff1a\u7ffb\u8f6c\u6700\u4e0a\u9762\u7684\u724c\uff1b\u6b65\u9aa43\uff1a\u4f7f\u7528\u5e93\u5b58\u724c\u8fdb\u884c\u989d\u5916\u64cd\u4f5c\u3002\u4e86\u89e3\u724c\u5806\u5e03\u5c40\u662f\u638c\u63e1\u7eb8\u724c\u6e38\u620f\u7684\u5173\u952e\u3002\u8fd9\u5c31\u50cf\u5728\u6f14\u51fa\u5f00\u59cb\u4e4b\u524d\u5e03\u7f6e\u821e\u53f0\u4e00\u6837\u3002"}, {"question": "\u5728\u7eb8\u724c\u6e38\u620f\u4e2d\uff0c\u4e3a\u4ec0\u4e48\u6709\u4e9b\u64cd\u4f5c\u6bd4\u5176\u4ed6\u64cd\u4f5c\u66f4\u597d\uff0c\u4ee5\u53ca\u5982\u4f55\u6539\u8fdb\u6211\u6700\u521d\u5bf9\u7eb8\u724c\u6e38\u620f\u5e03\u5c40\u7684\u8bc4\u4f30\u4ee5\u627e\u5230\u66f4\u597d\u7684\u89e3\u51b3\u65b9\u6848\uff1f", "answer": "\u7eb8\u724c\u6e38\u620f\u4e2d\u66f4\u597d\u7684\u64cd\u4f5c\u4f1a\u8003\u8651\u724c\u7684\u53ef\u8bbf\u95ee\u6027\u548c\u57fa\u7840\u724c\u5806\u7684\u6f5c\u529b\u3002\u66b4\u9732\u4e00\u5f20\u80cc\u9762\u671d\u4e0a\u7684\u724c\u901a\u5e38\u662f\u4e00\u4e2a\u5f88\u597d\u7684\u64cd\u4f5c\u3002\u4f18\u5148\u5728\u724c\u5806\u4e2d\u5efa\u7acb\u95f4\u9694\u989c\u8272\u987a\u5e8f\u7684\u5e8f\u5217\u3002\u6539\u8fdb\u8bc4\u4f30\u5305\u62ec\uff1a\u4f18\u5148\u5904\u7406\u53ef\u8bbf\u95ee\u7684\u724c\uff0c\u6253\u5f00\u7a7a\u5217\u4ee5\u53ca\u8bc6\u522b\u5173\u952e\u724c\u3002\u5c3d\u65e9\u6253\u5f00\u7a7a\u5217\u53ef\u80fd\u4f1a\u8ba9\u60a8\u79fb\u52a8\u738b\u724c\u548c\u5176\u4ed6\u76f8\u5173\u7684\u724c\u5230\u7a7a\u4f4d\u3002\u7ec6\u81f4\u5730\u9010\u6b65\u8bc4\u4f30\u521d\u59cb\u5e03\u5c40\uff0c\u5c06\u5bfc\u81f4\u66f4\u597d\u7684\u6218\u7565\u9009\u62e9\u3002\u5c31\u50cf\u9605\u8bfb\u4fa6\u63a2\u5c0f\u8bf4\u4e00\u6837\uff0c\u4ece\u4e00\u5f00\u59cb\u5c31\u8981\u5bfb\u627e\u7ebf\u7d22\u3002\u7a7a\u5217\u63d0\u4f9b\u4e86\u5f88\u5927\u7684\u7075\u6d3b\u6027\uff0c\u5c31\u50cf\u62e5\u6709\u738b\u724c\u4e00\u6837\u3002"}, {"question": "\u2018\u514b\u9686\u8fea\u514b\u2019\u7eb8\u724c\u6e38\u620f\u83b7\u80dc\u7684\u7edf\u8ba1\u6982\u7387\u662f\u591a\u5c11\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u4f1a\u663e\u8457\u5f71\u54cd\u8be5\u6982\u7387\uff1f", "answer": "\u6807\u51c6\u514b\u9686\u8fea\u514b\u7eb8\u724c\u6e38\u620f\u7684\u83b7\u80dc\u7387\u7ea6\u4e3a43%\uff0c\u5c3d\u7ba1\u8fd9\u5dee\u5f02\u5f88\u5927\u3002\u663e\u8457\u5f71\u54cd\u8fd9\u4e00\u56e0\u7d20\u5305\u62ec\uff1a\u521d\u59cb\u724c\u7684\u5206\u5e03\uff08\u67d0\u4e9b\u8bbe\u7f6e\u6839\u672c\u65e0\u6cd5\u83b7\u80dc\uff09\uff0c\u73a9\u5bb6\u6280\u80fd\uff08\u6218\u7565\u9009\u62e9\u4f1a\u5f71\u54cd\u6210\u529f\u7387\uff09\u4ee5\u53ca\u89c4\u5219\u53d8\u4f53\uff08\u4f8b\u5982\uff0c\u62bd\u53d6\u4e00\u5f20\u724c\u4e0e\u62bd\u53d6\u4e09\u5f20\u724c\uff09\u3002\u6982\u7387\u53d6\u51b3\u4e8e\u724c\u7ec4\u3002\u6709\u5229\u7684\u724c\u7ec4\u5206\u5e03\u53ef\u4ee5\u63d0\u9ad8\u6210\u529f\u7387\u3002\u4e00\u4e2a\u7b80\u5355\u7684\u53d8\u4f53\u662f\u5141\u8bb8\u591a\u6b21\u901a\u8fc7\u5e93\u5b58\u724c\uff0c\u4ece\u800c\u63d0\u4f9b\u66f4\u516c\u5e73\u3001\u66f4\u8f7b\u677e\u7684\u6e38\u620f\u3002"}, {"question": "\u7eb8\u724c\u6e38\u620f\u201c\u64a4\u9500\u201d\u7b56\u7565\uff1a\u73a9\u5bb6\u5728\u4ec0\u4e48\u60c5\u51b5\u4e0b\u5e94\u8be5\u6700\u6709\u6548\u5730\u4f7f\u7528\u201c\u64a4\u9500\u201d\u529f\u80fd\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5728\u590d\u6742\u7684\u6e38\u620f\u60c5\u51b5\u4e0b\u63d0\u4f9b\u5e2e\u52a9\uff1f", "answer": "\u7eb8\u724c\u6e38\u620f\u4e2d\u7684\u201c\u64a4\u9500\u201d\u529f\u80fd\u5bf9\u4e8e\u7ea0\u6b63\u9519\u8bef\u6216\u63a2\u7d22\u4e0d\u540c\u7684\u64cd\u4f5c\u5e8f\u5217\u5f88\u6709\u7528\u3002\u73a9\u5bb6\u5e94\u8be5\u8c28\u614e\u4f7f\u7528\u5b83\uff0c\u907f\u514d\u4e60\u60ef\u6027\u4f9d\u8d56\u3002\u201c\u64a4\u9500\u201d\u529f\u80fd\u7684\u6709\u6548\u4f7f\u7528\u5305\u62ec\uff1a\u53cd\u8f6c\u963b\u788d\u8fdb\u5ea6\u7684\u64cd\u4f5c\uff0c\u5c1d\u8bd5\u5176\u4ed6\u64cd\u4f5c\u6765\u63ed\u793a\u80cc\u9762\u671d\u4e0a\u7684\u724c\u4ee5\u53ca\u4ece\u610f\u5916\u70b9\u51fb\u4e2d\u6062\u590d\u3002\u201c\u64a4\u9500\u201d\u529f\u80fd\u53ef\u4ee5\u9632\u6b62\u4e0d\u53ef\u9006\u7684\u64cd\u4f5c\u3002\u5047\u8bbe\u60a8\u79fb\u52a8\u4e86\u963b\u788d\u5173\u952e\u738b\u724c\u8fdb\u5165\u57fa\u7840\u724c\u5806\u7684\u724c\uff0c\u90a3\u4e48\u201c\u64a4\u9500\u201d\u529f\u80fd\u53ef\u4ee5\u4fdd\u5b58\u60a8\u7684\u6e38\u620f\u3002\u5c06\u201c\u64a4\u9500\u201d\u89c6\u4e3a\u65f6\u95f4\u5012\u8f6c\u5668\uff0c\u8ba9\u60a8\u6709\u7b2c\u4e8c\u6b21\u5c1d\u8bd5\u7684\u673a\u4f1a\u3002"}, {"question": "\u7eb8\u724c\u6e38\u620f\u8bb0\u5206\u7cfb\u7edf\uff1a\u4e0d\u540c\u7684\u7eb8\u724c\u6e38\u620f\u8bb0\u5206\u7cfb\u7edf\uff08\u6807\u51c6\uff0c\u62c9\u65af\u7ef4\u52a0\u65af\uff09\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u7b56\u7565\u4ee5\u53ca\u6574\u4f53\u73a9\u5bb6\u4f53\u9a8c\uff1f", "answer": "\u7eb8\u724c\u6e38\u620f\u4e2d\u7684\u4e0d\u540c\u8bb0\u5206\u7cfb\u7edf\u4f1a\u5f7b\u5e95\u6539\u53d8\u6e38\u620f\u7b56\u7565\u3002\u6807\u51c6\u8bb0\u5206\u5956\u52b1\u901f\u5ea6\u548c\u6548\u7387\uff0c\u800c\u62c9\u65af\u7ef4\u52a0\u65af\u8bb0\u5206\u5219\u4fa7\u91cd\u4e8e\u907f\u514d\u8d1f\u5206\u3002\u5bf9\u73a9\u5bb6\u4f53\u9a8c\u7684\u5f71\u54cd\uff1a\u6807\u51c6\u8bb0\u5206\u9f13\u52b1\u5feb\u901f\u6e38\u620f\uff0c\u62c9\u65af\u7ef4\u52a0\u65af\u8bb0\u5206\u5219\u63d0\u5021\u4fdd\u5b88\u7684\u6e38\u620f\uff0c\u5e76\u91c7\u7528\u9ad8\u98ce\u9669/\u9ad8\u56de\u62a5\u7684\u7b56\u7565\u3002\u5728\u6807\u51c6\u8bb0\u5206\u4e2d\uff0c\u65e0\u8bba\u5982\u4f55\u90fd\u5feb\u901f\u5c06\u724c\u79fb\u5230\u57fa\u7840\u724c\u5806\u3002\u5728\u62c9\u65af\u7ef4\u52a0\u65af\u8bb0\u5206\u4e2d\uff0c\u53ea\u4e13\u6ce8\u4e8e\u83b7\u80dc\u4ee5\u907f\u514d\u5de8\u5927\u7684\u6263\u5206\u3002\u4e86\u89e3\u4e0d\u540c\u8bb0\u5206\u7cfb\u7edf\u7684\u5de5\u4f5c\u539f\u7406\u975e\u5e38\u6709\u8da3\uff0c\u53ef\u4ee5\u4f18\u5316\u5f97\u5206\u3002\u533a\u522b\u5c31\u50cf\u9009\u62e9\u51b2\u523a\u548c\u9a6c\u62c9\u677e\u3002"}, {"question": "\u7eb8\u724c\u6e38\u620f\u5f15\u64ce\uff1a\u7eb8\u724c\u6e38\u620f\u5f15\u64ce\u4e2d\u4f7f\u7528\u7684\u7b97\u6cd5\u5982\u4f55\u751f\u6210\u53ef\u89e3\u6e38\u620f\uff0c\u4ee5\u53ca\u5b83\u4eec\u5728\u54ea\u4e9b\u9650\u5236\u4e0b\u8fd0\u884c\uff1f", "answer": "\u7eb8\u724c\u6e38\u620f\u5f15\u64ce\u4f7f\u7528\u5c1d\u8bd5\u751f\u6210\u53ef\u89e3\u6e38\u620f\u7684\u7b97\u6cd5\uff0c\u4f46\u65e0\u6cd5\u5b8c\u5168\u786e\u5b9a\u3002\u9650\u5236\u5305\u62ec\uff1a\u786e\u4fdd\u5408\u7406\u7684\u724c\u7684\u5206\u5e03\uff0c\u9075\u5faa\u53d1\u724c\u7684\u6e38\u620f\u89c4\u5219\uff0c\u4ee5\u53ca\u907f\u514d\u4ece\u4e00\u5f00\u59cb\u5c31\u6ce8\u5b9a\u4f1a\u5931\u8d25\u7684\u8bbe\u7f6e\u3002\u53ef\u89e3\u6027\u7b97\u6cd5\u53ef\u80fd\u4f1a\u4ece\u5df2\u89e3\u51b3\u7684\u72b6\u6001\u9006\u5411\u6d17\u724c\u6765\u751f\u6210\u65b0\u6e38\u620f\u3002\u8fd9\u4e9b\u7b97\u6cd5\u5c31\u50cf\u62fc\u56fe\u5236\u4f5c\u4eba\u4e00\u6837\uff0c\u5728\u9884\u5b9a\u4e49\u7684\u6e38\u620f\u89c4\u5219\u5185\u521b\u5efa\u6311\u6218\u3002"}, {"question": "\u8d85\u8d8a\u201c\u514b\u9686\u8fea\u514b\u201d\uff1a\u54ea\u4e9b\u662f\u6700\u6709\u8da3\u7684\u7eb8\u724c\u6e38\u620f\u53d8\u4f53\uff0c\u4ee5\u53ca\u5b83\u4eec\u72ec\u7279\u7684\u89c4\u5219\u96c6\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\u548c\u6218\u7565\u51b3\u7b56\uff1f", "answer": "\u9664\u4e86\u514b\u9686\u8fea\u514b\uff0c\u6709\u8da3\u7684\u7eb8\u724c\u6e38\u620f\u53d8\u4f53\u5305\u62ec\u8718\u86db\u7eb8\u724c\u3001\u5f17\u91cc\u8d5b\u5c14\u7eb8\u724c\u548c\u91d1\u5b57\u5854\u7eb8\u724c\u3002\u8fd9\u4e9b\u53d8\u4f53\u5728\u4ee5\u4e0b\u65b9\u9762\u6709\u6240\u4e0d\u540c\uff1a\u724c\u5806\u5e03\u5c40\u3001\u4f7f\u7528\u7684\u724c\u7ec4\u6570\u91cf\u3001\u79fb\u52a8\u724c\u7684\u89c4\u5219\u4ee5\u53ca\u83b7\u80dc\u6761\u4ef6\u3002\u8718\u86db\u7eb8\u724c\u9700\u8981\u5efa\u7acb\u76f8\u540c\u82b1\u8272\u7684\u5e8f\u5217\uff08\u96be\u5ea6\u66f4\u5927\uff09\uff0c\u800c\u5f17\u91cc\u8d5b\u5c14\u7eb8\u724c\u5219\u63d0\u4f9b\u7a7a\u95f2\u5355\u5143\u6765\u64cd\u4f5c\u724c\u3002\u66f4\u6539\u89c4\u5219\u4f1a\u663e\u7740\u5f71\u54cd\u96be\u5ea6\u3002\u73a9\u53d8\u4f53\u80fd\u591f\u5e26\u6765\u65b0\u7684\u601d\u8003\u3002\u6bcf\u4e2a\u53d8\u4f53\u90fd\u6d4b\u8bd5\u60a8\u89e3\u51b3\u62fc\u56fe\u6280\u80fd\u7684\u4e0d\u540c\u65b9\u9762\u3002\u53ef\u4ee5\u628a\u5b83\u770b\u4f5c\u5b66\u4e60\u4e0d\u540c\u7684\u8bed\u8a00\uff0c\u6bcf\u79cd\u8bed\u8a00\u90fd\u6709\u81ea\u5df1\u72ec\u7279\u7684\u7ed3\u6784\u3002"}, {"question": "\u8de8\u5e73\u53f0\u6e38\u620f\uff1a\u662f\u5426\u53ef\u4ee5\u5728\u4e0d\u540c\u7684\u64cd\u4f5c\u7cfb\u7edf\uff08iOS\u3001Android\u3001Windows\uff09\u4e4b\u95f4\u4f20\u8f93\u7eb8\u724c\u6e38\u620f\u8fdb\u5ea6\uff0c\u9700\u8981\u54ea\u4e9b\u6b65\u9aa4\uff1f", "answer": "\u5728\u4e0d\u540c\u7684\u64cd\u4f5c\u7cfb\u7edf\u5e73\u53f0\uff08iOS\u3001Android\u3001Windows\uff09\u4e4b\u95f4\u4f20\u8f93\u7eb8\u724c\u6e38\u620f\u8fdb\u5ea6\u53d6\u51b3\u4e8e\u5177\u4f53\u7684\u7eb8\u724c\u6e38\u620f\u3002\u901a\u5e38\u9700\u8981\uff1a\u8fde\u63a5\u5230\u6e38\u620f\u7684\u4e91\u540c\u6b65\u5e10\u6237\uff0c\u786e\u4fdd\u4f7f\u7528\u76f8\u540c\u7684\u5ba2\u6237\u7aef\u6e38\u620f\uff0c\u4ee5\u53ca\u9075\u5faa\u5e94\u7528\u7a0b\u5e8f\u4e2d\u7684\u6570\u636e\u4f20\u8f93\u8bf4\u660e\u3002\u90e8\u5206\u6e38\u620f\u4f7f\u7528Google Play Games\u5e10\u6237\u540c\u6b65\u8fdb\u5ea6\u3002\u68c0\u67e5\u60a8\u7684\u5e10\u6237\u8bbe\u7f6e\u3002\u6e38\u620f\u540c\u6b65\u5c31\u50cf\u5728\u4e91\u7aef\u62e5\u6709\u5168\u5c40\u4fdd\u5b58\u6587\u4ef6\u4e00\u6837\u3002"}, {"question": "\u7eb8\u724c\u6e38\u620f\u9690\u85cf\u6a21\u5f0f\uff1a\u7eb8\u724c\u6e38\u620f\u4e2d\u662f\u5426\u5b58\u5728\u4efb\u4f55\u9690\u85cf\u7684\u6e38\u620f\u6a21\u5f0f\u6216\u5f69\u86cb\u4f1a\u663e\u8457\u6539\u53d8\u6e38\u620f\u4f53\u9a8c\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9501\u5b83\u4eec\uff1f", "answer": "\u67d0\u4e9b\u7248\u672c\u7684\u7eb8\u724c\u6e38\u620f\u5305\u542b\u9690\u85cf\u7684\u6e38\u620f\u6a21\u5f0f\u6216\u5f69\u86cb\uff0c\u4f46\u8fd9\u4e9b\u6bd4\u8f83\u5c11\u89c1\u3002\u89e3\u9501\u5b83\u4eec\u901a\u5e38\u6d89\u53ca\uff1a\u5728\u6e38\u620f\u4e2d\u6267\u884c\u7279\u5b9a\u64cd\u4f5c\uff0c\u8f93\u5165\u79d8\u5bc6\u4ee3\u7801\u6216\u5728\u7279\u5b9a\u6761\u4ef6\u4e0b\u5b8c\u6210\u6311\u6218\u3002\u4f8b\u5982\uff0c\u65e7\u7248Windows\u7248\u672c\u53ef\u4ee5\u901a\u8fc7\u547d\u4ee4\u884c\u53c2\u6570\u8bbf\u95ee\u9690\u85cf\u6a21\u5f0f\u3002\u9690\u85cf\u7684\u6e38\u620f\u6a21\u5f0f/\u5f69\u86cb\u4f1a\u89e3\u9501\u4ee4\u4eba\u5174\u594b\u7684\u53d8\u4f53\u3002\u8fd9\u5c31\u50cf\u5728\u7ecf\u5178\u5e73\u53f0\u6e38\u620f\u4e2d\u627e\u5230\u79d8\u5bc6\u5173\u5361\u4e00\u6837\uff01"}, {"question": "\u7eb8\u724c\u6e38\u620f\u7b56\u7565\u6df1\u5165\u63a2\u8ba8\uff1a\u4e3a\u4ec0\u4e48\u9ad8\u7ea7\u7eb8\u724c\u6e38\u620f\u7b56\u7565\u4f18\u5148\u5728\u65e9\u671f\u89e3\u653e\u57fa\u7840\u724c\u5806\u69fd\u4f4d\uff0c\u4ee5\u53ca\u8fd9\u4e0e\u6574\u4f53\u83b7\u80dc\u7ed3\u679c\u6709\u4ec0\u4e48\u5173\u7cfb\uff1f", "answer": "\u9ad8\u7ea7\u7eb8\u724c\u6e38\u620f\u7b56\u7565\u5f3a\u8c03\u65e9\u671f\u5229\u7528\u57fa\u7840\u724c\u5806\u69fd\u4f4d\uff0c\u56e0\u4e3a\u5b83\u4e3a\u66f4\u957f\u7684\u8fd0\u884c\u521b\u5efa\u7a7a\u95f4\uff0c\u5e76\u589e\u52a0\u79fb\u52a8\u724c\u7684\u7075\u6d3b\u6027\u3002\u539f\u56e0\u662f\u53ef\u7528\u7684\u69fd\u4f4d\u8d8a\u591a\uff0c\u7ba1\u7406\u724c\u5e8f\u5217\u5c31\u8d8a\u5bb9\u6613\u3002\u6b65\u9aa41\uff1a\u5c3d\u53ef\u80fd\u591a\u5730\u66b4\u9732\u9690\u85cf\u7684\u724c\u3002\u6b65\u9aa42\uff1a\u4f18\u5148\u5c06A\u724c\u548c\u5c0f\u503c\u724c\u79fb\u52a8\u5230\u57fa\u7840\u724c\u5806\u3002\u6b65\u9aa43\uff1a\u8ba1\u5212\u79fb\u52a8\u4ee5\u6253\u5f00\u53ef\u4ee5\u586b\u5145\u6240\u9700\u724c\u7684\u7a7a\u4f4d\u3002\u89e3\u653e\u57fa\u7840\u724c\u5806\u69fd\u4f4d\u8f6c\u5316\u4e3a\u5bf9\u624b\u4e2d\u724c\u7684\u66f4\u5177\u6218\u7565\u6027\u7684\u7ba1\u7406\u3002\u8fd9\u5c31\u50cf\u5efa\u7acb\u4e00\u4e2a\u7269\u6d41\u7f51\u7edc\uff0c\u60a8\u9700\u8981\u5c3d\u53ef\u80fd\u591a\u7684\u4e2d\u8f6c\u7ad9\u6765\u79fb\u52a8\u60a8\u7684\u7269\u54c1\u3002"}]
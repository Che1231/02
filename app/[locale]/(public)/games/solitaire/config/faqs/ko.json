[{"question": "\uc194\ub9ac\ud14c\uc5b4 \uae30\ubcf8 \uc6d0\ub9ac: \uce74\ub4dc\ub97c \uc62c\ubc14\ub974\uac8c \ub098\ub204\ub294 \ubc29\ubc95\uacfc \ucd08\ubcf4\uc790\ub97c \uc704\ud55c \ub2e4\uc591\ud55c \ud14c\uc774\ube14 \uc313\uae30(Tableau) \uaddc\uce59\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc194\ub9ac\ud14c\uc5b4\uc5d0\uc11c \uce74\ub4dc\ub97c \ub098\ub204\ub294 \uac83\uc740 7\uac1c\uc758 \uc313\uae30 \uc601\uc5ed(Tableau)\uc744 \ub9cc\ub4dc\ub294 \uac83\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \uccab \ubc88\uc9f8 \uc313\uae30 \uc601\uc5ed\uc5d0\ub294 \ud55c \uc7a5\uc758 \uce74\ub4dc, \ub450 \ubc88\uc9f8 \uc313\uae30 \uc601\uc5ed\uc5d0\ub294 \ub450 \uc7a5\uc758 \uce74\ub4dc\uac00 \uc788\uace0, \uc774\ub7f0 \uc2dd\uc73c\ub85c \uc99d\uac00\ud569\ub2c8\ub2e4. \ucc98\uc74c\uc5d0\ub294 \uac01 \uc313\uae30 \uc601\uc5ed\uc758 \ub9e8 \uc704 \uce74\ub4dc\ub9cc \ubcf4\uc774\uace0, \ub098\uba38\uc9c0 \uce74\ub4dc\ub294 \uc2a4\ud0dd(Stock Pile)\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \ubaa9\ud45c\ub294 \ubaa8\ub4e0 \uce74\ub4dc\ub97c \ubb34\ub2ac\uc640 \uc22b\uc790 \uc21c\uc11c\ub300\ub85c \ubd84\ub958\ud558\uc5ec \uae30\ucd08 \uc313\uae30 \uc601\uc5ed(Foundation Pile)\uc73c\ub85c \uc774\ub3d9\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \ud14c\uc774\ube14 \uc313\uae30(Tableau) \uc601\uc5ed\uc740 \uac8c\uc784\uc758 \uc8fc\uc694 \ud654\uba74\uc774\ub77c\uace0 \uc0dd\uac01\ud558\uba74 \ub429\ub2c8\ub2e4. STEP1: 7\uac1c\uc758 \uc313\uae30 \uc601\uc5ed\uc744 \ub9cc\ub4ed\ub2c8\ub2e4. STEP2: \ub9e8 \uc704 \uce74\ub4dc\ub97c \ub4a4\uc9d1\uc2b5\ub2c8\ub2e4. STEP3: \ucd94\uac00 \uc774\ub3d9\uc744 \uc704\ud574 \uc2a4\ud0dd(Stockpile)\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ud14c\uc774\ube14 \uc313\uae30(Tableau) \ub808\uc774\uc544\uc6c3\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \uc194\ub9ac\ud14c\uc5b4 \ub9c8\uc2a4\ud130\ud558\ub294\ub370 \uc911\uc694\ud569\ub2c8\ub2e4. \ub9c8\uce58 \uacf5\uc5f0 \uc804\uc5d0 \ubb34\ub300\ub97c \uc138\ud305\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4."}, {"question": "\uc194\ub9ac\ud14c\uc5b4\uc5d0\uc11c \uc5b4\ub5a4 \uc774\ub3d9\uc774 \ub2e4\ub978 \uc774\ub3d9\ubcf4\ub2e4 \ub354 \uc88b\uc740 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \ub354 \ub098\uc740 \ud574\uacb0\ucc45\uc744 \ucc3e\uae30 \uc704\ud574 \ucd08\uae30 \uc194\ub9ac\ud14c\uc5b4 \uc124\uc815 \ud3c9\uac00\ub97c \uc5b4\ub5bb\uac8c \uac1c\uc120\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc194\ub9ac\ud14c\uc5b4\uc5d0\uc11c \ub354 \ub098\uc740 \uc774\ub3d9\uc740 \uce74\ub4dc \uc811\uadfc\uc131\uacfc \uae30\ucd08 \uc313\uae30 \uc601\uc5ed(Foundation) \uac00\ub2a5\uc131\uc744 \uace0\ub824\ud569\ub2c8\ub2e4. \uc228\uaca8\uc9c4 \uce74\ub4dc\ub97c \ub4dc\ub7ec\ub0b4\ub294 \uac83\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \uc88b\uc740 \uc774\ub3d9\uc785\ub2c8\ub2e4. \ubc88\uac08\uc544\uac00\uba70 \ub2e4\ub978 \uc0c9\uc0c1\uc758 \uce74\ub4dc\ub4e4\ub85c \ud14c\uc774\ube14 \uc313\uae30(Tableau)\uc758 \uc21c\uc11c\ub97c \ub9cc\ub4dc\ub294 \uac83\uc744 \uc120\ud638\ud569\ub2c8\ub2e4. \ud3c9\uac00 \uac1c\uc120\uc744 \uc704\ud574\uc11c\ub294: \uc811\uadfc \uac00\ub2a5\ud55c \uce74\ub4dc \uc6b0\uc120 \uc21c\uc704, \ube44\uc5b4 \uc788\ub294 \uc5f4(Column) \uc5f4\uae30, \ud544\uc694\ud55c \ud575\uc2ec \uce74\ub4dc \uc2dd\ubcc4\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \ube44\uc5b4 \uc788\ub294 \uc5f4(Column)\uc744 \uc77c\ucc0d \uc5f4\uba74 \ud0b9(King)\uacfc \uad00\ub828 \uce74\ub4dc\ub97c \uadf8 \uacf5\uac04\uc73c\ub85c \uc774\ub3d9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ucd08\uae30 \uc124\uc815\uc744 \ub2e8\uacc4\uc801\uc73c\ub85c \uaf3c\uaf3c\ud558\uac8c \ud3c9\uac00\ud558\uba74 \ub354 \ub098\uc740 \uc804\ub7b5\uc801 \uc120\ud0dd\uc744 \ub0b4\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud0d0\uc815 \uc18c\uc124\uc744 \uc77d\ub294 \uac83\ucc98\ub7fc \ucc98\uc74c\ubd80\ud130 \ub2e8\uc11c\ub97c \ucc3e\uc73c\uc138\uc694. \ube44\uc5b4 \uc788\ub294 \uc5f4(Column)\uc740 \ud070 \uc720\uc5f0\uc131\uc744 \uc81c\uacf5\ud558\uba70, \ub9c8\uce58 \uc640\uc77c\ub4dc \uce74\ub4dc(Wild Card)\ub97c \uac16\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4."}, {"question": "\u2018\ud074\ub860\ub2e4\uc774\ud06c\u2019 \uc194\ub9ac\ud14c\uc5b4 \uac8c\uc784\uc5d0\uc11c \uc2b9\ub9ac\ud560 \uac00\ub2a5\uc131\uc740 \uc5bc\ub9c8\ub098 \ub418\uba70, \uc774 \ud655\ub960\uc5d0 \ud070 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc694\uc778\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud45c\uc900 \ud074\ub860\ub2e4\uc774\ud06c \uc194\ub9ac\ud14c\uc5b4\uc758 \uc608\uc0c1 \uc2b9\ub960\uc740 \uc57d 43%\uc774\uc9c0\ub9cc, \uc774\ub294 \ub9e4\uc6b0 \ub2e4\uc591\ud558\uac8c \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \uc774\uc5d0 \ud070 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc694\uc778\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: \ucd08\uae30 \uce74\ub4dc \ubc30\ubd84(\ud2b9\uc815 \uc124\uc815\uc740 \uc808\ub300 \uc774\uae38 \uc218 \uc5c6\uc74c), \ud50c\ub808\uc774\uc5b4 \uae30\uc220(\uc804\ub7b5\uc801 \uc120\ud0dd\uc740 \uc131\uacf5\uc5d0 \uc601\ud5a5), \uaddc\uce59 \ubcc0\uacbd(\uc608: \ud55c \uc7a5\uc758 \uce74\ub4dc \ubf51\uae30 \ub300\uc2e0 \uc138 \uc7a5\uc758 \uce74\ub4dc \ubf51\uae30). \ud655\ub960\uc740 \uce74\ub4dc \ub371\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4. \uc88b\uc740 \uce74\ub4dc \ubd84\ud3ec\ub294 \uc131\uacf5 \uac00\ub2a5\uc131\uc744 \ub192\uc785\ub2c8\ub2e4. \uc2a4\ud0dd(stock)\uc744 \uc5ec\ub7ec \ubc88 \uc9c0\ub098\uac08 \uc218 \uc788\ub3c4\ub85d \ud558\ub294 \uac04\ub2e8\ud55c \ubcc0\ud615\uc740 \ub354 \uacf5\uc815\ud558\uace0 \ud3b8\uc548\ud55c \uac8c\uc784\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}, {"question": "\uc194\ub9ac\ud14c\uc5b4 \u2018\ub418\ub3cc\ub9ac\uae30\u2019 \uc804\ub7b5: \ud50c\ub808\uc774\uc5b4\uac00 \u2018\ub418\ub3cc\ub9ac\uae30\u2019 \uae30\ub2a5\uc744 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud574\uc57c \ud558\ub294 \uc2dc\uc810\uc740 \uc5b8\uc81c\uc774\uba70, \ubcf5\uc7a1\ud55c \uac8c\uc784 \uc0c1\ud669\uc5d0\uc11c \uc5b4\ub5bb\uac8c \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\ub098\uc694?", "answer": "\uc194\ub9ac\ud14c\uc5b4\uc5d0\uc11c \u2018\ub418\ub3cc\ub9ac\uae30\u2019 \uae30\ub2a5\uc740 \uc2e4\uc218\ub97c \ubc14\ub85c\uc7a1\uac70\ub098 \ub2e4\ub978 \uc774\ub3d9 \uc21c\uc11c\ub97c \uc2dc\ub3c4\ud558\ub294 \ub370 \uc720\uc6a9\ud569\ub2c8\ub2e4. \uc2b5\uad00\uc801\uc778 \uc758\uc874\uc744 \ud53c\ud558\uae30 \uc704\ud574 \ubcf4\uc218\uc801\uc73c\ub85c \uc0ac\uc6a9\ud574\uc57c \ud569\ub2c8\ub2e4. \ud6a8\uacfc\uc801\uc778 \uc0ac\uc6a9 \ubc29\ubc95\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc9c4\ucc99\uc744 \ub9c9\ub294 \uc774\ub3d9\uc744 \ub418\ub3cc\ub9ac\uae30, \uc228\uaca8\uc9c4 \uce74\ub4dc\ub97c \ub4dc\ub7ec\ub0b4\uae30 \uc704\ud55c \ub300\uc548\uc801 \uc774\ub3d9 \uc2dc\ub3c4, \uc6b0\ubc1c\uc801\uc778 \ud074\ub9ad\uc73c\ub85c\ubd80\ud130 \ud68c\ubcf5\ud558\uae30. \u2018\ub418\ub3cc\ub9ac\uae30\u2019\ub294 \ub418\ub3cc\ub9b4 \uc218 \uc5c6\ub294 \uc774\ub3d9\uc744 \ub9c9\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uae30\ucd08 \uc313\uae30 \uc601\uc5ed(Foundation)\uc73c\ub85c \uc774\ub3d9\ud574\uc57c \ud558\ub294 \uc911\uc694\ud55c \ud0b9(King) \uce74\ub4dc\ub97c \ub9c9\ub294 \uce74\ub4dc\ub97c \uc774\ub3d9\ud588\ub2e4\uba74, \u2018\ub418\ub3cc\ub9ac\uae30\u2019 \uae30\ub2a5\uc73c\ub85c \uac8c\uc784\uc744 \ubcf5\uad6c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \u2018\ub418\ub3cc\ub9ac\uae30\u2019\ub97c \uc2dc\uac04\uc744 \ub418\ub3cc\ub9ac\ub294 \uae30\ub2a5\ucc98\ub7fc \uc0dd\uac01\ud558\uba74 \ub450 \ubc88\uc9f8 \uc2dc\ub3c4\ub97c \ud560 \uc218 \uc788\uac8c \ud569\ub2c8\ub2e4."}, {"question": "\uc194\ub9ac\ud14c\uc5b4 \uc810\uc218 \uc2dc\uc2a4\ud15c: \ub2e4\uc591\ud55c \uc194\ub9ac\ud14c\uc5b4 \uc810\uc218 \uc2dc\uc2a4\ud15c(\ud45c\uc900, \ubca0\uac00\uc2a4)\uc740 \uac8c\uc784 \uc804\ub7b5\uacfc \uc804\uccb4 \ud50c\ub808\uc774\uc5b4 \uacbd\ud5d8\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "\uc194\ub9ac\ud14c\uc5b4\uc758 \ub2e4\uc591\ud55c \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uac8c\uc784 \uc804\ub7b5\uc744 \uadfc\ubcf8\uc801\uc73c\ub85c \ubc14\uafc9\ub2c8\ub2e4. \ud45c\uc900 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc18d\ub3c4\uc640 \ud6a8\uc728\uc131\uc744 \ubcf4\uc0c1\ud558\ub294 \ubc18\uba74, \ubca0\uac00\uc2a4 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ub9c8\uc774\ub108\uc2a4 \uc810\uc218\ub97c \ud53c\ud558\ub294 \ub370 \ucd08\uc810\uc744 \ub9de\ucda5\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4 \uacbd\ud5d8\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5: \ud45c\uc900 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ube60\ub978 \ud50c\ub808\uc774\ub97c \uc7a5\ub824\ud558\uace0, \ubca0\uac00\uc2a4 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc704\ud5d8\uc774 \ud070 \ub192\uc740 \ubcf4\uc0c1 \uc804\ub7b5\uc744 \ud3bc\uce58\uba74\uc11c \ubcf4\uc218\uc801\uc778 \ud50c\ub808\uc774\ub97c \uc7a5\ub824\ud569\ub2c8\ub2e4. \ud45c\uc900 \uc810\uc218 \uacc4\uc0b0\uc5d0\uc11c \ube60\ub974\uac8c \uce74\ub4dc\ub97c \uae30\ucd08 \uc313\uae30 \uc601\uc5ed(Foundation)\uc73c\ub85c \uc774\ub3d9\ud574\uc57c \ud569\ub2c8\ub2e4. \ubca0\uac00\uc2a4 \uc810\uc218 \uacc4\uc0b0 \ubc29\uc2dd\uc5d0\uc11c\ub294 \ud070 \uac10\uc810\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uc2b9\ub9ac\uc5d0\ub9cc \ucd08\uc810\uc744 \ub9de\ucd94\uc5b4\uc57c \ud569\ub2c8\ub2e4. \ub2e4\uc591\ud55c \uc810\uc218 \uc2dc\uc2a4\ud15c\uc5d0 \ub300\ud574 \uc774\ud574\ud558\ub294 \uac83\uc740 \uc810\uc218\ub97c \ucd5c\uc801\ud654\ud558\ub294 \ub370 \ud070 \uc7ac\ubbf8\ub97c \uc90d\ub2c8\ub2e4. \uc774 \ucc28\uc774\ub294 \uc2a4\ud504\ub9b0\ud2b8\uc640 \ub9c8\ub77c\ud1a4\uc744 \uc120\ud0dd\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4."}, {"question": "\uc194\ub9ac\ud14c\uc5b4 \uac8c\uc784 \uc5d4\uc9c4: \uc194\ub9ac\ud14c\uc5b4 \uac8c\uc784 \uc5d4\uc9c4\uc5d0\uc11c \uc0ac\uc6a9\ub418\ub294 \uc54c\uace0\ub9ac\uc998\uc740 \uc5b4\ub5bb\uac8c \ud480 \uc218 \uc788\ub294 \uac8c\uc784\uc744 \uc0dd\uc131\ud558\uba70, \uc5b4\ub5a4 \uc81c\uc57d \uc870\uac74 \ud558\uc5d0\uc11c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "\uc194\ub9ac\ud14c\uc5b4 \uac8c\uc784 \uc5d4\uc9c4\uc740 \ud480 \uc218 \uc788\ub294 \uac8c\uc784\uc744 \uc0dd\uc131\ud558\ub824\uace0 \ud558\uc9c0\ub9cc, \uc644\ubcbd\ud55c \ud655\uc2e4\uc131\uc744 \ubcf4\uc7a5\ud560 \uc218\ub294 \uc5c6\uc2b5\ub2c8\ub2e4. \uc81c\uc57d\uc0ac\ud56d\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: \uce74\ub4dc\uc758 \ud569\ub9ac\uc801\uc778 \ubc30\ubd84\uc744 \ubcf4\uc7a5\ud558\uae30, \uce74\ub4dc \ub098\ub204\ub294 \uaddc\uce59 \ub530\ub974\uae30, \ucc98\uc74c\ubd80\ud130 \uc190\uc2e4\uc774 \ud655\uc2e4\ud55c \uc124\uc815 \ubc29\uc9c0\ud558\uae30. \uc194\ub8e8\uc158 \uc54c\uace0\ub9ac\uc998\uc740 \ud480\ub9b0 \uc0c1\ud0dc\uc758 \uce74\ub4dc\ub97c \uc5ed\uc21c\uc73c\ub85c \uc11e\uc5b4 \uc0c8\ub85c\uc6b4 \uac8c\uc784\uc744 \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc54c\uace0\ub9ac\uc998\uc740 \ubbf8\ub9ac \uc815\uc758\ub41c \uac8c\uc784 \uaddc\uce59 \ub0b4\uc5d0\uc11c \ud37c\uc990\uc744 \ub9cc\ub4dc\ub294 \uc0ac\ub78c\uacfc \uac19\uc2b5\ub2c8\ub2e4."}, {"question": "\u2018\ud074\ub860\ub2e4\uc774\ud06c\u2019 \uc678\uc5d0 \uac00\uc7a5 \ud765\ubbf8\ub85c\uc6b4 \uc194\ub9ac\ud14c\uc5b4 \ubcc0\ud615 \uac8c\uc784\uc740 \ubb34\uc5c7\uc774\uba70, \uadf8 \uace0\uc720\ud55c \uaddc\uce59\uc740 \uac8c\uc784 \ud50c\ub808\uc774\uc640 \uc804\ub7b5\uc801 \uacb0\uc815\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "\ud074\ub860\ub2e4\uc774\ud06c \uc678\uc5d0 \ud765\ubbf8\ub85c\uc6b4 \uc194\ub9ac\ud14c\uc5b4 \ubcc0\ud615 \uac8c\uc784\uc73c\ub85c\ub294 \uc2a4\ud30c\uc774\ub354 \uc194\ub9ac\ud14c\uc5b4, \ud504\ub9ac\uc140, \ud53c\ub77c\ubbf8\ub4dc\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ubcc0\ud615 \uac8c\uc784\uc740 \ub2e4\uc74c\uacfc \uac19\uc774 \ub2e4\ub985\ub2c8\ub2e4: \ud14c\uc774\ube14 \uc313\uae30(Tableau) \ub808\uc774\uc544\uc6c3, \uc0ac\uc6a9\ub41c \uce74\ub4dc \ub371 \uc218, \uce74\ub4dc \uc774\ub3d9 \uaddc\uce59, \uc2b9\ub9ac \uc870\uac74. \uc2a4\ud30c\uc774\ub354 \uc194\ub9ac\ud14c\uc5b4\ub294 \uac19\uc740 \ubb34\ub2ac\uc758 \uce74\ub4dc\ub97c \uc313\ub294 \uac83(\ud6e8\uc52c \uc5b4\ub824\uc6c0)\uc774\uba70, \ud504\ub9ac\uc140\uc740 \uce74\ub4dc\ub97c \uc774\ub3d9\ud558\uae30 \uc704\ud55c \uc790\uc720 \uc5f4(Free Cell)\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uaddc\uce59\uc744 \ubcc0\uacbd\ud558\uba74 \uc5b4\ub824\uc6c0\uc774 \ud06c\uac8c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4. \ubcc0\ud615 \uac8c\uc784\uc744 \ud50c\ub808\uc774\ud558\uba74 \uc0c8\ub85c\uc6b4 \uc0ac\uace0 \ubc29\uc2dd\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac01 \ubcc0\ud615\uc740 \ud37c\uc990 \ud480\uc774 \ub2a5\ub825\uc758 \ub2e4\ub978 \uce21\uba74\uc744 \uc2dc\ud5d8\ud569\ub2c8\ub2e4. \uc774\uac83\uc740 \uac01\uac01 \uace0\uc720\ud55c \uad6c\uc870\ub97c \uac00\uc9c4 \ub2e4\ub978 \uc5b8\uc5b4\ub97c \ubc30\uc6b0\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4."}, {"question": "\ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c\uc758 \ud50c\ub808\uc774: \uc194\ub9ac\ud14c\uc5b4 \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\ub978 \uc6b4\uc601 \uccb4\uc81c(iOS, \uc548\ub4dc\ub85c\uc774\ub4dc, \uc708\ub3c4\uc6b0) \uac04\uc5d0 \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694? \ud544\uc694\ud55c \ub2e8\uacc4\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub2e4\uc591\ud55c \uc6b4\uc601 \uccb4\uc81c(iOS, \uc548\ub4dc\ub85c\uc774\ub4dc, \uc708\ub3c4\uc6b0) \uac04\uc5d0 \uc194\ub9ac\ud14c\uc5b4 \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669 \uc774\ub3d9 \uac00\ub2a5 \uc5ec\ubd80\ub294 \ud2b9\uc815 \uc194\ub9ac\ud14c\uc5b4 \uac8c\uc784\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc73c\ub85c \ub2e4\uc74c\uc774 \ud544\uc694\ud569\ub2c8\ub2e4: \uac8c\uc784\uc5d0 \uc5f0\uacb0\ub41c \ud074\ub77c\uc6b0\ub4dc \ub3d9\uae30\ud654 \uacc4\uc815 \ubcf4\uc720, \ub3d9\uc77c\ud55c \uac8c\uc784 \ud074\ub77c\uc774\uc5b8\ud2b8\ub97c \ub450 \uae30\uae30 \ubaa8\ub450\uc5d0\uc11c \uc0ac\uc6a9, \ub370\uc774\ud130 \uc804\uc1a1\uc744 \uc704\ud55c \uc571 \ub0b4 \uc9c0\uce68 \ub530\ub974\uae30. \uc77c\ubd80 \uac8c\uc784\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669 \ub3d9\uae30\ud654\ub294 Google Play \uac8c\uc784 \uacc4\uc815\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uacc4\uc815 \uc124\uc815\uc744 \ud655\uc778\ud558\uc138\uc694. \uac8c\uc784 \ub3d9\uae30\ud654\ub294 \ud074\ub77c\uc6b0\ub4dc\uc5d0 \uae00\ub85c\ubc8c \uc800\uc7a5 \ud30c\uc77c\uc744 \uac00\uc9c4 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4."}, {"question": "\uc194\ub9ac\ud14c\uc5b4 \uc228\uaca8\uc9c4 \ubaa8\ub4dc: \uc194\ub9ac\ud14c\uc5b4\uc5d0\ub294 \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \ud06c\uac8c \ubc14\uafb8\ub294 \uc228\uaca8\uc9c4 \uac8c\uc784 \ubaa8\ub4dc\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\ub098\uc694? \uc5b4\ub5bb\uac8c \ud574\uc81c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc77c\ubd80 \uc194\ub9ac\ud14c\uc5b4 \ubc84\uc804\uc5d0\ub294 \uc228\uaca8\uc9c4 \uac8c\uc784 \ubaa8\ub4dc\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc9c0\ub9cc, \ub4dc\ubb3c\uac8c \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uae30\ub2a5\uc744 \ud574\uc81c\ud558\ub294 \ub370\ub294 \ub2e4\uc74c\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4: \uac8c\uc784 \ub0b4 \ud2b9\uc815 \ub3d9\uc791 \uc218\ud589, \ube44\ubc00 \ucf54\ub4dc \uc785\ub825, \ud2b9\uc815 \uc870\uac74 \ud558\uc5d0\uc11c \ucc4c\ub9b0\uc9c0 \uc644\ub8cc. \uc608\ub97c \ub4e4\uc5b4, \uc774\uc804 \uc708\ub3c4\uc6b0 \ubc84\uc804\uc5d0\ub294 \uba85\ub839\uc904 \uc778\uc218\ub97c \ud1b5\ud574 \uc228\uaca8\uc9c4 \ubaa8\ub4dc\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\uc5c8\uc2b5\ub2c8\ub2e4. \uc228\uaca8\uc9c4 \uac8c\uc784 \ubaa8\ub4dc/\uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ud765\ubbf8\ub85c\uc6b4 \ubcc0\ud615\uc744 \ud480\uc5b4\uc90d\ub2c8\ub2e4. \ub9c8\uce58 \ud074\ub798\uc2dd \ud50c\ub7ab\ud3ec\uba38 \uac8c\uc784\uc5d0\uc11c \ube44\ubc00 \ub808\ubca8\uc744 \ubc1c\uacac\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4!"}, {"question": "\uc194\ub9ac\ud14c\uc5b4 \uc804\ub7b5 \uc2ec\uce35 \ubd84\uc11d: \uace0\uae09 \uc194\ub9ac\ud14c\uc5b4 \uc804\ub7b5\uc740 \uc65c \uae30\ucd08 \uc313\uae30 \uc601\uc5ed(Foundation) \uacf5\uac04\uc744 \uc77c\ucc0d \ud655\ubcf4\ud558\ub294 \uac83\uc744 \uc6b0\uc120\uc2dc\ud558\uba70, \uc774\ub294 \uc804\uccb4\uc801\uc778 \uc2b9\ub9ac \uacb0\uacfc\uc640 \uc5b4\ub5a4 \uad00\ub828\uc774 \uc788\ub098\uc694?", "answer": "\uace0\uae09 \uc194\ub9ac\ud14c\uc5b4 \uc804\ub7b5\uc740 \ucd08\uae30 \uae30\ucd08 \uc313\uae30 \uc601\uc5ed(Foundation) \ud65c\uc6a9\uc744 \uc911\uc2dc\ud569\ub2c8\ub2e4. \uc774\ub294 \ub354 \uae34 \uc2dc\ud000\uc2a4\ub97c \ub9cc\ub4e4\uace0 \uce74\ub4dc \uc774\ub3d9\uc5d0 \ub300\ud55c \uc720\uc5f0\uc131\uc744 \ub192\uc774\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \ub354 \ub9ce\uc740 \uacf5\uac04\uc774 \ud655\ubcf4\ub418\uba74, \uce74\ub4dc \uc2dc\ud000\uc2a4\ub97c \uad00\ub9ac\ud558\uae30\uac00 \ud6e8\uc52c \uc26c\uc6cc\uc9d1\ub2c8\ub2e4. Step 1: \uac00\ub2a5\ud55c \ud55c \ub9ce\uc740 \uc228\uaca8\uc9c4 \uce74\ub4dc\ub97c \ub4dc\ub7ec\ub0b4\uc138\uc694. Step 2: \uc5d0\uc774\uc2a4\uc640 \ub0ae\uc740 \uac00\uce58\uc758 \uce74\ub4dc\ub97c \uae30\ucd08 \uc313\uae30 \uc601\uc5ed(Foundation)\uc73c\ub85c \uc62e\uae30\ub294 \uac83\uc744 \uc6b0\uc120\uc2dc\ud558\uc138\uc694. Step 3: \ud544\uc694\ud55c \uce74\ub4dc\ub85c \ucc44\uc6b8 \uc218 \uc788\ub294 \uacf5\uac04\uc744 \uc5f4 \uc218 \uc788\ub3c4\ub85d \uc774\ub3d9 \uacc4\ud68d\uc744 \uc138\uc6b0\uc138\uc694. \uae30\ucd08 \uc313\uae30 \uc601\uc5ed(Foundation) \uacf5\uac04\uc744 \ud655\ubcf4\ud558\ub294 \uac83\uc740 \uc190\uc5d0 \ub4e4\uace0 \uc788\ub294 \uce74\ub4dc\ub97c \ub354 \uc804\ub7b5\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ub9c8\uce58 \ubb3c\uc790\ub97c \uc62e\uae30\uae30 \uc704\ud55c \ubb3c\ub958 \ub124\ud2b8\uc6cc\ud06c\ub97c \uad6c\ucd95\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ub354 \ub9ce\uc740 \uc911\uac04 \uc9c0\uc810\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."}]
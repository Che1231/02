[{"question": "\u4f5c\u4e3a\u65b0\u73a9\u5bb6\uff0c\u6211\u8be5\u5982\u4f55\u5feb\u901f\u4e0a\u624bStarBlast.io\uff1f", "answer": "\u8981\u5f00\u59cb\u73a9StarBlast.io\uff0c\u9996\u5148\u9009\u62e9\u50cfDelta\u6218\u6597\u673a\u8fd9\u6837\u7684\u57fa\u7840\u98de\u8239\uff0c\u5b83\u62e5\u6709\u5e73\u8861\u7684\u5c5e\u6027\u3002\u4f7f\u7528WASD\u952e\u79fb\u52a8\uff0c\u9f20\u6807\u7784\u51c6\u548c\u5c04\u51fb\u3002\u4e13\u6ce8\u4e8e\u6536\u96c6\u5c0f\u884c\u661f\u4e0a\u7684\u5b9d\u77f3\u6765\u5347\u7ea7\u4f60\u7684\u98de\u8239\u3002\u4f8b\u5982\uff0c\u65e9\u671f\u5347\u7ea7\u5e94\u8be5\u4f18\u5148\u8003\u8651\u63d0\u9ad8\u98de\u8239\u7684\u901f\u5ea6\u548c\u706b\u529b\uff0c\u4ee5\u5e94\u5bf9\u521d\u59cb\u906d\u9047\u3002\u8bb0\u4f4f\uff0c\u8981\u505c\u7559\u5728\u5730\u56fe\u4e2d\u5fc3\u9644\u8fd1\uff0c\u90a3\u91cc\u8d44\u6e90\u66f4\u4e30\u5bcc\u3002"}, {"question": "\u5728StarBlast.io\u4e2d\uff0c\u6211\u9700\u8981\u638c\u63e1\u54ea\u4e9b\u5173\u952e\u63a7\u5236\uff1f", "answer": "StarBlast.io\u4e2d\u7684\u5173\u952e\u63a7\u5236\u5305\u62ec\u79fb\u52a8\uff08WASD\uff09\u3001\u7784\u51c6\u548c\u5c04\u51fb\uff08\u9f20\u6807\uff09\u4ee5\u53ca\u4f7f\u7528\u7279\u6b8a\u80fd\u529b\uff08\u7a7a\u683c\u952e\uff09\u3002\u4f8b\u5982\uff0c\u638c\u63e1\u7a7a\u683c\u952e\u7684\u4f7f\u7528\uff0c\u4f8b\u5982Delta\u6218\u6597\u673a\u52a0\u901f\u80fd\u529b\uff0c\u53ef\u4ee5\u5e2e\u52a9\u4f60\u6446\u8131\u5371\u9669\u5c40\u9762\u3002\u7ec3\u4e60\u5728\u5c0f\u884c\u661f\u548c\u654c\u65b9\u706b\u529b\u5468\u56f4\u673a\u52a8\uff0c\u4ee5\u63d0\u9ad8\u4f60\u7684\u6e38\u620f\u6548\u7387\u3002"}, {"question": "\u5728StarBlast.io\u4e2d\uff0c\u5347\u7ea7\u6211\u7684\u98de\u8239\u4e3a\u4ec0\u4e48\u91cd\u8981\uff1f", "answer": "\u5728StarBlast.io\u4e2d\u5347\u7ea7\u4f60\u7684\u98de\u8239\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u53ef\u4ee5\u63d0\u5347\u4f60\u7684\u98de\u8239\u5c5e\u6027\uff0c\u4f8b\u5982\u901f\u5ea6\u3001\u706b\u529b\u548c\u8010\u4e45\u6027\u3002\u4f8b\u5982\uff0c\u5347\u7ea7Delta\u6218\u6597\u673a\u7684\u901f\u5ea6\u53ef\u4ee5\u8ba9\u4f60\u5728\u654c\u4eba\u9762\u524d\u5b8c\u6210\u673a\u52a8\uff0c\u800c\u589e\u52a0\u706b\u529b\u53ef\u4ee5\u66f4\u5feb\u5730\u51fb\u8d25\u654c\u4eba\u3002\u59cb\u7ec8\u4f18\u5148\u5347\u7ea7\u90a3\u4e9b\u80fd\u8865\u5145\u4f60\u6e38\u620f\u98ce\u683c\u548c\u5f53\u524d\u6e38\u620f\u5c40\u52bf\u7684\u5347\u7ea7\u3002"}, {"question": "\u5728\u73a9StarBlast.io\u8d85\u8fc7100\u5c0f\u65f6\u540e\uff0c\u6211\u5e94\u8be5\u4f7f\u7528\u54ea\u4e9b\u9ad8\u7ea7\u7b56\u7565\uff1f", "answer": "\u5728StarBlast.io\u4e2d\u73a9\u8d85\u8fc7100\u5c0f\u65f6\u540e\uff0c\u4e13\u6ce8\u4e8e\u9ad8\u7ea7\u7b56\u7565\uff0c\u4f8b\u5982\u98de\u8239\u4e13\u4e1a\u5316\u548c\u5730\u56fe\u63a7\u5236\u3002\u4f8b\u5982\uff0c\u9009\u62e9\u50cf\u5f71\u5b50X-1\u8fd9\u6837\u7684\u98de\u8239\uff0c\u4ee5\u8fdb\u884c\u9690\u853d\u548c\u4f0f\u51fb\u6218\u672f\u3002\u6b65\u9aa4\u4e00\uff1a\u8ba9\u81ea\u5df1\u5904\u4e8e\u9ad8\u6d41\u91cf\u533a\u57df\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u4f60\u98de\u8239\u7684\u72ec\u7279\u80fd\u529b\u6765\u4ee4\u654c\u4eba\u63aa\u624b\u4e0d\u53ca\u3002\u6b65\u9aa4\u4e09\uff1a\u5229\u7528\u9644\u8fd1\u7684\u5c0f\u884c\u661f\u64a4\u9000\u5e76\u6062\u590d\u5065\u5eb7\u3002\u8fd9\u79cd\u65b9\u6cd5\u53ef\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u4f60\u7684\u6548\u7387\u5e76\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u98ce\u9669\u3002"}, {"question": "\u5982\u4f55\u5728StarBlast.io\u4e2d\u6709\u6548\u5730\u63a7\u5236\u5730\u56fe\uff1f", "answer": "\u8981\u5728StarBlast.io\u4e2d\u63a7\u5236\u5730\u56fe\uff0c\u5c31\u8981\u63a7\u5236\u5173\u952e\u8d44\u6e90\u533a\u548c\u74f6\u9888\u5730\u5e26\u3002\u4f8b\u5982\uff0c\u5c06\u4f60\u7684\u98de\u8239\u505c\u653e\u5728\u5927\u578b\u5c0f\u884c\u661f\u7fa4\u9644\u8fd1\uff0c\u4ee5\u6536\u96c6\u5b9d\u77f3\u5e76\u4f0f\u51fb\u654c\u4eba\u3002\u4f7f\u7528\u5177\u6709\u9ad8\u673a\u52a8\u6027\u548c\u706b\u529b\u7684\u98de\u8239\uff0c\u4f8b\u5982\u72c2\u66b4\u4e4b\u661f\uff0c\u4ee5\u6709\u6548\u5de1\u903b\u8fd9\u4e9b\u533a\u57df\u3002\u59cb\u7ec8\u7559\u610f\u654c\u4eba\u7684\u884c\u52a8\uff0c\u5e76\u76f8\u5e94\u5730\u8c03\u6574\u4f60\u7684\u4f4d\u7f6e\u3002"}, {"question": "\u5728StarBlast.io\u7684\u56e2\u961f\u6e38\u620f\u4e2d\uff0c\u54ea\u4e9b\u6700\u4f73\u98de\u8239\u7ec4\u5408\uff1f", "answer": "\u5728StarBlast.io\u7684\u56e2\u961f\u6e38\u620f\u4e2d\uff0c\u7ec4\u5408\u5177\u6709\u4e92\u8865\u80fd\u529b\u7684\u98de\u8239\u3002\u4f8b\u5982\uff0c\u5c06\u50cf\u6cf0\u5766\u8fd9\u6837\u7684\u9632\u5fa1\u578b\u98de\u8239\u4e0e\u50cf\u5e7d\u7075\u8fd9\u6837\u7684\u9ad8\u4f24\u5bb3\u8f93\u51fa\u98de\u8239\u7ec4\u5408\u3002\u6cf0\u5766\u5438\u6536\u4f24\u5bb3\uff0c\u800c\u5e7d\u7075\u5219\u4e13\u6ce8\u4e8e\u6d88\u706d\u654c\u4eba\u3002\u6c9f\u901a\u548c\u534f\u8c03\u662f\u6700\u5927\u9650\u5ea6\u5730\u53d1\u6325\u8fd9\u4e9b\u7ec4\u5408\u6548\u679c\u7684\u5173\u952e\u3002"}, {"question": "StarBlast.io\u4e2d\u7684\u98de\u8239\u5347\u7ea7\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "StarBlast.io\u4e2d\u7684\u98de\u8239\u5347\u7ea7\u7cfb\u7edf\u5141\u8bb8\u4f60\u4f7f\u7528\u4ece\u5c0f\u884c\u661f\u6536\u96c6\u7684\u5b9d\u77f3\u6765\u589e\u5f3a\u4f60\u7684\u98de\u8239\u5c5e\u6027\u3002\u6bcf\u8258\u98de\u8239\u90fd\u6709\u4e00\u4e2a\u72ec\u7279\u7684\u5347\u7ea7\u6811\u3002\u4f8b\u5982\uff0cDelta\u6218\u6597\u673a\u53ef\u4ee5\u5347\u7ea7\u5b83\u7684\u901f\u5ea6\u3001\u706b\u529b\u548c\u8010\u4e45\u6027\u3002\u5347\u7ea7\u5728\u6574\u4e2a\u6bd4\u8d5b\u671f\u95f4\u90fd\u662f\u6c38\u4e45\u6027\u7684\uff0c\u56e0\u6b64\u6839\u636e\u4f60\u7684\u7b56\u7565\u548c\u6e38\u620f\u7684\u8fdb\u5c55\u660e\u667a\u5730\u9009\u62e9\u3002"}, {"question": "StarBlast.io\u4e2d\u98de\u8239\u8010\u4e45\u6027\u7684\u57fa\u672c\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "StarBlast.io\u4e2d\u98de\u8239\u7684\u8010\u4e45\u6027\u7531\u98de\u8239\u7684\u57fa\u672c\u751f\u547d\u503c\u548c\u5347\u7ea7\u51b3\u5b9a\u3002\u4f8b\u5982\uff0c\u6cf0\u5766\u62e5\u6709\u9ad8\u57fa\u672c\u751f\u547d\u503c\uff0c\u4f7f\u5176\u66f4\u8010\u7528\u3002\u8010\u4e45\u6027\u53ef\u4ee5\u901a\u8fc7\u5347\u7ea7\u6765\u63d0\u9ad8\uff0c\u4f46\u4e5f\u4f1a\u53d7\u5230\u654c\u65b9\u706b\u529b\u548c\u78b0\u649e\u7684\u5f71\u54cd\u3002\u7ba1\u7406\u4f60\u7684\u98de\u8239\u7684\u8010\u4e45\u6027\u5305\u62ec\u5e73\u8861\u8fdb\u653b\u548c\u9632\u5fa1\uff0c\u4f8b\u5982\u5728\u5fc5\u8981\u65f6\u64a4\u9000\u4ee5\u6062\u590d\u5065\u5eb7\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e0a\u8f6c\u79fbStarBlast.io\u4e2d\u7684\u6e38\u620f\u8fdb\u5ea6\u5417\uff1f", "answer": "\u76ee\u524d\uff0cStarBlast.io\u4e0d\u652f\u6301\u8de8\u5e73\u53f0\u6e38\u620f\u8fdb\u5ea6\u8f6c\u79fb\u3002\u6bcf\u4e2a\u5e73\u53f0\uff08\u4f8b\u5982PC\u3001\u79fb\u52a8\u8bbe\u5907\uff09\u90fd\u7ef4\u62a4\u72ec\u7acb\u7684\u6e38\u620f\u6570\u636e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728PC\u548c\u79fb\u52a8\u8bbe\u5907\u4e0a\u73a9\uff0c\u4f60\u9700\u8981\u5728\u6bcf\u4e2a\u5e73\u53f0\u4e0a\u91cd\u65b0\u5f00\u59cb\u3002\u8bf7\u786e\u4fdd\u4f60\u767b\u5f55\u4e86\u6b63\u786e\u7684\u8d26\u6237\uff0c\u4ee5\u907f\u514d\u4e22\u5931\u8fdb\u5ea6\u3002"}, {"question": "StarBlast.io\u4e2d\u662f\u5426\u5b58\u5728\u4efb\u4f55\u9690\u85cf\u7684\u5f69\u86cb\u6216\u79d8\u5bc6\uff1f", "answer": "\u662f\u7684\uff0cStarBlast.io\u4e2d\u5b58\u5728\u9690\u85cf\u7684\u5f69\u86cb\uff0c\u4f8b\u5982\u7a00\u6709\u98de\u8239\u76ae\u80a4\u548c\u79d8\u5bc6\u5c0f\u884c\u661f\u7ed3\u6784\u3002\u4f8b\u5982\uff0c\u4e00\u4e9b\u73a9\u5bb6\u62a5\u544a\u53d1\u73b0\u4e86\u4e00\u79cd\u72ec\u7279\u7684\u80fd\u663e\u793a\u9690\u85cf\u5b9d\u77f3\u7c07\u7684\u5c0f\u884c\u661f\u3002\u5f7b\u5e95\u63a2\u7d22\u5730\u56fe\u5e76\u5c1d\u8bd5\u4f7f\u7528\u4e0d\u540c\u7684\u98de\u8239\u53ef\u80fd\u4f1a\u53d1\u73b0\u8fd9\u4e9b\u79d8\u5bc6\u3002"}]
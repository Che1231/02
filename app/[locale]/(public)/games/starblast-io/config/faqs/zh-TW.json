[{"question": "\u5982\u4f55\u5feb\u901f\u4e0a\u624b StarBlast.io \u65b0\u624b\u73a9\u5bb6?", "answer": "\u8981\u958b\u59cb\u5728 StarBlast.io \u4e2d\u904a\u6232\uff0c\u9996\u5148\u9078\u64c7\u4e00\u8258\u57fa\u790e\u8266\u8247\uff0c\u4f8b\u5982 Delta \u6230\u9b25\u6a5f\uff0c\u5176\u5e73\u8861\u7684\u5c6c\u6027\u9069\u5408\u65b0\u624b\u3002\u4f7f\u7528 WASD \u9375\u79fb\u52d5\uff0c\u6ed1\u9f20\u7784\u6e96\u548c\u5c04\u64ca\u3002\u5c08\u6ce8\u65bc\u6536\u96c6\u5c0f\u884c\u661f\u4e0a\u7684\u5bf6\u77f3\u4f86\u5347\u7d1a\u4f60\u7684\u8266\u8247\u3002\u4f8b\u5982\uff0c\u521d\u671f\u5347\u7d1a\u61c9\u512a\u5148\u8003\u616e\u63d0\u5347\u8266\u8247\u7684\u901f\u5ea6\u548c\u706b\u529b\uff0c\u4ee5\u61c9\u5c0d\u521d\u59cb\u906d\u9047\u6230\u3002\u8a18\u4f4f\uff0c\u7559\u5728\u5730\u5716\u4e2d\u5fc3\u9644\u8fd1\uff0c\u90a3\u88e1\u8cc7\u6e90\u66f4\u8c50\u5bcc\u3002"}, {"question": "\u5728 StarBlast.io \u4e2d\uff0c\u54ea\u4e9b\u95dc\u9375\u63a7\u5236\u9700\u8981\u638c\u63e1?", "answer": "StarBlast.io \u4e2d\u7684\u95dc\u9375\u63a7\u5236\u5305\u62ec\u79fb\u52d5\uff08WASD\uff09\u3001\u7784\u6e96\u548c\u5c04\u64ca\uff08\u6ed1\u9f20\uff09\u4ee5\u53ca\u4f7f\u7528\u7279\u6b8a\u80fd\u529b\uff08\u7a7a\u683c\u9375\uff09\u3002\u4f8b\u5982\uff0c\u638c\u63e1\u7a7a\u683c\u9375\u7684\u4f7f\u7528\uff0c\u4f8b\u5982 Delta \u6230\u9b25\u6a5f\u7684\u901f\u5ea6\u63d0\u5347\uff0c\u53ef\u4ee5\u5e6b\u52a9\u4f60\u9003\u96e2\u5371\u96aa\u60c5\u6cc1\u3002\u7df4\u7fd2\u5728\u5c0f\u884c\u661f\u548c\u6575\u65b9\u706b\u529b\u5468\u570d\u8ff4\u907f\uff0c\u4ee5\u63d0\u9ad8\u904a\u6232\u6548\u7387\u3002"}, {"question": "\u5728 StarBlast.io \u4e2d\u5347\u7d1a\u6211\u7684\u8266\u8247\u5f88\u91cd\u8981\u55ce\uff1f\u70ba\u4ec0\u9ebc\uff1f", "answer": "\u5728 StarBlast.io \u4e2d\u5347\u7d1a\u4f60\u7684\u8266\u8247\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u53ef\u4ee5\u63d0\u5347\u4f60\u7684\u8266\u8247\u5c6c\u6027\uff0c\u4f8b\u5982\u901f\u5ea6\u3001\u706b\u529b\u548c\u8010\u4e45\u5ea6\u3002\u4f8b\u5982\uff0c\u5347\u7d1a Delta \u6230\u9b25\u6a5f\u7684\u901f\u5ea6\u53ef\u4ee5\u8b93\u4f60\u66f4\u9748\u6d3b\u5730\u8ff4\u907f\u6575\u4eba\uff0c\u800c\u589e\u52a0\u706b\u529b\u5247\u53ef\u4ee5\u8b93\u4f60\u66f4\u5feb\u5730\u64ca\u6557\u4ed6\u5011\u3002\u59cb\u7d42\u512a\u5148\u5347\u7d1a\u90a3\u4e9b\u8207\u4f60\u7684\u904a\u6232\u98a8\u683c\u548c\u7576\u524d\u904a\u6232\u72c0\u6cc1\u76f8\u7b26\u7684\u5347\u7d1a\u3002"}, {"question": "\u5728\u73a9\u4e86\u8d85\u904e 100 \u5c0f\u6642\u7684 StarBlast.io \u5f8c\uff0c\u6211\u61c9\u8a72\u4f7f\u7528\u54ea\u4e9b\u5148\u9032\u7b56\u7565\uff1f", "answer": "\u5728 StarBlast.io \u73a9\u8d85\u904e 100 \u5c0f\u6642\u5f8c\uff0c\u61c9\u5c08\u6ce8\u65bc\u5148\u9032\u7b56\u7565\uff0c\u4f8b\u5982\u8266\u8247\u5c08\u696d\u5316\u548c\u5730\u5716\u63a7\u5236\u3002\u4f8b\u5982\uff0c\u9078\u64c7\u50cf Shadow X-1 \u9019\u6a23\u7684\u8266\u8247\uff0c\u4ee5\u9032\u884c\u96b1\u853d\u548c\u4f0f\u64ca\u6230\u8853\u3002\u6b65\u9a5f 1\uff1a\u5c07\u81ea\u5df1\u7f6e\u65bc\u4eba\u6d41\u91cf\u5927\u7684\u5340\u57df\u3002\u6b65\u9a5f 2\uff1a\u5229\u7528\u4f60\u7684\u8266\u8247\u7368\u7279\u80fd\u529b\u4f86\u7d66\u6575\u4eba\u5e36\u4f86\u9a5a\u559c\u3002\u6b65\u9a5f 3\uff1a\u4f7f\u7528\u9644\u8fd1\u7684\u9695\u77f3\u64a4\u9000\u548c\u6062\u5fa9\u3002\u9019\u7a2e\u65b9\u6cd5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u4e86\u4f60\u7684\u6548\u7387\u4e26\u5c07\u98a8\u96aa\u964d\u81f3\u6700\u4f4e\u3002"}, {"question": "\u5982\u4f55\u5728 StarBlast.io \u4e2d\u6709\u6548\u5730\u63a7\u5236\u5730\u5716\uff1f", "answer": "\u8981\u5728 StarBlast.io \u4e2d\u63a7\u5236\u5730\u5716\uff0c\u5c31\u8981\u4f54\u9818\u95dc\u9375\u8cc7\u6e90\u5340\u548c\u9698\u53e3\u3002\u4f8b\u5982\uff0c\u5c07\u4f60\u7684\u8266\u8247\u505c\u9760\u5728\u5927\u578b\u9695\u77f3\u53e2\u9644\u8fd1\uff0c\u4ee5\u6536\u96c6\u5bf6\u77f3\u4e26\u4f0f\u64ca\u6575\u4eba\u3002\u4f7f\u7528\u5177\u6709\u9ad8\u6a5f\u52d5\u6027\u548c\u706b\u529b\uff0c\u4f8b\u5982 Fury Star \u9019\u6a23\u7684\u8266\u8247\uff0c\u4ee5\u9ad8\u6548\u5de1\u908f\u9019\u4e9b\u5340\u57df\u3002\u59cb\u7d42\u7559\u610f\u6575\u4eba\u7684\u884c\u52d5\u4e26\u76f8\u61c9\u5730\u8abf\u6574\u4f60\u7684\u4f4d\u7f6e\u3002"}, {"question": "\u5728 StarBlast.io \u7684\u5718\u968a\u904a\u6232\u4e2d\uff0c\u54ea\u4e9b\u8266\u8247\u7d44\u5408\u6700\u597d\uff1f", "answer": "\u5728 StarBlast.io \u7684\u5718\u968a\u904a\u6232\u4e2d\uff0c\u61c9\u7d44\u5408\u5177\u6709\u4e92\u88dc\u80fd\u529b\u7684\u8266\u8247\u3002\u4f8b\u5982\uff0c\u5c07\u4e00\u8258\u5805\u56fa\u7684\u8266\u8247\uff0c\u4f8b\u5982\u6cf0\u5766\uff0c\u8207\u9ad8\u50b7\u5bb3\u8f38\u51fa\u8266\u8247\uff0c\u4f8b\u5982\u5e7d\u9748\uff0c\u914d\u5c0d\u3002\u6cf0\u5766\u5438\u6536\u50b7\u5bb3\uff0c\u800c\u5e7d\u9748\u5247\u5c08\u6ce8\u65bc\u6d88\u6ec5\u6575\u4eba\u3002\u826f\u597d\u7684\u6e9d\u901a\u548c\u5354\u8abf\u662f\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u9019\u4e9b\u7d44\u5408\u6548\u679c\u7684\u95dc\u9375\u3002"}, {"question": "StarBlast.io \u7684\u8266\u8247\u5347\u7d1a\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff1f", "answer": "StarBlast.io \u7684\u8266\u8247\u5347\u7d1a\u7cfb\u7d71\u5141\u8a31\u60a8\u4f7f\u7528\u5f9e\u5c0f\u884c\u661f\u6536\u96c6\u7684\u5bf6\u77f3\u4f86\u63d0\u9ad8\u8266\u8247\u7684\u5c6c\u6027\u3002\u6bcf\u8258\u8266\u8247\u90fd\u6709\u7368\u7279\u7684\u5347\u7d1a\u6a39\u3002\u4f8b\u5982\uff0cDelta \u6230\u9b25\u6a5f\u53ef\u4ee5\u5347\u7d1a\u5b83\u7684\u901f\u5ea6\u3001\u706b\u529b\u548c\u8010\u4e45\u6027\u3002\u5347\u7d1a\u5728\u6bd4\u8cfd\u671f\u9593\u6c38\u4e45\u6709\u6548\uff0c\u6240\u4ee5\u6839\u64da\u4f60\u7684\u7b56\u7565\u548c\u904a\u6232\u9032\u7a0b\u660e\u667a\u5730\u9078\u64c7\u5347\u7d1a\u3002"}, {"question": "StarBlast.io \u4e2d\u8266\u8247\u8010\u4e45\u6027\u7684\u57fa\u672c\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "StarBlast.io \u4e2d\u7684\u8266\u8247\u8010\u4e45\u5ea6\u7531\u8266\u8247\u7684\u57fa\u672c\u751f\u547d\u503c\u548c\u5347\u7d1a\u6c7a\u5b9a\u3002\u4f8b\u5982\uff0c\u6cf0\u5766\u64c1\u6709\u9ad8\u57fa\u790e\u751f\u547d\u503c\uff0c\u4f7f\u5176\u66f4\u5177\u8010\u4e45\u6027\u3002\u8010\u4e45\u5ea6\u53ef\u4ee5\u900f\u904e\u5347\u7d1a\u4f86\u589e\u5f37\uff0c\u4f46\u4e5f\u6703\u53d7\u5230\u6575\u65b9\u706b\u529b\u548c\u78b0\u649e\u7684\u5f71\u97ff\u3002\u7ba1\u7406\u4f60\u7684\u8266\u8247\u8010\u4e45\u5ea6\u9700\u8981\u5e73\u8861\u9032\u653b\u548c\u9632\u79a6\uff0c\u4f8b\u5982\u5728\u5fc5\u8981\u6642\u64a4\u9000\u6cbb\u7642\u3002"}, {"question": "\u6211\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u53ef\u4ee5\u5c07 StarBlast.io \u7684\u9032\u5ea6\u8f49\u79fb\u55ce\uff1f", "answer": "\u76ee\u524d\uff0cStarBlast.io \u4e0d\u652f\u63f4\u8de8\u5e73\u53f0\u9032\u5ea6\u8f49\u79fb\u3002\u6bcf\u500b\u5e73\u53f0\uff08\u4f8b\u5982\u96fb\u8166\u3001\u624b\u6a5f\uff09\u90fd\u6703\u7dad\u8b77\u7368\u7acb\u7684\u904a\u6232\u6578\u64da\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u96fb\u8166\u548c\u624b\u6a5f\u4e0a\u90fd\u73a9\uff0c\u4f60\u9700\u8981\u5728\u6bcf\u500b\u5e73\u53f0\u91cd\u65b0\u958b\u59cb\u3002\u59cb\u7d42\u78ba\u4fdd\u4f60\u767b\u5165\u6b63\u78ba\u7684\u5e33\u6236\uff0c\u4ee5\u907f\u514d\u907a\u5931\u9032\u5ea6\u3002"}, {"question": "StarBlast.io \u4e2d\u6709\u6c92\u6709\u96b1\u85cf\u7684\u5f69\u86cb\u6216\u7955\u5bc6\uff1f", "answer": "\u662f\u7684\uff0cStarBlast.io \u6709\u96b1\u85cf\u7684\u5f69\u86cb\uff0c\u4f8b\u5982\u7a00\u6709\u7684\u8266\u8247\u76ae\u819a\u548c\u79d8\u5bc6\u7684\u9695\u77f3\u7d50\u69cb\u3002\u4f8b\u5982\uff0c\u4e00\u4e9b\u73a9\u5bb6\u5831\u544a\u767c\u73fe\u4e86\u4e00\u500b\u7368\u7279\u7684\u9695\u77f3\uff0c\u6467\u6bc0\u5b83\u5f8c\u6703\u63ed\u793a\u4e00\u500b\u96b1\u85cf\u7684\u5bf6\u77f3\u7fa4\u3002\u5fb9\u5e95\u63a2\u7d22\u5730\u5716\u4e26\u5617\u8a66\u4e0d\u540c\u7684\u8266\u8247\u53ef\u4ee5\u767c\u73fe\u9019\u4e9b\u7955\u5bc6\u3002"}]
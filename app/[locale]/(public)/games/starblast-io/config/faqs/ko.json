[{"question": "StarBlast.io \uac8c\uc784\uc5d0 \uc0c8 \ud50c\ub808\uc774\uc5b4\ub85c\uc11c \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "StarBlast.io\uc5d0 \uc2dc\uc791\ud558\ub824\uba74 \uba3c\uc800 \uade0\ud615 \uc7a1\ud78c \ud1b5\uacc4\ub97c \uac00\uc9c4 \ub378\ud0c0 \uc804\ud22c\uae30\uc640 \uac19\uc740 \uae30\ubcf8 \ud568\uc120\uc744 \uc120\ud0dd\ud558\uc138\uc694. WASD \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc774\ub3d9\ud558\uace0 \ub9c8\uc6b0\uc2a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc870\uc900\ud558\uace0 \uc0ac\uaca9\ud558\uc138\uc694. \uc18c\ud589\uc131\uc5d0\uc11c \ubcf4\uc11d\uc744 \uc218\uc9d1\ud558\uc5ec \ud568\uc120\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ucd08\uae30 \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \ucd08\uae30 \ub9cc\ub0a8\uc744 \ucc98\ub9ac\ud558\uae30 \uc704\ud574 \ud568\uc120\uc758 \uc18d\ub3c4\uc640 \ud654\ub825\uc744 \uac1c\uc120\ud558\ub294 \ub370 \uc6b0\uc120\uc21c\uc704\ub97c \ub450\uc5b4\uc57c \ud569\ub2c8\ub2e4. \uc790\uc6d0\uc774 \ud48d\ubd80\ud55c \ub9f5 \uc911\uc559\uc5d0 \uba38\ubb34\ub974\ub294 \uac83\uc744 \uae30\uc5b5\ud558\uc138\uc694."}, {"question": "StarBlast.io\uc5d0\uc11c \uc219\ub2ec\ud574\uc57c \ud560 \uc8fc\uc694 \ucee8\ud2b8\ub864\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "StarBlast.io\uc758 \uc8fc\uc694 \ucee8\ud2b8\ub864\uc5d0\ub294 \uc774\ub3d9(WASD), \uc870\uc900 \ubc0f \uc0ac\uaca9(\ub9c8\uc6b0\uc2a4), \ud2b9\uc218 \ub2a5\ub825 \uc0ac\uc6a9(\uc2a4\ud398\uc774\uc2a4\ubc14)\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub378\ud0c0 \uc804\ud22c\uae30\uc758 \uc18d\ub3c4 \uc99d\uac00\uc640 \uac19\uc740 \ub2a5\ub825\uc5d0 \ub300\ud55c \uc2a4\ud398\uc774\uc2a4\ubc14 \uc0ac\uc6a9\ubc95\uc744 \uc219\ub2ec\ud558\uba74 \uc704\ud5d8\ud55c \uc0c1\ud669\uc5d0\uc11c \ubc97\uc5b4\ub098\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc18c\ud589\uc131\uacfc \uc801\uc758 \uacf5\uaca9\uc744 \ud53c\ud558\uba70 \uae30\ub3d9\ud558\ub294 \uc5f0\uc2b5\uc744 \ud1b5\ud574 \uac8c\uc784 \ud6a8\uc728\uc131\uc744 \ub192\uc774\uc138\uc694."}, {"question": "StarBlast.io\uc5d0\uc11c \ud568\uc120\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "StarBlast.io\uc5d0\uc11c \ud568\uc120\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \uac83\uc740 \ud568\uc120\uc758 \uc18d\ub3c4, \ud654\ub825 \ubc0f \ub0b4\uad6c\uc131\uacfc \uac19\uc740 \ud1b5\uacc4\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub378\ud0c0 \uc804\ud22c\uae30\uc758 \uc18d\ub3c4\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uba74 \uc801\uc744 \ub530\ub3cc\ub9b4 \uc218 \uc788\uc73c\uba70, \ud654\ub825\uc744 \ub192\uc774\uba74 \uc801\uc744 \ub354 \ube68\ub9ac \ubb3c\ub9ac\uce60 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud56d\uc0c1 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\uace0 \ud604\uc7ac \uac8c\uc784 \uc0c1\ud669\uc5d0 \ubd80\ud569\ud558\ub294 \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0 \uc6b0\uc120\uc21c\uc704\ub97c \ub450\uc138\uc694."}, {"question": "StarBlast.io\ub97c 100\uc2dc\uac04 \uc774\uc0c1 \ud50c\ub808\uc774\ud55c \ud6c4 \uc0ac\uc6a9\ud574\uc57c \ud560 \uace0\uae09 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "StarBlast.io\uc5d0\uc11c 100\uc2dc\uac04 \uc774\uc0c1 \ud50c\ub808\uc774\ud55c \ud6c4\uc5d0\ub294 \ud568\uc120 \uc804\ubb38\ud654 \ubc0f \uc9c0\ub3c4 \uc81c\uc5b4\uc640 \uac19\uc740 \uace0\uae09 \uc804\ub7b5\uc5d0 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc740\uc2e0 \ubc0f \ub9e4\ubcf5 \uc804\uc220\uc5d0 \uc801\ud569\ud55c \uc100\ub3c4\uc6b0 X-1\uacfc \uac19\uc740 \ud568\uc120\uc744 \uc120\ud0dd\ud558\uc138\uc694. STEP1: \uace0\uac1d\uc774 \ub9ce\uc740 \uc9c0\uc5ed\uc5d0 \uc704\uce58\uc2dc\ud0a4\uc138\uc694. STEP2: \ud568\uc120\uc758 \uace0\uc720 \ub2a5\ub825\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc801\uc744 \ub180\ub77c\uac8c \ud558\uc138\uc694. STEP3: \uc8fc\ubcc0 \uc18c\ud589\uc131\uc744 \uc774\uc6a9\ud558\uc5ec \uc740\uc2e0 \ubc0f \uce58\ub8cc\ud558\uc138\uc694. \uc774 \uc811\uadfc \ubc29\uc2dd\uc740 \ud6a8\uacfc\ub97c \uadf9\ub300\ud654\ud558\uace0 \uc704\ud5d8\uc744 \ucd5c\uc18c\ud654\ud569\ub2c8\ub2e4."}, {"question": "StarBlast.io\uc5d0\uc11c \uc9c0\ub3c4\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc81c\uc5b4\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "StarBlast.io\uc5d0\uc11c \uc9c0\ub3c4\ub97c \uc81c\uc5b4\ud558\ub824\uba74 \uc8fc\uc694 \uc790\uc6d0 \uc9c0\uc5ed\uacfc \uc9c0\uc815\ub41c \uc9c0\uc810\uc744 \uc7a5\uc545\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub300\ud615 \uc18c\ud589\uc131 \ud074\ub7ec\uc2a4\ud130 \uadfc\ucc98\uc5d0 \ud568\uc120\uc744 \ubc30\uce58\ud558\uc5ec \ubcf4\uc11d\uc744 \uc218\uc9d1\ud558\uace0 \uc801\uc744 \ub9e4\ubcf5\ud558\uc138\uc694. \ud4e8\ub9ac \uc2a4\ud0c0\uc640 \uac19\uc774 \ub192\uc740 \uae30\ub3d9\uc131\uacfc \ud654\ub825\uc744 \uac00\uc9c4 \ud568\uc120\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc774\ub7ec\ud55c \uc9c0\uc5ed\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uc21c\ucc30\ud558\uc138\uc694. \ud56d\uc0c1 \uc801\uc758 \uc774\ub3d9 \uc0c1\ud669\uc744 \ud30c\uc545\ud558\uace0 \uc704\uce58\ub97c \uc870\uc815\ud558\uc138\uc694."}, {"question": "StarBlast.io \ud300 \ud50c\ub808\uc774\uc5d0 \uc801\ud569\ud55c \ucd5c\uace0\uc758 \ud568\uc120 \uc870\ud569\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "StarBlast.io \ud300 \ud50c\ub808\uc774\ub97c \uc704\ud574 \uc0c1\ud638 \ubcf4\uc644\uc801\uc778 \ub2a5\ub825\uc744 \uac00\uc9c4 \ud568\uc120\uc744 \uacb0\ud569\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud0c0\uc774\ud0c4\uacfc \uac19\uc740 \uacac\uace0\ud55c \ud568\uc120\uacfc \ud32c\ud140\uacfc \uac19\uc740 \uace0\ud53c\ud574 \ub51c\ub7ec\ub97c \uacb0\ud569\ud558\uc138\uc694. \ud0c0\uc774\ud0c4\uc740 \ud53c\ud574\ub97c \ud761\uc218\ud558\uba70 \ud32c\ud140\uc740 \uc801\uc744 \uc81c\uac70\ud558\ub294 \ub370 \uc9d1\uc911\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc870\ud569\uc758 \ud6a8\uacfc\ub97c \uadf9\ub300\ud654\ud558\ub824\uba74 \uc18c\ud1b5\uacfc \uc870\uc815\uc774 \uc911\uc694\ud569\ub2c8\ub2e4."}, {"question": "StarBlast.io\uc5d0\uc11c \ud568\uc120 \uc5c5\uadf8\ub808\uc774\ub4dc \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "StarBlast.io\uc758 \ud568\uc120 \uc5c5\uadf8\ub808\uc774\ub4dc \uc2dc\uc2a4\ud15c\uc744 \ud1b5\ud574 \uc18c\ud589\uc131\uc5d0\uc11c \uc218\uc9d1\ud55c \ubcf4\uc11d\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud568\uc120 \ud1b5\uacc4\ub97c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac01 \ud568\uc120\uc740 \uace0\uc720\ud55c \uc5c5\uadf8\ub808\uc774\ub4dc \ud2b8\ub9ac\ub97c \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub378\ud0c0 \uc804\ud22c\uae30\ub294 \uc18d\ub3c4, \ud654\ub825 \ubc0f \ub0b4\uad6c\uc131\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \ub9e4\uce58 \uae30\uac04 \ub3d9\uc548 \uc601\uad6c\uc801\uc774\ubbc0\ub85c \uc804\ub7b5 \ubc0f \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc5d0 \ub530\ub77c \ud604\uba85\ud558\uac8c \uc120\ud0dd\ud558\uc138\uc694."}, {"question": "StarBlast.io\uc5d0\uc11c \ud568\uc120 \ub0b4\uad6c\uc131\uc758 \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "StarBlast.io\uc5d0\uc11c \ud568\uc120 \ub0b4\uad6c\uc131\uc740 \ud568\uc120\uc758 \uae30\ubcf8 \uccb4\ub825\uacfc \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0 \uc758\ud574 \uacb0\uc815\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud0c0\uc774\ud0c4\uc740 \uae30\ubcf8 \uccb4\ub825\uc774 \ub192\uc544 \ub0b4\uad6c\uc131\uc774 \ub354 \ub192\uc2b5\ub2c8\ub2e4. \ub0b4\uad6c\uc131\uc740 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \ud1b5\ud574 \uc99d\uac00\ud560 \uc218 \uc788\uc9c0\ub9cc, \uc801\uc758 \uacf5\uaca9\uacfc \ucda9\ub3cc\ub85c \uc778\ud574 \uc601\ud5a5\uc744 \ubc1b\uae30\ub3c4 \ud569\ub2c8\ub2e4. \ud568\uc120\uc758 \ub0b4\uad6c\uc131\uc744 \uad00\ub9ac\ud558\ub824\uba74 \ud544\uc694\uc5d0 \ub530\ub77c \ud68c\ubcf5\ud558\uae30 \uc704\ud574 \ud6c4\ud1f4\ud558\ub294 \uac83\uacfc \uac19\uc774 \uacf5\uaca9\uacfc \ubc29\uc5b4\uc758 \uade0\ud615\uc744 \ub9de\ucd94\uc138\uc694."}, {"question": "StarBlast.io\uc5d0\uc11c \ub2e4\ub978 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud604\uc7ac StarBlast.io\ub294 \ub2e4\ub978 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uac01 \ud50c\ub7ab\ud3fc(\uc608: PC, \ubaa8\ubc14\uc77c)\uc740 \ubcc4\ub3c4\uc758 \uac8c\uc784 \ub370\uc774\ud130\ub97c \uc720\uc9c0\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc640 \ubaa8\ubc14\uc77c\uc5d0\uc11c \ubaa8\ub450 \ud50c\ub808\uc774\ud558\ub294 \uacbd\uc6b0 \uac01 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc0c8\ub85c \uc2dc\uc791\ud574\uc57c \ud569\ub2c8\ub2e4. \uc9c4\ud589 \uc0c1\ud669\uc744 \uc783\uc9c0 \uc54a\uc73c\ub824\uba74 \ud56d\uc0c1 \uc62c\ubc14\ub978 \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uc138\uc694."}, {"question": "StarBlast.io\uc5d0 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub098 \ube44\ubc00\uc774 \uc788\ub098\uc694?", "answer": "\ub124, StarBlast.io\uc5d0\ub294 \ud76c\uadc0\ud55c \ud568\uc120 \uc2a4\ud0a8\uacfc \ube44\ubc00 \uc18c\ud589\uc131 \ud615\uc131\uacfc \uac19\uc740 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\ub294 \ud30c\uad34\ud588\uc744 \ub54c \uc228\uaca8\uc9c4 \ubcf4\uc11d \ud074\ub7ec\uc2a4\ud130\ub97c \ub4dc\ub7ec\ub0b4\ub294 \ub3c5\ud2b9\ud55c \uc18c\ud589\uc131\uc744 \ubc1c\uacac\ud588\ub2e4\uace0 \ubcf4\uace0\ud588\uc2b5\ub2c8\ub2e4. \uc9c0\ub3c4\ub97c \ucca0\uc800\ud788 \ud0d0\ud5d8\ud558\uace0 \ub2e4\uc591\ud55c \ud568\uc120\uc744 \uc2e4\ud5d8\ud558\uba74 \uc774\ub7ec\ud55c \ube44\ubc00\uc744 \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
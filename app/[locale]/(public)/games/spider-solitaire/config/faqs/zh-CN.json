[{"question": "\u6251\u514b\u5355\u4eba\u6e38\u620f\u57fa\u7840\uff1a\u5982\u4f55\u79fb\u52a8\u724c\u7ec4\u4e2d\u7684\u724c\uff0c\u4ee5\u53ca\u65b0\u73a9\u5bb6\u5165\u95e8\u9700\u8981\u4e86\u89e3\u7684\u57fa\u672c\u89c4\u5219\uff1f", "answer": "\u5bf9\u4e8e\u65b0\u624b\u6765\u8bf4\uff0c\u7406\u89e3\u724c\u7684\u79fb\u52a8\u65b9\u5f0f\u81f3\u5173\u91cd\u8981\u3002\u60a8\u9700\u8981\u5c06\u724c\u79fb\u52a8\u5230\u540c\u4e00\u82b1\u8272\u7684\u964d\u5e8f\u5e8f\u5217\u4e2d\u3002\u4f8b\u5982\uff0c\u60a8\u53ef\u4ee5\u5c06\u9ed1\u68437\u79fb\u52a8\u5230\u9ed1\u68438\u4e0a\u3002\u5982\u679c\u60a8\u6709\u4e00\u7ec4\u964d\u5e8f\u4e14\u82b1\u8272\u76f8\u540c\u7684\u724c\uff0c\u5219\u53ef\u4ee5\u5c06\u6574\u7ec4\u724c\u79fb\u52a8\u5230\u53e6\u4e00\u5217\u3002\u4e3b\u8981\u76ee\u6807\u662f\u521b\u5efa\u4ece\u738b\u724c\u5230A\u7684\u5b8c\u6574\u724c\u5e8f\uff0c\u8fd9\u4e9b\u724c\u5e8f\u968f\u540e\u5c06\u81ea\u52a8\u4ece\u6e38\u620f\u4e2d\u79fb\u9664\u3002\u8bf7\u8bb0\u4f4f\uff0c\u53ea\u6709\u5728\u6240\u6709\u724c\u7ec4\u5217\u4e2d\u90fd\u5b58\u5728\u724c\u7684\u60c5\u51b5\u4e0b\uff0c\u901a\u8fc7\u70b9\u51fb\u5e95\u90e8\u7684\u724c\u5806\u624d\u80fd\u53d1\u4e0b\u4e00\u884c\u724c\u3002\u6b64\u64cd\u4f5c\u6709\u52a9\u4e8e\u5f00\u542f\u60a8\u7684\u73a9\u6cd5\uff0c\u907f\u514d\u5728\u6e38\u620f\u521d\u671f\u9677\u5165\u56f0\u5883\u3002"}, {"question": "\u6251\u514b\u5355\u4eba\u6e38\u620f\u4e2d\uff0c\"\u64a4\u9500\" \u529f\u80fd\u662f\u4ec0\u4e48\uff1f\u81ea\u5a92\u4f53\u5185\u5bb9\u521b\u4f5c\u8005\u5728\u5c55\u793a\u6e38\u620f\u73a9\u6cd5\u65f6\uff0c\u5e94\u8be5\u6ce8\u610f\u54ea\u4e9b\u9650\u5236\uff1f", "answer": "\"\u64a4\u9500\" \u529f\u80fd\u5141\u8bb8\u60a8\u64a4\u9500\u4e0a\u6b21\u64cd\u4f5c\uff0c\u8fd9\u5c24\u5176\u6709\u52a9\u4e8e\u5c1d\u8bd5\u4e0d\u540c\u7684\u7b56\u7565\u3002\u60a8\u53ef\u4ee5\u64a4\u9500\u591a\u6b21\u64cd\u4f5c\uff0c\u53ef\u80fd\u9000\u56de\u591a\u6b65\uff0c\u4f46\u8fd9\u53ef\u80fd\u4f1a\u5f71\u54cd\u60a8\u5728\u5c55\u793a\u6251\u514b\u5355\u4eba\u6e38\u620f\u5185\u5bb9\u65f6\u7684\u771f\u5b9e\u6027\u3002\u8bf7\u5bf9\u89c2\u4f17\u4fdd\u6301\u900f\u660e\u3002\u5982\u679c\u60a8\u8fdb\u884c\u4e86\u4e00\u6b21\u6218\u7565\u6027\u79fb\u52a8\uff0c\u540e\u6765\u610f\u8bc6\u5230\u5b83\u5e76\u975e\u6700\u4f73\u9009\u62e9\uff0c\u53ef\u4ee5\u64a4\u9500\u5e76\u63a2\u7d22\u5176\u4ed6\u9009\u62e9\uff0c\u4f46\u8bf7\u786e\u4fdd\u60a8\u5c55\u793a\u5e76\u89e3\u91ca\u60a8\u7684\u601d\u8003\u8fc7\u7a0b\u3002\u89c2\u4f17\u6b23\u8d4f\u8bda\u5b9e\u548c\u4ece\u9519\u8bef\u4e2d\u5b66\u4e60\u3002\u4f8b\u5982\uff0c\u60a8\u53ef\u4ee5\u8fd9\u6837\u8bf4\uff1a\"\u6211\u8ba4\u4e3a\u5c06\u8fd9\u5f207\u79fb\u52a8\u8fc7\u53bb\u662f\u4e2a\u597d\u4e3b\u610f\uff0c\u4f46\u67e5\u770b\u5176\u4ed6\u724c\u5217\u540e\uff0c\u5b83\u5b9e\u9645\u4e0a\u4f1a\u963b\u788d\u6211\u3002\u8ba9\u6211\u4eec\u64a4\u9500\u5e76\u5c1d\u8bd5\u53e6\u4e00\u79cd\u65b9\u6cd5\u3002\""}, {"question": "\u6211\u4e3a\u4ec0\u4e48\u7ecf\u5e38\u5728\u6251\u514b\u5355\u4eba\u6e38\u620f\u4e2d\u8017\u5c3d\u4e86\u53ef\u7528\u7684\u884c\u52a8\uff1f\u5728\u521d\u671f\u9636\u6bb5\uff0c\u6211\u4f5c\u4e3a\u65b0\u624b\uff0c\u53ef\u4ee5\u5bf9\u81ea\u5df1\u7684\u65b9\u6cd5\u505a\u54ea\u4e9b\u8c03\u6574\uff1f", "answer": "\u8017\u5c3d\u884c\u52a8\u6b21\u6570\u5f88\u5e38\u89c1\uff0c\u5c24\u5176\u662f\u5728\u5f00\u59cb\u65f6\u3002\u9996\u5148\uff0c\u59cb\u7ec8\u5c1d\u8bd5\u63ed\u793a\u9690\u85cf\u7684\u724c\uff0c\u56e0\u4e3a\u5b83\u4eec\u4f1a\u89e3\u9501\u65b0\u7684\u9009\u9879\u3002\u4f18\u5148\u8003\u8651\u5c06\u724c\u79fb\u52a8\u5230\u7a7a\u5217\uff0c\u56e0\u4e3a\u8fd9\u4e9b\u7a7a\u5217\u975e\u5e38\u5b9d\u8d35\u3002\u786e\u4fdd\u60a8\u6ca1\u6709\u8fc7\u65e9\u5730\u4ece\u724c\u5806\u53d1\u724c\uff1b\u8fd9\u5e94\u8be5\u662f\u6700\u540e\u7684\u624b\u6bb5\u3002\u65b0\u53d1\u51fa\u7684\u724c\u884c\u53ef\u80fd\u4f1a\u963b\u788d\u60a8\u7684\u8fdb\u5c55\uff0c\u800c\u4e0d\u662f\u5e2e\u52a9\u60a8\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4e00\u5217\u4e2d\u6709\u57cb\u85cf\u7684A\uff0c\u5219\u5728\u7edd\u5bf9\u5fc5\u8981\u4e4b\u524d\u4e0d\u8981\u53d1\u724c\u3002\u5c3d\u53ef\u80fd\u4e13\u6ce8\u4e8e\u6784\u5efa\u540c\u4e00\u82b1\u8272\u7684\u5e8f\u5217\uff0c\u4ee5\u817e\u51fa\u7a7a\u95f4\uff0c\u56e0\u4e3a\u8fd9\u662f\u4ece\u957f\u8fdc\u6765\u770b\u8d62\u5f97\u6251\u514b\u5355\u4eba\u6e38\u620f\u7684\u5173\u952e\u3002\u8010\u5fc3\u548c\u4ed4\u7ec6\u89c2\u5bdf\u662f\u60a8\u7684\u76df\u53cb\u3002"}, {"question": "\u6251\u514b\u5355\u4eba\u6e38\u620f\u9ad8\u7ea7\u7b56\u7565\uff1a\u6211\u5e94\u8be5\u591a\u4e45\u6d17\u4e00\u6b21\u724c\uff0c\u4e3a\u4ec0\u4e48\u65f6\u95f4\u4f3c\u4e4e\u5bf9\u80dc\u5229\u5982\u6b64\u91cd\u8981\uff1f", "answer": "\u6d17\u724c\uff08\u5373\u53d1\u65b0\u724c\uff09\u5e94\u8be5\u88ab\u89c6\u4e3a\u4e00\u79cd\u7b56\u7565\u6027\u7684\u201c\u91cd\u7f6e\u201d\u3002\u65f6\u95f4\u81f3\u5173\u91cd\u8981\u3002\u5982\u679c\u60a8\u53ef\u4ee5\u5728\u724c\u7ec4\u5217\u4e0a\u8fdb\u884c\u79fb\u52a8\uff0c\u5373\u4f7f\u8fd9\u4e9b\u79fb\u52a8\u770b\u8d77\u6765\u5f88\u5c0f\uff0c\u4e5f\u4e0d\u8981\u6d17\u724c\u3002\u5728\u53d1\u724c\u4e4b\u524d\uff0c\u8bf7\u5148\u5c1d\u8bd5\u6253\u5f00\u5217\u6216\u5728\u73b0\u6709\u5e8f\u5217\u4e0a\u6784\u5efa\u3002\u4e3a\u4ec0\u4e48\uff1f\u56e0\u4e3a\u6bcf\u4e00\u884c\u65b0\u53d1\u51fa\u7684\u724c\u90fd\u4f1a\u589e\u52a0\u4e00\u5c42\u590d\u6742\u6027\uff0c\u5e76\u53ef\u80fd\u9020\u6210\u969c\u788d\u3002\u6b64\u5916\uff0c\u5728\u53d1\u724c\u4e4b\u524d\u5206\u6790\u5f53\u524d\u68cb\u76d8\u72b6\u6001 - \u60a8\u662f\u5426\u6709\u88ab\u9ad8\u4ef7\u503c\u724c\u963b\u585e\u7684\u5e8f\u5217\u6216\u79fb\u52a8\uff1f\u5982\u679c\u662f\uff0c\u5219\u53d1\u724c\u901a\u5e38\u5f88\u597d\u3002\u5982\u679c\u60a8\u6709\u591a\u4e2a\u53ef\u884c\u7684\u5217\uff0c\u8bf7\u7b49\u5f85\u3002\u6b65\u9aa41\uff1a\u8bc4\u4f30\u724c\u7ec4\u3002\u6b65\u9aa42\uff1a\u8bc6\u522b\u6f5c\u5728\u7684\u963b\u585e\u60c5\u51b5\u3002\u6b65\u9aa43\uff1a\u5982\u679c\u963b\u585e\u60c5\u51b5\u4e25\u91cd\u6216\u52a8\u4f5c\u7a00\u5c11\uff0c\u5219\u53d1\u724c\uff1b\u5426\u5219\uff0c\u8bf7\u7b49\u5f85\u3002"}, {"question": "\u6251\u514b\u5355\u4eba\u6e38\u620f\u4e2d\u7684\u201c\u5355\u82b1\u8272\u201d\u7b56\u7565\u662f\u4ec0\u4e48\uff1f\u4ec0\u4e48\u65f6\u5019\u6bd4\u201c\u56db\u82b1\u8272\u201d\u6216\u201c\u4e24\u82b1\u8272\u201d\u7b56\u7565\u66f4\u6709\u4f18\u52bf\uff1f", "answer": "\u201c\u5355\u82b1\u8272\u201d\u7b56\u7565\u662f\u6700\u7b80\u5355\u7684\u3002\u8fd9\u610f\u5473\u7740\u4ec5\u4f7f\u7528\u4e00\u79cd\u82b1\u8272\uff08\u4f8b\u5982\uff0c\u4ec5\u4f7f\u7528\u9ed1\u6843\uff09\u3002\u8fd9\u5927\u5927\u7b80\u5316\u4e86\u6e38\u620f\uff0c\u56e0\u4e3a\u5728\u6784\u5efa\u5e8f\u5217\u65f6\u65e0\u9700\u62c5\u5fc3\u4ea4\u66ff\u989c\u8272\u6216\u82b1\u8272\u3002\u5f53\u5b66\u4e60\u6e38\u620f\u57fa\u672c\u673a\u5236\u5e76\u7406\u89e3\u724c\u79fb\u52a8\u65f6\uff0c\u6b64\u7b56\u7565\u66f4\u6709\u4f18\u52bf\u3002\u5b83\u63d0\u4f9b\u4e86\u4e00\u4e2a\u7b80\u5316\u7684\u73af\u5883\uff0c\u53ef\u4ee5\u5feb\u901f\u7ec3\u4e60\u6e05\u7406\u5217\u548c\u6784\u5efa\u53ef\u89e3\u51b3\u7684\u5e8f\u5217\u3002\"\u56db\u82b1\u8272\" \u901a\u5e38\u88ab\u8ba4\u4e3a\u6781\u96be\uff0c\u800c\"\u4e24\u82b1\u8272\" \u63d0\u4f9b\u4e00\u4e2a\u7b56\u7565\u4e2d\u95f4\u5730\u5e26\uff1b\u5355\u82b1\u8272\u5141\u8bb8\u60a8\u7528\u6700\u5c0f\u7684\u52aa\u529b\u8d62\u5f97\u5927\u591a\u6570\u6e38\u620f\u3002\u5355\u82b1\u8272\u6251\u514b\u5355\u4eba\u6e38\u620f\u975e\u5e38\u9002\u5408\u65f6\u95f4\u7d27\u8feb\u7684\u65b0\u95fb\u7f16\u8f91\u548c\u5185\u5bb9\u521b\u4f5c\u8005\u3002"}, {"question": "\u80fd\u5426\u63cf\u8ff0\u6251\u514b\u5355\u4eba\u6e38\u620f\u7684\u6700\u4f73\u7ed3\u675f\u6e38\u620f\u7b56\u7565\uff0c\u91cd\u70b9\u662f\u6392\u5217\u548c\u5e8f\u5217\u5b8c\u6210\u4ee5\u6700\u5927\u5316\u83b7\u80dc\u673a\u4f1a\uff1f", "answer": "\u5728\u7ed3\u675f\u6e38\u620f\u4e2d\uff0c\u4f18\u5148\u8003\u8651\u5408\u5e76\u5e8f\u5217\u3002\u7406\u60f3\u60c5\u51b5\u4e0b\uff0c\u5e94\u5c3d\u53ef\u80fd\u5728\u4e0d\u540c\u7684\u5217\u4e2d\u62e5\u6709\u5c3d\u53ef\u80fd\u591a\u7684\u5b8c\u6574\u6216\u63a5\u8fd1\u5b8c\u6574\u7684\u5e8f\u5217\u3002\u8fd9\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u4e86\u5728\u5c06\u5df2\u6392\u5e8f\u7684\u90e8\u5206\u79fb\u52a8\u5230\u7a7a\u5217\u65f6\u53d1\u751f\u8fde\u9501\u53cd\u5e94\u7684\u53ef\u80fd\u6027\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u6709\u4e00\u7ec4\u51e0\u4e4e\u5b8c\u6574\u7684\u9ed1\u6843\u5e8f\u5217\uff0c\u8bf7\u5c1d\u8bd5\u5c06\u5b83\u4eec\u4fdd\u6301\u5728\u4e00\u8d77\u3002\u6700\u7ec8\u76ee\u6807\u662f\u540c\u65f6\u6e05\u7406\u5b8c\u6574\u7684\u5e8f\u5217\uff0c\u4ee5\u521b\u5efa\u591a\u4e2a\u7a7a\u5217\u8fdb\u884c\u64cd\u4f5c\u3002\u8fd9\u5141\u8bb8\u60a8\u63a7\u5236\u6e38\u620f\uff0c\u76f4\u5230\u7ed3\u675f\u3002\u6e05\u9664\u7a7a\u5217\u53ef\u80fd\u662f\u7ed3\u675f\u6e38\u620f\u6700\u91cd\u8981\u7684\u4e8b\u60c5\u3002\u8bf7\u8003\u8651\u4e0b\u8868\uff1a\n[\u7ed3\u675f\u6e38\u620f\u7b56\u7565\u8868]\n| \u7b56\u7565 | \u63cf\u8ff0 | \u4f18\u5148\u7ea7 |\n|---|---|---| \n| \u5408\u5e76 | \u5c06\u63a5\u8fd1\u5b8c\u6574\u7684\u5e8f\u5217\u5206\u7ec4 | \u9ad8 |\n| \u7a7a\u5217 | \u521b\u5efa\u591a\u4e2a\u7a7a\u5217 | \u9ad8 |\n| \u8fde\u9501\u53cd\u5e94 | \u8bbe\u7f6e\u79fb\u52a8\u4ee5\u540c\u65f6\u6e05\u9664\u5e8f\u5217 | \u4e2d\u7b49 |"}, {"question": "\u89e3\u6784\u6251\u514b\u5355\u4eba\u6e38\u620f\uff1a\u54ea\u4e9b\u5e95\u5c42\u7b97\u6cd5\u63a7\u5236\u7740\u724c\u7684\u53d1\u724c\uff0c\u4ee5\u53ca\u4e86\u89e3\u8fd9\u4e9b\u7b97\u6cd5\u5982\u4f55\u63d0\u5347\u8d44\u6df1\u73a9\u5bb6\u7684\u73a9\u6cd5\uff1f", "answer": "\u6251\u514b\u5355\u4eba\u6e38\u620f\u4e2d\u7684\u724c\u53d1\u724c\u901a\u5e38\u57fa\u4e8e\u4f2a\u968f\u673a\u6570\u751f\u6210\u5668\uff08PRNG\uff09\u3002\u8fd9\u610f\u5473\u7740\u6251\u514b\u724c\u7684\u6392\u5217\u5e76\u975e\u771f\u6b63\u968f\u673a\uff0c\u800c\u662f\u4e00\u79cd\u57fa\u4e8e\u521d\u59cb\u79cd\u5b50\u503c\u7684\u786e\u5b9a\u6027\u5e8f\u5217\u3002\u867d\u7136\u60a8\u65e0\u6cd5\u9884\u6d4b\u786e\u5207\u7684\u724c\u4f4d\uff0c\u4f46\u4e86\u89e3\u8fd9\u4e9b\u539f\u7406\u4f1a\u5e26\u6765\u5e2e\u52a9\u3002\u77e5\u9053\u5b83\u662f\u4f2a\u968f\u673a\u7684\u610f\u5473\u7740\u67d0\u4e9b\u6a21\u5f0f\u53ef\u80fd\u4f1a\u51fa\u73b0\uff0c\u5c3d\u7ba1\u5b83\u4eec\u662f\u6781\u96be\u53ef\u9760\u5229\u7528\u7684\u3002\u5982\u679c\u60a8\u4fdd\u5b58\u51e0\u573a\u6bd4\u8d5b\u7684\u8be6\u7ec6\u8bb0\u5f55\uff08\u6251\u514b\u724c\u4f4d\u7f6e\u3001\u79fb\u52a8\u7b49\uff09\uff0c\u5219\u53ef\u80fd\u4f1a\u89c2\u5bdf\u5230\u4e00\u4e9b\u9ad8\u6c34\u51c6\u7684\u91cd\u590d\u8d8b\u52bf\uff08\u4f46\u662f\uff0c\u60a8\u53ef\u4ee5\u9884\u6599\u5230\u4e00\u7ec4\u4e13\u4e1a\u6570\u5b66\u5bb6\u4f1a\u53d1\u73b0\u4e00\u4e9b\u6709\u4ef7\u503c\u7684\u4e1c\u897f\uff09\u3002\u5e95\u5c42\u7b97\u6cd5\u65e8\u5728\u751f\u6210\u4e0d\u53ef\u9884\u6d4b\u7684\u72b6\u6001\uff0c\u56e0\u6b64\u8bb0\u4f4f\u53d1\u51fa\u7684\u724c\u578b\u901a\u5e38\u662f\u53ef\u4ee5\u907f\u514d\u7684\u3002"}, {"question": "\u6251\u514b\u5355\u4eba\u6e38\u620f\u5982\u4f55\u786e\u5b9a\u6e38\u620f\u7684\u96be\u5ea6\u7b49\u7ea7\uff0c\u4ee5\u53ca\u54ea\u4e9b\u6807\u51c6\u4f1a\u5f71\u54cd\u9ad8\u4ef7\u503c\u724c\u548c\u4f4e\u4ef7\u503c\u724c\u7684\u5206\u5e03\uff1f", "answer": "\u6251\u514b\u5355\u4eba\u6e38\u620f\u7684\u96be\u5ea6\u4e3b\u8981\u53d6\u51b3\u4e8e\u53c2\u4e0e\u7684\u6e38\u620f\u82b1\u8272\u6570\u91cf\u3002\u5355\u82b1\u8272\u662f\u6700\u7b80\u5355\u7684\uff0c\u800c\u56db\u82b1\u8272\u662f\u6700\u96be\u7684\uff0c\u56e0\u4e3a\u60a8\u5fc5\u987b\u7ba1\u7406\u591a\u4e2a\u5e8f\u5217\u548c\u82b1\u8272\u53d8\u5316\u3002\u5728\u53d1\u724c\u65f6\uff0c\u66f4\u9ad8\u7684\u96be\u5ea6\u5e76\u4e0d\u7279\u522b\u4e13\u6ce8\u4e8e\u786e\u4fdd\u201c\u9ad8\u4ef7\u503c\u201dvs\u201c\u4f4e\u4ef7\u503c\u201d\u724c\u7684\u6570\u91cf\u2014\u2014\u800c\u662f\u589e\u52a0\u82b1\u8272\u6570\u91cf\u901a\u5e38\u4f1a\u81ea\u7136\u589e\u52a0\u963b\u585e\u8fd0\u884c\u7684\u53ef\u80fd\u6027\uff08\u56e0\u4e3a\u82b1\u8272\u7684\u51b2\u7a81\uff09\u3002\u57fa\u672c\u4e0a\uff0c\u5206\u5e03\u65e8\u5728\u786e\u4fdd\u6240\u6709\u6251\u514b\u724c\u90fd\u88ab\u4ee3\u8868\u5e76\u4e14\u76f8\u5f53\u6df7\u5408\uff0c\u800c\u4e0d\u7ba1\u82b1\u8272\u6570\u91cf\u5982\u4f55\u3002\u4e86\u89e3\u8fd9\u4e9b\u53c2\u6570\u53ef\u4ee5\u8ba9\u73a9\u5bb6\u66f4\u597d\u5730\u6839\u636e\u9009\u5b9a\u7684\u82b1\u8272\u6761\u4ef6\u5236\u5b9a\u7b56\u7565\u3002\u82b1\u8272\u8d8a\u591a\uff0c\u7ed3\u679c\u8d8a\u4e0d\u53ef\u9884\u6d4b\uff0c\u9700\u8981\u7684\u52aa\u529b\u8d8a\u591a\u3002"}, {"question": "\u8de8\u5e73\u53f0\u7684\u6251\u514b\u5355\u4eba\u6e38\u620f\uff1a\u662f\u5426\u63d0\u4f9b\u8de8\u5e73\u53f0\u7684\u5b58\u6863\u529f\u80fd\uff0c\u624b\u673a\u4e0a\u6e38\u620f\u5b58\u6863\u6587\u4ef6\u901a\u5e38\u5b58\u50a8\u5728\u54ea\u91cc\uff1f", "answer": "\u4e0d\u5e78\u7684\u662f\uff0c\u5927\u591a\u6570\u72ec\u7acb\u7248\u672c\u7684\u6251\u514b\u5355\u4eba\u6e38\u620f\u4e0d\u652f\u6301\u672c\u5730\u8de8\u5e73\u53f0\u5b58\u6863\u529f\u80fd\u3002\u624b\u673a\u8bbe\u5907\u4e0a\u7684\u5b58\u6863\u6587\u4ef6\u901a\u5e38\u5b58\u50a8\u5728\u8bbe\u5907\u5185\u90e8\u5b58\u50a8\u7684\u5e94\u7528\u7a0b\u5e8f\u5206\u914d\u7684\u5b58\u50a8\u7a7a\u95f4\u4e2d\u3002\u786e\u5207\u7684\u4f4d\u7f6e\u56e0 Android \u6216 iOS \u7248\u672c\u800c\u5f02\u3002\u8bf7\u6ce8\u610f\uff0c\u5927\u591a\u6570\u79fb\u52a8\u8bbe\u5907\u5c06\u4ee5\u5b89\u5168\u7684\u65b9\u5f0f\u5b58\u50a8\u5b58\u6863\u6587\u4ef6\uff0c\u4ee5\u9632\u6b62\u4e22\u5931\uff1b\u4e5f\u5c31\u662f\u8bf4\uff0c\u5b58\u6863\u4f1a\u4e0a\u4f20\u5230\u5185\u90e8 Apple/Google \u670d\u52a1\u5668\uff0c\u56e0\u6b64\u53ef\u4ee5\u5728\u7c7b\u4f3c\u751f\u6001\u7cfb\u7edf\u7684\u8bbe\u5907\u4e4b\u95f4\u540c\u6b65\u3002\u4f46\u662f\uff0c\u6251\u514b\u5355\u4eba\u6e38\u620f\u5982\u6b64\u7b80\u5355\uff0c\u56e0\u6b64\u5f00\u53d1\u4eba\u5458\u901a\u5e38\u4e0d\u4f1a\u5c06\u8de8\u5e73\u53f0\u652f\u6301\u5217\u4e3a\u9ad8\u4f18\u5148\u7ea7\u3002"}, {"question": "\u9664\u4e86\u83b7\u80dc\u4e4b\u5916\uff0c\u5728\u6251\u514b\u5355\u4eba\u6e38\u620f\u4e2d\u8fbe\u5230\u7279\u5b9a\u5206\u6570\u91cc\u7a0b\u7891\u6216\u7ec4\u5408\u8fde\u51fb\u662f\u5426\u4f1a\u6709\u4efb\u4f55\u5f69\u86cb\u6216\u53ef\u89e3\u9501\u5185\u5bb9\uff1f", "answer": "\u867d\u7136\u6251\u514b\u5355\u4eba\u6e38\u620f\u4ece\u6839\u672c\u4e0a\u6765\u8bf4\u662f\u4e00\u4e2a\u4ee5\u6280\u5de7\u4e3a\u4e2d\u5fc3\u7684\u5355\u4eba\u6251\u514b\u724c\u6e38\u620f\uff0c\u4f46\u67d0\u4e9b\u7248\u672c\u786e\u5b9e\u4f1a\u63d0\u4f9b\u4e00\u4e9b\u7ec6\u5fae\u7684\u6210\u5c31\u6216\u89c6\u89c9\u81ea\u5b9a\u4e49\u9009\u9879\u4f5c\u4e3a\u201c\u5956\u52b1\u201d\u3002\u4f8b\u5982\uff0c\u67d0\u4e9b\u7248\u672c\u53ef\u80fd\u4f1a\u5728\u8fbe\u5230\u7279\u5b9a\u5206\u6570\u91cc\u7a0b\u7891\u6216\u5b8c\u6210\u6ca1\u6709\u4f7f\u7528\u201c\u64a4\u9500\u201d\u529f\u80fd\u7684\u7279\u522b\u957f\u7684\u6e38\u620f\u8fde\u51fb\u65f6\u89e3\u9501\u65b0\u7684\u6251\u514b\u724c\u80cc\u9762\u8bbe\u8ba1\u3001\u80cc\u666f\u4e3b\u9898\u6216\u7279\u6b8a\u52a8\u753b\u3002\u8fd9\u4e9b\u5f69\u86cb\u901a\u5e38\u5f88\u5c0f\uff0c\u4e0d\u4f1a\u5f71\u54cd\u6838\u5fc3\u6e38\u620f\u73a9\u6cd5\uff0c\u4f46\u5b83\u4eec\u4e3a\u70ed\u8877\u73a9\u5bb6\u589e\u52a0\u4e86\u8fdb\u6b65\u548c\u5b9a\u5236\u5c42\u3002\u8bf7\u67e5\u770b\u6e38\u620f\u7684\u8bbe\u7f6e\u6216\u5e2e\u52a9\u83dc\u5355\uff0c\u4e86\u89e3\u53ef\u89e3\u9501\u5185\u5bb9\u4ee5\u53ca\u5982\u4f55\u5b9e\u73b0\u7279\u5b9a\u91cc\u7a0b\u7891\u3002"}]
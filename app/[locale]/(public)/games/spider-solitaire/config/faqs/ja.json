[{"question": "\u30b9\u30d1\u30a4\u30c0\u30fc\u30bd\u30ea\u30c6\u30a3\u30a2\u306e\u57fa\u672c\uff1a\u30ab\u30fc\u30c9\u3092\u30c8\u30ec\u30a4\u30ed\u30fc\u3067\u3069\u306e\u3088\u3046\u306b\u79fb\u52d5\u3055\u305b\u3001\u521d\u5fc3\u8005\u3068\u3057\u3066\u59cb\u3081\u308b\u305f\u3081\u306e\u57fa\u672c\u7684\u306a\u30eb\u30fc\u30eb\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001\u30ab\u30fc\u30c9\u306e\u79fb\u52d5\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u91cd\u8981\u3067\u3059\u3002\u540c\u3058\u8272\u306e\u964d\u9806\u306e\u30ab\u30fc\u30c9\u5217\u3092\u4f5c\u6210\u3059\u308b\u305f\u3081\u306b\u30ab\u30fc\u30c9\u3092\u79fb\u52d5\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30cf\u30fc\u30c8\u306e7\u3092\u30cf\u30fc\u30c8\u306e8\u306e\u4e0a\u306b\u79fb\u52d5\u3067\u304d\u307e\u3059\u3002\u964d\u9806\u3067\u540c\u3058\u8272\u306e\u30ab\u30fc\u30c9\u306e\u5217\u304c\u3042\u308b\u5834\u5408\u306f\u3001\u305d\u306e\u5217\u5168\u4f53\u3092\u5225\u306e\u5217\u306b\u79fb\u52d5\u3067\u304d\u307e\u3059\u3002\u4e3b\u306a\u76ee\u6a19\u306f\u3001\u30ad\u30f3\u30b0\u304b\u3089\u30a8\u30fc\u30b9\u307e\u3067\u306e\u5b8c\u5168\u306a\u30ab\u30fc\u30c9\u5217\u3092\u4f5c\u6210\u3059\u308b\u3053\u3068\u3067\u3042\u308a\u3001\u305d\u308c\u3089\u306f\u81ea\u52d5\u7684\u306b\u30b2\u30fc\u30e0\u304b\u3089\u524a\u9664\u3055\u308c\u307e\u3059\u3002\u4e0b\u90e8\u306e\u30b9\u30c8\u30c3\u30af\u3092\u30af\u30ea\u30c3\u30af\u3057\u3066\u3001\u65b0\u3057\u3044\u30ab\u30fc\u30c9\u306e\u884c\u3092\u51e6\u7406\u3067\u304d\u307e\u3059\u304c\u3001\u3059\u3079\u3066\u306e\u30c8\u30ec\u30a4\u30ed\u30fc\u5217\u306b\u30ab\u30fc\u30c9\u304c\u3042\u308b\u5834\u5408\u306b\u306e\u307f\u53ef\u80fd\u3067\u3059\u3002\u3053\u306e\u64cd\u4f5c\u306f\u3001\u7279\u306b\u30b2\u30fc\u30e0\u306e\u521d\u671f\u6bb5\u968e\u3067\u3001\u30d7\u30ec\u30a4\u3092\u89e3\u304d\u653e\u3061\u3001\u884c\u304d\u8a70\u307e\u308b\u306e\u3092\u9632\u3050\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30b9\u30d1\u30a4\u30c0\u30fc\u30bd\u30ea\u30c6\u30a3\u30a2\u3067[\u3084\u308a\u76f4\u3057]\u6a5f\u80fd\u3068\u306f\u4f55\u3067\u3059\u304b\u3002\u521d\u5fc3\u8005\u306e\u81ea\u5df1\u30e1\u30c7\u30a3\u30a2\u30b3\u30f3\u30c6\u30f3\u30c4\u88fd\u4f5c\u8005\u304c\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u7d39\u4ecb\u3059\u308b\u3068\u304d\u306b\u6ce8\u610f\u3059\u3079\u304d\u5236\u9650\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u300c\u3084\u308a\u76f4\u3057\u300d\u6a5f\u80fd\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u76f4\u524d\u306e\u64cd\u4f5c\u3092\u5143\u306b\u623b\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u6226\u7565\u3092\u8a66\u3059\u969b\u306b\u7279\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u8907\u6570\u306e\u64cd\u4f5c\u3092\u5143\u306b\u623b\u3059\u3053\u3068\u304c\u3067\u304d\u3001\u6570\u30bf\u30fc\u30f3\u623b\u308a\u307e\u3059\u304c\u3001\u30b9\u30d1\u30a4\u30c0\u30fc\u30bd\u30ea\u30c6\u30a3\u30a2\u306e\u5185\u5bb9\u3092\u4f5c\u6210\u3059\u308b\u3068\u304d\u306b\u3001\u672c\u7269\u3089\u3057\u3055\u306b\u5f71\u97ff\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u8996\u8074\u8005\u306b\u5bfe\u3057\u3066\u900f\u660e\u6027\u3092\u4fdd\u3061\u307e\u3059\u3002\u6226\u7565\u7684\u306a\u52d5\u304d\u3092\u3057\u305f\u5f8c\u3001\u6700\u9069\u306a\u65b9\u6cd5\u3067\u306a\u304b\u3063\u305f\u3053\u3068\u306b\u6c17\u3065\u3044\u305f\u3089\u3001\u4ee3\u66ff\u6848\u3092\u63a2\u6c42\u3059\u308b\u305f\u3081\u306b\u5143\u306b\u623b\u3057\u307e\u3059\u304c\u3001\u601d\u8003\u30d7\u30ed\u30bb\u30b9\u3092\u793a\u3057\u3066\u8aac\u660e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u8996\u8074\u8005\u306f\u3001\u6b63\u76f4\u3055\u3068\u9593\u9055\u3044\u304b\u3089\u306e\u5b66\u3073\u3092\u9ad8\u304f\u8a55\u4fa1\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u3084\u308a\u76f4\u3057\u3092\u96a0\u3059\u306e\u3067\u306f\u306a\u304f\u3001\u6b21\u306e\u3088\u3046\u306b\u8aac\u660e\u3067\u304d\u307e\u3059\u3002\u300c\u305d\u306e7\u3092\u52d5\u304b\u3059\u3053\u3068\u306f\u7d20\u6674\u3089\u3057\u3044\u30a2\u30a4\u30c7\u30a2\u3060\u3068\u8003\u3048\u307e\u3057\u305f\u304c\u3001\u4ed6\u306e\u5217\u3092\u898b\u308b\u3068\u3001\u5b9f\u969b\u306b\u306f\u30d6\u30ed\u30c3\u30af\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u304c\u308f\u304b\u308a\u307e\u3059\u3002\u3084\u308a\u76f4\u3057\u3092\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u5225\u306e\u65b9\u6cd5\u3092\u8a66\u3057\u307e\u3057\u3087\u3046\u3002\u300d"}, {"question": "\u306a\u305c\u79c1\u306f\u30b9\u30d1\u30a4\u30c0\u30fc\u30bd\u30ea\u30c6\u30a3\u30a2\u3067\u4f55\u5ea6\u3082\u624b\u672d\u3092\u4f7f\u3044\u5207\u3063\u3066\u3057\u307e\u3046\u306e\u3067\u3059\u304b\uff1f\u521d\u671f\u6bb5\u968e\u304b\u3089\u79c1\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u3092\u6539\u5584\u3059\u308b\u305f\u3081\u306b\u3001\u521d\u5fc3\u8005\u306b\u512a\u3057\u3044\u4fee\u6b63\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u624b\u672d\u3092\u4f7f\u3044\u5207\u3063\u3066\u3057\u307e\u3046\u3053\u3068\u306f\u3001\u7279\u306b\u30b2\u30fc\u30e0\u3092\u59cb\u3081\u305f\u3070\u304b\u308a\u306e\u3068\u304d\u306b\u3088\u304f\u3042\u308a\u307e\u3059\u3002\u307e\u305a\u3001\u5e38\u306b\u96a0\u3055\u308c\u305f\u30ab\u30fc\u30c9\u3092\u660e\u3089\u304b\u306b\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u65b0\u3057\u3044\u30aa\u30d7\u30b7\u30e7\u30f3\u304c\u89e3\u653e\u3055\u308c\u307e\u3059\u3002\u7a7a\u306e\u5217\u306b\u30ab\u30fc\u30c9\u3092\u79fb\u52d5\u3059\u308b\u3053\u3068\u3092\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u3089\u306f\u975e\u5e38\u306b\u8cb4\u91cd\u306a\u3082\u306e\u3067\u3059\u3002\u30b9\u30c8\u30c3\u30af\u304b\u3089\u65b0\u3057\u3044\u884c\u3092\u65e9\u6025\u306b\u51e6\u7406\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u306f\u6700\u5f8c\u306e\u624b\u6bb5\u3067\u3059\u3002\u65b0\u3057\u3044\u884c\u306f\u3001\u3042\u306a\u305f\u3092\u52a9\u3051\u308b\u3088\u308a\u3082\u3080\u3057\u308d\u90aa\u9b54\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5217\u306b\u96a0\u308c\u305f\u30a8\u30fc\u30b9\u304c\u3042\u308b\u5834\u5408\u3001\u7d76\u5bfe\u5fc5\u8981\u306b\u306a\u308b\u307e\u3067\u51e6\u7406\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002\u53ef\u80fd\u306a\u9650\u308a\u540c\u3058\u8272\u306e\u5217\u3092\u69cb\u7bc9\u3057\u3001\u30b9\u30da\u30fc\u30b9\u3092\u7a7a\u3051\u308b\u3053\u3068\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u304c\u9577\u671f\u7684\u306b\u306f\u30b9\u30d1\u30a4\u30c0\u30fc\u30bd\u30ea\u30c6\u30a3\u30a2\u306b\u52dd\u3064\u305f\u3081\u306e\u30ab\u30ae\u3060\u304b\u3089\u3067\u3059\u3002\u5fcd\u8010\u529b\u3068\u6ce8\u610f\u6df1\u3044\u89b3\u5bdf\u304c\u3042\u306a\u305f\u306e\u5473\u65b9\u3067\u3059\u3002"}, {"question": "\u30b9\u30d1\u30a4\u30c0\u30fc\u30bd\u30ea\u30c6\u30a3\u30a2\u306e\u9ad8\u5ea6\u306a\u6226\u7565\uff1a\u30c7\u30c3\u30ad\u3092\u4f55\u56de\u30b7\u30e3\u30c3\u30d5\u30eb\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u304b\u3002\u52dd\u3064\u305f\u3081\u306b\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u3067\u3042\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u30b7\u30e3\u30c3\u30d5\u30eb\uff08\u3064\u307e\u308a\u3001\u65b0\u3057\u3044\u884c\u306e\u51e6\u7406\uff09\u306f\u3001\u6226\u7565\u7684\u306a\u300c\u30ea\u30bb\u30c3\u30c8\u300d\u3068\u898b\u306a\u3059\u3079\u304d\u3067\u3059\u3002\u30bf\u30a4\u30df\u30f3\u30b0\u306f\u91cd\u8981\u3067\u3059\u3002\u30c8\u30ec\u30a4\u30ed\u30fc\u3067\u52d5\u304d\u304c\u3067\u304d\u308b\u5834\u5408\u3001\u305f\u3068\u3048\u5c0f\u3055\u306a\u52d5\u304d\u3067\u3042\u3063\u3066\u3082\u3001\u30b7\u30e3\u30c3\u30d5\u30eb\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002\u51e6\u7406\u3059\u308b\u524d\u306b\u3001\u5e38\u306b\u5217\u3092\u958b\u3044\u305f\u308a\u3001\u65e2\u5b58\u306e\u5217\u306b\u69cb\u7bc9\u3057\u305f\u308a\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u306a\u305c\u3067\u3059\u304b\uff1f\u65b0\u3057\u3044\u30ab\u30fc\u30c9\u306e\u884c\u306f\u3001\u8907\u96d1\u3055\u3092\u3055\u3089\u306b\u5897\u3084\u3057\u3001\u969c\u5bb3\u3092\u4f5c\u308a\u51fa\u3059\u53ef\u80fd\u6027\u304c\u3042\u308b\u304b\u3089\u3067\u3059\u3002\u307e\u305f\u3001\u51e6\u7406\u3059\u308b\u524d\u306b\u73fe\u5728\u306e\u30b2\u30fc\u30e0\u306e\u72b6\u614b\u3092\u5206\u6790\u3059\u308b\u3053\u3068\u3082\u91cd\u8981\u3067\u3059\u3002\u30b7\u30fc\u30b1\u30f3\u30b9\u307e\u305f\u306f\u52d5\u304d\u304c\u9ad8\u4fa1\u306a\u30ab\u30fc\u30c9\u306b\u3088\u3063\u3066\u30d6\u30ed\u30c3\u30af\u3055\u308c\u3066\u3044\u307e\u3059\u304b\uff1f\u306f\u3044\u306e\u5834\u5408\u3001\u30b7\u30e3\u30c3\u30d5\u30eb\u306f\u4e00\u822c\u7684\u306b\u826f\u3044\u3053\u3068\u3067\u3059\u3002\u6709\u52b9\u306a\u5217\u304c\u8907\u6570\u3042\u308b\u5834\u5408\u306f\u3001\u51e6\u7406\u3092\u4fdd\u7559\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30c8\u30ec\u30a4\u30ed\u30fc\u3092\u8a55\u4fa1\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6f5c\u5728\u7684\u306a\u30d6\u30ed\u30c3\u30af\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30d6\u30ed\u30c3\u30af\u304c\u9ad8\u3044\u304b\u3001\u52d5\u304d\u304c\u4e0d\u8db3\u3057\u3066\u3044\u308b\u5834\u5408\u306f\u51e6\u7406\u3057\u307e\u3059\u3002\u305d\u3046\u3067\u306a\u3044\u5834\u5408\u306f\u3001\u51e6\u7406\u3092\u4fdd\u7559\u3057\u307e\u3059\u3002"}, {"question": "\u30b9\u30d1\u30a4\u30c0\u30fc\u30bd\u30ea\u30c6\u30a3\u30a2\u3067\u300c\u5358\u4e00\u306e\u30b9\u30fc\u30c4\u300d\u6226\u7565\u3068\u306f\u4f55\u3067\u3059\u304b\u3002\u305d\u3057\u3066\u3001\u306a\u305c\u300c4\u3064\u306e\u30b9\u30fc\u30c4\u300d\u307e\u305f\u306f\u300c2\u3064\u306e\u30b9\u30fc\u30c4\u300d\u306e\u5909\u66f4\u3088\u308a\u3082\u6709\u5229\u3067\u3042\u308b\u306e\u3067\u3059\u304b\uff1f", "answer": "\u300c\u5358\u4e00\u306e\u30b9\u30fc\u30c4\u300d\u6226\u7565\u306f\u6700\u3082\u7c21\u5358\u306a\u3082\u306e\u3067\u3059\u3002\u3064\u307e\u308a\u3001\u3042\u308b\u30b9\u30fc\u30c4\uff08\u305f\u3068\u3048\u3070\u3001\u30b9\u30da\u30fc\u30c9\u306e\u307f\uff09\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u3092\u610f\u5473\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u69cb\u7bc9\u3059\u308b\u3068\u304d\u306b\u3001\u8272\u306e\u5909\u5316\u3084\u30b9\u30fc\u30c4\u306e\u5909\u5316\u3092\u5fc3\u914d\u3059\u308b\u5fc5\u8981\u304c\u306a\u3044\u305f\u3081\u3001\u30b2\u30fc\u30e0\u3092\u5927\u5e45\u306b\u7c21\u7d20\u5316\u3057\u307e\u3059\u3002\u3053\u306e\u30d0\u30ea\u30a8\u30fc\u30b7\u30e7\u30f3\u306f\u3001\u30b2\u30fc\u30e0\u306e\u57fa\u672c\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u5b66\u3073\u3001\u30ab\u30fc\u30c9\u306e\u79fb\u52d5\u3092\u7406\u89e3\u3059\u308b\u3068\u304d\u306b\u6709\u5229\u3067\u3059\u3002\u5217\u3092\u30af\u30ea\u30a2\u3057\u3001\u89e3\u6c7a\u3067\u304d\u308b\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u7d20\u65e9\u304f\u69cb\u7bc9\u3059\u308b\u305f\u3081\u306e\u5358\u7d14\u306a\u74b0\u5883\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u300c\uff14\u3064\u306e\u30b9\u30fc\u30c4\u300d\u306f\u975e\u5e38\u306b\u96e3\u3057\u3044\u3068\u307f\u306a\u3055\u308c\u308b\u3053\u3068\u304c\u591a\u304f\u3001\uff12\u3064\u306e\u30b9\u30fc\u30c4\u306f\u6226\u7565\u306e\u4e2d\u9593\u5730\u70b9\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\uff11\u3064\u306e\u30b9\u30fc\u30c4\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u6700\u4f4e\u9650\u306e\u52aa\u529b\u3067\u307b\u3068\u3093\u3069\u3059\u3079\u3066\u306e\u30b2\u30fc\u30e0\u306b\u52dd\u3064\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u5fd9\u3057\u3044\u30cb\u30e5\u30fc\u30b9\u7de8\u96c6\u8005\u3084\u30b3\u30f3\u30c6\u30f3\u30c4\u88fd\u4f5c\u8005\u306b\u3068\u3063\u3066\u30011\u3064\u306e\u30b9\u30fc\u30c4\u306e\u30b9\u30d1\u30a4\u30c0\u30fc\u306f\u6700\u9069\u3067\u3059\u3002"}, {"question": "\u30b9\u30d1\u30a4\u30c0\u30fc\u30bd\u30ea\u30c6\u30a3\u30a2\u306e\u6700\u9069\u306a\u6700\u7d42\u6226\u7565\u3092\u8aac\u660e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u52dd\u5229\u306e\u53ef\u80fd\u6027\u3092\u6700\u5927\u9650\u306b\u3059\u308b\u305f\u3081\u306e\u914d\u7f6e\u3068\u30b7\u30fc\u30b1\u30f3\u30b9\u306e\u5b8c\u4e86\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "\u6700\u7d42\u6bb5\u968e\u3067\u306f\u3001\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u7d71\u5408\u3059\u308b\u3053\u3068\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u7406\u60f3\u7684\u306b\u306f\u3001\u53ef\u80fd\u306a\u9650\u308a\u3001\u5225\u306e\u5217\u306b\u5b8c\u5168\u307e\u305f\u306f\u307b\u307c\u5b8c\u5168\u306a\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u3067\u304d\u308b\u3060\u3051\u591a\u304f\u6301\u3064\u3053\u3068\u3092\u76ee\u6307\u3057\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u30b7\u30fc\u30b1\u30f3\u30b9\u306e\u90e8\u5206\u3092\u7a7a\u306e\u5217\u306b\u79fb\u52d5\u3059\u308b\u3068\u304d\u306b\u9023\u9396\u53cd\u5fdc\u304c\u8d77\u3053\u308b\u53ef\u80fd\u6027\u304c\u6700\u5927\u9650\u306b\u9ad8\u307e\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30b9\u30da\u30fc\u30c9\u306e\u307b\u307c\u5b8c\u5168\u306a\u30b7\u30fc\u30b1\u30f3\u30b9\u304c\u3042\u308b\u5834\u5408\u3001\u305d\u308c\u3092\u30b0\u30eb\u30fc\u30d7\u5316\u3057\u3088\u3046\u3068\u3057\u307e\u3059\u3002\u6700\u7d42\u76ee\u6a19\u306f\u3001\u8907\u6570\u306e\u7a7a\u306e\u5217\u3092\u4f5c\u6210\u3057\u3066\u3001\u6700\u5f8c\u307e\u3067\u30b2\u30fc\u30e0\u3092\u5236\u5fa1\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u7a7a\u306e\u5217\u3092\u30af\u30ea\u30a2\u3059\u308b\u3053\u3068\u306f\u3001\u304a\u305d\u3089\u304f\u6700\u7d42\u6bb5\u968e\u3067\u6700\u3082\u91cd\u8981\u306a\u3053\u3068\u3067\u3059\u3002\u4e0b\u306e\u8868\u3092\u53c2\u7167\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n[\u8868\uff1a\u6700\u7d42\u6bb5\u968e\u306e\u6226\u7565] \n| \u6226\u7565 | \u8aac\u660e | \u512a\u5148\u9806\u4f4d |\n|---|---|---| \n| \u7d71\u5408 | \u307b\u307c\u5b8c\u5168\u306a\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u30b0\u30eb\u30fc\u30d7\u5316 | \u9ad8 |\n| \u7a7a\u306e\u5217 | \u8907\u6570\u306e\u7a7a\u306e\u5217\u3092\u4f5c\u6210 | \u9ad8 |\n| \u9023\u9396\u53cd\u5fdc | \u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u540c\u6642\u306b\u30af\u30ea\u30a2\u3059\u308b\u305f\u3081\u306e\u52d5\u304d\u3092\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7 | \u4e2d |"}, {"question": "\u30b9\u30d1\u30a4\u30c0\u30fc\u30bd\u30ea\u30c6\u30a3\u30a2\u306e\u89e3\u5256\uff1a\u30ab\u30fc\u30c9\u306e\u51e6\u7406\u3092\u652f\u914d\u3059\u308b\u57fa\u790e\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\u3002\u305d\u3057\u3066\u3001\u305d\u308c\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u30d9\u30c6\u30e9\u30f3\u30d7\u30ec\u30fc\u30e4\u30fc\u306e\u30d7\u30ec\u30a4\u306f\u3069\u306e\u3088\u3046\u306b\u5411\u4e0a\u3059\u308b\u306e\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30d1\u30a4\u30c0\u30fc\u30bd\u30ea\u30c6\u30a3\u30a2\u3067\u306e\u30ab\u30fc\u30c9\u51e6\u7406\u306f\u3001\u4e00\u822c\u7684\u306b\u64ec\u4f3c\u4e71\u6570\u751f\u6210\u5668\uff08PRNG\uff09\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u3064\u307e\u308a\u3001\u30ab\u30fc\u30c9\u306e\u914d\u7f6e\u306f\u5b9f\u969b\u306b\u306f\u30e9\u30f3\u30c0\u30e0\u3067\u306f\u306a\u304f\u3001\u521d\u671f\u306e\u30b7\u30fc\u30c9\u5024\u306b\u57fa\u3065\u3044\u305f\u6c7a\u5b9a\u8ad6\u7684\u306a\u30b7\u30fc\u30b1\u30f3\u30b9\u3067\u3059\u3002\u6b63\u78ba\u306a\u30ab\u30fc\u30c9\u306e\u4f4d\u7f6e\u3092\u4e88\u6e2c\u3059\u308b\u3053\u3068\u306f\u3067\u304d\u307e\u305b\u3093\u304c\u3001\u539f\u5247\u3092\u7406\u89e3\u3059\u308b\u3068\u5f79\u7acb\u3061\u307e\u3059\u3002\u305d\u308c\u304c\u64ec\u4f3c\u30e9\u30f3\u30c0\u30e0\u3067\u3042\u308b\u3053\u3068\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u7279\u5b9a\u306e\u30d1\u30bf\u30fc\u30f3\u304c\u73fe\u308c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u304c\u3001\u305d\u308c\u3089\u3092\u4fe1\u983c\u3057\u3066\u6d3b\u7528\u3059\u308b\u3053\u3068\u306f\u975e\u5e38\u306b\u56f0\u96e3\u3067\u3059\u3002\u3044\u304f\u3064\u304b\u306e\u30b2\u30fc\u30e0\uff08\u30ab\u30fc\u30c9\u306e\u4f4d\u7f6e\u3001\u79fb\u52d5\u306a\u3069\uff09\u306e\u8a73\u7d30\u306a\u8a18\u9332\u3092\u4fdd\u6301\u3059\u308b\u3068\u3001\u4e00\u90e8\u306e\u9ad8\u30ec\u30d9\u30eb\u3067\u7e70\u308a\u8fd4\u3057\u73fe\u308c\u308b\u50be\u5411\u3092\u89b3\u5bdf\u3067\u304d\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\uff08\u305f\u3060\u3057\u3001\u4fa1\u5024\u306e\u3042\u308b\u3082\u306e\u3092\u63a2\u3059\u305f\u3081\u306e\u30d7\u30ed\u306e\u6570\u5b66\u8005\u30c1\u30fc\u30e0\u3092\u671f\u5f85\u3067\u304d\u307e\u3059\uff09\u3002\u57fa\u790e\u3068\u306a\u308b\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u4e88\u6e2c\u3067\u304d\u306a\u3044\u72b6\u614b\u3092\u4f5c\u6210\u3059\u308b\u3053\u3068\u3092\u76ee\u7684\u3068\u3057\u3066\u3044\u308b\u305f\u3081\u3001\u914d\u5e03\u3055\u308c\u305f\u30d1\u30bf\u30fc\u30f3\u3092\u899a\u3048\u308b\u3053\u3068\u306f\u901a\u5e38\u3001\u907f\u3051\u3089\u308c\u307e\u3059\u3002"}, {"question": "\u30b9\u30d1\u30a4\u30c0\u30fc\u30bd\u30ea\u30c6\u30a3\u30a2\u306f\u3069\u306e\u3088\u3046\u306b\u30b2\u30fc\u30e0\u306e\u96e3\u6613\u5ea6\u3092\u6c7a\u3081\u308b\u306e\u3067\u3059\u304b\u3002\u9ad8\u4fa1\u306a\u30ab\u30fc\u30c9\u3068\u4f4e\u4fa1\u306a\u30ab\u30fc\u30c9\u306e\u5206\u5e03\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u57fa\u6e96\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30d1\u30a4\u30c0\u30fc\u30bd\u30ea\u30c6\u30a3\u30a2\u306e\u30b2\u30fc\u30e0\u96e3\u5ea6\u306f\u3001\u4e3b\u306b\u4f7f\u7528\u3055\u308c\u308b\u30b9\u30fc\u30c4\u306e\u6570\u306b\u3088\u3063\u3066\u6c7a\u307e\u308a\u307e\u3059\u30021\u3064\u306e\u30b9\u30fc\u30c4\u304c\u6700\u3082\u7c21\u5358\u3067\u30014\u3064\u306e\u30b9\u30fc\u30c4\u304c\u6700\u3082\u96e3\u3057\u3044\u3067\u3059\u3002\u8907\u6570\u306e\u30b7\u30fc\u30b1\u30f3\u30b9\u3068\u30b9\u30fc\u30c4\u306e\u5909\u66f4\u3092\u7ba1\u7406\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u304b\u3089\u3067\u3059\u3002\u30ab\u30fc\u30c9\u3092\u51e6\u7406\u3059\u308b\u969b\u306b\u3001\u3088\u308a\u9ad8\u3044\u96e3\u6613\u5ea6\u3067\u306f\u3001\u7279\u306b\u300c\u9ad8\u4fa1\u306a\u300d\u30ab\u30fc\u30c9\u3068\u300c\u4f4e\u4fa1\u306a\u300d\u30ab\u30fc\u30c9\u306e\u6570\u3092\u78ba\u4fdd\u3059\u308b\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u305f\u3060\u3057\u3001\u30b9\u30fc\u30c4\u306e\u6570\u306e\u5897\u52a0\u306b\u3088\u308a\u3001\u30e9\u30f3\u304c\u30d6\u30ed\u30c3\u30af\u3055\u308c\u308b\u53ef\u80fd\u6027\u304c\u9ad8\u304f\u306a\u308a\u307e\u3059\uff08\u30b9\u30fc\u30c4\u306e\u7af6\u5408\u306e\u305f\u3081\uff09\u3002\u57fa\u672c\u7684\u306b\u3001\u5206\u5e03\u306f\u3001\u30b9\u30fc\u30c4\u306e\u6570\u3092\u554f\u308f\u305a\u3001\u3059\u3079\u3066\u306e\u30ab\u30fc\u30c9\u304c\u8868\u3055\u308c\u3001\u516c\u5e73\u306b\u6df7\u5408\u3055\u308c\u308b\u3053\u3068\u3092\u76ee\u7684\u3068\u3057\u3066\u3044\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30d1\u30e9\u30e1\u30fc\u30bf\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u30d7\u30ec\u30fc\u30e4\u30fc\u306f\u9078\u629e\u3055\u308c\u305f\u30b9\u30fc\u30c4\u30b3\u30f3\u30c7\u30a3\u30b7\u30e7\u30f3\u306b\u57fa\u3065\u3044\u3066\u6226\u7565\u3092\u3088\u308a\u826f\u304f\u7acb\u3066\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30fc\u30c4\u304c\u591a\u3044\u307b\u3069\u3001\u4e88\u6e2c\u3067\u304d\u306a\u3044\u7d50\u679c\u306b\u306a\u308a\u3001\u3088\u308a\u591a\u304f\u306e\u52aa\u529b\u304c\u5fc5\u8981\u3067\u3059\u3002"}, {"question": "\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u306e\u30b9\u30d1\u30a4\u30c0\u30fc\u30bd\u30ea\u30c6\u30a3\u30a2\uff1a\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u30bb\u30fc\u30d6\u30b2\u30fc\u30e0\u6a5f\u80fd\u306f\u3042\u308a\u307e\u3059\u304b\u3002\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u3067\u30b2\u30fc\u30e0\u30bb\u30fc\u30d6\u30d5\u30a1\u30a4\u30eb\u306f\u901a\u5e38\u3069\u3053\u306b\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u6b8b\u5ff5\u306a\u304c\u3089\u3001\u307b\u3068\u3093\u3069\u306e\u30b9\u30bf\u30f3\u30c9\u30a2\u30ed\u30f3\u30d0\u30fc\u30b8\u30e7\u30f3\u306e\u30b9\u30d1\u30a4\u30c0\u30fc\u30bd\u30ea\u30c6\u30a3\u30a2\u306f\u3001\u30cd\u30a4\u30c6\u30a3\u30d6\u306b\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u30bb\u30fc\u30d6\u30b2\u30fc\u30e0\u6a5f\u80fd\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u307e\u305b\u3093\u3002\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u306e\u30bb\u30fc\u30d6\u30b2\u30fc\u30e0\u30d5\u30a1\u30a4\u30eb\u306f\u4e00\u822c\u7684\u306b\u3001\u30c7\u30d0\u30a4\u30b9\u306e\u5185\u90e8\u30e1\u30e2\u30ea\u5185\u306e\u30a2\u30d7\u30ea\u304c\u5272\u308a\u5f53\u3066\u3089\u308c\u305f\u30b9\u30c8\u30ec\u30fc\u30b8\u306b\u4fdd\u5b58\u3055\u308c\u307e\u3059\u3002\u6b63\u78ba\u306a\u5834\u6240\u306f\u3001Android\u307e\u305f\u306fiOS\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u3002\u307b\u3068\u3093\u3069\u306e\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u306f\u30bb\u30fc\u30d6\u30d5\u30a1\u30a4\u30eb\u3092\u640d\u5931\u304b\u3089\u4fdd\u8b77\u3059\u308b\u305f\u3081\u306b\u5b89\u5168\u306a\u65b9\u6cd5\u3067\u4fdd\u5b58\u3059\u308b\u3053\u3068\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3064\u307e\u308a\u3001\u30bb\u30fc\u30d6\u306f\u5185\u90e8\u306eApple / Google\u30b5\u30fc\u30d0\u30fc\u306b\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3055\u308c\u3001\u305d\u308c\u4ee5\u5f8c\u540c\u3058\u30a8\u30b3\u30b7\u30b9\u30c6\u30e0\u306e\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u540c\u671f\u3055\u308c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3060\u3057\u3001\u30b9\u30d1\u30a4\u30c0\u30fc\u30bd\u30ea\u30c6\u30a3\u30a2\u306f\u975e\u5e38\u306b\u7c21\u5358\u306a\u30b2\u30fc\u30e0\u3067\u3042\u308b\u305f\u3081\u3001\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30b5\u30dd\u30fc\u30c8\u306f\u901a\u5e38\u3001\u958b\u767a\u8005\u306b\u3068\u3063\u3066\u512a\u5148\u9805\u76ee\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}, {"question": "\u52dd\u3064\u3092\u8d8a\u3048\u3066\uff1a\u30b9\u30d1\u30a4\u30c0\u30fc\u30bd\u30ea\u30c6\u30a3\u30a2\u3067\u7279\u5b9a\u306e\u30b9\u30b3\u30a2\u30de\u30a4\u30eb\u30b9\u30c8\u30fc\u30f3\u307e\u305f\u306f\u30b3\u30f3\u30dc\u30b9\u30c8\u30ea\u30fc\u30e0\u306b\u5230\u9054\u3059\u308b\u3068\u3001\u4f55\u304b\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u307e\u305f\u306f\u30a2\u30f3\u30ed\u30c3\u30af\u53ef\u80fd\u306a\u30b3\u30f3\u30c6\u30f3\u30c4\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30b9\u30d1\u30a4\u30c0\u30fc\u30bd\u30ea\u30c6\u30a3\u30a2\u306f\u3001\u672c\u8cea\u7684\u306b\u30b9\u30ad\u30eb\u3092\u4e2d\u5fc3\u3068\u3057\u305f\u5358\u72ec\u306e\u30ab\u30fc\u30c9\u30b2\u30fc\u30e0\u3067\u3042\u308b\u305f\u3081\u3001\u4e00\u90e8\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u3067\u306f\u3001\u7279\u5b9a\u306e\u9054\u6210\u5ea6\u307e\u305f\u306f\u8996\u899a\u7684\u306a\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u300c\u5831\u916c\u300d\u3068\u3057\u3066\u63d0\u4f9b\u3057\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u4e00\u90e8\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u3067\u306f\u3001\u7279\u5b9a\u306e\u30b9\u30b3\u30a2\u30de\u30a4\u30eb\u30b9\u30c8\u30fc\u30f3\u306b\u5230\u9054\u3057\u305f\u308a\u3001\u7279\u306b\u9577\u3044\u30b2\u30fc\u30e0\u30b9\u30c8\u30ea\u30fc\u30e0\u3092\u300c\u3084\u308a\u76f4\u3057\u300d\u3092\u4f7f\u7528\u305b\u305a\u306b\u5b8c\u4e86\u3057\u305f\u308a\u3057\u305f\u5834\u5408\u306b\u3001\u65b0\u3057\u3044\u30ab\u30fc\u30c9\u306e\u88cf\u9762\u30c7\u30b6\u30a4\u30f3\u3001\u80cc\u666f\u30c6\u30fc\u30de\u3001\u307e\u305f\u306f\u7279\u5225\u306a\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3\u304c\u30ed\u30c3\u30af\u89e3\u9664\u3055\u308c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u901a\u5e38\u5c0f\u3055\u304f\u3001\u30b3\u30a2\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u305b\u3093\u304c\u3001\u71b1\u5fc3\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u305f\u3081\u306e\u9032\u884c\u3068\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u306e\u5c64\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002\u30a2\u30f3\u30ed\u30c3\u30af\u53ef\u80fd\u306a\u30b3\u30f3\u30c6\u30f3\u30c4\u3068\u7279\u5b9a\u306e\u30de\u30a4\u30eb\u30b9\u30c8\u30fc\u30f3\u3092\u9054\u6210\u3059\u308b\u65b9\u6cd5\u306b\u3064\u3044\u3066\u306f\u3001\u30b2\u30fc\u30e0\u306e\u8a2d\u5b9a\u307e\u305f\u306f\u30d8\u30eb\u30d7\u30e1\u30cb\u30e5\u30fc\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}]
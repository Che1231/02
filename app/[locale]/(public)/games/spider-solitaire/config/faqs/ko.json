[{"question": "\uc2a4\ud30c\uc774\ub354 \uc194\ub9ac\ud14c\uc5b4 \uae30\ubcf8 \uc6d0\uce59: \uce74\ub4dc\ub97c \ud14c\uc774\ube14\ub85c \uc774\ub3d9\ud558\ub294 \ubc29\ubc95\uacfc \ucd08\ubcf4\uc790\uac00 \uc2dc\uc791\ud558\uae30 \uc704\ud55c \uae30\ubcf8 \uaddc\uce59\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ucd08\uc2ec\uc790\ub85c\uc11c \uce74\ub4dc \uc774\ub3d9\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uac19\uc740 \ubb34\ub2ac\uc758 \ub0b4\ub9bc\ucc28\uc21c\uc73c\ub85c \uce74\ub4dc\ub97c \uc774\ub3d9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud558\ud2b8 7\uc744 \ud558\ud2b8 8 \uc704\ub85c \uc774\ub3d9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub0b4\ub9bc\ucc28\uc21c\uc774\uace0 \uac19\uc740 \ubb34\ub2ac\uc758 \uce74\ub4dc \uc2dc\ud000\uc2a4\uac00 \uc788\uc73c\uba74 \uc804\uccb4 \uc2dc\ud000\uc2a4\ub97c \ub2e4\ub978 \uc5f4\ub85c \uc774\ub3d9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc8fc\uc694 \ubaa9\ud45c\ub294 \uc655\uc5d0\uc11c \uc5d0\uc774\uc2a4\uae4c\uc9c0\uc758 \uc644\ubcbd\ud55c \uce74\ub4dc \uc2dc\ud000\uc2a4\ub97c \ub9cc\ub4dc\ub294 \uac83\uc774\uba70, \uc774\ub294 \uac8c\uc784\uc5d0\uc11c \uc790\ub3d9\uc73c\ub85c \uc81c\uac70\ub429\ub2c8\ub2e4. \uae30\uc5b5\ud560 \uc810\uc740 \uc544\ub798\ucabd\uc758 \uc2a4\ud0c1 \uce74\ub4dc\ub97c \ud074\ub9ad\ud558\uc5ec \uc0c8 \ud589\uc758 \uce74\ub4dc\ub97c \ub0bc \uc218 \uc788\uc9c0\ub9cc, \ubaa8\ub4e0 \ud14c\uc774\ube14 \uc5f4\uc5d0 \uce74\ub4dc\uac00 \uc788\uc744 \ub54c\ub9cc \uac00\ub2a5\ud558\ub2e4\ub294 \uac83\uc785\ub2c8\ub2e4. \uc774 \uc791\uc5c5\uc740 \ud2b9\ud788 \uac8c\uc784 \ucd08\ubc18\uc5d0 \ud50c\ub808\uc774\ub97c \ud574\uc81c\ud558\uace0 \ub9c9\ud788\ub294 \uac83\uc744 \ubc29\uc9c0\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc2a4\ud30c\uc774\ub354 \uc194\ub9ac\ud14c\uc5b4\uc5d0\uc11c \"\ub418\ub3cc\ub9ac\uae30\" \uae30\ub2a5\uc740 \ubb34\uc5c7\uc774\uba70, \uc0c8\ub86d\uac8c \ucf58\ud150\uce20 \uc81c\uc791\uc790\ub294 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ubcf4\uc5ec\uc904 \ub54c \uc5b4\ub5a4 \uc81c\ud55c \uc0ac\ud56d\uc744 \uc54c\uc544\uc57c \ud569\ub2c8\uae4c?", "answer": "\"\ub418\ub3cc\ub9ac\uae30\" \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uba74 \ub9c8\uc9c0\ub9c9 \ub3d9\uc791\uc744 \ub418\ub3cc\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 \ub2e4\uc591\ud55c \uc804\ub7b5\uc744 \uc2dc\ub3c4\ud560 \ub54c \uc720\uc6a9\ud569\ub2c8\ub2e4. \uc5ec\ub7ec \ub3d9\uc791\uc744 \ub418\ub3cc\ub9b4 \uc218 \uc788\uc73c\uba70, \uba87 \ud134\uc744 \ub418\ub3cc\ub9b4 \uc218 \uc788\uc9c0\ub9cc, \uc2a4\ud30c\uc774\ub354 \uc194\ub9ac\ud14c\uc5b4 \ucf58\ud150\uce20\ub97c \uc81c\uc791\ud560 \ub54c \uc9c4\uc815\uc131\uc5d0 \uc601\ud5a5\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2dc\uccad\uc790\uc5d0\uac8c \ud22c\uba85\ud574\uc57c \ud569\ub2c8\ub2e4. \uc804\ub7b5\uc801\uc778 \ub3d9\uc791\uc744 \ud55c \ud6c4\uc5d0 \uadf8 \ubc29\ubc95\uc774 \ucd5c\uc801\uc774 \uc544\ub2c8\ub77c\uace0 \ud310\ub2e8\ub418\uba74, \ub300\uc548\uc744 \ud0d0\uc0c9\ud558\uae30 \uc704\ud574 \ub418\ub3cc\ub9ac\uc2ed\uc2dc\uc624. \ud558\uc9c0\ub9cc \uc0dd\uac01 \uacfc\uc815\uc744 \ubcf4\uc5ec\uc8fc\uace0 \uc124\uba85\ud574\uc57c \ud569\ub2c8\ub2e4. \uc2dc\uccad\uc790\ub294 \uc815\uc9c1\ud568\uacfc \uc2e4\uc218\uc5d0\uc11c \ubc30\uc6b0\ub294 \uac83\uc744 \ub192\uc774 \ud3c9\uac00\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub418\ub3cc\ub9ac\uae30\ub97c \uc228\uae30\ub294 \ub300\uc2e0 \"\uc800\ub294 \uadf8 7\uc744 \uc6c0\uc9c1\uc774\ub294 \uac83\uc774 \uc88b\uc740 \uc0dd\uac01\uc774\ub77c\uace0 \uc0dd\uac01\ud588\uc9c0\ub9cc, \ub2e4\ub978 \uc5f4\uc744 \uc0b4\ud3b4\ubcf8 \uacb0\uacfc \uc2e4\uc81c\ub85c \uc81c\ud55c\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \ub418\ub3cc\ub824\uc11c \ub2e4\ub978 \ubc29\ubc95\uc744 \uc2dc\ub3c4\ud574 \ubcf4\uaca0\uc2b5\ub2c8\ub2e4.\" \ub77c\uace0 \ub9d0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc65c \uc9c0\uc18d\uc801\uc73c\ub85c \uc2a4\ud30c\uc774\ub354 \uc194\ub9ac\ud14c\uc5b4\uc5d0\uc11c \uc6c0\uc9c1\uc784\uc774 \ubd80\uc871\ud569\ub2c8\uae4c? \ucd08\ubcf4\uc790 \ub2e8\uacc4\uc5d0\uc11c \uc811\uadfc \ubc29\uc2dd\uc5d0 \ub300\ud55c \ucd08\ubcf4\uc790 \uce5c\ud654\uc801\uc778 \uc870\uc815 \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc6c0\uc9c1\uc784\uc774 \ubd80\uc871\ud55c \uac83\uc740 \ud2b9\ud788 \ucd08\ubcf4 \uc2dc\uae30\uc5d0 \ud754\ud569\ub2c8\ub2e4. \uccab\uc9f8, \ud56d\uc0c1 \uc228\uaca8\uc9c4 \uce74\ub4dc\ub97c \ub178\ucd9c\ud558\ub824\uace0 \uc2dc\ub3c4\ud558\uc2ed\uc2dc\uc624. \uc228\uaca8\uc9c4 \uce74\ub4dc\ub294 \uc0c8\ub85c\uc6b4 \uc635\uc158\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ube44\uc5b4\uc788\ub294 \uc5f4\ub85c \uce74\ub4dc\ub97c \uc774\ub3d9\ud558\ub294 \uac83\uc744 \uc6b0\uc120\uc2dc\ud558\uc2ed\uc2dc\uc624. \uc774\ub294 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc2a4\ud0c1 \uce74\ub4dc\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud589\uc744 \uc131\uae09\ud558\uac8c \ub0b4\uc9c0 \ub9c8\uc2ed\uc2dc\uc624. \uc774\ub294 \ub9c8\uc9c0\ub9c9 \uc218\ub2e8\uc785\ub2c8\ub2e4. \uc0c8\ub85c\uc6b4 \ud589\uc740 \ub354 \ub9ce\uc740 \uc7a5\uc560\ubb3c\uc744 \uc57c\uae30\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5f4\uc5d0 \uc228\uaca8\uc9c4 \uc5d0\uc774\uc2a4\uac00 \uc788\ub294 \uacbd\uc6b0 \uc808\ub300\uc801\uc73c\ub85c \ud544\uc694\ud560 \ub54c\uae4c\uc9c0 \ub0b4\uc9c0 \ub9c8\uc2ed\uc2dc\uc624. \uac00\ub2a5\ud55c \ud55c \ub3d9\uc77c\ud55c \ubb34\ub2ac\uc758 \uc2dc\ud000\uc2a4\ub97c \uad6c\ucd95\ud558\uc5ec \uacf5\uac04\uc744 \ud655\ubcf4\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \uc774\ub294 \uc7a5\uae30\uc801\uc73c\ub85c \uc2a4\ud30c\uc774\ub354 \uc194\ub9ac\ud14c\uc5b4\ub97c \uc774\uae30\ub294 \uc5f4\uc1e0\uc785\ub2c8\ub2e4. \uc778\ub0b4\uc2ec\uacfc \uc8fc\uc758 \uae4a\uc740 \uad00\ucc30\uc774 \ub2f9\uc2e0\uc758 \ub3d9\ub9f9\uc785\ub2c8\ub2e4."}, {"question": "\uc2a4\ud30c\uc774\ub354 \uc194\ub9ac\ud14c\uc5b4 \uace0\uae09 \uc804\ub7b5: \uc5b8\uc81c \uce74\ub4dc \ub371\uc744 \ub2e4\uc2dc \uc11e\uc5b4\uc57c \ud558\uba70, \uc2b9\ub9ac\uc5d0 \uc2dc\uac04\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub2e4\uc2dc \uc11e\ub294 \uac83(\uc989, \uc0c8\ub85c\uc6b4 \ud589\uc744 \ub0b4\ub294 \uac83)\uc740 \uc804\uc220\uc801\uc778 '\uc7ac\uc124\uc815'\uc73c\ub85c \uac04\uc8fc\ud574\uc57c \ud569\ub2c8\ub2e4. \uc2dc\uac04\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \ud14c\uc774\ube14\uc5d0\uc11c \uc6c0\uc9c1\uc784\uc744 \ud560 \uc218 \uc788\ub294 \uacbd\uc6b0, \uc544\ubb34\ub9ac \uc0ac\uc18c\ud558\uac8c \ubcf4\uc5ec\ub3c4 \ub2e4\uc2dc \uc11e\uc9c0 \ub9c8\uc2ed\uc2dc\uc624. \uc774\ub3d9\ud558\uae30 \uc804\uc5d0 \ud56d\uc0c1 \uc5f4\uc744 \uc5f0 \ub610\ub294 \uae30\uc874 \uc2dc\ud000\uc2a4\ub97c \uad6c\ucd95\ud558\ub824\uace0 \uc2dc\ub3c4\ud558\uc2ed\uc2dc\uc624. \uc65c\ub0d0\ud558\uba74 \uac01 \uce74\ub4dc\uc758 \uc0c8 \ud589\uc740 \ubcf5\uc7a1\uc131\uc744 \ucd94\uac00\ud558\uace0 \uc7a5\uc560\ubb3c\uc744 \ub9cc\ub4e4 \uc218 \uc788\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \ub610\ud55c \uce74\ub4dc\ub97c \ub0b4\uae30 \uc804\uc5d0 \ud604\uc7ac \ubcf4\ub4dc \uc0c1\ud0dc\ub97c \ubd84\uc11d\ud558\uc2ed\uc2dc\uc624. \uc2dc\ud000\uc2a4\ub098 \uc774\ub3d9\uc774 \uace0\uac00\uc758 \uce74\ub4dc\ub85c \ucc28\ub2e8\ub429\ub2c8\uae4c? \uadf8\ub807\ub2e4\uba74 \uce74\ub4dc\ub97c \ub0b4\ub294 \uac83\uc774 \uc77c\ubc18\uc801\uc73c\ub85c \uc88b\uc2b5\ub2c8\ub2e4. \uc5ec\ub7ec \uac1c\uc758 \uc791\uc5c5 \uac00\ub2a5\ud55c \uc5f4\uc774 \uc788\ub294 \uacbd\uc6b0 \uae30\ub2e4\ub9ac\uc2ed\uc2dc\uc624. STEP1: \ud14c\uc774\ube14 \ud3c9\uac00. STEP2: \uc7a0\uc7ac\uc801\uc778 \ucc28\ub2e8 \uc694\uc18c \uc2dd\ubcc4. STEP3: \ucc28\ub2e8 \uc694\uc18c\uac00 \ub192\uac70\ub098 \uc6c0\uc9c1\uc784\uc774 \ubd80\uc871\ud558\uba74 \uce74\ub4dc\ub97c \ub0b4\uc2ed\uc2dc\uc624. \uadf8\ub807\uc9c0 \uc54a\uc73c\uba74 \uae30\ub2e4\ub9ac\uc2ed\uc2dc\uc624."}, {"question": "\uc2a4\ud30c\uc774\ub354 \uc194\ub9ac\ud14c\uc5b4\uc5d0\uc11c \"\ud55c \ubb34\ub2ac\" \uc804\ub7b5\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b8\uc81c \"\ub124 \ubb34\ub2ac\" \ub610\ub294 \"\ub450 \ubb34\ub2ac\" \ubcc0\ud615\ubcf4\ub2e4 \uc720\ub9ac\ud569\ub2c8\uae4c?", "answer": "\"\ud55c \ubb34\ub2ac\" \uc804\ub7b5\uc774 \uac00\uc7a5 \uc27d\uc2b5\ub2c8\ub2e4. \ud2b9\uc815 \ubb34\ub2ac(\uc608: \uc2a4\ud398\uc774\ub4dc\ub9cc)\ub85c \ud50c\ub808\uc774\ud558\ub294 \uac83\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4. \uc5f0\uc18d\uc744 \uad6c\uc131\ud560 \ub54c \uc0c9\uc0c1\uc774\ub098 \ubb34\ub2ac\ub97c \ubc88\uac08\uc544 \uac00\uba70 \uace0\ub824\ud560 \ud544\uc694\uac00 \uc5c6\uae30 \ub54c\ubb38\uc5d0 \uac8c\uc784\uc774 \ud06c\uac8c \ub2e8\uc21c\ud654\ub429\ub2c8\ub2e4. \uc774 \ubcc0\ud615\uc740 \uac8c\uc784\uc758 \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc744 \ubc30\uc6b0\uace0 \uce74\ub4dc \uc774\ub3d9\uc744 \uc774\ud574\ud560 \ub54c \uc720\ub9ac\ud569\ub2c8\ub2e4. \uc5f4\uc744 \uc9c0\uc6b0\uace0 \ud480 \uc218 \uc788\ub294 \uc2dc\ud000\uc2a4\ub97c \uc2e0\uc18d\ud558\uac8c \uad6c\ucd95\ud558\ub294 \uc5f0\uc2b5\uc744 \uc704\ud55c \ub2e8\uc21c\ud654\ub41c \ud658\uacbd\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \"\ub124 \ubb34\ub2ac\"\ub294 \uc885\uc885 \ub9e4\uc6b0 \uc5b4\ub824\uc6b4 \uac83\uc73c\ub85c \uac04\uc8fc\ub418\uba70, \"\ub450 \ubb34\ub2ac\"\ub294 \uc804\ub7b5\uc744 \uc704\ud55c \uc911\uac04 \uc9c0\uc810\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ud55c \ubb34\ub2ac\ub294 \ucd5c\uc18c\ud55c\uc758 \ub178\ub825\uc73c\ub85c \ub300\ubd80\ubd84\uc758 \uac8c\uc784\uc744 \uc774\uae38 \uc218 \uc788\uac8c \ud569\ub2c8\ub2e4. \ud55c \ubb34\ub2ac \uc2a4\ud30c\uc774\ub354\ub294 \uc2dc\uac04\uc774 \ubd80\uc871\ud55c \ub274\uc2a4 \ud3b8\uc9d1\uc790 \ubc0f \ucf58\ud150\uce20 \uc81c\uc791\uc790\uc5d0\uac8c \uc801\ud569\ud569\ub2c8\ub2e4."}, {"question": "\uc2a4\ud30c\uc774\ub354 \uc194\ub9ac\ud14c\uc5b4\uc758 \ucd5c\uc801 \uc885\ub8cc \uc804\ub7b5\uc740 \ubb34\uc5c7\uc774\uba70, \ubc30\uc5f4\uacfc \uc2dc\ud000\uc2a4 \uc644\uc131\uc5d0 \uc9d1\uc911\ud558\uc5ec \uc2b9\uc0b0\uc744 \uadf9\ub300\ud654\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\uc885\ub8cc \ub2e8\uacc4\uc5d0\uc11c \uc2dc\ud000\uc2a4 \ud1b5\ud569\uc744 \uc6b0\uc120\uc2dc\ud558\uc2ed\uc2dc\uc624. \uc774\uc0c1\uc801\uc73c\ub85c \uac00\ub2a5\ud55c \ud55c \ub9ce\uc740 \uc644\uc131 \ub610\ub294 \uac70\uc758 \uc644\uc131\ub41c \uc2dc\ud000\uc2a4\ub97c \ubcc4\ub3c4\uc758 \uc5f4\uc5d0 \ub193\ub294 \uac83\uc744 \ubaa9\ud45c\ub85c \ud569\ub2c8\ub2e4. \uc2dc\ud000\uc2a4 \ubd80\ubd84\uc744 \ube44\uc5b4\uc788\ub294 \uc5f4\ub85c \uc774\ub3d9\ud560 \ub54c \uc5f0\uc1c4 \ubc18\uc751 \uac00\ub2a5\uc131\uc774 \uadf9\ub300\ud654\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc2a4\ud398\uc774\ub4dc\uc758 \uac70\uc758 \uc644\uc131\ub41c \uc2dc\ud000\uc2a4\uac00 \uc788\ub294 \uacbd\uc6b0 \uadf8\ub8f9\uc73c\ub85c \uc720\uc9c0\ud558\ub824\uace0 \uc2dc\ub3c4\ud558\uc2ed\uc2dc\uc624. \uad81\uadf9\uc801\uc778 \ubaa9\ud45c\ub294 \uc5ec\ub7ec \ube44\uc5b4\uc788\ub294 \uc5f4\uc744 \uc870\uc791\ud560 \uc218 \uc788\ub3c4\ub85d \uc804\uccb4 \uc2dc\ud000\uc2a4\ub97c \ub3d9\uc2dc\uc5d0 \uc9c0\uc6b0\ub294 \uac83\uc785\ub2c8\ub2e4. \uc774\ub807\uac8c \ud568\uc73c\ub85c\uc368 \ucd5c\uc885\uae4c\uc9c0 \uac8c\uc784\uc744 \ud1b5\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ube44\uc5b4\uc788\ub294 \uc5f4\uc744 \uc9c0\uc6b0\ub294 \uac83\uc774 \uc544\ub9c8\ub3c4 \uc885\ub8cc \ub2e8\uacc4\uc5d0\uc11c \uac00\uc7a5 \uc911\uc694\ud55c \uac83\uc785\ub2c8\ub2e4. \uc544\ub798 \ud45c\ub97c \ucc38\uace0\ud558\uc2ed\uc2dc\uc624.\n[\uc885\ub8cc \uc804\ub7b5 \ud45c]\n| \uc804\ub7b5 | \uc124\uba85 | \uc6b0\uc120\uc21c\uc704 |\n|---|---|---|\n| \ud1b5\ud569 | \uac70\uc758 \uc644\uc131\ub41c \uc2dc\ud000\uc2a4 \uadf8\ub8f9\ud654 | \ub192\uc74c |\n| \ube48 \uc5f4 | \uc5ec\ub7ec \ube48 \uc5f4 \ub9cc\ub4e4\uae30 | \ub192\uc74c |\n| \uc5f0\uc1c4 \ubc18\uc751 | \ub3d9\uc2dc\uc5d0 \uc2dc\ud000\uc2a4\ub97c \uc9c0\uc6b0\ub294 \uc774\ub3d9 \uc124\uc815 | \uc911\uac04 |"}, {"question": "\uc2a4\ud30c\uc774\ub354 \uc194\ub9ac\ud14c\uc5b4 \ud574\uccb4: \uc5b4\ub5a4 \uae30\ubcf8 \uc54c\uace0\ub9ac\uc998\uc774 \uce74\ub4dc \ubc30\ubd84\uc744 \uad00\ub9ac\ud558\uba70, \uc774\ub97c \uc544\ub294 \uac83\uc774 \ubca0\ud14c\ub791 \ud50c\ub808\uc774\ub97c \uc5b4\ub5bb\uac8c \ub192\uc5ec\uc904 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc2a4\ud30c\uc774\ub354 \uc194\ub9ac\ud14c\uc5b4\uc758 \uce74\ub4dc \ubc30\ubd84\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \uc758\uc0ac \ub09c\uc218 \uc0dd\uc131\uae30(PRNG)\ub97c \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. \uc774\ub294 \uce74\ub4dc\uc758 \ubc30\uc5f4\uc774 \uc2e4\uc81c\ub85c \ubb34\uc791\uc704\uac00 \uc544\ub2c8\uace0 \ucd08\uae30 \uc2dc\ub4dc \uac12\uc744 \uae30\ubc18\uc73c\ub85c \ud558\ub294 \uacb0\uc815\uc801\uc778 \uc2dc\ud000\uc2a4\ub77c\ub294 \uac83\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4. *\uc815\ud655\ud55c* \uce74\ub4dc \uc704\uce58\ub97c \uc608\uce21\ud560 \uc218\ub294 \uc5c6\uc9c0\ub9cc \uc6d0\ub9ac\ub97c \uc774\ud574\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc758\uc0ac \ub09c\uc218\uc784\uc744 \uc54c\uba74 \ud2b9\uc815 \ud328\ud134\uc774 \ub098\ud0c0\ub0a0 \uc218 \uc788\uc9c0\ub9cc \uc774\ub7ec\ud55c \ud328\ud134\uc744 \uc2e0\ub8b0\uc131 \uc788\uac8c \ud65c\uc6a9\ud558\uae30\ub294 \ub9e4\uc6b0 \uc5b4\ub835\uc2b5\ub2c8\ub2e4. \uc5ec\ub7ec \uac8c\uc784(\uce74\ub4dc \uc704\uce58, \uc774\ub3d9 \ub4f1)\uc758 \uc0c1\uc138\ud55c \uae30\ub85d\uc744 \uc720\uc9c0\ud558\uba74 \uc77c\ubd80 \uace0\uc218\uc900 \ubc18\ubcf5 \uacbd\ud5a5\uc744 \uad00\ucc30\ud560 \uc218 \uc788\uc744 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4(\ud558\uc9c0\ub9cc, \uc804\ubb38 \uc218\ud559\uc790 \ud300\uc774 \uac00\uce58 \uc788\ub294 \uac83\uc744 \ucc3e\uc744 \uc218 \uc788\uc744 \uac83\uc73c\ub85c \uc608\uc0c1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4). \uae30\ubcf8 \uc54c\uace0\ub9ac\uc998\uc740 \uc608\uce21 \ubd88\uac00\ub2a5\ud55c \uc0c1\ud0dc\ub97c \uc0dd\uc131\ud558\ub3c4\ub85d \uc758\ub3c4\ub418\uc5b4 \uc788\uc73c\ubbc0\ub85c \ubc30\ubd84\ub41c \ud328\ud134\uc744 \uae30\uc5b5\ud558\ub294 \uac83\uc744 \uc77c\ubc18\uc801\uc73c\ub85c \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc2a4\ud30c\uc774\ub354 \uc194\ub9ac\ud14c\uc5b4\ub294 \uac8c\uc784\uc758 \ub09c\uc774\ub3c4 \ub808\ubca8\uc744 \uc5b4\ub5bb\uac8c \uacb0\uc815\ud558\uba70, \uace0\uac00 \ub300 \uc800\uac00 \uce74\ub4dc\uc758 \ubd84\ud3ec\uc5d0 \uc5b4\ub5a4 \uae30\uc900\uc774 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\uc2a4\ud30c\uc774\ub354 \uc194\ub9ac\ud14c\uc5b4\uc758 \uac8c\uc784 \ub09c\uc774\ub3c4\ub294 \uc8fc\ub85c \ud50c\ub808\uc774\ub41c \ubb34\ub2ac\uc758 \uc218\uc5d0 \ub2ec\ub824 \uc788\uc2b5\ub2c8\ub2e4. \ud55c \ubb34\ub2ac\ub294 \uac00\uc7a5 \uc27d\uace0, \ub124 \ubb34\ub2ac\ub294 \uac00\uc7a5 \uc5b4\ub835\uc2b5\ub2c8\ub2e4. \uc5ec\ub7ec \uc2dc\ud000\uc2a4\uc640 \ubb34\ub2ac \ubcc0\uacbd\uc744 \uad00\ub9ac\ud574\uc57c \ud558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uce74\ub4dc\ub97c \ub0b4\ub294 \uacbd\uc6b0, \ub354 \ub192\uc740 \ub09c\uc774\ub3c4\ub294 \ud2b9\ubcc4\ud788 '\uace0\uac00' \ub300 '\uc800\uac00' \uce74\ub4dc\uc758 \uc218\ub97c \ubcf4\uc7a5\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \ubb34\ub2ac \uc218\uac00 \ub298\uc5b4\ub0a0\uc218\ub85d \ub2ec\ub9ac\uace0 \ucc28\ub2e8\ub420 \uac00\ub2a5\uc131\uc774 \uc790\uc5f0\ud788 \ub192\uc544\uc9d1\ub2c8\ub2e4 (\ubb34\ub2ac \ucda9\ub3cc \ub54c\ubb38\uc5d0). \uae30\ubcf8\uc801\uc73c\ub85c \ubd84\ud3ec\ub294 \ubaa8\ub4e0 \uce74\ub4dc\uac00 \ud45c\ud604\ub418\uace0 \ubb34\ub2ac \uc218\uc640 \uad00\uacc4\uc5c6\uc774 \uacf5\uc815\ud558\uac8c \ud63c\ud569\ub418\ub3c4\ub85d \ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ub9e4\uac1c\ubcc0\uc218\ub97c \uc774\ud574\ud558\uba74 \ud50c\ub808\uc774\uc5b4\ub294 \uc120\ud0dd\ub41c \ubb34\ub2ac \uc870\uac74\uc5d0 \ub530\ub77c \uc804\ub7b5\uc744 \ub354 \uc798 \uc138\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubb34\ub2ac\uac00 \ub9ce\uc73c\uba74 \uc608\uce21 \ubd88\uac00\ub2a5\ud55c \uacb0\uacfc\uac00 \ub9ce\uace0 \ub354 \ub9ce\uc740 \ub178\ub825\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."}, {"question": "\ud50c\ub7ab\ud3fc \uac04 \uc2a4\ud30c\uc774\ub354 \uc194\ub9ac\ud14c\uc5b4: \ud50c\ub7ab\ud3fc \uac04 \uc800\uc7a5 \uac8c\uc784 \uae30\ub2a5\uc774 \uc788\uc2b5\ub2c8\uae4c? \ubaa8\ubc14\uc77c\uc5d0\uc11c \uac8c\uc784 \uc800\uc7a5 \ud30c\uc77c\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \uc5b4\ub514\uc5d0 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ubd88\ud589\ud788\ub3c4 \ub300\ubd80\ubd84\uc758 \ub3c5\ub9bd\uc801 \uc2a4\ud30c\uc774\ub354 \uc194\ub9ac\ud14c\uc5b4 \ubc84\uc804\uc740 \uae30\ubcf8\uc801\uc73c\ub85c \ud50c\ub7ab\ud3fc \uac04 \uc800\uc7a5 \uac8c\uc784 \uae30\ub2a5\uc744 \uc9c0\uc6d0\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ubaa8\ubc14\uc77c \uae30\uae30\uc5d0\uc11c \uac8c\uc784 \uc800\uc7a5 \ud30c\uc77c\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \uae30\uae30\uc758 \ub0b4\ubd80 \uba54\ubaa8\ub9ac \ub0b4\uc5d0\uc11c \uc571\uc758 \ud560\ub2f9\ub41c \uc800\uc7a5\uc18c\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \uc815\ud655\ud55c \uc704\uce58\ub294 Android \ub610\ub294 iOS \ubc84\uc804\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. \ub300\ubd80\ubd84\uc758 \ubaa8\ubc14\uc77c \uae30\uae30\ub294 \uc190\uc2e4\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \uc548\uc804\ud558\uac8c \uc800\uc7a5 \ud30c\uc77c\uc744 \uc800\uc7a5\ud569\ub2c8\ub2e4. \uc800\uc7a5 \uc790\ub8cc\uac00 \uc720\uc0ac\ud55c \ud658\uacbd\uc758 \uae30\uae30\uc5d0 \ub3d9\uae30\ud654\ub420 \uc218 \uc788\ub3c4\ub85d \ub0b4\ubd80\uc758 Apple/Google \uc11c\ubc84\uc5d0 \uc5c5\ub85c\ub4dc\ub418\ub294 \uac83\uc785\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \uc2a4\ud30c\uc774\ub354 \uc194\ub9ac\ud14c\uc5b4\ub294 \ub108\ubb34 \ub2e8\uc21c\ud55c \uac8c\uc784\uc774\uae30 \ub54c\ubb38\uc5d0 \uac1c\ubc1c\uc790\ub294 \ud50c\ub7ab\ud3fc \uac04 \uc9c0\uc6d0\uc5d0 \uc6b0\uc120\uc21c\uc704\ub97c \ub450\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."}, {"question": "\uc2b9\ub9ac \uc678\uc5d0\ub3c4 \uc2a4\ud30c\uc774\ub354 \uc194\ub9ac\ud14c\uc5b4\uc5d0\uc11c \ud2b9\uc815 \uc810\uc218 \uae30\ub85d \ub610\ub294 \uc870\ud569 \uc2a4\ud2b8\ub9ad\uc744 \ub2ec\uc131\ud558\uba74 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub098 \uc7a0\uae08 \ud574\uc81c \ucf58\ud150\uce20\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc2a4\ud30c\uc774\ub354 \uc194\ub9ac\ud14c\uc5b4\ub294 \uae30\ubcf8\uc801\uc73c\ub85c \uae30\uc220\uc5d0 \uc911\uc810\uc744 \ub454 \ub2e8\ub3c5 \uce74\ub4dc \uac8c\uc784\uc774\uc9c0\ub9cc, \uc77c\ubd80 \ubc84\uc804\uc740 '\ubcf4\uc0c1'\uc73c\ub85c\uc11c \ubbf8\ubb18\ud55c \uc5c5\uc801 \ub610\ub294 \uc2dc\uac01\uc801 \uc0ac\uc6a9\uc790 \uc9c0\uc815 \uc635\uc158\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc77c\ubd80 \ubc84\uc804\uc740 \ud2b9\uc815 \uc810\uc218 \uae30\ub85d\uc744 \ub2ec\uc131\ud558\uac70\ub098 '\ub418\ub3cc\ub9ac\uae30'\ub97c \uc0ac\uc6a9\ud558\uc9c0 \uc54a\uace0 \ud2b9\ud788 \uae34 \uac8c\uc784 \uc2a4\ud2b8\ub9ad\uc744 \uc644\ub8cc\ud558\uba74 \uc0c8\ub85c\uc6b4 \uce74\ub4dc \ub4b7\uba74 \ub514\uc790\uc778, \ubc30\uacbd \ud14c\ub9c8 \ub610\ub294 \ud2b9\uc218 \uc560\ub2c8\uba54\uc774\uc158\uc744 \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uc77c\ubc18\uc801\uc73c\ub85c \uc791\uace0 \ud575\uc2ec \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc601\ud5a5\uc744 \uc8fc\uc9c0 \uc54a\uc9c0\ub9cc, \uc5f4\ub82c\ud55c \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \uc9c4\ud589 \ubc0f \uc0ac\uc6a9\uc790 \uc9c0\uc815\uce35\uc744 \ucd94\uac00\ud569\ub2c8\ub2e4. \uc7a0\uae08 \ud574\uc81c \ucf58\ud150\uce20 \ubc0f \ud2b9\uc815 \ub9c8\uc77c\uc2a4\ud1a4 \ub2ec\uc131 \ubc29\ubc95\uc5d0 \ub300\ud55c \uc790\uc138\ud55c \ub0b4\uc6a9\uc740 \uac8c\uc784 \uc124\uc815\uc774\ub098 \ub3c4\uc6c0\ub9d0 \uba54\ub274\ub97c \ud655\uc778\ud558\uc2ed\uc2dc\uc624."}]
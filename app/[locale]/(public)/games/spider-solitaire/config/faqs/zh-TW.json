[{"question": "\u8718\u86db\u724c\u904a\u6232\u57fa\u790e\uff1a\u5982\u4f55\u79fb\u52d5\u724c\u5806\u4e2d\u7684\u724c\uff0c\u4ee5\u53ca\u65b0\u624b\u5165\u9580\u7684\u57fa\u672c\u898f\u5247\u70ba\u4f55\uff1f", "answer": "\u5c0d\u65bc\u65b0\u624b\u4f86\u8aaa\uff0c\u4e86\u89e3\u724c\u7684\u79fb\u52d5\u65b9\u5f0f\u81f3\u95dc\u91cd\u8981\u3002\u60a8\u9700\u8981\u5c07\u724c\u79fb\u52d5\u5230\u540c\u4e00\u82b1\u8272\u7684\u905e\u6e1b\u5e8f\u5217\u4e2d\u3002\u4f8b\u5982\uff0c\u60a8\u53ef\u4ee5\u5c07\u7d05\u5fc3 7 \u79fb\u52d5\u5230\u7d05\u5fc3 8\u3002\u5982\u679c\u60a8\u6709\u4e00\u7d44\u82b1\u8272\u76f8\u540c\u4e14\u9806\u5e8f\u905e\u6e1b\u7684\u724c\uff0c\u5247\u53ef\u4ee5\u5c07\u6574\u7d44\u724c\u79fb\u52d5\u5230\u53e6\u4e00\u5217\u3002\u4e3b\u8981\u76ee\u6a19\u662f\u5efa\u7acb\u5f9e\u738b\u724c\u5230 A \u7684\u5b8c\u6574\u724c\u7d44\u5e8f\u5217\uff0c\u7136\u5f8c\u9019\u4e9b\u5e8f\u5217\u6703\u81ea\u52d5\u5f9e\u904a\u6232\u4e2d\u79fb\u9664\u3002\u8acb\u8a18\u4f4f\uff0c\u53ea\u6709\u7576\u6bcf\u5217\u724c\u5806\u4e2d\u90fd\u81f3\u5c11\u6709\u4e00\u5f35\u724c\u6642\uff0c\u624d\u80fd\u9ede\u64ca\u5e95\u90e8\u7684\u724c\u5eab\u767c\u4e0b\u4e00\u884c\u724c\u3002\u6b64\u52d5\u4f5c\u6709\u52a9\u65bc\u958b\u555f\u60a8\u7684\u904a\u6232\u73a9\u6cd5\uff0c\u4e26\u907f\u514d\u5728\u904a\u6232\u521d\u671f\u5361\u4f4f\u3002"}, {"question": "\u8718\u86db\u724c\u904a\u6232\u4e2d\u7684\u300e\u5fa9\u539f\u300f\u529f\u80fd\u662f\u4ec0\u9ebc\uff1f\u793e\u7fa4\u5a92\u9ad4\u5167\u5bb9\u5275\u4f5c\u8005\u5728\u5c55\u793a\u904a\u6232\u73a9\u6cd5\u6642\uff0c\u61c9\u8a72\u6ce8\u610f\u54ea\u4e9b\u9650\u5236\uff1f", "answer": "\u300e\u5fa9\u539f\u300f\u529f\u80fd\u5141\u8a31\u60a8\u64a4\u92b7\u4e0a\u6b21\u7684\u52d5\u4f5c\uff0c\u9019\u5c0d\u65bc\u5617\u8a66\u4e0d\u540c\u7684\u7b56\u7565\u5c24\u5176\u6709\u5e6b\u52a9\u3002\u60a8\u53ef\u4ee5\u5fa9\u539f\u591a\u500b\u52d5\u4f5c\uff0c\u6f5b\u5728\u5730\u56de\u6eaf\u6578\u56de\u5408\uff0c\u4f46\u9019\u53ef\u80fd\u6703\u5f71\u97ff\u60a8\u88fd\u4f5c\u8718\u86db\u724c\u904a\u6232\u5167\u5bb9\u7684\u771f\u5be6\u6027\u3002\u5c0d\u89c0\u773e\u900f\u660e\u3002\u5982\u679c\u60a8\u57f7\u884c\u4e86\u4e00\u500b\u7b56\u7565\u6027\u52d5\u4f5c\uff0c\u5f8c\u4f86\u767c\u73fe\u4e26\u975e\u6700\u4f73\u9078\u64c7\uff0c\u5247\u53ef\u4ee5\u5fa9\u539f\u4ee5\u63a2\u7d22\u5176\u4ed6\u65b9\u6848\uff0c\u4f46\u8acb\u52d9\u5fc5\u986f\u793a\u548c\u89e3\u91cb\u60a8\u7684\u601d\u8003\u904e\u7a0b\u3002\u89c0\u773e\u6b23\u8cde\u8aa0\u5be6\u548c\u5f9e\u932f\u8aa4\u4e2d\u5b78\u7fd2\u3002\u4f8b\u5982\uff0c\u4e0d\u8981\u96b1\u85cf\u5fa9\u539f\u529f\u80fd\uff0c\u60a8\u53ef\u4ee5\u8aaa\uff1a\u300e\u6211\u8a8d\u70ba\u79fb\u52d5\u90a3\u5f35 7 \u662f\u500b\u597d\u4e3b\u610f\uff0c\u4f46\u4ed4\u7d30\u89c0\u5bdf\u5176\u4ed6\u724c\u5806\u5f8c\uff0c\u5b83\u5be6\u969b\u4e0a\u963b\u7919\u4e86\u6211\u3002\u8b93\u6211\u5011\u5fa9\u539f\uff0c\u5617\u8a66\u4e0d\u540c\u7684\u65b9\u6cd5\u3002\u300f"}, {"question": "\u6211\u70ba\u4ec0\u9ebc\u5728\u8718\u86db\u724c\u904a\u6232\u4e2d\u7e3d\u662f\u7f3a\u5c11\u52d5\u4f5c\uff1f\u5f9e\u958b\u59cb\u968e\u6bb5\uff0c\u6211\u53ef\u4ee5\u63a1\u53d6\u54ea\u4e9b\u53cb\u5584\u7684\u65b0\u624b\u8abf\u6574\u7b56\u7565\uff1f", "answer": "\u7f3a\u5c11\u52d5\u4f5c\u662f\u5f88\u5e38\u898b\u7684\uff0c\u5c24\u5176\u662f\u5728\u525b\u958b\u59cb\u7684\u6642\u5019\u3002\u9996\u5148\uff0c\u52d9\u5fc5\u5617\u8a66\u63ed\u9732\u96b1\u85cf\u7684\u724c\uff0c\u56e0\u70ba\u5b83\u5011\u6703\u958b\u555f\u65b0\u7684\u9078\u9805\u3002\u512a\u5148\u5c07\u724c\u79fb\u81f3\u7a7a\u5217\uff0c\u56e0\u70ba\u5b83\u5011\u975e\u5e38\u5bf6\u8cb4\u3002\u78ba\u4fdd\u60a8\u4e0d\u8981\u904e\u65e9\u5f9e\u724c\u5eab\u767c\u4e0b\u4e00\u884c\u724c\uff1b\u9019\u61c9\u8a72\u662f\u6700\u5f8c\u624b\u6bb5\u3002\u65b0\u7684\u724c\u884c\u53ef\u80fd\u6703\u963b\u7919\u60a8\u7684\u904a\u6232\uff0c\u800c\u4e0d\u662f\u5e6b\u52a9\u60a8\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4e00\u5217\u4e2d\u6709\u57cb\u85cf\u7684 A\uff0c\u5247\u5728\u5fc5\u8981\u4e4b\u524d\u4e0d\u8981\u767c\u724c\u3002\u76e1\u53ef\u80fd\u5c08\u6ce8\u65bc\u5efa\u7acb\u540c\u4e00\u82b1\u8272\u7684\u5e8f\u5217\uff0c\u4ee5\u9a30\u51fa\u7a7a\u9593\uff0c\u56e0\u70ba\u9019\u662f\u5728\u9577\u671f\u904a\u6232\u8718\u86db\u724c\u904a\u6232\u4e2d\u7372\u52dd\u7684\u95dc\u9375\u3002\u8010\u5fc3\u548c\u4ed4\u7d30\u89c0\u5bdf\u662f\u60a8\u7684\u76df\u53cb\u3002"}, {"question": "\u8718\u86db\u724c\u9ad8\u7d1a\u7b56\u7565\uff1a\u6211\u61c9\u8a72\u591a\u4e45\u91cd\u65b0\u6d17\u724c\u4e00\u6b21\uff1f\u70ba\u4ec0\u9ebc\u6642\u9593\u4f3c\u4e4e\u5c0d\u52dd\u5229\u5982\u6b64\u95dc\u9375\uff1f", "answer": "\u91cd\u65b0\u6d17\u724c\uff0c\u4e5f\u5c31\u662f\u767c\u4e0b\u4e00\u884c\u724c\uff0c\u61c9\u8a72\u88ab\u8996\u70ba\u4e00\u7a2e\u6230\u8853\u300e\u91cd\u7f6e\u300f\u3002\u6642\u9593\u81f3\u95dc\u91cd\u8981\u3002\u5982\u679c\u53ef\u4ee5\u5728\u724c\u5806\u4e0a\u57f7\u884c\u52d5\u4f5c\uff0c\u5373\u4f7f\u770b\u8d77\u4f86\u5f88\u5c0f\uff0c\u4e5f\u4e0d\u8981\u91cd\u65b0\u6d17\u724c\u3002\u5728\u767c\u724c\u4e4b\u524d\uff0c\u8acb\u52d9\u5fc5\u5148\u5617\u8a66\u958b\u555f\u724c\u5217\u6216\u5efa\u7acb\u73fe\u6709\u5e8f\u5217\u3002\u70ba\u4ec0\u9ebc\uff1f\u56e0\u70ba\u6bcf\u767c\u4e0b\u4e00\u884c\u724c\u90fd\u6703\u589e\u52a0\u984d\u5916\u7684\u8907\u96dc\u6027\uff0c\u4e26\u53ef\u80fd\u7522\u751f\u969c\u7919\u3002\u6b64\u5916\uff0c\u5728\u767c\u724c\u4e4b\u524d\u5206\u6790\u7576\u524d\u904a\u6232\u72c0\u614b\u2014\u60a8\u662f\u5426\u6709\u88ab\u9ad8\u50f9\u503c\u724c\u963b\u64cb\u7684\u5e8f\u5217\u6216\u52d5\u4f5c\uff1f\u5982\u679c\u662f\uff0c\u5247\u767c\u724c\u901a\u5e38\u5f88\u597d\u3002\u5982\u679c\u60a8\u7684\u724c\u5217\u4e2d\u6709\u5e7e\u500b\u53ef\u884c\u7684\u52d5\u4f5c\uff0c\u5247\u61c9\u66ab\u505c\u3002\u6b65\u9a5f1\uff1a\u8a55\u4f30\u684c\u9762\u72c0\u614b\u3002\u6b65\u9a5f2\uff1a\u8b58\u5225\u6f5b\u5728\u7684\u963b\u7919\u3002\u6b65\u9a5f3\uff1a\u5982\u679c\u963b\u7919\u8f03\u591a\u6216\u52d5\u4f5c\u8f03\u5c11\uff0c\u5247\u767c\u724c\uff1b\u5426\u5247\u66ab\u505c\u3002"}, {"question": "\u8718\u86db\u724c\u904a\u6232\u4e2d\u7684\u300e\u55ae\u82b1\u8272\u300f\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f\u5728\u4f55\u7a2e\u60c5\u6cc1\u4e0b\uff0c\u5b83\u6bd4\u300e\u56db\u82b1\u8272\u300f\u6216\u300e\u96d9\u82b1\u8272\u300f\u7b56\u7565\u66f4\u512a\u8d8a\uff1f", "answer": "\u300e\u55ae\u82b1\u8272\u300f\u7b56\u7565\u662f\u6700\u7c21\u55ae\u7684\u3002\u5b83\u8868\u793a\u60a8\u50c5\u4f7f\u7528\u4e00\u7a2e\u82b1\u8272\uff08\u4f8b\u5982\uff0c\u50c5\u4f7f\u7528\u9ed1\u6843\uff09\u3002\u9019\u4f7f\u904a\u6232\u986f\u8457\u7c21\u5316\uff0c\u56e0\u70ba\u5728\u5efa\u7acb\u5e8f\u5217\u6642\uff0c\u60a8\u7121\u9700\u64d4\u5fc3\u4ea4\u66ff\u984f\u8272\u6216\u82b1\u8272\u3002\u6b64\u8b8a\u9ad4\u5728\u5b78\u7fd2\u904a\u6232\u7684\u57fa\u672c\u6a5f\u5236\u4e26\u7406\u89e3\u724c\u7684\u79fb\u52d5\u65b9\u5f0f\u6642\u975e\u5e38\u6709\u512a\u52e2\u3002\u5b83\u63d0\u4f9b\u4e86\u4e00\u500b\u7c21\u5316\u7684\u74b0\u5883\uff0c\u8b93\u60a8\u5feb\u901f\u7df4\u7fd2\u6e05\u9664\u724c\u5806\u548c\u5efa\u7acb\u53ef\u89e3\u7684\u5e8f\u5217\u3002\u300e\u56db\u82b1\u8272\u300f\u901a\u5e38\u88ab\u8a8d\u70ba\u6975\u96e3\uff0c\u800c\u300e\u96d9\u82b1\u8272\u300f\u5247\u63d0\u4f9b\u4e00\u500b\u7b56\u7565\u4e2d\u9593\u9ede\uff1b\u55ae\u82b1\u8272\u5141\u8a31\u73a9\u5bb6\u5728\u4ed8\u51fa\u6700\u5c0f\u52aa\u529b\u7684\u60c5\u6cc1\u4e0b\u8d0f\u5f97\u5927\u90e8\u5206\u904a\u6232\u3002\u5c0d\u65bc\u6642\u9593\u6709\u9650\u7684\u65b0\u805e\u7de8\u8f2f\u548c\u5167\u5bb9\u5275\u4f5c\u8005\u4f86\u8aaa\uff0c\u55ae\u82b1\u8272\u8718\u86db\u724c\u904a\u6232\u975e\u5e38\u5b8c\u7f8e\u3002"}, {"question": "\u63cf\u8ff0\u8718\u86db\u724c\u904a\u6232\u7684\u6700\u4f73\u7d50\u5c3e\u7b56\u7565\uff0c\u91cd\u9ede\u653e\u5728\u6392\u5217\u548c\u9806\u5e8f\u7684\u5b8c\u6210\u4e0a\uff0c\u4ee5\u6700\u5927\u5316\u7372\u52dd\u6a5f\u7387\uff1f", "answer": "\u5728\u904a\u6232\u7d50\u5c3e\uff0c\u512a\u5148\u5c07\u5e8f\u5217\u5408\u4f75\u3002\u7406\u60f3\u60c5\u6cc1\u4e0b\uff0c\u76ee\u6a19\u662f\u5728\u4e0d\u540c\u7684\u724c\u5806\u4e2d\u64c1\u6709\u5118\u53ef\u80fd\u591a\u7684\u5b8c\u6574\u6216\u63a5\u8fd1\u5b8c\u6574\u7684\u5e8f\u5217\u3002\u9019\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u4e86\u5c07\u5e8f\u5217\u90e8\u5206\u79fb\u52d5\u5230\u7a7a\u5217\u6642\u7522\u751f\u9023\u9396\u53cd\u61c9\u7684\u53ef\u80fd\u6027\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u6709\u4e00\u7d44\u63a5\u8fd1\u5b8c\u6574\u7684\u9ed1\u6843\u5e8f\u5217\uff0c\u8acb\u5617\u8a66\u5c07\u5176\u4fdd\u6301\u5728\u540c\u4e00\u5340\u57df\u3002\u6700\u7d42\u76ee\u6a19\u662f\u540c\u6642\u6e05\u9664\u6574\u500b\u5e8f\u5217\uff0c\u4ee5\u5275\u5efa\u591a\u500b\u7a7a\u5217\u9032\u884c\u64cd\u4f5c\u3002\u9019\u5141\u8a31\u60a8\u5728\u904a\u6232\u7d50\u675f\u524d\u4fdd\u6301\u5c0d\u904a\u6232\u7684\u63a7\u5236\u3002\u6e05\u9664\u7a7a\u5217\u53ef\u80fd\u662f\u7d50\u5c3e\u968e\u6bb5\u6700\u91cd\u8981\u7684\u4e8b\u9805\u3002\u8acb\u8003\u616e\u4e0b\u8868\uff1a\n[\u30a8\u30f3\u30c9\u30b2\u30fc\u30e0\u6226\u7565\u8868]\n| \u6226\u7565 | \u8aac\u660e | \u512a\u5148\u5ea6 |\n|---|---|---| \n| \u7d71\u5408\u5316 | \u307b\u307c\u5b8c\u6210\u3057\u305f\u9023\u7d9a\u3057\u305f\u30ab\u30fc\u30c9\u3092\u307e\u3068\u3081\u308b | \u9ad8 |\n| \u7a7a\u767d\u306e\u5217 | \u7a7a\u767d\u306e\u5217\u3092\u8907\u6570\u4f5c\u6210\u3059\u308b | \u9ad8 |\n| \u9023\u9396\u53cd\u5fdc | \u8907\u6570\u306e\u9023\u7d9a\u3057\u305f\u30ab\u30fc\u30c9\u3092\u540c\u6642\u306b\u89e3\u6c7a\u3059\u308b\u52d5\u4f5c\u3092\u8a2d\u5b9a\u3059\u308b | \u4e2d |"}, {"question": "\u89e3\u69cb\u8718\u86db\u724c\u904a\u6232\uff1a\u54ea\u4e9b\u5e95\u5c64\u6f14\u7b97\u6cd5\u63a7\u5236\u8457\u724c\u7684\u767c\u724c\u65b9\u5f0f\uff1f\u4e86\u89e3\u9019\u4e9b\u6f14\u7b97\u6cd5\u5982\u4f55\u63d0\u5347\u8cc7\u6df1\u73a9\u5bb6\u7684\u904a\u6232\u6280\u5de7\uff1f", "answer": "\u8718\u86db\u724c\u904a\u6232\u7684\u724c\u767c\u65b9\u5f0f\u901a\u5e38\u57fa\u65bc\u507d\u96a8\u6a5f\u6578\u751f\u6210\u5668 (PRNG)\u3002\u9019\u8868\u793a\u724c\u7684\u6392\u5217\u4e0d\u662f\u771f\u6b63\u96a8\u6a5f\u7684\uff0c\u800c\u662f\u57fa\u65bc\u521d\u59cb\u7a2e\u5b50\u503c\u7684\u78ba\u5b9a\u6027\u5e8f\u5217\u3002\u5118\u7ba1\u60a8\u7121\u6cd5\u9810\u6e2c *\u7cbe\u78ba\u7684* \u724c\u4f4d\u7f6e\uff0c\u4f46\u4e86\u89e3\u9019\u4e9b\u539f\u5247\u6709\u52a9\u65bc\u63d0\u5347\u6280\u5de7\u3002\u77e5\u9053\u5b83\u662f\u507d\u96a8\u6a5f\u7684\uff0c\u610f\u5473\u8457\u67d0\u4e9b\u6a21\u5f0f\u53ef\u80fd\u6703\u51fa\u73fe\uff0c\u5118\u7ba1\u5b83\u5011\u6975\u96e3\u53ef\u9760\u5730\u5229\u7528\u3002\u5982\u679c\u60a8\u8a73\u7d30\u8a18\u9304\u5e7e\u5834\u904a\u6232\uff08\u724c\u7684\u4f4d\u7f6e\u3001\u79fb\u52d5\u7b49\uff09\uff0c\u53ef\u80fd\u6703\u89c0\u5bdf\u5230\u4e00\u4e9b\u9ad8\u7d1a\u91cd\u8907\u8da8\u52e2\uff08\u7136\u800c\uff0c\u60a8\u53ef\u4ee5\u9810\u671f\u4e00\u652f\u5c08\u696d\u6578\u5b78\u5bb6\u5718\u968a\u80fd\u5920\u627e\u5230\u6709\u50f9\u503c\u7684\u6771\u897f\uff09\u3002\u5e95\u5c64\u6f14\u7b97\u6cd5\u65e8\u5728\u751f\u6210\u4e0d\u53ef\u9810\u6e2c\u7684\u72c0\u614b\uff0c\u56e0\u6b64\u8a18\u61b6\u767c\u724c\u6a21\u5f0f\u901a\u5e38\u53ef\u4ee5\u907f\u514d\u3002"}, {"question": "\u8718\u86db\u724c\u904a\u6232\u5982\u4f55\u78ba\u5b9a\u904a\u6232\u7684\u96e3\u5ea6\u7b49\u7d1a\uff1f\u54ea\u4e9b\u6a19\u6e96\u5f71\u97ff\u4e86\u9ad8\u50f9\u503c\u724c\u548c\u4f4e\u50f9\u503c\u724c\u7684\u5206\u914d\uff1f", "answer": "\u8718\u86db\u724c\u904a\u6232\u7684\u904a\u6232\u96e3\u5ea6\u4e3b\u8981\u53d6\u6c7a\u65bc\u904a\u6232\u4e2d\u82b1\u8272\u7684\u6578\u91cf\u3002\u55ae\u82b1\u8272\u662f\u6700\u7c21\u55ae\u7684\uff0c\u800c\u56db\u82b1\u8272\u662f\u6700\u5177\u6311\u6230\u6027\u7684\uff0c\u56e0\u70ba\u60a8\u5fc5\u9808\u7ba1\u7406\u591a\u500b\u5e8f\u5217\u548c\u82b1\u8272\u8b8a\u66f4\u3002\u5728\u767c\u724c\u6642\uff0c\u9ad8\u96e3\u5ea6\u904a\u6232\u4e26\u975e\u7279\u5225\u5c08\u6ce8\u65bc\u78ba\u4fdd\u300e\u9ad8\u50f9\u503c\u300f\u724c\u548c\u300e\u4f4e\u50f9\u503c\u300f\u724c\u7684\u6578\u91cf\u2014\u4f46\u662f\u82b1\u8272\u6578\u91cf\u589e\u52a0\u5f80\u5f80\u6703\u81ea\u7136\u589e\u52a0\u8dd1\u724c\u88ab\u963b\u64cb\u7684\u6a5f\u7387\uff08\u56e0\u70ba\u82b1\u8272\u7684\u885d\u7a81\uff09\u3002\u57fa\u672c\u4e0a\uff0c\u5206\u914d\u7684\u76ee\u6a19\u662f\u4ee3\u8868\u6240\u6709\u724c\u4e26\u6df7\u5408\u5f97\u76f8\u7576\u5747\u52fb\uff0c\u800c\u4e0d\u8ad6\u82b1\u8272\u7684\u6578\u91cf\u3002\u4e86\u89e3\u9019\u4e9b\u53c3\u6578\u4f7f\u73a9\u5bb6\u80fd\u5920\u6839\u64da\u9078\u5b9a\u7684\u82b1\u8272\u689d\u4ef6\u9032\u884c\u66f4\u597d\u7684\u7b56\u7565\u5236\u5b9a\u3002\u82b1\u8272\u8d8a\u591a\uff0c\u7d50\u679c\u8d8a\u96e3\u9810\u6e2c\uff0c\u6240\u9700\u7684\u52aa\u529b\u4e5f\u8d8a\u591a\u3002"}, {"question": "\u8de8\u5e73\u53f0\u8718\u86db\u724c\u904a\u6232\uff1a\u662f\u5426\u6709\u8de8\u5e73\u53f0\u5132\u5b58\u904a\u6232\u7684\u529f\u80fd\uff1f\u5728\u884c\u52d5\u88dd\u7f6e\u4e0a\uff0c\u904a\u6232\u5132\u5b58\u6a94\u901a\u5e38\u5132\u5b58\u65bc\u54ea\u88e1\uff1f", "answer": "\u907a\u61be\u7684\u662f\uff0c\u5927\u591a\u6578\u7368\u7acb\u7248\u7684\u8718\u86db\u724c\u904a\u6232\u4e26\u672a\u539f\u751f\u652f\u63f4\u8de8\u5e73\u53f0\u5132\u5b58\u904a\u6232\u529f\u80fd\u3002\u884c\u52d5\u88dd\u7f6e\u4e0a\u7684\u904a\u6232\u5132\u5b58\u6a94\u901a\u5e38\u5132\u5b58\u5728\u88dd\u7f6e\u5167\u5b58\u4e2d\u61c9\u7528\u7a0b\u5f0f\u5206\u914d\u7684\u5132\u5b58\u7a7a\u9593\u5167\u3002\u7cbe\u78ba\u4f4d\u7f6e\u56e0 Android \u6216 iOS \u7684\u7248\u672c\u800c\u7570\u3002\u8acb\u6ce8\u610f\uff0c\u5927\u591a\u6578\u884c\u52d5\u88dd\u7f6e\u6703\u4ee5\u5b89\u5168\u7684\u65b9\u5f0f\u5132\u5b58\u5132\u5b58\u6a94\uff0c\u4ee5\u9632\u6b62\u8cc7\u6599\u907a\u5931\uff1b\u4e5f\u5c31\u662f\u8aaa\uff0c\u5132\u5b58\u6a94\u6703\u4e0a\u50b3\u5230\u5167\u90e8 Apple/Google \u670d\u52d9\u5668\uff0c\u56e0\u6b64\u53ef\u4ee5\u5728\u76f8\u540c\u751f\u614b\u7cfb\u7d71\u7684\u88dd\u7f6e\u4e4b\u9593\u540c\u6b65\u3002\u4f46\u8718\u86db\u724c\u904a\u6232\u5982\u6b64\u7c21\u55ae\uff0c\u56e0\u6b64\u958b\u767c\u8005\u901a\u5e38\u4e0d\u6703\u91cd\u8996\u8de8\u5e73\u53f0\u652f\u63f4\u3002"}, {"question": "\u9664\u4e86\u7372\u52dd\u4e4b\u5916\uff0c\u5728\u8718\u86db\u724c\u904a\u6232\u4e2d\u9054\u5230\u7279\u5b9a\u5206\u6578\u91cc\u7a0b\u7891\u6216\u9023\u64ca\u5e8f\u5217\uff0c\u662f\u5426\u9084\u6709\u4efb\u4f55\u5f69\u86cb\u6216\u53ef\u89e3\u9396\u5167\u5bb9\uff1f", "answer": "\u96d6\u7136\u8718\u86db\u724c\u904a\u6232\u672c\u8cea\u4e0a\u662f\u4e00\u6b3e\u55ae\u4eba\u7d19\u724c\u904a\u6232\uff0c\u4e26\u4ee5\u6280\u5de7\u70ba\u4e2d\u5fc3\uff0c\u4f46\u67d0\u4e9b\u7248\u672c\u78ba\u5be6\u6703\u63d0\u4f9b\u4e00\u4e9b\u5fae\u5999\u7684\u6210\u5c31\u6216\u8996\u89ba\u81ea\u8a02\u9078\u9805\u4f5c\u70ba\u300e\u734e\u52f5\u300f\u3002\u4f8b\u5982\uff0c\u67d0\u4e9b\u7248\u672c\u5728\u9054\u5230\u7279\u5b9a\u5206\u6578\u91cc\u7a0b\u7891\u6216\u9023\u7e8c\u73a9\u5e7e\u5c40\u904a\u6232\u800c\u4e0d\u4f7f\u7528\u300e\u5fa9\u539f\u300f\u7684\u529f\u80fd\u6642\uff0c\u53ef\u80fd\u6703\u89e3\u9396\u65b0\u7684\u724c\u80cc\u8a2d\u8a08\u3001\u80cc\u666f\u4e3b\u984c\u6216\u7279\u6b8a\u52d5\u756b\u3002\u9019\u4e9b\u5f69\u86cb\u901a\u5e38\u90fd\u5f88\u5c0f\uff0c\u4e0d\u6703\u5f71\u97ff\u6838\u5fc3\u904a\u6232\u73a9\u6cd5\uff0c\u4f46\u5b83\u5011\u70ba\u71b1\u8877\u7684\u73a9\u5bb6\u589e\u52a0\u4e86\u9032\u5ea6\u548c\u81ea\u8a02\u5c64\u9762\u3002\u8acb\u67e5\u770b\u904a\u6232\u7684\u8a2d\u5b9a\u6216\u8aaa\u660e\u9801\u9762\u4ee5\u77ad\u89e3\u53ef\u89e3\u9396\u5167\u5bb9\u4ee5\u53ca\u5982\u4f55\u9054\u6210\u7279\u5b9a\u91cc\u7a0b\u7891\u3002"}]
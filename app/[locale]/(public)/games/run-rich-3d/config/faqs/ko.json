[{"question": "Run Rich 3D\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "Run Rich 3D\ub97c \uc2dc\uc791\ud558\ub824\uba74 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc5d0 \uc775\uc219\ud574\uc9c0\uc138\uc694. \uc870\uc774\uc2a4\ud2f1\uc744 \uc0ac\uc6a9\ud558\uc5ec \uce90\ub9ad\ud130\ub97c \uc774\ub3d9\ud558\uace0, \ud654\uba74\uc744 \ud0ed\ud558\uc5ec \uc810\ud504\ud558\uba70, \uc2a4 \uc640\uc774\ud504\ud558\uc5ec \ud2b9\uc218 \ub3d9\uc791\uc744 \uc218\ud589\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c\ub294 \uc801\uc808\ud55c \uc2dc\uc810\uc5d0 \ud0ed\ud558\uc5ec \uc7a5\uc560\ubb3c\uc744 \ub6f0\uc5b4\ub118\uc5b4\uc57c \ud569\ub2c8\ub2e4. \uc790\uc2e0\uac10\uc744 \ud0a4\uc6b0\uae30 \uc704\ud574 \ud29c\ud1a0\ub9ac\uc5bc\uc5d0\uc11c \uc774\ub7ec\ud55c \ub3d9\uc791\uc744 \uc5f0\uc2b5\ud558\uc138\uc694. [\ube44\uc720 \uc124\uba85: \uc790\ub3d9\ucc28\ub97c \uc6b4\uc804\ud558\ub294 \uac83\ucc98\ub7fc \ucee8\ud2b8\ub864\uc744 \uc0dd\uac01\ud574\ubcf4\uc138\uc694. \ub3c4\ub85c\ub97c \uc8fc\ud589\ud558\uae30 \uc804\uc5d0 \uc2a4\ud2f0\uc5b4\ub9c1\uacfc \ube0c\ub808\uc774\ud06c \uac10\uac01\uc744 \uc775\ud600\uc57c \ud569\ub2c8\ub2e4.]"}, {"question": "100\uc2dc\uac04 \uc774\uc0c1 \uac8c\uc784\uc744 \ud55c \ud6c4 Run Rich 3D\uc5d0\uc11c \ucf54\uc778\uc744 \uac00\uc7a5 \ud6a8\uc728\uc801\uc73c\ub85c \uc5bb\ub294 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "100\uc2dc\uac04\uc774 \uc9c0\ub09c \ud6c4, \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uba74\uc11c \ucf54\uc778 \uc218\uc785\uc744 \uadf9\ub300\ud654\ud558\uc138\uc694. \ub2e8\uacc4 1: \uc885\uc885 \ub192\uc740 \ucf54\uc778 \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud558\ub294 \uc77c\uc77c \ucc4c\ub9b0\uc9c0 \uc644\ub8cc \uc6b0\uc120 \uc21c\uc704\ub97c \uc9c0\uc815\ud558\uc138\uc694. \ub2e8\uacc4 2: \uc790\uc11d\uacfc \uac19\uc740 \uac15\ud654 \uc544\uc774\ud15c\uc744 \ud65c\uc6a9\ud558\uc5ec \ub2ec\ub9ac\ub294 \ub3d9\uc548 \uc790\ub3d9\uc73c\ub85c \ucf54\uc778\uc744 \uc218\uc9d1\ud558\uc138\uc694. \ub2e8\uacc4 3: \ucf54\uc778 \ubc30\uc728\uc774 \ud65c\uc131\ud654\ub41c '\ubd80\uc720 \ubaa8\ub4dc'\uc5d0\uc11c \ud50c\ub808\uc774\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\ud669\uae08 \uc815\uae00' \ub808\ubca8\uc5d0\uc11c \uc790\uc11d\uacfc \ubd80\uc720 \ubaa8\ub4dc\ub97c \uacb0\ud569\ud558\uba74 \ud55c \ubc88\uc758 \ud50c\ub808\uc774\ub2f9 1,000\uac1c \uc774\uc0c1\uc758 \ucf54\uc778\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: \uc77c\ubc18\uc801\uc778 \ud50c\ub808\uc774\ub294 \uc548\uc815\uc801\uc774\uc9c0\ub9cc, \ubd80\uc720 \ubaa8\ub4dc\ub294 \uac70\uc758 \ub178\ub825 \uc5c6\uc774 \uc218\uc775\uc744 \ud06c\uac8c \ub192\uc785\ub2c8\ub2e4.]"}, {"question": "Run Rich 3D\uc758 \uc2a4\ud0dc\ubbf8\ub098 \uc2dc\uc2a4\ud15c\uc774 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc81c\ud55c\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Run Rich 3D\uc758 \uc2a4\ud0dc\ubbf8\ub098 \uc2dc\uc2a4\ud15c\uc740 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uade0\ud615 \uc788\uac8c \uc720\uc9c0\ud558\uace0 \uc804\ub7b5\uc801\uc778 \ud50c\ub808\uc774\ub97c \uc7a5\ub824\ud558\uae30 \uc704\ud574 \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc774\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \uad11\uace0 \uc2dc\uccad \ub610\ub294 \uc5d0\ub108\uc9c0 \uc74c\ub8cc\uc640 \uac19\uc740 \uac8c\uc784 \ub0b4 \uc544\uc774\ud15c\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc2a4\ud0dc\ubbf8\ub098\ub97c \ucda9\uc804\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ubcf4\uc2a4\uc804 \uc911 \uc2a4\ud0dc\ubbf8\ub098\uac00 \ubd80\uc871\ud558\uba74 \uc5d0\ub108\uc9c0 \uc74c\ub8cc\ub85c \ubc14\ub85c \ub9c9\ub300\ub97c \ucc44\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50 \ud45c: \uc77c\ubc18 \ucda9\uc804: 5\ubd84\ub9c8\ub2e4 1 \uc2a4\ud0dc\ubbf8\ub098; \uc5d0\ub108\uc9c0 \uc74c\ub8cc: \uc989\uc2dc \uc644\uc804 \ucda9\uc804.]"}, {"question": "Run Rich 3D\uc758 \uce90\ub9ad\ud130 \uc131\uc7a5 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uc5b4\ub5a4 \uc694\uc778\uc774 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "Run Rich 3D\uc758 \uce90\ub9ad\ud130 \uc131\uc7a5\uc740 \uacbd\ud5d8\uce58(XP)\uc640 \uc7a5\ube44 \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0 \uc758\ud574 \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \ub808\ubca8 \ubc0f \ubbf8\uc158\uc744 \uc644\ub8cc\ud558\uc5ec XP\ub97c \uc5bb\uc740 \ub2e4\uc74c, \uc774\ub97c \uc0ac\uc6a9\ud558\uc5ec \uce90\ub9ad\ud130 \ub808\ubca8\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc138\uc694. '\ud669\uae08 \ubd80\uce20'\uc640 \uac19\uc740 \uc7a5\ube44\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uba74 \uc18d\ub3c4 \ubc0f \uc810\ud504 \ub192\uc774\uc640 \uac19\uc740 \ub2a5\ub825\uc774 \ud5a5\uc0c1\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 5\uc758 \uce90\ub9ad\ud130\uac00 \ubd80\uce20\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud55c \uacbd\uc6b0 '\ud558\ub298 \ub192\uc774' \ub808\ubca8\uc5d0\uc11c \ub354 \uae34 \uac04\uaca9\uc744 \ub6f0\uc5b4\ub118\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: XP \ud68d\ub4dd \u2192 \ub808\ubca8 \uc5c5 \u2192 \ub2a5\ub825 \ud574\uc81c \u2192 \uc7a5\ube44 \uc5c5\uadf8\ub808\uc774\ub4dc \u2192 \uc131\ub2a5 \ud5a5\uc0c1.]"}, {"question": "Run Rich 3D\uc5d0\uc11c \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \uac15\ud654 \uc544\uc774\ud15c\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \uc7a5\uc560\ubb3c\ub85c\ubd80\ud130 \ubcf4\ud638\ud558\ub294 \ubc29\ud328\uc640 \uc7a5\uc2dc\uac04 \ube44\ud589\uc744 \uac00\ub2a5\ud558\uac8c \ud558\ub294 \uc81c\ud2b8\ud329\uacfc \uac19\uc740 \uac15\ud654 \uc544\uc774\ud15c\uc5d0 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc6a9\uc554 \ub545' \ub808\ubca8\uc5d0\uc11c \ubc29\ud328\ub294 \uc6a9\uc554 \uad6c\ub369\uc774\uc5d0 \ube60\uc9c0\ub294 \uac83\uc744 \ubc29\uc9c0\ud558\uace0, \uc81c\ud2b8\ud329\uc740 \ud070 \uac04\uaca9\uc744 \uc774\ub3d9\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: \ubc29\ud328: \ubc29\uc5b4; \uc81c\ud2b8\ud329: \uacf5\uaca9; \uc790\uc11d: \uc720\ud2f8\ub9ac\ud2f0.]"}, {"question": "Run Rich 3D\uc758 '\ud074\ub798\uc2dd \ubaa8\ub4dc'\uc640 '\ubd80\uc720 \ubaa8\ub4dc'\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Run Rich 3D\uc758 \ud074\ub798\uc2dd \ubaa8\ub4dc\ub294 \uc804\ud1b5\uc801\uc778 \ub05d\uc5c6\ub294 \ub7ec\ub108 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud558\ub294 \ubc18\uba74, \ubd80\uc720 \ubaa8\ub4dc\ub294 \ucf54\uc778 \ubc30\uc728\uacfc \ud76c\uadc0 \uac15\ud654 \uc544\uc774\ud15c\uc744 \ub3c4\uc785\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubd80\uc720 \ubaa8\ub4dc\uc5d0\uc11c \uc81c\ud55c\ub41c \uc2dc\uac04 \ub3d9\uc548 \uc218\uc785\uc744 \ub450 \ubc30\ub85c \ub9cc\ub4dc\ub294 '\ud669\uae08 \ucf54\uc778'\uc744 \ub9cc\ub0a0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50 \ud45c: \ud074\ub798\uc2dd \ubaa8\ub4dc: \ud45c\uc900 \uac8c\uc784 \ud50c\ub808\uc774; \ubd80\uc720 \ubaa8\ub4dc: 2\ubc30 \ucf54\uc778, \ud76c\uadc0 \uac15\ud654 \uc544\uc774\ud15c.]"}, {"question": "\ud734\ub300\ud3f0\uc5d0\uc11c \ud0dc\ube14\ub9bf\uc73c\ub85c Run Rich 3D\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub824\uba74 \ub450 \uae30\uae30 \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uc124\uc815 \uba54\ub274\uc758 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub370\uc774\ud130\ub97c \uc5c5\ub85c\ub4dc\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud734\ub300\ud3f0\uc5d0\uc11c '\uc0ac\ub9c9 \uc9c8\uc8fc' \ub808\ubca8\uc744 \uc644\ub8cc\ud588\ub2e4\uba74 \ud0dc\ube14\ub9bf\uc5d0 \ub85c\uadf8\uc778\ud558\uba74 \uc774 \uc9c4\ud589 \uc0c1\ud669\uc774 \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc740 \ub3c4\uc11c\uad00 \uce74\ub4dc\uc640 \uac19\uc2b5\ub2c8\ub2e4. \ubaa8\ub4e0 \uae30\uae30\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc774 \uc800\uc7a5\ub418\uace0 \uc561\uc138\uc2a4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "Run Rich 3D\uc5d0\uc11c \uc5b4\ub5a4 \uc228\uaca8\uc9c4 \uc131\ucde8\ub3c4\ub97c \ud574\uc81c\ud560 \uc218 \uc788\uc73c\uba70, \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Run Rich 3D\uc758 \uc228\uaca8\uc9c4 \uc131\ucde8\ub3c4\ub294 \uc885\uc885 \ud2b9\uc815 \ud589\ub3d9\uc744 \ud544\uc694\ub85c \ud569\ub2c8\ub2e4. \ud55c \ubc88\uc758 \ub7f0\uc5d0\uc11c 100\uac1c\uc758 \ucf54\uc778\uc744 \uc218\uc9d1\ud558\uac70\ub098 \ubcf4\uc2a4\ub97c \ud53c\ud574\uc5c6\uc774 \ubb3c\ub9ac\uce58\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ucf54\uc778 \uc218\uc9d1\uac00' \uc131\ucde8\ub3c4\ub294 '\ubcf4\ubb3c \ud56d\uad6c' \ub808\ubca8\uc5d0\uc11c 1,000\uac1c\uc758 \ucf54\uc778\uc744 \ubaa8\uc544\uc11c \ud574\uc81c\ub429\ub2c8\ub2e4. [\ubcf4\ub108\uc2a4 \ud68d\ub4dd: \uac8c\uc784 \ub0b4 \ud2b9\uc774\ud55c \ud589\ub3d9\uc5d0 \uc8fc\uc758\ud558\uc138\uc694. \uc774\ub4e4\uc774 \uc885\uc885 \uc228\uaca8\uc9c4 \uc131\ucde8\ub3c4\ub97c \uc720\ubc1c\ud569\ub2c8\ub2e4.]"}, {"question": "Run Rich 3D\uc758 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "Run Rich 3D\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uc758 \uae30\uc220 \ub808\ubca8\uacfc \uc9c4\ud589 \uc0c1\ud669\uc744 \uae30\ubc18\uc73c\ub85c \ud50c\ub808\uc774\uc5b4\ub97c \ud398\uc5b4\ub9c1\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 50\uac1c\uc758 \ub808\ubca8\uc744 \uc644\ub8cc\ud588\ub2e4\uba74 \ube44\uc2b7\ud55c \uacbd\ud5d8\uc744 \uac00\uc9c4 \ud50c\ub808\uc774\uc5b4\uc640 \ub9e4\uce6d\ub420 \uac83\uc785\ub2c8\ub2e4. \uc2dc\uc2a4\ud15c\uc740 \ub610\ud55c \uade0\ud615 \uc7a1\ud78c \ub9e4\uce58\ub97c \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 \ucd5c\uadfc \uc131\uacfc\ub97c \uace0\ub824\ud569\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uae30\uc220 \ub808\ubca8 + \uc9c4\ud589 \uc0c1\ud669 + \ucd5c\uadfc \uc131\uacfc \u2192 \ub9e4\uce6d.]"}, {"question": "Run Rich 3D\uc5d0\uc11c \ubcf4\uc11d\uc744 \uac00\uc7a5 \ud6a8\uc728\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Run Rich 3D\uc5d0\uc11c \ubcf4\uc11d\uc740 \uce90\ub9ad\ud130 \uc2ac\ub86f\uc774\ub098 \ud504\ub9ac\ubbf8\uc5c4 \uac15\ud654 \uc544\uc774\ud15c\uacfc \uac19\uc740 \uc601\uad6c \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucd94\uac00 \uce90\ub9ad\ud130 \uc2ac\ub86f\uc744 \ud574\uc81c\ud558\uba74 \ub2e4\uc591\ud55c \ub2a5\ub825\uc744 \uac00\uc9c4 \uce90\ub9ad\ud130\ub97c \uc804\ud658\ud558\uc5ec \ub2e4\uc591\uc131\uc744 \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc77c\uc2dc\uc801\uc778 \ubd80\uc2a4\ud2b8\uc5d0 \ubcf4\uc11d\uc744 \uc0ac\uc6a9\ud558\ub294 \uac83\uc740 \uc7a5\uae30\uc801\uc778 \uac00\uce58\uac00 \ub0ae\uc73c\ubbc0\ub85c \ud53c\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: \uc601\uad6c \uc5c5\uadf8\ub808\uc774\ub4dc: \ub192\uc740 \uac00\uce58; \uc77c\uc2dc\uc801 \ubd80\uc2a4\ud2b8: \ub0ae\uc740 \uac00\uce58.]"}]
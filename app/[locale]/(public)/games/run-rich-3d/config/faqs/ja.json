[{"question": "Run Rich 3D\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u3059\u3050\u306b\u59cb\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Run Rich 3D\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u899a\u3048\u307e\u3057\u3087\u3046\u3002\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u3092\u4f7f\u3063\u3066\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u79fb\u52d5\u3057\u3001\u753b\u9762\u3092\u30bf\u30c3\u30d7\u3057\u3066\u30b8\u30e3\u30f3\u30d7\u3057\u3001\u30b9\u30ef\u30a4\u30d7\u3057\u3066\u7279\u6b8a\u306a\u6280\u3092\u5b9f\u884c\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u9069\u5207\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u30bf\u30c3\u30d7\u3057\u3066\u969c\u5bb3\u7269\u3092\u98db\u3073\u8d8a\u3048\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u64cd\u4f5c\u306f\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3067\u7df4\u7fd2\u3057\u3066\u3001\u81ea\u4fe1\u3092\u6df1\u3081\u307e\u3057\u3087\u3046\u3002[\u4f8b\uff1a\u64cd\u4f5c\u306f\u8eca\u306e\u904b\u8ee2\u3068\u4e00\u7dd2\u3067\u3059\u3002\u9053\u8def\u306b\u51fa\u308b\u524d\u306b\u3001\u30cf\u30f3\u30c9\u30eb\u3084\u30d6\u30ec\u30fc\u30ad\u306e\u611f\u899a\u3092\u63b4\u3080\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002]"}, {"question": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001Run Rich 3D\u3067\u30b3\u30a4\u30f3\u3092\u6700\u3082\u52b9\u7387\u7684\u306b\u7372\u5f97\u3059\u308b\u306b\u306f\u3001\u3069\u306e\u3088\u3046\u306a\u6226\u7565\u304c\u6709\u52b9\u3067\u3059\u304b\uff1f", "answer": "100\u6642\u9593\u30d7\u30ec\u30a4\u5f8c\u3001\u30b3\u30a4\u30f3\u7372\u5f97\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u65e5\u3005\u306e\u8ab2\u984c\u3092\u512a\u5148\u7684\u306b\u5b8c\u4e86\u3057\u307e\u3059\u3002\u591a\u304f\u306e\u5834\u5408\u3001\u9ad8\u984d\u306e\u30b3\u30a4\u30f3\u5831\u916c\u304c\u5f97\u3089\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u78c1\u77f3\u306a\u3069\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u3092\u4f7f\u3063\u3066\u3001\u30e9\u30f3\u30cb\u30f3\u30b0\u4e2d\u306b\u81ea\u52d5\u7684\u306b\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b3\u30a4\u30f3\u500d\u7387\u304c\u6709\u52b9\u306a\u300c\u30ea\u30c3\u30c1\u30e2\u30fc\u30c9\u300d\u3067\u30d7\u30ec\u30a4\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30b4\u30fc\u30eb\u30c7\u30f3\u30b8\u30e3\u30f3\u30b0\u30eb\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u78c1\u77f3\u3068\u30ea\u30c3\u30c1\u30e2\u30fc\u30c9\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u30011\u30b2\u30fc\u30e0\u3042\u305f\u308a1000\u500b\u4ee5\u4e0a\u306e\u5831\u916c\u304c\u5f97\u3089\u308c\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u901a\u5e38\u306e\u30e9\u30f3\u3067\u306f\u5b89\u5b9a\u3057\u305f\u5831\u916c\u3092\u5f97\u3089\u308c\u307e\u3059\u304c\u3001\u30ea\u30c3\u30c1\u30e2\u30fc\u30c9\u3067\u306f\u6700\u5c0f\u9650\u306e\u52aa\u529b\u3067\u53ce\u76ca\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002]"}, {"question": "Run Rich 3D\u306e\u30b9\u30bf\u30df\u30ca\u30b7\u30b9\u30c6\u30e0\u304c\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5236\u9650\u3059\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u3069\u306e\u3088\u3046\u306b\u6700\u9069\u5316\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Run Rich 3D\u306e\u30b9\u30bf\u30df\u30ca\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u30d0\u30e9\u30f3\u30b9\u3055\u305b\u3001\u6226\u7565\u7684\u306a\u30d7\u30ec\u30a4\u3092\u5968\u52b1\u3059\u308b\u305f\u3081\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u5e83\u544a\u306e\u8996\u8074\u3084\u3001\u30a8\u30ca\u30b8\u30fc\u30c9\u30ea\u30f3\u30af\u306a\u3069\u306e\u30b2\u30fc\u30e0\u5185\u30a2\u30a4\u30c6\u30e0\u3092\u4f7f\u7528\u3057\u3066\u30b9\u30bf\u30df\u30ca\u3092\u56de\u5fa9\u3055\u305b\u307e\u3057\u3087\u3046\u3002\u305f\u3068\u3048\u3070\u3001\u30dc\u30b9\u6226\u4e2d\u306b\u30b9\u30bf\u30df\u30ca\u304c\u4e0d\u8db3\u3057\u3066\u3044\u308b\u5834\u5408\u306f\u3001\u30a8\u30ca\u30b8\u30fc\u30c9\u30ea\u30f3\u30af\u3067\u30d0\u30fc\u3092\u77ac\u6642\u306b\u56de\u5fa9\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u4ed5\u69d8\u8868\uff1a\u901a\u5e38\u306e\u56de\u5fa9\uff1a5\u5206\u9593\u306b1\u30b9\u30bf\u30df\u30ca\u3001\u30a8\u30ca\u30b8\u30fc\u30c9\u30ea\u30f3\u30af\uff1a\u5373\u6642\u5168\u56de\u5fa9\u3002]"}, {"question": "Run Rich 3D\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u9032\u6b69\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u3069\u306e\u3088\u3046\u306a\u8981\u56e0\u304c\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "Run Rich 3D\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u6210\u9577\u306f\u3001\u7d4c\u9a13\u5024\uff08XP\uff09\u3068\u88c5\u5099\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u3088\u3063\u3066\u5f71\u97ff\u3055\u308c\u307e\u3059\u3002\u30ec\u30d9\u30eb\u3068\u30df\u30c3\u30b7\u30e7\u30f3\u3092\u30af\u30ea\u30a2\u3059\u308b\u3053\u3068\u3067XP\u3092\u7372\u5f97\u3057\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b4\u30fc\u30eb\u30c7\u30f3\u30d6\u30fc\u30c4\u306a\u3069\u306e\u88c5\u5099\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3053\u3068\u3067\u3001\u901f\u5ea6\u3084\u30b8\u30e3\u30f3\u30d7\u529b\u306a\u3069\u306e\u80fd\u529b\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30b9\u30ab\u30a4\u30cf\u30a4\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30ec\u30d9\u30eb5\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3067\u30d6\u30fc\u30c4\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3068\u3001\u3088\u308a\u9577\u3044\u9593\u9694\u3092\u30af\u30ea\u30a2\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u7d4c\u9a13\u5024\u7372\u5f97\u2192\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u2192\u80fd\u529b\u89e3\u653e\u2192\u88c5\u5099\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u2192\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u5f37\u5316\u3002]"}, {"question": "Run Rich 3D\u3067\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u6700\u3082\u52b9\u679c\u7684\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u969c\u5bb3\u7269\u304b\u3089\u8eab\u3092\u5b88\u3063\u3066\u304f\u308c\u308b\u30b7\u30fc\u30eb\u30c9\u3084\u3001\u98db\u884c\u6642\u9593\u3092\u9577\u304f\u3057\u3066\u304f\u308c\u308b\u30b8\u30a7\u30c3\u30c8\u30d1\u30c3\u30af\u306a\u3069\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3079\u304d\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u6eb6\u5ca9\u5730\u5e2f\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30b7\u30fc\u30eb\u30c9\u3067\u6eb6\u5ca9\u306e\u7a74\u306b\u843d\u3061\u308b\u306e\u3092\u9632\u304e\u3001\u30b8\u30a7\u30c3\u30c8\u30d1\u30c3\u30af\u3067\u5927\u304d\u306a\u9699\u9593\u3092\u4e57\u308a\u8d8a\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u30b7\u30fc\u30eb\u30c9\uff1a\u9632\u5fa1\u529b\u3001\u30b8\u30a7\u30c3\u30c8\u30d1\u30c3\u30af\uff1a\u653b\u6483\u529b\u3001\u78c1\u77f3\uff1a\u88dc\u52a9\u7684\u3002]"}, {"question": "Run Rich 3D\u306e\u300c\u30af\u30e9\u30b7\u30c3\u30af\u30e2\u30fc\u30c9\u300d\u3068\u300c\u30ea\u30c3\u30c1\u30e2\u30fc\u30c9\u300d\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Run Rich 3D\u306e\u30af\u30e9\u30b7\u30c3\u30af\u30e2\u30fc\u30c9\u306f\u3001\u5f93\u6765\u306e\u30a8\u30f3\u30c9\u30ec\u30b9\u30e9\u30f3\u30ca\u30fc\u306e\u4f53\u9a13\u3092\u63d0\u4f9b\u3057\u307e\u3059\u304c\u3001\u30ea\u30c3\u30c1\u30e2\u30fc\u30c9\u3067\u306f\u30b3\u30a4\u30f3\u500d\u7387\u3068\u30ec\u30a2\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u304c\u5c0e\u5165\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ea\u30c3\u30c1\u30e2\u30fc\u30c9\u3067\u306f\u3001\u9650\u5b9a\u6642\u9593\u5185\u3067\u53ce\u76ca\u3092\u500d\u5897\u3055\u305b\u308b\u300c\u30b4\u30fc\u30eb\u30c7\u30f3\u30b3\u30a4\u30f3\u300d\u306b\u51fa\u4f1a\u3048\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002[\u4ed5\u69d8\u8868\uff1a\u30af\u30e9\u30b7\u30c3\u30af\u30e2\u30fc\u30c9\uff1a\u6a19\u6e96\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3001\u30ea\u30c3\u30c1\u30e2\u30fc\u30c9\uff1a\u30b3\u30a4\u30f32\u500d\u3001\u30ec\u30a2\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3002]"}, {"question": "\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u3001\u79c1\u306eRun Rich 3D\u306e\u9032\u6357\u72b6\u6cc1\u3092\u30b9\u30de\u30fc\u30c8\u30d5\u30a9\u30f3\u304b\u3089\u30bf\u30d6\u30ec\u30c3\u30c8\u306b\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u9032\u6357\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u306e\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u3001\u30c7\u30fc\u30bf\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30b9\u30de\u30fc\u30c8\u30d5\u30a9\u30f3\u3067\u300c\u7802\u6f20\u306e\u75be\u8d70\u300d\u30ec\u30d9\u30eb\u3092\u5b8c\u4e86\u3057\u305f\u5834\u5408\u3001\u30bf\u30d6\u30ec\u30c3\u30c8\u3067\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3068\u3001\u3053\u306e\u9032\u6357\u72b6\u6cc1\u304c\u540c\u671f\u3055\u308c\u307e\u3059\u3002[\u4f8b\uff1a\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u306f\u3001\u56f3\u66f8\u9928\u30ab\u30fc\u30c9\u3068\u540c\u69d8\u3067\u3059\u3002\u9032\u6357\u72b6\u6cc1\u304c\u4fdd\u5b58\u3055\u308c\u3001\u3042\u3089\u3086\u308b\u30c7\u30d0\u30a4\u30b9\u3067\u30a2\u30af\u30bb\u30b9\u53ef\u80fd\u3067\u3059\u3002]"}, {"question": "Run Rich 3D\u3067\u96a0\u3055\u308c\u305f\u5b9f\u7e3e\u306f\u4f55\u304b\u3001\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u898b\u3064\u3051\u3089\u308c\u307e\u3059\u304b\uff1f", "answer": "Run Rich 3D\u306e\u96a0\u308c\u305f\u5b9f\u7e3e\u306f\u30011\u3064\u306e\u30e9\u30f3\u3067100\u500b\u306e\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u308b\u3001\u307e\u305f\u306f\u30dc\u30b9\u3092\u5012\u3059\u3053\u3068\u306a\u304f\u30c0\u30e1\u30fc\u30b8\u3092\u53d7\u3051\u305a\u306b\u30af\u30ea\u30a2\u3059\u308b\u306a\u3069\u3001\u7279\u5b9a\u306e\u884c\u52d5\u304c\u5fc5\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30b3\u30a4\u30f3\u30b3\u30ec\u30af\u30bf\u30fc\u300d\u3068\u3044\u3046\u5b9f\u7e3e\u306f\u3001\u300c\u5b9d\u306e\u5165\u308a\u6c5f\u300d\u30ec\u30d9\u30eb\u30671000\u500b\u306e\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u308b\u3053\u3068\u3067\u89e3\u9664\u3055\u308c\u307e\u3059\u3002[\u30d2\u30f3\u30c8\uff1a\u7570\u5e38\u306a\u30b2\u30fc\u30e0\u5185\u884c\u52d5\u306b\u6ce8\u610f\u3057\u307e\u3057\u3087\u3046\u3002\u305d\u308c\u3089\u306f\u96a0\u3055\u308c\u305f\u5b9f\u7e3e\u306e\u30c8\u30ea\u30ac\u30fc\u3068\u306a\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002]"}, {"question": "Run Rich 3D\u306e\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306b\u304a\u3051\u308b\u30de\u30c3\u30c1\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "Run Rich 3D\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u3068\u9032\u6357\u72b6\u6cc1\u306b\u57fa\u3065\u3044\u3066\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u30da\u30a2\u30ea\u30f3\u30b0\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u300150\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3057\u3066\u3044\u308b\u5834\u5408\u3001\u7d4c\u9a13\u5024\u304c\u985e\u4f3c\u3057\u305f\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u30de\u30c3\u30c1\u30f3\u30b0\u3055\u308c\u307e\u3059\u3002\u30b7\u30b9\u30c6\u30e0\u306f\u6700\u8fd1\u306e\u6210\u7e3e\u3082\u8003\u616e\u3057\u3066\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u53d6\u308c\u305f\u30de\u30c3\u30c1\u30f3\u30b0\u3092\u5b9f\u73fe\u3057\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb+\u9032\u6357\u72b6\u6cc1+\u6700\u8fd1\u306e\u6210\u7e3e\u2192\u30de\u30c3\u30c1\u30f3\u30b0\u3002]"}, {"question": "Run Rich 3D\u3067\u30b8\u30a7\u30e0\u3092\u6700\u3082\u52b9\u7387\u7684\u306b\u4f7f\u3046\u65b9\u6cd5\u306f\uff1f", "answer": "Run Rich 3D\u306e\u30b8\u30a7\u30e0\u306f\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30b9\u30ed\u30c3\u30c8\u3084\u30d7\u30ec\u30df\u30a2\u30e0\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306a\u3069\u306e\u6c38\u4e45\u7684\u306a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u4f7f\u3046\u306e\u304c\u6700\u9069\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u8ffd\u52a0\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30b9\u30ed\u30c3\u30c8\u3092\u89e3\u653e\u3059\u308b\u3068\u3001\u3055\u307e\u3056\u307e\u306a\u80fd\u529b\u3092\u6301\u3064\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u5207\u308a\u66ff\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u3001\u4f7f\u3044\u3084\u3059\u3055\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002\u4e00\u6642\u7684\u306a\u30d6\u30fc\u30b9\u30c8\u306b\u30b8\u30a7\u30e0\u3092\u4f7f\u3046\u3053\u3068\u306f\u907f\u3051\u307e\u3057\u3087\u3046\u3001\u305d\u306e\u4fa1\u5024\u306f\u9577\u671f\u7684\u306b\u306f\u4f4e\u3044\u304b\u3089\u3067\u3059\u3002[\u6bd4\u8f03\uff1a\u6c38\u4e45\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\uff1a\u9ad8\u4fa1\u5024\u3001\u4e00\u6642\u7684\u306a\u30d6\u30fc\u30b9\u30c8\uff1a\u4f4e\u4fa1\u5024\u3002]"}]
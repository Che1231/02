[{"question": "\u5982\u4f55\u5feb\u901f\u4e0a\u624bRun Rich 3D\u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u5f00\u59cb\u4f7f\u7528Run Rich 3D\uff0c\u8bf7\u719f\u6089\u57fa\u672c\u63a7\u5236\uff1a\u4f7f\u7528\u64cd\u7eb5\u6746\u79fb\u52a8\u89d2\u8272\uff0c\u70b9\u51fb\u5c4f\u5e55\u8df3\u8dc3\uff0c\u5e76\u6ed1\u52a8\u5c4f\u5e55\u6267\u884c\u7279\u6b8a\u52a8\u4f5c\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u5173\u4e2d\uff0c\u60a8\u9700\u8981\u5728\u6b63\u786e\u7684\u65f6\u95f4\u70b9\u51fb\u5c4f\u5e55\u624d\u80fd\u8df3\u8fc7\u969c\u788d\u3002\u5728\u6559\u7a0b\u4e2d\u7ec3\u4e60\u8fd9\u4e9b\u64cd\u4f5c\uff0c\u4ee5\u5efa\u7acb\u4fe1\u5fc3\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u63a7\u5236\u60f3\u8c61\u6210\u5f00\u8f66\uff1b\u5728\u4e0a\u8def\u4e4b\u524d\uff0c\u60a8\u9700\u8981\u638c\u63e1\u65b9\u5411\u76d8\u548c\u5239\u8f66\u3002]"}, {"question": "\u5728\u6e38\u620f100\u5c0f\u65f6\u540e\uff0c\u5728Run Rich 3D\u4e2d\u83b7\u5f97\u786c\u5e01\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "100\u5c0f\u65f6\u540e\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u786c\u5e01\u6536\u76ca\uff1a\u6b65\u9aa41\uff1a\u4f18\u5148\u5b8c\u6210\u6bcf\u65e5\u6311\u6218\uff0c\u8fd9\u4e9b\u6311\u6218\u901a\u5e38\u63d0\u4f9b\u4e30\u539a\u7684\u786c\u5e01\u5956\u52b1\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u78c1\u94c1\u7b49\u9053\u5177\uff0c\u5728\u5954\u8dd1\u8fc7\u7a0b\u4e2d\u81ea\u52a8\u6536\u96c6\u786c\u5e01\u3002\u6b65\u9aa43\uff1a\u5728\u201c\u5bcc\u88d5\u6a21\u5f0f\u201d\u4e2d\u8fdb\u884c\u6e38\u620f\uff0c\u5728\u8be5\u6a21\u5f0f\u4e0b\uff0c\u786c\u5e01\u500d\u6570\u5904\u4e8e\u6d3b\u52a8\u72b6\u6001\u3002\u4f8b\u5982\uff0c\u5728\u201c\u9ec4\u91d1\u4e1b\u6797\u201d\u5173\u5361\u4e2d\uff0c\u5c06\u78c1\u94c1\u4e0e\u5bcc\u88d5\u6a21\u5f0f\u7ed3\u5408\u4f7f\u7528\uff0c\u6bcf\u6b21\u8fd0\u884c\u53ef\u4ee5\u83b7\u5f97\u8d85\u8fc71000\u679a\u786c\u5e01\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u666e\u901a\u6e38\u620f\u8fd0\u884c\u6301\u7eed\u7a33\u5b9a\uff0c\u800c\u5bcc\u88d5\u6a21\u5f0f\u5219\u5728\u51e0\u4e4e\u65e0\u9700\u989d\u5916\u52aa\u529b\u7684\u60c5\u51b5\u4e0b\u663e\u8457\u63d0\u9ad8\u6536\u76ca\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48Run Rich 3D\u7684\u4f53\u529b\u7cfb\u7edf\u4f1a\u9650\u5236\u6e38\u620f\uff0c\u6211\u8be5\u5982\u4f55\u4f18\u5316\u5b83\uff1f", "answer": "Run Rich 3D\u7684\u4f53\u529b\u7cfb\u7edf\u65e8\u5728\u5e73\u8861\u6e38\u620f\u4f53\u9a8c\uff0c\u5e76\u9f13\u52b1\u73a9\u5bb6\u8fdb\u884c\u6218\u7565\u6027\u6e38\u620f\u3002\u8981\u4f18\u5316\u5b83\uff0c\u53ef\u4ee5\u901a\u8fc7\u89c2\u770b\u5e7f\u544a\u6216\u4f7f\u7528\u6e38\u620f\u9053\u5177\uff08\u4f8b\u5982\u80fd\u91cf\u996e\u6599\uff09\u6765\u6062\u590d\u4f53\u529b\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5728\u4e0eBoss\u6218\u6597\u65f6\u4f53\u529b\u4e0d\u8db3\uff0c\u80fd\u91cf\u996e\u6599\u53ef\u4ee5\u7acb\u5373\u8865\u5145\u4f53\u529b\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u666e\u901a\u6062\u590d\uff1a\u6bcf5\u5206\u949f\u6062\u590d1\u70b9\u4f53\u529b\uff1b\u80fd\u91cf\u996e\u6599\uff1a\u7acb\u5373\u5b8c\u5168\u6062\u590d\u3002]"}, {"question": "Run Rich 3D\u7684\u89d2\u8272\u5347\u7ea7\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u5b83\uff1f", "answer": "Run Rich 3D\u4e2d\u7684\u89d2\u8272\u5347\u7ea7\u53d7\u7ecf\u9a8c\u503c\uff08XP\uff09\u548c\u88c5\u5907\u5347\u7ea7\u7684\u5f71\u54cd\u3002\u901a\u8fc7\u5b8c\u6210\u5173\u5361\u548c\u4efb\u52a1\u6765\u83b7\u5f97\u7ecf\u9a8c\u503c\uff0c\u7136\u540e\u4f7f\u7528\u7ecf\u9a8c\u503c\u6765\u63d0\u5347\u89d2\u8272\u7b49\u7ea7\u3002\u5347\u7ea7\u88c5\u5907\uff0c\u4f8b\u5982\u201c\u9ec4\u91d1\u9774\u5b50\u201d\uff0c\u4f1a\u589e\u5f3a\u8bf8\u5982\u901f\u5ea6\u548c\u8df3\u8dc3\u9ad8\u5ea6\u7b49\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5929\u7a7a\u4e4b\u9ad8\u201d\u5173\u5361\u4e2d\uff0c\u7b49\u7ea75\u7684\u89d2\u8272\u5347\u7ea7\u4e86\u9774\u5b50\uff0c\u53ef\u4ee5\u8de8\u8d8a\u66f4\u957f\u7684\u8ddd\u79bb\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u7ecf\u9a8c\u503c\u83b7\u53d6\u2192\u7b49\u7ea7\u63d0\u5347\u2192\u89e3\u9501\u80fd\u529b\u2192\u5347\u7ea7\u88c5\u5907\u2192\u6027\u80fd\u589e\u5f3a\u3002]"}, {"question": "\u5728Run Rich 3D\u4e2d\uff0c\u54ea\u4e9b\u9053\u5177\u5bf9\u4e8e\u9ad8\u7ea7\u73a9\u5bb6\u6765\u8bf4\u6700\u6709\u6548\uff1f", "answer": "\u9ad8\u7ea7\u73a9\u5bb6\u5e94\u8be5\u4e13\u6ce8\u4e8e\u76fe\u724c\uff08\u4fdd\u62a4\u514d\u53d7\u969c\u788d\u7269\u4f24\u5bb3\uff09\u548c\u55b7\u6c14\u80cc\u5305\uff08\u5141\u8bb8\u66f4\u957f\u65f6\u95f4\u98de\u884c\uff09\u7b49\u9053\u5177\u3002\u4f8b\u5982\uff0c\u5728\u201c\u7194\u5ca9\u4e4b\u5730\u201d\u5173\u5361\u4e2d\uff0c\u76fe\u724c\u53ef\u4ee5\u9632\u6b62\u6389\u5165\u7194\u5ca9\u5751\uff0c\u800c\u55b7\u6c14\u80cc\u5305\u6709\u52a9\u4e8e\u8de8\u8d8a\u8f83\u5927\u7684\u7a7a\u9699\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u76fe\u724c\uff1a\u9632\u5fa1\uff1b\u55b7\u6c14\u80cc\u5305\uff1a\u8fdb\u653b\uff1b\u78c1\u94c1\uff1a\u5b9e\u7528\u3002]"}, {"question": "Run Rich 3D\u7684\u201c\u7ecf\u5178\u6a21\u5f0f\u201d\u548c\u201c\u5bcc\u88d5\u6a21\u5f0f\u201d\u7684\u4e3b\u8981\u533a\u522b\u662f\u4ec0\u4e48\uff1f", "answer": "Run Rich 3D\u4e2d\u7684\u7ecf\u5178\u6a21\u5f0f\u63d0\u4f9b\u4f20\u7edf\u7684\u65e0\u5c3d\u8dd1\u9177\u4f53\u9a8c\uff0c\u800c\u5bcc\u88d5\u6a21\u5f0f\u5f15\u5165\u4e86\u786c\u5e01\u500d\u6570\u548c\u7a00\u6709\u9053\u5177\u3002\u4f8b\u5982\uff0c\u5728\u5bcc\u88d5\u6a21\u5f0f\u4e2d\uff0c\u60a8\u53ef\u80fd\u4f1a\u9047\u5230\u201c\u9ec4\u91d1\u786c\u5e01\u201d\uff0c\u5b83\u4f1a\u5c06\u60a8\u7684\u6536\u76ca\u7ffb\u500d\uff0c\u6301\u7eed\u4e00\u6bb5\u65f6\u95f4\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u7ecf\u5178\u6a21\u5f0f\uff1a\u6807\u51c6\u6e38\u620f\u73a9\u6cd5\uff1b\u5bcc\u88d5\u6a21\u5f0f\uff1a2\u500d\u786c\u5e01\uff0c\u7a00\u6709\u9053\u5177\u3002]"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684Run Rich 3D\u6e38\u620f\u8fdb\u5ea6\u4ece\u624b\u673a\u8f6c\u79fb\u5230\u5e73\u677f\u7535\u8111\uff1f", "answer": "\u8981\u8f6c\u79fb\u8fdb\u5ea6\uff0c\u8bf7\u786e\u4fdd\u60a8\u5728\u4e24\u53f0\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u8d26\u6237\u3002\u4f7f\u7528\u8bbe\u7f6e\u83dc\u5355\u4e2d\u7684\u4e91\u4fdd\u5b58\u529f\u80fd\u4e0a\u4f20\u60a8\u7684\u6570\u636e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5df2\u5728\u624b\u673a\u4e0a\u5b8c\u6210\u4e86\u201c\u6c99\u6f20\u51b2\u523a\u201d\u5173\u5361\uff0c\u5219\u767b\u5f55\u5e73\u677f\u7535\u8111\u4f1a\u540c\u6b65\u6b64\u8fdb\u5ea6\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u4e91\u4fdd\u5b58\u60f3\u8c61\u6210\u4e00\u5f20\u56fe\u4e66\u9986\u5361\uff1b\u60a8\u7684\u6e38\u620f\u8fdb\u5ea6\u5b58\u50a8\u5728\u4e91\u7aef\uff0c\u4efb\u4f55\u8bbe\u5907\u90fd\u80fd\u8bbf\u95ee\u3002]"}, {"question": "\u5728Run Rich 3D\u4e2d\uff0c\u6211\u53ef\u4ee5\u89e3\u9501\u54ea\u4e9b\u9690\u85cf\u6210\u5c31\uff0c\u4ee5\u53ca\u5982\u4f55\u627e\u5230\u5b83\u4eec\uff1f", "answer": "Run Rich 3D\u4e2d\u7684\u9690\u85cf\u6210\u5c31\u901a\u5e38\u9700\u8981\u7279\u5b9a\u64cd\u4f5c\uff0c\u4f8b\u5982\u5728\u5355\u6b21\u6e38\u620f\u4e2d\u6536\u96c6 100 \u679a\u786c\u5e01\uff0c\u6216\u5728\u4e0d\u53d7\u5230\u4f24\u5bb3\u7684\u60c5\u51b5\u4e0b\u51fb\u8d25 Boss\u3002\u4f8b\u5982\uff0c\u201c\u786c\u5e01\u6536\u85cf\u5bb6\u201d\u6210\u5c31\uff0c\u901a\u8fc7\u5728\u201c\u5b9d\u85cf\u6d77\u6e7e\u201d\u5173\u5361\u4e2d\u6536\u96c6 1000 \u679a\u786c\u5e01\u6765\u89e3\u9501\u3002[\u5f69\u86cb\u6316\u6398\uff1a\u5bc6\u5207\u5173\u6ce8\u6e38\u620f\u4e2d\u4e0d\u5bfb\u5e38\u7684\u64cd\u4f5c\uff1b\u5b83\u4eec\u901a\u5e38\u4f1a\u89e6\u53d1\u9690\u85cf\u6210\u5c31\u3002]"}, {"question": "Run Rich 3D\u7684\u591a\u4eba\u6a21\u5f0f\u5339\u914d\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "Run Rich 3D\u7684\u5339\u914d\u7cfb\u7edf\u57fa\u4e8e\u73a9\u5bb6\u7684\u6280\u80fd\u7b49\u7ea7\u548c\u8fdb\u5ea6\u6765\u5339\u914d\u73a9\u5bb6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5df2\u5b8c\u6210 50 \u4e2a\u5173\u5361\uff0c\u5219\u4f1a\u4e0e\u5177\u6709\u7c7b\u4f3c\u7ecf\u9a8c\u7684\u73a9\u5bb6\u5339\u914d\u3002\u7cfb\u7edf\u8fd8\u4f1a\u8003\u8651\u60a8\u7684\u8fd1\u671f\u8868\u73b0\u4ee5\u786e\u4fdd\u5339\u914d\u7684\u5e73\u8861\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u6280\u80fd\u7b49\u7ea7 + \u8fdb\u5ea6 + \u6700\u8fd1\u8868\u73b0 \u2192 \u5339\u914d\u3002]"}, {"question": "\u5728Run Rich 3D\u4e2d\uff0c\u6700\u6709\u6548\u5730\u82b1\u8d39\u5b9d\u77f3\u7684\u65b9\u6cd5\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728Run Rich 3D\u4e2d\uff0c\u6700\u6709\u6548\u5730\u4f7f\u7528\u5b9d\u77f3\u7684\u65b9\u6cd5\u662f\u8d2d\u4e70\u6c38\u4e45\u6027\u7684\u5347\u7ea7\uff0c\u4f8b\u5982\u89d2\u8272\u63d2\u69fd\u6216\u9ad8\u7ea7\u9053\u5177\u3002\u4f8b\u5982\uff0c\u89e3\u9501\u989d\u5916\u7684\u89d2\u8272\u63d2\u69fd\u53ef\u4ee5\u8ba9\u60a8\u5728\u4e0d\u540c\u89d2\u8272\u4e4b\u95f4\u5207\u6362\uff0c\u63d0\u9ad8\u7075\u6d3b\u6027\u3002\u907f\u514d\u5728\u4e34\u65f6\u63d0\u5347\u4e0a\u82b1\u8d39\u5b9d\u77f3\uff0c\u56e0\u4e3a\u5b83\u4eec\u5bf9\u957f\u671f\u4ef7\u503c\u6765\u8bf4\uff0c\u4ef7\u503c\u8f83\u4f4e\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6c38\u4e45\u5347\u7ea7\uff1a\u9ad8\u4ef7\u503c\uff1b\u4e34\u65f6\u63d0\u5347\uff1a\u4f4e\u4ef7\u503c\u3002]"}]
[{"question": "\u5982\u4f55\u5728Run Rich 3D\u5feb\u901f\u4e0a\u624b\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u958b\u59cb\u4f7f\u7528Run Rich 3D\uff0c\u8acb\u5148\u719f\u6089\u57fa\u672c\u63a7\u5236\uff1a\u4f7f\u7528\u6416\u687f\u79fb\u52d5\u89d2\u8272\uff0c\u9ede\u64ca\u87a2\u5e55\u8df3\u8e8d\uff0c\u4e26\u6ed1\u52d5\u87a2\u5e55\u57f7\u884c\u7279\u6b8a\u52d5\u4f5c\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u95dc\u4e2d\uff0c\u60a8\u9700\u8981\u5728\u9069\u7576\u7684\u6642\u6a5f\u9ede\u64ca\u87a2\u5e55\u624d\u80fd\u8df3\u904e\u969c\u7919\u7269\u3002\u5728\u6559\u5b78\u4e2d\u7df4\u7fd2\u9019\u4e9b\u52d5\u4f5c\uff0c\u4ee5\u5efa\u7acb\u4fe1\u5fc3\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u63a7\u5236\u60f3\u50cf\u6210\u958b\u8eca\uff1b\u60a8\u9700\u8981\u5148\u719f\u6089\u65b9\u5411\u76e4\u548c\u715e\u8eca\uff0c\u624d\u80fd\u4e0a\u8def\u3002]"}, {"question": "\u5728\u904a\u6232\u9032\u884c100\u5c0f\u6642\u5f8c\uff0c\u5728Run Rich 3D\u4e2d\u7372\u5f97\u786c\u5e63\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u904a\u6232\u9032\u884c100\u5c0f\u6642\u5f8c\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff0c\u6700\u5927\u9650\u5ea6\u5730\u589e\u52a0\u786c\u5e63\uff1a\u6b65\u9a5f1\uff1a\u512a\u5148\u5b8c\u6210\u6bcf\u65e5\u6311\u6230\uff0c\u9019\u4e9b\u6311\u6230\u901a\u5e38\u63d0\u4f9b\u9ad8\u984d\u7684\u786c\u5e63\u734e\u52f5\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u4f8b\u5982\u5438\u9435\u7b49\u589e\u5f37\u9053\u5177\uff0c\u5728\u904b\u884c\u904e\u7a0b\u4e2d\u81ea\u52d5\u6536\u96c6\u786c\u5e63\u3002\u6b65\u9a5f3\uff1a\u5728\u300c\u5bcc\u8c6a\u6a21\u5f0f\u300d\u4e2d\u904a\u6232\uff0c\u5176\u4e2d\u786c\u5e63\u500d\u6578\u6703\u88ab\u555f\u52d5\u3002\u4f8b\u5982\uff0c\u5728\u300c\u9ec3\u91d1\u53e2\u6797\u300d\u95dc\u5361\u4e2d\uff0c\u5c07\u5438\u9435\u8207\u5bcc\u8c6a\u6a21\u5f0f\u7d50\u5408\u4f7f\u7528\uff0c\u6bcf\u6b21\u904b\u884c\u53ef\u4ee5\u7372\u5f97\u8d85\u904e1000\u679a\u786c\u5e63\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u96d6\u7136\u666e\u901a\u904b\u884c\u7a69\u5b9a\uff0c\u4f46\u5bcc\u8c6a\u6a21\u5f0f\u5728\u5e7e\u4e4e\u4e0d\u589e\u52a0\u984d\u5916\u52aa\u529b\u7684\u60c5\u6cc1\u4e0b\u986f\u8457\u63d0\u9ad8\u4e86\u6536\u76ca\u3002]"}, {"question": "\u70ba\u4ec0\u9ebcRun Rich 3D\u7684\u9ad4\u529b\u7cfb\u7d71\u6703\u9650\u5236\u904a\u6232\u9032\u5ea6\uff0c\u4ee5\u53ca\u5982\u4f55\u512a\u5316\u5b83\uff1f", "answer": "Run Rich 3D\u7684\u9ad4\u529b\u7cfb\u7d71\u65e8\u5728\u5e73\u8861\u904a\u6232\u9032\u5ea6\uff0c\u4e26\u9f13\u52f5\u73a9\u5bb6\u7b56\u7565\u6027\u5730\u904a\u6232\u3002\u8981\u512a\u5316\u5b83\uff0c\u8acb\u900f\u904e\u89c0\u770b\u5ee3\u544a\u6216\u4f7f\u7528\u904a\u6232\u5167\u7269\u54c1\uff08\u5982\u80fd\u91cf\u98f2\u6599\uff09\u4f86\u6062\u5fa9\u9ad4\u529b\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u8207Boss\u6230\u9b25\u6642\u9ad4\u529b\u4e0d\u8db3\uff0c\u80fd\u91cf\u98f2\u6599\u53ef\u4ee5\u7acb\u5373\u88dc\u5145\u60a8\u7684\u9ad4\u529b\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6b63\u5e38\u6062\u5fa9\uff1a\u6bcf5\u5206\u9418\u6062\u5fa91\u9ede\u9ad4\u529b\uff1b\u80fd\u91cf\u98f2\u6599\uff1a\u7acb\u5373\u5b8c\u5168\u6062\u5fa9\u9ad4\u529b\u3002]"}, {"question": "Run Rich 3D\u7684\u89d2\u8272\u9032\u968e\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u5b83\uff1f", "answer": "Run Rich 3D\u7684\u89d2\u8272\u9032\u968e\u53d6\u6c7a\u65bc\u7d93\u9a57\u503c (XP) \u548c\u88dd\u5099\u5347\u7d1a\u3002\u900f\u904e\u5b8c\u6210\u95dc\u5361\u548c\u4efb\u52d9\u4f86\u8cfa\u53d6\u7d93\u9a57\u503c\uff0c\u7136\u5f8c\u4f7f\u7528\u5b83\u4f86\u63d0\u5347\u89d2\u8272\u7b49\u7d1a\u3002\u5347\u7d1a\u88dd\u5099\uff0c\u4f8b\u5982\u300c\u9ec3\u91d1\u978b\u5b50\u300d\uff0c\u6703\u5f37\u5316\u80fd\u529b\uff0c\u4f8b\u5982\u901f\u5ea6\u548c\u8df3\u8e8d\u9ad8\u5ea6\u3002\u4f8b\u5982\uff0c\u7b49\u7d1a 5 \u7684\u89d2\u8272\u914d\u5099\u5347\u7d1a\u7684\u978b\u5b50\u53ef\u4ee5\u5728\u300c\u9ad8\u7a7a\u300d\u95dc\u5361\u4e2d\u8de8\u8d8a\u66f4\u9577\u7684\u8ddd\u96e2\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u7d93\u9a57\u503c\u7372\u5f97 \u2192 \u7b49\u7d1a\u63d0\u5347 \u2192 \u89e3\u9396\u80fd\u529b \u2192 \u5347\u7d1a\u88dd\u5099 \u2192 \u63d0\u5347\u8868\u73fe\u3002]"}, {"question": "\u5728Run Rich 3D\u4e2d\uff0c\u54ea\u4e9b\u589e\u5f37\u9053\u5177\u5c0d\u9ad8\u7d1a\u73a9\u5bb6\u6700\u6709\u6548\uff1f", "answer": "\u9ad8\u7d1a\u73a9\u5bb6\u61c9\u8a72\u5c08\u6ce8\u65bc\u9632\u8b77\u9053\u5177\uff0c\u4f8b\u5982\u76fe\u724c\uff0c\u53ef\u4ee5\u62b5\u79a6\u969c\u7919\uff0c\u4ee5\u53ca\u5674\u5c04\u80cc\u5305\uff0c\u53ef\u4ee5\u5ef6\u9577\u98db\u884c\u6642\u9593\u3002\u4f8b\u5982\uff0c\u5728\u300c\u7194\u5ca9\u5730\u300d\u95dc\u5361\u4e2d\uff0c\u76fe\u724c\u53ef\u4ee5\u9632\u6b62\u60a8\u589c\u5165\u7194\u5ca9\u5751\u4e2d\uff0c\u800c\u5674\u5c04\u80cc\u5305\u5247\u6709\u52a9\u65bc\u8de8\u8d8a\u8f03\u5927\u7684\u8ddd\u96e2\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u76fe\u724c\uff1a\u9632\u79a6\uff1b\u5674\u5c04\u80cc\u5305\uff1a\u9032\u653b\uff1b\u5438\u9435\uff1a\u8f14\u52a9\u3002]"}, {"question": "Run Rich 3D\u7684\u300c\u7d93\u5178\u6a21\u5f0f\u300d\u548c\u300c\u5bcc\u8c6a\u6a21\u5f0f\u300d\u4e4b\u9593\u7684\u4e3b\u8981\u5340\u5225\u662f\u4ec0\u9ebc\uff1f", "answer": "Run Rich 3D\u7684\u7d93\u5178\u6a21\u5f0f\u63d0\u4f9b\u50b3\u7d71\u7684\u7121\u9650\u8dd1\u9177\u9ad4\u9a57\uff0c\u800c\u5bcc\u8c6a\u6a21\u5f0f\u5247\u5f15\u5165\u4e86\u786c\u5e63\u500d\u6578\u548c\u7a00\u6709\u589e\u5f37\u9053\u5177\u3002\u4f8b\u5982\uff0c\u5728\u5bcc\u8c6a\u6a21\u5f0f\u4e2d\uff0c\u60a8\u53ef\u80fd\u6703\u9047\u5230\u300c\u9ec3\u91d1\u786c\u5e63\u300d\uff0c\u5b83\u6703\u5728\u4e00\u6bb5\u6642\u9593\u5167\u5c07\u60a8\u7684\u6536\u76ca\u52a0\u500d\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u7d93\u5178\u6a21\u5f0f\uff1a\u6a19\u6e96\u904a\u6232\u73a9\u6cd5\uff1b\u5bcc\u8c6a\u6a21\u5f0f\uff1a\u96d9\u500d\u786c\u5e63\uff0c\u7a00\u6709\u589e\u5f37\u9053\u5177\u3002]"}, {"question": "\u6211\u5982\u4f55\u5c07\u6211\u7684Run Rich 3D\u904a\u6232\u9032\u5ea6\u5f9e\u624b\u6a5f\u8f49\u79fb\u5230\u5e73\u677f\u96fb\u8166\uff1f", "answer": "\u8981\u8f49\u79fb\u9032\u5ea6\uff0c\u8acb\u78ba\u4fdd\u60a8\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u90fd\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u3002\u4f7f\u7528\u8a2d\u5b9a\u9078\u55ae\u4e2d\u7684\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u4e0a\u50b3\u60a8\u7684\u8cc7\u6599\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5df2\u5728\u624b\u6a5f\u4e0a\u5b8c\u6210\u300c\u6c99\u6f20\u885d\u523a\u300d\u95dc\u5361\uff0c\u5728\u5e73\u677f\u96fb\u8166\u4e0a\u767b\u5165\u60a8\u7684\u5e33\u6236\u5c07\u6703\u540c\u6b65\u6b64\u9032\u5ea6\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u96f2\u7aef\u5132\u5b58\u60f3\u50cf\u6210\u5716\u66f8\u9928\u5361\uff1b\u60a8\u7684\u9032\u5ea6\u5132\u5b58\u4e26\u53ef\u5f9e\u4efb\u4f55\u88dd\u7f6e\u5b58\u53d6\u3002]"}, {"question": "\u6211\u5728Run Rich 3D\u4e2d\u53ef\u4ee5\u89e3\u9396\u54ea\u4e9b\u96b1\u85cf\u6210\u5c31\uff0c\u4ee5\u53ca\u5982\u4f55\u627e\u5230\u5b83\u5011\uff1f", "answer": "Run Rich 3D\u4e2d\u7684\u96b1\u85cf\u6210\u5c31\u901a\u5e38\u9700\u8981\u7279\u5b9a\u52d5\u4f5c\uff0c\u4f8b\u5982\u55ae\u6b21\u904a\u6232\u4e2d\u6536\u96c6 100 \u679a\u786c\u5e63\u6216\u5728\u4e0d\u53d7\u5230\u50b7\u5bb3\u7684\u60c5\u6cc1\u4e0b\u64ca\u6557 Boss\u3002\u4f8b\u5982\uff0c\u300c\u786c\u5e63\u6536\u96c6\u8005\u300d\u6210\u5c31\u5c07\u5728\u300c\u5bf6\u85cf\u7063\u300d\u95dc\u5361\u4e2d\u900f\u904e\u6536\u96c6 1000 \u679a\u786c\u5e63\u4f86\u89e3\u9396\u3002[\u5f69\u86cb\u6316\u6398\uff1a\u5bc6\u5207\u95dc\u6ce8\u904a\u6232\u4e2d\u7684\u4e0d\u5c0b\u5e38\u52d5\u4f5c\uff1b\u5b83\u5011\u901a\u5e38\u6703\u89f8\u767c\u96b1\u85cf\u6210\u5c31\u3002]"}, {"question": "Run Rich 3D\u7684\u591a\u4eba\u6a21\u5f0f\u7684\u5339\u914d\u6a5f\u5236\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "Run Rich 3D\u7684\u5339\u914d\u6a5f\u5236\u6703\u6839\u64da\u73a9\u5bb6\u7684\u6280\u80fd\u7b49\u7d1a\u548c\u9032\u5ea6\u5c07\u73a9\u5bb6\u914d\u5c0d\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5df2\u5b8c\u6210 50 \u500b\u95dc\u5361\uff0c\u60a8\u5c07\u6703\u8207\u5177\u6709\u985e\u4f3c\u7d93\u9a57\u7684\u73a9\u5bb6\u914d\u5c0d\u3002\u8a72\u7cfb\u7d71\u4e5f\u6703\u8003\u616e\u60a8\u6700\u8fd1\u7684\u8868\u73fe\uff0c\u4ee5\u78ba\u4fdd\u5339\u914d\u516c\u5e73\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u6280\u80fd\u7b49\u7d1a + \u9032\u5ea6 + \u6700\u8fd1\u8868\u73fe \u2192 \u5339\u914d\u6a5f\u5236\u3002]"}, {"question": "\u5728Run Rich 3D\u4e2d\uff0c\u6700\u6709\u6548\u7684\u82b1\u8cbb\u947d\u77f3\u7684\u65b9\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728Run Rich 3D\u4e2d\uff0c\u947d\u77f3\u6700\u9069\u5408\u7528\u65bc\u6c38\u4e45\u5347\u7d1a\uff0c\u4f8b\u5982\u89d2\u8272\u63d2\u69fd\u6216\u9ad8\u7d1a\u589e\u5f37\u9053\u5177\u3002\u4f8b\u5982\uff0c\u89e3\u9396\u984d\u5916\u7684\u89d2\u8272\u63d2\u69fd\u4f7f\u60a8\u80fd\u5920\u5728\u5177\u6709\u4e0d\u540c\u80fd\u529b\u7684\u89d2\u8272\u4e4b\u9593\u5207\u63db\uff0c\u63d0\u9ad8\u591a\u529f\u80fd\u6027\u3002\u907f\u514d\u82b1\u8cbb\u947d\u77f3\u5728\u81e8\u6642\u589e\u76ca\u4e0a\uff0c\u56e0\u70ba\u5b83\u5011\u63d0\u4f9b\u7684\u9577\u671f\u50f9\u503c\u8f03\u4f4e\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u6c38\u4e45\u5347\u7d1a\uff1a\u9ad8\u50f9\u503c\uff1b\u81e8\u6642\u589e\u76ca\uff1a\u4f4e\u50f9\u503c\u3002]"}]
[{"question": "Among Us\u30aa\u30f3\u30e9\u30a4\u30f3\u7248\u3067\u30af\u30eb\u30fc\u30e1\u30a4\u30c8\u3068\u3057\u3066\u57fa\u672c\u7684\u306a\u30bf\u30b9\u30af\u3092\u5b9f\u884c\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Among Us\u30aa\u30f3\u30e9\u30a4\u30f3\u7248\u3067\u30af\u30eb\u30fc\u30e1\u30a4\u30c8\u3068\u3057\u3066\u3001\u3042\u306a\u305f\u306e\u4e3b\u306a\u76ee\u7684\u306f\u3001\u5b87\u5b99\u8239\u306e\u6a5f\u80fd\u3092\u78ba\u4fdd\u3059\u308b\u305f\u3081\u306b\u30bf\u30b9\u30af\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u7ba1\u7406\u300f\u5ba4\u3067\u306f\u3001\u30ab\u30fc\u30c9\u3092\u30ea\u30fc\u30c0\u30fc\u306b\u304b\u3056\u3057\u3066\u30b9\u30ef\u30a4\u30d7\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u30bf\u30b9\u30af\u3092\u52b9\u679c\u7684\u306b\u5b9f\u884c\u3059\u308b\u305f\u3081\u306b\uff1aSTEP1 - \u30de\u30c3\u30d7\u3092\u4f7f\u7528\u3057\u3066\u30bf\u30b9\u30af\u306e\u5834\u6240\u307e\u3067\u79fb\u52d5\u3057\u307e\u3059\u3002STEP2 - \u30af\u30ea\u30c3\u30af\u307e\u305f\u306f\u30bf\u30c3\u30d7\u3057\u3066\u30bf\u30b9\u30af\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3068\u5bfe\u8a71\u3057\u307e\u3059\u3002STEP3 - \u753b\u9762\u306e\u6307\u793a\u306b\u5f93\u3063\u3066\u30bf\u30b9\u30af\u3092\u5b8c\u4e86\u3057\u307e\u3059\u3002\u30af\u30eb\u30fc\u30e1\u30a4\u30c8\u306e\u8272\u306b\u5408\u308f\u305b\u3066\u30bf\u30b9\u30af\u304c\u8272\u5206\u3051\u3055\u308c\u3066\u3044\u308b\u306e\u3067\u3001\u81ea\u5206\u306e\u30bf\u30b9\u30af\u3092\u7c21\u5358\u306b\u8b58\u5225\u3067\u304d\u307e\u3059\u3002"}, {"question": "Among Us\u30aa\u30f3\u30e9\u30a4\u30f3\u7248\u3067\u30a4\u30f3\u30dd\u30b9\u30bf\u30fc\u3092\u7279\u5b9a\u3059\u308b\u305f\u3081\u306e\u4e3b\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Among Us\u30aa\u30f3\u30e9\u30a4\u30f3\u7248\u3067\u30a4\u30f3\u30dd\u30b9\u30bf\u30fc\u3092\u7279\u5b9a\u3059\u308b\u306b\u306f\u3001\u92ed\u3044\u89b3\u5bdf\u529b\u3068\u6226\u7565\u7684\u306a\u601d\u8003\u304c\u5fc5\u8981\u3067\u3059\u3002\u52b9\u679c\u7684\u306a\u6226\u7565\u306e1\u3064\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u52d5\u304d\u3092\u89b3\u5bdf\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u63db\u6c17\u53e3\u3092\u4f7f\u7528\u3057\u3066\u3044\u308b\u306e\u3092\u898b\u304b\u3051\u305f\u3089\u3001\u3053\u308c\u306f\u30a4\u30f3\u30dd\u30b9\u30bf\u30fc\u3067\u3042\u308b\u660e\u78ba\u306a\u5146\u5019\u3067\u3059\u3002STEP1 - \u30bf\u30b9\u30af\u3092\u56de\u907f\u3057\u305f\u308a\u3001\u30bf\u30b9\u30af\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3\u3092\u507d\u88c5\u3057\u305f\u308a\u3059\u308b\u306a\u3069\u3001\u7570\u5e38\u306a\u884c\u52d5\u3092\u89b3\u5bdf\u3057\u307e\u3059\u3002STEP2 - \u7591\u308f\u3057\u3044\u6d3b\u52d5\u304c\u691c\u51fa\u3055\u308c\u305f\u3089\u3001\u300e\u5831\u544a\u300f\u30dc\u30bf\u30f3\u3092\u4f7f\u7528\u3057\u3066\u7dca\u6025\u4f1a\u8b70\u3092\u547c\u3073\u51fa\u3057\u307e\u3059\u3002STEP3 - \u4f1a\u8b70\u4e2d\u3001\u3042\u306a\u305f\u306e\u89b3\u5bdf\u7d50\u679c\u3092\u5171\u6709\u3057\u3001\u4ed6\u306e\u4eba\u305f\u3061\u306e\u8aac\u660e\u3092\u805e\u3044\u3066\u3001\u30a4\u30f3\u30dd\u30b9\u30bf\u30fc\u306e\u8eab\u5143\u3092\u7a81\u304d\u6b62\u3081\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30a2\u30ea\u30d0\u30a4\u3092\u6bd4\u8f03\u3059\u308b\u3053\u3068\u3067\u3001\u5bb9\u7591\u8005\u3092\u7d5e\u308a\u8fbc\u3080\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Among Us\u30aa\u30f3\u30e9\u30a4\u30f3\u7248\u306e\u30bf\u30b9\u30af\u5b8c\u4e86\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "Among Us\u30aa\u30f3\u30e9\u30a4\u30f3\u7248\u306e\u30bf\u30b9\u30af\u5b8c\u4e86\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30af\u30eb\u30fc\u30e1\u30a4\u30c8\u304c\u5b87\u5b99\u8239\u3092\u7dad\u6301\u3059\u308b\u9032\u6357\u3092\u8ffd\u8de1\u3059\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u5404\u30bf\u30b9\u30af\u306b\u306f\u3001\u624b\u9806\u306b\u5f93\u3046\u5fc5\u8981\u304c\u3042\u308b\u7279\u5b9a\u306e\u4e00\u9023\u306e\u30b9\u30c6\u30c3\u30d7\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u96fb\u6c17\u300f\u5ba4\u3067\u306f\u3001\u540c\u3058\u8272\u306e\u30ef\u30a4\u30e4\u3092\u63a5\u7d9a\u3059\u308b\u3053\u3068\u3067\u914d\u7dda\u3092\u4fee\u6b63\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u30b7\u30b9\u30c6\u30e0\u306f\u753b\u9762\u4e0a\u90e8\u306e\u9032\u884c\u72b6\u6cc1\u30d0\u30fc\u3092\u4f7f\u7528\u3057\u3066\u3001\u5168\u4f53\u7684\u306a\u30bf\u30b9\u30af\u5b8c\u4e86\u306e\u72b6\u6cc1\u3092\u793a\u3057\u307e\u3059\u3002\u30bf\u30b9\u30af\u306f\u3001\u8996\u899a\u7684\u30bf\u30b9\u30af\u304a\u3088\u3073\u975e\u8996\u899a\u7684\u30bf\u30b9\u30af\u306b\u5206\u985e\u3055\u308c\u3066\u304a\u308a\u3001\u8996\u899a\u7684\u30bf\u30b9\u30af\u306f\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u7121\u7f6a\u3092\u8a3c\u660e\u3057\u307e\u3059\u3002\u3059\u3079\u3066\u306e\u30bf\u30b9\u30af\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u306f\u3001\u30af\u30eb\u30fc\u30e1\u30a4\u30c8\u304c\u30b2\u30fc\u30e0\u306b\u52dd\u5229\u3059\u308b\u305f\u3081\u306e\u4e3b\u8981\u306a\u65b9\u6cd5\u3067\u3059\u3002"}, {"question": "Among Us\u30aa\u30f3\u30e9\u30a4\u30f3\u7248\u3067\u63db\u6c17\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u30a4\u30f3\u30dd\u30b9\u30bf\u30fc\u306b\u3068\u3063\u3066\u306a\u305c\u91cd\u8981\u3067\u3059\u304b\uff1f", "answer": "Among Us\u30aa\u30f3\u30e9\u30a4\u30f3\u7248\u3067\u63db\u6c17\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u30a4\u30f3\u30dd\u30b9\u30bf\u30fc\u306b\u3068\u3063\u3066\u3001\u30de\u30c3\u30d7\u5168\u4f53\u3092\u7d20\u65e9\u304f\u79fb\u52d5\u3057\u3001\u6226\u7565\u7684\u306a\u6bba\u5bb3\u3068\u8131\u51fa\u3092\u53ef\u80fd\u306b\u3059\u308b\u305f\u3081\u3001\u91cd\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30a4\u30f3\u30dd\u30b9\u30bf\u30fc\u306f\u63db\u6c17\u53e3\u3092\u4f7f\u3063\u3066\u3001\u300e\u30bb\u30ad\u30e5\u30ea\u30c6\u30a3\u300f\u304b\u3089\u300e\u533b\u7642\u5ba4\u300f\u307e\u3067\u7d20\u65e9\u304f\u79fb\u52d5\u3057\u3066\u3001\u30a2\u30ea\u30d0\u30a4\u3092\u4f5c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002STEP1 - \u901a\u5e38\u3001\u300e\u98df\u5802\u300f\u3084\u300e\u96fb\u6c17\u300f\u306e\u3088\u3046\u306a\u4e2d\u5fc3\u7684\u306a\u5834\u6240\u306b\u8a2d\u7f6e\u3055\u308c\u3066\u3044\u308b\u63db\u6c17\u53e3\u306e\u5165\u53e3\u3092\u63a2\u3057\u307e\u3059\u3002STEP2 - \u30af\u30eb\u30fc\u30e1\u30a4\u30c8\u306b\u898b\u3089\u308c\u306a\u3044\u3088\u3046\u306b\u63db\u6c17\u53e3\u3092\u4f7f\u7528\u3057\u3066\u90e8\u5c4b\u3092\u79fb\u52d5\u3057\u307e\u3059\u3002STEP3 - \u30ab\u30e1\u30e9\u3084\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u6355\u307e\u3063\u3066\u3057\u307e\u3046\u306e\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u3001\u81ea\u5206\u306e\u52d5\u304d\u3092\u8a08\u753b\u3057\u307e\u3059\u3002\u63db\u6c17\u53e3\u306e\u4f7f\u7528\u65b9\u6cd5\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u3067\u3001\u30a4\u30f3\u30dd\u30b9\u30bf\u30fc\u306e\u52b9\u679c\u3092\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Among Us\u30aa\u30f3\u30e9\u30a4\u30f3\u7248\u306b\u304a\u3051\u308b\u8996\u899a\u7684\u30bf\u30b9\u30af\u3068\u975e\u8996\u899a\u7684\u30bf\u30b9\u30af\u306e\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Among Us\u30aa\u30f3\u30e9\u30a4\u30f3\u7248\u3067\u306f\u3001\u30bf\u30b9\u30af\u306f\u8996\u899a\u7684\u30bf\u30a4\u30d7\u3068\u975e\u8996\u899a\u7684\u30bf\u30a4\u30d7\u306e2\u7a2e\u985e\u306b\u5206\u985e\u3055\u308c\u3001\u305d\u308c\u305e\u308c\u306b\u7570\u306a\u308b\u76ee\u7684\u304c\u3042\u308a\u307e\u3059\u3002\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u898b\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u300e\u533b\u7642\u5ba4\u30b9\u30ad\u30e3\u30f3\u300f\u306e\u3088\u3046\u306a\u8996\u899a\u7684\u30bf\u30b9\u30af\u306f\u3001\u30af\u30eb\u30fc\u30e1\u30a4\u30c8\u306e\u7121\u7f6a\u306e\u8a3c\u62e0\u3068\u306a\u308a\u307e\u3059\u3002\u300e\u914d\u7dda\u3092\u4fee\u6b63\u3059\u308b\u300f\u3068\u3044\u3063\u305f\u975e\u8996\u899a\u7684\u30bf\u30b9\u30af\u306b\u306f\u3001\u8868\u793a\u3067\u304d\u308b\u6307\u6a19\u304c\u306a\u304f\u3001\u30bf\u30b9\u30af\u30d0\u30fc\u3092\u524d\u9032\u3055\u305b\u308b\u305f\u3081\u306e\u3082\u306e\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u4ed6\u306e\u4eba\u3005\u306e\u524d\u3067\u8996\u899a\u7684\u30bf\u30b9\u30af\u3092\u5b8c\u4e86\u3059\u308c\u3070\u7591\u60d1\u3092\u6674\u3089\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304c\u3001\u975e\u8996\u899a\u7684\u30bf\u30b9\u30af\u306f\u30bf\u30b9\u30af\u306e\u5b8c\u4e86\u306b\u57fa\u3065\u3044\u305f\u4fe1\u983c\u304c\u5fc5\u8981\u3067\u3059\u3002\u3053\u308c\u3089\u306e\u9055\u3044\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u30af\u30eb\u30fc\u30e1\u30a4\u30c8\u3068\u30a4\u30f3\u30dd\u30b9\u30bf\u30fc\u306e\u4e21\u65b9\u306b\u3068\u3063\u3066\u3001\u6226\u7565\u3092\u52b9\u679c\u7684\u306b\u7acb\u3066\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002"}, {"question": "Among Us\u30aa\u30f3\u30e9\u30a4\u30f3\u7248\u3067\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u52d5\u304d\u3092\u8ffd\u8de1\u3059\u308b\u305f\u3081\u306b\u7ba1\u7406\u30de\u30c3\u30d7\u3092\u4f7f\u3046\u65b9\u6cd5\u306f\uff1f", "answer": "Among Us\u30aa\u30f3\u30e9\u30a4\u30f3\u7248\u306e\u7ba1\u7406\u30de\u30c3\u30d7\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u52d5\u304d\u3092\u8ffd\u8de1\u3057\u3001\u7591\u308f\u3057\u3044\u884c\u52d5\u3092\u7279\u5b9a\u3059\u308b\u305f\u3081\u306e\u5f37\u529b\u306a\u30c4\u30fc\u30eb\u3067\u3059\u3002\u52b9\u679c\u7684\u306b\u4f7f\u3046\u305f\u3081\u306b\u306f\uff1aSTEP1 - \u300e\u7ba1\u7406\u300f\u5ba4\u306b\u884c\u3063\u3066\u30b3\u30f3\u30bd\u30fc\u30eb\u3068\u5bfe\u8a71\u3059\u308b\u3053\u3068\u3067\u3001\u7ba1\u7406\u30de\u30c3\u30d7\u306b\u30a2\u30af\u30bb\u30b9\u3057\u307e\u3059\u3002STEP2 - \u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u3067\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u4f4d\u7f6e\u3092\u793a\u3059\u30a2\u30a4\u30b3\u30f3\u3092\u89b3\u5bdf\u3057\u307e\u3059\u3002STEP3 - \u30bf\u30b9\u30af\u306a\u3057\u306e\u90e8\u5c4b\u306b\u73fe\u308c\u305f\u308a\u3001\u9060\u304f\u96e2\u308c\u305f\u30a8\u30ea\u30a2\u3092\u975e\u5e38\u306b\u65e9\u304f\u79fb\u52d5\u3057\u305f\u308a\u3059\u308b\u306a\u3069\u3001\u7570\u5e38\u306a\u70b9\u3092\u63a2\u3057\u307e\u3059\u3002\u4f8b\u3068\u3057\u3066\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u300e\u30bb\u30ad\u30e5\u30ea\u30c6\u30a3\u300f\u306b\u3044\u3066\u3001\u3059\u3050\u306b\u63db\u6c17\u53e3\u3092\u4f7f\u7528\u305b\u305a\u306b\u300e\u539f\u5b50\u7089\u300f\u306b\u73fe\u308c\u305f\u3089\u3001\u3053\u308c\u306f\u30a4\u30f3\u30dd\u30b9\u30bf\u30fc\u306e\u6d3b\u52d5\u3067\u3042\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u7ba1\u7406\u30de\u30c3\u30d7\u306f\u3001\u30af\u30eb\u30fc\u30e1\u30a4\u30c8\u304c\u8a3c\u62e0\u3092\u96c6\u3081\u308b\u305f\u3081\u3001\u30a4\u30f3\u30dd\u30b9\u30bf\u30fc\u304c\u81ea\u5206\u306e\u52d5\u304d\u3092\u8a08\u753b\u3059\u308b\u305f\u3081\u306b\u7279\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "Among Us\u30aa\u30f3\u30e9\u30a4\u30f3\u7248\u3067\u30d7\u30e9\u30a4\u30d9\u30fc\u30c8\u30b2\u30fc\u30e0\u3092\u30db\u30b9\u30c8\u3059\u308b\u305f\u3081\u306e\u30d9\u30b9\u30c8\u30d7\u30e9\u30af\u30c6\u30a3\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Among Us\u30aa\u30f3\u30e9\u30a4\u30f3\u7248\u3067\u30d7\u30e9\u30a4\u30d9\u30fc\u30c8\u30b2\u30fc\u30e0\u3092\u30db\u30b9\u30c8\u3059\u308b\u306b\u306f\u3001\u3059\u3079\u3066\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u30b9\u30e0\u30fc\u30ba\u3067\u697d\u3057\u3044\u4f53\u9a13\u3092\u4fdd\u8a3c\u3059\u308b\u305f\u3081\u306b\u3001\u6ce8\u610f\u6df1\u304f\u8a2d\u5b9a\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002STEP1 - \u30e1\u30a4\u30f3\u30e1\u30cb\u30e5\u30fc\u304b\u3089\u300e\u30aa\u30f3\u30e9\u30a4\u30f3\u300f\u3092\u9078\u629e\u3057\u3001\u6b21\u306b\u300e\u30d7\u30e9\u30a4\u30d9\u30fc\u30c8\u300f\u3092\u9078\u629e\u3057\u3066\u30d7\u30e9\u30a4\u30d9\u30fc\u30c8\u30ed\u30d3\u30fc\u3092\u4f5c\u6210\u3057\u307e\u3059\u3002STEP2 - \u30ed\u30d3\u30fc\u30b3\u30fc\u30c9\u3092\u53cb\u9054\u3084\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u30e1\u30f3\u30d0\u30fc\u3068\u5171\u6709\u3057\u3066\u3001\u53c2\u52a0\u3067\u304d\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002STEP3 - \u30a4\u30f3\u30dd\u30b9\u30bf\u30fc\u306e\u6570\u3001\u30bf\u30b9\u30af\u6570\u3001\u30c7\u30a3\u30b9\u30ab\u30c3\u30b7\u30e7\u30f3\u6642\u9593\u306a\u3069\u306e\u30b2\u30fc\u30e0\u8a2d\u5b9a\u3092\u3001\u30b0\u30eb\u30fc\u30d7\u306e\u597d\u307f\u306b\u5408\u308f\u305b\u3066\u8abf\u6574\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u3088\u308a\u9577\u3044\u30c7\u30a3\u30b9\u30ab\u30c3\u30b7\u30e7\u30f3\u6642\u9593\u3092\u8a2d\u5b9a\u3059\u308b\u3053\u3068\u3067\u3001\u4f1a\u8b70\u4e2d\u306b\u3088\u308a\u6226\u7565\u7684\u306a\u4f1a\u8a71\u304c\u4fc3\u9032\u3055\u308c\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u3059\u3079\u3066\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u5b89\u5b9a\u3057\u305f\u30a4\u30f3\u30bf\u30fc\u30cd\u30c3\u30c8\u63a5\u7d9a\u3092\u6301\u3063\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u3001\u5207\u65ad\u3092\u9632\u304e\u307e\u3059\u3002"}, {"question": "Among Us\u30aa\u30f3\u30e9\u30a4\u30f3\u7248\u306b\u304a\u3051\u308b\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u4e92\u63db\u6027\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "Among Us\u30aa\u30f3\u30e9\u30a4\u30f3\u7248\u306e\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u4e92\u63db\u6027\u306b\u3088\u308a\u3001\u3055\u307e\u3056\u307e\u306a\u30c7\u30d0\u30a4\u30b9\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30b7\u30fc\u30e0\u30ec\u30b9\u306b\u4e00\u7dd2\u306b\u30d7\u30ec\u30a4\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u30b2\u30fc\u30e0\u306fiOS\u3001Android\u3001PC\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u304a\u308a\u3001\u53cb\u9054\u304c\u81ea\u5206\u306e\u30c7\u30d0\u30a4\u30b9\u306b\u95a2\u4fc2\u306a\u304f\u540c\u3058\u30b2\u30fc\u30e0\u306b\u53c2\u52a0\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001iPhone\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306fWindows PC\u3067\u53cb\u9054\u304c\u958b\u50ac\u3057\u3066\u3044\u308b\u30b2\u30fc\u30e0\u306b\u53c2\u52a0\u3067\u304d\u307e\u3059\u3002\u4e92\u63db\u6027\u3092\u4fdd\u8a3c\u3059\u308b\u305f\u3081\u306b\u3001\u3059\u3079\u3066\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30b2\u30fc\u30e0\u306e\u6700\u65b0\u30d0\u30fc\u30b8\u30e7\u30f3\u3092\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u3066\u3044\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u307e\u305f\u3001\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u306f\u8ffd\u52a0\u306e\u8a2d\u5b9a\u306f\u4e0d\u8981\u3067\u3059\u3002\u30ed\u30d3\u30fc\u30b3\u30fc\u30c9\u3092\u5171\u6709\u3059\u308b\u3060\u3051\u3067\u3001\u30b5\u30dd\u30fc\u30c8\u3055\u308c\u3066\u3044\u308b\u30c7\u30d0\u30a4\u30b9\u304b\u3089\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u53c2\u52a0\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u6a5f\u80fd\u306f\u3001\u30b2\u30fc\u30e0\u306e\u30a2\u30af\u30bb\u30b7\u30d3\u30ea\u30c6\u30a3\u3068\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u3078\u306e\u53c2\u52a0\u3092\u9ad8\u3081\u307e\u3059\u3002"}, {"question": "Among Us\u30aa\u30f3\u30e9\u30a4\u30f3\u7248\u306e\u7834\u58ca\u30b7\u30b9\u30c6\u30e0\u306e\u96a0\u308c\u305f\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Among Us\u30aa\u30f3\u30e9\u30a4\u30f3\u7248\u306e\u7834\u58ca\u30b7\u30b9\u30c6\u30e0\u306b\u306f\u3001\u30a4\u30f3\u30dd\u30b9\u30bf\u30fc\u304c\u6df7\u4e71\u3092\u5f15\u304d\u8d77\u3053\u3057\u3001\u30af\u30eb\u30fc\u30e1\u30a4\u30c8\u306e\u59a8\u5bb3\u306b\u5229\u7528\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u30e1\u30ab\u30cb\u30ba\u30e0\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u9178\u7d20\u300f\u3092\u7834\u58ca\u3059\u308b\u306b\u306f\u3001\u30af\u30eb\u30fc\u30e1\u30a4\u30c8\u304c\u6642\u9593\u5236\u9650\u5185\u306b\u4e21\u65b9\u306e\u9178\u7d20\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u3092\u4fee\u6b63\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002STEP1 - \u300e\u539f\u5b50\u7089\u300f\u3084\u300e\u7167\u660e\u300f\u306a\u3069\u3001\u30af\u30eb\u30fc\u30e1\u30a4\u30c8\u306e\u30bf\u30b9\u30af\u3092\u59a8\u5bb3\u3067\u304d\u308b\u4e3b\u8981\u306a\u7834\u58ca\u30dd\u30a4\u30f3\u30c8\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002STEP2 - \u30af\u30eb\u30fc\u30e1\u30a4\u30c8\u304c\u307e\u3068\u3081\u3066\u3044\u308b\u3088\u3046\u306a\u91cd\u5927\u306a\u72b6\u6cc1\u6642\u306b\u3001\u6226\u7565\u7684\u306b\u7834\u58ca\u3092\u884c\u3044\u307e\u3059\u3002STEP3 - \u30af\u30eb\u30fc\u30e1\u30a4\u30c8\u3092\u6df7\u4e71\u3055\u305b\u3001\u5206\u65ad\u3055\u305b\u308b\u305f\u3081\u306b\u7834\u58ca\u3092\u5229\u7528\u3057\u3001\u3088\u308a\u7c21\u5358\u306b\u7247\u4ed8\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u30a4\u30f3\u30dd\u30b9\u30bf\u30fc\u306f\u30b2\u30fc\u30e0\u306e\u9032\u884c\u72b6\u6cc1\u3092\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3059\u308b\u80fd\u529b\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Among Us\u30aa\u30f3\u30e9\u30a4\u30f3\u7248\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3084\u96a0\u3055\u308c\u305f\u53c2\u7167\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Among Us\u30aa\u30f3\u30e9\u30a4\u30f3\u7248\u306b\u306f\u3001\u30b2\u30fc\u30e0\u306b\u5965\u884c\u304d\u3068\u30e6\u30fc\u30e2\u30a2\u3092\u8ffd\u52a0\u3059\u308b\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3084\u96a0\u3055\u308c\u305f\u53c2\u7167\u304c\u305f\u304f\u3055\u3093\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u4fdd\u7ba1\u5eab\u300f\u5ba4\u3067\u306f\u3001\u30b2\u30fc\u30e0\u306e\u4e2d\u5fc3\u30c6\u30fc\u30de\u3092\u6697\u793a\u3059\u308b\u3088\u3046\u306a\u300e\u30a4\u30f3\u30dd\u30b9\u30bf\u30fc\u300f\u30ed\u30b4\u306b\u4f3c\u305f\u63db\u6c17\u53e3\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u300e\u30a8\u30f3\u30b8\u30f3\u51fa\u529b\u306e\u8abf\u6574\u300f\u306a\u3069\u306e\u7279\u5b9a\u306e\u30bf\u30b9\u30af\u306b\u306f\u3001\u30af\u30e9\u30b7\u30c3\u30af\u306aSF\u306e\u30c8\u30ed\u30fc\u30d7\u3092\u53c2\u7167\u3059\u308b\u30e6\u30fc\u30e2\u30e9\u30b9\u306a\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3\u304c\u5099\u308f\u3063\u3066\u3044\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u96a0\u3055\u308c\u305f\u8981\u7d20\u3092\u63a2\u6c42\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u5145\u5b9f\u3057\u305f\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u3001\u958b\u767a\u8005\u306e\u7d30\u90e8\u306b\u307e\u3067\u3053\u3060\u308f\u3063\u305f\u70b9\u3092\u77e5\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u5b87\u5b99\u8239\u3092\u79fb\u52d5\u3059\u308b\u969b\u306b\u3001\u5fae\u5999\u306a\u30d2\u30f3\u30c8\u3068\u53c2\u7167\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305d\u308c\u3089\u306f\u3057\u3070\u3057\u3070\u30b2\u30fc\u30e0\u3078\u306e\u697d\u3057\u3055\u3092\u3055\u3089\u306b\u9ad8\u3081\u308b\u3082\u306e\u3067\u3059\u3002"}]
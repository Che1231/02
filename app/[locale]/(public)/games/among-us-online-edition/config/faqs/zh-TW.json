[{"question": "\u5982\u4f55\u5728\u300aAmong Us Online Edition\u300b\u4e2d\u57f7\u884c\u57fa\u672c\u4efb\u52d9\u4f5c\u70ba\u8239\u54e1\uff1f", "answer": "\u5728\u300aAmong Us Online Edition\u300b\u4e2d\uff0c\u4f5c\u70ba\u8239\u54e1\uff0c\u60a8\u7684\u4e3b\u8981\u76ee\u6a19\u662f\u5b8c\u6210\u4efb\u52d9\uff0c\u4ee5\u78ba\u4fdd\u98db\u8239\u7684\u6b63\u5e38\u904b\u4f5c\u3002\u4f8b\u5982\uff0c\u5728\"\u7ba1\u7406\u54e1\"\u623f\u9593\uff0c\u60a8\u53ef\u80fd\u9700\u8981\u901a\u904e\u5c07\u5361\u7247\u62d6\u52d5\u5230\u8b80\u5361\u5668\u4e0a\u4f86\u5237\u5361\u3002\u8981\u6709\u6548\u5730\u57f7\u884c\u4efb\u52d9\uff1a\u6b65\u9a5f1 - \u4f7f\u7528\u5730\u5716\u5c0e\u822a\u5230\u4efb\u52d9\u4f4d\u7f6e\u3002\u6b65\u9a5f2 - \u9ede\u64ca\u6216\u8f15\u89f8\u4efb\u52d9\u7269\u4ef6\u8207\u4e4b\u4e92\u52d5\u3002\u6b65\u9a5f3 - \u6309\u7167\u87a2\u5e55\u4e0a\u7684\u6307\u793a\u5b8c\u6210\u4efb\u52d9\u3002\u8acb\u8a18\u4f4f\uff0c\u4efb\u52d9\u6703\u6839\u64da\u60a8\u7684\u8239\u54e1\u984f\u8272\u9032\u884c\u984f\u8272\u7de8\u78bc\uff0c\u8b93\u60a8\u66f4\u5bb9\u6613\u8b58\u5225\u5c6c\u65bc\u60a8\u7684\u4efb\u52d9\u3002"}, {"question": "\u5728\u300aAmong Us Online Edition\u300b\u4e2d\uff0c\u8b58\u5225\u9a19\u5b50\u7684\u95dc\u9375\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u300aAmong Us Online Edition\u300b\u4e2d\u8b58\u5225\u9a19\u5b50\u9700\u8981\u654f\u92b3\u7684\u89c0\u5bdf\u529b\u548c\u7b56\u7565\u6027\u601d\u7dad\u3002\u4e00\u7a2e\u6709\u6548\u7684\u7b56\u7565\u662f\u76e3\u63a7\u73a9\u5bb6\u7684\u79fb\u52d5\u3002\u4f8b\u5982\uff0c\u5982\u679c\u770b\u5230\u73a9\u5bb6\u6b63\u5728\u901a\u98a8\u53e3\u79fb\u52d5\uff0c\u9019\u5c31\u660e\u986f\u8868\u660e\u8a72\u73a9\u5bb6\u662f\u9a19\u5b50\u3002\u6b65\u9a5f1 - \u6ce8\u610f\u4e0d\u5c0b\u5e38\u7684\u884c\u70ba\uff0c\u4f8b\u5982\u73a9\u5bb6\u8ff4\u907f\u4efb\u52d9\u6216\u507d\u9020\u4efb\u52d9\u52d5\u756b\u3002\u6b65\u9a5f2 - \u7576\u5075\u6e2c\u5230\u53ef\u7591\u6d3b\u52d5\u6642\uff0c\u4f7f\u7528\u300c\u5831\u544a\u300d\u6309\u9215\u53ec\u958b\u7dca\u6025\u6703\u8b70\u3002\u6b65\u9a5f3 - \u5728\u6703\u8b70\u671f\u9593\uff0c\u5206\u4eab\u60a8\u7684\u89c0\u5bdf\u7d50\u679c\uff0c\u4e26\u50be\u807d\u5176\u4ed6\u4eba\u7684\u63cf\u8ff0\uff0c\u4ee5\u62fc\u6e4a\u51fa\u9a19\u5b50\u7684\u8eab\u4efd\u3002\u6b64\u5916\uff0c\u6bd4\u8f03\u4e0d\u5728\u5834\u8b49\u660e\u4e5f\u6709\u52a9\u65bc\u7e2e\u5c0f\u5acc\u7591\u7bc4\u570d\u3002"}, {"question": "\u300aAmong Us Online Edition\u300b\u7684\u4efb\u52d9\u5b8c\u6210\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u300aAmong Us Online Edition\u300b\u7684\u4efb\u52d9\u5b8c\u6210\u7cfb\u7d71\u65e8\u5728\u8ffd\u8e64\u8239\u54e1\u7dad\u8b77\u98db\u8239\u7684\u9032\u5ea6\u3002\u6bcf\u500b\u4efb\u52d9\u90fd\u6709\u5177\u9ad4\u7684\u6b65\u9a5f\u9700\u8981\u9075\u5faa\u3002\u4f8b\u5982\uff0c\u5728\u300c\u96fb\u6c23\u300d\u623f\u9593\uff0c\u60a8\u53ef\u80fd\u9700\u8981\u901a\u904e\u9023\u63a5\u5339\u914d\u984f\u8272\u7684\u96fb\u7dda\u4f86\u4fee\u5fa9\u96fb\u7dda\u3002\u6b64\u7cfb\u7d71\u4f7f\u7528\u87a2\u5e55\u9802\u90e8\u7684\u9032\u5ea6\u689d\u986f\u793a\u6574\u9ad4\u4efb\u52d9\u5b8c\u6210\u60c5\u6cc1\u3002\u4efb\u52d9\u5206\u70ba\u8996\u89ba\u548c\u975e\u8996\u89ba\u985e\u5225\uff0c\u5176\u4e2d\u8996\u89ba\u4efb\u52d9\u63d0\u4f9b\u4e86\u73a9\u5bb6\u6e05\u767d\u7684\u8b49\u64da\u3002\u5b8c\u6210\u6240\u6709\u4efb\u52d9\u662f\u8239\u54e1\u8d0f\u5f97\u904a\u6232\u7684\u4e3b\u8981\u9014\u5f91\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u7406\u89e3\u901a\u98a8\u7cfb\u7d71\u5c0d\u65bc\u300aAmong Us Online Edition\u300b\u4e2d\u7684\u9a19\u5b50\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u7406\u89e3\u901a\u98a8\u7cfb\u7d71\u5c0d\u65bc\u300aAmong Us Online Edition\u300b\u4e2d\u7684\u9a19\u5b50\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u5141\u8a31\u5feb\u901f\u5728\u6574\u500b\u5730\u5716\u4e0a\u79fb\u52d5\uff0c\u5f9e\u800c\u5be6\u73fe\u7b56\u7565\u6027\u7684\u6bba\u622e\u548c\u9003\u812b\u3002\u4f8b\u5982\uff0c\u9a19\u5b50\u53ef\u4ee5\u4f7f\u7528\u901a\u98a8\u53e3\u5feb\u901f\u5f9e\u300c\u5b89\u5168\u300d\u79fb\u52d5\u5230\u300c\u91ab\u7642\u8259\u300d\u4f86\u88fd\u9020\u4e0d\u5728\u5834\u8b49\u660e\u3002\u6b65\u9a5f1 - \u627e\u5230\u901a\u98a8\u53e3\u5165\u53e3\uff0c\u901a\u5e38\u4f4d\u65bc\u300c\u9910\u5ef3\u300d\u6216\u300c\u96fb\u6c23\u300d\u7b49\u4e2d\u5fc3\u5340\u57df\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u901a\u98a8\u53e3\u5728\u623f\u9593\u4e4b\u9593\u79fb\u52d5\uff0c\u800c\u4e0d\u6703\u88ab\u8239\u54e1\u770b\u5230\u3002\u6b65\u9a5f3 - \u8a08\u5283\u60a8\u7684\u79fb\u52d5\uff0c\u907f\u514d\u88ab\u651d\u5f71\u6a5f\u6216\u5176\u4ed6\u73a9\u5bb6\u6293\u5230\u3002\u719f\u7df4\u638c\u63e1\u901a\u98a8\u53e3\u7684\u4f7f\u7528\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u9a19\u5b50\u7684\u6548\u7387\u3002"}, {"question": "\u5728\u300aAmong Us Online Edition\u300b\u4e2d\uff0c\u8996\u89ba\u4efb\u52d9\u548c\u975e\u8996\u89ba\u4efb\u52d9\u4e4b\u9593\u6709\u4ec0\u9ebc\u5340\u5225\uff1f", "answer": "\u5728\u300aAmong Us Online Edition\u300b\u4e2d\uff0c\u4efb\u52d9\u5206\u70ba\u8996\u89ba\u548c\u975e\u8996\u89ba\u985e\u578b\uff0c\u6bcf\u7a2e\u985e\u578b\u90fd\u5177\u6709\u4e0d\u540c\u7684\u76ee\u7684\u3002\u8996\u89ba\u4efb\u52d9\uff0c\u4f8b\u5982\u300c\u91ab\u7642\u8259\u6383\u63cf\u300d\uff0c\u53ef\u4ee5\u88ab\u5176\u4ed6\u73a9\u5bb6\u770b\u5230\uff0c\u63d0\u4f9b\u8239\u54e1\u6e05\u767d\u7684\u8b49\u64da\u3002\u975e\u8996\u89ba\u4efb\u52d9\uff0c\u4f8b\u5982\u300c\u4fee\u7406\u96fb\u7dda\u300d\uff0c\u6c92\u6709\u660e\u986f\u6307\u6a19\uff0c\u50c5\u7528\u65bc\u63a8\u9032\u4efb\u52d9\u689d\u3002\u4f8b\u5982\uff0c\u5728\u5176\u4ed6\u4eba\u9762\u524d\u5b8c\u6210\u8996\u89ba\u4efb\u52d9\u53ef\u4ee5\u6d88\u9664\u5acc\u7591\uff0c\u800c\u975e\u8996\u89ba\u4efb\u52d9\u5247\u9700\u8981\u57fa\u65bc\u4efb\u52d9\u5b8c\u6210\u60c5\u6cc1\u7684\u4fe1\u4efb\u3002\u7406\u89e3\u9019\u4e9b\u5340\u5225\u5c0d\u65bc\u8239\u54e1\u548c\u9a19\u5b50\u5236\u5b9a\u6709\u6548\u7b56\u7565\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u5982\u4f55\u5728\u300aAmong Us Online Edition\u300b\u4e2d\u4f7f\u7528\u7ba1\u7406\u54e1\u5730\u5716\u4f86\u8ffd\u8e64\u73a9\u5bb6\u7684\u79fb\u52d5\uff1f", "answer": "\u300aAmong Us Online Edition\u300b\u4e2d\u7684\u7ba1\u7406\u54e1\u5730\u5716\u662f\u8ffd\u8e64\u73a9\u5bb6\u79fb\u52d5\u548c\u8b58\u5225\u53ef\u7591\u884c\u70ba\u7684\u5f37\u5927\u5de5\u5177\u3002\u8981\u6709\u6548\u5730\u4f7f\u7528\u5b83\uff1a\u6b65\u9a5f1 - \u9032\u5165\u300c\u7ba1\u7406\u54e1\u300d\u623f\u9593\u4e26\u8207\u63a7\u5236\u53f0\u4e92\u52d5\u4f86\u8a2a\u554f\u7ba1\u7406\u54e1\u5730\u5716\u3002\u6b65\u9a5f2 - \u89c0\u5bdf\u4ee3\u8868\u73a9\u5bb6\u4f4d\u7f6e\u7684\u5716\u6a19\uff0c\u4e26\u5be6\u6642\u8ffd\u8e64\u4ed6\u5011\u7684\u52d5\u614b\u3002\u6b65\u9a5f3 - \u6ce8\u610f\u7570\u5e38\u60c5\u6cc1\uff0c\u4f8b\u5982\u73a9\u5bb6\u51fa\u73fe\u5728\u6c92\u6709\u4efb\u52d9\u7684\u623f\u9593\u6216\u5728\u76f8\u8ddd\u8f03\u9060\u7684\u5340\u57df\u79fb\u52d5\u904e\u5feb\u3002\u4f8b\u5982\uff0c\u5982\u679c\u770b\u5230\u73a9\u5bb6\u5728\u300c\u5b89\u5168\u300d\u623f\u9593\uff0c\u4f46\u96a8\u5f8c\u5728\u300c\u53cd\u61c9\u7210\u300d\u623f\u9593\u51fa\u73fe\uff0c\u800c\u6c92\u6709\u4f7f\u7528\u901a\u98a8\u53e3\uff0c\u9019\u5c31\u53ef\u80fd\u8868\u660e\u9a19\u5b50\u7684\u6d3b\u52d5\u3002\u7ba1\u7406\u54e1\u5730\u5716\u5c0d\u65bc\u8239\u54e1\u6536\u96c6\u8b49\u64da\u548c\u9a19\u5b50\u898f\u5283\u884c\u52d5\u5c24\u5176\u6709\u7528\u3002"}, {"question": "\u5728\u300aAmong Us Online Edition\u300b\u4e2d\uff0c\u8209\u8fa6\u79c1\u4eba\u904a\u6232\u7684\u6700\u4f73\u5be6\u52d9\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u300aAmong Us Online Edition\u300b\u4e2d\u8209\u8fa6\u79c1\u4eba\u904a\u6232\u9700\u8981\u4ed4\u7d30\u8a2d\u5b9a\uff0c\u4ee5\u78ba\u4fdd\u6240\u6709\u73a9\u5bb6\u90fd\u80fd\u6709\u4e00\u500b\u9806\u5229\u4e14\u6109\u5feb\u7684\u9ad4\u9a57\u3002\u6b65\u9a5f1 - \u5f9e\u4e3b\u9078\u55ae\u9078\u64c7\u300c\u7dda\u4e0a\u300d\u7136\u5f8c\u300c\u79c1\u4eba\u300d\u4f86\u5efa\u7acb\u79c1\u4eba\u5927\u5ef3\u3002\u6b65\u9a5f2 - \u8207\u60a8\u7684\u670b\u53cb\u6216\u793e\u7fa4\u6210\u54e1\u5206\u4eab\u5927\u5ef3\u4ee3\u78bc\uff0c\u8b93\u4ed6\u5011\u52a0\u5165\u904a\u6232\u3002\u6b65\u9a5f3 - \u8abf\u6574\u904a\u6232\u8a2d\u5b9a\uff0c\u4f8b\u5982\u9a19\u5b50\u6578\u91cf\u3001\u4efb\u52d9\u6578\u91cf\u548c\u8a0e\u8ad6\u6642\u9593\uff0c\u4ee5\u7b26\u5408\u60a8\u7fa4\u7d44\u7684\u559c\u597d\u3002\u4f8b\u5982\uff0c\u8a2d\u5b9a\u8f03\u9577\u6642\u9593\u7684\u8a0e\u8ad6\u6642\u9593\u53ef\u4ee5\u9f13\u52f5\u5728\u6703\u8b70\u671f\u9593\u9032\u884c\u66f4\u591a\u7b56\u7565\u6027\u5c0d\u8a71\u3002\u6b64\u5916\uff0c\u78ba\u4fdd\u6240\u6709\u73a9\u5bb6\u90fd\u5177\u6709\u7a69\u5b9a\u7684\u7db2\u8def\u9023\u7dda\uff0c\u4ee5\u907f\u514d\u65b7\u7dda\u3002"}, {"question": "\u300aAmong Us Online Edition\u300b\u7684\u8de8\u5e73\u53f0\u76f8\u5bb9\u6027\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u300aAmong Us Online Edition\u300b\u7684\u8de8\u5e73\u53f0\u76f8\u5bb9\u6027\u5141\u8a31\u4e0d\u540c\u88dd\u7f6e\u7684\u73a9\u5bb6\u7121\u7e2b\u5730\u4e00\u8d77\u904a\u6232\u3002\u8a72\u904a\u6232\u652f\u63f4 iOS\u3001Android \u548c PC \u5e73\u53f0\uff0c\u8b93\u670b\u53cb\u53ef\u4ee5\u52a0\u5165\u540c\u4e00\u904a\u6232\uff0c\u800c\u8207\u5176\u88dd\u7f6e\u7121\u95dc\u3002\u4f8b\u5982\uff0ciPhone \u4e0a\u7684\u73a9\u5bb6\u53ef\u4ee5\u52a0\u5165\u7531 Windows PC \u4e0a\u7684\u670b\u53cb\u4e3b\u8fa6\u7684\u904a\u6232\u3002\u70ba\u78ba\u4fdd\u76f8\u5bb9\u6027\uff0c\u6240\u6709\u73a9\u5bb6\u90fd\u5fc5\u9808\u5b89\u88dd\u6700\u65b0\u7684\u904a\u6232\u7248\u672c\u3002\u6b64\u5916\uff0c\u8de8\u5e73\u53f0\u904a\u6232\u4e0d\u9700\u8981\u4efb\u4f55\u984d\u5916\u8a2d\u5b9a\uff1b\u53ea\u9700\u5206\u4eab\u5927\u5ef3\u4ee3\u78bc\uff0c\u73a9\u5bb6\u5373\u53ef\u5f9e\u4efb\u4f55\u652f\u63f4\u7684\u88dd\u7f6e\u52a0\u5165\u904a\u6232\u3002\u6b64\u529f\u80fd\u589e\u5f37\u4e86\u904a\u6232\u7684\u4fbf\u5229\u6027\u53ca\u793e\u7fa4\u53c3\u8207\u5ea6\u3002"}, {"question": "\u300aAmong Us Online Edition\u300b\u7684\u7834\u58de\u7cfb\u7d71\u7684\u96b1\u85cf\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "\u300aAmong Us Online Edition\u300b\u7684\u7834\u58de\u7cfb\u7d71\u5305\u542b\u96b1\u85cf\u6a5f\u5236\uff0c\u9a19\u5b50\u53ef\u4ee5\u5229\u7528\u9019\u4e9b\u6a5f\u5236\u4f86\u88fd\u9020\u6df7\u4e82\u4e26\u963b\u7919\u8239\u54e1\u7684\u4efb\u52d9\u3002\u4f8b\u5982\uff0c\u7834\u58de\u300c\u6c27\u6c23\u300d\u9700\u8981\u8239\u54e1\u5728\u6642\u9650\u5167\u4fee\u5fa9\u5169\u500b\u6c27\u6c23\u7ad9\uff0c\u71df\u9020\u7dca\u8feb\u611f\u3002\u6b65\u9a5f1 - \u8b58\u5225\u95dc\u9375\u7684\u7834\u58de\u9ede\uff0c\u4f8b\u5982\u300c\u53cd\u61c9\u7210\u300d\u6216\u300c\u71c8\u5149\u300d\uff0c\u9019\u4e9b\u9ede\u53ef\u4ee5\u64fe\u4e82\u8239\u54e1\u7684\u4efb\u52d9\u3002\u6b65\u9a5f2 - \u5728\u95dc\u9375\u6642\u523b\uff08\u4f8b\u5982\u8239\u54e1\u805a\u96c6\u5728\u4e00\u8d77\u6642\uff09\u7b56\u7565\u6027\u5730\u9032\u884c\u7834\u58de\u3002\u6b65\u9a5f3 - \u5229\u7528\u7834\u58de\u4f86\u5206\u6563\u8239\u54e1\u7684\u6ce8\u610f\u529b\u4e26\u5c07\u5176\u5206\u958b\uff0c\u5f9e\u800c\u66f4\u5bb9\u6613\u5c07\u5176\u9010\u500b\u64ca\u7834\u3002\u7406\u89e3\u9019\u4e9b\u6a5f\u5236\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u9a19\u5b50\u63a7\u5236\u904a\u6232\u6d41\u7a0b\u7684\u80fd\u529b\u3002"}, {"question": "\u300aAmong Us Online Edition\u300b\u4e2d\u6709\u54ea\u4e9b\u5f69\u86cb\u548c\u96b1\u85cf\u7684\u53c3\u8003\uff1f", "answer": "\u300aAmong Us Online Edition\u300b\u5145\u6eff\u4e86\u5f69\u86cb\u548c\u96b1\u85cf\u7684\u53c3\u8003\uff0c\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u6df1\u5ea6\u548c\u5e7d\u9ed8\u3002\u4f8b\u5982\uff0c\u5728\u300c\u5132\u85cf\u300d\u623f\u9593\uff0c\u60a8\u53ef\u4ee5\u627e\u5230\u4e00\u500b\u985e\u4f3c\u300c\u9a19\u5b50\u300d\u6a19\u8a8c\u7684\u901a\u98a8\u53e3\uff0c\u6697\u793a\u904a\u6232\u7684\u6838\u5fc3\u4e3b\u984c\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u4efb\u52d9\uff0c\u4f8b\u5982\u300c\u8abf\u6574\u5f15\u64ce\u8f38\u51fa\u300d\uff0c\u5177\u6709\u6709\u8da3\u7684\u52d5\u756b\uff0c\u5411\u7d93\u5178\u79d1\u5e7b\u96fb\u5f71\u81f4\u656c\u3002\u63a2\u7d22\u9019\u4e9b\u96b1\u85cf\u5143\u7d20\u53ef\u4ee5\u8c50\u5bcc\u904a\u6232\u9ad4\u9a57\uff0c\u4e26\u5c55\u73fe\u958b\u767c\u5718\u968a\u7684\u7d30\u7dfb\u8a2d\u8a08\u3002\u5728\u60a8\u63a2\u7d22\u98db\u8239\u6642\uff0c\u8acb\u7559\u610f\u6f5b\u5728\u7684\u7dda\u7d22\u548c\u53c3\u8003\uff0c\u5b83\u5011\u901a\u5e38\u6703\u70ba\u904a\u6232\u589e\u6dfb\u984d\u5916\u7684\u6a02\u8da3\u3002"}]
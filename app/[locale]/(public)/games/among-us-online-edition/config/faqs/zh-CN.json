[{"question": "\u5982\u4f55\u5728\u300aAmong Us Online Edition\u300b\u6e38\u620f\u4e2d\u6267\u884c\u8239\u5458\u7684\u57fa\u672c\u4efb\u52a1\uff1f", "answer": "\u5728\u300aAmong Us Online Edition\u300b\u6e38\u620f\u4e2d\uff0c\u4f5c\u4e3a\u4e00\u540d\u8239\u5458\uff0c\u4f60\u7684\u4e3b\u8981\u76ee\u6807\u662f\u5b8c\u6210\u4efb\u52a1\uff0c\u4ee5\u786e\u4fdd\u98de\u8239\u7684\u6b63\u5e38\u8fd0\u884c\u3002\u4f8b\u5982\uff0c\u5728\"\u7ba1\u7406\"\u623f\u95f4\u4e2d\uff0c\u4f60\u53ef\u80fd\u9700\u8981\u901a\u8fc7\u5c06\u5361\u7247\u62d6\u8fc7\u8bfb\u53d6\u5668\u6765\u5237\u5361\u3002\u4e3a\u4e86\u6709\u6548\u5730\u6267\u884c\u4efb\u52a1\uff1a\u6b65\u9aa41 - \u4f7f\u7528\u5730\u56fe\u5bfc\u822a\u5230\u4efb\u52a1\u4f4d\u7f6e\u3002\u6b65\u9aa42 - \u70b9\u51fb\u6216\u8f7b\u89e6\u4e0e\u4efb\u52a1\u7269\u54c1\u4ea4\u4e92\u3002\u6b65\u9aa43 - \u6309\u7167\u5c4f\u5e55\u4e0a\u7684\u8bf4\u660e\u5b8c\u6210\u4efb\u52a1\u3002\u8bf7\u8bb0\u4f4f\uff0c\u4efb\u52a1\u7684\u989c\u8272\u4e0e\u4f60\u7684\u8239\u5458\u989c\u8272\u76f8\u5bf9\u5e94\uff0c\u8fd9\u4f7f\u5f97\u8bc6\u522b\u4f60\u7684\u4efb\u52a1\u66f4\u5bb9\u6613\u3002"}, {"question": "\u5728\u300aAmong Us Online Edition\u300b\u6e38\u620f\u4e2d\u8bc6\u522b\u6f5c\u4f0f\u8005\u7684\u5173\u952e\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300aAmong Us Online Edition\u300b\u6e38\u620f\u4e2d\u8bc6\u522b\u6f5c\u4f0f\u8005\u9700\u8981\u654f\u9510\u7684\u89c2\u5bdf\u529b\u548c\u6218\u7565\u601d\u7ef4\u3002\u4e00\u79cd\u6709\u6548\u7684\u7b56\u7565\u662f\u76d1\u63a7\u73a9\u5bb6\u7684\u79fb\u52a8\u3002\u4f8b\u5982\uff0c\u5982\u679c\u770b\u5230\u4e00\u540d\u73a9\u5bb6\u6b63\u5728\u901a\u98ce\uff0c\u8fd9\u6e05\u695a\u5730\u8868\u660e\u4ed6/\u5979\u662f\u4e00\u4e2a\u6f5c\u4f0f\u8005\u3002\u6b65\u9aa41 - \u89c2\u5bdf\u4e0d\u5bfb\u5e38\u7684\u884c\u4e3a\u4f8b\u5982\uff0c\u73a9\u5bb6\u907f\u5f00\u4efb\u52a1\u6216\u5047\u88c5\u5b8c\u6210\u4efb\u52a1\u52a8\u753b\u3002\u6b65\u9aa42 - \u5728\u53d1\u73b0\u53ef\u7591\u6d3b\u52a8\u65f6\uff0c\u4f7f\u7528\"\u62a5\u544a\"\u6309\u94ae\u53ec\u96c6\u7d27\u6025\u4f1a\u8bae\u3002\u6b65\u9aa43 - \u5728\u4f1a\u8bae\u671f\u95f4\uff0c\u5206\u4eab\u4f60\u7684\u89c2\u5bdf\u7ed3\u679c\u5e76\u8046\u542c\u5176\u4ed6\u4eba\u7684\u63cf\u8ff0\uff0c\u4ee5\u62fc\u51d1\u51fa\u6f5c\u4f0f\u8005\u7684\u8eab\u4efd\u3002\u6b64\u5916\uff0c\u6bd4\u8f83\u4e0d\u5728\u573a\u7684\u7406\u7531\u6709\u52a9\u4e8e\u7f29\u5c0f\u5acc\u7591\u72af\u8303\u56f4\u3002"}, {"question": "\u300aAmong Us Online Edition\u300b\u4e2d\u7684\u4efb\u52a1\u5b8c\u6210\u7cfb\u7edf\u5982\u4f55\u8fd0\u4f5c\uff1f", "answer": "\u300aAmong Us Online Edition\u300b\u4e2d\u7684\u4efb\u52a1\u5b8c\u6210\u7cfb\u7edf\u65e8\u5728\u8ffd\u8e2a\u8239\u5458\u5728\u7ef4\u62a4\u98de\u8239\u65b9\u9762\u53d6\u5f97\u7684\u8fdb\u5c55\u3002\u6bcf\u4e2a\u4efb\u52a1\u90fd\u6709\u4e00\u4e2a\u5fc5\u987b\u9075\u5faa\u7684\u7279\u5b9a\u6b65\u9aa4\u3002\u4f8b\u5982\uff0c\u5728\"\u7535\u529b\"\u623f\u95f4\u4e2d\uff0c\u4f60\u53ef\u80fd\u9700\u8981\u901a\u8fc7\u8fde\u63a5\u989c\u8272\u5339\u914d\u7684\u7535\u7ebf\u6765\u4fee\u590d\u7ebf\u8def\u3002\u8be5\u7cfb\u7edf\u5728\u5c4f\u5e55\u9876\u90e8\u4f7f\u7528\u8fdb\u5ea6\u6761\u663e\u793a\u6574\u4f53\u4efb\u52a1\u5b8c\u6210\u60c5\u51b5\u3002\u4efb\u52a1\u88ab\u5212\u5206\u4e3a\u89c6\u89c9\u548c\u975e\u89c6\u89c9\u7c7b\u522b\uff0c\u89c6\u89c9\u4efb\u52a1\u63d0\u4f9b\u4e86\u73a9\u5bb6\u6e05\u767d\u7684\u8bc1\u636e\u3002\u5b8c\u6210\u6240\u6709\u4efb\u52a1\u662f\u8239\u5458\u8d62\u5f97\u6bd4\u8d5b\u7684\u4e3b\u8981\u65b9\u5f0f\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u7406\u89e3\u901a\u98ce\u7cfb\u7edf\u5bf9\u4e8e\u300aAmong Us Online Edition\u300b\u4e2d\u7684\u6f5c\u4f0f\u8005\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u5728\u300aAmong Us Online Edition\u300b\u4e2d\uff0c\u7406\u89e3\u901a\u98ce\u7cfb\u7edf\u5bf9\u4e8e\u6f5c\u4f0f\u8005\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u53ef\u4ee5\u5feb\u901f\u5728\u5730\u56fe\u4e0a\u79fb\u52a8\uff0c\u4ece\u800c\u5b9e\u65bd\u7b56\u7565\u6027\u6697\u6740\u548c\u9003\u8131\u3002\u4f8b\u5982\uff0c\u6f5c\u4f0f\u8005\u53ef\u4ee5\u4f7f\u7528\u901a\u98ce\u53e3\u5feb\u901f\u4ece\"\u5b89\u5168\"\u533a\u79fb\u52a8\u5230\"\u533b\u52a1\u5ba4\"\u521b\u9020\u4e0d\u5728\u573a\u8bc1\u660e\u3002\u6b65\u9aa41 - \u627e\u5230\u901a\u98ce\u53e3\u5165\u53e3\uff0c\u901a\u5e38\u5728\"\u81ea\u52a9\u9910\u5385\"\u6216\"\u7535\u529b\"\u7b49\u4e2d\u5fc3\u533a\u57df\u3002\u6b65\u9aa42 - \u4f7f\u7528\u901a\u98ce\u53e3\u5728\u4e0d\u88ab\u8239\u5458\u53d1\u73b0\u7684\u60c5\u51b5\u4e0b\u5728\u623f\u95f4\u4e4b\u95f4\u79fb\u52a8\u3002\u6b65\u9aa43 - \u8ba1\u5212\u4f60\u7684\u884c\u52a8\u4ee5\u907f\u514d\u88ab\u6444\u50cf\u5934\u6216\u5176\u4ed6\u73a9\u5bb6\u6293\u83b7\u3002\u719f\u7ec3\u638c\u63e1\u901a\u98ce\u53e3\u7684\u4f7f\u7528\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u6f5c\u4f0f\u8005\u7684\u6548\u7387\u3002"}, {"question": "\u300aAmong Us Online Edition\u300b\u4e2d\u7684\u89c6\u89c9\u4efb\u52a1\u548c\u975e\u89c6\u89c9\u4efb\u52a1\u6709\u4ec0\u4e48\u533a\u522b\uff1f", "answer": "\u5728\u300aAmong Us Online Edition\u300b\u4e2d\uff0c\u4efb\u52a1\u88ab\u5206\u4e3a\u89c6\u89c9\u548c\u975e\u89c6\u89c9\u7c7b\u578b\uff0c\u6bcf\u79cd\u7c7b\u578b\u90fd\u6709\u4e0d\u540c\u7684\u7528\u9014\u3002\u89c6\u89c9\u4efb\u52a1\uff0c\u4f8b\u5982\"\u533b\u52a1\u5ba4\u626b\u63cf\"\uff0c\u53ef\u4ee5\u88ab\u5176\u4ed6\u73a9\u5bb6\u770b\u5230\uff0c\u63d0\u4f9b\u8239\u5458\u6e05\u767d\u7684\u8bc1\u636e\u3002\u975e\u89c6\u89c9\u4efb\u52a1\uff0c\u5982\"\u4fee\u590d\u7535\u7ebf\"\uff0c\u6ca1\u6709\u660e\u663e\u7684\u6307\u793a\uff0c\u4ec5\u7528\u4e8e\u63a8\u8fdb\u4efb\u52a1\u8fdb\u5ea6\u6761\u3002\u4f8b\u5982\uff0c\u5728\u5176\u4ed6\u73a9\u5bb6\u9762\u524d\u5b8c\u6210\u89c6\u89c9\u4efb\u52a1\u53ef\u4ee5\u6d88\u9664\u6000\u7591\uff0c\u800c\u975e\u89c6\u89c9\u4efb\u52a1\u5219\u9700\u8981\u57fa\u4e8e\u4efb\u52a1\u5b8c\u6210\u60c5\u51b5\u5efa\u7acb\u4fe1\u4efb\u3002\u7406\u89e3\u8fd9\u4e9b\u533a\u522b\u5bf9\u4e8e\u8239\u5458\u548c\u6f5c\u4f0f\u8005\u6709\u6548\u5236\u5b9a\u7b56\u7565\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u5982\u4f55\u5728\u300aAmong Us Online Edition\u300b\u6e38\u620f\u4e2d\u4f7f\u7528\u7ba1\u7406\u5458\u5730\u56fe\u6765\u8ffd\u8e2a\u73a9\u5bb6\u7684\u79fb\u52a8\uff1f", "answer": "\u300aAmong Us Online Edition\u300b\u4e2d\u7684\u7ba1\u7406\u5458\u5730\u56fe\u662f\u4e00\u4e2a\u5f3a\u5927\u7684\u5de5\u5177\uff0c\u7528\u4e8e\u8ffd\u8e2a\u73a9\u5bb6\u7684\u79fb\u52a8\u548c\u8bc6\u522b\u53ef\u7591\u884c\u4e3a\u3002\u4e3a\u4e86\u6709\u6548\u5730\u4f7f\u7528\u5b83\uff1a\u6b65\u9aa41 - \u901a\u8fc7\u8fdb\u5165\"\u7ba1\u7406\"\u623f\u95f4\u5e76\u4e0e\u63a7\u5236\u53f0\u4ea4\u4e92\u6765\u8bbf\u95ee\u7ba1\u7406\u5458\u5730\u56fe\u3002\u6b65\u9aa42 - \u5b9e\u65f6\u89c2\u5bdf\u4ee3\u8868\u73a9\u5bb6\u4f4d\u7f6e\u7684\u56fe\u6807\u3002\u6b65\u9aa43 - \u5bfb\u627e\u5f02\u5e38\u60c5\u51b5\uff0c\u4f8b\u5982\u73a9\u5bb6\u51fa\u73b0\u5728\u6ca1\u6709\u4efb\u52a1\u7684\u623f\u95f4\u6216\u5728\u76f8\u8ddd\u8f83\u8fdc\u7684\u533a\u57df\u4e4b\u95f4\u79fb\u52a8\u8fc7\u5feb\u3002\u4f8b\u5982\uff0c\u5982\u679c\u770b\u5230\u4e00\u540d\u73a9\u5bb6\u51fa\u73b0\u5728\"\u5b89\u5168\"\u533a\uff0c\u4f46\u968f\u540e\u5728\"\u53cd\u5e94\u5806\"\u533a\u51fa\u73b0\uff0c\u800c\u6ca1\u6709\u4f7f\u7528\u901a\u98ce\u53e3\uff0c\u5219\u53ef\u80fd\u8868\u660e\u6f5c\u4f0f\u8005\u7684\u6d3b\u52a8\u3002\u7ba1\u7406\u5458\u5730\u56fe\u5bf9\u4e8e\u8239\u5458\u6536\u96c6\u8bc1\u636e\u548c\u6f5c\u4f0f\u8005\u89c4\u5212\u884c\u52a8\u7279\u522b\u6709\u7528\u3002"}, {"question": "\u5728\u300aAmong Us Online Edition\u300b\u4e2d\u4e3e\u529e\u79c1\u4eba\u6e38\u620f\u7684\u6700\u4f73\u5b9e\u8df5\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300aAmong Us Online Edition\u300b\u4e2d\u4e3e\u529e\u79c1\u4eba\u6e38\u620f\u9700\u8981\u4ed4\u7ec6\u8bbe\u7f6e\uff0c\u4ee5\u786e\u4fdd\u6240\u6709\u73a9\u5bb6\u62e5\u6709\u6d41\u7545\u6109\u5feb\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u6b65\u9aa41 - \u901a\u8fc7\u4ece\u4e3b\u83dc\u5355\u9009\u62e9\"\u5728\u7ebf\"\u7136\u540e\"\u79c1\u4eba\"\u521b\u5efa\u79c1\u4eba\u623f\u95f4\u3002\u6b65\u9aa42 - \u4e0e\u4f60\u7684\u670b\u53cb\u6216\u793e\u7fa4\u6210\u5458\u5171\u4eab\u623f\u95f4\u4ee3\u7801\uff0c\u5141\u8bb8\u4ed6\u4eec\u52a0\u5165\u3002\u6b65\u9aa43 - \u8c03\u6574\u6e38\u620f\u8bbe\u7f6e\uff0c\u4f8b\u5982\u6f5c\u4f0f\u8005\u7684\u6570\u91cf\u3001\u4efb\u52a1\u7684\u6570\u91cf\u548c\u8ba8\u8bba\u65f6\u95f4\uff0c\u4ee5\u6ee1\u8db3\u4f60\u56e2\u961f\u7684\u559c\u597d\u3002\u4f8b\u5982\uff0c\u8bbe\u7f6e\u66f4\u957f\u7684\u8ba8\u8bba\u65f6\u95f4\u53ef\u4ee5\u9f13\u52b1\u5728\u4f1a\u8bae\u671f\u95f4\u8fdb\u884c\u66f4\u5177\u7b56\u7565\u6027\u7684\u5bf9\u8bdd\u3002\u6b64\u5916\uff0c\u786e\u4fdd\u6240\u6709\u73a9\u5bb6\u62e5\u6709\u7a33\u5b9a\u7684\u4e92\u8054\u7f51\u8fde\u63a5\u4ee5\u907f\u514d\u65ad\u5f00\u8fde\u63a5\u3002"}, {"question": "\u300aAmong Us Online Edition\u300b\u4e2d\u7684\u8de8\u5e73\u53f0\u517c\u5bb9\u6027\u5982\u4f55\u8fd0\u4f5c\uff1f", "answer": "\u300aAmong Us Online Edition\u300b\u4e2d\u7684\u8de8\u5e73\u53f0\u517c\u5bb9\u6027\u5141\u8bb8\u4e0d\u540c\u8bbe\u5907\u4e0a\u7684\u73a9\u5bb6\u65e0\u7f1d\u5730\u4e00\u8d77\u73a9\u6e38\u620f\u3002\u8be5\u6e38\u620f\u652f\u6301 iOS\u3001Android \u548c PC \u5e73\u53f0\uff0c\u4f7f\u670b\u53cb\u80fd\u591f\u52a0\u5165\u540c\u4e00\u6e38\u620f\uff0c\u65e0\u8bba\u4ed6\u4eec\u4f7f\u7528\u4f55\u79cd\u8bbe\u5907\u3002\u4f8b\u5982\uff0ciPhone \u4e0a\u7684\u73a9\u5bb6\u53ef\u4ee5\u52a0\u5165\u7531 Windows PC \u4e0a\u7684\u670b\u53cb\u4e3b\u529e\u7684\u6e38\u620f\u3002\u4e3a\u4e86\u786e\u4fdd\u517c\u5bb9\u6027\uff0c\u6240\u6709\u73a9\u5bb6\u90fd\u5fc5\u987b\u5b89\u88c5\u6700\u65b0\u7248\u672c\u7684\u8be5\u6e38\u620f\u3002\u6b64\u5916\uff0c\u8de8\u5e73\u53f0\u6e38\u620f\u65e0\u9700\u4efb\u4f55\u989d\u5916\u8bbe\u7f6e\uff1b\u53ea\u9700\u5171\u4eab\u623f\u95f4\u4ee3\u7801\uff0c\u73a9\u5bb6\u5c31\u53ef\u4ee5\u4ece\u4efb\u4f55\u652f\u6301\u7684\u8bbe\u5907\u52a0\u5165\u3002\u6b64\u529f\u80fd\u589e\u5f3a\u4e86\u6e38\u620f\u7684\u6613\u7528\u6027\u548c\u793e\u533a\u53c2\u4e0e\u5ea6\u3002"}, {"question": "\u300aAmong Us Online Edition\u300b\u4e2d\u7684\u7834\u574f\u7cfb\u7edf\u9690\u85cf\u673a\u5236\u6709\u54ea\u4e9b\uff1f", "answer": "\u300aAmong Us Online Edition\u300b\u4e2d\u7684\u7834\u574f\u7cfb\u7edf\u5305\u542b\u6f5c\u4f0f\u8005\u53ef\u4ee5\u5229\u7528\u4ee5\u5236\u9020\u6df7\u4e71\u5e76\u963b\u788d\u8239\u5458\u7684\u9690\u85cf\u673a\u5236\u3002\u4f8b\u5982\uff0c\u7834\u574f\"\u6c27\u6c14\"\u9700\u8981\u8239\u5458\u5728\u9650\u65f6\u5185\u4fee\u590d\u4e24\u4e2a\u6c27\u6c14\u7ad9\uff0c\u8425\u9020\u4e00\u79cd\u7d27\u8feb\u611f\u3002\u6b65\u9aa41 - \u8bc6\u522b\u5173\u952e\u7834\u574f\u70b9\uff0c\u4f8b\u5982\"\u53cd\u5e94\u5806\"\u6216\"\u706f\u5149\"\uff0c\u8fd9\u4e9b\u70b9\u4f1a\u6270\u4e71\u8239\u5458\u7684\u4efb\u52a1\u3002\u6b65\u9aa42 - \u5728\u5173\u952e\u65f6\u523b\uff0c\u4f8b\u5982\u8239\u5458\u805a\u96c6\u5728\u4e00\u8d77\u7684\u65f6\u523b\uff0c\u6218\u7565\u6027\u5730\u5b9e\u65bd\u7834\u574f\u3002\u6b65\u9aa43 - \u4f7f\u7528\u7834\u574f\u6765\u5206\u6563\u548c\u5206\u5272\u8239\u5458\uff0c\u4f7f\u5176\u66f4\u5bb9\u6613\u9010\u4e00\u51fb\u7834\u3002\u7406\u89e3\u8fd9\u4e9b\u673a\u5236\u53ef\u4ee5\u663e\u8457\u589e\u5f3a\u6f5c\u4f0f\u8005\u63a7\u5236\u6e38\u620f\u6d41\u7a0b\u7684\u80fd\u529b\u3002"}, {"question": "\u300aAmong Us Online Edition\u300b\u4e2d\u7684\u5f69\u86cb\u548c\u9690\u85cf\u5f15\u7528\u6709\u54ea\u4e9b\uff1f", "answer": "\u300aAmong Us Online Edition\u300b\u5145\u6ee1\u4e86\u5f69\u86cb\u548c\u9690\u85cf\u5f15\u7528\uff0c\u4f7f\u6e38\u620f\u66f4\u5177\u6df1\u5ea6\u548c\u8da3\u5473\u3002\u4f8b\u5982\uff0c\u5728\"\u7269\u8d44\"\u623f\u95f4\u4e2d\uff0c\u4f60\u53ef\u4ee5\u627e\u5230\u4e00\u4e2a\u7c7b\u4f3c\"\u6f5c\u4f0f\u8005\"\u6807\u5fd7\u7684\u901a\u98ce\u53e3\uff0c\u6697\u793a\u7740\u6e38\u620f\u7684\u6838\u5fc3\u4e3b\u9898\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u4efb\u52a1\uff0c\u4f8b\u5982\"\u8c03\u6574\u5f15\u64ce\u8f93\u51fa\"\uff0c\u5305\u542b\u5bf9\u7ecf\u5178\u79d1\u5e7b\u4f5c\u54c1\u7684\u5e7d\u9ed8\u52a8\u753b\u53c2\u8003\u3002\u63a2\u7d22\u8fd9\u4e9b\u9690\u85cf\u5143\u7d20\u53ef\u4ee5\u5e26\u6765\u66f4\u4e30\u5bcc\u7684\u6e38\u620f\u4f53\u9a8c\uff0c\u5e76\u5c55\u73b0\u5f00\u53d1\u4eba\u5458\u7684\u7ec6\u81f4\u5165\u5fae\u3002\u5728\u4f60\u63a2\u7d22\u98de\u8239\u65f6\uff0c\u7559\u610f\u7ec6\u5fae\u7684\u7ebf\u7d22\u548c\u5f15\u7528\uff0c\u56e0\u4e3a\u5b83\u4eec\u901a\u5e38\u4e3a\u6e38\u620f\u589e\u6dfb\u4e86\u989d\u5916\u7684\u4e50\u8da3\u3002"}]
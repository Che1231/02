[{"question": "\ub808\ubca8\uc5c5 \ubcfc\uc988\uc5d0\uc11c \uacf5\uc744 \uc5b4\ub5bb\uac8c \uc81c\uc5b4\ud558\uace0 \uae30\ubcf8\uc801\uc778 \uc6c0\uc9c1\uc784\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub808\ubca8\uc5c5 \ubcfc\uc988\uc5d0\uc11c \uacf5 \uc81c\uc5b4\ub294 \ubc29\ud5a5\ud0a4\ub098 \uc870\uc774\uc2a4\ud2f1\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc88c\uc6b0, \uc55e\ub4a4\ub85c \uc6c0\uc9c1\uc774\ub294 \uac83\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c\ub294 \uc7a5\uc560\ubb3c\uc744 \ud53c\ud574 \ubbf8\ub85c\ub97c \ud0d0\uc0c9\ud558\uae30 \uc704\ud574 \uc870\uc774\uc2a4\ud2f1\uc744 \uc0b4\uc9dd \uae30\uc6b8\uc5ec\uc57c \ud569\ub2c8\ub2e4. \ub610\ud55c, \uc810\ud504 \ubc84\ud2bc\uc744 \ub204\ub974\uba74 \uacf5\uc774 \uac04\uaca9\uc744 \ub6f0\uc5b4\ub118\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \uc870\uc774\uc2a4\ud2f1\uc744 \ubd80\ub4dc\ub7fd\uac8c \uae30\uc6b8\uc5ec \uc6c0\uc9c1\uc785\ub2c8\ub2e4. STEP2: \uc801\uc808\ud55c \uc2dc\uc810\uc5d0 \uc810\ud504 \ubc84\ud2bc\uc744 \ub204\ub985\ub2c8\ub2e4. STEP3: \ud29c\ud1a0\ub9ac\uc5bc \ub808\ubca8\uc5d0\uc11c \uc5f0\uc2b5\ud558\uc5ec \uc870\uc791\uac10\uc744 \uc775\uc219\ud574\uc9d1\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uacf5\uc744 \uad6c\ubd88\uad6c\ubd88\ud55c \uae38\uc744 \uc6b4\uc804\ud558\ub294 \ucc28\ub7c9\uc73c\ub85c \uc0dd\uac01\ud558\uc138\uc694. \uc815\ud655\uc131\uc774 \ud575\uc2ec\uc785\ub2c8\ub2e4.]"}, {"question": "\uc65c \ub808\ubca8\uc5c5 \ubcfc\uc988\uc5d0\uc11c \uacf5\uc774 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uacc4\uc18d \ub5a8\uc5b4\uc9c0\uace0 \uc5b4\ub5bb\uac8c \ubc29\uc9c0\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub5a8\uc5b4\uc9c0\ub294 \uacbd\uc6b0\ub294 \uc885\uc885 \uacfc\ub3c4\ud55c \uc870\uc791\uc774\ub098 \uc810\ud504 \ud310\ub2e8 \uc624\ub958\ub85c \ubc1c\uc0dd\ud569\ub2c8\ub2e4. \ub808\ubca8\uc5c5 \ubcfc\uc988\uc5d0\uc11c \uac01 \ud50c\ub7ab\ud3fc\uc740 '\ud558\ub298 \ub192\uc774' \ub808\ubca8\uc758 \uc881\uc740 \ub2e4\ub9ac\uc640 \uac19\uc774 \ub3c5\ud2b9\ud55c \ub808\uc774\uc544\uc6c3\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ub5a8\uc5b4\uc9c0\ub294 \uac83\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud574 STEP1: \uc6c0\uc9c1\uc784\uc744 \uc904\uc774\uace0 \uac11\uc791\uc2a4\ub7ec\uc6b4 \uae30\uc6b8\uc784\uc744 \ud53c\ud558\uc2ed\uc2dc\uc624. STEP2: \uce74\uba54\ub77c \uac01\ub3c4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uac70\ub9ac\ub97c \ub354 \uc798 \ud310\ub2e8\ud569\ub2c8\ub2e4. STEP3: \uc791\uc740 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc810\ud504 \ud0c0\uc774\ubc0d \uc5f0\uc2b5\uc744 \uba3c\uc800 \ud569\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \uc881\uc740 \ud50c\ub7ab\ud3fc\uc740 \ub290\ub9b0 \uc6c0\uc9c1\uc784\uc774 \ud544\uc694\ud558\uc9c0\ub9cc \ub113\uc740 \ud50c\ub7ab\ud3fc\uc740 \ube60\ub978 \uc774\ub3d9\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4.]"}, {"question": "\ub808\ubca8\uc5c5 \ubcfc\uc988\uc758 \ud30c\uc6cc\uc5c5\uc740 \ubb34\uc5c7\uc774\uba70, \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0a4\ub098\uc694?", "answer": "\ub808\ubca8\uc5c5 \ubcfc\uc988\uc5d0\ub294 \uc18d\ub3c4 \ubd80\uc2a4\ud130\uc640 \uc77c\uc815 \uc2dc\uac04 \ub3d9\uc548 \uc704\ud5d8\uc73c\ub85c\ubd80\ud130 \ubcf4\ud638\ud574\uc8fc\ub294 \ubc29\ud328\uc640 \uac19\uc740 \uc5ec\ub7ec \ud30c\uc6cc\uc5c5\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud06c\ub9ac\uc2a4\ud0c8 \ub3d9\uad74' \ub808\ubca8\uc5d0\uc11c \uc18d\ub3c4 \ubd80\uc2a4\ud130\ub294 \uad74\ub7ec\uac00\ub294 \ubc14\uc704\ub97c \ud53c\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. STEP1: \uc9c0\ub3c4\uc5d0 \ube5b\ub098\ub294 \uc544\uc774\ucf58\uc744 \ucc3e\uc2b5\ub2c8\ub2e4. STEP2: \uc704\ub85c \uad74\ub7ec\uc11c \ud65c\uc131\ud654\ud569\ub2c8\ub2e4. STEP3: \uc790\uc8fc \uc704\ud5d8\uc774 \ubc1c\uc0dd\ud558\ub294 \uad6c\uac04\uc5d0\ub294 \ubc29\ud328\ub97c \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc194\ub8e8\uc158 \ube44\uad50: \uc18d\ub3c4 \ubd80\uc2a4\ud130\ub294 \uc2dc\uac04 \uacbd\uc7c1 \uc2dc\ud5d8\uc5d0 \uc801\ud569\ud558\uace0 \ubc29\ud328\ub294 \uc0dd\uc874 \uc911\uc2ec \ub808\ubca8\uc5d0 \ub354 \uc801\ud569\ud569\ub2c8\ub2e4.]"}, {"question": "\ub808\ubca8\uc5c5 \ubcfc\uc988\uc5d0\uc11c \uc810\uc218\ub97c \ucd5c\uc801\ud654\ud558\uace0 \uc5b4\ub5a4 \uc804\ub7b5\uc744 \uc0ac\uc6a9\ud574\uc57c \ud558\ub098\uc694?", "answer": "\ub808\ubca8\uc5c5 \ubcfc\uc988\uc5d0\uc11c \uc810\uc218\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \uac00\ub2a5\ud55c \ud55c \ubaa8\ub4e0 \ubcf4\uc11d\uc744 \ubaa8\uc73c\uace0 \ub808\ubca8\uc744 \ube60\ub974\uac8c \uc644\ub8cc\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uace8\ub4e0 \uadf8\ub85c\ube0c' \ub808\ubca8\uc5d0\uc11c \uc228\uaca8\uc9c4 \ubcf4\uc11d \ud074\ub7ec\uc2a4\ud130\ub97c \ubc1c\uacac\ud558\uc5ec \ubcf4\ub108\uc2a4 \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \uc228\uaca8\uc9c4 \uc544\uc774\ud15c\uc744 \uc704\ud574 \uc9c0\ub3c4\uc758 \ubaa8\ub4e0 \uad6c\uc11d\uc744 \ud0d0\ud5d8\ud569\ub2c8\ub2e4. STEP2: \uba3c \ubcf4\uc11d\uc744 \ub04c\uc5b4\ub2f9\uae30\ub294 \uc790\uc11d\uacfc \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. STEP3: \uc18d\ub3c4 \ub2ec\ub9ac\uae30\ub97c \uc5f0\uc2b5\ud558\uc5ec \uc644\ub8cc \uc2dc\uac04\uc744 \uc904\uc785\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \ub2e4\uc774\uc5b4\uadf8\ub7a8: \ud0d0\ud5d8 \u2192 \uc218\uc9d1 \u2192 \uc18d\ub3c4 \ub2ec\ub9ac\uae30 \u2192 \ubc18\ubcf5.]"}, {"question": "\uc65c \ub808\ubca8\uc5c5 \ubcfc\uc988\uc758 \uc77c\ubd80 \ub808\ubca8\uc740 \ub2e4\ub978 \ub808\ubca8\ubcf4\ub2e4 \uc5b4\ub824\uc6b4\uac00\uc694? \uc5b4\ub5bb\uac8c \ub300\ube44\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub808\ubca8\uc5c5 \ubcfc\uc988\uc758 \ub09c\uc774\ub3c4\ub294 \ud50c\ub7ab\ud3fc \ubcf5\uc7a1\uc131, \uc801 \ubc30\uce58, \ud658\uacbd \uc704\ud5d8\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc6a9\uc554 \ubbf8\uad81' \ub808\ubca8\uc740 \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uacfc \ubd88 \ud568\uc815\uc744 \ub3c4\uc785\ud569\ub2c8\ub2e4. \ub300\ube44\ud558\uae30 \uc704\ud574 STEP1: \uae30\ubcf8 \uc870\uc791\uc744 \ub9c8\uc2a4\ud130\ud558\uae30 \uc704\ud574 \uc774\uc804 \ub808\ubca8\uc744 \ub2e4\uc2dc \ud50c\ub808\uc774\ud569\ub2c8\ub2e4. STEP2: \ubbf8\ub9ac \ubcf4\uae30 \ud654\uba74\uc5d0\uc11c \ub808\ubca8 \ub808\uc774\uc544\uc6c3\uc744 \uacf5\ubd80\ud569\ub2c8\ub2e4. STEP3: \ucd94\uac00\uc801\uc778 \ubcf4\ud638\ub97c \uc704\ud574 \ubc29\ud328\uc640 \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc7a5\ucc29\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ub9c8\ub77c\ud1a4 \uc5f0\uc2b5\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uac01 \ub808\ubca8\uc740 \uadc0\ud558\uc758 \uae30\uc220\uc744 \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4.]"}, {"question": "\ub808\ubca8\uc5c5 \ubcfc\uc988\uc758 \uc5f0\uc18d \ucf64\ubcf4 \uc2dc\uc2a4\ud15c\uc758 \uc911\uc694\uc131\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "\ub808\ubca8\uc5c5 \ubcfc\uc988\uc758 \ucf64\ubcf4 \uc2dc\uc2a4\ud15c\uc740 \ubcf4\uc11d \ubaa8\uc73c\uae30\ub098 \uc801 \ucc98\uce58\uc640 \uac19\uc774 \uc5f0\uc18d\uc801\uc778 \ud589\ub3d9\uc744 \uc2e4\uc218 \uc5c6\uc774 \uc218\ud589\ud55c \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ubcf4\uc0c1\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ube59\ubd09' \ub808\ubca8\uc5d0\uc11c \ubcf4\uc11d \uc218\uc9d1\uc744 \uc5f0\uc18d\uc801\uc73c\ub85c \ud560 \uacbd\uc6b0 \uc810\uc218\uac00 \ub450 \ubc30\ub85c \uc99d\uac00\ud569\ub2c8\ub2e4. STEP1: \uafb8\uc900\ud55c \ub9ac\ub4ec \uc720\uc9c0\ub97c \uc704\ud574 \uc9d1\uc911\ud569\ub2c8\ub2e4. STEP2: \ucf64\ubcf4\ub97c \uae68\ub294 \uc704\ud5d8\uc744 \ud53c\ud558\uc138\uc694. STEP3: \ubaa8\uba58\ud140\uc744 \uc720\uc9c0\ud558\uae30 \uc704\ud574 \uc18d\ub3c4 \ubd80\uc2a4\ud130\uc640 \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. [\uc124\uc815 \ube44\uad50\ud45c: \uc9e7\uc740 \ucf64\ubcf4\ub294 \uc791\uc740 \ubcf4\ub108\uc2a4\ub97c \uc81c\uacf5\ud558\uace0, \uae34 \uc5f0\uc18d\uc740 \uae30\ud558\uae09\uc218\uc801\uc778 \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.]"}, {"question": "\ub808\ubca8\uc5c5 \ubcfc\uc988\uc758 \ubb3c\ub9ac \uc5d4\uc9c4\uc740 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\uba70, \uc5b4\ub5a4 \uc810\uc5d0 \uc720\uc758\ud574\uc57c \ud558\ub098\uc694?", "answer": "\ub808\ubca8\uc5c5 \ubcfc\uc988\uc758 \ubb3c\ub9ac \uc5d4\uc9c4\uc740 \uc6b4\ub3d9\ub7c9\uacfc \ub9c8\ucc30\uc744 \ud3ec\ud568\ud55c \ud604\uc2e4\uc801\uc778 \uacf5 \uc6c0\uc9c1\uc784\uc744 \uc2dc\ubbac\ub808\uc774\uc158\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc5bc\uc74c\ubd09\uc6b0\ub9ac' \ub808\ubca8\uacfc \uac19\uc740 \uc5bc\uc74c \ud45c\uba74\uc5d0\uc11c \uacf5\uc740 \ub354 \ub9ce\uc774 \ubbf8\ub044\ub7ec\uc838 \uc81c\uc5b4\uac00 \uc5b4\ub824\uc6cc\uc9d1\ub2c8\ub2e4. STEP1: \uc6b4\ub3d9\ub7c9\uc744 \uace0\ub824\ud558\uc5ec \uc6c0\uc9c1\uc784\uc744 \uc870\uc808\ud558\uc138\uc694. STEP2: \uacbd\uc0ac\uba74\uc744 \uc774\uc6a9\ud558\uc5ec \uc18d\ub3c4\ub97c \ub192\uc774\ub294 \ub4f1 \ud658\uacbd\uc744 \ud65c\uc6a9\ud558\uc138\uc694. STEP3: \ub2e4\uc591\ud55c \uc9c0\ud615\uc5d0\uc11c \uc5f0\uc2b5\ud558\uc5ec \ubb3c\ub9ac \ud604\uc0c1\uc774 \uc5b4\ub5bb\uac8c \ubcc0\ud558\ub294\uc9c0 \uc774\ud574\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uacf5\uc744 \ud558\ud0a4 \ud37d\uc73c\ub85c \uc0dd\uac01\ud558\uc138\uc694. \uc5bc\uc74c \uc704\uc640 \uc794\ub514 \uc704\uc5d0\uc11c\uc758 \ud589\ub3d9\uc740 \ub2e4\ub985\ub2c8\ub2e4.]"}, {"question": "\ub808\ubca8\uc5c5 \ubcfc\uc988\uc758 \uc228\uaca8\uc9c4 \uc131\ucde8\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud574\uc81c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub808\ubca8\uc5c5 \ubcfc\uc988\uc5d0\ub294 \ud53c\ud574\ub97c \uc785\uc9c0 \uc54a\uace0 \ub808\ubca8\uc744 \uc644\ub8cc\ud574\uc57c \ud558\ub294 '\uc720\ub839 \ub7ec\ub108'\uc640 \uac19\uc740 \uc228\uaca8\uc9c4 \uc131\ucde8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uadf8\ub9bc\uc790 \ubbf8\ub85c' \ub808\ubca8\uc5d0\uc11c\ub294 \ubaa8\ub4e0 \ud568\uc815\uacfc \uc801\uc744 \ud53c\ud574\uc57c \ud569\ub2c8\ub2e4. STEP1: \ub808\ubca8 \ub808\uc774\uc544\uc6c3\uc744 \uc5f0\uad6c\ud558\uc5ec \uc704\ud5d8 \uc694\uc18c\ub97c \ud30c\uc545\ud569\ub2c8\ub2e4. STEP2: \ubc29\ud328\uc640 \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc704\ud5d8\uc744 \uc644\ud654\ud569\ub2c8\ub2e4. STEP3: \uc644\ubcbd\ud558\uac8c \ud0d0\uc0c9\ud560 \uc218 \uc788\uc744 \ub54c\uae4c\uc9c0 \uc5f0\uc2b5\ud569\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc194\ub8e8\uc158 \ube44\uad50: \uc77c\ubd80 \uc131\ucde8\ub294 \uc18d\ub3c4\uac00 \ud544\uc694\ud558\uace0, \ub2e4\ub978 \uc131\ucde8\ub294 \uc815\ud655\uc131\uc5d0 \ucd08\uc810\uc744 \ub9de\ucda5\ub2c8\ub2e4.]"}, {"question": "\ud50c\ub7ab\ud3fc \uac04\uc5d0 \ub808\ubca8\uc5c5 \ubcfc\uc988\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694? \ud50c\ub7ab\ud3fc \uac04 \ud50c\ub808\uc774\ub294 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "\ub124, \ub808\ubca8\uc5c5 \ubcfc\uc988\ub294 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ud1b5\ud574 \ud50c\ub7ab\ud3fc \uac04 \uc9c4\ud589 \uc0c1\ud669 \uc804\uc1a1\uc744 \uc9c0\uc6d0\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ucf58\uc194\ub85c \uc804\ud658\ud558\ub294 \uacbd\uc6b0 \uc800\uc7a5 \ub370\uc774\ud130\uac00 \uc790\ub3d9\uc73c\ub85c \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. STEP1: \ub450 \ud50c\ub7ab\ud3fc \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. STEP2: \uac8c\uc784 \uc124\uc815\uc5d0\uc11c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4. STEP3: \uc9c4\ud589 \uc0c1\ud669\uc774 \uc62c\ubc14\ub974\uac8c \uc804\uc1a1\ub418\uc5c8\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc740 PC, \ucf58\uc194 \ubc0f \ubaa8\ubc14\uc77c\uc5d0\uc11c \uc0ac\uc6a9 \uac00\ub2a5\ud558\uc9c0\ub9cc \ud65c\uc131 \uc778\ud130\ub137 \uc5f0\uacb0\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.]"}, {"question": "\ub808\ubca8\uc5c5 \ubcfc\uc988\uc758 \ube44\ubc00 \ub808\ubca8\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \uc561\uc138\uc2a4\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub808\ubca8\uc5c5 \ubcfc\uc988\uc5d0\ub294 \uc8fc \ub808\ubca8\uc5d0\uc11c \ubaa8\ub4e0 \uc228\uaca8\uc9c4 \uc5f4\uc1e0\ub97c \ubaa8\uc544 \ud574\uc81c\ud558\ub294 '\uc601\uc6d0\ud55c \uc2ec\uc5f0'\uacfc \uac19\uc740 \ube44\ubc00 \ub808\ubca8\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uace0\ub300 \uc720\uc801' \ub808\ubca8\uc5d0\uc11c \ubd80\uc11c\uc9c0\ub294 \ubcbd \ub4a4\uc5d0 \uc5f4\uc1e0\uac00 \uc228\uaca8\uc838 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \ubaa8\ub4e0 \ub808\ubca8\uc744 \ucca0\uc800\ud558\uac8c \ud0d0\ud5d8\ud558\uc5ec \uc228\uaca8\uc9c4 \uc5f4\uc1e0\ub97c \ucc3e\uc2b5\ub2c8\ub2e4. STEP2: \uc228\uaca8\uc9c4 \uacbd\ub85c\ub97c \ucc3e\ub294 X\ub808\uc774 \ube44\uc804\uacfc \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. STEP3: \ubaa8\ub4e0 \uc5f4\uc1e0\uac00 \uc218\uc9d1\ub418\uba74 \ube44\ubc00 \ub808\ubca8\uc774 \uc9c0\ub3c4\uc5d0 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc5f4\uc1e0\ub97c \ubcf4\ubb3c\uc9c0\ub3c4 \uc870\uac01\uc73c\ub85c \uc0dd\uac01\ud558\uc138\uc694. \ubaa8\ub4e0 \uc870\uac01\uc774 \ubc1c\uacac\ub420 \ub54c\ub9cc \uacbd\ub85c\uac00 \ub4dc\ub7ec\ub0a9\ub2c8\ub2e4.]"}]
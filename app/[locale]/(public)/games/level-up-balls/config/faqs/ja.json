[{"question": "Level Up Balls\u3067\u30dc\u30fc\u30eb\u3092\u3069\u306e\u3088\u3046\u306b\u64cd\u4f5c\u3057\u3001\u57fa\u672c\u7684\u306a\u52d5\u304d\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Level Up Balls\u3067\u30dc\u30fc\u30eb\u3092\u64cd\u4f5c\u3059\u308b\u306b\u306f\u3001\u65b9\u5411\u30d1\u30c3\u30c9\u307e\u305f\u306f\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u3092\u4f7f\u7528\u3057\u3066\u3001\u5de6\u3001\u53f3\u3001\u524d\u3001\u5f8c\u308d\u306b\u79fb\u52d5\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u969c\u5bb3\u7269\u3092\u56de\u907f\u3059\u308b\u305f\u3081\u306b\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u3092\u308f\u305a\u304b\u306b\u50be\u3051\u3066\u8ff7\u8def\u3092\u9032\u3080\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30b8\u30e3\u30f3\u30d7\u30dc\u30bf\u30f3\u3092\u62bc\u3059\u3068\u3001\u30dc\u30fc\u30eb\u304c\u9699\u9593\u3092\u98db\u3073\u8d8a\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u624b\u98061\uff1a\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u3092\u8efd\u304f\u50be\u3051\u3066\u79fb\u52d5\u3057\u307e\u3059\u3002\u624b\u98062\uff1a\u9069\u5207\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u30b8\u30e3\u30f3\u30d7\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u307e\u3059\u3002\u624b\u98063\uff1a\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30ec\u30d9\u30eb\u3067\u7df4\u7fd2\u3057\u3066\u3001\u64cd\u4f5c\u611f\u3092\u3064\u304b\u307f\u307e\u3057\u3087\u3046\u3002[\u4f8b\u3048\uff1a\u30dc\u30fc\u30eb\u306f\u3001\u30ab\u30fc\u30d6\u3057\u305f\u9053\u3092\u9032\u3080\u8eca\u3060\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u6b63\u78ba\u306a\u64cd\u4f5c\u304c\u9375\u3067\u3059\u3002]"}, {"question": "Level Up Balls\u3067\u30dc\u30fc\u30eb\u304c\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u304b\u3089\u843d\u3061\u7d9a\u3051\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u307e\u305f\u3001\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u305d\u308c\u3092\u9632\u3050\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u304b\u3089\u843d\u3061\u308b\u3053\u3068\u306f\u3001\u904e\u5270\u306a\u64cd\u4f5c\u3084\u30b8\u30e3\u30f3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u30df\u30b9\u306b\u3088\u308b\u3053\u3068\u304c\u3088\u304f\u3042\u308a\u307e\u3059\u3002Level Up Balls\u3067\u306f\u3001\u5404\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306f\u72ec\u81ea\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30b9\u30ab\u30a4\u30cf\u30a4\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u72ed\u3044\u6a4b\u304c\u3042\u308a\u307e\u3059\u3002\u843d\u4e0b\u3092\u9632\u3050\u305f\u3081\u306b\u3001\u624b\u98061\uff1a\u52d5\u304d\u3092\u9045\u304f\u3057\u3001\u6025\u306a\u50be\u304d\u3092\u907f\u3051\u3066\u304f\u3060\u3055\u3044\u3002\u624b\u98062\uff1a\u30ab\u30e1\u30e9\u30a2\u30f3\u30b0\u30eb\u3092\u4f7f\u7528\u3057\u3066\u3001\u8ddd\u96e2\u3092\u3088\u308a\u3088\u304f\u5224\u65ad\u3057\u307e\u3059\u3002\u624b\u98063\uff1a\u307e\u305a\u3001\u5c0f\u3055\u306a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u4e0a\u3067\u30b8\u30e3\u30f3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u7df4\u7fd2\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u5bfe\u5fdc\u8868\uff1a\u72ed\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u306f\u3001\u52d5\u304d\u3092\u9045\u304f\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4e00\u65b9\u3001\u5e83\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u306f\u3001\u3088\u308a\u901f\u304f\u79fb\u52d5\u3067\u304d\u307e\u3059\u3002]"}, {"question": "Level Up Balls\u306e\u5f37\u5316\u30a2\u30a4\u30c6\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u308c\u3089\u306f\u3069\u306e\u3088\u3046\u306b\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5f37\u5316\u3057\u307e\u3059\u304b\uff1f", "answer": "Level Up Balls\u306b\u306f\u3001\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\uff08\u4e00\u6642\u7684\u306b\u30dc\u30fc\u30eb\u306e\u901f\u5ea6\u3092\u9ad8\u3081\u308b\uff09\u3084\u30b7\u30fc\u30eb\u30c9\uff08\u4e00\u5b9a\u6642\u9593\u3001\u5371\u967a\u304b\u3089\u4fdd\u8b77\u3059\u308b\uff09\u306a\u3069\u3001\u3044\u304f\u3064\u304b\u306e\u5f37\u5316\u30a2\u30a4\u30c6\u30e0\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30af\u30ea\u30b9\u30bf\u30eb\u6d1e\u7a9f\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u304c\u8ee2\u304c\u308b\u5ca9\u3092\u8ffd\u3044\u629c\u304f\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u624b\u98061\uff1a\u30de\u30c3\u30d7\u4e0a\u306e\u5149\u3063\u3066\u3044\u308b\u30a2\u30a4\u30b3\u30f3\u3092\u63a2\u3057\u307e\u3059\u3002\u624b\u98062\uff1a\u305d\u308c\u3089\u306e\u4e0a\u306b\u79fb\u52d5\u3057\u3066\u30a2\u30af\u30c6\u30a3\u30d6\u306b\u3057\u307e\u3059\u3002\u624b\u98063\uff1a\u30b7\u30fc\u30eb\u30c9\u306e\u3088\u3046\u306a\u5f37\u5316\u30a2\u30a4\u30c6\u30e0\u3092\u983b\u7e41\u306b\u5371\u967a\u304c\u3042\u308b\u30bb\u30af\u30b7\u30e7\u30f3\u306e\u305f\u3081\u306b\u6226\u7565\u7684\u306b\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u6bd4\u8f03\uff1a\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u306f\u30bf\u30a4\u30e0\u30c8\u30e9\u30a4\u30a2\u30eb\u306b\u9069\u3057\u3066\u304a\u308a\u3001\u30b7\u30fc\u30eb\u30c9\u306f\u751f\u5b58\u91cd\u8996\u306e\u30ec\u30d9\u30eb\u306b\u9069\u3057\u3066\u3044\u307e\u3059\u3002]"}, {"question": "Level Up Balls\u3067\u30b9\u30b3\u30a2\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f\u307e\u305f\u3001\u3069\u306e\u3088\u3046\u306a\u6226\u7565\u3092\u4f7f\u7528\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Level Up Balls\u3067\u30b9\u30b3\u30a2\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u3059\u3079\u3066\u306e\u5b9d\u77f3\u3092\u96c6\u3081\u3001\u3067\u304d\u308b\u3060\u3051\u65e9\u304f\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u300c\u30b4\u30fc\u30eb\u30c7\u30f3\u30fb\u30b0\u30ed\u30fc\u30d6\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u96a0\u3055\u308c\u305f\u5b9d\u77f3\u306e\u584a\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u3067\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u624b\u98061\uff1a\u30de\u30c3\u30d7\u4e0a\u306e\u3042\u3089\u3086\u308b\u30b3\u30fc\u30ca\u30fc\u3092\u63a2\u7d22\u3057\u3066\u3001\u96a0\u3055\u308c\u305f\u30a2\u30a4\u30c6\u30e0\u3092\u63a2\u3057\u307e\u3059\u3002\u624b\u98062\uff1a\u78c1\u77f3\u306a\u3069\u306e\u5f37\u5316\u30a2\u30a4\u30c6\u30e0\u3092\u4f7f\u7528\u3057\u3066\u3001\u9060\u304f\u306e\u5b9d\u77f3\u3092\u5f15\u304d\u5bc4\u305b\u307e\u3059\u3002\u624b\u98063\uff1a\u30b9\u30d4\u30fc\u30c9\u30e9\u30f3\u30cb\u30f3\u30b0\u306e\u7df4\u7fd2\u3067\u30af\u30ea\u30a2\u6642\u9593\u3092\u77ed\u7e2e\u3057\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u63a2\u3059\u2192\u96c6\u3081\u308b\u2192\u30b9\u30d4\u30fc\u30c9\u30e9\u30f3\u2192\u7e70\u308a\u8fd4\u3059\u3002]"}, {"question": "Level Up Balls\u306e\u30ec\u30d9\u30eb\u306e\u4e2d\u306b\u306f\u3001\u4ed6\u306e\u30ec\u30d9\u30eb\u3088\u308a\u3082\u96e3\u3057\u3044\u30ec\u30d9\u30eb\u304c\u3042\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u306b\u3069\u3046\u5099\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Level Up Balls\u306e\u30ec\u30d9\u30eb\u96e3\u6613\u5ea6\u306f\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u8907\u96d1\u3055\u3001\u6575\u306e\u914d\u7f6e\u3001\u74b0\u5883\u306e\u5371\u967a\u306a\u3069\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u6eb6\u5ca9\u8ff7\u5bae\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u52d5\u304f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3084\u706b\u306e\u30c8\u30e9\u30c3\u30d7\u304c\u767b\u5834\u3057\u307e\u3059\u3002\u6e96\u5099\u3059\u308b\u305f\u3081\u306b\u3001\u30b9\u30c6\u30c3\u30d71\uff1a\u57fa\u672c\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u305f\u3081\u306b\u3001\u4ee5\u524d\u306e\u30ec\u30d9\u30eb\u3092\u7e70\u308a\u8fd4\u3057\u30d7\u30ec\u30a4\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d7\u30ec\u30d3\u30e5\u30fc\u753b\u9762\u3067\u30ec\u30d9\u30eb\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u8abf\u3079\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u8ffd\u52a0\u306e\u4fdd\u8b77\u306e\u305f\u3081\u306b\u30b7\u30fc\u30eb\u30c9\u306e\u3088\u3046\u306a\u5f37\u5316\u30a2\u30a4\u30c6\u30e0\u3092\u88c5\u5099\u3057\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u30de\u30e9\u30bd\u30f3\u7df4\u7fd2\u3068\u898b\u3066\u304f\u3060\u3055\u3044\u3002\u305d\u308c\u305e\u308c\u306e\u30ec\u30d9\u30eb\u306f\u3001\u3042\u306a\u305f\u306e\u30b9\u30ad\u30eb\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002]"}, {"question": "Level Up Balls\u306e\u30b3\u30f3\u30dc\u30b7\u30b9\u30c6\u30e0\u306e\u610f\u5473\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "Level Up Balls\u306e\u30b3\u30f3\u30dc\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u5b9d\u77f3\u306e\u53ce\u96c6\u3084\u6575\u306e\u8fc5\u901f\u306a\u6483\u7834\u306a\u3069\u3001\u9023\u7d9a\u3057\u305f\u30df\u30b9\u306a\u3057\u306e\u884c\u52d5\u3092\u8912\u3081\u3066\u304f\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30a2\u30a4\u30b9\u30b9\u30d1\u30a4\u30e4\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u5b9d\u77f3\u306e\u53ce\u96c6\u3092\u9023\u9396\u3055\u305b\u308b\u3053\u3068\u3067\u3001\u30b9\u30b3\u30a2\u304c\u500d\u5897\u3057\u307e\u3059\u3002\u624b\u98061\uff1a\u5b89\u5b9a\u3057\u305f\u30ea\u30ba\u30e0\u3092\u7dad\u6301\u3059\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u307e\u3059\u3002\u624b\u98062\uff1a\u30b3\u30f3\u30dc\u3092\u4e2d\u65ad\u3055\u305b\u308b\u5371\u967a\u3092\u907f\u3051\u307e\u3059\u3002\u624b\u98063\uff1a\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u306a\u3069\u306e\u5f37\u5316\u30a2\u30a4\u30c6\u30e0\u3092\u4f7f\u7528\u3057\u3066\u52e2\u3044\u3092\u7dad\u6301\u3057\u307e\u3059\u3002[\u5bfe\u5fdc\u8868\uff1a\u77ed\u3044\u30b3\u30f3\u30dc\u306f\u5c0f\u3055\u306a\u30dc\u30fc\u30ca\u30b9\u3092\u4e0e\u3048\u307e\u3059\u304c\u3001\u9577\u3044\u9023\u9396\u306f\u6307\u6570\u95a2\u6570\u7684\u306a\u5831\u916c\u3092\u4e0e\u3048\u307e\u3059\u3002]"}, {"question": "Level Up Balls\u306e\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u306f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f\u307e\u305f\u3001\u4f55\u306b\u6ce8\u610f\u3059\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "Level Up Balls\u306e\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u306f\u3001\u904b\u52d5\u91cf\u3084\u6469\u64e6\u306a\u3069\u3001\u73fe\u5b9f\u7684\u306a\u30dc\u30fc\u30eb\u306e\u52d5\u304d\u3092\u30b7\u30df\u30e5\u30ec\u30fc\u30c8\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u971c\u5cf0\u300d\u30ec\u30d9\u30eb\u306e\u3088\u3046\u306a\u6c37\u306e\u8868\u9762\u3067\u306f\u3001\u30dc\u30fc\u30eb\u304c\u3088\u308a\u6ed1\u308a\u3084\u3059\u304f\u306a\u308a\u3001\u64cd\u4f5c\u304c\u96e3\u3057\u304f\u306a\u308a\u307e\u3059\u3002\u624b\u98061\uff1a\u904b\u52d5\u91cf\u3092\u8003\u616e\u3057\u3066\u3001\u52d5\u304d\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u624b\u98062\uff1a\u659c\u9762\u3092\u4f7f\u3063\u3066\u901f\u5ea6\u3092\u5f97\u308b\u306a\u3069\u3001\u74b0\u5883\u3092\u3042\u306a\u305f\u306e\u6709\u5229\u306b\u5229\u7528\u3057\u307e\u3059\u3002\u624b\u98063\uff1a\u3055\u307e\u3056\u307e\u306a\u5730\u5f62\u3092\u7df4\u7fd2\u3057\u3066\u3001\u7269\u7406\u7684\u306a\u5909\u5316\u3092\u7406\u89e3\u3057\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u30dc\u30fc\u30eb\u3092\u30db\u30c3\u30b1\u30fc\u306e\u6c37\u4e0a\u3092\u6ed1\u308b\u30d1\u30c3\u30af\u3060\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u829d\u751f\u4e0a\u3068\u9055\u3063\u3066\u632f\u308b\u821e\u3044\u307e\u3059\u3002]"}, {"question": "Level Up Balls\u306e\u96a0\u3055\u308c\u305f\u5b9f\u7e3e\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u3092\u3069\u306e\u3088\u3046\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Level Up Balls\u306b\u306f\u3001\u300c\u30b4\u30fc\u30b9\u30c8\u30e9\u30f3\u30ca\u30fc\u300d\u306e\u3088\u3046\u306a\u96a0\u3055\u308c\u305f\u5b9f\u7e3e\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u30c0\u30e1\u30fc\u30b8\u3092\u53d7\u3051\u305a\u306b\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u5b9f\u7e3e\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u5f71\u306e\u8ff7\u5bae\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u3059\u3079\u3066\u306e\u7f60\u3084\u6575\u3092\u907f\u3051\u306a\u3051\u308c\u3070\u306a\u308a\u307e\u305b\u3093\u3002\u624b\u98061\uff1a\u30ec\u30d9\u30eb\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u8abf\u3079\u3066\u3001\u5371\u967a\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002\u624b\u98062\uff1a\u30b7\u30fc\u30eb\u30c9\u306a\u3069\u306e\u5f37\u5316\u30a2\u30a4\u30c6\u30e0\u3092\u4f7f\u7528\u3057\u3066\u3001\u30ea\u30b9\u30af\u3092\u8efd\u6e1b\u3057\u307e\u3059\u3002\u624b\u98063\uff1a\u5b8c\u74a7\u306b\u30ca\u30d3\u30b2\u30fc\u30c8\u3067\u304d\u308b\u307e\u3067\u7df4\u7fd2\u3057\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u4e00\u90e8\u306e\u5b9f\u7e3e\u306f\u30b9\u30d4\u30fc\u30c9\u304c\u5fc5\u8981\u3067\u3001\u4ed6\u306e\u5b9f\u7e3e\u306f\u6b63\u78ba\u3055\u304c\u5fc5\u8981\u3067\u3059\u3002]"}, {"question": "Level Up Balls\u306e\u9032\u884c\u72b6\u6cc1\u3092\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30d7\u30ec\u30a4\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001Level Up Balls\u306f\u30af\u30e9\u30a6\u30c9\u30bb\u30fc\u30d6\u3092\u4f7f\u7528\u3057\u3066\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u306e\u9032\u884c\u72b6\u6cc1\u8ee2\u9001\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001PC\u304b\u3089\u30b3\u30f3\u30bd\u30fc\u30eb\u306b\u5207\u308a\u66ff\u3048\u3066\u3082\u3001\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u306f\u81ea\u52d5\u7684\u306b\u540c\u671f\u3055\u308c\u307e\u3059\u3002\u624b\u98061\uff1a\u4e21\u65b9\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u624b\u98062\uff1a\u30b2\u30fc\u30e0\u8a2d\u5b9a\u3067\u30af\u30e9\u30a6\u30c9\u30bb\u30fc\u30d6\u3092\u6709\u52b9\u306b\u3057\u307e\u3059\u3002\u624b\u98063\uff1a\u9032\u884c\u72b6\u6cc1\u304c\u6b63\u3057\u304f\u8ee2\u9001\u3055\u308c\u305f\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002[\u5bfe\u5fdc\u8868\uff1a\u30af\u30e9\u30a6\u30c9\u30bb\u30fc\u30d6\u306fPC\u3001\u30b3\u30f3\u30bd\u30fc\u30eb\u3001\u30e2\u30d0\u30a4\u30eb\u3067\u5229\u7528\u3067\u304d\u307e\u3059\u304c\u3001\u30a4\u30f3\u30bf\u30fc\u30cd\u30c3\u30c8\u63a5\u7d9a\u304c\u5fc5\u8981\u3067\u3059\u3002]"}, {"question": "Level Up Balls\u306e\u79d8\u5bc6\u30ec\u30d9\u30eb\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u306b\u3069\u306e\u3088\u3046\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Level Up Balls\u306b\u306f\u3001\u4e3b\u8981\u306a\u30ec\u30d9\u30eb\u306b\u3042\u308b\u3059\u3079\u3066\u306e\u96a0\u3057\u30ad\u30fc\u3092\u96c6\u3081\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u308b\u300c\u6c38\u9060\u306e\u6df1\u6df5\u300d\u306e\u3088\u3046\u306a\u79d8\u5bc6\u30ec\u30d9\u30eb\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u53e4\u4ee3\u907a\u8de1\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u58ca\u305b\u308b\u58c1\u306e\u80cc\u5f8c\u306b\u30ad\u30fc\u304c\u96a0\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u624b\u98061\uff1a\u3059\u3079\u3066\u306e\u30ec\u30d9\u30eb\u3092\u5fb9\u5e95\u7684\u306b\u8abf\u3079\u3001\u96a0\u3057\u30ad\u30fc\u3092\u63a2\u3057\u307e\u3059\u3002\u624b\u98062\uff1aX\u7dda\u30d3\u30b8\u30e7\u30f3\u306a\u3069\u306e\u5f37\u5316\u30a2\u30a4\u30c6\u30e0\u3092\u4f7f\u7528\u3057\u3066\u3001\u96a0\u3057\u30d1\u30b9\u3092\u63a2\u3057\u307e\u3059\u3002\u624b\u98063\uff1a\u3059\u3079\u3066\u306e\u30ad\u30fc\u3092\u96c6\u3081\u308b\u3068\u3001\u79d8\u5bc6\u306e\u30ec\u30d9\u30eb\u304c\u30de\u30c3\u30d7\u4e0a\u306b\u8868\u793a\u3055\u308c\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u30ad\u30fc\u306f\u5b9d\u5730\u56f3\u306e\u4e00\u90e8\u3060\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u3059\u3079\u3066\u304c\u898b\u3064\u304b\u308b\u307e\u3067\u3001\u9053\u306f\u660e\u3089\u304b\u306b\u306a\u308a\u307e\u305b\u3093\u3002]"}]
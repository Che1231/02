[{"question": "\u5982\u4f55\u63a7\u5236 Level Up Balls \u4e2d\u7684\u7403\uff0c\u4ee5\u53ca\u57fa\u672c\u7684\u79fb\u52d5\u65b9\u5f0f\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728 Level Up Balls \u4e2d\uff0c\u63a7\u5236\u7403\u7684\u65b9\u6cd5\u662f\u4f7f\u7528\u65b9\u5411\u9375\u6216\u6416\u687f\u4f86\u79fb\u52d5\u7403\u7684\u5de6\u53f3\u3001\u524d\u5f8c\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u95dc\u4e2d\uff0c\u60a8\u9700\u8981\u901a\u904e\u8ff7\u5bae\uff0c\u53ea\u9700\u8f15\u5fae\u50be\u659c\u6416\u687f\u5373\u53ef\u907f\u958b\u969c\u7919\u7269\u3002\u6b64\u5916\uff0c\u6309\u4e0b\u8df3\u8e8d\u6309\u9215\u53ef\u4ee5\u8b93\u7403\u8df3\u904e\u9593\u9699\u3002\u6b65\u9a5f1\uff1a\u8f15\u8f15\u50be\u659c\u6416\u687f\u79fb\u52d5\u3002\u6b65\u9a5f2\uff1a\u5728\u9069\u7576\u7684\u6642\u6a5f\u6309\u4e0b\u8df3\u8e8d\u6309\u9215\u3002\u6b65\u9a5f3\uff1a\u5728\u6559\u5b78\u95dc\u5361\u7df4\u7fd2\uff0c\u4ee5\u4e86\u89e3\u64cd\u63a7\u65b9\u5f0f\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u7403\u60f3\u50cf\u6210\u5728\u873f\u8712\u9053\u8def\u4e0a\u884c\u99db\u7684\u6c7d\u8eca\uff1b\u7cbe\u6e96\u5ea6\u81f3\u95dc\u91cd\u8981\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u7684\u7403\u6703\u4e0d\u65b7\u5f9e Level Up Balls \u4e2d\u7684\u5e73\u53f0\u4e0a\u6389\u4e0b\u4f86\uff0c\u4ee5\u53ca\u5982\u4f55\u9810\u9632\uff1f", "answer": "\u6389\u843d\u5e73\u53f0\u7684\u60c5\u6cc1\u901a\u5e38\u662f\u56e0\u70ba\u904e\u5ea6\u64cd\u7e31\u6216\u8df3\u8e8d\u5224\u65b7\u5931\u8aa4\u3002\u5728 Level Up Balls \u4e2d\uff0c\u6bcf\u500b\u5e73\u53f0\u90fd\u6709\u7368\u7279\u7684\u4f48\u5c40\uff0c\u4f8b\u5982\u300c\u7a7a\u4e2d\u9ad8\u8073\u300d\u95dc\u5361\u4e2d\u7684\u72f9\u7a84\u6a4b\u6a11\u3002\u70ba\u907f\u514d\u6389\u843d\uff0c\u6b65\u9a5f1\uff1a\u653e\u6162\u52d5\u4f5c\uff0c\u907f\u514d\u7a81\u7136\u50be\u659c\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u76f8\u6a5f\u89d2\u5ea6\uff0c\u66f4\u597d\u5730\u6e2c\u91cf\u8ddd\u96e2\u3002\u6b65\u9a5f3\uff1a\u5148\u5728\u8f03\u5c0f\u7684\u5e73\u53f0\u4e0a\u7df4\u7fd2\u8df3\u8e8d\u7684\u6642\u6a5f\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u72f9\u7a84\u7684\u5e73\u53f0\u9700\u8981\u8f03\u6162\u7684\u52d5\u4f5c\uff0c\u800c\u8f03\u5bec\u7684\u5e73\u53f0\u5247\u5141\u8a31\u8f03\u5feb\u7684\u79fb\u52d5\u3002]"}, {"question": "Level Up Balls \u4e2d\u6709\u54ea\u4e9b\u52a0\u5f37\u904a\u6232\u9ad4\u9a57\u7684\u9053\u5177\uff0c\u4ee5\u53ca\u5b83\u5011\u5982\u4f55\u63d0\u5347\u904a\u6232\u6027\uff1f", "answer": "Level Up Balls \u4e2d\u6709\u5e7e\u500b\u9053\u5177\uff0c\u4f8b\u5982\u52a0\u901f\u63d0\u5347\uff0c\u66ab\u6642\u63d0\u5347\u7403\u7684\u901f\u5ea6\uff0c\u4ee5\u53ca\u76fe\u724c\uff0c\u5728\u4e00\u6bb5\u6642\u9593\u5167\u4fdd\u8b77\u60a8\u514d\u53d7\u5371\u96aa\u3002\u4f8b\u5982\uff0c\u5728\u300c\u6c34\u6676\u6d1e\u7a74\u300d\u95dc\u5361\u4e2d\uff0c\u52a0\u901f\u63d0\u5347\u6709\u52a9\u65bc\u60a8\u8d85\u8d8a\u6efe\u52d5\u7684\u5de8\u77f3\u3002\u6b65\u9a5f1\uff1a\u5728\u5730\u5716\u4e0a\u5c0b\u627e\u767c\u5149\u7684\u5716\u793a\u3002\u6b65\u9a5f2\uff1a\u6efe\u904e\u5b83\u5011\u4ee5\u555f\u52d5\u3002\u6b65\u9a5f3\uff1a\u50cf\u5c07\u76fe\u724c\u5132\u5b58\u65bc\u5371\u96aa\u983b\u7e41\u51fa\u73fe\u7684\u5340\u57df\uff0c\u7b56\u7565\u6027\u5730\u4f7f\u7528\u5b83\u5011\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u52a0\u901f\u63d0\u5347\u9069\u5408\u6642\u9593\u8a66\u7149\uff0c\u800c\u76fe\u724c\u5247\u66f4\u9069\u5408\u4ee5\u751f\u5b58\u70ba\u91cd\u9ede\u7684\u95dc\u5361\u3002]"}, {"question": "\u5982\u4f55\u5728 Level Up Balls \u4e2d\u6700\u4f73\u5316\u6211\u7684\u5f97\u5206\uff0c\u4ee5\u53ca\u61c9\u8a72\u4f7f\u7528\u54ea\u4e9b\u7b56\u7565\uff1f", "answer": "\u70ba\u4e86\u6700\u4f73\u5316 Level Up Balls \u4e2d\u7684\u5f97\u5206\uff0c\u91cd\u9ede\u662f\u6536\u96c6\u6240\u6709\u5bf6\u77f3\u4e26\u76e1\u5feb\u5b8c\u6210\u95dc\u5361\u3002\u4f8b\u5982\uff0c\u5728\u300c\u9ec3\u91d1\u6797\u5730\u300d\u95dc\u5361\u4e2d\uff0c\u60a8\u53ef\u4ee5\u5728\u767c\u73fe\u96b1\u85cf\u7684\u5bf6\u77f3\u7fa4\u6642\u7372\u5f97\u984d\u5916\u5206\u6578\u3002\u6b65\u9a5f1\uff1a\u4ed4\u7d30\u63a2\u7d22\u5730\u5716\u7684\u6bcf\u500b\u89d2\u843d\uff0c\u5c0b\u627e\u96b1\u85cf\u7269\u54c1\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u78c1\u529b\u9053\u5177\u5438\u5f15\u9060\u8655\u7684\u5bf6\u77f3\u3002\u6b65\u9a5f3\uff1a\u7df4\u7fd2\u5feb\u901f\u901a\u95dc\u4ee5\u7e2e\u77ed\u5b8c\u6210\u6642\u9593\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u63a2\u7d22\u2192\u6536\u96c6\u2192\u5feb\u901f\u901a\u95dc\u2192\u91cd\u8907\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc Level Up Balls \u4e2d\u6709\u4e9b\u95dc\u5361\u6bd4\u5176\u4ed6\u95dc\u5361\u66f4\u96e3\uff0c\u4ee5\u53ca\u5982\u4f55\u70ba\u5b83\u5011\u505a\u597d\u6e96\u5099\uff1f", "answer": "Level Up Balls \u95dc\u5361\u7684\u96e3\u5ea6\u56e0\u5e73\u53f0\u8907\u96dc\u6027\u3001\u6575\u4eba\u4f4d\u7f6e\u548c\u74b0\u5883\u5371\u96aa\u800c\u7570\u3002\u4f8b\u5982\uff0c\u300c\u7194\u5ca9\u8ff7\u5bae\u300d\u95dc\u5361\u5f15\u5165\u4e86\u79fb\u52d5\u5e73\u53f0\u548c\u706b\u9677\u9631\u3002\u70ba\u505a\u597d\u6e96\u5099\uff0c\u6b65\u9a5f1\uff1a\u91cd\u73a9\u4e4b\u524d\u7684\u95dc\u5361\uff0c\u4ee5\u638c\u63e1\u57fa\u672c\u63a7\u5236\u3002\u6b65\u9a5f2\uff1a\u5728\u9810\u89bd\u756b\u9762\u4e2d\u4ed4\u7d30\u7814\u7a76\u95dc\u5361\u4f48\u5c40\u3002\u6b65\u9a5f3\uff1a\u88dd\u5099\u76fe\u724c\u7b49\u9053\u5177\u4ee5\u589e\u52a0\u4fdd\u8b77\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u628a\u5b83\u60f3\u50cf\u6210\u99ac\u62c9\u677e\u8a13\u7df4\uff1b\u6bcf\u4e00\u95dc\u90fd\u935b\u934a\u60a8\u7684\u6280\u80fd\u3002]"}, {"question": "Level Up Balls \u4e2d\u7684\u9023\u64ca\u7cfb\u7d71\u6709\u4ec0\u9ebc\u610f\u7fa9\uff0c\u4ee5\u53ca\u5b83\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "Level Up Balls \u4e2d\u7684\u9023\u64ca\u7cfb\u7d71\u734e\u52f5\u73a9\u5bb6\u5728\u9023\u7e8c\u884c\u52d5\u904e\u7a0b\u4e2d\u6c92\u6709\u932f\u8aa4\uff0c\u4f8b\u5982\u5feb\u901f\u9023\u7e8c\u6536\u96c6\u5bf6\u77f3\u6216\u64ca\u6557\u6575\u4eba\u3002\u4f8b\u5982\uff0c\u5728\u300c\u51b0\u5cf0\u300d\u95dc\u5361\u4e2d\uff0c\u9023\u7e8c\u6536\u96c6\u5bf6\u77f3\u53ef\u4ee5\u4f7f\u60a8\u7684\u5206\u6578\u7ffb\u500d\u3002\u6b65\u9a5f1\uff1a\u5c08\u6ce8\u65bc\u4fdd\u6301\u7a69\u5b9a\u7684\u7bc0\u594f\u3002\u6b65\u9a5f2\uff1a\u907f\u514d\u7834\u58de\u9023\u64ca\u7684\u5371\u96aa\u3002\u6b65\u9a5f3\uff1a\u4f7f\u7528\u52a0\u901f\u63d0\u5347\u7b49\u9053\u5177\u4f86\u4fdd\u6301\u52d5\u80fd\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u77ed\u9023\u64ca\u63d0\u4f9b\u5c0f\u984d\u734e\u52f5\uff0c\u800c\u9577\u9023\u64ca\u5247\u63d0\u4f9b\u6307\u6578\u7d1a\u7684\u734e\u52f5\u3002]"}, {"question": "Level Up Balls \u4e2d\u7684\u7269\u7406\u5f15\u64ce\u5982\u4f55\u5f71\u97ff\u904a\u6232\u6027\uff0c\u4ee5\u53ca\u9700\u8981\u6ce8\u610f\u4e9b\u4ec0\u9ebc\uff1f", "answer": "Level Up Balls \u4e2d\u7684\u7269\u7406\u5f15\u64ce\u6a21\u64ec\u73fe\u5be6\u7684\u7403\u9ad4\u79fb\u52d5\uff0c\u5305\u62ec\u52d5\u80fd\u548c\u6469\u64e6\u529b\u3002\u4f8b\u5982\uff0c\u5728\u300c\u7d50\u971c\u9ad8\u5cf0\u300d\u95dc\u5361\u4e2d\uff0c\u50cf\u51b0\u9762\u4e00\u6a23\u7684\u8868\u9762\uff0c\u60a8\u7684\u7403\u6703\u6ed1\u52d5\u66f4\u591a\uff0c\u4f7f\u63a7\u5236\u66f4\u56f0\u96e3\u3002\u6b65\u9a5f1\uff1a\u8abf\u6574\u60a8\u7684\u52d5\u4f5c\uff0c\u4ee5\u8003\u616e\u52d5\u80fd\u3002\u6b65\u9a5f2\uff1a\u5229\u7528\u74b0\u5883\u4f86\u63d0\u5347\uff0c\u4f8b\u5982\u4f7f\u7528\u659c\u5761\u4f86\u7372\u5f97\u901f\u5ea6\u3002\u6b65\u9a5f3\uff1a\u5728\u4e0d\u540c\u7684\u5730\u5f62\u4e0a\u7df4\u7fd2\u4ee5\u4e86\u89e3\u7269\u7406\u5982\u4f55\u8b8a\u5316\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u7403\u60f3\u50cf\u6210\u66f2\u68cd\u7403\uff1b\u5b83\u5728\u51b0\u4e0a\u548c\u8349\u5730\u4e0a\u6703\u8868\u73fe\u4e0d\u540c\u3002]"}, {"question": "Level Up Balls \u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u6210\u5c31\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9396\u5b83\u5011\uff1f", "answer": "Level Up Balls \u5305\u542b\u96b1\u85cf\u6210\u5c31\uff0c\u4f8b\u5982\u300c\u5e7d\u9748\u8dd1\u8005\u300d\uff0c\u9700\u8981\u5728\u4e0d\u53d7\u5230\u50b7\u5bb3\u7684\u60c5\u6cc1\u4e0b\u5b8c\u6210\u4e00\u500b\u95dc\u5361\u3002\u4f8b\u5982\uff0c\u5728\u300c\u9670\u5f71\u8ff7\u5bae\u300d\u95dc\u5361\u4e2d\uff0c\u60a8\u9700\u8981\u907f\u958b\u6240\u6709\u9677\u9631\u548c\u6575\u4eba\u3002\u6b65\u9a5f1\uff1a\u4ed4\u7d30\u7814\u7a76\u95dc\u5361\u4f48\u5c40\uff0c\u627e\u51fa\u5371\u96aa\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u76fe\u724c\u7b49\u9053\u5177\u4f86\u6e1b\u5c11\u98a8\u96aa\u3002\u6b65\u9a5f3\uff1a\u4e0d\u65b7\u7df4\u7fd2\uff0c\u76f4\u5230\u60a8\u80fd\u5920\u9806\u5229\u5b8c\u6210\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u67d0\u4e9b\u6210\u5c31\u9700\u8981\u901f\u5ea6\uff0c\u800c\u5176\u4ed6\u6210\u5c31\u5247\u5074\u91cd\u65bc\u7cbe\u78ba\u6027\u3002]"}, {"question": "\u6211\u53ef\u4ee5\u5c07\u6211\u7684 Level Up Balls \u9032\u5ea6\u5728\u4e0d\u540c\u5e73\u53f0\u9593\u8f49\u79fb\u55ce\uff1f\u8de8\u5e73\u53f0\u904a\u73a9\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u662f\u7684\uff0cLevel Up Balls \u652f\u63f4\u900f\u904e\u96f2\u7aef\u5132\u5b58\u4f86\u8de8\u5e73\u53f0\u8f49\u79fb\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9e\u96fb\u8166\u5207\u63db\u5230\u4e3b\u6a5f\uff0c\u60a8\u7684\u5132\u5b58\u8cc7\u6599\u6703\u81ea\u52d5\u540c\u6b65\u3002\u6b65\u9a5f1\uff1a\u78ba\u4fdd\u60a8\u5728\u5169\u500b\u5e73\u53f0\u4e0a\u90fd\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u3002\u6b65\u9a5f2\uff1a\u5728\u904a\u6232\u8a2d\u5b9a\u4e2d\u555f\u7528\u96f2\u7aef\u5132\u5b58\u3002\u6b65\u9a5f3\uff1a\u9a57\u8b49\u60a8\u7684\u9032\u5ea6\u5df2\u6b63\u78ba\u8f49\u79fb\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u96f2\u7aef\u5132\u5b58\u53ef\u5728\u96fb\u8166\u3001\u4e3b\u6a5f\u548c\u624b\u6a5f\u4e0a\u4f7f\u7528\uff0c\u4f46\u9700\u8981\u6d3b\u8e8d\u7684\u7db2\u8def\u9023\u7dda\u3002]"}, {"question": "Level Up Balls \u4e2d\u6709\u54ea\u4e9b\u79d8\u5bc6\u95dc\u5361\uff0c\u4ee5\u53ca\u5982\u4f55\u9032\u5165\uff1f", "answer": "Level Up Balls \u4e2d\u5305\u542b\u79d8\u5bc6\u95dc\u5361\uff0c\u4f8b\u5982\u300c\u6c38\u6046\u6df1\u6df5\u300d\uff0c\u5b83\u662f\u901a\u904e\u5728\u4e3b\u8981\u95dc\u5361\u4e2d\u6536\u96c6\u6240\u6709\u96b1\u85cf\u9470\u5319\u800c\u89e3\u9396\u7684\u3002\u4f8b\u5982\uff0c\u5728\u300c\u53e4\u4ee3\u907a\u5740\u300d\u95dc\u5361\u4e2d\uff0c\u9470\u5319\u96b1\u85cf\u5728\u53ef\u7834\u58de\u7684\u7246\u58c1\u5f8c\u9762\u3002\u6b65\u9a5f1\uff1a\u5fb9\u5e95\u63a2\u7d22\u6bcf\u500b\u95dc\u5361\u4ee5\u5c0b\u627e\u96b1\u85cf\u9470\u5319\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528 X \u5149\u8996\u7dda\u7b49\u9053\u5177\u4f86\u767c\u73fe\u96b1\u85cf\u7684\u8def\u7dda\u3002\u6b65\u9a5f3\uff1a\u6536\u96c6\u6240\u6709\u9470\u5319\u5f8c\uff0c\u79d8\u5bc6\u95dc\u5361\u6703\u51fa\u73fe\u5728\u5730\u5716\u4e0a\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u9470\u5319\u60f3\u50cf\u6210\u5bf6\u85cf\u5730\u5716\u788e\u7247\uff1b\u53ea\u6709\u7576\u6240\u6709\u788e\u7247\u90fd\u627e\u5230\u6642\uff0c\u8def\u5f91\u624d\u6703\u986f\u73fe\u3002]"}]
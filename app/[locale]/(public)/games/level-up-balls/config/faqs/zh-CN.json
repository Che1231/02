[{"question": "\u5982\u4f55\u5728\u300a\u5173\u5361\u5347\u7ea7\u7403\u300b\u4e2d\u63a7\u5236\u7403\uff0c\u4ee5\u53ca\u57fa\u672c\u7684\u79fb\u52a8\u65b9\u5f0f\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300a\u5173\u5361\u5347\u7ea7\u7403\u300b\u4e2d\uff0c\u63a7\u5236\u7403\u9700\u8981\u4f7f\u7528\u65b9\u5411\u952e\u6216\u64cd\u7eb5\u6746\u6765\u5de6\u53f3\u79fb\u52a8\u548c\u524d\u540e\u79fb\u52a8\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u5173\u4e2d\uff0c\u4f60\u9700\u8981\u901a\u8fc7\u7565\u5fae\u503e\u659c\u64cd\u7eb5\u6746\u6765\u907f\u5f00\u969c\u788d\u7269\uff0c\u4ece\u800c\u5728\u8ff7\u5bab\u4e2d\u5bfc\u822a\u3002\u6b64\u5916\uff0c\u6309\u4e0b\u8df3\u8dc3\u952e\u53ef\u4ee5\u8ba9\u7403\u8df3\u8fc7\u7a7a\u9699\u3002\u6b65\u9aa4\u4e00\uff1a\u8f7b\u8f7b\u503e\u659c\u64cd\u7eb5\u6746\u79fb\u52a8\u3002\u6b65\u9aa4\u4e8c\uff1a\u5728\u9002\u5f53\u7684\u65f6\u5019\u6309\u4e0b\u8df3\u8dc3\u952e\u3002\u6b65\u9aa4\u4e09\uff1a\u5728\u6559\u7a0b\u5173\u5361\u4e2d\u7ec3\u4e60\uff0c\u611f\u53d7\u63a7\u5236\u65b9\u5f0f\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u7403\u60f3\u8c61\u6210\u4e00\u8f86\u5728\u873f\u8712\u9053\u8def\u4e0a\u884c\u9a76\u7684\u6c7d\u8f66\uff1b\u7cbe\u786e\u5ea6\u81f3\u5173\u91cd\u8981\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u7684\u7403\u4f1a\u5728\u300a\u5173\u5361\u5347\u7ea7\u7403\u300b\u4e2d\u4e0d\u65ad\u4ece\u5e73\u53f0\u4e0a\u6389\u4e0b\u6765\uff0c\u4ee5\u53ca\u5982\u4f55\u9632\u6b62\u8fd9\u79cd\u60c5\u51b5\uff1f", "answer": "\u4ece\u5e73\u53f0\u4e0a\u6389\u4e0b\u6765\u901a\u5e38\u662f\u7531\u4e8e\u8fc7\u5ea6\u8f6c\u5411\u6216\u9519\u8bef\u5224\u65ad\u8df3\u8dc3\u9020\u6210\u7684\u3002\u5728\u300a\u5173\u5361\u5347\u7ea7\u7403\u300b\u4e2d\uff0c\u6bcf\u4e2a\u5e73\u53f0\u90fd\u6709\u72ec\u7279\u7684\u5e03\u5c40\uff0c\u4f8b\u5982\u201c\u9ad8\u7a7a\u201d\u5173\u5361\u4e2d\u7684\u72ed\u7a84\u6865\u6881\u3002\u4e3a\u4e86\u9632\u6b62\u6389\u843d\uff0c\u6b65\u9aa4\u4e00\uff1a\u51cf\u6162\u79fb\u52a8\u901f\u5ea6\uff0c\u907f\u514d\u7a81\u7136\u503e\u659c\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u955c\u5934\u89d2\u5ea6\u66f4\u597d\u5730\u5224\u65ad\u8ddd\u79bb\u3002\u6b65\u9aa4\u4e09\uff1a\u5148\u5728\u8f83\u5c0f\u7684\u5e73\u53f0\u4e0a\u7ec3\u4e60\u8df3\u8dc3\u65f6\u673a\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u72ed\u7a84\u7684\u5e73\u53f0\u9700\u8981\u8f83\u6162\u7684\u79fb\u52a8\u901f\u5ea6\uff0c\u800c\u8f83\u5bbd\u7684\u5e73\u53f0\u5141\u8bb8\u66f4\u5feb\u7684\u5bfc\u822a\u3002]"}, {"question": "\u300a\u5173\u5361\u5347\u7ea7\u7403\u300b\u4e2d\u7684\u9053\u5177\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5b83\u4eec\u5982\u4f55\u589e\u5f3a\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u300a\u5173\u5361\u5347\u7ea7\u7403\u300b\u6709\u591a\u79cd\u9053\u5177\uff0c\u4f8b\u5982\u901f\u5ea6\u63d0\u5347\u9053\u5177\uff0c\u53ef\u4ee5\u6682\u65f6\u589e\u52a0\u7403\u7684\u901f\u5ea6\uff0c\u4ee5\u53ca\u62a4\u76fe\u9053\u5177\uff0c\u53ef\u4ee5\u5728\u4e00\u5b9a\u65f6\u95f4\u5185\u4fdd\u62a4\u4f60\u514d\u53d7\u5371\u9669\u3002\u4f8b\u5982\uff0c\u5728\u201c\u6c34\u6676\u6d1e\u7a74\u201d\u5173\u5361\u4e2d\uff0c\u901f\u5ea6\u63d0\u5347\u9053\u5177\u53ef\u4ee5\u5e2e\u52a9\u4f60\u8d85\u8d8a\u6eda\u52a8\u7684\u5de8\u77f3\u3002\u6b65\u9aa4\u4e00\uff1a\u5728\u5730\u56fe\u4e0a\u5bfb\u627e\u53d1\u5149\u7684\u56fe\u6807\u3002\u6b65\u9aa4\u4e8c\uff1a\u6eda\u8fc7\u5b83\u4eec\u6765\u6fc0\u6d3b\u3002\u6b65\u9aa4\u4e09\uff1a\u6218\u7565\u6027\u5730\u4f7f\u7528\u5b83\u4eec\uff0c\u4f8b\u5982\u5c06\u62a4\u76fe\u7559\u7ed9\u5371\u9669\u9891\u53d1\u7684\u533a\u57df\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u901f\u5ea6\u63d0\u5347\u9053\u5177\u975e\u5e38\u9002\u5408\u65f6\u95f4\u8d5b\u8dd1\uff0c\u800c\u62a4\u76fe\u5219\u66f4\u9002\u5408\u4ee5\u751f\u5b58\u4e3a\u91cd\u70b9\u7684\u5173\u5361\u3002]"}, {"question": "\u5982\u4f55\u5728\u300a\u5173\u5361\u5347\u7ea7\u7403\u300b\u4e2d\u4f18\u5316\u5f97\u5206\uff0c\u4ee5\u53ca\u5e94\u8be5\u4f7f\u7528\u54ea\u4e9b\u7b56\u7565\uff1f", "answer": "\u4e3a\u4e86\u5728\u300a\u5173\u5361\u5347\u7ea7\u7403\u300b\u4e2d\u4f18\u5316\u5f97\u5206\uff0c\u4e13\u6ce8\u4e8e\u6536\u96c6\u6240\u6709\u5b9d\u77f3\u5e76\u5c3d\u5feb\u5b8c\u6210\u5173\u5361\u3002\u4f8b\u5982\uff0c\u5728\u201c\u91d1\u8272\u6797\u5730\u201d\u5173\u5361\u4e2d\uff0c\u4f60\u53ef\u4ee5\u901a\u8fc7\u53d1\u73b0\u9690\u85cf\u7684\u5b9d\u77f3\u96c6\u7fa4\u6765\u83b7\u5f97\u989d\u5916\u5206\u6570\u3002\u6b65\u9aa4\u4e00\uff1a\u63a2\u7d22\u5730\u56fe\u7684\u6bcf\u4e00\u4e2a\u89d2\u843d\uff0c\u5bfb\u627e\u9690\u85cf\u7269\u54c1\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u78c1\u94c1\u7b49\u9053\u5177\u5438\u5f15\u8fdc\u5904\u7684\u5b9d\u77f3\u3002\u6b65\u9aa4\u4e09\uff1a\u7ec3\u4e60\u5feb\u901f\u901a\u5173\uff0c\u4ee5\u7f29\u77ed\u5b8c\u6210\u65f6\u95f4\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u63a2\u7d22\u2192\u6536\u96c6\u2192\u5feb\u901f\u901a\u5173\u2192\u91cd\u590d\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u300a\u5173\u5361\u5347\u7ea7\u7403\u300b\u4e2d\u6709\u4e9b\u5173\u5361\u6bd4\u5176\u4ed6\u5173\u5361\u66f4\u96be\uff0c\u4ee5\u53ca\u5982\u4f55\u4e3a\u5b83\u4eec\u505a\u597d\u51c6\u5907\uff1f", "answer": "\u300a\u5173\u5361\u5347\u7ea7\u7403\u300b\u4e2d\u7684\u5173\u5361\u96be\u5ea6\u56e0\u5e73\u53f0\u590d\u6742\u7a0b\u5ea6\u3001\u654c\u4eba\u4f4d\u7f6e\u548c\u73af\u5883\u5371\u5bb3\u800c\u5f02\u3002\u4f8b\u5982\uff0c\u201c\u7194\u5ca9\u8ff7\u5bab\u201d\u5173\u5361\u5f15\u5165\u4e86\u79fb\u52a8\u5e73\u53f0\u548c\u706b\u9677\u9631\u3002\u4e3a\u4e86\u505a\u597d\u51c6\u5907\uff0c\u6b65\u9aa4\u4e00\uff1a\u91cd\u73a9\u4e4b\u524d\u7684\u5173\u5361\uff0c\u638c\u63e1\u57fa\u672c\u63a7\u5236\u3002\u6b65\u9aa4\u4e8c\uff1a\u5728\u9884\u89c8\u5c4f\u5e55\u4e2d\u7814\u7a76\u5173\u5361\u5e03\u5c40\u3002\u6b65\u9aa4\u4e09\uff1a\u88c5\u5907\u62a4\u76fe\u7b49\u9053\u5177\uff0c\u4ee5\u589e\u5f3a\u4fdd\u62a4\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u628a\u5b83\u60f3\u8c61\u6210\u9a6c\u62c9\u677e\u8bad\u7ec3\uff1b\u6bcf\u4e2a\u5173\u5361\u90fd\u5728\u63d0\u5347\u4f60\u7684\u6280\u80fd\u3002]"}, {"question": "\u300a\u5173\u5361\u5347\u7ea7\u7403\u300b\u4e2d\u7ec4\u5408\u7cfb\u7edf\u7684\u610f\u4e49\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5b83\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u300a\u5173\u5361\u5347\u7ea7\u7403\u300b\u4e2d\u7684\u7ec4\u5408\u7cfb\u7edf\u4f1a\u5956\u52b1\u73a9\u5bb6\u8fde\u7eed\u8fdb\u884c\u6ca1\u6709\u9519\u8bef\u7684\u52a8\u4f5c\uff0c\u4f8b\u5982\u5feb\u901f\u8fde\u7eed\u6536\u96c6\u5b9d\u77f3\u6216\u51fb\u8d25\u654c\u4eba\u3002\u4f8b\u5982\uff0c\u5728\u201c\u51b0\u5cf0\u201d\u5173\u5361\u4e2d\uff0c\u8fde\u9501\u6536\u96c6\u5b9d\u77f3\u53ef\u4ee5\u4f7f\u4f60\u7684\u5206\u6570\u7ffb\u500d\u3002\u6b65\u9aa4\u4e00\uff1a\u4e13\u6ce8\u4e8e\u4fdd\u6301\u7a33\u5b9a\u7684\u8282\u594f\u3002\u6b65\u9aa4\u4e8c\uff1a\u907f\u514d\u6253\u7834\u7ec4\u5408\u7684\u5371\u9669\u3002\u6b65\u9aa4\u4e09\uff1a\u4f7f\u7528\u901f\u5ea6\u63d0\u5347\u7b49\u9053\u5177\u6765\u4fdd\u6301\u52bf\u5934\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u77ed\u7ec4\u5408\u63d0\u4f9b\u5c11\u91cf\u5956\u52b1\uff0c\u800c\u957f\u7ec4\u5408\u5219\u63d0\u4f9b\u6307\u6570\u7ea7\u7684\u5956\u52b1\u3002]"}, {"question": "\u300a\u5173\u5361\u5347\u7ea7\u7403\u300b\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u4f53\u9a8c\uff0c\u4ee5\u53ca\u9700\u8981\u6ce8\u610f\u54ea\u4e9b\u65b9\u9762\uff1f", "answer": "\u300a\u5173\u5361\u5347\u7ea7\u7403\u300b\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u6a21\u62df\u4e86\u771f\u5b9e\u7684\u7403\u4f53\u79fb\u52a8\uff0c\u5305\u62ec\u52a8\u91cf\u548c\u6469\u64e6\u3002\u4f8b\u5982\uff0c\u5728\u201c\u51b0\u5cf0\u201d\u5173\u5361\u7b49\u51b0\u9762\uff0c\u7403\u7684\u6ed1\u52a8\u4f1a\u66f4\u591a\uff0c\u63a7\u5236\u4f1a\u66f4\u96be\u3002\u6b65\u9aa4\u4e00\uff1a\u6839\u636e\u52a8\u91cf\u8c03\u6574\u4f60\u7684\u52a8\u4f5c\u3002\u6b65\u9aa4\u4e8c\uff1a\u5229\u7528\u73af\u5883\u6765\u53d1\u6325\u4f18\u52bf\uff0c\u4f8b\u5982\u5229\u7528\u659c\u5761\u83b7\u5f97\u901f\u5ea6\u3002\u6b65\u9aa4\u4e09\uff1a\u5728\u4e0d\u540c\u7684\u5730\u5f62\u4e0a\u7ec3\u4e60\uff0c\u4e86\u89e3\u7269\u7406\u53d8\u5316\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u7403\u60f3\u8c61\u6210\u51b0\u7403\uff1b\u5b83\u5728\u51b0\u9762\u548c\u8349\u5730\u4e0a\u7684\u884c\u4e3a\u4e0d\u540c\u3002]"}, {"question": "\u300a\u5173\u5361\u5347\u7ea7\u7403\u300b\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u6210\u5c31\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9501\u5b83\u4eec\uff1f", "answer": "\u300a\u5173\u5361\u5347\u7ea7\u7403\u300b\u5305\u542b\u9690\u85cf\u6210\u5c31\uff0c\u4f8b\u5982\u201c\u5e7d\u7075\u8d5b\u8dd1\u201d\uff0c\u8981\u6c42\u5728\u4e0d\u53d7\u5230\u4f24\u5bb3\u7684\u60c5\u51b5\u4e0b\u5b8c\u6210\u4e00\u4e2a\u5173\u5361\u3002\u4f8b\u5982\uff0c\u5728\u201c\u9634\u5f71\u8ff7\u5bab\u201d\u5173\u5361\u4e2d\uff0c\u4f60\u9700\u8981\u907f\u5f00\u6240\u6709\u9677\u9631\u548c\u654c\u4eba\u3002\u6b65\u9aa4\u4e00\uff1a\u7814\u7a76\u5173\u5361\u5e03\u5c40\uff0c\u8bc6\u522b\u5371\u9669\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u62a4\u76fe\u7b49\u9053\u5177\u6765\u964d\u4f4e\u98ce\u9669\u3002\u6b65\u9aa4\u4e09\uff1a\u7ec3\u4e60\uff0c\u76f4\u5230\u4f60\u80fd\u5b8c\u7f8e\u5730\u5bfc\u822a\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6709\u4e9b\u6210\u5c31\u9700\u8981\u901f\u5ea6\uff0c\u800c\u53e6\u4e00\u4e9b\u5219\u4fa7\u91cd\u4e8e\u7cbe\u786e\u6027\u3002]"}, {"question": "\u6211\u662f\u5426\u53ef\u4ee5\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u300a\u5173\u5361\u5347\u7ea7\u7403\u300b\u7684\u6e38\u620f\u8fdb\u5ea6\uff1f\u8de8\u5e73\u53f0\u6e38\u620f\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u662f\u7684\uff0c\u300a\u5173\u5361\u5347\u7ea7\u7403\u300b\u652f\u6301\u901a\u8fc7\u4e91\u4fdd\u5b58\u8de8\u5e73\u53f0\u6e38\u620f\u8fdb\u5ea6\u8f6c\u79fb\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4ece\u7535\u8111\u5207\u6362\u5230\u6e38\u620f\u673a\uff0c\u4f60\u7684\u5b58\u6863\u6570\u636e\u4f1a\u81ea\u52a8\u540c\u6b65\u3002\u6b65\u9aa4\u4e00\uff1a\u786e\u4fdd\u4f60\u5728\u4e24\u4e2a\u5e73\u53f0\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u8d26\u6237\u3002\u6b65\u9aa4\u4e8c\uff1a\u5728\u6e38\u620f\u8bbe\u7f6e\u4e2d\u542f\u7528\u4e91\u4fdd\u5b58\u3002\u6b65\u9aa4\u4e09\uff1a\u9a8c\u8bc1\u4f60\u7684\u8fdb\u5ea6\u5df2\u6b63\u786e\u8f6c\u79fb\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u4e91\u4fdd\u5b58\u5728\u7535\u8111\u3001\u6e38\u620f\u673a\u548c\u624b\u673a\u4e0a\u53ef\u7528\uff0c\u4f46\u9700\u8981\u8fde\u63a5\u5230\u4e92\u8054\u7f51\u3002]"}, {"question": "\u300a\u5173\u5361\u5347\u7ea7\u7403\u300b\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u5173\u5361\uff0c\u4ee5\u53ca\u5982\u4f55\u8bbf\u95ee\u5b83\u4eec\uff1f", "answer": "\u300a\u5173\u5361\u5347\u7ea7\u7403\u300b\u5305\u542b\u9690\u85cf\u5173\u5361\uff0c\u4f8b\u5982\u201c\u6c38\u6052\u6df1\u6e0a\u201d\uff0c\u901a\u8fc7\u5728\u4e3b\u5173\u5361\u4e2d\u6536\u96c6\u6240\u6709\u9690\u85cf\u94a5\u5319\u6765\u89e3\u9501\u3002\u4f8b\u5982\uff0c\u5728\u201c\u53e4\u4ee3\u9057\u8ff9\u201d\u5173\u5361\u4e2d\uff0c\u94a5\u5319\u85cf\u5728\u53ef\u7834\u574f\u7684\u5899\u58c1\u540e\u9762\u3002\u6b65\u9aa4\u4e00\uff1a\u5f7b\u5e95\u63a2\u7d22\u6bcf\u4e2a\u5173\u5361\uff0c\u5bfb\u627e\u9690\u85cf\u7684\u94a5\u5319\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528X\u5c04\u7ebf\u89c6\u89c9\u7b49\u9053\u5177\u6765\u53d1\u73b0\u9690\u85cf\u8def\u5f84\u3002\u6b65\u9aa4\u4e09\uff1a\u6536\u96c6\u6240\u6709\u94a5\u5319\u540e\uff0c\u9690\u85cf\u5173\u5361\u5c06\u663e\u793a\u5728\u5730\u56fe\u4e0a\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u94a5\u5319\u60f3\u8c61\u6210\u85cf\u5b9d\u56fe\u788e\u7247\uff1b\u53ea\u6709\u5f53\u6240\u6709\u788e\u7247\u90fd\u627e\u5230\u65f6\uff0c\u8def\u5f84\u624d\u4f1a\u663e\u73b0\u3002]"}]
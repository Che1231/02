[{"question": "\ucd08\uc2ec\uc790\ub85c\uc11c 3D \ub370\uc2a4\ub7f0\uc5d0\uc11c \uae30\ubcf8\uc801\uc778 \uc6c0\uc9c1\uc784\uc740 \uc5b4\ub5bb\uac8c \uc218\ud589\ud569\ub2c8\uae4c?", "answer": "3D \ub370\uc2a4\ub7f0\uc5d0\uc11c \uae30\ubcf8\uc801\uc778 \uc6c0\uc9c1\uc784\uc740 \uc7a5\uc560\ubb3c\uc744 \uadf9\ubcf5\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc55e\uc73c\ub85c \uc774\ub3d9\ud558\ub824\uba74 \ud654\uba74\uc744 \uc704\ub85c \uc4f8\uc5b4 \uc62c\ub9bd\ub2c8\ub2e4. \uc606\uc73c\ub85c \uc774\ub3d9\ud558\ub824\uba74 \uc67c\ucabd\uc774\ub098 \uc624\ub978\ucabd\uc73c\ub85c \uc4f8\uc5b4 \ub0b4\ub9ac\uace0, \uc6c5\ud06c\ub9ac\ub824\uba74 \uc544\ub798\ub85c \uc4f8\uc5b4 \ub0b4\ub9bd\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub0ae\uc740 \uc7a5\uc560\ubb3c\uc5d0 \uc811\uadfc\ud560 \ub54c \uc544\ub798\ub85c \uc4f8\uc5b4 \ub0b4\ub9ac\uba74 \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \ud29c\ud1a0\ub9ac\uc5bc \ub808\ubca8\uc5d0\uc11c \uc774\ub7ec\ud55c \uc81c\uc2a4\ucc98\ub97c \uc5f0\uc2b5\ud558\uc5ec \uadfc\uc721 \uae30\uc5b5\uc744 \ud0a4\uc6b0\uc2ed\uc2dc\uc624. [\ube44\uc720 \uc124\uba85: \ud654\uba74\uc744 \uac01 \uc4f8\uc5b4 \ub0b4\ub9ac\ub294 \ub3d9\uc791\uc73c\ub85c \uce90\ub9ad\ud130\ub97c \uc870\uc885\ud558\ub294 \uc2a4\ud2f0\uc5b4\ub9c1 \ud720\ub85c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694.]"}, {"question": "3D \ub370\uc2a4\ub7f0\uc5d0\uc11c \uace0\uae09 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "3D \ub370\uc2a4\ub7f0\uc758 \uace0\uae09 \ub808\ubca8\uc740 \uc815\ud655\uc131\uacfc \ud0c0\uc774\ubc0d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \uc5ec\ub7ec \ubc88 \ub808\ubca8\uc744 \ubc18\ubcf5\ud574\uc11c \uc7a5\uc560\ubb3c \ud328\ud134\uc744 \uc5f0\uad6c\ud569\ub2c8\ub2e4. STEP2: \ub9ac\ub4ec\uc5d0 \uc9d1\uc911\ud569\ub2c8\ub2e4. \ub9ce\uc740 \uc7a5\uc560\ubb3c\uc740 \uc74c\uc545\uc774\ub098 \uc77c\uad00\ub41c \ubc15\uc790\uc5d0 \ub9de\ucdb0\uc838 \uc788\uc2b5\ub2c8\ub2e4. STEP3: \ubc29\ud328\uc640 \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc5ec \ud55c \uac1c\uc758 \uc7a5\uc560\ubb3c\uc744 \uc6b0\ud68c\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 20\ub808\ubca8\uc5d0\uc11c \uc74c\uc545\uacfc \ub6f0\ub294 \ud0c0\uc774\ubc0d\uc744 \ub9de\ucd94\uba74 \ud68c\uc804\ud558\ub294 \uce7c\ub0a0\uc744 \ub118\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc911 \uc194\ub8e8\uc158 \ube44\uad50: \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\ub294 \uc554\uae30, \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub294 \ube60\ub978 \ubc18\uc0ac\uc5d0 \uc758\uc874\ud569\ub2c8\ub2e4.]"}, {"question": "\uc65c 3D \ub370\uc2a4\ub7f0\uc5d0\uc11c \uce90\ub9ad\ud130\uac00 \ub54c\ub54c\ub85c \uc7a5\uc560\ubb3c\uc744 \ub6f0\uc5b4\ub118\uc9c0 \ubabb\ud569\ub2c8\uae4c?", "answer": "3D \ub370\uc2a4\ub7f0\uc5d0\uc11c \uc810\ud504 \uc2e4\ud328\ub294 \uc885\uc885 \uc4f8\uc5b4 \ub0b4\ub9ac\ub294 \ud0c0\uc774\ubc0d\uc774 \uc798\ubabb\ub418\uac70\ub098 \uae30\uae30\uc758 \uac10\ub3c4 \ubb38\uc81c\ub85c \uc778\ud574 \ubc1c\uc0dd\ud569\ub2c8\ub2e4. \uc4f8\uc5b4 \ub0b4\ub9ac\ub294 \ub3d9\uc791\uc744 \uc2e0\uc911\ud558\uace0 \ub108\ubb34 \ube60\ub974\uc9c0 \uc54a\uac8c\ud558\uc2ed\uc2dc\uc624. \uc800\uc0ac\uc591 \uae30\uae30\ub97c \uc0ac\uc6a9\ud558\ub294 \uacbd\uc6b0 \uadf8\ub798\ud53d \uc124\uc815\uc744 \ub0ae\ucd94\uba74 \ubc18\uc751\uc131\uc774 \ud5a5\uc0c1\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 15\uc5d0\uc11c \ub108\ubb34 \uc77c\ucc0d \ub610\ub294 \ub108\ubb34 \ub2a6\uac8c \uc4f8\uc5b4 \ub0b4\ub9ac\uba74 \uce90\ub9ad\ud130\uac00 \ud50c\ub7ab\ud3fc\uc744 \ub193\uce58\uac8c \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ucee8\ud53c\uadf8\ub808\uc774\uc158 \ube44\uad50\ud45c: \uace0\uc0ac\uc591 \uae30\uae30\ub294 \uc131\uacf5\ub960\uc774 95%\uc778 \ubc18\uba74, \uc800\uc0ac\uc591 \uae30\uae30\ub294 75%\ub85c \ub5a8\uc5b4\uc9d1\ub2c8\ub2e4.]"}, {"question": "3D \ub370\uc2a4\ub7f0\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \ubb34\uc5c7\uc774 \uc810\uc218\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "3D \ub370\uc2a4\ub7f0\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc8fc\ud589 \uac70\ub9ac, \ucf54\uc778 \uc218\uc9d1 \ubc0f \ucf64\ubcf4 \uba40\ud2f0\ud50c\ub77c\uc774\uc5b4\ub97c \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. 1\ubbf8\ud130\ub9c8\ub2e4 \uc8fc\ud589 \uac70\ub9ac\uac00 \uc810\uc218\uc5d0 \ub354\ud574\uc9c0\uace0, \ucf54\uc778\uc740 \ubcf4\ub108\uc2a4 \uc810\uc218\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ucf64\ubcf4\ub294 \uc5f0\uc18d\uc73c\ub85c \uc5ec\ub7ec \ucf54\uc778\uc744 \ubaa8\uc544\uc11c \ub2ec\uc131\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 10\ub808\ubca8\uc5d0\uc11c \uc5f0\uc18d \uc138 \uac1c\uc758 \ucf54\uc778\uc744 \ubaa8\uc73c\uba74 \ud574\ub2f9 \uad6c\uac04\uc758 \uc810\uc218\uac00 \ub450 \ubc30\ub85c \uc99d\uac00\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \ub2e4\uc774\uc5b4\uadf8\ub7a8: \uac70\ub9ac \u2192 \ucf54\uc778 \u2192 \ucf64\ubcf4 \u2192 \ucd1d \uc810\uc218]"}, {"question": "3D \ub370\uc2a4\ub7f0\uc5d0\uc11c \uc5b4\ub5a4 \ud30c\uc6cc\uc5c5\uc774 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc774\uba70 \uc5b8\uc81c \uc0ac\uc6a9\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "3D \ub370\uc2a4\ub7f0\uc5d0\uc11c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ud30c\uc6cc\uc5c5\uc740 \ubc29\ud328, \uc790\uc11d \ubc0f \uc18d\ub3c4 \ubd80\uc2a4\ud2b8\uc785\ub2c8\ub2e4. \ubc29\ud328\ub294 \ud558\ub098\uc758 \uc7a5\uc560\ubb3c\uc744 \uc6b0\ud68c\ud558\uace0, \uc790\uc11d\uc740 \ucf54\uc778\uc744 \uc790\ub3d9\uc73c\ub85c \uc218\uc9d1\ud558\uba70, \uc18d\ub3c4 \ubd80\uc2a4\ud2b8\ub294 \ub354 \uae34 \uac70\ub9ac\ub97c \ube60\ub974\uac8c \uc774\ub3d9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 25\ub808\ubca8\uc5d0\uc11c \uae34 \uad6c\uac04 \uc804\uc5d0 \uc18d\ub3c4 \ubd80\uc2a4\ud2b8\ub97c \uc0ac\uc6a9\ud558\uba74 \uc5ec\ub7ec \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc911 \uc194\ub8e8\uc158 \ube44\uad50: \ubc29\ud328\ub294 \uc815\ud655\uc131\uc5d0 \uc801\ud569\ud558\uace0 \uc18d\ub3c4 \ubd80\uc2a4\ud2b8\ub294 \uc2a4\ud53c\ub4dc\ub7f0\uc5d0 \uc774\uc0c1\uc801\uc785\ub2c8\ub2e4.]"}, {"question": "\ubaa8\ubc14\uc77c \ubc0f PC \ud50c\ub7ab\ud3fc\uc5d0\uc11c 3D \ub370\uc2a4\ub7f0\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubaa8\ubc14\uc77c \ubc0f PC \ud50c\ub7ab\ud3fc\uc5d0\uc11c 3D \ub370\uc2a4\ub7f0\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc5d0\ub294 \ucee8\ud2b8\ub864, \uadf8\ub798\ud53d \ubc0f \uc131\ub2a5\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ubaa8\ubc14\uc77c\uc740 \ud130\uce58 \uc81c\uc2a4\ucc98\ub97c \uc0ac\uc6a9\ud558\uace0, PC\ub294 \ud0a4\ubcf4\ub4dc \uc785\ub825\uc5d0 \uc758\uc874\ud569\ub2c8\ub2e4. PC \ubc84\uc804\uc740 \uadf8\ub798\ud53d \uc124\uc815\uc774 \ub354 \ub192\uace0 \uc131\ub2a5\uc774 \ub354 \uc6d0\ud65c\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 30\ub808\ubca8\uc758 PC \ubc84\uc804\uc5d0\ub294 \ud5a5\uc0c1\ub41c \uc9c8\uac10\uacfc \uc870\uba85 \ud6a8\uacfc\uac00 \uc788\uc2b5\ub2c8\ub2e4. [\ucee8\ud53c\uadf8\ub808\uc774\uc158 \ube44\uad50\ud45c: \ubaa8\ubc14\uc77c: \ud130\uce58 \ucee8\ud2b8\ub864, \uc911\uac04 \uadf8\ub798\ud53d. PC: \ud0a4\ubcf4\ub4dc \ucee8\ud2b8\ub864, \uace0\uae09 \uadf8\ub798\ud53d.]"}, {"question": "3D \ub370\uc2a4\ub7f0\uc5d0\uc11c \uc228\uaca8\uc9c4 \ub808\ubca8\uc744 \uc5b4\ub5bb\uac8c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "3D \ub370\uc2a4\ub7f0\uc758 \uc228\uaca8\uc9c4 \ub808\ubca8\uc740 \ud2b9\uc815 \ucc4c\ub9b0\uc9c0 \uc644\ub8cc \ub610\ub294 \ud2b9\uc815 \uc544\uc774\ud15c \uc218\uc9d1\uc744 \ud1b5\ud574 \uc7a0\uae08 \ud574\uc81c\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 5\ub808\ubca8\uc758 \ubaa8\ub4e0 \ucf54\uc778\uc744 \uc218\uc9d1\ud558\uba74 \ube44\ubc00 \ub808\ubca8\uc774 \uc7a0\uae08 \ud574\uc81c\ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ub808\ubca8\uc5d0\ub294 \uc885\uc885 \ub3c5\ud2b9\ud55c \uc7a5\uc560\ubb3c\uacfc \ub354 \ub192\uc740 \ub09c\uc774\ub3c4\uac00 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc228\uaca8\uc9c4 \ub808\ubca8\uc744 \ubc1c\uacac\ud558\uae30 \uc704\ud574 \uae30\ub2e4\ub9ac\ub294 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub85c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694.]"}, {"question": "3D \ub370\uc2a4\ub7f0\uc5d0\uc11c \uc7a5\uc560\ubb3c \uc0dd\uc131\uc758 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "3D \ub370\uc2a4\ub7f0\uc758 \uc7a5\uc560\ubb3c \uc0dd\uc131\uc740 \ub2e4\uc591\uc131\uacfc \ub09c\uc774\ub3c4\ub97c \ubcf4\uc7a5\ud558\ub294 \ud504\ub85c\uc2dc\uc800 \uc54c\uace0\ub9ac\uc998\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uac01 \ub808\ubca8\uc5d0\ub294 \ubbf8\ub9ac \uc815\uc758\ub41c \uc7a5\uc560\ubb3c \uc9d1\ud569\uc774 \uc788\uc9c0\ub9cc, \ud2b9\uc815 \ub9e4\uac1c\ubcc0\uc218 \ub0b4\uc5d0\uc11c \ubc30\uce58\uac00 \ubb34\uc791\uc704\ub85c \uacb0\uc815\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 10\uc5d0\ub294 \ud56d\uc0c1 \ud68c\uc804\ud558\ub294 \uce7c\ub0a0\uc774 \ud3ec\ud568\ub418\uc9c0\ub9cc, \uadf8 \ud0c0\uc774\ubc0d\uacfc \uc704\uce58\ub294 \ub2e4\ub985\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \ub2e4\uc774\uc5b4\uadf8\ub7a8: \uc54c\uace0\ub9ac\uc998 \u2192 \uc7a5\uc560\ubb3c \ud480 \u2192 \ubb34\uc791\uc704 \ubc30\uce58 \u2192 \ub808\ubca8 \ub514\uc790\uc778]"}, {"question": "\ucd5c\uc0c1\uc758 3D \ub370\uc2a4\ub7f0 \uacbd\ud5d8\uc744 \uc704\ud574 \uae30\uae30 \uc124\uc815\uc744 \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uae30\uae30\ub97c 3D \ub370\uc2a4\ub7f0\uc5d0 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uba3c\uc800 \uc6b4\uc601 \uccb4\uc81c\uac00 \ucd5c\uc2e0 \ubc84\uc804\uc778\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uc9c0\uc5f0\uc774 \ubc1c\uc0dd\ud558\uba74 \uadf8\ub798\ud53d \uc124\uc815\uc744 \ub0ae\ucd94\uace0 \ubc31\uadf8\ub77c\uc6b4\ub4dc \uc571\uc744 \ub2eb\uc544 \uba54\ubaa8\ub9ac\ub97c \ud655\ubcf4\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uad6c\ud615 \uae30\uae30\uc5d0\uc11c \ud574\uc0c1\ub3c4\ub97c \ub0ae\ucd94\uba74 \ud504\ub808\uc784 \uc18d\ub3c4\uac00 \uac1c\uc120\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ucee8\ud53c\uadf8\ub808\uc774\uc158 \ube44\uad50\ud45c: \ub192\uc74c \uc124\uc815: 60 FPS, \uc911\uac04: 45 FPS, \ub0ae\uc74c: 30 FPS.]"}, {"question": "3D \ub370\uc2a4\ub7f0\uc5d0\uc11c \uac00\uc7a5 \uc5b4\ub824\uc6b4 \uc7a5\uc560\ubb3c\uc740 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \uadf9\ubcf5\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "3D \ub370\uc2a4\ub7f0\uc5d0\uc11c \uac00\uc7a5 \uc5b4\ub824\uc6b4 \uc7a5\uc560\ubb3c\uc5d0\ub294 \ud68c\uc804\ud558\ub294 \uce7c\ub0a0, \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc \ubc0f \ub808\uc774\uc800 \ube54\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub4e4\uc744 \uadf9\ubcf5\ud558\uae30 \uc704\ud574\uc11c\ub294 \ud0c0\uc774\ubc0d\uacfc \uc815\ud655\uc131\uc5d0 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \ud68c\uc804\ud558\ub294 \uce7c\ub0a0\uc758 \uacbd\uc6b0 \uc810\ud504\ud558\uae30 \uc804\uc5d0 \ud2c8\uc0c8\ub97c \uae30\ub2e4\ub9ac\uc2ed\uc2dc\uc624. \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uc758 \uacbd\uc6b0 \uc6c0\uc9c1\uc784\uacfc \uc810\ud504\ub97c \uc77c\uce58\uc2dc\ud0a4\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, 40\ub808\ubca8\uc5d0\uc11c \ub808\uc774\uc800 \ube54\uc758 \uc791\ub3d9\uacfc \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uc77c\uce58\uc2dc\ud0a4\uba74 \uc2e4\ud328\ub97c \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc911 \uc194\ub8e8\uc158 \ube44\uad50: \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\ub294 \uc554\uae30, \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub294 \ube60\ub978 \ubc18\uc0ac\uc5d0 \uc758\uc874\ud569\ub2c8\ub2e4.]"}]
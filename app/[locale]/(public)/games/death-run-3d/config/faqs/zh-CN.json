[{"question": "\u5982\u4f55\u4f5c\u4e3a\u65b0\u624b\u57283D\u6b7b\u4ea1\u7ade\u901f\u6e38\u620f\u4e2d\u6267\u884c\u57fa\u672c\u52a8\u4f5c\uff1f", "answer": "\u57283D\u6b7b\u4ea1\u7ade\u901f\u6e38\u620f\u4e2d\uff0c\u57fa\u672c\u52a8\u4f5c\u5bf9\u4e8e\u5728\u969c\u788d\u7269\u4e2d\u8fdb\u884c\u5bfc\u822a\u81f3\u5173\u91cd\u8981\u3002\u8981\u5411\u524d\u79fb\u52a8\uff0c\u8bf7\u5728\u5c4f\u5e55\u4e0a\u5411\u4e0a\u6ed1\u52a8\u3002\u5de6\u53f3\u6ed1\u52a8\u4ee5\u6a2a\u5411\u79fb\u52a8\uff0c\u5411\u4e0b\u6ed1\u52a8\u4ee5\u8e72\u4e0b\u3002\u4f8b\u5982\uff0c\u5728\u63a5\u8fd1\u4f4e\u969c\u788d\u7269\u65f6\uff0c\u5411\u4e0b\u6ed1\u52a8\u6709\u52a9\u4e8e\u907f\u514d\u649e\u5230\u5b83\u3002\u5728\u6559\u7a0b\u5173\u5361\u4e2d\u7ec3\u4e60\u8fd9\u4e9b\u624b\u52bf\uff0c\u4ee5\u5efa\u7acb\u808c\u8089\u8bb0\u5fc6\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u5c4f\u5e55\u60f3\u8c61\u6210\u4e00\u4e2a\u65b9\u5411\u76d8\uff0c\u6bcf\u6b21\u6ed1\u52a8\u90fd\u4f1a\u5f15\u5bfc\u4f60\u7684\u89d2\u8272\u3002]"}, {"question": "\u57283D\u6b7b\u4ea1\u7ade\u901f\u6e38\u620f\u4e2d\u5b8c\u6210\u9ad8\u7ea7\u5173\u5361\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "3D\u6b7b\u4ea1\u7ade\u901f\u6e38\u620f\u4e2d\u7684\u9ad8\u7ea7\u5173\u5361\u9700\u8981\u7cbe\u786e\u548c\u65f6\u673a\u3002\u6b65\u9aa41\uff1a\u901a\u8fc7\u591a\u6b21\u91cd\u73a9\u5173\u5361\u6765\u7814\u7a76\u969c\u788d\u7269\u6a21\u5f0f\u3002\u6b65\u9aa42\uff1a\u4e13\u6ce8\u4e8e\u8282\u594f\uff1b\u8bb8\u591a\u969c\u788d\u7269\u4e0e\u97f3\u4e50\u6216\u4e00\u4e2a\u6301\u7eed\u7684\u8282\u62cd\u540c\u6b65\u3002\u6b65\u9aa43\uff1a\u6218\u7565\u6027\u5730\u4f7f\u7528\u9053\u5177\uff0c\u4f8b\u5982\u76fe\u724c\u6765\u7ed5\u8fc7\u4e00\u4e2a\u969c\u788d\u7269\u3002\u4f8b\u5982\uff0c\u572820\u7ea7\u5173\u5361\u4e2d\uff0c\u5c06\u4f60\u7684\u8df3\u8dc3\u4e0e\u97f3\u4e50\u8282\u594f\u540c\u6b65\u53ef\u4ee5\u5e2e\u52a9\u4f60\u7a7f\u8fc7\u65cb\u8f6c\u7684\u5200\u7247\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u4e00\u4e9b\u73a9\u5bb6\u66f4\u559c\u6b22\u8bb0\u5fc6\uff0c\u800c\u53e6\u4e00\u4e9b\u73a9\u5bb6\u5219\u4f9d\u8d56\u5feb\u901f\u53cd\u5e94\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u7684\u89d2\u8272\u6709\u65f6\u65e0\u6cd5\u57283D\u6b7b\u4ea1\u7ade\u901f\u6e38\u620f\u4e2d\u8df3\u8fc7\u969c\u788d\u7269\uff1f", "answer": "\u57283D\u6b7b\u4ea1\u7ade\u901f\u6e38\u620f\u4e2d\u8df3\u8dc3\u5931\u8d25\u901a\u5e38\u662f\u7531\u4e8e\u6ed1\u52a8\u65f6\u673a\u4e0d\u6b63\u786e\u6216\u8bbe\u5907\u7075\u654f\u5ea6\u95ee\u9898\u3002\u786e\u4fdd\u4f60\u7684\u6ed1\u52a8\u52a8\u4f5c\u7cbe\u51c6\uff0c\u4e0d\u8981\u592a\u5feb\u3002\u5982\u679c\u4f7f\u7528\u4f4e\u7aef\u8bbe\u5907\uff0c\u8bf7\u8003\u8651\u964d\u4f4e\u56fe\u5f62\u8bbe\u7f6e\u4ee5\u63d0\u9ad8\u54cd\u5e94\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u572815\u7ea7\u5173\u5361\u4e2d\uff0c\u6ed1\u52a8\u8fc7\u65e9\u6216\u8fc7\u665a\u4f1a\u5bfc\u81f4\u4f60\u7684\u89d2\u8272\u9519\u8fc7\u5e73\u53f0\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u9ad8\u7aef\u8bbe\u5907\u7684\u6210\u529f\u7387\u4e3a95%\uff0c\u800c\u4f4e\u7aef\u8bbe\u5907\u5219\u4e0b\u964d\u523075%\u3002]"}, {"question": "3D\u6b7b\u4ea1\u7ade\u901f\u6e38\u620f\u7684\u8ba1\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u5b83\uff1f", "answer": "3D\u6b7b\u4ea1\u7ade\u901f\u6e38\u620f\u7684\u8ba1\u5206\u7cfb\u7edf\u57fa\u4e8e\u8dd1\u6b65\u8ddd\u79bb\u3001\u6536\u96c6\u7684\u786c\u5e01\u548c\u8fde\u51fb\u500d\u6570\u3002\u4f60\u8dd1\u8fc7\u7684\u6bcf\u4e00\u6bb5\u8ddd\u79bb\u90fd\u4f1a\u589e\u52a0\u5206\u6570\uff0c\u800c\u786c\u5e01\u5219\u63d0\u4f9b\u989d\u5916\u5206\u6570\u3002\u5feb\u901f\u8fde\u7eed\u5730\u6536\u96c6\u591a\u679a\u786c\u5e01\u5373\u53ef\u83b7\u5f97\u8fde\u51fb\u3002\u4f8b\u5982\uff0c\u572810\u7ea7\u5173\u5361\u4e2d\uff0c\u8fde\u7eed\u6536\u96c6\u4e09\u679a\u786c\u5e01\u53ef\u4ee5\u4f7f\u8be5\u533a\u57df\u7684\u5206\u6570\u7ffb\u500d\u3002[\u6d41\u7a0b\u56fe\u89e3: \u8ddd\u79bb \u2192 \u786c\u5e01 \u2192 \u8fde\u51fb \u2192 \u603b\u5206\u6570]"}, {"question": "\u57283D\u6b7b\u4ea1\u7ade\u901f\u6e38\u620f\u4e2d\u54ea\u4e9b\u9053\u5177\u6700\u6709\u6548\uff0c\u4ee5\u53ca\u4f55\u65f6\u5e94\u8be5\u4f7f\u7528\u5b83\u4eec\uff1f", "answer": "\u57283D\u6b7b\u4ea1\u7ade\u901f\u6e38\u620f\u4e2d\u6700\u6709\u6548\u7684\u9053\u5177\u662f\u76fe\u724c\u3001\u78c1\u94c1\u548c\u52a0\u901f\u3002\u4f7f\u7528\u76fe\u724c\u7ed5\u8fc7\u4e00\u4e2a\u969c\u788d\u7269\uff0c\u4f7f\u7528\u78c1\u94c1\u81ea\u52a8\u6536\u96c6\u786c\u5e01\uff0c\u4f7f\u7528\u52a0\u901f\u51b2\u523a\u5feb\u901f\u8dd1\u8fc7\u66f4\u591a\u8ddd\u79bb\u3002\u4f8b\u5982\uff0c\u572825\u7ea7\u5173\u5361\u4e2d\uff0c\u5728\u957f\u8ddd\u79bb\u51b2\u523a\u524d\u6fc0\u6d3b\u52a0\u901f\u9053\u5177\u53ef\u4ee5\u5e2e\u52a9\u4f60\u907f\u5f00\u591a\u4e2a\u969c\u788d\u7269\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u76fe\u724c\u6700\u9002\u5408\u7cbe\u786e\u64cd\u4f5c\uff0c\u800c\u52a0\u901f\u51b2\u523a\u6700\u9002\u5408\u901f\u5ea6\u8dd1\u901a\u5173\u3002]"}, {"question": "\u79fb\u52a8\u5e73\u53f0\u548cPC\u5e73\u53f0\u4e0a\u76843D\u6b7b\u4ea1\u7ade\u901f\u6e38\u620f\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u79fb\u52a8\u5e73\u53f0\u548cPC\u5e73\u53f0\u4e0a\u76843D\u6b7b\u4ea1\u7ade\u901f\u6e38\u620f\u7684\u4e3b\u8981\u533a\u522b\u5728\u4e8e\u63a7\u5236\u65b9\u5f0f\u3001\u56fe\u5f62\u548c\u6027\u80fd\u3002\u79fb\u52a8\u7aef\u4f7f\u7528\u89e6\u6478\u624b\u52bf\uff0c\u800cPC\u7aef\u5219\u4f9d\u8d56\u952e\u76d8\u8f93\u5165\u3002PC\u7248\u672c\u901a\u5e38\u5177\u6709\u66f4\u9ad8\u7684\u56fe\u5f62\u8bbe\u7f6e\u548c\u66f4\u6d41\u7545\u7684\u6027\u80fd\u3002\u4f8b\u5982\uff0c30\u7ea7\u5173\u5361\u7684PC\u7248\u672c\u5177\u6709\u589e\u5f3a\u7684\u7eb9\u7406\u548c\u706f\u5149\u6548\u679c\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u79fb\u52a8\u7aef\uff1a\u89e6\u6478\u63a7\u5236\uff0c\u4e2d\u7b49\u56fe\u5f62\u3002PC\u7aef\uff1a\u952e\u76d8\u63a7\u5236\uff0c\u9ad8\u56fe\u5f62\u8bbe\u7f6e\u3002]"}, {"question": "\u5982\u4f55\u57283D\u6b7b\u4ea1\u7ade\u901f\u6e38\u620f\u4e2d\u89e3\u9501\u9690\u85cf\u5173\u5361\uff1f", "answer": "\u57283D\u6b7b\u4ea1\u7ade\u901f\u6e38\u620f\u4e2d\uff0c\u901a\u8fc7\u5b8c\u6210\u7279\u5b9a\u6311\u6218\u6216\u6536\u96c6\u7a00\u6709\u7269\u54c1\u6765\u89e3\u9501\u9690\u85cf\u5173\u5361\u3002\u4f8b\u5982\uff0c\u57285\u7ea7\u5173\u5361\u4e2d\u6536\u96c6\u6240\u6709\u786c\u5e01\u53ef\u4ee5\u89e3\u9501\u4e00\u4e2a\u9690\u85cf\u5173\u5361\u3002\u8fd9\u4e9b\u5173\u5361\u901a\u5e38\u5177\u6709\u72ec\u7279\u7684\u969c\u788d\u7269\u548c\u66f4\u9ad8\u7684\u96be\u5ea6\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u9690\u85cf\u5173\u5361\u60f3\u8c61\u6210\u7b49\u5f85\u88ab\u53d1\u73b0\u7684\u5f69\u86cb\u3002]"}, {"question": "3D\u6b7b\u4ea1\u7ade\u901f\u6e38\u620f\u4e2d\u969c\u788d\u7269\u751f\u6210\u7684\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "3D\u6b7b\u4ea1\u7ade\u901f\u6e38\u620f\u4e2d\u969c\u788d\u7269\u7684\u751f\u6210\u57fa\u4e8e\u7a0b\u5e8f\u7b97\u6cd5\uff0c\u4ee5\u786e\u4fdd\u591a\u6837\u6027\u548c\u6311\u6218\u6027\u3002\u6bcf\u4e2a\u5173\u5361\u90fd\u6709\u4e00\u7ec4\u9884\u5b9a\u4e49\u7684\u969c\u788d\u7269\uff0c\u4f46\u5b83\u4eec\u7684\u653e\u7f6e\u5728\u4e00\u5b9a\u7684\u53c2\u6570\u8303\u56f4\u5185\u662f\u968f\u673a\u7684\u3002\u4f8b\u5982\uff0c10\u7ea7\u5173\u5361\u59cb\u7ec8\u5305\u542b\u65cb\u8f6c\u5200\u7247\uff0c\u4f46\u5b83\u4eec\u7684\u65f6\u673a\u548c\u4f4d\u7f6e\u4f1a\u6709\u53d8\u5316\u3002[\u6d41\u7a0b\u56fe\u89e3: \u7b97\u6cd5 \u2192 \u969c\u788d\u7269\u6c60 \u2192 \u968f\u673a\u653e\u7f6e \u2192 \u5173\u5361\u8bbe\u8ba1]"}, {"question": "\u5982\u4f55\u4f18\u5316\u6211\u7684\u8bbe\u5907\u8bbe\u7f6e\u4ee5\u83b7\u5f97\u6700\u4f73\u76843D\u6b7b\u4ea1\u7ade\u901f\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u4e3a\u4e86\u4f18\u5316\u4f60\u7684\u8bbe\u5907\u4ee5\u83b7\u5f97\u6700\u4f73\u76843D\u6b7b\u4ea1\u7ade\u901f\u6e38\u620f\u4f53\u9a8c\uff0c\u9996\u5148\u786e\u4fdd\u4f60\u7684\u64cd\u4f5c\u7cfb\u7edf\u5df2\u66f4\u65b0\u3002\u5982\u679c\u9047\u5230\u5ef6\u8fdf\uff0c\u8bf7\u964d\u4f4e\u56fe\u5f62\u8bbe\u7f6e\uff0c\u5e76\u5173\u95ed\u540e\u53f0\u5e94\u7528\u7a0b\u5e8f\u4ee5\u91ca\u653e\u5185\u5b58\u3002\u4f8b\u5982\uff0c\u5728\u8f83\u65e7\u7684\u8bbe\u5907\u4e0a\uff0c\u964d\u4f4e\u5206\u8fa8\u7387\u53ef\u4ee5\u63d0\u9ad8\u5e27\u901f\u7387\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u9ad8\u8bbe\u7f6e\uff1a60 \u5e27/\u79d2\uff0c\u4e2d\u7b49\uff1a45 \u5e27/\u79d2\uff0c\u4f4e\uff1a30 \u5e27/\u79d2\u3002]"}, {"question": "3D\u6b7b\u4ea1\u7ade\u901f\u6e38\u620f\u4e2d\u54ea\u4e9b\u969c\u788d\u7269\u6700\u5177\u6311\u6218\u6027\uff0c\u4ee5\u53ca\u5982\u4f55\u514b\u670d\u5b83\u4eec\uff1f", "answer": "3D\u6b7b\u4ea1\u7ade\u901f\u6e38\u620f\u4e2d\u6700\u5177\u6311\u6218\u6027\u7684\u969c\u788d\u7269\u5305\u62ec\u65cb\u8f6c\u5200\u7247\u3001\u79fb\u52a8\u5e73\u53f0\u548c\u6fc0\u5149\u675f\u3002\u8981\u514b\u670d\u5b83\u4eec\uff0c\u9700\u8981\u4e13\u6ce8\u4e8e\u65f6\u673a\u548c\u7cbe\u786e\u5ea6\u3002\u5bf9\u4e8e\u65cb\u8f6c\u5200\u7247\uff0c\u7b49\u5f85\u95f4\u9699\u540e\u518d\u8df3\u8dc3\u3002\u5bf9\u4e8e\u79fb\u52a8\u5e73\u53f0\uff0c\u5c06\u4f60\u7684\u8df3\u8dc3\u4e0e\u5b83\u4eec\u7684\u79fb\u52a8\u5bf9\u9f50\u3002\u4f8b\u5982\uff0c\u572840\u7ea7\u5173\u5361\u4e2d\uff0c\u5c06\u4f60\u7684\u8df3\u8dc3\u4e0e\u6fc0\u5149\u675f\u7684\u6fc0\u6d3b\u65f6\u95f4\u540c\u6b65\u53ef\u4ee5\u907f\u514d\u5931\u8d25\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u4e00\u4e9b\u73a9\u5bb6\u66f4\u559c\u6b22\u8bb0\u5fc6\uff0c\u800c\u53e6\u4e00\u4e9b\u73a9\u5bb6\u5219\u4f9d\u8d56\u5feb\u901f\u53cd\u5e94\u3002]"}]
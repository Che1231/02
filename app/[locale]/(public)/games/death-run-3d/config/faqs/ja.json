[{"question": "Death Run 3D\u306e\u521d\u5fc3\u8005\u5411\u3051\u57fa\u672c\u64cd\u4f5c\u306f\u3069\u306e\u3088\u3046\u306b\u884c\u3044\u307e\u3059\u304b\uff1f", "answer": "Death Run 3D\u3067\u306f\u3001\u969c\u5bb3\u7269\u3092\u56de\u907f\u3059\u308b\u305f\u3081\u306b\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u304c\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u524d\u9032\u3059\u308b\u306b\u306f\u3001\u753b\u9762\u3092\u4e0a\u306b\u30b9\u30ef\u30a4\u30d7\u3057\u307e\u3059\u3002\u5de6\u53f3\u306b\u30b9\u30ef\u30a4\u30d7\u3057\u3066\u6a2a\u79fb\u52d5\u3057\u3001\u4e0b\u306b\u30b9\u30ef\u30a4\u30d7\u3057\u3066\u3057\u3083\u304c\u307f\u8fbc\u307f\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u4f4e\u3044\u969c\u5bb3\u7269\u306b\u8fd1\u3065\u3044\u3066\u3044\u308b\u3068\u304d\u306f\u3001\u4e0b\u306b\u30b9\u30ef\u30a4\u30d7\u3059\u308b\u3053\u3068\u3067\u969c\u5bb3\u7269\u3092\u56de\u907f\u3067\u304d\u307e\u3059\u3002\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30ec\u30d9\u30eb\u3067\u3053\u308c\u3089\u306e\u30b8\u30a7\u30b9\u30c1\u30e3\u30fc\u3092\u5b9f\u8df5\u3057\u3066\u3001\u7b4b\u8089\u8a18\u61b6\u3092\u69cb\u7bc9\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u4f8b\u3048\uff1a\u753b\u9762\u3092\u30b9\u30c6\u30a2\u30ea\u30f3\u30b0\u30db\u30a4\u30fc\u30eb\u3068\u8003\u3048\u3001\u5404\u30b9\u30ef\u30a4\u30d7\u306f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u52d5\u304d\u3092\u6307\u793a\u3057\u307e\u3059\u3002]"}, {"question": "Death Run 3D\u306e\u9ad8\u5ea6\u306a\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u305f\u3081\u306e\u6700\u9069\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Death Run 3D\u306e\u9ad8\u5ea6\u306a\u30ec\u30d9\u30eb\u3067\u306f\u3001\u6b63\u78ba\u6027\u3068\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u6c42\u3081\u3089\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff11\uff1a\u30ec\u30d9\u30eb\u3092\u4f55\u5ea6\u3082\u3084\u308a\u76f4\u3057\u3066\u969c\u5bb3\u7269\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u7814\u7a76\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff12\uff1a\u30ea\u30ba\u30e0\u306b\u96c6\u4e2d\u3057\u307e\u3059\u3002\u591a\u304f\u306e\u969c\u5bb3\u7269\u306f\u97f3\u697d\u3084\u4e00\u5b9a\u306e\u30ea\u30ba\u30e0\u306b\u5408\u308f\u305b\u3066\u914d\u7f6e\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff13\uff1a\u76fe\u306a\u3069\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u3092\u6226\u7565\u7684\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb20\u3067\u306f\u3001\u97f3\u697d\u306b\u5408\u308f\u305b\u3066\u30b8\u30e3\u30f3\u30d7\u3059\u308b\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5408\u308f\u305b\u308b\u3053\u3068\u304c\u56de\u8ee2\u3059\u308b\u30d6\u30ec\u30fc\u30c9\u3092\u30af\u30ea\u30a2\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u3044\u304f\u3064\u304b\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u6697\u8a18\u3092\u597d\u307f\u3001\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u7d20\u65e9\u3044\u53cd\u5fdc\u529b\u306b\u983c\u3063\u3066\u3044\u307e\u3059\u3002]"}, {"question": "Death Run 3D\u3067\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u969c\u5bb3\u7269\u3092\u30b8\u30e3\u30f3\u30d7\u3067\u304d\u306a\u3044\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "Death Run 3D\u3067\u30b8\u30e3\u30f3\u30d7\u306b\u5931\u6557\u3059\u308b\u539f\u56e0\u306f\u3001\u30b9\u30ef\u30a4\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u9593\u9055\u3063\u3066\u3044\u308b\u304b\u3001\u30c7\u30d0\u30a4\u30b9\u306e\u611f\u5ea6\u304c\u60aa\u3044\u5834\u5408\u304c\u591a\u3044\u3067\u3059\u3002\u610f\u56f3\u7684\u306a\u30b9\u30ef\u30a4\u30d7\u3092\u884c\u3044\u3001\u65e9\u3059\u304e\u306a\u3044\u3088\u3046\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f4e\u30a8\u30f3\u30c9\u30c7\u30d0\u30a4\u30b9\u3092\u4f7f\u7528\u3057\u3066\u3044\u308b\u5834\u5408\u306f\u3001\u5fdc\u7b54\u6027\u3092\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u306b\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3092\u4e0b\u3052\u308b\
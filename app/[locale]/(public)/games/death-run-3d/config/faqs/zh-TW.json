[{"question": "\u5165\u9580\u8005\u5982\u4f55\u5728\u300a\u6b7b\u4ea1\u5954\u99b3 3D\u300b\u4e2d\u57f7\u884c\u57fa\u672c\u52d5\u4f5c\uff1f", "answer": "\u5728\u300a\u6b7b\u4ea1\u5954\u99b3 3D\u300b\u4e2d\uff0c\u57fa\u672c\u52d5\u4f5c\u5c0d\u65bc\u7a7f\u68ad\u969c\u7919\u7269\u81f3\u95dc\u91cd\u8981\u3002\u8981\u524d\u9032\uff0c\u8acb\u5728\u87a2\u5e55\u4e0a\u5411\u4e0a\u6ed1\u52d5\u3002\u8981\u5411\u5de6\u6216\u5411\u53f3\u79fb\u52d5\uff0c\u8acb\u5411\u5de6\u6216\u5411\u53f3\u6ed1\u52d5\uff1b\u8981\u8e72\u4e0b\uff0c\u8acb\u5411\u4e0b\u6ed1\u52d5\u3002\u4f8b\u5982\uff0c\u5728\u63a5\u8fd1\u4f4e\u77ee\u969c\u7919\u7269\u6642\uff0c\u5411\u4e0b\u6ed1\u52d5\u53ef\u4ee5\u5e6b\u52a9\u60a8\u907f\u958b\u5b83\u3002\u8acb\u5728\u6559\u5b78\u95dc\u5361\u7df4\u7fd2\u9019\u4e9b\u624b\u52e2\uff0c\u5efa\u7acb\u808c\u8089\u8a18\u61b6\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4e00\u4e0b\u87a2\u5e55\u5c31\u50cf\u65b9\u5411\u76e4\uff0c\u6bcf\u6b21\u6ed1\u52d5\u90fd\u6703\u5f15\u5c0e\u60a8\u7684\u89d2\u8272\u3002]"}, {"question": "\u5728\u300a\u6b7b\u4ea1\u5954\u99b3 3D\u300b\u4e2d\u5b8c\u6210\u9ad8\u7d1a\u95dc\u5361\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u300a\u6b7b\u4ea1\u5954\u99b3 3D\u300b\u4e2d\u7684\u9ad8\u7d1a\u95dc\u5361\u9700\u8981\u7cbe\u78ba\u548c\u6642\u9593\u638c\u63a7\u3002\u6b65\u9a5f\u4e00\uff1a\u900f\u904e\u53cd\u8986\u91cd\u73a9\u95dc\u5361\u4f86\u7814\u7a76\u969c\u7919\u7269\u6a21\u5f0f\u3002\u6b65\u9a5f\u4e8c\uff1a\u5c08\u6ce8\u65bc\u7bc0\u594f\uff1b\u8a31\u591a\u969c\u7919\u7269\u90fd\u8207\u97f3\u6a02\u6216\u4e00\u81f4\u7684\u7bc0\u62cd\u540c\u6b65\u3002\u6b65\u9a5f\u4e09\uff1a\u7b56\u7565\u6027\u5730\u4f7f\u7528\u80fd\u529b\uff0c\u4f8b\u5982\u76fe\u724c\u4f86\u907f\u958b\u4e00\u500b\u969c\u7919\u7269\u3002\u4f8b\u5982\uff0c\u5728 20 \u95dc\uff0c\u5c07\u60a8\u7684\u8df3\u8e8d\u8207\u97f3\u6a02\u540c\u6b65\u53ef\u4ee5\u5e6b\u52a9\u60a8\u6e05\u9664\u65cb\u8f49\u7684\u5200\u7247\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u6709\u4e9b\u73a9\u5bb6\u504f\u597d\u8a18\u61b6\uff0c\u800c\u53e6\u4e00\u4e9b\u73a9\u5bb6\u5247\u4f9d\u8cf4\u5feb\u901f\u53cd\u61c9\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u7684\u89d2\u8272\u6709\u6642\u5728\u300a\u6b7b\u4ea1\u5954\u99b3 3D\u300b\u4e2d\u8df3\u904e\u969c\u7919\u7269\u6642\u6703\u5931\u6557\uff1f", "answer": "\u5728\u300a\u6b7b\u4ea1\u5954\u99b3 3D\u300b\u4e2d\u8df3\u8e8d\u5931\u6557\u901a\u5e38\u662f\u4f86\u81ea\u6ed1\u52d5\u6642\u9593\u4e0d\u6b63\u78ba\u6216\u88dd\u7f6e\u611f\u61c9\u5ea6\u554f\u984c\u3002\u8acb\u78ba\u4fdd\u60a8\u7684\u6ed1\u52d5\u52d5\u4f5c\u660e\u78ba\u4e14\u4e0d\u904e\u65bc\u8fc5\u901f\u3002\u5982\u679c\u4f7f\u7528\u4f4e\u968e\u88dd\u7f6e\uff0c\u8acb\u8003\u616e\u964d\u4f4e\u5716\u5f62\u8a2d\u5b9a\u4ee5\u6539\u5584\u53cd\u61c9\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u5728 15 \u95dc\uff0c\u6ed1\u52d5\u904e\u65e9\u6216\u904e\u665a\u6703\u5c0e\u81f4\u60a8\u7684\u89d2\u8272\u932f\u904e\u5e73\u53f0\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u9ad8\u968e\u88dd\u7f6e\u7684\u6210\u529f\u7387\u70ba 95%\uff0c\u800c\u4f4e\u968e\u88dd\u7f6e\u5247\u4e0b\u964d\u5230 75%\u3002]"}, {"question": "\u300a\u6b7b\u4ea1\u5954\u99b3 3D\u300b\u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u4ee5\u53ca\u4ec0\u9ebc\u6703\u5f71\u97ff\u5b83\uff1f", "answer": "\u300a\u6b7b\u4ea1\u5954\u99b3 3D\u300b\u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u884c\u9032\u8ddd\u96e2\u3001\u6536\u96c6\u7684\u786c\u5e63\u548c\u9023\u64ca\u500d\u6578\u3002\u60a8\u8dd1\u904e\u7684\u6bcf\u4e00\u500b\u516c\u5c3a\u90fd\u6703\u589e\u52a0\u60a8\u7684\u5f97\u5206\uff0c\u800c\u786c\u5e63\u5247\u63d0\u4f9b\u984d\u5916\u7a4d\u5206\u3002\u9023\u64ca\u662f\u900f\u904e\u5feb\u901f\u9023\u7e8c\u6536\u96c6\u591a\u500b\u786c\u5e63\u4f86\u5be6\u73fe\u7684\u3002\u4f8b\u5982\uff0c\u5728 10 \u95dc\uff0c\u9023\u7e8c\u6536\u96c6\u4e09\u500b\u786c\u5e63\u53ef\u4ee5\u5c07\u8a72\u5340\u6bb5\u7684\u5f97\u5206\u52a0\u500d\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u8ddd\u96e2 \u2192 \u786c\u5e63 \u2192 \u9023\u64ca \u2192 \u7e3d\u5206]"}, {"question": "\u300a\u6b7b\u4ea1\u5954\u99b3 3D\u300b\u4e2d\u54ea\u4e9b\u80fd\u529b\u6700\u6709\u6548\uff0c\u4ee5\u53ca\u4f55\u6642\u61c9\u8a72\u4f7f\u7528\u5b83\u5011\uff1f", "answer": "\u300a\u6b7b\u4ea1\u5954\u99b3 3D\u300b\u4e2d\u6700\u6709\u6548\u7684\u80fd\u529b\u662f\u76fe\u724c\u3001\u78c1\u9435\u548c\u52a0\u901f\u3002\u4f7f\u7528\u76fe\u724c\u4f86\u907f\u958b\u4e00\u500b\u969c\u7919\u7269\uff0c\u4f7f\u7528\u78c1\u9435\u81ea\u52d5\u6536\u96c6\u786c\u5e63\uff0c\u4f7f\u7528\u52a0\u901f\u4f86\u5feb\u901f\u8986\u84cb\u66f4\u591a\u8ddd\u96e2\u3002\u4f8b\u5982\uff0c\u5728 25 \u95dc\uff0c\u5728\u4e00\u6bb5\u5f88\u9577\u7684\u8ddd\u96e2\u4e4b\u524d\u555f\u52d5\u52a0\u901f\u53ef\u4ee5\u5e6b\u52a9\u60a8\u907f\u958b\u591a\u500b\u969c\u7919\u7269\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u76fe\u724c\u6700\u9069\u5408\u7cbe\u6e96\u5ea6\uff0c\u800c\u52a0\u901f\u6700\u9069\u5408\u5feb\u901f\u901a\u95dc\u3002]"}, {"question": "\u5728\u884c\u52d5\u88dd\u7f6e\u548c PC \u5e73\u53f0\u4e0a\uff0c\u300a\u6b7b\u4ea1\u5954\u99b3 3D\u300b\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "\u300a\u6b7b\u4ea1\u5954\u99b3 3D\u300b\u5728\u884c\u52d5\u88dd\u7f6e\u548c PC \u5e73\u53f0\u4e0a\u7684\u4e3b\u8981\u5dee\u7570\u5305\u62ec\u63a7\u5236\u65b9\u5f0f\u3001\u5716\u5f62\u548c\u6548\u80fd\u3002\u884c\u52d5\u88dd\u7f6e\u4f7f\u7528\u89f8\u63a7\u624b\u52e2\uff0c\u800c PC \u5247\u4f9d\u8cf4\u9375\u76e4\u8f38\u5165\u3002PC \u7248\u672c\u901a\u5e38\u5177\u6709\u66f4\u9ad8\u7684\u5716\u5f62\u8a2d\u5b9a\u548c\u66f4\u6d41\u66a2\u7684\u6548\u80fd\u3002\u4f8b\u5982\uff0c30 \u95dc\u7684 PC \u7248\u672c\u5177\u6709\u589e\u5f37\u7684\u7d0b\u7406\u548c\u7167\u660e\u6548\u679c\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u884c\u52d5\u88dd\u7f6e\uff1a\u89f8\u63a7\u63a7\u5236\uff0c\u4e2d\u7b49\u5716\u5f62\u3002PC\uff1a\u9375\u76e4\u63a7\u5236\uff0c\u9ad8\u5716\u5f62\u3002]"}, {"question": "\u5982\u4f55\u89e3\u9396\u300a\u6b7b\u4ea1\u5954\u99b3 3D\u300b\u4e2d\u7684\u96b1\u85cf\u95dc\u5361\uff1f", "answer": "\u300a\u6b7b\u4ea1\u5954\u99b3 3D\u300b\u4e2d\u7684\u96b1\u85cf\u95dc\u5361\u662f\u900f\u904e\u5b8c\u6210\u7279\u5b9a\u6311\u6230\u6216\u6536\u96c6\u7a00\u6709\u7269\u54c1\u4f86\u89e3\u9396\u7684\u3002\u4f8b\u5982\uff0c\u5728 5 \u95dc\u6536\u96c6\u6240\u6709\u786c\u5e63\u5373\u53ef\u89e3\u9396\u4e00\u500b\u79d8\u5bc6\u95dc\u5361\u3002\u9019\u4e9b\u95dc\u5361\u901a\u5e38\u5177\u6709\u7368\u7279\u7684\u969c\u7919\u7269\u548c\u66f4\u9ad8\u7684\u96e3\u5ea6\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u96b1\u85cf\u95dc\u5361\u5c31\u50cf\u7b49\u5f85\u88ab\u767c\u73fe\u7684\u5f69\u86cb\u3002]"}, {"question": "\u300a\u6b7b\u4ea1\u5954\u99b3 3D\u300b\u4e2d\u969c\u7919\u7269\u7522\u751f\u6a5f\u5236\u80cc\u5f8c\u7684\u539f\u7406\u662f\u4ec0\u9ebc\uff1f", "answer": "\u300a\u6b7b\u4ea1\u5954\u99b3 3D\u300b\u4e2d\u7684\u969c\u7919\u7269\u7522\u751f\u662f\u57fa\u65bc\u7a0b\u5e8f\u6f14\u7b97\u6cd5\uff0c\u78ba\u4fdd\u591a\u6a23\u6027\u548c\u6311\u6230\u6027\u3002\u6bcf\u500b\u95dc\u5361\u90fd\u6709\u9810\u5b9a\u7fa9\u7684\u4e00\u7d44\u969c\u7919\u7269\uff0c\u4f46\u5b83\u5011\u7684\u653e\u7f6e\u4f4d\u7f6e\u5728\u7279\u5b9a\u53c3\u6578\u5167\u662f\u96a8\u6a5f\u7684\u3002\u4f8b\u5982\uff0c10 \u95dc\u59cb\u7d42\u5305\u542b\u65cb\u8f49\u7684\u5200\u7247\uff0c\u4f46\u5176\u6642\u9593\u548c\u4f4d\u7f6e\u6703\u6709\u6240\u4e0d\u540c\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u6f14\u7b97\u6cd5 \u2192 \u969c\u7919\u7269\u6c60 \u2192 \u96a8\u6a5f\u653e\u7f6e \u2192 \u95dc\u5361\u8a2d\u8a08]"}, {"question": "\u5982\u4f55\u512a\u5316\u6211\u7684\u88dd\u7f6e\u8a2d\u5b9a\uff0c\u4ee5\u7372\u5f97\u6700\u4f73\u7684\u300a\u6b7b\u4ea1\u5954\u99b3 3D\u300b\u9ad4\u9a57\uff1f", "answer": "\u8981\u512a\u5316\u60a8\u7684\u88dd\u7f6e\u4ee5\u7372\u5f97\u6700\u4f73\u7684\u300a\u6b7b\u4ea1\u5954\u99b3 3D\u300b\u9ad4\u9a57\uff0c\u8acb\u5148\u78ba\u4fdd\u60a8\u7684\u4f5c\u696d\u7cfb\u7d71\u5df2\u66f4\u65b0\u3002\u5982\u679c\u51fa\u73fe\u5ef6\u9072\uff0c\u8acb\u964d\u4f4e\u5716\u5f62\u8a2d\u5b9a\uff0c\u4e26\u95dc\u9589\u80cc\u666f\u61c9\u7528\u7a0b\u5f0f\u4ee5\u91cb\u653e\u8a18\u61b6\u9ad4\u3002\u4f8b\u5982\uff0c\u5728\u820a\u88dd\u7f6e\u4e0a\uff0c\u6e1b\u5c11\u89e3\u6790\u5ea6\u53ef\u4ee5\u6539\u5584\u756b\u9762\u66f4\u65b0\u7387\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u9ad8\u8a2d\u5b9a\uff1a60 FPS\uff0c\u4e2d\u8a2d\u5b9a\uff1a45 FPS\uff0c\u4f4e\u8a2d\u5b9a\uff1a30 FPS\u3002]"}, {"question": "\u300a\u6b7b\u4ea1\u5954\u99b3 3D\u300b\u4e2d\u6700\u5177\u6311\u6230\u6027\u7684\u969c\u7919\u7269\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5982\u4f55\u514b\u670d\u5b83\u5011\uff1f", "answer": "\u300a\u6b7b\u4ea1\u5954\u99b3 3D\u300b\u4e2d\u6700\u5177\u6311\u6230\u6027\u7684\u969c\u7919\u7269\u5305\u62ec\u65cb\u8f49\u5200\u7247\u3001\u79fb\u52d5\u5e73\u53f0\u548c\u96f7\u5c04\u675f\u3002\u8981\u514b\u670d\u5b83\u5011\uff0c\u8acb\u5c08\u6ce8\u65bc\u6642\u9593\u548c\u7cbe\u6e96\u5ea6\u3002\u5c0d\u65bc\u65cb\u8f49\u5200\u7247\uff0c\u8acb\u7b49\u5f85\u7e2b\u9699\u518d\u8df3\u8e8d\u3002\u5c0d\u65bc\u79fb\u52d5\u5e73\u53f0\uff0c\u8acb\u5c07\u60a8\u7684\u8df3\u8e8d\u8207\u5b83\u5011\u7684\u79fb\u52d5\u5c0d\u9f4a\u3002\u4f8b\u5982\uff0c\u5728 40 \u95dc\uff0c\u5c07\u60a8\u7684\u8df3\u8e8d\u8207\u96f7\u5c04\u675f\u7684\u555f\u52d5\u6642\u9593\u540c\u6b65\u53ef\u4ee5\u907f\u514d\u5931\u6557\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u6709\u4e9b\u73a9\u5bb6\u504f\u597d\u8a18\u61b6\uff0c\u800c\u53e6\u4e00\u4e9b\u73a9\u5bb6\u5247\u4f9d\u8cf4\u5feb\u901f\u53cd\u61c9\u3002]"}]
[{"question": "\ud788\uc5b4\ub85c \uc6cc\uc988\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \uc601\uc6c5 \ub808\ubca8\uc744 \ube60\ub974\uac8c \uc62c\ub9ac\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud788\uc5b4\ub85c \uc6cc\uc988\uc5d0\uc11c \uc601\uc6c5 \ub808\ubca8\uc744 \ube60\ub974\uac8c \uc62c\ub9ac\ub824\uba74, \ub9e4\uc77c \ud018\uc2a4\ud2b8\uc640 \ucea0\ud398\uc778 \uc784\ubb34\ub97c \uc644\ub8cc\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. STEP1: \uacbd\ud5d8\uce58 \ud3ec\uc158\uc744 \uc81c\uacf5\ud558\ub294 \uc784\ubb34\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \uc644\ub8cc\ud558\uc2ed\uc2dc\uc624. STEP2: \uc601\uc6c5 \ud2b9\uc815 \uc544\uc774\ud15c\uc744 \ub4dc\ub86d\ud558\ub294 \ub2e8\uacc4\uc5d0 \uc5d0\ub108\uc9c0\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. STEP3: \ucd94\uac00 \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud558\ub294 '\uc601\uc6c5 \uc0c1\uc790'\uc640 \uac19\uc740 \uc774\ubca4\ud2b8\uc5d0 \ucc38\uc5ec\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\uc5b4\ub460 \ucea0\ud398\uc778'\uc744 \uc644\ub8cc\ud558\uba74 \uc0c1\ub2f9\ud55c \uacbd\ud5d8\uce58\uc640 \uc790\uc6d0\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud788\uc5b4\ub85c \uc6cc\uc988 \ucd08\ubc18 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \ucd5c\uace0\uc758 \ud300 \uad6c\uc131\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ucd08\ubc18 \ud50c\ub808\uc774\uc5b4\ub294 \uade0\ud615 \uc7a1\ud78c \ud300 \uad6c\uc131\uc5d0 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. \uad8c\uc7a5\ub418\ub294 \uc124\uc815\uc5d0\ub294 \ud0f1\ucee4(\uc608: \uc544\uc2a4\ud0c0\ub85c\uc2a4), \ud790\ub7ec(\uc608: \ud14c\uc544) \ubc0f \ub370\ubbf8\uc9c0\ub51c\ub7ec(\uc608: \ud0a4\ub77c, \uac08\ub77c\ud558\ub4dc)\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc601\uc6c5 \uc5ed\ud560\uacfc \uc2dc\ub108\uc9c0\ub97c \ube44\uad50\ud558\uae30 \uc704\ud55c \uad6c\uc131\ud45c\ub97c \uc0ac\uc6a9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc544\uc2a4\ud0c0\ub85c\uc2a4\uc758 \ubc29\ud328 \ub2a5\ub825\uc740 \ud0a4\ub77c\uc758 \ub192\uc740 \ud53c\ud574\ub7c9 \ucd9c\ub825\uc744 \ubcf4\uc644\ud558\uc5ec \uac15\ub825\ud55c \ub4c0\uc624\ub97c \ub9cc\ub4ed\ub2c8\ub2e4."}, {"question": "\ud788\uc5b4\ub85c \uc6cc\uc988\uc5d0\uc11c \uae38\ub4dc\uc5d0 \uac00\uc785\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\uc640 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc5b4\ub5a4 \uc774\uc810\uc744 \uc81c\uacf5\ud569\ub2c8\uae4c?", "answer": "\ud788\uc5b4\ub85c \uc6cc\uc988\uc5d0\uc11c \uae38\ub4dc\uc5d0 \uac00\uc785\ud558\uba74 \uae38\ub4dc \uc804\uc7c1, \uacf5\uc720 \uc790\uc6d0 \ubc0f \ud611\ub3d9 \ud50c\ub808\uc774\ub97c \uc774\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \uae38\ub4dc \ud65c\ub3d9\uc5d0 \ucc38\uc5ec\ud558\uc5ec \uae38\ub4dc \ucf54\uc778\uc744 \ud68d\ub4dd\ud558\uc2ed\uc2dc\uc624. STEP2: \uc774 \ucf54\uc778\uc744 \uc0ac\uc6a9\ud558\uc5ec \uae38\ub4dc \uc0c1\uc810\uc5d0\uc11c \ud76c\uadc0 \uc544\uc774\ud15c\uc744 \uad6c\uc785\ud558\uc2ed\uc2dc\uc624. STEP3: \uae38\ub4dc \ud68c\uc6d0\ub4e4\uacfc \ud611\ub825\ud558\uc5ec \uace0\ub09c\uc774\ub3c4 \ub358\uc804\uc744 \uacf5\ub7b5\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uae38\ub4dc \uc804\uc7c1\uc740 \ud76c\uadc0\ud55c \uc544\ud2f0\ud329\ud2b8\uc640 \uc601\uc6c5 \uc870\uac01\uacfc \uac19\uc740 \uc0c1\ub2f9\ud55c \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud788\uc5b4\ub85c \uc6cc\uc988 PvP \uc804\ud22c\uc5d0\uc11c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \uc601\uc6c5 \ub2a5\ub825\uc740 \ubb34\uc5c7\uc774\uba70, \uadf8 \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "PvP \uc804\ud22c\uc5d0\uc11c\ub294 \uc801 \uc9c4\ud615\uc744 \ubc29\ud574\ud558\uac70\ub098 \uad70\uc911 \uc81c\uc5b4\ub97c \uc81c\uacf5\ud558\ub294 \ub2a5\ub825\uc774 \ub9e4\uc6b0 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. \uc694\ub974\uac90(\uc5d0\ub108\uc9c0 \uc870\uc791)\uacfc \ub124\ubdf8\ub77c(\ub3d9\ub9f9 \uac15\ud654)\uc640 \uac19\uc740 \uc601\uc6c5\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \ub2a5\ub825 \uc0c1\ud638\uc791\uc6a9\uc744 \ub9e4\ud551\ud558\uae30 \uc704\ud55c \ud50c\ub85c\uc6b0\ucc28\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc694\ub974\uac90\uc758 '\ud761\ud608' \ub2a5\ub825\uc740 \uc801\uc758 \uc5d0\ub108\uc9c0\ub97c \ud761\uc218\ud558\uc5ec \ucd5c\ud6c4\uc758 \uae30\uc220\uc744 \uc0ac\uc6a9\ud558\uc9c0 \ubabb\ud558\uac8c \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud788\uc5b4\ub85c \uc6cc\uc988\uc758 \uc544\ud2f0\ud329\ud2b8 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud788\uc5b4\ub85c \uc6cc\uc988\uc5d0\uc11c \uc544\ud2f0\ud329\ud2b8\ub294 \uc601\uc6c5\uc758 \uc2a4\ud0ef\uc744 \uac15\ud654\ud558\uace0 \uace0\uc720\ud55c \ub2a5\ub825\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. STEP1: \ucea0\ud398\uc778 \uc784\ubb34\uc640 \uc774\ubca4\ud2b8\uc5d0\uc11c \uc544\ud2f0\ud329\ud2b8 \uc870\uac01\uc744 \uc218\uc9d1\ud558\uc2ed\uc2dc\uc624. STEP2: \uace8\ub4dc\uc640 \uc870\uac01\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc544\ud2f0\ud329\ud2b8\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc2ed\uc2dc\uc624. STEP3: \uc601\uc6c5\uc758 \uc5ed\ud560\uc5d0 \ubcf4\uc644\uc801\uc778 \uc544\ud2f0\ud329\ud2b8\ub97c \uc7a5\ucc29\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\uc608\uc5b8\uc758 \ucc45' \uc544\ud2f0\ud329\ud2b8\ub294 \ub9c8\ubc95 \uacf5\uaca9\uc744 \uc99d\uac00\uc2dc\ucf1c \uc624\ub9ac\uc628\uacfc \uac19\uc740 \ub9c8\ubc95 \uc601\uc6c5\uc5d0\uac8c \uc774\uc0c1\uc801\uc785\ub2c8\ub2e4."}, {"question": "\ud788\uc5b4\ub85c \uc6cc\uc988\uc5d0\uc11c \uc790\uc6d0 \ud6a8\uc728\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5a4 \uc804\ub7b5\uc744 \uc0ac\uc6a9\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\uc790\uc6d0 \ud6a8\uc728\uc744 \uadf9\ub300\ud654\ud558\ub824\uba74 \uc2e0\uc911\ud55c \uacc4\ud68d\uacfc \uc6b0\uc120\uc21c\uc704 \uc9c0\uc815\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \uc790\uc6d0\uc744 \ub0ad\ube44\ud558\uc9c0 \uc54a\uace0 \ud575\uc2ec \uc601\uc6c5\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. STEP2: \ub354\ube14 \uacbd\ud5d8\uce58 \uc774\ubca4\ud2b8 \ub3d9\uc548 \ubcf4\uc11d\uc744 \uc5d0\ub108\uc9c0 \uc7ac\ucda9\uc804\uc5d0 \uc800\uc7a5\ud558\uc2ed\uc2dc\uc624. STEP3: '\uc0c1\uc778'\uc744 \uc774\uc6a9\ud558\uc5ec \ucd08\uacfc \uc544\uc774\ud15c\uc744 \ud544\uc694\ud55c \uc790\uc6d0\uacfc \uad50\ud658\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc800\ud2f0\uc5b4 \uc544\uc774\ud15c\uc744 \uace0\ud2f0\uc5b4 \uc544\uc774\ud15c\uacfc \uad50\ud658\ud558\uba74 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc0c1\ub2f9\ud788 \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ud788\uc5b4\ub85c \uc6cc\uc988\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\ub824\uba74 \uacc4\uc815\uc774 \uc18c\uc15c \ubbf8\ub514\uc5b4 \ub610\ub294 \uc774\uba54\uc77c \uacc4\uc815\uacfc \uc5f0\uacb0\ub418\uc5b4 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. STEP1: '\uc124\uc815' \uba54\ub274\ub85c \uc774\ub3d9\ud558\uc5ec '\uacc4\uc815'\uc744 \uc120\ud0dd\ud558\uc2ed\uc2dc\uc624. STEP2: Facebook, Google \ub610\ub294 Apple ID\uc5d0 \uacc4\uc815\uc744 \uc5f0\uacb0\ud558\uc2ed\uc2dc\uc624. STEP3: \ub3d9\uc77c\ud55c \uc790\uaca9 \uc99d\uba85\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc0c8 \ud50c\ub7ab\ud3fc\uc5d0 \ub85c\uadf8\uc778\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, Facebook\uc5d0 \uc5f0\uacb0\ud558\uba74 Android \ubc0f iOS \uae30\uae30 \uac04\uc5d0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc6d0\ud65c\ud558\uac8c \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud788\uc5b4\ub85c \uc6cc\uc988\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 \uc885\uc885 \uac04\uacfc\ud558\ub294 \uc228\uaca8\uc9c4 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc228\uaca8\uc9c4 \uba54\ucee4\ub2c8\uc998\uc5d0\ub294 '\uc5d0\ub108\uc9c0 \uacfc\uc789' \uc2dc\uc2a4\ud15c\uacfc '\uc601\uc6c5 \uc2dc\ub108\uc9c0' \ubcf4\ub108\uc2a4\uac00 \ud3ec\ud568\ub429\ub2c8\ub2e4. STEP1: \uc0ac\uc6a9\ub418\uc9c0 \uc54a\uc740 \uc5d0\ub108\uc9c0\uac00 \ub2e4\uc74c \ub0a0\uc758 \uc81c\ud55c\ub7c9\uc73c\ub85c \ub118\uce60 \uc218 \uc788\ub2e4\ub294 \uac83\uc744 \uc774\ud574\ud558\uc2ed\uc2dc\uc624. STEP2: \ud5a5\uc0c1\ub41c \uc131\ub2a5\uc744 \uc704\ud574 \uc2dc\ub108\uc9c0 \ud6a8\uacfc\uac00 \uc788\ub294 \uc601\uc6c5\uc744 \uc30d\uc73c\ub85c \uad6c\uc131\ud558\uc2ed\uc2dc\uc624. STEP3: '\ub3c4\uc11c\uad00'\uc744 \ud0d0\uc0c9\ud558\uc5ec \uc228\uaca8\uc9c4 \uc2a4\ud0ef\uacfc \ubcf4\ub108\uc2a4\ub97c \ud574\uc81c\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc544\uc2a4\ud0c0\ub85c\uc2a4\uc640 \ub9c8\uc57c\ub97c \uc30d\uc73c\ub85c \uad6c\uc131\ud558\uba74 \uc989\uc2dc \uba85\ud655\ud558\uc9c0 \uc54a\uc740 \uce58\uc720 \uc2dc\ub108\uc9c0\ub97c \uc720\ubc1c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud788\uc5b4\ub85c \uc6cc\uc988\uc5d0\uc11c '\ud0c0\uc774\ud0c4' \uc2dc\uc2a4\ud15c\uc740 \uc8fc\uc694 \uac8c\uc784\ud50c\ub808\uc774\uc640 \uc5b4\ub5bb\uac8c \ud1b5\ud569\ub429\ub2c8\uae4c?", "answer": "'\ud0c0\uc774\ud0c4' \uc2dc\uc2a4\ud15c\uc740 \uc804\ud22c\uc5d0\uc11c \uc18c\ud658\ud560 \uc218 \uc788\ub294 \uac15\ub825\ud55c \uc720\ub2db\uc744 \ub3c4\uc785\ud558\uc5ec \uc804\ub7b5\uc801 \uc694\uc18c\ub97c \ucd94\uac00\ud569\ub2c8\ub2e4. STEP1: '\ud0c0\uc774\ud0c4 \uacc4\uace1'\uc5d0\uc11c \ud0c0\uc774\ud0c4 \uc601\ud63c\uc744 \uc218\uc9d1\ud558\uc2ed\uc2dc\uc624. STEP2: \ud0c0\uc774\ud0c4 \ud3ec\uc158\uacfc \uc601\ud63c\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud0c0\uc774\ud0c4\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc2ed\uc2dc\uc624. STEP3: \uc804\ud22c\uc5d0 \ud0c0\uc774\ud0c4\uc744 \ubc30\uce58\ud558\uc5ec \ubd84\uc704\uae30\ub97c \ubc14\uafb8\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\ud558\uc774\ud398\ub9ac\uc628' \ud0c0\uc774\ud0c4\uc740 \ub3d9\ub9f9\uc744 \uce58\uc720\ud558\uace0 \ub300\ub7c9\uc758 \ud53c\ud574\ub97c \uc904 \uc218 \uc788\uc5b4 \uc5b4\ub824\uc6b4 \uc804\ud22c\uc5d0\uc11c \uac8c\uc784\uc758 \ubcc0\uc218\uac00 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud788\uc5b4\ub85c \uc6cc\uc988\uc5d0\uc11c \uc5b4\ub5a4 \uac8c\uc784 \ub0b4 \uc774\ubca4\ud2b8\uac00 \uac00\uc7a5 \uc88b\uc740 \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud558\uba70, \uc5b4\ub5bb\uac8c \uc900\ube44\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "'\uc601\uc6c5 \uc0c1\uc790'\uc640 '\ud0c0\uc774\ud0c4 \uc18c\ud658'\uacfc \uac19\uc740 \uc774\ubca4\ud2b8\uac00 \uac00\uc7a5 \uc88b\uc740 \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. STEP1: \uc774\ub7ec\ud55c \uc774\ubca4\ud2b8\ub97c \uc704\ud574 \ubcf4\uc11d\uacfc \uc5d0\ub108\uc9c0 \uc7ac\ucda9\uc804\uacfc \uac19\uc740 \uc790\uc6d0\uc744 \uc800\uc7a5\ud558\uc2ed\uc2dc\uc624. STEP2: \ubcf4\uc0c1\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \uc774\ubca4\ud2b8 \ud2b9\uc815 \ud018\uc2a4\ud2b8\ub97c \uc644\ub8cc\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. STEP3: \uc774\ub7ec\ud55c \uc774\ubca4\ud2b8\uc640 \uc77c\uce58\ud558\ub294 \uae38\ub4dc \ud65c\ub3d9\uc5d0 \ucc38\uc5ec\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\uc601\uc6c5 \uc0c1\uc790' \uc774\ubca4\ud2b8\uc5d0\uc11c \ud76c\uadc0\ud55c \uc601\uc6c5 \uc870\uac01\uacfc \uc544\ud2f0\ud329\ud2b8\ub97c \uc5bb\uc744 \uc218 \uc788\uc73c\ubbc0\ub85c \ub85c\uc2a4\ud130\ub97c \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
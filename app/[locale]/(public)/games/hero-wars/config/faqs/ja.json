[{"question": "\u30d2\u30fc\u30ed\u30fc\u30a6\u30a9\u30fc\u30ba\u3067\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30d2\u30fc\u30ed\u30fc\u3092\u8fc5\u901f\u306b\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d2\u30fc\u30ed\u30fc\u30a6\u30a9\u30fc\u30ba\u3067\u30d2\u30fc\u30ed\u30fc\u3092\u8fc5\u901f\u306b\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u3059\u308b\u306b\u306f\u3001\u30c7\u30a4\u30ea\u30fc\u30af\u30a8\u30b9\u30c8\u3068\u30ad\u30e3\u30f3\u30da\u30fc\u30f3\u30df\u30c3\u30b7\u30e7\u30f3\u306e\u5b8c\u4e86\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d71\uff1aXP\u30dd\u30fc\u30b7\u30e7\u30f3\u3092\u63d0\u4f9b\u3059\u308b\u30df\u30c3\u30b7\u30e7\u30f3\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d2\u30fc\u30ed\u30fc\u56fa\u6709\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u30c9\u30ed\u30c3\u30d7\u3059\u308b\u30b9\u30c6\u30fc\u30b8\u3092\u30bf\u30fc\u30b2\u30c3\u30c8\u306b\u3057\u3066\u3001\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u52b9\u7387\u7684\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u8ffd\u52a0\u5831\u916c\u3092\u5f97\u308b\u305f\u3081\u306b\u300e\u82f1\u96c4\u306e\u5b9d\u7bb1\u300f\u306a\u3069\u306e\u30a4\u30d9\u30f3\u30c8\u306b\u53c2\u52a0\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30c0\u30fc\u30af\u30ad\u30e3\u30f3\u30da\u30fc\u30f3\u300f\u3092\u5b8c\u4e86\u3059\u308b\u3068\u3001\u5927\u304d\u306aXP\u3068\u30ea\u30bd\u30fc\u30b9\u3092\u5f97\u3089\u308c\u307e\u3059\u3002"}, {"question": "\u30d2\u30fc\u30ed\u30fc\u30a6\u30a9\u30fc\u30ba\u306e\u521d\u671f\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u3001\u6700\u9ad8\u306e\u30c1\u30fc\u30e0\u69cb\u6210\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u521d\u671f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u30c1\u30fc\u30e0\u69cb\u6210\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3079\u304d\u3067\u3059\u3002\u63a8\u5968\u3055\u308c\u308b\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7\u306f\u3001\u30bf\u30f3\u30af\uff08\u4f8b\uff1a\u30a2\u30b9\u30bf\u30fc\u30aa\u30b7\uff09\u3001\u30d2\u30fc\u30e9\u30fc\uff08\u4f8b\uff1a\u30c6\u30a3\u30a2\uff09\u3001\u305d\u3057\u3066\u30c0\u30e1\u30fc\u30b8\u30c7\u30a3\u30fc\u30e9\u30fc\uff08\u4f8b\uff1a\u30ad\u30fc\u30e9\u3001\u30ac\u30e9\u30cf\u30c9\uff09\u3092\u542b\u307f\u307e\u3059\u3002\u30d2\u30fc\u30ed\u30fc\u306e\u5f79\u5272\u3068\u30b7\u30ca\u30b8\u30fc\u3092\u6bd4\u8f03\u3059\u308b\u305f\u3081\u306e\u69cb\u6210\u8868\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u30a2\u30b9\u30bf\u30fc\u30aa\u30b7\u306e\u30b7\u30fc\u30eb\u30c9\u80fd\u529b\u306f\u30ad\u30fc\u30e9\u306e\u9ad8\u3044\u30c0\u30e1\u30fc\u30b8\u51fa\u529b\u3068\u76f8\u307e\u3063\u3066\u3001\u5f37\u529b\u306a\u30c7\u30e5\u30aa\u306b\u306a\u308a\u307e\u3059\u3002"}, {"question": "\u30d2\u30fc\u30ed\u30fc\u30a6\u30a9\u30fc\u30ba\u3067\u30ae\u30eb\u30c9\u306b\u53c2\u52a0\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3069\u306e\u3088\u3046\u306a\u5229\u70b9\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30d2\u30fc\u30ed\u30fc\u30a6\u30a9\u30fc\u30ba\u3067\u30ae\u30eb\u30c9\u306b\u53c2\u52a0\u3059\u308b\u3068\u3001\u30ae\u30eb\u30c9\u30a6\u30a9\u30fc\u30ba\u3001\u5171\u6709\u30ea\u30bd\u30fc\u30b9\u3001\u305d\u3057\u3066\u5354\u529b\u30d7\u30ec\u30a4\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30ae\u30eb\u30c9\u6d3b\u52d5\u306b\u53c2\u52a0\u3057\u3066\u30ae\u30eb\u30c9\u30b3\u30a4\u30f3\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u3053\u308c\u3089\u306e\u30b3\u30a4\u30f3\u3092\u4f7f\u7528\u3057\u3066\u3001\u30ae\u30eb\u30c9\u30b7\u30e7\u30c3\u30d7\u304b\u3089\u30ec\u30a2\u30a2\u30a4\u30c6\u30e0\u3092\u8cfc\u5165\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30ae\u30eb\u30c9\u30e1\u30f3\u30d0\u30fc\u3068\u5354\u529b\u3057\u3066\u3001\u9ad8\u30ec\u30d9\u30eb\u306e\u30c0\u30f3\u30b8\u30e7\u30f3\u306b\u7acb\u3061\u5411\u304b\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ae\u30eb\u30c9\u30a6\u30a9\u30fc\u30ba\u3067\u306f\u3001\u30ec\u30a2\u306a\u30a2\u30fc\u30c6\u30a3\u30d5\u30a1\u30af\u30c8\u3084\u30d2\u30fc\u30ed\u30fc\u306e\u7834\u7247\u306e\u3088\u3046\u306a\u91cd\u8981\u306a\u5831\u916c\u3092\u5f97\u3089\u308c\u307e\u3059\u3002"}, {"question": "\u30d2\u30fc\u30ed\u30fc\u30a6\u30a9\u30fc\u30ba\u306ePvP\u6226\u95d8\u3067\u6700\u3082\u52b9\u679c\u7684\u306a\u30d2\u30fc\u30ed\u30fc\u306e\u80fd\u529b\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "PvP\u6226\u95d8\u3067\u306f\u3001\u6575\u306e\u9663\u5f62\u3092\u6df7\u4e71\u3055\u305b\u305f\u308a\u3001\u6575\u5bfe\u7684\u306a\u884c\u52d5\u3092\u8d77\u3053\u3055\u305b\u305f\u308a\u3059\u308b\u80fd\u529b\u304c\u975e\u5e38\u306b\u52b9\u679c\u7684\u3067\u3059\u3002\u30e8\u30eb\u30b2\u30f3\uff08\u30a8\u30cd\u30eb\u30ae\u30fc\u64cd\u4f5c\uff09\u3084\u30cd\u30d3\u30e5\u30e9\uff08\u5473\u65b9\u5897\u5f37\uff09\u306e\u3088\u3046\u306a\u30d2\u30fc\u30ed\u30fc\u304c\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u80fd\u529b\u306e\u76f8\u4e92\u4f5c\u7528\u3092\u30de\u30c3\u30d7\u3059\u308b\u305f\u3081\u306e\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u30e8\u30eb\u30b2\u30f3\u306e\u300e\u30ea\u30fc\u30c1\u300f\u80fd\u529b\u306f\u6575\u306e\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u596a\u3046\u3053\u3068\u304c\u3067\u304d\u3001\u7a76\u6975\u6280\u306e\u4f7f\u7528\u3092\u59a8\u3052\u307e\u3059\u3002"}, {"question": "\u30d2\u30fc\u30ed\u30fc\u30a6\u30a9\u30fc\u30ba\u306e\u30a2\u30fc\u30c6\u30a3\u30d5\u30a1\u30af\u30c8\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u305d\u308c\u3092\u3069\u306e\u3088\u3046\u306b\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d2\u30fc\u30ed\u30fc\u30a6\u30a9\u30fc\u30ba\u306e\u30a2\u30fc\u30c6\u30a3\u30d5\u30a1\u30af\u30c8\u306f\u3001\u30d2\u30fc\u30ed\u30fc\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u5f37\u5316\u3057\u3001\u72ec\u81ea\u306e\u80fd\u529b\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30ad\u30e3\u30f3\u30da\u30fc\u30f3\u30df\u30c3\u30b7\u30e7\u30f3\u3084\u30a4\u30d9\u30f3\u30c8\u304b\u3089\u30a2\u30fc\u30c6\u30a3\u30d5\u30a1\u30af\u30c8\u306e\u7834\u7247\u3092\u96c6\u3081\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b4\u30fc\u30eb\u30c9\u3068\u7834\u7247\u3092\u4f7f\u3063\u3066\u30a2\u30fc\u30c6\u30a3\u30d5\u30a1\u30af\u30c8\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u3042\u306a\u305f\u306e\u30d2\u30fc\u30ed\u30fc\u306e\u5f79\u5272\u3092\u88dc\u5b8c\u3059\u308b\u30a2\u30fc\u30c6\u30a3\u30d5\u30a1\u30af\u30c8\u3092\u88c5\u5099\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u4e88\u8a00\u66f8\u300f\u30a2\u30fc\u30c6\u30a3\u30d5\u30a1\u30af\u30c8\u306f\u9b54\u529b\u306e\u653b\u6483\u529b\u3092\u5411\u4e0a\u3055\u305b\u3001\u30aa\u30e9\u30a4\u30aa\u30f3\u306e\u3088\u3046\u306a\u9b54\u6cd5\u4f7f\u3044\u30d2\u30fc\u30ed\u30fc\u306b\u6700\u9069\u3067\u3059\u3002"}, {"question": "\u30d2\u30fc\u30ed\u30fc\u30a6\u30a9\u30fc\u30ba\u3067\u30ea\u30bd\u30fc\u30b9\u52b9\u7387\u3092\u6700\u5927\u9650\u306b\u9ad8\u3081\u308b\u305f\u3081\u306b\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u3088\u3046\u306a\u6226\u7565\u3092\u4f7f\u7528\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30ea\u30bd\u30fc\u30b9\u52b9\u7387\u3092\u6700\u5927\u9650\u306b\u9ad8\u3081\u308b\u306b\u306f\u3001\u7dbf\u5bc6\u306a\u8a08\u753b\u3068\u512a\u5148\u9806\u4f4d\u4ed8\u3051\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30ea\u30bd\u30fc\u30b9\u3092\u8584\u304f\u5e83\u3052\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u30b3\u30a2\u30d2\u30fc\u30ed\u30fc\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u91cd\u70b9\u3092\u7f6e\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30c0\u30d6\u30ebXP\u30a4\u30d9\u30f3\u30c8\u4e2d\u306b\u5b9d\u77f3\u3092\u30a8\u30cd\u30eb\u30ae\u30fc\u88dc\u5145\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u300e\u5546\u4eba\u300f\u3092\u4f7f\u7528\u3057\u3066\u4e0d\u8981\u306a\u30a2\u30a4\u30c6\u30e0\u3068\u5fc5\u8981\u306a\u30ea\u30bd\u30fc\u30b9\u3092\u4ea4\u63db\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u4f4e\u30ec\u30d9\u30eb\u30a2\u30a4\u30c6\u30e0\u3068\u9ad8\u30ec\u30d9\u30eb\u30a2\u30a4\u30c6\u30e0\u306e\u4ea4\u63db\u306b\u3088\u308a\u3001\u5927\u5e45\u306a\u9032\u6b69\u3092\u4fc3\u9032\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u30d2\u30fc\u30ed\u30fc\u30a6\u30a9\u30fc\u30ba\u306e\u9032\u6357\u72b6\u6cc1\u3092\u3069\u306e\u3088\u3046\u306b\u79fb\u884c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u9032\u6357\u72b6\u6cc1\u3092\u79fb\u884c\u3059\u308b\u306b\u306f\u3001\u30bd\u30fc\u30b7\u30e3\u30eb\u30e1\u30c7\u30a3\u30a2\u307e\u305f\u306f\u30e1\u30fc\u30eb\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30ea\u30f3\u30af\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u300e\u8a2d\u5b9a\u300f\u30e1\u30cb\u30e5\u30fc\u306b\u30a2\u30af\u30bb\u30b9\u3057\u3001\u300e\u30a2\u30ab\u30a6\u30f3\u30c8\u300f\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1aFacebook\u3001Google\u3001\u307e\u305f\u306fApple ID\u306b\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30ea\u30f3\u30af\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u540c\u3058\u8cc7\u683c\u60c5\u5831\u3092\u4f7f\u7528\u3057\u3066\u3001\u65b0\u3057\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001Facebook\u306b\u30ea\u30f3\u30af\u3059\u308b\u3068\u3001Android\u3068iOS\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u30b9\u30e0\u30fc\u30ba\u306a\u9032\u6357\u72b6\u6cc1\u306e\u79fb\u884c\u304c\u53ef\u80fd\u3067\u3059\u3002"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u3088\u304f\u898b\u904e\u3054\u3057\u3066\u3044\u308b\u30d2\u30fc\u30ed\u30fc\u30a6\u30a9\u30fc\u30ba\u306e\u96a0\u308c\u305f\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u96a0\u308c\u305f\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u306f\u3001\u300e\u30a8\u30cd\u30eb\u30ae\u30fc\u30aa\u30fc\u30d0\u30fc\u30d5\u30ed\u30fc\u300f\u30b7\u30b9\u30c6\u30e0\u3068\u300e\u30d2\u30fc\u30ed\u30fc\u30b7\u30ca\u30b8\u30fc\u300f\u30dc\u30fc\u30ca\u30b9\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u672a\u4f7f\u7528\u306e\u30a8\u30cd\u30eb\u30ae\u30fc\u306f\u6b21\u306e\u65e5\u306e\u4e0a\u9650\u306b\u30aa\u30fc\u30d0\u30fc\u30d5\u30ed\u30fc\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308b\u3068\u3044\u3046\u3053\u3068\u3092\u7406\u89e3\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5f37\u5316\u3055\u308c\u305f\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306e\u305f\u3081\u306b\u3001\u30b7\u30ca\u30b8\u30fc\u306e\u3042\u308b\u80fd\u529b\u3092\u6301\u3064\u30d2\u30fc\u30ed\u30fc\u3092\u7d44\u307f\u5408\u308f\u305b\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u300e\u56f3\u66f8\u9928\u300f\u3092\u63a2\u7d22\u3057\u3066\u3001\u96a0\u308c\u305f\u30b9\u30c6\u30fc\u30bf\u30b9\u3084\u30dc\u30fc\u30ca\u30b9\u3092\u89e3\u7981\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30a2\u30b9\u30bf\u30fc\u30aa\u30b7\u3068\u30de\u30e4\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3068\u3001\u3059\u3050\u306b\u660e\u3089\u304b\u306b\u306a\u3089\u306a\u3044\u30d2\u30fc\u30ea\u30f3\u30b0\u30b7\u30ca\u30b8\u30fc\u304c\u30c8\u30ea\u30ac\u30fc\u3055\u308c\u307e\u3059\u3002"}, {"question": "\u300e\u30bf\u30a4\u30bf\u30f3\u300f\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d2\u30fc\u30ed\u30fc\u30a6\u30a9\u30fc\u30ba\u306e\u30e1\u30a4\u30f3\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3068\u3069\u306e\u3088\u3046\u306b\u7d71\u5408\u3055\u308c\u307e\u3059\u304b\uff1f", "answer": "\u300e\u30bf\u30a4\u30bf\u30f3\u300f\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6226\u95d8\u3067\u53ec\u559a\u3067\u304d\u308b\u5f37\u529b\u306a\u30e6\u30cb\u30c3\u30c8\u3092\u5c0e\u5165\u3059\u308b\u3053\u3068\u306b\u3088\u308a\u3001\u6226\u7565\u306e\u5c64\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u300e\u30bf\u30a4\u30bf\u30f3\u30d0\u30ec\u30fc\u300f\u304b\u3089\u30bf\u30a4\u30bf\u30f3\u306e\u9b42\u3092\u96c6\u3081\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30bf\u30a4\u30bf\u30f3\u306e\u30dd\u30fc\u30b7\u30e7\u30f3\u3068\u9b42\u3092\u4f7f\u7528\u3057\u3066\u30bf\u30a4\u30bf\u30f3\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6226\u95d8\u3067\u30bf\u30a4\u30bf\u30f3\u3092\u5c55\u958b\u3057\u3066\u3001\u6226\u6cc1\u3092\u8ee2\u63db\u3055\u305b\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30cf\u30a4\u30da\u30ea\u30aa\u30f3\u300f\u30bf\u30a4\u30bf\u30f3\u306f\u5473\u65b9\u3092\u56de\u5fa9\u3057\u3001\u83ab\u5927\u306a\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u53b3\u3057\u3044\u6226\u95d8\u3067\u30b2\u30fc\u30e0\u30c1\u30a7\u30f3\u30b8\u30e3\u30fc\u3068\u306a\u308a\u307e\u3059\u3002"}, {"question": "\u30d2\u30fc\u30ed\u30fc\u30a6\u30a9\u30fc\u30ba\u306e\u3069\u306e\u30b2\u30fc\u30e0\u30a4\u30d9\u30f3\u30c8\u304c\u6700\u9ad8\u306e\u5831\u916c\u3092\u63d0\u4f9b\u3057\u307e\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u306b\u6e96\u5099\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u300e\u82f1\u96c4\u306e\u5b9d\u7bb1\u300f\u3068\u300e\u30bf\u30a4\u30bf\u30f3\u53ec\u559a\u300f\u306e\u3088\u3046\u306a\u30a4\u30d9\u30f3\u30c8\u304c\u6700\u9ad8\u306e\u5831\u916c\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5b9d\u77f3\u3084\u30a8\u30cd\u30eb\u30ae\u30fc\u88dc\u5145\u306e\u3088\u3046\u306a\u30ea\u30bd\u30fc\u30b9\u3092\u3053\u308c\u3089\u306e\u30a4\u30d9\u30f3\u30c8\u306e\u305f\u3081\u306b\u7bc0\u7d04\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5831\u916c\u3092\u6700\u5927\u5316\u3059\u308b\u305f\u3081\u306b\u3001\u30a4\u30d9\u30f3\u30c8\u56fa\u6709\u306e\u30af\u30a8\u30b9\u30c8\u3092\u5b8c\u4e86\u3059\u308b\u306e\u306b\u96c6\u4e2d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u3053\u308c\u3089\u306e\u30a4\u30d9\u30f3\u30c8\u3068\u4e00\u81f4\u3059\u308b\u30ae\u30eb\u30c9\u6d3b\u52d5\u306b\u53c2\u52a0\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u82f1\u96c4\u306e\u5b9d\u7bb1\u300f\u30a4\u30d9\u30f3\u30c8\u3067\u306f\u3001\u30ec\u30a2\u306a\u30d2\u30fc\u30ed\u30fc\u306e\u7834\u7247\u3084\u30a2\u30fc\u30c6\u30a3\u30d5\u30a1\u30af\u30c8\u3092\u7372\u5f97\u3067\u304d\u3001\u3042\u306a\u305f\u306e\u30d2\u30fc\u30ed\u30fc\u306e\u9078\u5b9a\u3092\u5927\u304d\u304f\u5f37\u5316\u3057\u307e\u3059\u3002"}]
[{"question": "\u5982\u4f55\u8ba9\u65b0\u73a9\u5bb6\u5feb\u901f\u63d0\u5347\u82f1\u96c4\u7b49\u7ea7\u5728\u82f1\u96c4\u6218\u4e89\uff1f", "answer": "\u5728\u82f1\u96c4\u6218\u4e89\u4e2d\u5feb\u901f\u63d0\u5347\u82f1\u96c4\u7b49\u7ea7\uff0c\u8bf7\u96c6\u4e2d\u7cbe\u529b\u5b8c\u6210\u6bcf\u65e5\u4efb\u52a1\u548c\u6218\u5f79\u4efb\u52a1\u3002\u6b65\u9aa41\uff1a\u4f18\u5148\u5b8c\u6210\u63d0\u4f9b\u7ecf\u9a8c\u836f\u5242\u7684\u4efb\u52a1\u3002\u6b65\u9aa42\uff1a\u6709\u6548\u5229\u7528\u80fd\u91cf\uff0c\u76ee\u6807\u9636\u6bb5\u6389\u843d\u82f1\u96c4\u7279\u5b9a\u7269\u54c1\u3002\u6b65\u9aa43\uff1a\u53c2\u4e0e\"\u82f1\u96c4\u5b9d\u7bb1\"\u7b49\u6d3b\u52a8\u4ee5\u83b7\u5f97\u989d\u5916\u5956\u52b1\u3002\u4f8b\u5982\uff0c\u5b8c\u6210\"\u9ed1\u6697\u6218\u5f79\"\u53ef\u4ee5\u83b7\u5f97\u5927\u91cf\u7684\u7ecf\u9a8c\u503c\u548c\u8d44\u6e90\u3002"}, {"question": "\u82f1\u96c4\u6218\u4e89\u65e9\u671f\u6e38\u620f\u73a9\u5bb6\u7684\u6700\u4f73\u56e2\u961f\u7ec4\u5408\u662f\u4ec0\u4e48\uff1f", "answer": "\u65e9\u671f\u6e38\u620f\u73a9\u5bb6\u5e94\u6ce8\u91cd\u5e73\u8861\u7684\u56e2\u961f\u7ec4\u5408\u3002\u63a8\u8350\u7684\u7ec4\u5408\u5305\u62ec\u4e00\u4e2a\u5766\u514b\uff08\u4f8b\u5982\uff0c\u963f\u65af\u5854\u7f57\u65af\uff09\u3001\u4e00\u4e2a\u6cbb\u7597\u8005\uff08\u4f8b\u5982\uff0c\u7279\u5a05\uff09\u548c\u51e0\u4e2a\u8f93\u51fa\u82f1\u96c4\uff08\u4f8b\u5982\uff0c\u51ef\u62c9\u3001\u52a0\u62c9\u54c8\u5fb7\uff09\u3002\u4f7f\u7528\u914d\u7f6e\u8868\u683c\u6bd4\u8f83\u82f1\u96c4\u89d2\u8272\u548c\u534f\u540c\u4f5c\u7528\u3002\u4f8b\u5982\uff0c\u963f\u65af\u5854\u7f57\u65af\u7684\u62a4\u76fe\u6280\u80fd\u8865\u5145\u4e86\u51ef\u62c9\u7684\u9ad8\u4f24\u5bb3\u8f93\u51fa\uff0c\u4f7f\u4ed6\u4eec\u6210\u4e3a\u5f3a\u5927\u7684\u7ec4\u5408\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u5728\u82f1\u96c4\u6218\u4e89\u4e2d\u52a0\u5165\u516c\u4f1a\u5f88\u91cd\u8981\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u4f7f\u73a9\u5bb6\u53d7\u76ca\uff1f", "answer": "\u5728\u82f1\u96c4\u6218\u4e89\u4e2d\u52a0\u5165\u516c\u4f1a\u53ef\u4ee5\u83b7\u5f97\u516c\u4f1a\u6218\u4e89\u3001\u5171\u4eab\u8d44\u6e90\u548c\u5408\u4f5c\u6e38\u620f\u7684\u6743\u9650\u3002\u6b65\u9aa41\uff1a\u53c2\u4e0e\u516c\u4f1a\u6d3b\u52a8\u4ee5\u83b7\u5f97\u516c\u4f1a\u91d1\u5e01\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u8fd9\u4e9b\u91d1\u5e01\u4ece\u516c\u4f1a\u5546\u5e97\u8d2d\u4e70\u7a00\u6709\u7269\u54c1\u3002\u6b65\u9aa43\uff1a\u4e0e\u516c\u4f1a\u6210\u5458\u5408\u4f5c\u4ee5\u5e94\u5bf9\u9ad8\u7b49\u7ea7\u7684\u5730\u4e0b\u57ce\u3002\u4f8b\u5982\uff0c\u516c\u4f1a\u6218\u4e89\u53ef\u4ee5\u83b7\u5f97\u4e30\u539a\u7684\u5956\u52b1\uff0c\u5982\u7a00\u6709\u795e\u5668\u548c\u82f1\u96c4\u788e\u7247\u3002"}, {"question": "\u54ea\u4e9b\u82f1\u96c4\u6280\u80fd\u5728\u82f1\u96c4\u6218\u4e89\u7684PVP\u6218\u6597\u4e2d\u6700\u6709\u6548\uff0c\u4ee5\u53ca\u4e3a\u4ec0\u4e48\uff1f", "answer": "\u5728PVP\u6218\u6597\u4e2d\uff0c\u80fd\u591f\u6270\u4e71\u654c\u4eba\u9635\u578b\u6216\u63d0\u4f9b\u63a7\u5236\u6280\u80fd\u7684\u6280\u80fd\u975e\u5e38\u6709\u6548\u3002\u4e54\u6839\uff08\u80fd\u91cf\u64cd\u7eb5\uff09\u548c\u5c3c\u5e03\u62c9\uff08\u4e3a\u76df\u53cb\u52a0\u6210\uff09\u7b49\u82f1\u96c4\u81f3\u5173\u91cd\u8981\u3002\u4f7f\u7528\u6d41\u7a0b\u56fe\u6765\u7ed8\u5236\u6280\u80fd\u4e92\u52a8\u3002\u4f8b\u5982\uff0c\u4e54\u6839\u7684\u201c\u5438\u8840\u201d\u6280\u80fd\u53ef\u4ee5\u6d88\u8017\u654c\u4eba\u7684\u80fd\u91cf\uff0c\u9632\u6b62\u4ed6\u4eec\u4f7f\u7528\u7ec8\u6781\u6280\u80fd\u3002"}, {"question": "\u82f1\u96c4\u6218\u4e89\u4e2d\u7684\u795e\u5668\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u73a9\u5bb6\u5982\u4f55\u4f18\u5316\u5b83\uff1f", "answer": "\u82f1\u96c4\u6218\u4e89\u4e2d\u7684\u795e\u5668\u53ef\u4ee5\u63d0\u5347\u82f1\u96c4\u5c5e\u6027\u5e76\u63d0\u4f9b\u72ec\u7279\u80fd\u529b\u3002\u6b65\u9aa41\uff1a\u4ece\u6218\u5f79\u4efb\u52a1\u548c\u6d3b\u52a8\u4e2d\u6536\u96c6\u795e\u5668\u788e\u7247\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u91d1\u5e01\u548c\u788e\u7247\u5347\u7ea7\u795e\u5668\u3002\u6b65\u9aa43\uff1a\u88c5\u5907\u4e0e\u82f1\u96c4\u89d2\u8272\u76f8\u5f97\u76ca\u5f70\u7684\u795e\u5668\u3002\u4f8b\u5982\uff0c\u201c\u9884\u8a00\u4e4b\u4e66\u201d\u795e\u5668\u53ef\u4ee5\u63d0\u5347\u9b54\u6cd5\u653b\u51fb\uff0c\u4f7f\u5176\u975e\u5e38\u9002\u5408\u50cf\u5965\u5229\u5b89\u8fd9\u6837\u7684\u6cd5\u5e08\u82f1\u96c4\u3002"}, {"question": "\u73a9\u5bb6\u5e94\u8be5\u4f7f\u7528\u54ea\u4e9b\u7b56\u7565\u6765\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u82f1\u96c4\u6218\u4e89\u4e2d\u7684\u8d44\u6e90\u6548\u7387\uff1f", "answer": "\u6700\u5927\u9650\u5ea6\u63d0\u9ad8\u8d44\u6e90\u6548\u7387\u9700\u8981\u4ed4\u7ec6\u8ba1\u5212\u548c\u4f18\u5148\u7ea7\u6392\u5e8f\u3002\u6b65\u9aa41\uff1a\u4e13\u6ce8\u4e8e\u5347\u7ea7\u6838\u5fc3\u82f1\u96c4\uff0c\u800c\u4e0d\u662f\u5c06\u8d44\u6e90\u5206\u6563\u3002\u6b65\u9aa42\uff1a\u5728\u53cc\u500d\u7ecf\u9a8c\u6d3b\u52a8\u671f\u95f4\u4fdd\u5b58\u5b9d\u77f3\u4ee5\u8865\u5145\u80fd\u91cf\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u201c\u5546\u4eba\u201d\u5c06\u591a\u4f59\u7269\u54c1\u5151\u6362\u4e3a\u6240\u9700\u8d44\u6e90\u3002\u4f8b\u5982\uff0c\u5c06\u4f4e\u7ea7\u7269\u54c1\u5151\u6362\u6210\u9ad8\u7ea7\u7269\u54c1\u53ef\u4ee5\u663e\u8457\u63d0\u5347\u4f60\u7684\u8fdb\u5ea6\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u8fc1\u79fb\u82f1\u96c4\u6218\u4e89\u7684\u8fdb\u5ea6\uff1f", "answer": "\u8981\u8de8\u5e73\u53f0\u8fc1\u79fb\u8fdb\u5ea6\uff0c\u8bf7\u786e\u4fdd\u4f60\u7684\u5e10\u6237\u5df2\u94fe\u63a5\u5230\u793e\u4ea4\u5a92\u4f53\u6216\u7535\u5b50\u90ae\u4ef6\u5e10\u6237\u3002\u6b65\u9aa41\uff1a\u8f6c\u5230\u201c\u8bbe\u7f6e\u201d\u83dc\u5355\u5e76\u9009\u62e9\u201c\u5e10\u6237\u201d\u3002\u6b65\u9aa42\uff1a\u5c06\u4f60\u7684\u5e10\u6237\u94fe\u63a5\u5230 Facebook\u3001Google \u6216 Apple ID\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u76f8\u540c\u7684\u51ed\u636e\u767b\u5f55\u65b0\u7684\u5e73\u53f0\u3002\u4f8b\u5982\uff0c\u94fe\u63a5\u5230 Facebook \u5141\u8bb8\u5728 Android \u548c iOS \u8bbe\u5907\u4e4b\u95f4\u65e0\u7f1d\u8fc1\u79fb\u8fdb\u5ea6\u3002"}, {"question": "\u82f1\u96c4\u6218\u4e89\u4e2d\u73a9\u5bb6\u7ecf\u5e38\u5ffd\u7565\u7684\u9690\u85cf\u673a\u5236\u6709\u54ea\u4e9b\uff1f", "answer": "\u9690\u85cf\u673a\u5236\u5305\u62ec\u201c\u80fd\u91cf\u6ea2\u51fa\u201d\u7cfb\u7edf\u548c\u201c\u82f1\u96c4\u534f\u540c\u201d\u52a0\u6210\u3002\u6b65\u9aa41\uff1a\u4e86\u89e3\u672a\u4f7f\u7528\u7684\u80fd\u91cf\u53ef\u4ee5\u6ea2\u51fa\u81f3\u6b21\u65e5\u7684\u4e0a\u9650\u3002\u6b65\u9aa42\uff1a\u5c06\u62e5\u6709\u534f\u540c\u80fd\u529b\u7684\u82f1\u96c4\u642d\u914d\u4f7f\u7528\uff0c\u4ee5\u589e\u5f3a\u6027\u80fd\u3002\u6b65\u9aa43\uff1a\u63a2\u7d22\u201c\u56fe\u9274\u201d\u4ee5\u89e3\u5f00\u9690\u85cf\u7684\u5c5e\u6027\u548c\u52a0\u6210\u3002\u4f8b\u5982\uff0c\u5c06\u963f\u65af\u5854\u7f57\u65af\u4e0e\u739b\u96c5\u642d\u914d\u4f7f\u7528\uff0c\u53ef\u4ee5\u89e6\u53d1\u672a\u88ab\u7acb\u523b\u5bdf\u89c9\u7684\u6cbb\u7597\u534f\u540c\u80fd\u529b\u3002"}, {"question": "\u201c\u6cf0\u5766\u201d\u7cfb\u7edf\u5982\u4f55\u5728\u82f1\u96c4\u6218\u4e89\u7684\u4e3b\u8981\u6e38\u620f\u4e2d\u6574\u5408\uff1f", "answer": "\u201c\u6cf0\u5766\u201d\u7cfb\u7edf\u901a\u8fc7\u5f15\u5165\u53ef\u4ee5\u53ec\u5524\u5230\u6218\u6597\u4e2d\u5f3a\u5927\u5355\u4f4d\u6765\u589e\u52a0\u7b56\u7565\u5c42\u3002\u6b65\u9aa41\uff1a\u4ece\u201c\u6cf0\u5766\u5ce1\u8c37\u201d\u6536\u96c6\u6cf0\u5766\u7075\u9b42\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u6cf0\u5766\u836f\u5242\u548c\u7075\u9b42\u5347\u7ea7\u6cf0\u5766\u3002\u6b65\u9aa43\uff1a\u5728\u6218\u6597\u4e2d\u90e8\u7f72\u6cf0\u5766\u626d\u8f6c\u5c40\u52bf\u3002\u4f8b\u5982\uff0c\u201c\u5e0c\u73c0\u91cc\u5b89\u201d\u6cf0\u5766\u53ef\u4ee5\u6cbb\u7597\u76df\u53cb\u5e76\u9020\u6210\u5de8\u5927\u4f24\u5bb3\uff0c\u4f7f\u5176\u6210\u4e3a\u8270\u96be\u6218\u6597\u4e2d\u7684\u6e38\u620f\u6539\u53d8\u8005\u3002"}, {"question": "\u82f1\u96c4\u6218\u4e89\u4e2d\u54ea\u4e9b\u6e38\u620f\u6d3b\u52a8\u63d0\u4f9b\u6700\u4f73\u5956\u52b1\uff0c\u4ee5\u53ca\u5982\u4f55\u4e3a\u5176\u505a\u597d\u51c6\u5907\uff1f", "answer": "\u50cf\u201c\u82f1\u96c4\u5b9d\u7bb1\u201d\u548c\u201c\u6cf0\u5766\u53ec\u5524\u201d\u8fd9\u6837\u7684\u6d3b\u52a8\u63d0\u4f9b\u6700\u4f73\u5956\u52b1\u3002\u6b65\u9aa41\uff1a\u4e3a\u8fd9\u4e9b\u6d3b\u52a8\u4fdd\u5b58\u8d44\u6e90\uff0c\u4f8b\u5982\u5b9d\u77f3\u548c\u80fd\u91cf\u8865\u5145\u3002\u6b65\u9aa42\uff1a\u4e13\u6ce8\u4e8e\u5b8c\u6210\u7279\u5b9a\u6d3b\u52a8\u7684\u59d4\u6258\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u83b7\u5f97\u5956\u52b1\u3002\u6b65\u9aa43\uff1a\u53c2\u4e0e\u4e0e\u8fd9\u4e9b\u6d3b\u52a8\u540c\u65f6\u8fdb\u884c\u7684\u516c\u4f1a\u6d3b\u52a8\u3002\u4f8b\u5982\uff0c\u201c\u82f1\u96c4\u5b9d\u7bb1\u201d\u6d3b\u52a8\u53ef\u4ee5\u83b7\u5f97\u7a00\u6709\u7684\u82f1\u96c4\u788e\u7247\u548c\u795e\u5668\uff0c\u4ece\u800c\u6781\u5927\u5730\u589e\u5f3a\u4f60\u7684\u82f1\u96c4\u9635\u5bb9\u3002"}]
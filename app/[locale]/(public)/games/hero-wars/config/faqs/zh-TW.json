[{"question": "\u5982\u4f55\u8b93\u65b0\u73a9\u5bb6\u5728\u82f1\u96c4\u6230\u722d\u5feb\u901f\u63d0\u5347\u82f1\u96c4\u7b49\u7d1a\uff1f", "answer": "\u5728\u82f1\u96c4\u6230\u722d\u5feb\u901f\u63d0\u5347\u82f1\u96c4\u7b49\u7d1a\uff0c\u91cd\u9ede\u5728\u65bc\u5b8c\u6210\u6bcf\u65e5\u4efb\u52d9\u548c\u6d3b\u52d5\u4efb\u52d9\u3002\u6b65\u9a5f\u4e00\uff1a\u512a\u5148\u5b8c\u6210\u63d0\u4f9b\u7d93\u9a57\u503c\u7684\u4efb\u52d9\u3002\u6b65\u9a5f\u4e8c\uff1a\u6709\u6548\u904b\u7528\u80fd\u91cf\uff0c\u91dd\u5c0d\u6389\u843d\u7279\u5b9a\u82f1\u96c4\u7269\u54c1\u7684\u95dc\u5361\u3002\u6b65\u9a5f\u4e09\uff1a\u53c3\u8207\u50cf\u300e\u82f1\u96c4\u5bf6\u7bb1\u300f\u7b49\u6d3b\u52d5\u4ee5\u7372\u5f97\u984d\u5916\u734e\u52f5\u3002\u4f8b\u5982\uff0c\u5b8c\u6210\u300e\u9ed1\u6697\u9060\u5f81\u300f\u53ef\u4ee5\u7372\u5f97\u5927\u91cf\u7684\u7d93\u9a57\u503c\u548c\u8cc7\u6e90\u3002"}, {"question": "\u82f1\u96c4\u6230\u722d\u65e9\u671f\u904a\u6232\u7684\u6700\u4f73\u968a\u4f0d\u7d44\u5408\u70ba\u4f55\uff1f", "answer": "\u65e9\u671f\u904a\u6232\u73a9\u5bb6\u61c9\u8a72\u8457\u91cd\u65bc\u5e73\u8861\u7684\u968a\u4f0d\u7d44\u5408\u3002\u63a8\u85a6\u7684\u914d\u7f6e\u5305\u542b\u4e00\u500b\u5766\u514b\uff08\u4f8b\u5982\uff0c\u963f\u65af\u5854\u7f85\u7279\uff09\uff0c\u4e00\u500b\u6cbb\u7642\u5e2b\uff08\u4f8b\u5982\uff0c\u63d0\u96c5\uff09\uff0c\u4ee5\u53ca\u4e00\u4e9b\u50b7\u5bb3\u8f38\u51fa\u89d2\u8272\uff08\u4f8b\u5982\uff0c\u51f1\u62c9\u3001\u52a0\u62c9\u54c8\u5fb7\uff09\u3002\u4f7f\u7528\u914d\u7f6e\u8868\u683c\u6bd4\u8f03\u82f1\u96c4\u89d2\u8272\u548c\u5354\u540c\u4f5c\u7528\u3002\u4f8b\u5982\uff0c\u963f\u65af\u5854\u7f85\u7279\u7684\u8b77\u76fe\u6280\u80fd\u8207\u51f1\u62c9\u7684\u9ad8\u50b7\u5bb3\u8f38\u51fa\u76f8\u8f14\u76f8\u6210\uff0c\u4f7f\u4ed6\u5011\u6210\u70ba\u5f37\u529b\u7684\u7d44\u5408\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u5728\u82f1\u96c4\u6230\u722d\u4e2d\u52a0\u5165\u5de5\u6703\u5f88\u91cd\u8981\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5e6b\u52a9\u73a9\u5bb6\uff1f", "answer": "\u5728\u82f1\u96c4\u6230\u722d\u4e2d\u52a0\u5165\u5de5\u6703\u53ef\u4ee5\u7372\u5f97\u5de5\u6703\u6230\u722d\uff0c\u5171\u4eab\u8cc7\u6e90\u548c\u5408\u4f5c\u73a9\u6cd5\u7684\u6a5f\u6703\u3002\u6b65\u9a5f\u4e00\uff1a\u53c3\u8207\u5de5\u6703\u6d3b\u52d5\u4ee5\u8cfa\u53d6\u5de5\u6703\u91d1\u5e63\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u9019\u4e9b\u91d1\u5e63\u5f9e\u5de5\u6703\u5546\u5e97\u8cfc\u8cb7\u7a00\u6709\u7269\u54c1\u3002\u6b65\u9a5f\u4e09\uff1a\u8207\u5de5\u6703\u6210\u54e1\u5408\u4f5c\u6311\u6230\u9ad8\u96e3\u5ea6\u526f\u672c\u3002\u4f8b\u5982\uff0c\u5de5\u6703\u6230\u722d\u53ef\u4ee5\u7372\u5f97\u8c50\u539a\u7684\u734e\u52f5\uff0c\u4f8b\u5982\u7a00\u6709\u6587\u7269\u548c\u82f1\u96c4\u788e\u7247\u3002"}, {"question": "\u54ea\u4e9b\u82f1\u96c4\u6280\u80fd\u5728\u82f1\u96c4\u6230\u722d\u7684 PvP \u6230\u9b25\u4e2d\u6700\u6709\u6548\uff0c\u4ee5\u53ca\u539f\u56e0\u70ba\u4f55\uff1f", "answer": "\u5728 PvP \u6230\u9b25\u4e2d\uff0c\u80fd\u5920\u64fe\u4e82\u6575\u65b9\u9663\u578b\u6216\u63d0\u4f9b\u63a7\u5236\u6280\u80fd\u7684\u6280\u80fd\u975e\u5e38\u6709\u6548\u3002\u50cf\u55ac\u6839\uff08\u80fd\u91cf\u64cd\u63a7\uff09\u548c\u5c3c\u5e03\u62c9\uff08\u589e\u76ca\u76df\u53cb\uff09\u9019\u6a23\u7684\u82f1\u96c4\u81f3\u95dc\u91cd\u8981\u3002\u4f7f\u7528\u6d41\u7a0b\u5716\u4f86\u7e6a\u88fd\u6280\u80fd\u4e92\u52d5\u3002\u4f8b\u5982\uff0c\u55ac\u6839\u7684\u300e\u5438\u53d6\u300f\u6280\u80fd\u53ef\u4ee5\u6d88\u8017\u6575\u65b9\u80fd\u91cf\uff0c\u963b\u6b62\u4ed6\u5011\u4f7f\u7528\u7d42\u6975\u6280\u80fd\u3002"}, {"question": "\u82f1\u96c4\u6230\u722d\u4e2d\u7684\u6587\u7269\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff0c\u4ee5\u53ca\u73a9\u5bb6\u5982\u4f55\u512a\u5316\u5b83\uff1f", "answer": "\u82f1\u96c4\u6230\u722d\u4e2d\u7684\u6587\u7269\u53ef\u4ee5\u5f37\u5316\u82f1\u96c4\u5c6c\u6027\u4e26\u63d0\u4f9b\u7368\u7279\u7684\u6280\u80fd\u3002\u6b65\u9a5f\u4e00\uff1a\u5f9e\u6d3b\u52d5\u4efb\u52d9\u548c\u6d3b\u52d5\u4e2d\u6536\u96c6\u6587\u7269\u788e\u7247\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u91d1\u5e63\u548c\u788e\u7247\u5347\u7d1a\u6587\u7269\u3002\u6b65\u9a5f\u4e09\uff1a\u88dd\u5099\u8207\u60a8\u82f1\u96c4\u89d2\u8272\u76f8\u8f14\u76f8\u6210\u7684\u6587\u7269\u3002\u4f8b\u5982\uff0c\u300e\u9810\u8a00\u4e4b\u66f8\u300f\u6587\u7269\u53ef\u4ee5\u63d0\u5347\u9b54\u6cd5\u653b\u64ca\uff0c\u4f7f\u5176\u975e\u5e38\u9069\u5408\u50cf\u5967\u5229\u5b89\u9019\u6a23\u7684\u6cd5\u5e2b\u82f1\u96c4\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u82f1\u96c4\u6230\u722d\u4e2d\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u8cc7\u6e90\u6548\u7387\uff1f", "answer": "\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u8cc7\u6e90\u6548\u7387\u9700\u8981\u4ed4\u7d30\u898f\u5283\u548c\u512a\u5148\u6392\u5e8f\u3002\u6b65\u9a5f\u4e00\uff1a\u5c08\u6ce8\u65bc\u5347\u7d1a\u6838\u5fc3\u82f1\u96c4\uff0c\u800c\u4e0d\u662f\u5c07\u8cc7\u6e90\u5206\u6563\u3002\u6b65\u9a5f\u4e8c\uff1a\u5728\u96d9\u500d\u7d93\u9a57\u503c\u6d3b\u52d5\u671f\u9593\u5132\u5b58\u5bf6\u77f3\u4ee5\u88dc\u5145\u80fd\u91cf\u3002\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u300e\u5546\u4eba\u300f\u4ea4\u63db\u591a\u9918\u7684\u7269\u54c1\u4ee5\u7372\u5f97\u6240\u9700\u7684\u8cc7\u6e90\u3002\u4f8b\u5982\uff0c\u5c07\u4f4e\u7d1a\u7269\u54c1\u4ea4\u63db\u6210\u9ad8\u7d1a\u7269\u54c1\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u4f60\u7684\u9032\u5ea6\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u9593\u9077\u79fb\u82f1\u96c4\u6230\u722d\u7684\u9032\u5ea6\uff1f", "answer": "\u8981\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u9593\u9077\u79fb\u9032\u5ea6\uff0c\u8acb\u52d9\u5fc5\u5c07\u60a8\u7684\u5e33\u6236\u9023\u7d50\u5230\u793e\u7fa4\u5a92\u9ad4\u6216\u96fb\u5b50\u90f5\u4ef6\u5e33\u6236\u3002\u6b65\u9a5f\u4e00\uff1a\u9032\u5165\u300e\u8a2d\u5b9a\u300f\u9078\u55ae\u4e26\u9078\u64c7\u300e\u5e33\u6236\u300f\u3002\u6b65\u9a5f\u4e8c\uff1a\u5c07\u60a8\u7684\u5e33\u6236\u9023\u7d50\u5230 Facebook\u3001Google \u6216 Apple ID\u3002\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u76f8\u540c\u7684\u6191\u8b49\u767b\u5165\u65b0\u5e73\u53f0\u3002\u4f8b\u5982\uff0c\u9023\u7d50 Facebook \u53ef\u5728 Android \u548c iOS \u88dd\u7f6e\u4e4b\u9593\u9806\u5229\u5730\u8f49\u79fb\u9032\u5ea6\u3002"}, {"question": "\u82f1\u96c4\u6230\u722d\u4e2d\u73a9\u5bb6\u7d93\u5e38\u5ffd\u7565\u7684\u96b1\u85cf\u6a5f\u5236\u6709\u54ea\u4e9b\uff1f", "answer": "\u96b1\u85cf\u6a5f\u5236\u5305\u62ec\u300e\u80fd\u91cf\u6ea2\u51fa\u300f\u7cfb\u7d71\u548c\u300e\u82f1\u96c4\u5354\u540c\u300f\u734e\u52f5\u3002\u6b65\u9a5f\u4e00\uff1a\u77ad\u89e3\u672a\u4f7f\u7528\u7684\u80fd\u91cf\u53ef\u80fd\u6703\u6ea2\u51fa\u81f3\u9694\u5929\u7684\u4e0a\u9650\u3002\u6b65\u9a5f\u4e8c\uff1a\u5c07\u82f1\u96c4\u8207\u5354\u540c\u6280\u80fd\u914d\u5c0d\u4ee5\u63d0\u5347\u8868\u73fe\u3002\u6b65\u9a5f\u4e09\uff1a\u63a2\u7d22\u300e\u5716\u66f8\u9928\u300f\u4ee5\u89e3\u9396\u96b1\u85cf\u7684\u5c6c\u6027\u548c\u734e\u52f5\u3002\u4f8b\u5982\uff0c\u5c07\u963f\u65af\u5854\u7f85\u7279\u8207\u746a\u96c5\u914d\u5c0d\u53ef\u4ee5\u89f8\u767c\u60a8\u4e0d\u592a\u660e\u986f\u7684\u6cbb\u7642\u5354\u540c\u4f5c\u7528\u3002"}, {"question": "\u300e\u6cf0\u5766\u300f\u7cfb\u7d71\u5982\u4f55\u5728\u82f1\u96c4\u6230\u722d\u7684\u904a\u6232\u4e2d\u6574\u5408\uff1f", "answer": "\u300e\u6cf0\u5766\u300f\u7cfb\u7d71\u901a\u904e\u5f15\u5165\u53ef\u4ee5\u53ec\u559a\u5230\u6230\u9b25\u4e2d\u5f37\u5927\u55ae\u4f4d\u7684\u6a5f\u5236\uff0c\u589e\u52a0\u4e86\u7b56\u7565\u5c64\u9762\u3002\u6b65\u9a5f\u4e00\uff1a\u5f9e\u300e\u6cf0\u5766\u8c37\u300f\u6536\u96c6\u6cf0\u5766\u9748\u9b42\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u6cf0\u5766\u85e5\u5291\u548c\u9748\u9b42\u5347\u7d1a\u6cf0\u5766\u3002\u6b65\u9a5f\u4e09\uff1a\u5728\u6230\u9b25\u4e2d\u90e8\u7f72\u6cf0\u5766\u4f86\u626d\u8f49\u5c40\u52e2\u3002\u4f8b\u5982\uff0c\u300e\u5e0c\u4f69\u91cc\u7fc1\u300f\u6cf0\u5766\u53ef\u4ee5\u6cbb\u7642\u76df\u53cb\u4e26\u9020\u6210\u5927\u91cf\u7684\u50b7\u5bb3\uff0c\u4f7f\u5176\u6210\u70ba\u8271\u96e3\u6230\u9b25\u4e2d\u7684\u904a\u6232\u6539\u8b8a\u8005\u3002"}, {"question": "\u82f1\u96c4\u6230\u722d\u4e2d\u7684\u54ea\u4e9b\u904a\u6232\u6d3b\u52d5\u63d0\u4f9b\u6700\u4f73\u734e\u52f5\uff0c\u4ee5\u53ca\u5982\u4f55\u70ba\u5b83\u5011\u505a\u6e96\u5099\uff1f", "answer": "\u50cf\u300e\u82f1\u96c4\u5bf6\u7bb1\u300f\u548c\u300e\u6cf0\u5766\u53ec\u559a\u300f\u7b49\u6d3b\u52d5\u63d0\u4f9b\u6700\u4f73\u734e\u52f5\u3002\u6b65\u9a5f\u4e00\uff1a\u70ba\u9019\u4e9b\u6d3b\u52d5\u5132\u5b58\u8cc7\u6e90\uff0c\u4f8b\u5982\u5bf6\u77f3\u548c\u80fd\u91cf\u88dc\u5145\u3002\u6b65\u9a5f\u4e8c\uff1a\u5c08\u6ce8\u65bc\u5b8c\u6210\u7279\u5b9a\u6d3b\u52d5\u4efb\u52d9\u4ee5\u6700\u5927\u5316\u734e\u52f5\u3002\u6b65\u9a5f\u4e09\uff1a\u53c3\u8207\u8207\u9019\u4e9b\u6d3b\u52d5\u540c\u6b65\u7684\u5de5\u6703\u6d3b\u52d5\u3002\u4f8b\u5982\uff0c\u300e\u82f1\u96c4\u5bf6\u7bb1\u300f\u6d3b\u52d5\u53ef\u4ee5\u7522\u751f\u7a00\u6709\u82f1\u96c4\u788e\u7247\u548c\u6587\u7269\uff0c\u986f\u8457\u63d0\u5347\u60a8\u7684\u82f1\u96c4\u540d\u55ae\u3002"}]
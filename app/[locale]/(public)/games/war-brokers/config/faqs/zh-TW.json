[{"question": "\u5982\u4f55\u63d0\u9ad8\u6211\u5728\u6230\u722d\u4ee3\u7406\u4eba\u7684\u521d\u5b78\u8005\u7784\u6e96\u7cbe\u6e96\u5ea6\uff1f", "answer": "\u8981\u63d0\u9ad8\u5728\u6230\u722d\u4ee3\u7406\u4eba\u7684\u7784\u6e96\u7cbe\u6e96\u5ea6\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f\u4e00\uff1a\u5c07\u8a2d\u5b9a\u4e2d\u7684\u6ed1\u9f20\u611f\u61c9\u5ea6\u8abf\u6574\u5230\u8212\u9069\u7684\u7a0b\u5ea6\u3002\u6b65\u9a5f\u4e8c\uff1a\u5728\u8a13\u7df4\u6a21\u5f0f\u4e2d\u7df4\u7fd2\uff0c\u4ee5\u719f\u6089\u4e0d\u540c\u6b66\u5668\u3002\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u72d9\u64ca\u6b65\u69cd\u5c08\u6ce8\u65bc\u7cbe\u6e96\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u300e\u6c99\u6f20\u300f\u5730\u5716\u4e2d\uff0c\u5c07\u81ea\u5df1\u64fa\u5728\u9ad8\u8655\uff0c\u4ee5\u4fbf\u6e05\u695a\u5730\u770b\u5230\u6575\u4eba\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u7784\u6e96\u60f3\u50cf\u6210\u958b\u8eca\uff1b\u7df4\u7fd2\u8d8a\u591a\uff0c\u63a7\u5236\u5c31\u8d8a\u9806\u66a2\u3002]"}, {"question": "\u6230\u722d\u4ee3\u7406\u4eba\u5718\u968a\u5408\u4f5c\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u6230\u722d\u4ee3\u7406\u4eba\u4e2d\u6709\u6548\u7684\u5718\u968a\u5408\u4f5c\u9700\u8981\u6e9d\u901a\u548c\u89d2\u8272\u5206\u914d\u3002\u6b65\u9a5f\u4e00\uff1a\u4f7f\u7528\u904a\u6232\u5167\u804a\u5929\u6216\u8a9e\u97f3\u901a\u8a0a\u5354\u8abf\u3002\u6b65\u9a5f\u4e8c\uff1a\u5206\u914d\u4f8b\u5982\u72d9\u64ca\u624b\u3001\u91ab\u7642\u5175\u548c\u7a81\u64ca\u968a\u54e1\u7b49\u89d2\u8272\uff0c\u4ee5\u5e73\u8861\u5718\u968a\u3002\u6b65\u9a5f\u4e09\uff1a\u5c08\u6ce8\u65bc\u76ee\u6a19\uff0c\u4f8b\u5982\u4f54\u9818\u9ede\u6216\u8b77\u9001\u88dc\u7d66\u54c1\u3002\u4f8b\u5982\uff0c\u5728\u300e\u57ce\u5e02\u300f\u5730\u5716\u4e2d\uff0c\u4e00\u500b\u5354\u8abf\u826f\u597d\u7684\u5718\u968a\u53ef\u4ee5\u900f\u904e\u63a7\u5236\u95dc\u9375\u7684\u9698\u53e3\u4f86\u4f54\u64da\u4e3b\u5c0e\u5730\u4f4d\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u89d2\u8272 | \u6b66\u5668 | \u6230\u7565]"}, {"question": "\u5728\u6230\u722d\u4ee3\u7406\u4eba\u7684\u8fd1\u8ddd\u96e2\u6230\u9b25\u4e2d\uff0c\u54ea\u4e9b\u6b66\u5668\u6700\u6709\u6548\uff1f", "answer": "\u5728\u8fd1\u8ddd\u96e2\u6230\u9b25\u4e2d\uff0c\u9730\u5f48\u69cd\u548c\u885d\u92d2\u69cd\u975e\u5e38\u6709\u6548\u3002\u9730\u5f48\u69cd\u5728\u8fd1\u8ddd\u96e2\u63d0\u4f9b\u9ad8\u50b7\u5bb3\uff0c\u800c\u885d\u92d2\u69cd\u5247\u63d0\u4f9b\u5feb\u901f\u5c04\u64ca\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5de5\u5ee0\u300f\u5730\u5716\u4e2d\uff0c\u5728\u72f9\u7a84\u7684\u8d70\u5eca\u4f7f\u7528\u9730\u5f48\u69cd\u53ef\u4ee5\u5feb\u901f\u6d88\u6ec5\u6575\u4eba\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u9730\u5f48\u69cd\u8207\u885d\u92d2\u69cd\u5728\u50b7\u5bb3\u3001\u5c04\u7a0b\u548c\u5c04\u901f\u65b9\u9762\u7684\u6bd4\u8f03\u3002]"}, {"question": "\u6230\u722d\u4ee3\u7406\u4eba\u7684\u88dd\u7532\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u6230\u722d\u4ee3\u7406\u4eba\u7684\u88dd\u7532\u7cfb\u7d71\u53ef\u6e1b\u5c11\u6575\u65b9\u9020\u6210\u7684\u50b7\u5bb3\u3002\u88dd\u7532\u53ef\u4ee5\u5f9e\u6230\u5834\u4e0a\u64bf\u62fe\uff0c\u6216\u5728\u5546\u5e97\u8cfc\u8cb7\u3002\u6bcf\u4ef6\u88dd\u7532\u90fd\u6709\u8010\u4e45\u5ea6\uff0c\u96a8\u8457\u6240\u53d7\u50b7\u5bb3\u800c\u6e1b\u5c11\u3002\u4f8b\u5982\uff0c\u7a7f\u8457\u5168\u5957\u88dd\u7532\u53ef\u4ee5\u5c07\u72d9\u64ca\u6b65\u69cd\u7684\u50b7\u5bb3\u5f9e100\u964d\u4f4e\u523070\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u88dd\u7532\u7684\u50b7\u5bb3\u8a08\u7b97\u65b9\u5f0f]"}, {"question": "\u4e0d\u540c\u904a\u6232\u6a21\u5f0f\u5728\u6230\u722d\u4ee3\u7406\u4eba\u4e4b\u9593\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "\u6230\u722d\u4ee3\u7406\u4eba\u63d0\u4f9b\u591a\u7a2e\u904a\u6232\u6a21\u5f0f\uff1a\u5718\u968a\u6b7b\u4ea1\u8cfd\u3001\u6436\u596a\u65d7\u5e5f\u548c\u751f\u5b58\u904a\u6232\u3002\u5718\u968a\u6b7b\u4ea1\u8cfd\u5c08\u6ce8\u65bc\u6d88\u6ec5\u6575\u65b9\u5718\u968a\uff0c\u6436\u596a\u65d7\u5e5f\u9700\u8981\u7b56\u7565\u4f86\u596a\u53d6\u548c\u56de\u6b78\u6575\u65b9\u65d7\u5e5f\uff0c\u800c\u751f\u5b58\u904a\u6232\u5247\u662f\u4e00\u500b\u6700\u5f8c\u4e00\u4eba\u751f\u5b58\u7684\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u5728\u751f\u5b58\u904a\u6232\u4e2d\uff0c\u73a9\u5bb6\u5fc5\u9808\u641c\u5c0b\u6b66\u5668\u4e26\u907f\u958b\u7e2e\u5c0f\u7684\u904a\u6232\u5340\u57df\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u904a\u6232\u6a21\u5f0f\u60f3\u6210\u4e0d\u540c\u7684\u904b\u52d5\uff1b\u6bcf\u4e00\u9805\u904b\u52d5\u90fd\u6709\u5176\u898f\u5247\u548c\u76ee\u6a19\u3002]"}, {"question": "\u5982\u4f55\u5728\u6230\u722d\u4ee3\u7406\u4eba\u4e2d\u512a\u5316\u904a\u6232\u8a2d\u5b9a\u4ee5\u7372\u5f97\u66f4\u597d\u7684\u6548\u80fd\uff1f", "answer": "\u512a\u5316\u6230\u722d\u4ee3\u7406\u4eba\u7684\u8a2d\u5b9a\u53ef\u4ee5\u589e\u5f37\u6548\u80fd\u3002\u6b65\u9a5f\u4e00\uff1a\u964d\u4f4e\u5716\u5f62\u8a2d\u5b9a\uff0c\u4f8b\u5982\u7d0b\u7406\u54c1\u8cea\u548c\u9670\u5f71\u3002\u6b65\u9a5f\u4e8c\uff1a\u505c\u7528\u4e0d\u5fc5\u8981\u7684\u80cc\u666f\u61c9\u7528\u7a0b\u5f0f\u3002\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u6709\u7dda\u7db2\u8def\u9023\u7dda\uff0c\u4ee5\u78ba\u4fdd\u7a69\u5b9a\u7684\u5ef6\u9072\u3002\u4f8b\u5982\uff0c\u6e1b\u5c11\u6e32\u67d3\u8ddd\u96e2\u53ef\u4ee5\u986f\u8457\u6539\u5584\u4f4e\u7aef\u7cfb\u7d71\u7684\u756b\u9762\u901f\u7387\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u8a2d\u5b9a | \u5efa\u8b70\u503c | \u5c0d\u6548\u80fd\u7684\u5f71\u97ff]"}, {"question": "\u5728\u6230\u722d\u4ee3\u7406\u4eba\u4e2d\u6709\u6548\u7ba1\u7406\u904a\u6232\u8ca8\u5e63\u7684\u6700\u4f73\u505a\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "\u6709\u6548\u7ba1\u7406\u904a\u6232\u8ca8\u5e63\u9700\u8981\u512a\u5148\u8cfc\u8cb7\u5fc5\u8981\u7684\u7269\u54c1\u3002\u6b65\u9a5f\u4e00\uff1a\u8cfc\u8cb7\u9069\u5408\u81ea\u5df1\u904a\u6232\u98a8\u683c\u7684\u6b66\u5668\u548c\u88dd\u7532\u3002\u6b65\u9a5f\u4e8c\uff1a\u5132\u5b58\u8ca8\u5e63\u7528\u65bc\u9ad8\u5f71\u97ff\u529b\u7684\u7269\u54c1\uff0c\u4f8b\u5982\u5f37\u5927\u7684\u6b66\u5668\u6216\u76ae\u819a\u3002\u6b65\u9a5f\u4e09\uff1a\u53c3\u8207\u6d3b\u52d5\u4ee5\u8cfa\u53d6\u984d\u5916\u8ca8\u5e63\u3002\u4f8b\u5982\uff0c\u53ca\u65e9\u8cfc\u8cb7\u72d9\u64ca\u6b65\u69cd\u53ef\u4ee5\u70ba\u60a8\u5e36\u4f86\u6230\u7565\u512a\u52e2\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u53ca\u65e9\u8cfc\u8cb7\u8207\u5132\u84c4\u4ee5\u5099\u5f8c\u671f\u7684\u6bd4\u8f03\u3002]"}, {"question": "\u6230\u722d\u4ee3\u7406\u4eba\u7684\u5339\u914d\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u6230\u722d\u4ee3\u7406\u4eba\u7684\u5339\u914d\u7cfb\u7d71\u6839\u64da\u73a9\u5bb6\u7684\u6280\u80fd\u548c\u7d93\u9a57\u4f86\u5e73\u8861\u5718\u968a\u3002\u5b83\u4f7f\u7528\u6f14\u7b97\u6cd5\u4f86\u78ba\u4fdd\u516c\u5e73\u7684\u6bd4\u8cfd\uff0c\u4e26\u8003\u616e\u52dd\u7387\u548c\u64ca\u6bba\u7387\u7b49\u56e0\u7d20\u3002\u4f8b\u5982\uff0c\u65b0\u73a9\u5bb6\u901a\u5e38\u6703\u8207\u5176\u4ed6\u7d93\u9a57\u76f8\u8fd1\u7684\u73a9\u5bb6\u5339\u914d\uff0c\u4ee5\u907f\u514d\u9762\u81e8\u904e\u5927\u7684\u6311\u6230\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u5339\u914d\u6d41\u7a0b]"}, {"question": "\u6211\u53ef\u4ee5\u5c07\u6230\u722d\u4ee3\u7406\u4eba\u96fb\u8166\u7248\u904a\u6232\u9032\u5ea6\u8f49\u79fb\u5230\u624b\u6a5f\u7248\u55ce\uff1f", "answer": "\u76ee\u524d\uff0c\u6230\u722d\u4ee3\u7406\u4eba\u4e0d\u652f\u63f4\u8de8\u5e73\u53f0\u9032\u5ea6\u8f49\u79fb\u3002\u60a8\u5728\u96fb\u8166\u7248\u7684\u9032\u5ea6\u8207\u624b\u6a5f\u7248\u4fdd\u6301\u5206\u96e2\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u96fb\u8166\u7248\u89e3\u9396\u4e86\u4e00\u628a\u6b66\u5668\uff0c\u5b83\u5c07\u4e0d\u6703\u51fa\u73fe\u5728\u60a8\u7684\u624b\u6a5f\u5e33\u6236\u4e2d\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5982\u540c\u64c1\u6709\u5169\u500b\u4e0d\u540c\u7684\u5716\u66f8\u9928\uff1b\u6bcf\u500b\u5e73\u53f0\u90fd\u6709\u5176\u81ea\u5df1\u7684\u6536\u85cf\u3002]"}, {"question": "\u5728\u6230\u722d\u4ee3\u7406\u4eba\u4e2d\u6709\u4efb\u4f55\u96b1\u85cf\u7684\u5f69\u86cb\u6216\u79d8\u5bc6\u55ce\uff1f", "answer": "\u6230\u722d\u4ee3\u7406\u4eba\u5305\u62ec\u4e00\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u5728\u300e\u68ee\u6797\u300f\u5730\u5716\u4e2d\uff0c\u6709\u4e00\u500b\u96b1\u85cf\u7684\u6d1e\u7a74\uff0c\u88e1\u9762\u5305\u542b\u7279\u6b8a\u6b66\u5668\u3002\u63a2\u7d22\u504f\u96e2\u5e38\u898f\u8def\u7dda\u7684\u5340\u57df\u53ef\u4ee5\u767c\u73fe\u9019\u4e9b\u79d8\u5bc6\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u5f69\u86cb\u60f3\u50cf\u6210\u96b1\u85cf\u7684\u5bf6\u85cf\uff1b\u5b83\u5011\u56de\u5831\u597d\u5947\u548c\u5192\u96aa\u7684\u4eba\u3002]"}]
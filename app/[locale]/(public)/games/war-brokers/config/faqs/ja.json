[{"question": "War Brokers\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001\u5c04\u6483\u7cbe\u5ea6\u3092\u5411\u4e0a\u3055\u305b\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "War Brokers\u3067\u5c04\u6483\u7cbe\u5ea6\u3092\u5411\u4e0a\u3055\u305b\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u8a2d\u5b9a\u3067\u30de\u30a6\u30b9\u306e\u611f\u5ea6\u3092\u5feb\u9069\u306a\u30ec\u30d9\u30eb\u306b\u8abf\u6574\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u30e2\u30fc\u30c9\u3067\u3055\u307e\u3056\u307e\u306a\u6b66\u5668\u306b\u6163\u308c\u308b\u7df4\u7fd2\u3092\u884c\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u72d9\u6483\u30e9\u30a4\u30d5\u30eb\u3092\u4f7f\u7528\u3057\u3066\u6b63\u78ba\u3055\u306b\u5411\u304b\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30de\u30c3\u30d7\u300c\u30c7\u30b6\u30fc\u30c8\u300d\u3067\u306f\u3001\u6575\u306e\u660e\u78ba\u306a\u8996\u754c\u3092\u5f97\u308b\u305f\u3081\u3001\u9ad8\u5730\u306b\u4f4d\u7f6e\u53d6\u308a\u307e\u3057\u3087\u3046\u3002[\u4f8b\u3048\uff1a\u5c04\u6483\u3092\u904b\u8ee2\u306b\u4f8b\u3048\u308b\u3068\u3001\u7df4\u7fd2\u3059\u308c\u3070\u3059\u308b\u307b\u3069\u64cd\u4f5c\u304c\u30b9\u30e0\u30fc\u30ba\u306b\u306a\u308a\u307e\u3059\u3002]"}, {"question": "War Brokers\u306b\u304a\u3051\u308b\u30c1\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u6700\u9069\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "War Brokers\u3067\u52b9\u679c\u7684\u306a\u30c1\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u884c\u3046\u306b\u306f\u3001\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u3068\u5f79\u5272\u5206\u62c5\u304c\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30a4\u30f3\u30b2\u30fc\u30e0\u30c1\u30e3\u30c3\u30c8\u307e\u305f\u306f\u30dc\u30a4\u30b9\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u3092\u4f7f\u7528\u3057\u3066\u9023\u643a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u72d9\u6483\u624b\u3001\u533b\u7642\u5175\u3001\u653b\u6483\u624b\u3068\u3044\u3063\u305f\u5f79\u5272\u3092\u5272\u308a\u5f53\u3066\u3001\u30c1\u30fc\u30e0\u306e\u30d0\u30e9\u30f3\u30b9\u3092\u53d6\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30dd\u30a4\u30f3\u30c8\u306e\u5360\u9818\u3084\u8f38\u9001\u4efb\u52d9\u306a\u3069\u306e\u76ee\u6a19\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30de\u30c3\u30d7\u300c\u30b7\u30c6\u30a3\u300d\u3067\u306f\u3001\u9023\u643a\u306e\u3068\u308c\u305f\u30c1\u30fc\u30e0\u304c\u4e3b\u8981\u306a\u9698\u8def\u3092\u652f\u914d\u3059\u308b\u3053\u3068\u3067\u512a\u4f4d\u306b\u7acb\u3064\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u914d\u7f6e\u8868\uff1a\u5f79\u5272\uff5c\u6b66\u5668\uff5c\u6226\u7565]"}, {"question": "War Brokers\u3067\u8fd1\u63a5\u6226\u95d8\u306b\u6700\u3082\u6709\u52b9\u306a\u6b66\u5668\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u8fd1\u63a5\u6226\u95d8\u306b\u304a\u3044\u3066\u306f\u3001\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\u3068SMG\u304c\u975e\u5e38\u306b\u6709\u52b9\u3067\u3059\u3002\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\u306f\u8fd1\u8ddd\u96e2\u3067\u9ad8\u3044\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u3001SMG\u306f\u9023\u5c04\u529b\u304c\u9ad8\u3044\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30de\u30c3\u30d7\u300c\u5de5\u5834\u300d\u3067\u306f\u3001\u72ed\u3044\u901a\u8def\u3067\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\u3092\u4f7f\u7528\u3057\u3066\u6575\u3092\u8fc5\u901f\u306b\u6392\u9664\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\u3068SMG\u306e\u30c0\u30e1\u30fc\u30b8\u3001\u5c04\u7a0b\u3001\u5c04\u6483\u901f\u5ea6\u306e\u6bd4\u8f03]"}, {"question": "War Brokers\u306e\u88c5\u7532\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "War Brokers\u306e\u88c5\u7532\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u53d7\u3051\u53d6\u308b\u30c0\u30e1\u30fc\u30b8\u3092\u8efd\u6e1b\u3057\u307e\u3059\u3002\u88c5\u7532\u306f\u6226\u5834\u304b\u3089\u62fe\u3063\u305f\u308a\u3001\u30b7\u30e7\u30c3\u30d7\u3067\u8cfc\u5165\u3067\u304d\u307e\u3059\u3002\u5404\u88c5\u7532\u306b\u306f\u3001\u53d7\u3051\u305f\u30c0\u30e1\u30fc\u30b8\u306b\u3088\u3063\u3066\u6e1b\u5c11\u3059\u308b\u8010\u4e45\u5024\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30d5\u30eb\u30a2\u30fc\u30de\u30fc\u3092\u88c5\u5099\u3059\u308b\u3068\u3001\u72d9\u6483\u5175\u306e100\u306e\u30c0\u30e1\u30fc\u30b8\u309270\u306b\u8efd\u6e1b\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u88c5\u7532\u306b\u3088\u308b\u30c0\u30e1\u30fc\u30b8\u8a08\u7b97]"}, {"question": "War Brokers\u306e\u3055\u307e\u3056\u307e\u306a\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "War Brokers\u306b\u306f\u3001\u30c1\u30fc\u30e0\u30c7\u30b9\u30de\u30c3\u30c1\u3001\u9663\u5730\u596a\u53d6\u3001\u30d0\u30c8\u30eb\u30ed\u30a4\u30e4\u30eb\u306a\u3069\u306e\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u304c\u3042\u308a\u307e\u3059\u3002\u30c1\u30fc\u30e0\u30c7\u30b9\u30de\u30c3\u30c1\u306f\u6575\u30c1\u30fc\u30e0\u306e\u6bb2\u6ec5\u306b\u7126\u70b9\u3092\u5f53\u3066\u3001\u9663\u5730\u596a\u53d6\u306f\u6575\u306e\u65d7\u306e\u596a\u53d6\u3068\u8fd4\u9084\u3068\u3044\u3046\u6226\u7565\u7684\u306a\u8981\u7d20\u304c\u91cd\u8981\u3067\u3059\u3002\u30d0\u30c8\u30eb\u30ed\u30a4\u30e4\u30eb\u306f\u6700\u5f8c\u306e1\u4eba\u306b\u306a\u308b\u307e\u3067\u306e\u30e2\u30fc\u30c9\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30d0\u30c8\u30eb\u30ed\u30a4\u30e4\u30eb\u3067\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u6b66\u5668\u3092\u63a2\u3057\u6c42\u3081\u3001\u7e2e\u5c0f\u3059\u308b\u30d7\u30ec\u30a4\u30a8\u30ea\u30a2\u304b\u3089\u8eab\u3092\u96a0\u3059\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u3092\u7570\u306a\u308b\u30b9\u30dd\u30fc\u30c4\u306b\u4f8b\u3048\u308b\u306a\u3089\u3001\u305d\u308c\u305e\u308c\u72ec\u81ea\u306e\u30eb\u30fc\u30eb\u3068\u76ee\u6a19\u304c\u3042\u308a\u307e\u3059\u3002]"}, {"question": "War Brokers\u3067\u30b2\u30fc\u30e0\u8a2d\u5b9a\u3092\u6700\u9069\u5316\u3057\u3066\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5411\u4e0a\u3055\u305b\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "War Brokers\u306e\u8a2d\u5b9a\u3092\u6700\u9069\u5316\u3059\u308b\u3053\u3068\u3067\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30c6\u30af\u30b9\u30c1\u30e3\u306e\u54c1\u8cea\u3084\u5f71\u306e\u3088\u3046\u306a\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3092\u4e0b\u3052\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u4e0d\u8981\u306a\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u30a2\u30d7\u30ea\u30b1\u30fc\u30b7\u30e7\u30f3\u3092\u7121\u52b9\u306b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5b89\u5b9a\u3057\u305f\u30ec\u30a4\u30c6\u30f3\u30b7\u30fc\u3092\u5f97\u308b\u305f\u3081\u306b\u6709\u7dda\u30a4\u30f3\u30bf\u30fc\u30cd\u30c3\u30c8\u63a5\u7d9a\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30f3\u30c0\u30ea\u30f3\u30b0\u8ddd\u96e2\u3092\u7e2e\u5c0f\u3059\u308b\u3053\u3068\u3067\u3001\u4f4e\u6027\u80fd\u306a\u30b7\u30b9\u30c6\u30e0\u3067\u3082\u30d5\u30ec\u30fc\u30e0\u30ec\u30fc\u30c8\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002[\u8a2d\u5b9a\u8868\uff1a\u8a2d\u5b9a\uff5c\u63a8\u5968\u5024\uff5c\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3078\u306e\u5f71\u97ff]"}, {"question": "War Brokers\u3067\u30b2\u30fc\u30e0\u5185\u901a\u8ca8\u3092\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3059\u308b\u30d9\u30b9\u30c8\u30d7\u30e9\u30af\u30c6\u30a3\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b2\u30fc\u30e0\u5185\u901a\u8ca8\u3092\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3059\u308b\u306b\u306f\u3001\u5fc5\u8981\u306a\u8cfc\u5165\u306b\u512a\u5148\u9806\u4f4d\u3092\u4ed8\u3051\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u81ea\u5206\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u5408\u3063\u305f\u6b66\u5668\u3084\u30a2\u30fc\u30de\u30fc\u3092\u8cfc\u5165\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5f37\u529b\u306a\u6b66\u5668\u3084\u30b9\u30ad\u30f3\u3068\u3044\u3063\u305f\u9ad8\u30a4\u30f3\u30d1\u30af\u30c8\u30a2\u30a4\u30c6\u30e0\u306e\u305f\u3081\u306b\u901a\u8ca8\u3092\u7bc0\u7d04\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30a4\u30d9\u30f3\u30c8\u306b\u53c2\u52a0\u3057\u3066\u8ffd\u52a0\u306e\u901a\u8ca8\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u521d\u671f\u6bb5\u968e\u3067\u72d9\u6483\u30e9\u30a4\u30d5\u30eb\u3092\u8cfc\u5165\u3059\u308b\u3053\u3068\u3067\u3001\u6226\u7565\u7684\u306a\u512a\u4f4d\u6027\u3092\u7bc9\u304f\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u65e9\u671f\u8cfc\u5165\u3068\u5f8c\u671f\u30b2\u30fc\u30e0\u3078\u306e\u8caf\u84c4]"}, {"question": "War Brokers\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "War Brokers\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b9\u30ad\u30eb\u3068\u7d4c\u9a13\u306b\u57fa\u3065\u3044\u3066\u30c1\u30fc\u30e0\u3092\u30d0\u30e9\u30f3\u30b9\u3055\u305b\u307e\u3059\u3002\u52dd\u6557\u7387\u3084\u30ad\u30eb\u30c7\u30b9\u6bd4\u306a\u3069\u306e\u8981\u56e0\u3092\u8003\u616e\u3059\u308b\u3053\u3068\u3067\u3001\u516c\u6b63\u306a\u30de\u30c3\u30c1\u30f3\u30b0\u3092\u5b9f\u73fe\u3059\u308b\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u3092\u4f7f\u7528\u3057\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u901a\u5e38\u3001\u5727\u5012\u7684\u306a\u6311\u6226\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u3001\u540c\u69d8\u306e\u7d4c\u9a13\u3092\u6301\u3064\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u30de\u30c3\u30c1\u30f3\u30b0\u3055\u308c\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30de\u30c3\u30c1\u30f3\u30b0\u30d7\u30ed\u30bb\u30b9]"}, {"question": "PC\u7248\u306eWar Brokers\u306e\u9032\u884c\u72b6\u6cc1\u3092\u30e2\u30d0\u30a4\u30eb\u7248\u306b\u79fb\u884c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u73fe\u5728\u3001War Brokers\u306f\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u9032\u884c\u72b6\u6cc1\u306e\u79fb\u884c\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u307e\u305b\u3093\u3002PC\u7248\u306e\u9032\u884c\u72b6\u6cc1\u306f\u30e2\u30d0\u30a4\u30eb\u7248\u3068\u306f\u72ec\u7acb\u3057\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001PC\u7248\u3067\u6b66\u5668\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u3066\u3082\u3001\u30e2\u30d0\u30a4\u30eb\u7248\u306e\u30a2\u30ab\u30a6\u30f3\u30c8\u3067\u306f\u5229\u7528\u3067\u304d\u307e\u305b\u3093\u3002[\u4f8b\u3048\uff1a\u7570\u306a\u308b2\u3064\u306e\u56f3\u66f8\u9928\u3092\u6301\u3064\u3088\u3046\u306b\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u5404\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u306f\u72ec\u81ea\u306e\u53ce\u96c6\u54c1\u304c\u3042\u308a\u307e\u3059\u3002]"}, {"question": "War Brokers\u306b\u306f\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3084\u79d8\u5bc6\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "War Brokers\u306b\u306f\u8907\u6570\u306e\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30de\u30c3\u30d7\u300c\u68ee\u300d\u306b\u306f\u7279\u5225\u306a\u6b66\u5668\u304c\u5165\u3063\u305f\u96a0\u3055\u308c\u305f\u6d1e\u7a9f\u304c\u3042\u308a\u307e\u3059\u3002\u666e\u6bb5\u884c\u304b\u306a\u3044\u30a8\u30ea\u30a2\u3092\u63a2\u691c\u3059\u308b\u3053\u3068\u3067\u3001\u3053\u308c\u3089\u306e\u79d8\u5bc6\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u96a0\u3055\u308c\u305f\u5b9d\u7269\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u597d\u5947\u5fc3\u65fa\u76db\u3067\u5192\u967a\u5fc3\u306e\u3042\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u5831\u3044\u3066\u304f\u308c\u307e\u3059\u3002]"}]
[{"question": "\u5982\u4f55\u63d0\u9ad8\u6211\u5728\u300a\u6218\u4e89\u7ecf\u7eaa\u4eba\u300b\u4e2d\u7684\u65b0\u624b\u7784\u51c6\u7cbe\u5ea6\uff1f", "answer": "\u8981\u63d0\u9ad8\u300a\u6218\u4e89\u7ecf\u7eaa\u4eba\u300b\u4e2d\u7684\u7784\u51c6\u7cbe\u5ea6\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u5728\u8bbe\u7f6e\u4e2d\u8c03\u6574\u9f20\u6807\u7075\u654f\u5ea6\u5230\u8212\u9002\u7684\u6c34\u5e73\u3002\u6b65\u9aa42\uff1a\u5728\u8bad\u7ec3\u6a21\u5f0f\u4e2d\u7ec3\u4e60\u4ee5\u719f\u6089\u4e0d\u540c\u6b66\u5668\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u72d9\u51fb\u6b65\u67aa\u4e13\u6ce8\u4e8e\u7cbe\u786e\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u201c\u6c99\u6f20\u201d\u5730\u56fe\u4e2d\uff0c\u8ba9\u81ea\u5df1\u5904\u5728\u9ad8\u5730\uff0c\u4ee5\u83b7\u5f97\u6e05\u6670\u7684\u654c\u4eba\u89c6\u91ce\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u7784\u51c6\u60f3\u8c61\u6210\u5f00\u8f66\uff1b\u7ec3\u4e60\u8d8a\u591a\uff0c\u63a7\u5236\u5c31\u8d8a\u5e73\u7a33\u3002]"}, {"question": "\u300a\u6218\u4e89\u7ecf\u7eaa\u4eba\u300b\u4e2d\u56e2\u961f\u5408\u4f5c\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u6218\u4e89\u7ecf\u7eaa\u4eba\u300b\u4e2d\u6709\u6548\u7684\u56e2\u961f\u5408\u4f5c\u9700\u8981\u6c9f\u901a\u548c\u89d2\u8272\u5206\u914d\u3002\u6b65\u9aa41\uff1a\u4f7f\u7528\u6e38\u620f\u5185\u7684\u804a\u5929\u6216\u8bed\u97f3\u901a\u4fe1\u8fdb\u884c\u534f\u8c03\u3002\u6b65\u9aa42\uff1a\u5206\u914d\u4f8b\u5982\u72d9\u51fb\u624b\u3001\u533b\u62a4\u4eba\u5458\u548c\u7a81\u51fb\u961f\u5458\u7b49\u89d2\u8272\uff0c\u4ee5\u5e73\u8861\u56e2\u961f\u3002\u6b65\u9aa43\uff1a\u4e13\u6ce8\u4e8e\u76ee\u6807\uff0c\u4f8b\u5982\u5360\u9886\u636e\u70b9\u6216\u62a4\u9001\u8865\u7ed9\u3002\u4f8b\u5982\uff0c\u5728\u201c\u57ce\u5e02\u201d\u5730\u56fe\u4e2d\uff0c\u4e00\u4e2a\u534f\u8c03\u826f\u597d\u7684\u56e2\u961f\u53ef\u4ee5\u901a\u8fc7\u63a7\u5236\u5173\u952e\u7684\u9698\u53e3\u6765\u5360\u636e\u4f18\u52bf\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u89d2\u8272 | \u6b66\u5668 | \u7b56\u7565]"}, {"question": "\u300a\u6218\u4e89\u7ecf\u7eaa\u4eba\u300b\u4e2d\u8fd1\u8ddd\u79bb\u6218\u6597\u6700\u6709\u6548\u7684\u6b66\u5668\u6709\u54ea\u4e9b\uff1f", "answer": "\u5728\u8fd1\u8ddd\u79bb\u6218\u6597\u4e2d\uff0c\u6563\u5f39\u67aa\u548c\u51b2\u950b\u67aa\u975e\u5e38\u6709\u6548\u3002\u6563\u5f39\u67aa\u5728\u8fd1\u8ddd\u79bb\u63d0\u4f9b\u9ad8\u4f24\u5bb3\uff0c\u800c\u51b2\u950b\u67aa\u5219\u63d0\u4f9b\u5feb\u901f\u5c04\u51fb\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5de5\u5382\u201d\u5730\u56fe\u4e2d\uff0c\u5728\u72ed\u7a84\u7684\u8d70\u5eca\u91cc\u4f7f\u7528\u6563\u5f39\u67aa\u53ef\u4ee5\u8fc5\u901f\u6d88\u706d\u654c\u4eba\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6563\u5f39\u67aa\u4e0e\u51b2\u950b\u67aa\u5728\u4f24\u5bb3\u3001\u5c04\u7a0b\u548c\u5c04\u51fb\u901f\u5ea6\u65b9\u9762\u7684\u6bd4\u8f83\u3002]"}, {"question": "\u300a\u6218\u4e89\u7ecf\u7eaa\u4eba\u300b\u4e2d\u7684\u62a4\u7532\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u300a\u6218\u4e89\u7ecf\u7eaa\u4eba\u300b\u4e2d\u7684\u62a4\u7532\u7cfb\u7edf\u4f1a\u964d\u4f4e\u53d7\u5230\u7684\u4f24\u5bb3\u3002\u62a4\u7532\u53ef\u4ee5\u4ece\u6218\u573a\u4e0a\u62fe\u53d6\u6216\u5728\u5546\u5e97\u8d2d\u4e70\u3002\u6bcf\u4ef6\u62a4\u7532\u90fd\u6709\u8010\u4e45\u5ea6\uff0c\u968f\u7740\u53d7\u5230\u7684\u4f24\u5bb3\u800c\u964d\u4f4e\u3002\u4f8b\u5982\uff0c\u7a7f\u7740\u5168\u5957\u62a4\u7532\u53ef\u4ee5\u5c06\u72d9\u51fb\u67aa\u7684\u4f24\u5bb3\u4ece 100 \u964d\u4f4e\u5230 70\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u62a4\u7532\u7684\u4f24\u5bb3\u8ba1\u7b97]"}, {"question": "\u300a\u6218\u4e89\u7ecf\u7eaa\u4eba\u300b\u4e2d\u5404\u79cd\u6e38\u620f\u6a21\u5f0f\u4e4b\u95f4\u7684\u4e3b\u8981\u533a\u522b\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u6218\u4e89\u7ecf\u7eaa\u4eba\u300b\u63d0\u4f9b\u4e86\u51e0\u79cd\u6e38\u620f\u6a21\u5f0f\uff1a\u56e2\u961f\u6b7b\u4ea1\u7ade\u8d5b\u3001\u593a\u65d7\u548c\u751f\u5b58\u7ade\u8d5b\u3002\u56e2\u961f\u6b7b\u4ea1\u7ade\u8d5b\u4e13\u6ce8\u4e8e\u6d88\u706d\u5bf9\u624b\u56e2\u961f\uff1b\u593a\u65d7\u9700\u8981\u6218\u7565\u6765\u593a\u53d6\u548c\u8fd4\u8fd8\u654c\u65b9\u65d7\u5e1c\uff1b\u751f\u5b58\u7ade\u8d5b\u662f\u6700\u540e\u4e00\u4eba\u83b7\u80dc\u7684\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u5728\u751f\u5b58\u7ade\u8d5b\u4e2d\uff0c\u73a9\u5bb6\u5fc5\u987b\u641c\u5bfb\u6b66\u5668\u5e76\u907f\u5f00\u7f29\u5c0f\u7684\u6e38\u620f\u533a\u57df\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u6e38\u620f\u6a21\u5f0f\u60f3\u8c61\u6210\u4e0d\u540c\u7684\u8fd0\u52a8\uff1b\u6bcf\u79cd\u8fd0\u52a8\u90fd\u6709\u5176\u89c4\u5219\u548c\u76ee\u6807\u3002]"}, {"question": "\u5982\u4f55\u4f18\u5316\u6211\u7684\u6e38\u620f\u8bbe\u7f6e\u4ee5\u83b7\u5f97\u66f4\u597d\u7684\u300a\u6218\u4e89\u7ecf\u7eaa\u4eba\u300b\u6e38\u620f\u6027\u80fd\uff1f", "answer": "\u4f18\u5316\u300a\u6218\u4e89\u7ecf\u7eaa\u4eba\u300b\u4e2d\u7684\u8bbe\u7f6e\u53ef\u4ee5\u63d0\u9ad8\u6e38\u620f\u6027\u80fd\u3002\u6b65\u9aa41\uff1a\u964d\u4f4e\u56fe\u5f62\u8bbe\u7f6e\uff0c\u4f8b\u5982\u6750\u8d28\u8d28\u91cf\u548c\u9634\u5f71\u3002\u6b65\u9aa42\uff1a\u7981\u7528\u4e0d\u5fc5\u8981\u7684\u540e\u53f0\u5e94\u7528\u7a0b\u5e8f\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u6709\u7ebf\u4e92\u8054\u7f51\u8fde\u63a5\u4ee5\u83b7\u5f97\u7a33\u5b9a\u7684\u5ef6\u8fdf\u3002\u4f8b\u5982\uff0c\u964d\u4f4e\u6e32\u67d3\u8ddd\u79bb\u53ef\u4ee5\u5728\u4f4e\u7aef\u7cfb\u7edf\u4e0a\u663e\u8457\u63d0\u9ad8\u5e27\u901f\u7387\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u8bbe\u7f6e | \u5efa\u8bae\u503c | \u5bf9\u6027\u80fd\u7684\u5f71\u54cd]"}, {"question": "\u5728\u300a\u6218\u4e89\u7ecf\u7eaa\u4eba\u300b\u4e2d\u5982\u4f55\u6709\u6548\u5730\u7ba1\u7406\u6e38\u620f\u5185\u8d27\u5e01\uff1f", "answer": "\u6709\u6548\u7ba1\u7406\u6e38\u620f\u5185\u8d27\u5e01\u9700\u8981\u4f18\u5148\u8003\u8651\u5fc5\u8981\u7684\u8d2d\u4e70\u3002\u6b65\u9aa41\uff1a\u8d2d\u4e70\u9002\u5408\u4f60\u6e38\u620f\u98ce\u683c\u7684\u6b66\u5668\u548c\u62a4\u7532\u3002\u6b65\u9aa42\uff1a\u4fdd\u5b58\u8d27\u5e01\u7528\u4e8e\u9ad8\u4ef7\u503c\u7269\u54c1\uff0c\u4f8b\u5982\u5f3a\u5927\u7684\u6b66\u5668\u6216\u76ae\u80a4\u3002\u6b65\u9aa43\uff1a\u53c2\u4e0e\u6d3b\u52a8\u4ee5\u8d5a\u53d6\u989d\u5916\u8d27\u5e01\u3002\u4f8b\u5982\uff0c\u5c3d\u65e9\u8d2d\u4e70\u72d9\u51fb\u6b65\u67aa\u53ef\u4ee5\u8ba9\u4f60\u5728\u6218\u7565\u4e0a\u83b7\u5f97\u4f18\u52bf\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u63d0\u524d\u8d2d\u4e70\u4e0e\u4e3a\u540e\u671f\u6e38\u620f\u4fdd\u5b58]"}, {"question": "\u300a\u6218\u4e89\u7ecf\u7eaa\u4eba\u300b\u7684\u5339\u914d\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u300a\u6218\u4e89\u7ecf\u7eaa\u4eba\u300b\u7684\u5339\u914d\u7cfb\u7edf\u6839\u636e\u73a9\u5bb6\u7684\u6280\u80fd\u548c\u7ecf\u9a8c\u6765\u5e73\u8861\u56e2\u961f\u3002\u5b83\u4f7f\u7528\u7b97\u6cd5\u6765\u786e\u4fdd\u516c\u5e73\u7684\u5339\u914d\uff0c\u901a\u8fc7\u8003\u8651\u8bf8\u5982\u80dc\u8d1f\u7387\u548c\u51fb\u6740/\u6b7b\u4ea1\u7387\u7b49\u56e0\u7d20\u3002\u4f8b\u5982\uff0c\u65b0\u73a9\u5bb6\u901a\u5e38\u4f1a\u4e0e\u7ecf\u9a8c\u76f8\u4f3c\u7684\u5176\u4ed6\u73a9\u5bb6\u5339\u914d\uff0c\u4ee5\u907f\u514d\u8fc7\u4e8e\u56f0\u96be\u7684\u6311\u6218\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u5339\u914d\u8fc7\u7a0b]"}, {"question": "\u6211\u53ef\u4ee5\u5c06\u6211\u7684\u300a\u6218\u4e89\u7ecf\u7eaa\u4eba\u300bPC\u8fdb\u5ea6\u8f6c\u79fb\u5230\u79fb\u52a8\u7aef\u5417\uff1f", "answer": "\u76ee\u524d\uff0c\u300a\u6218\u4e89\u7ecf\u7eaa\u4eba\u300b\u4e0d\u652f\u6301\u8de8\u5e73\u53f0\u8fdb\u5ea6\u8f6c\u79fb\u3002\u60a8\u5728 PC \u4e0a\u7684\u8fdb\u5ea6\u4e0e\u79fb\u52a8\u7aef\u662f\u5206\u5f00\u7684\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728 PC \u4e0a\u89e3\u9501\u4e86\u4e00\u4ef6\u6b66\u5668\uff0c\u5b83\u4e0d\u4f1a\u51fa\u73b0\u5728\u4f60\u7684\u79fb\u52a8\u7aef\u8d26\u6237\u4e0a\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u53ef\u4ee5\u5c06\u5b83\u60f3\u8c61\u6210\u4e24\u4e2a\u4e0d\u540c\u7684\u56fe\u4e66\u9986\uff1b\u6bcf\u4e2a\u5e73\u53f0\u90fd\u6709\u5b83\u81ea\u5df1\u7684\u6536\u85cf\u3002]"}, {"question": "\u300a\u6218\u4e89\u7ecf\u7eaa\u4eba\u300b\u4e2d\u662f\u5426\u6709\u4efb\u4f55\u9690\u85cf\u7684\u5f69\u86cb\u6216\u79d8\u5bc6\uff1f", "answer": "\u300a\u6218\u4e89\u7ecf\u7eaa\u4eba\u300b\u4e2d\u6709\u51e0\u4e2a\u9690\u85cf\u7684\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u5728\u201c\u68ee\u6797\u201d\u5730\u56fe\u4e2d\uff0c\u6709\u4e00\u4e2a\u9690\u85cf\u7684\u5c71\u6d1e\uff0c\u5176\u4e2d\u5305\u542b\u4e00\u4ef6\u7279\u6b8a\u7684\u6b66\u5668\u3002\u63a2\u7d22\u90a3\u4e9b\u4e0d\u5e38\u53bb\u7684\u5730\u65b9\u53ef\u4ee5\u53d1\u73b0\u8fd9\u4e9b\u79d8\u5bc6\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u5f69\u86cb\u60f3\u8c61\u6210\u9690\u85cf\u7684\u5b9d\u85cf\uff1b\u5b83\u4eec\u5956\u52b1\u90a3\u4e9b\u597d\u5947\u548c\u6709\u5192\u9669\u7cbe\u795e\u7684\u4eba\u3002]"}]
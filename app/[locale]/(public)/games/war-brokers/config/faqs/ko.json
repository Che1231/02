[{"question": "\ucd08\ubcf4\uc790\ub85c\uc11c War Brokers\uc5d0\uc11c \uc870\uc900 \uc815\ud655\ub3c4\ub97c \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\ub098\uc694?", "answer": "War Brokers\uc5d0\uc11c \uc870\uc900 \uc815\ud655\ub3c4\ub97c \ub192\uc774\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: \ub2e8\uacc4 1: \uc124\uc815\uc5d0\uc11c \ub9c8\uc6b0\uc2a4 \ubbfc\uac10\ub3c4\ub97c \ud3b8\uc548\ud55c \uc218\uc900\uc73c\ub85c \uc870\uc815\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ub2e4\uc591\ud55c \ubb34\uae30\ub97c \uc775\ud788\uae30 \uc704\ud574 \uc5f0\uc2b5 \ubaa8\ub4dc\uc5d0\uc11c \uc5f0\uc2b5\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc815\ubc00\uc131\uc5d0 \uc9d1\uc911\ud558\uae30 \uc704\ud574 \uc2a4\ub098\uc774\ud37c \ub77c\uc774\ud50c\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc0ac\ub9c9' \uc9c0\ub3c4\uc5d0\uc11c \uc801\uc758 \uc2dc\uc57c\ub97c \ud655\ubcf4\ud558\uae30 \uc704\ud574 \uace0\uc9c0\ub300\uc5d0 \uc704\uce58\ud558\uc2ed\uc2dc\uc624. [\ube44\uc720: \uc870\uc900\uc744 \uc790\ub3d9\ucc28 \uc6b4\uc804\uc5d0 \ube44\uc720\ud558\uba74, \uc5f0\uc2b5\ud560\uc218\ub85d \uc81c\uc5b4\uac00 \ub354\uc6b1 \uc6d0\ud65c\ud574\uc9d1\ub2c8\ub2e4.]"}, {"question": "War Brokers\uc5d0\uc11c \ud300 \ud50c\ub808\uc774\ub97c \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "War Brokers\uc5d0\uc11c \ud6a8\uacfc\uc801\uc778 \ud300 \ud50c\ub808\uc774\ub294 \uc18c\ud1b5\uacfc \uc5ed\ud560 \ubd84\ub2f4\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \uac8c\uc784 \ub0b4 \ucc44\ud305 \ub610\ub294 \uc74c\uc131 \ucc44\ud305\uc744 \ud1b5\ud574 \ud611\ub825\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \uc2a4\ub098\uc774\ud37c, \uc758\ubb34\ubcd1, \uacf5\uaca9\ub300\uc6d0\uacfc \uac19\uc740 \uc5ed\ud560\uc744 \ubd84\ub2f4\ud558\uc5ec \ud300\uc744 \uade0\ud615 \uc788\uac8c \ub9cc\ub4dc\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \uc9c0\uc810 \ud68d\ub4dd\uc774\ub098 \ubcf4\uae09\ud488 \ud638\uc1a1\uacfc \uac19\uc740 \ubaa9\ud45c\uc5d0 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\ub3c4\uc2dc' \uc9c0\ub3c4\uc5d0\uc11c \uc798 \uc870\uc815\ub41c \ud300\uc740 \uc8fc\uc694 \uc9c0\uc810\uc744 \uc7a5\uc545\ud558\uc5ec \uc6b0\uc704\ub97c \uc810\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud45c: \uc5ed\ud560 | \ubb34\uae30 | \uc804\ub7b5]"}, {"question": "War Brokers\uc5d0\uc11c \uadfc\uc811\uc804\uc5d0 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ubb34\uae30\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uadfc\uc811\uc804\uc5d0\uc11c \uc0b0\ud0c4\ucd1d\uacfc \uae30\uad00\ub2e8\ucd1d\uc774 \ub9e4\uc6b0 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. \uc0b0\ud0c4\ucd1d\uc740 \uadfc\uc811 \uac70\ub9ac\uc5d0\uc11c \ub192\uc740 \ud53c\ud574\ub97c \uc785\ud788\uace0, \uae30\uad00\ub2e8\ucd1d\uc740 \ube60\ub978 \uc0ac\uaca9 \uc18d\ub3c4\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uacf5\uc7a5' \uc9c0\ub3c4\uc5d0\uc11c \uc881\uc740 \ubcf5\ub3c4\uc5d0\uc11c \uc0b0\ud0c4\ucd1d\uc744 \uc0ac\uc6a9\ud558\uba74 \uc801\uc744 \uc2e0\uc18d\ud558\uac8c \uc81c\uac70\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uad50: \uc0b0\ud0c4\ucd1d \ub300 \uae30\uad00\ub2e8\ucd1d, \ud53c\ud574, \uc0ac\uc815\uac70\ub9ac, \uc0ac\uaca9 \uc18d\ub3c4 \ube44\uad50]"}, {"question": "War Brokers\uc758 \uc7a5\uac11 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "War Brokers\uc758 \uc7a5\uac11 \uc2dc\uc2a4\ud15c\uc740 \ubc1b\ub294 \ud53c\ud574\ub97c \uc904\uc5ec\uc90d\ub2c8\ub2e4. \uc7a5\uac11\uc740 \uc804\uc7a5\uc5d0\uc11c \ud68d\ub4dd\ud558\uac70\ub098 \uc0c1\uc810\uc5d0\uc11c \uad6c\ub9e4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac01 \uc7a5\uac11 \uc870\uac01\uc740 \ubc1b\uc740 \ud53c\ud574\uc5d0 \ub530\ub77c \ub0b4\uad6c\ub3c4\uac00 \uac10\uc18c\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc644\uc804\ud55c \uc7a5\uac11\uc744 \ucc29\uc6a9\ud558\uba74 \uc2a4\ub098\uc774\ud37c\uc758 100\uc758 \ud53c\ud574\ub97c 70\uc73c\ub85c \uc904\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub3c4\ud45c: \uc7a5\uac11\uc744 \uace0\ub824\ud55c \ud53c\ud574 \uacc4\uc0b0]"}, {"question": "War Brokers\uc758 \ub2e4\uc591\ud55c \uac8c\uc784 \ubaa8\ub4dc \uac04\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "War Brokers\ub294 \ud300 \ub370\uc2a4\ub9e4\uce58, \uae43\ubc1c \ud0c8\ud658, \ubc30\ud2c0 \ub85c\uc584 \ub4f1 \uc5ec\ub7ec \uac8c\uc784 \ubaa8\ub4dc\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ud300 \ub370\uc2a4\ub9e4\uce58\ub294 \uc0c1\ub300 \ud300\uc744 \uc81c\uac70\ud558\ub294 \ub370 \ucd08\uc810\uc744 \ub9de\ucd94\uace0, \uae43\ubc1c \ud0c8\ud658\uc740 \uc801\uc758 \uae43\ubc1c\uc744 \ud68d\ub4dd\ud558\uace0 \ubc18\ud658\ud558\ub294 \uc804\ub7b5\uc774 \ud544\uc694\ud558\uba70, \ubc30\ud2c0 \ub85c\uc584\uc740 \ub9c8\uc9c0\ub9c9 \uc0dd\uc874\uc790\ub97c \uac00\ub9ac\ub294 \ubaa8\ub4dc\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubc30\ud2c0 \ub85c\uc584\uc5d0\uc11c\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \ubb34\uae30\ub97c \uc218\uc9d1\ud558\uace0 \uc904\uc5b4\ub4dc\ub294 \ud50c\ub808\uc774 \uc601\uc5ed\uc744 \ud53c\ud574\uc57c \ud569\ub2c8\ub2e4. [\ube44\uc720: \uac8c\uc784 \ubaa8\ub4dc\ub294 \uac01\uae30 \ub2e4\ub978 \uc2a4\ud3ec\uce20\uc640 \uac19\uc2b5\ub2c8\ub2e4. \uac01\uac01 \uace0\uc720\ud55c \uaddc\uce59\uacfc \ubaa9\ud45c\uac00 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "War Brokers\uc5d0\uc11c \uac8c\uc784 \uc124\uc815\uc744 \ucd5c\uc801\ud654\ud558\uc5ec \uc131\ub2a5\uc744 \uac1c\uc120\ud560 \uc218 \uc788\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "War Brokers\uc5d0\uc11c \uc124\uc815\uc744 \ucd5c\uc801\ud654\ud558\uba74 \uc131\ub2a5\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \ud14d\uc2a4\ucc98 \ud488\uc9c8 \ubc0f \uadf8\ub9bc\uc790\uc640 \uac19\uc740 \uadf8\ub798\ud53d \uc124\uc815\uc744 \ub0ae\ucda5\ub2c8\ub2e4. \ub2e8\uacc4 2: \ubd88\ud544\uc694\ud55c \ubc30\uacbd \uc751\uc6a9 \ud504\ub85c\uadf8\ub7a8\uc744 \ube44\ud65c\uc131\ud654\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc548\uc815\uc801\uc778 \ub51c\ub808\uc774\ub97c \uc704\ud574 \uc720\uc120 \uc778\ud130\ub137 \uc5f0\uacb0\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub80c\ub354\ub9c1 \uac70\ub9ac\ub97c \uc904\uc774\uba74 \uc800\uc0ac\uc591 \uc2dc\uc2a4\ud15c\uc5d0\uc11c \ud504\ub808\uc784 \uc18d\ub3c4\ub97c \ud06c\uac8c \uac1c\uc120\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud45c: \uc124\uc815 | \uad8c\uc7a5 \uac12 | \uc131\ub2a5 \uc601\ud5a5]"}, {"question": "War Brokers\uc5d0\uc11c \uac8c\uc784 \ub0b4 \ud1b5\ud654\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \ucd5c\uc120\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uac8c\uc784 \ub0b4 \ud1b5\ud654\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub824\uba74 \ud544\uc218 \uad6c\ub9e4\uc5d0 \uc6b0\uc120\uc21c\uc704\ub97c \ub450\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc790\uc2e0\uc758 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\ub294 \ubb34\uae30\uc640 \uc7a5\uac11\uc744 \uad6c\ub9e4\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uac15\ub825\ud55c \ubb34\uae30\ub098 \uc2a4\ud0a8\uacfc \uac19\uc740 \ub192\uc740 \ud6a8\uacfc\ub97c \ubc1c\ud718\ud558\ub294 \uc544\uc774\ud15c\uc744 \uc704\ud574 \ud1b5\ud654\ub97c \uc800\ucd95\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc774\ubca4\ud2b8\uc5d0 \ucc38\uc5ec\ud558\uc5ec \ucd94\uac00 \ud1b5\ud654\ub97c \ud68d\ub4dd\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucd08\uae30\uc5d0 \uc2a4\ub098\uc774\ud37c \ub77c\uc774\ud50c\uc744 \uad6c\ub9e4\ud558\uba74 \uc804\ub7b5\uc801 \uc6b0\uc704\ub97c \ud655\ubcf4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uad50: \uc870\uae30 \uad6c\ub9e4 \ub300 \ud6c4\ubc18 \uc800\ucd95]"}, {"question": "War Brokers\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "War Brokers\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uc758 \uae30\uc220\uacfc \uacbd\ud5d8\uc744 \uae30\uc900\uc73c\ub85c \ud300\uc744 \uade0\ud615 \uc788\uac8c \ub9cc\ub4ed\ub2c8\ub2e4. \uc2b9\ub960\uacfc \ud0ac\ub383 \ube44\uc728\uacfc \uac19\uc740 \uc694\uc18c\ub4e4\uc744 \uace0\ub824\ud558\uc5ec \uacf5\uc815\ud55c \ub9e4\uce58\ub97c \ubcf4\uc7a5\ud558\ub294 \uc54c\uace0\ub9ac\uc998\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub294 \uc77c\ubc18\uc801\uc73c\ub85c \uc555\ub3c4\uc801\uc778 \uacbd\ud5d8\uc744 \ud53c\ud558\uae30 \uc704\ud574 \ube44\uc2b7\ud55c \uacbd\ud5d8\uc744 \uac00\uc9c4 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub4e4\uacfc \ub9e4\uce6d\ub429\ub2c8\ub2e4. [\ub3c4\ud45c: \ub9e4\uce6d \ud504\ub85c\uc138\uc2a4]"}, {"question": "PC\uc5d0\uc11c \ubaa8\ubc14\uc77c\ub85c War Brokers\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud604\uc7ac War Brokers\ub294 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \uc9c4\ud589 \uc0c1\ud669 \uc774\uc804\uc744 \uc9c0\uc6d0\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. PC\uc5d0\uc11c\uc758 \uc9c4\ud589 \uc0c1\ud669\uc740 \ubaa8\ubc14\uc77c\uacfc \ubd84\ub9ac\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ubb34\uae30\ub97c \ud574\uc81c\ud558\uba74 \ubaa8\ubc14\uc77c \uacc4\uc815\uc5d0\uc11c \uc0ac\uc6a9\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. [\ube44\uc720: \ub450 \uac1c\uc758 \uc11c\ub85c \ub2e4\ub978 \ub3c4\uc11c\uad00\uc774 \uc788\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uac01 \ud50c\ub7ab\ud3fc\uc5d0\ub294 \uace0\uc720\ud55c \uceec\ub809\uc158\uc774 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "War Brokers\uc5d0\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8 \ub610\ub294 \ube44\ubc00\uc774 \uc788\ub098\uc694?", "answer": "War Brokers\uc5d0\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc232' \uc9c0\ub3c4\uc5d0\ub294 \ud2b9\uc218 \ubb34\uae30\ub97c \ubcf4\uc720\ud55c \uc228\uaca8\uc9c4 \ub3d9\uad74\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc775\uc219\ud558\uc9c0 \uc54a\uc740 \uc9c0\uc5ed\uc744 \ud0d0\ud5d8\ud558\uba74 \uc774\ub7ec\ud55c \ube44\ubc00\uc744 \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720: \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ud638\uae30\uc2ec\uacfc \ubaa8\ud5d8\uc2ec\uc744 \uac00\uc9c4 \uc0ac\ub78c\ub4e4\uc5d0\uac8c \uc0c1\uc744 \uc90d\ub2c8\ub2e4.]"}]
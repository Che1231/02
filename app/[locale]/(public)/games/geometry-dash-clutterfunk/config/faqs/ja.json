[{"question": "Geometry Dash Clutterfunk\u3067\u30ad\u30e5\u30fc\u30d6\u3092\u521d\u5fc3\u8005\u3067\u3082\u52b9\u679c\u7684\u306b\u64cd\u4f5c\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Geometry Dash Clutterfunk\u3067\u30ad\u30e5\u30fc\u30d6\u3092\u52b9\u679c\u7684\u306b\u64cd\u4f5c\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002STEP1 - \u753b\u9762\u3092\u30bf\u30c3\u30d7\u3057\u305f\u308a\u3001\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u3092\u62bc\u3057\u305f\u308a\u3057\u3066\u3001\u57fa\u672c\u7684\u306a\u30b8\u30e3\u30f3\u30d7\u306e\u7df4\u7fd2\u3092\u3057\u307e\u3059\u3002STEP2 - \u30b8\u30e3\u30f3\u30d7\u3092\u6b63\u78ba\u306b\u30bf\u30a4\u30df\u30f3\u30b0\u5408\u308f\u305b\u3059\u308b\u305f\u3081\u306b\u306f\u3001\u97f3\u697d\u306e\u30ea\u30ba\u30e0\u306b\u96c6\u4e2d\u3057\u307e\u3059\u3002STEP3 - \u7b4b\u30c8\u30ec\u3092\u69cb\u7bc9\u3059\u308b\u305f\u3081\u306b\u3001\u3088\u308a\u96e3\u6613\u5ea6\u306e\u4f4e\u3044\u30ec\u30d9\u30eb\u304b\u3089\u59cb\u3081\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001Clutterfunk\u306e\u6700\u521d\u306e\u30bb\u30af\u30b7\u30e7\u30f3\u3067\u306f\u3001\u969c\u5bb3\u7269\u3092\u907f\u3051\u306a\u304c\u3089\u30b8\u30e3\u30f3\u30d7\u3092\u30d3\u30fc\u30c8\u306b\u5408\u308f\u305b\u3066\u540c\u671f\u3055\u305b\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u30ad\u30e5\u30fc\u30d6\u3092\u3001\u9069\u5207\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u5730\u9762\u306b\u5f53\u305f\u308b\u5fc5\u8981\u304c\u3042\u308b\u8df3\u306d\u8fd4\u308b\u30dc\u30fc\u30eb\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "Geometry Dash Clutterfunk\u306e\u8239\u306e\u30bb\u30af\u30b7\u30e7\u30f3\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u305f\u3081\u306e\u4e3b\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Geometry Dash Clutterfunk\u306e\u8239\u306e\u30bb\u30af\u30b7\u30e7\u30f3\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u70b9\u304c\u5fc5\u8981\u3067\u3059\u3002STEP1 - \u30b8\u30e3\u30f3\u30d7\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u3066\u3044\u308b\u9593\u3068\u96e2\u3057\u3066\u3044\u308b\u9593\u3067\u3001\u8239\u306e\u4e0a\u6607\u3068\u4e0b\u964d\u3092\u5236\u5fa1\u3059\u308b\u65b9\u6cd5\u3092\u5b66\u3073\u307e\u3059\u3002STEP2 - \u969c\u5bb3\u7269\u306e\u914d\u7f6e\u3092\u899a\u3048\u3066\u3001\u52d5\u304d\u3092\u4e88\u6e2c\u3057\u307e\u3059\u3002STEP3 - \u7df4\u7fd2\u30e2\u30fc\u30c9\u3092\u4f7f\u7528\u3057\u3066\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5fae\u8abf\u6574\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001Clutterfunk\u306e\u4e2d\u9593\u30bb\u30af\u30b7\u30e7\u30f3\u3067\u306f\u3001\u77ed\u3044\u62bc\u4e0b\u3068\u9577\u3044\u62bc\u4e0b\u306e\u4ea4\u4e92\u4f7f\u7528\u3067\u3001\u72ed\u3044\u901a\u8def\u3092\u79fb\u52d5\u3057\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u8aac\u660e\uff1a\u8239\u306e\u7d4c\u8def\u3092\u3001\u969c\u5bb3\u7269\u306e\u30d1\u30bf\u30fc\u30f3\u306b\u5408\u308f\u305b\u308b\u5fc5\u8981\u304c\u3042\u308b\u6ce2\u3068\u3057\u3066\u8996\u899a\u5316\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "Geometry Dash Clutterfunk\u3067\u3001\u52d5\u304d\u3092\u97f3\u697d\u3068\u540c\u671f\u3055\u305b\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "Geometry Dash Clutterfunk\u3067\u3001\u52d5\u304d\u3092\u97f3\u697d\u3068\u540c\u671f\u3055\u305b\u308b\u3053\u3068\u306f\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u306a\u305c\u306a\u3089\u3001\u30ec\u30d9\u30eb\u30c7\u30b6\u30a4\u30f3\u306f\u30ea\u30ba\u30e0\u306b\u57fa\u3065\u3044\u3066\u3044\u308b\u304b\u3089\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001Clutterfunk\u306e\u6700\u7d42\u30bb\u30af\u30b7\u30e7\u30f3\u3067\u306f\u3001\u30b8\u30e3\u30f3\u30d7\u3068\u52d5\u304d\u304c\u30d3\u30fc\u30c8\u3068\u4e00\u81f4\u3057\u3001\u884c\u52d5\u3092\u3088\u308a
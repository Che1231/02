2\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u7df4\u7fd2\u6280\u8853\u304c\u52b9\u679c\u7684\u3067\u3059\u3002STEP1 - \u7df4\u7fd2\u30e2\u30fc\u30c9\u3092\u4f7f\u7528\u3057\u3066\u3001\u56f0\u96e3\u306a\u30bb\u30af\u30b7\u30e7\u30f3\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002STEP2 - \u7279\u5b9a\u306e\u90e8\u5206\u3092\u7e70\u308a\u8fd4\u3057\u30d7\u30ec\u30a4\u3057\u3066\u3001\u4e00\u8cab\u6027\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002STEP3 - \u518d\u751f\u3092\u5206\u6790\u3057\u3066\u3001\u9593\u9055\u3044\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6ce2\u306e\u30bb\u30af\u30b7\u30e7\u30f3\u3092\u7e70\u308a\u8fd4\u3057\u7df4\u7fd2\u3059\u308b\u3068\u3001\u72ed\u3044\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03\u8868\u8aac\u660e\uff1a\u69d8\u3005\u306a\u7df4\u7fd2\u65b9\u6cd5\u3092\u6bd4\u8f03\u3057\u3066\u3001\u6700\u3082\u52b9\u679c\u7684\u306a\u65b9\u6cd5\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002]"}]
[{"question": "Geometry Dash Clutterfunk\uc5d0\uc11c \ucd08\ubcf4\uc790\uac00 \ud050\ube0c\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc81c\uc5b4\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Geometry Dash Clutterfunk\uc5d0\uc11c \ud050\ube0c\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc81c\uc5b4\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. STEP1 - \ud654\uba74\uc744 \ud0ed\ud558\uac70\ub098 \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \uc801\uc808\ud55c \uc21c\uac04\uc5d0 \ub20c\ub7ec \uae30\ubcf8 \uc810\ud504\ub97c \uc5f0\uc2b5\ud569\ub2c8\ub2e4. STEP2 - \uc74c\uc545\uc758 \ub9ac\ub4ec\uc5d0 \uc9d1\uc911\ud558\uc5ec \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uc815\ud655\ud558\uac8c \ub9de\ucda5\ub2c8\ub2e4. STEP3 - \uadfc\uc721 \uae30\uc5b5\ub825\uc744 \ud0a4\uc6b0\uae30 \uc704\ud574 \ub354 \ub290\ub9b0 \ub808\ubca8\ubd80\ud130 \uc2dc\uc791\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, Clutterfunk\uc758 \ucd08\uae30 \uc139\uc158\uc5d0\uc11c\ub294 \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\uae30 \uc704\ud574 \ube44\ud2b8\uc5d0 \ub9de\ucdb0 \uc810\ud504\ub97c \ub3d9\uae30\ud654\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud050\ube0c\ub97c \uc801\uc808\ud55c \uc2dc\uac04\uc5d0 \ub545\uc5d0 \ub2ff\uc544\uc57c \ud558\ub294 \ud280\ub294 \uacf5\uc774\ub77c\uace0 \uc0dd\uac01\ud558\uc138\uc694.]"}, {"question": "Geometry Dash Clutterfunk\uc5d0\uc11c \ud568\uc120 \uc139\uc158\uc744 \ub9c8\uc2a4\ud130\ud558\ub294 \uc8fc\uc694 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Geometry Dash Clutterfunk\uc5d0\uc11c \ud568\uc120 \uc139\uc158\uc744 \ub9c8\uc2a4\ud130\ud558\ub824\uba74 \ub2e4\uc74c\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1 - \uc810\ud504 \ubc84\ud2bc\uc744 \ub204\ub974\uace0 \ub5bc\uc5b4 \ud568\uc120\uc758 \uc0c1\uc2b9 \ubc0f \ud558\uac15\uc744 \uc81c\uc5b4\ud558\ub294 \ubc29\ubc95\uc744 \ubc30\uc6c1\ub2c8\ub2e4. STEP2 - \uc7a5\uc560\ubb3c\uc758 \ub808\uc774\uc544\uc6c3\uc744 \uc554\uae30\ud558\uc5ec \uc6c0\uc9c1\uc784\uc744 \uc608\uce21\ud569\ub2c8\ub2e4. STEP3 - \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud0c0\uc774\ubc0d\uc744 \uac1c\uc120\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, Clutterfunk\uc758 \uc911\uac04 \uc139\uc158\uc5d0\uc11c\ub294 \uc9e7\uac8c \ub204\ub974\uae30\uc640 \uae38\uac8c \ub204\ub974\uae30\ub97c \ubc88\uac08\uc544 \uac00\uba70 \uc881\uc740 \ud1b5\ub85c\ub97c \ud0d0\uc0c9\ud569\ub2c8\ub2e4. [\ud750\ub984\ub3c4 \ud574\uc124: \ud568\uc120\uc758 \uacbd\ub85c\ub97c \uc7a5\uc560\ubb3c \ud328\ud134\uc5d0 \ub9de\ucdb0\uc57c \ud558\ub294 \ud30c\ub3d9\uc73c\ub85c \uc2dc\uac01\ud654\ud569\ub2c8\ub2e4.]"}, {"question": "Geometry Dash Clutterfunk\uc5d0\uc11c \uc74c\uc545\uc5d0 \ub9de\ucdb0 \uc6c0\uc9c1\uc774\ub294 \uac83\uc774 \uc65c \uc911\uc694\ud55c\uac00\uc694?", "answer": "Geometry Dash Clutterfunk\uc5d0\uc11c \uc74c\uc545\uc5d0 \ub9de\ucdb0 \uc6c0\uc9c1\uc774\ub294 \uac83\uc740 \ub808\ubca8 \ub514\uc790\uc778\uc774 \ub9ac\ub4ec \uae30\ubc18\uc774\uae30 \ub54c\ubb38\uc5d0 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, Clutterfunk\uc758 \ub9c8\uc9c0\ub9c9 \uc139\uc158\uc5d0\uc11c\ub294 \uc810\ud504\uc640 \uc6c0\uc9c1\uc784\uc774 \ube44\ud2b8\uc5d0 \ub9de\ucdb0\uc838 \uc788\uc5b4 \uc561\uc158 \ud0c0\uc774\ubc0d\uc744 \uc815\ud655\ud558\uac8c \ub9de\ucd94\uae30\uac00 \ub354 \uc27d\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc74c\uc545\uc744 \ubaa8\ub4e0 \uc6c0\uc9c1\uc784\uc744 \uc548\ub0b4\ud558\ub294 \uba54\ud2b8\ub85c\ub188\uc774\ub77c\uace0 \uc0c1\uc0c1\ud574 \ubcf4\uc138\uc694.]"}, {"question": "\uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\ub294 Geometry Dash Clutterfunk\uc5d0\uc11c \uc5b4\ub5bb\uac8c \uacbd\ub85c\ub97c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\ub294 \ub2e4\uc74c\uc744 \ud1b5\ud574 \uacbd\ub85c\ub97c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1 - \ub808\ubca8\uc744 \ud1b5\uacfc\ud558\ub294 \uc9c0\ub984\uae38\uc774\ub098 \ub354 \uc548\uc804\ud55c \uacbd\ub85c\ub97c \uc2dd\ubcc4\ud569\ub2c8\ub2e4. STEP2 - \uc704\ud5d8\uc744 \uc904\uc774\uae30 \uc704\ud574 \ubd88\ud544\uc694\ud55c \uc6c0\uc9c1\uc784\uc744 \ucd5c\uc18c\ud654\ud569\ub2c8\ub2e4. STEP3 - \ud2b9\uc815 \uc5b4\ub824\uc6b4 \uc139\uc158\uc744 \ubc18\ubcf5\uc801\uc73c\ub85c \uc5f0\uc2b5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud568\uc120 \uc139\uc158\uc5d0\uc11c\ub294 \uc57d\uac04 \ub354 \ub192\uc740 \uacbd\ub85c\ub97c \uc120\ud0dd\ud558\uba74 \uc2a4\ud30c\uc774\ud06c \ud074\ub7ec\uc2a4\ud130\ub97c \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uacc4\ud68d \ube44\uad50: \ud45c\uc900 \uacbd\ub85c\uc640 \ub300\uccb4 \uacbd\ub85c\ub97c \ube44\uad50\ud558\uc5ec \uac00\uc7a5 \ud6a8\uc728\uc801\uc778 \uacbd\ub85c\ub97c \ucc3e\uc2b5\ub2c8\ub2e4.]"}, {"question": "Geometry Dash Clutterfunk\uc5d0\uc11c \uac00\uc7a5 \uc5b4\ub824\uc6b4 \uc7a5\uc560\ubb3c\uc740 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \uadf9\ubcf5\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Geometry Dash Clutterfunk\uc5d0\uc11c \uac00\uc7a5 \uc5b4\ub824\uc6b4 \uc7a5\uc560\ubb3c\uc5d0\ub294 \uc881\uc740 \uc2a4\ud30c\uc774\ud06c \ud074\ub7ec\uc2a4\ud130\uc640 \uac11\uc791\uc2a4\ub7ec\uc6b4 \uc911\ub825 \ubcc0\ud654\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub97c \uadf9\ubcf5\ud558\ub824\uba74 \ub2e4\uc74c\uc744 \uc218\ud589\ud558\uc138\uc694. STEP1 - \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub290\ub9b0 \ub3d9\uc791\uc73c\ub85c \uc5f0\uc2b5\ud569\ub2c8\ub2e4. STEP2 - \ud0c0\uc774\ubc0d\uacfc \uc815\ud655\uc131\uc5d0 \uc9d1\uc911\ud569\ub2c8\ub2e4. STEP3 - \uc2dc\uac01\uc801 \uc2e0\ud638\ub97c \uc0ac\uc6a9\ud558\uc5ec \ubcc0\ud654\ub97c \uc608\uce21\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub9c8\uc9c0\ub9c9 \uc139\uc158\uc5d0\uc11c\ub294 \ub2e4\uac00\uc624\ub294 \uc911\ub825 \ubc18\uc804\uc744 \uc54c\ub9ac\ub294 \uc0c9\uc0c1 \ubcc0\ud654\ub97c \uc8fc\uc2dc\ud558\uc138\uc694. [\uad6c\uc131 \ub300\uc870\ud45c: \uc7a5\uc560\ubb3c \uc720\ud615\uacfc \uad8c\uc7a5 \uc804\ub7b5\uc744 \ube44\uad50\ud569\ub2c8\ub2e4.]"}, {"question": "Geometry Dash Clutterfunk\uc758 \ub09c\uc774\ub3c4 \uace1\uc120\uc740 \ub2e4\ub978 \ub808\ubca8\uacfc \ube44\uad50\ud558\uc5ec \uc5b4\ub5bb\uc2b5\ub2c8\uae4c?", "answer": "Geometry Dash Clutterfunk\uc758 \ub09c\uc774\ub3c4 \uace1\uc120\uc740 \ucd08\uae30 \ub808\ubca8\ubcf4\ub2e4 \uac00\ud30c\ub974\uc9c0\ub9cc \ud6c4\uae30 \ub808\ubca8\uc5d0 \ube44\ud574 \ub354 \uc810\uc9c4\uc801\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucd08\uae30 \uc139\uc158\uc740 \ucd08\ubcf4\uc790\uac00 \uad00\ub9ac\ud558\uae30 \uc27d\uc9c0\ub9cc \ud568\uc120 \ubc0f \ud30c\ub3c4 \uc139\uc158\uc5d0\ub294 \uace0\uae09 \uae30\uc220\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. [\ud750\ub984\ub3c4 \ud574\uc124: \uc2dc\uc791\ubd80\ud130 \ub05d\uae4c\uc9c0 \ub09c\uc774\ub3c4 \uc9c4\ud589 \uc0c1\ud669\uc744 \ucc28\ud2b8\ub85c \ud45c\uc2dc\ud569\ub2c8\ub2e4.]"}, {"question": "Geometry Dash Clutterfunk\uc758 \uc911\ub825 \ud3ec\ud138\uc758 \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Geometry Dash Clutterfunk\uc758 \uc911\ub825 \ud3ec\ud138\uc740 \uc911\ub825 \ubc29\ud5a5\uc744 \ubc18\uc804\uc2dc\ucf1c \ud050\ube0c \ub610\ub294 \ud568\uc120\uc744 \uac70\uafb8\ub85c \ub4a4\uc9d1\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc911\uac04 \uc139\uc158\uc5d0\uc11c\ub294 \uc911\ub825 \ud3ec\ud138\uc5d0 \ub4e4\uc5b4\uac00\uba74 \uc0c8\ub85c\uc6b4 \ubc29\ud5a5\uc73c\ub85c \uc989\uc2dc \uc870\uc815\ud574\uc57c \ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc911\ub825 \ud3ec\ud138\uc744 \uc6c0\uc9c1\uc784 \uaddc\uce59\uc744 \ubcc0\uacbd\ud558\ub294 \uc2a4\uc704\uce58\ub77c\uace0 \uc0dd\uac01\ud558\uc138\uc694.]"}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 Geometry Dash Clutterfunk\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uc5b4\ub5bb\uac8c \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Geometry Dash Clutterfunk\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. STEP1 - RobTop \uacc4\uc815\uc774 \uc788\uace0 \ub85c\uadf8\uc778\ub418\uc5b4 \uc788\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. STEP2 - '\ub85c\ub4dc' \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud569\ub2c8\ub2e4. STEP3 - \ubaa8\ub4e0 \uc5c5\uc801\uacfc \ub808\ubca8\uc774 \uc804\uc1a1\ub418\uc5c8\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, iOS\uc5d0\uc11c Android\ub85c \uc774\ub3d9\ud558\ub824\uba74 \ub3d9\uc77c\ud55c \uacc4\uc815 \ub85c\uadf8\uc778\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. [\uad6c\uc131 \ub300\uc870\ud45c: \ub370\uc774\ud130 \ub9c8\uc774\uadf8\ub808\uc774\uc158\uc5d0 \ub300\ud55c \ud50c\ub7ab\ud3fc\ubcc4 \ub2e8\uacc4\ub97c \ube44\uad50\ud569\ub2c8\ub2e4.]"}, {"question": "Geometry Dash Clutterfunk\uc5d0\uc11c \uc5b4\ub5a4 \uc228\uaca8\uc9c4 \ube44\ubc00\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Geometry Dash Clutterfunk\uc758 \uc228\uaca8\uc9c4 \ube44\ubc00\uc5d0\ub294 \ub300\uccb4 \uacbd\ub85c\uc640 \uc2dc\uac01\uc801 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud568\uc120 \uc139\uc158\uc5d0\uc11c\ub294 \ub354 \ub0ae\uc740 \uacbd\ub85c\ub97c \uc120\ud0dd\ud558\uba74 \ub3c5\ud2b9\ud55c \ub514\uc790\uc778\uc758 \uc228\uaca8\uc9c4 \uc601\uc5ed\uc774 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc774\ub7ec\ud55c \ube44\ubc00\uc744 \ubc1c\uacac\ub418\uae30\ub97c \uae30\ub2e4\ub9ac\ub294 \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uc774\ub77c\uace0 \uc0dd\uac01\ud558\uc138\uc694.]"}, {"question": "Geometry Dash Clutterfunk\ub97c \ub9c8\uc2a4\ud130\ud558\ub294 \ub370 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \uc5f0\uc2b5 \uae30\uc220\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Geometry Dash Clutterfunk\ub97c \ub9c8\uc2a4\ud130\ud558\ub294 \ub370 \ud6a8\uacfc\uc801\uc778 \uc5f0\uc2b5 \uae30\uc220\uc5d0\ub294 \ub2e4\uc74c\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. STEP1 - \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc5b4\ub824\uc6b4 \uc139\uc158\uc744 \ubd84\ub9ac\ud569\ub2c8\ub2e4. STEP2 - \ud2b9\uc815 \ubd80\ubd84\uc744 \ub2e4\uc2dc \uc7ac\uc0dd\ud558\uc5ec \uc77c\uad00\uc131\uc744 \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4. STEP3 - \uc7ac\uc0dd\uc744 \ubd84\uc11d\ud558\uc5ec \uc2e4\uc218\ub97c \uc2dd\ubcc4\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud30c\ub3c4 \uc139\uc158\uc744 \ubc18\ubcf5\uc801\uc73c\ub85c \uc5f0\uc2b5\ud558\uba74 \uc881\uc740 \uae30\ub3d9\uc744 \ub9c8\uc2a4\ud130\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uacc4\ud68d \ube44\uad50: \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ubc29\ubc95\uc744 \ucc3e\uae30 \uc704\ud574 \ub2e4\uc591\ud55c \uc5f0\uc2b5 \ubc29\ubc95\uc744 \ube44\uad50\ud569\ub2c8\ub2e4.]"}]
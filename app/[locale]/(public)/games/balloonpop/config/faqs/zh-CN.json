[{"question": "\u65b0\u624b\u5982\u4f55\u5f00\u59cb\u73a9BalloonPop\u6e38\u620f\uff1f", "answer": "\u8981\u5f00\u59cb\u73a9BalloonPop\uff0c\u9996\u5148\u9700\u8981\u4ece\u60a8\u559c\u6b22\u7684\u5e94\u7528\u5546\u5e97\u4e0b\u8f7d\u5e76\u5b89\u88c5\u6e38\u620f\u3002\u5b89\u88c5\u5b8c\u6210\u540e\uff0c\u6253\u5f00\u6e38\u620f\u5e76\u5b8c\u6210\u6559\u7a0b\uff0c\u6559\u7a0b\u5c06\u6307\u5bfc\u60a8\u4e86\u89e3\u57fa\u672c\u6e38\u620f\u673a\u5236\u3002\u4f8b\u5982\uff0c\u60a8\u5c06\u5b66\u4e60\u5982\u4f55\u70b9\u51fb\u6c14\u7403\u4f7f\u5176\u7206\u7834\u5e76\u83b7\u5f97\u79ef\u5206\u3002\u6559\u7a0b\u8fd8\u4f1a\u4ecb\u7ecd\u4f8b\u5982\"\u8fde\u7206\"\u4e4b\u7c7b\u7684\u589e\u5f3a\u9053\u5177\uff0c\u5b83\u5141\u8bb8\u60a8\u4e00\u6b21\u7206\u7834\u591a\u4e2a\u6c14\u7403\u3002\u5efa\u8bae\u60a8\u4ece\"\u7b80\u5355\"\u6a21\u5f0f\u5f00\u59cb\uff0c\u4ee5\u9002\u5e94\u6e38\u620f\u7684\u8282\u594f\u548c\u63a7\u5236"}, {"question": "BalloonPop\u6e38\u620f\u4e2d\u83b7\u5f97\u9ad8\u5206\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728BalloonPop\u4e2d\u83b7\u5f97\u9ad8\u5206\u9700\u8981\u901f\u5ea6\u548c\u7b56\u7565\u7684\u7ed3\u5408\u3002\u7b2c\u4e00\u6b65\uff1a\u4e13\u6ce8\u4e8e\u5feb\u901f\u8fde\u7eed\u7206\u7834\u6c14\u7403\u4ee5\u5efa\u7acb\u8fde\u51fb\u500d\u6570\u3002\u7b2c\u4e8c\u6b65\uff1a\u7b56\u7565\u6027\u5730\u4f7f\u7528\u589e\u5f3a\u9053\u5177\uff1b\u4f8b\u5982\uff0c\u5c06\"\u65f6\u95f4\u6682\u505c\"\u7559\u5f85\u5c4f\u5e55\u62e5\u6324\u65f6\u4f7f\u7528\u3002\u7b2c\u4e09\u6b65\uff1a\u7784\u51c6\u7279\u6b8a\u6c14\u7403\uff0c\u4f8b\u5982\"\u91d1\u8272\u6c14\u7403\"\uff0c\u5b83\u4f1a\u63d0\u4f9b\u989d\u5916\u5206\u6570\u3002\u4f8b\u5982\uff0c\u5728\u6e38\u620f\u573a\u666f\u62e5\u6324\u65f6\uff0c\u5148\u4f7f\u7528\"\u65f6\u95f4\u6682\u505c\"\uff0c\u7136\u540e\u4f7f\u7528\"\u8fde\u7206\"\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u60a8\u7684\u5206\u6570\u3002"}, {"question": "\u4e3a\u4ec0\u4e48BalloonPop\u4f1a\u6709\u4e0d\u540c\u7684\u6a21\u5f0f\uff0c\u6211\u5e94\u8be5\u9009\u62e9\u54ea\u4e2a\uff1f", "answer": "BalloonPop\u63d0\u4f9b\u4e0d\u540c\u7684\u6a21\u5f0f\uff0c\u4ee5\u6ee1\u8db3\u5404\u79cd\u73a9\u5bb6\u7684\u6280\u80fd\u6c34\u5e73\u548c\u559c\u597d\u3002\"\u7b80\u5355\"\u6a21\u5f0f\u975e\u5e38\u9002\u5408\u65b0\u624b\uff0c\u5b83\u5305\u542b\u8f83\u6162\u7684\u6c14\u7403\u901f\u5ea6\u548c\u8f83\u5c11\u7684\u969c\u788d\u3002\"\u56f0\u96be\"\u6a21\u5f0f\u5219\u4f1a\u5411\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u63d0\u51fa\u6311\u6218\uff0c\u5b83\u5305\u542b\u901f\u5ea6\u66f4\u5feb\u7684\u6c14\u7403\u548c\u66f4\u590d\u6742\u7684\u6a21\u5f0f\u3002\"\u65f6\u95f4\u653b\u51fb\"\u6a21\u5f0f\u975e\u5e38\u9002\u5408\u559c\u6b22\u5feb\u901f\u3001\u8ba1\u65f6\u6311\u6218\u7684\u73a9\u5bb6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u662f\u65b0\u624b\u73a9\u5bb6\uff0c\u4ece\"\u7b80\u5355\"\u6a21\u5f0f\u5f00\u59cb\u5c06\u6709\u52a9\u4e8e\u60a8\u5efa\u7acb\u4fe1\u5fc3\u548c\u6280\u80fd\uff0c\u7136\u540e\u518d\u8fc7\u6e21\u5230\u66f4\u5177\u6311\u6218\u6027\u7684\u6a21\u5f0f\u3002"}, {"question": "BalloonPop\u4e2d\u7684\u8fde\u51fb\u7cfb\u7edf\u5982\u4f55\u8fd0\u4f5c\uff0c\u6211\u8be5\u5982\u4f55\u6700\u5927\u5316\u8fde\u51fb\uff1f", "answer": "BalloonPop\u4e2d\u7684\u8fde\u51fb\u7cfb\u7edf\u4f1a\u5956\u52b1\u73a9\u5bb6\u5feb\u901f\u8fde\u7eed\u7206\u7834\u6c14\u7403\u3002\u6bcf\u6b21\u8fde\u7eed\u7206\u7834\u90fd\u4f1a\u589e\u52a0\u60a8\u7684\u8fde\u51fb\u500d\u6570\uff0c\u4ece\u800c\u83b7\u5f97\u66f4\u9ad8\u7684\u5206\u6570\u3002\u8981\u6700\u5927\u5316\u8fde\u51fb\uff0c\u8bf7\u5c1d\u8bd5\u5728\u4e0d\u9057\u6f0f\u4efb\u4f55\u6c14\u7403\u7684\u60c5\u51b5\u4e0b\u7206\u7834\u6c14\u7403\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u8fde\u7eed\u7206\u783410\u4e2a\u6c14\u7403\uff0c\u60a8\u7684\u8fde\u51fb\u500d\u6570\u5c06\u4f1a\u663e\u8457\u63d0\u9ad8\uff0c\u4ece\u800c\u63d0\u5347\u60a8\u7684\u603b\u5f97\u5206\u3002\u4f7f\u7528\u5982\"\u8fde\u7206\"\u4e4b\u7c7b\u7684\u589e\u5f3a\u9053\u5177\u4e5f\u53ef\u4ee5\u5e2e\u52a9\u4fdd\u6301\u548c\u589e\u52a0\u60a8\u7684\u8fde\u51fb\u94fe\u3002"}, {"question": "BalloonPop\u7684\u589e\u5f3a\u9053\u5177\u4e4b\u95f4\u7684\u4e3b\u8981\u533a\u522b\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u6211\u5e94\u8be5\u5728\u4f55\u65f6\u4f7f\u7528\u5b83\u4eec\uff1f", "answer": "BalloonPop\u5305\u542b\u591a\u79cd\u589e\u5f3a\u9053\u5177\uff0c\u6bcf\u4e2a\u9053\u5177\u90fd\u6709\u72ec\u7279\u7684\u597d\u5904\u3002 \"\u8fde\u7206\"\u5141\u8bb8\u60a8\u901a\u8fc7\u4e00\u6b21\u70b9\u51fb\u7206\u7834\u591a\u4e2a\u6c14\u7403\uff0c\u975e\u5e38\u9002\u5408\u5c4f\u5e55\u62e5\u6324\u7684\u60c5\u51b5\u3002 \"\u65f6\u95f4\u6682\u505c\"\u4f1a\u51cf\u6162\u6c14\u7403\u7684\u79fb\u52a8\u901f\u5ea6\uff0c\u4e3a\u60a8\u63d0\u4f9b\u66f4\u591a\u8ba1\u5212\u64cd\u4f5c\u7684\u65f6\u95f4\u3002 \"\u5f97\u5206\u63d0\u5347\"\u4f1a\u6682\u65f6\u589e\u52a0\u6bcf\u6b21\u7206\u7834\u83b7\u5f97\u7684\u5206\u6570\u3002 \u4f8b\u5982\uff0c\u5f53\u5c4f\u5e55\u4e0a\u5145\u6ee1\u6c14\u7403\u65f6\uff0c\u4f7f\u7528\"\u65f6\u95f4\u6682\u505c\"\u53ef\u4ee5\u6700\u5927\u5316\u60a8\u7684\u7206\u7834\u6548\u7387\u548c\u5206\u6570\u3002"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684BalloonPop\u6e38\u620f\u8fdb\u5ea6\u4ece\u4e00\u53f0\u8bbe\u5907\u8fc1\u79fb\u5230\u53e6\u4e00\u53f0\u8bbe\u5907\uff1f", "answer": "\u8981\u8fc1\u79fb\u60a8\u7684BalloonPop\u6e38\u620f\u8fdb\u5ea6\uff0c\u8bf7\u786e\u4fdd\u60a8\u767b\u5f55\u7684\u8d26\u6237\u5728\u4e24\u53f0\u8bbe\u5907\u4e0a\u90fd\u662f\u76f8\u540c\u7684\u3002\u5927\u591a\u6570\u5e73\u53f0\u90fd\u652f\u6301\u4e91\u4fdd\u5b58\uff0c\u56e0\u6b64\u60a8\u7684\u8fdb\u5ea6\u5e94\u8be5\u4f1a\u81ea\u52a8\u540c\u6b65\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u4eceAndroid\u8bbe\u5907\u5207\u6362\u5230iOS\u8bbe\u5907\uff0c\u53ea\u9700\u5728\u65b0\u7684\u8bbe\u5907\u4e0a\u767b\u5f55\u60a8\u5728Google Play\u6216\u82f9\u679cID\u5373\u53ef\u5c06\u60a8\u7684\u6570\u636e\u4f20\u8f93\u8fc7\u6765\u3002\u5982\u679c\u51fa\u73b0\u95ee\u9898\uff0c\u8bf7\u68c0\u67e5\u6e38\u620f\u7684\u8bbe\u7f6e\uff0c\u4ee5\u67e5\u770b\u624b\u52a8\u540c\u6b65\u9009\u9879\uff0c\u6216\u8054\u7cfb\u652f\u6301\u3002"}, {"question": "BalloonPop\u4e2d\u7684\u9690\u85cf\u6210\u5c31\u6709\u54ea\u4e9b\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9501\u5b83\u4eec\uff1f", "answer": "BalloonPop\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u6210\u5c31\uff0c\u9700\u8981\u6267\u884c\u7279\u5b9a\u64cd\u4f5c\u624d\u80fd\u89e3\u9501\u3002\u4f8b\u5982\uff0c\"\u6c14\u7403\u5927\u5e08\"\u662f\u901a\u8fc7\u5728\u4e00\u4e2a\u6e38\u620f\u4f1a\u8bdd\u4e2d\u7206\u78341000\u4e2a\u6c14\u7403\u6765\u5b9e\u73b0\u7684\u3002\"\u589e\u5f3a\u9053\u5177\u4e13\u5bb6\"\u9700\u8981\u5728\u4e00\u4e2a\u6e38\u620f\u4e2d\u4f7f\u7528\u6240\u6709\u53ef\u7528\u7684\u589e\u5f3a\u9053\u5177\u3002 \u8981\u89e3\u9501\u8fd9\u4e9b\u6210\u5c31\uff0c\u8bf7\u4e13\u6ce8\u4e8e\u638c\u63e1\u6e38\u620f\u673a\u5236\u5e76\u5c1d\u8bd5\u4e0d\u540c\u7684\u7b56\u7565\u3002\u5bc6\u5207\u5173\u6ce8\u6210\u5c31\u5217\u8868\uff0c\u4ee5\u4e86\u89e3\u9700\u8981\u6267\u884c\u54ea\u4e9b\u64cd\u4f5c\u3002"}, {"question": "BalloonPop\u7684\u8bc4\u5206\u7b97\u6cd5\u662f\u5982\u4f55\u5de5\u4f5c\u7684\uff0c\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u6211\u7684\u6700\u7ec8\u5f97\u5206\uff1f", "answer": "BalloonPop\u7684\u8bc4\u5206\u7b97\u6cd5\u57fa\u4e8e\u51e0\u4e2a\u56e0\u7d20\uff1a\u7206\u7834\u6c14\u7403\u7684\u6570\u91cf\u3001\u8fde\u51fb\u500d\u6570\u548c\u589e\u5f3a\u9053\u5177\u7684\u4f7f\u7528\u3002\u6bcf\u4e2a\u7206\u7834\u7684\u6c14\u7403\u90fd\u4f1a\u83b7\u5f97\u57fa\u7840\u5206\u6570\uff0c\u8be5\u5206\u6570\u4f1a\u4e58\u4ee5\u60a8\u7684\u5f53\u524d\u8fde\u51fb\u500d\u6570\u3002\u7279\u6b8a\u6c14\u7403\uff0c\u4f8b\u5982\"\u91d1\u8272\u6c14\u7403\"\uff0c\u4f1a\u63d0\u4f9b\u989d\u5916\u5206\u6570\u3002 \u4f8b\u5982\uff0c\u4ee5\u9ad8\u8fde\u51fb\u500d\u6570\u7206\u7834\"\u91d1\u8272\u6c14\u7403\"\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u60a8\u7684\u5206\u6570\u3002\u6b64\u5916\uff0c\u4f7f\u7528\u589e\u5f3a\u9053\u5177\uff0c\u4f8b\u5982\"\u5f97\u5206\u63d0\u5347\"\uff0c\u4f1a\u8fdb\u4e00\u6b65\u589e\u5f3a\u60a8\u7684\u6bcf\u70b9\u51fb\u5206\u6570\u3002"}, {"question": "\u5728\u6211\u7684\u8bbe\u5907\u4e0a\u5e73\u7a33\u8fd0\u884cBalloonPop\u6240\u9700\u7684\u54ea\u4e9b\u6280\u672f\u8981\u6c42\uff1f", "answer": "\u4e3a\u4e86\u5728\u60a8\u7684\u8bbe\u5907\u4e0a\u5e73\u7a33\u8fd0\u884cBalloonPop\uff0c\u8bf7\u786e\u4fdd\u60a8\u7684\u8bbe\u5907\u7b26\u5408\u6700\u4f4e\u6280\u672f\u8981\u6c42\u3002\u5bf9\u4e8eAndroid\uff0c\u60a8\u9700\u8981\u81f3\u5c11\u7248\u672c5.0\uff08\u68d2\u68d2\u7cd6\uff09\u548c2GB\u5185\u5b58\u3002iOS\u7528\u6237\u5e94\u8be5\u62e5\u6709iOS 10\u6216\u66f4\u9ad8\u7248\u672c\u548c1GB\u5185\u5b58\u3002\u6b64\u5916\uff0c\u5efa\u8bae\u62e5\u6709\u7a33\u5b9a\u7684\u4e92\u8054\u7f51\u8fde\u63a5\uff0c\u4ee5\u4fbf\u540c\u6b65\u8fdb\u5ea6\u548c\u8bbf\u95ee\u5728\u7ebf\u529f\u80fd\u3002\u4f8b\u5982\uff0c\u5728\u7b26\u5408\u8fd9\u4e9b\u89c4\u683c\u7684\u8bbe\u5907\u4e0a\u6e38\u620f\u5c06\u63d0\u4f9b\u6d41\u7545\u4e14\u6109\u60a6\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u54ea\u4e2aBalloonPop\u589e\u5f3a\u9053\u5177\u6700\u6709\u6548\u5730\u83b7\u5f97\u9ad8\u5206\uff0c\u4e3a\u4ec0\u4e48\uff1f", "answer": "\u5728BalloonPop\u4e2d\uff0c\"\u5f97\u5206\u63d0\u5347\"\u589e\u5f3a\u9053\u5177\u6700\u6709\u6548\u5730\u83b7\u5f97\u9ad8\u5206\u3002\u5b83\u4f1a\u6682\u65f6\u589e\u52a0\u6bcf\u6b21\u7206\u7834\u83b7\u5f97\u7684\u5206\u6570\uff0c\u5f53\u4e0e\u9ad8\u8fde\u51fb\u500d\u6570\u76f8\u7ed3\u5408\u65f6\uff0c\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u5206\u6570\u3002 \u4f8b\u5982\uff0c\u5728\u9ad8\u8fde\u51fb\u94fe\u4e2d\u4f7f\u7528\"\u5f97\u5206\u63d0\u5347\"\u53ef\u4ee5\u5448\u6307\u6570\u7ea7\u63d0\u9ad8\u60a8\u7684\u5206\u6570\u3002\u4f46\u662f\uff0c\u65f6\u673a\u81f3\u5173\u91cd\u8981\uff1b\u5728\u60a8\u62e5\u6709\u5f3a\u5927\u8fde\u51fb\u4e14\u5c4f\u5e55\u62e5\u6324\u65f6\u4f7f\u7528\u5b83\uff0c\u4ee5\u6700\u5927\u5316\u5176\u5f71\u54cd\u3002"}]
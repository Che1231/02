[{"question": "\u65b0\u624b\u5982\u4f55\u958b\u59cb\u73a9\u6c23\u7403\u7206\u7834\u904a\u6232\uff1f", "answer": "\u8981\u958b\u59cb\u73a9\u6c23\u7403\u7206\u7834\u904a\u6232\uff0c\u8acb\u5148\u5f9e\u60a8\u559c\u611b\u7684\u61c9\u7528\u7a0b\u5f0f\u5546\u5e97\u4e0b\u8f09\u4e26\u5b89\u88dd\u904a\u6232\u3002\u5b89\u88dd\u5b8c\u6210\u5f8c\uff0c\u958b\u555f\u904a\u6232\u4e26\u5b8c\u6210\u6559\u5b78\uff0c\u6559\u5b78\u6703\u6307\u5c0e\u60a8\u5b8c\u6210\u57fa\u672c\u904a\u6232\u6a5f\u5236\u3002\u4f8b\u5982\uff0c\u60a8\u5c07\u5b78\u7fd2\u5982\u4f55\u9ede\u64ca\u6c23\u7403\u4ee5\u4f7f\u5176\u7206\u7834\u4e26\u7372\u5f97\u5206\u6578\u3002\u6559\u5b78\u4e5f\u5c07\u4ecb\u7d39\u4e00\u4e9b\u589e\u5f37\u529f\u80fd\uff0c\u4f8b\u5982\u300c\u591a\u91cd\u7206\u7834\u300d\uff0c\u5b83\u5141\u8a31\u60a8\u4e00\u6b21\u7206\u7834\u591a\u500b\u6c23\u7403\u3002\u5efa\u8b70\u60a8\u5f9e\u300c\u7c21\u55ae\u300d\u6a21\u5f0f\u958b\u59cb\uff0c\u4ee5\u719f\u6089\u904a\u6232\u7bc0\u594f\u548c\u63a7\u5236\u65b9\u5f0f\u3002"}, {"question": "\u5728\u6c23\u7403\u7206\u7834\u904a\u6232\u4e2d\uff0c\u5982\u4f55\u53d6\u5f97\u9ad8\u5206\uff1f", "answer": "\u5728\u6c23\u7403\u7206\u7834\u904a\u6232\u4e2d\u53d6\u5f97\u9ad8\u5206\u9700\u8981\u901f\u5ea6\u548c\u7b56\u7565\u7684\u7d50\u5408\u3002\u6b65\u9a5f\u4e00\uff1a\u96c6\u4e2d\u7cbe\u529b\u5feb\u901f\u9023\u7e8c\u7206\u7834\u6c23\u7403\u4ee5\u5efa\u7acb\u9023\u64ca\u500d\u6578\u3002\u6b65\u9a5f\u4e8c\uff1a\u7b56\u7565\u6027\u5730\u4f7f\u7528\u589e\u5f37\u529f\u80fd\uff1b\u4f8b\u5982\uff0c\u5c07\u300c\u6642\u9593\u66ab\u505c\u300d\u5132\u5b58\u65bc\u87a2\u5e55\u64c1\u64e0\u6642\u4f7f\u7528\u3002\u6b65\u9a5f\u4e09\uff1a\u7784\u6e96\u7279\u6b8a\u6c23\u7403\uff0c\u4f8b\u5982\u300c\u91d1\u8272\u6c23\u7403\u300d\uff0c\u5b83\u6703\u63d0\u4f9b\u984d\u5916\u5206\u6578\u3002\u4f8b\u5982\uff0c\u5728\u904a\u6232\u756b\u9762\u64c1\u64e0\u7684\u60c5\u6cc1\u4e0b\uff0c\u4f7f\u7528\u300c\u6642\u9593\u66ab\u505c\u300d\u4e26\u63a5\u8457\u4f7f\u7528\u300c\u591a\u91cd\u7206\u7834\u300d\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u60a8\u7684\u5f97\u5206\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u6c23\u7403\u7206\u7834\u904a\u6232\u6709\u4e0d\u540c\u7684\u6a21\u5f0f\uff0c\u6211\u61c9\u8a72\u9078\u64c7\u54ea\u7a2e\u6a21\u5f0f\uff1f", "answer": "\u6c23\u7403\u7206\u7834\u904a\u6232\u63d0\u4f9b\u4e0d\u540c\u7684\u6a21\u5f0f\uff0c\u4ee5\u6eff\u8db3\u5404\u7a2e\u73a9\u5bb6\u7684\u6280\u80fd\u6c34\u5e73\u548c\u559c\u597d\u3002\u5c0d\u65bc\u65b0\u624b\u4f86\u8aaa\uff0c\u5efa\u8b70\u9078\u64c7\u300c\u7c21\u55ae\u300d\u6a21\u5f0f\uff0c\u8a72\u6a21\u5f0f\u7684\u6c23\u7403\u901f\u5ea6\u8f03\u6162\uff0c\u969c\u7919\u7269\u4e5f\u8f03\u5c11\u3002\u300c\u56f0\u96e3\u300d\u6a21\u5f0f\u5247\u6311\u6230\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\uff0c\u6c23\u7403\u901f\u5ea6\u8f03\u5feb\uff0c\u6a21\u5f0f\u4e5f\u66f4\u8907\u96dc\u3002\u300c\u6642\u9593\u6311\u6230\u300d\u6a21\u5f0f\u975e\u5e38\u9069\u5408\u90a3\u4e9b\u559c\u6b61\u5feb\u901f\u3001\u9650\u6642\u6311\u6230\u7684\u73a9\u5bb6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u662f\u65b0\u624b\u73a9\u5bb6\uff0c\u5f9e\u300c\u7c21\u55ae\u300d\u6a21\u5f0f\u958b\u59cb\uff0c\u53ef\u4ee5\u5e6b\u52a9\u60a8\u5efa\u7acb\u4fe1\u5fc3\u548c\u6280\u80fd\uff0c\u7136\u5f8c\u518d\u8f49\u63db\u81f3\u66f4\u5177\u6311\u6230\u6027\u7684\u6a21\u5f0f\u3002"}, {"question": "\u5728\u6c23\u7403\u7206\u7834\u904a\u6232\u4e2d\uff0c\u9023\u64ca\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u5982\u4f55\u6700\u5927\u5316\u9023\u64ca\u6548\u679c\uff1f", "answer": "\u6c23\u7403\u7206\u7834\u904a\u6232\u4e2d\u7684\u9023\u64ca\u7cfb\u7d71\u6703\u734e\u52f5\u73a9\u5bb6\u5feb\u901f\u9023\u7e8c\u7206\u7834\u6c23\u7403\u3002\u6bcf\u6b21\u9023\u7e8c\u7206\u7834\u90fd\u5c07\u589e\u52a0\u60a8\u7684\u9023\u64ca\u500d\u6578\uff0c\u4e26\u5c0e\u81f4\u66f4\u9ad8\u7684\u5206\u6578\u3002\u8981\u6700\u5927\u5316\u9023\u64ca\u6548\u679c\uff0c\u8acb\u5617\u8a66\u5728\u6c92\u6709\u6f0f\u6389\u4efb\u4f55\u6c23\u7403\u7684\u60c5\u6cc1\u4e0b\u7206\u7834\u6c23\u7403\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u9023\u7e8c\u7206\u7834 10 \u500b\u6c23\u7403\uff0c\u60a8\u7684\u9023\u64ca\u500d\u6578\u5c07\u986f\u8457\u589e\u52a0\uff0c\u5f9e\u800c\u63d0\u5347\u60a8\u7684\u7e3d\u5206\u3002\u4f7f\u7528\u589e\u5f37\u529f\u80fd\uff0c\u4f8b\u5982\u300c\u591a\u91cd\u7206\u7834\u300d\uff0c\u4e5f\u53ef\u4ee5\u5e6b\u52a9\u7dad\u6301\u548c\u589e\u52a0\u60a8\u7684\u9023\u64ca\u9023\u9396\u3002"}, {"question": "\u6c23\u7403\u7206\u7834\u904a\u6232\u7684\u589e\u5f37\u529f\u80fd\u4e4b\u9593\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff0c\u4ee5\u53ca\u4f55\u6642\u61c9\u8a72\u4f7f\u7528\u5b83\u5011\uff1f", "answer": "\u6c23\u7403\u7206\u7834\u904a\u6232\u5305\u542b\u8a31\u591a\u589e\u5f37\u529f\u80fd\uff0c\u6bcf\u7a2e\u529f\u80fd\u90fd\u6709\u7368\u7279\u7684\u512a\u52e2\u3002\u300c\u591a\u91cd\u7206\u7834\u300d\u5141\u8a31\u60a8\u7528\u4e00\u6b21\u9ede\u64ca\u7206\u7834\u591a\u500b\u6c23\u7403\uff0c\u975e\u5e38\u9069\u5408\u64c1\u64e0\u7684\u87a2\u5e55\u3002\u300c\u6642\u9593\u66ab\u505c\u300d\u6703\u6e1b\u7de9\u6c23\u7403\u79fb\u52d5\u901f\u5ea6\uff0c\u8b93\u60a8\u6709\u66f4\u591a\u6642\u9593\u898f\u5283\u60a8\u7684\u52d5\u4f5c\u3002\u300c\u5f97\u5206\u63d0\u5347\u300d\u6703\u66ab\u6642\u589e\u52a0\u6bcf\u6b21\u7206\u7834\u7372\u5f97\u7684\u5206\u6578\u3002\u4f8b\u5982\uff0c\u7576\u87a2\u5e55\u4e0a\u5145\u6eff\u6c23\u7403\u6642\uff0c\u4f7f\u7528\u300c\u6642\u9593\u66ab\u505c\u300d\u53ef\u4ee5\u6700\u5927\u5316\u60a8\u7684\u7206\u7834\u6548\u7387\u548c\u5f97\u5206\u3002"}, {"question": "\u5982\u4f55\u5728\u4e0d\u540c\u7684\u88dd\u7f6e\u4e4b\u9593\u9077\u79fb\u6211\u7684\u6c23\u7403\u7206\u7834\u904a\u6232\u9032\u5ea6\uff1f", "answer": "\u8981\u9077\u79fb\u60a8\u7684\u6c23\u7403\u7206\u7834\u904a\u6232\u9032\u5ea6\uff0c\u8acb\u78ba\u4fdd\u60a8\u5728\u5169\u500b\u8a2d\u5099\u4e0a\u90fd\u767b\u9304\u540c\u4e00\u500b\u5e33\u6236\u3002\u5927\u591a\u6578\u5e73\u53f0\u90fd\u652f\u63f4\u96f2\u7aef\u5132\u5b58\uff0c\u56e0\u6b64\u60a8\u7684\u9032\u5ea6\u61c9\u8a72\u6703\u81ea\u52d5\u540c\u6b65\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9e Android \u88dd\u7f6e\u5207\u63db\u5230 iOS \u88dd\u7f6e\uff0c\u53ea\u8981\u5728\u65b0\u7684\u88dd\u7f6e\u4e0a\u767b\u5165\u60a8\u7684 Google Play \u6216 Apple ID\uff0c\u5c31\u80fd\u5920\u5c07\u60a8\u7684\u8cc7\u6599\u8f49\u79fb\u3002\u5982\u679c\u51fa\u73fe\u554f\u984c\uff0c\u8acb\u67e5\u770b\u904a\u6232\u8a2d\u5b9a\u4e2d\u662f\u5426\u6709\u624b\u52d5\u540c\u6b65\u9078\u9805\uff0c\u6216\u806f\u7e6b\u5ba2\u670d\u3002"}, {"question": "\u6c23\u7403\u7206\u7834\u904a\u6232\u4e2d\u7684\u96b1\u85cf\u6210\u5c31\u6709\u54ea\u4e9b\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9396\u5b83\u5011\uff1f", "answer": "\u6c23\u7403\u7206\u7834\u904a\u6232\u5305\u542b\u4e00\u4e9b\u96b1\u85cf\u6210\u5c31\uff0c\u9700\u8981\u57f7\u884c\u7279\u5b9a\u52d5\u4f5c\u624d\u80fd\u89e3\u9396\u3002\u4f8b\u5982\uff0c\u300c\u6c23\u7403\u5927\u5e2b\u300d\u7684\u6210\u5c31\u9700\u8981\u5728\u55ae\u500b\u904a\u6232\u6703\u8a71\u4e2d\u7206\u7834 1,000 \u500b\u6c23\u7403\u3002\u300c\u589e\u5f37\u529f\u80fd\u5c08\u5bb6\u300d\u9700\u8981\u5728\u55ae\u500b\u904a\u6232\u4e2d\u4f7f\u7528\u6240\u6709\u53ef\u7528\u7684\u589e\u5f37\u529f\u80fd\u3002\u8981\u89e3\u9396\u9019\u4e9b\u6210\u5c31\uff0c\u8acb\u96c6\u4e2d\u7cbe\u529b\u638c\u63e1\u904a\u6232\u6a5f\u5236\u4e26\u5617\u8a66\u4e0d\u540c\u7684\u7b56\u7565\u3002\u8acb\u5bc6\u5207\u95dc\u6ce8\u6210\u5c31\u6e05\u55ae\uff0c\u4ee5\u7372\u53d6\u6709\u95dc\u8981\u57f7\u884c\u54ea\u4e9b\u52d5\u4f5c\u7684\u63d0\u793a\u3002"}, {"question": "\u6c23\u7403\u7206\u7834\u904a\u6232\u7684\u8a08\u5206\u6f14\u7b97\u6cd5\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u6211\u7684\u6700\u7d42\u5f97\u5206\uff1f", "answer": "\u6c23\u7403\u7206\u7834\u904a\u6232\u7684\u8a08\u5206\u6f14\u7b97\u6cd5\u57fa\u65bc\u5e7e\u500b\u56e0\u7d20\uff1a\u7206\u7834\u6c23\u7403\u7684\u6578\u91cf\u3001\u9023\u64ca\u500d\u6578\u4ee5\u53ca\u589e\u5f37\u529f\u80fd\u7684\u4f7f\u7528\u3002\u6bcf\u500b\u7206\u7834\u7684\u6c23\u7403\u90fd\u6703\u7372\u5f97\u57fa\u672c\u5206\u6578\uff0c\u8a72\u5206\u6578\u6703\u4e58\u4ee5\u60a8\u7684\u7576\u524d\u9023\u64ca\u500d\u6578\u3002\u7279\u6b8a\u6c23\u7403\uff0c\u4f8b\u5982\u300c\u91d1\u8272\u6c23\u7403\u300d\uff0c\u6703\u63d0\u4f9b\u984d\u5916\u5206\u6578\u3002\u4f8b\u5982\uff0c\u5728\u9ad8\u9023\u64ca\u500d\u6578\u4e0b\u7206\u7834\u300c\u91d1\u8272\u6c23\u7403\u300d\uff0c\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u60a8\u7684\u5f97\u5206\u3002\u6b64\u5916\uff0c\u4f7f\u7528\u589e\u5f37\u529f\u80fd\uff0c\u4f8b\u5982\u300c\u5f97\u5206\u63d0\u5347\u300d\uff0c\u4e5f\u6703\u9032\u4e00\u6b65\u63d0\u5347\u60a8\u6bcf\u6b21\u7206\u7834\u7372\u5f97\u7684\u5206\u6578\u3002"}, {"question": "\u5728\u88dd\u7f6e\u4e0a\u9806\u5229\u904b\u884c\u6c23\u7403\u7206\u7834\u904a\u6232\u7684\u6280\u8853\u9700\u6c42\u662f\u4ec0\u9ebc\uff1f", "answer": "\u8981\u9806\u5229\u904b\u884c\u6c23\u7403\u7206\u7834\u904a\u6232\uff0c\u8acb\u78ba\u4fdd\u60a8\u7684\u8a2d\u5099\u7b26\u5408\u6700\u4f4e\u6280\u8853\u9700\u6c42\u3002\u5c0d\u65bc Android\uff0c\u60a8\u9700\u8981\u81f3\u5c11\u7248\u672c 5.0\uff08\u68d2\u68d2\u7cd6\uff09\u548c 2GB \u7684 RAM\u3002iOS \u4f7f\u7528\u8005\u61c9\u8a72\u64c1\u6709 iOS 10 \u6216\u66f4\u9ad8\u7248\u672c\u548c 1GB \u7684 RAM\u3002\u6b64\u5916\uff0c\u5efa\u8b70\u4f7f\u7528\u7a69\u5b9a\u7684\u7db2\u8def\u9023\u7dda\uff0c\u4ee5\u540c\u6b65\u9032\u5ea6\u4e26\u5b58\u53d6\u7dda\u4e0a\u529f\u80fd\u3002\u4f8b\u5982\uff0c\u5728\u7b26\u5408\u9019\u4e9b\u898f\u683c\u7684\u8a2d\u5099\u4e0a\u73a9\u904a\u6232\uff0c\u5c07\u63d0\u4f9b\u9806\u66a2\u4e14\u6109\u5feb\u7684\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u54ea\u7a2e\u6c23\u7403\u7206\u7834\u904a\u6232\u589e\u5f37\u529f\u80fd\u6700\u6709\u6548\u5730\u9054\u5230\u9ad8\u5206\uff0c\u70ba\u4ec0\u9ebc\uff1f", "answer": "\u300c\u5f97\u5206\u63d0\u5347\u300d\u589e\u5f37\u529f\u80fd\u5728\u6c23\u7403\u7206\u7834\u904a\u6232\u4e2d\u662f\u9054\u5230\u9ad8\u5206\u7684\u6700\u4f73\u9078\u64c7\u3002\u5b83\u6703\u66ab\u6642\u63d0\u5347\u6bcf\u6b21\u7206\u7834\u7372\u5f97\u7684\u5206\u6578\uff0c\u9019\u7d50\u5408\u9ad8\u9023\u64ca\u500d\u6578\uff0c\u53ef\u4ee5\u5e36\u4f86\u986f\u8457\u7684\u5f97\u5206\u63d0\u5347\u3002\u4f8b\u5982\uff0c\u5728\u9ad8\u9023\u64ca\u9023\u9396\u4e2d\u4f7f\u7528\u300c\u5f97\u5206\u63d0\u5347\u300d\u53ef\u4ee5\u8b93\u60a8\u7684\u5f97\u5206\u5448\u6307\u6578\u7d1a\u589e\u52a0\u3002\u4f46\u662f\uff0c\u6642\u6a5f\u81f3\u95dc\u91cd\u8981\uff1b\u5728\u64c1\u6709\u5f37\u5927\u9023\u64ca\u4e14\u87a2\u5e55\u64c1\u64e0\u6642\u4f7f\u7528\u5b83\uff0c\u53ef\u4ee5\u6700\u5927\u5316\u5176\u6548\u679c\u3002"}]
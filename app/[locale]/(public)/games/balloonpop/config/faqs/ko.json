[{"question": "\ucd08\uc2ec\uc790\uac00 \ud48d\uc120 \ud31d \uac8c\uc784\uc744 \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud574\uc57c \ud558\ub098\uc694?", "answer": "\ud48d\uc120 \ud31d \uac8c\uc784\uc744 \uc2dc\uc791\ud558\ub824\uba74 \uba3c\uc800 \uc6d0\ud558\ub294 \uc571 \uc2a4\ud1a0\uc5b4\uc5d0\uc11c \uac8c\uc784\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uace0 \uc124\uce58\ud558\uc138\uc694. \uc124\uce58 \ud6c4 \uac8c\uc784\uc744 \uc5f4\uace0 \ud29c\ud1a0\ub9ac\uc5bc\uc744 \uc644\ub8cc\ud558\uc138\uc694. \ud29c\ud1a0\ub9ac\uc5bc\uc740 \uae30\ubcf8\uc801\uc778 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc744 \uc548\ub0b4\ud574\uc90d\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud48d\uc120\uc744 \ud130\uce58\ud558\uc5ec \ud48d\uc120\uc744 \ud130\ub728\ub9ac\uace0 \uc810\uc218\ub97c \uc5bb\ub294 \ubc29\ubc95\uc744 \ubc30\uc6b8 \uac83\uc785\ub2c8\ub2e4. \ud29c\ud1a0\ub9ac\uc5bc\uc5d0\uc11c\ub294 \uc5ec\ub7ec \ud48d\uc120\uc744 \ub3d9\uc2dc\uc5d0 \ud130\ub728\ub9b4 \uc218 \uc788\ub294 '\uba40\ud2f0 \ud31d'\uacfc \uac19\uc740 \ud30c\uc6cc\uc5c5\ub3c4 \uc18c\uac1c\ud569\ub2c8\ub2e4. \uac8c\uc784\uc758 \uc18d\ub3c4\uc640 \ucee8\ud2b8\ub864\uc5d0 \uc775\uc219\ud574\uc9c0\uae30 \uc704\ud574 '\uc26c\uc6c0' \ubaa8\ub4dc\ub85c \uc2dc\uc791\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4."}, {"question": "\ud48d\uc120 \ud31d \uac8c\uc784\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud48d\uc120 \ud31d \uac8c\uc784\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc73c\ub824\uba74 \uc18d\ub3c4\uc640 \uc804\ub7b5\uc758 \uc870\ud569\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \uc5f0\uc18d\uc801\uc73c\ub85c \ud48d\uc120\uc744 \ud130\ub728\ub824\uc11c \ucf64\ubcf4 \ubc30\uc728\uc744 \ub192\uc774\uc138\uc694. 2\ub2e8\uacc4: '\uc2dc\uac04 \uc815\uc9c0'\uc640 \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud654\uba74\uc774 \ubcf5\uc7a1\ud55c \uc21c\uac04\uc5d0 '\uc2dc\uac04 \uc815\uc9c0'\ub97c \uc0ac\uc6a9\ud558\uc138\uc694. 3\ub2e8\uacc4: \ubcf4\ub108\uc2a4 \uc810\uc218\ub97c \uc81c\uacf5\ud558\ub294 '\uace8\ub4e0 \ud48d\uc120'\uacfc \uac19\uc740 \ud2b9\ubcc4\ud55c \ud48d\uc120\uc744 \ub178\ub9ac\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud654\uba74\uc774 \ubcf5\uc7a1\ud55c \uacbd\uc6b0 '\uc2dc\uac04 \uc815\uc9c0' \ud30c\uc6cc\uc5c5 \ud6c4 '\uba40\ud2f0 \ud31d'\uc744 \uc0ac\uc6a9\ud558\uba74 \uc810\uc218\ub97c \ud06c\uac8c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud48d\uc120 \ud31d \uac8c\uc784\uc758 \ub2e4\uc591\ud55c \ubaa8\ub4dc\ub294 \uc65c \uc874\uc7ac\ud558\uba70, \uc5b4\ub5a4 \ubaa8\ub4dc\ub97c \uc120\ud0dd\ud574\uc57c \ud558\ub098\uc694?", "answer": "\ud48d\uc120 \ud31d \uac8c\uc784\uc740 \ub2e4\uc591\ud55c \ud50c\ub808\uc774\uc5b4\uc758 \uae30\uc220 \uc218\uc900\uacfc \uc120\ud638\ub3c4\ub97c \uace0\ub824\ud558\uc5ec \uac01\uae30 \ub2e4\ub978 \ubaa8\ub4dc\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ucd08\uc2ec\uc790\ub97c \uc704\ud55c '\uc26c\uc6c0' \ubaa8\ub4dc\ub294 \ud48d\uc120 \uc18d\ub3c4\uac00 \ub290\ub9ac\uace0 \uc7a5\uc560\ubb3c\uc774 \uc801\uc2b5\ub2c8\ub2e4. '\uc5b4\ub824\uc6c0' \ubaa8\ub4dc\ub294 \uacbd\ud5d8 \ub9ce\uc740 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \ube60\ub978 \ud48d\uc120\uacfc \ubcf5\uc7a1\ud55c \ud328\ud134\uc744 \ud2b9\uc9d5\uc73c\ub85c \ud569\ub2c8\ub2e4. '\uc2dc\uac04 \uacf5\uaca9' \ubaa8\ub4dc\ub294 \ube60\ub974\uace0 \uae34\ubc15\ud55c \uc2dc\uac04 \uc81c\ud55c \ucc4c\ub9b0\uc9c0\uac00 \uc7ac\ubbf8\uc788\ub294 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc801\ud569\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucd08\ubcf4 \ud50c\ub808\uc774\uc5b4\ub294 '\uc26c\uc6c0' \ubaa8\ub4dc\ub85c \uc2dc\uc791\ud558\uc5ec \uc790\uc2e0\uac10\uc744 \ud0a4\uc6b0\uace0 \ub354 \uc5b4\ub824\uc6b4 \ubaa8\ub4dc\ub85c \uc804\ud658\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud48d\uc120 \ud31d \uac8c\uc784\uc758 \ucf64\ubcf4 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uc5b4\ub5bb\uac8c \ucd5c\ub300\ud654\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud48d\uc120 \ud31d \uac8c\uc784\uc758 \ucf64\ubcf4 \uc2dc\uc2a4\ud15c\uc740 \ube60\ub974\uac8c \uc5f0\uc18d\uc801\uc73c\ub85c \ud48d\uc120\uc744 \ud130\ub728\ub9ac\ub294 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc5f0\uc18d\uc801\uc73c\ub85c \ud48d\uc120\uc744 \ud130\ub728\ub9b4 \ub54c\ub9c8\ub2e4 \ucf64\ubcf4 \ubc30\uc728\uc774 \ub192\uc544\uc838 \uc810\uc218\uac00 \ub192\uc544\uc9d1\ub2c8\ub2e4. \ucf64\ubcf4\ub97c \ucd5c\ub300\ud654\ud558\ub824\uba74 \ud48d\uc120\uc744 \ub193\uce58\uc9c0 \uc54a\uace0 \ud130\ub728\ub9ac\ub824\uace0 \ub178\ub825\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, 10\uac1c\uc758 \ud48d\uc120\uc744 \uc5f0\uc18d\uc73c\ub85c \ud130\ub728\ub9ac\uba74 \ucf64\ubcf4 \ubc30\uc728\uc774 \ud06c\uac8c \uc99d\uac00\ud558\uc5ec \uc804\uccb4 \uc810\uc218\uac00 \ud06c\uac8c \ub192\uc544\uc9d1\ub2c8\ub2e4. '\uba40\ud2f0 \ud31d'\uacfc \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud558\uba74 \ucf64\ubcf4 \uc5f0\uc1c4\ub97c \uc720\uc9c0\ud558\uace0 \uc99d\uac00\uc2dc\ud0a4\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud48d\uc120 \ud31d \uac8c\uc784\uc758 \ud30c\uc6cc\uc5c5 \uac04 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b8\uc81c \uc0ac\uc6a9\ud574\uc57c \ud558\ub098\uc694?", "answer": "\ud48d\uc120 \ud31d \uac8c\uc784\uc5d0\ub294 \uac01\uae30 \ub2e4\ub978 \uc774\uc810\uc744 \uac00\uc9c4 \uc5ec\ub7ec \ud30c\uc6cc\uc5c5\uc774 \uc788\uc2b5\ub2c8\ub2e4. '\uba40\ud2f0 \ud31d'\uc740 \ud55c \ubc88\uc758 \ud0ed\uc73c\ub85c \uc5ec\ub7ec \ud48d\uc120\uc744 \ud130\ub728\ub9b4 \uc218 \uc788\uc73c\uba70, \ud654\uba74\uc774 \ubcf5\uc7a1\ud55c \uc0c1\ud669\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4. '\uc2dc\uac04 \uc815\uc9c0'\ub294 \ud48d\uc120\uc758 \uc6c0\uc9c1\uc784\uc744 \ub2a6\ucdb0 \uc774\ub3d9 \uacc4\ud68d\uc744 \uc138\uc6b8 \uc2dc\uac04\uc744 \ub354\uc90d\ub2c8\ub2e4. '\uc810\uc218 \uc99d\uac00'\ub294 \ud130\ub728\ub9b4 \ub54c\ub9c8\ub2e4 \uc5bb\ub294 \uc810\uc218\ub97c \uc77c\uc2dc\uc801\uc73c\ub85c \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud654\uba74\uc774 \ud48d\uc120\uc73c\ub85c \uac00\ub4dd \ucc3c\uc744 \ub54c '\uc2dc\uac04 \uc815\uc9c0'\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud48d\uc120 \ud130\ub728\ub9ac\ub294 \ud6a8\uc728\uacfc \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud558\ub098\uc758 \uae30\uae30\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30\ub85c \ud48d\uc120 \ud31d \uac8c\uc784\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud48d\uc120 \ud31d \uac8c\uc784\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\ub978 \uae30\uae30\ub85c \uc774\uc804\ud558\ub824\uba74 \ub450 \uae30\uae30 \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \ub300\ubd80\ubd84\uc758 \ud50c\ub7ab\ud3fc\uc740 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \uc9c0\uc6d0\ud558\ubbc0\ub85c \uc9c4\ud589 \uc0c1\ud669\uc774 \uc790\ub3d9\uc73c\ub85c \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc548\ub4dc\ub85c\uc774\ub4dc \uae30\uae30\uc5d0\uc11c iOS \uae30\uae30\ub85c \uc804\ud658\ud558\ub294 \uacbd\uc6b0 \uc0c8 \uae30\uae30\uc5d0\uc11c Google Play \ub610\ub294 Apple ID\uc5d0 \ub85c\uadf8\uc778\ud558\uba74 \ub370\uc774\ud130\uac00 \uc804\uc1a1\ub429\ub2c8\ub2e4. \ubb38\uc81c\uac00 \ubc1c\uc0dd\ud558\uba74 \uac8c\uc784 \uc124\uc815\uc5d0\uc11c \uc218\ub3d9 \ub3d9\uae30\ud654 \uc635\uc158\uc744 \ud655\uc778\ud558\uac70\ub098 \uc9c0\uc6d0\ud300\uc5d0 \ubb38\uc758\ud558\uc138\uc694."}, {"question": "\ud48d\uc120 \ud31d \uac8c\uc784\uc758 \uc228\uaca8\uc9c4 \uc131\ucde8\ub3c4\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud574\uc81c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud48d\uc120 \ud31d \uac8c\uc784\uc5d0\ub294 \ud2b9\uc815 \ud589\ub3d9\uc744 \ud1b5\ud574 \ud574\uc81c\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc131\ucde8\ub3c4\uac00 \uc5ec\ub7ec \uac00\uc9c0 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud48d\uc120 \ub9c8\uc2a4\ud130'\ub294 \ud55c \uac8c\uc784 \uc138\uc158\uc5d0\uc11c 1,000\uac1c\uc758 \ud48d\uc120\uc744 \ud130\ub728\ub824 \ub2ec\uc131\ud569\ub2c8\ub2e4. '\ud30c\uc6cc\uc5c5 \uc804\ubb38\uac00'\ub294 \ubaa8\ub4e0 \ud30c\uc6cc\uc5c5\uc744 \ud55c \uac8c\uc784 \uc138\uc158\uc5d0\uc11c \uc0ac\uc6a9\ud558\uc5ec \ub2ec\uc131\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc131\ucde8\ub3c4\ub97c \ud574\uc81c\ud558\ub824\uba74 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc744 \uc219\ub2ec\ud558\uace0 \ub2e4\uc591\ud55c \uc804\ub7b5\uc744 \uc2dc\ub3c4\ud574\ubcf4\uc138\uc694. \uc131\ucde8\ub3c4 \ubaa9\ub85d\uc744 \uc8fc\uc2dc\ud558\uba74 \uc5b4\ub5a4 \ud589\ub3d9\uc744 \ucde8\ud574\uc57c \ud558\ub294\uc9c0 \ud78c\ud2b8\uac00 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud48d\uc120 \ud31d \uac8c\uc784\uc758 \uc810\uc218 \uacc4\uc0b0 \ubc29\uc2dd\uc740 \ubb34\uc5c7\uc774\uba70, \ucd5c\uc885 \uc810\uc218\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc694\uc18c\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud48d\uc120 \ud31d \uac8c\uc784\uc758 \uc810\uc218 \uacc4\uc0b0 \ubc29\uc2dd\uc740 \uc5ec\ub7ec \uc694\uc18c\ub97c \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. \ud130\ub728\ub9b0 \ud48d\uc120\uc758 \uc218, \ucf64\ubcf4 \ubc30\uc728, \ud30c\uc6cc\uc5c5 \uc0ac\uc6a9 \ub4f1\uc785\ub2c8\ub2e4. \ud130\ub728\ub9b0 \uac01 \ud48d\uc120\uc740 \uae30\ubcf8 \uc810\uc218\ub97c \ubd80\uc5ec\ud558\uba70, \ud604\uc7ac \ucf64\ubcf4\uc5d0 \ub530\ub77c \uacf1\ud574\uc9d1\ub2c8\ub2e4. '\uace8\ub4e0 \ud48d\uc120'\uacfc \uac19\uc740 \ud2b9\uc218 \ud48d\uc120\uc740 \ubcf4\ub108\uc2a4 \uc810\uc218\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub192\uc740 \ucf64\ubcf4 \ubc30\uc728\ub85c '\uace8\ub4e0 \ud48d\uc120'\uc744 \ud130\ub728\ub9ac\uba74 \uc810\uc218\uac00 \ud06c\uac8c \ub192\uc544\uc9d1\ub2c8\ub2e4. \ub610\ud55c, '\uc810\uc218 \uc99d\uac00'\uc640 \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud558\uba74 \uac01 \ud130\ub728\ub9bc\uc5d0 \ub300\ud55c \uc810\uc218\ub97c \ub354\uc6b1 \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud48d\uc120 \ud31d \uac8c\uc784\uc744 \uae30\uae30\uc5d0 \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ud558\uae30 \uc704\ud55c \uae30\uc220\uc801 \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud48d\uc120 \ud31d \uac8c\uc784\uc744 \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ud558\ub824\uba74 \uae30\uae30\uac00 \ucd5c\uc18c \uae30\uc220 \uc694\uad6c \uc0ac\ud56d\uc744 \ucda9\uc871\ud574\uc57c \ud569\ub2c8\ub2e4. \uc548\ub4dc\ub85c\uc774\ub4dc\uc758 \uacbd\uc6b0 \ucd5c\uc18c \uc548\ub4dc\ub85c\uc774\ub4dc 5.0(\ub864\ub9ac\ud31d) \uc774\uc0c1\uacfc 2GB\uc758 RAM\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. iOS \uc0ac\uc6a9\uc790\ub294 iOS 10 \uc774\uc0c1\uacfc 1GB\uc758 RAM\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub610\ud55c, \uc9c4\ud589 \uc0c1\ud669 \ub3d9\uae30\ud654 \ubc0f \uc628\ub77c\uc778 \uae30\ub2a5\uc5d0 \uc811\uadfc\ud558\uae30 \uc704\ud574 \uc548\uc815\uc801\uc778 \uc778\ud130\ub137 \uc5f0\uacb0\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc774\ub7ec\ud55c \uc0ac\uc591\uc744 \uac16\ucd98 \uae30\uae30\uc5d0\uc11c \uac8c\uc784\uc744 \ud558\uba74 \uc6d0\ud65c\ud558\uace0 \uc990\uac70\uc6b4 \uac8c\uc784 \uacbd\ud5d8\uc744 \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud48d\uc120 \ud31d \uac8c\uc784\uc5d0\uc11c \uace0\ub4dd\uc810 \ub2ec\uc131\uc5d0 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ud30c\uc6cc\uc5c5\uc740 \ubb34\uc5c7\uc774\uba70, \uadf8 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "'\uc810\uc218 \uc99d\uac00' \ud30c\uc6cc\uc5c5\uc740 \ud48d\uc120 \ud31d \uac8c\uc784\uc5d0\uc11c \uace0\ub4dd\uc810 \ub2ec\uc131\uc5d0 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. \uc774 \ud30c\uc6cc\uc5c5\uc740 \ud130\ub728\ub9b4 \ub54c\ub9c8\ub2e4 \uc5bb\ub294 \uc810\uc218\ub97c \uc77c\uc2dc\uc801\uc73c\ub85c \uc99d\uac00\uc2dc\ud0a4\uae30 \ub54c\ubb38\uc5d0 \ub192\uc740 \ucf64\ubcf4 \ubc30\uc728\uacfc \uacb0\ud569\ud558\uba74 \uc0c1\ub2f9\ud55c \uc810\uc218 \uc99d\uac00\ub97c \uac00\uc838\uc62c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub192\uc740 \ucf64\ubcf4 \uc5f0\uc1c4 \uc911 '\uc810\uc218 \uc99d\uac00'\ub97c \uc0ac\uc6a9\ud558\uba74 \uc810\uc218\uac00 \uae30\ud558\uae09\uc218\uc801\uc73c\ub85c \uc99d\uac00\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \ud0c0\uc774\ubc0d\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uac15\ub825\ud55c \ucf64\ubcf4\uc640 \ud654\uba74\uc774 \ubcf5\uc7a1\ud55c \uacbd\uc6b0\uc5d0 \uc0ac\uc6a9\ud558\uc5ec \ud6a8\uacfc\ub97c \uadf9\ub300\ud654\ud558\uc138\uc694."}]
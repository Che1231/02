[{"question": "\u521d\u5fc3\u8005\u3068\u3057\u3066BalloonPop\u3092\u3069\u306e\u3088\u3046\u306b\u958b\u59cb\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "BalloonPop\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u307e\u305a\u304a\u597d\u307f\u306e\u30a2\u30d7\u30ea\u30b9\u30c8\u30a2\u304b\u3089\u30b2\u30fc\u30e0\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3066\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u5f8c\u3001\u30b2\u30fc\u30e0\u3092\u958b\u304d\u3001\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3092\u5b8c\u4e86\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3067\u306f\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u65b9\u6cd5\u304c\u8aac\u660e\u3055\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u98a8\u8239\u3092\u30bf\u30c3\u30d7\u3057\u3066\u5272\u308b\u65b9\u6cd5\u3084\u3001\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3059\u308b\u65b9\u6cd5\u3092\u5b66\u7fd2\u3057\u307e\u3059\u3002\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3067\u306f\u3001\u8907\u6570\u306e\u98a8\u8239\u3092\u540c\u6642\u306b\u5272\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u300e\u30de\u30eb\u30c1\u30dd\u30c3\u30d7\u300f\u306a\u3069\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3082\u7d39\u4ecb\u3055\u308c\u307e\u3059\u3002\u300e\u7c21\u5358\u300f\u30e2\u30fc\u30c9\u304b\u3089\u59cb\u3081\u3066\u3001\u30b2\u30fc\u30e0\u306e\u30da\u30fc\u30b9\u3068\u64cd\u4f5c\u306b\u6163\u308c\u308b\u3053\u3068\u3092\u304a\u52e7\u3081\u3057\u307e\u3059\u3002"}, {"question": "BalloonPop\u3067\u9ad8\u5f97\u70b9\u3092\u53d6\u308b\u305f\u3081\u306e\u6700\u9069\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "BalloonPop\u3067\u9ad8\u5f97\u70b9\u3092\u53d6\u308b\u306b\u306f\u3001\u30b9\u30d4\u30fc\u30c9\u3068\u6226\u7565\u306e\u4e21\u65b9\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u9023\u7d9a\u3057\u3066\u98a8\u8239\u3092\u5272\u3063\u3066\u30b3\u30f3\u30dc\u500d\u7387\u3092\u4e0a\u3052\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u6226\u7565\u7684\u306b\u5229\u7528\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u6642\u9593\u505c\u6b62\u300f\u306f\u753b\u9762\u304c\u6df7\u96d1\u3057\u3066\u3044\u308b\u3068\u304d\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3067\u304d\u308b\u300e\u30b4\u30fc\u30eb\u30c7\u30f3\u98a8\u8239\u300f\u306a\u3069\u306e\u7279\u5225\u306a\u98a8\u8239\u3092\u72d9\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6df7\u96d1\u3057\u305f\u30b2\u30fc\u30e0\u72b6\u6cc1\u3067\u306f\u3001\u300e\u6642\u9593\u505c\u6b62\u300f\u306e\u5f8c\u306b\u300e\u30de\u30eb\u30c1\u30dd\u30c3\u30d7\u300f\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u30b9\u30b3\u30a2\u3092\u5927\u5e45\u306b\u4f38\u3070\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "BalloonPop\u306b\u306f\u3001\u306a\u305c\u3055\u307e\u3056\u307e\u306a\u30e2\u30fc\u30c9\u304c\u3042\u308a\u3001\u3069\u308c\u3092\u9078\u3079\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "BalloonPop\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u3068\u597d\u307f\u306b\u5bfe\u5fdc\u3059\u308b\u305f\u3081\u306b\u3001\u3055\u307e\u3056\u307e\u306a\u30e2\u30fc\u30c9\u3092\u63d0\u4f9b\u3057\u3066\u3044\u307e\u3059\u3002\u300e\u7c21\u5358\u300f\u30e2\u30fc\u30c9\u306f\u3001\u521d\u5fc3\u8005\u5411\u3051\u3067\u3001\u98a8\u8239\u306e\u901f\u5ea6\u304c\u9045\u304f\u3001\u969c\u5bb3\u7269\u304c\u5c11\u306a\u3044\u306e\u304c\u7279\u5fb4\u3067\u3059\u3002\u300e\u96e3\u3057\u3044\u300f\u30e2\u30fc\u30c9\u306f\u3001\u7d4c\u9a13\u8c4a\u5bcc\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u6311\u6226\u3055\u305b\u308b\u305f\u3081\u306b\u3001\u98a8\u8239\u306e\u901f\u5ea6\u304c\u901f\u304f\u3001\u30d1\u30bf\u30fc\u30f3\u304c\u8907\u96d1\u3067\u3059\u3002\u300e\u30bf\u30a4\u30e0\u30a2\u30bf\u30c3\u30af\u300f\u30e2\u30fc\u30c9\u306f\u3001\u30b9\u30d4\u30fc\u30c9\u611f\u3042\u3075\u308c\u308b\u6642\u9593\u5236\u9650\u306e\u3042\u308b\u6311\u6226\u3092\u697d\u3057\u307f\u305f\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u6700\u9069\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u3042\u306a\u305f\u304c\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u306a\u3089\u3001\u300e\u7c21\u5358\u300f\u30e2\u30fc\u30c9\u304b\u3089\u59cb\u3081\u3066\u3001\u3088\u308a\u96e3\u3057\u3044\u30e2\u30fc\u30c9\u306b\u79fb\u884c\u3059\u308b\u524d\u306b\u81ea\u4fe1\u3068\u30b9\u30ad\u30eb\u3092\u8eab\u306b\u3064\u3051\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "BalloonPop\u306e\u30b3\u30f3\u30dc\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u3069\u306e\u3088\u3046\u306b\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "BalloonPop\u306e\u30b3\u30f3\u30dc\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u9023\u7d9a\u3057\u3066\u98a8\u8239\u3092\u5272\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u5831\u3044\u307e\u3059\u3002\u9023\u7d9a\u3059\u308b\u305d\u308c\u305e\u308c\u306e\u5272\u308b\u884c\u70ba\u304c\u30b3\u30f3\u30dc\u500d\u7387\u3092\u9ad8\u3081\u3001\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002\u30b3\u30f3\u30dc\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u98a8\u8239\u3092\u30df\u30b9\u3059\u308b\u3053\u3068\u306a\u304f\u5272\u308b\u3088\u3046\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u300110\u500b\u306e\u98a8\u8239\u3092\u9023\u7d9a\u3067\u5272\u308b\u3068\u3001\u30b3\u30f3\u30dc\u500d\u7387\u304c\u5927\u5e45\u306b\u4e0a\u6607\u3057\u3001\u7dcf\u5408\u7684\u306a\u30b9\u30b3\u30a2\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002\u300e\u30de\u30eb\u30c1\u30dd\u30c3\u30d7\u300f\u306a\u3069\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3059\u308b\u3068
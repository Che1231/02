[{"question": "\u30d1\u30d1\u306e\u30bf\u30b3\u30df\u30a2\u3067\u30bf\u30b3\u30b9\u4f5c\u308a\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u521d\u5fc3\u8005\u3067\u3082\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u306e\u30bf\u30b3\u30df\u30a2\u3067\u30bf\u30b3\u30b9\u4f5c\u308a\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71 \u2013 \u304a\u5ba2\u69d8\u306e\u6ce8\u6587\u3092\u53d7\u3051\u3001\u305d\u306e\u597d\u307f\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72 \u2013 \u30c8\u30eb\u30c6\u30a3\u30fc\u30e4\u306e\u7a2e\u985e\u3092\u9078\u3076\u305f\u3081\u306b\u30c8\u30eb\u30c6\u30a3\u30fc\u30e4\u306e\u99c5\u306b\u79fb\u52d5\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d73 \u2013 \u8089\u3001\u91ce\u83dc\u3001\u30bd\u30fc\u30b9\u306a\u3069\u306e\u9078\u629e\u3057\u305f\u6750\u6599\u3092\u52a0\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u3001\u304a\u5ba2\u69d8\u304c\u725b\u8089\u306e\u30bf\u30b3\u30b9\u306b\u30ec\u30bf\u30b9\u3068\u30b5\u30eb\u30b5\u3092\u6ce8\u6587\u3057\u305f\u5834\u5408\u3001\u5c0f\u9ea6\u7c89\u306e\u30c8\u30eb\u30c6\u30a3\u30fc\u30e4\u3092\u9078\u3073\u3001\u725b\u8089\u3001\u30ec\u30bf\u30b9\u3001\u6b21\u306b\u30b5\u30eb\u30b5\u3092\u52a0\u3048\u307e\u3059\u3002\u6b63\u78ba\u6027\u3092\u78ba\u4fdd\u3059\u308b\u305f\u3081\u306b\u3001\u6ce8\u6587\u7968\u3092\u53c2\u8003\u306b\u3055\u308c\u308b\u3053\u3068\u3092\u304a\u52e7\u3081\u3057\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u306e\u30bf\u30b3\u30df\u30a2\u3067\u3001\u306a\u305c\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u3067\u3001\u3069\u306e\u3088\u3046\u306b\u6539\u5584\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u306e\u30bf\u30b3\u30df\u30a2\u3067\u306f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u306f\u30c1\u30c3\u30d7\u7387\u3068\u9867\u5ba2\u6e80\u8db3\u5ea6\u306b\u5f71\u97ff\u3059\u308b\u305f\u3081\u3001\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u6539\u5584\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71 \u2013 \u8089\u306e\u30b0\u30ea\u30eb\u30ea\u30f3\u30b0\u306e\u3088\u3046\u306a\u3001\u8abf\u7406\u6642\u9593\u306e\u9577\u3055\u304c\u9577\u3044\u4f5c\u696d\u304b\u3089\u512a\u5148\u9806\u4f4d\u3092\u3064\u3051\u3066\u958b\u59cb\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72 \u2013 \u8907\u6570\u306e\u90e8\u54c1\u3092\u540c\u6642\u306b\u6e96\u5099\u3057\u3066\u3001\u30de\u30eb\u30c1\u30bf\u30b9\u30ad\u30f3\u30b0\u3092\u6d3b\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d73 \u2013 \u6642\u523b\u8868\u3092\u6ce8\u610f\u6df1\u304f\u898b\u5b88\u308a\u3001\u5358\u4e00\u306e\u99c5\u3078\u306e\u8ca0\u8377\u3092\u907f\u3051\u307e\u3057\u3087\u3046\u3002\u305f\u3068\u3048\u3070\u3001\u8089\u3092\u30b0\u30ea\u30eb\u3057\u3066\u3044\u308b\u9593\u306b\u91ce\u83dc\u3092\u5207\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30bf\u30b9\u30af\u3092\u8ffd\u8de1\u3059\u308b\u305f\u3081\u306b\u3001\u982d\u306e\u4e2d\u306e\u30c1\u30a7\u30c3\u30af\u30ea\u30b9\u30c8\u3092\u4f7f\u3044\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u30d1\u30d1\u306e\u30bf\u30b3\u30df\u30a2\u3067\u91cd\u8981\u306a\u6750\u6599\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u306f\u6700\u7d42\u88fd\u54c1\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u306e\u30bf\u30b3\u30df\u30a2\u3067\u91cd\u8981\u306a\u6750\u6599\u306b\u306f\u3001\u30c8\u30eb\u30c6\u30a3\u30fc\u30e4\u3001\u8089\u3001\u91ce\u83dc\u3001\u30bd\u30fc\u30b9\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u305d\u308c\u305e\u308c\u306e\u6750\u6599\u306f\u6700\u7d42\u88fd\u54c1\u306b\u7279\u5b9a\u306e\u65b9\u6cd5\u3067\u5f71\u97ff\u3057\u307e\u3059\u3002\u30c8\u30eb\u30c6\u30a3\u30fc\u30e4\u306f\u57fa\u672c\u7684\u306a\u98df\u611f\u3001\u8089\u306f\u4e3b\u305f\u308b\u98a8\u5473\u3001\u91ce\u83dc\u306f\u65b0\u9bae\u3055\u3068\u30b6\u30af\u30c3\u3068\u3057\u305f\u98df\u611f\u3001\u30bd\u30fc\u30b9\u306f\u5168\u4f53\u7684\u306a\u5473\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30b3\u30fc\u30f3\u30c8\u30eb\u30c6\u30a3\u30fc\u30e4\u306b\u30b0\u30ea\u30eb\u30c1\u30ad\u30f3\u3001\u30ec\u30bf\u30b9\u3001\u30b9\u30d1\u30a4\u30b7\u30fc\u30bd\u30fc\u30b9\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u5c0f\u9ea6\u7c89\u306e\u30c8\u30eb\u30c6\u30a3\u30fc\u30e4\u306b\u725b\u8089\u3001\u30c8\u30de\u30c8\u3001\u30de\u30a4\u30eb\u30c9\u30bd\u30fc\u30b9\u3092\u4f7f\u7528\u3059\u308b\u5834\u5408\u3068\u306f\u7570\u306a\u308b\u7d4c\u9a13\u306b\u306a\u308a\u307e\u3059\u3002\u7d44\u307f\u5408\u308f\u305b\u3092\u8a66\u3057\u3066\u3001\u304a\u5ba2\u69d8\u306e\u304a\u6c17\u306b\u5165\u308a\u3092\u898b\u3064\u3051\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30d1\u30d1\u306e\u30bf\u30b3\u30df\u30a2\u3067\u6750\u6599\u306e\u4f7f\u7528\u3092\u6700\u9069\u5316\u3057\u3066\u5229\u76ca\u3092\u6700\u5927\u5316\u3059\u308b\u65b9\u6cd5\u306f\uff1f", "answer": "\u30d1\u30d1\u306e\u30bf\u30b3\u30df\u30a2\u3067\u6750\u6599\u306e\u4f7f\u7528\u3092\u6700\u9069\u5316\u3057\u3001\u5229\u76ca\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71 \u2013 \u4eba\u6c17\u306e\u6ce8\u6587\u3092\u8ffd\u8de1\u3057\u3001\u305d\u308c\u306b\u5fdc\u3058\u3066\u6750\u6599\u3092\u4fdd\u7ba1\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72 \u2013 \u6ce8\u6587\u304c\u305d\u308c\u307b\u3069\u591a\u304f\u306a\u3044\u6750\u6599\u306e\u904e\u5270\u306a\u6e96\u5099\u3092\u907f\u3051\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d73 \u2013 \u9ad8\u5229\u76ca\u5546\u54c1\u3092\u5ba3\u4f1d\u3059\u308b\u305f\u3081\u306b\u3001\u300c\u30b9\u30da\u30b7\u30e3\u30eb\u300d\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u3001\u725b\u8089\u306e\u30bf\u30b3\u30b9\u304c\u9b5a\u4ecb\u306e\u30bf\u30b3\u30b9\u3088\u308a\u3082\u4eba\u6c17\u304c\u3042\u308b\u5834\u5408\u306f\u3001\u5341\u5206\u306a\u725b\u8089\u3092\u5728\u5eab\u3057\u3066\u304a\u304d\u3001\u725b\u8089\u30bf\u30b3\u30b9\u30b9\u30da\u30b7\u30e3\u30eb\u3092\u5ba3\u4f1d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u5ec3\u68c4\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u308b\u305f\u3081\u3001\u5b9a\u671f\u7684\u306b\u5728\u5eab\u3092\u76e3\u8996\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30d1\u30d1\u306e\u30bf\u30b3\u30df\u30a2\u3067\u5b8c\u74a7\u306a\u30b9\u30b3\u30a2\u3092\u5f97\u308b\u305f\u3081\u306b\u3069\u306e\u3088\u3046\u306a\u6226\u7565\u304c\u6709\u52b9\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u306e\u30bf\u30b3\u30df\u30a2\u3067\u5b8c\u74a7\u306a\u30b9\u30b3\u30a2\u3092\u5f97\u308b\u306b\u306f\u3001\u30b9\u30d4\u30fc\u30c9\u3001\u6b63\u78ba\u6027\u3001\u9867\u5ba2\u6e80\u8db3\u5ea6\u306e\u7d44\u307f\u5408\u308f\u305b\u304c\u5fc5\u8981\u3067\u3059\u3002 \u3044\u304f\u3064\u304b\u306e\u6226\u7565\u3092\u4ee5\u4e0b\u306b\u793a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71 \u2013 \u591a\u6570\u306e\u6ce8\u6587\u3092\u52b9\u7387\u7684\u306b\u51e6\u7406\u3059\u308b\u305f\u3081\u306b\u3001\u30de\u30eb\u30c1\u30bf\u30b9\u30ad\u30f3\u30b0\u3092\u5b9f\u8df5\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 \u2013 \u9867\u5ba2\u306e\u597d\u307f\u3092\u6ce8\u610f\u6df1\u304f\u898b\u5b88\u308a\u3001\u6ce8\u6587\u5185\u5bb9\u306b\u5fdc\u3058\u3066\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 \u2013 \u300c\u30b9\u30da\u30b7\u30e3\u30eb\u300d\u3084\u300c\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u300d\u3092\u4f7f\u7528\u3057\u3066\u30c1\u30c3\u30d7\u7387\u3092\u4e0a\u3052\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u304a\u5ba2\u69d8\u304c\u30c1\u30fc\u30ba\u3092\u8ffd\u52a0\u3057\u305f\u3044\u5834\u5408\u306f\u3001\u9045\u5ef6\u3059\u308b\u3053\u3068\u306a\u304f\u8ffd\u52a0\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5b9a\u671f\u7684\u306b\u898b\u76f4\u3057\u3001\u6539\u5584\u3059\u3079\u304d\u70b9\u3092\u7279\u5b9a\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30d1\u30d1\u306e\u30bf\u30b3\u30df\u30a2\u3067\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306e\u4ed5\u7d44\u307f\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u306e\u30bf\u30b3\u30df\u30a2\u3067\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6b63\u78ba\u6027\u3001\u30b9\u30d4\u30fc\u30c9\u3001\u9867\u5ba2\u6e80\u8db3\u5ea6\u306e3\u3064\u306e\u4e3b\u8981\u306a\u8981\u56e0\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u6b63\u78ba\u6027\u306f\u3001\u6ce8\u6587\u4ed5\u69d8\u306b\u5f93\u3046\u80fd\u529b\u306b\u3088\u3063\u3066\u6c7a\u5b9a\u3055\u308c\u307e\u3059\u3002\u30b9\u30d4\u30fc\u30c9\u306f\u3001\u6ce8\u6587\u3092\u5b8c\u4e86\u3059\u308b\u306e\u306b\u304b\u304b\u308b\u6642\u9593\u3067\u8a08\u6e2c\u3055\u308c\u307e\u3059\u3002\u9867\u5ba2\u6e80\u8db3\u5ea6\u306f\u3001\u597d\u307f\u306b\u5fdc\u3058\u305f\u5bfe\u5fdc\u306e\u9069\u5207\u3055\u3068\u3001\u8ffd\u52a0\u306e\u8981\u671b\u306b\u5fdc\u3058\u308b\u80fd\u529b\u306b\u3088\u3063\u3066\u5f71\u97ff\u3092\u53d7\u3051\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u304a\u5ba2\u69d8\u304c\u30bf\u30b3\u30b9\u306b\u30bf\u30de\u30cd\u30ae\u3092\u4ed8\u3051\u305f\u304f\u306a\u3044\u5834\u5408\u306f\u3001\u30bf\u30de\u30cd\u30ae\u3092\u542b\u3081\u308b\u3068\u3001\u6b63\u78ba\u6027\u306e\u30b9\u30b3\u30a2\u304c\u4e0b\u304c\u308b\u3067\u3057\u3087\u3046\u3002\u3053\u308c\u3089\u306e\u8981\u7d20\u3092\u30d0\u30e9\u30f3\u30b9\u3055\u305b\u308b\u3053\u3068\u304c\u3001\u9ad8\u5f97\u70b9\u9054\u6210\u306e\u9375\u3068\u306a\u308a\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u306e\u30bf\u30b3\u30df\u30a2\u3067\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u3069\u306e\u3088\u3046\u306b\u5f37\u5316\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u306e\u30bf\u30b3\u30df\u30a2\u3067\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30bf\u30b3\u30b9\u4f5c\u308a\u306e\u52b9\u7387\u3068\u54c1\u8cea\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u306b\u3088\u308a\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5f37\u5316\u3057\u307e\u3059\u3002\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u306f\u3001\u9ad8\u901f\u8abf\u7406\u6642\u9593\u3001\u3088\u308a\u826f\u3044\u7d20\u6750\u3001\u5f37\u5316\u3055\u308c\u305f\u30c4\u30fc\u30eb\u304c\u542b\u307e\u308c\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30b0\u30ea\u30eb\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3068\u3001\u8089\u306e\u8abf\u7406\u6642\u9593\u3092\u77ed\u7e2e\u3067\u304d\u3001\u3088\u308a\u591a\u304f\u306e\u6ce8\u6587\u306b\u5bfe\u5fdc\u3067\u304d\u307e\u3059\u3002\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u6226\u7565\u7684\u306b\u4f7f\u7528\u3057\u3066\u305d\u306e\u6069\u6075\u3092\u6700\u5927\u9650\u306b\u6d3b\u7528\u3057\u3001\u3042\u306a\u305f\u306e\u5168\u4f53\u7684\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6539\u5584\u3057\u307e\u3057\u3087\u3046\u3002\u63d0\u4f9b\u3055\u308c\u3066\u3044\u308b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u5b9a\u671f\u7684\u306b\u78ba\u8a8d\u3057\u3001\u6700\u3082\u5927\u304d\u306a\u5229\u70b9\u3092\u3082\u305f\u3089\u3059\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u6295\u8cc7\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u30d1\u30d1\u306e\u30bf\u30b3\u30df\u30a2\u3067\u306e\u79c1\u306e\u9032\u6357\u72b6\u6cc1\u3092\u5225\u306e\u30c7\u30d0\u30a4\u30b9\u306b\u79fb\u8ee2\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u3001\u30d1\u30d1\u306e\u30bf\u30b3\u30df\u30a2\u3067\u306e\u9032\u6357\u72b6\u6cc1\u3092\u5225\u306e\u30c7\u30d0\u30a4\u30b9\u306b\u79fb\u8ee2\u3067\u304d\u307e\u3059\u3002\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3001\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u304c\u6709\u52b9\u306b\u306a\u3063\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u3001Android\u30c7\u30d0\u30a4\u30b9\u304b\u3089iOS\u30c7\u30d0\u30a4\u30b9\u306b\u5207\u308a\u66ff\u3048\u308b\u5834\u5408\u306f\u3001\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u3067\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u9032\u6357\u72b6\u6cc1\u3092\u540c\u671f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u9032\u6357\u72b6\u6cc1\u306e\u55aa\u5931\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u3001\u5207\u308a\u66ff\u3048\u308b\u524d\u306b\u5fc5\u305a\u30c7\u30fc\u30bf\u3092\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30d1\u30d1\u306e\u30bf\u30b3\u30df\u30a2\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u306e\u30bf\u30b3\u30df\u30a2\u306b\u306f\u3001\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u8c4a\u304b\u306b\u3059\u308b\u5e7e\u3064\u304b\u306e\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3068\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u3042\u308a\u307e\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3001\u7279\u5b9a\u306e\u8ab2\u984c\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3067\u7279\u5225\u306a\u6750\u6599\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u308b\u70b9\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5b8c\u74a7\u306a\u30b9\u30b3\u30a2\u3067100\u4ef6\u306e\u6ce8\u6587\u3092\u5b8c\u4e86\u3059\u308b\u3068\u3001\u9867\u5ba2\u6e80\u8db3\u5ea6\u3092\u9ad8\u3081\u308b\u7279\u5225\u306a\u30bd\u30fc\u30b9\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u30b2\u30fc\u30e0\u5185\u306e\u30d2\u30f3\u30c8\u306b\u6ce8\u610f\u3057\u3001\u3055\u307e\u3056\u307e\u306a\u7d44\u307f\u5408\u308f\u305b\u3092\u8a66\u3057\u3066\u3001\u3053\u308c\u3089\u306e\u96a0\u3055\u308c\u305f\u5b9d\u77f3\u3092\u767a\u898b\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u5b9a\u671f\u7684\u306b\u30b2\u30fc\u30e0\u3092\u63a2\u7d22\u3057\u3066\u3001\u65b0\u3057\u3044\u9a5a\u304d\u3092\u898b\u3064\u3051\u3066\u304f\u3060\u3055\u3044\u3002"}]
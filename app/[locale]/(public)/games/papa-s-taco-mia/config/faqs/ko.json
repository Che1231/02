[{"question": "\ucd08\ubcf4\uc790\uac00 \ud30c\ud30c\uc2a4 \ud0c0\ucf54 \ubbf8\uc544\uc5d0\uc11c \ud0c0\ucf54 \uc81c\uc791\uc744 \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud30c\ud30c\uc2a4 \ud0c0\ucf54 \ubbf8\uc544\uc5d0\uc11c \ud0c0\ucf54 \uc81c\uc791\uc744 \uc2dc\uc791\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. \ub2e8\uacc41 - \uace0\uac1d\uc758 \uc8fc\ubb38\uc744 \ubc1b\uace0 \uae30\ud638\ub97c \uba54\ubaa8\ud569\ub2c8\ub2e4. \ub2e8\uacc42 - \ud130\ud0a4\ub098 \uc808\ud3b8\uc744 \uc120\ud0dd\ud558\uae30 \uc704\ud574 \ud130\ud0a4\ub098 \uc808\ud3b8\ub300\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4. \ub2e8\uacc43 - \uace0\uae30, \ucc44\uc18c \ubc0f \uc18c\uc2a4\uc640 \uac19\uc740 \uc120\ud0dd\ud55c \uc7ac\ub8cc\ub97c \ucd94\uac00\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uace0\uac1d\uc774 \uc1e0\uace0\uae30 \ud0c0\ucf54\uc5d0 \uc0c1\ucd94\uc640 \uc0b4\uc0ac\ub97c \uc8fc\ubb38\ud558\uba74 \ubc00\uac00\ub8e8 \ud130\ud0a4\ub098\ub97c \uc120\ud0dd\ud558\uace0 \uc1e0\uace0\uae30, \uc0c1\ucd94, \uc0b4\uc0ac\ub97c \ucd94\uac00\ud558\uba74 \ub429\ub2c8\ub2e4. \uc815\ud655\uc131\uc744 \ud655\ubcf4\ud558\uae30 \uc704\ud574 \uc8fc\ubb38 \ud45c\ub97c \ucc38\uc870\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ud30c\ud30c\uc2a4 \ud0c0\ucf54 \ubbf8\uc544\uc5d0\uc11c \uc2dc\uac04 \uad00\ub9ac\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \uac1c\uc120\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud30c\ud30c\uc2a4 \ud0c0\ucf54 \ubbf8\uc544\uc5d0\uc11c \uc2dc\uac04 \uad00\ub9ac\uac00 \uc911\uc694\ud55c \uac83\uc740 \ud301 \ube44\uc728\uacfc \uace0\uac1d \ub9cc\uc871\ub3c4\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc2dc\uac04 \uad00\ub9ac\ub97c \uac1c\uc120\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. \ub2e8\uacc41 - \uace0\uae30 \uad6c\uc774\uc640 \uac19\uc774 \uc694\ub9ac \uc2dc\uac04\uc774 \uac00\uc7a5 \uae34 \uc791\uc5c5\ubd80\ud130 \uc6b0\uc120\uc21c\uc704\ub97c \ub9e4\uae41\ub2c8\ub2e4. \ub2e8\uacc42 - \uc5ec\ub7ec \uad6c\uc131 \uc694\uc18c\ub97c \ub3d9\uc2dc\uc5d0 \uc900\ube44\ud558\uc5ec \ub2e4\uc911 \uc791\uc5c5\uc744 \uc218\ud589\ud569\ub2c8\ub2e4. \ub2e8\uacc43 - \uc2dc\uacc4\ub97c \uc8fc\uc2dc\ud558\uace0 \uc5b4\ub5a4 \ud55c \uc791\uc5c5\uc7a5\ub3c4 \uacfc\ubd80\ud558\ub418\uc9c0 \uc54a\ub3c4\ub85d \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uace0\uae30\uac00 \uad6c\uc6cc\uc9c0\uace0 \uc788\ub294 \ub3d9\uc548 \ucc44\uc18c\ub97c \ub2e4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc791\uc5c5 \ucd94\uc801\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\uae30 \uc704\ud574 \uc815\uc2e0\uc801\uc778 \uccb4\ud06c\ub9ac\uc2a4\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ud30c\ud30c\uc2a4 \ud0c0\ucf54 \ubbf8\uc544\uc758 \uc8fc\uc694 \uc7ac\ub8cc\ub294 \ubb34\uc5c7\uc774\uba70 \ucd5c\uc885 \uc81c\ud488\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud0c0\ucf54 \ubbf8\uc544\uc758 \uc8fc\uc694 \uc7ac\ub8cc\ub294 \ud130\ud0a4\ub098, \uace0\uae30, \ucc44\uc18c \ubc0f \uc18c\uc2a4\uc785\ub2c8\ub2e4. \uac01 \uc7ac\ub8cc\ub294 \ucd5c\uc885 \uc81c\ud488\uc5d0 \ud2b9\uc815\ud55c \ubc29\uc2dd\uc73c\ub85c \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ud130\ud0a4\ub098\ub294 \uae30\ubcf8\uc801\uc778 \uc9c8\uac10\uc744 \uacb0\uc815\ud558\uace0, \uace0\uae30\ub294 \uc8fc\uc694 \ud48d\ubbf8\ub97c \uc81c\uacf5\ud558\uba70, \ucc44\uc18c\ub294 \uc2e0\uc120\ud568\uacfc \ubc14\uc0ad\ud568\uc744 \ub354\ud558\uace0, \uc18c\uc2a4\ub294 \uc804\uccb4\uc801\uc778 \ub9db\uc744 \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc625\uc218\uc218 \ud130\ud0a4\ub098\uc5d0 \uad6c\uc6b4 \ub2ed\uace0\uae30, \uc0c1\ucd94 \ubc0f \ub9e4\uc6b4 \uc18c\uc2a4\ub97c \uc0ac\uc6a9\ud558\uba74 \ubc00\uac00\ub8e8 \ud130\ud0a4\ub098\uc5d0 \uc1e0\uace0\uae30, \ud1a0\ub9c8\ud1a0 \ubc0f \uc21c\ud55c \uc18c\uc2a4\ub97c \uc0ac\uc6a9\ud558\ub294 \uac83\uacfc \ub2e4\ub978 \uacbd\ud5d8\uc774 \ub429\ub2c8\ub2e4. \uc870\ud569\uc744 \uc2dc\ub3c4\ud558\uc5ec \uace0\uac1d\uc774 \uc120\ud638\ud558\ub294 \uac83\uc744 \ubc1c\uacac\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ud30c\ud30c\uc2a4 \ud0c0\ucf54 \ubbf8\uc544\uc5d0\uc11c \uc7ac\ub8cc \uc0ac\uc6a9\uc744 \ucd5c\uc801\ud654\ud558\uc5ec \uc774\uc775\uc744 \uadf9\ub300\ud654\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud558\ub098\uc694?", "answer": "\ud30c\ud30c\uc2a4 \ud0c0\ucf54 \ubbf8\uc544\uc5d0\uc11c \uc7ac\ub8cc \uc0ac\uc6a9\uc744 \ucd5c\uc801\ud654\ud558\uace0 \uc774\uc775\uc744 \uadf9\ub300\ud654\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. \ub2e8\uacc41 - \uc778\uae30 \uc8fc\ubb38\uc744 \ucd94\uc801\ud558\uace0 \uc7ac\ub8cc\ub97c \uadf8\uc5d0 \ub530\ub77c \uc7ac\uace0 \uad00\ub9ac\ud569\ub2c8\ub2e4. \ub2e8\uacc42 - \uc8fc\ubb38 \ube48\ub3c4\uac00 \ub0ae\uc740 \uc7ac\ub8cc\ub294 \uacfc\ub3c4\ud558\uac8c \uc900\ube44\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ub2e8\uacc43 - '\ud2b9\ubcc4 \uba54\ub274' \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc218\uc775\uc131\uc774 \ub192\uc740 \uba54\ub274\ub97c \ud64d\ubcf4\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc1e0\uace0\uae30 \ud0c0\ucf54\uac00 \uc0dd\uc120 \ud0c0\ucf54\ubcf4\ub2e4 \uc778\uae30\uac00 \ub9ce\ub2e4\uba74 \uc1e0\uace0\uae30 \uc7ac\uace0\ub97c \ucda9\ubd84\ud788 \ud655\ubcf4\ud558\uace0 \uc1e0\uace0\uae30 \ud0c0\ucf54 \ud2b9\ubcc4 \uba54\ub274\ub97c \ud64d\ubcf4\ud558\uc138\uc694. \ub0ad\ube44\ub97c \ucd5c\uc18c\ud654\ud558\uae30 \uc704\ud574 \uc815\uae30\uc801\uc73c\ub85c \uc7ac\uace0\ub97c \uc810\uac80\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ud30c\ud30c\uc2a4 \ud0c0\ucf54 \ubbf8\uc544\uc5d0\uc11c \uc644\ubcbd\ud55c \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\ub294 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud0c0\ucf54 \ubbf8\uc544\uc5d0\uc11c \uc644\ubcbd\ud55c \uc810\uc218\ub97c \uc5bb\uc73c\ub824\uba74 \uc18d\ub3c4, \uc815\ud655\uc131 \ubc0f \uace0\uac1d \ub9cc\uc871\ub3c4\ub97c \ubaa8\ub450 \uac16\ucdb0\uc57c \ud569\ub2c8\ub2e4. \ub2e4\uc74c\uacfc \uac19\uc740 \uc804\ub7b5\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc41 - \ub2e4\uc911 \uc791\uc5c5 \uc5f0\uc2b5\uc744 \ud1b5\ud574 \uc5ec\ub7ec \uc8fc\ubb38\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \ucc98\ub9ac\ud569\ub2c8\ub2e4. \ub2e8\uacc42 - \uace0\uac1d\uc758 \uc120\ud638\ub3c4\ub97c \uc8fc\uc758 \uae4a\uac8c \uc0b4\ud3b4\ubcf4\uace0 \uadf8\uc5d0 \ub530\ub77c \uc8fc\ubb38\uc744 \ub9de\ucda4 \uc124\uc815\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc43 - '\ud2b9\ubcc4 \uba54\ub274'\uc640 '\uc5c5\uadf8\ub808\uc774\ub4dc'\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud301 \ube44\uc728\uc744 \ub192\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uace0\uac1d\uc774 \ucd94\uac00 \uce58\uc988\ub97c \uc6d0\ud558\ub294 \uacbd\uc6b0 \uc989\uc2dc \ucd94\uac00\ud558\uc2ed\uc2dc\uc624. \uac1c\uc120\ud560 \ubd80\ubd84\uc744 \ud30c\uc545\ud558\uae30 \uc704\ud574 \uc815\uae30\uc801\uc73c\ub85c \uc131\uacfc\ub97c \uac80\ud1a0\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ud30c\ud30c\uc2a4 \ud0c0\ucf54 \ubbf8\uc544\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c \ub4a4\uc5d0 \uc228\uaca8\uc9c4 \uc6d0\ub9ac\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud0c0\ucf54 \ubbf8\uc544\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc815\ud655\uc131, \uc18d\ub3c4 \ubc0f \uace0\uac1d \ub9cc\uc871\ub3c4\ub77c\ub294 \uc138 \uac00\uc9c0 \uc8fc\uc694 \uc694\uc18c\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uc815\ud655\uc131\uc740 \uc8fc\ubb38 \uc0ac\uc591\uc744 \uc5bc\ub9c8\ub098 \uc798 \ub530\ub974\ub294\uc9c0\uc5d0 \ub530\ub77c \uacb0\uc815\ub429\ub2c8\ub2e4. \uc18d\ub3c4\ub294 \uc8fc\ubb38\uc744 \uc644\ub8cc\ud558\ub294 \ub370 \uac78\ub9ac\ub294 \uc2dc\uac04\uc73c\ub85c \uce21\uc815\ub429\ub2c8\ub2e4. \uace0\uac1d \ub9cc\uc871\ub3c4\ub294 \uace0\uac1d\uc758 \uc120\ud638\ub3c4\uc640 \ucd94\uac00 \uc694\uccad\uc744 \uc5bc\ub9c8\ub098 \uc798 \ucda9\uc871\ud558\ub294\uc9c0\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uace0\uac1d\uc774 \uc591\ud30c\uac00 \uc5c6\ub294 \ud0c0\ucf54\ub97c \uc8fc\ubb38\ud588\uace0 \uc591\ud30c\ub97c \ud3ec\ud568\uc2dc\ud0a4\uba74 \uc815\ud655\uc131 \uc810\uc218\uac00 \ub0ae\uc544\uc9d1\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc694\uc18c\ub4e4\uc744 \uade0\ud615 \uc788\uac8c \uc870\uc815\ud558\ub294 \uac83\uc774 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\ub294 \uc5f4\uc1e0\uc785\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c\uc2a4 \ud0c0\ucf54 \ubbf8\uc544\uc758 \uc5c5\uadf8\ub808\uc774\ub4dc \uc2dc\uc2a4\ud15c\uc740 \uac8c\uc784\ud50c\ub808\uc774\ub97c \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0a4\ub098\uc694?", "answer": "\ud30c\ud30c\uc2a4 \ud0c0\ucf54 \ubbf8\uc544\uc758 \uc5c5\uadf8\ub808\uc774\ub4dc \uc2dc\uc2a4\ud15c\uc740 \ud0c0\ucf54 \uc81c\uc791 \uacfc\uc815\uc758 \ud6a8\uc728\uc131\uacfc \ud488\uc9c8\uc744 \ub192\uc5ec \uac8c\uc784\ud50c\ub808\uc774\ub97c \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4. \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0\ub294 \uc694\ub9ac \uc2dc\uac04 \ub2e8\ucd95, \ub354 \ub098\uc740 \uc7ac\ub8cc \ubc0f \ud5a5\uc0c1\ub41c \ub3c4\uad6c\uac00 \ud3ec\ud568\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uadf8\ub9b4\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uba74 \uace0\uae30\ub97c \uc694\ub9ac\ud558\ub294 \ub370 \uac78\ub9ac\ub294 \uc2dc\uac04\uc744 \ub2e8\ucd95\ud558\uc5ec \ub354 \ub9ce\uc740 \uc8fc\ubb38\uc744 \ucc98\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc5ec \uadf8 \ud6a8\uc6a9\uc744 \uadf9\ub300\ud654\ud558\uace0 \uc804\ubc18\uc801\uc778 \uc131\ub2a5\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uc2ed\uc2dc\uc624. \uc0ac\uc6a9 \uac00\ub2a5\ud55c \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc815\uae30\uc801\uc73c\ub85c \ud655\uc778\ud558\uace0 \uac00\uc7a5 \ud070 \uc774\uc810\uc744 \uc81c\uacf5\ud558\ub294 \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0 \ud22c\uc790\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ud30c\ud30c\uc2a4 \ud0c0\ucf54 \ubbf8\uc544\uc5d0\uc11c\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\ub978 \uae30\uae30\uc5d0 \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub124, \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud30c\ud30c\uc2a4 \ud0c0\ucf54 \ubbf8\uc544\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub450 \uae30\uae30 \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uace0 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc774 \ud65c\uc131\ud654\ub418\uc5c8\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc548\ub4dc\ub85c\uc774\ub4dc \uae30\uae30\uc5d0\uc11c iOS \uae30\uae30\ub85c \uc804\ud658\ud558\ub294 \uacbd\uc6b0 \uac19\uc740 \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uace0 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud558\uc2ed\uc2dc\uc624. \uc9c4\ud589 \uc0c1\ud669\uc744 \uc783\ub294 \uac83\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uc804\ud658\ud558\uae30 \uc804\uc5d0 \ud56d\uc0c1 \ub370\uc774\ud130\ub97c \ubc31\uc5c5\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ud30c\ud30c\uc2a4 \ud0c0\ucf54 \ubbf8\uc544\uc5d0\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\ub098\uc694?", "answer": "\ud30c\ud30c\uc2a4 \ud0c0\ucf54 \ubbf8\uc544\uc5d0\ub294 \uac8c\uc784 \uacbd\ud5d8\uc5d0 \uae30\uc5ec\ud558\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uae30\ub2a5\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc8fc\ubaa9\ud560 \ub9cc\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ud2b9\uc815 \ucc4c\ub9b0\uc9c0 \uc644\ub8cc\ub85c \ud2b9\ubcc4\ud55c \uc7ac\ub8cc\ub97c \ud574\uc81c\ud558\ub294 \uae30\ub2a5\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc644\ubcbd\ud55c \uc810\uc218\ub85c 100\uac1c\uc758 \uc8fc\ubb38\uc744 \uc644\ub8cc\ud558\uba74 \uace0\uac1d \ub9cc\uc871\ub3c4\ub97c \ub192\uc774\ub294 \uace0\uc720\ud55c \uc18c\uc2a4\ub97c \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784 \ub0b4 \ud78c\ud2b8\ub97c \uc8fc\uc2dc\ud558\uace0 \ub2e4\uc591\ud55c \uc870\ud569\uc744 \uc2e4\ud5d8\ud558\uc5ec \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ubcf4\uc11d\uc744 \ubc1c\uacac\ud558\uc2ed\uc2dc\uc624. \uc815\uae30\uc801\uc73c\ub85c \uac8c\uc784\uc744 \ud0d0\uc0c9\ud558\uc5ec \uc0c8\ub85c\uc6b4 \ub180\ub77c\uc6c0\uc744 \ubc1c\uacac\ud574 \ubcf4\uc138\uc694."}]
[{"question": "\u5982\u4f55\u4f5c\u4e3a\u521d\u5b66\u8005\u5728Papa's Taco Mia\u4e2d\u5f00\u59cb\u5236\u4f5c\u7389\u7c73\u5377\uff1f", "answer": "\u8981\u5728Papa's Taco Mia\u4e2d\u5f00\u59cb\u5236\u4f5c\u7389\u7c73\u5377\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u63a5\u5f85\u987e\u5ba2\u8ba2\u5355\u5e76\u8bb0\u5f55\u4ed6\u4eec\u7684\u504f\u597d\u3002\u6b65\u9aa42 - \u524d\u5f80\u7389\u7c73\u997c\u7ad9\u9009\u62e9\u7389\u7c73\u997c\u79cd\u7c7b\u3002\u6b65\u9aa43 - \u6dfb\u52a0\u6240\u9009\u914d\u6599\uff0c\u4f8b\u5982\u8089\u7c7b\u3001\u852c\u83dc\u548c\u8c03\u5473\u54c1\u3002\u4f8b\u5982\uff0c\u5982\u679c\u987e\u5ba2\u70b9\u4e86\u4e00\u4e2a\u725b\u8089\u7389\u7c73\u5377\uff0c\u4e0a\u9762\u6709\u751f\u83dc\u548c\u8fa3\u9171\uff0c\u90a3\u4e48\u60a8\u9700\u8981\u9009\u62e9\u666e\u901a\u7389\u7c73\u997c\uff0c\u6dfb\u52a0\u725b\u8089\u3001\u751f\u83dc\uff0c\u7136\u540e\u662f\u8fa3\u9171\u3002\u8bf7\u4ee5\u8ba2\u5355\u5355\u636e\u4e3a\u53c2\u8003\uff0c\u786e\u4fdd\u51c6\u786e\u65e0\u8bef\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u5728Papa's Taco Mia\u4e2d\u65f6\u95f4\u5f88\u91cd\u8981\uff0c\u6211\u8be5\u5982\u4f55\u63d0\u9ad8\u65f6\u95f4\u6548\u7387\uff1f", "answer": "\u5728Papa's Taco Mia\u4e2d\uff0c\u65f6\u95f4\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u4f1a\u5f71\u54cd\u60a8\u7684\u5c0f\u8d39\u6bd4\u4f8b\u548c\u987e\u5ba2\u6ee1\u610f\u5ea6\u3002\u8981\u63d0\u9ad8\u65f6\u95f4\u6548\u7387\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u4f18\u5148\u5904\u7406\u9700\u8981\u8f83\u957f\u65f6\u95f4\u70f9\u996a\u7684\u4efb\u52a1\uff0c\u4f8b\u5982\u70e4\u8089\u3002\u6b65\u9aa42 - \u901a\u8fc7\u540c\u65f6\u51c6\u5907\u591a\u4e2a\u7ec4\u4ef6\u6765\u8fdb\u884c\u591a\u4efb\u52a1\u5904\u7406\u3002\u6b65\u9aa43 - \u6ce8\u610f\u65f6\u949f\uff0c\u907f\u514d\u4efb\u4f55\u4e00\u4e2a\u5de5\u4f5c\u7ad9\u8d85\u8d1f\u8377\u8fd0\u8f6c\u3002\u4f8b\u5982\uff0c\u8089\u7c7b\u6b63\u5728\u70e4\u5236\u65f6\uff0c\u60a8\u53ef\u4ee5\u5207\u852c\u83dc\u3002\u4f7f\u7528\u5fc3\u7406\u6e05\u5355\u6709\u6548\u5730\u8ddf\u8e2a\u4efb\u52a1\u3002"}, {"question": "Papa's Taco Mia\u4e2d\u7684\u5173\u952e\u914d\u6599\u662f\u4ec0\u4e48\uff0c\u5b83\u4eec\u5982\u4f55\u5f71\u54cd\u6700\u7ec8\u4ea7\u54c1\uff1f", "answer": "Papa's Taco Mia\u4e2d\u7684\u5173\u952e\u914d\u6599\u5305\u62ec\u7389\u7c73\u997c\u3001\u8089\u7c7b\u3001\u852c\u83dc\u548c\u8c03\u5473\u54c1\u3002\u6bcf\u79cd\u914d\u6599\u90fd\u4f1a\u4ee5\u7279\u5b9a\u65b9\u5f0f\u5f71\u54cd\u6700\u7ec8\u4ea7\u54c1\uff1a\u7389\u7c73\u997c\u51b3\u5b9a\u57fa\u7840\u53e3\u611f\uff0c\u8089\u7c7b\u63d0\u4f9b\u4e3b\u8981\u98ce\u5473\uff0c\u852c\u83dc\u6dfb\u52a0\u65b0\u9c9c\u611f\u548c\u8106\u611f\uff0c\u8c03\u5473\u54c1\u589e\u5f3a\u6574\u4f53\u98ce\u5473\u3002\u4f8b\u5982\uff0c\u7528\u7389\u7c73\u997c\u3001\u70e4\u9e21\u3001\u751f\u83dc\u548c\u8fa3\u9171\u5236\u4f5c\u7684\u7389\u7c73\u5377\u4e0e\u7528\u666e\u901a\u7389\u7c73\u997c\u3001\u725b\u8089\u3001\u897f\u7ea2\u67ff\u548c\u6e29\u548c\u8c03\u5473\u54c1\u5236\u4f5c\u7684\u7389\u7c73\u5377\u4f53\u9a8c\u4e0d\u540c\u3002\u5c1d\u8bd5\u5404\u79cd\u7ec4\u5408\uff0c\u53d1\u73b0\u987e\u5ba2\u7684\u6700\u7231\u3002"}, {"question": "\u5982\u4f55\u5728Papa's Taco Mia\u4e2d\u4f18\u5316\u914d\u6599\u4f7f\u7528\uff0c\u4ee5\u6700\u5927\u5316\u5229\u6da6\uff1f", "answer": "\u8981\u5728Papa's Taco Mia\u4e2d\u4f18\u5316\u914d\u6599\u4f7f\u7528\u5e76\u6700\u5927\u5316\u5229\u6da6\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u8ddf\u8e2a\u53d7\u6b22\u8fce\u7684\u8ba2\u5355\uff0c\u5e76\u76f8\u5e94\u5730\u50a8\u5b58\u914d\u6599\u3002\u6b65\u9aa42 - \u907f\u514d\u8fc7\u5ea6\u51c6\u5907\u4e0d\u592a\u53d7\u6b22\u8fce\u7684\u914d\u6599\u3002\u6b65\u9aa43 - \u5229\u7528\u201c\u7279\u4ef7\u201d\u529f\u80fd\u63a8\u5e7f\u9ad8\u5229\u6da6\u5546\u54c1\u3002\u4f8b\u5982\uff0c\u5982\u679c\u725b\u8089\u7389\u7c73\u5377\u6bd4\u9c7c\u7389\u7c73\u5377\u66f4\u53d7\u6b22\u8fce\uff0c\u8bf7\u786e\u4fdd\u60a8\u6709\u8db3\u591f\u7684\u725b\u8089\u5e93\u5b58\uff0c\u5e76\u63a8\u5e7f\u725b\u8089\u7389\u7c73\u5377\u7279\u4ef7\u3002\u5b9a\u671f\u76d1\u63a7\u5e93\u5b58\uff0c\u5c3d\u91cf\u51cf\u5c11\u6d6a\u8d39\u3002"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u53ef\u4ee5\u5e2e\u52a9\u6211\u5728Papa's Taco Mia\u4e2d\u83b7\u5f97\u5b8c\u7f8e\u6210\u7ee9\uff1f", "answer": "\u5728Papa's Taco Mia\u4e2d\u83b7\u5f97\u5b8c\u7f8e\u6210\u7ee9\u9700\u8981\u901f\u5ea6\u3001\u51c6\u786e\u6027\u548c\u987e\u5ba2\u6ee1\u610f\u5ea6\u7684\u7ed3\u5408\u3002\u4ee5\u4e0b\u662f\u4e00\u4e9b\u7b56\u7565\uff1a\u6b65\u9aa41 - \u7ec3\u4e60\u591a\u4efb\u52a1\u5904\u7406\uff0c\u4ee5\u9ad8\u6548\u5904\u7406\u591a\u4e2a\u8ba2\u5355\u3002\u6b65\u9aa42 - \u5bc6\u5207\u5173\u6ce8\u987e\u5ba2\u504f\u597d\uff0c\u5e76\u76f8\u5e94\u5730\u5b9a\u5236\u8ba2\u5355\u3002\u6b65\u9aa43 - \u5229\u7528\u201c\u7279\u4ef7\u201d\u548c\u201c\u5347\u7ea7\u201d\u6765\u63d0\u9ad8\u5c0f\u8d39\u6bd4\u4f8b\u3002\u4f8b\u5982\uff0c\u5982\u679c\u987e\u5ba2\u60f3\u8981\u989d\u5916\u5976\u916a\uff0c\u8bf7\u786e\u4fdd\u7acb\u5373\u6dfb\u52a0\u3002\u5b9a\u671f\u590d\u6838\u60a8\u7684\u8868\u73b0\uff0c\u627e\u51fa\u9700\u8981\u6539\u8fdb\u7684\u65b9\u9762\u3002"}, {"question": "Papa's Taco Mia\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u80cc\u540e\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "Papa's Taco Mia\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u4e09\u4e2a\u4e3b\u8981\u56e0\u7d20\uff1a\u51c6\u786e\u6027\u3001\u901f\u5ea6\u548c\u987e\u5ba2\u6ee1\u610f\u5ea6\u3002\u51c6\u786e\u6027\u53d6\u51b3\u4e8e\u60a8\u662f\u5426\u9075\u5faa\u8ba2\u5355\u89c4\u683c\u3002\u901f\u5ea6\u4ee5\u5b8c\u6210\u8ba2\u5355\u6240\u9700\u7684\u65f6\u95f4\u6765\u8861\u91cf\u3002\u987e\u5ba2\u6ee1\u610f\u5ea6\u53d7\u60a8\u6ee1\u8db3\u987e\u5ba2\u504f\u597d\u4ee5\u53ca\u4efb\u4f55\u989d\u5916\u8981\u6c42\u7684\u7a0b\u5ea6\u5f71\u54cd\u3002\u4f8b\u5982\uff0c\u5982\u679c\u987e\u5ba2\u70b9\u4e86\u4e00\u4e2a\u6ca1\u6709\u6d0b\u8471\u7684\u7389\u7c73\u5377\uff0c\u800c\u60a8\u6dfb\u52a0\u4e86\u6d0b\u8471\uff0c\u5219\u60a8\u7684\u51c6\u786e\u6027\u5f97\u5206\u5c06\u4f1a\u964d\u4f4e\u3002\u5e73\u8861\u8fd9\u4e9b\u56e0\u7d20\u662f\u83b7\u5f97\u9ad8\u5206\u7684\u5173\u952e\u3002"}, {"question": "Papa's Taco Mia\u4e2d\u7684\u5347\u7ea7\u7cfb\u7edf\u5982\u4f55\u63d0\u5347\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "Papa's Taco Mia\u4e2d\u7684\u5347\u7ea7\u7cfb\u7edf\u901a\u8fc7\u63d0\u9ad8\u7389\u7c73\u5377\u5236\u4f5c\u6d41\u7a0b\u7684\u6548\u7387\u548c\u8d28\u91cf\u6765\u63d0\u5347\u6e38\u620f\u4f53\u9a8c\u3002\u5347\u7ea7\u53ef\u80fd\u5305\u62ec\u66f4\u5feb\u7684\u70f9\u996a\u65f6\u95f4\u3001\u66f4\u597d\u7684\u914d\u6599\u548c\u6539\u8fdb\u7684\u5de5\u5177\u3002\u4f8b\u5982\uff0c\u5347\u7ea7\u60a8\u7684\u70e4\u67b6\u53ef\u4ee5\u7f29\u77ed\u70f9\u996a\u8089\u7c7b\u7684\u65f6\u95f4\uff0c\u8ba9\u60a8\u5904\u7406\u66f4\u591a\u8ba2\u5355\u3002\u6218\u7565\u6027\u5730\u4f7f\u7528\u5347\u7ea7\uff0c\u6700\u5927\u9650\u5ea6\u5730\u53d1\u6325\u5176\u4f18\u52bf\uff0c\u5e76\u63d0\u9ad8\u60a8\u7684\u6574\u4f53\u6027\u80fd\u3002\u5b9a\u671f\u67e5\u770b\u53ef\u7528\u7684\u5347\u7ea7\uff0c\u5e76\u6295\u8d44\u4e8e\u90a3\u4e9b\u63d0\u4f9b\u6700\u5927\u4f18\u52bf\u7684\u5347\u7ea7\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5c06\u6211\u5728Papa's Taco Mia\u4e2d\u7684\u6e38\u620f\u8fdb\u5ea6\u8f6c\u79fb\u5230\u53e6\u4e00\u53f0\u8bbe\u5907\u4e0a\u5417\uff1f", "answer": "\u662f\u7684\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u4f7f\u7528\u4e91\u4fdd\u5b58\u529f\u80fd\u5c06Papa's Taco Mia\u4e2d\u7684\u6e38\u620f\u8fdb\u5ea6\u8f6c\u79fb\u5230\u53e6\u4e00\u53f0\u8bbe\u5907\u4e0a\u3002\u786e\u4fdd\u60a8\u5728\u4e24\u53f0\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u5e10\u6237\uff0c\u5e76\u4e14\u5df2\u542f\u7528\u4e91\u4fdd\u5b58\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u4ece Android \u8bbe\u5907\u5207\u6362\u5230 iOS \u8bbe\u5907\uff0c\u8bf7\u4f7f\u7528\u76f8\u540c\u7684\u5e10\u6237\u767b\u5f55\u5e76\u540c\u6b65\u60a8\u7684\u8fdb\u5ea6\u3002\u5728\u8fdb\u884c\u5207\u6362\u4e4b\u524d\uff0c\u8bf7\u59cb\u7ec8\u5907\u4efd\u60a8\u7684\u6570\u636e\uff0c\u4ee5\u907f\u514d\u4efb\u4f55\u8fdb\u5ea6\u4e22\u5931\u3002"}, {"question": "Papa's Taco Mia\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u7684\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "Papa's Taco Mia\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u7684\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u8fd9\u4e9b\u529f\u80fd\u548c\u5f69\u86cb\u589e\u52a0\u4e86\u6e38\u620f\u4f53\u9a8c\u3002\u4e00\u4e2a\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\u901a\u8fc7\u5b8c\u6210\u67d0\u4e9b\u6311\u6218\u6765\u89e3\u9501\u7279\u6b8a\u914d\u6599\u3002\u4f8b\u5982\uff0c\u5b8c\u6210100\u4e2a\u5b8c\u7f8e\u5f97\u5206\u8ba2\u5355\u53ef\u80fd\u4f1a\u89e3\u9501\u4e00\u79cd\u72ec\u7279\u7684\u9171\u6c41\uff0c\u4ece\u800c\u63d0\u9ad8\u987e\u5ba2\u6ee1\u610f\u5ea6\u3002\u5bc6\u5207\u7559\u610f\u6e38\u620f\u63d0\u793a\u5e76\u5c1d\u8bd5\u4e0d\u540c\u7684\u7ec4\u5408\uff0c\u4ee5\u53d1\u73b0\u8fd9\u4e9b\u9690\u85cf\u7684\u5b9d\u85cf\u3002\u5b9a\u671f\u63a2\u7d22\u6e38\u620f\uff0c\u4ee5\u53d1\u73b0\u60ca\u559c\u3002"}]
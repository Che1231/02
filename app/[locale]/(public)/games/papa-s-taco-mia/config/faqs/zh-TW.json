[{"question": "\u5982\u4f55\u958b\u59cb\u5728 Papa's Taco Mia \u4e2d\u88fd\u4f5c\u58a8\u897f\u54e5\u6372\u9905\uff0c\u4f5c\u70ba\u65b0\u624b\uff1f", "answer": "\u60f3\u8981\u5728 Papa's Taco Mia \u4e2d\u958b\u59cb\u88fd\u4f5c\u58a8\u897f\u54e5\u6372\u9905\uff0c\u8acb\u9075\u5faa\u4e0b\u5217\u6b65\u9a5f\uff1a\u6b65\u9a5f 1 - \u63a5\u5f85\u9867\u5ba2\u9ede\u9910\u4e26\u8a18\u4e0b\u4ed6\u5011\u7684\u559c\u597d\u3002\u6b65\u9a5f 2 - \u524d\u5f80\u7389\u7c73\u9905\u88fd\u4f5c\u5340\u9078\u64c7\u7389\u7c73\u9905\u985e\u578b\u3002\u6b65\u9a5f 3 - \u52a0\u5165\u9078\u5b9a\u7684\u98df\u6750\uff0c\u4f8b\u5982\u8089\u985e\u3001\u852c\u83dc\u548c\u91ac\u6599\u3002\u4f8b\u5982\uff0c\u5982\u679c\u9867\u5ba2\u9ede\u4e86\u725b\u8089\u58a8\u897f\u54e5\u6372\u9905\uff0c\u4e26\u8981\u751f\u83dc\u548c\u8fa3\u91ac\uff0c\u60a8\u5c31\u61c9\u9078\u64c7\u9eb5\u7c89\u7389\u7c73\u9905\uff0c\u52a0\u5165\u725b\u8089\u3001\u751f\u83dc\uff0c\u7136\u5f8c\u52a0\u5165\u8fa3\u91ac\u3002\u8acb\u4ee5\u8a02\u55ae\u660e\u7d30\u70ba\u6e96\uff0c\u78ba\u4fdd\u6e96\u78ba\u6027\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u6642\u9593\u5b89\u6392\u5728 Papa's Taco Mia \u4e2d\u5f88\u91cd\u8981\uff1f\u4ee5\u53ca\u5982\u4f55\u6539\u5584\u6642\u9593\u5b89\u6392\uff1f", "answer": "\u5728 Papa's Taco Mia \u4e2d\uff0c\u6642\u9593\u5b89\u6392\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6703\u5f71\u97ff\u60a8\u7684\u5c0f\u8cbb\u767e\u5206\u6bd4\u548c\u9867\u5ba2\u6eff\u610f\u5ea6\u3002\u8981\u6539\u5584\u6642\u9593\u5b89\u6392\uff0c\u8acb\u9075\u5faa\u4e0b\u5217\u6b65\u9a5f\uff1a\u6b65\u9a5f 1 - \u6839\u64da\u5404\u9805\u4efb\u52d9\u6240\u9700\u6642\u9593\u9577\u77ed\u4f86\u6392\u5e8f\uff0c\u4f8b\u5982\u5148\u8655\u7406\u9700\u8981\u8f03\u9577\u6642\u9593\u70f9\u98ea\u7684\u8089\u985e\u3002\u6b65\u9a5f 2 - \u591a\u5de5\u8655\u7406\uff0c\u540c\u6642\u6e96\u5099\u591a\u500b\u7d44\u6210\u90e8\u5206\u3002\u6b65\u9a5f 3 - \u6ce8\u610f\u6642\u9418\uff0c\u907f\u514d\u4efb\u4f55\u4e00\u500b\u5de5\u4f5c\u7ad9\u904e\u5ea6\u8d85\u8f09\u3002\u4f8b\u5982\uff0c\u8089\u985e\u6b63\u5728\u70e4\u88fd\u6642\uff0c\u60a8\u53ef\u4ee5\u5207\u852c\u83dc\u3002\u4f7f\u7528\u5fc3\u7406\u6e05\u55ae\u6709\u6548\u5730\u8ddf\u8e64\u4efb\u52d9\u3002"}, {"question": "Papa's Taco Mia \u4e2d\u7684\u95dc\u9375\u98df\u6750\u6709\u54ea\u4e9b\uff1f\u4ee5\u53ca\u5b83\u5011\u5982\u4f55\u5f71\u97ff\u6700\u7d42\u7522\u54c1\uff1f", "answer": "Papa's Taco Mia \u4e2d\u7684\u95dc\u9375\u98df\u6750\u5305\u62ec\u7389\u7c73\u9905\u3001\u8089\u985e\u3001\u852c\u83dc\u548c\u91ac\u6599\u3002\u6bcf\u7a2e\u98df\u6750\u90fd\u6703\u4ee5\u7279\u5b9a\u65b9\u5f0f\u5f71\u97ff\u6700\u7d42\u7522\u54c1\uff1a\u7389\u7c73\u9905\u6c7a\u5b9a\u4e86\u57fa\u5e95\u7684\u53e3\u611f\uff0c\u8089\u985e\u63d0\u4f9b\u4e86\u4e3b\u8981\u98a8\u5473\uff0c\u852c\u83dc\u589e\u6dfb\u4e86\u65b0\u9bae\u611f\u548c\u8106\u5ea6\uff0c\u91ac\u6599\u5247\u63d0\u5347\u4e86\u6574\u9ad4\u98a8\u5473\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u7389\u7c73\u714e\u9905\u3001\u70e4\u96de\u3001\u751f\u83dc\u548c\u8fa3\u91ac\uff0c\u8207\u9eb5\u7c89\u7389\u7c73\u9905\u3001\u725b\u8089\u3001\u756a\u8304\u548c\u6e05\u6de1\u91ac\u6599\u7d44\u5408\u7684\u9ad4\u9a57\u4e0d\u540c\u3002\u5617\u8a66\u5404\u7a2e\u7d44\u5408\uff0c\u4ee5\u767c\u73fe\u9867\u5ba2\u6700\u559c\u6b61\u7684\u53e3\u5473\u3002"}, {"question": "\u5982\u4f55\u5728 Papa's Taco Mia \u4e2d\u6700\u4f73\u5316\u98df\u6750\u4f7f\u7528\uff0c\u4ee5\u6700\u5927\u5316\u5229\u6f64\uff1f", "answer": "\u8981\u5728 Papa's Taco Mia \u4e2d\u6700\u4f73\u5316\u98df\u6750\u4f7f\u7528\u4e26\u6700\u5927\u5316\u5229\u6f64\uff0c\u8acb\u9075\u5faa\u4e0b\u5217\u6b65\u9a5f\uff1a\u6b65\u9a5f 1 - \u8ffd\u8e64\u71b1\u9580\u8a02\u55ae\uff0c\u4e26\u6839\u64da\u9700\u6c42\u5099\u59a5\u98df\u6750\u3002\u6b65\u9a5f 2 - \u907f\u514d\u904e\u5ea6\u6e96\u5099\u8f03\u5c11\u9ede\u7684\u98df\u6750\u3002\u6b65\u9a5f 3 - \u4f7f\u7528\u300c\u7279\u50f9\u300d\u529f\u80fd\u4f86\u4fc3\u92b7\u9ad8\u5229\u6f64\u5546\u54c1\u3002\u4f8b\u5982\uff0c\u5982\u679c\u725b\u8089\u7389\u7c73\u9905\u6bd4\u9b5a\u7389\u7c73\u9905\u66f4\u53d7\u6b61\u8fce\uff0c\u8acb\u78ba\u4fdd\u60a8\u6709\u8db3\u5920\u7684\u725b\u8089\u5eab\u5b58\uff0c\u4e26\u4fc3\u92b7\u725b\u8089\u7389\u7c73\u9905\u7279\u50f9\u3002\u5b9a\u671f\u76e3\u63a7\u60a8\u7684\u5eab\u5b58\uff0c\u4ee5\u5c07\u6d6a\u8cbb\u964d\u5230\u6700\u4f4e\u3002"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u80fd\u5920\u5e6b\u52a9\u6211\u5728 Papa's Taco Mia \u4e2d\u53d6\u5f97\u5b8c\u7f8e\u5206\u6578\uff1f", "answer": "\u5728 Papa's Taco Mia \u4e2d\u53d6\u5f97\u5b8c\u7f8e\u5206\u6578\uff0c\u9700\u8981\u901f\u5ea6\u3001\u6e96\u78ba\u6027\u548c\u9867\u5ba2\u6eff\u610f\u5ea6\u7684\u7d50\u5408\u3002\u4ee5\u4e0b\u662f\u4e00\u4e9b\u7b56\u7565\uff1a\u6b65\u9a5f 1 - \u7df4\u7fd2\u591a\u5de5\u8655\u7406\uff0c\u6709\u6548\u61c9\u5c0d\u591a\u500b\u8a02\u55ae\u3002\u6b65\u9a5f 2 - \u6ce8\u610f\u9867\u5ba2\u504f\u597d\u4e26\u6839\u64da\u9700\u8981\u5ba2\u88fd\u5316\u8a02\u55ae\u3002\u6b65\u9a5f 3 - \u5229\u7528\u300c\u7279\u50f9\u300d\u548c\u300c\u5347\u7d1a\u300d\u4f86\u63d0\u9ad8\u5c0f\u8cbb\u767e\u5206\u6bd4\u3002\u4f8b\u5982\uff0c\u5982\u679c\u9867\u5ba2\u504f\u597d\u984d\u5916\u8d77\u53f8\uff0c\u8acb\u52d9\u5fc5\u6beb\u4e0d\u5ef6\u8aa4\u5730\u52a0\u5165\u3002 \u5b9a\u671f\u6aa2\u8a0e\u60a8\u7684\u8868\u73fe\uff0c\u4ee5\u627e\u51fa\u6539\u9032\u7684\u9818\u57df\u3002"}, {"question": "Papa's Taco Mia \u4e2d\u7684\u8a55\u5206\u7cfb\u7d71\u80cc\u5f8c\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "Papa's Taco Mia \u4e2d\u7684\u8a55\u5206\u7cfb\u7d71\u57fa\u65bc\u4e09\u500b\u4e3b\u8981\u56e0\u7d20\uff1a\u6e96\u78ba\u6027\u3001\u901f\u5ea6\u548c\u9867\u5ba2\u6eff\u610f\u5ea6\u3002\u6e96\u78ba\u6027\u53d6\u6c7a\u65bc\u60a8\u662f\u5426\u6e96\u78ba\u5730\u9075\u5faa\u8a02\u55ae\u8aaa\u660e\u3002\u901f\u5ea6\u5247\u4ee5\u5b8c\u6210\u8a02\u55ae\u6240\u9700\u7684\u6642\u9593\u4f86\u8861\u91cf\u3002\u9867\u5ba2\u6eff\u610f\u5ea6\u53d7\u60a8\u6eff\u8db3\u9867\u5ba2\u504f\u597d\u548c\u984d\u5916\u8981\u6c42\u7684\u7a0b\u5ea6\u5f71\u97ff\u3002\u4f8b\u5982\uff0c\u5982\u679c\u9867\u5ba2\u9ede\u4e86\u4e00\u500b\u6c92\u6709\u6d0b\u8525\u7684\u7389\u7c73\u9905\uff0c\u800c\u60a8\u537b\u52a0\u5165\u4e86\u6d0b\u8525\uff0c\u60a8\u7684\u6e96\u78ba\u6027\u5206\u6578\u5c31\u6703\u964d\u4f4e\u3002\u5e73\u8861\u9019\u4e9b\u56e0\u7d20\u662f\u53d6\u5f97\u9ad8\u5206\u7684\u95dc\u9375\u3002"}, {"question": "Papa's Taco Mia \u4e2d\u7684\u5347\u7d1a\u7cfb\u7d71\u5982\u4f55\u63d0\u5347\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "Papa's Taco Mia \u4e2d\u7684\u5347\u7d1a\u7cfb\u7d71\u900f\u904e\u63d0\u5347\u60a8\u88fd\u4f5c\u58a8\u897f\u54e5\u6372\u9905\u7684\u6548\u7387\u548c\u54c1\u8cea\u4f86\u63d0\u5347\u904a\u6232\u9ad4\u9a57\u3002\u5347\u7d1a\u53ef\u4ee5\u5305\u62ec\u66f4\u5feb\u7684\u70f9\u98ea\u6642\u9593\u3001\u66f4\u597d\u7684\u98df\u6750\u548c\u6539\u9032\u7684\u5de5\u5177\u3002\u4f8b\u5982\uff0c\u5347\u7d1a\u60a8\u7684\u70e4\u67b6\u53ef\u4ee5\u7e2e\u77ed\u70f9\u98ea\u8089\u985e\u6240\u9700\u7684\u6642\u9593\uff0c\u8b93\u60a8\u80fd\u5920\u8655\u7406\u66f4\u591a\u8a02\u55ae\u3002\u7b56\u7565\u6027\u5730\u4f7f\u7528\u5347\u7d1a\uff0c\u4ee5\u6700\u5927\u5316\u5176\u6548\u76ca\u4e26\u6539\u5584\u60a8\u7684\u6574\u9ad4\u8868\u73fe\u3002\u5b9a\u671f\u67e5\u770b\u53ef\u7528\u7684\u5347\u7d1a\uff0c\u4e26\u6295\u8cc7\u90a3\u4e9b\u63d0\u4f9b\u6700\u5927\u512a\u52e2\u7684\u5347\u7d1a\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5c07 Papa's Taco Mia \u4e2d\u7684\u9032\u5ea6\u8f49\u79fb\u5230\u53e6\u4e00\u53f0\u88dd\u7f6e\u55ce\uff1f", "answer": "\u662f\u7684\uff0c\u60a8\u53ef\u4ee5\u900f\u904e\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u5c07 Papa's Taco Mia \u4e2d\u7684\u9032\u5ea6\u8f49\u79fb\u5230\u53e6\u4e00\u53f0\u88dd\u7f6e\u3002\u8acb\u78ba\u4fdd\u60a8\u5728\u5169\u53f0\u88dd\u7f6e\u4e0a\u90fd\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\uff0c\u4e26\u4e14\u5df2\u555f\u7528\u96f2\u7aef\u5132\u5b58\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9e Android \u88dd\u7f6e\u5207\u63db\u5230 iOS \u88dd\u7f6e\uff0c\u8acb\u4f7f\u7528\u76f8\u540c\u7684\u5e33\u6236\u767b\u5165\u4e26\u540c\u6b65\u60a8\u7684\u9032\u5ea6\u3002\u5728\u9032\u884c\u5207\u63db\u4e4b\u524d\uff0c\u8acb\u52d9\u5fc5\u5099\u4efd\u60a8\u7684\u8cc7\u6599\uff0c\u4ee5\u907f\u514d\u4efb\u4f55\u9032\u5ea6\u640d\u5931\u3002"}, {"question": "Papa's Taco Mia \u4e2d\u6709\u4ec0\u9ebc\u96b1\u85cf\u7684\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "Papa's Taco Mia \u5305\u542b\u4e00\u4e9b\u96b1\u85cf\u7684\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u53ef\u4ee5\u8c50\u5bcc\u904a\u6232\u9ad4\u9a57\u3002\u4e00\u500b\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\uff0c\u900f\u904e\u5b8c\u6210\u7279\u5b9a\u6311\u6230\u4f86\u89e3\u9396\u7279\u6b8a\u98df\u6750\u3002\u4f8b\u5982\uff0c\u5b8c\u6210 100 \u500b\u5b8c\u7f8e\u5206\u6578\u7684\u8a02\u55ae\uff0c\u53ef\u80fd\u6703\u89e3\u9396\u80fd\u63d0\u5347\u9867\u5ba2\u6eff\u610f\u5ea6\u7684\u7368\u7279\u91ac\u6599\u3002\u5bc6\u5207\u7559\u610f\u904a\u6232\u63d0\u793a\uff0c\u4e26\u5617\u8a66\u4e0d\u540c\u7684\u7d44\u5408\uff0c\u4ee5\u767c\u73fe\u9019\u4e9b\u96b1\u85cf\u7684\u5bf6\u85cf\u3002 \u5b9a\u671f\u63a2\u7d22\u904a\u6232\uff0c\u5c0b\u627e\u65b0\u7684\u9a5a\u559c\u3002"}]
[{"question": "\u30ab\u30e9\u30fc\u30ea\u30f3\u30b0\u30d6\u30ed\u30c3\u30af\u30d1\u30ba\u30eb\u3067\u57fa\u672c\u7684\u306a\u52d5\u304d\u3092\u884c\u3046\u306b\u306f\uff1f", "answer": "\u30ab\u30e9\u30fc\u30ea\u30f3\u30b0\u30d6\u30ed\u30c3\u30af\u30d1\u30ba\u30eb\u3067\u306f\u3001\u57fa\u672c\u7684\u306a\u52d5\u304d\u306f\u3001\u30ea\u30f3\u30b0\u3092\u30bf\u30c3\u30d7\u3057\u3066\u9078\u629e\u3057\u3001\u7a7a\u3044\u3066\u3044\u308b\u30b9\u30ed\u30c3\u30c8\u306b\u30c9\u30e9\u30c3\u30b0\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u4e0a\u6bb5\u306b\u8d64\u3044\u30ea\u30f3\u30b0\u304c\u3042\u308b\u5834\u5408\u3001\u305d\u308c\u3092\u30bf\u30c3\u30d7\u3057\u3066\u3001\u4e0b\u6bb5\u306e\u7a7a\u3044\u3066\u3044\u308b\u30b9\u30ed\u30c3\u30c8\u306b\u30c9\u30e9\u30c3\u30b0\u3057\u307e\u3059\u3002\u3053\u306e\u52d5\u304d\u306f\u3001\u30de\u30c3\u30c1\u3092\u4f5c\u6210\u3057\u3001\u30dc\u30fc\u30c9\u3092\u30af\u30ea\u30a2\u3059\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002[\u4f8b\uff1a\u5c06\u68cb\u99d2\u3092\u65b0\u3057\u3044\u4f4d\u7f6e\u306b\u79fb\u52d5\u3057\u3066\u6226\u7565\u7684\u512a\u4f4d\u6027\u3092\u78ba\u7acb\u3059\u308b\u306e\u3068\u540c\u3058\u3067\u3059\u3002]"}, {"question": "\u30ab\u30e9\u30fc\u30ea\u30f3\u30b0\u30d6\u30ed\u30c3\u30af\u30d1\u30ba\u30eb\u3067\u3001\u5148\u306b\u52d5\u304d\u3092\u8a08\u753b\u3059\u308b\u3053\u3068\u306f\u306a\u305c\u91cd\u8981\u306a\u306e\u3067\u3059\u304b\uff1f", "answer": "\u30ab\u30e9\u30fc\u30ea\u30f3\u30b0\u30d6\u30ed\u30c3\u30af\u30d1\u30ba\u30eb\u3067\u5148\u306b\u52d5\u304d\u3092\u8a08\u753b\u3059\u308b\u3053\u3068\u306f\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u3053\u308c\u306f\u3001\u9023\u9396\u53cd\u5fdc\u3092\u4f5c\u308a\u3001\u30b9\u30b3\u30a2\u3092\u6700\u5927\u9650\u306b\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u30013\u3064\u5148\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u304c\u8003\u3048\u3089\u308c\u308b\u5834\u5408\u3001\u73fe\u5728\u306e\u52d5\u304d\u3092\u305d\u308c\u306b\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3001\u305d\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u3092\u5b9f\u73fe\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u6226\u7565\u306f\u3001\u30dc\u30fc\u30c9\u3092\u3088\u308a\u52b9\u7387\u7684\u306b\u30af\u30ea\u30a2\u3057\u3001\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002[\u9078\u629e\u80a2\uff1a\u30e9\u30f3\u30c0\u30e0\u306a\u52d5\u304d\u3067\u3082\u30dc\u30fc\u30c9\u3092\u30af\u30ea\u30a2\u3059\u308b\u3053\u3068\u306f\u3067\u304d\u307e\u3059\u304c\u3001\u8a08\u753b\u7684\u306a\u52d5\u304d\u306e\u65b9\u304c\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u3068\u3088\u308a\u52b9\u7387\u7684\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002]"}, {"question": "\u30ab\u30e9\u30fc\u30ea\u30f3\u30b0\u30d6\u30ed\u30c3\u30af\u30d1\u30ba\u30eb\u306b\u306f\u3001\u3069\u306e\u3088\u3046\u306a\u7a2e\u985e\u306e\u30ea\u30f3\u30b0\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30ab\u30e9\u30fc\u30ea\u30f3\u30b0\u30d6\u30ed\u30c3\u30af\u30d1\u30ba\u30eb\u306b\u306f\u3001\u57fa\u672c\u7684\u306a\u8272\u306e\u30ea\u30f3\u30b0\u3001\u6574\u5217\u3057\u305f\u884c\u307e\u305f\u306f\u5217\u5168\u4f53\u3092\u30af\u30ea\u30a2\u3059\u308b\u7279\u6b8a\u306a\u30ea\u30f3\u30b0\u3001\u8ffd\u52a0\u306e\u30dd\u30a4\u30f3\u30c8\u3092\u63d0\u4f9b\u3059\u308b\u30dc\u30fc\u30ca\u30b9\u30ea\u30f3\u30b0\u306a\u3069\u3001\u3044\u304f\u3064\u304b\u306e\u7a2e\u985e\u306e\u30ea\u30f3\u30b0\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u9752\u3044\u30ea\u30f3\u30b0\u306f\u57fa\u672c\u7684\u306a\u30ea\u30f3\u30b0\u3067\u3059\u304c\u3001\u91d1\u8272\u306e\u30ea\u30f3\u30b0\u306f\u3001\u30de\u30c3\u30c1\u30f3\u30b0\u3059\u308b\u3068\u3001\u6574\u5217\u3057\u305f\u884c\u5168\u4f53\u3092\u30af\u30ea\u30a2\u3059\u308b\u7279\u6b8a\u306a\u30ea\u30f3\u30b0\u3067\u3059\u3002\u3053\u308c\u3089\u306e\u7a2e\u985e\u3092\u77e5\u308b\u3053\u3068\u3067\u3001\u6226\u7565\u7684\u306a\u52d5\u304d\u3092\u7acb\u3066\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u7a2e\u985e\u4e00\u89a7\uff1a\u57fa\u672c\u30ea\u30f3\u30b0-\u8272\u4ed8\u304d\u30ea\u30f3\u30b0\uff1b\u7279\u6b8a\u30ea\u30f3\u30b0-\u884c/\u5217\u30af\u30ea\u30a2\u30ea\u30f3\u30b0\uff1b\u30dc\u30fc\u30ca\u30b9\u30ea\u30f3\u30b0-\u8ffd\u52a0\u30dd\u30a4\u30f3\u30c8\u30ea\u30f3\u30b0]"}, {"question": "100\u6642\u9593\u30d7\u30ec\u30a4\u5f8c\u3001\u30ab\u30e9\u30fc\u30ea\u30f3\u30b0\u30d6\u30ed\u30c3\u30af\u30d1\u30ba\u30eb\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u305f\u3081\u306b\u5f79\u7acb\u3064\u6226\u7565\u306f\uff1f", "answer": "100\u6642\u9593\u30d7\u30ec\u30a4\u5f8c\u3001\u30ab\u30e9\u30fc\u30ea\u30f3\u30b0\u30d6\u30ed\u30c3\u30af\u30d1\u30ba\u30eb\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u9023\u9396\u7684\u306a\u30de\u30c3\u30c1\u30f3\u30b0\u3092\u4f5c\u6210\u3057\u3001\u7279\u6b8a\u306a\u30ea\u30f3\u30b0\u3092\u52b9\u679c\u7684\u306b\u4f7f\u3046\u3088\u3046\u306a\u4e0a\u7d1a\u6226\u7565\u304c\u5fc5\u8981\u3068\u306a\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u7279\u6b8a\u306a\u30ea\u30f3\u30b0\u304c\u3042\u308b\u5834\u5408\u3001\u8907\u6570\u306e\u884c\u3084\u5217\u3092\u4e00\u5ea6\u306b\u30af\u30ea\u30a2\u3067\u304d\u308b\u72b6\u6cc1\u306b\u5099\u3048\u3066\u4fdd\u5b58\u3057\u3066\u304a\u304d\u307e\u3057\u3087\u3046\u3002\u3053\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u3001\u5404\u52d5\u304d\u306e\u30a4\u30f3\u30d1\u30af\u30c8\u3092\u6700\u5927\u5316\u3057\u3001\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002[\u30b9\u30c6\u30c3\u30d7\u5225\u624b\u9806\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u7279\u6b8a\u306a\u30ea\u30f3\u30b0\u3092\u7279\u5b9a\u3059\u308b\uff1b\u30b9\u30c6\u30c3\u30d72\uff1a\u6700\u5927\u9650\u306e\u52b9\u679c\u306e\u305f\u3081\u306e\u4f7f\u7528\u3092\u8a08\u753b\u3059\u308b\uff1b\u30b9\u30c6\u30c3\u30d73\uff1a\u9023\u9396\u7684\u306a\u30de\u30c3\u30c1\u30f3\u30b0\u3092\u4f5c\u6210\u3059\u308b\u52d5\u304d\u3092\u5b9f\u884c\u3059\u308b\u3002]"}, {"question": "\u30ab\u30e9\u30fc\u30ea\u30f3\u30b0\u30d6\u30ed\u30c3\u30af\u30d1\u30ba\u30eb\u3067\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30ab\u30e9\u30fc\u30ea\u30f3\u30b0\u30d6\u30ed\u30c3\u30af\u30d1\u30ba\u30eb\u3067\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u5358\u4e00\u306e\u52d5\u304d\u3067\u30af\u30ea\u30a2\u3057\u305f\u30ea\u30f3\u30b0\u306e\u6570\u3068\u3001\u95a2\u308f\u3063\u305f\u30ea\u30f3\u30b0\u306e\u7a2e\u985e\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u30013\u3064\u306e\u57fa\u672c\u7684\u306a\u30ea\u30f3\u30b0\u3092\u30af\u30ea\u30a2\u3059\u308b\u3068100\u30dd\u30a4\u30f3\u30c8\u5f97\u3089\u308c\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u4e00\u65b9\u3001\u7279\u6b8a\u306a\u30ea\u30f3\u30b0\u3092\u4f7f\u3063\u3066\u6574\u5217\u3057\u305f\u884c\u5168\u4f53\u3092\u30af\u30ea\u30a2\u3059\u308b\u3068500\u30dd\u30a4\u30f3\u30c8\u5f97\u3089\u308c\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u5f97\u308b\u305f\u3081\u306e\u6226\u7565\u3092\u7acb\u3066\u3089\u308c\u307e\u3059\u3002[\u4f8b\uff1a\u683c\u95d8\u30b2\u30fc\u30e0\u306e\u30b3\u30de\u30f3\u30c9\u306e\u3088\u3046\u306b\u3001\u52d5\u304d\u306e\u8907\u96d1\u3055\u306b\u3088\u308a\u30b9\u30b3\u30a2\u304c\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002]"}, {"question": "\u30ab\u30e9\u30fc\u30ea\u30f3\u30b0\u30d6\u30ed\u30c3\u30af\u30d1\u30ba\u30eb\u306b\u304a\u3051\u308b\u30ea\u30f3\u30b0\u30de\u30c3\u30c1\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306e\u4e3b\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ab\u30e9\u30fc\u30ea\u30f3\u30b0\u30d6\u30ed\u30c3\u30af\u30d1\u30ba\u30eb\u306b\u304a\u3051\u308b\u30ea\u30f3\u30b0\u30de\u30c3\u30c1\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306e\u4e3b\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u540c\u3058\u8272\u306e\u30ea\u30f3\u30b0\u30923\u3064\u4ee5\u4e0a\u3001\u884c\u307e\u305f\u306f\u5217\u306b\u4e26\u3079\u308b\u3053\u3068\u3067\u3059\u3002\u4f8b\u3048\u3070\u30013\u3064\u306e\u8d64\u3044\u30ea\u30f3\u30b0\u304c\u540c\u3058\u884c\u306b\u63c3\u3063\u3066\u3044\u308b\u5834\u5408\u3001\u305d\u308c\u3089\u306f\u30af\u30ea\u30a2\u3055\u308c\u3001\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u7279\u6b8a\u306a\u30ea\u30f3\u30b0\u3092\u30de\u30c3\u30c1\u30f3\u30b0\u3055\u305b\u308b\u3053\u3068\u3067\u3001\u6574\u5217\u3057\u305f\u884c\u3084\u5217\u5168\u4f53\u3092\u30af\u30ea\u30a2\u3057\u3066\u3001\u3055\u3089\u306b\u6226\u7565\u7684\u306a\u8981\u7d20\u304c\u8ffd\u52a0\u3055\u308c\u307e\u3059\u3002[\u4f8b\uff1a\u57fa\u672c\u7684\u306a\u30de\u30c3\u30c1\u306f\u3044\u304f\u3064\u304b\u306e\u30ea\u30f3\u30b0\u3092\u30af\u30ea\u30a2\u3057\u307e\u3059\u304c\u3001\u7279\u6b8a\u306a\u30de\u30c3\u30c1\u306f\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u306e\u305f\u3081\u306b\u6574\u5217\u3057\u305f\u884c\u3084\u5217\u5168\u4f53\u3092\u30af\u30ea\u30a2\u3057\u307e\u3059\u3002]"}, {"question": "\u8907\u6570\u306e\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u30ab\u30e9\u30fc\u30ea\u30f3\u30b0\u30d6\u30ed\u30c3\u30af\u30d1\u30ba\u30eb\u30c7\u30fc\u30bf\u3092\u79fb\u884c\u3059\u308b\u306b\u306f\uff1f", "answer": "\u8907\u6570\u306e\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u30ab\u30e9\u30fc\u30ea\u30f3\u30b0\u30d6\u30ed\u30c3\u30af\u30d1\u30ba\u30eb\u30c7\u30fc\u30bf\u3092\u79fb\u884c\u3059\u308b\u306b\u306f\u3001\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001Android\u30b9\u30de\u30fc\u30c8\u30d5\u30a9\u30f3\u3067Google Play\u30b2\u30fc\u30e0\u3092\u4f7f\u7528\u3057\u3066\u3044\u308b\u5834\u5408\u3001\u30bf\u30d6\u30ec\u30c3\u30c8\u3067\u3082\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3057\u3087\u3046\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u30c7\u30fc\u30bf\u304c\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u540c\u671f\u3055\u308c\u3001\u30b2\u30fc\u30e0\u3092\u30b7\u30fc\u30e0\u30ec\u30b9\u306b\u7d9a\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u5bfe\u5fdc\u8868\uff1a\u30c7\u30d0\u30a4\u30b91 - Android\u30b9\u30de\u30fc\u30c8\u30d5\u30a9\u30f3\uff1b\u30c7\u30d0\u30a4\u30b92 - Android\u30bf\u30d6\u30ec\u30c3\u30c8\uff1b\u540c\u671f\u65b9\u6cd5 - Google Play\u30b2\u30fc\u30e0]"}, {"question": "\u30ab\u30e9\u30fc\u30ea\u30f3\u30b0\u30d6\u30ed\u30c3\u30af\u30d1\u30ba\u30eb\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30ab\u30e9\u30fc\u30ea\u30f3\u30b0\u30d6\u30ed\u30c3\u30af\u30d1\u30ba\u30eb\u306b\u306f\u3001\u30dc\u30fc\u30ca\u30b9\u30ec\u30d9\u30eb\u3084\u79d8\u5bc6\u306e\u9054\u6210\u611f\u7372\u5f97\u3068\u3044\u3063\u305f\u96a0\u308c\u305f\u6a5f\u80fd\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002 \u4f8b\u3048\u3070\u3001\u7279\u5b9a\u306e\u6642\u9593\u5185\u306b\u30ec\u30d9\u30eb\u3092\u5b8c\u4e86\u3059\u308b\u3068\u3001\u30e6\u30cb\u30fc\u30af\u306a\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u6301\u3064\u30dc\u30fc\u30ca\u30b9\u30ec\u30d9\u30eb\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u6a5f\u80fd\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u306b\u3055\u3089\u306b\u8208\u596e\u3068\u518d\u904a\u73a9\u6027\u304c\u5897\u3057\u307e\u3059\u3002[\u4f8b\uff1aRPG\u3067\u96a0\u3055\u308c\u305f\u5b9d\u7bb1\u3092\u898b\u3064\u3051\u305f\u6642\u3068\u540c\u3058\u3067\u3001\u5b09\u3057\u3044\u30b5\u30d7\u30e9\u30a4\u30ba\u3067\u3059\u3002]"}, {"question": "\u30ab\u30e9\u30fc\u30ea\u30f3\u30b0\u30d6\u30ed\u30c3\u30af\u30d1\u30ba\u30eb\u306e\u96e3\u6613\u5ea6\u66f2\u7dda\u306f\u3069\u306e\u3088\u3046\u306b\u9032\u307f\u307e\u3059\u304b\uff1f", "answer": "\u30ab\u30e9\u30fc\u30ea\u30f3\u30b0\u30d6\u30ed\u30c3\u30af\u30d1\u30ba\u30eb\u306e\u96e3\u6613\u5ea6\u66f2\u7dda\u306f\u3001\u30ec\u30d9\u30eb\u3092\u9032\u3081\u308b\u306b\u3064\u308c\u3066\u3001\u3088\u308a\u8907\u96d1\u306a\u30ea\u30f3\u30b0\u914d\u7f6e\u3068\u5236\u9650\u3055\u308c\u305f\u624b\u6570\u3067\u9032\u307f\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u521d\u671f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u7c21\u5358\u306a3\u3064\u306e\u30ea\u30f3\u30b0\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u304c\u3042\u308a\u307e\u3059\u304c\u3001\u5f8c\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u5236\u9650\u3055\u308c\u305f\u624b\u6570\u5185\u3067\u30dc\u30fc\u30c9\u3092\u30af\u30ea\u30a2\u3059\u308b\u305f\u3081\u306b\u6226\u7565\u7684\u306a\u8a08\u753b\u304c\u5fc5\u8981\u306b\u306a\u308a\u307e\u3059\u3002\u3053\u306e\u6bb5\u968e\u7684\u306a\u96e3\u6613\u5ea6\u5411\u4e0a\u306f\u3001\u30b2\u30fc\u30e0\u3092\u6311\u6226\u7684\u3067\u9b45\u529b\u7684\u306a\u3082\u306e\u306b\u3057\u307e\u3059\u3002[\u30ec\u30d9\u30eb\u56f3\uff1a\u30ec\u30d9\u30eb1-10 - \u57fa\u672c\u30de\u30c3\u30c1\u30f3\u30b0\uff1b\u30ec\u30d9\u30eb11-20 - \u5236\u9650\u3055\u308c\u305f\u624b\u6570\uff1b\u30ec\u30d9\u30eb21+ - \u8907\u96d1\u306a\u914d\u7f6e]"}, {"question": "\u30ab\u30e9\u30fc\u30ea\u30f3\u30b0\u30d6\u30ed\u30c3\u30af\u30d1\u30ba\u30eb\u306e\u521d\u5fc3\u8005\u306b\u3068\u3063\u3066\u3001\u3069\u306e\u3088\u3046\u306a\u30d9\u30b9\u30c8\u30d7\u30e9\u30af\u30c6\u30a3\u30b9\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30ab\u30e9\u30fc\u30ea\u30f3\u30b0\u30d6\u30ed\u30c3\u30af\u30d1\u30ba\u30eb\u306e\u521d\u5fc3\u8005\u306b\u3068\u3063\u3066\u3001\u30d9\u30b9\u30c8\u30d7\u30e9\u30af\u30c6\u30a3\u30b9\u306f\u3001\u57fa\u672c\u7684\u306a\u30de\u30c3\u30c1\u30f3\u30b0\u306b\u96c6\u4e2d\u3057\u3001\u3055\u307e\u3056\u307e\u306a\u7a2e\u985e\u306e\u30ea\u30f3\u30b0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u307e\u305a3\u3064\u306e\u57fa\u672c\u7684\u306a\u30ea\u30f3\u30b0\u3092\u4e00\u81f4\u3055\u305b\u3066\u30dc\u30fc\u30c9\u3092\u30af\u30ea\u30a2\u3057\u3001\u5f90\u3005\u306b\u7279\u6b8a\u306a\u30ea\u30f3\u30b0\u3092\u3088\u308a\u5927\u304d\u306a\u52b9\u679c\u306e\u305f\u3081\u306b\u4f7f\u3046\u3053\u3068\u3092\u5b66\u3073\u307e\u3057\u3087\u3046\u3002\u3053\u306e\u57fa\u790e\u77e5\u8b58\u306f\u30b2\u30fc\u30e0\u3092\u9032\u3081\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002[\u4f8b\uff1a\u521d\u5fc3\u8005\u306e\u65b9\u3005\u306f\u57fa\u672c\u7684\u306a\u30de\u30c3\u30c1\u306b\u96c6\u4e2d\u3059\u308b\u3079\u304d\u3067\u3059\u304c\u3001\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3088\u308a\u9ad8\u3044\u5f97\u70b9\u3092\u5f97\u308b\u305f\u3081\u306b\u7279\u6b8a\u306a\u30ea\u30f3\u30b0\u3092\u6d3b\u7528\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002]"}]
[{"question": "\u5982\u4f55\u8fdb\u884c\u300a\u5f69\u8272\u73af\u5757\u72b6\u62fc\u56fe\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u5728\u300a\u5f69\u8272\u73af\u5757\u72b6\u62fc\u56fe\u300b\u4e2d\uff0c\u57fa\u672c\u64cd\u4f5c\u5305\u62ec\u70b9\u51fb\u4e00\u4e2a\u73af\u5c06\u5176\u9009\u4e2d\uff0c\u7136\u540e\u5c06\u5176\u62d6\u52a8\u5230\u7a7a\u4f4d\u3002\u4f8b\u5982\uff0c\u5982\u679c\u9876\u90e8\u6709\u4e00\u679a\u7ea2\u8272\u73af\uff0c\u70b9\u51fb\u5b83\u5e76\u5c06\u5176\u62d6\u52a8\u5230\u5e95\u90e8\u7a7a\u4f4d\u3002\u6b64\u64cd\u4f5c\u5bf9\u4e8e\u521b\u5efa\u5339\u914d\u5e76\u6e05\u9664\u6e38\u620f\u677f\u81f3\u5173\u91cd\u8981\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u53ef\u4ee5\u5c06\u5b83\u60f3\u8c61\u6210\u5728\u68cb\u76d8\u4e0a\u79fb\u52a8\u68cb\u5b50\uff0c\u4ee5\u5efa\u7acb\u6218\u7565\u4f18\u52bf\u3002]"}, {"question": "\u5728\u300a\u5f69\u8272\u73af\u5757\u72b6\u62fc\u56fe\u300b\u4e2d\u63d0\u524d\u89c4\u5212\u79fb\u52a8\u6b65\u9aa4\u4e3a\u4ec0\u4e48\u91cd\u8981\uff1f", "answer": "\u5728\u300a\u5f69\u8272\u73af\u5757\u72b6\u62fc\u56fe\u300b\u4e2d\u63d0\u524d\u89c4\u5212\u79fb\u52a8\u6b65\u9aa4\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u5141\u8bb8\u4f60\u521b\u5efa\u8fde\u9501\u53cd\u5e94\u5e76\u6700\u5927\u5316\u4f60\u7684\u5f97\u5206\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u770b\u5230\u4e09\u6b65\u4e4b\u540e\u5b58\u5728\u6f5c\u5728\u7684\u5339\u914d\uff0c\u4f60\u53ef\u4ee5\u8bbe\u7f6e\u5f53\u524d\u7684\u79fb\u52a8\u6b65\u9aa4\u6765\u5b9e\u73b0\u3002\u8fd9\u79cd\u7b56\u7565\u6709\u52a9\u4e8e\u66f4\u6709\u6548\u5730\u6e05\u9664\u6e38\u620f\u677f\u5e76\u83b7\u5f97\u66f4\u9ad8\u5206\u6570\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u867d\u7136\u968f\u673a\u79fb\u52a8\u4e5f\u80fd\u6e05\u9664\u6e38\u620f\u677f\uff0c\u4f46\u89c4\u5212\u597d\u7684\u79fb\u52a8\u53ef\u4ee5\u83b7\u5f97\u66f4\u9ad8\u7684\u5206\u6570\u548c\u66f4\u6709\u6548\u7684\u6e38\u620f\u4f53\u9a8c\u3002]"}, {"question": "\u300a\u5f69\u8272\u73af\u5757\u72b6\u62fc\u56fe\u300b\u4e2d\u6709\u54ea\u4e9b\u4e0d\u540c\u7c7b\u578b\u7684\u73af\uff1f", "answer": "\u300a\u5f69\u8272\u73af\u5757\u72b6\u62fc\u56fe\u300b\u5305\u542b\u591a\u79cd\u7c7b\u578b\u7684\u73af\uff0c\u5305\u62ec\u57fa\u672c\u7684\u5f69\u8272\u73af\u3001\u6e05\u9664\u6574\u884c\u6216\u6574\u5217\u7684\u7279\u6b8a\u73af\u4ee5\u53ca\u63d0\u4f9b\u989d\u5916\u5206\u6570\u7684\u5956\u52b1\u73af\u3002\u4f8b\u5982\uff0c\u84dd\u8272\u73af\u53ef\u80fd\u662f\u57fa\u672c\u73af\uff0c\u800c\u91d1\u8272\u73af\u5219\u53ef\u80fd\u662f\u4e00\u79cd\u6e05\u9664\u6574\u884c\u7684\u7279\u6b8a\u73af\u3002\u4e86\u89e3\u8fd9\u4e9b\u7c7b\u578b\u6709\u52a9\u4e8e\u5236\u5b9a\u4f60\u7684\u7b56\u7565\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u57fa\u672c\u73af - \u5f69\u8272\u73af\uff1b\u7279\u6b8a\u73af - \u6e05\u9664\u6574\u884c/\u5217\uff1b\u5956\u52b1\u73af - \u989d\u5916\u5206\u6570]"}, {"question": "\u5728\u73a9\u300a\u5f69\u8272\u73af\u5757\u72b6\u62fc\u56fe\u300b100\u5c0f\u65f6\u540e\uff0c\u54ea\u4e9b\u7b56\u7565\u53ef\u4ee5\u5e2e\u52a9\u638c\u63e1\u6e38\u620f\uff1f", "answer": "\u5728\u73a9\u300a\u5f69\u8272\u73af\u5757\u72b6\u62fc\u56fe\u300b100\u5c0f\u65f6\u540e\uff0c\u638c\u63e1\u6e38\u620f\u7684\u8bc0\u7a8d\u5305\u62ec\u521b\u5efa\u7ea7\u8054\u5339\u914d\u548c\u6709\u6548\u4f7f\u7528\u7279\u6b8a\u73af\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u6709\u4e00\u4e2a\u7279\u6b8a\u73af\uff0c\u5c06\u5176\u4fdd\u5b58\u5230\u80fd\u591f\u6e05\u9664\u591a\u884c\u6216\u591a\u5217\u7684\u65f6\u5019\u4f7f\u7528\u3002\u8fd9\u79cd\u65b9\u6cd5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u6bcf\u6b21\u79fb\u52a8\u7684\u5f71\u54cd\uff0c\u5e76\u5e2e\u52a9\u4f60\u83b7\u5f97\u66f4\u9ad8\u7684\u5206\u6570\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u6b65\u9aa4 1\uff1a\u8bc6\u522b\u7279\u6b8a\u73af\uff1b\u6b65\u9aa4 2\uff1a\u89c4\u5212\u5176\u4f7f\u7528\u4ee5\u6700\u5927\u5316\u5f71\u54cd\uff1b\u6b65\u9aa4 3\uff1a\u6267\u884c\u79fb\u52a8\u4ee5\u521b\u5efa\u7ea7\u8054\u5339\u914d\u3002]"}, {"question": "\u300a\u5f69\u8272\u73af\u5757\u72b6\u62fc\u56fe\u300b\u7684\u8ba1\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u300a\u5f69\u8272\u73af\u5757\u72b6\u62fc\u56fe\u300b\u7684\u8ba1\u5206\u7cfb\u7edf\u57fa\u4e8e\u4f60\u4e00\u6b21\u79fb\u52a8\u4e2d\u6e05\u9664\u7684\u73af\u7684\u6570\u91cf\u548c\u73af\u7684\u7c7b\u578b\u3002\u4f8b\u5982\uff0c\u6e05\u9664\u4e09\u4e2a\u57fa\u672c\u73af\u53ef\u80fd\u4f1a\u83b7\u5f97 100 \u5206\uff0c\u800c\u4f7f\u7528\u7279\u6b8a\u73af\u6e05\u9664\u6574\u884c\u5219\u53ef\u80fd\u4f1a\u83b7\u5f97 500 \u5206\u3002\u4e86\u89e3\u8be5\u7cfb\u7edf\u6709\u52a9\u4e8e\u5236\u5b9a\u7b56\u7565\u4ee5\u83b7\u5f97\u66f4\u9ad8\u7684\u5206\u6570\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u53ef\u4ee5\u5c06\u5176\u60f3\u8c61\u6210\u683c\u6597\u6e38\u620f\u4e2d\u8fde\u51fb\u2014\u2014\u8fde\u51fb\u8d8a\u590d\u6742\uff0c\u5206\u6570\u8d8a\u9ad8\u3002]"}, {"question": "\u300a\u5f69\u8272\u73af\u5757\u72b6\u62fc\u56fe\u300b\u4e2d\u73af\u5339\u914d\u7cfb\u7edf\u7684\u5173\u952e\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u5f69\u8272\u73af\u5757\u72b6\u62fc\u56fe\u300b\u73af\u5339\u914d\u7cfb\u7edf\u80cc\u540e\u7684\u5173\u952e\u673a\u5236\u5305\u62ec\u5728\u884c\u6216\u5217\u4e2d\u5bf9\u9f50\u4e09\u4e2a\u6216\u66f4\u591a\u76f8\u540c\u989c\u8272\u7684\u73af\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u6709\u4e00\u6392\u4e09\u4e2a\u7ea2\u8272\u73af\uff0c\u5b83\u4eec\u5c06\u4f1a\u6d88\u5931\u5e76\u83b7\u5f97\u5206\u6570\u3002\u7279\u6b8a\u73af\u4e5f\u53ef\u4ee5\u8fdb\u884c\u5339\u914d\u4ee5\u6e05\u9664\u6574\u884c\u6216\u6574\u5217\uff0c\u589e\u52a0\u7b56\u7565\u7684\u5c42\u7ea7\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u57fa\u672c\u5339\u914d\u6e05\u9664\u51e0\u4e2a\u73af\uff0c\u800c\u7279\u6b8a\u5339\u914d\u6e05\u9664\u6574\u884c\u6216\u6574\u5217\u5e76\u83b7\u5f97\u66f4\u9ad8\u5206\u6570\u3002]"}, {"question": "\u5982\u4f55\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u8fc1\u79fb\u300a\u5f69\u8272\u73af\u5757\u72b6\u62fc\u56fe\u300b\u6570\u636e\uff1f", "answer": "\u8981\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u8fc1\u79fb\u300a\u5f69\u8272\u73af\u5757\u72b6\u62fc\u56fe\u300b\u6570\u636e\uff0c\u8bf7\u786e\u4fdd\u4f60\u5728\u4e24\u4e2a\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u5e10\u6237\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728 Android \u624b\u673a\u4e0a\u4f7f\u7528 Google Play \u6e38\u620f\uff0c\u8bf7\u5728\u5e73\u677f\u7535\u8111\u4e0a\u767b\u5f55\u540c\u4e00\u4e2a\u5e10\u6237\u3002\u8fd9\u5c06\u540c\u6b65\u4f60\u8de8\u8bbe\u5907\u7684\u8fdb\u5ea6\uff0c\u8ba9\u4f60\u80fd\u591f\u65e0\u7f1d\u5730\u7ee7\u7eed\u6e38\u620f\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u8bbe\u5907 1 - Android \u624b\u673a\uff1b\u8bbe\u5907 2 - Android \u5e73\u677f\u7535\u8111\uff1b\u540c\u6b65\u65b9\u6cd5 - Google Play \u6e38\u620f]"}, {"question": "\u300a\u5f69\u8272\u73af\u5757\u72b6\u62fc\u56fe\u300b\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u7684\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "\u300a\u5f69\u8272\u73af\u5757\u72b6\u62fc\u56fe\u300b\u5305\u542b\u9690\u85cf\u7684\u529f\u80fd\uff0c\u4f8b\u5982\u5956\u52b1\u5173\u5361\u548c\u79d8\u5bc6\u6210\u5c31\u3002\u4f8b\u5982\uff0c\u5728\u4e00\u5b9a\u65f6\u95f4\u5185\u5b8c\u6210\u4e00\u4e2a\u5173\u5361\u53ef\u80fd\u4f1a\u89e3\u9501\u5177\u6709\u72ec\u7279\u6311\u6218\u7684\u5956\u52b1\u5173\u5361\u3002\u53d1\u73b0\u8fd9\u4e9b\u529f\u80fd\u4e3a\u6e38\u620f\u589e\u6dfb\u4e86\u989d\u5916\u7684\u8da3\u5473\u6027\u548c\u53ef\u73a9\u6027\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u53ef\u4ee5\u5c06\u5176\u60f3\u8c61\u6210\u5728 RPG \u6e38\u620f\u4e2d\u627e\u5230\u9690\u85cf\u7684\u5b9d\u7bb1\u2014\u2014\u8fd9\u662f\u4e00\u79cd\u4ee4\u4eba\u6109\u5feb\u7684\u60ca\u559c\u3002]"}, {"question": "\u300a\u5f69\u8272\u73af\u5757\u72b6\u62fc\u56fe\u300b\u7684\u96be\u5ea6\u66f2\u7ebf\u662f\u5982\u4f55\u9012\u8fdb\u7684\uff1f", "answer": "\u300a\u5f69\u8272\u73af\u5757\u72b6\u62fc\u56fe\u300b\u7684\u96be\u5ea6\u66f2\u7ebf\u662f\u901a\u8fc7\u5f15\u5165\u66f4\u590d\u6742\u7684\u73af\u6392\u5217\u548c\u6709\u9650\u7684\u79fb\u52a8\u6b21\u6570\u6765\u9012\u8fdb\u7684\uff0c\u968f\u7740\u4f60\u5b8c\u6210\u5173\u5361\u800c\u589e\u52a0\u3002\u4f8b\u5982\uff0c\u65e9\u671f\u5173\u5361\u53ef\u80fd\u9700\u8981\u7b80\u5355\u7684 3 \u4e2a\u73af\u5339\u914d\uff0c\u800c\u540e\u671f\u5173\u5361\u5219\u9700\u8981\u6218\u7565\u89c4\u5212\u624d\u80fd\u5728\u6709\u9650\u7684\u79fb\u52a8\u6b21\u6570\u5185\u6e05\u9664\u6e38\u620f\u677f\u3002\u8fd9\u79cd\u5faa\u5e8f\u6e10\u8fdb\u7684\u96be\u5ea6\u63d0\u5347\u4f7f\u6e38\u620f\u4fdd\u6301\u4e86\u6311\u6218\u6027\u548c\u5438\u5f15\u529b\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a1-10 \u5173 - \u57fa\u672c\u5339\u914d\uff1b11-20 \u5173 - \u79fb\u52a8\u6b21\u6570\u6709\u9650\uff1b21 \u5173\u53ca\u4ee5\u4e0a - \u590d\u6742\u6392\u5217]"}, {"question": "\u300a\u5f69\u8272\u73af\u5757\u72b6\u62fc\u56fe\u300b\u65b0\u624b\u73a9\u5bb6\u7684\u6700\u4f73\u5b9e\u8df5\u662f\u4ec0\u4e48\uff1f", "answer": "\u5bf9\u4e8e\u300a\u5f69\u8272\u73af\u5757\u72b6\u62fc\u56fe\u300b\u7684\u65b0\u624b\u73a9\u5bb6\u6765\u8bf4\uff0c\u6700\u4f73\u5b9e\u8df5\u5305\u62ec\u4e13\u6ce8\u4e8e\u521b\u5efa\u57fa\u672c\u5339\u914d\u5e76\u4e86\u89e3\u4e0d\u540c\u7c7b\u578b\u7684\u73af\u3002\u4f8b\u5982\uff0c\u9996\u5148\u5339\u914d\u4e09\u4e2a\u57fa\u672c\u73af\u6765\u6e05\u9664\u6e38\u620f\u677f\uff0c\u7136\u540e\u9010\u6b65\u5b66\u4e60\u4f7f\u7528\u7279\u6b8a\u73af\u4ee5\u83b7\u5f97\u66f4\u5927\u5f71\u54cd\u3002\u8fd9\u79cd\u57fa\u7840\u77e5\u8bc6\u5bf9\u4e8e\u6e38\u620f\u4e2d\u7684\u8fdb\u6b65\u81f3\u5173\u91cd\u8981\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u65b0\u624b\u73a9\u5bb6\u5e94\u4e13\u6ce8\u4e8e\u57fa\u672c\u5339\u914d\uff0c\u800c\u9ad8\u7ea7\u73a9\u5bb6\u5219\u53ef\u4ee5\u5c1d\u8bd5\u4f7f\u7528\u7279\u6b8a\u73af\u4ee5\u83b7\u5f97\u66f4\u9ad8\u7684\u5206\u6570\u3002]"}]
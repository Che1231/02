[{"question": "\u5982\u4f55\u57f7\u884c\u5f69\u8272\u74b0\u584a\u62fc\u5716\u7684\u57fa\u672c\u79fb\u52d5\uff1f", "answer": "\u5728\u5f69\u8272\u74b0\u584a\u62fc\u5716\u4e2d\uff0c\u57fa\u672c\u79fb\u52d5\u5305\u62ec\u9ede\u64ca\u4e00\u500b\u74b0\u4f86\u9078\u53d6\u5b83\uff0c\u7136\u5f8c\u5c07\u5176\u62d6\u66f3\u5230\u4e00\u500b\u7a7a\u4f4d\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u9802\u884c\u6709\u4e00\u500b\u7d05\u8272\u74b0\uff0c\u8acb\u9ede\u64ca\u5b83\u4e26\u5c07\u5176\u62d6\u66f3\u5230\u5e95\u884c\u7684\u4e00\u500b\u7a7a\u4f4d\u3002\u6b64\u79fb\u52d5\u5c0d\u65bc\u5275\u9020\u5339\u914d\u4e26\u6e05\u9664\u904a\u6232\u677f\u81f3\u95dc\u91cd\u8981\u3002 [\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4e00\u4e0b\uff0c\u5c31\u50cf\u5728\u68cb\u76e4\u904a\u6232\u4e2d\u79fb\u52d5\u68cb\u5b50\u5230\u65b0\u7684\u4f4d\u7f6e\u4f86\u5efa\u7acb\u6230\u7565\u512a\u52e2\u4e00\u6a23\u3002]"}, {"question": "\u5728\u5f69\u8272\u74b0\u584a\u62fc\u5716\u904a\u6232\u4e2d\uff0c\u63d0\u524d\u898f\u5283\u79fb\u52d5\u70ba\u4f55\u91cd\u8981\uff1f", "answer": "\u5728\u5f69\u8272\u74b0\u584a\u62fc\u5716\u904a\u6232\u4e2d\uff0c\u63d0\u524d\u898f\u5283\u79fb\u52d5\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u5141\u8a31\u60a8\u5275\u9020\u9023\u9396\u53cd\u61c9\u4e26\u6700\u5927\u5316\u60a8\u7684\u5f97\u5206\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u63d0\u524d\u4e09\u6b65\u770b\u5230\u4e00\u500b\u6f5b\u5728\u7684\u5339\u914d\uff0c\u60a8\u53ef\u4ee5\u8a2d\u5b9a\u7576\u524d\u79fb\u52d5\u4f86\u9054\u6210\u76ee\u6a19\u3002\u6b64\u7b56\u7565\u6709\u52a9\u65bc\u66f4\u6709\u6548\u5730\u6e05\u9664\u904a\u6232\u677f\u4e26\u7372\u5f97\u66f4\u9ad8\u7684\u5206\u6578\u3002 [\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u96d6\u7136\u96a8\u6a5f\u79fb\u52d5\u53ef\u4ee5\u6e05\u9664\u904a\u6232\u677f\uff0c\u4f46\u8a08\u5283\u597d\u7684\u79fb\u52d5\u6703\u5c0e\u81f4\u66f4\u9ad8\u7684\u5206\u6578\u548c\u66f4\u6709\u6548\u7684\u904a\u6232\u9ad4\u9a57\u3002]"}, {"question": "\u5f69\u8272\u74b0\u584a\u62fc\u5716\u4e2d\u6709\u54ea\u4e9b\u4e0d\u540c\u985e\u578b\u7684\u74b0\uff1f", "answer": "\u5f69\u8272\u74b0\u584a\u62fc\u5716\u5177\u6709\u591a\u7a2e\u74b0\u985e\u578b\uff0c\u5305\u62ec\u57fa\u672c\u7684\u5f69\u8272\u74b0\u3001\u6e05\u9664\u6574\u884c\u6216\u6574\u5217\u7684\u7279\u6b8a\u74b0\u4ee5\u53ca\u63d0\u4f9b\u984d\u5916\u5206\u6578\u7684\u734e\u52f5\u74b0\u3002\u4f8b\u5982\uff0c\u85cd\u8272\u74b0\u53ef\u80fd\u662f\u4e00\u500b\u57fa\u672c\u74b0\uff0c\u800c\u91d1\u8272\u74b0\u53ef\u80fd\u662f\u4e00\u500b\u6e05\u9664\u6574\u884c\u7684\u7279\u6b8a\u74b0\uff0c\u7576\u914d\u5c0d\u6642\u3002\u77ad\u89e3\u9019\u4e9b\u985e\u578b\u6709\u52a9\u65bc\u5236\u5b9a\u60a8\u7684\u904a\u6232\u7b56\u7565\u3002 [\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u57fa\u672c\u74b0 - \u5f69\u8272\uff1b\u7279\u6b8a\u74b0 - \u6e05\u9664\u884c/\u5217\uff1b\u734e\u52f5\u74b0 - \u984d\u5916\u5206\u6578]"}, {"question": "\u5728\u73a9\u4e86 100 \u5c0f\u6642\u5f8c\uff0c\u54ea\u4e9b\u7b56\u7565\u6709\u52a9\u65bc\u7cbe\u901a\u5f69\u8272\u74b0\u584a\u62fc\u5716\uff1f", "answer": "\u5728\u73a9\u4e86 100 \u5c0f\u6642\u5f8c\uff0c\u8981\u7cbe\u901a\u5f69\u8272\u74b0\u584a\u62fc\u5716\uff0c\u9700\u8981\u66f4\u9ad8\u7d1a\u7684\u7b56\u7565\uff0c\u4f8b\u5982\u5275\u9020\u9023\u9396\u5339\u914d\u548c\u6709\u6548\u5730\u4f7f\u7528\u7279\u6b8a\u74b0\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u6709\u4e00\u500b\u7279\u6b8a\u74b0\uff0c\u8acb\u5728\u5b83\u80fd\u6e05\u9664\u591a\u884c\u6216\u591a\u5217\u7684\u6642\u5019\u4fdd\u7559\u5b83\u3002\u9019\u7a2e\u65b9\u6cd5\u6700\u5927\u5316\u4e86\u6bcf\u6b21\u79fb\u52d5\u7684\u5f71\u97ff\uff0c\u4e26\u6709\u52a9\u65bc\u7372\u5f97\u66f4\u9ad8\u7684\u5206\u6578\u3002 [\u6d41\u7a0b\u5716\u89e3\uff1a\u6b65\u9a5f 1\uff1a\u8b58\u5225\u7279\u6b8a\u74b0\uff1b\u6b65\u9a5f 2\uff1a\u898f\u5283\u5176\u4f7f\u7528\u4ee5\u6700\u5927\u5316\u5f71\u97ff\uff1b\u6b65\u9a5f 3\uff1a\u57f7\u884c\u79fb\u52d5\u4ee5\u5275\u9020\u9023\u9396\u5339\u914d\u3002]"}, {"question": "\u5f69\u8272\u74b0\u584a\u62fc\u5716\u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u5f69\u8272\u74b0\u584a\u62fc\u5716\u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u60a8\u55ae\u6b21\u79fb\u52d5\u4e2d\u6e05\u9664\u7684\u74b0\u6578\u91cf\u4ee5\u53ca\u6240\u6d89\u53ca\u7684\u74b0\u985e\u578b\u3002\u4f8b\u5982\uff0c\u6e05\u9664\u4e09\u500b\u57fa\u672c\u74b0\u53ef\u80fd\u6703\u7372\u5f97 100 \u5206\uff0c\u800c\u4f7f\u7528\u7279\u6b8a\u74b0\u6e05\u9664\u6574\u884c\u5247\u53ef\u80fd\u7372\u5f97 500 \u5206\u3002\u77ad\u89e3\u6b64\u7cfb\u7d71\u6709\u52a9\u65bc\u5236\u5b9a\u66f4\u9ad8\u7684\u5f97\u5206\u7b56\u7565\u3002 [\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4e00\u4e0b\uff0c\u5c31\u50cf\u683c\u9b25\u904a\u6232\u4e2d\u7684\u9023\u64ca\u2014\u2014\u52d5\u4f5c\u8d8a\u8907\u96dc\uff0c\u5206\u6578\u8d8a\u9ad8\u3002]"}, {"question": "\u5f69\u8272\u74b0\u584a\u62fc\u5716\u74b0\u5339\u914d\u7cfb\u7d71\u80cc\u5f8c\u7684\u95dc\u9375\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5f69\u8272\u74b0\u584a\u62fc\u5716\u74b0\u5339\u914d\u7cfb\u7d71\u80cc\u5f8c\u7684\u95dc\u9375\u6a5f\u5236\u5305\u62ec\u5728\u884c\u6216\u5217\u4e2d\u5c0d\u9f4a\u4e09\u500b\u6216\u66f4\u591a\u76f8\u540c\u984f\u8272\u7684\u74b0\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u540c\u4e00\u500b\u984f\u8272\u4e2d\u6709\u4e00\u6392\u4e09\u500b\u7d05\u8272\u7684\u74b0\uff0c\u4ed6\u5011\u6703\u6d88\u5931\u4e26\u7372\u5f97\u5206\u6578\u3002\u7279\u6b8a\u74b0\u4e5f\u53ef\u4ee5\u914d\u5c0d\u8d77\u4f86\u6e05\u9664\u6574\u884c\u6216\u6574\u5217\uff0c\u589e\u52a0\u53e6\u4e00\u500b\u7b56\u7565\u5c64\u3002 [\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u57fa\u672c\u5339\u914d\u6e05\u9664\u5e7e\u500b\u74b0\uff0c\u800c\u7279\u6b8a\u5339\u914d\u6e05\u9664\u6574\u884c\u6216\u6574\u5217\u4ee5\u7372\u5f97\u66f4\u9ad8\u7684\u5206\u6578\u3002]"}, {"question": "\u5982\u4f55\u5728\u4e0d\u540c\u7684\u8a2d\u5099\u4e4b\u9593\u9077\u79fb\u6211\u7684\u5f69\u8272\u74b0\u584a\u62fc\u5716\u6578\u64da\uff1f", "answer": "\u8981\u5c07\u60a8\u7684\u5f69\u8272\u74b0\u584a\u62fc\u5716\u6578\u64da\u9077\u79fb\u5230\u4e0d\u540c\u8a2d\u5099\u4e4b\u9593\uff0c\u8acb\u78ba\u4fdd\u60a8\u5728\u5169\u53f0\u8a2d\u5099\u4e0a\u90fd\u767b\u9304\u76f8\u540c\u7684\u5e33\u6236\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728 Android \u624b\u6a5f\u4e0a\u4f7f\u7528 Google Play \u904a\u6232\uff0c\u8acb\u5728\u5e73\u677f\u96fb\u8166\u4e0a\u767b\u9304\u76f8\u540c\u7684\u5e33\u6236\u3002\u9019\u5c07\u540c\u6b65\u60a8\u5728\u4e0d\u540c\u8a2d\u5099\u4e0a\u7684\u9032\u5ea6\uff0c\u8b93\u60a8\u7121\u7e2b\u5730\u7e7c\u7e8c\u904a\u6232\u3002 [\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u8a2d\u5099 1 - Android \u624b\u6a5f\uff1b\u8a2d\u5099 2 - Android \u5e73\u677f\u96fb\u8166\uff1b\u540c\u6b65\u65b9\u6cd5 - Google Play \u904a\u6232]"}, {"question": "\u5f69\u8272\u74b0\u584a\u62fc\u5716\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u7684\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "\u5f69\u8272\u74b0\u584a\u62fc\u5716\u5305\u62ec\u4e00\u4e9b\u96b1\u85cf\u7684\u529f\u80fd\uff0c\u4f8b\u5982\u734e\u52f5\u95dc\u5361\u548c\u79d8\u5bc6\u6210\u5c31\u3002\u4f8b\u5982\uff0c\u5728\u7279\u5b9a\u6642\u9593\u5167\u5b8c\u6210\u4e00\u500b\u95dc\u5361\u53ef\u80fd\u6703\u89e3\u9396\u5177\u6709\u7368\u7279\u6311\u6230\u7684\u734e\u52f5\u95dc\u5361\u3002\u767c\u73fe\u9019\u4e9b\u529f\u80fd\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u984d\u5916\u7684\u9a5a\u559c\u548c\u91cd\u8907\u53ef\u73a9\u6027\u3002 [\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4e00\u4e0b\uff0c\u5c31\u50cf\u5728\u89d2\u8272\u626e\u6f14\u904a\u6232\u4e2d\u627e\u5230\u4e00\u500b\u96b1\u85cf\u7684\u5bf6\u7bb1\u4e00\u6a23\u2014\u2014\u9019\u662f\u4e00\u500b\u4ee4\u4eba\u6b23\u559c\u7684\u9a5a\u559c\u3002]"}, {"question": "\u5f69\u8272\u74b0\u584a\u62fc\u5716\u7684\u96e3\u5ea6\u66f2\u7dda\u662f\u5982\u4f55\u9010\u6f38\u63d0\u5347\u7684\uff1f", "answer": "\u5f69\u8272\u74b0\u584a\u62fc\u5716\u7684\u96e3\u5ea6\u66f2\u7dda\u662f\u901a\u904e\u5f15\u5165\u66f4\u8907\u96dc\u7684\u74b0\u6392\u5217\u548c\u6709\u9650\u7684\u79fb\u52d5\u6b21\u6578\u4f86\u63d0\u5347\u7684\uff0c\u96a8\u8457\u60a8\u5728\u95dc\u5361\u4e2d\u7684\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u65e9\u671f\u95dc\u5361\u53ef\u80fd\u5177\u6709\u7c21\u55ae\u7684 3 \u500b\u74b0\u5339\u914d\uff0c\u800c\u5f8c\u671f\u7684\u95dc\u5361\u5247\u9700\u8981\u5236\u5b9a\u7b56\u7565\u4e26\u5728\u6709\u9650\u7684\u79fb\u52d5\u6b21\u6578\u5167\u6e05\u9664\u904a\u6232\u677f\u3002\u9019\u7a2e\u9010\u6f38\u589e\u52a0\u7684\u96e3\u5ea6\u8b93\u904a\u6232\u4fdd\u6301\u6311\u6230\u6027\u548c\u5438\u5f15\u529b\u3002 [\u6d41\u7a0b\u5716\u89e3\uff1a\u7b2c 1-10 \u95dc - \u57fa\u672c\u5339\u914d\uff1b\u7b2c 11-20 \u95dc - \u79fb\u52d5\u6b21\u6578\u53d7\u9650\uff1b\u7b2c 21 \u95dc\u53ca\u4e4b\u5f8c - \u8907\u96dc\u7684\u6392\u5217]"}, {"question": "\u5f69\u8272\u74b0\u584a\u62fc\u5716\u65b0\u624b\u61c9\u8a72\u6ce8\u610f\u54ea\u4e9b\u6700\u4f73\u5be6\u8e10\uff1f", "answer": "\u5c0d\u65bc\u5f69\u8272\u74b0\u584a\u62fc\u5716\u7684\u65b0\u624b\u4f86\u8aaa\uff0c\u6700\u4f73\u5be6\u8e10\u5305\u62ec\u5c08\u6ce8\u65bc\u5275\u9020\u57fa\u672c\u5339\u914d\u548c\u7406\u89e3\u4e0d\u540c\u7684\u74b0\u985e\u578b\u3002\u4f8b\u5982\uff0c\u5f9e\u5339\u914d\u4e09\u500b\u57fa\u672c\u74b0\u958b\u59cb\u4ee5\u6e05\u9664\u904a\u6232\u677f\uff0c\u4e26\u9010\u6b65\u5b78\u7fd2\u5982\u4f55\u4f7f\u7528\u7279\u6b8a\u74b0\u4ee5\u7522\u751f\u66f4\u5927\u7684\u5f71\u97ff\u3002\u9019\u9805\u57fa\u790e\u77e5\u8b58\u5c0d\u65bc\u5728\u904a\u6232\u4e2d\u53d6\u5f97\u9032\u5c55\u81f3\u95dc\u91cd\u8981\u3002 [\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u65b0\u624b\u61c9\u8a72\u5c08\u6ce8\u65bc\u57fa\u672c\u5339\u914d\uff0c\u800c\u9ad8\u7d1a\u73a9\u5bb6\u5247\u53ef\u4ee5\u5617\u8a66\u4f7f\u7528\u7279\u6b8a\u74b0\u4ee5\u7372\u5f97\u66f4\u9ad8\u7684\u5206\u6578\u3002]"}]
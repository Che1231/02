[{"question": "\uceec\ub7ec \ub9c1 \ube14\ub85d \ud37c\uc990\uc5d0\uc11c \uae30\ubcf8 \uc774\ub3d9\uc740 \uc5b4\ub5bb\uac8c \ud558\ub098\uc694?", "answer": "\uceec\ub7ec \ub9c1 \ube14\ub85d \ud37c\uc990\uc5d0\uc11c \uae30\ubcf8 \uc774\ub3d9\uc740 \ub9c1\uc744 \ud0ed\ud558\uc5ec \uc120\ud0dd\ud55c \ub2e4\uc74c \ube48 \uc2ac\ub86f\uc73c\ub85c \ub04c\uc5b4\ub2e4 \ub193\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub9e8 \uc704 \uc904\uc5d0 \ube68\uac04\uc0c9 \ub9c1\uc774 \uc788\ub2e4\uba74 \ub9c1\uc744 \ud0ed\ud558\uace0 \uc544\ub798\ucabd \ube48 \uc2ac\ub86f\uc73c\ub85c \ub04c\uc5b4\ub2e4 \ub193\uc73c\uba74 \ub429\ub2c8\ub2e4. \uc774 \uc774\ub3d9\uc740 \ub9e4\uce58\ub97c \uc0dd\uc131\ud558\uace0 \ubcf4\ub4dc\ub97c \ud074\ub9ac\uc5b4\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uccb4\uc2a4 \ub9d0\uc744 \uc804\ub7b5\uc801 \uc6b0\uc704\ub97c \ud655\ubcf4\ud558\uae30 \uc704\ud574 \uc0c8\ub85c\uc6b4 \uc704\uce58\ub85c \uc62e\uae30\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\uceec\ub7ec \ub9c1 \ube14\ub85d \ud37c\uc990\uc5d0\uc11c \ubbf8\ub9ac \uc774\ub3d9\uc744 \uacc4\ud68d\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uceec\ub7ec \ub9c1 \ube14\ub85d \ud37c\uc990\uc5d0\uc11c \ubbf8\ub9ac \uc774\ub3d9\uc744 \uacc4\ud68d\ud558\ub294 \uac83\uc740 \uc5f0\uc1c4 \ubc18\uc751\uc744 \ub9cc\ub4e4\uace0 \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud560 \uc218 \uc788\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc138 \uac1c\uc758 \ub9c1\uc744 \ub9de\ucd9c \uc218 \uc788\ub294 \uac00\ub2a5\uc131\uc744 3\uce78 \uc55e\uc11c \uc608\uce21\ud560 \uc218 \uc788\ub2e4\uba74, \ud604\uc7ac \uc774\ub3d9\uc744 \uadf8\uc5d0 \ub9de\ucdb0 \uc124\uc815\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc804\ub7b5\uc740 \ubcf4\ub4dc\ub97c \ub354 \ud6a8\uc728\uc801\uc73c\ub85c \ud074\ub9ac\uc5b4\ud558\uace0 \ub354 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uacc4\ud68d \ube44\uad50: \ubb34\uc791\uc704 \uc774\ub3d9\uc73c\ub85c\ub3c4 \ubcf4\ub4dc\ub97c \ud074\ub9ac\uc5b4\ud560 \uc218 \uc788\uc9c0\ub9cc, \uacc4\ud68d\ub41c \uc774\ub3d9\uc740 \ub354 \ub192\uc740 \uc810\uc218\uc640 \ub354 \ud6a8\uc728\uc801\uc778 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc774\ub04c\uc5b4\ub0c5\ub2c8\ub2e4.]"}, {"question": "\uceec\ub7ec \ub9c1 \ube14\ub85d \ud37c\uc990\uc5d0\ub294 \uc5b4\ub5a4 \uc885\ub958\uc758 \ub9c1\uc774 \uc788\ub098\uc694?", "answer": "\uceec\ub7ec \ub9c1 \ube14\ub85d \ud37c\uc990\uc5d0\ub294 \uae30\ubcf8\uc801\uc778 \uc0c9\uc0c1 \ub9c1, \uc804\uccb4 \ud589 \ub610\ub294 \uc5f4\uc744 \ud074\ub9ac\uc5b4\ud558\ub294 \ud2b9\uc218 \ub9c1, \ucd94\uac00 \uc810\uc218\ub97c \uc81c\uacf5\ud558\ub294 \ubcf4\ub108\uc2a4 \ub9c1 \ub4f1 \uc5ec\ub7ec \uc720\ud615\uc758 \ub9c1\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud30c\ub780\uc0c9 \ub9c1\uc740 \uae30\ubcf8 \ub9c1\uc77c \uc218 \uc788\uc73c\uba70, \uae08\uc0c9 \ub9c1\uc740 \ub9e4\uce58 \uc2dc \uc804\uccb4 \ud589\uc744 \ud074\ub9ac\uc5b4\ud558\ub294 \ud2b9\uc218 \ub9c1\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc720\ud615\uc744 \uc774\ud574\ud558\uba74 \uc804\ub7b5\uc744 \uc138\uc6b0\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. [\uad6c\uc131\ud45c: \uae30\ubcf8 \ub9c1 - \uc0c9\uc0c1; \ud2b9\uc218 \ub9c1 - \ud589/\uc5f4 \ud074\ub9ac\uc5b4; \ubcf4\ub108\uc2a4 \ub9c1 - \ucd94\uac00 \uc810\uc218]"}, {"question": "100\uc2dc\uac04 \uc774\uc0c1 \uceec\ub7ec \ub9c1 \ube14\ub85d \ud37c\uc990\uc744 \ud50c\ub808\uc774\ud55c \ud6c4 \uc219\ub2ec\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ub294 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "100\uc2dc\uac04 \uc774\uc0c1 \ud50c\ub808\uc774\ud55c \ud6c4 \uceec\ub7ec \ub9c1 \ube14\ub85d \ud37c\uc990\uc744 \uc219\ub2ec\ud558\ub294 \uac83\uc740 \uc5f0\uc1c4 \ub9e4\uce58\ub97c \uc0dd\uc131\ud558\uace0 \ud2b9\uc218 \ub9c1\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \uace0\uae09 \uc804\ub7b5\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud2b9\uc218 \ub9c1\uc774 \uc788\ub2e4\uba74 \uc5ec\ub7ec \ud589\uc774\ub098 \uc5f4\uc744 \ud074\ub9ac\uc5b4\ud560 \uc218 \uc788\ub294 \uc2dc\uc810\uc744 \uc704\ud574 \ubcf4\uad00\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc811\uadfc \ubc29\uc2dd\uc740 \uac01 \uc774\ub3d9\uc758 \uc601\ud5a5\uc744 \uadf9\ub300\ud654\ud558\uace0 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \ub2e8\uacc4 1: \ud2b9\uc218 \ub9c1 \uc2dd\ubcc4; \ub2e8\uacc4 2: \ucd5c\ub300 \uc601\ud5a5\uc744 \uc704\ud574 \uc0ac\uc6a9 \uacc4\ud68d; \ub2e8\uacc4 3: \uc5f0\uc1c4 \ub9e4\uce58\ub97c \ub9cc\ub4e4\uae30 \uc704\ud55c \uc774\ub3d9 \uc2e4\ud589.]"}, {"question": "\uceec\ub7ec \ub9c1 \ube14\ub85d \ud37c\uc990\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "\uceec\ub7ec \ub9c1 \ube14\ub85d \ud37c\uc990\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ud55c \ubc88\uc758 \uc774\ub3d9\uc5d0\uc11c \ud074\ub9ac\uc5b4\ud55c \ub9c1\uc758 \uc218\uc640 \uad00\ub828\ub41c \ub9c1\uc758 \uc720\ud615\uc5d0 \ub530\ub77c \uacb0\uc815\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc138 \uac1c\uc758 \uae30\ubcf8 \ub9c1\uc744 \ud074\ub9ac\uc5b4\ud558\uba74 100\uc810\uc774 \uc8fc\uc5b4\uc9c8 \uc218 \uc788\uc73c\uba70, \ud2b9\uc218 \ub9c1\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc804\uccb4 \ud589\uc744 \ud074\ub9ac\uc5b4\ud558\uba74 500\uc810\uc774 \uc8fc\uc5b4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\uba74 \ub354 \ub192\uc740 \uc810\uc218\ub97c \uc704\ud55c \uc804\ub7b5\uc744 \uc138\uc6b0\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uaca9\ud22c \uac8c\uc784\uc5d0\uc11c \ucf64\ubcf4\uc640 \uac19\uc2b5\ub2c8\ub2e4. \uc774\ub3d9\uc774 \ubcf5\uc7a1\ud560\uc218\ub85d \uc810\uc218\uac00 \ub192\uc2b5\ub2c8\ub2e4.]"}, {"question": "\uceec\ub7ec \ub9c1 \ube14\ub85d \ud37c\uc990\uc758 \ub9c1 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc758 \ud575\uc2ec \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uceec\ub7ec \ub9c1 \ube14\ub85d \ud37c\uc990\uc758 \ub9c1 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc758 \ud575\uc2ec \uba54\ucee4\ub2c8\uc998\uc740 \uac19\uc740 \uc0c9\uc0c1\uc758 \uc138 \uac1c \uc774\uc0c1\uc758 \ub9c1\uc744 \ud589 \ub610\ub294 \uc5f4\uc5d0 \uc815\ub82c\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc138 \uac1c\uc758 \ube68\uac04\uc0c9 \ub9c1\uc774 \uc77c\ub82c\ub85c \uc788\uc73c\uba74 \ud074\ub9ac\uc5b4\ub418\uace0 \uc810\uc218\uac00 \ubd80\uc5ec\ub429\ub2c8\ub2e4. \ud2b9\uc218 \ub9c1\ub3c4 \ub9e4\uce58\ud558\uc5ec \uc804\uccb4 \ud589 \ub610\ub294 \uc5f4\uc744 \ud074\ub9ac\uc5b4\ud558\uc5ec \uc804\ub7b5\uc758 \ub610 \ub2e4\ub978 \uce21\uba74\uc744 \ucd94\uac00\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uacc4\ud68d \ube44\uad50: \uae30\ubcf8 \ub9e4\uce58\ub294 \uba87 \uac1c\uc758 \ub9c1\uc744 \ud074\ub9ac\uc5b4\ud558\uc9c0\ub9cc, \ud2b9\uc218 \ub9e4\uce58\ub294 \uc804\uccb4 \ud589 \ub610\ub294 \uc5f4\uc744 \ud074\ub9ac\uc5b4\ud558\uc5ec \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc2b5\ub2c8\ub2e4.]"}, {"question": "\uceec\ub7ec \ub9c1 \ube14\ub85d \ud37c\uc990\uc758 \ub370\uc774\ud130\ub97c \ub2e4\ub978 \uae30\uae30\ub85c \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud558\ub098\uc694?", "answer": "\uceec\ub7ec \ub9c1 \ube14\ub85d \ud37c\uc990\uc758 \ub370\uc774\ud130\ub97c \ub2e4\ub978 \uae30\uae30\ub85c \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud558\ub824\uba74 \ub450 \uae30\uae30 \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc548\ub4dc\ub85c\uc774\ub4dc \ud734\ub300\ud3f0\uc5d0\uc11c Google Play \uac8c\uc784\uc744 \uc0ac\uc6a9\ud558\ub294 \uacbd\uc6b0, \ud0dc\ube14\ub9bf\uc5d0\uc11c\ub3c4 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uba74 \ub429\ub2c8\ub2e4. \uc774\ub807\uac8c \ud558\uba74 \ub370\uc774\ud130\uac00 \uae30\uae30\uc5d0 \ub3d9\uae30\ud654\ub418\uc5b4 \uac8c\uc784\uc744 \uc6d0\ud65c\ud558\uac8c \uacc4\uc18d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131\ud45c: \uae30\uae30 1 - \uc548\ub4dc\ub85c\uc774\ub4dc \ud734\ub300\ud3f0; \uae30\uae30 2 - \uc548\ub4dc\ub85c\uc774\ub4dc \ud0dc\ube14\ub9bf; \ub3d9\uae30\ud654 \ubc29\ubc95 - Google Play \uac8c\uc784]"}, {"question": "\uceec\ub7ec \ub9c1 \ube14\ub85d \ud37c\uc990\uc5d0\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\ub098\uc694?", "answer": "\uceec\ub7ec \ub9c1 \ube14\ub85d \ud37c\uc990\uc5d0\ub294 \ubcf4\ub108\uc2a4 \ub808\ubca8\uacfc \ube44\ubc00\uc131\ucde8\uc640 \uac19\uc740 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud2b9\uc815 \uc2dc\uac04 \ub0b4\uc5d0 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uba74 \uace0\uc720\ud55c \ucc4c\ub9b0\uc9c0\uac00 \uc788\ub294 \ubcf4\ub108\uc2a4 \ub808\ubca8\uc774 \uc5f4\ub9bd\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uae30\ub2a5\uc744 \ubc1c\uacac\ud558\uba74 \uac8c\uc784\uc5d0 \ub300\ud55c \ucd94\uac00\uc801\uc778 \ud765\ubbf8\uc640 \uc7ac\ubbf8\ub97c \ub354\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: RPG\uc5d0\uc11c \uc228\uaca8\uc9c4 \ubcf4\ubb3c \uc0c1\uc790\ub97c \ubc1c\uacac\ud558\ub294 \uac83\ucc98\ub7fc \ubcf4\uc0c1\uc801\uc778 \ub180\ub77c\uc6c0\uc785\ub2c8\ub2e4.]"}, {"question": "\uceec\ub7ec \ub9c1 \ube14\ub85d \ud37c\uc990\uc758 \ub09c\uc774\ub3c4 \uace1\uc120\uc740 \uc5b4\ub5bb\uac8c \uc9c4\ud589\ub418\ub098\uc694?", "answer": "\uceec\ub7ec \ub9c1 \ube14\ub85d \ud37c\uc990\uc758 \ub09c\uc774\ub3c4\uac00 \ub192\uc544\uc9c0\ub294 \ubc29\uc2dd\uc740 \ub808\ubca8\uc744 \uc9c4\ud589\ud568\uc5d0 \ub530\ub77c \ub354 \ubcf5\uc7a1\ud55c \ub9c1 \ubc30\uc5f4\uacfc \uc81c\ud55c\ub41c \uc774\ub3d9\uc744 \ub3c4\uc785\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucd08\uae30 \ub808\ubca8\uc5d0\uc11c\ub294 \uac04\ub2e8\ud55c 3\ub9c1 \ub9e4\uce58\uac00 \uc788\ub294 \ubc18\uba74, \ud6c4\ubc18 \ub808\ubca8\uc5d0\uc11c\ub294 \uc81c\ud55c\ub41c \uc774\ub3d9 \uc218 \uc548\uc5d0\uc11c \ubcf4\ub4dc\ub97c \ud074\ub9ac\uc5b4\ud558\uae30 \uc704\ud55c \uc804\ub7b5\uc801\uc778 \uacc4\ud68d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc810\uc9c4\uc801\uc778 \ub09c\uc774\ub3c4 \uc99d\uac00\ub294 \uac8c\uc784\uc744 \uacc4\uc18d\ud574\uc11c \uc5b4\ub835\uace0 \uc7ac\ubbf8\uc788\uac8c \ub9cc\ub4ed\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \ub808\ubca8 1-10 - \uae30\ubcf8 \ub9e4\uce58; \ub808\ubca8 11-20 - \uc81c\ud55c\ub41c \uc774\ub3d9; \ub808\ubca8 21+ - \ubcf5\uc7a1\ud55c \ubc30\uc5f4]"}, {"question": "\uceec\ub7ec \ub9c1 \ube14\ub85d \ud37c\uc990 \ucd08\uc2ec\uc790\ub97c \uc704\ud55c \ucd5c\uc0c1\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uceec\ub7ec \ub9c1 \ube14\ub85d \ud37c\uc990 \ucd08\uc2ec\uc790\ub97c \uc704\ud55c \ucd5c\uc0c1\uc758 \ubc29\ubc95\uc740 \uae30\ubcf8 \ub9e4\uce58\ub97c \ub9cc\ub4dc\ub294 \ub370 \uc9d1\uc911\ud558\uace0, \ub9c1\uc758 \ub2e4\ub978 \uc720\ud615\uc744 \uc774\ud574\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubcf4\ub4dc\ub97c \ud074\ub9ac\uc5b4\ud558\uae30 \uc704\ud574 \ucc98\uc74c\uc5d0\ub294 \uc138 \uac1c\uc758 \uae30\ubcf8 \ub9c1\uc744 \ub9e4\uce58\ud55c \ub2e4\uc74c \uc810\uc9c4\uc801\uc73c\ub85c \ud2b9\uc218 \ub9c1\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub354 \ud070 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \ubc29\ubc95\uc744 \uc775\ud788\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uae30\ubcf8 \uc9c0\uc2dd\uc740 \uac8c\uc784\uc744 \uc9c4\ud589\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uacc4\ud68d \ube44\uad50: \ucd08\uc2ec\uc790\ub294 \uae30\ubcf8 \ub9e4\uce58\uc5d0 \uc9d1\uc911\ud574\uc57c \ud558\uba70, \uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \ud2b9\uc218 \ub9c1\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub192\uc740 \uc810\uc218\ub97c \ub178\ub824\ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}]
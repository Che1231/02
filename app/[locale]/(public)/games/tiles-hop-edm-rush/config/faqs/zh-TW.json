[{"question": "\u5982\u4f55\u57f7\u884c\u300a\u8df3\u78da\u584a\uff1aEDM\u72c2\u6f6e\uff01\u300b\u7684\u57fa\u672c\u8df3\u8e8d\u52d5\u4f5c\uff0c\u4ee5\u53ca\u521d\u5b78\u8005\u5e38\u72af\u7684\u932f\u8aa4\u6709\u54ea\u4e9b\uff1f", "answer": "\u8981\u57f7\u884c\u300a\u8df3\u78da\u584a\uff1aEDM\u72c2\u6f6e\uff01\u300b\u7684\u57fa\u672c\u8df3\u8e8d\uff0c\u53ea\u8981\u5728\u7403\u8207\u78da\u584a\u4e2d\u5fc3\u5c0d\u9f4a\u6642\u9ede\u64ca\u87a2\u5e55\u5373\u53ef\u3002\u521d\u5b78\u8005\u5e38\u72af\u7684\u932f\u8aa4\u662f\u9ede\u64ca\u904e\u65e9\u6216\u904e\u665a\uff0c\u5c0e\u81f4\u7403\u932f\u904e\u78da\u584a\u3002\u4f8b\u5982\uff0c\u5982\u679c\u7403\u5728\u87a2\u5e55\u5de6\u5074\uff0c\u8acb\u7b49\u5230\u5b83\u79fb\u52d5\u5230\u4e2d\u5fc3\u4f4d\u7f6e\u518d\u9ede\u64ca\u3002\u4e00\u500b\u6709\u5e6b\u52a9\u7684\u5c0f\u6280\u5de7\u662f\u8ddf\u8457 EDM \u97f3\u6a02\u7684\u7bc0\u594f\uff0c\u9019\u53ef\u4ee5\u63d0\u5347\u6642\u9593\u611f\u548c\u6e96\u78ba\u5ea6\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u300a\u8df3\u78da\u584a\uff1aEDM\u72c2\u6f6e\uff01\u300b\u7684\u901f\u5ea6\u6703\u589e\u52a0\uff0c\u4ee5\u53ca\u4f5c\u70ba\u65b0\u73a9\u5bb6\u5982\u4f55\u9069\u61c9\uff1f", "answer": "\u300a\u8df3\u78da\u584a\uff1aEDM\u72c2\u6f6e\uff01\u300b\u7684\u901f\u5ea6\u589e\u52a0\u662f\u70ba\u4e86\u6311\u6230\u73a9\u5bb6\uff0c\u4e26\u4fdd\u6301\u904a\u6232\u7684\u5438\u5f15\u529b\u3002\u4f5c\u70ba\u65b0\u73a9\u5bb6\uff0c\u60a8\u53ef\u4ee5\u900f\u904e\u5b9a\u671f\u7df4\u7fd2\u4f86\u63d0\u9ad8\u60a8\u7684\u53cd\u61c9\u6642\u9593\u3002\u4f8b\u5982\uff0c\u5f9e\u8f03\u6162\u7684\u95dc\u5361\u958b\u59cb\uff0c\u9010\u6b65\u904e\u6e21\u5230\u8f03\u5feb\u7684\u95dc\u5361\u3002\u6b64\u5916\uff0c\u8acb\u5c08\u6ce8\u65bc\u8996\u89ba\u63d0\u793a\uff0c\u800c\u4e0d\u662f\u55ae\u7d14\u4f9d\u8cf4\u8072\u97f3\uff0c\u56e0\u70ba\u9019\u53ef\u4ee5\u5e6b\u52a9\u60a8\u66f4\u6709\u6548\u5730\u9810\u6e2c\u4e0b\u4e00\u6b65\u52d5\u4f5c\u3002"}, {"question": "\u300a\u8df3\u78da\u584a\uff1aEDM\u72c2\u6f6e\uff01\u300b\u4e2d\u6709\u54ea\u4e9b\u4e0d\u540c\u985e\u578b\u7684\u78da\u584a\uff0c\u4ee5\u53ca\u5b83\u5011\u5982\u4f55\u5f71\u97ff\u904a\u6232\uff1f", "answer": "\u5728\u300a\u8df3\u78da\u584a\uff1aEDM\u72c2\u6f6e\uff01\u300b\u4e2d\uff0c\u6709\u5e7e\u7a2e\u985e\u578b\u7684\u78da\u584a\uff0c\u5305\u62ec\u6a19\u6e96\u78da\u584a\u3001\u79fb\u52d5\u78da\u584a\u548c\u53ef\u7834\u58de\u78da\u584a\u3002\u6a19\u6e96\u78da\u584a\u662f\u975c\u6b62\u7684\uff0c\u53ef\u4ee5\u5b89\u5168\u8457\u9678\u3002\u79fb\u52d5\u78da\u584a\u6703\u4f86\u56de\u6ed1\u52d5\uff0c\u9700\u8981\u7cbe\u78ba\u7684\u6642\u9593\u611f\u3002\u53ef\u7834\u58de\u78da\u584a\u5728\u55ae\u6b21\u8df3\u8e8d\u5f8c\u6703\u6d88\u5931\uff0c\u589e\u52a0\u4e86\u98a8\u96aa\u6027\u3002\u4f8b\u5982\uff0c\u843d\u5728\u53ef\u7834\u58de\u7684\u78da\u584a\u4e0a\u6703\u8feb\u4f7f\u60a8\u8fc5\u901f\u8df3\u5230\u4e0b\u4e00\u584a\u78da\u584a\uff0c\u4ee5\u907f\u514d\u589c\u843d\u3002\u77ad\u89e3\u9019\u4e9b\u78da\u584a\u985e\u578b\u5c0d\u65bc\u7b56\u7565\u6027\u904a\u6232\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u5982\u4f55\u900f\u904e\u6709\u6548\u9023\u64ca\u4f86\u6700\u5927\u5316\u300a\u8df3\u78da\u584a\uff1aEDM\u72c2\u6f6e\uff01\u300b\u7684\u5206\u6578\uff1f", "answer": "\u8981\u6700\u5927\u5316\u300a\u8df3\u78da\u584a\uff1aEDM\u72c2\u6f6e\uff01\u300b\u7684\u5206\u6578\uff0c\u8acb\u5c08\u6ce8\u65bc\u9023\u7e8c\u8457\u9678\u5728\u9023\u7e8c\u7684\u78da\u584a\u4e0a\uff0c\u800c\u7121\u9700\u932f\u904e\u3002\u4ee5\u4e0b\u662f\u9010\u6b65\u6307\u5357\uff1a\u6b65\u9a5f\u4e00\uff1a\u5c07\u7403\u8207\u78da\u584a\u4e2d\u5fc3\u5c0d\u9f4a\u3002\u6b65\u9a5f\u4e8c\uff1a\u5728\u6b63\u78ba\u7684\u6642\u9593\u9ede\u64ca\u4ee5\u78ba\u4fdd\u6210\u529f\u8df3\u8e8d\u3002\u6b65\u9a5f\u4e09\uff1a\u4fdd\u6301\u7bc0\u594f\u91cd\u8907\u6b64\u904e\u7a0b\u3002\u4f8b\u5982\uff0c\u9023\u7e8c\u8457\u9678 10 \u500b\u78da\u584a\u5c07\u986f\u8457\u63d0\u5347\u60a8\u7684\u5206\u6578\u3002\u6b64\u5916\uff0c\u5617\u8a66\u8457\u9678\u5728\u7279\u5225\u7684\u78da\u584a\u4e0a\uff0c\u4f8b\u5982\u91d1\u78da\u584a\uff0c\u5b83\u5011\u6703\u63d0\u4f9b\u984d\u5916\u5206\u6578\u3002"}, {"question": "\u300a\u8df3\u78da\u584a\uff1aEDM\u72c2\u6f6e\uff01\u300b\u4e2d\u6700\u6709\u6548\u7684\u589e\u76ca\u9053\u5177\u6709\u54ea\u4e9b\uff0c\u4ee5\u53ca\u4f55\u6642\u61c9\u8a72\u4f7f\u7528\u5b83\u5011\uff1f", "answer": "\u300a\u8df3\u78da\u584a\uff1aEDM\u72c2\u6f6e\uff01\u300b\u4e2d\u6700\u6709\u6548\u7684\u589e\u76ca\u9053\u5177\u5305\u62ec\u8b77\u76fe\u3001\u5206\u6578\u500d\u589e\u5668\u548c\u6162\u52d5\u4f5c\u3002\u8b77\u76fe\u53ef\u4ee5\u4fdd\u8b77\u60a8\u514d\u65bc\u932f\u904e\u78da\u584a\uff0c\u5206\u6578\u500d\u589e\u5668\u6703\u589e\u52a0\u60a8\u7684\u5206\u6578\uff0c\u800c\u6162\u52d5\u4f5c\u5247\u6703\u964d\u4f4e\u904a\u6232\u901f\u5ea6\u3002\u7576\u60a8\u8655\u65bc\u56f0\u96e3\u5340\u6bb5\u6642\u4f7f\u7528\u8b77\u76fe\uff0c\u5728\u9ad8\u5206\u6a5f\u6703\u4f7f\u7528\u5206\u6578\u500d\u589e\u5668\uff0c\u7576\u904a\u6232\u901f\u5ea6\u904e\u5feb\u6642\u4f7f\u7528\u6162\u52d5\u4f5c\u3002\u4f8b\u5982\uff0c\u5728\u5feb\u901f\u7bc0\u594f\u7684\u5340\u6bb5\u4e2d\u6fc0\u6d3b\u6162\u52d5\u4f5c\u53ef\u4ee5\u5e6b\u52a9\u60a8\u6062\u5fa9\u63a7\u5236\u3002"}, {"question": "\u5b8c\u6210\u300a\u8df3\u78da\u584a\uff1aEDM\u72c2\u6f6e\uff01\u300b\u56f0\u96e3\u95dc\u5361\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5b8c\u6210\u300a\u8df3\u78da\u584a\uff1aEDM\u72c2\u6f6e\uff01\u300b\u56f0\u96e3\u95dc\u5361\u7684\u6700\u4f73\u7b56\u7565\u7d50\u5408\u4e86\u7df4\u7fd2\u3001\u6642\u9593\u638c\u63a7\u548c\u589e\u76ca\u9053\u5177\u7684\u904b\u7528\u3002\u6b65\u9a5f\u4e00\uff1a\u53cd\u8986\u7df4\u7fd2\u95dc\u5361\uff0c\u4ee5\u719f\u6089\u78da\u584a\u7684\u6a21\u5f0f\u3002\u6b65\u9a5f\u4e8c\uff1a\u5c08\u6ce8\u65bc\u7cbe\u78ba\u5730\u638c\u63e1\u8df3\u8e8d\u6642\u9593\uff0c\u5c24\u5176\u662f\u79fb\u52d5\u78da\u584a\u3002\u6b65\u9a5f\u4e09\uff1a\u7b56\u7565\u6027\u5730\u4f7f\u7528\u589e\u76ca\u9053\u5177\uff0c\u4f8b\u5982\u8b77\u76fe\u4ee5\u63d0\u4f9b\u4fdd\u8b77\uff0c\u4ee5\u53ca\u6162\u52d5\u4f5c\u4ee5\u66f4\u597d\u5730\u63a7\u5236\u3002\u4f8b\u5982\uff0c\u5728\u8a31\u591a\u53ef\u7834\u58de\u78da\u584a\u7684\u95dc\u5361\u4e2d\uff0c\u8b77\u76fe\u53ef\u4ee5\u9632\u6b62\u60a8\u589c\u843d\u3002"}, {"question": "\u300a\u8df3\u78da\u584a\uff1aEDM\u72c2\u6f6e\uff01\u300b\u7684\u5206\u6578\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u6700\u7d42\u5206\u6578\uff1f", "answer": "\u300a\u8df3\u78da\u584a\uff1aEDM\u72c2\u6f6e\uff01\u300b\u7684\u5206\u6578\u7cfb\u7d71\u57fa\u65bc\u6210\u529f\u8df3\u8e8d\u6b21\u6578\u3001\u9023\u64ca\u7d44\u5408\u548c\u7279\u6b8a\u78da\u584a\u8457\u9678\u3002\u6bcf\u6b21\u6210\u529f\u7684\u8df3\u8e8d\u90fd\u6703\u7372\u5f97\u5206\u6578\uff0c\u5728\u7279\u6b8a\u78da\u584a\uff08\u4f8b\u5982\u91d1\u78da\u584a\uff09\u4e0a\u8457\u9678\u6703\u984d\u5916\u7372\u5f97\u5206\u6578\u3002\u9023\u64ca\u7d44\u5408\u6703\u4e58\u4ee5\u60a8\u7684\u5206\u6578\uff0c\u6240\u4ee5\u9023\u7e8c\u8457\u9678\u591a\u500b\u78da\u584a\u4e14\u4e0dMISS\u6703\u63d0\u9ad8\u60a8\u7684\u6700\u7d42\u5206\u6578\u3002\u4f8b\u5982\uff0c\u9023\u7e8c\u8457\u9678 5 \u500b\u78da\u584a\u5c07\u6bd4\u5728\u4e2d\u9593\u932f\u904e 5 \u500b\u78da\u584a\u7372\u5f97\u66f4\u9ad8\u7684\u5206\u6578\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5728\u53e6\u4e00\u90e8\u88dd\u7f6e\u4e0a\u8f49\u79fb\u300a\u8df3\u78da\u584a\uff1aEDM\u72c2\u6f6e\uff01\u300b\u7684\u904a\u6232\u9032\u5ea6\u55ce\uff1f\u5982\u4f55\u8f49\u79fb\uff1f", "answer": "\u662f\u7684\uff0c\u60a8\u53ef\u4ee5\u900f\u904e\u5c07\u904a\u6232\u5e33\u6236\u9023\u7d50\u5230\u793e\u7fa4\u5a92\u9ad4\u5e33\u6236\u6216\u96fb\u5b50\u90f5\u4ef6\u4f86\u8f49\u79fb\u300a\u8df3\u78da\u584a\uff1aEDM\u72c2\u6f6e\uff01\u300b\u7684\u904a\u6232\u9032\u5ea6\u5230\u53e6\u4e00\u90e8\u88dd\u7f6e\u3002\u6b65\u9a5f\u4e00\uff1a\u524d\u5f80\u904a\u6232\u8a2d\u5b9a\u4e26\u9078\u64c7\u300c\u5e33\u6236\u300d\u9078\u9805\u3002\u6b65\u9a5f\u4e8c\uff1a\u9078\u64c7\u300c\u9023\u7d50\u5e33\u6236\u300d\u529f\u80fd\uff0c\u4e26\u6309\u7167\u63d0\u793a\u9023\u7d50\u60a8\u7684\u5e33\u6236\u3002\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u76f8\u540c\u7684\u5e33\u6236\u8a73\u7d30\u8cc7\u6599\u767b\u5165\u60a8\u7684\u65b0\u88dd\u7f6e\u3002\u4f8b\u5982\uff0c\u9023\u7d50 Facebook \u53ef\u4ee5\u78ba\u4fdd\u60a8\u7684\u9032\u5ea6\u6703\u5132\u5b58\uff0c\u4e26\u53ef\u4ee5\u5b58\u53d6\u4efb\u4f55\u88dd\u7f6e\u3002"}, {"question": "\u300a\u8df3\u78da\u584a\uff1aEDM\u72c2\u6f6e\uff01\u300b\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u6210\u5c31\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9396\u5b83\u5011\uff1f", "answer": "\u300a\u8df3\u78da\u584a\uff1aEDM\u72c2\u6f6e\uff01\u300b\u4e2d\u7684\u96b1\u85cf\u6210\u5c31\u5305\u62ec\u300c\u5b8c\u7f8e\u9023\u64ca\u300d\u3001\u300c\u901f\u5ea6\u9b54\u4eba\u300d\u548c\u300c\u78da\u584a\u5927\u5e2b\u300d\u3002\u8981\u89e3\u9396\u300c\u5b8c\u7f8e\u9023\u64ca\u300d\uff0c\u8acb\u9023\u7e8c\u8457\u9678 50 \u500b\u78da\u584a\u800c\u4e0d\u932f\u904e\u3002\u8981\u89e3\u9396\u300c\u901f\u5ea6\u9b54\u4eba\u300d\uff0c\u8acb\u4ee5\u6700\u5927\u901f\u5ea6\u500d\u7387\u5b8c\u6210\u4e00\u500b\u95dc\u5361\u3002\u8981\u89e3\u9396\u300c\u78da\u584a\u5927\u5e2b\u300d\uff0c\u8acb\u5728\u55ae\u5834\u904a\u6232\u4e2d\u8457\u9678\u6bcf\u7a2e\u985e\u578b\u7684\u78da\u584a\u3002\u4f8b\u5982\uff0c\u5728\u6709\u79fb\u52d5\u78da\u584a\u3001\u53ef\u7834\u58de\u78da\u584a\u548c\u91d1\u78da\u584a\u7684\u95dc\u5361\u901a\u95dc\uff0c\u8457\u9678\u6240\u6709\u4e09\u7a2e\u985e\u578b\u78da\u584a\u5c07\u89e3\u9396\u300c\u78da\u584a\u5927\u5e2b\u300d\u6210\u5c31\u3002"}]
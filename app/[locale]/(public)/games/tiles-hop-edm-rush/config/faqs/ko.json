[{"question": "\ud0c0\uc77c \ud649: EDM \ub7ec\uc2dc!\uc5d0\uc11c \uae30\ubcf8 \uc810\ud504\ub97c \uc5b4\ub5bb\uac8c \uc218\ud589\ud558\uba70, \ucd08\ubcf4\uc790\ub4e4\uc774 \ud754\ud788 \uc800\uc9c0\ub974\ub294 \uc2e4\uc218\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud0c0\uc77c \ud649: EDM \ub7ec\uc2dc!\uc5d0\uc11c \uae30\ubcf8 \uc810\ud504\ub97c \ud558\ub824\uba74 \uacf5\uc774 \ud0c0\uc77c \uc911\uc559\uc5d0 \uc815\ub82c\ub418\uc5c8\uc744 \ub54c \ud654\uba74\uc744 \ud0ed\ud558\uba74 \ub429\ub2c8\ub2e4. \ucd08\ubcf4\uc790\ub4e4\uc740 \uc790\uc8fc \ub108\ubb34 \uc77c\ucc0d \ub610\ub294 \ub108\ubb34 \ub2a6\uac8c \ud0ed\ud558\uc5ec \uacf5\uc774 \ud0c0\uc77c\uc744 \ub193\uce58\ub294 \uc2e4\uc218\ub97c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uacf5\uc774 \ud654\uba74 \uc67c\ucabd\uc5d0 \uc788\uc73c\uba74 \uc6c0\uc9c1\uc5ec \uc911\uc559\uc5d0 \uc624\uae30 \uc804\uae4c\uc9c0 \ud0ed\ud558\uc9c0 \ub9c8\uc2ed\uc2dc\uc624. EDM \uc74c\uc545\uc758 \ub9ac\ub4ec\uc744 \ub530\ub974\ub294 \uac83\uc774 \ud0c0\uc774\ubc0d\uacfc \uc815\ud655\uc131\uc744 \ub192\uc774\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud0c0\uc77c \ud649: EDM \ub7ec\uc2dc!\uc5d0\uc11c \uc18d\ub3c4\uac00 \uc99d\uac00\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc0c8 \ud50c\ub808\uc774\uc5b4\ub85c\uc11c \uc5b4\ub5bb\uac8c \uc801\uc751\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud0c0\uc77c \ud649: EDM \ub7ec\uc2dc!\uc5d0\uc11c \uc18d\ub3c4\uac00 \uc99d\uac00\ud558\ub294 \uac83\uc740 \ud50c\ub808\uc774\uc5b4\ub97c \ucc4c\ub9b0\uc9c0\ud558\uace0 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud765\ubbf8\ub86d\uac8c \uc720\uc9c0\ud558\uae30 \uc704\ud55c \uac83\uc785\ub2c8\ub2e4. \uc2e0\uaddc \ud50c\ub808\uc774\uc5b4\ub85c\uc11c \ubc18\uc751 \uc2dc\uac04\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uae30 \uc704\ud574 \uc815\uae30\uc801\uc73c\ub85c \uc5f0\uc2b5\ud558\uba74 \uc801\uc751\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub354 \ub290\ub9b0 \ub808\ubca8\ub85c \uc2dc\uc791\ud558\uc5ec \uc810\ucc28\uc801\uc73c\ub85c \ub354 \ube60\ub978 \ub808\ubca8\ub85c \uc62e\uaca8\ubcf4\uc138\uc694. \ub610\ud55c, \uc624\uc9c1 \uc18c\ub9ac\uc5d0\ub9cc \uc758\uc874\ud558\uae30\ubcf4\ub2e4\ub294 \uc2dc\uac01\uc801 \ub2e8\uc11c\uc5d0 \uc9d1\uc911\ud558\uba74 \ub2e4\uc74c \uc6c0\uc9c1\uc784\uc744 \ub354 \ud6a8\uacfc\uc801\uc73c\ub85c \uc608\uce21\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud0c0\uc77c \ud649: EDM \ub7ec\uc2dc!\uc5d0\uc11c \ud0c0\uc77c\uc758 \uc885\ub958\ub294 \ubb34\uc5c7\uc774\uba70, \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ud0c0\uc77c \ud649: EDM \ub7ec\uc2dc!\uc5d0\ub294 \ud45c\uc900 \ud0c0\uc77c, \uc774\ub3d9 \ud0c0\uc77c \ubc0f \ubd80\uc11c\uc9c0\ub294 \ud0c0\uc77c \ub4f1 \uc5ec\ub7ec \uc720\ud615\uc758 \ud0c0\uc77c\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ud45c\uc900 \ud0c0\uc77c\uc740 \uace0\uc815\ub418\uc5b4 \uc788\uace0 \ucc29\uc9c0\ud558\uae30 \uc548\uc804\ud569\ub2c8\ub2e4. \uc774\ub3d9 \ud0c0\uc77c\uc740 \uc55e\ub4a4\ub85c \ubbf8\ub044\ub7ec\uc9c0\ubbc0\ub85c \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ubd80\uc11c\uc9c0\ub294 \ud0c0\uc77c\uc740 \ub2e8 \ud55c \ubc88\uc758 \uc810\ud504 \ud6c4 \uc0ac\ub77c\uc9c0\ubbc0\ub85c \uc704\ud5d8 \uc694\uc18c\uac00 \ucd94\uac00\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubd80\uc11c\uc9c0\ub294 \ud0c0\uc77c\uc5d0 \ucc29\ub959\ud558\uba74 \ub5a8\uc5b4\uc9c0\ub294 \uac83\uc744 \ud53c\ud558\uae30 \uc704\ud574 \ub2e4\uc74c \ud0c0\uc77c\uc5d0 \uc2e0\uc18d\ud558\uac8c \uc810\ud504\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud0c0\uc77c \uc720\ud615\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \uc804\ub7b5\uc801 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4."}, {"question": "\ud0c0\uc77c \ud649: EDM \ub7ec\uc2dc!\uc5d0\uc11c \ud6a8\uacfc\uc801\uc73c\ub85c \uc5f0\uc1c4 \ucf64\ubcf4\ub97c \ud1b5\ud574 \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud0c0\uc77c \ud649: EDM \ub7ec\uc2dc!\uc5d0\uc11c \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud558\ub824\uba74 \uc5f0\uc18d\uc801\uc778 \ud0c0\uc77c\uc5d0 \ub193\uce58\uc9c0 \uc54a\uace0 \ucc29\ub959\ud558\uc5ec \ucf64\ubcf4\ub97c \uc5f0\uc1c4\uc2dc\ud0a4\ub294 \ub370 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. \ub2e4\uc74c\uc740 \ub2e8\uacc4\ubcc4 \uac00\uc774\ub4dc\uc785\ub2c8\ub2e4: 1\ub2e8\uacc4: \uacf5\uc744 \ud0c0\uc77c \uc911\uc559\uc5d0 \uc815\ub82c\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \uc131\uacf5\uc801\uc778 \uc810\ud504\ub97c \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 \uc801\uc808\ud55c \uc21c\uac04\uc5d0 \ud0ed\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \ub9ac\ub4ec\uc744 \uc720\uc9c0\ud558\uba74\uc11c \uc774 \uacfc\uc815\uc744 \ubc18\ubcf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5f0\uc18d 10\uac1c\uc758 \ud0c0\uc77c\uc5d0 \ucc29\ub959\ud558\uba74 \uc810\uc218\uac00 \ud06c\uac8c \uc99d\uac00\ud560 \uac83\uc785\ub2c8\ub2e4. \ub610\ud55c \uace8\ub4e0 \ud0c0\uc77c\uacfc \uac19\uc740 \ud2b9\uc218 \ud0c0\uc77c\uc5d0 \ucc29\ub959\ud558\uc5ec \ucd94\uac00 \uc810\uc218\ub97c \uc5bb\uc73c\ub824\uace0 \ub178\ub825\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ud0c0\uc77c \ud649: EDM \ub7ec\uc2dc!\uc5d0\uc11c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ud30c\uc6cc\uc5c5\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b8\uc81c \uc0ac\uc6a9\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\ud0c0\uc77c \ud649: EDM \ub7ec\uc2dc!\uc5d0\uc11c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ud30c\uc6cc\uc5c5\uc5d0\ub294 \ubc29\ud328, \uc810\uc218 \ubc30\uc218\uae30 \ubc0f \uc2ac\ub85c\uc6b0 \ubaa8\uc158\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \ubc29\ud328\ub294 \ud0c0\uc77c\uc744 \ub193\uce58\ub294 \uac83\uc73c\ub85c\ubd80\ud130 \ubcf4\ud638\ud558\uace0, \uc810\uc218 \ubc30\uc218\uae30\ub294 \uc810\uc218\ub97c \uc99d\uac00\uc2dc\ud0a4\uba70, \uc2ac\ub85c\uc6b0 \ubaa8\uc158\uc740 \uac8c\uc784 \uc18d\ub3c4\ub97c \uc904\uc785\ub2c8\ub2e4. \uc5b4\ub824\uc6b4 \uad6c\uac04\uc5d0\uc11c\ub294 \ubc29\ud328\ub97c, \ub192\uc740 \uc810\uc218\ub97c \ubaa9\ud45c\ub85c \ud558\ub294 \uc0c1\ud669\uc5d0\uc11c\ub294 \uc810\uc218 \ubc30\uc218\uae30\ub97c, \uac8c\uc784 \uc18d\ub3c4\uac00 \ub108\ubb34 \ube68\ub77c\uc9c8 \ub54c\ub294 \uc2ac\ub85c\uc6b0 \ubaa8\uc158\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ube60\ub974\uac8c \uc9c4\ud589\ub418\ub294 \uad6c\uac04\uc5d0\uc11c \uc2ac\ub85c\uc6b0 \ubaa8\uc158\uc744 \ud65c\uc131\ud654\ud558\uba74 \uc81c\uc5b4\ub825\uc744 \ub418\ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud0c0\uc77c \ud649: EDM \ub7ec\uc2dc!\uc5d0\uc11c \uc5b4\ub824\uc6b4 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud0c0\uc77c \ud649: EDM \ub7ec\uc2dc!\uc5d0\uc11c \uc5b4\ub824\uc6b4 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \uc5f0\uc2b5, \ud0c0\uc774\ubc0d \ubc0f \ud30c\uc6cc\uc5c5 \uc0ac\uc6a9\uc758 \uc870\ud569\uc785\ub2c8\ub2e4. 1\ub2e8\uacc4: \ud0c0\uc77c \ud328\ud134\uc5d0 \uc775\uc219\ud574\uc9c8 \uc218 \uc788\ub3c4\ub85d \ub808\ubca8\uc744 \uc5ec\ub7ec \ubc88 \uc5f0\uc2b5\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \ud2b9\ud788 \uc774\ub3d9 \ud0c0\uc77c\uc5d0 \ub300\ud574 \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uc815\ud655\ud558\uac8c \ub9de\ucda5\ub2c8\ub2e4. 3\ub2e8\uacc4: \ubcf4\ud638\ub97c \uc704\ud574 \ubc29\ud328\uc640 \uc81c\uc5b4\ub825 \ud5a5\uc0c1\uc744 \uc704\ud574 \uc2ac\ub85c\uc6b0 \ubaa8\uc158\uacfc \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub9ce\uc740 \ubd80\uc11c\uc9c0\ub294 \ud0c0\uc77c\uc774 \uc788\ub294 \ub808\ubca8\uc5d0\uc11c\ub294 \ubc29\ud328\uac00 \ub5a8\uc5b4\uc9c0\ub294 \uac83\uc744 \ub9c9\uc544\uc90d\ub2c8\ub2e4."}, {"question": "\ud0c0\uc77c \ud649: EDM \ub7ec\uc2dc!\uc5d0\uc11c \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \ucd5c\uc885 \uc810\uc218\ub294 \uc5b4\ub5a4 \uc694\uc778\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\uae4c?", "answer": "\ud0c0\uc77c \ud649: EDM \ub7ec\uc2dc!\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc131\uacf5\uc801\uc778 \uc810\ud504 \uc218, \ucf64\ubcf4 \uc5f0\uc1c4 \ubc0f \ud2b9\uc218 \ud0c0\uc77c\uc5d0 \ucc29\uc9c0\ud55c \ud69f\uc218\ub97c \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. \uac01 \uc131\uacf5\uc801\uc778 \uc810\ud504\ub294 \uc810\uc218\ub97c \uc81c\uacf5\ud558\uba70, \uace8\ub4e0 \ud0c0\uc77c\uacfc \uac19\uc740 \ud2b9\uc218 \ud0c0\uc77c\uc5d0 \ucc29\uc9c0\ud558\uba74 \ucd94\uac00 \uc810\uc218\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. \ucf64\ubcf4 \uc5f0\uc1c4\ub294 \uc810\uc218\ub97c \ubc30\uc218\ud558\uc5ec \uc5f0\uc18d\uc73c\ub85c \uc5ec\ub7ec \ud0c0\uc77c\uc5d0 \ucc29\ub959\ud558\uace0 \ub193\uce58\uc9c0 \uc54a\uc73c\uba74 \ucd5c\uc885 \uc810\uc218\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5f0\uc18d 5\uac1c\uc758 \ud0c0\uc77c\uc5d0 \ucc29\ub959\ud558\ub294 \uac83\uc740 \uadf8 \uc0ac\uc774\uc5d0 \ub193\uce5c 5\uac1c\uc758 \ud0c0\uc77c\uc5d0 \ucc29\ub959\ud558\ub294 \uac83\ubcf4\ub2e4 \ub354 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc2b5\ub2c8\ub2e4."}, {"question": "\ud0c0\uc77c \ud649: EDM \ub7ec\uc2dc!\uc5d0\uc11c \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\ub978 \uae30\uae30\uc5d0 \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c? \uc5b4\ub5bb\uac8c \ud569\ub2c8\uae4c?", "answer": "\ub124, \ud0c0\uc77c \ud649: EDM \ub7ec\uc2dc!\uc5d0\uc11c \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\ub978 \uae30\uae30\uc5d0 \uc774\uc804\ud558\ub824\uba74 \uc18c\uc15c \ubbf8\ub514\uc5b4 \uacc4\uc815 \ub610\ub294 \uc774\uba54\uc77c\ub85c \uac8c\uc784 \uacc4\uc815\uc744 \uc5f0\uacb0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 1\ub2e8\uacc4: \uac8c\uc784 \uc124\uc815\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec \"\uacc4\uc815\" \uc635\uc158\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \"\uacc4\uc815 \uc5f0\uacb0\" \uae30\ub2a5\uc744 \uc120\ud0dd\ud558\uace0 \uc548\ub0b4\uc5d0 \ub530\ub77c \uacc4\uc815\uc744 \uc5f0\uacb0\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \ub3d9\uc77c\ud55c \uacc4\uc815 \uc815\ubcf4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc0c8 \uae30\uae30\uc5d0\uc11c \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud398\uc774\uc2a4\ubd81\uc5d0 \uc5f0\uacb0\ud558\uba74 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc800\uc7a5\ub418\uc5b4 \ubaa8\ub4e0 \uae30\uae30\uc5d0\uc11c \uc561\uc138\uc2a4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud0c0\uc77c \ud649: EDM \ub7ec\uc2dc!\uc5d0\uc11c \uc228\uaca8\uc9c4 \uc5c5\uc801\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud0c0\uc77c \ud649: EDM \ub7ec\uc2dc!\uc758 \uc228\uaca8\uc9c4 \uc5c5\uc801\uc5d0\ub294 \"\uc644\ubcbd\ud55c \ucf64\ubcf4\", \"\uc2a4\ud53c\ub4dc \ub370\ubaac\", \"\ud0c0\uc77c \ub9c8\uc2a4\ud130\"\uac00 \uc788\uc2b5\ub2c8\ub2e4. \"\uc644\ubcbd\ud55c \ucf64\ubcf4\"\ub97c \ud574\uc81c\ud558\ub824\uba74 50\uac1c\uc758 \ud0c0\uc77c\uc5d0 \uc5f0\uc18d\ud574\uc11c \ub193\uce58\uc9c0 \uc54a\uace0 \ucc29\ub959\ud574\uc57c \ud569\ub2c8\ub2e4. \"\uc2a4\ud53c\ub4dc \ub370\ubaac\"\uc740 \ucd5c\ub300 \uc18d\ub3c4 \ubc30\uc218\uae30\ub85c \ub808\ubca8\uc744 \uc644\ub8cc\ud574\uc57c \ud569\ub2c8\ub2e4. \"\ud0c0\uc77c \ub9c8\uc2a4\ud130\"\ub294 \ud55c \uac8c\uc784\uc5d0\uc11c \ubaa8\ub4e0 \uc720\ud615\uc758 \ud0c0\uc77c\uc5d0 \ucc29\ub959\ud558\uc5ec \ub2ec\uc131\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc774\ub3d9, \ubd80\uc11c\uc9d0 \ubc0f \uace8\ub4e0 \ud0c0\uc77c\uc774 \uc788\ub294 \ub808\ubca8\uc5d0\uc11c \uc138 \ud0c0\uc77c\uc5d0 \ubaa8\ub450 \ucc29\ub959\ud558\uba74 \"\ud0c0\uc77c \ub9c8\uc2a4\ud130\"\uac00 \ud574\uc81c\ub429\ub2c8\ub2e4."}]
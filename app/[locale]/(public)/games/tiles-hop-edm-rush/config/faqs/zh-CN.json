[{"question": "\u5982\u4f55\u5728\u300a\u65b9\u5757\u8df3\u8dc3\uff1aEDM\u72c2\u6f6e\u300b\u4e2d\u8fdb\u884c\u57fa\u672c\u8df3\u8dc3\uff0c\u4ee5\u53ca\u521d\u5b66\u8005\u5e38\u72af\u54ea\u4e9b\u9519\u8bef\uff1f", "answer": "\u8981\u5728\u300a\u65b9\u5757\u8df3\u8dc3\uff1aEDM\u72c2\u6f6e\u300b\u4e2d\u8fdb\u884c\u57fa\u672c\u8df3\u8dc3\uff0c\u53ea\u9700\u5728\u5c0f\u7403\u4e0e\u65b9\u5757\u4e2d\u5fc3\u5bf9\u9f50\u65f6\u70b9\u51fb\u5c4f\u5e55\u3002\u521d\u5b66\u8005\u5e38\u72af\u7684\u9519\u8bef\u662f\u70b9\u51fb\u8fc7\u65e9\u6216\u8fc7\u665a\uff0c\u5bfc\u81f4\u5c0f\u7403\u9519\u8fc7\u65b9\u5757\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5c0f\u7403\u5728\u5c4f\u5e55\u5de6\u4fa7\uff0c\u8bf7\u7b49\u5f85\u5176\u79fb\u52a8\u5230\u4e2d\u5fc3\u540e\u518d\u70b9\u51fb\u3002\u4e00\u4e2a\u6709\u7528\u7684\u6280\u5de7\u662f\u8ddf\u968fEDM\u97f3\u4e50\u7684\u8282\u594f\uff0c\u8fd9\u6709\u52a9\u4e8e\u63d0\u9ad8\u65f6\u95f4\u611f\u548c\u51c6\u786e\u6027\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u300a\u65b9\u5757\u8df3\u8dc3\uff1aEDM\u72c2\u6f6e\u300b\u4e2d\u7684\u901f\u5ea6\u4f1a\u52a0\u5feb\uff0c\u4f5c\u4e3a\u65b0\u73a9\u5bb6\u5982\u4f55\u9002\u5e94\uff1f", "answer": "\u300a\u65b9\u5757\u8df3\u8dc3\uff1aEDM\u72c2\u6f6e\u300b\u4e2d\u7684\u901f\u5ea6\u52a0\u5feb\u662f\u4e3a\u4e86\u6311\u6218\u73a9\u5bb6\uff0c\u4fdd\u6301\u6e38\u620f\u7684\u8da3\u5473\u6027\u3002\u4f5c\u4e3a\u65b0\u73a9\u5bb6\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u5b9a\u671f\u7ec3\u4e60\u6765\u63d0\u9ad8\u53cd\u5e94\u65f6\u95f4\u4ee5\u9002\u5e94\u3002\u4f8b\u5982\uff0c\u4ece\u8f83\u6162\u7684\u5173\u5361\u5f00\u59cb\uff0c\u9010\u6e10\u8fc7\u6e21\u5230\u8f83\u5feb\u7684\u5173\u5361\u3002\u6b64\u5916\uff0c\u5173\u6ce8\u89c6\u89c9\u63d0\u793a\u800c\u4e0d\u662f\u4ec5\u4f9d\u8d56\u58f0\u97f3\uff0c\u8fd9\u6709\u52a9\u4e8e\u60a8\u66f4\u6709\u6548\u5730\u9884\u6d4b\u4e0b\u4e00\u6b65\u52a8\u4f5c\u3002"}, {"question": "\u300a\u65b9\u5757\u8df3\u8dc3\uff1aEDM\u72c2\u6f6e\u300b\u4e2d\u6709\u54ea\u4e9b\u4e0d\u540c\u7c7b\u578b\u7684\u65b9\u5757\uff0c\u5b83\u4eec\u5982\u4f55\u5f71\u54cd\u6e38\u620f\uff1f", "answer": "\u5728\u300a\u65b9\u5757\u8df3\u8dc3\uff1aEDM\u72c2\u6f6e\u300b\u4e2d\uff0c\u6709\u591a\u79cd\u7c7b\u578b\u7684\u65b9\u5757\uff0c\u5305\u62ec\u6807\u51c6\u65b9\u5757\u3001\u79fb\u52a8\u65b9\u5757\u548c\u53ef\u7834\u574f\u65b9\u5757\u3002\u6807\u51c6\u65b9\u5757\u662f\u9759\u6b62\u7684\uff0c\u53ef\u4ee5\u5b89\u5168\u7740\u9646\u3002\u79fb\u52a8\u65b9\u5757\u6765\u56de\u6ed1\u52a8\uff0c\u9700\u8981\u7cbe\u786e\u7684\u65f6\u95f4\u63a7\u5236\u3002\u53ef\u7834\u574f\u65b9\u5757\u5728\u5355\u6b21\u8df3\u8dc3\u540e\u6d88\u5931\uff0c\u589e\u52a0\u4e86\u4e00\u5b9a\u7684\u98ce\u9669\u3002\u4f8b\u5982\uff0c\u843d\u5728\u53ef\u7834\u574f\u65b9\u5757\u4e0a\uff0c\u8feb\u4f7f\u60a8\u5feb\u901f\u8df3\u5230\u4e0b\u4e00\u4e2a\u65b9\u5757\u4ee5\u907f\u514d\u6389\u843d\u3002\u4e86\u89e3\u8fd9\u4e9b\u65b9\u5757\u7c7b\u578b\u5bf9\u4e8e\u6218\u7565\u6e38\u620f\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u5982\u4f55\u901a\u8fc7\u6709\u6548\u5730\u8fde\u51fb\u7ec4\u5408\u6765\u6700\u5927\u5316\u300a\u65b9\u5757\u8df3\u8dc3\uff1aEDM\u72c2\u6f6e\u300b\u4e2d\u7684\u5f97\u5206\uff1f", "answer": "\u8981\u5728\u300a\u65b9\u5757\u8df3\u8dc3\uff1aEDM\u72c2\u6f6e\u300b\u4e2d\u6700\u5927\u5316\u5f97\u5206\uff0c\u8bf7\u4e13\u6ce8\u4e8e\u901a\u8fc7\u8fde\u7eed\u843d\u5728\u65b9\u5757\u4e0a\u800c\u4e0d\u5931\u8bef\u6765\u8fde\u51fb\u7ec4\u5408\u3002\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41\uff1a\u5c06\u5c0f\u7403\u4e0e\u65b9\u5757\u4e2d\u5fc3\u5bf9\u9f50\u3002\u6b65\u9aa42\uff1a\u5728\u6b63\u786e\u7684\u65f6\u95f4\u70b9\u51fb\u4ee5\u786e\u4fdd\u6210\u529f\u8df3\u8dc3\u3002\u6b65\u9aa43\uff1a\u4fdd\u6301\u8282\u594f\u91cd\u590d\u6b64\u8fc7\u7a0b\u3002\u4f8b\u5982\uff0c\u8fde\u7eed\u843d\u572810\u4e2a\u65b9\u5757\u4e0a\u5c06\u663e\u7740\u63d0\u9ad8\u60a8\u7684\u5f97\u5206\u3002\u6b64\u5916\uff0c\u5c1d\u8bd5\u843d\u5728\u7279\u6b8a\u65b9\u5757\u4e0a\uff0c\u4f8b\u5982\u91d1\u8272\u65b9\u5757\uff0c\u5b83\u4eec\u4f1a\u63d0\u4f9b\u989d\u5916\u5206\u6570\u3002"}, {"question": "\u300a\u65b9\u5757\u8df3\u8dc3\uff1aEDM\u72c2\u6f6e\u300b\u4e2d\u6700\u6709\u6548\u7684\u9053\u5177\u6709\u54ea\u4e9b\uff0c\u4ee5\u53ca\u4f55\u65f6\u5e94\u8be5\u4f7f\u7528\u5b83\u4eec\uff1f", "answer": "\u300a\u65b9\u5757\u8df3\u8dc3\uff1aEDM\u72c2\u6f6e\u300b\u4e2d\u6700\u6709\u6548\u7684\u9053\u5177\u5305\u62ec\u62a4\u76fe\u3001\u5f97\u5206\u500d\u589e\u5668\u548c\u6162\u52a8\u4f5c\u3002\u62a4\u76fe\u4fdd\u62a4\u60a8\u514d\u4e8e\u9519\u8fc7\u65b9\u5757\uff0c\u5f97\u5206\u500d\u589e\u5668\u589e\u52a0\u60a8\u7684\u5206\u6570\uff0c\u6162\u52a8\u4f5c\u964d\u4f4e\u6e38\u620f\u901f\u5ea6\u3002\u5728\u56f0\u96be\u533a\u57df\u65f6\u4f7f\u7528\u62a4\u76fe\uff0c\u5728\u9ad8\u5206\u673a\u4f1a\u65f6\u4f7f\u7528\u5f97\u5206\u500d\u589e\u5668\uff0c\u5f53\u6e38\u620f\u901f\u5ea6\u8fc7\u4e8e\u5feb\u65f6\u4f7f\u7528\u6162\u52a8\u4f5c\u3002\u4f8b\u5982\uff0c\u5728\u5feb\u901f\u8282\u594f\u7684\u5173\u5361\u4e2d\u6fc0\u6d3b\u6162\u52a8\u4f5c\u53ef\u4ee5\u5e2e\u52a9\u60a8\u91cd\u65b0\u63a7\u5236\u3002"}, {"question": "\u5b8c\u6210\u300a\u65b9\u5757\u8df3\u8dc3\uff1aEDM\u72c2\u6f6e\u300b\u4e2d\u56f0\u96be\u5173\u5361\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5b8c\u6210\u300a\u65b9\u5757\u8df3\u8dc3\uff1aEDM\u72c2\u6f6e\u300b\u4e2d\u56f0\u96be\u5173\u5361\u7684\u6700\u4f73\u7b56\u7565\u5305\u62ec\u7ec3\u4e60\u3001\u65f6\u95f4\u63a7\u5236\u548c\u9053\u5177\u4f7f\u7528\u76f8\u7ed3\u5408\u3002\u6b65\u9aa41\uff1a\u91cd\u590d\u7ec3\u4e60\u5173\u5361\u591a\u6b21\uff0c\u719f\u6089\u65b9\u5757\u7684\u6a21\u5f0f\u3002\u6b65\u9aa42\uff1a\u4e13\u6ce8\u4e8e\u51c6\u786e\u8ba1\u65f6\u8df3\u8dc3\uff0c\u7279\u522b\u662f\u79fb\u52a8\u65b9\u5757\u3002\u6b65\u9aa43\uff1a\u6218\u7565\u6027\u5730\u4f7f\u7528\u9053\u5177\uff0c\u4f8b\u5982\u62a4\u76fe\u4ee5\u63d0\u4f9b\u4fdd\u62a4\uff0c\u6162\u52a8\u4f5c\u4ee5\u66f4\u597d\u5730\u63a7\u5236\u3002\u4f8b\u5982\uff0c\u5728\u6709\u8bb8\u591a\u53ef\u7834\u574f\u65b9\u5757\u7684\u5173\u5361\u4e2d\uff0c\u62a4\u76fe\u53ef\u4ee5\u4e3a\u60a8\u907f\u514d\u6389\u843d\u3002"}, {"question": "\u300a\u65b9\u5757\u8df3\u8dc3\uff1aEDM\u72c2\u6f6e\u300b\u4e2d\u7684\u8ba1\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u6700\u7ec8\u5f97\u5206\uff1f", "answer": "\u300a\u65b9\u5757\u8df3\u8dc3\uff1aEDM\u72c2\u6f6e\u300b\u7684\u8ba1\u5206\u7cfb\u7edf\u57fa\u4e8e\u6210\u529f\u8df3\u8dc3\u6b21\u6570\u3001\u7ec4\u5408\u8fde\u51fb\u548c\u7279\u6b8a\u65b9\u5757\u7740\u9646\u3002\u6bcf\u6b21\u6210\u529f\u8df3\u8dc3\u90fd\u4f1a\u5956\u52b1\u5206\u6570\uff0c\u843d\u5728\u7279\u6b8a\u65b9\u5757\uff08\u5982\u91d1\u8272\u65b9\u5757\uff09\u4e0a\u4f1a\u989d\u5916\u83b7\u5f97\u5206\u6570\u3002\u7ec4\u5408\u8fde\u51fb\u4f1a\u4f7f\u5206\u6570\u7ffb\u500d\uff0c\u56e0\u6b64\u5728\u8fde\u7eed\u843d\u5165\u591a\u4e2a\u65b9\u5757\u4e0a\u800c\u6ca1\u6709\u5931\u8bef\u7684\u60c5\u51b5\u4e0b\uff0c\u60a8\u7684\u6700\u7ec8\u5f97\u5206\u4f1a\u589e\u52a0\u3002\u4f8b\u5982\uff0c\u8fde\u7eed\u843d\u5165 5 \u4e2a\u65b9\u5757\u7684\u5206\u6570\u4f1a\u9ad8\u4e8e\u4e2d\u95f4\u6709\u51e0\u6b21\u5931\u8bef\u7684 5 \u4e2a\u65b9\u5757\u5206\u6570\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5728\u4e0d\u540c\u7684\u8bbe\u5907\u95f4\u4f20\u8f93\u300a\u65b9\u5757\u8df3\u8dc3\uff1aEDM\u72c2\u6f6e\u300b\u7684\u6e38\u620f\u8fdb\u5ea6\u5417\uff1f\u5982\u4f55\u64cd\u4f5c\uff1f", "answer": "\u662f\u7684\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u5c06\u6e38\u620f\u8d26\u6237\u94fe\u63a5\u5230\u793e\u4ea4\u5a92\u4f53\u8d26\u6237\u6216\u7535\u5b50\u90ae\u4ef6\u5730\u5740\u6765\u5728\u4e0d\u540c\u8bbe\u5907\u95f4\u4f20\u8f93\u300a\u65b9\u5757\u8df3\u8dc3\uff1aEDM\u72c2\u6f6e\u300b\u7684\u6e38\u620f\u8fdb\u5ea6\u3002\u6b65\u9aa41\uff1a\u8f6c\u5230\u6e38\u620f\u8bbe\u7f6e\u5e76\u9009\u62e9\u201c\u8d26\u6237\u201d\u9009\u9879\u3002\u6b65\u9aa42\uff1a\u9009\u62e9\u201c\u94fe\u63a5\u8d26\u6237\u201d\u529f\u80fd\u5e76\u6309\u7167\u63d0\u793a\u8fde\u63a5\u60a8\u7684\u8d26\u6237\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u76f8\u540c\u7684\u8d26\u6237\u8be6\u7ec6\u4fe1\u606f\u767b\u5f55\u60a8\u7684\u65b0\u8bbe\u5907\u3002\u4f8b\u5982\uff0c\u94fe\u63a5\u5230Facebook\u53ef\u4ee5\u786e\u4fdd\u60a8\u7684\u8fdb\u5ea6\u4fdd\u5b58\uff0c\u5e76\u5728\u4efb\u4f55\u8bbe\u5907\u4e0a\u8bbf\u95ee\u3002"}, {"question": "\u300a\u65b9\u5757\u8df3\u8dc3\uff1aEDM\u72c2\u6f6e\u300b\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u6210\u5c31\uff0c\u5982\u4f55\u89e3\u9501\u5b83\u4eec\uff1f", "answer": "\u300a\u65b9\u5757\u8df3\u8dc3\uff1aEDM\u72c2\u6f6e\u300b\u4e2d\u7684\u9690\u85cf\u6210\u5c31\u5305\u62ec\u201c\u5b8c\u7f8e\u8fde\u51fb\u201d\u3001\u201c\u901f\u5ea6\u5927\u5e08\u201d\u548c\u201c\u65b9\u5757\u5927\u5e08\u201d\u3002\u8981\u89e3\u9501\u201c\u5b8c\u7f8e\u8fde\u51fb\u201d\uff0c\u8bf7\u5728\u4e0d\u5931\u8bef\u7684\u60c5\u51b5\u4e0b\u8fde\u7eed\u8df3\u8dc3 50 \u4e2a\u65b9\u5757\u3002\u8981\u89e3\u9501\u201c\u901f\u5ea6\u5927\u5e08\u201d\uff0c\u8bf7\u4ee5\u6700\u5927\u901f\u5ea6\u500d\u589e\u5668\u5b8c\u6210\u4e00\u4e2a\u5173\u5361\u3002\u201c\u65b9\u5757\u5927\u5e08\u201d\u662f\u901a\u8fc7\u5728\u4e00\u4e2a\u6e38\u620f\u4e2d\u843d\u5728\u6240\u6709\u7c7b\u578b\u7684\u65b9\u5757\u4e0a\u800c\u83b7\u5f97\u7684\u3002\u4f8b\u5982\uff0c\u5728\u4e00\u4e2a\u6709\u79fb\u52a8\u65b9\u5757\u3001\u53ef\u7834\u574f\u65b9\u5757\u548c\u91d1\u8272\u65b9\u5757\u7684\u5173\u5361\u4e2d\uff0c\u843d\u5728\u6240\u6709\u4e09\u79cd\u7c7b\u578b\u65b9\u5757\u4e0a\u5c06\u89e3\u9501\u201c\u65b9\u5757\u5927\u5e08\u201d\u3002"}]
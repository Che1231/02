[{"question": "\u65b0\u624b\u5982\u4f55\u5f00\u59cb\u73a9\u714e\u997c\u6e38\u620f?", "answer": "\u8981\u5f00\u59cb\u73a9\u714e\u997c\u6e38\u620f\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u4ece\u60a8\u504f\u597d\u7684\u5e73\u53f0\u4e0b\u8f7d\u5e76\u5b89\u88c5\u6e38\u620f\u3002\u6b65\u9aa42 - \u5b8c\u6210\u6559\u7a0b\u4ee5\u4e86\u89e3\u57fa\u672c\u63a7\u5236\u548c\u76ee\u6807\u3002\u6b65\u9aa43 - \u4ece\u300e\u65b0\u624b\u4efb\u52a1\u300f\u5f00\u59cb\u7ec3\u4e60\u60a8\u7684\u6280\u80fd\u3002\u4f8b\u5982\uff0c\u5728\u6559\u7a0b\u4e2d\uff0c\u60a8\u5c06\u5b66\u4e60\u5982\u4f55\u4f7f\u7528\u300eF\u300f\u952e\u7ffb\u8f6c\u714e\u997c\uff0c\u8fd9\u5bf9\u4e8e\u6e38\u620f\u4e2d\u7684\u8fdb\u6b65\u81f3\u5173\u91cd\u8981\u3002\u8bf7\u8bb0\u4f4f\uff0c\u67e5\u9605\u6e38\u620f\u5185\u7684\u6307\u5357\u4ee5\u83b7\u53d6\u6280\u5de7\u548c\u7a8d\u95e8\u3002"}, {"question": "\u5728\u73a9\u714e\u997c\u6e38\u620f 100 \u5c0f\u65f6\u540e\uff0c\u638c\u63e1\u6e38\u620f\u7684\u5173\u952e\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u73a9\u4e86 100 \u5c0f\u65f6\u540e\uff0c\u8bf7\u5173\u6ce8\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9aa41 - \u901a\u8fc7\u5b8c\u7f8e\u5730\u63a7\u5236\u7ffb\u8f6c\u65f6\u673a\u6765\u4f18\u5316\u60a8\u7684\u714e\u997c\u7ffb\u8f6c\u6280\u5de7\u3002\u6b65\u9aa42 - \u5229\u7528\u4f8b\u5982\u300e\u9ec4\u91d1\u7cd6\u6d46\u300f\u4e4b\u7c7b\u7684\u9053\u5177\u6765\u6700\u5927\u5316\u5206\u6570\u3002\u6b65\u9aa43 - \u7814\u7a76\u9ad8\u7ea7\u714e\u997c\u5e8f\u5217\u7684\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u5728\u300e\u7cd6\u6d46\u98ce\u66b4\u300f\u5173\u5361\u4e2d\uff0c\u4ee5\u4e4b\u5b57\u5f62\u7ffb\u8f6c\u714e\u997c\u53ef\u4ee5\u83b7\u5f97\u66f4\u9ad8\u7684\u5206\u6570\u3002\u4f7f\u7528\u914d\u7f6e\u8868\u6765\u8ddf\u8e2a\u54ea\u4e9b\u7b56\u7565\u5728\u4e0d\u540c\u5173\u5361\u4e2d\u6548\u679c\u6700\u4f73\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u714e\u997c\u6e38\u620f\u7684\u8bc4\u5206\u7cfb\u7edf\u66f4\u770b\u91cd\u7cbe\u5ea6\u800c\u4e0d\u662f\u901f\u5ea6\uff1f", "answer": "\u714e\u997c\u6e38\u620f\u7684\u8bc4\u5206\u7cfb\u7edf\u5f3a\u8c03\u7cbe\u5ea6\uff0c\u56e0\u4e3a\u5b83\u5956\u52b1\u73a9\u5bb6\u51c6\u786e\u7684\u7ffb\u8f6c\u52a8\u4f5c\uff0c\u800c\u4e0d\u662f\u5feb\u901f\u4e14\u7c97\u5fc3\u7684\u52a8\u4f5c\u3002\u4f8b\u5982\uff0c\u5728\u300e\u7cbe\u786e\u6311\u6218\u300f\u5173\u5361\u4e2d\uff0c\u4e00\u4e2a\u5b8c\u7f8e\u7ffb\u8f6c\u7684\u714e\u997c\u53ef\u4ee5\u83b7\u5f97 100 \u5206\uff0c\u800c\u5306\u5fd9\u7684\u7ffb\u8f6c\u52a8\u4f5c\u53ef\u80fd\u53ea\u80fd\u83b7\u5f97 50 \u5206\u3002\u8fd9\u4e2a\u7cfb\u7edf\u9f13\u52b1\u73a9\u5bb6\u57f9\u517b\u6280\u5de7\u548c\u7cbe\u7ec6\u5ea6\uff0c\u4f7f\u6e38\u620f\u66f4\u5177\u5438\u5f15\u529b\u548c\u5956\u52b1\u6027\u3002\u8bf7\u53c2\u8003\u6e38\u620f\u624b\u518c\u4e2d\u7684\u8bc4\u5206\u6d41\u7a0b\u56fe\uff0c\u4ee5\u83b7\u5f97\u8be6\u7ec6\u7684\u8bf4\u660e\u3002"}, {"question": "\u54ea\u4e9b\u5e73\u53f0\u652f\u6301\u714e\u997c\u6e38\u620f\uff0c\u4ee5\u53ca\u8de8\u5e73\u53f0\u6e38\u620f\u5982\u4f55\u8fd0\u4f5c\uff1f", "answer": "\u714e\u997c\u6e38\u620f\u53ef\u5728 PC\u3001Mac \u548c\u79fb\u52a8\u8bbe\u5907\u4e0a\u4f7f\u7528\u3002\u8de8\u5e73\u53f0\u6e38\u620f\u901a\u8fc7\u7edf\u4e00\u7684\u8d26\u6237\u7cfb\u7edf\u5b9e\u73b0\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728 PC \u4e0a\u5f00\u59cb\u6e38\u620f\uff0c\u5219\u53ef\u4ee5\u901a\u8fc7\u767b\u5f55\u540c\u4e00\u8d26\u6237\u7ee7\u7eed\u60a8\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\u7684\u8fdb\u5ea6\u3002\u786e\u4fdd\u6240\u6709\u5e73\u53f0\u7684\u6e38\u620f\u7248\u672c\u90fd\u5df2\u66f4\u65b0\uff0c\u4ee5\u907f\u514d\u517c\u5bb9\u6027\u95ee\u9898\u3002\u5b98\u65b9\u714e\u997c\u6e38\u620f\u7f51\u7ad9\u4e0a\u63d0\u4f9b\u517c\u5bb9\u6027\u8868\u683c\uff0c\u4ee5\u83b7\u53d6\u8be6\u7ec6\u7684\u4fe1\u606f\u3002"}, {"question": "\u714e\u997c\u6e38\u620f\u4e2d\u54ea\u4e9b\u9690\u85cf\u5185\u5bb9\u53ef\u4ee5\u88ab\u53d1\u73b0\uff0c\u4ee5\u53ca\u5982\u4f55\u53d1\u73b0\u5b83\u4eec\uff1f", "answer": "\u714e\u997c\u6e38\u620f\u5305\u542b\u9690\u85cf\u5185\u5bb9\uff0c\u4f8b\u5982\u9690\u85cf\u5173\u5361\u548c\u7a00\u6709\u714e\u997c\u8bbe\u8ba1\u3002\u4e3a\u4e86\u53d1\u73b0\u8fd9\u4e9b\u5185\u5bb9\uff0c\u8bf7\u63a2\u7d22\u6e38\u620f\u4e16\u754c\u7684\u6bcf\u4e00\u4e2a\u89d2\u843d\u5e76\u5b8c\u6210\u7279\u5b9a\u7684\u6311\u6218\u3002\u4f8b\u5982\uff0c\u5728\u300e\u795e\u79d8\u53a8\u623f\u300f\u5173\u5361\u4e2d\uff0c\u627e\u5230\u6240\u6709\u9690\u85cf\u7684\u7cd6\u6d46\u74f6\u53ef\u4ee5\u89e3\u9501\u4e00\u4e2a\u79d8\u5bc6\u714e\u997c\u98df\u8c31\u3002\u4f7f\u7528\u6e38\u620f\u5730\u56fe\u6765\u8ddf\u8e2a\u60a8\u7684\u8fdb\u5ea6\uff0c\u5e76\u786e\u4fdd\u60a8\u4e0d\u4f1a\u9519\u8fc7\u4efb\u4f55\u9690\u85cf\u5143\u7d20\u3002\u793e\u533a\u8bba\u575b\u4e2d\u63d0\u4f9b\u4e86\u4e00\u4efd\u9010\u6b65\u6307\u5357\uff0c\u7528\u4e8e\u53d1\u73b0\u9690\u85cf\u5185\u5bb9\u3002"}, {"question": "\u714e\u997c\u6e38\u620f\u7684\u714e\u997c\u7ffb\u8f6c\u673a\u5236\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u714e\u997c\u6e38\u620f\u7684\u714e\u997c\u7ffb\u8f6c\u673a\u5236\u6d89\u53ca\u4f7f\u7528\u300eF\u300f\u952e\u5728\u9002\u5f53\u7684\u65f6\u673a\u7ffb\u8f6c\u714e\u997c\u3002\u65f6\u673a\u81f3\u5173\u91cd\u8981\uff1b\u8fc7\u65e9\u6216\u8fc7\u665a\u7684\u7ffb\u8f6c\u4f1a\u5bfc\u81f4\u5206\u6570\u964d\u4f4e\u3002\u4f8b\u5982\uff0c\u5728\u300e\u8ba1\u65f6\u7ffb\u8f6c\u300f\u5173\u5361\u4e2d\uff0c\u5728\u714e\u997c\u5230\u8fbe\u5176\u5f27\u5f62\u9876\u70b9\u7684\u65f6\u523b\u7ffb\u8f6c\u714e\u997c\u53ef\u4ee5\u83b7\u5f97\u6700\u9ad8\u5206\u6570\u3002\u8bf7\u5728\u6559\u7a0b\u4e2d\u7ec3\u4e60\u6b64\u673a\u5236\uff0c\u4ee5\u4e86\u89e3\u65f6\u673a\u7684\u638c\u63e1\u3002\u6e38\u620f\u4e2d\u5e2e\u52a9\u90e8\u5206\u7684\u8ba1\u65f6\u56fe\u63d0\u4f9b\u989d\u5916\u7684\u89c6\u89c9\u6307\u5bfc\u3002"}, {"question": "\u5728\u714e\u997c\u6e38\u620f\u4e2d\uff0c\u54ea\u4e9b\u9053\u5177\u6700\u9002\u5408\u4f7f\u7528\uff0c\u4ee5\u53ca\u5728\u4f55\u65f6\u4f7f\u7528\uff1f", "answer": "\u714e\u997c\u6e38\u620f\u4e2d\u7684\u6700\u4f73\u9053\u5177\u5305\u62ec\u300e\u9ec4\u91d1\u7cd6\u6d46\u300f\uff08\u7528\u4e8e\u5206\u6570\u63d0\u5347\uff09\u548c\u300e\u5feb\u901f\u7ffb\u8f6c\u300f\uff08\u7528\u4e8e\u66f4\u5feb\u7ffb\u8f6c\uff09\u3002\u5728\u9ad8\u5206\u673a\u4f1a\uff08\u4f8b\u5982\u300e\u7cd6\u6d46\u6fc0\u589e\u300f\u5173\u5361\uff09\u671f\u95f4\u4f7f\u7528\u300e\u9ec4\u91d1\u7cd6\u6d46\u300f\uff0c\u4ee5\u6700\u5927\u5316\u60a8\u7684\u5206\u6570\u3002\u300e\u5feb\u901f\u7ffb\u8f6c\u300f\u975e\u5e38\u9002\u5408\u65f6\u95f4\u654f\u611f\u7684\u6311\u6218\uff08\u4f8b\u5982\u300e\u5feb\u901f\u7ffb\u8f6c\u300f\u5173\u5361\uff09\u3002\u4f7f\u7528\u6e38\u620f\u5185\u9053\u5177\u6bd4\u8f83\u56fe\u8868\u6bd4\u8f83\u9053\u5177\u7684\u6709\u6548\u6027\uff0c\u4ee5\u6709\u6548\u5730\u5236\u5b9a\u7b56\u7565\u3002"}, {"question": "\u5982\u4f55\u5728\u714e\u997c\u6e38\u620f\u4e2d\u63d0\u5347\u6211\u7684\u9ad8\u5206\uff1f", "answer": "\u8981\u63d0\u9ad8\u714e\u997c\u6e38\u620f\u4e2d\u7684\u9ad8\u5206\uff0c\u8bf7\u4e13\u6ce8\u4e8e\u5b8c\u5584\u60a8\u7684\u7ffb\u8f6c\u65f6\u673a\u5e76\u6709\u7b56\u7565\u5730\u4f7f\u7528\u9053\u5177\u3002\u4f8b\u5982\uff0c\u5728\u300e\u9ad8\u5206\u72e9\u730e\u300f\u5173\u5361\u4e2d\uff0c\u5c06\u300e\u9ec4\u91d1\u7cd6\u6d46\u300f\u4e0e\u7cbe\u786e\u7684\u7ffb\u8f6c\u7ed3\u5408\u4f7f\u7528\u53ef\u4ee5\u663e\u8457\u63d0\u5347\u60a8\u7684\u5206\u6570\u3002\u6b64\u5916\uff0c\u8bf7\u7814\u7a76\u6392\u884c\u699c\u4e2d\u9876\u7ea7\u73a9\u5bb6\u7684\u8bc4\u5206\u6a21\u5f0f\u3002\u9075\u5faa\u5206\u6b65\u7ec3\u4e60\u7a0b\u5e8f\uff0c\u4ee5\u4e0d\u65ad\u63d0\u9ad8\u60a8\u7684\u6280\u80fd\u5e76\u7a33\u5b9a\u63d0\u9ad8\u5206\u6570\u3002"}, {"question": "\u714e\u997c\u6e38\u620f\u4e2d\u6709\u54ea\u4e9b\u4e0d\u540c\u7684\u6e38\u620f\u6a21\u5f0f\uff1f", "answer": "\u714e\u997c\u6e38\u620f\u63d0\u4f9b\u591a\u79cd\u6a21\u5f0f\uff0c\u5305\u62ec\u300e\u6545\u4e8b\u6a21\u5f0f\u300f\u3001\u300e\u6311\u6218\u6a21\u5f0f\u300f\u548c\u300e\u65e0\u9650\u6a21\u5f0f\u300f\u3002\u300e\u6545\u4e8b\u6a21\u5f0f\u300f\u8bb2\u8ff0\u4e00\u4e2a\u5177\u6709\u7279\u5b9a\u76ee\u6807\u7684\u6545\u4e8b\uff0c\u4f8b\u5982\u5b8c\u6210\u300e\u4f1f\u5927\u714e\u997c\u4efb\u52a1\u300f\u3002\u300e\u6311\u6218\u6a21\u5f0f\u300f\u901a\u8fc7\u8ba1\u65f6\u548c\u7cbe\u786e\u4efb\u52a1\u6d4b\u8bd5\u60a8\u7684\u6280\u80fd\uff0c\u4f8b\u5982\u300e\u7ffb\u8f6c\u72c2\u6f6e\u300f\u6311\u6218\u3002\u300e\u65e0\u9650\u6a21\u5f0f\u300f\u5141\u8bb8\u60a8\u65e0\u9650\u7ffb\u8f6c\u714e\u997c\u4ee5\u83b7\u5f97\u6700\u9ad8\u5206\u3002\u8bf7\u53c2\u8003\u6e38\u620f\u6a21\u5f0f\u6d41\u7a0b\u56fe\u4ee5\u4e86\u89e3\u6bcf\u79cd\u6a21\u5f0f\u7684\u76ee\u6807\u548c\u5956\u52b1\u3002"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684\u714e\u997c\u6e38\u620f\u8fdb\u5ea6\u8f6c\u79fb\u5230\u65b0\u8bbe\u5907\uff1f", "answer": "\u8981\u8f6c\u79fb\u60a8\u7684\u714e\u997c\u6e38\u620f\u8fdb\u5ea6\uff0c\u8bf7\u786e\u4fdd\u60a8\u5728\u4e24\u53f0\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u8d26\u6237\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u8981\u5c06\u8fdb\u5ea6\u4ece PC \u79fb\u52a8\u5230\u79fb\u52a8\u8bbe\u5907\uff0c\u8bf7\u4f7f\u7528\u60a8\u7684\u73b0\u6709\u8d26\u6237\u51ed\u636e\u767b\u5f55\u3002\u60a8\u7684\u8fdb\u5ea6\uff0c\u5305\u62ec\u9ad8\u5206\u548c\u5df2\u89e3\u9501\u7684\u5185\u5bb9\uff0c\u5c06\u81ea\u52a8\u540c\u6b65\u3002\u8bf7\u67e5\u9605\u5b98\u65b9\u714e\u997c\u6e38\u620f\u652f\u6301\u9875\u9762\uff0c\u4ee5\u83b7\u53d6\u6709\u5173\u6570\u636e\u8fc1\u79fb\u548c\u6545\u969c\u6392\u9664\u6280\u5de7\u7684\u8be6\u7ec6\u6307\u5357\u3002"}]
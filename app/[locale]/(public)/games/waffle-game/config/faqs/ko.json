[{"question": "\uc640\ud50c \uac8c\uc784 \ucd08\ubcf4\uc790\ub294 \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc640\ud50c \uac8c\uc784\uc744 \uc2dc\uc791\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1 - \uc6d0\ud558\ub294 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uac8c\uc784\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uace0 \uc124\uce58\ud569\ub2c8\ub2e4. STEP2 - \uae30\ubcf8 \ucee8\ud2b8\ub864\uacfc \ubaa9\ud45c\ub97c \uc774\ud574\ud558\uae30 \uc704\ud574 \ud29c\ud1a0\ub9ac\uc5bc\uc744 \uc644\ub8cc\ud569\ub2c8\ub2e4. STEP3 - \uc219\ub828\ub3c4\ub97c \uc5f0\uc2b5\ud558\uae30 \uc704\ud574 '\ucd08\ubcf4\uc790 \ud018\uc2a4\ud2b8'\ub97c \uc2dc\uc791\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud29c\ud1a0\ub9ac\uc5bc\uc5d0\uc11c\ub294 \uac8c\uc784 \uc9c4\ud589\uc5d0 \ud544\uc218\uc801\uc778 'F' \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc640\ud50c\uc744 \ub4a4\uc9d1\ub294 \ubc29\ubc95\uc744 \ubc30\uc6c1\ub2c8\ub2e4. \ud301\uacfc \uc694\ub839\uc740 \uac8c\uc784 \ub0b4 \uac00\uc774\ub4dc\ub97c \ucc38\uc870\ud558\uc2ed\uc2dc\uc624."}, {"question": "100\uc2dc\uac04 \ud50c\ub808\uc774 \ud6c4 \uc640\ud50c \uac8c\uc784 \ub9c8\uc2a4\ud130\ud558\uae30 \uc704\ud55c \uc8fc\uc694 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "100\uc2dc\uac04 \ud50c\ub808\uc774 \ud6c4, \ub2e4\uc74c \uc804\ub7b5\uc5d0 \uc9d1\uc911\ud558\uc138\uc694: STEP1 - \uc640\ud50c \ub4a4\uc9d1\ub294 \uae30\uc220\uc744 \ucd5c\uc801\ud654\ud558\uc5ec \ub4a4\uc9d1\ub294 \ud0c0\uc774\ubc0d\uc744 \uc644\ubcbd\ud558\uac8c \uc870\uc808\ud569\ub2c8\ub2e4. STEP2 - '\ud669\uae08 \uc2dc\ub7fd'\uacfc \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \ud65c\uc6a9\ud558\uc5ec \uc810\uc218\ub97c \uadf9\ub300\ud654\ud569\ub2c8\ub2e4. STEP3 - \uace0\ub09c\uc774\ub3c4 \uc640\ud50c \uc2dc\ud000\uc2a4 \ud328\ud134\uc744 \uc5f0\uad6c\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc2dc\ub7fd \ud3ed\ud48d' \ub808\ubca8\uc5d0\uc11c \uc9c0\uadf8\uc7ac\uadf8 \ud328\ud134\uc73c\ub85c \uc640\ud50c\uc744 \ub4a4\uc9d1\uc73c\uba74 \ub354 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc5b4\ub5a4 \uc804\ub7b5\uc774 \uc5b4\ub5a4 \ub808\ubca8\uc5d0\uc11c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778\uc9c0 \ucd94\uc801\ud558\uae30 \uc704\ud574 \uad6c\uc131\ud45c\ub97c \uc0ac\uc6a9\ud558\uc138\uc694."}, {"question": "\uc640\ud50c \uac8c\uc784\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc774 \uc18d\ub3c4\ubcf4\ub2e4 \uc815\ud655\uc131\uc744 \uc911\uc2dc\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc640\ud50c \uac8c\uc784\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ube60\ub974\uace0 \ubd80\uc8fc\uc758\ud55c \ud589\ub3d9\ubcf4\ub2e4\ub294 \uc815\ud655\ud55c \ub4a4\uc9d1\uae30\uc5d0 \ub300\ud55c \ubcf4\uc0c1\uc744 \uc8fc\uae30 \ub54c\ubb38\uc5d0 \uc815\ud655\uc131\uc744 \uac15\uc870\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc815\ud655\uc131 \ucc4c\ub9b0\uc9c0' \ub808\ubca8\uc5d0\uc11c \uc644\ubcbd\ud558\uac8c \ub4a4\uc9d1\uc740 \uc640\ud50c\uc740 100\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc9c0\ub9cc, \uc11c\ub450\ub978 \ub4a4\uc9d1\uae30\ub294 50\uc810 \uc815\ub3c4\ubc16\uc5d0 \ubc1b\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uae30\uc220\uacfc \uc815\uad50\ud568\uc744 \uac1c\ubc1c\ud558\ub3c4\ub85d \uc7a5\ub824\ud558\uc5ec \uac8c\uc784\uc744 \ub354\uc6b1 \ub9e4\ub825\uc801\uc774\uace0 \ubcf4\ub78c \uc788\uac8c \ub9cc\ub4ed\ub2c8\ub2e4. \uc790\uc138\ud55c \ub0b4\uc6a9\uc740 \uac8c\uc784 \uc124\uba85\uc11c\uc758 \uc810\uc218 \ud50c\ub85c\uc6b0\ucc28\ud2b8\ub97c \ucc38\uc870\ud558\uc2ed\uc2dc\uc624."}, {"question": "\uc640\ud50c \uac8c\uc784\uc740 \uc5b4\ub5a4 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc9c0\uc6d0\ub418\uba70, \ud50c\ub7ab\ud3fc \uac04 \ud50c\ub808\uc774\ub294 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "\uc640\ud50c \uac8c\uc784\uc740 PC, Mac \ubc0f \ubaa8\ubc14\uc77c \uae30\uae30\uc5d0\uc11c \uc774\uc6a9 \uac00\ub2a5\ud569\ub2c8\ub2e4. \ud50c\ub7ab\ud3fc \uac04 \ud50c\ub808\uc774\ub294 \ud1b5\ud569 \uacc4\uc815 \uc2dc\uc2a4\ud15c\uc744 \ud1b5\ud574 \uc774\ub8e8\uc5b4\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \uac8c\uc784\uc744 \uc2dc\uc791\ud558\uba74 \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uc5ec \ubaa8\ubc14\uc77c \uae30\uae30\uc5d0\uc11c \uac8c\uc784 \uc9c4\ud589\uc744 \uacc4\uc18d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud638\ud658\uc131 \ubb38\uc81c\ub97c \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \ubaa8\ub4e0 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uac8c\uc784 \ubc84\uc804\uc774 \ucd5c\uc2e0 \ubc84\uc804\uc778\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uc790\uc138\ud55c \ub0b4\uc6a9\uc740 \uacf5\uc2dd \uc640\ud50c \uac8c\uc784 \uc6f9\uc0ac\uc774\ud2b8\uc758 \ud638\ud658\uc131 \ud45c\ub97c \ucc38\uace0\ud558\uc2ed\uc2dc\uc624."}, {"question": "\uc640\ud50c \uac8c\uc784\uc5d0\uc11c \uc5b4\ub5a4 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \ubc1c\uacac\ud560 \uc218 \uc788\uc73c\uba70, \uc5b4\ub5bb\uac8c \ubc1c\uacac\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc640\ud50c \uac8c\uc784\uc5d0\ub294 \ube44\ubc00 \ub808\ubca8\uacfc \ud76c\uadc0 \uc640\ud50c \ub514\uc790\uc778\uacfc \uac19\uc740 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ucf58\ud150\uce20\ub97c \ubc1c\uacac\ud558\ub824\uba74 \uac8c\uc784 \uc138\uacc4\uc758 \ubaa8\ub4e0 \uad6c\uc11d\uc744 \ud0d0\ud5d8\ud558\uace0 \ud2b9\uc815 \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ubbf8\uc2a4\ud130\ub9ac \uc8fc\ubc29' \ub808\ubca8\uc5d0\uc11c \ubaa8\ub4e0 \uc228\uaca8\uc9c4 \uc2dc\ub7fd\ubcd1\uc744 \ucc3e\uc73c\uba74 \ube44\ubc00 \uc640\ud50c \ub808\uc2dc\ud53c\ub97c \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc9c4\ud589 \uc0c1\ud669\uc744 \ucd94\uc801\ud558\uace0 \uc228\uaca8\uc9c4 \uc694\uc18c\ub97c \ub193\uce58\uc9c0 \uc54a\ub3c4\ub85d \uac8c\uc784 \ub0b4 \uc9c0\ub3c4\ub97c \uc0ac\uc6a9\ud558\uc138\uc694. \uc228\uaca8\uc9c4 \ucf58\ud150\uce20 \ubc1c\uacac\uc5d0 \ub300\ud55c \ub2e8\uacc4\ubcc4 \uac00\uc774\ub4dc\ub294 \ucee4\ubba4\ub2c8\ud2f0 \ud3ec\ub7fc\uc5d0\uc11c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc640\ud50c \uac8c\uc784\uc5d0\uc11c \uc640\ud50c \ub4a4\uc9d1\uae30 \uba54\ucee4\ub2c8\uc998\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "\uc640\ud50c \uac8c\uc784\uc758 \uc640\ud50c \ub4a4\uc9d1\uae30 \uba54\ucee4\ub2c8\uc998\uc740 \uc801\uc808\ud55c \uc2dc\uc810\uc5d0 'F' \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc640\ud50c\uc744 \ub4a4\uc9d1\ub294 \uac83\uc785\ub2c8\ub2e4. \ud0c0\uc774\ubc0d\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \ub108\ubb34 \uc77c\ucc0d \ub610\ub294 \ub108\ubb34 \ub2a6\uac8c \ub4a4\uc9d1\uc73c\uba74 \uc810\uc218\uac00 \ub0ae\uc544\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud0c0\uc774\ubc0d \ub4a4\uc9d1\uae30' \ub808\ubca8\uc5d0\uc11c \uc640\ud50c\uc774 \ucd5c\uace0\uc810\uc5d0 \ub3c4\ub2ec\ud588\uc744 \ub54c \ub4a4\uc9d1\uc73c\uba74 \ucd5c\ub300 \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud29c\ud1a0\ub9ac\uc5bc\uc5d0\uc11c \uc774 \uba54\ucee4\ub2c8\uc998\uc744 \uc5f0\uc2b5\ud558\uc5ec \ud0c0\uc774\ubc0d \uac10\uac01\uc744 \uc775\ud788\uc138\uc694. \uac8c\uc784 \ub3c4\uc6c0\ub9d0 \uc139\uc158\uc758 \ud0c0\uc774\ubc0d \ub2e4\uc774\uc5b4\uadf8\ub7a8\uc740 \ucd94\uac00\uc801\uc778 \uc2dc\uac01\uc801 \uc548\ub0b4\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4."}, {"question": "\uc640\ud50c \uac8c\uc784\uc5d0\uc11c \uc0ac\uc6a9\ud560 \ucd5c\uace0\uc758 \ud30c\uc6cc\uc5c5\uacfc \uc5b8\uc81c \uc0ac\uc6a9\ud574\uc57c \ud558\ub098\uc694?", "answer": "\uc640\ud50c \uac8c\uc784\uc5d0\uc11c \uac00\uc7a5 \uc88b\uc740 \ud30c\uc6cc\uc5c5\uc5d0\ub294 \uc810\uc218\ub97c \ub192\uc774\ub294 '\ud669\uae08 \uc2dc\ub7fd'\uacfc \ub4a4\uc9d1\ub294 \uc18d\ub3c4\ub97c \ub192\uc774\ub294 '\uc18d\ub3c4 \ub4a4\uc9d1\uae30'\uac00 \uc788\uc2b5\ub2c8\ub2e4. '\ud669\uae08 \uc2dc\ub7fd'\uc740 '\uc2dc\ub7fd \uae09\uc99d' \ub808\ubca8\uacfc \uac19\uc774 \ub192\uc740 \uc810\uc218 \ud68d\ub4dd \uae30\ud68c\uac00 \uc788\ub294 \ub3d9\uc548 \uc0ac\uc6a9\ud558\uc5ec \uc810\uc218\ub97c \uadf9\ub300\ud654\ud558\uc138\uc694. '\uc18d\ub3c4 \ub4a4\uc9d1\uae30'\ub294 '\ube60\ub978 \ub4a4\uc9d1\uae30' \ub808\ubca8\uacfc \uac19\uc740 \uc2dc\uac04 \uc81c\ud55c \ucc4c\ub9b0\uc9c0\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4. \ud6a8\uacfc\uc801\uc778 \uc804\ub7b5\uc744 \uc138\uc6b0\uae30 \uc704\ud574 \uac8c\uc784 \ub0b4 \ud30c\uc6cc\uc5c5 \ube44\uad50 \ucc28\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud30c\uc6cc\uc5c5 \ud6a8\uacfc\ub97c \ube44\uad50\ud558\uc138\uc694."}, {"question": "\uc640\ud50c \uac8c\uc784\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\ub098\uc694?", "answer": "\uc640\ud50c \uac8c\uc784\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\ub824\uba74 \ub4a4\uc9d1\uae30 \ud0c0\uc774\ubc0d\uc744 \uc644\ubcbd\ud558\uac8c \ud558\uace0 \ud30c\uc6cc\uc5c5\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\ub192\uc740 \uc810\uc218 \uc0ac\ub0e5' \ub808\ubca8\uc5d0\uc11c '\ud669\uae08 \uc2dc\ub7fd'\uacfc \uc815\ud655\ud55c \ub4a4\uc9d1\uae30\ub97c \uacb0\ud569\ud558\uba74 \uc810\uc218\uac00 \ud06c\uac8c \uc0c1\uc2b9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \ub7ad\ud0b9\uc5d0\uc11c \ucd5c\uace0 \ud50c\ub808\uc774\uc5b4\uc758 \uc810\uc218 \ud328\ud134\uc744 \uc5f0\uad6c \u06a9\u0646\u06cc\u062f. \uc219\ub828\ub3c4\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\uace0 \uc810\uc218\ub97c \uafb8\uc900\ud788 \ub192\uc774\uae30 \uc704\ud55c \ub2e8\uacc4\ubcc4 \uc5f0\uc2b5 \ub8e8\ud2f4\uc744 \ub530\ub974\uc138\uc694."}, {"question": "\uc640\ud50c \uac8c\uc784\uc5d0\uc11c \uc81c\uacf5\ub418\ub294 \ub2e4\uc591\ud55c \uac8c\uc784 \ubaa8\ub4dc\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc640\ud50c \uac8c\uc784\uc5d0\ub294 '\uc2a4\ud1a0\ub9ac \ubaa8\ub4dc', '\ucc4c\ub9b0\uc9c0 \ubaa8\ub4dc' \ubc0f '\ubb34\ud55c \ubaa8\ub4dc' \ub4f1 \uc5ec\ub7ec \uac00\uc9c0 \ubaa8\ub4dc\uac00 \uc788\uc2b5\ub2c8\ub2e4. '\uc2a4\ud1a0\ub9ac \ubaa8\ub4dc'\ub294 '\uc704\ub300\ud55c \uc640\ud50c \ud018\uc2a4\ud2b8'\uc640 \uac19\uc774 \ud2b9\uc815 \ubaa9\ud45c\uac00 \uc788\ub294 \uc774\uc57c\uae30\ub97c \ub530\ub985\ub2c8\ub2e4. '\ucc4c\ub9b0\uc9c0 \ubaa8\ub4dc'\ub294 '\ub4a4\uc9d1\uae30 \uad11\uae30' \ucc4c\ub9b0\uc9c0\uc640 \uac19\uc774 \uc2dc\uac04 \uc81c\ud55c \ubc0f \uc815\ud655\uc131 \uae30\ubc18\uc758 \uacfc\uc81c\ub85c \uc219\ub828\ub3c4\ub97c \uc2dc\ud5d8\ud569\ub2c8\ub2e4. '\ubb34\ud55c \ubaa8\ub4dc'\ub294 \ucd5c\uace0 \uc810\uc218\ub97c \uc5bb\uae30 \uc704\ud574 \ubb34\ud55c\ud788 \uc640\ud50c\uc744 \ub4a4\uc9d1\uc744 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. \uac01 \ubaa8\ub4dc\uc758 \ubaa9\ud45c\uc640 \ubcf4\uc0c1\uc744 \uc774\ud574\ud558\ub824\uba74 \uac8c\uc784 \ubaa8\ub4dc \ud50c\ub85c\uc6b0\ucc28\ud2b8\ub97c \ucc38\uc870\ud558\uc138\uc694."}, {"question": "\uc0c8\ub85c\uc6b4 \uae30\uae30\uc5d0 \uc640\ud50c \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc640\ud50c \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\ub824\uba74 \ub450 \uae30\uae30 \ubaa8\ub450\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 PC\uc5d0\uc11c \ubaa8\ubc14\uc77c \uae30\uae30\ub85c \uc774\ub3d9\ud558\ub294 \uacbd\uc6b0 \uae30\uc874 \uacc4\uc815 \uc790\uaca9 \uc99d\uba85\uc73c\ub85c \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. \ub192\uc740 \uc810\uc218\uc640 \uc7a0\uae08 \ud574\uc81c\ub41c \ucf58\ud150\uce20\ub97c \ud3ec\ud568\ud55c \uc9c4\ud589 \uc0c1\ud669\uc740 \uc790\ub3d9\uc73c\ub85c \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. \uc790\uc138\ud55c \uc815\ubcf4\uc640 \ubb38\uc81c \ud574\uacb0 \ud301\uc740 \uacf5\uc2dd \uc640\ud50c \uac8c\uc784 \uc9c0\uc6d0 \ud398\uc774\uc9c0\ub97c \ucc38\uace0\ud558\uc138\uc694."}]
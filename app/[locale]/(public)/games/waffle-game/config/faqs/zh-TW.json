[{"question": "\u521d\u5b78\u8005\u5982\u4f55\u958b\u59cb\u73a9\u83ef\u592b\u9905\u904a\u6232\uff1f", "answer": "\u958b\u59cb\u73a9\u83ef\u592b\u9905\u904a\u6232\uff0c\u8acb\u6309\u7167\u9019\u4e9b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u5f9e\u60a8\u559c\u611b\u7684\u5e73\u53f0\u4e0b\u8f09\u4e26\u5b89\u88dd\u904a\u6232\u3002\u6b65\u9a5f2 - \u5b8c\u6210\u6559\u5b78\uff0c\u4e86\u89e3\u57fa\u672c\u63a7\u5236\u548c\u76ee\u6a19\u3002\u6b65\u9a5f3 - \u5f9e\u300e\u65b0\u624b\u4efb\u52d9\u300f\u958b\u59cb\u7df4\u7fd2\u60a8\u7684\u6280\u80fd\u3002\u4f8b\u5982\uff0c\u5728\u6559\u5b78\u4e2d\uff0c\u60a8\u5c07\u5b78\u7fd2\u5982\u4f55\u4f7f\u7528\u300eF\u300f\u9375\u7ffb\u8f49\u83ef\u592b\u9905\uff0c\u9019\u5c0d\u65bc\u904a\u6232\u7684\u9032\u5c55\u81f3\u95dc\u91cd\u8981\u3002\u8acb\u8a18\u4f4f\u67e5\u770b\u904a\u6232\u5167\u6307\u5357\u4ee5\u7372\u5f97\u6280\u5de7\u548c\u8a23\u7ac5\u3002"}, {"question": "\u73a9\u83ef\u592b\u9905\u904a\u6232 100 \u5c0f\u6642\u5f8c\uff0c\u638c\u63e1\u904a\u6232\u7684\u95dc\u9375\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u73a9 100 \u5c0f\u6642\u5f8c\uff0c\u8acb\u5c08\u6ce8\u65bc\u9019\u4e9b\u7b56\u7565\uff1a\u6b65\u9a5f1 - \u900f\u904e\u7cbe\u78ba\u638c\u63e1\u7ffb\u8f49\u6642\u9593\u4f86\u512a\u5316\u60a8\u7684\u83ef\u592b\u9905\u7ffb\u8f49\u6280\u5de7\u3002\u6b65\u9a5f2 - \u5229\u7528\u50cf\u662f\u300e\u9ec3\u91d1\u7cd6\u6f3f\u300f\u7b49\u589e\u76ca\u9053\u5177\u4f86\u6700\u5927\u5316\u5f97\u5206\u3002\u6b65\u9a5f3 - \u7814\u7a76\u9ad8\u968e\u83ef\u592b\u9905\u5e8f\u5217\u7684\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u5728\u300e\u7cd6\u6f3f\u66b4\u98a8\u96e8\u300f\u95dc\u5361\u4e2d\uff0c\u4ee5\u4e4b\u5b57\u5f62\u6a21\u5f0f\u7ffb\u8f49\u83ef\u592b\u9905\u53ef\u4ee5\u7372\u5f97\u66f4\u9ad8\u7684\u5206\u6578\u3002\u4f7f\u7528\u914d\u7f6e\u8868\u4f86\u8ffd\u8e64\u54ea\u4e9b\u7b56\u7565\u5728\u4e0d\u540c\u7684\u95dc\u5361\u6700\u6709\u6548\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u83ef\u592b\u9905\u904a\u6232\u7684\u8a08\u5206\u7cfb\u7d71\u91cd\u8996\u7cbe\u78ba\u5ea6\u800c\u4e0d\u662f\u901f\u5ea6\uff1f", "answer": "\u83ef\u592b\u9905\u904a\u6232\u7684\u8a08\u5206\u7cfb\u7d71\u5f37\u8abf\u7cbe\u78ba\u5ea6\uff0c\u56e0\u70ba\u5b83\u734e\u52f5\u73a9\u5bb6\u7cbe\u78ba\u7684\u7ffb\u8f49\u52d5\u4f5c\uff0c\u800c\u4e0d\u662f\u5feb\u901f\u800c\u7c97\u5fc3\u7684\u5927\u52d5\u4f5c\u3002\u4f8b\u5982\uff0c\u5728\u300e\u7cbe\u6e96\u6311\u6230\u300f\u95dc\u5361\u4e2d\uff0c\u5b8c\u7f8e\u7ffb\u8f49\u7684\u83ef\u592b\u9905\u53ef\u4ee5\u7372\u5f97 100 \u5206\uff0c\u800c\u5306\u5fd9\u7684\u7ffb\u8f49\u52d5\u4f5c\u53ef\u80fd\u53ea\u7d66\u60a8 50 \u5206\u3002\u9019\u500b\u7cfb\u7d71\u9f13\u52f5\u73a9\u5bb6\u57f9\u990a\u6280\u5de7\u548c\u7cbe\u7d30\u5ea6\uff0c\u8b93\u904a\u6232\u66f4\u5177\u5438\u5f15\u529b\u548c\u734e\u52f5\u6027\u3002\u8acb\u53c3\u8003\u904a\u6232\u8aaa\u660e\u624b\u518a\u4e2d\u7684\u8a08\u5206\u6d41\u7a0b\u5716\uff0c\u8a73\u7d30\u4e86\u89e3\u8a08\u5206\u898f\u5247\u3002"}, {"question": "\u54ea\u4e9b\u5e73\u53f0\u652f\u63f4\u83ef\u592b\u9905\u904a\u6232\uff0c\u4ee5\u53ca\u8de8\u5e73\u53f0\u904a\u73a9\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u83ef\u592b\u9905\u904a\u6232\u53ef\u5728\u96fb\u8166\u3001Mac \u548c\u884c\u52d5\u88dd\u7f6e\u4e0a\u904a\u73a9\u3002\u8de8\u5e73\u53f0\u904a\u73a9\u900f\u904e\u7d71\u4e00\u7684\u5e33\u6236\u7cfb\u7d71\u5be6\u73fe\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u96fb\u8166\u4e0a\u958b\u59cb\u904a\u6232\uff0c\u60a8\u53ef\u4ee5\u900f\u904e\u767b\u5165\u540c\u4e00\u5e33\u6236\u7e7c\u7e8c\u5728\u884c\u52d5\u88dd\u7f6e\u4e0a\u904a\u73a9\u3002\u8acb\u78ba\u4fdd\u6240\u6709\u5e73\u53f0\u7684\u904a\u6232\u7248\u672c\u7686\u70ba\u6700\u65b0\u7248\u672c\uff0c\u4ee5\u907f\u514d\u76f8\u5bb9\u6027\u554f\u984c\u3002\u5b98\u65b9\u83ef\u592b\u9905\u904a\u6232\u7db2\u7ad9\u63d0\u4f9b\u8a73\u7d30\u8cc7\u8a0a\u7684\u76f8\u5bb9\u6027\u8868\u683c\u3002"}, {"question": "\u83ef\u592b\u9905\u904a\u6232\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u5167\u5bb9\uff0c\u4ee5\u53ca\u5982\u4f55\u767c\u73fe\uff1f", "answer": "\u83ef\u592b\u9905\u904a\u6232\u5305\u542b\u96b1\u85cf\u5167\u5bb9\uff0c\u4f8b\u5982\u79d8\u5bc6\u95dc\u5361\u548c\u7a00\u6709\u83ef\u592b\u9905\u5716\u6848\u3002\u8981\u89e3\u9396\u9019\u4e9b\u5167\u5bb9\uff0c\u8acb\u63a2\u7d22\u904a\u6232\u4e16\u754c\u4e2d\u7684\u6bcf\u500b\u89d2\u843d\u4e26\u5b8c\u6210\u7279\u5b9a\u6311\u6230\u3002\u4f8b\u5982\uff0c\u5728\u300e\u795e\u79d8\u5eda\u623f\u300f\u95dc\u5361\u4e2d\uff0c\u627e\u5230\u6240\u6709\u96b1\u85cf\u7684\u7cd6\u6f3f\u74f6\uff0c\u5373\u53ef\u89e3\u9396\u4e00\u500b\u79d8\u5bc6\u83ef\u592b\u9905\u98df\u8b5c\u3002\u4f7f\u7528\u904a\u6232\u5730\u5716\u8ffd\u8e64\u60a8\u7684\u9032\u5ea6\uff0c\u78ba\u4fdd\u60a8\u4e0d\u6703\u932f\u904e\u4efb\u4f55\u96b1\u85cf\u5143\u7d20\u3002\u793e\u7fa4\u8ad6\u58c7\u4e2d\u63d0\u4f9b\u9010\u6b65\u6307\u5357\uff0c\u8aaa\u660e\u5982\u4f55\u767c\u73fe\u96b1\u85cf\u5167\u5bb9\u3002"}, {"question": "\u83ef\u592b\u9905\u904a\u6232\u4e2d\u7684\u83ef\u592b\u9905\u7ffb\u8f49\u6a5f\u5236\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u83ef\u592b\u9905\u904a\u6232\u4e2d\u7684\u83ef\u592b\u9905\u7ffb\u8f49\u6a5f\u5236\u9700\u8981\u4f7f\u7528\u300eF\u300f\u9375\u5728\u6b63\u78ba\u7684\u6642\u9593\u7ffb\u8f49\u83ef\u592b\u9905\u3002\u6642\u9593\u975e\u5e38\u91cd\u8981\uff1b\u904e\u65e9\u6216\u904e\u665a\u7ffb\u8f49\u83ef\u592b\u9905\u6703\u5c0e\u81f4\u5f97\u5206\u964d\u4f4e\u3002\u4f8b\u5982\uff0c\u5728\u300e\u9650\u6642\u7ffb\u8f49\u300f\u95dc\u5361\u4e2d\uff0c\u5728\u83ef\u592b\u9905\u9054\u5230\u5176\u5f27\u7dda\u9802\u9ede\u6642\u7ffb\u8f49\uff0c\u53ef\u4ee5\u7372\u5f97\u6700\u5927\u5206\u6578\u3002\u5728\u6559\u5b78\u4e2d\u7df4\u7fd2\u9019\u500b\u6a5f\u5236\uff0c\u4ee5\u4fbf\u66f4\u597d\u5730\u638c\u63e1\u6642\u9593\u7bc0\u594f\u3002\u904a\u6232\u7684\u8aaa\u660e\u90e8\u5206\u63d0\u4f9b\u984d\u5916\u7684\u8996\u89ba\u6307\u5c0e\u6642\u9593\u5716\u8868\u3002"}, {"question": "\u83ef\u592b\u9905\u904a\u6232\u4e2d\u54ea\u4e9b\u589e\u76ca\u9053\u5177\u6700\u597d\u7528\uff0c\u4ee5\u53ca\u4f55\u6642\u4f7f\u7528\uff1f", "answer": "\u83ef\u592b\u9905\u904a\u6232\u4e2d\u6700\u4f73\u7684\u589e\u76ca\u9053\u5177\u5305\u542b\u300e\u9ec3\u91d1\u7cd6\u6f3f\u300f\uff08\u7528\u65bc\u63d0\u5347\u5f97\u5206\uff09\u548c\u300e\u5feb\u901f\u7ffb\u8f49\u300f\uff08\u7528\u65bc\u52a0\u901f\u7ffb\u8f49\uff09\u3002\u5728\u9ad8\u5206\u6a5f\u6703\uff0c\u4f8b\u5982\u300e\u7cd6\u6f3f\u6fc0\u589e\u300f\u95dc\u5361\u4e2d\u4f7f\u7528\u300e\u9ec3\u91d1\u7cd6\u6f3f\u300f\uff0c\u4ee5\u6700\u5927\u5316\u60a8\u7684\u5f97\u5206\u3002\u300e\u5feb\u901f\u7ffb\u8f49\u300f\u9069\u5408\u6642\u9593\u654f\u611f\u7684\u6311\u6230\uff0c\u4f8b\u5982\u300e\u5feb\u901f\u7ffb\u8f49\u300f\u95dc\u5361\u3002\u4f7f\u7528\u904a\u6232\u5167\u589e\u76ca\u9053\u5177\u6bd4\u8f03\u5716\u8868\uff0c\u6709\u6548\u5730\u5236\u5b9a\u589e\u76ca\u9053\u5177\u7684\u7b56\u7565\u3002"}, {"question": "\u5982\u4f55\u5728\u83ef\u592b\u9905\u904a\u6232\u4e2d\u63d0\u9ad8\u6211\u7684\u9ad8\u5206\uff1f", "answer": "\u70ba\u4e86\u5728\u83ef\u592b\u9905\u904a\u6232\u4e2d\u63d0\u9ad8\u60a8\u7684\u9ad8\u5206\uff0c\u8acb\u5c08\u6ce8\u65bc\u7cbe\u78ba\u638c\u63e1\u7ffb\u8f49\u7684\u6642\u6a5f\u4e26\u6709\u7b56\u7565\u5730\u904b\u7528\u589e\u76ca\u9053\u5177\u3002\u4f8b\u5982\uff0c\u5728\u300e\u9ad8\u5206\u72e9\u7375\u300f\u95dc\u5361\u4e2d\uff0c\u5c07\u300e\u9ec3\u91d1\u7cd6\u6f3f\u300f\u8207\u7cbe\u78ba\u7684\u7ffb\u8f49\u76f8\u7d50\u5408\uff0c\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u60a8\u7684\u5f97\u5206\u3002\u6b64\u5916\uff0c\u8acb\u7814\u7a76\u6392\u884c\u699c\u4e2d\u9802\u5c16\u73a9\u5bb6\u7684\u8a08\u5206\u6a21\u5f0f\u3002\u9075\u5faa\u9010\u6b65\u7684\u7df4\u7fd2\u6d41\u7a0b\u4f86\u78e8\u7df4\u60a8\u7684\u6280\u80fd\uff0c\u4e26\u7a69\u6b65\u63d0\u9ad8\u60a8\u7684\u5f97\u5206\u3002"}, {"question": "\u83ef\u592b\u9905\u904a\u6232\u4e2d\u6709\u54ea\u4e9b\u4e0d\u540c\u7684\u904a\u6232\u6a21\u5f0f\uff1f", "answer": "\u83ef\u592b\u9905\u904a\u6232\u63d0\u4f9b\u591a\u7a2e\u6a21\u5f0f\uff0c\u5305\u62ec\u300e\u6545\u4e8b\u6a21\u5f0f\u300f\u3001\u300e\u6311\u6230\u6a21\u5f0f\u300f\u548c\u300e\u7121\u9650\u6a21\u5f0f\u300f\u3002\u300e\u6545\u4e8b\u6a21\u5f0f\u300f\u9075\u5faa\u7279\u5b9a\u76ee\u6a19\u7684\u5287\u60c5\uff0c\u4f8b\u5982\u5b8c\u6210\u300e\u5049\u5927\u7684\u83ef\u592b\u9905\u63a2\u96aa\u300f\u3002\u300e\u6311\u6230\u6a21\u5f0f\u300f\u6703\u900f\u904e\u9650\u6642\u548c\u7cbe\u6e96\u5ea6\u4efb\u52d9\u6e2c\u8a66\u60a8\u7684\u6280\u5de7\uff0c\u4f8b\u5982\u300e\u7ffb\u8f49\u72c2\u6f6e\u300f\u6311\u6230\u3002\u300e\u7121\u9650\u6a21\u5f0f\u300f\u8b93\u60a8\u53ef\u4ee5\u7121\u9650\u6642\u9593\u5730\u7ffb\u8f49\u83ef\u592b\u9905\u4ee5\u9054\u6210\u6700\u9ad8\u5f97\u5206\u3002\u8acb\u53c3\u8003\u904a\u6232\u6a21\u5f0f\u6d41\u7a0b\u5716\uff0c\u77ad\u89e3\u6bcf\u500b\u6a21\u5f0f\u7684\u76ee\u6a19\u548c\u734e\u52f5\u3002"}, {"question": "\u5982\u4f55\u5c07\u6211\u7684\u83ef\u592b\u9905\u904a\u6232\u9032\u5ea6\u8f49\u79fb\u5230\u65b0\u7684\u88dd\u7f6e\uff1f", "answer": "\u8981\u8f49\u79fb\u60a8\u7684\u83ef\u592b\u9905\u904a\u6232\u9032\u5ea6\uff0c\u8acb\u78ba\u4fdd\u60a8\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u90fd\u767b\u5165\u540c\u4e00\u5e33\u6236\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9e\u96fb\u8166\u79fb\u52d5\u5230\u884c\u52d5\u88dd\u7f6e\uff0c\u8acb\u4f7f\u7528\u60a8\u7684\u73fe\u6709\u5e33\u6236\u6191\u8b49\u767b\u5165\u3002\u60a8\u7684\u9032\u5ea6\uff0c\u5305\u62ec\u9ad8\u5206\u548c\u89e3\u9396\u7684\u5167\u5bb9\uff0c\u5c07\u6703\u81ea\u52d5\u540c\u6b65\u3002\u8acb\u67e5\u770b\u5b98\u65b9\u83ef\u592b\u9905\u904a\u6232\u652f\u63f4\u9801\u9762\uff0c\u8a73\u7d30\u4e86\u89e3\u8cc7\u6599\u9077\u79fb\u548c\u7591\u96e3\u6392\u89e3\u6280\u5de7\u3002"}]
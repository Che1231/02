[{"question": "\u30ef\u30c3\u30d5\u30eb\u30b2\u30fc\u30e0\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u521d\u5fc3\u8005\u306e\u65b9\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30ef\u30c3\u30d5\u30eb\u30b2\u30fc\u30e0\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u304a\u597d\u307f\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u304b\u3089\u30b2\u30fc\u30e0\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3066\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3092\u5b8c\u4e86\u3057\u3066\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3068\u76ee\u6a19\u3092\u7406\u89e3\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b9\u30ad\u30eb\u3092\u7df4\u7fd2\u3059\u308b\u305f\u3081\u306b\u3001\u300e\u521d\u5fc3\u8005\u30af\u30a8\u30b9\u30c8\u300f\u304b\u3089\u59cb\u3081\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3067\u306f\u300eF\u300f\u30ad\u30fc\u3092\u4f7f\u3063\u3066\u30ef\u30c3\u30d5\u30eb\u3092\u3072\u3063\u304f\u308a\u8fd4\u3059\u65b9\u6cd5\u3092\u5b66\u3073\u307e\u3059\u3002\u3053\u308c\u306f\u30b2\u30fc\u30e0\u3092\u9032\u3081\u308b\u305f\u3081\u306b\u5fc5\u9808\u3067\u3059\u3002\u30d2\u30f3\u30c8\u3068\u30b3\u30c4\u306b\u3064\u3044\u3066\u306f\u3001\u30b2\u30fc\u30e0\u5185\u306e\u30ac\u30a4\u30c9\u3092\u53c2\u7167\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u30ef\u30c3\u30d5\u30eb\u30b2\u30fc\u30e0\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u305f\u3081\u306e\u4e3b\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "100\u6642\u9593\u30d7\u30ec\u30a4\u5f8c\u3001\u3053\u308c\u3089\u306e\u6226\u7565\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30ef\u30c3\u30d5\u30eb\u3092\u3072\u3063\u304f\u308a\u8fd4\u3059\u6280\u8853\u3092\u6700\u9069\u5316\u3057\u3001\u3072\u3063\u304f\u308a\u8fd4\u3059\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5b8c\u74a7\u306b\u5408\u308f\u305b\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u300e\u30b4\u30fc\u30eb\u30c7\u30f3\u30b7\u30ed\u30c3\u30d7\u300f\u306a\u3069\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u3092\u6d3b\u7528\u3057\u3066\u3001\u30dd\u30a4\u30f3\u30c8\u3092\u6700\u5927\u5316\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u4e0a\u7d1a\u8005\u306e\u30ef\u30c3\u30d5\u30eb\u306e\u30b7\u30fc\u30b1\u30f3\u30b9\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u7814\u7a76\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30b7\u30ed\u30c3\u30d7\u30b9\u30c8\u30fc\u30e0\u300f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30b8\u30b0\u30b6\u30b0\u306b\u30ef\u30c3\u30d5\u30eb\u3092\u3072\u3063\u304f\u308a\u8fd4\u3059\u3053\u3068\u3067\u3001\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u3069\u306e\u6226\u7565\u304c\u305d\u308c\u305e\u308c\u306e\u30ec\u30d9\u30eb\u3067\u6709\u52b9\u304b\u8ffd\u8de1\u3059\u308b\u305f\u3081\u306b\u3001\u8a2d\u5b9a\u8868\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u306a\u305c\u30ef\u30c3\u30d5\u30eb\u30b2\u30fc\u30e0\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b9\u30d4\u30fc\u30c9\u3088\u308a\u3082\u6b63\u78ba\u3055\u3092\u91cd\u8996\u3059\u308b\u306e\u3067\u3059\u304b\uff1f", "answer": "\u30ef\u30c3\u30d5\u30eb\u30b2\u30fc\u30e0\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u6b63\u78ba\u3055\u3092\u91cd\u8996\u3057\u3066\u3044\u307e\u3059\u3002\u306a\u305c\u306a\u3089\u3001\u7d20\u65e9\u304f\u3001\u4e0d\u6ce8\u610f\u306a\u884c\u52d5\u3067\u306f\u306a\u304f\u3001\u6b63\u78ba\u306a\u3072\u3063\u304f\u308a\u8fd4\u3057\u306b\u5831\u916c\u3092\u4e0e\u3048\u308b\u304b\u3089\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u6b63\u78ba\u3055\u30c1\u30e3\u30ec\u30f3\u30b8\u300f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u5b8c\u74a7\u306b\u3072\u3063\u304f\u308a\u8fd4\u3057\u305f\u30ef\u30c3\u30d5\u30eb\u306f100\u70b9\u7372\u5f97\u3067\u304d\u307e\u3059\u304c\u3001\u6025\u3044\u3067\u3072\u3063\u304f\u308a\u8fd4\u3057\u305f\u5834\u5408\u300150\u70b9\u3057\u304b\u7372\u5f97\u3067\u304d\u306a\u3044\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u6280\u8853\u3068\u5de7\u307f\u3055\u3092\u990a\u3046\u3053\u3068\u3092\u4fc3\u3057\u3001\u30b2\u30fc\u30e0\u3092\u3088\u308a\u9b45\u529b\u7684\u3067\u3084\u308a\u304c\u3044\u306e\u3042\u308b\u3082\u306e\u306b\u3057\u307e\u3059\u3002\u8a73\u7d30\u306a\u6982\u8981\u306b\u3064\u3044\u3066\u306f\u3001\u30b2\u30fc\u30e0\u30de\u30cb\u30e5\u30a2\u30eb\u306e\u30b9\u30b3\u30a2\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u53c2\u7167\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u3069\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u304c\u30ef\u30c3\u30d5\u30eb\u30b2\u30fc\u30e0\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u304a\u308a\u3001\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30d7\u30ec\u30a4\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30ef\u30c3\u30d5\u30eb\u30b2\u30fc\u30e0\u306fPC\u3001Mac\u3001\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u3067\u5229\u7528\u53ef\u80fd\u3067\u3059\u3002\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30d7\u30ec\u30a4\u306f\u3001\u7d71\u5408\u3055\u308c\u305f\u30a2\u30ab\u30a6\u30f3\u30c8\u30b7\u30b9\u30c6\u30e0\u3092\u901a\u3058\u3066\u5b9f\u73fe\u3055\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001PC\u3067\u30d7\u30ec\u30a4\u3092\u59cb\u3081\u308b\u3068\u3001\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3053\u3068\u3067\u3001\u30e2\u30d0\u30a4\u30eb\u7aef\u672b\u3067\u30b2\u30fc\u30e0\u3092\u7d9a\u3051\u3089\u308c\u307e\u3059\u3002\u4e92\u63db\u6027\u554f\u984c\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u3001\u3059\u3079\u3066\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u30b2\u30fc\u30e0\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u3092\u6700\u65b0\u306e\u72b6\u614b\u306b\u4fdd\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u8a73\u7d30\u60c5\u5831\u306b\u3064\u3044\u3066\u306f\u3001\u516c\u5f0f\u30ef\u30c3\u30d5\u30eb\u30b2\u30fc\u30e0\u30a6\u30a7\u30d6\u30b5\u30a4\u30c8\u306b\u3042\u308b\u4e92\u63db\u6027\u8868\u3092\u3054\u89a7\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30ef\u30c3\u30d5\u30eb\u30b2\u30fc\u30e0\u3067\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3068\u3001\u305d\u308c\u3089\u306f\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u767a\u898b\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30ef\u30c3\u30d5\u30eb\u30b2\u30fc\u30e0\u306b\u306f\u3001\u79d8\u5bc6\u306e\u30ec\u30d9\u30eb\u3084\u73cd\u3057\u3044\u30ef\u30c3\u30d5\u30eb\u306e\u30c7\u30b6\u30a4\u30f3\u306a\u3069\u3001\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u767a\u898b\u3059\u308b\u306b\u306f\u3001\u30b2\u30fc\u30e0\u4e16\u754c\u306e\u9685\u3005\u3092\u63a2\u7d22\u3057\u3001\u7279\u5b9a\u306e\u8ab2\u984c\u3092\u5b8c\u4e86\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30df\u30b9\u30c6\u30ea\u30fc\u30ad\u30c3\u30c1\u30f3\u300f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u3059\u3079\u3066\u306e\u96a0\u3055\u308c\u305f\u30b7\u30ed\u30c3\u30d7\u30dc\u30c8\u30eb\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u3067\u3001\u7279\u5225\u306a\u30ef\u30c3\u30d5\u30eb\u30ec\u30b7\u30d4\u304c\u89e3\u7981\u3055\u308c\u307e\u3059\u3002\u9032\u6357\u72b6\u6cc1\u3092\u8ffd\u8de1\u3057\u3001\u96a0\u3055\u308c\u305f\u8981\u7d20\u3092\u9003\u3055\u306a\u3044\u3088\u3046\u306b\u3001\u30b2\u30fc\u30e0\u5185\u30de\u30c3\u30d7\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u767a\u898b\u3059\u308b\u305f\u3081\u306e\u6bb5\u968e\u7684\u306a\u30ac\u30a4\u30c9\u306f\u3001\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u30d5\u30a9\u30fc\u30e9\u30e0\u306b\u63b2\u8f09\u3055\u308c\u3066\u3044\u307e\u3059\u3002"}, {"question": "\u30ef\u30c3\u30d5\u30eb\u30b2\u30fc\u30e0\u306e\u30ef\u30c3\u30d5\u30eb\u3092\u3072\u3063\u304f\u308a\u8fd4\u3059\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30ef\u30c3\u30d5\u30eb\u30b2\u30fc\u30e0\u306e\u30ef\u30c3\u30d5\u30eb\u3092\u3072\u3063\u304f\u308a\u8fd4\u3059\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u300eF\u300f\u30ad\u30fc\u3092\u4f7f\u3063\u3066\u9069\u5207\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u30ef\u30c3\u30d5\u30eb\u3092\u3072\u3063\u304f\u308a\u8fd4\u3059\u3053\u3068\u3067\u3059\u3002\u30bf\u30a4\u30df\u30f3\u30b0\u306f\u91cd\u8981\u3067\u3059\u3002\u3072\u3063\u304f\u308a\u8fd4\u3057\u3059\u304e\u308b\u3068\u3082\u3001\u9045\u3059\u304e\u308b\u3068\u3001\u30b9\u30b3\u30a2\u304c\u4f4e\u304f\u306a\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u6642\u9593\u5236\u9650\u30d5\u30ea\u30c3\u30d7\u300f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30ef\u30c3\u30d5\u30eb\u304c\u305d\u306e\u5186\u5f27\u306e\u9802\u70b9\u306b\u9054\u3057\u305f\u3068\u304d\u306b\u3072\u3063\u304f\u308a\u8fd4\u3059\u3053\u3068\u3067\u3001\u6700\u5927\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3067\u7df4\u7fd2\u3057\u3066\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u628a\u63e1\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b2\u30fc\u30e0\u306e\u30d8\u30eb\u30d7\u30bb\u30af\u30b7\u30e7\u30f3\u306b\u3042\u308b\u30bf\u30a4\u30df\u30f3\u30b0\u56f3\u306f\u3001\u8ffd\u52a0\u306e\u8996\u899a\u7684\u306a\u30ac\u30a4\u30c0\u30f3\u30b9\u3092\u63d0\u4f9b\u3057\u3066\u3044\u307e\u3059\u3002"}, {"question": "\u30ef\u30c3\u30d5\u30eb\u30b2\u30fc\u30e0\u3067\u4f7f\u7528\u3059\u308b\u6700\u9069\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3068\u3001\u4f7f\u7528\u3059\u3079\u304d\u30bf\u30a4\u30df\u30f3\u30b0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ef\u30c3\u30d5\u30eb\u30b2\u30fc\u30e0\u3067\u6700\u9069\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306b\u306f\u3001\u300e\u30b4\u30fc\u30eb\u30c7\u30f3\u30b7\u30ed\u30c3\u30d7\u300f\u306b\u3088\u308b\u30dd\u30a4\u30f3\u30c8\u5897\u3068\u3001\u300e\u30b9\u30d4\u30fc\u30c9\u30d5\u30ea\u30c3\u30d7\u300f\u306b\u3088\u308b\u3088\u308a\u901f\u3044\u3072\u3063\u304f\u308a\u8fd4\u3057\u304c\u3042\u308a\u307e\u3059\u3002\u300e\u30b4\u30fc\u30eb\u30c7\u30f3\u30b7\u30ed\u30c3\u30d7\u300f\u306f\u3001\u300e\u30b7\u30ed\u30c3\u30d7\u30b5\u30fc\u30b8\u300f\u30ec\u30d9\u30eb\u306a\u3069\u306e\u9ad8\u5f97\u70b9\u6a5f\u4f1a\u4e2d\u306b\u4f7f\u7528\u3057\u3066\u3001\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3057\u307e\u3059\u3002\u300e\u30b9\u30d4\u30fc\u30c9\u30d5\u30ea\u30c3\u30d7\u300f\u306f\u3001\u300e\u6025\u901f\u30d5\u30ea\u30c3\u30d7\u300f\u30ec\u30d9\u30eb\u306a\u3069\u306e\u6642\u9593\u5236\u9650\u306e\u3042\u308b\u8ab2\u984c\u306b\u6700\u9069\u3067\u3059\u3002\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306e\u52b9\u679c\u3092\u6bd4\u8f03\u3059\u308b\u305f\u3081\u306e\u30b2\u30fc\u30e0\u5185\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u6bd4\u8f03\u30c1\u30e3\u30fc\u30c8\u3092\u53c2\u7167\u3057\u3066\u3001\u52b9\u679c\u7684\u306a\u6226\u7565\u3092\u7acb\u3066\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30ef\u30c3\u30d5\u30eb\u30b2\u30fc\u30e0\u3067\u81ea\u5206\u306e\u9ad8\u30b9\u30b3\u30a2\u3092\u3069\u306e\u3088\u3046\u306b\u6539\u5584\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30ef\u30c3\u30d5\u30eb\u30b2\u30fc\u30e0\u3067\u9ad8\u30b9\u30b3\u30a2\u3092\u4e0a\u3052\u308b\u306b\u306f\u3001\u3072\u3063\u304f\u308a\u8fd4\u3059\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5b8c\u74a7\u306b\u3057\u305f\u308a\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u6226\u7565\u7684\u306b\u6d3b\u7528\u3059\u308b\u3053\u3068\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u300e\u9ad8\u5f97\u70b9\u30cf\u30f3\u30c6\u30a3\u30f3\u30b0\u300f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u300e\u30b4\u30fc\u30eb\u30c7\u30f3\u30b7\u30ed\u30c3\u30d7\u300f\u3068\u6b63\u78ba\u306a\u3072\u3063\u304f\u308a\u8fd4\u3057\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3001\u30b9\u30b3\u30a2\u3092\u5927\u5e45\u306b\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30ea\u30fc\u30c0\u30fc\u30dc\u30fc\u30c9\u306e\u4e0a\u4f4d\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30d1\u30bf\u30fc\u30f3\u3092\u7814\u7a76\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6bb5\u968e\u7684\u306a\u7df4\u7fd2\u30eb\u30fc\u30c1\u30f3\u306b\u5f93\u3046\u3053\u3068\u3067\u30b9\u30ad\u30eb\u3092\u78e8\u3044\u3066\u3001\u7740\u5b9f\u306b\u30b9\u30b3\u30a2\u3092\u5897\u3084\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30ef\u30c3\u30d5\u30eb\u30b2\u30fc\u30e0\u3067\u5229\u7528\u53ef\u80fd\u306a\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ef\u30c3\u30d5\u30eb\u30b2\u30fc\u30e0\u306b\u306f\u3001\u300e\u30b9\u30c8\u30fc\u30ea\u30fc\u30e2\u30fc\u30c9\u300f\u3001\u300e\u30c1\u30e3\u30ec\u30f3\u30b8\u30e2\u30fc\u30c9\u300f\u3001\u300e\u30a8\u30f3\u30c9\u30ec\u30b9\u30e2\u30fc\u30c9\u300f\u306a\u3069\u3001\u3044\u304f\u3064\u304b\u306e\u30e2\u30fc\u30c9\u304c\u3042\u308a\u307e\u3059\u3002\u300e\u30b9\u30c8\u30fc\u30ea\u30fc\u30e2\u30fc\u30c9\u300f\u306f\u3001\u300e\u5049\u5927\u306a\u30ef\u30c3\u30d5\u30eb\u30af\u30a8\u30b9\u30c8\u300f\u3092\u5b8c\u4e86\u3059\u308b\u3068\u3044\u3063\u305f\u3001\u7279\u5b9a\u306e\u76ee\u6a19\u3092\u6301\u3064\u7269\u8a9e\u306b\u5f93\u3044\u307e\u3059\u3002\u300e\u30c1\u30e3\u30ec\u30f3\u30b8\u30e2\u30fc\u30c9\u300f\u306f\u3001\u300e\u30d5\u30ea\u30c3\u30d7\u30d5\u30ec\u30a4\u30b8\u30fc\u300f\u30c1\u30e3\u30ec\u30f3\u30b8\u306e\u3088\u3046\u306a\u3001\u6642\u9593\u5236\u9650\u3068\u6b63\u78ba\u3055\u3092\u91cd\u8996\u3059\u308b\u8ab2\u984c\u3067\u3042\u306a\u305f\u306e\u30b9\u30ad\u30eb\u3092\u8a66\u3057\u307e\u3059\u3002\u300e\u30a8\u30f3\u30c9\u30ec\u30b9\u30e2\u30fc\u30c9\u300f\u3067\u306f\u3001\u6700\u9ad8\u30b9\u30b3\u30a2\u3092\u76ee\u6307\u3057\u3066\u3001\u7121\u9650\u306b\u30ef\u30c3\u30d5\u30eb\u3092\u3072\u3063\u304f\u308a\u8fd4\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305d\u308c\u305e\u308c\u306e\u30e2\u30fc\u30c9\u306e\u76ee\u6a19\u3068\u5831\u916c\u3092\u7406\u89e3\u3059\u308b\u305f\u3081\u306b\u3001\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u53c2\u7167\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u30ef\u30c3\u30d5\u30eb\u30b2\u30fc\u30e0\u306e\u9032\u6357\u72b6\u6cc1\u3092\u3069\u306e\u3088\u3046\u306b\u79fb\u884c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30ef\u30c3\u30d5\u30eb\u30b2\u30fc\u30e0\u306e\u9032\u6357\u72b6\u6cc1\u3092\u79fb\u884c\u3059\u308b\u306b\u306f\u3001\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001PC\u304b\u3089\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u306b\u79fb\u884c\u3059\u308b\u5834\u5408\u3001\u65e2\u5b58\u306e\u30a2\u30ab\u30a6\u30f3\u30c8\u306e\u8cc7\u683c\u60c5\u5831\u3092\u4f7f\u7528\u3057\u3066\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u9ad8\u30b9\u30b3\u30a2\u3084\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u306a\u3069\u3001\u3042\u306a\u305f\u306e\u9032\u6357\u72b6\u6cc1\u306f\u81ea\u52d5\u7684\u306b\u540c\u671f\u3055\u308c\u307e\u3059\u3002\u30c7\u30fc\u30bf\u79fb\u884c\u3068\u30c8\u30e9\u30d6\u30eb\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0\u306e\u30d2\u30f3\u30c8\u306e\u8a73\u7d30\u306a\u30ac\u30a4\u30c9\u306b\u3064\u3044\u3066\u306f\u3001\u516c\u5f0f\u30ef\u30c3\u30d5\u30eb\u30b2\u30fc\u30e0\u30b5\u30dd\u30fc\u30c8\u30da\u30fc\u30b8\u3092\u53c2\u7167\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}]
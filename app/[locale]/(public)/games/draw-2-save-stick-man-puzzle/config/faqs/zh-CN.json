[{"question": "\u5728Draw 2 Save Stick man Puzzle\u6e38\u620f\u4e2d\uff0c\u521d\u5b66\u8005\u5982\u4f55\u6267\u884c\u57fa\u672c\u7684\u7ed8\u56fe\u64cd\u4f5c\uff1f", "answer": "\u5728Draw 2 Save Stick man Puzzle\u6e38\u620f\u4e2d\uff0c\u521d\u5b66\u8005\u53ef\u4ee5\u5148\u4f7f\u7528\u7ed8\u56fe\u5de5\u5177\u7ed8\u5236\u7ebf\u6761\u6216\u5f62\u72b6\uff0c\u5e2e\u52a9\u5c0f\u6728\u5076\u7ed5\u8fc7\u969c\u788d\u7269\u3002\u4f8b\u5982\uff0c\u5728\u95f4\u9699\u4e0a\u7ed8\u5236\u6865\u6881\uff0c\u6216\u5728\u5760\u7269\u9762\u524d\u7ed8\u5236\u76fe\u724c\u3002\u6b65\u9aa41\uff1a\u4ece\u5e95\u90e8\u83dc\u5355\u8bbf\u95ee\u7ed8\u56fe\u5de5\u5177\u3002\u6b65\u9aa42\uff1a\u9009\u62e9\u6240\u9700\u5f62\u72b6\u6216\u7ebf\u6761\u7c7b\u578b\u3002\u6b65\u9aa43\uff1a\u5728\u9700\u8981\u7684\u5730\u65b9\u7ed8\u5236\u3002\u8fd9\u79cd\u7b80\u5355\u7684\u65b9\u6cd5\u5bf9\u4e8e\u901a\u5173\u65e9\u671f\u5173\u5361\u81f3\u5173\u91cd\u8981\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u628a\u7ed8\u56fe\u5de5\u5177\u60f3\u8c61\u6210\u4e00\u652f\u795e\u5947\u7684\u7b14\uff0c\u80fd\u591f\u521b\u9020\u89e3\u51b3\u7269\u7406\u95ee\u9898\u7684\u65b9\u6848\u3002]"}, {"question": "\u5373\u4f7f\u7ed8\u5236\u4e86\u56fe\uff0c\u4e3a\u4ec0\u4e48\u6211\u7684\u5c0f\u6728\u5076\u5728Draw 2 Save Stick man Puzzle\u6e38\u620f\u4e2d\u4ecd\u7136\u5931\u8d25\uff1f", "answer": "\u5728Draw 2 Save Stick man Puzzle\u6e38\u620f\u4e2d\uff0c\u5931\u8d25\u901a\u5e38\u662f\u7531\u4e8e\u7ed8\u5236\u4f4d\u7f6e\u4e0d\u5f53\u6216\u652f\u6491\u4e0d\u8db3\u9020\u6210\u7684\u3002\u4f8b\u5982\uff0c\u7ed8\u5236\u7684\u6865\u6881\u592a\u77ed\uff0c\u65e0\u6cd5\u8de8\u8d8a\u95f4\u9699\uff0c\u5bfc\u81f4\u5c0f\u6728\u5076\u6389\u843d\u3002\u8bf7\u786e\u4fdd\u60a8\u7684\u7ed8\u5236\u5b8c\u5168\u89e3\u51b3\u4e86\u969c\u788d\u7269\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6865\u6881\u957f\u5ea6\u4e0e\u95f4\u9699\u5bbd\u5ea6] \u8f83\u5bbd\u7684\u95f4\u9699\u9700\u8981\u8f83\u957f\u7684\u6865\u6881\u3002\u8fd8\u8981\u68c0\u67e5\u60a8\u7ed8\u5236\u56fe\u5f62\u7684\u7a33\u5b9a\u6027\uff1b\u6447\u6447\u6b32\u5760\u7684\u7ebf\u6761\u53ef\u80fd\u627f\u53d7\u4e0d\u4f4f\u5c0f\u6728\u5076\u7684\u91cd\u91cf\u3002"}, {"question": "Draw 2 Save Stick man Puzzle\u6e38\u620f\u4e2d\uff0c\u6bcf\u4e2a\u73a9\u5bb6\u90fd\u5e94\u8be5\u638c\u63e1\u54ea\u4e9b\u5fc5\u5907\u5de5\u5177\uff1f", "answer": "\u5728Draw 2 Save Stick man Puzzle\u6e38\u620f\u4e2d\uff0c\u638c\u63e1\u7ebf\u6761\u548c\u5f62\u72b6\u5de5\u5177\u81f3\u5173\u91cd\u8981\u3002\u7ebf\u6761\u5de5\u5177\u53ef\u7528\u4e8e\u521b\u5efa\u6865\u6881\u3001\u659c\u5761\u6216\u969c\u788d\u7269\uff0c\u800c\u5f62\u72b6\u5de5\u5177\u5219\u53ef\u4ee5\u5f62\u6210\u76fe\u724c\u6216\u5e73\u53f0\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u5706\u5f62\u4f5c\u4e3a\u76fe\u724c\u53ef\u4ee5\u4fdd\u62a4\u5c0f\u6728\u5076\u514d\u53d7\u5760\u843d\u5ca9\u77f3\u7684\u4f24\u5bb3\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u5de5\u5177\u9009\u62e9 \u2192 \u7ed8\u56fe\u5e94\u7528 \u2192 \u7ed3\u679c\u5206\u6790] \u901a\u8fc7\u7ec3\u4e60\u8fd9\u4e9b\u5de5\u5177\uff0c\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u60a8\u7684\u6e38\u620f\u6548\u7387\u3002"}, {"question": "\u9ad8\u7ea7\u73a9\u5bb6\u5728Draw 2 Save Stick man Puzzle\u6e38\u620f\u4e2d\u5982\u4f55\u89e3\u51b3\u590d\u6742\u8c1c\u9898\uff1f", "answer": "\u5728Draw 2 Save Stick man Puzzle\u6e38\u620f\u4e2d\uff0c\u9ad8\u7ea7\u73a9\u5bb6\u901a\u5e38\u4f1a\u91c7\u7528\u591a\u6b65\u9aa4\u7b56\u7565\u3002\u6b65\u9aa41\uff1a\u5206\u6790\u8c1c\u9898\uff0c\u8bc6\u522b\u6240\u6709\u969c\u788d\u7269\u3002\u6b65\u9aa42\uff1a\u8ba1\u5212\u514b\u670d\u6bcf\u4e2a\u969c\u788d\u7269\u6240\u9700\u7684\u7ed8\u56fe\u987a\u5e8f\u3002\u6b65\u9aa43\uff1a\u7cbe\u786e\u6267\u884c\u8ba1\u5212\u3002\u4f8b\u5982\uff0c\u5728\u4e00\u4e2a\u5305\u542b\u591a\u91cd\u79fb\u52a8\u5371\u9669\u7684\u5173\u5361\u4e2d\uff0c\u7ed8\u5236\u4e00\u7cfb\u5217\u5b9a\u65f6\u969c\u788d\u7269\u53ef\u4ee5\u4fdd\u62a4\u5c0f\u6728\u5076\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u5355\u4e00\u969c\u788d\u7269\u4e0e\u591a\u91cd\u5b9a\u65f6\u969c\u788d\u7269] \u5728\u590d\u6742\u573a\u666f\u4e2d\u4f7f\u7528\u591a\u91cd\u5b9a\u65f6\u969c\u788d\u7269\u53ef\u80fd\u66f4\u6709\u6548\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728Draw 2 Save Stick man Puzzle\u6e38\u620f\u4e2d\u4f18\u5316\u7ed8\u56fe\u6280\u5de7\u4ee5\u83b7\u5f97\u9ad8\u5206\uff1f", "answer": "\u4e3a\u4e86\u5728Draw 2 Save Stick man Puzzle\u6e38\u620f\u4e2d\u4f18\u5316\u9ad8\u5206\uff0c\u8bf7\u6ce8\u91cd\u6548\u7387\u548c\u521b\u9020\u529b\u3002\u4f7f\u7528\u6700\u5c11\u7684\u7ebf\u6761\u6765\u89e3\u51b3\u8c1c\u9898\uff0c\u56e0\u4e3a\u8f83\u5c11\u7684\u7ebf\u6761\u53ef\u4ee5\u83b7\u5f97\u66f4\u9ad8\u7684\u5206\u6570\u3002\u4f8b\u5982\uff0c\u4e0e\u5176\u7ed8\u5236\u6574\u5ea7\u6865\u6881\uff0c\u4e0d\u5982\u4f7f\u7528\u4e00\u6761\u5de7\u5999\u653e\u7f6e\u7684\u76f4\u7ebf\u6765\u521b\u5efa\u4e00\u4e2a\u659c\u5761\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u60f3\u8c61\u4e00\u4e0b\uff0c\u6bcf\u6761\u7ebf\u5c31\u50cf\u4e00\u7b14\u753b\u4f5c\u4e2d\u7684\u7b14\u89e6\uff1b\u7b14\u89e6\u8d8a\u5c11\uff0c\u89e3\u51b3\u65b9\u6848\u5c31\u8d8a\u4f18\u96c5\u3002] \u6b64\u5916\uff0c\u5c1d\u8bd5\u4f7f\u7528\u975e\u4f20\u7edf\u7684\u5f62\u72b6\u6709\u65f6\u53ef\u4ee5\u83b7\u5f97\u66f4\u597d\u7684\u7ed3\u679c\u548c\u66f4\u9ad8\u7684\u5206\u6570\u3002"}, {"question": "Draw 2 Save Stick man Puzzle\u6e38\u620f\u4e2d\u7684\u8ba1\u5206\u7cfb\u7edf\u80cc\u540e\u6709\u54ea\u4e9b\u5173\u952e\u673a\u5236\uff1f", "answer": "Draw 2 Save Stick man Puzzle\u6e38\u620f\u4e2d\u7684\u8ba1\u5206\u7cfb\u7edf\u5956\u52b1\u6548\u7387\u548c\u521b\u9020\u529b\u3002\u5206\u6570\u6839\u636e\u4f7f\u7528\u7684\u7ebf\u6761\u6570\u91cf\u6765\u8ba1\u7b97\uff0c\u7ebf\u6761\u8d8a\u5c11\uff0c\u5206\u6570\u8d8a\u9ad8\u3002\u6b64\u5916\uff0c\u6210\u529f\u5f15\u5bfc\u5c0f\u6728\u5076\u901a\u8fc7\u969c\u788d\u7269\u800c\u65e0\u9700\u91cd\u65b0\u7ed8\u5236\u5219\u989d\u5916\u52a0\u5206\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u4f7f\u7528\u7684\u7ebf\u6761\u6570\u91cf\u4e0e\u83b7\u5f97\u7684\u5206\u6570] \u4f8b\u5982\uff0c\u4f7f\u7528\u4e00\u6761\u7ebf\u6765\u89e3\u51b3\u4e00\u4e2a\u8c1c\u9898\u53ef\u80fd\u83b7\u5f97100\u5206\uff0c\u800c\u4f7f\u7528\u4e09\u6761\u7ebf\u53ef\u80fd\u4f1a\u964d\u4f4e\u5206\u6570\u81f370\u5206\u3002"}, {"question": "\u6e38\u620f\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u5982\u4f55\u5728Draw 2 Save Stick man Puzzle\u6e38\u620f\u4e2d\u5f71\u54cd\u8c1c\u9898\u89e3\u51b3\u65b9\u6848\uff1f", "answer": "Draw 2 Save Stick man Puzzle\u6e38\u620f\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u5728\u786e\u5b9a\u60a8\u7ed8\u5236\u7684\u56fe\u5f62\u6210\u529f\u4e0e\u5426\u65b9\u9762\u53d1\u6325\u7740\u81f3\u5173\u91cd\u8981\u7684\u4f5c\u7528\u3002\u4f8b\u5982\uff0c\u4ee5\u9661\u5ced\u89d2\u5ea6\u7ed8\u5236\u7684\u6865\u6881\u53ef\u80fd\u627f\u53d7\u4e0d\u4f4f\u5c0f\u6728\u5076\u7684\u91cd\u91cf\uff0c\u800c\u5e73\u7f13\u659c\u5761\u7684\u659c\u5761\u5219\u66f4\u7a33\u5b9a\u3002\u4e86\u89e3\u91cd\u529b\u3001\u91cd\u91cf\u5206\u5e03\u548c\u6750\u8d28\u7279\u6027\uff08\u4f8b\u5982\u7ebf\u6761\u7c97\u7ec6\uff09\u81f3\u5173\u91cd\u8981\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u7ed8\u5236\u521b\u5efa \u2192 \u7269\u7406\u6a21\u62df \u2192 \u7ed3\u679c\u8bc4\u4f30] \u8fd9\u6709\u52a9\u4e8e\u521b\u5efa\u5bf9\u590d\u6742\u8c1c\u9898\u7684\u6709\u6548\u89e3\u51b3\u65b9\u6848\u3002"}, {"question": "\u73a9\u5bb6\u80fd\u5426\u5728Draw 2 Save Stick man Puzzle\u6e38\u620f\u4e2d\u5c06\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u8bbe\u5907\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u8bbe\u5907\uff1f", "answer": "\u662f\u7684\uff0c\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u5c06\u6e38\u620f\u94fe\u63a5\u5230\u4e91\u5e10\u6237\u6765\u8f6c\u79fbDraw 2 Save Stick man Puzzle\u6e38\u620f\u4e2d\u7684\u8fdb\u5ea6\u3002\u6b65\u9aa41\uff1a\u8fdb\u5165\u8bbe\u7f6e\u83dc\u5355\uff0c\u9009\u62e9\u201c\u4e91\u4fdd\u5b58\u201d\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u60a8\u9009\u62e9\u7684\u4e91\u670d\u52a1\u767b\u5f55\uff08\u4f8b\u5982\uff0cGoogle Play\u3001Apple Game Center\uff09\u3002\u6b65\u9aa43\uff1a\u4e0a\u4f20\u60a8\u7684\u5f53\u524d\u8fdb\u5ea6\u3002\u5207\u6362\u8bbe\u5907\u65f6\uff0c\u53ea\u9700\u767b\u5f55\u76f8\u540c\u7684\u4e91\u5e10\u6237\u5373\u53ef\u68c0\u7d22\u60a8\u7684\u6570\u636e\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u624b\u52a8\u4fdd\u5b58\u4e0e\u4e91\u4fdd\u5b58] \u4e91\u4fdd\u5b58\u786e\u4fdd\u8de8\u5e73\u53f0\u65e0\u7f1d\u7684\u8fdb\u5ea6\u8f6c\u79fb\u3002"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728Draw 2 Save Stick man Puzzle\u6e38\u620f\u4e2d\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "Draw 2 Save Stick man Puzzle\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u529f\u80fd\u548c\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u5728\u7279\u5b9a\u5173\u5361\u4e2d\u7ed8\u5236\u7279\u5b9a\u5f62\u72b6\uff0c\u4f8b\u5982\u661f\u661f\u6216\u5fc3\u810f\uff0c\u53ef\u4ee5\u89e3\u9501\u79d8\u5bc6\u5956\u52b1\u6216\u52a8\u753b\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u5173\u5361\u4e2d\u6709\u9690\u85cf\u8def\u5f84\uff0c\u53ef\u4ee5\u901a\u8fc7\u5728\u610f\u5916\u533a\u57df\u7ed8\u5236\u6765\u63ed\u793a\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u628a\u8fd9\u4e9b\u9690\u85cf\u529f\u80fd\u60f3\u8c61\u6210\u7b49\u5f85\u7528\u6b63\u786e\u7684\u94a5\u5319\uff08\u7ed8\u5236\uff09\u53d1\u73b0\u7684\u5b9d\u7bb1\u3002] \u63a2\u7d22\u8fd9\u4e9b\u5143\u7d20\u4e3a\u6e38\u620f\u589e\u6dfb\u4e86\u989d\u5916\u7684\u4e50\u8da3\u548c\u6311\u6218\u3002"}]
[{"question": "\ucd08\uc2ec\uc790\ub97c \uc704\ud55c Draw 2 Save Stick man Puzzle\uc758 \uae30\ubcf8\uc801\uc778 \uadf8\ub9bc \uadf8\ub9ac\uae30 \uc791\uc5c5\uc740 \uc5b4\ub5bb\uac8c \uc218\ud589\ud574\uc57c \ud560\uae4c\uc694?", "answer": "Draw 2 Save Stick man Puzzle\uc5d0\uc11c \ucd08\uc2ec\uc790\ub294 \uc2a4\ud2f1\ub9e8\uc774 \uc7a5\uc560\ubb3c\uc744 \ud5e4\uccd0\ub098\uac08 \uc218 \uc788\ub3c4\ub85d \uc120\uc774\ub098 \ub3c4\ud615\uc744 \uadf8\ub9ac\ub294 \uac83\uc73c\ub85c \uc2dc\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac04\uaca9\uc744 \uac74\ub108\ub294 \ub2e4\ub9ac\ub098 \ub5a8\uc5b4\uc9c0\ub294 \ubb3c\uccb4\ub85c\ubd80\ud130 \ubcf4\ud638\ud558\ub294 \ubc29\ud328\ub97c \uadf8\ub9ac\ub294 \uac83\uc785\ub2c8\ub2e4. \ub2e8\uacc4 1: \ud558\ub2e8 \uba54\ub274\uc5d0\uc11c \uadf8\ub9bc \ub3c4\uad6c\uc5d0 \uc811\uadfc\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc6d0\ud558\ub294 \ubaa8\uc591\uc774\ub098 \uc120 \uc720\ud615\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ud544\uc694\ud55c \ud654\uba74\uc5d0 \uadf8\ub9bc\uc744 \uadf8\ub9bd\ub2c8\ub2e4. \uc774 \uac04\ub2e8\ud55c \ubc29\ubc95\uc740 \ucd08\ubc18 \ub808\ubca8\uc744 \uc9c4\ud589\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uadf8\ub9bc \ub3c4\uad6c\ub97c \ubb3c\ub9ac\uc801 \ubb38\uc81c\uc5d0 \ub300\ud55c \ud574\uacb0\ucc45\uc744 \ub9cc\ub4dc\ub294 \ub9c8\ubc95\uc758 \ud39c\uc73c\ub85c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694.]"}, {"question": "\uadf8\ub9bc\uc744 \uadf8\ub9b0 \ud6c4\uc5d0\ub3c4 Draw 2 Save Stick man Puzzle\uc5d0\uc11c \uc2a4\ud2f1\ub9e8\uc774 \uacc4\uc18d \uc2e4\ud328\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Draw 2 Save Stick man Puzzle\uc5d0\uc11c \uc2e4\ud328\ub294 \uc885\uc885 \uadf8\ub9bc\uc758 \uc704\uce58\uac00 \uc798\ubabb\ub418\uc5c8\uac70\ub098 \uc9c0\uc9c0\uac00 \ubd88\ucda9\ubd84\ud558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub108\ubb34 \uc9e7\uac8c \uadf8\ub9b0 \ub2e4\ub9ac\ub294 \uac04\uaca9\uc744 \uba54\uc6b0\uc9c0 \ubabb\ud574 \uc2a4\ud2f1\ub9e8\uc774 \ub5a8\uc5b4\uc9c0\ub294 \uc6d0\uc778\uc774 \ub429\ub2c8\ub2e4. \uc7a5\uc560\ubb3c\uc744 \uc644\uc804\ud788 \ud574\uacb0\ud558\ub294 \uadf8\ub9bc\uc744 \uadf8\ub9ac\uc138\uc694. [\uad6c\uc131 \ub300\uc870\ud45c: \ub2e4\ub9ac \uae38\uc774 \ub300 \uac04\uaca9 \ub108\ube44] \ub354 \ub113\uc740 \uac04\uaca9\uc5d0\ub294 \ub354 \uae34 \ub2e4\ub9ac\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ub610\ud55c, \uadf8\ub9ac\uae30\uc758 \uc548\uc815\uc131\ub3c4 \ud655\uc778\ud558\uc138\uc694. \ud754\ub4e4\ub9ac\ub294 \uc120\uc740 \uc2a4\ud2f1\ub9e8\uc758 \ubb34\uac8c\ub97c \uacac\ub51c \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."}, {"question": "Draw 2 Save Stick man Puzzle\uc5d0\uc11c \ubaa8\ub4e0 \ud50c\ub808\uc774\uc5b4\uac00 \uc219\ub2ec\ud574\uc57c \ud558\ub294 \ud544\uc218\uc801\uc778 \ub3c4\uad6c\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Draw 2 Save Stick man Puzzle\uc5d0\uc11c \uc120\uacfc \ub3c4\ud615 \ub3c4\uad6c\ub97c \uc219\ub2ec\ud558\ub294 \uac83\uc740 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc120 \ub3c4\uad6c\ub294 \ub2e4\ub9ac, \uacbd\uc0ac\ub85c \ub610\ub294 \uc7a5\ubcbd\uc744 \ub9cc\ub4dc\ub294 \ub370 \ub2e4\uc7ac\ub2e4\ub2a5\ud558\uba70, \ub3c4\ud615 \ub3c4\uad6c\ub294 \ubc29\ud328\ub098 \ud50c\ub7ab\ud3fc\uc744 \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc6d0\ud615 \ub3c4\ud615\uc744 \ubc29\ud328\ub85c \uc0ac\uc6a9\ud558\uba74 \uc2a4\ud2f1\ub9e8\uc774 \ub5a8\uc5b4\uc9c0\ub294 \ub3cc\ub85c\ubd80\ud130 \ubcf4\ud638\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \ucc28\ud2b8: \ub3c4\uad6c \uc120\ud0dd \u2192 \uadf8\ub9bc \uc801\uc6a9 \u2192 \uacb0\uacfc \ubd84\uc11d] \uc774 \ub3c4\uad6c\ub85c \uc5f0\uc2b5\ud558\uba74 \uac8c\uc784 \ud6a8\uc728\uc131\uc774 \ud06c\uac8c \ud5a5\uc0c1\ub420 \uac83\uc785\ub2c8\ub2e4."}, {"question": "Draw 2 Save Stick man Puzzle\uc5d0\uc11c \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uac00 \ubcf5\uc7a1\ud55c \ud37c\uc990\uc744 \ud574\uacb0\ud558\uae30 \uc704\ud574 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Draw 2 Save Stick man Puzzle\uc758 \uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \uc885\uc885 \ub2e4\ub2e8\uacc4 \uc804\ub7b5\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \ubaa8\ub4e0 \uc7a5\uc560\ubb3c\uc744 \uc2dd\ubcc4\ud558\uae30 \uc704\ud574 \ud37c\uc990\uc744 \ubd84\uc11d\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uac01 \uc7a5\uc560\ubb3c\uc744 \uadf9\ubcf5\ud558\uae30 \uc704\ud574 \ud544\uc694\ud55c \uadf8\ub9bc\uc758 \uc21c\uc11c\ub97c \uacc4\ud68d\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc815\ud655\ud558\uac8c \uacc4\ud68d\uc744 \uc2e4\ud589\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5ec\ub7ec \uc774\ub3d9 \uc7a5\uc560\ubb3c\uc774 \uc788\ub294 \ub808\ubca8\uc5d0\uc11c\ub294 \uc77c\ub828\uc758 \ud0c0\uc774\ubc0d \uc7a5\ubcbd\uc744 \uadf8\ub824 \uc2a4\ud2f1\ub9e8\uc744 \ubcf4\ud638\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: \ub2e8\uc77c \uc7a5\ubcbd \ub300 \uc5ec\ub7ec \ud0c0\uc774\ubc0d \uc7a5\ubcbd] \ubcf5\uc7a1\ud55c \uc0c1\ud669\uc5d0\uc11c\ub294 \uc5ec\ub7ec \uac1c\uc758 \uc2dc\uac04 \uc7a5\ubcbd\uc744 \uc0ac\uc6a9\ud558\ub294 \uac83\uc774 \ub354 \ud6a8\uacfc\uc801\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Draw 2 Save Stick man Puzzle\uc5d0\uc11c \uace0\ub4dd\uc810\uc744 \ub2ec\uc131\ud558\uae30 \uc704\ud574 \uadf8\ub9bc \uae30\uc220\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Draw 2 Save Stick man Puzzle\uc5d0\uc11c \uace0\ub4dd\uc810\uc744 \uc704\ud574 \ud6a8\uc728\uc131\uacfc \ucc3d\uc758\uc131\uc5d0 \uc9d1\uc911\ud558\uc138\uc694. \ud37c\uc990\uc744 \ud574\uacb0\ud558\uae30 \uc704\ud574 \ucd5c\uc18c\ud55c\uc758 \uc120\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. \uc120\uc774 \uc801\uc744\uc218\ub85d \uc810\uc218\uac00 \ub192\uc544\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc804\uccb4 \ub2e4\ub9ac\ub97c \uadf8\ub9ac\ub294 \ub300\uc2e0 \ub7a8\ud504\ub97c \ub9cc\ub4e4\uae30 \uc704\ud574 \ud55c \uac1c\uc758 \uc798 \ubc30\uce58\ub41c \uc120\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. [\ube44\uc720 \uc124\uba85: \uac01 \uc120\uc744 \uac78\uc791\uc758 \ubd93\ub180\ub9bc\uc73c\ub85c \uc0c1\uc0c1\ud574 \ubcf4\uc138\uc694. \ubd93\ub180\ub9bc\uc774 \uc801\uc744\uc218\ub85d \ud574\uacb0\ucc45\uc774 \ub354\uc6b1 \uc6b0\uc544\ud574\uc9d1\ub2c8\ub2e4.] \ub610\ud55c, \ube44\ud45c\uc900\uc801\uc778 \ub3c4\ud615\uc744 \uc2e4\ud5d8\ud558\uba74 \ub54c\ub85c\ub294 \ub354 \ub098\uc740 \uacb0\uacfc\uc640 \ub354 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Draw 2 Save Stick man Puzzle\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c \ub4a4\uc5d0 \uc228\uaca8\uc9c4 \uc8fc\uc694 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Draw 2 Save Stick man Puzzle\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ud6a8\uc728\uc131\uacfc \ucc3d\uc758\uc131\uc744 \ubcf4\uc0c1\ud569\ub2c8\ub2e4. \uc810\uc218\ub294 \uc0ac\uc6a9\ub41c \uc120\uc758 \uac1c\uc218\uc5d0 \ub530\ub77c \ubd80\uc5ec\ub418\uba70, \uc120\uc774 \uc801\uc744\uc218\ub85d \uc810\uc218\uac00 \ub192\uc544\uc9d1\ub2c8\ub2e4. \ub610\ud55c, \uc2a4\ud2f1\ub9e8\uc774 \uc7a5\uc560\ubb3c\uc744 \ud1b5\uacfc\ud558\ub294 \ub370 \ub2e4\uc2dc \uadf8\ub9ac\uc9c0 \uc54a\uace0 \uc131\uacf5\uc801\uc73c\ub85c \uc774\ub3d9\ud558\uba74 \ubcf4\ub108\uc2a4 \uc810\uc218\uac00 \ucd94\uac00\ub429\ub2c8\ub2e4. [\uad6c\uc131 \ub300\uc870\ud45c: \uc0ac\uc6a9\ub41c \uc120 \uc218 \ub300 \uc810\uc218] \uc608\ub97c \ub4e4\uc5b4, \ud37c\uc990\uc744 \ud480\uae30 \uc704\ud574 \ud55c \uac1c\uc758 \uc120\uc744 \uc0ac\uc6a9\ud558\uba74 100\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc9c0\ub9cc \uc138 \uac1c\uc758 \uc120\uc744 \uc0ac\uc6a9\ud558\uba74 \uc810\uc218\uac00 70\uc810\uc73c\ub85c \uc904\uc5b4\ub4ed\ub2c8\ub2e4."}, {"question": "Draw 2 Save Stick man Puzzle\uc758 \ubb3c\ub9ac \uc5d4\uc9c4\uc740 \ud37c\uc990 \ud574\uacb0\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "Draw 2 Save Stick man Puzzle\uc758 \ubb3c\ub9ac \uc5d4\uc9c4\uc740 \uadf8\ub9bc\uc758 \uc131\uacf5 \uc5ec\ubd80\ub97c \uacb0\uc815\ud558\ub294 \ub370 \uc911\uc694\ud55c \uc5ed\ud560\uc744 \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac00\ud30c\ub978 \uac01\ub3c4\ub85c \uadf8\ub9b0 \ub2e4\ub9ac\ub294 \uc2a4\ud2f1\ub9e8\uc758 \ubb34\uac8c\ub97c \uacac\ub514\uc9c0 \ubabb\ud558\uace0 \ubb34\ub108\uc9c8 \uc218 \uc788\uc9c0\ub9cc, \uc644\ub9cc\ud55c \uacbd\uc0ac\uba74\uc758 \uacbd\uc0ac\ub85c\ub294 \uc548\uc815\uc801\uc785\ub2c8\ub2e4. \uc911\ub825, \ubb34\uac8c \ubd84\ubc30 \ubc0f \uc7ac\ub8cc \ud2b9\uc131(\uc608: \uc120 \ub450\uaed8)\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \ucc28\ud2b8: \uadf8\ub9bc \uc0dd\uc131 \u2192 \ubb3c\ub9ac \uc2dc\ubbac\ub808\uc774\uc158 \u2192 \uacb0\uacfc \ud3c9\uac00] \uc774 \uc9c0\uc2dd\uc740 \ubcf5\uc7a1\ud55c \ud37c\uc990\uc5d0 \ud6a8\uacfc\uc801\uc778 \ud574\uacb0\ucc45\uc744 \uad6c\ucd95\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 Draw 2 Save Stick man Puzzle\uc5d0\uc11c \ud55c \uae30\uae30\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub124, \ud50c\ub808\uc774\uc5b4\ub294 \uac8c\uc784\uc744 \ud074\ub77c\uc6b0\ub4dc \uacc4\uc815\uc5d0 \uc5f0\uacb0\ud558\uc5ec Draw 2 Save Stick man Puzzle\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc124\uc815 \uba54\ub274\ub85c \uc774\ub3d9\ud558\uc5ec '\ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5'\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc6d0\ud558\ub294 \ud074\ub77c\uc6b0\ub4dc \uc11c\ube44\uc2a4(\uc608: Google Play, Apple Game Center)\ub85c \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ud604\uc7ac \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5c5\ub85c\ub4dc\ud569\ub2c8\ub2e4. \uae30\uae30\ub97c \ubc14\uafc0 \ub54c\ub294 \ub3d9\uc77c\ud55c \ud074\ub77c\uc6b0\ub4dc \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uc5ec \ub370\uc774\ud130\ub97c \uac80\uc0c9\ud558\uba74 \ub429\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: \uc218\ub3d9 \uc800\uc7a5 \ub300 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5] \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ud1b5\ud574 \ud50c\ub7ab\ud3fc \uac04\uc758 \uc9c4\ud589 \uc0c1\ud669 \uc774\uc804\uc774 \uc6d0\ud65c\ud574\uc9d1\ub2c8\ub2e4."}, {"question": "Draw 2 Save Stick man Puzzle\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\ub098\uc694?", "answer": "Draw 2 Save Stick man Puzzle\uc5d0\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uae30\ub2a5\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud2b9\uc815 \ub808\ubca8\uc5d0\uc11c \ubcc4\uc774\ub098 \uc2ec\uc7a5\uacfc \uac19\uc740 \ud2b9\uc815 \ubaa8\uc591\uc744 \uadf8\ub9ac\uba74 \ubcf4\ub108\uc2a4 \ub610\ub294 \uc560\ub2c8\uba54\uc774\uc158\uc744 \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \uc77c\ubd80 \ub808\ubca8\uc5d0\ub294 \uc608\uc0c1\uce58 \ubabb\ud55c \uc601\uc5ed\uc5d0 \uadf8\ub9bc\uc744 \uadf8\ub9ac\uba74 \ub4dc\ub7ec\ub098\ub294 \uc228\uaca8\uc9c4 \uacbd\ub85c\uac00 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uae30\ub2a5\uc744 \uc801\uc808\ud55c \uc5f4\uc1e0(\uadf8\ub9bc)\ub85c \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \ubcf4\ubb3c \uc0c1\uc790\ub85c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694.] \uc774\ub7ec\ud55c \uc694\uc18c\ub97c \ud0d0\uc0c9\ud558\uba74 \uac8c\uc784\uc5d0 \ucd94\uac00\uc801\uc778 \uc7ac\ubbf8\uc640 \ub3c4\uc804\uc744 \ub354\ud569\ub2c8\ub2e4."}]
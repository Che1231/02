[{"question": "\u5982\u4f55\u4ee5\u521d\u5b78\u8005\u7684\u8eab\u4efd\u5728Draw 2 Save Stick man Puzzle\u4e2d\u57f7\u884c\u57fa\u672c\u7e6a\u5716\u52d5\u4f5c\uff1f", "answer": "\u5728Draw 2 Save Stick man Puzzle\u4e2d\uff0c\u521d\u5b78\u8005\u53ef\u4ee5\u5f9e\u4f7f\u7528\u7e6a\u5716\u5de5\u5177\u4f86\u5275\u5efa\u7dda\u689d\u6216\u5f62\u72c0\u958b\u59cb\uff0c\u4ee5\u5e6b\u52a9\u5c0f\u68cd\u4eba\u7a7f\u8d8a\u969c\u7919\u7269\u3002\u4f8b\u5982\uff0c\u5728\u9593\u9699\u4e0a\u756b\u4e00\u5ea7\u6a4b\u6a11\uff0c\u6216\u5728\u6389\u843d\u7269\u9ad4\u6642\u756b\u4e00\u9762\u76fe\u724c\u3002\u6b65\u9a5f1\uff1a\u5f9e\u5e95\u90e8\u9078\u55ae\u4e2d\u5b58\u53d6\u7e6a\u5716\u5de5\u5177\u3002\u6b65\u9a5f2\uff1a\u9078\u64c7\u6240\u9700\u7684\u5f62\u72c0\u6216\u7dda\u689d\u985e\u578b\u3002\u6b65\u9a5f3\uff1a\u5728\u87a2\u5e55\u6240\u9700\u4f4d\u7f6e\u7e6a\u5716\u3002\u9019\u500b\u7c21\u55ae\u7684\u65b9\u6cd5\u5c0d\u65bc\u5b8c\u6210\u65e9\u671f\u95dc\u5361\u81f3\u95dc\u91cd\u8981\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u7e6a\u5716\u5de5\u5177\u60f3\u50cf\u6210\u4e00\u652f\u5275\u9020\u89e3\u6c7a\u7269\u7406\u554f\u984c\u7684\u9b54\u6cd5\u7b46\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u7684\u4eba\u7269\u5728Draw 2 Save Stick man Puzzle\u904a\u6232\u4e2d\uff0c\u5373\u4f7f\u7e6a\u5716\u5b8c\u6210\u5f8c\u4ecd\u4e0d\u65b7\u5931\u6557\uff1f", "answer": "\u5728Draw 2 Save Stick man Puzzle\u904a\u6232\u4e2d\uff0c\u5931\u6557\u901a\u5e38\u662f\u56e0\u7e6a\u5716\u4f4d\u7f6e\u932f\u8aa4\u6216\u652f\u6490\u4e0d\u8db3\u6240\u81f4\u3002\u4f8b\u5982\uff0c\u4e00\u5ea7\u756b\u5f97\u592a\u77ed\u7684\u6a4b\u6a11\u7121\u6cd5\u6db5\u84cb\u9593\u9699\uff0c\u5c0e\u81f4\u5c0f\u68cd\u4eba\u8dcc\u843d\u3002\u8acb\u78ba\u4fdd\u60a8\u7684\u7e6a\u5716\u5b8c\u5168\u89e3\u6c7a\u969c\u7919\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6a4b\u6a11\u9577\u5ea6\u8207\u9593\u9699\u5bec\u5ea6] \u66f4\u5bec\u7684\u9593\u9699\u9700\u8981\u66f4\u9577\u7684\u6a4b\u6a11\u3002\u6b64\u5916\uff0c\u4e5f\u8981\u6aa2\u67e5\u7e6a\u5716\u7684\u7a69\u5b9a\u6027\uff1b\u4e00\u689d\u6416\u6416\u6b32\u589c\u7684\u7dda\u689d\u53ef\u80fd\u6703\u5728\u5c0f\u68cd\u4eba\u7684\u91cd\u91cf\u4e0b\u5d29\u6f70\u3002"}, {"question": "Draw 2 Save Stick man Puzzle\u904a\u6232\u4e2d\uff0c\u6bcf\u4f4d\u73a9\u5bb6\u90fd\u61c9\u8a72\u7cbe\u901a\u54ea\u4e9b\u5fc5\u5099\u5de5\u5177\uff1f", "answer": "\u5728Draw 2 Save Stick man Puzzle\u904a\u6232\u4e2d\uff0c\u638c\u63e1\u7dda\u689d\u548c\u5f62\u72c0\u5de5\u5177\u81f3\u95dc\u91cd\u8981\u3002\u7dda\u689d\u5de5\u5177\u9069\u7528\u65bc\u5275\u4f5c\u6a4b\u6a11\u3001\u659c\u5761\u6216\u969c\u7919\uff0c\u800c\u5f62\u72c0\u5de5\u5177\u5247\u53ef\u4ee5\u7528\u65bc\u88fd\u4f5c\u76fe\u724c\u6216\u5e73\u53f0\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u5713\u5f62\u5f62\u72c0\u4f5c\u70ba\u76fe\u724c\u53ef\u4ee5\u4fdd\u8b77\u5c0f\u68cd\u4eba\u514d\u53d7\u77f3\u584a\u589c\u843d\u7684\u50b7\u5bb3\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u5de5\u5177\u9078\u64c7\u2192\u7e6a\u5716\u61c9\u7528\u2192\u7d50\u679c\u5206\u6790] \u7df4\u7fd2\u4f7f\u7528\u9019\u4e9b\u5de5\u5177\u5c07\u986f\u8457\u63d0\u9ad8\u60a8\u7684\u904a\u6232\u6548\u7387\u3002"}, {"question": "\u9032\u968e\u73a9\u5bb6\u5728Draw 2 Save Stick man Puzzle\u904a\u6232\u4e2d\uff0c\u53ef\u4ee5\u904b\u7528\u54ea\u4e9b\u7b56\u7565\u4f86\u89e3\u6c7a\u8907\u96dc\u7684\u8b0e\u984c\uff1f", "answer": "\u5728Draw 2 Save Stick man Puzzle\u904a\u6232\u4e2d\uff0c\u9032\u968e\u73a9\u5bb6\u901a\u5e38\u6703\u63a1\u7528\u591a\u6b65\u9a5f\u7b56\u7565\u3002\u6b65\u9a5f1\uff1a\u5206\u6790\u8b0e\u984c\uff0c\u627e\u51fa\u6240\u6709\u969c\u7919\u3002\u6b65\u9a5f2\uff1a\u898f\u5283\u514b\u670d\u6bcf\u500b\u969c\u7919\u6240\u9700\u7684\u7e6a\u5716\u9806\u5e8f\u3002\u6b65\u9a5f3\uff1a\u7cbe\u78ba\u57f7\u884c\u8a08\u5283\u3002\u4f8b\u5982\uff0c\u5728\u5305\u542b\u591a\u500b\u79fb\u52d5\u5371\u96aa\u7684\u95dc\u5361\u4e2d\uff0c\u7e6a\u88fd\u4e00\u7cfb\u5217\u6642\u9593\u969c\u7919\u53ef\u4ee5\u4fdd\u8b77\u5c0f\u68cd\u4eba\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u55ae\u4e00\u969c\u7919 vs. \u591a\u500b\u6642\u9593\u969c\u7919] \u5728\u8907\u96dc\u60c5\u6cc1\u4e0b\u4f7f\u7528\u591a\u500b\u6642\u9593\u969c\u7919\u53ef\u80fd\u66f4\u6709\u6548\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728Draw 2 Save Stick man Puzzle\u904a\u6232\u4e2d\u512a\u5316\u5176\u7e6a\u5716\u6280\u5de7\u4ee5\u9054\u6210\u9ad8\u5206\uff1f", "answer": "\u70ba\u4e86\u5728Draw 2 Save Stick man Puzzle\u904a\u6232\u4e2d\u512a\u5316\u5f97\u5206\uff0c\u8acb\u5c08\u6ce8\u65bc\u6548\u7387\u548c\u5275\u610f\u3002\u4f7f\u7528\u6700\u5c11\u7684\u7dda\u689d\u4f86\u89e3\u6c7a\u8b0e\u984c\uff0c\u56e0\u70ba\u8f03\u5c11\u7684\u7dda\u689d\u53ef\u80fd\u5c0e\u81f4\u8f03\u9ad8\u7684\u5206\u6578\u3002\u4f8b\u5982\uff0c\u4e0d\u8981\u756b\u6574\u5ea7\u6a4b\u6a11\uff0c\u800c\u6539\u7528\u4e00\u6839\u5de7\u5999\u653e\u7f6e\u7684\u7dda\u689d\u4f86\u5275\u9020\u659c\u5761\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u6bcf\u4e00\u689d\u7dda\u689d\u90fd\u662f\u4e00\u5e45\u5091\u4f5c\u4e2d\u7684\u7b46\u89f8\uff1b\u7b46\u89f8\u8d8a\u5c11\uff0c\u89e3\u6c7a\u65b9\u6848\u5c31\u8d8a\u512a\u96c5\u3002] \u6b64\u5916\uff0c\u5617\u8a66\u4f7f\u7528\u975e\u50b3\u7d71\u5f62\u72c0\u6709\u6642\u4e5f\u80fd\u7372\u5f97\u66f4\u597d\u7684\u7d50\u679c\u548c\u66f4\u9ad8\u7684\u5206\u6578\u3002"}, {"question": "Draw 2 Save Stick man Puzzle\u904a\u6232\u4e2d\u7684\u8a08\u5206\u7cfb\u7d71\u80cc\u5f8c\u6709\u54ea\u4e9b\u95dc\u9375\u6a5f\u5236\uff1f", "answer": "Draw 2 Save Stick man Puzzle\u904a\u6232\u7684\u8a08\u5206\u7cfb\u7d71\u734e\u52f5\u6548\u7387\u548c\u5275\u610f\u3002\u5206\u6578\u6839\u64da\u4f7f\u7528\u7684\u7dda\u689d\u6578\u4f86\u8a08\u7b97\uff0c\u4f7f\u7528\u8f03\u5c11\u7684\u7dda\u689d\u6703\u5c0e\u81f4\u8f03\u9ad8\u7684\u5206\u6578\u3002\u6b64\u5916\uff0c\u6210\u529f\u5730\u5f15\u5c0e\u5c0f\u68cd\u4eba\u7a7f\u8d8a\u969c\u7919\u7269\u800c\u4e0d\u91cd\u65b0\u7e6a\u5716\u4e5f\u6703\u7372\u5f97\u984d\u5916\u5206\u6578\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u4f7f\u7528\u7dda\u689d\u6578 vs. \u7372\u5f97\u5206\u6578] \u4f8b\u5982\uff0c\u4f7f\u7528\u4e00\u689d\u7dda\u689d\u4f86\u89e3\u6c7a\u4e00\u500b\u8b0e\u984c\u53ef\u80fd\u6703\u7372\u5f97 100 \u5206\uff0c\u800c\u4f7f\u7528\u4e09\u689d\u7dda\u689d\u5247\u53ef\u80fd\u6703\u5c07\u5206\u6578\u964d\u4f4e\u81f3 70 \u5206\u3002"}, {"question": "\u904a\u6232\u7684\u7269\u7406\u5f15\u64ce\u5982\u4f55\u5728Draw 2 Save Stick man Puzzle\u904a\u6232\u4e2d\u5f71\u97ff\u8b0e\u984c\u7684\u89e3\u6cd5\uff1f", "answer": "Draw 2 Save Stick man Puzzle\u904a\u6232\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u5728\u6c7a\u5b9a\u60a8\u7684\u7e6a\u5716\u6210\u529f\u8207\u5426\u626e\u6f14\u8457\u95dc\u9375\u89d2\u8272\u3002\u4f8b\u5982\uff0c\u4ee5\u9661\u5ced\u7684\u89d2\u5ea6\u7e6a\u88fd\u7684\u6a4b\u6a11\u53ef\u80fd\u6703\u5728\u5c0f\u68cd\u4eba\u7684\u91cd\u91cf\u4e0b\u5d29\u584c\uff0c\u800c\u4e00\u500b\u7de9\u548c\u7684\u659c\u5761\u5247\u6703\u7a69\u56fa\u3002\u4e86\u89e3\u91cd\u529b\u3001\u91cd\u91cf\u5206\u914d\u548c\u6750\u8cea\u7279\u6027\uff08\u4f8b\u5982\u7dda\u689d\u7c97\u7d30\uff09\u81f3\u95dc\u91cd\u8981\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u7e6a\u5716\u5275\u4f5c\u2192\u7269\u7406\u6a21\u64ec\u2192\u7d50\u679c\u8a55\u4f30] \u9019\u4e9b\u77e5\u8b58\u6709\u52a9\u65bc\u8a2d\u8a08\u51fa\u6709\u6548\u89e3\u6c7a\u8907\u96dc\u8b0e\u984c\u7684\u65b9\u6848\u3002"}, {"question": "\u73a9\u5bb6\u662f\u5426\u53ef\u4ee5\u5728Draw 2 Save Stick man Puzzle\u904a\u6232\u4e2d\u5c07\u5176\u9032\u5ea6\u5f9e\u4e00\u500b\u88dd\u7f6e\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u88dd\u7f6e\uff1f", "answer": "\u662f\u7684\uff0c\u73a9\u5bb6\u53ef\u4ee5\u4f7f\u7528\u96f2\u7aef\u5e33\u6236\u5c07Draw 2 Save Stick man Puzzle\u904a\u6232\u4e2d\u7684\u9032\u5ea6\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u88dd\u7f6e\u3002\u6b65\u9a5f1\uff1a\u524d\u5f80\u8a2d\u5b9a\u9078\u55ae\uff0c\u9078\u64c7\u300c\u96f2\u7aef\u5132\u5b58\u300d\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u60a8\u504f\u597d\u7684\u96f2\u7aef\u670d\u52d9\u767b\u5165\uff08\u4f8b\u5982\uff0cGoogle Play\u3001Apple Game Center\uff09\u3002\u6b65\u9a5f3\uff1a\u4e0a\u50b3\u60a8\u7684\u7576\u524d\u9032\u5ea6\u3002\u5207\u63db\u88dd\u7f6e\u6642\uff0c\u53ea\u9700\u767b\u5165\u76f8\u540c\u7684\u96f2\u7aef\u5e33\u6236\u5373\u53ef\u53d6\u56de\u60a8\u7684\u8cc7\u6599\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u624b\u52d5\u5132\u5b58 vs. \u96f2\u7aef\u5132\u5b58] \u96f2\u7aef\u5132\u5b58\u78ba\u4fdd\u5e73\u53f0\u9593\u7684\u9032\u5ea6\u7121\u7e2b\u8f49\u79fb\u3002"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728Draw 2 Save Stick man Puzzle\u904a\u6232\u4e2d\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "Draw 2 Save Stick man Puzzle\u904a\u6232\u5305\u542b\u591a\u500b\u96b1\u85cf\u529f\u80fd\u548c\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u5728\u67d0\u4e9b\u95dc\u5361\u4e2d\u7e6a\u88fd\u7279\u5b9a\u7684\u5f62\u72c0\uff08\u4f8b\u5982\u661f\u661f\u6216\u5fc3\u5f62\uff09\u53ef\u4ee5\u89e3\u9396\u79d8\u5bc6\u734e\u52f5\u6216\u52d5\u756b\u3002\u6b64\u5916\uff0c\u4e00\u4e9b\u95dc\u5361\u6709\u96b1\u85cf\u7684\u901a\u9053\uff0c\u53ef\u4ee5\u900f\u904e\u5728\u9810\u6599\u4e4b\u5916\u7684\u5730\u5340\u7e6a\u5716\u4f86\u63ed\u793a\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u9019\u4e9b\u96b1\u85cf\u529f\u80fd\u60f3\u50cf\u6210\u7b49\u5f85\u7528\u6b63\u78ba\u7684\u9470\u5319\uff08\u7e6a\u5716\uff09\u958b\u555f\u7684\u5bf6\u7bb1\u3002] \u63a2\u7d22\u9019\u4e9b\u5143\u7d20\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u984d\u5916\u7684\u4e00\u5c64\u8da3\u5473\u548c\u6311\u6230\u3002"}]
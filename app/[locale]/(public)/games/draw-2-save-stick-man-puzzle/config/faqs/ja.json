[{"question": "\u521d\u5fc3\u8005\u5411\u3051\u306b\u3001Draw 2 Save Stick man Puzzle\u306e\u57fa\u672c\u7684\u306a\u63cf\u753b\u64cd\u4f5c\u65b9\u6cd5\u3092\u6559\u3048\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "Draw 2 Save Stick man Puzzle\u3067\u306f\u3001\u521d\u5fc3\u8005\u306e\u65b9\u3005\u306f\u3001\u307e\u305a\u63cf\u753b\u30c4\u30fc\u30eb\u3092\u4f7f\u3063\u3066\u3001\u68d2\u4eba\u9593\u304c\u969c\u5bb3\u7269\u3092\u4e57\u308a\u8d8a\u3048\u308b\u306e\u306b\u5f79\u7acb\u3064\u7dda\u3084\u5f62\u3092\u63cf\u304f\u3053\u3068\u304b\u3089\u59cb\u3081\u3089\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u9699\u9593\u3092\u6a4b\u3067\u3064\u306a\u3050\u3001\u3042\u308b\u3044\u306f\u843d\u4e0b\u7269\u304b\u3089\u8eab\u3092\u5b88\u308b\u305f\u3081\u306e\u76fe\u3092\u63cf\u304f\u3053\u3068\u306a\u3069\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u4e0b\u90e8\u306e\u30e1\u30cb\u30e5\u30fc\u304b\u3089\u63cf\u753b\u30c4\u30fc\u30eb\u306b\u30a2\u30af\u30bb\u30b9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5fc5\u8981\u306a\u5f62\u3084\u7dda\u306e\u7a2e\u985e\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u753b\u9762\u306e\u5fc5\u8981\u306a\u5834\u6240\u306b\u63cf\u753b\u3057\u307e\u3059\u3002\u3053\u306e\u30b7\u30f3\u30d7\u30eb\u306a\u65b9\u6cd5\u306f\u3001\u521d\u671f\u30ec\u30d9\u30eb\u306e\u653b\u7565\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002[\u4f8b\u3048\u8aac\u660e\uff1a\u63cf\u753b\u30c4\u30fc\u30eb\u3092\u3001\u7269\u7406\u7684\u306a\u554f\u984c\u3092\u89e3\u6c7a\u3059\u308b\u9b54\u6cd5\u306e\u30da\u30f3\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u63cf\u753b\u3057\u305f\u5f8c\u3082\u3001Draw 2 Save Stick man Puzzle\u3067\u68d2\u4eba\u9593\u304c\u5931\u6557\u3057\u7d9a\u3051\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "Draw 2 Save Stick man Puzzle\u3067\u5931\u6557\u3059\u308b\u539f\u56e0\u306f\u3001\u3057\u3070\u3057\u3070\u63cf\u753b\u4f4d\u7f6e\u306e\u8aa4\u308a\u3001\u307e\u305f\u306f\u652f\u3048\u4e0d\u8db3\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u6a4b\u304c\u77ed\u3059\u304e\u3066\u9699\u9593\u3092\u3075\u3055\u3052\u306a\u3044\u5834\u5408\u3001\u68d2\u4eba\u9593\u306f\u843d\u4e0b\u3057\u3066\u3057\u307e\u3044\u307e\u3059\u3002\u5fc5\u305a\u3001\u969c\u5bb3\u7269\u3092\u5b8c\u5168\u306b\u89e3\u6c7a\u3059\u308b\u3088\u3046\u306a\u63cf\u753b\u3092\u884c\u3063\u3066\u304f\u3060\u3055\u3044\u3002[\u5bfe\u5fdc\u8868\uff1a\u6a4b\u306e\u9577\u3055 vs. \u30ae\u30e3\u30c3\u30d7\u306e\u5e45] \u5e45\u306e\u5e83\u3044\u30ae\u30e3\u30c3\u30d7\u306b\u306f\u3001\u3088\u308a\u9577\u3044\u6a4b\u304c\u5fc5\u8981\u3067\u3059\u3002\u307e\u305f\u3001\u63cf\u753b\u306e\u5b89\u5b9a\u6027\u3082\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u63fa\u3089\u3044\u3060\u7dda\u306f\u3001\u68d2\u4eba\u9593\u306e\u91cd\u3055\u3067\u5d29\u58ca\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "Draw 2 Save Stick man Puzzle\u3067\u3001\u3059\u3079\u3066\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30de\u30b9\u30bf\u30fc\u3059\u3079\u304d\u5fc5\u9808\u30c4\u30fc\u30eb\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Draw 2 Save Stick man Puzzle\u3067\u306f\u3001\u7dda\u3068\u5f62\u72b6\u30c4\u30fc\u30eb\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002\u7dda\u30c4\u30fc\u30eb\u306f\u3001\u6a4b\u3001\u30e9\u30f3\u30d7\u3001\u307e\u305f\u306f\u30d0\u30ea\u30a2\u3092\u4f5c\u6210\u3059\u308b\u306e\u306b\u591a\u7528\u9014\u306b\u4f7f\u7528\u3067\u304d\u3001\u4e00\u65b9\u3001\u5f62\u72b6\u30c4\u30fc\u30eb\u306f\u76fe\u3084\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u4f5c\u6210\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5186\u5f62\u3092\u76fe\u3068\u3057\u3066\u4f7f\u3046\u3053\u3068\u306b\u3088\u308a\u3001\u68d2\u4eba\u9593\u306f\u843d\u4e0b\u3059\u308b\u5ca9\u304b\u3089\u8eab\u3092\u5b88\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30c4\u30fc\u30eb\u9078\u629e\u2192\u63cf\u753b\u9069\u7528\u2192\u7d50\u679c\u5206\u6790] \u3053\u308c\u3089\u306e\u30c4\u30fc\u30eb\u3092\u4f7f\u3063\u3066\u7df4\u7fd2\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u52b9\u7387\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002"}, {"question": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001Draw 2 Save Stick man Puzzle\u306e\u8907\u96d1\u306a\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u305f\u3081\u306b\u3069\u306e\u3088\u3046\u306a\u6226\u7565\u3092\u4f7f\u7528\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Draw 2 Save Stick man Puzzle\u306b\u304a\u3051\u308b\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u3057\u3070\u3057\u3070\u8907\u6570\u6bb5\u968e\u306e\u6226\u7565\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30d1\u30ba\u30eb\u3092\u5206\u6790\u3057\u3066\u3001\u3059\u3079\u3066\u306e\u969c\u5bb3\u7269\u3092\u7279\u5b9a\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5404\u969c\u5bb3\u7269\u3092\u514b\u670d\u3059\u308b\u305f\u3081\u306b\u5fc5\u8981\u306a\u63cf\u753b\u306e\u9806\u5e8f\u3092\u8a08\u753b\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6b63\u78ba\u306b\u8a08\u753b\u3092\u5b9f\u884c\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u8907\u6570\u306e\u79fb\u52d5\u3059\u308b\u5371\u967a\u7269\u304c\u3042\u308b\u30ec\u30d9\u30eb\u3067\u306f\u3001\u4e00\u9023\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u8a08\u3063\u305f\u30d0\u30ea\u30a2\u3092\u63cf\u304f\u3053\u3068\u3067\u3001\u68d2\u4eba\u9593\u3092\u5b88\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03\u8868\uff1a\u5358\u4e00\u306e\u30d0\u30ea\u30a2 vs. \u8907\u6570\u30bf\u30a4\u30df\u30f3\u30b0\u306e\u30d0\u30ea\u30a2] \u8907\u6570\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u8a08\u3063\u305f\u30d0\u30ea\u30a2\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u8907\u96d1\u306a\u30b7\u30ca\u30ea\u30aa\u3067\u3088\u308a\u52b9\u679c\u7684\u3067\u3059\u3002"}, {"question": "Draw 2 Save Stick man Puzzle\u3067\u3001\u9ad8\u30b9\u30b3\u30a2\u7372\u5f97\u306e\u305f\u3081\u306b\u63cf\u753b\u30c6\u30af\u30cb\u30c3\u30af\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "Draw 2 Save Stick man Puzzle\u3067\u9ad8\u30b9\u30b3\u30a2\u3092\u72d9\u3046\u305f\u3081\u306b\u306f\u3001\u52b9\u7387\u6027\u3068\u5275\u9020\u6027\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3057\u3087\u3046\u3002\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u305f\u3081\u306b\u5fc5\u8981\u306a\u7dda\u3092\u6700\u5c0f\u9650\u306b\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6a4b\u5168\u4f53\u3092\u63cf\u304f\u4ee3\u308f\u308a\u306b\u30011\u672c\u306e\u9069\u5207\u306a\u4f4d\u7f6e\u306e\u7dda\u3092\u4f7f\u3063\u3066\u30e9\u30f3\u30d7\u3092\u4f5c\u6210\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002[\u4f8b\u3048\u8aac\u660e\uff1a\u305d\u308c\u305e\u308c\u306e\u7dda\u3092\u3001\u5091\u4f5c\u306b\u304a\u3051\u308b\u7b46\u306e\u30bf\u30c3\u30c1\u3068\u8003\u3048\u307e\u3057\u3087\u3046\u3002\u30b9\u30c8\u30ed\u30fc\u30af\u304c\u5c11\u306a\u3044\u307b\u3069\u3001\u89e3\u6c7a\u7b56\u306f\u6d17\u7df4\u3055\u308c\u307e\u3059\u3002] \u307e\u305f\u3001\u975e\u5f93\u6765\u306e\u5f62\u72b6\u3092\u8a66\u3059\u3053\u3068\u3082\u3001\u5834\u5408\u306b\u3088\u3063\u3066\u306f\u3088\u308a\u826f\u3044\u7d50\u679c\u3068\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u3082\u305f\u3089\u3057\u307e\u3059\u3002"}, {"question": "Draw 2 Save Stick man Puzzle\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306e\u80cc\u5f8c\u306b\u3042\u308b\u4e3b\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Draw 2 Save Stick man Puzzle\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u3067\u306f\u3001\u52b9\u7387\u6027\u3068\u5275\u9020\u6027\u304c\u304a\u304a\u3044\u306b\u8a55\u4fa1\u3055\u308c\u307e\u3059\u3002\u5f97\u70b9\u306f\u4f7f\u7528\u3057\u305f\u7dda\u306e\u6570\u306b\u57fa\u3065\u3044\u3066\u4ed8\u4e0e\u3055\u308c\u3001\u7dda\u304c\u5c11\u306a\u3044\u307b\u3069\u30b9\u30b3\u30a2\u304c\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u969c\u5bb3\u7269\u3092\u518d\u63cf\u753b\u3059\u308b\u3053\u3068\u306a\u304f\u68d2\u4eba\u9593\u3092\u7121\u4e8b\u306b\u901a\u904e\u3055\u305b\u308b\u3053\u3068\u3067\u3001\u30dc\u30fc\u30ca\u30b9\u70b9\u304c\u52a0\u7b97\u3055\u308c\u307e\u3059\u3002[\u5bfe\u5fdc\u8868\uff1a\u4f7f\u7528\u3057\u305f\u7dda\u6570 vs. \u5f97\u70b9] \u4f8b\u3048\u3070\u3001\u30d1\u30ba\u30eb\u30921\u672c\u306e\u7dda\u3067\u89e3\u304f\u3068100\u70b9\u304c\u5f97\u3089\u308c\u308b\u306e\u306b\u5bfe\u3057\u30013\u672c\u306e\u7dda\u3092\u4f7f\u3046\u3068\u5f97\u70b9\u304c70\u70b9\u306b\u6e1b\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002"}, {"question": "\u30b2\u30fc\u30e0\u306e\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u306f\u3001Draw 2 Save Stick man Puzzle\u306e\u30d1\u30ba\u30eb\u89e3\u6c7a\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "Draw 2 Save Stick man Puzzle\u306e\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u306f\u3001\u63cf\u753b\u306e\u6210\u529f\u3092\u6c7a\u5b9a\u3059\u308b\u91cd\u8981\u306a\u5f79\u5272\u3092\u679c\u305f\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6025\u306a\u89d2\u5ea6\u3067\u6a4b\u3092\u63cf\u304f\u3068\u68d2\u4eba\u9593\u306e\u91cd\u307f\u3067\u5d29\u308c\u3066\u3057\u307e\u3046\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u304c\u3001\u7de9\u3084\u304b\u306a\u52fe\u914d\u306e\u30e9\u30f3\u30d7\u306a\u3089\u5b89\u5b9a\u3057\u3066\u3044\u307e\u3059\u3002\u91cd\u529b\u3001\u91cd\u91cf\u5206\u5e03\u3001\u7d20\u6750\u306e\u7279\u6027\uff08\u7dda\u306e\u592a\u3055\u306a\u3069\uff09\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u63
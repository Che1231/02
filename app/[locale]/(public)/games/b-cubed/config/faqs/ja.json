[{"question": "B-Cubed\u30d3\u30ae\u30ca\u30fc\u5165\u9580\uff1a\u57fa\u672c\u7684\u306a\u79fb\u52d5\u3068\u30d6\u30ed\u30c3\u30af\u306e\u914d\u7f6e\u306e\u30c6\u30af\u30cb\u30c3\u30af\u3092\u7d20\u65e9\u304f\u7fd2\u5f97\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f\u304a\u3059\u3059\u3081\u306e\u521d\u5fc3\u8005\u5411\u3051\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3084\u7df4\u7fd2\u30e2\u30fc\u30c9\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "B-Cubed\u3067\u306f\u3001\u57fa\u672c\u7684\u306a\u79fb\u52d5\u3068\u30d6\u30ed\u30c3\u30af\u306e\u914d\u7f6e\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u306f\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u65b0\u53c2\u8005\u306f\u307e\u305a\u3001\u30b2\u30fc\u30e0\u5185\u306e\u300c\u65b0\u53c2\u8005\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u30ad\u30e3\u30f3\u30d7\u300d\u30e2\u30fc\u30c9\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3092\u304a\u52e7\u3081\u3057\u307e\u3059\u3002\u3053\u306e\u30e2\u30fc\u30c9\u3067\u306f\u3001\u79fb\u52d5\u3001\u56de\u8ee2\u3001\u30d6\u30ed\u30c3\u30af\u306e\u914d\u7f6e\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u304c\u8a73\u7d30\u306b\u8aac\u660e\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u30b2\u30fc\u30e0\u5185\u3067\u306f\u3001\u65b9\u5411\u30ad\u30fc\u3067\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u79fb\u52d5\u3057\u3001\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u3067\u30d6\u30ed\u30c3\u30af\u3092\u56de\u8ee2\u3055\u305b\u3001Z\u30ad\u30fc\u3067\u30d6\u30ed\u30c3\u30af\u3092\u7d20\u65e9\u304f\u843d\u3068\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002 \u4f8b\u3048\u3070\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001L\u5b57\u578b\u30d6\u30ed\u30c3\u30af\u3092\u51f9\u90e8\u306b\u5b8c\u5168\u306b\u57cb\u3081\u8fbc\u3080\u305f\u3081\u306b\u56de\u8ee2\u3092\u6d3b\u7528\u3059\u308b\u3053\u3068\u3092\u5b66\u3076\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30c1\u30e3\u30ec\u30f3\u30b8\u30e2\u30fc\u30c9\u306e\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3092\u7e70\u308a\u8fd4\u3057\u7df4\u7fd2\u3059\u308b\u3053\u3068\u3067\u3001\u624b\u65e9\u304f\u53cd\u5fdc\u3059\u308b\u80fd\u529b\u3092\u5411\u4e0a\u3055\u305b\u3001\u5f8c\u306e\u30ec\u30d9\u30eb\u306e\u305f\u3081\u306e\u5805\u5b9f\u306a\u57fa\u790e\u3092\u7bc9\u304f\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u306a\u305c\u79c1\u306eB-Cubed\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306f\u58c1\u3084\u30d6\u30ed\u30c3\u30af\u306b\u631f\u307e\u3063\u3066\u52d5\u304b\u306a\u3044\u306e\u3067\u3059\u304b\uff1f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u58c1\u3084\u30d6\u30ed\u30c3\u30af\u306e\u9593\u306b\u631f\u307e\u3063\u3066\u52d5\u3051\u306a\u304f\u306a\u308b\u306e\u3092\u907f\u3051\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u52d5\u304b\u306a\u304f\u306a\u308b\u306e\u306f\u3001\u901a\u5e38\u3001\u885d\u7a81\u5224\u5b9a\u3084\u3001\u6025\u964d\u4e0b\u306e\u969b\u306b\u7740\u5730\u5730\u70b9\u304c\u969c\u5bb3\u7269\u306b\u963b\u307e\u308c\u305f\u3053\u3068\u306b\u3088\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u631f\u307e\u3063\u3066\u3044\u308b\u72b6\u614b\u304b\u3089\u8131\u51fa\u3059\u308b\u305f\u3081\u306b\u30b8\u30e3\u30f3\u30d7\uff08\u30c7\u30d5\u30a9\u30eb\u30c8\u30ad\u30fc\u306fX\uff09\u3092\u8a66\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u79fb\u52d5\u6226\u7565\u3092\u8abf\u6574\u3057\u3001\u6b21\u306e\u52d5\u4f5c\u3092\u4e88\u6e2c\u3057\u3066\u3001\u72ed\u3044\u5834\u6240\u306b\u79fb\u52d5\u3057\u306a\u3044\u3088\u3046\u306b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u300c\u5e7d\u970a\u300d\u30e2\u30fc\u30c9\uff08\u7279\u6b8a\u30a2\u30a4\u30c6\u30e0\u3092\u53ce\u96c6\u3059\u308b\u3053\u3068\u3067\u6709\u52b9\uff09\u3092\u30aa\u30f3\u306b\u3057\u307e\u3059\u3002\u3053\u306e\u30e2\u30fc\u30c9\u3067\u306f\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u4e00\u90e8\u306e\u969c\u5bb3\u7269\u3092\u901a\u904e\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u30015\u756a\u76ee\u306e\u30ec\u30d9\u30eb\u306e\u8907\u96d1\u306a\u5730\u5f62\u3067\u306f\u3001\u5e7d\u970a\u30e2\u30fc\u30c9\u3092\u4e8b\u524d\u306b\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u4e00\u9023\u306e\u969c\u5bb3\u7269\u3092\u3088\u308a\u7c21\u5358\u306b\u901a\u904e\u3067\u304d\u307e\u3059\u3002\u30b2\u30fc\u30e0\u5185\u306e\u79fb\u52d5\u30b7\u30b9\u30c6\u30e0\u3092\u7cbe\u5bc6\u306a\u6b6f\u8eca\u306b\u4f8b\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3044\u304b\u306a\u308b\u308f\u305a\u304b\u306a\u30ba\u30ec\u3082\u3001\u52d5\u304b\u306a\u304f\u306a\u308b\u539f\u56e0\u3068\u306a\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u305d\u306e\u305f\u3081\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u6b63\u78ba\u306b\u5236\u5fa1\u3059\u308b\u3053\u3068\u304c\u4e0d\u53ef\u6b20\u3067\u3059\u3002"}, {"question": "B\u00b2\u4e0a\u7d1a\u30c6\u30af\u30cb\u30c3\u30af\uff1aB-Cubed\u306b\u304a\u3051\u308b\u30b3\u30f3\u30dc\u306e\u52b9\u679c\u306f\u4f55\u3067\u3059\u304b\uff1f\u30b3\u30f3\u30dc\u306b\u3088\u308b\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3059\u308b\u65b9\u6cd5\u306f\uff1f", "answer": "\u30b3\u30f3\u30dc\u306fB-Cubed\u3067\u9ad8\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u305f\u3081\u306e\u91cd\u8981\u306a\u8981\u7d20\u3067\u3059\u3002\u5404\u884c\u307e\u305f\u306f\u8907\u6570\u306e\u30d6\u30ed\u30c3\u30af\u3092\u6d88\u53bb\u3059\u308b\u305f\u3073\u306b\u57fa\u790e\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3057\u307e\u3059\u304c\u3001\u9023\u7d9a\u3057\u3066\u6d88\u53bb\u3059\u308c\u3070\u3001\u5927\u5e45\u306b\u30b9\u30b3\u30a2\u500d\u7387\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6b21\u306e\u6d88\u53bb\u3092\u60f3\u5b9a\u3057\u3066\u30d6\u30ed\u30c3\u30af\u306e\u914d\u7f6e\u3092\u8a08\u753b\u3057\u3001\u30b9\u30da\u30fc\u30b9\u3092\u78ba\u4fdd\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u901a\u5e38\u3001\u9023\u9396\u53cd\u5fdc\u3092\u5f15\u304d\u8d77\u3053\u3057\u3001\u591a\u6bb5\u6d88\u53bb\u3092\u5f15\u304d\u8d77\u3053\u3059\u306e\u3067\u3001\u4e0b\u90e8\u306e\u30d6\u30ed\u30c3\u30af\u3092\u512a\u5148\u7684\u306b\u6d88\u53bb\u3057\u307e\u3059\u3002 \u30b9\u30c6\u30c3\u30d73\uff1a\u7279\u6b8a\u30d6\u30ed\u30c3\u30af\uff08\u7206\u5f3e\u30d6\u30ed\u30c3\u30af\u306a\u3069\uff09\u3092\u4f7f\u3063\u3066\u5468\u56f2\u306e\u30d6\u30ed\u30c3\u30af\u3092\u7206\u767a\u3055\u305b\u3001\u5927\u898f\u6a21\u306a\u6d88\u53bb\u3092\u884c\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u300112\u756a\u76ee\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u7206\u5f3e\u30d6\u30ed\u30c3\u30af\u3092\u9069\u5207\u306b\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u5468\u56f2\u306e\u6d88\u3057\u3084\u3059\u3044\u30d6\u30ed\u30c3\u30af\u3092\u7206\u767a\u3055\u305b\u308c\u3070\u3001\u4e00\u5ea6\u306b5000\u70b9\u4ee5\u4e0a\u306e\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3057\u3001\u901a\u5e38\u306e\u6d88\u53bb\u3092\u306f\u308b\u304b\u306b\u4e0a\u56de\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b3\u30f3\u30dc\u500d\u7387\u3068\u30b9\u30b3\u30a2\u306e\u95a2\u4fc2\u3092\u8868\u306b\u793a\u3057\u307e\u3059\u3002| \u30b3\u30f3\u30dc\u56de\u6570 | \u30b9\u30b3\u30a2\u500d\u7387 |\n|---|---| \n| 1 | x1 |\n| 2 | x2 |\n| 3 | x4 |\n| 4\u4ee5\u4e0a | x8 |"}, {"question": "\u6642\u9593\u5236\u9650\u306e\u3042\u308bB-Cubed\u30c1\u30e3\u30ec\u30f3\u30b8\u3067\u6700\u9ad8\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f\u5236\u9650\u6642\u9593\u5185\u306b\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u5236\u9650\u6642\u9593\u306e\u3042\u308b\u30c1\u30e3\u30ec\u30f3\u30b8\u3067\u306f\u3001\u6642\u9593\u306f\u30b9\u30b3\u30a2\u306b\u76f4\u7d50\u3057\u307e\u3059\uff01\u6700\u9069\u306a\u6226\u7565\u306f\u52b9\u7387\u6027\u3068\u6b63\u78ba\u6027\u3067\u3059\u3002\u307e\u305a\u3001\u30ec\u30d9\u30eb\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u628a\u63e1\u3057\u3001\u6700\u9069\u306a\u30eb\u30fc\u30c8\u3092\u8a08\u753b\u3057\u307e\u3059\u3002\u6b21\u306b\u3001\u9023\u9396\u53cd\u5fdc\u3092\u5f15\u304d\u8d77\u3053\u3059\u53ef\u80fd\u6027\u306e\u3042\u308b\u30d6\u30ed\u30c3\u30af\u3092\u512a\u5148\u7684\u306b\u6d88\u53bb\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u52a0\u901f\u30a2\u30a4\u30c6\u30e0\u3092\u52b9\u679c\u7684\u306b\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u79fb\u52d5\u901f\u5ea6\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u72c2\u9a12\u306e\u7a4d\u307f\u6728\u300d\u30c1\u30e3\u30ec\u30f3\u30b8\u3067\u306f\u3001\u4e0b\u90e8\u306e\u5149\u308b\u30d6\u30ed\u30c3\u30af\u3092\u512a\u5148\u7684\u306b\u6d88\u53bb\u3059\u308b\u3053\u3068\u3067\u3001\u8ffd\u52a0\u306e\u52a0\u901f\u6642\u9593\u3092\u5f97\u3066\u3001\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u3088\u308a\u65e9\u304f\u5b8c\u4e86\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u52b9\u7387\u7684\u306a\u6226\u7565\u306f\u300c\u8fc5\u901f\u306a\u69cb\u7bc9\u3001\u8fc5\u901f\u306a\u6d88\u53bb\u300d\u3067\u3059\u3002\u3053\u308c\u306f\u3001\u30d6\u30ed\u30c3\u30af\u3092\u8fc5\u901f\u306b\u7a4d\u307f\u91cd\u306d\u3001\u3059\u3050\u306b\u6d88\u53bb\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u77ed\u6642\u9593\u3067\u5927\u91cf\u306e\u30b9\u30b3\u30a2\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u8a18\u9332\u3092\u66f4\u65b0\u3057\u305f\u3044\u5834\u5408\u306f\u3001\u5404\u52a0\u901f\u30a2\u30a4\u30c6\u30e0\u3092\u6700\u5927\u9650\u306b\u6d3b\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "B-Cubed\u306e\u9054\u6210\u30b7\u30b9\u30c6\u30e0\u306e\u89e3\u6790\uff1a\u3069\u306e\u9054\u6210\u304c\u6700\u3082\u6311\u6226\u7684\u3067\u3001\u5831\u308f\u308c\u307e\u3059\u304b\uff1f\u7279\u5225\u306a\u6ce8\u610f\u304c\u5fc5\u8981\u306a\u96a0\u3057\u9054\u6210\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "B-Cubed\u306e\u9054\u6210\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u30b2\u30fc\u30e0\u306e\u69d8\u3005\u306a\u5074\u9762\u3092\u63a2\u6c42\u3059\u308b\u30a4\u30f3\u30bb\u30f3\u30c6\u30a3\u30d6\u3092\u4e0e\u3048\u307e\u3059\u3002\u6700\u3082\u6311\u6226\u7684\u306a\u9054\u6210\u306f\u3001\u9ad8\u5ea6\u306a\u6280\u8853\u3068\u6df1\u3044\u30b2\u30fc\u30e0\u7406\u89e3\u304c\u5fc5\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u5b8c\u74a7\u4e3b\u7fa9\u8005\u300d\u306f\u3001\u3069\u306e\u30a2\u30a4\u30c6\u30e0\u3082\u4f7f\u7528\u305b\u305a\u306b\u3059\u3079\u3066\u306e\u30ec\u30d9\u30eb\u3092\u4e00\u5ea6\u306b\u30af\u30ea\u30a2\u3059\u308b\u3053\u3068\u3092\u8981\u6c42\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u64cd\u4f5c\u3068\u6226\u7565\u80fd\u529b\u3092\u975e\u5e38\u306b\u8a66\u3057\u307e\u3059\u3002\u96a0\u3055\u308c\u305f\u9054\u6210\u306f\u3001\u7279\u5b9a\u306e\u30bf\u30b9\u30af\u3092\u5b8c\u4e86\u3057\u305f\u308a\u3001\u7279\u5b9a\u306e\u6761\u4ef6\u3092\u6e80\u305f\u3057\u305f\u308a\u3059\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u308b\u3053\u3068\u304c\u591a\u3044\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b2\u30fc\u30e0\u5185\u3067\u7279\u5b9a\u306e\u30d6\u30ed\u30c3\u30af\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u4f7f\u3063\u3066\u3001\u7279\u5b9a\u6570\u306e\u30d6\u30ed\u30c3\u30af\u3092\u6d88\u53bb\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u9054\u6210\u76ee\u6a19\u3092\u3088\u308a\u52b9\u7387\u7684\u306b\u9054\u6210\u3059\u308b\u306e\u306b\u5f79\u7acb\u3064\u8868\u3092\u4f5c\u6210\u3057\u307e\u3057\u305f\u3002\n| \u6210\u5c31\u540d | \u9054\u6210\u6761\u4ef6 | \u5831\u916c |\n|---|---|---| \n|\u300c\u30d6\u30ed\u30c3\u30af\u30de\u30b9\u30bf\u30fc\u300d|10,000\u500b\u306e\u30d6\u30ed\u30c3\u30af\u3092\u6d88\u53bb\u3059\u308b|\u7279\u5225\u306a\u30a2\u30d0\u30bf\u30fc|\n|\u300c\u30b9\u30d4\u30fc\u30c9\u30e9\u30f3\u30ca\u30fc\u300d|30\u79d2\u4ee5\u5185\u306b\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b|\u52a0\u901f\u30a2\u30a4\u30c6\u30e0\u306e\u5831\u916c|"}, {"question": "B-Cubed\u306e\u30d6\u30ed\u30c3\u30af\u751f\u6210\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u3064\u3044\u3066\uff1a\u3055\u307e\u3056\u307e\u306a\u30bf\u30a4\u30d7\u306e\u30d6\u30ed\u30c3\u30af\u306f\u3069\u306e\u3088\u3046\u306b\u751f\u6210\u3055\u308c\u3001\u91cd\u307f\u4ed8\u3051\u3055\u308c\u3066\u3044\u307e\u3059\u304b\uff1f\u30d6\u30ed\u30c3\u30af\u306e\u51fa\u73fe\u78ba\u7387\u306f\u30b2\u30fc\u30e0\u306e\u96e3\u6613\u5ea6\u3092\u5de6\u53f3\u3057\u307e\u3059\u304b\uff1f", "answer": "B-Cubed\u306e\u30d6\u30ed\u30c3\u30af\u751f\u6210\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u7591\u4f3c\u4e71\u6570\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u3092\u63a1\u7528\u3057\u3001\u8a2d\u5b9a\u3055\u308c\u305f\u91cd\u307f\u4ed8\u3051\u306b\u57fa\u3065\u3044\u3066\u3001\u69d8\u3005\u306a\u30bf\u30a4\u30d7\u306e\u30d6\u30ed\u30c3\u30af\u306e\u51fa\u73fe\u78ba\u7387\u3092\u6c7a\u5b9a\u3057\u307e\u3059\u3002\u901a\u5e38\u3001\u57fa\u672c\u7684\u306a\u30d6\u30ed\u30c3\u30af\uff08I\u578b\u3001L\u578b\u3001T\u578b\u306a\u3069\uff09\u306e\u51fa\u73fe\u78ba\u7387\u304c\u9ad8\u304f\u3001\u7279\u6b8a\u30d6\u30ed\u30c3\u30af\uff08\u7206\u5f3e\u30d6\u30ed\u30c3\u30af\u3001\u5e7d\u970a\u30d6\u30ed\u30c3\u30af\u306a\u3069\uff09\u306e\u51fa\u73fe\u78ba\u7387\u306f\u4f4e\u3044\u3067\u3059\u3002\u30d6\u30ed\u30c3\u30af\u306e\u51fa\u73fe\u78ba\u7387\u306f\u78ba\u304b\u306b\u30b2\u30fc\u30e0\u306e\u96e3\u6613\u5ea6\u3092\u5de6\u53f3\u3057\u307e\u3059\u3002\u4f7f\u3044\u306b\u304f\u3044\u30d6\u30ed\u30c3\u30af\u304c\u9023\u7d9a\u3057\u3066\u51fa\u73fe\u3059\u308b\u3068\u3001\u7a4d\u307f\u91cd\u306d\u304c\u96e3\u3057\u304f\u306a\u308a\u3001\u30b2\u30fc\u30e0\u306e\u5931\u6557\u306b\u3064\u306a\u304c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u958b\u767a\u8005\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u30d5\u30a3\u30fc\u30c9\u30d0\u30c3\u30af\u306b\u57fa\u3065\u3044\u3066\u30d6\u30ed\u30c3\u30af\u306e\u91cd\u307f\u4ed8\u3051\u3092\u8abf\u6574\u3057\u3001\u30b2\u30fc\u30e0\u306e\u96e3\u6613\u5ea6\u3092\u30d0\u30e9\u30f3\u30b9\u3055\u305b\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u300c\u96e3\u6613\u5ea6\u8abf\u6574\u5668\u300d\u30e2\u30b8\u30e5\u30fc\u30eb\u3067\u624b\u52d5\u3067\u8abf\u6574\u3067\u304d\u307e\u3059\u3002"}, {"question": "B3\u6df1\u5165\uff1aB-Cubed\u306e\u96a0\u3057\u30ec\u30d9\u30eb\u30e1\u30ab\u30cb\u30ba\u30e0\uff1a\u96a0\u3057\u30ec\u30d9\u30eb\u3092\u958b\u653e\u3059\u308b\u65b9\u6cd5\u3068\u3001\u305d\u308c\u3089\u306b\u3069\u306e\u3088\u3046\u306a\u30e6\u30cb\u30fc\u30af\u306a\u8ab2\u984c\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "B-Cubed\u306b\u306f\u8907\u6570\u306e\u96a0\u3057\u30ec\u30d9\u30eb\u304c\u3042\u308a\u3001\u3053\u308c\u3092\u958b\u653e\u3059\u308b\u306b\u306f\u7279\u5b9a\u306e\u6761\u4ef6\u3092\u6e80\u305f\u3059\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u901a\u5e38\u3001\u3053\u308c\u3089\u306e\u6761\u4ef6\u306f\u30b2\u30fc\u30e0\u5185\u306e\u7279\u5b9a\u306e\u30a4\u30d9\u30f3\u30c8\u3084\u9054\u6210\u4e8b\u9805\u306b\u95a2\u9023\u3057\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u3059\u3079\u3066\u306e\u901a\u5e38\u306e\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3057\u30013\u3064\u306e\u661f\u3092\u7372\u5f97\u3059\u308b\u3068\u3001\u300c\u93e1\u9762\u4e16\u754c\u300d\u3068\u3044\u3046\u6700\u521d\u306e\u96a0\u3057\u30ec\u30d9\u30eb\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u96a0\u3057\u30ec\u30d9\u30eb\u306f\u3001\u901a\u5e38\u3001\u30e6\u30cb\u30fc\u30af\u306a\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u53cd\u91cd\u529b\u3001\u6642\u9593\u5236\u9650\u306e\u3042\u308b\u6d88\u53bb\u3001\u7279\u6b8a\u306a\u30d6\u30ed\u30c3\u30af\u30bf\u30a4\u30d7\u306a\u3069\u3067\u3059\u3002\u96a0\u3057\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u3053\u3068\u3067\u3001\u8c4a\u5bcc\u306a\u5831\u916c\u3068\u9054\u6210\u611f\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u96a0\u3057\u30ec\u30d9\u30eb\u306f\u3001\u901a\u5e38\u3001\u901a\u5e38\u306e\u30ec\u30d9\u30eb\u3088\u308a\u3082\u96e3\u6613\u5ea6\u304c\u9ad8\u3044\u50be\u5411\u304c\u3042\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u64cd\u4f5c\u3068\u6226\u7565\u80fd\u529b\u306b\u5bfe\u3059\u308b\u8981\u6c42\u3092\u9ad8\u3081\u307e\u3059\u3002\u96a0\u3057\u30ec\u30d9\u30eb\u3092\u30b2\u30fc\u30e0\u5185\u306e\u300c\u4e0a\u7d1a\u8a66\u7df4\u300d\u3068\u6349\u3048\u3066\u307f\u3066\u3082\u826f\u3044\u3067\u3057\u3087\u3046\u3002\u771f\u306eB-Cubed\u30de\u30b9\u30bf\u30fc\u3057\u304b\u5f81\u670d\u3067\u304d\u307e\u305b\u3093\u3002"}, {"question": "B-Cubed\u306e\u5e95\u5c64\u30ed\u30b8\u30c3\u30af\uff1a\u30b2\u30fc\u30e0\u5185\u306e\u30d6\u30ed\u30c3\u30af\u6d88\u5931\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u5b9f\u88c5\u3055\u308c\u3066\u3044\u307e\u3059\u304b\uff1f\u6700\u9069\u89e3\u306f\u5b58\u5728\u3057\u307e\u3059\u304b\uff1f", "answer": "B-Cubed\u306e\u5e95\u5c64\u30ed\u30b8\u30c3\u30af\u306f\u3001\u96e2\u6563\u6570\u5b66\u3068\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u30d6\u30ed\u30c3\u30af\u306e\u6d88\u53bb\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u691c\u7d22\u3068\u30d1\u30bf\u30fc\u30f3\u30de\u30c3\u30c1\u30f3\u30b0\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306f\u30b2\u30fc\u30e0\u30a8\u30ea\u30a2\u3092\u30b9\u30ad\u30e3\u30f3\u3057\u3001\u6d88\u53bb\u6761\u4ef6\u3092\u6e80\u305f\u3059\u30d6\u30ed\u30c3\u30af\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u898b\u3064\u3051\u307e\u3059\uff08\u4f8b\u3048\u3070\u3001\u4e00\u884c\u307e\u305f\u306f\u4e00\u5217\u3092\u57cb\u3081\u308b\uff09\u3002\u7406\u8ad6\u7684\u306b\u306f\u6700\u9069\u89e3\u304c\u5b58\u5728\u3059\u308b\uff08\u3064\u307e\u308a\u3001\u5236\u9650\u3055\u308c\u305f\u30b9\u30c6\u30c3\u30d7\u6570\u3067\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\uff09\u3068\u601d\u3044\u307e\u3059\u304c\u3001\u30b2\u30fc\u30e0\u306e\u30e9\u30f3\u30c0\u30e0\u6027\u3068\u8907\u96d1\u3055\u306e\u305f\u3081\u3001\u6700\u9069\u89e3\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u306f\u901a\u5e38\u975e\u5e38\u306b\u56f0\u96e3\u3067\u3059\u3002\u4ee5\u4e0b\u306e\u56f3\u306f\u3001\u7c21\u7565\u5316\u3055\u308c\u305f\u6d88\u53bb\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u3092\u793a\u3057\u3066\u3044\u307e\u3059\u3002\n[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u958b\u59cb -> \u30b2\u30fc\u30e0\u30a8\u30ea\u30a2\u306e\u6383\u5f15 -> \u6d88\u53bb\u53ef\u80fd\u306a\u30d6\u30ed\u30c3\u30af\u306e\u7d44\u307f\u5408\u308f\u305b\u306e\u691c\u7d22 -> \u30d6\u30ed\u30c3\u30af\u306e\u6d88\u53bb -> \u30b9\u30b3\u30a2\u306e\u518d\u8a08\u7b97 -> \u7d42\u4e86]\n\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306e\u4e2d\u5fc3\u306f\u3001\u30b2\u30fc\u30e0\u30a8\u30ea\u30a2\u3092\u52b9\u7387\u7684\u306b\u63a2\u3057\u3001\u6d88\u53bb\u53ef\u80fd\u306a\u30d6\u30ed\u30c3\u30af\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u3059\u3070\u3084\u304f\u898b\u3064\u3051\u308b\u3053\u3068\u3067\u3059\u3002\u30b2\u30fc\u30e0\u30a8\u30f3\u30b8\u30f3\u306f\u3001\u901a\u5e38\u3001\u7a7a\u9593\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u306a\u3069\u306e\u6280\u8853\u3092\u4f7f\u7528\u3057\u3066\u30b9\u30ad\u30e3\u30f3\u30d7\u30ed\u30bb\u30b9\u3092\u6700\u9069\u5316\u3057\u3066\u3044\u307e\u3059\u3002"}, {"question": "B-Cubed\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u540c\u671f\u306e\u554f\u984c\uff1aPC\u3068\u30e2\u30d0\u30a4\u30eb\u306e\u9593\u3067\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u3092\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f\u7279\u6b8a\u306a\u30c4\u30fc\u30eb\u306f\u5fc5\u8981\u3067\u3059\u304b\uff1f", "answer": "B-Cubed\u306f\u3001\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u3067\u30b2\u30fc\u30e0\u3092\u30b7\u30fc\u30e0\u30ec\u30b9\u306b\u4f53\u9a13\u3067\u304d\u308b\u3088\u3046\u306b\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u306e\u30c7\u30fc\u30bf\u540c\u671f\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u307e\u3059\u3002\u901a\u5e38\u3001\u30b2\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u767b\u9332\u3057\u3066\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u6b21\u306b\u3001\u30af\u30e9\u30a6\u30c9\u540c\u671f\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u3001\u30b2\u30fc\u30e0\u30c7\u30fc\u30bf\u3092\u30b5\u30fc\u30d0\u30fc\u306b\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u4ed6\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u306f\u3001\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u4f7f\u7528\u3057\u3066\u30b2\u30fc\u30e0\u306b\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3060\u3051\u3067\u3001\u30b2\u30fc\u30e0\u306e\u9032\u884c\u72b6\u6cc1\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3067\u304d\u307e\u3059\u3002\u3044\u304f\u3064\u304b\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u306f\u3001\u540c\u3058\u30d0\u30fc\u30b8\u30e7\u30f3\u306e\u30b2\u30fc\u30e0\u3092\u8cfc\u5165\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u4e00\u90e8\u306e\u30b5\u30fc\u30c9\u30d1\u30fc\u30c6\u30a3\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306f\u7570\u306a\u308b\u30c7\u30fc\u30bf\u540c\u671f\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u6301\u3064\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u8aac\u660e\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u306f\u4ee5\u4e0b\u306e\u3068\u304a\u308a\u3067\u3059\uff1a[\u30c7\u30d0\u30a4\u30b9A] -> [\u30a2\u30ab\u30a6\u30f3\u30c8\u30ed\u30b0\u30a4\u30f3]->[\u30af\u30e9\u30a6\u30c9\u3078\u30c7\u30fc\u30bf\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9]->[\u30c7\u30d0\u30a4\u30b9B]->[\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u30ed\u30b0\u30a4\u30f3]->[\u30c7\u30fc\u30bf\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9]"}, {"question": "B-Cubed\u306e\u96a0\u308c\u305f\u8981\u7d20\uff1a\u30b2\u30fc\u30e0\u5185\u306b\u96a0\u3055\u308c\u305f\u53c2\u7167\u307e\u305f\u306f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f\u96a0\u3057\u30b9\u30c8\u30fc\u30ea\u30fc\u3084\u7279\u6b8a\u30a4\u30d9\u30f3\u30c8\u3092\u30c8\u30ea\u30ac\u30fc\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "B-Cubed\u306b\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u9762\u767d\u3044\u96a0\u3055\u308c\u305f\u53c2\u7167\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u3044\u304f\u3064\u304b\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u7279\u5b9a\u306e\u30d6\u30ed\u30c3\u30af\u306e\u914d\u7f6e\u306f\u3001\u30d1\u30c3\u30af\u30de\u30f3\u306a\u3069\u306e\u53e4\u5178\u7684\u306a\u30d4\u30af\u30bb\u30eb\u30b2\u30fc\u30e0\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u5f62\u6210\u3057\u307e\u3059\u3002\u96a0\u3057\u30b9\u30c8\u30fc\u30ea\u30fc\u3084\u7279\u6b8a\u30a4\u30d9\u30f3\u30c8\u3092\u30c8\u30ea\u30ac\u30fc\u3059\u308b\u306b\u306f\u3001\u7279\u5b9a\u306e\u30bf\u30b9\u30af\u3092\u5b8c\u4e86\u3057\u305f\u308a\u3001\u7279\u5b9a\u306e\u6761\u4ef6\u3092\u6e80\u305f\u3057\u305f\u308a\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u300120\u30ec\u30d9\u30eb\u3067\u306f\u30015\u500b\u306e\u7206\u5f3e\u30d6\u30ed\u30c3\u30af\u3092\u9023\u7d9a\u3057\u3066\u4f7f\u7528\u3059\u308b\u3068\u3001\u96a0\u3057\u30b9\u30c8\u30fc\u30ea\u30fc\u304c\u30c8\u30ea\u30ac\u30fc\u3055\u308c\u3001\u65b0\u3057\u3044\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30b9\u30ad\u30f3\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u30b2\u30fc\u30e0\u5185\u306e\u73cd\u3057\u3044\u8a73\u7d30\u3084\u3001\u4e00\u822c\u7684\u306a\u64cd\u4f5c\u3092\u8a66\u3059\u3053\u3068\u3067\u3001\u4e88\u60f3\u5916\u306e\u9a5a\u304d\u3092\u767a\u898b\u3067\u304d\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u5f69\u86cb\u63a2\u3057\u306f\u5b9d\u63a2\u3057\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u6ce8\u610f\u6df1\u304f\u89b3\u5bdf\u3057\u3001\u5927\u80c6\u306b\u8a66\u3057\u3066\u307f\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}]
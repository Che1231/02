[{"question": "\ubc84\ud37c\uce74 \uaca9\ud30c \uacbd\uc8fc\uc5d0\uc11c \ucd08\ubcf4\uc790\ub294 \ubc84\ud37c\uce74\ub97c \uc5b4\ub5bb\uac8c \uc870\uc885\ud574\uc57c \ud558\ub098\uc694?", "answer": "\ubc84\ud37c\uce74 \uaca9\ud30c \uacbd\uc8fc\uc5d0\uc11c \ubc84\ud37c\uce74\ub97c \uc870\uc885\ud558\ub824\uba74 \ud654\uc0b4\ud45c \ud0a4 \ub610\ub294 WASD \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc774\ub3d9\ud569\ub2c8\ub2e4. \uc2a4\ud398\uc774\uc2a4\ubc14\ub294 \uc18d\ub3c4\ub97c \ub192\uc774\ub294 \ub370 \ud544\uc218\uc801\uc778 \ubd80\uc2a4\ud2b8\ub97c \ud65c\uc131\ud654\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub3c4\uc2dc \ud63c\ub3c8' \uc9c0\ub3c4\uc5d0\uc11c \uc881\uc740 \ucf54\ub108\ub97c \ubd80\uc2a4\ud2b8\ub85c \ub3cc\ud30c\ud558\uba74 \ucda9\ub3cc\uc744 \ud53c\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \ud29c\ud1a0\ub9ac\uc5bc \ubaa8\ub4dc\ub85c \uc5f0\uc2b5\ud558\uc5ec \uc870\uc791 \uac10\uac01\uc744 \uc775\ud788\ub294 \uac83\uc744 \uc78a\uc9c0 \ub9c8\uc138\uc694. [\ube44\uc720 \uc124\uba85: \ubc84\ud37c\uce74\ub97c \ubbfc\ucca9\ud55c \ubb34\uc6a9\uc218\ub85c \uc0dd\uac01\ud558\uc138\uc694, \uc815\ud655\ud55c \uc785\ub825\uc73c\ub85c \ubd80\ub4dc\ub7fd\uac8c \ubbf8\ub044\ub7ec\uc9d1\ub2c8\ub2e4.]"}, {"question": "\ubc84\ud37c\uce74 \uaca9\ud30c \uacbd\uc8fc\uc5d0\uc11c \uae30\ubcf8\uc801\uc778 \ud30c\uc6cc\uc5c5\uc740 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "\ubc84\ud37c\uce74 \uaca9\ud30c \uacbd\uc8fc\uc5d0\ub294 \uae30\ubcf8\uc801\uc778 \ud30c\uc6cc\uc5c5 \uc138 \uac00\uc9c0\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc18d\ub3c4 \ubd80\uc2a4\ud130, \ubc29\ud328, \ubbf8\uc0ac\uc77c\uc785\ub2c8\ub2e4. \uc18d\ub3c4 \ubd80\uc2a4\ud130\ub294 \uc77c\uc2dc\uc801\uc73c\ub85c \ucc28\ub7c9\uc758 \uc18d\ub3c4\ub97c \ub192\uc774\uace0, \ubc29\ud328\ub294 \ud55c \ubc88\uc758 \ud0c0\uaca9\uc73c\ub85c\ubd80\ud130 \ubcf4\ud638\ud558\uba70, \ubbf8\uc0ac\uc77c\uc740 \uc0c1\ub300\ubc29\uc744 \ud0c0\uac9f\ud305\ud558\uc5ec \ud53c\ud574\ub97c \uc785\ud790 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc0ac\ub9c9 \uc9c8\uc8fc' \uc9c0\ub3c4\uc5d0\uc11c \ubc29\ud328\ub97c \uc0ac\uc6a9\ud558\uba74 \uac11\uc791\uc2a4\ub7ec\uc6b4 \uc7a5\uc560\ubb3c\ub85c \uc778\ud574 \uaca9\ud30c\ub418\ub294 \uac83\uc744 \ub9c9\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ub300\uc870\ud45c: \uc18d\ub3c4 \ubd80\uc2a4\ud130: 5\ucd08 \ub3d9\uc548 \uc18d\ub3c4 50% \uc99d\uac00 | \ubc29\ud328: \ud55c \ubc88\uc758 \ud0c0\uaca9 \ud761\uc218 | \ubbf8\uc0ac\uc77c: \ud0c0\uac9f\ud305\ub41c \uc0c1\ub300\uc5d0\uac8c 30\uc758 \ud53c\ud574]"}, {"question": "\ubc84\ud37c\uce74 \uaca9\ud30c \uacbd\uc8fc\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5a4 \ubc84\ud37c\uce74\ub97c \uc120\ud0dd\ud574\uc57c \ud558\ub098\uc694?", "answer": "\ubc84\ud37c\uce74 \uaca9\ud30c \uacbd\uc8fc\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub294 '\uae30\ubcf8 \ubc84\ud37c\uce74'\ub85c \uc2dc\uc791\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \uc18d\ub3c4, \ub0b4\uad6c\uc131, \uc870\uc885 \uc131\ub2a5\uc774 \uade0\ud615\uc744 \uc774\ub8e8\uace0 \uc788\uc5b4 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc744 \ubc30\uc6b0\uae30\uc5d0 \ub354 \uc27d\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc232 \uad11\ub780' \uc9c0\ub3c4\uc5d0\uc11c \uae30\ubcf8 \ubc84\ud37c\uce74\uc758 \uade0\ud615 \uc7a1\ud78c \uc18d\uc131\uc740 \ud1b5\uc81c\ub825\uc744 \uc783\uc9c0 \uc54a\uace0 \ube7d\ube7d\ud55c \ub098\ubb34 \uc0ac\uc774\ub97c \uc774\ub3d9\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc120\ud0dd \ube44\uad50: \uae30\ubcf8 \ubc84\ud37c\uce74: \uade0\ud615 \uc7a1\ud798 | \uc2a4\ud53c\ub4dc\uc2a4\ud130: \ube60\ub974\uc9c0\ub9cc \uc57d\ud568 | \ud0f1\ud06c: \ub290\ub9ac\uc9c0\ub9cc \ub0b4\uad6c\uc131 \uc88b\uc74c]"}, {"question": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \ubc84\ud37c\uce74 \uaca9\ud30c \uacbd\uc8fc\uc5d0\uc11c \uc9c0\ub3c4 \uc778\uc9c0\ub825\uc740 \uc65c \uc911\uc694\ud55c\uac00\uc694?", "answer": "\ubc84\ud37c\uce74 \uaca9\ud30c \uacbd\uc8fc\uc5d0\uc11c \uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \uc9c0\ub3c4 \uc778\uc9c0\ub825\uc740 \uc7a5\uc560\ubb3c, \ud30c\uc6cc\uc5c5 \uc704\uce58, \uc0c1\ub300\ubc29\uc758 \uc6c0\uc9c1\uc784\uc744 \uc608\uce21\ud560 \uc218 \uc788\uac8c \ud574 \uc8fc\uae30 \ub54c\ubb38\uc5d0 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc5bc\uc74c \uc9c0\uc625' \uc9c0\ub3c4\uc5d0\uc11c \uc5bc\uc74c \ud328\uce58\uac00 \uc788\ub294 \uc704\uce58\ub97c \uc54c\uba74 \ud2b8\ub799\uc5d0\uc11c \ubbf8\ub044\ub7ec\uc9c0\ub294 \uac83\uc744 \ubc29\uc9c0\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. STEP1: \ub808\uc774\uc2a4 \uc2dc\uc791 \uc804\uc5d0 \uc9c0\ub3c4 \ub808\uc774\uc544\uc6c3\uc744 \uacf5\ubd80\ud558\uc138\uc694. STEP2: \ub808\uc774\uc2a4 \uc911\uc5d0\ub294 \ubbf8\ub2c8\ub9f5\uc744 \uc8fc\uc2dc\ud558\uc138\uc694. STEP3: \uc2e4\uc2dc\uac04 \uc9c0\ub3c4 \uc0c1\ud669\uc5d0 \ub530\ub77c \uc804\ub7b5\uc744 \uc870\uc815\ud558\uc138\uc694. [\ud750\ub984\ub3c4: \uc9c0\ub3c4 \uacf5\ubd80 -> \ubbf8\ub2c8\ub9f5 \ubaa8\ub2c8\ud130\ub9c1 -> \uc804\ub7b5 \uc870\uc815]"}, {"question": "\ubc84\ud37c\uce74 \uaca9\ud30c \uacbd\uc8fc\uc5d0\uc11c \ubc84\ud37c\uce74 \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ubc84\ud37c\uce74 \uaca9\ud30c \uacbd\uc8fc\uc5d0\uc11c \ubc84\ud37c\uce74 \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc18d\ub3c4, \ub0b4\uad6c\uc131, \uc870\uc885 \uc131\ub2a5\uacfc \uac19\uc740 \uc8fc\uc694 \uc18d\uc131\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uc0b0\uc545 \ud63c\ub780' \uc9c0\ub3c4\uc5d0\uc11c \ucc28\ub7c9\uc758 \uc870\uc885 \uc131\ub2a5\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uba74 \uac00\ud30c\ub978 \uacbd\uc0ac\ub85c\ub97c \ub354 \ud6a8\uacfc\uc801\uc73c\ub85c \uc774\ub3d9\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \ub808\uc774\uc2a4 \uc644\ub8cc\ub97c \ud1b5\ud574 \ucf54\uc778\uc744 \ud68d\ub4dd\ud558\uc138\uc694. STEP2: \ucc28\uace0\uc5d0 \ub4e4\uc5b4\uac00 \ucc28\ub7c9\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc138\uc694. STEP3: \uc5f0\uc2b5 \ub808\uc774\uc2a4\uc5d0\uc11c \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \ud14c\uc2a4\ud2b8\ud558\uc5ec \ud544\uc694\uc5d0 \ub9de\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. [\ube44\uc720 \uc124\uba85: \ubc84\ud37c\uce74\ub97c \uc815\uad50\ud558\uac8c \uc870\uc728\ub41c \uc545\uae30\ub85c \uc0dd\uac01\ud558\uc138\uc694, \uac01 \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \uc131\ub2a5\uc744 \uc138\ub828\ub418\uac8c \ud569\ub2c8\ub2e4.]"}, {"question": "\ubc84\ud37c\uce74 \uaca9\ud30c \uacbd\uc8fc\uc758 \ud300 \ubaa8\ub4dc\uc5d0\uc11c \uc774\uae30\uae30 \uc704\ud55c \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ubc84\ud37c\uce74 \uaca9\ud30c \uacbd\uc8fc\uc758 \ud300 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \ud611\ub825\uacfc \uc5ed\ud560 \uc804\ubb38\ud654\uac00 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub3c4\uc2dc \uc18c\ub780' \uc9c0\ub3c4\uc5d0\uc11c \ud55c \uba85\uc758 \ud50c\ub808\uc774\uc5b4\ub294 \ud30c\uc6cc\uc5c5\uc744 \uc218\uc9d1\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uace0 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub294 \ubc29\uc5b4 \ub610\ub294 \uacf5\uaca9\uc744 \ub2f4\ub2f9\ud558\uac8c \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \ub808\uc774\uc2a4 \uc2dc\uc791 \uc804\uc5d0 \ud300\uc6d0\uacfc \uc18c\ud1b5\ud558\uc138\uc694. STEP2: \uac01 \ud50c\ub808\uc774\uc5b4\uc758 \uac15\uc810\uc744 \uae30\ubc18\uc73c\ub85c \uc5ed\ud560\uc744 \uc9c0\uc815\ud558\uc138\uc694. STEP3: \uc5ed\ub3d9\uc801\uc778 \ub808\uc774\uc2a4 \uc0c1\ud669\uc5d0 \uc801\uc751\ud558\uba74\uc11c \uc804\ub7b5\uc744 \uc2e4\ud589\ud558\uc138\uc694. [\ub2e4\uc591\ud55c \uc120\ud0dd \ube44\uad50: \uacf5\uaca9\uc801\uc778 \uc804\ub7b5: \uacf5\uaca9\uc5d0 \uc9d1\uc911 | \ubc29\uc5b4\uc801\uc778 \uc804\ub7b5: \ubcf4\ud638\ub97c \uc6b0\uc120 | \uade0\ud615 \uc7a1\ud78c \uc804\ub7b5: \ub458 \ub2e4 \ud63c\ud569]"}, {"question": "\ubc84\ud37c\uce74 \uaca9\ud30c \uacbd\uc8fc\uc5d0\uc11c \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "\ubc84\ud37c\uce74 \uaca9\ud30c \uacbd\uc8fc\uc5d0\uc11c \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ub808\uc774\uc2a4 \uc21c\uc704, \ud53c\ud574\ub7c9, \ud30c\uc6cc\uc5c5 \uc218\uc9d1\uc758 \uc870\ud569\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc815\uae00 \uc7bc' \uc9c0\ub3c4\uc5d0\uc11c 1\ub4f1\uc744 \ud558\uba74 100\uc810\uc774\uba70, \uac01 \ud30c\uc6cc\uc5c5\uc744 \uc218\uc9d1\ud560 \ub54c\ub9c8\ub2e4 10\uc810\uc774 \ucd94\uac00\ub429\ub2c8\ub2e4. \ub610\ud55c, \uc0c1\ub300\ubc29\uc5d0\uac8c \ud53c\ud574\ub97c \uc785\ud788\uba74 \ud0c0\uaca9\ub2f9 5\uc810\uc744 \uc5bb\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ub300\uc870\ud45c: \ub808\uc774\uc2a4 \uc21c\uc704: 1\ub4f1: 100\uc810 | \ud30c\uc6cc\uc5c5: \uac01\uac01 10\uc810 | \ud53c\ud574: \ud0c0\uaca9\ub2f9 5\uc810]"}, {"question": "\ubc84\ud37c\uce74 \uaca9\ud30c \uacbd\uc8fc\uc5d0\uc11c \ucda9\ub3cc \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ubc84\ud37c\uce74 \uaca9\ud30c \uacbd\uc8fc\uc5d0\uc11c \ucda9\ub3cc \uba54\ucee4\ub2c8\uc998\uc740 \uc18d\ub3c4, \ucda9\ub3cc \uac01\ub3c4, \ucc28\ub7c9 \ub0b4\uad6c\uc131\uc744 \uace0\ub824\ud55c \ubb3c\ub9ac \uc2dc\ubbac\ub808\uc774\uc158\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud654\uc0b0 \uc18c\uc6a9\ub3cc\uc774' \uc9c0\ub3c4\uc5d0\uc11c \uace0\uc18d\uc73c\ub85c \uc815\uba74 \ucda9\ub3cc\ud558\uba74 \ub450 \ucc28\ub7c9 \ubaa8\ub450 \uc0c1\ub2f9\ud55c \ud53c\ud574\ub97c \uc785\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784\uc740 \ucda9\ub3cc\uc758 \ud798\uc744 \uacc4\uc0b0\ud558\uace0 \ucc28\ub7c9\uc758 \ub0b4\uad6c\ub3c4 \ud1b5\uacc4\uc5d0 \uc801\uc6a9\ud558\uc5ec \ub0b4\uad6c\ub3c4\uac00 0\uc5d0 \ub3c4\ub2ec\ud558\uba74 \uaca9\ud30c\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ucda9\ub3cc\uc744 \uac70\ub300\ud55c \uc874\uc7ac\ub4e4\uc758 \ucda9\ub3cc\ucc98\ub7fc \uc0c1\uc0c1\ud558\uc138\uc694, \ud798\uc774 \uacb0\uacfc\ub97c \uacb0\uc815\ud569\ub2c8\ub2e4.]"}, {"question": "\ubaa8\ubc14\uc77c\uc5d0\uc11c PC\ub85c \ubc84\ud37c\uce74 \uaca9\ud30c \uacbd\uc8fc\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc608, \ubc84\ud37c\uce74 \uaca9\ud30c \uacbd\uc8fc\uc5d0\uc11c \ubaa8\ubc14\uc77c\uc5d0\uc11c PC\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\ub824\uba74 \uac8c\uc784 \uacc4\uc815\uc744 \uc720\ub2c8\ubc84\uc124 \ud504\ub85c\ud544\uc5d0 \uc5f0\uacb0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 \ubaa8\ubc14\uc77c\uc5d0\uc11c '\uc2a4\ud53c\ub4dc\uc2a4\ud130 \ubc84\ud37c\uce74'\ub97c \ud68d\ub4dd\ud588\ub2e4\uba74 \uacc4\uc815\uc744 \uc5f0\uacb0\ud558\uba74 PC\uc5d0\uc11c\ub3c4 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \uac8c\uc784 \uc124\uc815\uc5d0\uc11c \uc720\ub2c8\ubc84\uc124 \ud504\ub85c\ud544\uc744 \ub9cc\ub4dc\uc138\uc694. STEP2: \ub3d9\uc77c\ud55c \ud504\ub85c\ud544\ub85c \ub450 \uae30\uae30 \ubaa8\ub450\uc5d0 \ub85c\uadf8\uc778\ud558\uc138\uc694.. STEP3: \ubaa8\ub4e0 \ud68d\ub4dd \ubc0f \uc5c5\uadf8\ub808\uc774\ub4dc\uac00 \uc804\uc1a1\ub418\ub3c4\ub85d \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud558\uc138\uc694. [\ud750\ub984\ub3c4: \ud504\ub85c\ud544 \uc0dd\uc131 -> \uae30\uae30 \ub85c\uadf8\uc778 -> \uc9c4\ud589 \uc0c1\ud669 \ub3d9\uae30\ud654]"}, {"question": "\ubc84\ud37c\uce74 \uaca9\ud30c \uacbd\uc8fc\uc5d0\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\ub098\uc694?", "answer": "\uc608, \ubc84\ud37c\uce74 \uaca9\ud30c \uacbd\uc8fc\uc5d0\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc720\ub839 \uace0\uc18d\ub3c4\ub85c' \uc9c0\ub3c4\uc5d0\uc11c \uc790\uc815(\uac8c\uc784 \uc2dc\uac04)\uc5d0 \ud2b9\uc815 \ubb18\uc9c0 \uad6c\uc5ed\uc744 \ud1b5\uacfc\ud558\uba74 \uc720\ub839 \ubc84\ud37c\uce74\uac00 \ub098\ud0c0\ub098 \ud568\uaed8 \uacbd\uc8fc\ub97c \ud558\uac8c \ub429\ub2c8\ub2e4. \uc774 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uace0\uc804\uc801\uc778 \uacf5\ud3ec \uc601\ud654\uc5d0 \ub300\ud55c \uacbd\uc758\ub97c \ud45c\ud558\uba70, \uadf8\uac83\uc744 \ubc1c\uacac\ud55c \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud574 \ucd94\uac00\uc801\uc778 \uc7ac\ubbf8\ub97c \ub354\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ube44\ubc00\uc2a4\ub7ec\uc6b4 \ubcf4\ubb3c \ucc3e\uae30 \uac8c\uc784\uc73c\ub85c \uc0dd\uac01\ud558\uc138\uc694, \ubcf4\uc0c1\uc740 \ud765\ubbf8\uc9c4\uc9c4\ud55c \ub180\ub77c\uc6c0\uc785\ub2c8\ub2e4.]"}]
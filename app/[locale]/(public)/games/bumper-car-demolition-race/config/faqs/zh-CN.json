[{"question": "\u65b0\u624b\u5982\u4f55\u63a7\u5236\u6211\u7684\u78b0\u78b0\u8f66\u5728\u78b0\u78b0\u8f66\u5927\u7834\u574f\u8d5b\u4e2d\uff1f", "answer": "\u5728\u78b0\u78b0\u8f66\u5927\u7834\u574f\u8d5b\u4e2d\u63a7\u5236\u4f60\u7684\u78b0\u78b0\u8f66\uff0c\u8bf7\u4f7f\u7528\u65b9\u5411\u952e\u6216 WASD \u8fdb\u884c\u79fb\u52a8\u3002\u7a7a\u683c\u952e\u6fc0\u6d3b\u4f60\u7684\u52a0\u901f\u5668\uff0c\u8fd9\u5bf9\u4e8e\u83b7\u5f97\u901f\u5ea6\u81f3\u5173\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5728\u201c\u57ce\u5e02\u6df7\u4e71\u201d\u5730\u56fe\u4e2d\uff0c\u901a\u8fc7\u7d27\u5bc6\u7684\u62d0\u89d2\u5904\u52a0\u901f\u53ef\u4ee5\u5e2e\u52a9\u4f60\u907f\u514d\u78b0\u649e\u3002\u8bb0\u4f4f\uff0c\u5728\u6559\u7a0b\u6a21\u5f0f\u4e2d\u7ec3\u4e60\uff0c\u4ee5\u4fbf\u719f\u6089\u63a7\u5236\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u4f60\u7684\u78b0\u78b0\u8f66\u60f3\u8c61\u6210\u4e00\u4e2a\u654f\u6377\u7684\u821e\u8005\uff0c\u901a\u8fc7\u7cbe\u786e\u7684\u8f93\u5165\u5e73\u6ed1\u5730\u6ed1\u884c\u3002]"}, {"question": "\u78b0\u78b0\u8f66\u5927\u7834\u574f\u8d5b\u4e2d\u6709\u54ea\u4e9b\u57fa\u672c\u7684\u9053\u5177\uff0c\u5b83\u4eec\u5982\u4f55\u8fd0\u4f5c\uff1f", "answer": "\u5728\u78b0\u78b0\u8f66\u5927\u7834\u574f\u8d5b\u4e2d\uff0c\u6709\u4e09\u79cd\u57fa\u672c\u7684\u9053\u5177\uff1a\u52a0\u901f\u9053\u5177\u3001\u62a4\u76fe\u548c\u5bfc\u5f39\u3002\u52a0\u901f\u9053\u5177\u4f1a\u6682\u65f6\u589e\u52a0\u4f60\u7684\u8f66\u901f\uff0c\u62a4\u76fe\u4f1a\u4fdd\u62a4\u4f60\u514d\u53d7\u4e00\u6b21\u649e\u51fb\uff0c\u800c\u5bfc\u5f39\u5219\u5141\u8bb8\u4f60\u7784\u51c6\u5e76\u653b\u51fb\u5bf9\u624b\u3002\u4f8b\u5982\uff0c\u5728\u201c\u6c99\u6f20\u51b2\u523a\u201d\u5730\u56fe\u4e2d\u4f7f\u7528\u62a4\u76fe\u53ef\u4ee5\u9632\u6b62\u4f60\u88ab\u7a81\u5982\u5176\u6765\u7684\u969c\u788d\u649e\u51fa\u8d5b\u9053\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u52a0\u901f\u9053\u5177\uff1a\u63d0\u5347 50% \u901f\u5ea6\u6301\u7eed 5 \u79d2 | \u62a4\u76fe\uff1a\u5438\u6536\u4e00\u6b21\u649e\u51fb | \u5bfc\u5f39\uff1a\u5bf9\u76ee\u6807\u9020\u6210 30 \u70b9\u4f24\u5bb3]"}, {"question": "\u4f5c\u4e3a\u65b0\u73a9\u5bb6\uff0c\u6211\u5e94\u8be5\u9009\u62e9\u54ea\u6b3e\u78b0\u78b0\u8f66\uff1f", "answer": "\u4f5c\u4e3a\u78b0\u78b0\u8f66\u5927\u7834\u574f\u8d5b\u7684\u65b0\u73a9\u5bb6\uff0c\u8bf7\u4ece\u201c\u5165\u95e8\u8f66\u201d\u5f00\u59cb\u3002\u5b83\u5728\u901f\u5ea6\u3001\u8010\u4e45\u6027\u548c\u64cd\u63a7\u6027\u65b9\u9762\u62e5\u6709\u5e73\u8861\u7684\u5c5e\u6027\uff0c\u8fd9\u4f7f\u5f97\u5b66\u4e60\u6e38\u620f\u673a\u5236\u66f4\u5bb9\u6613\u3002\u4f8b\u5982\uff0c\u5728\u201c\u68ee\u6797\u72c2\u70ed\u201d\u5730\u56fe\u4e2d\uff0c\u5165\u95e8\u8f66\u7684\u5e73\u8861\u5c5e\u6027\u6709\u52a9\u4e8e\u4f60\u5728\u8302\u5bc6\u7684\u6811\u6797\u4e2d\u5bfc\u822a\uff0c\u800c\u4e0d\u4f1a\u5931\u53bb\u63a7\u5236\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u5165\u95e8\u8f66\uff1a\u5e73\u8861 | \u901f\u5ea6\u578b\uff1a\u5feb\u901f\u4f46\u8106\u5f31 | \u5766\u514b\u578b\uff1a\u6162\u4f46\u8010\u7528]"}, {"question": "\u5bf9\u4e8e\u9ad8\u7ea7\u73a9\u5bb6\u6765\u8bf4\uff0c\u5730\u56fe\u610f\u8bc6\u5728\u78b0\u78b0\u8f66\u5927\u7834\u574f\u8d5b\u4e2d\u4e3a\u4ec0\u4e48\u91cd\u8981\uff1f", "answer": "\u5bf9\u4e8e\u78b0\u78b0\u8f66\u5927\u7834\u574f\u8d5b\u7684\u9ad8\u7ea7\u73a9\u5bb6\u6765\u8bf4\uff0c\u5730\u56fe\u610f\u8bc6\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u53ef\u4ee5\u8ba9\u4f60\u9884\u6d4b\u969c\u788d\u7269\u3001\u9053\u5177\u4f4d\u7f6e\u548c\u5bf9\u624b\u7684\u884c\u52a8\u3002\u4f8b\u5982\uff0c\u5728\u201c\u51b0\u706b\u5730\u72f1\u201d\u5730\u56fe\u4e2d\uff0c\u77e5\u9053\u51b0\u5757\u533a\u57df\u7684\u4f4d\u7f6e\u53ef\u4ee5\u5e2e\u52a9\u4f60\u907f\u514d\u6ed1\u51fa\u8d5b\u9053\u3002\u6b65\u9aa4 1\uff1a\u6bd4\u8d5b\u5f00\u59cb\u524d\u7814\u7a76\u5730\u56fe\u5e03\u5c40\u3002\u6b65\u9aa4 2\uff1a\u6bd4\u8d5b\u671f\u95f4\u5bc6\u5207\u5173\u6ce8\u5c0f\u5730\u56fe\u3002\u6b65\u9aa4 3\uff1a\u6839\u636e\u5b9e\u65f6\u5730\u56fe\u60c5\u51b5\u8c03\u6574\u4f60\u7684\u7b56\u7565\u3002[\u6d41\u7a0b\u56fe\u89e3: \u5730\u56fe\u7814\u7a76 -> \u5c0f\u5730\u56fe\u76d1\u63a7 -> \u7b56\u7565\u8c03\u6574]"}, {"question": "\u5982\u4f55\u5728\u78b0\u78b0\u8f66\u5927\u7834\u574f\u8d5b\u4e2d\u4f18\u5316\u78b0\u78b0\u8f66\u7684\u6027\u80fd\uff1f", "answer": "\u5728\u78b0\u78b0\u8f66\u5927\u7834\u574f\u8d5b\u4e2d\u4f18\u5316\u4f60\u7684\u78b0\u78b0\u8f66\u6027\u80fd\uff0c\u91cd\u70b9\u63d0\u5347\u901f\u5ea6\u3001\u8010\u4e45\u6027\u548c\u64cd\u63a7\u6027\u7b49\u5173\u952e\u5c5e\u6027\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5c71\u533a\u72c2\u66b4\u201d\u5730\u56fe\u4e2d\uff0c\u63d0\u5347\u4f60\u7684\u8f66\u7684\u64cd\u63a7\u6027\u53ef\u4ee5\u5e2e\u52a9\u4f60\u66f4\u6709\u6548\u5730\u9a7e\u9a6d\u9661\u5ced\u7684\u5c71\u5761\u3002\u6b65\u9aa4 1\uff1a\u901a\u8fc7\u5b8c\u6210\u6bd4\u8d5b\u83b7\u5f97\u91d1\u5e01\u3002\u6b65\u9aa4 2\uff1a\u524d\u5f80\u8f66\u5e93\u5347\u7ea7\u4f60\u7684\u6c7d\u8f66\u3002\u6b65\u9aa4 3\uff1a\u5728\u7ec3\u4e60\u8d5b\u4e2d\u6d4b\u8bd5\u4f60\u7684\u5347\u7ea7\uff0c\u4ee5\u786e\u4fdd\u5b83\u4eec\u7b26\u5408\u4f60\u7684\u9700\u6c42\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u4f60\u7684\u8f66\u60f3\u8c61\u6210\u4e00\u53f0\u7ecf\u8fc7\u7cbe\u7ec6\u8c03\u6821\u7684\u4e50\u5668\uff0c\u6bcf\u4e00\u6b21\u5347\u7ea7\u90fd\u63d0\u5347\u5b83\u7684\u6027\u80fd\u3002]"}, {"question": "\u5728\u78b0\u78b0\u8f66\u5927\u7834\u574f\u8d5b\u7684\u56e2\u961f\u6a21\u5f0f\u4e2d\uff0c\u6211\u80fd\u4f7f\u7528\u54ea\u4e9b\u7b56\u7565\u83b7\u80dc\uff1f", "answer": "\u5728\u78b0\u78b0\u8f66\u5927\u7834\u574f\u8d5b\u7684\u56e2\u961f\u6a21\u5f0f\u4e2d\uff0c\u534f\u8c03\u548c\u89d2\u8272\u5206\u5de5\u662f\u5173\u952e\u3002\u4f8b\u5982\uff0c\u5728\u201c\u57ce\u5e02\u9a9a\u4e71\u201d\u5730\u56fe\u4e2d\uff0c\u8ba9\u4e00\u540d\u73a9\u5bb6\u4e13\u6ce8\u4e8e\u6536\u96c6\u9053\u5177\uff0c\u800c\u5176\u4ed6\u73a9\u5bb6\u5219\u8fdb\u884c\u9632\u5b88\u6216\u653b\u51fb\u3002\u6b65\u9aa4 1\uff1a\u6bd4\u8d5b\u5f00\u59cb\u524d\u4e0e\u4f60\u7684\u56e2\u961f\u6c9f\u901a\u3002\u6b65\u9aa4 2\uff1a\u6839\u636e\u6bcf\u4e2a\u73a9\u5bb6\u7684\u4f18\u52bf\u5206\u914d\u89d2\u8272\u3002\u6b65\u9aa4 3\uff1a\u6267\u884c\u4f60\u7684\u7b56\u7565\uff0c\u540c\u65f6\u9002\u5e94\u52a8\u6001\u7684\u6bd4\u8d5b\u60c5\u51b5\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u4fb5\u7565\u6027\u7b56\u7565\uff1a\u4e13\u6ce8\u4e8e\u8fdb\u653b | \u9632\u5fa1\u6027\u7b56\u7565\uff1a\u4f18\u5148\u8003\u8651\u4fdd\u62a4 | \u5e73\u8861\u7b56\u7565\uff1a\u4e24\u8005\u517c\u987e]"}, {"question": "\u78b0\u78b0\u8f66\u5927\u7834\u574f\u8d5b\u4e2d\u7684\u5f97\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u78b0\u78b0\u8f66\u5927\u7834\u574f\u8d5b\u4e2d\u7684\u5f97\u5206\u7cfb\u7edf\u57fa\u4e8e\u6bd4\u8d5b\u4f4d\u7f6e\u3001\u9020\u6210\u7684\u4f24\u5bb3\u548c\u6536\u96c6\u7684\u9053\u5177\u7684\u7efc\u5408\u3002\u4f8b\u5982\uff0c\u5728\u201c\u4e1b\u6797\u72c2\u6b22\u201d\u5730\u56fe\u4e2d\u83b7\u5f97\u7b2c\u4e00\u540d\u5956\u52b1 100 \u5206\uff0c\u800c\u6bcf\u6b21\u6536\u96c6\u9053\u5177\u5219\u989d\u5916\u589e\u52a0 10 \u5206\u3002\u6b64\u5916\uff0c\u5bf9\u5bf9\u624b\u9020\u6210\u4f24\u5bb3\u5c06\u6bcf\u51fb\u989d\u5916\u5956\u52b1 5 \u5206\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u6bd4\u8d5b\u4f4d\u7f6e\uff1a\u7b2c\u4e00\u540d\uff1a100 \u5206 | \u9053\u5177\uff1a\u6bcf\u4e2a\u9053\u5177 +10 \u5206 | \u9020\u6210\u7684\u4f24\u5bb3\uff1a\u6bcf\u51fb +5 \u5206]"}, {"question": "\u78b0\u78b0\u8f66\u5927\u7834\u574f\u8d5b\u4e2d\u78b0\u649e\u7684\u6f5c\u5728\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "\u78b0\u78b0\u8f66\u5927\u7834\u574f\u8d5b\u4e2d\u7684\u78b0\u649e\u673a\u5236\u57fa\u4e8e\u7269\u7406\u6a21\u62df\uff0c\u5b83\u8003\u8651\u4e86\u901f\u5ea6\u3001\u649e\u51fb\u89d2\u5ea6\u548c\u8f66\u8f86\u8010\u4e45\u6027\u3002\u4f8b\u5982\uff0c\u5728\u201c\u706b\u5c71\u6f29\u6da1\u201d\u5730\u56fe\u4e2d\uff0c\u9ad8\u901f\u6b63\u9762\u78b0\u649e\u4f1a\u5bf9\u4e24\u8f86\u8f66\u9020\u6210\u91cd\u5927\u635f\u5bb3\u3002\u6e38\u620f\u4f1a\u8ba1\u7b97\u649e\u51fb\u529b\uff0c\u5e76\u5c06\u5176\u5e94\u7528\u4e8e\u8f66\u8f86\u7684\u8010\u4e45\u6027\u5c5e\u6027\uff0c\u5982\u679c\u8010\u4e45\u6027\u964d\u81f3\u96f6\uff0c\u5219\u4f1a\u5bfc\u81f4\u649e\u51fb\u6dd8\u6c70\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u78b0\u649e\u60f3\u8c61\u6210\u6cf0\u5766\u7684\u51b2\u7a81\uff0c\u529b\u91cf\u51b3\u5b9a\u7ed3\u679c\u3002]"}, {"question": "\u6211\u53ef\u4ee5\u5728\u78b0\u78b0\u8f66\u5927\u7834\u574f\u8d5b\u4e2d\u5c06\u6211\u7684\u79fb\u52a8\u7aef\u8fdb\u5ea6\u8f6c\u79fb\u5230\u7535\u8111\u4e0a\u5417\uff1f", "answer": "\u662f\u7684\uff0c\u4f60\u53ef\u4ee5\u901a\u8fc7\u5c06\u4f60\u7684\u6e38\u620f\u8d26\u53f7\u94fe\u63a5\u5230\u4e00\u4e2a\u901a\u7528\u4e2a\u4eba\u8d44\u6599\u6765\u5c06\u4f60\u7684\u79fb\u52a8\u7aef\u8fdb\u5ea6\u8f6c\u79fb\u5230\u7535\u8111\u7aef\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5df2\u7ecf\u5728\u4f60\u7684\u79fb\u52a8\u7aef\u89e3\u9501\u4e86\u201c\u901f\u5ea6\u578b\u6c7d\u8f66\u201d\uff0c\u90a3\u4e48\u4e00\u65e6\u94fe\u63a5\u4e86\u8d26\u53f7\uff0c\u5b83\u5c31\u4f1a\u5728\u4f60\u7684\u7535\u8111\u4e0a\u53ef\u7528\u3002\u6b65\u9aa4 1\uff1a\u5728\u6e38\u620f\u8bbe\u7f6e\u4e2d\u521b\u5efa\u901a\u7528\u4e2a\u4eba\u8d44\u6599\u3002\u6b65\u9aa4 2\uff1a\u4f7f\u7528\u540c\u4e00\u4e2a\u4eba\u8d44\u6599\u767b\u5f55\u4e24\u4e2a\u8bbe\u5907\u3002\u6b65\u9aa4 3\uff1a\u540c\u6b65\u4f60\u7684\u8fdb\u5ea6\uff0c\u4ee5\u786e\u4fdd\u6240\u6709\u89e3\u9501\u548c\u5347\u7ea7\u90fd\u5df2\u8f6c\u79fb\u3002[\u6d41\u7a0b\u56fe\u89e3: \u4e2a\u4eba\u8d44\u6599\u521b\u5efa -> \u8bbe\u5907\u767b\u5f55 -> \u8fdb\u5ea6\u540c\u6b65]"}, {"question": "\u78b0\u78b0\u8f66\u5927\u7834\u574f\u8d5b\u4e2d\u662f\u5426\u5b58\u5728\u4efb\u4f55\u9690\u85cf\u5f69\u86cb\uff1f", "answer": "\u662f\u7684\uff0c\u78b0\u78b0\u8f66\u5927\u7834\u574f\u8d5b\u5305\u542b\u8bb8\u591a\u9690\u85cf\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u5728\u201c\u9b3c\u5f71\u9ad8\u901f\u516c\u8def\u201d\u5730\u56fe\u4e2d\uff0c\u5982\u679c\u5728\u5348\u591c\u65f6\u5206\uff08\u6e38\u620f\u65f6\u95f4\uff09\u7a7f\u8fc7\u7279\u5b9a\u5893\u5730\u533a\u57df\uff0c\u4e00\u8f86\u9b3c\u8f66\u5c06\u4f1a\u51fa\u73b0\u5e76\u4e0e\u4f60\u4e00\u8d77\u6bd4\u8d5b\u3002\u8fd9\u4e2a\u5f69\u86cb\u662f\u5bf9\u7ecf\u5178\u6050\u6016\u7535\u5f71\u7684\u81f4\u656c\uff0c\u5e76\u4e14\u4e3a\u53d1\u73b0\u5b83\u7684\u73a9\u5bb6\u589e\u52a0\u4e86\u989d\u5916\u7684\u4e50\u8da3\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u5176\u60f3\u8c61\u6210\u4e00\u573a\u79d8\u5bc6\u5bfb\u5b9d\u6e38\u620f\uff0c\u5176\u4e2d\u5956\u52b1\u662f\u4e00\u4e2a\u4ee4\u4eba\u5174\u594b\u7684\u60ca\u559c\u3002]"}]
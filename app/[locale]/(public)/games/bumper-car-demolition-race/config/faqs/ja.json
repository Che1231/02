[{"question": "\u30d0\u30f3\u30d7\u30ab\u30fc\u7834\u58ca\u30ec\u30fc\u30b9\u306e\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001\u81ea\u5206\u306e\u30d0\u30f3\u30d7\u30ab\u30fc\u3092\u3069\u306e\u3088\u3046\u306b\u5236\u5fa1\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30f3\u30d7\u30ab\u30fc\u7834\u58ca\u30ec\u30fc\u30b9\u3067\u30d0\u30f3\u30d7\u30ab\u30fc\u3092\u64cd\u4f5c\u3059\u308b\u306b\u306f\u3001\u77e2\u5370\u30ad\u30fc\u307e\u305f\u306fWASD\u30ad\u30fc\u3092\u4f7f\u3063\u3066\u79fb\u52d5\u3057\u307e\u3059\u3002\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u3092\u62bc\u3059\u3068\u30d6\u30fc\u30b9\u30c8\u304c\u4f5c\u52d5\u3057\u3001\u901f\u5ea6\u3092\u5897\u3084\u3059\u306e\u306b\u91cd\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u90fd\u5e02\u306e\u6df7\u6c8c\u300f\u30de\u30c3\u30d7\u3067\u306f\u3001\u72ed\u3044\u30b3\u30fc\u30ca\u30fc\u3092\u30d6\u30fc\u30b9\u30c8\u3059\u308b\u3068\u885d\u7a81\u3092\u56de\u907f\u3067\u304d\u307e\u3059\u3002\u64cd\u4f5c\u611f\u3092\u5f97\u308b\u305f\u3081\u306b\u3001\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30e2\u30fc\u30c9\u3067\u7df4\u7fd2\u3059\u308b\u3053\u3068\u3092\u304a\u52e7\u3081\u3057\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u30d0\u30f3\u30d7\u30ab\u30fc\u3092\u6a5f\u654f\u306a\u30c0\u30f3\u30b5\u30fc\u306b\u898b\u7acb\u3066\u3001\u6b63\u78ba\u306a\u5165\u529b\u3067\u30b9\u30e0\u30fc\u30ba\u306b\u6ed1\u3089\u304b\u306b\u52d5\u304f\u3088\u3046\u306b\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30d0\u30f3\u30d7\u30ab\u30fc\u7834\u58ca\u30ec\u30fc\u30b9\u306e\u57fa\u672c\u7684\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3068\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u308c\u3089\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30f3\u30d7\u30ab\u30fc\u7834\u58ca\u30ec\u30fc\u30b9\u306b\u306f\u30013\u3064\u306e\u57fa\u672c\u7684\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u304c\u3042\u308a\u307e\u3059\uff1a\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u3001\u30b7\u30fc\u30eb\u30c9\u3001\u30df\u30b5\u30a4\u30eb\u3067\u3059\u3002\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u306f\u4e00\u6642\u7684\u306b\u8eca\u306e\u901f\u5ea6\u3092\u5897\u3084\u3057\u3001\u30b7\u30fc\u30eb\u30c9\u306f1\u56de\u306e\u30d2\u30c3\u30c8\u304b\u3089\u4fdd\u8b77\u3057\u3001\u30df\u30b5\u30a4\u30eb\u306f\u5bfe\u6226\u76f8\u624b\u3092\u30bf\u30fc\u30b2\u30c3\u30c8\u306b\u3057\u3066\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u7802\u6f20\u306e\u75be\u8d70\u300f\u30de\u30c3\u30d7\u3067\u306f\u3001\u30b7\u30fc\u30eb\u30c9\u3092\u4f7f\u3046\u3068\u3001\u7a81\u7136\u306e\u969c\u5bb3\u7269\u306b\u3072\u3063\u304f\u308a\u8fd4\u3055\u308c\u308b\u306e\u3092\u9632\u3050\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u8868\uff1a\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\uff1a5\u79d2\u9593+50\uff05\u306e\u901f\u5ea6\uff5c\u30b7\u30fc\u30eb\u30c9\uff1a1\u56de\u306e\u30d2\u30c3\u30c8\u3092\u5438\u53ce\uff5c\u30df\u30b5\u30a4\u30eb\uff1a\u30bf\u30fc\u30b2\u30c3\u30c8\u306b30\u306e\u30c0\u30e1\u30fc\u30b8]"}, {"question": "\u30d0\u30f3\u30d7\u30ab\u30fc\u7834\u58ca\u30ec\u30fc\u30b9\u306e\u65b0\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u3057\u3066\u3001\u3069\u306e\u30d0\u30f3\u30d7\u30ab\u30fc\u3092\u9078\u629e\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30f3\u30d7\u30ab\u30fc\u7834\u58ca\u30ec\u30fc\u30b9\u306e\u65b0\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u3057\u3066\u3001\u300e\u30b9\u30bf\u30fc\u30bf\u30fc\u30ab\u30fc\u300f\u304b\u3089\u59cb\u3081\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30d4\u30fc\u30c9\u3001\u8010\u4e45\u6027\u3001\u64cd\u4f5c\u6027\u306b\u95a2\u3057\u3066\u30d0\u30e9\u30f3\u30b9\u306e\u53d6\u308c\u305f\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u6301\u3061\u3001\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u5b66\u3076\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u68ee\u306e\u72c2\u9a12\u300f\u30de\u30c3\u30d7\u3067\u306f\u3001\u30b9\u30bf\u30fc\u30bf\u30fc\u30ab\u30fc\u306e\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u5c5e\u6027\u304c\u3001\u5bc6\u96c6\u3057\u305f\u6728\u3005\u306e\u4e2d\u3067\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3092\u5931\u3046\u3053\u3068\u306a\u304f\u79fb\u52d5\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u30b9\u30bf\u30fc\u30bf\u30fc\u30ab\u30fc\uff1a\u30d0\u30e9\u30f3\u30b9\u578b\uff5c\u30b9\u30d4\u30fc\u30c9\u30b9\u30bf\u30fc\uff1a\u901f\u3044\u304c\u8106\u3044\uff5c\u30bf\u30f3\u30af\uff1a\u9045\u3044\u3060\u304c\u8010\u4e45\u6027\u304c\u9ad8\u3044]"}, {"question": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u3001\u30d0\u30f3\u30d7\u30ab\u30fc\u7834\u58ca\u30ec\u30fc\u30b9\u3067\u30de\u30c3\u30d7\u306e\u8a8d\u77e5\u306f\u306a\u305c\u91cd\u8981\u3067\u3059\u304b\uff1f", "answer": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u3001\u30d0\u30f3\u30d7\u30ab\u30fc\u7834\u58ca\u30ec\u30fc\u30b9\u3067\u30de\u30c3\u30d7\u306e\u8a8d\u77e5\u306f\u91cd\u8981\u3067\u3059\u3002\u969c\u5bb3\u7269\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306e\u5834\u6240\u3001\u5bfe\u6226\u76f8\u624b\u306e\u52d5\u304d\u3092\u4e88\u6e2c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u6c37\u306e\u7149\u7344\u300f\u30de\u30c3\u30d7\u3067\u306f\u3001\u6c37\u306e\u5834\u6240\u3092\u77e5\u3063\u3066\u3044\u308c\u3070\u3001\u30b3\u30fc\u30b9\u304b\u3089\u6ed1\u308a\u843d\u3061\u308b\u306e\u3092\u9632\u3050\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30ec\u30fc\u30b9\u306e\u524d\u306b\u30de\u30c3\u30d7\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u7814\u7a76\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30ec\u30fc\u30b9\u4e2d\u306b\u30df\u30cb\u30de\u30c3\u30d7\u3092\u5e38\u306b\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u306e\u30de\u30c3\u30d7\u72b6\u6cc1\u306b\u57fa\u3065\u3044\u3066\u6226\u7565\u3092\u8abf\u6574\u3057\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30de\u30c3\u30d7\u306e\u7814\u7a76\u2192\u30df\u30cb\u30de\u30c3\u30d7\u306e\u76e3\u8996\u2192\u6226\u7565\u306e\u8abf\u6574]"}, {"question": "\u30d0\u30f3\u30d7\u30ab\u30fc\u7834\u58ca\u30ec\u30fc\u30b9\u3067\u81ea\u5206\u306e\u30d0\u30f3\u30d7\u30ab\u30fc\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d0\u30f3\u30d7\u30ab\u30fc\u7834\u58ca\u30ec\u30fc\u30b9\u3067\u30d0\u30f3\u30d7\u30ab\u30fc\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u30b9\u30d4\u30fc\u30c9\u3001\u8010\u4e45\u6027\u3001\u64cd\u4f5c\u6027\u306a\u3069\u306e\u4e3b\u8981\u306a\u5c5e\u6027\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u300e\u5c71\u5cb3\u306e\u72c2\u9a12\u300f\u30de\u30c3\u30d7\u3067\u306f\u3001\u8eca\u306e\u64cd\u4f5c\u6027\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3068\u3001\u6025\u306a\u659c\u9762\u3092\u3088\u308a\u52b9\u679c\u7684\u306b\u8d70\u884c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30ec\u30fc\u30b9\u3092\u5b8c\u4e86\u3057\u3066\u30b3\u30a4\u30f3\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30ac\u30ec\u30fc\u30b8\u306b\u884c\u3063\u3066\u8eca\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7df4\u7fd2\u30ec\u30fc\u30b9\u3067\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u30c6\u30b9\u30c8\u3057\u3066\u3001\u30cb\u30fc\u30ba\u306b\u5bfe\u5fdc\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u81ea\u5206\u306e\u8eca\u3092\u7cbe\u5bc6\u306a\u697d\u5668\u306b\u898b\u7acb\u3066\u3001\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3054\u3068\u306b\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u304c\u6d17\u7df4\u3055\u308c\u3066\u3044\u304d\u307e\u3059\u3002]"}, {"question": "\u30d0\u30f3\u30d7\u30ab\u30fc\u7834\u58ca\u30ec\u30fc\u30b9\u306e\u30c1\u30fc\u30e0\u30e2\u30fc\u30c9\u3067\u52dd\u5229\u3059\u308b\u305f\u3081\u306b\u4f7f\u3048\u308b\u6226\u7565\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30f3\u30d7\u30ab\u30fc\u7834\u58ca\u30ec\u30fc\u30b9\u306e\u30c1\u30fc\u30e0\u30e2\u30fc\u30c9\u3067\u306f\u3001\u9023\u643a\u3068\u5f79\u5272\u5206\u62c5\u304c\u91cd\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u90fd\u5e02\u306e\u9a12\u52d5\u300f\u30de\u30c3\u30d7\u3067\u306f\u30011\u4eba\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u96c6\u4e2d\u7684\u306b\u3055\u305b\u308b\u4e00\u65b9\u3001\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u9632\u5fa1\u307e\u305f\u306f\u653b\u6483\u306b\u91cd\u70b9\u3092\u7f6e\u304f\u3088\u3046\u306b\u5272\u308a\u5f53\u3066\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30ec\u30fc\u30b9\u524d\u306b\u30c1\u30fc\u30e0\u3068\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u3092\u3068\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u305d\u308c\u305e\u308c\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u5f37\u3055\u306b\u57fa\u3065\u3044\u3066\u5f79\u5272\u3092\u5272\u308a\u5f53\u3066\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30c0\u30a4\u30ca\u30df\u30c3\u30af\u306a\u30ec\u30fc\u30b9\u72b6\u6cc1\u306b\u5408\u308f\u305b\u3066\u6226\u7565\u3092\u5b9f\u884c\u3057\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u653b\u6483\u7684\u306a\u6226\u7565\uff1a\u653b\u6483\u306b\u91cd\u70b9\uff5c\u9632\u5fa1\u7684\u306a\u6226\u7565\uff1a\u4fdd\u8b77\u3092\u512a\u5148\uff5c\u30d0\u30e9\u30f3\u30b9\u578b\u306e\u6226\u7565\uff1a\u4e21\u65b9\u3092\u30df\u30c3\u30af\u30b9]"}, {"question": "\u30d0\u30f3\u30d7\u30ab\u30fc\u7834\u58ca\u30ec\u30fc\u30b9\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30f3\u30d7\u30ab\u30fc\u7834\u58ca\u30ec\u30fc\u30b9\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30ec\u30fc\u30b9\u9806\u4f4d\u3001\u4e0e\u3048\u305f\u30c0\u30e1\u30fc\u30b8\u3001\u53ce\u96c6\u3057\u305f\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306e\u7d44\u307f\u5408\u308f\u305b\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30b8\u30e3\u30f3\u30b0\u30eb\u30b8\u30e3\u30e0\u300f\u30de\u30c3\u30d7\u30671\u4f4d\u306b\u306a\u308b\u3068100\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u3001\u5404\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u53ce\u96c6\u3059\u308b\u3054\u3068\u306b10\u30dd\u30a4\u30f3\u30c8\u304c\u52a0\u7b97\u3055\u308c\u307e\u3059\u3002\u307e\u305f\u3001\u5bfe\u6226\u76f8\u624b\u306b\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u3068\u30011\u56de\u306e\u30d2\u30c3\u30c8\u306b\u3064\u304d5\u30dd\u30a4\u30f3\u30c8\u304c\u4e0e\u3048\u3089\u308c\u307e\u3059\u3002[\u8868\uff1a\u30ec\u30fc\u30b9\u9806\u4f4d\uff1a1\u4f4d\uff1a100\u30dd\u30a4\u30f3\u30c8\uff5c\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\uff1a1\u500b\u3042\u305f\u308a\uff0b10\u30dd\u30a4\u30f3\u30c8\uff5c\u30c0\u30e1\u30fc\u30b8\uff1a1\u56de\u306e\u30d2\u30c3\u30c8\u306b\u3064\u304d\uff0b5\u30dd\u30a4\u30f3\u30c8]"}, {"question": "\u30d0\u30f3\u30d7\u30ab\u30fc\u7834\u58ca\u30ec\u30fc\u30b9\u306e\u885d\u7a81\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3069\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u304b\uff1f", "answer": "\u30d0\u30f3\u30d7\u30ab\u30fc\u7834\u58ca\u30ec\u30fc\u30b9\u306e\u885d\u7a81\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u901f\u5ea6\u3001\u885d\u7a81\u89d2\u5ea6\u3001\u8eca\u306e\u8010\u4e45\u6027\u3092\u8003\u616e\u3057\u305f\u7269\u7406\u30b7\u30df\u30e5\u30ec\u30fc\u30b7\u30e7\u30f3\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u706b\u5c71\u6e26\u300f\u30de\u30c3\u30d7\u3067\u9ad8\u901f\u3067\u6b63\u9762\u885d\u7a81\u304c\u8d77\u3053\u308b\u3068\u3001\u4e21\u65b9\u306e\u8eca\u306b\u5927\u304d\u306a\u640d\u5bb3\u304c\u767a\u751f\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306f\u885d\u7a81\u306e\u529b\u3092\u8a08\u7b97\u3057\u3001\u8eca\u306e\u8010\u4e45\u6027\u30b9\u30c6\u30fc\u30bf\u30b9\u306b\u9069\u7528\u3057\u307e\u3059\u3002\u8010\u4e45\u6027\u304c0\u306b\u9054\u3059\u308b\u3068\u3001\u30ce\u30c3\u30af\u30a2\u30a6\u30c8\u306b\u3064\u306a\u304c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u885d\u7a81\u3092\u30bf\u30a4\u30bf\u30f3\u306e\u885d\u7a81\u306b\u898b\u7acb\u3066\u3001\u305d\u306e\u529b\u304c\u7d50\u679c\u3092\u6c7a\u5b9a\u3065\u3051\u307e\u3059\u3002]"}, {"question": "\u30d0\u30f3\u30d7\u30ab\u30fc\u7834\u58ca\u30ec\u30fc\u30b9\u3067\u3001\u30e2\u30d0\u30a4\u30eb\u7248\u306e\u9032\u6357\u72b6\u6cc1\u3092PC\u7248\u306b\u79fb\u52d5\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30b2\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30e6\u30cb\u30d0\u30fc\u30b5\u30eb\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u306b\u30ea\u30f3\u30af\u3059\u308b\u3053\u3068\u3067\u3001\u30d0\u30f3\u30d7\u30ab\u30fc\u7834\u58ca\u30ec\u30fc\u30b9\u3067\u30e2\u30d0\u30a4\u30eb\u7248\u306e\u9032\u6357\u72b6\u6cc1\u3092PC\u7248\u306b\u79fb\u52d5\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30e2\u30d0\u30a4\u30eb\u7248\u3067\u300e\u30b9\u30d4\u30fc\u30c9\u30b9\u30bf\u30fc\u30ab\u30fc\u300f\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u305f\u5834\u5408\u3001\u30a2\u30ab\u30a6\u30f3\u30c8\u304c\u30ea\u30f3\u30af\u3055\u308c\u308b\u3068PC\u7248\u3067\u3082\u4f7f\u7528\u53ef\u80fd\u306b\u306a\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b2\u30fc\u30e0\u8a2d\u5b9a\u3067\u30e6\u30cb\u30d0\u30fc\u30b5\u30eb\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u3092\u4f5c\u6210\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u3059\u3079\u3066\u306e\u30a2\u30f3\u30ed\u30c3\u30af\u3068\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u304c\u8ee2\u9001\u3055\u308c\u308b\u3088\u3046\u306b\u3001\u9032\u6357\u72b6\u6cc1\u3092\u540c\u671f\u3057\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u306e\u4f5c\u6210\u2192\u30c7\u30d0\u30a4\u30b9\u30ed\u30b0\u30a4\u30f3\u2192\u9032\u6357\u72b6\u6cc1\u306e\u540c\u671f]"}, {"question": "\u30d0\u30f3\u30d7\u30ab\u30fc\u7834\u58ca\u30ec\u30fc\u30b9\u306b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30d0\u30f3\u30d7\u30ab\u30fc\u7834\u58ca\u30ec\u30fc\u30b9\u306b\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u5e7d\u970a\u306e\u901a\u308a\u300f\u30de\u30c3\u30d7\u3067\u3001\u771f\u591c\u4e2d\uff08\u30b2\u30fc\u30e0\u6642\u9593\uff09\u306b\u7279\u5b9a\u306e\u5893\u5730\u30a8\u30ea\u30a2\u3092\u901a\u904e\u3059\u308b\u3068\u3001\u5e7d\u970a\u306e\u8eca\u304c\u73fe\u308c\u3001\u3042\u306a\u305f\u3068\u4e00\u7dd2\u306b\u30ec\u30fc\u30b9\u3092\u3057\u307e\u3059\u3002\u3053\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3001\u53e4\u5178\u7684\u306a\u30db\u30e9\u30fc\u6620\u753b\u3078\u306e\u30aa\u30de\u30fc\u30b8\u30e5\u3067\u3042\u308a\u3001\u305d\u308c\u3092\u767a\u898b\u3059\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u3001\u3055\u3089\u306b\u697d\u3057\u3044\u8981\u7d20\u3092\u52a0\u3048\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u79d8\u5bc6\u306e\u5b9d\u63a2\u3057\u3067\u3042\u308a\u3001\u305d\u306e\u8912\u7f8e\u306f\u9a5a\u304f\u3079\u304d\u9a5a\u304d\u3067\u3059\u3002]"}]
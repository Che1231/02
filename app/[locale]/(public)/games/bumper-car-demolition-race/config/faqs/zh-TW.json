[{"question": "\u5982\u4f55\u63a7\u5236\u6211\u7684\u78b0\u78b0\u8eca\u5728\u78b0\u78b0\u8eca\u62c6\u9664\u8cfd\u4e2d\uff08\u521d\u5b78\u8005\uff09\uff1f", "answer": "\u8981\u5728\u78b0\u78b0\u8eca\u62c6\u9664\u8cfd\u4e2d\u63a7\u5236\u4f60\u7684\u78b0\u78b0\u8eca\uff0c\u8acb\u4f7f\u7528\u65b9\u5411\u9375\u6216 WASD \u9032\u884c\u79fb\u52d5\u3002\u7a7a\u683c\u9375\u555f\u52d5\u4f60\u7684\u52a0\u901f\u5668\uff0c\u9019\u5c0d\u65bc\u52a0\u901f\u81f3\u95dc\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5728\u300c\u57ce\u5e02\u6df7\u4e82\u300d\u5730\u5716\u4e2d\uff0c\u901a\u904e\u72f9\u7a84\u7684\u5f4e\u9053\u52a0\u901f\u53ef\u4ee5\u5e6b\u52a9\u4f60\u907f\u514d\u78b0\u649e\u3002\u8acb\u52d9\u5fc5\u5728\u6559\u5b78\u6a21\u5f0f\u4e2d\u7df4\u7fd2\uff0c\u4ee5\u719f\u6089\u63a7\u5236\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4f60\u7684\u78b0\u78b0\u8eca\u50cf\u4e00\u4f4d\u9748\u5de7\u7684\u821e\u8005\uff0c\u900f\u904e\u7cbe\u78ba\u7684\u8f38\u5165\uff0c\u5e73\u7a69\u5730\u6ed1\u884c\u3002]"}, {"question": "\u78b0\u78b0\u8eca\u62c6\u9664\u8cfd\u4e2d\u6709\u54ea\u4e9b\u57fa\u672c\u9053\u5177\uff0c\u5b83\u5011\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u5728\u78b0\u78b0\u8eca\u62c6\u9664\u8cfd\u4e2d\uff0c\u6709\u4e09\u500b\u57fa\u672c\u9053\u5177\uff1a\u52a0\u901f\u5668\u3001\u76fe\u724c\u548c\u98db\u5f48\u3002\u52a0\u901f\u5668\u66ab\u6642\u63d0\u5347\u4f60\u7684\u8eca\u901f\uff1b\u76fe\u724c\u4fdd\u8b77\u4f60\u514d\u53d7\u4e00\u6b21\u649e\u64ca\uff1b\u98db\u5f48\u5141\u8a31\u4f60\u7784\u6e96\u4e26\u653b\u64ca\u5c0d\u624b\u3002\u4f8b\u5982\uff0c\u5728\u300c\u6c99\u6f20\u885d\u523a\u300d\u5730\u5716\u4e2d\uff0c\u4f7f\u7528\u76fe\u724c\u53ef\u4ee5\u907f\u514d\u88ab\u7a81\u5982\u5176\u4f86\u7684\u969c\u7919\u7269\u64ca\u5012\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u52a0\u901f\u5668\uff1a\u63d0\u5347\u8eca\u901f 50% 5 \u79d2 | \u76fe\u724c\uff1a\u5438\u6536\u4e00\u6b21\u649e\u64ca | \u98db\u5f48\uff1a\u5c0d\u76ee\u6a19\u9020\u6210 30 \u9ede\u50b7\u5bb3]"}, {"question": "\u4f5c\u70ba\u65b0\u73a9\u5bb6\uff0c\u6211\u5728\u78b0\u78b0\u8eca\u62c6\u9664\u8cfd\u4e2d\u61c9\u8a72\u9078\u64c7\u54ea\u8f1b\u78b0\u78b0\u8eca\uff1f", "answer": "\u4f5c\u70ba\u78b0\u78b0\u8eca\u62c6\u9664\u8cfd\u7684\u65b0\u73a9\u5bb6\uff0c\u8acb\u5f9e\u300c\u5165\u9580\u8eca\u300d\u958b\u59cb\u3002\u5b83\u5728\u901f\u5ea6\u3001\u8010\u4e45\u6027\u548c\u64cd\u63a7\u6027\u65b9\u9762\u90fd\u5177\u6709\u5e73\u8861\u7684\u5c6c\u6027\uff0c\u66f4\u5bb9\u6613\u5b78\u7fd2\u904a\u6232\u6a5f\u5236\u3002\u4f8b\u5982\uff0c\u5728\u300c\u68ee\u6797\u72c2\u71b1\u300d\u5730\u5716\u4e2d\uff0c\u5165\u9580\u8eca\u7684\u5747\u8861\u5c6c\u6027\u6709\u52a9\u65bc\u4f60\u7a7f\u8d8a\u8302\u5bc6\u7684\u6a39\u6797\u800c\u4e0d\u6703\u5931\u53bb\u63a7\u5236\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u5165\u9580\u8eca\uff1a\u5e73\u8861 | \u901f\u5ea6\u5927\u5e2b\uff1a\u5feb\u901f\u4f46\u8106\u5f31 | \u5766\u514b\uff1a\u7de9\u6162\u4f46\u8010\u4e45]"}, {"question": "\u5c0d\u65bc\u9ad8\u7d1a\u73a9\u5bb6\u4f86\u8aaa\uff0c\u5728\u78b0\u78b0\u8eca\u62c6\u9664\u8cfd\u4e2d\uff0c\u70ba\u4ec0\u9ebc\u5730\u5716\u610f\u8b58\u5f88\u91cd\u8981\uff1f", "answer": "\u5c0d\u65bc\u78b0\u78b0\u8eca\u62c6\u9664\u8cfd\u7684\u9ad8\u7d1a\u73a9\u5bb6\u4f86\u8aaa\uff0c\u5730\u5716\u610f\u8b58\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u5141\u8a31\u4f60\u9810\u6e2c\u969c\u7919\u3001\u9053\u5177\u4f4d\u7f6e\u548c\u5c0d\u624b\u52d5\u4f5c\u3002\u4f8b\u5982\uff0c\u5728\u300c\u51b0\u706b\u5730\u7344\u300d\u5730\u5716\u4e2d\uff0c\u77e5\u9053\u51b0\u584a\u5340\u57df\u7684\u4f4d\u7f6e\u53ef\u4ee5\u5e6b\u52a9\u4f60\u907f\u514d\u6ed1\u51fa\u8cfd\u9053\u3002\u6b65\u9a5f1\uff1a\u5728\u6bd4\u8cfd\u524d\u7814\u7a76\u5730\u5716\u4f48\u5c40\u3002\u6b65\u9a5f2\uff1a\u6bd4\u8cfd\u671f\u9593\u5bc6\u5207\u95dc\u6ce8\u5c0f\u578b\u5730\u5716\u3002\u6b65\u9a5f3\uff1a\u6839\u64da\u5373\u6642\u7684\u5730\u5716\u72c0\u6cc1\u8abf\u6574\u7b56\u7565\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u5730\u5716\u7814\u7a76 -> \u5c0f\u578b\u5730\u5716\u76e3\u63a7 -> \u7b56\u7565\u8abf\u6574]"}, {"question": "\u5982\u4f55\u5728\u78b0\u78b0\u8eca\u62c6\u9664\u8cfd\u4e2d\u512a\u5316\u6211\u7684\u78b0\u78b0\u8eca\u6027\u80fd\uff1f", "answer": "\u8981\u5728\u78b0\u78b0\u8eca\u62c6\u9664\u8cfd\u4e2d\u512a\u5316\u4f60\u7684\u78b0\u78b0\u8eca\u6027\u80fd\uff0c\u8acb\u96c6\u4e2d\u63d0\u5347\u95dc\u9375\u5c6c\u6027\uff0c\u4f8b\u5982\u901f\u5ea6\u3001\u8010\u4e45\u6027\u548c\u64cd\u63a7\u6027\u3002\u4f8b\u5982\uff0c\u5728\u300c\u5c71\u8108\u6df7\u4e82\u300d\u5730\u5716\u4e2d\uff0c\u63d0\u5347\u4f60\u7684\u8eca\u8f1b\u64cd\u63a7\u6027\u53ef\u4ee5\u5e6b\u52a9\u4f60\u66f4\u6709\u6548\u5730\u99d5\u99db\u9661\u5ced\u7684\u659c\u5761\u3002\u6b65\u9a5f1\uff1a\u900f\u904e\u5b8c\u6210\u8cfd\u4e8b\u8cfa\u53d6\u786c\u5e63\u3002\u6b65\u9a5f2\uff1a\u524d\u5f80\u8eca\u5eab\u5347\u7d1a\u4f60\u7684\u8eca\u8f1b\u3002\u6b65\u9a5f3\uff1a\u5728\u7df4\u7fd2\u8cfd\u4e2d\u6e2c\u8a66\u4f60\u7684\u5347\u7d1a\uff0c\u78ba\u4fdd\u5b83\u5011\u7b26\u5408\u4f60\u7684\u9700\u6c42\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4f60\u7684\u8eca\u8f1b\u662f\u4e00\u8f1b\u7d93\u904e\u7cbe\u7d30\u8abf\u6574\u7684\u6a02\u5668\uff0c\u6bcf\u4e00\u6b21\u5347\u7d1a\u90fd\u5c07\u63d0\u5347\u5b83\u7684\u6027\u80fd\u3002]"}, {"question": "\u5982\u4f55\u5728\u78b0\u78b0\u8eca\u62c6\u9664\u8cfd\u7684\u5718\u968a\u6a21\u5f0f\u4e2d\u4f7f\u7528\u54ea\u4e9b\u7b56\u7565\u4f86\u7372\u52dd\uff1f", "answer": "\u5728\u78b0\u78b0\u8eca\u62c6\u9664\u8cfd\u7684\u5718\u968a\u6a21\u5f0f\u4e2d\uff0c\u5354\u8abf\u548c\u89d2\u8272\u5c08\u696d\u5316\u81f3\u95dc\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5728\u300c\u57ce\u5e02\u55a7\u56c2\u300d\u5730\u5716\u4e2d\uff0c\u5206\u914d\u4e00\u4f4d\u73a9\u5bb6\u5c08\u6ce8\u65bc\u6536\u96c6\u9053\u5177\uff0c\u800c\u5176\u4ed6\u73a9\u5bb6\u5247\u8ca0\u8cac\u9632\u5b88\u6216\u653b\u64ca\u3002\u6b65\u9a5f1\uff1a\u5728\u6bd4\u8cfd\u524d\u8207\u4f60\u7684\u968a\u4f0d\u6e9d\u901a\u3002\u6b65\u9a5f2\uff1a\u6839\u64da\u6bcf\u4f4d\u73a9\u5bb6\u7684\u512a\u52e2\u5206\u914d\u89d2\u8272\u3002\u6b65\u9a5f3\uff1a\u57f7\u884c\u4f60\u7684\u7b56\u7565\uff0c\u540c\u6642\u9069\u61c9\u52d5\u614b\u7684\u6bd4\u8cfd\u72c0\u6cc1\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u7a4d\u6975\u7b56\u7565\uff1a\u5c08\u6ce8\u65bc\u653b\u64ca | \u9632\u79a6\u7b56\u7565\uff1a\u512a\u5148\u4fdd\u8b77 | \u5e73\u8861\u7b56\u7565\uff1a\u6df7\u5408\u5169\u7a2e\u7b56\u7565]"}, {"question": "\u78b0\u78b0\u8eca\u62c6\u9664\u8cfd\u4e2d\u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u78b0\u78b0\u8eca\u62c6\u9664\u8cfd\u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u8cfd\u4e8b\u4f4d\u7f6e\u3001\u9020\u6210\u7684\u50b7\u5bb3\u548c\u6536\u96c6\u7684\u9053\u5177\u7684\u7d50\u5408\u3002\u4f8b\u5982\uff0c\u5728\u300c\u53e2\u6797\u72c2\u6b61\u300d\u5730\u5716\u4e2d\uff0c\u596a\u5f97\u7b2c\u4e00\u540d\u734e\u52f5 100 \u5206\uff0c\u800c\u6bcf\u6536\u96c6\u4e00\u500b\u9053\u5177\u5247\u52a0 10 \u5206\u3002\u6b64\u5916\uff0c\u5c0d\u5c0d\u624b\u9020\u6210\u50b7\u5bb3\u5247\u6bcf\u64ca\u4e2d\u4e00\u6b21\u52a0 5 \u5206\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u8cfd\u4e8b\u4f4d\u7f6e\uff1a\u7b2c\u4e00\u540d\uff1a100 \u5206 | \u9053\u5177\uff1a\u6bcf\u500b\u9053\u5177\u52a0 10 \u5206 | \u9020\u6210\u7684\u50b7\u5bb3\uff1a\u6bcf\u6b21\u64ca\u4e2d\u52a0 5 \u5206]"}, {"question": "\u78b0\u78b0\u8eca\u62c6\u9664\u8cfd\u4e2d\u78b0\u649e\u7684\u5e95\u5c64\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "\u78b0\u78b0\u8eca\u62c6\u9664\u8cfd\u4e2d\u7684\u78b0\u649e\u6a5f\u5236\u57fa\u65bc\u7269\u7406\u6a21\u64ec\uff0c\u8003\u616e\u5230\u901f\u5ea6\u3001\u649e\u64ca\u89d2\u5ea6\u548c\u8eca\u8f1b\u8010\u4e45\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u300c\u706b\u5c71\u6f29\u6e26\u300d\u5730\u5716\u4e2d\uff0c\u9ad8\u901f\u6b63\u9762\u78b0\u649e\u6703\u5c0d\u5169\u8f1b\u8eca\u9020\u6210\u986f\u8457\u50b7\u5bb3\u3002\u904a\u6232\u8a08\u7b97\u885d\u64ca\u529b\u4e26\u5c07\u5176\u61c9\u7528\u65bc\u8eca\u8f1b\u7684\u8010\u4e45\u5ea6\u5c6c\u6027\uff0c\u5982\u679c\u8010\u4e45\u5ea6\u964d\u81f3\u96f6\uff0c\u53ef\u80fd\u6703\u5c0e\u81f4\u6dd8\u6c70\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u78b0\u649e\u5c31\u50cf\u6cf0\u5766\u7684\u885d\u7a81\uff0c\u529b\u91cf\u6c7a\u5b9a\u7d50\u679c\u3002]"}, {"question": "\u6211\u53ef\u4ee5\u5728\u78b0\u78b0\u8eca\u62c6\u9664\u8cfd\u4e2d\u5c07\u6211\u7684\u884c\u52d5\u5f9e\u624b\u6a5f\u8f49\u79fb\u5230\u96fb\u8166\u55ce\uff1f", "answer": "\u662f\u7684\uff0c\u4f60\u53ef\u4ee5\u900f\u904e\u5c07\u4f60\u7684\u904a\u6232\u5e33\u6236\u9023\u7d50\u5230\u901a\u7528\u500b\u4eba\u6a94\u6848\uff0c\u5c07\u4f60\u7684\u624b\u6a5f\u9032\u5ea6\u8f49\u79fb\u5230\u96fb\u8166\u7684\u78b0\u78b0\u8eca\u62c6\u9664\u8cfd\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u624b\u6a5f\u4e0a\u89e3\u9396\u4e86\u300c\u901f\u5ea6\u5927\u5e2b\u8eca\u300d\uff0c\u9023\u7d50\u5e33\u6236\u5f8c\uff0c\u5b83\u5c07\u6703\u51fa\u73fe\u5728\u4f60\u7684\u96fb\u8166\u4e0a\u3002\u6b65\u9a5f1\uff1a\u5728\u904a\u6232\u8a2d\u5b9a\u4e2d\u5efa\u7acb\u901a\u7528\u500b\u4eba\u6a94\u6848\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u76f8\u540c\u7684\u500b\u4eba\u6a94\u6848\u767b\u5165\u5169\u53f0\u88dd\u7f6e\u3002\u6b65\u9a5f3\uff1a\u540c\u6b65\u4f60\u7684\u9032\u5ea6\uff0c\u4ee5\u78ba\u4fdd\u6240\u6709\u89e3\u9396\u548c\u5347\u7d1a\u90fd\u5df2\u8f49\u79fb\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u500b\u4eba\u6a94\u6848\u5efa\u7acb -> \u88dd\u7f6e\u767b\u5165 -> \u9032\u5ea6\u540c\u6b65]"}, {"question": "\u78b0\u78b0\u8eca\u62c6\u9664\u8cfd\u4e2d\u662f\u5426\u6709\u4efb\u4f55\u96b1\u85cf\u5f69\u86cb\uff1f", "answer": "\u662f\u7684\uff0c\u78b0\u78b0\u8eca\u62c6\u9664\u8cfd\u5305\u542b\u591a\u500b\u96b1\u85cf\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u5728\u300c\u9b3c\u9b45\u9ad8\u901f\u516c\u8def\u300d\u5730\u5716\u4e2d\uff0c\u5982\u679c\u5728\u5348\u591c\uff08\u904a\u6232\u6642\u9593\uff09\u99d5\u99db\u901a\u904e\u7279\u5b9a\u5893\u5730\u5340\u57df\uff0c\u5c07\u6703\u51fa\u73fe\u4e00\u8f1b\u9b3c\u8eca\u8207\u4f60\u4e00\u8d77\u6bd4\u8cfd\u3002\u9019\u500b\u5f69\u86cb\u5411\u7d93\u5178\u6050\u6016\u96fb\u5f71\u81f4\u656c\uff0c\u4e26\u70ba\u767c\u73fe\u5b83\u7684\u73a9\u5bb6\u589e\u6dfb\u8da3\u5473\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4e00\u4e0b\uff0c\u9019\u5c31\u50cf\u4e00\u5834\u79d8\u5bc6\u5c0b\u5bf6\uff0c\u734e\u52f5\u662f\u4e00\u6b21\u4ee4\u4eba\u8208\u596e\u7684\u9a5a\u559c\u3002]"}]
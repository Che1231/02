[{"question": "\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u5411\u3051\u306bSrunki Shooter 2025\u306e\u57fa\u672c\u7684\u306a\u52d5\u304d\u65b9\u3092\u8aac\u660e\u3057\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "Srunki Shooter 2025\u3067\u751f\u5b58\u3059\u308b\u305f\u3081\u306b\u3001\u57fa\u672c\u7684\u306a\u52d5\u304d\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u306f\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u79fb\u52d5\u306b\u306fWASD\u30ad\u30fc\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002W\u30ad\u30fc\u306f\u524d\u9032\u3001S\u30ad\u30fc\u306f\u5f8c\u9000\u3001A\u30ad\u30fc\u306f\u5de6\u3001D\u30ad\u30fc\u306f\u53f3\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6700\u521d\u306e\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001W\u30ad\u30fc\u3092\u62bc\u3057\u306a\u304c\u3089A\u30ad\u30fc\u307e\u305f\u306fD\u30ad\u30fc\u3067\u8abf\u6574\u3059\u308b\u3053\u3068\u3067\u3001\u6575\u306e\u653b\u6483\u3092\u56de\u907f\u3057\u306a\u304c\u3089\u30de\u30c3\u30d7\u3092\u79fb\u52d5\u3067\u304d\u307e\u3059\u3002\u307e\u305f\u3001\u969c\u5bb3\u7269\u3092\u98db\u3073\u8d8a\u3048\u308b\u306b\u306f\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u3092\u62bc\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u64cd\u4f5c\u306f\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30a8\u30ea\u30a2\u3067\u7df4\u7fd2\u3057\u3066\u3001\u7b4b\u8089\u8a18\u61b6\u3092\u69cb\u7bc9\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "Srunki Shooter 2025\u306b\u304a\u3051\u308b\u5f3e\u85ac\u7ba1\u7406\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Srunki Shooter 2025\u3067\u306f\u3001\u5f3e\u85ac\u7ba1\u7406\u304c\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5e38\u306b\u30d8\u30c3\u30c9\u30b7\u30e7\u30c3\u30c8\u3092\u512a\u5148\u3057\u3066\u3001\u5f3e\u85ac\u7bc0\u7d04\u306b\u52aa\u3081\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u7802\u6f20\u306e\u5f85\u3061\u4f0f\u305b\u300d\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u30d8\u30c3\u30c9\u30b7\u30e7\u30c3\u30c81\u767a\u3067\u3001\u305d\u3046\u3067\u306a\u3051\u308c\u30703\uff5e4\u767a\u306e\u4f53\u5f53\u3066\u304c\u5fc5\u8981\u306a\u6575\u3092\u5012\u305b\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u8fd1\u8ddd\u96e2\u306e\u6575\u306b\u306f\u767d\u5175\u6226\u3092\u4f7f\u7528\u3057\u3001\u5f3e\u4e38\u3092\u7bc0\u7d04\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30de\u30c3\u30d7\u4e0a\u306b\u6563\u3089\u3070\u3063\u3066\u3044\u308b\u5f3e\u85ac\u7bb1\u3092\u53ce\u96c6\u3057\u3001\u7279\u306b\u300c\u90fd\u5e02\u5305\u56f2\u300d\u30ec\u30d9\u30eb\u306a\u3069\u306e\u30ea\u30b9\u30af\u306e\u9ad8\u3044\u30a8\u30ea\u30a2\u3067\u53ce\u96c6\u3059\u308b\u3053\u3068\u306b\u91cd\u70b9\u3092\u7f6e\u304d\u307e\u3059\u3002\u3053\u306e\u6226\u7565\u306b\u3088\u308a\u3001\u6fc0\u3057\u3044\u9283\u6483\u6226\u4e2d\u306b\u7a7a\u306b\u306a\u308b\u4e8b\u304c\u306a\u304f\u306a\u308a\u307e\u3059\u3002"}, {"question": "Srunki Shooter 2025\u3067\u6b66\u5668\u306e\u53cd\u52d5\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "Srunki Shooter 2025\u3067\u6b66\u5668\u306e\u53cd\u52d5\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u6b63\u78ba\u6027\u3068\u52b9\u7387\u6027\u3092\u9ad8\u3081\u307e\u3059\u3002\u5404\u6b66\u5668\u306b\u306f\u72ec\u81ea\u306e\u53cd\u52d5\u30d1\u30bf\u30fc\u30f3\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30b9\u30bf\u30f3\u30b0\u30e9\u30fc\u30e9\u30a4\u30d5\u30eb\u300d\u306f\u9023\u7d9a\u5c04\u6483\u5f8c\u3001\u4e0a\u65b9\u306b\u53cd\u52d5\u3059\u308b\u50be\u5411\u304c\u3042\u308a\u307e\u3059\u3002\u305d\u308c\u3092\u5236\u5fa1\u3059\u308b\u306b\u306f\u3001\u6483\u3061\u306a\u304c\u3089\u30de\u30a6\u30b9\u3092\u512a\u3057\u304f\u4e0b\u306b\u5f15\u304d\u307e\u3059\u3002\u300c\u30b8\u30e3\u30f3\u30b0\u30eb\u8972\u6483\u300d\u30df\u30c3\u30b7\u30e7\u30f3\u306a\u3069\u3001\u6b63\u78ba\u6027\u304c\u91cd\u8981\u3068\u306a\u308b\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u7279\u306b\u6709\u52b9\u3067\u3059\u3002\u69d8\u3005\u306a\u6b66\u5668\u306e\u53cd\u52d5\u5236\u5fa1\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u305f\u3081\u306b\u3001\u5c04\u6483\u5834\u3067\u7df4\u7fd2\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "Srunki Shooter 2025\u306e\u4f53\u529b\u56de\u5fa9\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "Srunki Shooter 2025\u306e\u4f53\u529b\u56de\u5fa9\u306f\u30015\u79d2\u9593\u30c0\u30e1\u30fc\u30b8\u3092\u53d7\u3051\u306a\u3044\u5834\u5408\u306b\u59cb\u307e\u308b\u53d7\u52d5\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u5c71\u304b\u3089\u306e\u8131\u51fa\u300d\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u6570\u79d2\u9593\u30ab\u30d0\u30fc\u306e\u5f8c\u308d\u306b\u96a0\u308c\u308b\u3053\u3068\u3067\u3001\u4f53\u529b\u309220\uff05\u304b\u308950\uff05\u307e\u3067\u56de\u5fa9\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3057\u304b\u3057\u3001\u4f53\u529b\u56de\u5fa9\u85ac\u3092\u4f7f\u7528\u3059\u308b\u3068\u5373\u5ea7\u306b\u56de\u5fa9\u3059\u308b\u305f\u3081\u3001\u5371\u6a5f\u7684\u306a\u72b6\u6cc1\u3067\u306f\u304a\u52e7\u3081\u3067\u3059\u3002\u5e38\u306b\u53d7\u52d5\u7684\u306a\u56de\u5fa9\u3068\u7a4d\u6975\u7684\u306a\u6cbb\u7642\u6cd5\u306e\u30d0\u30e9\u30f3\u30b9\u3092\u53d6\u308a\u3001\u751f\u5b58\u7387\u3092\u6700\u5927\u5316\u3057\u307e\u3059\u3002"}, {"question": "Srunki Shooter 2025\u306e\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Srunki Shooter 2025\u306e\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u3001\u7
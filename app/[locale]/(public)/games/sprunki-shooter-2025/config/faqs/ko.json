[{"question": "\uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c Sprunki Shooter 2025\uc758 \uae30\ubcf8 \uc6c0\uc9c1\uc784 \uc218\ud589 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sprunki Shooter 2025\uc5d0\uc11c \uae30\ubcf8\uc801\uc778 \uc6c0\uc9c1\uc784\uc744 \uc775\ud788\ub294 \uac83\uc740 \uc0dd\uc874\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. WASD \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc774\ub3d9\ud569\ub2c8\ub2e4. W\ub294 \uc55e\uc73c\ub85c, S\ub294 \ub4a4\ub85c, A\ub294 \uc67c\ucabd, D\ub294 \uc624\ub978\ucabd\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ubbf8\uc158\uc5d0\uc11c W\ud0a4\ub97c \ub204\ub974\uace0 A \ub610\ub294 D\ud0a4\ub85c \uc870\uc815\ud558\uc5ec \uc801\uc758 \uacf5\uaca9\uc744 \ud53c\ud558\uba70 \uc9c0\ub3c4\ub97c \uc774\ub3d9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uc7a5\uc560\ubb3c\uc744 \ub6f0\uc5b4\ub118\uc73c\ub824\uba74 \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \ub204\ub974\uc138\uc694. \ud29c\ud1a0\ub9ac\uc5bc \uc601\uc5ed\uc5d0\uc11c \uc774\ub7ec\ud55c \ucee8\ud2b8\ub864\uc744 \uc5f0\uc2b5\ud558\uc5ec \uc219\ub2ec\ud558\uc138\uc694."}, {"question": "Sprunki Shooter 2025\uc5d0\uc11c \ud0c4\uc57d \uad00\ub9ac\ub97c \uc704\ud55c \ucd5c\uc0c1\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sprunki Shooter 2025\uc5d0\uc11c \ud0c4\uc57d \uad00\ub9ac\uac00 \uc911\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \ud56d\uc0c1 \ud0c4\uc57d\uc744 \uc808\uc57d\ud558\uae30 \uc704\ud574 \ud5e4\ub4dc\uc0f7\uc744 \uc6b0\uc120\uc2dc\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc0ac\ub9c9\uc758 \uc2b5\uaca9\" \ubbf8\uc158\uc5d0\uc11c \ud5e4\ub4dc\uc0f7 \ud558\ub098\ub85c 3~4\ubc1c\uc758 \ubab8\ud1b5\uc0f7\uc744 \ud544\uc694\ub85c \ud558\ub294 \uc801\uc744 \uc81c\uac70\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 2: \uadfc\uc811\uc804 \uc801\uc5d0\uac8c\ub294 \uadfc\uc811 \uacf5\uaca9\uc744 \uc0ac\uc6a9\ud558\uc5ec \ucd1d\uc54c\uc744 \uc808\uc57d\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ud2b9\ud788 \"\ub3c4\uc2dc \ud3ec\uc704\" \ub2e8\uacc4\uc640 \uac19\uc740 \uace0\uc704\ud5d8 \uc9c0\uc5ed\uc5d0 \ud769\uc5b4\uc838 \uc788\ub294 \ud0c4\uc57d \uc0c1\uc790\ub97c \uc218\uc9d1\ud558\uc2ed\uc2dc\uc624. \uc774 \uc804\ub7b5\uc740 \uce58\uc5f4\ud55c \uad50\uc804 \uc0c1\ud669\uc5d0\uc11c \uc808\ub300 \ud0c4\uc57d\uc774 \ubd80\uc871\ud558\uc9c0 \uc54a\ub3c4\ub85d \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "Sprunki Shooter 2025\uc5d0\uc11c \ubb34\uae30 \ud6c4\ud3ed\ud48d \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sprunki Shooter 2025\uc5d0\uc11c \ubb34\uae30 \ud6c4\ud3ed\ud48d\uc744 \uc774\ud574\ud558\uba74 \uc815\ud655\uc131\uacfc \ud6a8\uc728\uc131\uc774 \ud5a5\uc0c1\ub429\ub2c8\ub2e4. \uac01 \ubb34\uae30\ub294 \uace0\uc720\ud55c \ud6c4\ud3ed\ud48d \ud328\ud134\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc2a4\ud305\uc5b4 \ub77c\uc774\ud50c\"\uc740 \uc5f0\uc18d \ubc1c\uc0ac \ud6c4 \uc704\ucabd\uc73c\ub85c \ub04c\uc5b4\ub2f9\uae30\ub294 \uacbd\ud5a5\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub97c \uc81c\uc5b4\ud558\uae30 \uc704\ud574 \uc0ac\uaca9 \uc2dc \ub9c8\uc6b0\uc2a4\ub97c \ubd80\ub4dc\ub7fd\uac8c \uc544\ub798\ub85c \ub2f9\uae30\uc138\uc694. \uc774 \uae30\uc220\uc740 \uc6d0\uac70\ub9ac \ud45c\uc801\uc744 \uc81c\uac70\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \"\uc815\uae00 \uc2b5\uaca9\" \ubbf8\uc158\uc5d0\uc11c \ud2b9\ud788 \uc720\uc6a9\ud569\ub2c8\ub2e4. \ub2e4\uc591\ud55c \ubb34\uae30\uc5d0 \ub300\ud55c \ud6c4\ud3ed\ud48d \uc81c\uc5b4\ub97c \uc219\ub2ec\uc2dc\ud0a4\ub824\uba74 \uc0ac\uaca9 \ud6c8\ub828\uc7a5\uc5d0\uc11c \uc5f0\uc2b5\ud558\uc138\uc694."}, {"question": "Sprunki Shooter 2025\uc5d0\uc11c \uccb4\ub825 \uc7ac\uc0dd \uba54\ucee4\ub2c8\uc998\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "Sprunki Shooter 2025\uc758 \uccb4\ub825 \uc7ac\uc0dd\uc740 5\ucd08 \ub3d9\uc548 \ud53c\ud574\ub97c \uc785\uc9c0 \uc54a\uc73c\uba74 \ud65c\uc131\ud654\ub418\ub294 \uc218\ub3d9 \uba54\ucee4\ub2c8\uc998\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc0b0\uc545 \ud0c8\ucd9c\" \ubbf8\uc158\uc5d0\uc11c \uba87 \ucd08 \ub3d9\uc548 \uc740\uc2e0\ucc98 \ub4a4\uc5d0 \uc228\uc73c\uba74 \uccb4\ub825\uc774 20%\uc5d0\uc11c 50%\uae4c\uc9c0 \ud68c\ubcf5\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \uccb4\ub825 \ud3ec\uc158\uc740 \uc989\uac01\uc801\uc778 \ud68c\ubcf5\uc744 \uc81c\uacf5\ud558\uba70 \uc911\uc694\ud55c \uc21c\uac04\uc5d0 \uc0ac\uc6a9\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \uc218\ub3d9\uc801 \uc7ac\uc0dd\uacfc \uc801\uadf9\uc801\uc778 \uce58\ub8cc\ub97c \ud56d\uc0c1 \uade0\ud615 \uc788\uac8c \uc0ac\uc6a9\ud558\uc5ec \uc0dd\uc874\uc744 \uadf9\ub300\ud654\ud558\uc138\uc694."}, {"question": "Sprunki Shooter 2025\uc5d0\uc11c \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sprunki Shooter 2025\uc5d0\uc11c \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \ub2e4\ub978 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \"\ub3c4\uc2dc \ud3ec\uc704\" \ubbf8\uc158\uacfc \uac19\uc740 \uc2a4\ud1a0\ub9ac \uc911\uc2ec\uc758 \ucea0\ud398\uc778\uc5d0 \ucd08\uc810\uc744 \ub9de\ucd94\uc5b4 \ud2b9\uc815 \uc2a4\ud1a0\ub9ac \ub77c\uc778\uc744 \ub530\ub985\ub2c8\ub2e4. \ubc18\uba74\uc5d0 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \ud300\uc6cc\ud06c\uc640 \uacbd\uc7c1\uc5d0 \uc911\uc810\uc744 \ub461\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ud300 \ub370\uc2a4\ub9e4\uce58\"\uc5d0\uc11c \uc2b9\ub9ac\ud558\uae30 \uc704\ud574\uc11c\ub294 \ub3d9\ub8cc\ub4e4\uacfc\uc758 \uc870\uc815\uc774 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uac01 \ubaa8\ub4dc\ub294 \ub2e4\ub978 \uc804\ub7b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4\ub294 \uc740\uc2e0\uc220\uacfc \uc815\ud655\uc131\uc744 \ubcf4\uc0c1\ud558\uba70, \uba40\ud2f0\ud50c\ub808\uc774\uc5b4\ub294 \uc758\uc0ac\uc18c\ud1b5\uacfc \uc801\uc751\ub825\uc744 \ubcf4\uc0c1\ud569\ub2c8\ub2e4."}, {"question": "Sprunki Shooter 2025\uc5d0\uc11c \uade0\ud615 \uc7a1\ud78c \ube4c\ub4dc\ub97c \uc704\ud574 \uc5b4\ub5a4 \uae30\uc220\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \ub808\ubca8 \uc5c5\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "Sprunki Shooter 2025\uc5d0\uc11c \uade0\ud615 \uc7a1\ud78c \ube4c\ub4dc\ub294 \ub2e4\uc7ac\ub2e4\ub2a5\ud568\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uae30\uc220\uc5d0 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 1: \"\uc815\ud655\uc131\"\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc5ec \uc0ac\uaca9 \uc815\ud655\uc131\uc744 \ub192\uc774\uc138\uc694. \ud2b9\ud788 \"\uc800\uaca9\uc218\uc758 \ub465\uc9c0\"\uc640 \uac19\uc740 \ubbf8\uc158\uc5d0\uc11c \uc720\uc6a9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \"\uc9c0\uad6c\ub825\"\uc5d0 \ud22c\uc790\ud558\uc5ec \uc774\ub3d9 \uc18d\ub3c4\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\uace0 \uc801\uc758 \uacf5\uaca9\uc744 \ud53c\ud558\uc138\uc694. \ub2e8\uacc4 3: \"\uccb4\ub825 \uc7ac\uc0dd\"\uc744 \ub808\ubca8 \uc5c5\ud558\uc5ec \uc804\ud22c\uc5d0\uc11c \ub354 \uc624\ub798 \ubc84\ud2f0\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \"\ubc99\ucee4 \uacf5\uaca9\" \ubbf8\uc158\uc5d0\uc11c \uade0\ud615 \uc7a1\ud78c \ube4c\ub4dc\ub294 \uacf5\uaca9\uacfc \uc218\ube44 \uc804\uc220\uc744 \ub9e4\ub044\ub7fd\uac8c \uc804\ud658\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4."}, {"question": "Sprunki Shooter 2025\uc5d0\uc11c \uc2a4\ud154\uc2a4 \ubbf8\uc158\uc744 \uc704\ud55c \ub85c\ub4dc\uc544\uc6c3\uc744 \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Sprunki Shooter 2025\uc5d0\uc11c \uc2a4\ud154\uc2a4 \ubbf8\uc158\uc744 \uc704\ud55c \ub85c\ub4dc\uc544\uc6c3 \ucd5c\uc801\ud654\ub294 \uc2e0\uc911\ud55c \uc120\ud0dd\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \"\uadf8\ub9bc\uc790 \uad8c\ucd1d\"\uacfc \uac19\uc740 \uc18c\uc74c \uc81c\uac70 \ubb34\uae30\ub97c \uc7a5\ube44\ud558\uc5ec \uc801\uc744 \uc870\uc6a9\ud788 \uc81c\uac70\ud558\uc138\uc694. \ub2e8\uacc4 2: \uc5f0\ub9c9\ud0c4\uacfc \uac19\uc740 \uc7a5\uce58\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud63c\ub780\uc744 \uc57c\uae30\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \"\uc57c\uac04 \uce68\ud22c\" \ubbf8\uc158\uc5d0\uc11c \uc5f0\ub9c9\ud0c4\uc740 \uac10\uc2dc\uac00 \uc5c4\uc911\ud55c \uc9c0\uc5ed\uc744 \uc6b0\ud68c\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc704\uc7a5 \uc7a5\ube44\ub97c \ucc29\uc6a9\ud558\uc5ec \uc2dc\uc57c\ub97c \uac10\uc18c\uc2dc\ud0a4\uc138\uc694. \uc774 \ub85c\ub4dc\uc544\uc6c3\uc740 \uc801\uc744 \uacbd\uace0\ud558\uc9c0 \uc54a\uace0 \ubaa9\ud45c\ub97c \ub2ec\uc131\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4."}, {"question": "Sprunki Shooter 2025\ub97c PC\uc5d0\uc11c \uc2e4\ud589\ud558\uae30 \uc704\ud55c \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sprunki Shooter 2025\ub97c PC\uc5d0\uc11c \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ud558\ub824\uba74 \uc2dc\uc2a4\ud15c\uc774 \ub2e4\uc74c \uc694\uad6c \uc0ac\ud56d\uc744 \ucda9\uc871\ud574\uc57c \ud569\ub2c8\ub2e4. [\ucd5c\uc18c: \uc6b4\uc601 \uccb4\uc81c: Windows 10, \ud504\ub85c\uc138\uc11c: Intel i5-4460, RAM: 8GB, \uadf8\ub798\ud53d \uce74\ub4dc: NVIDIA GTX 960, \uc800\uc7a5 \uacf5\uac04: 50GB] [\uad8c\uc7a5: \uc6b4\uc601 \uccb4\uc81c: Windows 11, \ud504\ub85c\uc138\uc11c: Intel i7-9700K, RAM: 16GB, \uadf8\ub798\ud53d \uce74\ub4dc: NVIDIA RTX 2070, \uc800\uc7a5 \uacf5\uac04: 50GB SSD]. \uc608\ub97c \ub4e4\uc5b4, \uad8c\uc7a5 \uc0ac\uc591\uc744 \uac16\ucd98 \ud50c\ub808\uc774\uc5b4\ub294 \"\ub300\ub3c4\uc2dc \ub300\uacb0\" \ubbf8\uc158\uc5d0\uc11c \uace0\ud488\uc9c8 \uc124\uc815\uc5d0\uc11c 60 FPS\ub97c \uc990\uae38 \uc218 \uc788\ub294 \ubc18\uba74, \ucd5c\uc18c \uc0ac\uc591\uc740 \ucd5c\uc801\uc758 \uc131\ub2a5\uc744 \uc704\ud574 \uc124\uc815\uc744 \ub0ae\ucd9c \ud544\uc694\uac00 \uc788\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Sprunki Shooter 2025\uc5d0\uc11c PC\uc5d0\uc11c \ucf58\uc194\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Sprunki Shooter 2025\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub294 \uac83\uc740 \uac04\ub2e8\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: Steam\uc774\ub098 Xbox Live\uc640 \uac19\uc740 \ubcf4\ud3b8\uc801\uc778 \ud50c\ub7ab\ud3fc\uc5d0 \uac8c\uc784 \uacc4\uc815\uc744 \uc5f0\uacb0\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ucf58\uc194\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc232 \ud0c8\ucd9c\" \ubbf8\uc158\uc744 PC\uc5d0\uc11c \uc644\ub8cc\ud588\ub2e4\uba74 \ucf58\uc194\ub85c \uc790\ub3d9\uc73c\ub85c \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc804\uc1a1 \uc911\uc5d0 \ub450 \uae30\uae30 \ubaa8\ub450 \uc778\ud130\ub137\uc5d0 \uc5f0\uacb0\ub418\uc5b4 \uc788\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. \uc774 \ud504\ub85c\uc138\uc2a4\ub294 \ud50c\ub7ab\ud3fc \uac04 \uc6d0\ud65c\ud55c \uac8c\uc784 \uc5f0\uc18d\uc131\uc744 \uac00\ub2a5\ud558\uac8c \ud569\ub2c8\ub2e4."}, {"question": "Sprunki Shooter 2025\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Sprunki Shooter 2025\uc5d0\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uac00\ub4dd\ud569\ub2c8\ub2e4. \ud55c \uac00\uc9c0 \uc8fc\ubaa9\ud560\ub9cc\ud55c \uc608\ub294 \"\uace0\ub300 \uc720\uc801\" \ubbf8\uc158\uc758 \"\ud669\uae08 \uc2a4\ud504\ub860\ud0a4 \uc870\uac01\uc0c1\"\uc785\ub2c8\ub2e4. \uc774 \uc870\uac01\uc0c1\uc744 \ucc3e\uc73c\ub824\uba74 \uc138 \uac1c\uc758 \uc228\uaca8\uc9c4 \uc2a4\uc704\uce58\ub97c \ud65c\uc131\ud654\ud55c \ud6c4 \uc9c0\ub3c4\uc758 \ub3d9\ub0a8\ucabd \ubaa8\ud241\uc774\ub97c \ud0d0\ud5d8\ud558\uc138\uc694. \ub610 \ub2e4\ub978 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uba54\uc778 \uba54\ub274\uc5d0\uc11c \ud2b9\uc815 \ubc84\ud2bc \uc2dc\ud000\uc2a4\ub97c \uc785\ub825\ud558\uba74 \uc811\uadfc\ud560 \uc218 \uc788\ub294 \"\uac1c\ubc1c\uc790 \ubc29\"\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uc740 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ub3c5\ud2b9\ud55c \uc544\uc774\ud15c\uacfc \uac8c\uc784 \uc138\uacc4\uad00\uc5d0 \uae4a\uc774\ub97c \ub354\ud558\ub294 \ubc30\uacbd \uc2a4\ud1a0\ub9ac\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4."}]
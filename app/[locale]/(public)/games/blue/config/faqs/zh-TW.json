[{"question": "\u65b0\u624b\u6c42\u52a9\uff1a\u5728\u85cd\u8272\u904a\u6232\u4e2d\uff0c\u5982\u4f55\u5feb\u901f\u4e0a\u624b\u4e26\u5b8c\u6210\u6700\u521d\u7684\u5e7e\u500b\u4efb\u52d9\uff1f\u6709\u54ea\u4e9b\u85cd\u8272\u904a\u6232\u65b0\u624b\u5fc5\u77e5\u7684\u6280\u5de7\uff1f", "answer": "\u85cd\u8272\u904a\u6232\u7684\u521d\u671f\u4efb\u52d9\u65e8\u5728\u8b93\u4f60\u719f\u6089\u904a\u6232\u64cd\u4f5c\u548c\u57fa\u672c\u6a5f\u5236\u3002\u9996\u5148\uff0c\u8ddf\u8457\u6559\u5b78\u5f15\u5c0e\uff0c\u5b83\u6703\u6559\u4f60\u79fb\u52d5\u3001\u4e92\u52d5\u548c\u6230\u9b25\u3002\u4f8b\u5982\uff0c\u7b2c\u4e00\u500b\u4efb\u52d9\u901a\u5e38\u662f\u6536\u96c6\u8cc7\u6e90\uff0c\u6ce8\u610f\u87a2\u5e55\u4e0a\u7684\u63d0\u793a\uff0c\u4f8b\u5982\u300c\u6309 E \u9375\u62fe\u53d6\u300d\u3002\u5176\u6b21\uff0c\u5229\u7528\u904a\u6232\u5167\u7684\u5730\u5716\u548c\u5c0e\u822a\u7cfb\u7d71\uff0c\u53ef\u4ee5\u5feb\u901f\u627e\u5230\u76ee\u6a19\u5730\u9ede\u3002\u7b2c\u4e09\uff0c\u4e0d\u8981\u5bb3\u6015\u5617\u8a66\uff0c\u85cd\u8272\u904a\u6232\u524d\u671f\u5bb9\u932f\u7387\u5f88\u9ad8\uff0c\u591a\u5617\u8a66\u4e0d\u540c\u7684\u6280\u80fd\u548c\u88dd\u5099\u7d44\u5408\u3002\u9019\u4e9b\u65b0\u624b\u6280\u5de7\u4e00\u5b9a\u80fd\u8b93\u4f60\u66f4\u5feb\u878d\u5165\u85cd\u8272\u904a\u6232\u7684\u4e16\u754c\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u8cc7\u6e90\u7ba1\u7406\u5728\u85cd\u8272\u904a\u6232\u4e2d\u5982\u6b64\u91cd\u8981\uff1f\u65b0\u624b\u73a9\u5bb6\u80fd\u63a1\u53d6\u54ea\u4e9b\u7b56\u7565\u4f86\u6709\u6548\u5730\u6536\u96c6\u548c\u5229\u7528\u904a\u6232\u521d\u671f\u8cc7\u6e90\uff1f(\u85cd\u8272\u8cc7\u6e90\u7ba1\u7406\u91cd\u8981\u6027\u5206\u6790)", "answer": "\u8cc7\u6e90\u5728\u85cd\u8272\u904a\u6232\u4e2d\u81f3\u95dc\u91cd\u8981\uff0c\u5b83\u5011\u652f\u6490\u8457\u4f60\u7684\u751f\u5b58\u548c\u767c\u5c55\u3002\u521d\u671f\uff0c\u512a\u5148\u5347\u7d1a\u4f60\u7684\u8cc7\u6e90\u63a1\u96c6\u5de5\u5177\uff0c\u6548\u7387\u66f4\u9ad8\u3002\u4f8b\u5982\uff0c\u5347\u7d1a\u4f60\u7684\u93ac\u5b50\u53ef\u4ee5\u66f4\u5feb\u5730\u6316\u6398\u7926\u77f3\u3002\u5176\u6b21\uff0c\u5efa\u7acb\u4e00\u500b\u8cc7\u6e90\u5132\u5b58\u9ede\uff0c\u96a8\u6642\u5099\u4efd\u591a\u9918\u7684\u8cc7\u6e90\u3002\u6b65\u9a5f\u4e00\uff1a\u898f\u5283\u63a1\u96c6\u8def\u7dda\uff0c\u95dc\u6ce8\u5730\u5716\u4e0a\u7684\u8cc7\u6e90\u9ede\u3002\u6b65\u9a5f\u4e8c\uff1a\u6839\u64da\u9700\u6c42\u8abf\u6574\u63a1\u96c6\u7b56\u7565\uff0c\u907f\u514d\u6d6a\u8cbb\u3002\u6b65\u9a5f\u4e09\uff1a\u5408\u7406\u5206\u914d\u8cc7\u6e90\uff0c\u512a\u5148\u5347\u7d1a\u6838\u5fc3\u5efa\u7bc9\u548c\u88dd\u5099\u3002\u6bd4\u55bb\u8aaa\u660e\uff1a\u8cc7\u6e90\u5c31\u50cf\u4f60\u7684\u8840\u6db2\uff0c\u6e90\u6e90\u4e0d\u65b7\u5730\u70ba\u4f60\u7684\u89d2\u8272\u63d0\u4f9b\u80fd\u91cf\u3002"}, {"question": "\u85cd\u8272\u904a\u6232\u4e2d\u54ea\u4e9b\u57fa\u672c\u7684\u6230\u9b25\u6a5f\u5236\u65b0\u624b\u73a9\u5bb6\u61c9\u8a72\u5b78\u7fd2\uff0c\u4ee5\u53ca\u5982\u4f55\u6709\u6548\u5730\u7df4\u7fd2\u5b83\u5011\uff1f\u96f6\u57fa\u790e\u85cd\u8272\u904a\u6232\u6230\u9b25\u6559\u5b78", "answer": "\u85cd\u8272\u904a\u6232\u7684\u6230\u9b25\u6a5f\u5236\u5305\u62ec\u653b\u64ca\u3001\u9632\u79a6\u548c\u9583\u907f\u3002\u9996\u5148\uff0c\u719f\u6089\u4f60\u7684\u6b66\u5668\u5c6c\u6027\u53ca\u653b\u64ca\u7bc4\u570d\u3002\u7df4\u7fd2\u65b9\u6cd5\u662f\u5728\u5b89\u5168\u5340\u57df\uff08\u4f8b\u5982\u65b0\u624b\u6751\uff09\u8207\u4f4e\u7d1a\u602a\u7269\u6230\u9b25\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u528d\u6642\uff0c\u53ef\u4ee5\u7df4\u7fd2\u7cbe\u6e96\u7684\u653b\u64ca\u548c\u683c\u64cb\u3002\u5176\u6b21\uff0c\u5b78\u6703\u5229\u7528\u74b0\u5883\uff0c\u6709\u4e9b\u5730\u5f62\u53ef\u4ee5\u63d0\u4f9b\u63a9\u8b77\u6216\u589e\u52a0\u4f60\u7684\u653b\u64ca\u512a\u52e2\u3002\u7b2c\u4e09\uff0c\u5bc6\u5207\u95dc\u6ce8\u6575\u4eba\u7684\u653b\u64ca\u6a21\u5f0f\uff0c\u9810\u5224\u4e26\u9032\u884c\u9583\u907f\u3002\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u4e0d\u540c\u6b66\u5668\u7684\u653b\u64ca\u901f\u5ea6\u548c\u50b7\u5bb3\u7bc4\u570d\u5404\u6709\u4e0d\u540c\uff0c\u8acb\u53c3\u8003\u904a\u6232\u5167\u6b66\u5668\u5c6c\u6027\u8868\u3002"}, {"question": "\u5c0d\u65bc\u85cd\u8272\u904a\u6232\u9032\u968e\u73a9\u5bb6\uff0c\u6709\u54ea\u4e9b\u9032\u968e\u7b56\u7565\u53ef\u4ee5\u6700\u5927\u5316\u89d2\u8272\u5efa\u7acb\u4e26\u512a\u5316\u88dd\u5099\uff1f\u85cd\u8272\u89d2\u8272Build\u601d\u8def", "answer": "\u89d2\u8272\u7684 Build \u548c\u88dd\u5099\u512a\u5316\u662f\u85cd\u8272\u904a\u6232\u9032\u968e\u7684\u95dc\u9375\u3002\u9996\u5148\uff0c\u660e\u78ba\u4f60\u7684\u89d2\u8272\u5b9a\u4f4d\uff0c\u662f\u504f\u5411\u8f38\u51fa\u3001\u9632\u79a6\u9084\u662f\u8f14\u52a9\u3002\u5176\u6b21\uff0c\u6df1\u5165\u4e86\u89e3\u6280\u80fd\u6a39\uff0c\u6839\u64da\u4f60\u7684\u5b9a\u4f4d\u9078\u64c7\u5408\u9069\u7684\u6280\u80fd\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u7684\u89d2\u8272\u662f\u8f38\u51fa\u578b\uff0c\u53ef\u4ee5\u512a\u5148\u5b78\u7fd2\u589e\u52a0\u66b4\u64ca\u7387\u548c\u653b\u64ca\u529b\u7684\u6280\u80fd\u3002\u6b65\u9a5f\u4e00\uff1a\u7814\u7a76\u6280\u80fd\u642d\u914d\u3002\u6b65\u9a5f\u4e8c\uff1a\u7be9\u9078\u512a\u8cea\u88dd\u5099\u3002\u6b65\u9a5f\u4e09\uff1a\u4e0d\u65b7\u6e2c\u8a66\u548c\u8abf\u6574\u3002\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u53ef\u4ee5\u5617\u8a66\u4e0d\u540c\u7684 Build \u65b9\u6848\uff08\u4f8b\u5982\u7d14\u8f38\u51fa\u3001\u751f\u5b58\u6d41\uff09\uff0c\u627e\u5230\u6700\u9069\u5408\u81ea\u5df1\u7684\u3002"}, {"question": "\u5728\u85cd\u8272\u904a\u6232\u4e2d\uff0c\u9ad8\u624b\u662f\u5982\u4f55\u91dd\u5c0d\u4e0d\u540c\u985e\u578b\u7684\u6575\u4eba\u5236\u5b9a\u4f5c\u6230\u8a08\u756b\u7684\uff1f\u85cd\u8272\u9ad8\u968e\u4f5c\u6230\u90e8\u7f72", "answer": "\u9ad8\u624b\u91dd\u5c0d\u4e0d\u540c\u6575\u4eba\u6703\u63a1\u53d6\u4e0d\u540c\u7684\u7b56\u7565\u3002\u5c0d\u65bc\u5f31\u70b9\u660e\u986f\u7684\u6575\u4eba\uff0c\u96c6\u4e2d\u706b\u529b\u5feb\u901f\u89e3\u6c7a\u3002\u4f8b\u5982\uff0c\u5c0d\u4ed8\u884c\u52d5\u7de9\u6162\u7684\u5de8\u578b\u602a\u7269\uff0c\u53ef\u4ee5\u5229\u7528\u9060\u7a0b\u6b66\u5668\u9032\u884c\u727d\u5236\u6230\u8853\u3002\u5c0d\u65bc\u9ad8\u6a5f\u52d5\u6027\u7684\u6575\u4eba\uff0c\u4f7f\u7528\u63a7\u5236\u6280\u80fd\u9650\u5236\u5176\u884c\u52d5\u3002\u6d41\u7a0b\u5716\u89e3\uff1a\u6575\u4eba\u985e\u578b\u2192\u5f31\u70b9\u5206\u6790\u2192\u6230\u8853\u9078\u64c7\u2192\u57f7\u884c\u3002\u5305\u542b\u81f3\u5c11\u4e00\u500b\u904a\u6232\u5167\u5177\u9ad4\u7bc4\u4f8b\uff1a\u6311\u6230 BOSS \u6642\uff0c\u89c0\u5bdf BOSS \u7684\u6280\u80fd\u91cb\u653e\u898f\u5f8b\uff0c\u9810\u5224\u4e26\u8eb2\u907f\uff0c\u6293\u4f4f BOSS \u6280\u80fd\u7684\u7a7a\u6a94\u9032\u884c\u8f38\u51fa\u3002"}, {"question": "\u85cd\u8272\u904a\u6232\u7684\u6700\u7d42\u6311\u6230\u6709\u54ea\u4e9b\uff1f\u8cc7\u6df1\u73a9\u5bb6\u5982\u4f55\u6e96\u5099\u548c\u6709\u6548\u61c9\u5c0d\u85cd\u8272\u904a\u6232\u7684\u6700\u7d42\u6311\u6230\uff1f", "answer": "\u85cd\u8272\u904a\u6232\u7684\u6700\u7d42\u6311\u6230\u901a\u5e38\u5305\u62ec\u9ad8\u96e3\u5ea6\u7684\u526f\u672c\u3001BOSS \u6230\u548c PvP \u7af6\u6280\u5834\u3002\u9996\u5148\uff0c\u63d0\u5347\u4f60\u7684\u88dd\u5099\u7b49\u7d1a\u548c\u6280\u80fd\u719f\u7df4\u5ea6\u3002\u5176\u6b21\uff0c\u4e86\u89e3\u526f\u672c\u548c BOSS \u7684\u6a5f\u5236\uff0c\u5236\u5b9a\u8a73\u7d30\u7684\u6230\u8853\u3002\u4f8b\u5982\uff0c\u5728\u5718\u968a\u526f\u672c\u4e2d\uff0c\u9700\u8981\u5408\u7406\u7684\u8077\u696d\u642d\u914d\u548c\u660e\u78ba\u7684\u5206\u5de5\u3002\u6b65\u9a5f\u4e00\uff1a\u63d0\u5347\u6230\u529b\u3002\u6b65\u9a5f\u4e8c\uff1a\u719f\u6089\u6a5f\u5236\u3002\u6b65\u9a5f\u4e09\uff1a\u5718\u968a\u5408\u4f5c\u3002\u6bd4\u55bb\u8aaa\u660e\uff1a\u6700\u7d42\u6311\u6230\u5c31\u50cf\u4e00\u5834\u99ac\u62c9\u677e\uff0c\u9700\u8981\u5145\u5206\u7684\u6e96\u5099\u548c\u6301\u4e45\u7684\u8010\u529b\u3002"}, {"question": "\u85cd\u8272\u904a\u6232\u7684\u4e16\u754c\u89c0\u662f\u5982\u4f55\u8a2d\u5b9a\u7684\uff1f\u7279\u5b9a\u85cd\u8272\u904a\u6232\u5167\u4e8b\u4ef6\u6216\u767c\u73fe\u7684\u80cc\u666f\u6545\u4e8b\u6db5\u7fa9\u70ba\u4f55\uff1f\u85cd\u8272\u80cc\u666f\u6545\u4e8b\u6df1\u5ea6\u89e3\u6790", "answer": "\u85cd\u8272\u904a\u6232\u7684\u4e16\u754c\u89c0\u662f\u4e00\u500b\u5145\u6eff\u795e\u79d8\u548c\u5947\u5e7b\u7684\u4e16\u754c\uff0c\u96b1\u85cf\u8457\u8a31\u591a\u672a\u89e3\u4e4b\u8b0e\u3002\u900f\u904e\u904a\u6232\u4e2d\u7684\u4e8b\u4ef6\u3001NPC \u5c0d\u8a71\u548c\u7269\u54c1\u63cf\u8ff0\uff0c\u53ef\u4ee5\u9010\u6b65\u4e86\u89e3\u9019\u500b\u4e16\u754c\u7684\u904e\u53bb\u548c\u672a\u4f86\u3002\u4f8b\u5982\uff0c\u67d0\u500b\u4efb\u52d9\u4e2d\u767c\u73fe\u7684\u53e4\u4ee3\u907a\u8ff9\u53ef\u80fd\u63ed\u793a\u4e86\u85cd\u8272\u904a\u6232\u4e16\u754c\u7684\u8d77\u6e90\u3002\u4ed4\u7d30\u89c0\u5bdf\u904a\u6232\u4e2d\u7684\u7d30\u7bc0\uff0c\u4f60\u6703\u767c\u73fe\u66f4\u591a\u96b1\u85cf\u7684\u6545\u4e8b\u7dda\u7d22\u3002\u5305\u542b\u81f3\u5c11\u4e00\u500b\u904a\u6232\u5167\u5177\u9ad4\u7bc4\u4f8b\uff1a\u85cd\u8272\u904a\u6232\u4e16\u754c\u4e2d\u5b58\u5728\u4e00\u500b\u53e4\u8001\u7684\u9810\u8a00\uff0c\u9810\u793a\u8457\u4e16\u754c\u7684\u672a\u4f86\u3002\u9019\u500b\u9810\u8a00\u8cab\u7a7f\u6574\u500b\u904a\u6232\u5287\u60c5\uff0c\u5f15\u5c0e\u73a9\u5bb6\u63a2\u7d22\u66f4\u6df1\u5c64\u6b21\u7684\u79d8\u5bc6\u3002"}, {"question": "\u85cd\u8272\u904a\u6232\u4e2d\u7684\u6578\u503c\u6a5f\u5236\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f\u70ba\u4ec0\u9ebc\u5728\u85cd\u8272\u904a\u6232\u4e2d\u67d0\u4e9b\u5c6c\u6027\u5c0d\u65bc\u7279\u5b9a\u89d2\u8272\u5efa\u7acb\u66f4\u52a0\u91cd\u8981\uff1f(\u85cd\u8272\u6578\u503c\u6a5f\u5236\u5206\u6790)", "answer": "\u85cd\u8272\u904a\u6232\u7684\u6578\u503c\u6a5f\u5236\u5305\u62ec\u653b\u64ca\u529b\u3001\u9632\u79a6\u529b\u3001\u751f\u547d\u503c\u7b49\u3002\u4e0d\u540c\u7684\u5c6c\u6027\u5c0d\u89d2\u8272\u7684\u6230\u9b25\u80fd\u529b\u6709\u8457\u4e0d\u540c\u7684\u5f71\u97ff\u3002\u4f8b\u5982\uff0c\u653b\u64ca\u529b\u6c7a\u5b9a\u4e86\u4f60\u7684\u50b7\u5bb3\u8f38\u51fa\uff0c\u9632\u79a6\u529b\u964d\u4f4e\u4f60\u53d7\u5230\u7684\u50b7\u5bb3\u3002\u7406\u89e3\u9019\u4e9b\u6578\u503c\u7684\u904b\u4f5c\u65b9\u5f0f\u53ef\u4ee5\u5e6b\u52a9\u4f60\u66f4\u597d\u5730\u512a\u5316\u89d2\u8272 Build\u3002\u653b\u64ca\u529b\u548c\u66b4\u64ca\u7387\u5c0d\u65bc\u8f38\u51fa\u578b\u89d2\u8272\u81f3\u95dc\u91cd\u8981\uff0c\u800c\u9632\u79a6\u529b\u548c\u751f\u547d\u503c\u5c0d\u65bc\u5766\u514b\u578b\u89d2\u8272\u800c\u8a00\u66f4\u70ba\u91cd\u8981\u3002\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u4e0d\u540c\u8077\u696d\u5c0d\u61c9\u7684\u6838\u5fc3\u5c6c\u6027\uff08\u4f8b\u5982\uff1a\u6230\u58eb\uff0d\u529b\u91cf\uff0c\u6cd5\u5e2b\uff0d\u667a\u529b\uff09\u3002"}, {"question": "\u85cd\u8272\u904a\u6232\u662f\u5426\u652f\u63f4\u8de8\u5e73\u53f0\u904a\u6232\uff1f\u5982\u679c\u53ef\u7528\uff0c\u5982\u4f55\u5728 PC \u548c\u624b\u6a5f\u7248\u672c\u4e4b\u9593\u8f49\u79fb\u6211\u7684\u904a\u6232\u9032\u5ea6\uff1f(\u85cd\u8272\u8de8\u5e73\u53f0\u554f\u984c)", "answer": "\u85cd\u8272\u904a\u6232\u662f\u5426\u652f\u63f4\u8de8\u5e73\u53f0\u904a\u6232\u53d6\u6c7a\u65bc\u958b\u767c\u5546\u7684\u7b56\u7565\u3002\u5982\u679c\u652f\u63f4\uff0c\u901a\u5e38\u9700\u8981\u5728\u4e0d\u540c\u5e73\u53f0\u767b\u5165\u540c\u4e00\u500b\u5e33\u865f\uff0c\u4e26\u7d81\u5b9a\u4f60\u7684\u904a\u6232\u6578\u64da\u3002\u4f8b\u5982\uff0c\u900f\u904e\u85cd\u8272\u904a\u6232\u5b98\u65b9\u5e33\u865f\u6216\u7b2c\u4e09\u65b9\u5e73\u53f0\uff08\u4f8b\u5982 Steam\u3001Google Play\uff09\u9032\u884c\u7d81\u5b9a\u3002\u5982\u679c\u4e0d\u652f\u63f4\uff0c\u5247\u7121\u6cd5\u9032\u884c\u6578\u64da\u9077\u79fb\u3002\u8acb\u53c3\u8003\u85cd\u8272\u904a\u6232\u5b98\u65b9\u7db2\u7ad9\u6216\u8ad6\u58c7\uff0c\u4e86\u89e3\u6700\u65b0\u7684\u8de8\u5e73\u53f0\u652f\u63f4\u8cc7\u8a0a\u3002\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u6839\u64da\u904a\u6232\u5b98\u65b9\u63d0\u4f9b\u7684\u65b9\u6848\u9032\u884c\u9077\u79fb\u3002"}, {"question": "\u85cd\u8272\u904a\u6232\u4e2d\u662f\u5426\u96b1\u85cf\u8457\u4e00\u4e9b\u7279\u6b8a\u7684\u5f69\u86cb\u6216\u79d8\u5bc6\u5340\u57df\uff1f\u54ea\u4e9b\u662f\u85cd\u8272\u904a\u6232\u4e2d\u6700\u96e3\u4ee5\u767c\u73fe\u7684\u96b1\u85cf\u5167\u5bb9\uff0c\u4ee5\u53ca\u73a9\u5bb6\u5982\u4f55\u767c\u73fe\u5b83\u5011\uff1f", "answer": "\u85cd\u8272\u904a\u6232\u4e2d\u96b1\u85cf\u8457\u8a31\u591a\u5f69\u86cb\u548c\u79d8\u5bc6\u5340\u57df\uff0c\u7b49\u5f85\u73a9\u5bb6\u53bb\u63a2\u7d22\u3002\u9019\u4e9b\u5f69\u86cb\u53ef\u80fd\u5305\u62ec\u96b1\u85cf\u7684 BOSS\u3001\u7279\u6b8a\u7684\u88dd\u5099\u548c\u6709\u8da3\u7684\u5287\u60c5\u3002\u4f8b\u5982\uff0c\u5728\u7279\u5b9a\u5730\u5716\u5340\u57df\uff0c\u900f\u904e\u5b8c\u6210\u4e00\u7cfb\u5217\u96b1\u85cf\u4efb\u52d9\uff0c\u53ef\u4ee5\u89e3\u9396\u4e00\u500b\u79d8\u5bc6 BOSS\u3002\u5305\u542b\u81f3\u5c11\u4e00\u500b\u904a\u6232\u5167\u5177\u9ad4\u7bc4\u4f8b\uff1a\u904a\u6232\u65e9\u671f\u5730\u5716\u7684\u7011\u5e03\u5f8c\u65b9\uff0c\u85cf\u533f\u8457\u4e00\u500b\u5c71\u6d1e\uff0c\u5176\u4e2d\u6709\u5f37\u529b\u6b66\u5668\u3002"}]
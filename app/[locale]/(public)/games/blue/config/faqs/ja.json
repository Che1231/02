[{"question": "\u521d\u5fc3\u8005\u5411\u3051\uff1aBlue\u3067\u6700\u521d\u306e\u6570\u3005\u306e\u30bf\u30b9\u30af\u3092\u8fc5\u901f\u306b\u30de\u30b9\u30bf\u30fc\u3057\u3001\u5b8c\u4e86\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1fBlue\u521d\u5fc3\u8005\u306b\u77e5\u3063\u3066\u304a\u304f\u3079\u304d\u30c6\u30af\u30cb\u30c3\u30af\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "Blue\u306e\u521d\u671f\u30bf\u30b9\u30af\u306f\u3001\u30b2\u30fc\u30e0\u64cd\u4f5c\u3068\u57fa\u672c\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7fd2\u5f97\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u307e\u305a\u3001\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u79fb\u52d5\u3001\u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3\u3001\u6226\u95d8\u3092\u5b66\u3073\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6700\u521d\u306e\u30bf\u30b9\u30af\u306f\u901a\u5e38\u3001\u30ea\u30bd\u30fc\u30b9\u306e\u53ce\u96c6\u3067\u3059\u3002\u753b\u9762\u4e0a\u306e\u6307\u793a\uff08\u4f8b\uff1a\u300cE\u30ad\u30fc\u3092\u62bc\u3057\u3066\u62fe\u3046\u300d\uff09\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6b21\u306b\u3001\u30b2\u30fc\u30e0\u5185\u306e\u30de\u30c3\u30d7\u3068\u30ca\u30d3\u30b2\u30fc\u30b7\u30e7\u30f3\u30b7\u30b9\u30c6\u30e0\u3092\u4f7f\u7528\u3057\u3066\u3001\u76ee\u6a19\u5730\u70b9\u3092\u7d20\u65e9\u304f\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u7b2c\u4e09\u306b\u3001\u305f\u3081\u3089\u308f\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002Blue\u306e\u521d\u671f\u6bb5\u968e\u3067\u306f\u3001\u30a8\u30e9\u30fc\u8a31\u5bb9\u7387\u304c\u9ad8\u3044\u305f\u3081\u3001\u3055\u307e\u3056\u307e\u306a\u30b9\u30ad\u30eb\u3068\u88c5\u5099\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u8a66\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u3089\u306e\u521d\u5fc3\u8005\u5411\u3051\u30c6\u30af\u30cb\u30c3\u30af\u304c\u3042\u308c\u3070\u3001Blue\u306e\u4e16\u754c\u306b\u30b9\u30e0\u30fc\u30ba\u306b\u53c2\u52a0\u3067\u304d\u307e\u3059\u3002"}, {"question": "Blue\u306b\u304a\u3051\u308b\u8cc7\u6e90\u7ba1\u7406\u306f\u306a\u305c\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u304b\uff1f\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30b2\u30fc\u30e0\u521d\u671f\u306b\u8cc7\u6e90\u3092\u52b9\u7387\u7684\u306b\u53ce\u96c6\u304a\u3088\u3073\u6d3b\u7528\u3059\u308b\u305f\u3081\u306e\u3069\u306e\u3088\u3046\u306a\u6226\u7565\u3092\u63a1\u7528\u3067\u304d\u307e\u3059\u304b\uff1f(Blue\u8cc7\u6e90\u7ba1\u7406\u91cd\u8981\u6027\u5206\u6790)", "answer": "Blue\u3067\u306f\u8cc7\u6e90\u306f\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u751f\u5b58\u3068\u767a\u5c55\u3092\u652f\u3048\u3066\u3044\u307e\u3059\u3002\u521d\u671f\u6bb5\u968e\u3067\u306f\u3001\u307e\u305a\u8cc7\u6e90\u63a1\u53d6\u30c4\u30fc\u30eb\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3053\u3068\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u52b9\u7387\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30c4\u30eb\u30cf\u30b7\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3068\u3001\u9271\u77f3\u3092\u3088\u308a\u65e9\u304f\u63a1\u6398\u3067\u304d\u307e\u3059\u3002\u6b21\u306b\u3001\u4f59\u5270\u8cc7\u6e90\u3092\u5e38\u306b\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u3059\u308b\u305f\u3081\u306e\u8cc7\u6e90\u4fdd\u7ba1\u5834\u6240\u3092\u69cb\u7bc9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u63a1\u6398\u30eb\u30fc\u30c8\u3092\u8a08\u753b\u3057\u3001\u30de\u30c3\u30d7\u4e0a\u306e\u8cc7\u6e90\u30dd\u30a4\u30f3\u30c8\u306b\u6ce8\u610f\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30cb\u30fc\u30ba\u306b\u5408\u308f\u305b\u3066\u63a1\u96c6\u6226\u7565\u3092\u8abf\u6574\u3057\u3001\u7121\u99c4\u3092\u907f\u3051\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u8cc7\u6e90\u3092\u9069\u5207\u306b\u914d\u5206\u3057\u3001\u30b3\u30a2\u5efa\u7bc9\u7269\u3068\u88c5\u5099\u3092\u512a\u5148\u7684\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u307e\u3059\u3002\u6bd4\u55a9\u8aac\u660e\uff1a\u8cc7\u6e90\u306f\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306b\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u7d76\u3048\u9593\u306a\u304f\u4f9b\u7d66\u3059\u308b\u3001\u3042\u306a\u305f\u306e\u4f53\u306e\u4e2d\u306e\u8840\u6db2\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002"}, {"question": "\u521d\u5fc3\u8005\u306b\u3068\u3063\u3066\u3001Blue\u306e\u57fa\u672c\u7684\u306a\u6226\u95d8\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u308c\u3089\u3092\u52b9\u679c\u7684\u306b\u7df4\u7fd2\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f\u30bc\u30ed\u304b\u3089\u306eBlue\u6226\u95d8\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb", "answer": "Blue\u306e\u6226\u95d8\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u653b\u6483\u3001\u9632\u5fa1\u3001\u56de\u907f\u3067\u3059\u3002\u307e\u305a\u3001\u6b66\u5668\u306e\u5c5e\u6027\u3068\u653b\u6483\u7bc4\u56f2\u3092\u628a\u63e1\u3057\u307e\u3059\u3002\u7df4\u7fd2\u65b9\u6cd5\u306f\u3001\u5b89\u5168\u306a\u30a8\u30ea\u30a2\uff08\u521d\u5fc3\u8005\u6751\u306a\u3069\uff09\u3067\u4f4e\u30ec\u30d9\u30eb\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\u3068\u6226\u95d8\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5263\u3092\u4f7f\u7528\u3059\u308b\u5834\u5408\u3001\u6b63\u78ba\u306a\u653b\u6483\u3068\u30ac\u30fc\u30c9\u3092\u7df4\u7fd2\u3067\u304d\u307e\u3059\u3002\u6b21\u306b\u3001\u74b0\u5883\u3092\u6d3b\u7528\u3057\u307e\u3057\u3087\u3046\u3002\u5730\u5f62\u306b\u3088\u3063\u3066\u306f\u3001\u96a0\u853d\u3084\u653b\u6483\u306e\u5229\u70b9\u306b\u306a\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u7b2c\u4e09\u306b\u3001\u6575\u306e\u653b\u6483\u30d1\u30bf\u30fc\u30f3\u306b\u6ce8\u610f\u3057\u3001\u4e88\u6e2c\u3057\u3066\u56de\u907f\u3057\u307e\u3057\u3087\u3046\u3002\u8cc7\u6599\uff1a\u7570\u306a\u308b\u6b66\u5668\u306e\u653b\u6483\u901f\u5ea6\u3068\u30c0\u30e1\u30fc\u30b8\u7bc4\u56f2\u306f\u305d\u308c\u305e\u308c\u7570\u306a\u308a\u307e\u3059\u3002\u30b2\u30fc\u30e0\u5185\u306e\u6b66\u5668\u5c5e\u6027\u8868\u3092\u53c2\u7167\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "Blue\u306e\u9ad8\u5ea6\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u3001Blue\u3067\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30d3\u30eb\u30c9\u3092\u6700\u5927\u5316\u3057\u3001\u88c5\u5099\u3092\u6700\u9069\u5316\u3059\u308b\u305f\u3081\u306e\u9ad8\u5ea6\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1fBlue\u30ad\u30e3\u30e9\u30af\u30bf\u30fcBuild\u30a2\u30a4\u30c7\u30a2", "answer": "\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u30d3\u30eb\u30c9\u3068\u88c5\u5099\u306e\u6700\u9069\u5316\u306f\u3001Blue\u306e\u9ad8\u5ea6\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u91cd\u8981\u3067\u3059\u3002\u307e\u305a\u3001\u3042\u306a\u305f\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u5f79\u5272\uff08\u653b\u6483\u3001\u9632\u5fa1\u3001\u652f\u63f4\u306a\u3069\uff09\u3092\u660e\u78ba\u306b\u3057\u307e\u3059\u3002\u6b21\u306b\u3001\u30b9\u30ad\u30eb\u30c4\u30ea\u30fc\u3092\u6df1\u304f\u7406\u89e3\u3057\u3001\u5f79\u5272\u306b\u5408\u308f\u305b\u305f\u9069\u5207\u306a\u30b9\u30ad\u30eb\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u3042\u306a\u305f\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u653b\u6483\u30bf\u30a4\u30d7\u306e\u5834\u5408\u3001\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u7387\u3068\u653b\u6483\u529b\u3092\u5897\u52a0\u3055\u305b\u308b\u30b9\u30ad\u30eb\u3092\u512a\u5148\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b9\u30ad\u30eb\u7d44\u307f\u5408\u308f\u305b\u3092\u8abf\u67fb\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u9ad8\u54c1\u8cea\u306e\u88c5\u5099\u3092\u9078\u629e\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7d99\u7d9a\u7684\u306b\u30c6\u30b9\u30c8\u304a\u3088\u3073\u8abf\u6574\u3059\u308b\u3002\u8907\u6570\u306e\u30d7\u30e9\u30f3\u3092\u6bd4\u8f03\u3059\u308b\uff1a\u7d14\u7c8b\u306a\u653b\u6483\u3001\u30b5\u30d0\u30a4\u30d0\u30eb\u306a\u3069\u3001\u3055\u307e\u3056\u307e\u306a\u30d3\u30eb\u30c9\u30d7\u30e9\u30f3\u3092\u8a66\u3057\u3066\u3001\u81ea\u5206\u306b\u6700\u9069\u306a\u30d7\u30e9\u30f3\u3092\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Blue\u3067\u3001\u4e0a\u7d1a\u8005\u306f\u3069\u306e\u3088\u3046\u306b\u7570\u306a\u308b\u30bf\u30a4\u30d7\u306e\u6575\u306b\u5bfe\u3057\u3066\u4f5c\u6226\u8a08\u753b\u3092\u7b56\u5b9a\u3059\u308b\u306e\u3067\u3057\u3087\u3046\u304b\uff1fBlue\u4e0a\u7d1a\u4f5c\u6226\u914d\u7f6e", "answer": "\u719f\u7df4\u3057\u305f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u7570\u306a\u308b\u6575\u306b\u5bfe\u3057\u3066\u7570\u306a\u308b\u6226\u8853\u3092\u63a1\u7528\u3057\u307e\u3059\u3002\u5f31\u70b9\u306e\u3042\u308b\u6575\u306b\u306f\u3001\u96c6\u4e2d\u653b\u6483\u3067\u8fc5\u901f\u306b\u51e6\u7406\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u52d5\u304d\u304c\u9045\u3044\u5de8\u5927\u306a\u30e2\u30f3\u30b9\u30bf\u30fc\u306e\u5834\u5408\u3001\u9060\u8ddd\u96e2\u6b66\u5668\u3092\u4f7f\u7528\u3057\u3066\u5f15\u304d\u4ed8\u3051\u308b\u6226\u8853\u3092\u4f7f\u7528\u3067\u304d\u307e\u3059\u3002\u9ad8\u6a5f\u52d5\u529b\u6575\u306e\u5834\u5408\u306f\u3001\u5236\u5fa1\u30b9\u30ad\u30eb\u3092\u4f7f\u7528\u3057\u3066\u884c\u52d5\u3092\u5236\u9650\u3057\u307e\u3059\u3002\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u6575\u306e\u7a2e\u985e\u2192\u5f31\u70b9\u5206\u6790\u2192\u6226\u8853\u9078\u629e\u2192\u5b9f\u884c\u3002\u5c11\u306a\u304f\u3068\u30821\u3064\u306e\u30b2\u30fc\u30e0\u5185\u5177\u4f53\u7684\u306a\u4f8b\uff1a\u30dc\u30b9\u6226\u3067\u306f\u3001\u30dc\u30b9\u306e\u30b9\u30ad\u30eb\u653e\u51fa\u30d1\u30bf\u30fc\u30f3\u3092\u89b3\u5bdf\u3057\u3001\u4e88\u6e2c\u3057\u3066\u56de\u907f\u3057\u3001\u30dc\u30b9\u306e\u30b9\u30ad\u30eb\u306e\u9699\u3092\u7a81\u3044\u3066\u653b\u6483\u3057\u307e\u3059\u3002"}, {"question": "Blue\u306e\u30a8\u30f3\u30c7\u30a3\u30f3\u30b0\u30fb\u30c1\u30e3\u30ec\u30f3\u30b8\u3068\u306f\u4f55\u3067\u3059\u304b\uff1f\u30d9\u30c6\u30e9\u30f3\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001Blue\u306e\u7d42\u672b\u30c1\u30e3\u30ec\u30f3\u30b8\u306b\u3069\u306e\u3088\u3046\u306b\u6e96\u5099\u3057\u3001\u52b9\u679c\u7684\u306b\u5bfe\u51e6\u3059\u308b\u306e\u3067\u3059\u304b\uff1f", "answer": "Blue\u306e\u30a8\u30f3\u30c7\u30a3\u30f3\u30b0\u30c1\u30e3\u30ec\u30f3\u30b8\u306f\u3001\u901a\u5e38\u3001\u9ad8\u96e3\u5ea6\u306e\u30c0\u30f3\u30b8\u30e7\u30f3\u3001\u30dc\u30b9\u6226\u3001PvP\u7af6\u6280\u5834\u306a\u3069\u3067\u3059\u3002\u307e\u305a\u3001\u88c5\u5099\u30ec\u30d9\u30eb\u3068\u30b9\u30ad\u30eb\u719f\u7df4\u5ea6\u3092\u4e0a\u3052\u307e\u3059\u3002\u6b21\u306b\u3001\u30c0\u30f3\u30b8\u30e7\u30f3\u3084\u30dc\u30b9\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3057\u3001\u8a73\u7d30\u306a\u6226\u8853\u3092\u7acb\u3066\u307e\u3057\u3087\u3046\u3002\u305f\u3068\u3048\u3070\u3001\u30c1\u30fc\u30e0\u30c0\u30f3\u30b8\u30e7\u30f3\u3067\u306f\u3001\u9069\u5207\u306a\u8077\u696d\u69cb\u6210\u3068\u660e\u78ba\u306a\u5206\u62c5\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6226\u529b\u3092\u5411\u4e0a\u3055\u305b\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u3002\u300c\u30a8\u30f3\u30c7\u30a3\u30f3\u30b0\u30c1\u30e3\u30ec\u30f3\u30b8\u300d\u306f\u3001\u5341\u5206\u306a\u6e96\u5099\u3068\u6301\u7d9a\u7684\u306a\u5fcd\u8010\u529b\u304c\u5fc5\u8981\u306a\u30de\u30e9\u30bd\u30f3\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002"}, {"question": "Blue\u306e\u4e16\u754c\u89b3\u306f\u3069\u306e\u3088\u3046\u306b\u8a2d\u5b9a\u3055\u308c\u3066\u3044\u307e\u3059\u304b\uff1f\u7279\u5b9a\u306eBlue\u30b2\u30fc\u30e0\u5185\u30a4\u30d9\u30f3\u30c8\u307e\u305f\u306f\u767a\u898b\u306e\u30ed\u30a2\u30a4\u30f3\u30d7\u30ea\u30b1\u30fc\u30b7\u30e7\u30f3\u306f\u4f55\u3067\u3059\u304b\uff1fBlue\u306e\u80cc\u666f\u30b9\u30c8\u30fc\u30ea\u30fc\u306e\u6df1\u3044\u5206\u6790", "answer": "Blue\u306e\u4e16\u754c\u89b3\u306f\u795e\u79d8\u7684\u3067\u30d5\u30a1\u30f3\u30bf\u30b8\u30fc\u306b\u6e80\u3061\u305f\u4e16\u754c\u3067\u3042\u308a\u3001\u591a\u304f\u306e\u672a\u89e3\u660e\u306a\u8b0e\u3092\u62b1\u3048\u3066\u3044\u307e\u3059\u3002\u30b2\u30fc\u30e0\u5185\u306e\u30a4\u30d9\u30f3\u30c8\u3001NPC\u306e\u4f1a\u8a71\u3001\u30a2\u30a4\u30c6\u30e0\u306e\u8aac\u660e\u3092\u901a\u3058\u3066\u3001\u3053\u306e\u4e16\u754c\u306e\u904e\u53bb\u3068\u672a\u6765\u3092\u6bb5\u968e\u7684\u306b\u7406\u89e3\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u7279\u5b9a\u306e\u4efb\u52d9\u3067\u767a\u898b\u3055\u308c\u305f\u53e4\u4ee3\u907a\u8de1\u306f\u3001Blue\u4e16\u754c\u306e\u8d77\u6e90\u3092\u793a\u3059\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u30b2\u30fc\u30e0\u5185\u306e\u7d30\u90e8\u3092\u89b3\u5bdf\u3059\u308c\u3070\u3001\u96a0\u3055\u308c\u305f\u7269\u8a9e\u306e\u30d2\u30f3\u30c8\u3092\u3055\u3089\u306b\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u5177\u4f53\u4f8b\uff1aBlue\u306e\u4e16\u754c\u306b\u306f\u3001\u4e16\u754c\u306e\u672a\u6765\u3092\u4e88\u8a00\u3059\u308b\u53e4\u4ee3\u306e\u4e88\u8a00\u304c\u5b58\u5728\u3057\u307e\u3059\u3002\u3053\u306e\u4e88\u8a00\u306f\u30b2\u30fc\u30e0\u5168\u4f53\u3067\u91cd\u8981\u306a\u5834\u9762\u3092\u5360\u3081\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u3088\u308a\u6df1\u3044\u79d8\u5bc6\u3092\u63a2\u6c42\u3059\u308b\u3088\u3046\u5c0e\u304d\u307e\u3059\u3002"}, {"question": "Blue\u30b2\u30fc\u30e0\u306e\u5024\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f\u306a\u305c\u7279\u5b9a\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30d3\u30eb\u30c9\u306b\u7279\u5b9a\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u304c\u3088\u308a\u91cd\u8981\u3067\u3059\u304b\uff1f(Blue\u6570\u5024\u30e1\u30ab\u30cb\u30ba\u30e0\u5206\u6790)", "answer": "Blue\u306e\u5024\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u306f\u3001\u653b\u6483\u529b\u3001\u9632\u5fa1\u529b\u3001\u751f\u547d\u529b\u306a\u3069\u304c\u3042\u308a\u307e\u3059\u3002\u7570\u306a\u308b\u5c5e\u6027\u306f\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u6226\u95d8\u80fd\u529b\u306b\u7570\u306a\u308b\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u653b\u6483\u529b\u306f\u3042\u306a\u305f\u306e\u30c0\u30e1\u30fc\u30b8\u91cf\u3092\u6c7a\u5b9a\u3057\u3001\u9632\u5fa1\u529b\u306f\u53d7\u3051\u308b\u30c0\u30e1\u30fc\u30b8\u3092\u8efd\u6e1b\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u5024\u306e\u4ed5\u7d44\u307f\u3092\u7406\u89e3\u3059\u308b\u3068\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u30d3\u30eb\u30c9\u3092\u3088\u308a\u52b9\u679c\u7684\u306b\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u3002\u653b\u6483\u529b\u3068\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u7387\u306f\u653b\u6483\u578b\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306b\u3068\u3063\u3066\u91cd\u8981\u3067\u3042\u308a\u3001\u9632\u5fa1\u529b\u3068\u751f\u547d\u529b\u306f\u30bf\u30f3\u30af\u578b\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306b\u3068\u3063\u3066\u91cd\u8981\u3067\u3059\u3002\u8cc7\u6599\uff1a\u7570\u306a\u308b\u8077\u696d\u306b\u5bfe\u5fdc\u3059\u308b\u4e3b\u8981\u306a\u5c5e\u6027\uff08\u4f8b\uff1a\u6226\u58eb-\u529b\u3001\u9b54\u6cd5\u4f7f\u3044-\u77e5\u529b\uff09"}, {"question": "Blue\u306f\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30b2\u30fc\u30e0\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u307e\u3059\u304b\uff1fPC\u7248\u3068\u30e2\u30d0\u30a4\u30eb\u7248\u306eBlue\u9593\u3067\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f(Blue\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u554f\u984c)", "answer": "Blue\u304c\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u30b5\u30dd\u30fc\u30c8\u3059\u308b\u304b\u3069\u3046\u304b\u306f\u3001\u958b\u767a\u8005\u306e\u6226\u7565\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u3002\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u308b\u5834\u5408\u3001\u901a\u5e38\u3001\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3001\u30b2\u30fc\u30e0\u30c7\u30fc\u30bf\u3092\u30d0\u30a4\u30f3\u30c9\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001Blue\u516c\u5f0f\u30a2\u30ab\u30a6\u30f3\u30c8\u307e\u305f\u306fSteam\u3001Google Play\u306a\u3069\u306e\u30b5\u30fc\u30c9\u30d1\u30fc\u30c6\u30a3\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u4f7f\u7528\u3057\u3066\u30d0\u30a4\u30f3\u30c9\u3057\u307e\u3059\u3002\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u306a\u3044\u5834\u5408\u306f\u3001\u30c7\u30fc\u30bf\u306e\u79fb\u52d5\u306f\u4e0d\u53ef\u3067\u3059\u3002Blue\u306e\u516c\u5f0f\u30a6\u30a7\u30d6\u30b5\u30a4\u30c8\u307e\u305f\u306f\u30d5\u30a9\u30fc\u30e9\u30e0\u3067\u6700\u65b0\u306e\u60c5\u5831\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u8907\u6570\u306e\u30bd\u30ea\u30e5\u30fc\u30b7\u30e7\u30f3\u3092\u6bd4\u8f03\u3059\u308b\uff1a\u63d0\u4f9b\u3055\u308c\u3066\u3044\u308b\u30b2\u30fc\u30e0\u516c\u5f0f\u306e\u8a73\u7d30\u306b\u5f93\u3063\u3066\u3001\u79fb\u884c\u3092\u5b9f\u884c\u3057\u307e\u3059\u3002"}, {"question": "Blue\u306b\u306f\u7279\u5225\u306a\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u307e\u305f\u306f\u79d8\u5bc6\u306e\u30a8\u30ea\u30a2\u306f\u3042\u308a\u307e\u3059\u304b\uff1fBlue\u3067\u6700\u3082\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3068\u305d\u306e\u767a\u898b\u65b9\u6cd5\u306f\uff1f", "answer": "Blue\u306b\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u63a2\u6c42\u3067\u304d\u308b\u591a\u304f\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3084\u79d8\u5bc6\u306e\u30a8\u30ea\u30a2\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u30dc\u30b9\u3001\u7279\u5225\u306a\u88c5\u5099\u3001\u305d\u3057\u3066\u8208\u5473\u6df1\u3044\u30b9\u30c8\u30fc\u30ea\u30fc\u304c\u542b\u307e\u308c\u3066\u3044\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u7279\u5b9a\u306e\u5834\u6240\u3067\u306f\u3001\u4e00\u9023\u306e\u96a0\u3057\u4efb\u52d9\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3067\u3001\u79d8\u5bc6\u306e\u30dc\u30b9\u3092\u89e3\u653e\u3067\u304d\u307e\u3059\u3002\u5177\u4f53\u4f8b\uff1a\u30b2\u30fc\u30e0\u521d\u671f\u306e\u30de\u30c3\u30d7\u306e\u6edd\u306e\u5f8c\u308d\u306b\u3001\u5f37\u529b\u306a\u6b66\u5668\u304c\u3042\u308b\u6d1e\u7a9f\u304c\u96a0\u3055\u308c\u3066\u3044\u307e\u3059\u3002"}]
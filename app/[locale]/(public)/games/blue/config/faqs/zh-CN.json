[{"question": "\u65b0\u624b\u6c42\u52a9\uff1a\u5728\u84dd\u661f\u6e38\u620f\u4e2d\uff0c\u5982\u4f55\u5feb\u901f\u4e0a\u624b\u5e76\u5b8c\u6210\u6700\u521d\u7684\u51e0\u4e2a\u4efb\u52a1\uff1f\u6709\u54ea\u4e9b\u84dd\u661f\u6e38\u620f\u65b0\u624b\u5fc5\u77e5\u7684\u6280\u5de7\uff1f", "answer": "\u84dd\u661f\u6e38\u620f\u7684\u521d\u671f\u4efb\u52a1\u65e8\u5728\u5e2e\u52a9\u4f60\u719f\u6089\u6e38\u620f\u64cd\u4f5c\u548c\u57fa\u672c\u673a\u5236\u3002\u9996\u5148\uff0c\u8bf7\u4ed4\u7ec6\u9075\u5faa\u6e38\u620f\u6559\u7a0b\uff0c\u5b83\u4f1a\u6307\u5bfc\u4f60\u8fdb\u884c\u79fb\u52a8\u3001\u4e92\u52a8\u548c\u6218\u6597\u3002\u4f8b\u5982\uff0c\u7b2c\u4e00\u4e2a\u4efb\u52a1\u901a\u5e38\u662f\u6536\u96c6\u8d44\u6e90\uff0c\u8bf7\u7559\u610f\u5c4f\u5e55\u4e0a\u7684\u63d0\u793a\uff0c\u4f8b\u5982\u201c\u6309 E \u952e\u62fe\u53d6\u201d\u3002\u5176\u6b21\uff0c\u5229\u7528\u6e38\u620f\u4e2d\u7684\u5730\u56fe\u548c\u5bfc\u822a\u7cfb\u7edf\uff0c\u53ef\u4ee5\u5feb\u901f\u627e\u5230\u76ee\u6807\u5730\u70b9\u3002\u7b2c\u4e09\uff0c\u5927\u80c6\u5c1d\u8bd5\u4e0d\u540c\u64cd\u4f5c\uff0c\u84dd\u661f\u6e38\u620f\u524d\u671f\u5bb9\u9519\u7387\u8f83\u9ad8\uff0c\u591a\u5c1d\u8bd5\u4e0d\u540c\u7684\u6280\u80fd\u548c\u88c5\u5907\u7ec4\u5408\u3002\u8fd9\u4e9b\u65b0\u624b\u6280\u5de7\u5c06\u5e2e\u52a9\u4f60\u66f4\u5feb\u5730\u878d\u5165\u84dd\u661f\u4e16\u754c\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u84dd\u661f\u6e38\u620f\u4e2d\u7684\u8d44\u6e90\u7ba1\u7406\u5982\u6b64\u91cd\u8981\uff1f\u65b0\u624b\u73a9\u5bb6\u5728\u6e38\u620f\u521d\u671f\u5982\u4f55\u6709\u6548\u5730\u6536\u96c6\u548c\u5229\u7528\u8d44\u6e90\uff1f(\u84dd\u661f\u8d44\u6e90\u7ba1\u7406\u91cd\u8981\u6027\u5206\u6790)", "answer": "\u8d44\u6e90\u5728\u84dd\u661f\u6e38\u620f\u4e2d\u81f3\u5173\u91cd\u8981\uff0c\u5b83\u4eec\u652f\u6491\u7740\u4f60\u7684\u751f\u5b58\u548c\u53d1\u5c55\u3002\u521d\u671f\uff0c\u4f18\u5148\u5347\u7ea7\u4f60\u7684\u8d44\u6e90\u91c7\u96c6\u5de5\u5177\uff0c\u4ee5\u63d0\u9ad8\u6548\u7387\u3002\u4f8b\u5982\uff0c\u5347\u7ea7\u4f60\u7684\u9550\u5b50\u53ef\u4ee5\u66f4\u5feb\u5730\u6316\u6398\u77ff\u77f3\u3002\u5176\u6b21\uff0c\u5efa\u7acb\u4e00\u4e2a\u8d44\u6e90\u50a8\u5b58\u70b9\uff0c\u968f\u65f6\u5907\u4efd\u591a\u4f59\u7684\u8d44\u6e90\u3002\u6b65\u9aa4\u4e00\uff1a\u89c4\u5212\u91c7\u96c6\u8def\u7ebf\uff0c\u5173\u6ce8\u5730\u56fe\u4e0a\u7684\u8d44\u6e90\u70b9\u3002\u6b65\u9aa4\u4e8c\uff1a\u6839\u636e\u9700\u6c42\u8c03\u6574\u91c7\u96c6\u7b56\u7565\uff0c\u907f\u514d\u6d6a\u8d39\u3002\u6b65\u9aa4\u4e09\uff1a\u5408\u7406\u5206\u914d\u8d44\u6e90\uff0c\u4f18\u5148\u5347\u7ea7\u6838\u5fc3\u5efa\u7b51\u548c\u88c5\u5907\u3002\u6bd4\u55bb\u8bf4\u660e\uff1a\u8d44\u6e90\u5c31\u50cf\u4f60\u7684\u8840\u6db2\uff0c\u6e90\u6e90\u4e0d\u65ad\u5730\u4e3a\u4f60\u7684\u89d2\u8272\u63d0\u4f9b\u80fd\u91cf\u3002"}, {"question": "\u84dd\u661f\u6e38\u620f\u4e2d\u7684\u57fa\u672c\u6218\u6597\u673a\u5236\u662f\u4ec0\u4e48\uff0c\u65b0\u624b\u5e94\u8be5\u5982\u4f55\u6709\u6548\u5730\u7ec3\u4e60\uff1f\u96f6\u57fa\u7840\u84dd\u661f\u6218\u6597\u6559\u5b66", "answer": "\u84dd\u661f\u6e38\u620f\u7684\u6218\u6597\u673a\u5236\u5305\u62ec\u653b\u51fb\u3001\u9632\u5fa1\u548c\u95ea\u907f\u3002\u9996\u5148\uff0c\u719f\u6089\u4f60\u7684\u6b66\u5668\u5c5e\u6027\u548c\u653b\u51fb\u8303\u56f4\u3002\u7ec3\u4e60\u65b9\u6cd5\u662f\u5728\u5b89\u5168\u533a\u57df\uff08\u4f8b\u5982\u65b0\u624b\u6751\uff09\u4e0e\u4f4e\u7ea7\u602a\u7269\u6218\u6597\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u5251\u65f6\uff0c\u53ef\u4ee5\u7ec3\u4e60\u7cbe\u51c6\u7684\u653b\u51fb\u548c\u683c\u6321\u3002\u5176\u6b21\uff0c\u5b66\u4f1a\u5229\u7528\u73af\u5883\uff0c\u67d0\u4e9b\u5730\u5f62\u53ef\u4ee5\u63d0\u4f9b\u63a9\u62a4\u6216\u589e\u52a0\u4f60\u7684\u653b\u51fb\u4f18\u52bf\u3002\u7b2c\u4e09\uff0c\u5bc6\u5207\u5173\u6ce8\u654c\u4eba\u7684\u653b\u51fb\u6a21\u5f0f\uff0c\u9884\u5224\u5e76\u8fdb\u884c\u95ea\u907f\u3002\u5c5e\u6027\u5bf9\u7167\u8868\uff1a\u4e0d\u540c\u6b66\u5668\u7684\u653b\u51fb\u901f\u5ea6\u548c\u4f24\u5bb3\u8303\u56f4\u5404\u6709\u4e0d\u540c\uff0c\u8bf7\u67e5\u9605\u6e38\u620f\u5185\u6b66\u5668\u5c5e\u6027\u8868\u3002"}, {"question": "\u5bf9\u4e8e\u84dd\u661f\u6e38\u620f\u7684\u8fdb\u9636\u73a9\u5bb6\uff0c\u6709\u54ea\u4e9b\u9ad8\u7ea7\u7b56\u7565\u53ef\u4ee5\u6700\u5927\u5316\u89d2\u8272\u6784\u5efa\u5e76\u4f18\u5316\u88c5\u5907\uff1f\u84dd\u661f\u89d2\u8272\u6784\u5efa\u601d\u8def", "answer": "\u89d2\u8272\u7684\u6784\u5efa\u548c\u88c5\u5907\u4f18\u5316\u662f\u84dd\u661f\u6e38\u620f\u8fdb\u9636\u7684\u5173\u952e\u3002\u9996\u5148\uff0c\u660e\u786e\u4f60\u7684\u89d2\u8272\u5b9a\u4f4d\uff0c\u662f\u504f\u5411\u8f93\u51fa\u3001\u9632\u5fa1\u8fd8\u662f\u8f85\u52a9\u3002\u5176\u6b21\uff0c\u6df1\u5165\u4e86\u89e3\u6280\u80fd\u6811\uff0c\u6839\u636e\u4f60\u7684\u5b9a\u4f4d\u9009\u62e9\u5408\u9002\u7684\u6280\u80fd\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u7684\u89d2\u8272\u662f\u8f93\u51fa\u578b\uff0c\u53ef\u4ee5\u4f18\u5148\u5b66\u4e60\u589e\u52a0\u66b4\u51fb\u7387\u548c\u653b\u51fb\u529b\u7684\u6280\u80fd\u3002\u6b65\u9aa4\u4e00\uff1a\u7814\u7a76\u6280\u80fd\u642d\u914d\u3002\u6b65\u9aa4\u4e8c\uff1a\u7b5b\u9009\u4f18\u8d28\u88c5\u5907\u3002\u6b65\u9aa4\u4e09\uff1a\u4e0d\u65ad\u6d4b\u8bd5\u548c\u8c03\u6574\u3002\u591a\u65b9\u6848\u6bd4\u8f83\uff1a\u53ef\u4ee5\u5c1d\u8bd5\u4e0d\u540c\u7684\u6784\u5efa\u65b9\u6848\uff08\u4f8b\u5982\u7eaf\u8f93\u51fa\u3001\u751f\u5b58\u6d41\uff09\uff0c\u627e\u5230\u6700\u9002\u5408\u81ea\u5df1\u7684\u65b9\u6848\u3002"}, {"question": "\u5728\u84dd\u661f\u4e2d\uff0c\u9ad8\u624b\u662f\u5982\u4f55\u9488\u5bf9\u4e0d\u540c\u7c7b\u578b\u7684\u654c\u4eba\u5236\u5b9a\u4f5c\u6218\u8ba1\u5212\u7684\uff1f\u84dd\u661f\u9ad8\u9636\u4f5c\u6218\u90e8\u7f72", "answer": "\u9ad8\u624b\u9488\u5bf9\u4e0d\u540c\u654c\u4eba\u4f1a\u91c7\u53d6\u4e0d\u540c\u7684\u6218\u672f\u3002\u5bf9\u4e8e\u5f31\u70b9\u660e\u663e\u7684\u654c\u4eba\uff0c\u96c6\u4e2d\u706b\u529b\u5feb\u901f\u89e3\u51b3\u3002\u4f8b\u5982\uff0c\u5bf9\u4ed8\u884c\u52a8\u7f13\u6162\u7684\u5de8\u578b\u602a\u7269\uff0c\u53ef\u4ee5\u5229\u7528\u8fdc\u7a0b\u6b66\u5668\u8fdb\u884c\u98ce\u7b5d\u6218\u672f\u3002\u5bf9\u4e8e\u9ad8\u673a\u52a8\u6027\u654c\u4eba\uff0c\u4f7f\u7528\u63a7\u5236\u6280\u80fd\u9650\u5236\u5176\u884c\u52a8\u3002\u6d41\u7a0b\u56fe\u89e3\uff1a\u3010\u654c\u4eba\u7c7b\u578b\u3011\u2192\u3010\u5f31\u70b9\u5206\u6790\u3011\u2192\u3010\u6218\u672f\u9009\u62e9\u3011\u2192\u3010\u6267\u884c\u3011\u3002\u5305\u542b\u81f3\u5c11\u4e00\u4e2a\u6e38\u620f\u5185\u5177\u4f53\u793a\u4f8b\uff1a\u6311\u6218 BOSS \u65f6\uff0c\u89c2\u5bdf BOSS \u7684\u6280\u80fd\u91ca\u653e\u89c4\u5f8b\uff0c\u9884\u5224\u5e76\u8eb2\u907f\uff0c\u6293\u4f4f BOSS \u6280\u80fd\u7684\u7a7a\u6863\u8fdb\u884c\u8f93\u51fa\u3002"}, {"question": "\u84dd\u661f\u6e38\u620f\u7684\u6700\u7ec8\u6311\u6218\u6709\u54ea\u4e9b\uff1f\u8d44\u6df1\u73a9\u5bb6\u5982\u4f55\u51c6\u5907\u548c\u6709\u6548\u5e94\u5bf9\u84dd\u661f\u6e38\u620f\u7684\u6700\u7ec8\u6311\u6218\uff1f", "answer": "\u84dd\u661f\u6e38\u620f\u7684\u6700\u7ec8\u6311\u6218\u901a\u5e38\u5305\u62ec\u9ad8\u96be\u5ea6\u7684\u526f\u672c\u3001BOSS \u6218\u548c PvP \u7ade\u6280\u573a\u3002\u9996\u5148\uff0c\u63d0\u5347\u4f60\u7684\u88c5\u5907\u7b49\u7ea7\u548c\u6280\u80fd\u719f\u7ec3\u5ea6\u3002\u5176\u6b21\uff0c\u4e86\u89e3\u526f\u672c\u548c BOSS \u7684\u673a\u5236\uff0c\u5236\u5b9a\u8be6\u7ec6\u7684\u6218\u672f\u3002\u4f8b\u5982\uff0c\u5728\u56e2\u961f\u526f\u672c\u4e2d\uff0c\u9700\u8981\u5408\u7406\u7684\u804c\u4e1a\u642d\u914d\u548c\u660e\u786e\u7684\u5206\u5de5\u3002\u6b65\u9aa4\u4e00\uff1a\u63d0\u5347\u6218\u529b\u3002\u6b65\u9aa4\u4e8c\uff1a\u719f\u6089\u673a\u5236\u3002\u6b65\u9aa4\u4e09\uff1a\u56e2\u961f\u534f\u4f5c\u3002\u6bd4\u55bb\u8bf4\u660e\uff1a\u6700\u7ec8\u6311\u6218\u5c31\u50cf\u4e00\u573a\u9a6c\u62c9\u677e\uff0c\u9700\u8981\u5145\u5206\u7684\u51c6\u5907\u548c\u6301\u4e45\u7684\u8010\u529b\u3002"}, {"question": "\u84dd\u661f\u6e38\u620f\u7684\u4e16\u754c\u89c2\u662f\u5982\u4f55\u8bbe\u5b9a\u7684\uff1f\u67d0\u4e9b\u84dd\u661f\u6e38\u620f\u4e2d\u7684\u4e8b\u4ef6\u6216\u53d1\u73b0\u8574\u542b\u7740\u54ea\u4e9b\u80cc\u666f\u6545\u4e8b\uff1f\u84dd\u661f\u80cc\u666f\u6545\u4e8b\u6df1\u5ea6\u89e3\u6790", "answer": "\u84dd\u661f\u6e38\u620f\u7684\u4e16\u754c\u89c2\u662f\u4e00\u4e2a\u5145\u6ee1\u795e\u79d8\u548c\u5947\u5e7b\u7684\u4e16\u754c\uff0c\u9690\u85cf\u7740\u8bb8\u591a\u672a\u89e3\u4e4b\u8c1c\u3002\u901a\u8fc7\u6e38\u620f\u4e2d\u7684\u4e8b\u4ef6\u3001NPC \u5bf9\u8bdd\u548c\u7269\u54c1\u63cf\u8ff0\uff0c\u53ef\u4ee5\u9010\u6b65\u4e86\u89e3\u8fd9\u4e2a\u4e16\u754c\u7684\u8fc7\u53bb\u548c\u672a\u6765\u3002\u4f8b\u5982\uff0c\u67d0\u4e2a\u4efb\u52a1\u4e2d\u53d1\u73b0\u7684\u53e4\u4ee3\u9057\u8ff9\u53ef\u80fd\u63ed\u793a\u4e86\u84dd\u661f\u4e16\u754c\u7684\u795e\u79d8\u8d77\u6e90\u3002\u4ed4\u7ec6\u89c2\u5bdf\u6e38\u620f\u4e2d\u7684\u7ec6\u8282\uff0c\u4f60\u4f1a\u53d1\u73b0\u66f4\u591a\u9690\u85cf\u7684\u6545\u4e8b\u7ebf\u7d22\u3002\u5305\u542b\u81f3\u5c11\u4e00\u4e2a\u6e38\u620f\u5185\u5177\u4f53\u793a\u4f8b\uff1a\u84dd\u661f\u4e16\u754c\u4e2d\u5b58\u5728\u4e00\u4e2a\u53e4\u8001\u7684\u9884\u8a00\uff0c\u9884\u793a\u7740\u4e16\u754c\u7684\u672a\u6765\u3002\u8fd9\u4e2a\u9884\u8a00\u8d2f\u7a7f\u6574\u4e2a\u6e38\u620f\u5267\u60c5\uff0c\u5f15\u5bfc\u73a9\u5bb6\u63a2\u7d22\u66f4\u6df1\u5c42\u6b21\u7684\u79d8\u5bc6\u3002"}, {"question": "\u84dd\u661f\u6e38\u620f\u4e2d\u7684\u6570\u503c\u673a\u5236\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f\u4e3a\u4ec0\u4e48\u67d0\u4e9b\u5c5e\u6027\u5728\u84dd\u661f\u6e38\u620f\u4e2d\u5bf9\u7279\u5b9a\u89d2\u8272\u6784\u5efa\u66f4\u91cd\u8981\uff1f(\u84dd\u661f\u6570\u503c\u673a\u5236\u5206\u6790)", "answer": "\u84dd\u661f\u6e38\u620f\u7684\u6570\u503c\u673a\u5236\u5305\u62ec\u653b\u51fb\u529b\u3001\u9632\u5fa1\u529b\u3001\u751f\u547d\u503c\u7b49\u3002\u4e0d\u540c\u7684\u5c5e\u6027\u5bf9\u89d2\u8272\u7684\u6218\u6597\u80fd\u529b\u6709\u7740\u4e0d\u540c\u7684\u5f71\u54cd\u3002\u4f8b\u5982\uff0c\u653b\u51fb\u529b\u51b3\u5b9a\u4e86\u4f60\u7684\u4f24\u5bb3\u8f93\u51fa\uff0c\u9632\u5fa1\u529b\u964d\u4f4e\u4f60\u53d7\u5230\u7684\u4f24\u5bb3\u3002\u7406\u89e3\u8fd9\u4e9b\u6570\u503c\u7684\u8fd0\u4f5c\u65b9\u5f0f\u53ef\u4ee5\u5e2e\u52a9\u4f60\u66f4\u597d\u5730\u4f18\u5316\u89d2\u8272\u6784\u5efa\u3002\u653b\u51fb\u529b\u548c\u66b4\u51fb\u7387\u5bf9\u4e8e\u8f93\u51fa\u578b\u89d2\u8272\u81f3\u5173\u91cd\u8981\uff0c\u800c\u9632\u5fa1\u529b\u548c\u751f\u547d\u503c\u5bf9\u4e8e\u5766\u514b\u578b\u89d2\u8272\u66f4\u4e3a\u91cd\u8981\u3002\u5c5e\u6027\u5bf9\u7167\u8868\uff1a\u4e0d\u540c\u804c\u4e1a\u5bf9\u5e94\u7684\u6838\u5fc3\u5c5e\u6027\uff08\u4f8b\u5982\uff1a\u6218\u58eb\u2014\u529b\u91cf\uff0c\u6cd5\u5e08\u2014\u667a\u529b\uff09\u3002"}, {"question": "\u84dd\u661f\u6e38\u620f\u662f\u5426\u652f\u6301\u8de8\u5e73\u53f0\u6e38\u620f\uff1f\u5982\u679c\u652f\u6301\uff0c\u5982\u4f55\u5728 PC \u548c\u79fb\u52a8\u7248\u672c\u4e4b\u95f4\u8f6c\u79fb\u6e38\u620f\u8fdb\u5ea6\uff1f(\u84dd\u661f\u8de8\u5e73\u53f0\u95ee\u9898)", "answer": "\u84dd\u661f\u6e38\u620f\u662f\u5426\u652f\u6301\u8de8\u5e73\u53f0\u6e38\u620f\u53d6\u51b3\u4e8e\u5f00\u53d1\u5546\u7684\u7b56\u7565\u3002\u5982\u679c\u652f\u6301\uff0c\u901a\u5e38\u9700\u8981\u5728\u4e0d\u540c\u5e73\u53f0\u767b\u5f55\u540c\u4e00\u4e2a\u8d26\u53f7\uff0c\u5e76\u7ed1\u5b9a\u4f60\u7684\u6e38\u620f\u6570\u636e\u3002\u4f8b\u5982\uff0c\u901a\u8fc7\u84dd\u661f\u5b98\u65b9\u8d26\u53f7\u6216\u7b2c\u4e09\u65b9\u5e73\u53f0\uff08\u5982 Steam\u3001Google Play\uff09\u8fdb\u884c\u7ed1\u5b9a\u3002\u5982\u679c\u4e0d\u652f\u6301\uff0c\u5219\u65e0\u6cd5\u8fdb\u884c\u6570\u636e\u8fc1\u79fb\u3002\u8bf7\u67e5\u9605\u84dd\u661f\u5b98\u65b9\u7f51\u7ad9\u6216\u8bba\u575b\uff0c\u4e86\u89e3\u6700\u65b0\u7684\u8de8\u5e73\u53f0\u652f\u6301\u4fe1\u606f\u3002\u591a\u65b9\u6848\u6bd4\u8f83\uff1a\u6839\u636e\u6e38\u620f\u5b98\u7f51\u63d0\u4f9b\u7684\u65b9\u6848\u8fdb\u884c\u8fc1\u79fb\u3002"}, {"question": "\u84dd\u661f\u6e38\u620f\u4e2d\u662f\u5426\u5b58\u5728\u4e00\u4e9b\u7279\u6b8a\u7684\u5f69\u86cb\u6216\u79d8\u5bc6\u533a\u57df\uff1f\u54ea\u4e9b\u662f\u84dd\u661f\u6e38\u620f\u4e2d\u6700\u96be\u4ee5\u53d1\u73b0\u7684\u9690\u85cf\u5185\u5bb9\uff0c\u4ee5\u53ca\u73a9\u5bb6\u5982\u4f55\u53d1\u73b0\u5b83\u4eec\uff1f", "answer": "\u84dd\u661f\u6e38\u620f\u4e2d\u9690\u85cf\u7740\u8bb8\u591a\u5f69\u86cb\u548c\u79d8\u5bc6\u533a\u57df\uff0c\u7b49\u5f85\u73a9\u5bb6\u53bb\u63a2\u7d22\u3002\u8fd9\u4e9b\u5f69\u86cb\u53ef\u80fd\u5305\u62ec\u9690\u85cf\u7684 BOSS\u3001\u7279\u6b8a\u7684\u88c5\u5907\u548c\u6709\u8da3\u7684\u5267\u60c5\u3002\u4f8b\u5982\uff0c\u5728\u67d0\u4e2a\u7279\u5b9a\u5730\u56fe\u533a\u57df\uff0c\u901a\u8fc7\u5b8c\u6210\u4e00\u7cfb\u5217\u9690\u85cf\u4efb\u52a1\uff0c\u53ef\u4ee5\u89e3\u9501\u4e00\u4e2a\u79d8\u5bc6 BOSS\u3002\u5305\u542b\u81f3\u5c11\u4e00\u4e2a\u6e38\u620f\u5185\u5177\u4f53\u793a\u4f8b\uff1a\u6e38\u620f\u65e9\u671f\u5730\u56fe\u7684\u7011\u5e03\u540e\u65b9\uff0c\u85cf\u533f\u7740\u4e00\u4e2a\u5c71\u6d1e\uff0c\u5176\u4e2d\u6709\u5f3a\u529b\u6b66\u5668\u3002"}]
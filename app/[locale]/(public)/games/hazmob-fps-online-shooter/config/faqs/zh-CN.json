[{"question": "\u65b0\u624b\u5982\u4f55\u5feb\u901f\u4e0a\u624bHazmob FPS\uff1a\u5728\u7ebf\u5c04\u51fb\u6e38\u620f\uff1f", "answer": "\u5feb\u901f\u4e0a\u624bHazmob FPS\uff1a\u5728\u7ebf\u5c04\u51fb\u6e38\u620f\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u5b8c\u6210\u6559\u7a0b\u4ee5\u4e86\u89e3\u57fa\u672c\u63a7\u5236\u548c\u6e38\u620f\u673a\u5236\u3002\u6b65\u9aa42 - \u9009\u62e9\u9002\u5408\u65b0\u624b\u7684\u6b66\u5668\uff0c\u4f8b\u5982\u7a81\u51fb\u6b65\u67aa\uff0c\u5b83\u62e5\u6709\u5e73\u8861\u7684\u5c5e\u6027\u3002\u6b65\u9aa43 - \u52a0\u5165\u56e2\u961f\u6b7b\u4ea1\u7ade\u8d5b\u6a21\u5f0f\uff0c\u5728\u4f4e\u538b\u73af\u5883\u4e2d\u7ec3\u4e60\u4f60\u7684\u6280\u80fd\u3002\u4f8b\u5982\uff0c\u5728\u201c\u57ce\u5e02\u6218\u4e89\u201d\u5730\u56fe\u4e2d\u4f7f\u7528\u7a81\u51fb\u6b65\u67aa\u53ef\u4ee5\u5e2e\u52a9\u4f60\u9002\u5e94\u7784\u51c6\u548c\u79fb\u52a8\u3002\u6b64\u5916\uff0c\u8c03\u6574\u4f60\u7684\u7075\u654f\u5ea6\u8bbe\u7f6e\u4ee5\u5339\u914d\u4f60\u7684\u6e38\u620f\u98ce\u683c\uff0c\u4ee5\u4fbf\u66f4\u597d\u5730\u63a7\u5236\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u6559\u7a0b\u60f3\u8c61\u6210\u4f60\u5728\u9a91\u5168\u529f\u80fd\u6e38\u620f\u81ea\u884c\u8f66\u4e4b\u524d\u4f7f\u7528\u7684\u8bad\u7ec3\u8f6e\u3002]"}, {"question": "\u5728Hazmob FPS\uff1a\u5728\u7ebf\u5c04\u51fb\u6e38\u620f\u4e2d\uff0c\u6709\u54ea\u4e9b\u7cbe\u786e\u7784\u51c6\u7684\u6700\u4f73\u7b56\u7565\uff1f", "answer": "\u63d0\u9ad8\u4f60\u5728Hazmob FPS\uff1a\u5728\u7ebf\u5c04\u51fb\u6e38\u620f\u4e2d\u7684\u7784\u51c6\u80fd\u529b\uff0c\u9700\u8981\u4e00\u4e9b\u5173\u952e\u7b56\u7565\uff1a\u6b65\u9aa41 - \u5728\u5c04\u51fb\u573a\u7ec3\u4e60\u4ee5\u4e86\u89e3\u6b66\u5668\u540e\u5750\u529b\u6a21\u5f0f\u3002\u6b65\u9aa42 - \u4f7f\u7528\u201cADS\u201d\uff08\u7784\u51c6\uff09\u529f\u80fd\u8fdb\u884c\u7cbe\u786e\u5c04\u51fb\uff0c\u5c24\u5176\u662f\u5728\u4f7f\u7528\u72d9\u51fb\u6b65\u67aa\u65f6\u3002\u6b65\u9aa43 - \u8c03\u6574\u4f60\u7684\u51c6\u661f\u8bbe\u7f6e\uff0c\u4f7f\u5176\u989c\u8272\u548c\u5c3a\u5bf8\u9002\u5408\u4f60\u7684\u89c6\u91ce\u3002\u4f8b\u5982\uff0c\u5728\u201c\u6c99\u6f20\u524d\u54e8\u7ad9\u201d\u5730\u56fe\u4e0a\u4f7f\u7528\u5c0f\u7684\u7ea2\u8272\u51c6\u661f\u53ef\u4ee5\u5e2e\u52a9\u4f60\u66f4\u597d\u5730\u4e13\u6ce8\u4e8e\u8fdc\u8ddd\u79bb\u76ee\u6807\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6bd4\u8f83\u9ed8\u8ba4\u548c\u81ea\u5b9a\u4e49\u51c6\u661f\u8bbe\u7f6e\u4ee5\u63d0\u9ad8\u51c6\u786e\u6027\u3002]"}, {"question": "\u5728Hazmob FPS\uff1a\u5728\u7ebf\u5c04\u51fb\u6e38\u620f\u4e2d\uff0c\u54ea\u4e9b\u6b66\u5668\u6700\u9002\u5408\u4e0d\u540c\u7684\u6e38\u620f\u6a21\u5f0f\uff1f", "answer": "Hazmob FPS\uff1a\u5728\u7ebf\u5c04\u51fb\u6e38\u620f\u4e2d\u7684\u4e0d\u540c\u6e38\u620f\u6a21\u5f0f\u9700\u8981\u9009\u62e9\u7279\u5b9a\u7684\u6b66\u5668\uff1a\u5bf9\u4e8e\u56e2\u961f\u6b7b\u4ea1\u7ade\u8d5b\uff0c\u7a81\u51fb\u6b65\u67aa\u529f\u80fd\u5f3a\u5927\u4e14\u6709\u6548\u3002\u5728\u593a\u65d7\u6a21\u5f0f\u4e2d\uff0c\u51b2\u950b\u67aa\u5982\u201c\u6bd2\u86c7\u201d\u63d0\u4f9b\u901f\u5ea6\u548c\u7075\u6d3b\u6027\u3002\u5bf9\u4e8e\u4ec5\u9650\u72d9\u51fb\u624b\u7684\u6a21\u5f0f\uff0c\u957f\u5f13\u6b65\u67aa\u975e\u5e38\u9002\u5408\u8fdc\u8ddd\u79bb\u4ea4\u6218\u3002\u4f8b\u5982\uff0c\u5728\u201c\u68ee\u6797\u4f0f\u51fb\u201d\u5730\u56fe\u4e2d\u4f7f\u7528\u201c\u6bd2\u86c7\u201d\u53ef\u4ee5\u5feb\u901f\u593a\u53d6\u65d7\u5e1c\uff0c\u56e0\u4e3a\u5b83\u5177\u6709\u5f88\u5f3a\u7684\u673a\u52a8\u6027\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6bd4\u8f83\u6bcf\u79cd\u6a21\u5f0f\u7684\u6b66\u5668\u5c5e\u6027\u4ee5\u505a\u51fa\u660e\u667a\u7684\u9009\u62e9\u3002]"}, {"question": "\u5728Hazmob FPS\uff1a\u5728\u7ebf\u5c04\u51fb\u6e38\u620f\u4e2d\uff0c\u4e3a\u4ec0\u4e48\u5730\u56fe\u610f\u8bc6\u81f3\u5173\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u6539\u8fdb\u5b83\uff1f", "answer": "\u5728Hazmob FPS\uff1a\u5728\u7ebf\u5c04\u51fb\u6e38\u620f\u4e2d\uff0c\u5730\u56fe\u610f\u8bc6\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u80fd\u5e2e\u52a9\u4f60\u9884\u6d4b\u654c\u4eba\u7684\u884c\u52a8\u5e76\u63a7\u5236\u5173\u952e\u533a\u57df\u3002\u8981\u6539\u8fdb\u5730\u56fe\u610f\u8bc6\uff1a\u6b65\u9aa41 - \u901a\u8fc7\u5728\u81ea\u5b9a\u4e49\u6e38\u620f\u4e2d\u63a2\u7d22\u6240\u6709\u5730\u56fe\u6765\u719f\u6089\u5b83\u4eec\u3002\u6b65\u9aa42 - \u4f7f\u7528\u8ff7\u4f60\u5730\u56fe\u8ddf\u8e2a\u654c\u4eba\u7684\u4f4d\u7f6e\u5e76\u89c4\u5212\u4f60\u7684\u8def\u7ebf\u3002\u6b65\u9aa43 - \u4e0e\u4f60\u7684\u56e2\u961f\u6c9f\u901a\uff0c\u5206\u4eab\u5173\u4e8e\u654c\u4eba\u4f4d\u7f6e\u7684\u4fe1\u606f\u3002\u4f8b\u5982\uff0c\u5728\u201c\u57ce\u5e02\u5e9f\u589f\u201d\u5730\u56fe\u4e2d\uff0c\u4e86\u89e3\u5236\u9ad8\u70b9\u4f4d\u7f6e\u53ef\u4ee5\u4e3a\u4f60\u63d0\u4f9b\u6218\u7565\u4f18\u52bf\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u53ef\u89c6\u5316\u5e38\u89c1\u7684\u654c\u4eba\u8def\u7ebf\u548c\u74f6\u9888\u3002]"}, {"question": "\u5982\u4f55\u5728Hazmob FPS\uff1a\u5728\u7ebf\u5c04\u51fb\u6e38\u620f\u4e2d\u4f18\u5316\u6211\u7684\u88c5\u5907\u4ee5\u8fdb\u884c\u7ade\u6280\u6e38\u620f\uff1f", "answer": "\u5728Hazmob FPS\uff1a\u5728\u7ebf\u5c04\u51fb\u6e38\u620f\u4e2d\u4f18\u5316\u4f60\u7684\u88c5\u5907\u4ee5\u8fdb\u884c\u7ade\u6280\u6e38\u620f\uff0c\u9700\u8981\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u9009\u62e9\u4e0e\u4f60\u7684\u6e38\u620f\u98ce\u683c\u76f8\u914d\u7684\u6b66\u5668\uff0c\u4f8b\u5982\u201c\u5e7d\u7075\u201d\u51b2\u950b\u67aa\u9002\u5408\u4fb5\u7565\u578b\u73a9\u5bb6\u3002\u6b65\u9aa42 - \u5b89\u88c5\u9644\u4ef6\uff0c\u4f8b\u5982\u6269\u5c55\u5f39\u5323\u548c\u7784\u51c6\u955c\uff0c\u4ee5\u589e\u5f3a\u6b66\u5668\u6027\u80fd\u3002\u6b65\u9aa43 - \u9009\u62e9\u63d0\u4f9b\u6218\u672f\u4f18\u52bf\u7684\u6280\u80fd\uff0c\u4f8b\u5982\u63d0\u9ad8\u51b2\u523a\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5de5\u4e1a\u533a\u201d\u5730\u56fe\u4e2d\u4f7f\u7528\u5e26\u7ea2\u70b9\u7784\u51c6\u955c\u7684\u201c\u5e7d\u7075\u201d\u51b2\u950b\u67aa\u53ef\u4ee5\u4e3b\u5bfc\u8fd1\u8ddd\u79bb\u6218\u6597\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6bd4\u8f83\u4e0d\u540c\u7ade\u6280\u573a\u666f\u7684\u88c5\u5907\u914d\u7f6e\u3002]"}, {"question": "Hazmob FPS\uff1a\u5728\u7ebf\u5c04\u51fb\u6e38\u620f\u4e2d\uff0c\u51fb\u4e2d\u6ce8\u518c\u7cfb\u7edf\u4e4b\u95f4\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "Hazmob FPS\uff1a\u5728\u7ebf\u5c04\u51fb\u6e38\u620f\u4f7f\u7528\u5ba2\u6237\u7aef\u51fb\u4e2d\u6ce8\u518c\u7cfb\u7edf\uff0c\u8fd9\u610f\u5473\u7740\u51fb\u4e2d\u4f1a\u6839\u636e\u73a9\u5bb6\u7684\u89c6\u89d2\u800c\u4e0d\u662f\u670d\u52a1\u5668\u7684\u89c6\u89d2\u8fdb\u884c\u6ce8\u518c\u3002\u8fd9\u53ef\u80fd\u5bfc\u81f4\u9ad8\u5ef6\u8fdf\u60c5\u51b5\u4e0b\u51fa\u73b0\u5dee\u5f02\u3002\u4f8b\u5982\uff0c\u4f60\u53ef\u80fd\u4f1a\u5728\u5c4f\u5e55\u4e0a\u770b\u5230\u51fb\u4e2d\uff0c\u4f46\u7531\u4e8e\u5ef6\u8fdf\uff0c\u670d\u52a1\u5668\u53ef\u80fd\u65e0\u6cd5\u6ce8\u518c\u5b83\u3002\u4e3a\u4e86\u51cf\u8f7b\u8fd9\u79cd\u60c5\u51b5\uff0c\u8bf7\u786e\u4fdd\u4f60\u62e5\u6709\u7a33\u5b9a\u7684\u4e92\u8054\u7f51\u8fde\u63a5\uff0c\u5e76\u4f7f\u7528\u6e38\u620f\u4e2d\u7684ping\u6307\u793a\u5668\u6765\u76d1\u63a7\u5ef6\u8fdf\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u51fb\u4e2d\u6ce8\u518c\u60f3\u8c61\u6210\u4e00\u6b21\u7535\u8bdd\u901a\u8bdd\u2014\u2014\u5982\u679c\u6709\u5e72\u6270\uff0c\u6d88\u606f\u53ef\u80fd\u65e0\u6cd5\u6e05\u6670\u5730\u4f20\u9012\u3002]"}, {"question": "Hazmob FPS\uff1a\u5728\u7ebf\u5c04\u51fb\u6e38\u620f\u7684\u6392\u540d\u7cfb\u7edf\u5982\u4f55\u8fd0\u4f5c\uff0c\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u5b83\uff1f", "answer": "Hazmob FPS\uff1a\u5728\u7ebf\u5c04\u51fb\u6e38\u620f\u7684\u6392\u540d\u7cfb\u7edf\u57fa\u4e8e\u591a\u79cd\u56e0\u7d20\uff1a\u4f60\u7684\u80dc\u8d1f\u6bd4\u3001\u4e2a\u4eba\u8868\u73b0\uff08\u51fb\u6740\u3001\u52a9\u653b\u3001\u76ee\u6807\uff09\u548c\u6bd4\u8d5b\u96be\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u51fb\u8d25\u66f4\u9ad8\u6392\u540d\u7684\u5bf9\u624b\u65f6\u83b7\u80dc\u5c06\u4f1a\u663e\u8457\u63d0\u5347\u4f60\u7684\u7b49\u7ea7\u3002\u76f8\u53cd\uff0c\u8f93\u7ed9\u4f4e\u7b49\u7ea7\u7684\u73a9\u5bb6\u53ef\u80fd\u4f1a\u5bfc\u81f4\u540d\u6b21\u4e0b\u964d\u3002\u8be5\u7cfb\u7edf\u4f7f\u7528\u5339\u914d\u8bc4\u7ea7 (MMR) \u6765\u786e\u4fdd\u6bd4\u8d5b\u7684\u5e73\u8861\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6bd4\u8f83\u4e0d\u540c\u6bd4\u8d5b\u573a\u666f\u4e0b\u7684\u6392\u540d\u6da8\u8dcc\u3002]"}, {"question": "\u6211\u53ef\u4ee5\u5728Hazmob FPS\uff1a\u5728\u7ebf\u5c04\u51fb\u6e38\u620f\u4e2d\u5c06\u6211\u7684\u7535\u8111\u8fdb\u5ea6\u8f6c\u79fb\u5230\u63a7\u5236\u53f0\u5417\uff1f", "answer": "\u662f\u7684\uff0cHazmob FPS\uff1a\u5728\u7ebf\u5c04\u51fb\u6e38\u620f\u652f\u6301\u8de8\u5e73\u53f0\u8fdb\u5ea6\u8f6c\u79fb\u3002\u4e3a\u6b64\uff0c\u8bf7\u5c06\u4f60\u7684\u6e38\u620f\u8d26\u6237\u94fe\u63a5\u5230\u901a\u7528\u5e73\u53f0\u8d26\u6237\uff08\u4f8b\u5982Steam\u6216Xbox Live\uff09\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u7535\u8111\u4e0a\u73a9\u6e38\u620f\uff0c\u60f3\u5207\u6362\u5230Xbox\uff0c\u53ea\u9700\u4f7f\u7528\u76f8\u540c\u7684\u8d26\u6237\u767b\u5f55\uff0c\u4f60\u7684\u8fdb\u5ea6\uff08\u5305\u62ec\u89e3\u9501\u548c\u7edf\u8ba1\u6570\u636e\uff09\u5373\u53ef\u4f7f\u7528\u3002\u8bf7\u6ce8\u610f\uff0c\u67d0\u4e9b\u5e73\u53f0\u7279\u5b9a\u6210\u5c31\u53ef\u80fd\u65e0\u6cd5\u8f6c\u79fb\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6bd4\u8f83\u4e0d\u540c\u5e73\u53f0\u7684\u8fdb\u5ea6\u8f6c\u79fb\u9009\u9879\u3002]"}, {"question": "Hazmob FPS\uff1a\u5728\u7ebf\u5c04\u51fb\u6e38\u620f\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u7684\u5f69\u86cb\uff0c\u5982\u4f55\u53d1\u73b0\u5b83\u4eec\uff1f", "answer": "Hazmob FPS\uff1a\u5728\u7ebf\u5c04\u51fb\u6e38\u620f\u5145\u6ee1\u4e86\u9690\u85cf\u7684\u5f69\u86cb\uff0c\u5956\u52b1\u63a2\u7d22\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5e9f\u5f03\u5b9e\u9a8c\u5ba4\u201d\u5730\u56fe\u4e2d\uff0c\u51fb\u4e2d\u7279\u5b9a\u987a\u5e8f\u7684\u76ee\u6807\u53ef\u4ee5\u89e3\u9501\u4e00\u4e2a\u5e26\u6709\u7a00\u6709\u6218\u5229\u54c1\u7684\u79d8\u5bc6\u623f\u95f4\u3002\u4e3a\u4e86\u53d1\u73b0\u8fd9\u4e9b\u5f69\u86cb\uff0c\u8bf7\u6ce8\u610f\u73af\u5883\u63d0\u793a\uff0c\u4f8b\u5982\u4e0d\u5bfb\u5e38\u7684\u6807\u8bb0\u6216\u58f0\u97f3\u3002\u63a2\u7d22\u504f\u79bb\u5e38\u89c4\u533a\u57df\u901a\u5e38\u4f1a\u5bfc\u81f4\u53d1\u73b0\u8fd9\u4e9b\u9690\u85cf\u7684\u5b9d\u85cf\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u5f69\u86cb\u60f3\u8c61\u6210\u7b49\u5f85\u88ab\u53d1\u73b0\u7684\u9690\u85cf\u5b9d\u7bb1\u3002]"}, {"question": "\u5982\u4f55\u5728Hazmob FPS\uff1a\u5728\u7ebf\u5c04\u51fb\u6e38\u620f\u4e2d\u6709\u6548\u4f7f\u7528\u624b\u69b4\u5f39\u4ee5\u83b7\u5f97\u6218\u672f\u4f18\u52bf\uff1f", "answer": "\u5728Hazmob FPS\uff1a\u5728\u7ebf\u5c04\u51fb\u6e38\u620f\u4e2d\u6709\u6548\u4f7f\u7528\u624b\u69b4\u5f39\uff0c\u9700\u8981\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u5b66\u4e60\u4e0d\u540c\u7c7b\u578b\u624b\u69b4\u5f39\u7684\u8f68\u8ff9\u548c\u65f6\u673a\u3002\u6b65\u9aa42 - \u5229\u7528\u5b83\u4eec\u5c06\u654c\u4eba\u4ece\u63a9\u4f53\u4e2d\u903c\u51fa\u6765\u6216\u5c01\u9501\u5173\u952e\u70b9\u3002\u6b65\u9aa43 - \u4e0e\u4f60\u7684\u56e2\u961f\u534f\u8c03\u4ee5\u6700\u5927\u5316\u5176\u5f71\u54cd\u3002\u4f8b\u5982\uff0c\u5728\u201c\u4eba\u8d28\u8425\u6551\u201d\u6a21\u5f0f\u4e2d\uff0c\u5728\u8fdb\u5165\u623f\u95f4\u4e4b\u524d\u6295\u63b7\u4e00\u4e2a\u95ea\u5149\u5f39\u53ef\u4ee5\u4f7f\u654c\u4eba\u5931\u660e\uff0c\u7ed9\u4f60\u5728\u6218\u6597\u4e2d\u5360\u636e\u4f18\u52bf\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u53ef\u89c6\u5316\u624b\u69b4\u5f39\u7684\u8f68\u8ff9\u548c\u6700\u4f73\u4f7f\u7528\u573a\u666f\u3002]"}]
[{"question": "\u5982\u4f55\u5feb\u901f\u4e0a\u624bHazmob FPS\uff1a\u7dda\u4e0a\u5c04\u64ca\u904a\u6232\u4f5c\u70ba\u65b0\u624b\uff1f", "answer": "\u8981\u5feb\u901f\u4e0a\u624bHazmob FPS\uff1a\u7dda\u4e0a\u5c04\u64ca\u904a\u6232\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u5b8c\u6210\u6559\u5b78\u4ee5\u4e86\u89e3\u57fa\u672c\u63a7\u5236\u548c\u904a\u6232\u6a5f\u5236\u3002\u6b65\u9a5f2 - \u9078\u64c7\u9069\u5408\u65b0\u624b\u7684\u6b66\u5668\uff0c\u4f8b\u5982\u7a81\u64ca\u6b65\u69cd\uff0c\u5b83\u63d0\u4f9b\u5e73\u8861\u7684\u5c6c\u6027\u3002\u6b65\u9a5f3 - \u52a0\u5165\u5718\u968a\u6b7b\u4ea1\u7af6\u8cfd\u6a21\u5f0f\uff0c\u5728\u4f4e\u58d3\u74b0\u5883\u4e2d\u7df4\u7fd2\u4f60\u7684\u6280\u5de7\u3002\u4f8b\u5982\uff0c\u5728\u300e\u57ce\u5e02\u6230\u722d\u300f\u5730\u5716\u4e2d\u4f7f\u7528\u7a81\u64ca\u6b65\u69cd\uff0c\u53ef\u4ee5\u8b93\u4f60\u7fd2\u6163\u7784\u6e96\u548c\u79fb\u52d5\u3002\u6b64\u5916\uff0c\u8abf\u6574\u4f60\u7684\u9748\u654f\u5ea6\u8a2d\u5b9a\u4ee5\u5339\u914d\u4f60\u7684\u904a\u6232\u98a8\u683c\uff0c\u4ee5\u7372\u5f97\u66f4\u597d\u7684\u63a7\u5236\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u6559\u5b78\u60f3\u6210\u4f60\u5728\u9a0e\u4e58\u5168\u529f\u80fd\u904a\u6232\u81ea\u884c\u8eca\u4e4b\u524d\u4f7f\u7528\u7684\u8a13\u7df4\u8f2a\u80ce\u3002]"}, {"question": "\u5728Hazmob FPS\uff1a\u7dda\u4e0a\u5c04\u64ca\u904a\u6232\u4e2d\uff0c\u7cbe\u78ba\u7784\u6e96\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u63d0\u5347\u4f60\u5728Hazmob FPS\uff1a\u7dda\u4e0a\u5c04\u64ca\u904a\u6232\u4e2d\u7684\u7784\u6e96\u6280\u5de7\uff0c\u9700\u8981\u4e00\u4e9b\u95dc\u9375\u7b56\u7565\uff1a\u6b65\u9a5f1 - \u5728\u5c04\u64ca\u5834\u7df4\u7fd2\u4ee5\u4e86\u89e3\u6b66\u5668\u5f8c\u5750\u529b\u6a21\u5f0f\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u300eADS\u300f\uff08\u7784\u6e96\u93e1\uff09\u529f\u80fd\u9032\u884c\u7cbe\u78ba\u5c04\u64ca\uff0c\u5c24\u5176\u662f\u5728\u72d9\u64ca\u6b65\u69cd\u7684\u60c5\u6cc1\u4e0b\u3002\u6b65\u9a5f3 - \u8abf\u6574\u4f60\u7684\u6e96\u661f\u8a2d\u5b9a\uff0c\u4f7f\u5176\u984f\u8272\u548c\u5927\u5c0f\u9069\u5408\u4f60\u7684\u8996\u529b\u3002\u4f8b\u5982\uff0c\u5728\u300e\u6c99\u6f20\u524d\u54e8\u300f\u5730\u5716\u4e0a\u4f7f\u7528\u4e00\u500b\u5c0f\u7684\u7d05\u8272\u6e96\u661f\uff0c\u53ef\u4ee5\u5e6b\u52a9\u4f60\u66f4\u597d\u5730\u96c6\u4e2d\u6ce8\u610f\u529b\u65bc\u9060\u8ddd\u96e2\u76ee\u6a19\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6bd4\u8f03\u9810\u8a2d\u8207\u81ea\u8a02\u6e96\u661f\u8a2d\u5b9a\uff0c\u4ee5\u63d0\u9ad8\u6e96\u78ba\u6027\u3002]"}, {"question": "\u5728Hazmob FPS\uff1a\u7dda\u4e0a\u5c04\u64ca\u904a\u6232\u7684\u4e0d\u540c\u904a\u6232\u6a21\u5f0f\u4e2d\uff0c\u54ea\u4e9b\u6b66\u5668\u6700\u6709\u6548\uff1f", "answer": "Hazmob FPS\uff1a\u7dda\u4e0a\u5c04\u64ca\u904a\u6232\u7684\u4e0d\u540c\u904a\u6232\u6a21\u5f0f\u9700\u8981\u7279\u5b9a\u7684\u6b66\u5668\u9078\u64c7\uff1a\u5c0d\u65bc\u5718\u968a\u6b7b\u4ea1\u7af6\u8cfd\uff0c\u7a81\u64ca\u6b65\u69cd\u529f\u80fd\u591a\u6a23\u4e14\u6709\u6548\u3002\u5728\u596a\u65d7\u6a21\u5f0f\u4e2d\uff0c\u885d\u92d2\u69cd\uff08\u5982\u300e\u6bd2\u86c7\u300f\uff09\u63d0\u4f9b\u901f\u5ea6\u548c\u9748\u6d3b\u6027\u3002\u5c0d\u65bc\u50c5\u9650\u72d9\u64ca\u7684\u6a21\u5f0f\uff0c\u300e\u9577\u5f13\u300f\u975e\u5e38\u9069\u5408\u9060\u7a0b\u4ea4\u6230\u3002\u4f8b\u5982\uff0c\u5728\u300e\u68ee\u6797\u57cb\u4f0f\u300f\u5730\u5716\u4e2d\u4f7f\u7528\u300e\u6bd2\u86c7\u300f\u53ef\u4ee5\u56e0\u70ba\u5b83\u7684\u6a5f\u52d5\u6027\u800c\u5feb\u901f\u596a\u53d6\u65d7\u5e5f\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u6bd4\u8f03\u6bcf\u500b\u6a21\u5f0f\u7684\u6b66\u5668\u5c6c\u6027\uff0c\u4ee5\u505a\u51fa\u660e\u667a\u7684\u9078\u64c7\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u5730\u5716\u610f\u8b58\u5728Hazmob FPS\uff1a\u7dda\u4e0a\u5c04\u64ca\u904a\u6232\u4e2d\u81f3\u95dc\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u6539\u5584\u5b83\uff1f", "answer": "\u5728Hazmob FPS\uff1a\u7dda\u4e0a\u5c04\u64ca\u904a\u6232\u4e2d\uff0c\u5730\u5716\u610f\u8b58\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6709\u52a9\u65bc\u4f60\u9810\u6e2c\u6575\u4eba\u7684\u884c\u52d5\u4e26\u63a7\u5236\u95dc\u9375\u5340\u57df\u3002\u8981\u6539\u5584\uff1a\u6b65\u9a5f1 - \u901a\u904e\u5728\u81ea\u5b9a\u7fa9\u904a\u6232\u4e2d\u63a2\u7d22\u6240\u6709\u5730\u5716\u4f86\u719f\u6089\u5b83\u5011\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u8ff7\u4f60\u5730\u5716\u4f86\u8ffd\u8e64\u6575\u4eba\u7684\u4f4d\u7f6e\u4e26\u898f\u5283\u4f60\u7684\u8def\u7dda\u3002\u6b65\u9a5f3 - \u8207\u4f60\u7684\u5718\u968a\u6e9d\u901a\uff0c\u5206\u4eab\u6709\u95dc\u6575\u4eba\u4f4d\u7f6e\u7684\u4fe1\u606f\u3002\u4f8b\u5982\uff0c\u5728\u300e\u57ce\u5e02\u5ee2\u589f\u300f\u5730\u5716\u4e0a\uff0c\u77e5\u9053\u9ad8\u5730\u4f4d\u7f6e\u53ef\u4ee5\u70ba\u4f60\u5e36\u4f86\u6230\u7565\u512a\u52e2\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u53ef\u8996\u5316\u5e38\u898b\u7684\u6575\u4eba\u8def\u7dda\u548c\u9698\u53e3\u3002]"}, {"question": "\u5982\u4f55\u5728Hazmob FPS\uff1a\u7dda\u4e0a\u5c04\u64ca\u904a\u6232\u4e2d\u512a\u5316\u6211\u7684\u88dd\u5099\u4ee5\u9032\u884c\u7af6\u722d\u6027\u904a\u6232\uff1f", "answer": "\u5728Hazmob FPS\uff1a\u7dda\u4e0a\u5c04\u64ca\u904a\u6232\u4e2d\u512a\u5316\u4f60\u7684\u88dd\u5099\u4ee5\u9032\u884c\u7af6\u722d\u6027\u904a\u6232\uff0c\u9700\u8981\uff1a\u6b65\u9a5f1 - \u9078\u64c7\u8207\u4f60\u7684\u904a\u6232\u98a8\u683c\u76f8\u8f14\u76f8\u6210\u7684\u6b66\u5668\uff0c\u4f8b\u5982\u300e\u5e7d\u9748\u300f\u885d\u92d2\u69cd\u9069\u5408\u7a4d\u6975\u9032\u53d6\u7684\u73a9\u5bb6\u3002\u6b65\u9a5f2 - \u88dd\u5099\u9644\u4ef6\uff0c\u4f8b\u5982\u5ef6\u9577\u5f48\u593e\u548c\u7784\u6e96\u93e1\uff0c\u4ee5\u589e\u5f37\u6b66\u5668\u6027\u80fd\u3002\u6b65\u9a5f3 - \u9078\u64c7\u63d0\u4f9b\u6230\u8853\u512a\u52e2\u7684\u734e\u52f5\uff0c\u4f8b\u5982\u589e\u52a0\u885d\u523a\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5de5\u696d\u5340\u300f\u5730\u5716\u4e2d\u4f7f\u7528\u914d\u5099\u7d05\u8272\u6e96\u661f\u7684\u300e\u5e7d\u9748\u300f\uff0c\u53ef\u4ee5\u4e3b\u5c0e\u8fd1\u8ddd\u96e2\u6230\u9b25\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6bd4\u8f03\u4e0d\u540c\u7af6\u722d\u6027\u5834\u666f\u7684\u88dd\u5099\u8a2d\u7f6e\u3002]"}, {"question": "Hazmob FPS\uff1a\u7dda\u4e0a\u5c04\u64ca\u904a\u6232\u4e2d\u7684\u64ca\u4e2d\u767b\u8a18\u7cfb\u7d71\u4e4b\u9593\u7684\u95dc\u9375\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "Hazmob FPS\uff1a\u7dda\u4e0a\u5c04\u64ca\u904a\u6232\u4f7f\u7528\u5ba2\u6236\u7aef\u64ca\u4e2d\u767b\u8a18\u7cfb\u7d71\uff0c\u9019\u8868\u793a\u64ca\u4e2d\u662f\u5728\u57fa\u65bc\u73a9\u5bb6\u7684\u8996\u89d2\u800c\u4e0d\u662f\u4f3a\u670d\u5668\u4f86\u767b\u8a18\u7684\u3002\u9019\u53ef\u80fd\u6703\u5c0e\u81f4\u9ad8\u5ef6\u9072\u60c5\u6cc1\u4e0b\u7684\u5dee\u7570\u3002\u4f8b\u5982\uff0c\u4f60\u53ef\u80fd\u5728\u87a2\u5e55\u4e0a\u770b\u5230\u64ca\u4e2d\uff0c\u4f46\u4f3a\u670d\u5668\u53ef\u80fd\u7531\u65bc\u5ef6\u9072\u800c\u7121\u6cd5\u767b\u8a18\u5b83\u3002\u8981\u6e1b\u8f15\u9019\u4e00\u9ede\uff0c\u8acb\u78ba\u4fdd\u4f60\u7684\u7db2\u8def\u9023\u7dda\u7a69\u5b9a\uff0c\u4e26\u4f7f\u7528\u904a\u6232\u4e2d\u7684 ping \u6307\u6a19\u4f86\u76e3\u63a7\u5ef6\u9072\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u64ca\u4e2d\u767b\u8a18\u60f3\u6210\u96fb\u8a71\u901a\u8a71 - \u5982\u679c\u6709\u96dc\u8a0a\uff0c\u8a0a\u606f\u53ef\u80fd\u7121\u6cd5\u6e05\u695a\u50b3\u8f38\u3002]"}, {"question": "Hazmob FPS\uff1a\u7dda\u4e0a\u5c04\u64ca\u904a\u6232\u4e2d\u7684\u6392\u540d\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff0c\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u5b83\uff1f", "answer": "Hazmob FPS\uff1a\u7dda\u4e0a\u5c04\u64ca\u904a\u6232\u4e2d\u7684\u6392\u540d\u7cfb\u7d71\u57fa\u65bc\u591a\u500b\u56e0\u7d20\uff1a\u4f60\u7684\u52dd/\u8ca0\u6bd4\u7387\u3001\u500b\u4eba\u8868\u73fe\uff08\u64ca\u6bba\u3001\u52a9\u653b\u3001\u76ee\u6a19\uff09\u4ee5\u53ca\u6bd4\u8cfd\u96e3\u5ea6\u3002\u4f8b\u5982\uff0c\u64ca\u6557\u6392\u540d\u8f03\u9ad8\u7684\u5c0d\u624b\u5c07\u986f\u8457\u63d0\u5347\u4f60\u7684\u6392\u540d\u3002\u76f8\u53cd\u5730\uff0c\u8f38\u7d66\u6392\u540d\u8f03\u4f4e\u7684\u73a9\u5bb6\u6703\u5c0e\u81f4\u6392\u540d\u4e0b\u964d\u3002\u8a72\u7cfb\u7d71\u4f7f\u7528 MMR\uff08\u5339\u914d\u8a55\u7d1a\uff09\u4f86\u78ba\u4fdd\u5e73\u8861\u7684\u6bd4\u8cfd\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u6bd4\u8f03\u4e0d\u540c\u6bd4\u8cfd\u5834\u666f\u7684\u6392\u540d\u589e\u6e1b\u3002]"}, {"question": "\u6211\u53ef\u4ee5\u5728Hazmob FPS\uff1a\u7dda\u4e0a\u5c04\u64ca\u904a\u6232\u4e2d\u5c07\u6211\u7684PC\u9032\u5ea6\u8f49\u79fb\u5230\u4e3b\u6a5f\u55ce\uff1f", "answer": "\u662f\u7684\uff0cHazmob FPS\uff1a\u7dda\u4e0a\u5c04\u64ca\u904a\u6232\u652f\u63f4\u8de8\u5e73\u53f0\u9032\u5ea6\u8f49\u79fb\u3002\u70ba\u6b64\uff0c\u8acb\u5c07\u4f60\u7684\u904a\u6232\u5e33\u6236\u9023\u7d50\u5230\u901a\u7528\u5e73\u53f0\u5e33\u6236\uff08\u4f8b\u5982 Steam \u6216 Xbox Live\uff09\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728 PC \u4e0a\u73a9\u904a\u6232\uff0c\u60f3\u8981\u8f49\u63db\u5230 Xbox\uff0c\u53ea\u9700\u4f7f\u7528\u540c\u4e00\u500b\u5e33\u6236\u767b\u5165\uff0c\u4f60\u7684\u9032\u5ea6\uff08\u5305\u62ec\u89e3\u9396\u548c\u7d71\u8a08\u8cc7\u6599\uff09\u5c07\u6703\u53ef\u7528\u3002\u8acb\u6ce8\u610f\uff0c\u67d0\u4e9b\u5e73\u53f0\u7279\u5b9a\u6210\u5c31\u53ef\u80fd\u7121\u6cd5\u8f49\u79fb\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6bd4\u8f03\u4e0d\u540c\u5e73\u53f0\u7684\u9032\u5ea6\u8f49\u79fb\u9078\u9805\u3002]"}, {"question": "Hazmob FPS\uff1a\u7dda\u4e0a\u5c04\u64ca\u904a\u6232\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\uff0c\u4ee5\u53ca\u5982\u4f55\u767c\u73fe\u5b83\u5011\uff1f", "answer": "Hazmob FPS\uff1a\u7dda\u4e0a\u5c04\u64ca\u904a\u6232\u5145\u6eff\u96b1\u85cf\u7684\u5f69\u86cb\uff0c\u734e\u52f5\u63a2\u7d22\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5ee2\u68c4\u5be6\u9a57\u5ba4\u300f\u5730\u5716\u4e0a\uff0c\u5c04\u64ca\u7279\u5b9a\u9806\u5e8f\u7684\u76ee\u6a19\u6703\u89e3\u9396\u4e00\u500b\u79d8\u5bc6\u623f\u9593\uff0c\u88e1\u9762\u6709\u7a00\u6709\u6230\u5229\u54c1\u3002\u8981\u767c\u73fe\u9019\u4e9b\u5f69\u86cb\uff0c\u8acb\u6ce8\u610f\u74b0\u5883\u7dda\u7d22\uff0c\u4f8b\u5982\u4e0d\u5c0b\u5e38\u7684\u6a19\u8a18\u6216\u8072\u97f3\u3002\u63a2\u7d22\u504f\u96e2\u4e3b\u8981\u5340\u57df\u901a\u5e38\u6703\u901a\u5f80\u9019\u4e9b\u96b1\u85cf\u7684\u5bf6\u85cf\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u5f69\u86cb\u60f3\u50cf\u6210\u96b1\u85cf\u7684\u5bf6\u7bb1\uff0c\u7b49\u5f85\u88ab\u767c\u73fe\u3002]"}, {"question": "\u5982\u4f55\u5728Hazmob FPS\uff1a\u7dda\u4e0a\u5c04\u64ca\u904a\u6232\u4e2d\u6709\u6548\u5730\u4f7f\u7528\u624b\u69b4\u5f48\u4ee5\u7372\u5f97\u6230\u8853\u512a\u52e2\uff1f", "answer": "\u5728Hazmob FPS\uff1a\u7dda\u4e0a\u5c04\u64ca\u904a\u6232\u4e2d\u6709\u6548\u4f7f\u7528\u624b\u69b4\u5f48\u4ee5\u7372\u5f97\u6230\u8853\u512a\u52e2\u9700\u8981\uff1a\u6b65\u9a5f1 - \u5b78\u7fd2\u4e0d\u540c\u624b\u69b4\u5f48\u985e\u578b\u7684\u8ecc\u8de1\u548c\u6642\u6a5f\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u5b83\u5011\u5c07\u6575\u4eba\u5f9e\u63a9\u9ad4\u4e2d\u903c\u51fa\uff0c\u6216\u5c01\u9396\u9698\u53e3\u3002\u6b65\u9a5f3 - \u8207\u4f60\u7684\u5718\u968a\u5354\u8abf\u4ee5\u6700\u5927\u5316\u5176\u5f71\u97ff\u3002\u4f8b\u5982\uff0c\u5728\u9032\u5165\u623f\u9593\u4e4b\u524d\u6295\u64f2\u9583\u5149\u5f48\uff0c\u53ef\u4ee5\u4f7f\u6575\u4eba\u66ab\u6642\u5931\u660e\uff0c\u5728\u300e\u4eba\u8cea\u71df\u6551\u300f\u6a21\u5f0f\u4e2d\u7372\u5f97\u512a\u52e2\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u53ef\u8996\u5316\u624b\u69b4\u5f48\u7684\u8ecc\u8de1\u548c\u6700\u4f73\u4f7f\u7528\u5834\u666f\u3002]"}]
[{"question": "\ucd08\ubcf4\uc790\ub85c\uc11c Hazmob FPS: \uc628\ub77c\uc778 \uc288\ud130\ub97c \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud558\ub098\uc694?", "answer": "Hazmob FPS: \uc628\ub77c\uc778 \uc288\ud130\ub97c \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: 1\ub2e8\uacc4 - \uae30\ubcf8 \ucee8\ud2b8\ub864\uacfc \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\uae30 \uc704\ud574 \ud29c\ud1a0\ub9ac\uc5bc\uc744 \uc644\ub8cc\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4 - \uade0\ud615 \uc7a1\ud78c \ud1b5\uacc4\ub97c \uc81c\uacf5\ud558\ub294 \uacf5\uaca9 \uc18c\ucd1d\uacfc \uac19\uc740 \ucd08\ubcf4\uc790\uc5d0\uac8c \uce5c\uc219\ud55c \ubb34\uae30\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4 - \ub0ae\uc740 \uc555\ubc15 \ud658\uacbd\uc5d0\uc11c \uae30\uc220\uc744 \uc5f0\ub9c8\ud558\uae30 \uc704\ud574 \ud300 \ub370\uc2a4\ub9e4\uce58 \ubaa8\ub4dc\uc5d0 \ucc38\uc5ec\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub3c4\uc2dc \uc804\uc7c1'\uc9c0\ub3c4\uc5d0\uc11c \uacf5\uaca9 \uc18c\ucd1d\uc744 \uc0ac\uc6a9\ud558\uba74 \uc870\uc900 \ubc0f \uc774\ub3d9\uc5d0 \uc775\uc219\ud574\uc9d1\ub2c8\ub2e4. \ub610\ud55c, \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\ucdb0 \ubbfc\uac10\ub3c4 \uc124\uc815\uc744 \uc870\uc815\ud558\uc5ec \ub354 \ub098\uc740 \uc81c\uc5b4\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud29c\ud1a0\ub9ac\uc5bc\uc744 \uc644\uc804\ud55c \uac8c\uc784 \ubc14\uc774\ud06c\ub97c \ud0c0\uae30 \uc804\uc5d0 \uc0ac\uc6a9\ud558\ub294 \uc5f0\uc2b5 \ubc14\ud034\ub77c\uace0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694.]"}, {"question": "Hazmob FPS: \uc628\ub77c\uc778 \uc288\ud130\uc5d0\uc11c \uc815\ud655\ud558\uac8c \uc870\uc900\ud558\ub294 \ub370 \uac00\uc7a5 \uc88b\uc740 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Hazmob FPS: \uc628\ub77c\uc778 \uc288\ud130\uc5d0\uc11c \uc870\uc900\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ub370\ub294 \uba87 \uac00\uc9c0 \uc8fc\uc694 \uc804\ub7b5\uc774 \uc788\uc2b5\ub2c8\ub2e4: 1\ub2e8\uacc4 - \ubb34\uae30 \ud6c4\ud1f4 \ud328\ud134\uc744 \uc774\ud574\ud558\uae30 \uc704\ud574 \uc0ac\uaca9\uc7a5\uc5d0\uc11c \uc5f0\uc2b5\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4 - \ud2b9\ud788 \uc800\uaca9\uc18c\ucd1d\uc73c\ub85c \uc815\ubc00 \uc0ac\uaca9\uc744 \uc704\ud574 'ADS'(\uc870\uc900) \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4 - \uc2dc\uc57c\uc5d0 \ub9de\ub294 \uc0c9\uc0c1\uacfc \ud06c\uae30\ub85c \uc870\uc900\uc810 \uc124\uc815\uc744 \uc870\uc815\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc0ac\ub9c9 \uc804\ucd08\uae30\uc9c0' \uc9c0\ub3c4\uc5d0\uc11c \uc791\uc740 \ube68\uac04 \uc870\uc900\uc810\uc744 \uc0ac\uc6a9\ud558\uba74 \uc7a5\uac70\ub9ac \ud45c\uc801\uc5d0 \ub354 \uc9d1\uc911\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \uac1c\uc120\ub41c \uc815\ud655\uc131\uc744 \uc704\ud574 \uae30\ubcf8 \uc870\uc900\uc810\uacfc \uc0ac\uc6a9\uc790 \uc9c0\uc815 \uc870\uc900\uc810\uc744 \ube44\uad50\ud569\ub2c8\ub2e4.]"}, {"question": "Hazmob FPS: \uc628\ub77c\uc778 \uc288\ud130\uc5d0\uc11c \ub2e4\ub978 \uac8c\uc784 \ubaa8\ub4dc\uc5d0 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ubb34\uae30\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Hazmob FPS: \uc628\ub77c\uc778 \uc288\ud130\uc758 \ub2e4\ub978 \uac8c\uc784 \ubaa8\ub4dc\ub294 \ud2b9\uc815 \ubb34\uae30 \uc120\ud0dd\uc774 \ud544\uc694\ud569\ub2c8\ub2e4: \ud300 \ub370\uc2a4\ub9e4\uce58\uc758 \uacbd\uc6b0, \uacf5\uaca9 \uc18c\ucd1d\uc740 \ub2e4\uc7ac\ub2e4\ub2a5\ud558\uace0 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. \uae43\ubc1c \uc7c1\ud0c8\uc804\uc5d0\uc11c\ub294 '\ube44\ud37c'\uc640 \uac19\uc740 SMG\uac00 \uc18d\ub3c4\uc640 \ubbfc\ucca9\uc131\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc800\uaca9\uc218 \uc804\uc6a9 \ubaa8\ub4dc\uc5d0\uc11c\ub294 '\ub871\ubcf4\uc6b0'\uac00 \uc7a5\uac70\ub9ac \uad50\uc804\uc5d0 \uc774\uc0c1\uc801\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc232 \ub9e4\ubcf5'\uc9c0\ub3c4\uc5d0\uc11c '\ube44\ud37c'\ub97c \uc0ac\uc6a9\ud558\uba74 \uc774\ub3d9\uc131\uc73c\ub85c \uc778\ud574 \uae43\ubc1c\uc744 \ube60\ub974\uac8c \ucea1\ucc98\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc635\uc158 \ube44\uad50: \uac01 \ubaa8\ub4dc\uc5d0 \ub300\ud55c \ubb34\uae30 \ud1b5\uacc4\ub97c \ube44\uad50\ud558\uc5ec \uc815\ubcf4\uc5d0 \uc785\uac01\ud55c \uc120\ud0dd\uc744 \ud569\ub2c8\ub2e4.]"}, {"question": "Hazmob FPS: \uc628\ub77c\uc778 \uc288\ud130\uc5d0\uc11c \uc9c0\ub3c4 \uc778\uc9c0\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \uac1c\uc120\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Hazmob FPS: \uc628\ub77c\uc778 \uc288\ud130\uc5d0\uc11c \uc9c0\ub3c4 \uc778\uc9c0\ub294 \uc801\uc758 \uc774\ub3d9\uc744 \uc608\uce21\ud558\uace0 \uc8fc\uc694 \uc9c0\uc5ed\uc744 \ud1b5\uc81c\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ubbc0\ub85c \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \ub2e4\uc74c\uacfc \uac19\uc774 \uac1c\uc120\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4: 1\ub2e8\uacc4 - \uc0ac\uc6a9\uc790 \uc9c0\uc815 \uac8c\uc784\uc5d0\uc11c \ubaa8\ub4e0 \uc9c0\ub3c4\ub97c \ud0d0\ud5d8\ud558\uc5ec \ubaa8\ub4e0 \uc9c0\ub3c4\uc5d0 \uc775\uc219\ud574\uc9d1\ub2c8\ub2e4. 2\ub2e8\uacc4 - \ubbf8\ub2c8\ub9f5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc801\uc758 \uc704\uce58\ub97c \ucd94\uc801\ud558\uace0 \uacbd\ub85c\ub97c \uacc4\ud68d\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4 - \ud300\uc6d0\uacfc \uc18c\ud1b5\ud558\uc5ec \uc801 \uc704\uce58\uc5d0 \ub300\ud55c \uc815\ubcf4\ub97c \uacf5\uc720\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub3c4\uc2dc \ud3d0\ud5c8' \uc9c0\ub3c4\uc5d0\uc11c \uace0\uc9c0\ub300 \uc704\uce58\ub97c \uc544\ub294 \uac83\uc740 \uc804\ub7b5\uc801 \uc774\uc810\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc77c\ubc18\uc801\uc778 \uc801 \uacbd\ub85c\uc640 \ubcd1\ubaa9 \uc9c0\uc810\uc744 \uc2dc\uac01\ud654\ud569\ub2c8\ub2e4.]"}, {"question": "Hazmob FPS: \uc628\ub77c\uc778 \uc288\ud130\uc5d0\uc11c \uacbd\uc7c1 \ud50c\ub808\uc774\ub97c \uc704\ud574 \ub85c\ub4dc\uc544\uc6c3\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud558\ub098\uc694?", "answer": "Hazmob FPS: \uc628\ub77c\uc778 \uc288\ud130\uc5d0\uc11c \uacbd\uc7c1 \ud50c\ub808\uc774\ub97c \uc704\ud55c \ub85c\ub4dc\uc544\uc6c3 \ucd5c\uc801\ud654\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: 1\ub2e8\uacc4 - \uacf5\uaca9\uc801\uc778 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c '\ud32c\ud140' SMG\uc640 \uac19\uc774 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\ub294 \ubb34\uae30\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4 - \ud655\uc7a5 \ud0c4\ucc3d \ubc0f \ub9dd\uc6d0\uacbd\uacfc \uac19\uc740 \ubd80\ucc29\ubb3c\uc744 \uc7a5\ucc29\ud558\uc5ec \ubb34\uae30 \uc131\ub2a5\uc744 \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4. 3\ub2e8\uacc4 - \uc2a4\ud504\ub9b0\ud2b8 \uc18d\ub3c4 \ud5a5\uc0c1\uacfc \uac19\uc740 \uc804\uc220\uc801 \uc774\uc810\uc744 \uc81c\uacf5\ud558\ub294 \ud2b9\uc131\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc0b0\uc5c5 \uc9c0\ub300' \uc9c0\ub3c4\uc5d0\uc11c '\ud32c\ud140'\uc744 \uc801\uc0c9 \uc810 \uc870\uc900 \uc7a5\uce58\uc640 \ud568\uaed8 \uc0ac\uc6a9\ud558\uba74 \uadfc\uc811 \uc804\ud22c\ub97c \uc9c0\ubc30\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \ub2e4\ub978 \uacbd\uc7c1 \uc2dc\ub098\ub9ac\uc624\uc5d0 \ub300\ud55c \ub85c\ub4dc\uc544\uc6c3 \uc124\uc815\uc744 \ube44\uad50\ud569\ub2c8\ub2e4.]"}, {"question": "Hazmob FPS: \uc628\ub77c\uc778 \uc288\ud130\uc5d0\uc11c \ud788\ud2b8 \ub4f1\ub85d \uc2dc\uc2a4\ud15c\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Hazmob FPS: \uc628\ub77c\uc778 \uc288\ud130\ub294 \ud074\ub77c\uc774\uc5b8\ud2b8 \uce21 \ud788\ud2b8 \ub4f1\ub85d \uc2dc\uc2a4\ud15c\uc744 \uc0ac\uc6a9\ud558\uc5ec, \ud788\ud2b8\ub294 \uc11c\ubc84\uac00 \uc544\ub2cc \ud50c\ub808\uc774\uc5b4\uc758 \uad00\uc810\uc5d0 \ub530\ub77c \ub4f1\ub85d\ub429\ub2c8\ub2e4. \uc774\ub294 \ub192\uc740 \uc9c0\uc5f0 \uc2dc\uac04 \uc0c1\ud669\uc5d0\uc11c \ucc28\uc774\ub97c \ucd08\ub798\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud654\uba74\uc5d0\uc11c \ud788\ud2b8\ub97c \ubcfc \uc218 \uc788\uc9c0\ub9cc, \uc11c\ubc84\ub294 \uc9c0\uc5f0\uc73c\ub85c \uc778\ud574 \ub4f1\ub85d\ud558\uc9c0 \uc54a\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub97c \uc644\ud654\ud558\uae30 \uc704\ud574 \uc548\uc815\uc801\uc778 \uc778\ud130\ub137 \uc5f0\uacb0\uc744 \uc720\uc9c0\ud558\uace0 \uac8c\uc784 \ub0b4 \ud551 \uc9c0\ud45c\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc9c0\uc5f0 \uc2dc\uac04\uc744 \ubaa8\ub2c8\ud130\ub9c1\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud788\ud2b8 \ub4f1\ub85d\uc740 \uc804\ud654 \ud1b5\ud654\uc640 \uac19\uc2b5\ub2c8\ub2e4. \uc815\uc804\uc774 \uc788\uc73c\uba74 \uba54\uc2dc\uc9c0\uac00 \uba85\ud655\ud558\uac8c \uc804\ub2ec\ub418\uc9c0 \uc54a\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "Hazmob FPS: \uc628\ub77c\uc778 \uc288\ud130\uc5d0\uc11c \ub7ad\ud0b9 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \uc5b4\ub5a4 \uc694\uc18c\uac00 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "Hazmob FPS: \uc628\ub77c\uc778 \uc288\ud130\uc758 \ub7ad\ud0b9 \uc2dc\uc2a4\ud15c\uc740 \uc2b9\ub960, \uac1c\ubcc4 \uc131\ub2a5(\ud0ac, \uc5b4\uc2dc\uc2a4\ud2b8, \ubaa9\ud45c \ub2ec\uc131), \uadf8\ub9ac\uace0 \ub9e4\uce58 \ub09c\uc774\ub3c4\ub97c \uc885\ud569\uc801\uc73c\ub85c \uace0\ub824\ud558\uc5ec \uc791\ub3d9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub354 \ub192\uc740 \uc21c\uc704\uc758 \uc0c1\ub300\ub97c \uc0c1\ub300\ub85c \ub9e4\uce58\uc5d0\uc11c \uc774\uae30\uba74 \ub7ad\ud06c\uac00 \ud06c\uac8c \uc0c1\uc2b9\ud569\ub2c8\ub2e4. \ubc18\ub300\ub85c, \ub0ae\uc740 \uc21c\uc704\uc758 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc9c0\uba74 \ub7ad\ud06c\uac00 \ud558\ub77d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2dc\uc2a4\ud15c\uc740 \uade0\ud615 \uc7a1\ud78c \ub9e4\uce58\ub97c \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 MMR(\ub9e4\uce58\uba54\uc774\ud0b9 \ub4f1\uae09)\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc635\uc158 \ube44\uad50: \ub2e4\ub978 \ub9e4\uce58 \uc2dc\ub098\ub9ac\uc624\uc5d0\uc11c \ub7ad\ud0b9 \uc0c1\uc2b9/\ud558\ub77d\uc744 \ube44\uad50\ud569\ub2c8\ub2e4.]"}, {"question": "Hazmob FPS: \uc628\ub77c\uc778 \uc288\ud130\uc5d0\uc11c PC \uc9c4\ud589 \uc0c1\ud669\uc744 \ucf58\uc194\ub85c \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub124, Hazmob FPS: \uc628\ub77c\uc778 \uc288\ud130\ub294 \ub2e4\uc911 \ud50c\ub7ab\ud3fc \uc9c4\ud589 \uc0c1\ud669 \uc804\uc1a1\uc744 \uc9c0\uc6d0\ud569\ub2c8\ub2e4. \uc774\ub807\uac8c \ud558\ub824\uba74 \uac8c\uc784 \uacc4\uc815\uc744 Steam \ub610\ub294 Xbox Live\uc640 \uac19\uc740 \ubcf4\ud3b8\uc801\uc778 \ud50c\ub7ab\ud3fc \uacc4\uc815\uc5d0 \uc5f0\uacb0\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ud50c\ub808\uc774\ud558\uace0 Xbox\ub85c \uc804\ud658\ud558\ub824\uba74 \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uae30\ub9cc \ud558\uba74 \ub429\ub2c8\ub2e4. \uadf8\ub9ac\uace0 \uc5b8\ub77d \ubc0f \ud1b5\uacc4\ub97c \ud3ec\ud568\ud55c \uc9c4\ud589 \uc0c1\ud669\uc774 \uc0ac\uc6a9 \uac00\ub2a5\ud569\ub2c8\ub2e4. \uc77c\ubd80 \ud50c\ub7ab\ud3fc \ud2b9\uc815 \uc5c5\uc801\uc740 \uc804\uc1a1\ub418\uc9c0 \uc54a\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669 \uc804\uc1a1 \uc635\uc158\uc744 \ube44\uad50\ud569\ub2c8\ub2e4.]"}, {"question": "Hazmob FPS: \uc628\ub77c\uc778 \uc288\ud130\uc5d0\uc11c \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \ubc1c\uacac\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Hazmob FPS: \uc628\ub77c\uc778 \uc288\ud130\ub294 \ud0d0\ud5d8\uc744 \ubcf4\uc0c1\ud558\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub85c \uac00\ub4dd \ucc28 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud3d0\ud5c8\ub41c \uc2e4\ud5d8\uc2e4' \uc9c0\ub3c4\uc5d0\uc11c \ud2b9\uc815 \ud0c0\uac9f\uc744 \uc5f0\uc18d\uc73c\ub85c \uc0ac\uaca9\ud558\uba74 \ud76c\uadc0\ud55c \uc544\uc774\ud15c\uc774 \uc788\ub294 \ube44\ubc00 \ubc29\uc744 \uc5f4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\uac83\ub4e4\uc744 \ubc1c\uacac\ud558\uae30 \uc704\ud574\uc11c\ub294 \ube44\uc815\uc0c1\uc801\uc778 \ud45c\uc2dc \ub610\ub294 \uc18c\ub9ac\uc640 \uac19\uc740 \ud658\uacbd \ub2e8\uc11c\uc5d0 \uc8fc\uc758\ud558\uc2ed\uc2dc\uc624. \ubc97\uc5b4\ub09c \uc9c0\uc5ed\uc744 \ud0d0\ud5d8\ud558\ub294 \uac83\uc774 \uc885\uc885 \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ubcf4\ubb3c\ub85c \uc774\uc5b4\uc9d1\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ucc3e\uc744 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ubcf4\ubb3c \uc0c1\uc790\ub77c\uace0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694.]"}, {"question": "Hazmob FPS: \uc628\ub77c\uc778 \uc288\ud130\uc5d0\uc11c \uc804\uc220\uc801 \uc774\uc810\uc744 \uc5bb\uae30 \uc704\ud574 \uc218\ub958\ud0c4\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Hazmob FPS: \uc628\ub77c\uc778 \uc288\ud130\uc5d0\uc11c \uc218\ub958\ud0c4\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \ubc29\ubc95: 1\ub2e8\uacc4 - \ub2e4\uc591\ud55c \uc218\ub958\ud0c4 \uc720\ud615\uc758 \uada4\uc801\uacfc \ud0c0\uc774\ubc0d\uc744 \ubc30\uc6b0\uc138\uc694. 2\ub2e8\uacc4 - \uc801\uc744 \uc740\uc2e0\ucc98\uc5d0\uc11c \ub04c\uc5b4\ub0b4\uac70\ub098 \ubcd1\ubaa9 \uc9c0\uc810\uc744 \ucc28\ub2e8\ud558\uae30 \uc704\ud574 \uc0ac\uc6a9\ud558\uc138\uc694. 3\ub2e8\uacc4 - \ud300\uc6d0\uacfc \ud611\ub825\ud558\uc5ec \ucd5c\ub300 \ud6a8\uacfc\ub97c \ubc1c\ud718\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uc778\uc9c8 \uad6c\ucd9c' \ubaa8\ub4dc\uc5d0\uc11c \ubc29\uc5d0 \ud50c\ub798\uc2dc\ubc45\ud06c\ub97c \ub358\uc9c0\uba74 \uc801\uc744 \ub208\uba40\uac8c \ud558\uc5ec \uc6b0\uc704\ub97c \uc810\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc218\ub958\ud0c4 \uada4\uc801 \ubc0f \ucd5c\uc801 \uc0ac\uc6a9 \uc2dc\ub098\ub9ac\uc624\ub97c \uc2dc\uac01\ud654\ud569\ub2c8\ub2e4.]"}]
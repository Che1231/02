[{"question": "\u5982\u4f55\u5728\u65b0\u624b\u6a21\u5f0f\u4e0b\u958b\u59cb\u73a9\u6cf0\u52d2\u5bf6\u5bf6\u611f\u6069\u7bc0\u70f9\u98ea\u904a\u6232\uff1f", "answer": "\u8981\u958b\u59cb\u5728\u6cf0\u52d2\u5bf6\u5bf6\u611f\u6069\u7bc0\u70f9\u98ea\u904a\u6232\u4e2d\u70f9\u98ea\uff0c\u9996\u5148\uff0c\u8acb\u5f9e\u9078\u55ae\u4e2d\u9078\u64c7\u98df\u8b5c\u3002\u4f8b\u5982\uff0c\u9078\u64c7\u300e\u70e4\u706b\u96de\u300f\u3002\u6b65\u9a5f1\uff1a\u9ede\u64ca\u5eda\u623f\u88e1\u7684\u98df\u6750\uff0c\u6536\u96c6\u98df\u6750\u3002\u6b65\u9a5f2\uff1a\u6309\u7167\u87a2\u5e55\u4e0a\u7684\u6307\u793a\u6e96\u5099\u83dc\u991a\uff0c\u4f8b\u5982\u8abf\u5473\u706b\u96de\u3002\u6b65\u9a5f3\uff1a\u5229\u7528\u70e4\u7bb1\u6b63\u78ba\u8a2d\u5b9a\u8a08\u6642\u5668\uff0c\u70f9\u98ea\u706b\u96de\u3002\u9019\u500b\u57fa\u672c\u904e\u7a0b\u6703\u8b93\u4f60\u4e86\u89e3\u904a\u6232\u6a5f\u5236\u3002[\u6bd4\u55bb\u8aaa\u660e: \u53ef\u4ee5\u628a\u5b83\u60f3\u6210\u662f\u9075\u5faa\u5177\u6709\u4e92\u52d5\u6b65\u9a5f\u7684\u98df\u8b5c\u66f8\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u6642\u9593\u5728\u6cf0\u52d2\u5bf6\u5bf6\u611f\u6069\u7bc0\u70f9\u98ea\u904a\u6232\u4e2d\u5f88\u91cd\u8981\uff1f", "answer": "\u5728\u6cf0\u52d2\u5bf6\u5bf6\u611f\u6069\u7bc0\u70f9\u98ea\u904a\u6232\u4e2d\uff0c\u6642\u9593\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6703\u5f71\u97ff\u83dc\u991a\u7684\u54c1\u8cea\u3002\u4f8b\u5982\uff0c\u904e\u5ea6\u70f9\u98ea\u706b\u96de\u6703\u5c0e\u81f4\u83dc\u991a\u71d2\u7126\uff0c\u964d\u4f4e\u4f60\u7684\u5206\u6578\u3002\u6b63\u78ba\u7684\u6642\u9593\u80fd\u78ba\u4fdd\u5f9e\u6e96\u5099\u5230\u70f9\u98ea\u7684\u6bcf\u500b\u6b65\u9a5f\u90fd\u80fd\u5b8c\u7f8e\u57f7\u884c\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u672a\u716e\u719f\uff08\u4f4e\u5206\uff09| \u5b8c\u5168\u716e\u719f\uff08\u9ad8\u5206\uff09| \u904e\u5ea6\u70f9\u98ea\uff08\u5931\u6557\uff09]\u3002\u638c\u63e1\u6642\u9593\u80fd\u5e6b\u52a9\u4f60\u7372\u5f97\u66f4\u9ad8\u7684\u8a55\u5206\u4e26\u89e3\u9396\u9ad8\u7d1a\u98df\u8b5c\u3002"}, {"question": "\u6cf0\u52d2\u5bf6\u5bf6\u611f\u6069\u7bc0\u70f9\u98ea\u904a\u6232\u4e2d\u9700\u8981\u54ea\u4e9b\u57fa\u672c\u5de5\u5177\uff1f", "answer": "\u5728\u6cf0\u52d2\u5bf6\u5bf6\u611f\u6069\u7bc0\u70f9\u98ea\u904a\u6232\u4e2d\uff0c\u57fa\u672c\u5de5\u5177\u5305\u62ec\u70e4\u7bb1\u3001\u652a\u62cc\u7897\u548c\u5207\u83dc\u677f\u3002\u4f8b\u5982\uff0c\u70e4\u7bb1\u7528\u65bc\u70d8\u70e4\u5357\u74dc\u6d3e\u7b49\u83dc\u991a\uff0c\u800c\u652a\u62cc\u7897\u662f\u6e96\u5099\u9eb5\u5718\u7b49\u98df\u6750\u7684\u5fc5\u9700\u54c1\u3002\u9019\u4e9b\u5de5\u5177\u5c0d\u65bc\u6709\u6548\u5b8c\u6210\u98df\u8b5c\u81f3\u95dc\u91cd\u8981\u3002[\u6d41\u7a0b\u5716\u89e3: \u98df\u6750 \u2192 \u6e96\u5099(\u652a\u62cc\u7897) \u2192 \u70f9\u98ea(\u70e4\u7bb1) \u2192 \u6700\u7d42\u83dc\u991a]\u3002\u4e86\u89e3\u5b83\u5011\u7684\u529f\u80fd\u662f\u904a\u6232\u9032\u968e\u7684\u95dc\u9375\u3002"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u53ef\u4ee5\u5e6b\u52a9\u9ad8\u7d1a\u73a9\u5bb6\u5728\u6cf0\u52d2\u5bf6\u5bf6\u611f\u6069\u7bc0\u70f9\u98ea\u904a\u6232\u4e2d\u6700\u5927\u5316\u5f97\u5206\uff1f", "answer": "\u9ad8\u7d1a\u73a9\u5bb6\u53ef\u4ee5\u900f\u904e\u6ce8\u91cd\u7cbe\u78ba\u6027\u548c\u6548\u7387\u4f86\u6700\u5927\u5316\u5f97\u5206\u3002\u6b65\u9a5f1\uff1a\u8a18\u4f4f\u98df\u8b5c\u6b65\u9a5f\u4ee5\u7e2e\u77ed\u6e96\u5099\u6642\u9593\u3002\u6b65\u9a5f2\uff1a\u904b\u7528\u591a\u5de5\uff0c\u4f8b\u5982\u5728\u70e4\u7bb1\u9810\u71b1\u6642\u5207\u852c\u83dc\u3002\u6b65\u9a5f3\uff1a\u5b8c\u7f8e\u638c\u63e1\u6bcf\u6b21\u70f9\u98ea\u6b65\u9a5f\u7684\u6642\u9593\uff0c\u907f\u514d\u8655\u7f70\u3002\u4f8b\u5982\uff0c\u540c\u6b65\u70e4\u6d3e\u8207\u70e4\u706b\u96de\u53ef\u4ee5\u7bc0\u7701\u6642\u9593\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u55ae\u4e00\u4efb\u52d9(\u4f4e\u5206) \u5c0d \u591a\u4efb\u52d9(\u9ad8\u5206)]\u3002\u9019\u4e9b\u7b56\u7565\u63d0\u5347\u904a\u6232\u9ad4\u9a57\u4e26\u89e3\u9396\u96b1\u85cf\u6210\u5c31\u3002"}, {"question": "\u5982\u4f55\u5728\u6cf0\u52d2\u5bf6\u5bf6\u611f\u6069\u7bc0\u70f9\u98ea\u904a\u6232\u4e2d\u89e3\u9396\u96b1\u85cf\u98df\u8b5c\uff1f", "answer": "\u6cf0\u52d2\u5bf6\u5bf6\u611f\u6069\u7bc0\u70f9\u98ea\u904a\u6232\u4e2d\u7684\u96b1\u85cf\u98df\u8b5c\u662f\u900f\u904e\u5b8c\u6210\u7279\u5b9a\u6311\u6230\u89e3\u9396\u7684\u3002\u4f8b\u5982\uff0c\u5728\u4e09\u500b\u9023\u7e8c\u98df\u8b5c\u4e2d\u9054\u6210\u5b8c\u7f8e\u5206\u6578\uff0c\u53ef\u80fd\u6703\u89e3\u9396\u79d8\u5bc6\u751c\u9ede\u3002\u6ce8\u610f\u904a\u6232\u63d0\u793a\uff0c\u4e26\u63a2\u7d22\u4e0d\u540c\u98df\u6750\u7d44\u5408\uff0c\u5c31\u80fd\u767c\u73fe\u9019\u4e9b\u96b1\u85cf\u7684\u7f8e\u5473\u4f73\u991a\u3002[\u6bd4\u55bb\u8aaa\u660e: \u9019\u5c31\u50cf\u89e3\u958b\u4e00\u9053\u70f9\u98ea\u8b0e\u984c\u4f86\u63ed\u66c9\u9a5a\u559c\u83dc\u991a]\u3002\u9019\u70ba\u81f4\u529b\u65bc\u73a9\u904a\u6232\u7684\u73a9\u5bb6\u589e\u52a0\u4e86\u984d\u5916\u7684\u8208\u596e\u611f\u3002"}, {"question": "\u98df\u6750\u54c1\u8cea\u5728\u6cf0\u52d2\u5bf6\u5bf6\u611f\u6069\u7bc0\u70f9\u98ea\u904a\u6232\u4e2d\u626e\u6f14\u4ec0\u9ebc\u89d2\u8272\uff1f", "answer": "\u98df\u6750\u54c1\u8cea\u76f4\u63a5\u5f71\u97ff\u6cf0\u52d2\u5bf6\u5bf6\u611f\u6069\u7bc0\u70f9\u98ea\u904a\u6232\u4e2d\u7684\u6700\u7d42\u83dc\u991a\u3002\u512a\u8cea\u98df\u6750\uff0c\u4f8b\u5982\u65b0\u9bae\u852c\u83dc\uff0c\u80fd\u63d0\u5347\u83dc\u991a\u7684\u5473\u9053\u548c\u5916\u89c0\uff0c\u4e26\u7372\u5f97\u66f4\u9ad8\u7684\u5206\u6578\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u65b0\u9bae\u5357\u74dc\u505a\u6d3e\u9921\u6bd4\u4f7f\u7528\u7f50\u88dd\u5357\u74dc\u6548\u679c\u66f4\u597d\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u65b0\u9bae\u98df\u6750\uff08\u9ad8\u5206\uff09| \u666e\u901a\u98df\u6750\uff08\u4e2d\u7b49\u5206\uff09| \u52a3\u8cea\u98df\u6750\uff08\u4f4e\u5206\uff09]\u3002\u512a\u5148\u8003\u616e\u54c1\u8cea\u80fd\u78ba\u4fdd\u904a\u6232\u4e2d\u7684\u6301\u7e8c\u6210\u529f\u3002"}, {"question": "\u6cf0\u52d2\u5bf6\u5bf6\u611f\u6069\u7bc0\u70f9\u98ea\u904a\u6232\u7684\u5206\u6578\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u6cf0\u52d2\u5bf6\u5bf6\u611f\u6069\u7bc0\u70f9\u98ea\u904a\u6232\u7684\u5206\u6578\u7cfb\u7d71\u8a55\u4f30\u6e96\u78ba\u6027\u3001\u6642\u9593\u548c\u98df\u6750\u54c1\u8cea\u3002\u4f8b\u5982\uff0c\u88fd\u4f5c\u5b8c\u7f8e\u7684\u706b\u96de\u9700\u8981\u6b63\u78ba\u7684\u8abf\u5473\u3001\u9069\u7576\u7684\u70f9\u98ea\u6642\u9593\u548c\u65b0\u9bae\u98df\u6750\u3002\u6bcf\u500b\u6b65\u9a5f\u90fd\u6703\u500b\u5225\u8a08\u5206\uff0c\u5b8c\u7f8e\u57f7\u884c\u6703\u7372\u5f97\u984d\u5916\u734e\u52f5\u3002[\u6d41\u7a0b\u5716\u89e3: \u6e96\u5099(20%) \u2192 \u70f9\u98ea(50%) \u2192 \u88dd\u76e4(30%) \u2192 \u7e3d\u5206]\u3002\u4e86\u89e3\u9019\u500b\u5206\u89e3\u80fd\u5e6b\u52a9\u73a9\u5bb6\u5c08\u6ce8\u65bc\u9700\u8981\u6539\u9032\u7684\u65b9\u9762\u3002"}, {"question": "\u6cf0\u52d2\u5bf6\u5bf6\u611f\u6069\u7bc0\u70f9\u98ea\u904a\u6232\u7684\u9032\u5ea6\u53ef\u4ee5\u5728\u4e0d\u540c\u88dd\u7f6e\u9593\u8f49\u79fb\u55ce\uff1f", "answer": "\u662f\u7684\uff0c\u6cf0\u52d2\u5bf6\u5bf6\u611f\u6069\u7bc0\u70f9\u98ea\u904a\u6232\u7684\u9032\u5ea6\u53ef\u4ee5\u900f\u904e\u5c07\u4f60\u7684\u904a\u6232\u5e33\u6236\u9023\u7d50\u5230\u793e\u7fa4\u5a92\u9ad4\u6a94\u6848\u6216\u96fb\u5b50\u90f5\u4ef6\u4f86\u5728\u4e0d\u540c\u88dd\u7f6e\u9593\u8f49\u79fb\u3002\u9019\u78ba\u4fdd\u4f60\u7684\u6210\u5c31\u3001\u89e3\u9396\u7684\u98df\u8b5c\u548c\u9ad8\u5206\u6703\u5132\u5b58\u4e0b\u4f86\uff0c\u4e26\u5728\u4efb\u4f55\u76f8\u5bb9\u88dd\u7f6e\u4e0a\u90fd\u80fd\u5b58\u53d6\u3002[\u6bd4\u55bb\u8aaa\u660e: \u9019\u5c31\u50cf\u64c1\u6709\u4e00\u672c\u6703\u96a8\u8457\u4f60\u79fb\u52d5\u7684\u6578\u4f4d\u98df\u8b5c\u66f8]\u3002\u9019\u500b\u529f\u80fd\u5c0d\u65bc\u5728\u884c\u52d5\u88dd\u7f6e\u548c\u5e73\u677f\u88dd\u7f6e\u4e4b\u9593\u5207\u63db\u7684\u73a9\u5bb6\u4f86\u8aaa\u7279\u5225\u6709\u7528\u3002"}, {"question": "\u6cf0\u52d2\u5bf6\u5bf6\u611f\u6069\u7bc0\u70f9\u98ea\u904a\u6232\u4e2d\u7684\u4f11\u9592\u6a21\u5f0f\u548c\u5c08\u5bb6\u6a21\u5f0f\u6709\u4ec0\u9ebc\u95dc\u9375\u5dee\u7570\uff1f", "answer": "\u6cf0\u52d2\u5bf6\u5bf6\u611f\u6069\u7bc0\u70f9\u98ea\u904a\u6232\u7684\u4f11\u9592\u6a21\u5f0f\u63d0\u4f9b\u6307\u5c0e\u6b65\u9a5f\u548c\u5bec\u9b06\u7684\u6642\u9593\uff0c\u975e\u5e38\u9069\u5408\u65b0\u624b\u3002\u7136\u800c\uff0c\u5c08\u5bb6\u6a21\u5f0f\u5247\u79fb\u9664\u63d0\u793a\u4e26\u5f37\u5236\u57f7\u884c\u56b4\u683c\u7684\u6642\u9593\uff0c\u6311\u6230\u73a9\u5bb6\u4f9d\u8cf4\u81ea\u5df1\u7684\u6280\u80fd\u3002\u4f8b\u5982\uff0c\u5728\u5c08\u5bb6\u6a21\u5f0f\u4e2d\uff0c\u4f60\u5fc5\u9808\u5728\u6c92\u6709\u63d0\u793a\u7684\u60c5\u6cc1\u4e0b\u624b\u52d5\u8a2d\u5b9a\u70e4\u7bb1\u8a08\u6642\u5668\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u4f11\u9592\u6a21\u5f0f(\u6307\u5c0e\uff0c\u5bb9\u6613) \u5c0d \u5c08\u5bb6\u6a21\u5f0f(\u7121\u8f14\u52a9\uff0c\u5177\u6709\u6311\u6230\u6027)]\u3002\u9078\u64c7\u6b63\u78ba\u7684\u6a21\u5f0f\u53d6\u6c7a\u65bc\u4f60\u7684\u8212\u9069\u5ea6\u548c\u7d93\u9a57\u3002"}, {"question": "\u5982\u4f55\u5728\u6cf0\u52d2\u5bf6\u5bf6\u611f\u6069\u7bc0\u70f9\u98ea\u904a\u6232\u4e2d\u767c\u73fe\u5f69\u86cb\uff1f", "answer": "\u6cf0\u52d2\u5bf6\u5bf6\u611f\u6069\u7bc0\u70f9\u98ea\u904a\u6232\u4e2d\u7684\u5f69\u86cb\u662f\u904a\u6232\u4e2d\u96b1\u85cf\u7684\u4e92\u52d5\u6216\u9a5a\u559c\u3002\u4f8b\u5982\uff0c\u591a\u6b21\u9ede\u64ca\u7279\u5b9a\u7684\u5eda\u623f\u88dd\u98fe\u53ef\u80fd\u6703\u89f8\u767c\u7279\u6b8a\u52d5\u756b\u6216\u89e3\u9396\u7368\u7279\u7684\u98df\u6750\u3002\u63a2\u7d22\u5eda\u623f\u7684\u6bcf\u500b\u89d2\u843d\u4e26\u5617\u8a66\u4e0d\u5c0b\u5e38\u7684\u52d5\u4f5c\uff0c\u53ef\u4ee5\u63ed\u793a\u9019\u4e9b\u96b1\u85cf\u7684\u5bf6\u85cf\u3002[\u6bd4\u55bb\u8aaa\u660e: \u9019\u5c31\u50cf\u5728\u5fc3\u611b\u7684\u5bb6\u5ead\u98df\u8b5c\u4e2d\u627e\u5230\u79d8\u5bc6\u98df\u6750]\u3002\u9019\u70ba\u559c\u6b61\u5fb9\u5e95\u63a2\u7d22\u7684\u73a9\u5bb6\u589e\u52a0\u4e86\u8da3\u5473\u5143\u7d20\u3002"}]
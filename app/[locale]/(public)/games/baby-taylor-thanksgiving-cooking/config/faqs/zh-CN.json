[{"question": "\u65b0\u624b\u5982\u4f55\u5f00\u59cb\u5728\u5a74\u513f\u6cf0\u52d2\u611f\u6069\u8282\u70f9\u996a\u6e38\u620f\u4e2d\u70f9\u996a\uff1f", "answer": "\u8981\u5f00\u59cb\u5728\u5a74\u513f\u6cf0\u52d2\u611f\u6069\u8282\u70f9\u996a\u6e38\u620f\u4e2d\u70f9\u996a\uff0c\u9996\u5148\uff0c\u4ece\u83dc\u5355\u4e2d\u9009\u62e9\u4e00\u4e2a\u98df\u8c31\u3002\u4f8b\u5982\uff0c\u9009\u62e9\u201c\u70e4\u706b\u9e21\u201d\u3002\u6b65\u9aa41\uff1a\u70b9\u51fb\u53a8\u623f\u4e2d\u7684\u98df\u6750\uff0c\u6536\u96c6\u98df\u6750\u3002\u6b65\u9aa42\uff1a\u6309\u7167\u5c4f\u5e55\u4e0a\u7684\u8bf4\u660e\u51c6\u5907\u83dc\u80b4\uff0c\u4f8b\u5982\u7ed9\u706b\u9e21\u8c03\u5473\u3002\u6b65\u9aa43\uff1a\u901a\u8fc7\u6b63\u786e\u8bbe\u7f6e\u8ba1\u65f6\u5668\uff0c\u4f7f\u7528\u70e4\u7bb1\u70f9\u5236\u706b\u9e21\u3002\u8fd9\u4e2a\u57fa\u672c\u8fc7\u7a0b\u5411\u4f60\u4ecb\u7ecd\u4e86\u6e38\u620f\u673a\u5236\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u53ef\u4ee5\u628a\u5b83\u60f3\u8c61\u6210\u6309\u7167\u5e26\u4e92\u52a8\u6b65\u9aa4\u7684\u98df\u8c31\u4e66\u64cd\u4f5c\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u65f6\u95f4\u5728\u5a74\u513f\u6cf0\u52d2\u611f\u6069\u8282\u70f9\u996a\u6e38\u620f\u4e2d\u5f88\u91cd\u8981\uff1f", "answer": "\u65f6\u95f4\u5728\u5a74\u513f\u6cf0\u52d2\u611f\u6069\u8282\u70f9\u996a\u6e38\u620f\u4e2d\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u4f1a\u5f71\u54cd\u83dc\u80b4\u7684\u8d28\u91cf\u3002\u4f8b\u5982\uff0c\u706b\u9e21\u70f9\u996a\u8fc7\u5ea6\u4f1a\u5bfc\u81f4\u83dc\u80b4\u70e7\u7126\uff0c\u4ece\u800c\u964d\u4f4e\u5206\u6570\u3002\u6b63\u786e\u7684\u65f6\u95f4\u786e\u4fdd\u4ece\u51c6\u5907\u5230\u70f9\u996a\u7684\u6bcf\u4e2a\u6b65\u9aa4\u90fd\u5b8c\u7f8e\u6267\u884c\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u672a\u716e\u719f\uff08\u4f4e\u5206\uff09| \u6070\u5230\u597d\u5904\uff08\u9ad8\u5206\uff09| \u716e\u8fc7\uff08\u5931\u8d25\uff09]\u3002\u638c\u63e1\u65f6\u95f4\u53ef\u4ee5\u5e2e\u52a9\u4f60\u83b7\u5f97\u66f4\u9ad8\u7684\u8bc4\u5206\u5e76\u89e3\u9501\u9ad8\u7ea7\u98df\u8c31\u3002"}, {"question": "\u5a74\u513f\u6cf0\u52d2\u611f\u6069\u8282\u70f9\u996a\u6e38\u620f\u4e2d\u9700\u8981\u54ea\u4e9b\u5fc5\u5907\u5de5\u5177\uff1f", "answer": "\u5728\u5a74\u513f\u6cf0\u52d2\u611f\u6069\u8282\u70f9\u996a\u6e38\u620f\u4e2d\uff0c\u5fc5\u5907\u5de5\u5177\u5305\u62ec\u70e4\u7bb1\u3001\u6405\u62cc\u7897\u548c\u5207\u83dc\u677f\u3002\u4f8b\u5982\uff0c\u70e4\u7bb1\u7528\u4e8e\u70d8\u70e4\u5357\u74dc\u6d3e\u7b49\u83dc\u80b4\uff0c\u800c\u6405\u62cc\u7897\u5bf9\u4e8e\u51c6\u5907\u9762\u56e2\u7b49\u98df\u6750\u81f3\u5173\u91cd\u8981\u3002\u8fd9\u4e9b\u5de5\u5177\u5bf9\u4e8e\u9ad8\u6548\u5b8c\u6210\u98df\u8c31\u81f3\u5173\u91cd\u8981\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u98df\u6750\u2192\u51c6\u5907\uff08\u6405\u62cc\u7897\uff09\u2192\u70f9\u996a\uff08\u70e4\u7bb1\uff09\u2192\u6700\u7ec8\u83dc\u80b4]\u3002\u4e86\u89e3\u5b83\u4eec\u7684\u529f\u7528\u5bf9\u4e8e\u6e38\u620f\u4e2d\u53d6\u5f97\u8fdb\u5c55\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u53ef\u4ee5\u5e2e\u52a9\u9ad8\u7ea7\u73a9\u5bb6\u5728\u5a74\u513f\u6cf0\u52d2\u611f\u6069\u8282\u70f9\u996a\u6e38\u620f\u4e2d\u6700\u5927\u5316\u5f97\u5206\uff1f", "answer": "\u9ad8\u7ea7\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u4e13\u6ce8\u4e8e\u7cbe\u786e\u6027\u548c\u6548\u7387\u6765\u6700\u5927\u5316\u5f97\u5206\u3002\u6b65\u9aa41\uff1a\u8bb0\u4f4f\u98df\u8c31\u6b65\u9aa4\u4ee5\u51cf\u5c11\u51c6\u5907\u65f6\u95f4\u3002\u6b65\u9aa42\uff1a\u8fdb\u884c\u591a\u4efb\u52a1\u5904\u7406\uff0c\u4f8b\u5982\u5728\u70e4\u7bb1\u9884\u70ed\u65f6\u5207\u788e\u852c\u83dc\u3002\u6b65\u9aa43\uff1a\u5b8c\u7f8e\u638c\u63e1\u6bcf\u4e2a\u70f9\u996a\u6b65\u9aa4\u7684\u65f6\u95f4\uff0c\u4ee5\u907f\u514d\u5904\u7f5a\u3002\u4f8b\u5982\uff0c\u5c06\u9985\u997c\u7684\u70d8\u7119\u4e0e\u706b\u9e21\u7684\u70e4\u5236\u540c\u6b65\u53ef\u4ee5\u8282\u7701\u65f6\u95f4\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u5355\u4efb\u52a1\uff08\u4f4e\u5206\uff09\u4e0e\u591a\u4efb\u52a1\uff08\u9ad8\u5206\uff09]\u3002\u8fd9\u4e9b\u7b56\u7565\u53ef\u4ee5\u63d0\u5347\u6e38\u620f\u4f53\u9a8c\u5e76\u89e3\u9501\u9690\u85cf\u6210\u5c31\u3002"}, {"question": "\u5982\u4f55\u5728\u5a74\u513f\u6cf0\u52d2\u611f\u6069\u8282\u70f9\u996a\u6e38\u620f\u4e2d\u89e3\u9501\u9690\u85cf\u98df\u8c31\uff1f", "answer": "\u5a74\u513f\u6cf0\u52d2\u611f\u6069\u8282\u70f9\u996a\u6e38\u620f\u4e2d\u7684\u9690\u85cf\u98df\u8c31\u662f\u901a\u8fc7\u5b8c\u6210\u7279\u5b9a\u6311\u6218\u800c\u89e3\u9501\u7684\u3002\u4f8b\u5982\uff0c\u8fde\u7eed\u4e09\u6b21\u53d6\u5f97\u5b8c\u7f8e\u5206\u6570\u53ef\u80fd\u4f1a\u89e3\u9501\u4e00\u4efd\u79d8\u5bc6\u751c\u70b9\u3002\u6ce8\u610f\u6e38\u620f\u63d0\u793a\uff0c\u5e76\u63a2\u7d22\u4e0d\u540c\u98df\u6750\u7684\u7ec4\u5408\uff0c\u53ef\u4ee5\u53d1\u73b0\u8fd9\u4e9b\u9690\u85cf\u7684\u7f8e\u5473\u4f73\u80b4\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u8fd9\u5c31\u50cf\u89e3\u5f00\u4e00\u9053\u70f9\u996a\u8c1c\u9898\uff0c\u4ee5\u63ed\u793a\u4e00\u4efd\u60ca\u559c\u83dc\u80b4]\u3002\u8fd9\u4e3a\u79ef\u6781\u53c2\u4e0e\u6e38\u620f\u7684\u73a9\u5bb6\u589e\u6dfb\u4e86\u989d\u5916\u7684\u4e50\u8da3\u3002"}, {"question": "\u98df\u6750\u8d28\u91cf\u5728\u5a74\u513f\u6cf0\u52d2\u611f\u6069\u8282\u70f9\u996a\u6e38\u620f\u4e2d\u626e\u6f14\u4ec0\u4e48\u89d2\u8272\uff1f", "answer": "\u98df\u6750\u8d28\u91cf\u76f4\u63a5\u5f71\u54cd\u5a74\u513f\u6cf0\u52d2\u611f\u6069\u8282\u70f9\u996a\u6e38\u620f\u4e2d\u7684\u6700\u7ec8\u83dc\u80b4\u3002\u4f18\u8d28\u98df\u6750\uff0c\u4f8b\u5982\u65b0\u9c9c\u852c\u83dc\uff0c\u53ef\u4ee5\u589e\u5f3a\u83dc\u80b4\u7684\u5473\u9053\u548c\u5916\u89c2\uff0c\u4ece\u800c\u83b7\u5f97\u66f4\u9ad8\u7684\u5206\u6570\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u65b0\u9c9c\u5357\u74dc\u5236\u4f5c\u6d3e\u9985\u6599\u6bd4\u4f7f\u7528\u7f50\u88c5\u5357\u74dc\u7684\u6548\u679c\u66f4\u597d\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u65b0\u9c9c\u98df\u6750\uff08\u9ad8\u5206\uff09| \u5e73\u5747\u98df\u6750\uff08\u4e2d\u7b49\u5206\uff09| \u52a3\u8d28\u98df\u6750\uff08\u4f4e\u5206\uff09]\u3002\u4f18\u5148\u8003\u8651\u4f18\u8d28\u98df\u6750\u53ef\u4ee5\u786e\u4fdd\u6e38\u620f\u4e2d\u6301\u7eed\u83b7\u5f97\u6210\u529f\u3002"}, {"question": "\u5a74\u513f\u6cf0\u52d2\u611f\u6069\u8282\u70f9\u996a\u6e38\u620f\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u5a74\u513f\u6cf0\u52d2\u611f\u6069\u8282\u70f9\u996a\u6e38\u620f\u7684\u8bc4\u5206\u7cfb\u7edf\u8bc4\u4f30\u51c6\u786e\u6027\u3001\u65f6\u95f4\u548c\u98df\u6750\u8d28\u91cf\u3002\u4f8b\u5982\uff0c\u5236\u4f5c\u5b8c\u7f8e\u7684\u706b\u9e21\u9700\u8981\u6b63\u786e\u7684\u8c03\u5473\u3001\u5408\u9002\u7684\u70f9\u996a\u65f6\u95f4\u4ee5\u53ca\u4f7f\u7528\u65b0\u9c9c\u98df\u6750\u3002\u6bcf\u4e2a\u6b65\u9aa4\u90fd\u4f1a\u5355\u72ec\u8bc4\u5206\uff0c\u5e76\u4f1a\u5bf9\u5b8c\u7f8e\u6267\u884c\u7684\u6b65\u9aa4\u7ed9\u4e88\u5956\u52b1\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u51c6\u5907\uff0820%\uff09\u2192\u70f9\u996a\uff0850%\uff09\u2192\u5448\u73b0\uff0830%\uff09\u2192\u603b\u5f97\u5206]\u3002\u4e86\u89e3\u8fd9\u79cd\u5206\u89e3\u53ef\u4ee5\u5e2e\u52a9\u73a9\u5bb6\u4e13\u6ce8\u4e8e\u6539\u8fdb\u7684\u9886\u57df\u3002"}, {"question": "\u5a74\u513f\u6cf0\u52d2\u611f\u6069\u8282\u70f9\u996a\u6e38\u620f\u4e2d\u7684\u6e38\u620f\u8fdb\u5ea6\u53ef\u4ee5\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u8f6c\u79fb\u5417\uff1f", "answer": "\u662f\u7684\uff0c\u901a\u8fc7\u5c06\u6e38\u620f\u8d26\u53f7\u94fe\u63a5\u5230\u793e\u4ea4\u5a92\u4f53\u4e2a\u4eba\u8d44\u6599\u6216\u7535\u5b50\u90ae\u4ef6\uff0c\u5a74\u513f\u6cf0\u52d2\u611f\u6069\u8282\u70f9\u996a\u6e38\u620f\u4e2d\u7684\u6e38\u620f\u8fdb\u5ea6\u53ef\u4ee5\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u8f6c\u79fb\u3002\u8fd9\u786e\u4fdd\u4f60\u7684\u6210\u5c31\u3001\u89e3\u9501\u7684\u98df\u8c31\u548c\u9ad8\u5206\u4f1a\u88ab\u4fdd\u5b58\uff0c\u5e76\u5728\u4efb\u4f55\u517c\u5bb9\u8bbe\u5907\u4e0a\u90fd\u80fd\u8bbf\u95ee\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u8fd9\u5c31\u50cf\u62e5\u6709\u4e00\u4e2a\u968f\u8eab\u643a\u5e26\u7684\u6570\u5b57\u98df\u8c31\uff0c\u65e0\u8bba\u4f60\u8d70\u5230\u54ea\u91cc\u90fd\u80fd\u4f7f\u7528]\u3002\u6b64\u529f\u80fd\u5bf9\u4e8e\u5728\u79fb\u52a8\u8bbe\u5907\u548c\u5e73\u677f\u7535\u8111\u8bbe\u5907\u4e4b\u95f4\u5207\u6362\u7684\u73a9\u5bb6\u5c24\u5176\u6709\u7528\u3002"}, {"question": "\u5a74\u513f\u6cf0\u52d2\u611f\u6069\u8282\u70f9\u996a\u6e38\u620f\u4e2d\u7684\u4f11\u95f2\u6a21\u5f0f\u548c\u4e13\u5bb6\u6a21\u5f0f\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u5a74\u513f\u6cf0\u52d2\u611f\u6069\u8282\u70f9\u996a\u6e38\u620f\u7684\u4f11\u95f2\u6a21\u5f0f\u63d0\u4f9b\u6307\u5bfc\u6b65\u9aa4\u548c\u5bbd\u677e\u7684\u65f6\u95f4\uff0c\u975e\u5e38\u9002\u5408\u521d\u5b66\u8005\u3002\u7136\u800c\uff0c\u4e13\u5bb6\u6a21\u5f0f\u5219\u53d6\u6d88\u4e86\u63d0\u793a\uff0c\u5e76\u5f3a\u5236\u5b9e\u884c\u4e25\u683c\u7684\u65f6\u95f4\u9650\u5236\uff0c\u6311\u6218\u73a9\u5bb6\u4f9d\u9760\u81ea\u5df1\u7684\u6280\u80fd\u3002\u4f8b\u5982\uff0c\u5728\u4e13\u5bb6\u6a21\u5f0f\u4e0b\uff0c\u4f60\u5fc5\u987b\u624b\u52a8\u8bbe\u7f6e\u70e4\u7bb1\u8ba1\u65f6\u5668\uff0c\u800c\u65e0\u9700\u63d0\u793a\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u4f11\u95f2\u6a21\u5f0f\uff08\u6307\u5bfc\uff0c\u7b80\u5355\uff09\u4e0e\u4e13\u5bb6\u6a21\u5f0f\uff08\u65e0\u8f85\u52a9\uff0c\u5177\u6709\u6311\u6218\u6027\uff09]\u3002\u9009\u62e9\u5408\u9002\u7684\u6a21\u5f0f\u53d6\u51b3\u4e8e\u4f60\u7684\u8212\u9002\u5ea6\u548c\u7ecf\u9a8c\u3002"}, {"question": "\u5982\u4f55\u5728\u5a74\u513f\u6cf0\u52d2\u611f\u6069\u8282\u70f9\u996a\u6e38\u620f\u4e2d\u53d1\u73b0\u5f69\u86cb\uff1f", "answer": "\u5a74\u513f\u6cf0\u52d2\u611f\u6069\u8282\u70f9\u996a\u6e38\u620f\u4e2d\u7684\u5f69\u86cb\u662f\u6e38\u620f\u5185\u9690\u85cf\u7684\u4e92\u52a8\u6216\u60ca\u559c\u3002\u4f8b\u5982\uff0c\u591a\u6b21\u70b9\u51fb\u7279\u5b9a\u7684\u53a8\u623f\u88c5\u9970\u53ef\u80fd\u4f1a\u89e6\u53d1\u7279\u6b8a\u52a8\u753b\u6216\u89e3\u9501\u72ec\u7279\u7684\u98df\u6750\u3002\u63a2\u7d22\u53a8\u623f\u7684\u6bcf\u4e2a\u89d2\u843d\uff0c\u5e76\u5c1d\u8bd5\u4e0d\u5bfb\u5e38\u7684\u52a8\u4f5c\uff0c\u53ef\u4ee5\u63ed\u793a\u8fd9\u4e9b\u9690\u85cf\u7684\u5b9d\u85cf\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u8fd9\u5c31\u50cf\u5728\u6df1\u53d7\u6b22\u8fce\u7684\u5bb6\u5ead\u98df\u8c31\u4e2d\u627e\u5230\u79d8\u5bc6\u98df\u6750]\u3002\u8fd9\u4e3a\u559c\u6b22\u5f7b\u5e95\u63a2\u7d22\u6e38\u620f\u7684\u73a9\u5bb6\u589e\u6dfb\u4e86\u4e00\u4efd\u4e50\u8da3\u3002"}]
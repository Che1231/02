[{"question": "\u30d9\u30a4\u30d3\u30fc\u30c6\u30a4\u30eb\u30ba\u611f\u8b1d\u796d\u6599\u7406\u3067\u521d\u5fc3\u8005\u3068\u3057\u3066\u6599\u7406\u3092\u59cb\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d9\u30a4\u30d3\u30fc\u30c6\u30a4\u30eb\u30ba\u611f\u8b1d\u796d\u6599\u7406\u3067\u6599\u7406\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u307e\u305a\u30e1\u30cb\u30e5\u30fc\u304b\u3089\u30ec\u30b7\u30d4\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30ed\u30fc\u30b9\u30c8\u30bf\u30fc\u30ad\u30fc\u300f\u3092\u9078\u3073\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u53f0\u6240\u3067\u98df\u6750\u3092\u30bf\u30c3\u30d7\u3057\u3066\u6750\u6599\u3092\u96c6\u3081\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u753b\u9762\u306e\u6307\u793a\u306b\u5f93\u3063\u3066\u6599\u7406\u306e\u6e96\u5099\u3092\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30bf\u30fc\u30ad\u30fc\u306e\u8abf\u5473\u3092\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30bf\u30a4\u30de\u30fc\u3092\u6b63\u3057\u304f\u8a2d\u5b9a\u3057\u3066\u30aa\u30fc\u30d6\u30f3\u3067\u30bf\u30fc\u30ad\u30fc\u3092\u8abf\u7406\u3057\u307e\u3059\u3002\u3053\u306e\u57fa\u672c\u7684\u306a\u624b\u9806\u3067\u3001\u30b2\u30fc\u30e0\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3067\u304d\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u30a4\u30f3\u30bf\u30e9\u30af\u30c6\u30a3\u30d6\u306a\u624b\u9806\u3067\u30ec\u30b7\u30d4\u30d6\u30c3\u30af\u306b\u5f93\u3046\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002]"}, {"question": "\u30d9\u30a4\u30d3\u30fc\u30c6\u30a4\u30eb\u30ba\u611f\u8b1d\u796d\u6599\u7406\u3067\u3001\u306a\u305c\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u306a\u306e\u3067\u3059\u304b\uff1f", "answer": "\u30d9\u30a4\u30d3\u30fc\u30c6\u30a4\u30eb\u30ba\u611f\u8b1d\u796d\u6599\u7406\u3067\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u306a\u306e\u306f\u3001\u6599\u7406\u306e\u8cea\u306b\u5f71\u97ff\u3059\u308b\u305f\u3081\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30bf\u30fc\u30ad\u30fc\u3092\u713c\u304d\u3059\u304e\u308b\u3068\u3001\u7126\u3052\u4ed8\u304d\u3001\u30b9\u30b3\u30a2\u304c\u6e1b\u5c11\u3057\u307e\u3059\u3002\u9069\u5207\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u306f\u3001\u6e96\u5099\u304b\u3089\u8abf\u7406\u307e\u3067\u3001\u5404\u30b9\u30c6\u30c3\u30d7\u3092\u5b8c\u74a7\u306b\u5b9f\u884c\u3059\u308b\u3053\u3068\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002[\u914d\u7f6e\u5bfe\u7167\u8868\uff1a\u713c\u304d\u4e0d\u8db3\uff08\u4f4e\u5f97\u70b9\uff09\uff5c\u5b8c\u74a7\u306b\u8abf\u7406\uff08\u9ad8\u5f97\u70b9\uff09\uff5c\u713c\u304d\u3059\u304e\uff08\u5931\u6557\uff09]\u3002\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3068\u3001\u3088\u308a\u9ad8\u3044\u8a55\u4fa1\u3092\u5f97\u3066\u3001\u9ad8\u5ea6\u306a\u30ec\u30b7\u30d4\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d9\u30a4\u30d3\u30fc\u30c6\u30a4\u30eb\u30ba\u611f\u8b1d\u796d\u6599\u7406\u306b\u5fc5\u8981\u306a\u5fc5\u9808\u30c4\u30fc\u30eb\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d9\u30a4\u30d3\u30fc\u30c6\u30a4\u30eb\u30ba\u611f\u8b1d\u796d\u6599\u7406\u3067\u5fc5\u8981\u306a\u5fc5\u9808\u30c4\u30fc\u30eb\u306f\u3001\u30aa\u30fc\u30d6\u30f3\u3001\u30dc\u30a6\u30eb\u3001\u307e\u306a\u677f\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30aa\u30fc\u30d6\u30f3\u306f\u30d1\u30f3\u30d7\u30ad\u30f3\u30d1\u30a4\u306a\u3069\u306e\u6599\u7406\u3092\u4f5c\u308b\u306e\u306b\u4f7f\u7528\u3055\u308c\u307e\u3059\u304c\u3001\u30dc\u30a6\u30eb\u306e\u6750\u6599\u3092\u6df7\u305c\u308b\u306e\u306b\u6b20\u304b\u305b\u307e\u305b\u3093\u3002\u3053\u308c\u3089\u306e\u30c4\u30fc\u30eb\u306f\u30ec\u30b7\u30d4\u3092\u52b9\u7387\u7684\u306b\u5b8c\u4e86\u3059\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u98df\u6750\u2192\u6e96\u5099\uff08\u30dc\u30a6\u30eb\u306e\u6df7\u305c\u5408\u308f\u305b\uff09\u2192\u8abf\u7406\uff08\u30aa\u30fc\u30d6\u30f3\uff09\u2192\u5b8c\u6210\u6599\u7406]\u3002\u305d\u306e\u6a5f\u80fd\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u30b2\u30fc\u30e0\u3092\u9032\u3081\u308b\u4e0a\u3067\u91cd\u8981\u3067\u3059\u3002"}, {"question": "\u30d9\u30a4\u30d3\u30fc\u30c6\u30a4\u30eb\u30ba\u611f\u8b1d\u796d\u6599\u7406\u3067\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3059\u308b\u305f\u3081\u306e\u6226\u7565\u306f\uff1f", "answer": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u6b63\u78ba\u3055\u3068\u52b9\u7387\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3053\u3068\u3067\u3001\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6e96\u5099\u6642\u9593\u3092\u77ed\u7e2e\u3059\u308b\u305f\u3081\u306b\u30ec\u30b7\u30d4\u624b\u9806\u3092\u899a\u3048\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30aa\u30fc\u30d6\u30f3\u304c\u4e88\u71b1\u3057\u3066\u3044\u308b\u9593\u306b\u91ce\u83dc\u3092\u523b\u3080\u306a\u3069\u3001\u30de\u30eb\u30c1\u30bf\u30b9\u30af\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30da\u30ca\u30eb\u30c6\u30a3\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u5404\u8abf\u7406\u30b9\u30c6\u30c3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5b8c\u74a7\u306b\u5408\u308f\u305b\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30d1\u30a4\u306e\u713c\u304d\u6642\u9593\u3092\u30bf\u30fc\u30ad\u30fc\u306e\u30ed\u30fc\u30b9\u30c8\u3068\u540c\u671f\u3055\u305b\u308b\u3068\u3001\u6642\u9593\u304c\u7bc0\u7d04\u3067\u304d\u307e\u3059\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u5358\u4e00\u30bf\u30b9\u30af\uff08\u4f4e\u5f97\u70b9\uff09\u5bfe\u30de\u30eb\u30c1\u30bf\u30b9\u30af\uff08\u9ad8\u5f97\u70b9\uff09]\u3002\u3053\u308c\u3089\u306e\u6226\u7565\u306f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5411\u4e0a\u3055\u305b\u3001\u96a0\u3057\u5b9f\u7e3e\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u307e\u3059\u3002"}, {"question": "\u30d9\u30a4\u30d3\u30fc\u30c6\u30a4\u30eb\u30ba\u611f\u8b1d\u796d\u6599\u7406\u3067\u96a0\u3057\u30ec\u30b7\u30d4\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u306b\u306f\uff1f", "answer": "\u30d9\u30a4\u30d3\u30fc\u30c6\u30a4\u30eb\u30ba\u611f\u8b1d\u796d\u6599\u7406\u3067\u96a0\u3057\u30ec\u30b7\u30d4\u306f\u3001\u7279\u5b9a\u306e\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u30013\u3064\u306e\u30ec\u30b7\u30d4\u3067\u9023\u7d9a\u3057\u3066\u5b8c\u74a7\u306a\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u3068\u3001\u79d8\u5bc6\u306e\u30c7\u30b6\u30fc\u30c8\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u308b\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u3002\u30b2\u30fc\u30e0\u5185\u306e\u30d2\u30f3\u30c8\u306b\u6ce8\u610f\u3057\u3001\u3055\u307e\u3056\u307e\u306a\u6750\u6599\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u8a66\u3059\u3053\u3068\u3067\u3001\u3053\u308c\u3089\u306e\u96a0\u3055\u308c\u305f\u5091\u4f5c\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u3088\u304f\u4f7f\u308f\u308c\u308b\u5bb6\u5ead\u306e\u30ec\u30b7\u30d4\u306e\u4e2d\u306b\u3001\u79d8\u5bc6\u306e\u6750\u6599\u3092\u898b\u3064\u3051\u308b\u3088\u3046\u306a\u3082\u306e\u3067\u3059]\u3002\u3053\u308c\u306f\u3001\u71b1\u5fc3\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u305f\u3081\u306b\u3001\u3055\u3089\u306a\u308b\u8208\u596e\u8981\u7d20\u3092\u52a0\u3048\u307e\u3059\u3002"}, {"question": "\u30d9\u30a4\u30d3\u30fc\u30c6\u30a4\u30eb\u30ba\u611f\u8b1d\u796d\u6599\u7406\u3067\u3001\u6750\u6599\u306e\u8cea\u306f\u3069\u306e\u3088\u3046\u306a\u5f79\u5272\u3092\u679c\u305f\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d9\u30a4\u30d3\u30fc\u30c6\u30a4\u30eb\u30ba\u611f\u8b1d\u796d\u6599\u7406\u3067\u6750\u6599\u306e\u8cea\u306f\u3001\u6700\u7d42\u7684\u306a\u6599\u7406\u306b\u76f4\u63a5\u5f71\u97ff\u3057\u307e\u3059\u3002\u65b0\u9bae\u306a\u91ce\u83dc\u306a\u3069\u3001\u9ad8\u54c1\u8cea\u306a\u98df\u6750\u306f\u3001\u6599\u7406\u306e\u5473\u3068\u898b\u305f\u76ee\u3001\u305d\u3057\u3066\u5f97\u70b9\u306b\u3064\u306a\u304c\u308b\u305f\u3081\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30d1\u30a4\u306e\u30d5\u30a3\u30ea\u30f3\u30b0\u306b\u65b0\u9bae\u306a\u30ab\u30dc\u30c1\u30e3\u3092\u4f7f\u3046\u3068\u3001\u7f36\u8a70\u306e\u30ab\u30dc\u30c1\u30e3\u3088\u308a\u3082\u826f\u3044\u7d50\u679c\u304c\u5f97\u3089\u308c\u307e\u3059\u3002[\u914d\u7f6e\u5bfe\u7167\u8868\uff1a\u65b0\u9bae\u306a\u98df\u6750\uff08\u9ad8\u5f97\u70b9\uff09\uff5c\u5e73\u5747\u98df\u6750\uff08\u4e2d\u5f97\u70b9\uff09\uff5c\u52a3\u308b\u98df\u6750\uff08\u4f4e\u5f97\u70b9\uff09]\u3002\u54c1\u8cea\u3092\u91cd\u8996\u3059\u308b\u3053\u3068\u306f\u3001\u30b2\u30fc\u30e0\u3067\u306e\u4e00\u8cab\u3057\u305f\u6210\u529f\u3092\u78ba\u4fdd\u3057\u307e\u3059\u3002"}, {"question": "\u30d9\u30a4\u30d3\u30fc\u30c6\u30a4\u30eb\u30ba\u611f\u8b1d\u796d\u6599\u7406\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d9\u30a4\u30d3\u30fc\u30c6\u30a4\u30eb\u30ba\u611f\u8b1d\u796d\u6599\u7406\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6b63\u78ba\u6027\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3001\u6750\u6599\u306e\u8cea\u3092\u8a55\u4fa1\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5b8c\u74a7\u306a\u30bf\u30fc\u30ad\u30fc\u3092\u4f5c\u308b\u306b\u306f\u3001\u9069\u5207\u306a\u5473\u4ed8\u3051\u3001\u9069\u5207\u306a\u8abf\u7406\u6642\u9593\u3001\u65b0\u9bae\u306a\u6750\u6599\u304c\u5fc5\u8981\u3067\u3059\u3002\u5404\u30b9\u30c6\u30c3\u30d7\u306f\u500b\u5225\u306b\u30b9\u30b3\u30a2\u4ed8\u3051\u3055\u308c\u3001\u5b8c\u74a7\u306a\u5b9f\u884c\u306b\u5bfe\u3057\u3066\u30dc\u30fc\u30ca\u30b9\u304c\u4e0e\u3048\u3089\u308c\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u6e96\u5099\uff0820\uff05\uff09\u2192\u8abf\u7406\uff0850\uff05\uff09\u2192\u30d7\u30ec\u30bc\u30f3\u30c6\u30fc\u30b7\u30e7\u30f3\uff0830\uff05\uff09\u2192\u5408\u8a08\u30b9\u30b3\u30a2]\u3002\u3053\u306e\u5206\u89e3\u3092\u7406\u89e3\u3059\u308b\u3068\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u6539\u5584\u3059\u3079\u304d\u5206\u91ce\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d9\u30a4\u30d3\u30fc\u30c6\u30a4\u30eb\u30ba\u611f\u8b1d\u796d\u6599\u7406\u306e\u9032\u6357\u306f\u3001\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30d9\u30a4\u30d3\u30fc\u30c6\u30a4\u30eb\u30ba\u611f\u8b1d\u796d\u6599\u7406\u306e\u9032\u6357\u306f\u3001\u30b2\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30bd\u30fc\u30b7\u30e3\u30eb\u30e1\u30c7\u30a3\u30a2\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\u307e\u305f\u306f\u30e1\u30fc\u30eb\u30a2\u30c9\u30ec\u30b9\u306b\u30ea\u30f3\u30af\u3059\u308b\u3053\u3068\u3067\u3001\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u8ee2\u9001\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u5b9f\u7e3e\u3001\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u305f\u30ec\u30b7\u30d4\u3001\u9ad8\u5f97\u70b9\u306a\u3069\u304c\u4fdd\u5b58\u3055\u308c\u3001\u4e92\u63db\u6027\u306e\u3042\u308b\u30c7\u30d0\u30a4\u30b9\u3067\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u3069\u3053\u3078\u884c\u304f\u306b\u3082\u3042\u306a\u305f\u3068\u4e00\u7dd2\u306b\u9023\u308c\u3066\u884c\u304f\u30c7\u30b8\u30bf\u30eb\u30af\u30c3\u30ad\u30f3\u30b0\u30d6\u30c3\u30af\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059]\u3002\u3053\u306e\u6a5f\u80fd\u306f\u3001\u30e2\u30d0\u30a4\u30eb\u3068\u30bf\u30d6\u30ec\u30c3\u30c8\u30c7\u30d0\u30a4\u30b9\u306e\u4e21\u65b9\u3092\u4f7f\u7528\u3059\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u7279\u306b\u4fbf\u5229\u3067\u3059\u3002"}, {"question": "\u30d9\u30a4\u30d3\u30fc\u30c6\u30a4\u30eb\u30ba\u611f\u8b1d\u796d\u6599\u7406\u306b\u304a\u3051\u308b\u30ab\u30b8\u30e5\u30a2\u30eb\u30e2\u30fc\u30c9\u3068\u30a8\u30ad\u30b9\u30d1\u30fc\u30c8\u30e2\u30fc\u30c9\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d9\u30a4\u30d3\u30fc\u30c6\u30a4\u30eb\u30ba\u611f\u8b1d\u796d\u6599\u7406\u306e\u30ab\u30b8\u30e5\u30a2\u30eb\u30e2\u30fc\u30c9\u306f\u3001\u30ac\u30a4\u30c9\u4ed8\u304d\u30b9\u30c6\u30c3\u30d7\u3068\u5bdb\u5927\u306a\u6642\u9593\u8a2d\u5b9a\u3092\u63d0\u4f9b\u3059\u308b\u305f\u3081\u3001\u521d\u5fc3\u8005\u306b\u3068\u3063\u3066\u6700\u9069\u3067\u3059\u3002\u4e00\u65b9\u3001\u30a8\u30ad\u30b9\u30d1\u30fc\u30c8\u30e2\u30fc\u30c9\u306f\u30d2\u30f3\u30c8\u3092\u53d6\u308a\u9664\u304d\u3001\u53b3\u683c\u306a\u6642\u9593\u8a2d\u5b9a\u3092\u9069\u7528\u3059\u308b\u305f\u3081\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u81ea\u5206\u306e\u30b9\u30ad\u30eb\u306b\u983c\u3089\u306a\u3051\u308c\u3070\u306a\u308a\u307e\u305b\u3093\u3002\u4f8b\u3048\u3070\u3001\u30a8\u30ad\u30b9\u30d1\u30fc\u30c8\u30e2\u30fc\u30c9\u3067\u306f\u3001\u30d7\u30ed\u30f3\u30d7\u30c8\u306a\u3057\u3067\u30aa\u30fc\u30d6\u30f3\u306e\u30bf\u30a4\u30de\u30fc\u3092\u624b\u52d5\u3067\u8a2d\u5b9a\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u30ab\u30b8\u30e5\u30a2\u30eb\u30e2\u30fc\u30c9\uff08\u30ac\u30a4\u30c9\u4ed8\u304d\u3001\u7c21\u5358\uff09\u5bfe\u30a8\u30ad\u30b9\u30d1\u30fc\u30c8\u30e2\u30fc\u30c9\uff08\u7121\u88dc\u52a9\u3001\u6311\u6226\u7684\uff09]\u3002\u9069\u5207\u306a\u30e2\u30fc\u30c9\u3092\u9078\u3076\u306e\u306f\u3001\u3042\u306a\u305f\u306e\u5feb\u9069\u3055\u30ec\u30d9\u30eb\u3068\u7d4c\u9a13\u306b\u3088\u308b\u3082\u306e\u3067\u3059\u3002"}, {"question": "\u30d9\u30a4\u30d3\u30fc\u30c6\u30a4\u30eb\u30ba\u611f\u8b1d\u796d\u6599\u7406\u3067\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u898b\u3064\u3051\u308b\u65b9\u6cd5\u306f\uff1f", "answer": "\u30d9\u30a4\u30d3\u30fc\u30c6\u30a4\u30eb\u30ba\u611f\u8b1d\u796d\u6599\u7406\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3001\u30b2\u30fc\u30e0\u5185\u306e\u96a0\u308c\u305f\u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3\u3084\u30b5\u30d7\u30e9\u30a4\u30ba\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u7279\u5b9a\u306e\u30ad\u30c3\u30c1\u30f3\u88c5\u98fe\u3092\u8907\u6570\u56de\u30bf\u30c3\u30d7\u3059\u308b\u3068\u3001\u7279\u5225\u306a\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3\u304c\u8868\u793a\u3055\u308c\u305f\u308a\u3001\u30e6\u30cb\u30fc\u30af\u306a\u98df\u6750\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u305f\u308a\u3059\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u53f0\u6240\u306e\u3042\u3089\u3086\u308b\u5834\u6240\u3092\u63a2\u308a\u3001\u73cd\u3057\u3044\u884c\u52d5\u3092\u8a66\u3059\u3053\u3068\u3067\u3001\u3053\u308c\u3089\u306e\u96a0\u3055\u308c\u305f\u5b9d\u7269\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u611b\u3055\u308c\u3066\u3044\u308b\u5bb6\u65cf\u306e\u30ec\u30b7\u30d4\u306e\u4e2d\u306b\u3001\u79d8\u5bc6\u306e\u98df\u6750\u3092\u898b\u3064\u3051\u308b\u3088\u3046\u306a\u3082\u306e\u3067\u3059]\u3002\u3053\u308c\u306f\u3001\u5fb9\u5e95\u7684\u306a\u63a2\u6c42\u3092\u697d\u3057\u3080\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u305f\u3081\u306b\u3001\u697d\u3057\u3044\u8981\u7d20\u3092\u52a0\u3048\u307e\u3059\u3002"}]
[{"question": "\ubca0\uc774\ube44 \ud14c\uc77c\ub7ec \ub561\uc2a4\uae30\ube59 \ucfe0\ud0b9 \ucd08\ubcf4\uc790\uac00 \uc694\ub9ac \uc2dc\uc791\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ubca0\uc774\ube44 \ud14c\uc77c\ub7ec \ub561\uc2a4\uae30\ube59 \ucfe0\ud0b9\uc5d0\uc11c \uc694\ub9ac\ub97c \uc2dc\uc791\ud558\ub824\uba74 \uba3c\uc800 \uba54\ub274\uc5d0\uc11c \ub808\uc2dc\ud53c\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uad6c\uc6b4 \uce60\uba74\uc870'\ub97c \uc120\ud0dd\ud558\uc138\uc694. STEP1: \ubd80\uc5cc\uc5d0\uc11c \uc7ac\ub8cc\ub97c \ud0ed\ud558\uc5ec \uc7ac\ub8cc\ub97c \ubaa8\uc73c\uc138\uc694. STEP2: \ud654\uba74\uc758 \uc9c0\uce68\uc744 \ub530\ub77c \uc694\ub9ac\ub97c \uc900\ube44\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uce60\uba74\uc870\uc5d0 \uc591\ub150\uc744 \ud558\ub294 \uac83\uc785\ub2c8\ub2e4. STEP3: \ud0c0\uc774\uba38\ub97c \uc815\ud655\ud788 \uc124\uc815\ud558\uc5ec \uc624\ube10\uc73c\ub85c \uce60\uba74\uc870\ub97c \uad7d\uc2b5\ub2c8\ub2e4. \uc774 \uae30\ubcf8\uc801\uc778 \uacfc\uc815\uc740 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc744 \uc18c\uac1c\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc0c1\ud638 \uc791\uc6a9\ud558\ub294 \ub2e8\uacc4\uac00 \uc788\ub294 \uc694\ub9ac\ucc45\uc744 \ub530\ub974\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ubca0\uc774\ube44 \ud14c\uc77c\ub7ec \ub561\uc2a4\uae30\ube59 \ucfe0\ud0b9\uc5d0\uc11c \uc2dc\uac04\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ubca0\uc774\ube44 \ud14c\uc77c\ub7ec \ub561\uc2a4\uae30\ube59 \ucfe0\ud0b9\uc5d0\uc11c \uc2dc\uac04\uc740 \uc694\ub9ac\uc758 \ud488\uc9c8\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uce60\uba74\uc870\ub97c \ub108\ubb34 \uc624\ub798 \uad7d\uc73c\uba74 \ud0c0\uc11c \uc810\uc218\uac00 \uac10\uc18c\ud569\ub2c8\ub2e4. \uc801\uc808\ud55c \uc2dc\uac04\uc740 \uc900\ube44\ubd80\ud130 \uc694\ub9ac\uae4c\uc9c0 \uac01 \ub2e8\uacc4\ub97c \uc644\ubcbd\ud558\uac8c \uc218\ud589\ud558\ub294 \uac83\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50 \ud45c: \ub35c \uc775\ud78c(\ub0ae\uc740 \uc810\uc218) | \uc644\ubcbd\ud558\uac8c \uc775\ud78c(\ub192\uc740 \uc810\uc218) | \ub108\ubb34 \uc775\ud78c(\uc2e4\ud328)]. \uc2dc\uac04\uc744 \uc798 \uc870\uc808\ud558\uba74 \ub354 \ub192\uc740 \ub4f1\uae09\uc744 \ubc1b\uace0 \uace0\uae09 \ub808\uc2dc\ud53c\ub97c \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ubca0\uc774\ube44 \ud14c\uc77c\ub7ec \ub561\uc2a4\uae30\ube59 \ucfe0\ud0b9\uc5d0\uc11c \ud544\uc694\ud55c \ud544\uc218 \ub3c4\uad6c\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ubca0\uc774\ube44 \ud14c\uc77c\ub7ec \ub561\uc2a4\uae30\ube59 \ucfe0\ud0b9\uc5d0\uc11c \ud544\uc218 \ub3c4\uad6c\ub294 \uc624\ube10, \ubbf9\uc2f1 \ubcfc, \uce7c\uc9d1\ub3c4\ub9c8\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc624\ube10\uc740 \ud638\ubc15 \ud30c\uc774\uc640 \uac19\uc774 \uc694\ub9ac\ub97c \uad6c\uc6b8 \ub54c \uc0ac\uc6a9\ub418\uace0, \ubbf9\uc2f1 \ubcfc\uc740 \ubc18\uc8fd\uacfc \uac19\uc740 \uc7ac\ub8cc\ub97c \uc900\ube44\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ub3c4\uad6c\ub294 \ub808\uc2dc\ud53c\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uc644\ub8cc\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc7ac\ub8cc \u2192 \uc900\ube44(\ubbf9\uc2f1 \ubcfc) \u2192 \uc694\ub9ac(\uc624\ube10) \u2192 \ucd5c\uc885 \uc694\ub9ac]. \uae30\ub2a5\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \uac8c\uc784\uc5d0\uc11c \uc9c4\ud589\ud558\ub294 \ub370 \uc911\uc694\ud569\ub2c8\ub2e4."}, {"question": "\ubca0\uc774\ube44 \ud14c\uc77c\ub7ec \ub561\uc2a4\uae30\ube59 \ucfe0\ud0b9\uc5d0\uc11c \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uac00 \uc810\uc218\ub97c \uadf9\ub300\ud654\ud560 \uc218 \uc788\ub294 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \uc815\ud655\uc131\uacfc \ud6a8\uc728\uc131\uc5d0 \uc9d1\uc911\ud558\uc5ec \uc810\uc218\ub97c \uadf9\ub300\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \uc900\ube44 \uc2dc\uac04\uc744 \uc904\uc774\uae30 \uc704\ud574 \ub808\uc2dc\ud53c \ub2e8\uacc4\ub97c \uc219\ub2ec\ud558\uc138\uc694. STEP2: \uc624\ube10\uc774 \uc608\uc5f4\ub418\ub294 \ub3d9\uc548 \ucc44\uc18c\ub97c \ub2e4\ub4ec\ub294 \uac83\uacfc \uac19\uc774 \uba40\ud2f0\ud0dc\uc2a4\ud0b9\uc744 \ud65c\uc6a9\ud558\uc138\uc694. STEP3: \ud398\ub110\ud2f0\ub97c \ud53c\ud558\uae30 \uc704\ud574 \uac01 \uc694\ub9ac \ub2e8\uacc4\uc758 \uc2dc\uac04\uc744 \uc644\ubcbd\ud558\uac8c \ub9de\ucd94\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud30c\uc774\uc758 \uad6c\uc6c0\uacfc \uce60\uba74\uc870\uc758 \uad6c\uc774\ub97c \ub3d9\uc2dc\uc5d0 \ud558\uba74 \uc2dc\uac04\uc744 \uc808\uc57d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc5ec\ub7ec \uac00\uc9c0 \ubc29\ubc95 \ube44\uad50: \ub2e8\uc77c \uc791\uc5c5(\ub0ae\uc740 \uc810\uc218) \ub300 \uba40\ud2f0\ud0dc\uc2a4\ud0b9(\ub192\uc740 \uc810\uc218)]. \uc774\ub7ec\ud55c \uc804\ub7b5\uc740 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\uace0 \uc228\uaca8\uc9c4 \uc5c5\uc801\uc744 \ud574\uc81c\ud569\ub2c8\ub2e4."}, {"question": "\ubca0\uc774\ube44 \ud14c\uc77c\ub7ec \ub561\uc2a4\uae30\ube59 \ucfe0\ud0b9\uc5d0\uc11c \uc228\uaca8\uc9c4 \ub808\uc2dc\ud53c\ub97c \uc5b4\ub5bb\uac8c \ud574\uc81c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ubca0\uc774\ube44 \ud14c\uc77c\ub7ec \ub561\uc2a4\uae30\ube59 \ucfe0\ud0b9\uc5d0\uc11c \uc228\uaca8\uc9c4 \ub808\uc2dc\ud53c\ub294 \ud2b9\uc815 \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\uba74 \ud574\uc81c\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5f0\uc18d 3\ubc88 \ub808\uc2dc\ud53c\uc5d0\uc11c \uc644\ubcbd\ud55c \uc810\uc218\ub97c \uc5bb\uc73c\uba74 \ube44\ubc00 \ub514\uc800\ud2b8\uac00 \ud574\uc81c\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784 \ub0b4 \ud78c\ud2b8\uc5d0 \uc8fc\uc758\ud558\uace0 \uc7ac\ub8cc\uc758 \ub2e4\uc591\ud55c \uc870\ud569\uc744 \uc2dc\ub3c4\ud558\uc5ec \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uc744 \ubc1c\uacac\ud558\uc2ed\uc2dc\uc624. [\ube44\uc720 \uc124\uba85: \uc0ac\ub791\ubc1b\ub294 \uac00\uc871 \ub808\uc2dc\ud53c\uc5d0\uc11c \ube44\ubc00 \uc7ac\ub8cc\ub97c \ucc3e\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4]. \uc774\ub294 \uc5f4\uc815\uc801\uc778 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \ub610 \ub2e4\ub978 \uc7ac\ubbf8 \uc694\uc18c\ub97c \ucd94\uac00\ud569\ub2c8\ub2e4."}, {"question": "\ubca0\uc774\ube44 \ud14c\uc77c\ub7ec \ub561\uc2a4\uae30\ube59 \ucfe0\ud0b9\uc5d0\uc11c \uc7ac\ub8cc \ud488\uc9c8\uc758 \uc5ed\ud560\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ubca0\uc774\ube44 \ud14c\uc77c\ub7ec \ub561\uc2a4\uae30\ube59 \ucfe0\ud0b9\uc5d0\uc11c \uc7ac\ub8cc \ud488\uc9c8\uc740 \ucd5c\uc885 \uc694\ub9ac\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc2e0\uc120\ud55c \ucc44\uc18c\uc640 \uac19\uc740 \uace0\ud488\uc9c8 \uc7ac\ub8cc\ub294 \uc694\ub9ac\uc758 \ub9db\uacfc \uc678\uad00\uc744 \ud5a5\uc0c1\uc2dc\ucf1c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uac8c \ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud30c\uc774 \ud544\ub9c1\uc5d0 \uc2e0\uc120\ud55c \ud638\ubc15\uc744 \uc0ac\uc6a9\ud558\uba74 \ud1b5\uc870\ub9bc \ud638\ubc15\ubcf4\ub2e4 \ub354 \ub098\uc740 \uacb0\uacfc\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50 \ud45c: \uc2e0\uc120\ud55c \uc7ac\ub8cc(\ub192\uc740 \uc810\uc218) | \ud3c9\uade0\uc801\uc778 \uc7ac\ub8cc(\uc911\uac04 \uc810\uc218) | \ud488\uc9c8\uc774 \ub0ae\uc740 \uc7ac\ub8cc(\ub0ae\uc740 \uc810\uc218)]. \ud488\uc9c8\uc744 \uc6b0\uc120\uc2dc\ud558\uba74 \uac8c\uc784\uc5d0\uc11c \uc9c0\uc18d\uc801\uc778 \uc131\uacf5\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "\ubca0\uc774\ube44 \ud14c\uc77c\ub7ec \ub561\uc2a4\uae30\ube59 \ucfe0\ud0b9\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "\ubca0\uc774\ube44 \ud14c\uc77c\ub7ec \ub561\uc2a4\uae30\ube59 \ucfe0\ud0b9\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc815\ud655\uc131, \uc2dc\uac04 \ubc0f \uc7ac\ub8cc \ud488\uc9c8\uc744 \ud3c9\uac00\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc644\ubcbd\ud55c \uce60\uba74\uc870\ub97c \ub9cc\ub4dc\ub294 \uac83\uc740 \uc801\uc808\ud55c \uc591\ub150, \uc801\uc808\ud55c \uc870\ub9ac \uc2dc\uac04, \uc2e0\uc120\ud55c \uc7ac\ub8cc\ub97c \uc0ac\uc6a9\ud558\ub294 \uac83\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \uac01 \ub2e8\uacc4\ub294 \uac1c\ubcc4\uc801\uc73c\ub85c \uc810\uc218\uac00 \ub9e4\uaca8\uc9c0\uace0, \uc644\ubcbd\ud55c \uc2e4\ud589\uc5d0\ub294 \ubcf4\ub108\uc2a4\uac00 \ubd80\uc5ec\ub429\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc900\ube44(20%) \u2192 \uc694\ub9ac(50%) \u2192 \uc81c\uc2dc(30%) \u2192 \ucd1d \uc810\uc218]. \uc774\ub7ec\ud55c \ubd84\ub958\ub97c \uc774\ud574\ud558\uba74 \ud50c\ub808\uc774\uc5b4\uac00 \uac1c\uc120\ud560 \ubd80\ubd84\uc5d0 \uc9d1\uc911\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\ubca0\uc774\ube44 \ud14c\uc77c\ub7ec \ub561\uc2a4\uae30\ube59 \ucfe0\ud0b9\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc774 \uc5ec\ub7ec \uae30\uae30\uc5d0\uc11c \uc774\uc804\ub420 \uc218 \uc788\ub098\uc694?", "answer": "\ub124, \ubca0\uc774\ube44 \ud14c\uc77c\ub7ec \ub561\uc2a4\uae30\ube59 \ucfe0\ud0b9\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc740 \uac8c\uc784 \uacc4\uc815\uc744 \uc18c\uc15c \ubbf8\ub514\uc5b4 \ud504\ub85c\ud544 \ub610\ub294 \uc774\uba54\uc77c\ub85c \uc5f0\uacb0\ud558\uc5ec \uc5ec\ub7ec \uae30\uae30\uc5d0\uc11c \uc774\uc804\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub807\uac8c \ud558\uba74 \uc131\ucde8\ub3c4, \ud574\uc81c\ub41c \ub808\uc2dc\ud53c \ubc0f \ub192\uc740 \uc810\uc218\uac00 \uc800\uc7a5\ub418\uace0 \ud638\ud658 \uac00\ub2a5\ud55c \ubaa8\ub4e0 \uae30\uae30\uc5d0\uc11c \uc561\uc138\uc2a4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc5b4\ub514\ub97c \uac00\ub4e0 \ub2f9\uc2e0\uc758 \ud734\ub300\uc6a9 \uc694\ub9ac\ucc45\uc744 \uac00\uc9c0\uace0 \ub2e4\ub2c8\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4]. \uc774 \uae30\ub2a5\uc740 \ubaa8\ubc14\uc77c \ubc0f \ud0dc\ube14\ub9bf \uae30\uae30 \uac04\uc744 \uc804\ud658\ud558\ub294 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ud2b9\ud788 \uc720\uc6a9\ud569\ub2c8\ub2e4."}, {"question": "\ubca0\uc774\ube44 \ud14c\uc77c\ub7ec \ub561\uc2a4\uae30\ube59 \ucfe0\ud0b9\uc758 \uce90\uc8fc\uc5bc \ubaa8\ub4dc\uc640 \uc804\ubb38\uac00 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ubca0\uc774\ube44 \ud14c\uc77c\ub7ec \ub561\uc2a4\uae30\ube59 \ucfe0\ud0b9\uc758 \uce90\uc8fc\uc5bc \ubaa8\ub4dc\ub294 \uc548\ub0b4 \ub2e8\uacc4\uc640 \uad00\ub300\ud558\uac8c \uc124\uc815\ub41c \uc2dc\uac04\uc744 \uc81c\uacf5\ud558\uc5ec \ucd08\ubcf4\uc790\uc5d0\uac8c \uc801\ud569\ud569\ub2c8\ub2e4. \ubc18\uba74 \uc804\ubb38\uac00 \ubaa8\ub4dc\ub294 \ud78c\ud2b8\uac00 \uc81c\uac70\ub418\uace0 \uc5c4\uaca9\ud55c \uc2dc\uac04 \uc81c\ud55c\uc744 \uc801\uc6a9\ud558\uc5ec \ud50c\ub808\uc774\uc5b4\uac00 \uc790\uc2e0\uc758 \uae30\uc220\uc5d0 \uc758\uc874\ud558\ub3c4\ub85d \ub3c4\uc804\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc804\ubb38\uac00 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \ud504\ub86c\ud504\ud2b8 \uc5c6\uc774 \uc624\ube10 \ud0c0\uc774\uba38\ub97c \uc218\ub3d9\uc73c\ub85c \uc124\uc815\ud574\uc57c \ud569\ub2c8\ub2e4. [\uc5ec\ub7ec \uac00\uc9c0 \ubc29\ubc95 \ube44\uad50: \uce90\uc8fc\uc5bc \ubaa8\ub4dc(\uc548\ub0b4, \uc26c\uc6c0) \ub300 \uc804\ubb38\uac00 \ubaa8\ub4dc(\ubb34\ubcf4\uc870, \uc5b4\ub824\uc6c0)]. \uc62c\ubc14\ub978 \ubaa8\ub4dc\ub294 \uc790\uc2e0\uc758 \uc218\uc900\uacfc \uacbd\ud5d8\uc5d0 \ub530\ub77c \uc120\ud0dd\ub429\ub2c8\ub2e4."}, {"question": "\ubca0\uc774\ube44 \ud14c\uc77c\ub7ec \ub561\uc2a4\uae30\ube59 \ucfe0\ud0b9\uc5d0\uc11c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ucc3e\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ubca0\uc774\ube44 \ud14c\uc77c\ub7ec \ub561\uc2a4\uae30\ube59 \ucfe0\ud0b9\uc5d0\uc11c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uac8c\uc784 \ub0b4\uc5d0 \uc228\uaca8\uc9c4 \uc0c1\ud638 \uc791\uc6a9\uc774\ub098 \ub180\ub77c\uc6c0\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud2b9\uc815 \ubd80\uc5cc \uc7a5\uc2dd\uc744 \uc5ec\ub7ec \ubc88 \ud0ed\ud558\uba74 \ud2b9\ubcc4\ud55c \uc560\ub2c8\uba54\uc774\uc158\uc774 \uc2e4\ud589\ub418\uac70\ub098 \ub3c5\ud2b9\ud55c \uc7ac\ub8cc\uac00 \ud574\uc81c\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubd80\uc5cc \uad6c\uc11d\uad6c\uc11d\uc744 \ud0d0\ud5d8\ud558\uace0 \ud2b9\uc774\ud55c \ub3d9\uc791\uc744 \uc2dc\ub3c4\ud558\uba74 \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uc744 \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc0ac\ub791\ubc1b\ub294 \uac00\uc871 \ub808\uc2dc\ud53c\uc5d0\uc11c \ube44\ubc00 \uc7ac\ub8cc\ub97c \ucc3e\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4]. \uc774\ub294 \ucca0\uc800\ud55c \ud0d0\ud5d8\uc744 \uc88b\uc544\ud558\ub294 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \uc7ac\ubbf8 \uc694\uc18c\ub97c \ucd94\uac00\ud569\ub2c8\ub2e4."}]
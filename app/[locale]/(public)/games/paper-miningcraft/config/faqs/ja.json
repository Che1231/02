[{"question": "\u30da\u30fc\u30d1\u30fc\u30af\u30e9\u30d5\u30c8\u30de\u30a4\u30f3\u30af\u30e9\u30d5\u30c8\uff1a\u59cb\u3081\u305f\u3070\u304b\u308a\u306e\u3068\u304d\u306b\u57fa\u672c\u7684\u306a\u30c4\u30fc\u30eb\u3092\u3069\u306e\u3088\u3046\u306b\u4f5c\u6210\u3057\u3001\u6700\u521d\u306e\u52b9\u7387\u7684\u306a\u7d20\u6750\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30da\u30fc\u30d1\u30fc\u30af\u30e9\u30d5\u30c8\u30de\u30a4\u30f3\u30af\u30e9\u30d5\u30c8\u306e\u65b0\u53c2\u8005\u306b\u3068\u3063\u3066\u3001\u307e\u305a\u6728\u88fd\u306e\u30c4\u30fc\u30eb\u3092\u4f5c\u6210\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002\u624b\u98061\uff1a\u6728\u3092\u53e9\u3044\u3066\u6728\u7247\u3092\u5f97\u308b\u3002\u624b\u98062\uff1a\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u30af\u30e9\u30d5\u30c8\u30b0\u30ea\u30c3\u30c9\u3092\u4f7f\u3063\u3066\u6728\u7247\u3092\u677f\u306b\u5909\u63db\u3059\u308b\u3002\u624b\u98063\uff1a\u30af\u30e9\u30d5\u30c8\u30c6\u30fc\u30d6\u30eb\u3001\u6b21\u306b\u68d2\u3001\u305d\u3057\u3066\u6700\u5f8c\u306b\u30c4\u30fc\u30eb\u3092\u4f5c\u6210\u3059\u308b\u3002\u6700\u521d\u306f\u6728\u3067\u5341\u5206\u3067\u3059\u3002\u7279\u306b\u3001\u6728\u88fd\u306e\u30d4\u30c3\u30b1\u30eb\u3092\u4f5c\u6210\u3059\u308b\u3068\u3001\u9271\u77f3\u3092\u63a1\u6398\u3067\u304d\u308b\u305f\u3081\u3001\u8010\u4e45\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u6728\u306e\u30c4\u30fc\u30eb\u3092\u3001\u77f3\u306e\u30c4\u30fc\u30eb\u3068\u3044\u3046\u3088\u308a\u5b89\u5b9a\u3057\u305f\u81ea\u8ee2\u8eca\u306b\u79fb\u308b\u307e\u3067\u306e\u7df4\u7fd2\u7528\u30db\u30a4\u30fc\u30eb\u3068\u8003\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30da\u30fc\u30d1\u30fc\u30af\u30e9\u30d5\u30c8\u30de\u30a4\u30f3\u30af\u30e9\u30d5\u30c8\u306e\u98e2\u9913\u30b7\u30b9\u30c6\u30e0\u306e\u4ed5\u7d44\u307f\u306f\u4f55\u3067\u3059\u304b\uff1f\u306a\u305c\u79c1\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306f\u5e38\u306b\u7a7a\u8179\u3092\u611f\u3058\u308b\u306e\u3060\u308d\u3046\u304b\uff1f\u521d\u671f\u6bb5\u968e\u3067\u98e2\u3048\u6b7b\u3092\u56de\u907f\u3059\u308b\u305f\u3081\u306b\u3001\u3069\u306e\u3088\u3046\u306b\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30da\u30fc\u30d1\u30fc\u30af\u30e9\u30d5\u30c8\u30de\u30a4\u30f3\u30af\u30e9\u30d5\u30c8\u3067\u306f\u3001\u63a1\u6398\u306a\u3069\u306e\u884c\u52d5\u3092\u884c\u3046\u3068\u7a7a\u8179\u30b2\u30fc\u30b8\u304c\u6e1b\u5c11\u3057\u307e\u3059\u3002\u7a7a\u306b\u306a\u308b\u3068\u3001\u4f53\u529b\u3082\u4f4e\u4e0b\u3057\u307e\u3059\u3002\u521d\u671f\u6bb5\u968e\u3067\u306f\u3001\u5358\u7d14\u306a\u98df\u6599\u6e90\u306b\u96c6\u4e2d\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u624b\u98061\uff1a\u9d8f\u3084\u8c5a\u306a\u3069\u306e\u5165\u624b\u53ef\u80fd\u306a\u52d5\u7269\u3092\u72e9\u3063\u3066\u8089\u3092\u5f97\u308b\u3002\u624b\u98062\uff1a\u6eb6\u9271\u7089\u3092\u4f5c\u6210\u3057\u3066\u8089\u3092\u8abf\u7406\u3059\u308b\u3002\u8abf\u7406\u6e08\u307f\u306e\u8089\u306f\u6e80\u8179\u611f\uff08\u7a7a\u8179\u30b2\u30fc\u30b8\u304c\u6e80\u30bf\u30f3\u306b\u306a\u308b\u307e\u3067\u306e\u6642\u9593\uff09\u304c\u9577\u304f\u306a\u308a\u307e\u3059\u3002\u624b\u98063\uff1a\u30d9\u30ea\u30fc\u3092\u63a2\u3057\u307e\u3059\u3002\u521d\u671f\u306e\u30b2\u30fc\u30e0\u6226\u7565\u3068\u3057\u3066\u3001\u5e38\u306b\u8abf\u7406\u6e08\u307f\u306e\u8089\u3092\u6301\u3061\u6b69\u304d\u3001\u7a7a\u8179\u3092\u611f\u3058\u305f\u3089\u98df\u3079\u308b\u3088\u3046\u306b\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u73fe\u5b9f\u4e16\u754c\u3068\u540c\u3058\u3088\u3046\u306b\u3001\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u5b9a\u671f\u7684\u306b\u98df\u3079\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30da\u30fc\u30d1\u30fc\u30af\u30e9\u30d5\u30c8\u30de\u30a4\u30f3\u30af\u30e9\u30d5\u30c8\uff1a\u7570\u306a\u308b\u30d0\u30a4\u30aa\u30fc\u30e0\u306f\u4f55\u304b\u3001\u305d\u3057\u3066\u305d\u308c\u3089\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u521d\u671f\u30b2\u30fc\u30e0\u3067\u3069\u306e\u3088\u3046\u306a\u30e1\u30ea\u30c3\u30c8\u304c\u3042\u308b\u304b\uff1f\u305d\u308c\u305e\u308c\u306e\u30d0\u30a4\u30aa\u30fc\u30e0\u306b\u56fa\u6709\u306e\u8cc7\u6e90\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30da\u30fc\u30d1\u30fc\u30af\u30e9\u30d5\u30c8\u30de\u30a4\u30f3\u30af\u30e9\u30d5\u30c8\u3067\u306f\u3001\u68ee\u6797\u3001\u7802\u6f20\u3001\u96ea\u539f\u306a\u3069\u306e\u591a\u69d8\u306a\u30d0\u30a4\u30aa\u30fc\u30e0\u304c\u7279\u5fb4\u3067\u3059\u3002\u305d\u308c\u305e\u308c\u306b\u56fa\u6709\u306e\u8cc7\u6e90\u304c\u3042\u308a\u307e\u3059\u3002\u68ee\u6797\u306f\u6728\u6750\u304c\u8c4a\u5bcc\u3067\u3001\u7802\u6f20\u3067\u306f\u30b5\u30dc\u30c6\u30f3\uff08\u7dd1\u8272\u306e\u67d3\u6599\u306b\u4f7f\u3048\u307e\u3059\uff09\u304c\u3001\u96ea\u539f\u3067\u306f\u6c37\u304c\u624b\u306b\u5165\u308a\u307e\u3059\u3002\u624b\u98061\uff1a\u5468\u56f2\u306e\u30d0\u30a4\u30aa\u30fc\u30e0\u3092\u5730\u56f3\u4e0a\u306b\u8a18\u8f09\u3059\u308b\u3002\u624b\u98062\uff1a\u7802\u6f20\u306e\u30d0\u30a4\u30aa\u30fc\u30e0\u3067\u306f\u6c34\u8fba\u306b\u30b5\u30c8\u30a6\u30ad\u30d3\u304c\u898b\u3064\u304b\u308b\u306a\u3069\u3001\u5229\u7528\u53ef\u80fd\u306a\u8cc7\u6e90\u306b\u6ce8\u610f\u3059\u308b\u3002\u624b\u98063\uff1a\u5fc5\u8981\u306a\u8cc7\u6e90\u306e\u3042\u308b\u30d0\u30a4\u30aa\u30fc\u30e0\u306e\u8fd1\u304f\u306b\u57fa\u76e4\u3092\u8a2d\u3051\u308b\u3002\u6728\u6750\u3068\u98df\u6599\u3078\u306e\u5bb9\u6613\u306a\u30a2\u30af\u30bb\u30b9\u306e\u305f\u3081\u306b\u3001\u68ee\u6797\u3068\u5e73\u539f\u306e\u8fd1\u304f\u306b\u57fa\u5730\u3092\u7f6e\u304f\u3053\u3068\u3092\u8003\u3048\u308b\u3002\u30d0\u30a4\u30aa\u30fc\u30e0\u3092\u30b7\u30e7\u30c3\u30d4\u30f3\u30b0\u30bb\u30f3\u30bf\u30fc\u5185\u306e\u7570\u306a\u308b\u5e97\u8217\u3068\u8003\u3048\u3001\u305d\u308c\u305e\u308c\u306b\u7279\u5b9a\u306e\u88fd\u54c1\u3092\u5c02\u9580\u3068\u3057\u3066\u3044\u308b\u3068\u898b\u306a\u3059\u3053\u3068\u304c\u3067\u304d\u308b\u3002"}, {"question": "\u7d4c\u9a13\u8c4a\u5bcc\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u305f\u3081\u306e\uff1aPaperMC\uff1a\u7d99\u7d9a\u7684\u306a\u8cc7\u6e90\u3068\u7d4c\u9a13\u5024\u3092\u5f97\u308b\u305f\u3081\u306e\u52b9\u7387\u7684\u306a\u30e2\u30d6\u8fb2\u5834\u3092\u3069\u306e\u3088\u3046\u306b\u8a2d\u5b9a\u3057\u3001\u3069\u306e\u8fb2\u5834\u306e\u8a2d\u8a08\u304c\u6700\u3082\u30b9\u30b1\u30fc\u30e9\u30d6\u30eb\u3067\u3059\u304b\uff1f", "answer": "\u30e2\u30d6\u8fb2\u5834\u3092\u69cb\u7bc9\u3059\u308b\u3053\u3068\u306f\u3001\u8cc7\u6e90\u53ce\u96c6\u3068\u7d4c\u9a13\u5024\u7372\u5f97\u306b\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u30b7\u30f3\u30d7\u30eb\u3067\u6697\u3044\u90e8\u5c4b\u306e\u30c7\u30b6\u30a4\u30f3\u304c\u6700\u9069\u306a\u30b9\u30bf\u30fc\u30c8\u3067\u3059\u3002\u624b\u98061\uff1a\u6697\u304f\u3066\u5149\u304b\u3089\u9694\u96e2\u3055\u308c\u305f\u5834\u6240\u3092\u898b\u3064\u3051\u308b\u3001\u307e\u305f\u306f\u5efa\u7269\u3092\u4f5c\u308b\u3002\u624b\u98062\uff1a\u5185\u90e8\u306b\u5927\u304d\u306a\u5e73\u3089\u306a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u4f5c\u308b\u3002\u624b\u98063\uff1a\u30e2\u30d6\u3092\u4e2d\u592e\u306e\u843d\u4e0b\u70b9\u306b\u62bc\u3057\u8fbc\u3080\u305f\u3081\u306e\u6c34\u6d41\u3092\u8ffd\u52a0\u3059\u308b\u3002\u843d\u4e0b\u9ad8\u3055\u306b\u3088\u308a\u81f4\u547d\u7684\u306a\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u3001\u308f\u305a\u304b\u306b\u6b8b\u3063\u305f\u30e2\u30d6\u306f\u5263\u3067\u5012\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u6697\u3044\u90e8\u5c4b\u306e\u30c7\u30b6\u30a4\u30f3\u306f\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u62e1\u5f35\u3059\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u30b9\u30b1\u30fc\u30eb\u30a2\u30c3\u30d7\u53ef\u80fd\u3067\u3059\u3002\u8fb2\u5834\u306e\u5468\u308a\u306b\u305f\u3044\u307e\u3064\u3092\u8a2d\u7f6e\u3059\u308b\u3068\u3001\u30e2\u30d6\u306e\u51fa\u73fe\u306f\u6e1b\u5c11\u3057\u307e\u3059\u3002"}, {"question": "\u30da\u30fc\u30d1\u30fc\u30af\u30e9\u30d5\u30c8\u30de\u30a4\u30f3\u30af\u30e9\u30d5\u30c8\uff1a\u30a8\u30f3\u30c0\u30fc\u30c9\u30e9\u30b4\u30f3\u3092\u5012\u3059\u305f\u3081\u306e\u6700\u3082\u52b9\u679c\u7684\u306a\u6226\u7565\u3068\u3001\u6210\u529f\u7387\u3092\u9ad8\u3081\u308b\u305f\u3081\u306b\u512a\u5148\u3059\u3079\u304d\u88c5\u5099\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30a8\u30f3\u30c0\u30fc\u30c9\u30e9\u30b4\u30f3\u3092\u5012\u3059\u306b\u306f\u3001\u7dbf\u5bc6\u306a\u6e96\u5099\u304c\u5fc5\u8981\u3067\u3059\u3002\u624b\u98061\uff1a\u30c0\u30a4\u30e4\u30e2\u30f3\u30c9\u30a2\u30fc\u30de\u30fc\u3068\u3001\u5f37\u529b\u306a\u30a8\u30f3\u30c1\u30e3\u30f3\u30c8\u3055\u308c\u305f\uff08\u4f8b\u3048\u3070\u3001\u653b\u6483\u529b\u3068\u7121\u9650\uff09\u5f13\u3092\u53d6\u5f97\u3059\u308b\u3002\u624b\u98062\uff1a\u6f5c\u5728\u7684\u306a\u30c8\u30e9\u30d6\u30eb\u306b\u5099\u3048\u3066\u3001\u56de\u5fa9\u30dd\u30fc\u30b7\u30e7\u30f3\u3068\uff08\u4efb\u610f\u3067\uff09\u9045\u5ef6\u843d\u4e0b\u30dd\u30fc\u30b7\u30e7\u30f3\u3092\u78ba\u4fdd\u3059\u308b\u3002\u624b\u98063\uff1a\u9ed2\u66dc\u77f3\u306e\u5854\u306e\u4e0a\u306b\u3042\u308b\u30a8\u30f3\u30c0\u30fc\u30af\u30ea\u30b9\u30bf\u30eb\u3092\u7834\u58ca\u3059\u308b\u3002\u3053\u308c\u3089\u306f\u30c9\u30e9\u30b4\u30f3\u3092\u7652\u3059\u3002\u6700\u521d\u306b\u3053\u308c\u3089\u306e\u30af\u30ea\u30b9\u30bf\u30eb\u306b\u96c6\u4e2d\u3057\u3001\u6b21\u306b\u30dd\u30fc\u30bf\u30eb\u5674\u6c34\u306e\u4e0a\u306b\u6b62\u307e\u308b\u3068\u30c9\u30e9\u30b4\u30f3\u306b\u5f13\u3092\u4f7f\u3063\u3066\u653b\u6483\u3059\u308b\u3068\u3001\u7a7a\u4e2d\u3067\u9ad8\u304f\u3044\u308b\u3068\u304d\u306f\u5f13\u3067\u3001\u5730\u9762\u306b\u7740\u304f\u3068\u5263\u3067\u653b\u6483\u3057\u307e\u3059\u3002\u5f37\u529b\u306a\u30a8\u30f3\u30c1\u30e3\u30f3\u30c8\u3055\u308c\u305f\u5f13\u3068\u30c0\u30a4\u30e4\u30e2\u30f3\u30c9\u30a2\u30fc\u30de\u30fc\u304c\u3001\u7d42\u76e4\u306e\u969b\u306b\u547d\u7db1\u3068\u306a\u308a\u307e\u3059\u3002"}, {"question": "\u30da\u30fc\u30d1\u30fc\u30af\u30e9\u30d5\u30c8\u30de\u30a4\u30f3\u30af\u30e9\u30d5\u30c8\u3067\u3001\u8fb2\u5834\u3084\u9271\u77f3\u63a1\u6398\u306e\u3088\u3046\u306a\u8cc7\u6e90\u63a1\u53d6\u3092\u81ea\u52d5\u5316\u3059\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u65b9\u6cd5\u3068\u3001\u4e00\u822c\u7684\u306a\u81ea\u52d5\u5316\u8a2d\u8a08\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u81ea\u52d5\u5316\u3055\u308c\u305f\u8cc7\u6e90\u63a1\u53d6\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u52b9\u7387\u5316\u3057\u307e\u3059\u3002\u8fb2\u5834\u3067\u306f\u3001\u8fb2\u5730\u306e\u4e0b\u306b\u30db\u30c3\u30d1\u30fc\u3092\u8a2d\u7f6e\u3057\u3066\u4f5c\u7269\u3092\u53ce\u96c6\u3059\u308b\u30b7\u30b9\u30c6\u30e0\u3092\u4f5c\u6210\u3057\u307e\u3059\u3002\u9271\u77f3\u63a1\u6398\u3067\u306f\u3001\u30d6\u30ed\u30c3\u30af\u7834\u58ca\u88c5\u7f6e\u4ed8\u304d\u306e\u98db\u884c\u6a5f\u68b0\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u624b\u98061\uff1a\u704c\u6f11\u306e\u305f\u3081\u306b\u6c34\u8def\u306e\u3042\u308b\u8fb2\u5834\u3092\u30c7\u30b6\u30a4\u30f3\u3059\u308b\u3002\u624b\u98062\uff1a\u53ce\u7a6b\u3055\u308c\u305f\u4f5c\u7269\u3092\u81ea\u52d5\u7684\u306b\u53ce\u96c6\u3059\u308b\u305f\u3081\u306b\u3001\u8fb2\u5730\u306e\u4e0b\u306b\u30db\u30c3\u30d1\u30fc\u3092\u914d\u7f6e\u3059\u308b\u3002\u624b\u98063\uff1a\u30db\u30c3\u30d1\u30fc\u3092\u81ea\u52d5\u4fdd\u7ba1\u306e\u305f\u3081\u306e\u30c1\u30a7\u30b9\u30c8\u306b\u63a5\u7d9a\u3059\u308b\u3002\u30d7\u30ed\u30bb\u30b9\u3092\u81ea\u52d5\u5316\u3059\u308b\u3053\u3068\u3067\u3001\u5de5\u5834\u306e\u7d44\u307f\u7acb\u3066\u30e9\u30a4\u30f3\u306e\u3088\u3046\u306b\u3001\u6750\u6599\u306e\u5b89\u5b9a\u3057\u305f\u6d41\u308c\u304c\u78ba\u4fdd\u3055\u308c\u307e\u3059\u3002"}, {"question": "\u30da\u30fc\u30d1\u30fc\u30af\u30e9\u30d5\u30c8\u30de\u30a4\u30f3\u30af\u30e9\u30d5\u30c8\u306f\u30ef\u30fc\u30eb\u30c9\u751f\u6210\u3092\u3069\u306e\u3088\u3046\u306b\u51e6\u7406\u3057\u3001\u3055\u307e\u3056\u307e\u306a\u30b7\u30fc\u30c9\u3067\u30d0\u30a4\u30aa\u30fc\u30e0\u306e\u5206\u5e03\u3068\u69cb\u9020\u306e\u914d\u7f6e\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30da\u30fc\u30d1\u30fc\u30af\u30e9\u30d5\u30c8\u30de\u30a4\u30f3\u30af\u30e9\u30d5\u30c8\u306e\u30ef\u30fc\u30eb\u30c9\u751f\u6210\u306f\u3001\u30b7\u30fc\u30c9\u5024\u306b\u57fa\u3065\u3044\u305f\u98a8\u666f\u3092\u4f5c\u6210\u3059\u308b\u305f\u3081\u306e\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u3053\u306e\u30b7\u30fc\u30c9\u5024\u306f\u3001\u30d0\u30a4\u30aa\u30fc\u30e0\u3001\u69cb\u9020\u7269\u3001\u8cc7\u6e90\u306e\u914d\u7f6e\u3092\u6c7a\u5b9a\u3057\u307e\u3059\u3002\u30ef\u30fc\u30eb\u30c9\u751f\u6210\u30d7\u30ed\u30bb\u30b9\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u8981\u56e0\u3092\u8003\u616e\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30d0\u30a4\u30aa\u30fc\u30e0\u306e\u914d\u7f6e\u306f\u3001\u6e29\u5ea6\u3084\u6e7f\u5ea6\u30d1\u30e9\u30e1\u30fc\u30bf\u306e\u5f71\u97ff\u3092\u53d7\u3051\u308b\u5834\u5408\u304c\u591a\u304f\u3001\u6751\u306e\u3088\u3046\u306a\u69cb\u9020\u7269\u306f\u5e73\u3089\u306a\u5834\u6240\u306b\u914d\u7f6e\u3055\u308c\u307e\u3059\u3002\u30b7\u30fc\u30c9\u3092\u5909\u66f4\u3059\u308b\u3068\u3001\u5b8c\u5168\u306b\u98a8\u666f\u304c\u5909\u308f\u308a\u307e\u3059\u3002\u3053\u306e\u30d7\u30ed\u30bb\u30b9\u306f\u975e\u5e38\u306b\u5927\u304d\u304f\u8907\u96d1\u306a\u6570\u5b66\u95a2\u6570\u306b\u985e\u4f3c\u3057\u305f\u8907\u96d1\u306a\u6570\u5b66\u8a08\u7b97\u304c\u542b\u307e\u308c\u307e\u3059\u304c\u3001\u30b7\u30fc\u30c9\u306f\u305d\u306e\u95a2\u6570\u306e\u51fa\u529b\u5024\u3092\u6c7a\u5b9a\u3057\u307e\u3059\u3002"}, {"question": "\u30da\u30fc\u30d1\u30fc\u30af\u30e9\u30d5\u30c8\uff1a\u4e00\u90e8\u306e\u30ec\u30c3\u30c9\u30b9\u30c8\u30fc\u30f3\u56de\u8def\u304c\u4e88\u60f3\u901a\u308a\u306b\u6a5f\u80fd\u3057\u306a\u3044\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u8907\u96d1\u306a\u8ad6\u7406\u30b2\u30fc\u30c8\u3092\u6271\u3046\u969b\u306b\u3001\u305d\u308c\u3089\u3092\u6b63\u78ba\u306b\u30c8\u30e9\u30d6\u30eb\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30ec\u30c3\u30c9\u30b9\u30c8\u30fc\u30f3\u56de\u8def\u306e\u4e0d\u5177\u5408\u306f\u3001\u30ef\u30a4\u30e4\u306e\u914d\u7f6e\u30df\u30b9\u3084\u96fb\u5727\u30ec\u30d9\u30eb\u304c\u539f\u56e0\u3067\u3042\u308b\u3053\u3068\u304c\u591a\u304f\u306a\u3063\u3066\u3044\u307e\u3059\u3002\u30c8\u30e9\u30d6\u30eb\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0\u306f\u3001\u65b9\u6cd5\u7684\u306a\u30c6\u30b9\u30c8\u304c\u5fc5\u8981\u3067\u3059\u3002\u624b\u98061\uff1a\u30ea\u30d4\u30fc\u30bf\u30fc\u30d6\u30ed\u30c3\u30af\u3092\u4f7f\u7528\u3057\u3066\u3001\u6545\u969c\u3057\u3066\u3044\u308b\u90e8\u5206\u3092\u7279\u5b9a\u3059\u308b\u3002\u624b\u98062\uff1a\u5404\u30b3\u30f3\u30dd\u30fc\u30cd\u30f3\u30c8\u3092\u500b\u5225\u306b\u30c6\u30b9\u30c8\u3059\u308b\u3002\u30aa\u30d6\u30b6\u30fc\u30d0\u30fc\u3092\u4f7f\u7528\u3057\u3066\u3001\u7279\u5b9a\u306e\u30b3\u30f3\u30dd\u30fc\u30cd\u30f3\u30c8\u304c\u671f\u5f85\u901a\u308a\u4fe1\u53f7\u3092\u51fa\u529b\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3059\u308b\u3002\u624b\u98063\uff1a\u3088\u308a\u8996\u899a\u7684\u306a\u30ec\u30a4\u30a2\u30a6\u30c8\uff08\u4f8b\u3048\u3070\u3001\u30bb\u30af\u30b7\u30e7\u30f3\u306b\u30e9\u30d9\u30eb\u3092\u4ed8\u3051\u308b\uff09\u3067\u518d\u8a2d\u8a08\u3059\u308b\u3002\u4fe1\u53f7\u5f37\u5ea6\u304c\u4e0d\u6b63\u78ba\u3067\u3042\u3063\u305f\u308a\u3001\u30d1\u30b9\u304c\u30d6\u30ed\u30c3\u30af\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u304c\u3001\u983b\u7e41\u306a\u539f\u56e0\u3067\u3059\u3002\u30de\u30eb\u30c1\u30e1\u30fc\u30bf\u30fc\u3092\u4f7f\u3063\u3066\u96fb\u5b50\u56de\u8def\u3092\u30c8\u30e9\u30d6\u30eb\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0\u3059\u308b\u65b9\u6cd5\u3068\u540c\u69d8\u306b\u3001\u5404\u30b3\u30f3\u30dd\u30fc\u30cd\u30f3\u30c8\u3092\u5206\u96e2\u3057\u306a\u304c\u3089\u30c8\u30e9\u30d6\u30eb\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30da\u30fc\u30d1\u30fc\u30af\u30e9\u30d5\u30c8\u30de\u30a4\u30f3\u30af\u30e9\u30d5\u30c8\u306f\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u4e92\u63db\u3067\u3059\u304b\uff1f\u7570\u306a\u308b\u30d0\u30fc\u30b8\u30e7\u30f3\uff08\u4f8b\u3048\u3070\u3001\u30d9\u30c9\u30ed\u30c3\u30af\u7248\u5bfeJava\u7248\uff09\u306e\u53cb\u4eba\u3068\u30d7\u30ec\u30a4\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30da\u30fc\u30d1\u30fc\u30af\u30e9\u30d5\u30c8\u30de\u30a4\u30f3\u30af\u30e9\u30d5\u30c8\u306f\u4e3b\u306bJava\u30a8\u30c7\u30a3\u30b7\u30e7\u30f3\u3067\u52d5\u4f5c\u3057\u307e\u3059\u3002Java\u30a8\u30c7\u30a3\u30b7\u30e7\u30f3\u306f\u30d9\u30c9\u30ed\u30c3\u30af\u30a8\u30c7\u30a3\u30b7\u30e7\u30f3\u3068\u76f4\u63a5\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u4e92\u63db\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u4e00\u7dd2\u306b\u30d7\u30ec\u30a4\u3059\u308b\u306b\u306f\u3001\u4e21\u65b9\u3068\u3082Java\u30a8\u30c7\u30a3\u30b7\u30e7\u30f3\u3067\u3042\u308b\u304b\u3001\u30af\u30ed\u30b9\u30d7\u30ec\u30a4\u7528\u306b\u7279\u5225\u306b\u8a2d\u8a08\u3055\u308c\u305f\u30d6\u30ea\u30c3\u30b8\u3092\u5b9f\u88c5\u3059\u308b\u30b5\u30fc\u30d0\u30fc\u3092\u4f7f\u7528\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u306e\u7a2e\u306e\u30d6\u30ea\u30c3\u30b8\u306f\u30b2\u30fc\u30e0\u306b\u516c\u5f0f\u306b\u306f\u542b\u307e\u308c\u3066\u3044\u307e\u305b\u3093\u306e\u3067\u3001\u30b5\u30fc\u30c9\u30d1\u30fc\u30c6\u30a3\u306e\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u8abf\u3079\u3066\u304f\u3060\u3055\u3044\u3002Java\u7248\u3068\u30d9\u30c9\u30ed\u30c3\u30af\u7248\u3092\u7570\u306a\u308b\u8a00\u8a9e\u3092\u8a71\u3059\u3082\u306e\u3068\u8003\u3048\u308b\u3068\u3001\u7ffb\u8a33\u30b5\u30fc\u30d3\u30b9\u304c\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u306e\u30ae\u30e3\u30c3\u30d7\u3092\u57cb\u3081\u307e\u3059\u3002"}, {"question": "\u30da\u30fc\u30d1\u30fc\u30af\u30e9\u30d5\u30c8\u30de\u30a4\u30f3\u30af\u30e9\u30d5\u30c8\u306e\u3001\u540d\u524d\u4ed8\u304d\u306e\u30e2\u30d6\u3084\u7279\u5b9a\u306e\u30a2\u30a4\u30c6\u30e0\u306e\u7d44\u307f\u5408\u308f\u305b\u306b\u95a2\u9023\u3059\u308b\u3001\u3042\u307e\u308a\u77e5\u3089\u308c\u3066\u3044\u306a\u3044\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3084\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u4e00\u610f\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3068\u3057\u3066\u3001\u30cd\u30fc\u30e0\u30bf\u30b0\u3092\u4f7f\u7528\u3059\u308b\u4f8b\u3068\u3057\u3066\u6319\u3052\u3089\u308c\u307e\u3059\u3002\u7f8a\u306b\u300cjeb_\u300d\u3068\u3044\u3046\u540d\u524d\u3092\u4ed8\u3051\u308b\u3068\u3001\u305d\u306e\u6bdb\u306f\u3059\u3079\u3066\u306e\u8272\u306b\u5909\u308f\u308a\u307e\u3059\u3002\u3053\u308c\u3092\u884c\u3046\u306b\u306f\u3001\u30a2\u30f3\u30d3\u30eb\u3067\u30cd\u30fc\u30e0\u30bf\u30b0\u306e\u540d\u524d\u3092\u5909\u66f4\u3057\u3001\u305d\u308c\u3092\u7f8a\u306b\u9069\u7528\u3057\u307e\u3059\u3002\u540c\u69d8\u306b\u3001\u30a6\u30b5\u30ae\u306b\u300cToast\u300d\u3068\u3044\u3046\u540d\u524d\u3092\u4ed8\u3051\u308b\u3068\u3001\u72ec\u7279\u306e\u30b9\u30ad\u30f3\u306e\u5916\u89b3\u306b\u306a\u308a\u307e\u3059\u3002\u4ed6\u306e\u540d\u524d\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u8a66\u3057\u3066\u3001\u3088\u308a\u591a\u304f\u767a\u898b\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u306e\u3088\u3046\u306a\u96a0\u308c\u305f\u8981\u7d20\u306f\u3001\u30b2\u30fc\u30e0\u306b\u697d\u3057\u304f\u9a5a\u304d\u3092\u8ffd\u52a0\u3059\u308b\u305f\u3081\u306e\u7d20\u6674\u3089\u3057\u3044\u65b9\u6cd5\u3067\u3059\u3002"}]
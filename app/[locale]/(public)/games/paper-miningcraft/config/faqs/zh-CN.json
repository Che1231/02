[{"question": "Paper Minecraft\uff1a\u6e38\u620f\u5f00\u59cb\u65f6\u5982\u4f55\u5236\u4f5c\u57fa\u7840\u5de5\u5177\uff0c\u4ee5\u53ca\u6700\u521d\u4f7f\u7528\u54ea\u79cd\u6750\u6599\u6700\u6709\u6548\uff1f", "answer": "\u4f5c\u4e3a\u4e00\u540d\u5168\u65b0\u7684Paper Minecraft\u73a9\u5bb6\uff0c\u9996\u5148\u5236\u4f5c\u6728\u5236\u5de5\u5177\u81f3\u5173\u91cd\u8981\u3002\u6b65\u9aa41\uff1a\u780d\u4f10\u6811\u6728\uff0c\u83b7\u5f97\u6728\u5934\u539f\u6728\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u7269\u54c1\u680f\u7684\u5236\u4f5c\u7f51\u683c\uff0c\u5c06\u539f\u6728\u8f6c\u6362\u4e3a\u6728\u677f\u3002\u6b65\u9aa43\uff1a\u5236\u4f5c\u5de5\u4f5c\u53f0\uff0c\u7136\u540e\u5236\u4f5c\u6728\u68cd\uff0c\u6700\u540e\u5236\u4f5c\u5de5\u5177\u3002\u521d\u671f\uff0c\u6728\u6750\u5c31\u8db3\u591f\u4e86\u3002\u5177\u4f53\u6765\u8bf4\uff0c\u5236\u4f5c\u6728\u5236\u9550\u53ef\u4ee5\u8ba9\u4f60\u6316\u6398\u77f3\u5934\uff0c\u77f3\u5934\u66f4\u8010\u7528\u3002\u53ef\u4ee5\u5c06\u6728\u5236\u5de5\u5177\u89c6\u4e3a\u5728\u4f7f\u7528\u66f4\u7a33\u5b9a\u7684\u77f3\u5236\u5de5\u5177\u4e4b\u524d\uff0c\u4f60\u4f7f\u7528\u7684\u8bad\u7ec3\u8f6e\u5b50\u3002"}, {"question": "Paper Minecraft\u7684\u9965\u997f\u7cfb\u7edf\u662f\u600e\u4e48\u56de\u4e8b\uff1f\u4e3a\u4ec0\u4e48\u6211\u7684\u89d2\u8272\u4f1a\u4e00\u76f4\u611f\u5230\u9965\u997f\uff0c\u4ee5\u53ca\u5982\u4f55\u5728\u65e9\u671f\u6709\u6548\u5730\u7ba1\u7406\u9965\u997f\u4ee5\u907f\u514d\u6328\u997f\uff1f", "answer": "\u5728Paper Minecraft\u4e2d\uff0c\u6267\u884c\u6316\u6398\u7b49\u64cd\u4f5c\u65f6\uff0c\u4f60\u7684\u9965\u997f\u503c\u4f1a\u51cf\u5c11\u3002\u5f53\u9965\u997f\u503c\u8017\u5c3d\u65f6\uff0c\u4f60\u7684\u751f\u547d\u503c\u4f1a\u4e0b\u964d\u3002\u521d\u671f\uff0c\u4e13\u6ce8\u4e8e\u7b80\u5355\u7684\u98df\u7269\u6765\u6e90\u3002\u6b65\u9aa41\uff1a\u730e\u6740\u5bb9\u6613\u83b7\u5f97\u7684\u52a8\u7269\uff0c\u4f8b\u5982\u9e21\u548c\u732a\uff0c\u83b7\u53d6\u8089\u7c7b\u3002\u6b65\u9aa42\uff1a\u5236\u4f5c\u7194\u7089\u5c06\u8089\u7c7b\u70f9\u996a\uff1b\u70f9\u996a\u540e\u7684\u8089\u7c7b\u63d0\u4f9b\u66f4\u591a\u7684\u9971\u8179\u611f\uff08\u9965\u997f\u503c\u4fdd\u6301\u6ee1\u503c\u7684\u6301\u7eed\u65f6\u95f4\uff09\u3002\u6b65\u9aa43\uff1a\u5bfb\u627e\u6d46\u679c\u3002\u4e00\u79cd\u826f\u597d\u7684\u65e9\u671f\u6e38\u620f\u7b56\u7565\u662f\u59cb\u7ec8\u643a\u5e26\u719f\u8089\uff0c\u5e76\u5728\u9965\u997f\u503c\u51cf\u5c11\u65f6\u98df\u7528\u3002\u8fd9\u5c31\u50cf\u73b0\u5b9e\u751f\u6d3b\u4e00\u6837\uff0c\u4f60\u9700\u8981\u5b9a\u671f\u8fdb\u98df\u6765\u4fdd\u6301\u80fd\u91cf\uff01"}, {"question": "Paper Minecraft\uff1a\u4e0d\u540c\u7684\u751f\u7269\u7fa4\u7cfb\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5728\u65e9\u671f\u6e38\u620f\u8fc7\u7a0b\u4e2d\u4e86\u89e3\u5b83\u4eec\u80fd\u7ed9\u6211\u5e26\u6765\u54ea\u4e9b\u597d\u5904\uff1f\u54ea\u4e9b\u8d44\u6e90\u662f\u6bcf\u4e2a\u751f\u7269\u7fa4\u7cfb\u72ec\u6709\u7684\uff1f", "answer": "Paper Minecraft\u62e5\u6709\u5404\u79cd\u5404\u6837\u7684\u751f\u7269\u7fa4\u7cfb\uff0c\u4f8b\u5982\u68ee\u6797\u3001\u6c99\u6f20\u548c\u5e73\u539f\u3002\u6bcf\u4e2a\u751f\u7269\u7fa4\u7cfb\u90fd\u63d0\u4f9b\u72ec\u7279\u7684\u8d44\u6e90\u3002\u68ee\u6797\u4e2d\u6728\u6750\u4e30\u5bcc\uff0c\u6c99\u6f20\u4e2d\u63d0\u4f9b\u4ed9\u4eba\u638c\uff08\u53ef\u7528\u4e8e\u7eff\u8272\u67d3\u6599\uff09\uff0c\u800c\u96ea\u5730\u751f\u7269\u7fa4\u7cfb\u5219\u4ea7\u51fa\u51b0\u3002\u6b65\u9aa41\uff1a\u63a2\u7d22\u4ee5\u7ed8\u5236\u5468\u56f4\u751f\u7269\u7fa4\u7cfb\u7684\u56fe\u8c31\u3002\u6b65\u9aa42\uff1a\u8bb0\u5f55\u53ef\u7528\u7684\u8d44\u6e90\uff0c\u4f8b\u5982\u5728\u6c99\u6f20\u751f\u7269\u7fa4\u7cfb\u4e2d\u9760\u8fd1\u6c34\u6e90\u627e\u5230\u7518\u8517\u3002\u6b65\u9aa43\uff1a\u8ba1\u5212\u4f60\u7684\u57fa\u5730\u4f4d\u7f6e\uff0c\u4f7f\u5176\u9760\u8fd1\u62e5\u6709\u5fc5\u8981\u8d44\u6e90\u7684\u751f\u7269\u7fa4\u7cfb\u3002\u8003\u8651\u5c06\u57fa\u5730\u5efa\u5728\u68ee\u6797\u548c\u5e73\u539f\u9644\u8fd1\uff0c\u4ee5\u4fbf\u8f7b\u677e\u83b7\u53d6\u6728\u6750\u548c\u98df\u7269\u3002\u53ef\u4ee5\u5c06\u751f\u7269\u7fa4\u7cfb\u89c6\u4e3a\u8d2d\u7269\u4e2d\u5fc3\u4e2d\u4e0d\u540c\u7684\u5546\u5e97\uff0c\u6bcf\u5bb6\u5546\u5e97\u90fd\u4e13\u95e8\u51fa\u552e\u67d0\u4e9b\u4ea7\u54c1\u3002"}, {"question": "\u5bf9\u4e8e\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\uff1aPaperMC\uff1a\u5982\u4f55\u8bbe\u7f6e\u4e00\u4e2a\u9ad8\u6548\u7684\u602a\u7269\u519c\u573a\u6765\u83b7\u5f97\u6301\u7eed\u7684\u8d44\u6e90\u548c\u7ecf\u9a8c\uff0c\u4ee5\u53ca\u54ea\u79cd\u519c\u573a\u8bbe\u8ba1\u6700\u9002\u5408\u6269\u5c55\uff1f", "answer": "\u8bbe\u7f6e\u602a\u7269\u519c\u573a\u5bf9\u4e8e\u6536\u96c6\u8d44\u6e90\u548c\u7ecf\u9a8c\u81f3\u5173\u91cd\u8981\u3002\u4e00\u4e2a\u7b80\u5355\u7684\u9ed1\u6697\u623f\u95f4\u8bbe\u8ba1\u662f\u4e00\u4e2a\u5f88\u597d\u7684\u5f00\u59cb\uff1a\u6b65\u9aa41\uff1a\u627e\u5230\u4e00\u4e2a\u9ed1\u6697\u533a\u57df\u6216\u5efa\u9020\u4e00\u4e2a\u4e0e\u5149\u7ebf\u9694\u7edd\u7684\u7ed3\u6784\u3002\u6b65\u9aa42\uff1a\u5728\u5185\u90e8\u521b\u5efa\u4e00\u4e2a\u5927\u7684\u5e73\u5766\u5e73\u53f0\u3002\u6b65\u9aa43\uff1a\u6dfb\u52a0\u6c34\u6d41\u5c06\u602a\u7269\u63a8\u5411\u4e2d\u592e\u843d\u70b9\u3002\u9ad8\u5ea6\u7684\u6389\u843d\u4f1a\u5bfc\u81f4\u81f4\u547d\u4f24\u5bb3\uff0c\u51e0\u5177\u6b8b\u9ab8\u53ef\u4ee5\u7528\u4f60\u7684\u5251\u7ed3\u675f\u3002\u901a\u8fc7\u6269\u5c55\u5e73\u53f0\uff0c\u9ed1\u6697\u623f\u95f4\u7684\u8bbe\u8ba1\u53ef\u4ee5\u5f88\u597d\u5730\u6269\u5c55\u3002\u8bb0\u4f4f\uff0c\u519c\u573a\u5468\u56f4\u7684\u706b\u628a\u4f1a\u964d\u4f4e\u602a\u7269\u7684\u751f\u6210\u7387\u3002"}, {"question": "Paper Minecraft\uff1a\u5982\u4f55\u6709\u6548\u5730\u5e94\u5bf9\u672b\u5f71\u9f99\uff0c\u4ee5\u53ca\u4e3a\u4e86\u63d0\u9ad8\u6210\u529f\u7387\uff0c\u6211\u5e94\u8be5\u4f18\u5148\u8003\u8651\u54ea\u4e9b\u88c5\u5907\uff1f", "answer": "\u51fb\u8d25\u672b\u5f71\u9f99\u9700\u8981\u4ed4\u7ec6\u7684\u51c6\u5907\u3002\u6b65\u9aa41\uff1a\u83b7\u53d6\u94bb\u77f3\u76d4\u7532\u548c\u5e26\u6709\u201c\u529b\u91cf\u201d\u548c\u201c\u65e0\u9650\u201d\u7b49\u9644\u9b54\u7684\u5f3a\u529b\u5f13\u7bad\u3002\u6b65\u9aa42\uff1a\u50a8\u5b58\u6cbb\u7597\u836f\u6c34\u548c\u51cf\u901f\u836f\u6c34\uff08\u53ef\u9009\uff09\uff0c\u4ee5\u5e94\u5bf9\u6f5c\u5728\u7684\u610f\u5916\u60c5\u51b5\u3002\u6b65\u9aa43\uff1a\u6467\u6bc1\u4f4d\u4e8e\u9ed1\u66dc\u77f3\u5854\u9876\u4e0a\u7684\u672b\u5f71\u6676\u4f53\uff0c\u56e0\u4e3a\u8fd9\u4e9b\u6676\u4f53\u53ef\u4ee5\u6cbb\u7597\u672b\u5f71\u9f99\u3002\u9996\u5148\u4e13\u6ce8\u4e8e\u8fd9\u4e9b\u6676\u4f53\uff0c\u7136\u540e\u5728\u672b\u5f71\u9f99\u505c\u7559\u5728\u4f20\u9001\u95e8\u55b7\u6cc9\u4e0a\u65f6\uff0c\u7528\u5f13\u7bad\u653b\u51fb\u5b83\uff08\u5f53\u5b83\u5728\u7a7a\u4e2d\u65f6\uff09\uff0c\u7528\u5251\u653b\u51fb\u5b83\uff08\u5f53\u5b83\u7740\u9646\u65f6\uff09\u3002\u5f3a\u5927\u7684\u9644\u9b54\u5f13\u7bad\u548c\u94bb\u77f3\u76d4\u7532\u662f\u4f60\u5728\u6700\u7ec8\u4e4b\u6218\u4e2d\u7684\u751f\u547d\u7ebf\u3002"}, {"question": "\u5728Paper Minecraft\u4e2d\uff0c\u81ea\u52a8\u5316\u8d44\u6e90\u6536\u96c6\uff08\u4f8b\u5982\u519c\u4e1a\u6216\u77ff\u7269\u5f00\u91c7\uff09\u7684\u6700\u4f73\u65b9\u6cd5\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u4e00\u4e9b\u6d41\u884c\u7684\u81ea\u52a8\u5316\u8bbe\u8ba1\u6709\u54ea\u4e9b\uff1f", "answer": "\u81ea\u52a8\u5316\u8d44\u6e90\u6536\u96c6\u53ef\u4ee5\u7b80\u5316\u4f60\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u5bf9\u4e8e\u519c\u4e1a\uff0c\u521b\u5efa\u7cfb\u7edf\uff0c\u5728\u519c\u7530\u4e0b\u65b9\u653e\u7f6e\u6f0f\u6597\u6536\u96c6\u519c\u4f5c\u7269\u3002\u5bf9\u4e8e\u77ff\u7269\u5f00\u91c7\uff0c\u53ef\u4ee5\u7528\u5e26\u65b9\u5757\u7834\u574f\u5668\u7684\u98de\u884c\u673a\u5668\u3002\u6b65\u9aa41\uff1a\u8bbe\u8ba1\u4e00\u4e2a\u5e26\u6709\u704c\u6e89\u6c34\u6e20\u7684\u519c\u7530\u533a\u57df\u3002\u6b65\u9aa42\uff1a\u5728\u519c\u7530\u4e0b\u65b9\u653e\u7f6e\u6f0f\u6597\uff0c\u6536\u96c6\u6536\u5272\u7684\u519c\u4f5c\u7269\u3002\u6b65\u9aa43\uff1a\u5c06\u6f0f\u6597\u8fde\u63a5\u5230\u7bb1\u5b50\u8fdb\u884c\u81ea\u52a8\u5b58\u50a8\u3002\u81ea\u52a8\u5316\u6d41\u7a0b\u53ef\u4ee5\u786e\u4fdd\u6750\u6599\u6301\u7eed\u4f9b\u5e94\uff0c\u5c31\u50cf\u5de5\u5382\u6d41\u6c34\u7ebf\u4e00\u6837\u3002"}, {"question": "Paper Minecraft\u5982\u4f55\u5904\u7406\u4e16\u754c\u751f\u6210\uff0c\u4ee5\u53ca\u4e0d\u540c\u79cd\u5b50\u4e2d\u751f\u7269\u7fa4\u7cfb\u5206\u5e03\u548c\u7ed3\u6784\u653e\u7f6e\u80cc\u540e\u7684\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "Paper Minecraft\u7684\u4e16\u754c\u751f\u6210\u4f7f\u7528\u7b97\u6cd5\u521b\u5efa\u57fa\u4e8e\u79cd\u5b50\u503c\u7684\u666f\u89c2\u3002\u8be5\u79cd\u5b50\u51b3\u5b9a\u4e86\u751f\u7269\u7fa4\u7cfb\u3001\u7ed3\u6784\u548c\u8d44\u6e90\u7684\u653e\u7f6e\u3002\u4e16\u754c\u751f\u6210\u8fc7\u7a0b\u4f1a\u8003\u8651\u5404\u79cd\u56e0\u7d20\uff1a\u751f\u7269\u7fa4\u7cfb\u7684\u653e\u7f6e\u901a\u5e38\u53d7\u6e29\u5ea6\u548c\u6e7f\u5ea6\u53c2\u6570\u7684\u5f71\u54cd\uff0c\u5e76\u4e14\u6751\u5e84\u7b49\u7ed3\u6784\u88ab\u653e\u7f6e\u5728\u5e73\u5766\u7684\u5730\u9762\u4e0a\u3002\u66f4\u6539\u79cd\u5b50\u5c06\u5b8c\u5168\u6539\u53d8\u666f\u89c2\u3002\u8be5\u8fc7\u7a0b\u6d89\u53ca\u590d\u6742\u7684\u6570\u5b66\u8ba1\u7b97\uff0c\u7c7b\u4f3c\u4e8e\u4e00\u4e2a\u975e\u5e38\u5927\u4e14\u590d\u6742\u7684\u6570\u5b66\u51fd\u6570\uff0c\u4f46\u662f\u79cd\u5b50\u51b3\u5b9a\u4e86\u8be5\u51fd\u6570\u7684\u8f93\u51fa\u3002"}, {"question": "PaperMC\uff1a\u4e3a\u4ec0\u4e48\u6709\u4e9b\u7ea2\u77f3\u7535\u8def\u65e0\u6cd5\u6309\u9884\u671f\u8fd0\u884c\uff0c\u4ee5\u53ca\u5728\u5904\u7406\u590d\u6742\u7684\u903b\u8f91\u95e8\u65f6\u5982\u4f55\u51c6\u786e\u5730\u5bf9\u5176\u8fdb\u884c\u6545\u969c\u6392\u9664\uff1f", "answer": "\u7ea2\u77f3\u7535\u8def\u6545\u969c\u901a\u5e38\u662f\u7531\u4e8e\u7535\u7ebf\u653e\u7f6e\u4e0d\u5f53\u6216\u529f\u7387\u7b49\u7ea7\u4e0d\u6b63\u786e\u3002\u6545\u969c\u6392\u9664\u9700\u8981\u6709\u6761\u4e0d\u7d0a\u7684\u6d4b\u8bd5\u3002\u6b65\u9aa41\uff1a\u4f7f\u7528\u91cd\u590d\u5668\u9694\u79bb\u6545\u969c\u533a\u57df\u3002\u6b65\u9aa42\uff1a\u5355\u72ec\u6d4b\u8bd5\u6bcf\u4e2a\u90e8\u4ef6\u3002\u4f7f\u7528\u89c2\u5bdf\u8005\u68c0\u67e5\u67d0\u4e9b\u90e8\u4ef6\u662f\u5426\u6309\u9884\u671f\u8f93\u51fa\u4fe1\u53f7\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u66f4\u76f4\u89c2\u7684\u5e03\u5c40\u8fdb\u884c\u91cd\u65b0\u8bbe\u8ba1\uff08\u4f8b\u5982\uff0c\u6807\u8bb0\u90e8\u5206\uff09\u3002\u9519\u8bef\u7684\u4fe1\u53f7\u5f3a\u5ea6\u6216\u963b\u585e\u7684\u8def\u5f84\u662f\u5e38\u89c1\u7684\u539f\u56e0\u3002\u4e07\u7528\u8868\u53ef\u7528\u4e8e\u6545\u969c\u6392\u9664\u7535\u5b50\u7535\u8def\uff0c\u6b64\u5904\u53ef\u4ee5\u4f7f\u7528\u7c7b\u4f3c\u7684\u65b9\u6cd5\u6765\u9694\u79bb\u6bcf\u4e2a\u7ec4\u4ef6\u3002"}, {"question": "Paper Minecraft\u662f\u5426\u8de8\u5e73\u53f0\u517c\u5bb9\uff1f\u5982\u679c\u6211\u7684\u670b\u53cb\u4f7f\u7528\u4e0d\u540c\u7684\u7248\u672c\uff08\u4f8b\u5982\uff0c\u57fa\u5ca9\u7248\u4e0eJava\u7248\uff09\uff0c\u6211\u4eec\u80fd\u5426\u4e00\u8d77\u73a9\uff1f", "answer": "Paper Minecraft\u4e3b\u8981\u8fd0\u884c\u5728Java\u7248\u4e0a\u3002Java\u7248\u4e0e\u57fa\u5ca9\u7248\u4e0d\u76f4\u63a5\u8de8\u5e73\u53f0\u517c\u5bb9\u3002\u8981\u4e00\u8d77\u73a9\uff0c\u4f60\u4eec\u90fd\u9700\u8981\u4f7f\u7528Java\u7248\uff0c\u6216\u8005\u4f7f\u7528\u4e13\u95e8\u4e3a\u8de8\u5e73\u53f0\u6e38\u620f\u8bbe\u8ba1\u7684\u670d\u52a1\u5668\u6865\u63a5\u5668\u3002\u8fd9\u79cd\u6865\u63a5\u5668\u5e76\u975e\u5b98\u65b9\u529f\u80fd\uff0c\u56e0\u6b64\u9700\u8981\u67e5\u770b\u7b2c\u4e09\u65b9\u9009\u9879\u3002\u53ef\u4ee5\u5c06Java\u7248\u548c\u57fa\u5ca9\u7248\u89c6\u4e3a\u4f7f\u7528\u7565\u5fae\u4e0d\u540c\u7684\u8bed\u8a00\uff1b\u7ffb\u8bd1\u670d\u52a1\u5f25\u5408\u4e86\u6c9f\u901a\u7684\u5dee\u8ddd\u3002"}, {"question": "\u5728Paper Minecraft\u4e2d\uff0c\u6709\u54ea\u4e9b\u9c9c\u4e3a\u4eba\u77e5\u7684\u5f69\u86cb\u6216\u9690\u85cf\u529f\u80fd\uff0c\u4e0e\u547d\u540d\u602a\u7269\u6216\u7279\u5b9a\u7269\u54c1\u7ec4\u5408\u6709\u5173\uff1f", "answer": "\u4e00\u4e2a\u72ec\u7279\u7684\u5f69\u86cb\u662f\u4f7f\u7528\u540d\u79f0\u6807\u7b7e\uff1a\u5982\u679c\u4f60\u5c06\u7ef5\u7f8a\u7684\u540d\u79f0\u6539\u4e3a\"jeb_\", \u5b83\u7684\u7f8a\u6bdb\u989c\u8272\u4f1a\u5faa\u73af\u5207\u6362\u3002\u8fd9\u662f\u901a\u8fc7\u5728\u94c1\u7827\u4e0a\u91cd\u547d\u540d\u540d\u79f0\u6807\u7b7e\uff0c\u7136\u540e\u5c06\u8be5\u540d\u79f0\u6807\u7b7e\u7528\u4e8e\u7ef5\u7f8a\u6765\u5b9e\u73b0\u7684\u3002\u7c7b\u4f3c\u5730\uff0c\u5c06\u5154\u5b50\u7684\u540d\u79f0\u6539\u4e3a'Toast'\u4f1a\u8d4b\u4e88\u5b83\u72ec\u7279\u7684\u76ae\u80a4\u3002\u5c1d\u8bd5\u5176\u4ed6\u540d\u79f0\u7ec4\u5408\u4ee5\u4e86\u89e3\u66f4\u591a\u3002\u8fd9\u4e9b\u9690\u85cf\u7684\u60ca\u559c\u662f\u5c06\u4e50\u8da3\u6dfb\u52a0\u5230\u4f60\u7684\u6e38\u620f\u4e2d\u7684\u7edd\u4f73\u65b9\u5f0f\u3002"}]
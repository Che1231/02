[{"question": "Paper \ub9c8\uc778\ud06c\ub798\ud504\ud2b8: \uac8c\uc784 \uc2dc\uc791 \uc2dc \uae30\ubcf8 \ub3c4\uad6c\ub97c \ub9cc\ub4dc\ub294 \ubc29\ubc95\uacfc \ucd08\uae30\uc5d0\ub294 \uc5b4\ub5a4 \uc7ac\ub8cc\ub97c \uac00\uc7a5 \ud6a8\uc728\uc801\uc73c\ub85c \uc0ac\uc6a9\ud574\uc57c \ud560\uae4c\uc694?", "answer": "\uc0c8\ub85c\uc6b4 Paper \ub9c8\uc778\ud06c\ub798\ud504\ud2b8 \ud50c\ub808\uc774\uc5b4\ub77c\uba74 \uba3c\uc800 \ub098\ubb34 \ub3c4\uad6c\ub97c \ub9cc\ub4dc\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \ub098\ubb34\ub97c \uccd0\uc11c \ub098\ubb34 \uc6d0\ubaa9\uc744 \uc5bb\uc73c\uc138\uc694. 2\ub2e8\uacc4: \uc778\ubca4\ud1a0\ub9ac \uc81c\uc791 \ucc3d\uc5d0\uc11c \uc6d0\ubaa9\uc744 \ud310\uc790\ub85c \ubc14\uafb8\uc138\uc694. 3\ub2e8\uacc4: \uc81c\uc791\ub300, \ub9c9\ub300, \uadf8\ub9ac\uace0 \ub9c8\uce68\ub0b4 \ub3c4\uad6c\ub97c \ub9cc\ub4dc\uc138\uc694. \ub098\ubb34\ub294 \ucd08\uae30\uc5d0\ub294 \ucda9\ubd84\ud569\ub2c8\ub2e4. \ud2b9\ud788, \ub098\ubb34 \uace1\uad2d\uc774\ub294 \ub3cc\uc744 \uce90\ub294 \ub370 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc73c\ubbc0\ub85c \ub354 \ub0b4\uad6c\uc131\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ub098\ubb34 \ub3c4\uad6c\ub294 \ub3cc \ub3c4\uad6c\ub85c \ubc14\ub00c\uae30 \uc804\uae4c\uc9c0\uc758 \uc5f0\uc2b5\uc6a9 \ubc14\ud034\ub77c\uace0 \uc0dd\uac01\ud558\uc138\uc694."}, {"question": "Paper \ub9c8\uc778\ud06c\ub798\ud504\ud2b8\uc758 \ubc30\uace0\ud514 \uc2dc\uc2a4\ud15c\uc5d0 \ub300\ud574 \uc124\uba85\ud574\uc8fc\uc138\uc694. \uc65c \uce90\ub9ad\ud130\uac00 \uacc4\uc18d \ubc30\uac00 \uace0\ud508\uac00\uc694? \uadf8\ub9ac\uace0 \ucd08\ubc18\uc5d0 \uad76\uc8fc\ub9bc\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc5b4\ub5bb\uac8c \uad00\ub9ac\ud574\uc57c \ud560\uae4c\uc694?", "answer": "Paper \ub9c8\uc778\ud06c\ub798\ud504\ud2b8\uc5d0\uc11c \ucc44\uad11\uacfc \uac19\uc740 \ud589\ub3d9\uc744 \ud558\uba74 \ubc30\uace0\ud514 \uac8c\uc774\uc9c0\uac00 \uc904\uc5b4\ub4ed\ub2c8\ub2e4. \uac8c\uc774\uc9c0\uac00 \ube44\uba74 \uccb4\ub825\uc774 \uac10\uc18c\ud569\ub2c8\ub2e4. \ucd08\uae30\uc5d0\ub294 \uac04\ub2e8\ud55c \uc74c\uc2dd \uacf5\uae09\uc6d0\uc5d0 \uc9d1\uc911\ud558\uc138\uc694. 1\ub2e8\uacc4: \ub2ed\uc774\ub098 \ub3fc\uc9c0\uc640 \uac19\uc740 \uc190\uc27d\uac8c \uad6c\ud560 \uc218 \uc788\ub294 \ub3d9\ubb3c\uc744 \uc0ac\ub0e5\ud574\uc11c \uace0\uae30\ub97c \uc5bb\uc73c\uc138\uc694. 2\ub2e8\uacc4: \uc6a9\uad11\ub85c\ub97c \ub9cc\ub4e4\uc5b4 \uace0\uae30\ub97c \uad7d\uc2b5\ub2c8\ub2e4. \uad7d\ub294 \uace0\uae30\ub294 \ud3ec\ub9cc\uac10(\ubc30\uace0\ud514 \uac8c\uc774\uc9c0\uac00 \ucc44\uc6cc\uc9c0\ub294 \uc2dc\uac04)\uc744 \ub354 \uc624\ub798 \uc720\uc9c0\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \uc5f4\ub9e4\ub97c \ucc3e\uc73c\uc138\uc694. \ucd08\ubc18 \uac8c\uc784 \uc804\ub7b5\uc740 \ud56d\uc0c1 \uc775\ud78c \uace0\uae30\ub97c \uac00\uc9c0\uace0 \ub2e4\ub2c8\uba70 \ubc30\uac00 \uace0\ud50c \ub54c\ub9c8\ub2e4 \uba39\ub294 \uac83\uc785\ub2c8\ub2e4. \ud604\uc2e4\uacfc \ub9c8\ucc2c\uac00\uc9c0\ub85c \uc5d0\ub108\uc9c0\ub97c \uc720\uc9c0\ud558\uae30 \uc704\ud574\uc11c\ub294 \uc815\uae30\uc801\uc73c\ub85c \uc2dd\uc0ac\ud574\uc57c \ud569\ub2c8\ub2e4."}, {"question": "Paper \ub9c8\uc778\ud06c\ub798\ud504\ud2b8: \uc11c\ub85c \ub2e4\ub978 \uc0dd\ubb3c\uad70\uacc4\ub294 \ubb34\uc5c7\uc774\uba70, \ucd08\ubc18 \uac8c\uc784\uc5d0\uc11c \uc774\ub97c \uc774\ud574\ud558\ub294 \uac83\uc774 \uc5b4\ub5a4 \uc774\uc810\uc744 \uc904\uae4c\uc694? \uac01 \uc0dd\ubb3c\uad70\uacc4\uc5d0 \uace0\uc720\ud55c \uc790\uc6d0\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Paper \ub9c8\uc778\ud06c\ub798\ud504\ud2b8\ub294 \uc232, \uc0ac\ub9c9, \ub208 \ub36e\uc778 \ud3c9\uc6d0\uacfc \uac19\uc740 \ub2e4\uc591\ud55c \uc0dd\ubb3c\uad70\uacc4\ub97c \uc790\ub791\ud569\ub2c8\ub2e4. \uac01 \uc0dd\ubb3c\uad70\uacc4\ub294 \uace0\uc720\ud55c \uc790\uc6d0\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc232\uc740 \ub098\ubb34\uac00 \ud48d\ubd80\ud558\uace0, \uc0ac\ub9c9\uc740 \ub179\uc0c9 \uc5fc\ub8cc\ub85c \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \uc120\uc778\uc7a5\uc744 \uc81c\uacf5\ud558\uba70, \ub208 \ub36e\uc778 \uc0dd\ubb3c\uad70\uacc4\ub294 \uc5bc\uc74c\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \uc8fc\ubcc0 \uc0dd\ubb3c\uad70\uacc4\ub97c \uc9c0\ub3c4\ub85c \ub9cc\ub4e4\uae30 \uc704\ud574 \ud0d0\ud5d8\ud558\uc138\uc694. 2\ub2e8\uacc4: \uc0ac\ub9c9 \uc0dd\ubb3c\uad70\uacc4\uc5d0\uc11c \ubb3c \uadfc\ucc98\uc5d0 \uc788\ub294 \uc0ac\ud0d5\uc218\uc218 \uac19\uc740 \uc774\uc6a9 \uac00\ub2a5\ud55c \uc790\uc6d0\uc744 \uae30\ub85d\ud558\uc138\uc694. 3\ub2e8\uacc4: \ud544\uc694\ud55c \uc790\uc6d0\uc744 \uc27d\uac8c \uc5bb\uc744 \uc218 \uc788\ub3c4\ub85d \uc232\uacfc \ud3c9\uc6d0 \uadfc\ucc98\uc5d0 \uae30\uc9c0\ub97c \uc138\uc6b0\uc138\uc694. \uc232\uacfc \ud3c9\uc6d0 \uadfc\ucc98\uc5d0 \uae30\uc9c0\ub97c \ub450\ub294 \uac83\uc744 \uace0\ub824\ud558\uc138\uc694. \uc0dd\ubb3c\uad70\uacc4\ub294 \uac01\uac01 \ud2b9\uc815 \uc81c\ud488\uc744 \uc804\ubb38\uc73c\ub85c \ud558\ub294 \uc1fc\ud551\uc13c\ud130 \ub0b4\uc758 \ub2e4\ub978 \uc0c1\uc810\uacfc \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uc138\uc694."}, {"question": "\uacbd\ud5d8 \ub9ce\uc740 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \uc9c8\ubb38: PaperMC: \uc9c0\uc18d\uc801\uc778 \uc790\uc6d0 \ubc0f \uacbd\ud5d8\uce58\ub97c \uc5bb\uae30 \uc704\ud55c \ud6a8\uc728\uc801\uc778 \ubab9 \ub18d\uc7a5\uc744 \uc5b4\ub5bb\uac8c \uc124\uc815\ud558\uace0, \uc5b4\ub5a4 \ub18d\uc7a5 \uc124\uacc4\uac00 \uac00\uc7a5 \uc798 \ud655\uc7a5\ub420\uae4c\uc694?", "answer": "\ubab9 \ub18d\uc7a5\uc744 \uc124\uc815\ud558\ub294 \uac83\uc740 \uc790\uc6d0 \uc218\uc9d1\uacfc \uacbd\ud5d8\uce58\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc5b4\ub450\uc6b4 \ubc29 \uc124\uacc4\ub294 \uc88b\uc740 \uc2dc\uc791\uc785\ub2c8\ub2e4. 1\ub2e8\uacc4: \uc5b4\ub450\uc6b4 \uc9c0\uc5ed\uc744 \ucc3e\uac70\ub098 \ube5b\uc73c\ub85c\ubd80\ud130 \ub2e8\uc808\ub41c \uad6c\uc870\ub97c \ub9cc\ub4dc\uc138\uc694. 2\ub2e8\uacc4: \ub0b4\ubd80\uc5d0 \ud070 \ud3c9\ud3c9\ud55c \ud50c\ub7ab\ud3fc\uc744 \ub9cc\ub4dc\uc138\uc694. 3\ub2e8\uacc4: \ubb3c\uc904\uae30\ub97c \ucd94\uac00\ud558\uc5ec \ubab9\uc774 \uc911\uc559 \ub099\ud558 \uc9c0\uc810\uc73c\ub85c \ubc00\ub9ac\ub3c4\ub85d \ud558\uc138\uc694. \ub099\ud558 \ub192\uc774\ub294 \uce58\uba85\uc801\uc778 \ud53c\ud574\ub97c \uc785\ud788\uace0, \ub0a8\uc740 \uc794\ud574\ub294 \uce7c \ud55c \ubc29\uc73c\ub85c \uc81c\uac70\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc5b4\ub450\uc6b4 \ubc29 \uc124\uacc4\ub294 \ud50c\ub7ab\ud3fc\uc744 \ud655\uc7a5\ud558\uc5ec \uc798 \ud655\uc7a5\ub429\ub2c8\ub2e4. \ub18d\uc7a5 \uc8fc\ubcc0\uc5d0 \ud1a0\uce58\ub97c \uc124\uce58\ud558\uba74 \ubab9 \uc0dd\uc131\ub960\uc774 \uac10\uc18c\ud569\ub2c8\ub2e4."}, {"question": "Paper \ub9c8\uc778\ud06c\ub798\ud504\ud2b8: \uc5d4\ub354 \ub4dc\ub798\uace4\uc744 \ubb3c\ub9ac\uce58\ub294 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc774\uba70, \uc131\uacf5 \ud655\ub960\uc744 \ub192\uc774\uae30 \uc704\ud574 \uc6b0\uc120\uc801\uc73c\ub85c \uc5b4\ub5a4 \uc7a5\ube44\ub97c \uc900\ube44\ud574\uc57c \ud560\uae4c\uc694?", "answer": "\uc5d4\ub354 \ub4dc\ub798\uace4\uc744 \ubb3c\ub9ac\uce58\ub824\uba74 \uc2e0\uc911\ud55c \uc900\ube44\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \ub2e4\uc774\uc544\ubaac\ub4dc \uac11\uc637\uacfc \uac15\ub825\ud55c \ud65c(\ud798\uacfc \ubb34\ud55c \ubc1c\uc0ac\uc640 \uac19\uc740 \ub9c8\ubc95 \ud6a8\uacfc \uc635\uc158 \ud3ec\ud568)\uc744 \ud68d\ub4dd\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \uc608\uce21\uce58 \ubabb\ud55c \uc0c1\ud669\uc5d0 \ub300\ube44\ud558\uc5ec \uce58\uc720 \ud3ec\uc158\uacfc \ub290\ub9b0 \ub099\ud558 \ud3ec\uc158(\uc120\ud0dd \uc0ac\ud56d)\uc744 \ucda9\ubd84\ud788 \uc900\ube44\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \ud751\uc694\uc11d \ud0d1 \uc704\uc758 \uc5d4\ub354 \uacb0\uc815\uccb4\ub97c \ud30c\uad34\ud569\ub2c8\ub2e4. \uc774 \uacb0\uc815\uccb4\ub294 \ub4dc\ub798\uace4\uc744 \uce58\uc720\ud558\ubbc0\ub85c \uc6b0\uc120\uc801\uc73c\ub85c \ud30c\uad34\ud569\ub2c8\ub2e4. \uadf8 \ud6c4 \ub4dc\ub798\uace4\uc774 \ud3ec\ud138 \ubd84\uc218 \uc704\uc5d0 \uc549\uc744 \ub54c \ud65c\ub85c \uacf5\uaca9\ud558\uace0 \ub545\uc5d0 \ucc29\ub959\ud588\uc744 \ub54c\ub294 \uac80\uc73c\ub85c \uacf5\uaca9\ud574\uc8fc\uc138\uc694. \uac15\ub825\ud55c \ub9c8\ubc95 \ud65c\uacfc \ub2e4\uc774\uc544\ubaac\ub4dc \uac11\uc637\uc740 \ucd5c\ud6c4\uc758 \ubcf4\ub8e8\uc785\ub2c8\ub2e4."}, {"question": "Paper \ub9c8\uc778\ud06c\ub798\ud504\ud2b8\uc5d0\uc11c \ub18d\uc5c5\uc774\ub098 \uad11\uc11d \ucc44\uad11\uacfc \uac19\uc740 \uc790\uc6d0 \uc218\uc9d1\uc744 \uc790\ub3d9\ud654\ud558\ub294 \uac00\uc7a5 \uc88b\uc740 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc774\uba70, \uc778\uae30 \uc788\ub294 \uc790\ub3d9\ud654 \uc124\uacc4\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc790\ub3d9\ud654\ub41c \uc790\uc6d0 \uc218\uc9d1\uc740 \uac8c\uc784\ud50c\ub808\uc774\ub97c \uac04\uc18c\ud654\ud569\ub2c8\ub2e4. \ub18d\uc5c5\uc758 \uacbd\uc6b0, \uacbd\uc791\uc9c0 \uc544\ub798\uc5d0 \ub099\ud558 \uc0c1\uc790\ub97c \uc124\uce58\ud558\uc5ec \uc218\ud655\ud55c \uc791\ubb3c\uc744 \uc218\uc9d1\ud569\ub2c8\ub2e4. \uad11\uc11d \ucc44\uad11\uc758 \uacbd\uc6b0, \ud3ed\ud30c \ube14\ub85d\uc744 \uac00\uc9c4 \ube44\ud589 \uae30\uacc4\ub97c \uc0ac\uc6a9\ud558\ub294 \uac83\uc744 \uace0\ub824\ud558\uc138\uc694. 1\ub2e8\uacc4: \uad00\uac1c\ub97c \uc704\ud55c \ubb3c\uae38\uc774 \uc788\ub294 \ub18d\uc791\uc9c0 \uc601\uc5ed\uc744 \ub514\uc790\uc778\ud558\uc138\uc694. 2\ub2e8\uacc4: \uc218\ud655\ud55c \uc791\ubb3c\uc744 \uc218\uc9d1\ud558\uae30 \uc704\ud574 \uacbd\uc791\uc9c0 \uc544\ub798\uc5d0 \ub099\ud558 \uc0c1\uc790\ub97c \uc124\uce58\ud558\uc138\uc694. 3\ub2e8\uacc4: \ub099\ud558 \uc0c1\uc790\ub97c \uc790\ub3d9 \uc800\uc7a5\uc744 \uc704\ud55c \uac00\uc2b4\uc5d0 \uc5f0\uacb0\ud558\uc138\uc694. \uacf5\uc7a5 \uc870\ub9bd \ub77c\uc778\uacfc \uac19\uc774 \uc790\ub3d9\ud654\ub41c \ud504\ub85c\uc138\uc2a4\ub294 \uafb8\uc900\ud55c \uc790\uc6d0 \uacf5\uae09\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "Paper \ub9c8\uc778\ud06c\ub798\ud504\ud2b8\ub294 \uc138\uacc4 \uc0dd\uc131\uc744 \uc5b4\ub5bb\uac8c \ucc98\ub9ac\ud558\uba70, \uc11c\ub85c \ub2e4\ub978 \uc2dc\ub4dc\uc5d0\uc11c \uc0dd\ubb3c\uad70\uacc4 \ubd84\ud3ec \ubc0f \uad6c\uc870 \ubc30\uce58 \ub4a4\uc758 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Paper \ub9c8\uc778\ud06c\ub798\ud504\ud2b8\uc758 \uc138\uacc4 \uc0dd\uc131\uc740 \uc2dc\ub4dc \uac12\uc5d0 \ub530\ub77c \uc9c0\ud615\uc744 \ub9cc\ub4dc\ub294 \uc54c\uace0\ub9ac\uc998\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc774 \uc2dc\ub4dc\ub294 \uc0dd\ubb3c\uad70\uacc4, \uad6c\uc870\ubb3c \ubc0f \uc790\uc6d0\uc758 \ubc30\uce58\ub97c \uacb0\uc815\ud569\ub2c8\ub2e4. \uc138\uacc4 \uc0dd\uc131 \uacfc\uc815\uc740 \uc5ec\ub7ec \uc694\uc18c\ub97c \uace0\ub824\ud569\ub2c8\ub2e4. \uc0dd\ubb3c\uad70\uacc4 \ubc30\uce58\ub294 \uc885\uc885 \uc628\ub3c4\uc640 \uc2b5\ub3c4 \ub9e4\uac1c\ubcc0\uc218\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc73c\uba70, \ub9c8\uc744\uacfc \uac19\uc740 \uad6c\uc870\ubb3c\uc740 \ud3c9\ud3c9\ud55c \ud45c\uba74\uc5d0 \ubc30\uce58\ub429\ub2c8\ub2e4. \uc2dc\ub4dc\ub97c \ubcc0\uacbd\ud558\uba74 \uc9c0\ud615\uc774 \uc644\uc804\ud788 \ubc14\ub01d\ub2c8\ub2e4. \uc774 \uacfc\uc815\uc740 \ub9e4\uc6b0 \ud06c\uace0 \ubcf5\uc7a1\ud55c \uc218\ud559 \ud568\uc218\uc640 \uc720\uc0ac\ud55c \ubcf5\uc7a1\ud55c \uc218\ud559\uc801 \uacc4\uc0b0\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \uc2dc\ub4dc\ub294 \uadf8 \ud568\uc218\uc758 \ucd9c\ub825\uac12\uc744 \uacb0\uc815\ud569\ub2c8\ub2e4."}, {"question": "PaperMC: \uc77c\ubd80 \ub808\ub4dc\uc2a4\ud1a4 \ud68c\ub85c\uac00 \uc608\uc0c1\ub300\ub85c \uc791\ub3d9\ud558\uc9c0 \uc54a\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \ubcf5\uc7a1\ud55c \ub17c\ub9ac \uac8c\uc774\ud2b8\ub97c \ucc98\ub9ac\ud560 \ub54c \uc815\ud655\ud558\uac8c \ubb38\uc81c \ud574\uacb0\uc744 \ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub808\ub4dc\uc2a4\ud1a4 \ud68c\ub85c\uc758 \uc624\ub958\ub294 \uc885\uc885 \uc640\uc774\uc5b4 \ubc30\uce58 \uc624\ub958 \ub610\ub294 \uc804\ub825 \uc218\uc900\uc5d0\uc11c \ubc1c\uc0dd\ud569\ub2c8\ub2e4. \ubb38\uc81c \ud574\uacb0\uc740 \uccb4\uacc4\uc801\uc778 \ud14c\uc2a4\ud2b8\ub97c \uc218\ubc18\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \ubc18\ubcf5\uae30\ub97c \uc0ac\uc6a9\ud558\uc5ec \uacb0\ud568 \ubd80\ubd84\uc744 \ubd84\ub9ac\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \uac01 \uad6c\uc131 \uc694\uc18c\ub97c \uac1c\ubcc4\uc801\uc73c\ub85c \ud14c\uc2a4\ud2b8\ud569\ub2c8\ub2e4. \uad00\ucc30\uc790\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud2b9\uc815 \uad6c\uc131 \uc694\uc18c\uac00 \uc608\uc0c1\ub300\ub85c \uc2e0\ud638\ub97c \ucd9c\ub825\ud558\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \ub514\uc790\uc778\uc744 \ub354 \uc2dc\uac01\uc801\uc73c\ub85c \uc7ac\uad6c\uc131\ud569\ub2c8\ub2e4(\uc608: \uc139\uc158 \ub77c\ubca8). \uc798\ubabb\ub41c \uc2e0\ud638 \uac15\ub3c4 \ub610\ub294 \ucc28\ub2e8\ub41c \uacbd\ub85c\uac00 \ubc1c\uacac\ub418\ub294 \uacbd\uc6b0\uac00 \uc7a6\uc2b5\ub2c8\ub2e4. \uba40\ud2f0\ubbf8\ud130\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc804\uc790 \ud68c\ub85c\ub97c \ubb38\uc81c \ud574\uacb0\ud560 \uc218 \uc788\uc73c\uba70, \uc5ec\uae30\uc11c\ub3c4 \uac01 \uad6c\uc131 \uc694\uc18c\ub97c \ubd84\ub9ac\ud558\ub294 \uc720\uc0ac\ud55c \ubc29\ubc95\uc774 \uc0ac\uc6a9\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Paper \ub9c8\uc778\ud06c\ub798\ud504\ud2b8\ub294 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud638\ud658\uc774 \uac00\ub2a5\ud55c\uac00\uc694? \ub2e4\ub978 \ubc84\uc804(\uc608: \ubca0\ub4dc\ub77d \ub300 \uc790\ubc14)\uc5d0 \uc788\ub294 \uce5c\uad6c\ub4e4\uacfc \ud568\uaed8 \uac8c\uc784\uc744 \ud560 \uc218 \uc788\ub098\uc694?", "answer": "Paper \ub9c8\uc778\ud06c\ub798\ud504\ud2b8\ub294 \uc8fc\ub85c \uc790\ubc14 \uc5d0\ub514\uc158\uc5d0\uc11c \uc2e4\ud589\ub429\ub2c8\ub2e4. \uc790\ubc14 \uc5d0\ub514\uc158\uc740 \ubca0\ub4dc\ub77d \uc5d0\ub514\uc158\uacfc \uc9c1\uc811 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud638\ud658\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ud568\uaed8 \ud50c\ub808\uc774\ud558\ub824\uba74 \ubaa8\ub450 \uc790\ubc14 \uc5d0\ub514\uc158\uc744 \uc0ac\uc6a9\ud558\uac70\ub098 \ud06c\ub85c\uc2a4 \ud50c\ub808\uc774\ub97c \uc704\ud574 \ud2b9\ubcc4\ud788 \uc124\uacc4\ub41c \ube0c\ub9ac\uc9c0\ub97c \uad6c\ud604\ud558\ub294 \uc11c\ubc84\ub97c \uc0ac\uc6a9\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ube0c\ub9ac\uc9c0\ub294 \uacf5\uc2dd\uc801\uc73c\ub85c \uac8c\uc784\uc758 \uc77c\ubd80\ub294 \uc544\ub2c8\ubbc0\ub85c \ud0c0\uc0ac \uc635\uc158\uc744 \uc0b4\ud3b4\ubcf4\uc544\uc57c \ud569\ub2c8\ub2e4. \uc790\ubc14\uc640 \ubca0\ub4dc\ub77d\uc740 \uc57d\uac04 \ub2e4\ub978 \uc5b8\uc5b4\ub97c \uc0ac\uc6a9\ud558\ub294 \uac83\uacfc \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uc138\uc694. \ubc88\uc5ed \uc11c\ube44\uc2a4\ub294 \uc758\uc0ac\uc18c\ud1b5 \uaca9\ucc28\ub97c \uba54\uc6c1\ub2c8\ub2e4."}, {"question": "Paper \ub9c8\uc778\ud06c\ub798\ud504\ud2b8\uc5d0\ub294 \uc9c0\uc815\ub41c \ubab9\uc774\ub098 \ud2b9\uc815 \uc544\uc774\ud15c \uc870\ud569\uacfc \uad00\ub828\ub41c \ub35c \uc54c\ub824\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8 \ub610\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774 \uc788\ub098\uc694?", "answer": "\ub3c5\ud2b9\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uc774\ub984\ud45c\ub97c \uc0ac\uc6a9\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc591\uc5d0\uac8c \"jeb_\"!\ub77c\ub294 \uc774\ub984\uc744 \uc9c0\uc815\ud558\uba74 \uc591\uc758 \ud138\uc774 \ubaa8\ub4e0 \uc0c9\uc0c1\uc73c\ub85c \uc21c\ud658\ud569\ub2c8\ub2e4. \uc774\ub294 \uc774\ub984\ud45c\ub97c \ub9dd\uce58\ub85c \uc774\ub984\uc744 \ubc14\uafb8\uace0 \uc774 \uc774\ub984\ud45c\ub97c \uc591\uc5d0 \uc0ac\uc6a9\ud558\ub294 \ubc29\ubc95\uc73c\ub85c \uc774\ub8e8\uc5b4\uc9d1\ub2c8\ub2e4. \ub9c8\ucc2c\uac00\uc9c0\ub85c \ud1a0\ub07c\uc5d0 '\ud1a0\uc2a4\ud2b8'\ub77c\ub294 \uc774\ub984\uc744 \uc9c0\uc815\ud558\uba74 \uace0\uc720\ud55c \uc2a4\ud0a8\uc774 \uc81c\uacf5\ub429\ub2c8\ub2e4. \ub2e4\ub978 \uc774\ub984 \uc870\ud569\uc744 \uc2dc\ub3c4\ud558\uc5ec \uc790\uc138\ud55c \ub0b4\uc6a9\uc744 \uc54c\uc544\ubcf4\uc138\uc694. \uc774 \uc228\uaca8\uc9c4 \ubcf4\uc11d\uc740 \uac8c\uc784\uc5d0 \uc7ac\ubbf8\uc788\ub294 \ub180\ub77c\uc6c0\uc744 \ub354\ud558\ub294 \uc88b\uc740 \ubc29\ubc95\uc785\ub2c8\ub2e4."}]
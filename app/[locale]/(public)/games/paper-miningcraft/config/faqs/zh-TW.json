[{"question": "Paper Minecraft\uff1a\u525b\u958b\u59cb\u904a\u6232\u6642\uff0c\u5982\u4f55\u88fd\u4f5c\u57fa\u672c\u5de5\u5177\uff0c\u4ee5\u53ca\u521d\u671f\u6700\u6709\u6548\u7684\u6750\u6599\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5c0d\u65bc\u65b0\u624bPaper Minecraft\u73a9\u5bb6\u4f86\u8aaa\uff0c\u9996\u5148\u88fd\u4f5c\u6728\u982d\u5de5\u5177\u81f3\u95dc\u91cd\u8981\u3002\u6b65\u9a5f1\uff1a\u780d\u4f10\u6a39\u6728\uff0c\u7372\u5f97\u6728\u982d\u539f\u6728\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u7269\u54c1\u6b04\u7684\u5de5\u85dd\u7db2\u683c\uff0c\u5c07\u539f\u6728\u8f49\u63db\u6210\u6728\u677f\u3002\u6b65\u9a5f3\uff1a\u88fd\u4f5c\u5de5\u4f5c\u81fa\uff0c\u7136\u5f8c\u88fd\u4f5c\u6728\u68cd\uff0c\u6700\u5f8c\u88fd\u4f5c\u5de5\u5177\u3002\u521d\u671f\uff0c\u6728\u982d\u5c31\u8db3\u5920\u4e86\u3002\u5177\u9ad4\u4f86\u8aaa\uff0c\u88fd\u4f5c\u6728\u982d\u91d1\u65a7\u982d\u53ef\u4ee5\u8b93\u4f60\u6316\u6398\u77f3\u982d\uff0c\u77f3\u982d\u7684\u8010\u4e45\u5ea6\u66f4\u9ad8\u3002\u628a\u6728\u982d\u5de5\u5177\u60f3\u8c61\u6210\u4f60\u958b\u59cb\u9a0e\u81ea\u884c\u8eca\u524d\u7684\u8a13\u7df4\u8f2a\uff0c\u7b49\u719f\u6089\u5f8c\uff0c\u4f60\u5c31\u53ef\u4ee5\u6539\u7528\u66f4\u7a69\u56fa\u7684\u77f3\u982d\u5de5\u5177\u4e86\u3002"}, {"question": "Paper Minecraft\u7684\u98e2\u9913\u7cfb\u7d71\u662f\u600e\u9ebc\u56de\u4e8b\uff1f\u70ba\u4ec0\u9ebc\u6211\u7684\u89d2\u8272\u7e3d\u662f\u611f\u5230\u98e2\u9913\uff0c\u4ee5\u53ca\u5982\u4f55\u6709\u6548\u5730\u7ba1\u7406\u521d\u671f\u98e2\u9913\uff0c\u907f\u514d\u6328\u9913\uff1f", "answer": "\u5728Paper Minecraft\u4e2d\uff0c\u7576\u4f60\u9032\u884c\u63a1\u7926\u7b49\u52d5\u4f5c\u6642\uff0c\u4f60\u7684\u98e2\u9913\u689d\u6703\u9010\u6f38\u6d88\u8017\u3002\u7576\u5b83\u7a7a\u6389\u6642\uff0c\u4f60\u7684\u751f\u547d\u503c\u6703\u4e0b\u964d\u3002\u521d\u671f\uff0c\u5c08\u6ce8\u65bc\u7c21\u55ae\u7684\u98df\u7269\u4f86\u6e90\u3002\u6b65\u9a5f1\uff1a\u6355\u6349\u5bb9\u6613\u7372\u5f97\u7684\u52d5\u7269\uff0c\u4f8b\u5982\u96de\u548c\u8c6c\uff0c\u53d6\u5f97\u8089\u3002\u6b65\u9a5f2\uff1a\u88fd\u4f5c\u4e00\u500b\u7194\u7210\uff0c\u5c07\u8089\u70e4\u719f\uff1b\u70e4\u8089\u63d0\u4f9b\u66f4\u591a\u7684\u98fd\u8179\u611f\uff08\u98e2\u9913\u689d\u4fdd\u6301\u6eff\u503c\u7684\u6301\u7e8c\u6642\u9593\uff09\u3002\u6b65\u9a5f3\uff1a\u5c0b\u627e\u6f3f\u679c\u3002\u5728\u904a\u6232\u521d\u671f\u7684\u4e00\u500b\u826f\u597d\u7b56\u7565\u662f\u96a8\u6642\u651c\u5e36\u70e4\u8089\uff0c\u4e26\u5728\u98e2\u9913\u611f\u4e0b\u964d\u6642\u98df\u7528\u3002\u5c31\u50cf\u73fe\u5be6\u751f\u6d3b\u4e00\u6a23\uff0c\u4f60\u9700\u8981\u5b9a\u671f\u9032\u98df\uff0c\u624d\u80fd\u7dad\u6301\u4f60\u7684\u80fd\u91cf\uff01"}, {"question": "Paper Minecraft\uff1a\u4e0d\u540c\u7684\u751f\u7269\u7fa4\u7cfb\u6709\u54ea\u4e9b\uff0c\u4ee5\u53ca\u4e86\u89e3\u5b83\u5011\u5982\u4f55\u5728\u521d\u671f\u904a\u6232\u4e2d\u70ba\u6211\u5e36\u4f86\u76ca\u8655\uff1f\u6bcf\u7a2e\u751f\u7269\u7fa4\u7cfb\u7368\u7279\u7684\u8cc7\u6e90\u662f\u4ec0\u9ebc\uff1f", "answer": "Paper Minecraft\u64c1\u6709\u5404\u7a2e\u5404\u6a23\u7684\u751f\u7269\u7fa4\u7cfb\uff0c\u4f8b\u5982\u68ee\u6797\u3001\u6c99\u6f20\u548c\u96ea\u539f\u3002\u6bcf\u7a2e\u751f\u7269\u7fa4\u7cfb\u90fd\u63d0\u4f9b\u7368\u7279\u7684\u8cc7\u6e90\u3002\u68ee\u6797\u5bcc\u542b\u6728\u6750\uff0c\u6c99\u6f20\u63d0\u4f9b\u4ed9\u4eba\u638c\uff08\u53ef\u7528\u65bc\u7da0\u8272\u67d3\u6599\uff09\uff0c\u800c\u96ea\u539f\u63d0\u4f9b\u51b0\u584a\u3002\u6b65\u9a5f1\uff1a\u63a2\u7d22\u4ee5\u7e6a\u88fd\u5468\u570d\u751f\u7269\u7fa4\u7cfb\u7684\u8def\u7dda\u3002\u6b65\u9a5f2\uff1a\u8a18\u4e0b\u53ef\u7528\u7684\u8cc7\u6e90\uff0c\u4f8b\u5982\u5728\u6c99\u6f20\u751f\u7269\u7fa4\u7cfb\u4e2d\u5728\u6c34\u908a\u627e\u5230\u7518\u8517\u3002\u6b65\u9a5f3\uff1a\u5728\u9760\u8fd1\u64c1\u6709\u5fc5\u8981\u8cc7\u6e90\u7684\u751f\u7269\u7fa4\u7cfb\u9644\u8fd1\u5efa\u7acb\u4f60\u7684\u57fa\u5730\u3002\u8003\u616e\u5728\u68ee\u6797\u548c\u5e73\u539f\u9644\u8fd1\u5efa\u7acb\u57fa\u5730\uff0c\u4ee5\u4fbf\u8f15\u9b06\u53d6\u5f97\u6728\u6750\u548c\u98df\u7269\u3002\u628a\u751f\u7269\u7fa4\u7cfb\u60f3\u6210\u8cfc\u7269\u4e2d\u5fc3\u88cf\u4e0d\u540c\u7684\u5546\u5e97\uff0c\u6bcf\u5bb6\u5546\u5e97\u5c08\u9580\u92b7\u552e\u67d0\u4e9b\u7522\u54c1\u3002"}, {"question": "\u7d66\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\uff1aPaperMC\uff1a\u5982\u4f55\u5efa\u7acb\u4e00\u500b\u6709\u6548\u7684\u602a\u7269\u8fb2\u5834\u4f86\u6301\u7e8c\u7372\u5f97\u8cc7\u6e90\u548c\u7d93\u9a57\u503c\uff0c\u4ee5\u53ca\u54ea\u7a2e\u8fb2\u5834\u8a2d\u8a08\u6700\u9069\u5408\u64f4\u5c55\uff1f", "answer": "\u5efa\u7acb\u602a\u7269\u8fb2\u5834\u5c0d\u65bc\u6536\u96c6\u8cc7\u6e90\u548c\u7d93\u9a57\u503c\u81f3\u95dc\u91cd\u8981\u3002\u4e00\u500b\u7c21\u55ae\u7684\u9ed1\u6697\u623f\u9593\u8a2d\u8a08\u662f\u4e00\u500b\u5f88\u597d\u7684\u8d77\u9ede\uff1a\u6b65\u9a5f1\uff1a\u627e\u5230\u4e00\u500b\u9ed1\u6697\u5340\u57df\u6216\u5efa\u9020\u8207\u5149\u7dda\u9694\u7d55\u7684\u7d50\u69cb\u3002\u6b65\u9a5f2\uff1a\u5728\u88e1\u9762\u5efa\u7acb\u4e00\u500b\u5927\u578b\u5e73\u81fa\u3002\u6b65\u9a5f3\uff1a\u6dfb\u52a0\u6c34\u6d41\u5c07\u602a\u7269\u63a8\u5411\u4e2d\u592e\u589c\u843d\u9ede\u3002\u589c\u843d\u7684\u61f8\u5d16\u9ad8\u5ea6\u6703\u9020\u6210\u81f4\u547d\u50b7\u5bb3\uff0c\u800c\u5c11\u6578\u6b98\u9ab8\u53ef\u4ee5\u7528\u4f60\u7684\u528d\u780d\u6b7b\u3002\u9ed1\u6697\u623f\u9593\u7684\u8a2d\u8a08\u53ef\u4ee5\u900f\u904e\u64f4\u5c55\u5e73\u81fa\u4f86\u64f4\u5c55\u3002\u8acb\u8a18\u4f4f\uff0c\u8fb2\u5834\u5468\u570d\u7684\u706b\u628a\u6703\u6e1b\u5c11\u602a\u7269\u7684\u751f\u6210\u7387\u3002"}, {"question": "Paper Minecraft\uff1a\u61c9\u5c0d\u672b\u5f71\u9f8d\u6700\u6709\u6548\u7684\u7b56\u7565\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u70ba\u4e86\u589e\u52a0\u6210\u529f\u7387\uff0c\u6211\u61c9\u8a72\u512a\u5148\u8003\u616e\u54ea\u4e9b\u88dd\u5099\uff1f", "answer": "\u64ca\u6557\u672b\u5f71\u9f8d\u9700\u8981\u4ed4\u7d30\u7684\u6e96\u5099\u3002\u6b65\u9a5f1\uff1a\u53d6\u5f97\u947d\u77f3\u88dd\u7532\u548c\u9644\u9b54\u5f37\u5927\u7bad\u77e2\u7684\u5f13\uff08\u4f8b\u5982\u529b\u91cf\u548c\u7121\u9650\uff09\u3002\u6b65\u9a5f2\uff1a\u5132\u5099\u6cbb\u7642\u85e5\u6c34\u548c\u6e1b\u901f\u589c\u843d\u85e5\u6c34\uff08\u9078\u9805\uff09\u4ee5\u61c9\u5c0d\u6f5b\u5728\u7684\u610f\u5916\u3002\u6b65\u9a5f3\uff1a\u6467\u6bc0\u5728\u9ed1\u66dc\u77f3\u5854\u9802\u7684\u672b\u5f71\u6676\u9ad4\uff0c\u56e0\u70ba\u9019\u4e9b\u6676\u9ad4\u6703\u6cbb\u7642\u672b\u5f71\u9f8d\u3002\u9996\u5148\u91cd\u9ede\u6467\u6bc0\u9019\u4e9b\u6676\u9ad4\uff0c\u7136\u5f8c\u5728\u672b\u5f71\u9f8d\u505c\u7559\u5728\u50b3\u9001\u9580\u5674\u6cc9\u4e0a\u6642\uff0c\u5229\u7528\u5f13\u5728\u7a7a\u4e2d\u653b\u64ca\u5b83\uff0c\u7136\u5f8c\u843d\u5730\u6642\u518d\u7528\u528d\u3002\u5f37\u5927\u7684\u9644\u9b54\u5f13\u7bad\u548c\u947d\u77f3\u88dd\u7532\u662f\u4f60\u6700\u5f8c\u7684\u5e0c\u671b\u3002"}, {"question": "\u5728Paper Minecraft\u4e2d\uff0c\u81ea\u52d5\u5316\u8cc7\u6e90\u6536\u96c6\uff08\u4f8b\u5982\u8fb2\u4f5c\u7269\u6216\u7926\u7269\u63a1\u96c6\uff09\u7684\u6700\u4f73\u65b9\u6cd5\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u4e00\u4e9b\u6d41\u884c\u7684\u81ea\u52d5\u5316\u8a2d\u8a08\uff1f", "answer": "\u81ea\u52d5\u5316\u8cc7\u6e90\u6536\u96c6\u6703\u7c21\u5316\u4f60\u7684\u904a\u6232\u9ad4\u9a57\u3002\u5c0d\u65bc\u8fb2\u4f5c\u7269\uff0c\u5728\u8fb2\u7530\u4e0b\u65b9\u5efa\u7acb\u4e00\u500b\u7cfb\u7d71\uff0c\u4f7f\u7528\u6f0f\u6597\u6536\u96c6\u8fb2\u4f5c\u7269\u3002\u5c0d\u65bc\u7926\u7269\u63a1\u96c6\uff0c\u53ef\u4ee5\u8003\u616e\u4f7f\u7528\u5e36\u6709\u65b9\u584a\u7834\u58de\u5668\u7684\u98db\u884c\u6a5f\u5668\u3002\u6b65\u9a5f1\uff1a\u8a2d\u8a08\u4e00\u500b\u5e36\u6709\u704c\u6e89\u6c34\u6e20\u7684\u8fb2\u4f5c\u5340\u3002\u6b65\u9a5f2\uff1a\u5728\u8fb2\u7530\u4e0b\u65b9\u653e\u7f6e\u6f0f\u6597\u6536\u96c6\u6536\u7a6b\u7684\u8fb2\u4f5c\u7269\u3002\u6b65\u9a5f3\uff1a\u5c07\u6f0f\u6597\u9023\u63a5\u5230\u7bb1\u5b50\u4ee5\u9032\u884c\u81ea\u52d5\u5316\u5132\u5b58\u3002\u81ea\u52d5\u5316\u6d41\u7a0b\u53ef\u78ba\u4fdd\u6750\u6599\u7684\u6301\u7e8c\u4f9b\u61c9\uff0c\u5c31\u50cf\u5de5\u5ee0\u7684\u88dd\u914d\u7dda\u4e00\u6a23\u3002"}, {"question": "Paper Minecraft\u5982\u4f55\u8655\u7406\u4e16\u754c\u751f\u6210\uff0c\u4ee5\u53ca\u4e0d\u540c\u7a2e\u5b50\u4e2d\u7684\u751f\u7269\u7fa4\u7cfb\u5206\u4f48\u548c\u7d50\u69cb\u4f48\u5c40\u80cc\u5f8c\u7684\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "Paper Minecraft\u7684\u4e16\u754c\u751f\u6210\u4f7f\u7528\u6f14\u7b97\u6cd5\u6839\u64da\u7a2e\u5b50\u503c\u5275\u5efa\u5730\u5f62\u3002\u6b64\u7a2e\u5b50\u6c7a\u5b9a\u751f\u7269\u7fa4\u7cfb\u3001\u7d50\u69cb\u548c\u8cc7\u6e90\u7684\u653e\u7f6e\u4f4d\u7f6e\u3002\u4e16\u754c\u751f\u6210\u904e\u7a0b\u8003\u616e\u5404\u7a2e\u56e0\u7d20\uff1a\u751f\u7269\u7fa4\u7cfb\u7684\u653e\u7f6e\u901a\u5e38\u53d7\u6eab\u5ea6\u548c\u6fd5\u5ea6\u53c3\u6578\u7684\u5f71\u97ff\uff0c\u4f8b\u5982\u6751\u838a\u7b49\u7d50\u69cb\u653e\u7f6e\u5728\u5e73\u5766\u7684\u5730\u9762\u4e0a\u3002\u66f4\u6539\u7a2e\u5b50\u5c07\u6703\u5b8c\u5168\u6539\u8b8a\u5730\u5f62\u3002\u9019\u500b\u904e\u7a0b\u5305\u542b\u8907\u96dc\u7684\u6578\u5b78\u8a08\u7b97\uff0c\u5c31\u50cf\u4e00\u500b\u975e\u5e38\u9f90\u5927\u800c\u8907\u96dc\u7684\u6578\u5b78\u51fd\u5f0f\uff0c\u4f46\u7a2e\u5b50\u6c7a\u5b9a\u4e86\u8a72\u51fd\u5f0f\u7684\u8f38\u51fa\u3002"}, {"question": "PaperMC\uff1a\u70ba\u4ec0\u9ebc\u67d0\u4e9b\u7d05\u77f3\u96fb\u8def\u672a\u80fd\u6309\u9810\u671f\u5de5\u4f5c\uff0c\u4ee5\u53ca\u5728\u8655\u7406\u8907\u96dc\u908f\u8f2f\u9598\u6642\uff0c\u5982\u4f55\u6e96\u78ba\u5730\u6392\u9664\u6545\u969c\uff1f", "answer": "\u7d05\u77f3\u96fb\u8def\u6545\u969c\u901a\u5e38\u6e90\u65bc\u96fb\u7dda\u653e\u7f6e\u932f\u8aa4\u6216\u529f\u7387\u4e0d\u8db3\u3002\u6545\u969c\u6392\u9664\u9700\u8981\u6709\u689d\u4e0d\u7d0a\u7684\u6e2c\u8a66\u3002\u6b65\u9a5f1\uff1a\u4f7f\u7528\u4e2d\u7e7c\u5668\u584a\u9694\u96e2\u6545\u969c\u90e8\u5206\u3002\u6b65\u9a5f2\uff1a\u500b\u5225\u6e2c\u8a66\u6bcf\u500b\u7d44\u4ef6\u3002\u4f7f\u7528\u89c0\u5bdf\u8005\u6aa2\u67e5\u67d0\u4e9b\u7d44\u4ef6\u662f\u5426\u6309\u7167\u9810\u671f\u8f38\u51fa\u4fe1\u865f\u3002\u6b65\u9a5f3\uff1a\u63a1\u7528\u66f4\u76f4\u89c0\u7684\u4f48\u5c40\uff08\u4f8b\u5982\u6a19\u8a18\u90e8\u5206\uff09\u3002\u4fe1\u865f\u5f37\u5ea6\u932f\u8aa4\u6216\u8def\u5f91\u963b\u585e\u662f\u5e38\u898b\u7684\u7f6a\u9b41\u798d\u9996\u3002\u842c\u7528\u8868\u53ef\u7528\u65bc\u6545\u969c\u6392\u9664\u96fb\u8def\uff0c\u985e\u4f3c\u5730\uff0c\u53ef\u4ee5\u901a\u904e\u9694\u96e2\u6bcf\u500b\u7d44\u4ef6\u4f86\u9032\u884c\u6545\u969c\u6392\u9664\u3002"}, {"question": "Paper Minecraft\u662f\u5426\u8de8\u5e73\u53f0\u76f8\u5bb9\uff1f\u5982\u679c\u6211\u7684\u670b\u53cb\u4f7f\u7528\u4e0d\u540c\u7684\u7248\u672c\uff08\u4f8b\u5982\uff0c\u57fa\u5ca9\u7248\u8207Java\u7248\uff09\uff0c\u6211\u5011\u662f\u5426\u53ef\u4ee5\u4e00\u8d77\u904a\u6232\uff1f", "answer": "Paper Minecraft\u4e3b\u8981\u904b\u884c\u65bcJava\u7248\u3002Java\u7248\u4e0d\u80fd\u76f4\u63a5\u8207\u57fa\u5ca9\u7248\u8de8\u5e73\u53f0\u76f8\u5bb9\u3002\u70ba\u4e86\u80fd\u5920\u4e00\u8d77\u904a\u6232\uff0c\u4f60\u5011\u90fd\u9700\u8981\u4f7f\u7528Java\u7248\uff0c\u6216\u4f7f\u7528\u5c08\u9580\u70ba\u8de8\u5e73\u53f0\u904a\u6232\u8a2d\u8a08\u7684\u4f3a\u670d\u5668\u6a4b\u63a5\u5668\u3002\u9019\u7a2e\u6a4b\u63a5\u5668\u4e26\u975e\u904a\u6232\u5b98\u65b9\u529f\u80fd\uff0c\u6240\u4ee5\u9700\u8981\u5c0b\u627e\u7b2c\u4e09\u65b9\u9078\u9805\u3002\u53ef\u4ee5\u5c07Java\u7248\u548c\u57fa\u5ca9\u7248\u8996\u70ba\u4f7f\u7528\u7565\u5fae\u4e0d\u540c\u7684\u8a9e\u8a00\uff1b\u7ffb\u8b6f\u670d\u52d9\u6a4b\u63a5\u4e86\u6e9d\u901a\u7684\u9694\u95a1\u3002"}, {"question": "\u5728Paper Minecraft\u4e2d\uff0c\u95dc\u65bc\u547d\u540d\u602a\u7269\u6216\u7279\u5b9a\u7269\u54c1\u7d44\u5408\u7684\u4e00\u4e9b\u9bae\u70ba\u4eba\u77e5\u7684\u5f69\u86cb\u6216\u96b1\u85cf\u529f\u80fd\u662f\u4ec0\u9ebc\uff1f", "answer": "\u4e00\u500b\u7368\u7279\u7684\u5f69\u86cb\u662f\u4f7f\u7528\u540d\u7a31\u6a19\u7c64\uff1a\u5982\u679c\u4f60\u5c07\u7f8a\u7684\u540d\u5b57\u6539\u70ba\"jeb_\", \u5b83\u7684\u7f8a\u6bdb\u984f\u8272\u5c07\u6703\u5faa\u74b0\u8b8a\u5316\u3002\u9019\u900f\u904e\u5728\u9435\u7827\u4e0a\u70ba\u540d\u7a31\u6a19\u7c64\u6539\u540d\uff0c\u7136\u5f8c\u5c07\u540d\u7a31\u6a19\u7c64\u7528\u65bc\u7dbf\u7f8a\u4f86\u9054\u6210\u3002\u540c\u6a23\u5730\uff0c\u5c07\u5154\u5b50\u547d\u540d\u70ba\u300e\u5410\u53f8\u300f\u6703\u8b93\u5b83\u64c1\u6709\u7368\u7279\u7684\u76ae\u819a\u3002\u5617\u8a66\u5176\u4ed6\u540d\u7a31\u7d44\u5408\u4ee5\u4e86\u89e3\u66f4\u591a\u3002\u9019\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\u662f\u70ba\u4f60\u7684\u904a\u6232\u589e\u6dfb\u9a5a\u559c\u7684\u597d\u65b9\u6cd5\u3002"}]
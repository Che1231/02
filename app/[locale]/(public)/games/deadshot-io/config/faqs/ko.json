[{"question": "DEADSHOT.io\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "DEADSHOT.io\ub97c \uc2dc\uc791\ud558\ub824\uba74 \uba3c\uc800 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc5d0 \uc775\uc219\ud574\uc838\uc57c \ud569\ub2c8\ub2e4. WASD \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc774\ub3d9\ud558\uace0 \ub9c8\uc6b0\uc2a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc870\uc900 \ubc0f \uc0ac\uaca9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \uc784\ubb34\uc5d0\uc11c \uc801\uc5d0\uac8c \ub098\uc544\uac00\uae30 \uc804\uc5d0 \uc815\uc9c0\ub41c \ubb3c\uccb4\ub97c \uc870\uc900\ud558\uc5ec \uc5f0\uc2b5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub098\uc911 \ub2e8\uacc4\uc5d0\uc11c \uc0dd\uc874\uc5d0 \ud544\uc218\uc801\uc778 \ub4e4\uc5b4\uc624\ub294 \uacf5\uaca9\uc744 \ud68c\ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ucee8\ud2b8\ub864\uc744 \uc6b4\uc804 \ubc30\uc6b0\ub294 \uac83\uc73c\ub85c \uc0dd\uac01\ud558\uc2ed\uc2dc\uc624. \ucc9c\ucc9c\ud788 \uc2dc\uc791\ud558\uc5ec \uc810\ucc28 \uc18d\ub3c4\uc640 \uc815\ud655\ub3c4\ub97c \ub192\uc774\uc2ed\uc2dc\uc624.]"}, {"question": "DEADSHOT.io\uc5d0\uc11c \uc815\ud655\ub3c4\ub97c \ub192\uc774\uae30 \uc704\ud55c \ud544\uc218 \ud301\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "DEADSHOT.io\uc5d0\uc11c \uc815\ud655\ub3c4\ub97c \ub192\uc774\ub824\uba74 \uba87 \uac00\uc9c0 \ub2e8\uacc4\uac00 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \ub354 \ub9ce\uc740 \ud53c\ud574\ub97c \uc8fc\ub294 \ud5e4\ub4dc\uc0f7\uc744 \ud56d\uc0c1 \ub178\ub824\uc57c \ud569\ub2c8\ub2e4. STEP2: \ud658\uacbd\uc744 \ud65c\uc6a9\ud558\uc5ec \uc740\uc2e0\ucc98\ub97c \uc774\uc6a9\ud558\uace0 \uc801\uc808\ud55c \uc2dc\uc810\uc5d0 \uc0ac\uaca9\ud560 \uc900\ube44\ub97c \ud569\ub2c8\ub2e4. STEP3: \ub2e4\uc591\ud55c \ubb34\uae30\ub97c \ub290\uaef4\ubcf4\uae30 \uc704\ud574 \ud6c8\ub828 \ubaa8\ub4dc\uc5d0\uc11c \uc5f0\uc2b5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc800\uaca9 \uc18c\ucd1d\uc740 \uc815\ud655\uc131\uacfc \ud0c0\uc774\ubc0d\uc774 \ud544\uc694\ud558\uba70, \uc0b0\ud0c4\ucd1d\uc740 \uadfc\uc811 \uac70\ub9ac\uc5d0\uc11c \ub354 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: \ubb34\uae30\ub97c \uc77c\uc5d0 \ub9de\ub294 \uc801\uc808\ud55c \ub3c4\uad6c\ub97c \uc120\ud0dd\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uac01 \ubb34\uae30\uc5d0\ub294 \uc7a5\ub2e8\uc810\uc774 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "DEADSHOT.io\uc5d0\uc11c \uc5b4\ub5a4 \ubb34\uae30\uac00 \ub2e4\uc591\ud55c \uc0c1\ud669\uc5d0 \uac00\uc7a5 \uc801\ud569\ud569\ub2c8\uae4c?", "answer": "DEADSHOT.io\uc5d0\uc11c \uc0c1\ud669\uc5d0 \ub9de\ub294 \ubb34\uae30\ub97c \uc120\ud0dd\ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc7a5\uac70\ub9ac \uad50\uc804\uc5d0\ub294 \uc800\uaca9 \uc18c\ucd1d\uc774 \uc801\ud569\ud569\ub2c8\ub2e4. \uadfc\uc811\uc804\uc5d0\ub294 \uc0b0\ud0c4\ucd1d\uc774\ub098 \uae30\uad00\ub2e8\ucd1d\uc774 \ub354 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub3c4\uc2dc \uacf5\uaca9' \uc784\ubb34\uc5d0\uc11c\ub294 \uae30\uad00\ub2e8\ucd1d\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc881\uc740 \uacf5\uac04\uc5d0\uc11c \ud544\uc218\uc801\uc778 \ube60\ub978 \uc774\ub3d9\uacfc \uc0ac\uaca9\uc744 \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ub300\uc870\ud45c: \uc0ac\uc815\uac70\ub9ac, \ud53c\ud574\ub7c9, \ubc1c\uc0ac \uc18d\ub3c4\uc640 \uac19\uc740 \ubb34\uae30 \ud1b5\uacc4\ub97c \ube44\uad50\ud558\ub294 \ud45c\ub97c \ub9cc\ub4e4\uc5b4 \uc815\ubcf4\uc5d0 \uc785\uac01\ud55c \uacb0\uc815\uc744 \ub0b4\ub9ac\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4.]"}, {"question": "DEADSHOT.io\uc5d0\uc11c \uc801 AI \ud589\ub3d9\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "DEADSHOT.io\uc5d0\uc11c \uc801 AI \ud589\ub3d9\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \ud6a8\uacfc\uc801\uc778 \uc804\ub7b5\uc744 \uac1c\ubc1c\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc801\ub4e4\uc740 \uc11c\ub85c \ub2e4\ub978 \ud328\ud134\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc77c\ubd80\ub294 \ub2f9\uc2e0\uc5d0\uac8c \ub3cc\uaca9\ud560 \uc218\ub3c4 \uc788\uace0, \ub2e4\ub978 \uc77c\ubd80\ub294 \uc740\uc2e0\ucc98\ub97c \uc774\uc6a9\ud558\uc5ec \uc6d0\uac70\ub9ac\uc5d0\uc11c \uacf5\uaca9\ud560 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc0ac\ub9c9 \ub9e4\ubcf5' \uc784\ubb34\uc5d0\uc11c \uc800\uaca9\uc218\uac00 \ub4a4\uc5d0\uc11c \uc815\ud655\ud55c \uc0ac\uaca9\uc744 \uac00\ud560 \uac83\uc774\ub77c\ub294 \uac83\uc744 \uc54c\uba74 \uc811\uadfc \ubc29\uc2dd\uc744 \uc801\uc808\ud788 \uacc4\ud68d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc801\uc758 \uc77c\ubc18\uc801\uc778 \ud589\ub3d9\uc744 \uc608\uce21\ud558\uace0 \ub300\uc751\ud558\uae30 \uc704\ud574 \ud750\ub984\ub3c4\ub97c \uadf8\ub9bd\ub2c8\ub2e4.]"}, {"question": "DEADSHOT.io\uc5d0\uc11c \ub2e4\uc591\ud55c \uc784\ubb34\uc5d0 \ub9de\ub294 \uc7a5\ube44\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "DEADSHOT.io\uc5d0\uc11c \uc7a5\ube44\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc784\ubb34 \ubaa9\ud45c\uc640 \uc801 \uc720\ud615\uc744 \uace0\ub824\ud574\uc57c \ud569\ub2c8\ub2e4. STEP1: \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\uace0 \uc784\ubb34 \uc694\uad6c \uc0ac\ud56d\uc5d0 \ubd80\ud569\ud558\ub294 \ubb34\uae30\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. STEP2: \uac15\uc810\uc744 \uac15\ud654\ud558\uac70\ub098 \uc57d\uc810\uc744 \uc644\ud654\ud558\ub294 \ud2b9\uc804\uc744 \uc7a5\ucc29\ud569\ub2c8\ub2e4. STEP3: \ube44\uc0c1\uc2dc\ub97c \ub300\ube44\ud558\uc5ec \ud56d\uc0c1 \ubcf4\uc870 \ubb34\uae30\ub97c \ud734\ub300\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc57c\uac04 \uc791\uc804' \uc784\ubb34\uc5d0\uc11c\ub294 \uc57c\uac04 \ud22c\uc2dc\uacbd\uacfc \uc18c\uc74c\uae30\uac00 \uc7a5\ucc29\ub41c \uad8c\ucd1d\uc744 \uc7a5\ucc29\ud558\uba74 \uc804\uc220\uc801 \uc6b0\uc704\ub97c \uc810\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: \ub2e4\uc591\ud55c \uc0c1\ud669\uc5d0\uc11c \uc5b4\ub5a4 \uc7a5\ube44\uac00 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778\uc9c0 \ube44\uad50\ud569\ub2c8\ub2e4.]"}, {"question": "DEADSHOT.io\uc758 \ud6c4\ubc18 \ub2e8\uacc4\uc5d0\uc11c \uc0dd\uc874 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "DEADSHOT.io\uc758 \ud6c4\ubc18 \ub2e8\uacc4\uc5d0\uc11c \uc0dd\uc874\ud558\ub824\uba74 \uace0\uae09 \uc804\ub7b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \uc27d\uac8c \ud45c\uc801\uc774 \ub418\uc9c0 \uc54a\ub3c4\ub85d \ud56d\uc0c1 \uc6c0\uc9c1\uc785\ub2c8\ub2e4. STEP2: \ud658\uacbd\uc744 \ud65c\uc6a9\ud558\uc5ec \uc740\uc2e0\ucc98\ub97c \uc774\uc6a9\ud558\uace0 \ub9e4\ubcf5\uc744 \uc124\uc815\ud569\ub2c8\ub2e4. STEP3: \uc6b0\uc120\uc801\uc73c\ub85c \uc704\ud611\uc774 \ub192\uc740 \uc801\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uacf5\uaca9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ucd5c\ud6c4\uc758 \uacb0\uc804' \uc784\ubb34\uc5d0\uc11c \uc911\uc7a5\uac11 \uc801\uc744 \uba3c\uc800 \ucc98\ub9ac\ud55c \ud6c4 \uc77c\ubc18 \uc801\uc744 \ucc98\ub9ac\ud558\uba74 \uc0dd\uc874 \uac00\ub2a5\uc131\uc744 \ud06c\uac8c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud6c4\ubc18 \ub2e8\uacc4\ub97c \uccb4\uc2a4 \uac8c\uc784\uc73c\ub85c \uc0dd\uac01\ud558\uc2ed\uc2dc\uc624. \ubaa8\ub4e0 \uc218\uac00 \uc911\uc694\ud558\uba70 \uc804\ub7b5\uc774 \ud544\uc218\uc801\uc785\ub2c8\ub2e4.]"}, {"question": "DEADSHOT.io\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "DEADSHOT.io\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc815\ud655\uc131, \uc18d\ub3c4, \uc0ac\uc0b4\ud55c \uc801 \uc218\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \ud5e4\ub4dc\uc0f7\uacfc \ube60\ub978 \uc0ac\uc0b4\uc740 \ub192\uc740 \uc810\uc218\ub97c \uac00\uc838\uc635\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc800\uaca9\uc218\uc758 \ub465\uc9c0' \uc784\ubb34\uc5d0\uc11c \uc644\ubcbd\ud55c \uc810\uc218\ub97c \ubc1b\uc73c\ub824\uba74 \uc815\ud655\ud55c \ud5e4\ub4dc\uc0f7\uacfc \ucd5c\uc18c\ud55c\uc758 \uc2dc\uac04\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. [\uc124\uc815 \ub300\uc870\ud45c: \ud5e4\ub4dc\uc0f7, \ubab8\ud1b5\uc0f7, \uc2dc\uac04 \ubcf4\ub108\uc2a4\uc640 \uac19\uc774 \uc11c\ub85c \ub2e4\ub978 \ud589\ub3d9\uc774 \uc810\uc218\uc5d0 \uc5b4\ub5bb\uac8c \uae30\uc5ec\ud558\ub294\uc9c0 \ubcf4\uc5ec\uc8fc\ub294 \ud45c\ub97c \ub9cc\ub4ed\ub2c8\ub2e4.]"}, {"question": "DEADSHOT.io\uc758 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "DEADSHOT.io\uc758 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubaa9\ud45c\uc640 \uac8c\uc784 \ud50c\ub808\uc774 \uc5ed\ud559\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4\uc5d0\uc11c\ub294 \uc784\ubb34\ub97c \uc644\ub8cc\ud558\uace0 \uae30\uc220\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ub370 \ucd08\uc810\uc744 \ub9de\ucda5\ub2c8\ub2e4. \uba40\ud2f0\ud50c\ub808\uc774\uc5b4\uc5d0\uc11c\ub294 \ud300\uc6cc\ud06c\uc640 \uacbd\uc7c1\uc774 \uac15\uc870\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud300 \ub370\uc2a4\ub9e4\uce58' \ubaa8\ub4dc\uc5d0\uc11c \ub9f5\uc758 \uc8fc\uc694 \uc9c0\uc810\uc744 \uc7a5\uc545\ud558\uae30 \uc704\ud574 \ud300\uacfc \ud611\ub825\ud558\ub294 \uac83\uc774 \uc2b9\ub9ac\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: \ub450 \ubaa8\ub4dc\uc758 \ubaa9\ud45c, \uc804\ub7b5, \ubcf4\uc0c1\uc744 \ube44\uad50\ud558\uc5ec \ud50c\ub808\uc774\uc5b4\uac00 \uc790\uc2e0\uc5d0\uac8c \uac00\uc7a5 \uc801\ud569\ud55c \ubaa8\ub4dc\ub97c \uacb0\uc815\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4.]"}, {"question": "DEADSHOT.io\uc758 \ubaa8\ubc14\uc77c \ubc84\uc804 \uc9c4\ud589 \uc0c1\ud669\uc744 PC \ubc84\uc804\uc73c\ub85c \uc5b4\ub5bb\uac8c \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "DEADSHOT.io\uc758 \ubaa8\ubc14\uc77c \ubc84\uc804 \uc9c4\ud589 \uc0c1\ud669\uc744 PC \ubc84\uc804\uc73c\ub85c \uc774\uc804\ud558\ub294 \uac83\uc740 \uac04\ub2e8\ud569\ub2c8\ub2e4. STEP1: \ub450 \uae30\uae30\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. STEP2: \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud569\ub2c8\ub2e4. STEP3: PC\uc5d0\uc11c \uc778\ubca4\ud1a0\ub9ac\uc640 \uc784\ubb34 \uc9c4\ud589 \uc0c1\ud669\uc744 \ud655\uc778\ud558\uc5ec \uc774\uc804\uc774 \uc644\ub8cc\ub418\uc5c8\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubaa8\ubc14\uc77c\uc5d0\uc11c '\uc5d8\ub9ac\ud2b8 \uc800\uaca9\uc218' \ud0c0\uc774\ud2c0\uc744 \ud68d\ub4dd\ud588\ub2e4\uba74 \uc774\uc804 \ud6c4 PC \ud504\ub85c\ud544\uc5d0 \ud45c\uc2dc\ub418\uc5b4\uc57c \ud569\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc774\uc804 \uacfc\uc815\uc744 \uc124\uba85\ud558\ub294 \ub2e8\uacc4\ubcc4 \uac00\uc774\ub4dc\uc640 \uc2a4\ud06c\ub9b0\uc0f7\uc744 \ub9cc\ub4ed\ub2c8\ub2e4.]"}, {"question": "DEADSHOT.io\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "DEADSHOT.io\uc5d0\ub294 \uac8c\uc784\uc758 \ub9e4\ub825\uc744 \ub354\ud558\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uac00\ub4dd\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud3d0\ud5c8\uac00 \ub41c \uacf5\uc7a5' \uc784\ubb34\uc5d0\uc11c\ub294 \ud76c\uadc0\ud55c \ubb34\uae30 \uc2a4\ud0a8\uc774 \uc788\ub294 \uc228\uaca8\uc9c4 \ubc29\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub97c \ucc3e\uc73c\ub824\uba74 \ubcbd\uc5d0 \uac70\uc758 \ubcf4\uc774\uc9c0 \uc54a\ub294 \ud2c8\uc0c8\ub97c \ucc3e\uc544 \uc0c1\ud638 \uc791\uc6a9\ud558\uba74 \ub429\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 '\uc0ac\uaca9\uc7a5' \uc784\ubb34\uc758 '\uae08\uc0c9 \ud45c\uc801'\uc785\ub2c8\ub2e4. \uc774\uac83\uc744 \ub9de\ud788\uba74 \ud2b9\ubcc4\ud55c \uc5c5\uc801\uc744 \uc5bb\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ucc3e\ub294 \uac83\uc740 \ubcf4\ubb3c\ucc3e\uae30\uc640 \uac19\uc2b5\ub2c8\ub2e4. \uc778\ub0b4\uc2ec\uacfc \uc138\uc2ec\ud55c \uc8fc\uc758\uac00 \uc911\uc694\ud569\ub2c8\ub2e4.]"}]
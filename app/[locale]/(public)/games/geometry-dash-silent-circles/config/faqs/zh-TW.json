[{"question": "\u5982\u4f55\u4f5c\u70ba\u5165\u9580\u8005\u638c\u63e1 Geometry Dash Silent Circles \u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u638c\u63e1 Geometry Dash Silent Circles \u7684\u57fa\u672c\u63a7\u5236\uff0c\u9996\u5148\u8981\u719f\u6089\u8df3\u8e8d\u6a5f\u5236\u3002\u7df4\u7fd2\u6e96\u78ba\u5730\u8df3\u8e8d\u4ee5\u907f\u958b\u969c\u7919\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u95dc\uff0c\u4f60\u9700\u8981\u6e96\u78ba\u5730\u8df3\u904e\u5c16\u523a\u3002\u6b65\u9a5f\u4e00\uff1a\u9ede\u64ca\u87a2\u5e55\u6216\u6309\u4e0b\u7a7a\u683c\u9375\u8df3\u8e8d\u3002\u6b65\u9a5f\u4e8c\uff1a\u89c0\u5bdf\u95dc\u5361\u7684\u7bc0\u594f\uff0c\u9810\u6e2c\u8df3\u8e8d\u6642\u9593\u3002\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u77ed\u4fc3\u3001\u63a7\u5236\u7684\u9ede\u64ca\u4f86\u8df3\u904e\u8f03\u5c0f\u7684\u969c\u7919\uff0c\u4e26\u4ee5\u8f03\u9577\u6642\u9593\u7684\u9ede\u64ca\u4f86\u5b8c\u6210\u8f03\u9ad8\u7684\u8df3\u8e8d\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4e00\u4e0b\u8df3\u7e69\uff1b\u6642\u9593\u638c\u63e1\u5ea6\u81f3\u95dc\u91cd\u8981\u3002]"}, {"question": "\u5b8c\u6210 Geometry Dash Silent Circles \u9ad8\u7d1a\u95dc\u5361\u7684\u95dc\u9375\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5b8c\u6210 Geometry Dash Silent Circles \u7684\u9ad8\u7d1a\u95dc\u5361\u9700\u8981\u7cbe\u78ba\u5ea6\u548c\u8a18\u61b6\u529b\u3002\u5c08\u6ce8\u65bc\u5b78\u7fd2\u6bcf\u500b\u90e8\u5206\u7684\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u5728\u300cSilent Circles\u300d\u95dc\u5361\u4e2d\uff0c\u5b58\u5728\u8907\u96dc\u7684\u8df3\u8e8d\u548c\u91cd\u529b\u8b8a\u5316\u5e8f\u5217\u3002\u6b65\u9a5f\u4e00\uff1a\u591a\u6b21\u73a9\u95dc\u5361\u4f86\u8a18\u61b6\u6a21\u5f0f\u3002\u6b65\u9a5f\u4e8c\uff1a\u5c07\u95dc\u5361\u5206\u89e3\u6210\u8f03\u5c0f\u7684\u90e8\u5206\uff0c\u4e26\u7df4\u7fd2\u6bcf\u500b\u90e8\u5206\u3002\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u6aa2\u67e5\u9ede\u4f86\u5b8c\u5584\u4f60\u7684\u65b9\u6cd5\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u4e00\u4e9b\u73a9\u5bb6\u559c\u6b61\u4f7f\u7528\u7bc0\u62cd\u5668\u4f86\u7dad\u6301\u7bc0\u594f\uff0c\u800c\u53e6\u4e00\u4e9b\u73a9\u5bb6\u5247\u4f9d\u8cf4\u8996\u89ba\u63d0\u793a\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc Geometry Dash Silent Circles \u7684\u91cd\u529b\u6a5f\u5236\u5c0d\u65b0\u73a9\u5bb6\u4f86\u8aaa\u5177\u6709\u6311\u6230\u6027\uff1f", "answer": "Geometry Dash Silent Circles \u7684\u91cd\u529b\u6a5f\u5236\u4e4b\u6240\u4ee5\u5177\u6709\u6311\u6230\u6027\uff0c\u662f\u56e0\u70ba\u5b83\u53cd\u8f49\u4e86\u4f60\u7684\u8df3\u8e8d\u65b9\u5411\u3002\u9019\u9700\u8981\u5feb\u901f\u7684\u53cd\u61c9\u548c\u9069\u61c9\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u5728\u300cGravity Shift\u300d\u90e8\u5206\uff0c\u4f60\u5fc5\u9808\u6539\u8b8a\u4f60\u7684\u8996\u89d2\u4f86\u901a\u904e\u969c\u7919\u3002\u6b65\u9a5f\u4e00\uff1a\u9810\u6e2c\u91cd\u529b\u4f55\u6642\u6703\u6539\u8b8a\u3002\u6b65\u9a5f\u4e8c\uff1a\u8abf\u6574\u4f60\u7684\u8df3\u8e8d\u6642\u9593\u4f86\u5339\u914d\u65b0\u7684\u65b9\u5411\u3002\u6b65\u9a5f\u4e09\uff1a\u5728\u6311\u6230\u66f4\u56f0\u96e3\u7684\u95dc\u5361\u4e4b\u524d\uff0c\u5148\u5728\u8f03\u7c21\u55ae\u7684\u95dc\u5361\u4e2d\u7df4\u7fd2\u6b64\u6a5f\u5236\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u9019\u5c31\u50cf\u5b78\u7fd2\u9a0e\u81ea\u884c\u8eca\uff1b\u4f60\u9700\u8981\u5feb\u901f\u5e73\u8861\u548c\u8abf\u6574\u3002]"}, {"question": "Geometry Dash Silent Circles \u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "Geometry Dash Silent Circles \u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u6536\u96c6\u7684\u5bf6\u73e0\u6578\u91cf\u548c\u5b8c\u6210\u6642\u9593\u3002\u6bcf\u9846\u5bf6\u73e0\u90fd\u6703\u589e\u52a0\u4f60\u7684\u5206\u6578\uff0c\u5b8c\u6210\u6642\u9593\u8d8a\u5feb\uff0c\u734e\u52f5\u8d8a\u9ad8\u3002\u4f8b\u5982\uff0c\u5728\u300cOrb Frenzy\u300d\u95dc\u5361\u4e2d\uff0c\u6536\u96c6\u6240\u6709\u5bf6\u73e0\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u4f60\u7684\u5206\u6578\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u5bf6\u73e0\u50f9\u503c\uff1a100 \u5206\uff0c\u6642\u9593\u734e\u52f5\uff1a\u5728 1 \u5206\u9418\u5167\u5b8c\u6210\u53ef\u4ee5\u7372\u5f97 500 \u5206\u3002]"}, {"question": "\u5728\u884c\u52d5\u88dd\u7f6e\u4e0a\u6700\u4f73\u5316 Geometry Dash Silent Circles \u6548\u80fd\u7684\u6700\u4f73\u8a2d\u5b9a\u662f\u4ec0\u9ebc\uff1f", "answer": "\u8981\u6700\u4f73\u5316\u884c\u52d5\u88dd\u7f6e\u4e0a\u7684\u6548\u80fd\uff0c\u8acb\u8abf\u6574\u5716\u5f62\u8a2d\u5b9a\u4ee5\u6e1b\u5c11\u5ef6\u9072\u3002\u964d\u4f4e\u89e3\u6790\u5ea6\u4e26\u505c\u7528\u4e0d\u5fc5\u8981\u7684\u7279\u6548\u3002\u4f8b\u5982\uff0c\u5728\u300cSilent Circles\u300d\u95dc\u5361\u4e2d\uff0c\u964d\u4f4e\u7c92\u5b50\u6548\u679c\u53ef\u4ee5\u6539\u5584\u5e40\u7387\u3002\u6b65\u9a5f\u4e00\uff1a\u9032\u5165\u8a2d\u5b9a\u9078\u55ae\u3002\u6b65\u9a5f\u4e8c\uff1a\u5c07\u89e3\u6790\u5ea6\u964d\u4f4e\u5230\u300c\u4e2d\u300d\u3002\u6b65\u9a5f\u4e09\uff1a\u505c\u7528\u300c\u9670\u5f71\u300d\u548c\u300c\u7c92\u5b50\u6548\u679c\u300d\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u9ad8\u8a2d\u5b9a\uff1a\u5ef6\u9072\uff0c\u4e2d\u8a2d\u5b9a\uff1a\u9806\u66a2\uff0c\u4f4e\u8a2d\u5b9a\uff1a\u57fa\u672c\u3002]"}, {"question": "Geometry Dash Silent Circles \u4e2d\u54ea\u4e9b\u95dc\u5361\u88ab\u8a8d\u70ba\u662f\u6700\u56f0\u96e3\u7684\uff0c\u70ba\u4ec0\u9ebc\uff1f", "answer": "Geometry Dash Silent Circles \u4e2d\u6700\u56f0\u96e3\u7684\u95dc\u5361\u662f\u300cSilent Circles\u300d\u548c\u300cGravity Shift\u300d\uff0c\u56e0\u70ba\u5b83\u5011\u7684\u8907\u96dc\u6a21\u5f0f\u548c\u91cd\u529b\u6a5f\u5236\u3002\u300cSilent Circles\u300d\u9700\u8981\u7cbe\u78ba\u7684\u6642\u9593\u63a7\u5236\u548c\u8a18\u61b6\uff0c\u800c\u300cGravity Shift\u300d\u5247\u6703\u8b93\u73a9\u5bb6\u9762\u5c0d\u983b\u7e41\u7684\u91cd\u529b\u8b8a\u5316\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u4e00\u4e9b\u73a9\u5bb6\u89ba\u5f97\u300cSilent Circles\u300d\u66f4\u96e3\uff0c\u56e0\u70ba\u5b83\u7684\u9577\u5ea6\uff0c\u800c\u53e6\u4e00\u4e9b\u73a9\u5bb6\u5247\u66f4\u96e3\u61c9\u4ed8\u300cGravity Shift\u300d\u7684\u6301\u7e8c\u8996\u89d2\u8f49\u63db\u3002]"}, {"question": "\u5982\u4f55\u5c07 Geometry Dash Silent Circles \u7684\u9032\u5ea6\u5f9e\u4e00\u500b\u88dd\u7f6e\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u88dd\u7f6e\uff1f", "answer": "\u8981\u8f49\u79fb\u4f60\u7684\u9032\u5ea6\uff0c\u8acb\u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u3002\u9996\u5148\uff0c\u78ba\u4fdd\u4f60\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u767b\u5165\u76f8\u540c\u7684\u5e33\u6236\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9e Android \u88dd\u7f6e\u8f49\u79fb\u5230 iOS \u88dd\u7f6e\uff0c\u8acb\u4f7f\u7528\u60a8\u7684 Google Play \u6216 Apple ID \u767b\u5165\u3002\u6b65\u9a5f\u4e00\uff1a\u5728\u820a\u88dd\u7f6e\u4e0a\u958b\u555f\u904a\u6232\u4e26\u555f\u7528\u96f2\u7aef\u5132\u5b58\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u76f8\u540c\u7684\u5e33\u6236\u5728\u65b0\u7684\u88dd\u7f6e\u4e0a\u767b\u5165\u3002\u6b65\u9a5f\u4e09\uff1a\u5f9e\u96f2\u7aef\u540c\u6b65\u4f60\u7684\u9032\u5ea6\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u820a\u88dd\u7f6e \u2192 \u96f2\u7aef\u5132\u5b58 \u2192 \u65b0\u88dd\u7f6e\u3002]"}, {"question": "Geometry Dash Silent Circles \u4e2d\u6709\u4ec0\u9ebc\u96b1\u85cf\u7684\u79d8\u5bc6\u6216\u5f69\u86cb\uff1f", "answer": "Geometry Dash Silent Circles \u5305\u542b\u5e7e\u500b\u96b1\u85cf\u7684\u79d8\u5bc6\uff0c\u4f8b\u5982\u300cSilent Circles\u300d\u95dc\u5361\u4e2d\u7684\u300c\u9ec3\u91d1\u5713\u5708\u300d\u3002\u8981\u627e\u5230\u5b83\uff0c\u4f60\u9700\u8981\u63a1\u53d6\u4e00\u689d\u4e0d\u90a3\u9ebc\u660e\u986f\u7684\u7279\u5b9a\u8def\u5f91\u3002\u4f8b\u5982\uff0c\u5728\u4e2d\u9593\u90e8\u5206\uff0c\u8df3\u904e\u4e00\u7cfb\u5217\u96b1\u85cf\u7684\u5e73\u53f0\uff0c\u5373\u53ef\u63ed\u793a\u9ec3\u91d1\u5713\u5708\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u9019\u5c31\u50cf\u5728\u8ff7\u5bae\u4e2d\u627e\u5230\u4e00\u500b\u96b1\u85cf\u7684\u5bf6\u7bb1\u3002]"}, {"question": "\u5982\u4f55\u63d0\u9ad8 Geometry Dash Silent Circles \u4e2d\u5feb\u901f\u95dc\u5361\u7684\u53cd\u61c9\u6642\u9593\uff1f", "answer": "\u63d0\u9ad8\u53cd\u61c9\u6642\u9593\u9700\u8981\u7df4\u7fd2\u548c\u5c08\u6ce8\u3002\u9996\u5148\u73a9\u8f03\u6162\u7684\u95dc\u5361\u4f86\u5efa\u7acb\u808c\u8089\u8a18\u61b6\uff0c\u7136\u5f8c\u9010\u6b65\u63d0\u9ad8\u96e3\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u300cSpeed Run\u300d\u95dc\u5361\u4e2d\uff0c\u61c9\u5c08\u6ce8\u65bc\u9810\u6e2c\u969c\u7919\u7269\uff0c\u800c\u4e0d\u662f\u53cd\u61c9\u3002\u6b65\u9a5f\u4e00\uff1a\u73a9\u6709\u53ef\u9810\u6e2c\u6a21\u5f0f\u7684\u95dc\u5361\u3002\u6b65\u9a5f\u4e8c\uff1a\u9010\u6f38\u63d0\u9ad8\u95dc\u5361\u7684\u901f\u5ea6\u3002\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u8996\u89ba\u548c\u807d\u89ba\u63d0\u793a\u4f86\u9810\u6e2c\u8df3\u8e8d\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u4e00\u4e9b\u73a9\u5bb6\u4f7f\u7528\u8a13\u7df4\u61c9\u7528\u7a0b\u5f0f\uff0c\u800c\u53e6\u4e00\u4e9b\u73a9\u5bb6\u5247\u559c\u6b61\u5728\u904a\u6232\u4e2d\u7df4\u7fd2\u3002]"}, {"question": "\u5728 Geometry Dash Silent Circles \u4e2d\uff0c\u521d\u5b78\u8005\u6700\u5e38\u72af\u7684\u932f\u8aa4\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5982\u4f55\u907f\u514d\u5b83\u5011\uff1f", "answer": "\u5e38\u898b\u7684\u932f\u8aa4\u5305\u62ec\u8df3\u8e8d\u904e\u591a\u4ee5\u53ca\u4e0d\u6ce8\u610f\u7bc0\u594f\u3002\u4f8b\u5982\uff0c\u5728\u300cFirst Steps\u300d\u95dc\u5361\u4e2d\uff0c\u521d\u5b78\u8005\u7d93\u5e38\u8df3\u8e8d\u904e\u65e9\u6216\u904e\u665a\u3002\u6b65\u9a5f\u4e00\uff1a\u7df4\u7fd2\u8207\u97f3\u6a02\u540c\u6b65\u8df3\u8e8d\u3002\u6b65\u9a5f\u4e8c\uff1a\u907f\u514d\u904e\u5ea6\u6216\u904e\u8edf\u6309\u4e0b\u8df3\u8e8d\u6309\u9215\u3002\u6b65\u9a5f\u4e09\uff1a\u4fdd\u6301\u51b7\u975c\u548c\u5c08\u6ce8\uff0c\u5c24\u5176\u662f\u5728\u5feb\u901f\u7bc0\u594f\u7684\u90e8\u5206\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u9019\u5c31\u50cf\u5b78\u7fd2\u8df3\u821e\uff1b\u4f60\u9700\u8981\u4fdd\u6301\u8207\u97f3\u6a02\u7684\u7bc0\u594f\u3002]"}]
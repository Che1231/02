u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001Android\u304b\u3089iOS\u30c7\u30d0\u30a4\u30b9\u306b\u79fb\u52d5\u3059\u308b\u5834\u5408\u306f\u3001Google Play\u307e\u305f\u306fApple ID\u3067\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u53e4\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u30b2\u30fc\u30e0\u3092\u958b\u304d\u3001\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u6709\u52b9\u306b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u3067\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30af\u30e9\u30a6\u30c9\u304b\u3089\u9032\u884c\u72b6\u6cc1\u3092\u540c\u671f\u3057\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u56f3\uff1a\u53e4\u3044\u30c7\u30d0\u30a4\u30b9\u2192\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u2192\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3002]"}, {"question": "Geometry Dash Silent Circles\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u79d8\u5bc6\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "Geometry Dash Silent Circles\u306b\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u96a0\u3055\u308c\u305f\u79d8\u5bc6\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300cSilent Circles\u300d\u30ec\u30d9\u30eb\u306e\u300cGolden Circle\u300d\u3067\u3059\u3002\u898b\u3064\u3051\u308b\u306b\u306f\u3001\u3059\u3050\u306b\u660e\u3089\u304b\u3067\u306f\u306a\u3044\u7279\u5b9a\u306e\u30d1\u30b9\u3092\u901a\u904e\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u4e2d\u592e\u30bb\u30af\u30b7\u30e7\u30f3\u3067\u3001\u96a0\u3055\u308c\u305f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u9806\u756a\u306b\u98db\u3073\u8d8a\u3048\u308b\u3053\u3068\u3067\u3001Golden Circle\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u4f8b\u3048\u8aac\u660e\uff1a\u8ff7\u8def\u306e\u4e2d\u306b\u96a0\u3055\u308c\u305f\u5b9d\u7bb1\u3092\u898b\u3064\u3051\u308b\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002]"}, {"question": "Geometry Dash Silent Circles\u3067\u3001\u3088\u308a\u901f\u3044\u30ec\u30d9\u30eb\u306e\u305f\u3081\u306b\u53cd\u5fdc\u6642\u9593\u3092\u6539\u5584\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u53cd\u5fdc\u6642\u9593\u3092\u5411\u4e0a\u3055\u305b\u308b\u306b\u306f\u3001\u7df4\u7fd2\u3068\u96c6\u4e2d\u304c\u5fc5\u8981\u3067\u3059\u3002\u307e\u305a\u3001\u7b4b\u8a18\u61b6\u529b\u3092\u990a\u3046\u305f\u3081\u306b\u3001\u3088\u308a\u9045\u3044\u30ec\u30d9\u30eb\u3092\u30d7\u30ec\u30a4\u3057\u3001\u5f90\u3005\u306b\u96e3\u6613\u5ea6\u3092\u4e0a\u3052\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u3001\u300cSpeed Run\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u53cd\u5fdc\u3059\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u969c\u5bb3\u7269\u3092\u4e88\u6e2c\u3059\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u4e88\u6e2c\u53ef\u80fd\u306a\u30d1\u30bf\u30fc\u30f3\u3092\u6301\u3064\u30ec\u30d9\u30eb\u3092\u30d7\u30ec\u30a4\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30ec\u30d9\u30eb\u306e\u901f\u5ea6\u3092\u5f90\u3005\u306b\u4e0a\u3052\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u8996\u899a\u7684\u304a\u3088\u3073\u8074\u899a\u7684\u306a\u624b\u304c\u304b\u308a\u3092\u4f7f\u3063\u3066\u3001\u30b8\u30e3\u30f3\u30d7\u3092\u4e88\u6e2c\u3057\u307e\u3059\u3002[\u8907\u6570\u306e\u65b9\u6cd5\u306e\u6bd4\u8f03\uff1a\u4e00\u90e8\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u30a2\u30d7\u30ea\u3092\u4f7f\u7528\u3057\u307e\u3059\u304c\u3001\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30b2\u30fc\u30e0\u5185\u7df4\u7fd2\u3092\u597d\u307f\u307e\u3059\u3002]"}, {"question": "Geometry Dash Silent Circles\u3067\u521d\u5fc3\u8005\u304c\u3088\u304f\u72af\u3059\u4e00\u822c\u7684\u306a\u30df\u30b9\u3068\u305d\u306e\u56de\u907f\u7b56\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u4e00\u822c\u7684\u306a\u30df\u30b9\u306b\u306f\u3001\u30b8\u30e3\u30f3\u30d7\u3057\u3059\u304e\u305f\u308a\u3001\u30ea\u30ba\u30e0\u306b\u6ce8\u610f\u3092\u6255\u308f\u306a\u3044\u3053\u3068\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300cFirst Steps\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u521d\u5fc3\u8005\u306f\u30b8\u30e3\u30f3\u30d7\u3092\u65e9\u3059\u304e\u305f\u308a\u9045\u3059\u304e\u305f\u308a\u3059\u308b\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u97f3\u697d\u306b\u5408\u308f\u305b\u3066\u30b8\u30e3\u30f3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u7df4\u7fd2\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b8\u30e3\u30f3\u30d7\u30dc\u30bf\u30f3\u3092\u5f37\u304f\u62bc\u3057\u305f\u308a\u3001\u5f31\u304f\u62bc\u3057\u305f\u308a\u3057\u306a\u3044\u3088\u3046\u306b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7279\u306b\u30da\u30fc\u30b9\u306e\u901f\u3044\u30bb\u30af\u30b7\u30e7\u30f3\u3067\u306f\u3001\u843d\u3061\u7740\u3044\u3066\u96c6\u4e2d\u3057\u307e\u3057\u3087\u3046\u3002[\u4f8b\u3048\u8aac\u660e\uff1a\u30c0\u30f3\u30b9\u3092\u5b66\u3076\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u97f3\u697d\u306b\u5408\u308f\u305b\u3066\u30ea\u30ba\u30e0\u3092\u4fdd\u3064\u3053\u3068\u304c\u5fc5\u8981\u3067\u3059\u3002]"}]
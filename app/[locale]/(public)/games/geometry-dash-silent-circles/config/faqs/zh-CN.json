[{"question": "\u5982\u4f55\u4f5c\u4e3a\u521d\u5b66\u8005\u638c\u63e1\u51e0\u4f55\u51b2\u523a\u9759\u97f3\u5706\u5708\u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u638c\u63e1\u51e0\u4f55\u51b2\u523a\u9759\u97f3\u5706\u5708\u7684\u57fa\u672c\u63a7\u5236\uff0c\u9996\u5148\u8981\u719f\u6089\u8df3\u8dc3\u673a\u5236\u3002\u7ec3\u4e60\u51c6\u786e\u5730\u8df3\u8dc3\u4ee5\u907f\u5f00\u969c\u788d\u7269\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u5173\u4e2d\uff0c\u4f60\u9700\u8981\u7cbe\u786e\u5730\u8df3\u8fc7\u5c16\u523a\u3002\u6b65\u9aa41\uff1a\u70b9\u51fb\u5c4f\u5e55\u6216\u6309\u7a7a\u683c\u952e\u8df3\u8dc3\u3002\u6b65\u9aa42\uff1a\u89c2\u5bdf\u5173\u5361\u7684\u8282\u594f\uff0c\u9884\u6d4b\u8df3\u8dc3\u65f6\u673a\u3002\u6b65\u9aa43\uff1a\u5bf9\u4e8e\u8f83\u5c0f\u7684\u969c\u788d\u7269\uff0c\u4f7f\u7528\u77ed\u4fc3\u7684\u70b9\u51fb\uff1b\u5bf9\u4e8e\u8f83\u9ad8\u7684\u8df3\u8dc3\uff0c\u5219\u9700\u8981\u8f83\u957f\u65f6\u95f4\u7684\u6309\u4f4f\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u628a\u5b83\u60f3\u8c61\u6210\u8df3\u7ef3\uff0c\u65f6\u673a\u81f3\u5173\u91cd\u8981\u3002]"}, {"question": "\u5728\u51e0\u4f55\u51b2\u523a\u9759\u97f3\u5706\u5708\u4e2d\u5b8c\u6210\u9ad8\u7ea7\u5173\u5361\u7684\u5173\u952e\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u51e0\u4f55\u51b2\u523a\u9759\u97f3\u5706\u5708\u4e2d\u5b8c\u6210\u9ad8\u7ea7\u5173\u5361\u9700\u8981\u7cbe\u786e\u6027\u548c\u8bb0\u5fc6\u529b\u3002\u4e13\u6ce8\u4e8e\u5b66\u4e60\u6bcf\u4e2a\u90e8\u5206\u7684\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u5728\u201c\u9759\u97f3\u5706\u5708\u201d\u5173\u5361\u4e2d\uff0c\u5b58\u5728\u590d\u6742\u7684\u8df3\u8dc3\u548c\u91cd\u529b\u53d8\u5316\u5e8f\u5217\u3002\u6b65\u9aa41\uff1a\u591a\u6b21\u73a9\u5173\u5361\uff0c\u8bb0\u4f4f\u6a21\u5f0f\u3002\u6b65\u9aa42\uff1a\u5c06\u5173\u5361\u5206\u89e3\u6210\u8f83\u5c0f\u7684\u90e8\u5206\uff0c\u5e76\u7ec3\u4e60\u6bcf\u4e00\u90e8\u5206\u3002\u6b65\u9aa43\uff1a\u5229\u7528\u68c0\u67e5\u70b9\u6765\u5b8c\u5584\u4f60\u7684\u65b9\u6cd5\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u4e00\u4e9b\u73a9\u5bb6\u559c\u6b22\u4f7f\u7528\u8282\u62cd\u5668\u4fdd\u6301\u8282\u594f\uff0c\u800c\u53e6\u4e00\u4e9b\u73a9\u5bb6\u5219\u4f9d\u8d56\u89c6\u89c9\u63d0\u793a\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u51e0\u4f55\u51b2\u523a\u9759\u97f3\u5706\u5708\u4e2d\u7684\u91cd\u529b\u673a\u5236\u5bf9\u4e8e\u65b0\u73a9\u5bb6\u6765\u8bf4\u5177\u6709\u6311\u6218\u6027\uff1f", "answer": "\u51e0\u4f55\u51b2\u523a\u9759\u97f3\u5706\u5708\u4e2d\u7684\u91cd\u529b\u673a\u5236\u5177\u6709\u6311\u6218\u6027\uff0c\u56e0\u4e3a\u5b83\u4f1a\u53cd\u8f6c\u4f60\u7684\u8df3\u8dc3\u65b9\u5411\u3002\u8fd9\u9700\u8981\u5feb\u901f\u53cd\u5e94\u548c\u9002\u5e94\u6027\u3002\u4f8b\u5982\uff0c\u5728\u201c\u91cd\u529b\u8f6c\u6362\u201d\u90e8\u5206\uff0c\u4f60\u5fc5\u987b\u8f6c\u6362\u89c6\u89d2\u624d\u80fd\u901a\u8fc7\u969c\u788d\u7269\u3002\u6b65\u9aa41\uff1a\u9884\u6d4b\u91cd\u529b\u4f55\u65f6\u4f1a\u6539\u53d8\u3002\u6b65\u9aa42\uff1a\u8c03\u6574\u4f60\u7684\u65f6\u673a\u4ee5\u5339\u914d\u65b0\u7684\u65b9\u5411\u3002\u6b65\u9aa43\uff1a\u5728\u6311\u6218\u66f4\u96be\u7684\u5173\u5361\u4e4b\u524d\uff0c\u5148\u5728\u66f4\u7b80\u5355\u7684\u5173\u5361\u4e2d\u7ec3\u4e60\u8fd9\u79cd\u673a\u5236\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u8fd9\u5c31\u50cf\u5b66\u4e60\u9a91\u81ea\u884c\u8f66\uff0c\u4f60\u9700\u8981\u5feb\u901f\u5e73\u8861\u548c\u8c03\u6574\u3002]"}, {"question": "\u51e0\u4f55\u51b2\u523a\u9759\u97f3\u5706\u5708\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u51e0\u4f55\u51b2\u523a\u9759\u97f3\u5706\u5708\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u6536\u96c6\u7684\u5706\u5f62\u7269\u6570\u91cf\u548c\u5b8c\u6210\u65f6\u95f4\u3002\u6bcf\u4e2a\u5706\u5f62\u7269\u90fd\u4f1a\u589e\u52a0\u4f60\u7684\u5206\u6570\uff0c\u66f4\u5feb\u7684\u5b8c\u6210\u65f6\u95f4\u4f1a\u83b7\u5f97\u66f4\u9ad8\u7684\u5956\u52b1\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5706\u5f62\u7269\u72c2\u6f6e\u201d\u5173\u5361\u4e2d\uff0c\u6536\u96c6\u6240\u6709\u5706\u5f62\u7269\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u5206\u6570\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u5706\u5f62\u7269\u4ef7\u503c\uff1a100 \u5206\uff0c\u65f6\u95f4\u5956\u52b1\uff1a1 \u5206\u949f\u5185\u5b8c\u6210\u53ef\u83b7\u5f97 500 \u5206\u3002]"}, {"question": "\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\u4f18\u5316\u51e0\u4f55\u51b2\u523a\u9759\u97f3\u5706\u5708\u6027\u80fd\u7684\u6700\u4f73\u8bbe\u7f6e\u662f\u4ec0\u4e48\uff1f", "answer": "\u4e3a\u4e86\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\u4f18\u5316\u6027\u80fd\uff0c\u8bf7\u8c03\u6574\u56fe\u5f62\u8bbe\u7f6e\u4ee5\u51cf\u5c11\u5ef6\u8fdf\u3002\u964d\u4f4e\u5206\u8fa8\u7387\u5e76\u7981\u7528\u4e0d\u5fc5\u8981\u7684\u7279\u6548\u3002\u4f8b\u5982\uff0c\u5728\u201c\u9759\u97f3\u5706\u5708\u201d\u5173\u5361\u4e2d\uff0c\u51cf\u5c11\u7c92\u5b50\u7279\u6548\u53ef\u4ee5\u63d0\u9ad8\u5e27\u901f\u7387\u3002\u6b65\u9aa41\uff1a\u8fdb\u5165\u8bbe\u7f6e\u83dc\u5355\u3002\u6b65\u9aa42\uff1a\u5c06\u5206\u8fa8\u7387\u964d\u4f4e\u5230\u201c\u4e2d\u7b49\u201d\u3002\u6b65\u9aa43\uff1a\u7981\u7528\u201c\u9634\u5f71\u201d\u548c\u201c\u7c92\u5b50\u7279\u6548\u201d\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u9ad8\u8bbe\u7f6e\uff1a\u5ef6\u8fdf\uff1b\u4e2d\u7b49\u8bbe\u7f6e\uff1a\u6d41\u7545\uff1b\u4f4e\u8bbe\u7f6e\uff1a\u57fa\u672c\u3002]"}, {"question": "\u51e0\u4f55\u51b2\u523a\u9759\u97f3\u5706\u5708\u4e2d\u54ea\u4e9b\u5173\u5361\u88ab\u8ba4\u4e3a\u662f\u6700\u96be\u7684\uff0c\u4e3a\u4ec0\u4e48\uff1f", "answer": "\u51e0\u4f55\u51b2\u523a\u9759\u97f3\u5706\u5708\u4e2d\u6700\u96be\u7684\u5173\u5361\u662f\u201c\u9759\u97f3\u5706\u5708\u201d\u548c\u201c\u91cd\u529b\u8f6c\u6362\u201d\uff0c\u56e0\u4e3a\u5b83\u4eec\u7684\u6a21\u5f0f\u548c\u91cd\u529b\u673a\u5236\u975e\u5e38\u590d\u6742\u3002\u201c\u9759\u97f3\u5706\u5708\u201d\u9700\u8981\u7cbe\u786e\u7684\u65f6\u673a\u548c\u8bb0\u5fc6\u529b\uff0c\u800c\u201c\u91cd\u529b\u8f6c\u6362\u201d\u5219\u901a\u8fc7\u9891\u7e41\u7684\u91cd\u529b\u53d8\u5316\u6765\u6311\u6218\u73a9\u5bb6\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u4e00\u4e9b\u73a9\u5bb6\u89c9\u5f97\u201c\u9759\u97f3\u5706\u5708\u201d\u66f4\u96be\uff0c\u56e0\u4e3a\u5b83\u6bd4\u8f83\u957f\uff1b\u800c\u53e6\u4e00\u4e9b\u73a9\u5bb6\u5219\u66f4\u96be\u4ee5\u5e94\u5bf9\u201c\u91cd\u529b\u8f6c\u6362\u201d\uff0c\u56e0\u4e3a\u4e0d\u65ad\u53d8\u5316\u7684\u89c6\u89d2\u3002]"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684\u51e0\u4f55\u51b2\u523a\u9759\u97f3\u5706\u5708\u8fdb\u5ea6\u4ece\u4e00\u53f0\u8bbe\u5907\u8f6c\u79fb\u5230\u53e6\u4e00\u53f0\u8bbe\u5907\uff1f", "answer": "\u8981\u8f6c\u79fb\u4f60\u7684\u8fdb\u5ea6\uff0c\u8bf7\u4f7f\u7528\u4e91\u4fdd\u5b58\u529f\u80fd\u3002\u9996\u5148\uff0c\u786e\u4fdd\u4f60\u5728\u4e24\u53f0\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u5e10\u6237\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u8981\u5c06\u5b89\u5353\u8bbe\u5907\u7684\u8fdb\u5ea6\u8f6c\u79fb\u5230\u82f9\u679c\u8bbe\u5907\uff0c\u8bf7\u7528\u4f60\u7684\u8c37\u6b4c\u8d26\u53f7\u6216\u82f9\u679c\u8d26\u53f7\u767b\u5f55\u3002\u6b65\u9aa41\uff1a\u5728\u65e7\u8bbe\u5907\u4e0a\u6253\u5f00\u6e38\u620f\u5e76\u542f\u7528\u4e91\u4fdd\u5b58\u3002\u6b65\u9aa42\uff1a\u5728\u65b0\u8bbe\u5907\u4e0a\u7528\u540c\u4e00\u4e2a\u5e10\u6237\u767b\u5f55\u3002\u6b65\u9aa43\uff1a\u4ece\u4e91\u7aef\u540c\u6b65\u4f60\u7684\u8fdb\u5ea6\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u65e7\u8bbe\u5907\u2192\u4e91\u4fdd\u5b58\u2192\u65b0\u8bbe\u5907\u3002]"}, {"question": "\u51e0\u4f55\u51b2\u523a\u9759\u97f3\u5706\u5708\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u7684\u79d8\u5bc6\u6216\u5f69\u86cb\uff1f", "answer": "\u51e0\u4f55\u51b2\u523a\u9759\u97f3\u5706\u5708\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u7684\u79d8\u5bc6\uff0c\u4f8b\u5982\u201c\u9759\u97f3\u5706\u5708\u201d\u5173\u5361\u4e2d\u7684\u201c\u91d1\u8272\u5706\u5708\u201d\u3002\u8981\u627e\u5230\u5b83\uff0c\u4f60\u9700\u8981\u8d70\u4e00\u6761\u4e0d\u90a3\u4e48\u663e\u800c\u6613\u89c1\u7684\u7279\u5b9a\u8def\u5f84\u3002\u4f8b\u5982\uff0c\u5728\u4e2d\u95f4\u90e8\u5206\uff0c\u8df3\u8fc7\u4e00\u7cfb\u5217\u9690\u85cf\u7684\u5e73\u53f0\u4ee5\u63ed\u793a\u91d1\u8272\u5706\u5708\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u8fd9\u5c31\u50cf\u5728\u4e00\u4e2a\u8ff7\u5bab\u4e2d\u627e\u5230\u4e00\u4e2a\u9690\u85cf\u7684\u5b9d\u7bb1\u3002]"}, {"question": "\u5982\u4f55\u63d0\u9ad8\u6211\u7684\u53cd\u5e94\u65f6\u95f4\uff0c\u4ee5\u5728\u51e0\u4f55\u51b2\u523a\u9759\u97f3\u5706\u5708\u4e2d\u5b8c\u6210\u66f4\u5feb\u7684\u5173\u5361\uff1f", "answer": "\u63d0\u9ad8\u53cd\u5e94\u65f6\u95f4\u9700\u8981\u7ec3\u4e60\u548c\u4e13\u6ce8\u3002\u9996\u5148\uff0c\u73a9\u8f83\u6162\u7684\u5173\u5361\u6765\u5efa\u7acb\u808c\u8089\u8bb0\u5fc6\uff0c\u7136\u540e\u9010\u6e10\u63d0\u9ad8\u96be\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u201c\u901f\u5ea6\u8dd1\u201d\u5173\u5361\u4e2d\uff0c\u5e94\u5173\u6ce8\u9884\u6d4b\u969c\u788d\u7269\u800c\u4e0d\u662f\u5bf9\u969c\u788d\u7269\u505a\u51fa\u53cd\u5e94\u3002\u6b65\u9aa41\uff1a\u73a9\u6a21\u5f0f\u53ef\u9884\u6d4b\u7684\u5173\u5361\u3002\u6b65\u9aa42\uff1a\u9010\u6e10\u589e\u52a0\u5173\u5361\u901f\u5ea6\u3002\u6b65\u9aa43\uff1a\u5229\u7528\u89c6\u89c9\u548c\u542c\u89c9\u7ebf\u7d22\u6765\u9884\u6d4b\u8df3\u8dc3\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u4e00\u4e9b\u73a9\u5bb6\u4f7f\u7528\u8bad\u7ec3\u5e94\u7528\uff0c\u800c\u53e6\u4e00\u4e9b\u73a9\u5bb6\u5219\u66f4\u559c\u6b22\u5728\u6e38\u620f\u4e2d\u7ec3\u4e60\u3002]"}, {"question": "\u5728\u51e0\u4f55\u51b2\u523a\u9759\u97f3\u5706\u5708\u4e2d\u521d\u5b66\u8005\u6700\u5e38\u89c1\u7684\u9519\u8bef\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5982\u4f55\u907f\u514d\u5b83\u4eec\uff1f", "answer": "\u5e38\u89c1\u7684\u9519\u8bef\u5305\u62ec\u8fc7\u5ea6\u8df3\u8dc3\u548c\u4e0d\u6ce8\u610f\u8282\u594f\u3002\u4f8b\u5982\uff0c\u5728\u201c\u7b2c\u4e00\u6b65\u201d\u5173\u5361\u4e2d\uff0c\u521d\u5b66\u8005\u7ecf\u5e38\u8df3\u8dc3\u8fc7\u65e9\u6216\u8fc7\u665a\u3002\u6b65\u9aa41\uff1a\u7ec3\u4e60\u5c06\u8df3\u8dc3\u4e0e\u97f3\u4e50\u8282\u594f\u540c\u6b65\u3002\u6b65\u9aa42\uff1a\u907f\u514d\u7528\u529b\u8fc7\u731b\u6216\u8fc7\u8f7b\u5730\u6309\u8df3\u8dc3\u952e\u3002\u6b65\u9aa43\uff1a\u4fdd\u6301\u51b7\u9759\u548c\u4e13\u6ce8\uff0c\u5c24\u5176\u662f\u5728\u8282\u594f\u5feb\u7684\u90e8\u5206\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u8fd9\u5c31\u50cf\u5b66\u4e60\u8df3\u821e\uff0c\u4f60\u9700\u8981\u4e0e\u97f3\u4e50\u4fdd\u6301\u540c\u6b65\u3002]"}]
[{"question": "\ucd08\ubcf4\uc790\ub85c\uc11c Geometry Dash Silent Circles\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc5b4\ub5bb\uac8c \uc219\ub2ec\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Geometry Dash Silent Circles\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc219\ub2ec\ud558\ub824\uba74, \uba3c\uc800 \uc810\ud504 \uba54\ucee4\ub2c8\uc998\uc5d0 \uc775\uc219\ud574\uc9c0\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uc810\ud504 \ud0c0\uc774\ubc0d \uc5f0\uc2b5\uc744 \ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c \ubfb0\uc871\ud55c \ub3cc\uae30 \uc704\ub97c \uc815\ud655\ud558\uac8c \uc810\ud504\ud574\uc57c \ud569\ub2c8\ub2e4. STEP1: \ud654\uba74\uc744 \ud0ed\ud558\uac70\ub098 \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \ub20c\ub7ec \uc810\ud504\ud569\ub2c8\ub2e4. STEP2: \ub808\ubca8\uc758 \ub9ac\ub4ec\uc744 \uad00\ucc30\ud558\uc5ec \uc810\ud504\ub97c \uc608\uce21\ud569\ub2c8\ub2e4. STEP3: \uc791\uc740 \uc7a5\uc560\ubb3c\uc5d0\ub294 \uc9e7\uace0 \uc81c\uc5b4\ub41c \ud0ed\uc744, \ub192\uc740 \uc810\ud504\uc5d0\ub294 \ub354 \uae34 \ud0ed\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc904\ub118\uae30\uc640 \uac19\uc2b5\ub2c8\ub2e4. \ud0c0\uc774\ubc0d\uc774 \uc911\uc694\ud569\ub2c8\ub2e4.]"}, {"question": "Geometry Dash Silent Circles\uc758 \uace0\uae09 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uae30 \uc704\ud55c \uc8fc\uc694 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Geometry Dash Silent Circles\uc758 \uace0\uae09 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\ub824\uba74 \uc815\ud655\uc131\uacfc \uc219\ub2ec\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uac01 \uc139\uc158\uc758 \ud328\ud134\uc744 \ubc30\uc6b0\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \u2018Silent Circles\u2019 \ub808\ubca8\uc5d0\uc11c\ub294 \ubcf5\uc7a1\ud55c \uc810\ud504 \uc2dc\ud000\uc2a4\uc640 \uc911\ub825 \ubcc0\ud654\uac00 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \ub808\ubca8\uc744 \uc5ec\ub7ec \ubc88 \ubc18\ubcf5\ud558\uc5ec \ud328\ud134\uc744 \uc219\ub2ec\ud569\ub2c8\ub2e4. STEP2: \ub808\ubca8\uc744 \uc791\uc740 \uc139\uc158\uc73c\ub85c \ub098\ub204\uace0 \uac01 \uc139\uc158\uc744 \uc5f0\uc2b5\ud569\ub2c8\ub2e4. STEP3: \uccb4\ud06c\ud3ec\uc778\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc811\uadfc \ubc29\uc2dd\uc744 \uac1c\uc120\ud569\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc811\uadfc\ubc95: \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\ub294 \uba54\ud2b8\ub85c\ub188\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub9ac\ub4ec\uc744 \uc720\uc9c0\ud558\ub294 \uac83\uc744 \uc120\ud638\ud558\uc9c0\ub9cc, \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub294 \uc2dc\uac01\uc801 \ud78c\ud2b8\uc5d0 \uc758\uc874\ud569\ub2c8\ub2e4.]"}, {"question": "Geometry Dash Silent Circles\uc758 \uc911\ub825 \uba54\ucee4\ub2c8\uc998\uc774 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc5b4\ub824\uc6b4 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Geometry Dash Silent Circles\uc758 \uc911\ub825 \uba54\ucee4\ub2c8\uc998\uc740 \uc810\ud504 \ubc29\ud5a5\uc774 \uc5ed\uc804\ub418\uae30 \ub54c\ubb38\uc5d0 \uc5b4\ub824\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub294 \ube60\ub978 \ubc18\uc751 \uc18d\ub3c4\uc640 \uc801\uc751\ub825\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \u2018Gravity Shift\u2019 \uc139\uc158\uc5d0\uc11c\ub294 \uc7a5\uc560\ubb3c\uc744 \uadf9\ubcf5\ud558\uae30 \uc704\ud574 \uc2dc\uac01\uc801 \uad00\uc810\uc744 \ubc14\uafd4\uc57c \ud569\ub2c8\ub2e4. STEP1: \uc911\ub825\uc774 \ubc14\ub014 \ub54c\ub97c \uc608\uce21\ud569\ub2c8\ub2e4. STEP2: \uc0c8\ub85c\uc6b4 \ubc29\ud5a5\uc5d0 \ub9de\ucdb0 \ud0c0\uc774\ubc0d\uc744 \uc870\uc815\ud569\ub2c8\ub2e4. STEP3: \ub354 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc5d0 \ub3c4\uc804\ud558\uae30 \uc804\uc5d0 \uac04\ub2e8\ud55c \ub808\ubca8\uc5d0\uc11c \uc774 \uba54\ucee4\ub2c8\uc998\uc744 \uc5f0\uc2b5\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc790\uc804\uac70\ub97c \ubc30\uc6b0\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uade0\ud615\uc744 \uc720\uc9c0\ud558\uace0 \ube60\ub974\uac8c \uc870\uc815\ud574\uc57c \ud569\ub2c8\ub2e4.]"}, {"question": "Geometry Dash Silent Circles\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "Geometry Dash Silent Circles\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc218\uc9d1\ud55c \uc624\ube0c\uc758 \uac1c\uc218\uc640 \uc644\ub8cc \uc2dc\uac04\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uac01 \uc624\ube0c\ub294 \uc810\uc218\uc5d0 \ucd94\uac00\ub418\uba70, \uc644\ub8cc \uc2dc\uac04\uc774 \ube60\ub97c\uc218\ub85d \ub354 \ub192\uc740 \ubcf4\ub108\uc2a4\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \u2018Orb Frenzy\u2019 \ub808\ubca8\uc5d0\uc11c \ubaa8\ub4e0 \uc624\ube0c\ub97c \uc218\uc9d1\ud558\uba74 \uc810\uc218\uac00 \ud06c\uac8c \uc99d\uac00\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131\ud45c: \uc624\ube0c \uac00\uce58: 100\uc810, \uc2dc\uac04 \ubcf4\ub108\uc2a4: 1\ubd84 \ubbf8\ub9cc \uc2dc 500\uc810.]"}, {"question": "\ubaa8\ubc14\uc77c \uae30\uae30\uc5d0\uc11c Geometry Dash Silent Circles\uc758 \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\uae30 \uc704\ud55c \ucd5c\uc0c1\uc758 \uc124\uc815\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ubaa8\ubc14\uc77c \uae30\uae30\uc5d0\uc11c \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uadf8\ub798\ud53d \uc124\uc815\uc744 \uc870\uc815\ud558\uc5ec \uc9c0\uc5f0\uc744 \uc904\uc774\uc138\uc694. \ud574\uc0c1\ub3c4\ub97c \ub0ae\ucd94\uace0 \ubd88\ud544\uc694\ud55c \ud6a8\uacfc\ub97c \ube44\ud65c\uc131\ud654\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \u2018Silent Circles\u2019 \ub808\ubca8\uc5d0\uc11c \uc785\uc790 \ud6a8\uacfc\ub97c \uc904\uc774\uba74 \ud504\ub808\uc784 \uc18d\ub3c4\uac00 \ud5a5\uc0c1\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \uc124\uc815 \uba54\ub274\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4. STEP2: \ud574\uc0c1\ub3c4\ub97c \u2018\uc911\u2019\uc73c\ub85c \ub0ae\ucda5\ub2c8\ub2e4. STEP3: \u2018\uadf8\ub9bc\uc790\u2019\uc640 \u2018\uc785\uc790 \ud6a8\uacfc\u2019\ub97c \ube44\ud65c\uc131\ud654\ud569\ub2c8\ub2e4. [\uad6c\uc131\ud45c: \uace0\ud654\uc9c8: \uc9c0\uc5f0 \ubc1c\uc0dd, \uc911\ud654\uc9c8: \ubd80\ub4dc\ub7ec\uc6c0, \uc800\ud654\uc9c8: \uae30\ubcf8.]"}, {"question": "Geometry Dash Silent Circles\uc5d0\uc11c \uac00\uc7a5 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc740 \ubb34\uc5c7\uc774\uba70, \uadf8 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Geometry Dash Silent Circles\uc5d0\uc11c \uac00\uc7a5 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc740 \ubcf5\uc7a1\ud55c \ud328\ud134\uacfc \uc911\ub825 \uba54\ucee4\ub2c8\uc998\uc73c\ub85c \uc778\ud574 \u2018Silent Circles\u2019\uc640 \u2018Gravity Shift\u2019\uc785\ub2c8\ub2e4. \u2018Silent Circles\u2019\ub294 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uacfc \uc219\ub2ec\uc774 \ud544\uc694\ud558\uba70, \u2018Gravity Shift\u2019\ub294 \ube48\ubc88\ud55c \uc911\ub825 \ubcc0\ud654\ub85c \ud50c\ub808\uc774\uc5b4\ub97c \uc5b4\ub835\uac8c \ub9cc\ub4ed\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc811\uadfc\ubc95: \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\ub294 \uae38\uc774 \ub54c\ubb38\uc5d0 \u2018Silent Circles\u2019\uac00 \ub354 \uc5b4\ub835\ub2e4\uace0 \uc0dd\uac01\ud558\uc9c0\ub9cc, \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub294 \ub04a\uc784\uc5c6\ub294 \uad00\uc810 \ubcc0\ud654\ub85c \uc778\ud574 \u2018Gravity Shift\u2019\uac00 \ub354 \uc5b4\ub835\uac8c \ub290\uaef4\uc9d1\ub2c8\ub2e4.]"}, {"question": "Geometry Dash Silent Circles\uc5d0\uc11c \ud55c \uae30\uae30\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\ub824\uba74 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. \uba3c\uc800 \ub450 \uae30\uae30 \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc548\ub4dc\ub85c\uc774\ub4dc \uae30\uae30\uc5d0\uc11c iOS \uae30\uae30\ub85c \uc774\ub3d9\ud558\ub294 \uacbd\uc6b0 Google Play \ub610\ub294 Apple ID\ub85c \ub85c\uadf8\uc778\ud558\uc138\uc694. STEP1: \uc774\uc804 \uae30\uae30\uc5d0\uc11c \uac8c\uc784\uc744 \uc5f4\uace0 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4. STEP2: \uc0c8 \uae30\uae30\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. STEP3: \ud074\ub77c\uc6b0\ub4dc\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud569\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc774\uc804 \uae30\uae30 \u2192 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \u2192 \uc0c8 \uae30\uae30.]"}, {"question": "Geometry Dash Silent Circles\uc5d0\ub294 \uc228\uaca8\uc9c4 \ube44\ubc00\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\ub098\uc694?", "answer": "Geometry Dash Silent Circles\uc5d0\ub294 \u2018Silent Circles\u2019 \ub808\ubca8\uc758 \u2018\uace8\ub4e0 \uc11c\ud074\u2019\uacfc \uac19\uc740 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \ube44\ubc00\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\uac83\uc744 \ucc3e\uc73c\ub824\uba74 \uba85\ud655\ud558\uc9c0 \uc54a\uc740 \ud2b9\uc815 \uacbd\ub85c\ub97c \ub530\ub77c\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc911\uac04 \uc139\uc158\uc5d0\uc11c \uc228\uaca8\uc9c4 \ud50c\ub7ab\ud3fc \uc704\ub85c \uc810\ud504\ud558\uc5ec \uace8\ub4e0 \uc11c\ud074\uc744 \ub4dc\ub7ec\ub0bc \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ubbf8\ub85c \uc18d \uc228\uaca8\uc9c4 \ubcf4\ubb3c \uc0c1\uc790\ub97c \ucc3e\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "Geometry Dash Silent Circles\uc758 \ube60\ub978 \ub808\ubca8\uc744 \uc704\ud574 \ubc18\uc751 \uc2dc\uac04\uc744 \uc5b4\ub5bb\uac8c \uac1c\uc120\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ubc18\uc751 \uc2dc\uac04\uc744 \uac1c\uc120\ud558\ub824\uba74 \uc5f0\uc2b5\uacfc \uc9d1\uc911\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uba3c\uc800 \ub354 \ub290\ub9b0 \ub808\ubca8\uc744 \ud50c\ub808\uc774\ud558\uc5ec \uadfc\uc721 \uae30\uc5b5\uc744 \uad6c\ucd95\ud55c \ub2e4\uc74c \uc810\ucc28\uc801\uc73c\ub85c \ub09c\uc774\ub3c4\ub97c \ub192\uc774\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \u2018\uc2a4\ud53c\ub4dc \ub7f0\u2019 \ub808\ubca8\uc5d0\uc11c\ub294 \uc7a5\uc560\ubb3c\uc5d0 \ubc18\uc751\ud558\uae30\ubcf4\ub2e4\ub294 \uc7a5\uc560\ubb3c\uc744 \uc608\uce21\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. STEP1: \uc608\uce21 \uac00\ub2a5\ud55c \ud328\ud134\uc744 \uac00\uc9c4 \ub808\ubca8\uc744 \ud50c\ub808\uc774\ud569\ub2c8\ub2e4. STEP2: \uc810\ucc28\uc801\uc73c\ub85c \ub808\ubca8\uc758 \uc18d\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4. STEP3: \uc2dc\uac01\uc801 \ubc0f \uccad\uac01\uc801 \ud78c\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc810\ud504\ub97c \uc608\uce21\ud569\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc811\uadfc\ubc95: \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\ub294 \ud2b8\ub808\uc774\ub2dd \uc571\uc744 \uc0ac\uc6a9\ud558\uc9c0\ub9cc, \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub294 \uac8c\uc784 \ub0b4 \uc5f0\uc2b5\uc744 \uc120\ud638\ud569\ub2c8\ub2e4.]"}, {"question": "Geometry Dash Silent Circles\uc5d0\uc11c \ucd08\ubcf4\uc790\ub4e4\uc774 \ud754\ud788 \uc800\uc9c0\ub974\ub294 \uc2e4\uc218\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud53c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud754\ud55c \uc2e4\uc218\ub294 \uacfc\ub3c4\ud55c \uc810\ud504\uc640 \ub9ac\ub4ec\uc5d0 \uc8fc\uc758\ud558\uc9c0 \uc54a\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \u2018First Steps\u2019 \ub808\ubca8\uc5d0\uc11c \ucd08\ubcf4\uc790\ub294 \uc885\uc885 \ub108\ubb34 \uc774\ub974\uac70\ub098 \ub108\ubb34 \ub2a6\uac8c \uc810\ud504\ud569\ub2c8\ub2e4. STEP1: \uc74c\uc545\uacfc \ud568\uaed8 \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uc5f0\uc2b5\ud569\ub2c8\ub2e4. STEP2: \uc810\ud504 \ubc84\ud2bc\uc744 \ub108\ubb34 \uc138\uac8c \ub610\ub294 \ub108\ubb34 \uc57d\ud558\uac8c \ub204\ub974\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. STEP3: \ud2b9\ud788 \ube60\ub978 \uc139\uc158\uc5d0\uc11c \ucc28\ubd84\ud558\uace0 \uc9d1\uc911\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ucda4\uc744 \ubc30\uc6b0\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc74c\uc545\uacfc \ud568\uaed8 \ub9ac\ub4ec\uc744 \ub9de\ucdb0\uc57c \ud569\ub2c8\ub2e4.]"}]
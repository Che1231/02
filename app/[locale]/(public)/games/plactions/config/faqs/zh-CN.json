[{"question": "\u65b0\u624b\u5982\u4f55\u5feb\u901f\u638c\u63e1Plactions\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u5feb\u901f\u638c\u63e1Plactions\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u9996\u5148\u719f\u6089\u6e38\u620f\u4e2d\u7684\u79fb\u52a8\u673a\u5236\u3002\u4f7f\u7528WASD\u952e\u8fdb\u884c\u79fb\u52a8\uff0c\u9f20\u6807\u63a7\u5236\u89c6\u89d2\u3002\u4f8b\u5982\uff0c\u5728\u6559\u7a0b\u533a\u57df\u7ec3\u4e60\uff0c\u8ba9\u89d2\u8272\u7ed5\u8fc7\u969c\u788d\u7269\u6765\u719f\u6089\u79fb\u52a8\u3002\u63a5\u4e0b\u6765\uff0c\u5b66\u4e60\u57fa\u672c\u52a8\u4f5c\uff0c\u4f8b\u5982\u8df3\u8dc3\uff08\u7a7a\u683c\u952e\uff09\u548c\u4e0e\u7269\u4f53\u4e92\u52a8\uff08E\u952e\uff09\u3002\u6700\u540e\uff0c\u901a\u8fc7\u4e0e\u6559\u7a0b\u654c\u4eba\u8fdb\u884c\u7b80\u5355\u7684\u6218\u6597\u6765\u7ec3\u4e60\u6218\u6597\u64cd\u4f5c\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u628a\u64cd\u4f5c\u60f3\u8c61\u6210\u5b66\u4e60\u9a91\u81ea\u884c\u8f66\u2014\u2014\u5148\u6162\u540e\u5feb\uff0c\u9010\u6e10\u589e\u52a0\u901f\u5ea6\u548c\u590d\u6742\u5ea6\u3002]"}, {"question": "\u5728Plactions\u6e38\u620f\u4e2d\u73a9\u6ee1100\u5c0f\u65f6\u540e\uff0c\u54ea\u4e9b\u63d0\u5347\u7b56\u7565\u662f\u5fc5\u8981\u7684\uff1f", "answer": "\u5728Plactions\u6e38\u620f\u4e2d\u73a9\u6ee1100\u5c0f\u65f6\u540e\uff0c\u91cd\u70b9\u5728\u4e8e\u4f18\u5316\u89d2\u8272\u5c5e\u6027\u3002\u6b65\u9aa4\u4e00\uff1a\u5206\u6790\u4f60\u7684\u6e38\u620f\u98ce\u683c\u2014\u2014\u4f60\u662f\u66f4\u503e\u5411\u4e8e\u8fdb\u653b\u8fd8\u662f\u9632\u5b88\uff1f\u6b65\u9aa4\u4e8c\uff1a\u6295\u8d44\u4e8e\u4e0e\u4f60\u7684\u98ce\u683c\u76f8\u7b26\u7684\u6280\u80fd\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u66f4\u559c\u6b22\u8fdc\u7a0b\u6218\u6597\uff0c\u5347\u7ea7\u5f13\u7bad\u6280\u80fd\u3002\u6b65\u9aa4\u4e09\uff1a\u5b9a\u671f\u68c0\u67e5\u5e76\u8c03\u6574\u4f60\u7684\u88c5\u5907\u4ee5\u6700\u5927\u5316\u5c5e\u6027\u503c\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6bd4\u8f83\u4e0d\u540c\u7684\u76d4\u7532\u5957\u88c5\uff0c\u770b\u770b\u54ea\u4e00\u5957\u80fd\u6700\u597d\u5730\u5e73\u8861\u9632\u5fa1\u548c\u654f\u6377\u6027\u3002]"}, {"question": "\u5728Plactions\u6e38\u620f\u4e2d\uff0c\u4e3a\u4ec0\u4e48\u7406\u89e3\u5de5\u5320\u7cfb\u7edf\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u5728Plactions\u6e38\u620f\u4e2d\uff0c\u7406\u89e3\u5de5\u5320\u7cfb\u7edf\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u4f7f\u4f60\u80fd\u591f\u521b\u9020\u51fa\u5f3a\u5927\u7684\u7269\u54c1\uff0c\u663e\u8457\u63d0\u5347\u6e38\u620f\u4f53\u9a8c\u3002\u4f8b\u5982\uff0c\u6253\u9020\u50cf\u201c\u6c38\u6052\u4e4b\u5251\u201d\u8fd9\u6837\u7684\u9ad8\u9636\u6b66\u5668\u9700\u8981\u7279\u5b9a\u6750\u6599\uff0c\u8fd9\u4e9b\u6750\u6599\u53ea\u80fd\u901a\u8fc7\u63a2\u7d22\u548c\u6218\u6597\u83b7\u5f97\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u9996\u5148\u6536\u96c6\u8d44\u6e90\uff0c\u7136\u540e\u4f7f\u7528\u5de5\u5320\u754c\u9762\u5c06\u5b83\u4eec\u7ec4\u5408\uff0c\u6700\u540e\u88c5\u5907\u4f60\u65b0\u6253\u9020\u7684\u7269\u54c1\u3002]"}, {"question": "\u5728Plactions\u6e38\u620f\u4e2d\uff0c\u54ea\u4e2a\u89d2\u8272\u804c\u4e1a\u5728\u8fdb\u653b\u548c\u9632\u5fa1\u65b9\u9762\u53d6\u5f97\u4e86\u6700\u4f73\u5e73\u8861\uff1f", "answer": "\u5728Plactions\u6e38\u620f\u4e2d\uff0c\u5723\u9a91\u58eb\u804c\u4e1a\u5728\u8fdb\u653b\u548c\u9632\u5fa1\u65b9\u9762\u53d6\u5f97\u4e86\u6700\u4f73\u5e73\u8861\u3002\u51ed\u501f\u5176\u6280\u80fd\uff0c\u4f8b\u5982\u201c\u76fe\u51fb\u201d\u7528\u4e8e\u9632\u5fa1\u548c\u201c\u5723\u5149\u6253\u51fb\u201d\u7528\u4e8e\u8fdb\u653b\uff0c\u5723\u9a91\u58eb\u80fd\u591f\u9002\u5e94\u5404\u79cd\u6218\u6597\u60c5\u51b5\u3002\u4f8b\u5982\uff0c\u5728\u526f\u672c\u56e2\u6218\u4e2d\uff0c\u5723\u9a91\u58eb\u65e2\u80fd\u627f\u53d7\u4f24\u5bb3\uff0c\u53c8\u80fd\u5bf9\u654c\u4eba\u9020\u6210\u663e\u8457\u4f24\u5bb3\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6bd4\u8f83\u5723\u9a91\u58eb\u4e0e\u6218\u58eb\u548c\u6cd5\u5e08\u804c\u4e1a\uff0c\u7a81\u51fa\u5723\u9a91\u58eb\u7684\u591a\u529f\u80fd\u6027\u3002]"}, {"question": "Plactions\u4e2d\u7684\u7b49\u7ea7\u7cfb\u7edf\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u8fdb\u5ea6\uff1f", "answer": "Plactions\u4e2d\u7684\u7b49\u7ea7\u7cfb\u7edf\u4f1a\u76f4\u63a5\u5f71\u54cd\u6e38\u620f\u8fdb\u5ea6\uff0c\u56e0\u4e3a\u5b83\u4f1a\u89e3\u9501\u65b0\u7684\u6280\u80fd\u5e76\u63d0\u5347\u89d2\u8272\u5c5e\u6027\u3002\u4f8b\u5982\uff0c\u8fbe\u523010\u7ea7\u89e3\u9501\u201c\u53cc\u8df3\u201d\u6280\u80fd\uff0c\u4ece\u800c\u53ef\u4ee5\u8fdb\u5165\u4e4b\u524d\u65e0\u6cd5\u5230\u8fbe\u7684\u533a\u57df\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5347\u7ea7\u5c31\u50cf\u722c\u68af\u5b50\u4e00\u6837\u2014\u2014\u6bcf\u4e00\u6b65\u90fd\u628a\u4f60\u5e26\u5230\u66f4\u9ad8\u7684\u5c42\u6b21\u548c\u6311\u6218\u3002]"}, {"question": "Plactions\u4e2d\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u6709\u54ea\u4e9b\u4e3b\u8981\u533a\u522b\uff1f", "answer": "Plactions\u4e2d\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u7684\u4e3b\u8981\u533a\u522b\u5728\u4e8e\u6e38\u620f\u7126\u70b9\u548c\u4e92\u52a8\u65b9\u5f0f\u3002\u5355\u4eba\u6a21\u5f0f\u4fa7\u91cd\u4e8e\u6545\u4e8b\u548c\u63a2\u7d22\uff0c\u800c\u591a\u4eba\u6a21\u5f0f\u5219\u4fa7\u91cd\u4e8e\u5408\u4f5c\u548c\u7ade\u4e89\u6027\u6e38\u620f\u3002\u4f8b\u5982\uff0c\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f60\u53ef\u4ee5\u4e0e\u670b\u53cb\u7ec4\u961f\u5b8c\u6210\u5177\u6709\u6311\u6218\u6027\u7684\u526f\u672c\u6216\u5728PVP\u7ade\u6280\u573a\u4e2d\u7ade\u4e89\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6bd4\u8f83\u4e24\u79cd\u6a21\u5f0f\u7684\u5956\u52b1\u548c\u6311\u6218\uff0c\u5e2e\u52a9\u73a9\u5bb6\u51b3\u5b9a\u91cd\u70b9\u5173\u6ce8\u54ea\u79cd\u6a21\u5f0f\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728Plactions\u4e2d\u5207\u6362\u5e73\u53f0\u65f6\u786e\u4fdd\u6570\u636e\u5e73\u7a33\u8fc1\u79fb\uff1f", "answer": "\u4e3a\u4e86\u5728Plactions\u4e2d\u5e73\u7a33\u5730\u8fc1\u79fb\u6570\u636e\uff0c\u9996\u5148\u5c06\u4f60\u7684\u6e38\u620f\u8d26\u6237\u94fe\u63a5\u5230\u50cfSteam\u6216Epic Games\u8fd9\u6837\u7684\u901a\u7528\u5e73\u53f0\u3002\u5176\u6b21\uff0c\u786e\u4fdd\u4f60\u7684\u6e38\u620f\u6570\u636e\u540c\u6b65\u5230\u4e91\u7aef\u3002\u6700\u540e\uff0c\u767b\u5f55\u65b0\u5e73\u53f0\u4e0a\u7684\u4f60\u7684\u8d26\u6237\u5373\u53ef\u8bbf\u95ee\u4f60\u7684\u5b58\u6863\u6570\u636e\u3002\u4f8b\u5982\uff0c\u4ecePC\u8fc1\u79fb\u5230\u4e3b\u673a\u9700\u8981\u767b\u5f55\u4f60\u5df2\u94fe\u63a5\u7684\u4e3b\u673a\u7248\u8d26\u6237\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6bd4\u8f83\u4e0d\u540c\u5e73\u53f0\u7684\u6b65\u9aa4\uff0c\u4ee5\u786e\u4fdd\u6e05\u6670\u5ea6\u3002]"}, {"question": "\u5728Plactions\u4e2d\uff0c\u6709\u54ea\u4e9b\u9690\u85cf\u5185\u5bb9\u53ef\u4ee5\u88ab\u53d1\u73b0\uff0c\u4ee5\u53ca\u8fd9\u5982\u4f55\u63d0\u5347\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "Plactions\u4e2d\u7684\u9690\u85cf\u5185\u5bb9\uff0c\u4f8b\u5982\u79d8\u5bc6\u526f\u672c\u548c\u7a00\u6709\u7269\u54c1\uff0c\u901a\u8fc7\u63d0\u4f9b\u989d\u5916\u7684\u6311\u6218\u548c\u5956\u52b1\u6765\u63d0\u5347\u6e38\u620f\u4f53\u9a8c\u3002\u4f8b\u5982\uff0c\u53d1\u73b0\u201c\u5931\u843d\u795e\u5e99\u201d\u526f\u672c\u4e0d\u4ec5\u63d0\u4f9b\u72ec\u7279\u7684\u6218\u5229\u54c1\uff0c\u800c\u4e14\u52a0\u6df1\u4e86\u6e38\u620f\u7684\u4e16\u754c\u89c2\u3002[\u5f69\u86cb\u6316\u6398\uff1a\u63a2\u7d22\u6bcf\u4e00\u4e2a\u89d2\u843d\uff0c\u56e0\u4e3a\u9690\u85cf\u5185\u5bb9\u901a\u5e38\u9700\u8981\u654f\u9510\u7684\u89c2\u5bdf\u529b\u4ee5\u53ca\u89e3\u51b3\u8c1c\u9898\u7684\u80fd\u529b\u3002]"}, {"question": "Plactions\u4e2d\u7684\u6280\u80fd\u6811\u5982\u4f55\u5f71\u54cd\u89d2\u8272\u53d1\u5c55\uff1f", "answer": "Plactions\u4e2d\u7684\u6280\u80fd\u6811\u901a\u8fc7\u5141\u8bb8\u73a9\u5bb6\u6839\u636e\u81ea\u5df1\u7684\u6e38\u620f\u98ce\u683c\u5b9a\u5236\u6280\u80fd\u6765\u5f71\u54cd\u89d2\u8272\u53d1\u5c55\u3002\u4f8b\u5982\uff0c\u6295\u8d44\u4e8e\u201c\u6f5c\u884c\u201d\u5206\u652f\u4f1a\u589e\u5f3a\u6f5c\u884c\u548c\u6697\u6740\u6280\u80fd\uff0c\u800c\u201c\u6218\u6597\u201d\u5206\u652f\u5219\u4f1a\u63d0\u5347\u76f4\u63a5\u5bf9\u6297\u80fd\u529b\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u9996\u5148\u9009\u62e9\u4e3b\u8981\u6280\u80fd\u5206\u652f\uff0c\u7136\u540e\u5728\u4f60\u5347\u7ea7\u65f6\u5206\u914d\u70b9\u6570\u7ed9\u7279\u5b9a\u7684\u6280\u80fd\u3002]"}, {"question": "\u4e3a\u4e86\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u6548\u7387\uff0c\u5728Plactions\u4e2d\u5982\u4f55\u6700\u4f73\u5730\u7ba1\u7406\u8d44\u6e90\uff1f", "answer": "\u4e3a\u4e86\u5728Plactions\u4e2d\u6709\u6548\u5730\u7ba1\u7406\u8d44\u6e90\uff0c\u4f18\u5148\u6536\u96c6\u91cd\u8981\u7684\u6750\u6599\uff0c\u4f8b\u5982\u77ff\u77f3\u548c\u8349\u836f\u3002\u4f7f\u7528\u8d44\u6e90\u7ba1\u7406\u5de5\u5177\u8ddf\u8e2a\u4f60\u7684\u5e93\u5b58\u5e76\u8ba1\u5212\u4f60\u7684\u5236\u9020\u9700\u6c42\u3002\u4f8b\u5982\uff0c\u5728\u8e0f\u4e0a\u4efb\u52a1\u4e4b\u524d\uff0c\u786e\u4fdd\u4f60\u62e5\u6709\u8db3\u591f\u7684\u836f\u5242\u548c\u4fee\u7406\u5de5\u5177\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6bd4\u8f83\u4e0d\u540c\u7684\u8d44\u6e90\u7ba1\u7406\u7b56\u7565\uff0c\u627e\u5230\u6700\u9002\u5408\u4f60\u6e38\u620f\u98ce\u683c\u7684\u7b56\u7565\u3002]"}]
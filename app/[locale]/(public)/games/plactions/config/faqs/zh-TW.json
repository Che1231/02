[{"question": "Plactions\u65b0\u624b\u5982\u4f55\u5feb\u901f\u638c\u63e1\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1Plactions\u7684\u57fa\u672c\u63a7\u5236\uff0c\u8acb\u5148\u719f\u6089\u79fb\u52d5\u6a5f\u5236\u3002\u4f7f\u7528WASD\u9375\u9032\u884c\u79fb\u52d5\uff0c\u6ed1\u9f20\u63a7\u5236\u76f8\u6a5f\u3002\u4f8b\u5982\uff0c\u5728\u6559\u5b78\u5340\u57df\u4e2d\uff0c\u7df4\u7fd2\u8b93\u89d2\u8272\u7e5e\u904e\u969c\u7919\u7269\u3002\u63a5\u4e0b\u4f86\uff0c\u5b78\u7fd2\u57fa\u672c\u7684\u52d5\u4f5c\uff0c\u4f8b\u5982\u8df3\u8e8d\uff08\u7a7a\u683c\u9375\uff09\u548c\u8207\u7269\u9ad4\u4e92\u52d5\uff08E\u9375\uff09\u3002\u6700\u5f8c\uff0c\u900f\u904e\u8207\u6559\u5b78\u6575\u4eba\u9032\u884c\u7c21\u55ae\u7684\u6230\u9b25\u4f86\u5617\u8a66\u6230\u9b25\u63a7\u5236\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u63a7\u5236\u60f3\u50cf\u6210\u5b78\u7fd2\u9a0e\u81ea\u884c\u8eca\u2014\u2014\u4e00\u958b\u59cb\u6162\u6162\u4f86\uff0c\u7136\u5f8c\u9010\u6f38\u589e\u52a0\u901f\u5ea6\u548c\u8907\u96dc\u5ea6\u3002]"}, {"question": "\u5728Plactions\u904a\u6232\u4e2d\uff0c\u73a9\u8d85\u904e100\u5c0f\u6642\u5f8c\uff0c\u63d0\u5347\u7684\u5fc5\u8981\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728Plactions\u904a\u6232\u4e2d\u73a9\u8d85\u904e100\u5c0f\u6642\u5f8c\uff0c\u91cd\u9ede\u5728\u65bc\u512a\u5316\u89d2\u8272\u7684\u7d44\u6210\u3002\u6b65\u9a5f\u4e00\uff1a\u5206\u6790\u4f60\u7684\u904a\u6232\u98a8\u683c\u2014\u2014\u4f60\u662f\u50be\u5411\u65bc\u7a4d\u6975\u9032\u653b\u9084\u662f\u9632\u5b88\uff1f\u6b65\u9a5f\u4e8c\uff1a\u6295\u8cc7\u80fd\u8f14\u52a9\u4f60\u98a8\u683c\u7684\u6280\u80fd\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u504f\u597d\u9060\u7a0b\u6230\u9b25\uff0c\u5347\u7d1a\u4f60\u7684\u5f13\u7bad\u6280\u80fd\u3002\u6b65\u9a5f\u4e09\uff1a\u5b9a\u671f\u6aa2\u8996\u4e26\u8abf\u6574\u4f60\u7684\u88dd\u5099\uff0c\u4ee5\u6700\u5927\u5316\u5c6c\u6027\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6bd4\u8f03\u4e0d\u540c\u7684\u88dd\u7532\u5957\u88dd\uff0c\u770b\u770b\u54ea\u4e00\u5957\u80fd\u63d0\u4f9b\u6700\u4f73\u7684\u9632\u79a6\u548c\u654f\u6377\u5e73\u8861\u3002]"}, {"question": "\u70ba\u4f55\u5728Plactions\u904a\u6232\u4e2d\u7406\u89e3\u88fd\u4f5c\u7cfb\u7d71\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u5728Plactions\u904a\u6232\u4e2d\u7406\u89e3\u88fd\u4f5c\u7cfb\u7d71\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u80fd\u8b93\u4f60\u5275\u9020\u51fa\u5f37\u5927\u7684\u7269\u54c1\uff0c\u986f\u8457\u63d0\u5347\u4f60\u7684\u904a\u6232\u9ad4\u9a57\u3002\u4f8b\u5982\uff0c\u88fd\u4f5c\u9ad8\u968e\u6b66\u5668\u300c\u6c38\u6046\u4e4b\u5203\u300d\u9700\u8981\u7279\u5b9a\u7684\u6750\u6599\uff0c\u9019\u4e9b\u6750\u6599\u53ea\u80fd\u900f\u904e\u63a2\u7d22\u548c\u6230\u9b25\u7372\u5f97\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u9996\u5148\u6536\u96c6\u8cc7\u6e90\uff0c\u7136\u5f8c\u4f7f\u7528\u88fd\u4f5c\u9078\u55ae\u5c07\u5b83\u5011\u7d50\u5408\uff0c\u6700\u5f8c\u88dd\u5099\u4f60\u65b0\u88fd\u4f5c\u7684\u7269\u54c1\u3002]"}, {"question": "\u5728Plactions\u4e2d\uff0c\u54ea\u500b\u89d2\u8272\u8077\u696d\u5728\u653b\u64ca\u548c\u9632\u79a6\u4e4b\u9593\u63d0\u4f9b\u6700\u4f73\u5e73\u8861\uff1f", "answer": "Plactions\u904a\u6232\u4e2d\u7684\u8056\u9a0e\u58eb\u8077\u696d\u5728\u653b\u64ca\u548c\u9632\u79a6\u4e4b\u9593\u63d0\u4f9b\u6700\u4f73\u5e73\u8861\u3002\u64c1\u6709\u300c\u76fe\u64ca\u300d\u7b49\u9632\u79a6\u80fd\u529b\u548c\u300c\u8056\u5149\u885d\u64ca\u300d\u7b49\u653b\u64ca\u80fd\u529b\uff0c\u8056\u9a0e\u58eb\u53ef\u4ee5\u9069\u61c9\u5404\u7a2e\u6230\u9b25\u60c5\u6cc1\u3002\u4f8b\u5982\uff0c\u5728\u526f\u672c\u7a81\u8972\u4e2d\uff0c\u8056\u9a0e\u58eb\u65e2\u80fd\u625b\u4e0b\u50b7\u5bb3\uff0c\u4e5f\u80fd\u5c0d\u6575\u4eba\u9020\u6210\u986f\u8457\u50b7\u5bb3\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u6bd4\u8f03\u8056\u9a0e\u58eb\u8207\u6230\u58eb\u548c\u9b54\u6cd5\u5e2b\u8077\u696d\uff0c\u5f37\u8abf\u8056\u9a0e\u58eb\u7684\u591a\u529f\u80fd\u6027\u3002]"}, {"question": "Plactions\u904a\u6232\u4e2d\u7684\u7b49\u7d1a\u7cfb\u7d71\u5982\u4f55\u5f71\u97ff\u904a\u6232\u9032\u5ea6\uff1f", "answer": "Plactions\u904a\u6232\u4e2d\u7684\u7b49\u7d1a\u7cfb\u7d71\u76f4\u63a5\u5f71\u97ff\u904a\u6232\u9032\u5ea6\uff0c\u56e0\u70ba\u5b83\u80fd\u89e3\u9396\u65b0\u7684\u80fd\u529b\u4e26\u63d0\u5347\u89d2\u8272\u7684\u5c6c\u6027\u3002\u4f8b\u5982\uff0c\u9054\u523010\u7d1a\u89e3\u9396\u300c\u96d9\u8df3\u300d\u80fd\u529b\uff0c\u9019\u80fd\u8b93\u4f60\u9032\u5165\u4e4b\u524d\u7121\u6cd5\u5230\u9054\u7684\u5730\u5340\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5347\u7d1a\u5c31\u50cf\u722c\u968e\u68af\u4e00\u6a23\u2014\u2014\u6bcf\u4e00\u7d1a\u90fd\u8b93\u4f60\u66f4\u63a5\u8fd1\u65b0\u7684\u9ad8\u5ea6\u548c\u6311\u6230\u3002]"}, {"question": "Plactions\u904a\u6232\u4e2d\u7684\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "Plactions\u904a\u6232\u4e2d\u7684\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u7684\u4e3b\u8981\u5dee\u7570\u5728\u65bc\u91cd\u9ede\u548c\u4e92\u52d5\u3002\u55ae\u4eba\u6a21\u5f0f\u5f37\u8abf\u5287\u60c5\u548c\u63a2\u7d22\uff0c\u800c\u591a\u4eba\u6a21\u5f0f\u5247\u8457\u91cd\u65bc\u5408\u4f5c\u548c\u7af6\u722d\u904a\u6232\u3002\u4f8b\u5982\uff0c\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f60\u53ef\u4ee5\u8207\u670b\u53cb\u7d44\u968a\u6311\u6230\u5177\u6709\u6311\u6230\u6027\u7684\u8972\u64ca\uff0c\u6216\u5728PvP\u7af6\u6280\u5834\u4e2d\u7af6\u722d\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u6bd4\u8f03\u5169\u7a2e\u6a21\u5f0f\u7684\u734e\u52f5\u548c\u6311\u6230\uff0c\u5e6b\u52a9\u73a9\u5bb6\u6c7a\u5b9a\u8981\u5c08\u6ce8\u65bc\u54ea\u4e00\u7a2e\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728Plactions\u904a\u6232\u4e2d\u9032\u884c\u5e73\u53f0\u5207\u63db\u6642\u78ba\u4fdd\u8cc7\u6599\u9077\u79fb\u9806\u5229\uff1f", "answer": "\u8981\u5728Plactions\u904a\u6232\u4e2d\u9032\u884c\u5e73\u53f0\u5207\u63db\u6642\u78ba\u4fdd\u8cc7\u6599\u9077\u79fb\u9806\u5229\uff0c\u9996\u5148\u5c07\u904a\u6232\u5e33\u865f\u9023\u7d50\u5230\u901a\u7528\u5e73\u53f0\uff0c\u4f8b\u5982Steam\u6216Epic Games\u3002\u63a5\u4e0b\u4f86\uff0c\u78ba\u4fdd\u4f60\u7684\u904a\u6232\u8cc7\u6599\u540c\u6b65\u5230\u96f2\u7aef\u3002\u6700\u5f8c\uff0c\u767b\u5165\u65b0\u5e73\u53f0\u4e0a\u7684\u5e33\u865f\uff0c\u5c31\u80fd\u5b58\u53d6\u4f60\u7684\u5132\u5b58\u8cc7\u6599\u3002\u4f8b\u5982\uff0c\u5f9e\u96fb\u8166\u9077\u79fb\u5230\u4e3b\u6a5f\u9700\u8981\u5728\u4e3b\u6a5f\u7248\u672c\u767b\u5165\u6240\u9023\u7d50\u7684\u5e33\u865f\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6bd4\u8f03\u4e0d\u540c\u5e73\u53f0\u7684\u6b65\u9a5f\uff0c\u4ee5\u78ba\u4fdd\u6e05\u6670\u5ea6\u3002]"}, {"question": "\u5728Plactions\u904a\u6232\u4e2d\uff0c\u54ea\u4e9b\u96b1\u85cf\u5167\u5bb9\u53ef\u4ee5\u88ab\u767c\u73fe\uff0c\u4ee5\u53ca\u5982\u4f55\u63d0\u5347\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "Plactions\u904a\u6232\u4e2d\u7684\u96b1\u85cf\u5167\u5bb9\uff0c\u4f8b\u5982\u79d8\u5bc6\u526f\u672c\u548c\u7a00\u6709\u7269\u54c1\uff0c\u80fd\u85c9\u7531\u63d0\u4f9b\u984d\u5916\u7684\u6311\u6230\u548c\u734e\u52f5\u4f86\u63d0\u5347\u904a\u6232\u9ad4\u9a57\u3002\u4f8b\u5982\uff0c\u767c\u73fe\u300c\u5931\u843d\u7684\u8056\u6bbf\u300d\u526f\u672c\u4e0d\u50c5\u80fd\u63d0\u4f9b\u7368\u7279\u7684\u6230\u5229\u54c1\uff0c\u800c\u4e14\u4e5f\u52a0\u6df1\u4e86\u904a\u6232\u7684\u80cc\u666f\u6545\u4e8b\u3002[\u5f69\u86cb\u6316\u6398\uff1a\u63a2\u7d22\u6bcf\u500b\u89d2\u843d\uff0c\u56e0\u70ba\u96b1\u85cf\u5167\u5bb9\u901a\u5e38\u9700\u8981\u654f\u92b3\u7684\u89c0\u5bdf\u529b\u4ee5\u53ca\u89e3\u8b0e\u6280\u5de7\u3002]"}, {"question": "Plactions\u904a\u6232\u4e2d\u7684\u6280\u80fd\u6a39\u5982\u4f55\u5f71\u97ff\u89d2\u8272\u767c\u5c55\uff1f", "answer": "Plactions\u904a\u6232\u4e2d\u7684\u6280\u80fd\u6a39\u80fd\u8b93\u73a9\u5bb6\u6839\u64da\u500b\u4eba\u904a\u6232\u98a8\u683c\u81ea\u8a02\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u6295\u8cc7\u65bc\u300c\u6f5b\u884c\u300d\u5206\u652f\uff0c\u53ef\u4ee5\u63d0\u5347\u6f5b\u884c\u548c\u6697\u6bba\u6280\u80fd\uff0c\u800c\u300c\u6230\u9b25\u300d\u5206\u652f\u5247\u80fd\u6539\u5584\u76f4\u63a5\u5c0d\u6297\u80fd\u529b\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u9996\u5148\u9078\u64c7\u4e3b\u8981\u7684\u6280\u80fd\u5206\u652f\uff0c\u7136\u5f8c\u96a8\u8457\u7b49\u7d1a\u63d0\u5347\uff0c\u5206\u914d\u81f3\u7279\u5b9a\u6280\u80fd\u3002]"}, {"question": "\u5728Plactions\u904a\u6232\u4e2d\uff0c\u5982\u4f55\u6709\u6548\u7ba1\u7406\u8cc7\u6e90\u4ee5\u6700\u5927\u5316\u6548\u7387\uff1f", "answer": "\u8981\u5728Plactions\u904a\u6232\u4e2d\u6709\u6548\u7ba1\u7406\u8cc7\u6e90\uff0c\u8acb\u512a\u5148\u6536\u96c6\u91cd\u8981\u7684\u6750\u6599\uff0c\u4f8b\u5982\u7926\u7269\u548c\u85e5\u8349\u3002\u4f7f\u7528\u8cc7\u6e90\u7ba1\u7406\u5de5\u5177\u4f86\u8ffd\u8e64\u4f60\u7684\u5eab\u5b58\u4e26\u898f\u5283\u4f60\u7684\u88fd\u4f5c\u9700\u6c42\u3002\u4f8b\u5982\uff0c\u5728\u958b\u59cb\u4efb\u52d9\u4e4b\u524d\uff0c\u78ba\u4fdd\u4f60\u6709\u8db3\u5920\u7684\u85e5\u6c34\u548c\u4fee\u7406\u5de5\u5177\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u6bd4\u8f03\u4e0d\u540c\u7684\u8cc7\u6e90\u7ba1\u7406\u7b56\u7565\uff0c\u627e\u5230\u6700\u9069\u5408\u4f60\u7684\u904a\u6232\u98a8\u683c\u7684\u90a3\u4e00\u7a2e\u3002]"}]
[{"question": "\ud50c\ub799\uc158\uc2a4 \ucd08\ubcf4\uc790\uac00 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \ub9c8\uc2a4\ud130\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud50c\ub799\uc158\uc2a4\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \ub9c8\uc2a4\ud130\ud558\ub824\uba74 \uba3c\uc800 \uc774\ub3d9 \uba54\ucee4\ub2c8\uc998\uc5d0 \uc775\uc219\ud574\uc9c0\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. WASD \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc774\ub3d9\ud558\uace0 \ub9c8\uc6b0\uc2a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uce74\uba54\ub77c\ub97c \uc81c\uc5b4\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud29c\ud1a0\ub9ac\uc5bc \uc601\uc5ed\uc744 \ud0d0\uc0c9\ud558\uba74\uc11c \uce90\ub9ad\ud130\ub97c \uc7a5\uc560\ubb3c\uc744 \ud53c\ud574 \uc6c0\uc9c1\uc774\ub294 \uc5f0\uc2b5\uc744 \ud569\ub2c8\ub2e4. \ub2e4\uc74c\uc73c\ub85c \uc810\ud504(\uc2a4\ud398\uc774\uc2a4\ubc14)\uc640 \ubb3c\uccb4 \uc0c1\ud638\uc791\uc6a9(E \ud0a4)\uacfc \uac19\uc740 \uae30\ubcf8 \ub3d9\uc791\uc744 \ubc30\uc6b0\uc138\uc694. \ub9c8\uc9c0\ub9c9\uc73c\ub85c \ud29c\ud1a0\ub9ac\uc5bc \uc801\uacfc\uc758 \uac04\ub2e8\ud55c \uc804\ud22c\ub97c \ud1b5\ud574 \uc804\ud22c \ucee8\ud2b8\ub864\uc744 \uc2e4\ud5d8\ud574 \ubcf4\uc138\uc694. [\ube44\uc720 \uc124\uba85: \ucee8\ud2b8\ub864\uc744 \uc790\uc804\uac70 \ud0c0\ub294 \ubc95\uc5d0 \ube44\uc720\ud558\uba74, \ucc9c\ucc9c\ud788 \uc2dc\uc791\ud558\uc5ec \uc810\ucc28 \uc18d\ub3c4\uc640 \ubcf5\uc7a1\uc131\uc744 \ub192\uc5ec \ub098\uac00\uc138\uc694.]"}, {"question": "\ud50c\ub799\uc158\uc2a4\uc5d0\uc11c 100\uc2dc\uac04 \ud50c\ub808\uc774 \ud6c4 \ubc1c\uc804\uc744 \uc704\ud55c \ud544\uc218 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud50c\ub799\uc158\uc2a4\uc5d0\uc11c 100\uc2dc\uac04 \ud50c\ub808\uc774 \ud6c4\uc5d0\ub294 \uce90\ub9ad\ud130 \ube4c\ub4dc\ub97c \ucd5c\uc801\ud654\ud558\ub294 \ub370 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. STEP1: \uc790\uc2e0\uc758 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub300\ud574 \ubd84\uc11d\ud558\uc138\uc694\u2014\uacf5\uaca9\uc801\uc778 \ud50c\ub808\uc774\uc5b4\uc778\uac00\uc694 \uc544\ub2c8\uba74 \ubc29\uc5b4\uc801\uc778 \ud50c\ub808\uc774\uc5b4\uc778\uac00\uc694? STEP2: \uc790\uc2e0\uc758 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\ub294 \uc2a4\ud0ac\uc5d0 \ud22c\uc790\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc6d0\uac70\ub9ac \uc804\ud22c\ub97c \uc120\ud638\ud55c\ub2e4\uba74 \ud65c \uc2a4\ud0ac\uc744 \uac15\ud654\ud558\uc138\uc694. STEP3: \uc815\uae30\uc801\uc73c\ub85c \uc7a5\ube44\ub97c \uac80\ud1a0\ud558\uace0 \ucd5c\ub300\uc758 \uc2a4\ud15f\uc744 \uc5bb\uae30 \uc704\ud574 \uc870\uc815\ud558\uc138\uc694. [\uc124\uc815 \ube44\uad50\ud45c: \ub2e4\ub978 \uac11\uc637 \uc138\ud2b8\ub97c \ube44\uad50\ud558\uc5ec \ubc29\uc5b4\ub825\uacfc \ubbfc\ucca9\uc131\uc758 \ucd5c\uc801 \uade0\ud615\uc744 \uc81c\uacf5\ud558\ub294 \uc138\ud2b8\ub97c \ucc3e\uc73c\uc138\uc694.]"}, {"question": "\ud50c\ub799\uc158\uc2a4\uc5d0\uc11c \uc81c\uc791 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud50c\ub799\uc158\uc2a4\uc5d0\uc11c \uc81c\uc791 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \uc911\uc694\ud569\ub2c8\ub2e4. \uc81c\uc791 \uc2dc\uc2a4\ud15c\uc744 \ud1b5\ud574 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\ub294 \uac15\ub825\ud55c \uc544\uc774\ud15c\uc744 \ub9cc\ub4e4 \uc218 \uc788\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc601\uc6d0\ud55c \uac80\"\uacfc \uac19\uc740 \uace0\ub808\ubca8 \ubb34\uae30\ub97c \uc81c\uc791\ud558\ub824\uba74 \ud0d0\ud5d8\uacfc \uc804\ud22c\ub97c \ud1b5\ud574\uc11c\ub9cc \uc5bb\uc744 \uc218 \uc788\ub294 \ud2b9\uc815 \uc7ac\ub8cc\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uba3c\uc800 \uc790\uc6d0\uc744 \uc218\uc9d1\ud558\uace0, \uc81c\uc791 \uba54\ub274\ub97c \uc0ac\uc6a9\ud558\uc5ec \uacb0\ud569\ud558\uace0, \ub9c8\uc9c0\ub9c9\uc73c\ub85c \uc0c8\ub85c \uc81c\uc791\ud55c \uc544\uc774\ud15c\uc744 \uc7a5\ucc29\ud558\uc138\uc694.]"}, {"question": "\ud50c\ub799\uc158\uc2a4\uc5d0\uc11c \uacf5\uaca9\uacfc \ubc29\uc5b4\uc758 \uade0\ud615\uc774 \uac00\uc7a5 \uc88b\uc740 \uce90\ub9ad\ud130 \ud074\ub798\uc2a4\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud50c\ub799\uc158\uc2a4\uc5d0\uc11c \uacf5\uaca9\uacfc \ubc29\uc5b4\uc758 \uade0\ud615\uc774 \uac00\uc7a5 \uc88b\uc740 \uce90\ub9ad\ud130 \ud074\ub798\uc2a4\ub294 \ud314\ub77c\ub518\uc785\ub2c8\ub2e4. \"\ubc29\ud328 \uac15\ud0c0\"\uc640 \uac19\uc740 \ubc29\uc5b4 \ub2a5\ub825\uacfc \"\uc2e0\uc131\ud55c \uc77c\uaca9\"\uacfc \uac19\uc740 \uacf5\uaca9 \ub2a5\ub825\uc744 \uac16\ucd98 \ud314\ub77c\ub518\uc740 \ub2e4\uc591\ud55c \uc804\ud22c \uc0c1\ud669\uc5d0 \uc801\uc751\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub358\uc804 \ub808\uc774\ub4dc \uc0c1\ud669\uc5d0\uc11c \ud314\ub77c\ub518\uc740 \uc801\uc5d0\uac8c \uc0c1\ub2f9\ud55c \ud53c\ud574\ub97c \uc785\ud788\uba74\uc11c \ub3d9\uc2dc\uc5d0 \ud53c\ud574\ub97c \ud761\uc218\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc5ec\ub7ec \uc635\uc158 \ube44\uad50: \ud314\ub77c\ub518\uc744 \uae30\uc0ac\uc640 \ub9c8\ubc95\uc0ac \ud074\ub798\uc2a4\uc640 \ube44\uad50\ud558\uc5ec \ud314\ub77c\ub518\uc758 \ub2e4\uc7ac\ub2e4\ub2a5\ud568\uc744 \uac15\uc870\ud558\uc138\uc694.]"}, {"question": "\ud50c\ub799\uc158\uc2a4\uc758 \ub808\ubca8\ub9c1 \uc2dc\uc2a4\ud15c\uc740 \uac8c\uc784 \uc9c4\ud589\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ud50c\ub799\uc158\uc2a4\uc758 \ub808\ubca8\ub9c1 \uc2dc\uc2a4\ud15c\uc740 \uc0c8\ub85c\uc6b4 \ub2a5\ub825\uc744 \ud574\uc81c\ud558\uace0 \uce90\ub9ad\ud130\uc758 \uc2a4\ud15f\uc744 \uc99d\uac00\uc2dc\ucf1c \uac8c\uc784 \uc9c4\ud589\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 10\uc5d0 \ub3c4\ub2ec\ud558\uba74 \"\ub354\ube14 \uc810\ud504\" \ub2a5\ub825\uc774 \ud574\uc81c\ub418\uc5b4 \uc774\uc804\uc5d0\ub294 \uc811\uadfc\ud560 \uc218 \uc5c6\uc5c8\ub358 \uc9c0\uc5ed\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ub808\ubca8\uc5c5\uc740 \uc0ac\ub2e4\ub9ac\ub97c \uc624\ub974\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uac01 \ub2e8\uacc4\ub97c \uac70\uce58\uba74 \uc0c8\ub85c\uc6b4 \ub192\uc774\uc640 \ub3c4\uc804\uc5d0 \ub2e4\uac00\uac11\ub2c8\ub2e4.]"}, {"question": "\ud50c\ub799\uc158\uc2a4\uc758 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud50c\ub799\uc158\uc2a4\uc758 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ucd08\uc810\uacfc \uc0c1\ud638 \uc791\uc6a9\uc785\ub2c8\ub2e4. \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \uc2a4\ud1a0\ub9ac\uc640 \ud0d0\ud5d8\uc5d0 \uc9d1\uc911\ud558\ub294 \ubc18\uba74, \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \ud611\ub3d9\uacfc \uacbd\uc7c1\uc801\uc778 \ud50c\ub808\uc774\uc5d0 \ucd08\uc810\uc744 \ub9de\ucda5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uce5c\uad6c\ub4e4\uacfc \ud300\uc744 \uc774\ub8e8\uc5b4 \uc5b4\ub824\uc6b4 \ub808\uc774\ub4dc\ub97c \uacf5\ub7b5\ud558\uac70\ub098 PvP \uc544\ub808\ub098\uc5d0\uc11c \uacbd\uc7c1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc5ec\ub7ec \uc635\uc158 \ube44\uad50: \uac01 \ubaa8\ub4dc\uc758 \ubcf4\uc0c1\uacfc \ub3c4\uc804\uc744 \ube44\uad50\ud558\uc5ec \ud50c\ub808\uc774\uc5b4\ub4e4\uc774 \uc5b4\ub290 \ubaa8\ub4dc\uc5d0 \uc9d1\uc911\ud560\uc9c0 \uacb0\uc815\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4.]"}, {"question": "\ud50c\ub799\uc158\uc2a4\uc5d0\uc11c \ud50c\ub7ab\ud3fc\uc744 \uc804\ud658\ud560 \ub54c \ub370\uc774\ud130 \uc774\uc804\uc744 \uc6d0\ud65c\ud558\uac8c \ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\ud50c\ub799\uc158\uc2a4\uc5d0\uc11c \ud50c\ub7ab\ud3fc\uc744 \uc804\ud658\ud560 \ub54c \ub370\uc774\ud130 \uc774\uc804\uc744 \uc6d0\ud65c\ud558\uac8c \ud558\ub824\uba74 \uba3c\uc800 \uac8c\uc784 \uacc4\uc815\uc744 Steam\uc774\ub098 \uc5d0\ud53d\uac8c\uc784\uc988\uc640 \uac19\uc740 \uc720\ub2c8\ubc84\uc124 \ud50c\ub7ab\ud3fc\uc5d0 \uc5f0\uacb0\ud558\uc138\uc694. \ub2e4\uc74c\uc73c\ub85c \uac8c\uc784 \ub370\uc774\ud130\uac00 \ud074\ub77c\uc6b0\ub4dc\uc5d0 \ub3d9\uae30\ud654\ub418\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \ub9c8\uc9c0\ub9c9\uc73c\ub85c \uc0c8 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uc5ec \uc800\uc7a5\ub41c \ub370\uc774\ud130\uc5d0 \uc811\uadfc\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ucf58\uc194\ub85c \uc774\uc804\ud558\ub294 \uac83\uc740 \ucf58\uc194 \ubc84\uc804\uc758 \uc5f0\uacb0\ub41c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\ub294 \uac83\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \uc11c\ub85c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0 \ub300\ud55c \ub2e8\uacc4\ub97c \ube44\uad50\ud558\uc5ec \uba85\ud655\uc131\uc744 \ub192\uc774\uc138\uc694.]"}, {"question": "\ud50c\ub799\uc158\uc2a4\uc5d0\uc11c \uc5b4\ub5a4 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \ubc1c\uacac\ud560 \uc218 \uc788\uc73c\uba70, \uc774\ub294 \uac8c\uc784\uc744 \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0a4\ub098\uc694?", "answer": "\ud50c\ub799\uc158\uc2a4\uc758 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20(\ube44\ubc00 \ub358\uc804 \ubc0f \ud76c\uadc0 \uc544\uc774\ud15c \ub4f1)\ub294 \ucd94\uac00\uc801\uc778 \ub3c4\uc804\uacfc \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud558\uc5ec \uac8c\uc784\uc744 \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc783\uc5b4\ubc84\ub9b0 \uc0ac\uc6d0\" \ub358\uc804\uc744 \ubc1c\uacac\ud558\uba74 \ub3c5\ud2b9\ud55c \ubcf4\ubb3c\ubfd0\ub9cc \uc544\ub2c8\ub77c \uac8c\uc784\uc758 \ubc30\uacbd \uc774\uc57c\uae30\ub97c \ub354\uc6b1 \uae4a\uc774 \uc788\uac8c \ub9cc\ub4ed\ub2c8\ub2e4. [\uc228\uaca8\uc9c4 \uc694\uc18c \ubc1c\uad74: \ubaa8\ub4e0 \uad6c\uc11d\uad6c\uc11d\uc744 \ud0d0\ud5d8\ud558\uc138\uc694. \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub294 \uc885\uc885 \ub0a0\uce74\ub85c\uc6b4 \uad00\ucc30\ub825\uacfc \ud37c\uc990 \ud480\uc774 \ub2a5\ub825\uc774 \ud544\uc694\ud558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4.]"}, {"question": "\ud50c\ub799\uc158\uc2a4\uc758 \uc2a4\ud0ac \ud2b8\ub9ac\ub294 \uce90\ub9ad\ud130 \uac1c\ubc1c\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ud50c\ub799\uc158\uc2a4\uc758 \uc2a4\ud0ac \ud2b8\ub9ac\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uc790\uc2e0\uc758 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\ucdb0 \ub2a5\ub825\uc744 \ucee4\uc2a4\ud130\ub9c8\uc774\uc9d5\ud560 \uc218 \uc788\ub3c4\ub85d \ud558\uc5ec \uce90\ub9ad\ud130 \uac1c\ubc1c\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc740\uc2e0\" \ubd84\uc57c\uc5d0 \ud22c\uc790\ud558\uba74 \ubab0\ub798 \uc774\ub3d9 \ubc0f \uc554\uc0b4 \uc2a4\ud0ac\uc774 \uac15\ud654\ub418\uace0, \"\uc804\ud22c\" \ubd84\uc57c\uc5d0 \ud22c\uc790\ud558\uba74 \uc9c1\uc811\uc801\uc778 \ub300\uacb0 \ub2a5\ub825\uc774 \ud5a5\uc0c1\ub429\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uba3c\uc800 \uc8fc\uc694 \uc2a4\ud0ac \ubd84\uc57c\ub97c \uc120\ud0dd\ud558\uace0, \ub808\ubca8\uc5c5\ud560 \ub54c \ud2b9\uc815 \ub2a5\ub825\uc5d0 \uc810\uc218\ub97c \ubc30\ubd84\ud558\uc138\uc694.]"}, {"question": "\ud50c\ub799\uc158\uc2a4\uc5d0\uc11c \uc790\uc6d0\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\uc5ec \ud6a8\uc728\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud55c \ucd5c\uc120\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud50c\ub799\uc158\uc2a4\uc5d0\uc11c \uc790\uc6d0\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub824\uba74 \uad11\ubb3c\uacfc \uc57d\ucd08\uc640 \uac19\uc740 \ud544\uc218 \uc7ac\ub8cc\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \uc218\uc9d1\ud558\uc138\uc694. \uc790\uc6d0 \uad00\ub9ac \ub3c4\uad6c\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc7ac\uace0\ub97c \ucd94\uc801\ud558\uace0 \uc81c\uc791 \ud544\uc694\ud488\uc744 \uacc4\ud68d\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud018\uc2a4\ud2b8\ub97c \uc2dc\uc791\ud558\uae30 \uc804\uc5d0 \ud544\uc694\ud55c \ud68c\ubcf5\uc57d\uc774\ub098 \uc218\ub9ac \ud0a4\ud2b8\uac00 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. [\uc5ec\ub7ec \uc635\uc158 \ube44\uad50: \ub2e4\uc591\ud55c \uc790\uc6d0 \uad00\ub9ac \uc804\ub7b5\uc744 \ube44\uad50\ud558\uc5ec \uc790\uc2e0\uc5d0\uac8c \uac00\uc7a5 \uc801\ud569\ud55c \uc804\ub7b5\uc744 \ucc3e\uc73c\uc138\uc694.]"}]
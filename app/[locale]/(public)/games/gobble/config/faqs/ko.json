[{"question": "Gobble \uc785\ubb38: Gobble\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ube68\ub9ac \uac8c\uc784\uc744 \ubc30\uc6b8 \uc218 \uc788\ub098\uc694?", "answer": "Gobble\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc740 \uc8fc\ub85c \uc774\ub3d9\uacfc \ud761\uc785\uc785\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc73c\ub85c \uc774\ub3d9\uc740 \ud0a4\ubcf4\ub4dc\uc758 WASD \ud0a4\ub098 \ucee8\ud2b8\ub864\ub7ec\uc758 \uc870\uc774\uc2a4\ud2f1\uc73c\ub85c \ucc98\ub9ac\ub429\ub2c8\ub2e4. \ud761\uc785\ud558\ub824\uba74 \uc885\uc885 \uc2a4\ud398\uc774\uc2a4\ubc14 \ub610\ub294 \uc9c0\uc815\ub41c \ubc84\ud2bc\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ube60\ub974\uac8c \ubc30\uc6b0\ub824\uba74 \ud29c\ud1a0\ub9ac\uc5bc \ubaa8\ub4dc\ub85c \uc2dc\uc791\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ud29c\ud1a0\ub9ac\uc5bc\uc5d0\uc11c\ub294 'W' \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc804\uc9c4\ud558\uace0 '\uc2a4\ud398\uc774\uc2a4\ubc14'\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc791\uc740 \ubb3c\uccb4\ub97c \uba39\ub294 \ubc95\uc744 \ubc30\uc6c1\ub2c8\ub2e4. \ud5a5\ud6c4 \ub354 \ub192\uc740 \uc218\uc900\uc73c\ub85c \uc9c4\ud589\ud558\uace0 \ub354 \uace0\uae09 \uae30\uc220\uc744 \ub9c8\uc2a4\ud130\ud558\uae30 \uc804\uc5d0 \ucd08\uae30 \ub808\ubca8\uc5d0\uc11c \uc774\ub7ec\ud55c \uc6c0\uc9c1\uc784\uc744 \uc5f0\uc2b5\ud558\uc5ec \uac8c\uc784\uc5d0 \ub300\ud55c \uac10\uac01\uc744 \uc5bb\uc73c\uc138\uc694."}, {"question": "\uc65c \ub0b4 \uace0\ube14\ub7ec\uac00 \uacc4\uc18d \uac07\ud788\ub294 \uac78\uae4c\uc694? Gobble \uac8c\uc784\uc774 \uc9c0\ub8e8\ud574\uc9c8 \ub54c \uc5b4\ub5bb\uac8c \ud574\uc57c \ud558\ub098\uc694?", "answer": "\uace0\ube14\ub7ec\uac00 \ud658\uacbd\uc774\ub098 \ub2e4\ub978 \ub354 \ud070 \uace0\ube14\ub7ec\uc640 \ucda9\ub3cc\ub85c \uc778\ud574 \uac07\ud788\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc2b5\ub2c8\ub2e4. \uc774\ub7f0 \uc77c\uc774 \ubc1c\uc0dd\ud558\uba74 \ub2e4\uc74c\uacfc \uac19\uc740 \ubc29\ubc95\uc744 \uc2dc\ub3c4\ud574 \ubcf4\uc138\uc694: 1) \uace0\ube14\ub7ec\uac00 \uc790\uc720\ub85c\uc6cc\uc9c8 \uc218 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uae30 \uc704\ud574 \uc791\uc740 \ubc29\ud5a5 \uc870\uc815\uc744 \uc2dc\ub3c4\ud569\ub2c8\ub2e4. 2) \uadf8\ub807\uc9c0 \uc54a\ub2e4\uba74 \ub300\uc548\uc801\uc778 \uacbd\ub85c\ub97c \ud0d0\uc0c9\ud569\ub2c8\ub2e4. 3) \ub9c8\uc9c0\ub9c9 \uc218\ub2e8\uc73c\ub85c \ub9c8\uc9c0\ub9c9 \uccb4\ud06c\ud3ec\uc778\ud2b8\uc5d0\uc11c \ub808\ubca8\uc744 \ub2e4\uc2dc \uc2dc\uc791\ud569\ub2c8\ub2e4. \ucd08\uae30 \uc232 \uc9c0\uc5ed\uc5d0\uc11c \ub450 \uac1c\uc758 \ud070 \ubc14\uc704 \uc0ac\uc774\uc5d0 \uac07\ud788\ub294 \uacbd\uc6b0\uac00 \uc77c\ubc18\uc801\uc785\ub2c8\ub2e4. \uac15\uc81c\ub85c \uc55e\uc73c\ub85c \ub098\uc544\uac00\ub294 \ub300\uc2e0 (\uc544\ub9c8\ub3c4 \ub9c9\ud600 \uc788\uc744 \uac00\ub2a5\uc131\uc774 \ub192\uc74c) \uc67c\ucabd\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec \uc5f4\ub9b0 \uacbd\ub85c\ub97c \ucc3e\uc73c\uc138\uc694."}, {"question": "Gobble \ud06c\uae30 \uc911\uc694: \uace0\ube14\ub7ec\uc758 \ud06c\uae30\ub97c \ud0a4\uc6b0\uba74 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\uba70, \uc804\ub7b5\uc801 \uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uace0\ube14\ub7ec\uc758 \ud06c\uae30\ub97c \ud0a4\uc6b0\uba74 \uac8c\uc784 \ud50c\ub808\uc774\uac00 \ud06c\uac8c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4. \ub354 \ud070 \uace0\ube14\ub7ec\ub294 \ub354 \ud070 \ubb3c\uccb4\ub97c \uc18c\ube44\ud558\uace0 \uc9c0\ud615\uc744 \ub354 \uc218\uc6d4\ud558\uac8c \uc774\ub3d9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4! \uc804\ub7b5\uc801 \uc774\uc810\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: 1) \ud06c\uae30 \uc81c\ud55c\uc73c\ub85c \uc778\ud574 \uc774\uc804\uc5d0 \uc811\uadfc\ud560 \uc218 \uc5c6\uc5c8\ub358 \uc0c8\ub85c\uc6b4 \uc9c0\uc5ed\uc5d0 \uc811\uadfc\ud569\ub2c8\ub2e4. 2) \ub354 \uc791\uc740 \uc0c1\ub300\ub97c \uc704\ud611\ud558\uace0 \uc7a0\uc7ac\uc801\uc73c\ub85c \ud761\uc218\ud569\ub2c8\ub2e4. 3) \ub354 \ud070 \ubb3c\uccb4\ub97c \uc18c\ube44\ud558\uc5ec \uc810\uc218 \ubc30\uc218\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc791\uc740 \uace0\ube14\ub7ec\ub294 \ud070 \ubc84\uc12f\uc744 \uba39\ub294 \ub370 \uc5b4\ub824\uc6c0\uc744 \uacaa\uc744 \uc218 \uc788\uc9c0\ub9cc, \uc644\uc804\ud788 \uc790\ub780 \uace0\ube14\ub7ec\ub294 \ud55c \uc785\uc5d0 \uba39\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub294 \uc0c1\ub2f9\ud55c \uc810\uc218 \uc99d\uac00\ub97c \uac00\uc838\uc635\ub2c8\ub2e4!"}, {"question": "\uace0\uae09 \ud761\uc785 \uae30\ubc95: \uccb4\uc778 \ud761\uc785\uc740 \uc5b4\ub5bb\uac8c \uc218\ud589\ud560 \uc218 \uc788\uc73c\uba70, \uc774 \ud761\uc785 \uae30\uc220\uc744 \ub9c8\uc2a4\ud130\ud558\ub294 \ub370\ub294 \uc5b4\ub5a4 \uc774\uc810\uc774 \uc788\ub098\uc694?", "answer": "\uccb4\uc778 \ud761\uc785\uc744 \ud1b5\ud574 \uc5f0\uc18d\uc801\uc73c\ub85c \uc5ec\ub7ec \uac1c\uc758 \ubb3c\uccb4\ub97c \ud761\uc785\ud558\uc5ec \uc810\uc218 \ubc0f \ud6a8\uc728\uc131\uc744 \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \uac00\uae4c\uc6b4 \uc704\uce58\uc5d0 \uc788\ub294 \uc791\uc740 \ubb3c\uccb4\uc758 \uc21c\uc11c\ub97c \ud30c\uc545\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ube60\ub978 \uc18d\ub3c4\ub85c \uc5f0\uc18d\ud574\uc11c \uc18c\ube44\ud558\uc5ec \uc804\uc9c4 \uc6b4\ub3d9\uc744 \uc720\uc9c0\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ud761\uc785 \uac04\uc758 \ud2c8\uc0c8\ub97c \ud53c\ud558\uae30 \uc704\ud574 \ud761\uc785 \ud0c0\uc774\ubc0d\uc744 \uc5f0\uc2b5\ud569\ub2c8\ub2e4. \uc774\ub97c \uc5f0\uc2b5\ud558\uae30\uc5d0 \uc88b\uc740 \uc7a5\uc18c\ub294 \ucd08\uae30 \uac8c\uc784 \ub2e8\uacc4\uc5d0\uc11c \ucf64\ubcf4 \uc810\uc218\ub97c \uc5bb\uace0 \ub808\ubca8\uc5c5\uc744 \ub9e4\uc6b0 \ube60\ub974\uac8c \ud560 \uc218 \uc788\ub294 \uc5f4\ub9e4\uac00 \uc904\uc9c0\uc5b4 \uc788\ub294 \uac1c\ud65c\uc9c0 \uc9c0\uc5ed\uc785\ub2c8\ub2e4."}, {"question": "Gobble \ucd5c\uc801\ud654: \uc18d\ub3c4 \ub2ec\uc131\uc5d0 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \uace0\ube14\ub7ec \ube4c\ub4dc\ub294 \ubb34\uc5c7\uc774\uba70, \uc65c \ucd5c\uace0 \uc218\uc900\uc73c\ub85c \uac04\uc8fc\ub418\ub098\uc694?", "answer": "Gobble\uc758 \uc18d\ub3c4 \ub2ec\uc131\uc744 \uc704\ud574\uc11c\ub294 \uc18d\ub3c4\uc640 \ud6a8\uc728\uc801\uc778 \uc18c\ube44\uc5d0 \uc6b0\uc120\uc21c\uc704\ub97c \ub454 \ube4c\ub4dc\uac00 \uc911\uc694\ud569\ub2c8\ub2e4. \ucd5c\uc0c1\uc704 \ube4c\ub4dc\ub294 \uc77c\ubc18\uc801\uc73c\ub85c \uc774\ub3d9 \uc18d\ub3c4\ub97c \uadf9\ub300\ud654\ud558\uace0 \uc18c\ud654 \uc2dc\uac04\uc744 \ucd5c\uc18c\ud654\ud558\ub294 \ub370 \uc911\uc810\uc744 \ub461\ub2c8\ub2e4. [\uad6c\uc131\ud45c:] A) '\ud0d0\uc2dd\uac00' \ube4c\ub4dc: \uc21c\uc218\ud55c \uc591\uacfc \ud06c\uae30\ub97c \uc720\uc9c0\ud558\ub294 \ub2a5\ub825\uc5d0 \uc911\uc810\uc744 \ub461\ub2c8\ub2e4. B) '\ub0a0\uc318\uc774'\ub294 \ud3ed\ubc1c\uc801\uc778 \uacf5\uaca9\ub825\uc744 \uac00\uc9c4 \ube4c\ub4dc\uc785\ub2c8\ub2e4. C) \ud558\uc774\ube0c\ub9ac\ub4dc \ube4c\ub4dc\ub294 \uc77c\ubd80 \ud6a8\uc728 \ud1b5\uacc4\ub97c \uad50\ud658\ud558\uc5ec \uae30\ub3d9\uc131\uc744 \uac1c\uc120\ud569\ub2c8\ub2e4. \ucd5c\uc0c1\uc704\ub294 \uc77c\ubc18\uc801\uc73c\ub85c '\ub0a0\uc318\uc774' \ube4c\ub4dc\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc65c\ub0d0\ud558\uba74 \uc18d\ub3c4 \ub2ec\uc131\uc5d0\uc11c\ub294 \uccb4\ub825 \uc190\uc0c1\uc774 \uc911\uc694\ud558\uc9c0 \uc54a\uae30 \ub54c\ubb38\uc5d0 \ud6a8\uc728\uc774 \ud6e8\uc52c \ub354 \uc911\uc694\ud558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc774\ub294 \uc77c\ubc18\uc801\uc73c\ub85c \uc77c\uc2dc\uc801\uc778 \ubc84\ud504\ub85c \ud5a5\uc0c1\ub429\ub2c8\ub2e4."}, {"question": "Gobble \uc810\uc218 \ubc30\uc218\ub294 \ubb34\uc5c7\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc73c\uba70, \uc774\ub97c \uadf9\ub300\ud654\ud558\uba74 \uac8c\uc784 \uc810\uc218\ub97c \ub192\uc774\ub294 \ub370 \uc5b4\ub5bb\uac8c \ub3c4\uc6c0\uc774 \ub418\ub098\uc694?", "answer": "Gobble \uc810\uc218 \ubc30\uc218\ub294 \uc5ec\ub7ec \uc694\uc778\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9c0\uba70, \uc8fc\ub85c \uace0\ube14\ub7ec\uc640 \ud761\uc785\ud558\ub294 \ubb3c\uccb4\uc758 \ud06c\uae30 \ucc28\uc774\uc640 \ud604\uc7ac \ucf64\ubcf4\uc785\ub2c8\ub2e4. \ud6a8\uc728\uc744 \uadf9\ub300\ud654\ud560 \ub54c \uace0\ub824\ud574\uc57c \ud560 \uc694\uc18c\ub4e4\uc744 \ube44\uad50\ud574 \ubd05\ub2c8\ub2e4. \uc791\uc740 \uc801\uc740 \ub0ae\uc740 \uc810\uc218\ub97c \uc8fc\uace0 \uac8c\uc774\uc9c0\ub97c \ud56d\uc0c1 \ucc44\uc6cc\ub450\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud56d\uc0c1 \uc9c4\ud589 \uc911\uc778 \uccb4\uc778\uc744 \uc720\uc9c0\ud558\uba74\uc11c \uace0\ube14\ub7ec\ubcf4\ub2e4 \uc57d\uac04 \ud070 \ubb3c\uccb4\ub97c \uc9c0\uc18d\uc801\uc73c\ub85c \ud761\uc785\ud558\ub294 \uac83\uc740 \ub2e8\uc21c\ud788 \uac00\ub2a5\ud55c \uac00\uc7a5 \ud070 \ubb3c\uccb4\ub97c \uac00\ub2a5\ud55c \ud55c \uc790\uc8fc \uba39\ub294 \uac83\ubcf4\ub2e4 \ub192\uc740 \uc810\uc218 \ubc30\uc218\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub192\uc740 \uc810\uc218\ub294 \ub610\ud55c \uc678\uad00\uc0c1 \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Gobble \uc228\uaca8\uc9c4 \ud1b5\uacc4: Gobble\uc758 \uc18c\ud654 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5bc\ub9c8\ub098 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "Gobble\uc758 \uc18c\ud654 \uc2dc\uc2a4\ud15c\uc740 \uc228\uaca8\uc9c4 \ud1b5\uacc4\ub85c, \uace0\ube14\ub7ec\uac00 \uc18c\ube44\ud55c \ubb3c\uccb4\ub97c \uc5bc\ub9c8\ub098 \ube68\ub9ac \ucc98\ub9ac\ud558\ub294\uc9c0\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc18c\ud654 \uc18d\ub3c4\ub294 \ucd94\uac00 \ud56d\ubaa9\uc744 \uc5bc\ub9c8\ub098 \ube60\ub974\uac8c \uc18c\ube44\ud558\uace0 \ucf64\ubcf4 \uac8c\uc774\uc9c0\ub97c \uc720\uc9c0\ud560 \uc218 \uc788\ub294\uc9c0 \uacb0\uc815\ud569\ub2c8\ub2e4. \ub354 \ube60\ub978 \uc18c\ud654 \uc2dc\uc2a4\ud15c\uc740 \ub354 \ube60\ub978 \uccb4\uc778 \ud761\uc785\uacfc \ub354 \ub192\uc740 \ucd1d \uc810\uc218\ub97c \ud5c8\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ucca0\uc7a5' \uc544\uc774\ud15c\uc744 \uc7a5\ucc29\ud588\ub2e4\uba74 \uace0\ube14\ub7ec\uc758 \uc18d\ub3c4\uc640 \ubbfc\ucca9\uc131\uc744 \ub2a6\ucd94\uc9c0 \uc54a\uace0 \uc9c0\uc18d\uc801\uc73c\ub85c \uba39\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub294 \ud761\uc785 \uc804\ud22c\uc5d0\uc11c \uc6b0\uc704\ub97c \uc810\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc801 \uc720\ud615\uacfc \ud574\ub2f9 EXP \uac12 \uac04\uc758 \uc0c1\uad00 \uad00\uacc4\ub294 \ubb34\uc5c7\uc774\uba70, Gobble\uc5d0\uc11c EXP \ub18d\uc7a5\uc744 \uc704\ud574 \uac00\uc7a5 \uc88b\uc740 \uc9c0\uc5ed\uc740 \uc5b4\ub514\uc778\uac00\uc694?", "answer": "Gobble\uc758 \uac01 \uc801 \uc720\ud615\uc740 \ud761\uc785 \uc2dc \uc11c\ub85c \ub2e4\ub978 \uc591\uc758 EXP(\uacbd\ud5d8\uce58)\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub354 \ud06c\uace0 \uc704\ud5d8\ud55c \uc801\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \ub354 \ub9ce\uc740 EXP\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ud6a8\uc728\uc801\uc778 EXP \ub18d\uc7a5\uc744 \uc704\ud574\uc11c\ub294 \uc774\ub7ec\ud55c \uc801\uc774 \ub9ce\uc774 \ubab0\ub824\uc788\ub294 \uc9c0\uc5ed\uc5d0 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc624\uc544\uc2dc\uc2a4 \uc9c0\uc5ed\uc5d0\uc11c \ub354 \ub192\uc740 \uc218\uc900\uc758 \ubaac\uc2a4\ud130\ub97c \uc0ac\ub0e5\ud558\uc5ec \uc2a4\ud15f\uacfc EXP\ub97c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc5ec\ub7ec \uae30\uae30\uc5d0\uc11c Gobble: \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \uc800\uc7a5 \ub3d9\uae30\ud654\ub294 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, PC\uc640 \ubaa8\ubc14\uc77c\uc5d0\uc11c \ub3d9\uc77c\ud55c \uace0\ube14\ub7ec \uacc4\uc815\uc744 \ud50c\ub808\uc774\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \uc800\uc7a5 \ub3d9\uae30\ud654\ub97c \ud1b5\ud574 \uc5ec\ub7ec \uae30\uae30\uc5d0\uc11c \ub3d9\uc77c\ud55c \uace0\ube14\ub7ec \uacc4\uc815\uc744 \ud50c\ub808\uc774\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc73c\ub85c \uac8c\uc784 \uacc4\uc815\uc744 \ud074\ub77c\uc6b0\ub4dc \uc11c\ube44\uc2a4\uc5d0 \uc5f0\uacb0\ud558\uc5ec \uc791\ub3d9\ud569\ub2c8\ub2e4. \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud558\ub824\uba74 PC\uc640 \ubaa8\ubc14\uc77c \uae30\uae30\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud574\uc57c \ud569\ub2c8\ub2e4. \uc544\ub798\ub294 \ube44\uad50\ud45c\uc785\ub2c8\ub2e4: (A) Steam \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5, (B) \ubaa8\ubc14\uc77c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5: \uc77c\ubd80 \ud50c\ub7ab\ud3fc\uc740 \uc790\ub3d9 \ub3d9\uae30\ud654\ub97c \uc9c0\uc6d0\ud558\uc9c0\ub9cc, \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c\ub294 \uc218\ub3d9 \uc800\uc7a5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. (C) \uc11c\ub85c \ub2e4\ub978 \ubc84\uc804\uc774 \uc788\ub294 \ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc \uac04\uc5d0\ub294 \ub370\uc774\ud130\uac00 \uacf5\uc720\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."}, {"question": "Gobble\uc5d0 \ube44\ubc00 \uc601\uc5ed\uc774\ub098 \uc228\uaca8\uc9c4 \uace0\ube14\ub7ec\uac00 \uc788\ub098\uc694? \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\ub098\uc694? Gobble \ube44\ubc00 \u2013 \ub354 \uc790\uc138\ud558\uac8c \uc54c\ub824\uc8fc\uc138\uc694!", "answer": "\ub124, \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \ube44\ubc00 \uc601\uc5ed\uacfc \uc228\uaca8\uc9c4 \uace0\ube14\ub7ec\uac00 \uc788\uc2b5\ub2c8\ub2e4! \uc774\ub7ec\ud55c \uc601\uc5ed\uc740 \uc885\uc885 \uc228\uaca8\uc9c4 \uae38\uc774\ub098 \ud2b9\uc815 \ud589\ub3d9\uc744 \ud1b5\ud574 \uc5f4\ub9bd\ub2c8\ub2e4. \uc88b\uc740 \uc608\ub294 '\ubb34\uc9c0\uac1c \ud1b5\ub85c'\uc785\ub2c8\ub2e4. '\ubb34\uc9c0\uac1c\uc0c9 \uacfc\uc77c'\uc744 \ucd5c\uc18c 5\uac1c \uba39\uc5b4\uc57c \ud3ec\ud0c8\uc744 \ud65c\uc131\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc601\uc5ed\uc744 \ucc3e\uc73c\ub824\uba74 \uc9c0\ub3c4\uc758 \ubaa8\ub4e0 \uad6c\uc11d\uad6c\uc11d\uc744 \ud0d0\ud5d8\ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \ud2b9\uc774\ud55c \ud328\ud134, \uc228\uaca8\uc9c4 \ud1b5\ub85c \ub610\ub294 \ud658\uacbd\uacfc\uc758 \uc0c1\ud638 \uc791\uc6a9\uacfc \uac19\uc740 \uc2dc\uac01\uc801 \ub2e8\uc11c\ub97c \uc8fc\uc758 \uae4a\uac8c \uc0b4\ud3b4\ubcf4\uc138\uc694."}]
[{"question": "Gobble\u5165\u95e8\uff1aGobble\u7684\u57fa\u672c\u63a7\u5236\u6709\u54ea\u4e9b\uff0c\u6211\u8be5\u5982\u4f55\u5feb\u901f\u5b66\u4e60\u6e38\u620f\uff1f", "answer": "\u5728Gobble\u4e2d\uff0c\u57fa\u672c\u63a7\u5236\u4e3b\u8981\u5305\u62ec\u79fb\u52a8\u548c\u541e\u566c\u3002\u901a\u5e38\uff0c\u79fb\u52a8\u53ef\u4ee5\u4f7f\u7528\u952e\u76d8\u4e0a\u7684WASD\u952e\u6216\u6e38\u620f\u624b\u67c4\u4e0a\u7684\u6447\u6746\u63a7\u5236\u3002\u541e\u566c\u901a\u5e38\u4f7f\u7528\u7a7a\u683c\u952e\u6216\u6307\u5b9a\u6309\u94ae\u3002\u5feb\u901f\u5b66\u4e60\u7684\u65b9\u6cd5\u662f\u4ece\u6559\u7a0b\u6a21\u5f0f\u5f00\u59cb\u3002\u4f8b\u5982\uff0c\u5728\u6559\u7a0b\u4e2d\uff0c\u60a8\u5c06\u5b66\u4e60\u5982\u4f55\u4f7f\u7528'W'\u952e\u5411\u524d\u79fb\u52a8\uff0c\u5e76\u4f7f\u7528'\u7a7a\u683c\u952e'\u541e\u566c\u8f83\u5c0f\u7684\u7269\u4f53\u3002\u5728\u521d\u59cb\u5173\u5361\u7ec3\u4e60\u8fd9\u4e9b\u64cd\u4f5c\uff0c\u5728\u638c\u63e1\u66f4\u9ad8\u7ea7\u6280\u5de7\u4e4b\u524d\uff0c\u5148\u611f\u53d7\u6e38\u620f\u7684\u8282\u594f\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u7684Gobbler\u4f1a\u5361\u4f4f\uff1f\u5f53Gobble\u6e38\u620f\u53d8\u5f97\u4ee4\u4eba\u6cae\u4e27\u65f6\uff0c\u6211\u5e94\u8be5\u600e\u4e48\u505a\uff1f", "answer": "\u60a8\u7684Gobbler\u53ef\u80fd\u7531\u4e8e\u4e0e\u73af\u5883\u6216\u5176\u4ed6\u8f83\u5927Gobbler\u7684\u78b0\u649e\u800c\u5361\u4f4f\u3002\u53d1\u751f\u8fd9\u79cd\u60c5\u51b5\u65f6\uff0c\u8bf7\u5c1d\u8bd5\u4ee5\u4e0b\u65b9\u6cd5\uff1a1\uff09\u5c1d\u8bd5\u5fae\u8c03\u65b9\u5411\uff0c\u770b\u770bGobbler\u662f\u5426\u53ef\u4ee5\u81ea\u884c\u8131\u56f0\u30022\uff09\u5982\u679c\u65e0\u6548\uff0c\u8bf7\u63a2\u7d22\u66ff\u4ee3\u8def\u7ebf\u30023\uff09\u6700\u540e\uff0c\u53ef\u4ee5\u8003\u8651\u4ece\u4e0a\u6b21\u68c0\u67e5\u70b9\u91cd\u65b0\u5f00\u59cb\u5173\u5361\u3002\u4e00\u4e2a\u5e38\u89c1\u7684\u573a\u666f\u662f\u5728\u65e9\u671f\u68ee\u6797\u533a\u57df\u88ab\u4e24\u5757\u5927\u77f3\u5934\u5939\u4f4f\u3002\u4e0e\u5176\u5f3a\u884c\u524d\u8fdb\uff08\u5f88\u53ef\u80fd\u88ab\u5835\u4f4f\uff09\uff0c\u4e0d\u5982\u5c1d\u8bd5\u5411\u5de6\u79fb\u52a8\uff0c\u627e\u5230\u4e00\u4e2a\u7f3a\u53e3\u3002"}, {"question": "Gobble\u5927\u5c0f\u91cd\u8981\uff1a\u6211\u7684Gobbler\u4f53\u578b\u53d8\u5927\u5982\u4f55\u5f71\u54cd\u6e38\u620f\uff0c\u4ee5\u53ca\u6218\u7565\u4f18\u52bf\u662f\u4ec0\u4e48\uff1f", "answer": "\u589e\u52a0\u60a8\u7684Gobbler\u4f53\u578b\u4f1a\u663e\u8457\u6539\u53d8\u6e38\u620f\u3002\u4f53\u578b\u66f4\u5927\u7684Gobbler\u53ef\u4ee5\u541e\u566c\u66f4\u5927\u7684\u7269\u4f53\uff0c\u5e76\u66f4\u8f7b\u677e\u5730\u7a7f\u68ad\u5728\u5730\u5f62\u4e2d\uff01\u6218\u7565\u4f18\u52bf\u5305\u62ec\uff1a1\uff09\u8bbf\u95ee\u4ee5\u524d\u7531\u4e8e\u5c3a\u5bf8\u9650\u5236\u65e0\u6cd5\u5230\u8fbe\u7684\u65b0\u533a\u57df\u30022\uff09\u6050\u5413\u5e76\u53ef\u80fd\u541e\u566c\u8f83\u5c0f\u7684\u5bf9\u624b\u30023\uff09\u541e\u566c\u8f83\u5927\u7269\u4f53\u83b7\u5f97\u5206\u6570\u500d\u6570\u3002\u4f8b\u5982\uff0c\u4e00\u4e2a\u5c0fGobbler\u53ef\u80fd\u96be\u4ee5\u5403\u6389\u4e00\u4e2a\u5927\u8611\u83c7\uff0c\u4f46\u662f\u4e00\u4e2a\u5b8c\u5168\u957f\u5927\u7684Gobbler\u53ef\u4ee5\u5728\u4e00\u53e3\u541e\u6389\u5b83\uff0c\u83b7\u5f97\u5927\u91cf\u7684\u5206\u6570\uff01"}, {"question": "\u9ad8\u7ea7\u541e\u566c\u6280\u5de7\uff1a\u6211\u5982\u4f55\u6267\u884c\u8fde\u73af\u541e\u566c\uff0c\u4ee5\u53ca\u638c\u63e1\u8fd9\u9879\u6280\u80fd\u7684\u597d\u5904\u662f\u4ec0\u4e48\uff1f", "answer": "\u8fde\u73af\u541e\u566c\u8ba9\u60a8\u5feb\u901f\u8fde\u7eed\u541e\u566c\u591a\u4e2a\u7269\u4f53\uff0c\u63d0\u5347\u60a8\u7684\u5206\u6570\u548c\u6548\u7387\u3002\u6b65\u9aa41\uff1a\u8bc6\u522b\u9644\u8fd1\u7d27\u6328\u7740\u7684\u51e0\u4e2a\u8f83\u5c0f\u7269\u4f53\u3002\u6b65\u9aa42\uff1a\u5feb\u901f\u8fde\u7eed\u541e\u566c\u5b83\u4eec\uff0c\u4fdd\u6301\u524d\u8fdb\u7684\u52bf\u5934\u3002\u6b65\u9aa43\uff1a\u7ec3\u4e60\u63a7\u5236\u541e\u566c\u65f6\u95f4\uff0c\u907f\u514d\u541e\u566c\u95f4\u9699\u3002\u5728\u5f00\u9614\u7684\u7530\u91ce\u533a\u57df\u7ec3\u4e60\u6b64\u6280\u5de7\u662f\u4e2a\u4e0d\u9519\u7684\u9009\u62e9\uff0c\u90a3\u91cc\u7ecf\u5e38\u6709\u60a8\u53ef\u4ee5\u5728\u6e38\u620f\u65e9\u671f\u9636\u6bb5\u5feb\u901f\u8fde\u541e\u5e76\u83b7\u5f97\u7ec4\u5408\u5206\u6570\uff0c\u5feb\u901f\u5347\u7ea7\u7684\u6d46\u679c\u3002"}, {"question": "Gobble\u4f18\u5316\uff1a\u54ea\u4e9bGobbler\u6784\u5efa\u6700\u9002\u5408\u901f\u5ea6\u901a\u5173\uff0c\u4e3a\u4ec0\u4e48\u5b83\u4eec\u88ab\u8ba4\u4e3a\u662f\u9876\u7ea7\u6784\u5efa\uff1f", "answer": "\u5bf9\u4e8e\u901f\u5ea6\u901a\u5173Gobble\uff0c\u4f18\u5148\u8003\u8651\u901f\u5ea6\u548c\u9ad8\u6548\u541e\u566c\u7684\u6784\u5efa\u81f3\u5173\u91cd\u8981\u3002\u9876\u7ea7\u6784\u5efa\u901a\u5e38\u4e13\u6ce8\u4e8e\u6700\u5927\u5316\u79fb\u52a8\u901f\u5ea6\u548c\u6700\u5c0f\u5316\u6d88\u5316\u65f6\u95f4\u3002[\u914d\u7f6e\u8868\uff1a] A\uff09'\u8d2a\u5a6a\u8005'\u6784\u5efa\uff1a\u4e13\u6ce8\u4e8e\u7eaf\u7cb9\u7684\u4f53\u79ef\u4ee5\u53ca\u4fdd\u6301\u4f53\u578b\u7684\u80fd\u529b\u3002B\uff09'\u98de\u9556'\u6784\u5efa\uff1a\u91c7\u7528\u9ad8\u4f24\u5bb3\u8f93\u51fa\u3002C\uff09\u6df7\u5408\u6784\u5efa\u5728\u4e00\u5b9a\u7a0b\u5ea6\u4e0a\u727a\u7272\u90e8\u5206\u6548\u7387\u6765\u63d0\u9ad8\u673a\u52a8\u6027\u3002\u9876\u7ea7\u73a9\u5bb6\u901a\u5e38\u4f7f\u7528'\u98de\u9556'\u6784\u5efa\uff0c\u56e0\u4e3a\u5728\u901f\u5ea6\u901a\u5173\u4e2d\uff0c\u5bf9\u751f\u547d\u503c\u7684\u4f24\u5bb3\u5e76\u4e0d\u91cd\u8981\uff0c\u56e0\u6b64\u6548\u7387\u66f4\u4e3a\u91cd\u8981\u3002\u8fd9\u901a\u5e38\u7531\u4e34\u65f6\u589e\u76ca\u6765\u589e\u5f3a\u3002"}, {"question": "\u4ec0\u4e48\u56e0\u7d20\u4f1a\u5f71\u54cdGobble\u5206\u6570\u500d\u6570\uff0c\u5982\u4f55\u6700\u5927\u5316\u5b83\u6765\u83b7\u5f97\u66f4\u9ad8\u7684\u6e38\u620f\u5206\u6570\uff1f", "answer": "Gobble\u5206\u6570\u500d\u6570\u53d6\u51b3\u4e8e\u591a\u79cd\u56e0\u7d20\uff0c\u4e3b\u8981\u5305\u62ecGobbler\u4e0e\u88ab\u541e\u566c\u7269\u4f53\u4e4b\u95f4\u7684\u4f53\u578b\u5dee\u5f02\u53ca\u5f53\u524d\u7684\u8fde\u51fb\u6570\u3002\u5728\u5c1d\u8bd5\u6700\u5927\u5316\u6548\u7387\u65f6\uff0c\u8bf7\u8003\u8651\u4ee5\u4e0b\u56e0\u7d20\uff1a\u8f83\u5c0f\u7684\u654c\u4eba\u63d0\u4f9b\u7684\u5206\u6570\u8f83\u4f4e\uff0c\u4fdd\u6301\u8ba1\u5206\u5668\u59cb\u7ec8\u5145\u6ee1\u81f3\u5173\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u6301\u7eed\u541e\u566c\u6bd4\u60a8\u4f53\u578b\u7565\u5927\u7684\u7269\u4f53\u5e76\u4fdd\u6301\u8fde\u51fb\uff0c\u6bd4\u5c3d\u53ef\u80fd\u541e\u566c\u5c3d\u53ef\u80fd\u5927\u7684\u7269\u4f53\u5f97\u5206\u66f4\u9ad8\u3002\u66f4\u9ad8\u7684\u5206\u6570\u8fd8\u53ef\u4ee5\u63d0\u4f9b\u88c5\u9970\u5956\u52b1\u3002"}, {"question": "Gobble\u9690\u85cf\u5c5e\u6027\uff1aGobble\u7684\u6d88\u5316\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u5b83\u5bf9\u6e38\u620f\u6709\u4f55\u5f71\u54cd\uff1f", "answer": "Gobble\u7684\u6d88\u5316\u7cfb\u7edf\u662f\u4e00\u4e2a\u9690\u85cf\u5c5e\u6027\uff0c\u5b83\u4f1a\u5f71\u54cdGobbler\u5904\u7406\u6d88\u8017\u7684\u7269\u4f53\u7684\u901f\u5ea6\u3002\u6d88\u5316\u901f\u5ea6\u51b3\u5b9a\u4e86\u60a8\u53ef\u4ee5\u591a\u5feb\u5730\u541e\u566c\u9644\u52a0\u7269\u54c1\u5e76\u4fdd\u6301\u8fde\u51fb\u3002\u66f4\u5feb\u7684\u6d88\u5316\u7cfb\u7edf\u5141\u8bb8\u66f4\u5feb\u7684\u8fde\u73af\u541e\u566c\u548c\u66f4\u9ad8\u7684\u603b\u4f53\u5206\u6570\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u88c5\u5907\u4e86'\u94c1\u80c3'\u7269\u54c1\uff0c\u60a8\u5c31\u53ef\u4ee5\u8fde\u7eed\u541e\u566c\uff0c\u800c\u4e0d\u4f1a\u8ba9\u6d88\u5316\u51cf\u7f13Gobbler\u7684\u901f\u5ea6\u548c\u7075\u6d3b\u6027\u8fc7\u957f\uff0c\u4ece\u800c\u5728Gobble\u7684\u6df7\u6218\u4e2d\u5360\u636e\u4e0a\u98ce\u3002"}, {"question": "\u654c\u4eba\u7c7b\u578b\u4e0e\u5176\u76f8\u5e94\u7684\u7ecf\u9a8c\u503c\u4e4b\u95f4\u5728Gobble\u4e2d\u6709\u4ec0\u4e48\u5173\u8054\uff1f\u54ea\u4e9b\u533a\u57df\u6700\u9002\u5408\u7ecf\u9a8c\u503c\u83b7\u53d6\uff1f", "answer": "Gobble\u4e2d\u7684\u6bcf\u4e2a\u654c\u4eba\u7c7b\u578b\u5728\u541e\u566c\u540e\u90fd\u4f1a\u4ea7\u751f\u4e0d\u540c\u7684\u7ecf\u9a8c\u503c\uff08EXP\uff09\u3002\u4f53\u578b\u66f4\u5927\u3001\u66f4\u5371\u9669\u7684\u654c\u4eba\u901a\u5e38\u63d0\u4f9b\u7684\u7ecf\u9a8c\u503c\u66f4\u591a\u3002\u4e3a\u4e86\u6709\u6548\u5730\u83b7\u53d6\u7ecf\u9a8c\u503c\uff0c\u8bf7\u4e13\u6ce8\u4e8e\u654c\u4eba\u5bc6\u5ea6\u8f83\u9ad8\u7684\u533a\u57df\u3002\u4f8b\u5982\uff0c\u60a8\u53ef\u4ee5\u9009\u62e9\u5728\u6c99\u6f20\u4e2d\u72e9\u730e\u66f4\u9ad8\u7b49\u7ea7\u7684\u654c\u4eba\uff0c\u4ee5\u63d0\u5347\u60a8\u7684\u5c5e\u6027\u548c\u7ecf\u9a8c\u503c\u3002\u6700\u4f73\u533a\u57df\u662f\u7eff\u6d32\u5730\u70b9\u3002"}, {"question": "\u5728\u591a\u8bbe\u5907\u4e0a\u8fdb\u884cGobble\uff1a\u8de8\u5e73\u53f0\u5b58\u6863\u540c\u6b65\u662f\u5982\u4f55\u5de5\u4f5c\u7684\uff0c\u6211\u53ef\u4ee5\u5728PC\u548c\u79fb\u52a8\u8bbe\u5907\u4e0a\u4f7f\u7528\u540c\u4e00\u4e2aGobbler\u5e10\u6237\u73a9\u6e38\u620f\u5417\uff1f", "answer": "\u8de8\u5e73\u53f0\u5b58\u6863\u540c\u6b65\u5141\u8bb8\u60a8\u5728\u591a\u4e2a\u8bbe\u5907\u4e0a\u4f7f\u7528\u540c\u4e00\u4e2aGobbler\u5e10\u6237\u73a9\u6e38\u620f\u3002\u5b83\u901a\u5e38\u901a\u8fc7\u5c06\u60a8\u7684\u6e38\u620f\u5e10\u6237\u94fe\u63a5\u5230\u4e91\u670d\u52a1\u6765\u5b9e\u73b0\u3002\u8981\u540c\u6b65\u8fdb\u5ea6\uff0c\u8bf7\u786e\u4fdd\u60a8\u5728PC\u548c\u79fb\u52a8\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u540c\u4e00\u4e2a\u5e10\u6237\u3002\u4ee5\u4e0b\u662f\u6bd4\u8f83\uff1a (A) Steam\u4e91\u5b58\u6863\uff0c(B) \u79fb\u52a8\u4e91\u5b58\u6863\uff1a\u67d0\u4e9b\u5e73\u53f0\u652f\u6301\u81ea\u52a8\u540c\u6b65\uff0c\u800c\u53e6\u4e00\u4e9b\u5e73\u53f0\u5219\u9700\u8981\u624b\u52a8\u4fdd\u5b58\u3002 (C) \u6570\u636e\u4e0d\u4f1a\u5728\u4e0d\u540c\u7248\u672c\u53ef\u7528\u7684\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u5171\u4eab\u3002"}, {"question": "Gobble\u4e2d\u662f\u5426\u5b58\u5728\u4efb\u4f55\u79d8\u5bc6\u533a\u57df\u6216\u9690\u85cf\u7684Gobbler\uff0c\u6211\u8be5\u5982\u4f55\u627e\u5230\u5b83\u4eec\uff1fGobble\u7684\u79d8\u5bc6\u2014\u2014\u544a\u8bc9\u6211\u66f4\u591a\uff01", "answer": "\u662f\u7684\uff0c\u5b58\u5728\u79d8\u5bc6\u533a\u57df\u548c\u9690\u85cfGobbler\u4f9b\u60a8\u53d1\u73b0\uff01\u8fd9\u4e9b\u533a\u57df\u901a\u5e38\u4f4d\u4e8e\u504f\u50fb\u7684\u5730\u65b9\uff0c\u6216\u8005\u9700\u8981\u6267\u884c\u7279\u5b9a\u64cd\u4f5c\u624d\u80fd\u89e3\u9501\u3002\u4e00\u4e2a\u5f88\u597d\u7684\u4f8b\u5b50\u662f'\u5f69\u8679\u901a\u9053'\uff0c\u60a8\u9700\u8981\u541e\u566c\u81f3\u5c115\u4e2a'\u68f1\u955c\u6c34\u679c'\u624d\u80fd\u6fc0\u6d3b\u4f20\u9001\u95e8\u3002\u627e\u5230\u8fd9\u4e9b\u533a\u57df\u901a\u5e38\u9700\u8981\u63a2\u7d22\u5730\u56fe\u4e0a\u7684\u6bcf\u4e2a\u89d2\u843d\u3002\u5bc6\u5207\u7559\u610f\u8bf8\u5982\u4e0d\u540c\u5bfb\u5e38\u6a21\u5f0f\u3001\u9690\u85cf\u901a\u9053\u6216\u4e0e\u73af\u5883\u7684\u4e92\u52a8\u7b49\u89c6\u89c9\u7ebf\u7d22\u3002"}]
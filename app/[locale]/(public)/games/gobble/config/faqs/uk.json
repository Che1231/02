[{"question": "\u041f\u043e\u0447\u0430\u0442\u043e\u043a \u0433\u0440\u0438 Gobble: \u042f\u043a\u0456 \u043e\u0441\u043d\u043e\u0432\u043d\u0456 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0432 Gobble \u0456 \u044f\u043a \u0448\u0432\u0438\u0434\u043a\u043e \u043d\u0430\u0432\u0447\u0438\u0442\u0438\u0441\u044f \u0433\u0440\u0430\u0442\u0438?", "answer": "\u0423 Gobble \u043e\u0441\u043d\u043e\u0432\u043d\u0456 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u2013 \u0446\u0435 \u043f\u0435\u0440\u0435\u0432\u0430\u0436\u043d\u043e \u0440\u0443\u0445 \u0456 \u043f\u043e\u0433\u043b\u0438\u043d\u0430\u043d\u043d\u044f. \u0417\u0430\u0437\u0432\u0438\u0447\u0430\u0439, \u0440\u0443\u0445 \u0437\u0434\u0456\u0439\u0441\u043d\u044e\u0454\u0442\u044c\u0441\u044f \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u043a\u043b\u0430\u0432\u0456\u0448 WASD \u043d\u0430 \u043a\u043b\u0430\u0432\u0456\u0430\u0442\u0443\u0440\u0456 \u0430\u0431\u043e \u0434\u0436\u043e\u0439\u0441\u0442\u0438\u043a\u0430 \u043d\u0430 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0435\u0440\u0456. \u0429\u043e\u0431 \u043f\u043e\u0433\u043b\u0438\u043d\u0443\u0442\u0438, \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u044e\u0442\u044c \u043f\u0440\u043e\u0431\u0456\u043b \u0430\u0431\u043e \u043f\u0440\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u0443 \u043a\u043b\u0430\u0432\u0456\u0448\u0443. \u0429\u043e\u0431 \u0448\u0432\u0438\u0434\u043a\u043e \u043d\u0430\u0432\u0447\u0438\u0442\u0438\u0441\u044f, \u043f\u043e\u0447\u043d\u0456\u0442\u044c \u0437 \u043d\u0430\u0432\u0447\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0440\u0435\u0436\u0438\u043c\u0443. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0443 \u043d\u0430\u0432\u0447\u0430\u043d\u043d\u0456 \u0432\u0438 \u043d\u0430\u0432\u0447\u0438\u0442\u0435\u0441\u044f \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u043a\u043b\u0430\u0432\u0456\u0448\u0443 \u00abW\u00bb, \u0449\u043e\u0431 \u0440\u0443\u0445\u0430\u0442\u0438\u0441\u044f \u0432\u043f\u0435\u0440\u0435\u0434, \u0456 \u043a\u043b\u0430\u0432\u0456\u0448\u0443 \u00ab\u041f\u0440\u043e\u0431\u0456\u043b\u00bb, \u0449\u043e\u0431 \u043f\u043e\u0457\u0441\u0442\u0438 \u043c\u0435\u043d\u0448\u0456 \u043e\u0431'\u0454\u043a\u0442\u0438. \u041f\u0440\u0430\u043a\u0442\u0438\u043a\u0443\u0439\u0442\u0435 \u0446\u0456 \u0440\u0443\u0445\u0438 \u043d\u0430 \u043f\u043e\u0447\u0430\u0442\u043a\u043e\u0432\u0438\u0445 \u0440\u0456\u0432\u043d\u044f\u0445, \u0449\u043e\u0431 \u0432\u0456\u0434\u0447\u0443\u0442\u0438 \u0433\u0440\u0443, \u043f\u0435\u0440\u0448 \u043d\u0456\u0436 \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0438\u0442\u0438 \u0434\u043e \u0431\u0456\u043b\u044c\u0448 \u0441\u043a\u043b\u0430\u0434\u043d\u0438\u0445 \u0442\u0435\u0445\u043d\u0456\u043a \u043f\u0456\u0437\u043d\u0456\u0448\u0435."}, {"question": "\u0427\u043e\u043c\u0443 \u043c\u0456\u0439 Gobbler \u043f\u043e\u0441\u0442\u0456\u0439\u043d\u043e \u0437\u0430\u0441\u0442\u0440\u044f\u0454? \u0429\u043e \u0440\u043e\u0431\u0438\u0442\u0438, \u043a\u043e\u043b\u0438 \u0433\u0440\u0430 Gobble \u0441\u0442\u0430\u0454 \u043f\u0440\u0438\u043a\u0440\u043e\u044e?", "answer": "\u0412\u0430\u0448 Gobbler, \u0439\u043c\u043e\u0432\u0456\u0440\u043d\u043e, \u0437\u0430\u0441\u0442\u0440\u044f\u0454 \u0447\u0435\u0440\u0435\u0437 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0438 \u0437 \u043a\u043e\u043b\u0456\u0437\u0456\u0454\u044e \u0437 \u043e\u0442\u043e\u0447\u0435\u043d\u043d\u044f\u043c \u0430\u0431\u043e \u0437 \u0456\u043d\u0448\u0438\u043c\u0438 \u0431\u0456\u043b\u044c\u0448\u0438\u043c\u0438 Gobbler. \u0423 \u0442\u0430\u043a\u043e\u043c\u0443 \u0440\u0430\u0437\u0456 \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0442\u0430\u043a\u0435:1) \u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u043d\u0435\u0432\u0435\u043b\u0438\u043a\u0456 \u043a\u043e\u0440\u0435\u043a\u0442\u0438\u0432\u0438 \u043d\u0430\u043f\u0440\u044f\u043c\u043a\u0443, \u0449\u043e\u0431 \u043f\u043e\u0431\u0430\u0447\u0438\u0442\u0438, \u0447\u0438 \u0437\u043c\u043e\u0436\u0435 Gobbler \u0437\u0432\u0456\u043b\u044c\u043d\u0438\u0442\u0438\u0441\u044f. 2) \u042f\u043a\u0449\u043e \u0446\u0435 \u043d\u0435 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043b\u043e, \u0434\u043e\u0441\u043b\u0456\u0434\u0456\u0442\u044c \u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u043d\u0456 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0438. 3) \u042f\u043a \u043e\u0441\u0442\u0430\u043d\u043d\u0456\u0439 \u0437\u0430\u0441\u0456\u0431, \u0440\u043e\u0437\u0433\u043b\u044f\u043d\u044c\u0442\u0435 \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u043a \u0440\u0456\u0432\u043d\u044f \u0437 \u043e\u0441\u0442\u0430\u043d\u043d\u044c\u043e\u0433\u043e \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0443\u043d\u043a\u0442\u0443. \u041f\u043e\u0448\u0438\u0440\u0435\u043d\u043e\u044e \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u043e\u044e \u0454 \u0437\u0430\u0441\u0442\u0440\u044f\u0432\u0430\u043d\u043d\u044f \u043c\u0456\u0436 \u0434\u0432\u043e\u043c\u0430 \u0432\u0435\u043b\u0438\u043a\u0438\u043c\u0438 \u0441\u043a\u0435\u043b\u044f\u043c\u0438 \u043d\u0430 \u0440\u0430\u043d\u043d\u044c\u043e\u043c\u0443 \u0435\u0442\u0430\u043f\u0456 \u0432 \u043b\u0456\u0441\u0456. \u0417\u0430\u043c\u0456\u0441\u0442\u044c \u0442\u043e\u0433\u043e, \u0449\u043e\u0431 \u043f\u0440\u043e\u0431\u0438\u0432\u0430\u0442\u0438\u0441\u044c \u0432\u043f\u0435\u0440\u0435\u0434 (\u0449\u043e, \u0439\u043c\u043e\u0432\u0456\u0440\u043d\u043e, \u0437\u0430\u0431\u043b\u043e\u043a\u043e\u0432\u0430\u043d\u043e), \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0440\u0443\u0445\u0430\u0442\u0438\u0441\u044f \u0432\u043b\u0456\u0432\u043e, \u0449\u043e\u0431 \u0437\u043d\u0430\u0439\u0442\u0438 \u043f\u0440\u043e\u0445\u0456\u0434."}, {"question": "\u0420\u043e\u0437\u043c\u0456\u0440 \u043c\u0430\u0454 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0432 Gobble: \u042f\u043a \u0437\u0431\u0456\u043b\u044c\u0448\u0435\u043d\u043d\u044f \u0440\u043e\u0437\u043c\u0456\u0440\u0443 \u043c\u043e\u0433\u043e Gobbler \u0432\u043f\u043b\u0438\u0432\u0430\u0454 \u043d\u0430 \u0433\u0440\u0443 \u0456 \u044f\u043a\u0456 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0447\u043d\u0456 \u043f\u0435\u0440\u0435\u0432\u0430\u0433\u0438?", "answer": "\u0417\u0431\u0456\u043b\u044c\u0448\u0435\u043d\u043d\u044f \u0440\u043e\u0437\u043c\u0456\u0440\u0443 \u0432\u0430\u0448\u043e\u0433\u043e Gobbler \u0437\u043d\u0430\u0447\u043d\u043e \u0437\u043c\u0456\u043d\u044e\u0454 \u0433\u0440\u0443. \u0411\u0456\u043b\u044c\u0448\u0438\u0439 Gobbler \u043c\u043e\u0436\u0435 \u043f\u043e\u0433\u043b\u0438\u043d\u0430\u0442\u0438 \u0431\u0456\u043b\u044c\u0448\u0456 \u043e\u0431'\u0454\u043a\u0442\u0438 \u0442\u0430 \u0434\u043e\u043b\u0430\u0442\u0438 \u043c\u0456\u0441\u0446\u0435\u0432\u0456\u0441\u0442\u044c \u0437 \u0431\u0456\u043b\u044c\u0448\u043e\u044e \u043b\u0435\u0433\u043a\u0456\u0441\u0442\u044e! \u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0447\u043d\u0456 \u043f\u0435\u0440\u0435\u0432\u0430\u0433\u0438 \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442\u044c: 1) \u0414\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u043d\u043e\u0432\u0438\u0445 \u0437\u043e\u043d, \u044f\u043a\u0456 \u0440\u0430\u043d\u0456\u0448\u0435 \u0431\u0443\u043b\u0438 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u043c\u0438 \u0447\u0435\u0440\u0435\u0437 \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u043d\u044f \u0440\u043e\u0437\u043c\u0456\u0440\u0443. 2) \u0417\u0430\u043b\u044f\u043a\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u0430, \u043c\u043e\u0436\u043b\u0438\u0432\u043e, \u043f\u043e\u0433\u043b\u0438\u043d\u0430\u043d\u043d\u044f \u043c\u0435\u043d\u0448\u0438\u0445 \u043e\u043f\u043e\u043d\u0435\u043d\u0442\u0456\u0432. 3) \u041e\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f \u043c\u043d\u043e\u0436\u043d\u0438\u043a\u0430 \u0431\u0430\u043b\u0456\u0432 \u0437\u0430 \u043f\u043e\u0433\u043b\u0438\u043d\u0430\u043d\u043d\u044f \u0431\u0456\u043b\u044c\u0448\u0438\u0445 \u043e\u0431'\u0454\u043a\u0442\u0456\u0432. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043d\u0435\u0432\u0435\u043b\u0438\u043a\u0438\u0439 Gobbler \u043c\u043e\u0436\u0435 \u043c\u0430\u0442\u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0438 \u0437 \u043f\u043e\u0457\u0434\u0430\u043d\u043d\u044f\u043c \u0432\u0435\u043b\u0438\u043a\u043e\u0457 \u0433\u0440\u0438\u0431\u0430, \u0430\u043b\u0435 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u0432\u0438\u0440\u043e\u0449\u0435\u043d\u0438\u0439 Gobbler \u043c\u043e\u0436\u0435 \u0437'\u0457\u0441\u0442\u0438 \u0439\u043e\u0433\u043e \u043e\u0434\u043d\u0438\u043c \u043a\u043e\u0432\u0442\u043a\u043e\u043c, \u043e\u0442\u0440\u0438\u043c\u0430\u0432\u0448\u0438 \u0437\u043d\u0430\u0447\u043d\u0443 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u0431\u0430\u043b\u0456\u0432!"}, {"question": "\u0414\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u0456 \u0442\u0435\u0445\u043d\u0456\u043a\u0438 \u043f\u043e\u0433\u043b\u0438\u043d\u0430\u043d\u043d\u044f \u0432 Gobble: \u042f\u043a \u043c\u043e\u0436\u043d\u0430 \u0432\u0438\u043a\u043e\u043d\u0443\u0432\u0430\u0442\u0438 \u043b\u0430\u043d\u0446\u044e\u0433\u043e\u0432\u0456 \u043f\u043e\u0433\u043b\u0438\u043d\u0430\u043d\u043d\u044f \u0456 \u044f\u043a\u0456 \u043f\u0435\u0440\u0435\u0432\u0430\u0433\u0438 \u043c\u0430\u0454 \u043e\u0432\u043e\u043b\u043e\u0434\u0456\u043d\u043d\u044f \u0446\u0456\u0454\u044e \u0432\u043c\u0456\u043b\u0456\u0441\u0442\u044e?", "answer": "\u041b\u0430\u043d\u0446\u044e\u0433\u043e\u0432\u0435 \u043f\u043e\u0433\u043b\u0438\u043d\u0430\u043d\u043d\u044f \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u0454 \u0432\u0430\u043c \u043f\u043e\u0457\u0441\u0442\u0438 \u043a\u0456\u043b\u044c\u043a\u0430 \u043e\u0431'\u0454\u043a\u0442\u0456\u0432 \u043f\u043e\u0441\u043b\u0456\u0434\u043e\u0432\u043d\u043e, \u043f\u0456\u0434\u0432\u0438\u0449\u0438\u0432\u0448\u0438 \u0432\u0430\u0448 \u0431\u0430\u043b \u0442\u0430 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c. \u041a\u0420\u041e\u041a 1: \u0412\u0438\u0437\u043d\u0430\u0447\u0442\u0435 \u043f\u043e\u0441\u043b\u0456\u0434\u043e\u0432\u043d\u0456\u0441\u0442\u044c \u043c\u0435\u043d\u0448\u0438\u0445 \u043e\u0431'\u0454\u043a\u0442\u0456\u0432, \u0449\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u044f\u0442\u044c\u0441\u044f \u043f\u043e\u0440\u0443\u0447 \u043e\u0434\u0438\u043d \u0437 \u043e\u0434\u043d\u0438\u043c. \u041a\u0420\u041e\u041a 2: \u041f\u043e\u0447\u043d\u0456\u0442\u044c \u043f\u043e\u0457\u0434\u0430\u0442\u0438 \u0457\u0445 \u043f\u043e\u0441\u043b\u0456\u0434\u043e\u0432\u043d\u043e, \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u044e\u0447\u0438 \u0440\u0443\u0445 \u0432\u043f\u0435\u0440\u0435\u0434. \u041a\u0420\u041e\u041a 3: \u041f\u0440\u0430\u043a\u0442\u0438\u043a\u0443\u0439\u0442\u0435 \u0441\u0432\u043e\u0454\u0447\u0430\u0441\u043d\u0456\u0441\u0442\u044c \u043f\u043e\u0433\u043b\u0438\u043d\u0435\u043d\u043d\u044f, \u0449\u043e\u0431 \u0443\u043d\u0438\u043a\u043d\u0443\u0442\u0438 \u0440\u043e\u0437\u0440\u0438\u0432\u0456\u0432 \u0443 \u0441\u043f\u043e\u0436\u0438\u0432\u0430\u043d\u043d\u0456. \u0413\u0430\u0440\u043d\u0435 \u043c\u0456\u0441\u0446\u0435 \u0434\u043b\u044f \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0438 \u0446\u044c\u043e\u0433\u043e \u2013 \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u0456 \u043f\u043e\u043b\u044f, \u0434\u0435 \u0447\u0430\u0441\u0442\u043e \u0431\u0443\u0432\u0430\u044e\u0442\u044c \u0440\u044f\u0434\u0438 \u044f\u0433\u0456\u0434, \u044f\u043a\u0456 \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u043e\u0433\u043b\u0438\u043d\u0430\u0442\u0438 \u043b\u0430\u043d\u0446\u044e\u0436\u043a\u043e\u043c, \u043e\u0442\u0440\u0438\u043c\u0443\u044e\u0447\u0438 \u043a\u043e\u043c\u0431\u043e-\u0431\u0430\u043b\u0438 \u0442\u0430 \u0448\u0432\u0438\u0434\u043a\u043e \u043f\u0456\u0434\u0432\u0438\u0449\u0443\u044e\u0447\u0438 \u0440\u0456\u0432\u0435\u043d\u044c \u043d\u0430 \u0440\u0430\u043d\u043d\u0456\u0445 \u0441\u0442\u0430\u0434\u0456\u044f\u0445 \u0433\u0440\u0438."}, {"question": "\u041e\u043f\u0442\u0438\u043c\u0456\u0437\u0430\u0446\u0456\u044f Gobble: \u042f\u043a\u0456 \u043f\u043e\u0431\u0443\u0434\u043e\u0432\u0438 Gobbler \u043d\u0430\u0439\u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0456\u0448\u0456 \u0434\u043b\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0433\u043e \u043f\u0440\u043e\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f, \u0456 \u0447\u043e\u043c\u0443 \u0457\u0445 \u0432\u0432\u0430\u0436\u0430\u044e\u0442\u044c \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u043c\u0438?", "answer": "\u0414\u043b\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0433\u043e \u043f\u0440\u043e\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f Gobble \u043a\u043b\u044e\u0447\u043e\u0432\u0438\u043c\u0438 \u0454 \u043f\u043e\u0431\u0443\u0434\u043e\u0432\u0438, \u044f\u043a\u0456 \u043d\u0430\u0434\u0430\u044e\u0442\u044c \u043f\u0440\u0456\u043e\u0440\u0438\u0442\u0435\u0442 \u0448\u0432\u0438\u0434\u043a\u043e\u0441\u0442\u0456 \u0442\u0430 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u043c\u0443 \u0441\u043f\u043e\u0436\u0438\u0432\u0430\u043d\u043d\u044e. \u041d\u0430\u0439\u043a\u0440\u0430\u0449\u0456 \u043f\u043e\u0431\u0443\u0434\u043e\u0432\u0438 \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u0437\u043e\u0441\u0435\u0440\u0435\u0434\u0436\u0443\u044e\u0442\u044c\u0441\u044f \u043d\u0430 \u043c\u0430\u043a\u0441\u0438\u043c\u0456\u0437\u0430\u0446\u0456\u0457 \u0448\u0432\u0438\u0434\u043a\u043e\u0441\u0442\u0456 \u0440\u0443\u0445\u0443 \u0442\u0430 \u043c\u0456\u043d\u0456\u043c\u0456\u0437\u0430\u0446\u0456\u0457 \u0447\u0430\u0441\u0443 \u043f\u0435\u0440\u0435\u0442\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f. [\u0422\u0430\u0431\u043b\u0438\u0446\u044f \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c]:  \u0410) \"\u0413\u0443\u0440\u043c\u0430\u043d\" \u2013 \u043f\u043e\u0431\u0443\u0434\u043e\u0432\u0430, \u0449\u043e \u0437\u043e\u0441\u0435\u0440\u0435\u0434\u0436\u0443\u0454\u0442\u044c\u0441\u044f \u043d\u0430 \u0432\u0435\u043b\u0438\u043a\u043e\u043c\u0443 \u043e\u0431\u0441\u044f\u0437\u0456 \u0442\u0430 \u0437\u0434\u0430\u0442\u043d\u043e\u0441\u0442\u0456 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0442\u0438 \u0440\u043e\u0437\u043c\u0456\u0440. \u0411) \"\u0421\u0442\u0440\u0456\u043b\u0430\" \u2013 \u043f\u043e\u0431\u0443\u0434\u043e\u0432\u0430-\u00ab\u0430\u0440\u0442\u0438\u043b\u0435\u0440\u0438\u0441\u0442\u00bb. \u0412) \u0413\u0456\u0431\u0440\u0438\u0434\u043d\u0430 \u043f\u043e\u0431\u0443\u0434\u043e\u0432\u0430 \u0436\u0435\u0440\u0442\u0432\u0443\u0454 \u0434\u0435\u044f\u043a\u0438\u043c\u0438 \u043f\u043e\u043a\u0430\u0437\u043d\u0438\u043a\u0430\u043c\u0438 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0456, \u0449\u043e\u0431 \u043f\u043e\u043a\u0440\u0430\u0449\u0438\u0442\u0438 \u043c\u0430\u043d\u0435\u0432\u0440\u0435\u043d\u0456\u0441\u0442\u044c. \u041d\u0430\u0439\u043a\u0440\u0430\u0449\u0435 \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u044e\u0442\u044c \u043f\u043e\u0431\u0443\u0434\u043e\u0432\u0443 \"\u0421\u0442\u0440\u0456\u043b\u0430\", \u043e\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u0448\u043a\u043e\u0434\u0430 \u0437\u0434\u043e\u0440\u043e\u0432'\u044e \u043d\u0435 \u043c\u0430\u0454 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u043f\u0440\u0438 \u0448\u0432\u0438\u0434\u043a\u043e\u043c\u0443 \u043f\u0440\u043e\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u0456, \u043f\u0440\u0438 \u0446\u044c\u043e\u043c\u0443 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c \u043d\u0430\u0431\u0430\u0433\u0430\u0442\u043e \u0432\u0430\u0436\u043b\u0438\u0432\u0456\u0448\u0430. \u0417\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u0446\u0435 \u043f\u043e\u0441\u0438\u043b\u044e\u0454\u0442\u044c\u0441\u044f \u0442\u0438\u043c\u0447\u0430\u0441\u043e\u0432\u0438\u043c\u0438 \u0431\u0443\u0441\u0442\u0430\u043c\u0438."}, {"question": "\u0429\u043e \u0432\u043f\u043b\u0438\u0432\u0430\u0454 \u043d\u0430 \u043c\u043d\u043e\u0436\u043d\u0438\u043a \u0431\u0430\u043b\u0456\u0432 \u043f\u043e\u0433\u043b\u0438\u043d\u0430\u043d\u043d\u044f \u0432 Gobble, \u0456 \u044f\u043a \u0439\u043e\u0433\u043e \u043c\u0430\u043a\u0441\u0438\u043c\u0456\u0437\u0430\u0446\u0456\u044f \u043c\u043e\u0436\u0435 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0442\u0438 \u043c\u0435\u043d\u0456 \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u0432\u0438\u0449\u0456 \u0431\u0430\u043b\u0438 \u0432 \u0433\u0440\u0456?", "answer": "\u041c\u043d\u043e\u0436\u043d\u0438\u043a \u0431\u0430\u043b\u0456\u0432 \u043f\u043e\u0433\u043b\u0438\u043d\u0430\u043d\u043d\u044f \u0437\u0430\u043b\u0435\u0436\u0438\u0442\u044c \u0432\u0456\u0434 \u043a\u0456\u043b\u044c\u043a\u043e\u0445 \u0444\u0430\u043a\u0442\u043e\u0440\u0456\u0432, \u043f\u0435\u0440\u0448 \u0437\u0430 \u0432\u0441\u0435, \u0432\u0456\u0434 \u0440\u0456\u0437\u043d\u0438\u0446\u0456 \u0440\u043e\u0437\u043c\u0456\u0440\u0456\u0432 \u0432\u0430\u0448\u043e\u0433\u043e Gobbler \u0442\u0430 \u043e\u0431'\u0454\u043a\u0442\u0430, \u044f\u043a\u0438\u0439 \u0432\u0438 \u043f\u043e\u0433\u043b\u0438\u043d\u0430\u0454\u0442\u0435, \u0442\u0430 \u0432\u0456\u0434 \u043f\u043e\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u043a\u043e\u043c\u0431\u043e. \u0420\u043e\u0437\u0433\u043b\u044f\u043d\u044c\u0442\u0435 \u0446\u0456 \u0444\u0430\u043a\u0442\u043e\u0440\u0438 \u043f\u0440\u0438 \u0441\u043f\u0440\u043e\u0431\u0456 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0457 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0456: \u043c\u0435\u043d\u0448\u0456 \u0432\u043e\u0440\u043e\u0433\u0438 \u0434\u0430\u044e\u0442\u044c \u043c\u0435\u043d\u0448\u0435 \u0431\u0430\u043b\u0456\u0432, \u0456 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f \u043b\u0456\u0447\u0438\u043b\u044c\u043d\u0438\u043a\u0430 \u0437\u0430\u0432\u0436\u0434\u0438 \u0437\u0430\u043f\u043e\u0432\u043d\u0435\u043d\u0438\u043c \u043c\u0430\u0454 \u0432\u0438\u0440\u0456\u0448\u0430\u043b\u044c\u043d\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043f\u043e\u0441\u043b\u0456\u0434\u043e\u0432\u043d\u0435 \u043f\u043e\u0433\u043b\u0438\u043d\u0430\u043d\u043d\u044f \u043e\u0431'\u0454\u043a\u0442\u0456\u0432, \u0449\u043e \u0442\u0440\u043e\u0445\u0438 \u0431\u0456\u043b\u044c\u0448\u0456 \u0437\u0430 \u0432\u0430\u0441, \u043f\u0440\u0438 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u0456 \u0431\u0435\u0437\u043f\u0435\u0440\u0435\u0440\u0432\u043d\u043e\u0433\u043e \u043b\u0430\u043d\u0446\u044e\u0436\u043a\u0430, \u043f\u0440\u0438\u0437\u0432\u0435\u0434\u0435 \u0434\u043e \u0431\u0456\u043b\u044c\u0448\u043e\u0433\u043e \u043c\u043d\u043e\u0436\u043d\u0438\u043a\u0430 \u0431\u0430\u043b\u0456\u0432, \u043d\u0456\u0436 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u0433\u043b\u0438\u043d\u0430\u043d\u043d\u044f \u043d\u0430\u0439\u0431i\u043b\u044c\u0448\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0433\u043e \u043e\u0431'\u0454\u043a\u0442\u0430 \u0432 \u0431\u0443\u0434\u044c-\u044f\u043a\u0438\u0439 \u043c\u043e\u043c\u0435\u043d\u0442. \u0412\u0438\u0449\u0456 \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0438 \u0442\u0430\u043a\u043e\u0436 \u043c\u043e\u0436\u0443\u0442\u044c \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0438\u0442\u0438 \u0434\u0435\u043a\u043e\u0440\u0430\u0442\u0438\u0432\u043d\u0456 \u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0438."}, {"question": "\u041f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438 Gobble: \u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 \u0442\u0440\u0430\u0432\u043d\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0432 Gobble, \u0456 \u044f\u043a \u0432\u043e\u043d\u0430 \u0432\u043f\u043b\u0438\u0432\u0430\u0454 \u043d\u0430 \u0433\u0440\u0443?", "answer": "\u0422\u0440\u0430\u0432\u043d\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0432 Gobble \u2013 \u0446\u0435 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438, \u044f\u043a\u0456 \u0432\u043f\u043b\u0438\u0432\u0430\u044e\u0442\u044c \u043d\u0430 \u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c \u043e\u0431\u0440\u043e\u0431\u043a\u0438 \u0432\u0430\u0448\u0438\u043c\u0438 Gobbler \u043f\u043e\u0433\u043b\u0438\u043d\u0435\u043d\u0438\u0445 \u043e\u0431'\u0454\u043a\u0442\u0456\u0432. \u0428\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c \u0442\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044f \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u0454, \u043d\u0430\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u0448\u0432\u0438\u0434\u043a\u043e \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0437'\u0457\u0441\u0442\u0438 \u0434\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u0456 \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0438 \u0442\u0430 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u0442\u0438 \u043a\u043e\u043c\u0431\u043e-\u043b\u0456\u0447\u0438\u043b\u044c\u043d\u0438\u043a. \u0428\u0432\u0438\u0434\u0448\u0430 \u0442\u0440\u0430\u0432\u043d\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u0454 \u0448\u0432\u0438\u0434\u0448\u0435 \u043b\u0430\u043d\u0446\u044e\u0433\u043e\u0432\u0435 \u043f\u043e\u0433\u043b\u0438\u043d\u0430\u043d\u043d\u044f \u0442\u0430 \u0432\u0438\u0449\u0438\u0439 \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u0438\u0439 \u0431\u0430\u043b. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u044f\u043a\u0449\u043e \u0443 \u0432\u0430\u0441 \u0454 \u043f\u0440\u0435\u0434\u043c\u0435\u0442 \"\u0417\u0430\u043b\u0456\u0437\u043d\u0438\u0439 \u0436\u0438\u0432\u0456\u0442\", \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0431\u0435\u0437\u043f\u0435\u0440\u0435\u0440\u0432\u043d\u043e \u0457\u0441\u0442\u0438, \u043d\u0435 \u0437\u043d\u0438\u0436\u0443\u044e\u0447\u0438 \u0448\u0432\u0438\u0434\u043a\u043e\u0441\u0442\u0456 \u0442\u0430 \u0433\u043d\u0443\u0447\u043a\u043e\u0441\u0442\u0456 Gobbler \u043d\u0430\u0434\u043e\u0432\u0433\u043e, \u0449\u043e \u0434\u0430\u0454 \u0432\u0430\u043c \u043f\u0435\u0440\u0435\u0432\u0430\u0433\u0443 \u0432 \u0445\u0430\u043e\u0441\u0456 \u043f\u043e\u0433\u043b\u0438\u043d\u0430\u043d\u044c."}, {"question": "\u042f\u043a\u0430 \u043a\u043e\u0440\u0435\u043b\u044f\u0446\u0456\u044f \u043c\u0456\u0436 \u0442\u0438\u043f\u0430\u043c\u0438 \u0432\u043e\u0440\u043e\u0433\u0456\u0432 \u0442\u0430 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u0438\u043c\u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f\u043c\u0438 \u0434\u043e\u0441\u0432\u0456\u0434\u0443 \u0432 Gobble? \u042f\u043a\u0456 \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0456 \u0437\u043e\u043d\u0438 \u0434\u043b\u044f \u0444\u0430\u0440\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u0434\u043e\u0441\u0432\u0456\u0434\u0443?", "answer": "\u041a\u043e\u0436\u0435\u043d \u0442\u0438\u043f \u0432\u043e\u0440\u043e\u0433\u0456\u0432 \u0443 Gobble \u0434\u0430\u0454 \u0440\u0456\u0437\u043d\u0443 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u043e\u0447\u043e\u043a \u0434\u043e\u0441\u0432\u0456\u0434\u0443 (EXP) \u043f\u0440\u0438 \u0457\u0445 \u043f\u043e\u0433\u043b\u0438\u043d\u0430\u043d\u043d\u0456. \u0411\u0456\u043b\u044c\u0448\u0456 \u0442\u0430 \u0431\u0456\u043b\u044c\u0448 \u043d\u0435\u0431\u0435\u0437\u043f\u0435\u0447\u043d\u0456 \u0432\u043e\u0440\u043e\u0433\u0438 \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u0434\u0430\u044e\u0442\u044c \u0431\u0456\u043b\u044c\u0448\u0435 \u0434\u043e\u0441\u0432\u0456\u0434\u0443. \u0414\u043b\u044f \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0444\u0430\u0440\u043c\u0443 \u0434\u043e\u0441\u0432\u0456\u0434\u0443 \u0437\u043e\u0441\u0435\u0440\u0435\u0434\u044c\u0442\u0435\u0441\u044f \u043d\u0430 \u0437\u043e\u043d\u0430\u0445 \u0437 \u0432\u0438\u0441\u043e\u043a\u043e\u044e \u0449\u0456\u043b\u044c\u043d\u0456\u0441\u0442\u044e \u0442\u0430\u043a\u0438\u0445 \u0432\u043e\u0440\u043e\u0433\u0456\u0432. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0432\u0438\u0431\u0440\u0430\u0442\u0438 \u0444\u0430\u0440\u043c\u0443\u0432\u0430\u043d\u043d\u044f \u0432\u043e\u0440\u043e\u0433\u0456\u0432 \u0432\u0438\u0441\u043e\u043a\u043e\u0433\u043e \u0440\u0456\u0432\u043d\u044f \u0432 \u043f\u0443\u0441\u0442\u0435\u043b\u0456 \u0434\u043b\u044f \u043f\u0456\u0434\u0432\u0438\u0449\u0435\u043d\u043d\u044f \u0441\u0432\u043e\u0457\u0445 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a \u0442\u0430 EXP. \u041d\u0430\u0439\u043a\u0440\u0430\u0449\u043e\u044e \u0437\u043e\u043d\u043e\u044e \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u0431\u0443\u043b\u0430 \u0431 \u043c\u0456\u0441\u0446\u0435\u0432\u0456\u0441\u0442\u044c \u041e\u0430\u0437\u0438\u0441."}, {"question": "Gobble \u043d\u0430 \u0434\u0435\u043a\u0456\u043b\u044c\u043a\u043e\u0445 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044f\u0445: \u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0456\u0437\u0430\u0446\u0456\u044f \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f \u043c\u0456\u0436 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430\u043c\u0438, \u0456 \u0447\u0438 \u043c\u043e\u0436\u0443 \u044f \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u043e\u0434\u0438\u043d \u0456 \u0442\u043e\u0439 \u0441\u0430\u043c\u0438\u0439 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441 Gobbler \u043d\u0430 \u041f\u041a \u0442\u0430 \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0438\u0445 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044f\u0445?", "answer": "\u0421\u0438\u043d\u0445\u0440\u043e\u043d\u0456\u0437\u0430\u0446\u0456\u044f \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f \u043c\u0456\u0436 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430\u043c\u0438 \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u0454 \u0432\u0430\u043c \u0433\u0440\u0430\u0442\u0438 \u0437 \u0442\u0438\u043c \u0441\u0430\u043c\u0438\u043c \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u043c \u0437\u0430\u043f\u0438\u0441\u043e\u043c Gobble \u043d\u0430 \u0440\u0456\u0437\u043d\u0438\u0445 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044f\u0445. \u0417\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u0446\u0435 \u043f\u0440\u0430\u0446\u044e\u0454 \u0448\u043b\u044f\u0445\u043e\u043c \u0437\u0432'\u044f\u0437\u043a\u0443 \u0432\u0430\u0448\u043e\u0433\u043e \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u043e\u0433\u043e \u0437\u0430\u043f\u0438\u0441\u0443 \u0433\u0440\u0438 \u0437 \u0445\u043c\u0430\u0440\u043d\u043e\u044e \u0441\u043b\u0443\u0436\u0431\u043e\u044e. \u0429\u043e\u0431 \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0441\u0432\u0456\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441, \u043f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e \u0432\u0438 \u0443\u0432\u0456\u0439\u0448\u043b\u0438 \u0432 \u0442\u043e\u0439 \u0441\u0430\u043c\u0438\u0439 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441 \u044f\u043a \u043d\u0430 \u041f\u041a, \u0442\u0430\u043a \u0456 \u043d\u0430 \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u043e\u043c\u0443 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u0457. \u041e\u0441\u044c \u043f\u043e\u0440\u0456\u0432\u043d\u044f\u043d\u043d\u044f: (\u0410) \u0445\u043c\u0430\u0440\u043d\u0435 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f Steam, (\u0411) \u0445\u043c\u0430\u0440\u043d\u0435 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f \u0434\u043b\u044f \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0438\u0445 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u0457\u0432: \u0434\u0435\u044f\u043a\u0456 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0438 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u044e\u0442\u044c \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u0443 \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0456\u0437\u0430\u0446\u0456\u044e, \u0442\u043e\u0434\u0456 \u044f\u043a \u0456\u043d\u0448\u0456 \u0432\u0438\u043c\u0430\u0433\u0430\u044e\u0442\u044c \u0440\u0443\u0447\u043d\u043e\u0433\u043e \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f. (\u0412) \u0414\u0430\u043d\u0456 \u043d\u0456\u043a\u043e\u043b\u0438 \u043d\u0435 \u043e\u0431\u043c\u0456\u043d\u044e\u044e\u0442\u044c\u0441\u044f \u043c\u0456\u0436 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430\u043c\u0438 \u0437 \u0440\u0456\u0437\u043d\u0438\u043c\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u043c\u0438 \u0432\u0435\u0440\u0441\u0456\u044f\u043c\u0438."}, {"question": "\u0427\u0438 \u0454 \u0442\u0430\u0454\u043c\u043d\u0456 \u0437\u043e\u043d\u0438 \u0430\u0431\u043e \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 Gobbler \u0432 Gobble, \u0456 \u044f\u043a \u0457\u0445 \u0437\u043d\u0430\u0439\u0442\u0438? \u0422\u0430\u0454\u043c\u043d\u0438\u0446\u0456 \u043f\u043e\u0433\u043b\u0438\u043d\u0430\u043d\u043d\u044f \u2013 \u0440\u043e\u0437\u043a\u0430\u0436\u0456\u0442\u044c \u0431\u0456\u043b\u044c\u0448\u0435!", "answer": "\u0422\u0430\u043a, \u0454 \u0442\u0430\u0454\u043c\u043d\u0456 \u0437\u043e\u043d\u0438 \u0442\u0430 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 Gobbler, \u044f\u043a\u0456 \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u0438! \u0407\u0445 \u0447\u0430\u0441\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u044f\u0442\u044c \u043f\u043e\u0437\u0430 \u0437\u0432\u0438\u0447\u0430\u0439\u043d\u0438\u043c\u0438 \u0448\u043b\u044f\u0445\u0430\u043c\u0438 \u0430\u0431\u043e \u0434\u043b\u044f \u0457\u0445 \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u0442\u044f \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u0456 \u043f\u0435\u0432\u043d\u0456 \u0434\u0456\u0457. \u0425\u043e\u0440\u043e\u0448\u0438\u043c \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u043e\u043c \u0454 \"\u0420\u0430\u0434\u0443\u0436\u043d\u0438\u0439 \u043f\u0440\u043e\u0445\u0456\u0434\", \u0432\u0430\u043c \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u0437'\u0457\u0441\u0442\u0438 \u043f\u0440\u0438\u043d\u0430\u0439\u043c\u043d\u0456 5 \"\u041f\u0440\u0438\u0437\u043c\u0430\u0442\u0438\u0447\u043d\u0438\u0445 \u0444\u0440\u0443\u043a\u0442\u0456\u0432\", \u0449\u043e\u0431 \u0430\u043a\u0442\u0438\u0432\u0443\u0432\u0430\u0442\u0438 \u043f\u043e\u0440\u0442\u0430\u043b. \u0417\u043d\u0430\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f \u0446\u0438\u0445 \u043c\u0456\u0441\u0446\u044c \u0447\u0430\u0441\u0442\u043e \u043f\u043e\u043b\u044f\u0433\u0430\u0454 \u0432 \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u0456 \u043a\u043e\u0436\u043d\u043e\u0433\u043e \u043a\u0443\u0442\u043e\u0447\u043a\u0430 \u0442\u0430 \u043a\u0443\u0442\u043e\u0447\u043a\u0430 \u043a\u0430\u0440\u0442\u0438. \u0421\u0442\u0435\u0436\u0442\u0435 \u0437\u0430 \u0432\u0456\u0437\u0443\u0430\u043b\u044c\u043d\u0438\u043c\u0438 \u043f\u0456\u0434\u043a\u0430\u0437\u043a\u0430\u043c\u0438, \u0442\u0430\u043a\u0438\u043c\u0438 \u044f\u043a \u043d\u0435\u0437\u0432\u0438\u0447\u0430\u0439\u043d\u0456 \u0432\u0456\u0437\u0435\u0440\u0443\u043d\u043a\u0438, \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 \u0448\u043b\u044f\u0445\u0438 \u0430\u0431\u043e \u0432\u0437\u0430\u0454\u043c\u043e\u0434\u0456\u0457 \u0437 \u043d\u0430\u0432\u043a\u043e\u043b\u0438\u0448\u043d\u0456\u043c \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0435\u043c."}]
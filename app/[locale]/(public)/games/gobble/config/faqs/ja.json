[{"question": "Gobble\u5165\u9580\uff1aGobble\u306e\u57fa\u672c\u64cd\u4f5c\u306f\u4f55\u3067\u3059\u304b\u3002\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u65e9\u304f\u30d7\u30ec\u30a4\u3092\u5b66\u3076\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Gobble\u306e\u57fa\u672c\u64cd\u4f5c\u306f\u4e3b\u306b\u79fb\u52d5\u3068\u30b4\u30d6\u30ea\u30f3\u30b0\u3067\u3059\u3002\u901a\u5e38\u3001\u79fb\u52d5\u306f\u30ad\u30fc\u30dc\u30fc\u30c9\u306eWASD\u30ad\u30fc\u3001\u307e\u305f\u306f\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u306e\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u3067\u884c\u308f\u308c\u307e\u3059\u3002\u30b4\u30d6\u30ea\u30f3\u30b0\u3059\u308b\u306b\u306f\u3001\u901a\u5e38\u306f\u30b9\u30da\u30fc\u30b9\u30d0\u30fc\u307e\u305f\u306f\u6307\u5b9a\u3055\u308c\u305f\u30dc\u30bf\u30f3\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u8fc5\u901f\u306b\u5b66\u3076\u305f\u3081\u306b\u3001\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30e2\u30fc\u30c9\u304b\u3089\u59cb\u3081\u307e\u3057\u3087\u3046\u3002\u305f\u3068\u3048\u3070\u3001\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3067\u306f\u3001\u300eW\u300f\u30ad\u30fc\u3092\u4f7f\u3063\u3066\u524d\u65b9\u306b\u79fb\u52d5\u3057\u3001\u300e\u30b9\u30da\u30fc\u30b9\u30d0\u30fc\u300f\u3067\u5c0f\u3055\u3044\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u98df\u3079\u308b\u3053\u3068\u3092\u5b66\u3073\u307e\u3059\u3002\u3055\u3089\u306b\u5148\u306b\u9032\u3080\u524d\u306b\u3001\u30b2\u30fc\u30e0\u306e\u611f\u899a\u3092\u3064\u304b\u3080\u305f\u3081\u306b\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u3053\u308c\u3089\u306e\u52d5\u304d\u3092\u7df4\u7fd2\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305d\u3057\u3066\u5f8c\u3067\u3088\u308a\u9ad8\u5ea6\u306a\u30c6\u30af\u30cb\u30c3\u30af\u3092\u30de\u30b9\u30bf\u30fc\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u306a\u305c\u79c1\u306e\u30b4\u30d6\u30e9\u30fc\u306f\u52d5\u304b\u306a\u304f\u306a\u3063\u3066\u3057\u307e\u3046\u306e\u3067\u3057\u3087\u3046\u304b\uff1fGobble\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u304c\u30a4\u30e9\u30a4\u30e9\u3059\u308b\u3088\u3046\u306b\u306a\u3063\u305f\u3089\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30b4\u30d6\u30e9\u30fc\u304c\u52d5\u304b\u306a\u304f\u306a\u3063\u3066\u3057\u307e\u3046\u306e\u306f\u3001\u304a\u305d\u3089\u304f\u74b0\u5883\u307e\u305f\u306f\u4ed6\u306e\u5927\u304d\u306a\u30b4\u30d6\u30e9\u30fc\u3068\u306e\u885d\u7a81\u306e\u554f\u984c\u3067\u3059\u3002\u3053\u308c\u304c\u767a\u751f\u3057\u305f\u5834\u5408\u3001\u6b21\u306e\u3053\u3068\u3092\u8a66\u3057\u3066\u304f\u3060\u3055\u3044\u30021) \u30b4\u30d6\u30e9\u30fc\u304c\u81ea\u5206\u3067\u52d5\u3051\u308b\u304b\u3069\u3046\u304b\u3092\u78ba\u8a8d\u3059\u308b\u305f\u3081\u306b\u3001\u5c0f\u3055\u306a\u65b9\u5411\u306e\u8abf\u6574\u3092\u8a66\u3057\u3066\u304f\u3060\u3055\u3044\u30022) \u52b9\u679c\u304c\u306a\u3044\u5834\u5408\u306f\u3001\u5225\u306e\u30eb\u30fc\u30c8\u3092\u63a2\u3057\u3066\u304f\u3060\u3055\u3044\u30023) \u6700\u7d42\u624b\u6bb5\u3068\u3057\u3066\u3001\u524d\u56de\u306e\u30c1\u30a7\u30c3\u30af\u30dd\u30a4\u30f3\u30c8\u304b\u3089\u30ec\u30d9\u30eb\u3092\u3084\u308a\u76f4\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3088\u304f\u3042\u308b\u30b7\u30ca\u30ea\u30aa\u306f\u3001\u521d\u671f\u306e\u68ee\u30a8\u30ea\u30a2\u30672\u3064\u306e\u5927\u304d\u306a\u5ca9\u306e\u9593\u306b\u631f\u307e\u3063\u3066\u3057\u307e\u3046\u3053\u3068\u3067\u3059\u3002\u7121\u7406\u3084\u308a\u9032\u3080\u306e\u3067\u306f\u306a\u304f\uff08\u304a\u305d\u3089\u304f\u30d6\u30ed\u30c3\u30af\u3055\u308c\u3066\u3044\u308b\u3067\u3057\u3087\u3046\uff09\u3001\u5de6\u306b\u79fb\u52d5\u3057\u3066\u901a\u8def\u3092\u898b\u3064\u3051\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30b4\u30d6\u30e9\u30fc\u306e\u30b5\u30a4\u30ba\u306f\u91cd\u8981\uff1a\u30b4\u30d6\u30e9\u30fc\u306e\u30b5\u30a4\u30ba\u3092\u5897\u3084\u3059\u3068\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306a\u5f71\u97ff\u304c\u3042\u308a\u307e\u3059\u304b\u3002\u6226\u7565\u7684\u306a\u5229\u70b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b4\u30d6\u30e9\u30fc\u306e\u30b5\u30a4\u30ba\u3092\u5897\u3084\u3059\u3068\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u304c\u5927\u304d\u304f\u5909\u308f\u308a\u307e\u3059\u3002\u5927\u304d\u306a\u30b4\u30d6\u30e9\u30fc\u306f\u3088\u308a\u5927\u304d\u306a\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u98df\u3079\u3001\u3088\u308a\u7c21\u5358\u306b\u5730\u5f62\u3092\u9032\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\uff01\u6226\u7565\u7684\u306a\u5229\u70b9\u306b\u306f\u6b21\u306e\u3082\u306e\u304c\u3042\u308a\u307e\u3059\u30021) \u5927\u304d\u3055\u5236\u9650\u306e\u305f\u3081\u306b\u4ee5\u524d\u306f\u30a2\u30af\u30bb\u30b9\u3067\u304d\u306a\u304b\u3063\u305f\u65b0\u3057\u3044\u30a8\u30ea\u30a2\u3078\u306e\u30a2\u30af\u30bb\u30b9\u30022) \u3088\u308a\u5c0f\u3055\u306a\u6575\u3092\u5a01\u5687\u3057\u3001\u6f5c\u5728\u7684\u306b\u6d88\u8cbb\u3059\u308b\u30023) \u3088\u308a\u5927\u304d\u306a\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u6d88\u8cbb\u3059\u308b\u3053\u3068\u306b\u3088\u308b\u30b9\u30b3\u30a2\u500d\u7387\u306e\u7372\u5f97\u3002\u305f\u3068\u3048\u3070\u3001\u5c0f\u3055\u306a\u30b4\u30d6\u30e9\u30fc\u306f\u5927\u304d\u306a\u30ad\u30ce\u30b3\u3092\u98df\u3079\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u305b\u3093\u304c\u3001\u6210\u9577\u3057\u305f\u30b4\u30d6\u30e9\u30fc\u306f\u4e00\u5ea6\u306b\u98df\u3079\u308b\u3053\u3068\u304c\u3067\u304d\u3001\u304b\u306a\u308a\u306e\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u9ad8\u5ea6\u306a\u30b4\u30d6\u30ea\u30f3\u30b0\u30c6\u30af\u30cb\u30c3\u30af\uff1a\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u9023\u7d9a\u30b4\u30d6\u30ea\u30f3\u30b0\u3092\u5b9f\u884c\u3067\u304d\u307e\u3059\u304b\u3002\u3053\u306e\u30b4\u30d6\u30ea\u30f3\u30b0\u30b9\u30ad\u30eb\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u306e\u30e1\u30ea\u30c3\u30c8\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u9023\u7d9a\u30b4\u30d6\u30ea\u30f3\u30b0\u306b\u3088\u308a\u3001\u77ed\u6642\u9593\u3067\u8907\u6570\u306e\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u98df\u3079\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30b3\u30a2\u3068\u52b9\u7387\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u8fd1\u63a5\u3057\u305f\u5c0f\u3055\u306a\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306e\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u524d\u9032\u52e2\u529b\u3092\u7dad\u6301\u3057\u306a\u304c\u3089\u3001\u305d\u308c\u3089\u3092\u8fc5\u901f\u306b\u9023\u7d9a\u3057\u3066\u6d88\u8cbb\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6d88\u8cbb\u306e\u30ae\u30e3\u30c3\u30d7\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u30b4\u30d6\u30ea\u30f3\u30b0\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u7df4\u7fd2\u3057\u307e\u3059\u3002\u3053\u308c\u3092\u7df4\u7fd2\u3059\u308b\u826f\u3044\u5834\u6240\u306f\u3001\u591a\u304f\u306e\u30d9\u30ea\u30fc\u304c\u4e26\u3093\u3067\u3044\u308b\u958b\u3051\u305f\u30d5\u30a3\u30fc\u30eb\u30c9\u30a8\u30ea\u30a2\u3067\u3059\u3002\u305d\u3053\u3067\u306f\u3001\u9023\u7d9a\u3057\u3066\u30d9\u30ea\u30fc\u3092\u98df\u3079\u3001\u30b3\u30f3\u30dc\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u3001\u65e9\u671f\u30b2\u30fc\u30e0\u6bb5\u968e\u3067\u975e\u5e38\u306b\u65e9\u304f\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u3067\u304d\u307e\u3059\u3002"}, {"question": "Gobble\u6700\u9069\u5316\uff1a\u30b9\u30d4\u30fc\u30c9\u30e9\u30f3\u30cb\u30f3\u30b0\u306b\u6700\u9069\u306a\u30b4\u30d6\u30e9\u30fc\u306e\u30d3\u30eb\u30c9\u306f\u4f55\u3067\u3059\u304b\u3002\u305d\u308c\u3089\u306f\u30c8\u30c3\u30d7\u30c6\u30a3\u30a2\u3068\u898b\u306a\u3055\u308c\u3066\u3044\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "Gobble\u306e\u30b9\u30d4\u30fc\u30c9\u30e9\u30f3\u30cb\u30f3\u30b0\u3067\u306f\u3001\u901f\u5ea6\u3068\u52b9\u7387\u7684\u306a\u6d88\u8cbb\u3092\u512a\u5148\u3059\u308b\u30d3\u30eb\u30c9\u304c\u91cd\u8981\u3067\u3059\u3002\u30c8\u30c3\u30d7\u30c6\u30a3\u30a2\u306e\u30d3\u30eb\u30c9\u306f\u901a\u5e38\u3001\u79fb\u52d5\u901f\u5ea6\u3092\u6700\u5927\u5316\u3057\u3001\u6d88\u5316\u6642\u9593\u3092\u6700\u5c0f\u5316\u3059\u308b\u3053\u3068\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u3044\u307e\u3059\u3002[\u69cb\u6210\u8868\uff1a] A) \u300c\u5927\u98df\u6f22\u300d\u30d3\u30eb\u30c9\uff1a\u7d14\u7c8b\u306a\u30dc\u30ea\u30e5\u30fc\u30e0\u3068\u30b5\u30a4\u30ba\u3092\u7dad\u6301\u3059\u308b\u80fd\u529b\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u3044\u307e\u3059\u3002B) \u300c\u30c0\u30fc\u30c4\u300d\u306f\u5f37\u529b\u306a\u653b\u6483\u30bf\u30a4\u30d7\u3067\u3059\u3002C) \u30cf\u30a4\u30d6\u30ea\u30c3\u30c9\u30d3\u30eb\u30c9\u306f\u3001\u6a5f\u52d5\u529b\u5411\u4e0a\u306e\u305f\u3081\u3001\u52b9\u7387\u6027\u306e\u4e00\u90e8\u3092\u72a0\u7272\u306b\u3057\u307e\u3059\u3002\u901a\u5e38\u3001\u30b9\u30d4\u30fc\u30c9\u30e9\u30f3\u30cb\u30f3\u30b0\u3067\u306f\u30c0\u30e1\u30fc\u30b8\u306b\u95a2\u3059\u308b\u3053\u3068\u3067\u306f\u306a\u3044\u306e\u3067\u3001\u52b9\u7387\u6027\u306e\u65b9\u304c\u91cd\u8981\u3067\u3059\u3002\u3053\u308c\u306f\u901a\u5e38\u3001\u4e00\u6642\u7684\u306a\u30d0\u30d5\u3067\u5f37\u5316\u3055\u308c\u307e\u3059\u3002"}, {"question": "\u30b4\u30d6\u30ea\u30f3\u30b0\u30b9\u30b3\u30a2\u500d\u7387\u3092\u3069\u306e\u8981\u56e0\u304c\u5de6\u53f3\u3057\u307e\u3059\u304b\u3002\u305d\u308c\u3092\u6700\u5927\u5316\u3059\u308b\u3068\u3001\u3088\u308a\u9ad8\u3044\u30b2\u30fc\u30e0\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u304b\uff1f", "answer": "\u30b4\u30d6\u30ea\u30f3\u30b0\u30b9\u30b3\u30a2\u500d\u7387\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u8981\u56e0\u306b\u4f9d\u5b58\u3057\u307e\u3059\u3002\u4e3b\u306b\u3001\u30b4\u30d6\u30e9\u30fc\u3068\u30b4\u30d6\u30ea\u30f3\u30b0\u3059\u308b\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306e\u30b5\u30a4\u30ba\u5dee\u3068\u3001\u73fe\u5728\u306e\u30b3\u30f3\u30dc\u3067\u3059\u3002\u52b9\u7387\u6027\u3092\u6700\u5927\u5316\u3057\u3088\u3046\u3068\u3059\u308b\u5834\u5408\u306f\u3001\u3053\u308c\u3089\u306e\u8981\u56e0\u3092\u8003\u616e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u5c0f\u3055\u3044\u6575\u306f\u4f4e\u3044\u30b9\u30b3\u30a2\u3092\u4e0e\u3048\u307e\u3059\u3001\u30e1\u30fc\u30bf\u30fc\u3092\u5e38\u306b\u6e80\u30bf\u30f3\u306b\u4fdd\u3064\u3053\u3068\u306f\u91cd\u8981\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u9023\u7d9a\u3057\u3066\u81ea\u5206\u3088\u308a\u308f\u305a\u304b\u306b\u5927\u304d\u3044\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u30b4\u30d6\u30ea\u30f3\u30b0\u3057\u3001\u7d99\u7d9a\u7684\u306b\u30c1\u30a7\u30fc\u30f3\u3092\u7dad\u6301\u3059\u308b\u3068\u3001\u53ef\u80fd\u3067\u3042\u308c\u3070\u6700\u5927\u306e\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3060\u3051\u3092\u30b4\u30d6\u30ea\u30f3\u30b0\u3059\u308b\u3088\u308a\u3082\u3001\u9ad8\u30b9\u30b3\u30a2\u500d\u7387\u306b\u306a\u308a\u307e\u3059\u3002\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u306f\u3001\u5316\u7ca7\u54c1\u5831\u916c\u3082\u63d0\u4f9b\u3067\u304d\u307e\u3059\u3002"}, {"question": "Gobble\u306e\u96a0\u308c\u305f\u7d71\u8a08\uff1a\u6d88\u5316\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\u3002\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u304b\uff1f", "answer": "Gobble\u306e\u6d88\u5316\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b4\u30d6\u30e9\u30fc\u304c\u6d88\u8cbb\u3057\u305f\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u51e6\u7406\u3059\u308b\u901f\u5ea6\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u96a0\u308c\u305f\u7d71\u8a08\u3067\u3059\u3002\u6d88\u5316\u901f\u5ea6\u306f\u3001\u8ffd\u52a0\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u3069\u308c\u3060\u3051\u65e9\u304f\u6d88\u8cbb\u3057\u3001\u30b3\u30f3\u30dc\u30e1\u30fc\u30bf\u30fc\u3092\u7dad\u6301\u3067\u304d\u308b\u304b\u3092\u6c7a\u5b9a\u3057\u307e\u3059\u3002\u6d88\u5316\u30b7\u30b9\u30c6\u30e0\u304c\u901f\u3044\u307b\u3069\u3001\u3088\u308a\u8fc5\u901f\u306a\u9023\u7d9a\u30b4\u30d6\u30ea\u30f3\u30b0\u3068\u3001\u3088\u308a\u9ad8\u3044\u7dcf\u5408\u30b9\u30b3\u30a2\u304c\u53ef\u80fd\u306b\u306a\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u9244\u306e\u80c3\u300d\u30a2\u30a4\u30c6\u30e0\u3092\u88c5\u5099\u3057\u3066\u3044\u308b\u5834\u5408\u3001\u6d88\u5316\u304c\u30b4\u30d6\u30e9\u30fc\u306e\u901f\u5ea6\u3068\u6a5f\u654f\u3055\u3092\u9577\u671f\u9593\u4f4e\u4e0b\u3055\u305b\u308b\u3053\u3068\u306a\u304f\u3001\u9023\u7d9a\u3057\u3066\u98df\u3079\u308b\u3053\u3068\u3067\u3001\u30b4\u30d6\u30ea\u30f3\u30b0\u306e\u6df7\u4e71\u306e\u4e2d\u3067\u512a\u4f4d\u6027\u3092\u6301\u3064\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u6575\u306e\u7a2e\u985e\u3068\u305d\u306e\u5bfe\u5fdc\u3059\u308b\u7d4c\u9a13\u5024\u306e\u9593\u306b\u306f\u3069\u306e\u3088\u3046\u306a\u76f8\u95a2\u95a2\u4fc2\u304c\u3042\u308a\u307e\u3059\u304b\u3002\u7d4c\u9a13\u5024\u7372\u5f97\u306b\u6700\u9069\u306a\u30a8\u30ea\u30a2\u306f\u3069\u3053\u304b\uff1f", "answer": "Gobble\u306e\u5404\u6575\u306e\u7a2e\u985e\u306f\u3001\u6d88\u8cbb\u6642\u306b\u7570\u306a\u308b\u91cf\u306e\u7d4c\u9a13\u5024\uff08\u7d4c\u9a13\u30dd\u30a4\u30f3\u30c8\uff09\u306b\u306a\u308a\u307e\u3059\u3002\u3088\u308a\u5927\u304d\u304f\u3001\u3088\u308a\u5371\u967a\u306a\u6575\u306f\u901a\u5e38\u3001\u3088\u308a\u591a\u304f\u306e\u7d4c\u9a13\u5024\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u52b9\u7387\u7684\u306a\u7d4c\u9a13\u5024\u7372\u5f97\u306e\u305f\u3081\u306b\u3001\u3053\u308c\u3089\u306e\u6575\u306e\u5bc6\u5ea6\u304c\u9ad8\u3044\u30a8\u30ea\u30a2\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b9\u30c6\u30fc\u30bf\u30b9\u3068\u7d4c\u9a13\u5024\u3092\u9ad8\u3081\u308b\u305f\u3081\u306b\u3001\u7802\u6f20\u3067\u3088\u308a\u9ad8\u30ec\u30d9\u30eb\u306e\u6575\u3092\u72e9\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u6700\u9069\u306a\u30a8\u30ea\u30a2\u306f\u30aa\u30a2\u30b7\u30b9\u3067\u3059\u3002"}, {"question": "\u8907\u6570\u306e\u30c7\u30d0\u30a4\u30b9\u3067Gobble\uff1a\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u4fdd\u5b58\u540c\u671f\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\u3002PC\u3068\u30e2\u30d0\u30a4\u30eb\u3067\u540c\u3058\u30b4\u30d6\u30e9\u30fc\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30d7\u30ec\u30a4\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u4fdd\u5b58\u540c\u671f\u306b\u3088\u308a\u3001\u8907\u6570\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30b4\u30d6\u30e9\u30fc\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30d7\u30ec\u30a4\u3067\u304d\u307e\u3059\u3002\u901a\u5e38\u3001\u30b2\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30af\u30e9\u30a6\u30c9\u30b5\u30fc\u30d3\u30b9\u306b\u30ea\u30f3\u30af\u3059\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u6a5f\u80fd\u3057\u307e\u3059\u3002\u9032\u884c\u72b6\u6cc1\u3092\u540c\u671f\u3059\u308b\u305f\u3081\u306b\u3001PC\u3068\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u306e\u4e21\u65b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6b21\u306e\u6bd4\u8f03\u3092\u53c2\u7167\u3057\u3066\u304f\u3060\u3055\u3044\u3002(A) Steam\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3001(B) \u30e2\u30d0\u30a4\u30eb\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\uff1a\u4e00\u90e8\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306f\u81ea\u52d5\u540c\u671f\u3092\u30b5\u30dd\u30fc\u30c8\u3059\u308b\u4e00\u65b9\u3001\u4ed6\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306f\u624b\u52d5\u4fdd\u5b58\u304c\u5fc5\u8981\u3067\u3059\u3002(C) \u7570\u306a\u308b\u30d0\u30fc\u30b8\u30e7\u30f3\u3092\u6301\u3064\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u306f\u30c7\u30fc\u30bf\u306f\u5171\u6709\u3055\u308c\u307e\u305b\u3093\u3002"}, {"question": "Gobble\u306b\u306f\u79d8\u5bc6\u306e\u30a8\u30ea\u30a2\u3084\u96a0\u308c\u305f\u30b4\u30d6\u30e9\u30fc\u306f\u3042\u308a\u307e\u3059\u304b\u3002\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1fGobble\u306e\u79d8\u5bc6\u306b\u3064\u3044\u3066\u6559\u3048\u3066\u304f\u3060\u3055\u3044\uff01", "answer": "\u306f\u3044\u3001\u79d8\u5bc6\u306e\u30a8\u30ea\u30a2\u3084\u96a0\u308c\u305f\u30b4\u30d6\u30e9\u30fc\u3092\u767a\u898b\u3067\u304d\u307e\u3059\uff01\u3053\u308c\u3089\u306f\u3001\u901a\u5e38\u3001\u4eba\u901a\u308a\u306e\u5c11\u306a\u3044\u5834\u6240\u306b\u3042\u308b\u304b\u3001\u7279\u5b9a\u306e\u64cd\u4f5c\u3067\u30ed\u30c3\u30af\u89e3\u9664\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u300c\u8679\u306e\u901a\u8def\u300d\u306f\u826f\u3044\u4f8b\u3067\u3059\u3002\u5c11\u306a\u304f\u3068\u30825\u3064\u306e\u300e\u30d7\u30ea\u30ba\u30e0\u30d5\u30eb\u30fc\u30c4\u300f\u3092\u98df\u3079\u305f\u3053\u3068\u304c\u306a\u3044\u3068\u3001\u30dd\u30fc\u30bf\u30eb\u304c\u30a2\u30af\u30c6\u30a3\u30d6\u306b\u306a\u308a\u307e\u305b\u3093\u3002\u3053\u308c\u3089\u3092\u898b\u3064\u3051\u308b\u306b\u306f\u3001\u30de\u30c3\u30d7\u306e\u9685\u3005\u307e\u3067\u63a2\u6c42\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u7570\u5e38\u306a\u30d1\u30bf\u30fc\u30f3\u3001\u96a0\u308c\u305f\u901a\u8def\u3001\u307e\u305f\u306f\u74b0\u5883\u3068\u306e\u76f8\u4e92\u4f5c\u7528\u306a\u3069\u3001\u8996\u899a\u7684\u306a\u624b\u304c\u304b\u308a\u3092\u63a2\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}]
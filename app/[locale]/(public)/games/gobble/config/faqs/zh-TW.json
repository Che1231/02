[{"question": "Gobble\u5165\u9580\uff1aGobble\u7684\u57fa\u790e\u63a7\u5236\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5982\u4f55\u5feb\u901f\u4e0a\u624b\u904a\u6232\uff1f", "answer": "\u5728Gobble\u904a\u6232\u4e2d\uff0c\u57fa\u790e\u63a7\u5236\u4e3b\u8981\u570d\u7e5e\u79fb\u52d5\u548c\u541e\u566c\uff08Gobbling\uff09\u3002\u901a\u5e38\uff0c\u79fb\u52d5\u4f7f\u7528\u9375\u76e4\u4e0a\u7684 WASD \u9375\uff0c\u6216\u904a\u6232\u624b\u628a\u4e0a\u7684\u6416\u687f\u3002\u541e\u566c\u5247\u901a\u5e38\u4f7f\u7528\u7a7a\u683c\u9375\u6216\u6307\u5b9a\u6309\u9215\u3002\u5feb\u901f\u4e0a\u624b\u7684\u65b9\u6cd5\u662f\u5f9e\u6559\u5b78\u6a21\u5f0f\u958b\u59cb\u3002\u4f8b\u5982\uff0c\u5728\u6559\u5b78\u6a21\u5f0f\u4e2d\uff0c\u4f60\u6703\u5b78\u7fd2\u5982\u4f55\u4f7f\u7528 \"W\" \u9375\u524d\u9032\uff0c\u4e26\u4f7f\u7528 \"\u7a7a\u683c\u9375\" \u541e\u566c\u8f03\u5c0f\u7684\u7269\u9ad4\u3002\u5728\u6700\u521d\u7684\u95dc\u5361\u4e2d\u7df4\u7fd2\u9019\u4e9b\u52d5\u4f5c\uff0c\u719f\u6089\u904a\u6232\u64cd\u4f5c\uff0c\u7136\u5f8c\u518d\u9032\u968e\u5b78\u7fd2\u66f4\u9ad8\u7d1a\u7684\u6280\u5de7\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u7684 Gobbler \u8001\u662f\u5361\u4f4f\uff1f\u7576 Gobble \u904a\u6232\u8b8a\u5f97\u4ee4\u4eba\u6cae\u55aa\u6642\uff0c\u6211\u61c9\u8a72\u600e\u9ebc\u8fa6\uff1f", "answer": "\u4f60\u7684 Gobbler \u53ef\u80fd\u6703\u5361\u4f4f\uff0c\u56e0\u70ba\u8207\u74b0\u5883\u6216\u5176\u4ed6\u8f03\u5927\u7684 Gobbler \u767c\u751f\u78b0\u649e\u3002\u767c\u751f\u9019\u7a2e\u60c5\u6cc1\u6642\uff0c\u8acb\u5617\u8a66\u4ee5\u4e0b\u6b65\u9a5f\uff1a1) \u8a66\u8457\u5fae\u8abf\u65b9\u5411\uff0c\u770b\u770b Gobbler \u662f\u5426\u80fd\u81ea\u884c\u812b\u56f0\u30022) \u5982\u679c\u6c92\u6709\u7528\uff0c\u8acb\u5617\u8a66\u4f7f\u7528\u4e0d\u540c\u7684\u8def\u7dda\u30023) \u6700\u5f8c\uff0c\u53ef\u4ee5\u8003\u616e\u5f9e\u6700\u5f8c\u4e00\u500b\u6aa2\u67e5\u9ede\u91cd\u65b0\u958b\u59cb\u95dc\u5361\u3002\u65e9\u671f\u68ee\u6797\u5340\u57df\u5361\u5728\u5169\u584a\u5927\u5ca9\u77f3\u4e4b\u9593\u7684\u60c5\u6cc1\u5f88\u5e38\u898b\u3002\u4e0d\u8981\u5f37\u884c\u524d\u9032\uff08\u5f88\u53ef\u80fd\u88ab\u963b\u64cb\uff09\uff0c\u8a66\u8457\u5411\u5de6\u79fb\u52d5\uff0c\u5c0b\u627e\u7a7a\u9699\u3002"}, {"question": "Gobble \u7684\u5927\u5c0f\u5f88\u91cd\u8981\uff1a\u589e\u52a0\u6211\u7684 Gobbler \u5927\u5c0f\u6703\u5982\u4f55\u5f71\u97ff\u904a\u6232\uff0c\u4ee5\u53ca\u7b56\u7565\u4e0a\u7684\u512a\u52e2\u662f\u4ec0\u9ebc\uff1f", "answer": "\u589e\u52a0 Gobbler \u7684\u5927\u5c0f\u6703\u986f\u8457\u6539\u8b8a\u904a\u6232\u9ad4\u9a57\u3002\u8f03\u5927\u7684 Gobbler \u53ef\u4ee5\u541e\u566c\u66f4\u5927\u7684\u7269\u9ad4\uff0c\u4e26\u66f4\u5bb9\u6613\u5730\u7a7f\u68ad\u65bc\u5730\u5f62\uff01\u7b56\u7565\u512a\u52e2\u5305\u62ec\uff1a1) \u7372\u5f97\u5148\u524d\u56e0\u5927\u5c0f\u9650\u5236\u800c\u7121\u6cd5\u5230\u9054\u7684\u65b0\u5340\u57df\u30022) \u5a01\u61fe\u4e26\u6f5b\u5728\u541e\u566c\u8f03\u5c0f\u7684\u6575\u4eba\u30023) \u7372\u5f97\u541e\u566c\u8f03\u5927\u7269\u9ad4\u7684\u5f97\u5206\u500d\u6578\u3002\u4f8b\u5982\uff0c\u5c0f Gobbler \u53ef\u80fd\u96e3\u4ee5\u541e\u566c\u5927\u8611\u83c7\uff0c\u4f46\u9577\u5927\u5f8c\u7684 Gobbler \u80fd\u4e00\u53e3\u541e\u4e0b\uff0c\u7372\u5f97\u53ef\u89c0\u7684\u5f97\u5206\u52a0\u6210\uff01"}, {"question": "\u9032\u968e\u541e\u566c\u6280\u5de7\uff1a\u5982\u4f55\u57f7\u884c\u9023\u9396\u541e\u566c\uff0c\u4ee5\u53ca\u7cbe\u901a\u6b64\u6280\u5de7\u7684\u597d\u8655\u662f\u4ec0\u9ebc\uff1f", "answer": "\u9023\u9396\u541e\u566c\u8b93\u4f60\u5feb\u901f\u9023\u7e8c\u541e\u566c\u591a\u500b\u7269\u9ad4\uff0c\u63d0\u5347\u5f97\u5206\u548c\u6548\u7387\u3002\u6b65\u9a5f1\uff1a\u627e\u5230\u9644\u8fd1\u6709\u591a\u500b\u8f03\u5c0f\u7684\u7269\u9ad4\u3002\u6b65\u9a5f2\uff1a\u5feb\u901f\u9023\u7e8c\u541e\u566c\u5b83\u5011\uff0c\u4fdd\u6301\u524d\u9032\u7684\u52e2\u982d\u3002\u6b65\u9a5f3\uff1a\u7df4\u7fd2\u63a7\u5236\u541e\u566c\u6642\u9593\uff0c\u907f\u514d\u541e\u566c\u9593\u65b7\u3002\u5728\u958b\u95ca\u5340\u57df\u7df4\u7fd2\u6b64\u6280\u5de7\u975e\u5e38\u6709\u6548\uff0c\u56e0\u70ba\u7d93\u5e38\u6703\u6709\u6392\u5217\u6574\u9f4a\u7684\u6f3f\u679c\u53ef\u4ee5\u9023\u9396\u541e\u566c\uff0c\u7372\u5f97\u9023\u64ca\u5f97\u5206\uff0c\u4e26\u5728\u904a\u6232\u521d\u671f\u5feb\u901f\u5347\u7d1a\u3002"}, {"question": "Gobble \u512a\u5316\uff1a\u54ea\u4e9b Gobbler \u7d44\u5408\u6700\u9069\u5408\u901f\u5ea6\u8dd1\uff0c\u70ba\u4ec0\u9ebc\u5b83\u5011\u88ab\u8a8d\u70ba\u662f\u9802\u7d1a\u7d44\u5408\uff1f", "answer": "\u5c0d\u65bc\u901f\u5ea6\u8dd1 Gobble\uff0c\u512a\u5148\u8003\u616e\u901f\u5ea6\u548c\u6709\u6548\u541e\u566c\u7684\u7d44\u5408\u4f5c\u70ba\u95dc\u9375\u3002\u9802\u7d1a\u7d44\u5408\u901a\u5e38\u5074\u91cd\u65bc\u6700\u5927\u5316\u79fb\u52d5\u901f\u5ea6\u4e26\u5c07\u6d88\u5316\u6642\u9593\u964d\u5230\u6700\u4f4e\u3002[\u7d44\u5408\u8868\uff1a] A) \"\u66b4\u98df\u8005\" \u7d44\u5408\uff1a\u6ce8\u91cd\u6578\u91cf\u548c\u7dad\u6301\u5927\u5c0f\u7684\u80fd\u529b\u3002B) \"\u75be\u901f\u8005\" \u7d44\u5408\uff1a\u5c6c\u6027\u653b\u64ca\u578b\u3002C) \u6df7\u5408\u578b\u7d44\u5408\u80fd\u70ba\u4e86\u63d0\u9ad8\u9748\u6d3b\u6027\u800c\u6298\u8877\u4e00\u4e9b\u6548\u7387\u5c6c\u6027\uff1b\u901f\u5ea6\u8dd1\u901a\u5e38\u4f7f\u7528 \"\u75be\u901f\u8005\" \u7d44\u5408\uff0c\u56e0\u70ba\u5728\u901f\u5ea6\u8dd1\u4e2d\uff0c\u751f\u547d\u503c\u4e0b\u964d\u4e26\u975e\u91cd\u8981\u56e0\u7d20\uff0c\u56e0\u6b64\u6548\u7387\u66f4\u70ba\u91cd\u8981\uff0c\u9019\u901a\u5e38\u4f34\u96a8\u8457\u81e8\u6642\u52a0\u6210\u3002"}, {"question": "\u4ec0\u9ebc\u6703\u5f71\u97ff Gobble \u5f97\u5206\u500d\u6578\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u5927\u5316\u5b83\u4f86\u7372\u5f97\u66f4\u9ad8\u7684\u904a\u6232\u5206\u6578\uff1f", "answer": "Gobble \u5f97\u5206\u500d\u6578\u53d6\u6c7a\u65bc\u5e7e\u500b\u56e0\u7d20\uff0c\u4e3b\u8981\u5305\u62ec\u4f60\u7684 Gobbler \u548c\u88ab\u541e\u566c\u7269\u9ad4\u4e4b\u9593\u7684\u5927\u5c0f\u5dee\u7570\uff0c\u4ee5\u53ca\u4f60\u76ee\u524d\u7684\u9023\u64ca\u6578\u3002\u5728\u5c0b\u6c42\u6700\u5927\u5316\u6548\u7387\u6642\uff0c\u8acb\u8003\u616e\u9019\u4e9b\u56e0\u7d20\uff1a\u8f03\u5c0f\u7684\u6575\u4eba\u7d66\u4e88\u8f03\u4f4e\u7684\u5f97\u5206\uff0c\u4e26\u6642\u523b\u4fdd\u6301\u8a08\u5206\u5668\u662f\u5fc5\u8981\u7684\u3002\u4f8b\u5982\uff0c\u6301\u7e8c\u541e\u566c\u7565\u5927\u65bc\u4f60\u7684\u7269\u9ad4\uff0c\u4e26\u4fdd\u6301\u9023\u7e8c\u541e\u566c\uff0c\u6703\u6bd4\u53ea\u76e1\u53ef\u80fd\u541e\u566c\u6700\u5927\u7684\u7269\u9ad4\u6642\uff0c\u5e36\u4f86\u66f4\u9ad8\u7684\u5f97\u5206\u500d\u6578\u3002\u8f03\u9ad8\u7684\u5f97\u5206\u4e5f\u53ef\u80fd\u63d0\u4f9b\u8996\u89ba\u734e\u52f5\u3002"}, {"question": "Gobble \u7684\u96b1\u85cf\u5c6c\u6027\uff1aGobble \u7684\u6d88\u5316\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u4ee5\u53ca\u5b83\u6703\u5982\u4f55\u5f71\u97ff\u904a\u6232\uff1f", "answer": "Gobble \u7684\u6d88\u5316\u7cfb\u7d71\u662f\u4e00\u500b\u96b1\u85cf\u5c6c\u6027\uff0c\u5b83\u6703\u5f71\u97ff Gobbler \u8655\u7406\u6d88\u8017\u7684\u7269\u9ad4\u7684\u901f\u5ea6\u3002\u6d88\u5316\u901f\u5ea6\u6c7a\u5b9a\u4e86\u4f60\u53ef\u4ee5\u591a\u5feb\u5730\u541e\u566c\u984d\u5916\u7269\u54c1\u4e26\u4fdd\u6301\u9023\u64ca\u8a08\u5206\u5668\u3002\u66f4\u5feb\u7684\u6d88\u5316\u7cfb\u7d71\uff0c\u53ef\u4ee5\u9032\u884c\u66f4\u5feb\u901f\u7684\u9023\u9396\u541e\u566c\uff0c\u4e26\u7372\u5f97\u66f4\u9ad8\u7684\u7e3d\u9ad4\u5206\u6578\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5df2\u88dd\u5099\u4e86\u300c\u9435\u80c3\u300d\u9053\u5177\uff0c\u4f60\u53ef\u4ee5\u6301\u7e8c\u541e\u566c\uff0c\u800c\u4e0d\u6703\u56e0\u6d88\u5316\u800c\u5ef6\u7de9 Gobbler \u7684\u901f\u5ea6\u548c\u9748\u6d3b\u6027\uff0c\u8b93\u4f60\u5728 Gobbling \u6df7\u6230\u4e2d\u4f54\u64da\u512a\u52e2\u3002"}, {"question": "\u6575\u4eba\u985e\u578b\u8207\u5176\u5c0d\u61c9\u7684 EXP \u503c\u4e4b\u9593\u6709\u4ec0\u9ebc\u95dc\u806f\uff1f\u54ea\u4e9b\u5340\u57df\u6700\u9069\u5408 EXP \u7372\u53d6\uff1f", "answer": "Gobble \u4e2d\u7684\u6bcf\u4e00\u7a2e\u6575\u4eba\u985e\u578b\u90fd\u6703\u7522\u751f\u4e0d\u540c\u7684 EXP\uff08\u7d93\u9a57\u503c\uff09\u3002\u8f03\u5927\u3001\u8f03\u5371\u96aa\u7684\u6575\u4eba\u901a\u5e38\u6703\u63d0\u4f9b\u66f4\u591a EXP\u3002\u70ba\u4e86\u6709\u6548\u5730\u7372\u5f97 EXP\uff0c\u61c9\u96c6\u4e2d\u65bc\u6575\u4eba\u5bc6\u5ea6\u8f03\u9ad8\u7684\u5340\u57df\u3002\u4f8b\u5982\uff0c\u4f60\u53ef\u4ee5\u9078\u64c7\u5728\u6c99\u6f20\u4e2d\u72e9\u7375\u9ad8\u7b49\u7d1a\u7684\u602a\u7269\uff0c\u4ee5\u63d0\u5347\u4f60\u7684\u5c6c\u6027\u4e26\u7372\u5f97 EXP\u3002\u6700\u4f73\u7684\u5340\u57df\u662f\u7da0\u6d32\u3002"}, {"question": "\u5982\u4f55\u5728\u591a\u500b\u88dd\u7f6e\u4e0a\u9032\u884c Gobble \u904a\u6232\uff1f\u8de8\u5e73\u53f0\u5132\u5b58\u540c\u6b65\u5982\u4f55\u904b\u4f5c\uff0c\u6211\u53ef\u4ee5\u5728 PC \u548c\u624b\u6a5f\u4e0a\u4f7f\u7528\u540c\u4e00\u500b Gobbler \u5e33\u865f\u55ce\uff1f", "answer": "\u8de8\u5e73\u53f0\u5132\u5b58\u540c\u6b65\u5141\u8a31\u4f60\u5728\u591a\u500b\u88dd\u7f6e\u4e0a\u4f7f\u7528\u76f8\u540c\u7684 Gobbler \u5e33\u865f\u9032\u884c\u904a\u6232\u3002\u5b83\u901a\u5e38\u901a\u904e\u5c07\u4f60\u7684\u904a\u6232\u5e33\u865f\u9023\u7d50\u5230\u96f2\u7aef\u670d\u52d9\u4f86\u904b\u4f5c\u3002\u8981\u540c\u6b65\u4f60\u7684\u9032\u5ea6\uff0c\u8acb\u78ba\u4fdd\u4f60\u5728 PC \u548c\u884c\u52d5\u88dd\u7f6e\u4e0a\u767b\u5165\u540c\u4e00\u500b\u5e33\u865f\u3002\u4ee5\u4e0b\u662f\u6bd4\u8f03\uff1a(A) Steam \u96f2\u7aef\u5132\u5b58\uff0c(B)\u884c\u52d5\u88dd\u7f6e\u96f2\u7aef\u5132\u5b58\uff1a\u67d0\u4e9b\u5e73\u53f0\u652f\u63f4\u81ea\u52d5\u540c\u6b65\uff0c\u800c\u5176\u4ed6\u5e73\u53f0\u5247\u9700\u8981\u624b\u52d5\u5132\u5b58\u3002(C) \u8cc7\u6599\u7d55\u4e0d\u6703\u5728\u5177\u6709\u4e0d\u540c\u7248\u672c\u7684\u5e73\u53f0\u4e4b\u9593\u5171\u4eab\u3002"}, {"question": "Gobble \u904a\u6232\u4e2d\u6709\u6c92\u6709\u4efb\u4f55\u79d8\u5bc6\u5340\u57df\u6216\u96b1\u85cf\u7684 Gobbler\uff1f\u5982\u4f55\u627e\u5230\u5b83\u5011\uff1f\u544a\u8a34\u6211\u95dc\u65bc Gobble \u79d8\u5bc6\u7684\u66f4\u591a\u8cc7\u8a0a\uff01", "answer": "\u662f\u7684\uff0c\u6709\u79d8\u5bc6\u5340\u57df\u548c\u96b1\u85cf\u7684 Gobbler \u53ef\u4f9b\u767c\u73fe\uff01\u5b83\u5011\u901a\u5e38\u4f4d\u65bc\u504f\u50fb\u7684\u5340\u57df\uff0c\u6216\u9700\u8981\u57f7\u884c\u7279\u5b9a\u52d5\u4f5c\u624d\u80fd\u89e3\u9396\u3002\u4e00\u500b\u5f88\u597d\u7684\u4f8b\u5b50\u662f \"\u5f69\u8679\u901a\u9053\"\uff0c\u4f60\u9700\u8981\u541e\u566c\u81f3\u5c11 5 \u500b \"\u5f69\u8679\u679c\u5be6\" \u624d\u80fd\u6fc0\u6d3b\u50b3\u9001\u9580\u3002\u627e\u5230\u9019\u4e9b\u901a\u5e38\u9700\u8981\u63a2\u7d22\u5730\u5716\u4e2d\u7684\u6bcf\u500b\u89d2\u843d\u3002\u8acb\u7559\u610f\u8996\u89ba\u7dda\u7d22\uff0c\u4f8b\u5982\u7570\u5e38\u5716\u6848\u3001\u96b1\u85cf\u7684\u9053\u8def\u6216\u8207\u74b0\u5883\u7684\u4e92\u52d5\u3002"}]
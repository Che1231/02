[{"question": "\u65b0\u624b\u5982\u4f55\u5f00\u59cb\u5728\u5377\u997c\u5de5\u574a\u5236\u4f5c\u7b2c\u4e00\u4e2a\u5377\u997c\uff1f", "answer": "\u8981\u5728\u5377\u997c\u5de5\u574a\u5236\u4f5c\u7b2c\u4e00\u4e2a\u5377\u997c\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u6309'C'\u952e\u6253\u5f00\u5236\u4f5c\u83dc\u5355\u3002\u6b65\u9aa42 - \u9009\u62e9'\u57fa\u7840\u98df\u6750'\u6807\u7b7e\u3002\u6b65\u9aa43 - \u5c06\u4e00\u4e2a\u7389\u7c73\u997c\u62d6\u653e\u5230\u5236\u4f5c\u7f51\u683c\u4e0a\u3002\u6b65\u9aa44 - \u6dfb\u52a0\u81f3\u5c11\u4e00\u79cd\u9985\u6599\uff0c\u4f8b\u5982\u8c46\u7c7b\u6216\u7c73\u996d\u3002\u6b65\u9aa45 - \u70b9\u51fb'\u5236\u4f5c'\u5b8c\u6210\u60a8\u7684\u5377\u997c\u3002\u4f8b\u5982\uff0c\u65b0\u624b\u53ef\u4ee5\u4f7f\u7528\u8fd9\u4e9b\u6b65\u9aa4\u5236\u4f5c\u4e00\u4e2a\u7b80\u5355\u7684\u8c46\u5377\u997c\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u53ef\u4ee5\u628a\u5b83\u60f3\u8c61\u6210\u7ec4\u88c5\u4e09\u660e\u6cbb\uff0c\u7389\u7c73\u997c\u662f\u4f60\u7684\u9762\u5305\uff0c\u9985\u6599\u662f\u4f60\u7684\u914d\u6599\u3002]"}, {"question": "\u5728\u5377\u997c\u5de5\u574a\u6e38\u620f\u4e2d\u73a9\u6ee1100\u5c0f\u65f6\u540e\uff0c\u5982\u4f55\u6700\u5927\u5316\u6211\u7684\u5377\u997c\u5206\u6570\uff1f", "answer": "\u5728\u5377\u997c\u5de5\u574a\u6e38\u620f\u4e2d\u73a9\u6ee1100\u5c0f\u65f6\u540e\uff0c\u8981\u6700\u5927\u5316\u60a8\u7684\u5377\u997c\u5206\u6570\uff0c\u8bf7\u8003\u8651\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9aa41 - \u4f7f\u7528\u7a00\u6709\u98df\u6750\uff0c\u4f8b\u5982\u201c\u5e7d\u7075\u8fa3\u6912\u201d\uff0c\u83b7\u5f97\u989d\u5916\u5206\u6570\u3002\u6b65\u9aa42 - \u5e73\u8861\u9985\u6599\uff0c\u907f\u514d\u8fc7\u91cf\u6dfb\u52a0\uff0c\u8fd9\u4f1a\u964d\u4f4e\u60a8\u7684\u5206\u6570\u3002\u6b65\u9aa43 - \u4f7f\u7528\u7279\u6b8a\u9171\u6599\uff0c\u4f8b\u5982\u201c\u8fa3\u6912\u6cb9\u201d\uff0c\u83b7\u5f97\u98ce\u5473\u52a0\u6210\u3002\u4f8b\u5982\uff0c\u9ad8\u5206\u5377\u997c\u53ef\u80fd\u5305\u542b\u5e7d\u7075\u8fa3\u6912\uff0c\u5e73\u8861\u7684\u7c73\u996d\u548c\u8c46\u7c7b\u4ee5\u53ca\u8fa3\u6912\u6cb9\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u4f7f\u7528\u7a00\u6709\u98df\u6750\u4e0e\u666e\u901a\u98df\u6750\u76f8\u6bd4\uff0c\u5206\u6570\u53ef\u4ee5\u63d0\u9ad8\u9ad8\u8fbe50%\uff0c\u4f46\u662f\u8fc7\u91cf\u6dfb\u52a0\u98df\u6750\u4f1a\u964d\u4f4e20%\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u5377\u997c\u5de5\u574a\u7684\u5236\u4f5c\u7cfb\u7edf\u5141\u8bb8\u98df\u6750\u5806\u53e0\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\uff1f", "answer": "\u5377\u997c\u5de5\u574a\u7684\u5236\u4f5c\u7cfb\u7edf\u5141\u8bb8\u98df\u6750\u5806\u53e0\uff0c\u589e\u52a0\u6e38\u620f\u7684\u6df1\u5ea6\u548c\u7b56\u7565\u6027\u3002\u5806\u53e0\u98df\u6750\uff0c\u4f8b\u5982\u591a\u5c42\u5976\u916a\u6216\u8c46\u7c7b\uff0c\u53ef\u4ee5\u589e\u5f3a\u98ce\u5473\u5e76\u63d0\u9ad8\u60a8\u7684\u5377\u997c\u5206\u6570\u3002\u4f46\u662f\uff0c\u8fc7\u91cf\u5806\u53e0\u4f1a\u5bfc\u81f4\u5377\u997c\u7684\u51dd\u805a\u529b\u964d\u4f4e\uff0c\u4ece\u800c\u964d\u4f4e\u5176\u6574\u4f53\u8d28\u91cf\u3002\u4f8b\u5982\uff0c\u5806\u53e0\u4e09\u5c42\u5976\u916a\u53ef\u80fd\u63d0\u4f9b+15\u7684\u98ce\u5473\u52a0\u6210\uff0c\u4f46\u662f\u6dfb\u52a0\u7b2c\u56db\u5c42\u5976\u916a\u53ef\u80fd\u4f1a\u5bfc\u81f4-10\u7684\u51dd\u805a\u529b\u60e9\u7f5a\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a2\u5c42\u5976\u916a\uff1a+10\u98ce\u5473\uff1b3\u5c42\uff1a+15\u98ce\u5473\uff1b4\u5c42\uff1a+15\u98ce\u5473\uff0c-10\u51dd\u805a\u529b\u3002]"}, {"question": "\u54ea\u4e9b\u5e73\u53f0\u652f\u6301\u5377\u997c\u5de5\u574a\uff0c\u4ee5\u53ca\u5982\u4f55\u5728\u6211\u4e4b\u95f4\u8fc1\u79fb\u6211\u7684\u6e38\u620f\u8fdb\u5ea6\uff1f", "answer": "\u5377\u997c\u5de5\u574a\u652f\u6301PC\u3001Mac\u548cPlayStation\u3001Xbox\u7b49\u6e38\u620f\u673a\u3002\u8981\u8fc1\u79fb\u60a8\u7684\u6e38\u620f\u8fdb\u5ea6\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u767b\u5f55\u60a8\u5728\u539f\u59cb\u5e73\u53f0\u4e0a\u7684\u5e10\u6237\u3002\u6b65\u9aa42 - \u5bfc\u822a\u5230\u201c\u8d26\u6237\u8bbe\u7f6e\u201d\u5e76\u9009\u62e9\u201c\u5bfc\u51fa\u5b58\u6863\u6570\u636e\u201d\u3002\u6b65\u9aa43 - \u767b\u5f55\u60a8\u5728\u65b0\u5e73\u53f0\u4e0a\u7684\u5e10\u6237\u5e76\u5bfc\u5165\u5b58\u6863\u6570\u636e\u3002\u4f8b\u5982\uff0c\u60a8\u53ef\u4ee5\u5c06\u60a8\u7684\u5377\u997c\u98df\u8c31\u548c\u6210\u5c31\u4ecePC\u65e0\u7f1d\u5730\u8fc1\u79fb\u5230PlayStation\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u539f\u59cb\u5e73\u53f0\u2192\u5bfc\u51fa\u5b58\u6863\u6570\u636e\u2192\u65b0\u5e73\u53f0\u2192\u5bfc\u5165\u5b58\u6863\u6570\u636e\u2192\u6e38\u620f\u8fdb\u5ea6\u8fc1\u79fb\u3002]"}, {"question": "\u5377\u997c\u5de5\u574a\u91cc\u6709\u54ea\u4e9b\u9690\u85cf\u5f69\u86cb\uff0c\u4ee5\u53ca\u5982\u4f55\u53d1\u73b0\u5b83\u4eec\uff1f", "answer": "\u5377\u997c\u5de5\u574a\u4e2d\u5145\u6ee1\u4e86\u9690\u85cf\u5f69\u86cb\uff0c\u4f8b\u5982\u201c\u9ec4\u91d1\u9cc4\u68a8\u9171\u201d\u98df\u8c31\u3002\u8981\u53d1\u73b0\u5b83\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u8bbf\u95ee\u6e38\u620f\u4e2d\u5e02\u573a\u4e2d\u7684\u201c\u79d8\u5bc6\u98df\u6750\u201d\u5546\u5e97\u3002\u6b65\u9aa42 - \u4f7f\u7528500\u679a\u786c\u5e01\u8d2d\u4e70\u201c\u795e\u79d8\u9cc4\u68a8\u201d\u3002\u6b65\u9aa43 - \u4f7f\u7528\u9cc4\u68a8\u5236\u4f5c\u5377\u997c\uff0c\u89e3\u9501\u9ec4\u91d1\u9cc4\u68a8\u9171\u98df\u8c31\u3002\u4f8b\u5982\uff0c\u73a9\u5bb6\u53ef\u80fd\u4f1a\u901a\u8fc7\u5c1d\u8bd5\u7a00\u6709\u98df\u6750\u6765\u5076\u7136\u53d1\u73b0\u5b83\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5728\u5377\u997c\u5de5\u574a\u4e2d\u5bfb\u627e\u5f69\u86cb\u5c31\u50cf\u5728\u4e00\u4e2a\u5e7f\u9614\u7684\u70f9\u996a\u4e16\u754c\u4e2d\u53d1\u73b0\u9690\u85cf\u7684\u5b9d\u85cf\u3002]"}, {"question": "\u5982\u4f55\u5728\u5377\u997c\u5de5\u574a\u4e2d\u6709\u6548\u5730\u7ba1\u7406\u6211\u7684\u98df\u6750\u5e93\u5b58\uff0c\u907f\u514d\u77ed\u7f3a\uff1f", "answer": "\u8981\u5728\u5377\u997c\u5de5\u574a\u4e2d\u6709\u6548\u5730\u7ba1\u7406\u60a8\u7684\u98df\u6750\u5e93\u5b58\uff0c\u907f\u514d\u77ed\u7f3a\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u5b9a\u671f\u68c0\u67e5\u60a8\u7684\u5e93\u5b58\u6570\u91cf\uff0c\u65b9\u6cd5\u662f\u6309'I'\u952e\u3002\u6b65\u9aa42 - \u4f18\u5148\u8865\u5145\u9ad8\u9700\u6c42\u98df\u6750\uff0c\u4f8b\u5982\u7389\u7c73\u997c\u548c\u8c46\u7c7b\u3002\u6b65\u9aa43 - \u4f7f\u7528\u5e02\u573a\u4e2d\u7684\u201c\u81ea\u52a8\u8865\u7ed9\u201d\u529f\u80fd\u6765\u7ef4\u6301\u6700\u4f73\u5e93\u5b58\u6c34\u5e73\u3002\u4f8b\u5982\uff0c\u4e3a\u7389\u7c73\u997c\u8bbe\u7f6e\u81ea\u52a8\u8865\u7ed9\uff0c\u786e\u4fdd\u60a8\u5728\u5236\u4f5c\u8fc7\u7a0b\u4e2d\u6c38\u8fdc\u4e0d\u4f1a\u7528\u5b8c\u5b83\u4eec\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u7389\u7c73\u997c\uff1a\u81ea\u52a8\u8865\u7ed9\u91cf\u4e3a10\uff1b\u8c46\u7c7b\uff1a\u81ea\u52a8\u8865\u7ed9\u91cf\u4e3a15\uff1b\u5976\u916a\uff1a\u81ea\u52a8\u8865\u7ed9\u91cf\u4e3a20\u3002]"}, {"question": "\u98ce\u5473\u500d\u589e\u5668\u5728\u5377\u997c\u5de5\u574a\u4e2d\u4e3a\u4ec0\u4e48\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u5927\u5316\u5b83\uff1f", "answer": "\u5377\u997c\u5de5\u574a\u4e2d\u7684\u98ce\u5473\u500d\u589e\u5668\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u4f1a\u663e\u7740\u63d0\u5347\u60a8\u7684\u5377\u997c\u5206\u6570\u3002\u8981\u6700\u5927\u5316\u5b83\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u4f7f\u7528\u4e92\u8865\u7684\u98df\u6750\uff0c\u4f8b\u5982\u201c\u9752\u67e0\u82ab\u837d\u7c73\u996d\u201d\u4e0e\u201c\u9ed1\u8c46\u201d\u3002\u6b65\u9aa42 - \u6dfb\u52a0\u7279\u6b8a\u9171\u6599\uff0c\u4f8b\u5982\u201c\u8fa3\u756a\u8304\u9171\u201d\uff0c\u83b7\u5f97\u989d\u5916\u500d\u589e\u3002\u6b65\u9aa43 - \u907f\u514d\u6df7\u5408\u51b2\u7a81\u7684\u98ce\u5473\uff0c\u4f8b\u5982\u5c06\u201c\u751c\u7389\u7c73\u201d\u4e0e\u201c\u9178\u5976\u6cb9\u201d\u6df7\u5408\u3002\u4f8b\u5982\uff0c\u5c06\u9752\u67e0\u82ab\u837d\u7c73\u996d\u548c\u9ed1\u8c46\u7ed3\u5408\u8d77\u6765\u53ef\u4ee5\u4e3a\u60a8\u63d0\u4f9b2\u500d\u7684\u98ce\u5473\u500d\u589e\u5668\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u4e92\u8865\u98df\u6750\u53ef\u4ee5\u4f7f\u500d\u589e\u5668\u52a0\u500d\uff0c\u800c\u51b2\u7a81\u7684\u98ce\u5473\u5219\u53ef\u4ee5\u4f7f\u4e4b\u51cf\u534a\u3002]"}, {"question": "\u5377\u997c\u5de5\u574a\u4e2d\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u6709\u4ec0\u4e48\u4e3b\u8981\u533a\u522b\uff1f", "answer": "\u5377\u997c\u5de5\u574a\u4e2d\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u7684\u4e3b\u8981\u533a\u522b\u5728\u4e8e\uff1a\u5728\u5355\u4eba\u6a21\u5f0f\u4e2d\uff0c\u60a8\u4e13\u6ce8\u4e8e\u5b8c\u5584\u60a8\u7684\u5377\u997c\u98df\u8c31\u5e76\u83b7\u5f97\u9ad8\u5206\u3002\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u60a8\u53ef\u4ee5\u5728\u5b9e\u65f6\u5377\u997c\u5236\u4f5c\u6311\u6218\u4e2d\u4e0e\u4ed6\u4eba\u7ade\u4e89\u6216\u5408\u4f5c\u3002\u4f8b\u5982\uff0c\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u60a8\u53ef\u80fd\u4f1a\u53c2\u52a0\u201c\u901f\u5ea6\u5377\u997c\u201d\u6311\u6218\uff0c\u6700\u5feb\u3001\u6700\u7f8e\u5473\u7684\u5377\u997c\u83b7\u80dc\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5355\u4eba\u6a21\u5f0f\u5c31\u50cf\u4e00\u573a\u4e2a\u4eba\u70f9\u996a\u6bd4\u8d5b\uff0c\u800c\u591a\u4eba\u6a21\u5f0f\u5219\u662f\u4e00\u573a\u9ad8\u98ce\u9669\u7684\u70f9\u996a\u6218\u6597\u3002]"}, {"question": "\u5982\u4f55\u5728\u5377\u997c\u5de5\u574a\u4e2d\u89e3\u9501\u9ad8\u7ea7\u5236\u4f5c\u98df\u8c31\uff0c\u4ee5\u53ca\u5b83\u4eec\u6709\u4ec0\u4e48\u597d\u5904\uff1f", "answer": "\u8981\u89e3\u9501\u5377\u997c\u5de5\u574a\u4e2d\u7684\u9ad8\u7ea7\u5236\u4f5c\u98df\u8c31\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u5b8c\u6210\u201c\u5927\u5e08\u53a8\u5e08\u201d\u4efb\u52a1\u7ebf\u3002\u6b65\u9aa42 - \u4ece\u7279\u6b8a\u6d3b\u52a8\u4e2d\u6536\u96c6\u7a00\u6709\u98df\u6750\u3002\u6b65\u9aa43 - \u4ece\u6e38\u620f\u4e2d\u5546\u5e97\u8d2d\u4e70\u98df\u8c31\u4e66\u3002\u8fd9\u4e9b\u9ad8\u7ea7\u98df\u8c31\u63d0\u4f9b\u72ec\u7279\u7684\u597d\u5904\uff0c\u4f8b\u5982\u66f4\u9ad8\u7684\u5206\u6570\u548c\u7279\u6b8a\u6548\u679c\u3002\u4f8b\u5982\uff0c\u201c\u706b\u5c71\u5377\u997c\u201d\u98df\u8c31\u5728\u6536\u96c6\u4e86\u201c\u7194\u5ca9\u5976\u916a\u201d\u548c\u201c\u5730\u72f1\u9171\u201d\u540e\u89e3\u9501\uff0c\u63d0\u4f9b+50\u7684\u5206\u6570\u5956\u52b1\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u706b\u5c71\u5377\u997c\uff1a+50\u5206\u6570\uff1b\u5730\u72f1\u9171\uff1a+20\u98ce\u5473\u500d\u589e\u5668\uff1b\u7194\u5ca9\u5976\u916a\uff1a+15\u51dd\u805a\u529b\u3002]"}, {"question": "\u5377\u997c\u5de5\u574a\u4e2d\u201c\u5377\u997c\u5927\u5e08\u201d\u6210\u5c31\u7684\u610f\u4e49\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5982\u4f55\u83b7\u5f97\u5b83\uff1f", "answer": "\u5377\u997c\u5de5\u574a\u4e2d\u7684\u201c\u5377\u997c\u5927\u5e08\u201d\u6210\u5c31\u6807\u5fd7\u7740\u60a8\u5df2\u7ecf\u638c\u63e1\u4e86\u5377\u997c\u5236\u4f5c\u7684\u827a\u672f\u3002\u8981\u83b7\u5f97\u5b83\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u5236\u4f5c\u81f3\u5c11100\u79cd\u72ec\u7279\u7684\u5377\u997c\u98df\u8c31\u3002\u6b65\u9aa42 - \u5728\u6240\u6709\u5377\u997c\u4e2d\u83b7\u5f9710,000\u5206\u7684\u603b\u5206\u6570\u3002\u6b65\u9aa43 - \u89e3\u9501\u6240\u6709\u7279\u6b8a\u98df\u6750\u548c\u9171\u6599\u3002\u4f8b\u5982\uff0c\u73a9\u5bb6\u53ef\u80fd\u4f1a\u901a\u8fc7\u6301\u7eed\u5236\u4f5c\u9ad8\u5206\u5377\u997c\u5e76\u5c1d\u8bd5\u7a00\u6709\u98df\u6750\u6765\u83b7\u5f97\u5b83\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u83b7\u5f97\u201c\u5377\u997c\u5927\u5e08\u201d\u6210\u5c31\u5c31\u50cf\u4ece\u70f9\u996a\u5b66\u6821\u4ee5\u4f18\u5f02\u6210\u7ee9\u6bd5\u4e1a\u3002]"}]
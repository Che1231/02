[{"question": "\u65b0\u624b\u5165\u95e8\uff1aBurrito Craft\u600e\u4e48\u5feb\u901f\u4e0a\u624b\uff1f\u6709\u54ea\u4e9b\u57fa\u7840\u64cd\u4f5c\u662f\u5fc5\u987b\u638c\u63e1\u7684\uff1f", "answer": "Burrito Craft\u4e0a\u624b\u975e\u5e38\u7b80\u5355\uff01\u4f60\u9700\u8981\u5148\u719f\u6089\u98df\u6750\u7684\u83b7\u53d6\uff0c\u4f8b\u5982\u5728\u519c\u573a\u79cd\u690d\u756a\u8304\uff0c\u6216\u8005\u5728\u5546\u5e97\u8d2d\u4e70\u8089\u7c7b\u3002\u7136\u540e\uff0c\u5728\u53a8\u623f\u4f7f\u7528\u70f9\u996a\u53f0\uff0c\u6839\u636e\u98df\u8c31\u5c06\u98df\u6750\u7ec4\u5408\u6210\u7f8e\u5473\u7684\u58a8\u897f\u54e5\u5377\u997c\u3002\u57fa\u7840\u64cd\u4f5c\u5305\u62ec\uff1a\u79fb\u52a8\u89d2\u8272\u3001\u91c7\u96c6\u98df\u6750\u3001\u70f9\u996a\u5377\u997c\u548c\u51fa\u552e\u5377\u997c\u3002\u521d\u671f\u5efa\u8bae\u591a\u5236\u4f5c\u725b\u8089\u5377\u997c\uff0c\u6210\u672c\u4f4e\u4e14\u53d7\u6b22\u8fce\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u70f9\u996a\u53f0\u5c31\u50cf\u4f60\u7684\u9b54\u6cd5\u5de5\u4f5c\u53f0\uff0c\u5408\u7406\u642d\u914d\u98df\u6750\u5c31\u80fd\u5236\u9020\u51fa\u5947\u8ff9\uff01]"}, {"question": "Burrito Craft\u4e2d\uff0c\u5982\u4f55\u63d0\u5347\u5377\u997c\u7684\u54c1\u8d28\uff1f\u9ad8\u54c1\u8d28\u5377\u997c\u5bf9\u6536\u76ca\u6709\u4ec0\u4e48\u5f71\u54cd\uff1f", "answer": "\u60f3\u8981\u5236\u4f5c\u9ad8\u54c1\u8d28\u7684\u5377\u997c\uff0c\u9700\u8981\u6ce8\u610f\u4ee5\u4e0b\u51e0\u70b9\uff1a1.\u9009\u62e9\u65b0\u9c9c\u7684\u98df\u6750\uff0c\u53ef\u4ee5\u901a\u8fc7\u5347\u7ea7\u519c\u573a\u6765\u63d0\u9ad8\u98df\u6750\u54c1\u8d28\u30022.\u5347\u7ea7\u70f9\u996a\u53f0\uff0c\u9ad8\u7ea7\u70f9\u996a\u53f0\u53ef\u4ee5\u89e3\u9501\u65b0\u7684\u70f9\u996a\u6280\u5de7\u30023.\u638c\u63e1\u98df\u8c31\uff0c\u4e0d\u540c\u7684\u98df\u6750\u642d\u914d\u4f1a\u5f71\u54cd\u5377\u997c\u7684\u5c5e\u6027\u3002\u9ad8\u54c1\u8d28\u5377\u997c\u552e\u4ef7\u66f4\u9ad8\uff0c\u5e76\u4e14\u66f4\u5bb9\u6613\u5438\u5f15\u987e\u5ba2\uff0c\u63d0\u5347\u5e97\u94fa\u7684\u58f0\u671b\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u666e\u901a\u756a\u8304vs\u9ad8\u7ea7\u756a\u8304\uff0c\u552e\u4ef7\u5dee\u5f02\u4e00\u89c8\u8868]"}, {"question": "BC\u5377\u997c\u5e97\u7684\u58f0\u671b\u503c\u6709\u4ec0\u4e48\u4f5c\u7528\uff1f\u5982\u4f55\u5feb\u901f\u63d0\u9ad8\u58f0\u671b\u7b49\u7ea7\uff1f", "answer": "\u58f0\u671b\u503c\u4ee3\u8868\u4e86\u4f60\u7684\u5377\u997c\u5e97\u5728\u6e38\u620f\u4e2d\u53d7\u6b22\u8fce\u7684\u7a0b\u5ea6\u3002\u63d0\u9ad8\u58f0\u671b\u7b49\u7ea7\u53ef\u4ee5\u89e3\u9501\u65b0\u7684\u98df\u6750\u3001\u98df\u8c31\u548c\u5e97\u94fa\u88c5\u9970\u3002\u5feb\u901f\u63d0\u9ad8\u58f0\u671b\u7684\u65b9\u6cd5\u5305\u62ec\uff1a1.\u5b8c\u6210\u6bcf\u65e5\u4efb\u52a1\uff0c\u83b7\u5f97\u4e30\u539a\u58f0\u671b\u5956\u52b1\u30022.\u51fa\u552e\u9ad8\u54c1\u8d28\u7684\u5377\u997c\uff0c\u987e\u5ba2\u6ee1\u610f\u5ea6\u8d8a\u9ad8\uff0c\u83b7\u5f97\u7684\u58f0\u671b\u4e5f\u8d8a\u591a\u30023.\u53c2\u4e0e\u6e38\u620f\u6d3b\u52a8\uff0c\u4f8b\u5982\u5377\u997c\u5927\u8d5b\uff0c\u83b7\u5f97\u4e30\u5bcc\u7684\u58f0\u671b\u5956\u52b1\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u58f0\u671b\u63d0\u5347\u6d41\u7a0b\u56fe\uff0c\u5305\u542b\u4efb\u52a1\u3001\u5546\u54c1\u54c1\u8d28\u3001\u6d3b\u52a8\u4e09\u4e2a\u4e3b\u8981\u5206\u652f]"}, {"question": "Burrito Craft\u4e2d\uff0c\u4e0d\u540c\u7c7b\u578b\u7684\u987e\u5ba2\u6709\u4ec0\u4e48\u504f\u597d\uff1f\u5982\u4f55\u6839\u636e\u987e\u5ba2\u559c\u597d\u8c03\u6574\u5377\u997c\u914d\u65b9\uff1f", "answer": "\u6e38\u620f\u4e2d\u987e\u5ba2\u53e3\u5473\u5404\u5f02\u3002\u4f8b\u5982\uff0c\u4e00\u4e9b\u987e\u5ba2\u559c\u6b22\u8fa3\u5473\u5377\u997c\uff0c\u4e00\u4e9b\u5219\u559c\u6b22\u6e05\u6de1\u53e3\u5473\u3002\u53ef\u4ee5\u901a\u8fc7\u89c2\u5bdf\u987e\u5ba2\u7684\u8868\u60c5\u548c\u5bf9\u8bdd\u6765\u4e86\u89e3\u4ed6\u4eec\u7684\u559c\u597d\u3002\u8c03\u6574\u5377\u997c\u914d\u65b9\u65f6\uff0c\u53ef\u4ee5\u5c1d\u8bd5\u6dfb\u52a0\u4e0d\u540c\u7684\u8c03\u5473\u6599\uff0c\u4f8b\u5982\u8fa3\u6912\u3001\u9999\u83dc\u6216\u5976\u916a\u3002\u8bb0\u4f4f\uff0c\u6ee1\u8db3\u987e\u5ba2\u53e3\u5473\u624d\u80fd\u83b7\u5f97\u66f4\u9ad8\u7684\u6536\u76ca\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u8fa3\u5473\u5377\u997c\u914d\u65b9 vs \u6e05\u6de1\u5377\u997c\u914d\u65b9]"}, {"question": "\u4e2d\u540e\u671f\u5982\u4f55\u5b9e\u73b0Burrito Craft\u5377\u997c\u5e97\u7684\u81ea\u52a8\u5316\u7ecf\u8425\uff1f\u6709\u54ea\u4e9b\u5efa\u7b51\u6216\u9053\u5177\u53ef\u4ee5\u8f85\u52a9\uff1f", "answer": "Burrito Craft\u4e2d\u540e\u671f\uff0c\u53ef\u4ee5\u901a\u8fc7\u4ee5\u4e0b\u65b9\u6cd5\u5b9e\u73b0\u81ea\u52a8\u5316\u7ecf\u8425\uff1a\u6b65\u9aa41\uff1a\u5347\u7ea7\u4f60\u7684\u53a8\u623f\uff0c\u89e3\u9501\u81ea\u52a8\u5316\u70f9\u996a\u53f0\uff0c\u5b83\u53ef\u4ee5\u81ea\u52a8\u5236\u4f5c\u5377\u997c\u3002\u6b65\u9aa42\uff1a\u96c7\u4f63\u5458\u5de5\uff0c\u8ba9\u4ed6\u4eec\u8d1f\u8d23\u6536\u94f6\u548c\u6e05\u6d01\u5de5\u4f5c\u3002\u6b65\u9aa43\uff1a\u8d2d\u4e70\u81ea\u52a8\u552e\u8d27\u673a\uff0c\u5b83\u53ef\u4ee5\u81ea\u52a8\u51fa\u552e\u5377\u997c\u3002\u6b64\u5916\uff0c\u8fd8\u53ef\u4ee5\u8d2d\u4e70\u98df\u6750\u50a8\u5b58\u5668\uff0c\u81ea\u52a8\u50a8\u5b58\u98df\u6750\uff0c\u907f\u514d\u6d6a\u8d39\u3002[\u6e38\u620f\u5185\u793a\u4f8b\uff1a\u5728\u5546\u5e97\u8d2d\u4e70\u201c\u81ea\u52a8\u70f9\u996a\u53f0\u201d\uff0c\u5373\u53ef\u4f53\u9a8c\u81ea\u52a8\u5316\u751f\u4ea7\u3002]"}, {"question": "Burrito Craft\u4e2d\uff0c\u662f\u5426\u5b58\u5728\u9690\u85cf\u7684\u98df\u8c31\uff1f\u5982\u4f55\u624d\u80fd\u89e3\u9501\u8fd9\u4e9b\u795e\u79d8\u914d\u65b9\uff1f", "answer": "\u662f\u7684\uff0cBurrito Craft\u4e2d\u5b58\u5728\u4e00\u4e9b\u9690\u85cf\u98df\u8c31\u3002\u8fd9\u4e9b\u98df\u8c31\u901a\u5e38\u9700\u8981\u7279\u5b9a\u6761\u4ef6\u624d\u80fd\u89e3\u9501\u3002\u4f8b\u5982\uff0c\u5b8c\u6210\u4e00\u7cfb\u5217\u7279\u6b8a\u4efb\u52a1\uff0c\u6216\u6536\u96c6\u7279\u5b9a\u7684\u98df\u6750\u3002\u6709\u4e9b\u9690\u85cf\u98df\u8c31\u7684\u89e3\u9501\u65b9\u5f0f\u975e\u5e38\u9690\u853d\uff0c\u9700\u8981\u73a9\u5bb6\u4ed4\u7ec6\u63a2\u7d22\u6e38\u620f\u4e16\u754c\u3002\u63d0\u793a\uff1a\u7559\u610f\u6e38\u620f\u4e2d\u7684NPC\u5bf9\u8bdd\uff0c\u4ed6\u4eec\u53ef\u80fd\u4f1a\u900f\u9732\u4e00\u4e9b\u7ebf\u7d22\u3002[\u5f69\u86cb\u6316\u6398\uff1a\u5c1d\u8bd5\u5728\u7279\u5b9a\u65f6\u95f4\u70f9\u996a\u7279\u5b9a\u98df\u6750\u7ec4\u5408\uff0c\u53ef\u80fd\u4f1a\u89e6\u53d1\u9690\u85cf\u98df\u8c31\uff01]"}, {"question": "Burrito Craft\u7684\u6570\u503c\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f\u98df\u6750\u54c1\u8d28\u3001\u70f9\u996a\u6280\u5de7\u5bf9\u6700\u7ec8\u7684\u5377\u997c\u5c5e\u6027\u6709\u4ec0\u4e48\u5f71\u54cd\uff1f", "answer": "Burrito Craft\u7684\u6570\u503c\u7cfb\u7edf\u76f8\u5bf9\u590d\u6742\uff0c\u4f46\u53ef\u4ee5\u901a\u8fc7\u7b80\u5355\u7684\u65b9\u5f0f\u7406\u89e3\u3002\u98df\u6750\u7684\u54c1\u8d28\u76f4\u63a5\u5f71\u54cd\u5377\u997c\u7684\u57fa\u7840\u5c5e\u6027\uff0c\u4f8b\u5982\u98ce\u5473\u503c\u548c\u9971\u8179\u611f\u3002\u70f9\u996a\u6280\u5de7\u5219\u4f1a\u5f71\u54cd\u5377\u997c\u7684\u9644\u52a0\u5c5e\u6027\uff0c\u4f8b\u5982\u53e3\u611f\u548c\u5916\u89c2\u3002\u4e0d\u540c\u7684\u98df\u6750\u642d\u914d\u4f1a\u4ea7\u751f\u4e0d\u540c\u7684\u5316\u5b66\u53cd\u5e94\uff0c\u4ece\u800c\u5f71\u54cd\u5377\u997c\u7684\u6700\u7ec8\u5c5e\u6027\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u53ef\u4ee5\u5c06\u98df\u6750\u7684\u54c1\u8d28\u770b\u4f5c\u662f\u5377\u997c\u7684\u201c\u57fa\u7840\u201d\uff0c\u70f9\u996a\u6280\u5de7\u5219\u662f\u201c\u88c5\u9970\u201d\uff0c\u4e24\u8005\u5171\u540c\u51b3\u5b9a\u4e86\u5377\u997c\u7684\u4ef7\u503c\uff01]"}, {"question": "\u6df1\u6316\uff1aBurrito Craft\u7684\u5e97\u94fa\u5347\u7ea7\u7cfb\u7edf\u6709\u54ea\u4e9b\u5206\u652f\uff1f\u4e0d\u540c\u5347\u7ea7\u8def\u7ebf\u5bf9\u7ecf\u8425\u7b56\u7565\u6709\u4ec0\u4e48\u5f71\u54cd\uff1f", "answer": "\u5e97\u94fa\u5347\u7ea7\u7cfb\u7edf\u4e3b\u8981\u6709\u4e09\u4e2a\u5206\u652f\uff1a\u53a8\u623f\u5347\u7ea7\u3001\u519c\u573a\u5347\u7ea7\u548c\u5e97\u94fa\u5916\u89c2\u5347\u7ea7\u3002\u53a8\u623f\u5347\u7ea7\u53ef\u4ee5\u89e3\u9501\u65b0\u7684\u70f9\u996a\u6280\u5de7\u548c\u81ea\u52a8\u5316\u8bbe\u5907\uff0c\u63d0\u9ad8\u751f\u4ea7\u6548\u7387\u3002\u519c\u573a\u5347\u7ea7\u53ef\u4ee5\u63d0\u9ad8\u98df\u6750\u4ea7\u91cf\u548c\u54c1\u8d28\uff0c\u964d\u4f4e\u6210\u672c\u3002\u5e97\u94fa\u5916\u89c2\u5347\u7ea7\u53ef\u4ee5\u5438\u5f15\u66f4\u591a\u987e\u5ba2\uff0c\u63d0\u9ad8\u5ba2\u5355\u4ef7\u3002\u6839\u636e\u81ea\u5df1\u7684\u7ecf\u8425\u7b56\u7565\uff0c\u53ef\u4ee5\u9009\u62e9\u4e0d\u540c\u7684\u5347\u7ea7\u8def\u7ebf\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u5e97\u94fa\u5347\u7ea7\u8def\u7ebf\u56fe\uff0c\u5305\u542b\u53a8\u623f\u3001\u519c\u573a\u3001\u5916\u89c2\u4e09\u4e2a\u5206\u652f\uff0c\u4ee5\u53ca\u5404\u4e2a\u5206\u652f\u7684\u5347\u7ea7\u6548\u679c\u3002]"}, {"question": "Burrito Craft\u6709\u6ca1\u6709\u8ba1\u5212\u63a8\u51fa\u79fb\u52a8\u7248\u672c\uff1f\u5982\u679c\u63a8\u51fa\uff0cPC\u7248\u7684\u6570\u636e\u53ef\u4ee5\u8fc1\u79fb\u5230\u79fb\u52a8\u7aef\u5417\uff1f", "answer": "\u76ee\u524dBurrito Craft\u7684\u5b98\u65b9\u5c1a\u672a\u660e\u786e\u516c\u5e03\u63a8\u51fa\u79fb\u52a8\u7248\u672c\u7684\u8ba1\u5212\uff0c\u4f46\u5f00\u53d1\u8005\u4e00\u76f4\u5728\u79ef\u6781\u6536\u96c6\u73a9\u5bb6\u53cd\u9988\uff0c\u5e76\u8bc4\u4f30\u79fb\u52a8\u7248\u672c\u7684\u53ef\u884c\u6027\u3002\u5982\u679c\u63a8\u51fa\u79fb\u52a8\u7248\u672c\uff0c\u8003\u8651\u5230\u73a9\u5bb6\u7684\u6570\u636e\u4fdd\u5b58\u9700\u6c42\uff0c\u5f00\u53d1\u8005\u53ef\u80fd\u4f1a\u63d0\u4f9b\u6570\u636e\u8fc1\u79fb\u529f\u80fd\uff0c\u65b9\u4fbf\u73a9\u5bb6\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u540c\u6b65\u6e38\u620f\u8fdb\u5ea6\u3002\u4f46\u5177\u4f53\u65b9\u6848\u4ecd\u9700\u7b49\u5f85\u5b98\u65b9\u6b63\u5f0f\u516c\u544a\u3002[\u5efa\u8bae\uff1a\u5173\u6ce8Burrito Craft\u5b98\u65b9\u793e\u533a\uff0c\u7b2c\u4e00\u65f6\u95f4\u83b7\u53d6\u6700\u65b0\u6d88\u606f\uff01]"}, {"question": "\u6210\u5c31\u515a\u5fc5\u770b\uff1aBurrito Craft\u6709\u54ea\u4e9b\u9c9c\u4e3a\u4eba\u77e5\u7684\u9690\u85cf\u6210\u5c31\uff1f\u5982\u4f55\u8fbe\u6210\u8fd9\u4e9b\u6210\u5c31\u89e3\u9501\u7279\u6b8a\u5956\u52b1\uff1f", "answer": "Burrito Craft\u4e2d\u9690\u85cf\u7740\u4e00\u4e9b\u975e\u5e38\u6709\u8da3\u7684\u6210\u5c31\uff0c\u4f8b\u5982\u201c\u5377\u997c\u5927\u5e08\u201d\u3001\u201c\u7f8e\u98df\u8bc4\u8bba\u5bb6\u201d\u548c\u201c\u519c\u573a\u4e3b\u201d\u3002\u8fd9\u4e9b\u6210\u5c31\u901a\u5e38\u9700\u8981\u5b8c\u6210\u4e00\u4e9b\u7279\u6b8a\u6311\u6218\u624d\u80fd\u89e3\u9501\u3002\u4f8b\u5982\uff0c\u201c\u5377\u997c\u5927\u5e08\u201d\u53ef\u80fd\u9700\u8981\u5236\u4f5c\u6240\u6709\u7c7b\u578b\u7684\u5377\u997c\uff0c\u201c\u7f8e\u98df\u8bc4\u8bba\u5bb6\u201d\u53ef\u80fd\u9700\u8981\u83b7\u5f97\u6240\u6709\u987e\u5ba2\u7684\u597d\u8bc4\uff0c\u201c\u519c\u573a\u4e3b\u201d\u53ef\u80fd\u9700\u8981\u79cd\u690d\u6240\u6709\u7c7b\u578b\u7684\u98df\u6750\u3002\u89e3\u9501\u8fd9\u4e9b\u6210\u5c31\u540e\uff0c\u53ef\u4ee5\u83b7\u5f97\u7279\u6b8a\u7684\u5956\u52b1\uff0c\u4f8b\u5982\u7a00\u6709\u7684\u98df\u6750\u548c\u88c5\u9970\u54c1\u3002[\u6e38\u620f\u5185\u793a\u4f8b\uff1a\u5c1d\u8bd5\u8fde\u7eed\u4e09\u5929\u5236\u4f5c\u540c\u4e00\u79cd\u5377\u997c\uff0c\u53ef\u80fd\u4f1a\u89e6\u53d1\u201c\u5377\u997c\u4e13\u6ce8\u8005\u201d\u6210\u5c31\uff01]"}]
[{"question": "\ucd08\ubcf4\uc790 \uc548\ub0b4: Burrito Craft\ub97c \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc774\uba70, \ud544\uc218\uc801\uc73c\ub85c \uc219\ub2ec\ud574\uc57c \ud560 \uae30\ubcf8 \uc870\uc791\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Burrito Craft\ub294 \uc2dc\uc791\ud558\uae30 \ub9e4\uc6b0 \uc27d\uc2b5\ub2c8\ub2e4! \uba3c\uc800 \ub18d\uc7a5\uc5d0\uc11c \ud1a0\ub9c8\ud1a0\ub97c \uc7ac\ubc30\ud558\uac70\ub098 \uc0c1\uc810\uc5d0\uc11c \uace0\uae30\ub97c \uad6c\uc785\ud558\ub294 \ub4f1 \uc7ac\ub8cc \ud68d\ub4dd\uc5d0 \uc775\uc219\ud574\uc838\uc57c \ud569\ub2c8\ub2e4. \uadf8\ub7f0 \ub2e4\uc74c \uc8fc\ubc29\uc5d0\uc11c \uc694\ub9ac\ub300\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub808\uc2dc\ud53c\uc5d0 \ub530\ub77c \uc7ac\ub8cc\ub97c \uacb0\ud569\ud558\uc5ec \ub9db\uc788\ub294 \uba55\uc2dc\uce78 \ud018\uc0ac\ub514\uc57c\ub97c \ub9cc\ub4e4\uc5b4\uc57c \ud569\ub2c8\ub2e4. \uae30\ubcf8 \uc870\uc791\uc5d0\ub294 \uce90\ub9ad\ud130 \uc774\ub3d9, \uc7ac\ub8cc \uc218\uc9d1, \ud018\uc0ac\ub514\uc57c \uc694\ub9ac \ubc0f \ud310\ub9e4\uac00 \ud3ec\ud568\ub429\ub2c8\ub2e4. \ucd08\uae30\uc5d0\ub294 \uc800\ub834\ud558\uace0 \uc778\uae30\uac00 \ub9ce\uc740 \uc18c\uace0\uae30 \ud018\uc0ac\ub514\uc57c\ub97c \ub9ce\uc774 \ub9cc\ub4e4 \uac83\uc744 \uad8c\uc7a5\ud569\ub2c8\ub2e4.[\ube44\uc720 \uc124\uba85: \uc694\ub9ac\ub300\ub294 \ub9c8\uce58 \ub9c8\ubc95\uc758 \uc791\uc5c5\ub300\uc640 \uac19\uc73c\uba70, \uc7ac\ub8cc\ub97c \uc801\uc808\ud788 \uc870\ud569\ud558\uba74 \uae30\uc801\uc744 \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4!] "}, {"question": "Burrito Craft\uc5d0\uc11c \ud018\uc0ac\ub514\uc57c\uc758 \ud488\uc9c8\uc744 \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\ub098\uc694? \uace0\ud488\uc9c8 \ud018\uc0ac\ub514\uc57c\ub294 \uc218\uc775\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "\uace0\ud488\uc9c8 \ud018\uc0ac\ub514\uc57c\ub97c \ub9cc\ub4e4\ub824\uba74 \ub2e4\uc74c\uacfc \uac19\uc740 \uc810\uc5d0 \uc720\uc758\ud574\uc57c \ud569\ub2c8\ub2e4: 1. \uc2e0\uc120\ud55c \uc7ac\ub8cc\ub97c \uc120\ud0dd\ud558\uc5ec \ub18d\uc7a5\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc5ec \uc7ac\ub8cc \ud488\uc9c8\uc744 \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. 2. \ub354 \uace0\uae09 \uc694\ub9ac\ub300\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc5ec \uc0c8\ub85c\uc6b4 \uc694\ub9ac \uae30\uc220\uc744 \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 3. \ub808\uc2dc\ud53c\ub97c \uc219\ub2ec\ud558\uc5ec \uc11c\ub85c \ub2e4\ub978 \uc7ac\ub8cc\uc758 \uc870\ud569\uc774 \ud018\uc0ac\ub514\uc57c\uc758 \uc18d\uc131\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uace0\ud488\uc9c8 \ud018\uc0ac\ub514\uc57c\ub294 \uac00\uaca9\uc774 \ub354 \ub192\uace0 \uace0\uac1d\uc744 \ub354 \uc27d\uac8c \uc720\uc778\ud558\uc5ec \uc0c1\uc810\uc758 \uba85\uc131\uc744 \ub192\uc785\ub2c8\ub2e4.[\uad6c\uc131 \ube44\uad50\ud45c: \uc77c\ubc18 \ud1a0\ub9c8\ud1a0 \ub300 \uace0\uae09 \ud1a0\ub9c8\ud1a0, \uac00\uaca9 \ucc28\uc774 \uc77c\ub78c\ud45c]"}, {"question": "BC \ud018\uc0ac\ub514\uc57c \uac00\uac8c\uc758 \uba85\uc131 \uc810\uc218\ub294 \uc5b4\ub5a4 \uc5ed\ud560\uc744 \ud558\ub098\uc694? \uba85\uc131 \ub808\ubca8\uc744 \ube60\ub974\uac8c \ub192\uc774\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uba85\uc131 \uc810\uc218\ub294 \uac8c\uc784 \ub0b4\uc5d0\uc11c \uadc0\ud558\uc758 \ud018\uc0ac\ub514\uc57c \uac00\uac8c\uc758 \uc778\uae30\ub97c \ub098\ud0c0\ub0c5\ub2c8\ub2e4. \uba85\uc131 \ub808\ubca8\uc744 \ub192\uc774\uba74 \uc0c8\ub85c\uc6b4 \uc7ac\ub8cc, \ub808\uc2dc\ud53c \ubc0f \uac00\uac8c \uc7a5\uc2dd\uc744 \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uba85\uc131\uc744 \ube60\ub974\uac8c \ub192\uc774\ub294 \ubc29\ubc95\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: 1. \ub9e4\uc77c \ubbf8\uc158\uc744 \uc644\ub8cc\ud558\uc5ec \ub9ce\uc740 \uba85\uc131 \ubcf4\uc0c1\uc744 \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 2. \uace0\ud488\uc9c8 \ud018\uc0ac\ub514\uc57c\ub97c \ud310\ub9e4\ud558\uc5ec \uace0\uac1d \ub9cc\uc871\ub3c4\uac00 \ub192\uc744\uc218\ub85d \uc5bb\ub294 \uba85\uc131\ub3c4 \ub9ce\uc544\uc9d1\ub2c8\ub2e4. 3. \ud018\uc0ac\ub514\uc57c \ub300\ud68c\uc640 \uac19\uc740 \uac8c\uc784 \ub0b4 \uc774\ubca4\ud2b8\uc5d0 \ucc38\uc5ec\ud558\uc5ec \ud48d\uc871\ud55c \uba85\uc131 \ubcf4\uc0c1\uc744 \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uba85\uc131 \ud5a5\uc0c1 \ud750\ub984\ub3c4, \ubbf8\uc158, \uc0c1\ud488 \ud488\uc9c8, \uc774\ubca4\ud2b8 \uc138 \uac00\uc9c0 \uc8fc\uc694 \ubd84\uae30 \ud3ec\ud568]"}, {"question": "Burrito Craft\uc5d0\uc11c \uace0\uac1d \uc720\ud615\uc740 \uc5b4\ub5a4 \uc120\ud638\ub3c4\ub97c \uac00\uc9c0\uace0 \uc788\ub098\uc694? \uace0\uac1d \uc120\ud638\ub3c4\uc5d0 \ub530\ub77c \ud018\uc0ac\ub514\uc57c \ub808\uc2dc\ud53c\ub97c \uc5b4\ub5bb\uac8c \uc870\uc815\ud574\uc57c \ud558\ub098\uc694?", "answer": "\uac8c\uc784 \ub0b4 \uace0\uac1d\ub4e4\uc740 \ub2e4\uc591\ud55c \ucde8\ud5a5\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc77c\ubd80 \uace0\uac1d\uc740 \ub9e4\uc6b4 \ud018\uc0ac\ub514\uc57c\ub97c \uc88b\uc544\ud558\uc9c0\ub9cc, \uc77c\ubd80\ub294 \uc21c\ud55c \ub9db\uc744 \uc88b\uc544\ud569\ub2c8\ub2e4. \uace0\uac1d\uc758 \ud45c\uc815\uacfc \ub300\ud654\ub97c \ud1b5\ud574 \uadf8\ub4e4\uc758 \ucde8\ud5a5\uc744 \ud30c\uc545\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud018\uc0ac\ub514\uc57c \ub808\uc2dc\ud53c\ub97c \uc870\uc815\ud560 \ub54c\ub294 \uace0\ucd94, \ud30c\uc2ac\ub9ac \ub610\ub294 \uce58\uc988\uc640 \uac19\uc740 \ub2e4\uc591\ud55c \uc591\ub150\uc744 \ucd94\uac00\ud574 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uae30\uc5b5\ud558\uc138\uc694, \uace0\uac1d\uc758 \ucde8\ud5a5\uc744 \ucda9\uc871\uc2dc\ucf1c\uc57c \ub354 \ub192\uc740 \uc218\uc775\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.[\ub2e4\uc911 \ubc29\uc548 \ube44\uad50: \ub9e4\uc6b4 \ud018\uc0ac\ub514\uc57c \ub808\uc2dc\ud53c \ub300 \uc21c\ud55c \ub9db \ud018\uc0ac\ub514\uc57c \ub808\uc2dc\ud53c]"}, {"question": "\ud6c4\ubc18\ubd80\uc5d0 Burrito Craft \ud018\uc0ac\ub514\uc57c \uac00\uac8c\ub97c \uc790\ub3d9\ud654 \uc6b4\uc601\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694? \uc5b4\ub5a4 \uac74\ubb3c\uc774\ub098 \uc544\uc774\ud15c\uc774 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\ub098\uc694?", "answer": "Burrito Craft \ud6c4\ubc18\ubd80\uc5d0\uc11c \uc790\ub3d9\ud654 \uc6b4\uc601\uc744 \uc704\ud55c \ubc29\ubc95\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: STEP1: \uc8fc\ubc29\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc5ec \uc790\ub3d9\ud654 \uc694\ub9ac\ub300\ub97c \uc7a0\uae08 \ud574\uc81c\ud558\uba74 \ud018\uc0ac\ub514\uc57c\ub97c \uc790\ub3d9\uc73c\ub85c \uc81c\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP2: \uc9c1\uc6d0\uc744 \uace0\uc6a9\ud558\uc5ec \uacc4\uc0b0 \ubc0f \uccad\uc18c \uc791\uc5c5\uc744 \ub2f4\ub2f9\ud558\ub3c4\ub85d \ud569\ub2c8\ub2e4. STEP3: \uc790\ub3d9 \ud310\ub9e4\uae30\ub97c \uad6c\uc785\ud558\uba74 \ud018\uc0ac\ub514\uc57c\ub97c \uc790\ub3d9\uc73c\ub85c \ud310\ub9e4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \uc7ac\ub8cc \ubcf4\uad00\ud568\uc744 \uad6c\uc785\ud558\uc5ec \uc7ac\ub8cc\ub97c \uc790\ub3d9\uc73c\ub85c \ubcf4\uad00\ud558\uace0 \ub0ad\ube44\ub97c \uc904\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4.[\uac8c\uc784 \ub0b4 \uc608\uc2dc: \uc0c1\uc810\uc5d0\uc11c \"\uc790\ub3d9 \uc694\ub9ac\ub300\"\ub97c \uad6c\ub9e4\ud558\uba74 \uc790\ub3d9 \uc0dd\uc0b0\uc744 \uacbd\ud5d8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "Burrito Craft\uc5d0 \uc228\uaca8\uc9c4 \ub808\uc2dc\ud53c\uac00 \uc788\ub098\uc694? \uc774\ub7ec\ud55c \uc2e0\ube44\ud55c \ub808\uc2dc\ud53c\ub97c \uc5b4\ub5bb\uac8c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub124, Burrito Craft\uc5d0\ub294 \uc228\uaca8\uc9c4 \ub808\uc2dc\ud53c\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ub808\uc2dc\ud53c\ub294 \uc77c\ubc18\uc801\uc73c\ub85c \ud2b9\uc815 \uc870\uac74\uc744 \ucda9\uc871\ud574\uc57c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc77c\ub828\uc758 \ud2b9\ubcc4\ud55c \ubbf8\uc158\uc744 \uc644\ub8cc\ud558\uac70\ub098 \ud2b9\uc815 \uc7ac\ub8cc\ub97c \uc218\uc9d1\ud574\uc57c \ud560 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. \uc77c\ubd80 \uc228\uaca8\uc9c4 \ub808\uc2dc\ud53c\uc758 \uc7a0\uae08 \ud574\uc81c \ubc29\ubc95\uc740 \ub9e4\uc6b0 \uc740\ubc00\ud558\uba70, \ud50c\ub808\uc774\uc5b4\uac00 \uac8c\uc784 \uc138\uacc4\ub97c \uc790\uc138\ud788 \ud0d0\uc0c9\ud574\uc57c \ud569\ub2c8\ub2e4. \ud301: \uac8c\uc784 \ub0b4 NPC \ub300\ud654\uc5d0 \uc720\uc758\ud558\uba74 \ub2e8\uc11c\ub97c \uc5bb\uc744 \uc218 \uc788\uc744 \uac83\uc785\ub2c8\ub2e4.[\ubcf4\ubb3c \ucc3e\uae30: \ud2b9\uc815 \uc2dc\uac04\uc5d0 \ud2b9\uc815 \uc7ac\ub8cc \uc870\ud569\uc744 \uc870\ub9ac\ud558\uba74 \uc228\uaca8\uc9c4 \ub808\uc2dc\ud53c\ub97c \ubc1c\uacac\ud560 \uac00\ub2a5\uc131\uc774 \ub192\uc2b5\ub2c8\ub2e4!] "}, {"question": "Burrito Craft\uc758 \uc218\uce58 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694? \uc7ac\ub8cc \ud488\uc9c8\uacfc \uc694\ub9ac \uae30\uc220\uc740 \ucd5c\uc885 \ud018\uc0ac\ub514\uc57c \uc18d\uc131\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "Burrito Craft\uc758 \uc218\uce58 \uc2dc\uc2a4\ud15c\uc740 \ube44\uad50\uc801 \ubcf5\uc7a1\ud558\uc9c0\ub9cc \uac04\ub2e8\ud558\uac8c \uc774\ud574\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc7ac\ub8cc\uc758 \ud488\uc9c8\uc740 \ud018\uc0ac\ub514\uc57c\uc758 \uae30\ubcf8 \uc18d\uc131, \uc608\ub97c \ub4e4\uc5b4 \ud48d\ubbf8 \uac12\uacfc \ud3ec\ub9cc\uac10\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc694\ub9ac \uae30\uc220\uc740 \ud018\uc0ac\ub514\uc57c\uc758 \ubd80\uac00 \uc18d\uc131, \uc608\ub97c \ub4e4\uc5b4 \uc2dd\uac10\uacfc \uc678\uad00\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc11c\ub85c \ub2e4\ub978 \uc7ac\ub8cc\uc758 \uc870\ud569\uc740 \uc11c\ub85c \ub2e4\ub978 \ud654\ud559 \ubc18\uc751\uc744 \uc77c\uc73c\ucf1c \ud018\uc0ac\ub514\uc57c\uc758 \ucd5c\uc885 \uc18d\uc131\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4.[\ube44\uc720 \uc124\uba85: \uc7ac\ub8cc\uc758 \ud488\uc9c8\uc744 \ud018\uc0ac\ub514\uc57c\uc758 '\uae30\ubc18'\uc73c\ub85c, \uc694\ub9ac \uae30\uc220\uc744 '\uafb8\ubbf8\uae30'\ub85c \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub450 \uac00\uc9c0 \ubaa8\ub450 \ud018\uc0ac\ub514\uc57c\uc758 \uac00\uce58\ub97c \uacb0\uc815\ud569\ub2c8\ub2e4!]"}, {"question": "\uc2ec\uce35 \ubd84\uc11d: Burrito Craft\uc758 \uac00\uac8c \uc5c5\uadf8\ub808\uc774\ub4dc \uc2dc\uc2a4\ud15c\uc5d0\ub294 \uc5b4\ub5a4 \ubd84\uae30\uac00 \uc788\ub098\uc694? \uc11c\ub85c \ub2e4\ub978 \uc5c5\uadf8\ub808\uc774\ub4dc \uacbd\ub85c\ub294 \uc6b4\uc601 \uc804\ub7b5\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "\uac00\uac8c \uc5c5\uadf8\ub808\uc774\ub4dc \uc2dc\uc2a4\ud15c\uc740 \uc8fc\ubc29 \uc5c5\uadf8\ub808\uc774\ub4dc, \ub18d\uc7a5 \uc5c5\uadf8\ub808\uc774\ub4dc \ubc0f \uac00\uac8c \uc678\uad00 \uc5c5\uadf8\ub808\uc774\ub4dc\uc758 \uc138 \uac00\uc9c0 \ubd84\uae30\ub85c \ub098\ub269\ub2c8\ub2e4. \uc8fc\ubc29 \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \uc0c8\ub85c\uc6b4 \uc694\ub9ac \uae30\uc220 \ubc0f \uc790\ub3d9\ud654 \uc7a5\ube44\ub97c \uc7a0\uae08 \ud574\uc81c\ud558\uc5ec \uc0dd\uc0b0 \ud6a8\uc728\uc744 \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub18d\uc7a5 \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \uc7ac\ub8cc\uc758 \uc0dd\uc0b0\ub7c9 \ubc0f \ud488\uc9c8\uc744 \ub192\uc774\uace0 \ube44\uc6a9\uc744 \uc808\uac10\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac00\uac8c \uc678\uad00 \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \ub354 \ub9ce\uc740 \uace0\uac1d\uc744 \uc720\uc778\ud558\uace0 \ud3c9\uade0 \uc8fc\ubb38 \uac00\uaca9\uc744 \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc790\uc2e0\uc758 \uc6b4\uc601 \uc804\ub7b5\uc5d0 \ub530\ub77c \ub2e4\ub978 \uc5c5\uadf8\ub808\uc774\ub4dc \uacbd\ub85c\ub97c \uc120\ud0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.[\ud750\ub984\ub3c4: \uac00\uac8c \uc5c5\uadf8\ub808\uc774\ub4dc \uacbd\ub85c\ub3c4, \uc8fc\ubc29, \ub18d\uc7a5, \uc678\uad00 \uc138 \uac00\uc9c0 \ubd84\uae30 \ubc0f \uac01 \ubd84\uae30\uc758 \uc5c5\uadf8\ub808\uc774\ub4dc \ud6a8\uacfc \ud3ec\ud568]"}, {"question": "Burrito Craft\ub294 \ubaa8\ubc14\uc77c \ubc84\uc804 \ucd9c\uc2dc \uacc4\ud68d\uc774 \uc788\ub098\uc694? \ucd9c\uc2dc \uc2dc PC \ubc84\uc804 \ub370\uc774\ud130\ub97c \ubaa8\ubc14\uc77c\ub85c \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud604\uc7ac Burrito Craft\uc758 \uacf5\uc2dd \ubc1c\ud45c\ub294 \ubaa8\ubc14\uc77c \ubc84\uc804 \ucd9c\uc2dc \uacc4\ud68d\uc774 \uc5c6\uc9c0\ub9cc, \uac1c\ubc1c\uc790\ub4e4\uc740 \ud50c\ub808\uc774\uc5b4\uc758 \ud53c\ub4dc\ubc31\uc744 \uc801\uadf9\uc801\uc73c\ub85c \uc218\uc9d1\ud558\uace0 \ubaa8\ubc14\uc77c \ubc84\uc804\uc758 \ud0c0\ub2f9\uc131\uc744 \ud3c9\uac00\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ubaa8\ubc14\uc77c \ubc84\uc804\uc774 \ucd9c\uc2dc\ub420 \uacbd\uc6b0, \ud50c\ub808\uc774\uc5b4\uc758 \ub370\uc774\ud130 \uc800\uc7a5 \uc694\uad6c \uc0ac\ud56d\uc744 \uace0\ub824\ud558\uc5ec \uac1c\ubc1c\uc790\ub294 \uc11c\ub85c \ub2e4\ub978 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud558\ub294 \ub370\uc774\ud130 \uc774\uc804 \uae30\ub2a5\uc744 \uc81c\uacf5\ud560 \uac00\ub2a5\uc131\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \uad6c\uccb4\uc801\uc778 \ubc29\uc548\uc740 \uacf5\uc2dd \ubc1c\ud45c\ub97c \ud1b5\ud574 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.[\uac15\uc870: Burrito Craft \uacf5\uc2dd \ucee4\ubba4\ub2c8\ud2f0\ub97c \uc8fc\uc2dc\ud558\uc5ec \ucd5c\uc2e0 \uc815\ubcf4\ub97c \uac00\uc7a5 \uba3c\uc800 \uc5bb\uc73c\uc2ed\uc2dc\uc624!] "}, {"question": "\uc131\ucde8\uc8fc\uc758\uc790\ub97c \uc704\ud55c \ud544\ub3c5: Burrito Craft\uc5d0\ub294 \uc54c\ub824\uc9c0\uc9c0 \uc54a\uc740 \uc228\uaca8\uc9c4 \uc131\ucde8\uac00 \uc788\ub098\uc694? \uc774\ub7ec\ud55c \uc131\ucde8\ub97c \ub2ec\uc131\ud558\uc5ec \ud2b9\ubcc4\ud55c \ubcf4\uc0c1\uc744 \ubc1b\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Burrito Craft\uc5d0\ub294 \"\ud018\uc0ac\ub514\uc57c \ub9c8\uc2a4\ud130\", \"\uc694\ub9ac \ud3c9\ub860\uac00\" \ubc0f \"\ub18d\ubd80\"\uc640 \uac19\uc740 \ud765\ubbf8\ub85c\uc6b4 \uc228\uaca8\uc9c4 \uc131\ucde8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc131\ucde8\ub294 \uc77c\ubc18\uc801\uc73c\ub85c \ud2b9\ubcc4\ud55c \ub3c4\uc804\uc744 \uc644\ub8cc\ud574\uc57c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ud018\uc0ac\ub514\uc57c \ub9c8\uc2a4\ud130\"\ub294 \ubaa8\ub4e0 \uc720\ud615\uc758 \ud018\uc0ac\ub514\uc57c\ub97c \ub9cc\ub4e4\uc5b4\uc57c \ud560 \uc218 \uc788\uace0, \"\uc694\ub9ac \ud3c9\ub860\uac00\"\ub294 \ubaa8\ub4e0 \uace0\uac1d\uc758 \uce6d\ucc2c\uc744 \uc5bb\uc5b4\uc57c \ud560 \uc218 \uc788\uc73c\uba70, \"\ub18d\ubd80\"\ub294 \ubaa8\ub4e0 \uc720\ud615\uc758 \uc7ac\ub8cc\ub97c \uc7ac\ubc30\ud574\uc57c \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc131\ucde8\ub97c \uc7a0\uae08 \ud574\uc81c\ud558\uba74 \ud76c\uadc0\ud55c \uc7ac\ub8cc \ubc0f \uc7a5\uc2dd\ud488\uacfc \uac19\uc740 \ud2b9\ubcc4\ud55c \ubcf4\uc0c1\uc744 \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uac8c\uc784 \ub0b4 \uc608\uc2dc: \uc5f0\uc18d 3\uc77c \ub3d9\uc548 \uac19\uc740 \uc885\ub958\uc758 \ud018\uc0ac\ub514\uc57c\ub97c \ub9cc\ub4e4\uba74 \"\ud018\uc0ac\ub514\uc57c \uc9d1\uc911\uc790\" \uc131\ucde8\ub97c \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4!] "}]
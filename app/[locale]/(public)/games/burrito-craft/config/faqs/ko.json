[{"question": "\ucd08\ubcf4\uc790\ub85c\uc11c \ubc84\ub9ac\ud1a0 \ud06c\ub798\ud504\ud2b8\uc5d0\uc11c \uccab \ubc88\uc9f8 \ubc84\ub9ac\ud1a0\ub97c \ub9cc\ub4dc\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubc84\ub9ac\ud1a0 \ud06c\ub798\ud504\ud2b8\uc5d0\uc11c \uccab \ubc88\uc9f8 \ubc84\ub9ac\ud1a0\ub97c \ub9cc\ub4dc\ub294 \ubc29\ubc95\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. STEP1 - 'C' \ud0a4\ub97c \ub20c\ub7ec \uc81c\uc791 \uba54\ub274\ub97c \uc5fd\ub2c8\ub2e4. STEP2 - '\uae30\ubcf8 \uc7ac\ub8cc' \ud0ed\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. STEP3 - \ud2c0\uc5d0  tortilla\ub97c \ub4dc\ub798\uadf8 \uc564 \ub4dc\ub86d\ud569\ub2c8\ub2e4. STEP4 - \ucf69\uc774\ub098 \ubc25\uacfc \uac19\uc740 \uc801\uc5b4\ub3c4 \ud558\ub098\uc758 \uc18d\uc7ac\ub8cc\ub97c \ucd94\uac00\ud569\ub2c8\ub2e4. STEP5 - '\uc81c\uc791'\uc744 \ub20c\ub7ec \ubc84\ub9ac\ud1a0\ub97c \uc644\uc131\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucd08\ubcf4\uc790\ub294 \uc774\ub7ec\ud55c \ub2e8\uacc4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uac04\ub2e8\ud55c \ucf69 \ubc84\ub9ac\ud1a0\ub97c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc0cc\ub4dc\uc704\uce58\ub97c \uc870\ub9bd\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. tortilla\ub294 \ube75\uc774\uace0, \uc18d\uc7ac\ub8cc\ub294 \ud1a0\ud551\uc785\ub2c8\ub2e4.]"}, {"question": "\uac8c\uc784 \ud50c\ub808\uc774 \uc2dc\uac04 100\uc2dc\uac04\uc774 \uc9c0\ub09c \ud6c4 \ubc84\ub9ac\ud1a0 \ud06c\ub798\ud504\ud2b8\uc5d0\uc11c \ubc84\ub9ac\ud1a0 \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud558\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubc84\ub9ac\ud1a0 \ud06c\ub798\ud504\ud2b8\uc5d0\uc11c 100\uc2dc\uac04 \ud50c\ub808\uc774 \ud6c4 \ubc84\ub9ac\ud1a0 \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud558\ub294 \uc804\ub7b5\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. STEP1 - \ubcf4\ub108\uc2a4 \uc810\uc218\ub97c \uc704\ud55c '\uace0\uc2a4\ud2b8 \ud398\ud37c'\uc640 \uac19\uc740 \ud76c\uadc0 \uc7ac\ub8cc\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. STEP2 - \uc18d\uc7ac\ub8cc\ub97c \uc801\uc808\ud788 \uc870\ud654\ud558\uc5ec \uacfc\ub2e4\ud558\uac8c \ucc44\uc6b0\ub294 \uac83\uc744 \ud53c\ud574 \uc810\uc218\ub97c \ub0ae\ucd94\ub294 \uac83\uc744 \ubc29\uc9c0\ud569\ub2c8\ub2e4. STEP3 - '\uce60\ud3ec \uc544\uc720\ub9ac'\uc640 \uac19\uc740 \ud2b9\uc218 \uc18c\uc2a4\ub97c \ud65c\uc6a9\ud558\uc5ec \ub9db\uc744 \uacf1\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub192\uc740 \uc810\uc218\ub97c \ubc1b\ub294 \ubc84\ub9ac\ud1a0\uc5d0\ub294 \uace0\uc2a4\ud2b8 \ud398\ud37c, \uc801\uc808\ud788 \uc870\ud654\ub41c \ubc25\uacfc \ucf69, \uce60\ud3ec \uc544\uc720\ub9ac\uac00 \ud3ec\ud568\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: \ud76c\uadc0 \uc7ac\ub8cc \uc0ac\uc6a9 \ub300 \uc77c\ubc18 \uc7ac\ub8cc \uc0ac\uc6a9\uc740 \uc810\uc218\ub97c \ucd5c\ub300 50%\uae4c\uc9c0 \ub192\uc77c \uc218 \uc788\uc9c0\ub9cc, \uacfc\ub2e4\ud558\uac8c \ucc44\uc6b0\uba74 20%\uae4c\uc9c0 \uc810\uc218\uac00 \ub0ae\uc544\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ubc84\ub9ac\ud1a0 \ud06c\ub798\ud504\ud2b8\uc758 \uc81c\uc791 \uc2dc\uc2a4\ud15c\uc774 \uc7ac\ub8cc \uc313\uae30\ub97c \ud5c8\uc6a9\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ubc84\ub9ac\ud1a0 \ud06c\ub798\ud504\ud2b8\uc758 \uc81c\uc791 \uc2dc\uc2a4\ud15c\uc774 \uc7ac\ub8cc \uc313\uae30\ub97c \ud5c8\uc6a9\ud558\ub294 \uac83\uc740 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc804\ub7b5\uc131\uc744 \ub354\ud558\uace0 \uae4a\uc774\ub97c \ub354\ud558\uae30 \uc704\ud55c \uac83\uc785\ub2c8\ub2e4. \uce58\uc988\ub098 \ucf69\uacfc \uac19\uc740 \uc7ac\ub8cc\ub97c \uc5ec\ub7ec \uacb9\uc73c\ub85c \uc313\uc73c\uba74 \ud48d\ubbf8\ub97c \ud55c\uce35 \ub192\uc774\uace0 \ubc84\ub9ac\ud1a0 \uc810\uc218\ub97c \uc62c\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \uacfc\ub3c4\ud558\uac8c \uc313\uc73c\uba74 \ubc84\ub9ac\ud1a0\uac00 \uc870\ud654\ub97c \uc774\ub8e8\uc9c0 \ubabb\ud558\uc5ec \uc804\uccb4\uc801\uc778 \ud488\uc9c8\uc774 \ub5a8\uc5b4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uce58\uc988 3\uacb9\uc744 \uc313\uc73c\uba74 +15 \ud48d\ubbf8 \ubcf4\ub108\uc2a4\uac00 \uc788\uc9c0\ub9cc, 4\uacb9\uc744 \uc313\uc73c\uba74 -10\uc758 \uc870\ud654 \ud398\ub110\ud2f0\uac00 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: 2\uacb9 \uce58\uc988: +10 \ud48d\ubbf8; 3\uacb9: +15 \ud48d\ubbf8; 4\uacb9: +15 \ud48d\ubbf8, -10 \uc870\ud654.]"}, {"question": "\ubc84\ub9ac\ud1a0 \ud06c\ub798\ud504\ud2b8\ub97c \uc9c0\uc6d0\ud558\ub294 \ud50c\ub7ab\ud3fc\uc740 \ubb34\uc5c7\uc774\uba70, \ud50c\ub7ab\ud3fc \uac04 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ubc84\ub9ac\ud1a0 \ud06c\ub798\ud504\ud2b8\ub294 PC, Mac \ubc0f PlayStation, Xbox\uc640 \uac19\uc740 \ucf58\uc194\uc5d0\uc11c \uc9c0\uc6d0\ub429\ub2c8\ub2e4. \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc2ed\uc2dc\uc624. STEP1 - \uc6d0\ub798 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. STEP2 - '\uacc4\uc815 \uc124\uc815'\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec '\uc800\uc7a5 \ub370\uc774\ud130 \ub0b4\ubcf4\ub0b4\uae30'\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. STEP3 - \uc0c8 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uc5ec \uc800\uc7a5 \ub370\uc774\ud130\ub97c \uac00\uc838\uc635\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c PlayStation\uc73c\ub85c \ubc84\ub9ac\ud1a0 \ub808\uc2dc\ud53c\uc640 \uc131\ucde8\ub3c4\ub97c \uc6d0\ud65c\ud558\uac8c \uc774\ub3d9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc808\ucc28 \uc124\uba85: \uc6d0\ub798 \ud50c\ub7ab\ud3fc \u2192 \uc800\uc7a5 \ub370\uc774\ud130 \ub0b4\ubcf4\ub0b4\uae30 \u2192 \uc0c8 \ud50c\ub7ab\ud3fc \u2192 \uc800\uc7a5 \ub370\uc774\ud130 \uac00\uc838\uc624\uae30 \u2192 \uc9c4\ud589 \uc0c1\ud669 \uc774\uc804.]"}, {"question": "\ubc84\ub9ac\ud1a0 \ud06c\ub798\ud504\ud2b8\uc758 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ubc84\ub9ac\ud1a0 \ud06c\ub798\ud504\ud2b8\uc5d0\ub294 '\uace8\ub4e0 \uc544\ubcf4\uce74\ub3c4' \ub808\uc2dc\ud53c\uc640 \uac19\uc740 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ub9ce\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub97c \ubc1c\uacac\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc2ed\uc2dc\uc624. STEP1 - \uac8c\uc784 \ub9c8\ucf13\ud50c\ub808\uc774\uc2a4\uc5d0\uc11c '\ube44\ubc00 \uc7ac\ub8cc' \uc0c1\uc810\uc744 \ubc29\ubb38\ud569\ub2c8\ub2e4. STEP2 - '\ubbf8\uc2a4\ud14c\ub9ac \uc544\ubcf4\uce74\ub3c4'\ub97c 500 \ucf54\uc778\uc5d0 \uad6c\ub9e4\ud569\ub2c8\ub2e4. STEP3 - \uc544\ubcf4\uce74\ub3c4\ub97c \uc0ac\uc6a9\ud558\uc5ec \ubc84\ub9ac\ud1a0\ub97c \ub9cc\ub4e4\uc5b4 \uace8\ub4e0 \uc544\ubcf4\uce74\ub3c4 \ub808\uc2dc\ud53c\ub97c \ud574\uc81c\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud50c\ub808\uc774\uc5b4\ub294 \ud76c\uadc0 \uc7ac\ub8cc\ub97c \uc2e4\ud5d8\ud558\uc5ec \uc6b0\uc5f0\ud788 \uc774\uac83\uc744 \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ubc84\ub9ac\ud1a0 \ud06c\ub798\ud504\ud2b8\uc5d0\uc11c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ucc3e\ub294 \uac83\uc740 \uad11\ud65c\ud55c \uc694\ub9ac \uc138\uacc4\uc5d0\uc11c \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uc744 \ucc3e\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ubc84\ub9ac\ud1a0 \ud06c\ub798\ud504\ud2b8\uc5d0\uc11c \uc7ac\ub8cc \uc7ac\uace0\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\uc5ec \ubd80\uc871 \ud604\uc0c1\uc744 \ubc29\uc9c0\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubc84\ub9ac\ud1a0 \ud06c\ub798\ud504\ud2b8\uc5d0\uc11c \uc7ac\ub8cc \uc7ac\uace0\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\uace0 \ubd80\uc871 \ud604\uc0c1\uc744 \ubc29\uc9c0\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc2ed\uc2dc\uc624. STEP1 - 'I' \ud0a4\ub97c \ub20c\ub7ec \uc815\uae30\uc801\uc73c\ub85c \uc7ac\uace0 \uc218\uc900\uc744 \ud655\uc778\ud569\ub2c8\ub2e4. STEP2 - tortilla\uc640 \ucf69\uacfc \uac19\uc740 \uc218\uc694\uac00 \ub192\uc740 \uc7ac\ub8cc\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \uc7ac\uacf5\uae09\ud569\ub2c8\ub2e4. STEP3 - \ub9c8\ucf13\ud50c\ub808\uc774\uc2a4\uc5d0\uc11c '\uc790\ub3d9 \uc7ac\uace0' \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ucd5c\uc801\uc758 \uc218\uc900\uc744 \uc720\uc9c0\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, tortilla\uc758 \uc790\ub3d9 \uc7ac\uace0\ub97c \uc124\uc815\ud558\uba74 \uc81c\uc791 \uc138\uc158 \uc911\uc5d0 \uc808\ub300 \ubd80\uc871\ud558\uc9c0 \uc54a\ub3c4\ub85d \ud569\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: tortilla: \uc790\ub3d9 \uc7ac\uace0 10; \ucf69: \uc790\ub3d9 \uc7ac\uace0 15; \uce58\uc988: \uc790\ub3d9 \uc7ac\uace0 20.]"}, {"question": "\ubc84\ub9ac\ud1a0 \ud06c\ub798\ud504\ud2b8\uc5d0\uc11c \ud48d\ubbf8 \uacf1\uc148\uc790\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ucd5c\ub300\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ubc84\ub9ac\ud1a0 \ud06c\ub798\ud504\ud2b8\uc5d0\uc11c \ud48d\ubbf8 \uacf1\uc148\uc790\ub294 \ubc84\ub9ac\ud1a0 \uc810\uc218\ub97c \ud06c\uac8c \ub192\uc774\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc774\ub97c \ucd5c\ub300\ud654\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc2ed\uc2dc\uc624. STEP1 - '\ub77c\uc784 \uc2dc\ub780\ud2b8\ub85c \ubc25'\uacfc '\uac80\uc740\ucf69'\uacfc \uac19\uc740 \ubcf4\uc644\uc801\uc778 \uc7ac\ub8cc\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. STEP2 - '\uc2a4\ud30c\uc774\uc2dc \uc0b4\uc0ac'\uc640 \uac19\uc740 \ud2b9\uc218 \uc18c\uc2a4\ub97c \ucd94\uac00\ud558\uc5ec \uacf1\uc148\uc790\ub97c \ub354\uc6b1 \ub192\uc785\ub2c8\ub2e4. STEP3 - '\ub2ec\ucf64\ud55c \uc625\uc218\uc218'\uc640 '\uc0ac\uc6cc\ud06c\ub9bc'\uacfc \uac19\uc740 \ucda9\ub3cc\ud558\ub294 \ub9db\uc744 \ud63c\ud569\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub77c\uc784 \uc2dc\ub780\ud2b8\ub85c \ubc25\uacfc \uac80\uc740\ucf69\uc744 \uacb0\ud569\ud558\uba74 2\ubc30\uc758 \ud48d\ubbf8 \uacf1\uc148\uc790\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: \ubcf4\uc644\uc801\uc778 \uc7ac\ub8cc\ub294 \uacf1\uc148\uc790\ub97c \ub450 \ubc30\ub85c \ub9cc\ub4e4 \uc218 \uc788\uc9c0\ub9cc, \ucda9\ub3cc\ud558\ub294 \ub9db\uc740 \uc808\ubc18\uc73c\ub85c \uc904\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ubc84\ub9ac\ud1a0 \ud06c\ub798\ud504\ud2b8\uc758 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubc84\ub9ac\ud1a0 \ud06c\ub798\ud504\ud2b8\uc758 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \ubc84\ub9ac\ud1a0 \ub808\uc2dc\ud53c\ub97c \uc644\ubcbd\ud558\uac8c \ub9cc\ub4dc\ub294 \ub370 \uc9d1\uc911\ud558\uace0 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\ub294 \ub370 \uc911\uc810\uc744 \ub461\ub2c8\ub2e4. \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uc2e4\uc2dc\uac04\uc73c\ub85c \ub2e4\ub978 \uc0ac\ub78c\ub4e4\uacfc \uacbd\uc7c1\ud558\uac70\ub098 \ud611\ub825\ud558\uc5ec \ubc84\ub9ac\ud1a0 \uc81c\uc791 \ucc4c\ub9b0\uc9c0\uc5d0 \ucc38\uc5ec\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c \uac00\uc7a5 \ube60\ub974\uace0 \ub9db\uc788\ub294 \ubc84\ub9ac\ud1a0\uac00 \uc2b9\ub9ac\ud558\ub294 '\uc2a4\ud53c\ub4dc \ubc84\ub9ac\ud1a0' \ucc4c\ub9b0\uc9c0\uc5d0 \ucc38\uc5ec\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4\ub294 \uc194\ub85c \uc694\ub9ac\uc1fc\uc640 \uac19\uace0, \uba40\ud2f0\ud50c\ub808\uc774\uc5b4\ub294 \uce58\uc5f4\ud55c \uc694\ub9ac \ub300\uacb0\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ubc84\ub9ac\ud1a0 \ud06c\ub798\ud504\ud2b8\uc5d0\uc11c \uace0\uae09 \uc81c\uc791 \ub808\uc2dc\ud53c\ub97c \ud574\uc81c\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5a4 \uc774\uc810\uc744 \uc81c\uacf5\ud569\ub2c8\uae4c?", "answer": "\ubc84\ub9ac\ud1a0 \ud06c\ub798\ud504\ud2b8\uc5d0\uc11c \uace0\uae09 \uc81c\uc791 \ub808\uc2dc\ud53c\ub97c \ud574\uc81c\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc2ed\uc2dc\uc624. STEP1 - '\ub9c8\uc2a4\ud130 \uc170\ud504' \ud018\uc2a4\ud2b8 \ub77c\uc778\uc744 \uc644\ub8cc\ud569\ub2c8\ub2e4. STEP2 - \ud2b9\ubcc4 \uc774\ubca4\ud2b8\uc5d0\uc11c \ud76c\uadc0 \uc7ac\ub8cc\ub97c \uc218\uc9d1\ud569\ub2c8\ub2e4. STEP3 - \uac8c\uc784 \ub0b4 \uc0c1\uc810\uc5d0\uc11c \ub808\uc2dc\ud53c \ucc45\uc744 \uad6c\ub9e4\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uace0\uae09 \ub808\uc2dc\ud53c\ub294 \ub354 \ub192\uc740 \uc810\uc218\uc640 \ud2b9\ubcc4 \ud6a8\uacfc\uc640 \uac19\uc740 \uace0\uc720\ud55c \uc774\uc810\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud654\uc0b0 \ubc84\ub9ac\ud1a0' \ub808\uc2dc\ud53c\ub294 '\uc6a9\uc554 \uce58\uc988'\uc640 '\uc9c0\uc625 \uc18c\uc2a4'\ub97c \uc218\uc9d1\ud55c \ud6c4 \ud574\uc81c\ub418\uba70, +50 \uc810\uc218 \ubcf4\ub108\uc2a4\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \ud654\uc0b0 \ubc84\ub9ac\ud1a0: +50 \uc810\uc218; \uc9c0\uc625 \uc18c\uc2a4: +20 \ud48d\ubbf8 \uacf1\uc148\uc790; \uc6a9\uc554 \uce58\uc988: +15 \uc870\ud654.]"}, {"question": "'\ubc84\ub9ac\ud1a0 \ub9c8\uc2a4\ud130\ub9ac' \ub2ec\uc131\uc740 \ubc84\ub9ac\ud1a0 \ud06c\ub798\ud504\ud2b8\uc5d0\uc11c \ubb34\uc5c7\uc744 \uc758\ubbf8\ud558\uba70, \uc5b4\ub5bb\uac8c \ub2ec\uc131\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "'\ubc84\ub9ac\ud1a0 \ub9c8\uc2a4\ud130\ub9ac' \ub2ec\uc131\uc740 \ubc84\ub9ac\ud1a0 \ud06c\ub798\ud504\ud2b8\uc5d0\uc11c \ubc84\ub9ac\ud1a0 \uc81c\uc791\uc758 \uae30\uc220\uc744 \uc775\ud614\uc74c\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4. \uc774\ub97c \ub2ec\uc131\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc2ed\uc2dc\uc624. STEP1 - \uc801\uc5b4\ub3c4 100\uac1c\uc758 \ub3c5\ud2b9\ud55c \ubc84\ub9ac\ud1a0 \ub808\uc2dc\ud53c\ub97c \uc81c\uc791\ud569\ub2c8\ub2e4. STEP2 - \ubaa8\ub4e0 \ubc84\ub9ac\ud1a0\uc758 \ucd1d \uc810\uc218\ub97c 10,000\uc810 \uc774\uc0c1 \uc5bb\uc2b5\ub2c8\ub2e4. STEP3 - \ubaa8\ub4e0 \ud2b9\uc218 \uc7ac\ub8cc\uc640 \uc18c\uc2a4\ub97c \ud574\uc81c\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud50c\ub808\uc774\uc5b4\ub294 \uc9c0\uc18d\uc801\uc73c\ub85c \ub192\uc740 \uc810\uc218\uc758 \ubc84\ub9ac\ud1a0\ub97c \uc81c\uc791\ud558\uace0 \ud76c\uadc0 \uc7ac\ub8cc\ub97c \uc2e4\ud5d8\ud558\uc5ec \uc774\ub97c \ub2ec\uc131\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: '\ubc84\ub9ac\ud1a0 \ub9c8\uc2a4\ud130\ub9ac'\ub97c \ub2ec\uc131\ud558\ub294 \uac83\uc740 \uc694\ub9ac \ud559\uad50\ub97c \uc878\uc5c5\ud558\uace0 \ucd5c\uc6b0\uc218 \uc878\uc5c5\uc0dd\uc774 \ub418\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}]
[{"question": "\u0e09\u0e31\u0e19\u0e08\u0e30\u0e40\u0e23\u0e34\u0e48\u0e21\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e1a\u0e31\u0e27\u0e23\u0e4c\u0e23\u0e34\u0e42\u0e15\u0e49\u0e0a\u0e34\u0e49\u0e19\u0e41\u0e23\u0e01\u0e43\u0e19 Burrito Craft \u0e44\u0e14\u0e49\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e44\u0e23\u0e2b\u0e32\u0e01\u0e09\u0e31\u0e19\u0e40\u0e1b\u0e47\u0e19\u0e21\u0e37\u0e2d\u0e43\u0e2b\u0e21\u0e48?", "answer": "\u0e43\u0e19\u0e01\u0e32\u0e23\u0e40\u0e23\u0e34\u0e48\u0e21\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e1a\u0e31\u0e27\u0e23\u0e4c\u0e23\u0e34\u0e42\u0e15\u0e49\u0e0a\u0e34\u0e49\u0e19\u0e41\u0e23\u0e01\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e43\u0e19 Burrito Craft \u0e43\u0e2b\u0e49\u0e19\u0e33\u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e40\u0e2b\u0e25\u0e48\u0e32\u0e19\u0e35\u0e49\u0e21\u0e32\u0e43\u0e0a\u0e49: \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 1 - \u0e40\u0e1b\u0e34\u0e14\u0e40\u0e21\u0e19\u0e39\u0e01\u0e32\u0e23\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e42\u0e14\u0e22\u0e01\u0e14\u0e1b\u0e38\u0e48\u0e21 'C' \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 2 - \u0e40\u0e25\u0e37\u0e2d\u0e01\u0e41\u0e17\u0e47\u0e1a '\u0e2a\u0e48\u0e27\u0e19\u0e1c\u0e2a\u0e21\u0e1e\u0e37\u0e49\u0e19\u0e10\u0e32\u0e19' \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 3 - \u0e25\u0e32\u0e01\u0e41\u0e25\u0e30\u0e27\u0e32\u0e07\u0e17\u0e2d\u0e23\u0e4c\u0e15\u0e34\u0e25\u0e25\u0e48\u0e32\u0e25\u0e07\u0e1a\u0e19\u0e15\u0e32\u0e23\u0e32\u0e07\u0e2a\u0e23\u0e49\u0e32\u0e07 \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 4 - \u0e40\u0e1e\u0e34\u0e48\u0e21\u0e2a\u0e48\u0e27\u0e19\u0e1c\u0e2a\u0e21\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e19\u0e49\u0e2d\u0e22\u0e2b\u0e19\u0e36\u0e48\u0e07\u0e2d\u0e22\u0e48\u0e32\u0e07 \u0e40\u0e0a\u0e48\u0e19 \u0e16\u0e31\u0e48\u0e27\u0e2b\u0e23\u0e37\u0e2d\u0e02\u0e49\u0e32\u0e27 \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 5 - \u0e01\u0e14\u0e1b\u0e38\u0e48\u0e21 '\u0e2a\u0e23\u0e49\u0e32\u0e07' \u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e1a\u0e31\u0e27\u0e23\u0e4c\u0e23\u0e34\u0e42\u0e15\u0e49\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13  \u0e15\u0e31\u0e27\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e40\u0e0a\u0e48\u0e19 \u0e1c\u0e39\u0e49\u0e40\u0e23\u0e34\u0e48\u0e21\u0e15\u0e49\u0e19\u0e2d\u0e32\u0e08\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e1a\u0e31\u0e27\u0e23\u0e4c\u0e23\u0e34\u0e42\u0e15\u0e49\u0e16\u0e31\u0e48\u0e27\u0e41\u0e1a\u0e1a\u0e07\u0e48\u0e32\u0e22\u0e46 \u0e42\u0e14\u0e22\u0e43\u0e0a\u0e49\u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e40\u0e2b\u0e25\u0e48\u0e32\u0e19\u0e35\u0e49 [\u0e40\u0e1b\u0e23\u0e35\u0e22\u0e1a\u0e40\u0e17\u0e35\u0e22\u0e1a: \u0e19\u0e36\u0e01\u0e20\u0e32\u0e1e\u0e40\u0e2b\u0e21\u0e37\u0e2d\u0e19\u0e1b\u0e23\u0e30\u0e01\u0e2d\u0e1a\u0e41\u0e0b\u0e19\u0e27\u0e34\u0e0a \u0e42\u0e14\u0e22\u0e17\u0e35\u0e48\u0e17\u0e2d\u0e23\u0e4c\u0e15\u0e34\u0e25\u0e25\u0e48\u0e32\u0e40\u0e1b\u0e47\u0e19\u0e02\u0e19\u0e21\u0e1b\u0e31\u0e07\u0e41\u0e25\u0e30\u0e2a\u0e48\u0e27\u0e19\u0e1c\u0e2a\u0e21\u0e40\u0e1b\u0e47\u0e19\u0e2a\u0e48\u0e27\u0e19\u0e1c\u0e2a\u0e21\u0e15\u0e48\u0e32\u0e07\u0e46]"}, {"question": "\u0e01\u0e25\u0e22\u0e38\u0e17\u0e18\u0e4c\u0e17\u0e35\u0e48\u0e14\u0e35\u0e17\u0e35\u0e48\u0e2a\u0e38\u0e14\u0e43\u0e19\u0e01\u0e32\u0e23\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e04\u0e30\u0e41\u0e19\u0e19\u0e1a\u0e31\u0e27\u0e23\u0e4c\u0e23\u0e34\u0e42\u0e15\u0e49\u0e02\u0e2d\u0e07\u0e09\u0e31\u0e19\u0e43\u0e19 Burrito Craft \u0e2b\u0e25\u0e31\u0e07\u0e08\u0e32\u0e01\u0e40\u0e25\u0e48\u0e19\u0e40\u0e01\u0e21\u0e44\u0e1b\u0e41\u0e25\u0e49\u0e27 100 \u0e0a\u0e31\u0e48\u0e27\u0e42\u0e21\u0e07\u0e04\u0e37\u0e2d\u0e2d\u0e30\u0e44\u0e23?", "answer": "\u0e43\u0e19\u0e01\u0e32\u0e23\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e04\u0e30\u0e41\u0e19\u0e19\u0e1a\u0e31\u0e27\u0e23\u0e4c\u0e23\u0e34\u0e42\u0e15\u0e49\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e43\u0e19 Burrito Craft \u0e2b\u0e25\u0e31\u0e07\u0e08\u0e32\u0e01\u0e40\u0e25\u0e48\u0e19\u0e40\u0e01\u0e21\u0e44\u0e1b\u0e41\u0e25\u0e49\u0e27 100 \u0e0a\u0e31\u0e48\u0e27\u0e42\u0e21\u0e07 \u0e25\u0e2d\u0e07\u0e43\u0e0a\u0e49\u0e01\u0e25\u0e22\u0e38\u0e17\u0e18\u0e4c\u0e15\u0e48\u0e2d\u0e44\u0e1b\u0e19\u0e35\u0e49: \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 1 - \u0e43\u0e0a\u0e49\u0e2a\u0e48\u0e27\u0e19\u0e1c\u0e2a\u0e21\u0e2b\u0e32\u0e22\u0e32\u0e01 \u0e40\u0e0a\u0e48\u0e19 '\u0e1e\u0e23\u0e34\u0e01\u0e40\u0e1c\u0e32' \u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e04\u0e30\u0e41\u0e19\u0e19\u0e1e\u0e34\u0e40\u0e28\u0e29 \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 2 - \u0e2a\u0e21\u0e14\u0e38\u0e25\u0e2a\u0e48\u0e27\u0e19\u0e1c\u0e2a\u0e21\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e2b\u0e25\u0e35\u0e01\u0e40\u0e25\u0e35\u0e48\u0e22\u0e07\u0e01\u0e32\u0e23\u0e43\u0e2a\u0e48\u0e2a\u0e48\u0e27\u0e19\u0e1c\u0e2a\u0e21\u0e21\u0e32\u0e01\u0e40\u0e01\u0e34\u0e19\u0e44\u0e1b \u0e0b\u0e36\u0e48\u0e07\u0e2d\u0e32\u0e08\u0e17\u0e33\u0e43\u0e2b\u0e49\u0e04\u0e30\u0e41\u0e19\u0e19\u0e25\u0e14\u0e25\u0e07 \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 3 - \u0e43\u0e0a\u0e49\u0e0b\u0e2d\u0e2a\u0e1e\u0e34\u0e40\u0e28\u0e29 \u0e40\u0e0a\u0e48\u0e19 '\u0e0a\u0e34\u0e1b\u0e2d\u0e15\u0e40\u0e25 \u0e2d\u0e32\u0e22\u0e42\u0e2d\u0e25\u0e34' \u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e04\u0e39\u0e13\u0e23\u0e2a\u0e0a\u0e32\u0e15\u0e34 \u0e15\u0e31\u0e27\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e40\u0e0a\u0e48\u0e19 \u0e1a\u0e31\u0e27\u0e23\u0e4c\u0e23\u0e34\u0e42\u0e15\u0e49\u0e17\u0e35\u0e48\u0e21\u0e35\u0e04\u0e30\u0e41\u0e19\u0e19\u0e2a\u0e39\u0e07\u0e2d\u0e32\u0e08\u0e1b\u0e23\u0e30\u0e01\u0e2d\u0e1a\u0e14\u0e49\u0e27\u0e22\u0e1e\u0e23\u0e34\u0e01\u0e40\u0e1c\u0e32 \u0e02\u0e49\u0e32\u0e27\u0e41\u0e25\u0e30\u0e16\u0e31\u0e48\u0e27\u0e17\u0e35\u0e48\u0e2a\u0e21\u0e14\u0e38\u0e25 \u0e41\u0e25\u0e30\u0e0a\u0e34\u0e1b\u0e2d\u0e15\u0e40\u0e25 \u0e2d\u0e32\u0e22\u0e42\u0e2d\u0e25\u0e34 [\u0e01\u0e32\u0e23\u0e40\u0e1b\u0e23\u0e35\u0e22\u0e1a\u0e40\u0e17\u0e35\u0e22\u0e1a\u0e2b\u0e25\u0e32\u0e22\u0e17\u0e32\u0e07\u0e40\u0e25\u0e37\u0e2d\u0e01: \u0e01\u0e32\u0e23\u0e43\u0e0a\u0e49\u0e2a\u0e48\u0e27\u0e19\u0e1c\u0e2a\u0e21\u0e2b\u0e32\u0e22\u0e32\u0e01\u0e40\u0e17\u0e35\u0e22\u0e1a\u0e01\u0e31\u0e1a\u0e2a\u0e48\u0e27\u0e19\u0e1c\u0e2a\u0e21\u0e17\u0e31\u0e48\u0e27\u0e44\u0e1b \u0e2d\u0e32\u0e08\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e04\u0e30\u0e41\u0e19\u0e19\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e44\u0e14\u0e49\u0e16\u0e36\u0e07 50% \u0e41\u0e15\u0e48\u0e01\u0e32\u0e23\u0e43\u0e2a\u0e48\u0e2a\u0e48\u0e27\u0e19\u0e1c\u0e2a\u0e21\u0e21\u0e32\u0e01\u0e40\u0e01\u0e34\u0e19\u0e44\u0e1b\u0e2d\u0e32\u0e08\u0e17\u0e33\u0e43\u0e2b\u0e49\u0e25\u0e14\u0e25\u0e07 20%]"}, {"question": "\u0e17\u0e33\u0e44\u0e21\u0e23\u0e30\u0e1a\u0e1a\u0e01\u0e32\u0e23\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e43\u0e19 Burrito Craft \u0e08\u0e36\u0e07\u0e2d\u0e19\u0e38\u0e0d\u0e32\u0e15\u0e43\u0e2b\u0e49\u0e21\u0e35\u0e01\u0e32\u0e23\u0e2a\u0e41\u0e15\u0e47\u0e04\u0e2a\u0e48\u0e27\u0e19\u0e1c\u0e2a\u0e21 \u0e41\u0e25\u0e30\u0e21\u0e31\u0e19\u0e2a\u0e48\u0e07\u0e1c\u0e25\u0e15\u0e48\u0e2d\u0e01\u0e32\u0e23\u0e40\u0e25\u0e48\u0e19\u0e40\u0e01\u0e21\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e44\u0e23?", "answer": "\u0e23\u0e30\u0e1a\u0e1a\u0e01\u0e32\u0e23\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e43\u0e19 Burrito Craft \u0e2d\u0e19\u0e38\u0e0d\u0e32\u0e15\u0e43\u0e2b\u0e49\u0e21\u0e35\u0e01\u0e32\u0e23\u0e2a\u0e41\u0e15\u0e47\u0e04\u0e2a\u0e48\u0e27\u0e19\u0e1c\u0e2a\u0e21\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e04\u0e27\u0e32\u0e21\u0e25\u0e36\u0e01\u0e41\u0e25\u0e30\u0e01\u0e25\u0e22\u0e38\u0e17\u0e18\u0e4c\u0e43\u0e19\u0e01\u0e32\u0e23\u0e40\u0e25\u0e48\u0e19\u0e40\u0e01\u0e21 \u0e01\u0e32\u0e23\u0e2a\u0e41\u0e15\u0e47\u0e04\u0e2a\u0e48\u0e27\u0e19\u0e1c\u0e2a\u0e21 \u0e40\u0e0a\u0e48\u0e19 \u0e0a\u0e35\u0e2a\u0e2b\u0e23\u0e37\u0e2d\u0e16\u0e31\u0e48\u0e27\u0e2b\u0e25\u0e32\u0e22\u0e0a\u0e31\u0e49\u0e19 \u0e2d\u0e32\u0e08\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e23\u0e2a\u0e0a\u0e32\u0e15\u0e34\u0e41\u0e25\u0e30\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e04\u0e30\u0e41\u0e19\u0e19\u0e1a\u0e31\u0e27\u0e23\u0e4c\u0e23\u0e34\u0e42\u0e15\u0e49\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13 \u0e2d\u0e22\u0e48\u0e32\u0e07\u0e44\u0e23\u0e01\u0e47\u0e15\u0e32\u0e21 \u0e01\u0e32\u0e23\u0e2a\u0e41\u0e15\u0e47\u0e04\u0e21\u0e32\u0e01\u0e40\u0e01\u0e34\u0e19\u0e44\u0e1b\u0e2d\u0e32\u0e08\u0e17\u0e33\u0e43\u0e2b\u0e49\u0e1a\u0e31\u0e27\u0e23\u0e4c\u0e23\u0e34\u0e42\u0e15\u0e49\u0e19\u0e31\u0e49\u0e19\u0e44\u0e21\u0e48\u0e40\u0e1b\u0e47\u0e19\u0e40\u0e19\u0e37\u0e49\u0e2d\u0e40\u0e14\u0e35\u0e22\u0e27\u0e01\u0e31\u0e19 \u0e2a\u0e48\u0e07\u0e1c\u0e25\u0e43\u0e2b\u0e49\u0e04\u0e38\u0e13\u0e20\u0e32\u0e1e\u0e25\u0e14\u0e25\u0e07 \u0e15\u0e31\u0e27\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e40\u0e0a\u0e48\u0e19 \u0e01\u0e32\u0e23\u0e2a\u0e41\u0e15\u0e47\u0e04\u0e0a\u0e35\u0e2a\u0e2a\u0e32\u0e21\u0e0a\u0e31\u0e49\u0e19\u0e2d\u0e32\u0e08\u0e43\u0e2b\u0e49\u0e1a\u0e27\u0e01 15 \u0e41\u0e15\u0e49\u0e21\u0e23\u0e2a\u0e0a\u0e32\u0e15\u0e34 \u0e41\u0e15\u0e48\u0e01\u0e32\u0e23\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e0a\u0e31\u0e49\u0e19\u0e17\u0e35\u0e48\u0e2a\u0e35\u0e48\u0e2d\u0e32\u0e08\u0e2a\u0e48\u0e07\u0e1c\u0e25\u0e43\u0e2b\u0e49\u0e25\u0e14\u0e25\u0e07 10 \u0e41\u0e15\u0e49\u0e21\u0e04\u0e27\u0e32\u0e21\u0e01\u0e25\u0e21\u0e01\u0e25\u0e37\u0e19 [\u0e15\u0e32\u0e23\u0e32\u0e07\u0e40\u0e1b\u0e23\u0e35\u0e22\u0e1a\u0e40\u0e17\u0e35\u0e22\u0e1a\u0e01\u0e32\u0e23\u0e01\u0e33\u0e2b\u0e19\u0e14\u0e04\u0e48\u0e32: \u0e0a\u0e35\u0e2a 2 \u0e0a\u0e31\u0e49\u0e19: \u0e1a\u0e27\u0e01 10 \u0e23\u0e2a\u0e0a\u0e32\u0e15\u0e34; 3 \u0e0a\u0e31\u0e49\u0e19: \u0e1a\u0e27\u0e01 15 \u0e23\u0e2a\u0e0a\u0e32\u0e15\u0e34; 4 \u0e0a\u0e31\u0e49\u0e19: \u0e1a\u0e27\u0e01 15 \u0e23\u0e2a\u0e0a\u0e32\u0e15\u0e34, \u0e25\u0e1a 10 \u0e04\u0e27\u0e32\u0e21\u0e01\u0e25\u0e21\u0e01\u0e25\u0e37\u0e19]"}, {"question": "\u0e41\u0e1e\u0e25\u0e15\u0e1f\u0e2d\u0e23\u0e4c\u0e21\u0e43\u0e14\u0e1a\u0e49\u0e32\u0e07\u0e17\u0e35\u0e48\u0e23\u0e2d\u0e07\u0e23\u0e31\u0e1a Burrito Craft \u0e41\u0e25\u0e30\u0e09\u0e31\u0e19\u0e2a\u0e32\u0e21\u0e32\u0e23\u0e16\u0e22\u0e49\u0e32\u0e22\u0e04\u0e27\u0e32\u0e21\u0e04\u0e37\u0e1a\u0e2b\u0e19\u0e49\u0e32\u0e23\u0e30\u0e2b\u0e27\u0e48\u0e32\u0e07\u0e41\u0e1e\u0e25\u0e15\u0e1f\u0e2d\u0e23\u0e4c\u0e21\u0e40\u0e2b\u0e25\u0e48\u0e32\u0e19\u0e31\u0e49\u0e19\u0e44\u0e14\u0e49\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e44\u0e23?", "answer": "Burrito Craft \u0e44\u0e14\u0e49\u0e23\u0e31\u0e1a\u0e01\u0e32\u0e23\u0e2a\u0e19\u0e31\u0e1a\u0e2a\u0e19\u0e38\u0e19\u0e1a\u0e19 PC, Mac \u0e41\u0e25\u0e30\u0e40\u0e04\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e40\u0e25\u0e48\u0e19\u0e40\u0e01\u0e21\u0e04\u0e2d\u0e19\u0e42\u0e0b\u0e25 \u0e40\u0e0a\u0e48\u0e19 PlayStation \u0e41\u0e25\u0e30 Xbox \u0e2b\u0e32\u0e01\u0e15\u0e49\u0e2d\u0e07\u0e01\u0e32\u0e23\u0e22\u0e49\u0e32\u0e22\u0e04\u0e27\u0e32\u0e21\u0e04\u0e37\u0e1a\u0e2b\u0e19\u0e49\u0e32 \u0e42\u0e1b\u0e23\u0e14\u0e17\u0e33\u0e15\u0e32\u0e21\u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e15\u0e48\u0e2d\u0e44\u0e1b\u0e19\u0e35\u0e49: \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 1 - \u0e25\u0e47\u0e2d\u0e01\u0e2d\u0e34\u0e19\u0e40\u0e02\u0e49\u0e32\u0e1a\u0e31\u0e0d\u0e0a\u0e35\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e43\u0e19\u0e41\u0e1e\u0e25\u0e15\u0e1f\u0e2d\u0e23\u0e4c\u0e21\u0e14\u0e31\u0e49\u0e07\u0e40\u0e14\u0e34\u0e21 \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 2 - \u0e44\u0e1b\u0e17\u0e35\u0e48 '\u0e01\u0e32\u0e23\u0e15\u0e31\u0e49\u0e07\u0e04\u0e48\u0e32\u0e1a\u0e31\u0e0d\u0e0a\u0e35' \u0e41\u0e25\u0e30\u0e40\u0e25\u0e37\u0e2d\u0e01 '\u0e2a\u0e48\u0e07\u0e2d\u0e2d\u0e01\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e1a\u0e31\u0e19\u0e17\u0e36\u0e01' \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 3 - \u0e25\u0e47\u0e2d\u0e01\u0e2d\u0e34\u0e19\u0e40\u0e02\u0e49\u0e32\u0e1a\u0e31\u0e0d\u0e0a\u0e35\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e43\u0e19\u0e41\u0e1e\u0e25\u0e15\u0e1f\u0e2d\u0e23\u0e4c\u0e21\u0e43\u0e2b\u0e21\u0e48\u0e41\u0e25\u0e30\u0e19\u0e33\u0e40\u0e02\u0e49\u0e32\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e1a\u0e31\u0e19\u0e17\u0e36\u0e01 \u0e15\u0e31\u0e27\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e40\u0e0a\u0e48\u0e19 \u0e04\u0e38\u0e13\u0e2a\u0e32\u0e21\u0e32\u0e23\u0e16\u0e22\u0e49\u0e32\u0e22\u0e2a\u0e39\u0e15\u0e23\u0e1a\u0e31\u0e27\u0e23\u0e4c\u0e23\u0e34\u0e42\u0e15\u0e49\u0e41\u0e25\u0e30\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e33\u0e40\u0e23\u0e47\u0e08\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e08\u0e32\u0e01 PC \u0e44\u0e1b\u0e22\u0e31\u0e07 PlayStation \u0e44\u0e14\u0e49\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e23\u0e32\u0e1a\u0e23\u0e37\u0e48\u0e19 [\u0e41\u0e1c\u0e19\u0e1c\u0e31\u0e07\u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19: \u0e41\u0e1e\u0e25\u0e15\u0e1f\u0e2d\u0e23\u0e4c\u0e21\u0e40\u0e14\u0e34\u0e21 \u2192 \u0e2a\u0e48\u0e07\u0e2d\u0e2d\u0e01\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e1a\u0e31\u0e19\u0e17\u0e36\u0e01 \u2192 \u0e41\u0e1e\u0e25\u0e15\u0e1f\u0e2d\u0e23\u0e4c\u0e21\u0e43\u0e2b\u0e21\u0e48 \u2192 \u0e19\u0e33\u0e40\u0e02\u0e49\u0e32\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e1a\u0e31\u0e19\u0e17\u0e36\u0e01 \u2192 \u0e04\u0e27\u0e32\u0e21\u0e04\u0e37\u0e1a\u0e2b\u0e19\u0e49\u0e32\u0e44\u0e14\u0e49\u0e23\u0e31\u0e1a\u0e01\u0e32\u0e23\u0e22\u0e49\u0e32\u0e22]"}, {"question": "\u0e44\u0e02\u0e48\u0e1b\u0e31\u0e2a\u0e01\u0e32\u0e17\u0e35\u0e48\u0e0b\u0e48\u0e2d\u0e19\u0e2d\u0e22\u0e39\u0e48\u0e43\u0e19 Burrito Craft \u0e04\u0e37\u0e2d\u0e2d\u0e30\u0e44\u0e23\u0e41\u0e25\u0e30\u0e09\u0e31\u0e19\u0e08\u0e30\u0e04\u0e49\u0e19\u0e1e\u0e1a\u0e21\u0e31\u0e19\u0e44\u0e14\u0e49\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e44\u0e23?", "answer": "Burrito Craft \u0e40\u0e15\u0e47\u0e21\u0e44\u0e1b\u0e14\u0e49\u0e27\u0e22\u0e44\u0e02\u0e48\u0e1b\u0e31\u0e2a\u0e01\u0e32\u0e17\u0e35\u0e48\u0e0b\u0e48\u0e2d\u0e19\u0e2d\u0e22\u0e39\u0e48 \u0e40\u0e0a\u0e48\u0e19 \u0e2a\u0e39\u0e15\u0e23 '\u0e2d\u0e30\u0e42\u0e27\u0e04\u0e32\u0e42\u0e14\u0e17\u0e2d\u0e07\u0e04\u0e33' \u0e2b\u0e32\u0e01\u0e15\u0e49\u0e2d\u0e07\u0e01\u0e32\u0e23\u0e04\u0e49\u0e19\u0e2b\u0e32 \u0e43\u0e2b\u0e49\u0e17\u0e33\u0e14\u0e31\u0e07\u0e19\u0e35\u0e49: \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 1 - \u0e40\u0e22\u0e35\u0e48\u0e22\u0e21\u0e0a\u0e21\u0e23\u0e49\u0e32\u0e19\u0e04\u0e49\u0e32 '\u0e2a\u0e48\u0e27\u0e19\u0e1c\u0e2a\u0e21\u0e25\u0e31\u0e1a' \u0e43\u0e19\u0e15\u0e25\u0e32\u0e14\u0e02\u0e2d\u0e07\u0e40\u0e01\u0e21 \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 2 - \u0e0b\u0e37\u0e49\u0e2d '\u0e2d\u0e30\u0e42\u0e27\u0e04\u0e32\u0e42\u0e14\u0e25\u0e36\u0e01\u0e25\u0e31\u0e1a' \u0e43\u0e19\u0e23\u0e32\u0e04\u0e32 500 \u0e40\u0e2b\u0e23\u0e35\u0e22\u0e0d \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 3 - \u0e2a\u0e23\u0e49\u0e32\u0e07\u0e1a\u0e31\u0e27\u0e23\u0e4c\u0e23\u0e34\u0e42\u0e15\u0e49\u0e42\u0e14\u0e22\u0e43\u0e0a\u0e49\u0e2d\u0e30\u0e42\u0e27\u0e04\u0e32\u0e42\u0e14\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e1b\u0e25\u0e14\u0e25\u0e47\u0e2d\u0e04\u0e2a\u0e39\u0e15\u0e23\u0e2d\u0e30\u0e42\u0e27\u0e04\u0e32\u0e42\u0e14\u0e17\u0e2d\u0e07\u0e04\u0e33  \u0e15\u0e31\u0e27\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e40\u0e0a\u0e48\u0e19 \u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19\u0e2d\u0e32\u0e08\u0e2a\u0e30\u0e14\u0e38\u0e14\u0e01\u0e31\u0e1a\u0e2a\u0e34\u0e48\u0e07\u0e19\u0e35\u0e49\u0e42\u0e14\u0e22\u0e01\u0e32\u0e23\u0e17\u0e14\u0e25\u0e2d\u0e07\u0e43\u0e0a\u0e49\u0e2a\u0e48\u0e27\u0e19\u0e1c\u0e2a\u0e21\u0e17\u0e35\u0e48\u0e2b\u0e32\u0e22\u0e32\u0e01 [\u0e40\u0e1b\u0e23\u0e35\u0e22\u0e1a\u0e40\u0e17\u0e35\u0e22\u0e1a: \u0e01\u0e32\u0e23\u0e04\u0e49\u0e19\u0e2b\u0e32\u0e44\u0e02\u0e48\u0e1b\u0e31\u0e2a\u0e01\u0e32\u0e43\u0e19 Burrito Craft \u0e19\u0e31\u0e49\u0e19\u0e40\u0e2b\u0e21\u0e37\u0e2d\u0e19\u0e01\u0e31\u0e1a\u0e01\u0e32\u0e23\u0e04\u0e49\u0e19\u0e1e\u0e1a\u0e2a\u0e21\u0e1a\u0e31\u0e15\u0e34\u0e17\u0e35\u0e48\u0e0b\u0e48\u0e2d\u0e19\u0e2d\u0e22\u0e39\u0e48 \u0e43\u0e19\u0e42\u0e25\u0e01\u0e01\u0e32\u0e23\u0e17\u0e33\u0e2d\u0e32\u0e2b\u0e32\u0e23\u0e2d\u0e31\u0e19\u0e01\u0e27\u0e49\u0e32\u0e07\u0e43\u0e2b\u0e0d\u0e48]"}, {"question": "\u0e09\u0e31\u0e19\u0e08\u0e30\u0e08\u0e31\u0e14\u0e01\u0e32\u0e23\u0e2a\u0e15\u0e47\u0e2d\u0e01\u0e2a\u0e48\u0e27\u0e19\u0e1c\u0e2a\u0e21\u0e02\u0e2d\u0e07\u0e09\u0e31\u0e19\u0e43\u0e19 Burrito Craft \u0e44\u0e14\u0e49\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e21\u0e35\u0e1b\u0e23\u0e30\u0e2a\u0e34\u0e17\u0e18\u0e34\u0e20\u0e32\u0e1e\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e2b\u0e25\u0e35\u0e01\u0e40\u0e25\u0e35\u0e48\u0e22\u0e07\u0e01\u0e32\u0e23\u0e02\u0e32\u0e14\u0e41\u0e04\u0e25\u0e19\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e44\u0e23?", "answer": "\u0e43\u0e19\u0e01\u0e32\u0e23\u0e08\u0e31\u0e14\u0e01\u0e32\u0e23\u0e2a\u0e15\u0e47\u0e2d\u0e01\u0e2a\u0e48\u0e27\u0e19\u0e1c\u0e2a\u0e21\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e43\u0e19 Burrito Craft \u0e2d\u0e22\u0e48\u0e32\u0e07\u0e21\u0e35\u0e1b\u0e23\u0e30\u0e2a\u0e34\u0e17\u0e18\u0e34\u0e20\u0e32\u0e1e \u0e42\u0e1b\u0e23\u0e14\u0e17\u0e33\u0e15\u0e32\u0e21\u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e15\u0e48\u0e2d\u0e44\u0e1b\u0e19\u0e35\u0e49: \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 1 - \u0e15\u0e23\u0e27\u0e08\u0e2a\u0e2d\u0e1a\u0e23\u0e30\u0e14\u0e31\u0e1a\u0e2a\u0e15\u0e47\u0e2d\u0e01\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e40\u0e1b\u0e47\u0e19\u0e1b\u0e23\u0e30\u0e08\u0e33\u0e42\u0e14\u0e22\u0e01\u0e14\u0e1b\u0e38\u0e48\u0e21 'I' \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 2 - \u0e43\u0e2b\u0e49\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e33\u0e04\u0e31\u0e0d\u0e01\u0e31\u0e1a\u0e01\u0e32\u0e23\u0e40\u0e15\u0e34\u0e21\u0e2a\u0e15\u0e47\u0e2d\u0e01\u0e2a\u0e48\u0e27\u0e19\u0e1c\u0e2a\u0e21\u0e17\u0e35\u0e48\u0e21\u0e35\u0e04\u0e27\u0e32\u0e21\u0e15\u0e49\u0e2d\u0e07\u0e01\u0e32\u0e23\u0e2a\u0e39\u0e07 \u0e40\u0e0a\u0e48\u0e19 \u0e17\u0e2d\u0e23\u0e4c\u0e15\u0e34\u0e25\u0e25\u0e48\u0e32\u0e41\u0e25\u0e30\u0e16\u0e31\u0e48\u0e27 \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 3 - \u0e43\u0e0a\u0e49\u0e1f\u0e35\u0e40\u0e08\u0e2d\u0e23\u0e4c '\u0e40\u0e15\u0e34\u0e21\u0e2a\u0e15\u0e47\u0e2d\u0e01\u0e2d\u0e31\u0e15\u0e42\u0e19\u0e21\u0e31\u0e15\u0e34' \u0e43\u0e19\u0e15\u0e25\u0e32\u0e14\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e23\u0e31\u0e01\u0e29\u0e32\u0e2a\u0e15\u0e47\u0e2d\u0e01\u0e17\u0e35\u0e48\u0e14\u0e35\u0e17\u0e35\u0e48\u0e2a\u0e38\u0e14 \u0e15\u0e31\u0e27\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e40\u0e0a\u0e48\u0e19 \u0e01\u0e32\u0e23\u0e15\u0e31\u0e49\u0e07\u0e04\u0e48\u0e32\u0e01\u0e32\u0e23\u0e40\u0e15\u0e34\u0e21\u0e2a\u0e15\u0e47\u0e2d\u0e01\u0e2d\u0e31\u0e15\u0e42\u0e19\u0e21\u0e31\u0e15\u0e34\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e17\u0e2d\u0e23\u0e4c\u0e15\u0e34\u0e25\u0e25\u0e48\u0e32\u0e08\u0e30\u0e0a\u0e48\u0e27\u0e22\u0e43\u0e2b\u0e49\u0e04\u0e38\u0e13\u0e44\u0e21\u0e48\u0e02\u0e32\u0e14\u0e41\u0e04\u0e25\u0e19\u0e23\u0e30\u0e2b\u0e27\u0e48\u0e32\u0e07\u0e01\u0e32\u0e23\u0e2a\u0e23\u0e49\u0e32\u0e07 [\u0e15\u0e32\u0e23\u0e32\u0e07\u0e40\u0e1b\u0e23\u0e35\u0e22\u0e1a\u0e40\u0e17\u0e35\u0e22\u0e1a\u0e01\u0e32\u0e23\u0e01\u0e33\u0e2b\u0e19\u0e14\u0e04\u0e48\u0e32: \u0e17\u0e2d\u0e23\u0e4c\u0e15\u0e34\u0e25\u0e25\u0e48\u0e32: \u0e40\u0e15\u0e34\u0e21\u0e2a\u0e15\u0e47\u0e2d\u0e01\u0e2d\u0e31\u0e15\u0e42\u0e19\u0e21\u0e31\u0e15\u0e34\u0e17\u0e35\u0e48 10; \u0e16\u0e31\u0e48\u0e27: \u0e40\u0e15\u0e34\u0e21\u0e2a\u0e15\u0e47\u0e2d\u0e01\u0e2d\u0e31\u0e15\u0e42\u0e19\u0e21\u0e31\u0e15\u0e34\u0e17\u0e35\u0e48 15; \u0e0a\u0e35\u0e2a: \u0e40\u0e15\u0e34\u0e21\u0e2a\u0e15\u0e47\u0e2d\u0e01\u0e2d\u0e31\u0e15\u0e42\u0e19\u0e21\u0e31\u0e15\u0e34\u0e17\u0e35\u0e48 20]"}, {"question": "\u0e17\u0e33\u0e44\u0e21\u0e15\u0e31\u0e27\u0e04\u0e39\u0e13\u0e23\u0e2a\u0e0a\u0e32\u0e15\u0e34\u0e08\u0e36\u0e07\u0e21\u0e35\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e33\u0e04\u0e31\u0e0d\u0e43\u0e19 Burrito Craft \u0e41\u0e25\u0e30\u0e09\u0e31\u0e19\u0e08\u0e30\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e04\u0e48\u0e32\u0e2a\u0e39\u0e07\u0e2a\u0e38\u0e14\u0e44\u0e14\u0e49\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e44\u0e23?", "answer": "\u0e15\u0e31\u0e27\u0e04\u0e39\u0e13\u0e23\u0e2a\u0e0a\u0e32\u0e15\u0e34\u0e43\u0e19 Burrito Craft \u0e21\u0e35\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e33\u0e04\u0e31\u0e0d\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e22\u0e34\u0e48\u0e07\u0e40\u0e19\u0e37\u0e48\u0e2d\u0e07\u0e08\u0e32\u0e01\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e04\u0e30\u0e41\u0e19\u0e19\u0e1a\u0e31\u0e27\u0e23\u0e4c\u0e23\u0e34\u0e42\u0e15\u0e49\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e44\u0e14\u0e49\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e21\u0e32\u0e01 \u0e2b\u0e32\u0e01\u0e15\u0e49\u0e2d\u0e07\u0e01\u0e32\u0e23\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e04\u0e48\u0e32\u0e2a\u0e39\u0e07\u0e2a\u0e38\u0e14 \u0e43\u0e2b\u0e49\u0e17\u0e33\u0e15\u0e32\u0e21\u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e15\u0e48\u0e2d\u0e44\u0e1b\u0e19\u0e35\u0e49: \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 1 - \u0e43\u0e0a\u0e49\u0e2a\u0e48\u0e27\u0e19\u0e1c\u0e2a\u0e21\u0e17\u0e35\u0e48\u0e40\u0e02\u0e49\u0e32\u0e01\u0e31\u0e19\u0e44\u0e14\u0e49 \u0e40\u0e0a\u0e48\u0e19 '\u0e02\u0e49\u0e32\u0e27\u0e25\u0e34\u0e49\u0e19\u0e08\u0e35\u0e48\u0e21\u0e30\u0e19\u0e32\u0e27' \u0e01\u0e31\u0e1a '\u0e16\u0e31\u0e48\u0e27\u0e14\u0e33' \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 2 - \u0e40\u0e1e\u0e34\u0e48\u0e21\u0e0b\u0e2d\u0e2a\u0e1e\u0e34\u0e40\u0e28\u0e29 \u0e40\u0e0a\u0e48\u0e19 '\u0e0b\u0e31\u0e25\u0e0b\u0e48\u0e32\u0e40\u0e1c\u0e47\u0e14' \u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e04\u0e39\u0e13\u0e1e\u0e34\u0e40\u0e28\u0e29 \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 3 - \u0e2b\u0e25\u0e35\u0e01\u0e40\u0e25\u0e35\u0e48\u0e22\u0e07\u0e23\u0e2a\u0e0a\u0e32\u0e15\u0e34\u0e17\u0e35\u0e48\u0e02\u0e31\u0e14\u0e41\u0e22\u0e49\u0e07 \u0e40\u0e0a\u0e48\u0e19 \u0e01\u0e32\u0e23\u0e1c\u0e2a\u0e21 '\u0e02\u0e49\u0e32\u0e27\u0e42\u0e1e\u0e14\u0e2b\u0e27\u0e32\u0e19' \u0e01\u0e31\u0e1a '\u0e04\u0e23\u0e35\u0e21\u0e40\u0e1b\u0e23\u0e35\u0e49\u0e22\u0e27' \u0e15\u0e31\u0e27\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e40\u0e0a\u0e48\u0e19 \u0e01\u0e32\u0e23\u0e23\u0e27\u0e21\u0e02\u0e49\u0e32\u0e27\u0e25\u0e34\u0e49\u0e19\u0e08\u0e35\u0e48\u0e21\u0e30\u0e19\u0e32\u0e27\u0e41\u0e25\u0e30\u0e16\u0e31\u0e48\u0e27\u0e14\u0e33\u0e08\u0e30\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e15\u0e31\u0e27\u0e04\u0e39\u0e13\u0e23\u0e2a\u0e0a\u0e32\u0e15\u0e34\u0e44\u0e14\u0e49 2 \u0e40\u0e17\u0e48\u0e32 [\u0e40\u0e1b\u0e23\u0e35\u0e22\u0e1a\u0e40\u0e17\u0e35\u0e22\u0e1a\u0e2b\u0e25\u0e32\u0e22\u0e17\u0e32\u0e07\u0e40\u0e25\u0e37\u0e2d\u0e01: \u0e2a\u0e48\u0e27\u0e19\u0e1c\u0e2a\u0e21\u0e17\u0e35\u0e48\u0e40\u0e02\u0e49\u0e32\u0e01\u0e31\u0e19\u0e44\u0e14\u0e49\u0e08\u0e30\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e15\u0e31\u0e27\u0e04\u0e39\u0e13\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e40\u0e1b\u0e47\u0e19\u0e2a\u0e2d\u0e07\u0e40\u0e17\u0e48\u0e32 \u0e43\u0e19\u0e02\u0e13\u0e30\u0e17\u0e35\u0e48\u0e23\u0e2a\u0e0a\u0e32\u0e15\u0e34\u0e17\u0e35\u0e48\u0e02\u0e31\u0e14\u0e41\u0e22\u0e49\u0e07\u0e01\u0e31\u0e19\u0e08\u0e30\u0e25\u0e14\u0e25\u0e07\u0e04\u0e23\u0e36\u0e48\u0e07\u0e2b\u0e19\u0e36\u0e48\u0e07]"}, {"question": "\u0e04\u0e27\u0e32\u0e21\u0e41\u0e15\u0e01\u0e15\u0e48\u0e32\u0e07\u0e2b\u0e25\u0e31\u0e01\u0e23\u0e30\u0e2b\u0e27\u0e48\u0e32\u0e07\u0e42\u0e2b\u0e21\u0e14\u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19\u0e04\u0e19\u0e40\u0e14\u0e35\u0e22\u0e27\u0e41\u0e25\u0e30\u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19\u0e2b\u0e25\u0e32\u0e22\u0e04\u0e19\u0e43\u0e19 Burrito Craft \u0e04\u0e37\u0e2d\u0e2d\u0e30\u0e44\u0e23?", "answer": "\u0e04\u0e27\u0e32\u0e21\u0e41\u0e15\u0e01\u0e15\u0e48\u0e32\u0e07\u0e2b\u0e25\u0e31\u0e01\u0e23\u0e30\u0e2b\u0e27\u0e48\u0e32\u0e07\u0e42\u0e2b\u0e21\u0e14\u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19\u0e04\u0e19\u0e40\u0e14\u0e35\u0e22\u0e27\u0e41\u0e25\u0e30\u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19\u0e2b\u0e25\u0e32\u0e22\u0e04\u0e19\u0e43\u0e19 Burrito Craft \u0e04\u0e37\u0e2d: \u0e43\u0e19\u0e42\u0e2b\u0e21\u0e14\u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19\u0e04\u0e19\u0e40\u0e14\u0e35\u0e22\u0e27 \u0e04\u0e38\u0e13\u0e08\u0e30\u0e40\u0e19\u0e49\u0e19\u0e17\u0e35\u0e48\u0e01\u0e32\u0e23\u0e17\u0e33\u0e43\u0e2b\u0e49\u0e2a\u0e39\u0e15\u0e23\u0e1a\u0e31\u0e27\u0e23\u0e4c\u0e23\u0e34\u0e42\u0e15\u0e49\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e2a\u0e21\u0e1a\u0e39\u0e23\u0e13\u0e4c\u0e41\u0e25\u0e30\u0e17\u0e33\u0e04\u0e30\u0e41\u0e19\u0e19\u0e2a\u0e39\u0e07 \u0e43\u0e19\u0e42\u0e2b\u0e21\u0e14\u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19\u0e2b\u0e25\u0e32\u0e22\u0e04\u0e19 \u0e04\u0e38\u0e13\u0e08\u0e30\u0e41\u0e02\u0e48\u0e07\u0e02\u0e31\u0e19\u0e2b\u0e23\u0e37\u0e2d\u0e17\u0e33\u0e07\u0e32\u0e19\u0e23\u0e48\u0e27\u0e21\u0e01\u0e31\u0e19\u0e01\u0e31\u0e1a\u0e1c\u0e39\u0e49\u0e2d\u0e37\u0e48\u0e19\u0e43\u0e19\u0e01\u0e32\u0e23\u0e17\u0e49\u0e32\u0e17\u0e32\u0e22\u0e01\u0e32\u0e23\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e1a\u0e31\u0e27\u0e23\u0e4c\u0e23\u0e34\u0e42\u0e15\u0e49\u0e41\u0e1a\u0e1a\u0e40\u0e23\u0e35\u0e22\u0e25\u0e44\u0e17\u0e21\u0e4c \u0e15\u0e31\u0e27\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e40\u0e0a\u0e48\u0e19 \u0e43\u0e19\u0e42\u0e2b\u0e21\u0e14\u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19\u0e2b\u0e25\u0e32\u0e22\u0e04\u0e19 \u0e04\u0e38\u0e13\u0e2d\u0e32\u0e08\u0e40\u0e1c\u0e0a\u0e34\u0e0d\u0e2b\u0e19\u0e49\u0e32\u0e01\u0e31\u0e1a\u0e04\u0e27\u0e32\u0e21\u0e17\u0e49\u0e32\u0e17\u0e32\u0e22 '\u0e2a\u0e1b\u0e35\u0e14\u0e1a\u0e31\u0e27\u0e23\u0e4c\u0e23\u0e34\u0e42\u0e15\u0e49' \u0e0b\u0e36\u0e48\u0e07\u0e1a\u0e31\u0e27\u0e23\u0e4c\u0e23\u0e34\u0e42\u0e15\u0e49\u0e17\u0e35\u0e48\u0e40\u0e23\u0e47\u0e27\u0e17\u0e35\u0e48\u0e2a\u0e38\u0e14\u0e41\u0e25\u0e30\u0e21\u0e35\u0e23\u0e2a\u0e0a\u0e32\u0e15\u0e34\u0e21\u0e32\u0e01\u0e17\u0e35\u0e48\u0e2a\u0e38\u0e14\u0e08\u0e30\u0e0a\u0e19\u0e30 [\u0e40\u0e1b\u0e23\u0e35\u0e22\u0e1a\u0e40\u0e17\u0e35\u0e22\u0e1a: \u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19\u0e04\u0e19\u0e40\u0e14\u0e35\u0e22\u0e27\u0e40\u0e2b\u0e21\u0e37\u0e2d\u0e19\u0e01\u0e31\u0e1a\u0e23\u0e32\u0e22\u0e01\u0e32\u0e23\u0e17\u0e33\u0e2d\u0e32\u0e2b\u0e32\u0e23\u0e40\u0e14\u0e35\u0e48\u0e22\u0e27 \u0e43\u0e19\u0e02\u0e13\u0e30\u0e17\u0e35\u0e48\u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19\u0e2b\u0e25\u0e32\u0e22\u0e04\u0e19\u0e04\u0e37\u0e2d\u0e01\u0e32\u0e23\u0e15\u0e48\u0e2d\u0e2a\u0e39\u0e49\u0e17\u0e32\u0e07\u0e01\u0e32\u0e23\u0e17\u0e33\u0e2d\u0e32\u0e2b\u0e32\u0e23\u0e17\u0e35\u0e48\u0e21\u0e35\u0e04\u0e27\u0e32\u0e21\u0e40\u0e2a\u0e35\u0e48\u0e22\u0e07\u0e2a\u0e39\u0e07]"}, {"question": "\u0e09\u0e31\u0e19\u0e08\u0e30\u0e1b\u0e25\u0e14\u0e25\u0e47\u0e2d\u0e01\u0e2a\u0e39\u0e15\u0e23\u0e01\u0e32\u0e23\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e02\u0e31\u0e49\u0e19\u0e2a\u0e39\u0e07\u0e43\u0e19 Burrito Craft \u0e44\u0e14\u0e49\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e44\u0e23 \u0e41\u0e25\u0e30\u0e1b\u0e23\u0e30\u0e42\u0e22\u0e0a\u0e19\u0e4c\u0e17\u0e35\u0e48\u0e44\u0e14\u0e49\u0e23\u0e31\u0e1a\u0e04\u0e37\u0e2d\u0e2d\u0e30\u0e44\u0e23?", "answer": "\u0e43\u0e19\u0e01\u0e32\u0e23\u0e1b\u0e25\u0e14\u0e25\u0e47\u0e2d\u0e01\u0e2a\u0e39\u0e15\u0e23\u0e01\u0e32\u0e23\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e02\u0e31\u0e49\u0e19\u0e2a\u0e39\u0e07\u0e43\u0e19 Burrito Craft \u0e43\u0e2b\u0e49\u0e19\u0e33\u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e15\u0e48\u0e2d\u0e44\u0e1b\u0e19\u0e35\u0e49\u0e21\u0e32\u0e43\u0e0a\u0e49: \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 1 - \u0e40\u0e2a\u0e23\u0e47\u0e08\u0e2a\u0e34\u0e49\u0e19\u0e20\u0e32\u0e23\u0e01\u0e34\u0e08 '\u0e40\u0e0a\u0e1f\u0e1c\u0e39\u0e49\u0e40\u0e0a\u0e35\u0e48\u0e22\u0e27\u0e0a\u0e32\u0e0d' \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 2 - \u0e40\u0e01\u0e47\u0e1a\u0e2a\u0e48\u0e27\u0e19\u0e1c\u0e2a\u0e21\u0e17\u0e35\u0e48\u0e2b\u0e32\u0e22\u0e32\u0e01\u0e08\u0e32\u0e01\u0e01\u0e34\u0e08\u0e01\u0e23\u0e23\u0e21\u0e1e\u0e34\u0e40\u0e28\u0e29 \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 3 - \u0e0b\u0e37\u0e49\u0e2d\u0e2b\u0e19\u0e31\u0e07\u0e2a\u0e37\u0e2d\u0e2a\u0e39\u0e15\u0e23\u0e08\u0e32\u0e01\u0e23\u0e49\u0e32\u0e19\u0e04\u0e49\u0e32\u0e43\u0e19\u0e40\u0e01\u0e21 \u0e2a\u0e39\u0e15\u0e23\u0e02\u0e31\u0e49\u0e19\u0e2a\u0e39\u0e07\u0e40\u0e2b\u0e25\u0e48\u0e32\u0e19\u0e35\u0e49\u0e21\u0e2d\u0e1a\u0e1b\u0e23\u0e30\u0e42\u0e22\u0e0a\u0e19\u0e4c\u0e17\u0e35\u0e48\u0e40\u0e1b\u0e47\u0e19\u0e40\u0e2d\u0e01\u0e25\u0e31\u0e01\u0e29\u0e13\u0e4c\u0e40\u0e0a\u0e48\u0e19 \u0e04\u0e30\u0e41\u0e19\u0e19\u0e17\u0e35\u0e48\u0e2a\u0e39\u0e07\u0e01\u0e27\u0e48\u0e32\u0e41\u0e25\u0e30\u0e40\u0e2d\u0e1f\u0e40\u0e1f\u0e47\u0e01\u0e15\u0e4c\u0e1e\u0e34\u0e40\u0e28\u0e29 \u0e15\u0e31\u0e27\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e40\u0e0a\u0e48\u0e19 \u0e2a\u0e39\u0e15\u0e23 '\u0e1a\u0e31\u0e27\u0e23\u0e4c\u0e23\u0e34\u0e42\u0e15\u0e49\u0e20\u0e39\u0e40\u0e02\u0e32\u0e44\u0e1f' \u0e40\u0e1b\u0e34\u0e14\u0e43\u0e0a\u0e49\u0e07\u0e32\u0e19\u0e2b\u0e25\u0e31\u0e07\u0e08\u0e32\u0e01\u0e23\u0e27\u0e1a\u0e23\u0e27\u0e21 '\u0e0a\u0e35\u0e2a\u0e20\u0e39\u0e40\u0e02\u0e32\u0e44\u0e1f' \u0e41\u0e25\u0e30 '\u0e0b\u0e2d\u0e2a\u0e44\u0e1f\u0e19\u0e23\u0e01' \u0e43\u0e2b\u0e49\u0e04\u0e30\u0e41\u0e19\u0e19\u0e1e\u0e34\u0e40\u0e28\u0e29 +50 [\u0e15\u0e32\u0e23\u0e32\u0e07\u0e40\u0e1b\u0e23\u0e35\u0e22\u0e1a\u0e40\u0e17\u0e35\u0e22\u0e1a\u0e01\u0e32\u0e23\u0e01\u0e33\u0e2b\u0e19\u0e14\u0e04\u0e48\u0e32: \u0e1a\u0e31\u0e27\u0e23\u0e4c\u0e23\u0e34\u0e42\u0e15\u0e49\u0e20\u0e39\u0e40\u0e02\u0e32\u0e44\u0e1f: +50 \u0e04\u0e30\u0e41\u0e19\u0e19; \u0e0b\u0e2d\u0e2a\u0e44\u0e1f\u0e19\u0e23\u0e01: +20 \u0e15\u0e31\u0e27\u0e04\u0e39\u0e13\u0e23\u0e2a\u0e0a\u0e32\u0e15\u0e34; \u0e0a\u0e35\u0e2a\u0e20\u0e39\u0e40\u0e02\u0e32\u0e44\u0e1f: +15 \u0e04\u0e27\u0e32\u0e21\u0e01\u0e25\u0e21\u0e01\u0e25\u0e37\u0e19]"}, {"question": "\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e33\u0e04\u0e31\u0e0d\u0e02\u0e2d\u0e07\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e33\u0e40\u0e23\u0e47\u0e08 '\u0e01\u0e32\u0e23\u0e40\u0e0a\u0e35\u0e48\u0e22\u0e27\u0e0a\u0e32\u0e0d\u0e1a\u0e31\u0e27\u0e23\u0e4c\u0e23\u0e34\u0e42\u0e15\u0e49' \u0e43\u0e19 Burrito Craft \u0e04\u0e37\u0e2d\u0e2d\u0e30\u0e44\u0e23 \u0e41\u0e25\u0e30\u0e09\u0e31\u0e19\u0e08\u0e30\u0e1a\u0e23\u0e23\u0e25\u0e38\u0e21\u0e31\u0e19\u0e44\u0e14\u0e49\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e44\u0e23?", "answer": "\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e33\u0e40\u0e23\u0e47\u0e08 '\u0e01\u0e32\u0e23\u0e40\u0e0a\u0e35\u0e48\u0e22\u0e27\u0e0a\u0e32\u0e0d\u0e1a\u0e31\u0e27\u0e23\u0e4c\u0e23\u0e34\u0e42\u0e15\u0e49' \u0e43\u0e19 Burrito Craft \u0e2b\u0e21\u0e32\u0e22\u0e04\u0e27\u0e32\u0e21\u0e27\u0e48\u0e32\u0e04\u0e38\u0e13\u0e40\u0e0a\u0e35\u0e48\u0e22\u0e27\u0e0a\u0e32\u0e0d\u0e28\u0e34\u0e25\u0e1b\u0e30\u0e01\u0e32\u0e23\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e1a\u0e31\u0e27\u0e23\u0e4c\u0e23\u0e34\u0e42\u0e15\u0e49 \u0e2b\u0e32\u0e01\u0e15\u0e49\u0e2d\u0e07\u0e01\u0e32\u0e23\u0e1a\u0e23\u0e23\u0e25\u0e38\u0e2a\u0e34\u0e48\u0e07\u0e19\u0e35\u0e49 \u0e43\u0e2b\u0e49\u0e17\u0e33\u0e15\u0e32\u0e21\u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e15\u0e48\u0e2d\u0e44\u0e1b\u0e19\u0e35\u0e49: \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 1 - \u0e2a\u0e23\u0e49\u0e32\u0e07\u0e2a\u0e39\u0e15\u0e23\u0e1a\u0e31\u0e27\u0e23\u0e4c\u0e23\u0e34\u0e42\u0e15\u0e49\u0e17\u0e35\u0e48\u0e41\u0e15\u0e01\u0e15\u0e48\u0e32\u0e07\u0e01\u0e31\u0e19\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e19\u0e49\u0e2d\u0e22 100 \u0e2a\u0e39\u0e15\u0e23 \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 2 - \u0e17\u0e33\u0e04\u0e30\u0e41\u0e19\u0e19\u0e23\u0e27\u0e21 10,000 \u0e04\u0e30\u0e41\u0e19\u0e19\u0e17\u0e31\u0e48\u0e27\u0e17\u0e31\u0e49\u0e07\u0e1a\u0e31\u0e27\u0e23\u0e4c\u0e23\u0e34\u0e42\u0e15\u0e49\u0e17\u0e31\u0e49\u0e07\u0e2b\u0e21\u0e14 \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 3 - \u0e1b\u0e25\u0e14\u0e25\u0e47\u0e2d\u0e01\u0e2a\u0e48\u0e27\u0e19\u0e1c\u0e2a\u0e21\u0e41\u0e25\u0e30\u0e0b\u0e2d\u0e2a\u0e1e\u0e34\u0e40\u0e28\u0e29\u0e17\u0e31\u0e49\u0e07\u0e2b\u0e21\u0e14 \u0e15\u0e31\u0e27\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e40\u0e0a\u0e48\u0e19 \u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19\u0e2d\u0e32\u0e08\u0e17\u0e33\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e33\u0e40\u0e23\u0e47\u0e08\u0e19\u0e35\u0e49\u0e42\u0e14\u0e22\u0e01\u0e32\u0e23\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e1a\u0e31\u0e27\u0e23\u0e4c\u0e23\u0e34\u0e42\u0e15\u0e49\u0e17\u0e35\u0e48\u0e21\u0e35\u0e04\u0e30\u0e41\u0e19\u0e19\u0e2a\u0e39\u0e07\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e2a\u0e21\u0e48\u0e33\u0e40\u0e2a\u0e21\u0e2d\u0e41\u0e25\u0e30\u0e17\u0e14\u0e25\u0e2d\u0e07\u0e43\u0e0a\u0e49\u0e2a\u0e48\u0e27\u0e19\u0e1c\u0e2a\u0e21\u0e17\u0e35\u0e48\u0e2b\u0e32\u0e22\u0e32\u0e01 [\u0e40\u0e1b\u0e23\u0e35\u0e22\u0e1a\u0e40\u0e17\u0e35\u0e22\u0e1a: \u0e01\u0e32\u0e23\u0e44\u0e14\u0e49\u0e23\u0e31\u0e1a '\u0e01\u0e32\u0e23\u0e40\u0e0a\u0e35\u0e48\u0e22\u0e27\u0e0a\u0e32\u0e0d\u0e1a\u0e31\u0e27\u0e23\u0e4c\u0e23\u0e34\u0e42\u0e15\u0e49' \u0e19\u0e31\u0e49\u0e19\u0e40\u0e2b\u0e21\u0e37\u0e2d\u0e19\u0e01\u0e31\u0e1a\u0e08\u0e1a\u0e01\u0e32\u0e23\u0e28\u0e36\u0e01\u0e29\u0e32\u0e14\u0e49\u0e32\u0e19\u0e01\u0e32\u0e23\u0e17\u0e33\u0e2d\u0e32\u0e2b\u0e32\u0e23\u0e14\u0e49\u0e27\u0e22\u0e40\u0e01\u0e35\u0e22\u0e23\u0e15\u0e34\u0e22\u0e28\u0e2d\u0e31\u0e19\u0e2a\u0e39\u0e07\u0e2a\u0e38\u0e14]"}]
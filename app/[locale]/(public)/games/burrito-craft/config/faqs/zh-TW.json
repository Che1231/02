[{"question": "\u65b0\u624b\u5165\u9580\uff1aBurrito Craft \u5982\u4f55\u5feb\u901f\u4e0a\u624b\uff1f\u6709\u54ea\u4e9b\u57fa\u790e\u64cd\u4f5c\u662f\u5fc5\u9808\u638c\u63e1\u7684\uff1f", "answer": "Burrito Craft\u4e0a\u624b\u975e\u5e38\u7c21\u55ae\uff01\u60a8\u9700\u8981\u5148\u719f\u6089\u98df\u6750\u7684\u53d6\u5f97\uff0c\u4f8b\u5982\u5728\u8fb2\u5834\u7a2e\u690d\u756a\u8304\uff0c\u6216\u5728\u5546\u5e97\u8cfc\u8cb7\u8089\u985e\u3002\u7136\u5f8c\uff0c\u5728\u5eda\u623f\u4f7f\u7528\u70f9\u98ea\u53f0\uff0c\u6839\u64da\u98df\u8b5c\u5c07\u98df\u6750\u7d44\u5408\u6210\u7f8e\u5473\u7684\u58a8\u897f\u54e5\u6372\u9905\u3002\u57fa\u790e\u64cd\u4f5c\u5305\u62ec\uff1a\u79fb\u52d5\u89d2\u8272\u3001\u63a1\u96c6\u98df\u6750\u3001\u70f9\u98ea\u6372\u9905\u548c\u51fa\u552e\u6372\u9905\u3002\u521d\u671f\u5efa\u8b70\u591a\u88fd\u4f5c\u725b\u8089\u6372\u9905\uff0c\u6210\u672c\u4f4e\u4e14\u53d7\u6b61\u8fce\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u70f9\u98ea\u53f0\u5c31\u50cf\u60a8\u7684\u9b54\u6cd5\u5de5\u4f5c\u53f0\uff0c\u5408\u7406\u642d\u914d\u98df\u6750\u5c31\u80fd\u5275\u9020\u51fa\u5947\u8e5f\uff01]"}, {"question": "Burrito Craft \u4e2d\uff0c\u5982\u4f55\u63d0\u5347\u6372\u9905\u7684\u54c1\u8cea\uff1f\u9ad8\u54c1\u8cea\u6372\u9905\u5c0d\u6536\u76ca\u6709\u4ec0\u9ebc\u5f71\u97ff\uff1f", "answer": "\u60f3\u8981\u505a\u51fa\u9ad8\u54c1\u8cea\u7684\u6372\u9905\uff0c\u9700\u8981\u6ce8\u610f\u4ee5\u4e0b\u5e7e\u9ede\uff1a1. \u9078\u64c7\u65b0\u9bae\u7684\u98df\u6750\uff0c\u53ef\u4ee5\u901a\u8fc7\u5347\u7d1a\u8fb2\u5834\u4f86\u63d0\u9ad8\u98df\u6750\u54c1\u8cea\u30022. \u5347\u7d1a\u70f9\u98ea\u53f0\uff0c\u66f4\u9ad8\u7d1a\u7684\u70f9\u98ea\u53f0\u53ef\u4ee5\u89e3\u9396\u65b0\u7684\u70f9\u98ea\u6280\u5de7\u30023. \u638c\u63e1\u98df\u8b5c\uff0c\u4e0d\u540c\u7684\u98df\u6750\u642d\u914d\u6703\u5f71\u97ff\u6372\u9905\u7684\u5c6c\u6027\u3002\u9ad8\u54c1\u8cea\u6372\u9905\u7684\u552e\u50f9\u66f4\u9ad8\uff0c\u4e26\u4e14\u66f4\u5bb9\u6613\u5438\u5f15\u9867\u5ba2\uff0c\u63d0\u5347\u5546\u5e97\u7684\u8072\u671b\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u666e\u901a\u756a\u8304vs\u9ad8\u7d1a\u756a\u8304\uff0c\u552e\u50f9\u5dee\u7570\u4e00\u89bd\u8868]"}, {"question": "BC\u6372\u9905\u5e97\u7684\u8072\u671b\u503c\u6709\u4ec0\u9ebc\u4f5c\u7528\uff1f\u5982\u4f55\u5feb\u901f\u63d0\u9ad8\u8072\u671b\u7b49\u7d1a\uff1f", "answer": "\u8072\u671b\u503c\u4ee3\u8868\u4e86\u60a8\u7684\u6372\u9905\u5e97\u5728\u904a\u6232\u4e2d\u7684\u53d7\u6b61\u8fce\u7a0b\u5ea6\u3002\u63d0\u9ad8\u8072\u671b\u7b49\u7d1a\u53ef\u4ee5\u89e3\u9396\u65b0\u7684\u98df\u6750\u3001\u98df\u8b5c\u548c\u5546\u5e97\u88dd\u98fe\u3002\u5feb\u901f\u63d0\u9ad8\u8072\u671b\u7684\u65b9\u6cd5\u6709\u5982\u4e0b\uff1a1. \u5b8c\u6210\u6bcf\u65e5\u4efb\u52d9\uff0c\u53ef\u4ee5\u7372\u5f97\u5927\u91cf\u8072\u671b\u734e\u52f5\u30022. \u51fa\u552e\u9ad8\u54c1\u8cea\u7684\u6372\u9905\uff0c\u9867\u5ba2\u6eff\u610f\u5ea6\u8d8a\u9ad8\uff0c\u7372\u5f97\u7684\u8072\u671b\u4e5f\u8d8a\u591a\u30023. \u53c3\u8207\u904a\u6232\u5167\u7684\u6d3b\u52d5\uff0c\u4f8b\u5982\u6372\u9905\u5927\u8cfd\uff0c\u80fd\u5920\u7372\u5f97\u8c50\u539a\u7684\u8072\u671b\u734e\u52f5\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u8072\u671b\u63d0\u5347\u6d41\u7a0b\u5716\uff0c\u5305\u542b\u4efb\u52d9\u3001\u5546\u54c1\u54c1\u8cea\u3001\u6d3b\u52d5\u4e09\u500b\u4e3b\u8981\u5206\u652f]"}, {"question": "Burrito Craft \u4e2d\uff0c\u4e0d\u540c\u985e\u578b\u7684\u9867\u5ba2\u6709\u4ec0\u9ebc\u504f\u597d\uff1f\u5982\u4f55\u6839\u64da\u9867\u5ba2\u559c\u597d\u8abf\u6574\u6372\u9905\u914d\u65b9\uff1f", "answer": "\u904a\u6232\u4e2d\u7684\u9867\u5ba2\u6709\u4e0d\u540c\u7684\u53e3\u5473\u504f\u597d\u3002\u4f8b\u5982\uff0c\u6709\u4e9b\u9867\u5ba2\u559c\u6b61\u8fa3\u5473\u7684\u6372\u9905\uff0c\u6709\u4e9b\u5247\u559c\u6b61\u6e05\u6de1\u7684\u53e3\u5473\u3002\u53ef\u4ee5\u901a\u8fc7\u89c2\u5bdf\u9867\u5ba2\u7684\u8868\u60c5\u548c\u5c0d\u8a71\u4f86\u4e86\u89e3\u4ed6\u5011\u7684\u559c\u597d\u3002\u8abf\u6574\u6372\u9905\u914d\u65b9\u6642\uff0c\u53ef\u4ee5\u5617\u8a66\u6dfb\u52a0\u4e0d\u540c\u7684\u8abf\u5473\u6599\uff0c\u4f8b\u5982\u8fa3\u6912\u3001\u9999\u83dc\u6216\u8d77\u53f8\u3002\u8a18\u4f4f\uff0c\u6eff\u8db3\u9867\u5ba2\u7684\u53e3\u5473\u624d\u80fd\u7372\u5f97\u66f4\u9ad8\u7684\u6536\u76ca\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u8fa3\u5473\u6372\u9905\u914d\u65b9 vs \u6e05\u6de1\u6372\u9905\u914d\u65b9]"}, {"question": "\u5f8c\u671f\u5982\u4f55\u5be6\u73feBurrito Craft \u6372\u9905\u5e97\u7684\u81ea\u52d5\u5316\u7d93\u71df\uff1f\u6709\u54ea\u4e9b\u5efa\u7bc9\u6216\u9053\u5177\u53ef\u4ee5\u8f14\u52a9\uff1f", "answer": "Burrito Craft\u5f8c\u671f\uff0c\u53ef\u4ee5\u901a\u8fc7\u4ee5\u4e0b\u65b9\u6cd5\u5be6\u73fe\u81ea\u52d5\u5316\u7d93\u71df\uff1a\u6b65\u9a5f1: \u5347\u7d1a\u60a8\u7684\u5eda\u623f\uff0c\u89e3\u9396\u81ea\u52d5\u5316\u70f9\u98ea\u53f0\uff0c\u5b83\u53ef\u4ee5\u81ea\u52d5\u88fd\u4f5c\u6372\u9905\u3002\u6b65\u9a5f2: \u50f1\u7528\u54e1\u5de5\uff0c\u8b93\u4ed6\u5011\u8ca0\u8cac\u6536\u9280\u548c\u6e05\u6f54\u5de5\u4f5c\u3002\u6b65\u9a5f3: \u8cfc\u8cb7\u81ea\u52d5\u8ca9\u8ce3\u6a5f\uff0c\u5b83\u53ef\u4ee5\u81ea\u52d5\u51fa\u552e\u6372\u9905\u3002\u6b64\u5916\uff0c\u9084\u53ef\u4ee5\u8cfc\u8cb7\u98df\u6750\u5132\u85cf\u5668\uff0c\u5b83\u53ef\u4ee5\u81ea\u52d5\u5132\u5b58\u98df\u6750\uff0c\u907f\u514d\u6d6a\u8cbb\u3002[\u904a\u6232\u5167\u7bc4\u4f8b\uff1a\u5728\u5546\u5e97\u8cfc\u8cb7\u300c\u81ea\u52d5\u70f9\u98ea\u53f0\u300d\uff0c\u5373\u53ef\u9ad4\u9a57\u81ea\u52d5\u5316\u751f\u7522\u3002]"}, {"question": "Burrito Craft \u4e2d\uff0c\u662f\u5426\u5b58\u5728\u96b1\u85cf\u7684\u98df\u8b5c\uff1f\u5982\u4f55\u624d\u80fd\u89e3\u9396\u9019\u4e9b\u795e\u79d8\u914d\u65b9\uff1f", "answer": "\u662f\u7684\uff0cBurrito Craft\u4e2d\u5b58\u5728\u4e00\u4e9b\u96b1\u85cf\u7684\u98df\u8b5c\u3002\u9019\u4e9b\u98df\u8b5c\u901a\u5e38\u9700\u8981\u7279\u5b9a\u7684\u689d\u4ef6\u624d\u80fd\u89e3\u9396\u3002\u4f8b\u5982\uff0c\u9700\u8981\u5b8c\u6210\u4e00\u7cfb\u5217\u7279\u6b8a\u7684\u4efb\u52d9\uff0c\u6216\u8005\u6536\u96c6\u7279\u5b9a\u7684\u98df\u6750\u3002\u6709\u4e9b\u96b1\u85cf\u98df\u8b5c\u7684\u89e3\u9396\u65b9\u5f0f\u975e\u5e38\u96b1\u853d\uff0c\u9700\u8981\u73a9\u5bb6\u4ed4\u7d30\u63a2\u7d22\u904a\u6232\u4e16\u754c\u3002\u63d0\u793a\uff1a\u591a\u7559\u610f\u904a\u6232\u4e2d\u7684NPC\u5c0d\u8a71\uff0c\u4ed6\u5011\u53ef\u80fd\u6703\u900f\u9732\u4e00\u4e9b\u7dda\u7d22\u3002[\u5f69\u86cb\u6316\u6398\uff1a\u5617\u8a66\u5728\u7279\u5b9a\u6642\u9593\u70f9\u98ea\u7279\u5b9a\u7684\u98df\u6750\u7d44\u5408\uff0c\u53ef\u80fd\u6703\u89f8\u767c\u96b1\u85cf\u98df\u8b5c\uff01]"}, {"question": "Burrito Craft \u7684\u6578\u503c\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f\u98df\u6750\u54c1\u8cea\u3001\u70f9\u98ea\u6280\u5de7\u5c0d\u6700\u7d42\u7684\u6372\u9905\u5c6c\u6027\u6709\u4ec0\u9ebc\u5f71\u97ff\uff1f", "answer": "Burrito Craft\u7684\u6578\u503c\u7cfb\u7d71\u76f8\u5c0d\u8907\u96dc\uff0c\u4f46\u53ef\u4ee5\u901a\u8fc7\u7c21\u55ae\u7684\u65b9\u5f0f\u7406\u89e3\u3002\u98df\u6750\u7684\u54c1\u8cea\u76f4\u63a5\u5f71\u97ff\u6372\u9905\u7684\u57fa\u790e\u5c6c\u6027\uff0c\u4f8b\u5982\u98a8\u5473\u503c\u548c\u98fd\u8179\u611f\u3002\u70f9\u98ea\u6280\u5de7\u5247\u6703\u5f71\u97ff\u6372\u9905\u7684\u9644\u52a0\u5c6c\u6027\uff0c\u4f8b\u5982\u53e3\u611f\u548c\u5916\u89c0\u3002\u4e0d\u540c\u7684\u98df\u6750\u642d\u914d\u6703\u7522\u751f\u4e0d\u540c\u7684\u5316\u5b78\u53cd\u61c9\uff0c\u5f9e\u800c\u5f71\u97ff\u6372\u9905\u7684\u6700\u7d42\u5c6c\u6027\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u53ef\u4ee5\u5c07\u98df\u6750\u7684\u54c1\u8cea\u770b\u4f5c\u662f\u6372\u9905\u7684\u300c\u5730\u57fa\u300d\uff0c\u70f9\u98ea\u6280\u5de7\u5247\u662f\u300c\u88dd\u4fee\u300d\uff0c\u4e24\u8005\u5171\u540c\u6c7a\u5b9a\u4e86\u6372\u9905\u7684\u50f9\u503c\uff01]"}, {"question": "\u6df1\u5165\u63a2\u8a0e\uff1aBurrito Craft \u7684\u5546\u5e97\u5347\u7d1a\u7cfb\u7d71\u6709\u54ea\u4e9b\u5206\u652f\uff1f\u4e0d\u540c\u5347\u7d1a\u8def\u7dda\u5c0d\u7d93\u71df\u7b56\u7565\u6709\u4ec0\u9ebc\u5f71\u97ff\uff1f", "answer": "\u5546\u5e97\u5347\u7d1a\u7cfb\u7d71\u4e3b\u8981\u6709\u4e09\u500b\u5206\u652f\uff1a\u5eda\u623f\u5347\u7d1a\u3001\u8fb2\u5834\u5347\u7d1a\u548c\u5546\u5e97\u5916\u89c0\u5347\u7d1a\u3002\u5eda\u623f\u5347\u7d1a\u53ef\u4ee5\u89e3\u9396\u65b0\u7684\u70f9\u98ea\u6280\u5de7\u548c\u81ea\u52d5\u5316\u8a2d\u5099\uff0c\u63d0\u9ad8\u751f\u7522\u6548\u7387\u3002\u8fb2\u5834\u5347\u7d1a\u53ef\u4ee5\u63d0\u9ad8\u98df\u6750\u7684\u7522\u91cf\u548c\u54c1\u8cea\uff0c\u964d\u4f4e\u6210\u672c\u3002\u5546\u5e97\u5916\u89c0\u5347\u7d1a\u53ef\u4ee5\u5438\u5f15\u66f4\u591a\u7684\u9867\u5ba2\uff0c\u63d0\u9ad8\u5ba2\u55ae\u50f9\u3002\u6839\u64da\u81ea\u5df1\u7684\u7d93\u71df\u7b56\u7565\uff0c\u53ef\u4ee5\u9009\u62e9\u4e0d\u540c\u7684\u5347\u7d1a\u8def\u7dda\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u5546\u5e97\u5347\u7d1a\u8def\u7dda\u5716\uff0c\u5305\u542b\u5eda\u623f\u3001\u8fb2\u5834\u3001\u5916\u89c0\u4e09\u500b\u5206\u652f\uff0c\u4ee5\u53ca\u5404\u500b\u5206\u652f\u7684\u5347\u7d1a\u6548\u679c\u3002]"}, {"question": "Burrito Craft \u662f\u5426\u8a08\u756b\u63a8\u51fa\u884c\u52d5\u7248\u672c\uff1f\u5982\u679c\u63a8\u51fa\uff0cPC \u7248\u7684\u6578\u64da\u53ef\u4ee5\u9077\u79fb\u5230\u884c\u52d5\u7aef\u55ce\uff1f", "answer": "\u76ee\u524dBurrito Craft\u7684\u5b98\u65b9\u9084\u6c92\u6709\u660e\u78ba\u516c\u5e03\u63a8\u51fa\u884c\u52d5\u7248\u672c\u7684\u8a08\u756b\uff0c\u4f46\u662f\u958b\u767c\u8005\u4e00\u76f4\u5728\u7a4d\u6975\u6536\u96c6\u73a9\u5bb6\u7684\u56de\u994b\uff0c\u4e26\u8a55\u4f30\u884c\u52d5\u7248\u672c\u7684\u53ef\u884c\u6027\u3002\u5982\u679c\u63a8\u51fa\u884c\u52d5\u7248\u672c\uff0c\u8003\u616e\u5230\u73a9\u5bb6\u7684\u6578\u64da\u4fdd\u5b58\u9700\u6c42\uff0c\u958b\u767c\u8005\u53ef\u80fd\u6703\u63d0\u4f9b\u6578\u64da\u9077\u79fb\u529f\u80fd\uff0c\u65b9\u4fbf\u73a9\u5bb6\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u9593\u540c\u6b65\u904a\u6232\u9032\u5ea6\u3002\u4f46\u5177\u9ad4\u65b9\u6848\u9084\u9700\u7b49\u5f85\u5b98\u65b9\u6b63\u5f0f\u516c\u544a\u3002[\u5f37\u5316\uff1a\u95dc\u6ce8Burrito Craft\u5b98\u65b9\u793e\u7fa4\uff0c\u7b2c\u4e00\u6642\u9593\u7372\u53d6\u6700\u65b0\u6d88\u606f\uff01]"}, {"question": "\u6210\u5c31\u63a7\u5fc5\u770b\uff1aBurrito Craft \u6709\u54ea\u4e9b\u9bae\u70ba\u4eba\u77e5\u7684\u96b1\u85cf\u6210\u5c31\uff1f\u5982\u4f55\u9054\u6210\u9019\u4e9b\u6210\u5c31\u89e3\u9396\u7279\u6b8a\u734e\u52f5\uff1f", "answer": "Burrito Craft\u4e2d\u96b1\u85cf\u8457\u4e00\u4e9b\u975e\u5e38\u6709\u8da3\u7684\u6210\u5c31\uff0c\u4f8b\u5982\u300c\u6372\u9905\u5927\u5e2b\u300d\u3001\u300c\u7f8e\u98df\u8a55\u8ad6\u5bb6\u300d\u548c\u300c\u8fb2\u592b\u300d\u3002\u9019\u4e9b\u6210\u5c31\u901a\u5e38\u9700\u8981\u5b8c\u6210\u4e00\u4e9b\u7279\u6b8a\u7684\u6311\u6230\u624d\u80fd\u89e3\u9396\u3002\u4f8b\u5982\uff0c\u300c\u6372\u9905\u5927\u5e2b\u300d\u53ef\u80fd\u9700\u8981\u88fd\u4f5c\u6240\u6709\u985e\u578b\u7684\u6372\u9905\uff0c\u300c\u7f8e\u98df\u8a55\u8ad6\u5bb6\u300d\u53ef\u80fd\u9700\u8981\u7372\u5f97\u6240\u6709\u9867\u5ba2\u7684\u597d\u8a55\uff0c\u300c\u8fb2\u592b\u300d\u53ef\u80fd\u9700\u8981\u7a2e\u690d\u6240\u6709\u985e\u578b\u7684\u98df\u6750\u3002\u89e3\u9396\u9019\u4e9b\u6210\u5c31\u5f8c\uff0c\u53ef\u4ee5\u7372\u5f97\u7279\u6b8a\u7684\u734e\u52f5\uff0c\u4f8b\u5982\u7a00\u6709\u7684\u98df\u6750\u548c\u88dd\u98fe\u54c1\u3002[\u904a\u6232\u5167\u7bc4\u4f8b\uff1a\u5617\u8a66\u9023\u7e8c\u4e09\u5929\u88fd\u4f5c\u540c\u4e00\u7a2e\u6372\u9905\uff0c\u53ef\u80fd\u6703\u89f8\u767c\u300c\u6372\u9905\u5c08\u5bb6\u300d\u6210\u5c31\uff01]"}]
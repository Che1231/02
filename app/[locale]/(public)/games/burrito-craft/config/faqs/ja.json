[{"question": "\u521d\u5fc3\u8005\u5411\u3051\uff1aBurrito Craft\u3092\u8fc5\u901f\u306b\u59cb\u3081\u308b\u306b\u306f\uff1f\u30de\u30b9\u30bf\u30fc\u3059\u3079\u304d\u57fa\u672c\u64cd\u4f5c\u306f\uff1f", "answer": "Burrito Craft\u306f\u975e\u5e38\u306b\u7c21\u5358\u3067\u3059\uff01\u307e\u305a\u3001\u8fb2\u5834\u3067\u30c8\u30de\u30c8\u3092\u683d\u57f9\u3057\u305f\u308a\u3001\u5e97\u3067\u8089\u3092\u8cb7\u3044\u5165\u308c\u305f\u308a\u3059\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u3001\u98df\u6750\u306e\u5165\u624b\u65b9\u6cd5\u3092\u7fd2\u5f97\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u6b21\u306b\u3001\u53f0\u6240\u3067\u30ec\u30b7\u30d4\u306b\u5f93\u3063\u3066\u98df\u6750\u3092\u7d44\u307f\u5408\u308f\u305b\u3066\u3001\u7f8e\u5473\u3057\u3044\u30bf\u30b3\u30b9\u3092\u4f5c\u308a\u307e\u3059\u3002\u57fa\u672c\u64cd\u4f5c\u306b\u306f\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u306e\u79fb\u52d5\u3001\u98df\u6750\u306e\u63a1\u53d6\u3001\u30bf\u30b3\u30b9\u8abf\u7406\u3001\u30bf\u30b3\u30b9\u8ca9\u58f2\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u521d\u671f\u306f\u3001\u725b\u8089\u30bf\u30b3\u30b9\u3092\u591a\u304f\u4f5c\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b3\u30b9\u30c8\u304c\u4f4e\u304f\u3001\u4eba\u6c17\u304c\u3042\u308a\u307e\u3059\u3002[\u4f8b\uff1a\u53f0\u6240\u306f\u3042\u306a\u305f\u306e\u9b54\u6cd5\u306e\u4f5c\u696d\u53f0\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u98df\u6750\u3092\u9069\u5207\u306b\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3001\u5947\u8de1\u3092\u8d77\u3053\u305b\u308b\u3067\u3057\u3087\u3046\uff01]"}, {"question": "Burrito Craft\u3067\u3001\u30bf\u30b3\u30b9\u3092\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u9ad8\u54c1\u8cea\u306b\u3057\u307e\u3059\u304b\uff1f\u9ad8\u54c1\u8cea\u306e\u30bf\u30b3\u30b9\u306f\u53ce\u76ca\u306b\u3069\u306e\u3088\u3046\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u304b\uff1f", "answer": "\u9ad8\u54c1\u8cea\u306e\u30bf\u30b3\u30b9\u3092\u4f5c\u308b\u305f\u3081\u306b\u306f\u3001\u6b21\u306e\u70b9\u306b\u6ce8\u610f\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\uff1a1.\u65b0\u9bae\u306a\u98df\u6750\u3092\u9078\u3073\u3001\u8fb2\u5834\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3053\u3068\u3067\u98df\u6750\u306e\u54c1\u8cea\u3092\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u30022.\u53f0\u6240\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u3001\u3088\u308a\u9ad8\u5ea6\u306a\u53f0\u6240\u3067\u306f\u65b0\u3057\u3044\u8abf\u7406\u6280\u8853\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u30023.\u30ec\u30b7\u30d4\u3092\u30de\u30b9\u30bf\u30fc\u3057\u3001\u3055\u307e\u3056\u307e\u306a\u98df\u6750\u306e\u7d44\u307f\u5408\u308f\u305b\u306f\u30bf\u30b3\u30b9\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u9ad8\u54c1\u8cea\u306e\u30bf\u30b3\u30b9\u306f\u4fa1\u683c\u304c\u9ad8\u304f\u3001\u9867\u5ba2\u3092\u5f15\u304d\u4ed8\u3051\u3084\u3059\u304f\u3001\u304a\u5e97\u306e\u8a55\u5224\u3092\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u69cb\u6210\u6bd4\u8f03\u8868\uff1a\u901a\u5e38\u306e\u30c8\u30de\u30c8vs\u9ad8\u7d1a\u30c8\u30de\u30c8\u3001\u4fa1\u683c\u5dee\u3092\u4e00\u76ee\u77ad\u7136]"}, {"question": "BC\u30bf\u30b3\u30b9\u5e97\u306e\u8a55\u5224\u306f\u4f55\u306e\u305f\u3081\u306b\u5f79\u7acb\u3061\u307e\u3059\u304b\uff1f\u8a55\u5224\u30ec\u30d9\u30eb\u3092\u8fc5\u901f\u306b\u4e0a\u3052\u308b\u306b\u306f\uff1f", "answer": "\u8a55\u5224\u306f\u3001\u30b2\u30fc\u30e0\u5185\u306e\u3042\u306a\u305f\u306e\u30bf\u30b3\u30b9\u5e97\u306e\u8a55\u5224\u3092\u793a\u3057\u307e\u3059\u3002\u8a55\u5224\u30ec\u30d9\u30eb\u3092\u4e0a\u3052\u308b\u3053\u3068\u3067\u3001\u65b0\u3057\u3044\u98df\u6750\u3001\u30ec\u30b7\u30d4\u3001\u5e97\u5185\u306e\u88c5\u98fe\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u3002\u8a55\u5224\u3092\u8fc5\u901f\u306b\u4e0a\u3052\u308b\u65b9\u6cd5\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\uff1a1.\u6bce\u65e5\u306e\u30bf\u30b9\u30af\u3092\u5b8c\u4e86\u3057\u3001\u591a\u304f\u306e\u8a55\u5224\u5831\u916c\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u30022.\u9ad8\u54c1\u8cea\u306e\u30bf\u30b3\u30b9\u3092\u8ca9\u58f2\u3057\u3001\u9867\u5ba2\u6e80\u8db3\u5ea6\u304c\u9ad8\u3044\u307b\u3069\u3001\u7372\u5f97\u3059\u308b\u8a55\u5224\u3082\u591a\u304f\u306a\u308a\u307e\u3059\u30023.\u30bf\u30b3\u30b9\u30b3\u30f3\u30c6\u30b9\u30c8\u306a\u3069\u306e\u30b2\u30fc\u30e0\u5185\u30a4\u30d9\u30f3\u30c8\u306b\u53c2\u52a0\u3057\u3001\u8c4a\u5bcc\u306a\u8a55\u5224\u5831\u916c\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u8a55\u5224\u5411\u4e0a\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3001\u30bf\u30b9\u30af\u3001\u5546\u54c1\u54c1\u8cea\u3001\u30a4\u30d9\u30f3\u30c8\u306e3\u3064\u306e\u4e3b\u8981\u306a\u5206\u5c90\u3092\u542b\u3080]"}, {"question": "Burrito Craft\u3067\u3001\u3055\u307e\u3056\u307e\u306a\u30bf\u30a4\u30d7\u306e\u9867\u5ba2\u306e\u597d\u307f\u306f\uff1f\u9867\u5ba2\u306e\u597d\u307f\u306b\u5fdc\u3058\u3066\u30bf\u30b3\u30b9\u30ec\u30b7\u30d4\u3092\u3069\u306e\u3088\u3046\u306b\u8abf\u6574\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30b2\u30fc\u30e0\u5185\u306e\u9867\u5ba2\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u5473\u306e\u597d\u307f\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u4e00\u90e8\u306e\u9867\u5ba2\u306f\u8f9b\u3044\u30bf\u30b3\u30b9\u304c\u597d\u304d\u3067\u3001\u4e00\u90e8\u306e\u9867\u5ba2\u306f\u3042\u3063\u3055\u308a\u3057\u305f\u5473\u304c\u597d\u304d\u3067\u3059\u3002\u9867\u5ba2\u306e\u8868\u60c5\u3084\u4f1a\u8a71\u3092\u901a\u3057\u3066\u3001\u5f7c\u3089\u306e\u597d\u307f\u306b\u6c17\u3065\u304f\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30bf\u30b3\u30b9\u30ec\u30b7\u30d4\u3092\u8abf\u6574\u3059\u308b\u3068\u304d\u306f\u3001\u5510\u8f9b\u5b50\u3001\u30d1\u30af\u30c1\u30fc\u3001\u30c1\u30fc\u30ba\u306a\u3069\u306e\u3055\u307e\u3056\u307e\u306a\u8abf\u5473\u6599\u3092\u8ffd\u52a0\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u9867\u5ba2\u306e\u597d\u307f\u306b\u5bfe\u5fdc\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u9ad8\u3044\u53ce\u76ca\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u8907\u6570\u306e\u9078\u629e\u80a2\u306e\u6bd4\u8f03\uff1a\u8f9b\u3044\u30bf\u30b3\u30b9\u30ec\u30b7\u30d4 vs.\u3042\u3063\u3055\u308a\u30bf\u30b3\u30b9\u30ec\u30b7\u30d4]"}, {"question": "\u4e2d\u76e4\u4ee5\u964d\u3001Burrito Craft\u306e\u30bf\u30b3\u30b9\u5e97\u306e\u81ea\u52d5\u7d4c\u55b6\u3092\u5b9f\u73fe\u3059\u308b\u306b\u306f\uff1f\u3069\u306e\u3088\u3046\u306a\u5efa\u7269\u3084\u30a2\u30a4\u30c6\u30e0\u3067\u30b5\u30dd\u30fc\u30c8\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Burrito Craft\u306e\u4e2d\u76e4\u4ee5\u964d\u3001\u6b21\u306e\u65b9\u6cd5\u3067\u81ea\u52d5\u5316\u3055\u308c\u305f\u7d4c\u55b6\u3092\u5b9f\u73fe\u3067\u304d\u307e\u3059\u3002STEP1\uff1a\u3042\u306a\u305f\u306e\u53f0\u6240\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u3001\u81ea\u52d5\u8abf\u7406\u53f0\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u30bf\u30b3\u30b9\u3092\u81ea\u52d5\u7684\u306b\u8abf\u7406\u3067\u304d\u307e\u3059\u3002STEP2\uff1a\u5f93\u696d\u54e1\u3092\u96c7\u7528\u3057\u3001\u30ec\u30b8\u3068\u6e05\u6383\u696d\u52d9\u3092\u62c5\u5f53\u3055\u305b\u307e\u3059\u3002STEP3\uff1a\u81ea\u52d5\u8ca9\u58f2\u6a5f\u3092\u8cfc\u5165\u3057\u3001\u81ea\u52d5\u7684\u306b\u30bf\u30b3\u30b9\u3092\u8ca9\u58f2\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u98df\u6750\u7528\u4fdd\u7ba1\u5eab\u3092\u8cfc\u5165\u3059\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u98df\u6750\u306e\u7121\u99c4\u3092\u6e1b\u3089\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u30b2\u30fc\u30e0\u5185\u4f8b\uff1a\u5e97\u3067\u300c\u81ea\u52d5\u8abf\u7406\u53f0\u300d\u3092\u8cfc\u5165\u3059\u308b\u3068\u3001\u81ea\u52d5\u751f\u7523\u3092\u5b9f\u73fe\u3067\u304d\u307e\u3059\u3002]"}, {"question": "Burrito Craft\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u30ec\u30b7\u30d4\u306f\u3042\u308a\u307e\u3059\u304b\uff1f\u3053\u308c\u3089\u306e\u8b0e\u306e\u30ec\u30b7\u30d4\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u306b\u306f\uff1f", "answer": "\u306f\u3044\u3001Burrito Craft\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u30ec\u30b7\u30d4\u304c\u3044\u304f\u3064\u304b\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30ec\u30b7\u30d4\u306f\u3001\u901a\u5e38\u3001\u7279\u5b9a\u306e\u6761\u4ef6\u304c\u5fc5\u8981\u306a\u5834\u5408\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u4e00\u9023\u306e\u7279\u5225\u306a\u30bf\u30b9\u30af\u3092\u5b8c\u4e86\u3057\u305f\u308a\u3001\u7279\u5b9a\u306e\u98df\u6750\u3092\u96c6\u3081\u305f\u308a\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4e00\u90e8\u306e\u96a0\u3055\u308c\u305f\u30ec\u30b7\u30d4\u306e\u30a2\u30f3\u30ed\u30c3\u30af\u65b9\u6cd5\u306f\u3001\u975e\u5e38\u306b\u96a0\u3055\u308c\u3066\u3044\u3066\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30b2\u30fc\u30e0\u306e\u4e16\u754c\u3092\u6ce8\u610f\u6df1\u304f\u63a2\u6c42\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30d2\u30f3\u30c8\uff1a\u30b2\u30fc\u30e0\u5185\u306eNPC\u306e\u4f1a\u8a71\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u5f7c\u3089\u306f\u3044\u304f\u3064\u304b\u306e\u624b\u304c\u304b\u308a\u3092\u6559\u3048\u3066\u304f\u308c\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002[\u5f69\u86cb\u767a\u898b\uff1a\u7279\u5b9a\u306e\u6642\u9593\u5e2f\u306b\u7279\u5b9a\u306e\u98df\u6750\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u8abf\u7406\u3059\u308b\u3068\u3001\u96a0\u3055\u308c\u305f\u30ec\u30b7\u30d4\u304c\u30c8\u30ea\u30ac\u30fc\u3055\u308c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\uff01]"}, {"question": "Burrito Craft\u306e\u6570\u5024\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f\u98df\u6750\u306e\u54c1\u8cea\u3001\u8abf\u7406\u6280\u8853\u306f\u6700\u7d42\u7684\u306a\u30bf\u30b3\u30b9\u5c5e\u6027\u306b\u3069\u306e\u3088\u3046\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u304b\uff1f", "answer": "Burrito Craft\u306e\u6570\u5024\u30b7\u30b9\u30c6\u30e0\u306f\u6bd4\u8f03\u7684\u8907\u96d1\u3067\u3059\u304c\u3001\u30b7\u30f3\u30d7\u30eb\u306b\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3067\u304d\u307e\u3059\u3002\u98df\u6750\u306e\u54c1\u8cea\u306f\u3001\u30bf\u30b3\u30b9\u306e\u57fa\u672c\u7684\u306a\u5c5e\u6027\u3001\u305f\u3068\u3048\u3070\u98a8\u5473\u3068\u6e80\u8179\u611f\u3092\u76f4\u63a5\u7684\u306b\u5f71\u97ff\u3057\u307e\u3059\u3002\u8abf\u7406\u6280\u8853\u306f\u3001\u30bf\u30b3\u30b9\u306b\u8ffd\u52a0\u7684\u306a\u5c5e\u6027\u3001\u305f\u3068\u3048\u3070\u98df\u611f\u3068\u5916\u89b3\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u7570\u306a\u308b\u98df\u6750\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3001\u7570\u306a\u308b\u5316\u5b66\u53cd\u5fdc\u304c\u8d77\u3053\u308a\u3001\u6700\u7d42\u7684\u306a\u30bf\u30b3\u30b9\u5c5e\u6027\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002[\u4f8b\uff1a\u98df\u6750\u306e\u54c1\u8cea\u3092\u30bf\u30b3\u30b9\u300c\u57fa\u790e\u300d\u3001\u8abf\u7406\u6280\u8853\u3092\u300c\u88c5\u98fe\u300d\u3068\u8003\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u30022\u3064\u306e\u8981\u7d20\u306f\u30bf\u30b3\u30b9\u4fa1\u5024\u3092\u6c7a\u5b9a\u3057\u307e\u3059\uff01]"}, {"question": "\u6df1\u304f\u6398\u308a\u4e0b\u3052\u3066\uff1aBurrito Craft\u306e\u5e97\u8217\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u30b7\u30b9\u30c6\u30e0\u306b\u306f\u3069\u306e\u3088\u3046\u306a\u5206\u5c90\u304c\u3042\u308a\u307e\u3059\u304b\uff1f\u3055\u307e\u3056\u307e\u306a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u30eb\u30fc\u30c8\u306f\u7d4c\u55b6\u6226\u7565\u306b\u3069\u306e\u3088\u3046\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u304b\uff1f", "answer": "\u5e97\u8217\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u30b7\u30b9\u30c6\u30e0\u306b\u306f\u4e3b\u306b3\u3064\u306e\u5206\u5c90\u304c\u3042\u308a\u307e\u3059\u3002\u53f0\u6240\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3001\u8fb2\u5834\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3001\u5e97\u8217\u5916\u89b3\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3067\u3059\u3002\u53f0\u6240\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3067\u306f\u3001\u65b0\u3057\u3044\u8abf\u7406\u6280\u8853\u3068\u81ea\u52d5\u5316\u3055\u308c\u305f\u8a2d\u5099\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u3001\u751f\u7523\u52b9\u7387\u3092\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u8fb2\u5834\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u3001\u98df\u6750\u306e\u53ce\u7a6b\u91cf\u3068\u54c1\u8cea\u3092\u9ad8\u3081\u3001\u30b3\u30b9\u30c8\u3092\u524a\u6e1b\u3067\u304d\u307e\u3059\u3002\u5e97\u8217\u5916\u89b3\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u3001\u3088\u308a\u591a\u304f\u306e\u9867\u5ba2\u3092\u5f15\u304d\u3064\u3051\u3001\u5ba2\u5358\u4fa1\u3092\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u81ea\u5206\u306e\u7d4c\u55b6\u6226\u7565\u306b\u5408\u308f\u305b\u3066\u3001\u3055\u307e\u3056\u307e\u306a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u30eb\u30fc\u30c8\u3092\u9078\u629e\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u5e97\u8217\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u30eb\u30fc\u30c8\u30c1\u30e3\u30fc\u30c8\u3001\u53f0\u6240\u3001\u8fb2\u5834\u3001\u5916\u89b3\u306e3\u3064\u306e\u5206\u5c90\u3068\u3001\u5404\u5206\u5c90\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u52b9\u679c\u3092\u542b\u3080]"}, {"question": "Burrito Craft\u306f\u30e2\u30d0\u30a4\u30eb\u7248\u3092\u30ea\u30ea\u30fc\u30b9\u3059\u308b\u4e88\u5b9a\u3067\u3059\u304b\uff1f\u30ea\u30ea\u30fc\u30b9\u3059\u308b\u5834\u5408\u3001PC\u7248\u306e\u30c7\u30fc\u30bf\u306f\u30e2\u30d0\u30a4\u30eb\u7248\u306b\u79fb\u884c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u73fe\u5728\u3001Burrito Craft\u306e\u516c\u5f0f\u306f\u3001\u30e2\u30d0\u30a4\u30eb\u7248\u306e\u30ea\u30ea\u30fc\u30b9\u8a08\u753b\u3092\u660e\u78ba\u306b\u767a\u8868\u3057\u3066\u3044\u307e\u305b\u3093\u3002\u3057\u304b\u3057\u3001\u958b\u767a\u8005\u306f\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30d5\u30a3\u30fc\u30c9\u30d0\u30c3\u30af\u3092\u7a4d\u6975\u7684\u306b\u53ce\u96c6\u3057\u3001\u30e2\u30d0\u30a4\u30eb\u7248\u306e\u5b9f\u73fe\u53ef\u80fd\u6027\u3092\u8a55\u4fa1\u3057\u3066\u3044\u307e\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u7248\u304c\u30ea\u30ea\u30fc\u30b9\u3055\u308c\u305f\u5834\u5408\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30c7\u30fc\u30bf\u4fdd\u5b58\u8981\u6c42\u3092\u8003\u616e\u3057\u3066\u3001\u958b\u767a\u8005\u306f\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u30b2\u30fc\u30e0\u306e\u9032\u884c\u72b6\u6cc1\u3092\u540c\u671f\u3059\u308b\u3001\u30c7\u30fc\u30bf\u79fb\u884c\u6a5f\u80fd\u3092\u63d0\u4f9b\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3060\u3057\u3001\u5177\u4f53\u7684\u306a\u8a08\u753b\u306f\u3001\u516c\u5f0f\u767a\u8868\u3092\u5f85\u3064\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002[\u63a8\u5968\uff1aBurrito Craft\u306e\u516c\u5f0f\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u306b\u6ce8\u76ee\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6700\u65b0\u60c5\u5831\u3092\u5165\u624b\u3059\u308b\u306b\u306f\u6700\u826f\u306e\u624b\u6bb5\u3067\u3059\uff01]"}, {"question": "\u9054\u6210\u5ea6\u91cd\u8996\uff1aBurrito Craft\u306b\u306f\u3001\u3042\u307e\u308a\u77e5\u3089\u308c\u3066\u3044\u306a\u3044\u96a0\u3055\u308c\u305f\u9054\u6210\u5ea6\u306f\u3042\u308a\u307e\u3059\u304b\uff1f\u3053\u308c\u3089\u306e\u9054\u6210\u5ea6\u3092\u9054\u6210\u3057\u3001\u7279\u5225\u306a\u5831\u916c\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u306b\u306f\uff1f", "answer": "Burrito Craft\u306b\u306f\u3001\u975e\u5e38\u306b\u8208\u5473\u6df1\u3044\u9054\u6210\u5ea6\u3001\u305f\u3068\u3048\u3070\u300c\u30bf\u30b3\u30b9\u8077\u4eba\u300d\u3001 \u300c\u7f8e\u98df\u8a55\u8ad6\u5bb6\u300d\u3001\u304a\u3088\u3073\u300c\u8fb2\u5834\u4e3b\u300d\u304c\u96a0\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u9054\u6210\u5ea6\u306f\u3001\u901a\u5e38\u3001\u3044\u304f\u3064\u304b\u306e\u7279\u5225\u306a\u6311\u6226\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30bf\u30b3\u30b9\u8077\u4eba\u300d\u306f\u3001\u3059\u3079\u3066\u306e\u30bf\u30a4\u30d7\u306e\u30bf\u30b3\u30b9\u3092\u4f5c\u6210\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u300c\u7f8e\u98df\u8a55\u8ad6\u5bb6\u300d\u306f\u3059\u3079\u3066\u306e\u9867\u5ba2\u304b\u3089\u306e\u8cde\u8cdb\u3092\u7372\u5f97\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u300c\u8fb2\u5834\u4e3b\u300d\u306f\u3059\u3079\u3066\u306e\u30bf\u30a4\u30d7\u306e\u98df\u6750\u3092\u683d\u57f9\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u3053\u308c\u3089\u306e\u9054\u6210\u5ea6\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u3068\u3001\u7a00\u5c11\u306a\u98df\u6750\u3084\u88c5\u98fe\u54c1\u306a\u3069\u3001\u7279\u5225\u306a\u5831\u916c\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002[\u30b2\u30fc\u30e0\u5185\u4f8b\uff1a3\u65e5\u9593\u9023\u7d9a\u3057\u3066\u540c\u3058\u7a2e\u985e\u306e\u30bf\u30b3\u30b9\u3092\u4f5c\u308d\u3046\u3068\u3059\u308b\u3068\u3001\u300c\u30bf\u30b3\u30b9\u96c6\u4e2d\u8005\u300d\u306e\u9054\u6210\u5ea6\u304c\u30a2\u30af\u30c6\u30a3\u30d6\u306b\u306a\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\uff01]"}]
[{"question": "\ud30c\ud30c\uc2a4 \ubca0\uc774\ucee4\ub9ac\uc544 \ucd08\ubcf4\uc790\ub294 \uc5b4\ub5bb\uac8c \ud6a8\uacfc\uc801\uc73c\ub85c \uac8c\uc784\uc744 \uc2dc\uc791\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud30c\ud30c\uc2a4 \ubca0\uc774\ucee4\ub9ac\uc544\uc5d0\uc11c \ud6a8\uacfc\uc801\uc73c\ub85c \uac8c\uc784\uc744 \uc2dc\uc791\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1 - \uc8fc\ubb38 \ucc3d, \uc81c\ube75\ub300, \uc7a5\uc2dd\ub300 \ub4f1 \uac8c\uc784 \uc778\ud130\ud398\uc774\uc2a4\ub97c \uc219\uc9c0\ud558\uc138\uc694. STEP2 - \uae30\ubcf8\uc801\uc778 \uba38\ud540 \uc8fc\ubb38\uacfc \uac19\uc774 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc744 \ud30c\uc545\ud558\uae30 \uc704\ud574 \uac04\ub2e8\ud55c \uc8fc\ubb38\ubd80\ud130 \uc2dc\uc791\ud558\uc138\uc694. STEP3 - \ud301\uacfc \uace0\uac1d \ub9cc\uc871\ub3c4\ub97c \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \uc815\ud655\uc131\uacfc \uc18d\ub3c4\uc5d0 \uc9d1\uc911\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uba38\ud540\uc744 \uad6c\uc6b8 \ub54c, \uc801\uc808\ud55c \uc2dc\uae30\uc5d0 \ub4a4\uc9d1\uc5b4 \uace8\uace0\ub8e8 \uc775\ud788\ub3c4\ub85d \uc8fc\uc758\ud558\uc138\uc694."}, {"question": "\ud30c\ud30c\uc2a4 \ubca0\uc774\ucee4\ub9ac\uc544\uc5d0\uc11c \uc5ec\ub7ec \uc8fc\ubb38\uc744 \uad00\ub9ac\ud558\uae30 \uc704\ud55c \uc8fc\uc694 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc5ec\ub7ec \uc8fc\ubb38\uc744 \uad00\ub9ac\ud558\ub824\uba74 \uc2dc\uac04 \uad00\ub9ac\uc640 \uc6b0\uc120\uc21c\uc704 \uacb0\uc815\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1 - \ud56d\uc0c1 \uc8fc\ubb38 \ubaa9\ub85d\uc744 \ud655\uc778\ud558\uace0 \ub300\uae30 \uc2dc\uac04\uc774 \uac00\uc7a5 \uc9e7\uc740 \uc8fc\ubb38\uc744 \uc6b0\uc120\uc21c\uc704\ub85c \ud558\uc138\uc694. STEP2 - \uace0\uac1d\uc758 \uc120\ud638\ub3c4\uc640 \ud2b9\ubcc4 \uc694\uccad\uc744 \ud30c\uc545\ud558\uae30 \uc704\ud574 '\uc8fc\ubb38 \ucc3d'\uc744 \ud65c\uc6a9\ud558\uc138\uc694. STEP3 - \ud55c \uac00\uc9c0 \uc694\ub9ac\ub97c \uad6c\uc6b0\uba74\uc11c \ub2e4\ub978 \uc694\ub9ac\ub97c \uc7a5\uc2dd\ud558\ub294 \uac83\ucc98\ub7fc \uc791\uc5c5\uc744 \uc911\ubcf5\ud558\uc5ec \uc791\uc5c5 \ud750\ub984\uc744 \ucd5c\uc801\ud654\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ucf00\uc774\ud06c\ub97c \uad6c\uc6b8 \ub54c \ub2e4\ub978 \uc8fc\ubb38\uc758 \ud06c\ub9bc\uc744 \uc900\ube44\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c\uc2a4 \ubca0\uc774\ucee4\ub9ac\uc544\uc5d0\uc11c \uc9c4\ud589\ud558\uae30\uc5d0 \uac00\uc7a5 \uc720\uc775\ud55c \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud30c\ud30c\uc2a4 \ubca0\uc774\ucee4\ub9ac\uc544\uc5d0\uc11c \uac00\uc7a5 \uc720\uc775\ud55c \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \ud6a8\uc728\uc131\uacfc \ud488\uc9c8\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \uc5c5\uadf8\ub808\uc774\ub4dc\uc785\ub2c8\ub2e4. STEP1 - \uad6c\uc6b0\ub294 \uc2dc\uac04\uc744 \uc904\uc774\uace0 \uade0\uc77c\uc131\uc744 \ub192\uc774\uae30 \uc704\ud574 '\uc624\ube10 \uc5c5\uadf8\ub808\uc774\ub4dc'\ub97c \ud22c\uc790\ud558\uc138\uc694. STEP2 - '\uc7a5\uc2dd \ub3c4\uad6c \uc5c5\uadf8\ub808\uc774\ub4dc'\ub97c \ud1b5\ud574 \ub354 \uc815\uad50\ud55c \ub514\uc790\uc778\uc744 \ub9cc\ub4e4 \uc218 \uc788\uc5b4 \uace0\uac1d \ub9cc\uc871\ub3c4\ub97c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP3 - \ub3d9\uc2dc\uc5d0 \ub354 \ub9ce\uc740 \uc8fc\ubb38\uc744 \ucc98\ub9ac\ud560 \uc218 \uc788\ub3c4\ub85d '\uc8fc\ubb38 \ucc3d'\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc624\ube10 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \ud1b5\ud574 \ucfe0\ud0a4\uac00 \uade0\uc77c\ud558\uac8c \uad6c\uc6cc\uc838 \ud0c0\ub294 \ubaa8\uc11c\ub9ac\uac00 \uc904\uc5b4\ub4ed\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c\uc2a4 \ubca0\uc774\ucee4\ub9ac\uc544\uc5d0\uc11c \uc81c\ube75 \uc2dc \uc2dc\uac04\uc740 \uc65c \uc911\uc694\ud558\uba70, \uc5b4\ub5bb\uac8c \uc219\ub2ec\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc2dc\uac04\uc740 \uc81c\ube75 \uc81c\ud488\uc758 \ud488\uc9c8\uacfc \uace0\uac1d \ub9cc\uc871\ub3c4\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc2dc\uac04 \uc219\ub2ec \ubc29\ubc95: STEP1 - \ubc18\uc8fd\uc758 \uc0c9\uae54 \ubcc0\ud654\uc640 \uac19\uc740 \uc2dc\uac01\uc801 \ub2e8\uc11c\uc5d0 \uc8fc\uc758\ud558\uc2ed\uc2dc\uc624. STEP2 - \uac8c\uc784 \ub0b4 \ud0c0\uc774\uba38\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc870\ub9ac \uc2dc\uac04\uc744 \uc815\ud655\ud558\uac8c \ucd94\uc801\ud558\uc138\uc694. STEP3 - \ub2e4\uc591\ud55c \uc81c\ud488\uc73c\ub85c \uc5f0\uc2b5\ud558\uc5ec \uac01\uac01\uc758 \uad6c\uc774 \uc2dc\uac04\uc5d0 \ub300\ud55c \uac10\uc744 \uc775\ud788\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc644\ubcbd\ud558\uac8c \uc2dc\uac04\uc744 \ub9de\ucd98 \ucf00\uc774\ud06c\ub294 \ud669\uae08\ube5b \uac08\uc0c9 \uac89\ud45c\uba74\uacfc \ubd80\ub4dc\ub7fd\uace0 \ud48d\uc131\ud55c \ub0b4\ubd80\ub97c \uac00\uc9c0\uace0 \uc788\uc744 \uac83\uc785\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c\uc2a4 \ubca0\uc774\ucee4\ub9ac\uc544\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uc5b4\ub5a4 \uc694\uc18c\uac00 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "\ud30c\ud30c\uc2a4 \ubca0\uc774\ucee4\ub9ac\uc544\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc815\ud655\uc131, \uc18d\ub3c4 \ubc0f \uc81c\ud488\uc758 \uc678\uad00\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. STEP1 - \uc815\ud655\uc131\uc740 \uc8fc\ubb38 \uc138\ubd80 \uc815\ubcf4\ub97c \uc815\ud655\ud558\uac8c \ub530\ub974\ub294 \uac83\uc744 \uc758\ubbf8\ud558\uba70, \uc608\ub97c \ub4e4\uc5b4, \ud30c\uc774 \uc885\ub958\uc640 \ud1a0\ud551\uacfc \uac19\uc2b5\ub2c8\ub2e4. STEP2 - \uc18d\ub3c4\ub294 \ud488\uc9c8\uc744 \uc800\ud574\ud558\uc9c0 \uc54a\uace0 \uc8fc\ubb38\uc744 \uc5bc\ub9c8\ub098 \ube60\ub974\uac8c \uc644\ub8cc\ud558\ub294\uc9c0\ub97c \uce21\uc815\ud569\ub2c8\ub2e4. STEP3 - \uc81c\ud488\uc758 \ubbf8\uc801 \ub9e4\ub825\uc73c\ub85c \ud310\ub2e8\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc62c\ubc14\ub978 \ud1a0\ud551\uc73c\ub85c \uc798 \uc7a5\uc2dd\ub41c \ucef5\ucf00\uc774\ud06c\ub294 \ub2e8\uc21c\ud55c \ucef5\ucf00\uc774\ud06c\ubcf4\ub2e4 \ub354 \ub192\uc740 \uc810\uc218\ub97c \ubc1b\uc2b5\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c\uc2a4 \ubca0\uc774\ucee4\ub9ac\uc544\uc5d0\uc11c \ud301\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \ucf00\uc774\ud06c\ub97c \uc7a5\uc2dd\ud558\ub294 \uac00\uc7a5 \uc88b\uc740 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc7a5\uc2dd\uc744 \ud1b5\ud574 \ud301\uc744 \uadf9\ub300\ud654\ud558\ub824\uba74: STEP1 - \uace0\uac1d\uc758 \ud1a0\ud551 \ubc0f \ub514\uc790\uc778\uc5d0 \ub300\ud55c \ud2b9\ubcc4\ud55c \uc694\uccad\uc744 \ud56d\uc0c1 \ub530\ub974\uc138\uc694. STEP2 - \ucf00\uc774\ud06c\uc5d0 \uc2dc\uac01\uc801 \ub9e4\ub825\uc744 \uc8fc\uae30 \uc704\ud574 \ub2e4\uc591\ud55c \uc0c9\uc0c1\uacfc \ud328\ud134\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. STEP3 - \uc7a5\uc2dd\uc774 \uae54\ub054\ud558\uace0 \ub300\uce6d\uc801\uc774\ub3c4\ub85d \ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uade0\ud615 \uc7a1\ud78c \ubfcc\ub824\uc9c4 \uc124\ud0d5\uacfc \uae54\ub054\ud558\uac8c \uc9dc\ub0b8 \ud06c\ub9bc\uc774 \uc788\ub294 \ucef5\ucf00\uc774\ud06c\ub294 \ub192\uc740 \ud301\uc744 \uc5bb\uc744 \uac00\ub2a5\uc131\uc774 \ud07d\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c\uc2a4 \ubca0\uc774\ucee4\ub9ac\uc544\uc5d0\uc11c \uac01 \uc5ed\ud560 \uac04\uc758 \uc791\uc5c5 \ud750\ub984\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc791\uc5c5 \ud750\ub984\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc804\ub7b5\uc801 \uacc4\ud68d\uacfc \uba40\ud2f0\ud0dc\uc2a4\ud0b9\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1 - \ucf00\uc774\ud06c\ub098 \ud30c\uc774\uc640 \uac19\uc774 \uc81c\ube75\uc5d0 \uc2dc\uac04\uc774 \uc624\ub798 \uac78\ub9ac\ub294 \ud488\ubaa9\ubd80\ud130 \uc2dc\uc791\ud558\uc138\uc694. STEP2 - \uadf8\ub7f0 \ub3d9\uc548, \uc7a5\uc2dd\ub300\uc5d0\uc11c \ub2e4\ub978 \uc8fc\ubb38\uc758 \ud1a0\ud551\uacfc \ud06c\ub9bc\uc744 \uc900\ube44\ud558\uc138\uc694. STEP3 - \uacfc\uc5f4\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \uacc4\uc18d\ud574\uc11c \uc81c\ube75 \uc9c4\ud589 \uc0c1\ud669\uc744 \ubaa8\ub2c8\ud130\ub9c1\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud30c\uc774\ub97c \uad7d\ub294 \ub3d9\uc548 \ub2e4\ub978 \uc8fc\ubb38\uc758 \ud718\ud551 \ud06c\ub9bc\uacfc \uacfc\uc77c \ud1a0\ud551\uc744 \uc900\ube44\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ud30c\ud30c\uc2a4 \ubca0\uc774\ucee4\ub9ac\uc544\ub97c \uc2e4\ud589\ud558\uae30 \uc704\ud55c \uae30\uc220\uc801 \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud30c\ud30c\uc2a4 \ubca0\uc774\ucee4\ub9ac\uc544\uc758 \uae30\uc220\uc801 \uc694\uad6c \uc0ac\ud56d\uc740 \ud50c\ub7ab\ud3fc\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. PC\uc5d0\uc11c\ub294 \ucd5c\uc18c 2GB RAM\uacfc DirectX 9.0 \ud638\ud658 \uadf8\ub798\ud53d \uce74\ub4dc\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ubaa8\ubc14\uc77c \uae30\uae30\uc5d0\uc11c\ub294 iOS 10.0 \uc774\uc0c1 \ub610\ub294 Android 5.0 \uc774\uc0c1\uc5d0\uc11c \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, iPhone 8\uc5d0\uc11c \uac8c\uc784\uc740 \ub192\uc740 \uadf8\ub798\ud53d \uc124\uc815\uacfc \ucd5c\uc18c\ud55c\uc758 \uc9c0\uc5f0\uc73c\ub85c \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ub429\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c\uc2a4 \ubca0\uc774\ucee4\ub9ac\uc544\uc5d0\uc11c \uc228\uaca8\uc9c4 \ub808\uc2dc\ud53c\uc640 \uc544\uc774\ud15c\uc744 \uc5b4\ub5bb\uac8c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc228\uaca8\uc9c4 \ub808\uc2dc\ud53c\uc640 \uc544\uc774\ud15c\uc740 \ud2b9\uc815 \ucc4c\ub9b0\uc9c0\uc640 \ub192\uc740 \uc810\uc218\ub97c \ub2ec\uc131\ud558\uc5ec \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1 - \ub9e4\uc77c \ucc4c\ub9b0\uc9c0\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc9c0\uc18d\uc801\uc73c\ub85c \uc5bb\uc5b4 \ud76c\uadc0 \uc7ac\ub8cc\ub97c \uc7a0\uae08 \ud574\uc81c\ud558\uc138\uc694. STEP2 - \ud558\ub8e8 \ub3d9\uc548 \ubaa8\ub4e0 \uace0\uac1d \uc8fc\ubb38\uc744 \uc2e4\uc218 \uc5c6\uc774 \uc644\ub8cc\ud558\uc5ec \ud2b9\ubcc4 \ub808\uc2dc\ud53c\ub97c \uc7a0\uae08 \ud574\uc81c\ud558\uc138\uc694. STEP3 - \uacc4\uc808 \uc774\ubca4\ud2b8\uc5d0 \ucc38\uc5ec\ud558\uc5ec \ub3c5\uc810 \uc544\uc774\ud15c\uc744 \uc5bb\uc73c\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud560\ub85c\uc708 \uc774\ubca4\ud2b8 \uae30\uac04 \ub3d9\uc548 \uc77c\ub828\uc758 \ud14c\ub9c8 \uc8fc\ubb38\uc744 \uc644\ub8cc\ud558\uc5ec \ubb34\uc2dc\ubb34\uc2dc\ud55c \ud14c\ub9c8\uc758 \ucf00\uc774\ud06c \ub808\uc2dc\ud53c\ub97c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ubaa8\ubc14\uc77c \ubc0f PC \ubc84\uc804\uc758 \ud30c\ud30c\uc2a4 \ubca0\uc774\ucee4\ub9ac\uc544 \uac8c\uc784\ud50c\ub808\uc774 \uacbd\ud5d8\uc758 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uac8c\uc784\ud50c\ub808\uc774 \uacbd\ud5d8\uc740 \uc8fc\ub85c \ucee8\ud2b8\ub864 \ubc29\uc2dd\uacfc \ud654\uba74 \ubd80\ub3d9\uc0b0\uc758 \ucc28\uc774\ub85c \uc778\ud574 \ub2e4\ub985\ub2c8\ub2e4. PC\uc5d0\uc11c\ub294 \uc815\ubc00\ud55c \uc81c\uc5b4\ub97c \uc704\ud574 \ub9c8\uc6b0\uc2a4\ub97c \uc0ac\uc6a9\ud558\uba70, \uc138\ubd80\uc801\uc778 \uc7a5\uc2dd\uc5d0 \uc720\ub9ac\ud569\ub2c8\ub2e4. \ubaa8\ubc14\uc77c\uc5d0\uc11c\ub294 \ud130\uce58 \ucee8\ud2b8\ub864\uc774 \ud3b8\ub9ac\ud558\uc9c0\ub9cc \uc815\ubc00\ub3c4\uac00 \ubd80\uc871\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c PC \ubc84\uc804\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \uadf8\ub798\ud53d\uc774 \ub354 \uc88b\uace0 \uc131\ub2a5\uc774 \ub354 \uc548\uc815\uc801\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc815\uad50\ud55c \ud328\ud134\uc73c\ub85c \ucf00\uc774\ud06c\ub97c \uc7a5\uc2dd\ud558\ub294 \uac83\uc740 \ub9c8\uc6b0\uc2a4 \ucee8\ud2b8\ub864\uc758 \uc815\ubc00\ub3c4\ub85c \uc778\ud574 PC\uc5d0\uc11c \ub354 \uc27d\uc2b5\ub2c8\ub2e4."}]
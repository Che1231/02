[{"question": "\u30d1\u30d1\u30ba\u30d9\u30fc\u30ab\u30ea\u30a2\u3092\u52b9\u679c\u7684\u306b\u59cb\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30ba\u30d9\u30fc\u30ab\u30ea\u30a2\u3067\u52b9\u679c\u7684\u306b\u59cb\u3081\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71 \u2013 \u30aa\u30fc\u30c0\u30fc\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u3001\u30d9\u30fc\u30ad\u30f3\u30b0\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u3001\u30c7\u30b3\u30ec\u30fc\u30b7\u30e7\u30f3\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u306a\u3069\u3001\u30b2\u30fc\u30e0\u30a4\u30f3\u30bf\u30fc\u30d5\u30a7\u30fc\u30b9\u3092\u7406\u89e3\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 \u2013 \u57fa\u672c\u7684\u306a\u30de\u30d5\u30a3\u30f3\u30aa\u30fc\u30c0\u30fc\u306a\u3069\u3001\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u628a\u63e1\u3059\u308b\u305f\u3081\u306b\u7c21\u5358\u306a\u30aa\u30fc\u30c0\u30fc\u304b\u3089\u59cb\u3081\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 \u2013 \u30c1\u30c3\u30d7\u3084\u9867\u5ba2\u6e80\u8db3\u5ea6\u3092\u6700\u5927\u9650\u306b\u4e0a\u3052\u308b\u305f\u3081\u306b\u3001\u6b63\u78ba\u3055\u3068\u30b9\u30d4\u30fc\u30c9\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30de\u30d5\u30a3\u30f3\u3092\u713c\u304f\u3068\u304d\u306f\u3001\u9069\u5207\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u3072\u3063\u304f\u308a\u8fd4\u3059\u3053\u3068\u3067\u3001\u5747\u4e00\u306b\u713c\u304d\u4e0a\u304c\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u30ba\u30d9\u30fc\u30ab\u30ea\u30a2\u3067\u8907\u6570\u306e\u30aa\u30fc\u30c0\u30fc\u3092\u7ba1\u7406\u3059\u308b\u305f\u3081\u306e\u91cd\u8981\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u8907\u6570\u306e\u30aa\u30fc\u30c0\u30fc\u3092\u7ba1\u7406\u3059\u308b\u306b\u306f\u3001\u6642\u9593\u7ba1\u7406\u3068\u512a\u5148\u9806\u4f4d\u4ed8\u3051\u306e\u4e21\u65b9\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71 \u2013 \u5e38\u306b\u30aa\u30fc\u30c0\u30fc\u30ea\u30b9\u30c8\u3092\u78ba\u8a8d\u3057\u3001\u5f85\u3061\u6642\u9593\u304c\u6700\u77ed\u306e\u30aa\u30fc\u30c0\u30fc\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 \u2013 \u9867\u5ba2\u306e\u597d\u307f\u3084\u7279\u5225\u306a\u30ea\u30af\u30a8\u30b9\u30c8\u3092\u8ffd\u8de1\u3059\u308b\u305f\u3081\u306b\"\u30aa\u30fc\u30c0\u30fc\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\"\u3092\u6d3b\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 \u2013 \u3042\u308b\u30a2\u30a4\u30c6\u30e0\u3092\u713c\u304d\u306a\u304c\u3089\u5225\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u30c7\u30b3\u30ec\u30fc\u30b7\u30e7\u30f3\u3059\u308b\u306a\u3069\u3001\u4f5c\u696d\u3092\u91cd\u8907\u3055\u305b\u308b\u3053\u3068\u3067\u4f5c\u696d\u52b9\u7387\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30b1\u30fc\u30ad\u3092\u713c\u3044\u3066\u3044\u308b\u9593\u306b\u3001\u5225\u306e\u30aa\u30fc\u30c0\u30fc\u306e\u30d5\u30ed\u30b9\u30c6\u30a3\u30f3\u30b0\u306e\u6e96\u5099\u3092\u59cb\u3081\u3089\u308c\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u30ba\u30d9\u30fc\u30ab\u30ea\u30a2\u3067\u9032\u6b69\u3059\u308b\u305f\u3081\u306b\u6700\u9069\u306a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30ba\u30d9\u30fc\u30ab\u30ea\u30a2\u3067\u6700\u3082\u52b9\u679c\u7684\u306a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u3001\u52b9\u7387\u6027\u3068\u54c1\u8cea\u3092\u9ad8\u3081\u308b\u3082\u306e\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71 \u2013 \u30d9\u30fc\u30ad\u30f3\u30b0\u6642\u9593\u3092\u77ed\u7e2e\u3057\u3001\u713c\u304d\u52a0\u6e1b\u3092\u5747\u4e00\u306b\u3059\u308b\u305f\u3081\u306b\"\u30aa\u30fc\u30d6\u30f3\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\"\u306b\u6295\u8cc7\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 \u2013 \"\u30c7\u30b3\u30ec\u30fc\u30b7\u30e7\u30f3\u30c4\u30fc\u30eb\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\"\u306f\u3001\u3088\u308a\u8907\u96d1\u306a\u30c7\u30b6\u30a4\u30f3\u304c\u53ef\u80fd\u306b\u306a\u308a\u3001\u9867\u5ba2\u6e80\u8db3\u5ea6\u3092\u9ad8\u3081\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 \u2013 \u8907\u6570\u306e\u30aa\u30fc\u30c0\u30fc\u3092\u540c\u6642\u306b\u51e6\u7406\u3059\u308b\u305f\u3081\u306b\"\u30aa\u30fc\u30c0\u30fc\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\"\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30aa\u30fc\u30d6\u30f3\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u30af\u30c3\u30ad\u30fc\u304c\u5747\u7b49\u306b\u713c\u304d\u4e0a\u304c\u308a\u3001\u713c\u304d\u8272\u304c\u3064\u304b\u306a\u3044\u3088\u3046\u306b\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u30ba\u30d9\u30fc\u30ab\u30ea\u30a2\u3067\u3001\u713c\u304d\u6642\u9593\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u3069\u306e\u3088\u3046\u306b\u7fd2\u5f97\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u713c\u304d\u6642\u9593\u306f\u3001\u713c\u304d\u83d3\u5b50\u306e\u54c1\u8cea\u3068\u9867\u5ba2\u6e80\u8db3\u5ea6\u3092\u76f4\u63a5\u7684\u306b\u5de6\u53f3\u3059\u308b\u305f\u3081\u3001\u91cd\u8981\u3067\u3059\u3002\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u7fd2\u5f97\u3059\u308b\u306b\u306f\u4ee5\u4e0b\u306e\u30b9\u30c6\u30c3\u30d7\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71 \u2013 \u751f\u5730\u306e\u8272\u5408\u3044\u306e\u5909\u5316\u306a\u3069\u3001\u8996\u899a\u7684\u306a\u624b\u304c\u304b\u308a\u306b\u6ce8\u610f\u3092\u6255\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 \u2013 \u30b2\u30fc\u30e0\u5185\u306e\u30bf\u30a4\u30de\u30fc\u3092\u4f7f\u7528\u3057\u3066\u3001\u8abf\u7406\u6642\u9593\u3092\u6b63\u78ba\u306b\u628a\u63e1\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 \u2013 \u3055\u307e\u3056\u307e\u306a\u30a2\u30a4\u30c6\u30e0\u3067\u7df4\u7fd2\u3057\u3066\u3001\u305d\u308c\u305e\u308c\u306e\u713c\u304d\u6642\u9593\u3092\u628a\u63e1\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5b8c\u74a7\u306b\u713c\u304d\u4e0a\u304c\u3063\u305f\u30b1\u30fc\u30ad\u306f\u3001\u713c\u304d\u8272\u304c\u91d1\u8336\u8272\u3067\u3001\u5185\u90e8\u304c\u3075\u308f\u3075\u308f\u3057\u3066\u3044\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u30ba\u30d9\u30fc\u30ab\u30ea\u30a2\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f\u30b9\u30b3\u30a2\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u8981\u56e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30ba\u30d9\u30fc\u30ab\u30ea\u30a2\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6b63\u78ba\u3055\u3001\u30b9\u30d4\u30fc\u30c9\u3001\u305d\u3057\u3066\u30d7\u30ec\u30bc\u30f3\u30c6\u30fc\u30b7\u30e7\u30f3\u306e3\u3064\u306e\u8981\u7d20\u306b\u3088\u3063\u3066\u5f71\u97ff\u3055\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71 \u2013 \u6b63\u78ba\u3055\u306f\u3001\u30aa\u30fc\u30c0\u30fc\u306e\u8a73\u7d30\uff08\u9069\u5207\u306a\u7a2e\u985e\u306e\u30d1\u30b9\u30c8\u30ea\u30fc\u3084\u30c8\u30c3\u30d4\u30f3\u30b0\u306a\u3069\uff09\u3092\u6b63\u78ba\u306b\u5b88\u308b\u3053\u3068\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d72 \u2013 \u30b9\u30d4\u30fc\u30c9\u306f\u3001\u8cea\u3092\u640d\u306a\u3046\u3053\u3068\u306a\u304f\u30aa\u30fc\u30c0\u30fc\u3092\u8fc5\u901f\u306b\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d73 \u2013 \u30d7\u30ec\u30bc\u30f3\u30c6\u30fc\u30b7\u30e7\u30f3\u306f\u3001\u6700\u7d42\u88fd\u54c1\u306e\u8996\u899a\u7684\u306a\u9b45\u529b\u306b\u3088\u3063\u3066\u8a55\u4fa1\u3055\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u9069\u5207\u306a\u30c8\u30c3\u30d4\u30f3\u30b0\u3092\u4e57\u305b\u305f\u3001\u7f8e\u3057\u304f\u30c7\u30b3\u30ec\u30fc\u30b7\u30e7\u30f3\u3055\u308c\u305f\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u306f\u3001\u7d20\u6734\u306a\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u3088\u308a\u3082\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3057\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u30ba\u30d9\u30fc\u30ab\u30ea\u30a2\u3067\u3001\u30c1\u30c3\u30d7\u3092\u6700\u5927\u5316\u3059\u308b\u3088\u3046\u306b\u30c7\u30b6\u30fc\u30c8\u3092\u30c7\u30b3\u30ec\u30fc\u30b7\u30e7\u30f3\u3059\u308b\u305f\u3081\u306e\u30d9\u30b9\u30c8\u30d7\u30e9\u30af\u30c6\u30a3\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30c7\u30b3\u30ec\u30fc\u30b7\u30e7\u30f3\u3067\u30c1\u30c3\u30d7\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71 \u2013 \u5e38\u306b\u9867\u5ba2\u306e\u30c8\u30c3\u30d4\u30f3\u30b0\u3084\u30c7\u30b6\u30a4\u30f3\u306e\u5177\u4f53\u7684\u306a\u8981\u6c42\u306b\u5f93\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 \u2013 \u30c7\u30b6\u30fc\u30c8\u3092\u8996\u899a\u7684\u306b\u9b45\u529b\u7684\u306b\u3059\u308b\u305f\u3081\u306b\u3001\u3055\u307e\u3056\u307e\u306a\u8272\u3084\u6a21\u69d8\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 \u2013 \u30c7\u30b3\u30ec\u30fc\u30b7\u30e7\u30f3\u304c\u6574\u7136\u3068\u3057\u3066\u3044\u3066\u5bfe\u79f0\u7684\u3067\u3042\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5747\u7b49\u306b\u914d\u7f6e\u3055\u308c\u305f\u30b9\u30d7\u30ea\u30f3\u30af\u30eb\u3068\u3001\u7dba\u9e97\u306b\u7d5e\u3089\u308c\u305f\u30d5\u30ed\u30b9\u30c6\u30a3\u30f3\u30b0\u3092\u4e57\u305b\u305f\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u306f\u3001\u30c1\u30c3\u30d7\u304c\u9ad8\u304f\u306a\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u30ba\u30d9\u30fc\u30ab\u30ea\u30a2\u3067\u3001\u5404\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u9593\u306e\u4f5c\u696d\u52b9\u7387\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u4f5c\u696d\u52b9\u7387\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u6226\u7565\u7684\u306a\u8a08\u753b\u3068\u540c\u6642\u4f5c\u696d\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71 \u2013 \u307e\u305a\u3001\u30b1\u30fc\u30ad\u3084\u30d1\u30a4\u306a\u3069\u3001\u6642\u9593\u304c\u304b\u304b\u308b\u30a2\u30a4\u30c6\u30e0\u3092\u6700\u521d\u306b\u713c\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 \u2013 \u3053\u308c\u3089\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u713c\u3044\u3066\u3044\u308b\u9593\u306b\u3001\u30c7\u30b3\u30ec\u30fc\u30b7\u30e7\u30f3\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u306b\u79fb\u308a\u3001\u30c8\u30c3\u30d4\u30f3\u30b0\u3084\u30d5\u30ed\u30b9\u30c6\u30a3\u30f3\u30b0\u3092\u6e96\u5099\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 \u2013 \u713c\u304d\u4e0a\u304c\u308a\u3092\u78ba\u8a8d\u3057\u7d9a\u3051\u3001\u713c\u304d\u3059\u304e\u306a\u3044\u3088\u3046\u306b\u6ce8\u610f\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d1\u30a4\u3092\u713c\u3044\u3066\u3044\u308b\u9593\u306b\u3001\u5225\u306e\u30aa\u30fc\u30c0\u30fc\u306e\u305f\u3081\u306e\u30db\u30a4\u30c3\u30d7\u30af\u30ea\u30fc\u30e0\u3084\u30d5\u30eb\u30fc\u30c4\u30c8\u30c3\u30d4\u30f3\u30b0\u306e\u6e96\u5099\u3092\u59cb\u3081\u3089\u308c\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u30ba\u30d9\u30fc\u30ab\u30ea\u30a2\u3092\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u5b9f\u884c\u3059\u308b\u305f\u3081\u306e\u6280\u8853\u7684\u306a\u8981\u4ef6\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30ba\u30d9\u30fc\u30ab\u30ea\u30a2\u306f\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u3088\u3063\u3066\u6280\u8853\u7684\u306a\u8981\u4ef6\u304c\u7570\u306a\u308a\u307e\u3059\u3002PC\u306e\u5834\u5408\u3001\u6700\u4f4e2GB\u306eRAM\u3068DirectX 9.0\u4e92\u63db\u306e\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u30ab\u30fc\u30c9\u304c\u5fc5\u8981\u3067\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u3067\u306f\u3001iOS 10.0\u4ee5\u964d\u3068Android 5.0\u4ee5\u964d\u3067\u30b9\u30e0\u30fc\u30ba\u306b\u52d5\u4f5c\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001iPhone 8\u3067\u306f\u3001\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u304c\u9ad8\u304f\u3066\u3082\u3001\u30e9\u30b0\u304c\u6700\u5c0f\u9650\u3067\u3001\u30b2\u30fc\u30e0\u3092\u30b9\u30e0\u30fc\u30ba\u306b\u5b9f\u884c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u30ba\u30d9\u30fc\u30ab\u30ea\u30a2\u3067\u3001\u96a0\u3055\u308c\u305f\u30ec\u30b7\u30d4\u3068\u30a2\u30a4\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u96a0\u3055\u308c\u305f\u30ec\u30b7\u30d4\u3068\u30a2\u30a4\u30c6\u30e0\u306f\u3001\u7279\u5b9a\u306e\u6311\u6226\u3092\u9054\u6210\u3059\u308b\u3053\u3068\u3084\u3001\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71 \u2013 \u30c7\u30a4\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u3067\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3057\u7d9a\u3051\u308b\u3053\u3068\u3067\u3001\u30ec\u30a2\u306a\u6750\u6599\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 \u2013 1\u65e5\u306e\u3059\u3079\u3066\u306e\u30aa\u30fc\u30c0\u30fc\u3092\u30df\u30b9\u306a\u304f\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3067\u3001\u7279\u5225\u306a\u30ec\u30b7\u30d4\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 \u2013 \u30a4\u30d9\u30f3\u30c8\u306b\u53c2\u52a0\u3057\u3066\u3001\u9650\u5b9a\u30a2\u30a4\u30c6\u30e0\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30cf\u30ed\u30a6\u30a3\u30f3\u30a4\u30d9\u30f3\u30c8\u671f\u9593\u4e2d\u306f\u3001\u30c6\u30fc\u30de\u306e\u30aa\u30fc\u30c0\u30fc\u3092\u30b7\u30ea\u30fc\u30ba\u3067\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3067\u3001\u30db\u30e9\u30fc\u306a\u30c6\u30fc\u30de\u306e\u30b1\u30fc\u30ad\u30ec\u30b7\u30d4\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u30ba\u30d9\u30fc\u30ab\u30ea\u30a2\u306e\u30e2\u30d0\u30a4\u30eb\u7248\u3068PC\u7248\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4f53\u9a13\u306e\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4f53\u9a13\u306e\u9055\u3044\u306f\u3001\u4e3b\u306b\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u30b9\u30ad\u30fc\u30e0\u3068\u753b\u9762\u306e\u30b5\u30a4\u30ba\u3067\u3059\u3002PC\u3067\u306f\u30de\u30a6\u30b9\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u8a73\u7d30\u306a\u30c7\u30b3\u30ec\u30fc\u30b7\u30e7\u30f3\u306b\u5f79\u7acb\u3064\u6b63\u78ba\u306a\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u304c\u53ef\u80fd\u3067\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u3067\u306f\u30bf\u30c3\u30c1\u64cd\u4f5c\u304c\u4fbf\u5229\u3067\u3059\u304c\u3001\u6b63\u78ba\u3055\u304c\u6b20\u3051\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u307e\u305f\u3001PC\u7248\u306f\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u304c\u826f\u304f\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u304c\u30b9\u30e0\u30fc\u30ba\u306a\u5834\u5408\u304c\u591a\u3044\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u8907\u96d1\u306a\u6a21\u69d8\u3067\u30b1\u30fc\u30ad\u3092\u98fe\u308b\u3053\u3068\u306f\u3001\u30de\u30a6\u30b9\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u306e\u7cbe\u5ea6\u306b\u3088\u308aPC\u306e\u65b9\u304c\u7c21\u5358\u3067\u3059\u3002"}]
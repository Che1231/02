[{"question": "\u65b0\u624b\u5982\u4f55\u6709\u6548\u5730\u958b\u59cb\u73a9 Papa's Bakeria\uff1f", "answer": "\u8981\u5728 Papa's Bakeria \u6709\u6548\u5730\u958b\u59cb\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f 1 - \u719f\u6089\u904a\u6232\u4ecb\u9762\uff0c\u5305\u62ec\u8a02\u55ae\u7ad9\u3001\u70d8\u7119\u7ad9\u548c\u88dd\u98fe\u7ad9\u3002\u6b65\u9a5f 2 - \u5f9e\u7c21\u55ae\u7684\u8a02\u55ae\u958b\u59cb\uff0c\u4f8b\u5982\u57fa\u672c\u9b06\u9905\u8a02\u55ae\uff0c\u719f\u6089\u904a\u6232\u6a5f\u5236\u3002\u6b65\u9a5f 3 - \u95dc\u6ce8\u6e96\u78ba\u6027\u548c\u901f\u5ea6\uff0c\u4ee5\u6700\u5927\u5316\u5c0f\u8cbb\u548c\u9867\u5ba2\u6eff\u610f\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u70d8\u7119\u9b06\u9905\u6642\uff0c\u8acb\u78ba\u4fdd\u5b83\u5728\u6b63\u78ba\u7684\u6642\u9593\u7ffb\u9762\uff0c\u4ee5\u78ba\u4fdd\u5747\u52fb\u70d8\u70e4\u3002"}, {"question": "\u5728 Papa's Bakeria \u7ba1\u7406\u591a\u500b\u8a02\u55ae\u7684\u95dc\u9375\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u7ba1\u7406\u591a\u500b\u8a02\u55ae\u9700\u8981\u6642\u9593\u7ba1\u7406\u548c\u512a\u5148\u9806\u5e8f\u7684\u7d50\u5408\u3002\u6b65\u9a5f 1 - \u59cb\u7d42\u67e5\u770b\u8a02\u55ae\u6e05\u55ae\u4e26\u512a\u5148\u8655\u7406\u7b49\u5f85\u6642\u9593\u6700\u77ed\u7684\u8a02\u55ae\u3002\u6b65\u9a5f 2 - \u5229\u7528\u300c\u8a02\u55ae\u7ad9\u300d\u4f86\u8ffd\u8e64\u9867\u5ba2\u504f\u597d\u548c\u7279\u6b8a\u8981\u6c42\u3002\u6b65\u9a5f 3 - \u900f\u904e\u91cd\u758a\u4efb\u52d9\u512a\u5316\u60a8\u7684\u5de5\u4f5c\u6d41\u7a0b\uff0c\u4f8b\u5982\u5728\u70d8\u7119\u4e00\u500b\u7269\u54c1\u6642\u88dd\u98fe\u53e6\u4e00\u500b\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u7576\u86cb\u7cd5\u6b63\u5728\u70d8\u70e4\u6642\uff0c\u60a8\u53ef\u4ee5\u958b\u59cb\u70ba\u53e6\u4e00\u500b\u8a02\u55ae\u6e96\u5099\u7cd6\u971c\u3002"}, {"question": "\u5728 Papa's Bakeria \u4e2d\uff0c\u54ea\u4e9b\u5347\u7d1a\u5c0d\u9032\u968e\u6700\u6709\u5229\uff1f", "answer": "\u5728 Papa's Bakeria \u4e2d\uff0c\u6700\u6709\u5229\u7684\u5347\u7d1a\u662f\u90a3\u4e9b\u80fd\u63d0\u5347\u6548\u7387\u548c\u54c1\u8cea\u7684\u5347\u7d1a\u3002\u6b65\u9a5f 1 - \u6295\u8cc7\u65bc\u300c\u70e4\u7bb1\u5347\u7d1a\u300d\u4ee5\u7e2e\u77ed\u70d8\u70e4\u6642\u9593\u4e26\u63d0\u9ad8\u4e00\u81f4\u6027\u3002\u6b65\u9a5f 2 - \u300c\u88dd\u98fe\u5de5\u5177\u5347\u7d1a\u300d\u5141\u8a31\u66f4\u7cbe\u7dfb\u7684\u8a2d\u8a08\uff0c\u63d0\u9ad8\u9867\u5ba2\u6eff\u610f\u5ea6\u3002\u6b65\u9a5f 3 - \u5347\u7d1a\u300c\u8a02\u55ae\u7ad9\u300d\u4ee5\u540c\u6642\u8655\u7406\u66f4\u591a\u8a02\u55ae\u3002\u4f8b\u5982\uff0c\u70e4\u7bb1\u5347\u7d1a\u53ef\u78ba\u4fdd\u60a8\u7684\u9905\u4e7e\u70d8\u70e4\u5747\u52fb\uff0c\u6e1b\u5c11\u71d2\u7126\u908a\u7de3\u7684\u6a5f\u6703\u3002"}, {"question": "\u5728 Papa's Bakeria \u70d8\u7119\u6642\uff0c\u6642\u9593\u70ba\u4f55\u5982\u6b64\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u638c\u63e1\u5b83\uff1f", "answer": "\u6642\u9593\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u76f4\u63a5\u5f71\u97ff\u70d8\u7119\u98df\u54c1\u7684\u54c1\u8cea\u548c\u9867\u5ba2\u6eff\u610f\u5ea6\u3002\u8981\u638c\u63e1\u6642\u9593\uff1a\u6b65\u9a5f 1 - \u5bc6\u5207\u6ce8\u610f\u8996\u89ba\u7dda\u7d22\uff0c\u4f8b\u5982\u9eb5\u5718\u7684\u984f\u8272\u8b8a\u5316\u3002\u6b65\u9a5f 2 - \u4f7f\u7528\u904a\u6232\u4e2d\u7684\u8a08\u6642\u5668\u7cbe\u78ba\u8ffd\u8e64\u70f9\u98ea\u6642\u9593\u3002\u6b65\u9a5f 3 - \u7df4\u7fd2\u4e0d\u540c\u7684\u7269\u54c1\uff0c\u4ee5\u4e86\u89e3\u5b83\u5011\u7684\u7279\u5b9a\u70d8\u70e4\u6642\u9593\u3002\u4f8b\u5982\uff0c\u6642\u9593\u6070\u5230\u597d\u8655\u7684\u86cb\u7cd5\u5c07\u5177\u6709\u91d1\u9ec3\u8272\u7684\u5916\u6bbc\u548c\u67d4\u8edf\u84ec\u9b06\u7684\u5167\u90e8\u3002"}, {"question": "Papa's Bakeria \u7684\u8a08\u5206\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u5b83\uff1f", "answer": "Papa's Bakeria \u7684\u8a08\u5206\u7cfb\u7d71\u53d7\u5e7e\u500b\u56e0\u7d20\u5f71\u97ff\uff1a\u6e96\u78ba\u6027\u3001\u901f\u5ea6\u548c\u5448\u73fe\u65b9\u5f0f\u3002\u6b65\u9a5f 1 - \u6e96\u78ba\u6027\u5305\u62ec\u7cbe\u78ba\u5730\u9075\u5faa\u8a02\u55ae\u8a73\u7d30\u8cc7\u6599\uff0c\u4f8b\u5982\u6b63\u78ba\u7684\u7cd5\u9ede\u985e\u578b\u548c\u914d\u6599\u3002\u6b65\u9a5f 2 - \u901f\u5ea6\u4ee5\u60a8\u5728\u4e0d\u640d\u5bb3\u54c1\u8cea\u7684\u60c5\u6cc1\u4e0b\u5b8c\u6210\u8a02\u55ae\u7684\u901f\u5ea6\u4f86\u8861\u91cf\u3002\u6b65\u9a5f 3 - \u5448\u73fe\u65b9\u5f0f\u4ee5\u6700\u7d42\u7522\u54c1\u7684\u5be9\u7f8e\u5438\u5f15\u529b\u4f86\u5224\u65b7\u3002\u4f8b\u5982\uff0c\u88dd\u98fe\u7cbe\u7f8e\u7684\u86cb\u7cd5\u5377\u914d\u4e0a\u6b63\u78ba\u7684\u914d\u6599\uff0c\u5f97\u5206\u6703\u6bd4\u55ae\u8abf\u7684\u86cb\u7cd5\u9ad8\u3002"}, {"question": "\u5728 Papa's Bakeria \u4e2d\uff0c\u5982\u4f55\u88dd\u98fe\u7cd5\u9ede\u4ee5\u6700\u5927\u5316\u5c0f\u8cbb\uff1f", "answer": "\u900f\u904e\u88dd\u98fe\u4f86\u6700\u5927\u5316\u5c0f\u8cbb\uff1a\u6b65\u9a5f 1 - \u59cb\u7d42\u9075\u5faa\u9867\u5ba2\u5c0d\u914d\u6599\u548c\u8a2d\u8a08\u7684\u7279\u5b9a\u8981\u6c42\u3002\u6b65\u9a5f 2 - \u4f7f\u7528\u5404\u7a2e\u984f\u8272\u548c\u5716\u6848\u4f7f\u7cd5\u9ede\u8996\u89ba\u4e0a\u66f4\u5438\u5f15\u4eba\u3002\u6b65\u9a5f 3 - \u78ba\u4fdd\u88dd\u98fe\u6574\u6f54\u4e14\u5c0d\u7a31\u3002\u4f8b\u5982\uff0c\u914d\u6709\u5e73\u8861\u7684\u7cd6\u971c\u548c\u6574\u9f4a\u7684\u7cd6\u971c\u7684\u86cb\u7cd5\u5377\u5f88\u53ef\u80fd\u6703\u7372\u5f97\u66f4\u9ad8\u7684\u63d0\u793a\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728 Papa's Bakeria \u4e2d\u512a\u5316\u5404\u7ad9\u4e4b\u9593\u7684\u5de5\u4f5c\u6d41\u7a0b\uff1f", "answer": "\u512a\u5316\u5de5\u4f5c\u6d41\u7a0b\u9700\u8981\u7b56\u7565\u6027\u898f\u5283\u548c\u591a\u5de5\u3002\u6b65\u9a5f 1 - \u9996\u5148\u5f9e\u70d8\u70e4\u9700\u8981\u6642\u9593\u6700\u9577\u7684\u7269\u54c1\u958b\u59cb\uff0c\u4f8b\u5982\u86cb\u7cd5\u6216\u6d3e\u3002\u6b65\u9a5f 2 - \u5728\u9019\u4e9b\u7269\u54c1\u70d8\u70e4\u6642\uff0c\u8f49\u79fb\u5230\u88dd\u98fe\u7ad9\u6e96\u5099\u914d\u6599\u548c\u7cd6\u971c\u3002\u6b65\u9a5f 3 - \u4e0d\u65b7\u76e3\u63a7\u70d8\u70e4\u9032\u5ea6\uff0c\u4ee5\u907f\u514d\u904e\u5ea6\u70d8\u70e4\u3002\u4f8b\u5982\uff0c\u5728\u6d3e\u70d8\u70e4\u6642\uff0c\u60a8\u53ef\u4ee5\u70ba\u53e6\u4e00\u500b\u8a02\u55ae\u6e96\u5099\u9bae\u5976\u6cb9\u548c\u6c34\u679c\u914d\u6599\u3002"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u904b\u884c Papa's Bakeria \u7684\u6280\u8853\u8981\u6c42\u662f\u4ec0\u9ebc\uff1f", "answer": "Papa's Bakeria \u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u7684\u6280\u8853\u8981\u6c42\u6709\u6240\u4e0d\u540c\u3002\u5728\u96fb\u8166\u4e0a\uff0c\u5b83\u9700\u8981\u81f3\u5c11 2GB \u8a18\u61b6\u9ad4\u548c DirectX 9.0 \u76f8\u5bb9\u7684\u986f\u5361\u3002\u5728\u884c\u52d5\u88dd\u7f6e\u4e0a\uff0c\u5b83\u53ef\u5728 iOS 10.0 \u6216\u66f4\u9ad8\u7248\u672c\u548c Android 5.0 \u6216\u66f4\u9ad8\u7248\u672c\u4e0a\u9806\u66a2\u904b\u884c\u3002\u4f8b\u5982\uff0c\u5728 iPhone 8 \u4e0a\uff0c\u904a\u6232\u4ee5\u9ad8\u5716\u5f62\u8a2d\u5b9a\u548c\u6700\u5c0f\u7684\u5ef6\u9072\u7121\u7e2b\u904b\u884c\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728 Papa's Bakeria \u89e3\u9396\u96b1\u85cf\u7684\u98df\u8b5c\u548c\u7269\u54c1\uff1f", "answer": "\u96b1\u85cf\u7684\u98df\u8b5c\u548c\u7269\u54c1\u53ef\u4ee5\u900f\u904e\u5b8c\u6210\u7279\u5b9a\u6311\u6230\u548c\u9054\u5230\u9ad8\u5206\u4f86\u89e3\u9396\u3002\u6b65\u9a5f 1 - \u59cb\u7d42\u5728\u6bcf\u65e5\u6311\u6230\u4e2d\u53d6\u5f97\u9ad8\u5206\u4ee5\u89e3\u9396\u7a00\u6709\u98df\u6750\u3002\u6b65\u9a5f 2 - \u5b8c\u6210\u7576\u5929\u6240\u6709\u9867\u5ba2\u8a02\u55ae\uff0c\u4e14\u6c92\u6709\u4efb\u4f55\u932f\u8aa4\u4ee5\u89e3\u9396\u7279\u6b8a\u98df\u8b5c\u3002\u6b65\u9a5f 3 - \u53c3\u8207\u5b63\u7bc0\u6027\u6d3b\u52d5\u4ee5\u7372\u5f97\u7368\u5bb6\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5728\u842c\u8056\u7bc0\u6d3b\u52d5\u671f\u9593\uff0c\u73a9\u5bb6\u53ef\u900f\u904e\u5b8c\u6210\u4e00\u7cfb\u5217\u4e3b\u984c\u8a02\u55ae\u4f86\u89e3\u9396\u9748\u7570\u4e3b\u984c\u7684\u9eb5\u5305\u98df\u8b5c\u3002"}, {"question": "Papa's Bakeria \u7684\u884c\u52d5\u7248\u672c\u548c\u96fb\u8166\u7248\u672c\u5728\u904a\u6232\u9ad4\u9a57\u4e0a\u6709\u4ec0\u9ebc\u4e0d\u540c\uff1f", "answer": "\u904a\u6232\u9ad4\u9a57\u7684\u4e0d\u540c\u4e3b\u8981\u5728\u65bc\u63a7\u5236\u65b9\u6848\u548c\u87a2\u5e55\u7a7a\u9593\u3002\u5728\u96fb\u8166\u4e0a\uff0c\u73a9\u5bb6\u4f7f\u7528\u6ed1\u9f20\u9032\u884c\u7cbe\u78ba\u63a7\u5236\uff0c\u9019\u5c0d\u8a73\u7d30\u7684\u88dd\u98fe\u5f88\u6709\u5e6b\u52a9\u3002\u5728\u884c\u52d5\u88dd\u7f6e\u4e0a\uff0c\u89f8\u63a7\u63a7\u5236\u63d0\u4f9b\u4fbf\u5229\u6027\uff0c\u4f46\u53ef\u80fd\u7f3a\u4e4f\u7cbe\u78ba\u5ea6\u3002\u6b64\u5916\uff0c\u96fb\u8166\u7248\u672c\u901a\u5e38\u5177\u6709\u66f4\u597d\u7684\u5716\u5f62\u548c\u66f4\u9806\u66a2\u7684\u6548\u80fd\u3002\u4f8b\u5982\uff0c\u7531\u65bc\u6ed1\u9f20\u63a7\u5236\u7684\u7cbe\u78ba\u6027\uff0c\u5728\u96fb\u8166\u4e0a\u88dd\u98fe\u7cbe\u7dfb\u5716\u6848\u7684\u86cb\u7cd5\u66f4\u5bb9\u6613\u3002"}]
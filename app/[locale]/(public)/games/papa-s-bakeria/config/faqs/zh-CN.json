[{"question": "\u65b0\u624b\u5982\u4f55\u6709\u6548\u5730\u5f00\u59cb\u73a9\u300a\u9762\u5305\u5e08\u6e38\u620f\u300b\uff1f", "answer": "\u8981\u5728\u300a\u9762\u5305\u5e08\u6e38\u620f\u300b\u4e2d\u6709\u6548\u5730\u5f00\u59cb\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u719f\u6089\u6e38\u620f\u754c\u9762\uff0c\u5305\u62ec\u70b9\u5355\u53f0\u3001\u70d8\u7119\u53f0\u548c\u88c5\u9970\u53f0\u3002\u6b65\u9aa42 - \u4ece\u7b80\u5355\u7684\u8ba2\u5355\u5f00\u59cb\u719f\u6089\u6e38\u620f\u673a\u5236\uff0c\u4f8b\u5982\u57fa\u672c\u7684\u677e\u997c\u8ba2\u5355\u3002\u6b65\u9aa43 - \u4e13\u6ce8\u4e8e\u51c6\u786e\u6027\u548c\u901f\u5ea6\uff0c\u4ee5\u6700\u5927\u5316\u5c0f\u8d39\u548c\u5ba2\u6237\u6ee1\u610f\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u70d8\u7119\u677e\u997c\u65f6\uff0c\u8bf7\u786e\u4fdd\u5176\u53d7\u70ed\u5747\u5300\uff0c\u5e76\u5728\u9002\u5f53\u7684\u65f6\u5019\u7ffb\u8f6c\u3002"}, {"question": "\u5728\u300a\u9762\u5305\u5e08\u6e38\u620f\u300b\u4e2d\u7ba1\u7406\u591a\u4e2a\u8ba2\u5355\u7684\u5173\u952e\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u7ba1\u7406\u591a\u4e2a\u8ba2\u5355\u9700\u8981\u65f6\u95f4\u7ba1\u7406\u548c\u4f18\u5148\u7ea7\u7684\u7ed3\u5408\u3002\u6b65\u9aa41 - \u59cb\u7ec8\u67e5\u770b\u8ba2\u5355\u5217\u8868\uff0c\u4f18\u5148\u5904\u7406\u7b49\u5f85\u65f6\u95f4\u6700\u77ed\u7684\u8ba2\u5355\u3002\u6b65\u9aa42 - \u5229\u7528\u201c\u70b9\u5355\u53f0\u201d\u8ddf\u8e2a\u5ba2\u6237\u504f\u597d\u548c\u7279\u6b8a\u8981\u6c42\u3002\u6b65\u9aa43 - \u901a\u8fc7\u91cd\u53e0\u4efb\u52a1\u4f18\u5316\u5de5\u4f5c\u6d41\u7a0b\uff0c\u4f8b\u5982\u5728\u70d8\u7119\u4e00\u4e2a\u7269\u54c1\u7684\u540c\u65f6\u88c5\u9970\u53e6\u4e00\u4e2a\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5f53\u4e00\u4e2a\u86cb\u7cd5\u6b63\u5728\u70d8\u70e4\u65f6\uff0c\u60a8\u53ef\u4ee5\u5f00\u59cb\u4e3a\u53e6\u4e00\u4e2a\u8ba2\u5355\u51c6\u5907\u7cd6\u971c\u3002"}, {"question": "\u300a\u9762\u5305\u5e08\u6e38\u620f\u300b\u4e2d\u54ea\u4e9b\u5347\u7ea7\u5bf9\u63d0\u5347\u6e38\u620f\u6c34\u5e73\u6700\u6709\u76ca\uff1f", "answer": "\u300a\u9762\u5305\u5e08\u6e38\u620f\u300b\u4e2d\u6700\u6709\u76ca\u7684\u5347\u7ea7\u662f\u90a3\u4e9b\u63d0\u9ad8\u6548\u7387\u548c\u8d28\u91cf\u7684\u5347\u7ea7\u3002\u6b65\u9aa41 - \u6295\u8d44\u201c\u70e4\u7bb1\u5347\u7ea7\u201d\u4ee5\u51cf\u5c11\u70d8\u7119\u65f6\u95f4\u5e76\u63d0\u9ad8\u4e00\u81f4\u6027\u3002\u6b65\u9aa42 - \u201c\u88c5\u9970\u5de5\u5177\u5347\u7ea7\u201d\u5141\u8bb8\u8fdb\u884c\u66f4\u7cbe\u7ec6\u7684\u8bbe\u8ba1\uff0c\u63d0\u9ad8\u5ba2\u6237\u6ee1\u610f\u5ea6\u3002\u6b65\u9aa43 - \u5347\u7ea7\u201c\u70b9\u5355\u53f0\u201d\u4ee5\u540c\u65f6\u5904\u7406\u66f4\u591a\u8ba2\u5355\u3002\u4f8b\u5982\uff0c\u70e4\u7bb1\u5347\u7ea7\u53ef\u786e\u4fdd\u60a8\u7684\u997c\u5e72\u70d8\u70e4\u5747\u5300\uff0c\u51cf\u5c11\u70e7\u7126\u8fb9\u7f18\u7684\u53ef\u80fd\u6027\u3002"}, {"question": "\u5728\u300a\u9762\u5305\u5e08\u6e38\u620f\u300b\u4e2d\uff0c\u70d8\u7119\u65f6\u95f4\u4e3a\u4ec0\u4e48\u81f3\u5173\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u638c\u63e1\u5b83\uff1f", "answer": "\u65f6\u95f4\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u76f4\u63a5\u5f71\u54cd\u70d8\u7119\u98df\u54c1\u7684\u8d28\u91cf\u548c\u5ba2\u6237\u6ee1\u610f\u5ea6\u3002\u8981\u638c\u63e1\u65f6\u95f4\uff1a\u6b65\u9aa41 - \u5bc6\u5207\u5173\u6ce8\u89c6\u89c9\u7ebf\u7d22\uff0c\u4f8b\u5982\u9762\u56e2\u989c\u8272\u7684\u53d8\u5316\u3002\u6b65\u9aa42 - \u4f7f\u7528\u6e38\u620f\u4e2d\u7684\u8ba1\u65f6\u5668\u7cbe\u786e\u8ddf\u8e2a\u70f9\u996a\u65f6\u95f4\u3002\u6b65\u9aa43 - \u4f7f\u7528\u4e0d\u540c\u7269\u54c1\u8fdb\u884c\u7ec3\u4e60\uff0c\u4ee5\u4e86\u89e3\u5176\u7279\u5b9a\u7684\u70d8\u7119\u65f6\u95f4\u3002\u4f8b\u5982\uff0c\u65f6\u95f4\u628a\u63e1\u5f97\u5f53\u7684\u86cb\u7cd5\u5c06\u5177\u6709\u91d1\u68d5\u8272\u5916\u76ae\u548c\u67d4\u8f6f\u84ec\u677e\u7684\u5185\u90e8\u3002"}, {"question": "\u300a\u9762\u5305\u5e08\u6e38\u620f\u300b\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u5b83\uff1f", "answer": "\u300a\u9762\u5305\u5e08\u6e38\u620f\u300b\u7684\u8bc4\u5206\u7cfb\u7edf\u53d7\u51e0\u4e2a\u56e0\u7d20\u7684\u5f71\u54cd\uff1a\u51c6\u786e\u6027\u3001\u901f\u5ea6\u548c\u5916\u89c2\u3002\u6b65\u9aa41 - \u51c6\u786e\u6027\u5305\u62ec\u7cbe\u786e\u5730\u9075\u5faa\u8ba2\u5355\u660e\u7ec6\uff0c\u4f8b\u5982\u6b63\u786e\u7684\u7cd5\u70b9\u7c7b\u578b\u548c\u914d\u6599\u3002\u6b65\u9aa42 - \u901f\u5ea6\u662f\u6307\u5728\u4e0d\u5f71\u54cd\u8d28\u91cf\u7684\u60c5\u51b5\u4e0b\u5feb\u901f\u5b8c\u6210\u8ba2\u5355\u7684\u901f\u5ea6\u3002\u6b65\u9aa43 - \u5916\u89c2\u662f\u7531\u6700\u7ec8\u4ea7\u54c1\u7684\u7f8e\u89c2\u7a0b\u5ea6\u6765\u5224\u65ad\u7684\u3002\u4f8b\u5982\uff0c\u88c5\u9970\u7cbe\u7f8e\u7684\u7eb8\u676f\u86cb\u7cd5\uff0c\u914d\u6709\u6b63\u786e\u7684\u914d\u6599\uff0c\u6bd4\u666e\u901a\u7eb8\u676f\u86cb\u7cd5\u7684\u5f97\u5206\u8981\u9ad8\u3002"}, {"question": "\u4e3a\u4e86\u5728\u300a\u9762\u5305\u5e08\u6e38\u620f\u300b\u4e2d\u6700\u5927\u5316\u5c0f\u8d39\uff0c\u88c5\u9970\u7cd5\u70b9\u6709\u54ea\u4e9b\u6700\u4f73\u5b9e\u8df5\uff1f", "answer": "\u4e3a\u4e86\u901a\u8fc7\u88c5\u9970\u6700\u5927\u5316\u5c0f\u8d39\uff1a\u6b65\u9aa41 - \u59cb\u7ec8\u9075\u5faa\u5ba2\u6237\u5bf9\u914d\u6599\u548c\u8bbe\u8ba1\u7684\u7279\u5b9a\u8981\u6c42\u3002\u6b65\u9aa42 - \u4f7f\u7528\u5404\u79cd\u989c\u8272\u548c\u56fe\u6848\u4f7f\u7cd5\u70b9\u5177\u6709\u89c6\u89c9\u5438\u5f15\u529b\u3002\u6b65\u9aa43 - \u786e\u4fdd\u88c5\u9970\u6574\u6d01\u5bf9\u79f0\u3002\u4f8b\u5982\uff0c\u88c5\u9970\u5747\u5300\u7684\u6d12\u6ee1\u4e86\u7cd6\u971c\u7684\u7eb8\u676f\u86cb\u7cd5\u66f4\u6709\u53ef\u80fd\u83b7\u5f97\u66f4\u9ad8\u7684\u987e\u5ba2\u5c0f\u8d39\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u9762\u5305\u5e08\u6e38\u620f\u300b\u4e2d\u4f18\u5316\u5404\u4e2a\u5de5\u4f5c\u7ad9\u4e4b\u95f4\u7684\u5de5\u4f5c\u6d41\u7a0b\uff1f", "answer": "\u4f18\u5316\u5de5\u4f5c\u6d41\u7a0b\u9700\u8981\u6218\u7565\u89c4\u5212\u548c\u591a\u4efb\u52a1\u5904\u7406\u3002\u6b65\u9aa41 - \u9996\u5148\u5f00\u59cb\u70d8\u7119\u9700\u8981\u65f6\u95f4\u8f83\u957f\u7684\u7269\u54c1\uff0c\u4f8b\u5982\u86cb\u7cd5\u6216\u6d3e\u3002\u6b65\u9aa42 - \u5728\u8fd9\u4e9b\u7269\u54c1\u70d8\u70e4\u65f6\uff0c\u524d\u5f80\u88c5\u9970\u53f0\u51c6\u5907\u914d\u6599\u548c\u7cd6\u971c\u3002\u6b65\u9aa43 - \u6301\u7eed\u76d1\u63a7\u70d8\u70e4\u8fdb\u5ea6\uff0c\u907f\u514d\u8fc7\u5ea6\u70d8\u70e4\u3002\u4f8b\u5982\uff0c\u5f53\u4e00\u4e2a\u6d3e\u6b63\u5728\u70d8\u70e4\u65f6\uff0c\u60a8\u53ef\u4ee5\u51c6\u5907\u53e6\u4e00\u4e2a\u8ba2\u5355\u7684\u9c9c\u5976\u6cb9\u548c\u6c34\u679c\u914d\u6599\u3002"}, {"question": "\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e0a\u8fd0\u884c\u300a\u9762\u5305\u5e08\u6e38\u620f\u300b\u7684\u6280\u672f\u8981\u6c42\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u9762\u5305\u5e08\u6e38\u620f\u300b\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u7684\u6280\u672f\u8981\u6c42\u5404\u4e0d\u76f8\u540c\u3002\u5bf9\u4e8ePC\uff0c\u5b83\u9700\u8981\u81f3\u5c112GB\u5185\u5b58\u548c\u517c\u5bb9DirectX 9.0\u7684\u663e\u5361\u3002\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\uff0c\u5b83\u5728iOS 10.0\u53ca\u66f4\u9ad8\u7248\u672c\u548cAndroid 5.0\u53ca\u66f4\u9ad8\u7248\u672c\u4e0a\u8fd0\u884c\u6d41\u7545\u3002\u4f8b\u5982\uff0c\u5728iPhone 8\u4e0a\uff0c\u8be5\u6e38\u620f\u80fd\u591f\u4ee5\u9ad8\u8d28\u91cf\u56fe\u5f62\u548c\u6700\u5c0f\u5ef6\u8fdf\u65e0\u7f1d\u8fd0\u884c\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u9762\u5305\u5e08\u6e38\u620f\u300b\u4e2d\u89e3\u9501\u9690\u85cf\u7684\u98df\u8c31\u548c\u7269\u54c1\uff1f", "answer": "\u901a\u8fc7\u5b8c\u6210\u7279\u5b9a\u6311\u6218\u5e76\u83b7\u5f97\u9ad8\u5206\u53ef\u4ee5\u89e3\u9501\u9690\u85cf\u7684\u98df\u8c31\u548c\u7269\u54c1\u3002\u6b65\u9aa41 - \u6301\u7eed\u5728\u6bcf\u65e5\u6311\u6218\u4e2d\u83b7\u5f97\u9ad8\u5206\u4ee5\u89e3\u9501\u7a00\u6709\u98df\u6750\u3002\u6b65\u9aa42 - \u5728\u4e00\u5929\u5185\u5b8c\u6210\u6240\u6709\u5ba2\u6237\u8ba2\u5355\uff0c\u65e0\u9700\u4efb\u4f55\u9519\u8bef\u5373\u53ef\u89e3\u9501\u7279\u6b8a\u98df\u8c31\u3002\u6b65\u9aa43 - \u53c2\u4e0e\u5b63\u8282\u6027\u6d3b\u52a8\u4ee5\u83b7\u5f97\u72ec\u5bb6\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5728\u4e07\u5723\u8282\u6d3b\u52a8\u671f\u95f4\uff0c\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u5b8c\u6210\u4e00\u7cfb\u5217\u4e3b\u9898\u8ba2\u5355\u6765\u89e3\u9501\u4e00\u6b3e\u4e3b\u9898\u4e3a\u4e07\u5723\u8282\u7684\u86cb\u7cd5\u98df\u8c31\u3002"}, {"question": "\u300a\u9762\u5305\u5e08\u6e38\u620f\u300b\u7684\u79fb\u52a8\u7248\u548cPC\u7248\u6e38\u620f\u4f53\u9a8c\u6709\u4ec0\u4e48\u4e0d\u540c\uff1f", "answer": "\u6e38\u620f\u4f53\u9a8c\u4e3b\u8981\u5728\u4e8e\u63a7\u5236\u65b9\u6848\u548c\u5c4f\u5e55\u7a7a\u95f4\u4e0d\u540c\u3002\u5728PC\u4e0a\uff0c\u73a9\u5bb6\u4f7f\u7528\u9f20\u6807\u8fdb\u884c\u7cbe\u786e\u63a7\u5236\uff0c\u8fd9\u6709\u5229\u4e8e\u7cbe\u7ec6\u7684\u88c5\u9970\u3002\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\uff0c\u89e6\u6478\u63a7\u5236\u65b9\u4fbf\uff0c\u4f46\u53ef\u80fd\u7f3a\u4e4f\u7cbe\u786e\u5ea6\u3002\u6b64\u5916\uff0cPC\u7248\u901a\u5e38\u5177\u6709\u66f4\u597d\u7684\u56fe\u5f62\u548c\u66f4\u6d41\u7545\u7684\u6027\u80fd\u3002\u4f8b\u5982\uff0c\u7531\u4e8e\u9f20\u6807\u63a7\u5236\u7684\u7cbe\u786e\u6027\uff0c\u5728PC\u4e0a\u88c5\u9970\u5e26\u6709\u590d\u6742\u56fe\u6848\u7684\u86cb\u7cd5\u66f4\u5bb9\u6613\u3002"}]
[{"question": "\u5982\u4f55\u4f5c\u4e3a\u65b0\u624b\u638c\u63e1\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f 2\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u638c\u63e1\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f 2\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u9996\u5148\u8981\u719f\u6089\u65b9\u5411\u952e\u8fdb\u884c\u79fb\u52a8\u3002\u7ec3\u4e60\u5728\u6700\u521d\u51e0\u4e2a\u5173\u5361\u4e2d\u8fdb\u884c\u5bfc\u822a\uff0c\u611f\u53d7\u64cd\u4f5c\u7684\u54cd\u5e94\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u57281\u7ea7\u5173\u5361\u4e2d\uff0c\u6162\u6162\u79fb\u52a8\u4f60\u7684\u89d2\u8272\u4ee5\u907f\u514d\u79fb\u52a8\u7684\u7ea2\u8272\u5706\u70b9\u3002\u4f7f\u7528\u77ed\u800c\u63a7\u5236\u7684\u79fb\u52a8\uff0c\u800c\u4e0d\u662f\u5feb\u901f\u6309\u952e\uff0c\u4fdd\u6301\u7cbe\u786e\u6027\u3002\u968f\u7740\u4f60\u53d8\u5f97\u66f4\u8212\u9002\uff0c\u9010\u6e10\u63d0\u9ad8\u901f\u5ea6\u3002\u6b64\u5916\uff0c\u5229\u7528\u6682\u505c\u529f\u80fd\u6218\u7565\u6027\u5730\u89c4\u5212\u4f60\u7684\u4e0b\u4e00\u6b65\u884c\u52a8\u3002\u8bb0\u4f4f\uff0c\u8010\u5fc3\u548c\u7ec3\u4e60\u662f\u638c\u63e1\u63a7\u5236\u7684\u5173\u952e\u3002"}, {"question": "\u5728\u300aWHG2\u300b\u7684\u4e2d\u7ea7\u5173\u5361\u4e2d\u53d6\u5f97\u8fdb\u5c55\u7684\u5173\u952e\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f 2\u300b\u7684\u4e2d\u7ea7\u5173\u5361\u53d6\u5f97\u8fdb\u5c55\u9700\u8981\u7ed3\u5408\u65f6\u673a\u548c\u6a21\u5f0f\u8bc6\u522b\u3002\u6b65\u9aa41\uff1a\u89c2\u5bdf\u6bcf\u4e2a\u5173\u5361\u4e2d\u969c\u788d\u7269\u7684\u79fb\u52a8\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u572815\u7ea7\u5173\u5361\u4e2d\uff0c\u84dd\u8272\u65b9\u5757\u4ee5\u53ef\u9884\u6d4b\u7684\u5706\u5f62\u6a21\u5f0f\u79fb\u52a8\u3002\u6b65\u9aa42\uff1a\u901a\u8fc7\u8bc6\u522b\u5b89\u5168\u533a\u57df\u5e76\u4f7f\u4f60\u7684\u79fb\u52a8\u4e0e\u969c\u788d\u7269\u6a21\u5f0f\u4e2d\u7684\u7a7a\u9699\u76f8\u5339\u914d\u6765\u89c4\u5212\u4f60\u7684\u8def\u7ebf\u3002\u6b65\u9aa43\uff1a\u7528\u7cbe\u786e\u6027\u6267\u884c\u4f60\u7684\u8ba1\u5212\uff0c\u4f7f\u7528\u77ed\u65f6\u95f4\u7684\u79fb\u52a8\u6765\u7a7f\u68ad\u4e8e\u72ed\u7a84\u7684\u7a7a\u95f4\u3002\u591a\u6b21\u7ec3\u4e60\u6bcf\u4e2a\u5173\u5361\u4ee5\u5b8c\u5584\u4f60\u7684\u7b56\u7565\u5e76\u63d0\u9ad8\u4f60\u7684\u53cd\u5e94\u65f6\u95f4\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u7406\u89e3\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f 2\u300b\u4e2d\u7684\u78b0\u649e\u673a\u5236\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u7406\u89e3\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f 2\u300b\u4e2d\u7684\u78b0\u649e\u673a\u5236\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u76f4\u63a5\u5f71\u54cd\u4f60\u6210\u529f\u5730\u5b8c\u6210\u5173\u5361\u5bfc\u822a\u7684\u80fd\u529b\u3002\u8be5\u6e38\u620f\u4f7f\u7528\u50cf\u7d20\u5b8c\u7f8e\u7684\u78b0\u649e\u68c0\u6d4b\uff0c\u8fd9\u610f\u5473\u7740\u5373\u4f7f\u4e0e\u969c\u788d\u7269\u53d1\u751f\u6700\u8f7b\u5fae\u7684\u63a5\u89e6\u4e5f\u4f1a\u5bfc\u81f4\u5931\u8d25\u3002\u4f8b\u5982\uff0c\u572810\u7ea7\u5173\u5361\u4e2d\uff0c\u79fb\u52a8\u7684\u7ea2\u8272\u6761\u9700\u8981\u7cbe\u786e\u7684\u65f6\u673a\u624d\u80fd\u907f\u514d\u3002\u901a\u8fc7\u4e86\u89e3\u4f60\u7684\u89d2\u8272\u5982\u4f55\u4e0e\u969c\u788d\u7269\u4e92\u52a8\uff0c\u4f60\u53ef\u4ee5\u66f4\u597d\u5730\u9884\u6d4b\u5b89\u5168\u8def\u5f84\u5e76\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u9519\u8bef\u3002\u8fd9\u4e9b\u77e5\u8bc6\u8ba9\u4f60\u505a\u51fa\u66f4\u660e\u667a\u7684\u51b3\u5b9a\uff0c\u6700\u7ec8\u63d0\u9ad8\u4f60\u5728\u6e38\u620f\u4e2d\u7684\u6574\u4f53\u8868\u73b0\u548c\u8fdb\u5c55\u3002"}, {"question": "\u54ea\u4e9b\u9ad8\u7ea7\u6280\u5de7\u53ef\u4ee5\u5e2e\u52a9\u6211\u5728\u300aWHG2\u300b\u7684\u9ad8\u96be\u5ea6\u5173\u5361\u4e2d\u83b7\u80dc\uff1f", "answer": "\u5728\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f 2\u300b\u7684\u9ad8\u96be\u5ea6\u5173\u5361\u4e2d\u83b7\u80dc\u9700\u8981\u9ad8\u7ea7\u6280\u5de7\uff0c\u4f8b\u5982\u6a21\u5f0f\u8bb0\u5fc6\u548c\u9884\u6d4b\u6027\u79fb\u52a8\u3002\u6b65\u9aa41\uff1a\u4ed4\u7ec6\u7814\u7a76\u969c\u788d\u7269\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u572825\u7ea7\u5173\u5361\u4e2d\uff0c\u7eff\u8272\u4e09\u89d2\u5f62\u4ee5\u590d\u6742\u4e14\u91cd\u53e0\u7684\u6a21\u5f0f\u79fb\u52a8\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u9884\u6d4b\u6027\u79fb\u52a8\u6765\u9884\u6d4b\u969c\u788d\u7269\u7684\u4e0b\u4e00\u4e2a\u4f4d\u7f6e\uff0c\u4ece\u800c\u63d0\u524d\u89c4\u5212\u4f60\u7684\u8def\u7ebf\u3002\u6b65\u9aa43\uff1a\u7528\u7cbe\u786e\u6027\u6267\u884c\u4f60\u7684\u52a8\u4f5c\uff0c\u4f7f\u7528\u5feb\u901f\u3001\u63a7\u5236\u7684\u8f93\u5165\u6765\u7a7f\u68ad\u4e8e\u72ed\u7a84\u7684\u7a7a\u95f4\u3002\u6b64\u5916\uff0c\u8003\u8651\u4f7f\u7528\u201c\u91cd\u64ad\u201d\u529f\u80fd\u53cd\u590d\u7ec3\u4e60\u7279\u5b9a\u90e8\u5206\uff0c\u76f4\u5230\u4f60\u638c\u63e1\u4e3a\u6b62\u3002\u8fd9\u4e9b\u6280\u5de7\u7ed3\u5408\u8010\u5fc3\u548c\u7ec3\u4e60\uff0c\u5c06\u663e\u8457\u63d0\u9ad8\u4f60\u6210\u529f\u7684\u51e0\u7387\u3002"}, {"question": "\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f 2\u300b\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u5de5\u4f5c\u7684\uff0c\u4ee5\u53ca\u5982\u4f55\u4f18\u5316\u5b83\uff1f", "answer": "\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f 2\u300b\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u5269\u4f59\u7684\u751f\u547d\u6570\u548c\u5b8c\u6210\u6bcf\u4e2a\u5173\u5361\u6240\u9700\u7684\u65f6\u95f4\u3002\u4e3a\u4e86\u4f18\u5316\u4f60\u7684\u5206\u6570\uff0c\u4e13\u6ce8\u4e8e\u901a\u8fc7\u5c3d\u91cf\u51cf\u5c11\u9519\u8bef\u6765\u4fdd\u7559\u4f60\u7684\u751f\u547d\u3002\u4f8b\u5982\uff0c\u57285\u7ea7\u5173\u5361\u4e2d\uff0c\u82b1\u65f6\u95f4\u6765\u5bfc\u822a\u79fb\u52a8\u7684\u969c\u788d\u7269\uff0c\u800c\u4e0d\u662f\u5306\u5fd9\u5e76\u5192\u7740\u78b0\u649e\u7684\u98ce\u9669\u3002\u6b64\u5916\uff0c\u76ee\u6807\u662f\u5728\u4e0d\u727a\u7272\u51c6\u786e\u6027\u7684\u524d\u63d0\u4e0b\u5c3d\u53ef\u80fd\u5feb\u901f\u5730\u5b8c\u6210\u5173\u5361\u3002\u7ec3\u4e60\u6bcf\u4e2a\u5173\u5361\uff0c\u627e\u5230\u901f\u5ea6\u548c\u5b89\u5168\u4e4b\u95f4\u7684\u6700\u4f73\u5e73\u8861\u3002\u901a\u8fc7\u638c\u63e1\u8fd9\u4e24\u65b9\u9762\uff0c\u4f60\u53ef\u4ee5\u83b7\u5f97\u66f4\u9ad8\u7684\u5206\u6570\u5e76\u63d0\u9ad8\u4f60\u5728\u6e38\u620f\u4e2d\u7684\u6574\u4f53\u6392\u540d\u3002"}, {"question": "\u300aWHG2\u300b\u7684PC\u548c\u79fb\u52a8\u7248\u672c\u5728\u6e38\u620f\u73a9\u6cd5\u4e0a\u6709\u4ec0\u4e48\u4e0d\u540c\uff1f", "answer": "\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f 2\u300b\u7684PC\u548c\u79fb\u52a8\u7248\u672c\u7684\u4e3b\u8981\u533a\u522b\u5728\u4e8e\u63a7\u5236\u65b9\u6848\u548c\u5c4f\u5e55\u5c3a\u5bf8\u3002\u5728PC\u4e0a\uff0c\u4f60\u4f7f\u7528\u65b9\u5411\u952e\u8fdb\u884c\u7cbe\u786e\u7684\u79fb\u52a8\uff0c\u800c\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\uff0c\u4f60\u4f9d\u9760\u89e6\u6478\u63a7\u5236\uff0c\u8fd9\u53ef\u80fd\u4e0d\u592a\u7cbe\u786e\u3002\u4f8b\u5982\uff0c\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\u5bfc\u822a8\u7ea7\u5173\u5361\u53ef\u80fd\u9700\u8981\u66f4\u591a\u7ec3\u4e60\uff0c\u56e0\u4e3a\u89e6\u63a7\u8f93\u5165\u7684\u7075\u654f\u5ea6\u3002\u6b64\u5916\uff0c\u79fb\u52a8\u8bbe\u5907\u4e0a\u7684\u8f83\u5c0f\u5c4f\u5e55\u5c3a\u5bf8\u4f1a\u4f7f\u89c2\u5bdf\u969c\u788d\u7269\u53d8\u5f97\u66f4\u56f0\u96be\uff0c\u9700\u8981\u66f4\u591a\u4e13\u6ce8\u3002\u5c3d\u7ba1\u5b58\u5728\u8fd9\u4e9b\u5dee\u5f02\uff0c\u6838\u5fc3\u6e38\u620f\u673a\u5236\u4ecd\u7136\u76f8\u540c\uff0c\u901a\u8fc7\u7ec3\u4e60\uff0c\u4f60\u53ef\u4ee5\u5728\u4efb\u4f55\u7248\u672c\u4e0a\u53d6\u5f97\u6210\u529f\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f 2\u300b\u4e2d\u53d1\u73b0\u9690\u85cf\u5173\u5361\u6216\u79d8\u5bc6\uff1f", "answer": "\u5728\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f 2\u300b\u4e2d\u53d1\u73b0\u9690\u85cf\u5173\u5361\u6216\u79d8\u5bc6\u9700\u8981\u4ed4\u7ec6\u63a2\u7d22\u548c\u5173\u6ce8\u7ec6\u8282\u3002\u4f8b\u5982\uff0c\u572812\u7ea7\u5173\u5361\u4e2d\uff0c\u5982\u679c\u4f60\u6309\u7167\u7279\u5b9a\u969c\u788d\u7269\u5e8f\u5217\u8fdb\u884c\u5bfc\u822a\uff0c\u5219\u6709\u4e00\u4e2a\u9690\u85cf\u8def\u5f84\u901a\u5f80\u79d8\u5bc6\u533a\u57df\u3002\u4e3a\u4e86\u627e\u5230\u8fd9\u4e9b\u79d8\u5bc6\uff0c\u5c1d\u8bd5\u4e0d\u540c\u7684\u8def\u7ebf\uff0c\u5e76\u89c2\u5bdf\u4efb\u4f55\u4e0d\u5bfb\u5e38\u7684\u6a21\u5f0f\u6216\u969c\u788d\u7269\u4e2d\u7684\u7a7a\u9699\u3002\u6b64\u5916\uff0c\u7559\u610f\u97f3\u9891\u63d0\u793a\u6216\u5bfb\u627e\u53ef\u80fd\u8868\u660e\u9690\u85cf\u5185\u5bb9\u7684\u53ef\u89c6\u5f02\u5e38\u3002\u867d\u7136\u8fd9\u4e9b\u79d8\u5bc6\u5f88\u96be\u627e\u5230\uff0c\u4f46\u5b83\u4eec\u4e3a\u6e38\u620f\u589e\u6dfb\u4e86\u989d\u5916\u7684\u6df1\u5ea6\u548c\u53ef\u91cd\u590d\u6027\u3002"}, {"question": "\u5728\u300aWHG2\u300b\u4e2d\u7ba1\u7406\u751f\u547d\u548c\u7ee7\u7eed\u6e38\u620f\u7684\u6700\u4f73\u5b9e\u8df5\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f 2\u300b\u4e2d\u7ba1\u7406\u751f\u547d\u548c\u7ee7\u7eed\u6e38\u620f\u5bf9\u4e8e\u957f\u671f\u6210\u529f\u81f3\u5173\u91cd\u8981\u3002\u6b65\u9aa41\uff1a\u59cb\u7ec8\u4ee5\u5c3d\u53ef\u80fd\u5c11\u7684\u9519\u8bef\u5b8c\u6210\u5173\u5361\uff0c\u4ee5\u4fdd\u7559\u4f60\u7684\u751f\u547d\u3002\u4f8b\u5982\uff0c\u57283\u7ea7\u5173\u5361\u4e2d\uff0c\u82b1\u65f6\u95f4\u6765\u5bfc\u822a\u79fb\u52a8\u7684\u969c\u788d\u7269\uff0c\u800c\u4e0d\u662f\u5306\u5fd9\u3002\u6b65\u9aa42\uff1a\u5728\u9ad8\u96be\u5ea6\u5173\u5361\u4e2d\u6218\u7565\u6027\u5730\u4f7f\u7528\u7ee7\u7eed\u529f\u80fd\uff0c\u56e0\u4e3a\u5728\u8fd9\u4e9b\u5173\u5361\u4e2d\u72af\u9519\u7684\u53ef\u80fd\u6027\u66f4\u5927\u3002\u6b65\u9aa43\uff1a\u53cd\u590d\u7ec3\u4e60\u56f0\u96be\u7684\u90e8\u5206\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u9519\u8bef\u5e76\u63d0\u9ad8\u4f60\u7684\u6574\u4f53\u8868\u73b0\u3002\u901a\u8fc7\u91c7\u7528\u8fd9\u4e9b\u505a\u6cd5\uff0c\u4f60\u53ef\u4ee5\u5ef6\u957f\u4f60\u7684\u6e38\u620f\u65f6\u95f4\u5e76\u589e\u52a0\u5b8c\u6210\u6e38\u620f\u7684\u51e0\u7387\u3002"}, {"question": "\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f 2\u300b\u7684\u96be\u5ea6\u66f2\u7ebf\u4e0e\u5176\u4ed6\u76ca\u667a\u6e38\u620f\u76f8\u6bd4\u5982\u4f55\uff1f", "answer": "\u4e0e\u8bb8\u591a\u5176\u4ed6\u76ca\u667a\u6e38\u620f\u76f8\u6bd4\uff0c\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f 2\u300b\u7684\u96be\u5ea6\u66f2\u7ebf\u660e\u663e\u66f4\u9661\u5ced\u3002\u867d\u7136\u5927\u591a\u6570\u76ca\u667a\u6e38\u620f\u96be\u5ea6\u4f1a\u9010\u6e10\u589e\u52a0\uff0c\u4f46\u300aWHG2\u300b\u5728\u65e9\u671f\u5c31\u5f15\u5165\u4e86\u590d\u6742\u7684\u6a21\u5f0f\u548c\u72ed\u7a84\u7684\u7a7a\u95f4\u3002\u4f8b\u5982\uff0c\u52305\u7ea7\u5173\u5361\uff0c\u73a9\u5bb6\u5c31\u5df2\u7ecf\u9700\u8981\u5728\u591a\u4e2a\u79fb\u52a8\u7684\u969c\u788d\u7269\u4e2d\u8fdb\u884c\u5bfc\u822a\uff0c\u8fd9\u5728\u5176\u4ed6\u6e38\u620f\u4e2d\u53ef\u80fd\u51fa\u73b0\u5728\u66f4\u540e\u9762\u7684\u5173\u5361\u3002\u8fd9\u79cd\u5feb\u901f\u63d0\u5347\u9700\u8981\u73a9\u5bb6\u5feb\u901f\u9002\u5e94\u548c\u6539\u8fdb\u6280\u80fd\u3002\u6e38\u620f\u5bf9\u7cbe\u786e\u6027\u548c\u65f6\u673a\u7684\u5f3a\u8c03\uff0c\u5373\u4f7f\u662f\u7ecf\u9a8c\u4e30\u5bcc\u7684\u76ca\u667a\u6e38\u620f\u73a9\u5bb6\uff0c\u4e5f\u4f7f\u5176\u6210\u4e3a\u4e00\u79cd\u72ec\u7279\u4e14\u5177\u6709\u6311\u6218\u6027\u7684\u4f53\u9a8c\u3002"}, {"question": "\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f 2\u300b\u4e0e\u5176\u524d\u4f5c\u76f8\u6bd4\u6709\u54ea\u4e9b\u5173\u952e\u533a\u522b\uff1f", "answer": "\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f 2\u300b\u4e0e\u524d\u4f5c\u76f8\u6bd4\uff0c\u5f15\u5165\u4e86\u51e0\u4e2a\u5173\u952e\u533a\u522b\uff0c\u5305\u62ec\u66f4\u590d\u6742\u7684\u969c\u788d\u7269\u6a21\u5f0f\u548c\u989d\u5916\u7684\u6e38\u620f\u673a\u5236\u3002\u4f8b\u5982\uff0c\u300aWHG2\u300b\u5305\u542b\u901f\u5ea6\u548c\u65b9\u5411\u5404\u5f02\u7684\u79fb\u52a8\u969c\u788d\u7269\uff0c\u4f8b\u598220\u7ea7\u5173\u5361\u4e2d\u7684\u87ba\u65cb\u5f62\u84dd\u8272\u65b9\u5757\uff0c\u8fd9\u4e9b\u5728\u7b2c\u4e00\u6b3e\u6e38\u620f\u4e2d\u4e0d\u5b58\u5728\u3002\u6b64\u5916\uff0c\u300aWHG2\u300b\u5305\u542b\u65b0\u7684\u5173\u5361\u8bbe\u8ba1\u548c\u9690\u85cf\u7684\u79d8\u5bc6\uff0c\u589e\u52a0\u4e86\u6e38\u620f\u7684\u6df1\u5ea6\u548c\u53ef\u91cd\u590d\u6027\u3002\u6e38\u620f\u8fd8\u63d0\u4f9b\u6539\u8fdb\u7684\u56fe\u5f62\u548c\u58f0\u97f3\u6548\u679c\uff0c\u589e\u5f3a\u4e86\u6574\u4f53\u73a9\u5bb6\u4f53\u9a8c\u3002\u8fd9\u4e9b\u53d8\u5316\u4f7f\u5f97\u300aWHG2\u300b\u76f8\u6bd4\u524d\u4f5c\uff0c\u66f4\u5177\u6311\u6218\u6027\u4e14\u66f4\u5f15\u4eba\u5165\u80dc\u3002"}]
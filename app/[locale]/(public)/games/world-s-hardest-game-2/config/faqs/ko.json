[{"question": "\ucd08\ubcf4\uc790\ub85c\uc11c \uc5b4\ub5bb\uac8c \uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784 2\uc758 \uae30\ubcf8 \uc81c\uc5b4\ub97c \ub9c8\uc2a4\ud130\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784 2\uc758 \uae30\ubcf8 \uc81c\uc5b4\ub97c \ub9c8\uc2a4\ud130\ud558\ub824\uba74, \uba3c\uc800 \ubc29\ud5a5\ud0a4\ub97c \uc774\uc6a9\ud55c \uc774\ub3d9\uc5d0 \uc775\uc219\ud574\uc9c0\ub294 \uac83\ubd80\ud130 \uc2dc\uc791\ud558\uc138\uc694. \uccab \uba87 \ub2e8\uacc4\ub97c \ud0d0\uc0c9\ud558\uba70 \ubc18\uc751\uc131\uc744 \ud30c\uc545\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, 1\ub2e8\uacc4\uc5d0\uc11c\ub294 \uc6c0\uc9c1\uc774\ub294 \ube68\uac04 \uc810\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uce90\ub9ad\ud130\ub97c \ucc9c\ucc9c\ud788 \uc6c0\uc9c1\uc774\uc138\uc694. \uc815\ud655\uc131\uc744 \uc720\uc9c0\ud558\uae30 \uc704\ud574 \ube60\ub978 \ud0a4 \uc785\ub825 \ub300\uc2e0 \uc9e7\uace0 \uc81c\uc5b4\ub41c \uc6c0\uc9c1\uc784\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. \uc810\ucc28 \ub354\uc6b1 \ud3b8\uc548\ud574\uc9d0\uc5d0 \ub530\ub77c \uc18d\ub3c4\ub97c \ub192\uc774\uc138\uc694. \ub610\ud55c, \uc7a0\uc2dc \uba48\ucd94\ub294 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc804\ub7b5\uc801\uc73c\ub85c \ub2e4\uc74c \uc6c0\uc9c1\uc784\uc744 \uacc4\ud68d\ud558\uc138\uc694. \uc778\ub0b4\uc2ec\uacfc \uc5f0\uc2b5\uc774 \uc81c\uc5b4\ub97c \ub9c8\uc2a4\ud130\ud558\ub294 \ub370 \uc911\uc694\ud569\ub2c8\ub2e4."}, {"question": "WHG2 \uc911\uac04 \ub2e8\uacc4\ub97c \uc9c4\ud589\ud558\ub294 \ub370 \ud544\uc218\uc801\uc778 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784 2\uc758 \uc911\uac04 \ub2e8\uacc4\ub97c \uc9c4\ud589\ud558\ub824\uba74 \ud0c0\uc774\ubc0d\uacfc \ud328\ud134 \uc778\uc2dd\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \uac01 \ub2e8\uacc4\uc758 \uc7a5\uc560\ubb3c \uc774\ub3d9 \ud328\ud134\uc744 \uad00\ucc30\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, 15\ub2e8\uacc4\uc5d0\uc11c\ub294 \ud30c\ub780\uc0c9 \uc0ac\uac01\ud615\uc774 \uc608\uce21 \uac00\ub2a5\ud55c \uc6d0\ud615 \ud328\ud134\uc73c\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4. STEP2: \uc548\uc804 \uad6c\uc5ed\uc744 \ud30c\uc545\ud558\uace0 \uc7a5\uc560\ubb3c \ud328\ud134\uc758 \ube48\ud2c8\uc744 \ud65c\uc6a9\ud558\uc5ec \uc774\ub3d9 \ud0c0\uc774\ubc0d\uc744 \uacc4\ud68d\ud558\uc138\uc694. STEP3: \uc881\uc740 \uacf5\uac04\uc744 \uc6c0\uc9c1\uc774\uae30 \uc704\ud574 \uc9e7\uc740 \uc6c0\uc9c1\uc784\uc73c\ub85c \uc815\ud655\ud558\uac8c \uacc4\ud68d\uc744 \uc2e4\ud589\ud558\uc138\uc694. \uc804\ub7b5\uc744 \uac1c\uc120\ud558\uace0 \ubc18\uc751 \uc2dc\uac04\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uae30 \uc704\ud574 \uac01 \ub2e8\uacc4\ub97c \uc5ec\ub7ec \ubc88 \uc5f0\uc2b5\ud558\uc138\uc694."}, {"question": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784 2\uc5d0\uc11c \ucda9\ub3cc \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784 2\uc5d0\uc11c \ucda9\ub3cc \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \ub808\ubca8\uc744 \uc131\uacf5\uc801\uc73c\ub85c \ud0d0\uc0c9\ud558\ub294 \ub2a5\ub825\uc5d0 \uc9c1\uc811 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc774 \uac8c\uc784\uc740 \ud53d\uc140 \ub2e8\uc704 \ucda9\ub3cc \uac10\uc9c0 \ubc29\uc2dd\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc7a5\uc560\ubb3c\uacfc\uc758 \ucd5c\uc18c\ud55c\uc758 \uc811\ucd09\uc73c\ub85c\ub3c4 \uc2e4\ud328\ud558\uac8c \ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 10\ub2e8\uacc4\uc5d0\uc11c \uc6c0\uc9c1\uc774\ub294 \ube68\uac04\uc0c9 \ub9c9\ub300\ub294 \ud53c\ud558\uae30 \uc704\ud574 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uce90\ub9ad\ud130\uac00 \uc7a5\uc560\ubb3c\uacfc \uc0c1\ud638 \uc791\uc6a9\ud558\ub294 \ubc29\uc2dd\uc744 \uc774\ud574\ud568\uc73c\ub85c\uc368 \uc548\uc804\ud55c \uacbd\ub85c\ub97c \ub354 \uc798 \uc608\uce21\ud558\uace0 \uc624\ub958\ub97c \ucd5c\uc18c\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc9c0\uc2dd\uc740 \uac8c\uc784 \ub0b4 \uc804\uccb4 \uc131\ub2a5\uacfc \uc9c4\ud589 \uc0c1\ud669\uc744 \uac1c\uc120\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "WHG2\uc758 \uace0\ub09c\uc774\ub3c4 \ub808\ubca8\uc744 \ud074\ub9ac\uc5b4\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ub294 \uace0\uae09 \uae30\uc220\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784 2\uc758 \uace0\ub09c\uc774\ub3c4 \ub808\ubca8\uc744 \ud074\ub9ac\uc5b4\ud558\ub824\uba74 \ud328\ud134 \uc554\uae30\uc640 \uc608\uce21 \uc774\ub3d9\uacfc \uac19\uc740 \uace0\uae09 \uae30\uc220\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \uc7a5\uc560\ubb3c \ud328\ud134\uc744 \uc790\uc138\ud788 \uc5f0\uad6c\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, 25\ub2e8\uacc4\uc5d0\uc11c\ub294 \ub179\uc0c9 \uc0bc\uac01\ud615\uc774 \ubcf5\uc7a1\ud558\uace0 \uc911\ucca9\ub41c \ud328\ud134\uc73c\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4. STEP2: \uc608\uce21 \uc774\ub3d9\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc7a5\uc560\ubb3c\uc758 \ub2e4\uc74c \uc704\uce58\ub97c \uc608\uce21\ud558\uc5ec \ubbf8\ub9ac \uacbd\ub85c\ub97c \uacc4\ud68d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP3: \uc881\uc740 \uacf5\uac04\uc744 \uc6c0\uc9c1\uc774\uae30 \uc704\ud574 \ube60\ub974\uace0 \uc81c\uc5b4\ub41c \uc785\ub825\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc6c0\uc9c1\uc784\uc744 \uc815\ud655\ud558\uac8c \uc218\ud589\ud558\uc138\uc694. \ub610\ud55c, \ud2b9\uc815 \uad6c\uac04\uc744 \ubc18\ubcf5 \uc5f0\uc2b5\ud560 \uc218 \uc788\ub3c4\ub85d \ub418\uac10\uae30 \uae30\ub2a5\uc744 \ud65c\uc6a9\ud574 \ubcf4\uc138\uc694. \uc774\ub7ec\ud55c \uae30\uc220\uacfc \uc778\ub0b4\uc2ec \ubc0f \uc5f0\uc2b5\uc744 \ud1b5\ud574 \uc131\uacf5 \uac00\ub2a5\uc131\uc744 \ud06c\uac8c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784 2\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784 2\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ub0a8\uc740 \uc0dd\uba85 \uc218\uc640 \uac01 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\ub294 \ub370 \uac78\ub9b0 \uc2dc\uac04\uc744 \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. \uc810\uc218\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc2e4\uc218\ub97c \ucd5c\uc18c\ud654\ud558\uc5ec \uc0dd\uba85\uc744 \uc720\uc9c0\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, 5\ub2e8\uacc4\uc5d0\uc11c\ub294 \ucda9\ub3cc \uc704\ud5d8 \uc5c6\uc774 \uc6c0\uc9c1\uc774\ub294 \uc7a5\uc560\ubb3c\uc744 \ud1b5\uacfc\ud558\uae30 \uc704\ud574 \uc2dc\uac04\uc744 \ub4e4\uc774\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uc815\ud655\uc131\uc744 \ub5a8\uc5b4\ub728\ub9ac\uc9c0 \uc54a\uace0 \uac00\ub2a5\ud55c \ud55c \ube60\ub974\uac8c \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uc138\uc694. \uc18d\ub3c4\uc640 \uc548\uc804\uc131 \uc0ac\uc774\uc758 \ucd5c\uc801\uc758 \uade0\ud615\uc744 \ucc3e\uae30 \uc704\ud574 \uac01 \ub808\ubca8\uc744 \uc5f0\uc2b5\ud558\uc138\uc694. \uc774 \ub450 \uce21\uba74\uc744 \ubaa8\ub450 \ub9c8\uc2a4\ud130\ud568\uc73c\ub85c\uc368 \ub354 \ub192\uc740 \uc810\uc218\ub97c \ubc1b\uace0 \uac8c\uc784 \ub0b4 \uc804\uccb4 \uc21c\uc704\ub97c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "PC \ubc0f \ubaa8\ubc14\uc77c \ubc84\uc804\uc758 WHG2 \uac8c\uc784\ud50c\ub808\uc774\uc5d0\uc11c \uc5b4\ub5a4 \ucc28\uc774\uc810\uc774 \uc788\ub098\uc694?", "answer": "PC \ubc0f \ubaa8\ubc14\uc77c \ubc84\uc804\uc758 \uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784 2\ub294 \uc8fc\ub85c \uc81c\uc5b4 \ubc29\uc2dd\uacfc \ud654\uba74 \ud06c\uae30\uc5d0\uc11c \ucc28\uc774\uac00 \uc788\uc2b5\ub2c8\ub2e4. PC\uc5d0\uc11c\ub294 \uc815\ud655\ud55c \uc6c0\uc9c1\uc784\uc744 \uc704\ud574 \ubc29\ud5a5\ud0a4\ub97c \uc0ac\uc6a9\ud558\ub294 \ubc18\uba74, \ubaa8\ubc14\uc77c\uc5d0\uc11c\ub294 \uc815\ud655\ub3c4\uac00 \ub5a8\uc5b4\uc9c8 \uc218 \uc788\ub294 \ud130\uce58 \ucee8\ud2b8\ub864\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubaa8\ubc14\uc77c\uc5d0\uc11c 8\ub2e8\uacc4\ub97c \uc774\ub3d9\ud558\ub294 \uac83\uc740 \ud130\uce58 \uc785\ub825\uc758 \ubbfc\uac10\ub3c4 \ub54c\ubb38\uc5d0 \ub354 \ub9ce\uc740 \uc5f0\uc2b5\uc774 \ud544\uc694\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \ubaa8\ubc14\uc77c\uc758 \uc791\uc740 \ud654\uba74 \ud06c\uae30\ub294 \uc7a5\uc560\ubb3c\uc744 \ubcf4\uae30 \uc5b4\ub835\uac8c \ub9cc\ub4e4\uc5b4 \uc9d1\uc911\ub825\uc774 \ub354 \ud544\uc694\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \uc774\ub7ec\ud55c \ucc28\uc774\uc5d0\ub3c4 \ubd88\uad6c\ud558\uace0 \uae30\ubcf8\uc801\uc778 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc740 \ub3d9\uc77c\ud558\uba70, \uc5f0\uc2b5\uc744 \ud1b5\ud574 \uc5b4\ub5a4 \ubc84\uc804\uc5d0\ub3c4 \uc131\uacf5\uc801\uc73c\ub85c \uc801\uc751\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784 2\uc5d0\uc11c \uc228\uaca8\uc9c4 \ub808\ubca8\uc774\ub098 \ube44\ubc00\uc744 \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\ub098\uc694?", "answer": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784 2\uc5d0\uc11c \uc228\uaca8\uc9c4 \ub808\ubca8\uc774\ub098 \ube44\ubc00\uc744 \ucc3e\uc73c\ub824\uba74 \ucca0\uc800\ud55c \ud0d0\ud5d8\uacfc \uc138\ubd80 \uc0ac\ud56d\uc5d0 \ub300\ud55c \uc8fc\uc758\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 12\ub2e8\uacc4\uc5d0\uc11c\ub294 \ud2b9\uc815 \uc7a5\uc560\ubb3c \uc21c\uc11c\ub97c \uac70\uce58\uba74 \uc228\uaca8\uc9c4 \uc601\uc5ed\uc73c\ub85c \uc774\uc5b4\uc9c0\ub294 \uc228\uaca8\uc9c4 \uacbd\ub85c\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ube44\ubc00\uc744 \ucc3e\uc73c\ub824\uba74 \ub2e4\uc591\ud55c \uacbd\ub85c\ub97c \uc2dc\ub3c4\ud558\uace0 \uc7a5\uc560\ubb3c\uc5d0 \ub300\ud55c \ud2b9\uc774\ud55c \ud328\ud134\uc774\ub098 \ube48\ud2c8\uc744 \uad00\ucc30\ud558\uc138\uc694. \ub610\ud55c, \uc0ac\uc6b4\ub4dc \ud050\ub97c \uc8fc\uc758 \uae4a\uac8c \ub4e3\uac70\ub098 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \ub098\ud0c0\ub0bc \uc218 \uc788\ub294 \uc2dc\uac01\uc801 \uc774\uc0c1 \ud604\uc0c1\uc744 \ucc3e\uc73c\uc138\uc694. \uc774\ub7ec\ud55c \ube44\ubc00\uc744 \ucc3e\ub294 \uac83\uc740 \uc5b4\ub835\uc9c0\ub9cc, \uac8c\uc784\uc5d0 \uae4a\uc774\uc640 \uc7ac\ubbf8\ub97c \ub354\ud569\ub2c8\ub2e4."}, {"question": "WHG2\uc5d0\uc11c \uc0dd\uba85\uacfc \uc5f0\uc18d \uae30\ub2a5\uc744 \uad00\ub9ac\ud558\ub294 \ucd5c\uc0c1\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784 2\uc5d0\uc11c \uc0dd\uba85\uacfc \uc5f0\uc18d \uae30\ub2a5\uc744 \uad00\ub9ac\ud558\ub294 \uac83\uc740 \uc7a5\uae30\uc801\uc778 \uc131\uacf5\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. STEP1: \ud56d\uc0c1 \uac00\ub2a5\ud55c \ud55c \uc801\uc740 \uc2e4\uc218\ub85c \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uc5ec \uc0dd\uba85\uc744 \uc720\uc9c0\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 3\ub2e8\uacc4\uc5d0\uc11c\ub294 \uc6c0\uc9c1\uc774\ub294 \uc7a5\uc560\ubb3c\uc744 \ud1b5\uacfc\ud558\uae30 \uc704\ud574 \uc11c\ub450\ub974\uc9c0 \ub9d0\uace0 \uc2dc\uac04\uc744 \ub4e4\uc5ec\uc57c \ud569\ub2c8\ub2e4. STEP2: \ud2b9\ud788 \uace0\ub09c\uc774\ub3c4 \ub808\ubca8\uc5d0\uc11c \uc2e4\uc218 \uac00\ub2a5\uc131\uc774 \ub192\uc73c\ubbc0\ub85c \uc5f0\uc18d \uae30\ub2a5\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc138\uc694. STEP3: \uc2e4\uc218\ub97c \ucd5c\uc18c\ud654\ud558\uace0 \uc804\uccb4 \uc131\ub2a5\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uae30 \uc704\ud574 \uc5b4\ub824\uc6b4 \uad6c\uac04\uc744 \ubc18\ubcf5\uc801\uc73c\ub85c \uc5f0\uc2b5\ud558\uc138\uc694. \uc774\ub7ec\ud55c \ubc29\ubc95\uc744 \ub530\ub974\uba74 \uac8c\uc784 \ud50c\ub808\uc774 \uc2dc\uac04\uc744 \uc5f0\uc7a5\ud558\uace0 \uac8c\uc784\uc744 \uc644\ub8cc\ud560 \uac00\ub2a5\uc131\uc744 \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784 2\uc758 \ub09c\uc774\ub3c4 \uace1\uc120\uc774 \ub2e4\ub978 \ud37c\uc990 \uac8c\uc784\uacfc \ube44\uad50\ud558\uc5ec \uc5b4\ub5bb\uac8c \ub2e4\ub978\uac00\uc694?", "answer": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784 2\uc758 \ub09c\uc774\ub3c4 \uace1\uc120\uc740 \ub2e4\ub978 \ub9ce\uc740 \ud37c\uc990 \uac8c\uc784\uc5d0 \ube44\ud574 \uc0c1\ub2f9\ud788 \uac00\ud30c\ub985\ub2c8\ub2e4. \ub300\ubd80\ubd84\uc758 \ud37c\uc990 \uac8c\uc784\uc740 \uc810\uc9c4\uc801\uc73c\ub85c \ub09c\uc774\ub3c4\uac00 \uc99d\uac00\ud558\ub294 \ubc18\uba74, WHG2\ub294 \ucd08\uae30 \ub2e8\uacc4\ubd80\ud130 \ubcf5\uc7a1\ud55c \ud328\ud134\uacfc \uc881\uc740 \uacf5\uac04\uc744 \uc18c\uac1c\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud50c\ub808\uc774\uc5b4\ub294 \uc774\ubbf8 5\ub2e8\uacc4\uc5d0\uc11c \uc5ec\ub7ec \uac1c\uc758 \uc6c0\uc9c1\uc774\ub294 \uc7a5\uc560\ubb3c\uc744 \uc774\ub3d9\ud558\uace0 \uc788\uc73c\uba70, \uc774\ub294 \ub2e4\ub978 \uac8c\uc784\uc5d0\uc11c \ud6e8\uc52c \ub4a4\uc5d0 \ub098\ud0c0\ub0a0 \uc218 \uc788\ub294 \ub09c\uad00\uc77c \uac83\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ube60\ub978 \ub09c\uc774\ub3c4 \uc0c1\uc2b9\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \ube60\ub974\uac8c \uc801\uc751\ud558\uace0 \uae30\uc220\uc744 \uac1c\uc120\ud574\uc57c \ud569\ub2c8\ub2e4. \uac8c\uc784\uc758 \uc815\ud655\uc131\uacfc \ud0c0\uc774\ubc0d\uc5d0 \ub300\ud55c \uc911\uc810\uc740 \uc219\ub828\ub41c \ud37c\uc990 \uac8c\uc784 \uc560\ud638\uac00\uc870\ucc28\ub3c4 \ub3c5\ud2b9\ud558\uace0 \uc5b4\ub824\uc6b4 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}, {"question": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784 2\uc640 \uc804\uc791 \uc0ac\uc774\uc5d0\uc11c \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784 2\ub294 \uc804\uc791\uacfc \ube44\uad50\ud574 \ubcf5\uc7a1\ud55c \uc7a5\uc560\ubb3c \ud328\ud134\uacfc \ucd94\uac00 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc744 \ud3ec\ud568\ud55c \uba87 \uac00\uc9c0 \uc8fc\uc694 \ucc28\uc774\uc810\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, WHG2\uc5d0\uc11c\ub294 20\ub2e8\uacc4\uc5d0\uc11c \ub098\uc120\ud615\uc73c\ub85c \uc6c0\uc9c1\uc774\ub294 \ud478\ub978 \uc0ac\uac01\ud615\uacfc \uac19\uc774 \uc18d\ub3c4\uc640 \ubc29\ud5a5\uc774 \ub2e4\uc591\ud55c \uc6c0\uc9c1\uc774\ub294 \uc7a5\uc560\ubb3c\uc774 \ud2b9\uc9d5\uc774\uba70, \uc774\ub294 \uccab \ubc88\uc9f8 \uac8c\uc784\uc5d0 \uc5c6\uc5c8\uc2b5\ub2c8\ub2e4. \ub610\ud55c, WHG2\ub294 \uc0c8\ub85c\uc6b4 \ub808\ubca8 \ub514\uc790\uc778\uacfc \uc228\uaca8\uc9c4 \ube44\ubc00\uc744 \ud3ec\ud568\ud558\uc5ec \uae4a\uc774\uc640 \uc7ac\ubbf8\ub97c \ub354\ud569\ub2c8\ub2e4. \uc774 \uac8c\uc784\uc740 \ud5a5\uc0c1\ub41c \uadf8\ub798\ud53d\uacfc \uc0ac\uc6b4\ub4dc \ud6a8\uacfc\ub97c \uc81c\uacf5\ud558\uc5ec \uc804\uccb4 \ud50c\ub808\uc774\uc5b4 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ubcc0\ud654\ub294 WHG2\uac00 \uc6d0\ub798 \uac8c\uc784\uc5d0 \ube44\ud574 \ub354\uc6b1 \ub3c4\uc804\uc801\uc774\uace0 \ub9e4\ub825\uc801\uc778 \uc18d\ud3b8\uc774 \ub420 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4."}]
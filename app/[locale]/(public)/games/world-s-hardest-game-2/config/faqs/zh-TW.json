[{"question": "\u5982\u4f55\u624d\u80fd\u4f5c\u70ba\u65b0\u624b\u638c\u63e1\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232 2\u300b\u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u638c\u63e1\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232 2\u300b\u7684\u57fa\u672c\u63a7\u5236\uff0c\u9996\u5148\u8981\u719f\u6089\u65b9\u5411\u9375\u9032\u884c\u79fb\u52d5\u3002\u7df4\u7fd2\u5728\u6700\u521d\u5e7e\u500b\u95dc\u5361\u4e2d\u9032\u884c\u64cd\u4f5c\uff0c\u611f\u53d7\u5176\u53cd\u61c9\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u95dc\u4e2d\uff0c\u6162\u6162\u79fb\u52d5\u4f60\u7684\u89d2\u8272\u4ee5\u907f\u514d\u79fb\u52d5\u7684\u7d05\u8272\u5713\u9ede\u3002\u4f7f\u7528\u77ed\u800c\u63a7\u5236\u7684\u52d5\u4f5c\uff0c\u800c\u4e0d\u662f\u5feb\u901f\u6309\u9375\uff0c\u4ee5\u4fdd\u6301\u7cbe\u78ba\u5ea6\u3002\u96a8\u8457\u4f60\u8b8a\u5f97\u66f4\u8212\u9069\uff0c\u9010\u6f38\u63d0\u9ad8\u4f60\u7684\u901f\u5ea6\u3002\u6b64\u5916\uff0c\u5229\u7528\u66ab\u505c\u529f\u80fd\u7b56\u7565\u6027\u5730\u8a08\u5283\u4f60\u7684\u4e0b\u4e00\u6b65\u52d5\u4f5c\u3002\u8a18\u4f4f\uff0c\u8010\u5fc3\u548c\u7df4\u7fd2\u662f\u638c\u63e1\u63a7\u5236\u7684\u95dc\u9375\u3002"}, {"question": "\u5728\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232 2\u300b\u7684\u4e2d\u7d1a\u95dc\u5361\u4e2d\uff0c\u54ea\u4e9b\u662f\u5fc5\u8981\u7684\u653b\u7565\u7b56\u7565\uff1f", "answer": "\u5728\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232 2\u300b\u7684\u4e2d\u7d1a\u95dc\u5361\u4e2d\u53d6\u5f97\u9032\u5c55\uff0c\u9700\u8981\u7d50\u5408\u6642\u9593\u548c\u6a21\u5f0f\u8b58\u5225\u7684\u80fd\u529b\u3002\u6b65\u9a5f\u4e00\uff1a\u89c0\u5bdf\u6bcf\u500b\u95dc\u5361\u4e2d\u969c\u7919\u7269\u7684\u79fb\u52d5\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 15 \u95dc\u4e2d\uff0c\u85cd\u8272\u65b9\u584a\u4ee5\u53ef\u9810\u6e2c\u7684\u5713\u5f62\u6a21\u5f0f\u79fb\u52d5\u3002\u6b65\u9a5f\u4e8c\uff1a\u901a\u904e\u8b58\u5225\u5b89\u5168\u5340\u57df\u4e26\u6839\u64da\u969c\u7919\u7269\u6a21\u5f0f\u4e2d\u7684\u9593\u9699\u8abf\u6574\u4f60\u7684\u79fb\u52d5\u6642\u9593\uff0c\u898f\u5283\u4f60\u7684\u8def\u7dda\u3002\u6b65\u9a5f\u4e09\uff1a\u7cbe\u78ba\u5730\u57f7\u884c\u4f60\u7684\u8a08\u5283\uff0c\u5229\u7528\u77ed\u4fc3\u7684\u79fb\u52d5\u4f86\u7a7f\u904e\u72f9\u5c0f\u7684\u7a7a\u9593\u3002\u53cd\u8986\u7df4\u7fd2\u6bcf\u500b\u95dc\u5361\uff0c\u4ee5\u5b8c\u5584\u4f60\u7684\u7b56\u7565\u4e26\u63d0\u9ad8\u4f60\u7684\u53cd\u61c9\u6642\u9593\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u7406\u89e3\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232 2\u300b\u7684\u78b0\u649e\u6a5f\u5236\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u7406\u89e3\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232 2\u300b\u7684\u78b0\u649e\u6a5f\u5236\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u76f4\u63a5\u5f71\u97ff\u4f60\u6210\u529f\u901a\u904e\u95dc\u5361\u7684\u80fd\u529b\u3002\u8a72\u904a\u6232\u4f7f\u7528\u50cf\u7d20\u7d1a\u7cbe\u78ba\u78b0\u649e\u6aa2\u6e2c\uff0c\u610f\u5473\u8457\u5373\u4f7f\u8207\u969c\u7919\u7269\u8f15\u5fae\u63a5\u89f8\u4e5f\u6703\u5c0e\u81f4\u5931\u6557\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 10 \u95dc\u4e2d\uff0c\u79fb\u52d5\u7684\u7d05\u8272\u689d\u9700\u8981\u7cbe\u78ba\u7684\u6642\u9593\u4f86\u907f\u514d\u3002\u901a\u904e\u4e86\u89e3\u4f60\u7684\u89d2\u8272\u5982\u4f55\u8207\u969c\u7919\u7269\u4e92\u52d5\uff0c\u4f60\u53ef\u4ee5\u66f4\u597d\u5730\u9810\u6e2c\u5b89\u5168\u8def\u5f91\u4e26\u5c07\u932f\u8aa4\u964d\u5230\u6700\u4f4e\u3002\u9019\u9805\u77e5\u8b58\u4f7f\u4f60\u80fd\u5920\u505a\u51fa\u66f4\u660e\u667a\u7684\u6c7a\u5b9a\uff0c\u6700\u7d42\u63d0\u5347\u4f60\u5728\u904a\u6232\u4e2d\u7684\u6574\u9ad4\u8868\u73fe\u548c\u9032\u5ea6\u3002"}, {"question": "\u54ea\u4e9b\u9ad8\u7d1a\u6280\u5de7\u53ef\u4ee5\u5e6b\u52a9\u6211\u5728\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232 2\u300b\u7684\u9ad8\u96e3\u5ea6\u95dc\u5361\u4e2d\u7372\u52dd\uff1f", "answer": "\u5728\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232 2\u300b\u7684\u9ad8\u96e3\u5ea6\u95dc\u5361\u4e2d\u7372\u52dd\uff0c\u9700\u8981\u9ad8\u7d1a\u6280\u5de7\uff0c\u4f8b\u5982\u6a21\u5f0f\u8a18\u61b6\u548c\u9810\u6e2c\u6027\u79fb\u52d5\u3002\u6b65\u9a5f\u4e00\uff1a\u4ed4\u7d30\u7814\u7a76\u969c\u7919\u7269\u7684\u79fb\u52d5\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 25 \u95dc\u4e2d\uff0c\u7da0\u8272\u4e09\u89d2\u5f62\u4ee5\u8907\u96dc\u7684\u91cd\u758a\u6a21\u5f0f\u79fb\u52d5\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u9810\u6e2c\u6027\u79fb\u52d5\u4f86\u9810\u6e2c\u969c\u7919\u7269\u7684\u4e0b\u4e00\u500b\u4f4d\u7f6e\uff0c\u8b93\u4f60\u63d0\u524d\u898f\u5283\u8def\u7dda\u3002\u6b65\u9a5f\u4e09\uff1a\u7cbe\u78ba\u5730\u57f7\u884c\u4f60\u7684\u52d5\u4f5c\uff0c\u4f7f\u7528\u5feb\u901f\u3001\u63a7\u5236\u7684\u8f38\u5165\u4f86\u7a7f\u904e\u72f9\u5c0f\u7684\u7a7a\u9593\u3002\u6b64\u5916\uff0c\u8003\u616e\u4f7f\u7528\u300c\u91cd\u64ad\u300d\u529f\u80fd\u53cd\u8986\u7df4\u7fd2\u7279\u5b9a\u90e8\u5206\uff0c\u76f4\u5230\u4f60\u638c\u63e1\u5b83\u5011\u3002\u9019\u4e9b\u6280\u5de7\u7d50\u5408\u8010\u5fc3\u548c\u7df4\u7fd2\uff0c\u5c07\u986f\u8457\u63d0\u9ad8\u4f60\u6210\u529f\u7684\u6a5f\u7387\u3002"}, {"question": "\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232 2\u300b\u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u4ee5\u53ca\u5982\u4f55\u512a\u5316\u5b83\uff1f", "answer": "\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232 2\u300b\u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u5269\u9918\u7684\u751f\u547d\u503c\u548c\u5b8c\u6210\u6bcf\u500b\u95dc\u5361\u6240\u9700\u7684\u6642\u9593\u3002\u70ba\u4e86\u512a\u5316\u4f60\u7684\u5206\u6578\uff0c\u5c08\u6ce8\u65bc\u901a\u904e\u6e1b\u5c11\u932f\u8aa4\u4f86\u4fdd\u7559\u4f60\u7684\u751f\u547d\u503c\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 5 \u95dc\u4e2d\uff0c\u82b1\u6642\u9593\u7a7f\u904e\u79fb\u52d5\u7684\u969c\u7919\u7269\uff0c\u800c\u4e0d\u662f\u5009\u4fc3\u884c\u52d5\u4e26\u5192\u8457\u78b0\u649e\u7684\u98a8\u96aa\u3002\u6b64\u5916\uff0c\u76ee\u6a19\u662f\u5728\u4e0d\u72a7\u7272\u6e96\u78ba\u6027\u7684\u524d\u63d0\u4e0b\u76e1\u5feb\u5b8c\u6210\u95dc\u5361\u3002\u7df4\u7fd2\u6bcf\u500b\u95dc\u5361\u4ee5\u627e\u5230\u901f\u5ea6\u548c\u5b89\u5168\u4e4b\u9593\u7684\u6700\u4f73\u5e73\u8861\u3002\u901a\u904e\u638c\u63e1\u9019\u5169\u500b\u65b9\u9762\uff0c\u4f60\u5c31\u53ef\u4ee5\u7372\u5f97\u66f4\u9ad8\u7684\u5206\u6578\u4e26\u63d0\u5347\u4f60\u5728\u904a\u6232\u4e2d\u7684\u6574\u9ad4\u6392\u540d\u3002"}, {"question": "\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232 2\u300b\u7684\u96fb\u8166\u7248\u548c\u624b\u6a5f\u7248\u5728\u904a\u6232\u73a9\u6cd5\u4e0a\u6709\u54ea\u4e9b\u4e0d\u540c\uff1f", "answer": "\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232 2\u300b\u7684\u96fb\u8166\u7248\u548c\u624b\u6a5f\u7248\u4e3b\u8981\u5728\u65bc\u63a7\u5236\u65b9\u6848\u548c\u87a2\u5e55\u5c3a\u5bf8\u4e0d\u540c\u3002\u5728\u96fb\u8166\u4e0a\uff0c\u4f60\u4f7f\u7528\u65b9\u5411\u9375\u9032\u884c\u7cbe\u78ba\u7684\u79fb\u52d5\uff0c\u800c\u5728\u624b\u6a5f\u4e0a\uff0c\u4f60\u4f9d\u8cf4\u89f8\u63a7\u63a7\u5236\uff0c\u9019\u53ef\u80fd\u6703\u4e0d\u592a\u6e96\u78ba\u3002\u4f8b\u5982\uff0c\u5728\u624b\u6a5f\u4e0a\u901a\u904e\u7b2c 8 \u95dc\u53ef\u80fd\u9700\u8981\u66f4\u591a\u7df4\u7fd2\uff0c\u56e0\u70ba\u89f8\u63a7\u8f38\u5165\u7684\u654f\u611f\u5ea6\u8f03\u4f4e\u3002\u6b64\u5916\uff0c\u624b\u6a5f\u4e0a\u7684\u87a2\u5e55\u5c3a\u5bf8\u8f03\u5c0f\uff0c\u53ef\u80fd\u4f7f\u4f60\u66f4\u96e3\u770b\u5230\u969c\u7919\u7269\uff0c\u9700\u8981\u66f4\u591a\u6ce8\u610f\u529b\u3002\u5118\u7ba1\u5b58\u5728\u9019\u4e9b\u5dee\u7570\uff0c\u6838\u5fc3\u904a\u6232\u6a5f\u5236\u4ecd\u7136\u76f8\u540c\uff0c\u4e26\u901a\u904e\u7df4\u7fd2\uff0c\u4f60\u53ef\u4ee5\u6210\u529f\u9069\u61c9\u4efb\u4f55\u4e00\u500b\u7248\u672c\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232 2\u300b\u4e2d\u767c\u73fe\u96b1\u85cf\u7684\u95dc\u5361\u6216\u79d8\u5bc6\uff1f", "answer": "\u5728\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232 2\u300b\u4e2d\u767c\u73fe\u96b1\u85cf\u7684\u95dc\u5361\u6216\u79d8\u5bc6\u9700\u8981\u5fb9\u5e95\u63a2\u7d22\u548c\u4ed4\u7d30\u89c0\u5bdf\u7d30\u7bc0\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 12 \u95dc\u4e2d\uff0c\u5982\u679c\u4f60\u6309\u7167\u7279\u5b9a\u969c\u7919\u7269\u7684\u9806\u5e8f\u7a7f\u904e\uff0c\u5c31\u6703\u6709\u4e00\u500b\u96b1\u85cf\u7684\u8def\u5f91\u901a\u5f80\u4e00\u500b\u79d8\u5bc6\u5340\u57df\u3002\u70ba\u4e86\u627e\u5230\u9019\u4e9b\u79d8\u5bc6\uff0c\u8acb\u5617\u8a66\u4e0d\u540c\u7684\u8def\u7dda\uff0c\u4e26\u89c0\u5bdf\u4efb\u4f55\u4e0d\u5c0b\u5e38\u7684\u6a21\u5f0f\u6216\u969c\u7919\u7269\u4e2d\u7684\u9593\u9699\u3002\u6b64\u5916\uff0c\u50be\u807d\u97f3\u6548\u63d0\u793a\u6216\u5c0b\u627e\u53ef\u80fd\u986f\u793a\u96b1\u85cf\u5167\u5bb9\u7684\u53ef\u8996\u7570\u5e38\u3002\u96d6\u7136\u9019\u4e9b\u79d8\u5bc6\u5f88\u96e3\u627e\u5230\uff0c\u4f46\u5b83\u5011\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u984d\u5916\u7684\u6df1\u5ea6\u548c\u53ef\u91cd\u8907\u904a\u6232\u6027\u3002"}, {"question": "\u5728\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232 2\u300b\u4e2d\u7ba1\u7406\u751f\u547d\u503c\u548c\u7e7c\u7e8c\u904a\u6232\u7684\u6700\u4f73\u505a\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232 2\u300b\u4e2d\u7ba1\u7406\u751f\u547d\u503c\u548c\u7e7c\u7e8c\u904a\u6232\u5c0d\u65bc\u9577\u671f\u6210\u529f\u81f3\u95dc\u91cd\u8981\u3002\u6b65\u9a5f\u4e00\uff1a\u59cb\u7d42\u52aa\u529b\u4ee5\u6700\u5c11\u932f\u8aa4\u5b8c\u6210\u95dc\u5361\u4ee5\u4fdd\u7559\u4f60\u7684\u751f\u547d\u503c\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 3 \u95dc\u4e2d\uff0c\u82b1\u6642\u9593\u7a7f\u904e\u79fb\u52d5\u7684\u969c\u7919\u7269\uff0c\u800c\u4e0d\u662f\u5009\u4fc3\u884c\u52d5\u3002\u6b65\u9a5f\u4e8c\uff1a\u5728\u9ad8\u96e3\u5ea6\u95dc\u5361\u4e2d\uff0c\u5c24\u5176\u662f\u932f\u8aa4\u767c\u751f\u7387\u8f03\u9ad8\u7684\u95dc\u5361\uff0c\u7b56\u7565\u6027\u5730\u4f7f\u7528\u7e7c\u7e8c\u529f\u80fd\u3002\u6b65\u9a5f\u4e09\uff1a\u53cd\u8986\u7df4\u7fd2\u56f0\u96e3\u7684\u90e8\u5206\u4ee5\u6e1b\u5c11\u932f\u8aa4\u4e26\u63d0\u9ad8\u4f60\u7684\u6574\u9ad4\u8868\u73fe\u3002\u901a\u904e\u63a1\u7528\u9019\u4e9b\u505a\u6cd5\uff0c\u4f60\u53ef\u4ee5\u5ef6\u9577\u4f60\u7684\u904a\u6232\u6642\u9593\u4e26\u589e\u52a0\u5b8c\u6210\u904a\u6232\u7684\u6a5f\u7387\u3002"}, {"question": "\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232 2\u300b\u7684\u96e3\u5ea6\u66f2\u7dda\u8207\u5176\u4ed6\u76ca\u667a\u904a\u6232\u76f8\u6bd4\u5982\u4f55\uff1f", "answer": "\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232 2\u300b\u7684\u96e3\u5ea6\u66f2\u7dda\u660e\u986f\u6bd4\u8a31\u591a\u5176\u4ed6\u76ca\u667a\u904a\u6232\u66f4\u9661\u5ced\u3002\u96d6\u7136\u5927\u591a\u6578\u76ca\u667a\u904a\u6232\u7684\u96e3\u5ea6\u6703\u9010\u6f38\u589e\u52a0\uff0c\u4f46\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232 2\u300b\u5728\u65e9\u671f\u5c31\u5f15\u5165\u4e86\u8907\u96dc\u7684\u6a21\u5f0f\u548c\u72f9\u5c0f\u7684\u7a7a\u9593\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 5 \u95dc\uff0c\u73a9\u5bb6\u5df2\u7d93\u9700\u8981\u5728\u591a\u500b\u79fb\u52d5\u969c\u7919\u7269\u4e2d\u7a7f\u68ad\uff0c\u9019\u662f\u4e00\u500b\u5728\u5176\u4ed6\u904a\u6232\u4e2d\u53ef\u80fd\u5728\u5f8c\u9762\u7684\u95dc\u5361\u624d\u51fa\u73fe\u7684\u6311\u6230\u3002\u9019\u7a2e\u5feb\u901f\u63d0\u5347\u8981\u6c42\u73a9\u5bb6\u5feb\u901f\u9069\u61c9\u4e26\u7cbe\u7149\u4ed6\u5011\u7684\u6280\u80fd\u3002\u904a\u6232\u8457\u91cd\u65bc\u7cbe\u78ba\u6027\u548c\u6642\u9593\uff0c\u4f7f\u5176\u6210\u70ba\u4e00\u500b\u7368\u7279\u4e14\u5177\u6709\u6311\u6230\u6027\u7684\u9ad4\u9a57\uff0c\u5373\u4f7f\u662f\u7d93\u9a57\u8c50\u5bcc\u7684\u76ca\u667a\u904a\u6232\u611b\u597d\u8005\u3002"}, {"question": "\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232 2\u300b\u8207\u5176\u524d\u4f5c\u76f8\u6bd4\uff0c\u6709\u54ea\u4e9b\u95dc\u9375\u5dee\u7570\uff1f", "answer": "\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232 2\u300b\u8207\u5176\u524d\u4f5c\u76f8\u6bd4\uff0c\u5f15\u5165\u4e86\u5e7e\u500b\u95dc\u9375\u7684\u5dee\u7570\uff0c\u5305\u62ec\u66f4\u8907\u96dc\u7684\u969c\u7919\u7269\u6a21\u5f0f\u548c\u984d\u5916\u7684\u904a\u6232\u6a5f\u5236\u3002\u4f8b\u5982\uff0c\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232 2\u300b\u5305\u542b\u79fb\u52d5\u901f\u5ea6\u548c\u65b9\u5411\u5404\u7570\u7684\u969c\u7919\u7269\uff0c\u4f8b\u5982\u7b2c 20 \u95dc\u4e2d\u65cb\u8f49\u7684\u85cd\u8272\u65b9\u584a\uff0c\u5728\u7b2c\u4e00\u6b3e\u904a\u6232\u4e2d\u4e26\u4e0d\u5b58\u5728\u3002\u6b64\u5916\uff0c\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232 2\u300b\u5305\u542b\u65b0\u7684\u95dc\u5361\u8a2d\u8a08\u548c\u96b1\u85cf\u7684\u79d8\u5bc6\uff0c\u589e\u52a0\u4e86\u6df1\u5ea6\u548c\u53ef\u91cd\u8907\u904a\u6232\u6027\u3002\u904a\u6232\u9084\u63d0\u4f9b\u6539\u9032\u7684\u5716\u5f62\u548c\u97f3\u6548\uff0c\u589e\u5f37\u4e86\u6574\u9ad4\u904a\u6232\u9ad4\u9a57\u3002\u9019\u4e9b\u8b8a\u5316\u4f7f\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232 2\u300b\u6210\u70ba\u4e00\u500b\u6bd4\u539f\u7248\u904a\u6232\u66f4\u5177\u6311\u6230\u6027\u548c\u4ee4\u4eba\u8208\u596e\u7684\u7e8c\u4f5c\u3002"}]
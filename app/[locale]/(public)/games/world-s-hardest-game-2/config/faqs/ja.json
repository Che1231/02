[{"question": "\u30ef\u30fc\u30eb\u30c9\u6700\u96e3\u30b2\u30fc\u30e02\u306e\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001\u57fa\u672c\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9\u6700\u96e3\u30b2\u30fc\u30e02\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u307e\u305a\u77e2\u5370\u30ad\u30fc\u306b\u3088\u308b\u79fb\u52d5\u306b\u6163\u308c\u308b\u3053\u3068\u304b\u3089\u59cb\u3081\u307e\u3057\u3087\u3046\u3002\u6700\u521d\u306e\u6570\u30ec\u30d9\u30eb\u3092\u30d7\u30ec\u30a4\u3057\u3066\u3001\u53cd\u5fdc\u901f\u5ea6\u3092\u63b4\u307f\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb1\u3067\u306f\u3001\u79fb\u52d5\u3059\u308b\u8d64\u3044\u70b9\u3092\u907f\u3051\u306a\u304c\u3089\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u3092\u3086\u3063\u304f\u308a\u3068\u52d5\u304b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6b63\u78ba\u3055\u3092\u4fdd\u3064\u305f\u3081\u306b\u3001\u7d20\u65e9\u304f\u30ad\u30fc\u3092\u62bc\u3059\u306e\u3067\u306f\u306a\u304f\u3001\u77ed\u3044\u5236\u5fa1\u3055\u308c\u305f\u52d5\u304d\u3092\u4f7f\u7528\u3057\u307e\u3057\u3087\u3046\u3002\u6163\u308c\u3066\u304d\u305f\u3089\u5f90\u3005\u306b\u901f\u5ea6\u3092\u4e0a\u3052\u3066\u304f\u3060\u3055\u3044\u3002\u3055\u3089\u306b\u3001\u4e00\u6642\u505c\u6b62\u6a5f\u80fd\u3092\u4f7f\u3063\u3066\u3001\u6b21\u306e\u52d5\u304d\u3092\u6226\u7565\u7684\u306b\u8a08\u753b\u3059\u308b\u3053\u3068\u3082\u6709\u52b9\u3067\u3059\u3002\u5927\u5207\u306a\u306e\u306f\u3001\u5fcd\u8010\u3068\u7df4\u7fd2\u3067\u3059\u3002"}, {"question": "WHG2\u306e\u4e2d\u7d1a\u30ec\u30d9\u30eb\u3092\u7a81\u7834\u3059\u308b\u305f\u3081\u306e\u91cd\u8981\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9\u6700\u96e3\u30b2\u30fc\u30e02\u306e\u4e2d\u7d1a\u30ec\u30d9\u30eb\u3092\u7a81\u7834\u3059\u308b\u306b\u306f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u30d1\u30bf\u30fc\u30f3\u8a8d\u8b58\u306e\u7d44\u307f\u5408\u308f\u305b\u304c\u5fc5\u8981\u3067\u3059\u3002STEP1\uff1a\u5404\u30ec\u30d9\u30eb\u3067\u969c\u5bb3\u7269\u306e\u52d5\u304d\u3092\u6ce8\u610f\u6df1\u304f\u89b3\u5bdf\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb15\u3067\u306f\u3001\u9752\u3044\u56db\u89d2\u5f62\u306f\u4e88\u6e2c\u53ef\u80fd\u306a\u5186\u5f62\u306e\u30d1\u30bf\u30fc\u30f3\u3067\u52d5\u304d\u307e\u3059\u3002STEP2\uff1a\u5b89\u5168\u306a\u30a8\u30ea\u30a2\u3068\u3001\u969c\u5bb3\u7269\u306e\u30d1\u30bf\u30fc\u30f3\u306b\u304a\u3051\u308b\u9699\u9593\u3068\u4e00\u81f4\u3059\u308b\u52d5\u304d\u3092\u8a08\u753b\u3059\u308b\u3053\u3068\u3067\u30eb\u30fc\u30c8\u3092\u6c7a\u3081\u307e\u3057\u3087\u3046\u3002STEP3\uff1a\u8a08\u753b\u3092\u6b63\u78ba\u306b\u5b9f\u884c\u3057\u3001\u72ed\u3044\u5834\u6240\u3092\u901a\u904e\u3059\u308b\u305f\u3081\u306b\u3001\u77ed\u3044\u52d5\u4f5c\u306e\u30d0\u30fc\u30b9\u30c8\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6226\u7565\u3092\u6d17\u7df4\u3057\u3001\u53cd\u5fdc\u6642\u9593\u3092\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u306b\u3001\u5404\u30ec\u30d9\u30eb\u3092\u4f55\u5ea6\u304b\u7df4\u7fd2\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u30ef\u30fc\u30eb\u30c9\u6700\u96e3\u30b2\u30fc\u30e02\u3067\u885d\u7a81\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u306a\u305c\u91cd\u8981\u3067\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9\u6700\u96e3\u30b2\u30fc\u30e02\u306e\u885d\u7a81\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u30ec\u30d9\u30eb\u3092\u6210\u529f\u88cf\u306b\u9032\u3080\u305f\u3081\u306b\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u3053\u306e\u30b2\u30fc\u30e0\u3067\u306f\u30d4\u30af\u30bb\u30eb\u5358\u4f4d\u306e\u885d\u7a81\u691c\u77e5\u304c\u63a1\u7528\u3055\u308c\u3066\u304a\u308a\u3001\u969c\u5bb3\u7269\u306b\u308f\u305a\u304b\u306b\u89e6\u308c\u308b\u3060\u3051\u3067\u3082\u5931\u6557\u3068\u306a\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb10\u3067\u306f\u3001\u79fb\u52d5\u3059\u308b\u8d64\u3044\u68d2\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u306f\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u6c42\u3081\u3089\u308c\u307e\u3059\u3002\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u969c\u5bb3\u7269\u3068\u3069\u306e\u3088\u3046\u306b\u76f8\u4e92\u4f5c\u7528\u3059\u308b\u304b\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u5b89\u5168\u306a\u7d4c\u8def\u3092\u3088\u308a\u826f\u304f\u4e88\u6e2c\u3057\u3001\u30a8\u30e9\u30fc\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u77e5\u8b58\u306f\u3088\u308a\u7684\u78ba\u306a\u5224\u65ad\u3092\u53ef\u80fd\u306b\u3057\u3001\u30b2\u30fc\u30e0\u5168\u4f53\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3068\u9032\u6357\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002"}, {"question": "WHG2\u306e\u9ad8\u96e3\u5ea6\u30ec\u30d9\u30eb\u3092\u653b\u7565\u3059\u308b\u305f\u3081\u306b\u5f79\u7acb\u3064\u9ad8\u5ea6\u306a\u30c6\u30af\u30cb\u30c3\u30af\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9\u6700\u96e3\u30b2\u30fc\u30e02\u306e\u9ad8\u96e3\u5ea6\u30ec\u30d9\u30eb\u3092\u653b\u7565\u3059\u308b\u306b\u306f\u3001\u30d1\u30bf\u30fc\u30f3\u8a18\u61b6\u3068\u4e88\u6e2c\u7684\u306a\u52d5\u304d\u3068\u3044\u3063\u305f\u9ad8\u5ea6\u306a\u30c6\u30af\u30cb\u30c3\u30af\u304c\u5fc5\u8981\u3067\u3059\u3002STEP1\uff1a\u969c\u5bb3\u7269\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u8a73\u7d30\u306b\u7814\u7a76\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb25\u3067\u306f\u3001\u7dd1\u8272\u306e\u4e09\u89d2\u5f62\u306f\u8907\u96d1\u3067\u91cd\u306a\u308a\u5408\u3046\u30d1\u30bf\u30fc\u30f3\u3067\u52d5\u304d\u307e\u3059\u3002STEP2\uff1a\u969c\u5bb3\u7269\u306e\u6b21\u306e\u4f4d\u7f6e\u3092\u4e88\u6e2c\u3059\u308b\u305f\u3081\u306b\u4e88\u6e2c\u7684\u306a\u52d5\u304d\u3092\u5229\u7528\u3057\u3066\u3001\u4e8b\u524d\u306b\u30eb\u30fc\u30c8\u3092\u8a08\u753b\u3057\u307e\u3057\u3087\u3046\u3002STEP3\uff1a\u6b63\u78ba\u306b\u52d5\u304d\u3092\u5b9f\u884c\u3057\u3001\u72ed\u3044\u5834\u6240\u3092\u901a\u904e\u3059\u308b\u305f\u3081\u306b\u7d20\u65e9\u304f\u5236\u5fa1\u3055\u308c\u305f\u5165\u529b\u3092\u4f7f\u7528\u3057\u307e\u3057\u3087\u3046\u3002\u307e\u305f\u3001\u7279\u5b9a\u306e\u30bb\u30af\u30b7\u30e7\u30f3\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u307e\u3067\u3001\u7e70\u308a\u8fd4\u3057\u7df4\u7fd2\u3059\u308b\u305f\u3081\u306b\u5dfb\u304d\u623b\u3057\u6a5f\u80fd\u3082\u6d3b\u7528\u3057\u307e\u3057\u3087\u3046\u3002\u3053\u308c\u3089\u306e\u30c6\u30af\u30cb\u30c3\u30af\u306f\u3001\u5fcd\u8010\u3068\u7df4\u7fd2\u3068\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3001\u6210\u529f\u3059\u308b\u78ba\u7387\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002"}, {"question": "\u30ef\u30fc\u30eb\u30c9\u6700\u96e3\u30b2\u30fc\u30e02\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u3069\u306e\u3088\u3046\u306b\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9\u6700\u96e3\u30b2\u30fc\u30e02\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6b8b\u308a\u306e\u30e9\u30a4\u30d5\u6570\u3068\u3001\u5404\u30ec\u30d9\u30eb\u3092\u5b8c\u4e86\u3059\u308b\u307e\u3067\u306e\u6642\u9593\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u30b9\u30b3\u30a2\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u30df\u30b9\u3092\u6e1b\u3089\u3057\u3001\u30e9\u30a4\u30d5\u3092\u7dad\u6301\u3059\u308b\u3053\u3068\u306b\u91cd\u70b9\u3092\u7f6e\u3044\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb5\u3067\u306f\u3001\u885d\u7a81\u306e\u30ea\u30b9\u30af\u3092\u5192\u3059\u306e\u3067\u306f\u306a\u304f\u3001\u79fb\u52d5\u3059\u308b\u969c\u5bb3\u7269\u3092\u614e\u91cd\u306b\u9032\u307f\u306a\u304c\u3089\u3001\u6642\u9593\u3092\u304b\u3051\u307e\u3057\u3087\u3046\u3002\u3055\u3089\u306b\u3001\u6b63\u78ba\u6027\u3092\u72a0\u7272\u306b\u3059\u308b\u3053\u3068\u306a\u304f\u3001\u3067\u304d\u308b\u3060\u3051\u65e9\u304f\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u3053\u3068\u3092\u76ee\u6307\u3057\u307e\u3057\u3087\u3046\u3002\u5404\u30ec\u30d9\u30eb\u3092\u7df4\u7fd2\u3057\u3001\u901f\u5ea6\u3068\u5b89\u5168\u6027\u306e\u6700\u9069\u306a\u30d0\u30e9\u30f3\u30b9\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u3092\u76ee\u6307\u3057\u307e\u3059\u3002\u4e21\u65b9\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3057\u3001\u30b2\u30fc\u30e0\u306e\u5168\u4f53\u7684\u306a\u30e9\u30f3\u30ad\u30f3\u30b0\u3092\u5411\u4e0a\u3055\u305b\u3089\u308c\u307e\u3059\u3002"}, {"question": "PC\u7248\u3068\u30e2\u30d0\u30a4\u30eb\u7248\u306eWHG2\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "PC\u7248\u3068\u30e2\u30d0\u30a4\u30eb\u7248\u306e\u30ef\u30fc\u30eb\u30c9\u6700\u96e3\u30b2\u30fc\u30e02\u306e\u4e3b\u306a\u9055\u3044\u306f\u3001\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u30b9\u30ad\u30fc\u30e0\u3068\u753b\u9762\u30b5\u30a4\u30ba\u3067\u3059\u3002PC\u3067\u306f\u6b63\u78ba\u306a\u79fb\u52d5\u306e\u305f\u3081\u306b\u77e2\u5370\u30ad\u30fc\u3092\u4f7f\u7528\u3057\u307e\u3059\u304c\u3001\u30e2\u30d0\u30a4\u30eb\u3067\u306f\u30bf\u30c3\u30c1\u64cd\u4f5c\u306b\u983c\u308b\u305f\u3081\u3001\u7cbe\u5ea6\u304c\u52a3\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30e2\u30d0\u30a4\u30eb\u3067\u30ec\u30d9\u30eb8\u3092\u30af\u30ea\u30a2\u3059\u308b\u306b\u306f\u3001\u30bf\u30c3\u30c1\u5165\u529b\u306e\u611f\u5ea6\u306e\u305f\u3081\u306b\u3088\u308a\u591a\u304f\u306e\u7df4\u7fd2\u304c\u5fc5\u8981\u306b\u306a\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30e2\u30d0\u30a4\u30eb\u306e\u5c0f\u3055\u3044\u753b\u9762\u30b5\u30a4\u30ba\u306b\u3088\u308a\u3001\u969c\u5bb3\u7269\u3092\u8996\u8a8d\u3057\u306b\u304f\u304f\u3001\u3088\u308a\u96c6\u4e2d\u529b\u304c\u5fc5\u8981\u3067\u3059\u3002\u3057\u304b\u3057\u3001\u3053\u308c\u3089\u306e\u9055\u3044\u306b\u3082\u95a2\u308f\u3089\u305a\u3001\u57fa\u672c\u7684\u306a\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u540c\u3058\u3067\u3059\u3002\u7df4\u7fd2\u3059\u308b\u3053\u3068\u3067\u3001\u3069\u3061\u3089\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u306b\u3082\u3046\u307e\u304f\u5bfe\u5fdc\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30ef\u30fc\u30eb\u30c9\u6700\u96e3\u30b2\u30fc\u30e02\u3067\u96a0\u3055\u308c\u305f\u30ec\u30d9\u30eb\u3084\u79d8\u5bc6\u3092\u767a\u898b\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9\u6700\u96e3\u30b2\u30fc\u30e02\u3067\u96a0\u3055\u308c\u305f\u30ec\u30d9\u30eb\u3084\u79d8\u5bc6\u3092\u767a\u898b\u3059\u308b\u306b\u306f\u3001\u5fb9\u5e95\u7684\u306a\u63a2\u7d22\u3068\u7d30\u90e8\u3078\u306e\u6ce8\u610f\u304c\u5fc5\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb12\u306b\u306f\u3001\u7279\u5b9a\u306e\u969c\u5bb3\u7269\u306e\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u30af\u30ea\u30a2\u3059\u308b\u3068\u3001\u79d8\u5bc6\u306e\u30a8\u30ea\u30a2\u306b\u3064\u306a\u304c\u308b\u96a0\u3057\u901a\u8def\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u306e\u3088\u3046\u306a\u79d8\u5bc6\u3092\u898b\u3064\u3051\u308b\u305f\u3081\u306b\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u30eb\u30fc\u30c8\u3092\u8a66\u3057\u3066\u3001\u969c\u5bb3\u7269\u306e\u30d1\u30bf\u30fc\u30f3\u3084\u9699\u9593\u306a\u3069\u306b\u7570\u5e38\u304c\u306a\u3044\u304b\u89b3\u5bdf\u3057\u307e\u3057\u3087\u3046\u3002\u307e\u305f\u3001\u30aa\u30fc\u30c7\u30a3\u30aa\u30ad\u30e5\u30fc\u3092\u805e\u304d\u3001\u8996\u899a\u7684\u306a\u7570\u5e38\u304c\u3042\u308b\u304b\u3082\u78ba\u8a8d\u3057\u307e\u3057\u3087\u3046\u3002\u3053\u308c\u3089\u306e\u79d8\u5bc6\u306f\u767a\u898b\u3059\u308b\u306e\u304c\u96e3\u3057\u3044\u3067\u3059\u304c\u3001\u30b2\u30fc\u30e0\u306b\u5965\u884c\u304d\u3068\u518d\u30d7\u30ec\u30a4\u6027\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002"}, {"question": "WHG2\u3067\u30e9\u30a4\u30d5\u3068\u30b3\u30f3\u30c6\u30a3\u30cb\u30e5\u30fc\u3092\u7ba1\u7406\u3059\u308b\u305f\u3081\u306e\u30d9\u30b9\u30c8\u30d7\u30e9\u30af\u30c6\u30a3\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9\u6700\u96e3\u30b2\u30fc\u30e02\u3067\u30e9\u30a4\u30d5\u3068\u30b3\u30f3\u30c6\u30a3\u30cb\u30e5\u30fc\u3092\u7ba1\u7406\u3059\u308b\u3053\u3068\u306f\u3001\u9577\u671f\u7684\u306a\u6210\u529f\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002STEP1\uff1a\u5e38\u306b\u3001\u30df\u30b9\u3092\u6700\u5c0f\u9650\u306b\u3059\u308b\u3053\u3068\u3067\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3057\u3001\u30e9\u30a4\u30d5\u3092\u7dad\u6301\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb3\u3067\u306f\u3001\u6025\u3044\u3067\u79fb\u52d5\u3059\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u79fb\u52d5\u3059\u308b\u969c\u5bb3\u7269\u3092\u3086\u3063\u304f\u308a\u9032\u3080\u6642\u9593\u3092\u78ba\u4fdd\u3057\u3066\u304f\u3060\u3055\u3044\u3002STEP2\uff1a\u7279\u306b\u9ad8\u96e3\u5ea6\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30df\u30b9\u3092\u8d77\u3053\u3057\u3084\u3059\u3044\u305f\u3081\u3001\u30b3\u30f3\u30c6\u30a3\u30cb\u30e5\u30fc\u3092\u6226\u7565\u7684\u306b\u6d3b\u7528\u3057\u307e\u3057\u3087\u3046\u3002STEP3\uff1a\u30a8\u30e9\u30fc\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u3001\u5168\u4f53\u7684\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u306b\u3001\u96e3\u3057\u3044\u30bb\u30af\u30b7\u30e7\u30f3\u3092\u7e70\u308a\u8fd4\u3057\u7df4\u7fd2\u3057\u307e\u3057\u3087\u3046\u3002\u3053\u308c\u3089\u306e\u65b9\u6cd5\u306b\u5f93\u3046\u3053\u3068\u3067\u3001\u30d7\u30ec\u30a4\u6642\u9593\u3092\u5ef6\u9577\u3057\u3001\u30b2\u30fc\u30e0\u3092\u30af\u30ea\u30a2\u3059\u308b\u78ba\u7387\u3092\u4e0a\u3052\u3089\u308c\u307e\u3059\u3002"}, {"question": "\u30ef\u30fc\u30eb\u30c9\u6700\u96e3\u30b2\u30fc\u30e02\u306e\u96e3\u6613\u5ea6\u66f2\u7dda\u306f\u3001\u4ed6\u306e\u30d1\u30ba\u30eb\u30b2\u30fc\u30e0\u3068\u6bd4\u3079\u3066\u3069\u3046\u3067\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9\u6700\u96e3\u30b2\u30fc\u30e02\u306e\u96e3\u6613\u5ea6\u66f2\u7dda\u306f\u3001\u4ed6\u306e\u591a\u304f\u306e\u30d1\u30ba\u30eb\u30b2\u30fc\u30e0\u3068\u6bd4\u3079\u3066\u5927\u5e45\u306b\u6025\u52fe\u914d\u3067\u3059\u3002\u307b\u3068\u3093\u3069\u306e\u30d1\u30ba\u30eb\u30b2\u30fc\u30e0\u304c\u5f90\u3005\u306b\u96e3\u6613\u5ea6\u3092\u4e0a\u3052\u3066\u3044\u304f\u306e\u306b\u5bfe\u3057\u3001WHG2\u306f\u8907\u96d1\u306a\u30d1\u30bf\u30fc\u30f3\u3068\u72ed\u3044\u30b9\u30da\u30fc\u30b9\u3092\u521d\u671f\u6bb5\u968e\u304b\u3089\u5c0e\u5165\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb5\u307e\u3067\u306b\u3059\u3067\u306b\u8907\u6570\u306e\u79fb\u52d5\u3059\u308b\u969c\u5bb3\u7269\u3092\u901a\u904e\u3057\u306a\u3051\u308c\u3070\u306a\u3089\u306a\u3044\u3053\u3068\u304b\u3089\u3001\u4ed6\u306e\u30b2\u30fc\u30e0\u3067\u306f\u305a\u3063\u3068\u5f8c\u306b\u73fe\u308c\u308b\u3088\u3046\u306a\u6311\u6226\u304c\u51fa\u3066\u304d\u307e\u3059\u3002\u3053\u306e\u6025\u6fc0\u306a\u96e3\u6613\u5ea6\u4e0a\u6607\u306f\u3001\u30d7\u30ec\u30fc\u30e4\u30fc\u304c\u3059\u3050\u306b\u9069\u5fdc\u3057\u3001\u30b9\u30ad\u30eb\u3092\u6d17\u7df4\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u3053\u3068\u3092\u610f\u5473\u3057\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306e\u6b63\u78ba\u3055\u3084\u30bf\u30a4\u30df\u30f3\u30b0\u3078\u306e\u91cd\u70b9\u306f\u3001\u30d9\u30c6\u30e9\u30f3\u306e\u30d1\u30ba\u30eb\u30b2\u30fc\u30e0\u611b\u597d\u5bb6\u306b\u3082\u72ec\u7279\u3067\u6311\u6226\u7684\u306a\u7d4c\u9a13\u3092\u3082\u305f\u3089\u3057\u307e\u3059\u3002"}, {"question": "\u30ef\u30fc\u30eb\u30c9\u6700\u96e3\u30b2\u30fc\u30e02\u3068\u524d\u4f5c\u3068\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9\u6700\u96e3\u30b2\u30fc\u30e02\u306f\u3001\u524d\u4f5c\u3068\u6bd4\u3079\u3066\u3001\u3088\u308a\u8907\u96d1\u306a\u969c\u5bb3\u7269\u30d1\u30bf\u30fc\u30f3\u3084\u8ffd\u52a0\u306e\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u5c0e\u5165\u3057\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001WHG2\u306f\u901f\u5ea6\u3084\u65b9\u5411\u304c\u7570\u306a\u308b\u79fb\u52d5\u3059\u308b\u969c\u5bb3\u7269\u3092\u7279\u5fb4\u3068\u3057\u3066\u3044\u307e\u3059\uff08\u30ec\u30d9\u30eb20\u306b\u3042\u308b\u3089\u305b\u3093\u72b6\u306e\u9752\u3044\u56db\u89d2\u5f62\u306a\u3069\uff09\u3001\u3053\u308c\u306f\u6700\u521d\u306e\u30b2\u30fc\u30e0\u306b\u306f\u3042\u308a\u307e\u305b\u3093\u3067\u3057\u305f\u3002\u3055\u3089\u306b\u3001WHG2\u306b\u306f\u65b0\u3057\u3044\u30ec\u30d9\u30eb\u30c7\u30b6\u30a4\u30f3\u3084\u96a0\u3055\u308c\u305f\u79d8\u5bc6\u304c\u8ffd\u52a0\u3055\u308c\u3066\u304a\u308a\u3001\u5965\u884c\u304d\u3068\u518d\u30d7\u30ec\u30a4\u6027\u3092\u9ad8\u3081\u3066\u3044\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306f\u3001\u5168\u4f53\u7684\u306b\u30d7\u30ec\u30fc\u30e4\u30fc\u30a8\u30af\u30b9\u30da\u30ea\u30a8\u30f3\u30b9\u3092\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u306e\u3001\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u3068\u97f3\u97ff\u52b9\u679c\u3082\u6539\u5584\u3055\u308c\u307e\u3057\u305f\u3002\u3053\u308c\u3089\u306e\u5909\u66f4\u306b\u3088\u308a\u3001WHG2\u306f\u3001\u30aa\u30ea\u30b8\u30ca\u30eb\u306e\u30b2\u30fc\u30e0\u3068\u6bd4\u3079\u3066\u3001\u3088\u308a\u6311\u6226\u7684\u3067\u9b45\u529b\u7684\u306a\u7d9a\u7de8\u3068\u306a\u3063\u3066\u3044\u307e\u3059\u3002"}]
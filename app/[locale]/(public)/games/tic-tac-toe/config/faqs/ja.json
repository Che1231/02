[{"question": "\u521d\u3081\u3066\u306e\u65b9\u3001\u3069\u306e\u3088\u3046\u306b\u3057\u3066tic-tac-toe\u3092\u59cb\u3081\u3089\u308c\u307e\u3059\u304b\uff1f", "answer": "tic-tac-toe\u3092\u59cb\u3081\u308b\u306b\u306f\u30013\u00d73\u306e\u30b0\u30ea\u30c3\u30c9\u30682\u4eba\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u5fc5\u8981\u3067\u3059\u3002\u4e00\u65b9\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u300cX\u300d\u3001\u3082\u3046\u4e00\u65b9\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u300cO\u300d\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u4ea4\u4e92\u306b\u30b0\u30ea\u30c3\u30c9\u306e\u30b9\u30da\u30fc\u30b9\u306b\u5370\u3092\u4ed8\u3051\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d7\u30ec\u30a4\u30e4\u30fc1\u306f\u4e2d\u592e\u306b\u300cX\u300d\u3092\u7f6e\u304d\u307e\u3059\u3002\u30d7\u30ec\u30a4\u30e4\u30fc2\u306f\u6b21\u306b\u3001\u30b3\u30fc\u30ca\u30fc\u306b\u300cO\u300d\u3092\u7f6e\u304d\u307e\u3059\u3002\u76ee\u6a19\u306f\u3001\u81ea\u5206\u306e\u5370\u3092\u6c34\u5e73\u3001\u5782\u76f4\u3001\u307e\u305f\u306f\u5bfe\u89d2\u7dda\u4e0a\u306b3\u3064\u4e26\u3079\u308b\u3053\u3068\u3067\u3059\u3002\u3059\u3079\u3066\u306e\u30b9\u30da\u30fc\u30b9\u304c\u57cb\u307e\u3063\u3066\u3044\u3066\u3082\u52dd\u8005\u304c\u3044\u306a\u3044\u5834\u5408\u306f\u3001\u5f15\u304d\u5206\u3051\u3067\u3059\u3002"}, {"question": "\u3059\u3079\u3066\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u77e5\u3063\u3066\u304a\u304f\u3079\u304dtic-tac-toe\u306e\u57fa\u672c\u30eb\u30fc\u30eb\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "tic-tac-toe\u306e\u57fa\u672c\u30eb\u30fc\u30eb\u306f\u7c21\u5358\u3067\u3059\u30021) 3\u00d73\u306e\u30b0\u30ea\u30c3\u30c9\u3092\u4f7f\u7528\u3057\u307e\u3059\u30022) 2\u4eba\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u4ea4\u4e92\u306b\u300cX\u300d\u3068\u300cO\u300d\u3092\u7f6e\u304d\u307e\u3059\u30023) \u6c34\u5e73\u3001\u5782\u76f4\u3001\u307e\u305f\u306f\u5bfe\u89d2\u7dda\u4e0a\u306b3\u3064\u306e\u5370\u3092\u6700\u521d\u306b\u4e26\u3079\u305f\u4eba\u304c\u52dd\u3061\u307e\u3059\u30024) 9\u3064\u306e\u3059\u3079\u3066\u306e\u30de\u30b9\u304c\u52dd\u8005\u306a\u3057\u306b\u57cb\u307e\u3063\u3066\u3044\u308b\u5834\u5408\u3001\u5f15\u304d\u5206\u3051\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d7\u30ec\u30a4\u30e4\u30fc1\u304c\u5de6\u4e0a\u306e\u300cX\u300d\u3092\u7f6e\u304f\u5834\u5408\u3001\u30d7\u30ec\u30a4\u30e4\u30fc2\u306f\u4e2d\u592e\u306b\u300cO\u300d\u3092\u7f6e\u3044\u3066\u30d6\u30ed\u30c3\u30af\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "tic-tac-toe\u3067\u8ca0\u3051\u3092\u9632\u3050\u305f\u3081\u306b\u5f79\u7acb\u3064\u6226\u7565\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "tic-tac-toe\u3067\u8ca0\u3051\u3092\u9632\u3050\u305f\u3081\u306b\u3001\u6b21\u306e\u6226\u7565\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u30021) \u5e38\u306b\u4f7f\u7528\u53ef\u80fd\u306a\u5834\u5408\u3001\u4e2d\u592e\u3092\u53d6\u308a\u307e\u3059\u3002\u3053\u308c\u306f\u6700\u3082\u52dd\u5229\u3059\u308b\u6a5f\u4f1a\u3092\u63d0\u4f9b\u3057\u307e\u3059\u30022) \u76f8\u624b\u306e\u6f5c\u5728\u7684\u306a\u52dd\u5229\u306e\u624b\u3092\u963b\u6b62\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u76f8\u624b\u304c2\u3064\u306e\u300cO\u300d\u3092\u4e26\u3079\u3066\u3044\u308b\u5834\u5408\u306f\u3001\u30d6\u30ed\u30c3\u30af\u3059\u308b\u305f\u3081\u306b\u300cX\u300d\u3092\u7f6e\u304d\u307e\u3059\u30023) \u8907\u6570\u306e\u52dd\u5229\u30d1\u30b9\u3092\u540c\u6642\u306b\u4f5c\u6210\u3057\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u76f8\u624b\u306f\u9632\u5fa1\u3092\u5f37\u3044\u3089\u308c\u3001\u52dd\u5229\u3059\u308b\u53ef\u80fd\u6027\u304c\u9ad8\u307e\u308a\u307e\u3059\u3002"}, {"question": "\u306a\u305ctic-tac-toe\u306e\u4e2d\u592e\u306e\u30de\u30b9\u306f\u6700\u3082\u6226\u7565\u7684\u306b\u91cd\u8981\u3068\u898b\u306a\u3055\u308c\u308b\u306e\u3067\u3059\u304b\uff1f", "answer": "tic-tac-toe\u306e\u4e2d\u592e\u306e\u30de\u30b9\u306f\u30014\u3064\u306e\u6f5c\u5728\u7684\u306a\u52dd\u5229\u30e9\u30a4\u30f3\uff08\u6c34\u5e73\u3001\u5782\u76f4\u3001\u304a\u3088\u3073\u4e21\u65b9\u306e\u5bfe\u89d2\u7dda\uff09\u306e\u4e00\u90e8\u3067\u3042\u308b\u305f\u3081\u3001\u6700\u3082\u6226\u7565\u7684\u306b\u91cd\u8981\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u4e2d\u592e\u306b\u300cX\u300d\u3092\u7f6e\u304f\u3068\u3001\u3069\u306e\u65b9\u5411\u306b\u3082\u5370\u3092\u5408\u308f\u305b\u3066\u52dd\u5229\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u4e2d\u5fc3\u7684\u306a\u4f4d\u7f6e\u306f\u3001\u3042\u306a\u305f\u306e\u6a5f\u4f1a\u3092\u6700\u5927\u5316\u3057\u3001\u76f8\u624b\u304c\u52dd\u5229\u30e9\u30a4\u30f3\u3092\u5f62\u6210\u3059\u308b\u6a5f\u4f1a\u3092\u5236\u9650\u3057\u307e\u3059\u3002"}, {"question": "\u7d4c\u9a13\u8c4a\u5bcc\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u76f8\u624b\u306btic-tac-toe\u3067\u5f15\u304d\u5206\u3051\u306b\u6301\u3061\u8fbc\u3080\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u7d4c\u9a13\u8c4a\u5bcc\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u76f8\u624b\u306btic-tac-toe\u3067\u5f15\u304d\u5206\u3051\u306b\u6301\u3061\u8fbc\u3080\u306b\u306f\u3001\u6b21\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\u30021) \u521d\u624b\u306f\u5e38\u306b\u4e2d\u592e\u3092\u53d6\u308a\u307e\u3059\u30022) \u30d6\u30ed\u30c3\u30af\u306e\u6a5f\u4f1a\u3092\u6700\u5927\u5316\u3059\u308b\u3088\u3046\u306b\u3001\u30b3\u30fc\u30ca\u30fc\u306b\u5370\u3092\u7f6e\u304d\u307e\u3059\u30023) \u76f8\u624b\u306e\u52d5\u304d\u306b\u5bfe\u5fdc\u3057\u3066\u3001\u5f7c\u3089\u306e\u6f5c\u5728\u7684\u306a\u52dd\u5229\u306e\u30e9\u30a4\u30f3\u3092\u30d6\u30ed\u30c3\u30af\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u76f8\u624b\u304c\u30b3\u30fc\u30ca\u30fc\u306b\u300cO\u300d\u3092\u7f6e\u3044\u305f\u5834\u5408\u3001\u53cd\u5bfe\u5074\u306e\u30b3\u30fc\u30ca\u30fc\u306b\u300cX\u300d\u3092\u7f6e\u304d\u307e\u3059\u3002\u3053\u306e\u6226\u7565\u306b\u3088\u308a\u3001\u3069\u3061\u3089\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3082\u52dd\u5229\u3067\u304d\u307e\u305b\u3093\u3002"}, {"question": "tic-tac-toe\u3067\u78ba\u5b9f\u306b\u52dd\u5229\u3059\u308b\u4e0a\u7d1a\u30c6\u30af\u30cb\u30c3\u30af\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "tic-tac-toe\u3067\u78ba\u5b9f\u306b\u52dd\u5229\u3059\u308b\u4e0a\u7d1a\u30c6\u30af\u30cb\u30c3\u30af\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\u30021) \u30b2\u30fc\u30e0\u3092\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3059\u308b\u305f\u3081\u306b\u4e2d\u592e\u304b\u3089\u59cb\u3081\u307e\u3059\u30022) \u300c\u30d5\u30a9\u30fc\u30af\u300d\u3092\u4f5c\u6210\u3057\u307e\u3059\u3002\u540c\u6642\u306b2\u3064\u306e\u52dd\u5229\u306e\u52d5\u304d\u3092\u8a2d\u5b9a\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u30012\u3064\u306e\u30b3\u30fc\u30ca\u30fc\u306b\u300cX\u300d\u3092\u7f6e\u304f\u3068\u3001\u76f8\u624b\u306f\u4e00\u65b9\u3092\u30d6\u30ed\u30c3\u30af\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u3001\u3082\u3046\u4e00\u65b9\u3092\u4f7f\u3063\u3066\u52dd\u5229\u3067\u304d\u307e\u3059\u30023) \u5e38\u306b\u76f8\u624b\u306e\u6f5c\u5728\u7684\u306a\u52dd\u5229\u306e\u52d5\u304d\u3092\u30d6\u30ed\u30c3\u30af\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u624b\u9806\u306b\u3088\u308a\u3001\u512a\u4f4d\u6027\u3092\u7dad\u6301\u3067\u304d\u307e\u3059\u3002"}, {"question": "tic-tac-toe\u306e\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u9593\u306e\u516c\u5e73\u6027\u3092\u3069\u306e\u3088\u3046\u306b\u4fdd\u8a3c\u3057\u3066\u3044\u307e\u3059\u304b\uff1f", "answer": "tic-tac-toe\u306f\u3001\u305d\u306e\u5358\u7d14\u3067\u30bf\u30fc\u30f3\u30d9\u30fc\u30b9\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u3088\u3063\u3066\u516c\u5e73\u6027\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002\u4e21\u65b9\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u5370\u3092\u7f6e\u304f\u6a5f\u4f1a\u304c\u5e73\u7b49\u3067\u3059\u3002\u30b2\u30fc\u30e0\u306e\u5bfe\u79f0\u6027\u306b\u3088\u308a\u3001\u3044\u305a\u308c\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3082\u56fa\u6709\u306e\u5229\u70b9\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u305f\u3068\u3048\u3070\u3001\u30d7\u30ec\u30a4\u30e4\u30fc1\u304c\u4e2d\u592e\u3092\u53d6\u308b\u3068\u3001\u30d7\u30ec\u30a4\u30e4\u30fc2\u306f\u30b3\u30fc\u30ca\u30fc\u3092\u9078\u629e\u3059\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u52b9\u679c\u7684\u306b\u30d6\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u30d0\u30e9\u30f3\u30b9\u306b\u3088\u308a\u3001\u30b2\u30fc\u30e0\u306f\u516c\u5e73\u3067\u7af6\u4e89\u529b\u304c\u9ad8\u307e\u308a\u307e\u3059\u3002\u719f\u7df4\u3057\u305f\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u9593\u3067\u306f\u3001\u5f15\u304d\u5206\u3051\u306b\u306a\u308b\u3053\u3068\u304c\u3088\u304f\u3042\u308a\u307e\u3059\u3002"}, {"question": "tic-tac-toe\u3067\u52dd\u5229\u3001\u6557\u5317\u3001\u307e\u305f\u306f\u5f15\u304d\u5206\u3051\u306e\u78ba\u7387\u3092\u6570\u5024\u3067\u8868\u3059\u3053\u3068\u306f\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "tic-tac-toe\u3067\u306f\u3001\u6570\u5024\u306e\u78ba\u7387\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\u30021) \u52dd\u5229\uff1a\u6700\u9069\u306a\u30d7\u30ec\u30a4\u3092\u3057\u305f\u5834\u5408\u3001\u6700\u521d\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u7d0431\uff05\u3067\u3059\u30022) \u6557\u5317\uff1a\u540c\u3058\u6761\u4ef6\u4e0b\u30672\u756a\u76ee\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u7d0431\uff05\u3067\u3059\u30023) \u5f15\u304d\u5206\u3051\uff1a\u4e21\u65b9\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u6700\u9069\u306a\u6226\u7565\u3092\u4f7f\u7528\u3057\u305f\u5834\u5408\u306f\u7d0438\uff05\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d7\u30ec\u30a4\u30e4\u30fc1\u304c\u4e2d\u592e\u304b\u3089\u958b\u59cb\u3057\u3001\u30d7\u30ec\u30a4\u30e4\u30fc2\u304c\u6b63\u3057\u304f\u53cd\u5fdc\u3057\u305f\u5834\u5408\u3001\u30b2\u30fc\u30e0\u306f\u5f15\u304d\u5206\u3051\u306b\u306a\u308b\u53ef\u80fd\u6027\u304c\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002"}, {"question": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u79c1\u306etic-tac-toe\u306e\u9032\u6357\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067tic-tac-toe\u306e\u9032\u6357\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001\u4f7f\u7528\u3055\u308c\u3066\u3044\u308b\u30a2\u30d7\u30ea\u307e\u305f\u306f\u30b5\u30fc\u30d3\u30b9\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u3002\u4e00\u90e8\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306f\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u63d0\u4f9b\u3057\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ed\u30b0\u30a4\u30f3\u6a5f\u80fd\u3092\u6301\u3064\u30b2\u30fc\u30e0\u30a2\u30d7\u30ea\u3092\u4f7f\u7528\u3057\u3066\u3044\u308b\u5834\u5408\u306f\u3001\u9032\u6357\u72b6\u6cc1\u304c\u81ea\u52d5\u7684\u306b\u540c\u671f\u3055\u308c\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u30a8\u30af\u30b9\u30dd\u30fc\u30c8/\u30a4\u30f3\u30dd\u30fc\u30c8\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u63a2\u3057\u305f\u308a\u3001\u30b5\u30dd\u30fc\u30c8\u306b\u9023\u7d61\u3057\u3066\u30ac\u30a4\u30c0\u30f3\u30b9\u3092\u6c42\u3081\u305f\u308a\u3057\u307e\u3059\u3002\u4e21\u65b9\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u304c\u4e92\u63db\u6027\u306e\u305f\u3081\u306b\u540c\u3058\u30d0\u30fc\u30b8\u30e7\u30f3\u306e\u30b2\u30fc\u30e0\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "tic-tac-toe\u306b\u306f\u3001\u96a0\u308c\u305f\u30d1\u30bf\u30fc\u30f3\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "tic-tac-toe\u306b\u306f\u3001\u5404\u884c\u3001\u5217\u3001\u304a\u3088\u3073\u5bfe\u89d2\u7dda\u306e\u5408\u8a08\u304c15\u306b\u306a\u308b\u3088\u3046\u306b\u30011\u301c9\u306e\u6570\u3092\u914d\u7f6e\u3057\u305f\u300c\u30de\u30b8\u30c3\u30af\u30b9\u30af\u30a8\u30a2\u300d\u306e\u3088\u3046\u306a\u96a0\u308c\u305f\u30d1\u30bf\u30fc\u30f3\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300cX\u300d\u30925\uff08\u4e2d\u592e\uff09\u306b\u7f6e\u304d\u3001\u300cO\u300d\u30922\u306b\u7f6e\u304f\u3068\u3001\u6226\u7565\u7684\u306a\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7\u304c\u3067\u304d\u307e\u3059\u3002\u30c7\u30b8\u30bf\u30eb\u7248\u306e\u4e2d\u306b\u306f\u3001\u52dd\u5229\u6642\u306b\u30c6\u30fc\u30de\u304c\u4ed8\u3051\u3089\u308c\u305f\u30b0\u30ea\u30c3\u30c9\u3084\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3\u306a\u3069\u3001\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u3053\u308c\u3089\u3092\u63a2\u7d22\u3059\u308b\u3068\u3001\u3053\u306e\u53e4\u5178\u7684\u306a\u30b2\u30fc\u30e0\u306b\u697d\u3057\u3044\u8981\u7d20\u3092\u8ffd\u52a0\u3067\u304d\u307e\u3059\u3002"}]
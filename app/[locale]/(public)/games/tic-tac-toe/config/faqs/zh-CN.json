[{"question": "\u5982\u4f55\u5f00\u59cb\u73a9\u4e95\u5b57\u68cb\uff0c\u4f5c\u4e3a\u4e00\u540d\u5b8c\u5168\u7684\u521d\u5b66\u8005\uff1f", "answer": "\u8981\u5f00\u59cb\u73a9\u4e95\u5b57\u68cb\uff0c\u4f60\u9700\u8981\u4e00\u4e2a 3x3 \u7684\u68cb\u76d8\u548c\u4e24\u540d\u73a9\u5bb6\u3002\u4e00\u540d\u73a9\u5bb6\u4f7f\u7528 'X'\uff0c\u53e6\u4e00\u540d\u73a9\u5bb6\u4f7f\u7528 'O'\u3002\u73a9\u5bb6\u8f6e\u6d41\u5728\u68cb\u76d8\u4e0a\u6807\u8bb0\u4e00\u4e2a\u4f4d\u7f6e\u3002\u4f8b\u5982\uff0c\u73a9\u5bb6 1 \u5c06 'X' \u653e\u7f6e\u5728\u4e2d\u5fc3\u3002\u7136\u540e\u73a9\u5bb6 2 \u5c06 'O' \u653e\u7f6e\u5728\u89d2\u843d\u3002\u76ee\u6807\u662f\u5728\u6c34\u5e73\u3001\u5782\u76f4\u6216\u5bf9\u89d2\u7ebf\u4e0a\u83b7\u5f97\u4e09\u4e2a\u81ea\u5df1\u7684\u6807\u8bb0\u3002\u5982\u679c\u6240\u6709\u4f4d\u7f6e\u90fd\u88ab\u586b\u6ee1\u800c\u6ca1\u6709\u8d62\u5bb6\uff0c\u6e38\u620f\u5219\u5e73\u5c40\u3002"}, {"question": "\u6bcf\u4e2a\u73a9\u5bb6\u90fd\u5e94\u8be5\u77e5\u9053\u4e95\u5b57\u68cb\u7684\u57fa\u672c\u89c4\u5219\u662f\u4ec0\u4e48\uff1f", "answer": "\u4e95\u5b57\u68cb\u7684\u57fa\u672c\u89c4\u5219\u5f88\u7b80\u5355\uff1a1) \u4f7f\u7528 3x3 \u68cb\u76d8\u30022) \u4e24\u540d\u73a9\u5bb6\u8f6e\u6d41\u653e\u7f6e 'X' \u548c 'O'\u30023) \u9996\u5148\u5728\u6c34\u5e73\u3001\u5782\u76f4\u6216\u5bf9\u89d2\u7ebf\u4e0a\u6392\u5217\u4e09\u4e2a\u6807\u8bb0\u7684\u4eba\u83b7\u80dc\u30024) \u5982\u679c\u6240\u6709\u4e5d\u4e2a\u65b9\u683c\u90fd\u88ab\u586b\u6ee1\u800c\u6ca1\u6709\u8d62\u5bb6\uff0c\u5219\u5e73\u5c40\u3002\u4f8b\u5982\uff0c\u5982\u679c\u73a9\u5bb6 1 \u5c06 'X' \u653e\u7f6e\u5728\u5de6\u4e0a\u89d2\uff0c\u73a9\u5bb6 2 \u53ef\u80fd\u4f1a\u5c06 'O' \u653e\u7f6e\u5728\u4e2d\u5fc3\u4ee5\u8fdb\u884c\u5c01\u9501\u3002"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u53ef\u4ee5\u5e2e\u52a9\u6211\u5728\u4e95\u5b57\u68cb\u4e2d\u907f\u514d\u5931\u8d25\uff1f", "answer": "\u4e3a\u4e86\u5728\u4e95\u5b57\u68cb\u4e2d\u907f\u514d\u5931\u8d25\uff0c\u8bf7\u9075\u5faa\u4ee5\u4e0b\u7b56\u7565\uff1a1) \u5982\u679c\u6709\u53ef\u80fd\uff0c\u59cb\u7ec8\u5360\u636e\u4e2d\u5fc3\u4f4d\u7f6e\u2014\u2014\u5b83\u63d0\u4f9b\u4e86\u6700\u591a\u7684\u83b7\u80dc\u673a\u4f1a\u30022) \u5c01\u9501\u5bf9\u624b\u7684\u6f5c\u5728\u83b7\u80dc\u52a8\u4f5c\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4ed6\u4eec\u6709\u4e24\u4e2a 'O' \u5728\u540c\u4e00\u6761\u7ebf\u4e0a\uff0c\u8bf7\u5728\u8be5\u7ebf\u4e0a\u653e\u7f6e\u4f60\u7684 'X' \u6765\u8fdb\u884c\u5c01\u9501\u30023) \u540c\u65f6\u521b\u5efa\u591a\u4e2a\u83b7\u80dc\u8def\u5f84\u3002\u8fd9\u8feb\u4f7f\u4f60\u7684\u5bf9\u624b\u8fdb\u884c\u9632\u5b88\uff0c\u589e\u52a0\u4f60\u83b7\u80dc\u7684\u673a\u4f1a\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u4e95\u5b57\u68cb\u4e2d\u7684\u4e2d\u5fc3\u65b9\u683c\u88ab\u8ba4\u4e3a\u662f\u6700\u5177\u6218\u7565\u610f\u4e49\u7684\uff1f", "answer": "\u4e95\u5b57\u68cb\u4e2d\u7684\u4e2d\u5fc3\u65b9\u683c\u662f\u6700\u5177\u6218\u7565\u610f\u4e49\u7684\uff0c\u56e0\u4e3a\u5b83\u5c5e\u4e8e\u56db\u6761\u6f5c\u5728\u7684\u83b7\u80dc\u7ebf\uff08\u6c34\u5e73\u7ebf\u3001\u5782\u76f4\u7ebf\u548c\u4e24\u6761\u5bf9\u89d2\u7ebf\uff09\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5c06\u4f60\u7684 'X' \u653e\u7f6e\u5728\u4e2d\u5fc3\uff0c\u4f60\u53ef\u4ee5\u901a\u8fc7\u5728\u4efb\u4f55\u65b9\u5411\u4e0a\u5bf9\u9f50\u6807\u8bb0\u6765\u83b7\u80dc\u3002\u8fd9\u4e2a\u4e2d\u5fc3\u4f4d\u7f6e\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u4e86\u4f60\u7684\u673a\u4f1a\u5e76\u51cf\u5c11\u4e86\u4f60\u7684\u5bf9\u624b\u5f62\u6210\u83b7\u80dc\u7ebf\u7684\u53ef\u80fd\u6027\u3002"}, {"question": "\u5982\u4f55\u5728\u4e0e\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u5bf9\u6218\u4e95\u5b57\u68cb\u65f6\u8feb\u4f7f\u5e73\u5c40\uff1f", "answer": "\u4e3a\u4e86\u5728\u4e0e\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u5bf9\u6218\u4e95\u5b57\u68cb\u65f6\u8feb\u4f7f\u5e73\u5c40\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a1) \u5982\u679c\u4f60\u5148\u8d70\uff0c\u59cb\u7ec8\u5360\u636e\u4e2d\u5fc3\u4f4d\u7f6e\u30022) \u5c06\u4f60\u7684\u6807\u8bb0\u653e\u5728\u89d2\u843d\u91cc\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u5c01\u9501\u673a\u4f1a\u30023) \u901a\u8fc7\u5c01\u9501\u5bf9\u624b\u7684\u6f5c\u5728\u83b7\u80dc\u7ebf\u6765\u56de\u5e94\u5bf9\u624b\u7684\u4e3e\u52a8\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4ed6\u4eec\u5c06 'O' \u653e\u7f6e\u5728\u89d2\u843d\u91cc\uff0c\u8bf7\u5728\u76f8\u53cd\u7684\u89d2\u843d\u653e\u7f6e 'X'\u3002\u8fd9\u79cd\u7b56\u7565\u786e\u4fdd\u6ca1\u6709\u73a9\u5bb6\u53ef\u4ee5\u83b7\u80dc\u3002"}, {"question": "\u54ea\u4e9b\u9ad8\u7ea7\u6280\u5de7\u53ef\u4ee5\u4fdd\u8bc1\u5728\u4e95\u5b57\u68cb\u4e2d\u83b7\u80dc\uff1f", "answer": "\u5728\u4e95\u5b57\u68cb\u4e2d\u4fdd\u8bc1\u83b7\u80dc\u7684\u9ad8\u7ea7\u6280\u5de7\u5305\u62ec\uff1a1) \u4ece\u4e2d\u5fc3\u5f00\u59cb\u63a7\u5236\u6e38\u620f\u30022) \u521b\u5efa\u4e00\u4e2a\u201c\u53c9\u5f62\u201d\u2014\u2014\u540c\u65f6\u8bbe\u7f6e\u4e24\u4e2a\u83b7\u80dc\u52a8\u4f5c\u3002\u4f8b\u5982\uff0c\u5c06 'X' \u653e\u7f6e\u5728\u4e24\u4e2a\u89d2\u843d\u8feb\u4f7f\u4f60\u7684\u5bf9\u624b\u5c01\u9501\u4e00\u4e2a\uff0c\u5141\u8bb8\u4f60\u7528\u53e6\u4e00\u4e2a\u83b7\u80dc\u30023) \u59cb\u7ec8\u5c01\u9501\u5bf9\u624b\u7684\u6f5c\u5728\u83b7\u80dc\u52a8\u4f5c\u3002\u8fd9\u4e9b\u6b65\u9aa4\u786e\u4fdd\u4f60\u80fd\u4fdd\u6301\u4e0a\u98ce\u3002"}, {"question": "\u4e95\u5b57\u68cb\u7684\u6e38\u620f\u673a\u5236\u5982\u4f55\u786e\u4fdd\u73a9\u5bb6\u4e4b\u95f4\u516c\u5e73\uff1f", "answer": "\u4e95\u5b57\u68cb\u901a\u8fc7\u5176\u7b80\u5355\u7684\u56de\u5408\u5236\u673a\u5236\u786e\u4fdd\u516c\u5e73\u3002\u4e24\u540d\u73a9\u5bb6\u90fd\u6709\u540c\u7b49\u7684\u653e\u7f6e\u6807\u8bb0\u673a\u4f1a\u3002\u6e38\u620f\u7684\u5bf9\u79f0\u6027\u610f\u5473\u7740\u6ca1\u6709\u73a9\u5bb6\u5177\u6709\u56fa\u6709\u7684\u4f18\u52bf\u3002\u4f8b\u5982\uff0c\u5982\u679c\u73a9\u5bb6 1 \u5360\u636e\u4e2d\u5fc3\uff0c\u73a9\u5bb6 2 \u4ecd\u7136\u53ef\u4ee5\u901a\u8fc7\u9009\u62e9\u4e00\u4e2a\u89d2\u843d\u6709\u6548\u5730\u8fdb\u884c\u5c01\u9501\u3002\u8fd9\u79cd\u5e73\u8861\u4f7f\u6e38\u620f\u516c\u5e73\u5e76\u5177\u6709\u7ade\u4e89\u529b\uff0c\u901a\u5e38\u4f1a\u5bfc\u81f4\u719f\u7ec3\u7684\u73a9\u5bb6\u4e4b\u95f4\u51fa\u73b0\u5e73\u5c40\u3002"}, {"question": "\u4e95\u5b57\u68cb\u4e2d\u83b7\u80dc\u3001\u5931\u8d25\u6216\u5e73\u5c40\u7684\u6570\u503c\u6982\u7387\u662f\u591a\u5c11\uff1f", "answer": "\u5728\u4e95\u5b57\u68cb\u4e2d\uff0c\u6570\u503c\u6982\u7387\u4e3a\uff1a1) \u83b7\u80dc\uff1a\u5982\u679c\u7b2c\u4e00\u4f4d\u73a9\u5bb6\u4ee5\u6700\u4f73\u65b9\u5f0f\u8fdb\u884c\u6e38\u620f\uff0c\u5219\u4e3a ~31%\u30022) \u5931\u8d25\uff1a\u5728\u76f8\u540c\u6761\u4ef6\u4e0b\uff0c\u7b2c\u4e8c\u4f4d\u73a9\u5bb6\u7684\u5931\u8d25\u6982\u7387\u4e3a ~31%\u30023) \u5e73\u5c40\uff1a\u5f53\u53cc\u65b9\u90fd\u4f7f\u7528\u6700\u4f73\u7b56\u7565\u65f6\uff0c\u5e73\u5c40\u7684\u6982\u7387\u7ea6\u4e3a ~38%\u3002\u4f8b\u5982\uff0c\u5982\u679c\u73a9\u5bb6 1 \u4ece\u4e2d\u5fc3\u5f00\u59cb\uff0c\u73a9\u5bb6 2 \u505a\u51fa\u6b63\u786e\u7684\u56de\u5e94\uff0c\u6e38\u620f\u5f88\u53ef\u80fd\u4ee5\u5e73\u5c40\u7ed3\u675f\u3002"}, {"question": "\u5982\u4f55\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u6211\u7684\u4e95\u5b57\u68cb\u8fdb\u5ea6\uff1f", "answer": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u4e95\u5b57\u68cb\u8fdb\u5ea6\u53d6\u51b3\u4e8e\u4f7f\u7528\u7684\u5e94\u7528\u7a0b\u5e8f\u6216\u670d\u52a1\u3002\u67d0\u4e9b\u5e73\u53f0\u63d0\u4f9b\u4e91\u4fdd\u5b58\u529f\u80fd\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4f7f\u7528\u5e26\u6709\u767b\u5f55\u529f\u80fd\u7684\u6e38\u620f\u5e94\u7528\u7a0b\u5e8f\uff0c\u4f60\u7684\u8fdb\u5ea6\u53ef\u80fd\u4f1a\u81ea\u52a8\u540c\u6b65\u3002\u68c0\u67e5\u8bbe\u7f6e\u4ee5\u67e5\u770b\u5bfc\u51fa/\u5bfc\u5165\u9009\u9879\uff0c\u6216\u8054\u7cfb\u652f\u6301\u5bfb\u6c42\u6307\u5bfc\u3002\u786e\u4fdd\u4e24\u4e2a\u5e73\u53f0\u90fd\u652f\u6301\u76f8\u540c\u7248\u672c\u7684\u8be5\u6e38\u620f\u4ee5\u786e\u4fdd\u517c\u5bb9\u6027\u3002"}, {"question": "\u4e95\u5b57\u68cb\u4e2d\u53ef\u4ee5\u627e\u5230\u54ea\u4e9b\u9690\u85cf\u7684\u6a21\u5f0f\u6216\u5f69\u86cb\uff1f", "answer": "\u4e95\u5b57\u68cb\u4e2d\u6709\u4e00\u4e9b\u9690\u85cf\u7684\u6a21\u5f0f\uff0c\u4f8b\u5982\u201c\u5e7b\u65b9\u201d\uff0c\u5176\u4e2d\u6570\u5b57 1-9 \u7684\u6392\u5217\u65b9\u5f0f\u4f7f\u5f97\u6bcf\u4e00\u884c\u3001\u6bcf\u4e00\u5217\u548c\u6bcf\u4e00\u6761\u5bf9\u89d2\u7ebf\u4e4b\u548c\u90fd\u4e3a 15\u3002\u4f8b\u5982\uff0c\u5c06 'X' \u653e\u7f6e\u5728 5\uff08\u4e2d\u5fc3\uff09\u548c 'O' \u653e\u7f6e\u5728 2 \u4e0a\u4f1a\u521b\u5efa\u4e00\u4e2a\u6218\u7565\u6027\u8bbe\u7f6e\u3002\u67d0\u4e9b\u6570\u5b57\u7248\u672c\u4e2d\u5305\u542b\u5f69\u86cb\uff0c\u4f8b\u5982\u4e3b\u9898\u68cb\u76d8\u6216\u83b7\u80dc\u65f6\u51fa\u73b0\u7684\u52a8\u753b\u3002\u63a2\u7d22\u8fd9\u4e9b\u5f69\u86cb\u53ef\u4ee5\u4e3a\u7ecf\u5178\u6e38\u620f\u589e\u6dfb\u8da3\u5473\u3002"}]
[{"question": "\u5982\u4f55\u8b93\u5b8c\u5168\u6c92\u6709\u7d93\u9a57\u7684\u65b0\u624b\u958b\u59cb\u73a9\u4e95\u5b57\u904a\u6232\uff1f", "answer": "\u8981\u958b\u59cb\u73a9\u4e95\u5b57\u904a\u6232\uff0c\u4f60\u9700\u8981\u4e00\u500b 3x3 \u7684\u683c\u5b50\u548c\u5169\u4f4d\u73a9\u5bb6\u3002\u4e00\u4f4d\u73a9\u5bb6\u4f7f\u7528\u300eX\u300f\uff0c\u53e6\u4e00\u4f4d\u73a9\u5bb6\u4f7f\u7528\u300eO\u300f\u3002\u73a9\u5bb6\u8f2a\u6d41\u5728\u683c\u5b50\u4e0a\u6a19\u8a18\u3002\u4f8b\u5982\uff0c\u73a9\u5bb6 1 \u5c07\u300eX\u300f\u653e\u5728\u4e2d\u9593\u3002\u73a9\u5bb6 2 \u4e4b\u5f8c\u5c07\u300eO\u300f\u653e\u5728\u89d2\u843d\u3002\u76ee\u6a19\u662f\u5728\u6c34\u5e73\u3001\u5782\u76f4\u6216\u5c0d\u89d2\u7dda\u4e0a\u7372\u5f97\u4e09\u679a\u76f8\u540c\u7684\u8a18\u865f\u3002\u5982\u679c\u6240\u6709\u7a7a\u683c\u90fd\u586b\u6eff\uff0c\u6c92\u6709\u8d0f\u5bb6\uff0c\u5247\u904a\u6232\u5e73\u624b\u3002"}, {"question": "\u6bcf\u500b\u73a9\u5bb6\u90fd\u61c9\u8a72\u77e5\u9053\u4e95\u5b57\u904a\u6232\u7684\u57fa\u672c\u898f\u5247\u662f\u4ec0\u9ebc\uff1f", "answer": "\u4e95\u5b57\u904a\u6232\u7684\u57fa\u672c\u898f\u5247\u5f88\u7c21\u55ae\uff1a1) \u4f7f\u7528 3x3 \u7684\u683c\u7db2\u30022) \u5169\u4f4d\u73a9\u5bb6\u8f2a\u6d41\u653e\u7f6e\u300eX\u300f\u548c\u300eO\u300f\u30023) \u9996\u5148\u5728\u6c34\u5e73\u3001\u5782\u76f4\u6216\u5c0d\u89d2\u7dda\u4e0a\u6392\u5217\u4e09\u679a\u76f8\u540c\u8a18\u865f\u7684\u73a9\u5bb6\u7372\u52dd\u30024) \u5982\u679c\u6240\u6709\u4e5d\u500b\u683c\u5b50\u90fd\u586b\u6eff\u800c\u6c92\u6709\u8d0f\u5bb6\uff0c\u5247\u5e73\u5c40\u3002\u4f8b\u5982\uff0c\u5982\u679c\u73a9\u5bb6 1 \u5c07\u300eX\u300f\u653e\u5728\u5de6\u4e0a\u89d2\uff0c\u73a9\u5bb6 2 \u53ef\u80fd\u6703\u5c07\u300eO\u300f\u653e\u5728\u4e2d\u9593\u4ee5\u963b\u64cb\u3002"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u53ef\u4ee5\u5e6b\u52a9\u6211\u5728\u4e95\u5b57\u904a\u6232\u4e2d\u907f\u514d\u8f38\u6389\uff1f", "answer": "\u70ba\u4e86\u907f\u514d\u5728\u4e95\u5b57\u904a\u6232\u4e2d\u8f38\u6389\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u7b56\u7565\uff1a1) \u5982\u679c\u53ef\u7528\uff0c\u59cb\u7d42\u4f54\u9818\u4e2d\u5fc3\u4f4d\u7f6e\u2014\u5b83\u63d0\u4f9b\u4e86\u6700\u5927\u7684\u7372\u52dd\u6a5f\u6703\u30022) \u963b\u64cb\u5c0d\u624b\u7684\u6f5b\u5728\u7372\u52dd\u52d5\u4f5c\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4ed6\u5011\u5728\u540c\u4e00\u884c\u6709\u5169\u500b\u300eO\u300f\uff0c\u8acb\u653e\u7f6e\u60a8\u7684\u300eX\u300f\u4ee5\u963b\u64cb\u30023) \u540c\u6642\u5efa\u7acb\u591a\u500b\u7372\u52dd\u8def\u5f91\u3002\u9019\u8feb\u4f7f\u4f60\u7684\u5c0d\u624b\u9632\u5b88\uff0c\u589e\u52a0\u4f60\u7684\u7372\u52dd\u6a5f\u7387\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u4e95\u5b57\u904a\u6232\u4e2d\u7684\u4e2d\u5fc3\u65b9\u683c\u88ab\u8a8d\u70ba\u662f\u6700\u5177\u7b56\u7565\u6027\u7684\uff1f", "answer": "\u4e95\u5b57\u904a\u6232\u4e2d\u7684\u4e2d\u5fc3\u65b9\u683c\u662f\u6700\u5177\u7b56\u7565\u6027\u7684\uff0c\u56e0\u70ba\u5b83\u5c6c\u65bc\u56db\u689d\u6f5b\u5728\u7372\u52dd\u7dda\uff08\u6c34\u5e73\u3001\u5782\u76f4\u548c\u5169\u500b\u5c0d\u89d2\u7dda\uff09\u7684\u4e00\u90e8\u5206\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5c07\u60a8\u7684\u300eX\u300f\u653e\u5728\u4e2d\u5fc3\uff0c\u60a8\u53ef\u4ee5\u901a\u904e\u5728\u4efb\u4f55\u65b9\u5411\u6392\u5217\u8a18\u865f\u4f86\u7372\u52dd\u3002\u9019\u500b\u4e2d\u5fc3\u4f4d\u7f6e\u6700\u5927\u5316\u4e86\u60a8\u7684\u6a5f\u6703\uff0c\u4e26\u9650\u5236\u4e86\u5c0d\u624b\u5f62\u6210\u7372\u52dd\u7dda\u7684\u6a5f\u6703\u3002"}, {"question": "\u5982\u4f55\u8feb\u4f7f\u8207\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u5728\u4e95\u5b57\u904a\u6232\u4e2d\u6253\u6210\u5e73\u624b\uff1f", "answer": "\u70ba\u4e86\u5728\u5c0d\u6297\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u7684\u4e95\u5b57\u904a\u6232\u4e2d\u8feb\u4f7f\u5e73\u5c40\uff0c\u8acb\u9075\u5faa\u9019\u4e9b\u6b65\u9a5f\uff1a1) \u5982\u679c\u60a8\u5148\u8d70\uff0c\u59cb\u7d42\u4f54\u9818\u4e2d\u5fc3\u30022) \u5c07\u60a8\u7684\u8a18\u865f\u653e\u5728\u89d2\u843d\uff0c\u4ee5\u6700\u5927\u5316\u963b\u64cb\u6a5f\u6703\u30023) \u56de\u61c9\u5c0d\u624b\u7684\u52d5\u4f5c\uff0c\u963b\u64cb\u4ed6\u5011\u6f5b\u5728\u7684\u7372\u52dd\u7dda\u8def\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4ed6\u5011\u5c07\u300eO\u300f\u653e\u5728\u4e00\u500b\u89d2\u843d\uff0c\u5247\u5c07\u300eX\u300f\u653e\u5728\u5c0d\u89d2\u7684\u89d2\u843d\u3002\u6b64\u7b56\u7565\u78ba\u4fdd\u6c92\u6709\u4efb\u4f55\u73a9\u5bb6\u53ef\u4ee5\u7372\u52dd\u3002"}, {"question": "\u54ea\u4e9b\u5148\u9032\u6280\u8853\u53ef\u4ee5\u4fdd\u8b49\u5728\u4e95\u5b57\u904a\u6232\u4e2d\u7372\u52dd\uff1f", "answer": "\u5728\u4e95\u5b57\u904a\u6232\u4e2d\u4fdd\u8b49\u7372\u52dd\u7684\u5148\u9032\u6280\u8853\u5305\u62ec\uff1a1) \u5f9e\u4e2d\u5fc3\u958b\u59cb\u63a7\u5236\u904a\u6232\u30022) \u5efa\u7acb\u300c\u5206\u53c9\u300d\u2014\u540c\u6642\u8a2d\u5b9a\u5169\u500b\u7372\u52dd\u52d5\u4f5c\u3002\u4f8b\u5982\uff0c\u5c07\u300eX\u300f\u653e\u5728\u5169\u500b\u89d2\u843d\uff0c\u8feb\u4f7f\u5c0d\u624b\u963b\u6b62\u4e00\u500b\uff0c\u8b93\u60a8\u901a\u904e\u53e6\u4e00\u500b\u89d2\u843d\u7372\u52dd\u30023) \u59cb\u7d42\u963b\u64cb\u5c0d\u624b\u7684\u6f5b\u5728\u7372\u52dd\u52d5\u4f5c\u3002\u9019\u4e9b\u6b65\u9a5f\u78ba\u4fdd\u60a8\u4fdd\u6301\u512a\u52e2\u3002"}, {"question": "\u4e95\u5b57\u904a\u6232\u7684\u904a\u6232\u6a5f\u5236\u5982\u4f55\u78ba\u4fdd\u73a9\u5bb6\u4e4b\u9593\u7684\u516c\u5e73\u6027\uff1f", "answer": "\u4e95\u5b57\u904a\u6232\u901a\u904e\u5176\u7c21\u55ae\u7684\u8f2a\u6d41\u6a5f\u5236\u4f86\u78ba\u4fdd\u516c\u5e73\u6027\u3002\u5169\u4f4d\u73a9\u5bb6\u90fd\u6709\u540c\u7b49\u6a5f\u6703\u653e\u7f6e\u4ed6\u5011\u7684\u8a18\u865f\u3002\u904a\u6232\u7684\u5c0d\u7a31\u6027\u610f\u5473\u8457\u6c92\u6709\u4efb\u4f55\u73a9\u5bb6\u5177\u6709\u56fa\u6709\u7684\u512a\u52e2\u3002\u4f8b\u5982\uff0c\u5982\u679c\u73a9\u5bb6 1 \u4f54\u64da\u4e2d\u5fc3\uff0c\u73a9\u5bb6 2 \u4ecd\u7136\u53ef\u4ee5\u901a\u904e\u9078\u64c7\u89d2\u843d\u4f86\u6709\u6548\u963b\u64cb\u3002\u9019\u7a2e\u5e73\u8861\u4f7f\u5f97\u904a\u6232\u516c\u5e73\u4e14\u5177\u6709\u7af6\u722d\u529b\uff0c\u9019\u7d93\u5e38\u5c0e\u81f4\u719f\u7df4\u73a9\u5bb6\u4e4b\u9593\u7684\u5e73\u5c40\u3002"}, {"question": "\u5728\u4e95\u5b57\u904a\u6232\u4e2d\u7372\u52dd\u3001\u5931\u6557\u6216\u5e73\u5c40\u7684\u6578\u503c\u6a5f\u7387\u662f\u591a\u5c11\uff1f", "answer": "\u5728\u4e95\u5b57\u904a\u6232\u4e2d\uff0c\u6578\u503c\u6a5f\u7387\u70ba\uff1a1) \u7372\u52dd\uff1a\u5982\u679c\u7b2c\u4e00\u4f4d\u73a9\u5bb6\u6700\u4f73\u5316\u4ed6\u5011\u7684\u7b56\u7565\uff0c\u5247\u7d04\u70ba 31%\u30022) \u5931\u6557\uff1a\u5728\u76f8\u540c\u689d\u4ef6\u4e0b\uff0c\u7b2c\u4e8c\u4f4d\u73a9\u5bb6\u7d04\u70ba 31%\u30023) \u5e73\u5c40\uff1a\u7576\u5169\u4f4d\u73a9\u5bb6\u90fd\u4f7f\u7528\u6700\u4f73\u7b56\u7565\u6642\uff0c\u7d04\u70ba 38%\u3002\u4f8b\u5982\uff0c\u5982\u679c\u73a9\u5bb6 1 \u5f9e\u4e2d\u9593\u958b\u59cb\uff0c\u800c\u73a9\u5bb6 2 \u6b63\u78ba\u56de\u61c9\uff0c\u904a\u6232\u5f88\u53ef\u80fd\u4ee5\u5e73\u5c40\u7d50\u675f\u3002"}, {"question": "\u5982\u4f55\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e4b\u9593\u8f49\u79fb\u6211\u7684\u4e95\u5b57\u904a\u6232\u9032\u5ea6\uff1f", "answer": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u9593\u8f49\u79fb\u4e95\u5b57\u904a\u6232\u9032\u5ea6\u53d6\u6c7a\u65bc\u6240\u4f7f\u7528\u7684\u61c9\u7528\u7a0b\u5f0f\u6216\u670d\u52d9\u3002\u4e00\u4e9b\u5e73\u53f0\u63d0\u4f9b\u96f2\u7aef\u5132\u5b58\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u4f7f\u7528\u5177\u6709\u767b\u5165\u529f\u80fd\u7684\u904a\u6232\u61c9\u7528\u7a0b\u5f0f\uff0c\u60a8\u7684\u9032\u5ea6\u53ef\u80fd\u6703\u81ea\u52d5\u540c\u6b65\u3002\u6aa2\u67e5\u8a2d\u5b9a\u4ee5\u67e5\u770b\u532f\u51fa/\u532f\u5165\u9078\u9805\uff0c\u6216\u806f\u7e6b\u652f\u63f4\u4ee5\u7372\u5f97\u6307\u5c0e\u3002\u78ba\u4fdd\u5169\u500b\u5e73\u53f0\u90fd\u652f\u63f4\u76f8\u540c\u7248\u672c\u7684\u904a\u6232\u4ee5\u78ba\u4fdd\u76f8\u5bb9\u6027\u3002"}, {"question": "\u5728\u4e95\u5b57\u904a\u6232\u4e2d\uff0c\u53ef\u4ee5\u627e\u5230\u54ea\u4e9b\u96b1\u85cf\u7684\u6a21\u5f0f\u6216\u5f69\u86cb\uff1f", "answer": "\u4e95\u5b57\u904a\u6232\u6709\u4e00\u4e9b\u96b1\u85cf\u7684\u6a21\u5f0f\uff0c\u4f8b\u5982\u300e\u5e7b\u65b9\u300f\uff0c\u5176\u4e2d\u6578\u5b57 1-9 \u4ee5\u67d0\u7a2e\u65b9\u5f0f\u6392\u5217\uff0c\u4f7f\u5f97\u6bcf\u4e00\u884c\u3001\u6bcf\u4e00\u5217\u548c\u5c0d\u89d2\u7dda\u7684\u7e3d\u548c\u90fd\u662f 15\u3002\u4f8b\u5982\uff0c\u5c07\u300eX\u300f\u653e\u5728 5 \uff08\u4e2d\u5fc3\uff09\u548c\u300eO\u300f\u653e\u5728 2 \u5275\u9020\u4e86\u4e00\u500b\u5177\u6709\u7b56\u7565\u6027\u7684\u8a2d\u7f6e\u3002\u67d0\u4e9b\u6578\u4f4d\u7248\u672c\u5305\u542b\u5f69\u86cb\uff0c\u4f8b\u5982\u4e3b\u984c\u683c\u6216\u5728\u60a8\u7372\u52dd\u6642\u986f\u793a\u52d5\u756b\u3002\u63a2\u7d22\u9019\u4e9b\u5f69\u86cb\u53ef\u4ee5\u70ba\u7d93\u5178\u904a\u6232\u589e\u6dfb\u8da3\u5473\u3002"}]
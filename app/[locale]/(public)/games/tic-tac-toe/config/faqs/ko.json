[{"question": "\ucd08\ubcf4\uc790\ub97c \uc704\ud55c \ud2f1\ud0dd\ud1a0 \uac8c\uc784 \uc2dc\uc791 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud2f1\ud0dd\ud1a0 \uac8c\uc784\uc744 \uc2dc\uc791\ud558\ub824\uba74 3x3 \uaca9\uc790\ud310\uacfc \ub450 \uba85\uc758 \ud50c\ub808\uc774\uc5b4\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ud55c \ud50c\ub808\uc774\uc5b4\ub294 'X'\ub97c, \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub294 'O'\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\ub294 \uaca9\uc790\ud310\uc758 \uce78\uc5d0 \ubc88\uac08\uc544 \ud45c\uc2dc\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 1\ubc88 \ud50c\ub808\uc774\uc5b4\uac00 \uc911\uc559\uc5d0 'X'\ub97c \ub193\uc73c\uba74, 2\ubc88 \ud50c\ub808\uc774\uc5b4\ub294 \ubaa8\uc11c\ub9ac\uc5d0 'O'\ub97c \ub193\uc2b5\ub2c8\ub2e4. \ubaa9\ud45c\ub294 \uac00\ub85c, \uc138\ub85c \ub610\ub294 \ub300\uac01\uc120\uc73c\ub85c \uc790\uc2e0\uc758 \ud45c\uc2dc\ub97c \uc138 \uac1c \uc77c\ub82c\ub85c \ub9cc\ub4dc\ub294 \uac83\uc785\ub2c8\ub2e4. \ubaa8\ub4e0 \uce78\uc774 \ucc44\uc6cc\uc84c\uc9c0\ub9cc \uc2b9\uc790\uac00 \uc5c6\ub2e4\uba74 \ube44\uae40\uc785\ub2c8\ub2e4."}, {"question": "\ubaa8\ub4e0 \ud50c\ub808\uc774\uc5b4\uac00 \uc54c\uc544\uc57c \ud560 \ud2f1\ud0dd\ud1a0 \uae30\ubcf8 \uaddc\uce59\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud2f1\ud0dd\ud1a0\uc758 \uae30\ubcf8 \uaddc\uce59\uc740 \uac04\ub2e8\ud569\ub2c8\ub2e4. 1) 3x3 \uaca9\uc790\ud310\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. 2) \ub450 \ud50c\ub808\uc774\uc5b4\ub294 \ubc88\uac08\uc544 'X'\uc640 'O'\ub97c \ub193\uc2b5\ub2c8\ub2e4. 3) \uac00\ub85c, \uc138\ub85c \ub610\ub294 \ub300\uac01\uc120\uc73c\ub85c \uc138 \uac1c\uc758 \ud45c\uc2dc\ub97c \uc77c\ub82c\ub85c \ub9cc\ub4e0 \uccab \ubc88\uc9f8 \ud50c\ub808\uc774\uc5b4\uac00 \uc2b9\ub9ac\ud569\ub2c8\ub2e4. 4) \ubaa8\ub4e0 9\uac1c\uc758 \uce78\uc774 \uc2b9\uc790\uac00 \uc5c6\uc774 \ucc44\uc6cc\uc9c0\uba74 \ube44\uae40\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 1\ubc88 \ud50c\ub808\uc774\uc5b4\uac00 \uc67c\ucabd \uc704\uc5d0 'X'\ub97c \ub193\uc73c\uba74 2\ubc88 \ud50c\ub808\uc774\uc5b4\ub294 \uc911\uc559\uc5d0 'O'\ub97c \ub193\uc544 \ub9c9\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud2f1\ud0dd\ud1a0\uc5d0\uc11c \ud328\ubc30\ub97c \ud53c\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ub294 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud2f1\ud0dd\ud1a0\uc5d0\uc11c \ud328\ubc30\ub97c \ud53c\ud558\ub824\uba74 \ub2e4\uc74c \uc804\ub7b5\uc744 \ub530\ub974\uc138\uc694. 1) \uac00\ub2a5\ud558\uba74 \ud56d\uc0c1 \uc911\uc559\uc744 \ucc28\uc9c0\ud558\uc138\uc694. \uac00\uc7a5 \ub9ce\uc740 \uc2b9\ub9ac \uae30\ud68c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. 2) \uc0c1\ub300\ubc29\uc758 \uac00\ub2a5\ud55c \uc2b9\ub9ac \ud328\ud134\uc744 \ucc28\ub2e8\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc0c1\ub300\ubc29\uc774 \ub450 \uac1c\uc758 'O'\ub97c \uc77c\ub82c\ub85c \ubc30\uce58\ud588\ub2e4\uba74 \uc790\uc2e0\uc758 'X'\ub97c \ub193\uc544 \ub9c9\uc73c\uc138\uc694. 3) \ub3d9\uc2dc\uc5d0 \uc5ec\ub7ec \uc2b9\ub9ac \uacbd\ub85c\ub97c \ub9cc\ub4e4\uc138\uc694. \uc774\ub807\uac8c \ud558\uba74 \uc0c1\ub300\ubc29\uc740 \ubc29\uc5b4\uc5d0 \uc9d1\uc911\ud574\uc57c \ud558\ubbc0\ub85c \uc2b9\ub9ac \ud655\ub960\uc774 \ub192\uc544\uc9d1\ub2c8\ub2e4."}, {"question": "\ud2f1\ud0dd\ud1a0\uc5d0\uc11c \uc911\uc559 \uce78\uc774 \uac00\uc7a5 \uc804\ub7b5\uc801\uc778 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud2f1\ud0dd\ud1a0\uc5d0\uc11c \uc911\uc559 \uce78\uc774 \uac00\uc7a5 \uc804\ub7b5\uc801\uc778 \uc774\uc720\ub294 \ub124 \uac1c\uc758 \uc7a0\uc7ac\uc801\uc778 \uc2b9\ub9ac \ub77c\uc778(\uac00\ub85c, \uc138\ub85c, \uadf8\ub9ac\uace0 \ub450 \uac1c\uc758 \ub300\uac01\uc120)\uc5d0 \ud3ec\ud568\ub418\uc5b4 \uc788\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 \uc911\uc559\uc5d0 'X'\ub97c \ub193\uc73c\uba74 \uc5b4\ub5a4 \ubc29\ud5a5\uc73c\ub85c\ub4e0 \ud45c\uc2dc\ub97c \uc77c\ub82c\ub85c \ub9de\ucdb0 \uc2b9\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc911\uc559 \uc704\uce58\ub294 \uae30\ud68c\ub97c \uadf9\ub300\ud654\ud558\uace0 \uc0c1\ub300\ubc29\uc774 \uc2b9\ub9ac \ub77c\uc778\uc744 \ud615\uc131\ud560 \uac00\ub2a5\uc131\uc744 \uc81c\ud55c\ud569\ub2c8\ub2e4."}, {"question": "\uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\uc640 \ub300\uacb0\ud558\uc5ec \ud2f1\ud0dd\ud1a0\uc5d0\uc11c \ube44\uae40\uc744 \uac15\uc694\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\uc640 \ub300\uacb0\ud558\uc5ec \ud2f1\ud0dd\ud1a0\uc5d0\uc11c \ube44\uae40\uc744 \uac15\uc694\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. 1) \uc2dc\uc791\ud560 \ub54c \ud56d\uc0c1 \uc911\uc559\uc744 \ucc28\uc9c0\ud558\uc138\uc694. 2) \ub9c9\uc744 \uae30\ud68c\ub97c \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \ubaa8\uc11c\ub9ac\ub97c \ud45c\uc2dc\ud558\uc138\uc694. 3) \uc0c1\ub300\ubc29\uc758 \uc6c0\uc9c1\uc784\uc5d0 \ubc18\uc751\ud558\uc5ec \uc0c1\ub300\ubc29\uc758 \uc7a0\uc7ac\uc801\uc778 \uc2b9\ub9ac \ub77c\uc778\uc744 \ucc28\ub2e8\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc0c1\ub300\ubc29\uc774 \ubaa8\uc11c\ub9ac\uc5d0 'O'\ub97c \ub193\uc73c\uba74 \ubc18\ub300\ucabd \ubaa8\uc11c\ub9ac\uc5d0 'X'\ub97c \ub193\uc73c\uc138\uc694. \uc774 \uc804\ub7b5\uc740 \uc5b4\ub290 \ud50c\ub808\uc774\uc5b4\ub3c4 \uc2b9\ub9ac\ud560 \uc218 \uc5c6\ub3c4\ub85d \ud569\ub2c8\ub2e4."}, {"question": "\ud2f1\ud0dd\ud1a0\uc5d0\uc11c \uc2b9\ub9ac\ub97c \ubcf4\uc7a5\ud558\ub294 \uace0\uae09 \uae30\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud2f1\ud0dd\ud1a0\uc5d0\uc11c \uc2b9\ub9ac\ub97c \ubcf4\uc7a5\ud558\ub294 \uace0\uae09 \uae30\ubc95\uc5d0\ub294 \ub2e4\uc74c\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. 1) \uac8c\uc784\uc744 \uc81c\uc5b4\ud558\uae30 \uc704\ud574 \uc911\uc559\uc5d0\uc11c \uc2dc\uc791\ud569\ub2c8\ub2e4. 2) \"\ud3ec\ud06c\"\ub97c \ub9cc\ub4ed\ub2c8\ub2e4. \uc989, \ub3d9\uc2dc\uc5d0 \ub450 \uac1c\uc758 \uc2b9\ub9ac \uc6c0\uc9c1\uc784\uc744 \uc124\uc815\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub450 \ubaa8\uc11c\ub9ac\uc5d0 'X'\ub97c \ub193\uc73c\uba74 \uc0c1\ub300\ubc29\uc740 \ud558\ub098\ub97c \ub9c9\uc544\uc57c \ud558\uace0 \ub2e4\ub978 \ud558\ub098\ub294 \uc2b9\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 3) \ud56d\uc0c1 \uc0c1\ub300\ubc29\uc758 \uc7a0\uc7ac\uc801\uc778 \uc2b9\ub9ac \uc6c0\uc9c1\uc784\uc744 \ub9c9\uc73c\uc138\uc694. \uc774\ub7ec\ud55c \ub2e8\uacc4\ub97c \ud1b5\ud574 \uc6b0\uc704\ub97c \uc720\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud2f1\ud0dd\ud1a0 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc774 \ud50c\ub808\uc774\uc5b4 \uac04\uc758 \uacf5\uc815\uc131\uc744 \uc5b4\ub5bb\uac8c \ubcf4\uc7a5\ud558\ub098\uc694?", "answer": "\ud2f1\ud0dd\ud1a0\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uc790\uc2e0\uc758 \ud45c\uc2dc\ub97c \ub193\uc744 \uc218 \uc788\ub294 \ub3d9\uc77c\ud55c \uae30\ud68c\ub97c \uc81c\uacf5\ud558\ub294 \uac04\ub2e8\ud558\uba70 \ud134 \uae30\ubc18 \uba54\ucee4\ub2c8\uc998\uc744 \ud1b5\ud574 \uacf5\uc815\uc131\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4. \uac8c\uc784\uc758 \ub300\uce6d\uc131\uc740 \uc5b4\ub290 \ud50c\ub808\uc774\uc5b4\ub3c4 \uace0\uc720\ud55c \uc774\uc810\uc744 \uac00\uc9c0\uace0 \uc788\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 1\ubc88 \ud50c\ub808\uc774\uc5b4\uac00 \uc911\uc559\uc744 \ucc28\uc9c0\ud574\ub3c4 2\ubc88 \ud50c\ub808\uc774\uc5b4\ub294 \uc5ec\uc804\ud788 \ubaa8\uc11c\ub9ac\ub97c \uc120\ud0dd\ud558\uc5ec \ud6a8\uacfc\uc801\uc73c\ub85c \ub9c9\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uade0\ud615\uc740 \uac8c\uc784\uc744 \uacf5\uc815\ud558\uace0 \uacbd\uc7c1\uc801\uc774\uba70, \uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4 \uc0ac\uc774\uc5d0\uc11c \uc885\uc885 \ube44\uae40\uc73c\ub85c \uc774\uc5b4\uc9d1\ub2c8\ub2e4."}, {"question": "\ud2f1\ud0dd\ud1a0\uc5d0\uc11c \uc2b9\ub9ac, \ud328\ubc30 \ub610\ub294 \ube44\uae40\uc758 \uc218\uce58\uc801 \ud655\ub960\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud2f1\ud0dd\ud1a0\uc5d0\uc11c \uc218\uce58\uc801 \ud655\ub960\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. 1) \uc2b9\ub9ac: \ucd5c\uc801\uc758 \ud50c\ub808\uc774\ub97c \ud560 \uacbd\uc6b0 \uccab \ubc88\uc9f8 \ud50c\ub808\uc774\uc5b4\uc758 \uc2b9\ub9ac \ud655\ub960\uc740 \uc57d 31%\uc785\ub2c8\ub2e4. 2) \ud328\ubc30: \ub3d9\uc77c\ud55c \uc870\uac74\uc5d0\uc11c \ub450 \ubc88\uc9f8 \ud50c\ub808\uc774\uc5b4\uc758 \ud328\ubc30 \ud655\ub960\uc740 \uc57d 31%\uc785\ub2c8\ub2e4. 3) \ube44\uae40: \ub450 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub450 \ucd5c\uc801\uc758 \uc804\ub7b5\uc744 \uc0ac\uc6a9\ud560 \uacbd\uc6b0 \ube44\uae40 \ud655\ub960\uc740 \uc57d 38%\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 1\ubc88 \ud50c\ub808\uc774\uc5b4\uac00 \uc911\uc559\uc5d0\uc11c \uc2dc\uc791\ud558\uace0 2\ubc88 \ud50c\ub808\uc774\uc5b4\uac00 \uc62c\ubc14\ub974\uac8c \ubc18\uc751\ud558\uba74 \uac8c\uc784\uc740 \ube44\uae40\uc73c\ub85c \ub05d\ub0a0 \uac00\ub2a5\uc131\uc774 \ub192\uc2b5\ub2c8\ub2e4."}, {"question": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \ud2f1\ud0dd\ud1a0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \ud2f1\ud0dd\ud1a0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub294 \ubc29\ubc95\uc740 \uc0ac\uc6a9\ud558\ub294 \uc571 \ub610\ub294 \uc11c\ube44\uc2a4\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4. \uc77c\ubd80 \ud50c\ub7ab\ud3fc\uc740 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub85c\uadf8\uc778 \uae30\ub2a5\uc774 \uc788\ub294 \uac8c\uc784 \uc571\uc744 \uc0ac\uc6a9\ud558\ub294 \uacbd\uc6b0, \uc9c4\ud589 \uc0c1\ud669\uc774 \uc790\ub3d9\uc73c\ub85c \ub3d9\uae30\ud654\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud638\ud658\uc131\uc744 \uc704\ud574 \ub450 \ud50c\ub7ab\ud3fc \ubaa8\ub450 \ub3d9\uc77c\ud55c \uac8c\uc784 \ubc84\uc804\uc744 \uc9c0\uc6d0\ud558\ub294\uc9c0 \ud655\uc778\ud558\uace0, \ub0b4\ubcf4\ub0b4\uae30/\uac00\uc838\uc624\uae30 \uc635\uc158\uc744 \ud655\uc778\ud558\uac70\ub098 \uc9c0\uc6d0\ud300\uc5d0 \ubb38\uc758\ud558\uc138\uc694."}, {"question": "\ud2f1\ud0dd\ud1a0\uc5d0\uc11c \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ud328\ud134\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud2f1\ud0dd\ud1a0\uc5d0\ub294 \uac01 \ud589, \uc5f4 \ubc0f \ub300\uac01\uc120\uc758 \ud569\uc774 15\uac00 \ub418\ub3c4\ub85d \uc22b\uc790 1-9\uac00 \ubc30\uc5f4\ub41c \"\ub9c8\ubc95\uc758 \uc815\uc0ac\uac01\ud615\"\uacfc \uac19\uc740 \uc228\uaca8\uc9c4 \ud328\ud134\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'X'\ub97c \uc911\uc559(5)\uc5d0 \ub193\uace0 'O'\ub97c 2\uc5d0 \ub193\uc73c\uba74 \uc804\ub7b5\uc801\uc778 \uc124\uc815\uc774 \uc0dd\uc131\ub429\ub2c8\ub2e4. \uc77c\ubd80 \ub514\uc9c0\ud138 \ubc84\uc804\uc5d0\ub294 \uc2b9\ub9ac\ud560 \ub54c \ud14c\ub9c8\uac00 \uc788\ub294 \uaca9\uc790\ub098 \uc560\ub2c8\uba54\uc774\uc158\uacfc \uac19\uc740 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc694\uc18c\ub97c \ud0d0\uc0c9\ud558\uba74 \ud074\ub798\uc2dd \uac8c\uc784\uc5d0 \uc7ac\ubbf8\uc788\ub294 \ubcc0\ud654\ub97c \ub354\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
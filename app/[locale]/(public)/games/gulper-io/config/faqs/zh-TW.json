[{"question": "\u5982\u4f55\u63a7\u5236\u6211\u7684\u89d2\u8272\u5728\u65b0\u624b\u968e\u6bb5\u7684 Gulper.io \u904a\u6232\u4e2d\uff1f", "answer": "\u5728 Gulper.io \u4e2d\uff0c\u60a8\u53ef\u4ee5\u4f7f\u7528 WASD \u9375\u79fb\u52d5\u89d2\u8272\uff0c\u4f7f\u7528\u6ed1\u9f20\u7784\u6e96\u548c\u5c04\u64ca\u3002\u4f8b\u5982\uff0c\u8981\u5411\u524d\u79fb\u52d5\uff0c\u8acb\u6309\u4e0b\u300eW\u300f\u9375\uff1b\u8981\u5411\u5de6\u8f49\uff0c\u8acb\u6309\u4e0b\u300eA\u300f\u9375\u3002\u5728\u6559\u5b78\u6a21\u5f0f\u4e2d\u7df4\u7fd2\u9019\u4e9b\u63a7\u5236\uff0c\u4ee5\u4fbf\u719f\u6089\u64cd\u4f5c\u3002\u6b64\u5916\uff0c\u60a8\u53ef\u4ee5\u5728\u8a2d\u5b9a\u4e2d\u8abf\u6574\u6ed1\u9f20\u9748\u654f\u5ea6\uff0c\u4ee5\u7b26\u5408\u60a8\u7684\u904a\u6232\u98a8\u683c\u3002"}, {"question": "\u5728 Gulper.io \u4e2d\u6536\u96c6\u5967\u723e\u5e03\u70ba\u4f55\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u627e\u5230\u5b83\u5011\uff1f", "answer": "\u5728 Gulper.io \u4e2d\u6536\u96c6\u5967\u723e\u5e03\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u5011\u6703\u589e\u52a0\u60a8\u7684\u9ad4\u7a4d\u548c\u529b\u91cf\uff0c\u8b93\u60a8\u66f4\u5177\u7af6\u722d\u529b\u3002\u5967\u723e\u5e03\u6563\u4f48\u5728\u6574\u500b\u5730\u5716\u4e0a\uff0c\u60a8\u53ef\u4ee5\u901a\u904e\u63a2\u7d22\u4e0d\u540c\u5340\u57df\u627e\u5230\u5b83\u5011\u3002\u4f8b\u5982\uff0c\u5967\u723e\u5e03\u901a\u5e38\u51fa\u73fe\u5728\u5730\u5716\u4e2d\u5fc3\u6216\u504f\u50fb\u7684\u89d2\u843d\u3002\u5b9a\u671f\u6aa2\u67e5\u9019\u4e9b\u4f4d\u7f6e\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u6536\u96c6\u5967\u723e\u5e03\u3002"}, {"question": "\u5728 Gulper.io \u4e2d\u751f\u5b58\u66f4\u9577\u6642\u9593\u7684\u57fa\u672c\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u8981\u5728 Gulper.io \u4e2d\u751f\u5b58\u66f4\u9577\u6642\u9593\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f\u4e00 - \u907f\u514d\u8207\u8f03\u5927\u7684\u73a9\u5bb6\u63a5\u89f8\uff0c\u4fdd\u6301\u5728\u4eba\u5c11\u7684\u5730\u5340\u3002\u6b65\u9a5f\u4e8c - \u6536\u96c6\u5967\u723e\u5e03\u4ee5\u589e\u52a0\u60a8\u7684\u9ad4\u7a4d\u548c\u529b\u91cf\u3002\u6b65\u9a5f\u4e09 - \u5229\u7528\u74b0\u5883\u96b1\u85cf\u4e26\u4f0f\u64ca\u8f03\u5c0f\u7684\u73a9\u5bb6\u3002\u4f8b\u5982\uff0c\u5229\u7528\u5ca9\u77f3\u548c\u7246\u58c1\u4f5c\u70ba\u63a9\u9ad4\uff0c\u8eb2\u907f\u8f03\u5927\u7684\u5c0d\u624b\uff0c\u540c\u6642\u589e\u5f37\u81ea\u5df1\u7684\u5be6\u529b\u3002"}, {"question": "\u5982\u4f55\u5728 Gulper.io \u4e2d\u6709\u6548\u4f7f\u7528\u589e\u76ca\u9053\u5177\u4f86\u7372\u5f97\u512a\u52e2\uff1f", "answer": "\u5982\u679c\u904b\u7528\u5f97\u7576\uff0cGulper.io \u4e2d\u7684\u589e\u76ca\u9053\u5177\u53ef\u4ee5\u70ba\u60a8\u5e36\u4f86\u986f\u8457\u7684\u512a\u52e2\u3002\u4f8b\u5982\uff0c\u300c\u52a0\u901f\u300d\u589e\u76ca\u9053\u5177\u8b93\u60a8\u53ef\u4ee5\u9003\u96e2\u5371\u96aa\u60c5\u6cc1\u6216\u8ffd\u8d95\u8f03\u5c0f\u7684\u73a9\u5bb6\u3002\u96a8\u6642\u7559\u610f\u589e\u76ca\u9053\u5177\uff0c\u4e26\u7b56\u7565\u6027\u5730\u4f7f\u7528\u5b83\u5011\uff0c\u4f8b\u5982\u5728\u906d\u5230\u653b\u64ca\u6642\u4fdd\u5b58\u300c\u8b77\u76fe\u300d\u589e\u76ca\u9053\u5177\u3002"}, {"question": "\u5728 Gulper.io \u4e2d\u4f0f\u64ca\u5176\u4ed6\u73a9\u5bb6\u7684\u6700\u4f73\u65b9\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "\u8981\u5728 Gulper.io \u4e2d\u4f0f\u64ca\u5176\u4ed6\u73a9\u5bb6\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f\u4e00 - \u96b1\u85cf\u5728\u5967\u723e\u5e03\u5bc6\u5ea6\u9ad8\u7684\u5340\u57df\uff0c\u5438\u5f15\u8f03\u5c0f\u7684\u73a9\u5bb6\u904e\u4f86\u3002\u6b65\u9a5f\u4e8c - \u4f7f\u7528\u5ca9\u77f3\u548c\u7246\u58c1\u7b49\u969c\u7919\u7269\u96b1\u85cf\u60a8\u7684\u8e64\u8de1\u3002\u6b65\u9a5f\u4e09 - \u7b49\u5f85\u5408\u9069\u7684\u6642\u6a5f\u653b\u64ca\uff0c\u78ba\u4fdd\u60a8\u64c1\u6709\u9ad4\u7a4d\u512a\u52e2\u3002\u4f8b\u5982\uff0c\u96b1\u85cf\u5728\u5927\u5730\u5716\u4e2d\u592e\u7684\u4e00\u584a\u5927\u5ca9\u77f3\u5f8c\u9762\uff0c\u53ef\u4ee5\u6210\u70ba\u6709\u6548\u7684\u4f0f\u64ca\u5730\u9ede\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u5730\u5716\u610f\u8b58\u5728 Gulper.io \u4e2d\u81f3\u95dc\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u6539\u5584\u5b83\uff1f", "answer": "\u5728 Gulper.io \u4e2d\uff0c\u5730\u5716\u610f\u8b58\u5c0d\u65bc\u907f\u514d\u8f03\u5927\u7684\u73a9\u5bb6\u548c\u627e\u5230\u5967\u723e\u5e03\u81f3\u95dc\u91cd\u8981\u3002\u8981\u6539\u5584\u5b83\uff0c\u8acb\u5b9a\u671f\u67e5\u770b\u5c0f\u578b\u5730\u5716\uff0c\u4e26\u7559\u610f\u5468\u570d\u74b0\u5883\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5728\u5c0f\u578b\u5730\u5716\u4e0a\u770b\u5230\u5967\u723e\u5e03\u7fa4\uff0c\u8acb\u524d\u5f80\u8a72\u8655\uff0c\u4f46\u8981\u6ce8\u610f\u6f5b\u5728\u7684\u4f0f\u64ca\u3002\u5728\u4e0d\u540c\u7684\u904a\u6232\u6a21\u5f0f\u4e2d\u7df4\u7fd2\u5730\u5716\u5c0e\u822a\uff0c\u4ee5\u589e\u5f37\u60a8\u7684\u5730\u5716\u610f\u8b58\u3002"}, {"question": "Gulper.io \u4e2d\u7684\u9ad4\u7a4d\u6a5f\u5236\u5982\u4f55\u904b\u4f5c\uff0c\u4ee5\u53ca\u5176\u542b\u7fa9\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728 Gulper.io \u4e2d\uff0c\u96a8\u8457\u60a8\u6536\u96c6\u5967\u723e\u5e03\uff0c\u60a8\u7684\u9ad4\u7a4d\u6703\u589e\u52a0\uff0c\u8b93\u60a8\u66f4\u5f37\u5927\uff0c\u4f46\u4e5f\u8b93\u60a8\u6210\u70ba\u66f4\u5927\u7684\u76ee\u6a19\u3002\u8f03\u5927\u7684\u73a9\u5bb6\u53ef\u4ee5\u541e\u566c\u8f03\u5c0f\u7684\u73a9\u5bb6\uff0c\u4f46\u4ed6\u5011\u66f4\u6162\uff0c\u4e5f\u66f4\u660e\u986f\u3002\u4f8b\u5982\uff0c\u64c1\u6709 100 \u500b\u5967\u723e\u5e03\u7684\u73a9\u5bb6\u6bd4\u64c1\u6709 10 \u500b\u5967\u723e\u5e03\u7684\u73a9\u5bb6\u5927\u5f97\u591a\uff0c\u4e5f\u66f4\u6162\uff0c\u4f46\u537b\u66f4\u5bb9\u6613\u541e\u566c\u4ed6\u5011\u3002\u5e73\u8861\u60a8\u7684\u9ad4\u7a4d\u548c\u79fb\u52d5\u901f\u5ea6\uff0c\u4ee5\u4fdd\u6301\u7af6\u722d\u529b\u3002"}, {"question": "\u5728 Gulper.io \u4e2d\uff0c\u55ae\u4eba\u6a21\u5f0f\u548c\u5718\u968a\u6a21\u5f0f\u4e4b\u9593\u7684\u4e3b\u8981\u5340\u5225\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u55ae\u4eba\u6a21\u5f0f\u4e2d\uff0c\u60a8\u5fc5\u9808\u4f9d\u9760\u81ea\u5df1\u7684\u6280\u80fd\u4f86\u751f\u5b58\u548c\u6210\u9577\uff0c\u800c\u5728\u5718\u968a\u6a21\u5f0f\u4e2d\uff0c\u8207\u968a\u53cb\u7684\u5354\u8abf\u81f3\u95dc\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5728\u5718\u968a\u6a21\u5f0f\u4e2d\uff0c\u60a8\u53ef\u4ee5\u4fdd\u8b77\u8f03\u5c0f\u7684\u968a\u53cb\uff0c\u8b93\u4ed6\u5011\u6536\u96c6\u5967\u723e\u5e03\uff0c\u5275\u9020\u4e00\u500b\u5e73\u8861\u7684\u5718\u968a\u3002\u55ae\u4eba\u6a21\u5f0f\u9700\u8981\u66f4\u7b56\u7565\u6027\u7684\u904a\u6232\u548c\u610f\u8b58\uff0c\u800c\u5718\u968a\u6a21\u5f0f\u5247\u5074\u91cd\u65bc\u5718\u968a\u5408\u4f5c\u548c\u6e9d\u901a\u3002"}, {"question": "\u5982\u4f55\u5c07\u6211\u7684 Gulper.io \u9032\u5ea6\u8f49\u79fb\u5230\u4e0d\u540c\u7684\u88dd\u7f6e\uff1f", "answer": "\u8981\u8f49\u79fb\u60a8\u7684 Gulper.io \u9032\u5ea6\uff0c\u8acb\u78ba\u4fdd\u60a8\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u90fd\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u96fb\u8166\u4e0a\u73a9\uff0c\u4e26\u60f3\u5207\u63db\u5230\u624b\u6a5f\u88dd\u7f6e\uff0c\u8acb\u4f7f\u7528\u60a8\u7684\u5e33\u6236\u6191\u8b49\u767b\u5165\u624b\u6a5f\u61c9\u7528\u7a0b\u5f0f\u3002\u60a8\u7684\u9032\u5ea6\uff0c\u5305\u62ec\u5967\u723e\u5e03\u548c\u6210\u5c31\uff0c\u5c07\u81ea\u52d5\u540c\u6b65\u3002\u59cb\u7d42\u5099\u4efd\u60a8\u7684\u5e33\u6236\uff0c\u4ee5\u907f\u514d\u8cc7\u6599\u907a\u5931\u3002"}, {"question": "Gulper.io \u4e2d\u4e00\u4e9b\u73a9\u5bb6\u53ef\u80fd\u4e0d\u77e5\u9053\u7684\u96b1\u85cf\u6a5f\u5236\u6216\u5f69\u86cb\u662f\u4ec0\u9ebc\uff1f", "answer": "Gulper.io \u6709\u4e00\u4e9b\u96b1\u85cf\u7684\u6a5f\u5236\u548c\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u5728\u7279\u5b9a\u6642\u9593\u7279\u5b9a\u5730\u9ede\u6703\u51fa\u73fe\u7a00\u6709\u7684\u5967\u723e\u5e03\uff0c\u63d0\u4f9b\u7368\u7279\u7684\u589e\u76ca\u9053\u5177\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u5730\u5716\u6709\u96b1\u85cf\u5340\u57df\uff0c\u53ea\u80fd\u7531\u7279\u5b9a\u9ad4\u7a4d\u7684\u73a9\u5bb6\u9032\u5165\u3002\u63a2\u7d22\u9019\u4e9b\u5340\u57df\u53ef\u4ee5\u8b93\u60a8\u7372\u5f97\u512a\u52e2\u3002\u7559\u610f\u74b0\u5883\u4e2d\u7684\u7570\u5e38\u5716\u6848\u6216\u7dda\u7d22\u3002"}]
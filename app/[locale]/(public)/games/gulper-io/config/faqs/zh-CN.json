[{"question": "\u65b0\u624b\u5982\u4f55\u63a7\u5236\u6211\u5728Gulper.io\u4e2d\u7684\u89d2\u8272\uff1f", "answer": "\u5728Gulper.io\u4e2d\uff0c\u60a8\u53ef\u4ee5\u4f7f\u7528WASD\u952e\u63a7\u5236\u89d2\u8272\u79fb\u52a8\uff0c\u4f7f\u7528\u9f20\u6807\u7784\u51c6\u548c\u5c04\u51fb\u3002\u4f8b\u5982\uff0c\u5411\u524d\u79fb\u52a8\uff0c\u8bf7\u6309\"W\"\u952e\uff1b\u5411\u5de6\u8f6c\uff0c\u8bf7\u6309\"A\"\u952e\u3002\u5728\u6559\u7a0b\u6a21\u5f0f\u4e2d\u7ec3\u4e60\u8fd9\u4e9b\u63a7\u5236\uff0c\u4ee5\u4fbf\u9002\u5e94\u6e38\u620f\u3002\u6b64\u5916\uff0c\u60a8\u53ef\u4ee5\u5728\u8bbe\u7f6e\u4e2d\u8c03\u6574\u9f20\u6807\u7075\u654f\u5ea6\u4ee5\u9002\u5e94\u60a8\u7684\u6e38\u620f\u98ce\u683c\u3002"}, {"question": "\u5728Gulper.io\u4e2d\u6536\u96c6\u80fd\u91cf\u7403\u6709\u4ec0\u4e48\u91cd\u8981\u610f\u4e49\uff0c\u4ee5\u53ca\u5982\u4f55\u627e\u5230\u5b83\u4eec\uff1f", "answer": "\u5728Gulper.io\u4e2d\u6536\u96c6\u80fd\u91cf\u7403\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u4eec\u4f1a\u589e\u52a0\u60a8\u7684\u4f53\u578b\u548c\u529b\u91cf\uff0c\u8ba9\u60a8\u66f4\u5177\u7ade\u4e89\u529b\u3002\u80fd\u91cf\u7403\u6563\u5e03\u5728\u6574\u4e2a\u5730\u56fe\u4e0a\uff0c\u53ef\u4ee5\u901a\u8fc7\u63a2\u7d22\u4e0d\u540c\u533a\u57df\u627e\u5230\u3002\u4f8b\u5982\uff0c\u80fd\u91cf\u7403\u901a\u5e38\u51fa\u73b0\u5728\u5730\u56fe\u4e2d\u5fc3\u6216\u504f\u50fb\u7684\u89d2\u843d\u3002\u5b9a\u671f\u68c0\u67e5\u8fd9\u4e9b\u5730\u70b9\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u6536\u96c6\u80fd\u91cf\u7403\u3002"}, {"question": "\u5728Gulper.io\u4e2d\u751f\u5b58\u66f4\u957f\u65f6\u95f4\u7684\u57fa\u672c\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u8981\u5728Gulper.io\u4e2d\u751f\u5b58\u66f4\u957f\u65f6\u95f4\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u901a\u8fc7\u5f85\u5728\u4eba\u5c11\u7684\u5730\u65b9\u907f\u5f00\u4f53\u578b\u8f83\u5927\u7684\u73a9\u5bb6\u3002\u6b65\u9aa42 - \u6536\u96c6\u80fd\u91cf\u7403\u6765\u589e\u52a0\u60a8\u7684\u4f53\u578b\u548c\u529b\u91cf\u3002\u6b65\u9aa43 - \u5229\u7528\u73af\u5883\u9690\u85cf\u548c\u4f0f\u51fb\u4f53\u578b\u8f83\u5c0f\u7684\u73a9\u5bb6\u3002\u4f8b\u5982\uff0c\u53ef\u4ee5\u4f7f\u7528\u5ca9\u77f3\u548c\u5899\u58c1\u4f5c\u4e3a\u63a9\u62a4\u6765\u8eb2\u907f\u4f53\u578b\u8f83\u5927\u7684\u5bf9\u624b\uff0c\u540c\u65f6\u8ba9\u81ea\u5df1\u4e0d\u65ad\u53d8\u5f3a\u3002"}, {"question": "\u5982\u4f55\u5728Gulper.io\u4e2d\u6709\u6548\u5730\u4f7f\u7528\u9053\u5177\u6765\u83b7\u5f97\u4f18\u52bf\uff1f", "answer": "\u5982\u679c\u4f7f\u7528\u5f97\u5f53\uff0cGulper.io\u4e2d\u7684\u9053\u5177\u53ef\u4ee5\u4e3a\u60a8\u5e26\u6765\u663e\u8457\u7684\u4f18\u52bf\u3002\u4f8b\u5982\uff0c\"\u52a0\u901f\"\u9053\u5177\u53ef\u4ee5\u8ba9\u60a8\u9003\u79bb\u5371\u9669\u60c5\u51b5\u6216\u8ffd\u8d76\u4f53\u578b\u8f83\u5c0f\u7684\u73a9\u5bb6\u3002\u65f6\u523b\u7559\u610f\u9053\u5177\uff0c\u5e76\u91c7\u53d6\u6218\u7565\u6027\u5730\u4f7f\u7528\u5b83\u4eec\uff0c\u4f8b\u5982\u5728\u53d7\u5230\u653b\u51fb\u65f6\u4fdd\u7559\"\u76fe\u724c\"\u9053\u5177\u3002"}, {"question": "\u5728Gulper.io\u4e2d\u4f0f\u51fb\u5176\u4ed6\u73a9\u5bb6\u7684\u6700\u4f73\u65b9\u6cd5\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728Gulper.io\u4e2d\u4f0f\u51fb\u5176\u4ed6\u73a9\u5bb6\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u9690\u85cf\u5728\u80fd\u91cf\u7403\u5bc6\u5ea6\u9ad8\u7684\u533a\u57df\u4ee5\u5438\u5f15\u4f53\u578b\u8f83\u5c0f\u7684\u73a9\u5bb6\u3002\u6b65\u9aa42 - \u4f7f\u7528\u5ca9\u77f3\u548c\u5899\u58c1\u7b49\u969c\u788d\u7269\u9690\u85cf\u60a8\u7684\u5b58\u5728\u3002\u6b65\u9aa43 - \u8010\u5fc3\u7b49\u5f85\u65f6\u673a\uff0c\u786e\u4fdd\u62e5\u6709\u4f53\u578b\u4f18\u52bf\u3002\u4f8b\u5982\uff0c\u5728\u5927\u5730\u56fe\u4e2d\u5fc3\u9644\u8fd1\u85cf\u5728\u5927\u77f3\u5934\u540e\u9762\u662f\u4e00\u4e2a\u6709\u6548\u7684\u4f0f\u51fb\u5730\u70b9\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u5728Gulper.io\u4e2d\u5730\u56fe\u610f\u8bc6\u81f3\u5173\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u63d0\u9ad8\u5b83\uff1f", "answer": "\u5728Gulper.io\u4e2d\uff0c\u5730\u56fe\u610f\u8bc6\u5bf9\u4e8e\u907f\u514d\u4f53\u578b\u8f83\u5927\u7684\u73a9\u5bb6\u548c\u627e\u5230\u80fd\u91cf\u7403\u81f3\u5173\u91cd\u8981\u3002\u8981\u63d0\u9ad8\u5730\u56fe\u610f\u8bc6\uff0c\u8bf7\u5b9a\u671f\u67e5\u770b\u8ff7\u4f60\u5730\u56fe\u5e76\u6ce8\u610f\u5468\u56f4\u73af\u5883\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u8ff7\u4f60\u5730\u56fe\u4e0a\u770b\u5230\u4e00\u7c07\u80fd\u91cf\u7403\uff0c\u8bf7\u524d\u5f80\u90a3\u91cc\uff0c\u4f46\u8981\u5c0f\u5fc3\u6f5c\u5728\u7684\u4f0f\u51fb\u3002\u5728\u4e0d\u540c\u7684\u6e38\u620f\u6a21\u5f0f\u4e2d\u7ec3\u4e60\u5bfc\u822a\u5730\u56fe\u4ee5\u589e\u5f3a\u60a8\u7684\u5730\u56fe\u610f\u8bc6\u3002"}, {"question": "Gulper.io\u4e2d\u7684\u4f53\u578b\u673a\u5236\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u5b83\u7684\u542b\u4e49\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728Gulper.io\u4e2d\uff0c\u968f\u7740\u60a8\u6536\u96c6\u80fd\u91cf\u7403\uff0c\u60a8\u7684\u4f53\u578b\u4f1a\u589e\u52a0\uff0c\u8fd9\u4f7f\u60a8\u66f4\u5f3a\u5927\uff0c\u4f46\u4e5f\u589e\u52a0\u4e86\u60a8\u6210\u4e3a\u76ee\u6807\u7684\u53ef\u80fd\u6027\u3002\u4f53\u578b\u8f83\u5927\u7684\u73a9\u5bb6\u53ef\u4ee5\u541e\u566c\u4f53\u578b\u8f83\u5c0f\u7684\u73a9\u5bb6\uff0c\u4f46\u4ed6\u4eec\u79fb\u52a8\u901f\u5ea6\u8f83\u6162\uff0c\u4e5f\u66f4\u5bb9\u6613\u88ab\u53d1\u73b0\u3002\u4f8b\u5982\uff0c\u62e5\u6709100\u4e2a\u80fd\u91cf\u7403\u7684\u73a9\u5bb6\u6bd4\u62e5\u670910\u4e2a\u80fd\u91cf\u7403\u7684\u73a9\u5bb6\u4f53\u578b\u66f4\u5927\u3001\u79fb\u52a8\u66f4\u6162\uff0c\u4f46\u53ef\u4ee5\u8f7b\u677e\u5730\u541e\u566c\u4ed6\u4eec\u3002\u5e73\u8861\u60a8\u7684\u4f53\u578b\u548c\u673a\u52a8\u6027\u4ee5\u4fdd\u6301\u7ade\u4e89\u529b\u3002"}, {"question": "Gulper.io\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u56e2\u961f\u6a21\u5f0f\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u5728\u5355\u4eba\u6a21\u5f0f\u4e2d\uff0c\u60a8\u5fc5\u987b\u4f9d\u9760\u81ea\u5df1\u7684\u6280\u80fd\u751f\u5b58\u548c\u6210\u957f\uff0c\u800c\u5728\u56e2\u961f\u6a21\u5f0f\u4e2d\uff0c\u4e0e\u961f\u53cb\u7684\u914d\u5408\u81f3\u5173\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5728\u56e2\u961f\u6a21\u5f0f\u4e2d\uff0c\u60a8\u53ef\u4ee5\u4fdd\u62a4\u4f53\u578b\u8f83\u5c0f\u7684\u961f\u53cb\uff0c\u8ba9\u4ed6\u4eec\u6536\u96c6\u80fd\u91cf\u7403\uff0c\u521b\u5efa\u4e00\u652f\u5e73\u8861\u7684\u56e2\u961f\u3002\u5355\u4eba\u6a21\u5f0f\u9700\u8981\u66f4\u5177\u6218\u7565\u6027\u7684\u6e38\u620f\u548c\u610f\u8bc6\uff0c\u800c\u56e2\u961f\u6a21\u5f0f\u5219\u5f3a\u8c03\u56e2\u961f\u5408\u4f5c\u548c\u6c9f\u901a\u3002"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684Gulper.io\u8fdb\u5ea6\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u8f6c\u79fb\uff1f", "answer": "\u8981\u8f6c\u79fb\u60a8\u7684Gulper.io\u8fdb\u5ea6\uff0c\u8bf7\u786e\u4fdd\u60a8\u5728\u6240\u6709\u8bbe\u5907\u4e0a\u767b\u5f55\u540c\u4e00\u4e2a\u8d26\u6237\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u7535\u8111\u4e0a\u73a9\uff0c\u60f3\u8981\u5207\u6362\u5230\u624b\u673a\u8bbe\u5907\uff0c\u8bf7\u4f7f\u7528\u60a8\u7684\u8d26\u6237\u51ed\u636e\u767b\u5f55\u624b\u673a\u5e94\u7528\u7a0b\u5e8f\u3002\u60a8\u7684\u8fdb\u5ea6\uff0c\u5305\u62ec\u80fd\u91cf\u7403\u548c\u6210\u5c31\uff0c\u5c06\u4f1a\u81ea\u52a8\u540c\u6b65\u3002\u8bf7\u59cb\u7ec8\u5907\u4efd\u60a8\u7684\u8d26\u6237\u4ee5\u907f\u514d\u6570\u636e\u4e22\u5931\u3002"}, {"question": "Gulper.io\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u673a\u5236\u6216\u5f69\u86cb\u73a9\u5bb6\u53ef\u80fd\u4e0d\u77e5\u9053\uff1f", "answer": "Gulper.io\u4e2d\u6709\u4e00\u4e9b\u9690\u85cf\u673a\u5236\u548c\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u5728\u7279\u5b9a\u65f6\u95f4\uff0c\u7279\u5b9a\u4f4d\u7f6e\u4f1a\u51fa\u73b0\u7a00\u6709\u80fd\u91cf\u7403\uff0c\u63d0\u4f9b\u72ec\u7279\u7684\u9053\u5177\u3002\u6b64\u5916\uff0c\u4e00\u4e9b\u5730\u56fe\u4e2d\u6709\u9690\u85cf\u533a\u57df\uff0c\u53ea\u6709\u7279\u5b9a\u4f53\u578b\u73a9\u5bb6\u624d\u80fd\u8fdb\u5165\u3002\u63a2\u7d22\u8fd9\u4e9b\u533a\u57df\u53ef\u4ee5\u4e3a\u60a8\u5e26\u6765\u4f18\u52bf\u3002\u8bf7\u5bc6\u5207\u5173\u6ce8\u73af\u5883\u4e2d\u7684\u5f02\u5e38\u56fe\u6848\u6216\u7ebf\u7d22\u3002"}]
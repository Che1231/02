[{"question": "\ucd08\uc2ec\uc790\ub85c\uc11c Gulper.io\uc5d0\uc11c \uce90\ub9ad\ud130\ub97c \uc5b4\ub5bb\uac8c \uc81c\uc5b4\ud569\ub2c8\uae4c?", "answer": "Gulper.io\uc5d0\uc11c WASD \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc774\ub3d9\ud558\uace0 \ub9c8\uc6b0\uc2a4\ub85c \uc870\uc900 \ubc0f \uc0ac\uaca9\ud558\uc5ec \uce90\ub9ad\ud130\ub97c \uc81c\uc5b4\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc55e\uc73c\ub85c \uc774\ub3d9\ud558\ub824\uba74 'W' \ud0a4\ub97c \ub204\ub974\uace0, \uc67c\ucabd\uc73c\ub85c \ud68c\uc804\ud558\ub824\uba74 'A' \ud0a4\ub97c \ub204\ub985\ub2c8\ub2e4. \ud29c\ud1a0\ub9ac\uc5bc \ubaa8\ub4dc\uc5d0\uc11c \uc774\ub7ec\ud55c \uc81c\uc5b4 \ubc29\ubc95\uc744 \uc5f0\uc2b5\ud558\uc5ec \uc775\uc219\ud574\uc9c0\uc2ed\uc2dc\uc624. \ub610\ud55c, \uc124\uc815\uc5d0\uc11c \ub9c8\uc6b0\uc2a4 \ubbfc\uac10\ub3c4\ub97c \uc870\uc815\ud558\uc5ec \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\ucd9c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Gulper.io\uc5d0\uc11c \uc624\ube0c\ub97c \uc218\uc9d1\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Gulper.io\uc5d0\uc11c \uc624\ube0c\ub97c \uc218\uc9d1\ud558\ub294 \uac83\uc740 \ud06c\uae30\uc640 \ud798\uc744 \uc99d\uac00\uc2dc\ucf1c \ub354\uc6b1 \uacbd\uc7c1\ub825 \uc788\uac8c \ub9cc\ub4e4\uae30 \ub54c\ubb38\uc5d0 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc624\ube0c\ub294 \uc9c0\ub3c4 \uacf3\uacf3\uc5d0 \ud769\uc5b4\uc838 \uc788\uc73c\uba70, \ub2e4\uc591\ud55c \uc9c0\uc5ed\uc744 \ud0d0\ud5d8\ud558\uc5ec \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc624\ube0c\ub294 \uc885\uc885 \uc9c0\ub3c4 \uc911\uc559\uc774\ub098 \uc678\ub534 \uad6c\uc11d\uc5d0 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \uc624\ube0c \uc218\uc9d1\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \uc815\uae30\uc801\uc73c\ub85c \uc774\ub7ec\ud55c \uc7a5\uc18c\ub97c \ud655\uc778\ud558\uc2ed\uc2dc\uc624."}, {"question": "Gulper.io\uc5d0\uc11c \ub354 \uc624\ub798 \uc0dd\uc874\ud558\uae30 \uc704\ud55c \uae30\ubcf8 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Gulper.io\uc5d0\uc11c \ub354 \uc624\ub798 \uc0dd\uc874\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: \ub2e8\uacc4 1. \ub354 \ub113\uc740 \uc9c0\uc5ed\uc5d0 \uba38\ubb3c\ub7ec \ub354 \ud070 \ud50c\ub808\uc774\uc5b4\ub97c \ud53c\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2. \ud06c\uae30\uc640 \ud798\uc744 \ub192\uc774\uae30 \uc704\ud574 \uc624\ube0c\ub97c \uc218\uc9d1\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3. \ud658\uacbd\uc744 \ud65c\uc6a9\ud558\uc5ec \uc228\uac70\ub098 \ub354 \uc791\uc740 \ud50c\ub808\uc774\uc5b4\ub97c \uae30\uc2b5\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ud070 \uc0c1\ub300\ub97c \ud53c\ud558\uba74\uc11c \ub354 \uac15\ud574\uc9c0\ub824\uba74 \ubc14\uc704\ub098 \ubcbd\uc744 \uc740\uc2e0\ucc98\ub85c \ud65c\uc6a9\ud558\uc138\uc694."}, {"question": "Gulper.io\uc5d0\uc11c \uac15\ub825\ud55c \uc774\uc810\uc744 \uc5bb\uae30 \uc704\ud574 \ub2a5\ub825\uce58\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Gulper.io\uc5d0\uc11c \ub2a5\ub825\uce58\ub97c \uc62c\ubc14\ub974\uac8c \uc0ac\uc6a9\ud558\uba74 \uc0c1\ub2f9\ud55c \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc18d\ub3c4 \uc99d\uac00\" \ub2a5\ub825\uce58\ub97c \uc0ac\uc6a9\ud558\uba74 \uc704\ud5d8\ud55c \uc0c1\ud669\uc5d0\uc11c \ub3c4\ub9dd\uce58\uac70\ub098 \ub354 \uc791\uc740 \ud50c\ub808\uc774\uc5b4\ub97c \ucd94\uaca9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud56d\uc0c1 \ub2a5\ub825\uce58\ub97c \uc8fc\uc2dc\ud558\uace0 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uacf5\uaca9\uc744 \ubc1b\uc744 \ub54c \"\ubc29\ud328\" \ub2a5\ub825\uce58\ub97c \ubcf4\uad00\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4."}, {"question": "Gulper.io\uc5d0\uc11c \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uae30\uc2b5\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Gulper.io\uc5d0\uc11c \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub97c \uae30\uc2b5\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: \ub2e8\uacc4 1. \uc791\uc740 \ud50c\ub808\uc774\uc5b4\ub97c \uc720\uc778\ud558\uae30 \uc704\ud574 \ub192\uc740 \uc624\ube0c \ubc00\ub3c4 \uc9c0\uc5ed\uc5d0 \uc228\uc73c\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2. \ubc14\uc704\ub098 \ubcbd\uacfc \uac19\uc740 \uc7a5\uc560\ubb3c\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc874\uc7ac\ub97c \uac10\ucd94\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3. \ud06c\uae30 \uc6b0\uc704\ub97c \ud655\ubcf4\ud588\uc744 \ub54c \uc801\uc808\ud55c \uc21c\uac04\uc744 \uae30\ub2e4\ub824 \uacf5\uaca9\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc9c0\ub3c4 \uc911\uc559 \uadfc\ucc98\uc758 \ud070 \ubc14\uc704 \ub4a4\uc5d0 \uc228\ub294 \uac83\uc774 \ud6a8\uacfc\uc801\uc778 \uae30\uc2b5 \uc704\uce58\uac00 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Gulper.io\uc5d0\uc11c \uc9c0\ub3c4 \uc778\uc9c0\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \uac1c\uc120\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Gulper.io\uc5d0\uc11c \uc9c0\ub3c4 \uc778\uc9c0\ub294 \ub354 \ud070 \ud50c\ub808\uc774\uc5b4\ub97c \ud53c\ud558\uace0 \uc624\ube0c\ub97c \ucc3e\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uac1c\uc120\ud558\ub824\uba74 \uc815\uae30\uc801\uc73c\ub85c \ubbf8\ub2c8\ub9f5\uc744 \ud655\uc778\ud558\uace0 \uc8fc\ubcc0\uc744 \uc778\uc9c0\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ubbf8\ub2c8\ub9f5\uc5d0 \uc624\ube0c\uac00 \ubaa8\uc5ec \uc788\ub294 \uac83\uc744 \ubcf4\uba74 \uc8fc\uc758\ud558\uba74\uc11c \uac70\uae30\uc5d0 \uac00\uc57c \ud569\ub2c8\ub2e4. \ub2e4\uc591\ud55c \uac8c\uc784 \ubaa8\ub4dc\uc5d0\uc11c \uc9c0\ub3c4\ub97c \ud0d0\uc0c9\ud558\ub294 \uc5f0\uc2b5\uc744 \ud1b5\ud574 \uc778\uc9c0\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\uc2ed\uc2dc\uc624."}, {"question": "Gulper.io\uc5d0\uc11c \ud06c\uae30 \uba54\ucee4\ub2c8\uc998\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \uc5b4\ub5a4 \uc758\ubbf8\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Gulper.io\uc5d0\uc11c \uc624\ube0c\ub97c \uc218\uc9d1\ud558\uba74 \ud06c\uae30\uac00 \ucee4\uc838 \ub354 \uac15\ub825\ud574\uc9c0\uc9c0\ub9cc, \ub354 \ud070 \ud45c\uc801\uc774 \ub429\ub2c8\ub2e4. \ub354 \ud070 \ud50c\ub808\uc774\uc5b4\ub294 \ub354 \uc791\uc740 \ud50c\ub808\uc774\uc5b4\ub97c \ud761\uc218\ud560 \uc218 \uc788\uc9c0\ub9cc, \ub354 \ub290\ub9ac\uace0 \ub354 \ub208\uc5d0 \ub755\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 100\uac1c\uc758 \uc624\ube0c\ub97c \uac00\uc9c4 \ud50c\ub808\uc774\uc5b4\ub294 10\uac1c\uc758 \uc624\ube0c\ub97c \uac00\uc9c4 \ud50c\ub808\uc774\uc5b4\ubcf4\ub2e4 \ud6e8\uc52c \ud06c\uace0 \ub290\ub9ac\uc9c0\ub9cc, \uc27d\uac8c \ud761\uc218\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uacbd\uc7c1\ub825\uc744 \uc720\uc9c0\ud558\uae30 \uc704\ud574 \ud06c\uae30\uc640 \uc774\ub3d9\uc131\uc744 \uade0\ud615 \uc788\uac8c \uc720\uc9c0\ud558\uc2ed\uc2dc\uc624."}, {"question": "Gulper.io\uc758 \uc194\ub85c \ubaa8\ub4dc\uc640 \ud300 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc194\ub85c \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uc0dd\uc874\uacfc \uc131\uc7a5\uc744 \uc704\ud574 \uc624\ub85c\uc9c0 \uc790\uc2e0\uc758 \uae30\uc220\uc5d0 \uc758\uc874\ud574\uc57c \ud558\uc9c0\ub9cc, \ud300 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \ud300\uc6d0\uacfc\uc758 \ud611\ub825\uc774 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud300 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uc791\uc740 \ud300\uc6d0\uc744 \ubcf4\ud638\ud558\uba74\uc11c \uc624\ube0c\ub97c \uc218\uc9d1\ud560 \uc218 \uc788\ub3c4\ub85d \uade0\ud615 \uc7a1\ud78c \ud300\uc744 \ub9cc\ub4ed\ub2c8\ub2e4. \uc194\ub85c \ubaa8\ub4dc\ub294 \ub354 \uc804\ub7b5\uc801\uc778 \ud50c\ub808\uc774\uc640 \uc778\uc2dd\uc744 \uc694\uad6c\ud558\ub294 \ubc18\uba74, \ud300 \ubaa8\ub4dc\ub294 \ud300\uc6cc\ud06c\uc640 \uc758\uc0ac\uc18c\ud1b5\uc744 \uac15\uc870\ud569\ub2c8\ub2e4."}, {"question": "\ub2e4\ub978 \uae30\uae30 \uac04\uc5d0 Gulper.io \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Gulper.io \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub824\uba74 \ub450 \uae30\uae30 \ubaa8\ub450 \uac19\uc740 \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ud50c\ub808\uc774\ud558\uace0 \ubaa8\ubc14\uc77c \uae30\uae30\ub85c \uc804\ud658\ud558\ub824\uba74 \ubaa8\ubc14\uc77c \uc571\uc5d0\uc11c \uacc4\uc815 \uc790\uaca9 \uc99d\uba85\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uc2ed\uc2dc\uc624. \uc624\ube0c\uc640 \uc5c5\uc801\uc744 \ud3ec\ud568\ud55c \uc9c4\ud589 \uc0c1\ud669\uc774 \uc790\ub3d9\uc73c\ub85c \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. \ub370\uc774\ud130 \uc190\uc2e4\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \ud56d\uc0c1 \uacc4\uc815\uc744 \ubc31\uc5c5\ud558\uc2ed\uc2dc\uc624."}, {"question": "Gulper.io\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 \ubaa8\ub974\ub294 \uc228\uaca8\uc9c4 \uba54\ucee4\ub2c8\uc998\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Gulper.io\uc5d0\ub294 \uc5ec\ub7ec \uac00\uc9c0 \uc228\uaca8\uc9c4 \uba54\ucee4\ub2c8\uc998\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud2b9\uc815 \uc2dc\uac04\uc5d0 \ud2b9\uc815 \uc704\uce58\uc5d0 \ub098\ud0c0\ub098\ub294 \ub4dc\ubb38 \uc624\ube0c\uac00 \uc788\uc73c\uba70, \uace0\uc720\ud55c \ub2a5\ub825\uce58\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub610\ud55c, \uc77c\ubd80 \uc9c0\ub3c4\uc5d0\ub294 \ud2b9\uc815 \ud06c\uae30\uc758 \ud50c\ub808\uc774\uc5b4\ub9cc \uc811\uadfc\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc601\uc5ed\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc601\uc5ed\uc744 \ud0d0\ud5d8\ud558\uba74 \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud658\uacbd\uc5d0\uc11c \ud2b9\uc774\ud55c \ud328\ud134\uc774\ub098 \ub2e8\uc11c\ub97c \uacc4\uc18d \uc8fc\uc2dc\ud558\uc2ed\uc2dc\uc624."}]
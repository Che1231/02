064\u308c\u3066\u3001\u86c7\u306f\u5229\u7528\u53ef\u80fd\u306a\u30b9\u30da\u30fc\u30b9\u3092\u5360\u9818\u3057\u307e\u3059\u3002\u3042\u308b\u30b3\u30fc\u30c9\u3067\u306f\u3001\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u30d7\u30ec\u30fc\u30e4\u30fc\u304c\u5bfe\u5fdc\u3059\u308b\u6a5f\u4f1a\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u3088\u3046\u306b\u3001\u86c7\u306e\u982d\u90e8\u306b\u3042\u307e\u308a\u306b\u3082\u8fd1\u3059\u304e\u308b\u5834\u6240\u306b\u751f\u6210\u3057\u306a\u3044\u3088\u3046\u306b\u3057\u307e\u3059\u3002\u5206\u6790\u7684\u306b\u8a00\u3048\u3070\u3001\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u86c7\u306e\u73fe\u5728\u306e\u4f4d\u7f6e\u3068\u30e9\u30f3\u30c0\u30e0\u306a\uff08x\u3001y\uff09\u5ea7\u6a19\u3092\u751f\u6210\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "Google Snake\u306e\u5236\u9650\u4e8b\u9805\uff1aGoogle Snake\u306e\u6280\u8853\u7684\u306a\u5236\u9650\u4e8b\u9805\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u308c\u3089\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u30c7\u30d0\u30a4\u30b9\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "Google Snake\u306f\u3001\u30a6\u30a7\u30d6\u30d6\u30e9\u30a6\u30b6\u307e\u305f\u306f\u30e2\u30d0\u30a4\u30eb\u30a2\u30d7\u30ea\u3067\u52d5\u4f5c\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u7d14\u7c8b\u306a\u6280\u8853\u7684\u306a\u89b3\u70b9\u304b\u3089\u3001\u7279\u5b9a\u306e\u5236\u9650\u3092\u3082\u305f\u3089\u3057\u307e\u3059\u3002\u53e4\u3044\u30c7\u30d0\u30a4\u30b9\u306fJavaScript\u3092\u8fc5\u901f\u306b\u51e6\u7406\u3059\u308b\u306e\u306b\u82e6\u52b4\u3057\u3001\u7279\u306b\u30d8\u30d3\u304c\u9577\u304f\u306a\u308b\u307b\u3069\u3001\u30b2\u30fc\u30e0\u304c\u9045\u308c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u30d6\u30e9\u30a6\u30b6\u306e\u30e1\u30e2\u30ea\u5236\u9650\u306b\u3088\u308a\u3001\u30d8\u30d3\u304c\u904e\u5ea6\u306b\u9577\u304f\u306a\u308b\u3068\uff08\u4f8b\u3048\u3070\u3001\u753b\u9762\u306e\u307b\u3068\u3093\u3069\u3092\u5360\u3081\u308b\u5834\u5408\uff09\u3001\u30af\u30e9\u30c3\u30b7\u30e5\u3059\u308b\u53ef\u80fd\u6027\u3082\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5f37\u529b\u306a\u6700\u65b0\u306e\u30b2\u30fc\u30df\u30f3\u30b0\u30e9\u30c3\u30d7\u30c8\u30c3\u30d7\u306f\u3001\u53e4\u3044\u30bf\u30d6\u30ec\u30c3\u30c8\u3068\u6bd4\u8f03\u3057\u3066\u975e\u5e38\u306b\u5927\u304d\u3044\u30d8\u30d3\u3092\u51e6\u7406\u3057\u307e\u3059\u3002"}, {"question": "Google Snake\u306e\u79fb\u690d\u6027\uff1aGoogle Snake\u306e\u9032\u884c\u72b6\u6cc1\u307e\u305f\u306f\u8a2d\u5b9a\u306f\u3001\u30a6\u30a7\u30d6\u30d6\u30e9\u30a6\u30b6\u7248\u3068\u30e2\u30d0\u30a4\u30eb\u30a2\u30d7\u30ea\u7248\u306e\u9593\u3067\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f\u3082\u3057\u53ef\u80fd\u306a\u3089\u3001\u3069\u306e\u3088\u3046\u306b\uff1f", "answer": "\u6b8b\u5ff5\u306a\u304c\u3089\u3001Google Snake\u306e\u9032\u884c\u72b6\u6cc1\u3084\u8a2d\u5b9a\u306f\u3001\u30a6\u30a7\u30d6\u30d6\u30e9\u30a6\u30b6\u7248\u3068\u30a2\u30d7\u30ea\u7248\u306e\u9593\u3067\u76f4\u63a5\u8ee2\u9001\u3059\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002\u5404\u30d0\u30fc\u30b8\u30e7\u30f3\u306f\u901a\u5e38\u3001\u30c7\u30fc\u30bf\u3092\u30ed\u30fc\u30ab\u30eb\u306b\u4fdd\u5b58\u3057\u307e\u3059\u3002\u3064\u307e\u308a\u3001\u30cf\u30a4\u30b9\u30b3\u30a2\u3068\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u306f\u3001\u3042\u306a\u305f\u304c\u30d7\u30ec\u30a4\u3057\u3066\u3044\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u56fa\u6709\u3067\u3042\u308a\u3001\u30d6\u30e9\u30a6\u30b6\u306e\u8a2d\u5b9a\u3084\u30ad\u30e3\u30c3\u30b7\u30e5\u3092\u30af\u30ea\u30a2\u3057\u305f\u308a\u3001\u30a2\u30d7\u30ea\u3092\u30a2\u30f3\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u305f\u308a\u3057\u305f\u5834\u5408\u3001\u9032\u884c\u72b6\u6cc1\u306f\u5931\u308f\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30a6\u30a7\u30d6\u30d6\u30e9\u30a6\u30b6\u30d0\u30fc\u30b8\u30e7\u30f3\u3067500\u30dd\u30a4\u30f3\u30c8\u306e\u30cf\u30a4\u30b9\u30b3\u30a2\u3092\u9054\u6210\u3057\u305f\u5834\u5408\u3001\u3053\u306e\u30b9\u30b3\u30a2\u306f\u4e00\u822c\u7684\u306b\u30e2\u30d0\u30a4\u30eb\u30a2\u30d7\u30ea\u306b\u53cd\u6620\u3055\u308c\u307e\u305b\u3093\u3002\u4e00\u90e8\u306e\u6700\u65b0\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u306f\u3001\u30a2\u30ab\u30a6\u30f3\u30c8\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u3092\u4ecb\u3057\u3066\u30a2\u30d7\u30ea\u30c7\u30fc\u30bf\u3092\u624b\u52d5\u307e\u305f\u306f\u81ea\u52d5\u7684\u306b\u8ee2\u9001\u3067\u304d\u307e\u3059\u3002"}, {"question": "Google Snake\u306e\u63a2\u6c42\uff1aGoogle Snake\u306b\u306f\u3001\u307b\u3068\u3093\u3069\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u77e5\u3089\u306a\u3044\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3084\u79d8\u5bc6\u6a5f\u80fd\u306f\u3042\u308a\u307e\u3059\u304b\uff1f\u305d\u308c\u3089\u306f\u3069\u306e\u3088\u3046\u306b\u30a2\u30af\u30c6\u30a3\u30d6\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Google Snake\u306b\u306f\u3044\u304f\u3064\u304b\u306e\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3068\u79d8\u5bc6\u306e\u6a5f\u80fd\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u79d8\u5bc6\u3092\u30a2\u30af\u30c6\u30a3\u30d6\u306b\u3059\u308b\u306b\u306f\u3001\u901a\u5e38\u3001\u7279\u5b9a\u306e\u30ad\u30fc\u306e\u7d44\u307f\u5408\u308f\u305b\u307e\u305f\u306f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4e2d\u306b\u5b9f\u884c\u3055\u308c\u305f\u30a2\u30af\u30b7\u30e7\u30f3\u304c\u5fc5\u8981\u3067\u3059\u3002\u4e00\u822c\u7684\u306a\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306e1\u3064\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u30de\u30c3\u30d7\u30b9\u30bf\u30a4\u30eb\u307e\u305f\u306f\u30c6\u30fc\u30de\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u3053\u308c\u306f\u901a\u5e38\u3001\u7279\u5b9a\u306e\u5834\u6240\u306b\u7279\u5b9a\u56de\u6570\u30bf\u30c3\u30d7\u3059\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u3001\u7279\u5225\u306a\u30c1\u30fc\u30c8\u30b3\u30fc\u30c9\u3092\u5165\u529b\u3059\u308b\u3053\u3068\u3092\u542b\u307f\u307e\u3059\u3002\u4e00\u822c\u7684\u306a\u4f8b\u3068\u3057\u3066\u3001\u8ffd\u52a0\u306e\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u306e\u305f\u3081\u306b\u30b3\u30f3\u30e9\u30df\u30fc\u30b3\u30fc\u30c9\u3092\u5165\u529b\u3059\u308b\u3053\u3068\u3067\u3059\u3002"}]
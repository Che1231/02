[{"question": "Google Snake\u306e\u57fa\u672c\u64cd\u4f5c\uff1a\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u3057\u3066\u3001\u3069\u3046\u3059\u308c\u3070\u86c7\u3092\u64cd\u4f5c\u3057\u3001\u58c1\u3084\u81ea\u5206\u81ea\u8eab\u306b\u885d\u7a81\u3057\u306a\u3044\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u521d\u5fc3\u8005\u306e\u65b9\u306b\u3068\u3063\u3066\u3001Google Snake\u3067\u306e\u86c7\u306e\u64cd\u4f5c\u306f\u6bd4\u8f03\u7684\u7c21\u5358\u3067\u3059\u3002\u30ad\u30fc\u30dc\u30fc\u30c9\u306e\u77e2\u5370\u30ad\u30fc\uff08\u4e0a\u3001\u4e0b\u3001\u5de6\u3001\u53f3\uff09\u3092\u4f7f\u7528\u3057\u3066\u3001\u86c7\u306e\u52d5\u304d\u3092\u6307\u793a\u3057\u307e\u3059\u3002\u86c7\u306f\u3001\u65b0\u3057\u3044\u77e2\u5370\u30ad\u30fc\u3092\u62bc\u3059\u307e\u3067\u3001\u9078\u629e\u3057\u305f\u65b9\u5411\u306b\u7d99\u7d9a\u7684\u306b\u79fb\u52d5\u3057\u307e\u3059\u3002\u885d\u7a81\u3092\u907f\u3051\u308b\u306b\u306f\u3001\u5e38\u306b\u6570\u624b\u5148\u307e\u3067\u884c\u52d5\u3092\u8a08\u753b\u3057\u307e\u3057\u3087\u3046\u3002\u7a7a\u9593\u628a\u63e1\u529b\u3068\u4e88\u6e2c\u304c\u91cd\u8981\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u753b\u9762\u306e\u4e0a\u306b\u5411\u304b\u3063\u3066\u4e0a\u306b\u52d5\u3044\u3066\u3044\u308b\u5834\u5408\u3001\u58c1\u306b\u3076\u3064\u304b\u3089\u306a\u3044\u3088\u3046\u306b\u3001\u8fd1\u3065\u304d\u3059\u304e\u308b\u524d\u306b\u30bf\u30fc\u30f3\u3092\u8a08\u753b\u3057\u59cb\u3081\u307e\u3057\u3087\u3046\u3002\u307e\u305a\u306f\u3001\u30af\u30e9\u30c3\u30b7\u30c3\u30af\u30e2\u30fc\u30c9\u3067\u7df4\u7fd2\u3057\u307e\u3057\u3087\u3046\uff01"}, {"question": "\u306a\u305cGoogle Snake\u306f\u3001\u6642\u3005\u30e9\u30f3\u30c0\u30e0\u306b\u901f\u5ea6\u304c\u4e0a\u304c\u308b\u3088\u3046\u306b\u898b\u3048\u308b\u306e\u3067\u3057\u3087\u3046\u304b\u3002\u305d\u3057\u3066\u3001\u3053\u306e\u901f\u5ea6\u306e\u5897\u52a0\u3092\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3057\u3087\u3046\u304b\uff1f", "answer": "Google Snake\u30b2\u30fc\u30e0\u306f\u3001\u672c\u8cea\u7684\u306b\u30e9\u30f3\u30c0\u30e0\u306b\u901f\u5ea6\u304c\u5897\u52a0\u3057\u307e\u305b\u3093\u3002\u901f\u5ea6\u306e\u5897\u52a0\u306f\u3001\u3088\u308a\u591a\u304f\u306e\u30ea\u30f3\u30b4\u3092\u98df\u3079\u3066\u3044\u308b\u305f\u3081\u3001\u86c7\u304c\u9577\u304f\u306a\u308a\u3001\u3088\u308a\u591a\u304f\u306e\u5834\u6240\u3092\u30ab\u30d0\u30fc\u3059\u308b\u305f\u3081\u3001\u7279\u5b9a\u306e\u5834\u6240\u3092\u79fb\u52d5\u3059\u308b\u306e\u306b\u308f\u305a\u304b\u306b\u6642\u9593\u304c\u304b\u304b\u3089\u306a\u3044\u305f\u3081\u3067\u3059\u3002\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3059\u308b\u65b9\u6cd5\u3092\u3054\u7d39\u4ecb\u3057\u307e\u3059\u3002\n\n\u30b9\u30c6\u30c3\u30d71\uff1a\u3088\u308a\u9577\u3044\u30eb\u30fc\u30c8\u3092\u8a08\u753b\u3059\u308b\u30003\uff5e4\u624b\u5148\u3092\u4e88\u6e2c\u3059\u308b\u3002\n\u30b9\u30c6\u30c3\u30d72\uff1a\u77ed\u3044\u30bf\u30fc\u30f3\u3092\u4f7f\u3046\u3000\u81ea\u5206\u81ea\u8eab\u3092\u9589\u3058\u8fbc\u3081\u308b\u3088\u3046\u306a\u5927\u304d\u306a\u30bf\u30fc\u30f3\u3092\u907f\u3051\u308b\u3002\n\u30b9\u30c6\u30c3\u30d73\uff1a\u914d\u7f6e\u3092\u6700\u9069\u5316\u3059\u308b\u3000\u30b9\u30da\u30fc\u30b9\u304c\u3042\u308b\u5834\u5408\u3001\u98df\u3079\u7269\u3092\u62fe\u308f\u305a\u306b\u6642\u9593\u3092\u8cb7\u3046\u305f\u3081\u306b\u5468\u308a\u3092\u56de\u308a\u3001\u86c7\u3092\u77ed\u7e2e\u3057\u3066\u6a5f\u654f\u6027\u3092\u5411\u4e0a\u3055\u305b\u308b\u3002"}, {"question": "Google Snake\u306e\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u306f\u3069\u306e\u3088\u3046\u306a\u3082\u306e\u304c\u3042\u308a\u3001\u3069\u308c\u304c\u81ea\u5206\u306e\u6311\u6226\u306b\u6700\u9069\u3067\u3059\u304b\uff1f", "answer": "Google Snake\u306f\u3001\u30af\u30e9\u30b7\u30c3\u30af\u306a\u30d8\u30d3\u30b2\u30fc\u30e0\u306e\u3044\u304f\u3064\u304b\u306e\u30d0\u30ea\u30a8\u30fc\u30b7\u30e7\u30f3\u3092\u63d0\u4f9b\u3057\u3066\u3044\u307e\u3059\u3002\u4e00\u822c\u7684\u306b\u3001\u30de\u30c3\u30d7\u306e\u30b5\u30a4\u30ba\u3092\u5909\u66f4\u3057\u305f\u308a\u3001\u30bf\u30fc\u30f3\u901f\u5ea6\u3092\u5909\u66f4\u3057\u305f\u308a\u3001\u98df\u3079\u7269\u306e\u51fa\u73fe\u983b\u5ea6\u3092\u8abf\u6574\u3057\u305f\u308a\u3059\u308b\u30aa\u30d7\u30b7\u30e7\u30f3\u304c\u898b\u3064\u304b\u308a\u307e\u3059\u3002\u305d\u308c\u305e\u308c\u306e\u86c7\u306e\u30b5\u30a4\u30ba\u3068\u901f\u5ea6\u306f\u3001\u7570\u306a\u308b\u8ab2\u984c\u3092\u793a\u3057\u3066\u3044\u307e\u3059\u3002\u672c\u5f53\u306b\u65ac\u65b0\u306a\u65b9\u6cd5\u3068\u3057\u3066\u3001\u86c7\u81ea\u8eab\u306e\u5916\u89b3\u3092\u5909\u66f4\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\n\n\u30c7\u30d5\u30a9\u30eb\u30c8\u8a2d\u5b9a\u3068\u5909\u66f4\u8a2d\u5b9a\u306e\u6bd4\u8f03\uff1a\n\u30c7\u30d5\u30a9\u30eb\u30c8\uff1a\u30af\u30e9\u30b7\u30c3\u30af\u30ec\u30c8\u30ed\u5f62\u5f0f\u3001\u6a19\u6e96\u96e3\u6613\u5ea6\n\u5909\u66f4\uff1a\u30de\u30c3\u30d7\u3092\u6700\u5c0f\u30b5\u30a4\u30ba\u306b\u5909\u66f4\u3057\u3001\u86c7\u3092\u6700\u901f\u306b\u3059\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u3001\u30b2\u30fc\u30e0\u306e\u96e3\u6613\u5ea6\u3092\u5287\u7684\u306b\u4e0a\u3052\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u6311\u6226\u306b\u6700\u9069\u3067\u3059\u3002"}, {"question": "\u30c7\u30d5\u30a9\u30eb\u30c8\u306e\u76ae\u819a\u4ee5\u5916\u306b\u3001Google Snake\u3067\u86c7\u306e\u5916\u89b3\u3092\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3059\u308b\u3053\u3068\u306f\u53ef\u80fd\u3067\u3059\u304b\uff1f\u3082\u3057\u53ef\u80fd\u306a\u3089\u3001\u3069\u306e\u3088\u3046\u306b\u5909\u66f4\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001Google Snake\u3067\u306f\u3001\u86c7\u306e\u898b\u305f\u76ee\u3001\u305d\u3057\u3066\u6642\u306b\u86c7\u304c\u98df\u3079\u308b\u98df\u3079\u7269\u306e\u898b\u305f\u76ee\u3082\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3067\u304d\u307e\u3059\uff01\u5177\u4f53\u7684\u306a\u65b9\u6cd5\u306f\u3001\u3042\u306a\u305f\u304c\u30d7\u30ec\u30a4\u3057\u3066\u3044\u308b\u30d0\u30fc\u30b8\u30e7\u30f3\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u304c\u3001\u4e00\u822c\u7684\u306b\u3001\u53f3\u4e0a\u306e3\u3064\u306e\u70b9\u306b\u79fb\u52d5\u3057\u3066\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305d\u3053\u304b\u3089\u3001\u8996\u899a\u7684\u306a\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u307e\u305f\u306f\u5916\u89b3\u306b\u95a2\u3059\u308b\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u63a2\u3057\u307e\u3059\u3002\u3055\u307e\u3056\u307e\u306a\u8272\u3001\u30d1\u30bf\u30fc\u30f3\u3001\u3055\u3089\u306b\u306f\u30db\u30ea\u30c7\u30fc\u30c6\u30fc\u30de\u306e\u76ae\u819a\u3092\u8a66\u3057\u3066\u3001\u30b2\u30fc\u30e0\u306b\u72ec\u81ea\u306e\u5916\u89b3\u3092\u4e0e\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u7279\u306b\u300e\u30ab\u30e2\u30d5\u30e9\u30fc\u30b8\u30e5\u300f\u306e\u898b\u305f\u76ee\u304c\u6c17\u306b\u5165\u3063\u3066\u3044\u307e\u3059\uff01"}, {"question": "Google Snake\u306e\u6226\u7565\uff1aGoogle Snake\u3067\u9ad8\u30b9\u30b3\u30a2\u3092\u7d99\u7d9a\u7684\u306b\u9054\u6210\u3059\u308b\u305f\u3081\u306e\u9ad8\u5ea6\u306a\u30c6\u30af\u30cb\u30c3\u30af\u306f\uff1f", "answer": "Google Snake\u3067\u9ad8\u30b9\u30b3\u30a2\u3092\u7d99\u7d9a\u7684\u306b\u9054\u6210\u3059\u308b\u306b\u306f\u3001\u57fa\u672c\u7684\u306a\u751f\u5b58\u3092\u8d85\u3048\u305f\u9ad8\u5ea6\u306a\u6226\u7565\u3092\u9069\u7528\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4ee5\u4e0b\u306b\u3001\u624b\u9806\u3092\u8aac\u660e\u3057\u307e\u3059\uff1a\n\n\u30b9\u30c6\u30c3\u30d71\uff1a\u30b3\u30fc\u30ca\u30fc\u30ea\u30f3\u30b0\u3000\u30b3\u30fc\u30ca\u30fc\u3092\u81ea\u5206\u306e\u305f\u3081\u306b\u6d3b\u7528\u3057\u3001\u58c1\u306b\u3059\u3050\u306b\u3076\u3064\u304b\u308b\u30ea\u30b9\u30af\u306a\u3057\u306b\u3001\u5b89\u5168\u306b\u4e00\u6642\u505c\u6b62\u3057\u3066\u30dc\u30fc\u30c9\u3092\u8a55\u4fa1\u3067\u304d\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002\n\u30b9\u30c6\u30c3\u30d72\uff1a\u30d1\u30b9\u6700\u9069\u5316\u3000\u7121\u99c4\u306a\u30b9\u30da\u30fc\u30b9\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u3001\u5e38\u306b\u8131\u51fa\u30eb\u30fc\u30c8\u304c\u3042\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3001\u52b9\u7387\u7684\u306b\u52d5\u304d\u3092\u8a08\u753b\u3057\u307e\u3059\u3002\n\u30b9\u30c6\u30c3\u30d73\uff1a\u81ea\u5df1\u885d\u7a81\uff08\u4e0a\u7d1a\uff09 \u5fc5\u8981\u3067\u3042\u308c\u3070\u3001\u4e00\u6642\u7684\u306b\u9577\u3055\u3092\u6e1b\u3089\u3057\u3066\u72ed\u3044\u5834\u6240\u3092\u79fb\u52d5\u3067\u304d\u308b\u3088\u3046\u306b\u3001\u81ea\u5206\u306e\u5c3e\u306e\u4e00\u90e8\u3092\u98df\u3079\u308b\u30eb\u30fc\u30d7\u3092\u4f5c\u6210\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u7dca\u6025\u6642\u306e\u307f\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "Google Snake\u306e\u4e0d\u5177\u5408\uff1aGoogle Snake\u306b\u3001\u512a\u4f4d\u6027\u3092\u7372\u5f97\u3059\u308b\u305f\u3081\u306b\u4f7f\u7528\u3067\u304d\u308b\u65e2\u77e5\u306e\u4e0d\u5177\u5408\u3084\u30a8\u30af\u30b9\u30d7\u30ed\u30a4\u30c8\u306f\u3042\u308a\u307e\u3059\u304b\uff1f\u307e\u305f\u3001\u502b\u7406\u7684\u306a\u8003\u616e\u4e8b\u9805\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Google Snake\u306f\u6bd4\u8f03\u7684\u30b7\u30f3\u30d7\u30eb\u306a\u30b2\u30fc\u30e0\u3067\u3059\u304c\u3001\u6642\u9593\u3092\u304b\u3051\u3066\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u4e0d\u5177\u5408\u3084\u30a8\u30af\u30b9\u30d7\u30ed\u30a4\u30c8\u3092\u8a18\u9332\u3057\u3066\u3044\u307e\u3059\u3002\u3057\u304b\u3057\u3001\u5177\u4f53\u7684\u306a\u5185\u5bb9\u306f\u69d8\u3005\u3067\u3059\u3002\u4f55\u3089\u304b\u306f\u3001\u58c1\u3092\u901a\u308a\u629c\u3051\u308b\u3053\u3068\u3092\u53ef\u80fd\u306b\u3059\u308b\u7279\u5b9a\u306e\u30d6\u30e9\u30a6\u30b6\u306e\u6319\u52d5\u3001\u307e\u305f\u306f\u30b2\u30fc\u30e0\u30d5\u30a1\u30a4\u30eb\u3092\u5909\u6
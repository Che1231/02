[{"question": "\uad6c\uae00 \uc2a4\ub124\uc774\ud06c \uae30\ubcf8 \uc0ac\ud56d: \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub85c\uc11c \ubc40\uc744 \uc5b4\ub5bb\uac8c \uc81c\uc5b4\ud558\uace0 \ubcbd\uc774\ub098 \uc790\uc2e0\uacfc \ubd80\ub52a\ud788\ub294 \uac83\uc744 \ud53c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ucd08\uc2ec\uc790\ub77c\uba74 \uad6c\uae00 \uc2a4\ub124\uc774\ud06c\uc5d0\uc11c \ubc40\uc744 \uc81c\uc5b4\ud558\ub294 \uac83\uc740 \ube44\uad50\uc801 \uac04\ub2e8\ud569\ub2c8\ub2e4. \ud0a4\ubcf4\ub4dc\uc758 \ud654\uc0b4\ud45c \ud0a4(\uc704, \uc544\ub798, \uc67c\ucabd, \uc624\ub978\ucabd)\ub97c \uc0ac\uc6a9\ud558\uc5ec \ubc40\uc758 \uc774\ub3d9 \ubc29\ud5a5\uc744 \uc9c0\uc815\ud569\ub2c8\ub2e4. \ubc40\uc740 \uc0c8\ub85c\uc6b4 \ud654\uc0b4\ud45c \ud0a4\ub97c \ub204\ub974\uae30 \uc804\uae4c\uc9c0 \uc120\ud0dd\ud55c \ubc29\ud5a5\uc73c\ub85c \uacc4\uc18d \uc6c0\uc9c1\uc785\ub2c8\ub2e4. \ucda9\ub3cc\uc744 \ud53c\ud558\ub824\uba74 \ud56d\uc0c1 \uba87 \ub2e8\uacc4 \uc55e\uc73c\ub85c \ud68c\uc804\uc744 \uacc4\ud68d\ud558\uc2ed\uc2dc\uc624. \uacf5\uac04 \uac10\uac01\uacfc \uc608\uce21\uc774 \uad00\uac74\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud654\uba74 \uc0c1\ub2e8\uc73c\ub85c \uc704\ucabd\uc73c\ub85c \uc774\ub3d9\ud558\ub294 \uacbd\uc6b0 \ub108\ubb34 \uac00\uae4c\uc6cc\uc9c0\uae30 \uc804\uc5d0 \ud68c\uc804 \uacc4\ud68d\uc744 \uc2dc\uc791\ud574\uc57c \ud569\ub2c8\ub2e4. \uadf8\ub807\uc9c0 \uc54a\uc73c\uba74 \ubcbd\uc5d0 \ubd80\ub52a\ud790 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc5f0\uc2b5\uc744 \uc704\ud574 \ud074\ub798\uc2dd \ubaa8\ub4dc\ub85c \uc2dc\uc791\ud558\uc138\uc694!"}, {"question": "\uad6c\uae00 \uc2a4\ub124\uc774\ud06c\uac00 \ub54c\ub54c\ub85c \ubb34\uc791\uc704\ub85c \uc18d\ub3c4\uac00 \ube68\ub77c\uc9c0\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc774 \uc18d\ub3c4 \uc99d\uac00\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uad6c\uae00 \uc2a4\ub124\uc774\ud06c \uac8c\uc784\uc740 \ubcf8\uc9c8\uc801\uc73c\ub85c \uc18d\ub3c4\uac00 \ubb34\uc791\uc704\ub85c \uc99d\uac00\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc18d\ub3c4\uac00 \ube68\ub77c\uc9c0\ub294 \uac83\ucc98\ub7fc \ubcf4\uc774\ub294 \uac83\uc740 \ub2e8\uc21c\ud788 \ub354 \ub9ce\uc740 \uc0ac\uacfc\ub97c \uba39\uae30 \ub54c\ubb38\uc774\uba70, \ub530\ub77c\uc11c \ubc40\uc774 \uae38\uc5b4\uc9c0\uace0 \ub354 \ub9ce\uc740 \uc9c0\uba74\uc744 \ucee4\ubc84\ud558\uc5ec \ud2b9\uc815 \uacf5\uac04\uc744 \uc774\ub3d9\ud558\ub294 \ub370 \uc57d\uac04\uc758 \uc2dc\uac04\uc774 \ub354 \uc9e7\uac8c \uac78\ub9b0\ub2e4\ub294 \uac83\uc785\ub2c8\ub2e4. \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \ubc29\ubc95\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4:\n\n1\ub2e8\uacc4: \ub354 \uae34 \uacbd\ub85c \uacc4\ud68d \u2013 \uc55e\uc73c\ub85c 3~4\ubc88\uc758 \uc6c0\uc9c1\uc784\uc744 \uc608\uce21\ud569\ub2c8\ub2e4.\n2\ub2e8\uacc4: \uc9e7\uc740 \ud68c\uc804 \uc0ac\uc6a9 \u2013 \uac07\ud790 \uc218 \uc788\ub294 \ud070 \ud68c\uc804\uc740 \ud53c\ud558\uc2ed\uc2dc\uc624.\n3\ub2e8\uacc4: \ubc30\uce58 \ucd5c\uc801\ud654 \u2013 \uacf5\uac04\uc774 \uc788\uc73c\uba74 \uc74c\uc2dd\uc744 \uc5bb\uc9c0 \uc54a\uace0 \"\uc2dc\uac04\uc744 \uc0ac\"\ub294 \uc6d0\uc744 \uadf8\ub824 \ubc40\uc774 \uae38\uc774\ub97c \uc904\uc5ec\uc11c \uae30\ub3d9\uc131\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uad6c\uae00 \uc2a4\ub124\uc774\ud06c\uc5d0\uc11c \ub2e4\ub978 \uac8c\uc784 \ubaa8\ub4dc\ub294 \ubb34\uc5c7\uc774\uba70, \uc790\uc2e0\uc744 \ucc4c\ub9b0\uc9c0\ud558\uae30\uc5d0 \uac00\uc7a5 \uc88b\uc740 \ubaa8\ub4dc\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uad6c\uae00 \uc2a4\ub124\uc774\ud06c\ub294 \ud074\ub798\uc2dd \uc2a4\ub124\uc774\ud06c \uac8c\uc784\uc758 \uba87 \uac00\uc9c0 \ubcc0\ud615\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc73c\ub85c \uc9c0\ub3c4 \ud06c\uae30, \ud68c\uc804 \uc18d\ub3c4 \ubc0f \uc74c\uc2dd \uc0dd\uc131 \ube48\ub3c4\ub97c \ubcc0\uacbd\ud560 \uc218 \uc788\ub294 \uc635\uc158\uc744 \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac01\uae30 \ub2e4\ub978 \ubc40\uc758 \ud06c\uae30\uc640 \uc18d\ub3c4\ub294 \ub2e4\ub978 \ucc4c\ub9b0\uc9c0\uc785\ub2c8\ub2e4. \uc644\uc804\ud788 \uc0c8\ub85c\uc6b4 \uc811\uadfc \ubc29\uc2dd\uc744 \uc704\ud574 \ubc40\uc758 \ubaa8\uc591\uc744 \ubcc0\uacbd\ud574 \ubcf4\uc138\uc694.\n\n\uae30\ubcf8 \uc124\uc815 \ub300 \uc218\uc815\ub41c \uc124\uc815 \ube44\uad50:\n\uae30\ubcf8 \uc124\uc815: \ud074\ub798\uc2dd \ub808\ud2b8\ub85c \ud615\uc2dd, \ud45c\uc900 \ub09c\uc774\ub3c4.\n\uc218\uc815\ub41c \uc124\uc815: \uc9c0\ub3c4\ub97c \uac00\uc7a5 \uc791\uc740 \ud06c\uae30\ub85c \ubcc0\uacbd\ud558\uace0 \uac00\uc7a5 \ube60\ub978 \ubc40\uc744 \uc0ac\uc6a9\ud558\uc5ec \uac8c\uc784 \ub09c\uc774\ub3c4\ub97c \uadf9\uc801\uc73c\ub85c \ub192\uc785\ub2c8\ub2e4. \uc774\uac83\uc740 \ucc4c\ub9b0\uc9c0\uc5d0 \ucd5c\uc801\uc785\ub2c8\ub2e4."}, {"question": "\uae30\ubcf8 \uc2a4\ud0a8 \uc678\uc5d0 \uad6c\uae00 \uc2a4\ub124\uc774\ud06c\uc5d0\uc11c \ubc40\uc758 \ubaa8\uc591\uc744 \uc0ac\uc6a9\uc790 \uc9c0\uc815\ud560 \uc218 \uc788\ub098\uc694? \uadf8\ub807\ub2e4\uba74 \uc5b4\ub5bb\uac8c \ubcc0\uacbd\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub124, \uad6c\uae00 \uc2a4\ub124\uc774\ud06c\ub294 \ubc40\uc758 \ubaa8\uc591\uc744 \uc0ac\uc6a9\uc790 \uc9c0\uc815\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub54c\ub85c\ub294 \ubc40\uc774 \uba39\ub294 \uc74c\uc2dd\uc758 \ubaa8\uc591\ub3c4 \ubcc0\uacbd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4! \uad6c\uccb4\uc801\uc778 \ubc29\ubc95\uc740 \ud50c\ub808\uc774\ud558\ub294 \ubc84\uc804\uc5d0 \ub530\ub77c \ub2e4\ub974\uc9c0\ub9cc, \uc77c\ubc18\uc801\uc73c\ub85c \uc624\ub978\ucabd \uc0c1\ub2e8 \ubaa8\uc11c\ub9ac\uc5d0 \uc788\ub294 \uc138 \uac1c\uc758 \uc810\uc744 \ud1b5\ud574 \uc124\uc815 \uba54\ub274\ub85c \uc774\ub3d9\ud558\uc5ec \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac70\uae30\uc5d0\uc11c \uc2dc\uac01\uc801 \uc0ac\uc6a9\uc790 \uc9c0\uc815 \ub610\ub294 \ubaa8\uc591 \uad00\ub828 \uc635\uc158\uc744 \ucc3e\uc73c\uc2ed\uc2dc\uc624. \ub2e4\uc591\ud55c \uc0c9\uc0c1, \ud328\ud134, \uc2ec\uc9c0\uc5b4 \uc5f0\ud734 \ud14c\ub9c8 \uc2a4\ud0a8\uc744 \uc0ac\uc6a9\ud558\uc5ec \uac8c\uc784\uc5d0 \ub3c5\ud2b9\ud55c \ubaa8\uc2b5\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\ud788 '\uce74\ubaa8' \ubaa8\uc591\uc744 \uc88b\uc544\ud569\ub2c8\ub2e4!"}, {"question": "\uad6c\uae00 \uc2a4\ub124\uc774\ud06c \uc804\ub7b5: \uad6c\uae00 \uc2a4\ub124\uc774\ud06c\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc9c0\uc18d\uc801\uc73c\ub85c \uc5bb\uae30 \uc704\ud55c \uace0\uae09 \uae30\uc220\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uad6c\uae00 \uc2a4\ub124\uc774\ud06c\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc9c0\uc18d\uc801\uc73c\ub85c \uc5bb\uc73c\ub824\uba74 \uae30\ubcf8\uc801\uc778 \uc0dd\uc874\uc744 \ub118\uc5b4 \uace0\uae09 \uc804\ub7b5\uc744 \uad6c\ud604\ud574\uc57c \ud569\ub2c8\ub2e4. \ub2e4\uc74c\uc740 \uc138\ubd80 \ub0b4\uc6a9\uc785\ub2c8\ub2e4.\n\n1\ub2e8\uacc4: \ucf54\ub108\ub9c1 \u2013 \ucf54\ub108\ub97c \ud65c\uc6a9\ud558\uc5ec \uc548\uc804\ud558\uac8c \uc77c\uc2dc \uc815\uc9c0\ud558\uace0 \ubcf4\ub4dc\ub97c \ud3c9\uac00\ud560 \uc218 \uc788\ub3c4\ub85d \ubcbd\uc5d0 \ub2ff\uc744 \uc704\ud5d8 \uc5c6\uc774 \ucf54\ub108\ub97c \ud65c\uc6a9\ud569\ub2c8\ub2e4.\n2\ub2e8\uacc4: \uacbd\ub85c \ucd5c\uc801\ud654 \u2013 \uc774\ub3d9\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uacc4\ud68d\ud558\uc5ec \ub0ad\ube44\ub41c \uacf5\uac04\uc744 \ucd5c\uc18c\ud654\ud558\uace0 \ud56d\uc0c1 \ud0c8\ucd9c \uacbd\ub85c\uac00 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4.\n3\ub2e8\uacc4: \uc790\uac00 \uc12d\ucde8 (\uace0\uae09) \u2013 \ud544\uc694\ud55c \uacbd\uc6b0 \uaf2c\ub9ac \uc77c\ubd80\ub97c \uc784\uc2dc\ub85c \uc904\uc5ec \uc881\uc740 \uacf5\uac04\uc744 \uc774\ub3d9\ud560 \uc218 \uc788\ub3c4\ub85d \ubab8\ud1b5\uc744 \ud718\uac10\ub294 \ub8e8\ud504\ub97c \ub9cc\ub4ed\ub2c8\ub2e4. \uc774\ub294 \uae34\uae09 \uc0c1\ud669\uc5d0\uc11c\ub9cc \uc0ac\uc6a9\ud574\uc57c \ud569\ub2c8\ub2e4."}, {"question": "\uad6c\uae00 \uc2a4\ub124\uc774\ud06c \ubc84\uadf8: \uad6c\uae00 \uc2a4\ub124\uc774\ud06c\uc5d0 \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\ub294 \uc54c\ub824\uc9c4 \ubc84\uadf8\ub098 \uc545\uc6a9 \uc0ac\ub840\uac00 \uc788\ub098\uc694? \uc724\ub9ac\uc801 \uace0\ub824 \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uad6c\uae00 \uc2a4\ub124\uc774\ud06c\ub294 \ube44\uad50\uc801 \uac04\ub2e8\ud55c \uac8c\uc784\uc774\uc9c0\ub9cc, \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\uac00 \uc2dc\uac04\uc774 \uc9c0\ub0a8\uc5d0 \ub530\ub77c \ubc84\uadf8 \ub610\ub294 \uc545\uc6a9 \uc0ac\ub840\ub97c \ubb38\uc11c\ud654\ud588\uc2b5\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \uad6c\uccb4\uc801\uc778 \ub0b4\uc6a9\uc740 \ub2e4\ub985\ub2c8\ub2e4. \uc77c\ubd80\ub294 \ubcbd\uc744 \ud1b5\uacfc\ud560 \uc218 \uc788\ub3c4\ub85d \ud558\ub294 \ud2b9\uc815 \ube0c\ub77c\uc6b0\uc800 \ub3d9\uc791\uc774\ub098 \uac8c\uc784 \ud30c\uc77c\uc744 \ubcc0\uacbd\ud558\uc5ec \uc77c\ubd80 \uc694\uc18c\ub97c \uc81c\uac70\ud558\ub294 \uac83\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \uba85\ud655\ud788 \ud558\uc790\uba74, \uac8c\uc784 \ud30c\uc77c\uc744 \ubcc0\uacbd\ud558\ub294 \uac83\uc740 \uc885\uc885 \ube44\uc724\ub9ac\uc801\uc774\uba70 \uc11c\ube44\uc2a4 \uc57d\uad00 \uc704\ubc18\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uacbd\uc7c1 \ud50c\ub808\uc774 \uc2dc \ucee4\ubba4\ub2c8\ud2f0 \uaddc\uce59\uc774\ub098 \ub2e8\ub3c5 \ud50c\ub808\uc774 \ubaa8\ub4dc\uc758 \uac1c\uc778\uc801\uc778 \uc120\ud638\ub3c4\uc5d0 \ub530\ub77c \ud5c8\uc6a9 \uc5ec\ubd80\uac00 \uacb0\uc815\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubcbd\uc744 \ud1b5\uacfc\ud558\ub294 \ud074\ub9ac\ud551\uc740 \uc7a0\uc7ac\uc801\uc778 \uc724\ub9ac\uc801 \ube44\uc6a9\uc73c\ub85c \uc774\uc810\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}, {"question": "\uad6c\uae00 \uc2a4\ub124\uc774\ud06c \ubd84\uc11d: \uad6c\uae00 \uc2a4\ub124\uc774\ud06c\uc5d0\uc11c \uc0ac\uacfc \uc0dd\uc131\uc744 \uacb0\uc815\ud558\ub294 \uae30\ubcf8 \uc54c\uace0\ub9ac\uc998\uc740 \ubb34\uc5c7\uc774\uba70, \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "\uad6c\uae00 \uc2a4\ub124\uc774\ud06c\uc5d0\uc11c \uc0ac\uacfc \uc0dd\uc131\uc744 \uc704\ud55c \uae30\ubcf8 \uc54c\uace0\ub9ac\uc998\uc740 \uacf5\uc815\ud55c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ubcf4\uc7a5\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc0ac\uacfc\ub294 \ubc40 \uc790\uccb4\uc5d0 \uc0dd\uc131\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc73c\ub85c \ubb34\uc791\uc704 \uc704\uce58\uc5d0 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \uac8c\uc784\uc774 \uc9c4\ud589\ub428\uc5d0 \ub530\ub77c \ubc40\uc774 \uc0ac\uc6a9 \uac00\ub2a5\ud55c \uacf5\uac04\uc744 \ub354 \ub9ce\uc774 \ucc28\uc9c0\ud569\ub2c8\ub2e4. \uc77c\ubd80 \ucf54\ub4dc\uc5d0\uc11c \uc54c\uace0\ub9ac\uc998\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \ubc18\uc751\ud560 \uc218 \uc788\ub3c4\ub85d \ubc40\uc758 \uba38\ub9ac\uc5d0 \ub108\ubb34 \uac00\uae4c\uc774 \uc0dd\uc131\ub418\uc9c0 \uc54a\ub3c4\ub85d \ud569\ub2c8\ub2e4. \ubd84\uc11d\uc801\uc73c\ub85c \ub9d0\ud558\uba74, \uc54c\uace0\ub9ac\uc998\uc740 \ubc40\uc758 \ud604\uc7ac \uc704\uce58\uc640 \ubb34\uc791\uc704 (x, y) \uc88c\ud45c\ub97c \uc0dd\uc131\ud574\uc57c \ud569\ub2c8\ub2e4."}, {"question": "\uad6c\uae00 \uc2a4\ub124\uc774\ud06c \uc81c\ud55c \uc0ac\ud56d: \ub2e4\ub978 \uae30\uae30\uc5d0\uc11c \uc131\ub2a5\uc5d0 \uc601\ud5a5\uc744 \uc904 \uc218 \uc788\ub294 \uad6c\uae00 \uc2a4\ub124\uc774\ud06c\uc758 \uae30\uc220\uc801 \uc81c\ud55c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uad6c\uae00 \uc2a4\ub124\uc774\ud06c\ub294 \uc6f9 \ube0c\ub77c\uc6b0\uc800 \ub610\ub294 \ubaa8\ubc14\uc77c \uc571\uc5d0\uc11c \uc2e4\ud589\ub418\ubbc0\ub85c \uc21c\uc804\ud788 \uae30\uc220\uc801\uc778 \uad00\uc810\uc5d0\uc11c \ud2b9\uc815 \uc81c\ud55c \uc0ac\ud56d\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\uc804 \uae30\uae30\ub294 JavaScript\ub97c \ube60\ub974\uac8c \ucc98\ub9ac\ud558\ub294 \ub370 \uc5b4\ub824\uc6c0\uc744 \uacaa\uc744 \uc218 \uc788\uc73c\uba70, \ud2b9\ud788 \ubc40\uc774 \uae38\uc5b4\uc9c8\uc218\ub85d \uac8c\uc784\uc774 \uc9c0\uc5f0\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ube0c\ub77c\uc6b0\uc800 \uba54\ubaa8\ub9ac \uc81c\ud55c\uc73c\ub85c \uc778\ud574 \ubc40\uc774 \uacfc\ub3c4\ud558\uac8c \uae38\uc5b4\uc9c0\uba74(\uc608: \ud654\uba74\uc758 \ub300\ubd80\ubd84\uc744 \ucc44\uc6b0\ub294 \uacbd\uc6b0) \ucda9\ub3cc\uc774 \ubc1c\uc0dd\ud560 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac15\ub825\ud55c \ud604\ub300 \uac8c\uc774\ubc0d \ub178\ud2b8\ubd81\uc740 \uc774\uc804 \ud0dc\ube14\ub9bf\ubcf4\ub2e4 \ub9e4\uc6b0 \ud070 \ubc40\uc744 \ucc98\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uad6c\uae00 \uc2a4\ub124\uc774\ud06c \uc774\uc2dd\uc131: \uad6c\uae00 \uc2a4\ub124\uc774\ud06c \uc9c4\ud589 \uc0c1\ud669 \ub610\ub294 \uc124\uc815\uc744 \uc6f9 \ube0c\ub77c\uc6b0\uc800\uc640 \ubaa8\ubc14\uc77c \uc571 \ubc84\uc804 \uc0ac\uc774\uc5d0\uc11c \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694? \uadf8\ub807\ub2e4\uba74 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ubd88\ud589\ud788\ub3c4 \uad6c\uae00 \uc2a4\ub124\uc774\ud06c \uc9c4\ud589 \uc0c1\ud669\uacfc \uc124\uc815\uc740 \uc6f9 \ube0c\ub77c\uc6b0\uc800\uc640 \uc571 \ubc84\uc804 \uac04\uc5d0 \uc9c1\uc811 \uc804\uc1a1\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uac01 \ubc84\uc804\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \ub85c\uceec\uc5d0 \ub370\uc774\ud130\ub97c \uc800\uc7a5\ud558\ubbc0\ub85c, \uace0\ub4dd\uc810\uacfc \uc0ac\uc6a9\uc790 \uc9c0\uc815\uc740 \ud50c\ub808\uc774\ud558\ub294 \ud50c\ub7ab\ud3fc\uc5d0 \ud2b9\uc815\ud558\uba70, \ube0c\ub77c\uc6b0\uc800 \uc124\uc815\uc774\ub098 \uce90\uc2dc\ub97c \uc9c0\uc6b0\uac70\ub098 \uc571\uc744 \uc81c\uac70\ud558\uba74 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc190\uc2e4\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc6f9 \ube0c\ub77c\uc6b0\uc800 \ubc84\uc804\uc5d0\uc11c 500\uc810\uc758 \ub192\uc740 \uc810\uc218\ub97c \ub2ec\uc131\ud55c \uacbd\uc6b0, \uc774 \uc810\uc218\ub294 \uc77c\ubc18\uc801\uc73c\ub85c \ubaa8\ubc14\uc77c \uc571\uc5d0 \ubc18\uc601\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc77c\ubd80 \ud604\ub300 \ud50c\ub7ab\ud3fc\uc5d0\uc11c\ub294 \uacc4\uc815 \ubc31\uc5c5\uc744 \ud1b5\ud574 \uc571 \ub370\uc774\ud130\ub97c \uc218\ub3d9 \ub610\ub294 \uc790\ub3d9\uc73c\ub85c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uad6c\uae00 \uc2a4\ub124\uc774\ud06c \ud0d0\uad6c: \ub300\ubd80\ubd84\uc758 \ud50c\ub808\uc774\uc5b4\uac00 \ubaa8\ub974\ub294 \uad6c\uae00 \uc2a4\ub124\uc774\ud06c \ub0b4\uc758 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8 \ub610\ub294 \ube44\ubc00 \uae30\ub2a5\uc774 \uc788\ub098\uc694? \uc5b4\ub5bb\uac8c \ud65c\uc131\ud654\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uad6c\uae00 \uc2a4\ub124\uc774\ud06c\uc5d0\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uc640 \ube44\ubc00 \uae30\ub2a5\uc774 \uba87 \uac00\uc9c0 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \ube44\ubc00\uc744 \ud65c\uc131\ud654\ud558\ub824\uba74 \uc885\uc885 \uac8c\uc784 \ud50c\ub808\uc774 \uc911\uc5d0 \ud2b9\uc815 \ud0a4 \uc870\ud569\uc774\ub098 \uc791\uc5c5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc778 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ub2e4\ub978 \uc9c0\ub3c4 \uc2a4\ud0c0\uc77c\uc774\ub098 \ud14c\ub9c8\ub97c \uc7a0\uae08 \ud574\uc81c\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc774 \uc791\uc5c5\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \ud654\uba74\uc758 \ud2b9\uc815 \ubd80\ubd84\uc744 \ud2b9\uc815 \ud69f\uc218\ub9cc\ud07c \ud0ed\ud558\uc5ec \ud2b9\uc218 \uce58\ud2b8 \ucf54\ub4dc\ub97c \uc785\ub825\ud558\ub294 \uac83\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc778 \uc608\ub294 \ucd94\uac00 \uc0ac\uc6a9\uc790 \uc9c0\uc815\uc744 \uc704\ud574 Konami \ucf54\ub4dc\ub97c \uc785\ub825\ud558\ub294 \uac83\uc785\ub2c8\ub2e4."}]
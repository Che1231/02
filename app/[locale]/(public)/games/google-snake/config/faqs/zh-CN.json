[{"question": "\u8c37\u6b4c\u8d2a\u5403\u86c7\u57fa\u7840\uff1a\u4f5c\u4e3a\u65b0\u73a9\u5bb6\uff0c\u6211\u8be5\u5982\u4f55\u63a7\u5236\u86c7\u5e76\u907f\u514d\u649e\u5230\u5899\u58c1\u6216\u81ea\u5df1\uff1f", "answer": "\u5bf9\u4e8e\u521d\u5b66\u8005\u6765\u8bf4\uff0c\u5728\u8c37\u6b4c\u8d2a\u5403\u86c7\u4e2d\u63a7\u5236\u86c7\u76f8\u5f53\u7b80\u5355\u3002\u4f7f\u7528\u952e\u76d8\u4e0a\u7684\u7bad\u5934\u952e\uff08\u4e0a\u3001\u4e0b\u3001\u5de6\u3001\u53f3\uff09\u6765\u63a7\u5236\u86c7\u7684\u79fb\u52a8\u3002\u86c7\u5c06\u6301\u7eed\u671d\u9009\u5b9a\u7684\u65b9\u5411\u79fb\u52a8\uff0c\u76f4\u5230\u4f60\u6309\u4e0b\u65b0\u7684\u7bad\u5934\u952e\u3002\u4e3a\u4e86\u907f\u514d\u78b0\u649e\uff0c\u8bf7\u63d0\u524d\u51e0\u6b65\u89c4\u5212\u4f60\u7684\u8f6c\u5411\u3002\u5173\u952e\u5728\u4e8e\u7a7a\u95f4\u610f\u8bc6\u548c\u9884\u671f\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5411\u4e0a\u79fb\u52a8\u671d\u5411\u5c4f\u5e55\u9876\u90e8\uff0c\u8bf7\u5728\u8ddd\u79bb\u9876\u90e8\u592a\u8fd1\u4e4b\u524d\u5f00\u59cb\u89c4\u5212\u8f6c\u5411\uff1b\u5426\u5219\uff0c\u4f60\u53ef\u80fd\u4f1a\u649e\u5230\u5899\u58c1\u3002\u5148\u4ece\u7ecf\u5178\u6a21\u5f0f\u7ec3\u4e60\u5f00\u59cb\uff01"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u7684\u8c37\u6b4c\u8d2a\u5403\u86c7\u6709\u65f6\u4f1a\u968f\u673a\u52a0\u901f\uff0c\u6211\u8be5\u5982\u4f55\u6709\u6548\u5730\u63a7\u5236\u8fd9\u79cd\u52a0\u901f\uff1f", "answer": "\u8c37\u6b4c\u8d2a\u5403\u86c7\u6e38\u620f\u672c\u8eab\u4e0d\u4f1a\u968f\u673a\u589e\u52a0\u901f\u5ea6\u3002\u4efb\u4f55\u660e\u663e\u7684\u52a0\u901f\u90fd\u4ec5\u4ec5\u662f\u56e0\u4e3a\u4f60\u5403\u4e86\u66f4\u591a\u7684\u82f9\u679c\uff0c\u56e0\u6b64\u4f60\u7684\u86c7\u53d8\u5f97\u66f4\u957f\uff0c\u8986\u76d6\u7684\u8303\u56f4\u66f4\u5e7f\uff0c\u56e0\u6b64\u5728\u7279\u5b9a\u7a7a\u95f4\u5185\u82b1\u8d39\u7684\u65f6\u95f4\u7565\u5fae\u66f4\u5c11\u3002\u4ee5\u4e0b\u662f\u6709\u6548\u63a7\u5236\u5b83\u7684\u65b9\u6cd5\uff1a\n\n\u6b65\u9aa4 1\uff1a\u89c4\u5212\u66f4\u957f\u7684\u8def\u7ebf\u2014\u2014\u9884\u6d4b\u4f60\u5c06\u63d0\u524d\u4e09\u6216\u56db\u6b65\u7684\u4f4d\u7f6e\u3002\n\u6b65\u9aa4 2\uff1a\u4f7f\u7528\u77ed\u8f6c\u5f2f\u2014\u2014\u907f\u514d\u53ef\u80fd\u5c06\u4f60\u56f0\u4f4f\u7684\u5927\u5e45\u5ea6\u8f6c\u5f2f\u3002\n\u6b65\u9aa4 3\uff1a\u4f18\u5316\u653e\u7f6e\u2014\u2014\u5982\u679c\u4f60\u6709\u7a7a\u95f4\uff0c\u7ed5\u5708\u8d70\u4ee5\u2018\u8d2d\u4e70\u2019\u65f6\u95f4\u800c\u4e0d\u62fe\u53d6\u98df\u7269\uff0c\u8ba9\u86c7\u53d8\u77ed\uff0c\u4ee5\u63d0\u9ad8\u673a\u52a8\u6027\u3002"}, {"question": "\u8c37\u6b4c\u8d2a\u5403\u86c7\u6709\u54ea\u4e9b\u4e0d\u540c\u7684\u6e38\u620f\u6a21\u5f0f\uff0c\u54ea\u79cd\u6a21\u5f0f\u6700\u9002\u5408\u6311\u6218\u81ea\u5df1\uff1f", "answer": "\u8c37\u6b4c\u8d2a\u5403\u86c7\u63d0\u4f9b\u4e86\u4e00\u4e9b\u7ecf\u5178\u8d2a\u5403\u86c7\u6e38\u620f\u7684\u53d8\u4f53\u3002\u4f60\u901a\u5e38\u53ef\u4ee5\u627e\u5230\u9009\u9879\u6765\u66f4\u6539\u5730\u56fe\u5927\u5c0f\u3001\u8f6c\u5411\u901f\u5ea6\u548c\u8c03\u6574\u98df\u7269\u751f\u6210\u9891\u7387\u7b49\u3002\u6bcf\u6761\u4e0d\u540c\u5927\u5c0f\u548c\u901f\u5ea6\u7684\u86c7\u90fd\u5e26\u6765\u4e0d\u540c\u7684\u6311\u6218\u3002\u4e3a\u4e86\u83b7\u5f97\u771f\u6b63\u65b0\u9896\u7684\u65b9\u6cd5\uff0c\u5c1d\u8bd5\u66f4\u6539\u86c7\u7684\u5916\u89c2\u3002\n\n\u6bd4\u8f83\u9ed8\u8ba4\u8bbe\u7f6e\u4e0e\u4fee\u6539\u540e\u7684\u8bbe\u7f6e\uff1a\n\u9ed8\u8ba4\uff1a\u7ecf\u5178\u590d\u53e4\u683c\u5f0f\uff0c\u6807\u51c6\u96be\u5ea6\u3002\n\u4fee\u6539\uff1a\u5c06\u5730\u56fe\u66f4\u6539\u4e3a\u6700\u5c0f\u5c3a\u5bf8\uff0c\u5e76\u4f7f\u86c7\u7684\u901f\u5ea6\u6700\u5feb\uff0c\u8fd9\u6781\u5927\u5730\u589e\u52a0\u4e86\u6e38\u620f\u96be\u5ea6\u3002\u8fd9\u5bf9\u6311\u6218\u6765\u8bf4\u662f\u6700\u4f73\u9009\u62e9\u3002"}, {"question": "\u9664\u4e86\u9ed8\u8ba4\u76ae\u80a4\u5916\uff0c\u662f\u5426\u53ef\u4ee5\u81ea\u5b9a\u4e49\u8c37\u6b4c\u8d2a\u5403\u86c7\u4e2d\u86c7\u7684\u5916\u89c2\uff0c\u5982\u679c\u662f\uff0c\u6211\u8be5\u5982\u4f55\u66f4\u6539\uff1f", "answer": "\u662f\u7684\uff0c\u8c37\u6b4c\u8d2a\u5403\u86c7\u5141\u8bb8\u4f60\u81ea\u5b9a\u4e49\u4f60\u7684\u86c7\u7684\u5916\u89c2\uff0c\u6709\u65f6\uff0c\u8fd8\u53ef\u4ee5\u81ea\u5b9a\u4e49\u5b83\u5403\u6389\u7684\u98df\u7269\uff01\u5177\u4f53\u65b9\u6cd5\u53d6\u51b3\u4e8e\u4f60\u6b63\u5728\u73a9\u54ea\u4e2a\u7248\u672c\uff0c\u4f46\u901a\u5e38\u53ef\u4ee5\u5728\u53f3\u4e0a\u89d2\u7684\u4e09\u4e2a\u70b9\u4e2d\u627e\u5230\u8bbe\u7f6e\u83dc\u5355\u3002\u4ece\u90a3\u91cc\uff0c\u67e5\u627e\u4e0e\u89c6\u89c9\u81ea\u5b9a\u4e49\u6216\u5916\u89c2\u76f8\u5173\u7684\u9009\u9879\u3002\u4f60\u53ef\u4ee5\u5c1d\u8bd5\u4e0d\u540c\u7684\u989c\u8272\u3001\u56fe\u6848\uff0c\u751a\u81f3\u8282\u5047\u65e5\u4e3b\u9898\u76ae\u80a4\uff0c\u8ba9\u4f60\u7684\u6e38\u620f\u770b\u8d77\u6765\u72ec\u7279\u3002\u6211\u5c24\u5176\u559c\u6b22'\u4f2a\u88c5'\u5916\u89c2\uff01"}, {"question": "\u8c37\u6b4c\u8d2a\u5403\u86c7\u7b56\u7565\uff1a\u5728\u8c37\u6b4c\u8d2a\u5403\u86c7\u4e2d\u6301\u7eed\u83b7\u5f97\u9ad8\u5206\u7684\u4e00\u4e9b\u9ad8\u7ea7\u6280\u5de7\u6709\u54ea\u4e9b\uff1f", "answer": "\u4e3a\u4e86\u5728\u8c37\u6b4c\u8d2a\u5403\u86c7\u4e2d\u6301\u7eed\u83b7\u5f97\u9ad8\u5206\uff0c\u4f60\u9700\u8981\u5b9e\u65bd\u8d85\u8d8a\u57fa\u672c\u751f\u5b58\u7b56\u7565\u7684\u5148\u8fdb\u7b56\u7565\u3002\u4ee5\u4e0b\u662f\u5206\u89e3\uff1a\n\n\u6b65\u9aa4 1\uff1a\u89d2\u843d\u5229\u7528\u2014\u2014\u5229\u7528\u89d2\u843d\u6765\u4f60\u7684\u4f18\u52bf\uff0c\u8ba9\u4f60\u80fd\u591f\u5b89\u5168\u5730\u6682\u505c\u5e76\u8bc4\u4f30\u68cb\u76d8\uff0c\u800c\u65e0\u9700\u7acb\u5373\u649e\u5230\u5899\u58c1\u3002\n\u6b65\u9aa4 2\uff1a\u8def\u5f84\u4f18\u5316\u2014\u2014\u6709\u6548\u5730\u89c4\u5212\u4f60\u7684\u79fb\u52a8\uff0c\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u6d6a\u8d39\u7684\u7a7a\u95f4\uff0c\u5e76\u786e\u4fdd\u4f60\u59cb\u7ec8\u62e5\u6709\u9003\u751f\u8def\u7ebf\u3002\n\u6b65\u9aa4 3\uff1a\u81ea\u6211\u541e\u566c\uff08\u9ad8\u7ea7\uff09\u2014\u2014\u5982\u6709\u5fc5\u8981\uff0c\u521b\u5efa\u5141\u8bb8\u4f60\u5403\u6389\u81ea\u5df1\u4e00\u90e8\u5206\u5c3e\u5df4\u7684\u5faa\u73af\uff0c\u6682\u65f6\u51cf\u5c11\u4f60\u7684\u957f\u5ea6\u6765\u5e94\u5bf9\u72ed\u7a84\u7684\u7a7a\u95f4\u3002\u8fd9\u5e94\u8be5\u4ec5\u5728\u7d27\u6025\u60c5\u51b5\u4e0b\u4f7f\u7528\u3002"}, {"question": "\u8c37\u6b4c\u8d2a\u5403\u86c7\u9519\u8bef\uff1a\u8c37\u6b4c\u8d2a\u5403\u86c7\u4e2d\u662f\u5426\u5b58\u5728\u4efb\u4f55\u5df2\u77e5\u7684\u9519\u8bef\u6216\u6f0f\u6d1e\uff0c\u53ef\u4ee5\u7528\u6765\u83b7\u5f97\u4f18\u52bf\uff0c\u4ee5\u53ca\u76f8\u5173\u7684\u4f26\u7406\u95ee\u9898\u662f\u4ec0\u4e48\uff1f", "answer": "\u867d\u7136\u8c37\u6b4c\u8d2a\u5403\u86c7\u662f\u4e00\u4e2a\u76f8\u5bf9\u7b80\u5355\u7684\u6e38\u620f\uff0c\u4f46\u4e00\u4e9b\u73a9\u5bb6\u968f\u7740\u65f6\u95f4\u7684\u63a8\u79fb\u8bb0\u5f55\u4e86\u9519\u8bef\u6216\u6f0f\u6d1e\u3002\u7136\u800c\uff0c\u5177\u4f53\u60c5\u51b5\u5404\u6709\u4e0d\u540c\u3002\u4e00\u4e9b\u9519\u8bef\u6d89\u53ca\u7279\u5b9a\u6d4f\u89c8\u5668\u7684\u884c\u4e3a\uff0c\u5141\u8bb8\u7a7f\u5899\u800c\u8fc7\uff0c\u6216\u8005\u901a\u8fc7\u66f4\u6539\u6e38\u620f\u6587\u4ef6\u6765\u79fb\u9664\u67d0\u4e9b\u5143\u7d20\u3002\u660e\u786e\u5730\u8bf4\uff0c\u4fee\u6539\u6e38\u620f\u6587\u4ef6\u901a\u5e38\u662f\u4e0d\u9053\u5fb7\u7684\uff0c\u800c\u4e14\u53ef\u80fd\u8fdd\u53cd\u670d\u52a1\u6761\u6b3e\u6216\u6e38\u620f\u89c4\u5219\u3002\u5b83\u662f\u5426\u53ef\u63a5\u53d7\u53d6\u51b3\u4e8e\u4f60\u5728\u7ade\u4e89\u6027\u6e38\u620f\u4e2d\u7684\u793e\u533a\u89c4\u5219\uff0c\u6216\u5355\u4eba\u6e38\u620f\u6a21\u5f0f\u4e0b\u7684\u4e2a\u4eba\u559c\u597d\u3002\u4f8b\u5982\uff0c\u7a7f\u5899\u800c\u8fc7\u5728\u7279\u5b9a\u60c5\u51b5\u4e0b\u4f1a\u4ea7\u751f\u4f18\u52bf\uff0c\u4f46\u6f5c\u5728\u7684\u9053\u5fb7\u6210\u672c\u4f9d\u7136\u5b58\u5728\u3002"}, {"question": "\u5206\u6790\u8c37\u6b4c\u8d2a\u5403\u86c7\uff1a\u51b3\u5b9a\u8c37\u6b4c\u8d2a\u5403\u86c7\u4e2d\u82f9\u679c\u751f\u6210\u7684\u5e95\u5c42\u7b97\u6cd5\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\uff1f", "answer": "\u8c37\u6b4c\u8d2a\u5403\u86c7\u4e2d\u82f9\u679c\u751f\u6210\u7684\u57fa\u672c\u7b97\u6cd5\u65e8\u5728\u786e\u4fdd\u516c\u5e73\u7684\u6e38\u620f\u3002\u82f9\u679c\u4e0d\u4f1a\u51fa\u73b0\u5728\u86c7\u8eab\u4e0a\u3002\u5b83\u901a\u5e38\u4f1a\u51fa\u73b0\u5728\u968f\u673a\u4f4d\u7f6e\u3002\u968f\u7740\u6e38\u620f\u7684\u8fdb\u884c\uff0c\u86c7\u5c06\u5360\u636e\u66f4\u591a\u7684\u53ef\u7528\u7a7a\u95f4\u3002\u5728\u67d0\u4e9b\u4ee3\u7801\u4e2d\uff0c\u8be5\u7b97\u6cd5\u907f\u514d\u5c06\u82f9\u679c\u751f\u6210\u5728\u86c7\u7684\u5934\u90e8\u9644\u8fd1\uff0c\u4ee5\u4fbf\u73a9\u5bb6\u6709\u673a\u4f1a\u505a\u51fa\u53cd\u5e94\u3002\u4ece\u5206\u6790\u7684\u89d2\u5ea6\u6765\u770b\uff0c\u8be5\u7b97\u6cd5\u5fc5\u987b\u68c0\u67e5\u86c7\u7684\u5f53\u524d\u4f4d\u7f6e\u5e76\u751f\u6210\u968f\u673a (x, y) \u5750\u6807\u3002"}, {"question": "\u8c37\u6b4c\u8d2a\u5403\u86c7\u7684\u5c40\u9650\u6027\uff1a\u8c37\u6b4c\u8d2a\u5403\u86c7\u5728\u4e0d\u540c\u8bbe\u5907\u4e0a\u7684\u6027\u80fd\u53ef\u80fd\u53d7\u5230\u54ea\u4e9b\u6280\u672f\u9650\u5236\uff1f", "answer": "\u8c37\u6b4c\u8d2a\u5403\u86c7\u8fd0\u884c\u5728\u7f51\u9875\u6d4f\u89c8\u5668\u6216\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u4e2d\uff0c\u8fd9\u4ece\u7eaf\u7cb9\u7684\u6280\u672f\u89d2\u5ea6\u6765\u770b\u5f15\u5165\u4e86\u7279\u5b9a\u7684\u5c40\u9650\u6027\u3002\u8f83\u65e7\u7684\u8bbe\u5907\u53ef\u80fd\u96be\u4ee5\u5feb\u901f\u5904\u7406 JavaScript\uff0c\u5bfc\u81f4\u6e38\u620f\u5ef6\u8fdf\uff0c\u5c24\u5176\u662f\u5728\u86c7\u53d8\u957f\u65f6\u3002\u6d4f\u89c8\u5668\u5185\u5b58\u9650\u5236\u4e5f\u53ef\u80fd\u5bfc\u81f4\u5728\u86c7\u8fc7\u957f\u7684\u60c5\u51b5\u4e0b\u53d1\u751f\u5d29\u6e83\uff08\u4f8b\u5982\uff0c\u4f60\u586b\u6ee1\u5927\u90e8\u5206\u5c4f\u5e55\uff09\u3002\u4f8b\u5982\uff0c\u4e00\u53f0\u529f\u80fd\u5f3a\u5927\u7684\u73b0\u4ee3\u6e38\u620f\u7b14\u8bb0\u672c\u7535\u8111\u53ef\u4ee5\u5904\u7406\u6bd4\u65e7\u5e73\u677f\u7535\u8111\u66f4\u5927\u7684\u86c7\u3002"}, {"question": "\u8c37\u6b4c\u8d2a\u5403\u86c7\u7684\u53ef\u79fb\u690d\u6027\uff1a\u8c37\u6b4c\u8d2a\u5403\u86c7\u7684\u8fdb\u5ea6\u6216\u8bbe\u7f6e\u80fd\u5426\u5728\u7f51\u9875\u6d4f\u89c8\u5668\u7248\u548c\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u7248\u4e4b\u95f4\u8f6c\u79fb\uff1f\u5982\u679c\u53ef\u4ee5\uff0c\u5982\u4f55\u8f6c\u79fb\uff1f", "answer": "\u4e0d\u5e78\u7684\u662f\uff0c\u8c37\u6b4c\u8d2a\u5403\u86c7\u7684\u8fdb\u5ea6\u548c\u8bbe\u7f6e\u5e76\u672a\u8bbe\u8ba1\u4e3a\u53ef\u4ee5\u76f4\u63a5\u5728\u7f51\u9875\u6d4f\u89c8\u5668\u7248\u548c\u5e94\u7528\u7a0b\u5e8f\u7248\u4e4b\u95f4\u8f6c\u79fb\u3002\u6bcf\u4e2a\u7248\u672c\u901a\u5e38\u4f1a\u672c\u5730\u5b58\u50a8\u6570\u636e\uff0c\u8fd9\u610f\u5473\u7740\u4f60\u7684\u9ad8\u5206\u548c\u81ea\u5b9a\u4e49\u5185\u5bb9\u7279\u5b9a\u4e8e\u4f60\u6b63\u5728\u4f7f\u7528\u7684\u5e73\u53f0\uff0c\u5982\u679c\u6e05\u9664\u6d4f\u89c8\u5668\u8bbe\u7f6e\u6216\u7f13\u5b58\u6216\u5378\u8f7d\u5e94\u7528\u7a0b\u5e8f\uff0c\u4efb\u4f55\u8fdb\u5ea6\u90fd\u5c06\u4e22\u5931\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u7f51\u9875\u6d4f\u89c8\u5668\u7248\u672c\u4e2d\u83b7\u5f97 500 \u5206\u7684\u9ad8\u5206\uff0c\u8fd9\u4e2a\u5206\u6570\u901a\u5e38\u4e0d\u4f1a\u53cd\u6620\u5728\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u4e2d\u3002\u4e00\u4e9b\u73b0\u4ee3\u5e73\u53f0\u5141\u8bb8\u901a\u8fc7\u5e10\u6237\u5907\u4efd\u624b\u52a8\u6216\u81ea\u52a8\u8f6c\u79fb\u5e94\u7528\u7a0b\u5e8f\u6570\u636e\u3002"}, {"question": "\u6df1\u5165\u7814\u7a76\u8c37\u6b4c\u8d2a\u5403\u86c7\uff1a\u8c37\u6b4c\u8d2a\u5403\u86c7\u4e2d\u662f\u5426\u5b58\u5728\u4efb\u4f55\u5927\u591a\u6570\u73a9\u5bb6\u90fd\u4e0d\u77e5\u9053\u7684\u9690\u85cf\u5f69\u86cb\u6216\u79d8\u5bc6\u529f\u80fd\uff0c\u4ee5\u53ca\u5982\u4f55\u6fc0\u6d3b\u5b83\u4eec\uff1f", "answer": "\u8c37\u6b4c\u8d2a\u5403\u86c7\u6709\u4e00\u4e9b\u9690\u85cf\u7684\u5f69\u86cb\u548c\u79d8\u5bc6\u529f\u80fd\u3002\u6fc0\u6d3b\u8fd9\u4e9b\u79d8\u5bc6\u901a\u5e38\u9700\u8981\u6267\u884c\u7279\u5b9a\u6309\u952e\u7ec4\u5408\u6216\u5728\u6e38\u620f\u8fc7\u7a0b\u4e2d\u6267\u884c\u7279\u5b9a\u64cd\u4f5c\u3002\u4e00\u79cd\u5e38\u89c1\u7684\u5f69\u86cb\u662f\u89e3\u9501\u4e0d\u540c\u7684\u5730\u56fe\u6837\u5f0f\u6216\u4e3b\u9898\u3002\u8fd9\u901a\u5e38\u6d89\u53ca\u901a\u8fc7\u70b9\u51fb\u5c4f\u5e55\u7684\u7279\u5b9a\u90e8\u5206\u4e00\u5b9a\u6b21\u6570\u6765\u8f93\u5165\u7279\u6b8a\u7684\u4f5c\u5f0a\u4ee3\u7801\u3002\u4e00\u4e2a\u5178\u578b\u7684\u4f8b\u5b50\u662f\u8f93\u5165 Konami \u4ee3\u7801\u4ee5\u83b7\u5f97\u989d\u5916\u7684\u81ea\u5b9a\u4e49\u529f\u80fd\u3002"}]
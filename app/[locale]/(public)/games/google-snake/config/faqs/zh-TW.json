[{"question": "Google \u86c7\u904a\u6232\u57fa\u672c\u64cd\u4f5c\uff1a\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u63a7\u5236\u86c7\u4e26\u907f\u514d\u649e\u5230\u7246\u58c1\u6216\u81ea\u5df1\uff1f", "answer": "\u5c0d\u65bc\u521d\u5b78\u8005\u4f86\u8aaa\uff0c\u5728 Google \u86c7\u904a\u6232\u4e2d\u63a7\u5236\u86c7\u76f8\u7576\u7c21\u55ae\u3002\u4f7f\u7528\u9375\u76e4\u4e0a\u7684\u65b9\u5411\u9375\uff08\u4e0a\u3001\u4e0b\u3001\u5de6\u3001\u53f3\uff09\u4f86\u63a7\u5236\u86c7\u7684\u79fb\u52d5\u3002\u86c7\u6703\u6301\u7e8c\u671d\u9078\u5b9a\u7684\u65b9\u5411\u79fb\u52d5\uff0c\u76f4\u5230\u60a8\u6309\u4e0b\u65b0\u7684\u65b9\u5411\u9375\u3002\u70ba\u4e86\u907f\u514d\u78b0\u649e\uff0c\u8acb\u7e3d\u662f\u63d0\u524d\u5e7e\u6b65\u898f\u5283\u60a8\u7684\u52d5\u4f5c\u3002\u95dc\u9375\u5728\u65bc\u7a7a\u9593\u610f\u8b58\u548c\u9810\u6e2c\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u6b63\u5728\u5411\u4e0a\u79fb\u52d5\uff0c\u63a5\u8fd1\u87a2\u5e55\u9802\u7aef\u6642\uff0c\u8acb\u958b\u59cb\u898f\u5283\u60a8\u7684\u8f49\u5411\uff1b\u5426\u5247\uff0c\u60a8\u53ef\u80fd\u6703\u649e\u5230\u7246\u58c1\u3002\u5efa\u8b70\u5148\u5f9e\u7d93\u5178\u6a21\u5f0f\u7df4\u7fd2\uff01 "}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u7684 Google \u86c7\u904a\u6232\u6709\u6642\u6703\u96a8\u6a5f\u52a0\u901f\uff0c\u4ee5\u53ca\u5982\u4f55\u6709\u6548\u5730\u7ba1\u7406\u9019\u7a2e\u52a0\u901f\uff1f", "answer": "Google \u86c7\u904a\u6232\u672c\u8eab\u4e26\u4e0d\u6703\u96a8\u6a5f\u52a0\u901f\u3002\u4efb\u4f55\u660e\u986f\u7684\u52a0\u901f\u50c5\u50c5\u662f\u56e0\u70ba\u4f60\u5403\u4e86\u66f4\u591a\u7684\u860b\u679c\uff0c\u56e0\u6b64\u4f60\u7684\u86c7\u8b8a\u9577\u4e86\uff0c\u8986\u84cb\u4e86\u66f4\u591a\u7684\u5730\u9762\uff0c\u56e0\u6b64\u5728\u7a7f\u8d8a\u7279\u5b9a\u7a7a\u9593\u6642\u6240\u82b1\u8cbb\u7684\u6642\u9593\u7565\u5fae\u6e1b\u5c11\u3002\u4ee5\u4e0b\u662f\u5982\u4f55\u6709\u6548\u7ba1\u7406\u5b83\u7684\u65b9\u6cd5\uff1a\n\n\u6b65\u9a5f 1\uff1a\u898f\u5283\u66f4\u9577\u7684\u8def\u7dda \u2013 \u9810\u6e2c\u4f60\u5c07\u5728\u4e09\u5230\u56db\u6b65\u4e4b\u5f8c\u7684\u4f4d\u7f6e\u3002\n\u6b65\u9a5f 2\uff1a\u4f7f\u7528\u77ed\u8f49\u5f4e \u2013 \u907f\u514d\u904e\u5927\u3001\u5e45\u5ea6\u904e\u5927\u7684\u8f49\u5f4e\uff0c\u4ee5\u514d\u628a\u81ea\u5df1\u56f0\u4f4f\u3002\n\u6b65\u9a5f 3\uff1a\u512a\u5316\u64fa\u653e\u4f4d\u7f6e \u2013 \u5982\u679c\u4f60\u6709\u7a7a\u9593\uff0c\u7e5e\u5708\u8d70\u53ef\u4ee5\u300c\u722d\u53d6\u300d\u6642\u9593\uff0c\u4e0d\u64bf\u8d77\u98df\u7269\uff0c\u8b93\u86c7\u7e2e\u77ed\uff0c\u4ee5\u6539\u5584\u9748\u6d3b\u6027\u3002"}, {"question": "Google \u86c7\u904a\u6232\u4e2d\u7684\u4e0d\u540c\u904a\u6232\u6a21\u5f0f\u6709\u54ea\u4e9b\uff0c\u54ea\u500b\u6a21\u5f0f\u6700\u9069\u5408\u6311\u6230\u81ea\u5df1\uff1f", "answer": "Google \u86c7\u904a\u6232\u63d0\u4f9b\u4e86\u4e00\u4e9b\u7d93\u5178\u86c7\u904a\u6232\u7684\u8b8a\u9ad4\u3002\u60a8\u901a\u5e38\u53ef\u4ee5\u627e\u5230\u66f4\u6539\u5730\u5716\u5927\u5c0f\u3001\u8f49\u5f4e\u901f\u5ea6\u548c\u8abf\u6574\u98df\u7269\u7522\u751f\u7684\u983b\u7387\u7684\u9078\u9805\u3002\u6bcf\u500b\u4e0d\u540c\u7684\u86c7\u7684\u5927\u5c0f\u548c\u901f\u5ea6\u90fd\u5e36\u4f86\u4e0d\u540c\u7684\u6311\u6230\u3002\u8981\u5617\u8a66\u771f\u6b63\u65b0\u7a4e\u7684\u65b9\u6cd5\uff0c\u8acb\u5617\u8a66\u6539\u8b8a\u86c7\u7684\u5916\u89c0\u3002\n\n\u6bd4\u8f03\u9810\u8a2d\u8207\u4fee\u6539\u8a2d\u5b9a\uff1a\n\u9810\u8a2d\uff1a\u7d93\u5178\u5fa9\u53e4\u683c\u5f0f\uff0c\u6a19\u6e96\u96e3\u5ea6\u3002\n\u4fee\u6539\uff1a\u5c07\u5730\u5716\u66f4\u6539\u70ba\u6700\u5c0f\u5c3a\u5bf8\uff0c\u4e26\u914d\u5099\u901f\u5ea6\u6700\u5feb\u7684\u86c7\uff0c\u9019\u5c07\u5927\u5e45\u589e\u52a0\u904a\u6232\u96e3\u5ea6\u3002\u9019\u975e\u5e38\u9069\u5408\u6311\u6230\u3002"}, {"question": "\u9664\u4e86\u9810\u8a2d\u5916\u89c0\u4e4b\u5916\uff0c\u662f\u5426\u53ef\u4ee5\u5728 Google \u86c7\u904a\u6232\u4e2d\u81ea\u8a02\u86c7\u7684\u5916\u89c0\uff0c\u5982\u679c\u53ef\u4ee5\uff0c\u5982\u4f55\u66f4\u6539\u5b83\uff1f", "answer": "\u662f\u7684\uff0cGoogle \u86c7\u904a\u6232\u5141\u8a31\u60a8\u81ea\u8a02\u86c7\u7684\u5916\u89c0\uff0c\u6709\u6642\uff0c\u9084\u53ef\u4ee5\u81ea\u8a02\u5b83\u6240\u5403\u7684\u98df\u7269\uff01\u5177\u9ad4\u65b9\u6cd5\u53d6\u6c7a\u65bc\u60a8\u6b63\u5728\u73a9\u7684\u7248\u672c\uff0c\u4f46\u901a\u5e38\u53ef\u4ee5\u5728\u53f3\u4e0a\u89d2\u7684\u4e09\u500b\u9ede\u4e2d\u627e\u5230\u8a2d\u5b9a\u9078\u55ae\u3002\u5f9e\u90a3\u88e1\uff0c\u5c0b\u627e\u8207\u8996\u89ba\u81ea\u8a02\u6216\u5916\u89c0\u76f8\u95dc\u7684\u9078\u9805\u3002\u60a8\u53ef\u4ee5\u5617\u8a66\u4e0d\u540c\u7684\u984f\u8272\u3001\u5716\u6848\uff0c\u751a\u81f3\u7bc0\u65e5\u4e3b\u984c\u5916\u89c0\uff0c\u8b93\u60a8\u7684\u904a\u6232\u7368\u5177\u7279\u8272\u3002\u6211\u7279\u5225\u559c\u6b61\u300e\u507d\u88dd\u300f\u9019\u500b\u5916\u89c0\uff01"}, {"question": "Google \u86c7\u904a\u6232\u7b56\u7565\uff1a\u5728 Google \u86c7\u904a\u6232\u4e2d\u6301\u7e8c\u53d6\u5f97\u9ad8\u5206\u7684\u9032\u968e\u6280\u5de7\u6709\u54ea\u4e9b\uff1f", "answer": "\u70ba\u4e86\u5728 Google \u86c7\u904a\u6232\u4e2d\u6301\u7e8c\u53d6\u5f97\u9ad8\u5206\uff0c\u60a8\u9700\u8981\u5be6\u65bd\u4e00\u4e9b\u8d85\u8d8a\u57fa\u672c\u751f\u5b58\u7b56\u7565\u7684\u9032\u968e\u7b56\u7565\u3002\u4ee5\u4e0b\u8aaa\u660e\uff1a\n\n\u6b65\u9a5f 1\uff1a\u89d2\u843d\u5229\u7528 \u2013 \u5229\u7528\u89d2\u843d\u4f86\u512a\u52e2\uff0c\u8b93\u60a8\u5b89\u5168\u5730\u66ab\u505c\u4e26\u8a55\u4f30\u68cb\u76e4\uff0c\u800c\u4e0d\u6703\u6709\u7acb\u5373\u649e\u5230\u7246\u58c1\u7684\u98a8\u96aa\u3002\n\u6b65\u9a5f 2\uff1a\u8def\u5f91\u512a\u5316 \u2013 \u6709\u6548\u5730\u898f\u5283\u60a8\u7684\u52d5\u4f5c\uff0c\u5c07\u6d6a\u8cbb\u7684\u7a7a\u9593\u6e1b\u5230\u6700\u4f4e\uff0c\u4e26\u78ba\u4fdd\u60a8\u59cb\u7d42\u6709\u9003\u751f\u8def\u7dda\u3002\n\u6b65\u9a5f 3\uff1a\u81ea\u541e (\u9032\u968e) \u2013 \u5982\u679c\u5fc5\u8981\uff0c\u5275\u5efa\u8ff4\u5708\uff0c\u8b93\u60a8\u5403\u6389\u4e00\u90e8\u5206\u81ea\u5df1\u7684\u5c3e\u5df4\uff0c\u66ab\u6642\u6e1b\u5c11\u60a8\u7684\u9577\u5ea6\u4ee5\u4fbf\u5728\u72f9\u7a84\u7a7a\u9593\u4e2d\u8b8a\u63db\u65b9\u5411\u3002\u9019\u50c5\u61c9\u5728\u7dca\u6025\u60c5\u6cc1\u4e0b\u4f7f\u7528\u3002"}, {"question": "Google \u86c7\u904a\u6232\u932f\u8aa4\uff1aGoogle \u86c7\u904a\u6232\u4e2d\u662f\u5426\u6709\u4efb\u4f55\u5df2\u77e5\u7684\u932f\u8aa4\u6216\u6f0f\u6d1e\uff0c\u53ef\u4ee5\u7528\u4f86\u7372\u5f97\u512a\u52e2\uff0c\u4ee5\u53ca\u5176\u502b\u7406\u8003\u91cf\uff1f", "answer": "\u96d6\u7136 Google \u86c7\u904a\u6232\u662f\u4e00\u500b\u76f8\u5c0d\u7c21\u55ae\u7684\u904a\u6232\uff0c\u4f46\u96a8\u8457\u6642\u9593\u7684\u63a8\u79fb\uff0c\u4e00\u4e9b\u73a9\u5bb6\u5df2\u7d93\u8a18\u9304\u4e86\u4e00\u4e9b\u932f\u8aa4\u6216\u5229\u7528\u65b9\u5f0f\u3002\u7136\u800c\uff0c\u5177\u9ad4\u60c5\u6cc1\u56e0\u6848\u4f8b\u800c\u7570\u3002\u6709\u4e9b\u6d89\u53ca\u7279\u5b9a\u700f\u89bd\u5668\u884c\u70ba\uff0c\u5141\u8a31\u7a7f\u904e\u7246\u58c1\uff0c\u6216\u901a\u904e\u66f4\u6539\u904a\u6232\u6a94\u6848\u79fb\u9664\u67d0\u4e9b\u5143\u7d20\u3002\u660e\u78ba\u800c\u8a00\uff0c\u66f4\u6539\u904a\u6232\u6a94\u6848\u901a\u5e38\u662f\u4e0d\u9053\u5fb7\u7684\uff0c\u4e26\u4e14\u53ef\u80fd\u6703\u9055\u53cd\u670d\u52d9\u689d\u6b3e\u3002\u662f\u5426\u53ef\u4ee5\u63a5\u53d7\u53d6\u6c7a\u65bc\u60a8\u5728\u7af6\u722d\u6027\u904a\u6232\u6642\u6240\u5728\u7684\u793e\u7fa4\u898f\u5247\uff0c\u6216\u55ae\u4eba\u904a\u6232\u6a21\u5f0f\u7684\u500b\u4eba\u559c\u597d\u3002\u4f8b\u5982\uff0c\u7a7f\u904e\u7246\u58c1\u6703\u5728\u6f5b\u5728\u7684\u502b\u7406\u6210\u672c\u4e0b\u7372\u5f97\u512a\u52e2\u3002"}, {"question": "\u5206\u6790 Google \u86c7\u904a\u6232\uff1a\u6c7a\u5b9a Google \u86c7\u904a\u6232\u4e2d\u860b\u679c\u7522\u751f\u7684\u5e95\u5c64\u6f14\u7b97\u6cd5\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff1f", "answer": "Google \u86c7\u904a\u6232\u4e2d\u860b\u679c\u7522\u751f\u7684\u5e95\u5c64\u6f14\u7b97\u6cd5\u65e8\u5728\u78ba\u4fdd\u516c\u5e73\u7684\u904a\u6232\u9ad4\u9a57\u3002\u860b\u679c\u4e0d\u6703\u5728\u86c7\u8eab\u4e0a\u751f\u6210\u3002\u5b83\u901a\u5e38\u51fa\u73fe\u5728\u96a8\u6a5f\u4f4d\u7f6e\u3002\u96a8\u8457\u904a\u6232\u7684\u9032\u884c\uff0c\u86c7\u6703\u4f54\u7528\u66f4\u591a\u7684\u53ef\u7528\u7a7a\u9593\u3002\u5728\u67d0\u4e9b\u7a0b\u5f0f\u78bc\u4e2d\uff0c\u6f14\u7b97\u6cd5\u6703\u907f\u514d\u5728\u8ddd\u96e2\u86c7\u982d\u592a\u8fd1\u7684\u5730\u65b9\u751f\u6210\uff0c\u4ee5\u4fbf\u73a9\u5bb6\u6709\u6a5f\u6703\u505a\u51fa\u53cd\u61c9\u3002\u5f9e\u5206\u6790\u7684\u89d2\u5ea6\u4f86\u770b\uff0c\u6f14\u7b97\u6cd5\u5fc5\u9808\u6aa2\u67e5\u86c7\u7684\u7576\u524d\u4f4d\u7f6e\uff0c\u4e26\u751f\u6210\u96a8\u6a5f (x,y) \u5ea7\u6a19\u3002"}, {"question": "Google \u86c7\u904a\u6232\u7684\u9650\u5236\uff1aGoogle \u86c7\u904a\u6232\u5728\u4e0d\u540c\u88dd\u7f6e\u4e0a\u7684\u6548\u80fd\u53ef\u80fd\u53d7\u5230\u54ea\u4e9b\u6280\u8853\u9650\u5236\uff1f", "answer": "Google \u86c7\u904a\u6232\u5728\u7db2\u9801\u700f\u89bd\u5668\u6216\u884c\u52d5\u61c9\u7528\u7a0b\u5f0f\u4e2d\u57f7\u884c\uff0c\u9019\u5f9e\u7d14\u7cb9\u6280\u8853\u89d2\u5ea6\u4f86\u770b\u5f15\u5165\u4e86\u7279\u5b9a\u7684\u9650\u5236\u3002\u820a\u88dd\u7f6e\u53ef\u80fd\u96e3\u4ee5\u5feb\u901f\u8655\u7406 JavaScript\uff0c\u9020\u6210\u904a\u6232\u5ef6\u9072\uff0c\u5c24\u5176\u662f\u7576\u86c7\u8b8a\u9577\u6642\u3002\u700f\u89bd\u5668\u8a18\u61b6\u9ad4\u9650\u5236\u4e5f\u53ef\u80fd\u6703\u5c0e\u81f4\u86c7\u904e\u9577\u6642\uff08\u4f8b\u5982\u586b\u6eff\u5927\u90e8\u5206\u87a2\u5e55\uff09\u767c\u751f\u7576\u6a5f\u3002\u4f8b\u5982\uff0c\u4e00\u53f0\u5f37\u5927\u7684\u73fe\u4ee3\u904a\u6232\u7b46\u96fb\u6703\u6bd4\u820a\u5e73\u677f\u96fb\u8166\u8655\u7406\u66f4\u5927\u7684\u86c7\u3002"}, {"question": "Google \u86c7\u904a\u6232\u7684\u651c\u5e36\u6027\uff1aGoogle \u86c7\u904a\u6232\u7684\u9032\u5ea6\u6216\u8a2d\u5b9a\u662f\u5426\u53ef\u4ee5\u5728\u7db2\u9801\u700f\u89bd\u5668\u548c\u884c\u52d5\u61c9\u7528\u7a0b\u5f0f\u7248\u672c\u4e4b\u9593\u8f49\u79fb\uff1f\u5982\u679c\u53ef\u4ee5\uff0c\u5982\u4f55\u8f49\u79fb\uff1f", "answer": "\u907a\u61be\u7684\u662f\uff0cGoogle \u86c7\u904a\u6232\u7684\u9032\u5ea6\u548c\u8a2d\u5b9a\u8a2d\u8a08\u4e26\u975e\u76f4\u63a5\u5728\u7db2\u9801\u700f\u89bd\u5668\u548c\u61c9\u7528\u7a0b\u5f0f\u7248\u672c\u4e4b\u9593\u8f49\u79fb\u3002\u6bcf\u500b\u7248\u672c\u901a\u5e38\u5728\u672c\u6a5f\u5132\u5b58\u8cc7\u6599\uff0c\u8868\u793a\u60a8\u7684\u9ad8\u5206\u548c\u81ea\u8a02\u8a2d\u5b9a\u7279\u5b9a\u65bc\u60a8\u6b63\u5728\u4f7f\u7528\u7684\u5e73\u53f0\uff0c\u4e26\u4e14\uff0c\u5982\u679c\u60a8\u6e05\u9664\u700f\u89bd\u5668\u8a2d\u5b9a\u6216\u5feb\u53d6\u6216\u89e3\u9664\u5b89\u88dd\u61c9\u7528\u7a0b\u5f0f\uff0c\u4efb\u4f55\u9032\u5ea6\u90fd\u6703\u907a\u5931\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u7db2\u9801\u700f\u89bd\u5668\u7248\u672c\u4e2d\u53d6\u5f97 500 \u5206\u7684\u9ad8\u5206\uff0c\u6b64\u9ad8\u5206\u901a\u5e38\u4e0d\u6703\u53cd\u6620\u5728\u884c\u52d5\u61c9\u7528\u7a0b\u5f0f\u4e2d\u3002\u67d0\u4e9b\u73fe\u4ee3\u5e73\u53f0\u5141\u8a31\u900f\u904e\u5e33\u6236\u5099\u4efd\u7684\u624b\u52d5\u6216\u81ea\u52d5\u8f49\u79fb\u61c9\u7528\u7a0b\u5f0f\u8cc7\u6599\u3002"}, {"question": "\u6df1\u5165\u63a2\u8a0e Google \u86c7\u904a\u6232\uff1aGoogle \u86c7\u904a\u6232\u4e2d\u662f\u5426\u6709\u4efb\u4f55\u5927\u591a\u6578\u73a9\u5bb6\u90fd\u4e0d\u77e5\u9053\u7684\u96b1\u85cf\u5f69\u86cb\u6216\u79d8\u5bc6\u529f\u80fd\uff0c\u4ee5\u53ca\u5982\u4f55\u555f\u7528\u5b83\u5011\uff1f", "answer": "Google \u86c7\u904a\u6232\u6709\u4e00\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\u548c\u79d8\u5bc6\u529f\u80fd\u3002\u555f\u52d5\u9019\u4e9b\u79d8\u5bc6\u901a\u5e38\u9700\u8981\u5728\u904a\u6232\u904e\u7a0b\u4e2d\u8f38\u5165\u7279\u5b9a\u7684\u6309\u9375\u7d44\u5408\u6216\u52d5\u4f5c\u3002\u4e00\u500b\u5e38\u898b\u7684\u5f69\u86cb\u662f\u89e3\u9396\u4e0d\u540c\u7684\u5730\u5716\u98a8\u683c\u6216\u4e3b\u984c\u3002\u9019\u901a\u5e38\u9700\u8981\u8f38\u5165\u7279\u6b8a\u5bc6\u78bc\uff0c\u65b9\u6cd5\u662f\u89f8\u78b0\u87a2\u5e55\u7279\u5b9a\u90e8\u5206\u4e00\u5b9a\u6b21\u6578\u3002\u4e00\u500b\u5178\u578b\u7684\u4f8b\u5b50\u662f\u8f38\u5165 Konami \u78bc\u4ee5\u7372\u5f97\u984d\u5916\u81ea\u8a02\u529f\u80fd\u3002"}]
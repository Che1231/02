[{"question": "\u30b9\u30ca\u30a4\u30d1\u30fc\u30d1\u30ba\u30eb\u3067\u57fa\u672c\u7684\u306a\u52d5\u304d\u3068\u64cd\u4f5c\u3092\u884c\u3046\u65b9\u6cd5\u3092\u6559\u3048\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "\u30b9\u30ca\u30a4\u30d1\u30fc\u30d1\u30ba\u30eb\u3067\u306f\u3001\u65b9\u5411\u30ad\u30fc\u307e\u305f\u306fWASD\u30ad\u30fc\u3092\u4f7f\u3063\u3066\u57fa\u672c\u7684\u306a\u79fb\u52d5\u3092\u884c\u3044\u307e\u3059\u3002\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3068\u5bfe\u8a71\u3059\u308b\u306b\u306f\u3001\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u3092\u62bc\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u9375\u3092\u62fe\u3046\u306b\u306f\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u9375\u306e\u96a3\u306b\u79fb\u52d5\u3055\u305b\u3001\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u3092\u62bc\u3057\u307e\u3059\u3002\u3059\u308b\u3068\u3001\u9375\u304c\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u306b\u8ffd\u52a0\u3055\u308c\u3001'I'\u30ad\u30fc\u3092\u62bc\u3059\u3068\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u96a0\u308c\u3066\u3044\u308b\u306b\u3082\u304b\u304b\u308f\u3089\u305a\u3001\u30b9\u30ca\u30a4\u30d1\u30fc\u30d1\u30ba\u30eb\u3067\u306a\u305c\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u6355\u307e\u3063\u3066\u3057\u307e\u3046\u306e\u3067\u3059\u304b\uff1f", "answer": "\u96a0\u308c\u3066\u3044\u308b\u306b\u3082\u304b\u304b\u308f\u3089\u305a\u3001\u6355\u307e\u3063\u3066\u3057\u307e\u3046\u7406\u7531\u306f\u3044\u304f\u3064\u304b\u3042\u308a\u307e\u3059\u3002\u307e\u305a\u3001\u8b66\u5099\u54e1\u306e\u8996\u754c\u304b\u3089\u5b8c\u5168\u306b\u5916\u308c\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u3001\u58c1\u306e\u5f8c\u308d\u306b\u96a0\u308c\u3066\u3044\u3066\u3082\u3001\u8b66\u5099\u54e1\u304c\u307e\u3060\u3042\u306a\u305f\u306e\u5f71\u3092\u898b\u308b\u3053\u3068\u304c\u3067\u304d\u308c\u3070\u3001\u4e0d\u5341\u5206\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u6b21\u306b\u3001\u4e00\u90e8\u306e\u8b66\u5099\u54e1\u306f\u611f\u899a\u304c\u92ed\u304f\u3001\u5f71\u306e\u4e2d\u3067\u3042\u3063\u3066\u3082\u52d5\u304d\u3092\u691c\u77e5\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u884c\u52d5\u3092\u8d77\u3053\u3059\u524d\u306b\u3001\u5e38\u306b\u5f7c\u3089\u306e\u30d1\u30c8\u30ed\u30fc\u30eb\u30d1\u30bf\u30fc\u30f3\u3092\u89b3\u5bdf\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30b9\u30ca\u30a4\u30d1\u30fc\u30d1\u30ba\u30eb\u306e\u521d\u671f\u6bb5\u968e\u3067\u53ce\u96c6\u3059\u3079\u304d\u91cd\u8981\u306a\u30a2\u30a4\u30c6\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u521d\u671f\u6bb5\u968e\u3067\u306f\u3001\u9375\u3068\u30ab\u30ae\u722a\u3092\u53ce\u96c6\u3059\u308b\u3053\u3068\u306b\u91cd\u70b9\u3092\u7f6e\u3044\u3066\u304f\u3060\u3055\u3044\u3002\u9375\u306f\u30c9\u30a2\u3092\u958b\u3051\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3042\u308a\u3001\u30ab\u30ae\u722a\u306f\u65bd\u9320\u3055\u308c\u305f\u5b9d\u7bb1\u306b\u4f7f\u7528\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u96a3\u63a5\u3059\u308b\u90e8\u5c4b\u306b\u3042\u308b\u9375\u304c\u5fc5\u8981\u306a\u65bd\u9320\u3055\u308c\u305f\u30c9\u30a2\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30e0\u30fc\u30ba\u306b\u9032\u6357\u3059\u308b\u305f\u3081\u306b\u3001\u3053\u308c\u3089\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u30b9\u30ca\u30a4\u30d1\u30fc\u30d1\u30ba\u30eb\u3067\u30b9\u30c6\u30eb\u30b9\u6226\u7565\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u8b66\u5099\u54e1\u306e\u884c\u52d5\u30d1\u30bf\u30fc\u30f3\u3092\u30de\u30b9\u30bf\u30fc\u3057\u3001\u6c17\u3092\u7d1b\u3089\u308f\u305b\u308b\u3053\u3068\u3067\u30b9\u30c6\u30eb\u30b9\u6226\u7565\u3092\u6700\u9069\u5316\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71: \u8b66\u5099\u54e1\u306e\u30eb\u30fc\u30c8\u3068\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u89b3\u5bdf\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72: \u5ca9\u306a\u3069\u306e\u6295\u3052\u308b\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u4f7f\u3063\u3066\u6c17\u3092\u7d1b\u3089\u308f\u305b\u308b\u3002\u30b9\u30c6\u30c3\u30d73: \u5e38\u306b\u8131\u51fa\u30eb\u30fc\u30c8\u3092\u8a08\u753b\u3059\u308b\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb10\u3067\u306f\u3001\u53f3\u306b\u79fb\u52d5\u3057\u306a\u304c\u3089\u5de6\u306b\u5ca9\u3092\u6295\u3052\u308b\u3053\u3068\u3067\u3001\u52b9\u679c\u7684\u306b\u6ce8\u610f\u3092\u305d\u3089\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u9ad8\u5ea6\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u305f\u3081\u306b\u30b9\u30ca\u30a4\u30d1\u30fc\u30d1\u30ba\u30eb\u3067\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3079\u304d\u30b9\u30ad\u30eb\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u9ad8\u5ea6\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u305f\u3081\u306b\u3001\u30b9\u30c6\u30eb\u30b9\u3068\u30ab\u30ae\u722a\u306e\u30b9\u30ad\u30eb\u3092\u512a\u5148\u3057\u3066\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30eb\u30b9\u306f\u767a\u898b\u3055\u308c\u308b\u53ef\u80fd\u6027\u3092\u6e1b\u3089\u3057\u3001\u30ab\u30ae\u722a\u306f\u9ad8\u4fa1\u5024\u306e\u6226\u5229\u54c1\u3078\u306e\u30a2\u30af\u30bb\u30b9\u3092\u53ef\u80fd\u306b\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb15\u3067\u306f\u3001\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3055\u308c\u305f\u30ab\u30ae\u722a\u30b9\u30ad\u30eb\u306b\u3088\u308a\u3001\u30b9\u30b3\u30a2\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u8cb4\u91cd\u306a\u30a2\u30fc\u30c6\u30a3\u30d5\u30a1\u30af\u30c8\u304c\u5165\u3063\u305f\u5b9d\u7bb1\u3092\u958b\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30b9\u30ca\u30a4\u30d1\u30fc\u30d1\u30ba\u30eb\u3067\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u30b9\u30da\u30fc\u30b9\u3092\u7ba1\u7406\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u30b9\u30da\u30fc\u30b9\u3092\u7ba1\u7406\u3059\u308b\u3053\u3068\u306f\u3001\u91cd\u8981\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u904b\u3076\u80fd\u529b\u306b\u5f71\u97ff\u3059\u308b\u305f\u3081\u3001\u91cd\u8981\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb20\u3067\u306f\u3001\u8907\u6570\u306e\u9375\u3068\u30c4\u30fc\u30eb\u3092\u540c\u6642\u306b\u904b\u3076\u5fc5\u8981\u304c\u3042\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u304c\u3044\u3063\u3071\u3044\u306b\u306a\u308b\u3068\u3001\u91cd\u8981\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u6368\u3066\u308b\u3053\u3068\u3092\u4f59\u5100\u306a\u304f\u3055\u308c\u3001\u9032\u6357\u304c\u59a8\u3052\u3089\u308c\u307e\u3059\u3002\u5e38\u306b\u3001\u76f4\u3061\u306b\u5fc5\u8981\u3068\u306a\u308b\u30a2\u30a4\u30c6\u30e0\u3092\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30b9\u30ca\u30a4\u30d1\u30fc\u30d1\u30ba\u30eb\u306e\u691c\u77e5\u30b7\u30b9\u30c6\u30e0\u306e\u57fa\u76e4\u3068\u306a\u308b\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30ca\u30a4\u30d1\u30fc\u30d1\u30ba\u30eb\u306e\u691c\u77e5\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u8996\u7dda\u3068\u97f3\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u8b66\u5099\u54e1\u306f\u3001\u8996\u754c\u3092\u8868\u3059\u8996\u899a\u5186\u9310\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002\u3053\u306e\u5186\u9310\u5185\u3092\u79fb\u52d5\u3057\u305f\u308a\u3001\u8d70\u308a\u306a\u3069\u306e\u9a12\u97f3\u3092\u7acb\u3066\u305f\u308a\u3059\u308b\u3068\u3001\u691c\u77e5\u30ea\u30b9\u30af\u304c\u9ad8\u307e\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb5\u3067\u306f\u3001\u3057\u3083\u304c\u307f\u8fbc\u307f\u3001\u8b66\u5099\u54e1\u306e\u80cc\u5f8c\u3092\u3086\u3063\u304f\u308a\u3068\u79fb\u52d5\u3059\u308b\u3053\u3068\u3067\u3001\u767a\u898b\u3092\u56de\u907f\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30b9\u30ca\u30a4\u30d1\u30fc\u30d1\u30ba\u30eb\u306e\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6700\u7d42\u7684\u306a\u30b9\u30b3\u30a2\u3092\u3069\u306e\u3088\u3046\u306b\u8a08\u7b97\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30b9\u30ca\u30a4\u30d1\u30fc\u30d1\u30ba\u30eb\u306e\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6240\u8981\u6642\u9593\u3001\u53ce\u96c6\u3057\u305f\u30a2\u30a4\u30c6\u30e0\u3001\u30b9\u30c6\u30eb\u30b9\u30ec\u30d9\u30eb\u306e\u8907\u6570\u306e\u8981\u56e0\u306b\u57fa\u3065\u3044\u3066\u6700\u7d42\u7684\u306a\u30b9\u30b3\u30a2\u3092\u8a08\u7b97\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb\u3092\u8fc5\u901f\u306b\u30af\u30ea\u30a2\u3057\u3001\u3059\u3079\u3066\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u53ce\u96c6\u3057\u3001\u767a\u898b\u3055\u308c\u306a\u3044\u307e\u307e\u306b\u3059\u308b\u3068\u3001\u6700\u9ad8\u306e\u30b9\u30b3\u30a2\u304c\u5f97\u3089\u308c\u307e\u3059\u3002\u5404\u8981\u56e0\u306b\u306f\u7279\u5b9a\u306e\u91cd\u307f\u304c\u3042\u308a\u3001\u30b9\u30c6\u30eb\u30b9\u304c\u6700\u3082\u91cd\u8981\u3067\u3059\u3002"}, {"question": "PC\u7248\u306e\u30b9\u30ca\u30a4\u30d1\u30fc\u30d1\u30ba\u30eb\u306e\u9032\u884c\u72b6\u6cc1\u3092\u30e2\u30d0\u30a4\u30eb\u7248\u306b\u79fb\u884c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u4f7f\u7528\u3057\u3066PC\u7248\u306e\u30b9\u30ca\u30a4\u30d1\u30fc\u30d1\u30ba\u30eb\u306e\u9032\u884c\u72b6\u6cc1\u3092\u30e2\u30d0\u30a4\u30eb\u7248\u306b\u79fb\u884c\u3067\u304d\u307e\u3059\u3002\u4e21\u65b9\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u3001PC\u7248\u3067\u30ec\u30d9\u30eb10\u3092\u30af\u30ea\u30a2\u3057\u305f\u5f8c\u3001\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u306b\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3068\u3001\u9032\u884c\u72b6\u6cc1\u304c\u81ea\u52d5\u7684\u306b\u540c\u671f\u3055\u308c\u3001\u4e2d\u65ad\u3057\u305f\u3068\u3053\u308d\u304b\u3089\u518d\u958b\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30b9\u30ca\u30a4\u30d1\u30fc\u30d1\u30ba\u30eb\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30b9\u30ca\u30a4\u30d1\u30fc\u30d1\u30ba\u30eb\u306b\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u3042\u308a\u307e\u3059\u3002\u9855\u8457\u306a\u4f8b\u306f\u3001\u30ec\u30d9\u30eb12\u306e\u79d8\u5bc6\u306e\u90e8\u5c4b\u3067\u3059\u3002\u30a2\u30af\u30bb\u30b9\u3059\u308b\u306b\u306f\u3001\u7279\u5b9a\u306e\u58c1\u30d1\u30cd\u30eb\u3092\u9806\u756a\u306b\u64cd\u4f5c\u3057\u307e\u3059\u30023\u56de\u62bc\u3057\u3066\u3001\u5f85\u3063\u3066\u3001\u3082\u3046\u4e00\u5ea6\u62bc\u3057\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u30b2\u30fc\u30e0\u306e\u516c\u5f0f\u30ac\u30a4\u30c9\u306b\u306f\u8a18\u8f09\u3055\u308c\u3066\u3044\u306a\u3044\u3001\u30e6\u30cb\u30fc\u30af\u306a\u30a2\u30a4\u30c6\u30e0\u304c\u5165\u3063\u3066\u3044\u308b\u90e8\u5c4b\u304c\u660e\u3089\u304b\u306b\u306a\u308a\u307e\u3059\u3002"}]
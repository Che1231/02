[{"question": "\u5982\u4f55\u57f7\u884c\u7aca\u8cca\u8b0e\u984c\u4e2d\u7684\u57fa\u672c\u52d5\u4f5c\u548c\u4e92\u52d5\uff1f", "answer": "\u5728\u7aca\u8cca\u8b0e\u984c\u4e2d\uff0c\u57fa\u672c\u52d5\u4f5c\u4f7f\u7528\u65b9\u5411\u9375\u6216 WASD \u63a7\u5236\u3002\u8981\u8207\u7269\u4ef6\u4e92\u52d5\uff0c\u8acb\u6309\u4e0b\u7a7a\u683c\u9375\u3002\u4f8b\u5982\uff0c\u8981\u64bf\u53d6\u9470\u5319\uff0c\u8acb\u5c07\u89d2\u8272\u79fb\u81f3\u9470\u5319\u65c1\u908a\u4e26\u6309\u4e0b\u7a7a\u683c\u9375\u3002\u9019\u6703\u5c07\u9470\u5319\u6dfb\u52a0\u5230\u60a8\u7684\u7269\u54c1\u6b04\uff0c\u60a8\u53ef\u4ee5\u901a\u904e\u6309\u4e0b\u300eI\u300f\u9375\u5b58\u53d6\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u7684\u89d2\u8272\u5373\u4f7f\u8eb2\u85cf\u5728\u7aca\u8cca\u8b0e\u984c\u4e2d\u4e5f\u6703\u88ab\u6293\u5230\uff1f", "answer": "\u5728\u8eb2\u85cf\u6642\u88ab\u6293\u5230\uff0c\u53ef\u80fd\u6709\u5e7e\u500b\u539f\u56e0\u3002\u9996\u5148\uff0c\u8acb\u78ba\u4fdd\u60a8\u5b8c\u5168\u4e0d\u5728\u5b88\u885b\u7684\u8996\u7dda\u7bc4\u570d\u5167\u3002\u4f8b\u5982\uff0c\u8eb2\u5728\u7246\u5f8c\u53ef\u80fd\u4e0d\u5920\uff0c\u56e0\u70ba\u5b88\u885b\u4ecd\u7136\u53ef\u4ee5\u770b\u5230\u60a8\u7684\u5f71\u5b50\u3002\u5176\u6b21\uff0c\u6709\u4e9b\u5b88\u885b\u7684\u611f\u5b98\u654f\u92b3\uff0c\u5373\u4f7f\u5728\u9670\u5f71\u4e2d\u4e5f\u80fd\u5075\u6e2c\u5230\u52d5\u4f5c\u3002\u5728\u884c\u52d5\u524d\uff0c\u8acb\u96a8\u6642\u89c0\u5bdf\u4ed6\u5011\u7684\u5de1\u908f\u8def\u7dda\u3002"}, {"question": "\u5728\u7aca\u8cca\u8b0e\u984c\u65e9\u671f\u968e\u6bb5\u61c9\u8a72\u6536\u96c6\u54ea\u4e9b\u5fc5\u5099\u7269\u54c1\uff1f", "answer": "\u5728\u65e9\u671f\u968e\u6bb5\uff0c\u91cd\u9ede\u6536\u96c6\u9470\u5319\u548c\u958b\u9396\u5668\u3002\u9470\u5319\u7528\u65bc\u958b\u555f\u9580\u9396\uff0c\u800c\u958b\u9396\u5668\u53ef\u7528\u65bc\u958b\u555f\u9396\u4f4f\u7684\u7bb1\u5b50\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u95dc\u5c31\u6709\u4e00\u500b\u9700\u8981\u4f7f\u7528\u9130\u623f\u9593\u9470\u5319\u624d\u80fd\u958b\u555f\u7684\u9396\u9580\u3002\u7e3d\u4e4b\uff0c\u8acb\u512a\u5148\u6536\u96c6\u9019\u4e9b\u7269\u54c1\u4ee5\u9806\u5229\u63a8\u9032\u904a\u6232\u3002"}, {"question": "\u5728\u73a9\u7aca\u8cca\u8b0e\u984c 100 \u5c0f\u6642\u5f8c\uff0c\u6211\u5982\u4f55\u512a\u5316\u6211\u7684\u6f5b\u884c\u7b56\u7565\uff1f", "answer": "\u5728\u73a9\u4e86 100 \u5c0f\u6642\u5f8c\uff0c\u8acb\u900f\u904e\u638c\u63e1\u5b88\u885b\u7684\u6a21\u5f0f\u548c\u4f7f\u7528\u5e72\u64fe\u4f86\u512a\u5316\u60a8\u7684\u6f5b\u884c\u7b56\u7565\u3002\u6b65\u9a5f 1\uff1a\u89c0\u5bdf\u5b88\u885b\u7684\u8def\u7dda\u548c\u6642\u9593\u9ede\u3002\u6b65\u9a5f 2\uff1a\u4f7f\u7528\u6295\u64f2\u7269\u9ad4\uff08\u4f8b\u5982\u77f3\u982d\uff09\u88fd\u9020\u5e72\u64fe\u3002\u6b65\u9a5f 3\uff1a\u96a8\u6642\u898f\u5283\u9003\u751f\u8def\u7dda\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 10 \u95dc\uff0c\u5411\u5de6\u4e1f\u77f3\u982d\u540c\u6642\u5411\u53f3\u79fb\u52d5\u53ef\u4ee5\u6709\u6548\u5730\u8f49\u79fb\u6ce8\u610f\u529b\u3002"}, {"question": "\u5728\u7aca\u8cca\u8b0e\u984c\u7684\u9ad8\u968e\u904a\u6232\u4e2d\uff0c\u6211\u61c9\u8a72\u512a\u5148\u5347\u7d1a\u54ea\u4e9b\u6280\u80fd\uff1f", "answer": "\u5728\u9ad8\u968e\u904a\u6232\u4e2d\uff0c\u512a\u5148\u5347\u7d1a\u6f5b\u884c\u548c\u958b\u9396\u6280\u80fd\u3002\u6f5b\u884c\u964d\u4f4e\u88ab\u5075\u6e2c\u7684\u6a5f\u7387\uff0c\u800c\u958b\u9396\u53ef\u4ee5\u7372\u5f97\u9ad8\u50f9\u503c\u7684\u6230\u5229\u54c1\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 15 \u95dc\uff0c\u5347\u7d1a\u7684\u958b\u9396\u6280\u80fd\u4f7f\u60a8\u80fd\u5920\u958b\u555f\u4e00\u500b\u88dd\u6709\u7a00\u6709\u7269\u54c1\u7684\u7bb1\u5b50\uff0c\u9019\u5c07\u986f\u8457\u63d0\u5347\u60a8\u7684\u5206\u6578\u3002"}, {"question": "\u5728\u7aca\u8cca\u8b0e\u984c\u4e2d\uff0c\u70ba\u4ec0\u9ebc\u8981\u7ba1\u7406\u7269\u54c1\u6b04\u7a7a\u9593\uff1f", "answer": "\u7ba1\u7406\u7269\u54c1\u6b04\u7a7a\u9593\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6703\u5f71\u97ff\u60a8\u651c\u5e36\u91cd\u8981\u7269\u54c1\u7684\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 20 \u95dc\uff0c\u60a8\u53ef\u80fd\u9700\u8981\u540c\u6642\u651c\u5e36\u591a\u628a\u9470\u5319\u548c\u5de5\u5177\u3002\u7269\u54c1\u6b04\u904e\u8f09\u53ef\u80fd\u6703\u8feb\u4f7f\u60a8\u6368\u68c4\u91cd\u8981\u7269\u54c1\uff0c\u963b\u7919\u904a\u6232\u9032\u5ea6\u3002\u8acb\u6839\u64da\u7acb\u5373\u9700\u6c42\u512a\u5148\u8003\u616e\u7269\u54c1\u3002"}, {"question": "\u7aca\u8cca\u8b0e\u984c\u4e2d\u7684\u5075\u6e2c\u7cfb\u7d71\u80cc\u5f8c\u7684\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "\u7aca\u8cca\u8b0e\u984c\u4e2d\u7684\u5075\u6e2c\u7cfb\u7d71\u57fa\u65bc\u8996\u7dda\u548c\u8072\u97f3\u3002\u5b88\u885b\u6709\u4e00\u500b\u8996\u9310\uff0c\u4ee3\u8868\u4ed6\u5011\u7684\u8996\u91ce\u7bc4\u570d\u3002\u5728\u9019\u500b\u8996\u9310\u5167\u79fb\u52d5\u6216\u767c\u51fa\u566a\u97f3\uff08\u4f8b\u5982\u8dd1\u6b65\uff09\u6703\u589e\u52a0\u88ab\u5075\u6e2c\u7684\u98a8\u96aa\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 5 \u95dc\uff0c\u8e72\u4e0b\u4e26\u7de9\u6162\u79fb\u52d5\u81f3\u5b88\u885b\u80cc\u5f8c\u53ef\u4ee5\u4fdd\u6301\u96b1\u85cf\u3002"}, {"question": "\u7aca\u8cca\u8b0e\u984c\u4e2d\u7684\u8a08\u5206\u7cfb\u7d71\u5982\u4f55\u8a08\u7b97\u60a8\u7684\u6700\u7d42\u5206\u6578\uff1f", "answer": "\u7aca\u8cca\u8b0e\u984c\u4e2d\u7684\u8a08\u5206\u7cfb\u7d71\u6703\u6839\u64da\u591a\u500b\u56e0\u7d20\u8a08\u7b97\u60a8\u7684\u6700\u7d42\u5206\u6578\uff1a\u6240\u9700\u6642\u9593\u3001\u6536\u96c6\u7684\u7269\u54c1\u548c\u6f5b\u884c\u7b49\u7d1a\u3002\u4f8b\u5982\uff0c\u8fc5\u901f\u5b8c\u6210\u95dc\u5361\u3001\u6536\u96c6\u6240\u6709\u7269\u54c1\u4e26\u4fdd\u6301\u96b1\u85cf\u6703\u7372\u5f97\u6700\u9ad8\u5206\u6578\u3002\u6bcf\u500b\u56e0\u7d20\u90fd\u6709\u5176\u7279\u5b9a\u6b0a\u91cd\uff0c\u5176\u4e2d\u6f5b\u884c\u662f\u6700\u91cd\u8981\u7684\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5728 PC \u8207\u624b\u6a5f\u4e4b\u9593\u8f49\u79fb\u7aca\u8cca\u8b0e\u984c\u7684\u904a\u6232\u9032\u5ea6\u55ce\uff1f", "answer": "\u662f\u7684\uff0c\u60a8\u53ef\u4ee5\u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u5c07 PC \u7684\u904a\u6232\u9032\u5ea6\u8f49\u79fb\u5230\u624b\u6a5f\u3002\u8acb\u78ba\u4fdd\u60a8\u5728\u5169\u8005\u5e73\u53f0\u4e0a\u90fd\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u3002\u4f8b\u5982\uff0c\u5728 PC \u4e0a\u5b8c\u6210\u7b2c 10 \u95dc\u5f8c\uff0c\u767b\u5165\u60a8\u7684\u624b\u6a5f\u8a2d\u5099\uff0c\u60a8\u7684\u9032\u5ea6\u6703\u81ea\u52d5\u540c\u6b65\uff0c\u8b93\u60a8\u53ef\u4ee5\u7e7c\u7e8c\u672a\u5b8c\u6210\u7684\u4efb\u52d9\u3002"}, {"question": "\u7aca\u8cca\u8b0e\u984c\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\uff1f", "answer": "\u7aca\u8cca\u8b0e\u984c\u5305\u542b\u4e00\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\u3002\u4e00\u500b\u986f\u8457\u7684\u4f8b\u5b50\u662f\u7b2c 12 \u95dc\u7684\u79d8\u5bc6\u623f\u9593\u3002\u8981\u9032\u5165\uff0c\u8acb\u4ee5\u7279\u5b9a\u9806\u5e8f\u8207\u7279\u5b9a\u7246\u58c1\u9762\u677f\u4e92\u52d5\uff1a\u6309\u4e09\u6b21\uff0c\u7b49\u5f85\uff0c\u7136\u5f8c\u518d\u6309\u4e00\u6b21\u3002\u9019\u5c07\u986f\u793a\u4e00\u500b\u5305\u542b\u904a\u6232\u5b98\u65b9\u6307\u5357\u4e2d\u672a\u5217\u51fa\u7684\u7368\u7279\u7269\u54c1\u7684\u623f\u9593\u3002"}]
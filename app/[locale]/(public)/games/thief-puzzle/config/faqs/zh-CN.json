[{"question": "\u5982\u4f55\u5728\u300a\u7a83\u8d3c\u4e4b\u8c1c\u300b\u4e2d\u8fdb\u884c\u57fa\u672c\u79fb\u52a8\u548c\u4e92\u52a8\uff1f", "answer": "\u5728\u300a\u7a83\u8d3c\u4e4b\u8c1c\u300b\u4e2d\uff0c\u57fa\u672c\u79fb\u52a8\u4f7f\u7528\u65b9\u5411\u952e\u6216 WASD \u952e\u63a7\u5236\u3002\u8981\u4e0e\u7269\u4f53\u4e92\u52a8\uff0c\u8bf7\u6309\u7a7a\u683c\u952e\u3002\u4f8b\u5982\uff0c\u62fe\u53d6\u94a5\u5319\uff0c\u5c06\u89d2\u8272\u79fb\u52a8\u5230\u94a5\u5319\u65c1\u8fb9\uff0c\u5e76\u6309\u7a7a\u683c\u952e\u3002\u8fd9\u5c06\u628a\u94a5\u5319\u6dfb\u52a0\u5230\u4f60\u7684\u7269\u54c1\u680f\uff0c\u53ef\u4ee5\u901a\u8fc7\u6309 'I' \u952e\u8bbf\u95ee\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u5728\u300a\u7a83\u8d3c\u4e4b\u8c1c\u300b\u4e2d\u9690\u85cf\u65f6\u89d2\u8272\u4f1a\u88ab\u6293\u4f4f\uff1f", "answer": "\u5728\u9690\u85cf\u72b6\u6001\u4e0b\u88ab\u6293\u4f4f\u7684\u539f\u56e0\u53ef\u80fd\u6709\u591a\u4e2a\u3002\u9996\u5148\uff0c\u786e\u4fdd\u4f60\u5b8c\u5168\u8eb2\u8fc7\u4e86\u5b88\u536b\u7684\u89c6\u7ebf\u3002\u4f8b\u5982\uff0c\u8eb2\u5728\u5899\u540e\u53ef\u80fd\u4e0d\u8db3\u4ee5\u907f\u514d\u5b88\u536b\u770b\u5230\u4f60\u7684\u5f71\u5b50\u3002\u5176\u6b21\uff0c\u4e00\u4e9b\u5b88\u536b\u7684\u611f\u77e5\u80fd\u529b\u589e\u5f3a\uff0c\u5373\u4f7f\u5728\u9634\u5f71\u4e2d\u4e5f\u80fd\u63a2\u6d4b\u5230\u79fb\u52a8\u3002\u5728\u884c\u52a8\u4e4b\u524d\uff0c\u8bf7\u52a1\u5fc5\u89c2\u5bdf\u4ed6\u4eec\u7684\u5de1\u903b\u8def\u7ebf\u3002"}, {"question": "\u5728\u300a\u7a83\u8d3c\u4e4b\u8c1c\u300b\u7684\u65e9\u671f\u9636\u6bb5\uff0c\u54ea\u4e9b\u7269\u54c1\u662f\u5fc5\u987b\u6536\u96c6\u7684\uff1f", "answer": "\u5728\u65e9\u671f\u9636\u6bb5\uff0c\u4e13\u6ce8\u4e8e\u6536\u96c6\u94a5\u5319\u548c\u5f00\u9501\u5668\u3002\u94a5\u5319\u5bf9\u4e8e\u6253\u5f00\u95e8\u81f3\u5173\u91cd\u8981\uff0c\u800c\u5f00\u9501\u5668\u53ef\u4ee5\u7528\u6765\u6253\u5f00\u9501\u7740\u7684\u7bb1\u5b50\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u5173\uff0c\u6709\u4e00\u4e2a\u9700\u8981\u4ece\u76f8\u90bb\u623f\u95f4\u83b7\u5f97\u94a5\u5319\u624d\u80fd\u6253\u5f00\u7684\u95e8\u3002\u4e3a\u4e86\u987a\u5229\u8fdb\u884c\uff0c\u8bf7\u4f18\u5148\u6536\u96c6\u8fd9\u4e9b\u7269\u54c1\u3002"}, {"question": "\u5728\u300a\u7a83\u8d3c\u4e4b\u8c1c\u300b\u73a9\u4e86100\u5c0f\u65f6\u540e\uff0c\u5982\u4f55\u4f18\u5316\u6211\u7684\u6f5c\u884c\u7b56\u7565\uff1f", "answer": "\u5728\u73a9\u4e86100\u5c0f\u65f6\u540e\uff0c\u4f18\u5316\u4f60\u7684\u6f5c\u884c\u7b56\u7565\uff0c\u9700\u8981\u719f\u7ec3\u638c\u63e1\u5b88\u536b\u7684\u89c4\u5f8b\u5e76\u4f7f\u7528\u5e72\u6270\u624b\u6bb5\u3002\u6b65\u9aa41\uff1a\u89c2\u5bdf\u5b88\u536b\u7684\u8def\u7ebf\u548c\u65f6\u95f4\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u6295\u63b7\u7269\uff08\u4f8b\u5982\u77f3\u5934\uff09\u5236\u9020\u5e72\u6270\u3002\u6b65\u9aa43\uff1a\u59cb\u7ec8\u89c4\u5212\u597d\u9003\u751f\u8def\u7ebf\u3002\u4f8b\u5982\uff0c\u572810\u7ea7\u5173\u5361\uff0c\u5411\u5de6\u6295\u63b7\u77f3\u5934\u5e76\u5411\u53f3\u79fb\u52a8\u53ef\u4ee5\u6709\u6548\u5730\u8f6c\u79fb\u6ce8\u610f\u529b\u3002"}, {"question": "\u5728\u300a\u7a83\u8d3c\u4e4b\u8c1c\u300b\u7684\u9ad8\u7ea7\u6e38\u620f\u4e2d\uff0c\u6211\u5e94\u8be5\u4f18\u5148\u5347\u7ea7\u54ea\u4e9b\u6280\u80fd\uff1f", "answer": "\u4e3a\u4e86\u8fdb\u884c\u9ad8\u7ea7\u6e38\u620f\uff0c\u4f18\u5148\u5347\u7ea7\u6f5c\u884c\u548c\u5f00\u9501\u6280\u80fd\u3002\u6f5c\u884c\u6280\u80fd\u964d\u4f4e\u88ab\u53d1\u73b0\u7684\u51e0\u7387\uff0c\u800c\u5f00\u9501\u6280\u80fd\u5219\u5141\u8bb8\u4f60\u83b7\u53d6\u9ad8\u4ef7\u503c\u7684\u6218\u5229\u54c1\u3002\u4f8b\u5982\uff0c\u572815\u7ea7\u5173\u5361\u4e2d\uff0c\u5347\u7ea7\u7684\u5f00\u9501\u6280\u80fd\u8ba9\u4f60\u6253\u5f00\u4e00\u4e2a\u5305\u542b\u7a00\u6709\u7269\u54c1\u7684\u7bb1\u5b50\uff0c\u8fd9\u6781\u5927\u5730\u63d0\u5347\u4e86\u4f60\u7684\u5f97\u5206\u3002"}, {"question": "\u5728\u300a\u7a83\u8d3c\u4e4b\u8c1c\u300b\u4e2d\uff0c\u4e3a\u4ec0\u4e48\u9700\u8981\u7ba1\u7406\u7269\u54c1\u680f\u7a7a\u95f4\uff1f", "answer": "\u7ba1\u7406\u7269\u54c1\u680f\u7a7a\u95f4\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u4f1a\u5f71\u54cd\u4f60\u643a\u5e26\u91cd\u8981\u7269\u54c1\u7684\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u572820\u7ea7\u5173\u5361\uff0c\u4f60\u53ef\u80fd\u9700\u8981\u540c\u65f6\u643a\u5e26\u591a\u628a\u94a5\u5319\u548c\u5de5\u5177\u3002\u7269\u54c1\u680f\u8fc7\u8f7d\u53ef\u80fd\u4f1a\u8feb\u4f7f\u4f60\u4e22\u5f03\u91cd\u8981\u7269\u54c1\uff0c\u963b\u788d\u6e38\u620f\u8fdb\u7a0b\u3002\u8bf7\u59cb\u7ec8\u6839\u636e\u5f53\u524d\u9700\u6c42\u4f18\u5148\u8003\u8651\u7269\u54c1\u3002"}, {"question": "\u300a\u7a83\u8d3c\u4e4b\u8c1c\u300b\u4e2d\u7684\u63a2\u6d4b\u7cfb\u7edf\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u7a83\u8d3c\u4e4b\u8c1c\u300b\u4e2d\u7684\u63a2\u6d4b\u7cfb\u7edf\u57fa\u4e8e\u89c6\u7ebf\u548c\u58f0\u97f3\u3002\u5b88\u536b\u62e5\u6709\u4e00\u4e2a\u89c6\u9525\u4f53\uff0c\u4ee3\u8868\u4ed6\u4eec\u7684\u89c6\u91ce\u8303\u56f4\u3002\u5728\u8be5\u89c6\u9525\u4f53\u8303\u56f4\u5185\u79fb\u52a8\u6216\u53d1\u51fa\u58f0\u97f3\uff08\u4f8b\u5982\u5954\u8dd1\uff09\u90fd\u4f1a\u589e\u52a0\u88ab\u53d1\u73b0\u7684\u98ce\u9669\u3002\u4f8b\u5982\uff0c\u57285\u7ea7\u5173\u5361\u4e2d\uff0c\u5728\u5b88\u536b\u8eab\u540e\u8e72\u4e0b\u5e76\u7f13\u6162\u79fb\u52a8\u53ef\u4ee5\u907f\u514d\u88ab\u53d1\u73b0\u3002"}, {"question": "\u300a\u7a83\u8d3c\u4e4b\u8c1c\u300b\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8ba1\u7b97\u6700\u7ec8\u5f97\u5206\u7684\uff1f", "answer": "\u300a\u7a83\u8d3c\u4e4b\u8c1c\u300b\u7684\u8bc4\u5206\u7cfb\u7edf\u6839\u636e\u4ee5\u4e0b\u51e0\u4e2a\u56e0\u7d20\u8ba1\u7b97\u6700\u7ec8\u5f97\u5206\uff1a\u6240\u7528\u65f6\u95f4\u3001\u6536\u96c6\u7684\u7269\u54c1\u4ee5\u53ca\u6f5c\u884c\u7b49\u7ea7\u3002\u4f8b\u5982\uff0c\u5feb\u901f\u5b8c\u6210\u5173\u5361\u3001\u6536\u96c6\u6240\u6709\u7269\u54c1\u5e76\u4fdd\u6301\u4e0d\u88ab\u53d1\u73b0\u5c06\u83b7\u5f97\u6700\u9ad8\u5206\u3002\u6bcf\u4e2a\u56e0\u7d20\u90fd\u6709\u7279\u5b9a\u7684\u6743\u91cd\uff0c\u5176\u4e2d\u6f5c\u884c\u662f\u6700\u91cd\u8981\u7684\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5c06\u300a\u7a83\u8d3c\u4e4b\u8c1c\u300b\u7684PC\u8fdb\u5ea6\u8f6c\u79fb\u5230\u79fb\u52a8\u7aef\u5417\uff1f", "answer": "\u662f\u7684\uff0c\u4f60\u53ef\u4ee5\u4f7f\u7528\u4e91\u5b58\u6863\u5c06PC\u8fdb\u5ea6\u8f6c\u79fb\u5230\u79fb\u52a8\u7aef\u3002\u8bf7\u786e\u4fdd\u4f60\u5728\u4e24\u4e2a\u5e73\u53f0\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u8d26\u6237\u3002\u4f8b\u5982\uff0c\u5728PC\u4e0a\u5b8c\u621010\u7ea7\u5173\u5361\u540e\uff0c\u767b\u5f55\u4f60\u7684\u79fb\u52a8\u8bbe\u5907\uff0c\u4f60\u7684\u8fdb\u5ea6\u5c06\u4f1a\u81ea\u52a8\u540c\u6b65\uff0c\u8ba9\u4f60\u53ef\u4ee5\u7ee7\u7eed\u672a\u5b8c\u6210\u7684\u90e8\u5206\u3002"}, {"question": "\u300a\u7a83\u8d3c\u4e4b\u8c1c\u300b\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u5f69\u86cb\uff1f", "answer": "\u300a\u7a83\u8d3c\u4e4b\u8c1c\u300b\u5305\u542b\u591a\u4e2a\u9690\u85cf\u5f69\u86cb\u3002\u4e00\u4e2a\u660e\u663e\u7684\u4f8b\u5b50\u662f\u7b2c12\u5173\u7684\u79d8\u5bc6\u623f\u95f4\u3002\u8981\u8fdb\u5165\u5b83\uff0c\u9700\u8981\u6309\u7167\u7279\u5b9a\u987a\u5e8f\u4e0e\u5899\u58c1\u9762\u677f\u4e92\u52a8\uff1a\u6309\u4e0b\u5b83\u4e09\u6b21\uff0c\u7b49\u5f85\uff0c\u7136\u540e\u518d\u6b21\u6309\u4e0b\u5b83\u4e00\u6b21\u3002\u8fd9\u5c06\u63ed\u793a\u4e00\u4e2a\u5305\u542b\u6e38\u620f\u5b98\u65b9\u6307\u5357\u4e2d\u672a\u5217\u51fa\u7684\u72ec\u7279\u7269\u54c1\u7684\u623f\u95f4\u3002"}]
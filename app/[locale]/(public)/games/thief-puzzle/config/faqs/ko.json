[{"question": "\ub3c4\ub451 \uadf8\ub9bc\uc790 \ud37c\uc990\uc5d0\uc11c \uae30\ubcf8\uc801\uc778 \uc6c0\uc9c1\uc784\uacfc \uc0c1\ud638\uc791\uc6a9\uc740 \uc5b4\ub5bb\uac8c \uc218\ud589\ud558\ub098\uc694?", "answer": "\ub3c4\ub451 \uadf8\ub9bc\uc790 \ud37c\uc990\uc5d0\uc11c \uae30\ubcf8\uc801\uc778 \uc6c0\uc9c1\uc784\uc740 \ud654\uc0b4\ud45c \ud0a4 \ub610\ub294 WASD\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc81c\uc5b4\ud569\ub2c8\ub2e4. \ubb3c\uccb4\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\ub824\uba74 \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \ub204\ub985\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5f4\uc1e0\ub97c \uc9d1\uc73c\ub824\uba74 \uce90\ub9ad\ud130\ub97c \uc5f4\uc1e0 \uc606\uc73c\ub85c \uc774\ub3d9\uc2dc\ud0a8 \ub2e4\uc74c \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \ub204\ub974\uc138\uc694. \uc774\ub807\uac8c \ud558\uba74 \uc5f4\uc1e0\uac00 \uc778\ubca4\ud1a0\ub9ac\uc5d0 \ucd94\uac00\ub418\uba70, 'I' \ud0a4\ub97c \ub20c\ub7ec \uc778\ubca4\ud1a0\ub9ac\ub97c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub3c4\ub451 \uadf8\ub9bc\uc790 \ud37c\uc990\uc5d0\uc11c \uc228\uc5b4 \uc788\uc744 \ub54c\ub3c4 \uce90\ub9ad\ud130\uac00 \uc7a1\ud788\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc228\uc5b4 \uc788\uc744 \ub54c \uc7a1\ud788\ub294 \uac83\uc740 \uc5ec\ub7ec \uac00\uc9c0 \uc694\uc778 \ub54c\ubb38\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uccab\uc9f8, \uacbd\ube44\uc6d0\uc758 \uc2dc\uc57c\uc5d0\uc11c \uc644\uc804\ud788 \ubc97\uc5b4\ub0ac\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ubcbd \ub4a4\uc5d0 \uc228\ub294 \uac83\uc740 \uacbd\ube44\uc6d0\uc774 \uc5ec\uc804\ud788 \uadf8\ub9bc\uc790\ub97c \ubcfc \uc218 \uc788\ub2e4\uba74 \ucda9\ubd84\ud558\uc9c0 \uc54a\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub458\uc9f8, \uc77c\ubd80 \uacbd\ube44\uc6d0\uc740 \uac10\uac01\uc774 \uc608\ubbfc\ud558\uc5ec \uadf8\ub9bc\uc790 \uc18d\uc5d0\uc11c\ub3c4 \uc6c0\uc9c1\uc784\uc744 \uac10\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc6c0\uc9c1\uc774\uae30 \uc804\uc5d0 \ud56d\uc0c1 \uacbd\ube44\uc6d0\uc758 \uc21c\ucc30 \uacbd\ub85c\ub97c \uad00\ucc30\ud558\uc138\uc694."}, {"question": "\ub3c4\ub451 \uadf8\ub9bc\uc790 \ud37c\uc990\uc758 \ucd08\uae30 \ub2e8\uacc4\uc5d0\uc11c \uc218\uc9d1\ud574\uc57c \ud558\ub294 \ud544\uc218 \uc544\uc774\ud15c\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ucd08\uae30 \ub2e8\uacc4\uc5d0\uc11c\ub294 \uc5f4\uc1e0\uc640 \uc7a0\uae08 \ud574\uc81c \ub3c4\uad6c\ub97c \uc218\uc9d1\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \uc5f4\uc1e0\ub294 \ubb38\uc744 \uc5f4 \uc218 \uc788\ub294 \ud544\uc218\uc801\uc778 \uc694\uc18c\uc774\uace0, \uc7a0\uae08 \ud574\uc81c \ub3c4\uad6c\ub294 \uc7a0\uae34 \uc0c1\uc790\ub97c \uc5f4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\ub294 \uc778\uc811\ud55c \ubc29\uc5d0 \uc788\ub294 \uc5f4\uc1e0\uac00 \ud544\uc694\ud55c \uc7a0\uae34 \ubb38\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc6d0\ud65c\ud55c \uc9c4\ud589\uc744 \uc704\ud574 \ud56d\uc0c1 \uc774\ub7ec\ud55c \uc544\uc774\ud15c \uc6b0\uc120\uc21c\uc704\ub97c \uc815\ud558\uc138\uc694."}, {"question": "100\uc2dc\uac04\uc758 \ud50c\ub808\uc774 \ud6c4 \ub3c4\ub451 \uadf8\ub9bc\uc790 \ud37c\uc990\uc5d0\uc11c \uc2a4\ud154\uc2a4 \uc804\ub7b5\uc744 \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\ub098\uc694?", "answer": "100\uc2dc\uac04\uc774 \uc9c0\ub09c \ud6c4\uc5d0\ub294 \uacbd\ube44\uc6d0 \ud328\ud134\uacfc \uc0b0\ub780 \uc694\uc18c\ub97c \uc219\ub2ec\ud558\uc5ec \uc2a4\ud154\uc2a4 \uc804\ub7b5\uc744 \ucd5c\uc801\ud654\ud558\uc138\uc694. STEP1: \uacbd\ube44\uc6d0\uc758 \uacbd\ub85c\uc640 \uc2dc\uac04\uc744 \uad00\ucc30\ud569\ub2c8\ub2e4. STEP2: \ub3cc\uacfc \uac19\uc740 \ud22c\ucc99 \ubb3c\uccb4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc0b0\ub780 \uc694\uc18c\ub97c \ub9cc\ub4ed\ub2c8\ub2e4. STEP3: \ud56d\uc0c1 \ud0c8\ucd9c \uacbd\ub85c\ub97c \uacc4\ud68d\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 10\ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c \uc624\ub978\ucabd\uc73c\ub85c \uc774\ub3d9\ud558\uba74\uc11c \uc67c\ucabd\uc73c\ub85c \ub3cc\uc744 \ub358\uc9c0\uba74 \uc8fc\uc758\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc0b0\ub9cc\ud558\uac8c \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uace0\uae09 \ud50c\ub808\uc774\ub97c \uc704\ud574 \ub3c4\ub451 \uadf8\ub9bc\uc790 \ud37c\uc990\uc5d0\uc11c \uc5b4\ub5a4 \uc2a4\ud0ac\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud574\uc57c \ud558\ub098\uc694?", "answer": "\uace0\uae09 \ud50c\ub808\uc774\ub97c \uc704\ud574 \uc2a4\ud154\uc2a4\uc640 \uc7a0\uae08 \ud574\uc81c \uc2a4\ud0ac\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc138\uc694. \uc2a4\ud154\uc2a4\ub294 \uac10\uc9c0\ub420 \uac00\ub2a5\uc131\uc744 \uc904\uc5ec\uc8fc\uace0, \uc7a0\uae08 \ud574\uc81c\ub294 \uace0\uac00\uc758 \ubcf4\ubb3c\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\uac8c \ud574\uc90d\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 15\ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c\ub294 \uc5c5\uadf8\ub808\uc774\ub4dc\ub41c \uc7a0\uae08 \ud574\uc81c \uc2a4\ud0ac\uc744 \ud1b5\ud574 \uc810\uc218\ub97c \ud06c\uac8c \ub192\uc774\ub294 \ud76c\uadc0\ud55c \uc720\ubb3c\uc774 \ub4e4\uc5b4\uc788\ub294 \uc0c1\uc790\ub97c \uc5f4 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub3c4\ub451 \uadf8\ub9bc\uc790 \ud37c\uc990\uc5d0\uc11c \uc778\ubca4\ud1a0\ub9ac \uacf5\uac04\uc744 \uad00\ub9ac\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc778\ubca4\ud1a0\ub9ac \uacf5\uac04\uc744 \uad00\ub9ac\ud558\ub294 \uac83\uc740 \ud544\uc218 \uc544\uc774\ud15c\uc744 \ud734\ub300\ud560 \uc218 \uc788\ub294 \ub2a5\ub825\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 20\ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c\ub294 \uc5ec\ub7ec \uac1c\uc758 \uc5f4\uc1e0\uc640 \ub3c4\uad6c\ub97c \ub3d9\uc2dc\uc5d0 \ud734\ub300\ud574\uc57c \ud560 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. \uc778\ubca4\ud1a0\ub9ac\uac00 \uacfc\ubd80\ud558\ub418\uba74 \uc911\uc694\ud55c \uc544\uc774\ud15c\uc744 \ubc84\ub824\uc57c \ud558\uba70, \uc774\ub294 \uc9c4\ud589\uc5d0 \ubc29\ud574\uac00 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud56d\uc0c1 \uc989\uac01\uc801\uc778 \ud544\uc694\uc5d0 \ub530\ub77c \uc544\uc774\ud15c\uc744 \uc6b0\uc120\uc21c\uc704\ub85c \uc815\ud558\uc138\uc694."}, {"question": "\ub3c4\ub451 \uadf8\ub9bc\uc790 \ud37c\uc990\uc758 \uac10\uc9c0 \uc2dc\uc2a4\ud15c\uc758 \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub3c4\ub451 \uadf8\ub9bc\uc790 \ud37c\uc990\uc758 \uac10\uc9c0 \uc2dc\uc2a4\ud15c\uc740 \uc2dc\uc57c\uc640 \uc18c\ub9ac\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uacbd\ube44\uc6d0\uc740 \uc2dc\uc57c\ub97c \ub098\ud0c0\ub0b4\ub294 \uc2dc\uc57c \uc6d0\ubfd4\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc6d0\ubfd4 \ub0b4\uc5d0\uc11c \uc6c0\uc9c1\uc774\uac70\ub098 \ub2ec\ub9ac\uae30\uc640 \uac19\uc740 \uc18c\uc74c\uc744 \ub0b4\uba74 \uac10\uc9c0 \uc704\ud5d8\uc774 \ub192\uc544\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 5\ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c \uacbd\ube44\uc6d0\uc758 \ub4f1 \ub4a4\uc5d0 \uc6c5\ud06c\ub9ac\uace0 \ucc9c\ucc9c\ud788 \uc6c0\uc9c1\uc774\uba74 \uac10\uc9c0\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."}, {"question": "\ub3c4\ub451 \uadf8\ub9bc\uc790 \ud37c\uc990\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ucd5c\uc885 \uc810\uc218\ub97c \uc5b4\ub5bb\uac8c \uacc4\uc0b0\ud558\ub098\uc694?", "answer": "\ub3c4\ub451 \uadf8\ub9bc\uc790 \ud37c\uc990\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc18c\uc694 \uc2dc\uac04, \uc218\uc9d1\ud55c \uc544\uc774\ud15c \ubc0f \uc2a4\ud154\uc2a4 \uc218\uc900\uc744 \uae30\ubc18\uc73c\ub85c \ucd5c\uc885 \uc810\uc218\ub97c \uacc4\uc0b0\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubaa8\ub4e0 \uc544\uc774\ud15c\uc744 \uc218\uc9d1\ud558\uace0 \uac10\uc9c0\ub418\uc9c0 \uc54a\uc740 \uc0c1\ud0dc\ub85c \ub808\ubca8\uc744 \ube60\ub974\uac8c \uc644\ub8cc\ud558\uba74 \ucd5c\uace0 \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac01 \uc694\uc18c\ub294 \ud2b9\uc815 \uac00\uc911\uce58\ub97c \uac00\uc9c0\uba70, \uc2a4\ud154\uc2a4\ub294 \uac00\uc7a5 \uc911\uc694\ud55c \uc694\uc18c\uc785\ub2c8\ub2e4."}, {"question": "PC\uc5d0\uc11c \ubaa8\ubc14\uc77c\ub85c \ub3c4\ub451 \uadf8\ub9bc\uc790 \ud37c\uc990 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub124, \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \uc0ac\uc6a9\ud558\uc5ec PC\uc5d0\uc11c \ubaa8\ubc14\uc77c\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub450 \ud50c\ub7ab\ud3fc \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c 10\ubc88\uc9f8 \ub808\ubca8\uc744 \uc644\ub8cc\ud55c \ud6c4 \ubaa8\ubc14\uc77c \uae30\uae30\ub85c \ub85c\uadf8\uc778\ud558\uba74 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc790\ub3d9\uc73c\ub85c \ub3d9\uae30\ud654\ub418\uc5b4 \uc911\ub2e8\ud588\ub358 \uc9c0\uc810\ubd80\ud130 \uacc4\uc18d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub3c4\ub451 \uadf8\ub9bc\uc790 \ud37c\uc990\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\ub098\uc694?", "answer": "\ub3c4\ub451 \uadf8\ub9bc\uc790 \ud37c\uc990\uc5d0\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ub208\uc5d0 \ub744\ub294 \uc608\ub294 12\ubc88\uc9f8 \ub808\ubca8\uc758 \ube44\ubc00 \ubc29\uc785\ub2c8\ub2e4. \ud2b9\uc815 \ubcbd \ud328\ub110\uacfc \uc0c1\ud638 \uc791\uc6a9\ud558\uc5ec \uc774 \ubc29\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 3\ubc88 \ub204\ub974\uace0 \uae30\ub2e4\ub9b0 \ub2e4\uc74c \ud55c \ubc88 \ub354 \ub204\ub974\uc138\uc694. \uc774\ub807\uac8c \ud558\uba74 \uac8c\uc784 \uacf5\uc2dd \uac00\uc774\ub4dc\uc5d0 \ub098\uc640\uc788\uc9c0 \uc54a\uc740 \uace0\uc720\ud55c \uc544\uc774\ud15c\uc774 \uc788\ub294 \ubc29\uc774 \ub098\ud0c0\ub0a9\ub2c8\ub2e4."}]
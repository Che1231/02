[{"question": "8\ubcfc \ube4c\ub9ac\uc5b4\ub4dc \ud074\ub798\uc2dd\uc5d0\uc11c \uae30\ubcf8 \uc0f7\uc744 \uc5b4\ub5bb\uac8c \uc218\ud589\ud560 \uc218 \uc788\ub098\uc694?", "answer": "8\ubcfc \ube4c\ub9ac\uc5b4\ub4dc \ud074\ub798\uc2dd\uc5d0\uc11c \uae30\ubcf8 \uc0f7\uc744 \uc218\ud589\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: \ub2e8\uacc4 1 \u2013 \ud654\uba74\uc744 \ub530\ub77c \uc190\uac00\ub77d\uc73c\ub85c \ud050\ubcfc\uc744 \ud050 \uc2a4\ud2f1\uacfc \uc77c\uce58\uc2dc\ud0b5\ub2c8\ub2e4. \ub2e8\uacc4 2 \u2013 \ud798 \uc870\uc808\uae30\ub97c \ub2f9\uae30\uace0 \ub193\uc544 \uc0f7\uc758 \ud798\uc744 \uc870\uc808\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3 \u2013 \ud0c0\uac9f \ubcfc\uc744 \uc870\uc900\ud558\uace0 \uc0f7\uc744 \uc2e4\ud589\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc624\ud504\ub2dd \ube0c\ub808\uc774\ud06c\uc5d0\uc11c 1\ubc88 \uacf5\uc744 \uc870\uc900\ud558\uba74 \uac8c\uc784\uc758 \uac15\ub825\ud55c \uae30\ubc18\uc744 \ub9c8\ub828\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud798 \uc870\uc808\uae30\ub97c \uc2ac\ub9c1\uc0f7\uc5d0 \ube44\uc720\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2f9\uae38\uc218\ub85d \uc0f7\uc758 \ud798\uc774 \uac15\ud574\uc9d1\ub2c8\ub2e4.]"}, {"question": "8\ubcfc \ube4c\ub9ac\uc5b4\ub4dc \ud074\ub798\uc2dd\uc5d0\uc11c \uc704\uce58 \uc120\uc815\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "8\ubcfc \ube4c\ub9ac\uc5b4\ub4dc \ud074\ub798\uc2dd\uc5d0\uc11c \uc704\uce58 \uc120\uc815\uc740 \ub2e4\uc74c \uc0f7\uc744 \uacb0\uc815\ud558\uae30 \ub54c\ubb38\uc5d0 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc88b\uc740 \uc704\uce58 \uc120\uc815\uc740 \uc5f0\uc18d\uc801\uc778 \uc0f7\uc744 \uc124\uc815\ud558\uace0 \uac8c\uc784 \ud750\ub984\uc744 \uc81c\uc5b4\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 2\ubc88 \uacf5\uc744 \ub123\uc740 \ud6c4 3\ubc88 \uacf5 \uadfc\ucc98\uc5d0 \ud050\ubcfc\uc744 \uc704\uce58\uc2dc\ucf1c \uc27d\uac8c 3\ubc88 \uacf5\uc744 \ub123\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc0f7 -> \uc704\uce58 -> \ub2e4\uc74c \uc0f7 -> \uc2b9\ub9ac]."}, {"question": "8\ubcfc \ube4c\ub9ac\uc5b4\ub4dc \ud074\ub798\uc2dd \ucd08\ubcf4\uc790\ub85c\uc11c \uc54c\uc544\uc57c \ud560 \uae30\ubcf8 \uaddc\uce59\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "8\ubcfc \ube4c\ub9ac\uc5b4\ub4dc \ud074\ub798\uc2dd \ucd08\ubcf4\uc790\ub85c\uc11c \uc54c\uc544\uc57c \ud560 \uae30\ubcf8 \uaddc\uce59\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: 1) \uac8c\uc784\uc740 \ube0c\ub808\uc774\ud06c \uc0f7\uc73c\ub85c \uc2dc\uc791\ud569\ub2c8\ub2e4. 2) \ud569\ubc95\uc801\uc73c\ub85c \ub123\uc740 \uccab \ubc88\uc9f8 \uacf5\uc5d0 \ub530\ub77c \uc194\ub9ac\ub4dc \ub610\ub294 \uc2a4\ud2b8\ub77c\uc774\ud504 \uc911 \ud558\ub098\ub97c \ub123\uc5b4\uc57c \ud569\ub2c8\ub2e4. 3) 8\ubc88 \uacf5\uc744 \ub9c8\uc9c0\ub9c9\uc73c\ub85c \ub123\uc5b4\uc57c \uac8c\uc784\uc5d0\uc11c \uc2b9\ub9ac\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc194\ub9ac\ub4dc \uacf5\uc744 \uba3c\uc800 \ub123\uc73c\uba74 \uc194\ub9ac\ub4dc \uacf5\uc744 \uacc4\uc18d\ud574\uc11c \ub123\uc5b4\uc57c \ud569\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \uc194\ub9ac\ub4dc \ub300 \uc2a4\ud2b8\ub77c\uc774\ud504]."}, {"question": "8\ubcfc \ube4c\ub9ac\uc5b4\ub4dc \ud074\ub798\uc2dd\uc5d0\uc11c \ubc45\ud06c \uc0f7\uc744 \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\ub098\uc694?", "answer": "8\ubcfc \ube4c\ub9ac\uc5b4\ub4dc \ud074\ub798\uc2dd\uc5d0\uc11c \ubc45\ud06c \uc0f7\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub824\uba74 \uc5f0\uc2b5\uacfc \uc815\ud655\uc131\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1 \u2013 \ubcfc\uc774 \ucfe0\uc158\uc5d0\uc11c \ud295\uaca8 \ub098\uc640\uc57c \ud558\ub294 \uac01\ub3c4\ub97c \ud30c\uc545\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2 \u2013 \ubcfc\uc774 \ubaa9\ud45c\ubb3c\uc5d0 \ub3c4\ub2ec\ud558\ub3c4\ub85d \ud798\uc744 \uc870\uc815\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3 \u2013 \ud14c\uc774\ube14\uc5d0\uc11c \ub2e4\ub978 \uac01\ub3c4\ub97c \uc5f0\uc2b5\ud558\uc5ec \uac10\uac01\uc744 \uc775\ud799\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucf54\ub108 \ud3ec\ucf13\uc5d0 \ub123\uae30 \uc704\ud574 4\ubc88 \uacf5\uc744 \uce21\uba74 \ucfe0\uc158\uc5d0 \ubc45\ud06c \uc2dc\ucf1c\ubcf4\uc138\uc694. [\ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: \uc9c1\uc811 \uc0f7 \ub300 \ubc45\ud06c \uc0f7]."}, {"question": "8\ubcfc \ube4c\ub9ac\uc5b4\ub4dc \ud074\ub798\uc2dd\uc5d0\uc11c \ub354 \ub9ce\uc740 \uac8c\uc784\uc744 \uc774\uae30\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ub294 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "8\ubcfc \ube4c\ub9ac\uc5b4\ub4dc \ud074\ub798\uc2dd\uc5d0\uc11c \ub354 \ub9ce\uc740 \uac8c\uc784\uc744 \uc774\uae30\ub824\uba74 \ub2e4\uc74c \uc804\ub7b5\ub4e4\uc744 \ud65c\uc6a9\ud558\uc138\uc694: 1) \ud56d\uc0c1 \ub450 \uc0f7 \uc55e\uc744 \uacc4\ud68d\ud569\ub2c8\ub2e4. 2) \ub2e4\uc74c \uc0f7\uc744 \uc124\uc815\ud558\uae30 \uc704\ud574 \ud050\ubcfc\uc758 \uc704\uce58\ub97c \uc81c\uc5b4\ud569\ub2c8\ub2e4. 3) \ud6a8\uc728\uc801\uc73c\ub85c \uacf5 \uadf8\ub8f9\uc744 \ub123\ub294 \ub370 \uc9d1\uc911\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub9cc\uc57d 5\ubc88 \uacf5\uc744 \uc27d\uac8c \ub123\uc744 \uc218 \uc788\ub2e4\uba74, \ub2e4\uc74c \uc0f7\uc744 \uc704\ud574 \ud050\ubcfc\uc744 6\ubc88 \uacf5 \uadfc\ucc98\uc5d0 \uc704\uce58\uc2dc\ud0b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uac8c\uc784\uc744 \uccb4\uc2a4\uc640 \uac19\uc774 \uc0dd\uac01\ud558\uc138\uc694. \uac01 \uc774\ub3d9\uc740 \ub2e4\uc74c \uc774\ub3d9\uc744 \uc124\uc815\ud569\ub2c8\ub2e4.]"}, {"question": "8\ubcfc \ube4c\ub9ac\uc5b4\ub4dc \ud074\ub798\uc2dd\uc5d0\uc11c \ube0c\ub808\uc774\ud06c \uc0f7\uc758 \uc911\uc694\uc131\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "8\ubcfc \ube4c\ub9ac\uc5b4\ub4dc \ud074\ub798\uc2dd\uc5d0\uc11c \ube0c\ub808\uc774\ud06c \uc0f7\uc740 \uac8c\uc784\uc758 \ubd84\uc704\uae30\ub97c \uc124\uc815\ud558\ub294 \ub370 \uc911\uc694\ud569\ub2c8\ub2e4. \uac15\ub825\ud55c \ube0c\ub808\uc774\ud06c\ub294 \ubcfc\uc744 \ub113\uac8c \ud769\ubfcc\ub9b4 \uc218 \uc788\uc73c\ubbc0\ub85c \ub354 \ub9ce\uc740 \ub123\uc744 \uae30\ud68c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac15\ub825\ud558\uace0 \uac01\ub3c4\uac00 \uc798 \uc7a1\ud78c \ube0c\ub808\uc774\ud06c\ub294 \uc5ec\ub7ec \uac1c\uc758 \uacf5\uc744 \ub123\uc744 \uc218 \uc788\uc73c\uba70 \ucd08\uae30 \uc6b0\uc704\ub97c \ud655\ubcf4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \uac15\ub825\ud55c \ube0c\ub808\uc774\ud06c \ub300 \uc57d\ud55c \ube0c\ub808\uc774\ud06c]."}, {"question": "\ubb3c\ub9ac \uc5d4\uc9c4\uc740 8\ubcfc \ube4c\ub9ac\uc5b4\ub4dc \ud074\ub798\uc2dd \uac8c\uc784\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "8\ubcfc \ube4c\ub9ac\uc5b4\ub4dc \ud074\ub798\uc2dd\uc758 \ubb3c\ub9ac \uc5d4\uc9c4\uc740 \uc2e4\uc81c \ubcfc\uc758 \uc6c0\uc9c1\uc784\uc744 \uc2dc\ubbac\ub808\uc774\uc158\ud558\uc5ec \uac8c\uc784\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc774\uc5d0\ub294 \ud68c\uc804, \uc18d\ub3c4 \ubc0f \uac01\ub3c4\uc640 \uac19\uc740 \uc694\uc18c\uac00 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubc31\uc2a4\ud540\uc744 \uc801\uc6a9\ud558\uba74 \uc0f7 \ud6c4 \ud050\ubcfc\uc758 \uc704\uce58\ub97c \uc81c\uc5b4\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ubb3c\ub9ac \uc5d4\uc9c4\uc740 \uc2e4\uc81c \ube4c\ub9ac\uc5b4\ub4dc \ud14c\uc774\ube14\uacfc \uac19\uc73c\uba70 \uc2e4\uc81c \uc5ed\ud559\uc744 \uc7ac\ud604\ud569\ub2c8\ub2e4.]"}, {"question": "\ub2e8\uc77c \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \ud575\uc2ec \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "8\ubcfc \ube4c\ub9ac\uc5b4\ub4dc \ud074\ub798\uc2dd\uc5d0\uc11c \ub2e8\uc77c \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \ud575\uc2ec \ucc28\uc774\uc810\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: 1) \ub2e8\uc77c \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \uc5f0\uc2b5\uacfc \uae30\uc220 \ud5a5\uc0c1\uc5d0 \uc911\uc810\uc744 \ub450\ub294 \ubc18\uba74, \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \uc2e4\uc2dc\uac04 \uacbd\uc7c1\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. 2) \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \uce5c\uad6c \ub610\ub294 \uc804 \uc138\uacc4 \ud50c\ub808\uc774\uc5b4\uc640 \uacbd\uc7c1\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uba40\ud2f0\ud50c\ub808\uc774\uc5b4\uc5d0\uc11c \uc0c1\ub300\ubc29\uc758 \uc608\uce21 \ubd88\uac00\ub2a5\ud55c \uc804\ub7b5\uc5d0 \uc9c1\uba74\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: \ub2e8\uc77c \ud50c\ub808\uc774\uc5b4 \ub300 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4]."}, {"question": "8\ubcfc \ube4c\ub9ac\uc5b4\ub4dc \ud074\ub798\uc2dd\uc5d0\uc11c \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\ub978 \uae30\uae30\ub85c \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694?", "answer": "8\ubcfc \ube4c\ub9ac\uc5b4\ub4dc \ud074\ub798\uc2dd\uc5d0\uc11c \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\ub978 \uae30\uae30\ub85c \uc804\uc1a1\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: \ub2e8\uacc4 1 \u2013 \ub450 \uae30\uae30 \ubaa8\ub450 \uac19\uc740 \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2 \u2013 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5c5\ub85c\ub4dc\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3 \u2013 \uc0c8 \uae30\uae30\uc5d0\uc11c \uc800\uc7a5\ub41c \ub370\uc774\ud130\ub97c \ub2e4\uc6b4\ub85c\ub4dc\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc548\ub4dc\ub85c\uc774\ub4dc \uae30\uae30\uc5d0\uc11c iOS \uae30\uae30\ub85c \uc804\ud658\ud560 \ub54c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \uc0ac\uc6a9\ud558\uba74 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc720\uc9c0\ub429\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uae30\uae30 A -> \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 -> \uae30\uae30 B]."}, {"question": "8\ubcfc \ube4c\ub9ac\uc5b4\ub4dc \ud074\ub798\uc2dd\uc5d0 \uc228\uaca8\uc9c4 \uc131\ucde8\ub3c4\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\ub098\uc694?", "answer": "\ub124, 8\ubcfc \ube4c\ub9ac\uc5b4\ub4dc \ud074\ub798\uc2dd\uc5d0\ub294 \uc228\uaca8\uc9c4 \uc131\ucde8\ub3c4\uc640 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ube0c\ub808\uc774\ud06c \uc0f7\uc73c\ub85c 8\ubc88 \uacf5\uc744 \ub123\uc73c\uba74 \ud2b9\ubcc4\ud55c \uc131\ucde8\ub3c4\uac00 \ud574\uc81c\ub429\ub2c8\ub2e4. \ub2e4\uc591\ud55c \uc0f7 \uc870\ud569\uacfc \ub3c5\ud2b9\ud55c \uac8c\uc784 \uc2dc\ub098\ub9ac\uc624\ub97c \ud0d0\ud5d8\ud558\uba74 \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uc744 \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ubc1c\uacac\ud558\ub294 \uac83\uc740 \uac8c\uc784\uc5d0\uc11c \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uc744 \ucc3e\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}]
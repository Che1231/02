[{"question": "\u5982\u4f55\u57288\u7403\u53f0\u7403\u7ecf\u5178\u7248\u4e2d\u6267\u884c\u57fa\u672c\u51fb\u7403\uff1f", "answer": "\u8981\u57288\u7403\u53f0\u7403\u7ecf\u5178\u7248\u4e2d\u6267\u884c\u57fa\u672c\u51fb\u7403\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u901a\u8fc7\u5728\u5c4f\u5e55\u4e0a\u62d6\u52a8\u624b\u6307\uff0c\u4f7f\u7403\u6746\u4e0e\u6bcd\u7403\u5bf9\u9f50\u3002\u6b65\u9aa42 - \u901a\u8fc7\u62c9\u52a8\u5e76\u91ca\u653e\u529b\u91cf\u8ba1\u8c03\u6574\u51fb\u7403\u529b\u5ea6\u3002\u6b65\u9aa43 - \u7784\u51c6\u76ee\u6807\u7403\u5e76\u91ca\u653e\u8fdb\u884c\u51fb\u7403\u3002\u4f8b\u5982\uff0c\u5728\u5f00\u7403\u9636\u6bb5\u7784\u51c61\u53f7\u7403\u53ef\u4ee5\u4e3a\u6e38\u620f\u5960\u5b9a\u575a\u5b9e\u7684\u57fa\u7840\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u529b\u91cf\u8ba1\u60f3\u8c61\u6210\u5f39\u5f13\uff1b\u62c9\u5f97\u8d8a\u8fdc\uff0c\u51fb\u7403\u529b\u5ea6\u8d8a\u5927\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u57288\u7403\u53f0\u7403\u7ecf\u5178\u7248\u4e2d\u5b9a\u4f4d\u5f88\u91cd\u8981\uff1f", "answer": "\u57288\u7403\u53f0\u7403\u7ecf\u5178\u7248\u4e2d\uff0c\u5b9a\u4f4d\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u51b3\u5b9a\u7740\u4f60\u7684\u4e0b\u4e00\u51fb\u3002\u826f\u597d\u7684\u5b9a\u4f4d\u53ef\u4ee5\u8ba9\u4f60\u8bbe\u7f6e\u8fde\u7eed\u7684\u51fb\u7403\uff0c\u5e76\u63a7\u5236\u6e38\u620f\u8282\u594f\u3002\u4f8b\u5982\uff0c\u51fb\u843d2\u53f7\u7403\u540e\uff0c\u5c06\u6bcd\u7403\u6446\u653e\u57283\u53f7\u7403\u9644\u8fd1\uff0c\u4ee5\u4fbf\u8f7b\u677e\u8fdb\u884c\u540e\u7eed\u51fb\u7403\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u51fb\u7403 -> \u5b9a\u4f4d -> \u4e0b\u4e00\u51fb -> \u80dc\u5229\u3002]"}, {"question": "\u4f5c\u4e3a8\u7403\u53f0\u7403\u7ecf\u5178\u7248\u7684\u521d\u5b66\u8005\uff0c\u6211\u9700\u8981\u4e86\u89e3\u54ea\u4e9b\u57fa\u672c\u89c4\u5219\uff1f", "answer": "\u4f5c\u4e3a8\u7403\u53f0\u7403\u7ecf\u5178\u7248\u7684\u521d\u5b66\u8005\uff0c\u4f60\u9700\u8981\u4e86\u89e3\u4ee5\u4e0b\u57fa\u672c\u89c4\u5219\uff1a1\uff09\u6e38\u620f\u4ece\u51fb\u7403\u5f00\u59cb\u30022\uff09\u4f60\u5fc5\u987b\u6309\u7167\u4f60\u5408\u6cd5\u51fb\u843d\u7684\u7b2c\u4e00\u9897\u7403\uff0c\u51fb\u843d\u5b9e\u8272\u7403\u6216\u6761\u7eb9\u7403\u30023\uff098\u53f7\u7403\u662f\u6700\u540e\u51fb\u843d\u7684\u7403\uff0c\u4ee5\u8d62\u5f97\u6bd4\u8d5b\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5148\u51fb\u843d\u4e00\u4e2a\u5b9e\u8272\u7403\uff0c\u4f60\u5fc5\u987b\u7ee7\u7eed\u51fb\u843d\u5b9e\u8272\u7403\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u5b9e\u8272\u7403\u4e0e\u6761\u7eb9\u7403\u3002]"}, {"question": "\u5982\u4f55\u57288\u7403\u53f0\u7403\u7ecf\u5178\u7248\u4e2d\u6539\u8fdb\u6211\u7684\u5e93\u7403\uff1f", "answer": "\u57288\u7403\u53f0\u7403\u7ecf\u5178\u7248\u4e2d\u6539\u8fdb\u5e93\u7403\u9700\u8981\u7ec3\u4e60\u548c\u7cbe\u786e\u5ea6\u3002\u6b65\u9aa41 - \u786e\u5b9a\u7403\u9700\u8981\u5f39\u8df3\u5230\u54ea\u4e00\u4e2a\u5e93\u7684\u54ea\u4e2a\u89d2\u5ea6\u3002\u6b65\u9aa42 - \u8c03\u6574\u529b\u91cf\uff0c\u786e\u4fdd\u7403\u5230\u8fbe\u76ee\u6807\u4f4d\u7f6e\u3002\u6b65\u9aa43 - \u7ec3\u4e60\u4e0d\u540c\u7684\u89d2\u5ea6\uff0c\u4ee5\u4fbf\u5bf9\u53f0\u9762\u6709\u611f\u89c9\u3002\u4f8b\u5982\uff0c\u5c1d\u8bd5\u5c064\u53f7\u7403\u649e\u51fb\u8fb9\u5e93\uff0c\u4f7f\u5176\u8fdb\u5165\u89d2\u888b\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u76f4\u63a5\u51fb\u7403\u4e0e\u5e93\u7403\u3002]"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u53ef\u4ee5\u5e2e\u52a9\u6211\u57288\u7403\u53f0\u7403\u7ecf\u5178\u7248\u4e2d\u8d62\u5f97\u66f4\u591a\u6e38\u620f\uff1f", "answer": "\u8981\u8d62\u5f97\u66f4\u591a\u76848\u7403\u53f0\u7403\u7ecf\u5178\u7248\u6e38\u620f\uff0c\u8bf7\u91c7\u7528\u4ee5\u4e0b\u7b56\u7565\uff1a1\uff09\u603b\u662f\u63d0\u524d\u8ba1\u5212\u4e24\u6b65\u51fb\u7403\u30022\uff09\u63a7\u5236\u6bcd\u7403\u7684\u4f4d\u7f6e\uff0c\u4e3a\u4e0b\u4e00\u6b65\u7684\u51fb\u7403\u505a\u597d\u51c6\u5907\u30023\uff09\u4e13\u6ce8\u4e8e\u6709\u6548\u51fb\u843d\u4f60\u7684\u540c\u8272\u7403\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u80fd\u6e05\u6670\u5730\u51fb\u4e2d5\u53f7\u7403\uff0c\u8bf7\u5c06\u6bcd\u7403\u653e\u57286\u53f7\u7403\u9644\u8fd1\uff0c\u4ee5\u4fbf\u8fdb\u884c\u4e0b\u4e00\u6b65\u51fb\u7403\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u6e38\u620f\u60f3\u8c61\u6210\u8c61\u68cb\uff1b\u6bcf\u4e00\u6b65\u90fd\u4e3a\u4e0b\u4e00\u6b65\u505a\u51c6\u5907\u3002]"}, {"question": "\u57288\u7403\u53f0\u7403\u7ecf\u5178\u7248\u4e2d\uff0c\u51fb\u7403\u7684\u610f\u4e49\u662f\u4ec0\u4e48\uff1f", "answer": "\u57288\u7403\u53f0\u7403\u7ecf\u5178\u7248\u4e2d\uff0c\u51fb\u7403\u610f\u4e49\u91cd\u5927\uff0c\u56e0\u4e3a\u5b83\u8bbe\u5b9a\u4e86\u6e38\u620f\u7684\u57fa\u8c03\u3002\u5f3a\u6709\u529b\u7684\u51fb\u7403\u53ef\u4ee5\u5c06\u7403\u6563\u5e03\u5f97\u66f4\u5f00\uff0c\u7ed9\u4f60\u66f4\u591a\u7684\u51fb\u843d\u673a\u4f1a\u3002\u4f8b\u5982\uff0c\u5f3a\u52b2\u4e14\u89d2\u5ea6\u7cbe\u51c6\u7684\u51fb\u7403\u53ef\u4ee5\u51fb\u843d\u591a\u4e2a\u7403\uff0c\u5e76\u8ba9\u4f60\u5728\u65e9\u671f\u83b7\u5f97\u4f18\u52bf\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u5f3a\u51fb\u4e0e\u5f31\u51fb\u3002]"}, {"question": "\u7269\u7406\u5f15\u64ce\u5982\u4f55\u57288\u7403\u53f0\u7403\u7ecf\u5178\u7248\u4e2d\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\uff1f", "answer": "8\u7403\u53f0\u7403\u7ecf\u5178\u7248\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u901a\u8fc7\u6a21\u62df\u73b0\u5b9e\u4e16\u754c\u4e2d\u7684\u7403\u4f53\u8fd0\u52a8\u6765\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\u3002\u8fd9\u5305\u62ec\u65cb\u8f6c\u3001\u901f\u5ea6\u548c\u89d2\u5ea6\u7b49\u56e0\u7d20\u3002\u4f8b\u5982\uff0c\u5e94\u7528\u540e\u65cb\u8f6c\u53ef\u4ee5\u5e2e\u52a9\u63a7\u5236\u51fb\u7403\u540e\u6bcd\u7403\u7684\u4f4d\u7f6e\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u7269\u7406\u5f15\u64ce\u5c31\u50cf\u4e00\u4e2a\u865a\u62df\u7684\u53f0\u7403\u684c\uff0c\u590d\u5236\u73b0\u5b9e\u751f\u6d3b\u4e2d\u7684\u52a8\u6001\u3002]"}, {"question": "8\u7403\u53f0\u7403\u7ecf\u5178\u7248\u4e2d\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "8\u7403\u53f0\u7403\u7ecf\u5178\u7248\u4e2d\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u7684\u5173\u952e\u533a\u522b\u5728\u4e8e\uff1a1\uff09\u5355\u4eba\u6a21\u5f0f\u4fa7\u91cd\u4e8e\u7ec3\u4e60\u548c\u6280\u80fd\u63d0\u5347\uff0c\u800c\u591a\u4eba\u6a21\u5f0f\u5219\u6d89\u53ca\u5b9e\u65f6\u7ade\u8d5b\u30022\uff09\u591a\u4eba\u6a21\u5f0f\u5141\u8bb8\u4f60\u548c\u670b\u53cb\u6216\u5168\u7403\u73a9\u5bb6\u5bf9\u6218\u3002\u4f8b\u5982\uff0c\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f60\u53ef\u80fd\u4f1a\u9762\u4e34\u5bf9\u624b\u7684\u4e0d\u53ef\u9884\u6d4b\u7684\u7b56\u7565\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u5355\u4eba\u6a21\u5f0f\u4e0e\u591a\u4eba\u6a21\u5f0f\u3002]"}, {"question": "\u5982\u4f55\u57288\u7403\u53f0\u7403\u7ecf\u5178\u7248\u4e2d\u5c06\u6211\u7684\u6e38\u620f\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u8bbe\u5907\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u8bbe\u5907\uff1f", "answer": "\u8981\u57288\u7403\u53f0\u7403\u7ecf\u5178\u7248\u4e2d\u8f6c\u79fb\u4f60\u7684\u6e38\u620f\u8fdb\u5ea6\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u786e\u4fdd\u4f60\u5728\u4e24\u4e2a\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u5e10\u6237\u3002\u6b65\u9aa42 - \u4f7f\u7528\u4e91\u4fdd\u5b58\u529f\u80fd\u5c06\u4f60\u7684\u8fdb\u5ea6\u4e0a\u4f20\u3002\u6b65\u9aa43 - \u5728\u65b0\u8bbe\u5907\u4e0a\u4e0b\u8f7d\u4fdd\u5b58\u7684\u6570\u636e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4ece\u5b89\u5353\u8bbe\u5907\u5207\u6362\u5230iOS\u8bbe\u5907\uff0c\u4e91\u4fdd\u5b58\u53ef\u786e\u4fdd\u4f60\u7684\u8fdb\u5ea6\u5f97\u5230\u4fdd\u7559\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u8bbe\u5907A -> \u4e91\u4fdd\u5b58 -> \u8bbe\u5907B\u3002]"}, {"question": "8\u7403\u53f0\u7403\u7ecf\u5178\u7248\u4e2d\u662f\u5426\u5b58\u5728\u4efb\u4f55\u9690\u85cf\u6210\u5c31\u6216\u5f69\u86cb\uff1f", "answer": "\u662f\u7684\uff0c8\u7403\u53f0\u7403\u7ecf\u5178\u7248\u4e2d\u6709\u9690\u85cf\u6210\u5c31\u548c\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u5728\u51fb\u7403\u65f6\u51fb\u843d8\u53f7\u7403\u4f1a\u89e3\u9501\u4e00\u4e2a\u7279\u6b8a\u7684\u6210\u5c31\u3002\u63a2\u7d22\u4e0d\u540c\u7684\u51fb\u7403\u7ec4\u5408\u548c\u72ec\u7279\u7684\u573a\u666f\u53ef\u4ee5\u63ed\u793a\u8fd9\u4e9b\u9690\u85cf\u7684\u5b9d\u85cf\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u53d1\u73b0\u5f69\u86cb\u5c31\u50cf\u5728\u6e38\u620f\u4e2d\u5bfb\u627e\u9690\u85cf\u7684\u5b9d\u85cf\u3002]"}]
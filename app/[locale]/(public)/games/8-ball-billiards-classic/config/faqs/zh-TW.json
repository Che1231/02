[{"question": "\u5982\u4f55\u5728\u4e00\u687f\u6c7a\u52dd\u8ca0\u53f0\u7403\u7d93\u5178\u7248\u4e2d\u57f7\u884c\u57fa\u672c\u64ca\u7403\uff1f", "answer": "\u8981\u5728\u516b\u7403\u53f0\u7403\u7d93\u5178\u7248\u4e2d\u57f7\u884c\u57fa\u672c\u64ca\u7403\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u5c07\u7403\u687f\u8207\u6bcd\u7403\u5c0d\u9f4a\uff0c\u65b9\u6cd5\u662f\u5c07\u624b\u6307\u62d6\u66f3\u5728\u87a2\u5e55\u4e0a\u3002\u6b65\u9a5f2 - \u900f\u904e\u62c9\u52d5\u4e26\u91cb\u653e\u529b\u91cf\u8a08\u4f86\u8abf\u6574\u64ca\u7403\u529b\u91cf\u3002\u6b65\u9a5f3 - \u7784\u6e96\u76ee\u6a19\u7403\u4e26\u91cb\u653e\u4ee5\u57f7\u884c\u64ca\u7403\u3002\u4f8b\u5982\uff0c\u5728\u958b\u7403\u6642\u7784\u6e961\u865f\u7403\uff0c\u53ef\u4ee5\u70ba\u904a\u6232\u5960\u5b9a\u5805\u5be6\u7684\u57fa\u790e\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u529b\u91cf\u8a08\u60f3\u50cf\u6210\u5f48\u5f13\uff1b\u62c9\u5f97\u8d8a\u9060\uff0c\u64ca\u7403\u529b\u91cf\u5c31\u8d8a\u5927\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u5728\u516b\u7403\u53f0\u7403\u7d93\u5178\u7248\u4e2d\u5b9a\u4f4d\u5f88\u91cd\u8981\uff1f", "answer": "\u5728\u516b\u7403\u53f0\u7403\u7d93\u5178\u7248\u4e2d\uff0c\u5b9a\u4f4d\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6c7a\u5b9a\u4e86\u4f60\u7684\u4e0b\u4e00\u500b\u64ca\u7403\u3002\u826f\u597d\u7684\u5b9a\u4f4d\u4f7f\u4f60\u80fd\u5920\u8a2d\u7f6e\u9023\u7e8c\u64ca\u7403\u4e26\u63a7\u5236\u904a\u6232\u7bc0\u594f\u3002\u4f8b\u5982\uff0c\u64ca\u843d2\u865f\u7403\u5f8c\uff0c\u5c07\u6bcd\u7403\u64fa\u653e\u57283\u865f\u7403\u9644\u8fd1\uff0c\u4ee5\u4fbf\u8f15\u9b06\u9032\u884c\u5f8c\u7e8c\u64ca\u7403\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u64ca\u7403 -> \u5b9a\u4f4d -> \u4e0b\u4e00\u64ca\u7403 -> \u7372\u52dd\u3002]"}, {"question": "\u4f5c\u70ba\u516b\u7403\u53f0\u7403\u7d93\u5178\u7248\u7684\u65b0\u624b\uff0c\u6211\u9700\u8981\u77e5\u9053\u54ea\u4e9b\u57fa\u672c\u898f\u5247\uff1f", "answer": "\u4f5c\u70ba\u516b\u7403\u53f0\u7403\u7d93\u5178\u7248\u7684\u65b0\u624b\uff0c\u4f60\u9700\u8981\u77e5\u9053\u4ee5\u4e0b\u57fa\u672c\u898f\u5247\uff1a1) \u904a\u6232\u5f9e\u958b\u7403\u958b\u59cb\u30022) \u4f60\u5fc5\u9808\u4f9d\u64da\u5408\u6cd5\u64ca\u843d\u7684\u7b2c\u4e00\u9846\u7403\uff0c\u64ca\u843d\u5be6\u5fc3\u7403\u6216\u689d\u7d0b\u7403\u30023) \u64ca\u843d8\u865f\u7403\u624d\u80fd\u7372\u52dd\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5148\u64ca\u843d\u4e00\u9846\u5be6\u5fc3\u7403\uff0c\u4f60\u5fc5\u9808\u7e7c\u7e8c\u64ca\u843d\u5be6\u5fc3\u7403\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u5be6\u5fc3\u7403\u8207\u689d\u7d0b\u7403\u3002]"}, {"question": "\u5982\u4f55\u5728\u516b\u7403\u53f0\u7403\u7d93\u5178\u7248\u4e2d\u6539\u5584\u5eab\u908a\u7403\uff1f", "answer": "\u5728\u516b\u7403\u53f0\u7403\u7d93\u5178\u7248\u4e2d\u6539\u5584\u5eab\u908a\u7403\u9700\u8981\u7df4\u7fd2\u548c\u7cbe\u6e96\u5ea6\u3002\u6b65\u9a5f1 - \u78ba\u5b9a\u7403\u9700\u8981\u5f9e\u5eab\u908a\u53cd\u5f48\u7684\u89d2\u5ea6\u3002\u6b65\u9a5f2 - \u8abf\u6574\u529b\u91cf\uff0c\u78ba\u4fdd\u7403\u5230\u9054\u76ee\u6a19\u3002\u6b65\u9a5f3 - \u7df4\u7fd2\u4e0d\u540c\u7684\u89d2\u5ea6\uff0c\u611f\u53d7\u6aaf\u9762\u3002\u4f8b\u5982\uff0c\u8a66\u8457\u5c074\u865f\u7403\u64ca\u6253\u5230\u5074\u5eab\uff0c\u4f7f\u5176\u843d\u5165\u89d2\u843d\u888b\u4e2d\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u76f4\u63a5\u64ca\u7403\u8207\u5eab\u908a\u7403\u3002]"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u53ef\u4ee5\u5e6b\u52a9\u6211\u5728\u516b\u7403\u53f0\u7403\u7d93\u5178\u7248\u4e2d\u8d0f\u5f97\u66f4\u591a\u904a\u6232\uff1f", "answer": "\u8981\u5728\u516b\u7403\u53f0\u7403\u7d93\u5178\u7248\u4e2d\u8d0f\u5f97\u66f4\u591a\u904a\u6232\uff0c\u8acb\u63a1\u7528\u4ee5\u4e0b\u7b56\u7565\uff1a1) \u59cb\u7d42\u9810\u5148\u8a08\u5283\u5169\u6b21\u64ca\u7403\u30022) \u63a7\u5236\u6bcd\u7403\u7684\u4f4d\u7f6e\u4ee5\u8a2d\u5b9a\u4e0b\u4e00\u6b21\u64ca\u7403\u30023) \u96c6\u4e2d\u7cbe\u529b\u6709\u6548\u64ca\u843d\u4f60\u7684\u7403\u7d44\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u80fd\u6e05\u695a\u5730\u64ca\u843d5\u865f\u7403\uff0c\u5247\u5c07\u6bcd\u7403\u64fa\u653e\u57286\u865f\u7403\u9644\u8fd1\uff0c\u4ee5\u4fbf\u9032\u884c\u4e0b\u4e00\u6b21\u64ca\u7403\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u904a\u6232\u60f3\u50cf\u6210\u897f\u6d0b\u68cb\uff1b\u6bcf\u4e00\u6b65\u68cb\u90fd\u70ba\u4e0b\u4e00\u6b65\u92ea\u8def\u3002]"}, {"question": "\u516b\u7403\u53f0\u7403\u7d93\u5178\u7248\u4e2d\u958b\u7403\u7684\u610f\u7fa9\u662f\u4ec0\u9ebc\uff1f", "answer": "\u516b\u7403\u53f0\u7403\u7d93\u5178\u7248\u4e2d\u7684\u958b\u7403\u5f88\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u8a2d\u5b9a\u4e86\u904a\u6232\u7684\u57fa\u8abf\u3002\u5f37\u529b\u958b\u7403\u53ef\u4ee5\u5c07\u7403\u6563\u958b\uff0c\u7d66\u4f60\u66f4\u591a\u64ca\u843d\u7403\u7684\u6a5f\u6703\u3002\u4f8b\u5982\uff0c\u4e00\u6b21\u5f37\u52c1\u4e14\u89d2\u5ea6\u826f\u597d\u7684\u958b\u7403\u53ef\u4ee5\u64ca\u843d\u591a\u9846\u7403\uff0c\u4e26\u7d66\u4f60\u8f03\u65e9\u7684\u512a\u52e2\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u5f37\u529b\u958b\u7403\u8207\u5f31\u52e2\u958b\u7403\u3002]"}, {"question": "\u7269\u7406\u5f15\u64ce\u5982\u4f55\u5f71\u97ff\u516b\u7403\u53f0\u7403\u7d93\u5178\u7248\u7684\u904a\u6232\u73a9\u6cd5\uff1f", "answer": "\u516b\u7403\u53f0\u7403\u7d93\u5178\u7248\u7684\u7269\u7406\u5f15\u64ce\u900f\u904e\u6a21\u64ec\u771f\u5be6\u4e16\u754c\u7684\u7403\u9ad4\u904b\u52d5\u4f86\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\u3002\u9019\u5305\u62ec\u65cb\u8f49\u3001\u901f\u5ea6\u548c\u89d2\u5ea6\u7b49\u56e0\u7d20\u3002\u4f8b\u5982\uff0c\u65bd\u52a0\u5f8c\u65cb\u53ef\u4ee5\u5e6b\u52a9\u63a7\u5236\u64ca\u7403\u5f8c\u6bcd\u7403\u7684\u4f4d\u7f6e\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u7269\u7406\u5f15\u64ce\u5c31\u50cf\u4e00\u500b\u865b\u64ec\u7684\u53f0\u7403\u684c\uff0c\u8907\u88fd\u73fe\u5be6\u751f\u6d3b\u4e2d\u7684\u52d5\u614b\u3002]"}, {"question": "\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u5728\u516b\u7403\u53f0\u7403\u7d93\u5178\u7248\u4e2d\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "\u516b\u7403\u53f0\u7403\u7d93\u5178\u7248\u4e2d\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u7684\u4e3b\u8981\u5dee\u7570\u5728\u65bc\uff1a1) \u55ae\u4eba\u6a21\u5f0f\u91cd\u9ede\u5728\u65bc\u7df4\u7fd2\u548c\u6280\u80fd\u63d0\u5347\uff0c\u800c\u591a\u4eba\u6a21\u5f0f\u5247\u6d89\u53ca\u5373\u6642\u7af6\u722d\u30022) \u591a\u4eba\u6a21\u5f0f\u5141\u8a31\u4f60\u548c\u670b\u53cb\u6216\u5168\u7403\u73a9\u5bb6\u5c0d\u6230\u3002\u4f8b\u5982\uff0c\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f60\u53ef\u80fd\u6703\u9047\u5230\u4f86\u81ea\u5c0d\u624b\u7684\u4e0d\u53ef\u9810\u6e2c\u7684\u7b56\u7565\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u55ae\u4eba\u6a21\u5f0f\u8207\u591a\u4eba\u6a21\u5f0f\u3002]"}, {"question": "\u5982\u4f55\u5728\u516b\u7403\u53f0\u7403\u7d93\u5178\u7248\u4e2d\u5c07\u904a\u6232\u9032\u5ea6\u5f9e\u4e00\u500b\u88dd\u7f6e\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u88dd\u7f6e\uff1f", "answer": "\u8981\u5c07\u516b\u7403\u53f0\u7403\u7d93\u5178\u7248\u7684\u904a\u6232\u9032\u5ea6\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u88dd\u7f6e\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u78ba\u4fdd\u4f60\u5df2\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u4e0a\u50b3\u4f60\u7684\u9032\u5ea6\u3002\u6b65\u9a5f3 - \u5728\u65b0\u88dd\u7f6e\u4e0a\u4e0b\u8f09\u5132\u5b58\u7684\u8cc7\u6599\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5f9e Android \u88dd\u7f6e\u8f49\u63db\u5230 iOS \u88dd\u7f6e\uff0c\u96f2\u7aef\u5132\u5b58\u53ef\u78ba\u4fdd\u4fdd\u7559\u4f60\u7684\u9032\u5ea6\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u88dd\u7f6e A -> \u96f2\u7aef\u5132\u5b58 -> \u88dd\u7f6e B\u3002]"}, {"question": "\u516b\u7403\u53f0\u7403\u7d93\u5178\u7248\u4e2d\u662f\u5426\u6709\u4efb\u4f55\u96b1\u85cf\u6210\u5c31\u6216\u5f69\u86cb\uff1f", "answer": "\u662f\u7684\uff0c\u516b\u7403\u53f0\u7403\u7d93\u5178\u7248\u4e2d\u5305\u542b\u96b1\u85cf\u6210\u5c31\u548c\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u5728\u958b\u7403\u6642\u64ca\u843d8\u865f\u7403\u6703\u89e3\u9396\u7279\u6b8a\u6210\u5c31\u3002\u63a2\u7d22\u4e0d\u540c\u7684\u64ca\u7403\u7d44\u5408\u548c\u7368\u7279\u7684\u904a\u6232\u5834\u666f\u53ef\u4ee5\u767c\u73fe\u9019\u4e9b\u96b1\u85cf\u7684\u5bf6\u85cf\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u767c\u73fe\u5f69\u86cb\u5c31\u50cf\u5728\u904a\u6232\u4e2d\u5c0b\u627e\u96b1\u85cf\u7684\u5bf6\u85cf\u3002]"}]
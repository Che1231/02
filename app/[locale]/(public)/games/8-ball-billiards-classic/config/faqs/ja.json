[{"question": "8\u30dc\u30fc\u30eb\u30d3\u30ea\u30e4\u30fc\u30c9\u30af\u30e9\u30b7\u30c3\u30af\u3067\u57fa\u672c\u7684\u306a\u30b7\u30e7\u30c3\u30c8\u3092\u5b9f\u884c\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "8\u30dc\u30fc\u30eb\u30d3\u30ea\u30e4\u30fc\u30c9\u30af\u30e9\u30b7\u30c3\u30af\u3067\u57fa\u672c\u7684\u306a\u30b7\u30e7\u30c3\u30c8\u3092\u5b9f\u884c\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u753b\u9762\u4e0a\u3067\u6307\u3092\u30c9\u30e9\u30c3\u30b0\u3057\u3066\u30ad\u30e5\u30fc\u30b9\u30c6\u30a3\u30c3\u30af\u3092\u30ad\u30e5\u30fc\u30dc\u30fc\u30eb\u306b\u5408\u308f\u305b\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d1\u30ef\u30fc\u30e1\u30fc\u30bf\u30fc\u3092\u5f15\u3063\u5f35\u3063\u3066\u96e2\u3059\u3053\u3068\u3067\u30b7\u30e7\u30c3\u30c8\u306e\u30d1\u30ef\u30fc\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30bf\u30fc\u30b2\u30c3\u30c8\u30dc\u30fc\u30eb\u3092\u76ee\u6a19\u306b\u3057\u3066\u30b7\u30e7\u30c3\u30c8\u3092\u5b9f\u884c\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30aa\u30fc\u30d7\u30cb\u30f3\u30b0\u30d6\u30ec\u30a4\u30af\u30671\u30dc\u30fc\u30eb\u3092\u76ee\u6a19\u306b\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u306b\u5f37\u3044\u57fa\u790e\u3092\u7bc9\u304f\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u30d1\u30ef\u30fc\u30e1\u30fc\u30bf\u30fc\u3092\u30b9\u30ea\u30f3\u30b0\u30b7\u30e7\u30c3\u30c8\u306e\u3088\u3046\u306b\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u5f15\u304d\u623b\u3059\u307b\u3069\u30b7\u30e7\u30c3\u30c8\u306f\u5f37\u304f\u306a\u308a\u307e\u3059\u3002]"}, {"question": "8\u30dc\u30fc\u30eb\u30d3\u30ea\u30e4\u30fc\u30c9\u30af\u30e9\u30b7\u30c3\u30af\u3067\u30dd\u30b8\u30b7\u30e7\u30cb\u30f3\u30b0\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "8\u30dc\u30fc\u30eb\u30d3\u30ea\u30e4\u30fc\u30c9\u30af\u30e9\u30b7\u30c3\u30af\u3067\u30dd\u30b8\u30b7\u30e7\u30cb\u30f3\u30b0\u304c\u91cd\u8981\u306a\u306e\u306f\u3001\u6b21\u306e\u30b7\u30e7\u30c3\u30c8\u304c\u6c7a\u307e\u308b\u304b\u3089\u3067\u3059\u3002\u826f\u3044\u30dd\u30b8\u30b7\u30e7\u30cb\u30f3\u30b0\u306b\u3088\u308a\u3001\u9023\u7d9a\u3057\u305f\u30b7\u30e7\u30c3\u30c8\u3092\u8a2d\u5b9a\u3057\u3001\u30b2\u30fc\u30e0\u306e\u6d41\u308c\u3092\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u30012\u30dc\u30fc\u30eb\u3092\u30dd\u30b1\u30c3\u30c8\u306b\u5165\u308c\u308b\u5f8c\u30013\u30dc\u30fc\u30eb\u306e\u8fd1\u304f\u306b\u30ad\u30e5\u30fc\u30dc\u30fc\u30eb\u3092\u914d\u7f6e\u3057\u3066\u3001\u30d5\u30a9\u30ed\u30fc\u30a2\u30c3\u30d7\u3092\u7c21\u5358\u306b\u884c\u3046\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30b7\u30e7\u30c3\u30c8\u2192\u30dd\u30b8\u30b7\u30e7\u30f3\u2192\u6b21\u306e\u30b7\u30e7\u30c3\u30c8\u2192\u52dd\u5229]\u3002"}, {"question": "8\u30dc\u30fc\u30eb\u30d3\u30ea\u30e4\u30fc\u30c9\u30af\u30e9\u30b7\u30c3\u30af\u306e\u521d\u5fc3\u8005\u3068\u3057\u3066\u77e5\u3063\u3066\u304a\u304f\u3079\u304d\u57fa\u672c\u7684\u306a\u30eb\u30fc\u30eb\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "8\u30dc\u30fc\u30eb\u30d3\u30ea\u30e4\u30fc\u30c9\u30af\u30e9\u30b7\u30c3\u30af\u306e\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001\u4ee5\u4e0b\u306e\u57fa\u672c\u7684\u306a\u30eb\u30fc\u30eb\u3092\u77e5\u3063\u3066\u304a\u304f\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u30021\uff09\u30b2\u30fc\u30e0\u306f\u30d6\u30ec\u30a4\u30af\u30b7\u30e7\u30c3\u30c8\u304b\u3089\u59cb\u307e\u308a\u307e\u3059\u30022\uff09\u6700\u521d\u306b\u5408\u6cd5\u7684\u306b\u30dd\u30b1\u30c3\u30c8\u306b\u5165\u308c\u305f\u30dc\u30fc\u30eb\u306b\u57fa\u3065\u3044\u3066\u3001\u30bd\u30ea\u30c3\u30c9\u307e\u305f\u306f\u30b9\u30c8\u30e9\u30a4\u30d7\u306e\u3069\u3061\u3089\u304b\u3092\u30dd\u30b1\u30c3\u30c8\u306b\u5165\u308c\u307e\u3059\u30023\uff098\u30dc\u30fc\u30eb\u3092\u6700\u5f8c\u306b\u30dd\u30b1\u30c3\u30c8\u306b\u5165\u308c\u308b\u3053\u3068\u3067\u52dd\u5229\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6700\u521d\u306b\u30bd\u30ea\u30c3\u30c9\u30dc\u30fc\u30eb\u3092\u30dd\u30b1\u30c3\u30c8\u306b\u5165\u308c\u305f\u5834\u5408\u306f\u3001\u30bd\u30ea\u30c3\u30c9\u30dc\u30fc\u30eb\u3092\u7d9a\u3051\u306a\u3051\u308c\u3070\u306a\u308a\u307e\u305b\u3093\u3002[\u69cb\u6210\u5bfe\u7167\u8868\uff1a\u30bd\u30ea\u30c3\u30c9\u5bfe\u30b9\u30c8\u30e9\u30a4\u30d7]"}, {"question": "8\u30dc\u30fc\u30eb\u30d3\u30ea\u30e4\u30fc\u30c9\u30af\u30e9\u30b7\u30c3\u30af\u3067\u30d0\u30f3\u30af\u30b7\u30e7\u30c3\u30c8\u3092\u6539\u5584\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "8\u30dc\u30fc\u30eb\u30d3\u30ea\u30e4\u30fc\u30c9\u30af\u30e9\u30b7\u30c3\u30af\u3067\u30d0\u30f3\u30af\u30b7\u30e7\u30c3\u30c8\u3092\u6539\u5584\u3059\u308b\u306b\u306f\u3001\u7df4\u7fd2\u3068\u6b63\u78ba\u3055\u304c\u91cd\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30dc\u30fc\u30eb\u304c\u30af\u30c3\u30b7\u30e7\u30f3\u304b\u3089\u8df3\u306d\u8fd4\u308b\u89d2\u5ea6\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30dc\u30fc\u30eb\u304c\u76ee\u6a19\u7269\u306b\u5230\u9054\u3059\u308b\u3088\u3046\u306b\u30d1\u30ef\u30fc\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30c6\u30fc\u30d6\u30eb\u306e\u3055\u307e\u3056\u307e\u306a\u89d2\u5ea6\u3092\u5b9f\u611f\u306e\u305f\u3081\u306b\u7df4\u7fd2\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u30014\u30dc\u30fc\u30eb\u3092\u30b5\u30a4\u30c9\u30af\u30c3\u30b7\u30e7\u30f3\u306b\u5f53\u3066\u3066\u30b3\u30fc\u30ca\u30fc\u30dd\u30b1\u30c3\u30c8\u306b\u30dd\u30b1\u30c3\u30c8\u306b\u5165\u308c\u308b\u3053\u3068\u3092\u8a66\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002[\u8907\u6570\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u6bd4\u8f03\uff1a\u30c0\u30a4\u30ec\u30af\u30c8\u30b7\u30e7\u30c3\u30c8\u5bfe\u30d0\u30f3\u30af\u30b7\u30e7\u30c3\u30c8]"}, {"question": "8\u30dc\u30fc\u30eb\u30d3\u30ea\u30e4\u30fc\u30c9\u30af\u30e9\u30b7\u30c3\u30af\u3067\u3088\u308a\u591a\u304f\u306e\u30b2\u30fc\u30e0\u306b\u52dd\u3064\u305f\u3081\u306b\u5f79\u7acb\u3064\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "8\u30dc\u30fc\u30eb\u30d3\u30ea\u30e4\u30fc\u30c9\u30af\u30e9\u30b7\u30c3\u30af\u3067\u3088\u308a\u591a\u304f\u306e\u30b2\u30fc\u30e0\u306b\u52dd\u3064\u305f\u3081\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u6226\u7565\u3092\u63a1\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u30021\uff09\u5e38\u306b2\u3064\u5148\u306e\u30b7\u30e7\u30c3\u30c8\u3092\u8a08\u753b\u3059\u308b\u30022\uff09\u30ad\u30e5\u30fc\u30dc\u30fc\u30eb\u306e\u4f4d\u7f6e\u3092\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3057\u3066\u6b21\u306e\u30b7\u30e7\u30c3\u30c8\u3092\u8a2d\u5b9a\u3059\u308b\u30023\uff09\u52b9\u7387\u7684\u306b\u81ea\u5206\u306e\u30b0\u30eb\u30fc\u30d7\u306e\u30dc\u30fc\u30eb\u3092\u30dd\u30b1\u30c3\u30c8\u306b\u5165\u308c\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3059\u308b\u3002\u305f\u3068\u3048\u3070\u30015\u30dc\u30fc\u30eb\u3092\u78ba\u5b9f\u306b\u30dd\u30b1\u30c3\u30c8\u306b\u5165\u308c\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u5834\u5408\u3001\u6b21\u306e\u30b7\u30e7\u30c3\u30c8\u306e\u305f\u3081\u306b\u30ad\u30e5\u30fc\u30dc\u30fc\u30eb\u30926\u30dc\u30fc\u30eb\u306e\u8fd1\u304f\u306b\u914d\u7f6e\u3057\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u30b2\u30fc\u30e0\u3092\u30c1\u30a7\u30b9\u306e\u3088\u3046\u306b\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u5404\u624b\u304c\u6b21\u306e\u624b\u3092\u8a2d\u5b9a\u3057\u307e\u3059\u3002]"}, {"question": "8\u30dc\u30fc\u30eb\u30d3\u30ea\u30e4\u30fc\u30c9\u30af\u30e9\u30b7\u30c3\u30af\u3067\u30d6\u30ec\u30a4\u30af\u30b7\u30e7\u30c3\u30c8\u306e\u91cd\u8981\u6027\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "8\u30dc\u30fc\u30eb\u30d3\u30ea\u30e4\u30fc\u30c9\u30af\u30e9\u30b7\u30c3\u30af\u3067\u30d6\u30ec\u30a4\u30af\u30b7\u30e7\u30c3\u30c8\u306f\u3001\u30b2\u30fc\u30e0\u306e\u30c8\u30fc\u30f3\u3092\u8a2d\u5b9a\u3059\u308b\u4e0a\u3067\u91cd\u8981\u3067\u3059\u3002\u5f37\u529b\u306a\u30d6\u30ec\u30a4\u30af\u306f\u30dc\u30fc\u30eb\u3092\u5e83\u304f\u6563\u3089\u3059\u3053\u3068\u304c\u3067\u304d\u3001\u3088\u308a\u591a\u304f\u306e\u30dd\u30b1\u30c3\u30c8\u306b\u5165\u308c\u308b\u6a5f\u4f1a\u3092\u4e0e\u3048\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5f37\u529b\u3067\u89d2\u5ea6\u306e\u3057\u3063\u304b\u308a\u3057\u305f\u30d6\u30ec\u30a4\u30af\u306f\u8907\u6570\u306e\u30dc\u30fc\u30eb\u3092\u30dd\u30b1\u30c3\u30c8\u306b\u5165\u308c\u308b\u3053\u3068\u304c\u3067\u304d\u3001\u65e9\u671f\u306e\u30a2\u30c9\u30d0\u30f3\u30c6\u30fc\u30b8\u3092\u4e0e\u3048\u307e\u3059\u3002[\u69cb\u6210\u5bfe\u7167\u8868\uff1a\u5f37\u529b\u306a\u30d6\u30ec\u30a4\u30af\u5bfe\u5f31\u3044\u30d6\u30ec\u30a4\u30af]"}, {"question": "\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u306f8\u30dc\u30fc\u30eb\u30d3\u30ea\u30e4\u30fc\u30c9\u30af\u30e9\u30b7\u30c3\u30af\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "8\u30dc\u30fc\u30eb\u30d3\u30ea\u30e4\u30fc\u30c9\u30af\u30e9\u30b7\u30c3\u30af\u306e\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u306f\u3001\u73fe\u5b9f\u4e16\u754c\u306e\u30dc\u30fc\u30eb\u306e\u52d5\u304d\u3092\u30b7\u30df\u30e5\u30ec\u30fc\u30c8\u3059\u308b\u3053\u3068\u3067\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u5f71\u97ff\u3057\u307e\u3059\u3002\u3053\u308c\u306b\u306f\u3001\u30b9\u30d4\u30f3\u3001\u901f\u5ea6\u3001\u89d2\u5ea6\u306a\u3069\u306e\u8981\u56e0\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30d0\u30c3\u30af\u30b9\u30d4\u30f3\u3092\u304b\u3051\u308b\u3053\u3068\u3067\u3001\u30b7\u30e7\u30c3\u30c8\u5f8c\u30ad\u30e5\u30fc\u30dc\u30fc\u30eb\u306e\u4f4d\u7f6e\u3092\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u306f\u73fe\u5b9f\u4e16\u754c\u306e\u30c0\u30a4\u30ca\u30df\u30af\u30b9\u3092\u518d\u73fe\u3059\u308b\u4eee\u60f3\u30d3\u30ea\u30e4\u30fc\u30c9\u30c6\u30fc\u30d6\u30eb\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u3002]"}, {"question": "\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306e8\u30dc\u30fc\u30eb\u30d3\u30ea\u30e4\u30fc\u30c9\u30af\u30e9\u30b7\u30c3\u30af\u306b\u304a\u3051\u308b\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306e8\u30dc\u30fc\u30eb\u30d3\u30ea\u30e4\u30fc\u30c9\u30af\u30e9\u30b7\u30c3\u30af\u306b\u304a\u3051\u308b\u4e3b\u306a\u9055\u3044\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\u30021\uff09\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u7df4\u7fd2\u3068\u30b9\u30ad\u30eb\u5411\u4e0a\u306b\u7126\u70b9\u3092\u5f53\u3066\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u306e\u5bfe\u6226\u306b\u95a2\u308f\u308a\u307e\u3059\u30022\uff09\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3067\u306f\u3001\u53cb\u9054\u3084\u30b0\u30ed\u30fc\u30d0\u30eb\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u5bfe\u6226\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u306f\u3001\u5bfe\u6226\u76f8\u624b\u304b\u3089\u4e88\u6e2c\u3067\u304d\u306a\u3044\u6226\u7565\u306b\u76f4\u9762\u3059\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002[\u8907\u6570\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u6bd4\u8f03\uff1a\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u5bfe\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc]"}, {"question": "8\u30dc\u30fc\u30eb\u30d3\u30ea\u30e4\u30fc\u30c9\u30af\u30e9\u30b7\u30c3\u30af\u3067\u30b2\u30fc\u30e0\u306e\u9032\u884c\u72b6\u6cc1\u3092\u5225\u306e\u30c7\u30d0\u30a4\u30b9\u306b\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "8\u30dc\u30fc\u30eb\u30d3\u30ea\u30e4\u30fc\u30c9\u30af\u30e9\u30b7\u30c3\u30af\u3067\u30b2\u30fc\u30e0\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u3001\u9032\u884c\u72b6\u6cc1\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u4fdd\u5b58\u3055\u308c\u305f\u30c7\u30fc\u30bf\u3092\u8aad\u307f\u8fbc\u307f\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001Android\u30c7\u30d0\u30a4\u30b9\u304b\u3089iOS\u30c7\u30d0\u30a4\u30b9\u306b\u5207\u308a\u66ff\u3048\u305f\u5834\u5408\u3001\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u306b\u3088\u308a\u3001\u9032\u884c\u72b6\u6cc1\u304c\u7dad\u6301\u3055\u308c\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30c7\u30d0\u30a4\u30b9A\u2192\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u2192\u30c7\u30d0\u30a4\u30b9B]"}, {"question": "8\u30dc\u30fc\u30eb\u30d3\u30ea\u30e4\u30fc\u30c9\u30af\u30e9\u30b7\u30c3\u30af\u306b\u306f\u96a0\u3055\u308c\u305f\u9054\u6210\u5ea6\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u30018\u30dc\u30fc\u30eb\u30d3\u30ea\u30e4\u30fc\u30c9\u30af\u30e9\u30b7\u30c3\u30af\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u9054\u6210\u5ea6\u3068\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30d6\u30ec\u30a4\u30af\u30b7\u30e7\u30c3\u30c8\u30678\u30dc\u30fc\u30eb\u3092\u30dd\u30b1\u30c3\u30c8\u306b\u5165\u308c\u308b\u3068\u7279\u5225\u306a\u9054\u6210\u5ea6\u304c\u30ed\u30c3\u30af\u89e3\u9664\u3055\u308c\u307e\u3059\u3002\u3055\u307e\u3056\u307e\u306a\u30b7\u30e7\u30c3\u30c8\u306e\u7d44\u307f\u5408\u308f\u305b\u3068\u30e6\u30cb\u30fc\u30af\u306a\u30b2\u30fc\u30e0\u30b7\u30ca\u30ea\u30aa\u3092\u63a2\u6c42\u3059\u308b\u3053\u3068\u3067\u3001\u3053\u308c\u3089\u306e\u96a0\u3055\u308c\u305f\u5b9d\u77f3\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u306f\u3001\u30b2\u30fc\u30e0\u5185\u306e\u96a0\u3055\u308c\u305f\u5b9d\u7269\u3092\u63a2\u3059\u3053\u3068\u306b\u4f3c\u3066\u3044\u307e\u3059\u3002]"}]
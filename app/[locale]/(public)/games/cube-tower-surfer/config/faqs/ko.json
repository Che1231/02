[{"question": "\ucd08\ubcf4\uc790\ub85c\uc11c \ud050\ube0c \ud0c0\uc6cc \uc11c\ud37c\uc5d0\uc11c \ud050\ube0c\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc81c\uc5b4\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\ud050\ube0c \ud0c0\uc6cc \uc11c\ud37c\uc5d0\uc11c \ud050\ube0c\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc81c\uc5b4\ud558\ub824\uba74, \uba3c\uc800 \uae30\ubcf8 \uc81c\uc5b4 \ubc29\uc2dd\uc744 \uc775\uc219\ud574\uc9c0\uc138\uc694. \uc67c\ucabd\uacfc \uc624\ub978\ucabd \ud654\uc0b4\ud45c\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud050\ube0c\ub97c \uc218\ud3c9\uc73c\ub85c \uc774\ub3d9\uc2dc\ud0a4\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc881\uc740 \uae38\uc744 \uc811\uadfc\ud560 \ub54c\ub294 \ud654\uc0b4\ud45c\ub97c \uc0b4\uc9dd \ub20c\ub7ec \ubbf8\uc138 \uc870\uc815\uc744 \ud558\uc138\uc694. \ub610\ud55c, \uacf5\uac04 \ubc14\ub97c \ub20c\ub7ec \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uc5f0\uc2b5\ud558\uc5ec \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\uc138\uc694. \ub9e4\ub044\ub7fd\uace0 \uc815\ud655\ud55c \uc6c0\uc9c1\uc784\uc774 \ud0d1\uc744 \uc131\uacf5\uc801\uc73c\ub85c \ud0d0\uc0c9\ud558\ub294 \ud575\uc2ec\uc785\ub2c8\ub2e4."}, {"question": "\uac8c\uc784 \ud50c\ub808\uc774 \uc2dc\uac04 100\uc2dc\uac04 \ud6c4 \ud050\ube0c \ud0c0\uc6cc \uc11c\ud37c\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uac8c\uc784 \ud50c\ub808\uc774 \uc2dc\uac04 100\uc2dc\uac04\uc774 \uc9c0\ub09c \ud6c4\uc5d0\ub294 \ud050\ube0c \ud0c0\uc6cc \uc11c\ud37c\uc5d0\uc11c \uc810\uc218\ub97c \uadf9\ub300\ud654\ud558\uae30 \uc704\ud55c \uace0\uae09 \uc804\ub7b5\uc5d0 \uc9d1\uc911\ud558\uc138\uc694. \ub2e8\uacc41: \ud56d\uc0c1 \ud50c\ub7ab\ud3fc \uc911\uc559\uc744 \ub178\ub824 \uade0\ud615\uc744 \uc720\uc9c0\ud558\uc138\uc694. \ub2e8\uacc42: \uc18d\ub3c4 \ubd80\uc2a4\ud2b8\uc640 \uac19\uc740 \uac15\ud654 \uc544\uc774\ud15c\uc744 \ud65c\uc6a9\ud558\uc5ec \ube60\ub974\uac8c \ub354 \uba3c \uac70\ub9ac\ub97c \uc774\ub3d9\ud558\uc138\uc694. \ub2e8\uacc43: \uc5f0\uc18d \uc810\ud504 \uae30\uc220\uc744 \ub9c8\uc2a4\ud130\ud558\uc5ec \ubcf4\ub108\uc2a4 \uc810\uc218\ub97c \uc5bb\uc73c\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc5f0\uc18d \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \ub9de\ucd94\uba74 \uc810\uc218\uac00 \ud06c\uac8c \uc99d\uac00\ud569\ub2c8\ub2e4. \uafb8\uc900\ud55c \uc5f0\uc2b5\uacfc \uc815\ud655\uc131\uc774 \ub354 \ub192\uc740 \uacf3\uae4c\uc9c0 \uc624\ub974\uace0 \ub354 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4."}, {"question": "\ud050\ube0c \ud0c0\uc6cc \uc11c\ud37c\uc5d0\uc11c \ud050\ube0c\uac00 \uc608\uae30\uce58 \uc54a\uac8c \ub5a8\uc5b4\uc9c0\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \uc608\ubc29\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud050\ube0c \ud0c0\uc6cc \uc11c\ud37c\uc5d0\uc11c \ud050\ube0c\uac00 \uc608\uae30\uce58 \uc54a\uac8c \ub5a8\uc5b4\uc9c0\ub294 \uc774\uc720\ub294 \uc810\ud504 \ud310\ub2e8 \uc624\ub958 \ub610\ub294 \ud50c\ub7ab\ud3fc\uc758 \uac11\uc791\uc2a4\ub7ec\uc6b4 \uc6c0\uc9c1\uc784 \ub54c\ubb38\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub97c \uc608\ubc29\ud558\ub824\uba74 \ud56d\uc0c1 \ud50c\ub7ab\ud3fc\uc758 \ubcc0\ud654\ub97c \uc608\uce21\ud558\uace0 \uc704\uce58\ub97c \uc870\uc815\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud50c\ub7ab\ud3fc\uc774 \uae30\uc6b8\uae30 \uc2dc\uc791\ud558\uba74 \ud050\ube0c\ub97c \ubc18\ub300\ucabd\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec \uade0\ud615\uc744 \ub9de\ucd94\uc138\uc694. \ub610\ud55c, \uc11c\ub450\ub974\uc9c0 \ub9d0\uace0 \uac01 \uc6c0\uc9c1\uc784\uc744 \uacc4\ud68d\ud558\ub294 \ub370 \uc2dc\uac04\uc744 \ud560\uc560\ud558\uc138\uc694. \uc778\ub0b4\uc2ec\uacfc \uc138\uc2ec\ud55c \uad00\ucc30\ub825\uc774 \ub099\ud558\ub97c \ud53c\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4."}, {"question": "\ud050\ube0c \ud0c0\uc6cc \uc11c\ud37c\uc5d0\uc11c \ub354 \ub192\uc774 \uc624\ub974\ub294 \ub370 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \uac15\ud654 \uc544\uc774\ud15c\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \uc0ac\uc6a9\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\ud050\ube0c \ud0c0\uc6cc \uc11c\ud37c\uc5d0\uc11c \ub354 \ub192\uc774 \uc624\ub974\ub294 \ub370 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \uac15\ud654 \uc544\uc774\ud15c\uc740 \uc18d\ub3c4 \ubd80\uc2a4\ud2b8\uc640 \ubc29\ud328\uc785\ub2c8\ub2e4. \uc18d\ub3c4 \ubd80\uc2a4\ud2b8\ub294 \ub354 \ube60\ub974\uac8c \ub354 \uba3c \uac70\ub9ac\ub97c \uc774\ub3d9\ud560 \uc218 \uc788\ub3c4\ub85d \ud558\uba70, \ubc29\ud328\ub294 \uc7a5\uc560\ubb3c\ub85c\ubd80\ud130 \ubcf4\ud638\ud569\ub2c8\ub2e4. \uc548\uc815\uc801\uc778 \ud50c\ub7ab\ud3fc\uc774 \uae34 \uad6c\uac04\uc774 \uc788\uc744 \ub54c \uc18d\ub3c4 \ubd80\uc2a4\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc774\ub3d9 \uac70\ub9ac\ub97c \uadf9\ub300\ud654\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc9c1\uc120 \uacbd\ub85c\uc5d0\uc11c \uc18d\ub3c4 \ubd80\uc2a4\ud2b8\ub97c \ud65c\uc131\ud654\ud558\uba74 \uc5ec\ub7ec \ub808\ubca8\uc744 \ube60\ub974\uac8c \uac74\ub108\ub6f8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubc29\ud328\ub294 \ube48\ubc88\ud55c \uc7a5\uc560\ubb3c\uc774 \uc788\ub294 \uad6c\uac04\uc5d0\uc11c \uc0ac\uc6a9\ud558\uc5ec \uc548\uc804\ud558\uac8c \ud1b5\uacfc\ud560 \uc218 \uc788\ub3c4\ub85d \ud558\uc138\uc694. \uc774\ub7ec\ud55c \uac15\ud654 \uc544\uc774\ud15c\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uba74 \uc624\ub974\ub294 \ud6a8\uc728\uc131\uc744 \ud06c\uac8c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud050\ube0c \ud0c0\uc6cc \uc11c\ud37c\uc5d0\uc11c \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \ucd5c\uc885 \uc810\uc218\uc5d0 \uc5b4\ub5a4 \uc694\uc18c\uac00 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ud050\ube0c \ud0c0\uc6cc \uc11c\ud37c\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5ec\ub7ec \uc694\uc18c\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \ucd5c\uc885 \uc810\uc218\ub294 \ub3c4\ub2ec\ud55c \ub192\uc774, \uc131\uacf5\uc801\uc778 \uc810\ud504 \ud69f\uc218, \ubcf4\ub108\uc2a4 \uc544\uc774\ud15c \ud68d\ub4dd \ub4f1\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub354 \ub192\uc740 \ud50c\ub7ab\ud3fc\uc5d0 \ub3c4\ub2ec\ud558\uace0 \ubcf4\uc11d\uc744 \uc218\uc9d1\ud558\uba74 \uc810\uc218\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4. \ub610\ud55c, \ub099\ud558 \uc5c6\uc774 \uc5f0\uc18d \uc810\ud504\ub97c \ud558\ub294 \uacbd\uc6b0 \ucd94\uac00 \uc810\uc218\uac00 \ubd80\uc5ec\ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\uace0 \uac01 \uc694\uc18c\ub97c \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ucd5c\uc801\ud654\ud558\uba74 \ub354 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ubaa8\ubc14\uc77c \ubc84\uc804\uacfc PC \ubc84\uc804\uc758 \ud050\ube0c \ud0c0\uc6cc \uc11c\ud37c\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc774\uba70, \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ubaa8\ubc14\uc77c \ubc84\uc804\uacfc PC \ubc84\uc804\uc758 \ud050\ube0c \ud0c0\uc6cc \uc11c\ud37c\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \uc81c\uc5b4 \ubc29\uc2dd\uacfc \ud654\uba74 \ud06c\uae30\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \ubaa8\ubc14\uc77c\uc5d0\uc11c\ub294 \ud130\uce58 \uc81c\uc5b4\uac00 \uc774\ub3d9 \ubc0f \uc810\ud504\uc5d0 \uc0ac\uc6a9\ub418\uba70, PC\uc5d0\uc11c\ub294 \ud0a4\ubcf4\ub4dc \uc785\ub825\uc774 \uae30\ubcf8\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc758 \ud0a4\ubcf4\ub4dc \uc81c\uc5b4\ub294 \ud130\uce58 \uc81c\uc5b4\uc5d0 \ube44\ud574 \uc880 \ub354 \uc815\ud655\ud55c \uc6c0\uc9c1\uc784\uc744 \uac00\ub2a5\ud558\uac8c \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c PC\uc758 \ub354 \ud070 \ud654\uba74 \ud06c\uae30\ub294 \ud0d1\uc744 \ub354 \uc798 \ubcfc \uc218 \uc788\ub3c4\ub85d \ud558\uc5ec \ud0d0\uc0c9\uc5d0 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ucc28\uc774\uc810\uc5d0 \uc801\uc751\ud558\uba74 \uac01 \ud50c\ub7ab\ud3fc\uc5d0\uc11c\uc758 \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud050\ube0c \ud0c0\uc6cc \uc11c\ud37c\uc5d0\uc11c \uc228\uaca8\uc9c4 \ub808\ubca8\uc744 \uc5b4\ub5bb\uac8c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc73c\uba70, \uc5b4\ub5a4 \uc694\uad6c\uc0ac\ud56d\uc774 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud050\ube0c \ud0c0\uc6cc \uc11c\ud37c\uc5d0\uc11c \uc228\uaca8\uc9c4 \ub808\ubca8\uc744 \uc7a0\uae08 \ud574\uc81c\ud558\ub824\uba74 \ud2b9\uc815 \uc810\uc218 \ub2ec\uc131 \ub610\ub294 \ud2b9\uc815 \uc544\uc774\ud15c \uc218\uc9d1\uacfc \uac19\uc740 \ud2b9\uc815 \uc694\uad6c\uc0ac\ud56d\uc744 \ucda9\uc871\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uba54\uc778 \uac8c\uc784\uc5d0\uc11c 1\ub9cc \uc810\uc744 \ub2ec\uc131\ud558\uba74 \ube44\ubc00 \ub808\ubca8\uc774 \uc5f4\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \ud55c \ubc88\uc758 \ud50c\ub808\uc774\uc5d0\uc11c \ubaa8\ub4e0 \ubcf4\ub108\uc2a4 \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\uba74 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784 \ub0b4 \ud78c\ud2b8\ub97c \uc8fc\uc758 \uae4a\uac8c \uc0b4\ud3b4\ubcf4\uace0 \uc774\ub7ec\ud55c \uae30\uc900\uc744 \ucda9\uc871\ud558\uae30 \uc704\ud574 \ub178\ub825\ud558\uba74 \uac8c\uc784\uc758 \uc228\uaca8\uc9c4 \ub808\ubca8\uc744 \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ubaa8\ubc14\uc77c\uc5d0\uc11c PC\ub85c \ud050\ube0c \ud0c0\uc6cc \uc11c\ud37c\ub97c \uc804\ud658\ud560 \ub54c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc783\uc9c0 \uc54a\uc73c\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\ubaa8\ubc14\uc77c\uc5d0\uc11c PC\ub85c \ud050\ube0c \ud0c0\uc6cc \uc11c\ud37c\ub97c \uc804\ud658\ud560 \ub54c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc783\uc9c0 \uc54a\uc73c\ub824\uba74 \ub450 \ud50c\ub7ab\ud3fc \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubaa8\ubc14\uc77c\uc5d0\uc11c \uad6c\uae00 \ud50c\ub808\uc774 \uacc4\uc815\uc744 \uc0ac\uc6a9\ud558\ub294 \uacbd\uc6b0 PC \ubc84\uc804\uc5d0\uc11c\ub3c4 \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uc138\uc694. \ub610\ud55c, \uc815\uae30\uc801\uc73c\ub85c \uac8c\uc784 \ub370\uc774\ud130\ub97c \ud074\ub77c\uc6b0\ub4dc\uc5d0 \ubc31\uc5c5\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \uc548\uc804\ud558\uac8c \ubcf4\ud638\ud558\uc138\uc694. \uc774\ub7ec\ud55c \uc6d0\ud65c\ud55c \uc804\ud658\uc744 \ud1b5\ud574 \ud50c\ub7ab\ud3fc\uc5d0 \uad00\uacc4\uc5c6\uc774 \uc9c4\ud589\ud588\ub358 \uacf3\uc5d0\uc11c \uac8c\uc784\uc744 \uacc4\uc18d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud050\ube0c \ud0c0\uc6cc \uc11c\ud37c\uc5d0\uc11c \uc774\uc810\uc744 \uc5bb\uae30 \uc704\ud574 \ube44\ubc00 \uc9c0\ub984\uae38\uc744 \uc2dd\ubcc4\ud558\uace0 \ud65c\uc6a9\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud050\ube0c \ud0c0\uc6cc \uc11c\ud37c\uc5d0\uc11c \ube44\ubc00 \uc9c0\ub984\uae38\uc744 \uc2dd\ubcc4\ud558\uace0 \ud65c\uc6a9\ud558\ub824\uba74 \uc138\uc2ec\ud55c \uad00\ucc30\ub825\uacfc \ud0d0\uc0c9\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ud50c\ub7ab\ud3fc \uc9c8\uac10\uc758 \ubbf8\ubb18\ud55c \ucc28\uc774\uc810\uc774\ub098 \uc228\uaca8\uc9c4 \ud1b5\ub85c\uc640 \uac19\uc740 \ubbf8\uc138\ud55c \uc2dc\uac01\uc801 \ub2e8\uc11c\ub97c \ucc3e\uc544\ubcf4\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc57d\uac04 \ube5b\ub098\ub294 \ud50c\ub7ab\ud3fc\uc740 \uc9c0\ub984\uae38\uc744 \ub098\ud0c0\ub0bc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2dd\ubcc4\ud55c \ud6c4\uc5d0\ub294 \uc815\ud655\ud55c \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \ub9de\ucdb0 \uc774\ub7ec\ud55c \uc9c0\ub984\uae38\uc5d0 \uc811\uadfc\ud558\uc138\uc694. \uc774\ub4e4\uc744 \ud65c\uc6a9\ud558\uba74 \ub09c\uc774\ub3c4 \ub192\uc740 \uad6c\uac04\uc744 \uc6b0\ud68c\ud558\uace0 \ub354 \ud6a8\uc728\uc801\uc73c\ub85c \ud0d1\uc744 \uc624\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud56d\uc0c1 \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uae30\ud68c\ub97c \uc8fc\uc758 \uae4a\uac8c \uc0b4\ud3b4 \uc774\uc810\uc744 \uc5bb\uc73c\uc138\uc694."}, {"question": "\ud050\ube0c \ud0c0\uc6cc \uc11c\ud37c\uc5d0\uc11c \ud050\ube0c\uc758 \uc6c0\uc9c1\uc784 \ub4a4\uc5d0 \uc788\ub294 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud558\uc5ec \uc131\ub2a5\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud050\ube0c \ud0c0\uc6cc \uc11c\ud37c\uc5d0\uc11c \ud050\ube0c\uc758 \uc6c0\uc9c1\uc784 \ub4a4\uc5d0\ub294 \ubb3c\ub9ac \uae30\ubc18 \uc81c\uc5b4\uc640 \ud50c\ub7ab\ud3fc \uc0c1\ud638\uc791\uc6a9\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ud050\ube0c\uc758 \uc6c0\uc9c1\uc784\uc740 \uc911\ub825, \uc6b4\ub3d9\ub7c9, \ud50c\ub7ab\ud3fc\uc758 \uae30\uc6b8\uae30\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \ud050\ube0c\uc758 \uc18d\ub3c4\uc640 \ubc29\ud5a5\uc744 \uc81c\uc5b4\ud558\ub294 \uc5f0\uc2b5\uc744 \ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub0b4\ub824\uac08 \ub54c\ub294 \uc0b4\uc9dd \ud0ed\ud558\uc5ec \uc18d\ub3c4\ub97c \uc904\uc774\uace0 \uade0\ud615\uc744 \uc720\uc9c0\ud558\uc138\uc694. \ub610\ud55c, \ud50c\ub7ab\ud3fc\uc758 \uc6c0\uc9c1\uc784\uc744 \uc608\uce21\ud558\uace0 \ud050\ube0c\uc758 \uc704\uce58\ub97c \uc801\uc808\ud788 \uc870\uc815\ud558\uc138\uc694. \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \ub9c8\uc2a4\ud130\ud558\uba74 \uc81c\uc5b4\ub825\uacfc \uc804\uccb4\uc801\uc778 \uac8c\uc784 \uc131\ub2a5\uc774 \ud5a5\uc0c1\ub420 \uac83\uc785\ub2c8\ub2e4."}]
[{"question": "\u5982\u4f55\u6709\u6548\u63a7\u5236\u6211\u7684\u65b9\u584a\uff0c\u5728\u65b9\u584a\u5854\u885d\u6d6a\u904a\u6232\u4e2d\u4f5c\u70ba\u65b0\u624b\uff1f", "answer": "\u5728\u65b9\u584a\u5854\u885d\u6d6a\u904a\u6232\u4e2d\u6709\u6548\u63a7\u5236\u60a8\u7684\u65b9\u584a\uff0c\u9996\u5148\u8981\u719f\u6089\u57fa\u672c\u63a7\u5236\u3002\u4f7f\u7528\u5de6\u53f3\u7bad\u982d\u4f86\u6c34\u5e73\u79fb\u52d5\u60a8\u7684\u65b9\u584a\u3002\u4f8b\u5982\uff0c\u7576\u63a5\u8fd1\u72f9\u7a84\u7684\u901a\u9053\u6642\uff0c\u8f15\u89f8\u7bad\u982d\u4ee5\u9032\u884c\u5fae\u8abf\u3002\u6b64\u5916\uff0c\u7df4\u7fd2\u8df3\u8e8d\u6642\u9593\uff0c\u6309\u4e0b\u7a7a\u683c\u9375\u4ee5\u907f\u958b\u969c\u7919\u7269\u3002\u8a18\u4f4f\uff0c\u5e73\u7a69\u4e14\u7cbe\u78ba\u7684\u52d5\u4f5c\u662f\u6210\u529f\u7a7f\u8d8a\u5854\u6a13\u7684\u95dc\u9375\u3002"}, {"question": "\u5728\u73a9\u4e86\u65b9\u584a\u5854\u885d\u6d6a\u904a\u6232 100 \u5c0f\u6642\u5f8c\uff0c\u9054\u6210\u9ad8\u5206\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u73a9\u4e86\u65b9\u584a\u5854\u885d\u6d6a\u904a\u6232 100 \u5c0f\u6642\u5f8c\uff0c\u5c08\u6ce8\u65bc\u9032\u968e\u7b56\u7565\uff0c\u4ee5\u6700\u5927\u5316\u60a8\u7684\u5f97\u5206\u3002\u6b65\u9a5f1\uff1a\u59cb\u7d42\u7784\u6e96\u5e73\u53f0\u4e2d\u5fc3\uff0c\u4ee5\u4fdd\u6301\u5e73\u8861\u3002\u6b65\u9a5f2\uff1a\u5229\u7528\u52a0\u901f\u9053\u5177\uff0c\u4f8b\u5982\u52a0\u901f\u589e\u76ca\uff0c\u5feb\u901f\u8986\u84cb\u66f4\u591a\u8ddd\u96e2\u3002\u6b65\u9a5f3\uff1a\u638c\u63e1\u9023\u7e8c\u8df3\u8e8d\u7684\u6280\u5de7\uff0c\u4ee5\u7372\u5f97\u984d\u5916\u5206\u6578\u3002\u4f8b\u5982\uff0c\u5728\u79fb\u52d5\u5e73\u53f0\u4e0a\u7cbe\u6e96\u5730\u9023\u7e8c\u8df3\u8e8d\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u60a8\u7684\u5f97\u5206\u3002\u6301\u7e8c\u7684\u7df4\u7fd2\u548c\u6e96\u78ba\u6027\u5c07\u5e6b\u52a9\u60a8\u6500\u767b\u66f4\u9ad8\u4e26\u7372\u5f97\u66f4\u591a\u5206\u6578\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u7684\u65b9\u584a\u6709\u6642\u5728\u65b9\u584a\u5854\u885d\u6d6a\u904a\u6232\u4e2d\u6703\u610f\u5916\u589c\u843d\uff0c\u4ee5\u53ca\u5982\u4f55\u9810\u9632\uff1f", "answer": "\u60a8\u5728\u65b9\u584a\u5854\u885d\u6d6a\u904a\u6232\u4e2d\u65b9\u584a\u610f\u5916\u589c\u843d\uff0c\u53ef\u80fd\u662f\u7531\u65bc\u8df3\u8e8d\u5224\u65b7\u5931\u8aa4\u6216\u5e73\u53f0\u7a81\u7136\u79fb\u52d5\u3002\u70ba\u907f\u514d\u9019\u7a2e\u60c5\u6cc1\uff0c\u8acb\u59cb\u7d42\u9810\u6e2c\u5e73\u53f0\u7684\u79fb\u52d5\u4e26\u76f8\u61c9\u5730\u8abf\u6574\u60a8\u7684\u4f4d\u7f6e\u3002\u4f8b\u5982\uff0c\u7576\u5e73\u53f0\u958b\u59cb\u50be\u659c\u6642\uff0c\u5c07\u60a8\u7684\u65b9\u584a\u79fb\u52d5\u5230\u53e6\u4e00\u5074\u4ee5\u5e73\u8861\u3002\u6b64\u5916\uff0c\u907f\u514d\u5009\u4fc3\u884c\u4e8b\uff0c\u82b1\u6642\u9593\u8a08\u5283\u6bcf\u500b\u52d5\u4f5c\u3002\u8010\u5fc3\u548c\u4ed4\u7d30\u89c0\u5bdf\u5c0d\u65bc\u907f\u514d\u589c\u843d\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u5728\u65b9\u584a\u5854\u885d\u6d6a\u904a\u6232\u4e2d\uff0c\u54ea\u4e9b\u9053\u5177\u6700\u6709\u6548\u63d0\u5347\u6500\u767b\u9ad8\u5ea6\uff0c\u4ee5\u53ca\u5982\u4f55\u4f7f\u7528\u5b83\u5011\uff1f", "answer": "\u5728\u65b9\u584a\u5854\u885d\u6d6a\u904a\u6232\u4e2d\uff0c\u6700\u6709\u6548\u7684\u9053\u5177\u662f\u52a0\u901f\u589e\u76ca\u548c\u8b77\u76fe\u3002\u52a0\u901f\u589e\u76ca\u8b93\u60a8\u53ef\u4ee5\u5feb\u901f\u8986\u84cb\u66f4\u591a\u5730\u9762\uff0c\u800c\u8b77\u76fe\u5247\u4fdd\u8b77\u60a8\u514d\u53d7\u969c\u7919\u7269\u50b7\u5bb3\u3002\u7576\u60a8\u9047\u5230\u9577\u800c\u7a69\u5b9a\u7684\u5e73\u53f0\u6642\uff0c\u4f7f\u7528\u52a0\u901f\u589e\u76ca\u4ee5\u6700\u5927\u5316\u8ddd\u96e2\u3002\u4f8b\u5982\uff0c\u5728\u76f4\u7dda\u8def\u5f91\u4e0a\u555f\u52d5\u52a0\u901f\u589e\u76ca\u53ef\u4ee5\u5e6b\u52a9\u60a8\u7e5e\u904e\u591a\u500b\u5c64\u7d1a\u3002\u5728\u983b\u7e41\u51fa\u73fe\u969c\u7919\u7269\u7684\u5730\u5340\u4f7f\u7528\u8b77\u76fe\uff0c\u4ee5\u78ba\u4fdd\u5b89\u5168\u901a\u884c\u3002\u7b56\u7565\u6027\u5730\u4f7f\u7528\u9019\u4e9b\u9053\u5177\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u60a8\u7684\u6500\u767b\u6548\u7387\u3002"}, {"question": "\u65b9\u584a\u5854\u885d\u6d6a\u904a\u6232\u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u6700\u7d42\u5f97\u5206\uff1f", "answer": "\u65b9\u584a\u5854\u885d\u6d6a\u904a\u6232\u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u5e7e\u500b\u56e0\u7d20\u3002\u60a8\u7684\u6700\u7d42\u5f97\u5206\u53d7\u60a8\u5230\u9054\u7684\u9ad8\u5ea6\u3001\u6210\u529f\u8df3\u8e8d\u6b21\u6578\u4ee5\u53ca\u6536\u96c6\u734e\u52f5\u7269\u54c1\u7684\u5f71\u97ff\u3002\u4f8b\u5982\uff0c\u5230\u9054\u66f4\u9ad8\u7684\u5e73\u53f0\u4e26\u6536\u96c6\u5bf6\u77f3\u6703\u589e\u52a0\u60a8\u7684\u5f97\u5206\u3002\u6b64\u5916\uff0c\u9023\u7e8c\u8df3\u8e8d\u4e14\u4e0d\u589c\u843d\u6703\u7372\u5f97\u984d\u5916\u5206\u6578\u3002\u4e86\u89e3\u9019\u4e9b\u6a5f\u5236\u4e26\u512a\u5316\u60a8\u7684\u904a\u6232\u73a9\u6cd5\u4ee5\u6700\u5927\u5316\u6bcf\u500b\u56e0\u7d20\uff0c\u5c07\u6709\u52a9\u65bc\u60a8\u7372\u5f97\u66f4\u9ad8\u7684\u5f97\u5206\u3002"}, {"question": "\u884c\u52d5\u88dd\u7f6e\u7248\u548c\u96fb\u8166\u7248\u65b9\u584a\u5854\u885d\u6d6a\u904a\u6232\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5b83\u5011\u5982\u4f55\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff1f", "answer": "\u884c\u52d5\u88dd\u7f6e\u7248\u548c\u96fb\u8166\u7248\u65b9\u584a\u5854\u885d\u6d6a\u904a\u6232\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u5728\u65bc\u63a7\u5236\u65b9\u6848\u548c\u87a2\u5e55\u5927\u5c0f\u3002\u5728\u884c\u52d5\u88dd\u7f6e\u4e0a\uff0c\u89f8\u63a7\u63a7\u5236\u7528\u65bc\u79fb\u52d5\u548c\u8df3\u8e8d\uff0c\u800c\u5728\u96fb\u8166\u4e0a\uff0c\u9375\u76e4\u8f38\u5165\u662f\u6a19\u6e96\u7684\u3002\u4f8b\u5982\uff0c\u96fb\u8166\u4e0a\u7684\u9375\u76e4\u63a7\u5236\u7684\u7cbe\u78ba\u6027\u53ef\u80fd\u5141\u8a31\u66f4\u7cbe\u78ba\u7684\u52d5\u4f5c\uff0c\u8207\u89f8\u63a7\u63a7\u5236\u76f8\u6bd4\u3002\u6b64\u5916\uff0c\u96fb\u8166\u4e0a\u66f4\u5927\u7684\u87a2\u5e55\u5c3a\u5bf8\u63d0\u4f9b\u4e86\u66f4\u597d\u7684\u5854\u6a13\u8996\u5716\uff0c\u6709\u52a9\u65bc\u5c0e\u822a\u3002\u9069\u61c9\u9019\u4e9b\u5dee\u7570\u53ef\u4ee5\u589e\u5f37\u60a8\u5728\u6bcf\u500b\u5e73\u53f0\u4e0a\u7684\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u5982\u4f55\u5728\u65b9\u584a\u5854\u885d\u6d6a\u904a\u6232\u4e2d\u89e3\u9396\u96b1\u85cf\u95dc\u5361\uff0c\u4ee5\u53ca\u5176\u8981\u6c42\u662f\u4ec0\u9ebc\uff1f", "answer": "\u8981\u89e3\u9396\u65b9\u584a\u5854\u885d\u6d6a\u904a\u6232\u4e2d\u7684\u96b1\u85cf\u95dc\u5361\uff0c\u60a8\u9700\u8981\u6eff\u8db3\u7279\u5b9a\u8981\u6c42\uff0c\u4f8b\u5982\u9054\u5230\u7279\u5b9a\u5206\u6578\u6216\u6536\u96c6\u7a00\u6709\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5728\u4e3b\u904a\u6232\u4e2d\u9054\u5230 10,000 \u5206\u6578\u53ef\u80fd\u6703\u89e3\u9396\u4e00\u500b\u79d8\u5bc6\u95dc\u5361\u3002\u6b64\u5916\uff0c\u5b8c\u6210\u55ae\u4e00\u904a\u6232\u6d41\u7a0b\u4e2d\u7684\u6240\u6709\u984d\u5916\u6311\u6230\uff0c\u4e5f\u53ef\u4ee5\u7372\u5f97\u96b1\u85cf\u5167\u5bb9\u7684\u8a2a\u554f\u6b0a\u9650\u3002\u5bc6\u5207\u7559\u610f\u904a\u6232\u63d0\u793a\uff0c\u4e26\u52aa\u529b\u6eff\u8db3\u9019\u4e9b\u689d\u4ef6\u4ee5\u767c\u73fe\u904a\u6232\u7684\u96b1\u85cf\u95dc\u5361\u3002"}, {"question": "\u5982\u4f55\u5728\u4e0d\u640d\u5931\u9032\u5ea6\u7684\u65b9\u584a\u5854\u885d\u6d6a\u4e2d\u5f9e\u884c\u52d5\u88dd\u7f6e\u8f49\u5230\u96fb\u8166\uff0c\u8a72\u5982\u4f55\u64cd\u4f5c\uff1f", "answer": "\u8981\u5728\u4e0d\u640d\u5931\u9032\u5ea6\u7684\u65b9\u584a\u5854\u885d\u6d6a\u4e2d\u5f9e\u884c\u52d5\u88dd\u7f6e\u8f49\u5230\u96fb\u8166\uff0c\u8acb\u78ba\u4fdd\u60a8\u5728\u5169\u500b\u5e73\u53f0\u4e0a\u90fd\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u884c\u52d5\u88dd\u7f6e\u4e0a\u4f7f\u7528 Google Play \u5e33\u6236\uff0c\u8acb\u5728\u96fb\u8166\u7248\u4e0a\u4f7f\u7528\u76f8\u540c\u7684\u5e33\u6236\u767b\u5165\u3002\u6b64\u5916\uff0c\u5b9a\u671f\u5099\u4efd\u60a8\u7684\u904a\u6232\u6578\u64da\u5230\u96f2\u7aef\uff0c\u4ee5\u4fdd\u8b77\u60a8\u7684\u9032\u5ea6\u3002\u9019\u7a2e\u7121\u7e2b\u8f49\u63db\u4f7f\u60a8\u80fd\u5920\u5f9e\u60a8\u96e2\u958b\u7684\u5730\u65b9\u7e7c\u7e8c\u904a\u6232\uff0c\u800c\u8207\u5e73\u53f0\u7121\u95dc\u3002"}, {"question": "\u5982\u4f55\u5728\u65b9\u584a\u5854\u885d\u6d6a\u904a\u6232\u4e2d\u8fa8\u8b58\u548c\u5229\u7528\u79d8\u5bc6\u6377\u5f91\u4ee5\u7372\u5f97\u512a\u52e2\uff1f", "answer": "\u8fa8\u8b58\u548c\u5229\u7528\u65b9\u584a\u5854\u885d\u6d6a\u904a\u6232\u4e2d\u7684\u79d8\u5bc6\u6377\u5f91\uff0c\u9700\u8981\u654f\u92b3\u7684\u89c0\u5bdf\u529b\u53ca\u63a2\u7d22\u7cbe\u795e\u3002\u5c0b\u627e\u7d30\u5fae\u7684\u8996\u89ba\u63d0\u793a\uff0c\u4f8b\u5982\u7565\u5fae\u4e0d\u540c\u7684\u5e73\u53f0\u7d0b\u7406\u6216\u96b1\u85cf\u7684\u901a\u9053\u3002\u4f8b\u5982\uff0c\u767c\u51fa\u5fae\u5f31\u5149\u8292\u7684\u5e73\u53f0\u53ef\u80fd\u8868\u793a\u6377\u5f91\u7684\u5b58\u5728\u3002\u4e00\u65e6\u627e\u5230\uff0c\u8acb\u7cbe\u78ba\u5730\u63a7\u5236\u8df3\u8e8d\u6642\u9593\u4ee5\u9032\u5165\u9019\u4e9b\u6377\u5f91\u3002\u5229\u7528\u5b83\u5011\u53ef\u4ee5\u5e6b\u52a9\u60a8\u7e5e\u904e\u5177\u6709\u6311\u6230\u6027\u7684\u90e8\u5206\uff0c\u4e26\u66f4\u6709\u6548\u5730\u6500\u767b\u5854\u6a13\u3002\u59cb\u7d42\u7559\u610f\u9019\u4e9b\u96b1\u85cf\u7684\u6a5f\u6703\uff0c\u4ee5\u7372\u5f97\u512a\u52e2\u3002"}, {"question": "\u65b9\u584a\u5728\u65b9\u584a\u5854\u885d\u6d6a\u904a\u6232\u4e2d\u7684\u79fb\u52d5\u6a5f\u5236\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u4f73\u5316\u5b83\u5011\u4ee5\u7372\u5f97\u66f4\u597d\u7684\u6548\u80fd\uff1f", "answer": "\u65b9\u584a\u5728\u65b9\u584a\u5854\u885d\u6d6a\u904a\u6232\u4e2d\u7684\u79fb\u52d5\u6a5f\u5236\u6d89\u53ca\u57fa\u65bc\u7269\u7406\u7684\u63a7\u5236\u53ca\u5e73\u53f0\u4e92\u52d5\u3002\u65b9\u584a\u7684\u79fb\u52d5\u53d7\u5230\u91cd\u529b\u3001\u52d5\u91cf\u548c\u5e73\u53f0\u50be\u659c\u5ea6\u7684\u5f71\u97ff\u3002\u70ba\u4e86\u6700\u4f73\u5316\u6548\u80fd\uff0c\u7df4\u7fd2\u63a7\u5236\u65b9\u584a\u7684\u901f\u5ea6\u548c\u65b9\u5411\u3002\u4f8b\u5982\uff0c\u4e0b\u964d\u6642\uff0c\u4f7f\u7528\u8f15\u89f8\u4f86\u6e1b\u901f\u4e26\u4fdd\u6301\u5e73\u8861\u3002\u6b64\u5916\uff0c\u9810\u6e2c\u5e73\u53f0\u79fb\u52d5\u4e26\u76f8\u61c9\u5730\u8abf\u6574\u65b9\u584a\u4f4d\u7f6e\u3002\u638c\u63e1\u9019\u4e9b\u6a5f\u5236\u5c07\u589e\u5f37\u60a8\u7684\u63a7\u5236\u80fd\u529b\u548c\u6574\u9ad4\u904a\u6232\u6548\u80fd\u3002"}]
[{"question": "\u5982\u4f55\u5728\u300a\u65b9\u5757\u5854\u51b2\u6d6a\u300b\u6e38\u620f\u4e2d\uff0c\u4f5c\u4e3a\u65b0\u624b\u6709\u6548\u63a7\u5236\u65b9\u5757\uff1f", "answer": "\u4e3a\u4e86\u5728\u300a\u65b9\u5757\u5854\u51b2\u6d6a\u300b\u4e2d\u6709\u6548\u63a7\u5236\u4f60\u7684\u65b9\u5757\uff0c\u9996\u5148\u8981\u719f\u6089\u57fa\u672c\u64cd\u4f5c\u3002\u4f7f\u7528\u5de6\u53f3\u7bad\u5934\u952e\u6c34\u5e73\u79fb\u52a8\u65b9\u5757\u3002\u4f8b\u5982\uff0c\u5728\u63a5\u8fd1\u72ed\u7a84\u8def\u5f84\u65f6\uff0c\u8f7b\u89e6\u7bad\u5934\u952e\u8fdb\u884c\u5fae\u8c03\u3002\u6b64\u5916\uff0c\u7ec3\u4e60\u8df3\u8dc3\u65f6\u673a\uff0c\u6309\u4e0b\u7a7a\u683c\u952e\u4ee5\u8eb2\u907f\u969c\u788d\u7269\u3002\u8bb0\u4f4f\uff0c\u5e73\u7a33\u800c\u7cbe\u786e\u7684\u52a8\u4f5c\u662f\u6210\u529f\u6500\u767b\u5854\u697c\u7684\u5173\u952e\u3002"}, {"question": "\u5728\u6e38\u620f\u300a\u65b9\u5757\u5854\u51b2\u6d6a\u300b\u4e2d\u73a9\u4e86100\u5c0f\u65f6\u540e\uff0c\u5982\u4f55\u624d\u80fd\u53d6\u5f97\u9ad8\u5206\uff1f", "answer": "\u5728\u73a9\u4e86100\u4e2a\u5c0f\u65f6\u540e\uff0c\u8bf7\u4e13\u6ce8\u4e8e\u300a\u65b9\u5757\u5854\u51b2\u6d6a\u300b\u4e2d\u66f4\u9ad8\u7ea7\u7684\u7b56\u7565\uff0c\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u5206\u6570\u3002\u6b65\u9aa41\uff1a\u59cb\u7ec8\u7784\u51c6\u5e73\u53f0\u4e2d\u5fc3\u4fdd\u6301\u5e73\u8861\u3002\u6b65\u9aa42\uff1a\u5229\u7528\u901f\u5ea6\u52a0\u6210\u7b49\u9053\u5177\u5feb\u901f\u8986\u76d6\u66f4\u591a\u8ddd\u79bb\u3002\u6b65\u9aa43\uff1a\u638c\u63e1\u8fde\u8df3\u6280\u5de7\u4ee5\u83b7\u5f97\u989d\u5916\u5206\u6570\u3002\u4f8b\u5982\uff0c\u5728\u79fb\u52a8\u5e73\u53f0\u4e0a\u8fdb\u884c\u8fde\u7eed\u8df3\u8dc3\u7684\u65f6\u673a\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u5206\u6570\u3002\u6301\u7eed\u7ec3\u4e60\u548c\u7cbe\u786e\u64cd\u4f5c\u5c06\u5e2e\u52a9\u4f60\u6500\u767b\u66f4\u9ad8\u7684\u9ad8\u5ea6\u5e76\u83b7\u5f97\u66f4\u591a\u5206\u6570\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u7684\u65b9\u5757\u6709\u65f6\u4f1a\u5728\u300a\u65b9\u5757\u5854\u51b2\u6d6a\u300b\u4e2d\u610f\u5916\u6389\u843d\uff0c\u5982\u4f55\u9884\u9632\uff1f", "answer": "\u4f60\u7684\u65b9\u5757\u5728\u300a\u65b9\u5757\u5854\u51b2\u6d6a\u300b\u4e2d\u53ef\u80fd\u4f1a\u610f\u5916\u6389\u843d\uff0c\u539f\u56e0\u53ef\u80fd\u662f\u8df3\u8dc3\u5224\u65ad\u5931\u8bef\u6216\u5e73\u53f0\u7a81\u7136\u79fb\u52a8\u3002\u4e3a\u4e86\u9632\u6b62\u8fd9\u79cd\u60c5\u51b5\u53d1\u751f\uff0c\u8bf7\u59cb\u7ec8\u9884\u6d4b\u5e73\u53f0\u7684\u79fb\u52a8\u5e76\u76f8\u5e94\u8c03\u6574\u4f60\u7684\u4f4d\u7f6e\u3002\u4f8b\u5982\uff0c\u5f53\u5e73\u53f0\u5f00\u59cb\u503e\u659c\u65f6\uff0c\u5c06\u4f60\u7684\u65b9\u5757\u79fb\u52a8\u5230\u53cd\u65b9\u5411\u4ee5\u4fdd\u6301\u5e73\u8861\u3002\u6b64\u5916\uff0c\u907f\u514d\u5306\u5fd9\u884c\u4e8b\uff0c\u82b1\u65f6\u95f4\u8ba1\u5212\u597d\u6bcf\u4e00\u6b65\u3002\u8010\u5fc3\u548c\u4ed4\u7ec6\u89c2\u5bdf\u5bf9\u4e8e\u907f\u514d\u6389\u843d\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u5728\u300a\u65b9\u5757\u5854\u51b2\u6d6a\u300b\u4e2d\uff0c\u54ea\u4e9b\u9053\u5177\u6700\u6709\u6548\u5730\u5e2e\u52a9\u4f60\u6500\u767b\u66f4\u9ad8\uff0c\u5e94\u8be5\u5982\u4f55\u4f7f\u7528\uff1f", "answer": "\u5728\u300a\u65b9\u5757\u5854\u51b2\u6d6a\u300b\u4e2d\uff0c\u901f\u5ea6\u52a0\u6210\u548c\u62a4\u76fe\u9053\u5177\u6700\u6709\u6548\u5730\u5e2e\u52a9\u4f60\u6500\u767b\u66f4\u9ad8\u3002\u901f\u5ea6\u52a0\u6210\u9053\u5177\u53ef\u4ee5\u8ba9\u4f60\u5feb\u901f\u8986\u76d6\u66f4\u591a\u5730\u9762\uff0c\u800c\u62a4\u76fe\u9053\u5177\u5219\u53ef\u4ee5\u4fdd\u62a4\u4f60\u514d\u53d7\u969c\u788d\u7269\u7684\u4f24\u5bb3\u3002\u5728\u9047\u5230\u957f\u6bb5\u7a33\u5b9a\u7684\u5e73\u53f0\u65f6\u4f7f\u7528\u901f\u5ea6\u52a0\u6210\uff0c\u4ee5\u6700\u5927\u5316\u8ddd\u79bb\u3002\u4f8b\u5982\uff0c\u5728\u76f4\u8def\u4e0a\u6fc0\u6d3b\u901f\u5ea6\u52a0\u6210\u53ef\u4ee5\u5e2e\u52a9\u4f60\u7ed5\u8fc7\u591a\u4e2a\u5173\u5361\u3002\u5728\u969c\u788d\u7269\u5bc6\u96c6\u533a\u57df\u4f7f\u7528\u62a4\u76fe\uff0c\u4ee5\u786e\u4fdd\u5b89\u5168\u901a\u8fc7\u3002\u6218\u7565\u6027\u5730\u4f7f\u7528\u8fd9\u4e9b\u9053\u5177\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u6500\u767b\u6548\u7387\u3002"}, {"question": "\u300a\u65b9\u5757\u5854\u51b2\u6d6a\u300b\u4e2d\u7684\u5f97\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u6700\u7ec8\u5f97\u5206\uff1f", "answer": "\u300a\u65b9\u5757\u5854\u51b2\u6d6a\u300b\u7684\u5f97\u5206\u7cfb\u7edf\u57fa\u4e8e\u51e0\u4e2a\u56e0\u7d20\u3002\u4f60\u7684\u6700\u7ec8\u5f97\u5206\u53d7\u4f60\u8fbe\u5230\u7684\u9ad8\u5ea6\u3001\u6210\u529f\u8df3\u8dc3\u6b21\u6570\u4ee5\u53ca\u6536\u96c6\u5230\u7684\u5956\u52b1\u7269\u54c1\u7684\u5f71\u54cd\u3002\u4f8b\u5982\uff0c\u5230\u8fbe\u66f4\u9ad8\u7684\u5e73\u53f0\u5e76\u6536\u96c6\u5b9d\u77f3\u4f1a\u589e\u52a0\u4f60\u7684\u5206\u6570\u3002\u6b64\u5916\uff0c\u8fde\u7eed\u8df3\u8dc3\u800c\u4e0d\u6389\u843d\u5c06\u989d\u5916\u83b7\u5f97\u5206\u6570\u3002\u7406\u89e3\u8fd9\u4e9b\u673a\u5236\u5e76\u4f18\u5316\u4f60\u7684\u6e38\u620f\u73a9\u6cd5\u4ee5\u6700\u5927\u5316\u6bcf\u4e2a\u56e0\u7d20\u5c06\u6709\u52a9\u4e8e\u4f60\u83b7\u5f97\u66f4\u9ad8\u7684\u5206\u6570\u3002"}, {"question": "\u300a\u65b9\u5757\u5854\u51b2\u6d6a\u300b\u7684\u79fb\u52a8\u7aef\u548cPC\u7aef\u7248\u672c\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff0c\u4ee5\u53ca\u8fd9\u4e9b\u533a\u522b\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\uff1f", "answer": "\u300a\u65b9\u5757\u5854\u51b2\u6d6a\u300b\u7684\u79fb\u52a8\u7aef\u548cPC\u7aef\u7248\u672c\u7684\u5173\u952e\u533a\u522b\u5728\u4e8e\u63a7\u5236\u65b9\u6848\u548c\u5c4f\u5e55\u5c3a\u5bf8\u3002\u5728\u79fb\u52a8\u7aef\uff0c\u89e6\u6478\u63a7\u5236\u7528\u4e8e\u79fb\u52a8\u548c\u8df3\u8dc3\uff1b\u800c\u5728PC\u7aef\uff0c\u952e\u76d8\u8f93\u5165\u662f\u6807\u51c6\u64cd\u4f5c\u3002\u4f8b\u5982\uff0cPC\u7aef\u7684\u952e\u76d8\u63a7\u5236\u53ef\u80fd\u6bd4\u89e6\u6478\u63a7\u5236\u66f4\u7cbe\u786e\u3002\u6b64\u5916\uff0cPC\u7aef\u7684\u66f4\u5927\u5c4f\u5e55\u5c3a\u5bf8\u63d0\u4f9b\u4e86\u66f4\u597d\u7684\u5854\u697c\u89c6\u91ce\uff0c\u6709\u52a9\u4e8e\u5bfc\u822a\u3002\u9002\u5e94\u8fd9\u4e9b\u5dee\u5f02\u53ef\u4ee5\u589e\u5f3a\u4f60\u5728\u6bcf\u4e2a\u5e73\u53f0\u4e0a\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u65b9\u5757\u5854\u51b2\u6d6a\u300b\u4e2d\u89e3\u9501\u9690\u85cf\u5173\u5361\uff0c\u9700\u8981\u54ea\u4e9b\u6761\u4ef6\uff1f", "answer": "\u8981\u89e3\u9501\u300a\u65b9\u5757\u5854\u51b2\u6d6a\u300b\u4e2d\u7684\u9690\u85cf\u5173\u5361\uff0c\u4f60\u9700\u8981\u6ee1\u8db3\u4e00\u4e9b\u7279\u5b9a\u6761\u4ef6\uff0c\u4f8b\u5982\u8fbe\u5230\u7279\u5b9a\u5206\u6570\u6216\u6536\u96c6\u7a00\u6709\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5728\u4e3b\u6e38\u620f\u4e2d\u8fbe\u523010,000\u5206\u53ef\u80fd\u4f1a\u89e3\u9501\u4e00\u4e2a\u79d8\u5bc6\u5173\u5361\u3002\u6b64\u5916\uff0c\u5728\u5355\u6b21\u6e38\u620f\u8fdb\u7a0b\u4e2d\u5b8c\u6210\u6240\u6709\u989d\u5916\u6311\u6218\u4e5f\u53ef\u4ee5\u83b7\u5f97\u8bbf\u95ee\u9690\u85cf\u5185\u5bb9\u7684\u6743\u5229\u3002\u5bc6\u5207\u5173\u6ce8\u6e38\u620f\u4e2d\u7684\u63d0\u793a\uff0c\u5e76\u52aa\u529b\u6ee1\u8db3\u8fd9\u4e9b\u6761\u4ef6\u4ee5\u53d1\u73b0\u6e38\u620f\u7684\u9690\u85cf\u5173\u5361\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u65b9\u5757\u5854\u51b2\u6d6a\u300b\u4e2d\u4ece\u79fb\u52a8\u7aef\u5e73\u7a33\u8fc7\u6e21\u5230PC\u7aef\uff0c\u907f\u514d\u4e22\u5931\u6e38\u620f\u8fdb\u5ea6\uff1f", "answer": "\u4e3a\u4e86\u5728\u300a\u65b9\u5757\u5854\u51b2\u6d6a\u300b\u4e2d\u4ece\u79fb\u52a8\u7aef\u5e73\u7a33\u8fc7\u6e21\u5230PC\u7aef\uff0c\u5e76\u907f\u514d\u4e22\u5931\u6e38\u620f\u8fdb\u5ea6\uff0c\u8bf7\u786e\u4fdd\u4f60\u5df2\u5728\u4e24\u4e2a\u5e73\u53f0\u4e0a\u767b\u5f55\u540c\u4e00\u4e2a\u8d26\u6237\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u79fb\u52a8\u7aef\u4f7f\u7528Google Play\u8d26\u53f7\uff0c\u8bf7\u5728PC\u7aef\u4f7f\u7528\u76f8\u540c\u7684\u8d26\u53f7\u767b\u5f55\u3002\u6b64\u5916\uff0c\u5b9a\u671f\u5c06\u4f60\u7684\u6e38\u620f\u6570\u636e\u5907\u4efd\u5230\u4e91\u7aef\u4ee5\u4fdd\u62a4\u4f60\u7684\u6e38\u620f\u8fdb\u5ea6\u3002\u8fd9\u79cd\u5e73\u987a\u7684\u8fc7\u6e21\u5c06\u4f7f\u4f60\u80fd\u591f\u4ece\u4e2d\u65ad\u7684\u5730\u65b9\u7ee7\u7eed\u6e38\u620f\uff0c\u65e0\u8bba\u4f60\u4f7f\u7528\u54ea\u4e2a\u5e73\u53f0\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u65b9\u5757\u5854\u51b2\u6d6a\u300b\u4e2d\u8bc6\u522b\u548c\u5229\u7528\u79d8\u5bc6\u6377\u5f84\u4ee5\u83b7\u5f97\u4f18\u52bf\uff1f", "answer": "\u8bc6\u522b\u548c\u5229\u7528\u300a\u65b9\u5757\u5854\u51b2\u6d6a\u300b\u4e2d\u7684\u79d8\u5bc6\u6377\u5f84\u9700\u8981\u654f\u9510\u7684\u89c2\u5bdf\u548c\u63a2\u7d22\u3002\u5bfb\u627e\u7ec6\u5fae\u7684\u89c6\u89c9\u7ebf\u7d22\uff0c\u4f8b\u5982\u7565\u6709\u4e0d\u540c\u7684\u5e73\u53f0\u7eb9\u7406\u6216\u9690\u85cf\u7684\u901a\u9053\u3002\u4f8b\u5982\uff0c\u53d1\u5149\u5fae\u5f31\u7684\u5e73\u53f0\u53ef\u80fd\u610f\u5473\u7740\u6377\u5f84\u3002\u4e00\u65e6\u8bc6\u522b\u51fa\u6765\uff0c\u7cbe\u786e\u5730\u63a7\u5236\u4f60\u7684\u8df3\u8dc3\u65f6\u673a\u4ee5\u8fdb\u5165\u8fd9\u4e9b\u6377\u5f84\u3002\u5229\u7528\u5b83\u4eec\u53ef\u4ee5\u5e2e\u52a9\u4f60\u7ed5\u8fc7\u5177\u6709\u6311\u6218\u6027\u7684\u90e8\u5206\uff0c\u5e76\u66f4\u9ad8\u6548\u5730\u6500\u767b\u5854\u697c\u3002\u65f6\u523b\u5173\u6ce8\u8fd9\u4e9b\u9690\u85cf\u7684\u673a\u4f1a\u4ee5\u83b7\u5f97\u4f18\u52bf\u3002"}, {"question": "\u300a\u65b9\u5757\u5854\u51b2\u6d6a\u300b\u4e2d\u65b9\u5757\u79fb\u52a8\u7684\u673a\u5236\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5982\u4f55\u4f18\u5316\u8fd9\u4e9b\u673a\u5236\u4ee5\u83b7\u5f97\u66f4\u597d\u7684\u6027\u80fd\uff1f", "answer": "\u300a\u65b9\u5757\u5854\u51b2\u6d6a\u300b\u4e2d\u65b9\u5757\u79fb\u52a8\u7684\u673a\u5236\u6d89\u53ca\u57fa\u4e8e\u7269\u7406\u7684\u63a7\u5236\u548c\u5e73\u53f0\u4e92\u52a8\u3002\u65b9\u5757\u7684\u79fb\u52a8\u53d7\u91cd\u529b\u3001\u52a8\u91cf\u548c\u5e73\u53f0\u503e\u659c\u7684\u5f71\u54cd\u3002\u4e3a\u4e86\u4f18\u5316\u6027\u80fd\uff0c\u7ec3\u4e60\u63a7\u5236\u65b9\u5757\u7684\u901f\u5ea6\u548c\u65b9\u5411\u3002\u4f8b\u5982\uff0c\u5728\u4e0b\u964d\u65f6\uff0c\u4f7f\u7528\u8f7b\u89e6\u6765\u51cf\u6162\u901f\u5ea6\u5e76\u4fdd\u6301\u5e73\u8861\u3002\u6b64\u5916\uff0c\u9884\u6d4b\u5e73\u53f0\u79fb\u52a8\u5e76\u76f8\u5e94\u8c03\u6574\u4f60\u7684\u65b9\u5757\u4f4d\u7f6e\u3002\u638c\u63e1\u8fd9\u4e9b\u673a\u5236\u5c06\u589e\u5f3a\u4f60\u7684\u63a7\u5236\u80fd\u529b\u548c\u6574\u4f53\u6e38\u620f\u6027\u80fd\u3002"}]
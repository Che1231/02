[{"question": "\u30ad\u30e5\u30fc\u30d6\u30bf\u30ef\u30fc\u30b5\u30fc\u30d5\u30a1\u30fc\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001\u3069\u306e\u3088\u3046\u306b\u30ad\u30e5\u30fc\u30d6\u3092\u52b9\u679c\u7684\u306b\u5236\u5fa1\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30ad\u30e5\u30fc\u30d6\u30bf\u30ef\u30fc\u30b5\u30fc\u30d5\u30a1\u30fc\u3067\u30ad\u30e5\u30fc\u30d6\u3092\u52b9\u679c\u7684\u306b\u5236\u5fa1\u3059\u308b\u306b\u306f\u3001\u307e\u305a\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u899a\u3048\u308b\u3053\u3068\u304b\u3089\u59cb\u3081\u307e\u3059\u3002\u5de6\u53f3\u306e\u77e2\u5370\u30ad\u30fc\u3092\u4f7f\u3063\u3066\u30ad\u30e5\u30fc\u30d6\u3092\u6c34\u5e73\u65b9\u5411\u306b\u79fb\u52d5\u3055\u305b\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u72ed\u3044\u901a\u8def\u306b\u8fd1\u3065\u304f\u3068\u3001\u77e2\u5370\u30ad\u30fc\u3092\u8efd\u304f\u30bf\u30c3\u30d7\u3057\u3066\u5fae\u8abf\u6574\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u3092\u62bc\u3057\u3066\u30b8\u30e3\u30f3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u7df4\u7fd2\u3057\u3001\u969c\u5bb3\u7269\u3092\u56de\u907f\u3057\u307e\u3059\u3002\u30b9\u30e0\u30fc\u30ba\u3067\u6b63\u78ba\u306a\u52d5\u304d\u304c\u3001\u30bf\u30ef\u30fc\u3092\u6210\u529f\u3057\u3066\u9032\u3080\u305f\u3081\u306e\u9375\u3067\u3059\u3002"}, {"question": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u30ad\u30e5\u30fc\u30d6\u30bf\u30ef\u30fc\u30b5\u30fc\u30d5\u30a1\u30fc\u3067\u9ad8\u5f97\u70b9\u3092\u53d6\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u30ad\u30e5\u30fc\u30d6\u30bf\u30ef\u30fc\u30b5\u30fc\u30d5\u30a1\u30fc\u3067\u30b9\u30b3\u30a2\u3092\u6700\u5927\u9650\u306b\u4e0a\u3052\u308b\u305f\u3081\u306e\u9ad8\u5ea6\u306a\u6226\u7565\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30d0\u30e9\u30f3\u30b9\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u5e38\u306b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u4e2d\u5fc3\u3092\u72d9\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u306a\u3069\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u6d3b\u7528\u3057\u3066\u3001\u8fc5\u901f\u306b\u591a\u304f\u306e\u8ddd\u96e2\u3092\u30ab\u30d0\u30fc\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b8\u30e3\u30f3\u30d7\u3092\u7e4b\u3052\u308b\u6280\u8853\u3092\u30de\u30b9\u30bf\u30fc\u3057\u3066\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u52d5\u304f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u4e0a\u3067\u9023\u7d9a\u30b8\u30e3\u30f3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u3068\u308b\u3053\u3068\u3067\u3001\u5927\u5e45\u306b\u30b9\u30b3\u30a2\u3092\u4e0a\u3052\u308b\u4e8b\u304c\u3067\u304d\u307e\u3059\u3002\u7d99\u7d9a\u7684\u306a\u7df4\u7fd2\u3068\u6b63\u78ba\u306a\u64cd\u4f5c\u304c\u3001\u3088\u308a\u9ad8\u304f\u3001\u3088\u308a\u591a\u304f\u306e\u30b9\u30b3\u30a2\u3092\u5f97\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u306a\u305c\u30ad\u30e5\u30fc\u30d6\u306f\u3001\u3068\u304d\u3069\u304d\u30ad\u30e5\u30fc\u30d6\u30bf\u30ef\u30fc\u30b5\u30fc\u30d5\u30a1\u30fc\u3067\u4e88\u671f\u305b\u305a\u843d\u4e0b\u3059\u308b\u306e\u3067\u3057\u3087\u3046\u304b\u3002\u305d\u3057\u3066\u3001\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u305d\u308c\u3092\u9632\u3050\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30ad\u30e5\u30fc\u30d6\u30bf\u30ef\u30fc\u30b5\u30fc\u30d5\u30a1\u30fc\u3067\u30ad\u30e5\u30fc\u30d6\u304c\u4e88\u671f\u305b\u305a\u843d\u4e0b\u3059\u308b\u4e3b\u306a\u539f\u56e0\u306f\u3001\u30b8\u30e3\u30f3\u30d7\u306e\u8aa4\u5224\u65ad\u3084\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u6025\u6fc0\u306a\u52d5\u304d\u3067\u3059\u3002\u3053\u308c\u3092\u9632\u3050\u305f\u3081\u306b\u306f\u3001\u5e38\u306b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u52d5\u304d\u3092\u4e88\u6e2c\u3057\u3001\u305d\u308c\u306b\u5408\u308f\u305b\u3066\u81ea\u5206\u306e\u4f4d\u7f6e\u3092\u8abf\u6574\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u304c\u50be\u304d\u59cb\u3081\u305f\u3089\u3001\u53cd\u5bfe\u5074\u306b\u30ad\u30e5\u30fc\u30d6\u3092\u79fb\u52d5\u3055\u305b\u3066\u30d0\u30e9\u30f3\u30b9\u3092\u53d6\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u7126\u3089\u305a\u3001\u5404\u52d5\u304d\u3092\u8a08\u753b\u7684\u306b\u884c\u3046\u6642\u9593\u3092\u53d6\u308a\u307e\u3059\u3002\u5fcd\u8010\u3068\u6ce8\u610f\u6df1\u3044\u89b3\u5bdf\u306f\u3001\u843d\u4e0b\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002"}, {"question": "\u30ad\u30e5\u30fc\u30d6\u30bf\u30ef\u30fc\u30b5\u30fc\u30d5\u30a1\u30fc\u3067\u3088\u308a\u9ad8\u3044\u5834\u6240\u3078\u4e0a\u304c\u308b\u305f\u3081\u306b\u3001\u3069\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u304c\u6700\u3082\u52b9\u679c\u7684\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u3069\u306e\u3088\u3046\u306b\u4f7f\u7528\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30ad\u30e5\u30fc\u30d6\u30bf\u30ef\u30fc\u30b5\u30fc\u30d5\u30a1\u30fc\u3067\u3088\u308a\u9ad8\u3044\u5834\u6240\u306b\u767b\u308b\u305f\u3081\u306b\u6700\u3082\u52b9\u679c\u7684\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u3001\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u3068\u30b7\u30fc\u30eb\u30c9\u3067\u3059\u3002\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u306f\u3001\u3088\u308a\u8fc5\u901f\u306b\u5e83\u3044\u7bc4\u56f2\u3092\u79fb\u52d5\u3059\u308b\u3053\u3068\u3092\u53ef\u80fd\u306b\u3057\u3001\u30b7\u30fc\u30eb\u30c9\u306f\u969c\u5bb3\u7269\u304b\u3089\u3042\u306a\u305f\u3092\u5b88\u308a\u307e\u3059\u3002\u5b89\u5b9a\u3057\u305f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u304c\u9023\u7d9a\u3057\u3066\u3044\u308b\u5834\u5408\u306b\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u3092\u4f7f\u7528\u3057\u3001\u8ddd\u96e2\u3092\u6700\u5927\u9650\u306b\u4f38\u3070\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u76f4\u7dda\u4e0a\u306b\u3042\u308b\u8907\u6570\u306e\u30ec\u30d9\u30eb\u3092\u30b9\u30ad\u30c3\u30d7\u3059\u308b\u306e\u306b\u3001\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u3092\u30a2\u30af\u30c6\u30a3\u30d6\u306b\u3059\u308b\u3053\u3068\u306f\u5f79\u7acb\u3061\u307e\u3059\u3002\u30b7\u30fc\u30eb\u30c9\u306f\u3001\u969c\u5bb3\u7269\u304c\u983b\u7e41\u306b\u3042\u308b\u30a8\u30ea\u30a2\u3067\u4f7f\u7528\u3057\u3066\u3001\u5b89\u5168\u306a\u901a\u904e\u3092\u78ba\u4fdd\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u6226\u7565\u7684\u306b\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u767b\u308b\u306e\u52b9\u7387\u306f\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002"}, {"question": "\u30ad\u30e5\u30fc\u30d6\u30bf\u30ef\u30fc\u30b5\u30fc\u30d5\u30a1\u30fc\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u6700\u7d42\u7684\u306a\u30b9\u30b3\u30a2\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u8981\u56e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ad\u30e5\u30fc\u30d6\u30bf\u30ef\u30fc\u30b5\u30fc\u30d5\u30a1\u30fc\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u8981\u56e0\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u6700\u7d42\u7684\u306a\u30b9\u30b3\u30a2\u306f\u3001\u5230\u9054\u3057\u305f\u9ad8\u3055\u3001\u6210\u529f\u3057\u305f\u30b8\u30e3\u30f3\u30d7\u306e\u6570\u3001\u30dc\u30fc\u30ca\u30b9\u30a2\u30a4\u30c6\u30e0\u306e\u53ce\u96c6\u306b\u3088\u3063\u3066\u5f71\u97ff\u3055\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u3088\u308a\u9ad8\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u5230\u9054\u3057\u3001\u5b9d\u77f3\u3092\u96c6\u3081\u308b\u3053\u3068\u3067\u3001\u30b9\u30b3\u30a2\u304c\u52a0\u7b97\u3055\u308c\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u843d\u4e0b\u3059\u308b\u3053\u3068\u306a\u304f\u9023\u7d9a\u3057\u3066\u30b8\u30e3\u30f3\u30d7\u3092\u7e4b\u3052\u308b\u3068\u3001\u8ffd\u52a0\u306e\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3057\u3001\u5404\u8981\u56e0\u3092\u6700\u5927\u9650\u306b\u6d3b\u7528\u3059\u308b\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u6700\u9069\u5316\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30e2\u30d0\u30a4\u30eb\u7248\u3068PC\u7248\u306e\u30ad\u30e5\u30fc\u30d6\u30bf\u30ef\u30fc\u30b5\u30fc\u30d5\u30a1\u30fc\u306b\u306f\u3001\u3069\u306e\u3088\u3046\u306a\u4e3b\u306a\u9055\u3044\u304c\u3042\u308a\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306a\u5f71\u97ff\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30e2\u30d0\u30a4\u30eb\u7248\u3068PC\u7248\u306e\u30ad\u30e5\u30fc\u30d6\u30bf\u30ef\u30fc\u30b5\u30fc\u30d5\u30a1\u30fc\u306e\u4e3b\u306a\u9055\u3044\u306f\u3001\u64cd\u4f5c\u65b9\u6cd5\u3068\u753b\u9762\u30b5\u30a4\u30ba\u3067\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u7248\u3067\u306f\u3001\u30bf\u30c3\u30c1\u64cd\u4f5c\u3067\u79fb\u52d5\u3068\u30b8\u30e3\u30f3\u30d7\u3092\u884c\u3044\u307e\u3059\u3002\u4e00\u65b9\u3001PC\u7248\u3067\u306f\u30ad\u30fc\u30dc\u30fc\u30c9\u5165\u529b\u304c\u6a19\u6e96\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001PC\u7248\u306e\u30ad\u30fc\u30dc\u30fc\u30c9\u64cd\u4f5c\u306f\u3001\u30bf\u30c3\u30c1\u64cd\u4f5c\u3088\u308a\u3082\u6b63\u78ba\u306a\u52d5\u304d\u3092\u53ef\u80fd\u306b\u3059\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u3055\u3089\u306b\u3001PC\u7248\u306e\u5927\u304d\u306a\u753b\u9762\u30b5\u30a4\u30ba\u306b\u3088\u308a\u3001\u30bf\u30ef\u30fc\u5168\u4f53\u306e\u72b6\u6cc1\u3092\u3088\u308a\u826f\u304f\u898b\u308b\u3053\u3068\u304c\u3067\u304d\u3001\u30ca\u30d3\u30b2\u30fc\u30b7\u30e7\u30f3\u304c\u5bb9\u6613\u306b\u306a\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u9055\u3044\u306b\u9069\u5fdc\u3059\u308b\u3053\u3068\u3067\u3001\u305d\u308c\u305e\u308c\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u3088\u308a\u826f\u3044\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30ad\u30e5\u30fc\u30d6\u30bf\u30ef\u30fc\u30b5\u30fc\u30d5\u30a1\u30fc\u3067\u96a0\u3057\u30ec\u30d9\u30eb\u3092\u3069\u306e\u3088\u3046\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u3069\u306e\u3088\u3046\u306a\u6761\u4ef6\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30ad\u30e5\u30fc\u30d6\u30bf\u30ef\u30fc\u30b5\u30fc\u30d5\u30a1\u30fc\u3067\u96a0\u3057\u30ec\u30d9\u30eb\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u306b\u306f\u3001\u7279\u5b9a\u306e\u30b9\u30b3\u30a2\u3092\u9054\u6210\u3059\u308b\u3001\u307e\u305f\u306f\u30ec\u30a2\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u96c6\u3081\u308b\u306a\u3069\u306e\u6761\u4ef6\u3092\u6e80\u305f\u3059\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30e1\u30a4\u30f3\u30b2\u30fc\u30e0\u30671\u4e07\u70b9\u306e\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u3068\u3001\u96a0\u3057\u30ec\u30d9\u30eb\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u4e00\u5ea6\u306e\u30d7\u30ec\u30a4\u3067\u5168\u3066\u306e\u30dc\u30fc\u30ca\u30b9\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u30af\u30ea\u30a2\u3059\u308b\u3053\u3068\u3067\u3082\u3001\u96a0\u3057\u30b3\u30f3\u30c6\u30f3\u30c4\u3078\u306e\u30a2\u30af\u30bb\u30b9\u3092\u5f97\u3089\u308c\u307e\u3059\u3002\u30b2\u30fc\u30e0\u5185\u306e\u30d2\u30f3\u30c8\u306b\u6ce8\u610f\u3092\u6255\u3044\u3001\u3053\u308c\u3089\u306e\u6761\u4ef6\u3092\u6e80\u305f\u3059\u52aa\u529b\u3092\u7d9a\u3051\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u306e\u96a0\u3057\u30ec\u30d9\u30eb\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30ad\u30e5\u30fc\u30d6\u30bf\u30ef\u30fc\u30b5\u30fc\u30d5\u30a1\u30fc\u3067\u3001\u30e2\u30d0\u30a4\u30eb\u304b\u3089PC\u306b\u30b2\u30fc\u30e0\u3092\u79fb\u884c\u3057\u3001\u9032\u6357\u72b6\u6cc1\u3092\u5931\u3046\u3053\u3068\u306a\u304f\u3001\u3069\u306e\u3088\u3046\u306b\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30ad\u30e5\u30fc\u30d6\u30bf\u30ef\u30fc\u30b5\u30fc\u30d5\u30a1\u30fc\u3067\u3001\u30e2\u30d0\u30a4\u30eb\u304b\u3089PC\u306b\u30b2\u30fc\u30e0\u3092\u79fb\u884c\u3057\u3001\u9032\u6357\u72b6\u6cc1\u3092\u5931\u3046\u3053\u3068\u306a\u304f\u3059\u308b\u306b\u306f\u3001\u4e21\u65b9\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30e2\u30d0\u30a4\u30eb\u3067Google Play\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u4f7f\u3063\u3066\u3044\u308b\u5834\u5408\u306f\u3001PC\u7248\u3067\u3082\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u3067\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u5b9a\u671f\u7684\u306b\u30b2\u30fc\u30e0\u30c7\u30fc\u30bf\u3092\u30af\u30e9\u30a6\u30c9\u306b\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u3057\u3066\u3001\u9032\u6357\u3092\u4fdd\u5b58\u3057\u307e\u3059\u3002\u3053\u306e\u30b7\u30fc\u30e0\u30ec\u30b9\u306a\u79fb\u884c\u306b\u3088\u308a\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u95a2\u308f\u3089\u305a\u3001\u4e2d\u65ad\u3057\u305f\u3068\u3053\u308d\u304b\u3089\u30b2\u30fc\u30e0\u3092\u7d9a\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30ad\u30e5\u30fc\u30d6\u30bf\u30ef\u30fc\u30b5\u30fc\u30d5\u30a1\u30fc\u3067\u3001\u6709\u5229\u3092\u5f97\u308b\u305f\u3081\u306e\u79d8\u5bc6\u306e\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u3092\u7279\u5b9a\u3057\u3001\u6d3b\u7528\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30ad\u30e5\u30fc\u30d6\u30bf\u30ef\u30fc\u30b5\u30fc\u30d5\u30a1\u30fc\u3067\u79d8\u5bc6\u306e\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u3092\u7279\u5b9a\u3057\u3001\u6d3b\u7528\u3059\u308b\u306b\u306f\u3001\u92ed\u3044\u89b3\u5bdf\u529b\u3068\u63a2\u7d22\u304c\u5fc5\u8981\u3067\u3059\u3002\u5fae\u5999\u306a\u8996\u899a\u7684\u306a\u624b\u304c\u304b\u308a\u3001\u4f8b\u3048\u3070\u3001\u308f\u305a\u304b\u306b\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u30c6\u30af\u30b9\u30c1\u30e3\u3001\u307e\u305f\u306f\u96a0\u308c\u305f\u901a\u8def\u3092\u63a2\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u304b\u3059\u304b\u306a\u5149\u3092\u653e\u3063\u3066\u3044\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306f\u3001\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u3092\u793a\u3057\u3066\u3044\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u4e00\u5ea6\u7279\u5b9a\u3057\u305f\u3089\u3001\u6b63\u78ba\u306a\u30b8\u30e3\u30f3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u56f3\u3063\u3066\u3001\u3053\u308c\u3089\u306e\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u306b\u30a2\u30af\u30bb\u30b9\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u3092\u5229\u7528\u3059\u308b\u3053\u3068\u306b\u3088\u308a\u3001\u6311\u6226\u7684\u306a\u30bb\u30af\u30b7\u30e7\u30f3\u3092\u30b9\u30ad\u30c3\u30d7\u3057\u3001\u30bf\u30ef\u30fc\u3092\u3088\u308a\u52b9\u7387\u7684\u306b\u767b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u5e38\u306b\u3053\u308c\u3089\u306e\u96a0\u3055\u308c\u305f\u6a5f\u4f1a\u3092\u63a2\u3057\u3066\u3001\u6709\u5229\u3092\u5f97\u308b\u3088\u3046\u306b\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u30ad\u30e5\u30fc\u30d6\u30bf\u30ef\u30fc\u30b5\u30fc\u30d5\u30a1\u30fc\u3067\u30ad\u30e5\u30fc\u30d6\u306e\u52d5\u304d\u306b\u95a2\u3059\u308b\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u306b\u3001\u305d\u308c\u3089\u3092\u3069\u306e\u3088\u3046\u306b\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30ad\u30e5\u30fc\u30d6\u30bf\u30ef\u30fc\u30b5\u30fc\u30d5\u30a1\u30fc\u3067\u30ad\u30e5\u30fc\u30d6\u306e\u52d5\u304d\u306b\u95a2\u3059\u308b\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u7269\u7406\u30d9\u30fc\u30b9\u306e\u64cd\u4f5c\u3068\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3068\u306e\u76f8\u4e92\u4f5c\u7528\u3092\u542b\u307f\u307e\u3059\u3002\u30ad\u30e5\u30fc\u30d6\u306e\u52d5\u304d\u306f\u3001\u91cd\u529b\u3001\u6163\u6027\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u50be\u304d\u306b\u5f71\u97ff\u3055\u308c\u307e\u3059\u3002\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u30ad\u30e5\u30fc\u30d6\u306e\u901f\u5ea6\u3068\u65b9\u5411\u3092\u5236\u5fa1\u3059\u308b\u65b9\u6cd5\u3092\u7df4\u7fd2\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u4e0b\u964d\u3057\u3066\u3044\u308b\u6642\u306b\u8efd\u304f\u30bf\u30c3\u30d7\u3057\u3066\u30b9\u30d4\u30fc\u30c9\u3092\u843d\u3068\u3059\u3053\u3068\u3067\u30d0\u30e9\u30f3\u30b9\u3092\u7dad\u6301\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u52d5\u304d\u3092\u4e88\u6e2c\u3057\u3001\u30ad\u30e5\u30fc\u30d6\u306e\u4f4d\u7f6e\u3092\u305d\u308c\u306b\u5fdc\u3058\u3066\u8abf\u6574\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u3067\u3001\u64cd\u4f5c\u6027\u3068\u30b2\u30fc\u30e0\u5168\u4f53\u306e\u6027\u80fd\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002"}]
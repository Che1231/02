[{"question": "\u521d\u5b66\u8005\u5982\u4f55\u63d0\u9ad8\u5728\u8d85\u7ea7\u516d\u8fb9\u5f62\u6e38\u620f\u4e2d\u7684\u53cd\u5e94\u65f6\u95f4\uff1f", "answer": "\u4e3a\u4e86\u63d0\u9ad8\u5728\u8d85\u7ea7\u516d\u8fb9\u5f62\u6e38\u620f\u4e2d\u7684\u53cd\u5e94\u65f6\u95f4\uff0c\u9996\u5148\u8981\u4e13\u6ce8\u4e8e\u56fe\u6848\u51fa\u73b0\u7684\u5c4f\u5e55\u4e2d\u5fc3\u3002\u7ec3\u4e60\u5c3d\u65e9\u8bc6\u522b\u5f62\u72b6\uff0c\u8fd9\u53ef\u4ee5\u7559\u51fa\u66f4\u591a\u53cd\u5e94\u65f6\u95f4\u3002\u4f8b\u5982\uff0c\u5f53\u5899\u4f53\u903c\u8fd1\u65f6\uff0c\u5feb\u901f\u8bc6\u522b\u5b89\u5168\u8def\u5f84\u5e76\u76f8\u5e94\u79fb\u52a8\u3002\u6b65\u9aa41\uff1a\u4fdd\u6301\u773c\u775b\u56fa\u5b9a\u5728\u4e2d\u5fc3\u3002\u6b65\u9aa42\uff1a\u9884\u6d4b\u6a21\u5f0f\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u5feb\u901f\u3001\u7cbe\u786e\u7684\u52a8\u4f5c\u6765\u5bfc\u822a\u3002\u4e00\u4e2a\u6709\u7528\u7684\u7c7b\u6bd4\u662f\u5c06\u5176\u60f3\u8c61\u6210\u5f00\u8f66\u2014\u2014\u9884\u6d4b\u524d\u65b9\u8def\u51b5\u624d\u80fd\u5e73\u7a33\u9a7e\u9a76\u3002"}, {"question": "\u8d85\u7ea7\u516d\u8fb9\u5f62\u4e0d\u540c\u96be\u5ea6\u7b49\u7ea7\u4e4b\u95f4\u7684\u4e3b\u8981\u533a\u522b\u662f\u4ec0\u4e48\uff1f", "answer": "\u8d85\u7ea7\u516d\u8fb9\u5f62\u8bbe\u6709\u516d\u4e2a\u96be\u5ea6\u7b49\u7ea7\uff0c\u6bcf\u4e2a\u96be\u5ea6\u7b49\u7ea7\u7684\u901f\u5ea6\u548c\u590d\u6742\u7a0b\u5ea6\u90fd\u5728\u589e\u52a0\u3002\u4f8b\u5982\uff0c\"\u516d\u8fb9\u5f62\"\u662f\u6700\u7b80\u5355\u7684\uff0c\u5899\u4f53\u79fb\u52a8\u901f\u5ea6\u8f83\u6162\uff0c\u800c\"\u8d85\u7ea7\u516d\u8fb9\u5f62\"\u662f\u6700\u96be\u7684\uff0c\u7279\u5f81\u662f\u901f\u5ea6\u66f4\u5feb\u4e14\u6a21\u5f0f\u66f4\u4e0d\u53ef\u9884\u6d4b\u3002\u4e00\u4e2a\u6bd4\u8f83\u8868\u6709\u52a9\u4e8e\u8bf4\u660e\u8fd9\u4e9b\u5dee\u5f02\uff1a\n| \u96be\u5ea6\u7b49\u7ea7 | \u901f\u5ea6 | \u6a21\u5f0f\u590d\u6742\u5ea6 |\n|---|---|---|\n| \u516d\u8fb9\u5f62 | \u4f4e | \u7b80\u5355 |\n| \u8d85\u7ea7\u516d\u8fb9\u5f62 | \u9ad8 | \u975e\u5e38\u590d\u6742 |\n\u4e86\u89e3\u8fd9\u4e9b\u533a\u522b\u6709\u52a9\u4e8e\u73a9\u5bb6\u8bbe\u5b9a\u73b0\u5b9e\u7684\u76ee\u6807\u5e76\u6709\u6548\u5730\u53d6\u5f97\u8fdb\u6b65\u3002"}, {"question": "\u5728PC\u4e0a\u73a9\u8d85\u7ea7\u516d\u8fb9\u5f62\u6e38\u620f\uff0c\u54ea\u79cd\u63a7\u5236\u65b9\u6848\u6700\u597d\uff1f", "answer": "\u5bf9\u4e8ePC\u73a9\u5bb6\u6765\u8bf4\uff0c\u4f7f\u7528\u952e\u76d8\u901a\u5e38\u662f\u6700\u7cbe\u786e\u7684\u63a7\u5236\u65b9\u6848\u3002\u65b9\u5411\u952e\u53ef\u4ee5\u5b9e\u73b0\u5feb\u901f\u3001\u7cbe\u786e\u7684\u79fb\u52a8\uff0c\u8fd9\u5bf9\u5728\u8d85\u7ea7\u516d\u8fb9\u5f62\u6e38\u620f\u5feb\u901f\u53d8\u5316\u7684\u6a21\u5f0f\u4e2d\u5bfc\u822a\u81f3\u5173\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u5de6\u53f3\u65b9\u5411\u952e\u8eb2\u907f\u5899\u4f53\u611f\u89c9\u76f4\u89c2\u4e14\u54cd\u5e94\u8fc5\u901f\u3002\u6216\u8005\uff0c\u4e00\u4e9b\u73a9\u5bb6\u66f4\u559c\u6b22\u6e38\u620f\u624b\u67c4\uff0c\u4ee5\u83b7\u5f97\u66f4\u8f7b\u677e\u7684\u63e1\u6301\u611f\uff0c\u4f46\u5b83\u53ef\u80fd\u7f3a\u4e4f\u952e\u76d8\u7684\u7cbe\u786e\u5ea6\u3002\u6d41\u7a0b\u56fe\u53ef\u4ee5\u5e2e\u52a9\u51b3\u5b9a\uff1a\n1. \u9009\u62e9\u952e\u76d8 \u2192 \u9ad8\u7cbe\u5ea6\u3002\n2. \u9009\u62e9\u6e38\u620f\u624b\u67c4 \u2192 \u8212\u9002\u7684\u63e1\u6301\u611f\u3002"}, {"question": "\u9ad8\u7ea7\u73a9\u5bb6\u5982\u4f55\u4f18\u5316\u4ed6\u4eec\u7684\u7b56\u7565\uff0c\u5728\u8d85\u7ea7\u516d\u8fb9\u5f62\u6e38\u620f\u4e2d\u53d6\u5f97\u66f4\u957f\u65f6\u95f4\u7684\u8fd0\u884c\uff1f", "answer": "\u9ad8\u7ea7\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u638c\u63e1\u6a21\u5f0f\u8bc6\u522b\u5e76\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u4e0d\u5fc5\u8981\u7684\u52a8\u4f5c\u6765\u4f18\u5316\u4ed6\u4eec\u7684\u7b56\u7565\u3002\u6b65\u9aa41\uff1a\u4e13\u6ce8\u4e8e\u4e2d\u5fc3\u4ee5\u9884\u6d4b\u5373\u5c06\u5230\u6765\u7684\u5899\u4f53\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u6d41\u7545\u3001\u8fde\u7eed\u7684\u52a8\u4f5c\uff0c\u800c\u4e0d\u662f\u7a81\u7136\u7684\u52a8\u4f5c\u3002\u6b65\u9aa43\uff1a\u8bb0\u4f4f\u91cd\u590d\u51fa\u73b0\u7684\u6a21\u5f0f\u4ee5\u66f4\u5feb\u5730\u505a\u51fa\u53cd\u5e94\u3002\u4f8b\u5982\uff0c\u5728\"\u8d85\u7ea7\u516d\u8fb9\u5f62\"\u4e2d\uff0c\u67d0\u4e9b\u5899\u4f53\u5e8f\u5217\u4f1a\u91cd\u590d\uff0c\u8bc6\u522b\u5b83\u4eec\u53ef\u4ee5\u8282\u7701\u6781\u5176\u5b9d\u8d35\u7684\u65f6\u95f4\u3002\u4e00\u4e2a\u6709\u7528\u7684\u6bd4\u8f83\u662f\u5c06\u5176\u60f3\u8c61\u6210\u8df3\u821e\u2014\u2014\u77e5\u9053\u6b65\u9aa4\u624d\u80fd\u6d41\u7545\u5730\u79fb\u52a8\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u8d85\u7ea7\u516d\u8fb9\u5f62\u611f\u89c9\u5982\u6b64\u4e4b\u5feb\uff0c\u73a9\u5bb6\u5982\u4f55\u9002\u5e94\u5176\u901f\u5ea6\uff1f", "answer": "\u8d85\u7ea7\u516d\u8fb9\u5f62\u611f\u89c9\u5feb\u901f\u662f\u56e0\u4e3a\u5176\u4e0d\u65ad\u589e\u52a0\u7684\u901f\u5ea6\u548c\u6781\u7b80\u8bbe\u8ba1\uff0c\u6d88\u9664\u4e86\u5e72\u6270\u3002\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u8fdb\u884c\u66f4\u77ed\u65f6\u95f4\u7684\u7ec3\u4e60\u6765\u5efa\u7acb\u808c\u8089\u8bb0\u5fc6\u6765\u9002\u5e94\u3002\u4f8b\u5982\uff0c\u4ece\"\u516d\u8fb9\u5f62\"\u7b49\u7ea7\u5f00\u59cb\uff0c\u4ee5\u4fbf\u5728\u79fb\u52a8\u5230\u66f4\u5feb\u7684\u7b49\u7ea7\u4e4b\u524d\u9002\u5e94\u57fa\u672c\u673a\u5236\u3002\u6b65\u9aa41\uff1a\u4ece\u8f83\u6162\u7684\u7b49\u7ea7\u5f00\u59cb\u3002\u6b65\u9aa42\uff1a\u9010\u6e10\u589e\u52a0\u96be\u5ea6\u3002\u6b65\u9aa43\uff1a\u5728\u521d\u59cb\u9636\u6bb5\u4e13\u6ce8\u4e8e\u7a33\u5b9a\u6027\uff0c\u800c\u4e0d\u662f\u957f\u65f6\u95f4\u8fd0\u884c\u3002\u4e00\u4e2a\u6bd4\u55bb\u662f\u5c06\u5176\u60f3\u8c61\u6210\u5b66\u4e60\u9a91\u81ea\u884c\u8f66\u2014\u2014\u4ece\u6162\u901f\u5f00\u59cb\u5efa\u7acb\u4fe1\u5fc3\u3002"}, {"question": "\u8d85\u7ea7\u516d\u8fb9\u5f62\u4e2d\u989c\u8272\u53d8\u5316\u7684\u610f\u4e49\u662f\u4ec0\u4e48\uff1f", "answer": "\u8d85\u7ea7\u516d\u8fb9\u5f62\u4e2d\u7684\u989c\u8272\u53d8\u5316\u65e2\u6709\u5ba1\u7f8e\u610f\u4e49\uff0c\u4e5f\u6709\u529f\u80fd\u610f\u4e49\u3002\u5b83\u4eec\u6307\u793a\u4e86\u96be\u5ea6\u7b49\u7ea7\u4e4b\u95f4\u7684\u8f6c\u53d8\uff0c\u5e76\u5e2e\u52a9\u73a9\u5bb6\u4fdd\u6301\u89c6\u89c9\u53c2\u4e0e\u3002\u4f8b\u5982\uff0c\u5f53\u4ece\"\u516d\u8fb9\u5f62\"\u79fb\u52a8\u5230\"\u516d\u8fb9\u5f62\u8005\"\u65f6\uff0c\u80cc\u666f\u989c\u8272\u4ece\u84dd\u8272\u53d8\u4e3a\u7ea2\u8272\uff0c\u8fd9\u9884\u793a\u7740\u96be\u5ea6\u589e\u52a0\u3002\u56fe\u8868\u53ef\u4ee5\u8bf4\u660e\u8fd9\u4e00\u70b9\uff1a\n\u516d\u8fb9\u5f62 \u2192 \u84dd\u8272 \u2192 \u7b80\u5355\u3002\n\u516d\u8fb9\u5f62\u8005 \u2192 \u7ea2\u8272 \u2192 \u4e2d\u7b49\u3002\u8fd9\u79cd\u89c6\u89c9\u63d0\u793a\u6709\u52a9\u4e8e\u73a9\u5bb6\u4e3a\u5373\u5c06\u5230\u6765\u7684\u6311\u6218\u505a\u597d\u5fc3\u7406\u51c6\u5907\u3002"}, {"question": "\u8d85\u7ea7\u516d\u8fb9\u5f62\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u5de5\u4f5c\u7684\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u6700\u7ec8\u5f97\u5206\uff1f", "answer": "\u8d85\u7ea7\u516d\u8fb9\u5f62\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u751f\u5b58\u65f6\u95f4\u3002\u751f\u5b58\u65f6\u95f4\u8d8a\u957f\uff0c\u5f97\u5206\u8d8a\u9ad8\u3002\u6b64\u5916\uff0c\u6bcf\u4e2a\u96be\u5ea6\u7b49\u7ea7\u90fd\u5177\u6709\u4e00\u5f71\u54cd\u6700\u7ec8\u5f97\u5206\u7684\u500d\u589e\u5668\u3002\u4f8b\u5982\uff0c\u5728\"\u8d85\u7ea7\u516d\u8fb9\u5f62\"\u4e2d\u751f\u5b5860\u79d2\u7684\u5f97\u5206\u8981\u9ad8\u4e8e\u5728\"\u516d\u8fb9\u5f62\"\u4e2d\u76f8\u540c\u7684\u751f\u5b58\u65f6\u95f4\u3002\u4e00\u4e2a\u6bd4\u8f83\u8868\u53ef\u4ee5\u9610\u660e\u8fd9\u4e00\u70b9\uff1a\n| \u96be\u5ea6\u7b49\u7ea7 | \u751f\u5b58\u65f6\u95f4 | \u5f97\u5206\u500d\u589e\u5668 |\n|---|---|---|\n| \u516d\u8fb9\u5f62 | 60\u79d2 | 1\u500d |\n| \u8d85\u7ea7\u516d\u8fb9\u5f62 | 60\u79d2 | 3\u500d |\n\u4e86\u89e3\u8fd9\u4e00\u70b9\u53ef\u4ee5\u5e2e\u52a9\u73a9\u5bb6\u5236\u5b9a\u4ed6\u4eec\u7684\u8fd0\u884c\u7b56\u7565\u3002"}, {"question": "\u8d85\u7ea7\u516d\u8fb9\u5f62\u7684\u8fdb\u5ea6\u53ef\u4ee5\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u5417\uff1f", "answer": "\u76ee\u524d\uff0c\u8d85\u7ea7\u516d\u8fb9\u5f62\u4e0d\u652f\u6301\u8de8\u5e73\u53f0\u8fdb\u5ea6\u8f6c\u79fb\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728PC\u4e0a\u73a9\uff0c\u7136\u540e\u5207\u6362\u5230\u79fb\u52a8\u8bbe\u5907\uff0c\u60a8\u9700\u8981\u91cd\u65b0\u5f00\u59cb\u3002\u4f46\u662f\uff0c\u50cfSteam\u8fd9\u6837\u7684\u5e73\u53f0\u5141\u8bb8\u5bf9\u5355\u4e2a\u8bbe\u5907\u8fdb\u884c\u4e91\u4fdd\u5b58\u3002\u6d41\u7a0b\u56fe\u53ef\u4ee5\u5e2e\u52a9\u6f84\u6e05\uff1a\n1. \u5728PC\u4e0a\u73a9 \u2192 Steam\u4e91\u4fdd\u5b58\u3002\n2. \u5207\u6362\u5230\u79fb\u52a8\u8bbe\u5907 \u2192 \u91cd\u65b0\u5f00\u59cb\u3002\u8fd9\u79cd\u9650\u5236\u610f\u5473\u7740\u73a9\u5bb6\u5e94\u8be5\u4ed4\u7ec6\u9009\u62e9\u9996\u9009\u5e73\u53f0\u3002"}, {"question": "\u8d85\u7ea7\u516d\u8fb9\u5f62\u4e2d\u5b58\u5728\u54ea\u4e9b\u9690\u85cf\u673a\u5236\u6216\u5f69\u86cb\uff1f", "answer": "\u8d85\u7ea7\u516d\u8fb9\u5f62\u5305\u542b\u4e00\u4e9b\u7ec6\u5fae\u7684\u673a\u5236\u548c\u5f69\u86cb\uff0c\u4e3a\u6e38\u620f\u589e\u6dfb\u4e86\u6df1\u5ea6\u3002\u4f8b\u5982\uff0c\u6e38\u620f\u7684\u97f3\u8f68\u4f1a\u6839\u636e\u60a8\u7684\u8868\u73b0\u800c\u52a8\u6001\u6539\u53d8\uff0c\u4ece\u800c\u521b\u9020\u51fa\u66f4\u8eab\u4e34\u5176\u5883\u7684\u4f53\u9a8c\u3002\u6b64\u5916\uff0c\"\u8d85\u7ea7\u516d\u8fb9\u5f62\"\u4e2d\u67d0\u4e9b\u6a21\u5f0f\u7684\u8bbe\u8ba1\u51e0\u4e4e\u4e0d\u53ef\u80fd\u5b9e\u73b0\uff0c\u8fd9\u4e3a\u6700\u6709\u70ed\u60c5\u7684\u73a9\u5bb6\u63d0\u4f9b\u4e86\u6311\u6218\u3002\u4e00\u4e2a\u6bd4\u55bb\u662f\u5c06\u8fd9\u4e9b\u60f3\u8c61\u6210\u9690\u85cf\u7684\u5b9d\u85cf\u2014\u2014\u53d1\u73b0\u5b83\u4eec\u4f1a\u589e\u52a0\u6e38\u620f\u7684\u9b45\u529b\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u514b\u670d\u5728\u8d85\u7ea7\u516d\u8fb9\u5f62\u4e2d\u53cd\u590d\u5931\u8d25\u5e26\u6765\u7684\u632b\u8d25\u611f\uff1f", "answer": "\u5728\u8d85\u7ea7\u516d\u8fb9\u5f62\u4e2d\u53cd\u590d\u5931\u8d25\u53ef\u80fd\u4f1a\u4ee4\u4eba\u6cae\u4e27\uff0c\u4f46\u4e13\u6ce8\u4e8e\u5faa\u5e8f\u6e10\u8fdb\u7684\u8fdb\u6b65\u6709\u6240\u5e2e\u52a9\u3002\u6b65\u9aa41\uff1a\u8bbe\u5b9a\u5c0f\u76ee\u6807\uff0c\u4f8b\u5982\u6bd4\u4e0a\u6b21\u6700\u597d\u6210\u7ee9\u591a\u751f\u5b5810\u79d2\u3002\u6b65\u9aa42\uff1a\u5206\u6790\u6bcf\u6b21\u8fd0\u884c\u4e2d\u51fa\u73b0\u7684\u95ee\u9898\u2014\u2014\u662f\u7279\u5b9a\u6a21\u5f0f\u8fd8\u662f\u53cd\u5e94\u65f6\u95f4\uff1f\u6b65\u9aa43\uff1a\u4f11\u606f\u4e00\u4e0b\uff0c\u907f\u514d\u7cbe\u75b2\u529b\u5c3d\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u572820\u79d2\u5904\u4e0d\u65ad\u5931\u8d25\uff0c\u8bf7\u7ec3\u4e60\u8be5\u7279\u5b9a\u90e8\u5206\u3002\u4e00\u4e2a\u6709\u7528\u7684\u7c7b\u6bd4\u662f\u5c06\u5176\u60f3\u8c61\u6210\u6500\u767b\u4e00\u5ea7\u5c71\u2014\u2014\u6bcf\u4e00\u6b65\u90fd\u4f7f\u60a8\u66f4\u63a5\u8fd1\u5c71\u9876\u3002"}]
[{"question": "\ucd08\ubcf4\uc790\uac00 Super Hexagon\uc5d0\uc11c \ubc18\uc751 \uc2dc\uac04\uc744 \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\ub098\uc694?", "answer": "Super Hexagon\uc5d0\uc11c \ubc18\uc751 \uc2dc\uac04\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub824\uba74 \ud328\ud134\uc774 \ub098\ud0c0\ub098\ub294 \ud654\uba74 \uc911\uc559\uc5d0 \uc9d1\uc911\ud558\ub294 \uac83\ubd80\ud130 \uc2dc\uc791\ud558\uc138\uc694. \ubaa8\uc591\uc744 \uc77c\ucc0d \uc778\uc2dd\ud558\ub294 \uc5f0\uc2b5\uc744 \ud558\uba74 \ubc18\uc751\ud560 \uc2dc\uac04\uc774 \ub354 \ub9ce\uc544\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubcbd\uc774 \ub2e4\uac00\uc62c \ub54c \uc548\uc804\ud55c \uacbd\ub85c\ub97c \ube60\ub974\uac8c \uc2dd\ubcc4\ud558\uace0 \uadf8\uc5d0 \ub530\ub77c \uc6c0\uc9c1\uc774\uc138\uc694. 1\ub2e8\uacc4: \uc2dc\uc120\uc744 \uc911\uc559\uc5d0 \uace0\uc815\ud558\uc138\uc694. 2\ub2e8\uacc4: \ud328\ud134\uc744 \uc608\uce21\ud558\uc138\uc694. 3\ub2e8\uacc4: \ube60\ub974\uace0 \uc815\ud655\ud55c \uc6c0\uc9c1\uc784\uc73c\ub85c \ud0d0\uc0c9\ud558\uc138\uc694. \ub3c4\uc6c0\uc774 \ub418\ub294 \ube44\uc720\ub294 \uc6b4\uc804\uc774\ub77c\uace0 \uc0dd\uac01\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \ubd80\ub4dc\ub7fd\uac8c \uc870\uc885\ud558\ub824\uba74 \uc55e\uc744 \ub0b4\ub2e4\ubcf4\uc138\uc694."}, {"question": "Super Hexagon\uc758 \ub09c\uc774\ub3c4 \uc218\uc900 \uac04\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Super Hexagon\uc740 \uc18d\ub3c4\uc640 \ubcf5\uc7a1\uc131\uc774 \uc99d\uac00\ud558\ub294 6\uac00\uc9c0 \ub09c\uc774\ub3c4 \uc218\uc900\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 'Hexagon'\uc740 \ubcbd \uc6c0\uc9c1\uc784\uc774 \ub290\ub9b0 \uac00\uc7a5 \uc26c\uc6b4 \ub09c\uc774\ub3c4\uc774\uace0, 'Hyper Hexagonest'\ub294 \ub354 \ube60\ub974\uace0 \uc608\uce21\ud560 \uc218 \uc5c6\ub294 \ud328\ud134\uc774 \ud2b9\uc9d5\uc778 \uac00\uc7a5 \uc5b4\ub824\uc6b4 \ub09c\uc774\ub3c4\uc785\ub2c8\ub2e4. \ube44\uad50 \ud45c\ub294 \ucc28\uc774\uc810\uc744 \uc124\uba85\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \n| \ub09c\uc774\ub3c4 | \uc18d\ub3c4 | \ud328\ud134 \ubcf5\uc7a1\uc131 |\n|---|---|---|\n| Hexagon | \ub0ae\uc74c | \ub2e8\uc21c\ud568 |\n| Hyper Hexagonest | \ub192\uc74c | \ub9e4\uc6b0 \ubcf5\uc7a1\ud568 |\n \uc774\ub7ec\ud55c \ucc28\uc774\uc810\uc744 \uc774\ud574\ud558\uba74 \ud50c\ub808\uc774\uc5b4\uac00 \ud604\uc2e4\uc801\uc778 \ubaa9\ud45c\ub97c \uc124\uc815\ud558\uace0 \ud6a8\uacfc\uc801\uc73c\ub85c \uc9c4\ud589\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "PC\uc5d0\uc11c Super Hexagon\uc744 \ud50c\ub808\uc774\ud558\ub294 \ub370 \uac00\uc7a5 \uc801\ud569\ud55c \ucee8\ud2b8\ub864 \ubc29\uc2dd\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "PC \ud50c\ub808\uc774\uc5b4\uc758 \uacbd\uc6b0 \uc77c\ubc18\uc801\uc73c\ub85c \ud0a4\ubcf4\ub4dc\ub97c \uc0ac\uc6a9\ud558\ub294 \uac83\uc774 \uac00\uc7a5 \uc815\ud655\ud55c \ucee8\ud2b8\ub864 \ubc29\uc2dd\uc785\ub2c8\ub2e4. \ud654\uc0b4\ud45c \ud0a4\ub97c \uc0ac\uc6a9\ud558\uba74 \ube60\ub974\uace0 \uc815\ud655\ud55c \uc6c0\uc9c1\uc784\uc774 \uac00\ub2a5\ud558\uba70, \uc774\ub294 Super Hexagon\uc758 \ube60\ub974\uac8c \uc9c4\ud589\ub418\ub294 \ud328\ud134\uc744 \ud0d0\uc0c9\ud558\ub294 \ub370 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc67c\ucabd \ubc0f \uc624\ub978\ucabd \ud654\uc0b4\ud45c \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \ubcbd\uc744 \ud53c\ud558\ub294 \uac83\uc774 \uc9c1\uad00\uc801\uc774\uace0 \ubc18\uc751\uc131\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \ub610\ub294 \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\ub294 \ub354 \ud3b8\uc548\ud55c \uadf8\ub9bd\uac10\uc744 \uc704\ud574 \uac8c\uc784\ud328\ub4dc\ub97c \uc120\ud638\ud558\uc9c0\ub9cc \ud0a4\ubcf4\ub4dc\ub9cc\ud07c \uc815\ud655\ud558\uc9c0 \uc54a\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc21c\uc11c\ub3c4\ub294 \uacb0\uc815\uc744 \ub0b4\ub9ac\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \n1. \ud0a4\ubcf4\ub4dc \uc120\ud0dd \u2192 \ub192\uc740 \uc815\ud655\ub3c4. \n2. \uac8c\uc784\ud328\ub4dc \uc120\ud0dd \u2192 \ud3b8\uc548\ud55c \uadf8\ub9bd\uac10."}, {"question": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 Super Hexagon\uc5d0\uc11c \ub354 \uc624\ub798 \uc2e4\ud589\ud558\uae30 \uc704\ud574 \uc804\ub7b5\uc744 \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \ud328\ud134 \uc778\uc2dd\uc744 \ub9c8\uc2a4\ud130\ud558\uace0 \ubd88\ud544\uc694\ud55c \uc6c0\uc9c1\uc784\uc744 \ucd5c\uc18c\ud654\ud558\uc5ec \uc804\ub7b5\uc744 \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 1\ub2e8\uacc4: \ub4e4\uc5b4\uc624\ub294 \ubcbd\uc744 \uc608\uce21\ud558\ub824\uba74 \uc911\uc559\uc5d0 \uc9d1\uc911\ud558\uc138\uc694. 2\ub2e8\uacc4: \uacbd\ub828\uc801\uc778 \uc6c0\uc9c1\uc784\ubcf4\ub2e4\ub294 \ubd80\ub4dc\ub7fd\uace0 \uc9c0\uc18d\uc801\uc778 \uc6c0\uc9c1\uc784\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. 3\ub2e8\uacc4: \ubc18\ubcf5\ub418\ub294 \ud328\ud134\uc744 \uc554\uae30\ud558\uc5ec \ub354 \ube60\ub974\uac8c \ubc18\uc751\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4 'Hyper Hexagon'\uc5d0\uc11c\ub294 \ud2b9\uc815 \ubcbd \uc2dc\ud000\uc2a4\uac00 \ubc18\ubcf5\ub418\uba70 \uc774\ub97c \uc778\uc2dd\ud558\uba74 \uc911\uc694\ud55c \ubc00\ub9ac\ucd08\ub97c \uc808\uc57d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub3c4\uc6c0\uc774 \ub418\ub294 \ube44\uad50\ub294 \ucda4\uc774\ub77c\uace0 \uc0dd\uac01\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc720\uc5f0\ud558\uac8c \uc6c0\uc9c1\uc774\ub824\uba74 \ub2e8\uacc4\ub97c \uc54c\uc544\uc57c \ud569\ub2c8\ub2e4."}, {"question": "Super Hexagon\uc774 \uc65c \uadf8\ub807\uac8c \ube60\ub974\uac8c \ub290\uaef4\uc9c0\ub098\uc694? \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \uc18d\ub3c4\uc5d0 \uc801\uc751\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Super Hexagon\uc740 \uc18d\ub3c4 \uc99d\uac00\uc640 \uc8fc\uc758\ub97c \uc0b0\ub9cc\ud558\uac8c \ud558\ub294 \uc694\uc18c\ub97c \uc81c\uac70\ud558\ub294 \ubbf8\ub2c8\uba40\ud55c \ub514\uc790\uc778\uc73c\ub85c \uc778\ud574 \ube60\ub974\uac8c \ub290\uaef4\uc9d1\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\ub294 \uadfc\uc721 \uae30\uc5b5\uc744 \uad6c\ucd95\ud558\uae30 \uc704\ud574 \uc9e7\uc740 \uc2dc\uac04 \ub3d9\uc548 \uc5f0\uc2b5\ud558\uc5ec \uc801\uc751\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 \ub354 \ube60\ub978 \ub808\ubca8\ub85c \uc774\ub3d9\ud558\uae30 \uc804\uc5d0 'Hexagon' \ub808\ubca8\ubd80\ud130 \uc2dc\uc791\ud558\uc5ec \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc5d0 \uc775\uc219\ud574\uc9c0\uc138\uc694. 1\ub2e8\uacc4: \ub354 \ub290\ub9b0 \ub808\ubca8\ubd80\ud130 \uc2dc\uc791\ud558\uc138\uc694. 2\ub2e8\uacc4: \uc810\ucc28\uc801\uc73c\ub85c \ub09c\uc774\ub3c4\ub97c \ub192\uc774\uc138\uc694. 3\ub2e8\uacc4: \ucc98\uc74c\uc5d0\ub294 \uae34 \uc2e4\ud589\ubcf4\ub2e4\ub294 \uc77c\uad00\uc131\uc5d0 \uc9d1\uc911\ud558\uc138\uc694. \ube44\uc720\ub294 \uc790\uc804\uac70 \ud0c0\ub294 \ubc95\uc744 \ubc30\uc6b0\ub294 \uac83\uc774\ub77c\uace0 \uc0dd\uac01\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc790\uc2e0\uac10\uc744 \ud0a4\uc6b0\ub824\uba74 \ucc9c\ucc9c\ud788 \uc2dc\uc791\ud558\uc138\uc694."}, {"question": "Super Hexagon\uc758 \uc0c9\uc0c1 \ubcc0\uacbd\uc740 \ubb34\uc5c7\uc744 \uc758\ubbf8\ud558\ub098\uc694?", "answer": "Super Hexagon\uc758 \uc0c9\uc0c1 \ubcc0\uacbd\uc740 \ubbf8\uc801 \ubc0f \uae30\ub2a5\uc801 \ubaa9\uc801\uc744 \ubaa8\ub450 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub09c\uc774\ub3c4 \uc218\uc900 \uac04\uc758 \uc804\ud658\uc744 \ub098\ud0c0\ub0b4\uace0 \ud50c\ub808\uc774\uc5b4\uac00 \uc2dc\uac01\uc801\uc73c\ub85c \ubab0\uc785\ud560 \uc218 \uc788\ub3c4\ub85d \ub3d5\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 'Hexagon'\uc5d0\uc11c 'Hexagoner'\ub85c \uc774\ub3d9\ud560 \ub54c \ubc30\uacbd\uc0c9\uc774 \ud30c\ub780\uc0c9\uc5d0\uc11c \ube68\uac04\uc0c9\uc73c\ub85c \ubc14\ub00c\uc5b4 \ub09c\uc774\ub3c4 \uc99d\uac00\ub97c \uc54c\ub9bd\ub2c8\ub2e4. \ub2e4\uc774\uc5b4\uadf8\ub7a8\uc740 \uc774\ub97c \uc124\uba85\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \nHexagon \u2192 \ud30c\ub780\uc0c9 \u2192 \uc26c\uc6c0. \nHexagoner \u2192 \ube68\uac04\uc0c9 \u2192 \uc911\uac04. \uc774 \uc2dc\uac01\uc801 \uc2e0\ud638\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \ub2e4\uac00\uc624\ub294 \ub3c4\uc804\uc5d0 \ub300\ube44\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "Super Hexagon\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \ucd5c\uc885 \uc810\uc218\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc694\uc18c\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Super Hexagon\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc0dd\uc874 \uc2dc\uac04\uc744 \uae30\uc900\uc73c\ub85c \ud569\ub2c8\ub2e4. \uc0dd\uc874 \uc2dc\uac04\uc774 \uae38\uc218\ub85d \uc810\uc218\uac00 \ub192\uc544\uc9d1\ub2c8\ub2e4. \ub610\ud55c \uac01 \ub09c\uc774\ub3c4 \uc218\uc900\uc5d0\ub294 \ucd5c\uc885 \uc810\uc218\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc2b9\uc218\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 'Hyper Hexagon'\uc5d0\uc11c 60\ucd08 \ub3d9\uc548 \uc0dd\uc874\ud558\uba74 'Hexagon'\uc5d0\uc11c \uac19\uc740 \uc2dc\uac04 \ub3d9\uc548 \uc0dd\uc874\ud558\ub294 \uac83\ubcf4\ub2e4 \ub354 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ube44\uad50 \ud45c\ub294 \uc774\ub97c \uba85\ud655\ud788 \ud569\ub2c8\ub2e4. \n| \ub09c\uc774\ub3c4 | \uc0dd\uc874 \uc2dc\uac04 | \uc810\uc218 \uc2b9\uc218 |\n|---|---|---|\n| Hexagon | 60\ucd08 | 1\ubc30 |\n| Hyper Hexagon | 60\ucd08 | 3\ubc30 |\n \uc774\ub97c \uc774\ud574\ud558\uba74 \ud50c\ub808\uc774\uc5b4\uac00 \uc2e4\ud589 \uc804\ub7b5\uc744 \uc138\uc6b0\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Super Hexagon \uc9c4\ud589 \uc0c1\ud669\uc744 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud604\uc7ac Super Hexagon\uc740 \ud50c\ub7ab\ud3fc \uac04 \uc9c4\ud589 \uc0c1\ud669 \uc804\uc1a1\uc744 \uc9c0\uc6d0\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 PC\uc5d0\uc11c \ud50c\ub808\uc774\ud558\uace0 \ubaa8\ubc14\uc77c\ub85c \uc804\ud658\ud558\uba74 \ucc98\uc74c\ubd80\ud130 \ub2e4\uc2dc \uc2dc\uc791\ud574\uc57c \ud569\ub2c8\ub2e4. \uadf8\ub7ec\ub098 Steam\uacfc \uac19\uc740 \uc77c\ubd80 \ud50c\ub7ab\ud3fc\uc5d0\uc11c\ub294 \uac1c\ubcc4 \uc7a5\uce58\uc5d0 \ub300\ud55c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ud5c8\uc6a9\ud569\ub2c8\ub2e4. \uc21c\uc11c\ub3c4\ub294 \uba85\ud655\ud788 \ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \n1. PC\uc5d0\uc11c \ud50c\ub808\uc774 \u2192 Steam \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5. \n2. \ubaa8\ubc14\uc77c\ub85c \uc804\ud658 \u2192 \ucc98\uc74c\ubd80\ud130 \uc2dc\uc791. \uc774 \uc81c\ud55c\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc120\ud638\ud558\ub294 \ud50c\ub7ab\ud3fc\uc744 \uc2e0\uc911\ud558\uac8c \uc120\ud0dd\ud574\uc57c \ud568\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4."}, {"question": "Super Hexagon\uc5d0 \uc228\uaca8\uc9c4 \uba54\ucee4\ub2c8\uc998\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\ub098\uc694?", "answer": "Super Hexagon\uc5d0\ub294 \uac8c\uc784\uc5d0 \uae4a\uc774\ub97c \ub354\ud558\ub294 \ubbf8\ubb18\ud55c \uba54\ucee4\ub2c8\uc998\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 \uac8c\uc784 \uc0ac\uc6b4\ub4dc\ud2b8\ub799\uc740 \uc131\ub2a5\uc5d0 \ub530\ub77c \ub3d9\uc801\uc73c\ub85c \ubcc0\uacbd\ub418\uc5b4 \ub354\uc6b1 \ubab0\uc785\uac10 \uc788\ub294 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub610\ud55c 'Hyper Hexagonest'\uc758 \ud2b9\uc815 \ud328\ud134\uc740 \uac70\uc758 \ubd88\uac00\ub2a5\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5b4 \uac00\uc7a5 \ud5cc\uc2e0\uc801\uc778 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ub3c4\uc804 \uacfc\uc81c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ube44\uc720\ub294 \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uc774\ub77c\uace0 \uc0dd\uac01\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uadf8\uac83\ub4e4\uc744 \ubc1c\uacac\ud558\uba74 \uac8c\uc784\uc758 \ub9e4\ub825\uc774 \ub354\ud574\uc9d1\ub2c8\ub2e4."}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 Super Hexagon\uc5d0\uc11c \ubc18\ubcf5\ub418\ub294 \uc2e4\ud328\uc758 \uc88c\uc808\uac10\uc744 \uc5b4\ub5bb\uac8c \uadf9\ubcf5\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Super Hexagon\uc5d0\uc11c \ubc18\ubcf5\ub418\ub294 \uc2e4\ud328\ub294 \ub099\ub2f4\uc2a4\ub7ec\uc6b8 \uc218 \uc788\uc9c0\ub9cc \uc810\uc9c4\uc801\uc778 \uc9c4\ud589\uc5d0 \uc9d1\uc911\ud558\ub294 \uac83\uc774 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. 1\ub2e8\uacc4: \uc774\uc804 \ucd5c\uace0 \uae30\ub85d\ubcf4\ub2e4 10\ucd08 \ub354 \uc624\ub798 \uc0dd\uc874\ud558\ub294 \uac83\uacfc \uac19\uc774 \uc791\uc740 \ubaa9\ud45c\ub97c \uc124\uc815\ud558\uc138\uc694. 2\ub2e8\uacc4: \uac01 \uc2e4\ud589\uc5d0\uc11c \ubb34\uc5c7\uc774 \uc798\ubabb\ub418\uc5c8\ub294\uc9c0 \ubd84\uc11d\ud558\uc138\uc694. \ud2b9\uc815 \ud328\ud134\uc774\uc5c8\ub098\uc694, \uc544\ub2c8\uba74 \ubc18\uc751 \uc2dc\uac04\uc774\uc5c8\ub098\uc694? 3\ub2e8\uacc4: \uc18c\uc9c4\uc744 \ud53c\ud558\uae30 \uc704\ud574 \ud734\uc2dd\uc744 \ucde8\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4 20\ucd08 \ub9c8\ud06c\uc5d0\uc11c \uacc4\uc18d \uc2e4\ud328\ud558\ub294 \uacbd\uc6b0 \ud574\ub2f9 \ud2b9\uc815 \uc138\uadf8\uba3c\ud2b8\ub97c \uc5f0\uc2b5\ud558\uc138\uc694. \ub3c4\uc6c0\uc774 \ub418\ub294 \ube44\uc720\ub294 \uc0b0\uc744 \uc624\ub974\ub294 \uac83\uc774\ub77c\uace0 \uc0dd\uac01\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uac01 \ub2e8\uacc4\ub294 \uc815\uc0c1\uc5d0 \ub354 \uac00\uae4c\uc6cc\uc9c0\uac8c \ud569\ub2c8\ub2e4."}]
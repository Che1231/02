[{"question": "\u30b9\u30fc\u30d1\u30fc\u30d8\u30ad\u30b5\u30b4\u30f3\u3067\u521d\u5fc3\u8005\u304c\u53cd\u5fdc\u6642\u9593\u3092\u5411\u4e0a\u3055\u305b\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30fc\u30d1\u30fc\u30d8\u30ad\u30b5\u30b4\u30f3\u3067\u53cd\u5fdc\u6642\u9593\u3092\u5411\u4e0a\u3055\u305b\u308b\u306b\u306f\u3001\u30d1\u30bf\u30fc\u30f3\u306e\u51fa\u73fe\u3059\u308b\u753b\u9762\u306e\u4e2d\u5fc3\u306b\u96c6\u4e2d\u3059\u308b\u3053\u3068\u304b\u3089\u59cb\u3081\u307e\u3059\u3002\u56f3\u5f62\u3092\u65e9\u671f\u306b\u8a8d\u8b58\u3059\u308b\u7df4\u7fd2\u3092\u3059\u308b\u3053\u3068\u3067\u3001\u53cd\u5fdc\u3059\u308b\u6642\u9593\u3092\u4f5c\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u58c1\u304c\u8fd1\u3065\u3044\u3066\u304d\u305f\u3089\u3001\u5b89\u5168\u306a\u901a\u8def\u3092\u3059\u3070\u3084\u304f\u7279\u5b9a\u3057\u3001\u305d\u308c\u306b\u5fdc\u3058\u3066\u79fb\u52d5\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u76ee\u3092\u4e2d\u5fc3\u306b\u56fa\u5b9a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d1\u30bf\u30fc\u30f3\u3092\u4e88\u6e2c\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7d20\u65e9\u304f\u6b63\u78ba\u306a\u52d5\u304d\u3092\u4f7f\u7528\u3057\u3066\u79fb\u52d5\u3057\u307e\u3059\u3002\u308f\u304b\u308a\u3084\u3059\u3044\u4f8b\u3048\u306f\u3001\u904b\u8ee2\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u30b9\u30e0\u30fc\u30ba\u306b\u30cf\u30f3\u30c9\u30eb\u3092\u5207\u308b\u305f\u3081\u306b\u3001\u524d\u65b9\u9053\u8def\u3092\u4e88\u6e2c\u3057\u307e\u3059\u3002"}, {"question": "\u30b9\u30fc\u30d1\u30fc\u30d8\u30ad\u30b5\u30b4\u30f3\u306e\u96e3\u6613\u5ea6\u30ec\u30d9\u30eb\u9593\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30fc\u30d1\u30fc\u30d8\u30ad\u30b5\u30b4\u30f3\u306b\u306f\u3001\u901f\u5ea6\u3068\u8907\u96d1\u3055\u304c\u5897\u30596\u3064\u306e\u96e3\u6613\u5ea6\u30ec\u30d9\u30eb\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30d8\u30ad\u30b5\u30b4\u30f3\u300d\u306f\u6700\u3082\u7c21\u5358\u3067\u3001\u58c1\u306e\u52d5\u304d\u304c\u9045\u304f\u306a\u308a\u307e\u3059\u304c\u3001\u300c\u30cf\u30a4\u30d1\u30fc\u30d8\u30ad\u30b5\u30b4\u30f3\u300d\u306f\u6700\u3082\u96e3\u3057\u304f\u3001\u3088\u308a\u901f\u304f\u3001\u4e88\u6e2c\u3067\u304d\u306a\u3044\u30d1\u30bf\u30fc\u30f3\u306e\u7279\u5fb4\u304c\u3042\u308a\u307e\u3059\u3002\u6bd4\u8f03\u8868\u306f\u3001\u9055\u3044\u3092\u8aac\u660e\u3059\u308b\u305f\u3081\u306b\u5f79\u7acb\u3061\u307e\u3059\uff1a\n| \u96e3\u6613\u5ea6\u30ec\u30d9\u30eb | \u901f\u5ea6 | \u30d1\u30bf\u30fc\u30f3\u306e\u8907\u96d1\u3055 |\n|-----------------|-------|---------------------|\n| \u30d8\u30ad\u30b5\u30b4\u30f3          | \u4f4e   | \u30b7\u30f3\u30d7\u30eb              |\n| \u30cf\u30a4\u30d1\u30fc\u30d8\u30ad\u30b5\u30b4\u30f3 | \u9ad8  | \u6975\u3081\u3066\u8907\u96d1      |\n\u3053\u308c\u3089\u306e\u9055\u3044\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u73fe\u5b9f\u7684\u306a\u76ee\u6a19\u3092\u8a2d\u5b9a\u3057\u3001\u52b9\u679c\u7684\u306b\u9032\u6b69\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "PC\u3067\u30b9\u30fc\u30d1\u30fc\u30d8\u30ad\u30b5\u30b4\u30f3\u3092\u30d7\u30ec\u30a4\u3059\u308b\u306e\u306b\u6700\u9069\u306a\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u30b9\u30ad\u30fc\u30e0\u306f\u3069\u308c\u3067\u3059\u304b\uff1f", "answer": "PC\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u5834\u5408\u3001\u30ad\u30fc\u30dc\u30fc\u30c9\u3092\u4f7f\u7528\u3059\u308b\u306e\u304c\u4e00\u822c\u7684\u306b\u6700\u3082\u6b63\u78ba\u306a\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u30b9\u30ad\u30fc\u30e0\u3067\u3059\u3002\u77e2\u5370\u30ad\u30fc\u306f\u3001\u30b9\u30fc\u30d1\u30fc\u30d8\u30ad\u30b5\u30b4\u30f3\u306e\u9ad8\u901f\u306a\u30d1\u30bf\u30fc\u30f3\u3092\u30ca\u30d3\u30b2\u30fc\u30c8\u3059\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u306a\u3001\u8fc5\u901f\u304b\u3064\u6b63\u78ba\u306a\u52d5\u304d\u3092\u53ef\u80fd\u306b\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u58c1\u3092\u304b\u308f\u3059\u305f\u3081\u306b\u5de6\u53f3\u306e\u77e2\u5370\u30ad\u30fc\u3092\u4f7f\u7528\u3059\u308b\u306e\u306f\u76f4\u611f\u7684\u3067\u53cd\u5fdc\u7684\u3067\u3059\u3002\u3042\u308b\u3044\u306f\u3001\u4e00\u90e8\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u3088\u308a\u30ea\u30e9\u30c3\u30af\u30b9\u3057\u305f\u30b0\u30ea\u30c3\u30d7\u306e\u305f\u3081\u306b\u30b2\u30fc\u30e0\u30d1\u30c3\u30c9\u3092\u597d\u307f\u307e\u3059\u304c\u3001\u30ad\u30fc\u30dc\u30fc\u30c9\u307b\u3069\u306e\u6b63\u78ba\u6027\u306f\u6b20\u3051\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u304c\u9078\u629e\u306b\u5f79\u7acb\u3061\u307e\u3059\uff1a\n1. \u30ad\u30fc\u30dc\u30fc\u30c9\u3092\u9078\u629e \u2192 \u9ad8\u7cbe\u5ea6\u3002\n2. \u30b2\u30fc\u30e0\u30d1\u30c3\u30c9\u3092\u9078\u629e \u2192 \u5feb\u9069\u306a\u30b0\u30ea\u30c3\u30d7\u3002"}, {"question": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30b9\u30fc\u30d1\u30fc\u30d8\u30ad\u30b5\u30b4\u30f3\u3067\u9577\u6642\u9593\u306e\u30d7\u30ec\u30a4\u3092\u6700\u9069\u5316\u3059\u308b\u305f\u3081\u306b\u3001\u3069\u306e\u3088\u3046\u306a\u6226\u7565\u3092\u3068\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30d1\u30bf\u30fc\u30f3\u306e\u8a8d\u8b58\u3092\u30de\u30b9\u30bf\u30fc\u3057\u3001\u4e0d\u5fc5\u8981\u306a\u52d5\u304d\u3092\u6700\u5c0f\u9650\u306b\u3059\u308b\u3053\u3068\u3067\u3001\u6226\u7565\u3092\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5dee\u3057\u8feb\u3063\u305f\u58c1\u3092\u4e88\u6e2c\u3059\u308b\u305f\u3081\u306b\u3001\u4e2d\u5fc3\u306b\u6ce8\u610f\u3092\u6255\u3046\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u304e\u304f\u3057\u3083\u304f\u3057\u305f\u52d5\u304d\u3067\u306f\u306a\u304f\u3001\u6ed1\u3089\u304b\u3067\u9023\u7d9a\u7684\u306a\u52d5\u304d\u3092\u4f7f\u7528\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u3088\u308a\u901f\u304f\u53cd\u5fdc\u3059\u308b\u305f\u3081\u306b\u3001\u7e70\u308a\u8fd4\u3055\u308c\u308b\u30d1\u30bf\u30fc\u30f3\u3092\u8a18\u61b6\u3059\u308b\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30cf\u30a4\u30d1\u30fc\u30d8\u30ad\u30b5\u30b4\u30f3\u300d\u3067\u306f\u3001\u7279\u5b9a\u306e\u58c1\u30b7\u30fc\u30b1\u30f3\u30b9\u304c\u7e70\u308a\u8fd4\u3055\u308c\u307e\u3059\u3002\u305d\u308c\u3089\u3092\u8a8d\u8b58\u3059\u308b\u3053\u3068\u3067\u3001\u91cd\u8981\u306a\u30df\u30ea\u79d2\u3092\u7bc0\u7d04\u3067\u304d\u307e\u3059\u3002\u6709\u76ca\u306a\u6bd4\u8f03\u306f\u3001\u30c0\u30f3\u30b9\u3092\u8003\u3048\u308b\u3053\u3068\u3067\u3059\u3002\u30b9\u30e0\u30fc\u30ba\u306b\u79fb\u52d5\u3059\u308b\u305f\u3081\u306e\u624b\u9806\u3092\u7406\u89e3\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30b9\u30fc\u30d1\u30fc\u30d8\u30ad\u30b5\u30b4\u30f3\u304c\u306a\u305c\u305d\u308c\u307b\u3069\u901f\u304f\u611f\u3058\u3089\u308c\u308b\u306e\u3067\u3057\u3087\u3046\u304b\uff1f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u305d\u306e\u30b9\u30d4\u30fc\u30c9\u306b\u9069\u5fdc\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30b9\u30fc\u30d1\u30fc\u30d8\u30ad\u30b5\u30b4\u30f3\u306f\u3001\u305d\u306e\u5897\u52a0\u3059\u308b\u901f\u5ea6\u3068\u30b7\u30f3\u30d7\u30eb\u306a\u30c7\u30b6\u30a4\u30f3\u306e\u305f\u3081\u306b\u901f\u304f\u611f\u3058\u3089\u308c\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u6c17\u3092\u6563\u3089\u3059\u3082\u306e\u3092\u6392\u9664\u3057\u307e\u3059\u3002\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u7b4b\u8089\u8a18\u61b6\u3092\u69cb\u7bc9\u3059\u308b\u305f\u3081\u306b\u3001\u77ed\u3044\u6642\u9593\u306e\u30d1\u30bf\u30fc\u30f3\u7df4\u7fd2\u3092\u884c\u3046\u3053\u3068\u3067\u9069\u5fdc\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30d8\u30ad\u30b5\u30b4\u30f3\u300d\u30ec\u30d9\u30eb\u304b\u3089\u59cb\u3081\u3001\u3088\u308a\u901f\u3044\u30ec\u30d9\u30eb\u306b\u9032\u3080\u524d\u306b\u57fa\u672c\u7684\u306a\u30e1\u30ab\u30cb\u30af\u30b9\u306b\u6163\u308c\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u3088\u308a\u9045\u3044\u30ec\u30d9\u30eb\u304b\u3089\u59cb\u3081\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5f90\u3005\u306b\u96e3\u6613\u5ea6\u3092\u4e0a\u3052\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6700\u521d\u306f\u3001\u9577\u3044\u5b9f\u884c\u6642\u9593\u3088\u308a\u3082\u4e00\u8cab\u6027\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u4f8b\u3048\u306f\u3001\u81ea\u8ee2\u8eca\u306b\u4e57\u308b\u3053\u3068\u3092\u5b66\u3076\u3053\u3068\u3067\u3059\u3002\u81ea\u4fe1\u3092\u7bc9\u304f\u305f\u3081\u306b\u3086\u3063\u304f\u308a\u3068\u59cb\u3081\u307e\u3059\u3002"}, {"question": "\u30b9\u30fc\u30d1\u30fc\u30d8\u30ad\u30b5\u30b4\u30f3\u306e\u8272\u306e\u5909\u5316\u306f\u4f55\u3092\u610f\u5473\u3057\u3066\u3044\u307e\u3059\u304b\uff1f", "answer": "\u30b9\u30fc\u30d1\u30fc\u30d8\u30ad\u30b5\u30b4\u30f3\u306e\u8272\u306e\u5909\u5316\u306f\u3001\u7f8e\u7684\u306a\u76ee\u7684\u3068\u6a5f\u80fd\u7684\u306a\u76ee\u7684\u306e\u4e21\u65b9\u3067\u4f7f\u7528\u3055\u308c\u307e\u3059\u3002\u96e3\u6613\u5ea6\u306e\u30ec\u30d9\u30eb\u9593\u306e\u79fb\u884c\u3092\u793a\u3057\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u8996\u899a\u7684\u306b\u95a2\u4e0e\u3057\u7d9a\u3051\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30d8\u30ad\u30b5\u30b4\u30f3\u300d\u304b\u3089\u300c\u30d8\u30ad\u30b5 \u30b4\u30ca\u30fc\u300d\u306b\u79fb\u52d5\u3059\u308b\u3068\u3001\u80cc\u666f\u306e\u8272\u304c\u9752\u304b\u3089\u8d64\u306b\u5909\u5316\u3057\u3001\u96e3\u6613\u5ea6\u304c\u5897\u52a0\u3059\u308b\u3053\u3068\u3092\u793a\u3057\u307e\u3059\u3002\u56f3\u306f\u3053\u308c\u3092\u8aac\u660e\u3057\u307e\u3059\uff1a\n\u30d8\u30ad\u30b5\u30b4\u30f3 \u2192 \u9752 \u2192 \u7c21\u5358\u3002\n\u30d8\u30ad\u30b5 \u30b4\u30ca\u30fc \u2192 \u8d64 \u2192 \u4e2d\u7a0b\u5ea6\u3002\u3053\u306e\u8996\u899a\u7684\u306a\u624b\u304c\u304b\u308a\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u6b21\u306e\u8ab2\u984c\u306b\u7cbe\u795e\u7684\u306b\u6e96\u5099\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30b9\u30fc\u30d1\u30fc\u30d8\u30ad\u30b5\u30b4\u30f3\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u6700\u7d42\u7684\u306a\u30b9\u30b3\u30a2\u306b\u3069\u306e\u3088\u3046\u306a\u5f71\u97ff\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30b9\u30fc\u30d1\u30fc\u30d8\u30ad\u30b5\u30b4\u30f3\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u751f\u5b58\u6642\u9593\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u751f\u5b58\u6642\u9593\u304c\u9577\u3051\u308c\u3070\u9577\u3044\u307b\u3069\u3001\u30b9\u30b3\u30a2\u304c\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u5404\u96e3\u6613\u5ea6\u30ec\u30d9\u30eb\u306b\u306f\u3001\u6700\u7d42\u7684\u306a\u30b9\u30b3\u30a2\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u4e57\u6570\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30cf\u30a4\u30d1\u30fc\u30d8\u30ad\u30b5\u30b4\u30f3\u300d\u306760\u79d2\u751f\u5b58\u3059\u308b\u3068\u3001\u300c\u30d8\u30ad\u30b5\u30b4\u30f3\u300d\u3068\u540c\u3058\u6642\u9593\u3068\u6bd4\u3079\u3066\u3001\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u306b\u306a\u308a\u307e\u3059\u3002\u6bd4\u8f03\u8868\u306f\u3053\u306e\u70b9\u3092\u660e\u78ba\u5316\u3057\u307e\u3059\uff1a\n| \u96e3\u6613\u5ea6\u30ec\u30d9\u30eb | \u751f\u5b58\u6642\u9593 | \u30b9\u30b3\u30a2\u4e57\u6570 |\n|-----------------|---------------|------------------|\n| \u30d8\u30ad\u30b5\u30b4\u30f3          | 60\u79d2    | 1\u500d               |\n| \u30cf\u30a4\u30d1\u30fc\u30d8\u30ad\u30b5\u30b4\u30f3    | 60\u79d2    | 3\u500d               |\n\u3053\u306e\u7406\u89e3\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30d7\u30ec\u30a4\u6226\u7565\u3092\u7b56\u5b9a\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30b9\u30fc\u30d1\u30fc\u30d8\u30ad\u30b5\u30b4\u30f3\u306e\u9032\u884c\u72b6\u6cc1\u306f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u73fe\u5728\u3001\u30b9\u30fc\u30d1\u30fc\u30d8\u30ad\u30b5\u30b4\u30f3\u306f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u306e\u9032\u884c\u72b6\u6cc1\u306e\u8ee2\u9001\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u307e\u305b\u3093\u3002\u305f\u3068\u3048\u3070\u3001PC\u3067\u30d7\u30ec\u30a4\u3057\u3066\u30e2\u30d0\u30a4\u30eb\u306b\u5207\u308a\u66ff\u3048\u305f\u5834\u5408\u306f\u3001\u3084\u308a\u76f4\u3057\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3060\u3057\u3001Steam\u306a\u3069\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306f\u3001\u500b\u3005\u306e\u30c7\u30d0\u30a4\u30b9\u306b\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u8a31\u53ef\u3057\u307e\u3059\u3002\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u306f\u660e\u78ba\u306b\u8aac\u660e\u3057\u307e\u3059\uff1a\n1. PC\u3067\u30d7\u30ec\u30a4 \u2192 Steam \u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3002\n2. \u30e2\u30d0\u30a4\u30eb\u306b\u5207\u308a\u66ff\u3048 \u2192 \u65b0\u898f\u958b\u59cb\u3002\u3053\u306e\u5236\u9650\u306b\u3088\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u597d\u307e\u3057\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u614e\u91cd\u306b\u9078\u629e\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30b9\u30fc\u30d1\u30fc\u30d8\u30ad\u30b5\u30b4\u30f3\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u30e1\u30ab\u30cb\u30ba\u30e0\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30b9\u30fc\u30d1\u30fc\u30d8\u30ad\u30b5\u30b4\u30f3\u306b\u306f\u3001\u30b2\u30fc\u30e0\u306e\u6df1\u307f\u3092\u52a0\u3048\u308b\u5fae\u5999\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30b2\u30fc\u30e0\u306e\u30b5\u30a6\u30f3\u30c9\u30c8\u30e9\u30c3\u30af\u306f\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u57fa\u3065\u3044\u3066\u52d5\u7684\u306b\u5909\u5316\u3059\u308b\u305f\u3081\u3001\u3088\u308a\u6ca1\u5165\u611f\u306e\u3042\u308b\u4f53\u9a13\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u300c\u30cf\u30a4\u30d1\u30fc\u30d8\u30ad\u30b5\u30b4\u30f3\u300d\u306e\u7279\u5b9a\u306e\u30d1\u30bf\u30fc\u30f3\u306f\u3001\u6700\u3082\u71b1\u5fc3\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u6311\u6226\u3068\u3057\u3066\u6a5f\u80fd\u3059\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u96a0\u3055\u308c\u305f\u5b9d\u7bb1\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u305d\u308c\u3089\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u306e\u9b45\u529b\u304c\u5897\u3057\u307e\u3059\u3002"}, {"question": "\u30b9\u30fc\u30d1\u30fc\u30d8\u30ad\u30b5\u30b4\u30f3\u3067\u7e70\u308a\u8fd4\u3055\u308c\u308b\u5931\u6557\u306b\u3088\u308b\u30d5\u30e9\u30b9\u30c8\u30ec\u30fc\u30b7\u30e7\u30f3\u3092\u3069\u306e\u3088\u3046\u306b\u514b\u670d\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30b9\u30fc\u30d1\u30fc\u30d8\u30ad\u30b5\u30b4\u30f3\u3067\u7e70\u308a\u8fd4\u3055\u308c\u308b\u5931\u6557\u306f\u3001\u843d\u80c6\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u304c\u3001\u6bb5\u968e\u7684\u306a\u9032\u6b69\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3053\u3068\u3067\u5f79\u306b\u7acb\u3061\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u4ee5\u524d\u306e\u6700\u9ad8\u8a18\u9332\u3088\u308a\u308210\u79d2\u9577\u304f\u751f\u304d\u6b8b\u308b\u306a\u3069\u3001\u5c0f\u3055\u306a\u76ee\u6a19\u3092\u8a2d\u5b9a\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u305d\u308c\u305e\u308c\u306e\u5b9f\u884c\u3067\u4f55\u304c\u9593\u9055\u3063\u3066\u3044\u305f\u306e\u304b\u3092\u5206\u6790\u3059\u308b\u3002\u7279\u5b9a\u306e\u30d1\u30bf\u30fc\u30f3\u304b\u53cd\u5fdc\u6642\u9593\u3067\u3057\u305f\u304b\uff1f\u30b9\u30c6\u30c3\u30d73\uff1a\u71c3\u3048\u5c3d\u304d\u306a\u3044\u3088\u3046\u306b\u4f11\u61a9\u3092\u3068\u308b\u3002\u305f\u3068\u3048\u3070\u300120\u79d2\u5730\u70b9\u3067\u7e70\u308a\u8fd4\u3057\u5931\u6557\u3059\u308b\u5834\u5408\u306f\u3001\u305d\u306e\u7279\u5b9a\u306e\u30bb\u30b0\u30e1\u30f3\u30c8\u306e\u7df4\u7fd2\u3092\u3057\u307e\u3059\u3002\u5c71\u3092\u767b\u308b\u3068\u3044\u3063\u305f\u4f8b\u3048\u306f\u6709\u52b9\u3067\u3059\u3002\u5404\u30b9\u30c6\u30c3\u30d7\u304c\u5c71\u9802\u306b\u8fd1\u3065\u3051\u308b\u304b\u3089\u3067\u3059\u3002"}]
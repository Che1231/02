[{"question": "\u521d\u5b78\u8005\u5982\u4f55\u5728\u300a\u8d85\u7d1a\u516d\u908a\u5f62\u300b\u4e2d\u63d0\u5347\u53cd\u61c9\u6642\u9593\uff1f", "answer": "\u8981\u63d0\u5347\u300a\u8d85\u7d1a\u516d\u908a\u5f62\u300b\u4e2d\u7684\u53cd\u61c9\u6642\u9593\uff0c\u9996\u5148\u8981\u5c08\u6ce8\u65bc\u5716\u5f62\u51fa\u73fe\u7684\u87a2\u5e55\u4e2d\u592e\u3002\u7df4\u7fd2\u63d0\u65e9\u8fa8\u8b58\u5716\u5f62\uff0c\u9019\u53ef\u4ee5\u8b93\u60a8\u6709\u66f4\u591a\u53cd\u61c9\u6642\u9593\u3002\u4f8b\u5982\uff0c\u7576\u7246\u58c1\u903c\u8fd1\u6642\uff0c\u5feb\u901f\u8fa8\u8b58\u5b89\u5168\u7684\u8def\u7dda\u4e26\u76f8\u61c9\u5730\u79fb\u52d5\u3002\u6b65\u9a5f\u4e00\uff1a\u4fdd\u6301\u60a8\u7684\u8996\u7dda\u96c6\u4e2d\u5728\u4e2d\u592e\u3002\u6b65\u9a5f\u4e8c\uff1a\u9810\u6e2c\u5716\u5f62\u3002\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u5feb\u901f\u3001\u7cbe\u78ba\u7684\u52d5\u4f5c\u9032\u884c\u5c0e\u822a\u3002\u4e00\u500b\u6709\u5e6b\u52a9\u7684\u985e\u6bd4\u662f\u5c07\u5176\u8996\u70ba\u99d5\u99db\u2014\u2014\u9810\u6e2c\u524d\u65b9\u9053\u8def\uff0c\u4ee5\u5e73\u7a69\u5730\u8f49\u5411\u3002"}, {"question": "\u300a\u8d85\u7d1a\u516d\u908a\u5f62\u300b\u4e0d\u540c\u96e3\u5ea6\u7b49\u7d1a\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "\u300a\u8d85\u7d1a\u516d\u908a\u5f62\u300b\u8a2d\u6709\u516d\u500b\u96e3\u5ea6\u7b49\u7d1a\uff0c\u6bcf\u500b\u96e3\u5ea6\u7b49\u7d1a\u7684\u901f\u5ea6\u548c\u8907\u96dc\u5ea6\u90fd\u5728\u589e\u52a0\u3002\u4f8b\u5982\uff0c\u300c\u516d\u908a\u5f62\u300d\u662f\u6700\u5bb9\u6613\u7684\uff0c\u7246\u58c1\u79fb\u52d5\u901f\u5ea6\u8f03\u6162\uff0c\u800c\u300c\u8d85\u7d1a\u516d\u908a\u5f62\u300d\u662f\u6700\u96e3\u7684\uff0c\u5716\u6848\u901f\u5ea6\u66f4\u5feb\uff0c\u4e14\u66f4\u96e3\u9810\u6e2c\u3002\u6bd4\u8f03\u8868\u6709\u52a9\u65bc\u8aaa\u660e\u9019\u4e9b\u5dee\u7570\uff1a\n| \u96e3\u5ea6\u7b49\u7d1a | \u901f\u5ea6 | \u5716\u5f62\u8907\u96dc\u5ea6 |\n|---|---|---|\n| \u516d\u908a\u5f62 | \u4f4e | \u7c21\u55ae |\n| \u8d85\u7d1a\u516d\u908a\u5f62 | \u9ad8 | \u9ad8\u5ea6\u8907\u96dc |\n\u4e86\u89e3\u9019\u4e9b\u5dee\u7570\u53ef\u4ee5\u5e6b\u52a9\u73a9\u5bb6\u8a2d\u5b9a\u73fe\u5be6\u7684\u76ee\u6a19\u4e26\u6709\u6548\u5730\u9032\u6b65\u3002"}, {"question": "\u5728\u96fb\u8166\u4e0a\u73a9\u300a\u8d85\u7d1a\u516d\u908a\u5f62\u300b\u54ea\u7a2e\u63a7\u5236\u65b9\u6848\u6700\u597d\uff1f", "answer": "\u5c0d\u65bc\u96fb\u8166\u73a9\u5bb6\u4f86\u8aaa\uff0c\u4f7f\u7528\u9375\u76e4\u901a\u5e38\u662f\u7cbe\u5ea6\u6700\u9ad8\u7684\u63a7\u5236\u65b9\u6848\u3002\u65b9\u5411\u9375\u53ef\u4ee5\u8b93\u60a8\u5feb\u901f\u3001\u6e96\u78ba\u5730\u79fb\u52d5\uff0c\u9019\u5c0d\u65bc\u5728\u300a\u8d85\u7d1a\u516d\u908a\u5f62\u300b\u4e2d\u5c0e\u822a\u5feb\u901f\u8b8a\u5316\u7684\u5716\u6848\u81f3\u95dc\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u5de6\u53f3\u65b9\u5411\u9375\u4f86\u8eb2\u907f\u7246\u58c1\u611f\u89ba\u76f4\u89c0\u4e14\u53cd\u61c9\u8fc5\u901f\u3002\u6216\u8005\uff0c\u4e00\u4e9b\u73a9\u5bb6\u66f4\u559c\u6b61\u904a\u6232\u63a7\u5236\u5668\uff0c\u53ef\u4ee5\u63d0\u4f9b\u66f4\u653e\u9b06\u7684\u628a\u6301\u611f\uff0c\u4f46\u5b83\u53ef\u80fd\u7f3a\u4e4f\u9375\u76e4\u7684\u7cbe\u78ba\u6027\u3002\u6d41\u7a0b\u5716\u6709\u52a9\u65bc\u6c7a\u5b9a\uff1a\n1. \u9078\u64c7\u9375\u76e4 \u2192 \u9ad8\u7cbe\u5ea6\u3002\n2. \u9078\u64c7\u904a\u6232\u63a7\u5236\u5668 \u2192 \u8212\u9069\u6293\u63e1\u3002"}, {"question": "\u9ad8\u7d1a\u73a9\u5bb6\u5982\u4f55\u512a\u5316\u4ed6\u5011\u7684\u7b56\u7565\uff0c\u5728\u300a\u8d85\u7d1a\u516d\u908a\u5f62\u300b\u4e2d\u53d6\u5f97\u66f4\u9577\u6642\u9593\u7684\u904a\u6232\uff1f", "answer": "\u9ad8\u7d1a\u73a9\u5bb6\u53ef\u4ee5\u900f\u904e\u638c\u63e1\u5716\u5f62\u8fa8\u8b58\u548c\u6700\u5927\u9650\u5ea6\u5730\u6e1b\u5c11\u4e0d\u5fc5\u8981\u7684\u52d5\u4f5c\u4f86\u512a\u5316\u4ed6\u5011\u7684\u7b56\u7565\u3002\u6b65\u9a5f\u4e00\uff1a\u5c08\u6ce8\u65bc\u4e2d\u592e\u4f86\u9810\u6e2c\u5373\u5c07\u5230\u4f86\u7684\u7246\u58c1\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u5e73\u6ed1\u3001\u9023\u7e8c\u7684\u52d5\u4f5c\uff0c\u800c\u4e0d\u662f\u8df3\u52d5\u7684\u52d5\u4f5c\u3002\u6b65\u9a5f\u4e09\uff1a\u8a18\u4f4f\u91cd\u8907\u51fa\u73fe\u7684\u5716\u6848\uff0c\u4ee5\u4fbf\u66f4\u5feb\u5730\u53cd\u61c9\u3002\u4f8b\u5982\uff0c\u5728\u300c\u8d85\u7d1a\u516d\u908a\u5f62\u300d\u4e2d\uff0c\u67d0\u4e9b\u7246\u58c1\u5e8f\u5217\u6703\u91cd\u8907\uff0c\u8fa8\u8b58\u5b83\u5011\u53ef\u4ee5\u7bc0\u7701\u5bf6\u8cb4\u7684\u6beb\u79d2\u3002\u4e00\u500b\u6709\u5e6b\u52a9\u7684\u985e\u6bd4\u662f\u5c07\u5176\u8996\u70ba\u821e\u8e48\u2014\u2014\u77e5\u9053\u6b65\u9a5f\u624d\u80fd\u6d41\u66a2\u5730\u79fb\u52d5\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u300a\u8d85\u7d1a\u516d\u908a\u5f62\u300b\u611f\u89ba\u5982\u6b64\u5feb\u901f\uff0c\u73a9\u5bb6\u5982\u4f55\u9069\u61c9\u5176\u901f\u5ea6\uff1f", "answer": "\u300a\u8d85\u7d1a\u516d\u908a\u5f62\u300b\u611f\u89ba\u5feb\u901f\uff0c\u662f\u56e0\u70ba\u5b83\u4e0d\u65b7\u589e\u52a0\u7684\u901f\u5ea6\u548c\u6975\u7c21\u8a2d\u8a08\uff0c\u6d88\u9664\u4e86\u5e72\u64fe\u3002\u73a9\u5bb6\u53ef\u4ee5\u900f\u904e\u5728\u8f03\u77ed\u7684\u6642\u9593\u5167\u7df4\u7fd2\u4f86\u5efa\u7acb\u808c\u8089\u8a18\u61b6\u4f86\u9069\u61c9\u3002\u4f8b\u5982\uff0c\u5148\u5f9e\u300c\u516d\u908a\u5f62\u300d\u7b49\u7d1a\u958b\u59cb\uff0c\u719f\u6089\u57fa\u672c\u6a5f\u5236\uff0c\u7136\u5f8c\u518d\u9032\u5165\u8f03\u5feb\u7684\u7b49\u7d1a\u3002\u6b65\u9a5f\u4e00\uff1a\u5f9e\u8f03\u6162\u7684\u7b49\u7d1a\u958b\u59cb\u3002\u6b65\u9a5f\u4e8c\uff1a\u9010\u6f38\u589e\u52a0\u96e3\u5ea6\u3002\u6b65\u9a5f\u4e09\uff1a\u6700\u521d\u5c08\u6ce8\u65bc\u4e00\u81f4\u6027\uff0c\u800c\u4e0d\u662f\u9577\u6642\u9593\u904a\u6232\u3002\u4e00\u500b\u6bd4\u55bb\u662f\u5c07\u5176\u8996\u70ba\u5b78\u7fd2\u9a0e\u81ea\u884c\u8eca\u2014\u2014\u5f9e\u6162\u901f\u958b\u59cb\u4f86\u5efa\u7acb\u4fe1\u5fc3\u3002"}, {"question": "\u300a\u8d85\u7d1a\u516d\u908a\u5f62\u300b\u4e2d\u984f\u8272\u8b8a\u5316\u7684\u610f\u7fa9\u662f\u4ec0\u9ebc\uff1f", "answer": "\u300a\u8d85\u7d1a\u516d\u908a\u5f62\u300b\u4e2d\u7684\u984f\u8272\u8b8a\u5316\u540c\u6642\u5177\u6709\u7f8e\u5b78\u548c\u529f\u80fd\u4e0a\u7684\u76ee\u7684\u3002\u5b83\u5011\u6a19\u793a\u4e86\u96e3\u5ea6\u7b49\u7d1a\u7684\u8f49\u63db\uff0c\u4e26\u5e6b\u52a9\u73a9\u5bb6\u4fdd\u6301\u8996\u89ba\u4e0a\u7684\u53c3\u8207\u3002\u4f8b\u5982\uff0c\u7576\u5f9e\u300c\u516d\u908a\u5f62\u300d\u8f49\u63db\u5230\u300c\u516d\u908a\u5f62\u8005\u300d\u6642\uff0c\u80cc\u666f\u984f\u8272\u6703\u5f9e\u85cd\u8272\u8f49\u8b8a\u70ba\u7d05\u8272\uff0c\u8868\u793a\u96e3\u5ea6\u589e\u52a0\u3002\u5716\u89e3\u53ef\u4ee5\u8aaa\u660e\u9019\u4e00\u9ede\uff1a\n\u516d\u908a\u5f62 \u2192 \u85cd\u8272 \u2192 \u7c21\u55ae\u3002\n\u516d\u908a\u5f62\u8005 \u2192 \u7d05\u8272 \u2192 \u4e2d\u7b49\u3002\u9019\u500b\u8996\u89ba\u63d0\u793a\u5e6b\u52a9\u73a9\u5bb6\u5728\u5fc3\u7406\u4e0a\u70ba\u5373\u5c07\u5230\u4f86\u7684\u6311\u6230\u505a\u597d\u6e96\u5099\u3002"}, {"question": "\u300a\u8d85\u7d1a\u516d\u908a\u5f62\u300b\u7684\u5206\u6578\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u6700\u7d42\u5206\u6578\uff1f", "answer": "\u300a\u8d85\u7d1a\u516d\u908a\u5f62\u300b\u7684\u5206\u6578\u7cfb\u7d71\u57fa\u65bc\u5b58\u6d3b\u6642\u9593\u3002\u5b58\u6d3b\u6642\u9593\u8d8a\u9577\uff0c\u5206\u6578\u8d8a\u9ad8\u3002\u6b64\u5916\uff0c\u6bcf\u500b\u96e3\u5ea6\u7b49\u7d1a\u90fd\u6709\u5f71\u97ff\u6700\u7d42\u5206\u6578\u7684\u500d\u6578\u3002\u4f8b\u5982\uff0c\u5728\u300c\u8d85\u7d1a\u516d\u908a\u5f62\u300d\u4e2d\u5b58\u6d3b 60 \u79d2\u6703\u6bd4\u5728\u300c\u516d\u908a\u5f62\u300d\u4e2d\u7372\u5f97\u66f4\u9ad8\u7684\u5206\u6578\u3002\u6bd4\u8f03\u8868\u53ef\u4ee5\u6f84\u6e05\u9019\u4e00\u9ede\uff1a\n| \u96e3\u5ea6\u7b49\u7d1a | \u5b58\u6d3b\u6642\u9593 | \u5206\u6578\u500d\u6578 |\n|---|---|---|\n| \u516d\u908a\u5f62 | 60 \u79d2 | 1 \u500d |\n| \u8d85\u7d1a\u516d\u908a\u5f62 | 60 \u79d2 | 3 \u500d |\n\u4e86\u89e3\u9019\u4e00\u9ede\u53ef\u4ee5\u5e6b\u52a9\u73a9\u5bb6\u5236\u5b9a\u904a\u6232\u7b56\u7565\u3002"}, {"question": "\u300a\u8d85\u7d1a\u516d\u908a\u5f62\u300b\u7684\u9032\u5ea6\u53ef\u4ee5\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u9593\u8f49\u79fb\u55ce\uff1f", "answer": "\u76ee\u524d\uff0c\u300a\u8d85\u7d1a\u516d\u908a\u5f62\u300b\u4e0d\u652f\u6301\u8de8\u5e73\u53f0\u9032\u5ea6\u8f49\u79fb\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u96fb\u8166\u4e0a\u73a9\u904a\u6232\uff0c\u7136\u5f8c\u5207\u63db\u5230\u624b\u6a5f\uff0c\u60a8\u9700\u8981\u91cd\u65b0\u958b\u59cb\u3002\u4f46\u662f\uff0c\u50cf Steam \u9019\u6a23\u7684\u5e73\u53f0\u5141\u8a31\u500b\u5225\u88dd\u7f6e\u7684\u96f2\u7aef\u5132\u5b58\u3002\u6d41\u7a0b\u5716\u53ef\u4ee5\u5e6b\u52a9\u6f84\u6e05\uff1a\n1. \u5728\u96fb\u8166\u4e0a\u73a9 \u2192 Steam \u96f2\u7aef\u5132\u5b58\u3002\n2. \u5207\u63db\u5230\u624b\u6a5f \u2192 \u5f9e\u982d\u958b\u59cb\u3002\u9019\u7a2e\u9650\u5236\u610f\u5473\u8457\u73a9\u5bb6\u61c9\u8a72\u4ed4\u7d30\u9078\u64c7\u4ed6\u5011\u504f\u597d\u7684\u5e73\u53f0\u3002"}, {"question": "\u300a\u8d85\u7d1a\u516d\u908a\u5f62\u300b\u4e2d\u662f\u5426\u5b58\u5728\u96b1\u85cf\u7684\u6a5f\u5236\u6216\u5f69\u86cb\uff1f", "answer": "\u300a\u8d85\u7d1a\u516d\u908a\u5f62\u300b\u5305\u542b\u4e00\u4e9b\u7d30\u5fae\u7684\u6a5f\u5236\u548c\u5f69\u86cb\uff0c\u589e\u52a0\u4e86\u904a\u6232\u7684\u6df1\u5ea6\u3002\u4f8b\u5982\uff0c\u904a\u6232\u7684\u914d\u6a02\u6703\u6839\u64da\u60a8\u7684\u904a\u6232\u8868\u73fe\u800c\u52d5\u614b\u8b8a\u5316\uff0c\u5275\u9020\u51fa\u66f4\u6c89\u6d78\u5f0f\u7684\u9ad4\u9a57\u3002\u6b64\u5916\uff0c\u5728\u300c\u8d85\u7d1a\u516d\u908a\u5f62\u300d\u4e2d\u7684\u67d0\u4e9b\u5716\u6848\u88ab\u8a2d\u8a08\u6210\u5e7e\u4e4e\u4e0d\u53ef\u80fd\uff0c\u9019\u5c0d\u6700\u6295\u5165\u7684\u73a9\u5bb6\u4f86\u8aaa\u662f\u4e00\u7a2e\u6311\u6230\u3002\u4e00\u500b\u6bd4\u55bb\u662f\u5c07\u9019\u4e9b\u8996\u70ba\u96b1\u85cf\u7684\u5bf6\u85cf\u2014\u2014\u767c\u73fe\u5b83\u5011\u589e\u6dfb\u4e86\u904a\u6232\u7684\u9b45\u529b\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u514b\u670d\u5728\u300a\u8d85\u7d1a\u516d\u908a\u5f62\u300b\u4e2d\u53cd\u8986\u5931\u6557\u7684\u6cae\u55aa\u611f\uff1f", "answer": "\u5728\u300a\u8d85\u7d1a\u516d\u908a\u5f62\u300b\u4e2d\u53cd\u8986\u5931\u6557\u53ef\u80fd\u6703\u4ee4\u4eba\u6cae\u55aa\uff0c\u4f46\u5c08\u6ce8\u65bc\u6f38\u9032\u7684\u9032\u6b65\u6709\u52a9\u65bc\u89e3\u6c7a\u9019\u500b\u554f\u984c\u3002\u6b65\u9a5f\u4e00\uff1a\u8a2d\u5b9a\u5c0f\u76ee\u6a19\uff0c\u4f8b\u5982\u6bd4\u4e0a\u6b21\u6700\u597d\u6210\u7e3e\u591a\u5b58\u6d3b 10 \u79d2\u3002\u6b65\u9a5f\u4e8c\uff1a\u5206\u6790\u6bcf\u6b21\u904a\u6232\u5931\u6557\u7684\u539f\u56e0\u2014\u2014\u662f\u7279\u5b9a\u7684\u5716\u6848\u9084\u662f\u53cd\u61c9\u6642\u9593\uff1f\u6b65\u9a5f\u4e09\uff1a\u4f11\u606f\u4e00\u4e0b\uff0c\u907f\u514d\u611f\u5230\u7b4b\u75b2\u529b\u76e1\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u4e0d\u65b7\u5728 20 \u79d2\u8655\u5931\u6557\uff0c\u8acb\u7df4\u7fd2\u90a3\u500b\u7279\u5b9a\u7684\u90e8\u5206\u3002\u4e00\u500b\u6709\u5e6b\u52a9\u7684\u985e\u6bd4\u662f\u5c07\u5176\u8996\u70ba\u722c\u5c71\u2014\u2014\u6bcf\u4e00\u6b65\u90fd\u8b93\u60a8\u66f4\u63a5\u8fd1\u5c71\u9802\u3002"}]
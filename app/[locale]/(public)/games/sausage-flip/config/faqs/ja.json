[{"question": "\u30bd\u30fc\u30bb\u30fc\u30b8\u30d5\u30ea\u30c3\u30d7\u3067\u57fa\u672c\u7684\u306a\u30d5\u30ea\u30c3\u30d7\u3092\u3069\u306e\u3088\u3046\u306b\u5b9f\u884c\u3057\u3001\u521d\u5fc3\u8005\u306e\u305f\u3081\u306e\u4e3b\u8981\u306a\u64cd\u4f5c\u30ad\u30fc\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30bd\u30fc\u30bb\u30fc\u30b8\u30d5\u30ea\u30c3\u30d7\u3067\u57fa\u672c\u7684\u306a\u30d5\u30ea\u30c3\u30d7\u3092\u5b9f\u884c\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30d5\u30ea\u30c3\u30d7\u3092\u5145\u96fb\u3059\u308b\u305f\u3081\u306b\u753b\u9762\uff08\u307e\u305f\u306f\u30de\u30a6\u30b9\u30dc\u30bf\u30f3\uff09\u3092\u62bc\u3057\u7d9a\u3051\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30ea\u30ea\u30fc\u30b9\u3057\u3066\u30d5\u30ea\u30c3\u30d7\u3092\u5b9f\u884c\u3057\u307e\u3059\u3002\u91cd\u8981\u306a\u64cd\u4f5c\u30ad\u30fc\u306b\u306f\u3001\u5145\u96fb\u6642\u9593\uff08\u30d5\u30ea\u30c3\u30d7\u306e\u9ad8\u3055\u3092\u6c7a\u5b9a\uff09\u3001\u30ea\u30ea\u30fc\u30b9\u30bf\u30a4\u30df\u30f3\u30b0\uff08\u65b9\u5411\u3092\u5236\u5fa1\uff09\u3001\u89d2\u5ea6\u8abf\u6574\uff08\u7740\u5730\u306e\u5fae\u8abf\u6574\uff09\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb3\u3067\u306f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u306e\u826f\u3044\u30d5\u30ea\u30c3\u30d7\u3067\u30bd\u30fc\u30bb\u30fc\u30b8\u3092\u5c0f\u3055\u306a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u6b63\u78ba\u306b\u7740\u5730\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u5f13\u77e2\u3092\u5f15\u304f\u3088\u3046\u306b\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u4fdd\u6301\u3059\u308b\u6642\u9593\u304c\u9577\u3044\u307b\u3069\u3001\u98db\u8ddd\u96e2\u304c\u9577\u304f\u306a\u308a\u307e\u3059\u3002]"}, {"question": "\u30bd\u30fc\u30bb\u30fc\u30b8\u30d5\u30ea\u30c3\u30d7\u3067\u30bd\u30fc\u30bb\u30fc\u30b8\u304c\u6642\u3005\u4e88\u6e2c\u4e0d\u53ef\u80fd\u306b\u8df3\u306d\u8fd4\u308b\u7406\u7531\u306f\u4f55\u3067\u3059\u304b\u3002\u305d\u3057\u3066\u3001\u3069\u306e\u3088\u3046\u306b\u5b89\u5b9a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30bd\u30fc\u30bb\u30fc\u30b8\u30d5\u30ea\u30c3\u30d7\u3067\u4e88\u6e2c\u3067\u304d\u306a\u3044\u8df3\u306d\u8fd4\u308a\u306f\u3001\u9069\u5207\u306a\u7740\u5730\u89d2\u5ea6\u304c\u3068\u308c\u3066\u3044\u306a\u3044\u304b\u3001\u904e\u5270\u306a\u52e2\u3044\u304c\u3042\u308b\u3053\u3068\u304c\u539f\u56e0\u3068\u306a\u308b\u3053\u3068\u304c\u591a\u3044\u3067\u3059\u3002\u30bd\u30fc\u30bb\u30fc\u30b8\u3092\u5b89\u5b9a\u3055\u305b\u308b\u306b\u306f\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u7aef\u3067\u306f\u306a\u304f\u5e73\u3089\u306a\u9762\u3092\u72d9\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30bd\u30fc\u30bb\u30fc\u30b8\u304c\u98db\u3073\u8d8a\u3048\u3066\u3057\u307e\u3046\u5834\u5408\u306f\u3001\u30d5\u30ea\u30c3\u30d7\u306e\u529b\u3092\u6e1b\u3089\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u74b0\u5883\uff08\u58c1\u3084\u969c\u5bb3\u7269\u306a\u3069\uff09\u3092\u4f7f\u7528\u3057\u3066\u7740\u5730\u3092\u30af\u30c3\u30b7\u30e7\u30f3\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb7\u3067\u306f\u3001\u5de6\u5074\u306e\u58c1\u306b\u8df3\u306d\u8fd4\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u9ad8\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u5230\u9054\u3067\u304d\u307e\u3059\u3002[\u5bfe\u5fdc\u8868\uff1a\u9ad8\u3044\u30d1\u30ef\u30fc\uff1d\u8df3\u306d\u8fd4\u308a\u591a\uff1b\u4f4e\u3044\u30d1\u30ef\u30fc\uff1d\u6ed1\u3089\u304b\u306a\u7740\u5730\u3002]"}, {"question": "\u30bd\u30fc\u30bb\u30fc\u30b8\u30d5\u30ea\u30c3\u30d7\u306e\u521d\u671f\u30ec\u30d9\u30eb\u30673\u3064\u661f\u3092\u7372\u5f97\u3059\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u521d\u671f\u30ec\u30d9\u30eb\u30673\u3064\u661f\u3092\u7372\u5f97\u3059\u308b\u306b\u306f\u3001\u6b63\u78ba\u3055\u3068\u52b9\u7387\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30d5\u30ea\u30c3\u30d7\u56de\u6570\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u307e\u3059\u3002\u30d5\u30ea\u30c3\u30d7\u56de\u6570\u304c\u5c11\u306a\u3044\u307b\u3069\u3001\u30b9\u30b3\u30a2\u304c\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30dc\u30fc\u30ca\u30b9\u76ee\u6a19\uff08\u305f\u3068\u3048\u3070\u3001\u30b4\u30fc\u30eb\u30c7\u30f3\u30bd\u30fc\u30bb\u30fc\u30b8\uff09\u306b\u7740\u5730\u3057\u3066\u3001\u8ffd\u52a0\u70b9\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6642\u9593\u30dc\u30fc\u30ca\u30b9\u3092\u7372\u5f97\u3059\u308b\u305f\u3081\u306b\u3001\u30ec\u30d9\u30eb\u3092\u8fc5\u901f\u306b\u30af\u30ea\u30a2\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb5\u3067\u306f\u30011\u56de\u306e\u6b63\u78ba\u306a\u30d5\u30ea\u30c3\u30d7\u3067\u3001\u30b4\u30fc\u30eb\u30c7\u30f3\u30bd\u30fc\u30bb\u30fc\u30b8\u306e\u4e0a\u306b\u76f4\u63a5\u7740\u5730\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03\u8868\uff1a\u30aa\u30d7\u30b7\u30e7\u30f3A\uff1a\u5c0f\u3055\u306a\u30d5\u30ea\u30c3\u30d7\u3092\u8907\u6570\u56de\uff08\u30b9\u30b3\u30a2\u4f4e\uff09; \u30aa\u30d7\u30b7\u30e7\u30f3B\uff1a1\u56de\u306e\u5f37\u529b\u306a\u30d5\u30ea\u30c3\u30d7\uff08\u30b9\u30b3\u30a2\u9ad8\uff09\u3002]"}, {"question": "\u30bd\u30fc\u30bb\u30fc\u30b8\u30d5\u30ea\u30c3\u30d7\u3067\u9ad8\u5ea6\u306a\u30c0\u30d6\u30eb\u30d5\u30ea\u30c3\u30d7\u6280\u3092\u7fd2\u5f97\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30c0\u30d6\u30eb\u30d5\u30ea\u30c3\u30d7\u6280\u306f\u3001\u7a7a\u4e2d\u30672\u3064\u306e\u30d5\u30ea\u30c3\u30d7\u3092\u7e4b\u3052\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u9577\u3044\u8ddd\u96e2\u3068\u5236\u5fa1\u3092\u5b9f\u73fe\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u901a\u5e38\u3069\u304a\u308a\u6700\u521d\u306e\u30d5\u30ea\u30c3\u30d7\u3092\u5b9f\u884c\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6700\u521d\u306e\u30d5\u30ea\u30c3\u30d7\u306e\u6700\u9ad8\u70b9\u3067\u3001\u3059\u3050\u306b2\u756a\u76ee\u306e\u30d5\u30ea\u30c3\u30d7\u3092\u5145\u96fb\u3057\u3066\u30ea\u30ea\u30fc\u30b9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a2\u756a\u76ee\u306e\u30d5\u30ea\u30c3\u30d7\u4e2d\u306b\u89d2\u5ea6\u3092\u8abf\u6574\u3057\u3066\u3001\u7740\u5730\u3092\u5fae\u8abf\u6574\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb12\u3067\u306f\u3001\u30c0\u30d6\u30eb\u30d5\u30ea\u30c3\u30d7\u3067\u5e83\u3044\u30ae\u30e3\u30c3\u30d7\u3092\u30af\u30ea\u30a2\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u5145\u96fb\u2192\u30ea\u30ea\u30fc\u30b9\u2192\u30d4\u30fc\u30af\u2192\u5145\u96fb\u2192\u30ea\u30ea\u30fc\u30b9\u2192\u7740\u5730\u3002]"}, {"question": "\u30bd\u30fc\u30bb\u30fc\u30b8\u30d5\u30ea\u30c3\u30d7\u3067\u3001\u96e3\u3057\u3044\u30ec\u30d9\u30eb\u3067\u6709\u5229\u306b\u4f7f\u7528\u3067\u304d\u308b\u74b0\u5883\u8981\u7d20\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u58c1\u3001\u659c\u9762\u3001\u79fb\u52d5\u3059\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306a\u3069\u306e\u74b0\u5883\u8981\u7d20\u3092\u6226\u7565\u7684\u306b\u4f7f\u7528\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u58c1\u3092\u4f7f\u7528\u3057\u3066\u30bd\u30fc\u30bb\u30fc\u30b8\u306e\u8ecc\u9053\u3092\u5909\u66f4\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u659c\u9762\u3092\u4f7f\u7528\u3057\u3066\u8ffd\u52a0\u306e\u52e2\u3044\u3092\u5f97\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u79fb\u52d5\u3059\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u5408\u308f\u305b\u3066\u30d5\u30ea\u30c3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5408\u308f\u305b\u3001\u6b63\u78ba\u306b\u7740\u5730\u3055\u305b\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb15\u3067\u306f\u3001\u89d2\u5ea6\u306e\u3042\u308b\u58c1\u306b\u8df3\u306d\u8fd4\u308b\u3053\u3068\u3067\u3001\u96a0\u308c\u305f\u30a8\u30ea\u30a2\u306b\u5230\u9054\u3067\u304d\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u58c1\u3092\u30c8\u30e9\u30f3\u30dd\u30ea\u30f3\u3001\u659c\u9762\u3092\u30e9\u30f3\u30c1\u30e3\u30fc\u306e\u3088\u3046\u306b\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30bd\u30fc\u30bb\u30fc\u30b8\u30d5\u30ea\u30c3\u30d7\u306e\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306f\u4f55\u3067\u3059\u304b\u3002\u305d\u3057\u3066\u3001\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u306f\u3069\u306e\u3088\u3046\u306b\u8a08\u7b97\u3055\u308c\u307e\u3059\u304b\uff1f", "answer": "\u30bd\u30fc\u30bb\u30fc\u30b8\u30d5\u30ea\u30c3\u30d7\u306e\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d5\u30ea\u30c3\u30d7\u56de\u6570\u3001\u6240\u8981\u6642\u9593\u3001\u30dc\u30fc\u30ca\u30b9\u76ee\u6a19\u306e3\u3064\u306e\u8981\u7d20\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u5404\u30d5\u30ea\u30c3\u30d7\u3067\u30dd\u30a4\u30f3\u30c8\u306f\u6e1b\u5c11\u3057\u3001\u30af\u30ea\u30a2\u6642\u9593\u306e\u77ed\u7e2e\u3068\u30dc\u30fc\u30ca\u30b9\u76ee\u6a19\uff08\u305f\u3068\u3048\u3070\u3001\u30b4\u30fc\u30eb\u30c7\u30f3\u30bd\u30fc\u30bb\u30fc\u30b8\uff09\u3078\u306e\u7740\u5730\u306f\u30dd\u30a4\u30f3\u30c8\u3092\u5897\u3084\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb10\u3067\u3001\u8ffd\u52a0\u306e\u30d5\u30ea\u30c3\u30d7\u306a\u3057\u30673\u3064\u306e\u30b4\u30fc\u30eb\u30c7\u30f3\u30bd\u30fc\u30bb\u30fc\u30b8\u3059\u3079\u3066\u306b\u7740\u5730\u3059\u308c\u3070\u3001\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u3002[\u5bfe\u5fdc\u8868\uff1a\u30d5\u30ea\u30c3\u30d7\u56de\u6570\uff1a\u30d5\u30ea\u30c3\u30d71\u56de\u3042\u305f\u308a-10\u70b9; \u6642\u9593\u30dc\u30fc\u30ca\u30b9\uff1a30\u79d2\u672a\u6e80\uff0b100\u70b9\uff1b\u30b4\u30fc\u30eb\u30c7\u30f3\u30bd\u30fc\u30bb\u30fc\u30b8\uff1a\u54041\u3064\uff0b50\u70b9\u3002]"}, {"question": "\u30bd\u30fc\u30bb\u30fc\u30b8\u30d5\u30ea\u30c3\u30d7\u306e\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u306f\u3001\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30af\u30b9\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30bd\u30fc\u30bb\u30fc\u30b8\u30d5\u30ea\u30c3\u30d7\u306e\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u306f\u3001\u73fe\u5b9f\u7684\u306a\u52e2\u3044\u3001\u91cd\u529b\u3001\u885d\u7a81\u3092\u30b7\u30df\u30e5\u30ec\u30fc\u30c8\u3057\u307e\u3059\u3002\u52e2\u3044\u306f\u30bd\u30fc\u30bb\u30fc\u30b8\u306e\u79fb\u52d5\u8ddd\u96e2\u306b\u5f71\u97ff\u3057\u3001\u91cd\u529b\u306f\u964d\u4e0b\u901f\u5ea6\u3092\u6c7a\u5b9a\u3057\u3001\u885d\u7a81\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u8df3\u306d\u8fd4\u308a\u3068\u5b89\u5b9a\u6027\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb18\u3067\u306f\u3001\u30bd\u30fc\u30bb\u30fc\u30b8\u306e\u52e2\u3044\u3092\u9069\u5207\u306b\u5236\u5fa1\u3059\u308b\u3053\u3068\u3067\u3001\u969c\u5bb3\u7269\u3092\u8d85\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u30bd\u30fc\u30bb\u30fc\u30b8\u3092\u30b4\u30e0\u30dc\u30fc\u30eb\u3060\u3068\u8003\u3048\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u529b\u3068\u89d2\u5ea6\u306b\u5fdc\u3058\u3066\u8df3\u306d\u8fd4\u3063\u305f\u308a\u8ee2\u304c\u3063\u305f\u308a\u3057\u307e\u3059\u3002]"}, {"question": "\u30e2\u30d0\u30a4\u30eb\u3068PC\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u9593\u3067\u30bd\u30fc\u30bb\u30fc\u30b8\u30d5\u30ea\u30c3\u30d7\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30bd\u30fc\u30bb\u30fc\u30b8\u30d5\u30ea\u30c3\u30d7\u306f\u30af\u30e9\u30a6\u30c9\u30bb\u30fc\u30d6\u3092\u4f7f\u7528\u3057\u3066\u3001\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u9032\u884c\u72b6\u6cc1\u8ee2\u9001\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u4e21\u65b9\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u8a2d\u5b9a\u3067\u30af\u30e9\u30a6\u30c9\u540c\u671f\u3092\u6709\u52b9\u306b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u304c\u30a4\u30f3\u30bf\u30fc\u30cd\u30c3\u30c8\u306b\u63a5\u7d9a\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30e2\u30d0\u30a4\u30eb\u3067\u30ec\u30d9\u30eb20\u3092\u958b\u59cb\u3057\u305f\u5f8c\u306b\u3001PC\u3067\u30ec\u30d9\u30eb20\u3092\u7d9a\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u5bfe\u5fdc\u8868\uff1a\u30e2\u30d0\u30a4\u30eb\u2192PC\uff1a\u540c\u671f\u304c\u5fc5\u8981\u3067\u3059\uff1bPC\u2192\u30e2\u30d0\u30a4\u30eb\uff1a\u540c\u671f\u304c\u5fc5\u8981\u3067\u3059\u3002]"}, {"question": "\u30bd\u30fc\u30bb\u30fc\u30b8\u30d5\u30ea\u30c3\u30d7\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u30ec\u30d9\u30eb\u3084\u79d8\u5bc6\u306e\u30a8\u30ea\u30a2\u306f\u3042\u308a\u307e\u3059\u304b\uff1f\u305d\u308c\u3089\u306b\u30a2\u30af\u30bb\u30b9\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30bd\u30fc\u30bb\u30fc\u30b8\u30d5\u30ea\u30c3\u30d7\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u30ec\u30d9\u30eb\u3068\u79d8\u5bc6\u306e\u30a8\u30ea\u30a2\u304c\u3042\u308a\u307e\u3059\u3002\u305d\u308c\u3089\u306b\u30a2\u30af\u30bb\u30b9\u3059\u308b\u306b\u306f\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u7570\u5e38\u306a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u30d1\u30bf\u30fc\u30f3\u3084\u5c4a\u304b\u306a\u3044\u30a8\u30ea\u30a2\u3092\u63a2\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30c0\u30d6\u30eb\u30d5\u30ea\u30c3\u30d7\u3084\u58c1\u3078\u306e\u8df3\u306d\u8fd4\u308a\u306a\u3069\u3001\u9ad8\u5ea6\u306a\u30c6\u30af\u30cb\u30c3\u30af\u3092\u4f7f\u7528\u3057\u3066\u3001\u3053\u308c\u3089\u306e\u5834\u6240\u3078\u5230\u9054\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7279\u5b9a\u306e\u30c1\u30e3\u30ec\u30f3\u30b8\uff08\u305f\u3068\u3048\u3070\u3001\u30d5\u30ea\u30c3\u30d7\u306a\u3057\u3067\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\uff09\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3067\u3001\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb25\u3067\u306f\u3001\u3046\u307e\u304f\u5b9f\u884c\u3055\u308c\u305f\u30c0\u30d6\u30eb\u30d5\u30ea\u30c3\u30d7\u306b\u3088\u3063\u3066\u3001\u96a0\u3055\u308c\u305f\u30b4\u30fc\u30eb\u30c7\u30f3\u30bd\u30fc\u30bb\u30fc\u30b8\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u8ff7\u8def\u306e\u4e2d\u306e\u79d8\u5bc6\u306e\u90e8\u5c4b\u3092\u767a\u898b\u3059\u308b\u3088\u3046\u306b\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30bd\u30fc\u30bb\u30fc\u30b8\u30d5\u30ea\u30c3\u30d7\u306e\u901a\u5e38\u30e2\u30fc\u30c9\u3068\u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\u306e\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\u3001\u3069\u3061\u3089\u304c\u81ea\u5206\u306b\u5408\u3063\u3066\u3044\u307e\u3059\u304b\uff1f", "answer": "\u30bd\u30fc\u30bb\u30fc\u30b8\u30d5\u30ea\u30c3\u30d7\u306e\u901a\u5e38\u30e2\u30fc\u30c9\u306f\u3001\u30ea\u30e9\u30c3\u30af\u30b9\u3057\u305f\u7269\u7406\u3068\u8a31\u5bb9\u7684\u306a\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u3092\u63d0\u4f9b\u3057\u3001\u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\u306f\u3088\u308a\u53b3\u683c\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3068\u9ad8\u3044\u96e3\u6613\u5ea6\u3092\u5099\u3048\u3066\u3044\u307e\u3059\u3002\u901a\u5e38\u30e2\u30fc\u30c9\u306f\u3001\u521d\u5fc3\u8005\u3084\u30b9\u30c8\u30ec\u30b9\u306e\u306a\u3044\u7d4c\u9a13\u3092\u6c42\u3081\u308b\u4eba\u306b\u3068\u3063\u3066\u6700\u9069\u3067\u3042\u308a\u3001\u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\u306f\u7d4c\u9a13\u8c4a\u5bcc\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u6311\u6226\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\u3067\u306f\u3001\u30ec\u30d9\u30eb30\u306f\u3001\u30d4\u30af\u30bb\u30eb\u5358\u4f4d\u306e\u30d5\u30ea\u30c3\u30d7\u3092\u6b63\u78ba\u306b\u884c\u3046\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002[\u6bd4\u8f03\u8868\uff1a\u901a\u5e38\u30e2\u30fc\u30c9\uff1a\u7c21\u5358\u306a\u30d5\u30ea\u30c3\u30d7\u3001\u30da\u30ca\u30eb\u30c6\u30a3\u4f4e\uff1b\u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\uff1a\u6b63\u78ba\u306a\u30d5\u30ea\u30c3\u30d7\u3001\u30da\u30ca\u30eb\u30c6\u30a3\u9ad8\u3002]"}]
[{"question": "\u5982\u4f55\u8fdb\u884c\u9999\u80a0\u7ffb\u8f6c\u6e38\u620f\u7684\u57fa\u672c\u7ffb\u8f6c\u64cd\u4f5c\uff0c\u4ee5\u53ca\u521d\u5b66\u8005\u9700\u8981\u638c\u63e1\u54ea\u4e9b\u5173\u952e\u63a7\u5236\uff1f", "answer": "\u8981\u8fdb\u884c\u9999\u80a0\u7ffb\u8f6c\u6e38\u620f\u7684\u57fa\u672c\u7ffb\u8f6c\u64cd\u4f5c\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41\uff1a\u6309\u4f4f\u5c4f\u5e55\uff08\u6216\u9f20\u6807\u6309\u94ae\uff09\u6765\u84c4\u529b\u7ffb\u8f6c\u3002\u6b65\u9aa42\uff1a\u677e\u5f00\u4ee5\u6267\u884c\u7ffb\u8f6c\u3002\u5173\u952e\u63a7\u5236\u5305\u62ec\uff1a\u84c4\u529b\u65f6\u95f4\uff08\u51b3\u5b9a\u7ffb\u8f6c\u9ad8\u5ea6\uff09\u3001\u677e\u5f00\u65f6\u673a\uff08\u63a7\u5236\u65b9\u5411\uff09\u548c\u89d2\u5ea6\u8c03\u6574\uff08\u5fae\u8c03\u7740\u9646\uff09\u3002\u4f8b\u5982\uff0c\u57283\u7ea7\uff0c\u4e00\u4e2a\u65f6\u673a\u6070\u5230\u597d\u5904\u7684\u7ffb\u8f6c\u53ef\u4ee5\u5c06\u9999\u80a0\u5b8c\u7f8e\u5730\u843d\u5728\u5c0f\u5e73\u53f0\u4e0a\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u60f3\u8c61\u4e00\u4e0b\u62c9\u52a8\u5f39\u5f13\u2014\u2014\u4f60\u62c9\u5f97\u8d8a\u4e45\uff0c\u5b83\u98de\u5f97\u8d8a\u8fdc\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u7684\u9999\u80a0\u6709\u65f6\u4f1a\u5728\u9999\u80a0\u7ffb\u8f6c\u6e38\u620f\u4e2d\u5f39\u8df3\u5f97\u96be\u4ee5\u9884\u6d4b\uff0c\u4ee5\u53ca\u5982\u4f55\u4f7f\u5176\u7a33\u5b9a\uff1f", "answer": "\u9999\u80a0\u7ffb\u8f6c\u6e38\u620f\u4e2d\u96be\u4ee5\u9884\u6d4b\u7684\u5f39\u8df3\u901a\u5e38\u662f\u7531\u4e8e\u7740\u9646\u89d2\u5ea6\u4e0d\u5f53\u6216\u52a8\u91cf\u8fc7\u5927\u6240\u5bfc\u81f4\u7684\u3002\u8981\u4f7f\u9999\u80a0\u7a33\u5b9a\uff1a\u6b65\u9aa41\uff1a\u5c3d\u91cf\u7784\u51c6\u5e73\u5766\u7684\u8868\u9762\u800c\u4e0d\u662f\u8fb9\u7f18\u3002\u6b65\u9aa42\uff1a\u5982\u679c\u9999\u80a0\u8d85\u51fa\u76ee\u6807\uff0c\u8bf7\u51cf\u5c11\u7ffb\u8f6c\u529b\u5ea6\u3002\u6b65\u9aa43\uff1a\u5229\u7528\u73af\u5883\uff08\u4f8b\u5982\u5899\u58c1\u6216\u969c\u788d\u7269\uff09\u6765\u7f13\u51b2\u7740\u9646\u3002\u4f8b\u5982\uff0c\u57287\u7ea7\uff0c\u5f39\u8df3\u5230\u5de6\u4fa7\u5899\u58c1\u53ef\u4ee5\u5e2e\u52a9\u4f60\u5230\u8fbe\u66f4\u9ad8\u7684\u5e73\u53f0\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u9ad8\u529b\u91cf=\u66f4\u591a\u5f39\u8df3\uff1b\u4f4e\u529b\u91cf=\u66f4\u5e73\u7a33\u7684\u7740\u9646\u3002]"}, {"question": "\u5728\u9999\u80a0\u7ffb\u8f6c\u6e38\u620f\u7684\u65e9\u671f\u5173\u5361\u4e2d\uff0c\u5982\u4f55\u624d\u80fd\u53d6\u5f97\u4e09\u661f\u7684\u597d\u6210\u7ee9\uff1f", "answer": "\u5728\u65e9\u671f\u5173\u5361\u4e2d\u53d6\u5f97\u4e09\u661f\u7684\u597d\u6210\u7ee9\u9700\u8981\u7cbe\u786e\u548c\u9ad8\u6548\u7684\u64cd\u4f5c\u3002\u6b65\u9aa41\uff1a\u5c3d\u91cf\u51cf\u5c11\u7ffb\u8f6c\u6b21\u6570\u2014\u2014\u7ffb\u8f6c\u6b21\u6570\u8d8a\u5c11\uff0c\u5f97\u5206\u8d8a\u9ad8\u3002\u6b65\u9aa42\uff1a\u843d\u5728\u5956\u52b1\u76ee\u6807\u7269\uff08\u4f8b\u5982\u91d1\u8272\u9999\u80a0\uff09\u4e0a\u4ee5\u83b7\u5f97\u989d\u5916\u5206\u6570\u3002\u6b65\u9aa43\uff1a\u5feb\u901f\u5b8c\u6210\u5173\u5361\u4ee5\u83b7\u5f97\u65f6\u95f4\u5956\u52b1\u3002\u4f8b\u5982\uff0c\u57285\u7ea7\uff0c\u4e00\u4e2a\u7cbe\u786e\u7684\u7ffb\u8f6c\u53ef\u4ee5\u8ba9\u4f60\u76f4\u63a5\u843d\u5728\u91d1\u8272\u9999\u80a0\u4e0a\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u65b9\u6848A\uff1a\u591a\u6b21\u5c0f\u7ffb\u8f6c\uff08\u5f97\u5206\u8f83\u4f4e\uff09\uff1b\u65b9\u6848B\uff1a\u4e00\u6b21\u5f3a\u529b\u7ffb\u8f6c\uff08\u5f97\u5206\u8f83\u9ad8\uff09\u3002]"}, {"question": "\u5982\u4f55\u638c\u63e1\u9999\u80a0\u7ffb\u8f6c\u6e38\u620f\u4e2d\u7684\u9ad8\u7ea7\u53cc\u91cd\u7ffb\u8f6c\u6280\u5de7\uff1f", "answer": "\u53cc\u91cd\u7ffb\u8f6c\u6280\u5de7\u5305\u62ec\u5728\u7a7a\u4e2d\u8fde\u7eed\u8fdb\u884c\u4e24\u6b21\u7ffb\u8f6c\uff0c\u4ee5\u83b7\u5f97\u66f4\u8fdc\u7684\u8ddd\u79bb\u548c\u66f4\u597d\u7684\u63a7\u5236\u529b\u3002\u6b65\u9aa41\uff1a\u50cf\u5f80\u5e38\u4e00\u6837\u5b8c\u6210\u7b2c\u4e00\u6b21\u7ffb\u8f6c\u3002\u6b65\u9aa42\uff1a\u5728\u7b2c\u4e00\u6b21\u7ffb\u8f6c\u8fbe\u5230\u9876\u5cf0\u65f6\uff0c\u8fc5\u901f\u84c4\u529b\u5e76\u91ca\u653e\u7b2c\u4e8c\u6b21\u7ffb\u8f6c\u3002\u6b65\u9aa43\uff1a\u5728\u7b2c\u4e8c\u6b21\u7ffb\u8f6c\u671f\u95f4\u8c03\u6574\u89d2\u5ea6\uff0c\u4ee5\u5fae\u8c03\u7740\u9646\u4f4d\u7f6e\u3002\u4f8b\u5982\uff0c\u572812\u7ea7\uff0c\u53cc\u91cd\u7ffb\u8f6c\u53ef\u4ee5\u5e2e\u52a9\u4f60\u8de8\u8d8a\u5bbd\u9614\u7684\u95f4\u9699\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u84c4\u529b\u2192\u91ca\u653e\u2192\u9876\u5cf0\u2192\u84c4\u529b\u2192\u91ca\u653e\u2192\u7740\u9646\u3002]"}, {"question": "\u5728\u9999\u80a0\u7ffb\u8f6c\u6e38\u620f\u4e2d\uff0c\u54ea\u4e9b\u73af\u5883\u5143\u7d20\u53ef\u4ee5\u7528\u6765\u5e94\u5bf9\u68d8\u624b\u7684\u5173\u5361\uff1f", "answer": "\u73af\u5883\u5143\u7d20\uff0c\u4f8b\u5982\u5899\u58c1\u3001\u659c\u5761\u548c\u79fb\u52a8\u5e73\u53f0\uff0c\u53ef\u4ee5\u88ab\u6218\u7565\u6027\u5730\u5229\u7528\u3002\u6b65\u9aa41\uff1a\u4f7f\u7528\u5899\u58c1\u6765\u6539\u53d8\u9999\u80a0\u7684\u8f68\u8ff9\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u659c\u5761\u6765\u83b7\u5f97\u989d\u5916\u7684\u52a8\u91cf\u3002\u6b65\u9aa43\uff1a\u4e0e\u79fb\u52a8\u5e73\u53f0\u540c\u6b65\u4f60\u7684\u7ffb\u8f6c\u52a8\u4f5c\uff0c\u4ee5\u5b9e\u73b0\u7cbe\u786e\u7684\u7740\u9646\u3002\u4f8b\u5982\uff0c\u572815\u7ea7\uff0c\u5f39\u8df3\u5230\u503e\u659c\u7684\u5899\u58c1\u53ef\u4ee5\u5e2e\u52a9\u4f60\u5230\u8fbe\u9690\u85cf\u533a\u57df\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u628a\u5899\u58c1\u60f3\u8c61\u6210\u8e66\u5e8a\uff0c\u659c\u5761\u60f3\u8c61\u6210\u53d1\u5c04\u5761\u9053\u3002]"}, {"question": "\u9999\u80a0\u7ffb\u8f6c\u6e38\u620f\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5982\u4f55\u8ba1\u7b97\u5956\u52b1\u5206\u6570\uff1f", "answer": "\u9999\u80a0\u7ffb\u8f6c\u6e38\u620f\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u4e09\u4e2a\u56e0\u7d20\uff1a\u7ffb\u8f6c\u6b21\u6570\u3001\u5b8c\u6210\u65f6\u95f4\u548c\u5956\u52b1\u76ee\u6807\u3002\u6bcf\u6b21\u7ffb\u8f6c\u90fd\u4f1a\u6263\u9664\u5206\u6570\uff0c\u800c\u66f4\u5feb\u7684\u5b8c\u6210\u65f6\u95f4\u548c\u843d\u5728\u5956\u52b1\u76ee\u6807\uff08\u4f8b\u5982\u91d1\u8272\u9999\u80a0\uff09\u4e0a\u90fd\u4f1a\u589e\u52a0\u5206\u6570\u3002\u4f8b\u5982\uff0c\u572810\u7ea7\uff0c\u5728\u4e0d\u989d\u5916\u7ffb\u8f6c\u7684\u60c5\u51b5\u4e0b\u843d\u5728\u6240\u6709\u4e09\u4e2a\u91d1\u8272\u9999\u80a0\u4e0a\u53ef\u4ee5\u6700\u5927\u5316\u4f60\u7684\u5f97\u5206\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u7ffb\u8f6c\u6b21\u6570\uff1a\u6bcf\u6b21\u7ffb\u8f6c\u6263\u966410\u5206\uff1b\u65f6\u95f4\u5956\u52b1\uff1a\u5b8c\u6210\u65f6\u95f4\u5c11\u4e8e30\u79d2\u989d\u5916\u52a0100\u5206\uff1b\u91d1\u8272\u9999\u80a0\uff1a\u6bcf\u4e2a\u52a050\u5206\u3002]"}, {"question": "\u9999\u80a0\u7ffb\u8f6c\u6e38\u620f\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u673a\u5236\uff1f", "answer": "\u9999\u80a0\u7ffb\u8f6c\u6e38\u620f\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u6a21\u62df\u4e86\u73b0\u5b9e\u7684\u52a8\u91cf\u3001\u91cd\u529b\u548c\u78b0\u649e\u3002\u52a8\u91cf\u4f1a\u5f71\u54cd\u4f60\u9999\u80a0\u7684\u98de\u884c\u8ddd\u79bb\uff0c\u91cd\u529b\u51b3\u5b9a\u4e0b\u843d\u901f\u5ea6\uff0c\u78b0\u649e\u673a\u5236\u4f1a\u5f71\u54cd\u5f39\u8df3\u548c\u7a33\u5b9a\u6027\u3002\u4f8b\u5982\uff0c\u572818\u7ea7\uff0c\u5982\u679c\u65f6\u673a\u628a\u63e1\u5f97\u5f53\uff0c\u9999\u80a0\u7684\u52a8\u91cf\u53ef\u4ee5\u5e2e\u52a9\u5b83\u8d8a\u8fc7\u969c\u788d\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u60f3\u8c61\u4e00\u4e0b\u9999\u80a0\u50cf\u4e00\u4e2a\u6a61\u80f6\u7403\u2014\u2014\u5b83\u6839\u636e\u529b\u4e0e\u89d2\u5ea6\u53cd\u5f39\u548c\u6eda\u52a8\u3002]"}, {"question": "\u6211\u53ef\u4ee5\u5728\u79fb\u52a8\u5e73\u53f0\u548cPC\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u6211\u7684\u9999\u80a0\u7ffb\u8f6c\u6e38\u620f\u8fdb\u5ea6\u5417\uff1f", "answer": "\u662f\u7684\uff0c\u9999\u80a0\u7ffb\u8f6c\u6e38\u620f\u652f\u6301\u901a\u8fc7\u4e91\u7aef\u4fdd\u5b58\u8de8\u5e73\u53f0\u8fdb\u5ea6\u8f6c\u79fb\u3002\u6b65\u9aa41\uff1a\u5728\u4e24\u4e2a\u5e73\u53f0\u4e0a\u767b\u5f55\u540c\u4e00\u4e2a\u8d26\u6237\u3002\u6b65\u9aa42\uff1a\u5728\u8bbe\u7f6e\u4e2d\u542f\u7528\u4e91\u540c\u6b65\u3002\u6b65\u9aa43\uff1a\u786e\u4fdd\u4e24\u4e2a\u8bbe\u5907\u90fd\u8fde\u63a5\u5230\u4e92\u8054\u7f51\u3002\u4f8b\u5982\uff0c\u4f60\u53ef\u4ee5\u5728\u624b\u673a\u4e0a\u5f00\u59cb\u73a920\u7ea7\u540e\uff0c\u5728\u7535\u8111\u4e0a\u7ee7\u7eed\u6e38\u620f\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u79fb\u52a8\u7aef\u2192PC\u7aef\uff1a\u9700\u8981\u540c\u6b65\uff1bPC\u7aef\u2192\u79fb\u52a8\u7aef\uff1a\u9700\u8981\u540c\u6b65\u3002]"}, {"question": "\u9999\u80a0\u7ffb\u8f6c\u6e38\u620f\u4e2d\u6709\u9690\u85cf\u5173\u5361\u6216\u79d8\u5bc6\u533a\u57df\u5417\uff0c\u5982\u4f55\u8bbf\u95ee\u5b83\u4eec\uff1f", "answer": "\u662f\u7684\uff0c\u9999\u80a0\u7ffb\u8f6c\u6e38\u620f\u4e2d\u6709\u9690\u85cf\u5173\u5361\u548c\u79d8\u5bc6\u533a\u57df\u3002\u8981\u8bbf\u95ee\u5b83\u4eec\uff1a\u6b65\u9aa41\uff1a\u5bfb\u627e\u4e0d\u5bfb\u5e38\u7684\u5e73\u53f0\u56fe\u6848\u6216\u89e6\u53ca\u4e0d\u5230\u7684\u533a\u57df\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u9ad8\u7ea7\u6280\u5de7\uff0c\u4f8b\u5982\u53cc\u91cd\u7ffb\u8f6c\u6216\u5899\u58c1\u5f39\u8df3\uff0c\u6765\u5230\u8fbe\u8fd9\u4e9b\u4f4d\u7f6e\u3002\u6b65\u9aa43\uff1a\u5b8c\u6210\u7279\u5b9a\u6311\u6218\uff08\u4f8b\u5982\uff0c\u5728\u4e0d\u7ffb\u8f6c\u7684\u60c5\u51b5\u4e0b\u5b8c\u6210\u4e00\u4e2a\u5173\u5361\uff09\u4ee5\u89e3\u9501\u9690\u85cf\u5185\u5bb9\u3002\u4f8b\u5982\uff0c\u572825\u7ea7\uff0c\u4e00\u6b21\u6267\u884c\u5f97\u5f53\u7684\u53cc\u91cd\u7ffb\u8f6c\u53ef\u4ee5\u63ed\u793a\u9690\u85cf\u7684\u91d1\u8272\u9999\u80a0\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u60f3\u8c61\u4e00\u4e0b\u5728\u8ff7\u5bab\u4e2d\u53d1\u73b0\u4e00\u4e2a\u79d8\u5bc6\u623f\u95f4\u3002]"}, {"question": "\u9999\u80a0\u7ffb\u8f6c\u6e38\u620f\u7684\u4f11\u95f2\u6a21\u5f0f\u4e0e\u786c\u6838\u6a21\u5f0f\u6709\u4ec0\u4e48\u533a\u522b\uff0c\u54ea\u79cd\u6a21\u5f0f\u66f4\u9002\u5408\u6211\uff1f", "answer": "\u9999\u80a0\u7ffb\u8f6c\u6e38\u620f\u7684\u4f11\u95f2\u6a21\u5f0f\u63d0\u4f9b\u8f7b\u677e\u7684\u7269\u7406\u6548\u679c\u548c\u5bbd\u677e\u7684\u8bc4\u5206\uff0c\u800c\u786c\u6838\u6a21\u5f0f\u5219\u5177\u6709\u66f4\u4e25\u683c\u7684\u6e38\u620f\u673a\u5236\u548c\u66f4\u9ad8\u7684\u96be\u5ea6\u3002\u4f11\u95f2\u6a21\u5f0f\u9002\u5408\u521d\u5b66\u8005\u6216\u5bfb\u6c42\u8f7b\u677e\u4f53\u9a8c\u7684\u7528\u6237\uff0c\u800c\u786c\u6838\u6a21\u5f0f\u5219\u6311\u6218\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u3002\u4f8b\u5982\uff0c\u5728\u786c\u6838\u6a21\u5f0f\u4e2d\uff0c30\u7ea7\u9700\u8981\u8fdb\u884c\u7cbe\u786e\u5230\u50cf\u7d20\u7684\u7ffb\u8f6c\u624d\u80fd\u6210\u529f\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u4f11\u95f2\u6a21\u5f0f\uff1a\u8f7b\u677e\u7ffb\u8f6c\uff0c\u60e9\u7f5a\u8f83\u4f4e\uff1b\u786c\u6838\u6a21\u5f0f\uff1a\u7cbe\u786e\u7ffb\u8f6c\uff0c\u60e9\u7f5a\u8f83\u9ad8\u3002]"}]
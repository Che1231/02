[{"question": "\u5982\u4f55\u57f7\u884c\u9999\u8178\u7ffb\u6efe\u904a\u6232\u7684\u57fa\u672c\u7ffb\u8f49\u52d5\u4f5c\uff0c\u4ee5\u53ca\u521d\u5b78\u8005\u7684\u4e3b\u8981\u63a7\u5236\u65b9\u5f0f\u70ba\u4f55\uff1f", "answer": "\u8981\u57f7\u884c\u9999\u8178\u7ffb\u6efe\u904a\u6232\u7684\u57fa\u672c\u7ffb\u8f49\u52d5\u4f5c\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u6309\u4f4f\u87a2\u5e55 (\u6216\u6ed1\u9f20\u6309\u9215) \u4f86\u84c4\u529b\u7ffb\u8f49\u3002\u6b65\u9a5f2\uff1a\u91cb\u653e\u4ee5\u57f7\u884c\u7ffb\u8f49\u52d5\u4f5c\u3002\u4e3b\u8981\u63a7\u5236\u65b9\u5f0f\u5305\u62ec\uff1a\u84c4\u529b\u6642\u9593 (\u6c7a\u5b9a\u7ffb\u8f49\u9ad8\u5ea6)\u3001\u91cb\u653e\u6642\u9593 (\u63a7\u5236\u65b9\u5411) \u4ee5\u53ca\u89d2\u5ea6\u8abf\u6574 (\u5fae\u8abf\u8457\u9678)\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 3 \u95dc\uff0c\u6e96\u78ba\u7684\u7ffb\u8f49\u52d5\u4f5c\u53ef\u4ee5\u5c07\u9999\u8178\u5b8c\u7f8e\u5730\u8457\u9678\u5728\u5c0f\u5e73\u53f0\u4e0a\u3002 [\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4e00\u4e0b\u62c9\u52d5\u5f48\u5f13 \u2013 \u4f60\u62c9\u5f97\u8d8a\u4e45\uff0c\u5f48\u5f13\u7684\u8ddd\u96e2\u5c31\u8d8a\u9060\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u7684\u9999\u8178\u5728\u9999\u8178\u7ffb\u6efe\u904a\u6232\u4e2d\u6709\u6642\u6703\u51fa\u73fe\u7121\u6cd5\u9810\u6e2c\u7684\u5f48\u8df3\uff0c\u4ee5\u53ca\u5982\u4f55\u4f7f\u5176\u7a69\u5b9a\u4e0b\u4f86\uff1f", "answer": "\u9999\u8178\u7ffb\u6efe\u904a\u6232\u4e2d\u7121\u6cd5\u9810\u6e2c\u7684\u5f48\u8df3\u901a\u5e38\u662f\u7531\u65bc\u8457\u9678\u89d2\u5ea6\u4e0d\u6b63\u78ba\u6216\u52d5\u91cf\u904e\u5927\u6240\u5c0e\u81f4\u3002\u8981\u7a69\u5b9a\u4f60\u7684\u9999\u8178\uff1a\u6b65\u9a5f1\uff1a\u7784\u6e96\u5e73\u5766\u7684\u8868\u9762\uff0c\u800c\u4e0d\u662f\u908a\u7de3\u3002\u6b65\u9a5f2\uff1a\u5982\u679c\u9999\u8178\u8d85\u51fa\u9810\u671f\uff0c\u8acb\u964d\u4f4e\u7ffb\u8f49\u529b\u9053\u3002\u6b65\u9a5f3\uff1a\u5229\u7528\u74b0\u5883 (\u4f8b\u5982\u7246\u58c1\u6216\u969c\u7919\u7269) \u4f86\u7de9\u885d\u8457\u9678\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 7 \u95dc\uff0c\u5f48\u8df3\u5230\u5de6\u7246\u53ef\u4ee5\u5e6b\u52a9\u4f60\u5230\u9054\u66f4\u9ad8\u7684\u5e73\u53f0\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u9ad8\u529b\u91cf = \u66f4\u5927\u7684\u5f48\u8df3\uff1b\u4f4e\u529b\u91cf = \u66f4\u5e73\u7a69\u7684\u8457\u9678\u3002]"}, {"question": "\u5728\u9999\u8178\u7ffb\u6efe\u904a\u6232\u7684\u65e9\u671f\u95dc\u5361\u4e2d\uff0c\u7372\u5f97\u4e09\u661f\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u65e9\u671f\u95dc\u5361\u4e2d\u7372\u5f97\u4e09\u661f\u9700\u8981\u7cbe\u78ba\u6027\u548c\u6548\u7387\u3002\u6b65\u9a5f1\uff1a\u5c07\u7ffb\u8f49\u6b21\u6578\u6e1b\u81f3\u6700\u5c11 \u2013 \u7ffb\u8f49\u6b21\u6578\u8d8a\u5c11\uff0c\u5206\u6578\u8d8a\u9ad8\u3002\u6b65\u9a5f2\uff1a\u8457\u9678\u65bc\u734e\u52f5\u76ee\u6a19 (\u4f8b\u5982\u91d1\u9999\u8178) \u4ee5\u7372\u5f97\u984d\u5916\u5206\u6578\u3002\u6b65\u9a5f3\uff1a\u5feb\u901f\u5b8c\u6210\u95dc\u5361\u4ee5\u7372\u5f97\u6642\u9593\u734e\u52f5\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 5 \u95dc\uff0c\u4e00\u6b21\u7cbe\u6e96\u7684\u7ffb\u8f49\u53ef\u4ee5\u8b93\u4f60\u76f4\u63a5\u8457\u9678\u5728\u91d1\u9999\u8178\u4e0a\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u9078\u9805 A\uff1a\u591a\u6b21\u5c0f\u7ffb\u8f49 (\u5206\u6578\u8f03\u4f4e)\uff1b\u9078\u9805 B\uff1a\u4e00\u6b21\u5f37\u529b\u7684\u7ffb\u8f49 (\u5206\u6578\u8f03\u9ad8)\u3002]"}, {"question": "\u5982\u4f55\u5728\u9999\u8178\u7ffb\u6efe\u904a\u6232\u4e2d\u638c\u63e1\u9032\u968e\u7684\u96d9\u91cd\u7ffb\u8f49\u6280\u5de7\uff1f", "answer": "\u96d9\u91cd\u7ffb\u8f49\u6280\u5de7\u5305\u62ec\u5728\u7a7a\u4e2d\u9023\u7e8c\u9032\u884c\u5169\u500b\u7ffb\u8f49\u52d5\u4f5c\uff0c\u4ee5\u7372\u5f97\u66f4\u9577\u7684\u8ddd\u96e2\u548c\u63a7\u5236\u529b\u3002\u6b65\u9a5f1\uff1a\u50cf\u5f80\u5e38\u4e00\u6a23\u57f7\u884c\u7b2c\u4e00\u6b21\u7ffb\u8f49\u3002\u6b65\u9a5f2\uff1a\u5728\u7b2c\u4e00\u6b21\u7ffb\u8f49\u7684\u9802\u5cf0\uff0c\u5feb\u901f\u84c4\u529b\u548c\u91cb\u653e\u7b2c\u4e8c\u6b21\u7ffb\u8f49\u3002\u6b65\u9a5f3\uff1a\u5728\u7b2c\u4e8c\u6b21\u7ffb\u8f49\u671f\u9593\u8abf\u6574\u89d2\u5ea6\uff0c\u4ee5\u5fae\u8abf\u8457\u9678\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 12 \u95dc\uff0c\u96d9\u91cd\u7ffb\u8f49\u53ef\u4ee5\u5e6b\u52a9\u4f60\u8de8\u8d8a\u5bec\u95ca\u7684\u9593\u9699\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u84c4\u529b \u2192 \u91cb\u653e \u2192 \u9802\u5cf0 \u2192 \u84c4\u529b \u2192 \u91cb\u653e \u2192 \u8457\u9678\u3002]"}, {"question": "\u5728\u9999\u8178\u7ffb\u6efe\u904a\u6232\u4e2d\uff0c\u54ea\u4e9b\u74b0\u5883\u5143\u7d20\u53ef\u4ee5\u7528\u65bc\u6280\u5de7\u6027\u95dc\u5361\uff1f", "answer": "\u74b0\u5883\u5143\u7d20\uff0c\u4f8b\u5982\u7246\u58c1\u3001\u659c\u5761\u548c\u79fb\u52d5\u5e73\u53f0\uff0c\u53ef\u4ee5\u88ab\u7b56\u7565\u6027\u5730\u5229\u7528\u3002\u6b65\u9a5f1\uff1a\u5229\u7528\u7246\u58c1\u4f86\u6539\u8b8a\u4f60\u7684\u9999\u8178\u7684\u8ecc\u8de1\u3002\u6b65\u9a5f2\uff1a\u5229\u7528\u659c\u5761\u4f86\u7372\u5f97\u984d\u5916\u7684\u52d5\u91cf\u3002\u6b65\u9a5f3\uff1a\u8207\u79fb\u52d5\u5e73\u53f0\u540c\u6b65\u4f60\u7684\u7ffb\u8f49\u52d5\u4f5c\uff0c\u4ee5\u6e96\u78ba\u8457\u9678\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 15 \u95dc\uff0c\u5f48\u8df3\u5230\u50be\u659c\u7684\u7246\u58c1\u53ef\u4ee5\u5e6b\u52a9\u4f60\u5230\u9054\u96b1\u85cf\u5340\u57df\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4e00\u4e0b\u7246\u58c1\u662f\u5f48\u8df3\u677f\uff0c\u659c\u5761\u662f\u767c\u5c04\u5761\u9053\u3002]"}, {"question": "\u9999\u8178\u7ffb\u6efe\u904a\u6232\u7684\u5206\u6578\u7cfb\u7d71\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5982\u4f55\u8a08\u7b97\u734e\u52f5\u5206\u6578\uff1f", "answer": "\u9999\u8178\u7ffb\u6efe\u904a\u6232\u7684\u5206\u6578\u7cfb\u7d71\u57fa\u65bc\u4e09\u500b\u56e0\u7d20\uff1a\u7ffb\u8f49\u6b21\u6578\u3001\u5b8c\u6210\u6642\u9593\u548c\u734e\u52f5\u76ee\u6a19\u3002\u6bcf\u4e00\u6b21\u7ffb\u8f49\u90fd\u6703\u6263\u9664\u5206\u6578\uff0c\u800c\u66f4\u5feb\u7684\u5b8c\u6210\u6642\u9593\u548c\u8457\u9678\u65bc\u734e\u52f5\u76ee\u6a19 (\u4f8b\u5982\u91d1\u9999\u8178) \u5c07\u6703\u52a0\u5206\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 10 \u95dc\uff0c\u5728\u6c92\u6709\u984d\u5916\u7ffb\u8f49\u7684\u60c5\u6cc1\u4e0b\u8457\u9678\u65bc\u6240\u6709\u4e09\u500b\u91d1\u9999\u8178\u53ef\u4ee5\u6700\u5927\u5316\u4f60\u7684\u5206\u6578\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u7ffb\u8f49\u6b21\u6578\uff1a\u6bcf\u6b21\u7ffb\u8f49\u6263\u9664 10 \u5206\uff1b\u6642\u9593\u734e\u52f5\uff1a\u5b8c\u6210\u6642\u9593\u5c0f\u65bc 30 \u79d2\u53ef\u7372\u5f97 100 \u5206\uff1b\u91d1\u9999\u8178\uff1a\u6bcf\u500b\u91d1\u9999\u8178\u52a0 50 \u5206\u3002]"}, {"question": "\u9999\u8178\u7ffb\u6efe\u904a\u6232\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u5982\u4f55\u5f71\u97ff\u904a\u6232\u6a5f\u5236\uff1f", "answer": "\u9999\u8178\u7ffb\u6efe\u904a\u6232\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u6a21\u64ec\u73fe\u5be6\u7684\u52d5\u91cf\u3001\u91cd\u529b\u548c\u78b0\u649e\u3002\u52d5\u91cf\u5f71\u97ff\u4f60\u7684\u9999\u8178\u79fb\u52d5\u7684\u8ddd\u96e2\uff0c\u91cd\u529b\u6c7a\u5b9a\u4e0b\u964d\u7684\u901f\u5ea6\uff0c\u800c\u78b0\u649e\u6a5f\u5236\u5f71\u97ff\u5f48\u8df3\u548c\u7a69\u5b9a\u6027\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 18 \u95dc\uff0c\u5982\u679c\u6642\u9593\u6e96\u78ba\uff0c\u9999\u8178\u7684\u52d5\u91cf\u53ef\u4ee5\u628a\u5b83\u63a8\u904e\u969c\u7919\u7269\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4e00\u4e0b\u9999\u8178\u50cf\u4e00\u500b\u6a61\u76ae\u7403 \u2013 \u5b83\u6703\u6839\u64da\u529b\u9053\u548c\u89d2\u5ea6\u5f48\u8df3\u548c\u6efe\u52d5\u3002]"}, {"question": "\u6211\u53ef\u4ee5\u5728\u624b\u6a5f\u548c\u5e73\u677f\u96fb\u8166\u5e73\u53f0\u4e4b\u9593\u8f49\u79fb\u6211\u7684\u9999\u8178\u7ffb\u6efe\u904a\u6232\u9032\u5ea6\u55ce\uff1f", "answer": "\u662f\u7684\uff0c\u9999\u8178\u7ffb\u6efe\u904a\u6232\u652f\u63f4\u900f\u904e\u96f2\u7aef\u5132\u5b58\u4f86\u8f49\u79fb\u8de8\u5e73\u53f0\u9032\u5ea6\u3002\u6b65\u9a5f1\uff1a\u5728\u5169\u500b\u5e73\u53f0\u4e0a\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u3002\u6b65\u9a5f2\uff1a\u5728\u8a2d\u5b9a\u4e2d\u555f\u7528\u96f2\u7aef\u540c\u6b65\u3002\u6b65\u9a5f3\uff1a\u78ba\u4fdd\u5169\u500b\u88dd\u7f6e\u90fd\u9023\u63a5\u5230\u7db2\u8def\u3002\u4f8b\u5982\uff0c\u4f60\u53ef\u4ee5\u5728\u624b\u6a5f\u4e0a\u958b\u59cb\u73a9\u7b2c 20 \u95dc\u5f8c\u7e7c\u7e8c\u5728\u4f60\u7684\u96fb\u8166\u4e0a\u73a9\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u624b\u6a5f \u2192 \u96fb\u8166\uff1a\u9700\u8981\u540c\u6b65\uff1b\u96fb\u8166 \u2192 \u624b\u6a5f\uff1a\u9700\u8981\u540c\u6b65\u3002]"}, {"question": "\u9999\u8178\u7ffb\u6efe\u904a\u6232\u4e2d\u662f\u5426\u6709\u4efb\u4f55\u96b1\u85cf\u95dc\u5361\u6216\u79d8\u5bc6\u5340\u57df\uff0c\u4ee5\u53ca\u5982\u4f55\u9032\u5165\uff1f", "answer": "\u662f\u7684\uff0c\u9999\u8178\u7ffb\u6efe\u904a\u6232\u4e2d\u6709\u96b1\u85cf\u95dc\u5361\u548c\u79d8\u5bc6\u5340\u57df\u3002\u8981\u9032\u5165\u9019\u4e9b\u5340\u57df\uff1a\u6b65\u9a5f1\uff1a\u5c0b\u627e\u4e0d\u5c0b\u5e38\u7684\u5e73\u53f0\u6a23\u5f0f\u6216\u7121\u6cd5\u89f8\u53ca\u7684\u5340\u57df\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u9032\u968e\u6280\u5de7\uff0c\u4f8b\u5982\u96d9\u91cd\u7ffb\u8f49\u6216\u7246\u58c1\u5f48\u8df3\u4f86\u5230\u9054\u9019\u4e9b\u4f4d\u7f6e\u3002\u6b65\u9a5f3\uff1a\u5b8c\u6210\u7279\u5b9a\u6311\u6230 (\u4f8b\u5982\uff0c\u5728\u4e0d\u7ffb\u8f49\u7684\u60c5\u6cc1\u4e0b\u5b8c\u6210\u4e00\u500b\u95dc\u5361) \u4ee5\u89e3\u9396\u96b1\u85cf\u5167\u5bb9\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 25 \u95dc\uff0c\u4e00\u6b21\u6210\u529f\u7684\u96d9\u91cd\u7ffb\u8f49\u53ef\u4ee5\u63ed\u9732\u4e00\u500b\u96b1\u85cf\u7684\u91d1\u9999\u8178\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4e00\u4e0b\u5728\u8ff7\u5bae\u4e2d\u767c\u73fe\u4e00\u500b\u79d8\u5bc6\u623f\u9593\u3002]"}, {"question": "\u9999\u8178\u7ffb\u6efe\u904a\u6232\u7684\u4f11\u9592\u6a21\u5f0f\u548c\u786c\u6838\u6a21\u5f0f\u4e4b\u9593\u6709\u4ec0\u9ebc\u4e0d\u540c\uff0c\u54ea\u500b\u66f4\u9069\u5408\u6211\uff1f", "answer": "\u9999\u8178\u7ffb\u6efe\u904a\u6232\u4e2d\u7684\u4f11\u9592\u6a21\u5f0f\u63d0\u4f9b\u653e\u9b06\u7684\u7269\u7406\u7279\u6027\u548c\u5bec\u5bb9\u7684\u5206\u6578\u8a08\u7b97\uff0c\u800c\u786c\u6838\u6a21\u5f0f\u5247\u63d0\u4f9b\u66f4\u56b4\u683c\u7684\u904a\u6232\u6a5f\u5236\u548c\u66f4\u9ad8\u7684\u96e3\u5ea6\u3002\u4f11\u9592\u6a21\u5f0f\u9069\u5408\u521d\u5b78\u8005\u6216\u90a3\u4e9b\u60f3\u8981\u8f15\u9b06\u9ad4\u9a57\u7684\u4eba\uff0c\u800c\u786c\u6838\u6a21\u5f0f\u5247\u6311\u6230\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u3002\u4f8b\u5982\uff0c\u5728\u786c\u6838\u6a21\u5f0f\u4e2d\uff0c\u7b2c 30 \u95dc\u9700\u8981\u7cbe\u78ba\u7121\u8aa4\u7684\u7ffb\u8f49\u624d\u80fd\u6210\u529f\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u4f11\u9592\u6a21\u5f0f\uff1a\u7ffb\u8f49\u5bb9\u6613\uff0c\u61f2\u7f70\u8f03\u4f4e\uff1b\u786c\u6838\u6a21\u5f0f\uff1a\u7ffb\u8f49\u7cbe\u78ba\uff0c\u61f2\u7f70\u8f03\u9ad8\u3002]"}]
[{"question": "\uc18c\uc2dc\uc9c0 \ud50c\ub9bd\uc5d0\uc11c \uae30\ubcf8 \ud50c\ub9bd\uc744 \uc5b4\ub5bb\uac8c \uc218\ud589\ud558\uba70 \ucd08\ubcf4\uc790\ub97c \uc704\ud55c \uc8fc\uc694 \ucee8\ud2b8\ub864\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc18c\uc2dc\uc9c0 \ud50c\ub9bd\uc5d0\uc11c \uae30\ubcf8 \ud50c\ub9bd\uc744 \uc218\ud589\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. STEP1: \ud654\uba74(\ub610\ub294 \ub9c8\uc6b0\uc2a4 \ubc84\ud2bc)\uc744 \ub20c\ub7ec \ud50c\ub9bd\uc744 \ucda9\uc804\ud558\uc138\uc694. STEP2: \ud50c\ub9bd\uc744 \uc2e4\ud589\ud558\ub824\uba74 \ub193\uc73c\uc138\uc694. \uc8fc\uc694 \ucee8\ud2b8\ub864\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: \ucda9\uc804 \uc2dc\uac04(\ud50c\ub9bd \ub192\uc774 \uacb0\uc815), \ub193\ub294 \ud0c0\uc774\ubc0d(\ubc29\ud5a5 \uc870\uc815), \uac01\ub3c4 \uc870\uc815(\ucc29\uc9c0 \ubbf8\uc138 \uc870\uc815). \uc608\ub97c \ub4e4\uc5b4 \ub808\ubca8 3\uc5d0\uc11c \uc801\uc808\ud55c \ud0c0\uc774\ubc0d\uc758 \ud50c\ub9bd\uc740 \uc18c\uc2dc\uc9c0\ub97c \uc791\uc740 \ud50c\ub7ab\ud3fc\uc5d0 \uc644\ubcbd\ud558\uac8c \ucc29\uc9c0\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc2ac\ub9c1\uc0f7\uc744 \ub2f9\uae30\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \u2013 \ub20c\ub7ec\ub450\ub294 \uc2dc\uac04\uc774 \uae38\uc218\ub85d \ub354 \uba40\ub9ac \uac11\ub2c8\ub2e4.]"}, {"question": "\uc18c\uc2dc\uc9c0 \ud50c\ub9bd\uc5d0\uc11c \uc18c\uc2dc\uc9c0\uac00 \uc608\uce21 \ubd88\uac00\ub2a5\ud558\uac8c \ud280\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \uc548\uc815\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc18c\uc2dc\uc9c0 \ud50c\ub9bd\uc5d0\uc11c \uc608\uce21 \ubd88\uac00\ub2a5\ud55c \ud280\ub294 \ud604\uc0c1\uc740 \uc885\uc885 \ubd80\uc801\uc808\ud55c \ucc29\uc9c0 \uac01\ub3c4 \ub610\ub294 \uacfc\ub3c4\ud55c \ubaa8\uba58\ud140\uc73c\ub85c \uc778\ud574 \ubc1c\uc0dd\ud569\ub2c8\ub2e4. \uc18c\uc2dc\uc9c0\ub97c \uc548\uc815\uc2dc\ud0a4\ub824\uba74 \ub2e4\uc74c\uc744 \uc218\ud589\ud558\uc138\uc694. STEP1: \uac00\uc7a5\uc790\ub9ac\uac00 \uc544\ub2cc \ud3c9\ud3c9\ud55c \ud45c\uba74\uc744 \ubaa9\ud45c\ub85c \uc0bc\uc73c\uc138\uc694. STEP2: \uc18c\uc2dc\uc9c0\uac00 \uacfc\ub3c4\ud558\uac8c \ub118\uc5b4\uac00\uba74 \ud50c\ub9bd \ud798\uc744 \uc904\uc774\uc138\uc694. STEP3: \ud658\uacbd(\uc608: \ubcbd\uc774\ub098 \uc7a5\uc560\ubb3c)\uc744 \uc0ac\uc6a9\ud558\uc5ec \ucc29\uc9c0\ub97c \uc644\ud654\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4 \ub808\ubca8 7\uc5d0\uc11c \uc67c\ucabd \ubcbd\uc5d0 \ubc18\ubc1c\ud558\uba74 \ub354 \ub192\uc740 \ud50c\ub7ab\ud3fc\uc5d0 \ub3c4\ub2ec\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ub300\uc870\ud45c: \ub192\uc740 \ud798 = \ub354 \ub9ce\uc740 \ud280\uae40; \ub0ae\uc740 \ud798 = \ub354 \ubd80\ub4dc\ub7ec\uc6b4 \ucc29\uc9c0.]"}, {"question": "\uc18c\uc2dc\uc9c0 \ud50c\ub9bd\uc758 \ucd08\uae30 \ub808\ubca8\uc5d0\uc11c \uc0bc\uc131\uc744 \ub2ec\uc131\ud558\uae30 \uc704\ud55c \ucd5c\uc0c1\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ucd08\uae30 \ub808\ubca8\uc5d0\uc11c \uc0bc\uc131\uc744 \ub2ec\uc131\ud558\ub824\uba74 \uc815\ud655\uc131\uacfc \ud6a8\uc728\uc131\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \ud50c\ub9bd \ud69f\uc218\ub97c \ucd5c\uc18c\ud654\ud558\uc138\uc694. \ud50c\ub9bd\uc774 \uc801\uc744\uc218\ub85d \uc810\uc218\uac00 \ub192\uc544\uc9d1\ub2c8\ub2e4. STEP2: \ubcf4\ub108\uc2a4 \ud0c0\uac9f(\uc608: \uae08\uc0c9 \uc18c\uc2dc\uc9c0)\uc5d0 \ucc29\ub959\ud558\uc5ec \ucd94\uac00 \uc810\uc218\ub97c \uc5bb\uc73c\uc138\uc694. STEP3: \uc2dc\uac04 \ubcf4\ub108\uc2a4\ub97c \uc704\ud574 \ub808\ubca8\uc744 \uc2e0\uc18d\ud558\uac8c \uc644\ub8cc\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4 \ub808\ubca8 5\uc5d0\uc11c \ud55c \ubc88\uc758 \uc815\ud655\ud55c \ud50c\ub9bd\uc73c\ub85c \uae08\uc0c9 \uc18c\uc2dc\uc9c0\uc5d0 \uc9c1\uc811 \ucc29\ub959\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc911 \uc635\uc158 \ube44\uad50: \uc635\uc158 A: \uc5ec\ub7ec \ubc88 \uc791\uc740 \ud50c\ub9bd(\ub0ae\uc740 \uc810\uc218); \uc635\uc158 B: \ud55c \ubc88\uc758 \uac15\ub825\ud55c \ud50c\ub9bd(\ub192\uc740 \uc810\uc218).]"}, {"question": "\uc18c\uc2dc\uc9c0 \ud50c\ub9bd\uc5d0\uc11c \uace0\uae09 \uc774\uc911 \ud50c\ub9bd \uae30\uc220\uc744 \ub9c8\uc2a4\ud130\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc774\uc911 \ud50c\ub9bd \uae30\uc220\uc740 \uacf5\uc911\uc5d0\uc11c \ub450 \ubc88\uc758 \ud50c\ub9bd\uc744 \uc5f0\uacb0\ud558\uc5ec \ub354 \ud070 \uac70\ub9ac\uc640 \uc81c\uc5b4\ub97c \uc5bb\ub294 \uac83\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. STEP1: \uccab \ubc88\uc9f8 \ud50c\ub9bd\uc744 \ud3c9\uc18c\uc640 \uac19\uc774 \uc218\ud589\ud558\uc138\uc694. STEP2: \uccab \ubc88\uc9f8 \ud50c\ub9bd\uc758 \ucd5c\uace0\uc810\uc5d0\uc11c \ub450 \ubc88\uc9f8 \ud50c\ub9bd\uc744 \uc2e0\uc18d\ud558\uac8c \ucda9\uc804\ud558\uace0 \ub193\uc73c\uc138\uc694. STEP3: \ub450 \ubc88\uc9f8 \ud50c\ub9bd \uc911 \ucc29\uc9c0\ub97c \ubbf8\uc138 \uc870\uc815\ud558\uae30 \uc704\ud574 \uac01\ub3c4\ub97c \uc870\uc815\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4 \ub808\ubca8 12\uc5d0\uc11c \uc774\uc911 \ud50c\ub9bd\uc740 \ub113\uc740 \uac04\uaca9\uc744 \ub6f0\uc5b4\ub118\uc744 \uc218 \uc788\ub3c4\ub85d \ub3c4\uc640\uc90d\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \uadf8\ub9bc: \ucda9\uc804 \u2192 \ubc29\ucd9c \u2192 \ucd5c\uace0\uc810 \u2192 \ucda9\uc804 \u2192 \ubc29\ucd9c \u2192 \ucc29\ub959.]"}, {"question": "\uc18c\uc2dc\uc9c0 \ud50c\ub9bd\uc758 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc5d0\uc11c \uc5b4\ub5a4 \ud658\uacbd \uc694\uc18c\ub97c \ud65c\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ubcbd, \uacbd\uc0ac\uba74 \ubc0f \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uacfc \uac19\uc740 \ud658\uacbd \uc694\uc18c\ub294 \uc804\ub7b5\uc801\uc73c\ub85c \ud65c\uc6a9\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \ubcbd\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc18c\uc2dc\uc9c0\uc758 \uada4\uc801\uc744 \uc7ac\uc9c0\uc815\ud558\uc2ed\uc2dc\uc624. STEP2: \uacbd\uc0ac\uba74\uc744 \uc0ac\uc6a9\ud558\uc5ec \ucd94\uac00 \ubaa8\uba58\ud140\uc744 \uc5bb\uc73c\uc2ed\uc2dc\uc624. STEP3: \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uacfc \ud50c\ub9bd \ud0c0\uc774\ubc0d\uc744 \ub9de\ucdb0 \uc815\ud655\ud55c \ucc29\ub959\uc744 \ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4 \ub808\ubca8 15\uc5d0\uc11c \uacbd\uc0ac \ubcbd\uc5d0 \ubc18\ubc1c\ud558\uba74 \uc228\uaca8\uc9c4 \uc601\uc5ed\uc5d0 \ub3c4\ub2ec\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ubcbd\uc744 \ud2b8\ub7a8\ud384\ub9b0, \uacbd\uc0ac\uba74\uc744 \ubc1c\uc0ac\ub300\ub77c\uace0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694.]"}, {"question": "\uc18c\uc2dc\uc9c0 \ud50c\ub9bd\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ubb34\uc5c7\uc774\uba70 \ubcf4\ub108\uc2a4 \uc810\uc218\ub294 \uc5b4\ub5bb\uac8c \uacc4\uc0b0\ub429\ub2c8\uae4c?", "answer": "\uc18c\uc2dc\uc9c0 \ud50c\ub9bd\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub9bd \ud69f\uc218, \uc18c\uc694 \uc2dc\uac04 \ubc0f \ubcf4\ub108\uc2a4 \ud0c0\uac9f \uc138 \uac00\uc9c0 \uc694\uc778\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uac01 \ud50c\ub9bd\uc740 \uc810\uc218\ub97c \uae4e\uc9c0\ub9cc, \ube60\ub978 \uc644\ub8cc \ubc0f \ubcf4\ub108\uc2a4 \ud0c0\uac9f(\uc608: \uae08\uc0c9 \uc18c\uc2dc\uc9c0) \ucc29\ub959\uc740 \uc810\uc218\ub97c \ub354\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 \ub808\ubca8 10\uc5d0\uc11c \ucd94\uac00 \ud50c\ub9bd \uc5c6\uc774 \uc138 \uac1c\uc758 \uae08\uc0c9 \uc18c\uc2dc\uc9c0 \ubaa8\ub450\uc5d0 \ucc29\ub959\ud558\uba74 \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ub300\uc870\ud45c: \ud50c\ub9bd \ud69f\uc218: \ud50c\ub9bd\ub2f9 -10\uc810; \uc2dc\uac04 \ubcf4\ub108\uc2a4: 30\ucd08 \ubbf8\ub9cc \uc2dc +100\uc810; \uae08\uc0c9 \uc18c\uc2dc\uc9c0: \uac01\uac01 +50\uc810.]"}, {"question": "\uc18c\uc2dc\uc9c0 \ud50c\ub9bd\uc758 \ubb3c\ub9ac \uc5d4\uc9c4\uc740 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\uc18c\uc2dc\uc9c0 \ud50c\ub9bd\uc758 \ubb3c\ub9ac \uc5d4\uc9c4\uc740 \ud604\uc2e4\uc801\uc778 \ubaa8\uba58\ud140, \uc911\ub825 \ubc0f \ucda9\ub3cc\uc744 \uc2dc\ubbac\ub808\uc774\uc158\ud569\ub2c8\ub2e4. \ubaa8\uba58\ud140\uc740 \uc18c\uc2dc\uc9c0\uac00 \uc5bc\ub9c8\ub098 \uba40\ub9ac \uc774\ub3d9\ud558\ub294\uc9c0\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\uace0, \uc911\ub825\uc740 \ud558\uac15 \uc18d\ub3c4\ub97c \uacb0\uc815\ud558\uba70, \ucda9\ub3cc \uba54\ucee4\ub2c8\uc998\uc740 \ud280\uae40 \ubc0f \uc548\uc815\uc131\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 \ub808\ubca8 18\uc5d0\uc11c \uc18c\uc2dc\uc9c0\uc758 \ubaa8\uba58\ud140\uc740 \ud0c0\uc774\ubc0d\uc774 \uc801\uc808\ud558\uba74 \uc7a5\uc560\ubb3c\uc744 \ub6f0\uc5b4\ub118\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uace0\ubb34 \uacf5\ucc98\ub7fc \uc18c\uc2dc\uc9c0\ub97c \uc0c1\uc0c1\ud574 \ubcf4\uc138\uc694 \u2013 \ud798\uacfc \uac01\ub3c4\uc5d0 \ub530\ub77c \ud280\uace0 \uad74\ub7ec\uac11\ub2c8\ub2e4.]"}, {"question": "\ubaa8\ubc14\uc77c \ubc0f PC \ud50c\ub7ab\ud3fc \uac04\uc5d0 \uc18c\uc2dc\uc9c0 \ud50c\ub9bd \uc9c4\ucc99\ub3c4\ub97c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub124, \uc18c\uc2dc\uc9c0 \ud50c\ub9bd\uc740 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ud1b5\ud574 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \uc9c4\ucc99\ub3c4\ub97c \uc804\uc1a1\ud569\ub2c8\ub2e4. STEP1: \ub450 \ud50c\ub7ab\ud3fc \ubaa8\ub450\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uc138\uc694. STEP2: \uc124\uc815\uc5d0\uc11c \ud074\ub77c\uc6b0\ub4dc \ub3d9\uae30\ud654\ub97c \ud65c\uc131\ud654\ud558\uc138\uc694. STEP3: \ub450 \uae30\uae30\uac00 \ubaa8\ub450 \uc778\ud130\ub137\uc5d0 \uc5f0\uacb0\ub418\uc5b4 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4 \ubaa8\ubc14\uc77c\uc5d0\uc11c \uc2dc\uc791\ud55c \ud6c4 PC\uc5d0\uc11c \ub808\ubca8 20\uc744 \uacc4\uc18d \ud50c\ub808\uc774\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ub300\uc870\ud45c: \ubaa8\ubc14\uc77c \u2192 PC: \ub3d9\uae30\ud654 \ud544\uc694; PC \u2192 \ubaa8\ubc14\uc77c: \ub3d9\uae30\ud654 \ud544\uc694.]"}, {"question": "\uc18c\uc2dc\uc9c0 \ud50c\ub9bd\uc5d0 \uc228\uaca8\uc9c4 \ub808\ubca8\uc774\ub098 \ube44\ubc00 \uc601\uc5ed\uc774 \uc788\uc2b5\ub2c8\uae4c? \uc5b4\ub5bb\uac8c \uc561\uc138\uc2a4\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub124, \uc18c\uc2dc\uc9c0 \ud50c\ub9bd\uc5d0\ub294 \uc228\uaca8\uc9c4 \ub808\ubca8\uacfc \ube44\ubc00 \uc601\uc5ed\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc561\uc138\uc2a4\ud558\ub824\uba74 \ub2e4\uc74c\uc744 \uc218\ud589\ud558\uc138\uc694. STEP1: \ud2b9\uc774\ud55c \ud50c\ub7ab\ud3fc \ud328\ud134\uc774\ub098 \ub3c4\ub2ec\ud560 \uc218 \uc5c6\ub294 \uc601\uc5ed\uc744 \ucc3e\uc73c\uc138\uc694. STEP2: \uc774\uc911 \ud50c\ub9bd\uc774\ub098 \ubcbd \ubc18\ubc1c\uacfc \uac19\uc740 \uace0\uae09 \uae30\uc220\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc774\ub7ec\ud55c \uc9c0\uc810\uc5d0 \ub3c4\ub2ec\ud558\uc138\uc694. STEP3: \ud2b9\uc815 \ucc4c\ub9b0\uc9c0(\uc608: \ud50c\ub9bd \uc5c6\uc774 \ub808\ubca8 \uc644\ub8cc)\ub97c \uc644\ub8cc\ud558\uc5ec \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \uc7a0\uae08 \ud574\uc81c\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4 \ub808\ubca8 25\uc5d0\uc11c \uc798 \uc218\ud589\ub41c \uc774\uc911 \ud50c\ub9bd\uc73c\ub85c \uc228\uaca8\uc9c4 \uae08\uc0c9 \uc18c\uc2dc\uc9c0\ub97c \ub4dc\ub7ec\ub0bc \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ubbf8\ub85c\uc5d0\uc11c \ube44\ubc00 \ubc29\uc744 \ubc1c\uacac\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\uc18c\uc2dc\uc9c0 \ud50c\ub9bd\uc758 \uce90\uc8fc\uc5bc \ubaa8\ub4dc\uc640 \ud558\ub4dc\ucf54\uc5b4 \ubaa8\ub4dc\uc758 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5a4 \ubaa8\ub4dc\uac00 \ub354 \uc801\ud569\ud569\ub2c8\uae4c?", "answer": "\uc18c\uc2dc\uc9c0 \ud50c\ub9bd\uc758 \uce90\uc8fc\uc5bc \ubaa8\ub4dc\ub294 \ub290\uc2a8\ud55c \ubb3c\ub9ac\uc640 \uad00\ub300\ud55c \uc810\uc218\ub97c \uc81c\uacf5\ud558\uc9c0\ub9cc, \ud558\ub4dc\ucf54\uc5b4 \ubaa8\ub4dc\ub294 \uc5c4\uaca9\ud55c \uba54\ucee4\ub2c8\uc998\uacfc \ub192\uc740 \ub09c\uc774\ub3c4\ub97c \ud2b9\uc9d5\uc73c\ub85c \ud569\ub2c8\ub2e4. \uce90\uc8fc\uc5bc \ubaa8\ub4dc\ub294 \ucd08\ubcf4\uc790 \ub610\ub294 \uc2a4\ud2b8\ub808\uc2a4\ub97c \ub35c \uc6d0\ud558\ub294 \uc0ac\ub78c\uc5d0\uac8c \uc801\ud569\ud558\uc9c0\ub9cc, \ud558\ub4dc\ucf54\uc5b4 \ubaa8\ub4dc\ub294 \uacbd\ud5d8 \ub9ce\uc740 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \ub3c4\uc804\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 \ud558\ub4dc\ucf54\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c \ub808\ubca8 30\uc5d0\uc11c\ub294 \uc131\uacf5\ud558\uae30 \uc704\ud574 \ud53d\uc140 \ub2e8\uc704\ub85c \uc815\ud655\ud55c \ud50c\ub9bd\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. [\ub2e4\uc911 \uc635\uc158 \ube44\uad50: \uce90\uc8fc\uc5bc \ubaa8\ub4dc: \uc26c\uc6b4 \ud50c\ub9bd, \ub0ae\uc740 \ud398\ub110\ud2f0; \ud558\ub4dc\ucf54\uc5b4 \ubaa8\ub4dc: \uc815\ud655\ud55c \ud50c\ub9bd, \ub192\uc740 \ud398\ub110\ud2f0.]"}]
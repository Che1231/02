[{"question": "\u5982\u4f55\u5728\u300e\u4e94\u591c\u602a\u5922\uff1a\u59d0\u59b9\u5834\u6240\u300f\u4e2d\uff0c\u65b0\u624b\u5982\u4f55\u5ea6\u904e\u7b2c\u4e00\u591c\uff1f", "answer": "\u8981\u5ea6\u904e\u300e\u4e94\u591c\u602a\u5922\uff1a\u59d0\u59b9\u5834\u6240\u300f\u7684\u7b2c\u4e00\u591c\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u719f\u6089\u63a7\u5236\u9762\u677f\uff0c\u5305\u62ec\u87a2\u5e55\u3001\u97f3\u6548\u63d0\u793a\u548c\u901a\u98a8\u7ba1\u7cfb\u7d71\u3002\u6b65\u9a5f2 - \u4e0d\u65b7\u67e5\u770b\u87a2\u5e55\uff0c\u8ffd\u8e64\u64ec\u771f\u89d2\u8272\u7684\u52d5\u4f5c\uff0c\u5c24\u5176\u662f Baby \u548c Ballora\u3002\u6b65\u9a5f3 - \u7b56\u7565\u6027\u5730\u4f7f\u7528\u97f3\u6548\u8a98\u990c\uff0c\u5728\u64ec\u771f\u89d2\u8272\u9760\u8fd1\u6642\u5c07\u5176\u5206\u6563\u6ce8\u610f\u529b\u3002\u4f8b\u5982\uff0c\u5982\u679c Ballora \u5f9e\u5de6\u908a\u7684\u901a\u98a8\u7ba1\u9760\u8fd1\uff0c\u8acb\u5728\u53f3\u908a\u64ad\u653e\u97f3\u6548\u8a98\u990c\uff0c\u4ee5\u8f49\u79fb\u5979\u7684\u6ce8\u610f\u529b\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u63a7\u5236\u9762\u677f\u8996\u70ba\u60a8\u7684\u6307\u63ee\u4e2d\u5fc3\uff0c\u6bcf\u500b\u6309\u9215\u90fd\u662f\u751f\u5b58\u7684\u6551\u547d\u7a3b\u8349\u3002]"}, {"question": "\u70ba\u4f55\u5728\u300e\u4e94\u591c\u602a\u5922\uff1a\u59d0\u59b9\u5834\u6240\u300f\u4e2d\u77ad\u89e3\u64ec\u771f\u89d2\u8272\u884c\u70ba\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u5728\u300e\u4e94\u591c\u602a\u5922\uff1a\u59d0\u59b9\u5834\u6240\u300f\u4e2d\u77ad\u89e3\u64ec\u771f\u89d2\u8272\u884c\u70ba\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u6bcf\u500b\u64ec\u771f\u89d2\u8272\u90fd\u6709\u7368\u7279\u7684\u6a21\u5f0f\u548c\u89f8\u767c\u689d\u4ef6\u3002\u4f8b\u5982\uff0cBaby \u6709\u6642\u50be\u5411\u5f85\u5728\u99ac\u6232\u5718\u85dd\u5eca\uff0c\u4f46\u5982\u679c\u5075\u6e2c\u5230\u6d3b\u52d5\u5247\u6703\u79fb\u52d5\u3002\u53e6\u4e00\u65b9\u9762\uff0cBallora \u5c0d\u8072\u97f3\u5f88\u654f\u611f\uff0c\u5982\u679c\u807d\u5230\u566a\u97f3\u5247\u6703\u9760\u8fd1\u3002\u900f\u904e\u77ad\u89e3\u9019\u4e9b\u884c\u70ba\uff0c\u60a8\u53ef\u4ee5\u9810\u6e2c\u4ed6\u5011\u7684\u52d5\u4f5c\u4e26\u63a1\u53d6\u76f8\u61c9\u63aa\u65bd\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: Baby - \u99ac\u6232\u5718\u85dd\u5eca\uff0cBallora - \u97f3\u6a02\u5ef3\uff0cFuntime Freddy - \u7dad\u4fee\u5340\u3002]"}, {"question": "\u5728\u300e\u4e94\u591c\u602a\u5922\uff1a\u59d0\u59b9\u5834\u6240\u300f\u4e2d\uff0c\u54ea\u4e9b\u91cd\u8981\u7684\u63a7\u5236\u9805\u9700\u8981\u719f\u7df4\u638c\u63e1\uff1f", "answer": "\u5728\u300e\u4e94\u591c\u602a\u5922\uff1a\u59d0\u59b9\u5834\u6240\u300f\u4e2d\uff0c\u9700\u8981\u719f\u7df4\u638c\u63e1\u7684\u63a7\u5236\u9805\u5305\u62ec\u87a2\u5e55\u3001\u97f3\u6548\u8a98\u990c\u548c\u901a\u98a8\u7ba1\u7cfb\u7d71\u3002\u87a2\u5e55\u8b93\u60a8\u8ffd\u8e64\u64ec\u771f\u89d2\u8272\u7684\u4f4d\u7f6e\uff0c\u800c\u97f3\u6548\u8a98\u990c\u53ef\u4ee5\u5c07\u5176\u5206\u6563\u6ce8\u610f\u529b\u3002\u901a\u98a8\u7ba1\u7cfb\u7d71\u5c0d\u65bc\u5c01\u9396\u5165\u53e3\u81f3\u95dc\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5982\u679c Funtime Freddy \u9760\u8fd1\u901a\u98a8\u7ba1\uff0c\u8acb\u8fc5\u901f\u5c01\u9396\u5b83\uff0c\u4ee5\u9632\u6b62\u4ed6\u9032\u5165\u3002[\u6d41\u7a0b\u5716\u89e3: \u87a2\u5e55 \u2192 \u8ffd\u8e64\u64ec\u771f\u89d2\u8272 \u2192 \u4f7f\u7528\u97f3\u6548\u8a98\u990c \u2192 \u5c01\u9396\u901a\u98a8\u7ba1 \u2192 \u5b58\u6d3b\u3002]"}, {"question": "\u5982\u4f55\u5728\u300e\u4e94\u591c\u602a\u5922\uff1a\u59d0\u59b9\u5834\u6240\u300f\u4e2d\u6700\u4f73\u5316\u97f3\u6548\u8a98\u990c\u7684\u4f7f\u7528\uff1f", "answer": "\u8981\u5728\u300e\u4e94\u591c\u602a\u5922\uff1a\u59d0\u59b9\u5834\u6240\u300f\u4e2d\u6700\u4f73\u5316\u97f3\u6548\u8a98\u990c\u7684\u4f7f\u7528\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u8fa8\u8b58\u6b63\u5728\u9760\u8fd1\u7684\u64ec\u771f\u89d2\u8272\u3002\u6b65\u9a5f2 - \u5728\u76f8\u53cd\u65b9\u5411\u64ad\u653e\u97f3\u6548\u8a98\u990c\uff0c\u4ee5\u8f49\u79fb\u5176\u6ce8\u610f\u529b\u3002\u6b65\u9a5f3 - \u76e3\u63a7\u5176\u52d5\u4f5c\uff0c\u4ee5\u78ba\u4fdd\u8a98\u990c\u6709\u6548\u3002\u4f8b\u5982\uff0c\u5982\u679c Ballora \u671d\u60a8\u79fb\u52d5\uff0c\u8acb\u5728\u97f3\u6a02\u5ef3\u64ad\u653e\u97f3\u6548\u8a98\u990c\uff0c\u4ee5\u5c07\u5979\u5438\u5f15\u8d70\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u4f7f\u7528\u97f3\u6548\u8a98\u990c\u8207\u5c01\u9396\u901a\u98a8\u7ba1 - \u97f3\u6548\u8a98\u990c\u6700\u9069\u5408\u7528\u65bc\u5206\u6563\u6ce8\u610f\u529b\uff0c\u800c\u5c01\u9396\u901a\u98a8\u7ba1\u5247\u66f4\u9069\u5408\u7528\u65bc\u7acb\u5373\u7684\u9632\u79a6\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u901a\u98a8\u7ba1\u7cfb\u7d71\u5728\u300e\u4e94\u591c\u602a\u5922\uff1a\u59d0\u59b9\u5834\u6240\u300f\u4e2d\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u300e\u4e94\u591c\u602a\u5922\uff1a\u59d0\u59b9\u5834\u6240\u300f\u4e2d\u7684\u901a\u98a8\u7ba1\u7cfb\u7d71\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u662f\u64ec\u771f\u89d2\u8272\u7684\u4e3b\u8981\u9032\u5165\u9ede\u3002\u900f\u904e\u5c01\u9396\u901a\u98a8\u7ba1\uff0c\u60a8\u53ef\u4ee5\u963b\u6b62 Funtime Freddy \u7b49\u64ec\u771f\u89d2\u8272\u9032\u5165\u60a8\u7684\u5340\u57df\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u6ce8\u610f\u5230 Funtime Freddy \u9760\u8fd1\u901a\u98a8\u7ba1\uff0c\u8acb\u8fc5\u901f\u5c01\u9396\u5b83\u4ee5\u963b\u64cb\u4ed6\u7684\u8def\u5f91\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u901a\u98a8\u7ba1\u7cfb\u7d71\u8996\u70ba\u60a8\u7684\u6700\u5f8c\u4e00\u9053\u9632\u7dda\uff0c\u6bcf\u500b\u5c01\u9396\u90fd\u662f\u5c0d\u5165\u4fb5\u8005\u7684\u963b\u7919\u3002]"}, {"question": "\u5728\u300e\u4e94\u591c\u602a\u5922\uff1a\u59d0\u59b9\u5834\u6240\u300f\u4e2d\uff0c\u5982\u4f55\u61c9\u5c0d\u591a\u500b\u64ec\u771f\u89d2\u8272\uff1f", "answer": "\u5728\u300e\u4e94\u591c\u602a\u5922\uff1a\u59d0\u59b9\u5834\u6240\u300f\u4e2d\u61c9\u5c0d\u591a\u500b\u64ec\u771f\u89d2\u8272\u9700\u8981\u7d50\u5408\u76e3\u63a7\u3001\u97f3\u6548\u8a98\u990c\u548c\u901a\u98a8\u7ba1\u5c01\u9396\u3002\u6b65\u9a5f1 - \u4f7f\u7528\u87a2\u5e55\u540c\u6642\u8ffd\u8e64\u6240\u6709\u64ec\u771f\u89d2\u8272\u3002\u6b65\u9a5f2 - \u512a\u5148\u8655\u7406\u6700\u76f4\u63a5\u5a01\u8105\u7684\u64ec\u771f\u89d2\u8272\uff0c\u4e26\u4f7f\u7528\u97f3\u6548\u8a98\u990c\u5c07\u5176\u5206\u6563\u6ce8\u610f\u529b\u3002\u6b65\u9a5f3 - \u5c01\u9396\u901a\u98a8\u7ba1\uff0c\u4ee5\u9632\u6b62\u5176\u4ed6\u64ec\u771f\u89d2\u8272\u9032\u5165\u3002\u4f8b\u5982\uff0c\u5982\u679c Baby \u548c Ballora \u90fd\u6d3b\u8e8d\uff0c\u8acb\u5148\u5c08\u6ce8\u65bc Baby\uff0c\u56e0\u70ba\u5979\u53ef\u80fd\u66f4\u6709\u4fb5\u7565\u6027\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: Baby - \u9ad8\u5a01\u8105\uff0cBallora - \u4e2d\u7b49\u5a01\u8105\uff0cFuntime Freddy - \u4f4e\u5a01\u8105\u3002]"}, {"question": "\u300e\u4e94\u591c\u602a\u5922\uff1a\u59d0\u59b9\u5834\u6240\u300f\u4e2d\u7684\u64ec\u771f\u89d2\u8272 AI \u5982\u4f55\u904b\u4f5c\uff1f", "answer": "\u300e\u4e94\u591c\u602a\u5922\uff1a\u59d0\u59b9\u5834\u6240\u300f\u4e2d\u7684\u64ec\u771f\u89d2\u8272 AI \u8a2d\u8a08\u6709\u7279\u5b9a\u7684\u884c\u70ba\u548c\u89f8\u767c\u689d\u4ef6\u3002\u6bcf\u500b\u64ec\u771f\u89d2\u8272\u90fd\u6709\u7368\u7279\u7684\u898f\u5247\uff0c\u6c7a\u5b9a\u5176\u52d5\u4f5c\u548c\u884c\u70ba\u3002\u4f8b\u5982\uff0cBaby \u6703\u5f85\u5728\u99ac\u6232\u5718\u85dd\u5eca\uff0c\u9664\u975e\u5075\u6e2c\u5230\u6d3b\u52d5\uff0c\u800c Ballora \u6703\u671d\u4efb\u4f55\u807d\u5230\u8072\u97f3\u7684\u65b9\u5411\u79fb\u52d5\u3002\u7406\u89e3\u9019\u4e9b AI \u6a21\u5f0f\uff0c\u8b93\u73a9\u5bb6\u53ef\u4ee5\u9810\u6e2c\u4e26\u53cd\u5236\u4ed6\u5011\u7684\u52d5\u4f5c\u3002[\u6d41\u7a0b\u5716\u89e3: \u64ec\u771f\u89d2\u8272 AI \u2192 \u884c\u70ba\u6a21\u5f0f \u2192 \u73a9\u5bb6\u884c\u70ba \u2192 \u5b58\u6d3b\u3002]"}, {"question": "\u300e\u4e94\u591c\u602a\u5922\uff1a\u59d0\u59b9\u5834\u6240\u300f\u4e2d\u64ec\u771f\u89d2\u8272\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "\u300e\u4e94\u591c\u602a\u5922\uff1a\u59d0\u59b9\u5834\u6240\u300f\u4e2d\u64ec\u771f\u89d2\u8272\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u5728\u65bc\u5176\u884c\u70ba\u548c\u5a01\u8105\u7b49\u7d1a\u3002Baby \u5177\u6709\u9ad8\u5ea6\u4fb5\u7565\u6027\uff0c\u5982\u679c\u5075\u6e2c\u5230\u6d3b\u52d5\u5247\u6703\u653b\u64ca\uff0c\u800c Ballora \u5247\u66f4\u88ab\u52d5\uff0c\u4f46\u6703\u671d\u8072\u97f3\u7684\u65b9\u5411\u79fb\u52d5\u3002\u53e6\u4e00\u65b9\u9762\uff0cFuntime Freddy \u5247\u8f03\u4e0d\u5177\u4fb5\u7565\u6027\uff0c\u4f46\u5982\u679c\u6c92\u6709\u59a5\u5584\u7ba1\u7406\uff0c\u4f9d\u820a\u53ef\u80fd\u9020\u6210\u5a01\u8105\u3002\u4f8b\u5982\uff0cBaby \u9700\u8981\u6301\u7e8c\u76e3\u63a7\uff0c\u800c Ballora \u53ef\u4ee5\u7528\u97f3\u6548\u8a98\u990c\u5206\u6563\u6ce8\u610f\u529b\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: Baby vs. Ballora vs. Funtime Freddy - Baby \u6700\u5177\u4fb5\u7565\u6027\uff0cBallora \u5c0d\u8072\u97f3\u654f\u611f\uff0cFuntime Freddy \u5a01\u8105\u8f03\u4f4e\u3002]"}, {"question": "\u5982\u4f55\u5728\u300e\u4e94\u591c\u602a\u5922\uff1a\u59d0\u59b9\u5834\u6240\u300f\u4e2d\u5c07\u904a\u6232\u9032\u5ea6\u8f49\u79fb\u5230\u4e0d\u540c\u7684\u5e73\u53f0\uff1f", "answer": "\u5728\u300e\u4e94\u591c\u602a\u5922\uff1a\u59d0\u59b9\u5834\u6240\u300f\u4e2d\u5c07\u904a\u6232\u9032\u5ea6\u8f49\u79fb\u5230\u4e0d\u540c\u7684\u5e73\u53f0\u53ef\u80fd\u5177\u6709\u6311\u6230\u6027\uff0c\u56e0\u70ba\u7f3a\u4e4f\u5167\u5efa\u7684\u8de8\u5e73\u53f0\u5132\u5b58\u529f\u80fd\u3002\u4e0d\u904e\uff0c\u60a8\u53ef\u4ee5\u900f\u904e\u627e\u5230\u7576\u524d\u5e73\u53f0\u7684\u5132\u5b58\u8cc7\u6599\u4e26\u5c07\u5176\u79fb\u81f3\u65b0\u7684\u5e73\u53f0\u4f86\u624b\u52d5\u8f49\u79fb\u5132\u5b58\u6a94\u6848\u3002\u4f8b\u5982\uff0c\u5728\u96fb\u8166\u4e0a\uff0c\u5132\u5b58\u6a94\u6848\u901a\u5e38\u5132\u5b58\u5728\u904a\u6232\u5b89\u88dd\u76ee\u9304\u4e2d\uff0c\u800c\u5728\u4e3b\u6a5f\u904a\u6232\u4e0a\uff0c\u60a8\u53ef\u80fd\u9700\u8981\u4f7f\u7528\u5916\u90e8\u5132\u5b58\u88dd\u7f6e\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u5132\u5b58\u6a94\u6848\u8996\u70ba\u9700\u8981\u5728\u4e0d\u540c\u5e73\u53f0\u52a0\u84cb\u5370\u7ae0\u7684\u6578\u4f4d\u8b77\u7167\u3002]"}, {"question": "\u5728\u300e\u4e94\u591c\u602a\u5922\uff1a\u59d0\u59b9\u5834\u6240\u300f\u4e2d\uff0c\u6709\u54ea\u4e9b\u96b1\u85cf\u5167\u5bb9\u53ef\u4ee5\u767c\u73fe\uff1f", "answer": "\u300e\u4e94\u591c\u602a\u5922\uff1a\u59d0\u59b9\u5834\u6240\u300f\u4e2d\u7684\u96b1\u85cf\u5167\u5bb9\u5305\u62ec\u79d8\u5bc6\u7d50\u5c40\u548c\u5f69\u86cb\uff0c\u63ed\u793a\u66f4\u591a\u6709\u95dc\u904a\u6232\u80cc\u666f\u7684\u6545\u4e8b\u3002\u4f8b\u5982\uff0c\u900f\u904e\u9075\u5faa\u7279\u5b9a\u7684\u52d5\u4f5c\u548c\u505a\u51fa\u67d0\u4e9b\u9078\u64c7\uff0c\u73a9\u5bb6\u53ef\u4ee5\u89e3\u9396\u300e\u771f\u6b63\u7d50\u5c40\u300f\uff0c\u9019\u5c07\u63d0\u4f9b\u66f4\u6df1\u5165\u7684\u4e86\u89e3\u95dc\u65bc Circus Baby \u548c\u64ec\u771f\u89d2\u8272\u7684\u6545\u4e8b\u60c5\u7bc0\u3002[\u5f69\u86cb\u6316\u6398: \u6ce8\u610f\u74b0\u5883\u4e2d\u7684\u7d30\u5fae\u7dda\u7d22\uff0c\u4f8b\u5982\u96b1\u6666\u7684\u8a0a\u606f\u6216\u4e0d\u5c0b\u5e38\u7684\u64ec\u771f\u89d2\u8272\u884c\u70ba\uff0c\u4ee5\u767c\u73fe\u9019\u4e9b\u96b1\u85cf\u5bf6\u85cf\u3002]"}]
[{"question": "\ud30c\uc774\ube0c \ub098\uc774\uce20 \uc5b4\ud2b8 \uc250\ub4dc\uc758 \uc2dc\uc2a4\ud130 \ub85c\ucf00\uc774\uc158\uc5d0\uc11c \ucd08\ubcf4\uc790\uac00 \uccab \ubc88\uc9f8 \ubc24\uc744 \uc5b4\ub5bb\uac8c \uc0b4\uc544\ub0a8\uc744 \uc218 \uc788\uc744\uae4c\uc694?", "answer": "\ud30c\uc774\ube0c \ub098\uc774\uce20 \uc5b4\ud2b8 \uc250\ub4dc\uc758 \uc2dc\uc2a4\ud130 \ub85c\ucf00\uc774\uc158\uc5d0\uc11c \uccab \ubc88\uc9f8 \ubc24\uc744 \uc0b4\uc544\ub0a8\uc73c\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1 - \ubaa8\ub2c8\ud130, \uc624\ub514\uc624 \ud050, \ud658\ud48d\uad6c \uc2dc\uc2a4\ud15c\uc744 \ud3ec\ud568\ud55c \uc81c\uc5b4\ud310\uc744 \uc219\uc9c0\ud558\uc138\uc694. STEP2 - \ud2b9\ud788 \ubca0\uc774\ube44\uc640 \ubc1c\ub85c\ub77c\uc758 \ub3d9\uc791\uc744 \ucd94\uc801\ud558\uae30 \uc704\ud574 \ubaa8\ub2c8\ud130\ub97c \uc9c0\uc18d\uc801\uc73c\ub85c \ud655\uc778\ud558\uc138\uc694. STEP3 - \uc560\ub2c8\uba54\uc774\uc158 \uce90\ub9ad\ud130\ub4e4\uc774 \ub108\ubb34 \uac00\uae4c\uc774 \ub2e4\uac00\uc62c \ub54c \uc624\ub514\uc624 \uc720\uc778\ucc45\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc5ec \uc8fc\uc758\ub97c \uc0b0\ub9cc\ud558\uac8c \ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ubc1c\ub85c\ub77c\uac00 \uc67c\ucabd \ud658\ud48d\uad6c\uc5d0\uc11c \ub2e4\uac00\uc628\ub2e4\uba74, \uadf8\ub140\uc758 \uc8fc\uc758\ub97c \ub2e4\ub978 \uacf3\uc73c\ub85c \ub3cc\ub9ac\uae30 \uc704\ud574 \uc624\ub978\ucabd\uc73c\ub85c \uc624\ub514\uc624 \uc720\uc778\ucc45\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. [\ube44\uc720 \uc124\uba85: \uc81c\uc5b4\ud310\uc744 \uc0dd\uc874\uc744 \uc704\ud55c \uc9c0\ud718 \ubcf8\ubd80\ub85c \uc0dd\uac01\ud558\uc138\uc694. \uac01 \ubc84\ud2bc\uc740 \uc0dd\uc874\uc758 \uad6c\uc6d0\uc904\uc785\ub2c8\ub2e4.]"}, {"question": "\ud30c\uc774\ube0c \ub098\uc774\uce20 \uc5b4\ud2b8 \uc250\ub4dc \uc2dc\uc2a4\ud130 \ub85c\ucf00\uc774\uc158\uc5d0\uc11c \uc560\ub2c8\uba54\uc774\uc158 \uce90\ub9ad\ud130\uc758 \ud589\ub3d9\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\uc774\ube0c \ub098\uc774\uce20 \uc5b4\ud2b8 \uc250\ub4dc \uc2dc\uc2a4\ud130 \ub85c\ucf00\uc774\uc158\uc5d0\uc11c \uc560\ub2c8\uba54\uc774\uc158 \uce90\ub9ad\ud130\uc758 \ud589\ub3d9\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \uac01 \uc560\ub2c8\uba54\uc774\uc158 \uce90\ub9ad\ud130\uac00 \uace0\uc720\ud55c \ud328\ud134\uacfc \ud2b8\ub9ac\uac70\ub97c \uac00\uc9c0\uace0 \uc788\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubca0\uc774\ube44\ub294 \uc11c\ucee4\uc2a4 \uac24\ub7ec\ub9ac\uc5d0 \uba38\ubb3c\ub824 \ud558\uc9c0\ub9cc \ud65c\ub3d9\uc744 \uac10\uc9c0\ud558\uba74 \uc6c0\uc9c1\uc785\ub2c8\ub2e4. \ubc18\uba74\uc5d0 \ubc1c\ub85c\ub77c\ub294 \uc18c\ub9ac\uc5d0 \ubbfc\uac10\ud558\uc5ec \uc18c\uc74c\uc744 \ub4e4\uc73c\uba74 \ub2e4\uac00\uc635\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud589\ub3d9\uc744 \uc54c\uba74 \uadf8\ub4e4\uc758 \uc6c0\uc9c1\uc784\uc744 \uc608\uce21\ud558\uace0 \uc801\uc808\ud788 \ub300\ucc98\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \ubca0\uc774\ube44 - \uc11c\ucee4\uc2a4 \uac24\ub7ec\ub9ac, \ubc1c\ub85c\ub77c - \uac15\ub2f9, \ud380\ud0c0\uc784 \ud504\ub808\ub514 - \ubd80\ud488 \ubc0f \uc11c\ube44\uc2a4.]"}, {"question": "\ud30c\uc774\ube0c \ub098\uc774\uce20 \uc5b4\ud2b8 \uc250\ub4dc \uc2dc\uc2a4\ud130 \ub85c\ucf00\uc774\uc158\uc5d0\uc11c \uc219\ub2ec\ud574\uc57c \ud560 \ud544\uc218\uc801\uc778 \uc81c\uc5b4 \uc694\uc18c\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\uc774\ube0c \ub098\uc774\uce20 \uc5b4\ud2b8 \uc250\ub4dc \uc2dc\uc2a4\ud130 \ub85c\ucf00\uc774\uc158\uc5d0\uc11c \uc219\ub2ec\ud574\uc57c \ud560 \ud544\uc218\uc801\uc778 \uc81c\uc5b4 \uc694\uc18c\ub294 \ubaa8\ub2c8\ud130, \uc624\ub514\uc624 \uc720\uc778\ucc45 \ubc0f \ud658\ud48d\uad6c \uc2dc\uc2a4\ud15c\uc785\ub2c8\ub2e4. \ubaa8\ub2c8\ud130\ub294 \uc560\ub2c8\uba54\uc774\uc158 \uce90\ub9ad\ud130\uc758 \uc704\uce58\ub97c \ucd94\uc801\ud558\uace0, \uc624\ub514\uc624 \uc720\uc778\ucc45\uc740 \uadf8\ub4e4\uc744 \uc8fc\uc758\ub97c \uc0b0\ub9cc\ud558\uac8c \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud658\ud48d\uad6c \uc2dc\uc2a4\ud15c\uc740 \uc9c4\uc785 \uc9c0\uc810\uc744 \ubd09\uc1c4\ud558\ub294 \ub370 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud380\ud0c0\uc784 \ud504\ub808\ub514\uac00 \ud658\ud48d\uad6c \uadfc\ucc98\uc5d0 \uc788\ub2e4\uba74, \uadf8\uc758 \uc9c4\uc785\uc744 \ub9c9\uae30 \uc704\ud574 \uc2e0\uc18d\ud558\uac8c \ubd09\uc1c4\ud558\uc138\uc694. [\ud504\ub85c\uc138\uc2a4 \uc124\uba85: \ubaa8\ub2c8\ud130 \u2192 \uc560\ub2c8\uba54\uc774\uc158 \uce90\ub9ad\ud130 \ucd94\uc801 \u2192 \uc624\ub514\uc624 \uc720\uc778\ucc45 \uc0ac\uc6a9 \u2192 \ud658\ud48d\uad6c \ubd09\uc1c4 \u2192 \uc0dd\uc874.]"}, {"question": "\ud30c\uc774\ube0c \ub098\uc774\uce20 \uc5b4\ud2b8 \uc250\ub4dc \uc2dc\uc2a4\ud130 \ub85c\ucf00\uc774\uc158\uc5d0\uc11c \uc624\ub514\uc624 \uc720\uc778\ucc45\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\uc774\ube0c \ub098\uc774\uce20 \uc5b4\ud2b8 \uc250\ub4dc \uc2dc\uc2a4\ud130 \ub85c\ucf00\uc774\uc158\uc5d0\uc11c \uc624\ub514\uc624 \uc720\uc778\ucc45\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1 - \uc5b4\ub5a4 \uc560\ub2c8\uba54\uc774\uc158 \uce90\ub9ad\ud130\uac00 \ub2e4\uac00\uc624\uace0 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. STEP2 - \uadf8\ub4e4\uc758 \uc8fc\uc758\ub97c \ub2e4\ub978 \uacf3\uc73c\ub85c \ub3cc\ub9ac\uae30 \uc704\ud574 \ubc18\ub300 \ubc29\ud5a5\uc73c\ub85c \uc624\ub514\uc624 \uc720\uc778\ucc45\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. STEP3 - \uc720\uc778\ucc45\uc774 \ud6a8\uacfc\uc801\uc778\uc9c0 \ud655\uc778\ud558\uae30 \uc704\ud574 \uadf8\ub4e4\uc758 \uc6c0\uc9c1\uc784\uc744 \ubaa8\ub2c8\ud130\ub9c1\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ubc1c\ub85c\ub77c\uac00 \ub2f9\uc2e0\uc5d0\uac8c \ub2e4\uac00\uc624\uace0 \uc788\ub2e4\uba74 \uadf8\ub140\ub97c \ub04c\uc5b4\ub0b4\uae30 \uc704\ud574 \uac15\ub2f9\uc5d0 \uc624\ub514\uc624 \uc720\uc778\ucc45\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. [\ub2e4\uc911 \uc804\ub7b5 \ube44\uad50: \uc624\ub514\uc624 \uc720\uc778\ucc45 \uc0ac\uc6a9 vs. \ud658\ud48d\uad6c \ubd09\uc1c4 - \uc624\ub514\uc624 \uc720\uc778\ucc45\uc740 \uc8fc\uc758\ub97c \uc0b0\ub9cc\ud558\uac8c \ud558\ub294 \ub370 \uac00\uc7a5 \uc801\ud569\ud558\uace0, \ud658\ud48d\uad6c \ubd09\uc1c4\ub294 \uc989\uac01\uc801\uc778 \ubc29\uc5b4\uc5d0 \ub354 \uc801\ud569\ud569\ub2c8\ub2e4.]"}, {"question": "\ud30c\uc774\ube0c \ub098\uc774\uce20 \uc5b4\ud2b8 \uc250\ub4dc \uc2dc\uc2a4\ud130 \ub85c\ucf00\uc774\uc158\uc5d0\uc11c \ud658\ud48d\uad6c \uc2dc\uc2a4\ud15c\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\uc774\ube0c \ub098\uc774\uce20 \uc5b4\ud2b8 \uc250\ub4dc \uc2dc\uc2a4\ud130 \ub85c\ucf00\uc774\uc158\uc5d0\uc11c \ud658\ud48d\uad6c \uc2dc\uc2a4\ud15c\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \uc560\ub2c8\uba54\uc774\uc158 \uce90\ub9ad\ud130\uac00 \uc8fc\uc694 \uc9c4\uc785 \uc9c0\uc810\uc73c\ub85c \uc0ac\uc6a9\ud558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \ud658\ud48d\uad6c\ub97c \ubd09\uc1c4\ud558\uba74 \ud380\ud0c0\uc784 \ud504\ub808\ub514\uc640 \uac19\uc740 \uc560\ub2c8\uba54\uc774\uc158 \uce90\ub9ad\ud130\uac00 \uadc0\ud558\uc758 \uc9c0\uc5ed\uc73c\ub85c \ub4e4\uc5b4\uc624\ub294 \uac83\uc744 \ub9c9\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud380\ud0c0\uc784 \ud504\ub808\ub514\uac00 \ud658\ud48d\uad6c \uadfc\ucc98\uc5d0 \uc788\ub294 \uac83\uc744 \uc54c\uc558\ub2e4\uba74 \uadf8\uc758 \uacbd\ub85c\ub97c \ucc28\ub2e8\ud558\uae30 \uc704\ud574 \uc2e0\uc18d\ud558\uac8c \ud658\ud48d\uad6c\ub97c \ubd09\uc1c4\ud558\uc138\uc694. [\ube44\uc720 \uc124\uba85: \ud658\ud48d\uad6c \uc2dc\uc2a4\ud15c\uc744 \uce68\uc785\uc790\uc5d0 \ub9de\uc120 \ub9c8\uc9c0\ub9c9 \ubc29\uc5b4\uc120\uc73c\ub85c \uc0dd\uac01\ud558\uc138\uc694. \uac01 \ubd09\uc1c4\ub294 \uce68\uc785\uc790\ub97c \ub9c9\ub294 \uc7a5\ubcbd\uc785\ub2c8\ub2e4.]"}, {"question": "\ud30c\uc774\ube0c \ub098\uc774\uce20 \uc5b4\ud2b8 \uc250\ub4dc \uc2dc\uc2a4\ud130 \ub85c\ucf00\uc774\uc158\uc5d0\uc11c \uc5ec\ub7ec \uc560\ub2c8\uba54\uc774\uc158 \uce90\ub9ad\ud130\ub97c \ucc98\ub9ac\ud558\ub294 \ub370 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\uc774\ube0c \ub098\uc774\uce20 \uc5b4\ud2b8 \uc250\ub4dc \uc2dc\uc2a4\ud130 \ub85c\ucf00\uc774\uc158\uc5d0\uc11c \uc5ec\ub7ec \uc560\ub2c8\uba54\uc774\uc158 \uce90\ub9ad\ud130\ub97c \ucc98\ub9ac\ud558\ub824\uba74 \ubaa8\ub2c8\ud130\ub9c1, \uc624\ub514\uc624 \uc720\uc778\ucc45 \ubc0f \ud658\ud48d\uad6c \ubd09\uc1c4\uc758 \uc870\ud569\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1 - \ubaa8\ub4e0 \uc560\ub2c8\uba54\uc774\uc158 \uce90\ub9ad\ud130\ub97c \ub3d9\uc2dc\uc5d0 \ucd94\uc801\ud558\uae30 \uc704\ud574 \ubaa8\ub2c8\ud130\ub97c \uc0ac\uc6a9\ud558\uc138\uc694. STEP2 - \uac00\uc7a5 \uc989\uac01\uc801\uc778 \uc704\ud611\uc744 \uc81c\uc2dc\ud558\ub294 \uc560\ub2c8\uba54\uc774\uc158 \uce90\ub9ad\ud130\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \uc120\ud0dd\ud558\uace0 \uc624\ub514\uc624 \uc720\uc778\ucc45\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc8fc\uc758\ub97c \uc0b0\ub9cc\ud558\uac8c \ud558\uc138\uc694. STEP3 - \ub2e4\ub978 \uc560\ub2c8\uba54\uc774\uc158 \uce90\ub9ad\ud130\uac00 \ub4e4\uc5b4\uc624\ub294 \uac83\uc744 \ub9c9\uae30 \uc704\ud574 \ud658\ud48d\uad6c\ub97c \ubd09\uc1c4\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ubca0\uc774\ube44\uc640 \ubc1c\ub85c\ub77c\uac00 \ubaa8\ub450 \ud65c\ub3d9 \uc911\uc774\ub77c\uba74 \ub354 \uacf5\uaca9\uc801\uc778 \ubca0\uc774\ube44\ub97c \uba3c\uc800 \uc9d1\uc911\ud558\uc138\uc694. [\uc124\uc815 \ube44\uad50\ud45c: \ubca0\uc774\ube44 - \uace0\uc704\ud611, \ubc1c\ub85c\ub77c - \uc911\uc704\ud611, \ud380\ud0c0\uc784 \ud504\ub808\ub514 - \uc800\uc704\ud611.]"}, {"question": "\ud30c\uc774\ube0c \ub098\uc774\uce20 \uc5b4\ud2b8 \uc250\ub4dc \uc2dc\uc2a4\ud130 \ub85c\ucf00\uc774\uc158\uc5d0\uc11c \uc560\ub2c8\uba54\uc774\uc158 \uce90\ub9ad\ud130 AI\ub294 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "\ud30c\uc774\ube0c \ub098\uc774\uce20 \uc5b4\ud2b8 \uc250\ub4dc \uc2dc\uc2a4\ud130 \ub85c\ucf00\uc774\uc158\uc758 \uc560\ub2c8\uba54\uc774\uc158 AI\ub294 \ud2b9\uc815 \ud589\ub3d9 \ubc0f \ud2b8\ub9ac\uac70\ub97c \uac00\uc9c0\uace0 \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uac01 \uc560\ub2c8\uba54\uc774\uc158 \uce90\ub9ad\ud130\ub294 \uace0\uc720\ud55c \uaddc\uce59 \uc9d1\ud569\uc744 \uac00\uc9c0\uace0 \uc788\uc73c\uba70, \uc774\ub294 \uadf8\ub4e4\uc758 \uc6c0\uc9c1\uc784\uacfc \ud589\ub3d9\uc744 \uc9c0\uc2dc\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubca0\uc774\ube44\ub294 \ud65c\ub3d9\uc744 \uac10\uc9c0\ud558\uc9c0 \uc54a\ub294 \ud55c \uc11c\ucee4\uc2a4 \uac24\ub7ec\ub9ac\uc5d0 \uba38\ubb3c\uace0, \ubc1c\ub85c\ub77c\ub294 \ub4e4\ub9ac\ub294 \uc18c\ub9ac\uc5d0 \uc6c0\uc9c1\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c AI \ud328\ud134\uc744 \uc774\ud574\ud558\uba74 \ud50c\ub808\uc774\uc5b4\ub294 \uadf8\ub4e4\uc758 \uc6c0\uc9c1\uc784\uc744 \uc608\uce21\ud558\uace0 \ub300\uc751\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \uc124\uba85: \uc560\ub2c8\uba54\uc774\uc158 AI \u2192 \ud589\ub3d9 \ud328\ud134 \u2192 \ud50c\ub808\uc774\uc5b4 \ud589\ub3d9 \u2192 \uc0dd\uc874.]"}, {"question": "\ud30c\uc774\ube0c \ub098\uc774\uce20 \uc5b4\ud2b8 \uc250\ub4dc \uc2dc\uc2a4\ud130 \ub85c\ucf00\uc774\uc158\uc5d0\uc11c \uc560\ub2c8\uba54\uc774\uc158 \uce90\ub9ad\ud130\ub4e4 \uc0ac\uc774\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\uc774\ube0c \ub098\uc774\uce20 \uc5b4\ud2b8 \uc250\ub4dc \uc2dc\uc2a4\ud130 \ub85c\ucf00\uc774\uc158\uc5d0\uc11c \uc560\ub2c8\uba54\uc774\uc158 \uce90\ub9ad\ud130\ub4e4 \uc0ac\uc774\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \uadf8\ub4e4\uc758 \ud589\ub3d9\uacfc \uc704\ud611 \uc218\uc900\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \ubca0\uc774\ube44\ub294 \ub9e4\uc6b0 \uacf5\uaca9\uc801\uc774\uba70 \ud65c\ub3d9\uc744 \uac10\uc9c0\ud558\uba74 \uacf5\uaca9\ud558\uc9c0\ub9cc, \ubc1c\ub85c\ub77c\ub294 \ub354 \uc218\ub3d9\uc801\uc774\uc9c0\ub9cc \uc18c\ub9ac\uc5d0 \uc6c0\uc9c1\uc785\ub2c8\ub2e4. \ubc18\uba74, \ud380\ud0c0\uc784 \ud504\ub808\ub514\ub294 \ub35c \uacf5\uaca9\uc801\uc774\uc9c0\ub9cc \uc801\uc808\ud788 \uad00\ub9ac\ud558\uc9c0 \uc54a\uc73c\uba74 \uc5ec\uc804\ud788 \uc704\ud611\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubca0\uc774\ube44\ub294 \uc9c0\uc18d\uc801\uc778 \ubaa8\ub2c8\ud130\ub9c1\uc774 \ud544\uc694\ud558\uc9c0\ub9cc \ubc1c\ub85c\ub77c\ub294 \uc624\ub514\uc624 \uc720\uc778\ucc45\uc73c\ub85c \uc0b0\ub9cc\ud558\uac8c \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc911 \uc804\ub7b5 \ube44\uad50: \ubca0\uc774\ube44 vs. \ubc1c\ub85c\ub77c vs. \ud380\ud0c0\uc784 \ud504\ub808\ub514 - \ubca0\uc774\ube44\uac00 \uac00\uc7a5 \uacf5\uaca9\uc801\uc774\uace0, \ubc1c\ub85c\ub77c\ub294 \uc18c\ub9ac\uc5d0 \ubbfc\uac10\ud558\uba70, \ud380\ud0c0\uc784 \ud504\ub808\ub514\ub294 \ub35c \uc704\ud611\uc801\uc785\ub2c8\ub2e4.]"}, {"question": "\ud30c\uc774\ube0c \ub098\uc774\uce20 \uc5b4\ud2b8 \uc250\ub4dc \uc2dc\uc2a4\ud130 \ub85c\ucf00\uc774\uc158\uc5d0\uc11c \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uc804\uc1a1\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\uc774\ube0c \ub098\uc774\uce20 \uc5b4\ud2b8 \uc250\ub4dc \uc2dc\uc2a4\ud130 \ub85c\ucf00\uc774\uc158\uc5d0\uc11c \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uc804\uc1a1\ud558\ub294 \uac83\uc740 \ub0b4\uc7a5\ub41c \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \uc800\uc7a5 \uae30\ub2a5\uc774 \uc5c6\uae30 \ub54c\ubb38\uc5d0 \uc5b4\ub824\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \ud604\uc7ac \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc800\uc7a5 \ub370\uc774\ud130\ub97c \ucc3e\uc544 \uc0c8 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec \uc800\uc7a5 \ud30c\uc77c\uc744 \uc218\ub3d9\uc73c\ub85c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \uc800\uc7a5 \ud30c\uc77c\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \uac8c\uc784 \uc124\uce58 \ub514\ub809\ud1a0\ub9ac\uc5d0 \uc800\uc7a5\ub418\uace0, \ucf58\uc194\uc5d0\uc11c\ub294 \uc678\ubd80 \uc800\uc7a5 \uc7a5\uce58\ub97c \uc0ac\uc6a9\ud574\uc57c \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc800\uc7a5 \ud30c\uc77c\uc740 \uc0c8 \ud50c\ub7ab\ud3fc \uc9c4\uc785\uc744 \uc704\ud574 \ub3c4\uc7a5\uc774 \ud544\uc694\ud55c \ub514\uc9c0\ud138 \uc5ec\uad8c\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ud30c\uc774\ube0c \ub098\uc774\uce20 \uc5b4\ud2b8 \uc250\ub4dc \uc2dc\uc2a4\ud130 \ub85c\ucf00\uc774\uc158\uc5d0\uc11c \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ub0b4\uc6a9\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\uc774\ube0c \ub098\uc774\uce20 \uc5b4\ud2b8 \uc250\ub4dc \uc2dc\uc2a4\ud130 \ub85c\ucf00\uc774\uc158\uc758 \uc228\uaca8\uc9c4 \ub0b4\uc6a9\uc5d0\ub294 \uac8c\uc784\uc758 \ubc30\uacbd \uc2a4\ud1a0\ub9ac\ub97c \ub354 \uc790\uc138\ud788 \ubcf4\uc5ec\uc8fc\ub294 \ube44\ubc00 \uc5d4\ub529\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud2b9\uc815 \ud589\ub3d9\uc744 \ub530\ub974\uace0 \ud2b9\uc815 \uc120\ud0dd\uc744 \ud568\uc73c\ub85c\uc368 \ud50c\ub808\uc774\uc5b4\ub294 \uc11c\ucee4\uc2a4 \ubca0\uc774\ube44\uc640 \uc560\ub2c8\uba54\uc774\uc158 \uce90\ub9ad\ud130\uc758 \uc774\uc57c\uae30\uc5d0 \ub300\ud55c \ub354 \uae4a\uc740 \ud1b5\ucc30\ub825\uc744 \uc81c\uacf5\ud558\ub294 '\uc9c4\uc2e4\ub41c \uc5d4\ub529'\uc744 \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc228\uaca8\uc9c4 \uc694\uc18c \ud0d0\uc0c9: \ud658\uacbd\uc5d0\uc11c \ubbf8\ubb18\ud55c \ub2e8\uc11c, \uc608\ub97c \ub4e4\uc5b4 \uc554\ud638\ud654\ub41c \uba54\uc2dc\uc9c0 \ub610\ub294 \ud2b9\uc774\ud55c \uc560\ub2c8\uba54\uc774\uc158 \uce90\ub9ad\ud130 \ud589\ub3d9\uc744 \ucc3e\uc73c\uc138\uc694. \uc774 \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uc744 \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}]
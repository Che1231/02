[{"question": "\u5982\u4f55\u5728\u300a\u7b2c\u4e94\u591c\uff1a\u8d39\u8fea\u5357\u8482\u59d0\u59b9\u7bc7\u300b\u4e2d\u4f5c\u4e3a\u65b0\u624b\u5ea6\u8fc7\u7b2c\u4e00\u4e2a\u591c\u665a\uff1f", "answer": "\u8981\u5728\u300a\u7b2c\u4e94\u591c\uff1a\u8d39\u8fea\u5357\u8482\u59d0\u59b9\u7bc7\u300b\u4e2d\u5ea6\u8fc7\u7b2c\u4e00\u4e2a\u591c\u665a\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u719f\u6089\u63a7\u5236\u9762\u677f\uff0c\u5176\u4e2d\u5305\u62ec\u663e\u793a\u5668\u3001\u97f3\u9891\u63d0\u793a\u548c\u901a\u98ce\u7cfb\u7edf\u3002\u6b65\u9aa42 - \u6301\u7eed\u5173\u6ce8\u663e\u793a\u5668\uff0c\u8ddf\u8e2a\u62df\u4eba\u89d2\u8272\u7684\u79fb\u52a8\uff0c\u7279\u522b\u662fBaby\u548cBallora\u3002\u6b65\u9aa43 - \u6709\u7b56\u7565\u5730\u4f7f\u7528\u97f3\u9891\u8bf1\u9975\uff0c\u5728\u62df\u4eba\u89d2\u8272\u9760\u8fd1\u65f6\u5206\u6563\u5b83\u4eec\u7684\u6ce8\u610f\u529b\u3002\u4f8b\u5982\uff0c\u5982\u679cBallora\u4ece\u5de6\u4fa7\u901a\u98ce\u53e3\u9760\u8fd1\uff0c\u5219\u64ad\u653e\u53f3\u4fa7\u7684\u97f3\u9891\u8bf1\u9975\u4ee5\u8f6c\u79fb\u5979\u7684\u6ce8\u610f\u529b\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u63a7\u5236\u9762\u677f\u89c6\u4e3a\u60a8\u7684\u6307\u6325\u4e2d\u5fc3\uff0c\u6bcf\u4e2a\u6309\u94ae\u90fd\u662f\u751f\u5b58\u7684\u6551\u547d\u7a3b\u8349\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u7406\u89e3\u300a\u7b2c\u4e94\u591c\uff1a\u8d39\u8fea\u5357\u8482\u59d0\u59b9\u7bc7\u300b\u4e2d\u62df\u4eba\u89d2\u8272\u7684\u884c\u4e3a\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u5728\u300a\u7b2c\u4e94\u591c\uff1a\u8d39\u8fea\u5357\u8482\u59d0\u59b9\u7bc7\u300b\u4e2d\u7406\u89e3\u62df\u4eba\u89d2\u8272\u7684\u884c\u4e3a\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u6bcf\u4e2a\u62df\u4eba\u89d2\u8272\u90fd\u6709\u72ec\u7279\u7684\u6a21\u5f0f\u548c\u89e6\u53d1\u56e0\u7d20\u3002\u4f8b\u5982\uff0cBaby\u503e\u5411\u4e8e\u7559\u5728\u9a6c\u620f\u56e2\u753b\u5eca\uff0c\u4f46\u5982\u679c\u5979\u68c0\u6d4b\u5230\u6d3b\u52a8\uff0c\u5979\u4f1a\u79fb\u52a8\u3002\u53e6\u4e00\u65b9\u9762\uff0cBallora\u5bf9\u58f0\u97f3\u654f\u611f\uff0c\u5982\u679c\u542c\u5230\u566a\u97f3\uff0c\u5979\u4f1a\u9760\u8fd1\u3002\u901a\u8fc7\u4e86\u89e3\u8fd9\u4e9b\u884c\u4e3a\uff0c\u60a8\u53ef\u4ee5\u9884\u6d4b\u4ed6\u4eec\u7684\u52a8\u4f5c\u5e76\u91c7\u53d6\u76f8\u5e94\u7684\u884c\u52a8\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1aBaby - \u9a6c\u620f\u56e2\u753b\u5eca\uff0cBallora - \u793c\u5802\uff0cFuntime Freddy - \u96f6\u90e8\u4ef6\u548c\u670d\u52a1\u3002]"}, {"question": "\u5728\u300a\u7b2c\u4e94\u591c\uff1a\u8d39\u8fea\u5357\u8482\u59d0\u59b9\u7bc7\u300b\u4e2d\u9700\u8981\u638c\u63e1\u54ea\u4e9b\u5fc5\u5907\u63a7\u5236\uff1f", "answer": "\u5728\u300a\u7b2c\u4e94\u591c\uff1a\u8d39\u8fea\u5357\u8482\u59d0\u59b9\u7bc7\u300b\u4e2d\u9700\u8981\u638c\u63e1\u7684\u5fc5\u5907\u63a7\u5236\u5305\u62ec\u663e\u793a\u5668\u3001\u97f3\u9891\u8bf1\u9975\u548c\u901a\u98ce\u7cfb\u7edf\u3002\u663e\u793a\u5668\u5141\u8bb8\u60a8\u8ddf\u8e2a\u62df\u4eba\u89d2\u8272\u7684\u4f4d\u7f6e\uff0c\u800c\u97f3\u9891\u8bf1\u9975\u53ef\u4ee5\u5206\u6563\u5b83\u4eec\u7684\u6ce8\u610f\u529b\u3002\u901a\u98ce\u7cfb\u7edf\u5bf9\u4e8e\u5c01\u9501\u5165\u53e3\u81f3\u5173\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5982\u679cFuntime Freddy\u9760\u8fd1\u901a\u98ce\u53e3\uff0c\u8bf7\u8fc5\u901f\u5c06\u5176\u5c01\u95ed\u4ee5\u9632\u6b62\u5176\u8fdb\u5165\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u663e\u793a\u5668 \u2192 \u8ddf\u8e2a\u62df\u4eba\u89d2\u8272 \u2192 \u4f7f\u7528\u97f3\u9891\u8bf1\u9975 \u2192 \u5c01\u95ed\u901a\u98ce\u53e3 \u2192 \u751f\u5b58\u3002]"}, {"question": "\u5982\u4f55\u5728\u300a\u7b2c\u4e94\u591c\uff1a\u8d39\u8fea\u5357\u8482\u59d0\u59b9\u7bc7\u300b\u4e2d\u4f18\u5316\u97f3\u9891\u8bf1\u9975\u7684\u4f7f\u7528\uff1f", "answer": "\u8981\u5728\u300a\u7b2c\u4e94\u591c\uff1a\u8d39\u8fea\u5357\u8482\u59d0\u59b9\u7bc7\u300b\u4e2d\u4f18\u5316\u97f3\u9891\u8bf1\u9975\u7684\u4f7f\u7528\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u8bc6\u522b\u54ea\u4e2a\u62df\u4eba\u89d2\u8272\u6b63\u5728\u9760\u8fd1\u3002\u6b65\u9aa42 - \u5728\u76f8\u53cd\u7684\u65b9\u5411\u64ad\u653e\u97f3\u9891\u8bf1\u9975\u4ee5\u8f6c\u79fb\u5b83\u4eec\u7684\u6ce8\u610f\u529b\u3002\u6b65\u9aa43 - \u76d1\u63a7\u5b83\u4eec\u7684\u79fb\u52a8\u4ee5\u786e\u4fdd\u8bf1\u9975\u6709\u6548\u3002\u4f8b\u5982\uff0c\u5982\u679cBallora\u671d\u60a8\u79fb\u52a8\uff0c\u8bf7\u5728\u793c\u5802\u64ad\u653e\u97f3\u9891\u8bf1\u9975\u4ee5\u5c06\u5b83\u5438\u5f15\u8d70\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u4f7f\u7528\u97f3\u9891\u8bf1\u9975\u4e0e\u5173\u95ed\u901a\u98ce\u53e3\u2014\u2014\u97f3\u9891\u8bf1\u9975\u6700\u9002\u5408\u5206\u6563\u6ce8\u610f\u529b\uff0c\u800c\u5173\u95ed\u901a\u98ce\u53e3\u66f4\u9002\u5408\u7acb\u5373\u9632\u5fa1\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u901a\u98ce\u7cfb\u7edf\u5728\u300a\u7b2c\u4e94\u591c\uff1a\u8d39\u8fea\u5357\u8482\u59d0\u59b9\u7bc7\u300b\u4e2d\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u300a\u7b2c\u4e94\u591c\uff1a\u8d39\u8fea\u5357\u8482\u59d0\u59b9\u7bc7\u300b\u4e2d\u7684\u901a\u98ce\u7cfb\u7edf\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u6784\u6210\u4e86\u62df\u4eba\u89d2\u8272\u7684\u4e3b\u8981\u5165\u53e3\u3002\u901a\u8fc7\u5173\u95ed\u901a\u98ce\u53e3\uff0c\u60a8\u53ef\u4ee5\u9632\u6b62Funtime Freddy\u4e4b\u7c7b\u7684\u62df\u4eba\u89d2\u8272\u8fdb\u5165\u60a8\u7684\u533a\u57df\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u53d1\u73b0Funtime Freddy\u9760\u8fd1\u901a\u98ce\u53e3\uff0c\u8bf7\u8fc5\u901f\u5c06\u5176\u5173\u95ed\u4ee5\u963b\u6b62\u4ed6\u7684\u8def\u5f84\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u901a\u98ce\u7cfb\u7edf\u89c6\u4e3a\u60a8\u7684\u6700\u540e\u4e00\u9053\u9632\u7ebf\uff0c\u5176\u4e2d\u6bcf\u4e2a\u5bc6\u5c01\u90fd\u662f\u5bf9\u5165\u4fb5\u8005\u7684\u5c4f\u969c\u3002]"}, {"question": "\u5728\u300a\u7b2c\u4e94\u591c\uff1a\u8d39\u8fea\u5357\u8482\u59d0\u59b9\u7bc7\u300b\u4e2d\u5982\u4f55\u5904\u7406\u591a\u4e2a\u62df\u4eba\u89d2\u8272\uff1f", "answer": "\u5728\u300a\u7b2c\u4e94\u591c\uff1a\u8d39\u8fea\u5357\u8482\u59d0\u59b9\u7bc7\u300b\u4e2d\u5904\u7406\u591a\u4e2a\u62df\u4eba\u89d2\u8272\u9700\u8981\u76d1\u63a7\u3001\u97f3\u9891\u8bf1\u9975\u548c\u901a\u98ce\u53e3\u5c01\u9501\u76f8\u7ed3\u5408\u3002\u6b65\u9aa41 - \u4f7f\u7528\u663e\u793a\u5668\u540c\u65f6\u8ddf\u8e2a\u6240\u6709\u62df\u4eba\u89d2\u8272\u3002\u6b65\u9aa42 - \u4f18\u5148\u8003\u8651\u54ea\u79cd\u62df\u4eba\u89d2\u8272\u6784\u6210\u6700\u76f4\u63a5\u7684\u5a01\u80c1\uff0c\u5e76\u4f7f\u7528\u97f3\u9891\u8bf1\u9975\u5206\u6563\u5b83\u4eec\u7684\u6ce8\u610f\u529b\u3002\u6b65\u9aa43 - \u5c01\u95ed\u901a\u98ce\u53e3\u4ee5\u9632\u6b62\u5176\u4ed6\u62df\u4eba\u89d2\u8272\u8fdb\u5165\u3002\u4f8b\u5982\uff0c\u5982\u679cBaby\u548cBallora\u90fd\u5904\u4e8e\u6d3b\u8dc3\u72b6\u6001\uff0c\u8bf7\u5148\u4e13\u6ce8\u4e8eBaby\uff0c\u56e0\u4e3a\u5b83\u53ef\u80fd\u66f4\u5177\u4fb5\u7565\u6027\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1aBaby - \u9ad8\u5a01\u80c1\uff0cBallora - \u4e2d\u7b49\u5a01\u80c1\uff0cFuntime Freddy - \u4f4e\u5a01\u80c1\u3002]"}, {"question": "\u300a\u7b2c\u4e94\u591c\uff1a\u8d39\u8fea\u5357\u8482\u59d0\u59b9\u7bc7\u300b\u4e2d\u7684\u62df\u4eba\u89d2\u8272AI\u662f\u5982\u4f55\u5de5\u4f5c\u7684\uff1f", "answer": "\u300a\u7b2c\u4e94\u591c\uff1a\u8d39\u8fea\u5357\u8482\u59d0\u59b9\u7bc7\u300b\u4e2d\u7684\u62df\u4eba\u89d2\u8272AI\u8bbe\u8ba1\u6709\u7279\u5b9a\u7684\u884c\u4e3a\u548c\u89e6\u53d1\u56e0\u7d20\u3002\u6bcf\u4e2a\u62df\u4eba\u89d2\u8272\u90fd\u6709\u5176\u72ec\u7279\u7684\u4e00\u7ec4\u89c4\u5219\uff0c\u51b3\u5b9a\u5b83\u4eec\u7684\u79fb\u52a8\u548c\u884c\u52a8\u3002\u4f8b\u5982\uff0cBaby\u4f1a\u7559\u5728\u9a6c\u620f\u56e2\u753b\u5eca\uff0c\u9664\u975e\u5979\u68c0\u6d4b\u5230\u6d3b\u52a8\uff0c\u5426\u5219Ballora\u4f1a\u671d\u5979\u542c\u5230\u7684\u58f0\u97f3\u79fb\u52a8\u3002\u7406\u89e3\u8fd9\u4e9bAI\u6a21\u5f0f\u5141\u8bb8\u73a9\u5bb6\u9884\u6d4b\u5e76\u53cd\u51fb\u4ed6\u4eec\u7684\u52a8\u4f5c\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u62df\u4eba\u89d2\u8272AI \u2192 \u884c\u4e3a\u6a21\u5f0f \u2192 \u73a9\u5bb6\u884c\u4e3a \u2192 \u751f\u5b58\u3002]"}, {"question": "\u300a\u7b2c\u4e94\u591c\uff1a\u8d39\u8fea\u5357\u8482\u59d0\u59b9\u7bc7\u300b\u4e2d\u62df\u4eba\u89d2\u8272\u4e4b\u95f4\u6709\u54ea\u4e9b\u5173\u952e\u533a\u522b\uff1f", "answer": "\u300a\u7b2c\u4e94\u591c\uff1a\u8d39\u8fea\u5357\u8482\u59d0\u59b9\u7bc7\u300b\u4e2d\u62df\u4eba\u89d2\u8272\u7684\u5173\u952e\u533a\u522b\u5728\u4e8e\u5b83\u4eec\u7684\u884c\u70ba\u548c\u5a01\u80c1\u7a0b\u5ea6\u3002Baby\u975e\u5e38\u5177\u6709\u4fb5\u7565\u6027\uff0c\u5982\u679c\u5979\u68c0\u6d4b\u5230\u6d3b\u52a8\u5c31\u4f1a\u653b\u51fb\uff0c\u800cBallora\u5219\u66f4\u88ab\u52a8\uff0c\u4f46\u4f1a\u671d\u4efb\u4f55\u58f0\u97f3\u79fb\u52a8\u3002\u53e6\u4e00\u65b9\u9762\uff0cFuntime Freddy\u5219\u4e0d\u592a\u5177\u6709\u4fb5\u7565\u6027\uff0c\u4f46\u5982\u679c\u7ba1\u7406\u4e0d\u5f53\u4ecd\u7136\u53ef\u80fd\u6784\u6210\u5a01\u80c1\u3002\u4f8b\u5982\uff0cBaby\u9700\u8981\u6301\u7eed\u76d1\u63a7\uff0c\u800cBallora\u53ef\u4ee5\u7528\u97f3\u9891\u8bf1\u9975\u5206\u6563\u6ce8\u610f\u529b\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1aBaby vs. Ballora vs. Funtime Freddy - Baby\u6700\u5177\u4fb5\u7565\u6027\uff0cBallora\u5bf9\u58f0\u97f3\u654f\u611f\uff0cFuntime Freddy\u5a01\u80c1\u8f83\u5c0f\u3002]"}, {"question": "\u5982\u4f55\u5728\u300a\u7b2c\u4e94\u591c\uff1a\u8d39\u8fea\u5357\u8482\u59d0\u59b9\u7bc7\u300b\u4e2d\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u6e38\u620f\u8fdb\u5ea6\uff1f", "answer": "\u7531\u4e8e\u7f3a\u4e4f\u5185\u7f6e\u7684\u8de8\u5e73\u53f0\u4fdd\u5b58\u529f\u80fd\uff0c\u5728\u300a\u7b2c\u4e94\u591c\uff1a\u8d39\u8fea\u5357\u8482\u59d0\u59b9\u7bc7\u300b\u4e2d\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u6e38\u620f\u8fdb\u5ea6\u53ef\u80fd\u5177\u6709\u6311\u6218\u6027\u3002\u4f46\u662f\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u67e5\u627e\u5f53\u524d\u5e73\u53f0\u4e0a\u7684\u5b58\u6863\u6570\u636e\u5e76\u5c06\u5176\u79fb\u52a8\u5230\u65b0\u5e73\u53f0\u6765\u624b\u52a8\u8f6c\u79fb\u5b58\u6863\u6587\u4ef6\u3002\u4f8b\u5982\uff0c\u5728PC\u4e0a\uff0c\u5b58\u6863\u6587\u4ef6\u901a\u5e38\u5b58\u50a8\u5728\u6e38\u620f\u7684\u5b89\u88c5\u76ee\u5f55\u4e2d\uff0c\u800c\u5728\u6e38\u620f\u673a\u4e0a\uff0c\u60a8\u53ef\u80fd\u9700\u8981\u4f7f\u7528\u5916\u90e8\u5b58\u50a8\u8bbe\u5907\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u5b58\u6863\u6587\u4ef6\u89c6\u4e3a\u9700\u8981\u5728\u8fdb\u5165\u65b0\u5e73\u53f0\u65f6\u76d6\u7ae0\u7684\u6570\u5b57\u62a4\u7167\u3002]"}, {"question": "\u5728\u300a\u7b2c\u4e94\u591c\uff1a\u8d39\u8fea\u5357\u8482\u59d0\u59b9\u7bc7\u300b\u4e2d\u53ef\u4ee5\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u5185\u5bb9\uff1f", "answer": "\u300a\u7b2c\u4e94\u591c\uff1a\u8d39\u8fea\u5357\u8482\u59d0\u59b9\u7bc7\u300b\u4e2d\u7684\u9690\u85cf\u5185\u5bb9\u5305\u62ec\u9690\u85cf\u7ed3\u5c40\u548c\u5f69\u86cb\uff0c\u8fd9\u4e9b\u7ed3\u5c40\u548c\u5f69\u86cb\u63ed\u793a\u4e86\u66f4\u591a\u6709\u5173\u6e38\u620f\u80cc\u666f\u7684\u6545\u4e8b\u3002\u4f8b\u5982\uff0c\u901a\u8fc7\u9075\u5faa\u7279\u5b9a\u884c\u52a8\u5e76\u505a\u51fa\u67d0\u4e9b\u9009\u62e9\uff0c\u73a9\u5bb6\u53ef\u4ee5\u89e3\u9501\u201c\u771f\u5b9e\u7ed3\u5c40\u201d\uff0c\u8fd9\u5c06\u66f4\u6df1\u5165\u5730\u4e86\u89e3\u5c0f\u4e11\u8d1d\u6bd4\u548c\u62df\u4eba\u89d2\u8272\u7684\u6545\u4e8b\u3002[\u5f69\u86cb\u6316\u6398\uff1a\u5bfb\u627e\u73af\u5883\u4e2d\u7684\u7ec6\u5fae\u7ebf\u7d22\uff0c\u4f8b\u5982\u795e\u79d8\u4fe1\u606f\u6216\u4e0d\u5bfb\u5e38\u7684\u62df\u4eba\u89d2\u8272\u884c\u4e3a\uff0c\u4ee5\u53d1\u73b0\u8fd9\u4e9b\u9690\u85cf\u7684\u73cd\u5b9d\u3002]"}]
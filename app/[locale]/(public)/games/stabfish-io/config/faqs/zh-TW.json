[{"question": "\u65b0\u624b\u5982\u4f55\u5728 Stabfish.io \u63a7\u5236\u6211\u7684\u9b5a\uff1f", "answer": "\u5728 Stabfish.io \u4e2d\uff0c\u63a7\u5236\u4f60\u7684\u9b5a\u5f88\u5bb9\u6613\u3002\u4f7f\u7528\u65b9\u5411\u9375\u6216 WASD \u9375\u79fb\u52d5\u3002\u4f8b\u5982\uff0c\u6309\u4e0b \"\u5411\u4e0a\" \u7bad\u982d\u4f86\u5411\u524d\u904a\u52d5\u3002\u7a7a\u683c\u9375\u53ef\u4ee5\u8b93\u4f60\u523a\u7a7f\u5176\u4ed6\u9b5a\u3002\u5efa\u8b70\u5148\u5728\u6dfa\u6c34\u5340\u7df4\u7fd2\uff0c\u719f\u6089\u64cd\u4f5c\u3002\u8a18\u4f4f\uff0c\u7cbe\u78ba\u7684\u64cd\u4f5c\u662f\u751f\u5b58\u548c\u8301\u58ef\u6210\u9577\u7684\u95dc\u9375\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u7684\u9b5a\u5728 Stabfish.io \u4e2d\u4e0d\u65b7\u6b7b\u4ea1\uff1f", "answer": "\u4f60\u7684\u9b5a\u53ef\u80fd\u56e0\u70ba\u6575\u5c0d\u7684\u73a9\u5bb6\u6216\u74b0\u5883\u7684\u5371\u96aa\u800c\u6b7b\u4ea1\u3002\u4f8b\u5982\uff0c\u8f03\u5927\u7684\u9b5a\u5f88\u5bb9\u6613\u58d3\u5012\u8f03\u5c0f\u7684\u9b5a\u3002\u70ba\u4e86\u751f\u5b58\uff0c\u521d\u671f\u61c9\u907f\u514d\u885d\u7a81\uff0c\u5c08\u6ce8\u65bc\u5403\u6389\u8f03\u5c0f\u7684\u9b5a\u4f86\u6210\u9577\u3002\u5584\u7528\u74b0\u5883\uff0c\u8eb2\u85cf\u5728\u6d77\u85fb\u6216\u73ca\u745a\u7901\u4e2d\u3002"}, {"question": "Stabfish.io \u7684\u57fa\u672c\u76ee\u6a19\u662f\u4ec0\u9ebc\uff1f", "answer": "Stabfish.io \u7684\u4e3b\u8981\u76ee\u6a19\u662f\u901a\u904e\u5403\u6389\u8f03\u5c0f\u7684\u9b5a\u4f86\u8b93\u4f60\u7684\u9b5a\u6210\u9577\uff0c\u4e26\u907f\u514d\u88ab\u8f03\u5927\u7684\u9b5a\u5403\u6389\u3002\u4f8b\u5982\uff0c\u5148\u7784\u6e96\u6700\u5c0f\u7684\u9b5a\uff0c\u7136\u5f8c\u96a8\u8457\u6210\u9577\uff0c\u9010\u6f38\u8f49\u5411\u66f4\u5927\u7684\u7375\u7269\u3002\u904a\u6232\u734e\u52f5\u7b56\u7565\u6027\u73a9\u6cd5\u548c\u5feb\u901f\u53cd\u61c9\uff0c\u6240\u4ee5\u59cb\u7d42\u7559\u610f\u9032\u5c55\u7684\u6a5f\u6703\u3002"}, {"question": "\u5728\u73a9 Stabfish.io 100 \u5c0f\u6642\u5f8c\uff0c\u5982\u4f55\u6539\u5584\u6211\u7684\u751f\u5b58\u7b56\u7565\uff1f", "answer": "100 \u5c0f\u6642\u4ee5\u5f8c\uff0c\u61c9\u8457\u91cd\u65bc\u9032\u968e\u7b56\u7565\u3002\u6b65\u9a5f\u4e00\uff1a\u638c\u63e1\u57cb\u4f0f\u7684\u6280\u5de7\uff0c\u8eb2\u85cf\u5728\u6d77\u85fb\u4e2d\u3002\u6b65\u9a5f\u4e8c\uff1a\u5229\u7528\u74b0\u5883\u9677\u9631\u8f03\u5927\u7684\u9b5a\u3002\u6b65\u9a5f\u4e09\uff1a\u59cb\u7d42\u7559\u610f\u8ff7\u4f60\u5730\u5716\uff0c\u9810\u6e2c\u5a01\u8105\u3002\u4f8b\u5982\uff0c\u5f15\u8a98\u8f03\u5927\u7684\u9b5a\u9032\u5165\u72f9\u7a84\u7684\u901a\u9053\uff0c\u53ef\u4ee5\u8b93\u4f60\u6709\u512a\u52e2\u3002"}, {"question": "\u5728 Stabfish.io \u4e2d\uff0c\u70ba\u4e86\u6700\u5927\u7a0b\u5ea6\u7684\u6210\u9577\uff0c\u6211\u61c9\u8a72\u5148\u7784\u6e96\u54ea\u7a2e\u9b5a\uff1f", "answer": "\u9996\u5148\u7784\u6e96\u6700\u5c0f\u7684\u9b5a\uff0c\u4f8b\u5982 \"\u5c0f\u9b5a\"\u3002\u9019\u4e9b\u9b5a\u66f4\u5bb9\u6613\u6355\u6349\uff0c\u4e26\u63d0\u4f9b\u521d\u671f\u6240\u9700\u7684\u6210\u9577\u3002\u96a8\u8457\u6210\u9577\uff0c\u53ef\u4ee5\u8f49\u5411\u8f03\u5927\u7684\u9b5a\uff0c\u4f8b\u5982 \"\u9bd6\u9b5a\"\u3002\u4f8b\u5982\uff0c\u5f9e\u5c0f\u9b5a\u958b\u59cb\uff0c\u53ef\u4ee5\u8b93\u4f60\u5efa\u7acb\u4fe1\u5fc3\u548c\u6280\u5de7\uff0c\u7136\u5f8c\u518d\u61c9\u5c0d\u66f4\u5177\u6311\u6230\u6027\u7684\u7375\u7269\u3002"}, {"question": "\u5728 Stabfish.io \u4e2d\u5982\u4f55\u8655\u7406\u591a\u500b\u5c0d\u624b\uff1f", "answer": "\u8655\u7406\u591a\u500b\u5c0d\u624b\u9700\u8981\u7b56\u7565\u3002\u6b65\u9a5f\u4e00\uff1a\u5584\u7528\u74b0\u5883\uff0c\u85c9\u7531\u96b1\u85cf\u4f86\u7372\u5f97\u512a\u52e2\u3002\u6b65\u9a5f\u4e8c\uff1a\u4e00\u6b21\u5c08\u6ce8\u65bc\u4e00\u500b\u5c0d\u624b\uff0c\u4ee5\u6e1b\u5c11\u5c0d\u624b\u7684\u6578\u91cf\u3002\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u5feb\u901f\u79fb\u52d5\u4f86\u907f\u514d\u88ab\u5305\u570d\u3002\u4f8b\u5982\uff0c\u8eb2\u85cf\u5728\u73ca\u745a\u7901\u4e2d\u53ef\u4ee5\u63d0\u4f9b\u66ab\u6642\u7684\u5b89\u5168\u6027\uff0c\u8b93\u4f60\u53ef\u4ee5\u8a08\u5283\u4e0b\u4e00\u6b65\u7684\u884c\u52d5\u3002"}, {"question": "Stabfish.io \u7684\u6210\u9577\u6a5f\u5236\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "Stabfish.io \u7684\u6210\u9577\u6a5f\u5236\u57fa\u65bc\u4f60\u5403\u7684\u9b5a\u3002\u4f60\u5403\u6389\u7684\u6bcf\u689d\u9b5a\u90fd\u6703\u589e\u52a0\u4f60\u7684\u9ad4\u578b\u548c\u529b\u91cf\u3002\u4f8b\u5982\uff0c\u5403\u4e00\u689d \"\u5c0f\u9b5a\" \u6703\u5e36\u4f86\u5fae\u5c0f\u7684\u6210\u9577\u63d0\u5347\uff0c\u800c\u4e00\u689d \"\u9bd6\u9b5a\" \u5247\u6703\u5e36\u4f86\u66f4\u5927\u7684\u63d0\u5347\u3002\u904a\u6232\u4f7f\u7528\u7dda\u6027\u6210\u9577\u6a21\u578b\uff0c\u610f\u5473\u8457\u6301\u7e8c\u9032\u98df\u6703\u5c0e\u81f4\u7a69\u5b9a\u7684\u6210\u9577\u3002"}, {"question": "Stabfish.io \u4e2d\u6dfa\u6c34\u5340\u548c\u6df1\u6c34\u5340\u7684\u95dc\u9375\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "\u6dfa\u6c34\u5340\u6bd4\u8f03\u5b89\u5168\uff0c\u4f46\u9b5a\u8f03\u5c0f\uff1b\u6df1\u6c34\u5340\u98a8\u96aa\u8f03\u9ad8\uff0c\u9b5a\u8f03\u5927\u4e14\u8f03\u5177\u4fb5\u7565\u6027\u3002\u4f8b\u5982\uff0c\u65b0\u624b\u61c9\u5f9e\u6dfa\u6c34\u5340\u958b\u59cb\uff0c\u5efa\u7acb\u6280\u5de7\u3002\u6df1\u6c34\u5340\u63d0\u4f9b\u66f4\u5927\u7684\u734e\u52f5\uff0c\u4f46\u9700\u8981\u66f4\u9032\u968e\u7684\u7b56\u7565\u4f86\u61c9\u5c0d\u589e\u52a0\u7684\u5371\u96aa\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5728 Stabfish.io \u4e2d\u5c07\u6211\u7684\u9032\u5ea6\u8f49\u79fb\u5230\u53e6\u4e00\u53f0\u88dd\u7f6e\u4e0a\u55ce\uff1f", "answer": "\u53ef\u4ee5\uff0c\u4f60\u53ef\u4ee5\u901a\u904e\u5c07\u4f60\u7684\u904a\u6232\u5e33\u6236\u9023\u7d50\u5230\u96f2\u7aef\u670d\u52d9\u4f86\u8f49\u79fb\u4f60\u7684\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u4f7f\u7528 Google Play \u6216 Apple Game Center \u4f86\u5132\u5b58\u4f60\u7684\u8cc7\u6599\u3002\u9019\u5141\u8a31\u4f60\u53ef\u4ee5\u5728\u53e6\u4e00\u53f0\u88dd\u7f6e\u4e0a\u7e7c\u7e8c\u4f60\u7684\u904a\u6232\uff0c\u800c\u4e0d\u6703\u5931\u53bb\u9032\u5ea6\u3002\u8acb\u78ba\u4fdd\u4f60\u540c\u6642\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u5728\u5169\u53f0\u88dd\u7f6e\u4e0a\u3002"}, {"question": "Stabfish.io \u4e2d\u662f\u5426\u6709\u4efb\u4f55\u96b1\u85cf\u5f69\u86cb\uff1f", "answer": "\u662f\u7684\uff0cStabfish.io \u6709\u96b1\u85cf\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u5728\u73ca\u745a\u7901\u9644\u8fd1\u4ee5\u7279\u5b9a\u6a21\u5f0f\u904a\u52d5\u53ef\u4ee5\u63ed\u9732\u96b1\u85cf\u7684\u5bf6\u7bb1\u3002\u9019\u4e9b\u5f69\u86cb\u901a\u5e38\u6703\u734e\u52f5\u73a9\u5bb6\u7368\u7279\u7684\u7269\u54c1\u6216\u734e\u52f5\uff0c\u70ba\u904a\u6232\u589e\u52a0\u984d\u5916\u7684\u6a02\u8da3\u548c\u767c\u73fe\u3002"}]
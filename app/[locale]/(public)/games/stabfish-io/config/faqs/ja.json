[{"question": "\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001Stabfish.io\u3067\u9b5a\u3092\u3069\u306e\u3088\u3046\u306b\u5236\u5fa1\u3057\u307e\u3059\u304b\uff1f", "answer": "Stabfish.io\u3067\u306f\u3001\u9b5a\u306e\u5236\u5fa1\u306f\u7c21\u5358\u3067\u3059\u3002\u77e2\u5370\u30ad\u30fc\u307e\u305f\u306fWASD\u30ad\u30fc\u3092\u4f7f\u7528\u3057\u3066\u79fb\u52d5\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u524d\u65b9\u306b\u6cf3\u3050\u306b\u306f\u3001\u4e0a\u77e2\u5370\u30ad\u30fc\u3092\u62bc\u3057\u307e\u3059\u3002\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u3092\u62bc\u3059\u3068\u3001\u4ed6\u306e\u9b5a\u3092\u7a81\u304d\u523a\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u307e\u305a\u6d45\u702c\u3067\u7df4\u7fd2\u3057\u3066\u3001\u64cd\u4f5c\u306b\u6163\u308c\u3066\u304f\u3060\u3055\u3044\u3002\u751f\u5b58\u3057\u3001\u7e41\u6804\u3059\u308b\u306b\u306f\u3001\u6b63\u78ba\u6027\u304c\u91cd\u8981\u3067\u3059\u3002"}, {"question": "\u306a\u305cStabfish.io\u3067\u9b5a\u304c\u6b7b\u306b\u7d9a\u3051\u308b\u306e\u3067\u3059\u304b\uff1f", "answer": "\u9b5a\u304c\u6b7b\u306b\u7d9a\u3051\u308b\u306e\u306f\u3001\u653b\u6483\u7684\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u3084\u74b0\u5883\u4e0a\u306e\u5371\u967a\u304c\u539f\u56e0\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u4f8b\u3048\u3070\u3001\u3088\u308a\u5927\u304d\u306a\u9b5a\u306f\u7c21\u5358\u306b\u5c0f\u3055\u306a\u9b5a\u3092\u5727\u5012\u3067\u304d\u307e\u3059\u3002\u751f\u304d\u6b8b\u308b\u305f\u3081\u306b\u3001\u521d\u671f\u6bb5\u968e\u3067\u5bfe\u6c7a\u3092\u907f\u3051\u3001\u5c0f\u3055\u306a\u9b5a\u3092\u98df\u3079\u3066\u6210\u9577\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u6d77\u85fb\u3084\u30b5\u30f3\u30b4\u7901\u306b\u96a0\u308c\u308b\u3053\u3068\u3067\u3001\u74b0\u5883\u3092\u6709\u5229\u306b\u6d3b\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "Stabfish.io\u306e\u57fa\u672c\u7684\u306a\u76ee\u7684\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Stabfish.io\u306e\u57fa\u672c\u7684\u306a\u76ee\u7684\u306f\u3001\u3088\u308a\u5c0f\u3055\u3044\u9b5a\u3092\u98df\u3079\u3066\u9b5a\u3092\u5927\u304d\u304f\u3057\u3001\u3088\u308a\u5927\u304d\u306a\u9b5a\u306b\u98df\u3079\u3089\u308c\u308b\u306e\u3092\u907f\u3051\u308b\u3053\u3068\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u307e\u305a\u4e00\u756a\u5c0f\u3055\u306a\u9b5a\u3092\u30bf\u30fc\u30b2\u30c3\u30c8\u306b\u3057\u3066\u3001\u6210\u9577\u3059\u308b\u306b\u3064\u308c\u3066\u5f90\u3005\u306b\u5927\u304d\u306a\u7372\u7269\u306b\u79fb\u884c\u3057\u307e\u3059\u3002\u3053\u306e\u30b2\u30fc\u30e0\u306f\u6226\u7565\u7684\u306a\u30d7\u30ec\u30a4\u3068\u7d20\u65e9\u3044\u53cd\u5fdc\u3092\u8a55\u4fa1\u3059\u308b\u305f\u3081\u3001\u5e38\u306b\u524d\u9032\u3059\u308b\u6a5f\u4f1a\u3092\u63a2\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001Stabfish.io\u306e\u751f\u5b58\u6226\u7565\u3092\u3069\u306e\u3088\u3046\u306b\u6539\u5584\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u9ad8\u5ea6\u306a\u6226\u8853\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u624b\u98061\uff1a\u6d77\u85fb\u306e\u4e2d\u306b\u96a0\u308c\u308b\u3053\u3068\u3067\u3001\u5f85\u3061\u4f0f\u305b\u306e\u6280\u8853\u3092\u7fd2\u5f97\u3057\u307e\u3059\u3002\u624b\u98062\uff1a\u74b0\u5883\u3092\u5229\u7528\u3057\u3066\u5927\u304d\u306a\u9b5a\u3092\u7f60\u306b\u306f\u3081\u307e\u3059\u3002\u624b\u98063\uff1a\u30df\u30cb\u30de\u30c3\u30d7\u3092\u5e38\u306b\u6ce8\u610f\u3057\u3066\u3001\u8105\u5a01\u3092\u4e88\u6e2c\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5927\u304d\u306a\u9b5a\u3092\u72ed\u3044\u901a\u8def\u306b\u8a98\u3044\u8fbc\u3080\u3053\u3068\u3067\u3001\u512a\u4f4d\u306b\u7acb\u3066\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Stabfish.io\u3067\u6700\u5927\u9650\u306e\u6210\u9577\u306e\u305f\u3081\u306b\u3001\u6700\u521d\u306b\u3069\u306e\u9b5a\u3092\u30bf\u30fc\u30b2\u30c3\u30c8\u306b\u3059\u308b\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u6700\u521d\u306b\u4e00\u756a\u5c0f\u3055\u306a\u9b5a\u3001\u4f8b\u3048\u3070\u300e\u30cb\u30b7\u30f3\u300f\u3092\u30bf\u30fc\u30b2\u30c3\u30c8\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u3089\u306f\u6355\u307e\u3048\u3084\u3059\u304f\u3001\u521d\u671f\u306e\u6210\u9577\u306b\u5fc5\u8981\u306a\u6804\u990a\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u6210\u9577\u3059\u308b\u306b\u3064\u308c\u3066\u3001\u300e\u30b5\u30d0\u300f\u306e\u3088\u3046\u306a\u5927\u304d\u306a\u9b5a\u306b\u79fb\u308a\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u30cb\u30b7\u30f3\u304b\u3089\u59cb\u3081\u308b\u3068\u3001\u3088\u308a\u6311\u6226\u7684\u306a\u7372\u7269\u306b\u53d6\u308a\u7d44\u3080\u524d\u306b\u81ea\u4fe1\u3068\u30b9\u30ad\u30eb\u3092\u7bc9\u304f\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Stabfish.io\u3067\u8907\u6570\u306e\u6575\u3092\u3069\u306e\u3088\u3046\u306b\u5bfe\u51e6\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u8907\u6570\u306e\u6575\u306b\u5bfe\u51e6\u3059\u308b\u306b\u306f\u3001\u6226\u7565\u304c\u5fc5\u8981\u3067\u3059\u3002\u624b\u98061\uff1a\u96a0\u308c\u308b\u3053\u3068\u3067\u74b0\u5883\u3092\u6709\u5229\u306b\u6d3b\u7528\u3057\u307e\u3059\u3002\u624b\u98062\uff1a\u4e00\u5ea6\u306b1\u4eba\u306e\u6575\u306b\u96c6\u4e2d\u3057\u3066\u3001\u6575\u6570\u3092\u6e1b\u3089\u3057\u307e\u3059\u3002\u624b\u98063\uff1a\u56f2\u307e\u308c\u306a\u3044\u3088\u3046\u306b\u7d20\u65e9\u304f\u79fb\u52d5\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b5\u30f3\u30b4\u7901\u306b\u96a0\u308c\u308b\u3053\u3068\u306f\u3001\u6b21\u306e\u624b\u3092\u8a08\u753b\u3059\u308b\u9593\u306b\u4e00\u6642\u7684\u306a\u5b89\u5168\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002"}, {"question": "Stabfish.io\u306e\u6210\u9577\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "Stabfish.io\u306e\u6210\u9577\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u3042\u306a\u305f\u304c\u98df\u3079\u308b\u9b5a\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u305d\u308c\u305e\u308c\u306e\u9b5a\u3092\u6d88\u8cbb\u3059\u308b\u305f\u3073\u306b\u3001\u3042\u306a\u305f\u306e\u30b5\u30a4\u30ba\u3068\u5f37\u3055\u304c\u5897\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u30cb\u30b7\u30f3\u300f\u3092\u98df\u3079\u308b\u3053\u3068\u3067\u308f\u305a\u304b\u306b\u6210\u9577\u3057\u307e\u3059\u304c\u3001\u300e\u30b5\u30d0\u300f\u3092\u98df\u3079\u308b\u3053\u3068\u3067\u3088\u308a\u5927\u304d\u306a\u6210\u9577\u3092\u5f97\u3089\u308c\u307e\u3059\u3002\u3053\u306e\u30b2\u30fc\u30e0\u306f\u76f4\u7dda\u7684\u306a\u6210\u9577\u30e2\u30c7\u30eb\u3092\u4f7f\u7528\u3057\u3066\u304a\u308a\u3001\u7d99\u7d9a\u7684\u306a\u98df\u4e8b\u306b\u3088\u308a\u7740\u5b9f\u306b\u6210\u9577\u3059\u308b\u3067\u3057\u3087\u3046\u3002"}, {"question": "Stabfish.io\u306e\u6d45\u702c\u3068\u6df1\u702c\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u6d45\u702c\u306f\u5b89\u5168\u3067\u3059\u304c\u3001\u9b5a\u306f\u5c0f\u3055\u304f\u3001\u6df1\u702c\u306f\u5371\u967a\u3067\u3001\u3088\u308a\u5927\u304d\u304f\u3001\u653b\u6483\u7684\u306a\u9b5a\u304c\u751f\u606f\u3057\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u521d\u5fc3\u8005\u306f\u30b9\u30ad\u30eb\u3092\u990a\u6210\u3059\u308b\u305f\u3081\u306b\u3001\u6d45\u702c\u304b\u3089\u59cb\u3081\u308b\u3079\u304d\u3067\u3059\u3002\u6df1\u702c\u306f\u5927\u304d\u306a\u5831\u916c\u3092\u63d0\u4f9b\u3057\u307e\u3059\u304c\u3001\u5371\u967a\u304c\u5897\u52a0\u3059\u308b\u306e\u3067\u3001\u305d\u308c\u3092\u4e57\u308a\u8d8a\u3048\u308b\u305f\u3081\u306e\u9ad8\u5ea6\u306a\u6226\u7565\u304c\u5fc5\u8981\u3067\u3059\u3002"}, {"question": "Stabfish.io\u306e\u9032\u6357\u72b6\u6cc1\u3092\u5225\u306e\u30c7\u30d0\u30a4\u30b9\u306b\u79fb\u3059\u3053\u3068\u306f\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001
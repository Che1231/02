[{"question": "\ucd08\ubcf4\uc790\uac00 Stabfish.io\uc5d0\uc11c \ubb3c\uace0\uae30\ub97c \uc5b4\ub5bb\uac8c \uc81c\uc5b4\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Stabfish.io\uc5d0\uc11c \ubb3c\uace0\uae30\ub97c \uc81c\uc5b4\ud558\ub294 \uac83\uc740 \uac04\ub2e8\ud569\ub2c8\ub2e4. \ud654\uc0b4\ud45c \ud0a4 \ub610\ub294 WASD\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc774\ub3d9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc55e\uc73c\ub85c \ud5e4\uc5c4\uce58\ub824\uba74 \uc704\ucabd \ud654\uc0b4\ud45c \ud0a4\ub97c \ub204\ub974\uc138\uc694. \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \ub20c\ub7ec \ub2e4\ub978 \ubb3c\uace0\uae30\ub97c \uacf5\uaca9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ucc98\uc74c\uc5d0\ub294 \uc595\uc740 \uc9c0\uc5ed\uc5d0\uc11c \uc5f0\uc2b5\ud558\uc5ec \uc870\uc791\uac10\uc744 \uc775\ud788\uc138\uc694. \uc0dd\uc874\uacfc \ubc88\uc601\uc744 \uc704\ud574 \uc815\ud655\uc131\uc774 \uc911\uc694\ud569\ub2c8\ub2e4."}, {"question": "Stabfish.io\uc5d0\uc11c \ubb3c\uace0\uae30\uac00 \uacc4\uc18d \uc8fd\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uc8e0?", "answer": "\ubb3c\uace0\uae30\uac00 \uacf5\uaca9\uc801\uc778 \ud50c\ub808\uc774\uc5b4\ub098 \ud658\uacbd\uc801 \uc704\ud5d8\uc73c\ub85c \uc778\ud574 \uc8fd\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud070 \ubb3c\uace0\uae30\ub294 \uc791\uc740 \ubb3c\uace0\uae30\ub97c \uc27d\uac8c \uc81c\uc555\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc0dd\uc874\ud558\uae30 \uc704\ud574\uc11c\ub294 \ucc98\uc74c\uc5d0\ub294 \ucda9\ub3cc\uc744 \ud53c\ud558\uace0 \uc791\uc740 \ubb3c\uace0\uae30\ub97c \uba39\uc5b4 \ud06c\uae30\ub97c \ud0a4\uc6b0\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \ud574\ucd08\ub098 \uc0b0\ud638\ucd08\uc5d0 \uc228\uc5b4 \ud658\uacbd\uc744 \ud65c\uc6a9\ud558\uc138\uc694."}, {"question": "Stabfish.io\uc758 \uae30\ubcf8 \ubaa9\ud45c\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Stabfish.io\uc758 \uc8fc\uc694 \ubaa9\ud45c\ub294 \uc791\uc740 \ubb3c\uace0\uae30\ub97c \uba39\uc5b4 \ubb3c\uace0\uae30\uc758 \ud06c\uae30\ub97c \ud0a4\uc6b0\uace0 \ub354 \ud070 \ubb3c\uace0\uae30\uc5d0 \uba39\ud788\uc9c0 \uc54a\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac00\uc7a5 \uc791\uc740 \ubb3c\uace0\uae30\ub97c \uba3c\uc800 \uacf5\ub7b5\ud558\uace0 \uc810\ucc28\uc801\uc73c\ub85c \uc131\uc7a5\ud568\uc5d0 \ub530\ub77c \ub354 \ud070 \uba39\uc787\uac10\uc73c\ub85c \uc774\ub3d9\ud558\uc138\uc694. \uc774 \uac8c\uc784\uc740 \uc804\ub7b5\uc801\uc778 \ud50c\ub808\uc774\uc640 \ube60\ub978 \ubc18\uc751 \uc18d\ub3c4\ub97c \ubcf4\uc0c1\ud558\ubbc0\ub85c \ud56d\uc0c1 \ubc1c\uc804\ud560 \uae30\ud68c\ub97c \uc0b4\ud3b4\ubcf4\uc138\uc694."}, {"question": "100\uc2dc\uac04 \ub3d9\uc548 Stabfish.io\uc5d0\uc11c \uc0dd\uc874 \uc804\ub7b5\uc744 \uc5b4\ub5bb\uac8c \uac1c\uc120\ud560 \uc218 \uc788\ub098\uc694?", "answer": "100\uc2dc\uac04\uc774 \uc9c0\ub09c \ud6c4\uc5d0\ub294 \uace0\uae09 \uc804\uc220\uc5d0 \uc9d1\uc911\ud558\uc138\uc694. STEP1: \ud574\ucd08\uc5d0 \uc228\uc5b4 \ub9e4\ubcf5\ud558\ub294 \uae30\uc220\uc744 \uc775\ud788\uc138\uc694. STEP2: \ud658\uacbd\uc744 \ud65c\uc6a9\ud558\uc5ec \ub354 \ud070 \ubb3c\uace0\uae30\ub97c \uc7a1\uc73c\uc138\uc694. STEP3: \ubbf8\ub2c8\ub9f5\uc744 \ud56d\uc0c1 \uc8fc\uc2dc\ud558\uc5ec \uc704\ud611\uc744 \uc608\uce21\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub354 \ud070 \ubb3c\uace0\uae30\ub97c \uc881\uc740 \ud1b5\ub85c\ub85c \uc720\uc778\ud558\uba74 \uc6b0\uc704\ub97c \uc810\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Stabfish.io\uc5d0\uc11c \ucd5c\ub300 \uc131\uc7a5\uc744 \uc704\ud574 \uba3c\uc800 \uc5b4\ub5a4 \ubb3c\uace0\uae30\ub97c \ub178\ub824\uc57c \ud558\ub098\uc694?", "answer": "\uac00\uc7a5 \uc791\uc740 \ubb3c\uace0\uae30, \uc608\ub97c \ub4e4\uc5b4 \"\uc789\uc5b4\"\ub97c \uba3c\uc800 \ub178\ub824\uc57c \ud569\ub2c8\ub2e4. \uc774 \ubb3c\uace0\uae30\ub294 \uc7a1\uae30\uac00 \uc27d\uace0 \ucd08\uae30 \uc131\uc7a5\uc5d0 \ud544\uc694\ud55c \uc591\ubd84\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc131\uc7a5\ud568\uc5d0 \ub530\ub77c \"\uaf41\uce58\"\uc640 \uac19\uc740 \ub354 \ud070 \ubb3c\uace0\uae30\ub85c \ub118\uc5b4\uac00\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc789\uc5b4\ub85c \uc2dc\uc791\ud558\uba74 \ub354 \uc5b4\ub824\uc6b4 \uba39\uc787\uac10\uc744 \ucc98\ub9ac\ud558\uae30 \uc804\uc5d0 \uc790\uc2e0\uac10\uacfc \uae30\uc220\uc744 \uc313\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Stabfish.io\uc5d0\uc11c \uc5ec\ub7ec \uc0c1\ub300\ub97c \uc5b4\ub5bb\uac8c \ucc98\ub9ac\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc5ec\ub7ec \uc0c1\ub300\ub97c \ucc98\ub9ac\ud558\ub824\uba74 \uc804\ub7b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \ud658\uacbd\uc744 \ud65c\uc6a9\ud558\uc5ec \uc228\uc73c\uc138\uc694. STEP2: \ud55c \ubc88\uc5d0 \ud55c \uc0c1\ub300\uc5d0\uac8c \uc9d1\uc911\ud558\uc5ec \uc218\ub97c \uc904\uc774\uc138\uc694. STEP3: \ub458\ub7ec\uc2f8\uc774\uc9c0 \uc54a\ub3c4\ub85d \ube60\ub974\uac8c \uc774\ub3d9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4 \uc0b0\ud638\ucd08\uc5d0 \uc228\uc73c\uba74 \ub2e4\uc74c \ud589\ub3d9\uc744 \uacc4\ud68d\ud558\ub294 \ub3d9\uc548 \uc77c\uc2dc\uc801\uc778 \uc548\uc804\uc744 \ud655\ubcf4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Stabfish.io\uc758 \uc131\uc7a5 \uba54\ucee4\ub2c8\uc998\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "Stabfish.io\uc758 \uc131\uc7a5 \uba54\ucee4\ub2c8\uc998\uc740 \uba39\ub294 \ubb3c\uace0\uae30\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uac01 \ubb3c\uace0\uae30\ub97c \uba39\uc744 \ub54c\ub9c8\ub2e4 \ud06c\uae30\uc640 \uac15\ub3c4\uac00 \ucee4\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc789\uc5b4\"\ub97c \uba39\uc73c\uba74 \uc791\uc740 \uc131\uc7a5 \ucd09\uc9c4 \ud6a8\uacfc\uac00 \uc788\uace0, \"\uaf41\uce58\"\ub97c \uba39\uc73c\uba74 \ub354 \ud070 \uc131\uc7a5 \ucd09\uc9c4 \ud6a8\uacfc\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uac8c\uc784\uc740 \uc120\ud615 \uc131\uc7a5 \ubaa8\ub378\uc744 \uc0ac\uc6a9\ud558\ubbc0\ub85c \uc9c0\uc18d\uc801\uc778 \uba39\uc774 \ud65c\ub3d9\uc740 \uafb8\uc900\ud55c \uc131\uc7a5\uc744 \uc774\ub055\ub2c8\ub2e4."}, {"question": "Stabfish.io\uc5d0\uc11c \uc595\uc740 \ubb3c\uacfc \uae4a\uc740 \ubb3c\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc595\uc740 \ubb3c\uc740 \uc548\uc804\ud558\uc9c0\ub9cc \uc791\uc740 \ubb3c\uace0\uae30\uac00 \uc788\uace0, \uae4a\uc740 \ubb3c\uc740 \uc704\ud5d8\ud558\uc9c0\ub9cc \ub354 \ud06c\uace0 \uacf5\uaca9\uc801\uc778 \ubb3c\uace0\uae30\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucd08\ubcf4\uc790\ub294 \uae30\uc220\uc744 \uc313\uae30 \uc704\ud574 \uc595\uc740 \ubb3c\uc5d0\uc11c \uc2dc\uc791\ud574\uc57c \ud569\ub2c8\ub2e4. \uae4a\uc740 \ubb3c\uc740 \ub354 \ud070 \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud558\uc9c0\ub9cc \uc99d\uac00\ub41c \uc704\ud5d8\uc744 \ud5e4\uccd0\ub098\uac08 \uc218 \uc788\ub294 \uace0\uae09 \uc804\ub7b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."}, {"question": "Stabfish.io\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\ub978 \uae30\uae30\ub85c \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub124, \uac8c\uc784 \uacc4\uc815\uc744 \ud074\ub77c\uc6b0\ub4dc \uc11c\ube44\uc2a4\uc5d0 \uc5f0\uacb0\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, Google Play \ub610\ub294 Apple Game Center\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub370\uc774\ud130\ub97c \uc800\uc7a5\ud558\uc138\uc694. \uc774\ub97c \ud1b5\ud574 \ub2e4\ub978 \uae30\uae30\uc5d0\uc11c \uac8c\uc784\uc744 \uacc4\uc18d\ud560 \uc218 \uc788\uace0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc783\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ub450 \uae30\uae30 \ubaa8\ub450 \uac19\uc740 \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694."}, {"question": "Stabfish.io\uc5d0\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\ub098\uc694?", "answer": "\ub124, Stabfish.io\uc5d0\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc0b0\ud638\ucd08 \uadfc\ucc98\uc5d0\uc11c \ud2b9\uc815 \ud328\ud134\uc73c\ub85c \ud5e4\uc5c4\uce58\uba74 \uc228\uaca8\uc9c4 \ubcf4\ubb3c \uc0c1\uc790\uac00 \ub4dc\ub7ec\ub0a0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ub3c5\ud2b9\ud55c \uc544\uc774\ud15c\uc774\ub098 \ubcf4\ub108\uc2a4\ub97c \uc81c\uacf5\ud558\uc5ec \uac8c\uc784\uc5d0 \ucd94\uac00\uc801\uc778 \uc7ac\ubbf8\uc640 \ubc1c\uacac\uc744 \ub354\ud569\ub2c8\ub2e4."}]
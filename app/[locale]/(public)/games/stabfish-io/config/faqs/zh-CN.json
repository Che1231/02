[{"question": "\u65b0\u624b\u5982\u4f55\u63a7\u5236Stabfish.io\u4e2d\u7684\u9c7c?", "answer": "\u5728Stabfish.io\u4e2d\u63a7\u5236\u9c7c\u7c7b\u975e\u5e38\u7b80\u5355\u3002\u4f7f\u7528\u65b9\u5411\u952e\u6216WASD\u952e\u8fdb\u884c\u79fb\u52a8\u3002\u4f8b\u5982\uff0c\u6309\u4e0b\u5411\u4e0a\u7bad\u5934\u952e\u5411\u524d\u6e38\u52a8\u3002\u7a7a\u683c\u952e\u53ef\u4ee5\u653b\u51fb\u5176\u4ed6\u9c7c\u3002\u5efa\u8bae\u5148\u5728\u6d45\u6c34\u533a\u7ec3\u4e60\uff0c\u719f\u6089\u64cd\u4f5c\u3002\u8bb0\u4f4f\uff0c\u7cbe\u51c6\u63a7\u5236\u662f\u751f\u5b58\u7684\u5173\u952e\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u7684\u9c7c\u5728Stabfish.io\u4e2d\u4e0d\u65ad\u6b7b\u4ea1?", "answer": "\u4f60\u7684\u9c7c\u53ef\u80fd\u6b7b\u4e8e\u5176\u4ed6\u73a9\u5bb6\u7684\u653b\u51fb\u6216\u73af\u5883\u5371\u5bb3\u3002\u4f8b\u5982\uff0c\u4f53\u578b\u8f83\u5927\u7684\u9c7c\u5f88\u5bb9\u6613\u51fb\u8d25\u4f53\u578b\u8f83\u5c0f\u7684\u9c7c\u3002\u4e3a\u4e86\u751f\u5b58\uff0c\u521d\u671f\u5c3d\u91cf\u907f\u514d\u51b2\u7a81\uff0c\u4e13\u6ce8\u4e8e\u5403\u6389\u8f83\u5c0f\u7684\u9c7c\u7c7b\u6765\u6210\u957f\u3002\u5229\u7528\u73af\u5883\u4f18\u52bf\uff0c\u8eb2\u85cf\u5728\u6d77\u85fb\u6216\u73ca\u745a\u7901\u4e2d\u3002"}, {"question": "Stabfish.io\u7684\u57fa\u672c\u76ee\u6807\u662f\u4ec0\u4e48?", "answer": "Stabfish.io\u7684\u4e3b\u8981\u76ee\u6807\u662f\u901a\u8fc7\u5403\u6389\u8f83\u5c0f\u7684\u9c7c\u6765\u4f7f\u81ea\u5df1\u7684\u9c7c\u957f\u5927\uff0c\u5e76\u907f\u514d\u88ab\u4f53\u578b\u8f83\u5927\u7684\u9c7c\u5403\u6389\u3002\u4f8b\u5982\uff0c\u9996\u5148\u653b\u51fb\u6700\u5c0f\u7684\u9c7c\uff0c\u7136\u540e\u968f\u7740\u4f60\u7684\u9c7c\u957f\u5927\uff0c\u9010\u6e10\u653b\u51fb\u4f53\u578b\u66f4\u5927\u7684\u730e\u7269\u3002\u6e38\u620f\u5956\u52b1\u73a9\u5bb6\u7684\u7b56\u7565\u6027\u548c\u53cd\u5e94\u80fd\u529b\uff0c\u6240\u4ee5\u8981\u65f6\u523b\u7559\u610f\u63d0\u5347\u7684\u673a\u4f1a\u3002"}, {"question": "\u5728\u73a9Stabfish.io 100\u5c0f\u65f6\u540e\uff0c\u5982\u4f55\u6539\u8fdb\u6211\u7684\u751f\u5b58\u7b56\u7565?", "answer": "100\u5c0f\u65f6\u540e\uff0c\u4e13\u6ce8\u4e8e\u9ad8\u7ea7\u6218\u672f\u3002\u6b65\u9aa41\uff1a\u638c\u63e1\u4f0f\u51fb\u6280\u5de7\uff0c\u8eb2\u85cf\u5728\u6d77\u85fb\u4e2d\u3002\u6b65\u9aa42\uff1a\u5229\u7528\u73af\u5883\u9677\u9631\u6355\u6349\u8f83\u5927\u7684\u9c7c\u3002\u6b65\u9aa43\uff1a\u65f6\u523b\u5173\u6ce8\u8ff7\u4f60\u5730\u56fe\uff0c\u9884\u6d4b\u5a01\u80c1\u3002\u4f8b\u5982\uff0c\u8bf1\u5bfc\u8f83\u5927\u7684\u9c7c\u8fdb\u5165\u72ed\u7a84\u7684\u901a\u9053\uff0c\u53ef\u4ee5\u638c\u63e1\u4e3b\u52a8\u6743\u3002"}, {"question": "\u5728Stabfish.io\u4e2d\uff0c\u4e3a\u4e86\u6700\u5927\u9650\u5ea6\u5730\u6210\u957f\uff0c\u6211\u5e94\u8be5\u9996\u5148\u653b\u51fb\u54ea\u79cd\u9c7c?", "answer": "\u9996\u5148\u653b\u51fb\u6700\u5c0f\u7684\u9c7c\uff0c\u4f8b\u5982\"\u5c0f\u9c7c\"\u3002\u5b83\u4eec\u66f4\u5bb9\u6613\u6355\u6349\uff0c\u5e76\u63d0\u4f9b\u6700\u521d\u7684\u6210\u957f\u6240\u9700\u3002\u968f\u7740\u4f60\u7684\u6210\u957f\uff0c\u518d\u8f6c\u5411\u4f53\u578b\u8f83\u5927\u7684\u9c7c\uff0c\u4f8b\u5982\"\u9cad\u9c7c\"\u3002\u4f8b\u5982\uff0c\u4ece\"\u5c0f\u9c7c\"\u5f00\u59cb\u53ef\u4ee5\u8ba9\u4f60\u5728\u9762\u5bf9\u66f4\u5177\u6311\u6218\u6027\u7684\u730e\u7269\u4e4b\u524d\u5efa\u7acb\u4fe1\u5fc3\u548c\u6280\u80fd\u3002"}, {"question": "\u5728Stabfish.io\u4e2d\u5982\u4f55\u5e94\u5bf9\u591a\u4e2a\u5bf9\u624b?", "answer": "\u5e94\u5bf9\u591a\u4e2a\u5bf9\u624b\u9700\u8981\u7b56\u7565\u3002\u6b65\u9aa41\uff1a\u5229\u7528\u73af\u5883\u4f18\u52bf\uff0c\u9690\u85cf\u81ea\u5df1\u3002\u6b65\u9aa42\uff1a\u4e00\u6b21\u4e13\u6ce8\u4e8e\u4e00\u4e2a\u5bf9\u624b\uff0c\u51cf\u5c11\u5bf9\u624b\u6570\u91cf\u3002\u6b65\u9aa43\uff1a\u5feb\u901f\u79fb\u52a8\uff0c\u907f\u514d\u88ab\u5305\u56f4\u3002\u4f8b\u5982\uff0c\u8eb2\u85cf\u5728\u73ca\u745a\u7901\u4e2d\u53ef\u4ee5\u63d0\u4f9b\u6682\u65f6\u7684\u5b89\u5168\uff0c\u8ba9\u4f60\u8ba1\u5212\u4e0b\u4e00\u6b65\u884c\u52a8\u3002"}, {"question": "Stabfish.io\u4e2d\u7684\u6210\u957f\u673a\u5236\u662f\u5982\u4f55\u8fd0\u4f5c\u7684?", "answer": "Stabfish.io\u7684\u6210\u957f\u673a\u5236\u57fa\u4e8e\u4f60\u5403\u7684\u9c7c\u3002\u4f60\u5403\u6389\u6bcf\u4e00\u6761\u9c7c\u90fd\u4f1a\u589e\u52a0\u4f60\u7684\u4f53\u578b\u548c\u529b\u91cf\u3002\u4f8b\u5982\uff0c\u5403\u6389\u4e00\u6761\"\u5c0f\u9c7c\"\u4f1a\u5e26\u6765\u5c0f\u7684\u6210\u957f\u63d0\u5347\uff0c\u800c\u5403\u6389\u4e00\u6761\"\u9cad\u9c7c\"\u5219\u4f1a\u5e26\u6765\u66f4\u5927\u7684\u63d0\u5347\u3002\u6e38\u620f\u4f7f\u7528\u7ebf\u6027\u589e\u957f\u6a21\u578b\uff0c\u8fd9\u610f\u5473\u7740\u6301\u7eed\u8fdb\u98df\u4f1a\u5bfc\u81f4\u7a33\u5b9a\u7684\u589e\u957f\u3002"}, {"question": "Stabfish.io\u4e2d\u6d45\u6c34\u533a\u548c\u6df1\u6c34\u533a\u7684\u5173\u952e\u533a\u522b\u662f\u4ec0\u4e48?", "answer": "\u6d45\u6c34\u533a\u6bd4\u8f83\u5b89\u5168\uff0c\u4f46\u9c7c\u7c7b\u8f83\u5c0f\uff1b\u6df1\u6c34\u533a\u98ce\u9669\u8f83\u9ad8\uff0c\u9c7c\u7c7b\u4f53\u578b\u8f83\u5927\u3001\u66f4\u5177\u4fb5\u7565\u6027\u3002\u4f8b\u5982\uff0c\u521d\u5b66\u8005\u5e94\u8be5\u5728\u6d45\u6c34\u533a\u7ec3\u4e60\u6280\u80fd\u3002\u6df1\u6c34\u533a\u56de\u62a5\u66f4\u5927\uff0c\u4f46\u9700\u8981\u66f4\u9ad8\u7ea7\u7684\u7b56\u7565\u6765\u5e94\u5bf9\u589e\u52a0\u7684\u5371\u9669\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5c06\u6211\u7684Stabfish.io\u6e38\u620f\u8fdb\u5ea6\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u8bbe\u5907\u4e0a\u5417?", "answer": "\u53ef\u4ee5\uff0c\u4f60\u53ef\u4ee5\u901a\u8fc7\u5c06\u4f60\u7684\u6e38\u620f\u8d26\u53f7\u94fe\u63a5\u5230\u4e91\u670d\u52a1\u6765\u8f6c\u79fb\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u4f7f\u7528Google Play\u6216Apple Game Center\u4fdd\u5b58\u4f60\u7684\u6570\u636e\u3002\u8fd9\u5141\u8bb8\u4f60\u5728\u53e6\u4e00\u4e2a\u8bbe\u5907\u4e0a\u7ee7\u7eed\u6e38\u620f\uff0c\u800c\u4e0d\u4f1a\u4e22\u5931\u4f60\u7684\u8fdb\u5ea6\u3002\u786e\u4fdd\u4f60\u5728\u4e24\u4e2a\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u5e10\u53f7\u3002"}, {"question": "Stabfish.io\u4e2d\u662f\u5426\u5b58\u5728\u9690\u85cf\u5f69\u86cb?", "answer": "\u662f\u7684\uff0cStabfish.io\u4e2d\u5b58\u5728\u9690\u85cf\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u5728\u73ca\u745a\u7901\u9644\u8fd1\u4ee5\u7279\u5b9a\u6a21\u5f0f\u6e38\u52a8\u53ef\u4ee5\u53d1\u73b0\u9690\u85cf\u7684\u5b9d\u7bb1\u3002\u8fd9\u4e9b\u5f69\u86cb\u901a\u5e38\u4f1a\u5956\u52b1\u73a9\u5bb6\u72ec\u7279\u7684\u7269\u54c1\u6216\u5956\u52b1\uff0c\u4e3a\u6e38\u620f\u589e\u6dfb\u4e86\u989d\u5916\u7684\u4e50\u8da3\u548c\u53d1\u73b0\u3002"}]
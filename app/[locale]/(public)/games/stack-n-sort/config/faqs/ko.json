[{"question": "\uc2a4\ud0dd N \uc815\ub82c\uc5d0\uc11c \uae30\ubcf8 \uc2a4\ud0dd\uc740 \uc5b4\ub5bb\uac8c \uc218\ud589\ud569\ub2c8\uae4c?", "answer": "\uc2a4\ud0dd N \uc815\ub82c\uc5d0\uc11c \uae30\ubcf8 \uc2a4\ud0dd\uc744 \uc218\ud589\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc2ed\uc2dc\uc624. \ub2e8\uacc4 1: \uc7ac\uace0\uc5d0\uc11c \ud56d\ubaa9\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc2a4\ud0dd \uc601\uc5ed\uc5d0 \ub4dc\ub798\uadf8 \uc564 \ub4dc\ub86d\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc548\uc815\uc131\uc744 \ud655\ubcf4\ud558\uae30 \uc704\ud574 \uc815\ub82c\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc791\uc740 \uc0c1\uc790\ub97c \ud070 \uc0c1\uc790 \uc704\uc5d0 \ub193\uc73c\uba74 \uc2a4\ud0dd\uc774 \ubb34\ub108\uc9c0\ub294 \uac83\uc744 \ubc29\uc9c0\ud569\ub2c8\ub2e4. \ucd08\ubcf4\uc790\ub97c \uc704\ud574 '\uc790\ub3d9 \uc2a4\ud0dd' \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uba74 \ud504\ub85c\uc138\uc2a4\ub97c \ub2e8\uc21c\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc2a4\ud0dd N \uc815\ub82c\uc758 \uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \ud544\uc218 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc2a4\ud0dd N \uc815\ub82c\uc758 \uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \ub2e4\uc74c\uc5d0 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \uacf5\uac04\uc744 \ucd5c\ub300\ud654\ud558\uae30 \uc704\ud574 \ubaa8\uc591\uc774 \uc720\uc0ac\ud55c \ud56d\ubaa9\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uc2a4\ud0dd\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ud56d\ubaa9\uc744 \ub354 \ud6a8\uc728\uc801\uc73c\ub85c \ub9de\ucd94\uae30 \uc704\ud574 '\ud68c\uc804' \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ucd5c\uc885 \uc2a4\ud0dd \ub808\uc774\uc544\uc6c3\uc744 \uc2dc\uac01\ud654\ud558\uc5ec \ubbf8\ub9ac \uacc4\ud68d\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc9c1\uc0ac\uac01\ud615 \uc0c1\uc790\ub97c \uc218\uc9c1\uc73c\ub85c \ud68c\uc804\ud558\uba74 \uc218\ud3c9 \uacf5\uac04\uc744 \uc808\uc57d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubcf5\uc7a1\ud55c \ubc30\uc5f4\uc5d0\ub294 '\uba40\ud2f0 \uc2a4\ud0dd' \uc635\uc158\uc744 \uace0\ub824\ud558\uc2ed\uc2dc\uc624."}, {"question": "\uc2a4\ud0dd N \uc815\ub82c\uc758 \uc548\uc815\uc131 \ubbf8\ud130\uac00 \ubcc0\ub3d9\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc2a4\ud0dd N \uc815\ub82c\uc758 \uc548\uc815\uc131 \ubbf8\ud130\ub294 \uc2a4\ud0dd\uc758 \uade0\ud615\uacfc \ubb34\uac8c \ubd84\ud3ec\uc5d0 \ub530\ub77c \ubcc0\ub3d9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubb34\uac70\uc6b4 \ubb3c\uac74\uc744 \uac00\ubcbc\uc6b4 \ubb3c\uac74 \uc704\uc5d0 \ub193\uc73c\uba74 \uc548\uc815\uc131\uc774 \ub5a8\uc5b4\uc9d1\ub2c8\ub2e4. \ub192\uc740 \uc548\uc815\uc131\uc744 \uc720\uc9c0\ud558\ub824\uba74 \ubb34\uac70\uc6b4 \ubb3c\uac74\uc740 \uc544\ub798\ucabd\uc5d0, \uac00\ubcbc\uc6b4 \ubb3c\uac74\uc740 \uc704\ucabd\uc5d0 \ub193\uc544\uc57c \ud569\ub2c8\ub2e4. \ubbf8\ud130\ub294 \ub610\ud55c \uc2a4\ud0dd\uc758 \uc815\ub82c \ubc0f \ub300\uce6d\uc744 \uace0\ub824\ud569\ub2c8\ub2e4."}, {"question": "\uc2a4\ud0dd N \uc815\ub82c\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "\uc2a4\ud0dd N \uc815\ub82c\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc548\uc815\uc131, \uc18d\ub3c4 \ubc0f \ud6a8\uc728\uc131\uc774\ub77c\ub294 \uc138 \uac00\uc9c0 \uc8fc\uc694 \uc694\uc778\uc744 \ud3c9\uac00\ud569\ub2c8\ub2e4. \uc548\uc815\uc131\uc740 \uc2a4\ud0dd\uc774 \uade0\ud615\uc744 \uc5bc\ub9c8\ub098 \uc798 \uc720\uc9c0\ud558\ub294\uc9c0\uc5d0 \ub530\ub77c \uacb0\uc815\ub429\ub2c8\ub2e4. \uc18d\ub3c4\ub294 \uc2a4\ud0dd \uc791\uc5c5\uc744 \uc5bc\ub9c8\ub098 \ube60\ub974\uac8c \uc644\ub8cc\ud558\ub294\uc9c0\uc5d0 \ub530\ub77c \uacb0\uc815\ub429\ub2c8\ub2e4. \ud6a8\uc728\uc131\uc740 \uc0ac\uc6a9 \uac00\ub2a5\ud55c \uacf5\uac04\uc744 \uc5bc\ub9c8\ub098 \uc798 \ud65c\uc6a9\ud558\ub294\uc9c0 \uce21\uc815\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc644\ubcbd\ud558\uac8c \uade0\ud615 \uc7a1\ud78c \uc2a4\ud0dd\uc73c\ub85c \ub0ad\ube44\ub41c \uacf5\uac04\uc774 \ucd5c\uc18c\ud654\ub418\uba74 \ucd5c\uace0 \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc2a4\ud0dd N \uc815\ub82c\uc5d0\uc11c \uc2a4\ud0dd\ud558\uae30 \uac00\uc7a5 \uc5b4\ub824\uc6b4 \ud56d\ubaa9\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc2a4\ud0dd N \uc815\ub82c\uc5d0\uc11c \uac00\uc7a5 \uc2a4\ud0dd\ud558\uae30 \uc5b4\ub824\uc6b4 \ud56d\ubaa9\uc740 \uad6c\ud615\uacfc \uc6d0\ucd94\ud615\uacfc \uac19\uc774 \ubd88\uaddc\uce59\ud55c \ubaa8\uc591\uc758 \ubb3c\uccb4\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud56d\ubaa9\uc740 \uc548\uc815\uc131\uc744 \uc720\uc9c0\ud558\uae30 \uc704\ud574 \uc815\ud655\ud55c \uc704\uce58 \ubc30\uce58\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc6d0\ubfd4\uc744 \ud3c9\ud3c9\ud55c \ud45c\uba74 \uc704\uc5d0 \uc313\ub294 \uac83\uc740 \uace1\uba74 \uc704\uc5d0 \ub193\ub294 \uac83\ubcf4\ub2e4 \uc27d\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud56d\ubaa9\uc758 \uc704\uce58\ub97c \ub354 \uc815\ud655\ud558\uac8c \uc870\uc815\ud558\ub824\uba74 '\uc815\ubc00 \ubaa8\ub4dc'\ub97c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc \uac04 \uc2a4\ud0dd N \uc815\ub82c\uc758 \ub370\uc774\ud130 \ub9c8\uc774\uadf8\ub808\uc774\uc158\uc5d0 \ub300\ud55c \ucd5c\uc0c1\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc \uac04 \uc2a4\ud0dd N \uc815\ub82c\uc758 \ub370\uc774\ud130\ub97c \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc2ed\uc2dc\uc624. \ub2e8\uacc4 1: \ub450 \uae30\uae30 \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \uc5f0\uacb0\ub418\uc5b4 \uc788\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: '\ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5' \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5c5\ub85c\ub4dc\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc0c8 \uae30\uae30\uc5d0\uc11c \uc800\uc7a5\ub41c \ub370\uc774\ud130\ub97c \ub2e4\uc6b4\ub85c\ub4dc\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubaa8\ubc14\uc77c \uae30\uae30\uc5d0\uc11c PC\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub824\uba74 \ub450 \ud50c\ub7ab\ud3fc \ubaa8\ub450\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud574\uc57c \ud569\ub2c8\ub2e4. \ub9c8\uc774\uadf8\ub808\uc774\uc158 \ud6c4 \ub370\uc774\ud130 \ubb34\uacb0\uc131\uc744 \ud655\uc778\ud558\uc2ed\uc2dc\uc624."}, {"question": "\uc2a4\ud0dd N \uc815\ub82c\uc5d0\uc11c \uc228\uaca8\uc9c4 \ub808\ubca8\uc744 \uc5b4\ub5bb\uac8c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc2a4\ud0dd N \uc815\ub82c\uc5d0\uc11c \uc228\uaca8\uc9c4 \ub808\ubca8\uc740 \ud2b9\uc815 \ub9c8\uc77c\uc2a4\ud1a4\uc744 \ub2ec\uc131\ud568\uc73c\ub85c\uc368 \uc7a0\uae08 \ud574\uc81c\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 90% \uc774\uc0c1\uc758 \uc548\uc815\uc131 \ub4f1\uae09\uc73c\ub85c 50\uac1c\uc758 \uc2a4\ud0dd\uc744 \uc644\ub8cc\ud558\uba74 \ud2b9\ubcc4\ud55c \ub808\ubca8\uc774 \uc7a0\uae08 \ud574\uc81c\ub429\ub2c8\ub2e4. \ub610\ud55c \uac8c\uc784 \ub0b4\uc5d0\uc11c \uc228\uaca8\uc9c4 \ud56d\ubaa9\uc744 \ucc3e\uace0 \uc2a4\ud0dd\ud558\uba74 \ube44\ubc00 \ub808\ubca8\uc744 \uacf5\uac1c\ud560 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc778 \uc2a4\ud0dd \uae30\uc900\uacfc \uc77c\uce58\ud558\uc9c0 \uc54a\ub294 \ud2b9\uc774\ud55c \ud56d\ubaa9\uc744 \uc8fc\uc758 \uae4a\uac8c \uc0b4\ud3b4\ubcf4\uc2ed\uc2dc\uc624."}, {"question": "\uc2a4\ud0dd N \uc815\ub82c\uc5d0\uc11c \ud56d\ubaa9\uc758 \ubb34\uac8c\ub294 \uc2a4\ud0dd\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\uc2a4\ud0dd N \uc815\ub82c\uc5d0\uc11c \ud56d\ubaa9\uc758 \ubb34\uac8c\ub294 \uc2a4\ud0dd\uc5d0 \uc0c1\ub2f9\ud55c \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ubb34\uac70\uc6b4 \ud56d\ubaa9\uc740 \ub354 \uc548\uc815\uc801\uc778 \uae30\ubc18\uc744 \uc81c\uacf5\ud558\uc9c0\ub9cc \uac00\ubcbc\uc6b4 \ud56d\ubaa9 \uc704\uc5d0 \ub193\uae30\uac00 \ub354 \uc5b4\ub835\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc2a4\ud0dd\uc758 \uc544\ub798\ucabd\uc5d0 10kg \uc0c1\uc790\ub97c, \uc704\ucabd\uc5d0 2kg \uc0c1\uc790\ub97c \ub193\uc73c\uba74 \uc548\uc815\uc131\uc774 \ud5a5\uc0c1\ub429\ub2c8\ub2e4. \uac8c\uc784\uc740 \ubd88\uc548\uc815\uc131\uc744 \ucc98\ubc8c\ud558\uc5ec \uc804\uccb4 \uc810\uc218\ub97c \uac10\uc18c\uc2dc\ud0a4\ubbc0\ub85c \ud56d\uc0c1 \ubb34\uac8c \ubd84\ud3ec\ub97c \uace0\ub824\ud558\uc2ed\uc2dc\uc624."}, {"question": "\uc548\uc815\uc131\uc744 \ud76c\uc0dd\ud558\uc9c0 \uc54a\uace0 \uc2a4\ud0dd N \uc815\ub82c\uc758 \uc2a4\ud0dd \uc18d\ub3c4\ub97c \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc548\uc815\uc131\uc744 \uc720\uc9c0\ud558\uba74\uc11c \uc2a4\ud0dd N \uc815\ub82c\uc758 \uc2a4\ud0dd \uc18d\ub3c4\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc2ed\uc2dc\uc624. \ub2e8\uacc4 1: \ud56d\ubaa9 \ubaa8\uc591\uacfc \ubb34\uac8c\ub97c \uc775\uc219\ud574\uc9d1\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc790\uc8fc \uc0ac\uc6a9\ud558\ub294 \ud56d\ubaa9\uc5d0\ub294 '\ube60\ub978 \uc2a4\ud0dd' \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ubc30\uce58 \uc2dc\uac04\uc744 \ub2e8\ucd95\ud558\uae30 \uc704\ud574 \ud6a8\uc728\uc801\uc778 \uc190 \ub3d9\uc791\uc744 \uc5f0\uc2b5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc720\uc0ac\ud55c \ud56d\ubaa9\uc744 \uc5f0\uc18d\uc73c\ub85c \ube60\ub974\uac8c \uc2a4\ud0dd\ud558\uba74 \uc548\uc815\uc131\uc744 \ud76c\uc0dd\ud558\uc9c0 \uc54a\uace0 \uc2dc\uac04\uc744 \uc808\uc57d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc815\uae30\uc801\uc73c\ub85c \uc131\ub2a5\uc744 \uac80\ud1a0\ud558\uc5ec \uac1c\uc120\ud574\uc57c \ud560 \ubd80\ubd84\uc744 \ud30c\uc545\ud558\uc2ed\uc2dc\uc624."}, {"question": "\uc2a4\ud0dd N \uc815\ub82c\uc5d0\uc11c '\uba40\ud2f0 \uc2a4\ud0dd' \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\ub294 \uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc2a4\ud0dd N \uc815\ub82c\uc5d0\uc11c '\uba40\ud2f0 \uc2a4\ud0dd' \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uba74 \ud50c\ub808\uc774\uc5b4\uac00 \uc5ec\ub7ec \ud56d\ubaa9\uc744 \ub3d9\uc2dc\uc5d0 \uc2a4\ud0dd\ud558\uc5ec \ud6a8\uc728\uc131\uc744 \ub192\uc774\uace0 \uc2dc\uac04\uc744 \ub2e8\ucd95\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc138 \uac1c\uc758 \uc0c1\uc790\ub97c \ud55c \ubc88\uc5d0 \uc2a4\ud0dd\ud558\ub294 \uac83\uc740 \uac1c\ubcc4\uc801\uc73c\ub85c \uc2a4\ud0dd\ud558\ub294 \uac83\ubcf4\ub2e4 \uc2dc\uac04\uc744 \ud06c\uac8c \uc808\uc57d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uae30\ub2a5\uc740 \uc18d\ub3c4\uac00 \uc911\uc694\ud55c \uc2dc\uac04 \uc81c\ud55c \ub808\ubca8\uc5d0\uc11c \ud2b9\ud788 \uc720\uc6a9\ud569\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \uc2a4\ud0dd \uc548\uc815\uc131\uc744 \uc720\uc9c0\ud558\ub824\uba74 \uc815\ud655\ud55c \uc815\ub82c\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."}]
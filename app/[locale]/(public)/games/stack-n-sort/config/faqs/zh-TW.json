[{"question": "\u5982\u4f55\u57f7\u884c Stack N Sort \u7684\u57fa\u672c\u5806\u758a\uff1f", "answer": "\u8981\u57f7\u884c Stack N Sort \u7684\u57fa\u672c\u5806\u758a\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u5f9e\u5eab\u5b58\u4e2d\u9078\u64c7\u4e00\u500b\u7269\u54c1\u3002\u6b65\u9a5f2\uff1a\u5c07\u5176\u62d6\u653e\u5230\u5806\u758a\u5340\u57df\u3002\u6b65\u9a5f3\uff1a\u4ed4\u7d30\u8abf\u6574\u5176\u4f4d\u7f6e\u4ee5\u78ba\u4fdd\u7a69\u5b9a\u6027\u3002\u4f8b\u5982\uff0c\u5c07\u8f03\u5c0f\u7684\u76d2\u5b50\u653e\u5728\u8f03\u5927\u7684\u76d2\u5b50\u4e0a\u9762\u53ef\u4ee5\u9632\u6b62\u5806\u758a\u50be\u5012\u3002\u5c0d\u65bc\u521d\u5b78\u8005\uff0c\u53ef\u4ee5\u4f7f\u7528\u300e\u81ea\u52d5\u5806\u758a\u300f\u529f\u80fd\u4f86\u7c21\u5316\u9019\u500b\u904e\u7a0b\u3002"}, {"question": "Stack N Sort \u4e2d\u7684\u9032\u968e\u73a9\u5bb6\u61c9\u63a1\u53d6\u54ea\u4e9b\u95dc\u9375\u7b56\u7565\uff1f", "answer": "Stack N Sort \u4e2d\u7684\u9032\u968e\u73a9\u5bb6\u61c9\u5c08\u6ce8\u65bc\uff1a\u6b65\u9a5f1\uff1a\u512a\u5148\u5806\u758a\u5f62\u72c0\u76f8\u4f3c\u7684\u7269\u54c1\u4ee5\u6700\u5927\u5316\u7a7a\u9593\u5229\u7528\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u300e\u65cb\u8f49\u300f\u529f\u80fd\u66f4\u6709\u6548\u5730\u8abf\u6574\u7269\u54c1\u4f4d\u7f6e\u3002\u6b65\u9a5f3\uff1a\u9810\u5148\u898f\u5283\uff0c\u9810\u5148\u69cb\u601d\u6700\u7d42\u7684\u5806\u758a\u4f48\u5c40\u3002\u4f8b\u5982\uff0c\u5c07\u9577\u65b9\u5f62\u76d2\u5b50\u5782\u76f4\u65cb\u8f49\u53ef\u4ee5\u7bc0\u7701\u6c34\u5e73\u7a7a\u9593\u3002\u5c0d\u65bc\u8907\u96dc\u7684\u6392\u5217\uff0c\u8acb\u8003\u616e\u4f7f\u7528\u300e\u591a\u91cd\u5806\u758a\u300f\u9078\u9805\u3002"}, {"question": "\u70ba\u4ec0\u9ebc Stack N Sort \u4e2d\u7684\u7a69\u5b9a\u5ea6\u8a08\u6703\u6ce2\u52d5\uff1f", "answer": "Stack N Sort \u4e2d\u7684\u7a69\u5b9a\u5ea6\u8a08\u6703\u6839\u64da\u5806\u758a\u7684\u5e73\u8861\u6027\u548c\u91cd\u91cf\u5206\u4f48\u800c\u6ce2\u52d5\u3002\u4f8b\u5982\uff0c\u5c07\u91cd\u7269\u653e\u5728\u8f15\u7269\u4e0a\u9762\u6703\u964d\u4f4e\u7a69\u5b9a\u5ea6\u3002\u70ba\u7dad\u6301\u9ad8\u7a69\u5b9a\u5ea6\uff0c\u8acb\u78ba\u4fdd\u5c07\u8f03\u91cd\u7684\u7269\u54c1\u653e\u5728\u5e95\u90e8\uff0c\u8f03\u8f15\u7684\u7269\u54c1\u653e\u5728\u4e0a\u9762\u3002\u8a08\u6578\u5668\u4e5f\u6703\u8003\u91cf\u5806\u758a\u7684\u5c0d\u9f4a\u548c\u5c0d\u7a31\u6027\u3002"}, {"question": "Stack N Sort \u7684\u8a08\u5206\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff1f", "answer": "Stack N Sort \u7684\u8a08\u5206\u7cfb\u7d71\u8a55\u4f30\u4e09\u500b\u4e3b\u8981\u56e0\u7d20\uff1a\u7a69\u5b9a\u6027\u3001\u901f\u5ea6\u548c\u6548\u7387\u3002\u7a69\u5b9a\u6027\u662f\u7531\u5806\u758a\u4fdd\u6301\u5e73\u8861\u7684\u7a0b\u5ea6\u6c7a\u5b9a\u7684\u3002\u901f\u5ea6\u57fa\u65bc\u4f60\u5b8c\u6210\u5806\u758a\u4efb\u52d9\u7684\u901f\u5ea6\u3002\u6548\u7387\u5247\u6e2c\u91cf\u4f60\u5982\u4f55\u6709\u6548\u5229\u7528\u53ef\u7528\u7a7a\u9593\u3002\u4f8b\u5982\uff0c\u4e00\u500b\u5b8c\u5168\u5e73\u8861\u4e14\u6d6a\u8cbb\u7a7a\u9593\u6700\u5c11\u7684\u5806\u758a\u5c07\u6703\u7372\u5f97\u6700\u9ad8\u7684\u5f97\u5206\u3002"}, {"question": "Stack N Sort \u4e2d\u54ea\u4e9b\u7269\u54c1\u6700\u96e3\u5806\u758a\uff1f", "answer": "Stack N Sort \u4e2d\u6700\u96e3\u5806\u758a\u7684\u7269\u54c1\u662f\u4e0d\u898f\u5247\u5f62\u72c0\u7684\u7269\u9ad4\uff0c\u4f8b\u5982\u7403\u9ad4\u548c\u5713\u9310\u9ad4\u3002\u9019\u4e9b\u7269\u54c1\u9700\u8981\u7cbe\u78ba\u653e\u7f6e\u624d\u80fd\u7dad\u6301\u7a69\u5b9a\u6027\u3002\u4f8b\u5982\uff0c\u5c07\u5713\u9310\u9ad4\u653e\u5728\u5e73\u9762\u8868\u9762\u4e0a\u6bd4\u653e\u5728\u66f2\u9762\u8868\u9762\u4e0a\u66f4\u5bb9\u6613\u3002\u4f7f\u7528\u300e\u7cbe\u78ba\u6a21\u5f0f\u300f\u66f4\u6e96\u78ba\u5730\u8abf\u6574\u9019\u4e9b\u7269\u54c1\u7684\u4f4d\u7f6e\u3002"}, {"question": "\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e4b\u9593\uff0cStack N Sort \u7684\u8cc7\u6599\u9077\u79fb\u7684\u6700\u4f73\u505a\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "\u8981\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e4b\u9593\u9077\u79fb Stack N Sort \u7684\u8cc7\u6599\uff1a\u6b65\u9a5f1\uff1a\u8acb\u78ba\u4fdd\u5169\u500b\u88dd\u7f6e\u90fd\u9023\u63a5\u5230\u76f8\u540c\u7684\u5e33\u6236\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u300e\u96f2\u7aef\u5132\u5b58\u300f\u529f\u80fd\u4e0a\u50b3\u60a8\u7684\u9032\u5ea6\u3002\u6b65\u9a5f3\uff1a\u5728\u65b0\u88dd\u7f6e\u4e0a\u4e0b\u8f09\u5132\u5b58\u7684\u8cc7\u6599\u3002\u4f8b\u5982\uff0c\u5c07\u9032\u5ea6\u5f9e\u884c\u52d5\u88dd\u7f6e\u50b3\u8f38\u5230\u96fb\u8166\u9700\u8981\u5728\u5169\u500b\u5e73\u53f0\u4e0a\u767b\u5165\u76f8\u540c\u7684\u5e33\u6236\u3002\u9a57\u8b49\u8cc7\u6599\u9077\u79fb\u5f8c\u7684\u5b8c\u6574\u6027\u3002"}, {"question": "\u5982\u4f55\u5728 Stack N Sort \u4e2d\u89e3\u9396\u96b1\u85cf\u95dc\u5361\uff1f", "answer": "Stack N Sort \u4e2d\u7684\u96b1\u85cf\u95dc\u5361\u662f\u901a\u904e\u9054\u6210\u7279\u5b9a\u91cc\u7a0b\u7891\u4f86\u89e3\u9396\u7684\u3002\u4f8b\u5982\uff0c\u5b8c\u6210 50 \u6b21\u5806\u758a\uff0c\u4e14\u7a69\u5b9a\u6027\u8a55\u7d1a\u8d85\u904e 90%\uff0c\u5373\u53ef\u89e3\u9396\u7279\u6b8a\u95dc\u5361\u3002\u6b64\u5916\uff0c\u5728\u904a\u6232\u4e2d\u627e\u5230\u4e26\u5806\u758a\u96b1\u85cf\u7269\u54c1\u4e5f\u53ef\u4ee5\u63ed\u793a\u79d8\u5bc6\u95dc\u5361\u3002\u7559\u610f\u53ef\u80fd\u4e0d\u7b26\u5408\u4e00\u822c\u5806\u758a\u6a19\u6e96\u7684\u4e0d\u540c\u5c0b\u5e38\u7269\u54c1\u3002"}, {"question": "\u7269\u54c1\u91cd\u91cf\u5728 Stack N Sort \u7684\u5806\u758a\u4e2d\u626e\u6f14\u4ec0\u9ebc\u89d2\u8272\uff1f", "answer": "\u7269\u54c1\u91cd\u91cf\u5728 Stack N Sort \u7684\u5806\u758a\u4e2d\u626e\u6f14\u8457\u91cd\u8981\u7684\u89d2\u8272\u3002\u8f03\u91cd\u7684\u7269\u54c1\u63d0\u4f9b\u66f4\u7a69\u5b9a\u7684\u57fa\u790e\uff0c\u4f46\u66f4\u96e3\u653e\u5728\u8f03\u8f15\u7684\u7269\u54c1\u4e0a\u9762\u3002\u4f8b\u5982\uff0c\u5c07\u4e00\u500b 10 \u516c\u65a4\u7684\u76d2\u5b50\u653e\u5728\u5806\u758a\u5e95\u90e8\uff0c\u4e00\u500b 2 \u516c\u65a4\u7684\u76d2\u5b50\u653e\u5728\u4e0a\u9762\uff0c\u53ef\u4ee5\u78ba\u4fdd\u66f4\u597d\u7684\u7a69\u5b9a\u6027\u3002\u904a\u6232\u6703\u900f\u904e\u964d\u4f4e\u6574\u9ad4\u5f97\u5206\u4f86\u8655\u7f70\u4e0d\u7a69\u5b9a\u60c5\u6cc1\uff0c\u56e0\u6b64\u8acb\u52d9\u5fc5\u8003\u616e\u91cd\u91cf\u5206\u914d\u3002"}, {"question": "\u5982\u4f55\u5728\u4e0d\u640d\u5bb3\u7a69\u5b9a\u6027\u7684\u60c5\u6cc1\u4e0b\uff0c\u512a\u5316 Stack N Sort \u4e2d\u7684\u5806\u758a\u901f\u5ea6\uff1f", "answer": "\u8981\u5728\u7dad\u6301\u7a69\u5b9a\u6027\u7684\u524d\u63d0\u4e0b\uff0c\u512a\u5316 Stack N Sort \u4e2d\u7684\u5806\u758a\u901f\u5ea6\uff1a\u6b65\u9a5f1\uff1a\u719f\u6089\u7269\u54c1\u7684\u5f62\u72c0\u548c\u91cd\u91cf\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u300e\u5feb\u901f\u5806\u758a\u300f\u529f\u80fd\u4f86\u5feb\u901f\u5806\u758a\u5e38\u7528\u7684\u7269\u54c1\u3002\u6b65\u9a5f3\uff1a\u7df4\u7fd2\u9ad8\u6548\u7684\u624b\u90e8\u52d5\u4f5c\u4ee5\u7e2e\u77ed\u653e\u7f6e\u6642\u9593\u3002\u4f8b\u5982\uff0c\u5feb\u901f\u5806\u758a\u76f8\u540c\u7269\u54c1\u53ef\u4ee5\u7bc0\u7701\u6642\u9593\uff0c\u800c\u4e0d\u6703\u72a7\u7272\u7a69\u5b9a\u6027\u3002\u5b9a\u671f\u6aa2\u8a0e\u60a8\u7684\u8868\u73fe\uff0c\u627e\u51fa\u6539\u9032\u7684\u9818\u57df\u3002"}, {"question": "\u5728 Stack N Sort \u4e2d\u4f7f\u7528\u300e\u591a\u91cd\u5806\u758a\u300f\u529f\u80fd\u6709\u4ec0\u9ebc\u597d\u8655\uff1f", "answer": "Stack N Sort \u4e2d\u7684\u300e\u591a\u91cd\u5806\u758a\u300f\u529f\u80fd\u5141\u8a31\u73a9\u5bb6\u540c\u6642\u5806\u758a\u591a\u500b\u7269\u54c1\uff0c\u5f9e\u800c\u63d0\u9ad8\u6548\u7387\u4e26\u7e2e\u77ed\u6642\u9593\u3002\u4f8b\u5982\uff0c\u540c\u6642\u5806\u758a\u4e09\u500b\u76d2\u5b50\u53ef\u4ee5\u6bd4\u500b\u5225\u5806\u758a\u7bc0\u7701\u5927\u91cf\u6642\u9593\u3002\u6b64\u529f\u80fd\u5728\u6642\u9593\u6709\u9650\u7684\u95dc\u5361\u4e2d\u7279\u5225\u6709\u7528\uff0c\u56e0\u70ba\u901f\u5ea6\u81f3\u95dc\u91cd\u8981\u3002\u4e0d\u904e\uff0c\u9019\u9700\u8981\u7cbe\u78ba\u5c0d\u9f4a\u624d\u80fd\u7dad\u6301\u5806\u758a\u7684\u7a69\u5b9a\u6027\u3002"}]
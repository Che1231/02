[{"question": "Stack N Sort\u3067\u57fa\u672c\u7684\u306a\u7a4d\u307f\u91cd\u306d\u64cd\u4f5c\u3092\u884c\u3046\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Stack N Sort\u3067\u57fa\u672c\u7684\u306a\u7a4d\u307f\u91cd\u306d\u3092\u884c\u3046\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u304b\u3089\u30a2\u30a4\u30c6\u30e0\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b9\u30bf\u30c3\u30af\u9818\u57df\u306b\u30c9\u30e9\u30c3\u30b0\u30a2\u30f3\u30c9\u30c9\u30ed\u30c3\u30d7\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5b89\u5b9a\u6027\u3092\u78ba\u4fdd\u3059\u308b\u305f\u3081\u306b\u614e\u91cd\u306b\u6574\u5217\u3055\u305b\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5927\u304d\u306a\u7bb1\u306e\u4e0a\u306b\u5c0f\u3055\u306a\u7bb1\u3092\u7f6e\u304f\u3053\u3068\u3067\u3001\u7a4d\u307f\u91cd\u306d\u304c\u5d29\u308c\u308b\u306e\u3092\u9632\u304e\u307e\u3059\u3002\u521d\u5fc3\u8005\u306e\u65b9\u306b\u306f\u3001\u30d7\u30ed\u30bb\u30b9\u3092\u7c21\u7d20\u5316\u3059\u308b\u300c\u81ea\u52d5\u7a4d\u307f\u91cd\u306d\u300d\u6a5f\u80fd\u3092\u304a\u4f7f\u3044\u304f\u3060\u3055\u3044\u3002"}, {"question": "Stack N Sort\u306e\u9ad8\u5ea6\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u91cd\u8981\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Stack N Sort\u306e\u9ad8\u5ea6\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u4ee5\u4e0b\u306e\u70b9\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6700\u5927\u9650\u306e\u30b9\u30da\u30fc\u30b9\u3092\u6d3b\u7528\u3059\u308b\u305f\u3081\u306b\u3001\u5f62\u72b6\u306e\u985e\u4f3c\u3057\u305f\u30a2\u30a4\u30c6\u30e0\u3092\u512a\u5148\u7684\u306b\u7a4d\u307f\u91cd\u306d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30a2\u30a4\u
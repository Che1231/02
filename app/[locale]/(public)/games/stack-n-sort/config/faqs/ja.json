0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306f\u4e0d\u5b89\u5b9a\u3055\u3092\u30da\u30ca\u30eb\u30c6\u30a3\u3068\u3057\u3066\u6271\u3046\u305f\u3081\u3001\u5168\u4f53\u7684\u306a\u30b9\u30b3\u30a2\u3092\u4f4e\u4e0b\u3055\u305b\u307e\u3059\u3002\u305d\u306e\u305f\u3081\u3001\u5e38\u306b\u91cd\u5fc3\u306e\u5206\u5e03\u3092\u8003\u616e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "Stack N Sort\u3067\u7a4d\u307f\u91cd\u306d\u901f\u5ea6\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u5b89\u5b9a\u6027\u3092\u640d\u306a\u3046\u3053\u3068\u306a\u304f\u3069\u306e\u3088\u3046\u306b\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Stack N Sort\u3067\u7a4d\u307f\u91cd\u306d\u901f\u5ea6\u3092\u6700\u9069\u5316\u3057\u3001\u540c\u6642\u306b\u5b89\u5b9a\u6027\u3092\u7dad\u6301\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u30b9\u30c6\u30c3\u30d7\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30a2\u30a4\u30c6\u30e0\u306e\u5f62\u72b6\u3068\u91cd\u91cf\u3092\u628a\u63e1\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u300c\u30af\u30a4\u30c3\u30af\u30b9\u30bf\u30c3\u30af\u300d\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u3001\u983b\u7e41\u306b\u4f7f\u7528\u3059\u308b\u30a2\u30a4\u30c6\u30e0\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u914d\u7f6e\u6642\u9593\u3092\u77ed\u7e2e\u3059\u308b\u305f\u3081\u306b\u3001\u52b9\u7387\u7684\u306a\u624b\u4f5c\u696d\u3092\u5b9f\u8df5\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u985e\u4f3c\u3057\u305f\u30a2\u30a4\u30c6\u30e0\u3092\u9023\u7d9a\u3057\u3066\u7a4d\u307f\u91cd\u306d\u308b\u3053\u3068\u3067\u3001\u5b89\u5b9a\u6027\u3092\u640d\u306a\u3046\u3053\u3068\u306a\u304f\u6642\u9593\u3092\u7bc0\u7d04\u3067\u304d\u307e\u3059\u3002\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5b9a\u671f\u7684\u306b\u898b\u76f4\u3057\u3001\u6539\u5584\u3067\u304d\u308b\u90e8\u5206\u3092\u7279\u5b9a\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "Stack N Sort\u3067\u300c\u8907\u6570\u7a4d\u307f\u91cd\u306d\u300d\u6a5f\u80fd\u3092\u4f7f\u7528\u3059\u308b\u5229\u70b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Stack N Sort\u306e\u300c\u8907\u6570\u7a4d\u307f\u91cd\u306d\u300d\u6a5f\u80fd\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u8907\u6570\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u540c\u6642\u306b\u7a4d\u307f\u91cd\u306d\u308b\u3053\u3068\u304c\u3067\u304d\u3001\u52b9\u7387\u3092\u5411\u4e0a\u3055\u305b\u3001\u6642\u9593\u3092\u77ed\u7e2e\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u30013\u3064\u306e\u7bb1\u3092\u4e00\u5ea6\u306b\u7a4d\u307f\u91cd\u306d\u308b\u3053\u3068\u306f\u3001\u500b\u5225\u306b\u7a4d\u307f\u91cd\u306d\u308b\u3088\u308a\u3082\u5927\u5e45\u306a\u6642\u9593\u7bc0\u7d04\u306b\u306a\u308a\u307e\u3059\u3002\u3053\u306e\u6a5f\u80fd\u306f\u3001\u901f\u5ea6\u304c\u91cd\u8981\u306a\u6642\u9593\u5236\u9650\u4ed8\u304d\u30ec\u30d9\u30eb\u3067\u7279\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u305f\u3060\u3057\u3001\u7a4d\u307f\u91cd\u306d\u306e\u5b89\u5b9a\u6027\u3092\u7dad\u6301\u3059\u308b\u306b\u306f\u3001\u6b63\u78ba\u306a\u6574\u5217\u304c\u5fc5\u8981\u3067\u3059\u3002"}]
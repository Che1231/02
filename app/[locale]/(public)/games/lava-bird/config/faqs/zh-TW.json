[{"question": "\u5982\u4f55\u8b93\u65b0\u73a9\u5bb6\u638c\u63e1\u300a\u7194\u5ca9\u9ce5\u300b\u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u7cbe\u901a\u300a\u7194\u5ca9\u9ce5\u300b\u7684\u57fa\u672c\u63a7\u5236\uff0c\u9996\u5148\u8981\u719f\u6089\u89f8\u63a7\u6216\u9375\u76e4\u8f38\u5165\u3002\u4f8b\u5982\uff0c\u9ede\u64ca\u87a2\u5e55\u6216\u6309\u4e0b\u7a7a\u683c\u9375\u8b93\u9ce5\u5152\u62cd\u52d5\u7fc5\u8180\u4e0a\u5347\u3002\u7df4\u7fd2\u63a7\u5236\u62cd\u52d5\u6642\u9593\uff0c\u4ee5\u907f\u958b\u7194\u5ca9\u6d41\u7b49\u969c\u7919\u7269\u3002\u6b65\u9a5f\u4e00\uff1a\u5f9e\u6559\u5b78\u958b\u59cb\uff0c\u4e86\u89e3\u904a\u6232\u6a5f\u5236\u3002\u6b65\u9a5f\u4e8c\uff1a\u9032\u884c\u77ed\u6642\u9593\u904a\u6232\uff0c\u5efa\u7acb\u808c\u8089\u8a18\u61b6\u3002\u6b65\u9a5f\u4e09\uff1a\u9010\u6f38\u589e\u52a0\u96e3\u5ea6\uff0c\u5617\u8a66\u66f4\u9577\u6642\u9593\u7684\u98db\u884c\u3002\u4f7f\u7528\u914d\u7f6e\u8868\uff0c\u4ee5\u66f4\u597d\u5730\u7406\u89e3\u63a7\u5236\u8a2d\u5b9a\u3002"}, {"question": "\u5728\u300a\u7194\u5ca9\u9ce5\u300b\u4e2d\u751f\u5b58\u66f4\u9577\u6642\u9593\u7684\u95dc\u9375\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u300a\u7194\u5ca9\u9ce5\u300b\u4e2d\u751f\u5b58\u66f4\u9577\u6642\u9593\u9700\u8981\u7d50\u5408\u6642\u6a5f\u548c\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u89c0\u5bdf\u7194\u5ca9\u6d41\u7684\u898f\u5f8b\uff0c\u4e26\u63a7\u5236\u62cd\u52d5\u6642\u9593\uff0c\u4ee5\u901a\u904e\u9593\u9699\u3002\u6b65\u9a5f\u4e00\uff1a\u5c08\u6ce8\u65bc\u4fdd\u6301\u7a69\u5b9a\u9ad8\u5ea6\u3002\u6b65\u9a5f\u4e8c\uff1a\u9810\u6e2c\u5373\u5c07\u51fa\u73fe\u7684\u969c\u7919\u7269\uff0c\u4e26\u63d0\u524d\u505a\u597d\u6e96\u5099\u3002\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u300c\u7194\u5ca9\u76fe\u300d\u7b49\u9053\u5177\uff0c\u7372\u5f97\u66ab\u6642\u7684\u65e0\u654c\u72c0\u614b\u3002\u6d41\u7a0b\u5716\u53ef\u4ee5\u5e6b\u52a9\u8996\u89ba\u5316\u904a\u6232\u4e2d\u7684\u6c7a\u7b56\u9ede\uff0c\u4f8b\u5982\u4f55\u6642\u4f7f\u7528\u9053\u5177\u6216\u4f55\u6642\u5192\u96aa\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u300a\u7194\u5ca9\u9ce5\u300b\u7684\u96e3\u5ea6\u6703\u96a8\u8457\u6642\u9593\u589e\u52a0\uff1f", "answer": "\u300a\u7194\u5ca9\u9ce5\u300b\u7684\u96e3\u5ea6\u589e\u52a0\u662f\u70ba\u4e86\u4fdd\u6301\u904a\u6232\u7684\u6311\u6230\u6027\u548c\u5438\u5f15\u529b\u3002\u4f8b\u5982\uff0c\u96a8\u8457\u904a\u6232\u9032\u5ea6\uff0c\u7194\u5ca9\u6d41\u7684\u901f\u5ea6\u548c\u4e0d\u53ef\u9810\u6e2c\u6027\u6703\u589e\u52a0\u3002\u9019\u900f\u904e\u52d5\u614b\u96e3\u5ea6\u8abf\u6574\uff08DDA\uff09\u5be6\u73fe\uff0c\u78ba\u4fdd\u73a9\u5bb6\u4e0d\u65b7\u53d7\u5230\u8003\u9a57\u3002\u6bd4\u8f03\u8868\u53ef\u4ee5\u986f\u793a\u969c\u7919\u7269\u901f\u5ea6\u548c\u983b\u7387\u5982\u4f55\u96a8\u8457\u6642\u9593\u8b8a\u5316\uff0c\u63d0\u4f9b\u5c0d\u904a\u6232\u63d0\u5347\u6a5f\u5236\u7684\u6e05\u6670\u7406\u89e3\u3002"}, {"question": "\u300a\u7194\u5ca9\u9ce5\u300b\u4e2d\u6700\u6709\u6548\u7684\u9053\u5177\u6709\u54ea\u4e9b\uff0c\u4ee5\u53ca\u5982\u4f55\u4f7f\u7528\u5b83\u5011\uff1f", "answer": "\u300a\u7194\u5ca9\u9ce5\u300b\u4e2d\u6700\u6709\u6548\u7684\u9053\u5177\u5305\u62ec\u300c\u7194\u5ca9\u76fe\u300d\u548c\u300c\u52a0\u901f\u300d\u3002\u4f8b\u5982\uff0c\u300c\u7194\u5ca9\u76fe\u300d\u63d0\u4f9b\u66ab\u6642\u7684\u65e0\u654c\u72c0\u614b\uff0c\u8b93\u4f60\u53ef\u4ee5\u6beb\u9aee\u7121\u50b7\u5730\u901a\u904e\u969c\u7919\u7269\u3002\u6b65\u9a5f\u4e00\uff1a\u76e1\u53ef\u80fd\u6536\u96c6\u9053\u5177\u3002\u6b65\u9a5f\u4e8c\uff1a\u5728\u6311\u6230\u6027\u74b0\u7bc0\u4fdd\u5b58\u300c\u7194\u5ca9\u76fe\u300d\u3002\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u300c\u52a0\u901f\u300d\u5feb\u901f\u901a\u904e\u5bc6\u96c6\u7684\u969c\u7919\u7fa4\u3002\u591a\u65b9\u6848\u6bd4\u8f03\u53ef\u4ee5\u8aaa\u660e\u6bcf\u7a2e\u9053\u5177\u5728\u6700\u4f73\u5834\u666f\u4e0b\u7684\u4f7f\u7528\u3002"}, {"question": "\u300a\u7194\u5ca9\u9ce5\u300b\u7684\u5f97\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u300a\u7194\u5ca9\u9ce5\u300b\u7684\u5f97\u5206\u7cfb\u7d71\u57fa\u65bc\u98db\u884c\u8ddd\u96e2\u548c\u6536\u96c6\u7684\u91d1\u5e63\u3002\u4f8b\u5982\uff0c\u6bcf\u98db\u884c10\u7c73\u6703\u589e\u52a01\u5206\uff0c\u6bcf\u500b\u91d1\u5e63\u6703\u589e\u52a05\u5206\u3002\u9023\u7e8c\u5b8c\u7f8e\u901a\u904e\u7684\u5340\u6bb5\u6703\u7372\u5f97\u984d\u5916\u5206\u6578\u3002\u914d\u7f6e\u8868\u53ef\u4ee5\u5206\u89e3\u5f97\u5206\u6a5f\u5236\uff0c\u986f\u793a\u4e0d\u540c\u52d5\u4f5c\u5982\u4f55\u8ca2\u737b\u7e3d\u5206\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u7194\u5ca9\u9ce5\u300b\u4e2d\u5c07\u8cc7\u6599\u5728\u4e0d\u540c\u88dd\u7f6e\u4e4b\u9593\u9077\u79fb\uff1f", "answer": "\u8981\u5728\u4e0d\u540c\u7684\u88dd\u7f6e\u4e4b\u9593\u9077\u79fb\u300a\u7194\u5ca9\u9ce5\u300b\u7684\u8cc7\u6599\uff0c\u8acb\u78ba\u4fdd\u60a8\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u90fd\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u3002\u4f8b\u5982\uff0c\u4f7f\u7528Google Play Games\u6216Game Center\u7b49\u96f2\u7aef\u5132\u5b58\u529f\u80fd\uff0c\u53ef\u4ee5\u5be6\u73fe\u7121\u7e2b\u8f49\u79fb\u3002\u6b65\u9a5f\u4e00\uff1a\u900f\u904e\u96f2\u7aef\u5099\u4efd\u60a8\u7684\u904a\u6232\u9032\u5ea6\u3002\u6b65\u9a5f\u4e8c\uff1a\u5728\u65b0\u88dd\u7f6e\u4e0a\u5b89\u88dd\u300a\u7194\u5ca9\u9ce5\u300b\u3002\u6b65\u9a5f\u4e09\uff1a\u767b\u5165\u4e26\u540c\u6b65\u60a8\u7684\u8cc7\u6599\u3002\u6d41\u7a0b\u5716\u53ef\u4ee5\u5f15\u5c0e\u60a8\u5b8c\u6210\u9077\u79fb\u904e\u7a0b\uff0c\u78ba\u4fdd\u6c92\u6709\u8cc7\u6599\u907a\u5931\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u767c\u73fe\u300a\u7194\u5ca9\u9ce5\u300b\u4e2d\u7684\u96b1\u85cf\u5167\u5bb9\uff1f", "answer": "\u300a\u7194\u5ca9\u9ce5\u300b\u4e2d\u7684\u96b1\u85cf\u5167\u5bb9\u53ef\u4ee5\u900f\u904e\u63a2\u7d22\u79d8\u5bc6\u8def\u7dda\u6216\u9054\u6210\u7279\u5b9a\u91cc\u7a0b\u7891\u4f86\u767c\u73fe\u3002\u4f8b\u5982\uff0c\u5728\u7b2c5\u95dc\u7a7f\u904e\u96b1\u85cf\u7684\u96a7\u9053\u53ef\u4ee5\u89e3\u9396\u7279\u6b8a\u76ae\u819a\u3002\u6b65\u9a5f\u4e00\uff1a\u6ce8\u610f\u74b0\u5883\u7dda\u7d22\uff0c\u4f8b\u5982\u4e0d\u5c0b\u5e38\u7684\u5ca9\u77f3\u7d50\u69cb\u3002\u6b65\u9a5f\u4e8c\uff1a\u5617\u8a66\u4e0d\u540c\u7684\u8def\u7dda\u3002\u6b65\u9a5f\u4e09\uff1a\u5b8c\u6210\u6311\u6230\u4ee5\u63ed\u793a\u96b1\u85cf\u734e\u52f5\u3002\u5730\u5716\u5716\u8868\u53ef\u4ee5\u6a19\u793a\u96b1\u85cf\u5167\u5bb9\u7684\u6f5b\u5728\u4f4d\u7f6e\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u300a\u7194\u5ca9\u9ce5\u300b\u4e2d\u7684\u67d0\u4e9b\u969c\u7919\u7269\u6bd4\u5176\u4ed6\u969c\u7919\u7269\u66f4\u5177\u6311\u6230\u6027\uff1f", "answer": "\u300a\u7194\u5ca9\u9ce5\u300b\u4e2d\u7684\u67d0\u4e9b\u969c\u7919\u7269\u7531\u65bc\u5176\u8a2d\u8a08\u548c\u884c\u70ba\u800c\u66f4\u5177\u6311\u6230\u6027\u3002\u4f8b\u5982\uff0c\u79fb\u52d5\u7684\u7194\u5ca9\u6d41\u9700\u8981\u7cbe\u78ba\u7684\u6642\u6a5f\u624d\u80fd\u901a\u904e\uff0c\u800c\u975c\u614b\u969c\u7919\u7269\u5247\u66f4\u5bb9\u6613\u907f\u514d\u3002\u9019\u900f\u904e\u5404\u7a2e\u969c\u7919\u7269\u6a5f\u5236\uff08\u4f8b\u5982\u901f\u5ea6\u548c\u79fb\u52d5\u6a21\u5f0f\uff09\u5be6\u73fe\u3002\u6bd4\u8f03\u8868\u53ef\u4ee5\u8aaa\u660e\u969c\u7919\u7269\u985e\u578b\u4e4b\u9593\u7684\u5dee\u7570\uff0c\u5e6b\u52a9\u73a9\u5bb6\u76f8\u61c9\u5730\u5236\u5b9a\u7b56\u7565\u3002"}, {"question": "\u5728\u4f4e\u968e\u88dd\u7f6e\u4e0a\uff0c\u300a\u7194\u5ca9\u9ce5\u300b\u7684\u6700\u4f73\u8a2d\u5b9a\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5c0d\u65bc\u4f4e\u968e\u88dd\u7f6e\uff0c\u8acb\u512a\u5316\u300a\u7194\u5ca9\u9ce5\u300b\u7684\u65b9\u6cd5\u662f\u964d\u4f4e\u5716\u5f62\u54c1\u8cea\u4e26\u95dc\u9589\u80cc\u666f\u8655\u7406\u3002\u4f8b\u5982\uff0c\u5c07\u89e3\u6790\u5ea6\u964d\u4f4e\u81f3720p\u4e26\u95dc\u9589\u7c92\u5b50\u6548\u679c\u53ef\u4ee5\u63d0\u9ad8\u6548\u80fd\u3002\u6b65\u9a5f\u4e00\uff1a\u9032\u5165\u8a2d\u5b9a\u9078\u55ae\u3002\u6b65\u9a5f\u4e8c\uff1a\u8abf\u6574\u5716\u5f62\u548c\u6548\u80fd\u9078\u9805\u3002\u6b65\u9a5f\u4e09\uff1a\u6e2c\u8a66\u904a\u6232\uff0c\u78ba\u4fdd\u904a\u6232\u9806\u66a2\u3002\u914d\u7f6e\u8868\u53ef\u4ee5\u986f\u793a\u5404\u7a2e\u88dd\u7f6e\u898f\u683c\u7684\u6700\u4f73\u8a2d\u5b9a\u3002"}, {"question": "\u300a\u7194\u5ca9\u9ce5\u300b\u4e2d\u7684\u6210\u5c31\u5982\u4f55\u589e\u5f37\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u300a\u7194\u5ca9\u9ce5\u300b\u4e2d\u7684\u6210\u5c31\u589e\u52a0\u4e86\u76ee\u6a19\u548c\u734e\u52f5\uff0c\u8c50\u5bcc\u4e86\u904a\u6232\u9ad4\u9a57\u3002\u4f8b\u5982\uff0c\u300c\u7194\u5ca9\u5927\u5e2b\u300d\u6210\u5c31\u9700\u8981\u5728\u6c92\u6709\u78b0\u5230\u4efb\u4f55\u969c\u7919\u7269\u768410\u5206\u9418\u5167\u751f\u5b58\u4e0b\u4f86\u3002\u6b65\u9a5f\u4e00\uff1a\u6aa2\u95b1\u6210\u5c31\u6e05\u55ae\uff0c\u4e86\u89e3\u76ee\u6a19\u3002\u6b65\u9a5f\u4e8c\uff1a\u5728\u904a\u6232\u4e2d\u5c08\u6ce8\u65bc\u7279\u5b9a\u7684\u6311\u6230\u3002\u6b65\u9a5f\u4e09\uff1a\u5b8c\u6210\u6311\u6230\u5f8c\u7372\u5f97\u734e\u52f5\uff0c\u4f8b\u5982\u91d1\u5e63\u6216\u76ae\u819a\u3002\u6d41\u7a0b\u5716\u53ef\u4ee5\u6982\u8ff0\u89e3\u9396\u6210\u5c31\u7684\u6b65\u9a5f\uff0c\u63d0\u4f9b\u4e00\u689d\u6e05\u6670\u7684\u9032\u5ea6\u8def\u5f91\u3002"}]
[{"question": "\uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \uc6a9\uc554\uc0c8\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc5b4\ub5bb\uac8c \ub9c8\uc2a4\ud130\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc6a9\uc554\uc0c8\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ub9c8\uc2a4\ud130\ud558\ub824\uba74 \ud130\uce58 \ub610\ub294 \ud0a4\ubcf4\ub4dc \uc785\ub825\uc5d0 \uc775\uc219\ud574\uc9c0\ub294 \uac83\uc73c\ub85c \uc2dc\uc791\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud654\uba74\uc744 \ud0ed\ud558\uac70\ub098 \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \ub204\ub974\uba74 \uc0c8\uac00 \ub0a0\uac1c\uc9d3\uc744 \ud558\uc5ec \uc0c1\uc2b9\ud569\ub2c8\ub2e4. \uc6a9\uc554 \ud750\ub984\uacfc \uac19\uc740 \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\uae30 \uc704\ud574 \ub0a0\uac1c\uc9d3 \ud0c0\uc774\ubc0d \uc5f0\uc2b5\uc744 \ud558\uc138\uc694. STEP1: \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\uae30 \uc704\ud574 \ud29c\ud1a0\ub9ac\uc5bc\ub85c \uc2dc\uc791\ud558\uc138\uc694. STEP2: \uadfc\uc721 \uae30\uc5b5\ub825\uc744 \uad6c\ucd95\ud558\uae30 \uc704\ud574 \uc9e7\uc740 \uc2dc\uac04 \ud50c\ub808\uc774\ub97c \ud558\uc138\uc694. STEP3: \uc810\ucc28\uc801\uc73c\ub85c \ub354 \uae34 \ube44\ud589\uc744 \uc2dc\ub3c4\ud558\uc5ec \ub09c\uc774\ub3c4\ub97c \ub192\uc774\uc138\uc694. \ucee8\ud2b8\ub864\uc744 \ub354 \uc798 \uc774\ud574\ud558\uae30 \uc704\ud574 \uad6c\uc131\ud45c\ub97c \uc0ac\uc6a9\ud558\uc138\uc694."}, {"question": "\uc6a9\uc554\uc0c8\uc5d0\uc11c \ub354 \uc624\ub798 \uc0dd\uc874\ud558\uae30 \uc704\ud55c \uc8fc\uc694 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc6a9\uc554\uc0c8\uc5d0\uc11c \ub354 \uc624\ub798 \uc0dd\uc874\ud558\ub824\uba74 \uc2dc\uac04 \uc870\uc808\uacfc \uc804\ub7b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc6a9\uc554 \ud750\ub984\uc758 \ud328\ud134\uc744 \uad00\ucc30\ud558\uace0 \ud2c8\uc0c8\ub97c \uc9c0\ub098\uac08 \uc218 \uc788\ub3c4\ub85d \ub0a0\uac1c\uc9d3 \ud0c0\uc774\ubc0d\uc744 \ub9de\ucd94\uc138\uc694. STEP1: \uafb8\uc900\ud55c \uace0\ub3c4\ub97c \uc720\uc9c0\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. STEP2: \uc55e\uc73c\ub85c \uc2a4\uce94\ud558\uc5ec \ub2e4\uac00\uc624\ub294 \uc7a5\uc560\ubb3c\uc744 \uc608\uce21\ud558\uc138\uc694. STEP3: '\uc6a9\uc554 \ubc29\ud328'\uc640 \uac19\uc740 \uac15\ud654 \uc544\uc774\ud15c\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc77c\uc2dc\uc801\uc73c\ub85c \ubb34\uc801 \uc0c1\ud0dc\uac00 \ub418\uc138\uc694. \ud50c\ub85c\uc6b0\ucc28\ud2b8\ub294 \uac8c\uc784 \uc911 \uc758\uc0ac \uacb0\uc815 \uc9c0\uc810(\uc608: \uac15\ud654 \uc544\uc774\ud15c \uc0ac\uc6a9 \uc2dc\uae30 \ub610\ub294 \uc704\ud5d8 \uac10\uc218 \uc2dc\uae30)\uc744 \uc2dc\uac01\ud654\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc6a9\uc554\uc0c8\uc758 \ub09c\uc774\ub3c4\uac00 \uc2dc\uac04\uc774 \uc9c0\ub0a8\uc5d0 \ub530\ub77c \uc99d\uac00\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc6a9\uc554\uc0c8\uc758 \ub09c\uc774\ub3c4\uac00 \uc99d\uac00\ud558\ub294 \uac83\uc740 \uac8c\uc784\uc758 \ucc4c\ub9b0\uc9c0\uc640 \ucc38\uc5ec\ub3c4\ub97c \uc720\uc9c0\ud558\uae30 \uc704\ud574\uc11c\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac8c\uc784 \uc9c4\ud589 \uc2dc \uc6a9\uc554 \ud750\ub984\uc758 \uc18d\ub3c4\uc640 \uc608\uce21 \ubd88\uac00\ub2a5\uc131\uc774 \ub192\uc544\uc9d1\ub2c8\ub2e4. \uc774\ub294 \ub3d9\uc801 \ub09c\uc774\ub3c4 \uc870\uc815(DDA)\ub97c \ud1b5\ud574 \ub2ec\uc131\ub418\uba70, \ud50c\ub808\uc774\uc5b4\uac00 \uc9c0\uc18d\uc801\uc73c\ub85c \ud14c\uc2a4\ud2b8\ub418\ub3c4\ub85d \ud569\ub2c8\ub2e4. \ube44\uad50\ud45c\ub294 \uc7a5\uc560\ubb3c \uc18d\ub3c4\uc640 \ube48\ub3c4\uac00 \uc2dc\uac04\uc774 \uc9c0\ub0a8\uc5d0 \ub530\ub77c \uc5b4\ub5bb\uac8c \ubcc0\ud654\ud558\ub294\uc9c0 \ubcf4\uc5ec\uc8fc\uc5b4 \uac8c\uc784\uc758 \ud655\uc7a5 \uba54\ucee4\ub2c8\uc998\uc744 \uba85\ud655\ud558\uac8c \uc774\ud574\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4."}, {"question": "\uc6a9\uc554\uc0c8\uc5d0\uc11c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \uac15\ud654 \uc544\uc774\ud15c\uc740 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \uc0ac\uc6a9\ud574\uc57c \ud558\ub098\uc694?", "answer": "\uc6a9\uc554\uc0c8\uc5d0\uc11c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \uac15\ud654 \uc544\uc774\ud15c\uc740 '\uc6a9\uc554 \ubc29\ud328'\uc640 '\uc18d\ub3c4 \ubd80\uc2a4\ud130'\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc6a9\uc554 \ubc29\ud328'\ub294 \uc77c\uc2dc\uc801\uc73c\ub85c \ubb34\uc801 \uc0c1\ud0dc\ub97c \ubd80\uc5ec\ud558\uc5ec \uc7a5\uc560\ubb3c\uc744 \ud53c\ud574 \uc5c6\uc774 \ud1b5\uacfc\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. STEP1: \uac00\ub2a5\ud560 \ub54c\ub9c8\ub2e4 \uac15\ud654 \uc544\uc774\ud15c\uc744 \uc218\uc9d1\ud558\uc138\uc694. STEP2: \uc5b4\ub824\uc6b4 \uad6c\uac04\uc5d0\uc11c\ub294 '\uc6a9\uc554 \ubc29\ud328'\ub97c \uc544\uaef4 \uc0ac\uc6a9\ud558\uc138\uc694. STEP3: '\uc18d\ub3c4 \ubd80\uc2a4\ud130'\ub97c \uc0ac\uc6a9\ud558\uc5ec \ubc00\uc9d1\ub41c \uc7a5\uc560\ubb3c \uad70\uc744 \ube60\ub974\uac8c \uc6b0\ud68c\ud558\uc138\uc694. \uac01 \uac15\ud654 \uc544\uc774\ud15c\uc5d0 \uac00\uc7a5 \uc801\ud569\ud55c \uc0c1\ud669\uc744 \ubcf4\uc5ec\uc8fc\ub294 \ub2e4\uc911 \uc2a4\ud0a4\ub9c8 \ube44\uad50\ud45c\uac00 \uc788\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc6a9\uc554\uc0c8\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "\uc6a9\uc554\uc0c8\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc774\ub3d9 \uac70\ub9ac\uc640 \uc218\uc9d1\ud55c \ucf54\uc778\uc744 \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 10m\ub9c8\ub2e4 1\uc810\uc774 \ucd94\uac00\ub418\uace0 \uac01 \ucf54\uc778\uc740 5\uc810\uc774 \ucd94\uac00\ub429\ub2c8\ub2e4. \uc5f0\uc18d\ub41c \uc644\ubcbd\ud55c \uad6c\uac04\uc5d0 \ub300\ud55c \ubcf4\ub108\uc2a4 \uc810\uc218\uac00 \ubd80\uc5ec\ub429\ub2c8\ub2e4. \uad6c\uc131\ud45c\ub294 \ub2e4\uc591\ud55c \ud589\ub3d9\uc774 \ucd1d \uc810\uc218\uc5d0 \uc5b4\ub5bb\uac8c \uae30\uc5ec\ud558\ub294\uc9c0 \ubcf4\uc5ec\uc8fc\ub294 \uc810\uc218 \uba54\ucee4\ub2c8\uc998\uc744 \ubcf4\uc5ec\uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc7a5\uce58 \uac04 \uc6a9\uc554\uc0c8 \ub370\uc774\ud130 \ub9c8\uc774\uadf8\ub808\uc774\uc158\uc744 \uc704\ud55c \ucd5c\uc0c1\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc7a5\uce58 \uac04 \uc6a9\uc554\uc0c8 \ub370\uc774\ud130\ub97c \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud558\ub824\uba74 \ub450 \uc7a5\uce58 \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, Google Play \uac8c\uc784 \ub610\ub294 Game Center\uc640 \uac19\uc740 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uba74 \uc6d0\ud65c\ud55c \uc804\uc1a1\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4. STEP1: \ud074\ub77c\uc6b0\ub4dc\ub97c \ud1b5\ud574 \ud604\uc7ac \uc9c4\ud589 \uc0c1\ud669\uc744 \ubc31\uc5c5\ud558\uc138\uc694. STEP2: \uc0c8 \uc7a5\uce58\uc5d0 \uc6a9\uc554\uc0c8\ub97c \uc124\uce58\ud558\uc138\uc694. STEP3: \ub85c\uadf8\uc778\ud558\uace0 \ub370\uc774\ud130\ub97c \ub3d9\uae30\ud654\ud558\uc138\uc694. \ud50c\ub85c\uc6b0\ucc28\ud2b8\ub294 \ub370\uc774\ud130 \uc190\uc2e4 \uc5c6\uc774 \ub9c8\uc774\uadf8\ub808\uc774\uc158 \ud504\ub85c\uc138\uc2a4\ub97c \uc548\ub0b4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 \uc6a9\uc554\uc0c8\uc5d0\uc11c \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\ub098\uc694?", "answer": "\uc6a9\uc554\uc0c8\uc5d0\uc11c \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub294 \ube44\ubc00 \ud1b5\ub85c\ub97c \ud0d0\ud5d8\ud558\uac70\ub098 \ud2b9\uc815 \uc774\uc815\ud45c\ub97c \ub2ec\uc131\ud568\uc73c\ub85c\uc368 \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 5\ub808\ubca8\uc758 \uc228\uaca8\uc9c4 \ud130\ub110\uc744 \ud1b5\uacfc\ud558\uba74 \ud2b9\ubcc4\ud55c \uc2a4\ud0a8\uc774 \ud574\uae08\ub429\ub2c8\ub2e4. STEP1: \ube44\uc815\uc0c1\uc801\uc778 \ubc14\uc704 \ud615\ud0dc\uc640 \uac19\uc740 \ud658\uacbd \ub2e8\uc11c\uc5d0 \uc8fc\uc758\ud558\uc138\uc694. STEP2: \uc5ec\ub7ec \uacbd\ub85c\ub97c \uc2dc\ub3c4\ud574 \ubcf4\uc138\uc694. STEP3: \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\uc5ec \uc228\uaca8\uc9c4 \ubcf4\uc0c1\uc744 \uc5bb\uc73c\uc138\uc694. \uc9c0\ub3c4 \ub2e4\uc774\uc5b4\uadf8\ub7a8\uc740 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\uc758 \uc7a0\uc7ac\uc801 \uc704\uce58\ub97c \uac15\uc870\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud2b9\uc815 \uc7a5\uc560\ubb3c\uc774 \uc6a9\uc554\uc0c8\uc5d0\uc11c \ub2e4\ub978 \uc7a5\uc560\ubb3c\ubcf4\ub2e4 \ub354 \uc5b4\ub824\uc6b4 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc6a9\uc554\uc0c8\uc758 \ud2b9\uc815 \uc7a5\uc560\ubb3c\uc774 \ub2e4\ub978 \uc7a5\uc560\ubb3c\ubcf4\ub2e4 \ub354 \uc5b4\ub824\uc6b4 \uac83\uc740 \ub514\uc790\uc778\uacfc \ub3d9\uc791 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc774\ub3d9\ud558\ub294 \uc6a9\uc554 \ud750\ub984\uc740 \ud1b5\uacfc\ud558\uae30 \uc704\ud574 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uc774 \ud544\uc694\ud558\uc9c0\ub9cc, \uc815\uc9c0\ub41c \uc7a5\uc560\ubb3c\uc740 \ud53c\ud558\uae30\uac00 \ub354 \uc27d\uc2b5\ub2c8\ub2e4. \uc774\ub294 \uc18d\ub3c4 \ubc0f \uc6c0\uc9c1\uc784 \ud328\ud134\uacfc \uac19\uc740 \ub2e4\uc591\ud55c \uc7a5\uc560\ubb3c \uba54\ucee4\ub2c8\uc998\uc744 \ud1b5\ud574 \ub2ec\uc131\ub429\ub2c8\ub2e4. \ube44\uad50\ud45c\ub294 \uc7a5\uc560\ubb3c \uc720\ud615 \uac04\uc758 \ucc28\uc774\uc810\uc744 \ubcf4\uc5ec\uc8fc\uc5b4 \ud50c\ub808\uc774\uc5b4\uac00 \ub530\ub77c\uc11c \uc804\ub7b5\uc744 \uc138\uc6b0\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4."}, {"question": "\uc800\uc0ac\uc591 \uc7a5\uce58\uc5d0\uc11c \uc6a9\uc554\uc0c8\uc758 \ucd5c\uc801 \uc124\uc815\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc800\uc0ac\uc591 \uc7a5\uce58\uc758 \uacbd\uc6b0 \uc6a9\uc554\uc0c8\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \uadf8\ub798\ud53d \ud488\uc9c8\uc744 \ub0ae\ucd94\uace0 \ubc31\uadf8\ub77c\uc6b4\ub4dc \ud504\ub85c\uc138\uc2a4\ub97c \ube44\ud65c\uc131\ud654\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud574\uc0c1\ub3c4\ub97c 720p\ub85c \ub0ae\ucd94\uace0 \uc785\uc790 \ud6a8\uacfc\ub97c \ub044\uba74 \uc131\ub2a5\uc774 \uac1c\uc120\ub429\ub2c8\ub2e4. STEP1: \uc124\uc815 \uba54\ub274\uc5d0 \uc811\uadfc\ud558\uc138\uc694. STEP2: \uadf8\ub798\ud53d\uacfc \uc131\ub2a5 \uc635\uc158\uc744 \uc870\uc815\ud558\uc138\uc694. STEP3: \uc6d0\ud65c\ud55c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud655\uc778\ud558\uae30 \uc704\ud574 \uac8c\uc784\uc744 \ud14c\uc2a4\ud2b8\ud558\uc138\uc694. \uad6c\uc131\ud45c\ub294 \ub2e4\uc591\ud55c \uc7a5\uce58 \uc0ac\uc591\uc5d0 \ub300\ud55c \ucd5c\uc0c1\uc758 \uc124\uc815\uc744 \ubcf4\uc5ec\uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc6a9\uc554\uc0c8\uc758 \uc131\ucde8\ub3c4\uac00 \uac8c\uc784 \uacbd\ud5d8\uc744 \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0a4\ub098\uc694?", "answer": "\uc6a9\uc554\uc0c8\uc758 \uc131\ucde8\ub3c4\ub294 \ubaa9\ud45c\uc640 \ubcf4\uc0c1\uc744 \ucd94\uac00\ud558\uc5ec \uac8c\uc784 \uacbd\ud5d8\uc744 \ud48d\uc131\ud558\uac8c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc6a9\uc554 \ub9c8\uc2a4\ud130' \uc131\ucde8\ub3c4\ub294 \uc7a5\uc560\ubb3c\uc5d0 \ub2ff\uc9c0 \uc54a\uace0 10\ubd84 \ub3d9\uc548 \uc0dd\uc874\ud558\uc5ec \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \ubaa9\ud45c\ub97c \uc704\ud574 \uc131\ucde8\ub3c4 \ubaa9\ub85d\uc744 \uac80\ud1a0\ud558\uc138\uc694. STEP2: \uac8c\uc784 \ud50c\ub808\uc774 \uc911 \ud2b9\uc815 \ucc4c\ub9b0\uc9c0\uc5d0 \uc9d1\uc911\ud558\uc138\uc694. STEP3: \uc644\ub8cc \uc2dc \ucf54\uc778\uc774\ub098 \uc2a4\ud0a8\uacfc \uac19\uc740 \ubcf4\uc0c1\uc744 \ubc1b\uc73c\uc138\uc694. \ud50c\ub85c\uc6b0\ucc28\ud2b8\ub294 \uc131\ucde8\ub3c4\ub97c \ud574\uc81c\ud558\ub294 \ub2e8\uacc4\ub97c \uac1c\ub7b5\uc801\uc73c\ub85c \ubcf4\uc5ec\uc8fc\uc5b4 \uc9c4\ud589 \ubc29\ud5a5\uc744 \uba85\ud655\ud558\uac8c \uc81c\uc2dc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
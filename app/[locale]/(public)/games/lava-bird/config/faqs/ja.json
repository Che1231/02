[{"question": "\u65b0\u73a9\u5bb6\u5982\u4f55\u638c\u63e1\u7194\u5ca9\u9e1f\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u638c\u63e1\u7194\u5ca9\u9e1f\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u8bf7\u5148\u719f\u6089\u89e6\u63a7\u6216\u952e\u76d8\u8f93\u5165\u3002\u4f8b\u5982\uff0c\u8f7b\u89e6\u5c4f\u5e55\u6216\u6309\u4e0b\u7a7a\u683c\u952e\u53ef\u4ee5\u8ba9\u9e1f\u513f\u62cd\u6253\u7fc5\u8180\u4e0a\u5347\u3002\u7ec3\u4e60\u63a7\u5236\u62cd\u6253\u65f6\u673a\uff0c\u907f\u514d\u649e\u4e0a\u7194\u5ca9\u6d41\u7b49\u969c\u788d\u7269\u3002\u6b65\u9aa41\uff1a\u4ece\u6559\u7a0b\u5f00\u59cb\uff0c\u7406\u89e3\u6e38\u620f\u673a\u5236\u3002\u6b65\u9aa42\uff1a\u8fdb\u884c\u77ed\u65f6\u95f4\u7684\u6e38\u620f\uff0c\u5efa\u7acb\u808c\u8089\u8bb0\u5fc6\u3002\u6b65\u9aa43\uff1a\u9010\u6e10\u63d0\u5347\u96be\u5ea6\uff0c\u5c1d\u8bd5\u66f4\u957f\u7684\u98de\u884c\u3002\u4f7f\u7528\u914d\u7f6e\u8868\u6765\u66f4\u597d\u5730\u4e86\u89e3\u63a7\u5236\u65b9\u6848\u3002"}, {"question": "\u5728\u7194\u5ca9\u9e1f\u6e38\u620f\u4e2d\uff0c\u5982\u4f55\u624d\u80fd\u66f4\u957f\u65f6\u95f4\u5730\u751f\u5b58\u4e0b\u53bb\uff1f", "answer": "\u5728\u7194\u5ca9\u9e1f\u6e38\u620f\u4e2d\uff0c\u957f\u65f6\u95f4\u751f\u5b58\u9700\u8981\u7ed3\u5408\u65f6\u673a\u548c\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u89c2\u5bdf\u7194\u5ca9\u6d41\u7684\u89c4\u5f8b\uff0c\u5e76\u63a7\u5236\u62cd\u6253\u65f6\u673a\u901a\u8fc7\u95f4\u9699\u3002\u6b65\u9aa41\uff1a\u4e13\u6ce8\u4e8e\u4fdd\u6301\u7a33\u5b9a\u7684\u9ad8\u5ea6\u3002\u6b65\u9aa42\uff1a\u63d0\u524d\u626b\u63cf\uff0c\u9884\u6d4b\u5373\u5c06\u51fa\u73b0\u7684\u969c\u788d\u7269\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\"\u7194\u5ca9\u76fe\"\u7b49\u9053\u5177\u6765\u83b7\u5f97\u77ed\u6682\u7684\u65e0\u654c\u72b6\u6001\u3002\u6d41\u7a0b\u56fe\u53ef\u4ee5\u5e2e\u52a9\u53ef\u89c6\u5316\u6e38\u620f\u8fc7\u7a0b\u4e2d\u7684\u51b3\u7b56\u70b9\uff0c\u4f8b\u5982\u4f55\u65f6\u4f7f\u7528\u9053\u5177\u6216\u4f55\u65f6\u5192\u9669\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u7194\u5ca9\u9e1f\u6e38\u620f\u7684\u96be\u5ea6\u4f1a\u968f\u7740\u65f6\u95f4\u63a8\u79fb\u800c\u589e\u52a0\uff1f", "answer": "\u7194\u5ca9\u9e1f\u6e38\u620f\u7684\u96be\u5ea6\u4f1a\u968f\u7740\u65f6\u95f4\u63a8\u79fb\u800c\u589e\u52a0\uff0c\u4ee5\u4fdd\u6301\u6e38\u620f\u5177\u6709\u6311\u6218\u6027\u548c\u5438\u5f15\u529b\u3002\u4f8b\u5982\uff0c\u968f\u7740\u4f60\u7684\u6e38\u620f\u8fdb\u5ea6\uff0c\u7194\u5ca9\u6d41\u4f1a\u53d8\u5f97\u66f4\u5feb\u3001\u66f4\u96be\u4ee5\u9884\u6d4b\u3002\u8fd9\u901a\u8fc7\u52a8\u6001\u96be\u5ea6\u8c03\u6574(DDA) \u6765\u5b9e\u73b0\uff0c\u786e\u4fdd\u73a9\u5bb6\u4e0d\u65ad\u63a5\u53d7\u6311\u6218\u3002\u6bd4\u8f83\u8868\u53ef\u4ee5\u663e\u793a\u969c\u788d\u7269\u901f\u5ea6\u548c\u9891\u7387\u968f\u65f6\u95f4\u53d8\u5316\u7684\u60c5\u51b5\uff0c\u63d0\u4f9b\u5bf9\u6e38\u620f\u9012\u8fdb\u673a\u5236\u7684\u6e05\u6670\u7406\u89e3\u3002"}, {"question": "\u7194\u5ca9\u9e1f\u6e38\u620f\u4e2d\u54ea\u4e9b\u9053\u5177\u6700\u6709\u6548\uff0c\u4ee5\u53ca\u5982\u4f55\u4f7f\u7528\u5b83\u4eec\uff1f", "answer": "\u7194\u5ca9\u9e1f\u4e2d\u6700\u6709\u6548\u7684\u9053\u5177\u5305\u62ec\"\u7194\u5ca9\u76fe\"\u548c\"\u52a0\u901f\"\u3002\u4f8b\u5982\uff0c\"\u7194\u5ca9\u76fe\"\u80fd\u63d0\u4f9b\u77ed\u6682\u7684\u65e0\u654c\u72b6\u6001\uff0c\u8ba9\u4f60\u80fd\u591f\u5b89\u5168\u5730\u7a7f\u8fc7\u969c\u788d\u7269\u3002\u6b65\u9aa41\uff1a\u5c3d\u53ef\u80fd\u6536\u96c6\u9053\u5177\u3002\u6b65\u9aa42\uff1a\u5c06\"\u7194\u5ca9\u76fe\"\u7559\u7ed9\u5177\u6709\u6311\u6218\u6027\u7684\u5173\u5361\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\"\u52a0\u901f\"\u6765\u5feb\u901f\u901a\u8fc7\u5bc6\u96c6\u7684\u969c\u788d\u7269\u7c07\u3002\u591a\u65b9\u6848\u6bd4\u8f83\u53ef\u4ee5\u8bf4\u660e\u5404\u79cd\u9053\u5177\u5728\u4e0d\u540c\u573a\u666f\u4e0b\u7684\u6700\u4f73\u4f7f\u7528\u65b9\u6cd5\u3002"}, {"question": "\u7194\u5ca9\u9e1f\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u7194\u5ca9\u9e1f\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u98de\u884c\u8ddd\u79bb\u548c\u6536\u96c6\u786c\u5e01\u7684\u6570\u91cf\u3002\u4f8b\u5982\uff0c\u6bcf\u98de\u884c10\u7c73\u589e\u52a01\u5206\uff0c\u800c\u6bcf\u4e2a\u786c\u5e01\u589e\u52a05\u5206\u3002\u8fde\u7eed\u5b8c\u7f8e\u98de\u884c\u83b7\u5f97\u989d\u5916\u5956\u52b1\u3002\u914d\u7f6e\u8868\u53ef\u4ee5\u5206\u89e3\u8bc4\u5206\u673a\u5236\uff0c\u663e\u793a\u5404\u79cd\u884c\u52a8\u5bf9\u603b\u5f97\u5206\u7684\u8d21\u732e\u3002"}, {"question": "\u5728\u7194\u5ca9\u9e1f\u6e38\u620f\u4e2d\uff0c\u5982\u4f55\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u8fc1\u79fb\u6570\u636e\uff1f", "answer": "\u8981\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u8fc1\u79fb\u7194\u5ca9\u9e1f\u6570\u636e\uff0c\u8bf7\u786e\u4fdd\u4f60\u5728\u4e24\u53f0\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u5e10\u6237\u3002\u4f8b\u5982\uff0c\u4f7f\u7528Google Play \u6e38\u620f\u6216\u6e38\u620f\u4e2d\u5fc3\u4e4b\u7c7b\u7684\u4e91\u4fdd\u5b58\u529f\u80fd\u53ef\u4ee5\u5b9e\u73b0\u65e0\u7f1d\u8f6c\u79fb\u3002\u6b65\u9aa41\uff1a\u901a\u8fc7\u4e91\u7aef\u5907\u4efd\u5f53\u524d\u8fdb\u5ea6\u3002\u6b65\u9aa42\uff1a\u5728\u65b0\u8bbe\u5907\u4e0a\u5b89\u88c5\u7194\u5ca9\u9e1f\u3002\u6b65\u9aa43\uff1a\u767b\u5f55\u5e76\u540c\u6b65\u6570\u636e\u3002\u6d41\u7a0b\u56fe\u53ef\u4ee5\u6307\u5bfc\u4f60\u5b8c\u6210\u8fc1\u79fb\u8fc7\u7a0b\uff0c\u786e\u4fdd\u4e0d\u4f1a\u4e22\u5931\u4efb\u4f55\u6570\u636e\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u53d1\u73b0\u7194\u5ca9\u9e1f\u4e2d\u7684\u9690\u85cf\u5185\u5bb9\uff1f", "answer": "\u7194\u5ca9\u9e1f\u4e2d\u7684\u9690\u85cf\u5185\u5bb9\u53ef\u4ee5\u901a\u8fc7\u63a2\u7d22\u79d8\u5bc6\u8def\u5f84\u6216\u5b8c\u6210\u7279\u5b9a\u91cc\u7a0b\u7891\u6765\u53d1\u73b0\u3002\u4f8b\u5982\uff0c\u57285\u7ea7\u6e38\u620f\u4e2d\u7a7f\u8fc7\u9690\u85cf\u7684\u96a7\u9053\u53ef\u4ee5\u89e3\u9501\u7279\u6b8a\u76ae\u80a4\u3002\u6b65\u9aa41\uff1a\u6ce8\u610f\u73af\u5883\u7ebf\u7d22\uff0c\u4f8b\u5982\u4e0d\u5bfb\u5e38\u7684\u5ca9\u77f3\u7ed3\u6784\u3002\u6b65\u9aa42\uff1a\u5c1d\u8bd5\u4e0d\u540c\u7684\u8def\u7ebf\u3002\u6b65\u9aa43\uff1a\u5b8c\u6210\u6311\u6218\u4ee5\u63ed\u793a\u9690\u85cf\u5956\u52b1\u3002\u5730\u56fe\u56fe\u53ef\u4ee5\u7a81\u51fa\u663e\u793a\u9690\u85cf\u5185\u5bb9\u7684\u6f5c\u5728\u4f4d\u7f6e\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u7194\u5ca9\u9e1f\u4e2d\u7684\u67d0\u4e9b\u969c\u788d\u7269\u6bd4\u5176\u4ed6\u969c\u788d\u7269\u66f4\u5177\u6709\u6311\u6218\u6027\uff1f", "answer": "\u7194\u5ca9\u9e1f\u4e2d\u7684\u67d0\u4e9b\u969c\u788d\u7269\u7531\u4e8e\u5176\u8bbe\u8ba1\u548c\u884c\u4e3a\u800c\u66f4\u5177\u6311\u6218\u6027\u3002\u4f8b\u5982\uff0c\u79fb\u52a8\u7684\u7194\u5ca9\u6d41\u9700\u8981\u7cbe\u786e\u7684\u65f6\u673a\u624d\u80fd\u901a\u8fc7\uff0c\u800c\u9759\u6001\u969c\u788d\u7269\u5219\u66f4\u5bb9\u6613\u907f\u514d\u3002\u8fd9\u901a\u8fc7\u5404\u79cd\u969c\u788d\u7269\u673a\u5236\uff08\u5982\u901f\u5ea6\u548c\u79fb\u52a8\u6a21\u5f0f\uff09\u6765\u5b9e\u73b0\u3002\u6bd4\u8f83\u8868\u53ef\u4ee5\u8bf4\u660e\u4e0d\u540c\u969c\u788d\u7269\u7c7b\u578b\u4e4b\u95f4\u7684\u5dee\u5f02\uff0c\u5e2e\u52a9\u73a9\u5bb6\u76f8\u5e94\u5730\u5236\u5b9a\u7b56\u7565\u3002"}, {"question": "\u5728\u4f4e\u7aef\u8bbe\u5907\u4e0a\uff0c\u7194\u5ca9\u9e1f\u7684\u6700\u4f73\u8bbe\u7f6e\u662f\u4ec0\u4e48\uff1f", "answer": "\u5bf9\u4e8e\u4f4e\u7aef\u8bbe\u5907\uff0c\u4f18\u5316\u7194\u5ca9\u9e1f\u7684\u65b9\u6cd5\u662f\u964d\u4f4e\u56fe\u5f62\u8d28\u91cf\u5e76\u7981\u7528\u540e\u53f0\u8fdb\u7a0b\u3002\u4f8b\u5982\uff0c\u5c06\u5206\u8fa8\u7387\u964d\u4f4e\u5230720p\u5e76\u5173\u95ed\u7c92\u5b50\u6548\u679c\u53ef\u4ee5\u63d0\u9ad8\u6027\u80fd\u3002\u6b65\u9aa41\uff1a\u8bbf\u95ee\u8bbe\u7f6e\u83dc\u5355\u3002\u6b65\u9aa42\uff1a\u8c03\u6574\u56fe\u5f62\u548c\u6027\u80fd\u9009\u9879\u3002\u6b65\u9aa43\uff1a\u6d4b\u8bd5\u6e38\u620f\u4ee5\u786e\u4fdd\u6d41\u7545\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u914d\u7f6e\u8868\u53ef\u4ee5\u663e\u793a\u5404\u79cd\u8bbe\u5907\u89c4\u683c\u7684\u6700\u4f73\u8bbe\u7f6e\u3002"}, {"question": "\u7194\u5ca9\u9e1f\u6e38\u620f\u4e2d\u7684\u6210\u5c31\u5982\u4f55\u63d0\u5347\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u7194\u5ca9\u9e1f\u6e38\u620f\u4e2d\u7684\u6210\u5c31\u6dfb\u52a0\u4e86\u76ee\u6807\u548c\u5956\u52b1\uff0c\u4e30\u5bcc\u4e86\u6e38\u620f\u4f53\u9a8c\u3002\u4f8b\u5982\uff0c\u8981\u83b7\u5f97\"\u7194\u5ca9\u5927\u5e08\"\u6210\u5c31\uff0c\u5fc5\u987b\u5728\u4e0d\u78b0\u5230\u4efb\u4f55\u969c\u788d\u7269\u7684\u6761\u4ef6\u4e0b\u751f\u5b5810\u5206\u949f\u3002\u6b65\u9aa41\uff1a\u67e5\u770b\u6210\u5c31\u5217\u8868\u4ee5\u4e86\u89e3\u76ee\u6807\u3002\u6b65\u9aa42\uff1a\u5728\u6e38\u620f\u4e2d\u4e13\u6ce8\u4e8e\u7279\u5b9a\u6311\u6218\u3002\u6b65\u9aa43\uff1a\u5b8c\u6210\u6311\u6218\u540e\uff0c\u9886\u53d6\u786c\u5e01\u6216\u76ae\u80a4\u7b49\u5956\u52b1\u3002\u6d41\u7a0b\u56fe\u53ef\u4ee5\u6982\u8ff0\u89e3\u9501\u6210\u5c31\u7684\u6b65\u9aa4\uff0c\u63d0\u4f9b\u6e05\u6670\u7684\u63d0\u5347\u8def\u5f84\u3002"}]
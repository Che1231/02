[{"question": "\u30be\u30f3\u30d3\u30fb\u30e9\u30c3\u30b7\u30e5\u3067\u79fb\u52d5\u3084\u5c04\u6483\u306a\u3069\u306e\u57fa\u672c\u64cd\u4f5c\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30be\u30f3\u30d3\u30fb\u30e9\u30c3\u30b7\u30e5\u3067\u306f\u3001\u753b\u9762\u5de6\u5074\u306e\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u3067\u79fb\u52d5\u3057\u307e\u3059\u3002\u5c04\u6483\u3059\u308b\u306b\u306f\u3001\u753b\u9762\u53f3\u5074\u306e\u767a\u5c04\u30dc\u30bf\u30f3\u3092\u30bf\u30c3\u30d7\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30be\u30f3\u30d3\u3092\u6483\u3061\u306a\u304c\u3089\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u53f3\u306b\u79fb\u52d5\u3055\u305b\u308b\u306b\u306f\u3001\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u3092\u53f3\u306b\u30c9\u30e9\u30c3\u30b0\u3057\u3001\u540c\u6642\u306b\u767a\u5c04\u30dc\u30bf\u30f3\u3092\u30bf\u30c3\u30d7\u3059\u308b\u3060\u3051\u3067\u3059\u3002[\u4f8b\u3048\uff1a\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u306f\u30b9\u30c6\u30a2\u30ea\u30f3\u30b0\u30db\u30a4\u30fc\u30eb\u3001\u767a\u5c04\u30dc\u30bf\u30f3\u306f\u30c8\u30ea\u30ac\u30fc\u3060\u3068\u601d\u3063\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30be\u30f3\u30d3\u30fb\u30e9\u30c3\u30b7\u30e5\u3067\u9577\u304f\u751f\u304d\u6b8b\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30be\u30f3\u30d3\u30fb\u30e9\u30c3\u30b7\u30e5\u3067\u9577\u304f\u751f\u304d\u6b8b\u308b\u306b\u306f\u3001\u6226\u7565\u7684\u306a\u79fb\u52d5\u3068\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u306e\u7d44\u307f\u5408\u308f\u305b\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff11\uff1a \u5e38\u306b\u79fb\u52d5\u3057\u3066\u30be\u30f3\u30d3\u306e\u7fa4\u308c\u3092\u907f\u3051\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d7\uff12\uff1a \u3088\u308a\u826f\u3044\u706b\u529b\u306e\u305f\u3081\u306b\u6b66\u5668\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d7\uff13\uff1a \u74b0\u5883\u306e\u969c\u5bb3\u7269\u3092\u4f7f\u3063\u3066\u30be\u30f3\u30d3\u3092\u30ad\u30eb\u30be\u30fc\u30f3\u306b\u8a98\u5c0e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u3001\u58c1\u306e\u8fd1\u304f\u306b\u7acb\u3063\u3066\u3044\u308b\u3053\u3068\u3067\u3001\u30be\u30f3\u30d3\u304c\u63a5\u8fd1\u3067\u304d\u308b\u65b9\u5411\u3092\u5236\u9650\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u30aa\u30fc\u30d7\u30f3\u306a\u5834\u6240\u306b\u7acb\u3063\u3066\u3044\u308b\u306e\u3068\u6bd4\u3079\u3066\u3001\u58c1\u3092\u4f7f\u3046\u3053\u3068\u3067\u4e00\u5ea6\u306b\u51e6\u7406\u3059\u308b\u30be\u30f3\u30d3\u306e\u6570\u3092\u6e1b\u3089\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002]"}, {"question": "\u30be\u30f3\u30d3\u30fb\u30e9\u30c3\u30b7\u30e5\u3067\u3001\u3055\u307e\u3056\u307e\u306a\u7a2e\u985e\u306e\u30be\u30f3\u30d3\u306b\u5bfe\u3057\u3066\u6700\u3082\u52b9\u679c\u7684\u306a\u6b66\u5668\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30be\u30f3\u30d3\u30fb\u30e9\u30c3\u30b7\u30e5\u3067\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u6b66\u5668\u304c\u3055\u307e\u3056\u307e\u306a\u7a2e\u985e\u306e\u30be\u30f3\u30d3\u306b\u5bfe\u3057\u3066\u52b9\u679c\u7684\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\u306f\u3001\u62e1\u6563\u30c0\u30e1\u30fc\u30b8\u306e\u305f\u3081\u306b\u901a\u5e38\u306e\u30be\u30f3\u30d3\u306e\u7fa4\u308c\u306b\u5bfe\u3057\u3066\u975e\u5e38\u306b\u52b9\u679c\u7684\u3067\u3059\u3002\u4e00\u65b9\u3001\u30b9\u30ca\u30a4\u30d1\u30fc\u30e9\u30a4\u30d5\u30eb\u306f\u3001\u9060\u304f\u304b\u3089\u30a2\u30fc\u30de\u30fc\u4ed8\u304d\u306e\u30be\u30f3\u30d3\u3092\u5012\u3059\u306e\u306b\u9069\u3057\u3066\u3044\u307e\u3059\u3002[\u69cb\u6210\u8868\uff1a\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3 - \u901a\u5e38\u306e\u30be\u30f3\u30d3\u3001\u30b9\u30ca\u30a4\u30d1\u30fc\u30e9\u30a4\u30d5\u30eb - \u30a2\u30fc\u30de\u30fc\u4ed8\u304d\u30be\u30f3\u30d3\u3001\u706b\u708e\u653e\u5c04\u5668 - \u7fa4\u308c\u30be\u30f3\u30d3\u3002]"}, {"question": "\u30be\u30f3\u30d3\u30fb\u30e9\u30c3\u30b7\u30e5\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u4f55\u3092\u512a\u5148\u3059\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u30be\u30f3\u30d3\u30fb\u30e9\u30c3\u30b7\u30e5\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u30b7\u30b9\u30c6\u30e0\u3067\u306f\u3001\u30b2\u30fc\u30e0\u5185\u901a\u8ca8\u3092\u4f7f\u7528\u3057\u3066\u6b66\u5668\u3084\u80fd\u529b\u3092\u5f37\u5316\u3067\u304d\u307e\u3059\u3002\u307e\u305a\u3001\u653b\u6483\u529b\u306e\u5411\u4e0a\u306e\u305f\u3081\u3001\u4e3b\u8981\u306a\u6b66\u5668\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u3001\u30a2\u30b5\u30eb\u30c8\u30e9\u30a4\u30d5\u30eb\u3092\u30ec\u30d9\u30eb\uff11\u304b\u3089\u30ec\u30d9\u30eb\uff12\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3068\u3001\u706b\u529b\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u3001\u3088\u308a\u591a\u304f\u306e\u30be\u30f3\u30d3\u306e\u7fa4\u308c\u3092\u7c21\u5358\u306b\u51e6\u7406\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u308b\u2192\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u30e1\u30cb\u30e5\u30fc\u306b\u30a2\u30af\u30bb\u30b9\u3059\u308b\u2192\u6b66\u5668\u3092\u9078\u629e\u3059\u308b\u2192\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u78ba\u8a8d\u3059\u308b\u3002]"}, {"question": "\u30be\u30f3\u30d3\u30fb\u30e9\u30c3\u30b7\u30e5\u3067\u30c7\u30a4\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u5b8c\u4e86\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u30be\u30f3\u30d3\u30fb\u30e9\u30c3\u30b7\u30e5\u3067\u30c7\u30a4\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u5b8c\u4e86\u3059\u308b\u3068\u3001\u30b3\u30a4\u30f3\u3084\u7d4c\u9a13\u5024\u306a\u3069\u306e\u8cb4\u91cd\u306a\u30ea\u30bd\u30fc\u30b9\u304c\u5831\u916c\u3068\u3057\u3066\u5f97\u3089\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u7279\u5b9a\u306e\u6b66\u5668\u306750\u4f53\u306e\u30be\u30f3\u30d3\u3092\u5012\u3059\u5fc5\u8981\u304c\u3042\u308b\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u5b8c\u4e86\u3059\u308b\u3068\u3001\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u4f7f\u7528\u3067\u304d\u308b500\u30b3\u30a4\u30f3\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u30c7\u30a4\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u306f\u3001\u9032\u884c\u3092\u8fc5\u901f\u306b\u5f37\u5316\u3059\u308b\u30df\u30cb\u30af\u30a8\u30b9\u30c8\u3060\u3068\u601d\u3063\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30be\u30f3\u30d3\u30fb\u30e9\u30c3\u30b7\u30e5\u306e\u3055\u307e\u3056\u307e\u306a\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30be\u30f3\u30d3\u30fb\u30e9\u30c3\u30b7\u30e5\u306b\u306f\u8907\u6570\u306e\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u304c\u3042\u308a\u3001\u305d\u308c\u305e\u308c\u306b\u72ec\u81ea\u306e\u76ee\u6a19\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30b5\u30d0\u30a4\u30d0\u30eb\u30e2\u30fc\u30c9\u300d\u306f\u3001\u6c38\u9060\u306b\u7d9a\u304f\u30be\u30f3\u30d3\u306e\u7fa4\u308c\u306b\u8010\u3048\u7d9a\u3051\u308b\u3053\u3068\u3092\u91cd\u8996\u3057\u3001\u300c\u30df\u30c3\u30b7\u30e7\u30f3\u30e2\u30fc\u30c9\u300d\u306f\u3001\u751f\u5b58\u8005\u3092\u6551\u51fa\u3059\u308b\u3088\u3046\u306a\u7279\u5b9a\u306e\u30bf\u30b9\u30af\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3092\u8981\u6c42\u3057\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u30b5\u30d0\u30a4\u30d0\u30eb\u30e2\u30fc\u30c9\u306f\u5fcd\u8010\u529b\u3092\u8a66\u3059\u4e00\u65b9\u3001\u30df\u30c3\u30b7\u30e7\u30f3\u30e2\u30fc\u30c9\u306f\u6226\u7565\u3068\u6b63\u78ba\u3055\u3092\u8a66\u3059\u3002]"}, {"question": "\u30be\u30f3\u30d3\u30fb\u30e9\u30c3\u30b7\u30e5\u306e\u9032\u884c\u72b6\u6cc1\u3092\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30be\u30f3\u30d3\u30fb\u30e9\u30c3\u30b7\u30e5\u306e\u9032\u884c\u72b6\u6cc1\u3092\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\uff08Google Play\u307e\u305f\u306fApple ID\u306a\u3069\uff09\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u9032\u884c\u72b6\u6cc1\u306f\u81ea\u52d5\u7684\u306b\u540c\u671f\u3055\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001Android\u304b\u3089iPhone\u306b\u5207\u308a\u66ff\u3048\u308b\u5834\u5408\u3001Apple ID\u306b\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3068\u3001\u30b2\u30fc\u30e0\u30c7\u30fc\u30bf\u304c\u5fa9\u5143\u3055\u308c\u307e\u3059\u3002[\u69cb\u6210\u8868\uff1aAndroid - Google Play\u3001iOS - Apple ID\u3002]"}, {"question": "\u30be\u30f3\u30d3\u30fb\u30e9\u30c3\u30b7\u30e5\u3067\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u898b\u3064\u3051\u308b\u65b9\u6cd5\u306f\uff1f", "answer": "\u30be\u30f3\u30d3\u30fb\u30e9\u30c3\u30b7\u30e5\u306b\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u3042\u308a\u307e\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u4f8b\u3068\u3057\u3066\u3001\u30e1\u30a4\u30f3\u30e1\u30cb\u30e5\u30fc\u306b\u7279\u5b9a\u306e\u30b3\u30fc\u30c9\u3092\u5165\u529b\u3059\u308b\u3053\u3068\u3067\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u300c\u79d8\u5bc6\u306e\u30d0\u30f3\u30ab\u30fc\u300d\u30ec\u30d9\u30eb\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30e6\u30cb\u30fc\u30af\u306a\u5831\u916c\u3068\u30c1\u30e3\u30ec\u30f3\u30b8\u304c\u63d0\u4f9b\u3055\u308c\u307e\u3059\u3002[\u30d2\u30f3\u30c8\uff1a\u30b2\u30fc\u30e0\u74b0\u5883\u306e\u5fae\u5999\u306a\u30d2\u30f3\u30c8\u306b\u6ce8\u610f\u3092\u6255\u3044\u3001\u96a0\u3055\u308c\u305f\u30a8\u30ea\u30a2\u306b\u3064\u306a\u304c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308b\u3053\u3068\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30be\u30f3\u30d3\u30fb\u30e9\u30c3\u30b7\u30e5\u3067\u30ea\u30bd\u30fc\u30b9\u3092\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30be\u30f3\u30d3\u30fb\u30e9\u30c3\u30b7\u30e5\u3067\u30ea\u30bd\u30fc\u30b9\u3092\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3059\u308b\u305f\u3081\u306b\u306f\u3001\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3068\u6d88\u8cbb\u54c1\u306e\u652f\u51fa\u306e\u30d0\u30e9\u30f3\u30b9\u3092\u53d6\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff11\uff1a \u7dca\u6025\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306e\u305f\u3081\u306b\u3001\u5e38\u306b\u30b3\u30a4\u30f3\u306e\u4e00\u90e8\u3092\u8caf\u91d1\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d7\uff12\uff1a \u4f53\u529b\u30d1\u30c3\u30af\u306a\u3069\u306e\u6d88\u8cbb\u54c1\u306f\u3001\u63a7\u3048\u3081\u306b\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d7\uff13\uff1a \u9577\u671f\u7684\u6295\u8cc7\u3067\u3042\u308b\u6b66\u5668\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u3001\u77ed\u671f\u7684\u306a\u5229\u76ca\u3088\u308a\u3082\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\u3092\u65e9\u671f\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3068\u3001\u983b\u7e41\u306a\u4fee\u7406\u306e\u5fc5\u8981\u6027\u3092\u6e1b\u3089\u3059\u3053\u3068\u3067\u3001\u9577\u671f\u7684\u306b\u306f\u30b3\u30a4\u30f3\u3092\u7bc0\u7d04\u3067\u304d\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u30ea\u30bd\u30fc\u30b9\u306f\u3001\u6ce8\u610f\u6df1\u3044\u5272\u308a\u5f53\u3066\u304c\u5fc5\u8981\u306a\u4e88\u7b97\u3060\u3068\u601d\u3063\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30be\u30f3\u30d3\u30fb\u30e9\u30c3\u30b7\u30e5\u3067\u6700\u9069\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5f97\u308b\u305f\u3081\u306e\u8a2d\u5b9a\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30be\u30f3\u30d3\u30fb\u30e9\u30c3\u30b7\u30e5\u3067\u6700\u9069\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5f97\u308b\u305f\u3081\u306b\u3001\u30c7\u30d0\u30a4\u30b9\u306e\u6a5f\u80fd\u306b\u57fa\u3065\u3044\u3066\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3092\u8abf\u6574\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u306e\u54c1\u8cea\u3092\u4e0b\u3052\u308b\u3068\u3001\u53e4\u3044\u30c7\u30d0\u30a4\u30b9\u306e\u30d5\u30ec\u30fc\u30e0\u30ec\u30fc\u30c8\u304c\u5411\u4e0a\u3059\u308b\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30df\u30c3\u30c9\u30ec\u30f3\u30b8\u30b9\u30de\u30fc\u30c8\u30d5\u30a9\u30f3\u3067\u300c\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u54c1\u8cea\u300d\u3092\u300c\u4e2d\u300d\u306b\u8a2d\u5b9a\u3059\u308b\u3068\u3001\u8996\u899a\u7684\u306a\u640d\u5931\u304c\u307b\u3068\u3093\u3069\u306a\u304f\u3001\u3088\u308a\u30b9\u30e0\u30fc\u30ba\u306a\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u63d0\u4f9b\u3067\u304d\u307e\u3059\u3002[\u69cb\u6210\u8868\uff1a\u30cf\u30a4\u30a8\u30f3\u30c9\u30c7\u30d0\u30a4\u30b9 - \u9ad8\u54c1\u8cea\u3001\u30df\u30c3\u30c9\u30ec\u30f3\u30b8\u30c7\u30d0\u30a4\u30b9 - \u4e2d\u54c1\u8cea\u3001\u30ed\u30fc\u30a8\u30f3\u30c9\u30c7\u30d0\u30a4\u30b9 - \u4f4e\u54c1\u8cea\u3002]"}]
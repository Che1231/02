[{"question": "\u5982\u4f55\u57f7\u884c\u6bad\u5c4d\u72c2\u6f6e\u7684\u57fa\u672c\u52d5\u4f5c\uff0c\u4f8b\u5982\u79fb\u52d5\u548c\u5c04\u64ca\uff1f", "answer": "\u5728\u6bad\u5c4d\u72c2\u6f6e\u4e2d\uff0c\u79fb\u52d5\u662f\u7531\u87a2\u5e55\u5de6\u5074\u7684\u64cd\u7e31\u687f\u63a7\u5236\u3002\u8981\u5c04\u64ca\uff0c\u8acb\u9ede\u64ca\u53f3\u5074\u7684\u5c04\u64ca\u6309\u9215\u3002\u4f8b\u5982\uff0c\u8981\u8b93\u4f60\u7684\u89d2\u8272\u5728\u5c04\u64ca\u6bad\u5c4d\u7684\u540c\u6642\u5411\u53f3\u79fb\u52d5\uff0c\u53ea\u9700\u5c07\u64cd\u7e31\u687f\u5411\u53f3\u62d6\u52d5\u4e26\u6301\u7e8c\u9ede\u64ca\u5c04\u64ca\u6309\u9215\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u64cd\u7e31\u687f\u60f3\u50cf\u6210\u65b9\u5411\u76e4\uff0c\u5c07\u5c04\u64ca\u6309\u9215\u60f3\u50cf\u6210\u6273\u6a5f\u3002]"}, {"question": "\u5728\u6bad\u5c4d\u72c2\u6f6e\u4e2d\u751f\u5b58\u66f4\u9577\u6642\u9593\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u6bad\u5c4d\u72c2\u6f6e\u4e2d\u751f\u5b58\u66f4\u9577\u6642\u9593\u9700\u8981\u7b56\u7565\u6027\u7684\u79fb\u52d5\u548c\u8cc7\u6e90\u7ba1\u7406\u7684\u7d50\u5408\u3002\u6b65\u9a5f\u4e00\uff1a\u59cb\u7d42\u4fdd\u6301\u79fb\u52d5\uff0c\u4ee5\u907f\u514d\u6bad\u5c4d\u7fa4\u3002\u6b65\u9a5f\u4e8c\uff1a\u512a\u5148\u5347\u7d1a\u4f60\u7684\u6b66\u5668\uff0c\u4ee5\u7372\u5f97\u66f4\u5f37\u5927\u7684\u706b\u529b\u3002\u6b65\u9a5f\u4e09\uff1a\u5229\u7528\u74b0\u5883\u969c\u7919\u7269\u5c07\u6bad\u5c4d\u5f15\u5c0e\u5230\u6bba\u622e\u5340\u57df\u3002\u4f8b\u5982\uff0c\u7ad9\u5728\u7246\u908a\u53ef\u4ee5\u9650\u5236\u6bad\u5c4d\u7684\u8972\u64ca\u65b9\u5411\u3002[\u591a\u65b9\u6848\u6bd4\u8f03: \u8207\u7ad9\u5728\u7a7a\u66e0\u8655\u76f8\u6bd4\uff0c\u4f7f\u7528\u7246\u58c1\u53ef\u4ee5\u4e00\u6b21\u6e1b\u5c11\u9700\u8981\u61c9\u5c0d\u7684\u6bad\u5c4d\u6578\u91cf\u3002]"}, {"question": "\u5728\u6bad\u5c4d\u72c2\u6f6e\u4e2d\uff0c\u54ea\u4e9b\u6b66\u5668\u5c0d\u4e0d\u540c\u985e\u578b\u7684\u6bad\u5c4d\u6700\u6709\u6548\uff1f", "answer": "\u5728\u6bad\u5c4d\u72c2\u6f6e\u4e2d\uff0c\u4e0d\u540c\u7684\u6b66\u5668\u5c0d\u4e0d\u540c\u985e\u578b\u7684\u6bad\u5c4d\u8868\u73fe\u51fa\u8272\u3002\u4f8b\u5982\uff0c\u6563\u5f48\u69cd\u7531\u65bc\u5176\u6563\u4f48\u50b7\u5bb3\uff0c\u975e\u5e38\u6709\u6548\u5730\u5c0d\u4ed8\u4e00\u7fa4\u666e\u901a\u6bad\u5c4d\uff0c\u800c\u72d9\u64ca\u6b65\u69cd\u5247\u66f4\u9069\u5408\u5f9e\u9060\u8655\u64ca\u6bba\u88dd\u7532\u6bad\u5c4d\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u6563\u5f48\u69cd - \u666e\u901a\u6bad\u5c4d\uff1b\u72d9\u64ca\u6b65\u69cd - \u88dd\u7532\u6bad\u5c4d\uff1b\u706b\u7130\u5674\u5c04\u5668 - \u7fa4\u9ad4\u6bad\u5c4d\u3002]"}, {"question": "\u6bad\u5c4d\u72c2\u6f6e\u4e2d\u7684\u5347\u7d1a\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff0c\u4ee5\u53ca\u6211\u61c9\u8a72\u512a\u5148\u8003\u616e\u4ec0\u9ebc\uff1f", "answer": "\u6bad\u5c4d\u72c2\u6f6e\u4e2d\u7684\u5347\u7d1a\u7cfb\u7d71\u5141\u8a31\u4f60\u4f7f\u7528\u904a\u6232\u5167\u8ca8\u5e63\u4f86\u589e\u5f37\u4f60\u7684\u6b66\u5668\u548c\u80fd\u529b\u3002\u9996\u5148\u512a\u5148\u5347\u7d1a\u4f60\u7684\u4e3b\u8981\u6b66\u5668\u4ee5\u63d0\u9ad8\u50b7\u5bb3\u3002\u4f8b\u5982\uff0c\u5c07\u7a81\u64ca\u6b65\u69cd\u5f9e 1 \u7d1a\u5347\u7d1a\u5230 2 \u7d1a\u6703\u986f\u8457\u63d0\u5347\u5176\u706b\u529b\uff0c\u8b93\u4f60\u66f4\u5bb9\u6613\u61c9\u5c0d\u66f4\u5927\u7684\u6bad\u5c4d\u6ce2\u3002[\u6d41\u7a0b\u5716\u89e3: \u6536\u96c6\u91d1\u5e63 -> \u8a2a\u554f\u5347\u7d1a\u9078\u55ae -> \u9078\u64c7\u6b66\u5668 -> \u78ba\u8a8d\u5347\u7d1a\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u61c9\u8a72\u5c08\u6ce8\u65bc\u5728\u6bad\u5c4d\u72c2\u6f6e\u4e2d\u5b8c\u6210\u6bcf\u65e5\u6311\u6230\uff1f", "answer": "\u5728\u6bad\u5c4d\u72c2\u6f6e\u4e2d\u5b8c\u6210\u6bcf\u65e5\u6311\u6230\u6703\u734e\u52f5\u4f60\u5bf6\u8cb4\u7684\u8cc7\u6e90\uff0c\u4f8b\u5982\u91d1\u5e63\u548c\u7d93\u9a57\u503c\u3002\u4f8b\u5982\uff0c\u5b8c\u6210\u9700\u8981\u7528\u7279\u5b9a\u6b66\u5668\u6bba\u6b7b 50 \u500b\u6bad\u5c4d\u7684\u6311\u6230\u53ef\u4ee5\u7372\u5f97 500 \u679a\u91d1\u5e63\uff0c\u53ef\u4ee5\u7528\u65bc\u5347\u7d1a\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u6bcf\u65e5\u6311\u6230\u60f3\u50cf\u6210\u63d0\u4f9b\u5feb\u901f\u9032\u5c55\u7684\u8ff7\u4f60\u4efb\u52d9\u3002]"}, {"question": "\u6bad\u5c4d\u72c2\u6f6e\u4e2d\u5404\u7a2e\u904a\u6232\u6a21\u5f0f\u4e4b\u9593\u7684\u4e3b\u8981\u5340\u5225\u662f\u4ec0\u9ebc\uff1f", "answer": "\u6bad\u5c4d\u72c2\u6f6e\u63d0\u4f9b\u591a\u7a2e\u904a\u6232\u6a21\u5f0f\uff0c\u6bcf\u500b\u6a21\u5f0f\u90fd\u6709\u7368\u7279\u7684\u76ee\u6a19\u3002\u4f8b\u5982\uff0c\u300c\u751f\u5b58\u6a21\u5f0f\u300d\u5c08\u6ce8\u65bc\u5728\u9762\u5c0d\u7121\u76e1\u7684\u6bad\u5c4d\u6ce2\u6642\u5805\u6301\u76e1\u53ef\u80fd\u9577\u7684\u6642\u9593\uff0c\u800c\u300c\u4efb\u52d9\u6a21\u5f0f\u300d\u5247\u8981\u6c42\u5b8c\u6210\u7279\u5b9a\u4efb\u52d9\uff0c\u4f8b\u5982\u71df\u6551\u5016\u5b58\u8005\u3002[\u591a\u65b9\u6848\u6bd4\u8f03: \u751f\u5b58\u6a21\u5f0f\u6e2c\u8a66\u8010\u529b\uff0c\u4efb\u52d9\u6a21\u5f0f\u6e2c\u8a66\u7b56\u7565\u548c\u7cbe\u6e96\u5ea6\u3002]"}, {"question": "\u5982\u4f55\u5c07\u6211\u5728\u6bad\u5c4d\u72c2\u6f6e\u4e2d\u7684\u9032\u5ea6\u8f49\u79fb\u5230\u65b0\u8a2d\u5099\uff1f", "answer": "\u8981\u5c07\u4f60\u5728\u6bad\u5c4d\u72c2\u6f6e\u4e2d\u7684\u9032\u5ea6\u8f49\u79fb\u5230\u65b0\u8a2d\u5099\uff0c\u8acb\u78ba\u4fdd\u4f60\u5728\u5169\u90e8\u8a2d\u5099\u4e0a\u90fd\u767b\u9304\u540c\u4e00\u500b\u5e33\u6236\uff08\u4f8b\u5982\uff0cGoogle Play \u6216 Apple ID\uff09\u3002\u4f60\u7684\u9032\u5ea6\u5c07\u81ea\u52d5\u540c\u6b65\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5f9e Android \u5207\u63db\u5230 iPhone\uff0c\u767b\u9304\u4f60\u7684 Apple ID \u5c07\u6062\u5fa9\u4f60\u7684\u904a\u6232\u6578\u64da\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: Android - Google Play\uff1biOS - Apple ID\u3002]"}, {"question": "\u6211\u5728\u6bad\u5c4d\u72c2\u6f6e\u4e2d\u53ef\u4ee5\u627e\u5230\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "\u6bad\u5c4d\u72c2\u6f6e\u5305\u542b\u4e00\u4e9b\u96b1\u85cf\u529f\u80fd\u548c\u5f69\u86cb\u3002\u4e00\u500b\u986f\u8457\u7684\u4f8b\u5b50\u662f\u300c\u79d8\u5bc6\u7889\u5821\u300d\u95dc\u5361\uff0c\u73a9\u5bb6\u53ef\u4ee5\u5728\u4e3b\u9078\u55ae\u8f38\u5165\u7279\u5b9a\u4ee3\u78bc\u4f86\u9032\u5165\u3002\u6b64\u95dc\u5361\u63d0\u4f9b\u7368\u7279\u7684\u734e\u52f5\u548c\u6311\u6230\u3002[\u5f69\u86cb\u6316\u6398: \u5bc6\u5207\u95dc\u6ce8\u904a\u6232\u74b0\u5883\u4e2d\u7684\u7d30\u5fae\u6697\u793a\uff0c\u9019\u53ef\u80fd\u6703\u5f15\u5c0e\u4f60\u627e\u5230\u96b1\u85cf\u5340\u57df\u3002]"}, {"question": "\u5982\u4f55\u5728\u6bad\u5c4d\u72c2\u6f6e\u4e2d\u6709\u6548\u5730\u7ba1\u7406\u8cc7\u6e90\uff1f", "answer": "\u5728\u6bad\u5c4d\u72c2\u6f6e\u4e2d\u6709\u6548\u5730\u7ba1\u7406\u8cc7\u6e90\u6d89\u53ca\u5728\u5347\u7d1a\u548c\u6d88\u8017\u54c1\u4e0a\u5e73\u8861\u4f60\u7684\u652f\u51fa\u3002\u6b65\u9a5f\u4e00\uff1a\u59cb\u7d42\u4fdd\u7559\u4e00\u90e8\u5206\u91d1\u5e63\u7528\u65bc\u7dca\u6025\u5347\u7d1a\u3002\u6b65\u9a5f\u4e8c\uff1a\u7bc0\u7d04\u4f7f\u7528\u6d88\u8017\u54c1\uff0c\u4f8b\u5982\u85e5\u5291\u3002\u6b65\u9a5f\u4e09\uff1a\u512a\u5148\u8003\u616e\u9577\u671f\u7684\u6295\u8cc7\uff0c\u4f8b\u5982\u6b66\u5668\u5347\u7d1a\uff0c\u800c\u4e0d\u662f\u77ed\u671f\u7684\u6536\u76ca\u3002\u4f8b\u5982\uff0c\u65e9\u671f\u5347\u7d1a\u4f60\u7684\u6563\u5f48\u69cd\u53ef\u4ee5\u5f9e\u9577\u9060\u7684\u89d2\u5ea6\u7701\u4e0b\u91d1\u5e63\uff0c\u56e0\u70ba\u5b83\u53ef\u4ee5\u6e1b\u5c11\u983b\u7e41\u7dad\u4fee\u7684\u9700\u6c42\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u4f60\u7684\u8cc7\u6e90\u60f3\u50cf\u6210\u9700\u8981\u4ed4\u7d30\u5206\u914d\u7684\u9810\u7b97\u3002]"}, {"question": "\u5728\u6bad\u5c4d\u72c2\u6f6e\u4e2d\uff0c\u6700\u4f73\u7684\u8a2d\u7f6e\u662f\u4ec0\u9ebc\uff0c\u624d\u80fd\u7372\u5f97\u6700\u4f73\u6027\u80fd\uff1f", "answer": "\u5728\u6bad\u5c4d\u72c2\u6f6e\u4e2d\u7372\u5f97\u6700\u4f73\u6027\u80fd\uff0c\u8acb\u6839\u64da\u4f60\u7684\u8a2d\u5099\u80fd\u529b\u8abf\u6574\u5716\u5f62\u8a2d\u7f6e\u3002\u964d\u4f4e\u5716\u5f62\u8cea\u91cf\u53ef\u4ee5\u63d0\u9ad8\u820a\u8a2d\u5099\u7684\u5e40\u7387\u3002\u4f8b\u5982\uff0c\u5728\u4e2d\u6a94\u667a\u6167\u578b\u624b\u6a5f\u4e0a\u5c07\u300c\u5716\u5f62\u8cea\u91cf\u300d\u8a2d\u7f6e\u70ba\u300c\u4e2d\u300d\uff0c\u53ef\u4ee5\u5728\u4e0d\u56b4\u91cd\u640d\u5931\u8996\u89ba\u6548\u679c\u7684\u60c5\u6cc1\u4e0b\u63d0\u4f9b\u66f4\u9806\u66a2\u7684\u904a\u6232\u9ad4\u9a57\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u9ad8\u7aef\u8a2d\u5099 - \u9ad8\u8cea\u91cf\uff1b\u4e2d\u6a94\u8a2d\u5099 - \u4e2d\u8cea\u91cf\uff1b\u4f4e\u7aef\u8a2d\u5099 - \u4f4e\u8cea\u91cf\u3002]"}]
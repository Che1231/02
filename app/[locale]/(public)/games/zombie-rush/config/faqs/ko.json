[{"question": "\uc880\ube44 \ub7ec\uc26c\uc5d0\uc11c \uc774\ub3d9 \ubc0f \uc0ac\uaca9\uacfc \uac19\uc740 \uae30\ubcf8 \ub3d9\uc791\uc740 \uc5b4\ub5bb\uac8c \uc218\ud589\ud569\ub2c8\uae4c?", "answer": "\uc880\ube44 \ub7ec\uc26c\uc5d0\uc11c \uc774\ub3d9\uc740 \ud654\uba74 \uc67c\ucabd\uc758 \uc870\uc774\uc2a4\ud2f1\uc73c\ub85c \uc81c\uc5b4\ub429\ub2c8\ub2e4. \uc0ac\uaca9\ud558\ub824\uba74 \uc624\ub978\ucabd\uc758 \ubc1c\uc0ac \ubc84\ud2bc\uc744 \ud0ed\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc880\ube44\ub97c \uc0ac\uaca9\ud558\uba74\uc11c \uce90\ub9ad\ud130\ub97c \uc624\ub978\ucabd\uc73c\ub85c \uc774\ub3d9\ud558\ub824\uba74 \uc870\uc774\uc2a4\ud2f1\uc744 \uc624\ub978\ucabd\uc73c\ub85c \ub4dc\ub798\uadf8\ud558\uace0 \ubc1c\uc0ac \ubc84\ud2bc\uc744 \uacc4\uc18d \ud0ed\ud558\uba74 \ub429\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc870\uc774\uc2a4\ud2f1\uc744 \uc2a4\ud2f0\uc5b4\ub9c1 \ud720, \ubc1c\uc0ac \ubc84\ud2bc\uc744 \ud2b8\ub9ac\uac70\ub85c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694.]"}, {"question": "\uc880\ube44 \ub7ec\uc26c\uc5d0\uc11c \ub354 \uc624\ub798 \uc0dd\uc874\ud558\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc880\ube44 \ub7ec\uc26c\uc5d0\uc11c \ub354 \uc624\ub798 \uc0dd\uc874\ud558\ub824\uba74 \uc804\ub7b5\uc801\uc778 \uc774\ub3d9\uacfc \uc790\uc6d0 \uad00\ub9ac\uc758 \uc870\ud569\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc880\ube44 \ubb34\ub9ac\ub97c \ud53c\ud558\uae30 \uc704\ud574 \ud56d\uc0c1 \uc774\ub3d9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ub354 \ub098\uc740 \ud654\ub825\uc744 \uc704\ud574 \ubb34\uae30\ub97c \uc6b0\uc120 \uc5c5\uadf8\ub808\uc774\ub4dc\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ud658\uacbd \uc7a5\uc560\ubb3c\uc744 \ud65c\uc6a9\ud558\uc5ec \uc880\ube44\ub4e4\uc744 \uc0ac\uc0b4 \uad6c\uc5ed\uc73c\ub85c \uc720\ub3c4\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubcbd \uadfc\ucc98\uc5d0 \uc11c\uba74 \uc880\ube44\uac00 \uc811\uadfc\ud560 \uc218 \uc788\ub294 \ubc29\ud5a5\uc744 \uc81c\ud55c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\uc548 \ube44\uad50: \ube48 \uacf5\uac04\uc5d0 \uc11c \uc788\ub294 \uac83\uacfc \ub2ec\ub9ac, \ubcbd\uc744 \uc0ac\uc6a9\ud558\uba74 \ud55c \ubc88\uc5d0 \ucc98\ub9ac\ud574\uc57c \ud560 \uc880\ube44 \uc218\uac00 \uc904\uc5b4\ub4ed\ub2c8\ub2e4.]"}, {"question": "\uc880\ube44 \ub7ec\uc26c\uc5d0\uc11c \ub2e4\uc591\ud55c \uc880\ube44 \uc720\ud615\uc5d0 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ubb34\uae30\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc880\ube44 \ub7ec\uc26c\uc5d0\uc11c \ub2e4\uc591\ud55c \ubb34\uae30\ub294 \uac01\uae30 \ub2e4\ub978 \uc880\ube44 \uc720\ud615\uc5d0 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc0b0\ud0c4\ucd1d\uc740 \ub113\uc740 \ud53c\ud574 \ubc94\uc704\ub85c \uc778\ud574 \uc77c\ubc18 \uc880\ube44 \ubb34\ub9ac\uc5d0\uac8c \ub9e4\uc6b0 \ud6a8\uacfc\uc801\uc774\uba70, \uc800\uaca9\ucd1d\uc740 \uc7a5\uac70\ub9ac\uc5d0\uc11c \uc7a5\uac11 \uc880\ube44\ub97c \uc81c\uac70\ud558\ub294 \ub370 \ub354 \uc801\ud569\ud569\ub2c8\ub2e4. [\uc7a5\ube44 \ube44\uad50\ud45c: \uc0b0\ud0c4\ucd1d - \uc77c\ubc18 \uc880\ube44; \uc800\uaca9\ucd1d - \uc7a5\uac11 \uc880\ube44; \ud50c\ub808\uc784 \ub358\uc838 - \ubb34\ub9ac \uc880\ube44.]"}, {"question": "\uc880\ube44 \ub7ec\uc26c\uc5d0\uc11c \uc5c5\uadf8\ub808\uc774\ub4dc \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \ubb34\uc5c7\uc744 \uc6b0\uc120\uc2dc\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\uc880\ube44 \ub7ec\uc26c\uc758 \uc5c5\uadf8\ub808\uc774\ub4dc \uc2dc\uc2a4\ud15c\uc744 \ud1b5\ud574 \uac8c\uc784 \ub0b4 \ud1b5\ud654\ub97c \uc0ac\uc6a9\ud558\uc5ec \ubb34\uae30\uc640 \ub2a5\ub825\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uba3c\uc800 \uc8fc \ubb34\uae30\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc5ec \ub370\ubbf8\uc9c0\ub97c \ub192\uc774\ub294 \uac83\uc744 \uc6b0\uc120\uc2dc\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub3cc\uaca9 \uc18c\ucd1d\uc744 1\ub4f1\uae09\uc5d0\uc11c 2\ub4f1\uae09\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uba74 \ud654\ub825\uc774 \ud06c\uac8c \ud5a5\uc0c1\ub418\uc5b4 \ub354 \ub9ce\uc740 \uc880\ube44 \ubb34\ub9ac\ub97c \ub354\uc6b1 \uc27d\uac8c \ucc98\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uacfc\uc815 \uc124\uba85: \ucf54\uc778 \uc218\uc9d1 -> \uc5c5\uadf8\ub808\uc774\ub4dc \uba54\ub274 \uc811\uadfc -> \ubb34\uae30 \uc120\ud0dd -> \uc5c5\uadf8\ub808\uc774\ub4dc \ud655\uc778.]"}, {"question": "\uc880\ube44 \ub7ec\uc26c\uc5d0\uc11c \uc77c\uc77c \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\ub294 \ub370 \uc9d1\uc911\ud574\uc57c \ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc880\ube44 \ub7ec\uc26c\uc5d0\uc11c \uc77c\uc77c \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\uba74 \ucf54\uc778\uacfc \uacbd\ud5d8\uce58\uc640 \uac19\uc740 \uac12\uc9c4 \uc790\uc6d0\uc774 \ubcf4\uc0c1\uc73c\ub85c \uc8fc\uc5b4\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud2b9\uc815 \ubb34\uae30\ub85c 50\ub9c8\ub9ac\uc758 \uc880\ube44\ub97c \ucc98\uce58\ud574\uc57c \ud558\ub294 \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\uba74 500\uac1c\uc758 \ucf54\uc778\uc744 \uc5bb\uc744 \uc218 \uc788\uc73c\uba70, \uc774 \ucf54\uc778\uc740 \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc77c\uc77c \ucc4c\ub9b0\uc9c0\ub97c \uc9c4\ud589\ud558\uba74 \uac8c\uc784 \uc9c4\ud589 \uc18d\ub3c4\ub97c \ube60\ub974\uac8c \ub192\uc77c \uc218 \uc788\ub294 \uc791\uc740 \ud018\uc2a4\ud2b8\ub4e4\ub85c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694.]"}, {"question": "\uc880\ube44 \ub7ec\uc26c\uc758 \ub2e4\uc591\ud55c \uac8c\uc784 \ubaa8\ub4dc \uac04\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc880\ube44 \ub7ec\uc26c\ub294 \uac01\uac01 \uace0\uc720\ud55c \ubaa9\ud45c\ub97c \uac00\uc9c4 \uc5ec\ub7ec \uac8c\uc784 \ubaa8\ub4dc\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc0dd\uc874 \ubaa8\ub4dc'\ub294 \ubb34\ud55c\ud55c \uc880\ube44 \ubb34\ub9ac\uc5d0\uac8c \ucd5c\ub300\ud55c \uc624\ub7ab\ub3d9\uc548 \ubc84\ud2f0\ub294 \ub370 \uc911\uc810\uc744 \ub461\ub2c8\ub2e4. \ubc18\uba74 '\uc784\ubb34 \ubaa8\ub4dc'\ub294 \uc0dd\uc874\uc790 \uad6c\ucd9c\uacfc \uac19\uc740 \ud2b9\uc815 \uc784\ubb34\ub97c \uc644\ub8cc\ud558\ub294 \uac83\uc744 \uc694\uad6c\ud569\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\uc548 \ube44\uad50: \uc0dd\uc874 \ubaa8\ub4dc\ub294 \uc9c0\uad6c\ub825\uc744 \uc2dc\ud5d8\ud558\uace0, \uc784\ubb34 \ubaa8\ub4dc\ub294 \uc804\ub7b5\uacfc \uc815\ud655\uc131\uc744 \uc2dc\ud5d8\ud569\ub2c8\ub2e4.]"}, {"question": "\uc880\ube44 \ub7ec\uc26c\uc5d0\uc11c \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc0c8 \uae30\uae30\uc5d0 \uc804\uc1a1\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc880\ube44 \ub7ec\uc26c\uc5d0\uc11c \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc0c8 \uae30\uae30\uc5d0 \uc804\uc1a1\ud558\ub824\uba74 \ub450 \uae30\uae30 \ubaa8\ub450 \uac19\uc740 \uacc4\uc815(\uc608: Google Play \ub610\ub294 Apple ID)\uc5d0 \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc740 \uc790\ub3d9\uc73c\ub85c \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc548\ub4dc\ub85c\uc774\ub4dc\uc5d0\uc11c \uc544\uc774\ud3f0\uc73c\ub85c \uc804\ud658\ud560 \uacbd\uc6b0 Apple ID\uc5d0 \ub85c\uadf8\uc778\ud558\uba74 \uac8c\uc784 \ub370\uc774\ud130\uac00 \ubcf5\uc6d0\ub429\ub2c8\ub2e4. [\uc7a5\ube44 \ube44\uad50\ud45c: \uc548\ub4dc\ub85c\uc774\ub4dc - Google Play; iOS - Apple ID.]"}, {"question": "\uc880\ube44 \ub7ec\uc26c\uc5d0\uc11c \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5 \ub610\ub294 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc880\ube44 \ub7ec\uc26c\uc5d0\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uae30\ub2a5\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc8fc\ubaa9\ud560 \ub9cc\ud55c \uc608\ub294 \uba54\uc778 \uba54\ub274\uc5d0\uc11c \ud2b9\uc815 \ucf54\ub4dc\ub97c \uc785\ub825\ud558\uba74 \uc811\uadfc\ud560 \uc218 \uc788\ub294 '\ube44\ubc00 \ubc99\ucee4' \ub808\ubca8\uc785\ub2c8\ub2e4. \uc774 \ub808\ubca8\uc5d0\uc11c\ub294 \ub3c5\ud2b9\ud55c \ubcf4\uc0c1\uacfc \ucc4c\ub9b0\uc9c0\uac00 \uc81c\uacf5\ub429\ub2c8\ub2e4. [\uc228\uaca8\uc9c4 \uae30\ub2a5 \ubc1c\uacac: \uac8c\uc784 \ud658\uacbd\uc758 \ubbf8\ubb18\ud55c \ub2e8\uc11c\ub97c \uc8fc\uc758 \uae4a\uac8c \uc0b4\ud3b4\ubcf4\uc138\uc694, \uadf8\ub7ec\uba74 \uc228\uaca8\uc9c4 \uc601\uc5ed\uc73c\ub85c \uc774\uc5b4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "\uc880\ube44 \ub7ec\uc26c\uc5d0\uc11c \uc790\uc6d0\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc880\ube44 \ub7ec\uc26c\uc5d0\uc11c \uc790\uc6d0\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub824\uba74 \uc5c5\uadf8\ub808\uc774\ub4dc \ubc0f \uc18c\ubaa8\ud488\uc5d0 \ub300\ud55c \uc9c0\ucd9c\uc744 \uade0\ud615 \uc788\uac8c \ub9de\ucdb0\uc57c \ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \ud56d\uc0c1 \ube44\uc0c1 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc704\ud574 \ucf54\uc778 \uc77c\ubd80\ub97c \uc800\ucd95\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uccb4\ub825 \ud3ec\uc158\uacfc \uac19\uc740 \uc18c\ubaa8\ud488\uc740 \uc808\uc57d\ud558\uc5ec \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc7a5\uae30\uc801\uc778 \ud22c\uc790(\ubb34\uae30 \uc5c5\uadf8\ub808\uc774\ub4dc)\ub97c \ub2e8\uae30\uc801\uc778 \uc774\uc775\ubcf4\ub2e4 \uc6b0\uc120\uc2dc\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucd08\uae30\uc5d0 \uc0b0\ud0c4\ucd1d\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uba74 \ube48\ubc88\ud55c \uc218\ub9ac \ud544\uc694\uc131\uc744 \uc904\uc5ec \uc7a5\uae30\uc801\uc73c\ub85c \ucf54\uc778\uc744 \uc808\uc57d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc790\uc6d0\uc744 \uc608\uc0b0\uc73c\ub85c \uc0dd\uac01\ud558\uace0 \uc2e0\uc911\ud558\uac8c \ubc30\ubd84\ud574\uc57c \ud569\ub2c8\ub2e4.]"}, {"question": "\uc880\ube44 \ub7ec\uc26c\uc5d0\uc11c \ucd5c\uc801\uc758 \uc131\ub2a5\uc744 \uc704\ud55c \ucd5c\uace0\uc758 \uc124\uc815\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc880\ube44 \ub7ec\uc26c\uc5d0\uc11c \ucd5c\uc801\uc758 \uc131\ub2a5\uc744 \uc704\ud574 \uae30\uae30\uc758 \uc131\ub2a5\uc5d0 \ub530\ub77c \uadf8\ub798\ud53d \uc124\uc815\uc744 \uc870\uc815\ud558\uc138\uc694. \uadf8\ub798\ud53d \ud488\uc9c8\uc744 \ub0ae\ucd94\uba74 \uc624\ub798\ub41c \uae30\uae30\uc758 \ud504\ub808\uc784 \uc18d\ub3c4\ub97c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc911\uae09 \uc2a4\ub9c8\ud2b8\ud3f0\uc5d0\uc11c '\uadf8\ub798\ud53d \ud488\uc9c8'\uc744 '\uc911'\uc73c\ub85c \uc124\uc815\ud558\uba74 \ub208\uc5d0 \ub744\ub294 \uc2dc\uac01\uc801 \uc190\uc2e4 \uc5c6\uc774 \ub354 \ubd80\ub4dc\ub7ec\uc6b4 \uac8c\uc784 \ud658\uacbd\uc744 \uc81c\uacf5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc7a5\ube44 \ube44\uad50\ud45c: \uace0\uc131\ub2a5 \uae30\uae30 - \uace0\ud488\uc9c8; \uc911\uae09 \uae30\uae30 - \uc911\uae09 \ud488\uc9c8; \uc800\uc131\ub2a5 \uae30\uae30 - \uc800\ud488\uc9c8.]"}]
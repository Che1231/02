[{"question": "\u5982\u4f55\u5728\u50f5\u5c38\u7a81\u88ad\u4e2d\u6267\u884c\u57fa\u672c\u64cd\u4f5c\uff0c\u4f8b\u5982\u79fb\u52a8\u548c\u5c04\u51fb\uff1f", "answer": "\u5728\u50f5\u5c38\u7a81\u88ad\u4e2d\uff0c\u79fb\u52a8\u7531\u5c4f\u5e55\u5de6\u4fa7\u7684\u64cd\u7eb5\u6746\u63a7\u5236\u3002\u8981\u5c04\u51fb\uff0c\u8bf7\u70b9\u51fb\u53f3\u4fa7\u7684\u5c04\u51fb\u6309\u94ae\u3002\u4f8b\u5982\uff0c\u8981\u8ba9\u60a8\u7684\u89d2\u8272\u5728\u5411\u53f3\u79fb\u52a8\u7684\u540c\u65f6\u5c04\u51fb\u50f5\u5c38\uff0c\u53ea\u9700\u5c06\u64cd\u7eb5\u6746\u62d6\u52a8\u5230\u53f3\u4fa7\uff0c\u5e76\u7ee7\u7eed\u70b9\u51fb\u5c04\u51fb\u6309\u94ae\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u64cd\u7eb5\u6746\u60f3\u8c61\u6210\u65b9\u5411\u76d8\uff0c\u5c06\u5c04\u51fb\u6309\u94ae\u60f3\u8c61\u6210\u6273\u673a\u3002]"}, {"question": "\u5728\u50f5\u5c38\u7a81\u88ad\u4e2d\u751f\u5b58\u66f4\u957f\u65f6\u95f4\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u50f5\u5c38\u7a81\u88ad\u4e2d\u751f\u5b58\u66f4\u957f\u65f6\u95f4\u9700\u8981\u6218\u7565\u79fb\u52a8\u548c\u8d44\u6e90\u7ba1\u7406\u7684\u7ed3\u5408\u3002\u6b65\u9aa41\uff1a\u59cb\u7ec8\u4fdd\u6301\u79fb\u52a8\uff0c\u4ee5\u907f\u514d\u50f5\u5c38\u7fa4\u3002\u6b65\u9aa42\uff1a\u4f18\u5148\u5347\u7ea7\u60a8\u7684\u6b66\u5668\uff0c\u4ee5\u83b7\u5f97\u66f4\u597d\u7684\u706b\u529b\u3002\u6b65\u9aa43\uff1a\u5229\u7528\u73af\u5883\u969c\u788d\u5c06\u50f5\u5c38\u5f15\u5bfc\u5230\u6740\u622e\u533a\u57df\u3002\u4f8b\u5982\uff0c\u7ad9\u5728\u5899\u8fb9\u53ef\u4ee5\u9650\u5236\u50f5\u5c38\u63a5\u8fd1\u7684\u65b9\u5411\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u4e0e\u7ad9\u5728\u7a7a\u65f7\u7684\u5730\u65b9\u76f8\u6bd4\uff0c\u4f7f\u7528\u5899\u58c1\u53ef\u4ee5\u51cf\u5c11\u60a8\u4e00\u6b21\u9700\u8981\u5904\u7406\u7684\u50f5\u5c38\u6570\u91cf\u3002]"}, {"question": "\u5728\u50f5\u5c38\u7a81\u88ad\u4e2d\uff0c\u54ea\u4e9b\u6b66\u5668\u6700\u6709\u6548\u5730\u5bf9\u6297\u4e0d\u540c\u7c7b\u578b\u7684\u50f5\u5c38\uff1f", "answer": "\u5728\u50f5\u5c38\u7a81\u88ad\u4e2d\uff0c\u4e0d\u540c\u7684\u6b66\u5668\u64c5\u957f\u5bf9\u6297\u4e0d\u540c\u7684\u50f5\u5c38\u7c7b\u578b\u3002\u4f8b\u5982\uff0c\u6563\u5f39\u67aa\u7531\u4e8e\u5176\u6269\u6563\u4f24\u5bb3\uff0c\u975e\u5e38\u6709\u6548\u5730\u5bf9\u6297\u666e\u901a\u50f5\u5c38\u7fa4\u4f53\uff0c\u800c\u72d9\u51fb\u6b65\u67aa\u5219\u66f4\u9002\u5408\u4ece\u8fdc\u5904\u6d88\u706d\u88c5\u7532\u50f5\u5c38\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u6563\u5f39\u67aa - \u666e\u901a\u50f5\u5c38\uff1b\u72d9\u51fb\u6b65\u67aa - \u88c5\u7532\u50f5\u5c38\uff1b\u706b\u7130\u55b7\u5c04\u5668 - \u50f5\u5c38\u7fa4\u3002]"}, {"question": "\u50f5\u5c38\u7a81\u88ad\u4e2d\u7684\u5347\u7ea7\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u6211\u5e94\u8be5\u4f18\u5148\u8003\u8651\u4ec0\u4e48\uff1f", "answer": "\u50f5\u5c38\u7a81\u88ad\u4e2d\u7684\u5347\u7ea7\u7cfb\u7edf\u5141\u8bb8\u60a8\u4f7f\u7528\u6e38\u620f\u5185\u8d27\u5e01\u6765\u589e\u5f3a\u6b66\u5668\u548c\u80fd\u529b\u3002\u9996\u5148\u4f18\u5148\u5347\u7ea7\u60a8\u7684\u4e3b\u8981\u6b66\u5668\uff0c\u4ee5\u589e\u52a0\u4f24\u5bb3\u3002\u4f8b\u5982\uff0c\u5c06\u7a81\u51fb\u6b65\u67aa\u4ece1\u7ea7\u5347\u7ea7\u52302\u7ea7\u4f1a\u663e\u8457\u63d0\u9ad8\u5176\u706b\u529b\uff0c\u4f7f\u5904\u7406\u66f4\u5927\u7684\u50f5\u5c38\u6d6a\u6f6e\u66f4\u5bb9\u6613\u3002[\u6d41\u7a0b\u56fe\u89e3: \u6536\u96c6\u91d1\u5e01 -> \u8bbf\u95ee\u5347\u7ea7\u83dc\u5355 -> \u9009\u62e9\u6b66\u5668 -> \u786e\u8ba4\u5347\u7ea7\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u5e94\u8be5\u4e13\u6ce8\u4e8e\u5728\u50f5\u5c38\u7a81\u88ad\u4e2d\u5b8c\u6210\u6bcf\u65e5\u6311\u6218\uff1f", "answer": "\u5728\u50f5\u5c38\u7a81\u88ad\u4e2d\u5b8c\u6210\u6bcf\u65e5\u6311\u6218\u4f1a\u5956\u52b1\u60a8\u5b9d\u8d35\u7684\u8d44\u6e90\uff0c\u4f8b\u5982\u91d1\u5e01\u548c\u7ecf\u9a8c\u503c\u3002\u4f8b\u5982\uff0c\u5b8c\u6210\u4e00\u4e2a\u9700\u8981\u7528\u7279\u5b9a\u6b66\u5668\u6740\u6b7b50\u4e2a\u50f5\u5c38\u7684\u6311\u6218\u53ef\u4ee5\u83b7\u5f97500\u679a\u91d1\u5e01\uff0c\u8fd9\u4e9b\u91d1\u5e01\u53ef\u7528\u4e8e\u5347\u7ea7\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u6bcf\u65e5\u6311\u6218\u60f3\u8c61\u6210\u63d0\u4f9b\u5feb\u901f\u63d0\u5347\u60a8\u8fdb\u5ea6\u7684\u8ff7\u4f60\u4efb\u52a1\u3002]"}, {"question": "\u50f5\u5c38\u7a81\u88ad\u4e2d\u5404\u79cd\u6e38\u620f\u6a21\u5f0f\u4e4b\u95f4\u7684\u4e3b\u8981\u533a\u522b\u662f\u4ec0\u4e48\uff1f", "answer": "\u50f5\u5c38\u7a81\u88ad\u63d0\u4f9b\u591a\u79cd\u6e38\u620f\u6a21\u5f0f\uff0c\u6bcf\u79cd\u6a21\u5f0f\u90fd\u6709\u72ec\u7279\u7684\u76ee\u6807\u3002\u4f8b\u5982\uff0c\u201c\u751f\u5b58\u6a21\u5f0f\u201d\u4e13\u6ce8\u4e8e\u5728\u9762\u5bf9\u65e0\u5c3d\u7684\u50f5\u5c38\u6d6a\u6f6e\u65f6\u5c3d\u53ef\u80fd\u957f\u65f6\u95f4\u5730\u751f\u5b58\uff0c\u800c\u201c\u4efb\u52a1\u6a21\u5f0f\u201d\u5219\u9700\u8981\u5b8c\u6210\u8bf8\u5982\u8425\u6551\u5e78\u5b58\u8005\u7684\u7279\u5b9a\u4efb\u52a1\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u751f\u5b58\u6a21\u5f0f\u8003\u9a8c\u8010\u529b\uff0c\u4efb\u52a1\u6a21\u5f0f\u8003\u9a8c\u7b56\u7565\u548c\u7cbe\u786e\u6027\u3002]"}, {"question": "\u5982\u4f55\u5728\u50f5\u5c38\u7a81\u88ad\u4e2d\u5c06\u6211\u7684\u8fdb\u5ea6\u8f6c\u79fb\u5230\u65b0\u8bbe\u5907\uff1f", "answer": "\u8981\u5c06\u50f5\u5c38\u7a81\u88ad\u4e2d\u7684\u8fdb\u5ea6\u8f6c\u79fb\u5230\u65b0\u8bbe\u5907\uff0c\u8bf7\u786e\u4fdd\u60a8\u5728\u4e24\u53f0\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u76f8\u540c\u7684\u5e10\u6237\uff08\u4f8b\u5982\uff0cGoogle Play \u6216 Apple ID\uff09\u3002\u60a8\u7684\u8fdb\u5ea6\u5c06\u81ea\u52a8\u540c\u6b65\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u4ece Android \u5207\u6362\u5230 iPhone\uff0c\u767b\u5f55\u60a8\u7684 Apple ID \u5c06\u6062\u590d\u60a8\u7684\u6e38\u620f\u6570\u636e\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: Android - Google Play\uff1biOS - Apple ID\u3002]"}, {"question": "\u5728\u50f5\u5c38\u7a81\u88ad\u4e2d\uff0c\u6211\u80fd\u591f\u627e\u5230\u54ea\u4e9b\u9690\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "\u50f5\u5c38\u7a81\u88ad\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u529f\u80fd\u548c\u5f69\u86cb\u3002\u4e00\u4e2a\u503c\u5f97\u6ce8\u610f\u7684\u4f8b\u5b50\u662f\u201c\u79d8\u5bc6\u63a9\u4f53\u201d\u5173\u5361\uff0c\u53ef\u4ee5\u901a\u8fc7\u5728\u4e3b\u83dc\u5355\u4e2d\u8f93\u5165\u7279\u5b9a\u4ee3\u7801\u6765\u8bbf\u95ee\u3002\u6b64\u5173\u5361\u63d0\u4f9b\u72ec\u7279\u7684\u5956\u52b1\u548c\u6311\u6218\u3002[\u5f69\u86cb\u6316\u6398: \u8bf7\u5bc6\u5207\u5173\u6ce8\u6e38\u620f\u4e2d\u7ec6\u5fae\u7684\u63d0\u793a\uff0c\u8fd9\u4e9b\u63d0\u793a\u53ef\u80fd\u5f15\u5bfc\u60a8\u627e\u5230\u9690\u85cf\u533a\u57df\u3002]"}, {"question": "\u5982\u4f55\u5728\u50f5\u5c38\u7a81\u88ad\u4e2d\u6709\u6548\u5730\u7ba1\u7406\u6211\u7684\u8d44\u6e90\uff1f", "answer": "\u5728\u50f5\u5c38\u7a81\u88ad\u4e2d\u6709\u6548\u7ba1\u7406\u8d44\u6e90\u5305\u62ec\u5e73\u8861\u5347\u7ea7\u548c\u6d88\u8017\u54c1\u7684\u652f\u51fa\u3002\u6b65\u9aa41\uff1a\u59cb\u7ec8\u4fdd\u7559\u4e00\u90e8\u5206\u91d1\u5e01\u7528\u4e8e\u7d27\u6025\u5347\u7ea7\u3002\u6b65\u9aa42\uff1a\u8c28\u614e\u4f7f\u7528\u6d88\u8017\u54c1\uff0c\u4f8b\u5982\u5065\u5eb7\u836f\u5242\u3002\u6b65\u9aa43\uff1a\u4f18\u5148\u8003\u8651\u957f\u671f\u6295\u8d44\uff0c\u4f8b\u5982\u6b66\u5668\u5347\u7ea7\uff0c\u800c\u4e0d\u662f\u77ed\u671f\u6536\u76ca\u3002\u4f8b\u5982\uff0c\u5c3d\u65e9\u5347\u7ea7\u4f60\u7684\u6563\u5f39\u67aa\u53ef\u4ee5\u4ece\u957f\u8fdc\u8282\u7701\u91d1\u5e01\uff0c\u56e0\u4e3a\u5b83\u51cf\u5c11\u4e86\u9891\u7e41\u7ef4\u4fee\u7684\u9700\u6c42\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u60a8\u7684\u8d44\u6e90\u60f3\u8c61\u6210\u9700\u8981\u4ed4\u7ec6\u5206\u914d\u7684\u9884\u7b97\u3002]"}, {"question": "\u5728\u50f5\u5c38\u7a81\u88ad\u4e2d\uff0c\u54ea\u4e9b\u8bbe\u7f6e\u6700\u9002\u5408\u6700\u4f73\u6027\u80fd\uff1f", "answer": "\u5728\u50f5\u5c38\u7a81\u88ad\u4e2d\u83b7\u5f97\u6700\u4f73\u6027\u80fd\uff0c\u8bf7\u6839\u636e\u60a8\u7684\u8bbe\u5907\u529f\u80fd\u8c03\u6574\u56fe\u5f62\u8bbe\u7f6e\u3002\u964d\u4f4e\u56fe\u5f62\u8d28\u91cf\u53ef\u4ee5\u63d0\u9ad8\u65e7\u8bbe\u5907\u7684\u5e27\u901f\u7387\u3002\u4f8b\u5982\uff0c\u5c06\u201c\u56fe\u5f62\u8d28\u91cf\u201d\u8bbe\u7f6e\u4e3a\u201c\u4e2d\u201d\u53ef\u4ee5\u5728\u4e2d\u7aef\u667a\u80fd\u624b\u673a\u4e0a\u63d0\u4f9b\u6d41\u7545\u7684\u6e38\u620f\u4f53\u9a8c\uff0c\u800c\u4e0d\u4f1a\u9020\u6210\u660e\u663e\u7684\u89c6\u89c9\u635f\u5931\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u9ad8\u7aef\u8bbe\u5907 - \u9ad8\u8d28\u91cf\uff1b\u4e2d\u7aef\u8bbe\u5907 - \u4e2d\u7b49\u8d28\u91cf\uff1b\u4f4e\u7aef\u8bbe\u5907 - \u4f4e\u8d28\u91cf\u3002]"}]
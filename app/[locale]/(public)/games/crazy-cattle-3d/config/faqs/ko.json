[{"question": "\ubbf8\uce5c \uc18c 3D: \uac8c\uc784 \uc2dc\uc791 \uc2dc \uc774\ub3d9 \ubc0f \uc816\uc744 \uc9dc\ub294 \ub4f1 \uae30\ubcf8\uc801\uc778 \ub3d9\uc791\uc740 \uc5b4\ub5bb\uac8c \uc218\ud589\ud569\ub2c8\uae4c?", "answer": "\uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub85c\uc11c, \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc18c\ub97c \uc774\ub3d9\ud558\ub824\uba74 WASD \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \ubc29\ud5a5\uc744 \uc870\uc815\ud569\ub2c8\ub2e4. \uc816\uc744 \uc9dc\ub294 \uae30\ub2a5\uc740 \uc77c\ubc18\uc801\uc73c\ub85c 'E' \ud0a4\uc5d0 \ub9e4\ud551\ub429\ub2c8\ub2e4. \uc816\uc744 \uc9dc\ub294 \uc7a5\uc18c(\uc816\ubc29\uc6b8\uc774 \uc788\ub294 \uc18c \uc544\uc774\ucf58\uc73c\ub85c \ud45c\uc2dc\ub428)\uc5d0 \uac00\uae4c\uc774 \ub2e4\uac00\uac00 'E' \ud0a4\ub97c \ub20c\ub7ec \uc816\uc744 \uc9dc\uae30 \uc2dc\uc791\ud569\ub2c8\ub2e4. \ucd5c\ub300 \uc218\ud655\ub7c9\uc744 \uc704\ud574 \ubbf8\ub2c8 \uac8c\uc784\uc5d0\uc11c \uc801\uc808\ud55c \uc2dc\uc810\uc5d0 \ud074\ub9ad\ud574\uc57c \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub9ce\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \ub9c8\uc6b0\uc2a4 \ubbfc\uac10\ub3c4\ub97c \uc870\uc815\ud568\uc73c\ub85c\uc368 \uc816 \uc0dd\uc0b0\uc131\uc744 \ub192\uc774\ub294 \uac83\uc744 \ubc1c\uacac\ud588\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc62c\ub4dc \ub9e5\ub3c4\ub0a0\ub4dc \ub18d\uc7a5'\uc744 \ubc29\ubb38\ud574 \ubcf4\uc138\uc694. \ud56d\uc0c1 \uc644\ubcbd\ud558\uac8c \uc791\ub3d9\ud558\ub294 \uc124\uc815\uc774 \uc788\uc2b5\ub2c8\ub2e4!"}, {"question": "\ucd08\ubcf4\uc790\uc778 \ubbf8\uce5c \uc18c 3D\uc5d0\uc11c \ube60\ub974\uac8c \ub3c8\uc744 \ubc84\ub294 \uac00\uc7a5 \uc88b\uc740 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc774\uba70, \ucd08\uae30 \uac8c\uc784 \ud22c\uc790 \uc911 \uac00\uc7a5 \ud070 \uc218\uc775\uc744 \ub0b4\ub294 \uac83\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubbf8\uce5c \uc18c 3D\uc5d0\uc11c \ucd08\uae30\uc5d0 \ube60\ub974\uac8c \ub3c8\uc744 \ubc8c\ub824\uba74 \ucd08\uae30 \ud018\uc2a4\ud2b8\ub97c \uc644\ub8cc\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. 1\ub2e8\uacc4: \ub18d\ubd80 \uae38\ub808\uc2a4\uac00 \uc8fc\ub294 \ud018\uc2a4\ud2b8\ub97c \uc6b0\uc120\uc21c\uc704\ub85c \ucc98\ub9ac\ud558\uc138\uc694! \ucd08\uae30 \ub2e8\uacc4\uc5d0\uc11c \uc0c1\ub2f9\ud55c \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \uc790\uae08\uc774 \ud655\ubcf4\ub418\uba74 \uc816\uc744 \uc9dc\ub294 \uc18d\ub3c4\uac00 \ub354 \ube60\ub978 \uae30\uacc4\uc5d0 \ud22c\uc790\ud558\uc2ed\uc2dc\uc624. \uc774\ub294 \uc816 \uc0dd\uc0b0 \uc18d\ub3c4\ub97c \uadf9\uc801\uc73c\ub85c \ub192\uc5ec \uc9c1\uc811 \uc218\uc785\uc744 \uc99d\ub300\uc2dc\ud0b5\ub2c8\ub2e4. 3\ub2e8\uacc4: \ucd08\uae30 \ub2e8\uacc4\uc5d0\uc11c \uace0\uc218\uc775 \uc18c\ub97c \uc0ac\uc721\ud558\ub294 \uac83\uc744 \uace0\ub824\ud558\uc2ed\uc2dc\uc624. \uc8fc \uac8c\uc784 \uba54\ub274\uc758 \uc18c \ud488\uc885 \ube44\uad50 \ucc28\ud2b8\ub97c \ucc38\uc870\ud558\uc5ec \uc790\uc138\ud55c \ud1b5\uacc4\ub97c \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uade0\ud615 \uc7a1\ud78c \uc811\uadfc \ubc29\uc2dd\uc744 \uc704\ud574 \uc800\uc9c0 \uc18c\ub97c \uba3c\uc800 \uc2dc\uc791\ud558\ub294 \uac83\uc744 \uace0\ub824\ud574\ubcf4\uc138\uc694. \ube60\ub978 \uae30\uacc4\uc640 \ud488\uc9c8 \uc88b\uc740 \uc18c\ub97c \uacb0\ud569\ud558\ub294 \uac83\uc774 \ucd08\uae30 \ud22c\uc790\ub85c \uc88b\uc740 \uc120\ud0dd\uc785\ub2c8\ub2e4."}, {"answer": "\ubbf8\uce5c \uc18c 3D\uc5d0\uc11c \uc18c\uac00 \ub54c\ub54c\ub85c \uc816\uc744 \uc9dc\ub294 \uac83\uc744 \uac70\ubd80\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c? \uc624\ub958\uc785\ub2c8\uae4c, \uc544\ub2c8\uba74 \ub193\uce58\uace0 \uc788\ub294 \uba54\ucee4\ub2c8\uc998\uc774 \uc788\uc2b5\ub2c8\uae4c?", "question": "\uc816\ud1b5\uc744 \uc9c4\uc815\uc2dc\ud0a4\uc138\uc694! \ud56d\uc0c1 \uc624\ub958\ub294 \uc544\ub2d9\ub2c8\ub2e4. \uc18c\uc758 \uae30\ubd84\uc740 \uc816 \uc0dd\uc0b0\uc131\uacfc \ud611\ub825\uc5d0 \uc0c1\ub2f9\ud55c \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uccab\uc9f8, \uc2a4\ud2b8\ub808\uc2a4\uac00 \uc8fc\uc694 \uc5ed\ud560\uc744 \ud569\ub2c8\ub2e4. \uc18c\uac00 \uba39\uc774\ud1b5(\uba39\uc774\ud1b5 \uc544\uc774\ucf58\uc73c\ub85c \ud45c\uc2dc\ub428)\uacfc \ubb3c\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\ub3c4\ub85d \ud558\uc2ed\uc2dc\uc624. \ub458\uc9f8, \uae68\ub057\ud55c \ud658\uacbd\uc774 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \ud39c\uc744 \uc815\uae30\uc801\uc73c\ub85c \uccad\uc18c\ud558\uba74 \uae30\ubd84\uc774 \uc88b\uc544\uc9d1\ub2c8\ub2e4(\uc0bd \ub3c4\uad6c\ub97c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624). \uc14b\uc9f8, \uc9c8\ubcd1\uc744 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uc18c\uc758 \uc678\uad00\uc5d0 \uc8fc\uc758\ud558\uc5ec \ud544\uc694\ud558\uba74 \uc57d\uc744 \ud22c\uc5ec\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\ub370\uc774\uc9c0'\ub77c\ub294 \uc18c\ub294 \ud39c\uc774 \uc815\uae30\uc801\uc73c\ub85c \uccad\uc18c\ub418\uc9c0 \uc54a\uc544 \ub354 \uc774\uc0c1 \uc816\uc744 \uc0dd\uc0b0\ud558\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \uccad\uacb0\uc740 \uc2e0\uc131\ud55c \uac83\uc785\ub2c8\ub2e4."}, {"question": "\ubbf8\uce5c \uc18c 3D \uace0\uae09 \uc804\ub7b5: \uacbd\uc7c1\uc801\uc778 \ub3c8 \ucc3d\ucd9c\uc5d0 \ucd5c\uc801\uc758 \uc18c \ud488\uc885\uc740 \ubb34\uc5c7\uc774\uba70, \uace0\uae09 \ud6c8\ub828 \uae30\uc220\uc740 \uc5b4\ub5bb\uac8c \uc0b0\ucd9c\uc744 \uadf9\ub300\ud654\ud569\ub2c8\uae4c?", "answer": "\ubbf8\uce5c \uc18c 3D\uc5d0\uc11c \ucd5c\ub300 \ub3c8\uc744 \ubc8c\uae30 \uc704\ud574\uc11c\ub294 \uc18c \ud488\uc885\uacfc \ud6c8\ub828\uc744 \ucd5c\uc801\ud654\ud558\ub294 \uac83\uc774 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \ud640\uc2a4\ud0c0\uc778 \uc18c\ub294 \ud575\uc2ec \uc218\uc775 \uc99d\ub300 \uc694\uc18c\ub85c\uc11c \uac00\uc7a5 \ub9ce\uc740 \uc6b0\uc720\ub97c \uc0dd\uc0b0\ud558\uc9c0\ub9cc \uc0c1\ub2f9\ud55c \ud22c\uc790\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ud6c8\ub828\uc5d0\ub294 \uc2e0\uccb4\uc801 \ubc0f \uc815\uc2e0\uc801 \uc790\uadf9\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. 1\ub2e8\uacc4: \ud5db\uac04\uc758 \ud2b8\ub808\ub4dc\ubc00\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub9e4\uc77c \uc6b4\ub3d9 \uc77c\uc815\uc744 \uc2e4\uc2dc\ud558\uc5ec \uc9c0\uad6c\ub825\uc744 \ub192\uc774\uc138\uc694. 2\ub2e8\uacc4: \uc601\uc591\uc740 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \ucd5c\uc801\uc758 \uc218\ud655\ub7c9\uc744 \uc704\ud574 \uade0\ud615 \uc7a1\ud78c \uc0ac\ub8cc \ud3a0\ub9bf \ud63c\ud569\ubb3c\uc744 \ub9cc\ub4dc\uc2ed\uc2dc\uc624. 3\ub2e8\uacc4: \uac15\ud55c \uc720\ub300\uac10\uc744 \ud615\uc131\ud558\ub294 \ub370 \uc2dc\uac04\uc744 \ud22c\uc790\ud558\uc2ed\uc2dc\uc624. \ud589\ubcf5\ud55c \uc18c\ub294 \ub354 \ub9ce\uc740 \uc6b0\uc720\ub97c \uc90d\ub2c8\ub2e4. \uc774\ub807\uac8c \uc0dd\uac01\ud558\uc2ed\uc2dc\uc624. \ub354 \ud589\ubcf5\ud55c \uc18c\ub294 \ub354 \ub9ce\uc740 \uc218\uc775\uc744 \ub0b4\uace0, \ub354 \ub9ce\uc740 \uc218\uc775\uc740 \ub354 \ud589\ubcf5\ud55c \uc18c\ub85c \uc774\uc5b4\uc9d1\ub2c8\ub2e4!"}, {"question": "\ubbf8\uce5c \uc18c 3D: \ub18d\uc7a5 \ub808\uc774\uc544\uc6c3\uc744 \ucd5c\uc801\ud654\ud558\uc5ec \ud6a8\uc728\uc131\uacfc \uc18c\uc758 \ud589\ubcf5\uc744 \uadf9\ub300\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc774\uba70, \ud2b9\ud788 \uc816 \uc9dc\ub294 \uc2dc\uac04\ub300\uc758 \ubcd1\ubaa9 \ud604\uc0c1\uc740 \uc5b4\ub5bb\uac8c \ucc98\ub9ac\ud569\ub2c8\uae4c?", "answer": "\ubbf8\uce5c \uc18c 3D\uc5d0\uc11c \ub18d\uc7a5 \ub808\uc774\uc544\uc6c3 \ucd5c\uc801\ud654\ub294 \ud6a8\uc728\uc131\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc18c\uc758 \uc774\ub3d9 \uac70\ub9ac\ub97c \ucd5c\uc18c\ud654\ud569\ub2c8\ub2e4. \uba39\uc774\uc640 \ubb3c \uacf5\uae09\uc6d0\uc744 \uc816 \uc9dc\ub294 \uc7a5\uc18c\uc640 \uac00\uae5d\uac8c \ubc30\uce58\ud569\ub2c8\ub2e4. \ub458\uc9f8, \ud2b9\ud788 \uc816 \uc9dc\ub294 \uc9c0\uc5ed \uc8fc\ubcc0\uc5d0\uc11c \ubcd1\ubaa9 \ud604\uc0c1\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \ub2e8\ubc29\ud5a5 \uad50\ud1b5 \ud750\ub984\uc744 \uad6c\ud604\ud569\ub2c8\ub2e4. \uc6b8\ud0c0\ub9ac\ub97c \uc804\ub7b5\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\uc2ed\uc2dc\uc624. \uc14b\uc9f8, \uc816 \uc9dc\ub294 \uc7a5\uc18c\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud569\ub2c8\ub2e4. \uace0\uae09 \uc7a5\uc18c\ub294 \ub354 \ub9ce\uc740 \uc591\uc744 \ucc98\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608: '\uc120\uc14b \ub18d\uc7a5'\uc758 \uc54c\ud30c \uc5ed \uc7a5\uc18c\uc5d0 \ub354 \uac00\uae4c\uc774 \ubb3c\ud1b5\uc744 \uc774\ub3d9\uc2dc\ud0a8 \uac83\uc774 \uc816 \uc9dc\ub294 \ud6a8\uc728\uc774 \uadf9\uc801\uc73c\ub85c \uc0c1\uc2b9\ud574 \uc0dd\uc0b0\ub7c9\uc774 20% \uc99d\uac00\ud588\uc2b5\ub2c8\ub2e4. \uacb0\uad6d, \uc774\ub294 \ud6a8\uc728\uc801\uc778 \uc816 \uc9dc\uae30\ub85c \uc778\ud574 \uc18c\uc758 \ud589\ubcf5\ub3c4\uac00 \ud5a5\uc0c1\ub418\uc5c8\uc2b5\ub2c8\ub2e4."}, {"question": "\ubbf8\uce5c \uc18c 3D\uc5d0\uc11c \ub0a0\uc528 \uc2dc\uc2a4\ud15c\uc744 \ud65c\uc6a9\ud558\uc5ec \uc18c \uc0ac\ub8cc\uc6a9 \uc791\ubb3c \uc218\ud655\ub7c9\uc744 \uadf9\ub300\ud654\ud558\ub294 \uc228\uaca8\uc9c4 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc774\uba70, \uc774\ub294 \uc6b0\uc720 \uc0dd\uc0b0\uc5d0 \uc5b4\ub5bb\uac8c \ubc18\uc601\ub429\ub2c8\uae4c?", "answer": "\ubbf8\uce5c \uc18c 3D\ub97c \ud50c\ub808\uc774\ud560 \ub54c \ub0a0\uc528\ub97c \uc544\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4! \ube44\ub97c \uc88b\uc544\ud558\ub294 \uc791\ubb3c(\ud074\ub85c\ubc84)\uc744 \uc2b5\ud55c \uacc4\uc808\uc5d0, \uac00\ubb44\uc5d0 \uac15\ud55c \uc791\ubb3c(\uc54c\ud314\ud30c)\uc744 \ud587\uc0b4\uc774 \uca0d\uca0d\ud55c \uacc4\uc808\uc5d0 \uc2ec\uc5b4 \uc791\ubb3c \uc218\ud655\ub7c9\uc744 \ucd5c\uc801\ud654\ud558\uc138\uc694! 1\ub2e8\uacc4: \ub18d\uc7a5\uc5d0 \uae30\uc0c1 \uad00\uce21\uc18c\ub97c \uc124\uce58\ud558\uc5ec \uc608\uce21 \uc815\ud655\ub3c4\ub97c \ub192\uc774\uc2ed\uc2dc\uc624. \uc791\ubb3c \uc120\ud0dd\uc740 \uc608\uce21\uc744 \uae30\ubc18\uc73c\ub85c \uc774\ub8e8\uc5b4\uc838\uc57c \ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \ub0a0\uc528\ub85c \uc778\ud574 \uc791\ubb3c \uc218\ud655\ub7c9\uc774 \uc88b\uc9c0 \uc54a\uc744 \ub54c \uc2dc\uc7a5\uc5d0\uc11c \uc791\ubb3c\uc744 \uad6c\uc785\ud558\uc5ec \uc791\ubb3c\uc744 \ubcf4\ucda9\ud558\uc2ed\uc2dc\uc624. \ube44\uc6a9 \ud6a8\uc728\uc131\uc744 \ud3c9\uac00\ud558\uc2ed\uc2dc\uc624! 3\ub2e8\uacc4: \uae30\ud6c4\uac00 \uc81c\uc5b4\ub418\ub294 \ud5db\uac04\uc5d0 \ud22c\uc790\ud558\uc5ec \ub0a0\uc528 \uc601\ud5a5\uc73c\ub85c \uc791\ubb3c \uc218\ud655\ub7c9\uc774 \uc800\ud558\ub418\ub354\ub77c\ub3c4 \uc0dd\uc0b0\ub7c9\uc744 \ub192\uc740 \uc218\uc900\uc73c\ub85c \uc720\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub18d\ubd80\uc758 \uc5f0\uac10\uc740 \uc911\uc694\ud569\ub2c8\ub2e4."}, {"question": "\ubbf8\uce5c \uc18c 3D \uc2ec\uce35 \ubd84\uc11d: \uc18c\uc758 \ud589\ubcf5, \ud488\uc885 \ubc0f \uc601\uc591 \uc218\uc900\uacfc \uac19\uc740 \uc694\uc18c\ub97c \uace0\ub824\ud558\uc5ec \uc6b0\uc720 \uc0dd\uc0b0\uc744 \uacc4\uc0b0\ud558\ub294 \uadfc\ubcf8\uc801\uc778 \uacf5\uc2dd\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubbf8\uce5c \uc18c 3D\uc758 \uc6b0\uc720 \uc0dd\uc0b0 \uacf5\uc2dd\uc740 \ubcf5\uc7a1\ud558\uc9c0\ub9cc \ud575\uc2ec \uad6c\uc131 \uc694\uc18c\ub97c \uc774\ud574\ud558\uba74 \ucd5c\ub300 \ud6a8\uc728\uc744 \ub04c\uc5b4\ub0bc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uae30\ubcf8 \uc0dd\uc0b0\ub7c9 = \ud488\uc885 \ubc30\uc218\uc728 * \ud589\ubcf5 \uc694\uc778 * \uc601\uc591 \uc218\uc900 * \uac74\uac15 \uc218\uc815\uc790. \ud488\uc885 \ubc30\uc218\uc728: \ud640\uc2a4\ud0c0\uc778 \uc18c\ub294 \uac00\uc7a5 \ub192\uc740 \uac12(\uc608: 1.2)\uc744 \uac00\uc9c0\uace0 \uc788\uc73c\uba70, \uc800\uc9c0 \uc18c\ub294 \ub0ae\uc740 \uac12(\uc608: 1.0)\uc744 \uac00\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud589\ubcf5 \uc694\uc778: \ub9e4\uc6b0 \ubd88\ud589\ud55c \uc18c\uc758 \uacbd\uc6b0 0.8\uc5d0\uc11c \ub9e4\uc6b0 \ud589\ubcf5\ud55c \uc18c\uc758 \uacbd\uc6b0 1.2\uae4c\uc9c0 \ubc94\uc704\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc601\uc591 \uc218\uc900: \uc2dd\ud488 \ud488\uc9c8\uc5d0 \ub530\ub77c \ub9c8\ucc2c\uac00\uc9c0\ub85c 0.7\uc5d0\uc11c 1.2\uae4c\uc9c0 \ub2e4\uc591\ud569\ub2c8\ub2e4. \uac74\uac15 \uc218\uc815\uc790: \uc9c8\ubcd1 \ubc0f \uae30\ud0c0 \uc9c8\ubcd1\uc740 \uc6b0\uc720 \uc0dd\uc0b0\ub7c9\uc5d0 \uc2ec\uac01\ud55c \uc545\uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4(\uc608: -3). \uc790\uc138\ud55c \ub0b4\uc6a9\uc740 \uacf5\uc2dd \uac8c\uc784 \uac00\uc774\ub4dc\ub97c \ucc38\uc870\ud558\uc2ed\uc2dc\uc624."}, {"question": "'\uc9c4\uc815 \ud6a8\uacfc' \ub610\ub294 '\uc6b0\uc720 \uc18d\ub3c4'\uc640 \uac19\uc740 \uc228\uaca8\uc9c4 \uc18c \ud1b5\uacc4\ub294 \ubbf8\uce5c \uc18c 3D \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\uba70 \uc870\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc228\uaca8\uc9c4 \uc18c \ud1b5\uacc4\ub294 \ubbf8\uce5c \uc18c 3D\uc5d0 \uae4a\uc774\ub97c \ub354\ud569\ub2c8\ub2e4. \uc6b0\uc720 \uc18d\ub3c4\ub294 \uc816 \uc9dc\uae30 \ubbf8\ub2c8 \uac8c\uc784 \uc911 \uc6b0\uc720\uac00 \uc5bc\ub9c8\ub098 \ube68\ub9ac \uc218\uc9d1\ub418\ub294\uc9c0\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc9c4\uc815 \ud6a8\uacfc\ub294 \uadfc\ucc98 \uc18c\uc758 \uc2a4\ud2b8\ub808\uc2a4 \uc218\uc900\uc744 \uc904\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud1b5\uacc4\ub97c \uc9c1\uc811 \ubcfc \uc218\ub294 \uc5c6\uc9c0\ub9cc \ud2b9\uc815 \ud589\ub3d9\uc774 \uc774\ub7ec\ud55c \ud1b5\uacc4\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc18c \uadfc\ucc98\uc5d0 \"\uc9c4\uc815 \ubd84\uc218\"\ub97c \uc124\uce58\ud558\uba74 \uc18c\uc758 \uc9c4\uc815 \ud6a8\uacfc\uac00 \ud1b5\uacc4\uc801\uc73c\ub85c \ud5a5\uc0c1\ub429\ub2c8\ub2e4. \uace0\uae09 \uc720\uc804 \ubc0f \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \uc6b0\uc720 \uc18d\ub3c4\ub97c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ube44\ubc00 \ud1b5\uacc4\ub97c \ud2b9\uc815 \ud589\ub3d9\uc5d0 \ub300\ud55c \ubcf4\uc0c1 \ubc0f \ub2e4\uc591\ud55c \ub18d\uc7a5 \ub514\uc790\uc778\uc744 \uc7a5\ub824\ud558\ub294 \uc228\uaca8\uc9c4 \uc218\uc815\uc790\ub85c \uac04\uc8fc\ud558\uc2ed\uc2dc\uc624. \ub18d\uc7a5 \ub514\uc790\uc778\uc744 \ub2e4\uc591\ud558\uac8c \uc2dc\ub3c4\ud574 \ubcf4\uc138\uc694!"}, {"question": "\ubbf8\uce5c \uc18c 3D\uc5d0\uc11c PC \ubc84\uc804\uacfc \ubaa8\ubc14\uc77c \ubc84\uc804 \uac04\uc5d0, \ud2b9\ud788 \uc800\uc7a5 \uac8c\uc784 \ub370\uc774\ud130\uc640 \uc9c4\ud589 \uc0c1\ud669\uc5d0 \ub300\ud55c \ud50c\ub7ab\ud3fc \uac04 \ud638\ud658\uc131\uc774 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ubbf8\uce5c \uc18c 3D\uc758 \uc800\uc7a5 \uac8c\uc784 \ub370\uc774\ud130\ub294 PC\uc640 \ubaa8\ubc14\uc77c \uac04\uc5d0 \uc804\uc1a1\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uac8c\uc784\uc758 \uad6c\uc870\uc801\uc778 \ucc28\uc774\ub85c \uc778\ud574 \uc9c4\ud589 \uc0c1\ud669\ub3c4 \ub9c8\ucc2c\uac00\uc9c0\uc785\ub2c8\ub2e4. \ub450 \ubc84\uc804 \ubaa8\ub450 \ud575\uc2ec \uac8c\uc784 \ud50c\ub808\uc774 \ub8e8\ud504\ub97c \uacf5\uc720\ud558\uc9c0\ub9cc, \uac8c\uc784 \ud30c\uc77c\uc758 \uad6c\uc870\uac00 \ud06c\uac8c \ub2ec\ub77c\uc838 \ud638\ud658\uc131\uc774 \ub0ae\uc544\uc9d1\ub2c8\ub2e4. \ubaa8\ubc14\uc77c \ubc84\uc804\uc740 \uac04\uc18c\ud654\ub41c \ud50c\ub808\uc774\uc640 \uc9e7\uc740 \ud50c\ub808\uc774 \uc2dc\uac04\uc5d0 \ucd08\uc810\uc744 \ub9de\ucd94\ub294 \ubc18\uba74, PC \ubc84\uc804\uc740 \uad11\ub300\ud55c \uc9c0\ud615\uc744 \uc9c0\uc6d0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud5a5\ud6c4 \ud074\ub77c\uc6b0\ub4dc \ub3d9\uae30\ud654 \ub3c4\uad6c\uac00 \ud1b5\ud569\ub420 \uc608\uc815\uc774\uc9c0\ub9cc, \ud604\uc7ac\ub294 \uc0ac\uc6a9\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."}, {"question": "\ubbf8\uce5c \uc18c 3D\uc5d0 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8 \ub610\ub294 \uadf9\ud788 \ub4dc\ubb38 \uc18c \ud488\uc885\uc774 \uc788\uc2b5\ub2c8\uae4c? \uc774\ub97c \uc0ac\uc721\ud558\uae30 \uc704\ud574\uc11c\ub294 \uc5b4\ub5a4 \uc870\uac74\uc744 \ucda9\uc871\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\uc804\uc124\uc5d0 \ub530\ub974\uba74, \uac8c\uc784 \ub0b4 \ubaa8\ub4e0 \uc5c5\uc801\uc744 \uc644\ub8cc\ud558\uace0 \ub18d\ubd80 \uae38\ub808\uc2a4 \ud5db\uac04 \ub4a4\uc758 \uc791\ubb3c \uc6d0\uc744 \ubc29\ubb38\ud558\uace0 \ucf54\ub4dc \"MOOO-STERIOUS\"\ub97c \uc785\ub825\ud558\uba74 \uc6b0\uc8fc \uc6b0\uc720\ub97c \uc790\ub3d9\uc73c\ub85c \uc0dd\uc0b0\ud558\ub294 \uc2e0\ube44\ud55c '\uc740\ud558\uacc4 \uc18c'\ub97c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4! \ub354 \ub9ce\uc740 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc874\uc7ac\ud569\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\ub294 10\uc5f0\uc2b9\uc744 \ub2ec\uc131\ud558\uc5ec '\uae08\ube5b \uc816\ud1b5' \ud6a8\uacfc\ub97c \ud65c\uc131\ud654\ud574\uc57c \ud569\ub2c8\ub2e4. \uc18c\ubb38\uc5d0 \ub530\ub974\uba74 \uaca8\uc6b8\uc5d0 '\ub85c\ubcf4 \uc18c'\uac00 \ub098\ud0c0\ub0a9\ub2c8\ub2e4!"}]
[{"question": "\u75af\u72c2\u5976\u725b3D\uff1a\u6e38\u620f\u5f00\u59cb\u65f6\uff0c\u5982\u4f55\u6267\u884c\u57fa\u672c\u64cd\u4f5c\uff0c\u4f8b\u5982\u79fb\u52a8\u548c\u6324\u5976\uff1f", "answer": "\u5bf9\u4e8e\u65b0\u624b\u73a9\u5bb6\u6765\u8bf4\uff0c\u4e86\u89e3\u57fa\u672c\u63a7\u5236\u65b9\u6cd5\u81f3\u5173\u91cd\u8981\u3002\u79fb\u52a8\u5976\u725b\u9700\u8981\u4f7f\u7528 WASD \u952e\u63a7\u5236\u65b9\u5411\u3002\u6324\u5976\u901a\u5e38\u6620\u5c04\u5230\u201cE\u201d\u952e\u3002\u9760\u8fd1\u6324\u5976\u7ad9\uff08\u7528\u5e26\u6709\u725b\u5976\u6ef4\u7684\u5976\u725b\u56fe\u6807\u6307\u793a\uff09\uff0c\u7136\u540e\u6309\u201cE\u201d\u952e\u5f00\u59cb\u6324\u5976\u3002\u5c0f\u6e38\u620f\u53ef\u80fd\u9700\u8981\u60a8\u5728\u6b63\u786e\u7684\u65f6\u95f4\u70b9\u51fb\u624d\u80fd\u83b7\u5f97\u6700\u5927\u4ea7\u91cf\u3002\u8bb8\u591a\u73a9\u5bb6\u53d1\u73b0\u8c03\u6574\u9f20\u6807\u7075\u654f\u5ea6\u6709\u52a9\u4e8e\u63d0\u9ad8\u725b\u5976\u4ea7\u91cf\u3002\u4f8b\u5982\uff0c\u5c1d\u8bd5\u8bbf\u95ee\u201c\u8001\u9ea6\u8fea\u519c\u5e84\u201d\u2014\u2014\u5b83\u603b\u662f\u62e5\u6709\u529f\u80fd\u9f50\u5168\u7684\u8bbe\u7f6e\uff01"}, {"question": "\u5728\u75af\u72c2\u5976\u725b3D\u4e2d\uff0c\u4f5c\u4e3a\u65b0\u624b\u5feb\u901f\u8d5a\u94b1\u7684\u6700\u4f73\u65b9\u6cd5\u662f\u4ec0\u4e48\uff1f\u54ea\u4e9b\u65e9\u671f\u6e38\u620f\u6295\u8d44\u80fd\u5e26\u6765\u6700\u5927\u7684\u56de\u62a5\uff1f", "answer": "\u5728\u75af\u72c2\u5976\u725b3D\u7684\u65e9\u671f\u5feb\u901f\u8d5a\u94b1\uff0c\u4e13\u6ce8\u4e8e\u5b8c\u6210\u521d\u59cb\u4efb\u52a1\u3002\u6b65\u9aa4 1\uff1a\u4f18\u5148\u5b8c\u6210\u5409\u5c14\u65af\u519c\u592b\u7684\u4efb\u52a1\uff01\u5b83\u4eec\u5728\u65e9\u671f\u63d0\u4f9b\u4e30\u539a\u7684\u5956\u52b1\u3002\u6b65\u9aa4 2\uff1a\u4e00\u65e6\u62e5\u6709\u8d44\u91d1\uff0c\u6295\u8d44\u4e8e\u66f4\u5feb\u7684\u6324\u5976\u673a\u5668\u3002\u8fd9\u4e9b\u673a\u5668\u6781\u5927\u5730\u63d0\u9ad8\u4e86\u725b\u5976\u751f\u4ea7\u901f\u5ea6\uff0c\u76f4\u63a5\u8f6c\u5316\u4e3a\u66f4\u591a\u6536\u5165\u3002\u6b65\u9aa4 3\uff1a\u8003\u8651\u5728\u65e9\u671f\u57f9\u80b2\u9ad8\u4ea7\u5976\u725b\u3002\u53c2\u8003\u6e38\u620f\u4e3b\u83dc\u5355\u4e2d\u7684\u201c\u5976\u725b\u54c1\u79cd\u6bd4\u8f83\u56fe\u8868\u201d\u4ee5\u83b7\u53d6\u8be6\u7ec6\u6570\u636e\u3002\u8003\u8651\u4ece\u8377\u65af\u5766\u5976\u725b\u5f00\u59cb\uff0c\u4ee5\u4e00\u79cd\u5e73\u8861\u7684\u65b9\u5f0f\u6765\u505a\u3002\u5feb\u901f\u673a\u5668\u4e0e\u4f18\u8d28\u5976\u725b\u7684\u7ed3\u5408\u662f\u4e00\u4e2a\u4e0d\u9519\u7684\u521d\u59cb\u6295\u8d44\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u7684\u5976\u725b\u6709\u65f6\u4f1a\u62d2\u7edd\u88ab\u6324\u5976\uff1f\u662f\u6545\u969c\u8fd8\u662f\u6211\u9057\u6f0f\u4e86\u67d0\u79cd\u673a\u5236\uff1f", "answer": "\u51b7\u9759\uff01\u8fd9\u5e76\u975e\u603b\u662f\u6545\u969c\u3002\u5976\u725b\u7684\u60c5\u7eea\u4f1a\u6781\u5927\u5730\u5f71\u54cd\u725b\u5976\u4ea7\u91cf\u548c\u5408\u4f5c\u7a0b\u5ea6\u3002\u9996\u5148\uff0c\u538b\u529b\u8d77\u7740\u91cd\u8981\u4f5c\u7528\u3002\u786e\u4fdd\u4f60\u7684\u5976\u725b\u80fd\u5403\u5230\u4e1c\u897f\uff08\u7528\u9972\u6599\u69fd\u56fe\u6807\u6807\u8bc6\uff09\u548c\u6c34\u3002\u5176\u6b21\uff0c\u5e72\u51c0\u7684\u73af\u5883\u81f3\u5173\u91cd\u8981\u3002\u5b9a\u671f\u6e05\u7406\u725b\u820d\u53ef\u4ee5\u6539\u5584\u5fc3\u60c5\uff08\u4f7f\u7528\u94f2\u5b50\u5de5\u5177\uff09\u3002\u7b2c\u4e09\uff0c\u68c0\u67e5\u75be\u75c5\u3002\u89c2\u5bdf\u5976\u725b\u7684\u89c6\u89c9\u7ebf\u7d22\uff0c\u5982\u6709\u5fc5\u8981\uff0c\u7ed9\u4e88\u836f\u7269\u6cbb\u7597\u3002\u4f8b\u5982\uff0c\u4e00\u5934\u540d\u4e3a\u201c\u9edb\u897f\u201d\u7684\u5976\u725b\u505c\u6b62\u751f\u4ea7\u725b\u5976\uff0c\u56e0\u4e3a\u5979\u7684\u725b\u820d\u6ca1\u6709\u5b9a\u671f\u6e05\u6d01\u3002\u4fdd\u6301\u6e05\u6d01\u5f88\u91cd\u8981\u3002"}, {"question": "\u75af\u72c2\u5976\u725b3D\u9ad8\u7ea7\u7b56\u7565\uff1a\u54ea\u4e9b\u5976\u725b\u54c1\u79cd\u6700\u9002\u5408\u4ea7\u751f\u7ade\u4e89\u6027\u7684\u9ad8\u5229\u6da6\uff0c\u4ee5\u53ca\u54ea\u4e9b\u9ad8\u7ea7\u8bad\u7ec3\u6280\u5de7\u53ef\u4ee5\u6700\u5927\u5316\u4ea7\u91cf\uff1f", "answer": "\u5728\u75af\u72c2\u5976\u725b3D\u4e2d\u5b9e\u73b0\u6700\u5927\u5229\u6da6\uff0c\u9700\u8981\u6700\u5927\u5316\u5976\u725b\u54c1\u79cd\u548c\u8bad\u7ec3\u3002\u8377\u65af\u5766\u5976\u725b\u63d0\u4f9b\u6700\u9ad8\u7684\u725b\u5976\u4ea7\u91cf\uff0c\u4f5c\u4e3a\u6838\u5fc3\u5229\u6da6\u500d\u589e\u5668\uff0c\u4f46\u9700\u8981\u5927\u91cf\u6295\u8d44\u3002\u8bad\u7ec3\u5305\u62ec\u8eab\u4f53\u548c\u7cbe\u795e\u523a\u6fc0\u3002\u6b65\u9aa4 1\uff1a\u5b9e\u65bd\u6bcf\u5929\u5728\u725b\u68da\u91cc\u4f7f\u7528\u8dd1\u6b65\u673a\u7684\u953b\u70bc\u65f6\u95f4\u8868\u3002\u8fd9\u63d0\u9ad8\u4e86\u8010\u529b\u3002\u6b65\u9aa4 2\uff1a\u8425\u517b\u8d77\u7740\u5de8\u5927\u4f5c\u7528\uff1b\u521b\u9020\u4e00\u4e2a\u5747\u8861\u7684\u9972\u6599\u9897\u7c92\u6df7\u5408\u7269\u4ee5\u83b7\u5f97\u6700\u4f73\u4ea7\u91cf\u3002\u6b65\u9aa4 3\uff1a\u82b1\u65f6\u95f4\u5efa\u7acb\u7262\u56fa\u7684\u8054\u7cfb\u3002\u5feb\u4e50\u7684\u5976\u725b\u4f1a\u4ea7\u51fa\u66f4\u591a\u7684\u725b\u5976\u3002\u60f3\u60f3\u770b\u2014\u2014\u66f4\u5feb\u4e50\u7684\u5976\u725b\u4f1a\u83b7\u5f97\u66f4\u591a\u5229\u6da6\uff0c\u800c\u66f4\u591a\u7684\u5229\u6da6\u53c8\u4f1a\u4f7f\u5976\u725b\u66f4\u52a0\u5feb\u4e50\uff01"}, {"question": "\u75af\u72c2\u5976\u725b3D\uff1a\u5982\u4f55\u4f18\u5316\u519c\u573a\u5e03\u5c40\u4ee5\u6700\u5927\u5316\u6548\u7387\u548c\u5976\u725b\u5e78\u798f\u611f\uff0c\u5c24\u5176\u662f\u5728\u9ad8\u5cf0\u6324\u5976\u671f\u95f4\u5982\u4f55\u5904\u7406\u74f6\u9888\uff1f", "answer": "\u519c\u573a\u5e03\u5c40\u4f18\u5316\u5bf9\u4e8e\u75af\u72c2\u5976\u725b3D\u7684\u6548\u7387\u81f3\u5173\u91cd\u8981\u3002\u5c3d\u91cf\u51cf\u5c11\u5976\u725b\u7684\u65c5\u884c\u8ddd\u79bb\u3002\u5c06\u9972\u6599\u548c\u6c34\u6e90\u653e\u7f6e\u5728\u6324\u5976\u7ad9\u9644\u8fd1\u3002\u5176\u6b21\uff0c\u5b9e\u65bd\u5355\u5411\u4ea4\u901a\u6d41\uff0c\u4ee5\u9632\u6b62\u74f6\u9888\uff0c\u5c24\u5176\u662f\u5728\u6324\u5976\u533a\u3002\u8003\u8651\u7b56\u7565\u6027\u5730\u4f7f\u7528\u6805\u680f\u3002\u7b2c\u4e09\uff0c\u5347\u7ea7\u6324\u5976\u7ad9\u3002\u66f4\u9ad8\u8d28\u91cf\u7684\u6324\u5976\u7ad9\u53ef\u4ee5\u5904\u7406\u66f4\u9ad8\u7684\u4ea7\u91cf\u3002\u4f8b\u5982\uff0c\u5c06\u6c34\u69fd\u8fc1\u79fb\u5230\u201c\u65e5\u843d\u519c\u573a\u201d\u7684 Alpha \u7ad9\u4f4d\u9644\u8fd1\u6781\u5927\u5730\u63d0\u9ad8\u4e86\u6324\u5976\u6548\u7387\u3002\u8fd9\u5c06\u4ea7\u91cf\u63d0\u9ad8\u4e86 20%\uff0c\u6700\u7ec8\u4f7f\u5976\u725b\u7531\u4e8e\u9ad8\u6548\u7684\u6324\u5976\u800c\u66f4\u52a0\u5feb\u4e50\u3002"}, {"question": "\u5728\u75af\u72c2\u5976\u725b3D\u4e2d\uff0c\u54ea\u4e9b\u9690\u85cf\u7b56\u7565\u5229\u7528\u5929\u6c14\u7cfb\u7edf\u6700\u5927\u5316\u7528\u4e8e\u5976\u725b\u9972\u6599\u7684\u4f5c\u7269\u4ea7\u91cf\uff0c\u4ee5\u53ca\u5b83\u4eec\u5982\u4f55\u8f6c\u5316\u4e3a\u725b\u5976\u4ea7\u91cf\uff1f", "answer": "\u5728\u73a9\u75af\u72c2\u5976\u725b3D\u65f6\uff0c\u4e86\u89e3\u5929\u6c14\u662f\u5173\u952e\uff01\u901a\u8fc7\u5728\u96e8\u5b63\u79cd\u690d\u559c\u96e8\u4f5c\u7269\uff08\u4e09\u53f6\u8349\uff09\uff0c\u5728\u9633\u5149\u660e\u5a9a\u7684\u65f6\u5019\u79cd\u690d\u8010\u65f1\u4f5c\u7269\uff08\u82dc\u84ff\uff09\u6765\u4f18\u5316\u4f5c\u7269\u4ea7\u91cf\uff01\u6b65\u9aa4 1\uff1a\u5728\u519c\u573a\u5b89\u88c5\u4e00\u4e2a\u6c14\u8c61\u7ad9\u4ee5\u63d0\u9ad8\u9884\u6d4b\u51c6\u786e\u6027\u3002\u4f5c\u7269\u9009\u62e9\u5e94\u6839\u636e\u9884\u6d4b\u6765\u51b3\u5b9a\u3002\u6b65\u9aa4 2\uff1a\u5728\u4f5c\u7269\u4ea7\u91cf\u56e0\u5929\u6c14\u539f\u56e0\u53ef\u80fd\u8f83\u4f4e\u65f6\uff0c\u901a\u8fc7\u4ece\u5e02\u573a\u8d2d\u4e70\u6765\u8865\u5145\u4f5c\u7269\u3002\u4e00\u5b9a\u8981\u8bc4\u4f30\u6210\u672c\u6548\u76ca\uff01\u6b65\u9aa4 3\uff1a\u6295\u8d44\u4e8e\u6c14\u5019\u63a7\u5236\u7684\u725b\u68da\uff0c\u5373\u4f7f\u5929\u6c14\u5f71\u54cd\u4f5c\u7269\u4ea7\u91cf\uff0c\u4ea7\u91cf\u4e5f\u80fd\u4fdd\u6301\u5728\u9ad8\u6c34\u5e73\u3002\u519c\u5386\u662f\u6e38\u620f\u6539\u53d8\u8005\u3002"}, {"question": "\u75af\u72c2\u5976\u725b3D\u6df1\u5165\u63a2\u8ba8\uff1a\u8003\u8651\u5976\u725b\u5e78\u798f\u611f\u3001\u54c1\u79cd\u548c\u8425\u517b\u6c34\u5e73\u7b49\u56e0\u7d20\uff0c\u8ba1\u7b97\u725b\u5976\u4ea7\u91cf\u7684\u6f5c\u5728\u516c\u5f0f\u662f\u4ec0\u4e48\uff1f", "answer": "\u75af\u72c2\u5976\u725b3D\u7684\u725b\u5976\u4ea7\u91cf\u516c\u5f0f\u5f88\u590d\u6742\uff0c\u4f46\u4e86\u89e3\u6838\u5fc3\u7ec4\u4ef6\u53ef\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u6548\u7387\u3002\u57fa\u672c\u4ea7\u91cf = \u54c1\u79cd\u4e58\u6570 * \u5e78\u798f\u56e0\u5b50 * \u8425\u517b\u6c34\u5e73 * \u5065\u5eb7\u4fee\u6b63\u503c\u3002\u54c1\u79cd\u4e58\u6570\uff1a\u8377\u65af\u5766\u5976\u725b\u7684\u4ef7\u503c\u6700\u9ad8\uff08\u4f8b\u5982\uff0c1.2\uff09\uff0c\u800c\u5a1f\u59d7\u5976\u725b\u7684\u4ef7\u503c\u53ef\u80fd\u8f83\u4f4e\uff08\u4f8b\u5982\uff0c1.0\uff09\u3002\u5e78\u798f\u56e0\u5b50\uff1a\u8303\u56f4\u4ece 0.8\uff08\u6781\u5ea6\u4e0d\u5feb\u4e50\uff09\u5230 1.2\uff08\u6781\u5ea6\u5feb\u4e50\uff09\u3002\u8425\u517b\u6c34\u5e73\uff1a\u540c\u6837\u6839\u636e\u98df\u7269\u8d28\u91cf\u5728 0.7 \u5230 1.2 \u4e4b\u95f4\u53d8\u5316\u3002\u5065\u5eb7\u4fee\u6b63\u503c\uff1a\u75be\u75c5\u548c\u5176\u4ed6\u75be\u75c5\u4f1a\u5bf9\u725b\u5976\u4ea7\u91cf\u4ea7\u751f\u4e25\u91cd\u4e0d\u5229\u5f71\u54cd\uff08\u4f8b\u5982 -3\uff09\u3002\u8bf7\u53c2\u8003\u5b98\u65b9\u6e38\u620f\u6307\u5357\u4e86\u89e3\u66f4\u591a\u4fe1\u606f\u3002"}, {"question": "\u75af\u72c2\u5976\u725b3D\u4e2d\uff0c\u8bf8\u5982\u201c\u9547\u5b9a\u5149\u73af\u201d\u6216\u201c\u725b\u5976\u901f\u5ea6\u201d\u4e4b\u7c7b\u7684\u9690\u85cf\u5976\u725b\u5c5e\u6027\u4f1a\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\uff0c\u4ee5\u53ca\u5b83\u4eec\u80fd\u5426\u88ab\u64cd\u63a7\uff1f", "answer": "\u75af\u72c2\u5976\u725b3D\u4e2d\u7684\u9690\u85cf\u5976\u725b\u5c5e\u6027\u589e\u52a0\u4e86\u6e38\u620f\u7684\u6df1\u5ea6\u3002\u725b\u5976\u901f\u5ea6\u4f1a\u5f71\u54cd\u6324\u5976\u5c0f\u6e38\u620f\u671f\u95f4\u725b\u5976\u6536\u96c6\u7684\u901f\u5ea6\u3002\u9547\u5b9a\u5149\u73af\u4f1a\u964d\u4f4e\u9644\u8fd1\u5976\u725b\u7684\u538b\u529b\u6c34\u5e73\u3002\u867d\u7136\u6211\u4eec\u65e0\u6cd5\u76f4\u63a5\u770b\u5230\u8fd9\u4e9b\u5c5e\u6027\uff0c\u4f46\u67d0\u4e9b\u884c\u52a8\u4f1a\u5f71\u54cd\u5b83\u4eec\u3002\u4f8b\u5982\uff0c\u5728\u5976\u725b\u9644\u8fd1\u5efa\u9020\u201c\u9547\u9759\u55b7\u6cc9\u201d\u4f1a\u7edf\u8ba1\u6027\u5730\u63d0\u9ad8\u5b83\u4eec\u7684\u9547\u5b9a\u5149\u73af\u3002\u9ad8\u7aef\u9057\u4f20\u548c\u5347\u7ea7\u53ef\u4ee5\u63d0\u9ad8\u725b\u5976\u901f\u5ea6\u3002\u5c06\u8fd9\u4e9b\u79d8\u5bc6\u5c5e\u6027\u89c6\u4e3a\u5956\u52b1\u7279\u5b9a\u884c\u4e3a\u5e76\u9f13\u52b1\u591a\u6837\u5316\u519c\u573a\u8bbe\u8ba1\u7684\u9690\u85cf\u4fee\u6b63\u503c\u3002\u5c1d\u8bd5\u4e0d\u540c\u7684\u519c\u573a\u8bbe\u8ba1\uff01"}, {"question": "\u75af\u72c2\u5976\u725b3D\uff1aPC \u7248\u672c\u548c\u79fb\u52a8\u7248\u672c\u4e4b\u95f4\u662f\u5426\u5b58\u5728\u8de8\u5e73\u53f0\u517c\u5bb9\u6027\uff0c\u7279\u522b\u662f\u5173\u4e8e\u5b58\u6863\u6570\u636e\u548c\u8fdb\u5ea6\uff1f", "answer": "\u7531\u4e8e\u6e38\u620f\u6587\u4ef6\u7ed3\u6784\u4e0a\u7684\u5dee\u5f02\uff0c\u75af\u72c2\u5976\u725b3D\u7684\u5b58\u6863\u6570\u636e\u65e0\u6cd5\u5728 PC \u7248\u672c\u548c\u79fb\u52a8\u7248\u672c\u4e4b\u95f4\u4f20\u8f93\u3002\u6e38\u620f\u8fdb\u5ea6\u4e5f\u65e0\u6cd5\u4fdd\u5b58\u3002\u867d\u7136\u8fd9\u4e24\u4e2a\u7248\u672c\u5171\u4eab\u6838\u5fc3\u6e38\u620f\u5faa\u73af\uff0c\u4f46\u5b83\u4eec\u5728\u7ed3\u6784\u4e0a\u5b58\u5728\u663e\u8457\u5dee\u5f02\uff0c\u4ece\u800c\u964d\u4f4e\u4e86\u5b83\u4eec\u7684\u517c\u5bb9\u6027\u3002\u79fb\u52a8\u7aef\u4fa7\u91cd\u4e8e\u7b80\u5316\u7684\u6e38\u620f\u4f53\u9a8c\u548c\u66f4\u77ed\u7684\u6e38\u620f\u6d41\u7a0b\uff0c\u800c PC \u7aef\u5219\u53ef\u4ee5\u652f\u6301\u66f4\u5e7f\u9614\u7684\u573a\u666f\u3002\u8bf7\u6ce8\u610f\uff0c\u4e91\u540c\u6b65\u5de5\u5177\u8ba1\u5212\u5728\u672a\u6765\u96c6\u6210\uff0c\u4f46\u76ee\u524d\u5c1a\u4e0d\u53ef\u7528\u3002"}, {"question": "\u75af\u72c2\u5976\u725b3D\u4e2d\u662f\u5426\u5b58\u5728\u9690\u85cf\u7684\u5f69\u86cb\u6216\u8d85\u7a00\u6709\u5976\u725b\u54c1\u79cd\uff0c\u4ee5\u53ca\u89e6\u53d1\u5b83\u4eec\u4ee5\u4f9b\u517b\u6b96\u7684\u6761\u4ef6\u662f\u4ec0\u4e48\uff1f", "answer": "\u4f20\u8bf4\u5982\u679c\u5b8c\u6210\u6e38\u620f\u4e2d\u6240\u6709\u6210\u5c31\uff0c\u8bbf\u95ee\u5409\u5c14\u65af\u519c\u592b\u8eab\u540e\u7684\u5c0f\u9ea6\u5708\uff0c\u5e76\u8f93\u5165\u4ee3\u7801\u201cMOOO-STERIOUS\u201d\uff0c\u4f60\u53ef\u80fd\u4f1a\u89e3\u9501\u96be\u4ee5\u6349\u6478\u7684\u201c\u94f6\u6cb3\u5976\u725b\u201d\uff0c\u5b83\u4f1a\u81ea\u52a8\u751f\u4ea7\u94f6\u6cb3\u725b\u5976\uff01\u8fd8\u5b58\u5728\u5176\u4ed6\u5f69\u86cb\u3002\u73a9\u5bb6\u5fc5\u987b\u8d62\u5f97\u5341\u573a\u8fde\u7eed\u7684\u8d5a\u94b1\u6bd4\u8d5b\u624d\u80fd\u6fc0\u6d3b\u201c\u91d1\u8272\u4e73\u623f\u201d\u6548\u679c\u3002\u6709\u4f20\u95fb\u79f0\u201c\u673a\u5668\u4eba\u5976\u725b\u201d\u4f1a\u5728\u51ac\u5b63\u51fa\u73b0\uff01"}]
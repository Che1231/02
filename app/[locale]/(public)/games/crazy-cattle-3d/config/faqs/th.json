1c\u0e25\u0e1c\u0e25\u0e34\u0e15\u0e1e\u0e37\u0e0a\u0e42\u0e14\u0e22\u0e1b\u0e25\u0e39\u0e01\u0e1e\u0e37\u0e0a\u0e17\u0e35\u0e48\u0e0a\u0e2d\u0e1a\u0e1d\u0e19 (\u0e42\u0e04\u0e25\u0e40\u0e27\u0e2d\u0e23\u0e4c) \u0e43\u0e19\u0e24\u0e14\u0e39\u0e1d\u0e19 \u0e41\u0e25\u0e30\u0e1e\u0e37\u0e0a\u0e17\u0e35\u0e48\u0e17\u0e19\u0e15\u0e48\u0e2d\u0e20\u0e31\u0e22\u0e41\u0e25\u0e49\u0e07 (\u0e2b\u0e0d\u0e49\u0e32\u0e1d\u0e23\u0e31\u0e48\u0e19) \u0e40\u0e21\u0e37\u0e48\u0e2d\u0e14\u0e27\u0e07\u0e2d\u0e32\u0e17\u0e34\u0e15\u0e22\u0e4c\u0e2a\u0e48\u0e2d\u0e07\u0e41\u0e2a\u0e07! \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 1: \u0e15\u0e34\u0e14\u0e15\u0e31\u0e49\u0e07\u0e2a\u0e16\u0e32\u0e19\u0e35\u0e15\u0e23\u0e27\u0e08\u0e2d\u0e32\u0e01\u0e32\u0e28\u0e43\u0e19\u0e1f\u0e32\u0e23\u0e4c\u0e21\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e04\u0e27\u0e32\u0e21\u0e41\u0e21\u0e48\u0e19\u0e22\u0e33\u0e43\u0e19\u0e01\u0e32\u0e23\u0e1e\u0e22\u0e32\u0e01\u0e23\u0e13\u0e4c \u0e1c\u0e25\u0e1c\u0e25\u0e34\u0e15\u0e02\u0e2d\u0e07\u0e1e\u0e37\u0e0a\u0e04\u0e27\u0e23\u0e15\u0e31\u0e14\u0e2a\u0e34\u0e19\u0e43\u0e08\u0e15\u0e32\u0e21\u0e01\u0e32\u0e23\u0e04\u0e32\u0e14\u0e01\u0e32\u0e23\u0e13\u0e4c \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 2: \u0e40\u0e2a\u0e23\u0e34\u0e21\u0e1e\u0e37\u0e0a\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e42\u0e14\u0e22\u0e01\u0e32\u0e23\u0e0b\u0e37\u0e49\u0e2d\u0e08\u0e32\u0e01\u0e15\u0e25\u0e32\u0e14\u0e40\u0e21\u0e37\u0e48\u0e2d\u0e1c\u0e25\u0e1c\u0e25\u0e34\u0e15\u0e02\u0e2d\u0e07\u0e1e\u0e37\u0e0a\u0e2d\u0e32\u0e08\u0e15\u0e48\u0e33\u0e40\u0e19\u0e37\u0e48\u0e2d\u0e07\u0e08\u0e32\u0e01\u0e2a\u0e20\u0e32\u0e1e\u0e2d\u0e32\u0e01\u0e32\u0e28 \u0e15\u0e23\u0e27\u0e08\u0e2a\u0e2d\u0e1a\u0e1b\u0e23\u0e30\u0e2a\u0e34\u0e17\u0e18\u0e34\u0e20\u0e32\u0e1e\u0e01\u0e32\u0e23\u0e43\u0e0a\u0e49\u0e08\u0e48\u0e32\u0e22! \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 3: \u0e25\u0e07\u0e17\u0e38\u0e19\u0e43\u0e19\u0e42\u0e23\u0e07\u0e19\u0e32\u0e17\u0e35\u0e48\u0e21\u0e35\u0e23\u0e30\u0e1a\u0e1a\u0e04\u0e27\u0e1a\u0e04\u0e38\u0e21\u0e2a\u0e20\u0e32\u0e1e\u0e2d\u0e32\u0e01\u0e32\u0e28\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e43\u0e2b\u0e49\u0e41\u0e21\u0e49\u0e01\u0e23\u0e30\u0e17\u0e31\u0e48\u0e07\u0e40\u0e21\u0e37\u0e48\u0e2d\u0e2a\u0e20\u0e32\u0e1e\u0e2d\u0e32\u0e01\u0e32\u0e28\u0e2a\u0e48\u0e07\u0e1c\u0e25\u0e01\u0e23\u0e30\u0e17\u0e1a\u0e15\u0e48\u0e2d\u0e1c\u0e25\u0e1c\u0e25\u0e34\u0e15\u0e02\u0e2d\u0e07\u0e1e\u0e37\u0e0a \u0e01\u0e32\u0e23\u0e1c\u0e25\u0e34\u0e15\u0e2a\u0e32\u0e21\u0e32\u0e23\u0e16\u0e04\u0e07\u0e44\u0e27\u0e49\u0e44\u0e14\u0e49\u0e43\u0e19\u0e23\u0e30\u0e14\u0e31\u0e1a\u0e2a\u0e39\u0e07 \u0e2a\u0e21\u0e38\u0e14\u0e17\u0e32\u0e07\u0e14\u0e32\u0e23\u0e32\u0e28\u0e32\u0e2a\u0e15\u0e23\u0e4c\u0e02\u0e2d\u0e07\u0e0a\u0e32\u0e27\u0e19\u0e32\u0e40\u0e1b\u0e47\u0e19\u0e2a\u0e34\u0e48\u0e07\u0e17\u0e35\u0e48\u0e40\u0e1b\u0e25\u0e35\u0e48\u0e22\u0e19\u0e41\u0e1b\u0e25\u0e07\u0e40\u0e01\u0e21!"}, {"question": "\u0e01\u0e32\u0e23\u0e2a\u0e33\u0e23\u0e27\u0e08\u0e25\u0e36\u0e01 Crazy Cattle 3D: \u0e2a\u0e39\u0e15\u0e23\u0e1e\u0e37\u0e49\u0e19\u0e10\u0e32\u0e19\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e01\u0e32\u0e23\u0e04\u0e33\u0e19\u0e27\u0e13\u0e01\u0e32\u0e23\u0e1c\u0e25\u0e34\u0e15\u0e19\u0e21 \u0e42\u0e14\u0e22\u0e1e\u0e34\u0e08\u0e32\u0e23\u0e13\u0e32\u0e08\u0e32\u0e01\u0e1b\u0e31\u0e08\u0e08\u0e31\u0e22\u0e15\u0e48\u0e32\u0e07\u0e46 \u0e40\u0e0a\u0e48\u0e19 \u0e04\u0e27\u0e32\u0e21\u0e2a\u0e38\u0e02\u0e02\u0e2d\u0e07\u0e27\u0e31\u0e27 \u0e2a\u0e32\u0e22\u0e1e\u0e31\u0e19\u0e18\u0e38\u0e4c \u0e41\u0e25\u0e30\u0e23\u0e30\u0e14\u0e31\u0e1a\u0e42\u0e20\u0e0a\u0e19\u0e32\u0e01\u0e32\u0e23\u0e04\u0e37\u0e2d\u0e2d\u0e30\u0e44\u0e23?", "answer": "\u0e2a\u0e39\u0e15\u0e23\u0e01\u0e32\u0e23\u0e1c\u0e25\u0e34\u0e15\u0e19\u0e21\u0e43\u0e19 Crazy Cattle 3D \u0e19\u0e31\u0e49\u0e19\u0e0b\u0e31\u0e1a\u0e0b\u0e49\u0e2d\u0e19 \u0e41\u0e15\u0e48\u0e01\u0e32\u0e23\u0e17\u0e33\u0e04\u0e27\u0e32\u0e21\u0e40\u0e02\u0e49\u0e32\u0e43\u0e08\u0e2d\u0e07\u0e04\u0e4c\u0e1b\u0e23\u0e30\u0e01\u0e2d\u0e1a\u0e2b\u0e25\u0e31\u0e01\u0e08\u0e30\u0e1b\u0e25\u0e14\u0e25\u0e47\u0e2d\u0e01\u0e1b\u0e23\u0e30\u0e2a\u0e34\u0e17\u0e18\u0e34\u0e20\u0e32\u0e1e\u0e2a\u0e39\u0e07\u0e2a\u0e38\u0e14 \u0e1c\u0e25\u0e1c\u0e25\u0e34\u0e15\u0e1e\u0e37\u0e49\u0e19\u0e10\u0e32\u0e19 = \u0e15\u0e31\u0e27\u0e04\u0e39\u0e13\u0e2a\u0e32\u0e22\u0e1e\u0e31\u0e19\u0e18\u0e38\u0e4c * \u0e1b\u0e31\u0e08\u0e08\u0e31\u0e22\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e38\u0e02 * \u0e23\u0e30\u0e14\u0e31\u0e1a\u0e42\u0e20\u0e0a\u0e19\u0e32\u0e01\u0e32\u0e23 * \u0e15\u0e31\u0e27\u0e1b\u0e23\u0e31\u0e1a\u0e40\u0e1b\u0e25\u0e35\u0e48\u0e22\u0e19\u0e2a\u0e38\u0e02\u0e20\u0e32\u0e1e \u0e15\u0e31\u0e27\u0e04\u0e39\u0e13\u0e2a\u0e32\u0e22\u0e1e\u0e31\u0e19\u0e18\u0e38\u0e4c: \u0e27\u0e31\u0e27\u0e42\u0e2e\u0e25\u0e2a\u0e44\u0e15\u0e19\u0e4c\u0e21\u0e35\u0e04\u0e48\u0e32\u0e2a\u0e39\u0e07\u0e2a\u0e38\u0e14 (\u0e40\u0e0a\u0e48\u0e19 1.2) \u0e43\u0e19\u0e02\u0e13\u0e30\u0e17\u0e35\u0e48\u0e27\u0e31\u0e27\u0e40\u0e08\u0e2d\u0e23\u0e4c\u0e0b\u0e35\u0e22\u0e4c\u0e2d\u0e32\u0e08\u0e21\u0e35\u0e04\u0e48\u0e32\u0e15\u0e48\u0e33\u0e01\u0e27\u0e48\u0e32 (\u0e40\u0e0a\u0e48\u0e19 1.0) \u0e1b\u0e31\u0e08\u0e08\u0e31\u0e22\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e38\u0e02: \u0e2d\u0e22\u0e39\u0e48\u0e43\u0e19\u0e0a\u0e48\u0e27\u0e07\u0e15\u0e31\u0e49\u0e07\u0e41\u0e15\u0e48 0.8 (\u0e44\u0e21\u0e48\u0e2a\u0e38\u0e02\u0e21\u0e32\u0e01) \u0e16\u0e36\u0e07 1.2 (\u0e21\u0e35\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e38\u0e02\u0e21\u0e32\u0e01) \u0e23\u0e30\u0e14\u0e31\u0e1a\u0e42\u0e20\u0e0a\u0e19\u0e32\u0e01\u0e32\u0e23: \u0e43\u0e19\u0e17\u0e33\u0e19\u0e2d\u0e07\u0e40\u0e14\u0e35\u0e22\u0e27\u0e01\u0e31\u0e19\u0e2d\u0e22\u0e39\u0e48\u0e23\u0e30\u0e2b\u0e27\u0e48\u0e32\u0e07 0.7 \u0e16\u0e36\u0e07 1.2 \u0e02\u0e36\u0e49\u0e19\u0e2d\u0e22\u0e39\u0e48\u0e01\u0e31\u0e1a\u0e04\u0e38\u0e13\u0e20\u0e32\u0e1e\u0e02\u0e2d\u0e07\u0e2d\u0e32\u0e2b\u0e32\u0e23 \u0e15\u0e31\u0e27\u0e1b\u0e23\u0e31\u0e1a\u0e40\u0e1b\u0e25\u0e35\u0e48\u0e22\u0e19\u0e2a\u0e38\u0e02\u0e20\u0e32\u0e1e: \u0e42\u0e23\u0e04\u0e41\u0e25\u0e30\u0e42\u0e23\u0e04\u0e2d\u0e37\u0e48\u0e19\u0e46 \u0e08\u0e30\u0e2a\u0e48\u0e07\u0e1c\u0e25\u0e40\u0e2a\u0e35\u0e22\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e23\u0e49\u0e32\u0e22\u0e41\u0e23\u0e07\u0e15\u0e48\u0e2d\u0e1c\u0e25\u0e1c\u0e25\u0e34\u0e15\u0e19\u0e21 (\u0e40\u0e0a\u0e48\u0e19 -3) \u0e42\u0e1b\u0e23\u0e14\u0e2d\u0e49\u0e32\u0e07\u0e2d\u0e34\u0e07\u0e01\u0e31\u0e1a\u0e04\u0e39\u0e48\u0e21\u0e37\u0e2d\u0e40\u0e01\u0e21\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e40\u0e1b\u0e47\u0e19\u0e17\u0e32\u0e07\u0e01\u0e32\u0e23\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e40\u0e23\u0e35\u0e22\u0e19\u0e23\u0e39\u0e49\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e40\u0e15\u0e34\u0e21"}, {"question": "\u0e2a\u0e16\u0e34\u0e15\u0e34\u0e27\u0e31\u0e27\u0e17\u0e35\u0e48\u0e0b\u0e48\u0e2d\u0e19\u0e2d\u0e22\u0e39\u0e48 \u0e40\u0e0a\u0e48\u0e19 'aura \u0e2a\u0e07\u0e1a' \u0e2b\u0e23\u0e37\u0e2d '\u0e04\u0e27\u0e32\u0e21\u0e40\u0e23\u0e47\u0e27\u0e43\u0e19\u0e01\u0e32\u0e23\u0e43\u0e2b\u0e49\u0e19\u0e21' \u0e21\u0e35\u0e1c\u0e25\u0e15\u0e48\u0e2d\u0e01\u0e32\u0e23\u0e40\u0e25\u0e48\u0e19 Crazy Cattle 3D \u0e2d\u0e22\u0e48\u0e32\u0e07\u0e44\u0e23 \u0e41\u0e25\u0e30\u0e2a\u0e32\u0e21\u0e32\u0e23\u0e16\u0e08\u0e31\u0e14\u0e01\u0e32\u0e23\u0e44\u0e14\u0e49\u0e2b\u0e23\u0e37\u0e2d\u0e44\u0e21\u0e48?", "answer": "\u0e2a\u0e16\u0e34\u0e15\u0e34\u0e27\u0e31\u0e27\u0e17\u0e35\u0e48\u0e0b\u0e48\u0e2d\u0e19\u0e40\u0e23\u0e49\u0e19\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e04\u0e27\u0e32\u0e21\u0e25\u0e36\u0e01\u0e43\u0e19 Crazy Cattle 3D \u0e04\u0e27\u0e32\u0e21\u0e40\u0e23\u0e47\u0e27\u0e43\u0e19\u0e01\u0e32\u0e23\u0e43\u0e2b\u0e49\u0e19\u0e21\u0e2a\u0e48\u0e07\u0e1c\u0e25\u0e15\u0e48\u0e2d\u0e04\u0e27\u0e32\u0e21\u0e40\u0e23\u0e47\u0e27\u0e43\u0e19\u0e01\u0e32\u0e23\u0e40\u0e01\u0e47\u0e1a\u0e19\u0e21\u0e23\u0e30\u0e2b\u0e27\u0e48\u0e32\u0e07\u0e40\u0e
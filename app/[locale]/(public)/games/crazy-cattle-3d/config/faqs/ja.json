[{"question": "\u30af\u30ec\u30a4\u30b8\u30fc\u30fb\u30ad\u30e3\u30c3\u30b9\u30eb3D\uff1a\u30b2\u30fc\u30e0\u3092\u59cb\u3081\u305f\u3070\u304b\u308a\u306e\u3068\u304d\u306b\u3001\u79fb\u52d5\u3084\u643e\u4e73\u306a\u3069\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u3069\u306e\u3088\u3046\u306b\u5b9f\u884c\u3057\u307e\u3059\u304b\uff1f", "answer": "\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u3057\u3066\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u91cd\u8981\u3067\u3059\u3002\u725b\u306e\u79fb\u52d5\u306f\u3001WASD\u30ad\u30fc\u3092\u4f7f\u7528\u3057\u3066\u65b9\u5411\u8ee2\u63db\u3057\u307e\u3059\u3002\u643e\u4e73\u306f\u901a\u5e38\u3001\u300eE\u300f\u30ad\u30fc\u306b\u5272\u308a\u5f53\u3066\u3089\u308c\u3066\u3044\u307e\u3059\u3002\u643e\u4e73\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\uff08\u30df\u30eb\u30af\u306e\u3057\u305a\u304f\u306e\u3042\u308b\u725b\u306e\u30a2\u30a4\u30b3\u30f3\u3067\u793a\u3055\u308c\u307e\u3059\uff09\u306b\u8fd1\u3065\u304d\u3001\u300eE\u300f\u3092\u62bc\u3059\u3068\u643e\u4e73\u3092\u958b\u59cb\u3057\u307e\u3059\u3002\u30df\u30cb\u30b2\u30fc\u30e0\u3067\u306f\u3001\u6700\u5927\u53ce\u91cf\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u30af\u30ea\u30c3\u30af\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u591a\u304f\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30de\u30a6\u30b9\u306e\u611f\u5ea6\u3092\u8abf\u6574\u3059\u308b\u3053\u3068\u3067\u3001\u30df\u30eb\u30af\u306e\u751f\u7523\u6027\u304c\u5411\u4e0a\u3059\u308b\u3053\u3068\u3092\u767a\u898b\u3057\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u30aa\u30fc\u30eb\u30c9\u30fb\u30de\u30af\u30c9\u30ca\u30eb\u30c9\u7267\u5834\u300f\u3092\u8a2a\u308c\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u5e38\u306b\u5b8c\u5168\u306b\u6a5f\u80fd\u7684\u306a\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7\u304c\u3042\u308a\u307e\u3059\uff01"}, {"question": "\u30af\u30ec\u30a4\u30b8\u30fc\u30fb\u30ad\u30e3\u30c3\u30b9\u30eb3D\u3067\u521d\u5fc3\u8005\u304c\u3059\u3050\u306b\u30e2\u30aa\u30e9\u3092\u7372\u5f97\u3057\u3001\u30b2\u30fc\u30e0\u5e8f\u76e4\u306e\u3069\u306e\u6295\u8cc7\u304c\u6700\u5927\u306e\u53ce\u76ca\u3092\u3082\u305f\u3089\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30af\u30ec\u30a4\u30b8\u30fc\u30fb\u30ad\u30e3\u30c3\u30b9\u30eb3D\u3067\u521d\u671f\u6bb5\u968e\u3067\u9ad8\u901f\u306a\u30e2\u30aa\u30e9\u7372\u5f97\u306e\u305f\u3081\u306b\u306f\u3001\u521d\u671f\u306e\u30af\u30a8\u30b9\u30c8\u306e\u5b8c\u4e86\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30d5\u30a1\u30fc\u30de\u30fc\u30fb\u30b8\u30e3\u30a4\u30eb\u30ba\u304c\u4e0e\u3048\u308b\u30af\u30a8\u30b9\u30c8\u3092\u512a\u5148\u3057\u307e\u3057\u3087\u3046\uff01\u305d\u308c\u3089\u306f\u521d\u671f\u6bb5\u968e\u3067\u5927\u304d\u306a\u5831\u916c\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u8cc7\u91d1\u3092\u5f97\u305f\u3089\u3001\u9ad8\u901f\u306a\u643e\u4e73\u6a5f\u68b0\u306b\u6295\u8cc7\u3057\u307e\u3057\u3087\u3046\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u30df\u30eb\u30af\u751f\u7523\u901f\u5ea6\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u3001\u76f4\u63a5\u7684\u306a\u53ce\u5165\u5897\u52a0\u306b\u7e4b\u304e\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u521d\u671f\u6bb5\u968e\u3067\u9ad8\u3044\u53ce\u91cf\u306e\u725b\u306e\u7e41\u6b96\u3092\u691c\u8a0e\u3057\u307e\u3057\u3087\u3046\u3002\u30e1\u30a4\u30f3\u30b2\u30fc\u30e0\u30e1\u30cb\u30e5\u30fc\u306e\u725b\u54c1\u7a2e\u6bd4\u8f03\u8868\u3092\u53c2\u7167\u3057\u3066\u3001\u8a73\u7d30\u306a\u7d71\u8a08\u60c5\u5831\u3092\u78ba\u8a8d\u3057\u307e\u3057\u3087\u3046\u3002\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u30a2\u30d7\u30ed\u30fc\u30c1\u306e\u305f\u3081\u306b\u30b8\u30e3\u30fc\u30b8\u30fc\u7a2e\u304b\u3089\u59cb\u3081\u308b\u3053\u3068\u3092\u691c\u8a0e\u3057\u307e\u3057\u3087\u3046\u3002\u9ad8\u901f\u306a\u6a5f\u68b0\u3068\u826f\u8cea\u306a\u725b\u306f\u3001\u521d\u671f\u6295\u8cc7\u306b\u9069\u3057\u3066\u3044\u307e\u3059\u3002"}, {"question": "\u30af\u30ec\u30a4\u30b8\u30fc\u30fb\u30ad\u30e3\u30c3\u30b9\u30eb3D\u3067\u3001\u306a\u305c\u725b\u304c\u6642\u3005\u643e\u4e73\u3092\u62d2\u5426\u3059\u308b\u306e\u3067\u3059\u304b\uff1f\u30d0\u30b0\u3067\u3059\u304b\u3001\u305d\u308c\u3068\u3082\u6b20\u843d\u3057\u3066\u3044\u308b\u30e1\u30ab\u30cb\u30ba\u30e0\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u843d\u3061\u7740\u3044\u3066\uff01\u5fc5\u305a\u3057\u3082\u30d0\u30b0\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u725b\u306e\u6c17\u5206\u306f\u3001\u30df\u30eb\u30af\u306e\u751f\u7523\u6027\u3068\u5354\u529b\u306b\u5927\u304d\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u307e\u305a\u3001\u30b9\u30c8\u30ec\u30b9\u306f\u5927\u304d\u306a\u5f79\u5272\u3092\u679c\u305f\u3057\u307e\u3059\u3002\u725b\u304c\u990c\u5165\u308c\uff08\u990c\u5165\u308c\u30a2\u30a4\u30b3\u30f3\u3067\u793a\u3055\u308c\u307e\u3059\uff09\u3068\u6c34\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3057\u3087\u3046\u3002\u6b21\u306b\u3001\u6e05\u6f54\u306a\u74b0\u5883\u304c\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u30da\u30f3\u3092\u5b9a\u671f\u7684\u306b\u304d\u308c\u3044\u306b\u3059\u308c\u3070\u3001\u6c17\u5206\u304c\u5411\u4e0a\u3057\u307e\u3059\uff08\u30b7\u30e7\u30d9\u30eb\u30c4\u30fc\u30eb\u3092\u4f7f\u7528\uff09\u3002\u7b2c\u4e09\u306b\u3001\u75c5\u6c17\u306e\u6709\u7121\u3092\u30c1\u30a7\u30c3\u30af\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u725b\u306e\u8996\u899a\u7684\u306a\u5146\u5019\u3092\u78ba\u8a8d\u3057\u3001\u5fc5\u8981\u3067\u3042\u308c\u3070\u85ac\u3092\u6295\u4e0e\u3057\u307e\u3057\u3087\u3046\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u30c7\u30a4\u30b8\u30fc\u300f\u3068\u3044\u3046\u725b\u306f\u3001\u5f7c\u5973\u306e\u30da\u30f3\u304c\u5b9a\u671f\u7684\u306b\u6e05\u6383\u3055\u308c\u306a\u304b\u3063\u305f\u306e\u3067\u3001\u30df\u30eb\u30af\u306e\u751f\u7523\u3092\u505c\u6b62\u3057\u307e\u3057\u305f\u3002\u6e05\u6f54\u3055\u306f\u795e\u8056\u3067\u3059\u3002"}, {"question": "\u30af\u30ec\u30a4\u30b8\u30fc\u30ad\u30e3\u30c3\u30b9\u30eb3D\u306e\u9ad8\u5ea6\u306a\u6226\u7565\uff1a\u7af6\u4e89\u529b\u306e\u3042\u308b\u30e2\u30aa\u30e9\u751f\u6210\u306b\u6700\u9069\u306a\u725b\u306e\u7a2e\u985e\u306f\u4f55\u3067\u3059\u304b\u3001\u305d\u3057\u3066\u3069\u306e\u3088\u3046\u306a\u9ad8\u5ea6\u306a\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u624b\u6cd5\u3067\u751f\u7523\u6027\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30af\u30ec\u30a4\u30b8\u30fc\u30fb\u30ad\u30e3\u30c3\u30b9\u30eb3D\u3067\u6700\u5927\u9650\u306e\u30e2\u30aa\u30e9\u7372\u5f97\u306e\u305f\u3081\u306b\u306f\u3001\u725b\u306e\u7a2e\u985e\u3068\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u306e\u6700\u5927\u5316\u304c\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u30db\u30eb\u30b9\u30bf\u30a4\u30f3\u7a2e\u306f\u3001\u30b3\u30a2\u5229\u76ca\u306e\u4e57\u6570\u3068\u3057\u3066\u6700\u9ad8\u306e\u30df\u30eb\u30af\u91cf\u3092\u63d0\u4f9b\u3057\u307e\u3059\u304c\u3001\u304b\u306a\u308a\u306e\u6295\u8cc7\u304c\u5fc5\u8981\u3067\u3059\u3002\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u306b\u306f\u3001\u8eab\u4f53\u7684\u304a\u3088\u3073\u7cbe\u795e\u7684\u306a\u523a\u6fc0\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u7267\u5834\u306e\u30c8\u30ec\u30c3\u30c9\u30df\u30eb\u3092\u4f7f\u7528\u3057\u3066\u3001\u6bce\u65e5\u306e\u904b\u52d5\u30b9\u30b1\u30b8\u30e5\u30fc\u30eb\u3092\u5b9f\u65bd\u3057\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u30b9\u30bf\u30df\u30ca\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6804\u990a\u306f\u5927\u304d\u306a\u5f79\u5272\u3092\u679c\u305f\u3057\u307e\u3059\u3002\u6700\u9069\u306a\u53ce\u91cf\u306e\u305f\u3081\u306b\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u53d6\u308c\u305f\u98fc\u6599\u30da\u30ec\u30c3\u30c8\u306e\u6df7\u5408\u7269\u3092\u4f5c\u6210\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5f37\u3044\u7d46\u3092\u7bc9\u304f\u3053\u3068\u306b\u6642\u9593\u3092\u6295\u8cc7\u3057\u307e\u3057\u3087\u3046\u3002\u5e78\u305b\u306a\u725b\u306f\u3082\u3063\u3068\u30df\u30eb\u30af\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u3053\u3046\u8003\u3048\u307e\u3057\u3087\u3046\u3002\u5e78\u305b\u306a\u725b\u307b\u3069\u5229\u76ca\u304c\u591a\u304f\u306a\u308a\u3001\u5229\u76ca\u304c\u591a\u304f\u306a\u308c\u3070\u3055\u3089\u306b\u5e78\u305b\u306a\u725b\u306b\u306a\u308a\u307e\u3059\uff01"}, {"question": "\u30af\u30ec\u30a4\u30b8\u30fc\u30fb\u30ad\u30e3\u30c3\u30b9\u30eb3D\uff1a\u7279\u306b\u643e\u4e73\u6642\u9593\u5e2f\u306e\u30dc\u30c8\u30eb\u30cd\u30c3\u30af\u3092\u51e6\u7406\u3059\u308b\u305f\u3081\u306b\u3001\u52b9\u7387\u3068\u725b\u306e\u5e78\u798f\u3092\u6700\u5927\u5316\u3059\u308b\u3088\u3046\u306b\u7267\u5834\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u7267\u5834\u30ec\u30a4\u30a2\u30a6\u30c8\u306e\u6700\u9069\u5316\u306f\u3001\u30af\u30ec\u30a4\u30b8\u30fc\u30fb\u30ad\u30e3\u30c3\u30b9\u30eb3D\u306b\u304a\u3051\u308b\u52b9\u7387\u5316\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u725b\u306e\u79fb\u52d5\u8ddd\u96e2\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u307e\u3057\u3087\u3046\u3002\u990c\u3084\u308a\u5834\u3068\u6c34\u98f2\u307f\u5834\u3092\u643e\u4e73\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u306e\u8fd1\u304f\u306b\u914d\u7f6e\u3057\u307e\u3057\u3087\u3046\u3002\u6b21\u306b\u3001\u7279\u306b\u643e\u4e73\u30a8\u30ea\u30a2\u5468\u8fba\u3067\u30dc\u30c8\u30eb\u30cd\u30c3\u30af\u3092\u56de\u907f\u3059\u308b\u305f\u3081\u306b\u3001\u4e00\u65b9\u901a\u884c\u306e\u4ea4\u901a\u306e\u6d41\u308c\u3092\u5b9f\u88c5\u3057\u307e\u3057\u3087\u3046\u3002\u30d5\u30a7\u30f3\u30b9\u3092\u6226\u7565\u7684\u306b\u4f7f\u7528\u3059\u308b\u4e8b\u3082\u8003\u616e\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u7b2c\u4e09\u306b\u3001\u643e\u4e73\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u307e\u3057\u3087\u3046\u3002\u3088\u308a\u9ad8\u54c1\u8cea\u306e\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u306f\u3001\u3088\u308a\u591a\u304f\u306e\u91cf\u3092\u51e6\u7406\u3067\u304d\u307e\u3059\u3002\u4f8b\uff1a\u300e\u30b5\u30f3\u30bb\u30c3\u30c8\u30d5\u30a1\u30fc\u30e0\u300f\u306e\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u30a2\u30eb\u30d5\u30a1\u8fd1\u304f\u306e\u7d66\u6c34\u5834\u306e\u5834\u6240\u3092\u79fb\u52d5\u3055\u305b\u308b\u3053\u3068\u3067\u3001\u643e\u4e73\u52b9\u7387\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3057\u305f\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u751f\u7523\u6027\u304c20%\u5897\u52a0\u3057\u3001\u6700\u7d42\u7684\u306b\u306f\u52b9\u7387\u7684\u306a\u643e\u4e73\u306b\u3088\u308a\u725b\u3082\u5e78\u305b\u306b\u306a\u308a\u307e\u3057\u305f"}, {"question": "\u30af\u30ec\u30a4\u30b8\u30fc\u30fb\u30ad\u30e3\u30c3\u30b9\u30eb3D\u3067\u3001\u725b\u306e\u98fc\u6599\u306b\u4f7f\u7528\u3055\u308c\u308b\u4f5c\u7269\u306e\u53ce\u91cf\u3092\u6700\u5927\u5316\u3059\u308b\u305f\u3081\u306b\u3001\u6c17\u8c61\u30b7\u30b9\u30c6\u30e0\u3092\u6d3b\u7528\u3059\u308b\u96a0\u308c\u305f\u6226\u7565\u306f\u3042\u308a\u307e\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u306f\u30df\u30eb\u30af\u751f\u7523\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30af\u30ec\u30a4\u30b8\u30fc\u30fb\u30ad\u30e3\u30c3\u30b9\u30eb3D\u3092\u30d7\u30ec\u30a4\u3059\u308b\u969b\u306b\u306f\u3001\u5929\u5019\u3092\u77e5\u308b\u3053\u3068\u306f\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\uff01\u96e8\u3092\u597d\u3080\u4f5c\u7269\uff08\u30af\u30ed\u30fc\u30d0\u30fc\uff09\u3092\u96e8\u5b63\u306b\u3001\u8010\u65f1\u6027\u306e\u4f5c\u7269\uff08\u30a2\u30eb\u30d5\u30a1\u30eb\u30d5\u30a1\uff09\u3092\u65e5\u5dee\u3057\u304c\u5f37\u3044\u6642\u671f\u306b\u690d\u3048\u308b\u3053\u3068\u3067\u3001\u4f5c\u7269\u306e\u53ce\u91cf\u3092\u6700\u9069\u5316\u3057\u307e\u3057\u3087\u3046\uff01\u30b9\u30c6\u30c3\u30d71\uff1a\u7267\u5834\u306b\u6c17\u8c61\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u3092\u8a2d\u7f6e\u3057\u3066\u3001\u4e88\u6e2c\u306e\u7cbe\u5ea6\u3092\u9ad8\u3081\u307e\u3057\u3087\u3046\u3002\u4f5c\u7269\u306e\u9078\u629e\u306f\u3001\u4e88\u6e2c\u306b\u57fa\u3065\u3044\u3066\u884c\u3046\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5929\u5019\u306e\u305f\u3081\u306b\u4f5c\u7269\u306e\u53ce\u91cf\u304c\u60aa\u304f\u306a\u308a\u305d\u3046\u306a\u6642\u306b\u3001\u5e02\u5834\u3067\u8cfc\u5165\u3057\u3066\u4f5c\u7269\u3092\u88dc\u7d66\u3057\u307e\u3057\u3087\u3046\u3002\u30b3\u30b9\u30c8\u52b9\u7387\u3092\u8a55\u4fa1\u3057\u3066\u304f\u3060\u3055\u3044\uff01\u30b9\u30c6\u30c3\u30d73\uff1a\u5929\u5019\u304c\u4f5c\u7269\u306e\u53ce\u91cf\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u3066\u3082\u3001\u9ad8\u3044\u30ec\u30d9\u30eb\u3067\u306e\u751f\u7523\u3092\u7dad\u6301\u3067\u304d\u308b\u3088\u3046\u306b\u3001\u6c17\u5019\u5236\u5fa1\u3055\u308c\u305f\u7267\u820e\u306b\u6295\u8cc7\u3057\u307e\u3057\u3087\u3046\u3002\u8fb2\u5bb6\u306e\u30cf\u30f3\u30c9\u30d6\u30c3\u30af\u306f\u30b2\u30fc\u30e0\u3092\u5909\u3048\u308b\u3082\u306e\u3067\u3059\u3002"}, {"question": "\u30af\u30ec\u30a4\u30b8\u30fc\u30fb\u30ad\u30e3\u30c3\u30b9\u30eb3D\u306e\u8a73\u7d30\uff1a\u725b\u306e\u5e78\u798f\u3001\u54c1\u7a2e\u3001\u6804\u990a\u30ec\u30d9\u30eb\u3068\u3044\u3063\u305f\u8981\u56e0\u3092\u8003\u616e\u3057\u3066\u3001\u30df\u30eb\u30af\u751f\u7523\u3092\u8a08\u7b97\u3059\u308b\u305f\u3081\u306e\u57fa\u790e\u7684\u306a\u5f0f\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30af\u30ec\u30a4\u30b8\u30fc\u30fb\u30ad\u30e3\u30c3\u30b9\u30eb3D\u306e\u30df\u30eb\u30af\u751f\u7523\u5f0f\u306f\u8907\u96d1\u3067\u3059\u304c\u3001\u30b3\u30a2\u30b3\u30f3\u30dd\u30fc\u30cd\u30f3\u30c8\u3092\u7406\u89e3\u3059\u308c\u3070\u3001\u6700\u5927\u52b9\u7387\u3092\u89e3\u304d\u653e\u3064\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u57fa\u672c\u751f\u7523\u91cf\uff1d\u54c1\u7a2e\u4e57\u6570\u00d7\u5e78\u798f\u5ea6\u4fc2\u6570\u00d7\u6804\u990a\u30ec\u30d9\u30eb\u00d7\u5065\u5eb7\u5ea6\u4fee\u6b63\u4fc2\u6570\u3002\u54c1\u7a2e\u4e57\u6570\uff1a\u30db\u30eb\u30b9\u30bf\u30a4\u30f3\u7a2e\u306f\u6700\u9ad8\u5024\uff08\u4f8b\uff1a1.2\uff09\u3092\u6301\u3061\u307e\u3059\u3002\u4e00\u65b9\u3001\u30b8\u30e3\u30fc\u30b8\u30fc\u7a2e\u306f\u4f4e\u3044\u5024\uff08\u4f8b\uff1a1.0\uff09\u3092\u6301\u3064\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u5e78\u798f\u5ea6\u4fc2\u6570\uff1a\u975e\u5e38\u306b\u4e0d\u5e78\u306a\u72b6\u614b\u3067\u306f0.8\u304b\u3089\u3001\u975e\u5e38\u306b\u5e78\u305b\u306a\u72b6\u614b\u3067\u306f1.2\u307e\u3067\u5909\u5316\u3057\u307e\u3059\u3002\u6804\u990a\u30ec\u30d9\u30eb\uff1a\u540c\u69d8\u306b\u3001\u98df\u3079\u7269\u306e\u8cea\u306b\u57fa\u3065\u3044\u30660.7\u304b\u30891.2\u307e\u3067\u5909\u5316\u3057\u307e\u3059\u3002\u5065\u5eb7\u5ea6\u4fee\u6b63\u4fc2\u6570\uff1a\u75c5\u6c17\u3084\u305d\u306e\u4ed6\u306e\u75c5\u6c17\u306f\u3001\u30df\u30eb\u30af\u751f\u7523\u30ec\u30d9\u30eb\u306b\u6df1\u523b\u306a\u60aa\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\uff08\u4f8b\uff1a-3\uff09\u3002\u8a73\u7d30\u306b\u3064\u3044\u3066\u306f\u3001\u516c\u5f0f\u30b2\u30fc\u30e0\u30ac\u30a4\u30c9\u3092\u53c2\u7167\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30af\u30ec\u30a4\u30b8\u30fc\u30fb\u30ad\u30e3\u30c3\u30b9\u30eb3D\u3067\u300e\u93ae\u9759\u30aa\u30fc\u30e9\u300f\u3084\u300e\u30df\u30eb\u30af\u901f\u5ea6\u300f\u306a\u3069\u306e\u96a0\u3055\u308c\u305f\u725b\u306e\u7d71\u8a08\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u3046\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f\u64cd\u7e26\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u96a0\u3055\u308c\u305f\u725b\u306e\u7d71\u8a08\u306f\u3001\u30af\u30ec\u30a4\u30b8\u30fc\u30fb\u30ad\u30e3\u30c3\u30b9\u30eb3D\u306b\u5965\u884c\u304d\u3092\u4e0e\u3048\u307e\u3059\u3002\u30df\u30eb\u30af\u901f\u5ea6\u306f\u3001\u643e\u4e73\u30df\u30cb\u30b2\u30fc\u30e0\u4e2d\u306b\u30df\u30eb\u30af\u304c\u53ce\u96c6\u3055\u308c\u308b\u901f\u5ea6\u306b\u5f71\u97ff\u3057\u307e\u3059\u3002\u93ae\u9759\u30aa\u30fc\u30e9\u306f\u3001\u8fd1\u96a3\u306e\u725b\u306e\u30b9\u30c8\u30ec\u30b9\u30ec\u30d9\u30eb\u3092\u8efd\u6e1b\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u7d71\u8a08\u3092\u76f4\u63a5\u78ba\u8a8d\u3059\u308b\u3053\u3068\u306f\u3067\u304d\u307e\u305b\u3093\u304c\u3001\u7279\u5b9a\u306e\u884c\u52d5\u306b\u3088\u308a\u305d\u308c\u3089\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u93ae\u9759\u5674\u6c34\u300d\u3092\u725b\u306e\u8fd1\u304f\u306b\u5efa\u8a2d\u3059\u308b\u3053\u3068\u3067\u3001\u7d71\u8a08\u7684\u306b\u5f7c\u3089\u306e\u93ae\u9759\u30aa\u30fc\u30e9\u306f\u5411\u4e0a\u3057\u307e\u3059\u3002\u9ad8\u30ec\u30d9\u30eb\u306e\u907a\u4f1d\u5b50\u3068\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u3001\u30df\u30eb\u30af\u901f\u5ea6\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u79d8\u5bc6\u306e\u7d71\u8a08\u3092\u3001\u7279\u5b9a\u306e\u884c\u52d5\u306b\u5831\u3044\u308b\u96a0\u308c\u5909\u6570\u3068\u8003\u3048\u3001\u591a\u69d8\u306a\u8fb2\u5834\u30c7\u30b6\u30a4\u30f3\u3092\u63a8\u5968\u3057\u307e\u3057\u3087\u3046\uff01\u8272\u3005\u306a\u8fb2\u5834\u30c7\u30b6\u30a4\u30f3\u3092\u8a66\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\uff01"}, {"question": "\u30af\u30ec\u30a4\u30b8\u30fc\u30fb\u30ad\u30e3\u30c3\u30b9\u30eb3D\uff1aPC\u7248\u3068\u30e2\u30d0\u30a4\u30eb\u7248\u306e\u9593\u3067\u3001\u7279\u306b\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u3068\u9032\u6357\u72b6\u6cc1\u306b\u95a2\u3057\u3066\u3001\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u4e92\u63db\u6027\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30af\u30ec\u30a4\u30b8\u30fc\u30fb\u30ad\u30e3\u30c3\u30b9\u30eb3D\u306e\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u306f\u3001PC\u7248\u3068\u30e2\u30d0\u30a4\u30eb\u7248\u306e\u9593\u3067\u3001\u30b2\u30fc\u30e0\u30d5\u30a1\u30a4\u30eb\u306e\u69cb\u9020\u306e\u9055\u3044\u306e\u305f\u3081\u3001\u8ee2\u9001\u3067\u304d\u307e\u305b\u3093\u3002\u540c\u69d8\u306b\u3001\u30b2\u30fc\u30e0\u306e\u9032\u6357\u72b6\u6cc1\u3082\u4fdd\u5b58\u3067\u304d\u307e\u305b\u3093\u3002\u4e21\u65b9\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u304c\u30b3\u30a2\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u30eb\u30fc\u30d7\u3092\u5171\u6709\u3057\u3066\u3044\u308b\u4e00\u65b9\u3067\u3001\u69cb\u9020\u306f\u5927\u304d\u304f\u7570\u306a\u308a\u3001\u4e92\u63db\u6027\u3092\u4f4e\u4e0b\u3055\u305b\u3066\u3044\u307e\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u7248\u306f\u3001\u7c21\u7d20\u5316\u3055\u308c\u305f\u30d7\u30ec\u30a4\u3068\u77ed\u3044\u30d7\u30ec\u30a4\u30b9\u30eb\u30fc\u306b\u91cd\u70b9\u3092\u7f6e\u3044\u3066\u3044\u307e\u3059\u3002\u4e00\u65b9\u3001PC\u7248\u306f\u5e83\u5927\u306a\u98a8\u666f\u3092\u30b5\u30dd\u30fc\u30c8\u3067\u304d\u307e\u3059\u3002\u30af\u30e9\u30a6\u30c9\u540c\u671f\u30c4\u30fc\u30eb\u306f\u5c06\u6765\u7d71\u5408\u3055\u308c\u308b\u4e88\u5b9a\u3067\u3059\u3002\u305f\u3060\u3057\u3001\u73fe\u6642\u70b9\u3067\u306f\u5229\u7528\u3067\u304d\u307e\u305b\u3093\u3002"}, {"question": "\u30af\u30ec\u30a4\u30b8\u30fc\u30fb\u30ad\u30e3\u30c3\u30b9\u30eb3D\u306b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3084\u8d85\u30ec\u30a2\u306a\u725b\u306e\u7a2e\u985e\u306f\u3042\u308a\u307e\u3059\u304b\uff1f\u305d\u308c\u3089\u3092\u7372\u5f97\u3059\u308b\u306b\u306f\u3069\u306e\u3088\u3046\u306a\u30c8\u30ea\u30ac\u30fc\u304c\u5fc5\u8981\u3067\u3059\u304b\uff1f", "answer": "\u4f1d\u8aac\u306b\u3088\u308b\u3068\u3001\u30b2\u30fc\u30e0\u5185\u3059\u3079\u3066\u306e\u9054\u6210\u4e8b\u9805\u3092\u5b8c\u4e86\u3057\u3001\u30d5\u30a1\u30fc\u30de\u30fc\u30fb\u30b8\u30e3\u30a4\u30eb\u30ba\u7267\u5834\u306e\u5f8c\u308d\u306b\u3042\u308b\u5186\u5f62\u8fb2\u5730\u3092\u8a2a\u308c\u3001\u30b3\u30fc\u30c9\u300cMOOO-STERIOUS\u300d\u3092\u5165\u529b\u3059\u308b\u3068\u3001\u9280\u6cb3\u30df\u30eb\u30af\u3092\u81ea\u52d5\u7684\u306b\u751f\u6210\u3059\u308b\u300c\u9280\u6cb3\u725b\u300d\u304c\u5f97\u3089\u308c\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\uff01\u4ed6\u306b\u3082\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u3042\u308a\u307e\u3059\u3002\u30d7\u30ec\u30fc\u30e4\u30fc\u306f\u9023\u7d9a\u3057\u306610\u56de\u30e2\u30aa\u30e9\u30b3\u30f3\u30c6\u30b9\u30c8\u3067\u52dd\u5229\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u305d\u306e\u5834\u5408\u3067\u306a\u3044\u3068\u9ec4\u91d1\u306e\u4e73\u9996\u52b9\u679c\u306f\u30a2\u30af\u30c6\u30a3\u30d6\u306b\u306a\u308a\u307e\u305b\u3093\u3002\u5642\u3067\u306f\u3001\u51ac\u306b\u300c\u30ed\u30dc\u30c3\u30c8\u725b\u300d\u304c\u51fa\u73fe\u3059\u308b\u3068\u8a00\u308f\u308c\u3066\u3044\u307e\u3059\uff01"}]
[{"question": "Crazy Cattle 3D\uff1a\u904a\u6232\u525b\u958b\u59cb\u6642\uff0c\u5982\u4f55\u57f7\u884c\u57fa\u672c\u52d5\u4f5c\uff0c\u4f8b\u5982\u79fb\u52d5\u548c\u64e0\u5976\uff1f", "answer": "\u5c0d\u65bc\u65b0\u73a9\u5bb6\u4f86\u8aaa\uff0c\u4e86\u89e3\u57fa\u672c\u63a7\u5236\u65b9\u5f0f\u81f3\u95dc\u91cd\u8981\u3002\u79fb\u52d5\u725b\u96bb\u53ef\u4ee5\u4f7f\u7528 WASD \u9375\u63a7\u5236\u65b9\u5411\u3002\u64e0\u5976\u901a\u5e38\u6620\u5c04\u5230\u300eE\u300f\u9375\u3002\u9760\u8fd1\u64e0\u5976\u7ad9\uff08\u4ee5\u5e36\u6709\u725b\u5976\u6ef4\u843d\u7684\u725b\u5716\u6a19\u6a19\u793a\uff09\uff0c\u6309\u4e0b\u300eE\u300f\u9375\u958b\u59cb\u64e0\u5976\u3002\u5c0f\u578b\u904a\u6232\u53ef\u80fd\u9700\u8981\u60a8\u5728\u6b63\u78ba\u7684\u6642\u9593\u9ede\u64ca\u4ee5\u7372\u5f97\u6700\u5927\u7522\u91cf\u3002\u8a31\u591a\u73a9\u5bb6\u767c\u73fe\u8abf\u6574\u6ed1\u9f20\u9748\u654f\u5ea6\u6709\u52a9\u65bc\u63d0\u9ad8\u725b\u5976\u751f\u7522\u529b\u3002\u4f8b\u5982\uff0c\u5617\u8a66\u9020\u8a2a\u300e\u8001\u9ea5\u53ef\u8fb2\u5834\u300f- \u9019\u88e1\u7e3d\u662f\u6709\u4e00\u500b\u5b8c\u5168\u904b\u4f5c\u7684\u8a2d\u5b9a\uff01"}, {"question": "\u5728Crazy Cattle 3D\u4e2d\uff0c\u65b0\u624b\u5feb\u901f\u8cfa\u53d6\u300c\u54de\u62c9\u300d\u7684\u6700\u4f73\u65b9\u6cd5\u662f\u4ec0\u9ebc\uff1f\u54ea\u4e9b\u904a\u6232\u521d\u671f\u6295\u8cc7\u80fd\u5e36\u4f86\u6700\u5927\u7684\u56de\u5831\uff1f", "answer": "\u5728Crazy Cattle 3D\u7684\u65e9\u671f\u5feb\u901f\u8cfa\u53d6\u300c\u54de\u62c9\u300d\uff0c\u91cd\u9ede\u5728\u65bc\u5b8c\u6210\u521d\u59cb\u4efb\u52d9\u3002\u6b65\u9a5f 1\uff1a\u512a\u5148\u5b8c\u6210\u5409\u723e\u8fb2\u592b\u7d66\u51fa\u7684\u4efb\u52d9\uff01\u5b83\u5011\u5728\u65e9\u671f\u63d0\u4f9b\u8c50\u539a\u7684\u734e\u52f5\u3002\u6b65\u9a5f 2\uff1a\u4e00\u65e6\u8cc7\u91d1\u5230\u4f4d\uff0c\u6295\u8cc7\u901f\u5ea6\u66f4\u5feb\u7684\u64e0\u5976\u6a5f\u3002\u9019\u4e9b\u6a5f\u5668\u6703\u986f\u8457\u63d0\u9ad8\u725b\u5976\u751f\u7522\u901f\u5ea6\uff0c\u76f4\u63a5\u8f49\u5316\u70ba\u66f4\u591a\u6536\u5165\u3002\u6b65\u9a5f 3\uff1a\u5728\u65e9\u671f\u8003\u616e\u98fc\u990a\u9ad8\u7522\u5976\u725b\u3002\u53c3\u95b1\u904a\u6232\u4e3b\u9078\u55ae\u4e2d\u7684\u300c\u5976\u725b\u54c1\u7a2e\u6bd4\u8f03\u5716\u8868\u300d\u4ee5\u77ad\u89e3\u8a73\u7d30\u8cc7\u6599\u3002\u5efa\u8b70\u5f9e\u8377\u65af\u5766\u725b\u958b\u59cb\uff0c\u4ee5\u53d6\u5f97\u5e73\u8861\u7684\u65b9\u6cd5\u3002\u5feb\u901f\u6a5f\u5668\u52a0\u4e0a\u512a\u8cea\u5976\u725b\u662f\u4e00\u500b\u826f\u597d\u7684\u521d\u59cb\u6295\u8cc7\u3002"}, {"question": "\u6211\u7684\u725b\u5728 Crazy Cattle 3D \u4e2d\u70ba\u4ec0\u9ebc\u6709\u6642\u62d2\u7d55\u88ab\u64e0\u5976\uff1f\u662f\u932f\u8aa4\uff0c\u9084\u662f\u6211\u907a\u6f0f\u4e86\u67d0\u500b\u6a5f\u5236\uff1f", "answer": "\u51b7\u975c\u4e00\u4e0b\uff01\u9019\u4e0d\u7e3d\u662f\u932f\u8aa4\u3002\u5976\u725b\u7684\u60c5\u7dd2\u6703\u986f\u8457\u5f71\u97ff\u725b\u5976\u7684\u751f\u7522\u529b\u53ca\u5176\u5408\u4f5c\u7a0b\u5ea6\u3002\u9996\u5148\uff0c\u58d3\u529b\u626e\u6f14\u8457\u4e3b\u8981\u89d2\u8272\u3002\u78ba\u4fdd\u4f60\u7684\u725b\u96bb\u6709\u98df\u7269\uff08\u7531\u98fc\u6599\u69fd\u5716\u6a19\u6a19\u793a\uff09\u548c\u6c34\u3002\u5176\u6b21\uff0c\u4e7e\u6de8\u7684\u74b0\u5883\u81f3\u95dc\u91cd\u8981\u3002\u5b9a\u671f\u6e05\u6f54\u725b\u820d\u53ef\u4ee5\u6539\u5584\u60c5\u7dd2\uff08\u4f7f\u7528\u93df\u5b50\u5de5\u5177\uff09\u3002\u7b2c\u4e09\uff0c\u6aa2\u67e5\u75be\u75c5\u3002\u89c0\u5bdf\u725b\u96bb\u7684\u8996\u89ba\u63d0\u793a\uff0c\u5982\u6709\u9700\u8981\uff0c\u5247\u7d66\u4e88\u85e5\u7269\u3002\u4f8b\u5982\uff0c\u4e00\u96bb\u540d\u53eb\u300c\u9edb\u897f\u300d\u7684\u725b\uff0c\u5982\u679c\u5979\u7684\u725b\u820d\u6c92\u6709\u5b9a\u671f\u6e05\u6f54\uff0c\u5c31\u6703\u505c\u6b62\u7522\u5976\u3002\u6e05\u6f54\u5f88\u91cd\u8981\u3002"}, {"question": "Crazy Cattle 3D \u9032\u968e\u7b56\u7565\uff1a\u54ea\u4e9b\u5976\u725b\u54c1\u7a2e\u6700\u9069\u5408\u7af6\u722d\u300c\u54de\u62c9\u300d\u7522\u751f\uff0c\u4ee5\u53ca\u54ea\u4e9b\u9032\u968e\u8a13\u7df4\u6280\u5de7\u53ef\u4ee5\u6700\u5927\u5316\u5176\u7522\u91cf\uff1f", "answer": "\u5728Crazy Cattle 3D\u4e2d\u7372\u5f97\u6700\u5927\u300c\u54de\u62c9\u300d\uff0c\u5fc5\u9808\u5c07\u5976\u725b\u54c1\u7a2e\u548c\u8a13\u7df4\u6700\u5927\u5316\u3002\u8377\u65af\u5766\u725b\u63d0\u4f9b\u6700\u9ad8\u7684\u725b\u5976\u7522\u91cf\u4f5c\u70ba\u6838\u5fc3\u5229\u6f64\u4e58\u6578\uff0c\u5118\u7ba1\u5b83\u5011\u9700\u8981\u5927\u91cf\u7684\u6295\u8cc7\u3002\u8a13\u7df4\u5305\u62ec\u8eab\u9ad4\u548c\u7cbe\u795e\u4e0a\u7684\u523a\u6fc0\u3002\u6b65\u9a5f 1\uff1a\u5728\u7a40\u5009\u4e2d\u4f7f\u7528\u8dd1\u6b65\u6a5f\u57f7\u884c\u6bcf\u65e5\u904b\u52d5\u8a08\u756b\u3002\u9019\u6703\u589e\u5f37\u9ad4\u529b\u3002\u6b65\u9a5f 2\uff1a\u71df\u990a\u626e\u6f14\u8457\u5de8\u5927\u89d2\u8272\uff1b\u88fd\u4f5c\u5e73\u8861\u7684\u98fc\u6599\u9846\u7c92\u6df7\u5408\u7269\u4ee5\u9054\u5230\u6700\u4f73\u7522\u91cf\u3002\u6b65\u9a5f 3\uff1a\u82b1\u6642\u9593\u5efa\u7acb\u7262\u56fa\u7684\u95dc\u4fc2\u3002\u5feb\u6a02\u7684\u725b\u6703\u7522\u66f4\u591a\u5976\u3002\u60f3\u60f3\u770b\uff0c\u5feb\u6a02\u7684\u725b\u6703\u7522\u751f\u66f4\u591a\u5229\u6f64\uff0c\u800c\u66f4\u591a\u7684\u5229\u6f64\u6703\u8b93\u725b\u8b8a\u5f97\u66f4\u5feb\u6a02\uff01"}, {"question": "Crazy Cattle 3D\uff1a\u5982\u4f55\u512a\u5316\u6211\u7684\u8fb2\u5834\u4f48\u5c40\u4ee5\u6700\u5927\u5316\u6548\u7387\u548c\u725b\u96bb\u5feb\u6a02\uff0c\u5c24\u5176\u662f\u5728\u9ad8\u5cf0\u64e0\u5976\u6642\u9593\u8655\u7406\u74f6\u9838\uff1f", "answer": "\u8fb2\u5834\u4f48\u5c40\u512a\u5316\u5c0d\u65bcCrazy Cattle 3D\u7684\u6548\u7387\u81f3\u95dc\u91cd\u8981\u3002\u5c07\u725b\u96bb\u7684\u79fb\u52d5\u8ddd\u96e2\u964d\u5230\u6700\u4f4e\u3002\u5c07\u98fc\u6599\u548c\u6c34\u6e90\u653e\u7f6e\u5728\u64e0\u5976\u7ad9\u9644\u8fd1\u3002\u7b2c\u4e8c\uff0c\u5be6\u65bd\u55ae\u5411\u4ea4\u901a\u6d41\u91cf\uff0c\u4ee5\u9632\u6b62\u5728\u64e0\u5976\u5340\u57df\u7b49\u5730\u51fa\u73fe\u74f6\u9838\u3002\u8b39\u614e\u4f7f\u7528\u570d\u6b04\u3002\u7b2c\u4e09\uff0c\u5347\u7d1a\u64e0\u5976\u7ad9\u3002\u66f4\u9ad8\u54c1\u8cea\u7684\u64e0\u5976\u7ad9\u53ef\u4ee5\u8655\u7406\u66f4\u9ad8\u7684\u7522\u91cf\u3002\u4f8b\u5982\uff1a\u5c07\u6c34\u69fd\u79fb\u5230\u300e\u65e5\u843d\u8fb2\u5834\u300f\u7684 Alpha \u7ad9\u9644\u8fd1\u5927\u5e45\u63d0\u9ad8\u4e86\u64e0\u5976\u6548\u7387\u3002\u9019\u5c07\u751f\u7522\u7387\u63d0\u9ad8\u4e86 20%\uff0c\u6700\u7d42\u5c0e\u81f4\u5976\u725b\u7531\u65bc\u6548\u7387\u800c\u66f4\u5feb\u6a02\u3002"}, {"question": "\u5728Crazy Cattle 3D\u4e2d\uff0c\u6709\u54ea\u4e9b\u96b1\u85cf\u7b56\u7565\u53ef\u4ee5\u4f7f\u7528\u5929\u6c23\u7cfb\u7d71\u6700\u5927\u5316\u7528\u65bc\u725b\u98fc\u6599\u7684\u4f5c\u7269\u7522\u91cf\uff0c\u4ee5\u53ca\u5b83\u5011\u5982\u4f55\u8f49\u5316\u70ba\u725b\u5976\u751f\u7522\uff1f", "answer": "\u5728\u904a\u6232Crazy Cattle 3D\u4e2d\uff0c\u4e86\u89e3\u5929\u6c23\u662f\u95dc\u9375\uff01\u900f\u904e\u5728\u96e8\u5b63\u7a2e\u690d\u559c\u611b\u4e0b\u96e8\u7684\u4f5c\u7269\uff08\u82dc\u84ff\uff09\uff0c\u5728\u967d\u5149\u660e\u5a9a\u7684\u6642\u5019\u7a2e\u690d\u8010\u65f1\u4f5c\u7269\uff08\u7d2b\u82b1\u82dc\u84ff\uff09\u4f86\u512a\u5316\u4f5c\u7269\u7522\u91cf\uff01\u6b65\u9a5f 1\uff1a\u5728\u60a8\u7684\u8fb2\u5834\u5b89\u88dd\u4e00\u500b\u5929\u6c23\u7ad9\u4ee5\u63d0\u9ad8\u9810\u6e2c\u6e96\u78ba\u5ea6\u3002\u4f5c\u7269\u9078\u64c7\u61c9\u6839\u64da\u9810\u6e2c\u6c7a\u5b9a\u3002\u6b65\u9a5f 2\uff1a\u7576\u4f5c\u7269\u7522\u91cf\u53ef\u80fd\u56e0\u5929\u6c23\u800c\u4f4e\u6642\uff0c\u900f\u904e\u5f9e\u5e02\u5834\u8cfc\u8cb7\u4f86\u88dc\u5145\u4f5c\u7269\u3002\u52d9\u5fc5\u8a55\u4f30\u6210\u672c\u6548\u76ca\uff01\u6b65\u9a5f 3\uff1a\u6295\u8cc7\u5177\u6709\u6c23\u5019\u63a7\u5236\u529f\u80fd\u7684\u7a40\u5009\uff0c\u5373\u4f7f\u5929\u6c23\u6703\u5f71\u97ff\u4f5c\u7269\u7522\u91cf\uff0c\u751f\u7522\u7387\u4e5f\u80fd\u7dad\u6301\u5728\u9ad8\u6c34\u5e73\u3002\u8fb2\u592b\u7684\u66c6\u6cd5\u662f\u5f88\u91cd\u8981\u7684\u3002"}, {"question": "Crazy Cattle 3D \u6df1\u5165\u63a2\u8a0e\uff1a\u8003\u616e\u5976\u725b\u5feb\u6a02\u5ea6\u3001\u54c1\u7a2e\u548c\u71df\u990a\u6c34\u5e73\u7b49\u56e0\u7d20\uff0c\u8a08\u7b97\u725b\u5976\u7522\u91cf\u7684\u57fa\u672c\u516c\u5f0f\u662f\u4ec0\u9ebc\uff1f", "answer": "Crazy Cattle 3D \u4e2d\u7684\u725b\u5976\u751f\u7522\u516c\u5f0f\u8907\u96dc\uff0c\u4f46\u7406\u89e3\u6838\u5fc3\u7d44\u6210\u90e8\u5206\u53ef\u4ee5\u6700\u5927\u5316\u6548\u7387\u3002\u57fa\u672c\u751f\u7522 = \u54c1\u7a2e\u4e58\u6578 * \u5feb\u6a02\u6307\u6578 * \u71df\u990a\u6c34\u5e73 * \u5065\u5eb7\u4fee\u6b63\u4fc2\u6578\u3002\u54c1\u7a2e\u4e58\u6578\uff1a\u8377\u65af\u5766\u725b\u7684\u50f9\u503c\u6700\u9ad8\uff08\u4f8b\u5982 1.2\uff09\uff0c\u800c\u8377\u65af\u5766\u725b\u7684\u50f9\u503c\u53ef\u80fd\u8f03\u4f4e\uff08\u4f8b\u5982 1.0\uff09\u3002\u5feb\u6a02\u6307\u6578\uff1a\u7bc4\u570d\u5f9e 0.8\uff08\u6975\u5ea6\u4e0d\u5feb\u6a02\uff09\u5230 1.2\uff08\u6975\u5ea6\u5feb\u6a02\uff09\u3002\u71df\u990a\u6c34\u5e73\uff1a\u540c\u6a23\u57fa\u65bc\u98df\u7269\u8cea\u91cf\uff0c\u7bc4\u570d\u5f9e 0.7 \u5230 1.2\u3002\u5065\u5eb7\u4fee\u6b63\u4fc2\u6578\uff1a\u75be\u75c5\u548c\u5176\u4ed6\u75be\u75c5\u5c07\u5c0d\u725b\u5976\u7522\u91cf\u7522\u751f\u56b4\u91cd\u7684\u8ca0\u9762\u5f71\u97ff\uff08\u4f8b\u5982 -3\uff09\u3002\u8acb\u53c3\u8003\u5b98\u65b9\u904a\u6232\u6307\u5357\u4e86\u89e3\u66f4\u591a\u8cc7\u8a0a\u3002"}, {"question": "Crazy Cattle 3D\u4e2d\uff0c\u8af8\u5982\u300c\u93ae\u975c\u5149\u74b0\u300d\u6216\u300c\u725b\u5976\u901f\u5ea6\u300d\u7b49\u96b1\u85cf\u5976\u725b\u5c6c\u6027\u5982\u4f55\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff0c\u4e26\u4e14\u53ef\u4ee5\u63a7\u5236\u55ce\uff1f", "answer": "Crazy Cattle 3D \u4e2d\u7684\u96b1\u85cf\u5976\u725b\u5c6c\u6027\u589e\u52a0\u4e86\u904a\u6232\u6df1\u5ea6\u3002\u725b\u5976\u901f\u5ea6\u5f71\u97ff\u64e0\u5976\u5c0f\u578b\u904a\u6232\u4e2d\u725b\u5976\u7684\u6536\u96c6\u901f\u5ea6\u3002\u93ae\u975c\u5149\u74b0\u964d\u4f4e\u9644\u8fd1\u5976\u725b\u7684\u58d3\u529b\u7a0b\u5ea6\u3002\u96d6\u7136\u6211\u5011\u7121\u6cd5\u76f4\u63a5\u770b\u5230\u9019\u4e9b\u7d71\u8a08\u6578\u64da\uff0c\u4f46\u67d0\u4e9b\u52d5\u4f5c\u6703\u5f71\u97ff\u5b83\u5011\u3002\u4f8b\u5982\uff0c\u5728\u725b\u96bb\u9644\u8fd1\u5efa\u9020\u4e00\u500b\u300c\u8212\u7de9\u5674\u6cc9\u300d\u53ef\u4ee5\u7d71\u8a08\u63d0\u9ad8\u5b83\u5011\u7684\u93ae\u975c\u5149\u74b0\u3002\u9ad8\u968e\u907a\u50b3\u548c\u5347\u7d1a\u53ef\u4ee5\u63d0\u9ad8\u725b\u5976\u901f\u5ea6\u3002\u60a8\u53ef\u4ee5\u5c07\u9019\u4e9b\u79d8\u5bc6\u7d71\u8a08\u6578\u64da\u8996\u70ba\u96b1\u85cf\u7684\u4fee\u6b63\u9805\uff0c\u5b83\u5011\u6703\u734e\u52f5\u67d0\u4e9b\u52d5\u4f5c\u4e26\u9f13\u52f5\u591a\u6a23\u5316\u7684\u8fb2\u5834\u8a2d\u8a08\u3002\u591a\u8a66\u4e0d\u540c\u7684\u8fb2\u5834\u8a2d\u8a08\uff01"}, {"question": "Crazy Cattle 3D\uff1aPC \u7248\u548c\u624b\u6a5f\u7248\u4e4b\u9593\u662f\u5426\u5b58\u5728\u8de8\u5e73\u53f0\u76f8\u5bb9\u6027\uff0c\u7279\u5225\u662f\u95dc\u65bc\u5132\u5b58\u6a94\u6578\u64da\u548c\u9032\u5ea6\uff1f", "answer": "\u7531\u65bc\u904a\u6232\u6a94\u6848\u7d50\u69cb\u7684\u4e0d\u540c\uff0cCrazy Cattle 3D \u7684\u5132\u5b58\u6a94\u6578\u64da\u7121\u6cd5\u5728 PC \u548c\u624b\u6a5f\u4e4b\u9593\u8f49\u79fb\u3002\u540c\u6a23\u5730\uff0c\u904a\u6232\u9032\u5ea6\u4e5f\u7121\u6cd5\u5132\u5b58\u3002\u96d6\u7136\u5169\u500b\u7248\u672c\u5171\u4eab\u904a\u6232\u7684\u6838\u5fc3\u904a\u6232\u8ff4\u5708\uff0c\u4f46\u5b83\u5011\u7684\u67b6\u69cb\u5b58\u5728\u986f\u8457\u5dee\u7570\uff0c\u5f9e\u800c\u964d\u4f4e\u4e86\u76f8\u5bb9\u6027\u3002\u624b\u6a5f\u7248\u91cd\u9ede\u5728\u7c21\u5316\u904a\u6232\u4e26\u7e2e\u77ed\u904a\u6232\u6d41\u7a0b\uff0c\u800c PC \u7248\u53ef\u4ee5\u652f\u63f4\u5ee3\u95ca\u7684\u5340\u57df\u3002\u8acb\u6ce8\u610f\uff0c\u96f2\u7aef\u540c\u6b65\u5de5\u5177\u8a08\u5283\u5728\u672a\u4f86\u6574\u5408\uff0c\u4f46\u76ee\u524d\u9084\u7121\u6cd5\u4f7f\u7528\u3002"}, {"question": "Crazy Cattle 3D \u4e2d\u662f\u5426\u6709\u4efb\u4f55\u5f69\u86cb\u6216\u8d85\u7a00\u6709\u5976\u725b\u54c1\u7a2e\u96b1\u85cf\u5728\u904a\u6232\u4e2d\uff0c\u4ee5\u53ca\u54ea\u4e9b\u89f8\u767c\u689d\u4ef6\u6703\u53ec\u559a\u5b83\u5011\u4f9b\u8fb2\u5834\u4f7f\u7528\uff1f", "answer": "\u50b3\u8aaa\u4e2d\uff0c\u5982\u679c\u60a8\u5b8c\u6210\u6240\u6709\u904a\u6232\u6210\u5c31\uff0c\u9020\u8a2a\u5409\u723e\u8fb2\u592b\u7a40\u5009\u5f8c\u9762\u7684\u9ea5\u7530\u5708\uff0c\u4e26\u8f38\u5165\u4ee3\u78bc\u300cMOOO-STERIOUS\u300d\uff0c\u60a8\u53ef\u80fd\u6703\u89e3\u9396\u96e3\u4ee5\u6349\u6478\u7684\u300c\u9280\u6cb3\u725b\u300d\uff0c\u5b83\u6703\u81ea\u52d5\u751f\u7522\u9280\u6cb3\u7cfb\u725b\u5976\uff01\u9084\u6709\u66f4\u591a\u5f69\u86cb\u3002\u73a9\u5bb6\u5fc5\u9808\u9023\u7e8c\u8d0f\u5f97\u5341\u5834\u300c\u54de\u62c9\u300d\u7af6\u8cfd\u624d\u80fd\u6fc0\u6d3b\u300c\u91d1\u5976\u725b\u300d\u6548\u679c\u3002\u50b3\u805e\u4e2d\u7684\u300c\u6a5f\u5668\u725b\u300d\u6703\u51fa\u73fe\u5728\u51ac\u5929\uff01"}]
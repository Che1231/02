[{"question": "\u65b0\u73a9\u5bb6\u5982\u4f55\u5728Betrayal.io\u5feb\u901f\u638c\u63e1\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u65b0\u73a9\u5bb6\u60f3\u8981\u5feb\u901f\u4e0a\u624bBetrayal.io\uff0c\u9996\u5148\u5e94\u8be5\u719f\u6089\u57fa\u672c\u64cd\u4f5c\u3002\u6e38\u620f\u4e3b\u8981\u4f7f\u7528\u9f20\u6807\u8fdb\u884c\u79fb\u52a8\u548c\u4ea4\u4e92\u3002\u4f8b\u5982\uff0c\u70b9\u51fb\u89d2\u8272\u5c06\u79fb\u52a8\u4f60\u7684\u5316\u8eab\u5230\u8be5\u4f4d\u7f6e\u3002\u6b64\u5916\uff0c\u952e\u76d8\u5feb\u6377\u952e\uff08\u4f8b\u5982\u2018Q\u2019\u8fdb\u884c\u5feb\u901f\u64cd\u4f5c\u548c\u2018E\u2019\u8fdb\u884c\u4ea4\u4e92\uff09\u53ef\u4ee5\u663e\u8457\u52a0\u5feb\u6e38\u620f\u901f\u5ea6\u3002\u4e00\u4e2a\u597d\u7684\u7ec3\u4e60\u65b9\u6cd5\u662f\u5b8c\u6210\u6e38\u620f\u4e2d\u7684\u6559\u7a0b\uff0c\u5b83\u63d0\u4f9b\u4e86\u8fd9\u4e9b\u63a7\u5236\u64cd\u4f5c\u7684\u5b9e\u8df5\u7ecf\u9a8c\u3002\u4f8b\u5982\uff0c\u6559\u7a0b\u5c06\u6307\u5bfc\u4f60\u79fb\u52a8\u89d2\u8272\u3001\u4e0e\u7269\u4f53\u4ea4\u4e92\u4ee5\u53ca\u4f7f\u7528\u7279\u6b8a\u80fd\u529b\u3002\u8fd9\u4e9b\u57fa\u7840\u77e5\u8bc6\u5bf9\u4e8e\u5728\u6e38\u620f\u4e2d\u53d6\u5f97\u8fdb\u5c55\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u5bf9\u4e8e\u65b0\u624b\u6765\u8bf4\uff0c\u5728Betrayal.io\u4e2d\u751f\u5b58\u66f4\u957f\u65f6\u95f4\u7684\u5173\u952e\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u65b0\u624b\u73a9\u5bb6\u5728Betrayal.io\u4e2d\u751f\u5b58\u66f4\u957f\u65f6\u95f4\u9700\u8981\u8c28\u614e\u7684\u6e38\u620f\u548c\u7b56\u7565\u6027\u89c4\u5212\u76f8\u7ed3\u5408\u3002\u9996\u5148\uff0c\u65f6\u523b\u6ce8\u610f\u5468\u56f4\u73af\u5883\uff1b\u4f8b\u5982\uff0c\u907f\u514d\u5b64\u7acb\u533a\u57df\uff0c\u4ee5\u514d\u8f7b\u6613\u906d\u5230\u4f0f\u51fb\u3002\u5176\u6b21\uff0c\u5c3d\u53ef\u80fd\u4e0e\u5176\u4ed6\u73a9\u5bb6\u7ec4\u961f\uff0c\u56e0\u4e3a\u4eba\u591a\u529b\u91cf\u5927\u3002\u4e00\u79cd\u5177\u4f53\u7684\u7b56\u7565\u662f\uff0c\u5728\u7a7f\u8d8a\u5730\u56fe\u4e2d\u592e\u7b49\u9ad8\u98ce\u9669\u533a\u57df\u65f6\uff0c\u7d27\u968f\u56e2\u961f\u3002\u7b2c\u4e09\uff0c\u660e\u667a\u5730\u7ba1\u7406\u4f60\u7684\u8d44\u6e90\uff1b\u4f8b\u5982\uff0c\u9664\u975e\u5fc5\u8981\uff0c\u5426\u5219\u4e0d\u8981\u4f7f\u7528\u8865\u7ed9\u5305\uff0c\u5e76\u65f6\u523b\u5173\u6ce8\u8865\u7ed9\u6389\u843d\u3002\u901a\u8fc7\u9075\u5faa\u8fd9\u4e9b\u6b65\u9aa4\uff0c\u65b0\u624b\u73a9\u5bb6\u53ef\u4ee5\u663e\u8457\u5ef6\u957f\u81ea\u5df1\u5728\u6e38\u620f\u4e2d\u7684\u751f\u5b58\u65f6\u95f4\u3002"}, {"question": "\u4e3a\u4e86\u4f18\u5316\u65b0\u73a9\u5bb6\u5728Betrayal.io\u4e2d\u7684\u6e38\u620f\u6027\u80fd\uff0c\u5e94\u8be5\u8c03\u6574\u54ea\u4e9b\u8bbe\u7f6e\uff1f", "answer": "\u4e3a\u4e86\u4f18\u5316\u65b0\u73a9\u5bb6\u5728Betrayal.io\u4e2d\u7684\u6e38\u620f\u6027\u80fd\uff0c\u9700\u8981\u8c03\u6574\u4e00\u4e9b\u5173\u952e\u8bbe\u7f6e\u3002\u9996\u5148\uff0c\u5c06\u56fe\u5f62\u8bbe\u7f6e\u964d\u4f4e\u5230\u201c\u4e2d\u7b49\u201d\u6216\u201c\u4f4e\u201d\uff0c\u4ee5\u786e\u4fdd\u66f4\u6d41\u7545\u7684\u6e38\u620f\u4f53\u9a8c\uff0c\u5c24\u5176\u662f\u5728\u8f83\u65e7\u7684\u786c\u4ef6\u4e0a\u3002\u4f8b\u5982\uff0c\u964d\u4f4e\u7eb9\u7406\u8d28\u91cf\u548c\u9634\u5f71\u7ec6\u8282\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u5e27\u7387\u3002\u5176\u6b21\uff0c\u5c06\u5206\u8fa8\u7387\u8c03\u6574\u4e3a\u4f60\u7684\u663e\u793a\u5668\u7684\u539f\u751f\u5206\u8fa8\u7387\uff0c\u4ee5\u83b7\u5f97\u6700\u4f73\u89c6\u89c9\u4f53\u9a8c\u3002\u7b2c\u4e09\uff0c\u542f\u7528\u201c\u5782\u76f4\u540c\u6b65\u201d\u4ee5\u9632\u6b62\u753b\u9762\u6495\u88c2\uff0c\u8fd9\u5728\u7d27\u5f20\u65f6\u523b\u4f1a\u5f88\u4ee4\u4eba\u5206\u5fc3\u3002\u6b64\u5916\uff0c\u8003\u8651\u7a0d\u5fae\u964d\u4f4e\u89c6\u89d2\uff08FOV\uff09\u4ee5\u63d0\u9ad8\u6027\u80fd\uff0c\u540c\u65f6\u4e0d\u4f1a\u727a\u7272\u592a\u591a\u89c6\u91ce\u3002\u8fd9\u4e9b\u8c03\u6574\u5c06\u5e2e\u52a9\u65b0\u73a9\u5bb6\u83b7\u5f97\u66f4\u7a33\u5b9a\u548c\u54cd\u5e94\u66f4\u5feb\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u9ad8\u7ea7\u73a9\u5bb6\u5728Betrayal.io\u4e2d\u9700\u8981\u7406\u89e3\u80cc\u53db\u673a\u5236\uff1f", "answer": "\u9ad8\u7ea7\u73a9\u5bb6\u5728Betrayal.io\u4e2d\u9700\u8981\u7406\u89e3\u80cc\u53db\u673a\u5236\uff0c\u56e0\u4e3a\u5b83\u4ece\u6839\u672c\u4e0a\u6539\u53d8\u4e86\u6e38\u620f\u52a8\u6001\u3002\u80cc\u53db\u673a\u5236\u5141\u8bb8\u73a9\u5bb6\u6539\u53d8\u9635\u8425\uff0c\u5c06\u76df\u53cb\u53d8\u6210\u654c\u4eba\u3002\u4f8b\u5982\uff0c\u73a9\u5bb6\u53ef\u80fd\u4f1a\u80cc\u53db\u4ed6\u4eec\u7684\u56e2\u961f\u4ee5\u83b7\u5f97\u6218\u7565\u4f18\u52bf\u6216\u5b8c\u6210\u7279\u5b9a\u76ee\u6807\u3002\u9ad8\u7ea7\u73a9\u5bb6\u5e94\u8be5\u65f6\u523b\u51c6\u5907\u7740\u88ab\u80cc\u53db\u7684\u53ef\u80fd\u6027\uff0c\u4fdd\u6301\u60c5\u5883\u610f\u8bc6\uff0c\u4e0d\u8981\u5b8c\u5168\u4fe1\u4efb\u4efb\u4f55\u5355\u4e2a\u73a9\u5bb6\u3002\u6b64\u5916\uff0c\u4ed6\u4eec\u5e94\u8be5\u5236\u5b9a\u7b56\u7565\u6765\u5e94\u5bf9\u6f5c\u5728\u7684\u80cc\u53db\uff0c\u4f8b\u5982\u5efa\u7acb\u4e34\u65f6\u8054\u76df\u6216\u4e0e\u53ef\u7591\u73a9\u5bb6\u4fdd\u6301\u5b89\u5168\u8ddd\u79bb\u3002\u7cbe\u901a\u8be5\u673a\u5236\u53ef\u4ee5\u4e3a\u9ad8\u7ea7\u73a9\u5bb6\u5728\u6e38\u620f\u4e2d\u63d0\u4f9b\u663e\u8457\u4f18\u52bf\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728Betrayal.io\u4e2d\u6709\u6548\u5730\u5229\u7528\u73af\u5883\u4e3a\u81ea\u5df1\u8c0b\u5229\uff1f", "answer": "\u5728Betrayal.io\u4e2d\u6709\u6548\u5730\u5229\u7528\u73af\u5883\u4e3a\u81ea\u5df1\u8c0b\u5229\uff0c\u9700\u8981\u6df1\u5165\u4e86\u89e3\u5730\u56fe\u5e03\u5c40\u548c\u7269\u4f53\u4ea4\u4e92\u3002\u4f8b\u5982\uff0c\u67d0\u4e9b\u533a\u57df\u53ef\u4ee5\u4e3a\u8eb2\u907f\u654c\u4eba\u7684\u653b\u51fb\u63d0\u4f9b\u63a9\u62a4\uff0c\u800c\u5176\u4ed6\u533a\u57df\u5219\u4e3a\u83b7\u5f97\u66f4\u597d\u89c6\u91ce\u63d0\u4f9b\u4e86\u9ad8\u5730\u3002\u9ad8\u7ea7\u73a9\u5bb6\u5e94\u59cb\u7ec8\u610f\u8bc6\u5230\u8fd9\u4e9b\u6218\u7565\u4f4d\u7f6e\u5e76\u5229\u7528\u5176\u4f18\u52bf\u3002\u6b64\u5916\uff0c\u73af\u5883\u5371\u5bb3\uff0c\u5982\u9677\u9631\u6216\u7206\u70b8\u6876\uff0c\u53ef\u7528\u4e8e\u6d88\u706d\u654c\u4eba\u3002\u4e00\u79cd\u5177\u4f53\u7684\u7b56\u7565\u662f\u5c06\u5bf9\u624b\u5f15\u8bf1\u5230\u8fd9\u4e9b\u5371\u9669\u4e2d\uff0c\u8ba9\u81ea\u5df1\u6210\u4e3a\u8bf1\u9975\u3002\u6b64\u5916\uff0c\u4e86\u89e3\u8bf8\u5982\u8865\u7ed9\u5305\u548c\u6b66\u5668\u7b49\u91cd\u8981\u7269\u54c1\u7684\u751f\u6210\u70b9\u53ef\u4ee5\u4e3a\u60a8\u63d0\u4f9b\u663e\u8457\u4f18\u52bf\u3002\u901a\u8fc7\u638c\u63e1\u73af\u5883\uff0c\u73a9\u5bb6\u53ef\u4ee5\u5de7\u5999\u5730\u6446\u8131\u5e76\u51fb\u8d25\u5bf9\u624b\u3002"}, {"question": "\u5728Betrayal.io\u4e2d\uff0c\u4e0d\u540c\u6e38\u620f\u98ce\u683c\u7684\u6700\u4f73\u88c5\u8f7d\u7ec4\u5408\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728Betrayal.io\u4e2d\uff0c\u9009\u62e9\u6700\u4f73\u88c5\u8f7d\u7ec4\u5408\u53d6\u51b3\u4e8e\u4f60\u7684\u9996\u9009\u6e38\u620f\u98ce\u683c\u3002\u5bf9\u4e8e\u4fb5\u7565\u6027\u73a9\u5bb6\uff0c\u9ad8\u4f24\u5bb3\u6b66\u5668\uff08\u5982\u6563\u5f39\u67aa\u548c\u5feb\u901f\u88c5\u586b\u7684\u624b\u67aa\uff09\u7ec4\u5408\u662f\u7406\u60f3\u7684\u3002\u4f8b\u5982\uff0c\u6563\u5f39\u67aa\u975e\u5e38\u9002\u5408\u8fd1\u8ddd\u79bb\u6218\u6597\uff0c\u800c\u624b\u67aa\u5219\u5141\u8bb8\u8fdb\u884c\u5feb\u901f\u540e\u7eed\u5c04\u51fb\u3002\u9632\u5fa1\u6027\u73a9\u5bb6\u5e94\u8be5\u9009\u62e9\u8fdc\u7a0b\u6b66\u5668\uff0c\u4f8b\u5982\u72d9\u51fb\u6b65\u67aa\uff0c\u5e76\u9009\u62e9\u8f85\u52a9\u7269\u54c1\uff0c\u4f8b\u5982\u6025\u6551\u5305\u3002\u72d9\u51fb\u6b65\u67aa\u63d0\u4f9b\u6781\u4f73\u7684\u706b\u529b\u63a9\u62a4\uff0c\u800c\u6025\u6551\u5305\u5219\u786e\u4fdd\u6301\u7eed\u7684\u751f\u5b58\u80fd\u529b\u3002\u9690\u853d\u6027\u73a9\u5bb6\u53ef\u80fd\u66f4\u559c\u6b22\u6d88\u97f3\u6b66\u5668\u548c\u70df\u96fe\u5f39\u8fdb\u884c\u79d8\u5bc6\u884c\u52a8\u3002\u4f8b\u5982\uff0c\u6d88\u97f3\u624b\u67aa\u53ef\u4ee5\u8fdb\u884c\u5b89\u9759\u7684\u51fb\u6740\uff0c\u800c\u70df\u96fe\u5f39\u5219\u53ef\u4ee5\u5236\u9020\u5e72\u6270\u3002\u5c06\u4f60\u7684\u88c5\u8f7d\u7ec4\u5408\u8c03\u6574\u4e3a\u4f60\u7684\u6e38\u620f\u98ce\u683c\u53ef\u4ee5\u663e\u8457\u589e\u5f3a\u4f60\u5728\u6e38\u620f\u4e2d\u7684\u6548\u7387\u3002"}, {"question": "Betrayal.io\u7684\u6e38\u620f\u5339\u914d\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u5b83\uff1f", "answer": "Betrayal.io\u7684\u6e38\u620f\u5339\u914d\u7cfb\u7edf\u65e8\u5728\u901a\u8fc7\u8003\u8651\u591a\u4e2a\u56e0\u7d20\u6765\u521b\u5efa\u5e73\u8861\u4e14\u5177\u6709\u7ade\u4e89\u529b\u7684\u6bd4\u8d5b\u3002\u9996\u5148\uff0c\u5b83\u4f1a\u6839\u636e\u73a9\u5bb6\u7684\u8868\u73b0\u6307\u6807\uff08\u4f8b\u5982\u51fb\u6740/\u6b7b\u4ea1\u6bd4\u548c\u83b7\u80dc\u7387\uff09\u8bc4\u4f30\u73a9\u5bb6\u6280\u80fd\u6c34\u5e73\u3002\u4f8b\u5982\uff0c\u83b7\u80dc\u7387\u9ad8\u7684\u73a9\u5bb6\u66f4\u6709\u53ef\u80fd\u4e0e\u6280\u80fd\u76f8\u4f3c\u7684\u5bf9\u624b\u5339\u914d\u3002\u5176\u6b21\uff0c\u8be5\u7cfb\u7edf\u4f1a\u8003\u8651\u6d3b\u8dc3\u73a9\u5bb6\u7684\u6570\u91cf\uff0c\u4ee5\u786e\u4fdd\u5feb\u901f\u5339\u914d\u65f6\u95f4\u3002\u7b2c\u4e09\uff0c\u5b83\u4f1a\u8003\u8651\u4e00\u5929\u4e2d\u7684\u65f6\u95f4\u548c\u670d\u52a1\u5668\u4f4d\u7f6e\u4ee5\u4f18\u5316\u5ef6\u8fdf\u548c\u8fde\u63a5\u8d28\u91cf\u3002\u6b64\u5916\uff0c\u7cfb\u7edf\u53ef\u80fd\u4f18\u5148\u8003\u8651\u5c06\u5177\u6709\u7c7b\u4f3c\u6e38\u620f\u98ce\u683c\u6216\u76ee\u6807\u7684\u73a9\u5bb6\u7ec4\u5408\u5728\u4e00\u8d77\uff0c\u4f8b\u5982\u4e13\u6ce8\u4e8e\u56e2\u961f\u5408\u4f5c\u4e0e\u5355\u4eba\u6e38\u620f\u3002"}, {"question": "Betrayal.io\u4e2d\u751f\u547d\u503c\u548c\u4f24\u5bb3\u7cfb\u7edf\u7684\u57fa\u672c\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "Betrayal.io\u4e2d\u7684\u751f\u547d\u503c\u548c\u4f24\u5bb3\u7cfb\u7edf\u7531\u8bb8\u591a\u57fa\u672c\u673a\u5236\u63a7\u5236\uff0c\u8fd9\u4e9b\u673a\u5236\u73a9\u5bb6\u5e94\u8be5\u7406\u89e3\u624d\u80fd\u4f18\u5316\u4ed6\u4eec\u7684\u6e38\u620f\u73a9\u6cd5\u3002\u9996\u5148\uff0c\u751f\u547d\u503c\uff08HP\uff09\u662f\u6709\u9650\u7684\uff0c\u53ef\u4ee5\u4f7f\u7528\u5730\u56fe\u4e0a\u904d\u5e03\u7684\u8865\u7ed9\u5305\u8fdb\u884c\u8865\u5145\u3002\u4f8b\u5982\uff0c\u6807\u51c6\u7684\u8865\u7ed9\u5305\u53ef\u4ee5\u6062\u590d 50 \u70b9\u751f\u547d\u503c\u3002\u5176\u6b21\uff0c\u4e0d\u540c\u6b66\u5668\u9020\u6210\u7684\u4f24\u5bb3\u5404\u4e0d\u76f8\u540c\uff1b\u4f8b\u5982\uff0c\u6563\u5f39\u67aa\u53ef\u80fd\u4f1a\u6bcf\u53d1\u9020\u6210100\u70b9\u4f24\u5bb3\uff0c\u800c\u624b\u67aa\u5219\u9020\u621025\u70b9\u4f24\u5bb3\u3002\u7b2c\u4e09\uff0c\u76d4\u7532\u53ef\u4ee5\u51cf\u8f7b\u90e8\u5206\u4f24\u5bb3\uff0c\u4ece\u800c\u6709\u6548\u63d0\u9ad8\u73a9\u5bb6\u7684\u751f\u5b58\u80fd\u529b\u3002\u9ad8\u7ea7\u73a9\u5bb6\u5e94\u8be5\u4e86\u89e3\u8fd9\u4e9b\u673a\u5236\uff0c\u4ee5\u4fbf\u5728\u6218\u6597\u4e2d\u505a\u51fa\u660e\u667a\u7684\u51b3\u5b9a\uff0c\u4f8b\u5982\u4f18\u5148\u9009\u62e9\u9ad8\u4f24\u5bb3\u6b66\u5668\u6216\u5728\u751f\u547d\u503c\u4f4e\u65f6\u5bfb\u627e\u8865\u7ed9\u5305\u3002\u7cbe\u901a\u8fd9\u4e9b\u673a\u5236\u53ef\u4ee5\u4e3a\u73a9\u5bb6\u5728\u6e38\u620f\u4e2d\u63d0\u4f9b\u663e\u8457\u4f18\u52bf\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e0a\u4f20\u8f93\u4ed6\u4eec\u7684Betrayal.io\u5e10\u6237\u4ee5\u786e\u4fdd\u987a\u5229\u8fc7\u6e21\uff1f", "answer": "\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e0a\u8fc1\u79fb\u4f60\u7684Betrayal.io\u5e10\u6237\u4ee5\u786e\u4fdd\u987a\u5229\u8fc7\u6e21\uff0c\u9700\u8981\u51e0\u4e2a\u5173\u952e\u6b65\u9aa4\u3002\u9996\u5148\uff0c\u786e\u4fdd\u4f60\u7684\u5e10\u6237\u94fe\u63a5\u5230\u901a\u7528\u767b\u5f55\u670d\u52a1\uff08\u4f8b\u5982Google\u6216Facebook\uff09\uff0c\u8fd9\u5141\u8bb8\u73a9\u5bb6\u5728\u4e0d\u540c\u8bbe\u5907\u4e0a\u8f7b\u677e\u8bbf\u95ee\u3002\u4f8b\u5982\uff0c\u94fe\u63a5\u5230Google Play\u5e10\u6237\uff0c\u4f7f\u5728PC\u548c\u79fb\u52a8\u8bbe\u5907\u4e0a\u90fd\u80fd\u987a\u5229\u6e38\u620f\u3002\u5176\u6b21\uff0c\u9a8c\u8bc1\u6240\u6709\u4f60\u7684\u6e38\u620f\u6570\u636e\uff08\u5305\u62ec\u8fdb\u5ea6\u3001\u6210\u5c31\u548c\u5e93\u5b58\uff09\u90fd\u5df2\u4e0e\u4e91\u7aef\u540c\u6b65\u3002\u8fd9\u901a\u5e38\u53ef\u4ee5\u901a\u8fc7\u6e38\u620f\u7684\u8bbe\u7f6e\u83dc\u5355\u6765\u5b8c\u6210\u3002\u7b2c\u4e09\uff0c\u68c0\u67e5\u53ef\u80fd\u9700\u8981\u7ef4\u62a4\u517c\u5bb9\u6027\u7684\u5e73\u53f0\u7279\u5b9a\u66f4\u65b0\u6216\u8865\u4e01\u3002\u6b64\u5916\uff0c\u8981\u6ce8\u610f\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u7684\u63a7\u5236\u6216\u754c\u9762\u5dee\u5f02\uff0c\u5e76\u76f8\u5e94\u5730\u8c03\u6574\u4f60\u7684\u8bbe\u7f6e\u3002\u901a\u8fc7\u9075\u5faa\u8fd9\u4e9b\u6b65\u9aa4\uff0c\u73a9\u5bb6\u53ef\u4ee5\u5728\u4e0d\u540c\u7684\u8bbe\u5907\u4e0a\u83b7\u5f97\u4e00\u81f4\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728Betrayal.io\u4e2d\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u5185\u5bb9\u6216\u5f69\u86cb\uff0c\u4ee5\u53ca\u5b83\u4eec\u5982\u4f55\u589e\u5f3a\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "Betrayal.io\u5145\u6ee1\u4e86\u9690\u85cf\u5185\u5bb9\u548c\u5f69\u86cb\uff0c\u53ef\u4ee5\u4e3a\u597d\u5947\u7684\u73a9\u5bb6\u663e\u8457\u589e\u5f3a\u6e38\u620f\u4f53\u9a8c\u3002\u4e00\u4e2a\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\u201c\u9ec4\u91d1\u67aa\u201d\uff0c\u8fd9\u662f\u4e00\u79cd\u7a00\u6709\u6b66\u5668\uff0c\u53ef\u4ee5\u5728\u5730\u56fe\u4e0a\u7684\u79d8\u5bc6\u5730\u70b9\u627e\u5230\u3002\u4f8b\u5982\uff0c\u73a9\u5bb6\u53ef\u80fd\u4f1a\u5728\u504f\u8fdc\u533a\u57df\u7684\u5899\u540e\u53d1\u73b0\u5b83\u3002\u53e6\u4e00\u4e2a\u9690\u85cf\u529f\u80fd\u662f\u201c\u795e\u79d8\u623f\u95f4\u201d\uff0c\u5b83\u5305\u542b\u5b9d\u8d35\u7684\u6218\u5229\u54c1\uff0c\u4f46\u53ea\u6709\u901a\u8fc7\u4e00\u7cfb\u5217\u795e\u79d8\u7684\u8c1c\u9898\u624d\u80fd\u8fdb\u5165\u3002\u8fd9\u4e9b\u9690\u85cf\u5143\u7d20\u4e0d\u4ec5\u589e\u52a0\u4e86\u60ca\u559c\u548c\u63a2\u7d22\u7684\u5143\u7d20\uff0c\u800c\u4e14\u8fd8\u63d0\u4f9b\u4e86\u53ef\u83b7\u5f97\u7684\u5956\u52b1\uff0c\u53ef\u4ee5\u4e3a\u73a9\u5bb6\u5728\u6e38\u620f\u4e2d\u63d0\u4f9b\u4f18\u52bf\u3002\u53d1\u73b0\u8fd9\u4e9b\u79d8\u5bc6\u53ef\u4ee5\u4f7f\u5bf9\u559c\u6b22\u63a2\u7d22\u7684\u73a9\u5bb6\u6765\u8bf4\u6e38\u620f\u4f53\u9a8c\u66f4\u52a0\u5f15\u4eba\u5165\u80dc\u548c\u6709\u56de\u62a5\u3002"}]
[{"question": "\ubc30\uc2e0.io\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubc30\uc2e0.io\uc5d0\uc11c \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub824\uba74, \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub294 \uba3c\uc800 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc5d0 \uc775\uc219\ud574\uc838\uc57c \ud569\ub2c8\ub2e4. \uc774 \uac8c\uc784\uc740 \uc8fc\ub85c \ub9c8\uc6b0\uc2a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc774\ub3d9 \ubc0f \uc0c1\ud638 \uc791\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uce90\ub9ad\ud130\ub97c \ud074\ub9ad\ud558\uba74 \uc544\ubc14\ud0c0\uac00 \ud574\ub2f9 \uc704\uce58\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4. \ub610\ud55c, 'Q'\ub85c \ube60\ub978 \ub3d9\uc791 \ubc0f 'E'\ub85c \uc0c1\ud638 \uc791\uc6a9\uacfc \uac19\uc740 \ud0a4\ubcf4\ub4dc \ub2e8\ucd95\ud0a4\ub97c \uc0ac\uc6a9\ud558\uba74 \uac8c\uc784 \ud50c\ub808\uc774 \uc18d\ub3c4\ub97c \ud06c\uac8c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784 \ub0b4 \ud29c\ud1a0\ub9ac\uc5bc\uc744 \uc644\ub8cc\ud558\ub294 \uac83\uc774 \uc88b\uc740 \uc5f0\uc2b5\uc785\ub2c8\ub2e4. \uc774 \ud29c\ud1a0\ub9ac\uc5bc\uc740 \uce90\ub9ad\ud130 \uc774\ub3d9, \uac1c\uccb4\uc640\uc758 \uc0c1\ud638 \uc791\uc6a9 \ubc0f \ud2b9\uc218 \ub2a5\ub825 \uc0ac\uc6a9\uacfc \uac19\uc740 \ucee8\ud2b8\ub864\uc5d0 \ub300\ud55c \uc2e4\uc81c \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc774 \uae30\ubcf8\uc801\uc778 \uc9c0\uc2dd\uc740 \uac8c\uc784 \uc9c4\ud589\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4."}, {"question": "\ucd08\ubcf4 \ud50c\ub808\uc774\uc5b4\uac00 \ubc30\uc2e0.io\uc5d0\uc11c \ub354 \uc624\ub798 \uc0b4\uc544\ub0a8\uae30 \uc704\ud55c \uc8fc\uc694 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubc30\uc2e0.io\uc5d0\uc11c \ucd08\ubcf4 \ud50c\ub808\uc774\uc5b4\uac00 \ub354 \uc624\ub798 \uc0b4\uc544\ub0a8\uc73c\ub824\uba74 \uc2e0\uc911\ud55c \ud50c\ub808\uc774\uc640 \uc804\ub7b5\uc801\uc778 \uacc4\ud68d\uc774 \uacb0\ud569\ub418\uc5b4\uc57c \ud569\ub2c8\ub2e4. \uccab\uc9f8, \ud56d\uc0c1 \uc8fc\ubcc0 \ud658\uacbd\uc744 \uc778\uc2dd\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc27d\uac8c \ub9e4\ubcf5\ub2f9\ud560 \uc218 \uc788\ub294 \uace0\ub9bd\ub41c \uc9c0\uc5ed\uc744 \ud53c\ud558\uc2ed\uc2dc\uc624. \ub458\uc9f8, \uac00\ub2a5\ud558\uba74 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uc640 \ud568\uaed8 \ud50c\ub808\uc774\ud558\uc2ed\uc2dc\uc624. \uc22b\uc790\ub294 \uc548\uc804\ud569\ub2c8\ub2e4. \ud2b9\uc815 \uc804\ub7b5\uc740 \uc9c0\ub3c4\uc758 \uc911\uc559 \uc9c0\uc5ed\uacfc \uac19\uc740 \uace0\uc704\ud5d8 \uc9c0\uc5ed\uc744 \uc774\ub3d9\ud560 \ub54c \uadf8\ub8f9\uc5d0 \uac00\uae4c\uc774 \uba38\ubb34\ub294 \uac83\uc785\ub2c8\ub2e4. \uc14b\uc9f8, \uc790\uc6d0\uc744 \ud604\uba85\ud558\uac8c \uad00\ub9ac\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ud544\uc694\ud560 \ub54c\ub9cc \uccb4\ub825 \ud68c\ubcf5 \ud3ec\uc158\uc744 \uc0ac\uc6a9\ud558\uace0 \ubcf4\uae09\ud488 \ub4dc\ub78d\uc5d0 \uc8fc\uc758\ud558\uc2ed\uc2dc\uc624. \uc774\ub7ec\ud55c \ub2e8\uacc4\ub97c \ub530\ub974\uba74 \ucd08\ubcf4 \ud50c\ub808\uc774\uc5b4\ub294 \uac8c\uc784\uc5d0\uc11c \uc0dd\uc874 \uc2dc\uac04\uc744 \ud06c\uac8c \ub298\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \ubc30\uc2e0.io \uc131\ub2a5 \ucd5c\uc801\ud654\ub97c \uc704\ud574 \uc5b4\ub5a4 \uc124\uc815\uc744 \uc870\uc815\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\ubc30\uc2e0.io\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \uc131\ub2a5 \ucd5c\uc801\ud654\ub294 \uc5ec\ub7ec \ud575\uc2ec \uc124\uc815\uc744 \uc870\uc815\ud558\ub294 \uac83\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \uccab\uc9f8, \ud2b9\ud788 \uc624\ub798\ub41c \ud558\ub4dc\uc6e8\uc5b4\uc758 \uacbd\uc6b0 \ubd80\ub4dc\ub7ec\uc6b4 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc704\ud574 \uadf8\ub798\ud53d \uc124\uc815\uc744 '\uc911\uac04' \ub610\ub294 '\ub0ae\uc74c'\uc73c\ub85c \ub0ae\ucd94\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4 \ud14d\uc2a4\ucc98 \ud488\uc9c8\uacfc \uadf8\ub9bc\uc790 \ub514\ud14c\uc77c\uc744 \uc904\uc774\uba74 \ud504\ub808\uc784 \uc18d\ub3c4\ub97c \ud06c\uac8c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub458\uc9f8, \ucd5c\uc0c1\uc758 \uc2dc\uac01\uc801 \uacbd\ud5d8\uc744 \uc704\ud574 \ud574\uc0c1\ub3c4\ub97c \ubaa8\ub2c8\ud130\uc758 \uae30\ubcf8 \ud574\uc0c1\ub3c4\uc5d0 \ub9de\ucdb0 \uc870\uc815\ud569\ub2c8\ub2e4. \uc14b\uc9f8, \ud654\uba74 \ucc22\uae40\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud574 'VSync'\ub97c \ud65c\uc131\ud654\ud569\ub2c8\ub2e4. \uc774\ub294 \uaca9\ub82c\ud55c \uc21c\uac04\uc5d0 \ubc29\ud574\uac00 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uc2dc\uc57c\uac01(FOV)\uc744 \uc57d\uac04 \uc904\uc5ec\uc11c \ub108\ubb34 \ub9ce\uc740 \uc2dc\uc57c\ub97c \ud76c\uc0dd\ud558\uc9c0 \uc54a\uace0\ub3c4 \uc131\ub2a5\uc744 \uac1c\uc120\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc870\uc815\uc744 \ud1b5\ud574 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub294 \ub354 \uc548\uc815\uc801\uc774\uace0 \ubc18\uc751\uc131\uc774 \uc88b\uc740 \uac8c\uc784 \ud658\uacbd\uc744 \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ubc30\uc2e0.io\uc5d0\uc11c \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ubc30\uc2e0 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubc30\uc2e0.io\uc5d0\uc11c \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ubc30\uc2e0 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \uac8c\uc784\uc758 \uc5ed\ud559\uc744 \uadfc\ubcf8\uc801\uc73c\ub85c \ubc14\uafb8\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \ubc30\uc2e0 \uba54\ucee4\ub2c8\uc998\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \ub3d9\ub9f9\uc744 \ubc14\uafc0 \uc218 \uc788\ub3c4\ub85d \ud558\uc5ec \ub3d9\ub9f9\uc744 \uc801\ub300\uc801\uc778 \uad00\uacc4\ub85c \ubc14\uafc9\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud50c\ub808\uc774\uc5b4\ub294 \uc804\ub7b5\uc801 \uc774\uc810\uc744 \uc5bb\uac70\ub098 \ud2b9\uc815 \ubaa9\ud45c\ub97c \ub2ec\uc131\ud558\uae30 \uc704\ud574 \ud300\uc744 \ubc30\uc2e0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \uc0c1\ud669 \uc778\uc2dd\uc744 \uc720\uc9c0\ud558\uace0 \ub2e8 \ud55c \uba85\uc758 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c\ub3c4 \uc644\uc804\ud788 \uc2e0\ub8b0\ud558\uc9c0 \uc54a\uc74c\uc73c\ub85c\uc368 \ubc30\uc2e0 \uac00\ub2a5\uc131\uc5d0 \ud56d\uc0c1 \ub300\ube44\ud574\uc57c \ud569\ub2c8\ub2e4. \ub610\ud55c \uc784\uc2dc \ub3d9\ub9f9\uc744 \ud615\uc131\ud558\uac70\ub098 \uc758\uc2ec\uc2a4\ub7ec\uc6b4 \ud50c\ub808\uc774\uc5b4\uc640\uc758 \uac70\ub9ac\ub97c \uc720\uc9c0\ud558\ub294 \ub4f1 \uc7a0\uc7ac\uc801\uc778 \ubc30\uc2e0\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud55c \uc804\ub7b5\uc744 \uac1c\ubc1c\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774 \uba54\ucee4\ub2c8\uc998\uc744 \uc219\ub2ec\ud558\uba74 \uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \uac8c\uc784\uc5d0\uc11c \uc0c1\ub2f9\ud55c \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud50c\ub808\uc774\uc5b4\uac00 \ubc30\uc2e0.io\uc5d0\uc11c \ud658\uacbd\uc744 \ud65c\uc6a9\ud558\uc5ec \uc790\uc2e0\uc5d0\uac8c \uc720\ub9ac\ud558\uac8c \ub9cc\ub4dc\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubc30\uc2e0.io\uc5d0\uc11c \ud658\uacbd\uc744 \uc790\uc2e0\uc758 \uc774\uc775\uc73c\ub85c \ud65c\uc6a9\ud558\ub294 \uac83\uc740 \uc9c0\ub3c4 \ub808\uc774\uc544\uc6c3\uacfc \uac1c\uccb4 \uc0c1\ud638 \uc791\uc6a9\uc5d0 \ub300\ud55c \uae4a\uc740 \uc774\ud574\ub97c \ud3ec\ud568\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud2b9\uc815 \uc601\uc5ed\uc740 \uc801\uc758 \uacf5\uaca9\uc73c\ub85c\ubd80\ud130 \uc228\uc744 \uc81c\uacf5\ud558\uace0, \ub2e4\ub978 \uc601\uc5ed\uc740 \ub354 \ub098\uc740 \uc2dc\uc57c\ub97c \uc704\ud574 \uace0\uc9c0\ub300\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \ud56d\uc0c1 \uc774\ub7ec\ud55c \uc804\ub7b5\uc801 \uc704\uce58\uc5d0 \uc720\uc758\ud558\uace0 \uc790\uc2e0\uc758 \uc774\uc775\uc5d0 \uc0ac\uc6a9\ud574\uc57c \ud569\ub2c8\ub2e4. \ub610\ud55c, \ud568\uc815\uc774\ub098 \ud3ed\ubc1c\uc131 \ud1b5\uc774\uc640 \uac19\uc740 \ud658\uacbd \uc704\ud5d8 \uc694\uc18c\ub294 \uc801\uc744 \uc81c\uac70\ud558\ub294 \ub370 \uc0ac\uc6a9\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc801\uc73c\ub85c \ud558\uc5ec\uae08 \uc774\ub7ec\ud55c \uc704\ud5d8 \uc694\uc18c\uc5d0 \ube60\uc9c0\ub3c4\ub85d \uc720\uc778\ud560 \uc218 \uc788\ub294 \ud2b9\uc815 \uc804\ub7b5\uc740 \ubbf8\ub07c\ub85c \uc790\uc2e0\uc744 \ubc30\uce58\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \ub610\ud55c, \uccb4\ub825 \ud3ec\uc158\uacfc \ubb34\uae30\uc640 \uac19\uc740 \ud544\uc218 \uc544\uc774\ud15c\uc758 \ud68d\ub4dd \uc9c0\uc810\uc744 \uc54c\uace0 \uc788\ub294 \uac83\uc740 \uc0c1\ub2f9\ud55c \uc774\uc810\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ud658\uacbd\uc744 \uc81c\ub300\ub85c \ud65c\uc6a9\ud558\uba74 \ud50c\ub808\uc774\uc5b4\ub294 \uc0c1\ub300\ub97c \uad50\ubb18\ud558\uac8c \uc18d\uc774\uace0 \uc774\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ubc30\uc2e0.io\uc5d0\uc11c \uc11c\ub85c \ub2e4\ub978 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\ub294 \ucd5c\uace0\uc758 \ub85c\ub4dc\uc544\uc6c3 \uc870\ud569\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubc30\uc2e0.io\uc5d0\uc11c \ucd5c\uace0\uc758 \ub85c\ub4dc\uc544\uc6c3 \uc870\ud569\uc740 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. \uacf5\uaca9\uc801\uc778 \ud50c\ub808\uc774\uc5b4\ub294 \uc0b0\ud0c4\ucd1d\uacfc \ube60\ub978 \uc7ac\uc7a5\uc804 \uad8c\ucd1d\uacfc \uac19\uc740 \uace0\ud53c\ud574 \ubb34\uae30\ub97c \uacb0\ud569\ud55c \uc870\ud569\uc774 \uc774\uc0c1\uc801\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc0b0\ud0c4\ucd1d\uc740 \uadfc\uc811 \uc804\ud22c\uc5d0 \uc801\ud569\ud558\uace0, \uad8c\ucd1d\uc740 \ube60\ub978 \ucd94\uaca9 \uc0ac\uaca9\uc744 \uac00\ub2a5\ud558\uac8c \ud569\ub2c8\ub2e4. \uc218\ube44\uc801\uc778 \ud50c\ub808\uc774\uc5b4\ub294 \uc800\uaca9\ucd1d\uacfc \uc758\ub8cc \ud0a4\ud2b8\uc640 \uac19\uc740 \uc9c0\uc6d0 \uc544\uc774\ud15c\uc744 \uc120\ud0dd\ud574\uc57c \ud569\ub2c8\ub2e4. \uc800\uaca9\ucd1d\uc740 \ud0c1\uc6d4\ud55c \uc9c0\uc6d0 \uc0ac\uaca9\uc744 \uc81c\uacf5\ud558\uace0, \uc758\ub8cc \ud0a4\ud2b8\ub294 \uc9c0\uc18d\uc801\uc778 \uc0dd\uc874\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4. \uc740\uc2e0 \ud50c\ub808\uc774\uc5b4\ub294 \uc740\ubc00\ud55c \uc791\uc804\uc744 \uc704\ud574 \uce68\ubb35\ud615 \ubb34\uae30\uc640 \uc5f0\ub9c9\ud0c4\uc744 \uc120\ud638\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uce68\ubb35\ud615 \uad8c\ucd1d\uc740 \uc870\uc6a9\ud55c \uc81c\uac70\ub97c \uac00\ub2a5\ud558\uac8c \ud558\uba70, \uc5f0\ub9c9\ud0c4\uc740 \ubc29\ud574\ub97c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\ub294 \ub85c\ub4dc\uc544\uc6c3\uc744 \uad6c\uc131\ud558\uba74 \uac8c\uc784\uc5d0\uc11c \ud6a8\uacfc\ub97c \ud06c\uac8c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ubc30\uc2e0.io\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \uc5b4\ub5a4 \uc694\uc18c\uac00 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ubc30\uc2e0.io\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \ud0ac/\ub370\uc2a4 \ube44\uc728 \ubc0f \uc2b9\ub960\uacfc \uac19\uc740 \uc131\ub2a5 \uc9c0\ud45c\ub97c \uae30\ubc18\uc73c\ub85c \ud50c\ub808\uc774\uc5b4\uc758 \uae30\uc220 \uc218\uc900\uc744 \ud3c9\uac00\ud558\uc5ec \uade0\ud615 \uc788\uace0 \uacbd\uc7c1\uc801\uc778 \ub9e4\uce58\ub97c \ub9cc\ub4dc\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc2b9\ub960\uc774 \ub192\uc740 \ud50c\ub808\uc774\uc5b4\ub294 \uc720\uc0ac\ud55c \uae30\uc220 \uc218\uc900\uc758 \uc0c1\ub300\uc640 \ub9e4\uce58\ub420 \uac00\ub2a5\uc131\uc774 \ub192\uc2b5\ub2c8\ub2e4. \ub458\uc9f8, \uc2dc\uc2a4\ud15c\uc740 \ube60\ub978 \ub9e4\uce6d \uc2dc\uac04\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 \ud65c\uc131 \ud50c\ub808\uc774\uc5b4 \uc218\ub97c \uace0\ub824\ud569\ub2c8\ub2e4. \uc14b\uc9f8, \ub300\uae30 \uc2dc\uac04 \ubc0f \uc5f0\uacb0 \ud488\uc9c8\uc744 \ucd5c\uc801\ud654\ud558\uae30 \uc704\ud574 \uc2dc\uac04\ub300\uc640 \uc11c\ubc84 \uc704\uce58\ub97c \uace0\ub824\ud569\ub2c8\ub2e4. \ub610\ud55c, \uc2dc\uc2a4\ud15c\uc740 \ud300\uc6cc\ud06c \uc911\uc2ec \ub300 \uc194\ub85c \ud50c\ub808\uc774\uc640 \uac19\uc774 \uc720\uc0ac\ud55c \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc774\ub098 \ubaa9\ud45c\ub97c \uac00\uc9c4 \ud50c\ub808\uc774\uc5b4\ub97c \uadf8\ub8f9\ud654\ud558\ub294 \uac83\uc744 \uc6b0\uc120\uc21c\uc704\ub85c \ucc98\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc694\uc18c\ub97c \uc774\ud574\ud558\uba74 \ud50c\ub808\uc774\uc5b4\ub294 \uc790\uc2e0\uc774 \uc9c1\uba74\ud560 \ub9e4\uce58 \uc720\ud615\uc744 \uc608\uc0c1\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ubc30\uc2e0.io\uc758 \uccb4\ub825 \ubc0f \ud53c\ud574 \uc2dc\uc2a4\ud15c\uc758 \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubc30\uc2e0.io\uc758 \uccb4\ub825 \ubc0f \ud53c\ud574 \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ucd5c\uc801\ud654\ud558\uae30 \uc704\ud574 \uc774\ud574\ud574\uc57c \ud558\ub294 \uba87 \uac00\uc9c0 \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc5d0 \ub530\ub77c \uc6c0\uc9c1\uc785\ub2c8\ub2e4. \uccab\uc9f8, \uccb4\ub825 \uc810\uc218(HP)\ub294 \uc720\ud55c\ud558\uba70 \uc9c0\ub3c4 \uc804\uc5ed\uc5d0 \uc788\ub294 \uccb4\ub825 \ud68c\ubcf5 \ud3ec\uc158\uc744 \uc0ac\uc6a9\ud558\uc5ec \ubcf4\ucda9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud45c\uc900 \uccb4\ub825 \ud68c\ubcf5 \ud3ec\uc158\uc740 50 HP\ub97c \ubcf5\uad6c\ud569\ub2c8\ub2e4. \ub458\uc9f8, \uc11c\ub85c \ub2e4\ub978 \ubb34\uae30\ub294 \ub2e4\uc591\ud55c \uc591\uc758 \ud53c\ud574\ub97c \uc785\ud799\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc0b0\ud0c4\ucd1d\uc740 \ud55c \ubc1c\ub2f9 100\uc758 \ud53c\ud574\ub97c \uc785\ud788\uace0, \uad8c\ucd1d\uc740 25\uc758 \ud53c\ud574\ub97c \uc785\ud799\ub2c8\ub2e4. \uc14b\uc9f8, \uc7a5\uac11\uc740 \ub4e4\uc5b4\uc624\ub294 \ud53c\ud574\uc758 \uc77c\ubd80\ub97c \uc644\ud654\ud558\uc5ec \ud50c\ub808\uc774\uc5b4\uc758 \uc0dd\uc874\ub825\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc99d\uac00\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \uc804\ud22c \uc911\uc5d0 \uc0ac\ub9ac\ub97c \ud310\ub2e8\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ub3c4\ub85d \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc5d0 \uc720\uc758\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub192\uc740 \ud53c\ud574 \ubb34\uae30 \uc6b0\uc120 \ub610\ub294 HP\uac00 \ub0ae\uc744 \ub54c \uccb4\ub825 \ud3ec\uc158\uc744 \ucc3e\ub294 \uac83\uc744 \uc6b0\uc120\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \uc219\ub2ec\ud558\uba74 \ud50c\ub808\uc774\uc5b4\ub294 \uac8c\uc784\uc5d0\uc11c \uc0c1\ub2f9\ud55c \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud50c\ub808\uc774\uc5b4\uac00 \uc11c\ub85c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ubc30\uc2e0.io \uacc4\uc815\uc744 \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud560 \ub54c \uc6d0\ud65c\ud55c \uc804\ud658\uc744 \ubcf4\uc7a5\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc11c\ub85c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ubc30\uc2e0.io \uacc4\uc815\uc744 \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud560 \ub54c \uc6d0\ud65c\ud55c \uc804\ud658\uc744 \ubcf4\uc7a5\ud558\ub824\uba74 \uba87 \uac00\uc9c0 \ud575\uc2ec \ub2e8\uacc4\uac00 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uccab\uc9f8, Google\uc774\ub098 Facebook\uacfc \uac19\uc774 \uc5ec\ub7ec \uc7a5\uce58\uc5d0\uc11c \uc27d\uac8c \uc561\uc138\uc2a4\ud560 \uc218 \uc788\ub3c4\ub85d \uacc4\uc815\uc744 \ubcf4\ud3b8\uc801\uc778 \ub85c\uadf8\uc778 \uc11c\ube44\uc2a4\uc5d0 \uc5f0\uacb0\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, Google Play\uc5d0 \uacc4\uc815\uc744 \uc5f0\uacb0\ud558\uba74 PC\uc640 \ubaa8\ubc14\uc77c \ubaa8\ub450\uc5d0\uc11c \uc6d0\ud65c\ud55c \ud50c\ub808\uc774\ub97c \uacbd\ud5d8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub458\uc9f8, \uac8c\uc784 \ub370\uc774\ud130(\uc9c4\ud589 \uc0c1\ud669, \uc131\ucde8\ub3c4, \uc778\ubca4\ud1a0\ub9ac \ud3ec\ud568)\uac00 \ud074\ub77c\uc6b0\ub4dc\uc640 \ub3d9\uae30\ud654\ub418\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. \uc774 \uc791\uc5c5\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \uac8c\uc784 \uc124\uc815 \uba54\ub274\ub97c \ud1b5\ud574 \uc218\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc14b\uc9f8, \ud638\ud658\uc131\uc744 \uc720\uc9c0\ud558\ub294 \ub370 \ud544\uc694\ud55c \ud50c\ub7ab\ud3fc\ubcc4 \uc5c5\ub370\uc774\ud2b8 \ub610\ub294 \ud328\uce58\ub97c \ud655\uc778\ud569\ub2c8\ub2e4. \ub610\ud55c \ud50c\ub7ab\ud3fc \uac04\uc5d0 \uc81c\uc5b4 \ub610\ub294 \uc778\ud130\ud398\uc774\uc2a4\uc5d0 \ucc28\uc774\uac00 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uace0 \uc124\uc815\uc744 \uc870\uc815\ud558\uc2ed\uc2dc\uc624. \uc774\ub7ec\ud55c \ub2e8\uacc4\ub97c \ub530\ub974\uba74 \ud50c\ub808\uc774\uc5b4\ub294 \uc5ec\ub7ec \uc7a5\uce58\uc5d0\uc11c \uc77c\uad00\ub41c \uacbd\ud5d8\uc744 \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ubc30\uc2e0.io\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc774\uba70, \uac8c\uc784 \uacbd\ud5d8\uc744 \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\uae4c?", "answer": "\ubc30\uc2e0.io\ub294 \ud638\uae30\uc2ec \ub9ce\uc740 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uac8c\uc784 \uacbd\ud5d8\uc744 \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\uc640 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub85c \uac00\ub4dd\ud569\ub2c8\ub2e4. \uc8fc\ubaa9\ud560 \ub9cc\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uc9c0\ub3c4\uc758 \ube44\ubc00 \uc7a5\uc18c\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\ub294 \ud76c\uadc0 \ubb34\uae30\uc778 '\ud669\uae08 \ucd1d'\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud50c\ub808\uc774\uc5b4\ub294 \uba40\ub9ac \ub5a8\uc5b4\uc9c4 \uc9c0\uc5ed\uc758 \ubd80\uc220 \uc218 \uc788\ub294 \ubcbd \ub4a4\uc5d0 \uc228\uaca8\uc838 \uc788\ub294 \uac83\uc744 \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc740 \uc77c\ub828\uc758 \uc218\uc218\uaed8\ub07c \uac19\uc740 \ud37c\uc990\uc744 \ud1b5\ud574\uc11c\ub9cc \uc811\uadfc\ud560 \uc218 \uc788\ub294 \uadc0\uc911\ud55c \uc804\ub9ac\ud488\uc774 \ub4e4\uc5b4 \uc788\ub294 '\ubbf8\uc2a4\ud130\ub9ac \ubc29'\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uc694\uc18c\ub294 \ub180\ub77c\uc6c0\uacfc \ud0d0\ud5d8 \uc694\uc18c\ub97c \ucd94\uac00\ud560 \ubfd0\ub9cc \uc544\ub2c8\ub77c \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uac8c\uc784\uc5d0\uc11c \uc774\uc810\uc744 \uc904 \uc218 \uc788\ub294 \uc2e4\uc9c8\uc801\uc778 \ubcf4\uc0c1\ub3c4 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ube44\ubc00\uc744 \ubc1c\uacac\ud558\uba74 \ud0d0\ud5d8 \uac10\uac01\uc744 \uc990\uae30\ub294 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uac8c\uc784 \uacbd\ud5d8\uc744 \ub354 \ub9e4\ub825\uc801\uc774\uace0 \ubcf4\ub78c\uc788\uac8c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
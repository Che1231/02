[{"question": "\u30d9\u30c8\u30e9\u30fc\u30eb\u30fb\u30a2\u30a4\u30aa\u306e\u521d\u5fc3\u8005\u5411\u3051\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u8fc5\u901f\u306b\u59cb\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d9\u30c8\u30e9\u30fc\u30eb\u30fb\u30a2\u30a4\u30aa\u3092\u8fc5\u901f\u306b\u958b\u59cb\u3059\u308b\u306b\u306f\u3001\u521d\u5fc3\u8005\u306e\u65b9\u3005\u306f\u307e\u305a\u57fa\u672c\u64cd\u4f5c\u306b\u6163\u308c\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u306e\u30b2\u30fc\u30e0\u306f\u4e3b\u306b\u30de\u30a6\u30b9\u3092\u4f7f\u3063\u3066\u79fb\u52d5\u3084\u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3\u3092\u884c\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u30af\u30ea\u30c3\u30af\u3059\u308b\u3068\u3001\u30a2\u30d0\u30bf\u30fc\u306f\u305d\u306e\u5834\u6240\u306b\u79fb\u52d5\u3057\u307e\u3059\u3002\u52a0\u3048\u3066\u3001\"Q\"\u30ad\u30fc\u306f\u30af\u30a4\u30c3\u30af\u30a2\u30af\u30b7\u30e7\u30f3\u3001\"E\"\u30ad\u30fc\u306f\u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3\u306b\u4f7f\u7528\u3067\u304d\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5927\u5e45\u306b\u9ad8\u901f\u5316\u3067\u304d\u307e\u3059\u3002\u30b2\u30fc\u30e0\u5185\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u304c\u826f\u3044\u7df4\u7fd2\u3067\u3059\u3002\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3067\u306f\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u79fb\u52d5\u3001\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3068\u306e\u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3\u3001\u7279\u6b8a\u80fd\u529b\u306e\u4f7f\u7528\u3068\u3044\u3063\u305f\u5b9f\u8df5\u7684\u306a\u7d4c\u9a13\u3092\u6307\u5c0e\u3057\u307e\u3059\u3002\u3053\u306e\u57fa\u790e\u7684\u306a\u77e5\u8b58\u306f\u3001\u30b2\u30fc\u30e0\u3092\u9032\u3081\u308b\u4e0a\u3067\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002"}, {"question": "\u30d9\u30c8\u30e9\u30fc\u30eb\u30fb\u30a2\u30a4\u30aa\u3067\u521d\u5fc3\u8005\u3068\u3057\u3066\u3088\u308a\u9577\u304f\u751f\u304d\u6b8b\u308b\u305f\u3081\u306e\u4e3b\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d9\u30c8\u30e9\u30fc\u30eb\u30fb\u30a2\u30a4\u30aa\u3067\u521d\u5fc3\u8005\u3068\u3057\u3066\u3088\u308a\u9577\u304f\u751f\u304d\u6b8b\u308b\u306b\u306f\u3001\u614e\u91cd\u306a\u30d7\u30ec\u30a4\u3068\u6226\u7565\u7684\u306a\u8a08\u753b\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u307e\u305a\u3001\u5468\u56f2\u306b\u6ce8\u610f\u3092\u6255\u3044\u3001\u4f8b\u3048\u3070\u3001\u7c21\u5358\u306b\u5f85\u3061\u4f0f\u305b\u3055\u308c\u308b\u5b64\u7acb\u3057\u305f\u5834\u6240\u3092\u907f\u3051\u3066\u304f\u3060\u3055\u3044\u3002\u6b21\u306b\u3001\u53ef\u80fd\u3067\u3042\u308c\u3070\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u30c1\u30fc\u30e0\u3092\u7d44\u3080\u3068\u3001\u8907\u6570\u3044\u308b\u65b9\u304c\u5b89\u5168\u3067\u3059\u3002\u7279\u5b9a\u306e\u6226\u7565\u3068\u3057\u3066\u306f\u3001\u30de\u30c3\u30d7\u306e\u4e2d\u5fc3\u90e8\u306e\u3088\u3046\u306a\u9ad8\u30ea\u30b9\u30af\u30a8\u30ea\u30a2\u3092\u79fb\u52d5\u3059\u308b\u969b\u306f\u3001\u30b0\u30eb\u30fc\u30d7\u306b\u8fd1\u3065\u304d\u7d9a\u3051\u308b\u3053\u3068\u3067\u3059\u3002\u7b2c\u4e09\u306b\u3001\u30ea\u30bd\u30fc\u30b9\u3092\u8ce2\u304f\u7ba1\u7406\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u5fc5\u8981\u306b\u5fdc\u3058\u3066\u3060\u3051\u56de\u5fa9\u30a2\u30a4\u30c6\u30e0\u3092\u4f7f\u7528\u3057\u3001\u88dc\u7d66\u30a2\u30a4\u30c6\u30e0\u306e\u843d\u4e0b\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u3089\u306e\u624b\u9806\u306b\u5f93\u3046\u3053\u3068\u3067\u3001\u521d\u5fc3\u8005\u306e\u65b9\u3005\u306f\u30b2\u30fc\u30e0\u3067\u751f\u5b58\u6642\u9593\u3092\u5927\u5e45\u306b\u4f38\u3070\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d9\u30c8\u30e9\u30fc\u30eb\u30fb\u30a2\u30a4\u30aa\u3067\u3001\u521d\u5fc3\u8005\u5411\u3051\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u305f\u3081\u306b\u8abf\u6574\u3059\u3079\u304d\u8a2d\u5b9a\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d9\u30c8\u30e9\u30fc\u30eb\u30fb\u30a2\u30a4\u30aa\u3067\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u91cd\u8981\u306a\u8a2d\u5b9a\u3092\u8abf\u6574\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u307e\u305a\u3001\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3092\u300c\u4e2d\u300d\u307e\u305f\u306f\u300c\u4f4e\u300d\u306b\u4e0b\u3052\u3066\u3001\u7279\u306b\u53e4\u3044\u30cf\u30fc\u30c9\u30a6\u30a7\u30a2\u3067\u306f\u3001\u30b9\u30e0\u30fc\u30ba\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u78ba\u4fdd\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30c6\u30af\u30b9\u30c1\u30e3\u54c1\u8cea\u3084\u5f71\u306e\u8a73\u7d30\u3092\u6e1b\u3089\u3059\u3053\u3068\u3067\u3001\u30d5\u30ec\u30fc\u30e0\u30ec\u30fc\u30c8\u3092\u5927\u5e45\u306b\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u7b2c\u4e8c\u306b\u3001\u6700\u9ad8\u306e\u8996\u899a\u4f53\u9a13\u3092\u5f97\u308b\u305f\u3081\u306b\u3001\u89e3\u50cf\u5ea6\u3092\u30e2\u30cb\u30bf\u306e\u30cd\u30a4\u30c6\u30a3\u30d6\u89e3\u50cf\u5ea6\u306b\u5408\u308f\u305b\u3066\u8abf\u6574\u3057\u307e\u3059\u3002\u7b2c\u4e09\u306b\u3001\u300c\u5782\u76f4\u540c\u671f\uff08VSync\uff09\u300d\u3092\u6709\u52b9\u306b\u3057\u3066\u3001\u6fc0\u3057\u3044\u5834\u9762\u3067\u306e\u753b\u9762\u306e\u30c6\u30a3\u30a2\u30ea\u30f3\u30b0\u3092\u9632\u304e\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u8996\u91ce\u89d2\uff08FOV\uff09\u3092\u5c11\u3057\u6e1b\u3089\u3059\u3053\u3068\u3092\u691c\u8a0e\u3057\u3001\u8996\u8a8d\u6027\u3092\u3042\u307e\u308a\u72a0\u7272\u306b\u3059\u308b\u3053\u3068\u306a\u304f\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002\u3053\u308c\u3089\u8abf\u6574\u306b\u3088\u308a\u3001\u521d\u5fc3\u8005\u306e\u65b9\u3005\u306f\u3088\u308a\u5b89\u5b9a\u3057\u3066\u53cd\u5fdc\u6027\u306e\u9ad8\u3044\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u697d\u3057\u3080\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d9\u30c8\u30e9\u30fc\u30eb\u30fb\u30a2\u30a4\u30aa\u3067\u3001\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u88cf\u5207\u308a\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u306a\u305c\u91cd\u8981\u306a\u306e\u3067\u3059\u304b\uff1f", "answer": "\u30d9\u30c8\u30e9\u30fc\u30eb\u30fb\u30a2\u30a4\u30aa\u3067\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u88cf\u5207\u308a\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u91cd\u8981\u3067\u3059\u3002\u306a\u305c\u306a\u3089\u3001\u305d\u308c\u306f\u30b2\u30fc\u30e0\u306e\u30c0\u30a4\u30ca\u30df\u30af\u30b9\u3092\u6839\u672c\u7684\u306b\u5909\u3048\u308b\u304b\u3089\u3067\u3059\u3002\u88cf\u5207\u308a\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u3088\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u9663\u55b6\u3092\u5207\u308a\u66ff\u3048\u3001\u5473\u65b9\u3092\u6575\u306b\u5909\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u6226\u7565\u7684\u306a\u512a\u4f4d\u6027\u3092\u5f97\u308b\u305f\u3081\u3001\u307e\u305f\u306f\u7279\u5b9a\u306e\u76ee\u6a19\u3092\u9054\u6210\u3059\u308b\u305f\u3081\u306b\u3001\u30c1\u30fc\u30e0\u3092\u88cf\u5207\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u5e38\u306b\u72b6\u6cc1\u8a8d\u8b58\u3092\u7dad\u6301\u3057\u3001\u5358\u72ec\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u5b8c\u5168\u306b\u4fe1\u983c\u3057\u306a\u3044\u3053\u3068\u3067\u3001\u88cf\u5207\u308a\u306e\u53ef\u80fd\u6027\u306b\u5099\u3048\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u52a0\u3048\u3066\u3001\u6f5c\u5728\u7684\u306a\u88cf\u5207\u308a\u306b\u5bfe\u6297\u3059\u308b\u6226\u7565\u3092\u958b\u767a\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u4e00\u6642\u7684\u306a\u540c\u76df\u3092\u7d44\u3093\u3060\u308a\u3001\u602a\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u304b\u3089\u8ddd\u96e2\u3092\u7f6e\u304f\u306a\u3069\u3067\u3059\u3002\u3053\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u3067\u3001\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30b2\u30fc\u30e0\u3067\u5927\u304d\u306a\u30a2\u30c9\u30d0\u30f3\u30c6\u30fc\u30b8\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30d9\u30c8\u30e9\u30fc\u30eb\u30fb\u30a2\u30a4\u30aa\u3067\u74b0\u5883\u3092\u3069\u306e\u3088\u3046\u306b\u52b9\u679c\u7684\u306b\u6d3b\u7528\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d9\u30c8\u30e9\u30fc\u30eb\u30fb\u30a2\u30a4\u30aa\u3067\u74b0\u5883\u3092\u52b9\u679c\u7684\u306b\u6d3b\u7528\u3059\u308b\u306b\u306f\u3001\u30de\u30c3\u30d7\u30ec\u30a4\u30a2\u30a6\u30c8\u3068\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306e\u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3\u3092\u6df1\u304f\u7406\u89e3\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u7279\u5b9a\u306e\u30a8\u30ea\u30a2\u306f\u6575\u304b\u3089\u306e\u653b\u6483\u304b\u3089\u96a0\u308c\u308b\u96a0\u308c\u5834\u6240\u3092\u63d0\u4f9b\u3057\u3001\u4ed6\u306e\u30a8\u30ea\u30a2\u306f\u3088\u308a\u826f\u3044\u8996\u754c\u306e\u305f\u3081\u306e\u9ad8\u5730\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u5e38\u306b\u3053\u308c\u3089\u306e\u6226\u7565\u7684\u306a\u5834\u6240\u3092\u8a8d\u8b58\u3057\u3001\u305d\u308c\u3092\u81ea\u5206\u306e\u5229\u76ca\u306e\u305f\u3081\u306b\u6d3b\u7528\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30c8\u30e9\u30c3\u30d7\u3084\u7206\u767a\u6027\u306e\u3042\u308b\u6a3d\u3068\u3044\u3063\u305f\u74b0\u5883\u306e\u5371\u967a\u7269\u306f\u3001\u6575\u3092\u6392\u9664\u3059\u308b\u305f\u3081\u306b\u4f7f\u7528\u3067\u304d\u307e\u3059\u3002\u5177\u4f53\u7684\u306a\u6226\u7565\u3068\u3057\u3066\u306f\u3001\u81ea\u5206\u81ea\u8eab\u3092\u56ee\u306b\u3057\u3066\u76f8\u624b\u3092\u3053\u308c\u3089\u306e\u5371\u967a\u7269\u306b\u8a98\u3044\u8fbc\u3080\u3053\u3068\u3067\u3059\u3002\u307e\u305f\u3001\u56de\u5fa9\u30a2\u30a4\u30c6\u30e0\u3084\u6b66\u5668\u306a\u3069\u306e\u91cd\u8981\u306a\u30a2\u30a4\u30c6\u30e0\u306e\u51fa\u73fe\u5730\u70b9\u3092\u77e5\u308b\u3053\u3068\u3067\u3001\u5927\u304d\u306a\u5229\u70b9\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u74b0\u5883\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u306b\u3088\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u6575\u3092\u51fa\u3057\u629c\u304d\u3001\u51fa\u3057\u629c\u304f\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d9\u30c8\u30e9\u30fc\u30eb\u30fb\u30a2\u30a4\u30aa\u3067\u3001\u3055\u307e\u3056\u307e\u306a\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u6700\u9069\u306a\u88c5\u5099\u306e\u7d44\u307f\u5408\u308f\u305b\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d9\u30c8\u30e9\u30fc\u30eb\u30fb\u30a2\u30a4\u30aa\u3067\u6700\u9069\u306a\u88c5\u5099\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u9078\u3076\u3053\u3068\u306f\u3001\u597d\u307f\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u3002\u653b\u6483\u7684\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\u3084\u7d20\u65e9\u304f\u88c5\u586b\u3067\u304d\u308b\u62f3\u9283\u306a\u3069\u306e\u9ad8\u30c0\u30e1\u30fc\u30b8\u6b66\u5668\u306e\u7d44\u307f\u5408\u308f\u305b\u304c\u826f\u3044\u3067\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\u306f\u8fd1\u63a5\u6226\u95d8\u306b\u6700\u9069\u3067\u3001\u62f3\u9283\u306f\u7d20\u65e9\u3044\u8ffd\u6483\u30b7\u30e7\u30c3\u30c8\u306b\u4f7f\u7528\u3067\u304d\u307e\u3059\u3002\u9632\u5fa1\u7684\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30b9\u30ca\u30a4\u30d1\u30fc\u30e9\u30a4\u30d5\u30eb\u3084\u533b\u7642\u30ad\u30c3\u30c8\u306a\u3069\u306e\u30b5\u30dd\u30fc\u30c8\u30a2\u30a4\u30c6\u30e0\u304c\u6700\u9069\u3067\u3059\u3002\u30b9\u30ca\u30a4\u30d1\u30fc\u30e9\u30a4\u30d5\u30eb\u306f\u512a\u308c\u305f\u652f\u63f4\u706b\u529b\u3092\u63d0\u4f9b\u3057\u3001\u533b\u7642\u30ad\u30c3\u30c8\u306f\u6301\u7d9a\u7684\u306a\u751f\u5b58\u3092\u78ba\u4fdd\u3057\u307e\u3059\u3002\u30b9\u30c6\u30eb\u30b9\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30b5\u30a4\u30ec\u30f3\u30b5\u30fc\u4ed8\u304d\u6b66\u5668\u3084\u7159\u5e55\u30b0\u30ec\u30cd\u30fc\u30c9\u3092\u5bc6\u304b\u306b\u884c\u52d5\u306b\u6700\u9069\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b5\u30a4\u30ec\u30f3\u30b5\u30fc\u4ed8\u304d\u62f3\u9283\u306f\u9759\u304b\u306a\u6392\u9664\u306b\u9069\u3057\u3066\u304a\u308a\u3001\u7159\u5e55\u30b0\u30ec\u30cd\u30fc\u30c9\u306f\u6c17\u3092\u7d1b\u3089\u308f\u305b\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u5408\u308f\u305b\u3066\u88c5\u5099\u3092\u9078\u629e\u3059\u308b\u3053\u3068\u306f\u3001\u30b2\u30fc\u30e0\u306b\u304a\u3051\u308b\u6709\u52b9\u6027\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d9\u30c8\u30e9\u30fc\u30eb\u30fb\u30a2\u30a4\u30aa\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u3069\u306e\u3088\u3046\u306a\u8981\u56e0\u304c\u305d\u308c\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d9\u30c8\u30e9\u30fc\u30eb\u30fb\u30a2\u30a4\u30aa\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30ad\u30eb/\u30c7\u30b9\u6bd4\u3084\u52dd\u5229\u7387\u306a\u3069\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u6307\u6a19\u306b\u57fa\u3065\u3044\u3066\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u3092\u8a55\u4fa1\u3059\u308b\u3053\u3068\u3067\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u7af6\u4e89\u529b\u306e\u3042\u308b\u30de\u30c3\u30c1\u30f3\u30b0\u3092\u884c\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u9ad8\u3044\u52dd\u5229\u7387\u3092\u6301\u3064\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u540c\u69d8\u306e\u30b9\u30ad\u30eb\u3092\u6301\u3064\u76f8\u624b\u3068\u4e00\u81f4\u3059\u308b\u53ef\u80fd\u6027\u304c\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002\u7b2c\u4e8c\u306b\u3001\u30b7\u30b9\u30c6\u30e0\u306f\u8fc5\u901f\u306a\u30de\u30c3\u30c1\u30f3\u30b0\u6642\u9593\u3092\u78ba\u4fdd\u3059\u308b\u305f\u3081\u306b\u3001\u30a2\u30af\u30c6\u30a3\u30d6\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u6570\u3092\u8003\u616e\u3057\u307e\u3059\u3002\u7b2c\u4e09\u306b\u3001\u9045\u5ef6\u3068\u63a5\u7d9a\u54c1\u8cea\u3092\u6700\u9069\u5316\u3059\u308b\u305f\u3081\u306b\u3001\u6642\u9593\u5e2f\u3068\u30b5\u30fc\u30d0\u30fc\u306e\u5834\u6240\u3092\u8003\u616e\u3057\u307e\u3059\u3002\u52a0\u3048\u3066\u3001\u30b7\u30b9\u30c6\u30e0\u306f\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u91cd\u8996\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304b\u30bd\u30ed\u30d7\u30ec\u30a4\u30e4\u30fc\u306a\u3069\u3001\u985e\u4f3c\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u3084\u76ee\u6a19\u3092\u6301\u3064\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u512a\u5148\u7684\u306b\u30b0\u30eb\u30fc\u30d7\u5316\u3059\u308b\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u8981\u56e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u906d\u9047\u3059\u308b\u3067\u3042\u308d\u3046\u30de\u30c3\u30c1\u30f3\u30b0\u306e\u7a2e\u985e\u3092\u4e88\u6e2c\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30d9\u30c8\u30e9\u30fc\u30eb\u30fb\u30a2\u30a4\u30aa\u306e\u56de\u5fa9\u3068\u30c0\u30e1\u30fc\u30b8\u30b7\u30b9\u30c6\u30e0\u306e\u6839\u5e95\u306b\u3042\u308b\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d9\u30c8\u30e9\u30fc\u30eb\u30fb\u30a2\u30a4\u30aa\u306e\u56de\u5fa9\u3068\u30c0\u30e1\u30fc\u30b8\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u6700\u9069\u5316\u3059\u308b\u305f\u3081\u306b\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u7406\u89e3\u3059\u3079\u304d\u3044\u304f\u3064\u304b\u306e\u6839\u5e95\u306b\u3042\u308b\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u3088\u3063\u3066\u652f\u914d\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u307e\u305a\u3001\u4f53\u529b\uff08HP\uff09\u306f\u6709\u9650\u3067\u3042\u308a\u3001\u30de\u30c3\u30d7\u4e0a\u306b\u914d\u7f6e\u3055\u308c\u305f\u56de\u5fa9\u30a2\u30a4\u30c6\u30e0\u3092\u4f7f\u3063\u3066\u88dc\u5145\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u4e00\u822c\u7684\u306a\u56de\u5fa9\u30a2\u30a4\u30c6\u30e0\u306f50\u306e\u4f53\u529b\uff08HP\uff09\u3092\u56de\u5fa9\u3057\u307e\u3059\u3002\u7b2c\u4e8c\u306b\u3001\u7570\u306a\u308b\u6b66\u5668\u306f\u69d8\u3005\u306a\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\u306f1\u767a\u3042\u305f\u308a100\u306e\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u3001\u62f3\u9283\u306f25\u306e\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u307e\u3059\u3002\u7b2c\u4e09\u306b\u3001\u30a2\u30fc\u30de\u30fc\u306f\u88ab\u30c0\u30e1\u30fc\u30b8\u306e\u4e00\u90e8\u3092\u8efd\u6e1b\u3057\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u751f\u5b58\u6027\u3092\u52b9\u679c\u7684\u306b\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u6226\u95d8\u4e2d\u306b\u60c5\u5831\u3092\u6d3b\u7528\u3059\u308b\u969b\u306b\u3001\u9ad8\u30c0\u30e1\u30fc\u30b8\u6b66\u5668\u3092\u512a\u5148\u3059\u308b\u3001\u307e\u305f\u306fHP\u304c\u4f4e\u3044\u3068\u304d\u306b\u56de\u5fa9\u30a2\u30a4\u30c6\u30e0\u3092\u63a2\u3059\u306a\u3069\u306e\u3001\u3053\u308c\u3089\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u8a8d\u8b58\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002\u3053\u308c\u3089\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u3067\u5927\u304d\u306a\u30a2\u30c9\u30d0\u30f3\u30c6\u30fc\u30b8\u3092\u5f97\u308b\u3053\u3068\u304c\u53ef\u80fd\u3067\u3059\u3002"}, {"question": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u30d9\u30c8\u30e9\u30fc\u30eb\u30fb\u30a2\u30a4\u30aa\u306e\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u79fb\u884c\u3059\u308b\u3068\u304d\u306e\u30b9\u30e0\u30fc\u30ba\u306a\u79fb\u884c\u3092\u3069\u306e\u3088\u3046\u306b\u78ba\u4fdd\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u30d9\u30c8\u30e9\u30fc\u30eb\u30fb\u30a2\u30a4\u30aa\u306e\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30b9\u30e0\u30fc\u30ba\u306b\u79fb\u884c\u3059\u308b\u306b\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u91cd\u8981\u306a\u624b\u9806\u304c\u3042\u308a\u307e\u3059\u3002\u307e\u305a\u3001\u30a2\u30ab\u30a6\u30f3\u30c8\u3092Google\u3084Facebook\u306a\u3069\u306e\u30e6\u30cb\u30d0\u30fc\u30b5\u30eb\u30ed\u30b0\u30a4\u30f3\u30b5\u30fc\u30d3\u30b9\u306b\u30ea\u30f3\u30af\u3055\u305b\u308b\u3053\u3068\u3092\u304a\u52e7\u3081\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u7c21\u5358\u306b\u5229\u7528\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001Google Play\u306b\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30ea\u30f3\u30af\u3059\u308b\u3053\u3068\u3067\u3001PC\u3068\u30e2\u30d0\u30a4\u30eb\u306e\u4e21\u65b9\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u30b7\u30fc\u30e0\u30ec\u30b9\u306b\u30d7\u30ec\u30a4\u3067\u304d\u307e\u3059\u3002\u7b2c\u4e8c\u306b\u3001\u9032\u6357\u72b6\u6cc1\u3001\u5b9f\u7e3e\u3001\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u3092\u542b\u3080\u3059\u3079\u3066\u306e\u30b2\u30fc\u30e0\u30c7\u30fc\u30bf\u304c\u30af\u30e9\u30a6\u30c9\u3068\u540c\u671f\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u306f\u901a\u5e38\u3001\u30b2\u30fc\u30e0\u306e\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u3067\u884c\u3046\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u7b2c\u4e09\u306b\u3001\u4e92\u63db\u6027\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u5fc5\u8981\u306a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u56fa\u6709\u306e\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3084\u30d1\u30c3\u30c1\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3055\u3089\u306b\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u306e\u64cd\u4f5c\u3084\u30a4\u30f3\u30bf\u30fc\u30d5\u30a7\u30fc\u30b9\u306e\u9055\u3044\u306b\u6ce8\u610f\u3057\u3001\u5fc5\u8981\u306b\u5fdc\u3058\u3066\u8a2d\u5b9a\u3092\u8abf\u6574\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u3089\u306e\u624b\u9806\u306b\u5f93\u3046\u3053\u3068\u306b\u3088\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3055\u307e\u3056\u307e\u306a\u30c7\u30d0\u30a4\u30b9\u3067\u4e00\u8cab\u3057\u305f\u4f53\u9a13\u3092\u697d\u3057\u3080\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d9\u30c8\u30e9\u30fc\u30eb\u30fb\u30a2\u30a4\u30aa\u3067\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u4f55\u3067\u3042\u308a\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4f53\u9a13\u3092\u3069\u306e\u3088\u3046\u306b\u5411\u4e0a\u3055\u305b\u307e\u3059\u304b\uff1f", "answer": "\u30d9\u30c8\u30e9\u30fc\u30eb\u30fb\u30a2\u30a4\u30aa\u306b\u306f\u3001\u597d\u5947\u5fc3\u65fa\u76db\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u305f\u3081\u306b\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4f53\u9a13\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3068\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u6570\u591a\u304f\u3042\u308a\u307e\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306e1\u3064\u306f\u3001\u300c\u30b4\u30fc\u30eb\u30c7\u30f3\u30ac\u30f3\u300d\u3067\u3059\u3002\u3053\u308c\u306f\u3001\u30de\u30c3\u30d7\u4e0a\u306e\u79d8\u5bc6\u306e\u5834\u6240\u3067\u898b\u3064\u304b\u308b\u3001\u5e0c\u5c11\u306a\u6b66\u5668\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u96e2\u308c\u305f\u30a8\u30ea\u30a2\u306b\u3042\u308b\u58ca\u308c\u3084\u3059\u3044\u58c1\u306e\u5f8c\u308d\u306b\u96a0\u308c\u3066\u3044\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u3082\u3046\u4e00\u3064\u306e\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u306f\u300c\u8b0e\u306e\u90e8\u5c4b\u300d\u3067\u3001\u4fa1\u5024\u3042\u308b\u6226\u5229\u54c1\u304c\u5165\u3063\u3066\u3044\u307e\u3059\u304c\u3001\u4e00\u9023\u306e\u8b0e\u306e\u8b0e\u3092\u89e3\u304f\u3053\u3068\u306b\u3088\u3063\u3066\u306e\u307f\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u96a0\u3055\u308c\u305f\u8981\u7d20\u306f\u3001\u9a5a\u304d\u3068\u63a2\u6c42\u306e\u8981\u7d20\u3092\u8ffd\u52a0\u3059\u308b\u3060\u3051\u3067\u306a\u304f\u3001\u30b2\u30fc\u30e0\u3067\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u6709\u5229\u306a\u5b9f\u8cea\u7684\u306a\u5831\u916c\u3082\u63d0\u4f9b\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u79d8\u5bc6\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u3001\u767a\u898b\u306e\u559c\u3073\u3092\u5473\u308f\u3046\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u305f\u3081\u306e\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u3088\u308a\u9b45\u529b\u7684\u3067\u5831\u308f\u308c\u308b\u3082\u306e\u306b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}]
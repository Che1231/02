[{"question": "Homescapes\uc5d0\uc11c \ub808\ubca8\uc744 \uc5b4\ub5bb\uac8c \uc644\ub8cc\ud558\uace0 \ucd08\ubcf4\uc790\ub97c \uc704\ud55c \uae30\ubcf8 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Homescapes\uc5d0\uc11c \ub808\ubca8\uc744 \uc644\ub8cc\ud558\ub824\uba74 \ubcf4\ub4dc\uc5d0\uc11c \ub3d9\uc77c\ud55c \uc544\uc774\ud15c \uc138 \uac1c \uc774\uc0c1\uc744 \uc77c\uce58\uc2dc\ucf1c\uc57c \ud569\ub2c8\ub2e4. \ucd08\ubcf4\uc790\ub77c\uba74 \ub85c\ucf13\uc774\ub098 \ud3ed\ud0c4\uacfc \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc0dd\uc131\ud558\uae30 \uc704\ud574 \ub124 \uac1c \uc774\uc0c1\uc758 \uc544\uc774\ud15c\uc744 \uc77c\uce58\uc2dc\ud0a4\ub294 \ub370 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc77c\ub82c\ub85c \ub124 \uac1c\uc758 \uc0ac\ud0d5\uc744 \uc77c\uce58\uc2dc\ud0a4\uba74 \uc804\uccb4 \ud589\uc744 \uc9c0\uc6b0\ub294 \ub85c\ucf13\uc774 \uc0dd\uc131\ub429\ub2c8\ub2e4. \ub2e8\uacc4 1: \ub124 \uac1c \uc774\uc0c1\uc758 \uc544\uc774\ud15c\uc744 \uc77c\uce58\uc2dc\ud0a4\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ubcf4\ub4dc\uc758 \ud070 \ubd80\ubd84\uc744 \uc9c0\uc6c1\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc0c1\uc790\ub098 \uccb4\uc778\uacfc \uac19\uc740 \uc7a5\uc560\ubb3c\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uc81c\uac70\ud558\uc5ec \ub354 \ub2ff\uae30 \uc5b4\ub824\uc6b4 \uc544\uc774\ud15c\uc5d0 \uc811\uadfc\ud569\ub2c8\ub2e4."}, {"question": "Homescapes\uc758 \uc77c\ubd80 \ub808\ubca8\uc774 \uc774\uae30\uae30 \uc5b4\ub824\uc6cc \ubcf4\uc774\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5a4 \uace0\uae09 \uc804\ub7b5\uc774 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Homescapes\uc758 \uc77c\ubd80 \ub808\ubca8\uc740 \uc81c\ud55c\ub41c \uc774\ub3d9 \ud69f\uc218\ub098 \ubcf5\uc7a1\ud55c \uc7a5\uc560\ubb3c\ub85c \uc778\ud574 \uc5b4\ub824\uc6b8 \uc218 \uc788\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \ud30c\uc6cc\uc5c5\uc758 \uc870\ud569\uc744 \ub9cc\ub4dc\ub294 \ub370 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub85c\ucf13\uacfc \ud3ed\ud0c4\uc744 \uacb0\ud569\ud558\uba74 \ubcf4\ub4dc\uc758 \ud070 \uc601\uc5ed\uc744 \uc9c0\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \ud30c\uc6cc\uc5c5 \uc870\ud569\uc744 \ub9cc\ub4e4\ub3c4\ub85d \uc774\ub3d9\uc744 \uacc4\ud68d\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ud30c\uc6cc\uc5c5\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc5ec \ud2b9\uc815 \uc7a5\uc560\ubb3c\uc744 \ud0c0\uac9f\ud305\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ub808\ubca8 \uc644\ub8cc \uc9c1\uc804\uc5d0 \uc911\uc694\ud55c \uc21c\uac04\uc5d0 \ubd80\uc2a4\ud130\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "Homescapes\uc758 \uc8fc\uc694 \uba54\ucee4\ub2c8\uc998\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uac1c\uc120\ud558\uae30 \uc704\ud574 \uc774\ud574\ud574\uc57c \ud558\ub294 \ud575\uc2ec \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Homescapes\uc758 \ud575\uc2ec \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \uac8c\uc784 \ud50c\ub808\uc774 \uac1c\uc120\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc774 \uac8c\uc784\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc544\uc774\ud15c\uc744 \uc81c\uac70\ud558\uc5ec \uc9c4\ud589\ud558\ub294 \ub9e4\uce58 3 \ud37c\uc990\uc5d0 \uc911\uc810\uc744 \ub461\ub2c8\ub2e4. \uac01 \ub808\ubca8\uc5d0\ub294 \ud2b9\uc815 \ubaa9\ud45c\uac00 \uc788\uc73c\uba70, \ud2b9\uc815 \uc544\uc774\ud15c\uc744 \uc218\uc9d1\ud558\uac70\ub098 \uc7a5\uc560\ubb3c\uc744 \uc81c\uac70\ud558\ub294 \uac83\uc774 \ubaa9\ud45c\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucc3b\uc794\uc744 \uc218\uc9d1\ud574\uc57c \ud558\ub294 \ub808\ubca8\uc5d0\uc11c \ucc3b\uc794\uc744 \uc9c1\uc811 \ud0c0\uac9f\ud305\ud558\ub294 \ub9e4\uce58\uc5d0 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \ub610\ud55c \uc774 \uac8c\uc784\uc5d0\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \ub808\ubca8\uc5d0\uc11c \uc5bb\uc740 \ubcc4\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc9d1\uc744 \uc7a5\uc2dd\ud558\uace0 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \uc8fc\ud0dd \uac1c\uc870 \uce21\uba74\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc774\uc911 \uba54\ucee4\ub2c8\uc998\uc740 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uae4a\uc774\uc640 \ub2e4\uc591\uc131\uc744 \ub354\ud569\ub2c8\ub2e4."}, {"question": "Homescapes\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\ub978 \uae30\uae30 \uac04\uc5d0 \uc804\uc1a1\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc774\uba70, \ubb34\uc5c7\uc5d0 \uc720\uc758\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "Homescapes\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\ub978 \uae30\uae30 \uac04\uc5d0 \uc804\uc1a1\ud558\ub824\uba74 \ub450 \uae30\uae30 \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. Facebook \ub610\ub294 Apple/Google \uacc4\uc815\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, iPhone\uc5d0\uc11c Android \uae30\uae30\ub85c \uc804\ud658\ud558\ub294 \uacbd\uc6b0 \ub3d9\uc77c\ud55c Facebook \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uc5ec \uc911\ub2e8\ud55c \uacf3\ubd80\ud130 \uacc4\uc18d \uc9c4\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc77c\ubd80 \uc778\uc571 \uad6c\ub9e4\uac00 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \uc804\uc1a1\ub418\uc9c0 \uc54a\uc744 \uc218 \uc788\uc73c\ubbc0\ub85c \uc790\uc138\ud55c \uc9c0\uce68\uc740 \uac8c\uc784\uc758 \uc9c0\uc6d0 \ud398\uc774\uc9c0\ub97c \ud655\uc778\ud558\uc2ed\uc2dc\uc624."}, {"question": "Homescapes\uc5d0 \ud50c\ub808\uc774\uc5b4\uac00 \ubaa8\ub974\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Homescapes\uc5d0\ub294 \uc7ac\ubbf8\ub97c \ub354\ud558\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uac00\ub4dd\ud569\ub2c8\ub2e4. \uc8fc\ubaa9\ud560 \ub9cc\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uc8fc\ud0dd \uac1c\uc870 \uc7a5\uba74\uc758 \ud2b9\uc815 \uc544\uc774\ud15c\uacfc \uc0c1\ud638 \uc791\uc6a9\ud560 \uc218 \uc788\ub294 \uae30\ub2a5\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac70\uc2e4\uc5d0 \uc788\ub294 \uace0\uc591\uc774\ub97c \ud074\ub9ad\ud558\uba74 \uadc0\uc5ec\uc6b4 \uc560\ub2c8\uba54\uc774\uc158\uc774 \ud2b8\ub9ac\uac70\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \uc77c\ubd80 \ub808\ubca8\uc5d0\ub294 \ud2b9\uc815 \ud328\ud134\uc73c\ub85c \ud2b9\uc815 \ub9e4\uce58\ub97c \ud558\uc5ec \ud65c\uc131\ud654\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ud30c\uc6cc\uc5c5\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uae30\ub2a5\uc744 \ud0d0\uc0c9\ud558\uba74 \uac8c\uc784 \uacbd\ud5d8\uc774 \ub354 \ud48d\ubd80\ud558\uace0 \uc990\uac70\uc6cc\uc9d1\ub2c8\ub2e4."}, {"question": "Homescapes\uc5d0\uc11c \uc5b4\ub824\uc6b4 \ub808\ubca8\uc744 \uc9c0\uc6b0\ub294 \ub370 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ud30c\uc6cc\uc5c5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Homescapes\uc5d0\uc11c \uc5b4\ub824\uc6b4 \ub808\ubca8\uc744 \uc9c0\uc6b0\ub294 \ub370 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ud30c\uc6cc\uc5c5\uc740 \ubb34\uc9c0\uac1c \uacf5, \ub85c\ucf13 \ubc0f \ud3ed\ud0c4\uc785\ub2c8\ub2e4. \ubb34\uc9c0\uac1c \uacf5\uc740 \ubaa8\ub4e0 \uc544\uc774\ud15c\uacfc \uc77c\uce58\uc2dc\ucf1c \ubcf4\ub4dc\uc5d0\uc11c \ud574\ub2f9 \uc544\uc774\ud15c\uc758 \ubaa8\ub4e0 \uc778\uc2a4\ud134\uc2a4\ub97c \uc9c0\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubb34\uc9c0\uac1c \uacf5\uc744 \ucc3b\uc794\uacfc \uc77c\uce58\uc2dc\ud0a4\uba74 \ubaa8\ub4e0 \ucc3b\uc794\uc774 \uc9c0\uc6cc\uc9d1\ub2c8\ub2e4. \ub85c\ucf13\uc740 \uc804\uccb4 \ud589 \ub610\ub294 \uc5f4\uc744 \uc9c0\uc6b0\uace0 \ud3ed\ud0c4\uc740 3x3 \uc601\uc5ed\uc744 \uc9c0\uc6c1\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud30c\uc6cc\uc5c5\uc744 \uacb0\ud569\ud558\uba74 \ub354 \uac15\ub825\ud55c \ud6a8\uacfc\ub97c \ucc3d\ucd9c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubb34\uc9c0\uac1c \uacf5\uacfc \ub85c\ucf13\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc5ec\ub7ec \ud589\uc758 \ud2b9\uc815 \uc544\uc774\ud15c\uc744 \uc9c0\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Homescapes\uc758 \ubcc4 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \uc5b4\ub5bb\uac8c \ubcc4\uc744 \ucd5c\ub300\ud55c \ub9ce\uc774 \ubaa8\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Homescapes\uc758 \ubcc4 \uc2dc\uc2a4\ud15c\uc744 \ud1b5\ud574 \ud50c\ub808\uc774\uc5b4\ub294 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uc5ec \ubcc4\uc744 \uc5bb\uc744 \uc218 \uc788\uc73c\uba70, \uc774 \ubcc4\uc740 \uc9d1\uc744 \uac1c\uc870\ud558\uace0 \uc7a5\uc2dd\ud558\ub294 \ub370 \uc0ac\uc6a9\ub429\ub2c8\ub2e4. \ubcc4\uc744 \ucd5c\ub300\ud55c \ub9ce\uc774 \ubaa8\uc73c\ub824\uba74 \uac00\ub2a5\ud55c \ud55c \uc801\uc740 \uc774\ub3d9 \ud69f\uc218\ub85c \ub808\ubca8\uc744 \uc644\ub8cc\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \uc774\ub807\uac8c \ud558\uba74 \ubcf4\ub108\uc2a4 \ubcc4\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc138 \ubc88\uc758 \uc774\ub3d9\uc744 \ub0a8\uaca8\ub450\uace0 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uba74 \ucd94\uac00 \ubcc4\uc774 \uc81c\uacf5\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \ud2b9\ubcc4 \uc774\ubca4\ud2b8 \ubc0f \uc77c\uc77c \ucc4c\ub9b0\uc9c0\uc5d0 \ucc38\uc5ec\ud558\uba74 \ubcc4\uc744 \uc5bb\uc744 \uc218 \uc788\ub294 \ucd94\uac00 \uae30\ud68c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ud6a8\uacfc\uc801\uc778 \uac1c\uc870\uc5d0 \uc6b0\uc120\uc21c\uc704\ub97c \uc815\ud558\uc5ec \ubcc4\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\uba74 \uac8c\uc784 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Homescapes\uc5d0\uc11c \ubd80\uc2a4\ud130\ub97c \uad00\ub9ac\ud558\ub294 \uac00\uc7a5 \uc88b\uc740 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b8\uc81c \uc0ac\uc6a9\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "Homescapes\uc5d0\uc11c \ubd80\uc2a4\ud130\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\uba74 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc744 \uc644\ub8cc\ud560 \uac00\ub2a5\uc131\uc774 \ud06c\uac8c \ub192\uc544\uc9d1\ub2c8\ub2e4. \ubd80\uc2a4\ud130\ub294 \ub808\ubca8 \uc644\ub8cc \uc9c1\uc804\uc5d0 \uc870\uae08\uc758 \ub3c4\uc6c0\uc774 \ud544\uc694\ud560 \ub54c, \ud2b9\ud788 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc644\uace0\ud55c \uc7a5\uc560\ubb3c\uc744 \uc81c\uac70\ud558\uac70\ub098 \uc911\uc694\ud55c \ud30c\uc6cc\uc5c5\uc744 \uc0dd\uc131\ud558\uae30 \uc704\ud574 \ubd80\uc2a4\ud130\ub97c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 1: \uc9c0\uc18d\uc801\uc73c\ub85c \uc5b4\ub824\uc6c0\uc744 \uacaa\ub294 \ub808\ubca8\uc5d0 \ubd80\uc2a4\ud130\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ubd80\uc2a4\ud130\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud30c\uc6cc\uc5c5\uc744 \uc0dd\uc131\ud558\uac70\ub098 \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4. \ub2e8\uacc4 3: \ubd80\uc2a4\ud130\ub97c \ud30c\uc6cc\uc5c5\uacfc \uacb0\ud569\ud558\uc5ec \ucd5c\ub300 \ud6a8\uacfc\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ubc29\uc2dd\uc73c\ub85c \uc81c\ud55c\ub41c \ubd80\uc2a4\ud130 \uacf5\uae09\uc744 \ucd5c\ub300\ud55c \ud65c\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Homescapes\uc5d0\uc11c \uc131\uacf5 \ud655\ub960\uc744 \ub192\uc774\uae30 \uc704\ud574 \uc5b4\ub5bb\uac8c \uc774\ub3d9 \uacc4\ud68d\uc744 \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Homescapes\uc5d0\uc11c \uc774\ub3d9 \uacc4\ud68d\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \ubaa8\ub4e0 \uc774\ub3d9\uc744 \ud558\uae30 \uc804\uc5d0 \ubcf4\ub4dc\ub97c \uc2e0\uc911\ud558\uac8c \ubd84\uc11d\ud574\uc57c \ud569\ub2c8\ub2e4. \ud30c\uc6cc\uc5c5\uc744 \uc0dd\uc131\ud558\uac70\ub098 \uc5ec\ub7ec \uc7a5\uc560\ubb3c\uc744 \ub3d9\uc2dc\uc5d0 \uc81c\uac70\ud558\ub294 \ub9e4\uce58\ub97c \ucc3e\uc73c\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ub85c\ucf13\uc744 \ub9cc\ub4dc\ub294 \uc774\ub3d9\uc744 \uacc4\ud68d\ud558\uba74 \uc804\uccb4 \ud589\uc744 \uc9c0\uc6b0\uace0 \uc7a0\uc7ac\uc801\uc73c\ub85c \uc5f0\uc1c4\uc801\uc778 \ub9e4\uce58\ub97c \uc774\ub04c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \ud30c\uc6cc\uc5c5\uc744 \uc0dd\uc131\ud558\ub294 \uc7a0\uc7ac \ub9e4\uce58\ub97c \ubcf4\ub4dc\uc5d0\uc11c \uc870\uc0ac\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc7a5\uc560\ubb3c\uc744 \uc81c\uac70\ud558\uac70\ub098 \ub808\ubca8\uc758 \ubaa9\ud45c\ub97c \ud0c0\uac9f\ud305\ud558\ub294 \uc774\ub3d9\uc5d0 \uc6b0\uc120\uc21c\uc704\ub97c \ub461\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc774\ub3d9\uc774 \ubcf4\ub4dc \ub808\uc774\uc544\uc6c3\uc5d0 \uc5b4\ub5bb\uac8c \uc601\ud5a5\uc744 \ubbf8\uce60\uc9c0 \ubbf8\ub9ac \uc608\uc0c1\ud558\uc2ed\uc2dc\uc624. \uc774\ub7ec\ud55c \uc804\ub7b5\uc801 \uc811\uadfc \ubc29\uc2dd\uc740 \uc131\uacf5 \ud655\ub960\uc744 \ud06c\uac8c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Homescapes\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \uc790\uc8fc \uc800\uc9c0\ub974\ub294 \uc77c\ubc18\uc801\uc778 \uc2e4\uc218\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Homescapes\uc758 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub294 \uc774\ub3d9\uc744 \uacc4\ud68d\ud558\uc9c0 \uc54a\uace0 \ub808\ubca8\uc744 \uc11c\ub450\ub974\ub294 \uc2e4\uc218\ub97c \uc790\uc8fc \uc800\uc9c0\ub985\ub2c8\ub2e4. \uc774\ub85c \uc778\ud574 \uc774\ub3d9 \uc2dc\uac04\uc744 \ub0ad\ube44\ud558\uace0 \uc88c\uc808\uac10\uc744 \ub290\ub084 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uc77c\ubc18\uc801\uc778 \uc2e4\uc218\ub294 \ud30c\uc6cc\uc5c5\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\uc9c0 \uc54a\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub85c\ucf13\uc744 \uc7a5\uc560\ubb3c \ud55c\ub450 \uac1c \ub300\uc2e0 \uc7a5\uc560\ubb3c \uc904\uc744 \uc81c\uac70\ud558\ub294 \ub370 \uc0ac\uc6a9\ud558\ub294 \uac83\uc740 \ube44\ud6a8\uc728\uc801\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc2e4\uc218\ub97c \ud53c\ud558\ub824\uba74 \ubcf4\ub4dc\ub97c \ubd84\uc11d\ud558\uace0 \uc774\ub3d9\uc744 \uacc4\ud68d\ud558\ub294 \ub370 \uc2dc\uac04\uc744 \ud560\uc560\ud558\uc2ed\uc2dc\uc624. \ud30c\uc6cc\uc5c5\uc744 \uc0dd\uc131\ud558\uace0 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc5ec \uc5ec\ub7ec \uc7a5\uc560\ubb3c\uc774\ub098 \ud2b9\uc815 \ubaa9\ud45c\ub97c \uc81c\uac70\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \uc774\ub7ec\ud55c \uc0ac\ub824 \uae4a\uc740 \uc811\uadfc \ubc29\uc2dd\uc740 \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
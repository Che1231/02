[{"question": "Homescapes\u3067\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f\u521d\u5fc3\u8005\u306e\u65b9\u306e\u305f\u3081\u306e\u57fa\u672c\u7684\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Homescapes\u3067\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u306b\u306f\u3001\u540c\u3058\u30a2\u30a4\u30c6\u30e0\u30923\u3064\u4ee5\u4e0a\u30de\u30c3\u30c1\u3055\u305b\u3066\u30dc\u30fc\u30c9\u304b\u3089\u6d88\u3059\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u521d\u5fc3\u8005\u306e\u5834\u5408\u306f\u3001\u30ed\u30b1\u30c3\u30c8\u3084\u7206\u5f3e\u306a\u3069\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u751f\u307f\u51fa\u3059\u305f\u3081\u306b\u30014\u3064\u4ee5\u4e0a\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u30de\u30c3\u30c1\u3055\u305b\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u30014\u3064\u306e\u30ad\u30e3\u30f3\u30c7\u30a3\u30fc\u30921\u5217\u306b\u30de\u30c3\u30c1\u3055\u305b\u308b\u3068\u30011\u5217\u5168\u4f53\u3092\u6d88\u3059\u30ed\u30b1\u30c3\u30c8\u304c\u3067\u304d\u307e\u3059\u3002STEP1\uff1a4\u3064\u4ee5\u4e0a\u306e\u30a2\u30a4\u30c6\u30e0\u306e\u30de\u30c3\u30c1\u3092\u63a2\u3057\u307e\u3059\u3002STEP2\uff1a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3057\u3066\u3001\u30dc\u30fc\u30c9\u306e\u5e83\u3044\u90e8\u5206\u3092\u6d88\u3057\u307e\u3059\u3002STEP3\uff1a\u7bb1\u3084\u30c1\u30a7\u30fc\u30f3\u306a\u3069\u306e\u969c\u5bb3\u7269\u3092\u512a\u5148\u7684\u306b\u6d88\u53bb\u3057\u3066\u3001\u3088\u308a\u5230\u9054\u3057\u306b\u304f\u3044\u30a2\u30a4\u30c6\u30e0\u306b\u30a2\u30af\u30bb\u30b9\u3057\u307e\u3059\u3002"}, {"question": "Homescapes\u306e\u3044\u304f\u3064\u304b\u306e\u30ec\u30d9\u30eb\u304c\u30af\u30ea\u30a2\u3067\u304d\u306a\u3044\u3088\u3046\u306b\u898b\u3048\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u3069\u306e\u3088\u3046\u306a\u9ad8\u5ea6\u306a\u6226\u7565\u304c\u5f79\u7acb\u3061\u307e\u3059\u304b\uff1f", "answer": "Homescapes\u306e\u3044\u304f\u3064\u304b\u306e\u30ec\u30d9\u30eb\u306f\u3001\u79fb\u52d5\u56de\u6570\u5236\u9650\u3084\u8907\u96d1\u306a\u969c\u5bb3\u7269\u306a\u3069\u3001\u6311\u6226\u3059\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u4f5c\u308b\u3053\u3068\u306b\u91cd\u70b9\u3092\u7f6e\u304f\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ed\u30b1\u30c3\u30c8\u3068\u7206\u5f3e\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3068\u3001\u30dc\u30fc\u30c9\u306e\u5e83\u3044\u7bc4\u56f2\u3092\u6d88\u53bb\u3067\u304d\u307e\u3059\u3002STEP1\uff1a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u4f5c\u6210\u3059\u308b\u305f\u3081\u306b\u3001\u79fb\u52d5\u3092\u8a08\u753b\u3057\u307e\u3059\u3002STEP2\uff1a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u6226\u7565\u7684\u306b\u4f7f\u7528\u3057\u3066\u3001\u7279\u5b9a\u306e\u969c\u5bb3\u7269\u3092\u72d9\u6483\u3057\u307e\u3059\u3002STEP3\uff1a\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u76f4\u524d\u306a\u3069\u306e\u91cd\u8981\u306a\u5834\u9762\u306b\u30d6\u30fc\u30b9\u30bf\u30fc\u3092\u7bc0\u7d04\u3057\u307e\u3059\u3002"}, {"question": "Homescapes\u306e\u91cd\u8981\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u304b\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u6539\u5584\u3059\u308b\u305f\u3081\u306b\u7406\u89e3\u3057\u3066\u304a\u304f\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "Homescapes\u306e\u91cd\u8981\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u6539\u5584\u3059\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u3053\u306e\u30b2\u30fc\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30a2\u30a4\u30c6\u30e0\u3092\u30af\u30ea\u30a2\u3057\u3066\u9032\u3080\u30de\u30c3\u30c13\u30d1\u30ba\u30eb\u3092\u4e2d\u5fc3\u306b\u5c55\u958b\u3057\u3066\u3044\u307e\u3059\u3002\u5404\u30ec\u30d9\u30eb\u306b\u306f\u3001\u7279\u5b9a\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u53ce\u96c6\u3057\u305f\u308a\u3001\u969c\u5bb3\u7269\u3092\u30af\u30ea\u30a2\u3057\u305f\u308a\u3059\u308b\u306a\u3069\u306e\u5177\u4f53\u7684\u306a\u76ee\u6a19\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30c6\u30a3\u30fc\u30ab\u30c3\u30d7\u3092\u53ce\u96c6\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30c6\u30a3\u30fc\u30ab\u30c3\u30d7\u3092\u76f4\u63a5\u30bf\u30fc\u30b2\u30c3\u30c8\u306b\u3059\u308b\u30de\u30c3\u30c1\u306b\u96c6\u4e2d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3055\u3089\u306b\u3001\u3053\u306e\u30b2\u30fc\u30e0\u306b\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30ec\u30d9\u30eb\u304b\u3089\u7372\u5f97\u3057\u305f\u661f\u3092\u4f7f\u7528\u3057\u3066\u81ea\u5b85\u3092\u88c5\u98fe\u304a\u3088\u3073\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3001\u5bb6\u306e\u30ea\u30d5\u30a9\u30fc\u30e0\u8981\u7d20\u3082\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u3053\u306e\u30c7\u30e5\u30a2\u30eb\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u5965\u884c\u304d\u3068\u591a\u69d8\u6027\u3092\u4e0e\u3048\u307e\u3059\u3002"}, {"question": "Homescapes\u306e\u9032\u6357\u72b6\u6cc1\u3092\u8907\u6570\u306e\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f\u307e\u305f\u3001\u4f55\u306b\u6ce8\u610f\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u8907\u6570\u306e\u30c7\u30d0\u30a4\u30b9\u9593\u3067Homescapes\u306e\u9032\u6357\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002Facebook\u307e\u305f\u306fApple/Google\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u4f7f\u7528\u3057\u3066\u3001\u9032\u6357\u72b6\u6cc1\u3092\u540c\u671f\u3055\u305b\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001iPhone\u304b\u3089Android\u30c7\u30d0\u30a4\u30b9\u306b\u5207\u308a\u66ff\u3048\u308b\u5834\u5408\u3001\u540c\u3058Facebook\u30a2\u30ab\u30a6\u30f3\u30c8\u3067\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u4e2d\u65ad\u3057\u305f\u3068\u3053\u308d\u304b\u3089\u518d\u958b\u3059\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4e00\u90e8\u306e\u30a2\u30d7\u30ea\u5185\u8cfc\u5165\u306f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u8ee2\u9001\u3055\u308c\u306a\u3044\u5834\u5408\u304c\u3042\u308b\u305f\u3081\u3001\u8a73\u7d30\u306a\u624b\u9806\u306b\u3064\u3044\u3066\u306f\u3001\u30b2\u30fc\u30e0\u306e\u30b5\u30dd\u30fc\u30c8\u30da\u30fc\u30b8\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "Homescapes\u306b\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u305d\u308c\u3089\u306b\u3064\u3044\u3066\u77e5\u3089\u306a\u3044\u304b\u3082\u3057\u308c\u307e\u305b\u3093\uff1f", "answer": "Homescapes\u306b\u306f\u3001\u8ffd\u52a0\u306e\u697d\u3057\u307f\u3092\u52a0\u3048\u308b\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u6e80\u8f09\u3067\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306e1\u3064\u306f\u3001\u5bb6\u306e\u30ea\u30d5\u30a9\u30fc\u30e0\u30b7\u30fc\u30f3\u306e\u7279\u5b9a\u306e\u30a2\u30a4\u30c6\u30e0\u3068\u5bfe\u8a71\u3067\u304d\u308b\u6a5f\u80fd\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ea\u30d3\u30f3\u30b0\u30eb\u30fc\u30e0\u306e\u732b\u3092\u30af\u30ea\u30c3\u30af\u3059\u308b\u3068\u3001\u304b\u308f\u3044\u3044\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3\u304c\u30c8\u30ea\u30ac\u30fc\u3055\u308c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u307e\u305f\u3001\u7279\u5b9a\u306e\u30ec\u30d9\u30eb\u306b\u306f\u3001\u7279\u5b9a\u306e\u30d1\u30bf\u30fc\u30f3\u3067\u30de\u30c3\u30c1\u3092\u4f5c\u308b\u3053\u3068\u3067\u30a2\u30af\u30c6\u30a3\u30d6\u5316\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3092\u63a2\u6c42\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u8c4a\u304b\u3067\u697d\u3057\u3044\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Homescapes\u3067\u3001\u96e3\u3057\u3044\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u305f\u3081\u306b\u6700\u3082\u52b9\u679c\u7684\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Homescapes\u3067\u96e3\u3057\u3044\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u305f\u3081\u306b\u6700\u3082\u52b9\u679c\u7684\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u3001\u8679\u8272\u306e\u30dc\u30fc\u30eb\u3001\u30ed\u30b1\u30c3\u30c8\u3001\u7206\u5f3e\u3067\u3059\u3002\u8679\u8272\u306e\u30dc\u30fc\u30eb\u306f\u3001\u4efb\u610f\u306e\u30a2\u30a4\u30c6\u30e0\u3068\u30de\u30c3\u30c1\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u3001\u30dc\u30fc\u30c9\u304b\u3089\u305d\u306e\u30a2\u30a4\u30c6\u30e0\u306e\u3059\u3079\u3066\u306e\u30a4\u30f3\u30b9\u30bf\u30f3\u30b9\u3092\u30af\u30ea\u30a2\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u8679\u8272\u306e\u30dc\u30fc\u30eb\u3092\u30c6\u30a3\u30fc\u30ab\u30c3\u30d7\u3068\u30de\u30c3\u30c1\u3055\u305b\u308b\u3068\u3001\u3059\u3079\u3066\u306e\u30c6\u30a3\u30fc\u30ab\u30c3\u30d7\u304c\u30af\u30ea\u30a2\u3055\u308c\u307e
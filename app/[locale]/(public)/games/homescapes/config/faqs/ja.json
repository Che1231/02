\u3042\u308a\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u7279\u5225\u306a\u30a4\u30d9\u30f3\u30c8\u3084\u65e5\u3005\u306e\u6311\u6226\u306b\u53c2\u52a0\u3059\u308b\u3053\u3068\u3067\u3001\u661f\u3092\u7372\u5f97\u3059\u308b\u6a5f\u4f1a\u3092\u3055\u3089\u306b\u5897\u3084\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u9ad8\u30a4\u30f3\u30d1\u30af\u30c8\u306e\u30ea\u30d5\u30a9\u30fc\u30e0\u3092\u512a\u5148\u3059\u308b\u3053\u3068\u3067\u661f\u3092\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3059\u308b\u3053\u3068\u306b\u3088\u308a\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4f53\u9a13\u3092\u3055\u3089\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Homescapes\u3067\u30d6\u30fc\u30b9\u30bf\u30fc\u3092\u7ba1\u7406\u3059\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u304b\u3001\u3044\u3064\u4f7f\u7528\u3059\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "Homescapes\u3067\u30d6\u30fc\u30b9\u30bf\u30fc\u3092\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3059\u308b\u3053\u3068\u306f\u3001\u96e3\u3057\u3044\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u53ef\u80fd\u6027\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30d6\u30fc\u30b9\u30bf\u30fc\u306f\u6226\u7565\u7684\u306b\u4f7f\u7528\u3059\u3079\u304d\u3067\u3059\u3002\u7279\u306b\u3001\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u5bf8\u524d\u3001\u307e\u305f\u306f\u5c11\u3057\u306e\u52a9\u3051\u304c\u5fc5\u8981\u306a\u5834\u5408\u306b\u30d6\u30fc\u30b9\u30bf\u30fc\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u3001\u5384\u4ecb\u306a\u969c\u5bb3\u7269\u3092\u30af\u30ea\u30a2\u3057\u305f\u308a\u3001\u91cd\u8981\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f5c\u6210\u3057\u305f\u308a\u3059\u308b\u305f\u3081\u306b\u30d6\u30fc\u30b9\u30bf\u30fc\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002STEP1\uff1a\u4e00\u8cab\u3057\u3066\u82e6\u52b4\u3059\u308b\u30ec\u30d9\u30eb\u306b\u5411\u3051\u3066\u30d6\u30fc\u30b9\u30bf\u30fc\u3092\u4fdd\u5b58\u3057\u307e\u3059\u3002STEP2\uff1a\u30d6\u30fc\u30b9\u30bf\u30fc\u3092\u4f7f\u7528\u3057\u3066\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f5c\u6210\u307e\u305f\u306f\u5f37\u5316\u3057\u307e\u3059\u3002STEP3\uff1a\u6700\u5927\u9650\u306e\u52b9\u679c\u3092\u5f97\u308b\u305f\u3081\u306b\u3001\u30d6\u30fc\u30b9\u30bf\u30fc\u3092\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3068\u7d44\u307f\u5408\u308f\u305b\u307e\u3059\u3002\u3053\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u306b\u3088\u308a\u3001\u9650\u3089\u308c\u305f\u30d6\u30fc\u30b9\u30bf\u30fc\u306e\u4f9b\u7d66\u3092\u6700\u5927\u9650\u306b\u6d3b\u7528\u3067\u304d\u307e\u3059\u3002"}, {"question": "Homescapes\u3067\u79fb\u52d5\u8a08\u753b\u3092\u6700\u9069\u5316\u3057\u3066\u6210\u529f\u306e\u53ef\u80fd\u6027\u3092\u9ad8\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Homescapes\u3067\u79fb\u52d5\u8a08\u753b\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u79fb\u52d5\u3059\u308b\u524d\u306b\u30dc\u30fc\u30c9\u3092\u6ce8\u610f\u6df1\u304f\u5206\u6790\u3057\u307e\u3059\u3002\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f5c\u6210\u3057\u305f\u308a\u3001\u4e00\u5ea6\u306b\u8907\u6570\u306e\u969c\u5bb3\u7269\u3092\u30af\u30ea\u30a2\u3057\u305f\u308a\u3059\u308b\u30de\u30c3\u30c1\u3092\u63a2\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ed\u30b1\u30c3\u30c8\u3092\u4f5c\u6210\u3059\u308b\u79fb\u52d5\u3092\u8a08\u753b\u3059\u308b\u3068\u30011\u5217\u5168\u4f53\u3092\u30af\u30ea\u30a2\u3057\u3001\u6f5c\u5728\u7684\u306b\u9023\u9396\u7684\u306a\u30de\u30c3\u30c1\u306b\u3064\u306a\u304c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002STEP1\uff1a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f5c\u6210\u3059\u308b\u6f5c\u5728\u7684\u306a\u30de\u30c3\u30c1\u3092\u30dc\u30fc\u30c9\u304b\u3089\u8abf\u67fb\u3057\u307e\u3059\u3002STEP2\uff1a\u969c\u5bb3\u7269\u3092\u30af\u30ea\u30a2\u3057\u305f\u308a\u3001\u30ec\u30d9\u30eb\u306e\u76ee\u6a19\u3092\u30bf\u30fc\u30b2\u30c3\u30c8\u306b\u3057\u305f\u308a\u3059\u308b\u79fb\u52d5\u3092\u512a\u5148\u3057\u307e\u3059\u3002STEP3\uff1a\u79fb\u52d5\u304c\u30dc\u30fc\u30c9\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3059\u308b\u304b\u3092\u4e8b\u524d\u306b\u4e88\u6e2c\u3057\u307e\u3059\u3002\u3053\u306e\u6226\u7565\u7684\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u306b\u3088\u308a\u3001\u6210\u529f\u306e\u53ef\u80fd\u6027\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002"}, {"question": "Homescapes\u3067\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u9665\u308a\u3084\u3059\u3044\u4e00\u822c\u7684\u306a\u30df\u30b9\u306f\u4f55\u304b\u3001\u305d\u308c\u3089\u3092\u3069\u306e\u3088\u3046\u306b\u56de\u907f\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Homescapes\u306e\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u79fb\u52d5\u8a08\u753b\u3092\u7acb\u3066\u305a\u306b\u30ec\u30d9\u30eb\u3092\u6025\u3044\u3067\u30af\u30ea\u30a2\u3057\u3066\u3057\u307e\u3046\u3053\u3068\u304c\u3088\u304f\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u79fb\u52d5\u6642\u9593\u304c\u7121\u99c4\u306b\u306a\u308a\u3001\u30d5\u30e9\u30b9\u30c8\u30ec\u30fc\u30b7\u30e7\u30f3\u304c\u84c4\u7a4d\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3082\u3046\u4e00\u3064\u306e\u4e00\u822c\u7684\u306a\u30df\u30b9\u306f\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u52b9\u679c\u7684\u306b\u4f7f\u7528\u3057\u306a\u3044\u3053\u3068\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u969c\u5bb3\u7269\u306e\u5217\u3067\u306f\u306a\u304f\u3001\u5358\u4e00\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u30af\u30ea\u30a2\u3059\u308b\u305f\u3081\u306b\u30ed\u30b1\u30c3\u30c8\u3092\u4f7f\u7528\u3059\u308b\u306e\u306f\u52b9\u7387\u7684\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u3053\u308c\u3089\u306e\u9593\u9055\u3044\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u3001\u30dc\u30fc\u30c9\u3092\u5206\u6790\u3057\u3066\u79fb\u52d5\u3092\u8a08\u753b\u3059\u308b\u6642\u9593\u3092\u304b\u3051\u307e\u3059\u3002\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f5c\u6210\u3057\u3001\u305d\u308c\u3089\u3092\u6226\u7565\u7684\u306b\u4f7f\u7528\u3057\u3066\u8907\u6570\u306e\u969c\u5bb3\u7269\u3092\u30af\u30ea\u30a2\u3057\u305f\u308a\u3001\u7279\u5b9a\u306e\u76ee\u6a19\u306b\u30bf\u30fc\u30b2\u30c3\u30c8\u3092\u7d5e\u3063\u305f\u308a\u3059\u308b\u3053\u3068\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u306e\u914d\u616e\u306e\u3042\u308b\u30a2\u30d7\u30ed\u30fc\u30c1\u306b\u3088\u308a\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4f53\u9a13\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002"}]
[{"question": "\u5982\u4f55\u5728\u300a\u5bb6\u56ed\u5947\u7f18\u300b\u4e2d\u5b8c\u6210\u5173\u5361\uff0c\u4ee5\u53ca\u521d\u5b66\u8005\u5e94\u8be5\u638c\u63e1\u7684\u57fa\u672c\u7b56\u7565\uff1f", "answer": "\u8981\u5728\u300a\u5bb6\u56ed\u5947\u7f18\u300b\u4e2d\u5b8c\u6210\u4e00\u4e2a\u5173\u5361\uff0c\u4f60\u9700\u8981\u5c06\u4e09\u4e2a\u6216\u4e09\u4e2a\u4ee5\u4e0a\u76f8\u540c\u7684\u7269\u54c1\u914d\u5bf9\u6d88\u9664\u3002\u4f5c\u4e3a\u65b0\u624b\uff0c\u5e94\u8be5\u4e13\u6ce8\u4e8e\u521b\u5efa\u56db\u4e2a\u6216\u56db\u4e2a\u4ee5\u4e0a\u7269\u54c1\u7684\u5339\u914d\uff0c\u4ee5\u751f\u6210\u706b\u7bad\u548c\u70b8\u5f39\u7b49\u9053\u5177\u3002\u4f8b\u5982\uff0c\u5c06\u56db\u9897\u7cd6\u679c\u6392\u6210\u4e00\u884c\u53ef\u4ee5\u4ea7\u751f\u4e00\u4e2a\u6e05\u9664\u6574\u884c\u7684\u706b\u7bad\u3002\u6b65\u9aa4\u4e00\uff1a\u5bfb\u627e\u56db\u4e2a\u6216\u56db\u4e2a\u4ee5\u4e0a\u7269\u54c1\u7684\u5339\u914d\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u9053\u5177\u6e05\u9664\u5927\u7247\u6e38\u620f\u533a\u57df\u3002\u6b65\u9aa4\u4e09\uff1a\u4f18\u5148\u6e05\u9664\u969c\u788d\u7269\uff0c\u4f8b\u5982\u7bb1\u5b50\u548c\u94fe\u5b50\uff0c\u4ee5\u8bbf\u95ee\u66f4\u96be\u89e6\u53ca\u7684\u7269\u54c1\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u300a\u5bb6\u56ed\u5947\u7f18\u300b\u4e2d\u6709\u4e9b\u5173\u5361\u770b\u8d77\u6765\u51e0\u4e4e\u4e0d\u53ef\u80fd\u901a\u5173\uff0c\u4ee5\u53ca\u54ea\u4e9b\u9ad8\u7ea7\u7b56\u7565\u53ef\u4ee5\u5e2e\u52a9\uff1f", "answer": "\u300a\u5bb6\u56ed\u5947\u7f18\u300b\u4e2d\u7684\u67d0\u4e9b\u5173\u5361\u8bbe\u8ba1\u5f97\u6781\u5177\u6311\u6218\u6027\uff0c\u901a\u5e38\u662f\u56e0\u4e3a\u79fb\u52a8\u6b21\u6570\u6709\u9650\u6216\u969c\u788d\u7269\u590d\u6742\u3002\u9ad8\u7ea7\u73a9\u5bb6\u5e94\u8be5\u4e13\u6ce8\u4e8e\u521b\u5efa\u9053\u5177\u7ec4\u5408\u3002\u4f8b\u5982\uff0c\u5c06\u706b\u7bad\u4e0e\u70b8\u5f39\u7ed3\u5408\u4f7f\u7528\u53ef\u4ee5\u6e05\u9664\u6e38\u620f\u533a\u57df\u7684\u5927\u7247\u533a\u57df\u3002\u6b65\u9aa4\u4e00\uff1a\u8ba1\u5212\u4f60\u7684\u79fb\u52a8\uff0c\u4ee5\u521b\u5efa\u9053\u5177\u7ec4\u5408\u3002\u6b65\u9aa4\u4e8c\uff1a\u6218\u7565\u6027\u5730\u4f7f\u7528\u9053\u5177\uff0c\u4ee5\u9488\u5bf9\u7279\u5b9a\u7684\u969c\u788d\u7269\u3002\u6b65\u9aa4\u4e09\uff1a\u5728\u63a5\u8fd1\u901a\u5173\u5173\u5361\u65f6\uff0c\u4fdd\u5b58\u9053\u5177\u4ee5\u5e94\u5bf9\u5173\u952e\u65f6\u523b\u3002"}, {"question": "\u300a\u5bb6\u56ed\u5947\u7f18\u300b\u6709\u54ea\u4e9b\u5173\u952e\u673a\u5236\uff0c\u73a9\u5bb6\u5e94\u8be5\u4e86\u89e3\u8fd9\u4e9b\u673a\u5236\u624d\u80fd\u63d0\u5347\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u4e86\u89e3\u300a\u5bb6\u56ed\u5947\u7f18\u300b\u7684\u5173\u952e\u673a\u5236\u5bf9\u4e8e\u63d0\u5347\u6e38\u620f\u4f53\u9a8c\u81f3\u5173\u91cd\u8981\u3002\u8be5\u6e38\u620f\u56f4\u7ed5\u4e09\u6d88\u76ca\u667a\u6e38\u620f\uff0c\u73a9\u5bb6\u6e05\u9664\u7269\u54c1\u4ee5\u53d6\u5f97\u8fdb\u5c55\u3002\u6bcf\u4e2a\u5173\u5361\u90fd\u6709\u7279\u5b9a\u7684\u76ee\u6807\uff0c\u4f8b\u5982\u6536\u96c6\u7279\u5b9a\u7269\u54c1\u6216\u6e05\u9664\u969c\u788d\u7269\u3002\u4f8b\u5982\uff0c\u5728\u9700\u8981\u6536\u96c6\u8336\u676f\u7684\u5173\u5361\u4e2d\uff0c\u4e13\u6ce8\u4e8e\u76f4\u63a5\u9488\u5bf9\u8336\u676f\u7684\u5339\u914d\u3002\u6b64\u5916\uff0c\u6e38\u620f\u8fd8\u5305\u542b\u623f\u5c4b\u88c5\u4fee\u65b9\u9762\uff0c\u73a9\u5bb6\u4f7f\u7528\u4ece\u5173\u5361\u83b7\u5f97\u7684\u661f\u661f\u6765\u88c5\u9970\u548c\u5347\u7ea7\u4ed6\u4eec\u7684\u5bb6\u56ed\u3002\u8fd9\u79cd\u53cc\u91cd\u673a\u5236\u589e\u52a0\u4e86\u6e38\u620f\u7684\u6df1\u5ea6\u548c\u591a\u6837\u6027\u3002"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684\u300a\u5bb6\u56ed\u5947\u7f18\u300b\u8fdb\u5ea6\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u8f6c\u79fb\uff0c\u4ee5\u53ca\u9700\u8981\u6ce8\u610f\u54ea\u4e9b\u4e8b\u9879\uff1f", "answer": "\u8981\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u8f6c\u79fb\u300a\u5bb6\u56ed\u5947\u7f18\u300b\u8fdb\u5ea6\uff0c\u8bf7\u786e\u4fdd\u4f60\u5728\u4e24\u53f0\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u5e10\u6237\u3002\u4f7f\u7528 Facebook \u6216\u4f60\u7684 Apple/Google \u5e10\u6237\u540c\u6b65\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4ece iPhone \u5207\u6362\u5230 Android \u8bbe\u5907\uff0c\u8bf7\u4f7f\u7528\u76f8\u540c\u7684 Facebook \u5e10\u6237\u767b\u5f55\uff0c\u4ee5\u7ee7\u7eed\u672a\u5b8c\u6210\u7684\u6e38\u620f\u3002\u8bf7\u6ce8\u610f\uff0c\u90e8\u5206\u6e38\u620f\u5185\u8d2d\u4e70\u53ef\u80fd\u65e0\u6cd5\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\uff0c\u56e0\u6b64\u8bf7\u67e5\u770b\u6e38\u620f\u7684\u652f\u6301\u9875\u9762\u4ee5\u83b7\u5f97\u8be6\u7ec6\u8bf4\u660e\u3002"}, {"question": "\u300a\u5bb6\u56ed\u5947\u7f18\u300b\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff0c\u73a9\u5bb6\u53ef\u80fd\u4e0d\u77e5\u9053\uff1f", "answer": "\u300a\u5bb6\u56ed\u5947\u7f18\u300b\u5145\u6ee1\u4e86\u9690\u85cf\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u589e\u6dfb\u4e86\u6e38\u620f\u7684\u4e50\u8da3\u3002\u4e00\u4e2a\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\u80fd\u591f\u4e0e\u623f\u5c4b\u88c5\u4fee\u573a\u666f\u4e2d\u7684\u67d0\u4e9b\u7269\u54c1\u8fdb\u884c\u4e92\u52a8\u3002\u4f8b\u5982\uff0c\u70b9\u51fb\u5ba2\u5385\u91cc\u7684\u732b\u53ef\u80fd\u4f1a\u89e6\u53d1\u53ef\u7231\u7684\u52a8\u753b\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u5173\u5361\u4e2d\u8fd8\u6709\u9690\u85cf\u9053\u5177\uff0c\u53ef\u4ee5\u901a\u8fc7\u5728\u7279\u5b9a\u6a21\u5f0f\u4e2d\u8fdb\u884c\u7279\u5b9a\u5339\u914d\u6765\u6fc0\u6d3b\u3002\u63a2\u7d22\u8fd9\u4e9b\u9690\u85cf\u529f\u80fd\u53ef\u4ee5\u63d0\u4f9b\u66f4\u4e30\u5bcc\u548c\u66f4\u6109\u5feb\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u300a\u5bb6\u56ed\u5947\u7f18\u300b\u4e2d\u54ea\u4e9b\u9053\u5177\u6700\u6709\u6548\u5730\u6e05\u9664\u56f0\u96be\u5173\u5361\uff1f", "answer": "\u300a\u5bb6\u56ed\u5947\u7f18\u300b\u4e2d\uff0c\u6700\u6709\u6548\u6e05\u9664\u56f0\u96be\u5173\u5361\u7684\u9053\u5177\u662f\u5f69\u8679\u7403\u3001\u706b\u7bad\u548c\u70b8\u5f39\u3002\u5f69\u8679\u7403\u53ef\u4ee5\u4e0e\u4efb\u4f55\u7269\u54c1\u5339\u914d\uff0c\u4ece\u800c\u6e05\u9664\u6e38\u620f\u533a\u57df\u4e2d\u6240\u6709\u8be5\u7269\u54c1\u7684\u5b9e\u4f8b\u3002\u4f8b\u5982\uff0c\u5c06\u5f69\u8679\u7403\u4e0e\u8336\u676f\u5339\u914d\u53ef\u4ee5\u6e05\u9664\u6240\u6709\u8336\u676f\u3002\u706b\u7bad\u4f1a\u6e05\u9664\u6574\u884c\u6216\u6574\u5217\uff0c\u800c\u70b8\u5f39\u4f1a\u6e05\u9664 3x3 \u7684\u533a\u57df\u3002\u7ec4\u5408\u8fd9\u4e9b\u9053\u5177\u53ef\u4ee5\u521b\u9020\u51fa\u66f4\u5f3a\u5927\u7684\u6548\u679c\uff0c\u4f8b\u5982\u4f7f\u7528\u5f69\u8679\u7403\u914d\u5408\u706b\u7bad\u6e05\u9664\u7279\u5b9a\u7269\u54c1\u7684\u591a\u4e2a\u884c\u3002"}, {"question": "\u300a\u5bb6\u56ed\u5947\u7f18\u300b\u4e2d\u7684\u661f\u7ea7\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u5927\u9650\u5ea6\u5730\u6536\u96c6\u661f\u661f\uff1f", "answer": "\u300a\u5bb6\u56ed\u5947\u7f18\u300b\u7684\u661f\u7ea7\u7cfb\u7edf\u5141\u8bb8\u73a9\u5bb6\u901a\u8fc7\u5b8c\u6210\u5173\u5361\u6765\u83b7\u5f97\u661f\u661f\uff0c\u7136\u540e\u8fd9\u4e9b\u661f\u661f\u7528\u4e8e\u7ffb\u65b0\u548c\u88c5\u9970\u623f\u5c4b\u3002\u8981\u6700\u5927\u9650\u5ea6\u5730\u6536\u96c6\u661f\u661f\uff0c\u8bf7\u4e13\u6ce8\u4e8e\u5c3d\u53ef\u80fd\u5c11\u5730\u79fb\u52a8\u6b65\u6570\u6765\u5b8c\u6210\u5173\u5361\uff0c\u56e0\u4e3a\u8fd9\u901a\u5e38\u4f1a\u83b7\u5f97\u989d\u5916\u661f\u661f\u3002\u4f8b\u5982\uff0c\u4ee5\u4e09\u6b65\u5b8c\u6210\u5173\u5361\u53ef\u80fd\u4f1a\u989d\u5916\u83b7\u5f97\u4e00\u9897\u661f\u3002\u6b64\u5916\uff0c\u53c2\u4e0e\u7279\u6b8a\u6d3b\u52a8\u548c\u6bcf\u65e5\u6311\u6218\u53ef\u4ee5\u63d0\u4f9b\u989d\u5916\u7684\u673a\u4f1a\u6765\u83b7\u5f97\u661f\u661f\u3002\u6709\u6548\u7ba1\u7406\u661f\u661f\uff0c\u4f18\u5148\u8003\u8651\u9ad8\u5f71\u54cd\u529b\u7684\u7ffb\u65b0\u5de5\u4f5c\uff0c\u4e5f\u80fd\u63d0\u5347\u4f60\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u5728\u300a\u5bb6\u56ed\u5947\u7f18\u300b\u4e2d\u6709\u6548\u7ba1\u7406\u9053\u5177\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u4f55\u65f6\u5e94\u8be5\u4f7f\u7528\u5b83\u4eec\uff1f", "answer": "\u5728\u300a\u5bb6\u56ed\u5947\u7f18\u300b\u4e2d\u6709\u6548\u7ba1\u7406\u9053\u5177\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u5b8c\u6210\u56f0\u96be\u5173\u5361\u7684\u51e0\u7387\u3002\u9053\u5177\u5e94\u8be5\u6218\u7565\u6027\u5730\u4f7f\u7528\uff0c\u7279\u522b\u662f\u5728\u4f60\u5373\u5c06\u5b8c\u6210\u5173\u5361\u4f46\u9700\u8981\u4e00\u4e9b\u989d\u5916\u5e2e\u52a9\u65f6\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u9053\u5177\u6e05\u9664\u987d\u56fa\u7684\u969c\u788d\u7269\u6216\u521b\u9020\u5173\u952e\u7684\u9053\u5177\u3002\u6b65\u9aa4\u4e00\uff1a\u5c06\u9053\u5177\u4fdd\u5b58\u8d77\u6765\uff0c\u7528\u4e8e\u4f60\u7ecf\u5e38\u96be\u4ee5\u5b8c\u6210\u7684\u5173\u5361\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u9053\u5177\u6765\u521b\u9020\u6216\u589e\u5f3a\u9053\u5177\u3002\u6b65\u9aa4\u4e09\uff1a\u5c06\u9053\u5177\u4e0e\u9053\u5177\u7ec4\u5408\u4f7f\u7528\uff0c\u4ee5\u8fbe\u5230\u6700\u5927\u6548\u679c\u3002\u8fd9\u79cd\u65b9\u6cd5\u53ef\u4ee5\u786e\u4fdd\u4f60\u5145\u5206\u5229\u7528\u6709\u9650\u7684\u9053\u5177\u3002"}, {"question": "\u5982\u4f55\u4f18\u5316\u6211\u7684\u300a\u5bb6\u56ed\u5947\u7f18\u300b\u79fb\u52a8\u89c4\u5212\uff0c\u4ee5\u63d0\u9ad8\u6210\u529f\u7387\uff1f", "answer": "\u300a\u5bb6\u56ed\u5947\u7f18\u300b\u4e2d\u7684\u79fb\u52a8\u89c4\u5212\u4f18\u5316\u5305\u62ec\u5728\u79fb\u52a8\u4e4b\u524d\u4ed4\u7ec6\u5206\u6790\u6e38\u620f\u533a\u57df\u3002\u5bfb\u627e\u53ef\u4ee5\u521b\u5efa\u9053\u5177\u6216\u4e00\u6b21\u6e05\u9664\u591a\u4e2a\u969c\u788d\u7269\u7684\u5339\u914d\u3002\u4f8b\u5982\uff0c\u8ba1\u5212\u4e00\u4e2a\u80fd\u4ea7\u751f\u706b\u7bad\u7684\u79fb\u52a8\u53ef\u4ee5\u6e05\u9664\u6574\u884c\uff0c\u5e76\u53ef\u80fd\u5bfc\u81f4\u8fde\u9501\u5f0f\u5339\u914d\u3002\u6b65\u9aa4\u4e00\uff1a\u68c0\u67e5\u6e38\u620f\u533a\u57df\uff0c\u5bfb\u627e\u53ef\u80fd\u4ea7\u751f\u9053\u5177\u7684\u5339\u914d\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f18\u5148\u9009\u62e9\u6e05\u9664\u969c\u788d\u7269\u6216\u8fbe\u5230\u5173\u5361\u76ee\u6807\u7684\u79fb\u52a8\u3002\u6b65\u9aa4\u4e09\uff1a\u63d0\u524d\u8003\u8651\u4f60\u7684\u79fb\u52a8\u5c06\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u533a\u57df\u5e03\u5c40\u3002\u8fd9\u79cd\u6218\u7565\u65b9\u6cd5\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u6210\u529f\u7684\u51e0\u7387\u3002"}, {"question": "\u65b0\u624b\u73a9\u5bb6\u5728\u300a\u5bb6\u56ed\u5947\u7f18\u300b\u4e2d\u5e38\u89c1\u7684\u9519\u8bef\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5982\u4f55\u907f\u514d\u8fd9\u4e9b\u9519\u8bef\uff1f", "answer": "\u300a\u5bb6\u56ed\u5947\u7f18\u300b\u7684\u65b0\u624b\u73a9\u5bb6\u7ecf\u5e38\u72af\u7684\u9519\u8bef\u662f\u4e0d\u5728\u8ba1\u5212\u79fb\u52a8\u7684\u60c5\u51b5\u4e0b\u5306\u5fd9\u901a\u8fc7\u5173\u5361\u3002\u8fd9\u4f1a\u5bfc\u81f4\u79fb\u52a8\u6d6a\u8d39\u548c\u632b\u8d25\u611f\u3002\u53e6\u4e00\u4e2a\u5e38\u89c1\u9519\u8bef\u662f\u65e0\u6cd5\u6709\u6548\u5229\u7528\u9053\u5177\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u706b\u7bad\u6e05\u9664\u5355\u4e2a\u7269\u54c1\u800c\u4e0d\u662f\u4e00\u6392\u969c\u788d\u7269\u6548\u7387\u4f4e\u4e0b\u3002\u4e3a\u4e86\u907f\u514d\u8fd9\u4e9b\u9519\u8bef\uff0c\u82b1\u65f6\u95f4\u5206\u6790\u6e38\u620f\u533a\u57df\u5e76\u8ba1\u5212\u4f60\u7684\u79fb\u52a8\u3002\u4e13\u6ce8\u4e8e\u521b\u5efa\u9053\u5177\u5e76\u6218\u7565\u6027\u5730\u4f7f\u7528\u5b83\u4eec\u6e05\u9664\u591a\u4e2a\u969c\u788d\u7269\u6216\u9488\u5bf9\u7279\u5b9a\u76ee\u6807\u3002\u8fd9\u79cd\u7ec6\u81f4\u5165\u5fae\u7684\u65b9\u6cd5\u53ef\u4ee5\u6781\u5927\u5730\u63d0\u5347\u4f60\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}]
[{"question": "\u5982\u4f55\u5b8c\u6210\u300a\u5bb6\u5712\u7269\u8a9e\u300b\u4e2d\u7684\u95dc\u5361\uff0c\u4ee5\u53ca\u65b0\u624b\u73a9\u5bb6\u7684\u57fa\u672c\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u8981\u5b8c\u6210\u300a\u5bb6\u5712\u7269\u8a9e\u300b\u4e2d\u7684\u95dc\u5361\uff0c\u4f60\u9700\u8981\u5c07\u4e09\u500b\u6216\u4e09\u500b\u4ee5\u4e0a\u76f8\u540c\u7269\u54c1\u914d\u5c0d\uff0c\u4ee5\u6e05\u9664\u5b83\u5011\u3002\u4f5c\u70ba\u65b0\u624b\u73a9\u5bb6\uff0c\u61c9\u5c08\u6ce8\u65bc\u5275\u9020\u56db\u500b\u6216\u56db\u500b\u4ee5\u4e0a\u7269\u54c1\u7684\u914d\u5c0d\uff0c\u4ee5\u7522\u751f\u706b\u7bad\u548c\u70b8\u5f48\u7b49\u589e\u5f37\u9053\u5177\u3002\u4f8b\u5982\uff0c\u5c07\u56db\u500b\u7cd6\u679c\u9023\u6210\u4e00\u884c\u5373\u6703\u7522\u751f\u706b\u7bad\uff0c\u7528\u65bc\u6e05\u9664\u6574\u884c\u3002\u6b65\u9a5f\u4e00\uff1a\u5c0b\u627e\u56db\u500b\u6216\u56db\u500b\u4ee5\u4e0a\u7269\u54c1\u7684\u914d\u5c0d\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u589e\u5f37\u9053\u5177\u6e05\u9664\u5927\u90e8\u5206\u904a\u6232\u677f\u4e0a\u7684\u7269\u4ef6\u3002\u6b65\u9a5f\u4e09\uff1a\u512a\u5148\u6e05\u9664\u969c\u7919\u7269\uff0c\u4f8b\u5982\u76d2\u5b50\u548c\u93c8\u689d\uff0c\u4ee5\u53d6\u5f97\u96e3\u4ee5\u89f8\u53ca\u7684\u7269\u54c1\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u300a\u5bb6\u5712\u7269\u8a9e\u300b\u4e2d\u6709\u4e9b\u95dc\u5361\u4f3c\u4e4e\u7121\u6cd5\u901a\u95dc\uff0c\u4ee5\u53ca\u54ea\u4e9b\u9ad8\u7d1a\u7b56\u7565\u53ef\u4ee5\u5e6b\u52a9\uff1f", "answer": "\u300a\u5bb6\u5712\u7269\u8a9e\u300b\u4e2d\u6709\u4e9b\u95dc\u5361\u8a2d\u8a08\u5f97\u975e\u5e38\u5177\u6709\u6311\u6230\u6027\uff0c\u901a\u5e38\u662f\u56e0\u70ba\u79fb\u52d5\u6b21\u6578\u6709\u9650\u6216\u969c\u7919\u7269\u8907\u96dc\u3002\u9ad8\u7d1a\u73a9\u5bb6\u61c9\u5c08\u6ce8\u65bc\u5275\u9020\u589e\u5f37\u9053\u5177\u7684\u7d44\u5408\u3002\u4f8b\u5982\uff0c\u5c07\u706b\u7bad\u8207\u70b8\u5f48\u7d50\u5408\u53ef\u4ee5\u6e05\u9664\u904a\u6232\u677f\u4e0a\u7684\u5927\u90e8\u5206\u5340\u57df\u3002\u6b65\u9a5f\u4e00\uff1a\u898f\u5283\u60a8\u7684\u52d5\u4f5c\uff0c\u4ee5\u5275\u9020\u589e\u5f37\u9053\u5177\u7d44\u5408\u3002\u6b65\u9a5f\u4e8c\uff1a\u7b56\u7565\u6027\u5730\u4f7f\u7528\u589e\u5f37\u9053\u5177\u4f86\u91dd\u5c0d\u7279\u5b9a\u969c\u7919\u7269\u3002\u6b65\u9a5f\u4e09\uff1a\u5728\u63a5\u8fd1\u5b8c\u6210\u95dc\u5361\u7684\u6642\u5019\uff0c\u5132\u5b58\u589e\u5f37\u9053\u5177\u4ee5\u61c9\u5c0d\u95dc\u9375\u6642\u523b\u3002"}, {"question": "\u300a\u5bb6\u5712\u7269\u8a9e\u300b\u7684\u6838\u5fc3\u6a5f\u5236\u662f\u4ec0\u9ebc\uff0c\u73a9\u5bb6\u61c9\u8a72\u4e86\u89e3\u54ea\u4e9b\u77e5\u8b58\u4ee5\u6539\u5584\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u4e86\u89e3\u300a\u5bb6\u5712\u7269\u8a9e\u300b\u7684\u6838\u5fc3\u6a5f\u5236\u5c0d\u65bc\u6539\u5584\u904a\u6232\u9ad4\u9a57\u81f3\u95dc\u91cd\u8981\u3002\u8a72\u904a\u6232\u570d\u7e5e\u4e09\u6d88\u76ca\u667a\u904a\u6232\u9032\u884c\uff0c\u73a9\u5bb6\u6e05\u9664\u7269\u54c1\u4ee5\u53d6\u5f97\u9032\u5c55\u3002\u6bcf\u500b\u95dc\u5361\u90fd\u6709\u7279\u5b9a\u7684\u76ee\u6a19\uff0c\u4f8b\u5982\u6536\u96c6\u7279\u5b9a\u7269\u54c1\u6216\u6e05\u9664\u969c\u7919\u7269\u3002\u4f8b\u5982\uff0c\u5728\u9700\u8981\u6536\u96c6\u8336\u676f\u7684\u95dc\u5361\u4e2d\uff0c\u5c08\u6ce8\u65bc\u76f4\u63a5\u91dd\u5c0d\u8336\u676f\u7684\u914d\u5c0d\u3002\u6b64\u5916\uff0c\u904a\u6232\u9084\u5305\u542b\u623f\u5c4b\u88dd\u4fee\u65b9\u9762\uff0c\u73a9\u5bb6\u4f7f\u7528\u5f9e\u95dc\u5361\u4e2d\u7372\u5f97\u7684\u661f\u661f\u4f86\u88dd\u98fe\u548c\u5347\u7d1a\u4ed6\u5011\u7684\u623f\u5c4b\u3002\u9019\u7a2e\u96d9\u91cd\u6a5f\u5236\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u6df1\u5ea6\u548c\u591a\u6a23\u6027\u3002"}, {"question": "\u5982\u4f55\u5c07\u6211\u7684\u300a\u5bb6\u5712\u7269\u8a9e\u300b\u904a\u6232\u9032\u5ea6\u5728\u4e0d\u540c\u88dd\u7f6e\u9593\u8f49\u79fb\uff0c\u4ee5\u53ca\u9700\u8981\u6ce8\u610f\u54ea\u4e9b\u4e8b\u9805\uff1f", "answer": "\u8981\u5728\u4e0d\u540c\u88dd\u7f6e\u9593\u8f49\u79fb\u300a\u5bb6\u5712\u7269\u8a9e\u300b\u904a\u6232\u9032\u5ea6\uff0c\u8acb\u78ba\u4fdd\u60a8\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u90fd\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u3002\u4f7f\u7528 Facebook \u6216\u60a8\u7684 Apple/Google \u5e33\u6236\u540c\u6b65\u60a8\u7684\u904a\u6232\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9e iPhone \u5207\u63db\u5230 Android \u88dd\u7f6e\uff0c\u8acb\u4f7f\u7528\u76f8\u540c\u7684 Facebook \u5e33\u6236\u767b\u5165\uff0c\u4ee5\u7e7c\u7e8c\u4e0a\u6b21\u904a\u6232\u7684\u9032\u5ea6\u3002\u8acb\u6ce8\u610f\uff0c\u67d0\u4e9b\u61c9\u7528\u5167\u8cfc\u8cb7\u9805\u76ee\u53ef\u80fd\u7121\u6cd5\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u8f49\u79fb\uff0c\u56e0\u6b64\u8acb\u67e5\u770b\u904a\u6232\u652f\u63f4\u9801\u9762\u4ee5\u7372\u53d6\u8a73\u7d30\u8aaa\u660e\u3002"}, {"question": "\u300a\u5bb6\u5712\u7269\u8a9e\u300b\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff0c\u73a9\u5bb6\u53ef\u80fd\u4e0d\u77e5\u9053\uff1f", "answer": "\u300a\u5bb6\u5712\u7269\u8a9e\u300b\u5145\u6eff\u4e86\u96b1\u85cf\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u589e\u6dfb\u4e86\u904a\u6232\u6a02\u8da3\u3002\u503c\u5f97\u6ce8\u610f\u7684\u4e00\u500b\u5f69\u86cb\u662f\u80fd\u5920\u8207\u623f\u5c4b\u88dd\u4fee\u5834\u666f\u4e2d\u7684\u67d0\u4e9b\u7269\u54c1\u9032\u884c\u4e92\u52d5\u3002\u4f8b\u5982\uff0c\u9ede\u64ca\u5ba2\u5ef3\u88e1\u7684\u8c93\u54aa\u53ef\u80fd\u6703\u89f8\u767c\u53ef\u611b\u7684\u52d5\u756b\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u95dc\u5361\u4e2d\u6709\u4e00\u4e9b\u96b1\u85cf\u589e\u5f37\u9053\u5177\uff0c\u53ef\u901a\u904e\u5728\u7279\u5b9a\u6a21\u5f0f\u4e0b\u5b8c\u6210\u7279\u5b9a\u914d\u5c0d\u4f86\u555f\u7528\u3002\u63a2\u7d22\u9019\u4e9b\u96b1\u85cf\u529f\u80fd\u53ef\u4ee5\u8b93\u904a\u6232\u9ad4\u9a57\u66f4\u52a0\u8c50\u5bcc\u548c\u4ee4\u4eba\u6109\u5feb\u3002"}, {"question": "\u300a\u5bb6\u5712\u7269\u8a9e\u300b\u4e2d\u54ea\u4e9b\u589e\u5f37\u9053\u5177\u6700\u9069\u5408\u6e05\u9664\u56f0\u96e3\u95dc\u5361\uff1f", "answer": "\u300a\u5bb6\u5712\u7269\u8a9e\u300b\u4e2d\u6700\u6709\u6548\u7684\u589e\u5f37\u9053\u5177\uff0c\u7528\u65bc\u6e05\u9664\u56f0\u96e3\u95dc\u5361\u7684\u662f\u5f69\u8679\u7403\u3001\u706b\u7bad\u548c\u70b8\u5f48\u3002\u5f69\u8679\u7403\u53ef\u4ee5\u8207\u4efb\u4f55\u7269\u54c1\u914d\u5c0d\uff0c\u5f9e\u904a\u6232\u677f\u4e0a\u6e05\u9664\u6240\u6709\u8a72\u7269\u54c1\u7684\u5be6\u4f8b\u3002\u4f8b\u5982\uff0c\u5c07\u5f69\u8679\u7403\u8207\u8336\u676f\u914d\u5c0d\u5c07\u6e05\u9664\u6240\u6709\u8336\u676f\u3002\u706b\u7bad\u6e05\u9664\u6574\u884c\u6216\u6574\u5217\uff0c\u800c\u70b8\u5f48\u6e05\u9664 3x3 \u7684\u5340\u57df\u3002\u7d50\u5408\u9019\u4e9b\u589e\u5f37\u9053\u5177\u53ef\u4ee5\u7522\u751f\u66f4\u5f37\u5927\u7684\u6548\u679c\uff0c\u4f8b\u5982\u4f7f\u7528\u5f69\u8679\u7403\u8207\u706b\u7bad\u6e05\u9664\u591a\u884c\u7279\u5b9a\u7269\u54c1\u3002"}, {"question": "\u300a\u5bb6\u5712\u7269\u8a9e\u300b\u4e2d\u7684\u661f\u661f\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u5927\u5316\u661f\u661f\u7684\u6536\u96c6\uff1f", "answer": "\u300a\u5bb6\u5712\u7269\u8a9e\u300b\u4e2d\u7684\u661f\u661f\u7cfb\u7d71\u5141\u8a31\u73a9\u5bb6\u901a\u904e\u5b8c\u6210\u95dc\u5361\u4f86\u7372\u5f97\u661f\u661f\uff0c\u7136\u5f8c\u7528\u9019\u4e9b\u661f\u661f\u4f86\u88dd\u4fee\u548c\u88dd\u98fe\u623f\u5c4b\u3002\u8981\u6700\u5927\u5316\u661f\u661f\u7684\u6536\u96c6\uff0c\u61c9\u5c08\u6ce8\u65bc\u5728\u6700\u5c11\u79fb\u52d5\u6b21\u6578\u7684\u60c5\u6cc1\u4e0b\u5b8c\u6210\u95dc\u5361\uff0c\u9019\u901a\u5e38\u6703\u5c0e\u81f4\u984d\u5916\u661f\u661f\u7684\u734e\u52f5\u3002\u4f8b\u5982\uff0c\u5728\u5269\u9918\u4e09\u6b21\u79fb\u52d5\u7684\u60c5\u6cc1\u4e0b\u5b8c\u6210\u4e00\u500b\u95dc\u5361\u53ef\u80fd\u7372\u5f97\u984d\u5916\u4e00\u9846\u661f\u661f\u3002\u6b64\u5916\uff0c\u53c3\u8207\u7279\u5225\u6d3b\u52d5\u548c\u6bcf\u65e5\u6311\u6230\u53ef\u4ee5\u63d0\u4f9b\u984d\u5916\u7372\u5f97\u661f\u661f\u7684\u6a5f\u6703\u3002\u901a\u904e\u512a\u5148\u8003\u616e\u9ad8\u5f71\u97ff\u529b\u623f\u5c4b\u88dd\u4fee\u4f86\u6709\u6548\u7ba1\u7406\u661f\u661f\uff0c\u4e5f\u53ef\u4ee5\u589e\u5f37\u60a8\u7684\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u300a\u5bb6\u5712\u7269\u8a9e\u300b\u4e2d\u6700\u4f73\u7684\u589e\u5f37\u9053\u5177\u7ba1\u7406\u7b56\u7565\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u4f55\u6642\u61c9\u8a72\u4f7f\u7528\u5b83\u5011\uff1f", "answer": "\u5728\u300a\u5bb6\u5712\u7269\u8a9e\u300b\u4e2d\u6709\u6548\u7ba1\u7406\u589e\u5f37\u9053\u5177\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u60a8\u5b8c\u6210\u56f0\u96e3\u95dc\u5361\u7684\u6a5f\u7387\u3002\u589e\u5f37\u9053\u5177\u61c9\u8a72\u7b56\u7565\u6027\u5730\u4f7f\u7528\uff0c\u5c24\u5176\u662f\u5728\u60a8\u63a5\u8fd1\u5b8c\u6210\u95dc\u5361\uff0c\u4f46\u9700\u8981\u984d\u5916\u5354\u52a9\u7684\u6642\u5019\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u589e\u5f37\u9053\u5177\u6e05\u9664\u9811\u56fa\u7684\u969c\u7919\u7269\uff0c\u6216\u5275\u9020\u81f3\u95dc\u91cd\u8981\u7684\u589e\u5f37\u9053\u5177\u3002\u6b65\u9a5f\u4e00\uff1a\u5c07\u589e\u5f37\u9053\u5177\u5132\u5b58\u8d77\u4f86\uff0c\u7528\u65bc\u60a8\u6301\u7e8c\u52aa\u529b\u7684\u95dc\u5361\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u589e\u5f37\u9053\u5177\u4f86\u5275\u9020\u6216\u63d0\u5347\u589e\u5f37\u9053\u5177\u3002\u6b65\u9a5f\u4e09\uff1a\u5c07\u589e\u5f37\u9053\u5177\u8207\u589e\u5f37\u9053\u5177\u7d50\u5408\uff0c\u4ee5\u6700\u5927\u5316\u6548\u679c\u3002\u9019\u7a2e\u65b9\u6cd5\u53ef\u4ee5\u78ba\u4fdd\u60a8\u5f9e\u6709\u9650\u7684\u589e\u5f37\u9053\u5177\u4f9b\u61c9\u4e2d\u7372\u5f97\u6700\u5927\u7684\u50f9\u503c\u3002"}, {"question": "\u5982\u4f55\u512a\u5316\u6211\u7684\u884c\u52d5\u898f\u5283\uff0c\u4ee5\u63d0\u9ad8\u300a\u5bb6\u5712\u7269\u8a9e\u300b\u6210\u529f\u7684\u6a5f\u7387\uff1f", "answer": "\u512a\u5316\u300a\u5bb6\u5712\u7269\u8a9e\u300b\u4e2d\u7684\u884c\u52d5\u898f\u5283\uff0c\u9700\u8981\u4ed4\u7d30\u5206\u6790\u904a\u6232\u677f\uff0c\u5728\u57f7\u884c\u4efb\u4f55\u884c\u52d5\u4e4b\u524d\u3002\u5c0b\u627e\u53ef\u4ee5\u5275\u9020\u589e\u5f37\u9053\u5177\u6216\u4e00\u6b21\u6e05\u9664\u591a\u500b\u969c\u7919\u7269\u7684\u914d\u5c0d\u3002\u4f8b\u5982\uff0c\u898f\u5283\u4e00\u500b\u5275\u9020\u706b\u7bad\u7684\u52d5\u4f5c\u53ef\u4ee5\u6e05\u9664\u6574\u884c\uff0c\u9019\u53ef\u80fd\u6703\u5c0e\u81f4\u9023\u9396\u914d\u5c0d\u3002\u6b65\u9a5f\u4e00\uff1a\u67e5\u770b\u904a\u6232\u677f\u662f\u5426\u5b58\u5728\u53ef\u4ee5\u5275\u9020\u589e\u5f37\u9053\u5177\u7684\u6f5b\u5728\u914d\u5c0d\u3002\u6b65\u9a5f\u4e8c\uff1a\u512a\u5148\u8003\u616e\u6e05\u9664\u969c\u7919\u7269\u6216\u91dd\u5c0d\u95dc\u5361\u76ee\u6a19\u7684\u884c\u52d5\u3002\u6b65\u9a5f\u4e09\uff1a\u9810\u5148\u8003\u616e\u60a8\u7684\u52d5\u4f5c\u5c07\u5982\u4f55\u5f71\u97ff\u904a\u6232\u677f\u7684\u4f48\u5c40\u3002\u9019\u7a2e\u7b56\u7565\u6027\u65b9\u6cd5\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u60a8\u6210\u529f\u7684\u6a5f\u7387\u3002"}, {"question": "\u65b0\u624b\u73a9\u5bb6\u5728\u300a\u5bb6\u5712\u7269\u8a9e\u300b\u4e2d\u5e38\u72af\u54ea\u4e9b\u932f\u8aa4\uff0c\u4ee5\u53ca\u5982\u4f55\u907f\u514d\uff1f", "answer": "\u300a\u5bb6\u5712\u7269\u8a9e\u300b\u7684\u65b0\u624b\u73a9\u5bb6\u7d93\u5e38\u72af\u7684\u932f\u8aa4\u662f\uff0c\u5728\u6c92\u6709\u8a08\u5283\u597d\u52d5\u4f5c\u7684\u60c5\u6cc1\u4e0b\u5306\u5306\u901a\u904e\u95dc\u5361\u3002\u9019\u53ef\u80fd\u6703\u5c0e\u81f4\u6d6a\u8cbb\u52d5\u4f5c\u548c\u632b\u6298\u611f\u3002\u53e6\u4e00\u500b\u5e38\u898b\u932f\u8aa4\u662f\u4e0d\u6709\u6548\u5730\u5229\u7528\u589e\u5f37\u9053\u5177\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u706b\u7bad\u6e05\u9664\u55ae\u500b\u9805\u76ee\u800c\u4e0d\u662f\u4e00\u884c\u969c\u7919\u7269\u6548\u7387\u4e0d\u9ad8\u3002\u70ba\u907f\u514d\u9019\u4e9b\u932f\u8aa4\uff0c\u8acb\u82b1\u6642\u9593\u5206\u6790\u904a\u6232\u677f\u4e26\u898f\u5283\u60a8\u7684\u52d5\u4f5c\u3002\u5c08\u6ce8\u65bc\u5275\u9020\u589e\u5f37\u9053\u5177\u4e26\u7b56\u7565\u6027\u5730\u4f7f\u7528\u5b83\u5011\u4f86\u6e05\u9664\u591a\u500b\u969c\u7919\u7269\u6216\u91dd\u5c0d\u7279\u5b9a\u76ee\u6a19\u3002\u9019\u7a2e\u5be9\u614e\u7684\u65b9\u6cd5\u53ef\u4ee5\u6975\u5927\u5730\u63d0\u5347\u60a8\u7684\u904a\u6232\u9ad4\u9a57\u3002"}]
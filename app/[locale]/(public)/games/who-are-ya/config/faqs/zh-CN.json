[{"question": "\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u5728\u300aWho Are Ya\u300b\u4e2d\u4e0a\u624b\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u4e0a\u624b\u300aWho Are Ya\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41\uff1a\u4f7f\u7528\u5de6\u6447\u6746\u6216\u65b9\u5411\u952e\u79fb\u52a8\u89d2\u8272\u3002\u6b65\u9aa42\uff1a\u6309\u4e0b\u201cA\u201d\u952e\u6216\u7a7a\u683c\u952e\u4e0e\u7269\u4f53\u6216NPC\u4e92\u52a8\u3002\u6b65\u9aa43\uff1a\u6309\u4e0b\u201cB\u201d\u952e\u6216\u201cE\u201d\u952e\u8bbf\u95ee\u4f60\u7684\u80cc\u5305\u3002\u4f8b\u5982\uff0c\u5f53\u4f60\u9047\u5230\u9501\u7740\u7684\u95e8\u65f6\uff0c\u4e0e\u5b83\u4e92\u52a8\u67e5\u770b\u662f\u5426\u62e5\u6709\u6240\u9700\u7684\u94a5\u5319\u3002\u8fd9\u4e2a\u57fa\u672c\u63a7\u5236\u65b9\u6848\u786e\u4fdd\u4e86\u6e38\u620f\u6d41\u7545\u7684\u5165\u95e8\u4f53\u9a8c\u3002"}, {"question": "\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u5728\u300aWho Are Ya\u300b\u7684\u524d10\u5c0f\u65f6\u5185\u751f\u5b58\uff1f", "answer": "\u5728\u300aWho Are Ya\u300b\u7684\u524d10\u5c0f\u65f6\u5185\u751f\u5b58\u9700\u8981\u5173\u6ce8\u4ee5\u4e0b\u5173\u952e\u9886\u57df\uff1a\u6b65\u9aa41\uff1a\u59cb\u7ec8\u4fdd\u6301\u4f60\u7684\u80cc\u5305\u4e2d\u62e5\u6709\u8db3\u591f\u7684\u6cbb\u7597\u836f\u6c34\u548c\u57fa\u672c\u5de5\u5177\u3002\u6b65\u9aa42\uff1a\u5b8c\u6210\u6559\u7a0b\u4efb\u52a1\u4ee5\u83b7\u5f97\u7ecf\u9a8c\u548c\u91cd\u8981\u7269\u54c1\u3002\u6b65\u9aa43\uff1a\u5728\u88c5\u5907\u5145\u8db3\u4e4b\u524d\uff0c\u907f\u514d\u4e0e\u9ad8\u7b49\u7ea7\u654c\u4eba\u6218\u6597\u3002\u4f8b\u5982\uff0c\u5728\u8d77\u59cb\u533a\u57df\uff0c\u4e13\u6ce8\u4e8e\u6536\u96c6\u6728\u6750\u548c\u77f3\u5934\u7b49\u8d44\u6e90\u6765\u5236\u4f5c\u57fa\u672c\u6b66\u5668\u3002\u6b64\u7b56\u7565\u786e\u4fdd\u4e86\u4f60\u7684\u65c5\u7a0b\u62e5\u6709\u4e00\u4e2a\u575a\u5b9e\u7684\u57fa\u7840\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u7406\u89e3\u300aWho Are Ya\u300b\u4e2d\u7684\u5bf9\u8bdd\u7cfb\u7edf\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u7406\u89e3\u300aWho Are Ya\u300b\u4e2d\u7684\u5bf9\u8bdd\u7cfb\u7edf\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u5f71\u54cd\u7740\u89d2\u8272\u5173\u7cfb\u548c\u4efb\u52a1\u7ed3\u679c\u3002\u6b65\u9aa41\uff1a\u6ce8\u610f\u5bf9\u8bdd\u9009\u9879\uff0c\u56e0\u4e3a\u5b83\u4eec\u53ef\u80fd\u5f00\u542f\u65b0\u7684\u4efb\u52a1\u7ebf\u6216\u5173\u95ed\u5176\u4ed6\u4efb\u52a1\u7ebf\u3002\u6b65\u9aa42\uff1a\u5728\u53ef\u7528\u65f6\u4f7f\u7528\u201c\u8bf4\u670d\u201d\u9009\u9879\u4ee5\u83b7\u5f97\u66f4\u597d\u7684\u5956\u52b1\u3002\u6b65\u9aa43\uff1a\u8ddf\u8e2aNPC\u7684\u504f\u597d\u4ee5\u5efa\u7acb\u8054\u76df\u3002\u4f8b\u5982\uff0c\u5728\u4e89\u7aef\u4e2d\u9009\u62e9\u652f\u6301\u6751\u957f\u53ef\u80fd\u4f1a\u8ba9\u4f60\u83b7\u5f97\u72ec\u5bb6\u7269\u54c1\u3002\u8fd9\u4e2a\u7cfb\u7edf\u4e3a\u6e38\u620f\u4f53\u9a8c\u589e\u6dfb\u4e86\u6df1\u5ea6\u3002"}, {"question": "\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u5982\u4f55\u5728\u300aWho Are Ya\u300b\u4e2d\u4f18\u5316\u8d44\u6e90\u7ba1\u7406\uff1f", "answer": "\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u4ee5\u4e0b\u6b65\u9aa4\u5728\u300aWho Are Ya\u300b\u4e2d\u4f18\u5316\u8d44\u6e90\u7ba1\u7406\uff1a\u6b65\u9aa41\uff1a\u4f18\u5148\u5728\u7279\u5b9a\u6e38\u620f\u4e8b\u4ef6\u4e2d\u6536\u96c6\u7a00\u6709\u6750\u6599\u3002\u6b65\u9aa42\uff1a\u6709\u6548\u5730\u5229\u7528\u5236\u4f5c\u529f\u80fd\uff0c\u4e13\u6ce8\u4e8e\u9ad8\u9700\u6c42\u7269\u54c1\u3002\u6b65\u9aa43\uff1a\u4e0e\u5176\u4ed6\u73a9\u5bb6\u4ea4\u6613\u5269\u4f59\u8d44\u6e90\u4ee5\u83b7\u53d6\u6240\u9700\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5728\u201c\u4e30\u6536\u8282\u201d\u671f\u95f4\uff0c\u96c6\u4e2d\u6536\u96c6\u5728\u6b64\u671f\u95f4\u624d\u6709\u7684\u7a00\u6709\u8349\u836f\u3002\u8fd9\u79cd\u65b9\u6cd5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u4e86\u6548\u7387\u548c\u76c8\u5229\u80fd\u529b\u3002"}, {"question": "\u73a9\u5bb6\u5728\u300aWho Are Ya\u300b\u4e2d\u5e94\u8be5\u4f7f\u7528\u54ea\u4e9b\u9ad8\u7ea7\u6218\u6597\u7b56\u7565\uff1f", "answer": "\u300aWho Are Ya\u300b\u4e2d\u7684\u9ad8\u7ea7\u6218\u6597\u7b56\u7565\u5305\u62ec\uff1a\u6b65\u9aa41\uff1a\u5229\u7528\u8fde\u51fb\u653b\u51fb\uff0c\u5c06\u8f7b\u51fb\u548c\u91cd\u51fb\u4e32\u8054\u8d77\u6765\u3002\u6b65\u9aa42\uff1a\u5229\u7528\u73af\u5883\u5143\u7d20\uff0c\u4f8b\u5982\u5c06\u654c\u4eba\u63a8\u5165\u9677\u9631\u3002\u6b65\u9aa43\uff1a\u88c5\u5907\u4e0e\u4f60\u7684\u6e38\u620f\u98ce\u683c\u76f8\u5339\u914d\u7684\u88c5\u5907\uff0c\u4f8b\u5982\uff0c\u5bf9\u5177\u6709\u653b\u51fb\u6027\u7684\u73a9\u5bb6\u800c\u8a00\uff0c\u88c5\u5907\u9ad8\u4f24\u5bb3\u6b66\u5668\u3002\u4f8b\u5982\uff0c\u5728\u4e0eBOSS\u6218\u6597\u65f6\uff0c\u5229\u7528\u7ade\u6280\u573a\u4e2d\u7684\u67f1\u5b50\u6765\u963b\u6321\u653b\u51fb\uff0c\u540c\u65f6\u8ba1\u5212\u4f60\u7684\u53cd\u51fb\u3002\u8fd9\u4e9b\u7b56\u7565\u589e\u5f3a\u4e86\u6218\u6597\u6548\u7387\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u7cbe\u901a\u6280\u80fd\u6811\u5bf9\u4e8e\u300aWho Are Ya\u300b\u540e\u671f\u6e38\u620f\u7684\u6210\u529f\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u7cbe\u901a\u6280\u80fd\u6811\u5bf9\u4e8e\u300aWho Are Ya\u300b\u540e\u671f\u6e38\u620f\u7684\u6210\u529f\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u5141\u8bb8\u73a9\u5bb6\u8fdb\u884c\u4e13\u4e1a\u5316\u7684\u89d2\u8272\u6784\u5efa\u3002\u6b65\u9aa41\uff1a\u4e13\u6ce8\u4e8e\u4e0e\u4f60\u504f\u597d\u7684\u6e38\u620f\u98ce\u683c\u76f8\u534f\u8c03\u7684\u6280\u80fd\u3002\u6b65\u9aa42\uff1a\u5206\u914d\u70b9\u6570\u5230\u63d0\u4f9b\u957f\u671f\u597d\u5904\u7684\u88ab\u52a8\u6280\u80fd\u3002\u6b65\u9aa43\uff1a\u5982\u6709\u5fc5\u8981\uff0c\u91cd\u65b0\u5206\u914d\u6280\u80fd\u70b9\u4ee5\u9002\u5e94\u65b0\u7684\u6311\u6218\u3002\u4f8b\u5982\uff0c\u6295\u8d44\u4e8e\u201c\u6f5c\u884c\u201d\u6280\u80fd\u6811\u53ef\u4ee5\u8ba9\u4f60\u51e0\u4e4e\u5bf9\u654c\u4eba\u9690\u5f62\uff0c\u8fd9\u5bf9\u4e8e\u67d0\u4e9b\u4efb\u52a1\u81f3\u5173\u91cd\u8981\u3002\u8fd9\u79cd\u7cbe\u901a\u786e\u4fdd\u4e86\u540e\u671f\u6e38\u620f\u7684\u9002\u5e94\u6027\u548c\u529b\u91cf\u3002"}, {"question": "\u300aWho Are Ya\u300b\u4e2d\u7684\u5236\u4f5c\u7cfb\u7edf\u80cc\u540e\u7684\u5173\u952e\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "\u300aWho Are Ya\u300b\u4e2d\u7684\u5236\u4f5c\u7cfb\u7edf\u56f4\u7ed5\u4ee5\u4e0b\u5173\u952e\u673a\u5236\u5c55\u5f00\uff1a\u6b65\u9aa41\uff1a\u901a\u8fc7\u63a2\u7d22\u548c\u6218\u6597\u6536\u96c6\u8d44\u6e90\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u5236\u4f5c\u53f0\u5c06\u6750\u6599\u7ec4\u5408\u6210\u6709\u7528\u7684\u7269\u54c1\u3002\u6b65\u9aa43\uff1a\u5c1d\u8bd5\u4e0d\u540c\u7684\u914d\u65b9\u6765\u53d1\u73b0\u7a00\u6709\u56fe\u7eb8\u3002\u4f8b\u5982\uff0c\u5728\u7194\u7089\u4e2d\u5c06\u94c1\u77ff\u77f3\u548c\u7164\u70ad\u7ed3\u5408\u53ef\u4ee5\u5236\u4f5c\u4e00\u628a\u950b\u5229\u7684\u5b9d\u5251\u3002\u8fd9\u4e2a\u7cfb\u7edf\u9f13\u52b1\u521b\u9020\u529b\u548c\u8d44\u6e90\u5229\u7528\u3002"}, {"question": "\u52a8\u6001\u5929\u6c14\u7cfb\u7edf\u5982\u4f55\u5728\u300aWho Are Ya\u300b\u4e2d\u5f71\u54cd\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u300aWho Are Ya\u300b\u4e2d\u7684\u52a8\u6001\u5929\u6c14\u7cfb\u7edf\u4ee5\u591a\u79cd\u65b9\u5f0f\u5f71\u54cd\u6e38\u620f\u4f53\u9a8c\uff1a\u6b65\u9aa41\uff1a\u96e8\u5929\u4f1a\u4f7f\u5730\u9762\u53d8\u5f97\u6e7f\u6ed1\uff0c\u5f71\u54cd\u79fb\u52a8\u548c\u6218\u6597\u3002\u6b65\u9aa42\uff1a\u66b4\u98ce\u96ea\u4f1a\u964d\u4f4e\u80fd\u89c1\u5ea6\uff0c\u4f7f\u5bfc\u822a\u53d8\u5f97\u96be\u4ee5\u8fdb\u884c\u3002\u6b65\u9aa43\uff1a\u6674\u5929\u4f1a\u63d0\u9ad8\u67d0\u4e9b\u6280\u80fd\uff0c\u6bd4\u5982\u8015\u79cd\u6548\u7387\u3002\u4f8b\u5982\uff0c\u5728\u96f7\u96e8\u5929\u6c14\u4e2d\uff0c\u4f60\u53ef\u80fd\u4f1a\u5728\u5cb8\u8fb9\u53d1\u73b0\u7a00\u6709\u6750\u6599\u3002\u8fd9\u4e2a\u7cfb\u7edf\u589e\u52a0\u4e86\u6e38\u620f\u4e16\u754c\u7684\u771f\u5b9e\u611f\u548c\u591a\u6837\u6027\u3002"}, {"question": "\u5728\u300aWho Are Ya\u300b\u4e2d\uff0c\u73a9\u5bb6\u5728\u4e0d\u540c\u5e73\u53f0\u95f4\u8f6c\u79fb\u8fdb\u5ea6\u65f6\u5e94\u8be5\u8003\u8651\u54ea\u4e9b\u56e0\u7d20\uff1f", "answer": "\u5728\u300aWho Are Ya\u300b\u4e2d\uff0c\u73a9\u5bb6\u5728\u4e0d\u540c\u5e73\u53f0\u95f4\u8f6c\u79fb\u8fdb\u5ea6\u65f6\uff0c\u8bf7\u8003\u8651\u4ee5\u4e0b\u56e0\u7d20\uff1a\u6b65\u9aa41\uff1a\u786e\u4fdd\u4f60\u7684\u6e38\u620f\u8d26\u6237\u94fe\u63a5\u5230\u4e00\u4e2a\u901a\u7528\u7684\u4e2a\u4eba\u8d44\u6599\u3002\u6b65\u9aa42\uff1a\u68c0\u67e5\u5e73\u53f0\u7279\u6709\u7684\u9650\u5236\u6216\u5dee\u5f02\u3002\u6b65\u9aa43\uff1a\u9a8c\u8bc1\u6240\u6709DLC\u548c\u66f4\u65b0\u90fd\u517c\u5bb9\u3002\u4f8b\u5982\uff0c\u4ecePC\u8f6c\u79fb\u5230\u6e38\u620f\u4e3b\u673a\u53ef\u80fd\u9700\u8981\u8c03\u6574\u63a7\u5236\u8bbe\u7f6e\u4ee5\u83b7\u5f97\u6700\u4f73\u6e38\u620f\u4f53\u9a8c\u3002\u6b64\u8003\u8651\u786e\u4fdd\u4e86\u8de8\u8bbe\u5907\u7684\u5e73\u6ed1\u8fc7\u6e21\u3002"}, {"question": "\u73a9\u5bb6\u5728\u300aWho Are Ya\u300b\u4e2d\u53ef\u4ee5\u4ece\u54ea\u91cc\u627e\u5230\u9690\u85cf\u7684\u80cc\u666f\u6545\u4e8b\u7269\u54c1\uff1f", "answer": "\u300aWho Are Ya\u300b\u4e2d\u7684\u9690\u85cf\u80cc\u666f\u6545\u4e8b\u7269\u54c1\u53ef\u4ee5\u4ece\u8fd9\u4e9b\u5730\u70b9\u627e\u5230\uff1a\u6b65\u9aa41\uff1a\u63a2\u7d22\u504f\u50fb\u533a\u57df\uff0c\u4f8b\u5982\u6d1e\u7a74\u548c\u5e9f\u589f\u3002\u6b65\u9aa42\uff1a\u4e0e\u770b\u4f3c\u666e\u901a\u7684\u7269\u4f53\u4e92\u52a8\uff0c\u4ece\u4e2d\u5bfb\u627e\u7ec6\u5fae\u7684\u7ebf\u7d22\u3002\u6b65\u9aa43\uff1a\u5b8c\u6210\u7279\u5b9a\u4efb\u52a1\uff0c\u4ece\u800c\u89e3\u9501\u901a\u5f80\u79d8\u5bc6\u533a\u57df\u7684\u901a\u9053\u3002\u4f8b\u5982\uff0c\u56fe\u4e66\u9986\u4e2d\u770b\u4f3c\u666e\u901a\u7684\u4e66\u53ef\u80fd\u5305\u542b\u901a\u5f80\u9690\u85cf\u5b9d\u85cf\u7684\u5730\u56fe\u3002\u8fd9\u4e9b\u7269\u54c1\u4e30\u5bcc\u4e86\u6e38\u620f\u7684\u6545\u4e8b\uff0c\u5e76\u5956\u52b1\u63a2\u7d22\u3002"}]
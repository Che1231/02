[{"question": "Who Are Ya \uac8c\uc784\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc2dc\uc791\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Who Are Ya \uac8c\uc784\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc2dc\uc791\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. STEP1: \uc67c\ucabd \uc870\uc774\uc2a4\ud2f1 \ub610\ub294 \ud654\uc0b4\ud45c \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uce90\ub9ad\ud130\ub97c \uc774\ub3d9\ud558\uc138\uc694. STEP2: 'A' \ubc84\ud2bc \ub610\ub294 \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \ub20c\ub7ec \ubb3c\uccb4 \ub610\ub294 NPC\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\uc138\uc694. STEP3: 'B' \ubc84\ud2bc \ub610\ub294 'E' \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc778\ubca4\ud1a0\ub9ac\ub97c \ud655\uc778\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc7a0\uae34 \ubb38\uc744 \ub9cc\ub098\uba74 \ud544\uc694\ud55c \uc5f4\uc1e0\uac00 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uae30 \uc704\ud574 \ubb38\uacfc \uc0c1\ud638 \uc791\uc6a9\ud558\uc138\uc694. \uc774 \uae30\ubcf8 \ucee8\ud2b8\ub864 \ubc29\uc2dd\uc740 \uac8c\uc784\uc5d0 \ub300\ud55c \uc6d0\ud65c\ud55c \uc18c\uac1c\ub97c \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "Who Are Ya \uac8c\uc784\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \uccab 10\uc2dc\uac04 \ub3d9\uc548 \uc0dd\uc874\ud558\ub294 \ub370 \ud544\uc218\uc801\uc778 \ud301\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Who Are Ya \uac8c\uc784\uc5d0\uc11c \uccab 10\uc2dc\uac04 \ub3d9\uc548 \uc0dd\uc874\ud558\ub824\uba74 \ub2e4\uc74c \uc8fc\uc694 \uc601\uc5ed\uc5d0 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. STEP1: \ud56d\uc0c1 \uc778\ubca4\ud1a0\ub9ac\uc5d0 \uccb4\ub825 \ud3ec\uc158\uacfc \uae30\ubcf8 \ub3c4\uad6c\ub97c \ubcf4\uad00\ud558\uc138\uc694. STEP2: \ud29c\ud1a0\ub9ac\uc5bc \ud018\uc2a4\ud2b8\ub97c \uc644\ub8cc\ud558\uc5ec \uacbd\ud5d8\uce58\uc640 \ud544\uc218 \uc544\uc774\ud15c\uc744 \uc5bb\uc73c\uc138\uc694. STEP3: \uc801\uc808\ud788 \uc7a5\ube44\uac00 \uac16\ucdb0\uc9c8 \ub54c\uae4c\uc9c0 \uace0\ub808\ubca8 \ubaac\uc2a4\ud130\uc640\uc758 \uc804\ud22c\ub97c \ud53c\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc2dc\uc791 \uc9c0\uc5ed\uc5d0\uc11c\ub294 \ub098\ubb34\uc640 \ub3cc\uacfc \uac19\uc740 \uc790\uc6d0\uc744 \ubaa8\uc544 \uae30\ubcf8 \ubb34\uae30\ub97c \uc81c\uc791\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \uc774 \uc804\ub7b5\uc740 \uc5ec\uc815\uc744 \uc704\ud55c \ud0c4\ud0c4\ud55c \uae30\ubc18\uc744 \ub9c8\ub828\ud569\ub2c8\ub2e4."}, {"question": "Who Are Ya \uac8c\uc784\uc5d0\uc11c \ub300\ud654 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Who Are Ya \uac8c\uc784\uc5d0\uc11c \ub300\ud654 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \uce90\ub9ad\ud130 \uac04 \uad00\uacc4\uc640 \ud018\uc2a4\ud2b8 \uacb0\uacfc\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. STEP1: \ub300\ud654 \uc120\ud0dd\uc5d0 \uc8fc\uc758\ud558\uc138\uc694. \ub300\ud654 \uc120\ud0dd\uc740 \uc0c8\ub85c\uc6b4 \ud018\uc2a4\ud2b8 \ub77c\uc778\uc744 \uc5f4\uac70\ub098 \ub2e4\ub978 \ud018\uc2a4\ud2b8 \ub77c\uc778\uc744 \ub2eb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP2: \uac00\ub2a5\ud55c \uacbd\uc6b0 '\uc124\ub4dd' \uc635\uc158\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub354 \ub098\uc740 \ubcf4\uc0c1\uc744 \ubc1b\uc73c\uc138\uc694. STEP3: NPC\uc758 \uc120\ud638\ub3c4\ub97c \ud30c\uc545\ud558\uc5ec \ub3d9\ub9f9\uc744 \uad6c\ucd95\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub9c8\uc744 \ub178\uc778\uc744 \ubd84\uc7c1\uc5d0\uc11c \uc9c0\uc9c0\ud558\ub294 \uc120\ud0dd\uc740 \ub3c5\uc810 \uc544\uc774\ud15c\uc5d0 \ub300\ud55c \uc811\uadfc \uad8c\ud55c\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc5d0 \uae4a\uc774\ub97c \ub354\ud569\ub2c8\ub2e4."}, {"question": "Who Are Ya \uac8c\uc784\uc5d0\uc11c \uacbd\ud5d8 \ub9ce\uc740 \ud50c\ub808\uc774\uc5b4\ub294 \uc790\uc6d0 \uad00\ub9ac\ub97c \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Who Are Ya \uac8c\uc784\uc5d0\uc11c \uacbd\ud5d8 \ub9ce\uc740 \ud50c\ub808\uc774\uc5b4\ub294 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub984\uc73c\ub85c\uc368 \uc790\uc6d0 \uad00\ub9ac\ub97c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \ud2b9\uc815 \uac8c\uc784 \uc774\ubca4\ud2b8 \uae30\uac04 \ub3d9\uc548 \ud76c\uadc0\ud55c \uc7ac\ub8cc\ub97c \uc218\uc9d1\ud558\ub294 \ub370 \uc6b0\uc120 \uc21c\uc704\ub97c \ub450\uc138\uc694. STEP2: \uc218\uc694\uac00 \ub192\uc740 \uc544\uc774\ud15c\uc5d0 \uc9d1\uc911\ud558\uc5ec \uc81c\uc791\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\uc138\uc694. STEP3: \ud544\uc694\ud55c \uc544\uc774\ud15c\uc744 \uc5bb\uae30 \uc704\ud574 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uc640 \uc789\uc5ec \uc790\uc6d0\uc744 \uad50\ud658\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uc218\ud655 \ucd95\uc81c' \uae30\uac04\uc5d0\ub294 \uc774 \uae30\uac04\uc5d0\ub9cc \uc5bb\uc744 \uc218 \uc788\ub294 \ud76c\uadc0\ud55c \ud5c8\ube0c\ub97c \uc218\uc9d1\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \uc774\ub7ec\ud55c \uc811\uadfc \ubc29\uc2dd\uc740 \ud6a8\uc728\uc131\uacfc \uc218\uc775\uc131\uc744 \uadf9\ub300\ud654\ud569\ub2c8\ub2e4."}, {"question": "Who Are Ya \uac8c\uc784\uc5d0\uc11c \uc0ac\uc6a9\ud574\uc57c \ud558\ub294 \uace0\uae09 \uc804\ud22c \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Who Are Ya \uac8c\uc784\uc5d0\uc11c \uace0\uae09 \uc804\ud22c \uc804\ub7b5\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. STEP1: \uac00\ubcbc\uc6b4 \uacf5\uaca9\uacfc \ubb34\uac70\uc6b4 \uacf5\uaca9\uc744 \uc5f0\uacb0\ud558\uc5ec \uc5f0\uacc4 \uacf5\uaca9\uc744 \ud65c\uc6a9\ud558\uc138\uc694. STEP2: \uc801\uc744 \ud568\uc815\uc73c\ub85c \ubc00\uc5b4\ub123\ub294 \ub4f1 \ud658\uacbd \uc694\uc18c\ub97c \ud65c\uc6a9\ud558\uc138\uc694. STEP3: \uacf5\uaca9\uc801\uc778 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud574 \ub192\uc740 \ud53c\ud574\ub7c9 \ubb34\uae30\ub97c \ud3ec\ud568\ud558\uc5ec \uc790\uc2e0\uc758 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\ub294 \uc7a5\ube44\ub97c \ucc29\uc6a9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ubcf4\uc2a4 \uc804\ud22c\uc5d0\uc11c \uc544\ub808\ub098\uc758 \uae30\ub465\uc744 \ud65c\uc6a9\ud558\uc5ec \uacf5\uaca9\uc744 \ucc28\ub2e8\ud558\uace0 \ub300\uc751 \ubc29\uc548\uc744 \uacc4\ud68d\ud558\uc138\uc694. \uc774\ub7ec\ud55c \uc804\ub7b5\uc740 \uc804\ud22c \ud6a8\uc728\uc131\uc744 \ub192\uc785\ub2c8\ub2e4."}, {"question": "Who Are Ya \uac8c\uc784\uc5d0\uc11c \uc2a4\ud0ac \ud2b8\ub9ac\ub97c \ub9c8\uc2a4\ud130\ud558\ub294 \uac83\uc774 \ud6c4\ubc18 \uac8c\uc784 \uc131\uacf5\uc5d0 \ud544\uc218\uc801\uc778 \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Who Are Ya \uac8c\uc784\uc5d0\uc11c \uc2a4\ud0ac \ud2b8\ub9ac\ub97c \ub9c8\uc2a4\ud130\ud558\ub294 \uac83\uc740 \ud6c4\ubc18 \uac8c\uc784 \uc131\uacf5\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc2a4\ud0ac \ud2b8\ub9ac\ub97c \ub9c8\uc2a4\ud130\ud558\uba74 \ud2b9\ud654\ub41c \ube4c\ub4dc\ub97c \ud560 \uc218 \uc788\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. STEP1: \uc120\ud638\ud558\ub294 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \uc2dc\ub108\uc9c0 \ud6a8\uacfc\uac00 \uc788\ub294 \uc2a4\ud0ac\uc5d0 \uc9d1\uc911\ud558\uc138\uc694. STEP2: \uc7a5\uae30\uc801\uc778 \uc774\uc810\uc744 \uc81c\uacf5\ud558\ub294 \uc218\ub3d9 \uc2a4\ud0ac\uc5d0 \uc810\uc218\ub97c \ud560\ub2f9\ud558\uc138\uc694. STEP3: \ud544\uc694\uc5d0 \ub530\ub77c \uc7ac\ubd84\ubc30\ud558\uc5ec \uc0c8\ub85c\uc6b4 \ub3c4\uc804\uc5d0 \uc801\uc751\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \"\uc740\uc2e0\" \ud2b8\ub9ac\uc5d0 \ud22c\uc790\ud558\uba74 \ud2b9\uc815 \uc784\ubb34\uc5d0 \ud544\uc218\uc801\uc778 \uc801\uc5d0\uac8c \uac70\uc758 \ubcf4\uc774\uc9c0 \uc54a\uac8c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ub9c8\uc2a4\ud130\ub9ac\ub85c \ud6c4\ubc18 \uac8c\uc784\uc5d0\uc11c \uc801\uc751\ub825\uacfc \uac15\ub825\ud568\uc744 \ud655\ubcf4\ud569\ub2c8\ub2e4."}, {"question": "Who Are Ya \uac8c\uc784\uc758 \uc81c\uc791 \uc2dc\uc2a4\ud15c\uc758 \ud575\uc2ec \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Who Are Ya \uac8c\uc784\uc758 \uc81c\uc791 \uc2dc\uc2a4\ud15c\uc740 \ub2e4\uc74c \ud575\uc2ec \uba54\ucee4\ub2c8\uc998\uc744 \uc911\uc2ec\uc73c\ub85c \uc774\ub8e8\uc5b4\uc9d1\ub2c8\ub2e4. STEP1: \ud0d0\ud5d8\uacfc \uc804\ud22c\ub97c \ud1b5\ud574 \uc790\uc6d0\uc744 \uc218\uc9d1\ud558\uc138\uc694. STEP2: \uc81c\uc791 \uc2a4\ud14c\uc774\uc158\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc7ac\ub8cc\ub97c \uc720\uc6a9\ud55c \uc544\uc774\ud15c\uc73c\ub85c \ud569\uc131\ud558\uc138\uc694. STEP3: \ub2e4\uc591\ud55c \ub808\uc2dc\ud53c\ub97c \uc2dc\ub3c4\ud558\uc5ec \ud76c\uadc0\ud55c \uc124\uacc4\ub3c4\ub97c \ubc1c\uacac\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc81c\ub828\uc18c\uc5d0\uc11c \ucca0\uad11\uc11d\uacfc \uc11d\ud0c4\uc744 \ud569\uc131\ud558\uba74 \uac15\ub825\ud55c \uac80\uc744 \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \ucc3d\uc758\uc131\uacfc \uc720\uc6a9\uc131\uc744 \uc7a5\ub824\ud569\ub2c8\ub2e4."}, {"question": "Who Are Ya \uac8c\uc784\uc5d0\uc11c \ub3d9\uc801\uc778 \ub0a0\uc528 \uc2dc\uc2a4\ud15c\uc740 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "Who Are Ya \uac8c\uc784\uc758 \ub3d9\uc801\uc778 \ub0a0\uc528 \uc2dc\uc2a4\ud15c\uc740 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5ec\ub7ec \uac00\uc9c0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. STEP1: \ube44\ub294 \ud45c\uba74\uc744 \ubbf8\ub044\ub7fd\uac8c \ub9cc\ub4e4\uc5b4 \uc774\ub3d9\uacfc \uc804\ud22c\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. STEP2: \ub208\ubcf4\ub77c\ub85c \uc2dc\uc57c\uac00 \uc904\uc5b4\ub4e4\uc5b4 \ud0d0\uc0c9\uc774 \uc5b4\ub824\uc6cc\uc9d1\ub2c8\ub2e4. STEP3: \ub9d1\uc740 \ub0a0\uc528\ub294 \ub18d\uc5c5 \ud6a8\uc728\uacfc \uac19\uc740 \ud2b9\uc815 \uc2a4\ud0ac\uc744 \ub192\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud3ed\ud48d\uc6b0\uac00 \ubab0\uc544\uce60 \ub54c \ud574\ubcc0\uc5d0 \ud76c\uadc0\ud55c \uc7ac\ub8cc\uac00 \uc53b\uaca8 \ub098\uc624\ub294 \uac83\uc744 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \uac8c\uc784 \uc138\uacc4\uc5d0 \ud604\uc2e4\uac10\uacfc \ub2e4\uc591\uc131\uc744 \ub354\ud569\ub2c8\ub2e4."}, {"question": "Who Are Ya \uac8c\uc784\uc5d0\uc11c \ud50c\ub7ab\ud3fc \uac04 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud560 \ub54c \ubb34\uc5c7\uc744 \uace0\ub824\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "Who Are Ya \uac8c\uc784\uc5d0\uc11c \ud50c\ub7ab\ud3fc \uac04 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud560 \ub54c \ub2e4\uc74c \uc694\uc18c\ub97c \uace0\ub824\ud574\uc57c \ud569\ub2c8\ub2e4. STEP1: \uac8c\uc784 \uacc4\uc815\uc744 \ubcf4\ud3b8\uc801\uc778 \ud504\ub85c\ud544\uacfc \uc5f0\uacb0\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. STEP2: \ud50c\ub7ab\ud3fc\ubcc4 \uc81c\ud55c \uc0ac\ud56d\uc774\ub098 \ucc28\uc774\uc810\uc744 \ud655\uc778\ud558\uc138\uc694. STEP3: \ubaa8\ub4e0 DLC\uc640 \uc5c5\ub370\uc774\ud2b8\uac00 \ud638\ud658\ub418\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ucf58\uc194\ub85c \uc804\uc1a1\ud560 \uacbd\uc6b0 \ucd5c\uc801\uc758 \ud50c\ub808\uc774\ub97c \uc704\ud574 \ucee8\ud2b8\ub864 \uc124\uc815\uc744 \uc870\uc815\ud574\uc57c \ud560 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uace0\ub824 \uc0ac\ud56d\uc740 \uc5ec\ub7ec \uae30\uae30\uc5d0 \uc6d0\ud65c\ud55c \uc804\ud658\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "Who Are Ya \uac8c\uc784\uc5d0\uc11c \uc228\uaca8\uc9c4 \uc774\uc57c\uae30 \uc544\uc774\ud15c\ub4e4\uc740 \uc5b4\ub514\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Who Are Ya \uac8c\uc784\uc5d0\uc11c \uc228\uaca8\uc9c4 \uc774\uc57c\uae30 \uc544\uc774\ud15c\uc740 \ub2e4\uc74c \uc704\uce58\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \ub3d9\uad74\uc774\ub098 \uc720\uc801\uacfc \uac19\uc740 \ubc97\uc5b4\ub09c \uc9c0\uc5ed\uc744 \ud0d0\ud5d8\ud558\uc138\uc694. STEP2: \ubbf8\ubb18\ud55c \ub2e8\uc11c\ub97c \uac00\uc9c4 \ud3c9\ubc94\ud55c \ubb3c\uccb4\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\uc138\uc694. STEP3: \ube44\ubc00 \uc9c0\uc5ed\uc5d0 \ub300\ud55c \uc811\uadfc \uad8c\ud55c\uc744 \uc5f4\uc5b4\uc8fc\ub294 \ud2b9\uc815 \ud018\uc2a4\ud2b8\ub97c \uc644\ub8cc\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub3c4\uc11c\uad00\uc5d0 \uc788\ub294 \ud3c9\ubc94\ud574 \ubcf4\uc774\ub294 \ucc45\uc5d0 \uc228\uaca8\uc9c4 \ubcf4\ubb3c\ub85c \uc774\uc5b4\uc9c0\ub294 \uc9c0\ub3c4\uac00 \ub4e4\uc5b4 \uc788\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc544\uc774\ud15c\uc740 \uac8c\uc784\uc758 \uc774\uc57c\uae30\ub97c \ud48d\ubd80\ud558\uac8c \ud558\uace0 \ud0d0\ud5d8\uc744 \ubcf4\uc0c1\ud569\ub2c8\ub2e4."}]
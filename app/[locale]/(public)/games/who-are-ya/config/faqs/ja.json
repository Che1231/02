[{"question": "Who Are Ya\u306e\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u57fa\u672c\u64cd\u4f5c\u3092\u3069\u306e\u3088\u3046\u306b\u958b\u59cb\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Who Are Ya\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5de6\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u307e\u305f\u306f\u65b9\u5411\u30ad\u30fc\u3092\u4f7f\u7528\u3057\u3066\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u79fb\u52d5\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u307e\u305f\u306fNPC\u3068\u5bfe\u8a71\u3059\u308b\u306b\u306f\u3001\u300cA\u300d\u30dc\u30bf\u30f3\u307e\u305f\u306f\u30b9\u30da\u30fc\u30b9\u30d0\u30fc\u3092\u62bc\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u306b\u30a2\u30af\u30bb\u30b9\u3059\u308b\u306b\u306f\u3001\u300cB\u300d\u30dc\u30bf\u30f3\u307e\u305f\u306f\u300cE\u300d\u30ad\u30fc\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u65bd\u9320\u3055\u308c\u305f\u30c9\u30a2\u306b\u51fa\u304f\u308f\u3057\u305f\u5834\u5408\u306f\u3001\u5fc5\u8981\u306a\u9375\u3092\u6301\u3063\u3066\u3044\u308b\u304b\u3069\u3046\u304b\u3092\u78ba\u8a8d\u3059\u308b\u305f\u3081\u306b\u3001\u30c9\u30a2\u3068\u5bfe\u8a71\u3057\u307e\u3059\u3002\u3053\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u4f53\u7cfb\u306f\u3001\u30b2\u30fc\u30e0\u3078\u306e\u30b9\u30e0\u30fc\u30ba\u306a\u5c0e\u5165\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002"}, {"question": "Who Are Ya\u3067\u6700\u521d\u306e10\u6642\u9593\u3067\u751f\u304d\u6b8b\u308b\u305f\u3081\u306e\u91cd\u8981\u306a\u30d2\u30f3\u30c8\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Who Are Ya\u3067\u6700\u521d\u306e10\u6642\u9593\u3092\u751f\u304d\u6b8b\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u91cd\u8981\u306a\u70b9\u306b\u96c6\u4e2d\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u5e38\u306b\u3042\u306a\u305f\u306e\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u3092\u3001\u56de\u5fa9\u85ac\u3068\u57fa\u672c\u7684\u306a\u30c4\u30fc\u30eb\u3067\u6e80\u30bf\u30f3\u306b\u4fdd\u3061\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30af\u30a8\u30b9\u30c8\u3092\u5b8c\u4e86\u3057\u3066\u3001\u7d4c\u9a13\u5024\u3068\u91cd\u8981\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u5165\u624b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5341\u5206\u306b\u88c5\u5099\u3059\u308b\u307e\u3067\u3001\u9ad8\u30ec\u30d9\u30eb\u306e\u6575\u3068\u306e\u6226\u95d8\u3092\u907f\u3051\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u3001\u958b\u59cb\u30a8\u30ea\u30a2\u3067\u306f\u3001\u6728\u3084\u77f3\u306a\u3069\u306e\u8cc7\u6e90\u3092\u96c6\u3081\u3066\u3001\u57fa\u672c\u7684\u306a\u6b66\u5668\u3092\u88fd\u4f5c\u3059\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u307e\u3059\u3002\u3053\u306e\u6226\u7565\u306b\u3088\u308a\u3001\u3042\u306a\u305f\u306e\u5192\u967a\u306e\u5805\u5b9f\u306a\u57fa\u790e\u304c\u7bc9\u304b\u308c\u307e\u3059\u3002"}, {"question": "Who Are Ya\u3067\u5bfe\u8a71\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u306a\u305c\u91cd\u8981\u3067\u3059\u304b\uff1f", "answer": "Who Are Ya\u3067\u5bfe\u8a71\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u95a2\u4fc2\u3068\u30af\u30a8\u30b9\u30c8\u306e\u7d50\u679c\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u305f\u3081\u3001\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5bfe\u8a71\u9078\u629e\u306b\u6ce8\u610f\u3092\u6255\u3046\u3068\u3001\u65b0\u3057\u3044\u30af\u30a8\u30b9\u30c8\u30e9\u30a4\u30f3\u3092\u958b\u3044\u305f\u308a\u3001\u4ed6\u306e\u30af\u30a8\u30b9\u30c8\u30e9\u30a4\u30f3\u3092\u9589\u3058\u305f\u308a\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5229\u7528\u53ef\u80fd\u306a\u5834\u5408\u3001\u300c\u8aac\u5f97\u300d\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u3088\u308a\u826f\u3044\u5831\u916c\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1aNPC\u306e\u597d\u307f\u3092\u8ffd\u8de1\u3057\u3066\u3001\u540c\u76df\u3092\u7bc9\u304d\u307e\u3057\u3087\u3046\u3002\u305f\u3068\u3048\u3070\u3001\u6751\u306e\u5e74\u914d\u8005\u3078\u306e\u7d1b\u4e89\u306b\u304a\u3051\u308b\u652f\u63f4\u3092\u9078\u3079\u3070\u3001\u9650\u5b9a\u30a2\u30a4\u30c6\u30e0\u3078\u306e\u30a2\u30af\u30bb\u30b9\u304c\u5f97\u3089\u308c\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u5965\u884c\u304d\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002"}, {"question": "\u30d9\u30c6\u30e9\u30f3\u30d7\u30ec\u30a4\u30e4\u30fc\u306fWho Are Ya\u3067\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u3092\u3069\u306e\u3088\u3046\u306b\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d9\u30c6\u30e9\u30f3\u30d7\u30ec\u30a4\u30e4\u30fc\u306fWho Are Ya\u3067\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u3092\u6700\u9069\u5316\u3059\u308b\u305f\u3081\u306b\u3001\u4ee5\u4e0b\u306e\u30b9\u30c6\u30c3\u30d7\u306b\u5f93\u3046\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u7279\u5b9a\u306e\u30b2\u30fc\u30e0\u30a4\u30d9\u30f3\u30c8\u4e2d\u306b\u5e0c\u5c11\u306a\u7d20\u6750\u306e\u53ce\u96c6\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u9700\u8981\u306e\u9ad8\u3044\u30a2\u30a4\u30c6\u30e0\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u3001\u30af\u30e9\u30d5\u30c8\u3092\u52b9\u7387\u7684\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5fc5\u8981\u306a\u30a2\u30a4\u30c6\u30e0\u3068\u5f15\u304d\u63db\u3048\u306b\u3001\u4f59\u5270\u8cc7\u6e90\u3092\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u4ea4\u63db\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u53ce\u7a6b\u796d\u300d\u306e\u9593\u306f\u3001\u3053\u306e\u30a4\u30d9\u30f3\u30c8\u306e\u307f\u306b\u5165\u624b\u53ef\u80fd\u306a\u5e0c\u5c11\u306a\u30cf\u30fc\u30d6\u3092\u96c6\u3081\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u307e\u3059\u3002\u3053\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u3001\u52b9\u7387\u6027\u3068\u53ce\u76ca\u3092\u6700\u5927\u5316\u3057\u307e\u3059\u3002"}, {"question": "Who Are Ya\u3067\u3069\u306e\u3088\u3046\u306a\u9ad8\u5ea6\u306a\u6226\u95d8\u6226\u7565\u3092\u4f7f\u7528\u3059\u308b\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "Who Are Ya\u306b\u304a\u3051\u308b\u9ad8\u5ea6\u306a\u6226\u95d8\u6226\u7565\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u3082\u306e\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u8efd\u3044\u653b\u6483\u3068\u91cd\u3044\u653b\u6483\u3092\u7e4b\u3052\u308b\u3053\u3068\u3067\u3001\u30b3\u30f3\u30dc\u653b\u6483\u3092\u6d3b\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6575\u3092\u7f60\u306b\u8a98\u5c0e\u3059\u308b\u306a\u3069\u3001\u74b0\u5883\u8981\u7d20\u3092\u6709\u5229\u306b\u6d3b\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u653b\u6483\u7684\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u5411\u3051\u306e\u5f37\u529b\u306a\u6b66\u5668\u306a\u3069\u3001\u3042\u306a\u305f\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u5408\u308f\u305b\u305f\u88c5\u5099\u3092\u88c5\u5099\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30dc\u30b9\u6226\u3067\u306f\u3001\u30a2\u30ea\u30fc\u30ca\u306e\u67f1\u3092\u4f7f\u3063\u3066\u653b\u6483\u3092\u304b\u308f\u3057\u3001\u53cd\u6483\u3092\u8a08\u753b\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u6226\u7565\u306f\u6226\u95d8\u306e\u6709\u52b9\u6027\u3092\u9ad8\u3081\u307e\u3059\u3002"}, {"question": "Who Are Ya\u306e\u7d42\u76e4\u3067\u30b9\u30ad\u30eb\u30c4\u30ea\u30fc\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u306f\u306a\u305c\u91cd\u8981\u3067\u3059\u304b\uff1f", "answer": "Who Are Ya\u306e\u7d42\u76e4\u3067\u30b9\u30ad\u30eb\u30c4\u30ea\u30fc\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u306f\u3001\u9ad8\u5ea6\u306a\u30d3\u30eb\u30c9\u3092\u53ef\u80fd\u306b\u3059\u308b\u305f\u3081\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u597d\u307f\u306b\u5408\u3046\u30b9\u30ad\u30eb\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u9577\u671f\u7684\u306a\u6069\u6075\u3092\u3082\u305f\u3089\u3059\u30d1\u30c3\u30b7\u30d6\u30a2\u30d3\u30ea\u30c6\u30a3\u306b\u30dd\u30a4\u30f3\u30c8\u3092\u5272\u308a\u5f53\u3066\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5fc5\u8981\u3067\u3042\u308c\u3070\u3001\u65b0\u3057\u3044\u6311\u6226\u306b\u9069\u5fdc\u3059\u308b\u305f\u3081\u306b\u518d\u5c02\u9580\u5316\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30b9\u30c6\u30eb\u30b9\u300d\u30c4\u30ea\u30fc\u306b\u6295\u8cc7\u3059\u308b\u3068\u3001\u7279\u5b9a\u306e\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u975e\u5e38\u306b\u91cd\u8981\u3068\u306a\u308b\u3001\u6575\u306b\u307b\u3068\u3093\u3069\u6c17\u3065\u304b\u308c\u306a\u3044\u72b6\u614b\u306b\u306a\u308a\u307e\u3059\u3002\u3053\u306e\u7fd2\u5f97\u306f\u3001\u7d42\u76e4\u3067\u306e\u9069\u5fdc\u529b\u3068\u5f37\u3055\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002"}, {"question": "Who Are Ya\u306e\u30af\u30e9\u30d5\u30c8\u30b7\u30b9\u30c6\u30e0\u306e\u80cc\u5f8c\u306b\u3042\u308b\u4e3b\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Who Are Ya\u306e\u30af\u30e9\u30d5\u30c8\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u4ee5\u4e0b\u306e\u4e3b\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u4e2d\u5fc3\u306b\u5c55\u958b\u3057\u3066\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u63a2\u691c\u3068\u6226\u95d8\u3092\u901a\u3058\u3066\u8cc7\u6e90\u3092\u96c6\u3081\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30af\u30e9\u30d5\u30c8\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u3092\u4f7f\u7528\u3057\u3066\u3001\u6750\u6599\u3092\u6709\u7528\u306a\u30a2\u30a4\u30c6\u30e0\u306b\u7d44\u307f\u5408\u308f\u305b\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u3055\u307e\u3056\u307e\u306a\u30ec\u30b7\u30d4\u3092\u8a66\u3057\u3066\u3001\u5e0c\u5c11\u306a\u8a2d\u8a08\u56f3\u3092\u767a\u898b\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u935b\u51b6\u5834\u3067\u9244\u9271\u77f3\u3068\u77f3\u70ad\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3068\u3001\u5f37\u529b\u306a\u5263\u3092\u4f5c\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u5275\u9020\u6027\u3068\u5668\u7528\u3055\u3092\u4fc3\u9032\u3057\u307e\u3059\u3002"}, {"question": "Who Are Ya\u306e\u52d5\u7684\u6c17\u8c61\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u304b\uff1f", "answer": "Who Are Ya\u306e\u52d5\u7684\u6c17\u8c61\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3044\u304f\u3064\u304b\u306e\u65b9\u6cd5\u3067\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u96e8\u306b\u3088\u3063\u3066\u5730\u9762\u304c\u6ed1\u308a\u3084\u3059\u304f\u306a\u308a\u3001\u79fb\u52d5\u3068\u6226\u95d8\u306b\u5f71\u97ff\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5d50\u306b\u3088\u3063\u3066\u8996\u754c\u304c\u60aa\u304f\u306a\u308a\u3001\u30ca\u30d3\u30b2\u30fc\u30b7\u30e7\u30f3\u304c\u56f0\u96e3\u306b\u306a\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6674\u5929\u306f\u3001\u8fb2\u696d\u52b9\u7387\u306a\u3069\u306e\u7279\u5b9a\u306e\u30b9\u30ad\u30eb\u306e\u5411\u4e0a\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u843d\u96f7\u4e2d\u306b\u3001\u73cd\u3057\u3044\u7d20\u6750\u304c\u6d77\u5cb8\u306b\u6d41\u308c\u7740\u304f\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u306e\u4e16\u754c\u306b\u30ea\u30a2\u30ea\u30c6\u30a3\u3068\u591a\u69d8\u6027\u3092\u3082\u305f\u3089\u3057\u307e\u3059\u3002"}, {"question": "Who Are Ya\u3067\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u5834\u5408\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u4f55\u3092\u8003\u616e\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "Who Are Ya\u3067\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u5834\u5408\u3001\u3053\u308c\u3089\u306e\u8981\u56e0\u3092\u8003\u616e\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b2\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\u304c\u30e6\u30cb\u30d0\u30fc\u30b5\u30eb\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u306b\u30ea\u30f3\u30af\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u56fa\u6709\u306e\u5236\u9650\u3084\u9055\u3044\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u3059\u3079\u3066\u306eDLC\u3068\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u304c\u4e92\u63db\u6027\u304c\u3042\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001PC\u304b\u3089\u30b3\u30f3\u30bd\u30fc\u30eb\u306b\u8ee2\u9001\u3059\u308b\u5834\u5408\u3001\u6700\u9069\u306a\u30d7\u30ec\u30a4\u306e\u305f\u3081\u306b\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u306e\u8a2d\u5b9a\u3092\u8abf\u6574\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u306e\u8003\u616e\u4e8b\u9805\u306f\u3001\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u306e\u30b9\u30e0\u30fc\u30ba\u306a\u79fb\u884c\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002"}, {"question": "Who Are Ya\u3067\u96a0\u3055\u308c\u305f\u30ed\u30a2\u30a2\u30a4\u30c6\u30e0\u306f\u3069\u3053\u3067\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Who Are Ya\u306e\u96a0\u3055\u308c\u305f\u30ed\u30a2\u30a2\u30a4\u30c6\u30e0\u306f\u3001\u4ee5\u4e0b\u306e\u5834\u6240\u306b\u5b58\u5728\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6d1e\u7a9f\u3084\u907a\u8de1\u306a\u3069\u3001\u666e\u6bb5\u306f\u884c\u304b\u306a\u3044\u5834\u6240\u3092\u63a2\u691c\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5fae\u5999\u306a\u624b\u304c\u304b\u308a\u304c\u3042\u308b\u3001\u4e00\u898b\u5e73\u51e1\u306a\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3068\u5bfe\u8a71\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5177\u4f53\u7684\u306a\u30af\u30a8\u30b9\u30c8\u3092\u5b8c\u4e86\u3057\u3066\u3001\u79d8\u5bc6\u306e\u30a8\u30ea\u30a2\u3078\u306e\u30a2\u30af\u30bb\u30b9\u3092\u958b\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u56f3\u66f8\u9928\u306b\u3042\u308b\u4e00\u898b\u666e\u901a\u306e\u672c\u306b\u3001\u96a0\u3055\u308c\u305f\u5b9d\u306b\u3064\u306a\u304c\u308b\u5730\u56f3\u304c\u66f8\u304b\u308c\u3066\u3044\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30a2\u30a4\u30c6\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u306e\u7269\u8a9e\u3092\u8c4a\u304b\u306b\u3057\u3001\u63a2\u691c\u3078\u306e\u5831\u916c\u3068\u306a\u308a\u307e\u3059\u3002"}]
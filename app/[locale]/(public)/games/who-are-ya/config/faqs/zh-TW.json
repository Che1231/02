[{"question": "\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u5728\u300aWho Are Ya\u300b\u4e2d\u4e0a\u624b\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u5728\u300aWho Are Ya\u300b\u4e0a\u624b\u57fa\u672c\u63a7\u5236\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u4f7f\u7528\u5de6\u6416\u687f\u6216\u65b9\u5411\u9375\u79fb\u52d5\u89d2\u8272\u3002\u6b65\u9a5f2\uff1a\u6309\u4e0b\u300cA\u300d\u9375\u6216\u7a7a\u683c\u9375\u8207\u7269\u4ef6\u6216NPC\u4e92\u52d5\u3002\u6b65\u9a5f3\uff1a\u4f7f\u7528\u300cB\u300d\u9375\u6216\u300cE\u300d\u9375\u5b58\u53d6\u4f60\u7684\u80cc\u5305\u3002\u4f8b\u5982\uff0c\u7576\u4f60\u9047\u5230\u9396\u4f4f\u7684\u9580\u6642\uff0c\u8207\u4e4b\u4e92\u52d5\u67e5\u770b\u662f\u5426\u64c1\u6709\u6240\u9700\u9470\u5319\u3002\u9019\u500b\u57fa\u672c\u63a7\u5236\u65b9\u6848\u80fd\u78ba\u4fdd\u9806\u5229\u878d\u5165\u904a\u6232\u3002"}, {"question": "\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u5728\u300aWho Are Ya\u300b\u7684\u524d10\u5c0f\u6642\u751f\u5b58\u4e0b\u4f86\uff1f", "answer": "\u5728\u300aWho Are Ya\u300b\u7684\u524d10\u5c0f\u6642\u751f\u5b58\u4e0b\u4f86\uff0c\u9700\u8981\u5c08\u6ce8\u65bc\u4ee5\u4e0b\u95dc\u9375\u9818\u57df\uff1a\u6b65\u9a5f1\uff1a\u59cb\u7d42\u4fdd\u6301\u4f60\u7684\u80cc\u5305\u4e2d\u6709\u8db3\u5920\u7684\u6062\u5fa9\u85e5\u6c34\u548c\u57fa\u672c\u5de5\u5177\u3002\u6b65\u9a5f2\uff1a\u5b8c\u6210\u6559\u5b78\u4efb\u52d9\u4ee5\u7372\u5f97\u7d93\u9a57\u503c\u548c\u91cd\u8981\u7269\u54c1\u3002\u6b65\u9a5f3\uff1a\u5728\u88dd\u5099\u5145\u8db3\u4e4b\u524d\uff0c\u907f\u514d\u8207\u9ad8\u968e\u6575\u4eba\u6230\u9b25\u3002\u4f8b\u5982\uff0c\u5728\u8d77\u59cb\u5340\u57df\uff0c\u5c08\u6ce8\u65bc\u6536\u96c6\u6728\u6750\u548c\u77f3\u982d\u4ee5\u88fd\u4f5c\u57fa\u672c\u6b66\u5668\u3002\u6b64\u7b56\u7565\u78ba\u4fdd\u4e86\u65c5\u7a0b\u7684\u5805\u5be6\u57fa\u790e\u3002"}, {"question": "\u5728\u300aWho Are Ya\u300b\u4e2d\uff0c\u70ba\u4f55\u7406\u89e3\u5c0d\u8a71\u7cfb\u7d71\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u5728\u300aWho Are Ya\u300b\u4e2d\uff0c\u7406\u89e3\u5c0d\u8a71\u7cfb\u7d71\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6703\u5f71\u97ff\u89d2\u8272\u95dc\u4fc2\u548c\u4efb\u52d9\u7d50\u679c\u3002\u6b65\u9a5f1\uff1a\u6ce8\u610f\u5c0d\u8a71\u7684\u9078\u64c7\uff0c\u56e0\u70ba\u5b83\u5011\u53ef\u80fd\u6703\u958b\u555f\u65b0\u7684\u4efb\u52d9\u7dda\u6216\u95dc\u9589\u5176\u4ed6\u4efb\u52d9\u7dda\u3002\u6b65\u9a5f2\uff1a\u5728\u53ef\u7528\u7684\u60c5\u6cc1\u4e0b\uff0c\u4f7f\u7528\u300c\u8aaa\u670d\u300d\u9078\u9805\u4ee5\u7372\u5f97\u66f4\u597d\u7684\u734e\u52f5\u3002\u6b65\u9a5f3\uff1a\u8ffd\u8e64NPC\u7684\u559c\u597d\u4ee5\u5efa\u7acb\u806f\u76df\u3002\u4f8b\u5982\uff0c\u5728\u722d\u7aef\u4e2d\u9078\u64c7\u652f\u6301\u6751\u9577\uff0c\u53ef\u80fd\u6703\u8b93\u4f60\u7372\u5f97\u7368\u5bb6\u7269\u54c1\u3002\u9019\u500b\u7cfb\u7d71\u70ba\u904a\u6232\u9ad4\u9a57\u589e\u6dfb\u4e86\u6df1\u5ea6\u3002"}, {"question": "\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u5982\u4f55\u5728\u300aWho Are Ya\u300b\u4e2d\u512a\u5316\u8cc7\u6e90\u7ba1\u7406\uff1f", "answer": "\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u53ef\u4ee5\u5728\u300aWho Are Ya\u300b\u4e2d\u512a\u5316\u8cc7\u6e90\u7ba1\u7406\uff0c\u65b9\u6cd5\u5982\u4e0b\uff1a\u6b65\u9a5f1\uff1a\u5728\u7279\u5b9a\u904a\u6232\u6d3b\u52d5\u671f\u9593\u512a\u5148\u6536\u96c6\u7a00\u6709\u6750\u6599\u3002\u6b65\u9a5f2\uff1a\u6709\u6548\u5730\u4f7f\u7528\u88fd\u4f5c\u7cfb\u7d71\uff0c\u5c08\u6ce8\u65bc\u9ad8\u9700\u6c42\u7269\u54c1\u3002\u6b65\u9a5f3\uff1a\u8207\u5176\u4ed6\u73a9\u5bb6\u4ea4\u6613\u5269\u9918\u8cc7\u6e90\u4ee5\u7372\u5f97\u6240\u9700\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5728\u300c\u8c50\u6536\u7bc0\u300d\u671f\u9593\uff0c\u5c08\u6ce8\u65bc\u6536\u96c6\u53ea\u5728\u8a72\u6d3b\u52d5\u671f\u9593\u51fa\u73fe\u7684\u7a00\u6709\u85e5\u8349\u3002\u6b64\u65b9\u6cd5\u6700\u5927\u5316\u6548\u7387\u548c\u5229\u6f64\u3002"}, {"question": "\u300aWho Are Ya\u300b\u4e2d\uff0c\u73a9\u5bb6\u61c9\u8a72\u4f7f\u7528\u54ea\u4e9b\u5148\u9032\u7684\u6230\u9b25\u7b56\u7565\uff1f", "answer": "\u300aWho Are Ya\u300b\u4e2d\u7684\u5148\u9032\u6230\u9b25\u7b56\u7565\u5305\u62ec\uff1a\u6b65\u9a5f1\uff1a\u5229\u7528\u9023\u64ca\u653b\u64ca\uff0c\u9023\u7e8c\u8f15\u64ca\u548c\u91cd\u64ca\u3002\u6b65\u9a5f2\uff1a\u5229\u7528\u74b0\u5883\u5143\u7d20\uff0c\u4f8b\u5982\u5c07\u6575\u4eba\u63a8\u5165\u9677\u9631\u3002\u6b65\u9a5f3\uff1a\u914d\u5099\u8207\u4f60\u7684\u904a\u6232\u98a8\u683c\u76f8\u8f14\u76f8\u6210\u7684\u88dd\u5099\uff0c\u4f8b\u5982\uff0c\u5c0d\u4fb5\u7565\u6027\u73a9\u5bb6\u4f86\u8aaa\uff0c\u914d\u5099\u9ad8\u50b7\u5bb3\u6b66\u5668\u3002\u4f8b\u5982\uff0c\u5728\u8207\u9996\u9818\u6230\u9b25\u6642\uff0c\u5229\u7528\u7af6\u6280\u5834\u4e2d\u7684\u67f1\u5b50\u4f86\u963b\u64cb\u653b\u64ca\uff0c\u540c\u6642\u898f\u5283\u4f60\u7684\u53cd\u64ca\u3002\u9019\u4e9b\u7b56\u7565\u589e\u5f37\u6230\u9b25\u7684\u6709\u6548\u6027\u3002"}, {"question": "\u5728\u300aWho Are Ya\u300b\u7684\u5f8c\u671f\u904a\u6232\u4e2d\uff0c\u70ba\u4f55\u8981\u7cbe\u901a\u6280\u80fd\u6a39\uff1f", "answer": "\u5728\u300aWho Are Ya\u300b\u7684\u5f8c\u671f\u904a\u6232\u4e2d\uff0c\u7cbe\u901a\u6280\u80fd\u6a39\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u5141\u8a31\u73a9\u5bb6\u6253\u9020\u5c08\u7cbe\u7684\u904a\u6232\u98a8\u683c\u3002\u6b65\u9a5f1\uff1a\u5c08\u6ce8\u65bc\u8207\u4f60\u7684\u9996\u9078\u904a\u6232\u98a8\u683c\u76f8\u8f14\u76f8\u6210\u7684\u6280\u80fd\u3002\u6b65\u9a5f2\uff1a\u5206\u914d\u9ede\u6578\u5230\u63d0\u4f9b\u9577\u671f\u597d\u8655\u7684\u88ab\u52d5\u80fd\u529b\u3002\u6b65\u9a5f3\uff1a\u5982\u6709\u5fc5\u8981\uff0c\u91cd\u65b0\u5206\u914d\u6280\u80fd\u4ee5\u9069\u61c9\u65b0\u7684\u6311\u6230\u3002\u4f8b\u5982\uff0c\u6295\u8cc7\u65bc\u300c\u6f5b\u884c\u300d\u6280\u80fd\u6a39\u53ef\u4ee5\u8b93\u4f60\u5e7e\u4e4e\u5c0d\u6575\u4eba\u96b1\u5f62\uff0c\u9019\u5c0d\u65bc\u67d0\u4e9b\u4efb\u52d9\u81f3\u95dc\u91cd\u8981\u3002\u9019\u7a2e\u7cbe\u901a\u80fd\u78ba\u4fdd\u5f8c\u671f\u904a\u6232\u7684\u9069\u61c9\u6027\u548c\u529b\u91cf\u3002"}, {"question": "\u300aWho Are Ya\u300b\u7684\u88fd\u4f5c\u7cfb\u7d71\u80cc\u5f8c\u7684\u95dc\u9375\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "\u300aWho Are Ya\u300b\u7684\u88fd\u4f5c\u7cfb\u7d71\u570d\u7e5e\u8457\u9019\u4e9b\u95dc\u9375\u6a5f\u5236\uff1a\u6b65\u9a5f1\uff1a\u901a\u904e\u63a2\u7d22\u548c\u6230\u9b25\u6536\u96c6\u8cc7\u6e90\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u88fd\u4f5c\u5de5\u4f5c\u53f0\u5c07\u6750\u6599\u7d44\u5408\u6210\u6709\u7528\u7684\u7269\u54c1\u3002\u6b65\u9a5f3\uff1a\u5617\u8a66\u4e0d\u540c\u7684\u914d\u65b9\uff0c\u4ee5\u767c\u73fe\u7a00\u6709\u5716\u7d19\u3002\u4f8b\u5982\uff0c\u5728\u935b\u9020\u7210\u4e2d\u5c07\u9435\u7926\u77f3\u548c\u7164\u70ad\u878d\u5408\u53ef\u4ee5\u88fd\u4f5c\u4e00\u628a\u5f37\u529b\u7684\u528d\u3002\u9019\u500b\u7cfb\u7d71\u9f13\u52f5\u5275\u9020\u529b\u548c\u8cc7\u6e90\u5229\u7528\u3002"}, {"question": "\u300aWho Are Ya\u300b\u4e2d\u7684\u52d5\u614b\u5929\u6c23\u7cfb\u7d71\u5982\u4f55\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff1f", "answer": "\u300aWho Are Ya\u300b\u4e2d\u7684\u52d5\u614b\u5929\u6c23\u7cfb\u7d71\u6703\u4ee5\u591a\u7a2e\u65b9\u5f0f\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff1a\u6b65\u9a5f1\uff1a\u4e0b\u96e8\u6703\u4f7f\u8868\u9762\u8b8a\u5f97\u6fd5\u6ed1\uff0c\u5f71\u97ff\u79fb\u52d5\u548c\u6230\u9b25\u3002\u6b65\u9a5f2\uff1a\u66b4\u98a8\u96ea\u6703\u964d\u4f4e\u80fd\u898b\u5ea6\uff0c\u4f7f\u5c0e\u822a\u8b8a\u5f97\u8271\u96e3\u3002\u6b65\u9a5f3\uff1a\u6674\u5929\u6703\u63d0\u5347\u67d0\u4e9b\u6280\u80fd\uff0c\u4f8b\u5982\u8fb2\u696d\u6548\u7387\u3002\u4f8b\u5982\uff0c\u5728\u66b4\u98a8\u96e8\u671f\u9593\uff0c\u4f60\u53ef\u80fd\u6703\u767c\u73fe\u7a00\u6709\u6750\u6599\u88ab\u6c96\u5237\u5230\u5cb8\u908a\u3002\u9019\u500b\u7cfb\u7d71\u70ba\u904a\u6232\u4e16\u754c\u589e\u6dfb\u4e86\u771f\u5be6\u611f\u548c\u591a\u6a23\u6027\u3002"}, {"question": "\u5728\u300aWho Are Ya\u300b\u4e2d\uff0c\u73a9\u5bb6\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u9593\u8f49\u79fb\u9032\u5ea6\u6642\u61c9\u8a72\u8003\u616e\u54ea\u4e9b\u56e0\u7d20\uff1f", "answer": "\u5728\u300aWho Are Ya\u300b\u4e2d\uff0c\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u9593\u8f49\u79fb\u9032\u5ea6\u6642\uff0c\u8acb\u8003\u616e\u4ee5\u4e0b\u56e0\u7d20\uff1a\u6b65\u9a5f1\uff1a\u78ba\u4fdd\u4f60\u7684\u904a\u6232\u5e33\u865f\u9023\u7d50\u5230\u55ae\u4e00\u5e33\u6236\u3002\u6b65\u9a5f2\uff1a\u6aa2\u67e5\u5e73\u53f0\u7279\u5b9a\u9650\u5236\u6216\u5dee\u7570\u3002\u6b65\u9a5f3\uff1a\u9a57\u8b49\u6240\u6709DLC\u548c\u66f4\u65b0\u662f\u5426\u76f8\u5bb9\u3002\u4f8b\u5982\uff0c\u5f9ePC\u8f49\u79fb\u5230\u4e3b\u6a5f\u53ef\u80fd\u9700\u8981\u8abf\u6574\u63a7\u5236\u8a2d\u5b9a\uff0c\u4ee5\u7372\u5f97\u6700\u4f73\u904a\u6232\u9ad4\u9a57\u3002\u9019\u500b\u8003\u91cf\u78ba\u4fdd\u4e86\u5728\u4e0d\u540c\u88dd\u7f6e\u9593\u7684\u9806\u5229\u8f49\u63db\u3002"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728\u300aWho Are Ya\u300b\u4e2d\u627e\u5230\u96b1\u85cf\u7684\u80cc\u666f\u6545\u4e8b\u7269\u54c1\u5728\u54ea\u88e1\uff1f", "answer": "\u300aWho Are Ya\u300b\u4e2d\u7684\u96b1\u85cf\u80cc\u666f\u6545\u4e8b\u7269\u54c1\u53ef\u4ee5\u5728\u9019\u4e9b\u5730\u9ede\u627e\u5230\uff1a\u6b65\u9a5f1\uff1a\u63a2\u7d22\u504f\u96e2\u4e3b\u7dda\u5340\u57df\uff0c\u4f8b\u5982\u6d1e\u7a74\u548c\u5ee2\u589f\u3002\u6b65\u9a5f2\uff1a\u8207\u770b\u4f3c\u5e73\u51e1\u7684\u7269\u4ef6\u4e92\u52d5\uff0c\u5b83\u5011\u53ef\u80fd\u6709\u5fae\u5999\u7684\u7dda\u7d22\u3002\u6b65\u9a5f3\uff1a\u5b8c\u6210\u7279\u5b9a\u4efb\u52d9\uff0c\u4ee5\u89e3\u9396\u9032\u5165\u79d8\u5bc6\u5340\u57df\u7684\u9014\u5f91\u3002\u4f8b\u5982\uff0c\u5716\u66f8\u9928\u4e2d\u770b\u4f3c\u666e\u901a\u7684\u66f8\u53ef\u80fd\u5305\u542b\u4e00\u5f35\u5730\u5716\uff0c\u901a\u5f80\u96b1\u85cf\u7684\u5bf6\u85cf\u3002\u9019\u4e9b\u7269\u54c1\u8c50\u5bcc\u4e86\u904a\u6232\u7684\u6558\u4e8b\uff0c\u4e26\u734e\u52f5\u63a2\u7d22\u3002"}]
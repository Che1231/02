[{"question": "\u30c9\u30c9\u30af\u30eb\u30fb\u30af\u30ea\u30b1\u30c3\u30c8\u3067\u521d\u5fc3\u8005\u3068\u3057\u3066\u57fa\u672c\u7684\u306a\u30b7\u30e7\u30c3\u30c8\u3092\u884c\u3046\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30c9\u30c9\u30af\u30eb\u30fb\u30af\u30ea\u30b1\u30c3\u30c8\u3067\u57fa\u672c\u7684\u306a\u30b7\u30e7\u30c3\u30c8\u3092\u884c\u3046\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30dc\u30fc\u30eb\u304c\u6295\u3052\u3089\u308c\u308b\u306e\u3092\u5f85\u3061\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30dc\u30fc\u30eb\u304c\u6253\u6483\u30be\u30fc\u30f3\u306b\u3042\u308b\u3068\u304d\u306b\u753b\u9762\u3092\u30bf\u30c3\u30d7\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30dc\u30fc\u30eb\u3092\u6b63\u78ba\u306b\u6253\u3064\u305f\u3081\u306b\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u65e9\u3059\u304e\u305f\u308a\u9045\u3059\u304e\u305f\u308a\u30bf\u30c3\u30d7\u3059\u308b\u3068\u3001\u30df\u30b9\u30b7\u30e7\u30c3\u30c8\u3084\u5f31\u3044\u30b7\u30e7\u30c3\u30c8\u306b\u306a\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u30bf\u30a4\u30df\u30f3\u30b0\u30be\u30fc\u30f3\u3092\u8996\u899a\u5316\u3059\u308b\u305f\u3081\u306e\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u3088\u308a\u7406\u89e3\u3057\u3084\u3059\u304f\u306a\u308a\u307e\u3059\u3002"}, {"question": "\u30c9\u30c9\u30af\u30eb\u30fb\u30af\u30ea\u30b1\u30c3\u30c8\u3067\u7fd2\u5f97\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u91cd\u8981\u306a\u64cd\u4f5c\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30c9\u30c9\u30af\u30eb\u30fb\u30af\u30ea\u30b1\u30c3\u30c8\u306e\u91cd\u8981\u306a\u64cd\u4f5c\u306b\u306f\u30011)\u30b7\u30e7\u30c3\u30c8\u306e\u30bf\u30c3\u30d7\u30bf\u30a4\u30df\u30f3\u30b0\u30012)\u30d1\u30ef\u30fc\u30b7\u30e7\u30c3\u30c8\u306e\u30b9\u30ef\u30a4\u30d7\u30013)\u69d8\u3005\u306a\u6295\u7403\u30bf\u30a4\u30d7\u306b\u5408\u308f\u305b\u3066\u69cb\u3048\u3092\u8abf\u6574\u3059\u308b\u3053\u3068\u306a\u3069\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u4e0a\u65b9\u5411\u3078\u306e\u30b9\u30ef\u30a4\u30d7\u306f\u9ad8\u304f\u6253\u3061\u4e0a\u3052\u308b\u30b7\u30e7\u30c3\u30c8\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002\u7570\u306a\u308b\u30b9\u30ef\u30a4\u30d7\u65b9\u5411\u306e\u52b9\u679c\u3092\u6bd4\u8f03\u3059\u308b\u305f\u3081\u306e\u69cb\u6210\u8868\u3092\u4f7f\u7528\u3059\u308b\u3068\u4fbf\u5229\u3067\u3059\u3002"}, {"question": "\u30c9\u30c9\u30af\u30eb\u30fb\u30af\u30ea\u30b1\u30c3\u30c8\u3067\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u3069\u306e\u3088\u3046\u306b\u6539\u5584\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30c9\u30c9\u30af\u30eb\u30fb\u30af\u30ea\u30b1\u30c3\u30c8\u3067\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u306a\u306e\u306f\u3001\u30b7\u30e7\u30c3\u30c8\u306e\u6b63\u78ba\u6027\u3068\u5a01\u529b\u306b\u5f71\u97ff\u3059\u308b\u305f\u3081\u3067\u3059\u3002\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u6539\u5584\u3059\u308b\u305f\u3081\u306b\u3001\u30dc\u30fc\u30eb\u306e\u8ecc\u9053\u306b\u96c6\u4e2d\u3057\u3001\u30e1\u30c8\u30ed\u30ce\u30fc\u30e0\u30a2\u30d7\u30ea\u3092\u4f7f\u3063\u3066\u30ea\u30ba\u30e0\u3092\u958b\u767a\u3059\u308b\u3053\u3068\u3067\u3001\u5b9a\u671f\u7684\u306b\u7df4\u7fd2\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u30dc\u30fc\u30eb\u304c\u6700\u9ad8\u70b9\u306b\u3042\u308b\u3068\u304d\u306b\u6253\u3064\u3053\u3068\u3067\u3001\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u3002\u7570\u306a\u308b\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u30b7\u30e7\u30c3\u30c8\u306e\u7d50\u679c\u306b\u4e0e\u3048\u308b\u5f71\u97ff\u3092\u793a\u3059\u6bd4\u8f03\u8868\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "100\u6642\u9593\u30d7\u30ec\u30a4\u5f8c\u306b\u3001\u30c9\u30c9\u30af\u30eb\u30fb\u30af\u30ea\u30b1\u30c3\u30c8\u3067\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u306e\u306b\u5f79\u7acb\u3064\u9ad8\u5ea6\u306a\u6226\u7565\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "100\u6642\u9593\u30d7\u30ec\u30a4\u5f8c\u3001\u9ad8\u5ea6\u306a\u6226\u7565\u306b\u306f\u3001\u30b9\u30c6\u30c3\u30d71\uff1a\u30dc\u30a6\u30e9\u30fc\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u7814\u7a76\u3057\u3066\u6295\u7403\u3092\u4e88\u6e2c\u3059\u308b\u3053\u3068\u3001\u30b9\u30c6\u30c3\u30d72\uff1a\u30e9\u30f3\u3092\u6700\u5927\u5316\u3059\u308b\u305f\u3081\u306b\u6226\u7565\u7684\u306b\u30d1\u30ef\u30fc\u30b7\u30e7\u30c3\u30c8\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u3001\u30b9\u30c6\u30c3\u30d73\uff1a\u30a2\u30a6\u30c8\u306b\u306a\u308b\u306e\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u30c7\u30a3\u30d5\u30a7\u30f3\u30b9\u30b7\u30e7\u30c3\u30c8\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u306a\u3069\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b9\u30d4\u30ca\u30fc\u306e\u6295\u7403\u3092\u65e9\u671f\u306b\u8a8d\u8b58\u3059\u308b\u3053\u3068\u3067\u3001\u30b7\u30e7\u30c3\u30c8\u3092\u8abf\u6574\u3059\u308b\u4e8b\u304c\u3067\u304d\u307e\u3059\u3002\u69d8\u3005\u306a\u6295\u7403\u306b\u5bfe\u5fdc\u3057\u305f\u610f\u601d\u6c7a\u5b9a\u30d7\u30ed\u30bb\u30b9\u3092\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3067\u793a\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30c9\u30c9\u30af\u30eb\u30fb\u30af\u30ea\u30b1\u30c3\u30c8\u3067\u30b9\u30d4\u30f3\u30dc\u30fc\u30eb\u3092\u52b9\u679c\u7684\u306b\u6253\u3061\u8fd4\u3059\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30d4\u30f3\u30dc\u30fc\u30eb\u3092\u52b9\u679c\u7684\u306b\u6253\u3061\u8fd4\u3059\u306b\u306f\u3001\u30b9\u30c6\u30c3\u30d71\uff1a\u30dc\u30fc\u30eb\u3092\u6ce8\u610f\u6df1\u304f\u898b\u3066\u56de\u8ee2\u306e\u65b9\u5411\u3092\u691c\u51fa\u3059\u308b\u3053\u3068\u3001\u30b9\u30c6\u30c3\u30d72\uff1a\u30b9\u30d4\u30f3\u3092\u88dc\u6b63\u3059\u308b\u305f\u3081\u306b\u30b7\u30e7\u30c3\u30c8\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u8abf\u6574\u3059\u308b\u3053\u3068\u3001\u30b9\u30c6\u30c3\u30d73\uff1a\u4e0d\u78ba\u304b\u306a\u5834\u5408\u306f\u30c7\u30a3\u30d5\u30a7\u30f3\u30b9\u30b7\u30e7\u30c3\u30c8\u3092\u4f7f\u3046\u3053\u3068\u306a\u3069\u304c\u6319\u3052\u3089\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30c3\u30b0\u30b9\u30d4\u30ca\u30fc\u306b\u5bfe\u3057\u3066\u9045\u308c\u3066\u6253\u3064\u3053\u3068\u3067\u3001\u30a2\u30a6\u30c8\u306b\u306a\u308b\u30ea\u30b9\u30af\u3092\u6e1b\u3089\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30d4\u30f3\u306e\u7a2e\u985e\u3068\u63a8\u5968\u3055\u308c\u308b\u30b7\u30e7\u30c3\u30c8\u3092\u5bfe\u5fdc\u4ed8\u3051\u308b\u305f\u3081\u306e\u69cb\u6210\u8868\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30c9\u30c9\u30af\u30eb\u30fb\u30af\u30ea\u30b1\u30c3\u30c8\u3067\u9ad8\u5f97\u70b9\u3092\u51fa\u3059\u305f\u3081\u306b\u3001\u30a4\u30cb\u30f3\u30b0\u3092\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u9ad8\u5f97\u70b9\u3092\u51fa\u3059\u305f\u3081\u306b\u30a4\u30cb\u30f3\u30b0\u3092\u7ba1\u7406\u3059\u308b\u306b\u306f\u3001\u30b9\u30c6\u30c3\u30d71\uff1a\u614e\u91cd\u306b\u958b\u59cb\u3057\u3066\u57fa\u790e\u3092\u7bc9\u304f\u3053\u3068\u3001\u30b9\u30c6\u30c3\u30d72\uff1a\u4e2d\u76e4\u306e\u30aa\u30fc\u30d0\u30fc\u3067\u5f97\u70b9\u30da\u30fc\u30b9\u3092\u4e0a\u3052\u308b\u4e8b\u3001\u30b9\u30c6\u30c3\u30d73\uff1a\u7a4d\u6975\u7684\u306a\u30b7\u30e7\u30c3\u30c8\u3067\u7de0\u3081\u304f\u304f\u308b\u3053\u3068\u306a\u3069\u304c\u6319\u3052\u3089\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6700\u7d42\u30aa\u30fc\u30d0\u30fc\u307e\u3067\u30d1\u30ef\u30fc\u30b7\u30e7\u30c3\u30c8\u3092\u6b8b\u3059\u3053\u3068\u3067\u3001\u5408\u8a08\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306e\u7570\u306a\u308b\u6bb5\u968e\u306b\u304a\u3051\u308b\u30e9\u30f3\u306e\u5206\u5e03\u3092\u793a\u3059\u6bd4\u8f03\u8868\u3092\u4f7f\u7528\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30c9\u30c9\u30af\u30eb\u30fb\u30af\u30ea\u30b1\u30c3\u30c8\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u3069\u306e\u3088\u3046\u306b\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30c9\u30c9\u30af\u30eb\u30fb\u30af\u30ea\u30b1\u30c3\u30c8\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6b63\u78ba\u3067\u5f37\u529b\u306a\u30b7\u30e7\u30c3\u30c8\u3092\u5831\u3044\u307e\u3059\u3002\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u30dc\u30fc\u30eb\u3092\u30b9\u30a4\u30fc\u30c8\u30b9\u30dd\u30c3\u30c8\u306b\u5f53\u3066\u3066\u3001\u30d0\u30a6\u30f3\u30c0\u30ea\u30fc\u3092\u72d9\u3046\u305f\u3081\u306e\u30d1\u30ef\u30fc\u30b7\u30e7\u30c3\u30c8\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3088\u304f\u30d0\u30c3\u30c8\u306e\u4e2d\u592e\u306b\u30dc\u30fc\u30eb\u3092\u5f53\u3066\u308c\u3070\u30016\u30e9\u30f3\u306b\u7e4b\u304c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u30b7\u30e7\u30c3\u30c8\u306e\u8cea\u306b\u57fa\u3065\u3044\u305f\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u8aac\u660e\u3059\u308b\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30c9\u30c9\u30af\u30eb\u30fb\u30af\u30ea\u30b1\u30c3\u30c8\u306b\u304a\u3051\u308b\u30d1\u30ef\u30fc\u30b7\u30e7\u30c3\u30c8\u306e\u57fa\u790e\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30c9\u30c9\u30af\u30eb\u30fb\u30af\u30ea\u30b1\u30c3\u30c8\u306b\u304a\u3051\u308b\u30d1\u30ef\u30fc\u30b7\u30e7\u30c3\u30c8\u306f\u3001\u30b9\u30ef\u30a4\u30d7\u901f\u5ea6\u3001\u89d2\u5ea6\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u3044\u3063\u305f\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u3088\u3063\u3066\u652f\u914d\u3055\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u7d20\u65e9\u3044\u4e0a\u65b9\u5411\u306e\u30b9\u30ef\u30a4\u30d7\u306f\u9ad8\u304f\u6253\u3061\u4e0a\u3052\u308b6\u30e9\u30f3\u306b\u7e4b\u304c\u308a\u5f97\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30b7\u30e7\u30c3\u30c8\u306f\u30b9\u30bf\u30df\u30ca\u3092\u6d88\u8cbb\u3059\u308b\u306e\u3067\u3001\u614e\u91cd\u306b\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u7570\u306a\u308b\u30b9\u30ef\u30a4\u30d7\u30d1\u30e9\u30e1\u30fc\u30bf\u304c\u30b7\u30e7\u30c3\u30c8\u306e\u7d50\u679c\u306b\u53ca\u307c\u3059\u5f71\u97ff\u3092\u8a73\u7d30\u306b\u793a\u3059\u69cb\u6210\u8868\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30c9\u30c9\u30af\u30eb\u30fb\u30af\u30ea\u30b1\u30c3\u30c8\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8907\u6570\u306e\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f\u3069\u306e\u3088\u3046\u306b\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30bd\u30fc\u30b7\u30e3\u30eb\u30e1\u30c7\u30a3\u30a2\u307e\u305f\u306f\u30e1\u30fc\u30ebID\u306b\u30b2\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30ea\u30f3\u30af\u3059\u308b\u3053\u3068\u3067\u3001\u30c9\u30c9\u30af\u30eb\u30fb\u30af\u30ea\u30b1\u30c3\u30c8\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8907\u6570\u306e\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u8ee2\u9001\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u540c\u3058\u8a8d\u8a3c\u60c5\u5831\u3067\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3068\u3001\u30c7\u30fc\u30bf\u304c\u540c\u671f\u3055\u308c\u307e\u3059\u3002\u30a2\u30ab\u30a6\u30f3\u30c8\u306e\u30ea\u30f3\u30af\u3068\u30c7\u30fc\u30bf\u8ee2\u9001\u306e\u624b\u9806\u3092\u793a\u3059\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30c9\u30c9\u30af\u30eb\u30fb\u30af\u30ea\u30b1\u30c3\u30c8\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3084\u79d8\u5bc6\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30c9\u30c9\u30af\u30eb\u30fb\u30af\u30ea\u30b1\u30c3\u30c8\u306b\u306f\u3001\u7279\u5225\u306a\u30a2\u30f3\u30ed\u30c3\u30af\u53ef\u80fd\u306a\u30d0\u30c3\u30c8\u3084\u3001\u30de\u30a4\u30eb\u30b9\u30c8\u30fc\u30f3\u9054\u6210\u6642\u306e\u30e6\u30cb\u30fc\u30af\u306a\u30bb\u30ec\u30d6\u30ec\u30fc\u30b7\u30e7\u30f3\u3068\u3044\u3063\u305f\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u30011\u30b2\u30fc\u30e0\u3067100\u70b9\u3092\u7372\u5f97\u3059\u308b\u3068\u3001\u30b4\u30fc\u30eb\u30c7\u30f3\u30d0\u30c3\u30c8\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u65e2\u77e5\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3068\u305d\u306e\u30a2\u30f3\u30ed\u30c3\u30af\u6761\u4ef6\u3092\u4e00\u89a7\u8868\u793a\u3059\u308b\u6bd4\u8f03\u8868\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}]
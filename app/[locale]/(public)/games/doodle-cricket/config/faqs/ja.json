[{"question": "Doodle Cricket 101\uff1a\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001\u3069\u306e\u3088\u3046\u306b\u30d0\u30c3\u30c8\u3092\u632f\u3063\u3066\u30dc\u30fc\u30eb\u3092\u52b9\u679c\u7684\u306b\u6253\u3066\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u521d\u5fc3\u8005\u306b\u3068\u3063\u3066\u3001Doodle Cricket\u3067\u30d0\u30c3\u30c8\u3092\u52b9\u679c\u7684\u306b\u632f\u308b\u306b\u306f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u72d9\u3044\u304c\u91cd\u8981\u3067\u3059\u3002\u30af\u30ea\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u304c\u7bc4\u56f2\u5185\u306b\u3042\u308b\u3068\u304d\u306b\u753b\u9762\u3092\u30bf\u30c3\u30d7\u3057\u307e\u3059\u3002\u30b9\u30c8\u30ec\u30fc\u30c8\u30b7\u30e7\u30c3\u30c8\u306e\u5834\u5408\u306f\u3001\u30dc\u30fc\u30eb\u304c\u30d0\u30c3\u30bf\u30fc\u306e\u771f\u524d\u306b\u3042\u308b\u3068\u304d\u306b\u30bf\u30c3\u30d7\u3057\u307e\u3059\u3002\u9ad8\u304f\u6253\u3061\u4e0a\u3052\u308b\u30b7\u30e7\u30c3\u30c8\u3092\u3059\u308b\u5834\u5408\u306f\u3001\u30bf\u30c3\u30d7\u3059\u308b\u969b\u306b\u753b\u9762\u3092\u5c11\u3057\u4e0a\u306b\u30b9\u30ef\u30a4\u30d7\u3057\u307e\u3059\u3002\u521d\u671f\u30ec\u30d9\u30eb\u3067\u7df4\u7fd2\u3057\u3066\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u30de\u30b9\u30bf\u30fc\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u3066\u3093\u3068\u3046\u866b\u3092\u6253\u3064\u3053\u3068\u306b\u96c6\u4e2d\u3057\u3066\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u307e\u3057\u3087\u3046\u3002\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u3067\u3059\uff01\u30dc\u30fc\u30eb\u3092\u30ad\u30e3\u30c3\u30c1\u3059\u308b\u3053\u3068\u3068\u4f3c\u3066\u3044\u307e\u3059\u3002\u5230\u7740\u3092\u4e88\u6e2c\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002[\u4f8b\uff1a\u30d2\u30c3\u30c8\u306f\u91ce\u7403\u306e\u30d0\u30c3\u30c6\u30a3\u30f3\u30b0\u3068\u540c\u3058\u3067\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u3067\u3059]\u3002\u3055\u307e\u3056\u307e\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u30b9\u30ef\u30a4\u30d7\u89d2\u5ea6\u3092\u8a66\u3057\u3066\u3001\u30dc\u30fc\u30eb\u306e\u8ecc\u9053\u3092\u898b\u3066\u304f\u3060\u3055\u3044\u3002\u8981\u7d04\u3059\u308b\u3068\u3001\u30b9\u30c8\u30ec\u30fc\u30c8\u30d2\u30c3\u30c8\u306b\u306f\u30bf\u30c3\u30d7\u3057\u3001\u9ad8\u304f\u6253\u3061\u4e0a\u3052\u308b\u30d2\u30c3\u30c8\u306b\u306f\u5c11\u3057\u4e0a\u306b\u30b9\u30ef\u30a4\u30d7\u3057\u307e\u3059\u3002[\u6280\u8853\u7684\u306a\u5206\u89e3]"}, {"question": "Doodle Cricket\u30b2\u30fc\u30e0\u3067\u3001\u3053\u308c\u3089\u306e\u7279\u5225\u306a\u30af\u30ea\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\uff08\u3066\u3093\u3068\u3046\u866b\u306a\u3069\uff09\u304c\u51fa\u73fe\u3059\u308b\u80cc\u5f8c\u306b\u3042\u308b\u30dd\u30a4\u30f3\u30c8\u306f\u306a\u3093\u3067\u3059\u304b\uff1f", "answer": "Doodle Cricket\u3067\u3001\u3066\u3093\u3068\u3046\u866b\u306a\u3069\u306e\u7279\u5225\u306a\u30dc\u30fc\u30eb\u304c\u51fa\u73fe\u3059\u308b\u3053\u3068\u306f\u3001\u30dc\u30fc\u30ca\u30b9\u30c1\u30e3\u30f3\u30b9\u3092\u793a\u3057\u3066\u3044\u307e\u3059\u3002\u3066\u3093\u3068\u3046\u866b\u3092\u6253\u3064\u3068\u3001\u8ffd\u52a0\u306e\u30e9\u30f3\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u30b2\u30fc\u30e0\u304c\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u3088\u308a\u65e9\u304f\u9ad8\u5f97\u70b9\u3092\u53d6\u308b\u306e\u3092\u52a9\u3051\u308b\u65b9\u6cd5\u3067\u3059\u3002\u5f8c\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u30dc\u30fc\u30ca\u30b9\u52b9\u679c\u3092\u6301\u3064\u3055\u307e\u3056\u307e\u306a\u30dc\u30fc\u30eb\u306e\u51fa\u73fe\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002\u3066\u3093\u3068\u3046\u866b\u306f\u8ffd\u52a0\u306e\u30e9\u30f3\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u5225\u306e\u3082\u306e\u306f\u3001\u30b7\u30e7\u30c3\u30c8\u3078\u306e\u30d1\u30ef\u30fc\u30d6\u30fc\u30b9\u30c8\u3092\u8ffd\u52a0\u3059\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u3066\u3093\u3068\u3046\u866b\u3092\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3068\u8003\u3048\u3001\u6b63\u78ba\u306a\u30d2\u30c3\u30c8\u306b\u5bfe\u3059\u308b\u5373\u5ea7\u306e\u5831\u916c\u3092\u63d0\u4f9b\u3059\u308b\u3068\u8003\u3048\u307e\u3057\u3087\u3046\u3002\u5e38\u306b\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u3092\u6700\u5927\u9650\u306b\u6d3b\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u9ad8\u5727\u529b\u306e\u72b6\u6cc1\u3067\u6a19\u6e96\u7684\u306a\u30af\u30ea\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u3088\u308a\u3082\u3066\u3093\u3068\u3046\u866b\u3092\u512a\u5148\u7684\u306b\u6253\u3064\u3053\u3068\u3067\u3001\u8fc5\u901f\u306a\u5f97\u70b9\u30d6\u30fc\u30b9\u30c8\u3092\u5f97\u3066\u304f\u3060\u3055\u3044\u3002[\u30dc\u30fc\u30ca\u30b9\u30bf\u30a4\u30d7\u8868\u304c\u63d0\u4f9b\u3055\u308c\u3066\u3044\u308b]"}, {"question": "\u306a\u305cDoodle Cricket\u30b2\u30fc\u30e0\u304c\u6642\u3005\u30e9\u30b0\u3084\u30d5\u30ea\u30fc\u30ba\u3059\u308b\u306e\u3067\u3059\u304b\uff1f\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u306b\u4f55\u304c\u3067\u304d\u308b\u3067\u3057\u3087\u3046\u304b\uff1f", "answer": "Doodle Cricket\u3067\u306e\u30e9\u30b0\u3084\u30d5\u30ea\u30fc\u30ba\u306f\u3001\u30a4\u30e9\u30a4\u30e9\u3059\u308b\u3082\u306e\u3067\u3059\u3002\u3053\u308c\u306f\u3001\u30c7\u30d0\u30a4\u30b9\u306e\u5236\u9650\u307e\u305f\u306f\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u30a2\u30d7\u30ea\u306e\u30ea\u30bd\u30fc\u30b9\u306e\u6d88\u8cbb\u306b\u3088\u308b\u3082\u306e\u3067\u3059\u3002\u4f7f\u7528\u3057\u3066\u3044\u306a\u3044\u30a2\u30d7\u30ea\u30b1\u30fc\u30b7\u30e7\u30f3\u3092\u9589\u3058\u3001\u30e1\u30e2\u30ea\u3092\u958b\u653e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3055\u3089\u306b\u3001\u30c7\u30d0\u30a4\u30b9\u306e\u30aa\u30da\u30ec\u30fc\u30c6\u30a3\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u304c\u6700\u65b0\u3067\u3042\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6642\u3005\u3001\u5358\u306b\u30b2\u30fc\u30e0\u3092\u518d\u8d77\u52d5\u3057\u305f\u308a\u3001\u5834\u5408\u306b\u3088\u3063\u3066\u306f\u30c7\u30d0\u30a4\u30b9\u81ea\u4f53\u3092\u518d\u8d77\u52d5\u3057\u305f\u308a\u3059\u308b\u3053\u3068\u3067\u3001\u4e00\u6642\u7684\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306e\u554f\u984c\u3092\u89e3\u6c7a\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30c6\u30b9\u30c8\u3068\u3057\u3066\u3001\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u3067\u4f55\u304b\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3066\u3044\u306a\u3044\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u5f93\u3046\u3079\u304d\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306e\u30d2\u30f3\u30c8\u306e\u30c1\u30a7\u30c3\u30af\u30ea\u30b9\u30c8]\u3002\u554f\u984c\u304c\u7d9a\u304f\u5834\u5408\u306f\u3001\u51e6\u7406\u80fd\u529b\u306e\u9ad8\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u30d7\u30ec\u30a4\u3059\u308b\u3053\u3068\u3092\u691c\u8a0e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b2\u30fc\u30e0\u81ea\u4f53\u306b\u95a2\u9023\u3057\u3066\u3044\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u304c\u3001\u30b2\u30fc\u30e0\u306f\u901a\u5e38\u554f\u984c\u3042\u308a\u307e\u305b\u3093\u3002[\u30ea\u30bd\u30fc\u30b9\u4f7f\u7528\u7387\u306e\u6bd4\u8f03]"}, {"question": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u3057\u3066\u3001Doodle Cricket\u3067\u4e00\u8cab\u3057\u3066\u9ad8\u3044\u30e9\u30f3\u3092\u7372\u5f97\u3059\u308b\u305f\u3081\u306b\u4f7f\u3048\u308b\u6226\u7565\u306f\u3069\u3093\u306a\u3082\u306e\u3067\u3059\u304b\uff1f", "answer": "Doodle Cricket\u3067\u4e00\u8cab\u3057\u3066\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u306b\u306f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u30b7\u30e7\u30c3\u30c8\u306e\u914d\u7f6e\u306e\u6280\u8853\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b7\u30e7\u30c3\u30c8\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5b8c\u74a7\u306b\u7df4\u7fd2\u3057\u307e\u3059\u3002'\u5b8c\u74a7\u306a'\u30d2\u30c3\u30c8\u306b\u8fd1\u3044\u307b\u3069\u3001\u5f97\u70b9\u3059\u308b\u30e9\u30f3\u304c\u591a\u304f\u306a\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d5\u30a3\u30fc\u30eb\u30c9\u306e\u914d\u7f6e\u3092\u89b3\u5bdf\u3057\u3001\u30d5\u30a3\u30fc\u30eb\u30c9\u30d7\u30ec\u30fc\u30e4\u30fc\u306e\u9593\u306e\u9699\u9593\u306b\u30dc\u30fc\u30eb\u3092\u6253\u3061\u8fbc\u3080\u3088\u3046\u306b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u9ad8\u304f\u6253\u3061\u4e0a\u3052\u308b\u30b7\u30e7\u30c3\u30c8\u3092\u6226\u7565\u7684\u306b\u4f7f\u7528\u3057\u3066\u3001\u30a4\u30f3\u30d5\u30a3\u30fc\u30eb\u30c9\u3092\u8d8a\u3048\u3001\u30d0\u30a6\u30f3\u30c0\u30ea\u3092\u30d2\u30c3\u30c8\u3057\u3066\u30b9\u30b3\u30a2\u3057\u307e\u3057\u3087\u3046\u3002\u9699\u9593\u3092\u72d9\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30df\u30c3\u30c9\u30aa\u30f3\u3068\u30df\u30c3\u30c9\u30a6\u30a3\u30b1\u30c3\u30c8\u306e\u9593\u306e\u9699\u9593\u304c\u3042\u308b\u3053\u3068\u306b\u6c17\u4ed8\u3044\u305f\u3089\u3001\u305d\u3053\u3092\u72d9\u3063\u3066\u30b7\u30e7\u30c3\u30c8\u3092\u6253\u3061\u307e\u3057\u3087\u3046\u3002\u30b7\u30e7\u30c3\u30c8\u306e\u7a2e\u985e\u3092\u5909\u5316\u3055\u305b\u308b\u3053\u3068\u3067\u3001\u30d5\u30a3\u30fc\u30eb\u30c9\u30d7\u30ec\u30fc\u30e4\u30fc\u3092\u4e88\u60f3\u3055\u305b\u306a\u3044\u3088\u3046\u306b\u3057\u307e\u3059\u3002[\u6226\u7565\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8]\u3002\u4e00\u8cab\u6027\u306f\u3001\u7df4\u7fd2\u3068\u30b2\u30fc\u30e0\u30c0\u30a4\u30ca\u30df\u30af\u30b9\u3078\u306e\u9069\u5fdc\u306b\u3088\u3063\u3066\u751f\u307e\u308c\u307e\u3059\u3002"}, {"question": "Doodle Cricket\uff1aAI\u306e\u30d5\u30a3\u30fc\u30eb\u30c9\u30d7\u30ec\u30fc\u30e4\u30fc\u3068\u305d\u306e\u914d\u7f6e\u306e\u50be\u5411\u3092\u3069\u306e\u3088\u3046\u306b\u6d3b\u7528\u3057\u3066\u3001\u79c1\u306e\u5f97\u70b9\u6a5f\u4f1a\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Doodle Cricket\u3067AI\u306e\u30d5\u30a3\u30fc\u30eb\u30c9\u30d7\u30ec\u30fc\u30e4\u30fc\u3092\u653b\u7565\u3059\u308b\u306b\u306f\u3001\u5f7c\u3089\u306e\u914d\u7f6e\u30d1\u30bf\u30fc\u30f3\u3092\u7406\u89e3\u3057\u3001\u5f7c\u3089\u306e\u52d5\u304d\u3092\u4e88\u6e2c\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u5404\u6295\u7403\u306e\u524d\u306b\u5f7c\u3089\u306e\u4f4d\u7f6e\u3092\u89b3\u5bdf\u3057\u3001\u9699\u9593\u306b\u72d9\u3044\u3092\u5b9a\u3081\u307e\u3059\u3002AI\u306f\u904e\u53bb\u306e\u30b7\u30e7\u30c3\u30c8\u306b\u57fa\u3065\u3044\u3066\u30d5\u30a3\u30fc\u30eb\u30c9\u306e\u914d\u7f6e\u3092\u8abf\u6574\u3059\u308b\u50be\u5411\u304c\u3042\u308b\u306e\u3067\u3001\u30b7\u30e7\u30c3\u30c8\u306e\u7a2e\u985e\u3092\u983b\u7e41\u306b\u5909\u3048\u3066\u5f7c\u3089\u3092\u4e88\u60f3\u3055\u305b\u306a\u3044\u3088\u3046\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u5f7c\u3089\u304c\u30aa\u30d5\u30b5\u30a4\u30c9\u306b\u914d\u7f6e\u3059\u308b\u306a\u3089\u3001\u30ec\u30c3\u30b0\u30b5\u30a4\u30c9\u3092\u76ee\u6a19\u3068\u3057\u3001\u305d\u306e\u9006\u3082\u7136\u308a\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u7279\u5b9a\u306e\u65b9\u5411\u306e\u5883\u754c\u7dda\u3092\u6253\u3063\u305f\u5f8c\u3001\u3069\u306e\u3088\u3046\u306b\u8abf\u6574\u3059\u308b\u304b\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u3092\u4f7f\u7528\u3057\u3066\u3001\u53cd\u5bfe\u65b9\u5411\u306b\u5f97\u70b9\u30c1\u30e3\u30f3\u30b9\u3092\u4f5c\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[AI\u884c\u52d5\u56f3]\u3002\u30c1\u30a7\u30b9\u306e\u30b2\u30fc\u30e0\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002"}, {"question": "Doodle Cricket\u3067\u306f\u3001\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u4f7f\u7528\u3059\u308b\u3088\u3046\u306a\u9ad8\u5ea6\u306a\u6280\u8853\uff08\u300e\u30d1\u30ef\u30fc\u30b7\u30e7\u30c3\u30c8\u300f\u3084\u30c8\u30ea\u30c3\u30af\u30b7\u30e7\u30c3\u30c8\u306a\u3069\uff09\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Doodle Cricket\u306b\u306f\u660e\u793a\u7684\u306a\u300e\u30d1\u30ef\u30fc\u30b7\u30e7\u30c3\u30c8\u300f\u306f\u3042\u308a\u307e\u305b\u3093\u304c\u3001\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u914d\u7f6e\u3092\u4f7f\u7528\u3057\u3066\u5f97\u70b9\u306e\u53ef\u80fd\u6027\u3092\u6700\u5927\u9650\u306b\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30bf\u30a4\u30df\u30f3\u30b0\u306e\u53d6\u308c\u305f\u9ad8\u304f\u6253\u3061\u4e0a\u3052\u308b\u30b7\u30e7\u30c3\u30c8\u3092\u5b8c\u74a7\u306b\u5b9f\u884c\u3059\u308b\u3068\u3001\u5883\u754c\u3092\u8d8a\u3048\u30666\u30e9\u30f3\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u30dc\u30fc\u30eb\u3092\u6700\u9069\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u6253\u3064\u305f\u3081\u306b\u30bf\u30a4\u30df\u30f3\u30b0\u30a6\u30a3\u30f3\u30c9\u30a6\u3092\u30de\u30b9\u30bf\u30fc\u3057\u307e\u3059\u3002\u3055\u307e\u3056\u307e\u306a\u30b9\u30ef\u30a4\u30d7\u89d2\u5ea6\u3092\u8a66\u3057\u3066\u3001\u30d5\u30a3\u30fc\u30eb\u30c9\u30d7\u30ec\u30fc\u30e4\u30fc\u306e\u9593\u306e\u9699\u9593\u306b\u30dc\u30fc\u30eb\u3092\u8a98\u5c0e\u3057\u3001'\u30c8\u30ea\u30c3\u30af\u30b7\u30e7\u30c3\u30c8'\u306b\u4f3c\u305f\u3082\u306e\u306b\u3057\u307e\u3059\u3002\u6700\u5927\u306e\u8ddd\u96e2\u3092\u72d9\u3046\u5834\u5408\u306f\u3001\u30dc\u30fc\u30eb\u3092\u6253\u3064\u524d\u306b\u753b\u9762\u3092\u5c11\u3057\u4e0a\u306b\u30b9\u30ef\u30a4\u30d7\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u306f\u3001\u30b9\u30a4\u30f3\u30b0\u306b\u4f59\u5206\u306a\u529b\u3092\u52a0\u3048\u308b\u65b9\u6cd5\u3068\u8003\u3048\u307e\u3059\u3002\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u306e\u30b7\u30e7\u30c3\u30c8\u3092\u5b9f\u884c\u3067\u304d\u307e\u3059\u3002\u6700\u5927\u9650\u306e\u529b\u3092\u767a\u63ee\u3057\u307e\u3059\u3002[\u9ad8\u5ea6\u306a\u6280\u8853\u30ed\u30fc\u30c9\u30de\u30c3\u30d7\u304c\u63d0\u4f9b\u3055\u308c\u3066\u3044\u307e\u3059]\u3002\u3055\u307e\u3056\u307e\u306a\u30b9\u30ef\u30a4\u30d7\u89d2\u5ea6\u3068\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u7df4\u7fd2\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "Doodle Cricket\u306e\u30a8\u30f3\u30b8\u30f3\u3067\u5f97\u70b9\u3055\u308c\u305f\u30e9\u30f3\u306e\u6570\u3092\u6c7a\u5b9a\u3059\u308b\u6839\u672c\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Doodle Cricket\u3067\u306f\u3001\u5f97\u3089\u308c\u308b\u30e9\u30f3\u306e\u6570\u306f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u30b7\u30e7\u30c3\u30c8\u306e\u914d\u7f6e\u306b\u95a2\u9023\u3059\u308b\u8981\u56e0\u306e\u7d44\u307f\u5408\u308f\u305b\u306b\u3088\u3063\u3066\u6c7a\u5b9a\u3055\u308c\u307e\u3059\u3002\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u5b8c\u74a7\u3060\u3068\u3001\u30d2\u30c3\u30c8\u304c\u9577\u304f\u3001\u5f37\u529b\u306b\u306a\u308a\u3001\u5883\u754c\uff084\u30e9\u30f3\u307e\u305f\u306f6\u30e9\u30f3\uff09\u3092\u7372\u5f97\u3059\u308b\u30c1\u30e3\u30f3\u30b9\u304c\u9ad8\u307e\u308a\u307e\u3059\u3002'\u5b8c\u74a7\u306a'\u30d2\u30c3\u30c8\u30a6\u30a3\u30f3\u30c9\u30a6\u306b\u8fd1\u3044\u307b\u3069\u3001\u5f97\u3089\u308c\u308b\u30e9\u30f3\u304c\u591a\u304f\u306a\u308a\u307e\u3059\u3002\u307e\u305f\u3001\u30dc\u30fc\u30eb\u3092\u6253\u3064\u65b9\u5411\u3068\u3001\u30d5\u30a3\u30fc\u30eb\u30c9\u306e\u914d\u7f6e\u3068\u306e\u95a2\u4fc2\u3082\u91cd\u8981\u3067\u3059\u3002\u30d5\u30a3\u30fc\u30eb\u30c9\u30d7\u30ec\u30fc\u30e4\u30fc\u306e\u9593\u306e\u9699\u9593\u306b\u30dc\u30fc\u30eb\u3092\u6253\u3064\u3053\u3068\u3067\u3001\u5f97\u70b9\u306e\u6a5f\u4f1a\u3092\u6700\u5927\u9650\u306b\u9ad8\u3081\u307e\u3059\u3002\u30e9\u30f3 = \u57fa\u672c\u5024 \u00d7 \u30bf\u30a4\u30df\u30f3\u30b0\u4fc2\u6570 \u00d7 \u914d\u7f6e\u4fc2\u6570\u3002[\u30e9\u30f3\u306e\u5f97\u70b9\u306e\u6bd4\u8f03\u8868]\u3002\u30bf\u30a4\u30df\u30f3\u30b0\u306f\u91cd\u8981\u3067\u3059\u3002"}, {"question": "Doodle Cricket\u306e\u96e3\u6613\u5ea6\u8abf\u6574\u306b\u3064\u3044\u3066\u3001\u3088\u308a\u8a73\u7d30\u306b\u8aac\u660e\u3057\u3066\u3082\u3089\u3048\u307e\u3059\u304b\uff1f", "answer": "Doodle Cricket\u306f\u3001\u30d5\u30a3\u30fc\u30eb\u30c9\u306e\u914d\u7f6e\u306e\u8abf\u6574\u3068\u30dc\u30fc\u30eb\u306e\u6295\u7403\u901f\u5ea6\u306e\u7d44\u307f\u5408\u308f\u305b\u306b\u3088\u3063\u3066\u96e3\u6613\u5ea6\u8abf\u6574\u3092\u5b9f\u88c5\u3057\u3066\u3044\u307e\u3059\u3002\u30b2\u30fc\u30e0\u3092\u9032\u3081\u308b\u306b\u3064\u308c\u3066\u3001AI\u306f\u6226\u7565\u7684\u306b\u30d5\u30a3\u30fc\u30eb\u30c9\u30d7\u30ec\u30fc\u30e4\u30fc\u3092\u914d\u7f6e\u3057\u3066\u3001\u3088\u308a\u591a\u304f\u306e\u30a8\u30ea\u30a2\u3092\u30ab\u30d0\u30fc\u3059\u308b\u3088\u3046\u306b\u306a\u308a\u3001\u9699\u9593\u3092\u898b\u3064\u3051\u308b\u306e\u304c\u96e3\u3057\u304f\u306a\u308a\u307e\u3059\u3002\u30dc\u30fc\u30eb\u306e\u6295\u7403\u901f\u5ea6\u304c\u4e0a\u304c\u308b\u305f\u3081\u3001\u3088\u308a\u7d20\u65e9\u3044\u53cd\u5c04\u3068\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u6c42\u3081\u3089\u308c\u307e\u3059\u3002\u30d5\u30a3\u30fc\u30eb\u30c9\u306e\u30ab\u30d0\u30fc\u7387\u304c\u72ed\u304f\u306a\u308a\u3001\u5f97\u70b9\u306e\u9699\u9593\u304c\u5c11\u306a\u304f\u306a\u308b\u3068\u4e88\u60f3\u3055\u308c\u307e\u3059\u3002\u30dc\u30fc\u30eb\u901f\u5ea6\u306e\u8abf\u6574\u306b\u3088\u308a\u3001\u30d9\u30c6\u30e9\u30f3\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u3082\u6311\u6226\u306f\u7d9a\u304d\u307e\u3059\u3002\u96e3\u5ea6\u306f\u5897\u52a0\u3057\u307e\u3059\u304c\u3001\u5f97\u70b9\u306e\u6a5f\u4f1a\u306f\u6b8b\u308a\u307e\u3059\u3002[\u96e3\u6613\u5ea6\u66f2\u7dda\u30b0\u30e9\u30d5]\u3002\u654f\u6377\u306b\u884c\u52d5\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u9593\u3067Doodle Cricket\u306e\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u305f\u308a\u3001\u30c7\u30fc\u30bf\u3092\u8ee2\u9001\u3059\u308b\u3053\u3068\u306f\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u6b8b\u5ff5\u306a\u304c\u3089\u3001Doodle Cricket\u306f\u901a\u5e38\u3001\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u305f\u308a\u3001\u30c7\u30fc\u30bf\u3092\u8ee2\u9001\u3057\u305f\u308a\u3059\u308b\u3053\u3068\u306f\u3067\u304d\u307e\u305b\u3093\u3002\u9032\u884c\u72b6\u6cc1\u306f\u3001\u30d7\u30ec\u30a4\u3057\u3066\u3044\u308b\u30c7\u30d0\u30a4\u30b9\u306b\u30ed\u30fc\u30ab\u30eb\u306b\u4fdd\u5b58\u3055\u308c\u307e\u3059\u3002\u65b0\u3057\u3044\u96fb\u8a71\u3084\u30bf\u30d6\u30ec\u30c3\u30c8\u306b\u5207\u308a\u66ff\u3048\u308b\u3068\u3001\u30b2\u30fc\u30e0\u3092\u6700\u521d\u304b\u3089\u59cb\u3081\u308b\u5fc5\u8981\u304c\u3042\u308b\u3067\u3057\u3087\u3046\u3002Doodle Cricket\u306e\u30af\u30e9\u30a6\u30c9\u540c\u671f\u306f\u73fe\u5728\u5b9f\u88c5\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002\u30b2\u30fc\u30e0\u306e\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u306f\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\u3092\u64ae\u308b\u3053\u3068\u3067\u884c\u3044\u307e\u3057\u3087\u3046\u3002\u6539\u5584\u7b56\u3092\u63d0\u6848\u3059\u308b\u305f\u3081\u306b\u30ab\u30b9\u30bf\u30de\u30fc\u30b5\u30fc\u30d3\u30b9\u306b\u9023\u7d61\u3059\u308b\u3053\u3068\u3092\u691c\u8a0e\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u30af\u30e9\u30a6\u30c9\u30bb\u30fc\u30d6\u6bd4\u8f03\u8868]"}, {"question": "Doodle Cricket\u306e\u79d8\u5bc6\uff1aDoodle Cricket\u30b2\u30fc\u30e0\u306b\u96a0\u3055\u308c\u305f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f\u305d\u308c\u3089\u3092\u3069\u306e\u3088\u3046\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Doodle Cricket\u306b\u306f\u4f1d\u7d71\u7684\u306a\u610f\u5473\u3067\u306e\u30a2\u30f3\u30ed\u30c3\u30af\u53ef\u80fd\u306a\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306f\u3042\u308a\u307e\u305b\u3093\u304c\u3001\u30b2\u30fc\u30e0\u306b\u306f\u7279\u5225\u306a\u8996\u899a\u7684\u8868\u73fe\u3092\u6301\u3064\u30c6\u30fc\u30de\u578b\u306e\u30c9\u30ed\u30fc\u30ea\u30f3\u30b0\uff08Doodle\uff09\u304c\u3088\u304f\u767b\u5834\u3057\u307e\u3059\u3002\u4f11\u6687\u3084\u7279\u5225\u306a\u30a4\u30d9\u30f3\u30c8\u306b\u5408\u308f\u305b\u305f\u30c9\u30ed\u30fc\u30ea\u30f3\u30b0\u3092\u63a2\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u3089\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u898b\u3064\u3051\u308b\u306b\u306f\u3001\u7279\u5225\u306a\u65e5\u3084\u7279\u5225\u306a\u30a4\u30d9\u30f3\u30c8\u4e2d\u306b\u30b2\u30fc\u30e0\u3092\u30d7\u30ec\u30a4\u3057\u3066\u304f\u3060\u3055\u3044\u3002Google\u306e\u30c9\u30ed\u30fc\u30ea\u30f3\u30b0\u81ea\u8eab\u306f\u3001\u73fe\u5b9f\u4e16\u754c\u306e\u51fa\u6765\u4e8b\u306b\u5408\u308f\u305b\u3066\u6642\u3005\u5909\u308f\u308a\u307e\u3059\u3002\u30af\u30ea\u30b1\u30c3\u30c8\u30ef\u30fc\u30eb\u30c9\u30ab\u30c3\u30d7\u306a\u3069\u306e\u7279\u5225\u306a\u30a4\u30d9\u30f3\u30c8\u4e2d\u306b\u30d7\u30ec\u30a4\u3057\u3066\u305d\u306e\u3088\u3046\u306a\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u96a0\u3055\u308c\u305f\u610f\u5473\u3092\u6301\u3064\u65e2\u77e5\u306e\u30c9\u30ed\u30fc\u30ea\u30f3\u30b0\u306e\u30ea\u30b9\u30c8]\u3002\u697d\u3057\u3093\u3067\u304f\u3060\u3055\u3044\uff01"}]
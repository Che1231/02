[{"question": "Doodle Cricket 101\uff1a\u65b0\u624b\u5982\u4f55\u6709\u6548\u63ee\u68d2\u64ca\u7403\uff1f", "answer": "\u5c0d\u65bc\u65b0\u624b\u4f86\u8aaa\uff0c\u5728Doodle Cricket\u4e2d\u6709\u6548\u63ee\u68d2\u9700\u8981\u638c\u63e1\u6642\u9593\u548c\u7784\u6e96\u3002\u7576\u7403\u5728\u64ca\u7403\u7bc4\u570d\u5167\u6642\uff0c\u9ede\u64ca\u87a2\u5e55\u3002\u8981\u6253\u76f4\u7403\uff0c\u8acb\u5728\u7403\u4f4d\u65bc\u64ca\u7403\u54e1\u6b63\u524d\u65b9\u6642\u9ede\u64ca\u3002\u8981\u64ca\u51fa\u9ad8\u9060\u7403\uff0c\u8acb\u5728\u9ede\u64ca\u87a2\u5e55\u6642\u7a0d\u5fae\u5411\u4e0a\u6ed1\u52d5\u3002\u5728\u521d\u59cb\u95dc\u5361\u4e2d\u7df4\u7fd2\uff0c\u4ee5\u638c\u63e1\u64ca\u7403\u6642\u9593\u3002\u4f8b\u5982\uff0c\u5c08\u6ce8\u65bc\u64ca\u6253\u74e2\u87f2\u4ee5\u7372\u5f97\u984d\u5916\u5206\u6578\u3002\u6642\u9593\u81f3\u95dc\u91cd\u8981\uff01\u60f3\u50cf\u4e00\u4e0b\u63a5\u7403\uff1b\u4f60\u9700\u8981\u9810\u6e2c\u5b83\u7684\u5230\u4f86\u3002[\u985e\u6bd4\uff1a\u64ca\u7403\u5c31\u50cf\u68d2\u7403\u4e2d\u7684\u64ca\u6253\uff0c\u6642\u9593\u81f3\u95dc\u91cd\u8981]\u5617\u8a66\u4e0d\u540c\u7684\u6642\u9593\u548c\u6ed1\u52d5\u89d2\u5ea6\uff0c\u89c0\u5bdf\u7403\u7684\u8ecc\u8de1\u3002\u7e3d\u4e4b\uff0c\u9ede\u64ca\u87a2\u5e55\u6253\u76f4\u7403\uff0c\u7a0d\u7a0d\u5411\u4e0a\u6ed1\u52d5\u87a2\u5e55\u6253\u9ad8\u9060\u7403\u3002[\u6280\u8853\u5206\u89e3]"}, {"question": "Doodle Cricket\u904a\u6232\u4e2d\u90a3\u4e9b\u7279\u6b8a\u7403\u7684\u51fa\u73fe\uff08\u74e2\u87f2\u7b49\uff09\u80cc\u5f8c\u6709\u4ec0\u9ebc\u542b\u7fa9\uff1f", "answer": "Doodle Cricket\u4e2d\u7684\u7279\u6b8a\u7403\uff0c\u4f8b\u5982\u74e2\u87f2\uff0c\u8868\u793a\u984d\u5916\u7a4d\u5206\u6a5f\u6703\u3002\u64ca\u4e2d\u74e2\u87f2\u6703\u7372\u5f97\u984d\u5916\u5f97\u5206\u3002\u9019\u662f\u4e00\u7a2e\u904a\u6232\u5e6b\u52a9\u73a9\u5bb6\u66f4\u5feb\u7372\u5f97\u66f4\u9ad8\u5206\u6578\u7684\u65b9\u5f0f\u3002\u5f8c\u7e8c\u95dc\u5361\u6703\u51fa\u73fe\u5404\u7a2e\u984d\u5916\u6548\u679c\u7684\u4e0d\u540c\u7403\u7a2e\u3002\u74e2\u87f2\u63d0\u4f9b\u984d\u5916\u5f97\u5206\uff1b\u53e6\u4e00\u7a2e\u53ef\u80fd\u589e\u5f37\u4f60\u7684\u64ca\u7403\u5a01\u529b\u3002\u53ef\u4ee5\u5c07\u74e2\u87f2\u8996\u70ba\u4e00\u7a2e\u52a0\u5f37\u9805\u76ee\uff0c\u70ba\u6e96\u78ba\u64ca\u7403\u63d0\u4f9b\u5373\u6642\u734e\u52f5\u3002\u59cb\u7d42\u5617\u8a66\u6700\u5927\u5316\u984d\u5916\u5206\u6578\u3002\u4f8b\u5982\uff0c\u5728\u9ad8\u58d3\u6642\u523b\uff0c\u512a\u5148\u64ca\u4e2d\u74e2\u87f2\u800c\u4e0d\u662f\u6a19\u6e96\u7684\u677f\u7403\uff0c\u4ee5\u5feb\u901f\u63d0\u5347\u5f97\u5206\u3002[\u734e\u52f5\u985e\u578b\u8868\u683c]"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u7684Doodle Cricket\u904a\u6232\u6709\u6642\u6703\u5ef6\u9072\u6216\u51cd\u7d50\uff1f\u6211\u8a72\u5982\u4f55\u6539\u5584\u6548\u80fd\uff1f", "answer": "Doodle Cricket\u4e2d\u7684\u5ef6\u9072\u6216\u51cd\u7d50\u4ee4\u4eba\u6cae\u55aa\u3002\u9019\u901a\u5e38\u662f\u7531\u65bc\u8a2d\u5099\u9650\u5236\u6216\u5f8c\u53f0\u61c9\u7528\u7a0b\u5f0f\u6d88\u8017\u8cc7\u6e90\u6240\u81f4\u3002\u95dc\u9589\u672a\u4f7f\u7528\u7684\u61c9\u7528\u7a0b\u5f0f\u4ee5\u91cb\u653e\u8a18\u61b6\u9ad4\u3002\u6b64\u5916\uff0c\u8acb\u78ba\u4fdd\u60a8\u7684\u8a2d\u5099\u4f5c\u696d\u7cfb\u7d71\u5df2\u66f4\u65b0\u3002\u6709\u6642\uff0c\u50c5\u50c5\u91cd\u65b0\u555f\u52d5\u904a\u6232\uff0c\u751a\u81f3\u91cd\u65b0\u555f\u52d5\u60a8\u7684\u8a2d\u5099\uff0c\u5c31\u53ef\u4ee5\u89e3\u6c7a\u66ab\u6642\u7684\u6548\u80fd\u554f\u984c\u3002\u4f5c\u70ba\u6e2c\u8a66\uff0c\u8acb\u78ba\u4fdd\u60a8\u6c92\u6709\u5728\u5f8c\u53f0\u4e0b\u8f09\u4efb\u4f55\u5167\u5bb9\u3002[\u6548\u80fd\u63d0\u793a\u6e05\u55ae]\u3002\u5982\u679c\u554f\u984c\u6301\u7e8c\u5b58\u5728\uff0c\u8acb\u8003\u616e\u5728\u6548\u80fd\u66f4\u597d\u7684\u88dd\u7f6e\u4e0a\u9032\u884c\u904a\u6232\u3002\u9019\u53ef\u80fd\u8207\u904a\u6232\u672c\u8eab\u6709\u95dc\uff0c\u4f46\u904a\u6232\u901a\u5e38\u904b\u884c\u826f\u597d\u3002[\u8cc7\u6e90\u5229\u7528\u6bd4\u8f03]"}, {"question": "\u4f5c\u70ba\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\uff0c\u6211\u53ef\u4ee5\u7528\u54ea\u4e9b\u7b56\u7565\u5728Doodle Cricket\u4e2d\u6301\u7e8c\u7372\u5f97\u9ad8\u5206\uff1f", "answer": "\u8981\u5728Doodle Cricket\u4e2d\u7372\u5f97\u6301\u7e8c\u9ad8\u5206\uff0c\u9700\u8981\u638c\u63e1\u6642\u9593\u548c\u64ca\u7403\u4f4d\u7f6e\u7684\u85dd\u8853\u3002\u6b65\u9a5f1\uff1a\u5b8c\u7f8e\u5730\u7df4\u7fd2\u64ca\u7403\u6642\u9593\uff1b\u4f60\u8d8a\u63a5\u8fd1\u300c\u5b8c\u7f8e\u300d\u64ca\u7403\uff0c\u4f60\u7372\u5f97\u7684\u5206\u6578\u5c31\u8d8a\u591a\u3002\u6b65\u9a5f2\uff1a\u89c0\u5bdf\u5834\u5730\u4f4d\u7f6e\uff0c\u5617\u8a66\u64ca\u7403\u5230\u5834\u5916\u91ce\u624b\u4e4b\u9593\u7684\u7a7a\u9699\u3002\u6b65\u9a5f3\uff1a\u7b56\u7565\u6027\u5730\u4f7f\u7528\u9ad8\u9060\u7403\u4ee5\u8de8\u8d8a\u5167\u91ce\u4e26\u7372\u5f97\u908a\u754c\u5f97\u5206\u3002\u7784\u6e96\u7a7a\u9699\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u6ce8\u610f\u5230\u4e2d\u5916\u91ce\u548c\u4e2d\u5916\u91ce\u4e4b\u9593\u6709\u7a7a\u9699\uff0c\u8acb\u5617\u8a66\u5c07\u64ca\u7403\u89d2\u5ea6\u7784\u6e96\u8a72\u8655\u3002\u6539\u8b8a\u60a8\u7684\u64ca\u7403\u9078\u64c7\uff0c\u8b93\u5c0d\u65b9\u5834\u5916\u91ce\u624b\u731c\u4e0d\u900f\u4f60\u7684\u7b56\u7565\u3002[\u7b56\u7565\u6d41\u7a0b\u5716]\u3002\u8acb\u8a18\u4f4f\uff0c\u719f\u7df4\u7a0b\u5ea6\u4f86\u81ea\u65bc\u7df4\u7fd2\u548c\u9069\u61c9\u904a\u6232\u7684\u8b8a\u5316\u3002"}, {"question": "Doodle Cricket\uff1a\u5982\u4f55\u5229\u7528AI\u5834\u5916\u91ce\u624b\u53ca\u5176\u4f4d\u7f6e\u8da8\u52e2\uff0c\u6700\u5927\u5316\u6211\u7684\u5f97\u5206\u6a5f\u6703\uff1f", "answer": "\u5728Doodle Cricket\u4e2d\u5229\u7528AI\u5834\u5916\u91ce\u624b\uff0c\u9700\u8981\u4e86\u89e3\u4ed6\u5011\u7684\u90e8\u7f72\u6a21\u5f0f\u4e26\u9810\u6e2c\u4ed6\u5011\u7684\u79fb\u52d5\u3002\u5728\u6bcf\u6b21\u6295\u7403\u524d\u89c0\u5bdf\u4ed6\u5011\u7684\u7ad9\u4f4d\uff0c\u4e26\u7784\u6e96\u7a7a\u9699\u3002AI\u50be\u5411\u65bc\u6839\u64da\u60a8\u4e4b\u524d\u7684\u64ca\u7403\u4f86\u8abf\u6574\u5834\u5916\u91ce\u624b\u7684\u90e8\u7f72\u4f4d\u7f6e\uff0c\u56e0\u6b64\u8acb\u7d93\u5e38\u66f4\u6539\u60a8\u7684\u64ca\u7403\u9078\u64c7\uff0c\u8b93\u4ed6\u5011\u731c\u4e0d\u900f\u3002\u5982\u679c\u4ed6\u5011\u5c07\u9663\u5bb9\u9663\u5217\u5728\u7403\u7684\u5de6\u908a\uff0c\u8acb\u7784\u6e96\u7403\u7684\u53f3\u908a\uff0c\u53cd\u4e4b\u4ea6\u7136\u3002\u4f8b\u5982\uff0c\u6ce8\u610f\u5230\u4ed6\u5011\u5728\u60a8\u64ca\u51fa\u908a\u754c\u7403\u5f8c\uff0c\u5982\u4f55\u8abf\u6574\u3002\u60a8\u53ef\u4ee5\u5229\u7528\u9019\u4e00\u9ede\u5728\u76f8\u53cd\u65b9\u5411\u5275\u9020\u5f97\u5206\u6a5f\u6703\u3002[AI\u884c\u70ba\u5716\u8868]\u3002\u60f3\u50cf\u4e00\u4e0b\u50cf\u662f\u570b\u969b\u8c61\u68cb\u904a\u6232\u3002"}, {"question": "Doodle Cricket\u904a\u6232\u4e2d\uff0c\u54ea\u4e9b\u9ad8\u7d1a\u6280\u5de7\uff08\u50cf\u300c\u5f37\u529b\u64ca\u7403\u300d\u6216\u6280\u5de7\u6027\u64ca\u7403\uff09\u662f\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u4f7f\u7528\u7684\uff1f", "answer": "\u96d6\u7136Doodle Cricket\u6c92\u6709\u660e\u78ba\u7684\u300c\u5f37\u529b\u64ca\u7403\u300d\uff0c\u4f46\u60a8\u53ef\u4ee5\u4f7f\u7528\u7cbe\u78ba\u7684\u6642\u9593\u548c\u4f4d\u7f6e\u6700\u5927\u5316\u60a8\u7684\u5f97\u5206\u6f5b\u529b\u3002\u4e00\u500b\u5b8c\u7f8e\u57f7\u884c\u7684\u9ad8\u9060\u7403\u53ef\u4ee5\u8d8a\u904e\u908a\u754c\u5f97\u52066\u5206\u3002\u638c\u63e1\u64ca\u7403\u7684\u6700\u4f73\u6642\u9593\u8996\u7a97\u3002\u5617\u8a66\u4e0d\u540c\u7684\u6ed1\u52d5\u89d2\u5ea6\uff0c\u5c07\u7403\u5c0e\u5f15\u5230\u5834\u5916\u91ce\u624b\u4e4b\u9593\u7684\u7a7a\u9699\uff0c\u5c31\u50cf\u300c\u6280\u5de7\u6027\u64ca\u7403\u300d\u4e00\u6a23\u3002\u7576\u7784\u6e96\u6700\u5927\u8ddd\u96e2\u6642\uff0c\u8acb\u5728\u64ca\u7403\u4e4b\u524d\u7a0d\u5fae\u5411\u4e0a\u6ed1\u52d5\u3002\u60f3\u50cf\u4e00\u4e0b\uff0c\u9019\u5c31\u50cf\u589e\u52a0\u63ee\u68d2\u7684\u529b\u91cf\u3002\u53ef\u4ee5\u57f7\u884c\u7cbe\u78ba\u8a08\u6642\u7684\u64ca\u7403\uff0c\u5f9e\u800c\u7372\u5f97\u6700\u5927\u529b\u91cf\u3002[\u9ad8\u7d1a\u6280\u5de7\u8def\u7dda\u5716]\u3002\u7df4\u7fd2\u4e0d\u540c\u7684\u6ed1\u52d5\u89d2\u5ea6\u548c\u6642\u9593\u3002"}, {"question": "\u6c7a\u5b9aDoodle Cricket\u904a\u6232\u5f15\u64ce\u4e2d\u5f97\u5206\u6578\u91cf\u7684\u57fa\u672c\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728Doodle Cricket\u4e2d\uff0c\u60a8\u7372\u5f97\u7684\u5f97\u5206\u6578\u53d6\u6c7a\u65bc\u60a8\u7684\u6642\u9593\u548c\u64ca\u7403\u4f4d\u7f6e\u7684\u7d50\u5408\u3002\u5b8c\u7f8e\u7684\u6642\u9593\u6703\u5c0e\u81f4\u66f4\u9577\u7684\u3001\u66f4\u5f37\u70c8\u7684\u64ca\u7403\uff0c\u589e\u52a0\u60a8\u7372\u5f97\u908a\u754c\u7403\uff08\u56db\u5206\u6216\u516d\u5206\uff09\u7684\u6a5f\u7387\u3002\u60a8\u8d8a\u63a5\u8fd1\u300c\u5b8c\u7f8e\u300d\u64ca\u7403\u8996\u7a97\uff0c\u60a8\u7372\u5f97\u7684\u5206\u6578\u5c31\u8d8a\u591a\u3002\u6b64\u5916\uff0c\u60a8\u64ca\u7403\u7684\u65b9\u5411\u8207\u5834\u5916\u91ce\u624b\u7684\u90e8\u7f72\u4f4d\u7f6e\u6709\u95dc\u3002\u64ca\u6253\u5230\u5834\u5916\u91ce\u624b\u4e4b\u9593\u7684\u7a7a\u9699\uff0c\u5c07\u6700\u5927\u5316\u60a8\u7684\u5f97\u5206\u6a5f\u6703\u3002\u5f97\u5206 = \u57fa\u672c\u503c * \u6642\u9593\u4e58\u6578 * \u4f4d\u7f6e\u4e58\u6578\u3002[\u6bd4\u8f03\u8dd1\u52d5\u5f97\u5206\u914d\u7f6e\u8868\u683c]\u3002\u6642\u9593\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "Doodle Cricket\u7684\u96e3\u5ea6\u63d0\u5347\u6a5f\u5236\u53ef\u4ee5\u66f4\u6df1\u5165\u5730\u5206\u89e3\u55ce\uff1f", "answer": "Doodle Cricket\u900f\u904e\u8abf\u6574\u5834\u5916\u91ce\u624b\u7684\u90e8\u7f72\u4f4d\u7f6e\u548c\u7403\u7684\u6295\u7403\u901f\u5ea6\u4f86\u8abf\u6574\u96e3\u5ea6\u3002\u96a8\u8457\u60a8\u5728\u904a\u6232\u7684\u9032\u5ea6\uff0cAI\u6703\u7b56\u7565\u6027\u5730\u90e8\u7f72\u5834\u5916\u91ce\u624b\uff0c\u4f7f\u5b83\u5011\u53ef\u4ee5\u8986\u84cb\u66f4\u5927\u7684\u7bc4\u570d\uff0c\u8b93\u60a8\u66f4\u96e3\u627e\u5230\u7a7a\u9699\u3002\u7403\u7684\u6295\u7403\u901f\u5ea6\u6703\u52a0\u5feb\uff0c\u9700\u8981\u66f4\u5feb\u7684\u53cd\u61c9\u6642\u9593\u548c\u66f4\u7cbe\u78ba\u7684\u6642\u9593\u3002\u9810\u671f\u66f4\u7dca\u6e4a\u7684\u5834\u5916\u91ce\u624b\u8986\u84cb\u7bc4\u570d\uff0c\u7a7a\u9699\u66f4\u5c11\u3002\u7403\u901f\u8abf\u6574\u78ba\u4fdd\u5373\u4f7f\u5c0d\u65bc\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u4f86\u8aaa\uff0c\u6311\u6230\u4ecd\u7136\u5b58\u5728\u3002\u96e3\u5ea6\u589e\u52a0\uff0c\u4f46\u5f97\u5206\u6a5f\u6703\u4ecd\u7136\u5b58\u5728\u3002[\u96e3\u5ea6\u66f2\u7dda\u5716]\u3002\u4fdd\u6301\u654f\u6377\u3002"}, {"question": "Doodle Cricket\u5728\u4e0d\u540c\u8a2d\u5099\u4e4b\u9593\u662f\u5426\u652f\u63f4\u8de8\u5e73\u53f0\u5132\u5b58\u6216\u6578\u64da\u8f49\u79fb\uff1f", "answer": "\u907a\u61be\u7684\u662f\uff0cDoodle Cricket\u901a\u5e38\u4e0d\u652f\u63f4\u8de8\u5e73\u53f0\u5132\u5b58\u6216\u4e0d\u540c\u8a2d\u5099\u4e4b\u9593\u7684\u8cc7\u6599\u8f49\u79fb\u3002\u60a8\u7684\u9032\u5ea6\u901a\u5e38\u5132\u5b58\u5728\u60a8\u6b63\u5728\u904a\u6232\u7684\u8a2d\u5099\u4e0a\u3002\u9019\u8868\u793a\u5982\u679c\u60a8\u5207\u63db\u5230\u65b0\u7684\u624b\u6a5f\u6216\u5e73\u677f\u96fb\u8166\uff0c\u60a8\u53ef\u80fd\u5fc5\u9808\u5f9e\u982d\u958b\u59cb\u73a9\u904a\u6232\u3002Doodle Cricket\u76ee\u524d\u6c92\u6709\u96f2\u7aef\u540c\u6b65\u529f\u80fd\u3002\u8acb\u5099\u4efd\u60a8\u7684\u904a\u6232\uff0c\u4f8b\u5982\u622a\u5716\u3002\u8acb\u8003\u616e\u8207\u5ba2\u670d\u806f\u7d61\uff0c\u63d0\u4f9b\u6539\u9032\u5efa\u8b70\u3002[\u96f2\u7aef\u5132\u5b58\u6bd4\u8f03\u8868\u683c]\u3002"}, {"question": "Doodle Cricket\u79d8\u5bc6\uff1aDoodle Cricket\u904a\u6232\u4e2d\u662f\u5426\u6709\u96b1\u85cf\u89d2\u8272\u6216\u5f69\u86cb\uff1f\u5982\u4f55\u89e3\u9396\uff1f", "answer": "\u96d6\u7136Doodle Cricket\u6c92\u6709\u50b3\u7d71\u610f\u7fa9\u4e0a\u7684\u53ef\u89e3\u9396\u89d2\u8272\uff0c\u4f46\u904a\u6232\u901a\u5e38\u6703\u51fa\u73fe\u4e3b\u984c\u5857\u9d09\uff0c\u5177\u6709\u7279\u6b8a\u7684\u8996\u89ba\u6548\u679c\u3002\u8acb\u7559\u610f\u7bc0\u65e5\u4e3b\u984c\u6216\u7279\u6b8a\u4e8b\u4ef6\u5857\u9d09\uff0c\u5b83\u5011\u53ef\u80fd\u63d0\u4f9b\u7368\u7279\u7684\u8996\u89ba\u7279\u8272\u3002\u8981\u627e\u5230\u9019\u4e9b\u5f69\u86cb\uff0c\u8acb\u5728\u91cd\u8981\u65e5\u671f\u6216\u7279\u6b8a\u6d3b\u52d5\u671f\u9593\u73a9\u904a\u6232\u3002Google\u5857\u9d09\u672c\u8eab\u6709\u6642\u6703\u6839\u64da\u7576\u524d\u4e16\u754c\u4e8b\u4ef6\u9032\u884c\u66f4\u6539\u3002\u5728\u4f8b\u5982\u677f\u7403\u4e16\u754c\u76c3\u7b49\u7279\u6b8a\u6d3b\u52d5\u671f\u9593\u73a9\u904a\u6232\uff0c\u5373\u53ef\u770b\u5230\u6b64\u985e\u5f69\u86cb\u3002[\u5df2\u77e5\u5177\u6709\u96b1\u85cf\u542b\u7fa9\u7684\u5857\u9d09\u6e05\u55ae]\u3002\u73a9\u5f97\u958b\u5fc3\uff01"}]
[{"question": "\u5982\u4f55\u9032\u884c\u521d\u5b78\u8005\u5728Doodle Cricket\u7684\u57fa\u672c\u64ca\u7403\uff1f", "answer": "\u5728Doodle Cricket\u4e2d\u9032\u884c\u57fa\u672c\u64ca\u7403\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u7b49\u5f85\u7403\u88ab\u6295\u64f2\u3002\u6b65\u9a5f2\uff1a\u7576\u7403\u4f4d\u65bc\u64ca\u7403\u5340\u57df\u6642\uff0c\u9ede\u64ca\u87a2\u5e55\u3002\u6b65\u9a5f3\uff1a\u8abf\u6574\u64ca\u7403\u6642\u9593\u4ee5\u6e96\u78ba\u64ca\u4e2d\u7403\u3002\u4f8b\u5982\uff0c\u9ede\u64ca\u904e\u65e9\u6216\u904e\u665a\u53ef\u80fd\u6703\u5c0e\u81f4\u6f0f\u63a5\u6216\u5f31\u64ca\u3002\u4f7f\u7528\u6d41\u7a0b\u5716\u53ef\u8996\u5316\u64ca\u7403\u6642\u9593\u5340\u57df\u4ee5\u66f4\u597d\u5730\u7406\u89e3\u3002"}, {"question": "\u6211\u5728Doodle Cricket\u4e2d\u9700\u8981\u638c\u63e1\u54ea\u4e9b\u4e3b\u8981\u63a7\u5236\u9805\uff1f", "answer": "Doodle Cricket\u4e2d\u7684\u4e3b\u8981\u63a7\u5236\u9805\u5305\u62ec\uff1a1) \u8abf\u6574\u9ede\u64ca\u6642\u9593\u4ee5\u64ca\u7403\uff0c2) \u4f7f\u7528\u6ed1\u52d5\u9032\u884c\u5f37\u529b\u64ca\u7403\uff0c\u4ee5\u53ca3) \u8abf\u6574\u4f60\u7684\u59ff\u52e2\u4ee5\u61c9\u5c0d\u4e0d\u540c\u985e\u578b\u7684\u6295\u7403\u3002\u4f8b\u5982\uff0c\u5411\u4e0a\u6ed1\u52d5\u53ef\u4ee5\u7522\u751f\u9ad8\u98db\u7403\u3002\u914d\u7f6e\u8868\u53ef\u4ee5\u5e6b\u52a9\u6bd4\u8f03\u4e0d\u540c\u6ed1\u52d5\u65b9\u5411\u7684\u6548\u679c\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u6642\u9593\u63a7\u5236\u5728Doodle Cricket\u4e2d\u81f3\u95dc\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u6539\u9032\uff1f", "answer": "\u6642\u9593\u63a7\u5236\u5728Doodle Cricket\u4e2d\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6c7a\u5b9a\u4e86\u4f60\u7684\u64ca\u7403\u7cbe\u6e96\u5ea6\u548c\u529b\u91cf\u3002\u70ba\u4e86\u6539\u9032\u6642\u9593\u63a7\u5236\uff0c\u8acb\u5b9a\u671f\u7df4\u7fd2\uff0c\u5c08\u6ce8\u65bc\u7403\u7684\u8ecc\u8de1\uff0c\u4e26\u4f7f\u7528\u7bc0\u62cd\u5668\u61c9\u7528\u7a0b\u5f0f\u4f86\u958b\u767c\u7bc0\u594f\u3002\u4f8b\u5982\uff0c\u5728\u7403\u5f27\u9802\u64ca\u7403\u53ef\u4ee5\u6700\u5927\u5316\u4f60\u7684\u5f97\u5206\u3002\u4f7f\u7528\u6bd4\u8f03\u5716\u8868\u4f86\u986f\u793a\u4e0d\u540c\u6642\u9593\u63a7\u5236\u5c0d\u64ca\u7403\u7d50\u679c\u7684\u5f71\u97ff\u3002"}, {"question": "\u5728\u73a9Doodle Cricket 100\u5c0f\u6642\u5f8c\uff0c\u54ea\u4e9b\u9032\u968e\u7b56\u7565\u53ef\u4ee5\u5e6b\u52a9\u6211\u7372\u5f97\u66f4\u9ad8\u7684\u5f97\u5206\uff1f", "answer": "\u73a9\u4e86100\u5c0f\u6642\u5f8c\uff0c\u9032\u968e\u7b56\u7565\u5305\u62ec\uff1a\u6b65\u9a5f1\uff1a\u7814\u7a76\u6295\u7403\u54e1\u7684\u6295\u7403\u6a21\u5f0f\u4ee5\u9810\u6e2c\u6295\u7403\u3002\u6b65\u9a5f2\uff1a\u7b56\u7565\u6027\u5730\u4f7f\u7528\u5f37\u529b\u64ca\u7403\u4f86\u6700\u5927\u5316\u5f97\u5206\u3002\u6b65\u9a5f3\uff1a\u638c\u63e1\u9632\u5b88\u64ca\u7403\u4ee5\u907f\u514d\u88ab\u6dd8\u6c70\u3002\u4f8b\u5982\uff0c\u53ca\u65e9\u8fa8\u8a8d\u65cb\u8f49\u7403\u7684\u6295\u7403\u53ef\u4ee5\u5e6b\u52a9\u4f60\u8abf\u6574\u4f60\u7684\u64ca\u7403\u3002\u6d41\u7a0b\u5716\u53ef\u4ee5\u8aaa\u660e\u61c9\u5c0d\u4e0d\u540c\u6295\u7403\u7684\u6c7a\u7b56\u904e\u7a0b\u3002"}, {"question": "\u5982\u4f55\u5728Doodle Cricket\u4e2d\u6709\u6548\u5730\u53cd\u5236\u65cb\u8f49\u6295\u7403\uff1f", "answer": "\u8981\u6709\u6548\u53cd\u5236\u65cb\u8f49\u6295\u7403\uff1a\u6b65\u9a5f1\uff1a\u4ed4\u7d30\u89c0\u5bdf\u7403\u4ee5\u5075\u6e2c\u65cb\u8f49\u65b9\u5411\u3002\u6b65\u9a5f2\uff1a\u8abf\u6574\u4f60\u7684\u64ca\u7403\u6642\u9593\u4ee5\u88dc\u511f\u65cb\u8f49\u3002\u6b65\u9a5f3\uff1a\u5728\u4e0d\u78ba\u5b9a\u6642\u4f7f\u7528\u9632\u5b88\u64ca\u7403\u3002\u4f8b\u5982\uff0c\u5c0d\u6297\u817f\u90e8\u65cb\u8f49\u7403\u6642\uff0c\u5ef6\u9072\u64ca\u7403\u53ef\u4ee5\u964d\u4f4e\u88ab\u6dd8\u6c70\u7684\u98a8\u96aa\u3002\u914d\u7f6e\u8868\u53ef\u4ee5\u5e6b\u52a9\u5c07\u65cb\u8f49\u985e\u578b\u8207\u63a8\u85a6\u7684\u64ca\u7403\u65b9\u5f0f\u5c0d\u61c9\u3002"}, {"question": "\u5982\u4f55\u5728Doodle Cricket\u4e2d\u7ba1\u7406\u6211\u7684\u5c40\u6578\u4ee5\u7372\u5f97\u9ad8\u5206\uff1f", "answer": "\u8981\u7ba1\u7406\u4f60\u7684\u5c40\u6578\u4ee5\u7372\u5f97\u9ad8\u5206\uff1a\u6b65\u9a5f1\uff1a\u8b39\u614e\u958b\u59cb\u5efa\u7acb\u57fa\u790e\u3002\u6b65\u9a5f2\uff1a\u5728\u4e2d\u5c40\u52a0\u901f\u5f97\u5206\u3002\u6b65\u9a5f3\uff1a\u4ee5\u7a4d\u6975\u7684\u64ca\u7403\u6536\u5c3e\u3002\u4f8b\u5982\uff0c\u5c07\u5f37\u529b\u64ca\u7403\u4fdd\u7559\u5728\u6700\u5f8c\u5e7e\u5c40\u53ef\u4ee5\u6700\u5927\u5316\u4f60\u7684\u7e3d\u5206\u3002\u6bd4\u8f03\u5716\u8868\u53ef\u4ee5\u986f\u793a\u904a\u6232\u4e0d\u540c\u968e\u6bb5\u7684\u5f97\u5206\u5206\u914d\u3002"}, {"question": "Doodle Cricket\u4e2d\u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u4ee5\u53ca\u5982\u4f55\u512a\u5316\u5b83\uff1f", "answer": "Doodle Cricket\u7684\u8a08\u5206\u7cfb\u7d71\u734e\u52f5\u7cbe\u6e96\u4e14\u5f37\u529b\u7684\u64ca\u7403\u3002\u70ba\u4e86\u512a\u5316\u8a08\u5206\uff0c\u5c08\u6ce8\u65bc\u64ca\u4e2d\u7403\u7684\u751c\u871c\u9ede\uff0c\u4e26\u4f7f\u7528\u5f37\u529b\u64ca\u7403\u7372\u5f97\u908a\u754c\u5f97\u5206\u3002\u4f8b\u5982\uff0c\u5728\u7403\u62cd\u4e2d\u5fc3\u6e96\u78ba\u64ca\u4e2d\u7684\u597d\u7403\u53ef\u4ee5\u5f97\u5230\u5168\u58d8\u6253\u3002\u4f7f\u7528\u6d41\u7a0b\u5716\u4f86\u89e3\u91cb\u57fa\u65bc\u64ca\u7403\u8cea\u91cf\u7684\u8a08\u5206\u6a5f\u5236\u3002"}, {"question": "Doodle Cricket\u4e2d\u5f37\u529b\u64ca\u7403\u7684\u5e95\u5c64\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "Doodle Cricket\u4e2d\u7684\u5f37\u529b\u64ca\u7403\u53d7\u6ed1\u52d5\u901f\u5ea6\u3001\u89d2\u5ea6\u548c\u6642\u9593\u7b49\u6a5f\u5236\u63a7\u5236\u3002\u4f8b\u5982\uff0c\u5feb\u901f\u5411\u4e0a\u6ed1\u52d5\u53ef\u4ee5\u7522\u751f\u9ad8\u98db\u5168\u58d8\u6253\u3002\u9019\u4e9b\u64ca\u7403\u6703\u6d88\u8017\u8010\u529b\uff0c\u56e0\u6b64\u8acb\u8b39\u614e\u4f7f\u7528\u3002\u914d\u7f6e\u8868\u53ef\u4ee5\u8a73\u7d30\u8aaa\u660e\u4e0d\u540c\u6ed1\u52d5\u53c3\u6578\u5c0d\u64ca\u7403\u7d50\u679c\u7684\u5f71\u97ff\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5728\u4e0d\u540c\u88dd\u7f6e\u9593\u50b3\u8f38Doodle Cricket\u7684\u9032\u5ea6\u55ce\uff1f\u5982\u679c\u53ef\u4ee5\uff0c\u5982\u4f55\u64cd\u4f5c\uff1f", "answer": "\u662f\u7684\uff0c\u60a8\u53ef\u4ee5\u900f\u904e\u5c07\u904a\u6232\u5e33\u6236\u9023\u7d50\u5230\u793e\u4ea4\u5a92\u9ad4\u6216\u96fb\u5b50\u90f5\u4ef6 ID \u4f86\u5728\u4e0d\u540c\u88dd\u7f6e\u4e4b\u9593\u50b3\u8f38 Doodle Cricket \u7684\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u76f8\u540c\u7684\u6191\u8b49\u767b\u5165\u65b0\u7684\u88dd\u7f6e\u6703\u540c\u6b65\u60a8\u7684\u8cc7\u6599\u3002\u4f7f\u7528\u6d41\u7a0b\u5716\u4f86\u8aaa\u660e\u5e33\u6236\u9023\u7d50\u548c\u8cc7\u6599\u50b3\u8f38\u6b65\u9a5f\u3002"}, {"question": "Doodle Cricket\u4e2d\u662f\u5426\u6709\u4efb\u4f55\u96b1\u85cf\u7684\u5f69\u86cb\u6216\u79d8\u5bc6\uff1f", "answer": "Doodle Cricket\u5305\u542b\u96b1\u85cf\u7684\u5f69\u86cb\uff0c\u4f8b\u5982\u7279\u6b8a\u53ef\u89e3\u9396\u7684\u7403\u68d2\u6216\u5728\u9054\u6210\u91cc\u7a0b\u7891\u6642\u7372\u5f97\u7368\u7279\u7684\u6176\u795d\u6d3b\u52d5\u3002\u4f8b\u5982\uff0c\u5728\u55ae\u4e00\u904a\u6232\u4e2d\u7372\u5f97 100 \u5206\u53ef\u80fd\u89e3\u9396\u91d1\u68d2\u3002\u4f7f\u7528\u6bd4\u8f03\u5716\u8868\u4f86\u5217\u51fa\u5df2\u77e5\u7684\u5f69\u86cb\u53ca\u5176\u89e3\u9396\u689d\u4ef6\u3002"}]
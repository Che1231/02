[{"question": "\ub3c4\ub4e4 \ud06c\ub9ac\ucf13 \ucd08\ubcf4\uc790\uac00 \uae30\ubcf8\uc801\uc778 \uc0f7\uc744 \uc5b4\ub5bb\uac8c \uc218\ud589\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub3c4\ub4e4 \ud06c\ub9ac\ucf13\uc5d0\uc11c \uae30\ubcf8\uc801\uc778 \uc0f7\uc744 \uc218\ud589\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: \ub2e8\uacc4 1: \uacf5\uc774 \ub358\uc838\uc9c0\ub294 \uac83\uc744 \uae30\ub2e4\ub9bd\ub2c8\ub2e4. \ub2e8\uacc4 2: \uacf5\uc774 \ud0c0\uaca9 \uad6c\uc5ed\uc5d0 \uc788\ub294 \ub3d9\uc548 \ud654\uba74\uc744 \ud0ed\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uacf5\uc744 \uc815\ud655\ud558\uac8c \uce58\uae30 \uc704\ud574 \ud0c0\uc774\ubc0d\uc744 \uc870\uc815\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub108\ubb34 \uc77c\ucc0d \ub610\ub294 \ub108\ubb34 \ub2a6\uac8c \ud0ed\ud558\uba74 \uc2e4\ud328\ud558\uac70\ub098 \uc57d\ud55c \uc0f7\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud0c0\uc774\ubc0d \uad6c\uc5ed\uc744 \uc2dc\uac01\ud654\ud558\ub294 \ud50c\ub85c\uc6b0\ucc28\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc774\ud574\ub97c \ub192\uc774\uc138\uc694."}, {"question": "\ub3c4\ub4e4 \ud06c\ub9ac\ucf13\uc5d0\uc11c \uc219\ub2ec\ud574\uc57c \ud558\ub294 \uc8fc\uc694 \ucee8\ud2b8\ub864\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub3c4\ub4e4 \ud06c\ub9ac\ucf13\uc758 \uc8fc\uc694 \ucee8\ud2b8\ub864\ub85c\ub294 1) \uc0f7\uc744 \uc704\ud55c \ud0ed \ud0c0\uc774\ubc0d, 2) \ud30c\uc6cc \uc0f7\uc744 \uc704\ud55c \uc2a4\uc640\uc774\ud504, 3) \uc11c\ub85c \ub2e4\ub978 \uc885\ub958\uc758 \ubcfc\ub9c1\uc5d0 \ub9de\ucdb0 \uc790\uc138\ub97c \uc870\uc815\ud558\ub294 \uac83\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc704\ucabd\uc73c\ub85c \uc2a4\uc640\uc774\ud504\ud558\uba74 \ub192\uc774 \ub72c \uc0f7\uc744 \ub0a0\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\uc591\ud55c \uc2a4\uc640\uc774\ud504 \ubc29\ud5a5\uc758 \ud6a8\uacfc\ub97c \ube44\uad50\ud558\ub294 \uad6c\uc131\ud45c\uac00 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub3c4\ub4e4 \ud06c\ub9ac\ucf13\uc5d0\uc11c \ud0c0\uc774\ubc0d\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\ub098\uc694?", "answer": "\ub3c4\ub4e4 \ud06c\ub9ac\ucf13\uc5d0\uc11c \ud0c0\uc774\ubc0d\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \uc0f7\uc758 \uc815\ud655\uc131\uacfc \ud30c\uc6cc\ub97c \uacb0\uc815\ud558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \ud0c0\uc774\ubc0d\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub824\uba74 \uc815\uae30\uc801\uc73c\ub85c \uc5f0\uc2b5\ud558\uc5ec \uacf5\uc758 \uada4\uc801\uc5d0 \uc9d1\uc911\ud558\uace0 \uba54\ud2b8\ub85c\ub188 \uc571\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub9ac\ub4ec\uc744 \uac1c\ubc1c\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uacf5\uc774 \uace1\uc120\uc758 \uaf2d\ub300\uae30\uc5d0 \uc788\uc744 \ub54c \uacf5\uc744 \uce58\uba74 \uc810\uc218\ub97c \uadf9\ub300\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc11c\ub85c \ub2e4\ub978 \ud0c0\uc774\ubc0d\uc774 \uc0f7 \uacb0\uacfc\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc744 \ubcf4\uc5ec\uc8fc\ub294 \ube44\uad50 \ucc28\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc138\uc694."}, {"question": "100\uc2dc\uac04 \uc774\uc0c1 \ub3c4\ub4e4 \ud06c\ub9ac\ucf13\uc744 \ud50c\ub808\uc774\ud55c \ud6c4 \ub354 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\ub294 \uace0\uae09 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "100\uc2dc\uac04 \uc774\uc0c1 \ud50c\ub808\uc774\ud55c \ud6c4 \uace0\uae09 \uc804\ub7b5\uc73c\ub85c\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: \ub2e8\uacc4 1: \ud22c\uad6c \ud328\ud134\uc744 \uc5f0\uad6c\ud558\uc5ec \uacf5\uc744 \uc608\uce21\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ud30c\uc6cc \uc0f7\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc5ec \ub4dd\uc810\uc744 \uadf9\ub300\ud654\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc544\uc6c3\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uc218\ube44 \uc0f7\uc744 \uc219\ub2ec\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc2a4\ud53c\ub108\uc758 \uacf5\uc744 \uc77c\ucc0d \uc778\uc2dd\ud558\uba74 \uc0f7\uc744 \uc870\uc815\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\uc591\ud55c \uacf5\uc5d0 \ub300\ud55c \uc758\uc0ac \uacb0\uc815 \uacfc\uc815\uc744 \ubcf4\uc5ec\uc8fc\ub294 \ud50c\ub85c\uc6b0\ucc28\ud2b8\ub97c \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub3c4\ub4e4 \ud06c\ub9ac\ucf13\uc5d0\uc11c \uc2a4\ud540 \ubcfc\ub9c1\uc5d0 \ud6a8\uacfc\uc801\uc73c\ub85c \ub300\uc751\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc2a4\ud540 \ubcfc\ub9c1\uc5d0 \ud6a8\uacfc\uc801\uc73c\ub85c \ub300\uc751\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: \ub2e8\uacc4 1: \uacf5\uc758 \ud68c\uc804 \ubc29\ud5a5\uc744 \uac10\uc9c0\ud558\uae30 \uc704\ud574 \uacf5\uc744 \uc8fc\uc758 \uae4a\uac8c \uad00\ucc30\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ud68c\uc804\uc744 \ubcf4\uc644\ud558\uae30 \uc704\ud574 \uc0f7 \ud0c0\uc774\ubc0d\uc744 \uc870\uc815\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ud655\uc2e0\uc774 \uc11c\uc9c0 \uc54a\uc744 \ub54c\ub294 \uc218\ube44 \uc0f7\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\uadf8 \uc2a4\ud53c\ub108\uc5d0 \ub300\ud56d\ud558\uc5ec \ub098\uc911\uc5d0 \uacf5\uc744 \uce58\uba74 \uc544\uc6c3\ub420 \uc704\ud5d8\uc744 \uc904\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud68c\uc804 \uc720\ud615\uc744 \uad8c\uc7a5 \uc0f7\uc5d0 \ub9e4\ud551\ud558\ub294 \uad6c\uc131\ud45c\uac00 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub3c4\ub4e4 \ud06c\ub9ac\ucf13\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc704\ud574 \uc774\ub2dd\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub192\uc740 \uc810\uc218\ub97c \uc704\ud574 \uc774\ub2dd\uc744 \uad00\ub9ac\ud558\ub824\uba74 \ub2e4\uc74c\uacfc \uac19\uc774 \ud558\uc138\uc694: \ub2e8\uacc4 1: \uc2e0\uc911\ud558\uac8c \uc2dc\uc791\ud558\uc5ec \uae30\ubc18\uc744 \uad6c\ucd95\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc911\uac04 \uc624\ubc84\uc5d0\uc11c \uc810\uc218\ub97c \uac00\uc18d\ud654\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uacf5\uaca9\uc801\uc778 \uc0f7\uc73c\ub85c \ub9c8\ubb34\ub9ac\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub9c8\uc9c0\ub9c9 \uc624\ubc84\uc5d0\uc11c \ud30c\uc6cc \uc0f7\uc744 \ub0a8\uaca8\ub450\uba74 \ucd1d\uc810\uc744 \uadf9\ub300\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784\uc758 \uc11c\ub85c \ub2e4\ub978 \ub2e8\uacc4\uc5d0\uc11c\uc758 \ub4dd\uc810 \ubd84\ud3ec\ub97c \ubcf4\uc5ec\uc8fc\ub294 \ube44\uad50 \ucc28\ud2b8\ub97c \ud65c\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub3c4\ub4e4 \ud06c\ub9ac\ucf13\uc758 \ub4dd\uc810 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub3c4\ub4e4 \ud06c\ub9ac\ucf13 \ub4dd\uc810 \uc2dc\uc2a4\ud15c\uc740 \uc815\ud655\ud558\uace0 \uac15\ub825\ud55c \uc0f7\uc744 \ubcf4\uc0c1\ud569\ub2c8\ub2e4. \ub4dd\uc810\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uacf5\uc744 \uc2a4\uc704\ud2b8 \uc2a4\ud31f\uc5d0 \ub9de\ucd94\uace0 \uacbd\uacc4\uad6c\uac04\uc744 \uc704\ud55c \ud30c\uc6cc \uc0f7\uc744 \uc0ac\uc6a9\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc798 \ud0c0\uc774\ubc0d\uc774 \ub9de\ub294 \uc0f7\uc740 6\uc810\uc744 \ub0bc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc0f7\uc758 \uc9c8\uc5d0 \ub530\ub77c \ub4dd\uc810 \uba54\ucee4\ub2c8\uc998\uc744 \uc124\uba85\ud558\ub294 \ud50c\ub85c\uc6b0\ucc28\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc138\uc694."}, {"question": "\ub3c4\ub4e4 \ud06c\ub9ac\ucf13\uc5d0\uc11c \ud30c\uc6cc \uc0f7\uc758 \uae30\ubcf8\uc801\uc778 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub3c4\ub4e4 \ud06c\ub9ac\ucf13\uc758 \ud30c\uc6cc \uc0f7\uc740 \uc2a4\uc640\uc774\ud504 \uc18d\ub3c4, \uac01\ub3c4 \ubc0f \ud0c0\uc774\ubc0d\uacfc \uac19\uc740 \uba54\ucee4\ub2c8\uc998\uc5d0 \uc758\ud574 \uc9c0\ubc30\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ube60\ub978 \uc0c1\ud5a5 \uc2a4\uc640\uc774\ud504\ub294 \ub192\uc774 \ub72c 6\uc810\uc744 \ub0bc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc0f7\uc740 \uccb4\ub825\uc744 \uc18c\ubaa8\ud558\ubbc0\ub85c \uc2e0\uc911\ud558\uac8c \uc0ac\uc6a9\ud558\uc138\uc694. \ub2e4\uc591\ud55c \uc2a4\uc640\uc774\ud504 \ub9e4\uac1c\ubcc0\uc218\uac00 \uc0f7 \uacb0\uacfc\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc744 \uc790\uc138\ud788 \uc124\uba85\ud558\ub294 \uad6c\uc131\ud45c\ub97c \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub3c4\ub4e4 \ud06c\ub9ac\ucf13\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\ub978 \uae30\uae30\ub85c \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694? \uc5b4\ub5bb\uac8c \uac00\ub2a5\ud55c\uac00\uc694?", "answer": "\ub124, \uc18c\uc15c \ubbf8\ub514\uc5b4 \ub610\ub294 \uc774\uba54\uc77c ID\uc5d0 \uac8c\uc784 \uacc4\uc815\uc744 \uc5f0\uacb0\ud558\uc5ec \ub3c4\ub4e4 \ud06c\ub9ac\ucf13 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\ub978 \uae30\uae30\ub85c \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub3d9\uc77c\ud55c \uc790\uaca9 \uc99d\uba85\uc73c\ub85c \uc0c8\ub85c\uc6b4 \uae30\uae30\uc5d0\uc11c \ub85c\uadf8\uc778\ud558\uba74 \ub370\uc774\ud130\uac00 \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. \uacc4\uc815 \uc5f0\uacb0 \ubc0f \ub370\uc774\ud130 \uc804\uc1a1 \ub2e8\uacc4\ub97c \ubcf4\uc5ec\uc8fc\ub294 \ud50c\ub85c\uc6b0\ucc28\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc138\uc694."}, {"question": "\ub3c4\ub4e4 \ud06c\ub9ac\ucf13\uc5d0 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8 \ub610\ub294 \ube44\ubc00\uc774 \uc788\ub098\uc694?", "answer": "\ub3c4\ub4e4 \ud06c\ub9ac\ucf13\uc5d0\ub294 \ud2b9\ubcc4\ud55c \uc7a0\uae08 \ud574\uc81c \uac00\ub2a5\ud55c \ubc30\ud2b8\ub098 \uc774\uc815\ud45c \ub2ec\uc131\uc744 \uc704\ud55c \ub3c5\ud2b9\ud55c \ucd95\ud558 \ud589\uc0ac\uc640 \uac19\uc740 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud55c \ubc88\uc758 \uac8c\uc784\uc5d0\uc11c 100\uc810\uc744 \ub4dd\uc810\ud558\uba74 \ud669\uae08\uc0c9 \ubc30\ud2b8\uac00 \uc7a0\uae08 \ud574\uc81c\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc54c\ub824\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uc640 \ud574\uc81c \uc870\uac74\uc744 \ub098\uc5f4\ud558\ub294 \ube44\uad50 \ucc28\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc138\uc694."}]
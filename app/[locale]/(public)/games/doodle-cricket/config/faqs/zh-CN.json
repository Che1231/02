[{"question": "Doodle Cricket 101\uff1a\u65b0\u624b\u5982\u4f55\u6709\u6548\u5730\u6325\u68d2\u51fb\u7403\uff1f", "answer": "\u5bf9\u4e8e\u65b0\u624b\u6765\u8bf4\uff0c\u5728Doodle Cricket\u4e2d\u6709\u6548\u6325\u68d2\u51fb\u7403\u7684\u5173\u952e\u5728\u4e8e\u65f6\u673a\u548c\u7784\u51c6\u3002\u5f53\u677f\u7403\u5728\u53ef\u51fb\u8303\u56f4\u5185\u65f6\uff0c\u8f7b\u89e6\u5c4f\u5e55\u3002\u8981\u51fb\u51fa\u4e00\u76f4\u7ebf\u7403\uff0c\u8bf7\u5728\u7403\u4f4d\u4e8e\u51fb\u7403\u8005\u6b63\u524d\u65b9\u65f6\u8f7b\u89e6\u5c4f\u5e55\u3002\u8981\u51fb\u51fa\u4e00\u8bb0\u9ad8\u8fdc\u7403\uff0c\u8bf7\u5728\u8f7b\u89e6\u5c4f\u5e55\u7684\u540c\u65f6\u7565\u5fae\u5411\u4e0a\u6ed1\u52a8\u3002\u5728\u521d\u59cb\u7ea7\u522b\u7ec3\u4e60\uff0c\u638c\u63e1\u65f6\u673a\u975e\u5e38\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u4e13\u6ce8\u4e8e\u51fb\u4e2d\u74e2\u866b\u4ee5\u83b7\u5f97\u989d\u5916\u5206\u6570\u3002\u65f6\u673a\u81f3\u5173\u91cd\u8981\uff01\u60f3\u60f3\u770b\uff0c\u8fd9\u5c31\u50cf\u63a5\u7403\uff1b\u4f60\u9700\u8981\u9884\u6d4b\u7403\u7684\u5230\u8fbe\u65f6\u95f4\u3002[\u7c7b\u6bd4\uff1a\u51fb\u7403\u5c31\u50cf\u68d2\u7403\u6bd4\u8d5b\u4e2d\u7684\u51fb\u7403\uff0c\u65f6\u673a\u81f3\u5173\u91cd\u8981]\u3002\u5c1d\u8bd5\u4e0d\u540c\u7684\u65f6\u673a\u548c\u6ed1\u52a8\u89d2\u5ea6\uff0c\u89c2\u5bdf\u7403\u7684\u8f68\u8ff9\u3002\u603b\u4e4b\uff0c\u8f7b\u89e6\u5c4f\u5e55\u51fb\u51fa\u76f4\u7ebf\u7403\uff0c\u8f7b\u89e6\u5c4f\u5e55\u5e76\u7565\u5fae\u5411\u4e0a\u6ed1\u52a8\u51fb\u51fa\u9ad8\u8fdc\u7403\u3002[\u6280\u672f\u5206\u89e3]"}, {"question": "Doodle Cricket\u6e38\u620f\u4e2d\u7279\u6b8a\u677f\u7403\uff08\u74e2\u866b\u7b49\uff09\u51fa\u73b0\u7684\u610f\u4e49\u662f\u4ec0\u4e48\uff1f", "answer": "Doodle Cricket\u4e2d\u7279\u6b8a\u677f\u7403\u7684\u51fa\u73b0\uff0c\u4f8b\u5982\u74e2\u866b\uff0c\u8868\u793a\u989d\u5916\u5f97\u5206\u7684\u673a\u4f1a\u3002\u51fb\u4e2d\u74e2\u866b\u53ef\u4ee5\u83b7\u5f97\u989d\u5916\u5206\u6570\u3002\u6e38\u620f\u901a\u8fc7\u8fd9\u79cd\u65b9\u5f0f\u5e2e\u52a9\u73a9\u5bb6\u66f4\u5feb\u5730\u5f97\u5206\u3002\u540e\u7eed\u5173\u5361\u4e2d\u4f1a\u51fa\u73b0\u5404\u79cd\u989d\u5916\u6548\u679c\u7684\u7279\u6b8a\u677f\u7403\u3002\u74e2\u866b\u63d0\u4f9b\u989d\u5916\u5206\u6570\uff1b\u53e6\u4e00\u4e9b\u677f\u7403\u53ef\u80fd\u4f1a\u589e\u5f3a\u4f60\u7684\u51fb\u7403\u5a01\u529b\u3002\u53ef\u4ee5\u628a\u74e2\u866b\u60f3\u8c61\u6210\u4e00\u79cd\u9053\u5177\uff0c\u4e3a\u51c6\u786e\u7684\u51fb\u7403\u63d0\u4f9b\u5373\u65f6\u5956\u52b1\u3002\u59cb\u7ec8\u5c1d\u8bd5\u6700\u5927\u5316\u989d\u5916\u5206\u6570\u3002\u4f8b\u5982\uff0c\u5728\u5173\u952e\u65f6\u523b\uff0c\u4f18\u5148\u51fb\u4e2d\u74e2\u866b\u800c\u4e0d\u662f\u666e\u901a\u677f\u7403\uff0c\u4ee5\u5feb\u901f\u63d0\u5347\u5206\u6570\u3002[\u5956\u52b1\u7c7b\u578b\u8868]"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u7684Doodle Cricket\u6e38\u620f\u6709\u65f6\u4f1a\u5ef6\u8fdf\u6216\u51bb\u7ed3\uff1f\u5982\u4f55\u63d0\u9ad8\u6027\u80fd\uff1f", "answer": "Doodle Cricket\u6e38\u620f\u4e2d\u7684\u5ef6\u8fdf\u6216\u51bb\u7ed3\u4ee4\u4eba\u6cae\u4e27\u3002\u8fd9\u901a\u5e38\u662f\u7531\u4e8e\u8bbe\u5907\u9650\u5236\u6216\u540e\u53f0\u5e94\u7528\u6d88\u8017\u8d44\u6e90\u9020\u6210\u7684\u3002\u5173\u95ed\u4e0d\u4f7f\u7528\u7684\u5e94\u7528\u7a0b\u5e8f\u4ee5\u91ca\u653e\u5185\u5b58\u3002\u6b64\u5916\uff0c\u786e\u4fdd\u4f60\u7684\u8bbe\u5907\u64cd\u4f5c\u7cfb\u7edf\u5df2\u66f4\u65b0\u3002\u6709\u65f6\uff0c\u53ea\u9700\u91cd\u65b0\u542f\u52a8\u6e38\u620f\uff0c\u751a\u81f3\u91cd\u65b0\u542f\u52a8\u8bbe\u5907\uff0c\u5373\u53ef\u89e3\u51b3\u6682\u65f6\u7684\u6027\u80fd\u95ee\u9898\u3002\u4f5c\u4e3a\u6d4b\u8bd5\uff0c\u8bf7\u786e\u4fdd\u4f60\u6ca1\u6709\u5728\u540e\u53f0\u4e0b\u8f7d\u4efb\u4f55\u5185\u5bb9\u3002[\u6027\u80fd\u63d0\u793a\u6e05\u5355]\u3002\u5982\u679c\u95ee\u9898\u4ecd\u7136\u5b58\u5728\uff0c\u8bf7\u8003\u8651\u5728\u6027\u80fd\u66f4\u597d\u7684\u8bbe\u5907\u4e0a\u73a9\u6e38\u620f\u3002\u8fd9\u53ef\u80fd\u4e0e\u6e38\u620f\u672c\u8eab\u6709\u5173\uff0c\u4f46\u6e38\u620f\u901a\u5e38\u8fd0\u884c\u826f\u597d\u3002[\u8d44\u6e90\u5229\u7528\u6bd4\u8f83]"}, {"question": "\u4f5c\u4e3a\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\uff0c\u6211\u53ef\u4ee5\u4f7f\u7528\u54ea\u4e9b\u7b56\u7565\u5728Doodle Cricket\u4e2d\u6301\u7eed\u83b7\u5f97\u9ad8\u5206\uff1f", "answer": "\u5728Doodle Cricket\u4e2d\u83b7\u5f97\u6301\u7eed\u9ad8\u5206\uff0c\u5173\u952e\u5728\u4e8e\u638c\u63e1\u65f6\u673a\u548c\u51fb\u7403\u4f4d\u7f6e\u3002\u6b65\u9aa41\uff1a\u7ec3\u4e60\u5b8c\u7f8e\u51fb\u7403\u65f6\u673a\uff1b\u4f60\u8d8a\u63a5\u8fd1\u5b8c\u7f8e\u7684\u51fb\u7403\u65f6\u673a\uff0c\u5f97\u5206\u5c31\u8d8a\u9ad8\u3002\u6b65\u9aa42\uff1a\u89c2\u5bdf\u573a\u5730\u4f4d\u7f6e\uff0c\u5c3d\u91cf\u5c06\u7403\u51fb\u6253\u5230\u573a\u7403\u5458\u4e4b\u95f4\u7684\u7a7a\u6321\u3002\u6b65\u9aa43\uff1a\u7b56\u7565\u6027\u5730\u4f7f\u7528\u9ad8\u8fdc\u7403\u4ee5\u8d8a\u8fc7\u5185\u573a\uff0c\u5f97\u5206\u3002\u7784\u51c6\u7a7a\u6321\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u6ce8\u610f\u5230\u4e2d\u950b\u548c\u4e2d\u5916\u573a\u4e4b\u95f4\u6709\u7a7a\u6321\uff0c\u5c1d\u8bd5\u5c06\u7403\u51fb\u6253\u5230\u90a3\u91cc\u3002\u53d8\u6362\u51fb\u7403\u9009\u62e9\uff0c\u8ba9\u573a\u7403\u5458\u6478\u4e0d\u7740\u5934\u8111\u3002[\u7b56\u7565\u6d41\u7a0b\u56fe]\u3002\u8bb0\u4f4f\uff0c\u7ecf\u9a8c\u548c\u9002\u5e94\u6e38\u620f\u52a8\u6001\u662f\u53d6\u5f97\u4e00\u81f4\u6027\u7684\u5173\u952e\u3002"}, {"question": "\u5982\u4f55\u5728Doodle Cricket\u4e2d\u5229\u7528AI\u573a\u7403\u5458\u53ca\u5176\u4f4d\u7f6e\u503e\u5411\u6700\u5927\u5316\u5f97\u5206\u673a\u4f1a\uff1f", "answer": "\u5728Doodle Cricket\u4e2d\u5229\u7528AI\u573a\u7403\u5458\u9700\u8981\u7406\u89e3\u4ed6\u4eec\u7684\u4f4d\u7f6e\u6a21\u5f0f\u5e76\u9884\u6d4b\u4ed6\u4eec\u7684\u79fb\u52a8\u3002\u5728\u6bcf\u6b21\u6295\u7403\u524d\u89c2\u5bdf\u4ed6\u4eec\u7684\u4f4d\u7f6e\uff0c\u5e76\u7784\u51c6\u7a7a\u6321\u3002AI\u503e\u5411\u4e8e\u6839\u636e\u4f60\u4e4b\u524d\u7684\u51fb\u7403\u8c03\u6574\u573a\u7403\u5458\u4f4d\u7f6e\uff0c\u56e0\u6b64\u4e3a\u4e86\u8ba9\u4ed6\u4eec\u6478\u4e0d\u7740\u5934\u8111\uff0c\u8981\u9891\u7e41\u5730\u6539\u53d8\u4f60\u7684\u51fb\u7403\u9009\u62e9\u3002\u5982\u679c\u4ed6\u4eec\u5c06\u7403\u5458\u96c6\u4e2d\u5728\u7403\u573a\u4e00\u4fa7\uff0c\u5219\u7784\u51c6\u53e6\u4e00\u4fa7\uff0c\u53cd\u4e4b\u4ea6\u7136\u3002\u4f8b\u5982\uff0c\u6ce8\u610f\u5230\u4ed6\u4eec\u5728\u4f60\u5728\u7279\u5b9a\u65b9\u5411\u51fb\u51fa\u8fb9\u754c\u7403\u540e\u5982\u4f55\u8c03\u6574\u3002\u4f60\u53ef\u4ee5\u5229\u7528\u8fd9\u4e00\u70b9\u5728\u76f8\u53cd\u7684\u65b9\u5411\u521b\u9020\u5f97\u5206\u673a\u4f1a\u3002[AI\u884c\u4e3a\u56fe\u8868]\u3002\u628a\u5b83\u60f3\u8c61\u6210\u4e00\u76d8\u56fd\u9645\u8c61\u68cb\u3002"}, {"question": "Doodle Cricket\u6e38\u620f\u4e2d\uff0c\u4e13\u5bb6\u73a9\u5bb6\u4f7f\u7528\u54ea\u4e9b\u9ad8\u7ea7\u6280\u5de7\uff0c\u4f8b\u5982\u201c\u5f3a\u529b\u51fb\u7403\u201d\u6216\u6280\u5de7\u6027\u51fb\u7403\uff1f", "answer": "\u867d\u7136Doodle Cricket\u4e2d\u6ca1\u6709\u660e\u786e\u7684\u201c\u5f3a\u529b\u51fb\u7403\u201d\uff0c\u4f46\u4f60\u53ef\u4ee5\u4f7f\u7528\u7cbe\u786e\u7684\u65f6\u673a\u548c\u4f4d\u7f6e\u6700\u5927\u5316\u4f60\u7684\u5f97\u5206\u6f5c\u529b\u3002\u4e00\u8bb0\u7cbe\u51c6\u7684\u9ad8\u8fdc\u7403\uff0c\u5b8c\u7f8e\u5730\u51fb\u51fa\uff0c\u53ef\u4ee5\u5c06\u7403\u6253\u51fa\u8fb9\u754c\uff0c\u83b7\u5f97\u516d\u5206\u3002\u638c\u63e1\u65f6\u673a\u7a97\u53e3\uff0c\u5728\u6700\u4f73\u65f6\u673a\u51fb\u7403\u3002\u5c1d\u8bd5\u4e0d\u540c\u7684\u6ed1\u52a8\u89d2\u5ea6\uff0c\u5c06\u7403\u5f15\u5bfc\u5230\u573a\u7403\u5458\u4e4b\u95f4\u7684\u7a7a\u6321\uff0c\u7c7b\u4f3c\u4e8e\u201c\u6280\u5de7\u6027\u51fb\u7403\u201d\u3002\u8981\u83b7\u5f97\u6700\u5927\u8ddd\u79bb\uff0c\u8bf7\u5728\u51fb\u7403\u524d\u7565\u5fae\u5411\u4e0a\u6ed1\u52a8\u3002\u53ef\u4ee5\u5c06\u5b83\u60f3\u8c61\u6210\u5728\u4f60\u7684\u51fb\u7403\u4e2d\u589e\u52a0\u989d\u5916\u7684\u529b\u91cf\u3002\u7cbe\u786e\u7684\u65f6\u673a\u53ef\u4ee5\u6267\u884c\u51fb\u7403\uff0c\u4ece\u800c\u83b7\u5f97\u6700\u5927\u7684\u529b\u91cf\u3002[\u9ad8\u7ea7\u6280\u5de7\u8def\u7ebf\u56fe]\u3002\u7ec3\u4e60\u4e0d\u540c\u6ed1\u52a8\u89d2\u5ea6\u548c\u65f6\u673a\u3002"}, {"question": "Doodle Cricket\u5f15\u64ce\u4e2d\u54ea\u4e9b\u57fa\u672c\u673a\u5236\u51b3\u5b9a\u4e86\u5f97\u5206\uff1f", "answer": "\u5728Doodle Cricket\u4e2d\uff0c\u4f60\u83b7\u5f97\u7684\u5206\u6570\u53d6\u51b3\u4e8e\u65f6\u673a\u548c\u51fb\u7403\u4f4d\u7f6e\u7684\u7efc\u5408\u56e0\u7d20\u3002\u5b8c\u7f8e\u7684\u65f6\u673a\u5bfc\u81f4\u66f4\u957f\u7684\u3001\u66f4\u5f3a\u5927\u7684\u51fb\u7403\uff0c\u589e\u52a0\u4f60\u5f97\u5206\uff08\u56db\u5206\u6216\u516d\u5206\uff09\u7684\u673a\u4f1a\u3002\u4f60\u8d8a\u63a5\u8fd1\u5b8c\u7f8e\u7684\u51fb\u7403\u65f6\u673a\u7a97\u53e3\uff0c\u5f97\u5206\u5c31\u8d8a\u9ad8\u3002\u6b64\u5916\uff0c\u4f60\u51fb\u7403\u7684\u65b9\u5411\u4e0e\u573a\u7403\u5458\u4f4d\u7f6e\u6709\u5173\u3002\u51fb\u6253\u5230\u573a\u7403\u5458\u4e4b\u95f4\u7684\u7a7a\u6321\u53ef\u4ee5\u6700\u5927\u5316\u4f60\u7684\u5f97\u5206\u673a\u4f1a\u3002\u5f97\u5206 = \u57fa\u672c\u503c * \u65f6\u673a\u4e58\u6570 * \u4f4d\u7f6e\u4e58\u6570\u3002[\u6bd4\u8f83\u5f97\u5206\u914d\u7f6e\u7684\u8868\u683c]\u3002\u65f6\u673a\u662f\u5173\u952e\u3002"}, {"question": "\u4f60\u80fd\u5426\u66f4\u6df1\u5165\u5730\u5206\u6790Doodle Cricket\u6e38\u620f\u96be\u5ea6\u7b49\u7ea7\uff1f", "answer": "Doodle Cricket\u901a\u8fc7\u8c03\u6574\u573a\u7403\u5458\u4f4d\u7f6e\u548c\u6295\u7403\u901f\u5ea6\u6765\u5b9e\u73b0\u96be\u5ea6\u9012\u589e\u3002\u968f\u7740\u4f60\u6e38\u620f\u8fdb\u5c55\uff0cAI\u4f1a\u7b56\u7565\u6027\u5730\u5b89\u6392\u573a\u7403\u5458\u5360\u636e\u66f4\u591a\u5730\u9762\uff0c\u4f7f\u5f97\u627e\u5230\u7a7a\u6321\u53d8\u5f97\u66f4\u96be\u3002\u6295\u7403\u901f\u5ea6\u4f1a\u52a0\u5feb\uff0c\u9700\u8981\u66f4\u5feb\u7684\u53cd\u5e94\u901f\u5ea6\u548c\u66f4\u7cbe\u786e\u7684\u65f6\u673a\u3002\u9884\u8ba1\u4f1a\u66f4\u5bc6\u96c6\u5730\u9632\u5b88\uff0c\u5f97\u5206\u7a7a\u6321\u4f1a\u66f4\u5c11\u3002\u6295\u7403\u901f\u5ea6\u7684\u8c03\u6574\u786e\u4fdd\u4e86\u5373\u4f7f\u5bf9\u4e8e\u8001\u5c06\u73a9\u5bb6\uff0c\u6311\u6218\u4e5f\u4f9d\u7136\u5b58\u5728\u3002\u96be\u5ea6\u589e\u52a0\u4e86\uff0c\u4f46\u5f97\u5206\u673a\u4f1a\u4f9d\u7136\u5b58\u5728\u3002[\u96be\u5ea6\u66f2\u7ebf\u56fe]\u3002\u4fdd\u6301\u654f\u6377\u3002"}, {"question": "Doodle Cricket\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u662f\u5426\u6709\u8de8\u5e73\u53f0\u4fdd\u5b58\u652f\u6301\u6216\u6570\u636e\u4f20\u8f93\u529f\u80fd\uff1f", "answer": "\u5f88\u9057\u61be\uff0cDoodle Cricket\u901a\u5e38\u4e0d\u652f\u6301\u8de8\u5e73\u53f0\u4fdd\u5b58\u652f\u6301\u6216\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u7684\u6570\u636e\u4f20\u8f93\u3002\u4f60\u7684\u6e38\u620f\u8fdb\u5ea6\u901a\u5e38\u5b58\u50a8\u5728\u6b63\u5728\u4f7f\u7528\u7684\u8bbe\u5907\u7684\u672c\u5730\u3002\u8fd9\u610f\u5473\u7740\u5982\u679c\u4f60\u5207\u6362\u5230\u65b0\u7684\u624b\u673a\u6216\u5e73\u677f\u7535\u8111\uff0c\u4f60\u53ef\u80fd\u9700\u8981\u91cd\u65b0\u5f00\u59cb\u6e38\u620f\u3002\u76ee\u524dDoodle Cricket\u6ca1\u6709\u4e91\u540c\u6b65\u529f\u80fd\u3002\u901a\u8fc7\u622a\u5c4f\u5907\u4efd\u4f60\u7684\u6e38\u620f\u3002\u5efa\u8bae\u4e0e\u5ba2\u670d\u8054\u7cfb\uff0c\u63d0\u51fa\u6539\u8fdb\u5efa\u8bae\u3002[\u4e91\u4fdd\u5b58\u6bd4\u8f83\u8868]"}, {"question": "Doodle Cricket\u7684\u79d8\u5bc6\uff1aDoodle Cricket\u6e38\u620f\u4e2d\u662f\u5426\u5b58\u5728\u9690\u85cf\u89d2\u8272\u6216\u5f69\u86cb\uff1f\u5982\u4f55\u89e3\u9501\u5b83\u4eec\uff1f", "answer": "\u867d\u7136Doodle Cricket\u6ca1\u6709\u4f20\u7edf\u610f\u4e49\u4e0a\u7684\u53ef\u89e3\u9501\u89d2\u8272\uff0c\u4f46\u6e38\u620f\u4e2d\u5e38\u5e38\u51fa\u73b0\u4e3b\u9898\u6d82\u9e26\uff0c\u5177\u6709\u7279\u6b8a\u7684\u5916\u89c2\u3002\u7559\u610f\u8282\u5047\u65e5\u4e3b\u9898\u6216\u7279\u6b8a\u6d3b\u52a8\u6d82\u9e26\uff0c\u5b83\u4eec\u53ef\u80fd\u63d0\u4f9b\u72ec\u7279\u7684\u89c6\u89c9\u98ce\u683c\u3002\u8981\u627e\u5230\u8fd9\u4e9b\u5f69\u86cb\uff0c\u8bf7\u5728\u91cd\u8981\u65e5\u671f\u6216\u7279\u6b8a\u6d3b\u52a8\u671f\u95f4\u73a9\u6e38\u620f\u3002\u8c37\u6b4c\u6d82\u9e26\u6709\u65f6\u4e5f\u4f1a\u6539\u53d8\u4ee5\u53cd\u6620\u73b0\u5b9e\u4e16\u754c\u6b63\u5728\u53d1\u751f\u7684\u4e8b\u4ef6\u3002\u5728\u677f\u7403\u4e16\u754c\u676f\u7b49\u7279\u6b8a\u6d3b\u52a8\u671f\u95f4\u8fdb\u884c\u6e38\u620f\uff0c\u770b\u770b\u5f69\u86cb\u3002[\u5df2\u77e5\u5e26\u6709\u9690\u85cf\u542b\u4e49\u7684\u6d82\u9e26\u5217\u8868]\u3002\u795d\u4f60\u73a9\u5f97\u5f00\u5fc3\uff01"}]
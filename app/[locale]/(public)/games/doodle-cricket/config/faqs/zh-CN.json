[{"question": "\u65b0\u624b\u5728\u300a\u6d82\u9e26\u677f\u7403\u300b\u4e2d\u5982\u4f55\u8fdb\u884c\u57fa\u672c\u51fb\u7403\uff1f", "answer": "\u5728\u300a\u6d82\u9e26\u677f\u7403\u300b\u4e2d\u8fdb\u884c\u57fa\u672c\u51fb\u7403\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u7b49\u5f85\u7403\u88ab\u6295\u63b7\u3002\u6b65\u9aa42\uff1a\u5f53\u7403\u8fdb\u5165\u51fb\u7403\u533a\u57df\u65f6\uff0c\u70b9\u51fb\u5c4f\u5e55\u3002\u6b65\u9aa43\uff1a\u8c03\u6574\u51fb\u7403\u65f6\u673a\uff0c\u4ee5\u51c6\u786e\u51fb\u4e2d\u7403\u3002\u4f8b\u5982\uff0c\u70b9\u51fb\u8fc7\u65e9\u6216\u8fc7\u665a\u4f1a\u5bfc\u81f4\u51fb\u7403\u5931\u8bef\u6216\u51fb\u7403\u65e0\u529b\u3002\u4f7f\u7528\u6d41\u7a0b\u56fe\u53ef\u66f4\u6e05\u6670\u5730\u4e86\u89e3\u51fb\u7403\u65f6\u673a\u533a\u57df\u3002"}, {"question": "\u5728\u300a\u6d82\u9e26\u677f\u7403\u300b\u4e2d\u9700\u8981\u638c\u63e1\u54ea\u4e9b\u5173\u952e\u63a7\u5236\uff1f", "answer": "\u300a\u6d82\u9e26\u677f\u7403\u300b\u4e2d\u7684\u5173\u952e\u63a7\u5236\u5305\u62ec\uff1a1\uff09\u8c03\u6574\u51fb\u7403\u65f6\u673a\uff1b2\uff09\u6ed1\u52a8\u8fdb\u884c\u5f3a\u529b\u51fb\u7403\uff1b3\uff09\u6839\u636e\u4e0d\u540c\u7c7b\u578b\u7684\u6295\u7403\u8c03\u6574\u7ad9\u4f4d\u3002\u4f8b\u5982\uff0c\u5411\u4e0a\u6ed1\u52a8\u53ef\u4ee5\u51fb\u51fa\u9ad8\u8fdc\u7403\u3002\u914d\u7f6e\u8868\u53ef\u4ee5\u5e2e\u52a9\u6bd4\u8f83\u4e0d\u540c\u6ed1\u52a8\u65b9\u5411\u7684\u6548\u679c\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u300a\u6d82\u9e26\u677f\u7403\u300b\u4e2d\u65f6\u673a\u81f3\u5173\u91cd\u8981\uff0c\u6211\u8be5\u5982\u4f55\u63d0\u9ad8\uff1f", "answer": "\u5728\u300a\u6d82\u9e26\u677f\u7403\u300b\u4e2d\uff0c\u65f6\u673a\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u51b3\u5b9a\u4e86\u51fb\u7403\u7684\u51c6\u786e\u6027\u548c\u529b\u91cf\u3002\u4e3a\u4e86\u63d0\u9ad8\u65f6\u673a\uff0c\u8bf7\u5b9a\u671f\u7ec3\u4e60\uff0c\u4e13\u6ce8\u4e8e\u7403\u7684\u8f68\u8ff9\uff0c\u5e76\u4f7f\u7528\u8282\u62cd\u5668\u5e94\u7528\u7a0b\u5e8f\u6765\u57f9\u517b\u8282\u594f\u3002\u4f8b\u5982\uff0c\u5728\u7403\u7684\u6700\u9ad8\u70b9\u51fb\u7403\u53ef\u4ee5\u6700\u5927\u5316\u5f97\u5206\u3002\u4f7f\u7528\u6bd4\u8f83\u56fe\u8868\u663e\u793a\u4e0d\u540c\u65f6\u673a\u5bf9\u51fb\u7403\u7ed3\u679c\u7684\u5f71\u54cd\u3002"}, {"question": "\u5728\u300a\u6d82\u9e26\u677f\u7403\u300b\u4e2d\uff0c\u73a9\u4e86 100 \u5c0f\u65f6\u540e\uff0c\u54ea\u4e9b\u9ad8\u7ea7\u7b56\u7565\u53ef\u4ee5\u5e2e\u52a9\u6211\u83b7\u5f97\u66f4\u9ad8\u5206\u6570\uff1f", "answer": "\u73a9\u4e86 100 \u5c0f\u65f6\u540e\uff0c\u9ad8\u7ea7\u7b56\u7565\u5305\u62ec\uff1a\u6b65\u9aa41\uff1a\u7814\u7a76\u6295\u7403\u624b\u7684\u6295\u7403\u6a21\u5f0f\uff0c\u4ee5\u9884\u6d4b\u6295\u7403\u3002\u6b65\u9aa42\uff1a\u6218\u7565\u6027\u5730\u4f7f\u7528\u5f3a\u529b\u51fb\u7403\u6765\u6700\u5927\u5316\u5f97\u5206\u3002\u6b65\u9aa43\uff1a\u638c\u63e1\u9632\u5b88\u51fb\u7403\uff0c\u907f\u514d\u88ab\u6dd8\u6c70\u3002\u4f8b\u5982\uff0c\u63d0\u524d\u8bc6\u522b\u65cb\u8f6c\u7403\u7684\u6295\u7403\u53ef\u4ee5\u5e2e\u52a9\u60a8\u8c03\u6574\u51fb\u7403\u3002\u6d41\u7a0b\u56fe\u53ef\u4ee5\u8bf4\u660e\u5e94\u5bf9\u4e0d\u540c\u6295\u7403\u7684\u51b3\u7b56\u8fc7\u7a0b\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u6d82\u9e26\u677f\u7403\u300b\u4e2d\u6709\u6548\u53cd\u51fb\u65cb\u8f6c\u6295\u7403\uff1f", "answer": "\u4e3a\u4e86\u6709\u6548\u53cd\u51fb\u65cb\u8f6c\u6295\u7403\uff1a\u6b65\u9aa41\uff1a\u5bc6\u5207\u89c2\u5bdf\u7403\uff0c\u68c0\u6d4b\u65cb\u8f6c\u65b9\u5411\u3002\u6b65\u9aa42\uff1a\u8c03\u6574\u51fb\u7403\u65f6\u673a\uff0c\u4ee5\u5f25\u8865\u65cb\u8f6c\u7684\u5f71\u54cd\u3002\u6b65\u9aa43\uff1a\u5f53\u4e0d\u786e\u5b9a\u65f6\uff0c\u4f7f\u7528\u9632\u5b88\u51fb\u7403\u3002\u4f8b\u5982\uff0c\u5728\u9762\u5bf9\u817f\u90e8\u65cb\u8f6c\u7403\u65f6\uff0c\u5ef6\u540e\u51fb\u7403\u53ef\u4ee5\u964d\u4f4e\u88ab\u6dd8\u6c70\u7684\u98ce\u9669\u3002\u914d\u7f6e\u8868\u53ef\u4ee5\u5e2e\u52a9\u5c06\u65cb\u8f6c\u7c7b\u578b\u6620\u5c04\u5230\u63a8\u8350\u7684\u51fb\u7403\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u6d82\u9e26\u677f\u7403\u300b\u4e2d\u6709\u6548\u7ba1\u7406\u6211\u7684\u5c40\u52bf\u4ee5\u83b7\u5f97\u9ad8\u5206\uff1f", "answer": "\u4e3a\u4e86\u7ba1\u7406\u6bd4\u8d5b\u5c40\u9762\u4ee5\u83b7\u5f97\u9ad8\u5206\uff1a\u6b65\u9aa41\uff1a\u8c28\u614e\u5f00\u59cb\uff0c\u5efa\u7acb\u57fa\u7840\u3002\u6b65\u9aa42\uff1a\u5728\u4e2d\u5c40\u52a0\u901f\u5f97\u5206\u3002\u6b65\u9aa43\uff1a\u4ee5\u5f3a\u529b\u51fb\u7403\u7ed3\u675f\u6bd4\u8d5b\u3002\u4f8b\u5982\uff0c\u5c06\u5f3a\u529b\u51fb\u7403\u7559\u5230\u6700\u540e\u51e0\u5c40\u53ef\u4ee5\u6700\u5927\u5316\u603b\u5206\u3002\u6bd4\u8f83\u56fe\u8868\u53ef\u4ee5\u663e\u793a\u6bd4\u8d5b\u4e0d\u540c\u9636\u6bb5\u7684\u5f97\u5206\u5206\u914d\u3002"}, {"question": "\u300a\u6d82\u9e26\u677f\u7403\u300b\u4e2d\u7684\u8ba1\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u6211\u8be5\u5982\u4f55\u4f18\u5316\uff1f", "answer": "\u300a\u6d82\u9e26\u677f\u7403\u300b\u7684\u8ba1\u5206\u7cfb\u7edf\u5956\u52b1\u51c6\u786e\u4e14\u5f3a\u5927\u7684\u51fb\u7403\u3002\u4e3a\u4e86\u4f18\u5316\u5f97\u5206\uff0c\u8bf7\u4e13\u6ce8\u4e8e\u51fb\u4e2d\u7403\u7684\u751c\u70b9\u533a\u57df\uff0c\u5e76\u4f7f\u7528\u5f3a\u529b\u51fb\u7403\u51fb\u51fa\u8fb9\u754c\u7403\u3002\u4f8b\u5982\uff0c\u5728\u7403\u62cd\u4e2d\u5fc3\u4f4d\u7f6e\u51fb\u4e2d\u4e00\u4e2a\u65f6\u673a\u826f\u597d\u7684\u7403\u53ef\u4ee5\u51fb\u51fa\u5168\u5792\u6253\u3002\u4f7f\u7528\u6d41\u7a0b\u56fe\u89e3\u91ca\u57fa\u4e8e\u51fb\u7403\u8d28\u91cf\u7684\u8ba1\u5206\u673a\u5236\u3002"}, {"question": "\u300a\u6d82\u9e26\u677f\u7403\u300b\u4e2d\u5f3a\u529b\u51fb\u7403\u7684\u6f5c\u5728\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u6d82\u9e26\u677f\u7403\u300b\u4e2d\u7684\u5f3a\u529b\u51fb\u7403\u53d7\u6ed1\u52a8\u901f\u5ea6\u3001\u89d2\u5ea6\u548c\u65f6\u673a\u7b49\u673a\u5236\u7684\u5f71\u54cd\u3002\u4f8b\u5982\uff0c\u5feb\u901f\u5411\u4e0a\u6ed1\u52a8\u53ef\u4ee5\u51fb\u51fa\u9ad8\u8fdc\u7403\u3002\u8fd9\u4e9b\u51fb\u7403\u4f1a\u6d88\u8017\u4f53\u529b\uff0c\u56e0\u6b64\u8bf7\u8c28\u614e\u4f7f\u7528\u3002\u914d\u7f6e\u8868\u53ef\u4ee5\u8be6\u7ec6\u8bf4\u660e\u4e0d\u540c\u6ed1\u52a8\u53c2\u6570\u5bf9\u51fb\u7403\u7ed3\u679c\u7684\u5f71\u54cd\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5728\u4e0d\u540c\u7684\u8bbe\u5907\u4e4b\u95f4\u8f6c\u79fb\u300a\u6d82\u9e26\u677f\u7403\u300b\u7684\u6e38\u620f\u8fdb\u5ea6\u5417\uff1f\u5982\u4f55\u8f6c\u79fb\uff1f", "answer": "\u662f\u7684\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u5c06\u60a8\u7684\u6e38\u620f\u5e10\u6237\u94fe\u63a5\u5230\u793e\u4ea4\u5a92\u4f53\u6216\u7535\u5b50\u90ae\u4ef6 ID \u6765\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u8f6c\u79fb\u300a\u6d82\u9e26\u677f\u7403\u300b\u7684\u6e38\u620f\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u76f8\u540c\u7684\u51ed\u636e\u767b\u5f55\u65b0\u8bbe\u5907\u5c06\u540c\u6b65\u60a8\u7684\u6570\u636e\u3002\u4f7f\u7528\u6d41\u7a0b\u56fe\u8bf4\u660e\u5e10\u6237\u94fe\u63a5\u548c\u6570\u636e\u4f20\u8f93\u7684\u6b65\u9aa4\u3002"}, {"question": "\u300a\u6d82\u9e26\u677f\u7403\u300b\u4e2d\u6709\u9690\u85cf\u7684\u5f69\u86cb\u6216\u79d8\u5bc6\u5417\uff1f", "answer": "\u300a\u6d82\u9e26\u677f\u7403\u300b\u5305\u542b\u9690\u85cf\u5f69\u86cb\uff0c\u4f8b\u5982\u5b8c\u6210\u91cc\u7a0b\u7891\u4efb\u52a1\u53ef\u4ee5\u89e3\u9501\u7279\u6b8a\u7684\u7403\u68d2\u6216\u72ec\u7279\u7684\u5e86\u795d\u65b9\u5f0f\u3002\u4f8b\u5982\uff0c\u5728\u5355\u573a\u6bd4\u8d5b\u4e2d\u83b7\u5f97 100 \u5206\u53ef\u80fd\u5c31\u80fd\u89e3\u9501\u91d1\u8272\u7403\u68d2\u3002\u4f7f\u7528\u6bd4\u8f83\u56fe\u8868\u5217\u51fa\u5df2\u77e5\u7684\u5f69\u86cb\u53ca\u5176\u89e3\u9501\u6761\u4ef6\u3002"}]
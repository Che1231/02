[{"question": "\u5982\u4f55\u624d\u80fd\u5728\u6c64\u59c6\u732b\u548c\u6770\u745e\u5386\u9669\u8bb0\u4e2d\u5b8c\u6210\u53cc\u8df3\u4ee5\u5230\u8fbe\u66f4\u9ad8\u7684\u5e73\u53f0\uff1f", "answer": "\u5728\u6c64\u59c6\u732b\u548c\u6770\u745e\u5386\u9669\u8bb0\u4e2d\uff0c\u53cc\u8df3\u5bf9\u4e8e\u5230\u8fbe\u66f4\u9ad8\u7684\u5e73\u53f0\u81f3\u5173\u91cd\u8981\u3002\u9996\u5148\uff0c\u6309\u8df3\u8dc3\u6309\u94ae\u6267\u884c\u7b2c\u4e00\u6b21\u8df3\u8dc3\u3002\u5728\u7a7a\u4e2d\uff0c\u518d\u6b21\u6309\u8df3\u8dc3\u6309\u94ae\u6267\u884c\u7b2c\u4e8c\u6b21\u8df3\u8dc3\u3002\u4f8b\u5982\uff0c\u5728\u626e\u6f14\u6770\u745e\u65f6\uff0c\u53ef\u4ee5\u4f7f\u7528\u53cc\u8df3\u6765\u8bbf\u95ee\u2018\u53a8\u623f\u5927\u4e71\u6597\u2019\u5173\u5361\u4e2d\u85cf\u5728\u9ad8\u5904\u7684\u5976\u916a\u3002\u8fd9\u9879\u6280\u5de7\u5bf9\u4e8e\u63a2\u7d22\u548c\u6536\u96c6\u5956\u52b1\u90fd\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u5728\u6c64\u59c6\u732b\u548c\u6770\u745e\u5386\u9669\u8bb0\u4e2d\uff0c\u5982\u4f55\u6700\u597d\u5730\u907f\u514d\u6c64\u59c6\u7684\u9677\u9631\uff1f", "answer": "\u907f\u514d\u6c64\u59c6\u7684\u9677\u9631\u9700\u8981\u7ed3\u5408\u65f6\u673a\u548c\u89c2\u5bdf\u529b\u3002\u6b65\u9aa4\u4e00\uff1a\u59cb\u7ec8\u626b\u63cf\u73af\u5883\uff0c\u7559\u610f\u7eca\u7ebf\u6216\u538b\u529b\u677f\u7b49\u89c6\u89c9\u63d0\u793a\u3002\u6b65\u9aa4\u4e8c\uff1a\u4ed4\u7ec6\u63a7\u5236\u4f60\u7684\u884c\u52a8\u65f6\u95f4\uff1b\u7b49\u5f85\u9677\u9631\u89e6\u53d1\u540e\u8fc5\u901f\u901a\u8fc7\u3002\u6b65\u9aa4\u4e09\uff1a\u4f7f\u7528\u9053\u5177\uff0c\u4f8b\u5982\u2018\u9690\u8eab\u6597\u7bf7\u2019\uff0c\u6682\u65f6\u7ed5\u8fc7\u9677\u9631\u3002\u4f8b\u5982\uff0c\u5728\u2018\u540e\u9662\u95ea\u7535\u6218\u2019\u5173\u5361\u4e2d\uff0c\u5728\u6447\u6446\u7684\u6728\u69cc\u4e4b\u95f4\u63a7\u5236\u597d\u8dd1\u52a8\u65f6\u673a\u53ef\u4ee5\u907f\u514d\u88ab\u6293\u4f4f\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u5e94\u8be5\u4f18\u5148\u6536\u96c6\u6c64\u59c6\u732b\u548c\u6770\u745e\u5386\u9669\u8bb0\u4e2d\u7684\u5976\u916a\uff0c\u4ee5\u53ca\u5728\u54ea\u91cc\u53ef\u4ee5\u627e\u5230\u5b83\uff1f", "answer": "\u5728\u6c64\u59c6\u732b\u548c\u6770\u745e\u5386\u9669\u8bb0\u4e2d\u6536\u96c6\u5976\u916a\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u4f5c\u4e3a\u89e3\u9501\u65b0\u89d2\u8272\u548c\u5347\u7ea7\u7684\u4e3b\u8981\u8d27\u5e01\u3002\u5976\u916a\u901a\u5e38\u9690\u85cf\u5728\u96be\u4ee5\u89e6\u53ca\u7684\u5730\u65b9\u6216\u969c\u788d\u7269\u540e\u9762\u3002\u4f8b\u5982\uff0c\u5728\u2018\u5ba2\u5385\u8df3\u8dc3\u2019\u5173\u5361\u4e2d\uff0c\u4f60\u53ef\u4ee5\u901a\u8fc7\u6253\u7834\u4e00\u7cfb\u5217\u7bb1\u5b50\u627e\u5230\u4e00\u5927\u5757\u5976\u916a\u3002\u4f18\u5148\u6536\u96c6\u5976\u916a\u53ef\u4ee5\u663e\u8457\u63d0\u5347\u4f60\u7684\u6e38\u620f\u4f53\u9a8c\uff0c\u56e0\u4e3a\u5b83\u80fd\u63d0\u4f9b\u66f4\u597d\u7684\u5de5\u5177\u548c\u80fd\u529b\u3002"}, {"question": "\u5982\u4f55\u4f18\u5316\u6c64\u59c6\u732b\u548c\u6770\u745e\u5386\u9669\u8bb0\u4e2d\u89d2\u8272\u7684\u80fd\u529b\u4ee5\u8fdb\u884c\u7ade\u4e89\u6027\u6e38\u620f\uff1f", "answer": "\u4f18\u5316\u89d2\u8272\u80fd\u529b\u9700\u8981\u6280\u80fd\u5347\u7ea7\u548c\u7b56\u7565\u8fd0\u7528\u76f8\u7ed3\u5408\u3002\u6b65\u9aa4\u4e00\uff1a\u4e13\u6ce8\u4e8e\u63d0\u5347\u654f\u6377\u6027\u548c\u901f\u5ea6\u4ee5\u5728\u5bf9\u624b\u9762\u524d\u7075\u6d3b\u673a\u52a8\u3002\u6b65\u9aa4\u4e8c\uff1a\u5728\u5173\u952e\u65f6\u523b\u88c5\u5907\u2018\u52a0\u901f\u2019\u9053\u5177\u3002\u6b65\u9aa4\u4e09\uff1a\u7ec3\u4e60\u9ad8\u7ea7\u6280\u5de7\uff0c\u4f8b\u5982\u5899\u8df3\u548c\u6ed1\u884c\u51b2\u523a\u3002\u4f8b\u5982\uff0c\u5728\u2018\u51b2\u5411\u51b0\u7bb1\u2019\u6d3b\u52a8\u4e2d\u4f7f\u7528\u6770\u745e\u7684\u2018\u5feb\u901f\u51b2\u523a\u2019\u6280\u80fd\u53ef\u4ee5\u8ba9\u4f60\u5728\u5176\u4ed6\u73a9\u5bb6\u9762\u524d\u5360\u636e\u663e\u8457\u4f18\u52bf\u3002"}, {"question": "\u6c64\u59c6\u732b\u548c\u6770\u745e\u5386\u9669\u8bb0\u4e2d\u7684\u2018\u8ba1\u65f6\u8d5b\u2019\u6a21\u5f0f\u6709\u4ec0\u4e48\u610f\u4e49\uff0c\u4ee5\u53ca\u5982\u4f55\u624d\u80fd\u5728\u5176\u4e2d\u53d6\u5f97\u4f18\u5f02\u6210\u7ee9\uff1f", "answer": "\u6c64\u59c6\u732b\u548c\u6770\u745e\u5386\u9669\u8bb0\u4e2d\u7684\u2018\u8ba1\u65f6\u8d5b\u2019\u6a21\u5f0f\u6d4b\u8bd5\u4f60\u7684\u901f\u5ea6\u548c\u7cbe\u786e\u5ea6\u3002\u4e3a\u4e86\u53d6\u5f97\u4f18\u5f02\u6210\u7ee9\uff0c\u8981\u4e13\u6ce8\u4e8e\u638c\u63e1\u6700\u77ed\u8def\u7ebf\u5e76\u5b8c\u7f8e\u5730\u5b8c\u6210\u8df3\u8dc3\u3002\u4f8b\u5982\uff0c\u5728\u2018\u8f66\u5e93\u51b2\u523a\u2019\u5173\u5361\u4e2d\uff0c\u8d70\u4e0a\u65b9\u7684\u8def\u5f84\u53ef\u4ee5\u8282\u7701\u5b9d\u8d35\u7684\u65f6\u95f4\u3002\u53ef\u4ee5\u4f7f\u7528\u2018\u79d2\u8868\u2019\u9053\u5177\u6682\u65f6\u51cf\u6162\u65f6\u95f4\uff0c\u8ba9\u4f60\u66f4\u5bb9\u6613\u5730\u901a\u8fc7\u68d8\u624b\u7684\u8def\u6bb5\u3002\u8fd9\u4e2a\u6a21\u5f0f\u975e\u5e38\u9002\u5408\u78e8\u7ec3\u4f60\u7684\u6280\u5de7\u548c\u53d6\u5f97\u66f4\u5feb\u7684\u6210\u7ee9\u3002"}, {"question": "\u54ea\u4e9b\u9053\u5177\u5728\u6c64\u59c6\u732b\u548c\u6770\u745e\u5386\u9669\u8bb0\u7684\u4e0d\u540c\u6e38\u620f\u6a21\u5f0f\u4e2d\u6700\u4e3a\u6709\u6548\uff1f", "answer": "\u5728\u6c64\u59c6\u732b\u548c\u6770\u745e\u5386\u9669\u8bb0\u7684\u4e0d\u540c\u6e38\u620f\u6a21\u5f0f\u4e2d\uff0c\u4e0d\u540c\u7684\u9053\u5177\u6548\u679c\u4e0d\u540c\u3002\u5bf9\u4e8e\u2018\u8ba1\u65f6\u8d5b\u2019\uff0c\u2018\u79d2\u8868\u2019\u975e\u5e38\u5b9d\u8d35\u3002\u5728\u2018\u62a2\u593a\u5976\u916a\u2019\uff0c\u2018\u9690\u8eab\u6597\u7bf7\u2019\u53ef\u4ee5\u5e2e\u52a9\u4f60\u907f\u514d\u88ab\u53d1\u73b0\u3002\u5bf9\u4e8e\u2018\u751f\u5b58\u6a21\u5f0f\u2019\uff0c\u2018\u62a4\u76fe\u2019\u63d0\u4f9b\u989d\u5916\u7684\u4fdd\u62a4\u3002\u4f8b\u5982\uff0c\u5728\u2018\u51b2\u5411\u51b0\u7bb1\u2019\u4e2d\u4f7f\u7528\u2018\u52a0\u901f\u2019\u9053\u5177\u53ef\u4ee5\u5e2e\u52a9\u4f60\u8d85\u8d8a\u7ade\u4e89\u5bf9\u624b\u3002\u4e86\u89e3\u6bcf\u4e2a\u9053\u5177\u7684\u4f18\u52bf\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u8868\u73b0\u3002"}, {"question": "\u6c64\u59c6\u732b\u548c\u6770\u745e\u5386\u9669\u8bb0\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8ba1\u7b97\u6700\u7ec8\u5206\u6570\u7684\uff1f", "answer": "\u6c64\u59c6\u732b\u548c\u6770\u745e\u5386\u9669\u8bb0\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u51e0\u4e2a\u56e0\u7d20\uff1a\u884c\u8fdb\u8ddd\u79bb\uff0c\u6536\u96c6\u7684\u5976\u916a\u548c\u6240\u7528\u65f6\u95f4\u3002\u6bcf\u4e00\u5757\u5976\u916a\u90fd\u4f1a\u589e\u52a0\u4f60\u7684\u5206\u6570\uff0c\u800c\u66f4\u5feb\u7684\u5b8c\u6210\u65f6\u95f4\u4f1a\u83b7\u5f97\u989d\u5916\u5206\u6570\u3002\u4f8b\u5982\uff0c\u5728\u2018\u5ba2\u5385\u8df3\u8dc3\u2019\u5173\u5361\u4e2d\uff0c\u5728\u4e24\u5206\u949f\u5185\u5b8c\u6210\u6240\u6709\u5976\u916a\u6536\u96c6\uff0c\u53ef\u4ee5\u83b7\u5f97\u9ad8\u5206\u3002\u7406\u89e3\u8fd9\u4e9b\u673a\u5236\u53ef\u4ee5\u5e2e\u52a9\u4f60\u5236\u5b9a\u7b56\u7565\u4ee5\u83b7\u5f97\u66f4\u597d\u7684\u7ed3\u679c\u3002"}, {"question": "\u624b\u673a\u7248\u548c\u4e3b\u673a\u7248\u6c64\u59c6\u732b\u548c\u6770\u745e\u5386\u9669\u8bb0\u4e4b\u95f4\u6709\u54ea\u4e9b\u5173\u952e\u533a\u522b\uff1f", "answer": "\u624b\u673a\u7248\u548c\u4e3b\u673a\u7248\u6c64\u59c6\u732b\u548c\u6770\u745e\u5386\u9669\u8bb0\u7684\u4e3b\u8981\u533a\u522b\u5728\u4e8e\u63a7\u5236\u65b9\u5f0f\u548c\u753b\u9762\u3002\u624b\u673a\u7248\u4f7f\u7528\u89e6\u63a7\u63a7\u5236\uff0c\u800c\u4e3b\u673a\u7248\u4f7f\u7528\u6e38\u620f\u624b\u67c4\uff0c\u63d0\u4f9b\u66f4\u7cbe\u786e\u7684\u52a8\u4f5c\u3002\u4e3b\u673a\u7248\u7684\u753b\u9762\u66f4\u7cbe\u7ec6\uff0c\u589e\u5f3a\u4e86\u89c6\u89c9\u4f53\u9a8c\u3002\u4f8b\u5982\uff0c\u2018\u540e\u9662\u95ea\u7535\u6218\u2019\u5173\u5361\u5728\u4e3b\u673a\u7248\u770b\u8d77\u6765\u66f4\u751f\u52a8\u3002\u5c3d\u7ba1\u6709\u8fd9\u4e9b\u4e0d\u540c\uff0c\u4f46\u4e24\u6b3e\u7248\u672c\u90fd\u63d0\u4f9b\u76f8\u540c\u7684\u6838\u5fc3\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u5982\u4f55\u5c06\u624b\u673a\u7248\u6c64\u59c6\u732b\u548c\u6770\u745e\u5386\u9669\u8bb0\u7684\u8fdb\u5ea6\u8f6c\u79fb\u5230\u4e3b\u673a\u7248\uff1f", "answer": "\u4ece\u624b\u673a\u7248\u5230\u4e3b\u673a\u7248\u6c64\u59c6\u732b\u548c\u6770\u745e\u5386\u9669\u8bb0\u8f6c\u79fb\u8fdb\u5ea6\u975e\u5e38\u7b80\u5355\u3002\u9996\u5148\uff0c\u786e\u4fdd\u4e24\u4e2a\u8bbe\u5907\u8fde\u63a5\u5230\u540c\u4e00\u4e2a\u5e10\u6237\u3002\u7136\u540e\uff0c\u4f7f\u7528\u2018\u4e91\u4fdd\u5b58\u2019\u529f\u80fd\u5c06\u624b\u673a\u7248\u7684\u8fdb\u5ea6\u4e0a\u4f20\u3002\u6700\u540e\uff0c\u5728\u4e3b\u673a\u7248\u4e0b\u8f7d\u4fdd\u5b58\u6587\u4ef6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u624b\u673a\u7248\u4e2d\u5df2\u7ecf\u89e3\u9501\u4e86\u6770\u745e\u7684\u2018\u5feb\u901f\u51b2\u523a\u2019\uff0c\u5728\u8f6c\u79fb\u4e4b\u540e\u5b83\u4e5f\u4f1a\u5728\u4e3b\u673a\u7248\u4e0a\u53ef\u7528\u3002"}, {"question": "\u6c64\u59c6\u732b\u548c\u6770\u745e\u5386\u9669\u8bb0\u4e2d\u9690\u85cf\u7684\u2018\u9ec4\u91d1\u5976\u916a\u2019\u5728\u54ea\u91cc\u53ef\u4ee5\u627e\u5230\uff0c\u4ee5\u53ca\u5b83\u53ef\u4ee5\u89e3\u9501\u4ec0\u4e48\uff1f", "answer": "\u6c64\u59c6\u732b\u548c\u6770\u745e\u5386\u9669\u8bb0\u4e2d\u9690\u85cf\u7684\u2018\u9ec4\u91d1\u5976\u916a\u2019\u662f\u4e00\u79cd\u7a00\u6709\u6536\u85cf\u54c1\uff0c\u53ef\u4ee5\u89e3\u9501\u4e13\u5c5e\u5185\u5bb9\u3002\u5b83\u901a\u5e38\u9690\u85cf\u5728\u79d8\u5bc6\u533a\u57df\u6216\u5b8c\u6210\u5177\u6709\u6311\u6218\u6027\u7684\u4efb\u52a1\u540e\u3002\u4f8b\u5982\uff0c\u5728\u2018\u5730\u4e0b\u5ba4\u4e89\u593a\u6218\u2019\u5173\u5361\u4e2d\uff0c\u4f60\u53ef\u4ee5\u901a\u8fc7\u89e3\u51b3\u6d89\u53ca\u79fb\u52a8\u7bb1\u5b50\u7684\u8c1c\u9898\u6765\u627e\u5230\u2018\u9ec4\u91d1\u5976\u916a\u2019\u3002\u6536\u96c6\u5b83\u53ef\u4ee5\u89e3\u9501\u6c64\u59c6\u7684\u7279\u5236\u76ae\u80a4\uff0c\u4e3a\u4f60\u7684\u6e38\u620f\u589e\u6dfb\u72ec\u7279\u7684\u98ce\u683c\u3002"}]
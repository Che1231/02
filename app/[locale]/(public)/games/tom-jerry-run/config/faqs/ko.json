[{"question": "\ud1b0\uacfc \uc81c\ub9ac \ub7f0\uc5d0\uc11c \ub354 \ub192\uc740 \ud50c\ub7ab\ud3fc\uc5d0 \ub3c4\ub2ec\ud558\uae30 \uc704\ud574 \ub354\ube14 \uc810\ud504\ub97c \uc5b4\ub5bb\uac8c \uc218\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud1b0\uacfc \uc81c\ub9ac \ub7f0\uc5d0\uc11c \ub354\ube14 \uc810\ud504\ub294 \ub354 \ub192\uc740 \ud50c\ub7ab\ud3fc\uc5d0 \ub3c4\ub2ec\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uba3c\uc800 \uc810\ud504 \ubc84\ud2bc\uc744 \ub20c\ub7ec \uccab \ubc88\uc9f8 \uc810\ud504\ub97c \uc2dc\uc791\ud569\ub2c8\ub2e4. \uacf5\uc911\uc5d0 \uc788\ub294 \ub3d9\uc548 \uc810\ud504 \ubc84\ud2bc\uc744 \ub2e4\uc2dc \ub20c\ub7ec \ub450 \ubc88\uc9f8 \uc810\ud504\ub97c \uc2e4\ud589\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc81c\ub9ac\ub97c \ud50c\ub808\uc774\ud560 \ub54c \"\uc8fc\ubc29 \ud63c\ub3c8\" \ub808\ubca8\uc5d0\uc11c \ub192\uc740 \ub09c\uac04\uc5d0 \uc228\uaca8\uc9c4 \uce58\uc988\uc5d0 \uc811\uadfc\ud558\uae30 \uc704\ud574 \ub354\ube14 \uc810\ud504\ub97c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \uc774 \uae30\uc220\uc740 \ud0d0\uc0c9\uacfc \ubcf4\uc0c1 \ud68d\ub4dd \ubaa8\ub450\uc5d0 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4."}, {"question": "\ud1b0\uacfc \uc81c\ub9ac \ub7f0\uc5d0\uc11c \ud1b0\uc758 \ud568\uc815\uc744 \ud53c\ud558\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud1b0\uc758 \ud568\uc815\uc744 \ud53c\ud558\ub824\uba74 \ud0c0\uc774\ubc0d\uacfc \uad00\ucc30\ub825\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \ud56d\uc0c1 \ud568\uc815, \uc608\ub97c \ub4e4\uc5b4, \ub36b\uc774\ub098 \uc555\ub825\ud310\uacfc \uac19\uc740 \uc2dc\uac01\uc801 \ub2e8\uc11c\ub97c \ud658\uacbd\uc5d0\uc11c \uc2a4\uce94\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \uc6c0\uc9c1\uc784\uc758 \ud0c0\uc774\ubc0d\uc744 \uc8fc\uc758 \uae4a\uac8c \uc870\uc815\ud558\uc5ec \ud568\uc815\uc774 \uc791\ub3d9\ud560 \ub54c \ube60\ub974\uac8c \ud1b5\uacfc\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \"\ud22c\uba85 \ub9dd\ud1a0\"\uc640 \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc77c\uc2dc\uc801\uc73c\ub85c \ud568\uc815\uc744 \uc6b0\ud68c\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ub4b7\ub9c8\ub2f9 \uaca9\uc804\" \ub808\ubca8\uc5d0\uc11c \ud754\ub4e4\ub9ac\ub294 \ub9dd\uce58 \uc0ac\uc774\ub97c \ub2ec\ub9ac\ub294 \ud0c0\uc774\ubc0d\uc744 \ub9de\ucd94\uba74 \uac78\ub9ac\uc9c0 \uc54a\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud1b0\uacfc \uc81c\ub9ac \ub7f0\uc5d0\uc11c \uce58\uc988\ub97c \ubaa8\uc73c\ub294 \uac83\uc774 \uc6b0\uc120\uc21c\uc704\uac00 \ub418\uc5b4\uc57c \ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub514\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud1b0\uacfc \uc81c\ub9ac \ub7f0\uc5d0\uc11c \uce58\uc988\ub97c \ubaa8\uc73c\ub294 \uac83\uc740 \uc0c8\ub85c\uc6b4 \uce90\ub9ad\ud130\uc640 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \ud574\uc81c\ud558\ub294 \ub370 \ud544\uc218\uc801\uc778 \uae30\ubcf8 \ud1b5\ud654\uc774\uae30 \ub54c\ubb38\uc5d0 \uc6b0\uc120\uc21c\uc704\uac00 \ub418\uc5b4\uc57c \ud569\ub2c8\ub2e4. \uce58\uc988\ub294 \ub2ff\uae30 \uc5b4\ub824\uc6b4 \uacf3\uc774\ub098 \uc7a5\uc560\ubb3c \ub4a4\uc5d0 \uc790\uc8fc \uc228\uaca8\uc838 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uac70\uc2e4 \ub6f0\uae30\" \ub808\ubca8\uc5d0\uc11c\ub294 \uc77c\ub828\uc758 \uc0c1\uc790\ub97c \ubd80\uc218\uba74 \ud070 \uce58\uc988 \uc870\uac01\uc744 \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uce58\uc988 \uc218\uc9d1\uc5d0 \uc6b0\uc120\uc21c\uc704\ub97c \ub450\uba74 \ub354 \ub098\uc740 \ub3c4\uad6c \ubc0f \ub2a5\ub825\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\ub3c4\ub85d \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc774 \ud06c\uac8c \ud5a5\uc0c1\ub429\ub2c8\ub2e4."}, {"question": "\uacbd\uc7c1 \ud50c\ub808\uc774\ub97c \uc704\ud574 \ud1b0\uacfc \uc81c\ub9ac \ub7f0\uc5d0\uc11c \uce90\ub9ad\ud130\uc758 \ub2a5\ub825\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uce90\ub9ad\ud130\uc758 \ub2a5\ub825\uc744 \ucd5c\uc801\ud654\ud558\ub294 \uac83\uc740 \uc2a4\ud0ac \uc5c5\uadf8\ub808\uc774\ub4dc\uc640 \uc804\ub7b5\uc801\uc778 \uc0ac\uc6a9\uc758 \ud63c\ud569\uc785\ub2c8\ub2e4. 1\ub2e8\uacc4: \uc0c1\ub300\ub97c \uc81c\uc555\ud558\uae30 \uc704\ud574 \ubbfc\ucca9\uc131\uacfc \uc18d\ub3c4\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \ub370 \uc9d1\uc911\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \uc911\uc694\ud55c \uc21c\uac04\uc5d0 \"\uc18d\ub3c4 \ubd80\uc2a4\ud130\" \ud30c\uc6cc\uc5c5\uc744 \uc7a5\ucc29\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \ubcbd \uc810\ud504\uc640 \uc2ac\ub77c\uc774\ub529 \ub300\uc2dc\uc640 \uac19\uc740 \uace0\uae09 \uae30\uc220\uc744 \uc5f0\uc2b5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc81c\ub9ac\uc758 \"\ube60\ub978 \uc9c8\uc8fc\" \ub2a5\ub825\uc744 \"\ub0c9\uc7a5\uace0 \ub2ec\ub9ac\uae30\" \uc774\ubca4\ud2b8\uc5d0\uc11c \uc0ac\uc6a9\ud558\uba74 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ubcf4\ub2e4 \uc0c1\ub2f9\ud55c \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\"\uc2dc\uac04 \uc81c\ud55c\" \ubaa8\ub4dc\uac00 \ud1b0\uacfc \uc81c\ub9ac \ub7f0\uc5d0\uc11c \uc5b4\ub5a4 \uc758\ubbf8\ub97c \uac00\uc9c0\uace0 \uc788\uc73c\uba70, \uc5b4\ub5bb\uac8c \ub6f0\uc5b4\ub0a0 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud1b0\uacfc \uc81c\ub9ac \ub7f0\uc758 \"\uc2dc\uac04 \uc81c\ud55c\" \ubaa8\ub4dc\ub294 \uc18d\ub3c4\uc640 \uc815\ud655\uc131\uc744 \uc2dc\ud5d8\ud569\ub2c8\ub2e4. \ub6f0\uc5b4\ub098\uae30 \uc704\ud574\uc11c\ub294 \uac00\uc7a5 \uc9e7\uc740 \uacbd\ub85c\ub97c \uc219\ub2ec\ud558\uace0 \uc810\ud504\ub97c \uc644\ubcbd\ud558\uac8c \ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \"\ucc28\uace0 \uc9c8\uc8fc\" \ub808\ubca8\uc5d0\uc11c \uc0c1\ub2e8 \uacbd\ub85c\ub97c \uc120\ud0dd\ud558\uba74 \uadc0\uc911\ud55c \uc2dc\uac04\uc744 \uc808\uc57d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2dc\uac04\uc744 \uc77c\uc2dc\uc801\uc73c\ub85c \ub290\ub9ac\uac8c \ud574\uc8fc\ub294 \"\uc2a4\ud1b1\uc6cc\uce58\"\uc640 \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uae4c\ub2e4\ub85c\uc6b4 \uc139\uc158\uc744 \ub354\uc6b1 \uc27d\uac8c \uc774\ub3d9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \ubaa8\ub4dc\ub294 \uae30\uc220\uc744 \uc5f0\ub9c8\ud558\uace0 \ub354 \ube60\ub978 \uc2dc\uac04\uc744 \ub2ec\uc131\ud558\uae30\uc5d0 \uc644\ubcbd\ud569\ub2c8\ub2e4."}, {"question": "\ub2e4\uc591\ud55c \uac8c\uc784 \ubaa8\ub4dc\uc5d0\uc11c \ud1b0\uacfc \uc81c\ub9ac \ub7f0\uc5d0\uc11c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ud30c\uc6cc\uc5c5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud1b0\uacfc \uc81c\ub9ac \ub7f0\uc758 \ub2e4\uc591\ud55c \uac8c\uc784 \ubaa8\ub4dc\uc5d0\uc11c \ub2e4\ub978 \ud30c\uc6cc\uc5c5\uc774 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. \"\uc2dc\uac04 \uc81c\ud55c\"\uc758 \uacbd\uc6b0 \"\uc2a4\ud1b1\uc6cc\uce58\"\uac00 \ub9e4\uc6b0 \uadc0\uc911\ud569\ub2c8\ub2e4. \"\uce58\uc988 \ud68d\ub4dd\"\uc758 \uacbd\uc6b0 \"\ud22c\uba85 \ub9dd\ud1a0\"\ub294 \uac10\uc9c0 \ud53c\ud558\uae30\uc5d0 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \"\uc0dd\uc874 \ubaa8\ub4dc\"\uc758 \uacbd\uc6b0 \"\ubc29\ud328\"\ub294 \ucd94\uac00\uc801\uc778 \ubcf4\ud638 \uae30\ub2a5\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ub0c9\uc7a5\uace0 \ub2ec\ub9ac\uae30\"\uc5d0\uc11c \"\uc18d\ub3c4 \ubd80\uc2a4\ud130\"\ub97c \uc0ac\uc6a9\ud558\uba74 \uacbd\uc7c1\uc790\ubcf4\ub2e4 \uc55e\uc11c \ub098\uac08 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac01 \ud30c\uc6cc\uc5c5\uc758 \uac15\uc810\uc744 \uc774\ud574\ud558\uba74 \uc131\ub2a5\uc774 \ud06c\uac8c \ud5a5\uc0c1\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud1b0\uacfc \uc81c\ub9ac \ub7f0\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ucd5c\uc885 \uc810\uc218\ub97c \uc5b4\ub5bb\uac8c \uacc4\uc0b0\ud569\ub2c8\uae4c?", "answer": "\ud1b0\uacfc \uc81c\ub9ac \ub7f0\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc774\ub3d9 \uac70\ub9ac, \uce58\uc988 \uc218\uc9d1\ub7c9 \ubc0f \uc18c\uc694 \uc2dc\uac04 \ub4f1 \uc5ec\ub7ec \uc694\uc778\uc744 \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. \uac01 \uce58\uc988 \uc870\uac01\uc740 \uc810\uc218\uc5d0 \ucd94\uac00\ub418\uba70, \ub354 \ube60\ub978 \uc644\ub8cc \uc2dc\uac04\uc740 \ubcf4\ub108\uc2a4 \uc810\uc218\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubaa8\ub4e0 \uce58\uc988\ub97c \uc218\uc9d1\ud558\uace0 2\ubd84 \ubbf8\ub9cc\uc73c\ub85c \"\uac70\uc2e4 \ub6f0\uae30\" \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uba74 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\uba74 \ub354 \ub098\uc740 \uacb0\uacfc\ub97c \uc704\ud55c \uc804\ub7b5\uc744 \uc138\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ubaa8\ubc14\uc77c \ubc0f \ucf58\uc194 \ubc84\uc804\uc758 \ud1b0\uacfc \uc81c\ub9ac \ub7f0\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubaa8\ubc14\uc77c \ubc0f \ucf58\uc194 \ubc84\uc804\uc758 \ud1b0\uacfc \uc81c\ub9ac \ub7f0\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \uc81c\uc5b4 \ubc0f \uadf8\ub798\ud53d\uc785\ub2c8\ub2e4. \ubaa8\ubc14\uc77c \ubc84\uc804\uc740 \ud130\uce58 \uc81c\uc5b4\ub97c \uc0ac\uc6a9\ud558\ub294 \ubc18\uba74, \ucf58\uc194 \ubc84\uc804\uc740 \ub354 \uc815\ud655\ud55c \uc6c0\uc9c1\uc784\uc744 \uc81c\uacf5\ud558\ub294 \uac8c\uc784\ud328\ub4dc\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ucf58\uc194 \uadf8\ub798\ud53d\uc740 \uc2dc\uac01\uc801 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ub354 \uc790\uc138\ud55c \uc815\ubcf4\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ub4b7\ub9c8\ub2f9 \uaca9\uc804\" \ub808\ubca8\uc740 \ucf58\uc194\uc5d0\uc11c \ub354\uc6b1 \uc0dd\uc0dd\ud558\uac8c \ubcf4\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ucc28\uc774\uc810\uc5d0\ub3c4 \ubd88\uad6c\ud558\uace0 \ub450 \ubc84\uc804 \ubaa8\ub450 \ub3d9\uc77c\ud55c \ud575\uc2ec \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}, {"question": "\ubaa8\ubc14\uc77c \ubc84\uc804\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ud1b0\uacfc \uc81c\ub9ac \ub7f0 \ucf58\uc194 \ubc84\uc804\uc73c\ub85c \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ubaa8\ubc14\uc77c \ubc84\uc804\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ud1b0\uacfc \uc81c\ub9ac \ub7f0 \ucf58\uc194 \ubc84\uc804\uc73c\ub85c \uc804\uc1a1\ud558\ub294 \uac83\uc740 \uac04\ub2e8\ud569\ub2c8\ub2e4. \uba3c\uc800 \ub450 \uae30\uae30\uac00 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \uc5f0\uacb0\ub418\uc5b4 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uadf8\ub7f0 \ub2e4\uc74c \"\ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\" \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ubaa8\ubc14\uc77c \ubc84\uc804\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5c5\ub85c\ub4dc\ud569\ub2c8\ub2e4. \ub9c8\uc9c0\ub9c9\uc73c\ub85c \ucf58\uc194 \ubc84\uc804\uc5d0 \uc800\uc7a5 \ud30c\uc77c\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubaa8\ubc14\uc77c\uc5d0\uc11c \uc81c\ub9ac\uc758 \"\ube60\ub978 \uc9c8\uc8fc\"\ub97c \ud574\uc81c\ud588\uc73c\uba74 \uc804\uc1a1 \ud6c4 \ucf58\uc194\uc5d0\uc11c\ub3c4 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud1b0\uacfc \uc81c\ub9ac \ub7f0\uc5d0\uc11c \uc228\uaca8\uc9c4 \"\ud669\uae08 \uce58\uc988\"\ub97c \uc5b4\ub514\uc11c \ucc3e\uc744 \uc218 \uc788\uc73c\uba70, \ubb34\uc5c7\uc744 \ud574\uc81c\ud569\ub2c8\uae4c?", "answer": "\ud1b0\uacfc \uc81c\ub9ac \ub7f0\uc5d0\uc11c \uc228\uaca8\uc9c4 \"\ud669\uae08 \uce58\uc988\"\ub294 \ud2b9\ubcc4\ud55c \ucf58\ud150\uce20\ub97c \ud574\uc81c\ud558\ub294 \ud76c\uadc0\ud55c \uc218\uc9d1\ud488\uc785\ub2c8\ub2e4. \uc885\uc885 \ube44\ubc00 \uc601\uc5ed\uc774\ub098 \uae4c\ub2e4\ub85c\uc6b4 \uacfc\uc81c\ub97c \uc644\ub8cc\ud55c \ud6c4\uc5d0 \ubc1c\uacac\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc9c0\ud558\uc2e4 \uaca9\ud22c\" \ub808\ubca8\uc5d0\uc11c \uc0c1\uc790\ub97c \uc62e\uae30\ub294 \ud37c\uc990\uc744 \ud480\uba74 \"\ud669\uae08 \uce58\uc988\"\ub97c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub97c \uc218\uc9d1\ud558\uba74 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \ub3c5\ud2b9\ud55c \ubd84\uc704\uae30\ub97c \ub354\ud558\ub294 \ud1b0\uc744 \uc704\ud55c \ud2b9\ubcc4\ud55c \uc2a4\ud0a8\uc744 \ud574\uc81c\ud569\ub2c8\ub2e4."}]
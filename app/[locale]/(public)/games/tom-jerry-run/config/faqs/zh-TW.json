[{"question": "\u5982\u4f55\u624d\u80fd\u5728\u6e6f\u59c6\u8c93\u8207\u5091\u5229\u9f20\u8dd1\u9177\u904a\u6232\u4e2d\u5b8c\u6210\u96d9\u8df3\uff0c\u4ee5\u5230\u9054\u66f4\u9ad8\u8655\u7684\u5e73\u53f0\uff1f", "answer": "\u5728\u6e6f\u59c6\u8c93\u8207\u5091\u5229\u9f20\u8dd1\u9177\u904a\u6232\u4e2d\uff0c\u96d9\u8df3\u662f\u5230\u9054\u66f4\u9ad8\u8655\u5e73\u53f0\u7684\u5fc5\u8981\u6280\u5de7\u3002\u9996\u5148\uff0c\u6309\u4e0b\u8df3\u8e8d\u6309\u9215\u9032\u884c\u7b2c\u4e00\u6b21\u8df3\u8e8d\u3002\u5728\u7a7a\u4e2d\u6642\uff0c\u518d\u6b21\u6309\u4e0b\u8df3\u8e8d\u6309\u9215\u5373\u53ef\u57f7\u884c\u7b2c\u4e8c\u6b21\u8df3\u8e8d\u3002\u4f8b\u5982\uff0c\u5728\u64cd\u4f5c\u5091\u5229\u9f20\u6642\uff0c\u53ef\u4ee5\u4f7f\u7528\u96d9\u8df3\u4f86\u53d6\u5f97\u300e\u5eda\u623f\u6df7\u4e82\u300f\u95dc\u5361\u4e2d\u85cf\u5728\u9ad8\u8655\u7684\u5976\u916a\u3002\u6b64\u6280\u5de7\u5c0d\u65bc\u63a2\u7d22\u548c\u6536\u96c6\u734e\u52f5\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u5728\u6e6f\u59c6\u8c93\u8207\u5091\u5229\u9f20\u8dd1\u9177\u904a\u6232\u4e2d\uff0c\u5982\u4f55\u907f\u958b\u6e6f\u59c6\u8c93\u7684\u9677\u9631\uff1f\u6700\u4f73\u7b56\u7565\u70ba\u4f55\uff1f", "answer": "\u907f\u958b\u6e6f\u59c6\u8c93\u7684\u9677\u9631\u9700\u8981\u7d50\u5408\u6642\u9593\u5224\u65b7\u548c\u89c0\u5bdf\u3002\u6b65\u9a5f\u4e00\uff1a\u96a8\u6642\u6383\u63cf\u74b0\u5883\uff0c\u7559\u610f\u89f8\u767c\u9677\u9631\u7684\u7dda\u7d22\uff0c\u4f8b\u5982\u7d46\u7db2\u6216\u58d3\u529b\u677f\u3002\u6b65\u9a5f\u4e8c\uff1a\u5c0f\u5fc3\u63a7\u5236\u4f60\u7684\u52d5\u4f5c\uff0c\u7b49\u5f85\u9677\u9631\u555f\u52d5\u5f8c\u8fc5\u901f\u901a\u904e\u3002\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u4f8b\u5982\u300e\u96b1\u5f62\u6597\u7bf7\u300f\u7b49\u9053\u5177\u66ab\u6642\u7e5e\u904e\u9677\u9631\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5f8c\u9662\u5927\u6230\u300f\u95dc\u5361\uff0c\u5728\u76ea\u79cb\u5343\u7684\u6728\u69cc\u4e4b\u9593\u628a\u63e1\u597d\u6642\u9593\uff0c\u53ef\u4ee5\u907f\u514d\u88ab\u6349\u4f4f\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u5728\u6e6f\u59c6\u8c93\u8207\u5091\u5229\u9f20\u8dd1\u9177\u904a\u6232\u4e2d\u61c9\u8a72\u512a\u5148\u6536\u96c6\u5976\u916a\uff1f\u4ee5\u53ca\u5728\u54ea\u88e1\u53ef\u4ee5\u627e\u5230\u5b83\uff1f", "answer": "\u5728\u6e6f\u59c6\u8c93\u8207\u5091\u5229\u9f20\u8dd1\u9177\u904a\u6232\u4e2d\uff0c\u6536\u96c6\u5976\u916a\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u662f\u89e3\u9396\u65b0\u89d2\u8272\u548c\u5347\u7d1a\u7684\u4e3b\u8981\u8ca8\u5e63\u3002\u5976\u916a\u7d93\u5e38\u85cf\u5728\u96e3\u4ee5\u89f8\u53ca\u7684\u5730\u65b9\u6216\u969c\u7919\u7269\u5f8c\u9762\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5ba2\u5ef3\u8df3\u8e8d\u300f\u95dc\u5361\uff0c\u4f60\u53ef\u4ee5\u901a\u904e\u6253\u7834\u4e00\u7cfb\u5217\u7bb1\u5b50\u627e\u5230\u5927\u584a\u5976\u916a\u3002\u512a\u5148\u6536\u96c6\u5976\u916a\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u4f60\u7684\u904a\u6232\u9ad4\u9a57\uff0c\u63d0\u4f9b\u66f4\u597d\u7684\u5de5\u5177\u548c\u80fd\u529b\u3002"}, {"question": "\u5982\u4f55\u5728\u6e6f\u59c6\u8c93\u8207\u5091\u5229\u9f20\u8dd1\u9177\u904a\u6232\u4e2d\u512a\u5316\u89d2\u8272\u80fd\u529b\uff0c\u4ee5\u9032\u884c\u7af6\u722d\u6027\u904a\u6232\uff1f", "answer": "\u512a\u5316\u89d2\u8272\u80fd\u529b\u9700\u8981\u7d50\u5408\u6280\u80fd\u63d0\u5347\u548c\u7b56\u7565\u904b\u7528\u3002\u6b65\u9a5f\u4e00\uff1a\u5c08\u6ce8\u65bc\u63d0\u5347\u654f\u6377\u6027\u548c\u901f\u5ea6\uff0c\u4ee5\u8d85\u8d8a\u5c0d\u624b\u3002\u6b65\u9a5f\u4e8c\uff1a\u5728\u95dc\u9375\u6642\u523b\u4f7f\u7528\u300e\u52a0\u901f\u300f\u9053\u5177\u3002\u6b65\u9a5f\u4e09\uff1a\u7df4\u7fd2\u9ad8\u7d1a\u6280\u5de7\uff0c\u4f8b\u5982\u7246\u58c1\u8df3\u8e8d\u548c\u6ed1\u884c\u885d\u523a\u3002\u4f8b\u5982\uff0c\u5728\u300e\u51b0\u7bb1\u7af6\u901f\u300f\u6d3b\u52d5\u4e2d\u4f7f\u7528\u5091\u5229\u9f20\u7684\u300e\u5feb\u901f\u885d\u523a\u300f\u80fd\u529b\u53ef\u4ee5\u986f\u8457\u512a\u65bc\u5176\u4ed6\u73a9\u5bb6\u3002"}, {"question": "\u6e6f\u59c6\u8c93\u8207\u5091\u5229\u9f20\u8dd1\u9177\u904a\u6232\u4e2d\u7684\u300e\u8a08\u6642\u6311\u6230\u300f\u6a21\u5f0f\u6709\u4ec0\u9ebc\u610f\u7fa9\uff1f\u5982\u4f55\u624d\u80fd\u5728\u5176\u4e2d\u52dd\u51fa\uff1f", "answer": "\u6e6f\u59c6\u8c93\u8207\u5091\u5229\u9f20\u8dd1\u9177\u904a\u6232\u4e2d\u7684\u300e\u8a08\u6642\u6311\u6230\u300f\u6a21\u5f0f\u6e2c\u8a66\u4f60\u7684\u901f\u5ea6\u548c\u6e96\u78ba\u6027\u3002\u8981\u52dd\u51fa\uff0c\u8acb\u5c08\u6ce8\u65bc\u638c\u63e1\u6700\u77ed\u8def\u7dda\u4e26\u5b8c\u5584\u4f60\u7684\u8df3\u8e8d\u52d5\u4f5c\u3002\u4f8b\u5982\uff0c\u5728\u300e\u8eca\u5eab\u885d\u523a\u300f\u95dc\u5361\uff0c\u8d70\u4e0a\u65b9\u7684\u8def\u7dda\u53ef\u4ee5\u7bc0\u7701\u5bf6\u8cb4\u7684\u6642\u9593\u3002\u4f7f\u7528\u9053\u5177\u300e\u79d2\u8868\u300f\u66ab\u6642\u6e1b\u6162\u6642\u9593\uff0c\u8b93\u4f60\u5728\u68d8\u624b\u7684\u90e8\u5206\u66f4\u5bb9\u6613\u901a\u904e\u3002\u6b64\u6a21\u5f0f\u9069\u5408\u78e8\u7df4\u4f60\u7684\u6280\u80fd\u4e26\u53d6\u5f97\u66f4\u5feb\u7684\u6642\u9593\u3002"}, {"question": "\u54ea\u4e9b\u9053\u5177\u5728\u6e6f\u59c6\u8c93\u8207\u5091\u5229\u9f20\u8dd1\u9177\u904a\u6232\u7684\u4e0d\u540c\u904a\u6232\u6a21\u5f0f\u4e2d\u6548\u679c\u6700\u4f73\uff1f", "answer": "\u4e0d\u540c\u7684\u9053\u5177\u5728\u6e6f\u59c6\u8c93\u8207\u5091\u5229\u9f20\u8dd1\u9177\u904a\u6232\u7684\u4e0d\u540c\u904a\u6232\u6a21\u5f0f\u4e2d\u6548\u679c\u6700\u4f73\u3002\u5728\u300e\u8a08\u6642\u6311\u6230\u300f\u4e2d\uff0c\u300e\u79d2\u8868\u300f\u662f\u4e0d\u53ef\u6216\u7f3a\u7684\u3002\u5728\u300e\u596a\u53d6\u5976\u916a\u300f\u4e2d\uff0c\u300e\u96b1\u5f62\u6597\u7bf7\u300f\u6709\u52a9\u65bc\u4f60\u907f\u514d\u88ab\u767c\u73fe\u3002\u5728\u300e\u751f\u5b58\u6a21\u5f0f\u300f\u4e2d\uff0c\u300e\u76fe\u724c\u300f\u63d0\u4f9b\u984d\u5916\u7684\u4fdd\u8b77\u3002\u4f8b\u5982\uff0c\u5728\u300e\u51b0\u7bb1\u7af6\u901f\u300f\u4e2d\u4f7f\u7528\u300e\u52a0\u901f\u300f\u9053\u5177\u53ef\u4ee5\u5e6b\u52a9\u4f60\u8d85\u8d8a\u7af6\u722d\u5c0d\u624b\u3002\u4e86\u89e3\u6bcf\u7a2e\u9053\u5177\u7684\u512a\u52e2\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u4f60\u7684\u8868\u73fe\u3002"}, {"question": "\u6e6f\u59c6\u8c93\u8207\u5091\u5229\u9f20\u8dd1\u9177\u904a\u6232\u4e2d\u7684\u8a08\u5206\u7cfb\u7d71\u5982\u4f55\u8a08\u7b97\u6700\u7d42\u5f97\u5206\uff1f", "answer": "\u6e6f\u59c6\u8c93\u8207\u5091\u5229\u9f20\u8dd1\u9177\u904a\u6232\u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u591a\u500b\u56e0\u7d20\uff1a\u884c\u9032\u8ddd\u96e2\u3001\u6536\u96c6\u7684\u5976\u916a\u548c\u6240\u82b1\u6642\u9593\u3002\u6bcf\u584a\u5976\u916a\u90fd\u6703\u589e\u52a0\u4f60\u7684\u5f97\u5206\uff0c\u800c\u5b8c\u6210\u6642\u9593\u8d8a\u5feb\u5247\u6703\u7372\u5f97\u984d\u5916\u7a4d\u5206\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5ba2\u5ef3\u8df3\u8e8d\u300f\u95dc\u5361\u4e2d\uff0c\u5728\u5169\u5206\u9418\u5167\u5b8c\u6210\u6240\u6709\u95dc\u5361\u4e26\u6536\u96c6\u6240\u6709\u5976\u916a\u53ef\u4ee5\u7372\u5f97\u9ad8\u5206\u3002\u4e86\u89e3\u9019\u4e9b\u6a5f\u5236\u53ef\u4ee5\u5e6b\u52a9\u4f60\u5236\u5b9a\u7b56\u7565\uff0c\u7372\u5f97\u66f4\u597d\u7684\u6210\u7e3e\u3002"}, {"question": "\u624b\u6a5f\u7248\u548c\u4e3b\u6a5f\u7248\u6e6f\u59c6\u8c93\u8207\u5091\u5229\u9f20\u8dd1\u9177\u904a\u6232\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "\u624b\u6a5f\u7248\u548c\u4e3b\u6a5f\u7248\u6e6f\u59c6\u8c93\u8207\u5091\u5229\u9f20\u8dd1\u9177\u904a\u6232\u7684\u4e3b\u8981\u5dee\u7570\u5728\u65bc\u64cd\u63a7\u548c\u756b\u9762\u3002\u624b\u6a5f\u7248\u4f7f\u7528\u89f8\u63a7\u64cd\u63a7\uff0c\u800c\u4e3b\u6a5f\u7248\u4f7f\u7528\u904a\u6232\u624b\u67c4\uff0c\u63d0\u4f9b\u66f4\u7cbe\u78ba\u7684\u52d5\u4f5c\u3002\u4e3b\u6a5f\u7248\u7684\u756b\u9762\u66f4\u7cbe\u7d30\uff0c\u589e\u5f37\u4e86\u8996\u89ba\u9ad4\u9a57\u3002\u4f8b\u5982\uff0c\u300e\u5f8c\u9662\u5927\u6230\u300f\u95dc\u5361\u5728\u4e3b\u6a5f\u7248\u4e0a\u770b\u8d77\u4f86\u66f4\u52a0\u751f\u52d5\u3002\u5118\u7ba1\u5b58\u5728\u9019\u4e9b\u5dee\u7570\uff0c\u4f46\u5169\u7248\u904a\u6232\u90fd\u63d0\u4f9b\u76f8\u540c\u7684\u6838\u5fc3\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u5982\u4f55\u5c07\u624b\u6a5f\u7248\u6e6f\u59c6\u8c93\u8207\u5091\u5229\u9f20\u8dd1\u9177\u904a\u6232\u7684\u9032\u5ea6\u8f49\u79fb\u5230\u4e3b\u6a5f\u7248\uff1f", "answer": "\u5c07\u624b\u6a5f\u7248\u6e6f\u59c6\u8c93\u8207\u5091\u5229\u9f20\u8dd1\u9177\u904a\u6232\u7684\u9032\u5ea6\u8f49\u79fb\u5230\u4e3b\u6a5f\u7248\u975e\u5e38\u7c21\u55ae\u3002\u9996\u5148\uff0c\u78ba\u4fdd\u5169\u500b\u88dd\u7f6e\u90fd\u9023\u63a5\u5230\u540c\u4e00\u500b\u5e33\u6236\u3002\u7136\u5f8c\uff0c\u4f7f\u7528\u300e\u96f2\u7aef\u5132\u5b58\u300f\u529f\u80fd\u5c07\u624b\u6a5f\u7248\u9032\u5ea6\u4e0a\u50b3\u3002\u6700\u5f8c\uff0c\u5728\u4e3b\u6a5f\u7248\u4e0b\u8f09\u5132\u5b58\u6a94\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5df2\u5728\u624b\u6a5f\u7248\u89e3\u9396\u4e86\u5091\u5229\u9f20\u7684\u300e\u5feb\u901f\u885d\u523a\u300f\uff0c\u90a3\u9ebc\u8f49\u79fb\u5f8c\u5b83\u5c07\u5728\u4e3b\u6a5f\u7248\u4e0a\u53ef\u7528\u3002"}, {"question": "\u5728\u6e6f\u59c6\u8c93\u8207\u5091\u5229\u9f20\u8dd1\u9177\u904a\u6232\u4e2d\uff0c\u5982\u4f55\u627e\u5230\u96b1\u85cf\u7684\u300e\u9ec3\u91d1\u5976\u916a\u300f\uff1f\u5b83\u80fd\u89e3\u9396\u4ec0\u9ebc\uff1f", "answer": "\u6e6f\u59c6\u8c93\u8207\u5091\u5229\u9f20\u8dd1\u9177\u904a\u6232\u4e2d\u96b1\u85cf\u7684\u300e\u9ec3\u91d1\u5976\u916a\u300f\u662f\u7a00\u6709\u7684\u8490\u85cf\u54c1\uff0c\u89e3\u9396\u5c08\u5c6c\u5167\u5bb9\u3002\u5b83\u901a\u5e38\u85cf\u5728\u79d8\u5bc6\u5340\u57df\u6216\u5b8c\u6210\u5177\u6709\u6311\u6230\u6027\u7684\u4efb\u52d9\u5f8c\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5730\u4e0b\u5ba4\u722d\u9b25\u300f\u95dc\u5361\uff0c\u4f60\u53ef\u4ee5\u901a\u904e\u89e3\u6c7a\u6d89\u53ca\u79fb\u52d5\u7bb1\u5b50\u7684\u8b0e\u984c\u4f86\u627e\u5230\u300e\u9ec3\u91d1\u5976\u916a\u300f\u3002\u6536\u96c6\u5b83\u80fd\u89e3\u9396\u6e6f\u59c6\u8c93\u7684\u7279\u6b8a\u5916\u89c0\uff0c\u70ba\u4f60\u7684\u904a\u6232\u589e\u6dfb\u7368\u7279\u7684\u98a8\u683c\u3002"}]
[{"question": "\u30c8\u30e0\u3068\u30b8\u30a7\u30ea\u30fc\u30e9\u30f3\u3067\u3001\u3088\u308a\u9ad8\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u5230\u9054\u3059\u308b\u305f\u3081\u306b\u30c0\u30d6\u30eb\u30b8\u30e3\u30f3\u30d7\u306f\u3069\u306e\u3088\u3046\u306b\u5b9f\u884c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30c8\u30e0\u3068\u30b8\u30a7\u30ea\u30fc\u30e9\u30f3\u3067\u306f\u3001\u30c0\u30d6\u30eb\u30b8\u30e3\u30f3\u30d7\u306f\u3088\u308a\u9ad8\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u5230\u9054\u3059\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u307e\u305a\u3001\u6700\u521d\u306e\u30b8\u30e3\u30f3\u30d7\u3092\u958b\u59cb\u3059\u308b\u305f\u3081\u306b\u30b8\u30e3\u30f3\u30d7\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u307e\u3059\u3002\u7a7a\u4e2d\u3067\u3001\u30b8\u30e3\u30f3\u30d7\u30dc\u30bf\u30f3\u3092\u3082\u3046\u4e00\u5ea6\u62bc\u3057\u3066\u30012\u56de\u76ee\u306e\u30b8\u30e3\u30f3\u30d7\u3092\u5b9f\u884c\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30b8\u30a7\u30ea\u30fc\u3068\u3057\u3066\u30b2\u30fc\u30e0\u3092\u3057\u3066\u3044\u308b\u3068\u304d\u3001'\u30ad\u30c3\u30c1\u30f3\u30fb\u30ab\u30aa\u30b9'\u30ec\u30d9\u30eb\u306e\u9ad8\u3055\u306b\u3042\u308b\u30c1\u30fc\u30ba\u306b\u30a2\u30af\u30bb\u30b9\u3059\u308b\u305f\u3081\u306b\u3001\u30c0\u30d6\u30eb\u30b8\u30e3\u30f3\u30d7\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u3053\u306e\u30c6\u30af\u30cb\u30c3\u30af\u306f\u3001\u63a2\u7d22\u3068\u5831\u916c\u306e\u53ce\u96c6\u306e\u4e21\u65b9\u306b\u3068\u3063\u3066\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002"}, {"question": "\u30c8\u30e0\u3068\u30b8\u30a7\u30ea\u30fc\u30e9\u30f3\u3067\u30c8\u30e0\u306e\u30c8\u30e9\u30c3\u30d7\u3092\u56de\u907f\u3059\u308b\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30c8\u30e0\u306e\u30c8\u30e9\u30c3\u30d7\u3092\u56de\u907f\u3059\u308b\u306b\u306f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u89b3\u5bdf\u306e\u7d44\u307f\u5408\u308f\u305b\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5e38\u306b\u3001\u30c8\u30ea\u30c3\u30d7\u30ef\u30a4\u30e4\u30fc\u3084\u5727\u529b\u30d7\u30ec\u30fc\u30c8\u306a\u3069\u306e\u8996\u899a\u7684\u306a\u624b\u304c\u304b\u308a\u3092\u63a2\u3057\u3066\u74b0\u5883\u3092\u30b9\u30ad\u30e3\u30f3\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u614e\u91cd\u306b\u52d5\u304d\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u30c8\u30e9\u30c3\u30d7\u304c\u4f5c\u52d5\u3059\u308b\u306e\u3092\u5f85\u3063\u3066\u304b\u3089\u3001\u3059\u3070\u3084\u304f\u901a\u308a\u904e\u304e\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u4e00\u6642\u7684\u306b\u30c8\u30e9\u30c3\u30d7\u3092\u56de\u907f\u3059\u308b\u305f\u3081\u306b\u3001'\u30b9\u30c6\u30eb\u30b9'\u306e\u3088\u3046\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u30d0\u30c3\u30af\u30e4\u30fc\u30c9\u30fb\u30d6\u30ea\u30c3\u30c4\u300f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u63fa\u308c\u308b\u30cf\u30f3\u30de\u30fc\u306e\u9593\u3092\u8d70\u308a\u629c\u3051\u308b\u3068\u3001\u6355\u307e\u308b\u306e\u3092\u9632\u3050\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30c8\u30e0\u3068\u30b8\u30a7\u30ea\u30fc\u30e9\u30f3\u3067\u30c1\u30fc\u30ba\u3092\u53ce\u96c6\u3059\u308b\u512a\u5148\u9806\u4f4d\u3092\u4ed8\u3051\u308b\u3079\u304d\u7406\u7531\u306f\u3001\u3069\u3053\u3067\u30c1\u30fc\u30ba\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30c8\u30e0\u3068\u30b8\u30a7\u30ea\u30fc\u30e9\u30f3\u3067\u30c1\u30fc\u30ba\u3092\u53ce\u96c6\u3059\u308b\u3053\u3068\u306f\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u306a\u305c\u306a\u3089\u3001\u65b0\u3057\u3044\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3084\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u305f\u3081\u306e\u4e3b\u8981\u306a\u901a\u8ca8\u3060\u304b\u3089\u3067\u3059\u3002\u30c1\u30fc\u30ba\u306f\u3001\u624b\u306e\u5c4a\u304d\u306b\u304f\u3044\u5834\u6240\u3084\u969c\u5bb3\u7269\u5f8c\u306b\u96a0\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u304c\u3088\u304f\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u30ea\u30d3\u30f3\u30b0\u30eb\u30fc\u30e0\u30fb\u30ea\u30fc\u30d7\u300f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u4e00\u9023\u306e\u30ab\u30fc\u30c8\u30f3\u3092\u58ca\u3059\u3053\u3068\u306b\u3088\u3063\u3066\u3001\u5927\u304d\u306a\u30c1\u30fc\u30ba\u3092\u898b\u3064\u3051\u51fa\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30c1\u30fc\u30ba\u306e\u53ce\u96c6\u3092\u512a\u5148\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u826f\u3044\u30c4\u30fc\u30eb\u3084\u80fd\u529b\u3078\u306e\u30a2\u30af\u30bb\u30b9\u3092\u63d0\u4f9b\u3059\u308b\u3053\u3068\u306b\u3088\u308a\u3001\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u7af6\u4e89\u3092\u60f3\u5b9a\u3057\u3066\u3001\u30c8\u30e0\u3068\u30b8\u30a7\u30ea\u30fc\u30e9\u30f3\u3067\u81ea\u5206\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u80fd\u529b\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u80fd\u529b\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u30b9\u30ad\u30eb\u30a2\u30c3\u30d7\u3068\u6226\u7565\u7684\u306a\u4f7f\u7528\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5bfe\u6226\u76f8\u624b\u3092\u51fa\u3057\u629c\u304f\u305f\u3081\u306b\u3001\u6a5f\u654f\u6027\u3068\u901f\u5ea6\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u96c6\u4e2d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u91cd\u8981\u306a\u77ac\u9593\u306e\u305f\u3081\u306b\u300c\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u300d\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u88c5\u5099\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u58c1\u30b8\u30e3\u30f3\u30d7\u3084\u30b9\u30e9\u30a4\u30c9\u30c0\u30c3\u30b7\u30e5\u306a\u3069\u306e\u9ad8\u5ea6\u306a\u30c6\u30af\u30cb\u30c3\u30af\u3092\u5b9f\u8df5\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30b8\u30a7\u30ea\u30fc\u306e\u300c\u30af\u30a4\u30c3\u30af\u30c0\u30c3\u30b7\u30e5\u300d\u80fd\u529b\u3092\u300c\u51b7\u8535\u5eab\u3078\u306e\u30ec\u30fc\u30b9\u300d\u30a4\u30d9\u30f3\u30c8\u3067\u4f7f\u7528\u3059\u308b\u3068\u3001\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3088\u308a\u3082\u5927\u304d\u306a\u512a\u4f4d\u6027\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30c8\u30e0\u3068\u30b8\u30a7\u30ea\u30fc\u30e9\u30f3\u306e\u300e\u30bf\u30a4\u30e0\u30c8\u30e9\u30a4\u30a2\u30eb\u300f\u30e2\u30fc\u30c9\u306e\u610f\u7fa9\u306f\u4f55\u3067\u3042\u308a\u3001\u3069\u306e\u3088\u3046\u306b\u512a\u4f4d\u306b\u7acb\u3066\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30c8\u30e0\u3068\u30b8\u30a7\u30ea\u30fc\u30e9\u30f3\u306e\u300e\u30bf\u30a4\u30e0\u30c8\u30e9\u30a4\u30a2\u30eb\u300f\u30e2\u30fc\u30c9\u3067\u306f\u3001\u3042\u306a\u305f\u306e\u30b9\u30d4\u30fc\u30c9\u3068\u7cbe\u5ea6\u304c\u8a66\u3055\u308c\u307e\u3059\u3002\u512a\u4f4d\u306b\u7acb\u3064\u305f\u3081\u306b\u306f\u3001\u6700\u77ed\u30eb\u30fc\u30c8\u3092\u30de\u30b9\u30bf\u30fc\u3057\u3066\u3001\u30b8\u30e3\u30f3\u30d7\u3092\u5b8c\u74a7\u306b\u3059\u308b\u3053\u3068\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u30ac\u30ec\u30fc\u30b8\u30fb\u30c0\u30c3\u30b7\u30e5\u300f\u30ec\u30d9\u30eb\u3067\u3001\u4e0a\u5074\u30b3\u30fc\u30b9\u3092\u4f7f\u3046\u3068\u8cb4\u91cd\u306a\u6642\u9593\u3092\u7bc0\u7d04\u3067\u304d\u307e\u3059\u3002\u4e00\u6642\u7684\u306b\u6642\u9593\u3092\u9045\u304f\u3059\u308b\u300e\u30b9\u30c8\u30c3\u30d7\u30a6\u30a9\u30c3\u30c1\u300f\u306a\u3069\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u96e3\u3057\u3044\u30bb\u30af\u30b7\u30e7\u30f3\u3092\u3088\u308a\u7c21\u5358\u306b\u30ca\u30d3\u30b2\u30fc\u30c8\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u30e2\u30fc\u30c9\u306f\u3001\u3042\u306a\u305f\u306e\u30b9\u30ad\u30eb\u3092\u78e8\u3044\u3066\u3001\u3088\u308a\u901f\u3044\u30bf\u30a4\u30e0\u3092\u9054\u6210\u3059\u308b\u306e\u306b\u6700\u9069\u3067\u3059\u3002"}, {"question": "\u3055\u307e\u3056\u307e\u306a\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u3067\u3001\u30c8\u30e0\u3068\u30b8\u30a7\u30ea\u30fc\u30e9\u30f3\u3067\u6700\u3082\u52b9\u679c\u7684\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30c8\u30e0\u3068\u30b8\u30a7\u30ea\u30fc\u30e9\u30f3\u3067\u3055\u307e\u3056\u307e\u306a\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u306b\u52b9\u679c\u7684\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u7570\u306a\u308a\u307e\u3059\u3002\u300e\u30bf\u30a4\u30e0\u30c8\u30e9\u30a4\u30a2\u30eb\u300f\u3067\u306f\u3001\u300e\u30b9\u30c8\u30c3\u30d7\u30a6\u30a9\u30c3\u30c1\u300f\u304c\u975e\u5e38\u306b\u4fa1\u5024\u304c\u3042\u308a\u307e\u3059\u3002\u300e\u30c1\u30fc\u30ba\u596a\u53d6\u300f\u3067\u306f\u3001\u300e\u30b9\u30c6\u30eb\u30b9\u300f\u304c\u691c\u51fa\u3092\u56de\u907f\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u300e\u30b5\u30d0\u30a4\u30d0\u30eb\u30e2\u30fc\u30c9\u300f\u3067\u306f\u3001\u300e\u30b7\u30fc\u30eb\u30c9\u300f\u304c\u8ffd\u52a0\u306e\u4fdd\u8b77\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u51b7\u8535\u5eab\u3078\u306e\u30ec\u30fc\u30b9\u300f\u3067\u300e\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u300f\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u7af6\u5408\u76f8\u624b\u3092\u8ffd\u3044\u8d8a\u3059\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u5404\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306e\u5f37\u3055\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u3042\u306a\u305f\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30c8\u30e0\u3068\u30b8\u30a7\u30ea\u30fc\u30e9\u30f3\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6700\u7d42\u7684\u306a\u30b9\u30b3\u30a2\u3092\u3069\u306e\u3088\u3046\u306b\u8a08\u7b97\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30c8\u30e0\u3068\u30b8\u30a7\u30ea\u30fc\u30e9\u30f3\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u79fb\u52d5\u8ddd\u96e2\u3001\u53ce\u96c6\u3057\u305f\u30c1\u30fc\u30ba\u3001\u8cbb\u3084\u3057\u305f\u6642\u9593\u3068\u3044\u3046\u8907\u6570\u306e\u8981\u7d20\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u5404\u30c1\u30fc\u30ba\u30d4\u30fc\u30b9\u306f\u3042\u306a\u305f\u306e\u30b9\u30b3\u30a2\u306b\u52a0\u3048\u3089\u308c\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u3088\u308a\u901f\u3044\u30af\u30ea\u30a2\u30bf\u30a4\u30e0\u306f\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u30ea\u30d3\u30f3\u30b0\u30eb\u30fc\u30e0\u30fb\u30ea\u30fc\u30d7\u300f\u30ec\u30d9\u30eb\u30922\u5206\u672a\u6e80\u3067\u30af\u30ea\u30a2\u3057\u3001\u3059\u3079\u3066\u306e\u30c1\u30fc\u30ba\u3092\u53ce\u96c6\u3059\u308b\u3068\u3001\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u826f\u3044\u7d50\u679c\u3092\u5f97\u308b\u305f\u3081\u306e\u6226\u7565\u3092\u7acb\u3066\u3084\u3059\u304f\u306a\u308a\u307e\u3059\u3002"}, {"question": "\u30e2\u30d0\u30a4\u30eb\u7248\u3068\u30b3\u30f3\u30bd\u30fc\u30eb\u7248\u306e\u30c8\u30e0\u3068\u30b8\u30a7\u30ea\u30fc\u30e9\u30f3\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30e2\u30d0\u30a4\u30eb\u7248\u3068\u30b3\u30f3\u30bd\u30fc\u30eb\u7248\u306e\u30c8\u30e0\u3068\u30b8\u30a7\u30ea\u30fc\u30e9\u30f3\u306f\u3001\u4e3b\u306b\u64cd\u4f5c\u65b9\u6cd5\u3068\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u304c\u7570\u306a\u308a\u307e\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u7248\u306f\u30bf\u30c3\u30c1\u64cd\u4f5c\u3092\u4f7f\u7528\u3057\u307e\u3059\u304c\u3001\u30b3\u30f3\u30bd\u30fc\u30eb\u7248\u306f\u30b2\u30fc\u30e0\u30d1\u30c3\u30c9\u3092\u4f7f\u7528\u3059\u308b\u305f\u3081\u3001\u3088\u308a\u6b63\u78ba\u306a\u52d5\u304d\u3092\u5b9f\u73fe\u3067\u304d\u307e\u3059\u3002\u30b3\u30f3\u30bd\u30fc\u30eb\u7248\u306e\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u306f\u3088\u308a\u8a73\u7d30\u3067\u3001\u8996\u899a\u7684\u306a\u4f53\u9a13\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u30d0\u30c3\u30af\u30e4\u30fc\u30c9\u30fb\u30d6\u30ea\u30c3\u30c4\u300f\u30ec\u30d9\u30eb\u306f\u30b3\u30f3\u30bd\u30fc\u30eb\u7248\u3067\u3088\u308a\u9bae\u3084\u304b\u306b\u898b\u3048\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u9055\u3044\u306b\u3082\u304b\u304b\u308f\u3089\u305a\u3001\u4e21\u65b9\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u306f\u540c\u3058\u57fa\u672c\u7684\u306a\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002"}, {"question": "\u30e2\u30d0\u30a4\u30eb\u7248\u304b\u3089\u30b3\u30f3\u30bd\u30fc\u30eb\u7248\u306e\u30c8\u30e0\u3068\u30b8\u30a7\u30ea\u30fc\u30e9\u30f3\u306b\u9032\u884c\u72b6\u6cc1\u3092\u79fb\u884c\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30e2\u30d0\u30a4\u30eb\u7248\u304b\u3089\u30b3\u30f3\u30bd\u30fc\u30eb\u7248\u306e\u30c8\u30e0\u3068\u30b8\u30a7\u30ea\u30fc\u30e9\u30f3\u306b\u9032\u884c\u72b6\u6cc1\u3092\u79fb\u884c\u3059\u308b\u3053\u3068\u306f\u7c21\u5358\u3067\u3059\u3002\u307e\u305a\u3001\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u304c\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u63a5\u7d9a\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u6b21\u306b\u3001\u30e2\u30d0\u30a4\u30eb\u7248\u306e\u9032\u6357\u72b6\u6cc1\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3059\u308b\u305f\u3081\u306b\u300c\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u300d\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u6700\u5f8c\u306b\u3001\u30bb\u30fc\u30d6\u30d5\u30a1\u30a4\u30eb\u3092\u30b3\u30f3\u30bd\u30fc\u30eb\u7248\u3067\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30e2\u30d0\u30a4\u30eb\u7248\u3067\u30b8\u30a7\u30ea\u30fc\u306e\u300c\u30af\u30a4\u30c3\u30af\u30c0\u30c3\u30b7\u30e5\u300d\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u3066\u3044\u308b\u5834\u5408\u3001\u8ee2\u9001\u5f8c\u3001\u30b3\u30f3\u30bd\u30fc\u30eb\u7248\u3067\u3082\u5229\u7528\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002"}, {"question": "\u30c8\u30e0\u3068\u30b8\u30a7\u30ea\u30fc\u30e9\u30f3\u3067\u96a0\u3055\u308c\u305f\u300e\u30b4\u30fc\u30eb\u30c7\u30f3\u30c1\u30fc\u30ba\u300f\u306f\u3069\u3053\u3067\u898b\u3064\u304b\u308a\u3001\u4f55\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u304b\uff1f", "answer": "\u30c8\u30e0\u3068\u30b8\u30a7\u30ea\u30fc\u30e9\u30f3\u306e\u96a0\u3055\u308c\u305f\u300e\u30b4\u30fc\u30eb\u30c7\u30f3\u30c1\u30fc\u30ba\u300f\u306f\u3001\u7279\u5225\u306a\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u30ec\u30a2\u306a\u30b3\u30ec\u30af\u30bf\u30d6\u30eb\u30a2\u30a4\u30c6\u30e0\u3067\u3059\u3002\u79d8\u5bc6\u306e\u30a8\u30ea\u30a2\u3084\u3001\u96e3\u3057\u3044\u30bf\u30b9\u30af\u3092\u5b8c\u4e86\u3057\u305f\u5f8c\u306b\u898b\u3064\u304b\u308b\u3053\u3068\u304c\u3088\u304f\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u5730\u4e0b\u5ba4\u306e\u6226\u3044\u300f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30ab\u30fc\u30c8\u30f3\u3092\u52d5\u304b\u3059\u30d1\u30ba\u30eb\u3092\u89e3\u6c7a\u3059\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u300e\u30b4\u30fc\u30eb\u30c7\u30f3\u30c1\u30fc\u30ba\u300f\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305d\u308c\u3092\u53ce\u96c6\u3059\u308b\u3068\u3001\u30c8\u30e0\u306e\u7279\u5225\u306a\u30b9\u30ad\u30f3\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u72ec\u7279\u306e\u500b\u6027\u3092\u52a0\u3048\u307e\u3059\u3002"}]
[{"question": "\u5982\u4f55\u958b\u59cb\u5728FNF\uff1aSalty's Sunday Night\u73a9\u904a\u6232\uff0c\u6211\u662f\u5b8c\u5168\u7684\u65b0\u624b\uff1f", "answer": "\u8981\u958b\u59cb\u73a9FNF\uff1aSalty's Sunday Night\uff0c\u9996\u5148\u9700\u8981\u5f9e\u5b98\u65b9\u5e73\u53f0\u4e0b\u8f09\u4e26\u5b89\u88dd\u904a\u6232\u3002\u5b89\u88dd\u5b8c\u6210\u5f8c\uff0c\u555f\u52d5\u904a\u6232\uff0c\u7136\u5f8c\u524d\u5f80\u300e\u6545\u4e8b\u6a21\u5f0f\u300f\u9032\u884c\u5f15\u5c0e\u5f0f\u5165\u9580\u3002\u8acb\u719f\u6089\u57fa\u672c\u63a7\u5236\uff1a\u65b9\u5411\u9375\u5c0d\u61c9\u87a2\u5e55\u4e0a\u51fa\u73fe\u7684\u97f3\u7b26\u3002\u4f8b\u5982\uff0c\u7576\u97f3\u7b26\u8207\u6307\u793a\u5668\u5c0d\u9f4a\u6642\uff0c\u8acb\u6309\u4e0b\u5c0d\u61c9\u7684\u65b9\u5411\u9375\u3002\u5728\u300e\u81ea\u7531\u6a21\u5f0f\u300f\u7df4\u7fd2\uff0c\u4ee5\u63d0\u5347\u60a8\u7684\u7bc0\u594f\u611f\u548c\u6e96\u78ba\u5ea6\u3002\u8acb\u8a18\u4f4f\uff0c\u6301\u7e8c\u7df4\u7fd2\u662f\u638c\u63e1\u904a\u6232\u7684\u95dc\u9375\u3002"}, {"question": "\u70ba\u4ec0\u9ebcFNF\uff1aSalty's Sunday Night\u4e2d\u6709\u4e9b\u97f3\u7b26\u6bd4\u5176\u4ed6\u97f3\u7b26\u66f4\u96e3\u64ca\u4e2d\uff1f", "answer": "\u5728FNF\uff1aSalty's Sunday Night\u4e2d\uff0c\u64ca\u4e2d\u97f3\u7b26\u7684\u96e3\u5ea6\u6703\u56e0\u5176\u4f4d\u7f6e\u548c\u6642\u6a5f\u800c\u7570\u3002\u6709\u4e9b\u97f3\u7b26\u5f7c\u6b64\u9593\u8ddd\u8f03\u8fd1\uff0c\u6216\u9700\u8981\u66f4\u5feb\u7684\u53cd\u61c9\u80fd\u529b\uff0c\u56e0\u6b64\u66f4\u5177\u6311\u6230\u6027\u3002\u4f8b\u5982\uff0c\u5728\u300eSalty\u300f\u6b4c\u66f2\u4e2d\uff0c\u60a8\u6703\u9047\u5230\u4e00\u7cfb\u5217\u5feb\u901f\u9023\u7e8c\u7684\u97f3\u7b26\uff0c\u8003\u9a57\u60a8\u7684\u901f\u5ea6\u548c\u7cbe\u78ba\u5ea6\u3002\u70ba\u63d0\u5347\u8868\u73fe\uff0c\u8acb\u5c08\u6ce8\u65bc\u9810\u6e2c\u7bc0\u594f\uff0c\u4e26\u5148\u5728\u7bc0\u594f\u8f03\u6162\u7684\u6b4c\u66f2\u4e2d\u7df4\u7fd2\uff0c\u7136\u5f8c\u518d\u5617\u8a66\u66f4\u8907\u96dc\u7684\u66f2\u76ee\u3002\u4f7f\u7528\u7bc0\u62cd\u5668\u61c9\u7528\u7a0b\u5f0f\u4e5f\u53ef\u4ee5\u5e6b\u52a9\u60a8\u5167\u5316\u7bc0\u62cd\u3002"}, {"question": "\u5728FNF\uff1aSalty's Sunday Night\u4e2d\uff0c\u9054\u6210\u9ad8\u5206\u6578\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728FNF\uff1aSalty's Sunday Night\u4e2d\u9054\u6210\u9ad8\u5206\u6578\u9700\u8981\u4e00\u4e9b\u7b56\u7565\u3002\u6b65\u9a5f1\uff1a\u59cb\u7d42\u8ffd\u6c42\u300cSick\u300d\u64ca\u6253\uff0c\u5373\u6642\u9593\u5b8c\u7f8e\u4e14\u5f97\u5206\u6700\u9ad8\u7684\u64ca\u6253\u3002\u6b65\u9a5f2\uff1a\u5229\u7528\u300c\u9023\u64ca\u300d\u7cfb\u7d71\uff0c\u4fdd\u6301\u9023\u7e8c\u64ca\u6253\u800c\u4e0d\u932f\u904e\u4efb\u4f55\u97f3\u7b26\u3002\u6b65\u9a5f3\uff1a\u5c08\u6ce8\u65bc\u6e96\u78ba\u5ea6\u800c\u4e0d\u662f\u901f\u5ea6\uff1b\u5b8c\u7f8e\u64ca\u4e2d\u8f03\u5c11\u7684\u97f3\u7b26\uff0c\u52dd\u65bc\u5306\u5fd9\u800c\u932f\u904e\u8a31\u591a\u3002\u4f8b\u5982\uff0c\u5728\u300eRetro\u300f\u6b4c\u66f2\u4e2d\uff0c\u4fdd\u6301\u7a69\u5b9a\u7684\u7bc0\u594f\u5c07\u6709\u52a9\u65bc\u5efa\u7acb\u9ad8\u9023\u64ca\u6578\uff0c\u4e26\u6700\u5927\u5316\u60a8\u7684\u5f97\u5206\u3002\u5b9a\u671f\u7df4\u7fd2\u4ee5\u7cbe\u9032\u60a8\u7684\u7bc0\u594f\u611f\u548c\u7cbe\u6e96\u5ea6\u3002"}, {"question": "\u5982\u4f55\u6539\u5584\u6211\u5728FNF\uff1aSalty's Sunday Night\u4e2d\u8655\u7406\u5feb\u901f\u97f3\u7b26\u5e8f\u5217\u7684\u53cd\u61c9\u6642\u9593\uff1f", "answer": "\u6539\u5584\u5728FNF\uff1aSalty's Sunday Night\u4e2d\u8655\u7406\u5feb\u901f\u97f3\u7b26\u5e8f\u5217\u7684\u53cd\u61c9\u6642\u9593\uff0c\u9700\u8981\u6301\u7e8c\u7684\u7df4\u7fd2\u548c\u5c08\u6ce8\u3002\u6b65\u9a5f1\uff1a\u5f9e\u8f03\u6162\u7684\u6b4c\u66f2\u958b\u59cb\uff0c\u5efa\u7acb\u5805\u5be6\u7684\u57fa\u790e\u3002\u6b65\u9a5f2\uff1a\u9010\u6b65\u63d0\u5347\u96e3\u5ea6\uff0c\u64ad\u653e\u50cf\u300eMouthful\u300f\u9019\u6a23\u7684\u5feb\u7bc0\u594f\u66f2\u76ee\u3002\u6b65\u9a5f3\uff1a\u904b\u7528\u8996\u89ba\u5316\u6280\u5de7\uff0c\u5728\u97f3\u7b26\u51fa\u73fe\u4e4b\u524d\u9810\u6e2c\u97f3\u7b26\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u5728\u300eSpookeez\u300f\u6b4c\u66f2\u4e2d\uff0c\u9810\u5148\u60f3\u50cf\u5373\u5c07\u51fa\u73fe\u7684\u97f3\u7b26\u5e8f\u5217\uff0c\u70ba\u60a8\u7684\u624b\u6307\u505a\u597d\u6e96\u5099\u3002\u6b64\u5916\uff0c\u8acb\u78ba\u4fdd\u60a8\u7684\u9375\u76e4\u6216\u63a7\u5236\u5668\u5728\u9577\u6642\u9593\u904a\u6232\u6642\u53cd\u61c9\u9748\u654f\u4e14\u8212\u9069\u3002"}, {"question": "\u6211\u61c9\u8a72\u8abf\u6574\u54ea\u4e9b\u8a2d\u5b9a\u4ee5\u512a\u5316\u6211\u5728FNF\uff1aSalty's Sunday Night\u4e2d\u7684\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u512a\u5316\u5728FNF\uff1aSalty's Sunday Night\u4e2d\u7684\u904a\u6232\u9ad4\u9a57\uff0c\u9700\u8981\u8abf\u6574\u4e00\u4e9b\u8a2d\u5b9a\u3002\u9996\u5148\uff0c\u6821\u6e96\u300c\u97f3\u7b26\u504f\u79fb\u300d\u4ee5\u78ba\u4fdd\u97f3\u7b26\u8207\u87a2\u5e55\u7684\u87a2\u5e55\u66f4\u65b0\u7387\u5b8c\u7f8e\u5c0d\u9f4a\u3002\u5176\u6b21\uff0c\u8abf\u6574\u300c\u6372\u52d5\u901f\u5ea6\u300d\u81f3\u8212\u9069\u7684\u6c34\u5e73\uff0c\u4ee5\u7b26\u5408\u60a8\u7684\u53cd\u61c9\u6642\u9593\u3002\u4f8b\u5982\uff0c\u8f03\u9ad8\u7684\u6372\u52d5\u901f\u5ea6\u53ef\u4ee5\u4f7f\u50cf\u300ePhilly Nice\u300f\u9019\u6a23\u7684\u5feb\u7bc0\u594f\u6b4c\u66f2\u66f4\u5bb9\u6613\u8655\u7406\u3002\u6700\u5f8c\uff0c\u555f\u7528\u300c\u5e7d\u9748\u9ede\u64ca\u300d\u529f\u80fd\uff0c\u4ee5\u9632\u6b62\u5728\u6309\u4e0b\u9375\u76e4\u904e\u65e9\u6642\u932f\u904e\u97f3\u7b26\u3002\u5617\u8a66\u9019\u4e9b\u8a2d\u5b9a\uff0c\u627e\u5230\u6700\u9069\u5408\u60a8\u904a\u6232\u98a8\u683c\u7684\u914d\u7f6e\u3002"}, {"question": "FNF\uff1aSalty's Sunday Night\u4e2d\u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u5b83\uff1f", "answer": "FNF\uff1aSalty's Sunday Night\u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u60a8\u9ede\u64ca\u7684\u6e96\u78ba\u6027\u548c\u6642\u6a5f\u3002\u6bcf\u500b\u97f3\u7b26\u90fd\u53ef\u4ee5\u88ab\u64ca\u6253\u70ba\u300cSick\u300d\uff08\u5b8c\u7f8e\uff09\u3001\u300cGood\u300d\uff08\u7a0d\u5fae\u504f\u96e2\uff09\u3001\u300cBad\u300d\uff08\u932f\u904e\uff09\u6216\u300cShit\u300d\uff08\u5b8c\u5168\u932f\u904e\uff09\u3002\u300cSick\u300d\u64ca\u6253\u7372\u5f97\u6700\u591a\u7a4d\u5206\uff0c\u300cShit\u300d\u64ca\u6253\u5c0e\u81f4\u7a4d\u5206\u640d\u5931\u3002\u6b64\u5916\uff0c\u4fdd\u6301\u9023\u64ca\uff08\u5728\u6c92\u6709\u932f\u904e\u4efb\u4f55\u97f3\u7b26\u7684\u60c5\u6cc1\u4e0b\u9023\u7e8c\u64ca\u6253\u97f3\u7b26\uff09\u6703\u63d0\u9ad8\u4f60\u7684\u5f97\u5206\u500d\u6578\u3002\u4f8b\u5982\uff0c\u5728\u300eSouth\u300f\u6b4c\u66f2\u4e2d\uff0c\u5b8c\u7f8e\u64ca\u4e2d\u6240\u6709\u97f3\u7b26\u5c07\u6700\u5927\u5316\u60a8\u7684\u5f97\u5206\u548c\u9023\u64ca\u6578\u3002\u7df4\u7fd2\u7cbe\u6e96\u5ea6\uff0c\u4ee5\u6301\u7e8c\u53d6\u5f97\u9ad8\u5206\u3002"}, {"question": "FNF\uff1aSalty's Sunday Night\u4e2d\u5404\u7a2e\u96e3\u5ea6\u7b49\u7d1a\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "FNF\uff1aSalty's Sunday Night\u7684\u96e3\u5ea6\u7b49\u7d1a\u65e8\u5728\u8fce\u5408\u4e0d\u540c\u6280\u5de7\u6c34\u5e73\u7684\u73a9\u5bb6\u3002\u300c\u7c21\u55ae\u300d\u6a21\u5f0f\u7684\u97f3\u7b26\u901f\u5ea6\u8f03\u6162\uff0c\u6a21\u5f0f\u8f03\u7c21\u55ae\uff0c\u9069\u5408\u65b0\u624b\u3002 \u300c\u666e\u901a\u300d\u6a21\u5f0f\u589e\u52a0\u4e86\u97f3\u7b26\u5e8f\u5217\u7684\u901f\u5ea6\u548c\u8907\u96dc\u6027\uff0c\u63d0\u4f9b\u5e73\u8861\u7684\u6311\u6230\u3002 \u300c\u56f0\u96e3\u300d\u6a21\u5f0f\u5f15\u5165\u4e86\u5feb\u901f\u97f3\u7b26\u5e8f\u5217\u548c\u8907\u96dc\u7684\u6a21\u5f0f\uff0c\u9069\u5408\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u3002\u4f8b\u5982\uff0c\u5728\u300c\u56f0\u96e3\u300d\u6a21\u5f0f\u7684\u300cDad Battle\u300d\u6b4c\u66f2\u4e2d\uff0c\u5305\u542b\u5feb\u901f\u7bc0\u594f\u7684\u97f3\u7b26\u4e32\u6d41\uff0c\u8003\u9a57\u60a8\u7684\u53cd\u61c9\u901f\u5ea6\u548c\u7cbe\u78ba\u5ea6\u3002\u9078\u64c7\u5339\u914d\u60a8\u6280\u80fd\u6c34\u5e73\u7684\u96e3\u5ea6\uff0c\u4e26\u9010\u6b65\u63d0\u5347\u81f3\u66f4\u5177\u6311\u6230\u6027\u7684\u6a21\u5f0f\u3002"}, {"question": "\u5982\u4f55\u5728FNF\uff1aSalty's Sunday Night\u4e2d\u5c07\u904a\u6232\u9032\u5ea6\u5f9e\u4e00\u500b\u5e73\u53f0\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u5e73\u53f0\uff1f", "answer": "\u5728FNF\uff1aSalty's Sunday Night\u4e2d\uff0c\u5728\u5e73\u53f0\u4e4b\u9593\u8f49\u79fb\u60a8\u7684\u904a\u6232\u9032\u5ea6\u5305\u542b\u5e7e\u500b\u6b65\u9a5f\u3002\u6b65\u9a5f1\uff1a\u5728\u539f\u5e73\u53f0\u4e0a\u627e\u5230\u60a8\u7684\u5132\u5b58\u6a94\u6848\uff1b\u5b83\u901a\u5e38\u5132\u5b58\u5728\u904a\u6232\u5b89\u88dd\u76ee\u9304\u4e2d\u3002\u6b65\u9a5f2\uff1a\u5c07\u5132\u5b58\u6a94\u6848\u8907\u88fd\u5230USB\u96a8\u8eab\u789f\u6216\u96f2\u7aef\u5132\u5b58\u3002\u6b65\u9a5f3\uff1a\u5728\u65b0\u5e73\u53f0\u4e0a\u5b89\u88dd\u904a\u6232\uff0c\u4e26\u5c07\u9810\u8a2d\u5132\u5b58\u6a94\u6848\u66ff\u63db\u70ba\u60a8\u8907\u88fd\u7684\u6a94\u6848\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5f9ePC\u79fb\u52d5\u5230Mac\uff0c\u8acb\u78ba\u4fdd\u5132\u5b58\u6a94\u6848\u8207\u5169\u500b\u7cfb\u7d71\u76f8\u5bb9\u3002\u5728\u8f49\u79fb\u524d\u59cb\u7d42\u5099\u4efd\u60a8\u7684\u5132\u5b58\u6a94\u6848\uff0c\u4ee5\u9632\u6b62\u8cc7\u6599\u907a\u5931\u3002"}, {"question": "\u5728FNF\uff1aSalty's Sunday Night\u4e2d\uff0c\u6211\u80fd\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u79d8\u5bc6\u6216\u5f69\u86cb\uff1f", "answer": "FNF\uff1aSalty's Sunday Night\u4e2d\u5145\u6eff\u4e86\u5c08\u6ce8\u7684\u73a9\u5bb6\u53ef\u4ee5\u767c\u73fe\u7684\u96b1\u85cf\u79d8\u5bc6\u548c\u5f69\u86cb\u3002\u5176\u4e2d\u4e00\u500b\u986f\u8457\u7684\u5f69\u86cb\u662f\u300eSalty\u300f\u89d2\u8272\u5728\u300eSpookeez\u300f\u6b4c\u66f2\u4e2d\u7368\u7279\u5c0d\u8a71\uff0c\u5b83\u53c3\u8003\u4e86\u904a\u6232\u7684\u958b\u767c\u6b77\u53f2\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u6b4c\u66f2\u5305\u542b\u5728\u7279\u5b9a\u689d\u4ef6\u4e0b\u6703\u555f\u7528\u7684\u96b1\u85cf\u8996\u89ba\u6548\u679c\u3002\u4f8b\u5982\uff0c\u5728\u300eM.I.L.F\u300f\u6b4c\u66f2\u4e2d\u7372\u5f97\u5b8c\u7f8e\u5f97\u5206\u6703\u89e3\u9396\u7279\u6b8a\u52d5\u756b\u3002\u4ed4\u7d30\u63a2\u7d22\u904a\u6232\uff0c\u5617\u8a66\u4e0d\u540c\u7684\u52d5\u4f5c\u4f86\u63ed\u793a\u9019\u4e9b\u96b1\u85cf\u7684\u5bf6\u85cf\u3002"}]
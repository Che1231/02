[{"question": "\u4f5c\u4e3a\u5b8c\u5168\u7684\u521d\u5b66\u8005\uff0c\u6211\u8be5\u5982\u4f55\u5f00\u59cb\u73a9 FNF: Salty's Sunday Night\uff1f", "answer": "\u8981\u5f00\u59cb\u73a9 FNF: Salty's Sunday Night\uff0c\u9996\u5148\u4ece\u5b98\u65b9\u5e73\u53f0\u4e0b\u8f7d\u5e76\u5b89\u88c5\u6e38\u620f\u3002\u5b89\u88c5\u5b8c\u6210\u540e\uff0c\u542f\u52a8\u6e38\u620f\u5e76\u5bfc\u822a\u5230\u201c\u6545\u4e8b\u6a21\u5f0f\u201d\u4ee5\u83b7\u5f97\u5f15\u5bfc\u5f0f\u4ecb\u7ecd\u3002\u719f\u6089\u57fa\u672c\u63a7\u4ef6\uff1a\u7bad\u5934\u952e\u5bf9\u5e94\u4e8e\u5c4f\u5e55\u4e0a\u51fa\u73b0\u7684\u97f3\u7b26\u3002\u4f8b\u5982\uff0c\u5f53\u97f3\u7b26\u4e0e\u6307\u793a\u5668\u5bf9\u9f50\u65f6\uff0c\u6309\u4e0b\u76f8\u5e94\u7684\u7bad\u5934\u952e\u3002\u5728\u201c\u81ea\u7531\u6e38\u620f\u201d\u6a21\u5f0f\u4e0b\u7ec3\u4e60\u4ee5\u63d0\u9ad8\u60a8\u7684\u65f6\u673a\u548c\u51c6\u786e\u6027\u3002\u8bf7\u8bb0\u4f4f\uff0c\u6301\u7eed\u7ec3\u4e60\u662f\u638c\u63e1\u6e38\u620f\u7684\u5173\u952e\u3002"}, {"question": "\u4e3a\u4ec0\u4e48 FNF: Salty's Sunday Night \u4e2d\u7684\u67d0\u4e9b\u97f3\u7b26\u6bd4\u5176\u4ed6\u97f3\u7b26\u66f4\u96be\u51fb\u4e2d\uff1f", "answer": "\u5728 FNF: Salty's Sunday Night \u4e2d\uff0c\u51fb\u4e2d\u97f3\u7b26\u7684\u96be\u5ea6\u56e0\u5176\u4f4d\u7f6e\u548c\u65f6\u673a\u800c\u5f02\u3002\u6709\u4e9b\u97f3\u7b26\u653e\u7f6e\u5f97\u66f4\u8fd1\uff0c\u6216\u8005\u9700\u8981\u66f4\u5feb\u7684\u53cd\u5e94\u901f\u5ea6\uff0c\u8fd9\u4f7f\u5f97\u5b83\u4eec\u66f4\u5177\u6311\u6218\u6027\u3002\u4f8b\u5982\uff0c\u5728\u201cSalty\u201d\u6b4c\u66f2\u4e2d\uff0c\u60a8\u4f1a\u9047\u5230\u5feb\u901f\u7684\u97f3\u7b26\u5e8f\u5217\uff0c\u8003\u9a8c\u60a8\u7684\u901f\u5ea6\u548c\u7cbe\u786e\u5ea6\u3002\u4e3a\u4e86\u63d0\u9ad8\uff0c\u8bf7\u4e13\u6ce8\u4e8e\u9884\u6d4b\u8282\u594f\uff0c\u5e76\u5728\u5c1d\u8bd5\u66f4\u590d\u6742\u7684\u66f2\u76ee\u4e4b\u524d\uff0c\u5148\u7ec3\u4e60\u8282\u594f\u8f83\u6162\u7684\u6b4c\u66f2\u3002\u4f7f\u7528\u8282\u62cd\u5668\u5e94\u7528\u7a0b\u5e8f\u4e5f\u53ef\u4ee5\u5e2e\u52a9\u60a8\u5185\u5316\u8282\u62cd\u3002"}, {"question": "\u5728 FNF: Salty's Sunday Night \u4e2d\u83b7\u5f97\u9ad8\u5206\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728 FNF: Salty's Sunday Night \u4e2d\u83b7\u5f97\u9ad8\u5206\u6d89\u53ca\u591a\u79cd\u7b56\u7565\u3002\u7b2c\u4e00\u6b65\uff1a\u59cb\u7ec8\u7784\u51c6\u201cSick\u201d\u547d\u4e2d\uff0c\u8fd9\u662f\u5b8c\u7f8e\u7684\u65f6\u95f4\uff0c\u53ef\u4ee5\u4ea7\u751f\u6700\u591a\u7684\u5206\u6570\u3002\u7b2c\u4e8c\u6b65\uff1a\u901a\u8fc7\u4fdd\u6301\u8fde\u7eed\u547d\u4e2d\u7684\u8fde\u51fb\u800c\u4e0d\u9057\u6f0f\u4efb\u4f55\u97f3\u7b26\u6765\u5229\u7528\u201c\u8fde\u51fb\u201d\u7cfb\u7edf\u3002\u7b2c\u4e09\u6b65\uff1a\u4e13\u6ce8\u4e8e\u51c6\u786e\u6027\u800c\u4e0d\u662f\u901f\u5ea6\uff1b\u5b8c\u7f8e\u5730\u51fb\u4e2d\u8f83\u5c11\u7684\u97f3\u7b26\u6bd4\u5306\u5fd9\u9057\u6f0f\u8bb8\u591a\u97f3\u7b26\u66f4\u597d\u3002\u4f8b\u5982\uff0c\u5728\u201cRetro\u201d\u6b4c\u66f2\u4e2d\uff0c\u4fdd\u6301\u7a33\u5b9a\u7684\u8282\u594f\u5c06\u5e2e\u52a9\u60a8\u5efa\u7acb\u9ad8\u8fde\u51fb\u5e76\u6700\u5927\u5316\u60a8\u7684\u5206\u6570\u3002\u5b9a\u671f\u7ec3\u4e60\u4ee5\u63d0\u9ad8\u60a8\u7684\u65f6\u673a\u548c\u7cbe\u786e\u5ea6\u3002"}, {"question": "\u5982\u4f55\u63d0\u9ad8\u6211\u5728 FNF: Salty's Sunday Night \u4e2d\u5bf9\u66f4\u5feb\u97f3\u7b26\u5e8f\u5217\u7684\u53cd\u5e94\u65f6\u95f4\uff1f", "answer": "\u63d0\u9ad8\u5728 FNF: Salty's Sunday Night \u4e2d\u5bf9\u66f4\u5feb\u97f3\u7b26\u5e8f\u5217\u7684\u53cd\u5e94\u65f6\u95f4\u9700\u8981\u6301\u7eed\u7684\u7ec3\u4e60\u548c\u4e13\u6ce8\u3002\u7b2c\u4e00\u6b65\uff1a\u4ece\u8f83\u6162\u7684\u6b4c\u66f2\u5f00\u59cb\uff0c\u4ee5\u5efa\u7acb\u575a\u5b9e\u7684\u57fa\u7840\u3002\u7b2c\u4e8c\u6b65\uff1a\u901a\u8fc7\u64ad\u653e\u50cf\u201cMouthful\u201d\u8fd9\u6837\u7684\u66f4\u5feb\u66f2\u76ee\u6765\u9010\u6e10\u589e\u52a0\u96be\u5ea6\u3002\u7b2c\u4e09\u6b65\uff1a\u4f7f\u7528\u53ef\u89c6\u5316\u6280\u672f\u6765\u9884\u6d4b\u97f3\u7b26\u6a21\u5f0f\u5728\u5b83\u4eec\u51fa\u73b0\u4e4b\u524d\u3002\u4f8b\u5982\uff0c\u5728\u201cSpookeez\u201d\u6b4c\u66f2\u4e2d\uff0c\u53ef\u89c6\u5316\u5373\u5c06\u5230\u6765\u7684\u97f3\u7b26\u5e8f\u5217\u4ee5\u51c6\u5907\u60a8\u7684\u624b\u6307\u3002\u6b64\u5916\uff0c\u786e\u4fdd\u60a8\u7684\u952e\u76d8\u6216\u63a7\u5236\u5668\u5177\u6709\u54cd\u5e94\u6027\uff0c\u5e76\u4e14\u9002\u5408\u957f\u65f6\u95f4\u7684\u6e38\u620f\u4f1a\u8bdd\u3002"}, {"question": "\u6211\u5e94\u8be5\u8c03\u6574\u54ea\u4e9b\u8bbe\u7f6e\u6765\u4f18\u5316\u6211\u5728 FNF: Salty's Sunday Night \u4e2d\u7684\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u4f18\u5316\u60a8\u5728 FNF: Salty's Sunday Night \u4e2d\u7684\u6e38\u620f\u4f53\u9a8c\u6d89\u53ca\u8c03\u6574\u591a\u4e2a\u8bbe\u7f6e\u3002\u9996\u5148\uff0c\u6821\u51c6\u201c\u97f3\u7b26\u504f\u79fb\u201d\u4ee5\u786e\u4fdd\u97f3\u7b26\u4e0e\u5c4f\u5e55\u7684\u5237\u65b0\u7387\u5b8c\u7f8e\u5bf9\u9f50\u3002\u5176\u6b21\uff0c\u5c06\u201c\u6eda\u52a8\u901f\u5ea6\u201d\u8c03\u6574\u5230\u4e0e\u60a8\u7684\u53cd\u5e94\u65f6\u95f4\u76f8\u5339\u914d\u7684\u8212\u9002\u6c34\u5e73\u3002\u4f8b\u5982\uff0c\u66f4\u9ad8\u7684\u6eda\u52a8\u901f\u5ea6\u53ef\u4ee5\u4f7f\u50cf\u201cPhilly Nice\u201d\u8fd9\u6837\u7684\u5feb\u8282\u594f\u6b4c\u66f2\u66f4\u6613\u4e8e\u7ba1\u7406\u3002\u6700\u540e\uff0c\u542f\u7528\u201c\u5e7d\u7075\u6572\u51fb\u201d\u4ee5\u9632\u6b62\u8fc7\u65e9\u6309\u4e0b\u6309\u952e\u65f6\u9519\u8fc7\u97f3\u7b26\u3002\u5c1d\u8bd5\u8fd9\u4e9b\u8bbe\u7f6e\u4ee5\u627e\u5230\u6700\u9002\u5408\u60a8\u6e38\u620f\u98ce\u683c\u7684\u914d\u7f6e\u3002"}, {"question": "FNF: Salty's Sunday Night \u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u5982\u4f55\u8fd0\u4f5c\uff0c\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u5b83\uff1f", "answer": "FNF: Salty's Sunday Night \u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u60a8\u547d\u4e2d\u7684\u51c6\u786e\u6027\u548c\u65f6\u673a\u3002\u6bcf\u4e2a\u97f3\u7b26\u90fd\u53ef\u4ee5\u88ab\u51fb\u4e2d\u4e3a\u201cSick\u201d\uff08\u5b8c\u7f8e\uff09\u3001\u201cGood\u201d\uff08\u7565\u5fae\u504f\u79bb\uff09\u3001\u201cBad\u201d\uff08\u9519\u8fc7\uff09\u6216\u201cShit\u201d\uff08\u5b8c\u5168\u9519\u8fc7\uff09\u3002\u201cSick\u201d\u547d\u4e2d\u4ea7\u751f\u6700\u591a\u7684\u5206\u6570\uff0c\u800c\u201cShit\u201d\u547d\u4e2d\u4f1a\u5bfc\u81f4\u5206\u6570\u635f\u5931\u3002\u6b64\u5916\uff0c\u901a\u8fc7\u8fde\u7eed\u51fb\u4e2d\u97f3\u7b26\u800c\u4e0d\u9057\u6f0f\u6765\u4fdd\u6301\u8fde\u51fb\u4f1a\u589e\u52a0\u60a8\u7684\u5206\u6570\u500d\u6570\u3002\u4f8b\u5982\uff0c\u5728\u201cSouth\u201d\u6b4c\u66f2\u4e2d\uff0c\u5b8c\u7f8e\u5730\u51fb\u4e2d\u6240\u6709\u97f3\u7b26\u5c06\u6700\u5927\u5316\u60a8\u7684\u5206\u6570\u548c\u8fde\u51fb\u3002\u7ec3\u4e60\u7cbe\u786e\u5ea6\u4ee5\u59cb\u7ec8\u5982\u4e00\u5730\u83b7\u5f97\u9ad8\u5206\u3002"}, {"question": "FNF: Salty's Sunday Night \u4e2d\u5404\u79cd\u96be\u5ea6\u7ea7\u522b\u4e4b\u95f4\u7684\u4e3b\u8981\u533a\u522b\u662f\u4ec0\u4e48\uff1f", "answer": "FNF: Salty's Sunday Night \u4e2d\u7684\u96be\u5ea6\u7ea7\u522b\u65e8\u5728\u6ee1\u8db3\u4e0d\u540c\u6280\u80fd\u6c34\u5e73\u7684\u73a9\u5bb6\u3002\u201c\u7b80\u5355\u201d\u6a21\u5f0f\u5177\u6709\u8f83\u6162\u7684\u97f3\u7b26\u901f\u5ea6\u548c\u66f4\u7b80\u5355\u7684\u6a21\u5f0f\uff0c\u975e\u5e38\u9002\u5408\u521d\u5b66\u8005\u3002\u201c\u666e\u901a\u201d\u6a21\u5f0f\u589e\u52a0\u4e86\u97f3\u7b26\u5e8f\u5217\u7684\u901f\u5ea6\u548c\u590d\u6742\u6027\uff0c\u63d0\u4f9b\u4e86\u5e73\u8861\u7684\u6311\u6218\u3002\u201c\u56f0\u96be\u201d\u6a21\u5f0f\u5f15\u5165\u4e86\u5feb\u901f\u7684\u97f3\u7b26\u5e8f\u5217\u548c\u590d\u6742\u7684\u6a21\u5f0f\uff0c\u9002\u5408\u6709\u7ecf\u9a8c\u7684\u73a9\u5bb6\u3002\u4f8b\u5982\uff0c\u201cDad Battle\u201d\u6b4c\u66f2\u5728\u201c\u56f0\u96be\u201d\u6a21\u5f0f\u4e0b\u5305\u62ec\u5feb\u8282\u594f\u7684\u97f3\u7b26\u6d41\uff0c\u8003\u9a8c\u60a8\u7684\u53cd\u5e94\u80fd\u529b\u548c\u7cbe\u786e\u5ea6\u3002\u9009\u62e9\u4e0e\u60a8\u7684\u6280\u80fd\u6c34\u5e73\u76f8\u5339\u914d\u7684\u96be\u5ea6\uff0c\u5e76\u9010\u6e10\u8fdb\u6b65\u5230\u66f4\u5177\u6311\u6218\u6027\u7684\u6a21\u5f0f\u3002"}, {"question": "\u5982\u4f55\u5728 FNF: Salty's Sunday Night \u4e2d\u5c06\u6211\u7684\u6e38\u620f\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u5e73\u53f0\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u5e73\u53f0\uff1f", "answer": "\u5728 FNF: Salty's Sunday Night \u4e2d\uff0c\u5728\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u60a8\u7684\u6e38\u620f\u8fdb\u5ea6\u6d89\u53ca\u51e0\u4e2a\u6b65\u9aa4\u3002\u7b2c\u4e00\u6b65\uff1a\u5728\u539f\u59cb\u5e73\u53f0\u4e0a\u627e\u5230\u60a8\u7684\u4fdd\u5b58\u6587\u4ef6\uff1b\u5b83\u901a\u5e38\u5b58\u50a8\u5728\u6e38\u620f\u7684\u5b89\u88c5\u76ee\u5f55\u4e2d\u3002\u7b2c\u4e8c\u6b65\uff1a\u5c06\u4fdd\u5b58\u6587\u4ef6\u590d\u5236\u5230 USB \u9a71\u52a8\u5668\u6216\u4e91\u5b58\u50a8\u3002\u7b2c\u4e09\u6b65\uff1a\u5728\u65b0\u5e73\u53f0\u4e0a\uff0c\u5b89\u88c5\u6e38\u620f\u5e76\u5c06\u9ed8\u8ba4\u4fdd\u5b58\u6587\u4ef6\u66ff\u6362\u4e3a\u60a8\u590d\u5236\u7684\u6587\u4ef6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4ece PC \u79fb\u52a8\u5230 Mac\uff0c\u8bf7\u786e\u4fdd\u4fdd\u5b58\u6587\u4ef6\u4e0e\u4e24\u4e2a\u7cfb\u7edf\u517c\u5bb9\u3002\u5728\u4f20\u8f93\u4e4b\u524d\u59cb\u7ec8\u5907\u4efd\u60a8\u7684\u4fdd\u5b58\u6587\u4ef6\uff0c\u4ee5\u9632\u6b62\u6570\u636e\u4e22\u5931\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5728 FNF: Salty's Sunday Night \u4e2d\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u7684\u79d8\u5bc6\u6216\u5f69\u86cb\uff1f", "answer": "FNF: Salty's Sunday Night \u5145\u6ee1\u4e86\u9690\u85cf\u7684\u79d8\u5bc6\u548c\u5f69\u86cb\uff0c\u4f9b\u4e13\u6ce8\u7684\u73a9\u5bb6\u53d1\u73b0\u3002\u4e00\u4e2a\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\u201cSalty\u201d\u89d2\u8272\u5728\u201cSpookeez\u201d\u6b4c\u66f2\u4e2d\u7684\u72ec\u7279\u5bf9\u8bdd\uff0c\u5b83\u5f15\u7528\u4e86\u6e38\u620f\u7684\u53d1\u5c55\u5386\u53f2\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u6b4c\u66f2\u5305\u542b\u9690\u85cf\u7684\u89c6\u89c9\u6548\u679c\uff0c\u5f53\u6ee1\u8db3\u7279\u5b9a\u6761\u4ef6\u65f6\u4f1a\u6fc0\u6d3b\u3002\u4f8b\u5982\uff0c\u5728\u201cM.I.L.F\u201d\u6b4c\u66f2\u4e2d\u83b7\u5f97\u5b8c\u7f8e\u7684\u5206\u6570\u4f1a\u89e3\u9501\u4e00\u4e2a\u7279\u6b8a\u7684\u52a8\u753b\u3002\u5f7b\u5e95\u63a2\u7d22\u6e38\u620f\u5e76\u5c1d\u8bd5\u4e0d\u540c\u7684\u64cd\u4f5c\u4ee5\u53d1\u73b0\u8fd9\u4e9b\u9690\u85cf\u7684\u5b9d\u77f3\u3002"}]
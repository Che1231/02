[{"question": "FNF: Salty's \uc77c\uc694\uc77c \ubc24\uc5d0 \uc644\uc804 \ucd08\ubcf4\ub85c\uc11c \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud560 \uc218 \uc788\ub098\uc694?", "answer": "FNF: Salty's \uc77c\uc694\uc77c \ubc24 \uac8c\uc784\uc744 \uc2dc\uc791\ud558\ub824\uba74 \uba3c\uc800 \uacf5\uc2dd \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uac8c\uc784\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc5ec \uc124\uce58\ud558\uc138\uc694. \uc124\uce58\uac00 \uc644\ub8cc\ub418\uba74 \uac8c\uc784\uc744 \uc2e4\ud589\ud558\uace0 \uc548\ub0b4\ub41c \uc18c\uac1c\ub97c \uc704\ud574 '\uc2a4\ud1a0\ub9ac \ubaa8\ub4dc'\ub85c \uc774\ub3d9\ud558\uc138\uc694. \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc775\uc219\ud574\uc9c0\uc138\uc694. \ud654\uc0b4\ud45c \ud0a4\ub294 \ud654\uba74\uc5d0 \ub098\ud0c0\ub098\ub294 \uc74c\ud45c\uc5d0 \ud574\ub2f9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc74c\ud45c\uac00 \ud45c\uc2dc\uae30\uc640 \uc77c\uce58\ud558\uba74 \ud574\ub2f9 \ud654\uc0b4\ud45c \ud0a4\ub97c \ub204\ub974\uc138\uc694. \ud0c0\uc774\ubc0d\uacfc \uc815\ud655\ub3c4\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\uae30 \uc704\ud574 '\uc790\uc720 \ud50c\ub808\uc774' \ubaa8\ub4dc\uc5d0\uc11c \uc5f0\uc2b5\ud558\uc138\uc694. \uafb8\uc900\ud55c \uc5f0\uc2b5\uc774 \uac8c\uc784 \ub9c8\uc2a4\ud130\ud558\ub294 \ub370 \uc911\uc694\ud569\ub2c8\ub2e4."}, {"question": "FNF: Salty's \uc77c\uc694\uc77c \ubc24\uc5d0\uc11c \uc5b4\ub5a4 \uc74c\ud45c\uac00 \ub2e4\ub978 \uc74c\ud45c\ubcf4\ub2e4 \uce58\uae30 \uc5b4\ub824\uc6b4 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "FNF: Salty's \uc77c\uc694\uc77c \ubc24\uc5d0\uc11c \uc74c\ud45c\ub97c \uce58\ub294 \ub09c\uc774\ub3c4\ub294 \ubc30\uce58\uc640 \ud0c0\uc774\ubc0d\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4. \uc77c\ubd80 \uc74c\ud45c\ub294 \ub354 \uac00\uae4c\uc774 \ubc30\uce58\ub418\uac70\ub098 \ub354 \ube60\ub978 \ubc18\uc0ac \uc18d\ub3c4\uac00 \ud544\uc694\ud558\uc5ec \ub354 \uc5b4\ub824\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'Salty' \ub178\ub798 \uc911\uc5d0\ub294 \uc18d\ub3c4\uc640 \uc815\ud655\uc131\uc744 \uc2dc\ud5d8\ud558\ub294 \ube60\ub978 \uc5f0\uc18d \uc74c\ud45c\uac00 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \uac1c\uc120\ud558\ub824\uba74 \ub9ac\ub4ec\uc744 \uc608\uce21\ud558\uace0 \ub354 \ubcf5\uc7a1\ud55c \uace1\uc744 \uc2dc\ub3c4\ud558\uae30 \uc804\uc5d0 \ub290\ub9b0 \uace1\uc5d0\uc11c \uc5f0\uc2b5\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \uba54\ud2b8\ub85c\ub188 \uc571\uc744 \uc0ac\uc6a9\ud558\uba74 \ube44\ud2b8\ub97c \ub0b4\uba74\ud654\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "FNF: Salty's \uc77c\uc694\uc77c \ubc24\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "FNF: Salty's \uc77c\uc694\uc77c \ubc24\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc73c\ub824\uba74 \uc5ec\ub7ec \uc804\ub7b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \ud56d\uc0c1 \uc644\ubcbd\ud55c \ud0c0\uc774\ubc0d\uc73c\ub85c \uac00\uc7a5 \ub9ce\uc740 \uc810\uc218\ub97c \uc8fc\ub294 'Sick' \ud788\ud2b8\ub97c \ubaa9\ud45c\ub85c \ud558\uc138\uc694. STEP2: \uc5b4\ub5a4 \uc74c\ud45c\ub3c4 \ub193\uce58\uc9c0 \uc54a\uace0 \uc5f0\uc18d \ud788\ud2b8\ub97c \uc720\uc9c0\ud558\uc5ec '\ucf64\ubcf4' \uc2dc\uc2a4\ud15c\uc744 \ud65c\uc6a9\ud558\uc138\uc694. STEP3: \uc18d\ub3c4\ubcf4\ub2e4 \uc815\ud655\uc131\uc5d0 \uc9d1\uc911\ud558\uc138\uc694; \ub9ce\uc740 \uc74c\ud45c\ub97c \uc11c\ub450\ub974\uace0 \ub193\uce58\ub294 \uac83\ubcf4\ub2e4 \uba87 \uac1c\uc758 \uc74c\ud45c\ub97c \uc644\ubcbd\ud558\uac8c \uce58\ub294 \uac83\uc774 \ub354 \uc88b\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'Retro' \ub178\ub798\uc5d0\uc11c \uafb8\uc900\ud55c \ub9ac\ub4ec\uc744 \uc720\uc9c0\ud558\uba74 \ub192\uc740 \ucf64\ubcf4\ub97c \uad6c\ucd95\ud558\uace0 \uc810\uc218\ub97c \uadf9\ub300\ud654\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4. \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uacfc \uc815\ud655\uc131\uc744 \uac1c\uc120\ud558\uae30 \uc704\ud574 \uc815\uae30\uc801\uc73c\ub85c \uc5f0\uc2b5\ud558\uc138\uc694."}, {"question": "FNF: Salty's \uc77c\uc694\uc77c \ubc24\uc5d0\uc11c \ub354 \ube60\ub978 \uc74c\ud45c \uc2dc\ud000\uc2a4\uc5d0 \ub300\ud55c \ubc18\uc751 \uc2dc\uac04\uc744 \uc5b4\ub5bb\uac8c \uac1c\uc120\ud560 \uc218 \uc788\ub098\uc694?", "answer": "FNF: Salty's \uc77c\uc694\uc77c \ubc24\uc5d0\uc11c \ub354 \ube60\ub978 \uc74c\ud45c \uc2dc\ud000\uc2a4\uc5d0 \ub300\ud55c \ubc18\uc751 \uc2dc\uac04\uc744 \uac1c\uc120\ud558\ub824\uba74 \uafb8\uc900\ud55c \uc5f0\uc2b5\uacfc \uc9d1\uc911\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \ud0c4\ud0c4\ud55c \uae30\ubc18\uc744 \uad6c\ucd95\ud558\uae30 \uc704\ud574 \ub290\ub9b0 \uace1\ubd80\ud130 \uc2dc\uc791\ud558\uc138\uc694. STEP2: 'Mouthful'\uacfc \uac19\uc774 \ub354 \ube60\ub978 \uace1\uc744 \uc5f0\uc8fc\ud558\uc5ec \uc810\ucc28 \ub09c\uc774\ub3c4\ub97c \ub192\uc774\uc138\uc694. STEP3: \uc74c\ud45c \ud328\ud134\uc744 \ub098\ud0c0\ub098\uae30 \uc804\uc5d0 \uc608\uce21\ud558\uae30 \uc704\ud574 \uc2dc\uac01\ud654 \uae30\ubc95\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, 'Spookeez' \ub178\ub798 \uc911\uc5d0 \uc55e\uc73c\ub85c \ub098\ud0c0\ub0a0 \uc74c\ud45c \uc2dc\ud000\uc2a4\ub97c \uc2dc\uac01\ud654\ud558\uc5ec \uc190\uac00\ub77d\uc744 \uc900\ube44\ud558\uc138\uc694. \ub610\ud55c, \uc7a5\uc2dc\uac04 \ud50c\ub808\uc774\uc5d0 \uc801\ud569\ud558\uace0 \ubc18\uc751\uc774 \ube60\ub978 \ud0a4\ubcf4\ub4dc \ub610\ub294 \ucee8\ud2b8\ub864\ub7ec\ub97c \uc0ac\uc6a9\ud558\uc138\uc694."}, {"question": "FNF: Salty's \uc77c\uc694\uc77c \ubc24\uc5d0\uc11c \uac8c\uc784 \ud658\uacbd\uc744 \ucd5c\uc801\ud654\ud558\uae30 \uc704\ud574 \uc5b4\ub5a4 \uc124\uc815\uc744 \uc870\uc815\ud574\uc57c \ud558\ub098\uc694?", "answer": "FNF: Salty's \uc77c\uc694\uc77c \ubc24\uc5d0\uc11c \uac8c\uc784 \ud658\uacbd\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc5ec\ub7ec \uc124\uc815\uc744 \uc870\uc815\ud574\uc57c \ud569\ub2c8\ub2e4. \uccab\uc9f8, \uc74c\ud45c\uac00 \ud654\uba74\uc758 \uc8fc\uc0ac\uc728\uacfc \uc644\ubcbd\ud558\uac8c \uc77c\uce58\ud558\ub3c4\ub85d '\uc74c\ud45c \uc624\ud504\uc14b'\uc744 \ubcf4\uc815\ud558\uc138\uc694. \ub458\uc9f8, \ubc18\uc751 \uc2dc\uac04\uacfc \uc77c\uce58\ud558\ub294 \ud3b8\uc548\ud55c \uc218\uc900\uc73c\ub85c '\uc2a4\ud06c\ub864 \uc18d\ub3c4'\ub97c \uc870\uc815\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub354 \ub192\uc740 \uc2a4\ud06c\ub864 \uc18d\ub3c4\ub294 'Philly Nice'\uc640 \uac19\uc740 \ube60\ub978 \uace1\uc744 \ub354\uc6b1 \ub2e4\ub8e8\uae30 \uc27d\uac8c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub9c8\uc9c0\ub9c9\uc73c\ub85c, \ud0a4\ub97c \ub108\ubb34 \uc77c\ucc0d \ub204\ub97c \uacbd\uc6b0 \ub204\ub77d \uc74c\ud45c\ub97c \ubc29\uc9c0\ud558\uae30 \uc704\ud574 '\uace0\uc2a4\ud2b8 \ud0ed\ud551'\uc744 \ud65c\uc131\ud654\ud558\uc2ed\uc2dc\uc624. \uac01\uc790\uc758 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\ub294 \ucd5c\uc0c1\uc758 \uad6c\uc131\uc744 \ucc3e\uae30 \uc704\ud574 \uc774\ub7ec\ud55c \uc124\uc815\uc744 \uc2e4\ud5d8\ud558\uc138\uc694."}, {"question": "FNF: Salty's \uc77c\uc694\uc77c \ubc24\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uc5b4\ub5a4 \uc694\uc18c\uac00 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "FNF: Salty's \uc77c\uc694\uc77c \ubc24 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ud788\ud2b8\uc758 \uc815\ud655\uc131\uacfc \ud0c0\uc774\ubc0d\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uac01 \uc74c\ud45c\ub294 'Sick'(\uc644\ubcbd), 'Good'(\uc57d\uac04 \ube57\ub098\uac10), 'Bad'(\ub204\ub77d), \ub610\ub294 'Shit'(\uc644\uc804\ud788 \ub204\ub77d)\uc73c\ub85c \uce60 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 'Sick' \ud788\ud2b8\ub294 \uac00\uc7a5 \ub9ce\uc740 \uc810\uc218\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ubc18\uba74\uc5d0 'Shit' \ud788\ud2b8\ub294 \uc810\uc218 \uc190\uc2e4\uc744 \ucd08\ub798\ud569\ub2c8\ub2e4. \ub610\ud55c, \ub204\ub77d\ub41c \uc74c\ud45c \uc5c6\uc774 \uc5f0\uc18d\uc801\uc778 \uc74c\ud45c\ub97c \uce58\ub294 \ucf64\ubcf4\ub97c \uc720\uc9c0\ud558\uba74 \uc810\uc218 \ubc30\uc218\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'South' \ub178\ub798\uc5d0\uc11c \ubaa8\ub4e0 \uc74c\ud45c\ub97c \uc644\ubcbd\ud558\uac8c \uce58\uba74 \uc810\uc218\uc640 \ucf64\ubcf4\ub97c \uadf9\ub300\ud654\ud569\ub2c8\ub2e4. \uafb8\uc900\ud788 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc73c\ub824\uba74 \uc815\ud655\uc131 \uc5f0\uc2b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."}, {"question": "FNF: Salty's \uc77c\uc694\uc77c \ubc24\uc758 \ub2e4\uc591\ud55c \ub09c\uc774\ub3c4 \ub808\ubca8 \uc0ac\uc774\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "FNF: Salty's \uc77c\uc694\uc77c \ubc24\uc758 \ub09c\uc774\ub3c4 \ub808\ubca8\uc740 \ub2e4\uc591\ud55c \uae30\uc220 \ub808\ubca8\uc758 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ub9de\ucdb0 \uc124\uacc4\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. '\uc26c\uc6c0' \ubaa8\ub4dc\ub294 \ucd08\ubcf4\uc790\uc5d0\uac8c \uc801\ud569\ud55c \ub290\ub9b0 \uc74c\ud45c \uc18d\ub3c4\uc640 \uac04\ub2e8\ud55c \ud328\ud134\uc744 \ud2b9\uc9d5\uc73c\ub85c \ud569\ub2c8\ub2e4. '\ubcf4\ud1b5' \ubaa8\ub4dc\ub294 \uc74c\ud45c \uc2dc\ud000\uc2a4\uc758 \uc18d\ub3c4\uc640 \ubcf5\uc7a1\uc131\uc744 \ub192\uc5ec \uade0\ud615 \uc7a1\ud78c \ub3c4\uc804\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. '\uc5b4\ub824\uc6c0' \ubaa8\ub4dc\ub294 \uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc801\ud569\ud55c \ube60\ub978 \uc74c\ud45c \uc2dc\ud000\uc2a4\uc640 \ubcf5\uc7a1\ud55c \ud328\ud134\uc744 \ucd94\uac00\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'Hard' \ubaa8\ub4dc\uc758 'Dad Battle' \ub178\ub798\uc5d0\ub294 \ubc18\uc0ac\uc640 \uc815\ud655\uc131\uc744 \uc2dc\ud5d8\ud558\ub294 \ucd08\uace0\uc18d \uc74c\ud45c \uc2a4\ud2b8\ub9bc\uc774 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc790\uc2e0\uc758 \uae30\uc220 \uc218\uc900\uc5d0 \ub9de\ub294 \ub09c\uc774\ub3c4\ub97c \uc120\ud0dd\ud558\uace0 \uc810\ucc28 \ub354 \uc5b4\ub824\uc6b4 \ubaa8\ub4dc\ub85c \uc9c4\ud589\ud558\uc138\uc694."}, {"question": "FNF: Salty's \uc77c\uc694\uc77c \ubc24\uc5d0\uc11c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694?", "answer": "FNF: Salty's \uc77c\uc694\uc77c \ubc24\uc5d0\uc11c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub824\uba74 \uba87 \uac00\uc9c0 \ub2e8\uacc4\ub97c \uac70\uccd0\uc57c \ud569\ub2c8\ub2e4. STEP1: \uc6d0\ub798 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc800\uc7a5 \ud30c\uc77c\uc744 \ucc3e\uc73c\uc138\uc694. \uc77c\ubc18\uc801\uc73c\ub85c \uac8c\uc784 \uc124\uce58 \ub514\ub809\ud1a0\ub9ac\uc5d0 \uc800\uc7a5\ub429\ub2c8\ub2e4. STEP2: USB \ub4dc\ub77c\uc774\ube0c \ub610\ub294 \ud074\ub77c\uc6b0\ub4dc \uc2a4\ud1a0\ub9ac\uc9c0\uc5d0 \uc800\uc7a5 \ud30c\uc77c\uc744 \ubcf5\uc0ac\ud558\uc138\uc694. STEP3: \uc0c8 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uac8c\uc784\uc744 \uc124\uce58\ud558\uace0 \uae30\ubcf8 \uc800\uc7a5 \ud30c\uc77c\uc744 \ubcf5\uc0ac\ud55c \ud30c\uc77c\ub85c \ubc14\uafb8\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c Mac\uc73c\ub85c \uc774\ub3d9\ud558\ub294 \uacbd\uc6b0 \uc800\uc7a5 \ud30c\uc77c\uc774 \ub450 \uc2dc\uc2a4\ud15c \ubaa8\ub450\uc640 \ud638\ud658\ub418\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \ub370\uc774\ud130 \uc190\uc2e4 \ubc29\uc9c0\ub97c \uc704\ud574 \uc804\uc1a1\ud558\uae30 \uc804\uc5d0 \ud56d\uc0c1 \uc800\uc7a5 \ud30c\uc77c\uc744 \ubc31\uc5c5\ud558\uc138\uc694."}, {"question": "FNF: Salty's \uc77c\uc694\uc77c \ubc24\uc5d0\uc11c \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ube44\ubc00\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "FNF: Salty's \uc77c\uc694\uc77c \ubc24\uc5d0\ub294 \uc5f4\ub82c\ud55c \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ube44\ubc00\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uac00\ub4dd\ud569\ub2c8\ub2e4. \ub208\uc5ec\uaca8\ubcfc\ub9cc\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 'Spookeez' \ub178\ub798\uc5d0\uc11c 'Salty' \uce90\ub9ad\ud130\uc758 \ud2b9\ubcc4\ud55c \ub300\ud654\ub85c, \uac8c\uc784\uc758 \uac1c\ubc1c \uc5ed\uc0ac\ub97c \ucc38\uc870\ud569\ub2c8\ub2e4. \ub610\ud55c, \ud2b9\uc815 \uc870\uac74\uc774 \ucda9\uc871\ub418\uba74 \uc228\uaca8\uc9c4 \uc2dc\uac01 \ud6a8\uacfc\uac00 \uc788\ub294 \ud2b9\uc815 \ub178\ub798\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'M.I.L.F' \ub178\ub798\uc5d0\uc11c \uc644\ubcbd\ud55c \uc810\uc218\ub97c \uc5bb\uc73c\uba74 \ud2b9\ubcc4\ud55c \uc560\ub2c8\uba54\uc774\uc158\uc744 \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4. \uac8c\uc784\uc744 \uc790\uc138\ud788 \ud0d0\uc0c9\ud558\uace0 \ub2e4\uc591\ud55c \uc870\uc791\uc744 \uc2dc\ub3c4\ud558\uc5ec \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uc744 \ucc3e\uc544\ubcf4\uc138\uc694."}]
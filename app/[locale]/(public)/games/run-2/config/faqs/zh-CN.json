[{"question": "\u521d\u5b66\u8005\u5982\u4f55\u638c\u63e1Run 2\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u638c\u63e1Run 2\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u4f7f\u7528\u65b9\u5411\u952e\u79fb\u52a8\u89d2\u8272\u5de6\u53f3\u3002\u6b65\u9aa42 - \u6309\u4e0b\u4e0a\u65b9\u5411\u952e\u8df3\u8dc3\uff0c\u5e76\u7ed3\u5408\u5de6\u53f3\u65b9\u5411\u952e\u8fdb\u884c\u65b9\u5411\u8df3\u8dc3\u3002\u6b65\u9aa43 - \u7ec3\u4e60\u8df3\u8dc3\u65f6\u673a\uff0c\u907f\u514d\u4ece\u5e73\u53f0\u4e0a\u6389\u4e0b\u6765\u3002\u4f8b\u5982\uff0c\u57281\u7ea7\u5173\u5361\u4e2d\uff0c\u60a8\u9700\u8981\u5728\u4fdd\u6301\u52a8\u91cf\u7684\u540c\u65f6\u8df3\u8fc7\u95f4\u9699\u3002\u4e00\u4e2a\u6709\u7528\u7684\u6280\u5de7\u662f\u5c06\u64cd\u4f5c\u60f3\u8c61\u6210\u9a7e\u9a76\u6c7d\u8f66\u2014\u2014\u5e73\u7a33\u800c\u7cbe\u786e\u7684\u52a8\u4f5c\u662f\u5173\u952e\u3002"}, {"question": "\u5728Run 2\u4e2d\u751f\u5b58\u66f4\u957f\u65f6\u95f4\u7684\u5173\u952e\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728Run 2\u4e2d\u751f\u5b58\u66f4\u957f\u65f6\u95f4\u9700\u8981\u7ed3\u5408\u65f6\u673a\u548c\u7b56\u7565\u3002\u6b65\u9aa41 - \u59cb\u7ec8\u5411\u524d\u770b\uff0c\u9884\u6d4b\u5373\u5c06\u51fa\u73b0\u7684\u969c\u788d\u3002\u6b65\u9aa42 - \u5229\u7528\u52a8\u91cf\uff0c\u4fdd\u6301\u7a33\u5b9a\u7684\u901f\u5ea6\u8fd0\u884c\uff0c\u800c\u4e0d\u662f\u9891\u7e41\u505c\u6b62\u3002\u6b65\u9aa43 - \u7ec3\u4e60\u7cbe\u786e\u8df3\u8dc3\uff0c\u4ee5\u5e94\u5bf9\u68d8\u624b\u7684\u533a\u57df\u3002\u4f8b\u5982\uff0c\u57285\u7ea7\u5173\u5361\u4e2d\uff0c\u60a8\u4f1a\u9047\u5230\u9700\u8981\u7cbe\u786e\u65f6\u95f4\u7684\u79fb\u52a8\u5e73\u53f0\u3002\u628a\u5b83\u60f3\u8c61\u6210\u8282\u594f\u6e38\u620f\u2014\u2014\u5c06\u60a8\u7684\u8df3\u8dc3\u4e0e\u5e73\u53f0\u7684\u79fb\u52a8\u540c\u6b65\u3002\u6b64\u5916\uff0c\u638c\u63e1\u201c\u5899\u8df3\u201d\u6280\u5de7\u53ef\u4ee5\u5e2e\u52a9\u60a8\u4ece\u9519\u8bef\u4e2d\u6062\u590d\u3002"}, {"question": "\u4e3a\u4ec0\u4e48Run 2\u4e2d\u7684\u91cd\u529b\u673a\u5236\u5728\u67d0\u4e9b\u5173\u5361\u4e2d\u611f\u89c9\u4e0d\u540c\uff1f", "answer": "Run 2\u4e2d\u7684\u91cd\u529b\u673a\u5236\u5728\u4e0d\u540c\u5173\u5361\u4e4b\u95f4\u6709\u6240\u53d8\u5316\uff0c\u4ee5\u589e\u52a0\u6e38\u620f\u7684\u590d\u6742\u6027\u3002\u4f8b\u5982\uff0c\u57283\u7ea7\u5173\u5361\u4e2d\uff0c\u5f53\u60a8\u79fb\u52a8\u5230\u5f2f\u66f2\u8868\u9762\u65f6\uff0c\u91cd\u529b\u4f1a\u53d1\u751f\u53d8\u5316\uff0c\u4f7f\u60a8\u7684\u89d2\u8272\u5012\u6302\u3002\u8fd9\u662f\u901a\u8fc7\u6e38\u620f\u7269\u7406\u5f15\u64ce\u5b9e\u73b0\u7684\uff0c\u8be5\u5f15\u64ce\u6a21\u62df\u4e86\u79bb\u5fc3\u529b\u3002\u4e3a\u4e86\u9002\u5e94\uff0c\u8c03\u6574\u60a8\u7684\u64cd\u4f5c\uff0c\u5c31\u50cf\u5728\u5f2f\u9053\u4e0a\u9a7e\u9a76\u4e00\u6837\u2014\u2014\u9884\u6d4b\u53d8\u5316\u5e76\u76f8\u5e94\u5730\u8f6c\u5411\u3002\u914d\u7f6e\u8868\u53ef\u4ee5\u5e2e\u52a9\u60a8\u53ef\u89c6\u5316\u91cd\u529b\u53d8\u5316\uff1a3\u7ea7\u5173\u5361\uff08\u4f4e\u91cd\u529b\uff09\uff0c7\u7ea7\u5173\u5361\uff08\u53cd\u91cd\u529b\uff09\u3002"}, {"question": "Run 2\u4e2d\u54ea\u4e9b\u5173\u5361\u88ab\u8ba4\u4e3a\u662f\u5bf9\u9ad8\u7ea7\u73a9\u5bb6\u6700\u5177\u6311\u6218\u6027\u7684\u5173\u5361\uff1f", "answer": "\u9ad8\u7ea7\u73a9\u5bb6\u901a\u5e38\u8ba4\u4e3a8\u7ea7\u548c10\u7ea7\u5173\u5361\u6700\u5177\u6311\u6218\u6027\uff0c\u56e0\u4e3a\u5b83\u4eec\u7684\u5e03\u5c40\u548c\u91cd\u529b\u673a\u5236\u975e\u5e38\u590d\u6742\u3002\u57288\u7ea7\u5173\u5361\u4e2d\uff0c\u60a8\u5fc5\u987b\u7a7f\u8fc7\u72ed\u7a84\u7684\u96a7\u9053\uff0c\u91cd\u529b\u4ea4\u66ff\u53d8\u5316\uff0c\u800c10\u7ea7\u5173\u5361\u5f15\u5165\u4e86\u79fb\u52a8\u969c\u788d\u548c\u7cbe\u786e\u7684\u65f6\u673a\u3002\u4f8b\u5982\uff0c\u57288\u7ea7\u5173\u5361\u4e2d\uff0c\u60a8\u9700\u8981\u8fdb\u884c\u4e00\u7cfb\u5217\u7684\u5899\u58c1\u8df3\u8dc3\uff0c\u540c\u65f6\u9002\u5e94\u91cd\u529b\u53d8\u5316\u3002\u4e00\u79cd\u591a\u65b9\u6848\u65b9\u6cd5\u53ef\u4ee5\u63d0\u4f9b\u5e2e\u52a9\uff1a\u9009\u9879A - \u6162\u6162\u6765\uff1b\u9009\u9879B - \u5229\u7528\u52a8\u91cf\u5feb\u901f\u901a\u8fc7\u5173\u5361\u3002"}, {"question": "Run 2\u7684\u8bbe\u8ba1\u5982\u4f55\u9f13\u52b1\u91cd\u590d\u6e38\u73a9\uff1f", "answer": "Run 2\u7684\u8bbe\u8ba1\u901a\u8fc7\u52a8\u6001\u969c\u788d\u548c\u7a0b\u5e8f\u751f\u6210\u6765\u9f13\u52b1\u91cd\u590d\u6e38\u73a9\u3002\u6bcf\u6b21\u6e38\u620f\u90fd\u63d0\u4f9b\u7565\u5fae\u4e0d\u540c\u7684\u6311\u6218\uff0c\u4f7f\u6e38\u620f\u4f53\u9a8c\u4fdd\u6301\u65b0\u9c9c\u611f\u3002\u4f8b\u5982\uff0c\u57286\u7ea7\u5173\u5361\u4e2d\uff0c\u79fb\u52a8\u5e73\u53f0\u7684\u4f4d\u7f6e\u6bcf\u6b21\u91cd\u65b0\u5f00\u59cb\u6e38\u620f\u90fd\u4f1a\u53d1\u751f\u53d8\u5316\u3002\u8fd9\u5c31\u50cf\u6bcf\u6b21\u89e3\u51b3\u4e00\u4e2a\u65b0\u7684\u96be\u9898\u4e00\u6837\u3002\u6b64\u5916\uff0c\u6e38\u620f\u4f1a\u8ffd\u8e2a\u60a8\u7684\u6700\u4f73\u6210\u7ee9\uff0c\u6fc0\u52b1\u60a8\u63d0\u9ad8\u6210\u7ee9\u3002\u5173\u5361\u8bbe\u8ba1\u6d41\u7a0b\u56fe\u5c55\u793a\u4e86\u5982\u4f55\u5728\u969c\u788d\u4f4d\u7f6e\u4e2d\u878d\u5165\u968f\u673a\u6027\u3002"}, {"question": "Run 2\u7684\u684c\u9762\u7248\u548c\u79fb\u52a8\u7248\u6709\u4ec0\u4e48\u4e3b\u8981\u533a\u522b\uff1f", "answer": "Run 2\u7684\u684c\u9762\u7248\u548c\u79fb\u52a8\u7248\u7684\u4e3b\u8981\u533a\u522b\u5728\u4e8e\u63a7\u5236\u65b9\u5f0f\u548c\u6027\u80fd\u3002\u5728\u684c\u9762\u7248\u4e2d\uff0c\u60a8\u53ef\u4ee5\u4f7f\u7528\u65b9\u5411\u952e\u8fdb\u884c\u7cbe\u786e\u79fb\u52a8\uff0c\u800c\u79fb\u52a8\u7248\u5219\u4f9d\u8d56\u89e6\u6478\u63a7\u5236\uff0c\u53ef\u80fd\u4e0d\u592a\u7cbe\u786e\u3002\u4f8b\u5982\uff0c\u57284\u7ea7\u5173\u5361\u4e2d\uff0c\u684c\u9762\u7248\u73a9\u5bb6\u53ef\u4ee5\u6bd4\u79fb\u52a8\u7248\u7528\u6237\u66f4\u5bb9\u6613\u6267\u884c\u7cbe\u786e\u7684\u8df3\u8dc3\u3002\u914d\u7f6e\u6bd4\u8f83\u8868\u7a81\u51fa\u4e86\u5dee\u5f02\uff1a\u684c\u9762\u7248\uff08\u952e\u76d8\u63a7\u5236\uff0c\u66f4\u9ad8\u7684\u5e27\u7387\uff09\uff0c\u79fb\u52a8\u7248\uff08\u89e6\u6478\u63a7\u5236\uff0c\u9488\u5bf9\u5c0f\u578b\u5c4f\u5e55\u8fdb\u884c\u4e86\u4f18\u5316\uff09\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728Run 2\u4e2d\u89e3\u9501\u9690\u85cf\u89d2\u8272\uff1f", "answer": "\u8981\u89e3\u9501Run 2\u4e2d\u7684\u9690\u85cf\u89d2\u8272\uff0c\u60a8\u5fc5\u987b\u5728\u4e0d\u6454\u5012\u8d85\u8fc7\u4e09\u6b21\u7684\u60c5\u51b5\u4e0b\u5b8c\u621010\u7ea7\u5173\u5361\u3002\u8fd9\u4e2a\u89d2\u8272\u88ab\u79f0\u4e3a\u201c\u5f71\u5b50\u201d\uff0c\u5b83\u5177\u6709\u589e\u5f3a\u7684\u901f\u5ea6\u548c\u8df3\u8dc3\u9ad8\u5ea6\u3002\u4f8b\u5982\uff0c\u572810\u7ea7\u5173\u5361\u4e2d\uff0c\u60a8\u9700\u8981\u5bfc\u822a\u4e00\u7cfb\u5217\u79fb\u52a8\u5e73\u53f0\u548c\u7cbe\u786e\u7684\u8df3\u8dc3\u624d\u80fd\u5b9e\u73b0\u8fd9\u4e00\u70b9\u3002\u628a\u5b83\u770b\u4f5c\u662f\u638c\u63e1\u6e38\u620f\u673a\u5236\u7684\u5956\u52b1\u3002\u5206\u6b65\u6307\u5357\u53ef\u4ee5\u63d0\u4f9b\u5e2e\u52a9\uff1a\u6b65\u9aa41 - \u53cd\u590d\u7ec3\u4e6010\u7ea7\u5173\u5361\uff1b\u6b65\u9aa42 - \u6700\u5c0f\u5316\u9519\u8bef\uff1b\u6b65\u9aa43 - \u5728\u4e09\u6b21\u8dcc\u843d\u4ee5\u5185\u5b8c\u6210\u5173\u5361\u3002"}, {"question": "\u52a8\u91cf\u5728Run 2\u7684\u6e38\u620f\u673a\u5236\u4e2d\u626e\u6f14\u4ec0\u4e48\u89d2\u8272\uff1f", "answer": "\u52a8\u91cf\u662fRun 2\u7684\u6838\u5fc3\u673a\u5236\uff0c\u5f71\u54cd\u7740\u79fb\u52a8\u548c\u8df3\u8dc3\u3002\u4fdd\u6301\u52a8\u91cf\u6709\u52a9\u4e8e\u60a8\u8de8\u8d8a\u66f4\u957f\u7684\u95f4\u9699\uff0c\u5e76\u5e94\u5bf9\u68d8\u624b\u7684\u5173\u5361\u3002\u4f8b\u5982\uff0c\u57282\u7ea7\u5173\u5361\u4e2d\uff0c\u60a8\u9700\u8981\u63d0\u5347\u901f\u5ea6\u624d\u80fd\u8df3\u8fc7\u4e00\u7cfb\u5217\u5bbd\u9614\u7684\u95f4\u9699\u3002\u8fd9\u7c7b\u4f3c\u4e8e\u6ed1\u677f\u8fd0\u52a8\u5458\u5728\u659c\u5761\u524d\u52a0\u901f\u3002\u52a8\u91cf\u56fe\u53ef\u4ee5\u8bf4\u660e\u901f\u5ea6\u968f\u65f6\u95f4\u589e\u52a0\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u54cd\u8df3\u8dc3\u8ddd\u79bb\u3002"}, {"question": "Run 2\u7684\u7a0b\u5e8f\u751f\u6210\u7cfb\u7edf\u662f\u5982\u4f55\u5de5\u4f5c\u7684\uff1f", "answer": "Run 2\u7684\u7a0b\u5e8f\u751f\u6210\u7cfb\u7edf\u901a\u8fc7\u4ee5\u968f\u673a\u987a\u5e8f\u7ec4\u5408\u9884\u5b9a\u4e49\u7684\u969c\u788d\u7269\u6765\u521b\u5efa\u72ec\u7279\u7684\u5173\u5361\u5e03\u5c40\u3002\u4f8b\u5982\uff0c\u57289\u7ea7\u5173\u5361\u4e2d\uff0c\u79fb\u52a8\u5e73\u53f0\u548c\u91cd\u529b\u53d8\u5316\u7684\u4f4d\u7f6e\u6bcf\u6b21\u6e38\u620f\u90fd\u4f1a\u6709\u6240\u4e0d\u540c\u3002\u6b64\u7cfb\u7edf\u786e\u4fdd\u6ca1\u6709\u4e24\u6b21\u6e38\u620f\u4f53\u9a8c\u662f\u76f8\u540c\u7684\uff0c\u589e\u52a0\u4e86\u6e38\u620f\u7684\u91cd\u590d\u6e38\u73a9\u6027\u3002\u628a\u5b83\u60f3\u8c61\u6210\u4e00\u526f\u6251\u514b\u724c\u2014\u2014\u6bcf\u6b21\u6d17\u724c\u90fd\u4f1a\u521b\u5efa\u4e00\u4e2a\u65b0\u7684\u7ec4\u5408\u3002\u6d41\u7a0b\u56fe\u89e3\u91ca\u4e86\u8be5\u8fc7\u7a0b\uff1a\u5f00\u59cb \u2192 \u751f\u6210\u969c\u788d\u7269 \u2192 \u968f\u673a\u5316\u653e\u7f6e \u2192 \u5b8c\u6210\u5173\u5361\u3002"}, {"question": "\u4eceRun 2\u7684\u684c\u9762\u7248\u8fc7\u6e21\u5230\u79fb\u52a8\u7248\uff0c\u6700\u4f73\u5b9e\u8df5\u662f\u4ec0\u4e48\uff1f", "answer": "\u4eceRun 2\u7684\u684c\u9762\u7248\u8fc7\u6e21\u5230\u79fb\u52a8\u7248\u9700\u8981\u9002\u5e94\u89e6\u6478\u63a7\u5236\u548c\u66f4\u5c0f\u7684\u5c4f\u5e55\u5c3a\u5bf8\u3002\u6b65\u9aa41 - \u5728\u65e9\u671f\u5173\u5361\u4e2d\u7ec3\u4e60\u4f7f\u7528\u89e6\u6478\u63a7\u5236\uff0c\u4ee5\u5efa\u7acb\u808c\u8089\u8bb0\u5fc6\u3002\u6b65\u9aa42 - \u8c03\u6574\u60a8\u7684\u6e38\u620f\u98ce\u683c\uff0c\u4ee5\u9002\u5e94\u7565\u5fae\u964d\u4f4e\u7684\u7cbe\u786e\u5ea6\u3002\u6b65\u9aa43 - \u4f7f\u7528\u79fb\u52a8\u7248\u7684\u6ed1\u52a8\u624b\u52bf\u6765\u5b9e\u73b0\u66f4\u6d41\u7545\u7684\u79fb\u52a8\u3002\u4f8b\u5982\uff0c\u57281\u7ea7\u5173\u5361\u4e2d\uff0c\u60a8\u9700\u8981\u70b9\u51fb\u548c\u6ed1\u52a8\u6765\u5bfc\u822a\u7b80\u5355\u7684\u969c\u788d\u7269\u3002\u6bd4\u8f83\u8868\u7a81\u51fa\u4e86\u5dee\u5f02\uff1a\u684c\u9762\u7248\uff08\u952e\u76d8\u7cbe\u5ea6\uff09\uff0c\u79fb\u52a8\u7248\uff08\u89e6\u6478\u7075\u6d3b\u6027\uff09\u3002"}]
[{"question": "\ucd08\ubcf4\uc790\uac00 Run 2\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc5b4\ub5bb\uac8c \ub9c8\uc2a4\ud130\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Run 2\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ub9c8\uc2a4\ud130\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1 - \ud654\uc0b4\ud45c \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uce90\ub9ad\ud130\ub97c \uc88c\uc6b0\ub85c \uc774\ub3d9\uc2dc\ud0b5\ub2c8\ub2e4. STEP2 - \uc704\ucabd \ud654\uc0b4\ud45c\ub97c \ub20c\ub7ec \uc810\ud504\ud558\uace0, \uc88c/\uc6b0 \ud654\uc0b4\ud45c\uc640 \uacb0\ud569\ud558\uc5ec \ubc29\ud5a5 \uc810\ud504\ub97c \uc218\ud589\ud569\ub2c8\ub2e4. STEP3 - \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub5a8\uc5b4\uc9c0\uc9c0 \uc54a\ub3c4\ub85d \uc810\ud504 \ud0c0\uc774\ubc0d \uc5f0\uc2b5\uc744 \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 1\ub2e8\uacc4\uc5d0\uc11c\ub294 \ucd94\uc9c4\ub825\uc744 \uc720\uc9c0\ud558\uba74\uc11c \uac04\uaca9\uc744 \ub6f0\uc5b4\ub118\uc5b4\uc57c \ud569\ub2c8\ub2e4. \uc720\uc6a9\ud55c \ud301\uc740 \ucee8\ud2b8\ub864\uc744 \uc790\ub3d9\ucc28 \uc870\ud5a5\uacfc \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \ubd80\ub4dc\ub7fd\uace0 \uc815\ud655\ud55c \uc6c0\uc9c1\uc784\uc774 \uc911\uc694\ud569\ub2c8\ub2e4."}, {"question": "Run 2\uc5d0\uc11c \ub354 \uc624\ub798 \uc0dd\uc874\ud558\uae30 \uc704\ud55c \ud544\uc218 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Run 2\uc5d0\uc11c \ub354 \uc624\ub798 \uc0dd\uc874\ud558\ub824\uba74 \ud0c0\uc774\ubc0d\uacfc \uc804\ub7b5\uc758 \uc870\ud569\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1 - \uc55e\uc73c\ub85c \uc624\ub294 \uc7a5\uc560\ubb3c\uc744 \uc608\uce21\ud558\uae30 \uc704\ud574 \ud56d\uc0c1 \uc55e\uc744 \ub0b4\ub2e4\ubcf4\uc138\uc694. STEP2 - \uc790\uc8fc \uba48\ucd94\ub294 \ub300\uc2e0 \uafb8\uc900\ud55c \uc18d\ub3c4\ub85c \ub2ec\ub824\uc11c \ucd94\uc9c4\ub825\uc744 \uc774\uc6a9\ud558\uc138\uc694. STEP3 - \uae4c\ub2e4\ub85c\uc6b4 \uad6c\uac04\uc744 \ud0d0\uc0c9\ud558\uae30 \uc704\ud574 \uc815\ubc00\ud55c \uc810\ud504 \uc5f0\uc2b5\uc744 \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 5\ub2e8\uacc4\uc5d0\uc11c\ub294 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uc774 \ud544\uc694\ud55c \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uc744 \ub9cc\ub098\uac8c \ub429\ub2c8\ub2e4. \uc774\uac83\uc740 \ub9ac\ub4ec \uac8c\uc784\uacfc \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uc138\uc694. \ud50c\ub7ab\ud3fc \uc6c0\uc9c1\uc784\uc5d0 \ub9de\ucdb0 \uc810\ud504\ub97c \ub9de\ucdb0\uc57c \ud569\ub2c8\ub2e4. \ub610\ud55c, '\ubcbd \uc810\ud504' \uae30\uc220\uc744 \ub9c8\uc2a4\ud130\ud558\uba74 \uc2e4\uc218\ub97c \ub9cc\ud68c\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Run 2\uc758 \uc911\ub825 \uba54\ucee4\ub2c8\uc998\uc774 \ud2b9\uc815 \ub2e8\uacc4\uc5d0\uc11c \ub2e4\ub978 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Run 2\uc758 \uc911\ub825 \uba54\ucee4\ub2c8\uc998\uc740 \ubcf5\uc7a1\uc131\uc744 \ub354\ud558\uae30 \uc704\ud574 \ub2e8\uacc4\ubcc4\ub85c \ub2e4\ub985\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 3\ub2e8\uacc4\uc5d0\uc11c\ub294 \uace1\uc120 \ud45c\uba74\uc73c\ub85c \uc774\ub3d9\ud560 \ub54c \uc911\ub825\uc774 \ubcc0\ud558\uc5ec \uce90\ub9ad\ud130\uac00 \uac70\uafb8\ub85c \ub2ec\ub9ac\uac8c \ub429\ub2c8\ub2e4. \uc774\ub294 \uac8c\uc784\uc758 \ubb3c\ub9ac \uc5d4\uc9c4\uc774 \uc6d0\uc2ec\ub825\uc744 \uc2dc\ubbac\ub808\uc774\uc158\ud558\ub294 \ubc29\uc2dd\uc73c\ub85c \ub2ec\uc131\ub429\ub2c8\ub2e4. \uc801\uc751\ud558\ub824\uba74 \uace1\uc120 \ub3c4\ub85c\uc5d0\uc11c \uc6b4\uc804\ud558\ub294 \uac83\ucc98\ub7fc \ucee8\ud2b8\ub864\uc744 \uc870\uc815\ud558\uc138\uc694. \ubcc0\ud654\ub97c \uc608\uce21\ud558\uace0 \uadf8\uc5d0 \ub530\ub77c \uc870\ud5a5\ud558\uc138\uc694. \uc911\ub825 \ubcc0\ud654\ub97c \uc2dc\uac01\ud654\ud558\ub294 \uad6c\uc131\ud45c\uac00 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4: 3\ub2e8\uacc4(\ub0ae\uc740 \uc911\ub825), 7\ub2e8\uacc4(\uc5ed\uc911\ub825)."}, {"question": "Run 2\uc5d0\uc11c \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uac00\uc7a5 \uc5b4\ub824\uc6b4 \ub2e8\uacc4\ub294 \uc5b4\ub5a4 \ub2e8\uacc4\uc778\uac00\uc694?", "answer": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \uc885\uc885 \ubcf5\uc7a1\ud55c \ub808\uc774\uc544\uc6c3\uacfc \uc911\ub825 \uba54\ucee4\ub2c8\uc998\uc73c\ub85c \uc778\ud574 8\ub2e8\uacc4\uc640 10\ub2e8\uacc4\ub97c \uac00\uc7a5 \uc5b4\ub835\ub2e4\uace0 \uc0dd\uac01\ud569\ub2c8\ub2e4. 8\ub2e8\uacc4\uc5d0\uc11c\ub294 \uad50\ub300\ub85c \uc911\ub825\uc774 \ubcc0\ud558\ub294 \uc881\uc740 \ud130\ub110\uc744 \ud0d0\uc0c9\ud574\uc57c \ud558\uba70, 10\ub2e8\uacc4\uc5d0\uc11c\ub294 \uc6c0\uc9c1\uc774\ub294 \uc7a5\uc560\ubb3c\uacfc \ube61\ube61\ud55c \ud0c0\uc774\ubc0d\uc774 \ub4f1\uc7a5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 8\ub2e8\uacc4\uc5d0\uc11c\ub294 \uc911\ub825 \ubcc0\ud654\uc5d0 \uc801\uc751\ud558\uba74\uc11c \uc77c\ub828\uc758 \ubcbd \uc810\ud504\ub97c \uc218\ud589\ud574\uc57c \ud569\ub2c8\ub2e4. \ub2e4\uc911 \ud574\uacb0\ucc45 \uc811\uadfc \ubc29\uc2dd\uc774 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc635\uc158 A - \ucc9c\ucc9c\ud788 \uafb8\uc900\ud788 \uc9c4\ud589, \uc635\uc158 B - \ucd94\uc9c4\ub825\uc744 \uc774\uc6a9\ud558\uc5ec \uad6c\uac04\uc744 \ube60\ub974\uac8c \ud1b5\uacfc."}, {"question": "Run 2\uc758 \ub808\ubca8 \ub514\uc790\uc778\uc740 \uc7ac\uc0dd \uac00\ub2a5\uc131\uc744 \uc5b4\ub5bb\uac8c \uc7a5\ub824\ud558\ub294\uac00?", "answer": "Run 2\uc758 \ub808\ubca8 \ub514\uc790\uc778\uc740 \ub3d9\uc801\uc778 \uc7a5\uc560\ubb3c\uacfc \uc808\ucc28\uc801 \uc0dd\uc131\uc744 \ud1b5\ud574 \uc7ac\uc0dd \uac00\ub2a5\uc131\uc744 \uc7a5\ub824\ud569\ub2c8\ub2e4. \uac01 \ud50c\ub808\uc774\ub294 \uc57d\uac04 \ub2e4\ub978 \ub3c4\uc804 \uacfc\uc81c\ub97c \uc81c\uacf5\ud558\uc5ec \uacbd\ud5d8\uc744 \uc0c8\ub86d\uac8c \uc720\uc9c0\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 6\ub2e8\uacc4\uc5d0\uc11c\ub294 \uc774\ub3d9 \ud50c\ub7ab\ud3fc\uc758 \ubc30\uce58\uac00 \ub9e4\ubc88 \uc7ac\uc2dc\uc791\ud560 \ub54c\ub9c8\ub2e4 \ubcc0\uacbd\ub429\ub2c8\ub2e4. \uc774\ub294 \ub9e4\ubc88 \uc0c8\ub85c\uc6b4 \ud37c\uc990\uc744 \ud478\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uac8c\uc784\uc740 \ucd5c\uace0 \uae30\ub85d\uc744 \ucd94\uc801\ud558\uc5ec \uac1c\uc120\uc744 \uc704\ud55c \ub3d9\uae30\ub97c \ubd80\uc5ec\ud569\ub2c8\ub2e4. \ub808\ubca8 \ub514\uc790\uc778 \ud504\ub85c\uc138\uc2a4\uc758 \ud50c\ub85c\uc6b0\ucc28\ud2b8\ub294 \uc7a5\uc560\ubb3c \ubc30\uce58\uc5d0 \ub300\ud55c \ubb34\uc791\uc704\uc131\uc774 \uc5b4\ub5bb\uac8c \ud1b5\ud569\ub418\ub294\uc9c0 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4."}, {"question": "Run 2\uc758 \ub370\uc2a4\ud06c\ud1b1 \ubc84\uc804\uacfc \ubaa8\ubc14\uc77c \ubc84\uc804\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Run 2\uc758 \ub370\uc2a4\ud06c\ud1b1 \ubc84\uc804\uacfc \ubaa8\ubc14\uc77c \ubc84\uc804\uc740 \uc8fc\ub85c \ucee8\ud2b8\ub864\uacfc \uc131\ub2a5\uc774 \ub2e4\ub985\ub2c8\ub2e4. \ub370\uc2a4\ud06c\ud1b1\uc5d0\uc11c\ub294 \uc815\ud655\ud55c \uc6c0\uc9c1\uc784\uc744 \uc704\ud574 \ud654\uc0b4\ud45c \ud0a4\ub97c \uc0ac\uc6a9\ud558\uba70, \ubaa8\ubc14\uc77c\uc740 \ud130\uce58 \ucee8\ud2b8\ub864\uc5d0 \uc758\uc874\ud558\uc5ec \uc815\ud655\ub3c4\uac00 \ub35c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 4\ub2e8\uacc4\uc5d0\uc11c\ub294 \ub370\uc2a4\ud06c\ud1b1 \ud50c\ub808\uc774\uc5b4\uac00 \ubaa8\ubc14\uc77c \uc0ac\uc6a9\uc790\ubcf4\ub2e4 \uc815\ud655\ud55c \uc810\ud504\ub97c \ub354 \uc27d\uac8c \uc218\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uad6c\uc131 \ube44\uad50 \ud45c\ub294 \ub2e4\uc74c\uacfc \uac19\uc740 \ucc28\uc774\uc810\uc744 \uac15\uc870\ud569\ub2c8\ub2e4. \ub370\uc2a4\ud06c\ud1b1(\ud0a4\ubcf4\ub4dc \ucee8\ud2b8\ub864, \ub192\uc740 FPS), \ubaa8\ubc14\uc77c(\ud130\uce58 \ucee8\ud2b8\ub864, \uc791\uc740 \ud654\uba74 \ucd5c\uc801\ud654)."}, {"question": "Run 2\uc5d0\uc11c \uc228\uaca8\uc9c4 \uce90\ub9ad\ud130\ub97c \uc5b4\ub5bb\uac8c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Run 2\uc5d0\uc11c \uc228\uaca8\uc9c4 \uce90\ub9ad\ud130\ub97c \uc7a0\uae08 \ud574\uc81c\ud558\ub824\uba74 10\ub2e8\uacc4\ub97c 3\ubc88 \uc774\uc0c1 \ub118\uc5b4\uc9c0\uc9c0 \uc54a\uace0 \uc644\ub8cc\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774 \uce90\ub9ad\ud130\ub294 '\uadf8\ub9bc\uc790'\ub85c \uc54c\ub824\uc838 \uc788\uc73c\uba70 \uc18d\ub3c4\uc640 \uc810\ud504 \ub192\uc774\uac00 \ud5a5\uc0c1\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 10\ub2e8\uacc4\uc5d0\uc11c\ub294 \uc774\ub97c \ub2ec\uc131\ud558\uae30 \uc704\ud574 \uc77c\ub828\uc758 \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uacfc \ube61\ube61\ud55c \uc810\ud504\ub97c \ud0d0\uc0c9\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774\ub294 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc744 \ub9c8\uc2a4\ud130\ud55c \ubcf4\uc0c1\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4\ubcc4 \uac00\uc774\ub4dc\uac00 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1 - 10\ub2e8\uacc4\ub97c \ubc18\ubcf5\uc801\uc73c\ub85c \uc5f0\uc2b5\ud569\ub2c8\ub2e4. STEP2 - \uc2e4\uc218\ub97c \ucd5c\uc18c\ud654\ud569\ub2c8\ub2e4. STEP3 - 3\ubc88 \ubbf8\ub9cc\uc758 \ub099\ud558\ub85c \ub808\ubca8\uc744 \uc644\ub8cc\ud569\ub2c8\ub2e4."}, {"question": "Run 2\uc758 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc5d0\uc11c \ucd94\uc9c4\ub825\uc740 \uc5b4\ub5a4 \uc5ed\ud560\uc744 \ud558\ub098\uc694?", "answer": "\ucd94\uc9c4\ub825\uc740 Run 2\uc758 \ud575\uc2ec \uba54\ucee4\ub2c8\uc998\uc73c\ub85c \uc774\ub3d9\uacfc \uc810\ud504 \ubaa8\ub450\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ucd94\uc9c4\ub825\uc744 \uc720\uc9c0\ud558\uba74 \ub354 \uae34 \uac04\uaca9\uc744 \ub6f0\uc5b4\ub118\uace0 \uae4c\ub2e4\ub85c\uc6b4 \uad6c\uac04\uc744 \ud0d0\uc0c9\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 2\ub2e8\uacc4\uc5d0\uc11c\ub294 \uc77c\ub828\uc758 \ub113\uc740 \uac04\uaca9\uc744 \ub6f0\uc5b4\ub118\uae30 \uc704\ud574 \uc18d\ub3c4\ub97c \ub0bc \ud544\uc694\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub294 \uc2a4\ucf00\uc774\ud2b8\ubcf4\ub354\uac00 \ub7a8\ud504 \uc804\uc5d0 \uc18d\ub3c4\ub97c \ub0b4\ub294 \ubc29\uc2dd\uacfc \uc720\uc0ac\ud569\ub2c8\ub2e4. \ucd94\uc9c4\ub825 \uadf8\ub798\ud504\ub294 \uc2dc\uac04\uc774 \uc9c0\ub0a8\uc5d0 \ub530\ub77c \uc18d\ub3c4\uac00 \uc99d\uac00\ud558\uace0 \uc810\ud504 \uac70\ub9ac\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc744 \ubcf4\uc5ec\uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Run 2\uc758 \uc808\ucc28\uc801 \uc0dd\uc131 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "Run 2\uc758 \uc808\ucc28\uc801 \uc0dd\uc131 \uc2dc\uc2a4\ud15c\uc740 \ubbf8\ub9ac \uc815\uc758\ub41c \uc7a5\uc560\ubb3c\uc744 \ubb34\uc791\uc704 \uc21c\uc11c\ub85c \uacb0\ud569\ud558\uc5ec \uace0\uc720\ud55c \ub808\ubca8 \ub808\uc774\uc544\uc6c3\uc744 \ub9cc\ub4ed\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 9\ub2e8\uacc4\uc5d0\uc11c\ub294 \uc774\ub3d9 \ud50c\ub7ab\ud3fc\uacfc \uc911\ub825 \ubcc0\ud654\uc758 \ubc30\uce58\uac00 \ub9e4\ubc88 \ud50c\ub808\uc774\ud560 \ub54c\ub9c8\ub2e4 \ub2e4\ub985\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uac00 \ub3d9\uc77c\ud558\uc9c0 \uc54a\ub3c4\ub85d \ud558\uc5ec \uac8c\uc784\uc758 \uc7ac\uc0dd \uac00\ub2a5\uc131\uc744 \ub354\ud569\ub2c8\ub2e4. \uc774\ub294 \uce74\ub4dc \ub371\uacfc \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uc138\uc694. \uac01 \uc154\ud50c\uc740 \uc0c8\ub85c\uc6b4 \uc870\ud569\uc744 \ub9cc\ub4ed\ub2c8\ub2e4. \ud50c\ub85c\uc6b0\ucc28\ud2b8\ub294 \ub2e4\uc74c\uacfc \uac19\uc740 \ud504\ub85c\uc138\uc2a4\ub97c \uc124\uba85\ud569\ub2c8\ub2e4: \uc2dc\uc791 \u2192 \uc7a5\uc560\ubb3c \uc0dd\uc131 \u2192 \ubc30\uce58 \ubb34\uc791\uc704\ud654 \u2192 \ub808\ubca8 \uc644\ub8cc."}, {"question": "Run 2\uc758 \ub370\uc2a4\ud06c\ud1b1 \ubc84\uc804\uc5d0\uc11c \ubaa8\ubc14\uc77c \ubc84\uc804\uc73c\ub85c \uc804\ud658\ud558\ub294 \ucd5c\uace0\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Run 2\uc758 \ub370\uc2a4\ud06c\ud1b1 \ubc84\uc804\uc5d0\uc11c \ubaa8\ubc14\uc77c \ubc84\uc804\uc73c\ub85c \uc804\ud658\ud558\ub824\uba74 \ud130\uce58 \ucee8\ud2b8\ub864\uacfc \uc791\uc740 \ud654\uba74 \ud06c\uae30\uc5d0 \uc801\uc751\ud574\uc57c \ud569\ub2c8\ub2e4. STEP1 - \ucd08\uae30 \ub808\ubca8\uc5d0\uc11c \ud130\uce58 \ucee8\ud2b8\ub864\uc744 \uc0ac\uc6a9\ud558\uc5ec \uadfc\uc721 \uae30\uc5b5\ub825\uc744 \uad6c\ucd95\ud558\uc138\uc694. STEP2 - \uc57d\uac04 \ub35c \uc815\ud655\ud558\ub2e4\ub294 \uc810\uc744 \uac10\uc548\ud558\uc5ec \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \uc870\uc815\ud558\uc138\uc694. STEP3 - \ubaa8\ubc14\uc77c \ubc84\uc804\uc758 \uc2a4 \uc640\uc774\ud504 \uc81c\uc2a4\ucc98\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub354 \uc6d0\ud65c\ud558\uac8c \uc6c0\uc9c1\uc774\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, 1\ub2e8\uacc4\uc5d0\uc11c\ub294 \uac04\ub2e8\ud55c \uc7a5\uc560\ubb3c\uc744 \ud0d0\uc0c9\ud558\uae30 \uc704\ud574 \ud0ed\ud558\uace0 \uc2a4 \uc640\uc774\ud504\ud574\uc57c \ud569\ub2c8\ub2e4. \ube44\uad50 \ud45c\ub294 \ub2e4\uc74c\uacfc \uac19\uc740 \ucc28\uc774\uc810\uc744 \uac15\uc870\ud569\ub2c8\ub2e4. \ub370\uc2a4\ud06c\ud1b1(\ud0a4\ubcf4\ub4dc \uc815\ubc00\ub3c4), \ubaa8\ubc14\uc77c(\ud130\uce58 \uc720\uc5f0\uc131)."}]
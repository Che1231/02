[{"question": "\u521d\u5fc3\u8005\u306e\u65b9\u3001Run 2\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "Run 2\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u77e2\u5370\u30ad\u30fc\u3092\u4f7f\u3063\u3066\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u5de6\u53f3\u306b\u79fb\u52d5\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u4e0a\u77e2\u5370\u30ad\u30fc\u3092\u62bc\u3057\u3066\u30b8\u30e3\u30f3\u30d7\u3057\u3001\u5de6\u53f3\u306e\u77e2\u5370\u30ad\u30fc\u3068\u7d44\u307f\u5408\u308f\u305b\u3066\u65b9\u5411\u30b8\u30e3\u30f3\u30d7\u3092\u884c\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u304b\u3089\u843d\u3061\u306a\u3044\u3088\u3046\u306b\u3001\u30b8\u30e3\u30f3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u7df4\u7fd2\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb1\u3067\u306f\u3001\u52e2\u3044\u3092\u7dad\u6301\u3057\u306a\u304c\u3089\u30ae\u30e3\u30c3\u30d7\u3092\u30b8\u30e3\u30f3\u30d7\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30ab\u30fc\u3092\u64cd\u7e26\u3059\u308b\u3088\u3046\u306b\u64cd\u4f5c\u3059\u308b\u3053\u3068\u3092\u8003\u3048\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u6ed1\u3089\u304b\u3067\u6b63\u78ba\u306a\u52d5\u304d\u304c\u9375\u3068\u306a\u308a\u307e\u3059\u3002"}, {"question": "Run 2\u3067\u3088\u308a\u9577\u304f\u751f\u304d\u6b8b\u308b\u305f\u3081\u306e\u91cd\u8981\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Run 2\u3067\u3088\u308a\u9577\u304f\u751f\u304d\u6b8b\u308b\u305f\u3081\u306b\u306f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u6226\u7565\u306e\u7d44\u307f\u5408\u308f\u305b\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5e38\u306b\u524d\u65b9\u3092\u898b\u3066\u3001\u4eca\u5f8c\u306e\u969c\u5bb3\u3092\u4e88\u6e2c\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u983b\u7e41\u306b\u505c\u6b62\u3059\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u4e00\u5b9a\u306e\u30da\u30fc\u30b9\u3067\u8d70\u308a\u7d9a\u3051\u308b\u3053\u3068\u3067\u3001\u52e2\u3044\u3092\u81ea\u5206\u306e\u5473\u65b9\u306b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6b63\u78ba\u306a\u30b8\u30e3\u30f3\u30d7\u306e\u7df4\u7fd2\u3092\u3057\u3066\u3001\u96e3\u3057\u3044\u30bb\u30af\u30b7\u30e7\u30f3\u3092\u4e57\u308a\u8d8a\u3048\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb5\u3067\u306f\u3001\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u5fc5\u8981\u306a\u52d5\u304f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u304c\u3042\u308a\u307e\u3059\u3002\u30ea\u30ba\u30e0\u30b2\u30fc\u30e0\u306e\u3088\u3046\u306b\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u52d5\u304d\u306b\u5408\u308f\u305b\u3066\u30b8\u30e3\u30f3\u30d7\u3092\u540c\u671f\u3055\u305b\u3066\u304f\u3060\u3055\u3044\u3002\u307e\u305f\u3001\u300c\u58c1\u30b8\u30e3\u30f3\u30d7\u300d\u306e\u6280\u8853\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3068\u3001\u30df\u30b9\u304b\u3089\u306e\u56de\u5fa9\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "Run 2\u306e\u91cd\u529b\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u7279\u5b9a\u306e\u30ec\u30d9\u30eb\u3067\u7570\u306a\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "Run 2\u306e\u91cd\u529b\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u8907\u96d1\u3055\u3092\u52a0\u3048\u308b\u305f\u3081\u306b\u30ec\u30d9\u30eb\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb3\u3067\u306f\u3001\u6e7e\u66f2\u3057\u305f\u9762\u306b\u79fb\u52d5\u3059\u308b\u3068\u3001\u91cd\u529b\u304c\u5909\u5316\u3057\u3066\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u9006\u3055\u307e\u306b\u306a\u308a\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u30b2\u30fc\u30e0\u306e\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u306b\u3088\u3063\u3066\u5b9f\u73fe\u3055\u308c\u3001\u9060\u5fc3\u529b\u3092\u30b7\u30df\u30e5\u30ec\u30fc\u30c8\u3057\u3066\u3044\u307e\u3059\u3002\u9069\u5fdc\u3059\u308b\u306b\u306f\u3001\u6e7e\u66f2\u3057\u305f\u9053\u8def\u3092\u904b\u8ee2\u3057\u3066\u3044\u308b\u304b\u306e\u3088\u3046\u306b\u64cd\u4f5c\u3092\u8abf\u6574\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u5909\u5316\u3092\u4e88\u6e2c\u3057\u3066\u3001\u305d\u308c\u306b\u5fdc\u3058\u3066\u64cd\u4f5c\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u91cd\u529b\u30b7\u30d5\u30c8\u3092\u8996\u899a\u5316\u3059\u308b\u69cb\u6210\u8868\u306f\u5f79\u7acb\u3061\u307e\u3059\uff1a\u30ec\u30d9\u30eb3\uff08\u4f4e\u91cd\u529b\uff09\u3001\u30ec\u30d9\u30eb7\uff08\u9006\u91cd\u529b\uff09\u3002"}, {"question": "Run 2\u3067\u3001\u4e0a\u7d1a\u8005\u306b\u3068\u3063\u3066\u6700\u3082\u96e3\u3057\u3044\u30ec\u30d9\u30eb\u306f\u3069\u308c\u3067\u3059\u304b\uff1f", "answer": "\u4e0a\u7d1a\u8005\u306f\u3001\u8907\u96d1\u306a\u30ec\u30a4\u30a2\u30a6\u30c8\u3068\u91cd\u529b\u30e1\u30ab\u30cb\u30ba\u30e0\u306e\u305f\u3081\u306b\u3001\u30ec\u30d9\u30eb8\u306810\u3092\u6700\u3082\u96e3\u3057\u3044\u3068\u611f\u3058\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u30ec\u30d9\u30eb8\u3067\u306f\u3001\u4ea4\u4e92\u306b\u91cd\u529b\u304c\u5909\u308f\u308b\u72ed\u3044\u30c8\u30f3\u30cd\u30eb\u3092\u79fb\u52d5\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30ec\u30d9\u30eb10\u3067\u306f\u3001\u52d5\u304d\u306e\u969c\u5bb3\u7269\u3068\u30bf\u30a4\u30c8\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u767b\u5834\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb8\u3067\u306f\u3001\u91cd\u529b\u306e\u5909\u5316\u306b\u5408\u308f\u305b\u3066\u4e00\u9023\u306e\u58c1\u30b8\u30e3\u30f3\u30d7\u3092\u5b9f\u884c\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u591a\u69d8\u306a\u5bfe\u51e6\u6cd5\u304c\u6709\u52b9\u3067\u3059\u3002\u30aa\u30d7\u30b7\u30e7\u30f3A\uff1a\u3086\u3063\u304f\u308a\u3068\u78ba\u5b9f\u306b\u9032\u3081\u307e\u3059\u3002\u30aa\u30d7\u30b7\u30e7\u30f3B\uff1a\u52e2\u3044\u3092\u99c6\u4f7f\u3057\u3066\u30b9\u30e0\u30fc\u30ba\u306b\u9032\u307f\u307e\u3059\u3002"}, {"question": "Run 2\u306e\u30ec\u30d9\u30eb\u30c7\u30b6\u30a4\u30f3\u306f\u3001\u30d7\u30ec\u30a4\u30a2\u30d3\u30ea\u30c6\u30a3\u3092\u3069\u306e\u3088\u3046\u306b\u4fc3\u9032\u3057\u3066\u3044\u307e\u3059\u304b\uff1f", "answer": "Run 2\u306e\u30ec\u30d9\u30eb\u30c7\u30b6\u30a4\u30f3\u306f\u3001\u52d5\u7684\u306a\u969c\u5bb3\u7269\u3068\u624b\u7d9a\u304d\u7684\u751f\u6210\u3092\u901a\u3057\u3066\u3001\u30d7\u30ec\u30a4\u30a2\u30d3\u30ea\u30c6\u30a3\u3092\u4fc3\u9032\u3057\u307e\u3059\u3002\u5404\u30d7\u30ec\u30a4\u306f\u3001\u7d4c\u9a13\u3092\u65b0\u3057\u304f\u4fdd\u3064\u3001\u308f\u305a\u304b\u306b\u7570\u306a\u308b\u8ab2\u984c\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb6\u3067\u306f\u3001\u52d5\u304f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u914d\u7f6e\u306f\u3001\u6bce\u56de\u518d\u8d77\u52d5\u3059\u308b\u305f\u3073\u306b\u5909\u308f\u308a\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u6bce\u56de\u65b0\u3057\u3044\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u3055\u3089\u306b\u3001\u30b2\u30fc\u30e0\u306f\u3042\u306a\u305f\u306e\u6700\u901f\u30bf\u30a4\u30e0\u3092\u8ffd\u8de1\u3057\u3001\u6539\u5584\u3092\u4fc3\u3057\u307e\u3059\u3002\u30ec\u30d9\u30eb\u30c7\u30b6\u30a4\u30f3\u30d7\u30ed\u30bb\u30b9\u306e\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u306f\u3001\u30e9\u30f3\u30c0\u30e0\u6027\u304c\u969c\u5bb3\u7269\u914d\u7f6e\u306b\u3069\u306e\u3088\u3046\u306b\u7d71\u5408\u3055\u308c\u3066\u3044\u308b\u304b\u3092\u793a\u3057\u3066\u3044\u307e\u3059\u3002"}, {"question": "Run 2\u306e\u30c7\u30b9\u30af\u30c8\u30c3\u30d7\u7248\u3068\u30e2\u30d0\u30a4\u30eb\u7248\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Run 2\u306e\u30c7\u30b9\u30af\u30c8\u30c3\u30d7\u7248\u3068\u30e2\u30d0\u30a4\u30eb\u7248\u306f\u3001\u4e3b\u306b\u64cd\u4f5c\u3068\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u304a\u3044\u3066\u7570\u306a\u308a\u307e\u3059\u3002\u30c7\u30b9\u30af\u30c8\u30c3\u30d7\u7248\u3067\u306f\u3001\u6b63\u78ba\u306a\u79fb\u52d5\u306b\u77e2\u5370\u30ad\u30fc\u3092\u4f7f\u7528\u3057\u307e\u3059\u304c\u3001\u30e2\u30d0\u30a4\u30eb\u7248\u3067\u306f\u30bf\u30c3\u30c1\u64cd\u4f5c\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30bf\u30c3\u30c1\u64cd\u4f5c\u306f\u305d\u308c\u307b\u3069\u6b63\u78ba\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb4\u3067\u306f\u3001\u30c7\u30b9\u30af\u30c8\u30c3\u30d7\u7248\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30e2\u30d0\u30a4\u30eb\u30e6\u30fc\u30b6\u30fc\u3088\u308a\u3082\u6b63\u78ba\u306a\u30b8\u30e3\u30f3\u30d7\u3092\u3088\u308a\u7c21\u5358\u306b\u5b9f\u884c\u3067\u304d\u307e\u3059\u3002\u69cb\u6210\u6bd4\u8f03\u8868\u306f\u3001\u305d\u306e\u9055\u3044\u3092\u793a\u3057\u3066\u3044\u307e\u3059\u3002\u30c7\u30b9\u30af\u30c8\u30c3\u30d7\uff08\u30ad\u30fc\u30dc\u30fc\u30c9\u64cd\u4f5c\u3001\u9ad8\u3044\u30d5\u30ec\u30fc\u30e0\u30ec\u30fc\u30c8\uff09\u3001\u30e2\u30d0\u30a4\u30eb\uff08\u30bf\u30c3\u30c1\u64cd\u4f5c\u3001\u5c0f\u3055\u3044\u753b\u9762\u7528\u306b\u6700\u9069\u5316\uff09"}, {"question": "Run 2\u3067\u96a0\u3055\u308c\u305f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u3069\u306e\u3088\u3046\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Run 2\u3067\u96a0\u3055\u308c\u305f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u300c\u5f71\u300d\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u306b\u306f\u3001\u30ec\u30d9\u30eb10\u30923\u56de\u4ee5\u4e0a\u843d\u3061\u306a\u3044\u3067\u30af\u30ea\u30a2\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306f\u3001\u901f\u5ea6\u3068\u30b8\u30e3\u30f3\u30d7\u306e\u9ad8\u3055\u306b\u5f37\u5316\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb10\u3067\u306f\u3001\u3053\u308c\u3092\u5b9f\u73fe\u3059\u308b\u305f\u3081\u306b\u3001\u4e00\u9023\u306e\u52d5\u3044\u3066\u3044\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3068\u30bf\u30a4\u30c8\u306a\u30b8\u30e3\u30f3\u30d7\u3092\u4e57\u308a\u8d8a\u3048\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u30de\u30b9\u30bf\u30fc\u3057\u305f\u30ea\u30ef\u30fc\u30c9\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u6bb5\u968e\u7684\u306a\u30ac\u30a4\u30c9\u306f\u3001\u5f79\u7acb\u3061\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30ec\u30d9\u30eb10\u3092\u7e70\u308a\u8fd4\u3057\u7df4\u7fd2\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30df\u30b9\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a3\u56de\u672a\u6e80\u306e\u843d\u4e0b\u3067\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3057\u307e\u3059\u3002"}, {"question": "Run 2\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u304a\u3044\u3066\u3001\u52e2\u3044\u306f\u3069\u306e\u3088\u3046\u306a\u5f79\u5272\u3092\u679c\u305f\u3057\u307e\u3059\u304b\uff1f", "answer": "\u52e2\u3044\u306fRun 2\u306e\u91cd\u8981\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3067\u3042\u308a\u3001\u79fb\u52d5\u3068\u30b8\u30e3\u30f3\u30d7\u306e\u4e21\u65b9\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u52e2\u3044\u3092\u7dad\u6301\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u9577\u3044\u30ae\u30e3\u30c3\u30d7\u3092\u30af\u30ea\u30a2\u3057\u3001\u96e3\u3057\u3044\u30bb\u30af\u30b7\u30e7\u30f3\u3092\u4e57\u308a\u8d8a\u3048\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb2\u3067\u306f\u3001\u4e00\u9023\u306e\u5e83\u3044\u30ae\u30e3\u30c3\u30d7\u3092\u30b8\u30e3\u30f3\u30d7\u3059\u308b\u305f\u3081\u306b\u901f\u5ea6\u3092\u4e0a\u3052\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u30b9\u30b1\u30fc\u30c8\u30dc\u30fc\u30c9\u4e57\u308a\u304c\u30e9\u30f3\u30d7\u524d\u306b\u30b9\u30d4\u30fc\u30c9\u3092\u4e0a\u3052\u308b\u65b9\u6cd5\u3068\u4f3c\u3066\u3044\u307e\u3059\u3002\u52e2\u3044\u30b0\u30e9\u30d5\u306f\u3001\u6642\u9593\u306e\u7d4c\u904e\u3068\u3068\u3082\u306b\u30b9\u30d4\u30fc\u30c9\u304c\u5897\u52a0\u3057\u3001\u30b8\u30e3\u30f3\u30d7\u8ddd\u96e2\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3059\u308b\u304b\u3092\u793a\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Run 2\u306e\u624b\u7d9a\u304d\u7684\u751f\u6210\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "Run 2\u306e\u624b\u7d9a\u304d\u7684\u751f\u6210\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u4e8b\u524d\u5b9a\u7fa9\u3055\u308c\u305f\u969c\u5bb3\u7269\u3092\u30e9\u30f3\u30c0\u30e0\u306a\u30b7\u30fc\u30b1\u30f3\u30b9\u3067\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3001\u30e6\u30cb\u30fc\u30af\u306a\u30ec\u30d9\u30eb\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u4f5c\u6210\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb9\u3067\u306f\u3001\u52d5\u304f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u914d\u7f6e\u3068\u91cd\u529b\u306e\u5909\u5316\u306f\u3001\u6bce\u56de\u30d7\u30ec\u30a4\u3059\u308b\u305f\u3073\u306b\u7570\u306a\u308a\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u30012\u3064\u306e\u30d7\u30ec\u30a4\u304c\u540c\u3058\u306b\u306a\u3089\u306a\u3044\u3088\u3046\u306b\u4fdd\u8a3c\u3057\u3001\u30b2\u30fc\u30e0\u306e\u30d7\u30ec\u30a4\u30a2\u30d3\u30ea\u30c6\u30a3\u3092\u9ad8\u3081\u307e\u3059\u3002\u30c8\u30e9\u30f3\u30d7\u306e\u30c7\u30c3\u30ad\u306e\u3088\u3046\u306b\u8003\u3048\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u30b7\u30e3\u30c3\u30d5\u30eb\u3059\u308b\u305f\u3073\u306b\u65b0\u3057\u3044\u7d44\u307f\u5408\u308f\u305b\u304c\u4f5c\u6210\u3055\u308c\u307e\u3059\u3002\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u306f\u3001\u30d7\u30ed\u30bb\u30b9\u3092\u8aac\u660e\u3057\u307e\u3059\u3002\u958b\u59cb\u2192\u969c\u5bb3\u7269\u751f\u6210\u2192\u914d\u7f6e\u30e9\u30f3\u30c0\u30e0\u5316\u2192\u30ec\u30d9\u30eb\u5b8c\u4e86\u3002"}, {"question": "Run 2\u306e\u30c7\u30b9\u30af\u30c8\u30c3\u30d7\u7248\u304b\u3089\u30e2\u30d0\u30a4\u30eb\u7248\u3078\u306e\u79fb\u884c\u3067\u3001\u3069\u306e\u3088\u3046\u306a\u30d9\u30b9\u30c8\u30d7\u30e9\u30af\u30c6\u30a3\u30b9\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "Run 2\u306e\u30c7\u30b9\u30af\u30c8\u30c3\u30d7\u7248\u304b\u3089\u30e2\u30d0\u30a4\u30eb\u7248\u3078\u306e\u79fb\u884c\u306f\u3001\u30bf\u30c3\u30c1\u64cd\u4f5c\u3068\u5c0f\u3055\u3044\u753b\u9762\u30b5\u30a4\u30ba\u3078\u306e\u8abf\u6574\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u65e9\u671f\u306e\u30ec\u30d9\u30eb\u3067\u30bf\u30c3\u30c1\u64cd\u4f5c\u306e\u7df4\u7fd2\u3092\u884c\u3044\u3001\u7b4b\u8089\u8a18\u61b6\u3092\u69cb\u7bc9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u308f\u305a\u304b\u306b\u7cbe\u5ea6\u304c\u4f4e\u3044\u3053\u3068\u3092\u8003\u616e\u3057\u3066\u3001\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30e2\u30d0\u30a4\u30eb\u7248\u306e\u30b9\u30ef\u30a4\u30d7\u30b8\u30a7\u30b9\u30c1\u30e3\u30fc\u3092\u4f7f\u7528\u3057\u3066\u3001\u3088\u308a\u30b9\u30e0\u30fc\u30ba\u306a\u79fb\u52d5\u3092\u884c\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb1\u3067\u306f\u3001\u7c21\u5358\u306a\u969c\u5bb3\u7269\u3092\u30ca\u30d3\u30b2\u30fc\u30c8\u3059\u308b\u305f\u3081\u306b\u30bf\u30c3\u30d7\u3068\u30b9\u30ef\u30a4\u30d7\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u6bd4\u8f03\u8868\u306f\u3001\u305d\u306e\u9055\u3044\u3092\u793a\u3057\u307e\u3059\u3002\u30c7\u30b9\u30af\u30c8\u30c3\u30d7\uff08\u30ad\u30fc\u30dc\u30fc\u30c9\u7cbe\u5ea6\uff09\u3001\u30e2\u30d0\u30a4\u30eb\uff08\u30bf\u30c3\u30c1\u306e\u67d4\u8edf\u6027\uff09"}]
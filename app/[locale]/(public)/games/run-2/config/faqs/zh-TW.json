[{"question": "\u5982\u4f55\u8b93\u521d\u5b78\u8005\u638c\u63e1 Run 2 \u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u638c\u63e1 Run 2 \u7684\u57fa\u672c\u63a7\u5236\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f 1 - \u4f7f\u7528\u65b9\u5411\u9375\u4f86\u5de6\u53f3\u79fb\u52d5\u4f60\u7684\u89d2\u8272\u3002\u6b65\u9a5f 2 - \u6309\u4e0b\u4e0a\u65b9\u5411\u9375\u8df3\u8e8d\uff0c\u4e26\u914d\u5408\u5de6\u53f3\u65b9\u5411\u9375\u9032\u884c\u65b9\u5411\u8df3\u8e8d\u3002\u6b65\u9a5f 3 - \u7df4\u7fd2\u8df3\u8e8d\u6642\u9593\u4ee5\u907f\u514d\u5f9e\u5e73\u53f0\u4e0a\u6389\u843d\u3002\u4f8b\u5982\uff0c\u5728 1 \u7d1a\uff0c\u60a8\u9700\u8981\u5728\u4fdd\u6301\u52d5\u91cf\u7684\u540c\u6642\u8df3\u904e\u9593\u9699\u3002\u4e00\u500b\u6709\u7528\u7684\u6280\u5de7\u662f\u5c07\u63a7\u5236\u60f3\u50cf\u70ba\u99d5\u99db\u6c7d\u8eca\u2014\u2014\u5e73\u7a69\u4e14\u7cbe\u6e96\u7684\u52d5\u4f5c\u662f\u95dc\u9375\u3002"}, {"question": "\u5728 Run 2 \u4e2d\u751f\u5b58\u66f4\u9577\u6642\u9593\u7684\u95dc\u9375\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728 Run 2 \u4e2d\u751f\u5b58\u66f4\u9577\u6642\u9593\u9700\u8981\u7d50\u5408\u6642\u6a5f\u548c\u7b56\u7565\u3002\u6b65\u9a5f 1 - \u7e3d\u662f\u5411\u524d\u770b\uff0c\u9810\u6e2c\u5373\u5c07\u51fa\u73fe\u7684\u969c\u7919\u3002\u6b65\u9a5f 2 - \u5229\u7528\u52d5\u91cf\u4f5c\u70ba\u512a\u52e2\uff0c\u4ee5\u7a69\u5b9a\u7684\u901f\u5ea6\u5954\u8dd1\uff0c\u800c\u4e0d\u662f\u983b\u7e41\u5730\u505c\u6b62\u3002\u6b65\u9a5f 3 - \u7df4\u7fd2\u7cbe\u78ba\u7684\u8df3\u8e8d\uff0c\u4ee5\u901a\u904e\u68d8\u624b\u7684\u5340\u57df\u3002\u4f8b\u5982\uff0c\u5728 5 \u7d1a\uff0c\u60a8\u6703\u9047\u5230\u9700\u8981\u7cbe\u78ba\u6642\u9593\u7684\u79fb\u52d5\u5e73\u53f0\u3002\u628a\u5b83\u60f3\u50cf\u6210\u4e00\u6b3e\u7bc0\u594f\u904a\u6232\u2014\u2014\u5c07\u60a8\u7684\u8df3\u8e8d\u8207\u5e73\u53f0\u52d5\u4f5c\u540c\u6b65\u3002\u6b64\u5916\uff0c\u638c\u63e1\u300c\u7246\u58c1\u8df3\u8e8d\u300d\u7684\u85dd\u8853\u53ef\u4ee5\u5e6b\u52a9\u60a8\u5f9e\u932f\u8aa4\u4e2d\u6062\u5fa9\u3002"}, {"question": "\u70ba\u4ec0\u9ebc Run 2 \u4e2d\u7684\u91cd\u529b\u6a5f\u5236\u5728\u67d0\u4e9b\u95dc\u5361\u4e2d\u611f\u89ba\u4e0d\u540c\uff1f", "answer": "Run 2 \u4e2d\u7684\u91cd\u529b\u6a5f\u5236\u5728\u4e0d\u540c\u95dc\u5361\u4e4b\u9593\u6709\u6240\u8b8a\u5316\uff0c\u4ee5\u589e\u52a0\u8907\u96dc\u6027\u3002\u4f8b\u5982\uff0c\u5728 3 \u7d1a\uff0c\u7576\u60a8\u79fb\u52d5\u5230\u5f4e\u66f2\u8868\u9762\u6642\uff0c\u91cd\u529b\u6703\u6539\u8b8a\uff0c\u4f7f\u60a8\u7684\u89d2\u8272\u5012\u8457\u8dd1\u3002\u9019\u662f\u901a\u904e\u904a\u6232\u7684\u7269\u7406\u5f15\u64ce\u5be6\u73fe\u7684\uff0c\u8a72\u5f15\u64ce\u6a21\u64ec\u4e86\u96e2\u5fc3\u529b\u3002\u70ba\u4e86\u9069\u61c9\uff0c\u8abf\u6574\u60a8\u7684\u63a7\u5236\u65b9\u5f0f\uff0c\u5c31\u50cf\u5728\u5f4e\u66f2\u7684\u9053\u8def\u4e0a\u99d5\u99db\u4e00\u6a23\u2014\u2014\u9810\u6e2c\u8b8a\u5316\u4e26\u76f8\u61c9\u5730\u8f49\u5411\u3002\u914d\u7f6e\u8868\u53ef\u4ee5\u5e6b\u52a9\u60a8\u53ef\u8996\u5316\u91cd\u529b\u8b8a\u5316\uff1a3 \u7d1a\uff08\u4f4e\u91cd\u529b\uff09\u30017 \u7d1a\uff08\u53cd\u91cd\u529b\uff09\u3002"}, {"question": "Run 2 \u4e2d\u54ea\u4e9b\u95dc\u5361\u88ab\u8a8d\u70ba\u662f\u9032\u968e\u73a9\u5bb6\u6700\u5177\u6311\u6230\u6027\u7684\u95dc\u5361\uff1f", "answer": "\u9032\u968e\u73a9\u5bb6\u7d93\u5e38\u767c\u73fe 8 \u7d1a\u548c 10 \u7d1a\u662f\u6700\u5177\u6311\u6230\u6027\u7684\u95dc\u5361\uff0c\u56e0\u70ba\u5b83\u5011\u7684\u4f48\u5c40\u548c\u91cd\u529b\u6a5f\u5236\u932f\u7d9c\u8907\u96dc\u3002\u5728 8 \u7d1a\uff0c\u60a8\u5fc5\u9808\u5728\u4ea4\u66ff\u7684\u91cd\u529b\u4e0b\u7a7f\u904e\u72f9\u7a84\u7684\u96a7\u9053\uff1b\u800c 10 \u7d1a\u5247\u5f15\u5165\u4e86\u79fb\u52d5\u969c\u7919\u7269\u548c\u7cbe\u78ba\u7684\u6642\u6a5f\u3002\u4f8b\u5982\uff0c\u5728 8 \u7d1a\uff0c\u60a8\u9700\u8981\u5728\u8abf\u6574\u91cd\u529b\u8b8a\u5316\u7684\u540c\u6642\u57f7\u884c\u4e00\u7cfb\u5217\u7684\u7246\u58c1\u8df3\u8e8d\u3002\u591a\u7a2e\u89e3\u6c7a\u65b9\u6848\u65b9\u6cd5\u53ef\u80fd\u6709\u6240\u5e6b\u52a9\uff1a\u9078\u9805 A - \u7a69\u7d2e\u7a69\u6253\uff1b\u9078\u9805 B - \u5229\u7528\u52d5\u91cf\u5feb\u901f\u901a\u904e\u90e8\u5206\u5340\u57df\u3002"}, {"question": "Run 2 \u7684\u95dc\u5361\u8a2d\u8a08\u5982\u4f55\u9f13\u52f5\u91cd\u73a9\u6027\uff1f", "answer": "Run 2 \u7684\u95dc\u5361\u8a2d\u8a08\u901a\u904e\u52d5\u614b\u969c\u7919\u7269\u548c\u7a0b\u5f0f\u751f\u6210\u4f86\u9f13\u52f5\u91cd\u73a9\u6027\u3002\u6bcf\u6b21\u904a\u73a9\u90fd\u6703\u63d0\u4f9b\u7565\u5fae\u4e0d\u540c\u7684\u6311\u6230\uff0c\u4fdd\u6301\u9ad4\u9a57\u7684\u65b0\u9bae\u611f\u3002\u4f8b\u5982\uff0c\u5728 6 \u7d1a\uff0c\u79fb\u52d5\u5e73\u53f0\u7684\u4f4d\u7f6e\u6bcf\u6b21\u91cd\u65b0\u958b\u59cb\u904a\u6232\u6642\u90fd\u6703\u6539\u8b8a\u3002\u9019\u5c31\u50cf\u6bcf\u6b21\u89e3\u6c7a\u4e00\u500b\u65b0\u7684\u8b0e\u984c\u4e00\u6a23\u3002\u6b64\u5916\uff0c\u904a\u6232\u6703\u8ffd\u8e64\u60a8\u7684\u6700\u4f73\u6642\u9593\uff0c\u6fc0\u52f5\u60a8\u63d0\u5347\u8868\u73fe\u3002\u95dc\u5361\u8a2d\u8a08\u904e\u7a0b\u7684\u6d41\u7a0b\u5716\u986f\u793a\u4e86\u96a8\u6a5f\u6027\u662f\u5982\u4f55\u6574\u5408\u5230\u969c\u7919\u7269\u4f48\u5c40\u4e2d\u7684\u3002"}, {"question": "Run 2 \u7684\u684c\u9762\u7248\u548c\u884c\u52d5\u7248\u672c\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "Run 2 \u7684\u684c\u9762\u7248\u548c\u884c\u52d5\u7248\u672c\u7684\u4e3b\u8981\u5dee\u7570\u5728\u65bc\u63a7\u5236\u548c\u6548\u80fd\u3002\u5728\u684c\u9762\u7248\u4e0a\uff0c\u60a8\u4f7f\u7528\u65b9\u5411\u9375\u9032\u884c\u7cbe\u78ba\u7684\u79fb\u52d5\uff1b\u800c\u884c\u52d5\u7248\u5247\u4f9d\u8cf4\u89f8\u63a7\u63a7\u5236\uff0c\u6e96\u78ba\u6027\u53ef\u80fd\u8f03\u4f4e\u3002\u4f8b\u5982\uff0c\u5728 4 \u7d1a\uff0c\u684c\u9762\u7248\u73a9\u5bb6\u53ef\u4ee5\u6bd4\u884c\u52d5\u7248\u7528\u6236\u66f4\u5bb9\u6613\u57f7\u884c\u7cbe\u78ba\u7684\u8df3\u8e8d\u3002\u914d\u7f6e\u6bd4\u8f03\u8868\u7a81\u986f\u4e86\u9019\u4e9b\u5dee\u7570\uff1a\u684c\u9762\u7248\uff08\u9375\u76e4\u63a7\u5236\uff0c\u66f4\u9ad8 FPS\uff09\uff0c\u884c\u52d5\u7248\uff08\u89f8\u63a7\u63a7\u5236\uff0c\u512a\u5316\u4ee5\u9069\u5408\u8f03\u5c0f\u7684\u87a2\u5e55\uff09\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u89e3\u9396 Run 2 \u4e2d\u7684\u96b1\u85cf\u89d2\u8272\uff1f", "answer": "\u8981\u89e3\u9396 Run 2 \u4e2d\u7684\u96b1\u85cf\u89d2\u8272\uff0c\u60a8\u5fc5\u9808\u5728\u4e0d\u6454\u5012\u8d85\u904e\u4e09\u6b21\u7684\u60c5\u6cc1\u4e0b\u5b8c\u6210 10 \u7d1a\u3002\u9019\u500b\u89d2\u8272\uff0c\u7a31\u70ba\u300c\u9670\u5f71\u300d\uff0c\u5177\u6709\u589e\u5f37\u7684\u901f\u5ea6\u548c\u8df3\u8e8d\u9ad8\u5ea6\u3002\u4f8b\u5982\uff0c\u5728 10 \u7d1a\uff0c\u60a8\u9700\u8981\u99d5\u99ad\u4e00\u7cfb\u5217\u79fb\u52d5\u5e73\u53f0\u548c\u7cbe\u78ba\u7684\u8df3\u8e8d\u624d\u80fd\u9054\u5230\u9019\u500b\u76ee\u6a19\u3002\u628a\u5b83\u60f3\u50cf\u6210\u638c\u63e1\u904a\u6232\u6a5f\u5236\u7684\u734e\u52f5\u3002\u9010\u6b65\u6307\u5357\u53ef\u4ee5\u6709\u6240\u5e6b\u52a9\uff1a\u6b65\u9a5f 1 - \u53cd\u8986\u7df4\u7fd2 10 \u7d1a\uff1b\u6b65\u9a5f 2 - \u5c07\u932f\u8aa4\u964d\u5230\u6700\u4f4e\uff1b\u6b65\u9a5f 3 - \u4ee5\u5c11\u65bc\u4e09\u6b21\u7684\u8dcc\u5012\u4f86\u5b8c\u6210\u672c\u95dc\u5361\u3002"}, {"question": "\u52d5\u91cf\u5728 Run 2 \u7684\u904a\u6232\u6a5f\u5236\u4e2d\u626e\u6f14\u4ec0\u9ebc\u89d2\u8272\uff1f", "answer": "\u52d5\u91cf\u662f Run 2 \u4e2d\u7684\u6838\u5fc3\u6a5f\u5236\uff0c\u5f71\u97ff\u8457\u79fb\u52d5\u548c\u8df3\u8e8d\u3002\u4fdd\u6301\u52d5\u91cf\u6709\u52a9\u65bc\u60a8\u8de8\u8d8a\u66f4\u9577\u7684\u9593\u9699\uff0c\u4e26\u901a\u904e\u68d8\u624b\u7684\u5340\u57df\u3002\u4f8b\u5982\uff0c\u5728 2 \u7d1a\uff0c\u60a8\u9700\u8981\u589e\u5f37\u901f\u5ea6\u624d\u80fd\u8df3\u904e\u4e00\u7cfb\u5217\u5bec\u95ca\u7684\u9593\u9699\u3002\u9019\u985e\u4f3c\u65bc\u6ed1\u677f\u9078\u624b\u5728\u659c\u5761\u524d\u5efa\u69cb\u901f\u5ea6\u7684\u65b9\u5f0f\u3002\u52d5\u91cf\u5716\u8868\u53ef\u4ee5\u8aaa\u660e\u901f\u5ea6\u5982\u4f55\u96a8\u8457\u6642\u9593\u63a8\u79fb\u800c\u589e\u52a0\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u97ff\u8df3\u8e8d\u8ddd\u96e2\u3002"}, {"question": "Run 2 \u7684\u7a0b\u5f0f\u751f\u6210\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "Run 2 \u7684\u7a0b\u5f0f\u751f\u6210\u7cfb\u7d71\u900f\u904e\u5c07\u9810\u5b9a\u7fa9\u7684\u969c\u7919\u7269\u4ee5\u96a8\u6a5f\u9806\u5e8f\u7d44\u5408\uff0c\u5275\u9020\u51fa\u7368\u7279\u7684\u95dc\u5361\u4f48\u5c40\u3002\u4f8b\u5982\uff0c\u5728 9 \u7d1a\uff0c\u79fb\u52d5\u5e73\u53f0\u548c\u91cd\u529b\u8b8a\u5316\u6bcf\u6b21\u904a\u73a9\u90fd\u4e0d\u540c\u3002\u6b64\u7cfb\u7d71\u78ba\u4fdd\u6c92\u6709\u5169\u6b21\u904a\u73a9\u662f\u76f8\u540c\u7684\uff0c\u9032\u4e00\u6b65\u63d0\u9ad8\u4e86\u904a\u6232\u7684\u91cd\u73a9\u6027\u3002\u628a\u5b83\u60f3\u50cf\u6210\u4e00\u526f\u64b2\u514b\u724c\u2014\u2014\u6bcf\u6b21\u6d17\u724c\u90fd\u6703\u5275\u9020\u51fa\u65b0\u7684\u7d44\u5408\u3002\u6d41\u7a0b\u5716\u8aaa\u660e\u4e86\u6b64\u904e\u7a0b\uff1a\u958b\u59cb \u2192 \u751f\u6210\u969c\u7919\u7269 \u2192 \u96a8\u6a5f\u5316\u4f4d\u7f6e \u2192 \u5b8c\u6210\u95dc\u5361\u3002"}, {"question": "\u5f9e Run 2 \u7684\u684c\u9762\u7248\u8f49\u63db\u5230\u884c\u52d5\u7248\uff0c\u6700\u4f73\u505a\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5f9e Run 2 \u7684\u684c\u9762\u7248\u8f49\u63db\u5230\u884c\u52d5\u7248\u9700\u8981\u9069\u61c9\u89f8\u63a7\u63a7\u5236\u548c\u66f4\u5c0f\u7684\u87a2\u5e55\u5927\u5c0f\u3002\u6b65\u9a5f 1 - \u5728\u65e9\u671f\u95dc\u5361\u7df4\u7fd2\u4f7f\u7528\u89f8\u63a7\u63a7\u5236\u4ee5\u5efa\u7acb\u808c\u8089\u8a18\u61b6\u3002\u6b65\u9a5f 2 - \u8abf\u6574\u60a8\u7684\u904a\u6232\u98a8\u683c\uff0c\u4ee5\u8003\u616e\u7cbe\u78ba\u6027\u7565\u5fae\u964d\u4f4e\u3002\u6b65\u9a5f 3 - \u4f7f\u7528\u884c\u52d5\u7248\u7684\u624b\u52e2\u6ed1\u52d5\u4f86\u5be6\u73fe\u66f4\u6d41\u66a2\u7684\u79fb\u52d5\u3002\u4f8b\u5982\uff0c\u5728 1 \u7d1a\uff0c\u60a8\u9700\u8981\u8f15\u89f8\u4e26\u6ed1\u52d5\u4ee5\u99d5\u99ad\u7c21\u55ae\u7684\u969c\u7919\u7269\u3002\u6bd4\u8f03\u8868\u7a81\u51fa\u986f\u793a\u4e86\u5dee\u7570\uff1a\u684c\u9762\u7248\uff08\u9375\u76e4\u7cbe\u78ba\u5ea6\uff09\uff0c\u884c\u52d5\u7248\uff08\u89f8\u63a7\u9748\u6d3b\u5ea6\uff09\u3002"}]
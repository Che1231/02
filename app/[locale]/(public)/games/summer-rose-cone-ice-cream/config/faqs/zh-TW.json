[{"question": "\u5982\u4f55\u958b\u59cb\u73a9\u590f\u65e5\u73ab\u7470\u5713\u7b52\u51b0\u6dc7\u6dcb\u4f5c\u70ba\u65b0\u624b\uff1f", "answer": "\u8981\u958b\u59cb\u73a9\u590f\u65e5\u73ab\u7470\u5713\u7b52\u51b0\u6dc7\u6dcb\uff0c\u8acb\u5148\u5f9e\u60a8\u559c\u611b\u7684\u5e73\u53f0\u4e0b\u8f09\u904a\u6232\u3002\u5b89\u88dd\u5b8c\u6210\u5f8c\uff0c\u555f\u52d5\u904a\u6232\u4e26\u6309\u7167\u87a2\u5e55\u4e0a\u7684\u6559\u5b78\u6b65\u9a5f\u3002\u6559\u5b78\u5c07\u6307\u5c0e\u60a8\u5b8c\u6210\u57fa\u672c\u63a7\u5236\uff0c\u4f8b\u5982\u4f7f\u7528\u64cd\u7e31\u687f\u79fb\u52d5\u89d2\u8272\uff0c\u4e26\u4f7f\u7528\u52d5\u4f5c\u6309\u9215\u8207\u7269\u4ef6\u4e92\u52d5\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u95dc\u4e2d\uff0c\u60a8\u5c07\u5b78\u7fd2\u901a\u904e\u9ede\u64ca\u5b83\u5011\u9644\u8fd1\u7684\u52d5\u4f5c\u6309\u9215\u4f86\u6536\u96c6\u51b0\u6dc7\u6dcb\u5713\u7b52\u3002\u8a18\u4f4f\u6aa2\u67e5\u8a2d\u5b9a\uff0c\u4ee5\u6839\u64da\u60a8\u7684\u559c\u597d\u8abf\u6574\u63a7\u5236\u5668\u7684\u9748\u654f\u5ea6\u3002"}, {"question": "\u5728\u590f\u65e5\u73ab\u7470\u5713\u7b52\u51b0\u6dc7\u6dcb\u4e2d\u7372\u5f97\u9ad8\u5206\u7684\u95dc\u9375\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u590f\u65e5\u73ab\u7470\u5713\u7b52\u51b0\u6dc7\u6dcb\u4e2d\u7372\u5f97\u9ad8\u5206\u9700\u8981\u901f\u5ea6\u548c\u7cbe\u78ba\u5ea6\u7684\u7d50\u5408\u3002\u6b65\u9a5f\u4e00\uff1a\u59cb\u7d42\u8ffd\u6c42\u6536\u96c6\u51b0\u6dc7\u6dcb\u5713\u7b52\u6642\u7684\u300c\u5b8c\u7f8e\u300d\u6642\u9593\uff0c\u56e0\u70ba\u9019\u6703\u8b93\u60a8\u7372\u5f97\u984d\u5916\u7a4d\u5206\u3002\u6b65\u9a5f\u4e8c\uff1a\u5229\u7528\u4f8b\u5982\u300c\u96d9\u4efd\u7403\u300d\u7b49\u9053\u5177\uff0c\u5728\u4e00\u6bb5\u6642\u9593\u5167\u4f7f\u60a8\u7684\u7a4d\u5206\u7ffb\u500d\u3002\u6b65\u9a5f\u4e09\uff1a\u898f\u5283\u8def\u7dda\u4ee5\u907f\u514d\u969c\u7919\u7269\u4e26\u6700\u5927\u5316\u5713\u7b52\u6536\u96c6\u91cf\u3002\u4f8b\u5982\uff0c\u5728\u300c\u65e5\u843d\u5927\u9053\u300d\u95dc\u5361\u4e2d\uff0c\u8d70\u4e0a\u65b9\u7684\u9053\u8def\u53ef\u4ee5\u6536\u96c6\u66f4\u591a\u5713\u7b52\uff0c\u800c\u7121\u9700\u5192\u8207\u884c\u99db\u4e2d\u7684\u6c7d\u8eca\u767c\u751f\u78b0\u649e\u7684\u98a8\u96aa\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u590f\u65e5\u73ab\u7470\u5713\u7b52\u51b0\u6dc7\u6dcb\u6703\u5728\u5404\u95dc\u5361\u4f7f\u7528\u5b63\u7bc0\u6027\u4e3b\u984c\uff1f", "answer": "\u590f\u65e5\u73ab\u7470\u5713\u7b52\u51b0\u6dc7\u6dcb\u63a1\u7528\u5b63\u7bc0\u6027\u4e3b\u984c\u4f86\u589e\u5f37\u6c89\u6d78\u5f0f\u9ad4\u9a57\uff0c\u4e26\u53cd\u6620\u904a\u6232\u4e2d\u590f\u65e5\u5192\u96aa\u7684\u6558\u4e8b\u3002\u6bcf\u500b\u95dc\u5361\u90fd\u8a2d\u8a08\u6709\u7368\u7279\u7684\u5b63\u7bc0\u6027\u5143\u7d20\uff0c\u4f8b\u5982\u590f\u5b63\u7684\u6d77\u7058\u5834\u666f\u6216\u51ac\u5b63\u7684\u96ea\u666f\uff0c\u9019\u4e9b\u5834\u666f\u4e0d\u50c5\u63d0\u4f9b\u4e86\u8996\u89ba\u8b8a\u5316\uff0c\u9084\u5f15\u5165\u4e86\u4e0d\u540c\u7684\u904a\u6232\u6a5f\u5236\u3002\u4f8b\u5982\uff0c\u300c\u51ac\u5b63\u5947\u5883\u300d\u95dc\u5361\u4e2d\u6709\u6613\u6ed1\u7684\u51b0\u9762\uff0c\u9700\u8981\u7cbe\u78ba\u7684\u52d5\u4f5c\u4f86\u99d5\u99ad\u3002"}, {"question": "\u5728\u590f\u65e5\u73ab\u7470\u5713\u7b52\u51b0\u6dc7\u6dcb\u4e2d\uff0c\u6211\u61c9\u8a72\u8abf\u6574\u54ea\u4e9b\u8a2d\u5b9a\u4ee5\u7372\u5f97\u6700\u4f73\u6548\u80fd\uff1f", "answer": "\u8981\u5728\u590f\u65e5\u73ab\u7470\u5713\u7b52\u51b0\u6dc7\u6dcb\u4e2d\u7372\u5f97\u6700\u4f73\u6548\u80fd\uff0c\u8acb\u6839\u64da\u88dd\u7f6e\u80fd\u529b\u8abf\u6574\u5716\u5f62\u8a2d\u5b9a\u3002\u5982\u679c\u60a8\u9047\u5230\u5ef6\u9072\uff0c\u8acb\u964d\u4f4e\u89e3\u6790\u5ea6\u4e26\u95dc\u9589\u9ad8\u54c1\u8cea\u6548\u679c\u3002\u6b64\u5916\uff0c\u8acb\u6821\u6e96\u63a7\u5236\u9748\u654f\u5ea6\u4ee5\u78ba\u4fdd\u89d2\u8272\u79fb\u52d5\u9806\u66a2\u3002\u826f\u597d\u7684\u505a\u6cd5\u662f\u5728\u300e\u7df4\u7fd2\u6a21\u5f0f\u300f\u4e2d\u6e2c\u8a66\u9019\u4e9b\u8a2d\u5b9a\uff0c\u60a8\u53ef\u4ee5\u5728\u4e0d\u5f71\u97ff\u904a\u6232\u9032\u5ea6\u7684\u60c5\u6cc1\u4e0b\u8abf\u6574\u5b83\u5011\u3002"}, {"question": "\u5982\u4f55\u5c07\u6211\u7684\u590f\u65e5\u73ab\u7470\u5713\u7b52\u51b0\u6dc7\u6dcb\u9032\u5ea6\u8f49\u79fb\u5230\u65b0\u88dd\u7f6e\uff1f", "answer": "\u8981\u5c07\u60a8\u7684\u590f\u65e5\u73ab\u7470\u5713\u7b52\u51b0\u6dc7\u6dcb\u9032\u5ea6\u8f49\u79fb\u5230\u65b0\u88dd\u7f6e\uff0c\u8acb\u78ba\u4fdd\u60a8\u7684\u904a\u6232\u8cc7\u6599\u5df2\u5099\u4efd\u5230\u96f2\u7aef\u3002\u9019\u901a\u5e38\u53ef\u4ee5\u5728\u904a\u6232\u8a2d\u5b9a\u9078\u55ae\u4e2d\u7684\u300e\u5e33\u6236\u300f\u6216\u300e\u96f2\u7aef\u5132\u5b58\u300f\u4e2d\u5b8c\u6210\u3002\u5099\u4efd\u5f8c\uff0c\u8acb\u5728\u65b0\u88dd\u7f6e\u4e0a\u5b89\u88dd\u904a\u6232\u4e26\u4f7f\u7528\u76f8\u540c\u7684\u5e33\u6236\u767b\u5165\u4ee5\u6062\u5fa9\u9032\u5ea6\u3002\u8acb\u52d9\u5fc5\u5728\u5f9e\u820a\u88dd\u7f6e\u522a\u9664\u904a\u6232\u524d\u78ba\u8a8d\u8cc7\u6599\u5df2\u6210\u529f\u8f49\u79fb\u3002"}, {"question": "\u590f\u65e5\u73ab\u7470\u5713\u7b52\u51b0\u6dc7\u6dcb\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u95dc\u5361\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9396\u5b83\u5011\uff1f", "answer": "\u590f\u65e5\u73ab\u7470\u5713\u7b52\u51b0\u6dc7\u6dcb\u4e2d\u6709\u96b1\u85cf\u95dc\u5361\uff0c\u900f\u904e\u9054\u6210\u7279\u5b9a\u91cc\u7a0b\u7891\u5373\u53ef\u89e3\u9396\u3002\u4f8b\u5982\uff0c\u5728\u6240\u6709\u95dc\u5361\u4e2d\u6536\u96c6 500 \u500b\u51b0\u6dc7\u6dcb\u5713\u7b52\u5f8c\uff0c\u5373\u53ef\u89e3\u9396\u300e\u79d8\u5bc6\u82b1\u5712\u300f\u95dc\u5361\u3002\u9019\u4e9b\u96b1\u85cf\u95dc\u5361\u901a\u5e38\u5305\u542b\u7368\u7279\u7684\u6311\u6230\u548c\u734e\u52f5\uff0c\u4f8b\u5982\u7279\u6b8a\u9053\u5177\u6216\u7a00\u6709\u6536\u85cf\u54c1\u3002\u8acb\u5bc6\u5207\u6ce8\u610f\u904a\u6232\u6210\u5c31\u90e8\u5206\u7684\u9032\u5ea6\uff0c\u4ee5\u77e5\u9053\u4f55\u6642\u63a5\u8fd1\u89e3\u9396\u9019\u4e9b\u95dc\u5361\u3002"}, {"question": "\u590f\u65e5\u73ab\u7470\u5713\u7b52\u51b0\u6dc7\u6dcb\u4e2d\u7684\u7a4d\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u590f\u65e5\u73ab\u7470\u5713\u7b52\u51b0\u6dc7\u6dcb\u4e2d\u7684\u7a4d\u5206\u7cfb\u7d71\u57fa\u65bc\u5e7e\u500b\u56e0\u7d20\uff1a\u6536\u96c6\u7684\u51b0\u6dc7\u6dcb\u5713\u7b52\u6578\u91cf\u3001\u6536\u96c6\u6642\u9593\uff08\u300c\u5b8c\u7f8e\u300d\u6642\u9593\u6703\u7372\u5f97\u66f4\u591a\u7a4d\u5206\uff09\u4ee5\u53ca\u9053\u5177\u7684\u4f7f\u7528\u3002\u6b64\u5916\uff0c\u5b8c\u6210\u95dc\u5361\u4e14\u7121\u4efb\u4f55\u932f\u8aa4\u6216\u4f7f\u7528\u7e7c\u7e8c\u6a5f\u6703\u4e5f\u53ef\u4ee5\u7372\u5f97\u984d\u5916\u7a4d\u5206\u3002\u904a\u6232\u4e5f\u5177\u6709\u9023\u64ca\u7cfb\u7d71\uff0c\u9023\u7e8c\u5b8c\u7f8e\u6536\u96c6\u53ef\u4ee5\u63d0\u9ad8\u60a8\u7684\u7a4d\u5206\u500d\u6578\uff0c\u986f\u8457\u63d0\u5347\u60a8\u7684\u7e3d\u7a4d\u5206\u3002"}, {"question": "\u590f\u65e5\u73ab\u7470\u5713\u7b52\u51b0\u6dc7\u6dcb\u4e2d\u6700\u597d\u7684\u9053\u5177\u662f\u4ec0\u9ebc\uff0c\u5b83\u5011\u5982\u4f55\u63d0\u5347\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u590f\u65e5\u73ab\u7470\u5713\u7b52\u51b0\u6dc7\u6dcb\u4e2d\u6700\u597d\u7684\u9053\u5177\u5305\u62ec\u300c\u96d9\u4efd\u7403\u300d\uff0c\u53ef\u4ee5\u8b93\u60a8\u7684\u7a4d\u5206\u5728\u4e00\u6bb5\u6642\u9593\u5167\u7ffb\u500d\uff0c\u4ee5\u53ca\u300c\u76fe\u724c\u300d\uff0c\u53ef\u4ee5\u4fdd\u8b77\u60a8\u514d\u53d7\u969c\u7919\u7269\u50b7\u5bb3\u3002\u9019\u4e9b\u9053\u5177\u53ef\u4ee5\u5728\u5404\u95dc\u5361\u4e2d\u7684\u7279\u6b8a\u7bb1\u5b50\u4e2d\u627e\u5230\uff0c\u6216\u5728\u904a\u6232\u5167\u5546\u5e97\u8cfc\u8cb7\u3002\u7b56\u7565\u6027\u5730\u4f7f\u7528\u9019\u4e9b\u9053\u5177\u53ef\u4ee5\u986f\u8457\u589e\u5f37\u60a8\u7684\u904a\u6232\u9ad4\u9a57\uff0c\u8b93\u60a8\u5728\u5177\u6709\u6311\u6230\u6027\u7684\u95dc\u5361\u4e2d\u7372\u5f97\u66f4\u9ad8\u5206\u6578\u4e26\u53d6\u5f97\u9032\u5c55\u3002"}, {"question": "\u5982\u4f55\u5728\u590f\u65e5\u73ab\u7470\u5713\u7b52\u51b0\u6dc7\u6dcb\u4e2d\u63d0\u9ad8\u53cd\u61c9\u6642\u9593\uff1f", "answer": "\u5728\u590f\u65e5\u73ab\u7470\u5713\u7b52\u51b0\u6dc7\u6dcb\u4e2d\u63d0\u9ad8\u53cd\u61c9\u6642\u9593\uff0c\u53ef\u4ee5\u900f\u904e\u7df4\u7fd2\u548c\u719f\u6089\u904a\u6232\u6a5f\u5236\u4f86\u5be6\u73fe\u3002\u82b1\u6642\u9593\u5728\u300e\u7df4\u7fd2\u6a21\u5f0f\u300f\u4e2d\uff0c\u7fd2\u6163\u5713\u7b52\u6536\u96c6\u548c\u969c\u7919\u7269\u8ff4\u907f\u7684\u6642\u9593\u3002\u6b64\u5916\uff0c\u8abf\u6574\u63a7\u5236\u5668\u7684\u9748\u654f\u5ea6\u81f3\u97ff\u61c9\u6027\u8a2d\u5b9a\uff0c\u4e5f\u53ef\u4ee5\u6709\u6240\u5e6b\u52a9\u3002\u5b9a\u671f\u904a\u6232\u6703\u81ea\u7136\u5730\u589e\u5f37\u60a8\u7684\u53cd\u61c9\u80fd\u529b\uff0c\u8b93\u60a8\u66f4\u64c5\u9577\u99d5\u99ad\u904a\u6232\u4e2d\u7bc0\u594f\u66f4\u5feb\u7684\u95dc\u5361\u3002"}, {"question": "\u793e\u7fa4\u5c0d\u65bc\u7cbe\u901a\u590f\u65e5\u73ab\u7470\u5713\u7b52\u51b0\u6dc7\u6dcb\u6709\u54ea\u4e9b\u6700\u4f73\u5efa\u8b70\uff1f", "answer": "\u793e\u7fa4\u5c0d\u65bc\u7cbe\u901a\u590f\u65e5\u73ab\u7470\u5713\u7b52\u51b0\u6dc7\u6dcb\u7684\u6700\u4f73\u5efa\u8b70\u5305\u62ec\u5b9a\u671f\u7df4\u7fd2\u4ee5\u63d0\u9ad8\u6280\u80fd\uff0c\u7814\u7a76\u6bcf\u500b\u95dc\u5361\u7684\u4f48\u5c40\u4ee5\u898f\u5283\u6709\u6548\u8def\u7dda\uff0c\u4e26\u660e\u667a\u5730\u4f7f\u7528\u9053\u5177\u3002\u8a31\u591a\u73a9\u5bb6\u9084\u5efa\u8b70\u89c0\u770b\u7d93\u9a57\u8c50\u5bcc\u73a9\u5bb6\u7684\u6559\u5b78\u5f71\u7247\u6216\u4e32\u6d41\uff0c\u4ee5\u5b78\u7fd2\u5148\u9032\u6280\u5de7\u3002\u900f\u904e\u8ad6\u58c7\u6216\u793e\u7fa4\u5a92\u9ad4\u8207\u793e\u7fa4\u4e92\u52d5\uff0c\u4e5f\u80fd\u7372\u53d6\u5bf6\u8cb4\u7684\u898b\u89e3\u548c\u7b56\u7565\uff0c\u4ee5\u63d0\u5347\u60a8\u7684\u904a\u6232\u9ad4\u9a57\u3002"}]
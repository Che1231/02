[{"question": "\ucd08\ubcf4\uc790\uac00 \uc378\uba38 \ub85c\uc988 \ucf58 \uc544\uc774\uc2a4\ud06c\ub9bc\uc744 \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc378\uba38 \ub85c\uc988 \ucf58 \uc544\uc774\uc2a4\ud06c\ub9bc\uc744 \uc2dc\uc791\ud558\ub824\uba74 \uc6b0\uc120 \uc6d0\ud558\ub294 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uac8c\uc784\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc138\uc694. \uc124\uce58 \ud6c4 \uac8c\uc784\uc744 \uc2e4\ud589\ud558\uace0 \ud654\uba74\uc758 \ud29c\ud1a0\ub9ac\uc5bc\uc744 \ub530\ub77c\uc8fc\uc138\uc694. \ud29c\ud1a0\ub9ac\uc5bc\uc740 \uc870\uc774\uc2a4\ud2f1\uc73c\ub85c \uce90\ub9ad\ud130\ub97c \uc6c0\uc9c1\uc774\ub294 \ub4f1 \uae30\ubcf8 \uc870\uc791\ubc95\uacfc \uc561\uc158 \ubc84\ud2bc\uc73c\ub85c \ubb3c\uccb4\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\ub294 \ubc29\ubc95\uc744 \uc548\ub0b4\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c\ub294 \uac00\uae4c\uc774 \uc788\ub294 \uc544\uc774\uc2a4\ud06c\ub9bc \ucf58\uc744 \uc561\uc158 \ubc84\ud2bc\uc744 \ud0ed\ud558\uc5ec \uc218\uc9d1\ud558\ub294 \ubc95\uc744 \ubc30\uc6b0\uac8c \ub429\ub2c8\ub2e4. \uc81c\uc5b4 \uac10\ub3c4\ub97c \uc6d0\ud558\ub294\ub300\ub85c \uc870\uc815\ud558\ub824\uba74 \uc124\uc815\uc744 \ud655\uc778\ud558\uc138\uc694."}, {"question": "\uc378\uba38 \ub85c\uc988 \ucf58 \uc544\uc774\uc2a4\ud06c\ub9bc\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uae30 \uc704\ud55c \uc8fc\uc694 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc378\uba38 \ub85c\uc988 \ucf58 \uc544\uc774\uc2a4\ud06c\ub9bc\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc73c\ub824\uba74 \uc18d\ub3c4\uc640 \uc815\ud655\uc131\uc758 \uc870\ud569\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. STEP1: \uc544\uc774\uc2a4\ud06c\ub9bc \ucf58\uc744 \uc218\uc9d1\ud560 \ub54c \ud56d\uc0c1 '\uc644\ubcbd'\ud55c \ud0c0\uc774\ubc0d\uc744 \ub9de\ucd94\ub294 \uac83\uc774 \uc911\uc694\ud558\uba70, \uc774\ub807\uac8c \ud558\uba74 \ubcf4\ub108\uc2a4 \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP2: '\ub354\ube14 \uc2a4\ucff1'\uacfc \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \ud65c\uc6a9\ud558\uba74 \uc81c\ud55c\ub41c \uc2dc\uac04 \ub3d9\uc548 \uc810\uc218\uac00 \ub450 \ubc30\uac00 \ub429\ub2c8\ub2e4. STEP3: \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\uace0 \ucf58 \uc218\uc9d1\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \uacbd\ub85c\ub97c \uacc4\ud68d\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uc120\uc14b \ubd88\ubc14\ub4dc' \ub808\ubca8\uc5d0\uc11c \uc0c1\ub2e8 \uacbd\ub85c\ub97c \ub530\ub77c\uac00\uba74 \uc774\ub3d9\ud558\ub294 \uc790\ub3d9\ucc28\uc640\uc758 \ucda9\ub3cc \uc704\ud5d8 \uc5c6\uc774 \ub354 \ub9ce\uc740 \ucf58\uc744 \uc218\uc9d1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc378\uba38 \ub85c\uc988 \ucf58 \uc544\uc774\uc2a4\ud06c\ub9bc\uc774 \ub808\ubca8\uc5d0\uc11c \uacc4\uc808 \ud14c\ub9c8\ub97c \uc0ac\uc6a9\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc378\uba38 \ub85c\uc988 \ucf58 \uc544\uc774\uc2a4\ud06c\ub9bc\uc740 \uc5ec\ub984 \ubaa8\ud5d8\uc774\ub77c\ub294 \uac8c\uc784\uc758 \uc774\uc57c\uae30\ub97c \ubc18\uc601\ud558\uace0 \ubab0\uc785\uac10\uc744 \ub192\uc774\uae30 \uc704\ud574 \uacc4\uc808 \ud14c\ub9c8\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uac01 \ub808\ubca8\uc740 \uc5ec\ub984\uc758 \ud574\ubcc0 \ud48d\uacbd\uc774\ub098 \uaca8\uc6b8\uc758 \ub208\uae38 \uac19\uc740 \ub3c5\ud2b9\ud55c \uacc4\uc808 \uc694\uc18c\ub85c \ub514\uc790\uc778\ub418\uc5b4 \uc788\uc73c\uba70, \uc774\ub294 \uc2dc\uac01\uc801\uc778 \ub2e4\uc591\uc131\uc744 \uc81c\uacf5\ud560 \ubfd0\ub9cc \uc544\ub2c8\ub77c \uc11c\ub85c \ub2e4\ub978 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc744 \uc18c\uac1c\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uaca8\uc6b8 \ub3d9\ud654' \ub808\ubca8\uc740 \uc6c0\uc9c1\uc784\uc744 \uc815\ud655\ud558\uac8c \uc870\uc791\ud574\uc57c \ud558\ub294 \ubbf8\ub044\ub7ec\uc6b4 \uc5bc\uc74c \ud328\uce58\uac00 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc378\uba38 \ub85c\uc988 \ucf58 \uc544\uc774\uc2a4\ud06c\ub9bc\uc5d0\uc11c \ucd5c\uc801\uc758 \uc131\ub2a5\uc744 \uc704\ud574 \uc5b4\ub5a4 \uc124\uc815\uc744 \uc870\uc815\ud574\uc57c \ud558\ub098\uc694?", "answer": "\uc378\uba38 \ub85c\uc988 \ucf58 \uc544\uc774\uc2a4\ud06c\ub9bc\uc5d0\uc11c \ucd5c\uc801\uc758 \uc131\ub2a5\uc744 \uc704\ud574 \uae30\uae30 \uc131\ub2a5\uc5d0 \ub530\ub77c \uadf8\ub798\ud53d \uc124\uc815\uc744 \uc870\uc815\ud558\uc2ed\uc2dc\uc624. \ub799\uc774 \ubc1c\uc0dd\ud558\uba74 \ud574\uc0c1\ub3c4\ub97c \ub0ae\ucd94\uace0 \uace0\ud488\uc9c8 \ud6a8\uacfc\ub97c \ud574\uc81c\ud558\uc138\uc694. \ub610\ud55c, \ubd80\ub4dc\ub7ec\uc6b4 \uce90\ub9ad\ud130 \uc6c0\uc9c1\uc784\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 \uc870\uc791 \uac10\ub3c4\ub97c \ubcf4\uc815\ud558\uc138\uc694. \uac8c\uc784 \uc9c4\ud589\uc5d0 \uc601\ud5a5\uc744 \uc8fc\uc9c0 \uc54a\uace0 \uc124\uc815\uc744 \uc870\uc815\ud560 \uc218 \uc788\ub294 '\uc5f0\uc2b5 \ubaa8\ub4dc'\uc5d0\uc11c \uc774\ub7ec\ud55c \uc124\uc815\uc744 \ud14c\uc2a4\ud2b8\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4."}, {"question": "\uc0c8\ub85c\uc6b4 \uae30\uae30\ub85c \uc378\uba38 \ub85c\uc988 \ucf58 \uc544\uc774\uc2a4\ud06c\ub9bc\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc0c8\ub85c\uc6b4 \uae30\uae30\ub85c \uc378\uba38 \ub85c\uc988 \ucf58 \uc544\uc774\uc2a4\ud06c\ub9bc\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub824\uba74 \uac8c\uc784 \ub370\uc774\ud130\ub97c \ud074\ub77c\uc6b0\ub4dc\uc5d0 \ubc31\uc5c5\ud558\uc138\uc694. \uc77c\ubc18\uc801\uc73c\ub85c \uac8c\uc784 \uc124\uc815 \uba54\ub274\uc758 '\uacc4\uc815' \ub610\ub294 '\ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5'\uc744 \ud1b5\ud574 \uc774\ub8e8\uc5b4\uc9d1\ub2c8\ub2e4. \ubc31\uc5c5 \ud6c4 \uc0c8\ub85c\uc6b4 \uae30\uae30\uc5d0\uc11c \uac8c\uc784\uc744 \uc124\uce58\ud558\uace0 \uac19\uc740 \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \ubcf5\uad6c\ud558\uc138\uc694. \uc624\ub798\ub41c \uae30\uae30\uc5d0\uc11c \uac8c\uc784\uc744 \uc0ad\uc81c\ud558\uae30 \uc804\uc5d0 \ub370\uc774\ud130\uac00 \uc131\uacf5\uc801\uc73c\ub85c \uc804\uc1a1\ub418\uc5c8\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624."}, {"question": "\uc378\uba38 \ub85c\uc988 \ucf58 \uc544\uc774\uc2a4\ud06c\ub9bc\uc5d0 \uc5b4\ub5a4 \uc228\uaca8\uc9c4 \ub808\ubca8\uc774 \uc788\uace0 \uc5b4\ub5bb\uac8c \ud574\uc81c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc378\uba38 \ub85c\uc988 \ucf58 \uc544\uc774\uc2a4\ud06c\ub9bc\uc5d0\ub294 \ud2b9\uc815 \uc774\uc815\ud45c\ub97c \ub2ec\uc131\ud558\uc5ec \ud574\uc81c\ub418\ub294 \uc228\uaca8\uc9c4 \ub808\ubca8\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubaa8\ub4e0 \ub808\ubca8\uc5d0\uc11c 500\uac1c\uc758 \uc544\uc774\uc2a4\ud06c\ub9bc \ucf58\uc744 \ubaa8\uc740 \ud6c4 '\ube44\ubc00 \uc815\uc6d0' \ub808\ubca8\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ub808\ubca8\uc5d0\ub294 \uc885\uc885 \ud2b9\ubcc4\ud55c \ud30c\uc6cc\uc5c5\uc774\ub098 \ud76c\uadc0\ud55c \uc544\uc774\ud15c\uacfc \uac19\uc740 \ub3c5\ud2b9\ud55c \ub3c4\uc804\uacfc \ubcf4\uc0c1\uc774 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784\uc758 \uc5c5\uc801 \uc139\uc158\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc8fc\uc2dc\ud558\uc5ec \ub808\ubca8\uc744 \ud574\uc81c\ud560 \uc900\ube44\uac00 \ub418\uc5c8\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694."}, {"question": "\uc378\uba38 \ub85c\uc988 \ucf58 \uc544\uc774\uc2a4\ud06c\ub9bc\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "\uc378\uba38 \ub85c\uc988 \ucf58 \uc544\uc774\uc2a4\ud06c\ub9bc\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5ec\ub7ec \uc694\uc778\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uc218\uc9d1\ud55c \uc544\uc774\uc2a4\ud06c\ub9bc \ucf58\uc758 \uac1c\uc218, \uc218\uc9d1 \ud0c0\uc774\ubc0d ('\uc644\ubcbd'\ud55c \ud0c0\uc774\ubc0d\uc740 \ub354 \ub9ce\uc740 \uc810\uc218\ub97c \uc81c\uacf5\ud568), \ud30c\uc6cc\uc5c5 \uc0ac\uc6a9\uc785\ub2c8\ub2e4. \ub610\ud55c, \ub808\ubca8\uc744 \uc2e4\uc218 \uc5c6\uc774 \ub610\ub294 \uc5f0\uc18d\uc73c\ub85c \ud074\ub9ac\uc5b4\ud558\uba74 \ubcf4\ub108\uc2a4 \uc810\uc218\ub97c \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784\uc5d0\ub294 \uc5f0\uc18d\uc801\uc778 \uc644\ubcbd\ud55c \uc218\uc9d1\uc73c\ub85c \uc810\uc218 \ubc30\uc218\uac00 \uc99d\uac00\ud558\ub294 \ucf64\ubcf4 \uc2dc\uc2a4\ud15c\uc774 \uc788\uc5b4 \ucd1d \uc810\uc218\ub97c \ud06c\uac8c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc378\uba38 \ub85c\uc988 \ucf58 \uc544\uc774\uc2a4\ud06c\ub9bc\uc5d0\uc11c \uac00\uc7a5 \uc88b\uc740 \ud30c\uc6cc\uc5c5\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \uac8c\uc784\ud50c\ub808\uc774\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\ub098\uc694?", "answer": "\uc378\uba38 \ub85c\uc988 \ucf58 \uc544\uc774\uc2a4\ud06c\ub9bc\uc5d0\uc11c \uac00\uc7a5 \uc88b\uc740 \ud30c\uc6cc\uc5c5\uc5d0\ub294 \uc81c\ud55c\ub41c \uc2dc\uac04 \ub3d9\uc548 \uc810\uc218\ub97c \ub450 \ubc30\ub85c \ub9cc\ub4dc\ub294 '\ub354\ube14 \uc2a4\ucff1'\uacfc \uc7a5\uc560\ubb3c\ub85c\ubd80\ud130 \ubcf4\ud638\ud558\ub294 '\uc2e4\ub4dc'\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud30c\uc6cc\uc5c5\uc740 \ub808\ubca8 \uacf3\uacf3\uc5d0 \ud769\uc5b4\uc838 \uc788\ub294 \ud2b9\ubcc4\ud55c \uc0c1\uc790\ub098 \uac8c\uc784 \ub0b4 \uc0c1\uc810\uc5d0\uc11c \uad6c\ub9e4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc804\ub7b5\uc801\uc73c\ub85c \uc774\ub7ec\ud55c \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud558\uba74 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc5d0\uc11c \ub354 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uace0 \ub354\uc6b1 \ub098\uc544\uac08 \uc218 \uc788\ub3c4\ub85d \uac8c\uc784\ud50c\ub808\uc774\ub97c \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc378\uba38 \ub85c\uc988 \ucf58 \uc544\uc774\uc2a4\ud06c\ub9bc\uc5d0\uc11c \ubc18\uc751 \uc2dc\uac04\uc744 \uc5b4\ub5bb\uac8c \uac1c\uc120\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc378\uba38 \ub85c\uc988 \ucf58 \uc544\uc774\uc2a4\ud06c\ub9bc\uc5d0\uc11c \ubc18\uc751 \uc2dc\uac04\uc744 \uac1c\uc120\ud558\ub824\uba74 \uc5f0\uc2b5\uacfc \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc5d0 \ub300\ud55c \uc219\ub2ec\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \ucf58 \uc218\uc9d1\uacfc \uc7a5\uc560\ubb3c \ud68c\ud53c \ud0c0\uc774\ubc0d\uc5d0 \uc775\uc219\ud574\uc9c8 \uc218 \uc788\ub3c4\ub85d '\uc5f0\uc2b5 \ubaa8\ub4dc'\uc5d0\uc11c \uc2dc\uac04\uc744 \ubcf4\ub0b4\uc138\uc694. \ub610\ud55c, \uc870\uc791 \uac10\ub3c4\ub97c \ubc18\uc751\uc131\uc774 \ub290\uaef4\uc9c0\ub294 \uc124\uc815\uc73c\ub85c \uc870\uc815\ud558\uba74 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc815\uae30\uc801\uc73c\ub85c \ud50c\ub808\uc774\ud558\uba74 \uc790\uc5f0\uc2a4\ub7fd\uac8c \ubc18\uc0ac \uc2e0\uacbd\uc774 \ud5a5\uc0c1\ub418\uc5b4 \uac8c\uc784\uc758 \ube60\ub978 \uc18d\ub3c4 \ub808\ubca8\uc744 \ub354\uc6b1 \ub2a5\uc219\ud558\uac8c \ud0d0\uc0c9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc378\uba38 \ub85c\uc988 \ucf58 \uc544\uc774\uc2a4\ud06c\ub9bc\uc744 \ub9c8\uc2a4\ud130\ud558\uae30 \uc704\ud55c \ucee4\ubba4\ub2c8\ud2f0\uc758 \ucd5c\uace0 \ud301\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc378\uba38 \ub85c\uc988 \ucf58 \uc544\uc774\uc2a4\ud06c\ub9bc\uc744 \ub9c8\uc2a4\ud130\ud558\uae30 \uc704\ud55c \ucee4\ubba4\ub2c8\ud2f0\uc758 \ucd5c\uace0 \ud301\uc740 \uae30\uc220 \ud5a5\uc0c1\uc744 \uc704\ud574 \uafb8\uc900\ud788 \uc5f0\uc2b5\ud558\uace0, \uac01 \ub808\ubca8\uc758 \ub808\uc774\uc544\uc6c3\uc744 \uc5f0\uad6c\ud558\uc5ec \ud6a8\uc728\uc801\uc778 \uacbd\ub85c\ub97c \uacc4\ud68d\ud558\uace0, \ud30c\uc6cc\uc5c5\uc744 \ud604\uba85\ud558\uac8c \ud65c\uc6a9\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \ub9ce\uc740 \ud50c\ub808\uc774\uc5b4\ub294 \uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\uc758 \ud29c\ud1a0\ub9ac\uc5bc \ube44\ub514\uc624\ub098 \uc2a4\ud2b8\ub9bc\uc744 \uc2dc\uccad\ud558\uc5ec \uace0\uae09 \uae30\uc220\uc744 \ubc30\uc6b0\ub294 \uac83\uc744 \uad8c\uc7a5\ud569\ub2c8\ub2e4. \ud3ec\ub7fc\uc774\ub098 \uc18c\uc15c \ubbf8\ub514\uc5b4\ub97c \ud1b5\ud574 \ucee4\ubba4\ub2c8\ud2f0\uc640 \uc18c\ud1b5\ud558\uba74 \uac8c\uc784\ud50c\ub808\uc774\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ub370 \uc720\uc6a9\ud55c \ud1b5\ucc30\ub825\uacfc \uc804\ub7b5\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
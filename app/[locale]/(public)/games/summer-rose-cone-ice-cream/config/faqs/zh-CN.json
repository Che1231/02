[{"question": "\u65b0\u624b\u5982\u4f55\u5f00\u59cb\u73a9\u590f\u65e5\u73ab\u7470\u51b0\u6dc7\u6dcb\u6e38\u620f\uff1f", "answer": "\u8981\u5f00\u59cb\u73a9\u590f\u65e5\u73ab\u7470\u51b0\u6dc7\u6dcb\u6e38\u620f\uff0c\u9996\u5148\u9700\u8981\u4ece\u60a8\u559c\u6b22\u7684\u5e73\u53f0\u4e0b\u8f7d\u6e38\u620f\u3002\u5b89\u88c5\u5b8c\u6210\u540e\uff0c\u542f\u52a8\u6e38\u620f\u5e76\u6309\u7167\u5c4f\u5e55\u4e0a\u7684\u6559\u7a0b\u64cd\u4f5c\u3002\u6559\u7a0b\u5c06\u6307\u5bfc\u60a8\u5b8c\u6210\u57fa\u672c\u64cd\u4f5c\uff0c\u4f8b\u5982\u4f7f\u7528\u64cd\u7eb5\u6746\u79fb\u52a8\u89d2\u8272\u4ee5\u53ca\u4f7f\u7528\u64cd\u4f5c\u6309\u94ae\u4e0e\u7269\u4f53\u4e92\u52a8\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u5173\u4e2d\uff0c\u60a8\u5c06\u5b66\u4e60\u901a\u8fc7\u70b9\u51fb\u9760\u8fd1\u51b0\u6dc7\u6dcb\u5706\u9525\u7684\u6309\u952e\u6765\u6536\u96c6\u51b0\u6dc7\u6dcb\u5706\u9525\u3002\u8bf7\u8bb0\u4f4f\u68c0\u67e5\u8bbe\u7f6e\uff0c\u4ee5\u8c03\u6574\u63a7\u4ef6\u7684\u7075\u654f\u5ea6\u4ee5\u6ee1\u8db3\u60a8\u7684\u559c\u597d\u3002"}, {"question": "\u5728\u590f\u65e5\u73ab\u7470\u51b0\u6dc7\u6dcb\u6e38\u620f\u4e2d\u83b7\u5f97\u9ad8\u5206\u7684\u5173\u952e\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u590f\u65e5\u73ab\u7470\u51b0\u6dc7\u6dcb\u6e38\u620f\u4e2d\u83b7\u5f97\u9ad8\u5206\u9700\u8981\u7ed3\u5408\u901f\u5ea6\u548c\u7cbe\u5ea6\u3002\u6b65\u9aa4\u4e00\uff1a\u59cb\u7ec8\u7784\u51c6\u6536\u96c6\u51b0\u6dc7\u6dcb\u5706\u9525\u7684\u201c\u5b8c\u7f8e\u201d\u65f6\u673a\uff0c\u56e0\u4e3a\u8fd9\u4f1a\u4e3a\u60a8\u5e26\u6765\u5956\u52b1\u79ef\u5206\u3002\u6b65\u9aa4\u4e8c\uff1a\u5229\u7528\u201c\u53cc\u4efd\u52fa\u201d\u7b49\u9053\u5177\uff0c\u5728\u4e00\u5b9a\u65f6\u95f4\u5185\u5c06\u60a8\u7684\u5f97\u5206\u7ffb\u500d\u3002\u6b65\u9aa4\u4e09\uff1a\u89c4\u5212\u60a8\u7684\u8def\u7ebf\uff0c\u907f\u5f00\u969c\u788d\u5e76\u6700\u5927\u9650\u5ea6\u5730\u6536\u96c6\u5706\u9525\u3002\u4f8b\u5982\uff0c\u5728\u201c\u65e5\u843d\u5927\u9053\u201d\u5173\u5361\u4e2d\uff0c\u8d70\u4e0a\u5761\u8def\u53ef\u4ee5\u6536\u96c6\u66f4\u591a\u5706\u9525\uff0c\u800c\u65e0\u9700\u5192\u649e\u5230\u79fb\u52a8\u8f66\u8f86\u7684\u98ce\u9669\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u590f\u65e5\u73ab\u7470\u51b0\u6dc7\u6dcb\u6e38\u620f\u4f1a\u5728\u5176\u5173\u5361\u4e2d\u4f7f\u7528\u5b63\u8282\u6027\u4e3b\u9898\uff1f", "answer": "\u590f\u65e5\u73ab\u7470\u51b0\u6dc7\u6dcb\u6e38\u620f\u91c7\u7528\u5b63\u8282\u6027\u4e3b\u9898\u6765\u589e\u5f3a\u6c89\u6d78\u5f0f\u4f53\u9a8c\uff0c\u5e76\u53cd\u6620\u6e38\u620f\u5173\u4e8e\u590f\u65e5\u5192\u9669\u7684\u53d9\u4e8b\u3002\u6bcf\u4e2a\u5173\u5361\u7684\u8bbe\u8ba1\u90fd\u5305\u542b\u72ec\u7279\u7684\u5b63\u8282\u5143\u7d20\uff0c\u4f8b\u5982\u590f\u5b63\u7684\u6d77\u6ee9\u573a\u666f\u6216\u51ac\u5b63\u7684\u96ea\u666f\uff0c\u8fd9\u4e0d\u4ec5\u63d0\u4f9b\u4e86\u89c6\u89c9\u591a\u6837\u6027\uff0c\u8fd8\u5728\u4e0d\u540c\u6e38\u620f\u673a\u5236\u4e2d\u5f15\u5165\u4e86\u4e0d\u540c\u7684\u4f53\u9a8c\u3002\u4f8b\u5982\uff0c\u201c\u51ac\u65e5\u4ed9\u5883\u201d\u5173\u5361\u8bbe\u6709\u6ed1\u6e9c\u7684\u51b0\u9762\uff0c\u9700\u8981\u7cbe\u786e\u7684\u52a8\u4f5c\u6765\u5bfc\u822a\u3002"}, {"question": "\u5728\u590f\u65e5\u73ab\u7470\u51b0\u6dc7\u6dcb\u6e38\u620f\u4e2d\uff0c\u6211\u5e94\u8be5\u8c03\u6574\u54ea\u4e9b\u8bbe\u7f6e\u4ee5\u83b7\u5f97\u6700\u4f73\u6027\u80fd\uff1f", "answer": "\u8981\u5728\u590f\u65e5\u73ab\u7470\u51b0\u6dc7\u6dcb\u6e38\u620f\u4e2d\u83b7\u5f97\u6700\u4f73\u6027\u80fd\uff0c\u8bf7\u6839\u636e\u60a8\u7684\u8bbe\u5907\u80fd\u529b\u8c03\u6574\u56fe\u5f62\u8bbe\u7f6e\u3002\u5982\u679c\u60a8\u9047\u5230\u5ef6\u8fdf\uff0c\u8bf7\u964d\u4f4e\u5206\u8fa8\u7387\u5e76\u7981\u7528\u9ad8\u8d28\u91cf\u6548\u679c\u3002\u6b64\u5916\uff0c\u8bf7\u6821\u51c6\u63a7\u5236\u7075\u654f\u5ea6\u4ee5\u786e\u4fdd\u89d2\u8272\u5e73\u7a33\u79fb\u52a8\u3002\u4e00\u4e2a\u597d\u65b9\u6cd5\u662f\u5728\u201c\u7ec3\u4e60\u6a21\u5f0f\u201d\u4e2d\u6d4b\u8bd5\u8fd9\u4e9b\u8bbe\u7f6e\uff0c\u60a8\u53ef\u4ee5\u5728\u4e0d\u5f71\u54cd\u6e38\u620f\u8fdb\u5ea6\u7684\u60c5\u51b5\u4e0b\u8c03\u6574\u5b83\u4eec\u3002"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684\u590f\u65e5\u73ab\u7470\u51b0\u6dc7\u6dcb\u6e38\u620f\u8fdb\u5ea6\u8f6c\u79fb\u5230\u65b0\u8bbe\u5907\uff1f", "answer": "\u8981\u5c06\u60a8\u7684\u590f\u65e5\u73ab\u7470\u51b0\u6dc7\u6dcb\u6e38\u620f\u8fdb\u5ea6\u8f6c\u79fb\u5230\u65b0\u8bbe\u5907\uff0c\u8bf7\u786e\u4fdd\u60a8\u7684\u6e38\u620f\u6570\u636e\u5df2\u5907\u4efd\u5230\u4e91\u7aef\u3002\u8fd9\u901a\u5e38\u53ef\u4ee5\u901a\u8fc7\u6e38\u620f\u7684\u8bbe\u7f6e\u83dc\u5355\u4e2d\u7684\u201c\u5e10\u6237\u201d\u6216\u201c\u4e91\u4fdd\u5b58\u201d\u6765\u5b8c\u6210\u3002\u5907\u4efd\u5b8c\u6210\u540e\uff0c\u5728\u65b0\u8bbe\u5907\u4e0a\u5b89\u88c5\u6e38\u620f\u5e76\u4f7f\u7528\u76f8\u540c\u7684\u5e10\u6237\u767b\u5f55\uff0c\u5373\u53ef\u6062\u590d\u60a8\u7684\u8fdb\u5ea6\u3002\u5728\u4ece\u65e7\u8bbe\u5907\u5220\u9664\u6e38\u620f\u4e4b\u524d\uff0c\u8bf7\u59cb\u7ec8\u9a8c\u8bc1\u6570\u636e\u5df2\u6210\u529f\u8f6c\u79fb\u3002"}, {"question": "\u590f\u65e5\u73ab\u7470\u51b0\u6dc7\u6dcb\u6e38\u620f\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u5173\u5361\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9501\u5b83\u4eec\uff1f", "answer": "\u590f\u65e5\u73ab\u7470\u51b0\u6dc7\u6dcb\u6e38\u620f\u5305\u542b\u9690\u85cf\u5173\u5361\uff0c\u901a\u8fc7\u8fbe\u5230\u7279\u5b9a\u91cc\u7a0b\u7891\u6765\u89e3\u9501\u3002\u4f8b\u5982\uff0c\u5728\u6240\u6709\u5173\u5361\u4e2d\u6536\u96c6 500 \u4e2a\u51b0\u6dc7\u6dcb\u5706\u9525\u540e\uff0c\u53ef\u4ee5\u8bbf\u95ee\u201c\u79d8\u5bc6\u82b1\u56ed\u201d\u5173\u5361\u3002\u8fd9\u4e9b\u9690\u85cf\u5173\u5361\u901a\u5e38\u5305\u542b\u72ec\u7279\u7684\u6311\u6218\u548c\u5956\u52b1\uff0c\u4f8b\u5982\u7279\u6b8a\u9053\u5177\u6216\u7a00\u6709\u6536\u85cf\u54c1\u3002\u8bf7\u5173\u6ce8\u6e38\u620f\u4e2d\u7684\u6210\u5c31\u90e8\u5206\uff0c\u4ee5\u4e86\u89e3\u60a8\u4f55\u65f6\u63a5\u8fd1\u89e3\u9501\u8fd9\u4e9b\u5173\u5361\u3002"}, {"question": "\u590f\u65e5\u73ab\u7470\u51b0\u6dc7\u6dcb\u6e38\u620f\u7684\u8ba1\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u590f\u65e5\u73ab\u7470\u51b0\u6dc7\u6dcb\u6e38\u620f\u7684\u8ba1\u5206\u7cfb\u7edf\u57fa\u4e8e\u51e0\u4e2a\u56e0\u7d20\uff1a\u6536\u96c6\u7684\u51b0\u6dc7\u6dcb\u5706\u9525\u6570\u91cf\u3001\u6536\u96c6\u7684\u65f6\u673a\uff08\u201c\u5b8c\u7f8e\u201d\u65f6\u673a\u4f1a\u4ea7\u751f\u66f4\u591a\u79ef\u5206\uff09\u4ee5\u53ca\u9053\u5177\u7684\u4f7f\u7528\u3002\u6b64\u5916\uff0c\u5728\u6ca1\u6709\u72af\u4efb\u4f55\u9519\u8bef\u6216\u4f7f\u7528\u7ee7\u7eed\u7684\u60c5\u51b5\u4e0b\u5b8c\u6210\u5173\u5361\u53ef\u4ee5\u83b7\u5f97\u989d\u5916\u79ef\u5206\u3002\u6e38\u620f\u8fd8\u5305\u542b\u4e00\u4e2a\u7ec4\u5408\u7cfb\u7edf\uff0c\u5176\u4e2d\u8fde\u7eed\u5b8c\u7f8e\u6536\u96c6\u4f1a\u589e\u52a0\u60a8\u7684\u5f97\u5206\u4e58\u6570\uff0c\u4ece\u800c\u663e\u7740\u63d0\u9ad8\u60a8\u7684\u603b\u5206\u3002"}, {"question": "\u590f\u65e5\u73ab\u7470\u51b0\u6dc7\u6dcb\u6e38\u620f\u4e2d\u54ea\u4e9b\u9053\u5177\u6700\u597d\u7528\uff0c\u4ee5\u53ca\u5b83\u4eec\u5982\u4f55\u589e\u5f3a\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u590f\u65e5\u73ab\u7470\u51b0\u6dc7\u6dcb\u6e38\u620f\u4e2d\u6700\u597d\u7684\u9053\u5177\u5305\u62ec\u201c\u53cc\u4efd\u52fa\u201d\uff0c\u53ef\u5728\u4e00\u5b9a\u65f6\u95f4\u5185\u5c06\u60a8\u7684\u5f97\u5206\u7ffb\u500d\uff0c\u4ee5\u53ca\u201c\u76fe\u724c\u201d\uff0c\u53ef\u4ee5\u4fdd\u62a4\u60a8\u514d\u53d7\u969c\u788d\u7269\u7684\u653b\u51fb\u3002\u8fd9\u4e9b\u9053\u5177\u53ef\u4ee5\u5728\u5173\u5361\u4e2d\u6563\u5e03\u7684\u7279\u6b8a\u7bb1\u5b50\u6216\u6e38\u620f\u5185\u5546\u5e97\u4e2d\u627e\u5230\u3002\u6218\u7565\u6027\u5730\u4f7f\u7528\u8fd9\u4e9b\u9053\u5177\u53ef\u4ee5\u6781\u5927\u5730\u589e\u5f3a\u60a8\u7684\u6e38\u620f\u4f53\u9a8c\uff0c\u8ba9\u60a8\u5728\u5177\u6709\u6311\u6218\u6027\u7684\u5173\u5361\u4e2d\u83b7\u5f97\u66f4\u9ad8\u7684\u5206\u6570\u5e76\u53d6\u5f97\u66f4\u5927\u7684\u8fdb\u6b65\u3002"}, {"question": "\u5982\u4f55\u5728\u590f\u65e5\u73ab\u7470\u51b0\u6dc7\u6dcb\u6e38\u620f\u4e2d\u63d0\u9ad8\u6211\u7684\u53cd\u5e94\u65f6\u95f4\uff1f", "answer": "\u5728\u590f\u65e5\u73ab\u7470\u51b0\u6dc7\u6dcb\u6e38\u620f\u4e2d\u63d0\u9ad8\u60a8\u7684\u53cd\u5e94\u65f6\u95f4\u53ef\u4ee5\u901a\u8fc7\u7ec3\u4e60\u548c\u719f\u6089\u6e38\u620f\u673a\u5236\u6765\u5b9e\u73b0\u3002\u82b1\u65f6\u95f4\u5728\u201c\u7ec3\u4e60\u6a21\u5f0f\u201d\u4e2d\uff0c\u719f\u6089\u5706\u9525\u6536\u96c6\u548c\u969c\u788d\u89c4\u907f\u7684\u65f6\u95f4\u3002\u6b64\u5916\uff0c\u5c06\u63a7\u5236\u7075\u654f\u5ea6\u8c03\u6574\u5230\u54cd\u5e94\u901f\u5ea6\u8f83\u5feb\u7684\u8bbe\u7f6e\u53ef\u4ee5\u6709\u6240\u5e2e\u52a9\u3002\u5b9a\u671f\u6e38\u620f\u4f1a\u81ea\u7136\u5730\u63d0\u9ad8\u60a8\u7684\u53cd\u5e94\u901f\u5ea6\uff0c\u4f7f\u60a8\u66f4\u64c5\u957f\u5e94\u5bf9\u6e38\u620f\u8282\u594f\u66f4\u5feb\u7684\u5173\u5361\u3002"}, {"question": "\u793e\u533a\u4e2d\u5173\u4e8e\u638c\u63e1\u590f\u65e5\u73ab\u7470\u51b0\u6dc7\u6dcb\u6e38\u620f\u7684\u6700\u4f73\u6280\u5de7\u6709\u54ea\u4e9b\uff1f", "answer": "\u793e\u533a\u4e2d\u5173\u4e8e\u638c\u63e1\u590f\u65e5\u73ab\u7470\u51b0\u6dc7\u6dcb\u6e38\u620f\u7684\u6700\u4f73\u6280\u5de7\u5305\u62ec\uff1a\u5b9a\u671f\u7ec3\u4e60\u4ee5\u63d0\u9ad8\u60a8\u7684\u6280\u80fd\u3001\u7814\u7a76\u6bcf\u4e2a\u5173\u5361\u7684\u5e03\u5c40\u4ee5\u89c4\u5212\u9ad8\u6548\u7684\u8def\u7ebf\u4ee5\u53ca\u660e\u667a\u5730\u4f7f\u7528\u9053\u5177\u3002\u8bb8\u591a\u73a9\u5bb6\u8fd8\u5efa\u8bae\u89c2\u770b\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u7684\u6559\u7a0b\u89c6\u9891\u6216\u76f4\u64ad\uff0c\u4ee5\u5b66\u4e60\u9ad8\u7ea7\u6280\u5de7\u3002\u901a\u8fc7\u8bba\u575b\u6216\u793e\u4ea4\u5a92\u4f53\u53c2\u4e0e\u793e\u533a\uff0c\u8fd8\u53ef\u4ee5\u83b7\u5f97\u5b9d\u8d35\u7684\u89c1\u89e3\u548c\u7b56\u7565\u6765\u589e\u5f3a\u60a8\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}]
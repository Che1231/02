[{"question": "\u521d\u5fc3\u8005\u5411\u3051\u306b\u3001\u590f\u307f\u3089\u3044\u30a2\u30a4\u30b9\u30b3\u30fc\u30f3\u30b2\u30fc\u30e0\u3092\u59cb\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u590f\u307f\u3089\u3044\u30a2\u30a4\u30b9\u30b3\u30fc\u30f3\u30b2\u30fc\u30e0\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u307e\u305a\u304a\u597d\u307f\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u304b\u3089\u30b2\u30fc\u30e0\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u5f8c\u3001\u30b2\u30fc\u30e0\u3092\u8d77\u52d5\u3057\u3001\u753b\u9762\u306e\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u306b\u5f93\u3044\u307e\u3059\u3002\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3067\u306f\u3001\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u3067\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u79fb\u52d5\u3057\u305f\u308a\u3001\u30a2\u30af\u30b7\u30e7\u30f3\u30dc\u30bf\u30f3\u3067\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3068\u30a4\u30f3\u30bf\u30e9\u30af\u30c8\u3057\u305f\u308a\u3068\u3044\u3063\u305f\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u65b9\u6cd5\u3092\u5b66\u3076\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30b3\u30fc\u30f3\u306e\u8fd1\u304f\u306e\u30a2\u30af\u30b7\u30e7\u30f3\u30dc\u30bf\u30f3\u3092\u30bf\u30c3\u30d7\u3057\u3066\u30a2\u30a4\u30b9\u30af\u30ea\u30fc\u30e0\u30b3\u30fc\u30f3\u3092\u96c6\u3081\u308b\u65b9\u6cd5\u3092\u5b66\u3073\u307e\u3059\u3002\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u306e\u611f\u5ea6\u3092\u597d\u307f\u306b\u5408\u308f\u305b\u3066\u8abf\u6574\u3059\u308b\u305f\u3081\u306b\u3001\u8a2d\u5b9a\u3092\u30c1\u30a7\u30c3\u30af\u3059\u308b\u3053\u3068\u3092\u5fd8\u308c\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u590f\u307f\u3089\u3044\u30a2\u30a4\u30b9\u30b3\u30fc\u30f3\u30b2\u30fc\u30e0\u3067\u9ad8\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u305f\u3081\u306e\u91cd\u8981\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u590f\u307f\u3089\u3044\u30a2\u30a4\u30b9\u30b3\u30fc\u30f3\u30b2\u30fc\u30e0\u3067\u9ad8\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u306b\u306f\u3001\u30b9\u30d4\u30fc\u30c9\u3068\u6b63\u78ba\u3055\u306e\u4e21\u65b9\u304c\u91cd\u8981\u3067\u3059\u3002 STEP1\uff1a\u30a2\u30a4\u30b9\u30af\u30ea\u30fc\u30e0\u30b3\u30fc\u30f3\u3092\u53ce\u96c6\u3059\u308b\u969b\u306f\u5e38\u306b\u300c\u5b8c\u74a7\u300d\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u610f\u8b58\u3057\u3001\u3053\u308c\u306b\u3088\u308a\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u307e\u3059\u3002 STEP2\uff1a\u9650\u5b9a\u6642\u9593\u5185\u306b\u30dd\u30a4\u30f3\u30c8\u30922\u500d\u306b\u3059\u308b\u300c\u30c0\u30d6\u30eb\u30b9\u30b3\u30fc\u30d7\u300d\u306a\u3069\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u6d3b\u7528\u3057\u307e\u3059\u3002 STEP3\uff1a\u969c\u5bb3\u7269\u3092\u907f\u3051\u3001\u30b3\u30fc\u30f3\u3092\u6700\u5927\u9650\u306b\u53ce\u96c6\u3059\u308b\u305f\u3081\u306e\u30eb\u30fc\u30c8\u3092\u8a08\u753b\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30b5\u30f3\u30bb\u30c3\u30c8\u30d6\u30fc\u30eb\u30d0\u30fc\u30c9\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u4e0a\u308a\u306e\u9053\u7b4b\u3092\u901a\u308b\u3053\u3068\u3067\u3001\u79fb\u52d5\u3059\u308b\u8eca\u3068\u306e\u885d\u7a81\u306e\u30ea\u30b9\u30af\u3092\u56de\u907f\u3057\u306a\u304c\u3089\u3001\u3088\u308a\u591a\u304f\u306e\u30b3\u30fc\u30f3\u3092\u96c6\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u590f\u307f\u3089\u3044\u30a2\u30a4\u30b9\u30b3\u30fc\u30f3\u30b2\u30fc\u30e0\u306e\u30ec\u30d9\u30eb\u3067\u5b63\u7bc0\u306e\u30c6\u30fc\u30de\u3092\u4f7f\u7528\u3059\u308b\u7406\u7531\u306f\u306a\u3093\u3067\u3059\u304b\uff1f", "answer": "\u590f\u307f\u3089\u3044\u30a2\u30a4\u30b9\u30b3\u30fc\u30f3\u30b2\u30fc\u30e0\u306f\u3001\u6ca1\u5165\u611f\u3092\u9ad8\u3081\u3001\u590f\u306e\u5192\u967a\u3068\u3044\u3046\u30b2\u30fc\u30e0\u306e\u4e16\u754c\u89b3\u3092\u53cd\u6620\u3059\u308b\u305f\u3081\u306b\u3001\u5b63\u7bc0\u306e\u30c6\u30fc\u30de\u3092\u63a1\u7528\u3057\u3066\u3044\u307e\u3059\u3002\u5404\u30ec\u30d9\u30eb\u306f\u3001\u590f\u306b\u306f\u30d3\u30fc\u30c1\u306e\u98a8\u666f\u3001\u51ac\u306b\u306f\u96ea\u666f\u8272\u306a\u3069\u3001\u72ec\u81ea\u306e\u5b63\u7bc0\u8981\u7d20\u3067\u8a2d\u8a08\u3055\u308c\u3066\u304a\u308a\u3001\u8996\u899a\u7684\u306a\u5909\u5316\u3060\u3051\u3067\u306a\u304f\u3001\u69d8\u3005\u306a\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u3082\u5c0e\u5165\u3057\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30a6\u30a3\u30f3\u30bf\u30fc\u30ef\u30f3\u30c0\u30fc\u30e9\u30f3\u30c9\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u79fb\u52d5\u3092\u6b63\u78ba\u306b\u884c\u3046\u5fc5\u8981\u304c\u3042\u308b\u6ed1\u308a\u3084\u3059\u3044\u6c37\u306e\u6591\u70b9\u304c\u898b\u3089\u308c\u307e\u3059\u3002"}, {"question": "\u590f\u307f\u3089\u3044\u30a2\u30a4\u30b9\u30b3\u30fc\u30f3\u30b2\u30fc\u30e0\u3067\u6700\u9069\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5f97\u308b\u305f\u3081\u306b\u3001\u3069\u306e\u8a2d\u5b9a\u3092\u8abf\u6574\u3059\u308b\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u590f\u307f\u3089\u3044\u30a2\u30a4\u30b9\u30b3\u30fc\u30f3\u30b2\u30fc\u30e0\u3067\u6700\u9069\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5f97\u308b\u306b\u306f\u3001\u30c7\u30d0\u30a4\u30b9\u306e\u80fd\u529b\u306b\u57fa\u3065\u3044\u3066\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u30e9\u30b0\u304c\u767a\u751f\u3059\u308b\u5834\u5408\u306f\u3001\u89e3\u50cf\u5ea6\u3092\u4e0b\u3052\u3066\u3001\u9ad8\u753b\u8cea\u52b9\u679c\u3092\u30aa\u30d5\u306b\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30b9\u30e0\u30fc\u30ba\u306a\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u79fb\u52d5\u3092\u78ba\u4fdd\u3059\u308b\u305f\u3081\u306b\u3001\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u306e\u611f\u5ea6\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306e\u9032\u884c\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u305a\u306b\u8a2d\u5b9a\u3092\u8abf\u6574\u3067\u304d\u308b\u300c\u7df4\u7fd2\u30e2\u30fc\u30c9\u300d\u3067\u3053\u308c\u3089\u306e\u8a2d\u5b9a\u3092\u30c6\u30b9\u30c8\u3059\u308b\u3053\u3068\u3092\u304a\u52e7\u3081\u3057\u307e\u3059\u3002"}, {"question": "\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u590f\u307f\u3089\u3044\u30a2\u30a4\u30b9\u30b3\u30fc\u30f3\u30b2\u30fc\u30e0\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "\u590f\u307f\u3089\u3044\u30a2\u30a4\u30b9\u30b3\u30fc\u30f3\u30b2\u30fc\u30e0\u306e\u9032\u884c\u72b6\u6cc1\u3092\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001\u30b2\u30fc\u30e0\u30c7\u30fc\u30bf\u3092\u30af\u30e9\u30a6\u30c9\u306b\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u3059\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u901a\u5e38\u3001\u30b2\u30fc\u30e0\u306e\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u306e\u300c\u30a2\u30ab\u30a6\u30f3\u30c8\u300d\u307e\u305f\u306f\u300c\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u300d\u3067\u53ef\u80fd\u3067\u3059\u3002\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u5f8c\u3001\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u30b2\u30fc\u30e0\u3092\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u3001\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u3067\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u9032\u884c\u72b6\u6cc1\u3092\u5fa9\u5143\u3057\u307e\u3059\u3002\u53e4\u3044\u30c7\u30d0\u30a4\u30b9\u304b\u3089\u30b2\u30fc\u30e0\u3092\u524a\u9664\u3059\u308b\u524d\u306b\u3001\u30c7\u30fc\u30bf\u304c\u6b63\u5e38\u306b\u8ee2\u9001\u3055\u308c\u305f\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u590f\u307f\u3089\u3044\u30a2\u30a4\u30b9\u30b3\u30fc\u30f3\u30b2\u30fc\u30e0\u306b\u306f\u3001\u3069\u306e\u3088\u3046\u306a\u96a0\u3057\u30ec\u30d9\u30eb\u304c\u3042\u308a\u3001\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u307e\u3059\u304b\uff1f", "answer": "\u590f\u307f\u3089\u3044\u30a2\u30a4\u30b9\u30b3\u30fc\u30f3\u30b2\u30fc\u30e0\u306b\u306f\u3001\u7279\u5b9a\u306e\u76ee\u6a19\u3092\u9054\u6210\u3059\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u308b\u96a0\u3057\u30ec\u30d9\u30eb\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u79d8\u5bc6\u306e\u5ead\u5712\u300d\u30ec\u30d9\u30eb\u306f\u3001\u3059\u3079\u3066\u306e\u30ec\u30d9\u30eb\u3067\u30a2\u30a4\u30b9\u30af\u30ea\u30fc\u30e0\u30b3\u30fc\u30f3\u3092500\u500b\u96c6\u3081\u308b\u3053\u3068\u3067\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u96a0\u3057\u30ec\u30d9\u30eb\u306f\u3001\u7279\u5225\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3084\u30ec\u30a2\u306a\u30b3\u30ec\u30af\u30bf\u30d6\u30eb\u306a\u3069\u306e\u30e6\u30cb\u30fc\u30af\u306a\u8ab2\u984c\u3068\u5831\u916c\u3092\u542b\u307f\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30ec\u30d9\u30eb\u306e\u30a2\u30f3\u30ed\u30c3\u30af\u306b\u8fd1\u3065\u3044\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3059\u308b\u305f\u3081\u306b\u3001\u30b2\u30fc\u30e0\u306e\u9054\u6210\u5ea6\u30bb\u30af\u30b7\u30e7\u30f3\u306e\u9032\u884c\u72b6\u6cc1\u3092\u6ce8\u610f\u6df1\u304f\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u590f\u307f\u3089\u3044\u30a2\u30a4\u30b9\u30b3\u30fc\u30f3\u30b2\u30fc\u30e0\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u590f\u307f\u3089\u3044\u30a2\u30a4\u30b9\u30b3\u30fc\u30f3\u30b2\u30fc\u30e0\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u53ce\u96c6\u3057\u305f\u30a2\u30a4\u30b9\u30af\u30ea\u30fc\u30e0\u30b3\u30fc\u30f3\u306e\u6570\u3001\u53ce\u96c6\u306e\u30bf\u30a4\u30df\u30f3\u30b0\uff08\u300c\u5b8c\u74a7\u300d\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u306f\u3088\u308a\u591a\u304f\u306e\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\uff09\u3001\u304a\u3088\u3073\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306e\u4f7f\u7528\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u307e\u305f\u3001\u30a8\u30e9\u30fc\u3092\u72af\u3059\u3053\u3068\u306a\u304f\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3057\u305f\u308a\u3001\u30b3\u30f3\u30c6\u30a3\u30cb\u30e5\u30fc\u3092\u4f7f\u7528\u3057\u305f\u308a\u3057\u305f\u5834\u5408\u306b\u3082\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u304c\u4e0e\u3048\u3089\u308c\u307e\u3059\u3002\u3053\u306e\u30b2\u30fc\u30e0\u306f\u3001\u9023\u7d9a\u3057\u3066\u5b8c\u74a7\u306a\u53ce\u96c6\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u30b3\u30f3\u30dc\u30b7\u30b9\u30c6\u30e0\u3082\u5099\u3048\u3066\u304a\u308a\u3001\u5408\u8a08\u30b9\u30b3\u30a2\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002"}, {"question": "\u590f\u307f\u3089\u3044\u30a2\u30a4\u30b9\u30b3\u30fc\u30f3\u30b2\u30fc\u30e0\u3067\u6700\u9ad8\u306e\u30dc\u30fc\u30ca\u30b9\u30a2\u30a4\u30c6\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u306f\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u304b\uff1f", "answer": "\u590f\u307f\u3089\u3044\u30a2\u30a4\u30b9\u30b3\u30fc\u30f3\u30b2\u30fc\u30e0\u306e\u6700\u9ad8\u306e\u30dc\u30fc\u30ca\u30b9\u30a2\u30a4\u30c6\u30e0\u306b\u306f\u3001\u9650\u5b9a\u6642\u9593\u5185\u306b\u30dd\u30a4\u30f3\u30c8\u30922\u500d\u306b\u3059\u308b\u300c\u30c0\u30d6\u30eb\u30b9\u30b3\u30fc\u30d7\u300d\u3068\u3001\u969c\u5bb3\u7269\u304b\u3089\u4fdd\u8b77\u3059\u308b\u300c\u30b7\u30fc\u30eb\u30c9\u300d\u306a\u3069\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30a2\u30a4\u30c6\u30e0\u306f\u30ec\u30d9\u30eb\u4e2d\u306b\u6563\u3089\u3070\u3063\u3066\u3044\u308b\u7279\u5225\u306a\u7bb1\u306e\u4e2d\u306b\u3042\u308b\u3001\u307e\u305f\u306f\u30b2\u30fc\u30e0\u5185\u30b9\u30c8\u30a2\u3067\u8cfc\u5165\u53ef\u80fd\u3067\u3059\u3002\u3053\u308c\u3089\u306e\u30dc\u30fc\u30ca\u30b9\u30a2\u30a4\u30c6\u30e0\u3092\u6226\u7565\u7684\u306b\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3057\u3001\u6311\u6226\u7684\u306a\u30ec\u30d9\u30eb\u3092\u3055\u3089\u306b\u9032\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u590f\u307f\u3089\u3044\u30a2\u30a4\u30b9\u30b3\u30fc\u30f3\u30b2\u30fc\u30e0\u3067\u53cd\u5fdc\u6642\u9593\u3092\u6539\u5584\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u590f\u307f\u3089\u3044\u30a2\u30a4\u30b9\u30b3\u30fc\u30f3\u30b2\u30fc\u30e0\u306b\u304a\u3051\u308b\u53cd\u5fdc\u6642\u9593\u306e\u6539\u5584\u306f\u3001\u7df4\u7fd2\u3068\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u3078\u306e\u7406\u89e3\u3092\u901a\u3058\u3066\u9054\u6210\u3067\u304d\u307e\u3059\u3002\u300c\u7df4\u7fd2\u30e2\u30fc\u30c9\u300d\u3067\u6642\u9593\u3092\u304b\u3051\u3066\u30b3\u30fc\u30f3\u306e\u53ce\u96c6\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u969c\u5bb3\u7269\u56de\u907f\u306b\u6163\u308c\u308b\u3088\u3046\u306b\u3057\u307e\u3057\u3087\u3046\u3002\u307e\u305f\u3001\u64cd\u4f5c\u611f\u306e\u826f\u3044\u3088\u3046\u306b\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u306e\u611f\u5ea6\u3092\u8abf\u6574\u3059\u308b\u3068\u5f79\u7acb\u3061\u307e\u3059\u3002\u5b9a\u671f\u7684\u306b\u30d7\u30ec\u30a4\u3059\u308b\u3053\u3068\u3067\u3001\u81ea\u7136\u3068\u53cd\u5c04\u795e\u7d4c\u304c\u5411\u4e0a\u3057\u3001\u30b2\u30fc\u30e0\u306e\u30da\u30fc\u30b9\u306e\u901f\u3044\u30ec\u30d9\u30eb\u3092\u3088\u308a\u6a5f\u654f\u306b\u64cd\u4f5c\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002"}, {"question": "\u590f\u307f\u3089\u3044\u30a2\u30a4\u30b9\u30b3\u30fc\u30f3\u30b2\u30fc\u30e0\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u305f\u3081\u306e\u3001\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u306e\u4eba\u6c17\u306e\u304a\u3059\u3059\u3081\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u590f\u307f\u3089\u3044\u30a2\u30a4\u30b9\u30b3\u30fc\u30f3\u30b2\u30fc\u30e0\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u305f\u3081\u306e\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u306e\u4eba\u6c17\u306e\u304a\u3059\u3059\u3081\u306f\u3001\u30b9\u30ad\u30eb\u3092\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u306b\u5b9a\u671f\u7684\u306b\u7df4\u7fd2\u3059\u308b\u3053\u3068\u3001\u52b9\u7387\u7684\u306a\u30eb\u30fc\u30c8\u3092\u8a08\u753b\u3059\u308b\u305f\u3081\u306b\u5404\u30ec\u30d9\u30eb\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u7814\u7a76\u3059\u308b\u3053\u3068\u3001\u305d\u3057\u3066\u30dc\u30fc\u30ca\u30b9\u30a2\u30a4\u30c6\u30e0\u3092\u8ce2\u304f\u4f7f\u3046\u3053\u3068\u3067\u3059\u3002\u591a\u304f\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30d3\u30c7\u30aa\u3084\u30b9\u30c8\u30ea\u30fc\u30df\u30f3\u30b0\u3092\u898b\u308b\u3053\u3068\u3092\u52e7\u3081\u3001\u9ad8\u5ea6\u306a\u30c6\u30af\u30cb\u30c3\u30af\u3092\u5b66\u3076\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30d5\u30a9\u30fc\u30e9\u30e0\u3084\u30bd\u30fc\u30b7\u30e3\u30eb\u30e1\u30c7\u30a3\u30a2\u3092\u901a\u3058\u3066\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u3068\u4ea4\u6d41\u3059\u308b\u3053\u3068\u3082\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u306e\u8cb4\u91cd\u306a\u6d1e\u5bdf\u3068\u6226\u7565\u3092\u5f97\u308b\u305f\u3081\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}]
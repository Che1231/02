[{"question": "\u5982\u4f55\u5728\u300a\u53cc\u4eba\u5766\u514b\u5927\u6218\u300b\u4e2d\u63a7\u5236\u6211\u7684\u5766\u514b\uff1f", "answer": "\u5728\u300a\u53cc\u4eba\u5766\u514b\u5927\u6218\u300b\u4e2d\uff0c\u63a7\u5236\u4f60\u7684\u5766\u514b\u975e\u5e38\u7b80\u5355\u3002\u4f7f\u7528 WASD \u952e\u6765\u524d\u8fdb\u3001\u540e\u9000\u548c\u5de6\u53f3\u8f6c\u5411\u3002\u4f7f\u7528\u9f20\u6807\u7784\u51c6\u70ae\u5854\uff0c\u5de6\u952e\u70b9\u51fb\u53d1\u5c04\u3002\u4f8b\u5982\uff0c\u8981\u524d\u8fdb\u5e76\u5411\u654c\u4eba\u5c04\u51fb\uff0c\u8bf7\u6309\u201cW\u201d\u524d\u8fdb\uff0c\u7136\u540e\u5de6\u952e\u70b9\u51fb\u5c04\u51fb\u3002\u8fd9\u79cd\u57fa\u672c\u7684\u63a7\u5236\u65b9\u6848\u80fd\u8ba9\u4f60\u5feb\u901f\u53c2\u4e0e\u6218\u6597\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u53ef\u4ee5\u628a\u4f60\u7684\u5766\u514b\u60f3\u8c61\u6210\u4e00\u8f86\u6c7d\u8f66\uff1b\u6309\u952e\u5c31\u50cf\u65b9\u5411\u76d8\u548c\u8e0f\u677f\uff0c\u800c\u9f20\u6807\u5c31\u662f\u4f60\u7684\u7784\u51c6\u7cfb\u7edf\u3002]"}, {"question": "\u5728\u300a\u53cc\u4eba\u5766\u514b\u5927\u6218\u300b\u4e2d\uff0c\u8d62\u5f97\u6bd4\u8d5b\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300a\u53cc\u4eba\u5766\u514b\u5927\u6218\u300b\u4e2d\u83b7\u80dc\u9700\u8981\u7b56\u7565\u548c\u6218\u672f\u7684\u7ed3\u5408\u3002\u6b65\u9aa4\u4e00\uff1a\u59cb\u7ec8\u4fdd\u6301\u79fb\u52a8\u4ee5\u907f\u514d\u654c\u4eba\u653b\u51fb\u3002\u6b65\u9aa4\u4e8c\uff1a\u5229\u7528\u73af\u5883\u4f18\u52bf\uff0c\u8eb2\u85cf\u5728\u969c\u788d\u7269\u540e\u9762\u3002\u6b65\u9aa4\u4e09\uff1a\u4e0e\u961f\u53cb\u914d\u5408\uff0c\u4ece\u654c\u4eba\u4fa7\u7ffc\u653b\u51fb\u3002\u4f8b\u5982\uff0c\u4e00\u4e2a\u4eba\u5438\u5f15\u654c\u4eba\u7684\u6ce8\u610f\u529b\uff0c\u53e6\u4e00\u4e2a\u4eba\u53ef\u4ee5\u4ece\u4fa7\u9762\u653b\u51fb\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u4e0e\u6b63\u9762\u653b\u51fb\u76f8\u6bd4\uff0c\u4fa7\u7ffc\u653b\u51fb\u66f4\u6709\u6548\uff0c\u56e0\u4e3a\u5b83\u4f1a\u6270\u4e71\u654c\u4eba\uff0c\u964d\u4f4e\u4ed6\u4eec\u53cd\u51fb\u7684\u80fd\u529b\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u7684\u5766\u514b\u6709\u65f6\u4f1a\u5728\u300a\u53cc\u4eba\u5766\u514b\u5927\u6218\u300b\u4e2d\u53d7\u5230\u66f4\u591a\u4f24\u5bb3\uff1f", "answer": "\u5728\u300a\u53cc\u4eba\u5766\u514b\u5927\u6218\u300b\u4e2d\uff0c\u4f60\u7684\u5766\u514b\u53ef\u80fd\u4f1a\u53d7\u5230\u66f4\u591a\u4f24\u5bb3\uff0c\u539f\u56e0\u6709\u591a\u79cd\u3002\u9996\u5148\uff0c\u4e0d\u540c\u7684\u654c\u4eba\u6b66\u5668\u5177\u6709\u4e0d\u540c\u7684\u4f24\u5bb3\u503c\u3002\u4f8b\u5982\uff0c\u706b\u7bad\u53d1\u5c04\u5668\u9020\u6210\u7684\u4f24\u5bb3\u6bd4\u673a\u67aa\u66f4\u5927\u3002\u5176\u6b21\uff0c\u649e\u51fb\u89d2\u5ea6\u4f1a\u5f71\u54cd\u4f24\u5bb3\uff1b\u51fb\u4e2d\u5766\u514b\u4fa7\u9762\u6216\u540e\u65b9\u7684\u5c04\u51fb\u6bd4\u6b63\u9762\u51fb\u4e2d\u9020\u6210\u66f4\u591a\u4f24\u5bb3\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6b66\u5668\u7c7b\u578b\u53ca\u5176\u4f24\u5bb3\u503c\u7684\u8868\u683c\u53ef\u4ee5\u5e2e\u52a9\u4f60\u4e86\u89e3\u4f18\u5148\u653b\u51fb\u54ea\u4e9b\u654c\u4eba\u3002]"}, {"question": "\u5728\u300a\u53cc\u4eba\u5766\u514b\u5927\u6218\u300b\u4e2d\uff0c\u6211\u5e94\u8be5\u4f18\u5148\u5347\u7ea7\u54ea\u4e9b\u90e8\u4ef6\uff1f", "answer": "\u5728\u300a\u53cc\u4eba\u5766\u514b\u5927\u6218\u300b\u4e2d\uff0c\u5347\u7ea7\u90e8\u4ef6\u7684\u4f18\u5148\u7ea7\u53d6\u51b3\u4e8e\u4f60\u7684\u6e38\u620f\u98ce\u683c\u3002\u5982\u679c\u4f60\u559c\u6b22\u79ef\u6781\u7684\u653b\u51fb\uff0c\u90a3\u5c31\u4e13\u6ce8\u4e8e\u5347\u7ea7\u4f60\u7684\u706b\u529b\u548c\u901f\u5ea6\u3002\u5bf9\u4e8e\u9632\u5fa1\u578b\u73a9\u5bb6\u6765\u8bf4\uff0c\u88c5\u7532\u548c\u751f\u547d\u503c\u5347\u7ea7\u81f3\u5173\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5347\u7ea7\u70ae\u5854\u65cb\u8f6c\u901f\u5ea6\u53ef\u4ee5\u66f4\u5feb\u5730\u7784\u51c6\uff0c\u5728\u5feb\u901f\u6218\u6597\u4e2d\u4e3a\u4f60\u8d62\u5f97\u4f18\u52bf\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6bd4\u8f83\u4e0d\u540c\u7684\u5347\u7ea7\u8def\u5f84\u53ef\u4ee5\u5e2e\u52a9\u4f60\u6839\u636e\u7b56\u7565\u9009\u62e9\u589e\u5f3a\u653b\u51fb\u8fd8\u662f\u9632\u5fa1\u3002]"}, {"question": "\u300a\u53cc\u4eba\u5766\u514b\u5927\u6218\u300b\u7684\u5339\u914d\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u300a\u53cc\u4eba\u5766\u514b\u5927\u6218\u300b\u7684\u5339\u914d\u7cfb\u7edf\u4f1a\u6839\u636e\u73a9\u5bb6\u7684\u6280\u80fd\u7b49\u7ea7\u548c\u6e38\u620f\u65f6\u95f4\u6765\u5339\u914d\u73a9\u5bb6\u3002\u5b83\u4f7f\u7528\u4e00\u4e2a\u7b97\u6cd5\uff0c\u8003\u8651\u4f60\u7684\u80dc\u8d1f\u6bd4\u548c\u6700\u8fd1\u7684\u8868\u73b0\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4e00\u76f4\u83b7\u80dc\uff0c\u4f60\u5c06\u88ab\u5339\u914d\u5230\u6280\u80fd\u76f8\u4f3c\u7684\u73a9\u5bb6\uff0c\u4ee5\u786e\u4fdd\u6e38\u620f\u516c\u5e73\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u5339\u914d\u6d41\u7a0b\u7684\u6d41\u7a0b\u56fe\u53ef\u4ee5\u5e2e\u52a9\u4f60\u76f4\u89c2\u5730\u4e86\u89e3\u73a9\u5bb6\u662f\u5982\u4f55\u914d\u5bf9\u7684\u3002]"}, {"question": "\u300a\u53cc\u4eba\u5766\u514b\u5927\u6218\u300b\u4e2d\u4e0d\u540c\u5766\u514b\u7c7b\u578b\u7684\u5173\u952e\u533a\u522b\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300a\u53cc\u4eba\u5766\u514b\u5927\u6218\u300b\u4e2d\uff0c\u5766\u514b\u7c7b\u578b\u5728\u901f\u5ea6\u3001\u88c5\u7532\u548c\u706b\u529b\u65b9\u9762\u6709\u6240\u4e0d\u540c\u3002\u8f7b\u578b\u5766\u514b\u901f\u5ea6\u5feb\uff0c\u4f46\u88c5\u7532\u8f83\u5f31\uff0c\u800c\u91cd\u578b\u5766\u514b\u901f\u5ea6\u6162\uff0c\u4f46\u66f4\u8010\u7528\u3002\u4f8b\u5982\uff0c\u8f7b\u578b\u5766\u514b\u53ef\u4ee5\u5feb\u901f\u4ece\u654c\u4eba\u4fa7\u7ffc\u653b\u51fb\uff0c\u4f46\u5fc5\u987b\u907f\u514d\u76f4\u63a5\u51b2\u7a81\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6bd4\u8f83\u5766\u514b\u7c7b\u578b\u7684\u8868\u683c\u53ef\u4ee5\u5e2e\u52a9\u4f60\u6839\u636e\u6e38\u620f\u98ce\u683c\u9009\u62e9\u5408\u9002\u7684\u5766\u514b\u7c7b\u578b\u3002]"}, {"question": "\u5982\u4f55\u5728\u300a\u53cc\u4eba\u5766\u514b\u5927\u6218\u300b\u4e2d\u5c06\u6211\u7684\u7535\u8111\u8fdb\u5ea6\u8f6c\u79fb\u5230\u4e3b\u673a\uff1f", "answer": "\u5728\u300a\u53cc\u4eba\u5766\u514b\u5927\u6218\u300b\u4e2d\u5c06\u7535\u8111\u8fdb\u5ea6\u8f6c\u79fb\u5230\u4e3b\u673a\u975e\u5e38\u7b80\u5355\u3002\u9996\u5148\uff0c\u786e\u4fdd\u4f60\u5728\u8fd9\u4e24\u4e2a\u5e73\u53f0\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u5e10\u6237\u3002\u7136\u540e\uff0c\u4f7f\u7528\u4e91\u4fdd\u5b58\u529f\u80fd\u5c06\u4f60\u7684\u7535\u8111\u8fdb\u5ea6\u4e0a\u4f20\uff0c\u5e76\u5728\u4f60\u7684\u4e3b\u673a\u4e0a\u4e0b\u8f7d\u3002\u4f8b\u5982\uff0c\u5728\u7535\u8111\u4e0a\u5b8c\u6210\u4efb\u52a1\u540e\uff0c\u5c06\u5b58\u6863\u4e0a\u4f20\u5230\u4e3b\u673a\u4e0a\u7ee7\u7eed\u6e38\u620f\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u53ef\u4ee5\u628a\u4e91\u5b58\u50a8\u60f3\u8c61\u6210\u4e00\u4e2a\u80cc\u5305\uff0c\u5b83\u53ef\u4ee5\u628a\u4f60\u7684\u8fdb\u5ea6\u5e26\u5230\u4efb\u4f55\u5730\u65b9\u3002]"}, {"question": "\u5728\u300a\u53cc\u4eba\u5766\u514b\u5927\u6218\u300b\u4e2d\uff0c\u6211\u53ef\u4ee5\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u529f\u80fd\uff1f", "answer": "\u300a\u53cc\u4eba\u5766\u514b\u5927\u6218\u300b\u6709\u4e00\u4e9b\u9690\u85cf\u529f\u80fd\u3002\u4f8b\u5982\uff0c\u67d0\u4e9b\u5730\u56fe\u4e2d\u9690\u85cf\u7740\u63d0\u4f9b\u9053\u5177\u7684\u79d8\u5bc6\u533a\u57df\u3002\u6b64\u5916\uff0c\u4e00\u4e9b\u5766\u514b\u5177\u6709\u901a\u8fc7\u7279\u5b9a\u6309\u952e\u7ec4\u5408\u6fc0\u6d3b\u7684\u9690\u85cf\u80fd\u529b\u3002\u63a2\u7d22\u8fd9\u4e9b\u529f\u80fd\u53ef\u4ee5\u8ba9\u4f60\u5728\u6218\u6597\u4e2d\u83b7\u5f97\u4f18\u52bf\u3002[\u5f69\u86cb\u6316\u6398\uff1a\u53d1\u73b0\u8fd9\u4e9b\u9690\u85cf\u5143\u7d20\uff0c\u8ba9\u6e38\u620f\u66f4\u5177\u523a\u6fc0\u6027\u548c\u7b56\u7565\u6027\u3002]"}, {"question": "\u5982\u4f55\u5728\u300a\u53cc\u4eba\u5766\u514b\u5927\u6218\u300b\u4e2d\u4f18\u5316\u6211\u7684\u8bbe\u7f6e\u4ee5\u83b7\u5f97\u66f4\u597d\u7684\u6027\u80fd\uff1f", "answer": "\u5728\u300a\u53cc\u4eba\u5766\u514b\u5927\u6218\u300b\u4e2d\u4f18\u5316\u8bbe\u7f6e\u53ef\u4ee5\u63d0\u9ad8\u6027\u80fd\u3002\u964d\u4f4e\u56fe\u5f62\u8bbe\u7f6e\uff0c\u4f8b\u5982\u7eb9\u7406\u8d28\u91cf\u548c\u9634\u5f71\u7ec6\u8282\uff0c\u53ef\u4ee5\u63d0\u9ad8\u4f4e\u7aef\u7cfb\u7edf\u7684\u5e27\u901f\u7387\u3002\u4f8b\u5982\uff0c\u5c06\u5206\u8fa8\u7387\u4ece 1080p \u964d\u4f4e\u5230 720p \u53ef\u4ee5\u663e\u7740\u63d0\u9ad8\u6027\u80fd\uff0c\u800c\u4e0d\u4f1a\u5927\u5e45\u5f71\u54cd\u89c6\u89c9\u6548\u679c\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u8bbe\u7f6e\u5bf9\u6bd4\u8868\u53ef\u4ee5\u5e2e\u52a9\u4f60\u627e\u5230\u6027\u80fd\u548c\u89c6\u89c9\u6548\u679c\u4e4b\u95f4\u7684\u6700\u4f73\u5e73\u8861\u3002]"}, {"question": "\u5728\u300a\u53cc\u4eba\u5766\u514b\u5927\u6218\u300b\u4e2d\uff0c\u54ea\u4e9b\u662f\u6700\u6709\u6548\u7684\u56e2\u961f\u7ec4\u5408\uff1f", "answer": "\u5728\u300a\u53cc\u4eba\u5766\u514b\u5927\u6218\u300b\u4e2d\uff0c\u6709\u6548\u7684\u56e2\u961f\u7ec4\u5408\u901a\u5e38\u5305\u62ec\u4e0d\u540c\u7c7b\u578b\u7684\u5766\u514b\u3002\u4f8b\u5982\uff0c\u5c06\u91cd\u578b\u5766\u514b\u4e0e\u8f7b\u578b\u5766\u514b\u642d\u914d\u53ef\u4ee5\u63d0\u4f9b\u8010\u4e45\u6027\u548c\u901f\u5ea6\u3002\u91cd\u578b\u5766\u514b\u53ef\u4ee5\u5438\u6536\u4f24\u5bb3\uff0c\u800c\u8f7b\u578b\u5766\u514b\u53ef\u4ee5\u4ece\u4fa7\u7ffc\u653b\u51fb\u654c\u4eba\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6bd4\u8f83\u4e0d\u540c\u7684\u56e2\u961f\u7ec4\u5408\u53ef\u4ee5\u5e2e\u52a9\u4f60\u4e86\u89e3\u5728\u4e0d\u540c\u60c5\u51b5\u4e0b\u54ea\u4e9b\u7ec4\u5408\u6548\u679c\u6700\u597d\u3002]"}]
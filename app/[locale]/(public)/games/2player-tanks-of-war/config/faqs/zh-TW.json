[{"question": "\u5982\u4f55\u5728\u300a\u6230\u722d\u5766\u514b\u96d9\u4eba\u6230\u300b\u4e2d\u63a7\u5236\u6211\u7684\u5766\u514b\uff1f", "answer": "\u5728\u300a\u6230\u722d\u5766\u514b\u96d9\u4eba\u6230\u300b\u4e2d\uff0c\u63a7\u5236\u4f60\u7684\u5766\u514b\u975e\u5e38\u7c21\u55ae\u3002\u4f7f\u7528 WASD \u9375\u524d\u9032\u3001\u5f8c\u9000\u548c\u5de6\u53f3\u8f49\u5411\u3002\u4f7f\u7528\u6ed1\u9f20\u7784\u6e96\u70ae\u5854\uff0c\u5de6\u9375\u9ede\u64ca\u767c\u5c04\u3002\u4f8b\u5982\uff0c\u8981\u524d\u9032\u4e26\u5411\u6575\u4eba\u958b\u706b\uff0c\u8acb\u6309\"W\"\u524d\u9032\uff0c\u7136\u5f8c\u5de6\u9375\u9ede\u64ca\u5c04\u64ca\u3002\u9019\u7a2e\u57fa\u672c\u7684\u63a7\u5236\u65b9\u6848\u78ba\u4fdd\u60a8\u53ef\u4ee5\u5feb\u901f\u53c3\u8207\u6230\u9b25\u3002[\u985e\u6bd4\u8aaa\u660e\uff1a\u628a\u4f60\u7684\u5766\u514b\u60f3\u50cf\u6210\u4e00\u8f1b\u6c7d\u8eca\uff1b\u9375\u76e4\u662f\u4f60\u7684\u65b9\u5411\u76e4\u548c\u8e0f\u677f\uff0c\u800c\u6ed1\u9f20\u662f\u4f60\u7684\u76ee\u6a19\u7cfb\u7d71\u3002]"}, {"question": "\u5728\u300a\u6230\u722d\u5766\u514b\u96d9\u4eba\u6230\u300b\u4e2d\u7372\u52dd\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u300a\u6230\u722d\u5766\u514b\u96d9\u4eba\u6230\u300b\u4e2d\u7372\u52dd\u9700\u8981\u7b56\u7565\u548c\u6230\u8853\u7684\u7d50\u5408\u3002\u6b65\u9a5f1\uff1a\u59cb\u7d42\u4fdd\u6301\u79fb\u52d5\u4ee5\u907f\u514d\u6575\u4eba\u7684\u653b\u64ca\u3002\u6b65\u9a5f2\uff1a\u5229\u7528\u74b0\u5883\uff0c\u8eb2\u85cf\u5728\u969c\u7919\u7269\u5f8c\u9762\u3002\u6b65\u9a5f3\uff1a\u8207\u968a\u53cb\u5354\u8abf\u5074\u7ffc\u653b\u64ca\u6575\u4eba\u3002\u4f8b\u5982\uff0c\u7576\u4e00\u540d\u73a9\u5bb6\u5438\u5f15\u6575\u4eba\u7684\u6ce8\u610f\u529b\u6642\uff0c\u53e6\u4e00\u540d\u73a9\u5bb6\u53ef\u4ee5\u5f9e\u5074\u9762\u653b\u64ca\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u8207\u6b63\u9762\u653b\u64ca\u76f8\u6bd4\uff0c\u5074\u7ffc\u653b\u64ca\u53ef\u80fd\u66f4\u6709\u6548\uff0c\u56e0\u70ba\u5b83\u6703\u64fe\u4e82\u6575\u4eba\u7684\u90e8\u7f72\uff0c\u4e26\u964d\u4f4e\u4ed6\u5011\u53cd\u64ca\u7684\u80fd\u529b\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u7684\u5766\u514b\u6709\u6642\u5728\u300a\u6230\u722d\u5766\u514b\u96d9\u4eba\u6230\u300b\u4e2d\u6703\u53d7\u5230\u66f4\u591a\u50b7\u5bb3\uff1f", "answer": "\u4f60\u7684\u5766\u514b\u5728\u300a\u6230\u722d\u5766\u514b\u96d9\u4eba\u6230\u300b\u4e2d\u53ef\u80fd\u53d7\u5230\u66f4\u591a\u50b7\u5bb3\uff0c\u539f\u56e0\u6709\u5e7e\u500b\u3002\u9996\u5148\uff0c\u4e0d\u540c\u7684\u6575\u65b9\u6b66\u5668\u5177\u6709\u4e0d\u540c\u7684\u50b7\u5bb3\u503c\u3002\u4f8b\u5982\uff0c\u706b\u7bad\u767c\u5c04\u5668\u9020\u6210\u7684\u50b7\u5bb3\u5c07\u6bd4\u6a5f\u69cd\u9ad8\u3002\u5176\u6b21\uff0c\u649e\u64ca\u89d2\u5ea6\u6703\u5f71\u97ff\u50b7\u5bb3\uff1b\u64ca\u4e2d\u5766\u514b\u5074\u7ffc\u6216\u5f8c\u65b9\u7684\u5b50\u5f48\u6bd4\u64ca\u4e2d\u524d\u65b9\u7684\u5b50\u5f48\u50b7\u5bb3\u66f4\u5927\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6bd4\u8f03\u6b66\u5668\u985e\u578b\u53ca\u5176\u50b7\u5bb3\u503c\u7684\u8868\u683c\u53ef\u4ee5\u5e6b\u52a9\u4f60\u4e86\u89e3\u512a\u5148\u8003\u616e\u54ea\u4e9b\u6575\u4eba\u3002]"}, {"question": "\u5728\u300a\u6230\u722d\u5766\u514b\u96d9\u4eba\u6230\u300b\u4e2d\uff0c\u6211\u61c9\u8a72\u512a\u5148\u5347\u7d1a\u54ea\u4e9b\u88dd\u5099\uff1f", "answer": "\u5728\u300a\u6230\u722d\u5766\u514b\u96d9\u4eba\u6230\u300b\u4e2d\uff0c\u512a\u5148\u5347\u7d1a\u88dd\u5099\u53d6\u6c7a\u65bc\u4f60\u7684\u904a\u6232\u98a8\u683c\u3002\u5982\u679c\u4f60\u559c\u6b61\u7a4d\u6975\u7684\u904a\u6232\u98a8\u683c\uff0c\u8acb\u91cd\u9ede\u5347\u7d1a\u4f60\u7684\u706b\u529b\u548c\u901f\u5ea6\u3002\u5c0d\u65bc\u9632\u5b88\u578b\u7684\u73a9\u5bb6\u4f86\u8aaa\uff0c\u88dd\u7532\u548c\u751f\u547d\u503c\u5347\u7d1a\u81f3\u95dc\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u63d0\u5347\u4f60\u7684\u70ae\u5854\u65cb\u8f49\u901f\u5ea6\u53ef\u4ee5\u52a0\u5feb\u76ee\u6a19\u7784\u6e96\u901f\u5ea6\uff0c\u5728\u5feb\u7bc0\u594f\u7684\u6230\u9b25\u4e2d\u7d66\u4f60\u512a\u52e2\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u6bd4\u8f03\u5347\u7d1a\u8def\u7dda\u53ef\u4ee5\u5e6b\u52a9\u4f60\u6c7a\u5b9a\u662f\u52a0\u5f37\u653b\u64ca\u9084\u662f\u9632\u5b88\uff0c\u53d6\u6c7a\u65bc\u4f60\u7684\u7b56\u7565\u3002]"}, {"question": "\u300a\u6230\u722d\u5766\u514b\u96d9\u4eba\u6230\u300b\u7684\u5339\u914d\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u300a\u6230\u722d\u5766\u514b\u96d9\u4eba\u6230\u300b\u7684\u5339\u914d\u7cfb\u7d71\u6839\u64da\u73a9\u5bb6\u7684\u6280\u80fd\u7b49\u7d1a\u548c\u904a\u6232\u6642\u9593\u914d\u5c0d\u73a9\u5bb6\u3002\u5b83\u4f7f\u7528\u4e00\u500b\u8003\u616e\u4f60\u7684\u52dd\u7387\u548c\u6700\u8fd1\u8868\u73fe\u7684\u6f14\u7b97\u6cd5\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4e00\u76f4\u8d0f\u5f97\u6bd4\u8cfd\uff0c\u4f60\u5c07\u6703\u88ab\u5339\u914d\u5230\u6280\u80fd\u76f8\u8fd1\u7684\u73a9\u5bb6\uff0c\u4ee5\u78ba\u4fdd\u904a\u6232\u5e73\u8861\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u4e00\u500b\u5c55\u793a\u5339\u914d\u6d41\u7a0b\u7684\u6d41\u7a0b\u5716\u53ef\u4ee5\u5e6b\u52a9\u4f60\u76f4\u89c0\u5730\u4e86\u89e3\u73a9\u5bb6\u662f\u5982\u4f55\u914d\u5c0d\u7684\u3002]"}, {"question": "\u300a\u6230\u722d\u5766\u514b\u96d9\u4eba\u6230\u300b\u4e2d\u7684\u5766\u514b\u985e\u578b\u6709\u4ec0\u9ebc\u4e3b\u8981\u5340\u5225\uff1f", "answer": "\u5728\u300a\u6230\u722d\u5766\u514b\u96d9\u4eba\u6230\u300b\u4e2d\uff0c\u5766\u514b\u985e\u578b\u7684\u901f\u5ea6\u3001\u88dd\u7532\u548c\u706b\u529b\u5404\u4e0d\u76f8\u540c\u3002\u8f15\u578b\u5766\u514b\u901f\u5ea6\u5feb\uff0c\u4f46\u88dd\u7532\u8f03\u5f31\uff0c\u800c\u91cd\u578b\u5766\u514b\u901f\u5ea6\u8f03\u6162\uff0c\u4f46\u66f4\u5805\u56fa\u3002\u4f8b\u5982\uff0c\u8f15\u578b\u5766\u514b\u53ef\u4ee5\u5feb\u901f\u5305\u6284\u6575\u4eba\uff0c\u4f46\u5fc5\u9808\u907f\u514d\u76f4\u63a5\u885d\u7a81\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6bd4\u8f03\u5766\u514b\u985e\u578b\u7684\u8868\u683c\u53ef\u4ee5\u5e6b\u52a9\u4f60\u9078\u64c7\u9069\u5408\u4f60\u904a\u6232\u98a8\u683c\u7684\u5766\u514b\u3002]"}, {"question": "\u5982\u4f55\u5728\u300a\u6230\u722d\u5766\u514b\u96d9\u4eba\u6230\u300b\u4e2d\u5c07\u6211\u7684 PC \u9032\u5ea6\u8f49\u79fb\u5230\u4e3b\u6a5f\uff1f", "answer": "\u5728\u300a\u6230\u722d\u5766\u514b\u96d9\u4eba\u6230\u300b\u4e2d\uff0c\u5c07 PC \u9032\u5ea6\u8f49\u79fb\u5230\u4e3b\u6a5f\u975e\u5e38\u7c21\u55ae\u3002\u9996\u5148\uff0c\u78ba\u4fdd\u4f60\u5728\u5169\u500b\u5e73\u53f0\u4e0a\u90fd\u767b\u9304\u540c\u4e00\u500b\u5e33\u6236\u3002\u7136\u5f8c\uff0c\u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u5c07 PC \u7684\u9032\u5ea6\u4e0a\u50b3\uff0c\u4e26\u5728\u4e3b\u6a5f\u4e0a\u4e0b\u8f09\u3002\u4f8b\u5982\uff0c\u5728 PC \u4e0a\u5b8c\u6210\u4efb\u52d9\u5f8c\uff0c\u5c07\u5132\u5b58\u6a94\u4e0a\u50b3\u5230\u4e3b\u6a5f\u4e0a\u7e7c\u7e8c\u904a\u6232\u3002[\u985e\u6bd4\u8aaa\u660e\uff1a\u5c07\u96f2\u7aef\u5132\u5b58\u60f3\u50cf\u6210\u4e00\u500b\u80cc\u5305\uff0c\u5b83\u6703\u5e36\u8457\u4f60\u7684\u9032\u5ea6\u8d70\u904d\u6240\u6709\u5730\u65b9\u3002]"}, {"question": "\u5728\u300a\u6230\u722d\u5766\u514b\u96d9\u4eba\u6230\u300b\u4e2d\uff0c\u6211\u53ef\u4ee5\u627e\u5230\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\uff1f", "answer": "\u300a\u6230\u722d\u5766\u514b\u96d9\u4eba\u6230\u300b\u6709\u4e00\u4e9b\u96b1\u85cf\u529f\u80fd\u3002\u4f8b\u5982\uff0c\u67d0\u4e9b\u5730\u5716\u4e2d\u6709\u4e00\u4e9b\u79d8\u5bc6\u5340\u57df\uff0c\u53ef\u4ee5\u63d0\u4f9b\u589e\u76ca\u9053\u5177\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u5766\u514b\u5177\u6709\u901a\u904e\u7279\u5b9a\u6309\u9215\u7d44\u5408\u6fc0\u6d3b\u7684\u96b1\u85cf\u80fd\u529b\u3002\u63a2\u7d22\u9019\u4e9b\u529f\u80fd\u53ef\u4ee5\u8b93\u4f60\u7372\u5f97\u6230\u9b25\u512a\u52e2\u3002[\u5f69\u86cb\u6316\u6398\uff1a\u767c\u73fe\u9019\u4e9b\u96b1\u85cf\u5143\u7d20\u70ba\u904a\u6232\u589e\u52a0\u4e86\u984d\u5916\u7684\u8208\u596e\u548c\u7b56\u7565\u5c64\u6b21\u3002]"}, {"question": "\u5982\u4f55\u5728\u300a\u6230\u722d\u5766\u514b\u96d9\u4eba\u6230\u300b\u4e2d\u512a\u5316\u6211\u7684\u8a2d\u5b9a\u4ee5\u7372\u5f97\u66f4\u597d\u7684\u6027\u80fd\uff1f", "answer": "\u5728\u300a\u6230\u722d\u5766\u514b\u96d9\u4eba\u6230\u300b\u4e2d\u512a\u5316\u8a2d\u5b9a\u53ef\u4ee5\u63d0\u5347\u6548\u80fd\u3002\u964d\u4f4e\u5716\u5f62\u8a2d\u5b9a\uff08\u4f8b\u5982\u7d0b\u7406\u8cea\u91cf\u548c\u9670\u5f71\u7d30\u7bc0\uff09\u53ef\u4ee5\u63d0\u9ad8\u5f31\u914d\u7f6e\u7cfb\u7d71\u7684\u5e40\u7387\u3002\u4f8b\u5982\uff0c\u5c07\u89e3\u6790\u5ea6\u5f9e 1080p \u964d\u5230 720p \u53ef\u4ee5\u986f\u8457\u63d0\u5347\u6548\u80fd\uff0c\u800c\u4e0d\u6703\u5927\u5e45\u5f71\u97ff\u8996\u89ba\u54c1\u8cea\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u8a2d\u5b9a\u6bd4\u8f03\u8868\u683c\u53ef\u4ee5\u5e6b\u52a9\u4f60\u627e\u5230\u6548\u80fd\u548c\u8996\u89ba\u6548\u679c\u4e4b\u9593\u7684\u6700\u4f73\u5e73\u8861\u3002]"}, {"question": "\u5728\u300a\u6230\u722d\u5766\u514b\u96d9\u4eba\u6230\u300b\u4e2d\u6700\u6709\u6548\u7684\u5718\u968a\u7d44\u6210\u662f\u4ec0\u9ebc\uff1f", "answer": "\u300a\u6230\u722d\u5766\u514b\u96d9\u4eba\u6230\u300b\u4e2d\u6709\u6548\u7684\u5718\u968a\u7d44\u6210\u901a\u5e38\u5305\u542b\u5404\u7a2e\u5766\u514b\u985e\u578b\u3002\u4f8b\u5982\uff0c\u5c07\u91cd\u578b\u5766\u514b\u8207\u8f15\u578b\u5766\u514b\u914d\u5c0d\u53ef\u4ee5\u63d0\u4f9b\u5805\u56fa\u6027\u548c\u901f\u5ea6\u3002\u91cd\u578b\u5766\u514b\u53ef\u4ee5\u5438\u6536\u50b7\u5bb3\uff0c\u800c\u8f15\u578b\u5766\u514b\u53ef\u4ee5\u5074\u7ffc\u653b\u64ca\u6575\u4eba\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u6bd4\u8f03\u4e0d\u540c\u7684\u5718\u968a\u7d44\u6210\u53ef\u4ee5\u5e6b\u52a9\u4f60\u4e86\u89e3\u5728\u5404\u7a2e\u60c5\u6cc1\u4e0b\u54ea\u4e9b\u7d44\u5408\u6548\u679c\u6700\u597d\u3002]"}]
[{"question": "2\uc778\uc6a9 \ud0f1\ud06c \uc804\uc7c1\uc5d0\uc11c \ud0f1\ud06c\ub97c \uc5b4\ub5bb\uac8c \uc81c\uc5b4\ud569\ub2c8\uae4c?", "answer": "2\uc778\uc6a9 \ud0f1\ud06c \uc804\uc7c1\uc5d0\uc11c \ud0f1\ud06c \uc81c\uc5b4\ub294 \uac04\ub2e8\ud569\ub2c8\ub2e4. WASD \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc804\uc9c4, \ud6c4\uc9c4 \ubc0f \uc88c\uc6b0\ub85c \ud68c\uc804\ud569\ub2c8\ub2e4. \ub9c8\uc6b0\uc2a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud3ec\ud0d1\uc744 \uc870\uc900\ud558\uace0 \uc67c\ucabd \ubc84\ud2bc\uc744 \ud074\ub9ad\ud558\uc5ec \ubc1c\uc0ac\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc801\uc744 \ud5a5\ud574 \uc804\uc9c4\ud558\uace0 \ubc1c\uc0ac\ud558\ub824\uba74 'W' \ud0a4\ub97c \ub204\ub974\uace0 \uc67c\ucabd \ubc84\ud2bc\uc744 \ud074\ub9ad\ud558\uc5ec \ubc1c\uc0ac\ud569\ub2c8\ub2e4. \uc774 \uae30\ubcf8 \uc81c\uc5b4 \ubc29\uc2dd\uc744 \ud1b5\ud574 \uc804\ud22c\uc5d0 \uc2e0\uc18d\ud558\uac8c \ucc38\uc5ec\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud0f1\ud06c\ub97c \uc790\ub3d9\ucc28\ub85c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694. \ud0a4\ub294 \uc2a4\ud2f0\uc5b4\ub9c1 \ud720\uacfc \ud398\ub2ec\uc774\uace0 \ub9c8\uc6b0\uc2a4\ub294 \uc870\uc900 \uc2dc\uc2a4\ud15c\uc785\ub2c8\ub2e4.]"}, {"question": "2\uc778\uc6a9 \ud0f1\ud06c \uc804\uc7c1\uc5d0\uc11c \uc2b9\ub9ac\ud558\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "2\uc778\uc6a9 \ud0f1\ud06c \uc804\uc7c1\uc5d0\uc11c \uc2b9\ub9ac\ub294 \uc804\uc220\uacfc \uc804\ub7b5\uc758 \uc870\ud569\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc801\uc758 \ud3ec\uaca9\uc744 \ud53c\ud558\uae30 \uc704\ud574 \ud56d\uc0c1 \uc774\ub3d9\ud558\uc138\uc694. \ub2e8\uacc4 2: \uc7a5\uc560\ubb3c \ub4a4\uc5d0 \uc228\uc5b4 \ud658\uacbd\uc744 \ud65c\uc6a9\ud558\uc138\uc694. \ub2e8\uacc4 3: \ub3d9\ub8cc\uc640 \ud611\ub825\ud558\uc5ec \uc801\uc744 \uce21\uba74 \uacf5\uaca9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud55c \uba85\uc758 \ud50c\ub808\uc774\uc5b4\uac00 \uc801\uc744 \ud63c\ub780\uc2a4\ub7fd\uac8c \ub9cc\ub4dc\ub294 \ub3d9\uc548 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub294 \uce21\uba74\uc5d0\uc11c \uacf5\uaca9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: \uc815\uba74 \uacf5\uaca9\uacfc \ube44\uad50\ud558\uc5ec \uce21\uba74 \uacf5\uaca9\uc740 \uc801\uc744 \ub2f9\ud669\uc2dc\ud0a4\uace0 \uc5ed\uacf5\uc744 \ucde8\ud560 \ub2a5\ub825\uc744 \uc57d\ud654\uc2dc\ud0a4\uae30 \ub54c\ubb38\uc5d0 \ub354 \ud6a8\uacfc\uc801\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "\uc65c 2\uc778\uc6a9 \ud0f1\ud06c \uc804\uc7c1\uc5d0\uc11c \ud0f1\ud06c\uac00 \ub54c\ub54c\ub85c \ub354 \ub9ce\uc740 \ud53c\ud574\ub97c \uc785\uc2b5\ub2c8\uae4c?", "answer": "2\uc778\uc6a9 \ud0f1\ud06c \uc804\uc7c1\uc5d0\uc11c \ud0f1\ud06c\uac00 \ub354 \ub9ce\uc740 \ud53c\ud574\ub97c \uc785\ub294 \uc774\uc720\ub294 \uc5ec\ub7ec \uac00\uc9c0 \uc694\uc778 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uccab\uc9f8, \ub2e4\ub978 \uc801\uc758 \ubb34\uae30\ub294 \ub2e4\uc591\ud55c \ud53c\ud574 \uc218\uc900\uc744 \uac16\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub85c\ucf13 \ubc1c\uc0ac\uae30\ub294 \uae30\uad00\ucd1d\ubcf4\ub2e4 \ub354 \ud070 \ud53c\ud574\ub97c \uc785\ud799\ub2c8\ub2e4. \ub458\uc9f8, \ucda9\ub3cc \uac01\ub3c4\ub294 \ud53c\ud574\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ud0f1\ud06c\uc758 \uce21\uba74\uc774\ub098 \ud6c4\uba74\uc744 \ub9de\uc740 \ucd1d\uc54c\uc740 \uc804\uba74\uc744 \ub9de\uc740 \ucd1d\uc54c\ubcf4\ub2e4 \ub354 \ud070 \ud53c\ud574\ub97c \uc785\ud799\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \ubb34\uae30 \uc720\ud615\uacfc \ud53c\ud574 \uc218\uc900\uc744 \ube44\uad50\ud558\ub294 \ud45c\ub294 \uc5b4\ub5a4 \uc801\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uacf5\uaca9\ud574\uc57c \ud558\ub294\uc9c0 \uc774\ud574\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4.]"}, {"question": "2\uc778\uc6a9 \ud0f1\ud06c \uc804\uc7c1\uc5d0\uc11c \uc5b4\ub5a4 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "2\uc778\uc6a9 \ud0f1\ud06c \uc804\uc7c1\uc5d0\uc11c \uc5c5\uadf8\ub808\uc774\ub4dc \uc6b0\uc120\uc21c\uc704\ub294 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. \uacf5\uaca9\uc801\uc778 \ud50c\ub808\uc774\ub97c \uc120\ud638\ud55c\ub2e4\uba74 \ud654\ub825\uacfc \uc18d\ub3c4 \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0 \uc9d1\uc911\ud558\uc138\uc694. \ubc29\uc5b4\uc801\uc778 \ud50c\ub808\uc774\uc5b4\ub77c\uba74 \uc7a5\uac11\uacfc \uccb4\ub825 \uc5c5\uadf8\ub808\uc774\ub4dc\uac00 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud3ec\ud0d1 \ud68c\uc804 \uc18d\ub3c4\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uba74 \ube60\ub978 \uc870\uc900\uc774 \uac00\ub2a5\ud574\uc838 \ube60\ub974\uac8c \uc9c4\ud589\ub418\ub294 \uc804\ud22c\uc5d0\uc11c \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: \uc5c5\uadf8\ub808\uc774\ub4dc \uacbd\ub85c\ub97c \ube44\uad50\ud558\uba74 \uc804\ub7b5\uc5d0 \ub530\ub77c \uacf5\uaca9\ub825\uc744 \uac15\ud654\ud560\uc9c0 \ubc29\uc5b4\ub825\uc744 \uac15\ud654\ud560\uc9c0 \uacb0\uc815\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4.]"}, {"question": "2\uc778\uc6a9 \ud0f1\ud06c \uc804\uc7c1\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "2\uc778\uc6a9 \ud0f1\ud06c \uc804\uc7c1\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uc758 \uc2e4\ub825\uacfc \ud50c\ub808\uc774 \uc2dc\uac04\uc744 \uae30\ubc18\uc73c\ub85c \ud50c\ub808\uc774\uc5b4\ub97c \ud398\uc5b4\ub9c1\ud569\ub2c8\ub2e4. \uc774\ub294 \uc2b9/\ud328 \ube44\uc728\uacfc \ucd5c\uadfc \uc131\uacfc\ub97c \uace0\ub824\ud558\ub294 \uc54c\uace0\ub9ac\uc998\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc9c0\uc18d\uc801\uc73c\ub85c \uc2b9\ub9ac\ud558\ub294 \uacbd\uc6b0 \uade0\ud615 \uc7a1\ud78c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 \ube44\uc2b7\ud55c \uc2e4\ub825\uc758 \ud50c\ub808\uc774\uc5b4\uc640 \ub9e4\uce6d\ub420 \uac83\uc785\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \ud50c\ub808\uc774\uc5b4 \ub9e4\uce6d \uacfc\uc815\uc744 \uc2dc\uac01\ud654\ud558\ub294 \ud750\ub984\ub3c4\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uc5b4\ub5bb\uac8c \ud398\uc5b4\ub9c1\ub418\ub294\uc9c0 \uc774\ud574\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "2\uc778\uc6a9 \ud0f1\ud06c \uc804\uc7c1\uc758 \ud0f1\ud06c \ud074\ub798\uc2a4 \uac04\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "2\uc778\uc6a9 \ud0f1\ud06c \uc804\uc7c1\uc5d0\uc11c \ud0f1\ud06c \ud074\ub798\uc2a4\ub294 \uc18d\ub3c4, \uc7a5\uac11 \ubc0f \ud654\ub825\uc774 \ub2e4\ub985\ub2c8\ub2e4. \uacbd\uc804\ucc28\ub294 \ube60\ub974\uc9c0\ub9cc \uc7a5\uac11\uc774 \uc57d\ud558\uace0 \uc911\uc804\ucc28\ub294 \ub290\ub9ac\uc9c0\ub9cc \ub354 \ub0b4\uad6c\uc131\uc774 \ub192\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uacbd\uc804\ucc28\ub294 \uc801\uc744 \uc2e0\uc18d\ud558\uac8c \uce21\uba74 \uacf5\uaca9\ud560 \uc218 \uc788\uc9c0\ub9cc \uc9c1\uc811\uc801\uc778 \ucda9\ub3cc\uc744 \ud53c\ud574\uc57c \ud569\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \ud0f1\ud06c \ud074\ub798\uc2a4\ub97c \ube44\uad50\ud558\ub294 \ud45c\ub294 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \uc801\ud569\ud55c \ud0f1\ud06c\ub97c \uc120\ud0dd\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4.]"}, {"question": "2\uc778\uc6a9 \ud0f1\ud06c \uc804\uc7c1\uc5d0\uc11c PC \uc9c4\ud589 \uc0c1\ud669\uc744 \ucf58\uc194\ub85c \uc804\uc1a1\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "2\uc778\uc6a9 \ud0f1\ud06c \uc804\uc7c1\uc5d0\uc11c PC \uc9c4\ud589 \uc0c1\ud669\uc744 \ucf58\uc194\ub85c \uc804\uc1a1\ud558\ub294 \uac83\uc740 \uac04\ub2e8\ud569\ub2c8\ub2e4. \uba3c\uc800 \ub450 \ud50c\ub7ab\ud3fc \ubaa8\ub450\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uadf8\ub7f0 \ub2e4\uc74c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec PC\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5c5\ub85c\ub4dc\ud558\uace0 \ucf58\uc194\uc5d0\uc11c \ub2e4\uc6b4\ub85c\ub4dc\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ubbf8\uc158\uc744 \uc644\ub8cc\ud55c \ud6c4 \ucf58\uc194\uc5d0\uc11c \uacc4\uc18d\ud558\uae30 \uc704\ud574 \uc800\uc7a5 \ud30c\uc77c\uc744 \uc5c5\ub85c\ub4dc\ud558\uc2ed\uc2dc\uc624. [\ube44\uc720 \uc124\uba85: \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc740 \uc5b4\ub514\ub4e0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uac00\uc838\uac08 \uc218 \uc788\ub294 \ubc30\ub0ad\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "2\uc778\uc6a9 \ud0f1\ud06c \uc804\uc7c1\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "2\uc778\uc6a9 \ud0f1\ud06c \uc804\uc7c1\uc5d0\ub294 \uc5ec\ub7ec \uac00\uc9c0 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud2b9\uc815 \ub9f5\uc5d0\ub294 \ud30c\uc6cc\uc5c5\uc744 \uc81c\uacf5\ud558\ub294 \ube44\ubc00 \uc601\uc5ed\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uc77c\ubd80 \ud0f1\ud06c\ub294 \ud2b9\uc815 \ubc84\ud2bc \uc870\ud569\uc73c\ub85c \ud65c\uc131\ud654\ub418\ub294 \uc228\uaca8\uc9c4 \ub2a5\ub825\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uae30\ub2a5\uc744 \ud0d0\uc0c9\ud558\uba74 \uc804\ud22c\uc5d0\uc11c \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc228\uaca8\uc9c4 \uae30\ub2a5 \ubc1c\uacac: \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uc694\uc18c\ub97c \ubc1c\uacac\ud558\ub294 \uac83\uc740 \uac8c\uc784\uc5d0 \ucd94\uac00\uc801\uc778 \ud765\ubd84\uacfc \uc804\ub7b5\uc744 \ub354\ud569\ub2c8\ub2e4.]"}, {"question": "2\uc778\uc6a9 \ud0f1\ud06c \uc804\uc7c1\uc5d0\uc11c \uc131\ub2a5 \ud5a5\uc0c1\uc744 \uc704\ud55c \uc124\uc815\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "2\uc778\uc6a9 \ud0f1\ud06c \uc804\uc7c1\uc5d0\uc11c \uc124\uc815\uc744 \ucd5c\uc801\ud654\ud558\uba74 \uc131\ub2a5\uc774 \ud5a5\uc0c1\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud14d\uc2a4\ucc98 \ud488\uc9c8 \ubc0f \uadf8\ub9bc\uc790 \ub514\ud14c\uc77c\uacfc \uac19\uc740 \uadf8\ub798\ud53d \uc124\uc815\uc744 \ub0ae\ucd94\uba74 \uc800\uc0ac\uc591 \uc2dc\uc2a4\ud15c\uc5d0\uc11c \ud504\ub808\uc784 \uc18d\ub3c4\ub97c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 1080p\uc5d0\uc11c 720p\ub85c \ud574\uc0c1\ub3c4\ub97c \ub0ae\ucd94\uba74 \uc2dc\uac01\uc801 \ud488\uc9c8\uc740 \ud06c\uac8c \ub5a8\uc5b4\uc9c0\uc9c0 \uc54a\uc73c\uba74\uc11c \uc131\ub2a5\uc744 \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \uc124\uc815 \ube44\uad50\ud45c\ub294 \uc131\ub2a5\uacfc \uc2dc\uac01\uc801 \ud488\uc9c8 \uc0ac\uc774\uc5d0\uc11c \ucd5c\uc0c1\uc758 \uade0\ud615\uc744 \ucc3e\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4.]"}, {"question": "2\uc778\uc6a9 \ud0f1\ud06c \uc804\uc7c1\uc5d0\uc11c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ud300 \uad6c\uc131\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "2\uc778\uc6a9 \ud0f1\ud06c \uc804\uc7c1\uc5d0\uc11c \ud6a8\uacfc\uc801\uc778 \ud300 \uad6c\uc131\uc740 \uc885\uc885 \ub2e4\uc591\ud55c \ud0f1\ud06c \ud074\ub798\uc2a4\ub97c \ud3ec\ud568\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc911\uc804\ucc28\uc640 \uacbd\uc804\ucc28\ub97c \ud568\uaed8 \uc0ac\uc6a9\ud558\uba74 \ub0b4\uad6c\uc131\uacfc \uc18d\ub3c4\ub97c \ubaa8\ub450 \uc81c\uacf5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc911\uc804\ucc28\ub294 \ud53c\ud574\ub97c \ud761\uc218\ud558\uace0 \uacbd\uc804\ucc28\ub294 \uc801\uc744 \uce21\uba74 \uacf5\uaca9\ud569\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: \ub2e4\uc591\ud55c \ud300 \uad6c\uc131\uc744 \ube44\uad50\ud558\uba74 \ub2e4\uc591\ud55c \uc0c1\ud669\uc5d0\uc11c \uac00\uc7a5 \uc801\ud569\ud55c \uc870\ud569\uc744 \uc774\ud574\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4.]"}]
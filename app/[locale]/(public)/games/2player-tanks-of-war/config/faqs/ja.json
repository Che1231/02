[{"question": "\u5bfe\u6226\u8eca\u6226\u8eca\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u7248\u3067\u3001\u79c1\u306e\u6226\u8eca\u3092\u3069\u306e\u3088\u3046\u306b\u5236\u5fa1\u3057\u307e\u3059\u304b\uff1f", "answer": "\u5bfe\u6226\u8eca\u6226\u8eca\u306e2\u4eba\u30d7\u30ec\u30a4\u7248\u3067\u306f\u3001\u6226\u8eca\u306e\u5236\u5fa1\u306f\u7c21\u5358\u3067\u3059\u3002WASD\u30ad\u30fc\u3092\u4f7f\u7528\u3057\u3066\u524d\u9032\u3001\u5f8c\u9000\u3001\u5de6\u307e\u305f\u306f\u53f3\u306b\u65cb\u56de\u3057\u307e\u3059\u3002\u30de\u30a6\u30b9\u3092\u4f7f\u7528\u3057\u3066\u7832\u5854\u3092\u7167\u6e96\u3057\u3001\u5de6\u30af\u30ea\u30c3\u30af\u3067\u767a\u5c04\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u524d\u9032\u3057\u3066\u6575\u3092\u653b\u6483\u3059\u308b\u306b\u306f\u3001\u300eW\u300f\u30ad\u30fc\u3092\u62bc\u3057\u3066\u524d\u9032\u3057\u3001\u5de6\u30af\u30ea\u30c3\u30af\u3067\u5c04\u6483\u3057\u307e\u3059\u3002\u3053\u306e\u57fa\u672c\u7684\u306a\u5236\u5fa1\u30b9\u30ad\u30fc\u30e0\u306b\u3088\u308a\u3001\u8fc5\u901f\u306b\u6226\u95d8\u306b\u53c2\u52a0\u3067\u304d\u307e\u3059\u3002[\u4f8b\uff1a\u6226\u8eca\u3092\u8eca\u306b\u4f8b\u3048\u308b\u3068\u3001\u30ad\u30fc\u306f\u30cf\u30f3\u30c9\u30eb\u3068\u30da\u30c0\u30eb\u3001\u30de\u30a6\u30b9\u306f\u7167\u6e96\u30b7\u30b9\u30c6\u30e0\u3067\u3059\u3002]"}, {"question": "\u5bfe\u6226\u8eca\u6226\u8eca\u306e2\u4eba\u30d7\u30ec\u30a4\u7248\u3067\u52dd\u5229\u3059\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u5bfe\u6226\u8eca\u6226\u8eca\u306e2\u4eba\u30d7\u30ec\u30a4\u7248\u3067\u52dd\u5229\u3059\u308b\u306b\u306f\u3001\u6226\u8853\u3068\u6226\u7565\u306e\u7d44\u307f\u5408\u308f\u305b\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6575\u306e\u653b\u6483\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u5e38\u306b\u79fb\u52d5\u3057\u7d9a\u3051\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u969c\u5bb3\u7269\u306e\u5f8c\u308d\u306b\u96a0\u308c\u308b\u3053\u3068\u3067\u74b0\u5883\u3092\u6700\u5927\u9650\u306b\u6d3b\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6575\u3092\u5074\u9762\u653b\u6483\u3059\u308b\u305f\u3081\u306b\u30c1\u30fc\u30e0\u30e1\u30a4\u30c8\u3068\u9023\u643a\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u4e00\u65b9\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u6575\u306e\u6ce8\u610f\u3092\u5f15\u304d\u3064\u3051\u306a\u304c\u3089\u3001\u3082\u3046\u4e00\u65b9\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u5074\u9762\u304b\u3089\u653b\u6483\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u6b63\u9762\u653b\u6483\u3068\u6bd4\u3079\u3066\u3001\u5074\u9762\u653b\u6483\u306f\u6575\u3092\u6df7\u4e71\u3055\u305b\u3001\u6575\u306e\u53cd\u6483\u80fd\u529b\u3092\u4f4e\u4e0b\u3055\u305b\u308b\u305f\u3081\u3001\u3088\u308a\u52b9\u679c\u7684\u3067\u3059\u3002]"}, {"question": "\u5bfe\u6226\u8eca\u6226\u8eca\u3067\u3001\u306a\u305c\u6226\u8eca\u304c\u6642\u3005\u3088\u308a\u591a\u304f\u306e\u30c0\u30e1\u30fc\u30b8\u3092\u53d7\u3051\u308b\u306e\u3067\u3059\u304b\uff1f", "answer": "\u5bfe\u6226\u8eca\u6226\u8eca\u3067\u6226\u8eca\u304c\u3088\u308a\u591a\u304f\u306e\u30c0\u30e1\u30fc\u30b8\u3092\u53d7\u3051\u308b\u7406\u7531\u306f\u3044\u304f\u3064\u304b\u3042\u308a\u307e\u3059\u3002\u307e\u305a\u3001\u6575\u306e\u6b66\u5668\u306e\u7a2e\u985e\u306b\u3088\u3063\u3066\u4e0e\u3048\u308b\u30c0\u30e1\u30fc\u30b8\u91cf\u304c\u7570\u306a\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ed\u30b1\u30c3\u30c8\u30e9\u30f3\u30c1\u30e3\u30fc\u306f\u6a5f\u95a2\u9283\u3088\u308a\u3082\u5927\u304d\u306a\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u307e\u3059\u3002\u7b2c\u4e8c\u306b\u3001\u88ab\u5f3e\u89d2\u5ea6\u306f\u30c0\u30e1\u30fc\u30b8\u306b\u5f71\u97ff\u3057\u307e\u3059\u3002\u6226\u8eca\u306e\u5074\u9762\u3084\u5f8c\u90e8\u3092\u76f4\u6483\u3059\u308b\u5f3e\u4e38\u306f\u3001\u6b63\u9762\u3092\u76f4\u6483\u3059\u308b\u5f3e\u4e38\u3088\u308a\u3082\u3088\u308a\u5927\u304d\u306a\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u307e\u3059\u3002[\u6bd4\u8f03\u8868\uff1a\u6b66\u5668\u306e\u7a2e\u985e\u3068\u305d\u306e\u30c0\u30e1\u30fc\u30b8\u91cf\u3092\u6bd4\u8f03\u3057\u305f\u8868\u304c\u3042\u308c\u3070\u3001\u3069\u306e\u6575\u3092\u512a\u5148\u3059\u3079\u304d\u304b\u304c\u5206\u304b\u308a\u307e\u3059\u3002]"}, {"question": "\u5bfe\u6226\u8eca\u6226\u8eca2\u4eba\u30d7\u30ec\u30a4\u7248\u3067\u512a\u5148\u3059\u3079\u304d\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u5bfe\u6226\u8eca\u6226\u8eca2\u4eba\u30d7\u30ec\u30a4\u7248\u3067\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306e\u512a\u5148\u9806\u4f4d\u306f\u3001\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u3002\u653b\u6483\u7684\u306a\u30d7\u30ec\u30a4\u3092\u597d\u3080\u5834\u5408\u306f\u3001\u706b\u529b\u3068\u901f\u5ea6\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u304f\u3060\u3055\u3044\u3002\u9632\u5fa1\u7684\u306a\u30d7\u30ec\u30a4\u3092\u597d\u3080\u5834\u5408\u306f\u3001\u88c5\u7532\u3068\u4f53\u529b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u304c\u91cd\u8981\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u7832\u5854\u306e\u65cb\u56de\u901f\u5ea6\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3068\u3001\u8fc5\u901f\u306b\u7167\u6e96\u3092\u5408\u308f\u305b\u3089\u308c\u308b\u305f\u3081\u3001\u30da\u30fc\u30b9\u306e\u901f\u3044\u6226\u95d8\u3067\u6709\u5229\u306b\u306a\u308a\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u30d1\u30b9\u3092\u6bd4\u8f03\u3059\u308b\u3068\u3001\u6226\u7565\u306b\u5fdc\u3058\u3066\u653b\u6483\u304b\u9632\u5fa1\u3092\u5f37\u5316\u3059\u3079\u304d\u304b\u304c\u5206\u304b\u308a\u307e\u3059\u3002]"}, {"question": "\u5bfe\u6226\u8eca\u6226\u8eca\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u5bfe\u6226\u8eca\u6226\u8eca\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u3068\u30d7\u30ec\u30a4\u6642\u9593\u306b\u57fa\u3065\u3044\u3066\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u30da\u30a2\u30ea\u30f3\u30b0\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u3042\u306a\u305f\u306e\u52dd\u6557\u7387\u3068\u6700\u8fd1\u306e\u6210\u7e3e\u3092\u8003\u616e\u3057\u305f\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u3092\u4f7f\u7528\u3057\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u3042\u306a\u305f\u304c\u4e00\u8cab\u3057\u3066\u52dd\u5229\u3057\u3066\u3044\u308b\u5834\u5408\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u53d6\u308c\u305f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u78ba\u4fdd\u3059\u308b\u305f\u3081\u306b\u3001\u540c\u69d8\u306e\u30b9\u30ad\u30eb\u3092\u6301\u3064\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u30de\u30c3\u30c1\u30f3\u30b0\u3055\u308c\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u3069\u306e\u3088\u3046\u306b\u30da\u30a2\u30ea\u30f3\u30b0\u3055\u308c\u308b\u304b\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30d7\u30ed\u30bb\u30b9\u3092\u793a\u3059\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u304c\u3042\u308a\u307e\u3059\u3002]"}, {"question": "\u5bfe\u6226\u8eca\u6226\u8eca\u306e\u6226\u8eca\u30af\u30e9\u30b9\u9593\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u5bfe\u6226\u8eca\u6226\u8eca\u3067\u306f\u3001\u6226\u8eca\u30af\u30e9\u30b9\u306f\u901f\u5ea6\u3001\u88c5\u7532\u3001\u706b\u529b\u306e\u89b3\u70b9\u3067\u7570\u306a\u308a\u307e\u3059\u3002\u8efd\u6226\u8eca\u306f\u901f\u3044\u3067\u3059\u304c\u88c5\u7532\u306f\u5f31\u304f\u3001\u91cd\u6226\u8eca\u306f\u9045\u3044\u3067\u3059\u304c\u8010\u4e45\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u8efd\u6226\u8eca\u306f\u6575\u3092\u8fc5\u901f\u306b\u5074\u9762\u653b\u6483\u3067\u304d\u307e\u3059\u304c\u3001\u6b63\u9762\u885d\u7a81\u3092\u907f\u3051\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002[\u6bd4\u8f03\u8868\uff1a\u6226\u8eca\u30af\u30e9\u30b9\u3092\u6bd4\u8f03\u3057\u305f\u8868\u304c\u3042\u308c\u3070\u3001\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u5408\u3063\u305f\u6226\u8eca\u3092\u9078\u3076\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002]"}, {"question": "\u5bfe\u6226\u8eca\u6226\u8eca2\u4eba\u30d7\u30ec\u30a4\u7248\u3067PC\u7248\u306e\u9032\u6357\u72b6\u6cc1\u3092\u30b3\u30f3\u30bd\u30fc\u30eb\u7248\u306b\u79fb\u884c\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u5bfe\u6226\u8eca\u6226\u8eca2\u4eba\u30d7\u30ec\u30a4\u7248\u3067PC\u7248\u306e\u9032\u6357\u72b6\u6cc1\u3092\u30b3\u30f3\u30bd\u30fc\u30eb\u7248\u306b\u79fb\u884c\u3059\u308b\u306b\u306f\u7c21\u5358\u3067\u3059\u3002\u307e\u305a\u3001\u4e21\u65b9\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6b21\u306b\u3001\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066PC\u7248\u306e\u9032\u6357\u72b6\u6cc1\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3057\u3001\u30b3\u30f3\u30bd\u30fc\u30eb\u7248\u306b\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001PC\u7248\u3067\u30df\u30c3\u30b7\u30e7\u30f3\u3092\u5b8c\u4e86\u3057\u305f\u3089\u3001\u30b3\u30f3\u30bd\u30fc\u30eb\u7248\u3067\u7d9a\u884c\u3059\u308b\u305f\u3081\u306b\u4fdd\u5b58\u30c7\u30fc\u30bf\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002[\u4f8b\uff1a\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u3001\u9032\u6357\u72b6\u6cc1\u3092\u3069\u3053\u3078\u3067\u3082\u6301\u3061\u904b\u3076\u305f\u3081\u306e\u30d0\u30c3\u30af\u30d1\u30c3\u30af\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u5bfe\u6226\u8eca\u6226\u8eca\u3067\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u5bfe\u6226\u8eca\u6226\u8eca\u306b\u306f\u3044\u304f\u3064\u304b\u306e\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u7279\u5b9a\u306e\u30de\u30c3\u30d7\u306b\u306f\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u3092\u63d0\u4f9b\u3059\u308b\u79d8\u5bc6\u306e\u30a8\u30ea\u30a2\u304c\u3042\u308a\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u4e00\u90e8\u306e\u6226\u8eca\u306b\u306f\u3001\u7279\u5b9a\u306e\u30dc\u30bf\u30f3\u306e\u7d44\u307f\u5408\u308f\u305b\u306b\u3088\u3063\u3066\u6d3b\u6027\u5316\u3055\u308c\u308b\u96a0\u3055\u308c\u305f\u80fd\u529b\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u6a5f\u80fd\u3092\u63a2\u6c42\u3059\u308b\u3053\u3068\u3067\u3001\u6226\u95d8\u3067\u512a\u4f4d\u306b\u7acb\u3064\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u96a0\u308c\u305f\u8981\u7d20\uff1a\u3053\u308c\u3089\u306e\u96a0\u308c\u305f\u8981\u7d20\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u306b\u3055\u3089\u306b\u8208\u596e\u3068\u6226\u7565\u6027\u304c\u5897\u3057\u307e\u3059\u3002]"}, {"question": "\u5bfe\u6226\u8eca\u6226\u8eca\u3067\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u306b\u3001\u8a2d\u5b9a\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u5bfe\u6226\u8eca\u6226\u8eca\u3067\u8a2d\u5b9a\u3092\u6700\u9069\u5316\u3059\u308b\u3053\u3068\u3067\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30c6\u30af\u30b9\u30c1\u30e3\u54c1\u8cea\u3084\u5f71\u306e\u8a73\u7d30\u306a\u3069\u306e\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u30b9\u8a2d\u5b9a\u3092\u4e0b\u3052\u308b\u3068\u3001\u4f4e\u30a8\u30f3\u30c9\u306e\u30b7\u30b9\u30c6\u30e0\u3067\u3082\u30d5\u30ec\u30fc\u30e0\u30ec\u30fc\u30c8\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u89e3\u50cf\u5ea6\u30921080p\u304b\u3089720p\u306b\u4e0b\u3052\u308b\u3068\u3001\u8996\u899a\u7684\u306a\u8cea\u3092\u5927\u304d\u304f\u640d\u306a\u3046\u3053\u3068\u306a\u304f\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03\u8868\uff1a\u8a2d\u5b9a\u3092\u6bd4\u8f03\u3059\u308b\u8868\u304c\u3042\u308c\u3070\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3068\u8996\u899a\u54c1\u8cea\u306e\u6700\u9069\u306a\u30d0\u30e9\u30f3\u30b9\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002]"}, {"question": "\u5bfe\u6226\u8eca\u6226\u8eca2\u4eba\u30d7\u30ec\u30a4\u7248\u3067\u6700\u3082\u52b9\u679c\u7684\u306a\u30c1\u30fc\u30e0\u69cb\u6210\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u5bfe\u6226\u8eca\u6226\u8eca2\u4eba\u30d7\u30ec\u30a4\u7248\u3067\u52b9\u679c\u7684\u306a\u30c1\u30fc\u30e0\u69cb\u6210\u306f\u3001\u591a\u304f\u306e\u5834\u5408\u3001\u3055\u307e\u3056\u307e\u306a\u6226\u8eca\u30af\u30e9\u30b9\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u542b\u307f\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u91cd\u6226\u8eca\u3068\u8efd\u6226\u8eca\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3001\u8010\u4e45\u6027\u3068\u901f\u5ea6\u306e\u4e21\u65b9\u3092\u5099\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u91cd\u6226\u8eca\u306f\u30c0\u30e1\u30fc\u30b8\u3092\u5438\u53ce\u3057\u3001\u8efd\u6226\u8eca\u306f\u6575\u3092\u5074\u9762\u653b\u6483\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u3055\u307e\u3056\u307e\u306a\u30c1\u30fc\u30e0\u69cb\u6210\u3092\u6bd4\u8f03\u3059\u308b\u3053\u3068\u3067\u3001\u3055\u307e\u3056\u307e\u306a\u30b7\u30ca\u30ea\u30aa\u3067\u6700\u9069\u306a\u7d44\u307f\u5408\u308f\u305b\u304c\u5206\u304b\u308a\u307e\u3059\u3002]"}]
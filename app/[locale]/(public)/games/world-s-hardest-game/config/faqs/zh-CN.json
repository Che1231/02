[{"question": "\u521d\u5b66\u8005\u5982\u4f55\u6709\u6548\u63a7\u5236\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f\u300b\u4e2d\u7684\u89d2\u8272\uff1f", "answer": "\u8981\u6709\u6548\u63a7\u5236\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f\u300b\u4e2d\u7684\u89d2\u8272\uff0c\u9996\u5148\u8981\u638c\u63e1\u57fa\u672c\u79fb\u52a8\u3002\u4f7f\u7528\u65b9\u5411\u952e\u8fdb\u884c\u7cbe\u786e\u79fb\u52a8\u3002\u4f8b\u5982\uff0c\u57281\u7ea7\uff0c\u7ec3\u4e60\u5c11\u91cf\u79fb\u52a8\u89d2\u8272\u4ee5\u907f\u514d\u7ea2\u8272\u70b9\u3002\u6b65\u9aa41\uff1a\u7f13\u6162\u79fb\u52a8\u5e76\u89c2\u5bdf\u969c\u788d\u7269\u7684\u79fb\u52a8\u89c4\u5f8b\u3002\u6b65\u9aa42\uff1a\u5728\u95f4\u9699\u5bf9\u9f50\u65f6\uff0c\u8c03\u6574\u4f60\u7684\u79fb\u52a8\u65f6\u95f4\u3002\u6b65\u9aa43\uff1a\u91cd\u590d\u8be5\u5173\u5361\uff0c\u5efa\u7acb\u808c\u8089\u8bb0\u5fc6\u3002\u6b64\u65b9\u6cd5\u6709\u52a9\u4e8e\u7406\u89e3\u6e38\u620f\u7684\u673a\u5236\u5e76\u63d0\u9ad8\u4f60\u7684\u53cd\u5e94\u65f6\u95f4\u3002"}, {"question": "\u5728\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f\u300b\u4e2d\u5b8c\u62105\u7ea7\u6709\u54ea\u4e9b\u5fc5\u5907\u7b56\u7565\uff1f", "answer": "\u5728\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f\u300b\u4e2d\u5b8c\u62105\u7ea7\u9700\u8981\u6218\u7565\u89c4\u5212\u548c\u7cbe\u786e\u6267\u884c\u3002\u6b65\u9aa41\uff1a\u5206\u6790\u84dd\u8272\u548c\u7ea2\u8272\u70b9\u7684\u79fb\u52a8\u6a21\u5f0f\u3002\u6b65\u9aa42\uff1a\u901a\u8fc7\u8c03\u6574\u79fb\u52a8\u65f6\u95f4\u4ee5\u907f\u514d\u78b0\u649e\uff0c\u627e\u5230\u6700\u5b89\u5168\u7684\u8def\u5f84\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u5c4f\u5e55\u89d2\u843d\u6682\u505c\u5e76\u91cd\u65b0\u8bc4\u4f30\u4f60\u7684\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u5728\u4e00\u4e2a\u90e8\u5206\uff0c\u7b49\u5f85\u84dd\u8272\u70b9\u79fb\u52a8\u5f00\u540e\u518d\u524d\u8fdb\u81f3\u5173\u91cd\u8981\u3002\u8fd9\u79cd\u65b9\u6cd5\u6700\u5927\u9650\u5ea6\u5730\u964d\u4f4e\u98ce\u9669\uff0c\u5e76\u589e\u52a0\u6210\u529f\u7684\u51e0\u7387\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u65f6\u95f4\u5728\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f\u300b\u4e2d\u81f3\u5173\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u63d0\u9ad8\u65f6\u95f4\u63a7\u5236\u80fd\u529b\uff1f", "answer": "\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f\u300b\u4e2d\u65f6\u95f4\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u969c\u788d\u7269\u4ee5\u53ef\u9884\u6d4b\u7684\u6a21\u5f0f\u79fb\u52a8\u3002\u8981\u63d0\u9ad8\u4f60\u7684\u65f6\u95f4\u63a7\u5236\u80fd\u529b\uff0c\u7ec3\u4e60\u5c06\u4f60\u7684\u79fb\u52a8\u4e0e\u969c\u788d\u7269\u7684\u8282\u594f\u540c\u6b65\u3002\u4f8b\u5982\uff0c\u57283\u7ea7\uff0c\u89c2\u5bdf\u7ea2\u8272\u70b9\u5982\u4f55\u4ee5\u5706\u5f62\u6a21\u5f0f\u79fb\u52a8\uff0c\u5e76\u76f8\u5e94\u5730\u8c03\u6574\u4f60\u7684\u524d\u8fdb\u65f6\u95f4\u3002\u6b65\u9aa41\uff1a\u5728\u79fb\u52a8\u4e4b\u524d\u89c2\u5bdf\u969c\u788d\u7269\u6a21\u5f0f\u51e0\u79d2\u949f\u3002\u6b65\u9aa42\uff1a\u5728\u8def\u5f84\u6e05\u6670\u7684\u77ed\u6682\u7a97\u53e3\u79fb\u52a8\u3002\u6b65\u9aa43\uff1a\u91cd\u590d\u8be5\u5173\u5361\uff0c\u5b8c\u5584\u4f60\u7684\u65f6\u95f4\u63a7\u5236\u6280\u80fd\u3002\u6b64\u65b9\u6cd5\u6709\u52a9\u4e8e\u9884\u6d4b\u79fb\u52a8\u5e76\u51cf\u5c11\u9519\u8bef\u3002"}, {"question": "\u54ea\u4e9b\u9ad8\u7ea7\u6280\u5de7\u53ef\u4ee5\u5e2e\u52a9\u6211\u5728\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f\u300b\u4e2d\u5e94\u5bf9\u66f4\u590d\u6742\u7684\u5173\u5361\uff1f", "answer": "\u5728\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f\u300b\u4e2d\u5e94\u5bf9\u590d\u6742\u5173\u5361\u7684\u9ad8\u7ea7\u6280\u5de7\u5305\u62ec\u6a21\u5f0f\u8bc6\u522b\u548c\u8def\u5f84\u4f18\u5316\u3002\u6b65\u9aa41\uff1a\u7814\u7a76\u5173\u5361\u4e2d\u6240\u6709\u969c\u788d\u7269\u7684\u79fb\u52a8\u6a21\u5f0f\u3002\u6b65\u9aa42\uff1a\u901a\u8fc7\u8ba1\u7b97\u6bcf\u4e2a\u969c\u788d\u7269\u7684\u65f6\u95f4\uff0c\u786e\u5b9a\u6700\u5b89\u5168\u7684\u8def\u5f84\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u5feb\u901f\u7684\u7bad\u5934\u952e\u6309\u538b\u8fdb\u884c\u7cbe\u7ec6\u63a7\u5236\uff0c\u4ee5\u7cbe\u786e\u5730\u6267\u884c\u4f60\u7684\u79fb\u52a8\u3002\u4f8b\u5982\uff0c\u572810\u7ea7\uff0c\u4f7f\u7528\u6b64\u6280\u5de7\u53ef\u4ee5\u5e2e\u52a9\u4f60\u9ad8\u6548\u5730\u7a7f\u8fc7\u79fb\u52a8\u969c\u788d\u7269\u7684\u8ff7\u5bab\u3002\u8fd9\u79cd\u65b9\u6cd5\u5bf9\u4e8e\u638c\u63e1\u6e38\u620f\u66f4\u96be\u7684\u5173\u5361\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f\u300b\u4e2d\u7684\u5f97\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u6700\u7ec8\u5f97\u5206\uff1f", "answer": "\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f\u300b\u4e2d\u7684\u5f97\u5206\u7cfb\u7edf\u57fa\u4e8e\u5b8c\u6210\u6bcf\u4e2a\u5173\u5361\u6240\u9700\u79fb\u52a8\u6b21\u6570\u548c\u65f6\u95f4\u3002\u6b65\u9aa41\uff1a\u901a\u8fc7\u627e\u5230\u6700\u6709\u6548\u7684\u8def\u5f84\u6765\u6700\u5c0f\u5316\u79fb\u52a8\u6b21\u6570\u3002\u6b65\u9aa42\uff1a\u5728\u4e0d\u72af\u9519\u8bef\u7684\u60c5\u51b5\u4e0b\u5c3d\u5feb\u5b8c\u6210\u5173\u5361\u3002\u6b65\u9aa43\uff1a\u907f\u514d\u4e0d\u5fc5\u8981\u7684\u6682\u505c\u6216\u540e\u9000\u3002\u4f8b\u5982\uff0c\u57287\u7ea7\uff0c\u5728\u66f4\u5c11\u7684\u79fb\u52a8\u6b21\u6570\u548c\u66f4\u77ed\u7684\u65f6\u95f4\u5185\u5b8c\u6210\u5173\u5361\u7684\u73a9\u5bb6\u5c06\u83b7\u5f97\u66f4\u9ad8\u7684\u5206\u6570\u3002\u7406\u89e3\u6b64\u7cfb\u7edf\u6709\u52a9\u4e8e\u5236\u5b9a\u66f4\u597d\u7684\u7b56\u7565\u3002"}, {"question": "\u5982\u4f55\u5904\u7406\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f\u300b\u4e2d\u591a\u4e2a\u79fb\u52a8\u969c\u788d\u7269\uff1f", "answer": "\u5728\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f\u300b\u4e2d\u5904\u7406\u591a\u4e2a\u79fb\u52a8\u969c\u788d\u7269\u9700\u8981\u89c2\u5bdf\u548c\u7b56\u7565\u7684\u7ed3\u5408\u3002\u6b65\u9aa41\uff1a\u8bc6\u522b\u6bcf\u4e2a\u969c\u788d\u7269\u7684\u79fb\u52a8\u6a21\u5f0f\u3002\u6b65\u9aa42\uff1a\u89c4\u5212\u4e00\u6761\u540c\u65f6\u907f\u5f00\u6240\u6709\u969c\u788d\u7269\u7684\u8def\u5f84\u3002\u6b65\u9aa43\uff1a\u7cbe\u786e\u6267\u884c\u4f60\u7684\u8ba1\u5212\u3002\u4f8b\u5982\uff0c\u572812\u7ea7\uff0c\u4f60\u53ef\u80fd\u9700\u8981\u8fdb\u884c\u5bf9\u89d2\u79fb\u52a8\u6765\u907f\u5f00\u6c34\u5e73\u548c\u5782\u76f4\u7684\u969c\u788d\u7269\u3002\u8fd9\u79cd\u65b9\u6cd5\u786e\u4fdd\u4f60\u80fd\u6210\u529f\u5e94\u5bf9\u590d\u6742\u7684\u60c5\u51b5\u3002"}, {"question": "\u5982\u4f55\u5728\u4e0d\u540c\u8bbe\u5907\u4e0a\u4f18\u5316\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f\u300b\u7684\u6027\u80fd\uff1f", "answer": "\u5728\u4e0d\u540c\u8bbe\u5907\u4e0a\u4f18\u5316\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f\u300b\u7684\u6027\u80fd\u6d89\u53ca\u8c03\u6574\u8bbe\u7f6e\u548c\u4e86\u89e3\u8bbe\u5907\u529f\u80fd\u3002\u6b65\u9aa41\uff1a\u786e\u4fdd\u4f60\u7684\u8bbe\u5907\u62e5\u6709\u6700\u65b0\u7684\u66f4\u65b0\u548c\u8db3\u591f\u7684\u5904\u7406\u80fd\u529b\u3002\u6b65\u9aa42\uff1a\u8c03\u6574\u6e38\u620f\u7684\u56fe\u5f62\u8bbe\u7f6e\uff0c\u5e73\u8861\u6027\u80fd\u548c\u89c6\u89c9\u6e05\u6670\u5ea6\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u63d0\u4f9b\u7cbe\u786e\u8f93\u5165\u7684\u63a7\u5236\u5668\u6216\u952e\u76d8\u3002\u4f8b\u5982\uff0c\u5728\u5177\u6709\u9ad8\u5237\u65b0\u7387\u663e\u793a\u5668\u7684PC\u4e0a\u6e38\u620f\uff0c\u4e0e\u79fb\u52a8\u8bbe\u5907\u76f8\u6bd4\uff0c\u53ef\u4ee5\u63d0\u9ad8\u54cd\u5e94\u901f\u5ea6\u3002\u8fd9\u79cd\u65b9\u6cd5\u6709\u52a9\u4e8e\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u4fdd\u6301\u4e00\u81f4\u7684\u6027\u80fd\u3002"}, {"question": "\u5728\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f\u300b\u4e2d\uff0c\u6709\u54ea\u4e9b\u9690\u85cf\u7684\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f\u300b\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u7684\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u63d0\u5347\u6e38\u620f\u4f53\u9a8c\u3002\u4e00\u4e2a\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\u901a\u8fc7\u4ee5\u5b8c\u7f8e\u5206\u6570\u5b8c\u6210\u67d0\u4e9b\u5173\u5361\u5373\u53ef\u8bbf\u95ee\u7684\u79d8\u5bc6\u5173\u5361\u3002\u6b65\u9aa41\uff1a\u5728\u521d\u59cb\u5173\u5361\u4e2d\u4e89\u53d6\u5b8c\u7f8e\u8868\u73b0\u3002\u6b65\u9aa42\uff1a\u5bfb\u627e\u5173\u5361\u8bbe\u8ba1\u4e2d\u7684\u7ec6\u5fae\u63d0\u793a\u6216\u53d8\u5316\uff0c\u8fd9\u4e9b\u63d0\u793a\u6216\u53d8\u5316\u6697\u793a\u9690\u85cf\u8def\u5f84\u3002\u6b65\u9aa43\uff1a\u63a2\u7d22\u8fd9\u4e9b\u8def\u5f84\u6765\u53d1\u73b0\u79d8\u5bc6\u5173\u5361\u3002\u4f8b\u5982\uff0c\u572815\u7ea7\uff0c\u5982\u679c\u4f60\u5728\u6ca1\u6709\u4efb\u4f55\u9519\u8bef\u7684\u60c5\u51b5\u4e0b\u907f\u5f00\u6240\u6709\u969c\u788d\uff0c\u5219\u4f1a\u663e\u73b0\u4e00\u4e2a\u9690\u85cf\u8d70\u5eca\u3002\u53d1\u73b0\u8fd9\u4e9b\u5143\u7d20\u4e3a\u6e38\u620f\u589e\u52a0\u4e86\u989d\u5916\u7684\u6311\u6218\u6027\u548c\u4e50\u8da3\u3002"}, {"question": "\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f\u300b\u4e2d\u7684\u96be\u5ea6\u7b49\u7ea7\u662f\u5982\u4f55\u9012\u589e\u7684\uff0c\u4ee5\u53ca\u5728\u540e\u671f\u7684\u5173\u5361\u4e2d\u6211\u5e94\u8be5\u671f\u5f85\u4ec0\u4e48\uff1f", "answer": "\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f\u300b\u4e2d\u7684\u96be\u5ea6\u7b49\u7ea7\u901a\u8fc7\u589e\u52a0\u969c\u788d\u7269\u7684\u590d\u6742\u6027\u548c\u901f\u5ea6\u800c\u9012\u589e\u3002\u6b65\u9aa41\uff1a\u65e9\u671f\u5173\u5361\u5f15\u5165\u57fa\u672c\u79fb\u52a8\u6a21\u5f0f\u548c\u8f83\u5c11\u7684\u969c\u788d\u7269\u3002\u6b65\u9aa42\uff1a\u4e2d\u671f\u5173\u5361\u4f1a\u52a0\u5165\u66f4\u591a\u969c\u788d\u7269\u548c\u66f4\u5feb\u7684\u79fb\u52a8\u901f\u5ea6\u3002\u6b65\u9aa43\uff1a\u540e\u671f\u5173\u5361\u5c06\u591a\u79cd\u7c7b\u578b\u7684\u969c\u788d\u7269\u4e0e\u590d\u6742\u7684\u6a21\u5f0f\u7ed3\u5408\u5728\u4e00\u8d77\u3002\u4f8b\u5982\uff0c\u572820\u7ea7\uff0c\u4f60\u5c06\u9047\u5230\u9700\u8981\u7cbe\u786e\u65f6\u95f4\u63a7\u5236\u548c\u7b56\u7565\u7684\u65cb\u8f6c\u548c\u7ebf\u6027\u969c\u788d\u7269\u7684\u6df7\u5408\u3002\u7406\u89e3\u8fd9\u79cd\u9012\u8fdb\u6709\u52a9\u4e8e\u4e3a\u5c06\u6765\u7684\u6311\u6218\u505a\u597d\u51c6\u5907\u3002"}, {"question": "\u624b\u673a\u7248\u548cPC\u7248\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f\u300b\u4e4b\u95f4\u6709\u54ea\u4e9b\u5173\u952e\u533a\u522b\uff1f", "answer": "\u624b\u673a\u7248\u548cPC\u7248\u300a\u4e16\u754c\u6700\u96be\u6e38\u620f\u300b\u7684\u5173\u952e\u533a\u522b\u5305\u62ec\u63a7\u5236\u65b9\u6848\u548c\u6027\u80fd\u3002\u6b65\u9aa41\uff1a\u5728\u624b\u673a\u4e0a\uff0c\u4f7f\u7528\u89e6\u6478\u63a7\u5236\uff0c\u8fd9\u4e0d\u5982\u952e\u76d8\u6216\u63a7\u5236\u5668\u7cbe\u786e\u3002\u6b65\u9aa42\uff1a\u7531\u4e8e\u66f4\u9ad8\u7684\u5904\u7406\u80fd\u529b\uff0cPC\u7248\u672c\u901a\u5e38\u63d0\u4f9b\u66f4\u597d\u7684\u56fe\u5f62\u548c\u66f4\u6d41\u7545\u7684\u6027\u80fd\u3002\u6b65\u9aa43\uff1a\u624b\u673a\u7248\u672c\u53ef\u80fd\u5728\u5173\u5361\u8bbe\u8ba1\u4e0a\u7565\u6709\u4e0d\u540c\uff0c\u4ee5\u9002\u5e94\u89e6\u6478\u754c\u9762\u3002\u4f8b\u5982\uff0c\u624b\u673a\u72488\u7ea7\u53ef\u80fd\u5728\u969c\u788d\u7269\u4e4b\u95f4\u7684\u95f4\u9699\u7565\u5927\uff0c\u4ee5\u4fbf\u4f7f\u7528\u89e6\u6478\u63a7\u5236\u66f4\u5bb9\u6613\u64cd\u63a7\u3002\u4e86\u89e3\u8fd9\u4e9b\u5dee\u5f02\u6709\u52a9\u4e8e\u9009\u62e9\u6700\u9002\u5408\u4f60\u7684\u6e38\u620f\u98ce\u683c\u7684\u5e73\u53f0\u3002"}]
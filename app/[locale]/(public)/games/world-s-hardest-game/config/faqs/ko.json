[{"question": "\ucd08\uc2ec\uc790\ub85c\uc11c \uc5b4\ub5bb\uac8c \uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784\uc5d0\uc11c \uce90\ub9ad\ud130\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc81c\uc5b4\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784\uc5d0\uc11c \uce90\ub9ad\ud130\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc81c\uc5b4\ud558\ub824\uba74 \uae30\ubcf8\uc801\uc778 \uc6c0\uc9c1\uc784\uc744 \uc775\ud788\ub294 \uac83\uc73c\ub85c \uc2dc\uc791\ud558\uc138\uc694. \ud654\uc0b4\ud45c \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc815\ud655\ud558\uac8c \uc870\uc791\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 1\uc5d0\uc11c \ube68\uac04 \uc810\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uce90\ub9ad\ud130\ub97c \uc791\uc740 \uac04\uaca9\uc73c\ub85c \uc774\ub3d9\ud558\ub294 \uc5f0\uc2b5\uc744 \ud558\uc138\uc694. 1\ub2e8\uacc4: \ucc9c\ucc9c\ud788 \uc6c0\uc9c1\uc774\uace0 \uc7a5\uc560\ubb3c\uc758 \ud328\ud134\uc744 \uad00\ucc30\ud558\uc138\uc694. 2\ub2e8\uacc4: \uac04\uaca9\uc774 \ub9de\ucdb0\uc9c8 \ub54c \uc6c0\uc9c1\uc784\uc758 \ud0c0\uc774\ubc0d\uc744 \ub9de\ucdb0 \ud1b5\uacfc\ud558\uc138\uc694. 3\ub2e8\uacc4: \uadfc\uc721 \uae30\uc5b5\ub825\uc744 \uad6c\ucd95\ud558\uae30 \uc704\ud574 \ub808\ubca8\uc744 \ubc18\ubcf5\ud558\uc138\uc694. \uc774 \ubc29\ubc95\uc740 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\uace0 \ubc18\uc751 \uc2dc\uac04\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784\uc758 \ub808\ubca8 5\ub97c \uc644\ub8cc\ud558\uae30 \uc704\ud55c \ud544\uc218 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784\uc758 \ub808\ubca8 5\ub97c \uc644\ub8cc\ud558\ub824\uba74 \uc804\ub7b5\uc801\uc778 \uacc4\ud68d\uacfc \uc815\ud655\ud55c \uc2e4\ud589\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \ud30c\ub780\uc0c9\uacfc \ube68\uac04\uc0c9 \uc810\uc758 \uc6c0\uc9c1\uc784 \ud328\ud134\uc744 \ubd84\uc11d\ud558\uc138\uc694. 2\ub2e8\uacc4: \ucda9\ub3cc\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uc6c0\uc9c1\uc784\uc758 \ud0c0\uc774\ubc0d\uc744 \ub9de\ucdb0 \uac00\uc7a5 \uc548\uc804\ud55c \uacbd\ub85c\ub97c \ucc3e\uc73c\uc138\uc694. 3\ub2e8\uacc4: \ud654\uba74\uc758 \ubaa8\uc11c\ub9ac\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc77c\uc2dc \uc815\uc9c0\ud558\uace0 \uc804\ub7b5\uc744 \uc7ac\ud3c9\uac00\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud55c \uad6c\uac04\uc5d0\uc11c \ud30c\ub780\uc0c9 \uc810\uc774 \uc6c0\uc9c1\uc784\uc744 \uba48\ucd9c \ub54c\uae4c\uc9c0 \uae30\ub2e4\ub9ac\ub294 \uac83\uc774 \uc911\uc694\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc811\uadfc \ubc29\uc2dd\uc740 \uc704\ud5d8\uc744 \ucd5c\uc18c\ud654\ud558\uace0 \uc131\uacf5 \uac00\ub2a5\uc131\uc744 \ub192\uc785\ub2c8\ub2e4."}, {"question": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784\uc5d0\uc11c \ud0c0\uc774\ubc0d\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\ub098\uc694?", "answer": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784\uc5d0\uc11c \ud0c0\uc774\ubc0d\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \uc7a5\uc560\ubb3c\uc774 \uc608\uce21 \uac00\ub2a5\ud55c \ud328\ud134\uc73c\ub85c \uc6c0\uc9c1\uc774\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \ud0c0\uc774\ubc0d\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub824\uba74 \uc7a5\uc560\ubb3c\uc758 \ub9ac\ub4ec\uacfc \uc6c0\uc9c1\uc784\uc744 \ub3d9\uae30\ud654\ud558\ub294 \uc5f0\uc2b5\uc744 \ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 3\uc5d0\uc11c \ube68\uac04 \uc810\uc774 \uc6d0\ud615 \ud328\ud134\uc73c\ub85c \uc6c0\uc9c1\uc774\ub294 \ubc29\uc2dd\uc744 \uad00\ucc30\ud558\uace0 \uc774\uc5d0 \ub530\ub77c \uc774\ub3d9\ud558\uc138\uc694. 1\ub2e8\uacc4: \uc6c0\uc9c1\uc774\uae30 \uc804\uc5d0 \uc7a5\uc560\ubb3c \ud328\ud134\uc744 \uba87 \ucd08 \ub3d9\uc548 \uad00\ucc30\ud558\uc138\uc694. 2\ub2e8\uacc4: \uacbd\ub85c\uac00 \uc7a0\uc2dc \ub3d9\uc548 \ub9d1\uc744 \ub54c \uc6c0\uc9c1\uc774\uc138\uc694. 3\ub2e8\uacc4: \ud0c0\uc774\ubc0d \uae30\uc220\uc744 \uc815\uc81c\ud558\uae30 \uc704\ud574 \ub808\ubca8\uc744 \ubc18\ubcf5\ud558\uc138\uc694. \uc774 \ubc29\ubc95\uc740 \uc6c0\uc9c1\uc784\uc744 \uc608\uce21\ud558\uace0 \uc624\ub958\ub97c \uc904\uc774\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784\uc758 \ub354 \ubcf5\uc7a1\ud55c \ub808\ubca8\uc744 \ud0d0\uc0c9\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ub294 \uace0\uae09 \uae30\uc220\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784\uc758 \ubcf5\uc7a1\ud55c \ub808\ubca8\uc744 \ud0d0\uc0c9\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ub294 \uace0\uae09 \uae30\uc220\uc5d0\ub294 \ud328\ud134 \uc778\uc2dd\uacfc \uacbd\ub85c \ucd5c\uc801\ud654\uac00 \uc788\uc2b5\ub2c8\ub2e4. 1\ub2e8\uacc4: \ub808\ubca8 \ub0b4 \ubaa8\ub4e0 \uc7a5\uc560\ubb3c\uc758 \uc6c0\uc9c1\uc784 \ud328\ud134\uc744 \uc5f0\uad6c\ud558\uc138\uc694. 2\ub2e8\uacc4: \uac01 \uc7a5\uc560\ubb3c\uc758 \ud0c0\uc774\ubc0d\uc744 \uacc4\uc0b0\ud558\uc5ec \uac00\uc7a5 \uc548\uc804\ud55c \uacbd\ub85c\ub97c \uc2dd\ubcc4\ud558\uc138\uc694. 3\ub2e8\uacc4: \ud654\uc0b4\ud45c \ud0a4\ub97c \ube60\ub974\uac8c \ud0ed\ud558\uc5ec \uc815\ubc00\ud558\uac8c \uc6c0\uc9c1\uc784\uc744 \uc2e4\ud589\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 10\uc5d0\uc11c \uc774 \uae30\uc220\uc744 \uc0ac\uc6a9\ud558\uba74 \uc6c0\uc9c1\uc774\ub294 \uc7a5\uc560\ubb3c\uc758 \ubbf8\ub85c\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \ud0d0\uc0c9\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc811\uadfc\ubc95\uc740 \uac8c\uc784\uc758 \ub354 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc744 \ub9c8\uc2a4\ud130\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4."}, {"question": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \ucd5c\uc885 \uc810\uc218\uc5d0 \uc5b4\ub5a4 \uc694\uc18c\uac00 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uac01 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\ub294 \ub370 \uac78\ub9b0 \uc774\ub3d9 \ud69f\uc218\uc640 \uc2dc\uac04\uc744 \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \uac00\uc7a5 \ud6a8\uc728\uc801\uc778 \uacbd\ub85c\ub97c \ucc3e\uc544 \uc774\ub3d9 \ud69f\uc218\ub97c \ucd5c\uc18c\ud654\ud558\uc138\uc694. 2\ub2e8\uacc4: \uc2e4\uc218 \uc5c6\uc774 \ucd5c\ub300\ud55c \ube60\ub974\uac8c \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uc138\uc694. 3\ub2e8\uacc4: \ubd88\ud544\uc694\ud55c \uc911\uc9c0\ub098 \ub418\ub3cc\uc544\uac00\ub294 \uac83\uc744 \ud53c\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 7\uc5d0\uc11c \ub354 \uc801\uc740 \uc774\ub3d9 \ud69f\uc218\uc640 \ub354 \uc801\uc740 \uc2dc\uac04\uc73c\ub85c \ub808\ubca8\uc744 \uc644\ub8cc\ud55c \ud50c\ub808\uc774\uc5b4\ub294 \ub354 \ub192\uc740 \uc810\uc218\ub97c \ubc1b\uac8c \ub429\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\uba74 \ub354 \ub098\uc740 \uc131\ub2a5\uc744 \uc704\ud55c \uc804\ub7b5\uc744 \uc138\uc6b0\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784\uc5d0\uc11c \uc5ec\ub7ec \uac1c\uc758 \uc6c0\uc9c1\uc774\ub294 \uc7a5\uc560\ubb3c\uc744 \ucc98\ub9ac\ud558\ub294 \ucd5c\uc0c1\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784\uc5d0\uc11c \uc5ec\ub7ec \uc6c0\uc9c1\uc774\ub294 \uc7a5\uc560\ubb3c\uc744 \ucc98\ub9ac\ud558\ub824\uba74 \uad00\ucc30\uacfc \uc804\ub7b5\uc758 \uc870\ud569\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \uac01 \uc7a5\uc560\ubb3c\uc758 \uc6c0\uc9c1\uc784 \ud328\ud134\uc744 \uc2dd\ubcc4\ud558\uc138\uc694. 2\ub2e8\uacc4: \ubaa8\ub4e0 \uc7a5\uc560\ubb3c\uc744 \ub3d9\uc2dc\uc5d0 \ud53c\ud560 \uc218 \uc788\ub294 \uacbd\ub85c\ub97c \uacc4\ud68d\ud558\uc138\uc694. 3\ub2e8\uacc4: \uc815\ud655\ud55c \uc6c0\uc9c1\uc784\uc73c\ub85c \uacc4\ud68d\uc744 \uc2e4\ud589\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 12\uc5d0\uc11c\ub294 \uc218\ud3c9 \ubc0f \uc218\uc9c1 \uc7a5\uc560\ubb3c\uc744 \ubaa8\ub450 \ud53c\ud558\uae30 \uc704\ud574 \ub300\uac01\uc120\uc73c\ub85c \uc774\ub3d9\ud574\uc57c \ud560 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \ubc29\ubc95\uc744 \uc0ac\uc6a9\ud558\uba74 \ubcf5\uc7a1\ud55c \uc0c1\ud669\uc744 \uc131\uacf5\uc801\uc73c\ub85c \ud0d0\uc0c9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub2e4\uc591\ud55c \uae30\uae30\uc5d0\uc11c \uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784\uc758 \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub2e4\uc591\ud55c \uae30\uae30\uc5d0\uc11c \uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784\uc758 \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub294 \uac83\uc740 \uc124\uc815\uc744 \uc870\uc815\ud558\uace0 \uae30\uae30 \uae30\ub2a5\uc744 \uc774\ud574\ud558\ub294 \uac83\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \uae30\uae30\uac00 \ucd5c\uc2e0 \uc5c5\ub370\uc774\ud2b8\ub97c \ubc1b\uc558\uace0 \ucda9\ubd84\ud55c \ucc98\ub9ac \uc131\ub2a5\uc744 \uac16\ucd94\uc5c8\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. 2\ub2e8\uacc4: \uac8c\uc784\uc758 \uadf8\ub798\ud53d \uc124\uc815\uc744 \uc870\uc815\ud558\uc5ec \uc131\ub2a5\uacfc \uc2dc\uac01\uc801\uc778 \uba85\ud655\uc131\uc744 \uade0\ud615 \uc788\uac8c \uc720\uc9c0\ud558\uc138\uc694. 3\ub2e8\uacc4: \uc815\ud655\ud55c \uc785\ub825\uc744 \uc81c\uacf5\ud558\ub294 \ucee8\ud2b8\ub864\ub7ec \ub610\ub294 \ud0a4\ubcf4\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uace0\uc8fc\uc0ac\uc728 \ubaa8\ub2c8\ud130\uac00 \uc788\ub294 PC\uc5d0\uc11c \ud50c\ub808\uc774\ud558\ub294 \uac83\uc740 \ubaa8\ubc14\uc77c \uae30\uae30\uc640 \ube44\uad50\ud558\uc5ec \ubc18\uc751\uc131\uc744 \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc811\uadfc \ubc29\uc2dd\uc740 \ud50c\ub7ab\ud3fc \uac04 \uc77c\uad00\uc801\uc778 \uc131\ub2a5\uc744 \uc720\uc9c0\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784\uc5d0\uc11c \uc5b4\ub5a4 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ucc3e\uc744 \uc218 \uc788\ub098\uc694?", "answer": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784\uc5d0\ub294 \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uae30\ub2a5\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc8fc\ubaa9\ud560 \ub9cc\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ud2b9\uc815 \ub808\ubca8\uc744 \uc644\ubcbd \uc810\uc218\ub85c \ud074\ub9ac\uc5b4\ud568\uc73c\ub85c\uc368 \uc811\uadfc\ud560 \uc218 \uc788\ub294 \ube44\ubc00 \ub808\ubca8\uc785\ub2c8\ub2e4. 1\ub2e8\uacc4: \ucd08\uae30 \ub808\ubca8\uc5d0\uc11c \uc644\ubcbd\ud55c \uc131\ub2a5\uc744 \ubaa9\ud45c\ub85c \ud558\uc138\uc694. 2\ub2e8\uacc4: \uc228\uaca8\uc9c4 \uacbd\ub85c\ub97c \ub098\ud0c0\ub0b4\ub294 \ub808\ubca8 \ub514\uc790\uc778\uc758 \ubbf8\ubb18\ud55c \ud78c\ud2b8\ub098 \ubcc0\ud654\ub97c \ucc3e\uc73c\uc138\uc694. 3\ub2e8\uacc4: \uc774\ub7ec\ud55c \uacbd\ub85c\ub97c \ud0d0\uc0c9\ud558\uc5ec \ube44\ubc00 \ub808\ubca8\uc744 \ucc3e\uc73c\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 15\uc5d0\uc11c\ub294 \uc2e4\uc218 \uc5c6\uc774 \ubaa8\ub4e0 \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\uba74 \uc228\uaca8\uc9c4 \ubcf5\ub3c4\uac00 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc694\uc18c\ub97c \ubc1c\uacac\ud558\uba74 \uac8c\uc784\uc5d0 \ub3c4\uc804\uacfc \uc7ac\ubbf8\ub97c \ub354\ud569\ub2c8\ub2e4."}, {"question": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784\uc758 \ub09c\uc774\ub3c4 \ub808\ubca8\uc740 \uc5b4\ub5bb\uac8c \uc0c1\uc2b9\ud558\uba70, \ud6c4\ubc18 \ub808\ubca8\uc5d0\uc11c\ub294 \ubb34\uc5c7\uc744 \uae30\ub300\ud574\uc57c \ud558\ub098\uc694?", "answer": "\uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784\uc758 \ub09c\uc774\ub3c4 \ub808\ubca8\uc740 \uc7a5\uc560\ubb3c\uc758 \ubcf5\uc7a1\uc131\uacfc \uc18d\ub3c4\uac00 \uc99d\uac00\ud558\uba74\uc11c \uc0c1\uc2b9\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \ucd08\uae30 \ub808\ubca8\uc5d0\uc11c\ub294 \uae30\ubcf8\uc801\uc778 \uc774\ub3d9 \ud328\ud134\uacfc \uc801\uc740 \uc7a5\uc560\ubb3c\uc774 \ub4f1\uc7a5\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \uc911\uac04 \ub808\ubca8\uc5d0\uc11c\ub294 \uc7a5\uc560\ubb3c\uc774 \ub354 \ub9ce\uc544\uc9c0\uace0 \uc6c0\uc9c1\uc784\uc774 \ube68\ub77c\uc9d1\ub2c8\ub2e4. 3\ub2e8\uacc4: \ud6c4\ubc18 \ub808\ubca8\uc5d0\uc11c\ub294 \ub2e4\uc591\ud55c \uc720\ud615\uc758 \uc7a5\uc560\ubb3c\uc774 \ubcf5\uc7a1\ud55c \ud328\ud134\uc73c\ub85c \uacb0\ud569\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 20\uc5d0\uc11c\ub294 \ud68c\uc804 \ubc0f \uc120\ud615 \uc7a5\uc560\ubb3c\uc758 \ud63c\ud569\uc774 \ub098\ud0c0\ub098 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uacfc \uc804\ub7b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc9c4\ud589 \uacfc\uc815\uc744 \uc774\ud574\ud558\uba74 \uc55e\uc73c\ub85c\uc758 \ub3c4\uc804\uc5d0 \ub300\ube44\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\ubaa8\ubc14\uc77c \ubc0f PC \ubc84\uc804\uc758 \uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ubaa8\ubc14\uc77c \ubc0f PC \ubc84\uc804\uc758 \uc6d4\ub4dc \ud558\ub4dc \uac8c\uc784\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc5d0\ub294 \ucee8\ud2b8\ub864 \ubc29\uc2dd\uacfc \uc131\ub2a5\uc774 \uc788\uc2b5\ub2c8\ub2e4. 1\ub2e8\uacc4: \ubaa8\ubc14\uc77c\uc5d0\uc11c\ub294 \ud130\uce58 \ucee8\ud2b8\ub864\uc744 \uc0ac\uc6a9\ud558\ub294\ub370, \uc774\ub294 \ud0a4\ubcf4\ub4dc\ub098 \ucee8\ud2b8\ub864\ub7ec\ubcf4\ub2e4 \uc815\ubc00\ub3c4\uac00 \ub5a8\uc5b4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 2\ub2e8\uacc4: PC \ubc84\uc804\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \ub354 \ub192\uc740 \ucc98\ub9ac \uc131\ub2a5\uc73c\ub85c \uc778\ud574 \uadf8\ub798\ud53d\uc774 \ub354 \uc88b\uace0 \uc131\ub2a5\uc774 \ub354 \ubd80\ub4dc\ub7fd\uc2b5\ub2c8\ub2e4. 3\ub2e8\uacc4: \ubaa8\ubc14\uc77c \ubc84\uc804\uc740 \ud130\uce58 \uc778\ud130\ud398\uc774\uc2a4\uc5d0 \ub9de\uac8c \ub808\ubca8 \ub514\uc790\uc778\uc5d0 \uc57d\uac04\uc758 \ucc28\uc774\uac00 \uc788\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubaa8\ubc14\uc77c\uc758 \ub808\ubca8 8\uc5d0\uc11c\ub294 \ud130\uce58 \ucee8\ud2b8\ub864\ub85c \ub354\uc6b1 \uad00\ub9ac\ud558\uae30 \uc27d\ub3c4\ub85d \uc7a5\uc560\ubb3c \uc0ac\uc774\uc758 \uac04\uaca9\uc774 \uc57d\uac04 \ub354 \ucee4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ucc28\uc774\uc810\uc744 \uc774\ud574\ud558\uba74 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \uac00\uc7a5 \uc801\ud569\ud55c \ud50c\ub7ab\ud3fc\uc744 \uc120\ud0dd\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}]
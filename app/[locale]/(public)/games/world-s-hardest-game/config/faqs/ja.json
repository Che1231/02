[{"question": "\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001\u30ef\u30fc\u30eb\u30c9\u30ba\u30fb\u30cf\u30fc\u30c7\u30b9\u30b2\u30fc\u30e0\u3067\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u52b9\u679c\u7684\u306b\u5236\u5fa1\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9\u30ba\u30fb\u30cf\u30fc\u30c7\u30b9\u30b2\u30fc\u30e0\u3067\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u52b9\u679c\u7684\u306b\u5236\u5fa1\u3059\u308b\u306b\u306f\u3001\u57fa\u672c\u7684\u306a\u52d5\u304d\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u304b\u3089\u59cb\u3081\u307e\u3059\u3002\u77e2\u5370\u30ad\u30fc\u3092\u4f7f\u7528\u3057\u3066\u3001\u6b63\u78ba\u306b\u79fb\u52d5\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb1\u3067\u306f\u3001\u8d64\u3044\u70b9\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u5c11\u3057\u305a\u3064\u52d5\u304b\u3057\u3066\u7df4\u7fd2\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u3086\u3063\u304f\u308a\u3068\u52d5\u304d\u3001\u969c\u5bb3\u7269\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u89b3\u5bdf\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u9699\u9593\u304c\u63c3\u3046\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u3001\u305d\u306e\u9699\u9593\u3092\u901a\u904e\u3059\u308b\u3088\u3046\u306b\u52d5\u304d\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u8a08\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7b4b\u8089\u306e\u8a18\u61b6\u3092\u69cb\u7bc9\u3059\u308b\u305f\u3081\u306b\u3001\u30ec\u30d9\u30eb\u3092\u7e70\u308a\u8fd4\u3057\u307e\u3059\u3002\u3053\u306e\u65b9\u6cd5\u306f\u3001\u30b2\u30fc\u30e0\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3057\u3001\u53cd\u5fdc\u6642\u9593\u3092\u5411\u4e0a\u3055\u305b\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30ef\u30fc\u30eb\u30c9\u30ba\u30fb\u30cf\u30fc\u30c7\u30b9\u30b2\u30fc\u30e0\u306e\u30ec\u30d9\u30eb5\u3092\u30af\u30ea\u30a2\u3059\u308b\u305f\u3081\u306e\u5fc5\u9808\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9\u30ba\u30fb\u30cf\u30fc\u30c7\u30b9\u30b2\u30fc\u30e0\u306e\u30ec\u30d9\u30eb5\u3092\u30af\u30ea\u30a2\u3059\u308b\u306b\u306f\u3001\u6226\u7565\u7684\u306a\u8a08\u753b\u3068\u6b63\u78ba\u306a\u5b9f\u884c\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u9752\u3068\u8d64\u306e\u70b9\u306e\u79fb\u52d5\u30d1\u30bf\u30fc\u30f3\u3092\u5206\u6790\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u885d\u7a81\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u3001\u52d5\u304d\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u8a08\u3063\u3066\u3001\u6700\u3082\u5b89\u5168\u306a\u30eb\u30fc\u30c8\u3092\u898b\u3064\u3051\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u753b\u9762\u306e\u89d2\u3092\u4f7f\u3063\u3066\u4e00\u6642\u505c\u6b62\u3057\u3001\u6226\u7565\u3092\u518d\u8a55\u4fa1\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u3042\u308b\u30bb\u30af\u30b7\u30e7\u30f3\u3067\u306f\u3001\u9752\u306e\u70b9\u304c\u79fb\u52d5\u3057\u306a\u304f\u306a\u308b\u306e\u3092\u5f85\u3063\u3066\u304b\u3089\u524d\u9032\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002\u3053\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u3001\u30ea\u30b9\u30af\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u3001\u6210\u529f\u306e\u53ef\u80fd\u6027\u3092\u9ad8\u3081\u307e\u3059\u3002"}, {"question": "\u30ef\u30fc\u30eb\u30c9\u30ba\u30fb\u30cf\u30fc\u30c7\u30b9\u30b2\u30fc\u30e0\u3067\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u3069\u306e\u3088\u3046\u306b\u6539\u5584\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9\u30ba\u30fb\u30cf\u30fc\u30c7\u30b9\u30b2\u30fc\u30e0\u3067\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u306a\u306e\u306f\u3001\u969c\u5bb3\u7269\u304c\u4e88\u6e2c\u53ef\u80fd\u306a\u30d1\u30bf\u30fc\u30f3\u3067\u52d5\u304f\u305f\u3081\u3067\u3059\u3002\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u6539\u5584\u3059\u308b\u306b\u306f\u3001\u969c\u5bb3\u7269\u306e\u30ea\u30ba\u30e0\u306b\u5408\u308f\u305b\u3066\u52d5\u304d\u3092\u540c\u671f\u3055\u305b\u308b\u7df4\u7fd2\u3092\u884c\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb3\u3067\u306f\u3001\u8d64\u3044\u70b9\u304c\u5186\u5f62\u30d1\u30bf\u30fc\u30f3\u3067\u52d5\u304f\u69d8\u5b50\u3092\u89b3\u5bdf\u3057\u3001\u305d\u308c\u306b\u5fdc\u3058\u3066\u524d\u9032\u3059\u308b\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u8a08\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u79fb\u52d5\u3059\u308b\u524d\u306b\u3001\u6570\u79d2\u9593\u969c\u5bb3\u7269\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u89b3\u5bdf\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u901a\u8def\u304c\u958b\u3044\u3066\u3044\u308b\u77ed\u3044\u6642\u9593\u5e2f\u306b\u79fb\u52d5\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30bf\u30a4\u30df\u30f3\u30b0\u30b9\u30ad\u30eb\u3092\u6d17\u7df4\u3059\u308b\u305f\u3081\u306b\u3001\u30ec\u30d9\u30eb\u3092\u7e70\u308a\u8fd4\u3057\u307e\u3059\u3002\u3053\u306e\u65b9\u6cd5\u306f\u3001\u52d5\u304d\u3092\u4e88\u6e2c\u3057\u3001\u30a8\u30e9\u30fc\u3092\u6e1b\u3089\u3059\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30ef\u30fc\u30eb\u30c9\u30ba\u30fb\u30cf\u30fc\u30c7\u30b9\u30b2\u30fc\u30e0\u3067\u3088\u308a\u8907\u96d1\u306a\u30ec\u30d9\u30eb\u3092\u30ca\u30d3\u30b2\u30fc\u30c8\u3059\u308b\u306e\u306b\u5f79\u7acb\u3064\u9ad8\u5ea6\u306a\u30c6\u30af\u30cb\u30c3\u30af\u306f\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9\u30ba\u30fb\u30cf\u30fc\u30c7\u30b9\u30b2\u30fc\u30e0\u3067\u8907\u96d1\u306a\u30ec\u30d9\u30eb\u3092\u30ca\u30d3\u30b2\u30fc\u30c8\u3059\u308b\u9ad8\u5ea6\u306a\u30c6\u30af\u30cb\u30c3\u30af\u306b\u306f\u3001\u30d1\u30bf\u30fc\u30f3\u306e\u8a8d\u8b58\u3068\u7d4c\u8def\u6700\u9069\u5316\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30ec\u30d9\u30eb\u5185\u306e\u3059\u3079\u3066\u306e\u969c\u5bb3\u7269\u306e\u79fb\u52d5\u30d1\u30bf\u30fc\u30f3\u3092\u7814\u7a76\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5404\u969c\u5bb3\u7269\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u8a08\u7b97\u3059\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u3001\u6700\u3082\u5b89\u5168\u306a\u30eb\u30fc\u30c8\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u77e2\u5370\u30ad\u30fc\u3092\u7d20\u65e9\u304f\u30bf\u30c3\u30d7\u3057\u3066\u7d30\u304b\u3044\u5236\u5fa1\u3092\u884c\u3044\u3001\u6b63\u78ba\u306a\u52d5\u304d\u3067\u5b9f\u884c\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb10\u3067\u306f\u3001\u3053\u306e\u30c6\u30af\u30cb\u30c3\u30af\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u79fb\u52d5\u3059\u308b\u969c\u5bb3\u7269\u306e\u8ff7\u8def\u3092\u52b9\u7387\u7684\u306b\u30ca\u30d3\u30b2\u30fc\u30c8\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u3001\u30b2\u30fc\u30e0\u306e\u3088\u308a\u96e3\u3057\u3044\u30ec\u30d9\u30eb\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002"}, {"question": "\u30ef\u30fc\u30eb\u30c9\u30ba\u30fb\u30cf\u30fc\u30c7\u30b9\u30b2\u30fc\u30e0\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u6700\u7d42\u7684\u306a\u30b9\u30b3\u30a2\u306b\u3069\u306e\u3088\u3046\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9\u30ba\u30fb\u30cf\u30fc\u30c7\u30b9\u30b2\u30fc\u30e0\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u5404\u30ec\u30d9\u30eb\u3092\u5b8c\u4e86\u3059\u308b\u305f\u3081\u306b\u5fc5\u8981\u306a\u79fb\u52d5\u56de\u6570\u3068\u6642\u9593\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6700\u3082\u52b9\u7387\u7684\u306a\u7d4c\u8def\u3092\u898b\u3064\u3051\u3066\u3001\u79fb\u52d5\u56de\u6570\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30a8\u30e9\u30fc\u306a\u304f\u3067\u304d\u308b\u3060\u3051\u65e9\u304f\u30ec\u30d9\u30eb\u3092\u5b8c\u4e86\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u4e0d\u5fc5\u8981\u306a\u4e00\u6642\u505c\u6b62\u3084\u30d0\u30c3\u30af\u30c8\u30e9\u30c3\u30ad\u30f3\u30b0\u3092\u907f\u3051\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb7\u3067\u306f\u3001\u3088\u308a\u5c11\u306a\u3044\u79fb\u52d5\u56de\u6570\u3068\u77ed\u3044\u6642\u9593\u3067\u30ec\u30d9\u30eb\u3092\u5b8c\u4e86\u3057\u305f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3068\u3001\u3088\u308a\u826f\u3044\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306e\u305f\u3081\u306e\u6226\u7565\u3092\u7acb\u3066\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30ef\u30fc\u30eb\u30c9\u30ba\u30fb\u30cf\u30fc\u30c7\u30b9\u30b2\u30fc\u30e0\u3067\u8907\u6570\u306e\u79fb\u52d5\u3059\u308b\u969c\u5bb3\u7269\u3092\u51e6\u7406\u3059\u308b\u305f\u3081\u306e\u30d9\u30b9\u30c8\u30d7\u30e9\u30af\u30c6\u30a3\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9\u30ba\u30fb\u30cf\u30fc\u30c7\u30b9\u30b2\u30fc\u30e0\u3067\u8907\u6570\u306e\u79fb\u52d5\u3059\u308b\u969c\u5bb3\u7269\u3092\u51e6\u7406\u3059\u308b\u306b\u306f\u3001\u89b3\u5bdf\u529b\u3068\u6226\u7565\u306e\u7d44\u307f\u5408\u308f\u305b\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5404\u969c\u5bb3\u7269\u306e\u79fb\u52d5\u30d1\u30bf\u30fc\u30f3\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u3059\u3079\u3066\u306e\u969c\u5bb3\u7269\u3092\u540c\u6642\u306b\u907f\u3051\u308b\u7d4c\u8def\u3092\u8a08\u753b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6b63\u78ba\u306a\u52d5\u304d\u3067\u8a08\u753b\u3092\u5b9f\u884c\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb12\u3067\u306f\u3001\u6c34\u5e73\u304a\u3088\u3073\u5782\u76f4\u306e\u969c\u5bb3\u7269\u306e\u4e21\u65b9\u3092\u56de\u907f\u3059\u308b\u305f\u3081\u306b\u3001\u659c\u3081\u306b\u79fb\u52d5\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u3053\u306e\u65b9\u6cd5\u306f\u3001\u8907\u96d1\u306a\u72b6\u6cc1\u3067\u3046\u307e\u304f\u30ca\u30d3\u30b2\u30fc\u30c8\u3067\u304d\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002"}, {"question": "\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u3067\u30ef\u30fc\u30eb\u30c9\u30ba\u30fb\u30cf\u30fc\u30c7\u30b9\u30b2\u30fc\u30e0\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u3067\u30ef\u30fc\u30eb\u30c9\u30ba\u30fb\u30cf\u30fc\u30c7\u30b9\u30b2\u30fc\u30e0\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u8a2d\u5b9a\u3092\u8abf\u6574\u3057\u3001\u30c7\u30d0\u30a4\u30b9\u306e\u6a5f\u80fd\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30c7\u30d0\u30a4\u30b9\u304c\u6700\u65b0\u306e\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3092\u6301\u3061\u3001\u5341\u5206\u306a\u51e6\u7406\u80fd\u529b\u3092\u5099\u3048\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b2\u30fc\u30e0\u306e\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3092\u8abf\u6574\u3057\u3066\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3068\u8996\u899a\u7684\u306a\u30af\u30ea\u30a2\u30fc\u3055\u3092\u30d0\u30e9\u30f3\u30b9\u3055\u305b\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6b63\u78ba\u306a\u5165\u529b\u3092\u63d0\u4f9b\u3059\u308b\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u307e\u305f\u306f\u30ad\u30fc\u30dc\u30fc\u30c9\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001PC\u3067\u9ad8\u30ea\u30d5\u30ec\u30c3\u30b7\u30e5\u30ec\u30fc\u30c8\u306e\u30e2\u30cb\u30bf\u30fc\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u3068\u6bd4\u3079\u3066\u5fdc\u7b54\u6027\u304c\u9ad8\u307e\u308a\u307e\u3059\u3002\u3053\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u5168\u4f53\u3067\u4e00\u8cab\u3057\u305f\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u7dad\u6301\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30ef\u30fc\u30eb\u30c9\u30ba\u30fb\u30cf\u30fc\u30c7\u30b9\u30b2\u30fc\u30e0\u3067\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9\u30ba\u30fb\u30cf\u30fc\u30c7\u30b9\u30b2\u30fc\u30e0\u306b\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4f53\u9a13\u3092\u5411\u4e0a\u3055\u305b\u308b\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u3044\u304f\u3064\u304b\u3042\u308a\u307e\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306e1\u3064\u306f\u3001\u7279\u5b9a\u306e\u30ec\u30d9\u30eb\u3092\u5b8c\u74a7\u306a\u30b9\u30b3\u30a2\u3067\u30af\u30ea\u30a2\u3059\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u79d8\u5bc6\u306e\u30ec\u30d9\u30eb\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u5b8c\u74a7\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u76ee\u6307\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u96a0\u3055\u308c\u305f\u7d4c\u8def\u3092\u793a\u3059\u30ec\u30d9\u30eb\u30c7\u30b6\u30a4\u30f3\u306b\u304a\u3051\u308b\u5fae\u5999\u306a\u30d2\u30f3\u30c8\u3084\u5909\u5316\u3092\u63a2\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u3053\u308c\u3089\u306e\u7d4c\u8def\u3092\u63a2\u7d22\u3057\u3066\u3001\u79d8\u5bc6\u306e\u30ec\u30d9\u30eb\u3092\u767a\u898b\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb15\u3067\u306f\u3001\u3059\u3079\u3066\u306e\u969c\u5bb3\u7269\u3092\u9593\u9055\u3044\u306a\u304f\u56de\u907f\u3057\u305f\u5834\u5408\u3001\u96a0\u308c\u305f\u901a\u8def\u304c\u73fe\u308c\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u8981\u7d20\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u306b\u3055\u3089\u306a\u308b\u6311\u6226\u3068\u697d\u3057\u3055\u304c\u52a0\u308f\u308a\u307e\u3059\u3002"}, {"question": "\u30ef\u30fc\u30eb\u30c9\u30ba\u30fb\u30cf\u30fc\u30c7\u30b9\u30b2\u30fc\u30e0\u306e\u96e3\u6613\u5ea6\u30ec\u30d9\u30eb\u306f\u3069\u306e\u3088\u3046\u306b\u5897\u52a0\u3057\u3001\u5f8c\u7d9a\u306e\u30ec\u30d9\u30eb\u3067\u306f\u4f55\u304c\u671f\u5f85\u3055\u308c\u307e\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9\u30ba\u30fb\u30cf\u30fc\u30c7\u30b9\u30b2\u30fc\u30e0\u306e\u96e3\u6613\u5ea6\u30ec\u30d9\u30eb\u306f\u3001\u969c\u5bb3\u7269\u306e\u8907\u96d1\u3055\u3068\u901f\u5ea6\u304c\u5897\u52a0\u3059\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u5897\u52a0\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u521d\u671f\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u57fa\u672c\u7684\u306a\u79fb\u52d5\u30d1\u30bf\u30fc\u30f3\u3068\u5c11\u306a\u3044\u969c\u5bb3\u7269\u304c\u51fa\u73fe\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u4e2d\u9593\u30ec\u30d9\u30eb\u3067\u306f\u3001\u3088\u308a\u591a\u304f\u306e\u969c\u5bb3\u7269\u3068\u901f\u3044\u52d5\u304d\u304c\u8ffd\u52a0\u3055\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5f8c\u7d9a\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u8907\u96d1\u306a\u30d1\u30bf\u30fc\u30f3\u3092\u6301\u3064\u8907\u6570\u306e\u30bf\u30a4\u30d7\u306e\u969c\u5bb3\u7269\u304c\u7d44\u307f\u5408\u308f\u305b\u3089\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb20\u3067\u306f\u3001\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u6226\u7565\u304c\u5fc5\u8981\u306a\u56de\u8ee2\u969c\u5bb3\u7269\u3068\u76f4\u7dda\u969c\u5bb3\u7269\u306e\u7d44\u307f\u5408\u308f\u305b\u306b\u51fa\u4f1a\u3046\u3067\u3057\u3087\u3046\u3002\u3053\u306e\u9032\u884c\u3092\u7406\u89e3\u3059\u308b\u3068\u3001\u4eca\u5f8c\u306e\u8ab2\u984c\u306b\u5099\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30ef\u30fc\u30eb\u30c9\u30ba\u30fb\u30cf\u30fc\u30c7\u30b9\u30b2\u30fc\u30e0\u306e\u30e2\u30d0\u30a4\u30eb\u7248\u3068PC\u7248\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30eb\u30c9\u30ba\u30fb\u30cf\u30fc\u30c7\u30b9\u30b2\u30fc\u30e0\u306e\u30e2\u30d0\u30a4\u30eb\u7248\u3068PC\u7248\u306e\u4e3b\u306a\u9055\u3044\u306f\u3001\u5236\u5fa1\u65b9\u6cd5\u3068\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30e2\u30d0\u30a4\u30eb\u7248\u3067\u306f\u3001\u30ad\u30fc\u30dc\u30fc\u30c9\u3084\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u3088\u308a\u3082\u6b63\u78ba\u6027\u306b\u6b20\u3051\u308b\u30bf\u30c3\u30c1\u64cd\u4f5c\u304c\u4f7f\u7528\u3055\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1aPC\u7248\u3067\u306f\u3001\u901a\u5e38\u3001\u9ad8\u3044\u51e6\u7406\u80fd\u529b\u306e\u305f\u3081\u306b\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u304c\u512a\u308c\u3066\u3044\u3066\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u304c\u30b9\u30e0\u30fc\u30ba\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30e2\u30d0\u30a4\u30eb\u7248\u3067\u306f\u3001\u30bf\u30c3\u30c1\u30a4\u30f3\u30bf\u30fc\u30d5\u30a7\u30fc\u30b9\u306b\u5bfe\u5fdc\u3059\u308b\u305f\u3081\u306b\u3001\u30ec\u30d9\u30eb\u30c7\u30b6\u30a4\u30f3\u306b\u308f\u305a\u304b\u306a\u9055\u3044\u304c\u3042\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30e2\u30d0\u30a4\u30eb\u7248\u306e\u30ec\u30d9\u30eb8\u3067\u306f\u3001\u30bf\u30c3\u30c1\u64cd\u4f5c\u3067\u3088\u308a\u53d6\u308a\u6271\u3044\u304c\u5bb9\u6613\u306b\u306a\u308b\u3088\u3046\u306b\u3001\u969c\u5bb3\u7269\u9593\u306e\u9699\u9593\u304c\u3084\u3084\u5927\u304d\u304f\u306a\u3063\u3066\u3044\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u9055\u3044\u3092\u7406\u89e3\u3059\u308b\u3068\u3001\u81ea\u5206\u306b\u6700\u9069\u306a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u9078\u629e\u3067\u304d\u307e\u3059\u3002"}]
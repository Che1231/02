[{"question": "\u5982\u4f55\u6709\u6548\u63a7\u5236\u65b0\u624b\u5728\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232\u300b\u4e2d\u7684\u89d2\u8272\uff1f", "answer": "\u8981\u6709\u6548\u63a7\u5236\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232\u300b\u4e2d\u7684\u89d2\u8272\uff0c\u9996\u5148\u8981\u638c\u63e1\u57fa\u672c\u52d5\u4f5c\u3002\u8acb\u4f7f\u7528\u65b9\u5411\u9375\u9032\u884c\u7cbe\u78ba\u5c0e\u822a\u3002\u4f8b\u5982\uff0c\u5728\u7b2c1\u95dc\uff0c\u7df4\u7fd2\u5c11\u91cf\u79fb\u52d5\u89d2\u8272\u4ee5\u907f\u514d\u7d05\u8272\u6a19\u8a18\u3002\u6b65\u9a5f1\uff1a\u7de9\u6162\u79fb\u52d5\u4e26\u89c0\u5bdf\u969c\u7919\u7269\u7684\u898f\u5f8b\u3002\u6b65\u9a5f2\uff1a\u5728\u9593\u9699\u8207\u9593\u9699\u5c0d\u9f4a\u6642\uff0c\u8abf\u6574\u60a8\u7684\u79fb\u52d5\u6642\u9593\u3002\u6b65\u9a5f3\uff1a\u91cd\u8907\u8a72\u95dc\u5361\u4ee5\u5efa\u7acb\u808c\u8089\u8a18\u61b6\u3002\u6b64\u65b9\u6cd5\u6709\u52a9\u65bc\u7406\u89e3\u904a\u6232\u6a5f\u5236\u4e26\u63d0\u9ad8\u60a8\u7684\u53cd\u61c9\u6642\u9593\u3002"}, {"question": "\u5728\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232\u300b\u4e2d\u5b8c\u6210\u7b2c5\u95dc\u7684\u5fc5\u8981\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232\u300b\u4e2d\u5b8c\u6210\u7b2c5\u95dc\u9700\u8981\u7b56\u7565\u898f\u5283\u548c\u7cbe\u78ba\u57f7\u884c\u3002\u6b65\u9a5f1\uff1a\u5206\u6790\u85cd\u8272\u548c\u7d05\u8272\u6a19\u8a18\u7684\u79fb\u52d5\u6a21\u5f0f\u3002\u6b65\u9a5f2\uff1a\u901a\u904e\u8abf\u6574\u79fb\u52d5\u6642\u9593\u4ee5\u907f\u514d\u78b0\u649e\u4f86\u627e\u5230\u6700\u5b89\u5168\u7684\u8def\u7dda\u3002\u6b65\u9a5f3\uff1a\u4f7f\u7528\u87a2\u5e55\u89d2\u843d\u66ab\u505c\u4e26\u91cd\u65b0\u8a55\u4f30\u60a8\u7684\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u5728\u4e00\u500b\u90e8\u5206\u4e2d\uff0c\u7b49\u5f85\u85cd\u8272\u6a19\u8a18\u79fb\u958b\u518d\u524d\u9032\u81f3\u95dc\u91cd\u8981\u3002\u6b64\u65b9\u6cd5\u53ef\u5c07\u98a8\u96aa\u964d\u5230\u6700\u4f4e\u4e26\u63d0\u9ad8\u6210\u529f\u7387\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u6642\u9593\u5728\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232\u300b\u4e2d\u5982\u6b64\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u6539\u5584\u5b83\uff1f", "answer": "\u6642\u9593\u5728\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232\u300b\u4e2d\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u969c\u7919\u7269\u4ee5\u53ef\u9810\u6e2c\u7684\u6a21\u5f0f\u79fb\u52d5\u3002\u8981\u6539\u5584\u60a8\u7684\u6642\u9593\u638c\u63a7\u80fd\u529b\uff0c\u8acb\u7df4\u7fd2\u5c07\u60a8\u7684\u52d5\u4f5c\u8207\u969c\u7919\u7269\u7684\u7bc0\u594f\u540c\u6b65\u3002\u4f8b\u5982\uff0c\u5728\u7b2c3\u95dc\uff0c\u8acb\u89c0\u5bdf\u7d05\u8272\u6a19\u8a18\u5982\u4f55\u4ee5\u5713\u5f62\u6a21\u5f0f\u79fb\u52d5\u4e26\u76f8\u61c9\u5730\u8abf\u6574\u60a8\u7684\u524d\u9032\u6642\u9593\u3002\u6b65\u9a5f1\uff1a\u5728\u79fb\u52d5\u4e4b\u524d\u89c0\u5bdf\u969c\u7919\u7269\u6a21\u5f0f\u5e7e\u79d2\u9418\u3002\u6b65\u9a5f2\uff1a\u5728\u8def\u5f91\u66a2\u901a\u7684\u77ac\u9593\u79fb\u52d5\u3002\u6b65\u9a5f3\uff1a\u91cd\u8907\u8a72\u95dc\u5361\u4ee5\u63d0\u9ad8\u60a8\u7684\u6642\u9593\u638c\u63a7\u6280\u80fd\u3002\u6b64\u65b9\u6cd5\u6709\u52a9\u65bc\u9810\u6e2c\u52d5\u4f5c\u4e26\u6e1b\u5c11\u932f\u8aa4\u3002"}, {"question": "\u54ea\u4e9b\u5148\u9032\u6280\u8853\u53ef\u4ee5\u5e6b\u52a9\u6211\u61c9\u5c0d\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232\u300b\u4e2d\u66f4\u8907\u96dc\u7684\u95dc\u5361\uff1f", "answer": "\u5728\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232\u300b\u4e2d\u61c9\u5c0d\u8907\u96dc\u95dc\u5361\u7684\u5148\u9032\u6280\u8853\u5305\u62ec\u6a21\u5f0f\u8b58\u5225\u548c\u8def\u5f91\u512a\u5316\u3002\u6b65\u9a5f1\uff1a\u7814\u7a76\u95dc\u5361\u4e2d\u6240\u6709\u969c\u7919\u7269\u7684\u79fb\u52d5\u6a21\u5f0f\u3002\u6b65\u9a5f2\uff1a\u901a\u904e\u8a08\u7b97\u6bcf\u500b\u969c\u7919\u7269\u7684\u6642\u9593\u4f86\u8b58\u5225\u6700\u5b89\u5168\u7684\u8def\u7dda\u3002\u6b65\u9a5f3\uff1a\u4f7f\u7528\u65b9\u5411\u9375\u7684\u5feb\u901f\u9ede\u64ca\u9032\u884c\u7cbe\u78ba\u63a7\u5236\uff0c\u57f7\u884c\u60a8\u7684\u52d5\u4f5c\u3002\u4f8b\u5982\uff0c\u5728\u7b2c10\u95dc\uff0c\u4f7f\u7528\u6b64\u6280\u8853\u53ef\u4ee5\u5e6b\u52a9\u60a8\u6709\u6548\u5730\u7a7f\u904e\u79fb\u52d5\u969c\u7919\u7269\u7684\u8ff7\u5bae\u3002\u6b64\u65b9\u6cd5\u5c0d\u65bc\u638c\u63e1\u904a\u6232\u66f4\u96e3\u7684\u95dc\u5361\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232\u300b\u4e2d\u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u6700\u7d42\u5f97\u5206\uff1f", "answer": "\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232\u300b\u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u5b8c\u6210\u6bcf\u95dc\u6240\u9700\u7684\u52d5\u4f5c\u6b21\u6578\u548c\u6642\u9593\u3002\u6b65\u9a5f1\uff1a\u900f\u904e\u5c0b\u627e\u6700\u6709\u6548\u7387\u7684\u9014\u5f91\u4f86\u6e1b\u5c11\u52d5\u4f5c\u6b21\u6578\u3002\u6b65\u9a5f2\uff1a\u76e1\u53ef\u80fd\u5728\u4e0d\u72af\u932f\u7684\u60c5\u6cc1\u4e0b\u8fc5\u901f\u5b8c\u6210\u95dc\u5361\u3002\u6b65\u9a5f3\uff1a\u907f\u514d\u4e0d\u5fc5\u8981\u7684\u66ab\u505c\u6216\u5f80\u56de\u8d70\u3002\u4f8b\u5982\uff0c\u5728\u7b2c7\u95dc\uff0c\u5728\u66f4\u5c11\u52d5\u4f5c\u548c\u66f4\u77ed\u6642\u9593\u5167\u5b8c\u6210\u95dc\u5361\u7684\u73a9\u5bb6\u5c07\u7372\u5f97\u66f4\u9ad8\u7684\u5206\u6578\u3002\u4e86\u89e3\u6b64\u7cfb\u7d71\u6709\u52a9\u65bc\u5236\u5b9a\u66f4\u597d\u7684\u7b56\u7565\uff0c\u4ee5\u7372\u5f97\u66f4\u597d\u7684\u8868\u73fe\u3002"}, {"question": "\u5728\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232\u300b\u4e2d\u5982\u4f55\u8655\u7406\u591a\u500b\u79fb\u52d5\u969c\u7919\u7269\uff1f", "answer": "\u5728\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232\u300b\u4e2d\u8655\u7406\u591a\u500b\u79fb\u52d5\u969c\u7919\u7269\u9700\u8981\u7d50\u5408\u89c0\u5bdf\u548c\u7b56\u7565\u3002\u6b65\u9a5f1\uff1a\u8b58\u5225\u6bcf\u500b\u969c\u7919\u7269\u7684\u79fb\u52d5\u6a21\u5f0f\u3002\u6b65\u9a5f2\uff1a\u898f\u5283\u4e00\u689d\u540c\u6642\u907f\u958b\u6240\u6709\u969c\u7919\u7269\u7684\u8def\u7dda\u3002\u6b65\u9a5f3\uff1a\u4ee5\u7cbe\u78ba\u7684\u52d5\u4f5c\u57f7\u884c\u60a8\u7684\u8a08\u5283\u3002\u4f8b\u5982\uff0c\u5728\u7b2c12\u95dc\uff0c\u60a8\u53ef\u80fd\u9700\u8981\u4ee5\u5c0d\u89d2\u7dda\u65b9\u5f0f\u79fb\u52d5\u4ee5\u907f\u958b\u6c34\u5e73\u548c\u5782\u76f4\u969c\u7919\u7269\u3002\u6b64\u65b9\u6cd5\u78ba\u4fdd\u60a8\u80fd\u5920\u6210\u529f\u5730\u7a7f\u904e\u8907\u96dc\u7684\u60c5\u6cc1\u3002"}, {"question": "\u5982\u4f55\u5728\u4e0d\u540c\u88dd\u7f6e\u4e0a\u512a\u5316\u6211\u5728\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232\u300b\u4e2d\u7684\u8868\u73fe\uff1f", "answer": "\u5728\u4e0d\u540c\u88dd\u7f6e\u4e0a\u512a\u5316\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232\u300b\u7684\u8868\u73fe\u6d89\u53ca\u8abf\u6574\u8a2d\u5b9a\u548c\u4e86\u89e3\u88dd\u7f6e\u529f\u80fd\u3002\u6b65\u9a5f1\uff1a\u78ba\u4fdd\u60a8\u7684\u88dd\u7f6e\u5df2\u66f4\u65b0\u5230\u6700\u65b0\u7248\u672c\uff0c\u4e26\u64c1\u6709\u8db3\u5920\u7684\u8655\u7406\u80fd\u529b\u3002\u6b65\u9a5f2\uff1a\u8abf\u6574\u904a\u6232\u7684\u5716\u5f62\u8a2d\u5b9a\u4ee5\u5e73\u8861\u6548\u80fd\u548c\u8996\u89ba\u6e05\u6670\u5ea6\u3002\u6b65\u9a5f3\uff1a\u4f7f\u7528\u63d0\u4f9b\u7cbe\u78ba\u8f38\u5165\u7684\u63a7\u5236\u5668\u6216\u9375\u76e4\u3002\u4f8b\u5982\uff0c\u8207\u4f7f\u7528\u884c\u52d5\u88dd\u7f6e\u76f8\u6bd4\uff0c\u5728\u5177\u6709\u9ad8\u87a2\u5e55\u66f4\u65b0\u7387\u7684\u96fb\u8166\u4e0a\u73a9\u904a\u6232\u53ef\u4ee5\u63d0\u9ad8\u53cd\u61c9\u80fd\u529b\u3002\u6b64\u65b9\u6cd5\u6709\u52a9\u65bc\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u7dad\u6301\u4e00\u81f4\u7684\u6548\u80fd\u3002"}, {"question": "\u6211\u5728\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232\u300b\u4e2d\u53ef\u4ee5\u627e\u5230\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232\u300b\u5305\u542b\u4e00\u4e9b\u96b1\u85cf\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u4ee5\u589e\u5f37\u904a\u6232\u9ad4\u9a57\u3002\u503c\u5f97\u6ce8\u610f\u7684\u662f\uff0c\u900f\u904e\u4ee5\u5b8c\u7f8e\u5206\u6578\u5b8c\u6210\u67d0\u4e9b\u95dc\u5361\u53ef\u4ee5\u958b\u555f\u79d8\u5bc6\u95dc\u5361\u3002\u6b65\u9a5f1\uff1a\u52aa\u529b\u5728\u521d\u59cb\u95dc\u5361\u4e2d\u53d6\u5f97\u5b8c\u7f8e\u7684\u8868\u73fe\u3002\u6b65\u9a5f2\uff1a\u5c0b\u627e\u95dc\u5361\u8a2d\u8a08\u4e2d\u7d30\u5fae\u7684\u63d0\u793a\u6216\u8b8a\u5316\uff0c\u9019\u4e9b\u63d0\u793a\u6216\u8b8a\u5316\u6703\u986f\u793a\u96b1\u85cf\u8def\u5f91\u3002\u6b65\u9a5f3\uff1a\u63a2\u7d22\u9019\u4e9b\u8def\u7dda\u4ee5\u767c\u73fe\u79d8\u5bc6\u95dc\u5361\u3002\u4f8b\u5982\uff0c\u5728\u7b2c15\u95dc\uff0c\u5982\u679c\u60a8\u5728\u6c92\u6709\u4efb\u4f55\u932f\u8aa4\u7684\u60c5\u6cc1\u4e0b\u907f\u958b\u6240\u6709\u969c\u7919\u7269\uff0c\u5247\u6703\u51fa\u73fe\u4e00\u689d\u96b1\u85cf\u8d70\u5eca\u3002\u767c\u73fe\u9019\u4e9b\u5143\u7d20\u70ba\u904a\u6232\u589e\u52a0\u4e86\u984d\u5916\u7684\u6311\u6230\u548c\u6a02\u8da3\u3002"}, {"question": "\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232\u300b\u4e2d\u7684\u96e3\u5ea6\u7b49\u7d1a\u5982\u4f55\u63d0\u5347\uff0c\u5728\u5f8c\u9762\u7684\u95dc\u5361\u4e2d\u6211\u61c9\u8a72\u671f\u5f85\u4ec0\u9ebc\uff1f", "answer": "\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232\u300b\u4e2d\u7684\u96e3\u5ea6\u7b49\u7d1a\u63d0\u5347\u65b9\u5f0f\u5728\u65bc\u589e\u52a0\u969c\u7919\u7269\u7684\u8907\u96dc\u6027\u548c\u901f\u5ea6\u3002\u6b65\u9a5f1\uff1a\u65e9\u671f\u95dc\u5361\u6703\u4ecb\u7d39\u57fa\u672c\u7684\u79fb\u52d5\u6a21\u5f0f\u548c\u8f03\u5c11\u7684\u969c\u7919\u7269\u3002\u6b65\u9a5f2\uff1a\u4e2d\u671f\u95dc\u5361\u6703\u589e\u52a0\u66f4\u591a\u969c\u7919\u7269\u548c\u66f4\u5feb\u7684\u79fb\u52d5\u901f\u5ea6\u3002\u6b65\u9a5f3\uff1a\u5f8c\u671f\u95dc\u5361\u6703\u5c07\u591a\u7a2e\u985e\u578b\u7684\u969c\u7919\u7269\u8207\u8907\u96dc\u7684\u6a21\u5f0f\u7d50\u5408\u5728\u4e00\u8d77\u3002\u4f8b\u5982\uff0c\u5728\u7b2c20\u95dc\uff0c\u60a8\u5c07\u6703\u9047\u5230\u9700\u8981\u7cbe\u78ba\u6642\u9593\u638c\u63a7\u548c\u7b56\u7565\u7684\u65cb\u8f49\u548c\u7dda\u6027\u969c\u7919\u7269\u7d44\u5408\u3002\u4e86\u89e3\u9019\u7a2e\u63d0\u5347\u6709\u52a9\u65bc\u70ba\u5373\u5c07\u9762\u5c0d\u7684\u6311\u6230\u505a\u597d\u6e96\u5099\u3002"}, {"question": "\u884c\u52d5\u88dd\u7f6e\u7248\u548c\u96fb\u8166\u7248\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232\u300b\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "\u884c\u52d5\u88dd\u7f6e\u7248\u548c\u96fb\u8166\u7248\u300a\u4e16\u754c\u6700\u96e3\u904a\u6232\u300b\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u5305\u62ec\u63a7\u5236\u65b9\u6848\u548c\u6548\u80fd\u3002\u6b65\u9a5f1\uff1a\u5728\u884c\u52d5\u88dd\u7f6e\u4e0a\u4f7f\u7528\u89f8\u63a7\u63a7\u5236\uff0c\u5176\u7cbe\u78ba\u5ea6\u53ef\u80fd\u4e0d\u5982\u9375\u76e4\u6216\u63a7\u5236\u5668\u3002\u6b65\u9a5f2\uff1a\u7531\u65bc\u8655\u7406\u80fd\u529b\u8f03\u9ad8\uff0c\u96fb\u8166\u7248\u901a\u5e38\u63d0\u4f9b\u66f4\u597d\u7684\u5716\u5f62\u548c\u66f4\u9806\u66a2\u7684\u6548\u80fd\u3002\u6b65\u9a5f3\uff1a\u884c\u52d5\u88dd\u7f6e\u7248\u672c\u53ef\u80fd\u5728\u95dc\u5361\u8a2d\u8a08\u4e0a\u6709\u6240\u8abf\u6574\uff0c\u4ee5\u914d\u5408\u89f8\u63a7\u4ecb\u9762\u3002\u4f8b\u5982\uff0c\u5728\u884c\u52d5\u88dd\u7f6e\u4e0a\u7684\u7b2c8\u95dc\uff0c\u969c\u7919\u7269\u4e4b\u9593\u7684\u9593\u9699\u53ef\u80fd\u7565\u5927\uff0c\u4ee5\u4f7f\u7528\u89f8\u63a7\u63a7\u5236\u66f4\u65b9\u4fbf\u64cd\u4f5c\u3002\u4e86\u89e3\u9019\u4e9b\u5dee\u7570\u6709\u52a9\u65bc\u9078\u64c7\u6700\u9069\u5408\u60a8\u7684\u904a\u6232\u98a8\u683c\u7684\u5e73\u53f0\u3002"}]
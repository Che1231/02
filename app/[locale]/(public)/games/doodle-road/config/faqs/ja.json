[{"question": "\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001Doodle Road\u3092\u8fc5\u901f\u306b\u958b\u59cb\u3057\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Doodle Road\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30e1\u30a4\u30f3\u30e1\u30cb\u30e5\u30fc\u3092\u899a\u3048\u3001[\u30b2\u30fc\u30e0\u958b\u59cb]\u3092\u9078\u629e\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u65b9\u5411\u30ad\u30fc\u307e\u305f\u306f\u30b9\u30ef\u30a4\u30d7\u30b8\u30a7\u30b9\u30c1\u30e3\u30fc\u3092\u4f7f\u7528\u3057\u3066\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u5236\u5fa1\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u3001\u969c\u5bb3\u7269\u3092\u907f\u3051\u3001\u9032\u6b69\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u3044\u304b\u306a\u308b\u969c\u5bb3\u7269\u306b\u3082\u5f53\u305f\u3089\u306a\u3044\u306710\u500b\u306e\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u308b\u3053\u3068\u3067\u7df4\u7fd2\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u57fa\u672c\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3057\u3001\u5236\u5fa1\u30b9\u30ad\u30eb\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "100\u6642\u9593\u4ee5\u4e0a\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001Doodle Road\u3067\u9032\u6b69\u3059\u308b\u305f\u3081\u306e\u91cd\u8981\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Doodle Road\u3067100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u4ee5\u4e0b\u306e\u6226\u7565\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u969c\u5bb3\u7269\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u8a18\u61b6\u3059\u308b\u3053\u3068\u3067\u3001\u30eb\u30fc\u30c8\u3092\u6700\u9069\u5316\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u53ce\u96c6\u3057\u305f\u30b3\u30a4\u30f3\u3092\u4f7f\u7528\u3057\u3066\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u80fd\u529b\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30c7\u30a4\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u306b\u53c2\u52a0\u3057\u3066\u3001\u8ffd\u52a0\u306e\u5831\u916c\u3092\u5f97\u308b\u3002\u4f8b\u3048\u3070\u3001[\u7802\u6f20\u75be\u8d70]\u30ec\u30d9\u30eb\u3067\u306f\u3001\u79fb\u52d5\u3059\u308b\u969c\u5bb3\u7269\u306e\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u77e5\u308b\u3053\u3068\u304c\u3001\u547d\u3092\u5931\u3046\u306e\u3092\u9632\u3050\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u3055\u307e\u3056\u307e\u306a\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u6bd4\u8f03\u3059\u308b\u3053\u3068\u3067\u3001\u81ea\u5206\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u6700\u9069\u306a\u3082\u306e\u3092\u9078\u629e\u3067\u304d\u307e\u3059\u3002"}, {"question": "Doodle Road\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u7279\u5b9a\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u6709\u5229\u3067\u3042\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Doodle Road\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6b63\u78ba\u3055\u3068\u901f\u5ea6\u3092\u8a55\u4fa1\u3057\u307e\u3059\u3002\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u969c\u5bb3\u7269\u306b\u5f53\u305f\u3089\u306a\u3044\u5b8c\u5168\u306a\u30e9\u30f3\u3092\u76ee\u6307\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u53ef\u80fd\u306a\u9650\u308a\u591a\u304f\u306e\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u3001\u7279\u306b\u30dc\u30fc\u30ca\u30b9\u30a8\u30ea\u30a2\u3067\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u6226\u7565\u7684\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001[\u68ee\u306e\u72c2\u9a12]\u30ec\u30d9\u30eb\u3067\u306f\u3001[\u78c1\u77f3]\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u30b3\u30a4\u30f3\u3092\u3088\u308a\u52b9\u7387\u7684\u306b\u96c6\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u8981\u7d20\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3053\u3068\u3067\u3001\u5168\u4f53\u7684\u306a\u30b9\u30b3\u30a2\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Doodle Road\u306e\u3069\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u80fd\u529b\u304c\u6700\u3082\u5927\u304d\u306a\u5229\u70b9\u3092\u63d0\u4f9b\u3057\u3001\u3069\u306e\u3088\u3046\u306b\u6d3b\u7528\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "Doodle Road\u3067\u306f\u3001\u7279\u5b9a\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u80fd\u529b\u306f\u660e\u78ba\u306a\u5229\u70b9\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001[\u30c0\u30d6\u30eb\u30b8\u30e3\u30f3\u30d7]\u80fd\u529b\u306f\u3001\u3088\u308a\u9ad8\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u5230\u9054\u3057\u3001\u969c\u5bb3\u7269\u3092\u3088\u308a\u52b9\u679c\u7684\u306b\u907f\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5341\u5206\u306a\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u308b\u3053\u3068\u3067\u3001\u80fd\u529b\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5404\u30ec\u30d9\u30eb\u306b\u6700\u3082\u9069\u3057\u305f\u80fd\u529b\u3092\u88c5\u5099\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u3055\u307e\u3056\u307e\u306a\u30b7\u30ca\u30ea\u30aa\u3067\u80fd\u529b\u3092\u4f7f\u7528\u3059\u308b\u7df4\u7fd2\u3092\u3059\u308b\u3002[\u30b7\u30fc\u30eb\u30c9]\u3068[\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8]\u306e\u3088\u3046\u306a\u80fd\u529b\u3092\u6bd4\u8f03\u3059\u308b\u3053\u3068\u3067\u3001\u30ec\u30d9\u30eb\u306e\u8ab2\u984c\u306b\u57fa\u3065\u3044\u3066\u3069\u3061\u3089\u3092\u4f7f\u7528\u3059\u3079\u304d\u304b\u3092\u5224\u65ad\u3067\u304d\u307e\u3059\u3002"}, {"question": "Doodle Road\u306e\u30ec\u30d9\u30eb\u8a2d\u8a08\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u9032\u884c\u72b6\u6cc1\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u3001\u5404\u30b9\u30c6\u30fc\u30b8\u3067\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u91cd\u70b9\u3092\u4f55\u306b\u7f6e\u304f\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "Doodle Road\u306e\u30ec\u30d9\u30eb\u8a2d\u8a08\u306f\u3001\u65b0\u3057\u3044\u8981\u7d20\u3092\u5c0e\u5165\u3057\u306a\u304c\u3089\u3001\u6bb5\u968e\u7684\u306b\u96e3\u6613\u5ea6\u3092\u9ad8\u3081\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u5404\u30b9\u30c6\u30fc\u30b8\u3067\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u4ee5\u4e0b\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3079\u304d\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u65b0\u3057\u3044\u969c\u5bb3\u7269\u306e\u5c0e\u5165\u306b\u6ce8\u610f\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u79fb\u52d5\u3059\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3084\u6642\u9593\u5236\u9650\u306e\u3042\u308b\u30c1\u30e3\u30ec\u30f3\u30b8\u306a\u3069\u3001\u5909\u5316\u3059\u308b\u74b0\u5883\u306b\u9069\u5fdc\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30ec\u30d9\u30eb\u56fa\u6709\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u6d3b\u7528\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001[\u6c37\u306e\u6d1e\u7a9f]\u30ec\u30d9\u30eb\u3067\u306f\u3001[\u30b9\u30b1\u30fc\u30c8]\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u6ed1\u308a\u3084\u3059\u3044\u8868\u9762\u3092\u3088\u308a\u52b9\u679c\u7684\u306b\u79fb\u52d5\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u8a2d\u8a08\u8981\u7d20\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u9032\u884c\u72b6\u6cc1\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Doodle Road\u306e\u30e2\u30d0\u30a4\u30eb\u7248\u3068PC\u7248\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3042\u308a\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3092\u30b9\u30e0\u30fc\u30ba\u306b\u79fb\u884c\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Doodle Road\u306e\u30e2\u30d0\u30a4\u30eb\u7248\u3068PC\u7248\u306e\u4e3b\u306a\u9055\u3044\u306b\u306f\u3001\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u30b9\u30ad\u30fc\u30e0\u3068\u753b\u9762\u89e3\u50cf\u5ea6\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u30b9\u30e0\u30fc\u30ba\u306b\u79fb\u884c\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u306e\u9055\u3044\uff08\u30bf\u30c3\u30c1\u3068\u30ad\u30fc\u30dc\u30fc\u30c9\uff09\u3092\u7406\u89e3\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b2\u30fc\u30e0\u8a2d\u5b9a\u3092\u3001\u304a\u597d\u307f\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u5408\u308f\u305b\u3066\u8abf\u6574\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u3001\u9032\u884c\u72b6\u6cc1\u3092\u540c\u671f\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u30e2\u30d0\u30a4\u30eb\u3067\u30b9\u30ef\u30a4\u30d7\u3057\u3066\u3044\u308b\u5834\u5408\u306f\u3001PC\u3067\u65b9\u5411\u30ad\u30fc\u3092\u4f7f\u7528\u3059\u308b\u7df4\u7fd2\u3092\u3057\u3066\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u7dad\u6301\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u6bd4\u8f03\u306b\u3088\u308a\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3092\u30b9\u30e0\u30fc\u30ba\u306b\u79fb\u884c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Doodle Road\u3067\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u767a\u898b\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\u3002\u305d\u3057\u3066\u3001\u3053\u308c\u3089\u306e\u79d8\u5bc6\u306f\u3069\u306e\u3088\u3046\u306a\u5831\u916c\u3092\u3082\u305f\u3089\u3057\u307e\u3059\u304b\uff1f", "answer": "Doodle Road\u3067\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u767a\u898b\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5404\u30ec\u30d9\u30eb\u306e\u9032\u3093\u3067\u3044\u306a\u3044\u30a8\u30ea\u30a2\u3092\u63a2\u7d22\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u308f\u305a\u304b\u306a\u8996\u899a\u7684\u306a\u624b\u304c\u304b\u308a\u3001\u4f8b\u3048\u3070\u3001\u308f\u305a\u304b\u306b\u7570\u306a\u308b\u8cea\u611f\u3084\u8272\u3092\u63a2\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7279\u5b9a\u306e\u80fd\u529b\u3092\u4f7f\u7528\u3057\u3066\u3001\u3053\u308c\u3089\u306e\u30a8\u30ea\u30a2\u306b\u30a2\u30af\u30bb\u30b9\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001[\u795e\u79d8\u306e\u5c71]\u30ec\u30d9\u30eb\u3067\u306f\u3001[\u30c0\u30d6\u30eb\u30b8\u30e3\u30f3\u30d7]\u80fd\u529b\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u73cd\u3057\u3044\u30b3\u30a4\u30f3\u3084\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3067\u6e80\u305f\u3055\u308c\u305f\u96a0\u308c\u305f\u6d1e\u7a9f\u306b\u5230\u9054\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u79d8\u5bc6\u306f\u3001\u591a\u304f\u306e\u5834\u5408\u3001\u91cd\u8981\u306a\u5831\u916c\u3092\u63d0\u4f9b\u3057\u3001\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002"}, {"question": "Doodle Road\u3067\u30ea\u30bd\u30fc\u30b9\u3092\u7ba1\u7406\u3059\u308b\u305f\u3081\u306e\u6700\u3082\u52b9\u679c\u7684\u306a\u65b9\u6cd5\u306f\u4f55\u304b\u3001\u305d\u3057\u3066\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u5fc5\u8981\u306a\u30b3\u30a4\u30f3\u3092\u78ba\u4fdd\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Doodle Road\u3067\u30ea\u30bd\u30fc\u30b9\u3092\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5404\u30ec\u30d9\u30eb\u3067\u30b3\u30a4\u30f3\u53ce\u96c6\u3092\u512a\u5148\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u4e0d\u5fc5\u8981\u306a\u8cfc\u5165\u3092\u907f\u3051\u3066\u3001\u5fc5\u9808\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u96c6\u4e2d\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30a4\u30d9\u30f3\u30c8\u3084\u30c1\u30e3\u30ec\u30f3\u30b8\u306b\u53c2\u52a0\u3057\u3066\u3001\u8ffd\u52a0\u306e\u30b3\u30a4\u30f3\u3092\u5f97\u308b\u3002\u4f8b\u3048\u3070\u3001[\u90fd\u5e02\u30b9\u30d7\u30ea\u30f3\u30c8]\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30dc\u30fc\u30ca\u30b9\u30be\u30fc\u30f3\u306e\u30b3\u30a4\u30f3\u53ce\u96c6\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3053\u3068\u3067\u3001\u30b3\u30a4\u30f3\u306e\u6570\u3092\u5927\u5e45\u306b\u5897\u3084\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u624b\u9806\u306b\u5f93\u3046\u3053\u3068\u3067\u3001\u5fc5\u8981\u306a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u5fc5\u8981\u306a\u30ea\u30bd\u30fc\u30b9\u3092\u78ba\u4fdd\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Doodle Road\u306e\u96e3\u6613\u5ea6\u8abf\u6574\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3088\u308a\u96e3\u3057\u3044\u30ec\u30d9\u30eb\u306b\u5099\u3048\u308b\u305f\u3081\u306b\u4f55\u3092\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Doodle Road\u306e\u96e3\u6613\u5ea6\u8abf\u6574\u306f\u3001\u9032\u884c\u72b6\u6cc1\u306b\u5408\u308f\u305b\u3066\u3001\u3088\u308a\u8907\u96d1\u306a\u969c\u5bb3\u7269\u3084\u3088\u308a\u901f\u3044\u30da\u30fc\u30b9\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5c0e\u5165\u3057\u307e\u3059\u3002\u6e96\u5099\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u521d\u671f\u30ec\u30d9\u30eb\u3067\u57fa\u672c\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7fd2\u5f97\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5f90\u3005\u306b\u901f\u5ea6\u3068\u6b63\u78ba\u3055\u3092\u4e0a\u3052\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u969c\u5bb3\u7269\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u8a18\u61b6\u3059\u308b\u306a\u3069\u306e\u9ad8\u5ea6\u306a\u6226\u7565\u3092\u6d3b\u7528\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001[\u706b\u5c71\u8c37]\u30ec\u30d9\u30eb\u3067\u306f\u3001\u6eb6\u5ca9\u306e\u6d41\u308c\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u7df4\u7fd2\u3059\u308b\u3053\u3068\u3067\u3001\u30ec\u30d9\u30eb\u3092\u3088\u308a\u52b9\u7387\u7684\u306b\u79fb\u52d5\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u8abf\u6574\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u5897\u52a0\u3059\u308b\u8ab2\u984c\u306b\u9069\u5fdc\u3067\u304d\u307e\u3059\u3002"}, {"question": "Doodle Road\u306e\u30ea\u30fc\u30c0\u30fc\u30dc\u30fc\u30c9\u3067\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u305f\u3081\u306e\u30d9\u30b9\u30c8\u30d7\u30e9\u30af\u30c6\u30a3\u30b9\u306f\u4f55\u3067\u3042\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u3088\u3046\u306b\u4e00\u8cab\u3057\u3066\u512a\u308c\u305f\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u767a\u63ee\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Doodle Road\u306e\u30ea\u30fc\u30c0\u30fc\u30dc\u30fc\u30c9\u3067\u9ad8\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30df\u30b9\u304c\u306a\u3044\u5b8c\u5168\u306a\u30e9\u30f3\u306b\u96c6\u4e2d\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30dc\u30fc\u30ca\u30b9\u30a8\u30ea\u30a2\u3067\u7279\u306b\u3001\u30b3\u30a4\u30f3\u3092\u6700\u5927\u9650\u306b\u96c6\u3081\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5f37\u5316\u3059\u308b\u305f\u3081\u306b\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u6226\u7565\u7684\u306b\u4f7f\u7528\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001[\u30b9\u30ab\u30a4\u30cf\u30a4]\u30ec\u30d9\u30eb\u3067\u306f\u3001[\u30b8\u30a7\u30c3\u30c8\u30d1\u30c3\u30af]\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u3088\u308a\u52b9\u679c\u7684\u306b\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u3066\u969c\u5bb3\u7269\u3092\u56de\u907f\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u5b9f\u8df5\u3092\u7d99\u7d9a\u7684\u306b\u9069\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u30ea\u30fc\u30c0\u30fc\u30dc\u30fc\u30c9\u306e\u4e0a\u4f4d\u306b\u30e9\u30f3\u30af\u30a4\u30f3\u3059\u308b\u53ef\u80fd\u6027\u304c\u9ad8\u307e\u308a\u307e\u3059\u3002"}]
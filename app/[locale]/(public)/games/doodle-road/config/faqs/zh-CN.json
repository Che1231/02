[{"question": "\u65b0\u73a9\u5bb6\u5982\u4f55\u5feb\u901f\u4e0a\u624b\u300a\u6d82\u9e26\u8d5b\u9053\u300b\u5e76\u638c\u63e1\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u5feb\u901f\u4e0a\u624b\u300a\u6d82\u9e26\u8d5b\u9053\u300b\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa4\u4e00\u2014\u2014\u719f\u6089\u4e3b\u83dc\u5355\uff0c\u9009\u62e9\"\u5f00\u59cb\u6e38\u620f\"\uff1b\u6b65\u9aa4\u4e8c\u2014\u2014\u4f7f\u7528\u65b9\u5411\u952e\u6216\u6ed1\u52a8\u64cd\u4f5c\u63a7\u5236\u4f60\u7684\u89d2\u8272\uff1b\u6b65\u9aa4\u4e09\u2014\u2014\u6536\u96c6\u91d1\u5e01\u5e76\u907f\u5f00\u969c\u788d\u7269\u6765\u53d6\u5f97\u8fdb\u5c55\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u5173\uff0c\u4f60\u53ef\u4ee5\u7ec3\u4e60\u6536\u96c6 10 \u4e2a\u91d1\u5e01\uff0c\u4e14\u4e0d\u78b0\u5230\u4efb\u4f55\u969c\u788d\u7269\u3002\u8fd9\u5c06\u5e2e\u52a9\u4f60\u7406\u89e3\u57fa\u672c\u6e38\u620f\u673a\u5236\u5e76\u63d0\u9ad8\u63a7\u5236\u6280\u80fd\u3002"}, {"question": "\u5728\u73a9\u300a\u6d82\u9e26\u8d5b\u9053\u300b\u8d85\u8fc7 100 \u5c0f\u65f6\u540e\uff0c\u54ea\u4e9b\u6838\u5fc3\u7b56\u7565\u6709\u52a9\u4e8e\u63d0\u5347\u6e38\u620f\u8fdb\u5ea6\uff1f", "answer": "\u5728\u300a\u6d82\u9e26\u8d5b\u9053\u300b\u4e2d\u73a9\u8fc7 100 \u5c0f\u65f6\u540e\uff0c\u8bf7\u5173\u6ce8\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9aa4\u4e00\u2014\u2014\u901a\u8fc7\u8bb0\u5fc6\u969c\u788d\u7269\u6a21\u5f0f\u6765\u4f18\u5316\u4f60\u7684\u8def\u7ebf\uff1b\u6b65\u9aa4\u4e8c\u2014\u2014\u4f7f\u7528\u6536\u96c6\u5230\u7684\u91d1\u5e01\u5347\u7ea7\u4f60\u7684\u89d2\u8272\u80fd\u529b\uff1b\u6b65\u9aa4\u4e09\u2014\u2014\u53c2\u4e0e\u6bcf\u65e5\u6311\u6218\u4ee5\u83b7\u5f97\u989d\u5916\u5956\u52b1\u3002\u4f8b\u5982\uff0c\u5728\"\u6c99\u6f20\u51b2\u523a\"\u5173\u5361\u4e2d\uff0c\u4e86\u89e3\u79fb\u52a8\u969c\u788d\u7269\u7684\u786e\u5207\u65f6\u95f4\u53ef\u4ee5\u907f\u514d\u751f\u547d\u635f\u5931\u3002\u6b64\u5916\uff0c\u6bd4\u8f83\u4e0d\u540c\u7684\u89d2\u8272\u5347\u7ea7\u53ef\u4ee5\u5e2e\u52a9\u4f60\u9009\u62e9\u6700\u9002\u5408\u4f60\u7684\u6e38\u620f\u98ce\u683c\u7684\u5347\u7ea7\u65b9\u6848\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u300a\u6d82\u9e26\u8d5b\u9053\u300b\u7684\u8bc4\u5206\u7cfb\u7edf\u4f1a\u504f\u5411\u67d0\u4e9b\u6e38\u620f\u98ce\u683c\uff0c\u73a9\u5bb6\u5982\u4f55\u6700\u5927\u5316\u5f97\u5206\uff1f", "answer": "\u300a\u6d82\u9e26\u8d5b\u9053\u300b\u7684\u8bc4\u5206\u7cfb\u7edf\u5956\u52b1\u7cbe\u51c6\u5ea6\u548c\u901f\u5ea6\u3002\u8981\u6700\u5927\u5316\u4f60\u7684\u5f97\u5206\uff1a\u6b65\u9aa4\u4e00\u2014\u2014\u76ee\u6807\u662f\u5b8c\u7f8e\u8fd0\u884c\uff0c\u4e0d\u78b0\u5230\u969c\u788d\u7269\uff1b\u6b65\u9aa4\u4e8c\u2014\u2014\u5c3d\u53ef\u80fd\u6536\u96c6\u91d1\u5e01\uff0c\u5c24\u5176\u662f\u5728\u5956\u52b1\u533a\u57df\uff1b\u6b65\u9aa4\u4e09\u2014\u2014\u6218\u7565\u6027\u5730\u4f7f\u7528\u9053\u5177\u3002\u4f8b\u5982\uff0c\u5728\"\u68ee\u6797\u72c2\u6b22\"\u5173\u5361\u4e2d\uff0c\u4f7f\u7528\"\u78c1\u529b\"\u9053\u5177\u53ef\u4ee5\u66f4\u6709\u6548\u5730\u6536\u96c6\u91d1\u5e01\u3002\u4e13\u6ce8\u4e8e\u8fd9\u4e9b\u5143\u7d20\uff0c\u53ef\u4ee5\u663e\u8457\u63d0\u5347\u4f60\u7684\u603b\u5f97\u5206\u3002"}, {"question": "\u300a\u6d82\u9e26\u8d5b\u9053\u300b\u4e2d\u54ea\u4e9b\u89d2\u8272\u80fd\u529b\u63d0\u4f9b\u4e86\u6700\u5927\u7684\u4f18\u52bf\uff0c\u4ee5\u53ca\u5e94\u8be5\u5982\u4f55\u8fd0\u7528\u5b83\u4eec\uff1f", "answer": "\u5728\u300a\u6d82\u9e26\u8d5b\u9053\u300b\u4e2d\uff0c\u67d0\u4e9b\u89d2\u8272\u80fd\u529b\u63d0\u4f9b\u4e86\u660e\u663e\u7684\u4f18\u52bf\u3002\u4f8b\u5982\uff0c\"\u53cc\u8df3\"\u80fd\u529b\u5141\u8bb8\u4f60\u5230\u8fbe\u66f4\u9ad8\u7684\u5e73\u53f0\u5e76\u4e14\u66f4\u6709\u6548\u5730\u907f\u5f00\u969c\u788d\u7269\u3002\u6b65\u9aa4\u4e00\u2014\u2014\u901a\u8fc7\u6536\u96c6\u8db3\u591f\u7684\u91d1\u5e01\u6765\u89e3\u9501\u80fd\u529b\uff1b\u6b65\u9aa4\u4e8c\u2014\u2014\u4e3a\u6bcf\u4e2a\u5173\u5361\u88c5\u5907\u6700\u5408\u9002\u7684\u6280\u80fd\uff1b\u6b65\u9aa4\u4e09\u2014\u2014\u5728\u4e0d\u540c\u7684\u573a\u666f\u4e2d\u7ec3\u4e60\u4f7f\u7528\u8be5\u80fd\u529b\u3002\u6bd4\u8f83\"\u62a4\u76fe\"\u548c\"\u52a0\u901f\"\u7b49\u80fd\u529b\u53ef\u4ee5\u5e2e\u52a9\u4f60\u6839\u636e\u5173\u5361\u7684\u6311\u6218\u6765\u51b3\u5b9a\u4f7f\u7528\u54ea\u4e00\u79cd\u80fd\u529b\u3002"}, {"question": "\u300a\u6d82\u9e26\u8d5b\u9053\u300b\u7684\u5173\u5361\u8bbe\u8ba1\u5982\u4f55\u5f71\u54cd\u73a9\u5bb6\u7684\u8fdb\u5ea6\uff0c\u73a9\u5bb6\u5728\u6bcf\u4e2a\u9636\u6bb5\u5e94\u8be5\u5173\u6ce8\u4ec0\u4e48\uff1f", "answer": "\u300a\u6d82\u9e26\u8d5b\u9053\u300b\u7684\u5173\u5361\u8bbe\u8ba1\u65e8\u5728\u9010\u6b65\u589e\u52a0\u96be\u5ea6\uff0c\u540c\u65f6\u5f15\u5165\u65b0\u5143\u7d20\u3002\u5728\u6bcf\u4e2a\u9636\u6bb5\uff0c\u73a9\u5bb6\u5e94\u8be5\uff1a\u6b65\u9aa4\u4e00\u2014\u2014\u6ce8\u610f\u65b0\u969c\u788d\u7269\u7684\u51fa\u73b0\uff1b\u6b65\u9aa4\u4e8c\u2014\u2014\u9002\u5e94\u4e0d\u65ad\u53d8\u5316\u7684\u73af\u5883\uff0c\u4f8b\u5982\u79fb\u52a8\u5e73\u53f0\u6216\u65f6\u95f4\u6311\u6218\uff1b\u6b65\u9aa4\u4e09\u2014\u2014\u5229\u7528\u5173\u5361\u7279\u6709\u7684\u9053\u5177\u3002\u4f8b\u5982\uff0c\u5728\"\u51b0\u6d1e\"\u5173\u5361\u4e2d\uff0c\u4f7f\u7528\"\u51b0\u978b\"\u9053\u5177\u53ef\u4ee5\u66f4\u6709\u6548\u5730\u9a7e\u9a6d\u6ed1\u6e9c\u7684\u8868\u9762\u3002\u4e86\u89e3\u8fd9\u4e9b\u8bbe\u8ba1\u5143\u7d20\u53ef\u4ee5\u589e\u5f3a\u4f60\u7684\u6e38\u620f\u8fdb\u5ea6\u3002"}, {"question": "\u300a\u6d82\u9e26\u8d5b\u9053\u300b\u7684\u79fb\u52a8\u7248\u548c PC \u7248\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff0c\u73a9\u5bb6\u5982\u4f55\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u5e73\u7a33\u8fc7\u6e21\uff1f", "answer": "\u300a\u6d82\u9e26\u8d5b\u9053\u300b\u7684\u79fb\u52a8\u7248\u548c PC \u7248\u7684\u5173\u952e\u533a\u522b\u5728\u4e8e\u63a7\u5236\u65b9\u6848\u548c\u5c4f\u5e55\u5206\u8fa8\u7387\u3002\u4e3a\u4e86\u5e73\u7a33\u8fc7\u6e21\uff1a\u6b65\u9aa4\u4e00\u2014\u2014\u719f\u6089\u63a7\u5236\u65b9\u5f0f\u4e0a\u7684\u5dee\u5f02\uff08\u89e6\u6478 vs. \u952e\u76d8\uff09\uff1b\u6b65\u9aa4\u4e8c\u2014\u2014\u8c03\u6574\u6e38\u620f\u8bbe\u7f6e\u4ee5\u5339\u914d\u4f60\u504f\u597d\u7684\u5e73\u53f0\uff1b\u6b65\u9aa4\u4e09\u2014\u2014\u4f7f\u7528\u4e91\u7aef\u4fdd\u5b58\u529f\u80fd\u540c\u6b65\u4f60\u7684\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4e60\u60ef\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\u6ed1\u52a8\uff0c\u7ec3\u4e60\u5728 PC \u4e0a\u4f7f\u7528\u65b9\u5411\u952e\uff0c\u4ee5\u4fdd\u6301\u4f60\u7684\u6e38\u620f\u8868\u73b0\u3002\u8fd9\u79cd\u5bf9\u6bd4\u786e\u4fdd\u4e86\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u7684\u5e73\u6ed1\u8fc7\u6e21\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u53d1\u73b0\u300a\u6d82\u9e26\u8d5b\u9053\u300b\u4e2d\u7684\u9690\u85cf\u5185\u5bb9\uff0c\u8fd9\u4e9b\u79d8\u5bc6\u5956\u52b1\u4e86\u4ec0\u4e48\uff1f", "answer": "\u8981\u53d1\u73b0\u300a\u6d82\u9e26\u8d5b\u9053\u300b\u4e2d\u7684\u9690\u85cf\u5185\u5bb9\uff1a\u6b65\u9aa4\u4e00\u2014\u2014\u63a2\u7d22\u6bcf\u4e2a\u5173\u5361\u4e2d\u4e0d\u5e38\u7528\u7684\u533a\u57df\uff1b\u6b65\u9aa4\u4e8c\u2014\u2014\u5bfb\u627e\u7ec6\u5fae\u7684\u89c6\u89c9\u7ebf\u7d22\uff0c\u4f8b\u5982\u7565\u5fae\u4e0d\u540c\u7684\u7eb9\u7406\u6216\u989c\u8272\uff1b\u6b65\u9aa4\u4e09\u2014\u2014\u4f7f\u7528\u7279\u5b9a\u80fd\u529b\u8bbf\u95ee\u8fd9\u4e9b\u533a\u57df\u3002\u4f8b\u5982\uff0c\u5728\"\u795e\u79d8\u5c71\"\u5173\u5361\u4e2d\uff0c\u4f7f\u7528\"\u53cc\u8df3\"\u80fd\u529b\u53ef\u4ee5\u5e2e\u52a9\u4f60\u5230\u8fbe\u4e00\u4e2a\u9690\u85cf\u7684\u6d1e\u7a74\uff0c\u91cc\u9762\u5145\u6ee1\u4e86\u7a00\u6709\u91d1\u5e01\u548c\u9053\u5177\u3002\u8fd9\u4e9b\u79d8\u5bc6\u901a\u5e38\u63d0\u4f9b\u4e30\u539a\u7684\u5956\u52b1\uff0c\u589e\u5f3a\u4f60\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u5728\u300a\u6d82\u9e26\u8d5b\u9053\u300b\u4e2d\u6709\u6548\u7ba1\u7406\u8d44\u6e90\u7684\u6700\u4f73\u65b9\u6cd5\u662f\u4ec0\u4e48\uff0c\u73a9\u5bb6\u5982\u4f55\u786e\u4fdd\u4ed6\u4eec\u6709\u8db3\u591f\u7684\u5347\u7ea7\u91d1\u5e01\uff1f", "answer": "\u300a\u6d82\u9e26\u8d5b\u9053\u300b\u4e2d\u6709\u6548\u7684\u8d44\u6e90\u7ba1\u7406\u5305\u62ec\uff1a\u6b65\u9aa4\u4e00\u2014\u2014\u4f18\u5148\u5728\u6bcf\u4e2a\u5173\u5361\u6536\u96c6\u91d1\u5e01\uff1b\u6b65\u9aa4\u4e8c\u2014\u2014\u907f\u514d\u4e0d\u5fc5\u8981\u7684\u8d2d\u4e70\uff0c\u4e13\u6ce8\u4e8e\u5fc5\u8981\u7684\u5347\u7ea7\uff1b\u6b65\u9aa4\u4e09\u2014\u2014\u53c2\u4e0e\u6d3b\u52a8\u548c\u6311\u6218\u4ee5\u83b7\u5f97\u989d\u5916\u91d1\u5e01\u3002\u4f8b\u5982\uff0c\u5728\"\u57ce\u5e02\u51b2\u523a\"\u5173\u5361\u4e2d\uff0c\u4e13\u6ce8\u4e8e\u5956\u52b1\u533a\u57df\u6536\u96c6\u91d1\u5e01\u53ef\u4ee5\u663e\u8457\u589e\u52a0\u4f60\u7684\u91d1\u5e01\u6570\u91cf\u3002\u9075\u5faa\u8fd9\u4e9b\u6b65\u9aa4\uff0c\u4f60\u53ef\u4ee5\u786e\u4fdd\u4f60\u62e5\u6709\u8db3\u591f\u7684\u8d44\u6e90\u8fdb\u884c\u5fc5\u8981\u7684\u5347\u7ea7\u3002"}, {"question": "\u300a\u6d82\u9e26\u8d5b\u9053\u300b\u7684\u96be\u5ea6\u9012\u589e\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u73a9\u5bb6\u53ef\u4ee5\u505a\u4e9b\u4ec0\u4e48\u6765\u51c6\u5907\u66f4\u5177\u6311\u6218\u6027\u7684\u5173\u5361\uff1f", "answer": "\u300a\u6d82\u9e26\u8d5b\u9053\u300b\u7684\u96be\u5ea6\u9012\u589e\u4f1a\u968f\u7740\u4f60\u7684\u8fdb\u6b65\u800c\u5f15\u5165\u66f4\u590d\u6742\u7684\u969c\u788d\u7269\u548c\u66f4\u5feb\u7684\u6e38\u620f\u8282\u594f\u3002\u4e3a\u4e86\u505a\u597d\u51c6\u5907\uff1a\u6b65\u9aa4\u4e00\u2014\u2014\u5728\u65e9\u671f\u5173\u5361\u4e2d\u638c\u63e1\u57fa\u672c\u673a\u5236\uff1b\u6b65\u9aa4\u4e8c\u2014\u2014\u9010\u6e10\u63d0\u9ad8\u4f60\u7684\u901f\u5ea6\u548c\u7cbe\u51c6\u5ea6\uff1b\u6b65\u9aa4\u4e09\u2014\u2014\u8fd0\u7528\u9ad8\u7ea7\u7b56\u7565\uff0c\u4f8b\u5982\u8bb0\u4f4f\u969c\u788d\u7269\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u5728\"\u706b\u5c71\u5ce1\u8c37\"\u5173\u5361\u4e2d\uff0c\u7ec3\u4e60\u7194\u5ca9\u6d41\u7684\u65f6\u95f4\u53ef\u4ee5\u5e2e\u52a9\u4f60\u66f4\u6709\u6548\u5730\u9a7e\u9a6d\u8be5\u5173\u5361\u3002\u7406\u89e3\u6b64\u7f29\u653e\u7cfb\u7edf\u53ef\u4ee5\u5e2e\u52a9\u4f60\u9002\u5e94\u4e0d\u65ad\u589e\u52a0\u7684\u6311\u6218\u3002"}, {"question": "\u5728\u300a\u6d82\u9e26\u8d5b\u9053\u300b\u7684\u6392\u884c\u699c\u4e2d\u83b7\u5f97\u9ad8\u5206\u7684\u6700\u4f73\u5b9e\u8df5\u662f\u4ec0\u4e48\uff0c\u73a9\u5bb6\u5982\u4f55\u4fdd\u6301\u826f\u597d\u7684\u8868\u73b0\uff1f", "answer": "\u8981\u5728\u300a\u6d82\u9e26\u8d5b\u9053\u300b\u7684\u6392\u884c\u699c\u4e2d\u83b7\u5f97\u9ad8\u5206\uff1a\u6b65\u9aa4\u4e00\u2014\u2014\u4e13\u6ce8\u4e8e\u96f6\u5931\u8bef\u7684\u5b8c\u7f8e\u8fd0\u884c\uff1b\u6b65\u9aa4\u4e8c\u2014\u2014\u6700\u5927\u9650\u5ea6\u5730\u6536\u96c6\u91d1\u5e01\uff0c\u5c24\u5176\u662f\u5728\u5956\u52b1\u533a\u57df\uff1b\u6b65\u9aa4\u4e09\u2014\u2014\u6218\u7565\u6027\u5730\u4f7f\u7528\u9053\u5177\u6765\u589e\u5f3a\u4f60\u7684\u8868\u73b0\u3002\u4f8b\u5982\uff0c\u5728\"\u5929\u7a7a\u4e4b\u9ad8\"\u5173\u5361\u4e2d\uff0c\u4f7f\u7528\"\u55b7\u6c14\u80cc\u5305\"\u9053\u5177\u53ef\u4ee5\u5e2e\u52a9\u4f60\u66f4\u6709\u6548\u5730\u6536\u96c6\u91d1\u5e01\u5e76\u907f\u5f00\u969c\u788d\u7269\u3002\u6301\u7eed\u5e94\u7528\u8fd9\u4e9b\u65b9\u6cd5\u5c06\u63d0\u9ad8\u4f60\u5728\u6392\u884c\u699c\u4e0a\u540d\u5217\u524d\u8305\u7684\u673a\u4f1a\u3002"}]
[{"question": "\u5982\u4f55\u5728\u300a\u5857\u9d09\u4e4b\u8def\u300b\u5feb\u901f\u4e0a\u624b\u4e26\u638c\u63e1\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u958b\u59cb\u904a\u73a9\u300a\u5857\u9d09\u4e4b\u8def\u300b\uff0c\u8acb\u6309\u7167\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u719f\u6089\u4e3b\u9078\u55ae\u4e26\u9078\u64c7\u300e\u958b\u59cb\u904a\u6232\u300f\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u65b9\u5411\u9375\u6216\u6ed1\u52d5\u624b\u52e2\u4f86\u63a7\u5236\u4f60\u7684\u89d2\u8272\u3002\u6b65\u9a5f3 - \u8490\u96c6\u786c\u5e63\u4e26\u907f\u958b\u969c\u7919\u7269\u4ee5\u53d6\u5f97\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u95dc\uff0c\u4f60\u53ef\u4ee5\u7df4\u7fd2\u8490\u96c6 10 \u500b\u786c\u5e63\uff0c\u800c\u4e0d\u8981\u649e\u5230\u4efb\u4f55\u969c\u7919\u7269\u3002\u9019\u5c07\u6709\u52a9\u65bc\u4f60\u7406\u89e3\u57fa\u672c\u904a\u6232\u6a5f\u5236\u4e26\u63d0\u5347\u4f60\u7684\u63a7\u5236\u6280\u5de7\u3002"}, {"question": "\u5728\u904a\u73a9\u300a\u5857\u9d09\u4e4b\u8def\u300b\u8d85\u904e 100 \u5c0f\u6642\u5f8c\uff0c\u6709\u54ea\u4e9b\u5fc5\u8981\u7684\u9032\u968e\u7b56\u7565\uff1f", "answer": "\u5728\u300a\u5857\u9d09\u4e4b\u8def\u300b\u904a\u73a9\u8d85\u904e 100 \u5c0f\u6642\u5f8c\uff0c\u8acb\u5c08\u6ce8\u65bc\u9019\u4e9b\u7b56\u7565\uff1a\u6b65\u9a5f1 - \u8a18\u4f4f\u969c\u7919\u7269\u7684\u898f\u5f8b\uff0c\u4ee5\u512a\u5316\u4f60\u7684\u8def\u7dda\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u6536\u96c6\u5230\u7684\u786c\u5e63\u4f86\u5347\u7d1a\u4f60\u7684\u89d2\u8272\u80fd\u529b\u3002\u6b65\u9a5f3 - \u53c3\u8207\u6bcf\u65e5\u6311\u6230\u4ee5\u7372\u5f97\u984d\u5916\u734e\u52f5\u3002\u4f8b\u5982\uff0c\u5728\u300e\u6c99\u6f20\u885d\u523a\u300f\u95dc\u5361\u4e2d\uff0c\u6e96\u78ba\u638c\u63e1\u79fb\u52d5\u969c\u7919\u7269\u7684\u6642\u9593\u53ef\u4ee5\u907f\u514d\u640d\u5931\u751f\u547d\u3002\u6b64\u5916\uff0c\u6bd4\u8f03\u4e0d\u540c\u7684\u89d2\u8272\u5347\u7d1a\uff0c\u53ef\u4ee5\u5e6b\u52a9\u4f60\u9078\u64c7\u6700\u9069\u5408\u4f60\u7684\u904a\u6232\u98a8\u683c\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u300a\u5857\u9d09\u4e4b\u8def\u300b\u7684\u5206\u6578\u7cfb\u7d71\u6703\u504f\u597d\u67d0\u4e9b\u904a\u6232\u98a8\u683c\uff0c\u4ee5\u53ca\u73a9\u5bb6\u5982\u4f55\u6700\u5927\u5316\u5206\u6578\uff1f", "answer": "\u300a\u5857\u9d09\u4e4b\u8def\u300b\u7684\u5206\u6578\u7cfb\u7d71\u734e\u52f5\u7cbe\u6e96\u5ea6\u548c\u901f\u5ea6\u3002\u8981\u6700\u5927\u5316\u4f60\u7684\u5206\u6578\uff1a\u6b65\u9a5f1 - \u5617\u8a66\u5728\u4e0d\u78b0\u649e\u969c\u7919\u7269\u7684\u72c0\u614b\u4e0b\u5b8c\u6210\u5b8c\u7f8e\u8dd1\u9177\u3002\u6b65\u9a5f2 - \u76e1\u53ef\u80fd\u8490\u96c6\u6240\u6709\u786c\u5e63\uff0c\u7279\u5225\u662f\u5728\u734e\u52f5\u5340\u57df\u3002\u6b65\u9a5f3 - \u6709\u7b56\u7565\u5730\u904b\u7528\u9053\u5177\u3002\u4f8b\u5982\uff0c\u5728\u300e\u68ee\u6797\u72c2\u5954\u300f\u95dc\u5361\u4e2d\uff0c\u4f7f\u7528\u300e\u5438\u9435\u300f\u9053\u5177\u53ef\u4ee5\u66f4\u6709\u6548\u5730\u8490\u96c6\u786c\u5e63\u3002\u900f\u904e\u5c08\u6ce8\u65bc\u9019\u4e9b\u5143\u7d20\uff0c\u4f60\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u4f60\u7684\u7e3d\u5206\u6578\u3002"}, {"question": "\u300a\u5857\u9d09\u4e4b\u8def\u300b\u4e2d\u54ea\u4e9b\u89d2\u8272\u80fd\u529b\u63d0\u4f9b\u6700\u5927\u7684\u512a\u52e2\uff0c\u4ee5\u53ca\u5b83\u5011\u61c9\u8a72\u5982\u4f55\u904b\u7528\uff1f", "answer": "\u5728\u300a\u5857\u9d09\u4e4b\u8def\u300b\u4e2d\uff0c\u67d0\u4e9b\u89d2\u8272\u80fd\u529b\u63d0\u4f9b\u660e\u986f\u7684\u512a\u52e2\u3002\u4f8b\u5982\uff0c\u300e\u96d9\u8df3\u300f\u80fd\u529b\u5141\u8a31\u4f60\u5230\u9054\u66f4\u9ad8\u7684\u5e73\u53f0\u4e26\u66f4\u6709\u6548\u5730\u907f\u958b\u969c\u7919\u7269\u3002\u6b65\u9a5f1 - \u901a\u904e\u6536\u96c6\u8db3\u5920\u7684\u786c\u5e63\u4f86\u89e3\u9396\u80fd\u529b\u3002\u6b65\u9a5f2 - \u70ba\u6bcf\u500b\u95dc\u5361\u914d\u5099\u6700\u5408\u9069\u7684\u80fd\u529b\u3002\u6b65\u9a5f3 - \u5728\u4e0d\u540c\u7684\u5834\u666f\u4e2d\u7df4\u7fd2\u4f7f\u7528\u8a72\u80fd\u529b\u3002\u6bd4\u8f03\u300e\u76fe\u724c\u300f\u548c\u300e\u52a0\u901f\u300f\u7b49\u80fd\u529b\u53ef\u4ee5\u5e6b\u52a9\u4f60\u6839\u64da\u95dc\u5361\u7684\u6311\u6230\u6c7a\u5b9a\u4f7f\u7528\u54ea\u500b\u80fd\u529b\u3002"}, {"question": "\u300a\u5857\u9d09\u4e4b\u8def\u300b\u7684\u95dc\u5361\u8a2d\u8a08\u5982\u4f55\u5f71\u97ff\u73a9\u5bb6\u7684\u9032\u5ea6\uff0c\u4ee5\u53ca\u73a9\u5bb6\u5728\u6bcf\u500b\u968e\u6bb5\u61c9\u8a72\u5c08\u6ce8\u65bc\u54ea\u4e9b\u65b9\u9762\uff1f", "answer": "\u300a\u5857\u9d09\u4e4b\u8def\u300b\u7684\u95dc\u5361\u8a2d\u8a08\u65e8\u5728\u9010\u6b65\u63d0\u5347\u96e3\u5ea6\uff0c\u540c\u6642\u5f15\u5165\u65b0\u5143\u7d20\u3002\u5728\u6bcf\u500b\u968e\u6bb5\uff0c\u73a9\u5bb6\u61c9\u8a72\uff1a\u6b65\u9a5f1 - \u6ce8\u610f\u65b0\u969c\u7919\u7269\u7684\u51fa\u73fe\u3002\u6b65\u9a5f2 - \u9069\u61c9\u4e0d\u65b7\u8b8a\u5316\u7684\u74b0\u5883\uff0c\u4f8b\u5982\u79fb\u52d5\u5e73\u53f0\u6216\u9650\u6642\u6311\u6230\u3002\u6b65\u9a5f3 - \u5229\u7528\u95dc\u5361\u7279\u5b9a\u7684\u9053\u5177\u3002\u4f8b\u5982\uff0c\u5728\u300e\u51b0\u6d1e\u300f\u95dc\u5361\u4e2d\uff0c\u4f7f\u7528\u300e\u6e9c\u51b0\u300f\u9053\u5177\u53ef\u4ee5\u5e6b\u52a9\u4f60\u66f4\u6709\u6548\u5730\u7a7f\u904e\u6ed1\u6e9c\u7684\u8868\u9762\u3002\u7406\u89e3\u9019\u4e9b\u8a2d\u8a08\u5143\u7d20\u53ef\u4ee5\u63d0\u5347\u4f60\u7684\u9032\u5ea6\u3002"}, {"question": "\u300a\u5857\u9d09\u4e4b\u8def\u300b\u7684\u884c\u52d5\u88dd\u7f6e\u7248\u548c\u500b\u4eba\u96fb\u8166\u7248\u672c\u4e4b\u9593\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff0c\u4ee5\u53ca\u73a9\u5bb6\u5982\u4f55\u9806\u5229\u5730\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u9593\u5207\u63db\uff1f", "answer": "\u300a\u5857\u9d09\u4e4b\u8def\u300b\u884c\u52d5\u88dd\u7f6e\u7248\u548c\u500b\u4eba\u96fb\u8166\u7248\u672c\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u5728\u65bc\u63a7\u5236\u65b9\u6848\u548c\u87a2\u5e55\u89e3\u6790\u5ea6\u3002\u8981\u9806\u5229\u5207\u63db\uff1a\u6b65\u9a5f1 - \u719f\u6089\u63a7\u5236\u65b9\u5f0f\u7684\u5dee\u7570\uff08\u89f8\u63a7 vs. \u9375\u76e4\uff09\u3002\u6b65\u9a5f2 - \u8abf\u6574\u904a\u6232\u8a2d\u5b9a\u4ee5\u5339\u914d\u4f60\u504f\u597d\u7684\u5e73\u53f0\u3002\u6b65\u9a5f3 - \u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u540c\u6b65\u4f60\u7684\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u7fd2\u6163\u5728\u884c\u52d5\u88dd\u7f6e\u4e0a\u6ed1\u52d5\uff0c\u8acb\u7df4\u7fd2\u5728\u500b\u4eba\u96fb\u8166\u4e0a\u4f7f\u7528\u65b9\u5411\u9375\u4f86\u7dad\u6301\u4f60\u7684\u8868\u73fe\u3002\u9019\u7a2e\u6bd4\u8f03\u78ba\u4fdd\u4e86\u4e0d\u540c\u5e73\u53f0\u4e4b\u9593\u7684\u9806\u66a2\u8f49\u63db\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u5857\u9d09\u4e4b\u8def\u300b\u4e2d\u767c\u73fe\u96b1\u85cf\u5167\u5bb9\uff0c\u4ee5\u53ca\u9019\u4e9b\u79d8\u5bc6\u63d0\u4f9b\u54ea\u4e9b\u734e\u52f5\uff1f", "answer": "\u8981\u767c\u73fe\u300a\u5857\u9d09\u4e4b\u8def\u300b\u4e2d\u7684\u96b1\u85cf\u5167\u5bb9\uff1a\u6b65\u9a5f1 - \u5728\u6bcf\u500b\u95dc\u5361\u4e2d\u63a2\u7d22\u504f\u9060\u5340\u57df\u3002\u6b65\u9a5f2 - \u6ce8\u610f\u5fae\u5999\u7684\u8996\u89ba\u63d0\u793a\uff0c\u4f8b\u5982\u7565\u5fae\u4e0d\u540c\u7684\u7d0b\u7406\u6216\u984f\u8272\u3002\u6b65\u9a5f3 - \u4f7f\u7528\u7279\u5b9a\u80fd\u529b\u4f86\u9032\u5165\u9019\u4e9b\u5340\u57df\u3002\u4f8b\u5982\uff0c\u5728\u300e\u795e\u79d8\u5c71\u300f\u95dc\u5361\u4e2d\uff0c\u4f7f\u7528\u300e\u96d9\u8df3\u300f\u80fd\u529b\u53ef\u4ee5\u5e6b\u52a9\u4f60\u5230\u9054\u96b1\u85cf\u7684\u6d1e\u7a74\uff0c\u88e1\u9762\u5145\u6eff\u4e86\u7a00\u6709\u786c\u5e63\u548c\u9053\u5177\u3002\u9019\u4e9b\u79d8\u5bc6\u901a\u5e38\u63d0\u4f9b\u53ef\u89c0\u7684\u734e\u52f5\uff0c\u589e\u5f37\u4f60\u7684\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u5728\u300a\u5857\u9d09\u4e4b\u8def\u300b\u4e2d\u6709\u6548\u7ba1\u7406\u8cc7\u6e90\u7684\u6700\u4f73\u65b9\u5f0f\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u73a9\u5bb6\u5982\u4f55\u78ba\u4fdd\u4ed6\u5011\u6709\u8db3\u5920\u7684\u786c\u5e63\u9032\u884c\u5347\u7d1a\uff1f", "answer": "\u5728\u300a\u5857\u9d09\u4e4b\u8def\u300b\u4e2d\uff0c\u6709\u6548\u7ba1\u7406\u8cc7\u6e90\u5305\u62ec\uff1a\u6b65\u9a5f1 - \u5728\u6bcf\u500b\u95dc\u5361\u4e2d\u512a\u5148\u8490\u96c6\u786c\u5e63\u3002\u6b65\u9a5f2 - \u907f\u514d\u4e0d\u5fc5\u8981\u7684\u8cfc\u8cb7\uff0c\u4e26\u5c08\u6ce8\u65bc\u5fc5\u8981\u7684\u5347\u7d1a\u3002\u6b65\u9a5f3 - \u53c3\u8207\u6d3b\u52d5\u548c\u6311\u6230\u4ee5\u7372\u5f97\u984d\u5916\u786c\u5e63\u3002\u4f8b\u5982\uff0c\u5728\u300e\u57ce\u5e02\u885d\u523a\u300f\u95dc\u5361\u4e2d\uff0c\u5c08\u6ce8\u65bc\u734e\u52f5\u5340\u57df\u7684\u786c\u5e63\u6536\u96c6\u53ef\u4ee5\u986f\u8457\u589e\u52a0\u4f60\u7684\u786c\u5e63\u6578\u91cf\u3002\u900f\u904e\u9075\u5faa\u9019\u4e9b\u6b65\u9a5f\uff0c\u4f60\u53ef\u4ee5\u78ba\u4fdd\u4f60\u6709\u8db3\u5920\u7684\u8cc7\u6e90\u9032\u884c\u5fc5\u8981\u7684\u5347\u7d1a\u3002"}, {"question": "\u300a\u5857\u9d09\u4e4b\u8def\u300b\u7684\u96e3\u5ea6\u63d0\u5347\u6a5f\u5236\u5982\u4f55\u904b\u4f5c\uff0c\u73a9\u5bb6\u53ef\u4ee5\u505a\u4e9b\u4ec0\u9ebc\u6e96\u5099\u4ee5\u61c9\u5c0d\u66f4\u5177\u6311\u6230\u6027\u7684\u95dc\u5361\uff1f", "answer": "\u300a\u5857\u9d09\u4e4b\u8def\u300b\u7684\u96e3\u5ea6\u63d0\u5347\u6a5f\u5236\u6703\u96a8\u8457\u4f60\u7684\u9032\u5ea6\u800c\u5f15\u5165\u66f4\u8907\u96dc\u7684\u969c\u7919\u7269\u548c\u66f4\u5feb\u7684\u904a\u6232\u7bc0\u594f\u3002\u8981\u6e96\u5099\uff1a\u6b65\u9a5f1 - \u5728\u8f03\u65e9\u7684\u95dc\u5361\u4e2d\u638c\u63e1\u57fa\u672c\u6a5f\u5236\u3002\u6b65\u9a5f2 - \u9010\u6b65\u63d0\u5347\u4f60\u7684\u901f\u5ea6\u548c\u7cbe\u6e96\u5ea6\u3002\u6b65\u9a5f3 - \u5229\u7528\u5148\u9032\u7684\u7b56\u7565\uff0c\u4f8b\u5982\u8a18\u61b6\u969c\u7919\u7269\u7684\u898f\u5f8b\u3002\u4f8b\u5982\uff0c\u5728\u300e\u706b\u5c71\u8c37\u300f\u95dc\u5361\u4e2d\uff0c\u7df4\u7fd2\u7194\u5ca9\u6d41\u52d5\u7684\u6642\u9593\u53ef\u4ee5\u5e6b\u52a9\u4f60\u66f4\u6709\u6548\u5730\u5b8c\u6210\u95dc\u5361\u3002\u4e86\u89e3\u63d0\u5347\u6a5f\u5236\u53ef\u4ee5\u5e6b\u52a9\u4f60\u9069\u61c9\u8d8a\u4f86\u8d8a\u5927\u7684\u6311\u6230\u3002"}, {"question": "\u5728\u300a\u5857\u9d09\u4e4b\u8def\u300b\u7684\u6392\u884c\u699c\u4e0a\u53d6\u5f97\u9ad8\u5206\u7684\u6700\u4f73\u505a\u6cd5\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u73a9\u5bb6\u5982\u4f55\u6301\u7e8c\u8868\u73fe\u826f\u597d\uff1f", "answer": "\u8981\u5728\u300a\u5857\u9d09\u4e4b\u8def\u300b\u7684\u6392\u884c\u699c\u4e0a\u53d6\u5f97\u9ad8\u5206\uff1a\u6b65\u9a5f1 - \u5c08\u6ce8\u65bc\u6c92\u6709\u932f\u8aa4\u7684\u5b8c\u7f8e\u8dd1\u9177\u3002\u6b65\u9a5f2 - \u6700\u5927\u9650\u5ea6\u5730\u6536\u96c6\u786c\u5e63\uff0c\u7279\u5225\u662f\u5728\u734e\u52f5\u5340\u57df\u3002\u6b65\u9a5f3 - \u6709\u7b56\u7565\u5730\u4f7f\u7528\u9053\u5177\u4f86\u63d0\u5347\u4f60\u7684\u8868\u73fe\u3002\u4f8b\u5982\uff0c\u5728\u300e\u9ad8\u7a7a\u300f\u95dc\u5361\u4e2d\uff0c\u4f7f\u7528\u300e\u5674\u5c04\u80cc\u5305\u300f\u9053\u5177\u53ef\u4ee5\u5e6b\u52a9\u4f60\u66f4\u6709\u6548\u5730\u6536\u96c6\u786c\u5e63\u548c\u907f\u958b\u969c\u7919\u7269\u3002\u6301\u7e8c\u61c9\u7528\u9019\u4e9b\u505a\u6cd5\u5c07\u63d0\u9ad8\u4f60\u5728\u6392\u884c\u699c\u4e0a\u7684\u6a5f\u7387\u3002"}]
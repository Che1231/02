[{"question": "\u30b9\u30ea\u30c3\u30af\u30de\u30f3\u30b9\u30af\u30fc\u30eb\u30e9\u30f3\u521d\u5fc3\u8005\u306f\u3001\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u52b9\u679c\u7684\u306b\u5236\u5fa1\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30b9\u30ea\u30c3\u30af\u30de\u30f3\u30b9\u30af\u30fc\u30eb\u30e9\u30f3\u3067\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u52b9\u679c\u7684\u306b\u5236\u5fa1\u3059\u308b\u3053\u3068\u306f\u91cd\u8981\u3067\u3059\u3002\u307e\u305a\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u306b\u6163\u308c\u308b\u3053\u3068\u304b\u3089\u59cb\u3081\u307e\u3059\u3002\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u79fb\u52d5\u3059\u308b\u306b\u306f\u5de6\u307e\u305f\u306f\u53f3\u306b\u30b9\u30ef\u30a4\u30d7\u3057\u3001\u30b8\u30e3\u30f3\u30d7\u3059\u308b\u306b\u306f\u4e0a\u306b\u30b9\u30ef\u30a4\u30d7\u3057\u3001\u30b9\u30e9\u30a4\u30c9\u3059\u308b\u306b\u306f\u4e0b\u306b\u30b9\u30ef\u30a4\u30d7\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u969c\u5bb3\u7269\u306b\u8fd1\u3065\u304f\u3068\u3001\u305d\u308c\u3092\u98db\u3073\u8d8a\u3048\u308b\u305f\u3081\u306b\u4e0a\u306b\u30b9\u30ef\u30a4\u30d7\u3057\u307e\u3059\u3002\u521d\u671f\u306e\u30ec\u30d9\u30eb\u3067\u3053\u308c\u3089\u306e\u52d5\u4f5c\u3092\u7df4\u7fd2\u3057\u3066\u7b4b\u8089\u306e\u8a18\u61b6\u3092\u69cb\u7bc9\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3055\u3089\u306b\u3001\u969c\u5bb3\u7269\u3092\u30b9\u30e0\u30fc\u30ba\u306b\u56de\u907f\u3059\u308b\u305f\u3081\u306b\u3001\u30b9\u30ef\u30a4\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u3089\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3068\u3001\u3088\u308a\u9ad8\u5ea6\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u305f\u3081\u306e\u5f37\u3044\u57fa\u76e4\u304c\u7bc9\u304b\u308c\u308b\u3067\u3057\u3087\u3046\u3002"}, {"question": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u30b9\u30ea\u30c3\u30af\u30de\u30f3\u30b9\u30af\u30fc\u30eb\u30e9\u30f3\u3067\u9ad8\u5f97\u70b9\u3092\u53d6\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u30b9\u30ea\u30c3\u30af\u30de\u30f3\u30b9\u30af\u30fc\u30eb\u30e9\u30f3\u3067\u9ad8\u5f97\u70b9\u3092\u53d6\u308b\u306b\u306f\u3001\u9ad8\u5ea6\u306a\u6226\u7565\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b3\u30a4\u30f3\u3068\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u53ce\u96c6\u3059\u308b\u3053\u3068\u306b\u91cd\u70b9\u3092\u7f6e\u3044\u3066\u304f\u3060\u3055\u3044\u3002\u305d\u308c\u3089\u306f\u30b9\u30b3\u30a2\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u4e2d\u65ad\u3059\u308b\u3053\u3068\u306a\u304f\u9ad8\u901f\u30e9\u30f3\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u3001\u30b8\u30e3\u30f3\u30d7\u3068\u30b9\u30e9\u30a4\u30c9\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5b8c\u74a7\u306b\u30de\u30b9\u30bf\u30fc\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b3\u30a4\u30f3\u53ce\u96c6\u3092\u6700\u5927\u5316\u3059\u308b\u305f\u3081\u306b\u3001\u30c0\u30d6\u30eb\u30b8\u30e3\u30f3\u30d7\u3068\u78c1\u77f3\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u6226\u7565\u7684\u306b\u6d3b\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u524d\u65b9\u306e\u30b3\u30a4\u30f3\u306e\u584a\u304c\u898b\u3048\u305f\u3089\u3001\u78c1\u77f3\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u30a2\u30af\u30c6\u30a3\u30d6\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u3089\u306e\u30c6\u30af\u30cb\u30c3\u30af\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3001\u7740\u5b9f\u306b\u9ad8\u5f97\u70b9\u3092\u53d6\u308a\u3001\u30e9\u30f3\u30ad\u30f3\u30b0\u4e0a\u4f4d\u3092\u76ee\u6307\u305b\u307e\u3059\u3002"}, {"question": "\u306a\u305c\u30b9\u30ea\u30c3\u30af\u30de\u30f3\u30b9\u30af\u30fc\u30eb\u30e9\u30f3\u306e\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u7279\u5b9a\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4ed6\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3088\u308a\u3082\u512a\u9047\u3059\u308b\u306e\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30ea\u30c3\u30af\u30de\u30f3\u30b9\u30af\u30fc\u30eb\u30e9\u30f3\u306e\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3078\u306e\u6709\u52b9\u6027\u3068\u5f71\u97ff\u306b\u57fa\u3065\u3044\u3066\u3001\u7279\u5b9a\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u512a\u9047\u3059\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u78c1\u77f3\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u975e\u5e38\u306b\u512a\u9047\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u3042\u308b\u7bc4\u56f2\u5185\u306e\u30b3\u30a4\u30f3\u3092\u81ea\u52d5\u7684\u306b\u53ce\u96c6\u3059\u308b\u305f\u3081\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u969c\u5bb3\u7269\u306e\u56de\u907f\u306b\u96c6\u4e2d\u3067\u304d\u307e\u3059\u3002\u540c\u69d8\u306b\u3001\u30c0\u30d6\u30eb\u30b8\u30e3\u30f3\u30d7\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u3001\u8907\u96d1\u306a\u969c\u5bb3\u7269\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u514b\u670d\u3059\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u3053\u308c\u3089\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u7d4c\u9a13\u3092\u5f37\u5316\u3057\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u53d6\u308c\u305f\u6311\u6226\u3092\u63d0\u4f9b\u3059\u308b\u305f\u3081\u306b\u6226\u7565\u7684\u306b\u914d\u7f6e\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u30e9\u30f3\u4e2d\u306b\u305d\u308c\u3089\u3092\u6700\u9069\u306b\u4f7f\u7528\u3059\u308b\u65b9\u6cd5\u304c\u308f\u304b\u308a\u307e\u3059\u3002"}, {"question": "\u30b9\u30ea\u30c3\u30af\u30de\u30f3\u30b9\u30af\u30fc\u30eb\u30e9\u30f3\u3067\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u6700\u3082\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u30b7\u30b9\u30c6\u30e0\u8a2d\u5b9a\u306f\u3069\u308c\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30ea\u30c3\u30af\u30de\u30f3\u30b9\u30af\u30fc\u30eb\u30e9\u30f3\u3067\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u30b7\u30b9\u30c6\u30e0\u8a2d\u5b9a\u304c\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u5927\u304d\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u54c1\u8cea\u306f\u4e3b\u8981\u306a\u8981\u56e0\u3067\u3059\u3002\u305d\u308c\u3092\u4e0b\u3052\u308b\u3068\u3001\u6027\u80fd\u306e\u4f4e\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u30d5\u30ec\u30fc\u30e0\u30ec\u30fc\u30c8\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u30a2\u30d7\u30ea\u3092\u7121\u52b9\u5316\u3057\u3001\u5341\u5206\u306a\u30b9\u30c8\u30ec\u30fc\u30b8\u5bb9\u91cf\u3092\u78ba\u4fdd\u3059\u308b\u3068\u3001\u5168\u4f53\u7684\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u53e4\u3044\u30b9\u30de\u30fc\u30c8\u30d5\u30a9\u30f3\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u300c\u9ad8\u300d\u304b\u3089\u300c\u4e2d\u300d\u306b\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u54c1\u8cea\u3092\u4e0b\u3052\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u30b9\u30e0\u30fc\u30ba\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5b9f\u73fe\u3059\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u30b2\u30fc\u30e0\u3092\u6700\u65b0\u30d0\u30fc\u30b8\u30e7\u30f3\u306b\u5b9a\u671f\u7684\u306b\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3059\u308b\u3053\u3068\u3082\u3001\u6700\u9069\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3068\u6700\u65b0\u306e\u6a5f\u80fd\u3084\u30d0\u30b0\u4fee\u6b63\u3078\u306e\u30a2\u30af\u30bb\u30b9\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002"}, {"question": "\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u30b9\u30ea\u30c3\u30af\u30de\u30f3\u30b9\u30af\u30fc\u30eb\u30e9\u30f3\u306e\u9032\u6357\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u30b9\u30ea\u30c3\u30af\u30de\u30f3\u30b9\u30af\u30fc\u30eb\u30e9\u30f3\u306e\u9032\u6357\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u306e\u306f\u7c21\u5358\u3067\u3059\u3002\u307e\u305a\u3001\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u591a\u304f\u306e\u5834\u5408\u3001\u3053\u308c\u306fGoogle Play\u307e\u305f\u306fApple ID\u3067\u3059\u3002\u30b2\u30fc\u30e0\u306e\u8a2d\u5b9a\u306b\u79fb\u52d5\u3057\u3001\u300c\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u300d\u307e\u305f\u306f\u300c\u30a2\u30ab\u30a6\u30f3\u30c8\u540c\u671f\u300d\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u63a2\u3057\u307e\u3059\u3002\u3053\u306e\u6a5f\u80fd\u3092\u6709\u52b9\u306b\u3057\u3066\u3001\u73fe\u5728\u306e\u9032\u6357\u72b6\u6cc1\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3001\u4fdd\u5b58\u3055\u308c\u305f\u30c7\u30fc\u30bf\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001Android\u30c7\u30d0\u30a4\u30b9\u304b\u3089iOS\u30c7\u30d0\u30a4\u30b9\u306b\u5207\u308a\u66ff\u3048\u308b\u5834\u5408\u3001\u540c\u3058Google Play\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u9032\u6357\u72b6\u6cc1\u304c\u30b7\u30fc\u30e0\u30ec\u30b9\u306b\u8ee2\u9001\u3055\u308c\u307e\u3059\u3002"}, {"question": "\u30b9\u30ea\u30c3\u30af\u30de\u30f3\u30b9\u30af\u30fc\u30eb\u30e9\u30f3\u3067\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u30ec\u30d9\u30eb\u3084\u79d8\u5bc6\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30b9\u30ea\u30c3\u30af\u30de\u30f3\u30b9\u30af\u30fc\u30eb\u30e9\u30f3\u306b\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u6df1\u307f\u3092\u52a0\u3048\u308b\u96a0\u3055\u308c\u305f\u30ec\u30d9\u30eb\u3068\u79d8\u5bc6\u304c\u6e80\u8f09\u3067\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u79d8\u5bc6\u306e1\u3064\u306f\u3001\u300c\u771f\u591c\u4e2d\u306e\u30e9\u30f3\u300d\u30ec\u30d9\u30eb\u3067\u3059\u3002\u3053\u308c\u306f\u3001\u6700\u521d\u306e50\u30ec\u30d9\u30eb\u3092\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u305b\u305a\u306b\u30af\u30ea\u30a2\u3059\u308b\u3068\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30ec\u30d9\u30eb\u5185\u306e\u3059\u3079\u3066\u306e\u96a0\u3055\u308c\u305f\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u308b\u3053\u3068\u3067\u3001\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u3084\u30dc\u30fc\u30ca\u30b9\u30a8\u30ea\u30a2\u304c\u660e\u3089\u304b\u306b\u306a\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb25\u3067\u306f\u3001\u7279\u5b9a\u306e\u9806\u5e8f\u3067\u3059\u3079\u3066\u306e\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u308b\u3053\u3068\u3067\u3001\u96e3\u3057\u3044\u969c\u5bb3\u7269\u3092\u30b9\u30ad\u30c3\u30d7\u3059\u308b\u96a0\u3055\u308c\u305f\u30c8\u30f3\u30cd\u30eb\u304c\u958b\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u79d8\u5bc6\u3092\u63a2\u6c42\u3059\u308b\u3053\u3068\u3067\u3001\u732e\u8eab\u7684\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u65b0\u9bae\u3067\u3084\u308a\u304c\u3044\u306e\u3042\u308b\u4f53\u9a13\u304c\u5f97\u3089\u308c\u307e\u3059\u3002"}, {"question": "\u30b9\u30ea\u30c3\u30af\u30de\u30f3\u30b9\u30af\u30fc\u30eb\u30e9\u30f3\u3067\u8907\u96d1\u306a\u969c\u5bb3\u7269\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u3069\u306e\u3088\u3046\u306b\u30ca\u30d3\u30b2\u30fc\u30c8\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30ea\u30c3\u30af\u30de\u30f3\u30b9\u30af\u30fc\u30eb\u30e9\u30f3\u3067\u8907\u96d1\u306a\u969c\u5bb3\u7269\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u30ca\u30d3\u30b2\u30fc\u30c8\u3059\u308b\u306b\u306f\u3001\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u6226\u7565\u7684\u306a\u8a08\u753b\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u969c\u5bb3\u7269\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u9060\u304f\u304b\u3089\u89b3\u5bdf\u3057\u3066\u3001\u5dee\u3057\u8feb\u308b\u8ab2\u984c\u3092\u4e88\u6e2c\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30c0\u30d6\u30eb\u30b8\u30e3\u30f3\u30d7\u306e\u3088\u3046\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3057\u3066\u3001\u8907\u6570\u306e\u969c\u5bb3\u7269\u3092\u7d20\u65e9\u304f\u9023\u7d9a\u3057\u3066\u514b\u670d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u843d\u3061\u7740\u3044\u3066\u3044\u3066\u3001\u6025\u304c\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002\u6025\u304e\u8db3\u3060\u3068\u30df\u30b9\u306b\u3064\u306a\u304c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u4ea4\u4e92\u306b\u969c\u5bb3\u7269\u3068\u30b9\u30e9\u30a4\u30c9\u304c\u3042\u308b\u30b7\u30fc\u30b1\u30f3\u30b9\u3067\u306f\u3001\u52e2\u3044\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u30b8\u30e3\u30f3\u30d7\u3068\u30b9\u30e9\u30a4\u30c9\u3092\u614e\u91cd\u306b\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5408\u308f\u305b\u307e\u3059\u3002\u7df4\u7fd2\u3092\u91cd\u306d\u308b\u3053\u3068\u3067\u3001\u3053\u308c\u3089\u306e\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u30de\u30b9\u30bf\u30fc\u3057\u3001\u5168\u4f53\u7684\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30b9\u30ea\u30c3\u30af\u30de\u30f3\u30b9\u30af\u30fc\u30eb\u30e9\u30f3\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306e\u5f79\u5272\u306f\u4f55\u3067\u3042\u308a\u3001\u3069\u306e\u3088\u3046\u306b\u8a08\u7b97\u3055\u308c\u307e\u3059\u304b\uff1f", "answer": "\u30b9\u30ea\u30c3\u30af\u30de\u30f3\u30b9\u30af\u30fc\u30eb\u30e9\u30f3\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b9\u30ad\u30eb\u3068\u52b9\u7387\u3092\u5831\u3044\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u30b9\u30b3\u30a2\u306f\u3001\u30ab\u30d0\u30fc\u3057\u305f\u8ddd\u96e2\u3001\u53ce\u96c6\u3057\u305f\u30b3\u30a4\u30f3\u3001\u4f7f\u7528\u3057\u305f\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306e\u3044\u304f\u3064\u304b\u306e\u8981\u56e0\u306b\u57fa\u3065\u3044\u3066\u8a08\u7b97\u3055\u308c\u307e\u3059\u3002\u53ce\u96c6\u3057\u305f\u5404\u30b3\u30a4\u30f3\u306f\u30b9\u30b3\u30a2\u306b\u52a0\u7b97\u3055\u308c\u307e\u3059\u3002\u4e00\u65b9\u3001\u78c1\u77f3\u306e\u3088\u3046\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u3001\u30b3\u30a4\u30f3\u306e\u6570\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30e9\u30a4\u30d5\u3092\u5931\u3046\u3053\u3068\u306a\u304f\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u3068\u3001\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u304c\u4e0e\u3048\u3089\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5358\u4e00\u306e\u30e9\u30f3\u3067100\u500b\u306e\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u3001\u78c1\u77f3\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u6700\u7d42\u7684\u306a\u30b9\u30b3\u30a2\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u30dd\u30a4\u30f3\u30c8\u3092\u6700\u5927\u5316\u3059\u308b\u305f\u3081\u306e\u6226\u7565\u3092\u7acb\u3066\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30b9\u30ea\u30c3\u30af\u30de\u30f3\u30b9\u30af\u30fc\u30eb\u30e9\u30f3\u3067\u3001\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u6700\u3082\u52b9\u679c\u7684\u306a\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u80fd\u529b\u306f\u3069\u308c\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30ea\u30c3\u30af\u30de\u30f3\u30b9\u30af\u30fc\u30eb\u30e9\u30f3\u306e\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u901a\u5e38\u3001\u6a5f\u52d5\u6027\u3068\u52b9\u7387\u3092\u9ad8\u3081\u308b\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u80fd\u529b\u3092\u91cd\u8996\u3057\u307e\u3059\u3002\u7279\u306b\u3001\u30c0\u30d6\u30eb\u30b8\u30e3\u30f3\u30d7\u80fd\u529b\u306f\u52b9\u679c\u7684\u3067\u3059\u3002\u3053\u308c\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u8907\u96d1\u306a\u969c\u5bb3\u7269\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u5bb9\u6613\u306b\u30ca\u30d3\u30b2\u30fc\u30c8\u3059\u308b\u3053\u3068\u3092\u53ef\u80fd\u306b\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u80fd\u529b\u306f\u3001\u9ad8\u3044\u52e2\u3044\u3092\u7dad\u6301\u3057\u3001\u3088\u308a\u5927\u304d\u306a\u8ddd\u96e2\u3092\u8fc5\u901f\u306b\u30ab\u30d0\u30fc\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u9023\u7d9a\u3057\u3066\u8907\u6570\u306e\u969c\u5bb3\u7269\u3092\u30c0\u30d6\u30eb\u30b8\u30e3\u30f3\u30d7\u3067\u30af\u30ea\u30a2\u3059\u308b\u3068\u3001\u6642\u9593\u3092\u7bc0\u7d04\u3057\u3001\u30df\u30b9\u3059\u308b\u30ea\u30b9\u30af\u3092\u6e1b\u3089\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u80fd\u529b\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u3067\u3001\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u9ad8\u5f97\u70b9\u7372\u5f97\u306b\u304a\u3044\u3066\u5927\u304d\u306a\u30a2\u30c9\u30d0\u30f3\u30c6\u30fc\u30b8\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u6700\u9ad8\u306e\u30b9\u30ea\u30c3\u30af\u30de\u30f3\u30b9\u30af\u30fc\u30eb\u30e9\u30f3\u4f53\u9a13\u306e\u305f\u3081\u306b\u3001\u30c7\u30d0\u30a4\u30b9\u306e\u8a2d\u5b9a\u3092\u3069\u306e\u3088\u3046\u306b\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30b9\u30ea\u30c3\u30af\u30de\u30f3\u30b9\u30af\u30fc\u30eb\u30e9\u30f3\u306e\u6700\u9ad8\u306e\u4f53\u9a13\u306e\u305f\u3081\u306b\u3001\u30c7\u30d0\u30a4\u30b9\u8a2d\u5b9a\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u91cd\u8981\u306a\u8abf\u6574\u304c\u5fc5\u8981\u3067\u3059\u3002\u307e\u305a\u3001\u30c7\u30d0\u30a4\u30b9\u306e\u30aa\u30da\u30ec\u30fc\u30c6\u30a3\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u3068\u30b2\u30fc\u30e0\u81ea\u4f53\u3092\u6700\u65b0\u30d0\u30fc\u30b8\u30e7\u30f3\u306b\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u8996\u899a\u7684\u306a\u54c1\u8cea\u3068\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u30d0\u30e9\u30f3\u30b9\u3055\u305b\u308b\u305f\u3081\u306b\u3001\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u4e2d\uff5e\u4f4e\u30df\u30c3\u30c9\u30ec\u30f3\u30b8\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u3001\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3092\u300c\u4e2d\u300d\u306b\u8a2d\u5b9a\u3059\u308b\u3068\u3001\u30d5\u30ec\u30fc\u30e0\u30ec\u30fc\u30c8\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u30a2\u30d7\u30ea\u3092\u9589\u3058\u308b\u3068\u3001RAM\u304c\u89e3\u653e\u3055\u308c\u3001\u30b9\u30e0\u30fc\u30ba\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u304c\u5b9f\u73fe\u3055\u308c\u307e\u3059\u3002\u3088\u308a\u6ca1\u5165\u611f\u306e\u3042\u308b\u4f53\u9a13\u306e\u305f\u3081\u306b\u3001\u30d8\u30c3\u30c9\u30d5\u30a9\u30f3\u3092\u4f7f\u7528\u3057\u3066\u3001\u30b2\u30fc\u30e0\u306e\u97f3\u97ff\u52b9\u679c\u3068\u97f3\u697d\u3092\u5b58\u5206\u306b\u697d\u3057\u3093\u3067\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u3089\u306e\u6700\u9069\u5316\u306b\u3088\u308a\u3001\u5168\u4f53\u7684\u306a\u30b2\u30fc\u30e0\u4f53\u9a13\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002"}]
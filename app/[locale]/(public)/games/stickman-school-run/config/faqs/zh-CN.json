[{"question": "\u65b0\u624b\u5982\u4f55\u6709\u6548\u63a7\u5236\u300a\u8df3\u8df3\u4eba\u5b66\u6821\u8dd1\u9177\u300b\u4e2d\u7684\u89d2\u8272\uff1f", "answer": "\u5728\u300a\u8df3\u8df3\u4eba\u5b66\u6821\u8dd1\u9177\u300b\u4e2d\uff0c\u6709\u6548\u63a7\u5236\u89d2\u8272\u81f3\u5173\u91cd\u8981\u3002\u9996\u5148\uff0c\u719f\u6089\u57fa\u672c\u63a7\u5236\uff1a\u5de6\u53f3\u6ed1\u52a8\u79fb\u52a8\u89d2\u8272\uff0c\u5411\u4e0a\u6ed1\u52a8\u8df3\u8dc3\uff0c\u5411\u4e0b\u6ed1\u52a8\u6ed1\u884c\u3002\u4f8b\u5982\uff0c\u5728\u9047\u5230\u969c\u788d\u7269\u65f6\uff0c\u5411\u4e0a\u6ed1\u52a8\u8df3\u8dc3\u8de8\u8fc7\u5b83\u3002\u5728\u65e9\u671f\u5173\u5361\u7ec3\u4e60\u8fd9\u4e9b\u52a8\u4f5c\uff0c\u5efa\u7acb\u808c\u8089\u8bb0\u5fc6\u3002\u6b64\u5916\uff0c\u6ce8\u610f\u6ed1\u52a8\u65f6\u673a\uff0c\u5e73\u6ed1\u5730\u907f\u5f00\u969c\u788d\u7269\u3002\u8bb0\u4f4f\uff0c\u638c\u63e1\u8fd9\u4e9b\u57fa\u672c\u63a7\u5236\u5c06\u4e3a\u66f4\u9ad8\u7ea7\u7684\u6e38\u620f\u73a9\u6cd5\u5960\u5b9a\u575a\u5b9e\u7684\u57fa\u7840\u3002"}, {"question": "\u5728\u901a\u5173\u300a\u8df3\u8df3\u4eba\u5b66\u6821\u8dd1\u9177\u300b100\u5c0f\u65f6\u540e\uff0c\u5982\u4f55\u83b7\u5f97\u9ad8\u5206\uff1f", "answer": "\u5728\u901a\u5173\u300a\u8df3\u8df3\u4eba\u5b66\u6821\u8dd1\u9177\u300b100\u5c0f\u65f6\u540e\uff0c\u83b7\u5f97\u9ad8\u5206\u9700\u8981\u9ad8\u7ea7\u7b56\u7565\u3002\u6b65\u9aa4\u4e00\uff1a\u4e13\u6ce8\u4e8e\u6536\u96c6\u786c\u5e01\u548c\u9053\u5177\uff0c\u5b83\u4eec\u4f1a\u663e\u8457\u63d0\u5347\u5206\u6570\u3002\u6b65\u9aa4\u4e8c\uff1a\u5b8c\u7f8e\u638c\u63e1\u8df3\u8dc3\u548c\u6ed1\u884c\u7684\u65f6\u673a\uff0c\u4fdd\u6301\u9ad8\u901f\u8fd0\u884c\uff0c\u907f\u514d\u4e2d\u65ad\u3002\u6b65\u9aa4\u4e09\uff1a\u7b56\u7565\u6027\u5730\u8fd0\u7528\u53cc\u8df3\u548c\u78c1\u94c1\u9053\u5177\uff0c\u6700\u5927\u9650\u5ea6\u5730\u6536\u96c6\u786c\u5e01\u3002\u4f8b\u5982\uff0c\u5728\u524d\u65b9\u770b\u5230\u786c\u5e01\u7fa4\u65f6\uff0c\u6fc0\u6d3b\u78c1\u94c1\u9053\u5177\u3002\u7ed3\u5408\u8fd9\u4e9b\u6280\u5de7\uff0c\u4f60\u5c31\u80fd\u6301\u7eed\u83b7\u5f97\u9ad8\u5206\u5e76\u6500\u767b\u6392\u884c\u699c\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u300a\u8df3\u8df3\u4eba\u5b66\u6821\u8dd1\u9177\u300b\u7684\u6e38\u620f\u673a\u5236\u66f4\u9752\u7750\u67d0\u4e9b\u9053\u5177\uff1f", "answer": "\u300a\u8df3\u8df3\u4eba\u5b66\u6821\u8dd1\u9177\u300b\u7684\u6e38\u620f\u673a\u5236\u8bbe\u8ba1\u662f\u4e3a\u4e86\u57fa\u4e8e\u9053\u5177\u7684\u5b9e\u7528\u6027\u548c\u5bf9\u6e38\u620f\u73a9\u6cd5\u7684\u5f71\u54cd\u9752\u7750\u67d0\u4e9b\u9053\u5177\u3002\u4f8b\u5982\uff0c\u78c1\u94c1\u9053\u5177\u975e\u5e38\u53d7\u9752\u7750\uff0c\u56e0\u4e3a\u5b83\u53ef\u4ee5\u81ea\u52a8\u6536\u96c6\u4e00\u5b9a\u8303\u56f4\u5185\u7684\u786c\u5e01\uff0c\u8ba9\u73a9\u5bb6\u4e13\u6ce8\u4e8e\u8eb2\u907f\u969c\u788d\u7269\u3002\u540c\u6837\uff0c\u53cc\u8df3\u9053\u5177\u5bf9\u4e8e\u514b\u670d\u590d\u6742\u7684\u969c\u788d\u5e8f\u5217\u81f3\u5173\u91cd\u8981\u3002\u8fd9\u4e9b\u9053\u5177\u7684\u6218\u7565\u6027\u653e\u7f6e\u662f\u4e3a\u4e86\u63d0\u5347\u73a9\u5bb6\u4f53\u9a8c\uff0c\u5e76\u63d0\u4f9b\u5e73\u8861\u7684\u6311\u6218\u3002\u4e86\u89e3\u8fd9\u4e9b\u9053\u5177\u80cc\u540e\u7684\u673a\u5236\u53ef\u4ee5\u5e2e\u52a9\u4f60\u4f18\u5316\u5728\u8dd1\u9177\u8fc7\u7a0b\u4e2d\u7684\u4f7f\u7528\u3002"}, {"question": "\u300a\u8df3\u8df3\u4eba\u5b66\u6821\u8dd1\u9177\u300b\u4e2d\u54ea\u4e9b\u7cfb\u7edf\u8bbe\u7f6e\u5bf9\u6027\u80fd\u5f71\u54cd\u6700\u5927\uff1f", "answer": "\u5728\u300a\u8df3\u8df3\u4eba\u5b66\u6821\u8dd1\u9177\u300b\u4e2d\uff0c\u4e00\u4e9b\u7cfb\u7edf\u8bbe\u7f6e\u4f1a\u663e\u8457\u5f71\u54cd\u6027\u80fd\u3002\u56fe\u5f62\u8d28\u91cf\u662f\u4e3b\u8981\u56e0\u7d20\uff1b\u964d\u4f4e\u56fe\u5f62\u8d28\u91cf\u53ef\u4ee5\u5728\u6027\u80fd\u8f83\u4f4e\u7684\u8bbe\u5907\u4e0a\u63d0\u5347\u5e27\u7387\u3002\u6b64\u5916\uff0c\u7981\u7528\u540e\u53f0\u5e94\u7528\u7a0b\u5e8f\u5e76\u786e\u4fdd\u8db3\u591f\u7684\u5b58\u50a8\u7a7a\u95f4\u4e5f\u53ef\u4ee5\u63d0\u9ad8\u6574\u4f53\u6027\u80fd\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u65e7\u6b3e\u667a\u80fd\u624b\u673a\u7684\u73a9\u5bb6\uff0c\u53ef\u4ee5\u901a\u8fc7\u5c06\u56fe\u5f62\u8d28\u91cf\u4ece\u201c\u9ad8\u201d\u8c03\u6574\u81f3\u201c\u4e2d\u201d\u6765\u83b7\u5f97\u66f4\u6d41\u7545\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u5b9a\u671f\u66f4\u65b0\u6e38\u620f\u5230\u6700\u65b0\u7248\u672c\u4e5f\u53ef\u4ee5\u786e\u4fdd\u6700\u4f73\u6027\u80fd\uff0c\u5e76\u83b7\u5f97\u6700\u65b0\u529f\u80fd\u548c\u9519\u8bef\u4fee\u590d\u3002"}, {"question": "\u5982\u4f55\u5c06\u300a\u8df3\u8df3\u4eba\u5b66\u6821\u8dd1\u9177\u300b\u7684\u8fdb\u5ea6\u8f6c\u79fb\u5230\u65b0\u8bbe\u5907\uff1f", "answer": "\u5c06\u300a\u8df3\u8df3\u4eba\u5b66\u6821\u8dd1\u9177\u300b\u7684\u8fdb\u5ea6\u8f6c\u79fb\u5230\u65b0\u8bbe\u5907\u975e\u5e38\u7b80\u5355\u3002\u9996\u5148\uff0c\u786e\u4fdd\u4f60\u5728\u4e24\u4e2a\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u540c\u4e00\u4e2a\u8d26\u6237\uff0c\u901a\u5e38\u662f\u8c37\u6b4c\u6216\u82f9\u679c\u8d26\u6237\u3002\u8fdb\u5165\u6e38\u620f\u8bbe\u7f6e\uff0c\u67e5\u627e\u201c\u4e91\u4fdd\u5b58\u201d\u6216\u201c\u8d26\u6237\u540c\u6b65\u201d\u9009\u9879\u3002\u542f\u7528\u6b64\u529f\u80fd\u4ee5\u4e0a\u4f20\u5f53\u524d\u8fdb\u5ea6\u3002\u5728\u65b0\u8bbe\u5907\u4e0a\uff0c\u4f7f\u7528\u76f8\u540c\u7684\u8d26\u6237\u767b\u5f55\u5e76\u4e0b\u8f7d\u4fdd\u5b58\u7684\u6570\u636e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4ece\u5b89\u5353\u8bbe\u5907\u5207\u6362\u5230\u82f9\u679c\u8bbe\u5907\uff0c\u4f7f\u7528\u76f8\u540c\u7684\u8c37\u6b4c\u8d26\u53f7\u53ef\u4ee5\u65e0\u7f1d\u5730\u4f20\u8f93\u4f60\u7684\u8fdb\u5ea6\u3002"}, {"question": "\u5728\u300a\u8df3\u8df3\u4eba\u5b66\u6821\u8dd1\u9177\u300b\u4e2d\uff0c\u6211\u80fd\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u5173\u5361\u6216\u79d8\u5bc6\uff1f", "answer": "\u300a\u8df3\u8df3\u4eba\u5b66\u6821\u8dd1\u9177\u300b\u4e2d\u5145\u6ee1\u4e86\u9690\u85cf\u5173\u5361\u548c\u79d8\u5bc6\uff0c\u4e3a\u6e38\u620f\u589e\u6dfb\u6df1\u5ea6\u3002\u4e00\u4e2a\u663e\u8457\u7684\u79d8\u5bc6\u662f\u201c\u5348\u591c\u8dd1\u9177\u201d\u5173\u5361\uff0c\u53ef\u4ee5\u901a\u8fc7\u5b8c\u6210\u524d 50 \u4e2a\u5173\u5361\u800c\u4e0d\u4f7f\u7528\u4efb\u4f55\u9053\u5177\u6765\u89e3\u9501\u3002\u6b64\u5916\uff0c\u6536\u96c6\u5173\u5361\u4e2d\u6240\u6709\u9690\u85cf\u786c\u5e01\u6709\u65f6\u4f1a\u63ed\u793a\u6377\u5f84\u6216\u989d\u5916\u533a\u57df\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 25 \u5173\uff0c\u6309\u7167\u7279\u5b9a\u987a\u5e8f\u6536\u96c6\u6240\u6709\u786c\u5e01\uff0c\u5c31\u53ef\u4ee5\u6253\u5f00\u4e00\u6761\u9690\u85cf\u7684\u96a7\u9053\uff0c\u8df3\u8fc7\u4e00\u4e2a\u5177\u6709\u6311\u6218\u6027\u7684\u969c\u788d\u533a\u57df\u3002\u63a2\u7d22\u8fd9\u4e9b\u79d8\u5bc6\u53ef\u4ee5\u4e3a\u4e13\u6ce8\u7684\u73a9\u5bb6\u5e26\u6765\u65b0\u9c9c\u4e14\u6709\u76ca\u7684\u4f53\u9a8c\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u8df3\u8df3\u4eba\u5b66\u6821\u8dd1\u9177\u300b\u4e2d\u5e94\u5bf9\u590d\u6742\u7684\u969c\u788d\u5e8f\u5217\uff1f", "answer": "\u5728\u300a\u8df3\u8df3\u4eba\u5b66\u6821\u8dd1\u9177\u300b\u4e2d\u5e94\u5bf9\u590d\u6742\u7684\u969c\u788d\u5e8f\u5217\u9700\u8981\u7cbe\u786e\u7684\u65f6\u673a\u548c\u6218\u7565\u6027\u89c4\u5212\u3002\u6b65\u9aa4\u4e00\uff1a\u4ece\u8fdc\u5904\u89c2\u5bdf\u969c\u788d\u7269\u7684\u6a21\u5f0f\uff0c\u9884\u89c1\u5373\u5c06\u5230\u6765\u7684\u6311\u6218\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u53cc\u8df3\u7b49\u9053\u5177\u5feb\u901f\u8fde\u7eed\u5730\u514b\u670d\u591a\u4e2a\u969c\u788d\u3002\u6b65\u9aa4\u4e09\uff1a\u4fdd\u6301\u8010\u5fc3\uff0c\u907f\u514d\u5306\u5fd9\uff0c\u56e0\u4e3a\u4ed3\u4fc3\u7684\u52a8\u4f5c\u4f1a\u5bfc\u81f4\u9519\u8bef\u3002\u4f8b\u5982\uff0c\u5728\u4e00\u4e2a\u4ea4\u66ff\u51fa\u73b0\u969c\u788d\u7269\u548c\u6ed1\u884c\u7269\u7684\u5e8f\u5217\u4e2d\uff0c\u4ed4\u7ec6\u8c03\u6574\u8df3\u8dc3\u548c\u6ed1\u884c\u7684\u65f6\u673a\u4ee5\u4fdd\u6301\u52a8\u529b\u3002\u901a\u8fc7\u7ec3\u4e60\uff0c\u4f60\u53ef\u4ee5\u638c\u63e1\u8fd9\u4e9b\u5e8f\u5217\uff0c\u5e76\u63d0\u9ad8\u4f60\u7684\u6574\u4f53\u8868\u73b0\u3002"}, {"question": "\u300a\u8df3\u8df3\u4eba\u5b66\u6821\u8dd1\u9177\u300b\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u6709\u4ec0\u4e48\u4f5c\u7528\uff0c\u4ee5\u53ca\u5b83\u662f\u5982\u4f55\u8ba1\u7b97\u7684\uff1f", "answer": "\u300a\u8df3\u8df3\u4eba\u5b66\u6821\u8dd1\u9177\u300b\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u65e8\u5728\u5956\u52b1\u73a9\u5bb6\u7684\u6280\u5de7\u548c\u6548\u7387\u3002\u5206\u6570\u662f\u57fa\u4e8e\u4ee5\u4e0b\u51e0\u4e2a\u56e0\u7d20\u8ba1\u7b97\u7684\uff1a\u8986\u76d6\u7684\u8ddd\u79bb\u3001\u6536\u96c6\u7684\u786c\u5e01\u548c\u4f7f\u7528\u7684\u9053\u5177\u3002\u6536\u96c6\u7684\u6bcf\u4e2a\u786c\u5e01\u90fd\u4f1a\u589e\u52a0\u4f60\u7684\u5206\u6570\uff0c\u800c\u50cf\u78c1\u94c1\u8fd9\u6837\u7684\u9053\u5177\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u786c\u5e01\u6570\u91cf\u3002\u6b64\u5916\uff0c\u5b8c\u6210\u5173\u5361\u4e14\u6ca1\u6709\u635f\u5931\u751f\u547d\u4f1a\u83b7\u5f97\u989d\u5916\u5206\u6570\u3002\u4f8b\u5982\uff0c\u5728\u5355\u6b21\u8dd1\u9177\u4e2d\u6536\u96c6 100 \u4e2a\u786c\u5e01\u5e76\u4f7f\u7528\u78c1\u94c1\u9053\u5177\u53ef\u4ee5\u5927\u5e45\u63d0\u9ad8\u4f60\u7684\u6700\u7ec8\u5206\u6570\u3002\u4e86\u89e3\u8fd9\u4e2a\u7cfb\u7edf\u53ef\u4ee5\u5e2e\u52a9\u4f60\u5236\u5b9a\u7b56\u7565\u4ee5\u6700\u5927\u5316\u4f60\u7684\u5206\u6570\u3002"}, {"question": "\u300a\u8df3\u8df3\u4eba\u5b66\u6821\u8dd1\u9177\u300b\u4e2d\u54ea\u4e9b\u89d2\u8272\u80fd\u529b\u5bf9\u9ad8\u7ea7\u73a9\u5bb6\u6700\u6709\u6548\uff1f", "answer": "\u5728\u300a\u8df3\u8df3\u4eba\u5b66\u6821\u8dd1\u9177\u300b\u4e2d\uff0c\u9ad8\u7ea7\u73a9\u5bb6\u901a\u5e38\u9752\u7750\u90a3\u4e9b\u63d0\u5347\u79fb\u52a8\u6027\u548c\u6548\u7387\u7684\u89d2\u8272\u80fd\u529b\u3002\u53cc\u8df3\u80fd\u529b\u7279\u522b\u6709\u6548\uff0c\u5b83\u4f7f\u73a9\u5bb6\u80fd\u591f\u8f7b\u677e\u5730\u5e94\u5bf9\u590d\u6742\u7684\u969c\u788d\u5e8f\u5217\u3002\u6b64\u5916\uff0c\u52a0\u901f\u80fd\u529b\u5bf9\u4e8e\u4fdd\u6301\u9ad8\u901f\u5ea6\u5e76\u5feb\u901f\u8986\u76d6\u66f4\u957f\u7684\u8ddd\u79bb\u4e5f\u5f88\u6709\u4ef7\u503c\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u53cc\u8df3\u8fde\u7eed\u6e05\u9664\u591a\u4e2a\u969c\u788d\u7269\u53ef\u4ee5\u8282\u7701\u65f6\u95f4\uff0c\u5e76\u964d\u4f4e\u51fa\u9519\u7684\u98ce\u9669\u3002\u719f\u7ec3\u638c\u63e1\u8fd9\u4e9b\u80fd\u529b\u53ef\u4ee5\u4e3a\u9ad8\u7ea7\u73a9\u5bb6\u5728\u83b7\u5f97\u9ad8\u5206\u65b9\u9762\u5e26\u6765\u660e\u663e\u7684\u4f18\u52bf\u3002"}, {"question": "\u5982\u4f55\u4f18\u5316\u8bbe\u5907\u8bbe\u7f6e\u4ee5\u83b7\u5f97\u6700\u4f73\u7684\u300a\u8df3\u8df3\u4eba\u5b66\u6821\u8dd1\u9177\u300b\u4f53\u9a8c\uff1f", "answer": "\u4f18\u5316\u8bbe\u5907\u8bbe\u7f6e\u4ee5\u83b7\u5f97\u6700\u4f73\u7684\u300a\u8df3\u8df3\u4eba\u5b66\u6821\u8dd1\u9177\u300b\u4f53\u9a8c\u5305\u62ec\u4e00\u4e9b\u5173\u952e\u8c03\u6574\u3002\u9996\u5148\uff0c\u786e\u4fdd\u4f60\u7684\u8bbe\u5907\u64cd\u4f5c\u7cfb\u7edf\u548c\u6e38\u620f\u672c\u8eab\u90fd\u66f4\u65b0\u5230\u6700\u65b0\u7248\u672c\u3002\u8c03\u6574\u56fe\u5f62\u8bbe\u7f6e\u4ee5\u5e73\u8861\u89c6\u89c9\u8d28\u91cf\u548c\u6027\u80fd\uff1b\u4f8b\u5982\uff0c\u5c06\u56fe\u5f62\u8bbe\u7f6e\u4e3a\u201c\u4e2d\u201d\u53ef\u4ee5\u5728\u4e2d\u6863\u8bbe\u5907\u4e0a\u63d0\u9ad8\u5e27\u7387\u3002\u6b64\u5916\uff0c\u5173\u95ed\u540e\u53f0\u5e94\u7528\u7a0b\u5e8f\u4ee5\u91ca\u653e RAM\uff0c\u5e76\u786e\u4fdd\u6e38\u620f\u6d41\u7545\u8fd0\u884c\u3002\u4e3a\u4e86\u66f4\u8eab\u4e34\u5176\u5883\u7684\u4f53\u9a8c\uff0c\u8003\u8651\u4f7f\u7528\u8033\u673a\u4ee5\u5145\u5206\u4eab\u53d7\u6e38\u620f\u4e2d\u7684\u97f3\u6548\u548c\u97f3\u4e50\u3002\u8fd9\u4e9b\u4f18\u5316\u53ef\u4ee5\u663e\u8457\u63d0\u5347\u4f60\u7684\u6574\u4f53\u6e38\u620f\u4f53\u9a8c\u3002"}]
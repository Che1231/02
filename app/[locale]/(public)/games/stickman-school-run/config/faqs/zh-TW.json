[{"question": "\u5982\u4f55\u624d\u80fd\u6709\u6548\u63a7\u5236\u6211\u7684\u89d2\u8272\uff0c\u5728\u65b0\u624b\u968e\u6bb5\u73a9\u597d\u300a\u8df3\u8df3\u4eba\u5b78\u6821\u8dd1\u9177\u300b\u904a\u6232\uff1f", "answer": "\u5728\u300a\u8df3\u8df3\u4eba\u5b78\u6821\u8dd1\u9177\u300b\u4e2d\uff0c\u6709\u6548\u63a7\u5236\u4f60\u7684\u89d2\u8272\u81f3\u95dc\u91cd\u8981\u3002\u9996\u5148\uff0c\u719f\u6089\u57fa\u672c\u64cd\u4f5c\uff1a\u5de6\u53f3\u6ed1\u52d5\u79fb\u52d5\u4f60\u7684\u89d2\u8272\uff0c\u5411\u4e0a\u6ed1\u52d5\u8df3\u8e8d\uff0c\u5411\u4e0b\u6ed1\u52d5\u6ed1\u884c\u3002\u4f8b\u5982\uff0c\u7576\u63a5\u8fd1\u969c\u7919\u7269\u6642\uff0c\u5411\u4e0a\u6ed1\u52d5\u4ee5\u8df3\u904e\u5b83\u3002\u5728\u65e9\u671f\u95dc\u5361\u7df4\u7fd2\u9019\u4e9b\u52d5\u4f5c\uff0c\u5efa\u7acb\u808c\u8089\u8a18\u61b6\u3002\u6b64\u5916\uff0c\u6ce8\u610f\u6ed1\u52d5\u7684\u6642\u6a5f\uff0c\u4ee5\u9806\u5229\u907f\u958b\u969c\u7919\u7269\u3002\u8a18\u4f4f\uff0c\u638c\u63e1\u9019\u4e9b\u57fa\u672c\u63a7\u5236\u5c07\u70ba\u9032\u968e\u904a\u6232\u5960\u5b9a\u5805\u5be6\u7684\u57fa\u790e\u3002"}, {"question": "\u5728\u73a9\u4e86 100 \u5c0f\u6642\u300a\u8df3\u8df3\u4eba\u5b78\u6821\u8dd1\u9177\u300b\u5f8c\uff0c\u54ea\u4e9b\u7b56\u7565\u6700\u9069\u5408\u7372\u5f97\u9ad8\u5206\uff1f", "answer": "\u5728\u73a9\u4e86 100 \u5c0f\u6642\u300a\u8df3\u8df3\u4eba\u5b78\u6821\u8dd1\u9177\u300b\u5f8c\uff0c\u60f3\u8981\u7372\u5f97\u9ad8\u5206\u9700\u8981\u9032\u968e\u7b56\u7565\u3002\u6b65\u9a5f\u4e00\uff1a\u5c08\u6ce8\u65bc\u6536\u96c6\u786c\u5e63\u548c\u9053\u5177\uff0c\u56e0\u70ba\u5b83\u5011\u6703\u986f\u8457\u63d0\u5347\u4f60\u7684\u5206\u6578\u3002\u6b65\u9a5f\u4e8c\uff1a\u5b8c\u5584\u8df3\u8e8d\u548c\u6ed1\u884c\u7684\u6642\u6a5f\uff0c\u4ee5\u4fdd\u6301\u9ad8\u901f\u5954\u8dd1\uff0c\u907f\u514d\u4e2d\u65b7\u3002\u6b65\u9a5f\u4e09\uff1a\u7b56\u7565\u6027\u5730\u4f7f\u7528\u96d9\u8df3\u548c\u78c1\u529b\u9053\u5177\uff0c\u4ee5\u6700\u5927\u5316\u786c\u5e63\u6536\u96c6\u3002\u4f8b\u5982\uff0c\u7576\u4f60\u770b\u5230\u524d\u65b9\u4e00\u5806\u786c\u5e63\u6642\uff0c\u555f\u52d5\u78c1\u529b\u9053\u5177\u3002\u7d50\u5408\u9019\u4e9b\u6280\u5de7\uff0c\u4f60\u5c31\u80fd\u6301\u7e8c\u53d6\u5f97\u9ad8\u5206\uff0c\u4e26\u5728\u6392\u884c\u699c\u4e0a\u6500\u5347\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u300a\u8df3\u8df3\u4eba\u5b78\u6821\u8dd1\u9177\u300b\u7684\u904a\u6232\u6a5f\u5236\u6703\u504f\u5411\u67d0\u4e9b\u9053\u5177\uff0c\u800c\u4e0d\u662f\u5176\u4ed6\u9053\u5177\uff1f", "answer": "\u300a\u8df3\u8df3\u4eba\u5b78\u6821\u8dd1\u9177\u300b\u7684\u904a\u6232\u6a5f\u5236\u8a2d\u8a08\uff0c\u504f\u5411\u67d0\u4e9b\u9053\u5177\uff0c\u662f\u57fa\u65bc\u5b83\u5011\u5728\u904a\u6232\u4e2d\u7684\u6548\u7528\u548c\u5f71\u97ff\u3002\u4f8b\u5982\uff0c\u78c1\u529b\u9053\u5177\u975e\u5e38\u53d7\u6b61\u8fce\uff0c\u56e0\u70ba\u5b83\u6703\u81ea\u52d5\u6536\u96c6\u4e00\u5b9a\u7bc4\u570d\u5167\u7684\u786c\u5e63\uff0c\u8b93\u73a9\u5bb6\u53ef\u4ee5\u5c08\u6ce8\u65bc\u514b\u670d\u969c\u7919\u3002\u540c\u6a23\u5730\uff0c\u96d9\u8df3\u9053\u5177\u5c0d\u65bc\u514b\u670d\u8907\u96dc\u7684\u969c\u7919\u5e8f\u5217\u81f3\u95dc\u91cd\u8981\u3002\u9019\u4e9b\u9053\u5177\u7684\u5b89\u6392\u6709\u7b56\u7565\u6027\uff0c\u4ee5\u63d0\u5347\u73a9\u5bb6\u9ad4\u9a57\uff0c\u4e26\u63d0\u4f9b\u5e73\u8861\u7684\u6311\u6230\u3002\u4e86\u89e3\u9019\u4e9b\u9053\u5177\u80cc\u5f8c\u7684\u6a5f\u5236\uff0c\u53ef\u4ee5\u5e6b\u52a9\u4f60\u512a\u5316\u5728\u8dd1\u9177\u4e2d\u7684\u4f7f\u7528\u3002"}, {"question": "\u300a\u8df3\u8df3\u4eba\u5b78\u6821\u8dd1\u9177\u300b\u4e2d\u7684\u54ea\u4e9b\u7cfb\u7d71\u8a2d\u5b9a\u5c0d\u6548\u80fd\u7684\u5f71\u97ff\u6700\u5927\uff1f", "answer": "\u5728\u300a\u8df3\u8df3\u4eba\u5b78\u6821\u8dd1\u9177\u300b\u4e2d\uff0c\u4e00\u4e9b\u7cfb\u7d71\u8a2d\u5b9a\u6703\u986f\u8457\u5f71\u97ff\u6548\u80fd\u3002\u5716\u5f62\u54c1\u8cea\u662f\u4e3b\u8981\u56e0\u7d20\uff1b\u5728\u8f03\u5f31\u7684\u88dd\u7f6e\u4e0a\u964d\u4f4e\u5b83\u53ef\u4ee5\u6539\u5584\u756b\u9762\u5e40\u7387\u3002\u6b64\u5916\uff0c\u95dc\u9589\u80cc\u666f\u61c9\u7528\u7a0b\u5f0f\u4e26\u78ba\u4fdd\u8db3\u5920\u7684\u5132\u5b58\u7a7a\u9593\u53ef\u4ee5\u589e\u5f37\u6574\u9ad4\u6548\u80fd\u3002\u4f8b\u5982\uff0c\u5728\u8f03\u820a\u7684\u667a\u6167\u578b\u624b\u6a5f\u4e0a\uff0c\u5c07\u5716\u5f62\u54c1\u8cea\u5f9e\u300c\u9ad8\u300d\u8abf\u6574\u5230\u300c\u4e2d\u300d\uff0c\u53ef\u80fd\u6703\u8b93\u904a\u6232\u9ad4\u9a57\u66f4\u9806\u66a2\u3002\u5b9a\u671f\u66f4\u65b0\u904a\u6232\u5230\u6700\u65b0\u7248\u672c\uff0c\u4e5f\u80fd\u78ba\u4fdd\u6700\u4f73\u6548\u80fd\uff0c\u4e26\u7372\u5f97\u6700\u65b0\u529f\u80fd\u548c\u932f\u8aa4\u4fee\u6b63\u3002"}, {"question": "\u5982\u4f55\u5c07\u6211\u7684\u300a\u8df3\u8df3\u4eba\u5b78\u6821\u8dd1\u9177\u300b\u9032\u5ea6\u8f49\u79fb\u5230\u65b0\u7684\u88dd\u7f6e\uff1f", "answer": "\u5c07\u4f60\u7684\u300a\u8df3\u8df3\u4eba\u5b78\u6821\u8dd1\u9177\u300b\u9032\u5ea6\u8f49\u79fb\u5230\u65b0\u7684\u88dd\u7f6e\u975e\u5e38\u7c21\u55ae\u3002\u9996\u5148\uff0c\u78ba\u4fdd\u4f60\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u90fd\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u3002\u9019\u901a\u5e38\u662f Google Play \u6216 Apple ID\u3002\u700f\u89bd\u904a\u6232\u8a2d\u5b9a\uff0c\u5c0b\u627e\u300c\u96f2\u7aef\u5132\u5b58\u300d\u6216\u300c\u5e33\u6236\u540c\u6b65\u300d\u9078\u9805\u3002\u555f\u7528\u6b64\u529f\u80fd\u4ee5\u4e0a\u50b3\u4f60\u7684\u7576\u524d\u9032\u5ea6\u3002\u5728\u65b0\u88dd\u7f6e\u4e0a\uff0c\u4f7f\u7528\u76f8\u540c\u7684\u5e33\u6236\u767b\u5165\u4e26\u4e0b\u8f09\u5132\u5b58\u7684\u8cc7\u6599\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5f9e Android \u8f49\u63db\u5230 iOS \u88dd\u7f6e\uff0c\u4f7f\u7528\u76f8\u540c\u7684 Google Play \u5e33\u6236\u5c31\u80fd\u9806\u5229\u8f49\u79fb\u4f60\u7684\u9032\u5ea6\u3002"}, {"question": "\u5728\u300a\u8df3\u8df3\u4eba\u5b78\u6821\u8dd1\u9177\u300b\u4e2d\uff0c\u6211\u53ef\u4ee5\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u7684\u95dc\u5361\u6216\u79d8\u5bc6\uff1f", "answer": "\u300a\u8df3\u8df3\u4eba\u5b78\u6821\u8dd1\u9177\u300b\u5145\u6eff\u4e86\u96b1\u85cf\u95dc\u5361\u548c\u79d8\u5bc6\uff0c\u8c50\u5bcc\u4e86\u904a\u6232\u73a9\u6cd5\u3002\u4e00\u500b\u986f\u8457\u7684\u79d8\u5bc6\u662f\u300c\u5348\u591c\u8dd1\u300d\u95dc\u5361\uff0c\u5b83\u53ef\u4ee5\u5728\u4e0d\u4f7f\u7528\u4efb\u4f55\u9053\u5177\u7684\u60c5\u6cc1\u4e0b\u5b8c\u6210\u524d 50 \u500b\u95dc\u5361\u624d\u80fd\u89e3\u9396\u3002\u6b64\u5916\uff0c\u5728\u4e00\u500b\u95dc\u5361\u4e2d\u6536\u96c6\u6240\u6709\u96b1\u85cf\u7684\u786c\u5e63\uff0c\u6709\u6642\u6703\u767c\u73fe\u6377\u5f91\u6216\u734e\u52f5\u5340\u57df\u3002\u4f8b\u5982\uff0c\u5728 25 \u95dc\uff0c\u6309\u7167\u7279\u5b9a\u9806\u5e8f\u6536\u96c6\u6240\u6709\u786c\u5e63\uff0c\u5c31\u80fd\u958b\u555f\u96b1\u85cf\u7684\u96a7\u9053\uff0c\u8df3\u904e\u4e00\u500b\u5177\u6311\u6230\u6027\u7684\u969c\u7919\u90e8\u5206\u3002\u63a2\u7d22\u9019\u4e9b\u79d8\u5bc6\uff0c\u53ef\u4ee5\u70ba\u71b1\u8877\u7684\u73a9\u5bb6\u63d0\u4f9b\u65b0\u7684\u548c\u4ee4\u4eba\u6109\u6085\u7684\u9ad4\u9a57\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u8df3\u8df3\u4eba\u5b78\u6821\u8dd1\u9177\u300b\u4e2d\u7a7f\u8d8a\u8907\u96dc\u7684\u969c\u7919\u5e8f\u5217\uff1f", "answer": "\u5728\u300a\u8df3\u8df3\u4eba\u5b78\u6821\u8dd1\u9177\u300b\u4e2d\u7a7f\u8d8a\u8907\u96dc\u7684\u969c\u7919\u5e8f\u5217\uff0c\u9700\u8981\u7cbe\u78ba\u7684\u6642\u6a5f\u548c\u7b56\u7565\u898f\u5283\u3002\u6b65\u9a5f\u4e00\uff1a\u9060\u8ddd\u96e2\u89c0\u5bdf\u969c\u7919\u7269\u7684\u6a21\u5f0f\uff0c\u9810\u671f\u5373\u5c07\u51fa\u73fe\u7684\u6311\u6230\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u96d9\u8df3\u7b49\u9053\u5177\uff0c\u8fc5\u901f\u514b\u670d\u591a\u500b\u969c\u7919\u7269\u3002\u6b65\u9a5f\u4e09\uff1a\u4fdd\u6301\u8010\u5fc3\uff0c\u907f\u514d\u5306\u5fd9\uff0c\u56e0\u70ba\u5009\u4fc3\u7684\u52d5\u4f5c\u6703\u5c0e\u81f4\u932f\u8aa4\u3002\u4f8b\u5982\uff0c\u5728\u4e00\u500b\u4ea4\u66ff\u51fa\u73fe\u969c\u7919\u7269\u548c\u6ed1\u884c\u5e8f\u5217\u4e2d\uff0c\u4ed4\u7d30\u8abf\u6574\u8df3\u8e8d\u548c\u6ed1\u884c\u7684\u6642\u6a5f\uff0c\u4ee5\u4fdd\u6301\u52d5\u91cf\u3002\u900f\u904e\u7df4\u7fd2\uff0c\u4f60\u5c31\u80fd\u638c\u63e1\u9019\u4e9b\u5e8f\u5217\uff0c\u4e26\u63d0\u5347\u6574\u9ad4\u8868\u73fe\u3002"}, {"question": "\u300a\u8df3\u8df3\u4eba\u5b78\u6821\u8dd1\u9177\u300b\u7684\u8a08\u5206\u7cfb\u7d71\u6709\u4ec0\u9ebc\u4f5c\u7528\uff0c\u53c8\u662f\u5982\u4f55\u8a08\u7b97\u7684\uff1f", "answer": "\u300a\u8df3\u8df3\u4eba\u5b78\u6821\u8dd1\u9177\u300b\u7684\u8a08\u5206\u7cfb\u7d71\u65e8\u5728\u734e\u52f5\u73a9\u5bb6\u7684\u6280\u5de7\u548c\u6548\u7387\u3002\u5206\u6578\u7684\u8a08\u7b97\u57fa\u65bc\u5e7e\u500b\u56e0\u7d20\uff1a\u884c\u9032\u8ddd\u96e2\u3001\u6536\u96c6\u786c\u5e63\u548c\u4f7f\u7528\u9053\u5177\u3002\u6536\u96c6\u6bcf\u500b\u786c\u5e63\u90fd\u6703\u589e\u52a0\u4f60\u7684\u5206\u6578\uff0c\u800c\u50cf\u78c1\u529b\u9053\u5177\u9019\u6a23\u7684\u9053\u5177\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u4f60\u7684\u786c\u5e63\u6578\u91cf\u3002\u6b64\u5916\uff0c\u5b8c\u6210\u95dc\u5361\u800c\u4e0d\u640d\u5931\u751f\u547d\u6703\u7372\u5f97\u984d\u5916\u5206\u6578\u3002\u4f8b\u5982\uff0c\u5728\u4e00\u6b21\u8dd1\u9177\u4e2d\u6536\u96c6 100 \u500b\u786c\u5e63\u4e26\u4f7f\u7528\u78c1\u529b\u9053\u5177\uff0c\u53ef\u4ee5\u5927\u5e45\u63d0\u5347\u4f60\u7684\u6700\u7d42\u5206\u6578\u3002\u4e86\u89e3\u9019\u500b\u7cfb\u7d71\u80fd\u5e6b\u52a9\u4f60\u5236\u5b9a\u7b56\u7565\uff0c\u6700\u5927\u5316\u4f60\u7684\u5f97\u5206\u3002"}, {"question": "\u300a\u8df3\u8df3\u4eba\u5b78\u6821\u8dd1\u9177\u300b\u4e2d\u54ea\u4e9b\u89d2\u8272\u80fd\u529b\u5c0d\u9032\u968e\u73a9\u5bb6\u4f86\u8aaa\u6700\u6709\u6548\uff1f", "answer": "\u5728\u300a\u8df3\u8df3\u4eba\u5b78\u6821\u8dd1\u9177\u300b\u4e2d\uff0c\u9032\u968e\u73a9\u5bb6\u7d93\u5e38\u504f\u611b\u80fd\u63d0\u5347\u79fb\u52d5\u6027\u548c\u6548\u7387\u7684\u89d2\u8272\u80fd\u529b\u3002\u96d9\u8df3\u80fd\u529b\u7279\u5225\u6709\u6548\uff0c\u8b93\u73a9\u5bb6\u8f15\u9b06\u99d5\u99ad\u8907\u96dc\u7684\u969c\u7919\u5e8f\u5217\u3002\u6b64\u5916\uff0c\u901f\u5ea6\u63d0\u5347\u80fd\u529b\u5c0d\u65bc\u4fdd\u6301\u9ad8\u52d5\u91cf\u548c\u5feb\u901f\u8986\u84cb\u66f4\u9577\u8ddd\u96e2\u975e\u5e38\u6709\u50f9\u503c\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u96d9\u8df3\u4f86\u9023\u7e8c\u6e05\u9664\u591a\u500b\u969c\u7919\u7269\uff0c\u53ef\u4ee5\u7bc0\u7701\u6642\u9593\u4e26\u964d\u4f4e\u932f\u8aa4\u7684\u98a8\u96aa\u3002\u638c\u63e1\u9019\u4e9b\u80fd\u529b\uff0c\u53ef\u4ee5\u8b93\u9032\u968e\u73a9\u5bb6\u5728\u9054\u6210\u9ad8\u5206\u6642\u4f54\u64da\u660e\u986f\u512a\u52e2\u3002"}, {"question": "\u5982\u4f55\u512a\u5316\u6211\u7684\u88dd\u7f6e\u8a2d\u5b9a\uff0c\u4ee5\u7372\u5f97\u6700\u4f73\u7684\u300a\u8df3\u8df3\u4eba\u5b78\u6821\u8dd1\u9177\u300b\u9ad4\u9a57\uff1f", "answer": "\u512a\u5316\u4f60\u7684\u88dd\u7f6e\u8a2d\u5b9a\u4ee5\u7372\u5f97\u6700\u4f73\u300a\u8df3\u8df3\u4eba\u5b78\u6821\u8dd1\u9177\u300b\u9ad4\u9a57\uff0c\u6d89\u53ca\u591a\u9805\u8abf\u6574\u3002\u9996\u5148\uff0c\u78ba\u4fdd\u4f60\u7684\u88dd\u7f6e\u4f5c\u696d\u7cfb\u7d71\u548c\u904a\u6232\u672c\u8eab\u90fd\u66f4\u65b0\u5230\u6700\u65b0\u7248\u672c\u3002\u8abf\u6574\u5716\u5f62\u8a2d\u5b9a\uff0c\u4ee5\u5e73\u8861\u8996\u89ba\u54c1\u8cea\u548c\u6548\u80fd\uff1b\u4f8b\u5982\uff0c\u5c07\u5716\u5f62\u8a2d\u5b9a\u70ba\u300c\u4e2d\u300d\uff0c\u53ef\u4ee5\u6539\u5584\u4e2d\u7b49\u7bc4\u570d\u88dd\u7f6e\u7684\u756b\u9762\u5e40\u7387\u3002\u6b64\u5916\uff0c\u95dc\u9589\u80cc\u666f\u61c9\u7528\u7a0b\u5f0f\uff0c\u91cb\u653e RAM\uff0c\u78ba\u4fdd\u904a\u6232\u9806\u66a2\u3002\u70ba\u4e86\u66f4\u6c89\u6d78\u7684\u9ad4\u9a57\uff0c\u8003\u616e\u4f7f\u7528\u8033\u6a5f\uff0c\u4ee5\u5145\u5206\u4eab\u53d7\u904a\u6232\u7684\u97f3\u6548\u548c\u97f3\u6a02\u3002\u9019\u4e9b\u512a\u5316\u63aa\u65bd\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u4f60\u7684\u6574\u9ad4\u904a\u6232\u9ad4\u9a57\u3002"}]
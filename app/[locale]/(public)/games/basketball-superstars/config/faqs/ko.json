[{"question": "\ub18d\uad6c \uc288\ud37c\uc2a4\ud0c0\uc5d0\uc11c \ucd08\ubcf4\uc790\uac00 \uae30\ubcf8 \ub369\ud06c\ub97c \uc5b4\ub5bb\uac8c \ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub18d\uad6c \uc288\ud37c\uc2a4\ud0c0\uc5d0\uc11c \uae30\ubcf8 \ub369\ud06c\ub97c \ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1: \uace8\ub300 \uadfc\ucc98\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\ub97c \uc704\uce58\uc2dc\ud0b5\ub2c8\ub2e4. STEP2: \"\uc29b\" \ubc84\ud2bc\uc744 \ub204\ub974\uace0 \uacc4\uc2ed\ub2c8\ub2e4. STEP3: \ud30c\uc6cc \uac8c\uc774\uc9c0\uac00 \ucd5c\uc801\uc758 \uc601\uc5ed\uc5d0 \ub3c4\ub2ec\ud588\uc744 \ub54c \ubc84\ud2bc\uc744 \ub193\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud50c\ub808\uc774\uc5b4 \"MJ23\"\uc758 \"\ud30c\uc6cc \ub369\ud06c\" \uc2a4\ud0ac\uc744 \uc0ac\uc6a9\ud558\uba74 \ub192\uc740 \uc131\uacf5\ub960\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \ubc29\ubc95\uc740 \ucd08\ubcf4\uc790\uc5d0\uac8c \uce5c\uc219\ud558\uba70 \uc27d\uac8c \ub4dd\uc810\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc810\ud504 \ub85c\ud504 \ud0c0\uc774\ubc0d\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ucd5c\uace0\uc758 \uacb0\uacfc\ub97c \uc5bb\uc73c\ub824\uba74 \uc801\uc808\ud55c \uc2dc\uc810\uc5d0 \ub193\uc73c\uc138\uc694.]"}, {"question": "\ub18d\uad6c \uc288\ud37c\uc2a4\ud0c0\uc5d0\uc11c \uc219\ub2ec\ud574\uc57c \ud560 \uc8fc\uc694 \ucee8\ud2b8\ub864\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub18d\uad6c \uc288\ud37c\uc2a4\ud0c0\uc758 \uc8fc\uc694 \ucee8\ud2b8\ub864\uc740 \"\uc774\ub3d9\", \"\ud328\uc2a4\", \"\uc29b\", \"\uc218\ube44\"\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc774\ub3d9\"\uc740 \uc870\uc774\uc2a4\ud2f1\uc744 \uc0ac\uc6a9\ud558\uc5ec \ucf54\ud2b8\ub97c \uc774\ub3d9\ud558\uace0, \"\ud328\uc2a4\"\ub294 \ud300 \ud50c\ub808\uc774\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ucee8\ud2b8\ub864\uc744 \uc219\ub2ec\ud558\ub294 \uac83\uc740 \ud6a8\uacfc\uc801\uc778 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. [\uc124\uc815 \ub300\uc870\ud45c: \uc774\ub3d9 - \uc870\uc774\uc2a4\ud2f1, \ud328\uc2a4 - A \ubc84\ud2bc, \uc29b - B \ubc84\ud2bc, \uc218\ube44 - X \ubc84\ud2bc]"}, {"question": "\ub18d\uad6c \uc288\ud37c\uc2a4\ud0c0\uc5d0\uc11c \ud300 \uad6c\uc131\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub18d\uad6c \uc288\ud37c\uc2a4\ud0c0\uc5d0\uc11c \ud300 \uad6c\uc131\uc740 \uc804\ubc18\uc801\uc778 \uc804\ub7b5\uacfc \uc131\ub2a5\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc5d0 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac15\ub825\ud55c \uc13c\ud130, \ubbfc\ucca9\ud55c \uac00\ub4dc, \ub2e4\uc7ac\ub2e4\ub2a5\ud55c \ud3ec\uc6cc\ub4dc\uac00 \uc788\ub294 \uade0\ud615 \uc7a1\ud78c \ud300\uc740 \ub2e4\uc591\ud55c \uac8c\uc784 \uc0c1\ud669\uc5d0 \uc801\uc751\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\uc548 \ube44\uad50: \uade0\ud615 \uc7a1\ud78c \ud300 \ub300 \uacf5\uaca9 \uc911\uc2ec \ud300 \ub300 \uc218\ube44 \uc911\uc2ec \ud300]"}, {"question": "\ub18d\uad6c \uc288\ud37c\uc2a4\ud0c0\uc5d0\uc11c \uc288\ud305 \uc815\ud655\ub3c4\ub97c \uc5b4\ub5bb\uac8c \ub192\uc77c \uc218 \uc788\ub098\uc694?", "answer": "\uc288\ud305 \uc815\ud655\ub3c4\ub97c \ub192\uc774\ub824\uba74 \uc5f0\uc2b5\uacfc \uac8c\uc784 \uba54\ucee4\ub2c8\uc998 \uc774\ud574\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \uc288\ud305 \ud1b5\uacc4\uac00 \ub192\uc740 \uc120\uc218\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. STEP2: \uc29b\ud558\uae30 \uc804\uc5d0 \uc801\uc808\ud55c \uc704\uce58\uc5d0 \uc12d\ub2c8\ub2e4. STEP3: \uc29b \ubc1c\uc0ac \ud0c0\uc774\ubc0d\uc744 \uc644\ubcbd\ud558\uac8c \ub9de\ucda5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5f0\uc2b5 \ubaa8\ub4dc\uc5d0\uc11c \"\uc2a4\ub098\uc774\ud37c \uc2a4\ud2f0\ube0c\"\ub97c \uc0ac\uc6a9\ud558\uba74 \uc774\uc5d0 \uc775\uc219\ud574\uc9c0\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc2e4\uc81c \ub18d\uad6c\uc5d0\uc11c \uc790\uc720\ud22c \uc5f0\uc2b5\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ubc18\ubcf5\uc774 \uc644\ubcbd\ud568\uc73c\ub85c \uc774\uc5b4\uc9d1\ub2c8\ub2e4.]"}, {"question": "\ub18d\uad6c \uc288\ud37c\uc2a4\ud0c0\uc5d0\uc11c \uacbd\uae30\ub97c \uc774\uae30\uae30 \uc704\ud55c \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub18d\uad6c \uc288\ud37c\uc2a4\ud0c0\uc5d0\uc11c \uacbd\uae30\ub97c \uc774\uae30\ub824\uba74 \uacf5\uaca9\uacfc \uc218\ube44 \uc804\ub7b5\uc758 \uc870\ud569\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \uacf5 \uc18c\uc720\uc5d0 \uc9d1\uc911\ud569\ub2c8\ub2e4. STEP2: \ud50c\ub808\uc774\uc5b4 \uc2a4\ud0ac\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \ud65c\uc6a9\ud569\ub2c8\ub2e4. STEP3: \uc0c1\ub300\uc758 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc744 \uc801\uc808\ud788 \uc870\uc815\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc2a4\ud53c\ub514 \uace4\uc798\ub808\uc2a4\"\uc640 \"\ube60\ub978 \ub3cc\ud30c\" \uc804\uc220\uc744 \uc0ac\uc6a9\ud558\uba74 \uc0c1\ub300\ubc29\uc744 \ud63c\ub780\uc5d0 \ube60\ub728\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \uc124\uba85: \uacf5\uaca9 \uc804\ub7b5 -> \uc218\ube44 \uc804\ub7b5 -> \uc801\uc751\ud615 \ud50c\ub808\uc774]"}, {"question": "\uacbd\uc7c1\uc801\uc778 \ud50c\ub808\uc774\ub97c \uc704\ud574 \ub18d\uad6c \uc288\ud37c\uc2a4\ud0c0\uc5d0\uc11c \uc5b4\ub5a4 \uc120\uc218 \ud1b5\uacc4\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \uace0\ub824\ud574\uc57c \ud558\ub098\uc694?", "answer": "\uacbd\uc7c1\uc801\uc778 \ud50c\ub808\uc774\ub97c \uc704\ud574 \uc18d\ub3c4, \uc288\ud305 \uc815\ud655\ub3c4, \uc218\ube44\uc640 \uac19\uc740 \ud1b5\uacc4\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \uace0\ub824\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ub808\uc774\uc800 \ub77c\ub9ac\"\ucc98\ub7fc \uc18d\ub3c4\uc640 \uc288\ud305 \uc815\ud655\ub3c4\uac00 \ub192\uc740 \uc120\uc218\ub294 \ucf54\ud2b8\ub97c \uc9c0\ubc30\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ub300\uc870\ud45c: \uc18d\ub3c4 - 90, \uc288\ud305 \uc815\ud655\ub3c4 - 85, \uc218\ube44 - 80]"}, {"question": "\ub18d\uad6c \uc288\ud37c\uc2a4\ud0c0\uc5d0\uc11c \uc2a4\ud0dc\ubbf8\ub098 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "\ub18d\uad6c \uc288\ud37c\uc2a4\ud0c0\uc758 \uc2a4\ud0dc\ubbf8\ub098\ub294 \uc2dc\uac04\uc774 \uc9c0\ub0a8\uc5d0 \ub530\ub77c \ud50c\ub808\uc774\uc5b4\uc758 \uc131\ub2a5\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc2a4\ud0dc\ubbf8\ub098\uac00 \uc18c\uc9c4\ub418\uba74 \ud50c\ub808\uc774\uc5b4\ub294 \ub290\ub824\uc9c0\uace0 \ud6a8\uc728\uc131\uc774 \ub5a8\uc5b4\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ub0b4\uad6c\uc131 \uc5d0\ub514\"\ub294 \uc2a4\ud0dc\ubbf8\ub098 \ud480\uc774 \ub354 \ub192\uc544\uc11c \ub354 \uae34 \uacbd\uae30\uc5d0\uc11c \ub354 \ub098\uc740 \uc131\ub2a5\uc744 \ubc1c\ud718\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc2a4\ud0dc\ubbf8\ub098\ub294 \ubc30\ud130\ub9ac\uc640 \uac19\uc2b5\ub2c8\ub2e4. \uc0ac\uc6a9\ud558\uba74 \uc18c\ubaa8\ub418\uace0 \ucda9\uc804\ud558\ub294 \ub370 \uc2dc\uac04\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.]"}, {"question": "\ub18d\uad6c \uc288\ud37c\uc2a4\ud0c0\uc5d0\uc11c \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \uac1c\uc778 \uae30\uc220 \ud5a5\uc0c1\uacfc \uc2a4\ud1a0\ub9ac \uc9c4\ud589\uc5d0 \uc911\uc810\uc744 \ub450\ub294 \ubc18\uba74, \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \ud300\uc6cc\ud06c\uc640 \uacbd\uc7c1\uc5d0 \uc911\uc810\uc744 \ub461\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4\uc5d0\uc11c\ub294 AI\uac00 \uc81c\uc5b4\ud558\ub294 \ud300\uacfc \ub300\uacb0\ud558\ub294 \ubc18\uba74, \uba40\ud2f0\ud50c\ub808\uc774\uc5b4\uc5d0\uc11c\ub294 \uc2e4\uc81c \ud50c\ub808\uc774\uc5b4\uc640 \ub300\uacb0\ud558\uac8c \ub429\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\uc548 \ube44\uad50: \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ub300 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \uac8c\uc784 \ud50c\ub808\uc774]"}, {"question": "\ub18d\uad6c \uc288\ud37c\uc2a4\ud0c0\uc5d0\uc11c \ubaa8\ubc14\uc77c\uc5d0\uc11c PC\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub124, \ub18d\uad6c \uc288\ud37c\uc2a4\ud0c0\uc5d0\uc11c \ubaa8\ubc14\uc77c\uc5d0\uc11c PC\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uacc4\uc815\uc744 \uc720\ub2c8\ubc84\uc124 \uac8c\uc784 \ud504\ub85c\ud544\uc5d0 \uc5f0\uacb0\ud558\uba74 \ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, Google Play \ub610\ub294 Apple ID\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub370\uc774\ud130\ub97c \ub3d9\uae30\ud654\ud558\uba74 \uc6d0\ud65c\ud55c \uc804\ud658\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \uc124\uba85: \ubaa8\ubc14\uc77c -> \uacc4\uc815 \uc5f0\uacb0 -> PC]"}, {"question": "\ub18d\uad6c \uc288\ud37c\uc2a4\ud0c0\uc5d0 \uc228\uaca8\uc9c4 \uc5c5\uc801\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\ub098\uc694?", "answer": "\ub124, \ub18d\uad6c \uc288\ud37c\uc2a4\ud0c0\uc5d0\ub294 \uc228\uaca8\uc9c4 \uc5c5\uc801\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc4f0\ub9ac \ud3ec\uc778\ud2b8 \ud53c\ud2b8\"\ub85c \uc5f0\uc18d 10\uac1c\uc758 3\uc810\uc29b\uc744 \uc131\uacf5\ud558\uba74 \ud2b9\ubcc4\ud55c \uc5c5\uc801\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.[\uc228\uaca8\uc9c4 \uc544\uc774\ud15c \ucc3e\uae30: \uac8c\uc784 \uc9c0\ub3c4\ub97c \ucca0\uc800\ud558\uac8c \ud0d0\uc0c9\ud558\uc5ec \uc228\uaca8\uc9c4 \ucf54\ud2b8\ub97c \ucc3e\uc73c\uc138\uc694.]"}]
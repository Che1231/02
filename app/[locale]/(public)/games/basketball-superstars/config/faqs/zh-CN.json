[{"question": "\u5982\u4f55\u8fdb\u884c\u7bee\u7403\u8d85\u7ea7\u660e\u661f\u521d\u5b66\u8005\u7248\u7684\u57fa\u672c\u6263\u7bee\uff1f", "answer": "\u5728\u7bee\u7403\u8d85\u7ea7\u660e\u661f\u4e2d\u8fdb\u884c\u57fa\u672c\u6263\u7bee\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u5c06\u4f60\u7684\u7403\u5458\u5b9a\u4f4d\u5728\u7bee\u7b50\u9644\u8fd1\u3002\u6b65\u9aa42\uff1a\u6309\u4e0b\u5e76\u6309\u4f4f\u201c\u6295\u7bee\u201d\u6309\u94ae\u3002\u6b65\u9aa43\uff1a\u5f53\u80fd\u91cf\u8ba1\u8fbe\u5230\u6700\u4f73\u533a\u57df\u65f6\u677e\u5f00\u6309\u94ae\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u201c\u529b\u91cf\u6263\u7bee\u201d\u6280\u80fd\u548c\u7403\u5458\u201cMJ23\u201d\u53ef\u4ee5\u83b7\u5f97\u8f83\u9ad8\u7684\u6210\u529f\u7387\u3002\u6b64\u65b9\u6cd5\u9002\u5408\u521d\u5b66\u8005\uff0c\u5e76\u5e2e\u52a9\u4f60\u8f7b\u677e\u5f97\u5206\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u60f3\u8c61\u4e00\u4e0b\uff0c\u8fd9\u5c31\u50cf\u8ba1\u65f6\u8df3\u7ef3\uff1b\u5728\u6700\u4f73\u65f6\u673a\u677e\u5f00\uff0c\u624d\u80fd\u83b7\u5f97\u6700\u4f73\u7ed3\u679c\u3002]"}, {"question": "\u5728\u7bee\u7403\u8d85\u7ea7\u660e\u661f\u4e2d\uff0c\u9700\u8981\u638c\u63e1\u54ea\u4e9b\u5173\u952e\u63a7\u5236\uff1f", "answer": "\u7bee\u7403\u8d85\u7ea7\u660e\u661f\u4e2d\u7684\u5173\u952e\u63a7\u5236\u5305\u62ec\u201c\u79fb\u52a8\u201d\u3001\u201c\u4f20\u7403\u201d\u3001\u201c\u6295\u7bee\u201d\u548c\u201c\u9632\u5b88\u201d\u3002\u4f8b\u5982\uff0c\u201c\u79fb\u52a8\u201d\u4f7f\u7528\u64cd\u7eb5\u6746\u5728\u7403\u573a\u4e0a\u5bfc\u822a\uff0c\u201c\u4f20\u7403\u201d\u5bf9\u4e8e\u56e2\u961f\u5408\u4f5c\u81f3\u5173\u91cd\u8981\u3002\u638c\u63e1\u8fd9\u4e9b\u63a7\u5236\u5bf9\u4e8e\u6709\u6548\u7684\u6e38\u620f\u73a9\u6cd5\u81f3\u5173\u91cd\u8981\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u79fb\u52a8 - \u64cd\u7eb5\u6746\uff0c\u4f20\u7403 - A \u6309\u94ae\uff0c\u6295\u7bee - B \u6309\u94ae\uff0c\u9632\u5b88 - X \u6309\u94ae]"}, {"question": "\u7bee\u7403\u8d85\u7ea7\u660e\u661f\u4e2d\u56e2\u961f\u914d\u7f6e\u4e3a\u4ec0\u4e48\u91cd\u8981\uff1f", "answer": "\u5728\u7bee\u7403\u8d85\u7ea7\u660e\u661f\u4e2d\uff0c\u56e2\u961f\u914d\u7f6e\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u4f1a\u5f71\u54cd\u4f60\u7684\u6574\u4f53\u7b56\u7565\u548c\u8868\u73b0\u3002\u4f8b\u5982\uff0c\u4e00\u652f\u62e5\u6709\u5f3a\u5927\u4e2d\u950b\u3001\u654f\u6377\u540e\u536b\u548c\u591a\u529f\u80fd\u524d\u950b\u7684\u5e73\u8861\u578b\u7403\u961f\u53ef\u4ee5\u9002\u5e94\u5404\u79cd\u6bd4\u8d5b\u60c5\u51b5\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u5e73\u8861\u578b\u7403\u961f\u4e0e\u8fdb\u653b\u578b\u7403\u961f\u4e0e\u9632\u5b88\u578b\u7403\u961f]"}, {"question": "\u5982\u4f55\u5728\u7bee\u7403\u8d85\u7ea7\u660e\u661f\u4e2d\u63d0\u9ad8\u6211\u7684\u6295\u7bee\u51c6\u786e\u6027\uff1f", "answer": "\u63d0\u9ad8\u6295\u7bee\u51c6\u786e\u6027\u9700\u8981\u7ec3\u4e60\u548c\u7406\u89e3\u6e38\u620f\u673a\u5236\u3002\u6b65\u9aa41\uff1a\u9009\u62e9\u4e00\u540d\u5177\u6709\u9ad8\u6295\u7bee\u7edf\u8ba1\u6570\u636e\u7684\u7403\u5458\u3002\u6b65\u9aa42\uff1a\u5728\u6295\u7bee\u524d\u6b63\u786e\u5b9a\u4f4d\u81ea\u5df1\u3002\u6b65\u9aa43\uff1a\u5b8c\u7f8e\u5730\u63a7\u5236\u6295\u7bee\u65f6\u673a\u3002\u4f8b\u5982\uff0c\u5728\u7ec3\u4e60\u6a21\u5f0f\u4e2d\u4f7f\u7528\u201c\u795e\u67aa\u624b\u53f2\u8482\u592b\u201d\u53ef\u4ee5\u5e2e\u52a9\u4f60\u638c\u63e1\u5b83\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u8fd9\u5c31\u50cf\u5728\u771f\u6b63\u7684\u7bee\u7403\u6bd4\u8d5b\u4e2d\u7ec3\u4e60\u7f5a\u7403\uff1b\u91cd\u590d\u7ec3\u4e60\u624d\u80fd\u8fbe\u5230\u5b8c\u7f8e\u3002]"}, {"question": "\u5728\u7bee\u7403\u8d85\u7ea7\u660e\u661f\u4e2d\uff0c\u6211\u53ef\u4ee5\u4f7f\u7528\u54ea\u4e9b\u7b56\u7565\u6765\u8d62\u5f97\u6bd4\u8d5b\uff1f", "answer": "\u5728\u7bee\u7403\u8d85\u7ea7\u660e\u661f\u4e2d\u8d62\u5f97\u6bd4\u8d5b\u9700\u8981\u7ed3\u5408\u8fdb\u653b\u548c\u9632\u5b88\u7b56\u7565\u3002\u6b65\u9aa41\uff1a\u4e13\u6ce8\u4e8e\u63a7\u7403\u3002\u6b65\u9aa42\uff1a\u6709\u6548\u5229\u7528\u7403\u5458\u6280\u80fd\u3002\u6b65\u9aa43\uff1a\u9002\u5e94\u5bf9\u624b\u7684\u6253\u6cd5\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u201c\u5feb\u653b\u201d\u6218\u672f\u548c\u201c\u8fc5\u6377\u5188\u8428\u96f7\u65af\u201d\u53ef\u4ee5\u51fa\u5176\u4e0d\u610f\u5730\u6293\u4f4f\u5bf9\u624b\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u8fdb\u653b\u7b56\u7565 -> \u9632\u5b88\u7b56\u7565 -> \u9002\u5e94\u6027\u6bd4\u8d5b]"}, {"question": "\u5728\u7bee\u7403\u8d85\u7ea7\u660e\u661f\u7684\u7ade\u6280\u6bd4\u8d5b\u4e2d\uff0c\u6211\u5e94\u8be5\u4f18\u5148\u8003\u8651\u54ea\u4e9b\u7403\u5458\u5c5e\u6027\uff1f", "answer": "\u5728\u7ade\u6280\u6bd4\u8d5b\u4e2d\uff0c\u8981\u4f18\u5148\u8003\u8651\u901f\u5ea6\u3001\u6295\u7bee\u51c6\u786e\u6027\u548c\u9632\u5b88\u5c5e\u6027\u3002\u4f8b\u5982\uff0c\u4e00\u540d\u62e5\u6709\u9ad8\u901f\u5ea6\u548c\u9ad8\u6295\u7bee\u51c6\u786e\u6027\u7684\u7403\u5458\uff0c\u4f8b\u5982\u201c\u6fc0\u5149\u62c9\u91cc\u201d\uff0c\u53ef\u4ee5\u4e3b\u5bb0\u8d5b\u573a\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u901f\u5ea6 - 90\uff0c\u6295\u7bee\u51c6\u786e\u6027 - 85\uff0c\u9632\u5b88 - 80]"}, {"question": "\u7bee\u7403\u8d85\u7ea7\u660e\u661f\u4e2d\u7684\u4f53\u529b\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u7bee\u7403\u8d85\u7ea7\u660e\u661f\u4e2d\u7684\u4f53\u529b\u7cfb\u7edf\u4f1a\u968f\u7740\u65f6\u95f4\u7684\u63a8\u79fb\u5f71\u54cd\u7403\u5458\u8868\u73b0\u3002\u968f\u7740\u4f53\u529b\u7684\u6d88\u8017\uff0c\u7403\u5458\u4f1a\u53d8\u6162\uff0c\u6548\u7387\u4e5f\u4f1a\u964d\u4f4e\u3002\u4f8b\u5982\uff0c\u201c\u8010\u529b\u57c3\u8fea\u201d\u62e5\u6709\u66f4\u9ad8\u7684\u4f53\u529b\u6c60\uff0c\u8ba9\u4ed6\u80fd\u5728\u66f4\u957f\u7684\u6bd4\u8d5b\u4e2d\u8868\u73b0\u66f4\u597d\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u60f3\u8c61\u4e00\u4e0b\uff0c\u4f53\u529b\u5c31\u50cf\u4e00\u4e2a\u7535\u6c60\uff1b\u4f7f\u7528\u540e\u4f1a\u8017\u5c3d\uff0c\u9700\u8981\u65f6\u95f4\u5145\u7535\u3002]"}, {"question": "\u7bee\u7403\u8d85\u7ea7\u660e\u661f\u4e2d\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u6709\u4ec0\u4e48\u533a\u522b\uff1f", "answer": "\u5355\u4eba\u6a21\u5f0f\u4fa7\u91cd\u4e8e\u4e2a\u4eba\u6280\u80fd\u7684\u63d0\u5347\u548c\u6545\u4e8b\u7684\u63a8\u8fdb\uff0c\u800c\u591a\u4eba\u6a21\u5f0f\u4fa7\u91cd\u4e8e\u56e2\u961f\u5408\u4f5c\u548c\u7ade\u4e89\u3002\u4f8b\u5982\uff0c\u5728\u5355\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f60\u53ef\u80fd\u4f1a\u9762\u5bf9\u7531\u4eba\u5de5\u667a\u80fd\u63a7\u5236\u7684\u7403\u961f\uff0c\u800c\u591a\u4eba\u6a21\u5f0f\u5219\u8ba9\u4f60\u4e0e\u771f\u6b63\u7684\u73a9\u5bb6\u5bf9\u6297\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u5355\u4eba\u6a21\u5f0f\u4e0e\u591a\u4eba\u6a21\u5f0f\u6e38\u620f]"}, {"question": "\u6211\u53ef\u4ee5\u5728\u7bee\u7403\u8d85\u7ea7\u660e\u661f\u4e2d\u5c06\u6211\u7684\u79fb\u52a8\u7aef\u8fdb\u5ea6\u8f6c\u79fb\u5230\u7535\u8111\u7aef\u5417\uff1f", "answer": "\u662f\u7684\uff0c\u4f60\u53ef\u4ee5\u901a\u8fc7\u5c06\u4f60\u7684\u8d26\u6237\u94fe\u63a5\u5230\u4e00\u4e2a\u901a\u7528\u6e38\u620f\u4e2a\u4eba\u8d44\u6599\u6765\u5c06\u4f60\u5728\u7bee\u7403\u8d85\u7ea7\u660e\u661f\u4e2d\u7684\u79fb\u52a8\u7aef\u8fdb\u5ea6\u8f6c\u79fb\u5230\u7535\u8111\u7aef\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u4f60\u7684 Google Play \u6216 Apple ID \u540c\u6b65\u6570\u636e\uff0c\u786e\u4fdd\u5e73\u6ed1\u8fc7\u6e21\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u79fb\u52a8\u7aef -> \u8d26\u6237\u94fe\u63a5 -> \u7535\u8111\u7aef]"}, {"question": "\u7bee\u7403\u8d85\u7ea7\u660e\u661f\u4e2d\u662f\u5426\u6709\u4efb\u4f55\u9690\u85cf\u6210\u5c31\u6216\u5f69\u86cb\uff1f", "answer": "\u662f\u7684\uff0c\u7bee\u7403\u8d85\u7ea7\u660e\u661f\u4e2d\u5305\u542b\u9690\u85cf\u6210\u5c31\u548c\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u201c\u4e09\u5206\u7ebf\u5f7c\u5f97\u201d\u8fde\u7eed\u6295\u4e2d 10 \u4e2a\u4e09\u5206\u7403\u53ef\u4ee5\u89e3\u9501\u4e00\u4e2a\u7279\u6b8a\u6210\u5c31\u3002[\u5f69\u86cb\u6316\u6398\uff1a\u901a\u8fc7\u5f7b\u5e95\u63a2\u7d22\u6e38\u620f\u5730\u56fe\u6765\u53d1\u73b0\u9690\u85cf\u7403\u573a\u3002]"}]
[{"question": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30fc\u30d1\u30fc\u30b9\u30bf\u30fc\u30ba\u3067\u521d\u5fc3\u8005\u3068\u3057\u3066\u57fa\u672c\u7684\u306a\u30c0\u30f3\u30af\u306f\u3069\u3046\u3059\u308c\u3070\u5b9f\u884c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30fc\u30d1\u30fc\u30b9\u30bf\u30fc\u30ba\u3067\u57fa\u672c\u7684\u306a\u30c0\u30f3\u30af\u3092\u884c\u3046\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u30d0\u30b9\u30b1\u30c3\u30c8\u8fd1\u304f\u306b\u914d\u7f6e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u300e\u30b7\u30e5\u30fc\u30c8\u300f\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u7d9a\u3051\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30d1\u30ef\u30fc\u30e1\u30fc\u30bf\u30fc\u304c\u6700\u9069\u306a\u30be\u30fc\u30f3\u306b\u9054\u3057\u305f\u3089\u30dc\u30bf\u30f3\u3092\u96e2\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30d1\u30ef\u30fc\u30c0\u30f3\u30af\u300f\u30b9\u30ad\u30eb\u3092\u30d7\u30ec\u30a4\u30e4\u30fc\u300eMJ23\u300f\u3067\u4f7f\u7528\u3059\u308b\u3068\u3001\u6210\u529f\u7387\u304c\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002\u3053\u306e\u65b9\u6cd5\u306f\u521d\u5fc3\u8005\u5411\u3051\u3067\u3001\u7c21\u5358\u306b\u5f97\u70b9\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u30b8\u30e3\u30f3\u30d7\u30ed\u30fc\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u4e00\u7dd2\u3067\u3059\u3002\u6700\u9ad8\u306e\u7d50\u679c\u3092\u5f97\u308b\u306b\u306f\u3001\u9069\u5207\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u96e2\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30fc\u30d1\u30fc\u30b9\u30bf\u30fc\u30ba\u3067\u30de\u30b9\u30bf\u30fc\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u4e3b\u8981\u306a\u64cd\u4f5c\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30fc\u30d1\u30fc\u30b9\u30bf\u30fc\u30ba\u3067\u91cd\u8981\u306a\u64cd\u4f5c\u306b\u306f\u3001\u300e\u79fb\u52d5\u300f\u3001\u300e\u30d1\u30b9\u300f\u3001\u300e\u30b7\u30e5\u30fc\u30c8\u300f\u3001\u300e\u30c7\u30a3\u30d5\u30a7\u30f3\u30b9\u300f\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u79fb\u52d5\u300f\u306f\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u3092\u4f7f\u7528\u3057\u3066\u30b3\u30fc\u30c8\u3092\u79fb\u52d5\u3057\u3001\u300e\u30d1\u30b9\u300f\u306f\u30c1\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3068\u3063\u3066\u91cd\u8981\u3067\u3059\u3002\u3053\u308c\u3089\u306e\u64cd\u4f5c\u3092\u7fd2\u5f97\u3059\u308b\u3053\u3068\u306f\u3001\u52b9\u679c\u7684\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002[\u8a2d\u5b9a\u5bfe\u7167\u8868\uff1a\u79fb\u52d5-\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u3001\u30d1\u30b9-A\u30dc\u30bf\u30f3\u3001\u30b7\u30e5\u30fc\u30c8-B\u30dc\u30bf\u30f3\u3001\u30c7\u30a3\u30d5\u30a7\u30f3\u30b9-X\u30dc\u30bf\u30f3]"}, {"question": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30fc\u30d1\u30fc\u30b9\u30bf\u30fc\u30ba\u3067\u30c1\u30fc\u30e0\u69cb\u6210\u306f\u306a\u305c\u91cd\u8981\u3067\u3059\u304b\uff1f", "answer": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30fc\u30d1\u30fc\u30b9\u30bf\u30fc\u30ba\u3067\u30c1\u30fc\u30e0\u69cb\u6210\u306f\u3001\u5168\u4f53\u7684\u306a\u6226\u7565\u3068\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u305f\u3081\u3001\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u5f37\u529b\u306a\u30bb\u30f3\u30bf\u30fc\u3001\u6a5f\u654f\u306a\u30ac\u30fc\u30c9\u3001\u305d\u3057\u3066\u591a\u69d8\u306a\u30d5\u30a9\u30ef\u30fc\u30c9\u3092\u6301\u3064\u30d0\u30e9\u30f3\u30b9\u306e\u53d6\u308c\u305f\u30c1\u30fc\u30e0\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u30b2\u30fc\u30e0\u72b6\u6cc1\u306b\u5bfe\u5fdc\u3067\u304d\u307e\u3059\u3002[\u8907\u6570\u6848\u6bd4\u8f03\uff1a\u30d0\u30e9\u30f3\u30b9\u306e\u53d6\u308c\u305f\u30c1\u30fc\u30e0\u5bfe\u653b\u6483\u91cd\u8996\u30c1\u30fc\u30e0\u5bfe\u9632\u5fa1\u91cd\u8996\u30c1\u30fc\u30e0]"}, {"question": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30fc\u30d1\u30fc\u30b9\u30bf\u30fc\u30ba\u3067\u30b7\u30e5\u30fc\u30c8\u306e\u7cbe\u5ea6\u3092\u4e0a\u3052\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30b7\u30e5\u30fc\u30c8\u306e\u7cbe\u5ea6\u3092\u4e0a\u3052\u308b\u306b\u306f\u3001\u7df4\u7fd2\u3068\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u306e\u7406\u89e3\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u9ad8\u3044\u30b7\u30e5\u30fc\u30c8\u80fd\u529b\u3092\u6301\u3064\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u9078\u3073\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b7\u30e5\u30fc\u30c8\u3059\u308b\u524d\u306b\u6b63\u3057\u3044\u4f4d\u7f6e\u3092\u53d6\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b7\u30e5\u30fc\u30c8\u3092\u5b8c\u74a7\u306b\u30bf\u30a4\u30df\u30f3\u30b0\u3088\u304f\u30ea\u30ea\u30fc\u30b9\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u7df4\u7fd2\u30e2\u30fc\u30c9\u3067\u300e\u30b9\u30ca\u30a4\u30d1\u30fc\u30fb\u30b9\u30c6\u30a3\u30fc\u30d6\u300f\u3092\u4f7f\u3046\u3068\u3001\u30b3\u30c4\u3092\u63b4\u3080\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u5b9f\u969b\u306e\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u3067\u30d5\u30ea\u30fc\u30b9\u30ed\u30fc\u3092\u7df4\u7fd2\u3059\u308b\u3053\u3068\u3068\u540c\u3058\u3067\u3059\u3002\u7e70\u308a\u8fd4\u3057\u7df4\u7fd2\u3059\u308c\u3070\u3001\u5b8c\u74a7\u306b\u306a\u308a\u307e\u3059\u3002]"}, {"question": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30fc\u30d1\u30fc\u30b9\u30bf\u30fc\u30ba\u3067\u8a66\u5408\u306b\u52dd\u3064\u305f\u3081\u306b\u4f7f\u3048\u308b\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30fc\u30d1\u30fc\u30b9\u30bf\u30fc\u30ba\u3067\u8a66\u5408\u306b\u52dd\u3064\u306b\u306f\u3001\u653b\u6483\u3068\u9632\u5fa1\u306e\u6226\u7565\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30dc\u30fc\u30eb\u306e\u4fdd\u6301\u306b\u96c6\u4e2d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b9\u30ad\u30eb\u3092\u52b9\u679c\u7684\u306b\u6d3b\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u76f8\u624b\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u9069\u5fdc\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30b9\u30d4\u30fc\u30c9\u30b4\u30f3\u30b6\u30ec\u30b9\u300f\u3068\u300e\u30d5\u30a1\u30b9\u30c8\u30d6\u30ec\u30fc\u30af\u300f\u6226\u8853\u3092\u4f7f\u3046\u3068\u3001\u76f8\u624b\u3092\u6cb9\u65ad\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u653b\u6483\u6226\u7565\u2192\u9632\u5fa1\u6226\u7565\u2192\u9069\u5fdc\u30d7\u30ec\u30a4]"}, {"question": "\u7af6\u4e89\u30d7\u30ec\u30a4\u306b\u304a\u3044\u3066\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30fc\u30d1\u30fc\u30b9\u30bf\u30fc\u30ba\u3067\u512a\u5148\u3059\u3079\u304d\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u7af6\u4e89\u30d7\u30ec\u30a4\u306b\u304a\u3044\u3066\u306f\u3001\u30b9\u30d4\u30fc\u30c9\u3001\u30b7\u30e5\u30fc\u30c8\u7cbe\u5ea6\u3001\u30c7\u30a3\u30d5\u30a7\u30f3\u30b9\u306a\u3069\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u9ad8\u3044\u30b9\u30d4\u30fc\u30c9\u3068\u30b7\u30e5\u30fc\u30c8\u7cbe\u5ea6\u3092\u6301\u3064\u30d7\u30ec\u30a4\u30e4\u30fc\u300e\u30ec\u30fc\u30b6\u30fc\u30fb\u30e9\u30ea\u30fc\u300f\u306f\u3001\u30b3\u30fc\u30c8\u3092\u652f\u914d\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u8a2d\u5b9a\u5bfe\u7167\u8868\uff1a\u30b9\u30d4\u30fc\u30c9-90\u3001\u30b7\u30e5\u30fc\u30c8\u7cbe\u5ea6-85\u3001\u30c7\u30a3\u30d5\u30a7\u30f3\u30b9-80]"}, {"question": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30fc\u30d1\u30fc\u30b9\u30bf\u30fc\u30ba\u3067\u306e\u30b9\u30bf\u30df\u30ca\u30b7\u30b9\u30c6\u30e0\u306e\u4ed5\u7d44\u307f\u306f\uff1f", "answer": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30fc\u30d1\u30fc\u30b9\u30bf\u30fc\u30ba\u3067\u306e\u30b9\u30bf\u30df\u30ca\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6642\u9593\u306e\u7d4c\u904e\u3068\u3068\u3082\u306b\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u30b9\u30bf\u30df\u30ca\u304c\u6e1b\u5c11\u3059\u308b\u3068\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u9045\u304f\u306a\u308a\u3001\u52b9\u679c\u304c\u4f4e\u4e0b\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30a8\u30f3\u30c9\u30a5\u30e9\u30f3\u30b9\u30fb\u30a8\u30c7\u30a3\u300f\u306f\u30b9\u30bf\u30df\u30ca\u30d7\u30fc\u30eb\u304c\u9ad8\u3044\u305f\u3081\u3001\u9577\u6642\u9593\u8a66\u5408\u3092\u3059\u308b\u969b\u306b\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u7dad\u6301\u3067\u304d\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u30b9\u30bf\u30df\u30ca\u306f\u30d0\u30c3\u30c6\u30ea\u30fc\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u4f7f\u7528\u3059\u308b\u3068\u6d88\u8017\u3057\u3001\u5145\u96fb\u3059\u308b\u306b\u306f\u6642\u9593\u304c\u5fc5\u8981\u3067\u3059\u3002]"}, {"question": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30fc\u30d1\u30fc\u30b9\u30bf\u30fc\u30ba\u306b\u304a\u3051\u308b\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306e\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u3001\u500b\u3005\u306e\u30b9\u30ad\u30eb\u958b\u767a\u3068\u30b9\u30c8\u30fc\u30ea\u30fc\u9032\u884c\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u304a\u308a\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u3068\u7af6\u4e89\u306b\u91cd\u70b9\u3092\u7f6e\u3044\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u306f\u3001AI\u5236\u5fa1\u306e\u30c1\u30fc\u30e0\u306b\u76f4\u9762\u3059\u308b\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u304c\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u306f\u5b9f\u969b\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u5bfe\u6226\u3057\u307e\u3059\u3002[\u8907\u6570\u6848\u6bd4\u8f03\uff1a\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u5bfe\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4]"}, {"question": "\u30e2\u30d0\u30a4\u30eb\u7248\u304b\u3089PC\u7248\u3078\u306e\u9032\u6357\u72b6\u6cc1\u306e\u79fb\u884c\u306f\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30fc\u30d1\u30fc\u30b9\u30bf\u30fc\u30ba\u3067\u53ef\u80fd\u3067\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30fc\u30d1\u30fc\u30b9\u30bf\u30fc\u30ba\u3067\u30e2\u30d0\u30a4\u30eb\u7248\u304b\u3089PC\u7248\u3078\u306e\u9032\u6357\u72b6\u6cc1\u306e\u79fb\u884c\u306f\u53ef\u80fd\u3067\u3059\u3002\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30e6\u30cb\u30d0\u30fc\u30b5\u30eb\u30b2\u30fc\u30df\u30f3\u30b0\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\u306b\u30ea\u30f3\u30af\u3059\u308b\u3053\u3068\u3067\u3001\u9032\u6357\u72b6\u6cc1\u3092\u79fb\u884c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001Google Play\u307e\u305f\u306fApple ID\u3092\u4f7f\u7528\u3057\u3066\u30c7\u30fc\u30bf\u3092\u540c\u671f\u3059\u308b\u3068\u3001\u30b9\u30e0\u30fc\u30ba\u306a\u79fb\u884c\u304c\u53ef\u80fd\u306b\u306a\u308a\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30e2\u30d0\u30a4\u30eb\u2192\u30a2\u30ab\u30a6\u30f3\u30c8\u9023\u643a\u2192PC]"}, {"question": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30fc\u30d1\u30fc\u30b9\u30bf\u30fc\u30ba\u306b\u306f\u96a0\u3055\u308c\u305f\u5b9f\u7e3e\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30fc\u30d1\u30fc\u30b9\u30bf\u30fc\u30ba\u306b\u306f\u96a0\u3055\u308c\u305f\u5b9f\u7e3e\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30b9\u30ea\u30fc\u30dd\u30a4\u30f3\u30c8\u30fb\u30d4\u30fc\u30c8\u300f\u3067\u9023\u7d9a\u3057\u306610\u672c\u306e3\u30dd\u30a4\u30f3\u30c8\u30b7\u30e5\u30fc\u30c8\u3092\u6c7a\u3081\u308b\u3053\u3068\u3067\u3001\u7279\u5225\u306a\u5b9f\u7e3e\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002[\u5f69\u86cb\u63a2\u7d22\uff1a\u30b2\u30fc\u30e0\u30de\u30c3\u30d7\u3092\u5fb9\u5e95\u7684\u306b\u63a2\u7d22\u3059\u308b\u3053\u3068\u3067\u3001\u96a0\u308c\u305f\u30b3\u30fc\u30c8\u3092\u767a\u898b\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}]
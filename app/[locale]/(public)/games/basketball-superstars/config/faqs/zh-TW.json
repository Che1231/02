[{"question": "\u5982\u4f55\u4ee5\u65b0\u624b\u8eab\u4efd\u5728\u7c43\u7403\u660e\u661f\u8cfd\u4e2d\u57f7\u884c\u57fa\u672c\u704c\u7c43\uff1f", "answer": "\u5728\u7c43\u7403\u660e\u661f\u8cfd\u4e2d\u57f7\u884c\u57fa\u672c\u704c\u7c43\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u5c07\u60a8\u7684\u7403\u54e1\u7f6e\u65bc\u7c43\u6846\u9644\u8fd1\u3002\u6b65\u9a5f2\uff1a\u6309\u4f4f\"\u6295\u7c43\"\u6309\u9215\u3002\u6b65\u9a5f3\uff1a\u7576\u529b\u91cf\u8a08\u9054\u5230\u6700\u4f73\u5340\u57df\u6642\u9b06\u958b\u6309\u9215\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\"\u529b\u91cf\u704c\u7c43\"\u6280\u5de7\u642d\u914d\u7403\u54e1\"MJ23\"\u53ef\u4ee5\u7372\u5f97\u8f03\u9ad8\u7684\u6210\u529f\u7387\u3002\u6b64\u65b9\u6cd5\u9069\u5408\u65b0\u624b\uff0c\u4e26\u80fd\u5e6b\u52a9\u60a8\u8f15\u9b06\u5f97\u5206\u3002[\u6bd4\u55bb\u8aaa\u660e: \u60f3\u60f3\u770b\uff0c\u9019\u5c31\u50cf\u8a08\u6642\u8df3\u7e69\uff1b\u5728\u6b63\u78ba\u7684\u6642\u6a5f\u9b06\u958b\uff0c\u624d\u80fd\u7372\u5f97\u6700\u4f73\u6548\u679c\u3002]"}, {"question": "\u5728\u7c43\u7403\u660e\u661f\u8cfd\u4e2d\uff0c\u6211\u9700\u8981\u638c\u63e1\u54ea\u4e9b\u4e3b\u8981\u63a7\u5236\uff1f", "answer": "\u7c43\u7403\u660e\u661f\u8cfd\u7684\u4e3b\u8981\u63a7\u5236\u5305\u62ec\"\u79fb\u52d5\"\u3001\"\u50b3\u7403\"\u3001\"\u6295\u7c43\"\u548c\"\u9632\u5b88\"\u3002\u4f8b\u5982\uff0c\"\u79fb\u52d5\"\u4f7f\u7528\u64cd\u7e31\u687f\u5728\u7403\u5834\u4e0a\u79fb\u52d5\uff0c\u800c\"\u50b3\u7403\"\u5c0d\u65bc\u5718\u968a\u5408\u4f5c\u81f3\u95dc\u91cd\u8981\u3002\u719f\u7df4\u638c\u63e1\u9019\u4e9b\u63a7\u5236\u5c0d\u65bc\u6709\u6548\u5730\u9032\u884c\u904a\u6232\u81f3\u95dc\u91cd\u8981\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u79fb\u52d5 - \u64cd\u7e31\u687f\uff0c\u50b3\u7403 - A \u6309\u9215\uff0c\u6295\u7c43 - B \u6309\u9215\uff0c\u9632\u5b88 - X \u6309\u9215]"}, {"question": "\u70ba\u4ec0\u9ebc\u5728\u7c43\u7403\u660e\u661f\u8cfd\u4e2d\uff0c\u5718\u968a\u7d44\u6210\u5f88\u91cd\u8981\uff1f", "answer": "\u5728\u7c43\u7403\u660e\u661f\u8cfd\u4e2d\uff0c\u5718\u968a\u7d44\u6210\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6703\u5f71\u97ff\u60a8\u7684\u6574\u9ad4\u7b56\u7565\u548c\u8868\u73fe\u3002\u4f8b\u5982\uff0c\u4e00\u500b\u64c1\u6709\u5f37\u5927\u7684\u4e2d\u92d2\u3001\u9748\u6d3b\u7684\u5f8c\u885b\u548c\u591a\u529f\u80fd\u7684\u524d\u92d2\u7684\u5e73\u8861\u5718\u968a\u53ef\u4ee5\u9069\u61c9\u5404\u7a2e\u904a\u6232\u60c5\u6cc1\u3002[\u591a\u65b9\u6848\u6bd4\u8f03: \u5e73\u8861\u5718\u968a vs. \u653b\u52e2\u578b\u5718\u968a vs. \u9632\u5b88\u578b\u5718\u968a]"}, {"question": "\u5982\u4f55\u5728\u7c43\u7403\u660e\u661f\u8cfd\u4e2d\u63d0\u5347\u6211\u7684\u6295\u7c43\u6e96\u78ba\u5ea6\uff1f", "answer": "\u63d0\u5347\u7c43\u7403\u660e\u661f\u8cfd\u4e2d\u7684\u6295\u7c43\u6e96\u78ba\u5ea6\u9700\u8981\u7df4\u7fd2\u548c\u4e86\u89e3\u904a\u6232\u6a5f\u5236\u3002\u6b65\u9a5f1\uff1a\u9078\u64c7\u4e00\u4f4d\u5177\u6709\u9ad8\u6295\u7c43\u6578\u64da\u7684\u7403\u54e1\u3002\u6b65\u9a5f2\uff1a\u5728\u6295\u7c43\u524d\u6b63\u78ba\u5730\u5b9a\u4f4d\u81ea\u5df1\u3002\u6b65\u9a5f3\uff1a\u5b8c\u7f8e\u5730\u8a08\u6642\u6295\u7c43\u52d5\u4f5c\u3002\u4f8b\u5982\uff0c\u5728\u7df4\u7fd2\u6a21\u5f0f\u4e2d\u4f7f\u7528\"\u72d9\u64ca\u624b\u53f2\u8482\u592b\"\u53ef\u4ee5\u5e6b\u52a9\u60a8\u638c\u63e1\u8a23\u7ac5\u3002[\u6bd4\u55bb\u8aaa\u660e: \u9019\u5c31\u50cf\u5728\u771f\u5be6\u7c43\u7403\u6bd4\u8cfd\u4e2d\u7df4\u7fd2\u7f70\u7403\uff1b\u53cd\u8986\u7df4\u7fd2\u624d\u80fd\u9054\u5230\u5b8c\u7f8e\u3002]"}, {"question": "\u6211\u53ef\u4ee5\u7528\u54ea\u4e9b\u7b56\u7565\u5728\u7c43\u7403\u660e\u661f\u8cfd\u4e2d\u8d0f\u5f97\u6bd4\u8cfd\uff1f", "answer": "\u5728\u7c43\u7403\u660e\u661f\u8cfd\u4e2d\u8d0f\u5f97\u6bd4\u8cfd\u9700\u8981\u7d50\u5408\u9032\u653b\u548c\u9632\u5b88\u7b56\u7565\u3002\u6b65\u9a5f1\uff1a\u5c08\u6ce8\u65bc\u7403\u6b0a\u3002\u6b65\u9a5f2\uff1a\u6709\u6548\u904b\u7528\u7403\u54e1\u6280\u5de7\u3002\u6b65\u9a5f3\uff1a\u9069\u61c9\u5c0d\u624b\u7684\u6bd4\u8cfd\u98a8\u683c\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\"\u5feb\u901f\u7a81\u7834\"\u7b56\u7565\u642d\u914d\"\u901f\u5ea6\u9b3c\"\u53ef\u4ee5\u51fa\u5176\u4e0d\u610f\u5730\u64ca\u6557\u5c0d\u624b\u3002[\u6d41\u7a0b\u5716\u89e3: \u9032\u653b\u7b56\u7565 -> \u9632\u5b88\u7b56\u7565 -> \u9069\u61c9\u6027\u6bd4\u8cfd]"}, {"question": "\u5728\u7c43\u7403\u660e\u661f\u8cfd\u4e2d\uff0c\u7af6\u722d\u6027\u904a\u6232\u4e2d\uff0c\u6211\u61c9\u8a72\u512a\u5148\u8003\u616e\u54ea\u4e9b\u7403\u54e1\u6578\u64da\uff1f", "answer": "\u5728\u7af6\u722d\u6027\u904a\u6232\u4e2d\uff0c\u512a\u5148\u8003\u616e\u901f\u5ea6\u3001\u6295\u7c43\u6e96\u78ba\u5ea6\u548c\u9632\u5b88\u7b49\u6578\u64da\u3002\u4f8b\u5982\uff0c\u901f\u5ea6\u548c\u6295\u7c43\u6e96\u78ba\u5ea6\u90fd\u5f88\u9ad8\u7684\u7403\u54e1\uff0c\u4f8b\u5982\"\u96f7\u5c04\u62c9\u91cc\"\uff0c\u53ef\u4ee5\u4e3b\u5c0e\u6bd4\u8cfd\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u901f\u5ea6 - 90\uff0c\u6295\u7c43\u6e96\u78ba\u5ea6 - 85\uff0c\u9632\u5b88 - 80]"}, {"question": "\u7c43\u7403\u660e\u661f\u8cfd\u4e2d\u7684\u9ad4\u529b\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u7c43\u7403\u660e\u661f\u8cfd\u4e2d\u7684\u9ad4\u529b\u7cfb\u7d71\u6703\u96a8\u8457\u6642\u9593\u5f71\u97ff\u7403\u54e1\u7684\u8868\u73fe\u3002\u96a8\u8457\u9ad4\u529b\u7684\u6d88\u8017\uff0c\u7403\u54e1\u6703\u8b8a\u5f97\u6bd4\u8f03\u6162\u4e14\u6548\u7387\u964d\u4f4e\u3002\u4f8b\u5982\uff0c\"\u8010\u529b\u611b\u8fea\"\u64c1\u6709\u66f4\u9ad8\u7684\u9ad4\u529b\u6c60\uff0c\u8b93\u4ed6\u80fd\u5728\u8f03\u9577\u7684\u6bd4\u8cfd\u4e2d\u8868\u73fe\u5f97\u66f4\u597d\u3002[\u6bd4\u55bb\u8aaa\u660e: \u60f3\u60f3\u770b\uff0c\u9ad4\u529b\u5c31\u50cf\u96fb\u6c60\uff1b\u4f7f\u7528\u5f8c\u6703\u8017\u76e1\uff0c\u9700\u8981\u6642\u9593\u624d\u80fd\u6062\u5fa9\u3002]"}, {"question": "\u7c43\u7403\u660e\u661f\u8cfd\u4e2d\u7684\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u6709\u4ec0\u9ebc\u5340\u5225\uff1f", "answer": "\u55ae\u4eba\u6a21\u5f0f\u5c08\u6ce8\u65bc\u500b\u4eba\u6280\u80fd\u7684\u57f9\u990a\u548c\u6545\u4e8b\u7684\u9032\u5c55\uff0c\u800c\u591a\u4eba\u6a21\u5f0f\u5247\u5f37\u8abf\u5718\u968a\u5408\u4f5c\u548c\u7af6\u722d\u3002\u4f8b\u5982\uff0c\u5728\u55ae\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f60\u53ef\u80fd\u6703\u9762\u5c0d\u7531 AI \u63a7\u5236\u7684\u5718\u968a\uff0c\u800c\u591a\u4eba\u6a21\u5f0f\u5247\u8b93\u4f60\u8207\u771f\u5be6\u73a9\u5bb6\u5c0d\u6297\u3002[\u591a\u65b9\u6848\u6bd4\u8f03: \u55ae\u4eba\u6a21\u5f0f vs. \u591a\u4eba\u6a21\u5f0f\u904a\u6232]"}, {"question": "\u6211\u53ef\u4ee5\u5728\u7c43\u7403\u660e\u661f\u8cfd\u4e2d\u5c07\u6211\u7684\u884c\u52d5\u9032\u5ea6\u5f9e\u884c\u52d5\u88dd\u7f6e\u8f49\u79fb\u5230\u500b\u4eba\u96fb\u8166\u4e0a\u55ce\uff1f", "answer": "\u662f\u7684\uff0c\u60a8\u53ef\u4ee5\u5728\u7c43\u7403\u660e\u661f\u8cfd\u4e2d\u5c07\u884c\u52d5\u88dd\u7f6e\u4e0a\u7684\u9032\u5ea6\u8f49\u79fb\u5230\u500b\u4eba\u96fb\u8166\u4e0a\uff0c\u65b9\u6cd5\u662f\u9023\u7d50\u60a8\u7684\u5e33\u6236\u81f3\u901a\u7528\u904a\u6232\u500b\u4eba\u6a94\u6848\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u60a8\u7684 Google Play \u6216 Apple ID \u540c\u6b65\u6578\u64da\uff0c\u78ba\u4fdd\u9806\u66a2\u7684\u8f49\u63db\u3002[\u6d41\u7a0b\u5716\u89e3: \u884c\u52d5\u88dd\u7f6e -> \u5e33\u6236\u9023\u7d50 -> \u500b\u4eba\u96fb\u8166]"}, {"question": "\u5728\u7c43\u7403\u660e\u661f\u8cfd\u4e2d\uff0c\u662f\u5426\u6709\u4efb\u4f55\u96b1\u85cf\u6210\u5c31\u6216\u5f69\u86cb\uff1f", "answer": "\u662f\u7684\uff0c\u7c43\u7403\u660e\u661f\u8cfd\u4e2d\u6709\u96b1\u85cf\u6210\u5c31\u548c\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u8207\"\u4e09\u5206\u7403\u5f7c\u5f97\"\u4e00\u8d77\u9023\u7e8c\u6295\u9032 10 \u500b\u4e09\u5206\u7403\u6703\u89e3\u9396\u4e00\u500b\u7279\u6b8a\u6210\u5c31\u3002[\u5f69\u86cb\u6316\u6398: \u900f\u904e\u4ed4\u7d30\u63a2\u7d22\u904a\u6232\u5730\u5716\u4f86\u767c\u73fe\u96b1\u85cf\u7403\u5834\u3002]"}]
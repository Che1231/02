[{"question": "Little Alchemy 2\u3092\u521d\u5fc3\u8005\u3068\u3057\u3066\u59cb\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Little Alchemy 2\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u307e\u305a\u3001\u7a7a\u6c17\u3001\u571f\u3001\u706b\u3001\u6c34\u306a\u3069\u3001\u30b2\u30fc\u30e0\u958b\u59cb\u6642\u306b\u63d0\u4f9b\u3055\u308c\u308b\u57fa\u672c\u8981\u7d20\u3092\u7406\u89e3\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u3089\u306e\u8981\u7d20\u3092\u7d44\u307f\u5408\u308f\u305b\u3066\u65b0\u3057\u3044\u8981\u7d20\u3092\u4f5c\u6210\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u706b\u3068\u571f\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3068\u6eb6\u5ca9\u304c\u3067\u304d\u307e\u3059\u3002\u3055\u307e\u3056\u307e\u306a\u7d44\u307f\u5408\u308f\u305b\u3092\u8a66\u3057\u3066\u3001\u3088\u308a\u591a\u304f\u306e\u8981\u7d20\u3092\u767a\u898b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u884c\u304d\u8a70\u307e\u3063\u305f\u5834\u5408\u306f\u30d2\u30f3\u30c8\u30b7\u30b9\u30c6\u30e0\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u8003\u3048\u3089\u308c\u308b\u7d44\u307f\u5408\u308f\u305b\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002\u3053\u306e\u57fa\u790e\u7684\u306a\u30b9\u30c6\u30c3\u30d7\u306f\u3001\u5305\u62ec\u7684\u306a\u8981\u7d20\u30e9\u30a4\u30d6\u30e9\u30ea\u3092\u69cb\u7bc9\u3059\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002"}, {"question": "\u3059\u3079\u3066\u306eLittle Alchemy 2\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u77e5\u3063\u3066\u304a\u304f\u3079\u304d\u5fc5\u9808\u306e\u7d44\u307f\u5408\u308f\u305b\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u3059\u3079\u3066\u306eLittle Alchemy 2\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u8981\u7d20\u30e9\u30a4\u30d6\u30e9\u30ea\u3092\u8fc5\u901f\u306b\u62e1\u5927\u3059\u308b\u305f\u3081\u306e\u91cd\u8981\u306a\u7d44\u307f\u5408\u308f\u305b\u3092\u77e5\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u5fc5\u9808\u306e\u7d44\u307f\u5408\u308f\u305b\u306f\u3001\u7a7a\u6c17\uff0b\u706b\uff1d\u30a8\u30cd\u30eb\u30ae\u30fc\u3001\u571f\uff0b\u6c34\uff1d\u6ce5\u3001\u6ce5\uff0b\u706b\uff1d\u308c\u3093\u304c\u3067\u3059\u3002\u3053\u308c\u3089\u306e\u7d44\u307f\u5408\u308f\u305b\u306f\u3001\u57fa\u672c\u7684\u306a\u5316\u5b66\u306e\u539f\u7406\u3092\u7d39\u4ecb\u3059\u308b\u3060\u3051\u3067\u306a\u304f\u3001\u3088\u308a\u8907\u96d1\u306a\u8981\u7d20\u3078\u306e\u9053\u3092\u5207\u308a\u958b\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u5185\u3067\u306e\u3042\u306a\u305f\u306e\u9032\u6357\u3092\u5927\u5e45\u306b\u52a0\u901f\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Little Alchemy 2\u3067\u3088\u308a\u9ad8\u3044\u30ec\u30d9\u30eb\u306b\u9032\u3080\u305f\u3081\u306b\u91cd\u8981\u306a\u8981\u7d20\u306f\u3069\u308c\u3067\u3059\u304b\uff1f", "answer": "Little Alchemy 2\u3067\u306f\u3001\u7279\u5b9a\u306e\u8981\u7d20\u304c\u3088\u308a\u9ad8\u3044\u30ec\u30d9\u30eb\u306b\u9032\u3080\u305f\u3081\u306e\u91cd\u8981\u306a\u8981\u7d20\u3068\u306a\u308a\u307e\u3059\u3002\u751f\u547d\u3001\u6642\u9593\u3001\u4eba\u9593\u3068\u3044\u3063\u305f\u8981\u7d20\u304c\u91cd\u8981\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u751f\u547d\u300d\u3092\u4f5c\u6210\u3059\u308b\u306b\u306f\u6cbc\u5730\uff0b\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u7d44\u307f\u5408\u308f\u305b\u307e\u3059\u3002\u300c\u751f\u547d\u300d\u306f\u3001\u305d\u308c\u306b\u300c\u6642\u9593\u300d\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u300c\u4eba\u9593\u300d\u3092\u4f5c\u6210\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u8981\u7d20\u306f\u3001\u3088\u308a\u8907\u96d1\u3067\u9ad8\u5ea6\u306a\u8981\u7d20\u3092\u4f5c\u6210\u3059\u308b\u305f\u3081\u306e\u5e83\u5927\u306a\u53ef\u80fd\u6027\u3092\u958b\u304d\u307e\u3059\u3002"}, {"question": "Little Alchemy 2\u3067\u8981\u7d20\u767a\u898b\u6226\u7565\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Little Alchemy 2\u3067\u8981\u7d20\u767a\u898b\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u6226\u7565\u7684\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff09\u57fa\u672c\u8981\u7d20\u3092\u7d44\u307f\u5408\u308f\u305b\u3066\u3001\u3067\u304d\u308b\u3060\u3051\u591a\u304f\u306e\u65b0\u8981\u7d20\u3092\u4f5c\u6210\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff09\u300c\u751f\u547d\u300d\u300c\u4eba\u9593\u300d\u306a\u3069\u306e\u3001\u3088\u308a\u591a\u304f\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u958b\u304f\u91cd\u8981\u306a\u8981\u7d20\u306e\u4f5c\u6210\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff09\u30d2\u30f3\u30c8\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u4f9d\u5b58\u6027\u3092\u907f\u3051\u3066\u554f\u984c\u89e3\u6c7a\u80fd\u529b\u3092\u9ad8\u3081\u308b\u305f\u3081\u306b\u3001\u63a7\u3048\u3081\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002\u3053\u306e\u65b9\u6cd5\u306b\u3088\u308a\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u9032\u884c\u3068\u3001\u30b2\u30fc\u30e0\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u3088\u308a\u6df1\u304f\u7406\u89e3\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Little Alchemy 2\u306b\u304a\u3051\u308b\u8981\u7d20\u306e\u968e\u5c64\u69cb\u9020\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "Little Alchemy 2\u306b\u304a\u3051\u308b\u8981\u7d20\u306e\u968e\u5c64\u69cb\u9020\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u306a\u305c\u306a\u3089\u3001\u305d\u308c\u306f\u7d44\u307f\u5408\u308f\u305b\u306e\u6d41\u308c\u3068\u3001\u4f5c\u6210\u53ef\u80fd\u306a\u8981\u7d20\u306e\u8907\u96d1\u3055\u3092\u6c7a\u5b9a\u3059\u308b\u304b\u3089\u3067\u3059\u3002\u305f\u3068\u30
[{"question": "\u5982\u4f55\u958b\u59cb\u73a9\u5c0f\u7149\u91d1\u88532\u4f5c\u70ba\u65b0\u624b\uff1f", "answer": "\u8981\u958b\u59cb\u73a9\u5c0f\u7149\u91d1\u88532\uff0c\u9996\u5148\u8981\u719f\u6089\u904a\u6232\u4e00\u958b\u59cb\u63d0\u4f9b\u7684\u57fa\u672c\u5143\u7d20\uff0c\u4f8b\u5982\u7a7a\u6c23\u3001\u5927\u5730\u3001\u706b\u548c\u6c34\u3002\u5c07\u9019\u4e9b\u5143\u7d20\u7d50\u5408\u8d77\u4f86\u5275\u9020\u65b0\u7684\u5143\u7d20\u3002\u4f8b\u5982\uff0c\u5c07\u706b\u548c\u5927\u5730\u7d50\u5408\u5c31\u6703\u7522\u751f\u7194\u5ca9\u3002\u5617\u8a66\u4e0d\u540c\u7684\u7d44\u5408\u4f86\u767c\u73fe\u66f4\u591a\u5143\u7d20\u3002\u5982\u679c\u60a8\u5361\u4f4f\u4e86\uff0c\u53ef\u4ee5\u4f7f\u7528\u63d0\u793a\u7cfb\u7d71\uff0c\u5b83\u6703\u5efa\u8b70\u53ef\u80fd\u7684\u7d44\u5408\u3002\u9019\u4e00\u6b65\u9a5f\u5c0d\u65bc\u5efa\u7acb\u4e00\u500b\u5168\u9762\u7684\u5143\u7d20\u5716\u66f8\u9928\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u6bcf\u500b\u5c0f\u7149\u91d1\u88532\u73a9\u5bb6\u90fd\u61c9\u8a72\u77e5\u9053\u54ea\u4e9b\u5fc5\u5099\u7684\u7d44\u5408\uff1f", "answer": "\u6bcf\u500b\u5c0f\u7149\u91d1\u88532\u73a9\u5bb6\u90fd\u61c9\u8a72\u77e5\u9053\u4e00\u4e9b\u95dc\u9375\u7d44\u5408\uff0c\u4ee5\u5feb\u901f\u64f4\u5c55\u4ed6\u5011\u7684\u5143\u7d20\u5716\u66f8\u9928\u3002\u5fc5\u5099\u7d44\u5408\u5305\u62ec\uff1a\u7a7a\u6c23 + \u706b = \u80fd\u91cf\uff0c\u5927\u5730 + \u6c34 = \u6ce5\u571f\uff0c\u4ee5\u53ca\u6ce5\u571f + \u706b =\u78da\u584a\u3002\u9019\u4e9b\u7d44\u5408\u4e0d\u50c5\u4ecb\u7d39\u4e86\u57fa\u672c\u7684\u5316\u5b78\u539f\u7406\uff0c\u9084\u70ba\u5275\u9020\u66f4\u5fa9\u96dc\u7684\u5143\u7d20\u958b\u555f\u4e86\u9053\u8def\u3002\u4e86\u89e3\u9019\u4e9b\u7d44\u5408\u53ef\u4ee5\u986f\u8457\u52a0\u5feb\u4f60\u5728\u904a\u6232\u4e2d\u7684\u9032\u5ea6\u3002"}, {"question": "\u5c0f\u7149\u91d1\u88532\u4e2d\u54ea\u4e9b\u5143\u7d20\u5c0d\u65bc\u6649\u7d1a\u66f4\u9ad8\u5c64\u7d1a\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u5728\u5c0f\u7149\u91d1\u88532\u4e2d\uff0c\u67d0\u4e9b\u5143\u7d20\u5145\u7576\u6649\u7d1a\u66f4\u9ad8\u5c64\u7d1a\u7684\u95dc\u9375\u3002\u4f8b\u5982\u300c\u751f\u547d\u300d\u3001\u300c\u6642\u9593\u300d\u548c\u300c\u4eba\u985e\u300d\u7b49\u5143\u7d20\u81f3\u95dc\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5275\u9020\u300c\u751f\u547d\u300d\u9700\u8981\u5c07\u6cbc\u6fa4+\u80fd\u91cf\u7d50\u5408\u8d77\u4f86\u3002\u300c\u751f\u547d\u300d\u63a5\u8457\u53ef\u4ee5\u7528\u4f86\u5275\u9020\u300c\u4eba\u985e\u300d\uff0c\u65b9\u6cd5\u662f\u5c07\u5176\u8207\u300c\u6642\u9593\u300d\u7d50\u5408\u3002\u9019\u4e9b\u5143\u7d20\u70ba\u5275\u9020\u66f4\u8907\u96dc\u548c\u5148\u9032\u7684\u5143\u7d20\u958b\u95e2\u4e86\u5ee3\u95ca\u7684\u53ef\u80fd\u6027\u3002"}, {"question": "\u5982\u4f55\u5728\u5c0f\u7149\u91d1\u88532\u4e2d\u512a\u5316\u6211\u7684\u5143\u7d20\u767c\u73fe\u7b56\u7565\uff1f", "answer": "\u512a\u5316\u4f60\u5728\u5c0f\u7149\u91d1\u88532\u4e2d\u7684\u5143\u7d20\u767c\u73fe\u9700\u8981\u4e00\u500b\u7b56\u7565\u65b9\u6cd5\uff1a\u6b65\u9a5f1\uff09 \u5f9e\u57fa\u672c\u5143\u7d20\u958b\u59cb\u7d44\u5408\uff0c\u76e1\u53ef\u80fd\u5275\u9020\u51fa\u66f4\u591a\u65b0\u5143\u7d20\u3002\u6b65\u9a5f2\uff09 \u96c6\u4e2d\u7cbe\u529b\u5275\u9020\u95dc\u9375\u5143\u7d20\uff0c\u4f8b\u5982\u300c\u751f\u547d\u300d\u548c\u300c\u4eba\u985e\u300d\uff0c\u9019\u4e9b\u5143\u7d20\u6703\u958b\u555f\u66f4\u591a\u7d44\u5408\u3002\u6b65\u9a5f3\uff09 \u8b39\u614e\u4f7f\u7528\u63d0\u793a\u7cfb\u7d71\uff0c\u907f\u514d\u4f9d\u8cf4\uff0c\u4e26\u589e\u5f37\u4f60\u7684\u554f\u984c\u89e3\u6c7a\u80fd\u529b\u3002\u9019\u7a2e\u65b9\u6cd5\u53ef\u4ee5\u78ba\u4fdd\u5e73\u8861\u7684\u9032\u5ea6\uff0c\u4e26\u66f4\u6df1\u5165\u5730\u7406\u89e3\u904a\u6232\u6a5f\u5236\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u4e86\u89e3\u5c0f\u7149\u91d1\u88532\u4e2d\u7684\u5143\u7d20\u5c64\u7d1a\u7d50\u69cb\u5f88\u91cd\u8981\uff1f", "answer": "\u4e86\u89e3\u5c0f\u7149\u91d1\u88532\u4e2d\u7684\u5143\u7d20\u5c64\u7d1a\u7d50\u69cb\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6c7a\u5b9a\u4e86\u7d44\u5408\u7684\u6d41\u7a0b\u4ee5\u53ca\u60a8\u53ef\u4ee5\u5275\u9020\u7684\u5143\u7d20\u7684\u8907\u96dc\u6027\u3002\u4f8b\u5982\uff0c\u6c34\u548c\u706b\u7b49\u57fa\u672c\u5143\u7d20\u6703\u5c0e\u81f4\u66f4\u8907\u96dc\u7684\u5143\u7d20\uff0c\u4f8b\u5982\u84b8\u6c7d\u6216\u80fd\u91cf\u3002\u4e86\u89e3\u6b64\u5c64\u7d1a\u7d50\u69cb\u5c07\u6709\u52a9\u65bc\u60a8\u9810\u6e2c\u53ef\u80fd\u7684\u7d44\u5408\uff0c\u4e26\u6709\u6548\u5730\u898f\u5283\u60a8\u7684\u7b56\u7565\uff0c\u4ee5\u5728\u6c92\u6709\u91cd\u8907\u5617\u8a66\u7684\u60c5\u6cc1\u4e0b\u767c\u73fe\u6240\u6709\u5143\u7d20\u3002"}, {"question": "\u4ec0\u9ebc\u7b56\u7565\u53ef\u4ee5\u61c9\u7528\u65bc\u5728\u5c0f\u7149\u91d1\u88532\u4e2d\u89e3\u9396\u6240\u6709\u5143\u7d20\uff1f", "answer": "\u70ba\u4e86\u5728\u5c0f\u7149\u91d1\u88532\u4e2d\u89e3\u9396\u6240\u6709\u5143\u7d20\uff0c\u8acb\u63a1\u7528\u4ee5\u4e0b\u7cfb\u7d71\u7b56\u7565\uff1a\u6b65\u9a5f1\uff09 \u5275\u5efa\u6240\u6709\u5df2\u77e5\u5143\u7d20\u7684\u6e05\u55ae\u4e26\u8ffd\u8e64\u60a8\u7684\u9032\u5ea6\u3002\u6b65\u9a5f2\uff09 \u512a\u5148\u8003\u616e\u5c0e\u81f4\u5177\u6709\u591a\u7a2e\u7528\u9014\u7684\u5143\u7d20\uff08\u4f8b\u5982\u300c\u751f\u547d\u300d\u6216\u300c\u6642\u9593\u300d\uff09\u7684\u7d44\u5408\u3002\u6b65\u9a5f3\uff09 \u5b9a\u671f\u8907\u7fd2\u548c\u91cd\u65b0\u7d44\u5408\u73fe\u6709\u5143\u7d20\uff0c\u56e0\u70ba\u96a8\u8457\u66f4\u65b0\uff0c\u65b0\u7684\u7d44\u5408\u53ef\u80fd\u6703\u51fa\u73fe\u3002\u9019\u7a2e\u7d50\u69cb\u5316\u7684\u65b9\u6cd5\u53ef\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u6548\u7387\uff0c\u4e26\u78ba\u4fdd\u5168\u9762\u8986\u84cb\u3002"}, {"question": "\u5c0f\u7149\u91d1\u88532\u4e2d\u7684\u7d44\u5408\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u5c0f\u7149\u91d1\u88532\u4e2d\u7684\u7d44\u5408\u7cfb\u7d71\u57fa\u65bc\u908f\u8f2f\u5730\u5c07\u5143\u7d20\u914d\u5c0d\u5f62\u6210\u65b0\u7684\u5143\u7d20\u3002\u6bcf\u500b\u5143\u7d20\u90fd\u6709\u7279\u5b9a\u7684\u7279\u6027\uff0c\u6c7a\u5b9a\u5176\u53ef\u80fd\u7684\u7d44\u5408\u3002\u4f8b\u5982\uff0c\u5c07\u5927\u5730\u548c\u6c34\u7d50\u5408\u6703\u5275\u9020\u6ce5\u571f\uff0c\u7136\u5f8c\u53ef\u4ee5\u5c07\u5176\u8207\u706b\u7d50\u5408\u4ee5\u5275\u9020\u78da\u584a\u3002\u9019\u500b\u7cfb\u7d71\u9f13\u52f5\u5be6\u9a57\u548c\u908f\u8f2f\u601d\u8003\uff0c\u4e26\u734e\u52f5\u6210\u529f\u7d44\u5408\u7684\u73a9\u5bb6\u4ee5\u65b0\u7684\u5143\u7d20\u3002"}, {"question": "\u5c0f\u7149\u91d1\u88532\u4e2d\u5143\u7d20\u5275\u9020\u7684\u5e95\u5c64\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5c0f\u7149\u91d1\u88532\u4e2d\u5143\u7d20\u5275\u9020\u7684\u6a5f\u5236\u6d89\u53ca\u5c0d\u73fe\u6709\u5143\u7d20\u9032\u884c\u908f\u8f2f\u7684\uff0c\u6709\u6642\u662f\u5947\u7570\u7684\u7d44\u5408\u3002\u904a\u6232\u4f7f\u7528\u7c21\u55ae\u800c\u6df1\u523b\u7684\u6f14\u7b97\u6cd5\uff0c\u6bcf\u500b\u5143\u7d20\u90fd\u6709\u9810\u5148\u5b9a\u7fa9\u7684\u7d44\u5408\uff0c\u53ef\u4ee5\u5c0e\u81f4\u65b0\u7684\u5143\u7d20\u3002\u4f8b\u5982\uff0c\u5c07\u300c\u4eba\u985e\u300d\u8207\u300c\u97f3\u6a02\u300d\u7d50\u5408\uff0c\u53ef\u4ee5\u5275\u9020\u300c\u821e\u8005\u300d\u3002\u4e86\u89e3\u9019\u4e9b\u6a5f\u5236\u6709\u52a9\u65bc\u73a9\u5bb6\u9810\u6e2c\u548c\u5236\u5b9a\u7b56\u7565\uff0c\u4f86\u767c\u73fe\u6240\u6709\u5143\u7d20\u7684\u9014\u5f91\u3002"}, {"question": "\u5982\u4f55\u5728\u4e0d\u540c\u7684\u88dd\u7f6e\u4e4b\u9593\u8f49\u79fb\u6211\u7684\u5c0f\u7149\u91d1\u88532\u9032\u5ea6\uff1f", "answer": "\u5728\u4e0d\u540c\u88dd\u7f6e\u4e4b\u9593\u8f49\u79fb\u60a8\u7684\u5c0f\u7149\u91d1\u88532\u9032\u5ea6\uff0c\u53ef\u4ee5\u4f7f\u7528\u5e73\u53f0\u63d0\u4f9b\u7684\u96f2\u7aef\u5132\u5b58\u529f\u80fd\uff0c\u4f8b\u5982Google Play Games \u6216 Apple Game Center\u3002\u8acb\u78ba\u4fdd\u60a8\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u90fd\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\uff0c\u4e26\u4f7f\u7528\u904a\u6232\u4e2d\u7684\u300c\u5132\u5b58\u300d\u548c\u300c\u8f09\u5165\u300d\u9078\u9805\u4f86\u8f49\u79fb\u60a8\u7684\u9032\u5ea6\u3002\u6b64\u65b9\u6cd5\u53ef\u78ba\u4fdd\u60a8\u7684\u5143\u7d20\u767c\u73fe\u548c\u904a\u6232\u9032\u5ea6\u5728\u4e0d\u540c\u88dd\u7f6e\u4e4b\u9593\u540c\u6b65\u3002"}, {"question": "\u5c0f\u7149\u91d1\u88532\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u6216\u4e0d\u592a\u986f\u800c\u6613\u898b\u7684\u7d44\u5408\uff1f", "answer": "\u5c0f\u7149\u91d1\u88532\u5305\u542b\u4e00\u4e9b\u96b1\u85cf\u6216\u4e0d\u592a\u986f\u800c\u6613\u898b\u7684\u7d44\u5408\uff0c\u9019\u4e9b\u7d44\u5408\u6703\u4ee4\u4eba\u611f\u5230\u559c\u6085\u3002\u4f8b\u5982\uff0c\u5c07\u300c\u5f69\u8679\u300d\u8207\u300c\u4eba\u985e\u300d\u7d50\u5408\u6703\u5275\u9020\u300c\u85dd\u8853\u5bb6\u300d\uff0c\u5c07\u300c\u5149\u300d\u8207\u300c\u4eba\u985e\u300d\u7d50\u5408\u6703\u5275\u9020\u300c\u60f3\u6cd5\u300d\u3002\u9019\u4e9b\u7d44\u5408\u4e0d\u50c5\u6709\u8da3\uff0c\u9084\u9f13\u52f5\u73a9\u5bb6\u8df3\u51fa\u6846\u6846\u601d\u8003\uff0c\u63a2\u7d22\u904a\u6232\u4e2d\u5ee3\u95ca\u7684\u53ef\u80fd\u6027\u3002\u767c\u73fe\u9019\u4e9b\u7d44\u5408\u53ef\u4ee5\u5e36\u4f86\u6210\u5c31\u611f\uff0c\u4e26\u52a0\u6df1\u904a\u6232\u9ad4\u9a57\u3002"}]
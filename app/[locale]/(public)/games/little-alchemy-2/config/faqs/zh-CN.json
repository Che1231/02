[{"question": "\u5982\u4f55\u4f5c\u4e3a\u65b0\u624b\u5f00\u59cb\u73a9\u5c0f\u70bc\u91d1 2\uff1f", "answer": "\u8981\u5f00\u59cb\u73a9\u5c0f\u70bc\u91d1 2\uff0c\u9996\u5148\u8981\u719f\u6089\u6e38\u620f\u4e00\u5f00\u59cb\u63d0\u4f9b\u7684\u57fa\u672c\u5143\u7d20\uff0c\u4f8b\u5982\u7a7a\u6c14\u3001\u5927\u5730\u3001\u706b\u7130\u548c\u6c34\u3002\u5c06\u8fd9\u4e9b\u5143\u7d20\u7ec4\u5408\u8d77\u6765\u521b\u9020\u65b0\u7684\u5143\u7d20\u3002\u4f8b\u5982\uff0c\u5c06\u706b\u7130\u548c\u5927\u5730\u7ed3\u5408\u53ef\u4ee5\u521b\u9020\u7194\u5ca9\u3002\u5c1d\u8bd5\u4e0d\u540c\u7684\u7ec4\u5408\uff0c\u4ee5\u53d1\u73b0\u66f4\u591a\u5143\u7d20\u3002\u5982\u679c\u60a8\u5361\u4f4f\u4e86\uff0c\u53ef\u4ee5\u4f7f\u7528\u63d0\u793a\u7cfb\u7edf\uff0c\u5b83\u4f1a\u5efa\u8bae\u53ef\u80fd\u7684\u7ec4\u5408\u3002\u8fd9\u4e00\u5960\u57fa\u6b65\u9aa4\u5bf9\u4e8e\u6784\u5efa\u4e00\u4e2a\u5168\u9762\u7684\u5143\u7d20\u5e93\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u6bcf\u4e2a\u5c0f\u70bc\u91d1 2 \u7684\u73a9\u5bb6\u90fd\u5e94\u8be5\u77e5\u9053\u54ea\u4e9b\u5fc5\u5907\u7684\u7ec4\u5408\uff1f", "answer": "\u6bcf\u4e2a\u5c0f\u70bc\u91d1 2 \u7684\u73a9\u5bb6\u90fd\u5e94\u8be5\u77e5\u9053\u5173\u952e\u7684\u7ec4\u5408\uff0c\u4ee5\u4fbf\u5feb\u901f\u6269\u5c55\u4ed6\u4eec\u7684\u5143\u7d20\u5e93\u3002\u5fc5\u5907\u7684\u7ec4\u5408\u5305\u62ec\uff1a\u7a7a\u6c14 + \u706b\u7130 = \u80fd\u91cf\u3001\u5927\u5730 + \u6c34 = \u6ce5\u571f\uff0c\u4ee5\u53ca\u6ce5\u571f + \u706b\u7130 = \u7816\u5757\u3002\u8fd9\u4e9b\u7ec4\u5408\u4e0d\u4ec5\u4ecb\u7ecd\u4e86\u57fa\u672c\u7684\u5316\u5b66\u539f\u7406\uff0c\u800c\u4e14\u4e5f\u5f00\u542f\u4e86\u901a\u5f80\u66f4\u590d\u6742\u5143\u7d20\u7684\u9014\u5f84\u3002\u4e86\u89e3\u8fd9\u4e9b\u7ec4\u5408\u53ef\u4ee5\u663e\u8457\u52a0\u5feb\u60a8\u5728\u6e38\u620f\u4e2d\u7684\u8fdb\u5ea6\u3002"}, {"question": "\u5c0f\u70bc\u91d1 2 \u4e2d\u54ea\u4e9b\u5143\u7d20\u5bf9\u4e8e\u664b\u7ea7\u66f4\u9ad8\u7b49\u7ea7\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u5728\u5c0f\u70bc\u91d1 2 \u4e2d\uff0c\u67d0\u4e9b\u5143\u7d20\u662f\u664b\u7ea7\u66f4\u9ad8\u7b49\u7ea7\u7684\u5173\u952e\u3002\u4f8b\u5982\uff0c\"\u751f\u547d\"\u3001\"\u65f6\u95f4\" \u548c \"\u4eba\u7c7b\" \u7b49\u5143\u7d20\u81f3\u5173\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u521b\u5efa\"\u751f\u547d\" \u9700\u8981\u5c06\u6cbc\u6cfd+\u80fd\u91cf\u7ec4\u5408\u5728\u4e00\u8d77\u3002\u7136\u540e\uff0c\u901a\u8fc7\u5c06\u5176\u4e0e\"\u65f6\u95f4\" \u7ec4\u5408\uff0c\u53ef\u4ee5\u521b\u5efa\"\u4eba\u7c7b\"\u3002\u8fd9\u4e9b\u5143\u7d20\u5f00\u542f\u4e86\u521b\u9020\u66f4\u590d\u6742\u548c\u5148\u8fdb\u5143\u7d20\u7684\u5de8\u5927\u53ef\u80fd\u6027\u3002"}, {"question": "\u5982\u4f55\u5728\u5c0f\u70bc\u91d1 2 \u4e2d\u4f18\u5316\u6211\u7684\u5143\u7d20\u53d1\u73b0\u7b56\u7565\uff1f", "answer": "\u5728\u5c0f\u70bc\u91d1 2 \u4e2d\u4f18\u5316\u60a8\u7684\u5143\u7d20\u53d1\u73b0\uff0c\u9700\u8981\u4e00\u4e2a\u6218\u7565\u6027\u7684\u65b9\u6cd5\uff1a\u6b65\u9aa41\uff09\u9996\u5148\u5c06\u57fa\u672c\u5143\u7d20\u7ec4\u5408\u8d77\u6765\uff0c\u5c3d\u53ef\u80fd\u521b\u9020\u51fa\u65b0\u7684\u5143\u7d20\u3002\u6b65\u9aa42\uff09\u4e13\u6ce8\u4e8e\u521b\u5efa\u8bf8\u5982\u201c\u751f\u547d\u201d\u548c\u201c\u4eba\u7c7b\u201d\u7b49\u5173\u952e\u5143\u7d20\uff0c\u8fd9\u4e9b\u5143\u7d20\u4f1a\u5f00\u542f\u66f4\u591a\u7684\u7ec4\u5408\u3002\u6b65\u9aa43\uff09\u5c3d\u91cf\u5c11\u7528\u63d0\u793a\u7cfb\u7edf\uff0c\u907f\u514d\u4f9d\u8d56\uff0c\u5e76\u589e\u5f3a\u60a8\u7684\u95ee\u9898\u89e3\u51b3\u80fd\u529b\u3002\u8fd9\u79cd\u65b9\u6cd5\u786e\u4fdd\u4e86\u5747\u8861\u7684\u8fdb\u6b65\u548c\u5bf9\u6e38\u620f\u673a\u5236\u7684\u66f4\u6df1\u5165\u7406\u89e3\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u7406\u89e3\u5c0f\u70bc\u91d1 2 \u4e2d\u7684\u5143\u7d20\u5c42\u6b21\u7ed3\u6784\u5f88\u91cd\u8981\uff1f", "answer": "\u7406\u89e3\u5c0f\u70bc\u91d1 2 \u4e2d\u7684\u5143\u7d20\u5c42\u6b21\u7ed3\u6784\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u51b3\u5b9a\u4e86\u7ec4\u5408\u7684\u6d41\u7a0b\u548c\u60a8\u53ef\u4ee5\u521b\u9020\u7684\u5143\u7d20\u7684\u590d\u6742\u6027\u3002\u4f8b\u5982\uff0c\u50cf\u6c34\u548c\u706b\u8fd9\u6837\u7684\u57fa\u672c\u5143\u7d20\u4f1a\u5bfc\u81f4\u66f4\u590d\u6742\u7684\u5143\u7d20\uff0c\u4f8b\u5982\u84b8\u6c7d\u6216\u80fd\u91cf\u3002\u4e86\u89e3\u8fd9\u79cd\u5c42\u6b21\u7ed3\u6784\u6709\u52a9\u4e8e\u60a8\u9884\u6d4b\u53ef\u80fd\u7684\u7ec4\u5408\uff0c\u5e76\u6709\u6548\u5730\u89c4\u5212\u60a8\u7684\u7b56\u7565\uff0c\u4ee5\u53d1\u73b0\u6240\u6709\u5143\u7d20\uff0c\u800c\u65e0\u9700\u91cd\u590d\u5c1d\u8bd5\u3002"}, {"question": "\u4e3a\u4e86\u89e3\u9501\u5c0f\u70bc\u91d1 2 \u4e2d\u7684\u6240\u6709\u5143\u7d20\uff0c\u53ef\u4ee5\u91c7\u7528\u54ea\u4e9b\u7b56\u7565\uff1f", "answer": "\u4e3a\u4e86\u89e3\u9501\u5c0f\u70bc\u91d1 2 \u4e2d\u7684\u6240\u6709\u5143\u7d20\uff0c\u8bf7\u91c7\u7528\u4e00\u4e2a\u7cfb\u7edf\u5316\u7684\u7b56\u7565\uff1a\u6b65\u9aa4 1\uff09 \u521b\u5efa\u6240\u6709\u5df2\u77e5\u5143\u7d20\u7684\u6e05\u5355\uff0c\u5e76\u8ddf\u8e2a\u60a8\u7684\u8fdb\u5ea6\u3002\u6b65\u9aa4 2\uff09 \u4f18\u5148\u8003\u8651\u90a3\u4e9b\u5bfc\u81f4\u5177\u6709\u591a\u79cd\u7528\u9014\u7684\u5143\u7d20\uff08\u4f8b\u5982\u201c\u751f\u547d\u201d\u6216\u201c\u65f6\u95f4\u201d\uff09\u7684\u7ec4\u5408\u3002\u6b65\u9aa4 3\uff09 \u5b9a\u671f\u91cd\u65b0\u5ba1\u89c6\u548c\u91cd\u65b0\u7ec4\u5408\u73b0\u6709\u5143\u7d20\uff0c\u56e0\u4e3a\u968f\u7740\u66f4\u65b0\uff0c\u65b0\u7684\u7ec4\u5408\u53ef\u80fd\u4f1a\u51fa\u73b0\u3002\u8fd9\u79cd\u7ed3\u6784\u5316\u7684\u65b9\u6cd5\u53ef\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u6548\u7387\uff0c\u5e76\u786e\u4fdd\u5168\u9762\u8986\u76d6\u3002"}, {"question": "\u5c0f\u70bc\u91d1 2 \u4e2d\u7684\u7ec4\u5408\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u5c0f\u70bc\u91d1 2 \u4e2d\u7684\u7ec4\u5408\u7cfb\u7edf\u662f\u57fa\u4e8e\u903b\u8f91\u5730\u914d\u5bf9\u5143\u7d20\uff0c\u4ee5\u5f62\u6210\u65b0\u7684\u5143\u7d20\u3002\u6bcf\u4e2a\u5143\u7d20\u90fd\u6709\u5176\u7279\u5b9a\u7684\u5c5e\u6027\uff0c\u51b3\u5b9a\u4e86\u5176\u53ef\u80fd\u7684\u7ec4\u5408\u3002\u4f8b\u5982\uff0c\u5c06\u5927\u5730\u548c\u6c34\u7ec4\u5408\u5728\u4e00\u8d77\u4f1a\u4ea7\u751f\u6ce5\u571f\uff0c\u7136\u540e\u5c06\u6ce5\u571f\u4e0e\u706b\u7130\u7ec4\u5408\u5728\u4e00\u8d77\u53ef\u4ee5\u521b\u9020\u7816\u5757\u3002\u8be5\u7cfb\u7edf\u9f13\u52b1\u5b9e\u9a8c\u548c\u903b\u8f91\u601d\u7ef4\uff0c\u5956\u52b1\u73a9\u5bb6\u901a\u8fc7\u6210\u529f\u7684\u7ec4\u5408\u83b7\u5f97\u65b0\u7684\u5143\u7d20\u3002"}, {"question": "\u5c0f\u70bc\u91d1 2 \u4e2d\u5143\u7d20\u521b\u9020\u7684\u6f5c\u5728\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "\u5c0f\u70bc\u91d1 2 \u4e2d\u5143\u7d20\u521b\u9020\u7684\u673a\u5236\u5305\u62ec\u5bf9\u73b0\u6709\u5143\u7d20\u8fdb\u884c\u903b\u8f91\u7684\uff0c\u6709\u65f6\u662f\u5947\u601d\u5999\u60f3\u7684\u7ec4\u5408\u3002\u8be5\u6e38\u620f\u4f7f\u7528\u4e00\u79cd\u7b80\u5355\u800c\u6df1\u523b\u7684\u7b97\u6cd5\uff0c\u5176\u4e2d\u6bcf\u4e2a\u5143\u7d20\u90fd\u6709\u9884\u5b9a\u4e49\u7684\u7ec4\u5408\uff0c\u53ef\u4ee5\u4ea7\u751f\u65b0\u7684\u5143\u7d20\u3002\u4f8b\u5982\uff0c\u201c\u4eba\u7c7b\u201d\u4e0e\u201c\u97f3\u4e50\u201d\u7ec4\u5408\u53ef\u4ee5\u4ea7\u751f\u201c\u821e\u8005\u201d\u3002\u4e86\u89e3\u8fd9\u4e9b\u673a\u5236\u6709\u52a9\u4e8e\u73a9\u5bb6\u9884\u6d4b\u548c\u5236\u5b9a\u7b56\u7565\uff0c\u4ee5\u53d1\u73b0\u6240\u6709\u5143\u7d20\u3002"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684\u5c0f\u70bc\u91d1 2 \u8fdb\u5ea6\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u8f6c\u79fb\uff1f", "answer": "\u53ef\u4ee5\u901a\u8fc7\u60a8\u6b63\u5728\u4f7f\u7528\u7684\u5e73\u53f0\uff08\u4f8b\u5982 Google Play \u6e38\u620f\u6216 Apple \u6e38\u620f\u4e2d\u5fc3\uff09\u63d0\u4f9b\u7684\u4e91\u4fdd\u5b58\u529f\u80fd\uff0c\u5c06\u60a8\u7684 Little Alchemy 2 \u8fdb\u5ea6\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u8f6c\u79fb\u3002\u8bf7\u786e\u4fdd\u60a8\u5728\u4e24\u53f0\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u540c\u4e00\u4e2a\u5e10\u6237\uff0c\u5e76\u4f7f\u7528\u6e38\u620f\u4e2d\u7684\u201c\u4fdd\u5b58\u201d\u548c\u201c\u52a0\u8f7d\u201d\u9009\u9879\u4ee5\u8f6c\u79fb\u60a8\u7684\u8fdb\u5ea6\u3002\u6b64\u65b9\u6cd5\u53ef\u786e\u4fdd\u5728\u4e0d\u540c\u8bbe\u5907\u4e0a\u540c\u6b65\u60a8\u7684\u5143\u7d20\u53d1\u73b0\u548c\u6e38\u620f\u8fdb\u5ea6\u3002"}, {"question": "\u5c0f\u70bc\u91d1 2 \u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u6216\u4e0d\u592a\u660e\u663e\u7684\u7ec4\u5408\uff1f", "answer": "\u5c0f\u70bc\u91d1 2 \u4e2d\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u6216\u4e0d\u592a\u660e\u663e\u7684\u7ec4\u5408\uff0c\u53ef\u4ee5\u4ee4\u4eba\u60ca\u559c\u5730\u53d1\u73b0\u3002\u4f8b\u5982\uff0c\u5c06\u201c\u5f69\u8679\u201d\u4e0e\u201c\u4eba\u7c7b\u201d\u7ec4\u5408\u53ef\u4ee5\u521b\u9020\u201c\u827a\u672f\u5bb6\u201d\uff0c\u5c06\u201c\u5149\u201d\u4e0e\u201c\u4eba\u7c7b\u201d\u7ec4\u5408\u53ef\u4ee5\u521b\u9020\u201c\u60f3\u6cd5\u201d\u3002\u8fd9\u4e9b\u7ec4\u5408\u4e0d\u4ec5\u6709\u8da3\uff0c\u800c\u4e14\u4e5f\u9f13\u52b1\u73a9\u5bb6\u5f00\u62d3\u601d\u8def\uff0c\u63a2\u7d22\u6e38\u620f\u4e2d\u5de8\u5927\u7684\u53ef\u80fd\u6027\u3002\u53d1\u73b0\u8fd9\u4e9b\u7ec4\u5408\u53ef\u4ee5\u5e26\u6765\u6210\u5c31\u611f\uff0c\u5e76\u52a0\u6df1\u5bf9\u6e38\u620f\u7684\u53c2\u4e0e\u3002"}]
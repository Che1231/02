[{"question": "\ucd08\uc2ec\uc790\ub85c\uc11c Little Alchemy 2\ub97c \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud569\ub2c8\uae4c?", "answer": "Little Alchemy 2\ub97c \uc2dc\uc791\ud558\ub824\uba74 \ucc98\uc74c \uc81c\uacf5\ub418\ub294 \uae30\ubcf8 \uc694\uc18c(\uacf5\uae30, \ud759, \ubd88, \ubb3c)\uc744 \uba3c\uc800 \uc775\uc219\ud574\uc9c0\uc138\uc694. \uc774 \uc694\uc18c\ub4e4\uc744 \uacb0\ud569\ud558\uc5ec \uc0c8\ub85c\uc6b4 \uc694\uc18c\ub97c \ub9cc\ub4e4\uc5b4\ubcf4\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ubd88\uacfc \ud759\uc744 \uacb0\ud569\ud558\uba74 \uc6a9\uc554\uc774 \uc0dd\uc131\ub429\ub2c8\ub2e4. \ub2e4\uc591\ud55c \uc870\ud569\uc744 \uc2dc\ub3c4\ud558\uc5ec \ub354 \ub9ce\uc740 \uc694\uc18c\ub97c \ubc1c\uacac\ud574\ubcf4\uc138\uc694. \ub9c9\ud788\uba74 \ud78c\ud2b8 \uc2dc\uc2a4\ud15c\uc744 \ud65c\uc6a9\ud558\uc5ec \uac00\ub2a5\ud55c \uc870\ud569\uc744 \uc81c\uc548\ubc1b\uc73c\uc138\uc694. \uc774 \uae30\ucd08 \ub2e8\uacc4\ub294 \ud3ec\uad04\uc801\uc778 \uc694\uc18c \ub77c\uc774\ube0c\ub7ec\ub9ac\ub97c \uad6c\ucd95\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4."}, {"question": "\ubaa8\ub4e0 Little Alchemy 2 \ud50c\ub808\uc774\uc5b4\uac00 \uc54c\uc544\uc57c \ud558\ub294 \ud544\uc218 \uc870\ud569\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubaa8\ub4e0 Little Alchemy 2 \ud50c\ub808\uc774\uc5b4\ub294 \uc694\uc18c \ub77c\uc774\ube0c\ub7ec\ub9ac\ub97c \ube60\ub974\uac8c \ud655\uc7a5\ud558\uae30 \uc704\ud55c \ud575\uc2ec \uc870\ud569\uc744 \uc54c\uc544\uc57c \ud569\ub2c8\ub2e4. \ud544\uc218 \uc870\ud569\uc73c\ub85c\ub294 \uacf5\uae30 + \ubd88 = \uc5d0\ub108\uc9c0, \ud759 + \ubb3c = \uc9c4\ud759, \uc9c4\ud759 + \ubd88 = \ubcbd\ub3cc\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc870\ud569\uc740 \uae30\ubcf8\uc801\uc778 \ud654\ud559 \uc6d0\ub9ac\ub97c \uc18c\uac1c\ud560 \ubfd0\ub9cc \uc544\ub2c8\ub77c \ub354 \ubcf5\uc7a1\ud55c \uc694\uc18c\ub85c \uc774\uc5b4\uc9c0\ub294 \uacbd\ub85c\ub97c \uc5f4\uc5b4\uc90d\ub2c8\ub2e4. \uc774\ub97c \uc774\ud574\ud558\uba74 \uac8c\uc784 \uc9c4\ud589 \uc18d\ub3c4\ub97c \ud06c\uac8c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Little Alchemy 2\uc5d0\uc11c \ub354 \ub192\uc740 \ub808\ubca8\ub85c \uc9c4\ud589\ud558\ub294 \ub370 \uc911\uc694\ud55c \uc694\uc18c\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Little Alchemy 2\uc5d0\uc11c \ud2b9\uc815 \uc694\uc18c\ub294 \ub354 \ub192\uc740 \ub808\ubca8\ub85c \uc9c4\ud589\ud558\ub294 \ub370 \uc911\uc694\ud55c \uc5ed\ud560\uc744 \ud569\ub2c8\ub2e4. '\uc0dd\uba85', '\uc2dc\uac04', '\uc778\uac04'\uacfc \uac19\uc740 \uc694\uc18c\uac00 \uc911\uc2ec\uc801\uc778 \uc5ed\ud560\uc744 \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc0dd\uba85'\uc744 \ub9cc\ub4e4\ub824\uba74 \uc2b5\uc9c0 + \uc5d0\ub108\uc9c0\ub97c \uacb0\ud569\ud574\uc57c \ud569\ub2c8\ub2e4. '\uc0dd\uba85'\uc740 '\uc2dc\uac04'\uacfc \uacb0\ud569\ud558\uc5ec '\uc778\uac04'\uc744 \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc694\uc18c\ub294 \ub354 \ubcf5\uc7a1\ud558\uace0 \uace0\uae09 \uc694\uc18c\ub97c \ub9cc\ub4dc\ub294 \uad11\ubc94\uc704\ud55c \uac00\ub2a5\uc131\uc744 \uc5f4\uc5b4\uc90d\ub2c8\ub2e4."}, {"question": "Little Alchemy 2\uc5d0\uc11c \uc694\uc18c \ubc1c\uacac \uc804\ub7b5\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "Little Alchemy 2\uc5d0\uc11c \uc694\uc18c \ubc1c\uacac\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc804\ub7b5\uc801\uc778 \uc811\uadfc \ubc29\uc2dd\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4) \uae30\ubcf8 \uc694\uc18c\ub97c \uacb0\ud569\ud558\uc5ec \uac00\ub2a5\ud55c \ud55c \ub9ce\uc740 \uc0c8\ub85c\uc6b4 \uc694\uc18c\ub97c \ub9cc\ub4ed\ub2c8\ub2e4. 2\ub2e8\uacc4) '\uc0dd\uba85'\uacfc '\uc778\uac04'\uacfc \uac19\uc740 \ub354 \ub9ce\uc740 \uc870\ud569\uc744 \uc5f4\uc5b4\uc8fc\ub294 \ud575\uc2ec \uc694\uc18c\ub97c \ub9cc\ub4dc\ub294 \ub370 \uc9d1\uc911\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4) \uc758\uc874\ub3c4\ub97c \uc904\uc774\uace0 \ubb38\uc81c \ud574\uacb0 \ub2a5\ub825\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uae30 \uc704\ud574 \ud78c\ud2b8 \uc2dc\uc2a4\ud15c\uc744 \ud544\uc694\ud560 \ub54c\ub9cc \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc774 \ubc29\ubc95\uc744 \uc0ac\uc6a9\ud558\uba74 \uade0\ud615 \uc7a1\ud78c \uc9c4\ud589\uacfc \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc5d0 \ub300\ud55c \uc2ec\uce35\uc801\uc778 \uc774\ud574\ub97c \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "Little Alchemy 2\uc5d0\uc11c \uc694\uc18c \uacc4\uce35 \uad6c\uc870\ub97c \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Little Alchemy 2\uc5d0\uc11c \uc694\uc18c \uacc4\uce35 \uad6c\uc870\ub97c \uc774\ud574\ud558\ub294 \uac83\uc740 \uc870\ud569\uc758 \ud750\ub984\uacfc \ub9cc\ub4e4 \uc218 \uc788\ub294 \uc694\uc18c\uc758 \ubcf5\uc7a1\uc131\uc744 \uacb0\uc815\ud558\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubb3c\uacfc \ubd88\uacfc \uac19\uc740 \uae30\ubcf8 \uc694\uc18c\ub294 \uc99d\uae30\ub098 \uc5d0\ub108\uc9c0\uc640 \uac19\uc740 \ub354 \ubcf5\uc7a1\ud55c \uc694\uc18c\ub85c \uc774\uc5b4\uc9d1\ub2c8\ub2e4. \uc774 \uacc4\uce35 \uad6c\uc870\ub97c \uc54c\uba74 \uac00\ub2a5\ud55c \uc870\ud569\uc744 \uc608\uce21\ud558\uace0 \ubaa8\ub4e0 \uc694\uc18c\ub97c \uc911\ubcf5 \uc2dc\ub3c4 \uc5c6\uc774 \ubc1c\uacac\ud558\uae30 \uc704\ud55c \uc804\ub7b5\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uacc4\ud68d\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "Little Alchemy 2\uc5d0\uc11c \ubaa8\ub4e0 \uc694\uc18c\ub97c \ud574\uc81c\ud558\uae30 \uc704\ud574 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Little Alchemy 2\uc5d0\uc11c \ubaa8\ub4e0 \uc694\uc18c\ub97c \ud574\uc81c\ud558\ub824\uba74 \uccb4\uacc4\uc801\uc778 \uc804\ub7b5\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. 1\ub2e8\uacc4) \ubaa8\ub4e0 \uc54c\ub824\uc9c4 \uc694\uc18c\uc758 \ubaa9\ub85d\uc744 \uc791\uc131\ud558\uace0 \uc9c4\ud589 \uc0c1\ud669\uc744 \ucd94\uc801\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4) '\uc0dd\uba85'\uc774\ub098 '\uc2dc\uac04'\uacfc \uac19\uc774 \uc5ec\ub7ec \uc6a9\ub3c4\ub85c \uc0ac\uc6a9\ub420 \uc218 \uc788\ub294 \uc694\uc18c\ub85c \uc774\uc5b4\uc9c0\ub294 \uc870\ud569\uc5d0 \uc6b0\uc120\uc21c\uc704\ub97c \ub461\ub2c8\ub2e4. 3\ub2e8\uacc4) \uc0c8\ub85c\uc6b4 \uc870\ud569\uc774 \uc5c5\ub370\uc774\ud2b8\uc640 \ud568\uaed8 \uc0ac\uc6a9 \uac00\ub2a5\ud558\uac8c \ub420 \uc218 \uc788\uc73c\ubbc0\ub85c \uae30\uc874 \uc694\uc18c\ub97c \uc815\uae30\uc801\uc73c\ub85c \ub2e4\uc2dc \uac80\ud1a0\ud558\uace0 \uc7ac\uacb0\ud569\ud569\ub2c8\ub2e4. \uc774 \uad6c\uc870\ud654\ub41c \uc811\uadfc \ubc29\uc2dd\uc740 \ud6a8\uc728\uc131\uc744 \uadf9\ub300\ud654\ud558\uace0 \ud3ec\uad04\uc801\uc778 \ubc94\uc704\ub97c \ud655\ubcf4\ud569\ub2c8\ub2e4."}, {"question": "Little Alchemy 2\uc5d0\uc11c \uc870\ud569 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "Little Alchemy 2\uc758 \uc870\ud569 \uc2dc\uc2a4\ud15c\uc740 \uc0c8\ub85c\uc6b4 \uc694\uc18c\ub97c \ud615\uc131\ud558\uae30 \uc704\ud574 \uc694\uc18c\ub4e4\uc744 \ub17c\ub9ac\uc801\uc73c\ub85c \ud398\uc5b4\ub9c1\ud558\ub294 \ubc29\uc2dd\uc73c\ub85c \uc791\ub3d9\ud569\ub2c8\ub2e4. \uac01 \uc694\uc18c\ub294 \uac00\ub2a5\ud55c \uc870\ud569\uc744 \uacb0\uc815\ud558\ub294 \uace0\uc720\ud55c \ud2b9\uc131\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud759\uacfc \ubb3c\uc744 \uacb0\ud569\ud558\uba74 \uc9c4\ud759\uc774 \uc0dd\uc131\ub418\uace0, \uc774\ub97c \ubd88\uacfc \uacb0\ud569\ud558\uba74 \ubcbd\ub3cc\uc774 \uc0dd\uc131\ub429\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \uc2e4\ud5d8\uacfc \ub17c\ub9ac\uc801\uc778 \uc0ac\uace0\ub97c \uc7a5\ub824\ud558\uace0, \uc131\uacf5\uc801\uc778 \uc870\ud569\uc744 \ud1b5\ud574 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc0c8\ub85c\uc6b4 \uc694\uc18c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4."}, {"question": "Little Alchemy 2\uc5d0\uc11c \uc694\uc18c \uc0dd\uc131\uc758 \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Little Alchemy 2\uc5d0\uc11c \uc694\uc18c \uc0dd\uc131\uc758 \uba54\ucee4\ub2c8\uc998\uc740 \uae30\uc874 \uc694\uc18c\uc758 \ub17c\ub9ac\uc801\uc774\uace0 \ub54c\ub85c\ub294 \uae30\ubc1c\ud55c \uc870\ud569\uc73c\ub85c \uc774\ub8e8\uc5b4\uc9d1\ub2c8\ub2e4. \uc774 \uac8c\uc784\uc740 \uac01 \uc694\uc18c\uac00 \uc0c8\ub85c\uc6b4 \uc694\uc18c\ub85c \uc774\uc5b4\uc9c8 \uc218 \uc788\ub294 \uc0ac\uc804 \uc815\uc758\ub41c \uc870\ud569\uc744 \uac16\ub294 \ub2e8\uc21c\ud558\uc9c0\ub9cc \uc2ec\uc624\ud55c \uc54c\uace0\ub9ac\uc998\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc778\uac04'\uacfc '\uc74c\uc545'\uc744 \uacb0\ud569\ud558\uba74 '\ub304\uc11c'\uac00 \uc0dd\uc131\ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\uba74 \ud50c\ub808\uc774\uc5b4\uac00 \ubaa8\ub4e0 \uc694\uc18c\ub97c \ubc1c\uacac\ud558\uae30 \uc704\ud55c \uacbd\ub85c\ub97c \uc608\uce21\ud558\uace0 \uc804\ub7b5\uc744 \uc138\uc6b8 \uc218 \uc788\ub3c4\ub85d \ub3c4\uc640\uc90d\ub2c8\ub2e4."}, {"question": "\ub2e4\ub978 \uae30\uae30\uc5d0\uc11c Little Alchemy 2\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Google Play Games \ub610\ub294 Apple Game Center\uc640 \uac19\uc740 \uc0ac\uc6a9 \uc911\uc778 \ud50c\ub7ab\ud3fc\uc774 \uc81c\uacf5\ud558\ub294 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \ud1b5\ud574 \ub2e4\ub978 \uae30\uae30\uc5d0\uc11c Little Alchemy 2\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub450 \uae30\uae30\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uace0 \uac8c\uc784 \ub0b4 '\uc800\uc7a5' \ubc0f '\ubd88\ub7ec\uc624\uae30' \uc635\uc158\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\uc2ed\uc2dc\uc624. \uc774 \ubc29\ubc95\uc744 \ud1b5\ud574 \uc694\uc18c \ubc1c\uacac \ubc0f \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc5ec\ub7ec \uae30\uae30\uc5d0\uc11c \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4."}, {"question": "Little Alchemy 2\uc5d0\ub294 \uc228\uaca8\uc9c4 \ub610\ub294 \ub35c \uba85\ud655\ud55c \uc870\ud569\uc774 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Little Alchemy 2\uc5d0\ub294 \ubc1c\uacac\ud558\uae30 \uc990\uac70\uc6b4 \uc228\uaca8\uc9c4 \ub610\ub294 \ub35c \uba85\ud655\ud55c \uc870\ud569\uc774 \uc5ec\ub7ec \uac00\uc9c0 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ubb34\uc9c0\uac1c'\uc640 '\uc778\uac04'\uc744 \uacb0\ud569\ud558\uba74 '\uc608\uc220\uac00'\uac00 \uc0dd\uc131\ub418\uace0, '\ube5b'\uacfc '\uc778\uac04'\uc744 \uacb0\ud569\ud558\uba74 '\uc544\uc774\ub514\uc5b4'\uac00 \uc0dd\uc131\ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc870\ud569\uc740 \uc7ac\ubbf8\uc788\uc744 \ubfd0\ub9cc \uc544\ub2c8\ub77c \ud50c\ub808\uc774\uc5b4\uac00 \ud2c0\uc744 \ubc97\uc5b4\ub098 \uac8c\uc784 \ub0b4 \uad11\ubc94\uc704\ud55c \uac00\ub2a5\uc131\uc744 \ud0d0\uc0c9\ud558\ub3c4\ub85d \uc7a5\ub824\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc870\ud569\uc744 \ubc1c\uacac\ud558\uba74 \uc131\ucde8\uac10\uc744 \ub290\ub07c\uace0 \uac8c\uc784 \ucc38\uc5ec\ub97c \ub354\uc6b1 \uae4a\uc5b4\uc9c0\uac8c \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
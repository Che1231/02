[{"question": "\u5982\u4f55\u4ee5\u65b0\u624b\u8eab\u4efd\u5728\u7c43\u7403\u4e4b\u661f\u4e2d\u5b8c\u6210\u704c\u7c43\uff1f", "answer": "\u8981\u5728\u7c43\u7403\u4e4b\u661f\u4e2d\u5b8c\u6210\u704c\u7c43\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u5c07\u4f60\u7684\u7403\u54e1\u64fa\u653e\u5728\u7c43\u6846\u9644\u8fd1\u3002\u6b65\u9a5f2 - \u7528\u8db3\u5920\u7684\u529b\u91cf\u5728\u87a2\u5e55\u4e0a\u5411\u4e0a\u6ed1\u52d5\u3002\u6b65\u9a5f3 - \u5728\u8df3\u8e8d\u9802\u9ede\u91cb\u653e\uff0c\u4ee5\u4fbf\u6210\u529f\u704c\u7c43\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u300c\u529b\u91cf\u704c\u7c43\u300d\u52d5\u4f5c\u8207\u300c\u704c\u7c43\u5927\u5e2b\u300d\u7403\u54e1\uff0c\u589e\u52a0\u5f97\u5206\u6a5f\u6703\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4e00\u4e0b\u767c\u5c04\u706b\u7bad\u2014\u2014\u6642\u6a5f\u548c\u529b\u91cf\u81f3\u95dc\u91cd\u8981\u3002]"}, {"question": "\u5728\u7c43\u7403\u4e4b\u661f\u76841\u5c0d1\u6bd4\u8cfd\u4e2d\uff0c\u54ea\u4e9b\u662f\u7372\u52dd\u7684\u6700\u4f73\u7b56\u7565\uff1f", "answer": "\u5728\u7c43\u7403\u4e4b\u661f\u76841\u5c0d1\u6bd4\u8cfd\u4e2d\u7372\u52dd\uff0c\u9700\u8981\u7d50\u5408\u9032\u653b\u548c\u9632\u5b88\u3002\u6b65\u9a5f1 - \u7cbe\u901a\u4f60\u7403\u54e1\u7684\u7279\u6b8a\u52d5\u4f5c\uff0c\u4f8b\u5982\u300c\u4ea4\u53c9\u6b65\u300d\u6216\u300c\u5f8c\u64a4\u6b65\u300d\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u5047\u52d5\u4f5c\u4f86\u8aa4\u5c0e\u5c0d\u624b\u3002\u6b65\u9a5f3 - \u7e3d\u662f\u5728\u6b63\u78ba\u7684\u6642\u9593\u6ed1\u52d5\u4f86\u963b\u64cb\u6295\u7c43\u3002\u4f8b\u5982\uff0c\u300c\u963b\u653b\u738b\u300d\u7403\u54e1\u5728\u9632\u5b88\u65b9\u9762\u975e\u5e38\u51fa\u8272\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u9032\u653b\u7403\u54e1\u50cf\u300c\u5c04\u661f\u300d\u4e00\u6a23\u9069\u5408\u5f97\u5206\uff0c\u800c\u9632\u5b88\u7403\u54e1\u50cf\u300c\u963b\u653b\u738b\u300d\u5247\u66f4\u64c5\u9577\u963b\u6b62\u5c0d\u624b\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u7684\u7403\u54e1\u5728\u7c43\u7403\u4e4b\u661f\u4e2d\u6703\u932f\u904e\u7c21\u55ae\u7684\u6295\u7c43\uff1f", "answer": "\u5728\u7c43\u7403\u4e4b\u661f\u4e2d\u932f\u904e\u7c21\u55ae\u7684\u6295\u7c43\uff0c\u53ef\u80fd\u6709\u5e7e\u500b\u539f\u56e0\u3002\u6b65\u9a5f1 - \u78ba\u4fdd\u7403\u54e1\u7684\u9ad4\u80fd\u5f88\u9ad8\uff1b\u9ad4\u80fd\u4f4e\u6703\u5f71\u97ff\u6e96\u78ba\u6027\u3002\u6b65\u9a5f2 - \u6aa2\u67e5\u6295\u7c43\u8a08\u91cf\u5668\uff1b\u904e\u65e9\u6216\u904e\u665a\u91cb\u653e\u6703\u5c0e\u81f4\u6295\u7c43\u5931\u8aa4\u3002\u6b65\u9a5f3 - \u5347\u7d1a\u4f60\u7684\u7403\u54e1\u7684\u5c04\u64ca\u6578\u64da\u3002\u4f8b\u5982\uff0c\u300c\u795e\u5c04\u624b\u300d\u7403\u54e1\u6709\u66f4\u9ad8\u7684\u6210\u529f\u7387\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6bd4\u8f03\u300c\u5c04\u64ca\u6e96\u78ba\u5ea6\u300d\u548c\u300c\u9ad4\u80fd\u300d\u7b49\u6578\u64da\uff0c\u4ee5\u512a\u5316\u6027\u80fd\u3002]"}, {"question": "\u5982\u4f55\u5728\u7c43\u7403\u4e4b\u661f\u4e2d\u89e3\u9396\u65b0\u7403\u54e1\uff1f", "answer": "\u5728\u7c43\u7403\u4e4b\u661f\u4e2d\u89e3\u9396\u65b0\u7403\u54e1\uff0c\u9700\u8981\u900f\u904e\u904a\u6232\u8cfa\u53d6\u786c\u5e63\u548c\u5bf6\u77f3\u3002\u6b65\u9a5f1 - \u5b8c\u6210\u6bcf\u65e5\u6311\u6230\u548c\u6bd4\u8cfd\u4ee5\u6536\u96c6\u8cc7\u6e90\u3002\u6b65\u9a5f2 - \u524d\u5f80\u300c\u7403\u54e1\u5546\u5e97\u300d\u8cfc\u8cb7\u65b0\u7403\u54e1\u3002\u6b65\u9a5f3 - \u53c3\u52a0\u6d3b\u52d5\u4ee5\u7372\u5f97\u7368\u5bb6\u7403\u54e1\u3002\u4f8b\u5982\uff0c\u300c\u5df7\u9053\u6263\u7c43\u738b\u300d\u53ef\u4ee5\u5728\u7279\u6b8a\u6d3b\u52d5\u4e2d\u89e3\u9396\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u9019\u5c31\u50cf\u6536\u96c6\u4ea4\u6613\u5361\u2014\u2014\u6bcf\u500b\u7403\u54e1\u90fd\u80fd\u70ba\u4f60\u7684\u7403\u968a\u5e36\u4f86\u7368\u7279\u7684\u50f9\u503c\u3002]"}, {"question": "\u7c43\u7403\u4e4b\u661f\u4e2d\u7684\u666e\u901a\u6bd4\u8cfd\u548c\u6392\u4f4d\u8cfd\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "\u7c43\u7403\u4e4b\u661f\u4e2d\u7684\u666e\u901a\u6bd4\u8cfd\u548c\u6392\u4f4d\u8cfd\u5728\u5e7e\u500b\u65b9\u9762\u6709\u6240\u4e0d\u540c\u3002\u6b65\u9a5f1 - \u666e\u901a\u6bd4\u8cfd\u7528\u65bc\u7df4\u7fd2\u548c\u5a1b\u6a02\uff0c\u800c\u6392\u4f4d\u8cfd\u6703\u5f71\u97ff\u4f60\u7684\u6392\u884c\u699c\u4f4d\u7f6e\u3002\u6b65\u9a5f2 - \u6392\u4f4d\u8cfd\u9700\u8981\u66f4\u9ad8\u7684\u6280\u80fd\u6c34\u5e73\u548c\u6230\u7565\u6027\u64cd\u4f5c\u3002\u6b65\u9a5f3 - \u6392\u4f4d\u8cfd\u4e2d\u7684\u734e\u52f5\u66f4\u8c50\u539a\u3002\u4f8b\u5982\uff0c\u8d0f\u5f97\u4e00\u5834\u6392\u4f4d\u8cfd\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u4f60\u7684\u6392\u540d\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u666e\u901a\u6bd4\u8cfd\u5c31\u50cf\u71b1\u8eab\uff0c\u800c\u6392\u4f4d\u8cfd\u662f\u91cd\u982d\u6232\u3002]"}, {"question": "\u7c43\u7403\u4e4b\u661f\u4e2d\u6700\u6709\u50f9\u503c\u7684\u904a\u6232\u8ca8\u5e63\u662f\u4ec0\u9ebc\uff0c\u70ba\u4ec0\u9ebc\uff1f", "answer": "\u7c43\u7403\u4e4b\u661f\u4e2d\u6700\u6709\u50f9\u503c\u7684\u904a\u6232\u8ca8\u5e63\u662f\u786c\u5e63\u548c\u5bf6\u77f3\u3002\u6b65\u9a5f1 - \u786c\u5e63\u7528\u65bc\u57fa\u672c\u5347\u7d1a\u548c\u7403\u54e1\u8cfc\u8cb7\u3002\u6b65\u9a5f2 - \u5bf6\u77f3\u66f4\u7a00\u6709\uff0c\u53ef\u4ee5\u89e3\u9396\u9ad8\u7d1a\u7403\u54e1\u548c\u9053\u5177\u3002\u6b65\u9a5f3 - \u512a\u5148\u900f\u904e\u6d3b\u52d5\u548c\u6311\u6230\u8cfa\u53d6\u5bf6\u77f3\u3002\u4f8b\u5982\uff0c\u300c\u50b3\u5947\u7403\u54e1\u5305\u300d\u53ea\u80fd\u7528\u5bf6\u77f3\u8cfc\u8cb7\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6bd4\u8f03\u786c\u5e63\u548c\u5bf6\u77f3\u7684\u4f7f\u7528\u65b9\u6cd5\u548c\u7372\u53d6\u65b9\u6cd5\uff0c\u4ee5\u6709\u6548\u5730\u5236\u5b9a\u512a\u5148\u9806\u5e8f\u3002]"}, {"question": "\u7c43\u7403\u4e4b\u661f\u7684\u5339\u914d\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff1f", "answer": "\u7c43\u7403\u4e4b\u661f\u7684\u5339\u914d\u7cfb\u7d71\u6703\u6839\u64da\u7403\u54e1\u7684\u6280\u80fd\u6c34\u5e73\u548c\u6392\u540d\u4f86\u914d\u5c0d\u7403\u54e1\u3002\u6b65\u9a5f1 - \u7cfb\u7d71\u6703\u8a55\u4f30\u4f60\u6700\u8fd1\u7684\u8868\u73fe\u548c\u52dd\u8ca0\u6bd4\u3002\u6b65\u9a5f2 - \u5b83\u6703\u5c07\u4f60\u8207\u5177\u6709\u76f8\u4f3c\u6578\u64da\u7684\u7403\u54e1\u5339\u914d\uff0c\u4ee5\u78ba\u4fdd\u516c\u5e73\u5c0d\u6297\u3002\u6b65\u9a5f3 - \u6392\u540d\u8f03\u9ad8\u7684\u7403\u54e1\u5c07\u9762\u81e8\u66f4\u5f37\u52c1\u7684\u5c0d\u624b\u3002\u4f8b\u5982\uff0c\u52dd\u7387\u70ba70%\u7684\u7403\u54e1\u5c07\u9762\u5c0d\u540c\u6a23\u6280\u80fd\u6c34\u5e73\u7684\u5c0d\u624b\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u4e86\u89e3\u5f9e\u7403\u54e1\u6578\u64da\u2192\u5339\u914d\u6f14\u7b97\u6cd5\u2192\u5c0d\u624b\u9078\u64c7\u7684\u6d41\u7a0b\u3002]"}, {"question": "\u6211\u53ef\u4ee5\u5728\u624b\u6a5f\u7248\u7684\u7c43\u7403\u4e4b\u661f\u5c07\u9032\u5ea6\u8f49\u79fb\u5230\u96fb\u8166\u7248\u55ce\uff1f", "answer": "\u662f\u7684\uff0c\u4f60\u53ef\u4ee5\u5c07\u624b\u6a5f\u7248\u7684\u7c43\u7403\u4e4b\u661f\u9032\u5ea6\u8f49\u79fb\u5230\u96fb\u8166\u7248\u3002\u6b65\u9a5f1 - \u78ba\u4fdd\u4f60\u540c\u6642\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u767b\u5165\u540c\u4e00\u500b\u5e33\u865f\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u4f86\u540c\u6b65\u4f60\u7684\u9032\u5ea6\u3002\u6b65\u9a5f3 - \u901a\u904e\u6aa2\u67e5\u4f60\u7684\u7403\u54e1\u6578\u64da\u548c\u7269\u54c1\u4f86\u9a57\u8b49\u8f49\u79fb\u3002\u4f8b\u5982\uff0c\u4f60\u7684\u300c\u704c\u7c43\u5927\u5e2b\u300d\u7403\u54e1\u548c\u7d2f\u7a4d\u7684\u786c\u5e63\u61c9\u8a72\u5728\u5169\u500b\u5e73\u53f0\u4e0a\u51fa\u73fe\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u9019\u5c31\u50cf\u5c07\u4f60\u7684\u7269\u54c1\u642c\u5230\u65b0\u623f\u5b50\u2014\u2014\u4e00\u5207\u61c9\u8a72\u5230\u4f4d\u3002]"}, {"question": "\u5728\u7c43\u7403\u4e4b\u661f\u4e2d\uff0c\u6211\u53ef\u4ee5\u89e3\u9396\u54ea\u4e9b\u96b1\u85cf\u6210\u5c31\uff1f", "answer": "\u7c43\u7403\u4e4b\u661f\u6709\u4e00\u4e9b\u96b1\u85cf\u6210\u5c31\uff0c\u5b83\u5011\u6703\u734e\u52f5\u7368\u7279\u7684\u904a\u6232\u98a8\u683c\u3002\u6b65\u9a5f1 - \u5b8c\u6210\u4e00\u5b9a\u6578\u91cf\u7684\u6210\u529f\u704c\u7c43\u624d\u80fd\u89e3\u9396\u300c\u704c\u7c43\u738b\u300d\u3002\u6b65\u9a5f2 - \u5728\u6c92\u6709\u932f\u904e\u4efb\u4f55\u6295\u7c43\u7684\u60c5\u6cc1\u4e0b\u8d0f\u5f97\u6bd4\u8cfd\uff0c\u4ee5\u7372\u5f97\u300c\u5b8c\u7f8e\u904a\u6232\u300d\u3002\u6b65\u9a5f3 - \u5728\u55ae\u5834\u6bd4\u8cfd\u4e2d\u963b\u64cb 10 \u6b21\u6295\u7c43\u624d\u80fd\u7372\u5f97\u300c\u9632\u79a6\u7246\u300d\u3002\u4f8b\u5982\uff0c\u9054\u6210\u300c\u5b8c\u7f8e\u904a\u6232\u300d\u5c07\u6703\u7372\u5f97\u7368\u5bb6\u7403\u54e1\u76ae\u819a\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u9019\u5c31\u50cf\u5c0b\u627e\u5fa9\u6d3b\u7bc0\u5f69\u86cb\u2014\u2014\u5c08\u70ba\u6295\u5165\u7684\u7403\u54e1\u6e96\u5099\u7684\u96b1\u85cf\u734e\u52f5\u3002]"}, {"question": "\u5982\u4f55\u5728\u7c43\u7403\u4e4b\u661f\u4e2d\u512a\u5316\u7403\u54e1\u7684\u6578\u64da\uff0c\u4ee5\u9032\u884c\u7af6\u6280\u6bd4\u8cfd\uff1f", "answer": "\u5728\u7c43\u7403\u4e4b\u661f\u4e2d\u512a\u5316\u7403\u54e1\u7684\u6578\u64da\uff0c\u9700\u8981\u9032\u884c\u6230\u7565\u6027\u7684\u5347\u7d1a\u3002\u6b65\u9a5f1 - \u96c6\u4e2d\u65bc\u95dc\u9375\u6578\u64da\uff0c\u4f8b\u5982\u300c\u5c04\u64ca\u6e96\u78ba\u5ea6\u300d\u548c\u300c\u901f\u5ea6\u300d\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u786c\u5e63\u548c\u5bf6\u77f3\u8cfc\u8cb7\u6578\u64da\u63d0\u5347\u3002\u6b65\u9a5f3 - \u88dd\u5099\u53ef\u4ee5\u52a0\u5f37\u7279\u5b9a\u80fd\u529b\u7684\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u300c\u52a0\u901f\u978b\u300d\u7269\u54c1\u53ef\u4ee5\u63d0\u5347\u7403\u54e1\u7684\u79fb\u52d5\u901f\u5ea6\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6bd4\u8f03\u57fa\u790e\u6578\u64da\u8207\u5347\u7d1a\u5f8c\u6578\u64da\uff0c\u770b\u770b\u6539\u9032\u7684\u5f71\u97ff\u3002]"}]
[{"question": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30bf\u30fc\u30ba\u3067\u521d\u5fc3\u8005\u3068\u3057\u3066\u3069\u306e\u3088\u3046\u306b\u30c0\u30f3\u30af\u30b7\u30e5\u30fc\u30c8\u3092\u5b9f\u884c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30bf\u30fc\u30ba\u3067\u30c0\u30f3\u30af\u30b7\u30e5\u30fc\u30c8\u3092\u5b9f\u884c\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30d0\u30b9\u30b1\u30c3\u30c8\u306e\u8fd1\u304f\u306b\u30d7\u30ec\u30fc\u30e4\u30fc\u3092\u914d\u7f6e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u753b\u9762\u3092\u4e0a\u306b\u5341\u5206\u306a\u529b\u3067\u30b9\u30ef\u30a4\u30d7\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b8\u30e3\u30f3\u30d7\u306e\u9802\u70b9\u3067\u653e\u3059\u3053\u3068\u3067\u3001\u6210\u529f\u3057\u305f\u30c0\u30f3\u30af\u306b\u306a\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u30d1\u30ef\u30fc\u30c0\u30f3\u30af\u300f\u306e\u52d5\u304d\u3068\u300e\u30c0\u30f3\u30af\u30de\u30b9\u30bf\u30fc\u300f\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u5f97\u70b9\u3059\u308b\u53ef\u80fd\u6027\u304c\u9ad8\u307e\u308a\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e: \u30ed\u30b1\u30c3\u30c8\u3092\u767a\u5c04\u3059\u308b\u306e\u3068\u540c\u3058\u3067\u3059\u3002\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u529b\u306f\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002]"}, {"question": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30bf\u30fc\u30ba\u30671\u5bfe1\u306e\u8a66\u5408\u306b\u52dd\u3064\u305f\u3081\u306e\u6700\u5584\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30bf\u30fc\u30ba\u30671\u5bfe1\u306e\u8a66\u5408\u306b\u52dd\u3064\u305f\u3081\u306b\u306f\u3001\u653b\u6483\u3068\u9632\u5fa1\u306e\u4e21\u65b9\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u300e\u30af\u30ed\u30b9\u30aa\u30fc\u30d0\u30fc\u300f\u3084\u300e\u30b9\u30c6\u30c3\u30d7\u30d0\u30c3\u30af\u300f\u306a\u3069\u306e\u30d7\u30ec\u30fc\u30e4\u30fc\u306e\u30b9\u30da\u30b7\u30e3\u30eb\u30e0\u30fc\u30d6\u3092\u30de\u30b9\u30bf\u30fc\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d5\u30a7\u30a4\u30af\u30b7\u30e5\u30fc\u30c8\u3092\u4f7f\u3063\u3066\u5bfe\u6226\u76f8\u624b\u3092\u60d1\u308f\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u9069\u5207\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u30b9\u30ef\u30a4\u30d7\u3057\u3066\u5e38\u306b\u30b7\u30e5\u30fc\u30c8\u3092\u30d6\u30ed\u30c3\u30af\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u30d6\u30ed\u30c3\u30af\u30ad\u30f3\u30b0\u300f\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u9632\u5fa1\u306b\u512a\u308c\u3066\u3044\u307e\u3059\u3002[\u591a\u69d8\u306a\u9078\u629e\u306e\u6bd4\u8f03\uff1a\u653b\u6483\u7684\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u3042\u308b\u300e\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0\u30b9\u30bf\u30fc\u300f\u306f\u5f97\u70b9\u306b\u6700\u9069\u3067\u3059\u304c\u3001\u9632\u5fa1\u7684\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u3042\u308b\u300e\u30d6\u30ed\u30c3\u30af\u30ad\u30f3\u30b0\u300f\u306f\u5bfe\u6226\u76f8\u624b\u3092\u963b\u6b62\u3059\u308b\u65b9\u304c\u512a\u308c\u3066\u3044\u307e\u3059\u3002]"}, {"question": "\u306a\u305c\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30bf\u30fc\u30ba\u3067\u7c21\u5358\u306a\u30b7\u30e5\u30fc\u30c8\u3092\u5916\u3057\u3066\u3057\u307e\u3046\u306e\u3067\u3059\u304b\uff1f", "answer": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30bf\u30fc\u30ba\u3067\u7c21\u5358\u306a\u30b7\u30e5\u30fc\u30c8\u3092\u5916\u3057\u3066\u3057\u307e\u3046\u306e\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u8981\u56e0\u304c\u8003\u3048\u3089\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30d7\u30ec\u30fc\u30e4\u30fc\u306e\u30b9\u30bf\u30df\u30ca\u304c\u9ad8\u3044\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30bf\u30df\u30ca\u304c\u4f4e\u3044\u3068\u7cbe\u5ea6\u306b\u5f71\u97ff\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b7\u30e5\u30fc\u30c8\u30e1\u30fc\u30bf\u30fc\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u65e9\u3059\u304e\u305f\u308a\u9045\u3059\u304e\u305f\u308a\u3059\u308b\u3068\u30b7\u30e5\u30fc\u30c8\u3092\u5916\u3057\u3066\u3057\u307e\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30d7\u30ec\u30fc\u30e4\u30fc\u306e\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u30b7\u30e3\u30fc\u30d7\u30b7\u30e5\u30fc\u30bf\u30fc\u300f\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u6210\u529f\u7387\u304c\u9ad8\u3044\u3067\u3059\u3002[\u69cb\u6210\u6bd4\u8f03\u8868\uff1a\u300e\u30b7\u30e5\u30fc\u30c8\u7cbe\u5ea6\u300f\u3084\u300e\u30b9\u30bf\u30df\u30ca\u300f\u306a\u3069\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u6bd4\u8f03\u3057\u3066\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3057\u307e\u3059\u3002]"}, {"question": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30bf\u30fc\u30ba\u3067\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u3069\u306e\u3088\u3046\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30bf\u30fc\u30ba\u3067\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u306b\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u901a\u3058\u3066\u30b3\u30a4\u30f3\u3068\u30b8\u30a7\u30e0\u3092\u7372\u5f97\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30c7\u30a4\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u3068\u8a66\u5408\u3092\u5b8c\u4e86\u3057\u3066\u30ea\u30bd\u30fc\u30b9\u3092\u96c6\u3081\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u300e\u30d7\u30ec\u30a4\u30e4\u30fc\u30b7\u30e7\u30c3\u30d7\u300f\u306b\u30a2\u30af\u30bb\u30b9\u3057\u3066\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u8cfc\u5165\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7279\u5225\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u305f\u3081\u306b\u30a4\u30d9\u30f3\u30c8\u306b\u53c2\u52a0\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u30a2\u30ea\u30fc\u30aa\u30fc\u30d7\u30ad\u30f3\u30b0\u300f\u306f\u7279\u5225\u306a\u30a4\u30d9\u30f3\u30c8\u4e2d\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u30c8\u30ec\u30fc\u30c7\u30a3\u30f3\u30b0\u30ab\u30fc\u30c9\u3092\u96c6\u3081\u308b\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u5404\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30c1\u30fc\u30e0\u306b\u72ec\u81ea\u306e\u4fa1\u5024\u3092\u52a0\u3048\u307e\u3059\u3002]"}, {"question": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30bf\u30fc\u30ba\u306e\u30ab\u30b8\u30e5\u30a2\u30eb\u30de\u30c3\u30c1\u3068\u30e9\u30f3\u30af\u30de\u30c3\u30c1\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30bf\u30fc\u30ba\u306e\u30ab\u30b8\u30e5\u30a2\u30eb\u30de\u30c3\u30c1\u3068\u30e9\u30f3\u30af\u30de\u30c3\u30c1\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u70b9\u3067\u7570\u306a\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30ab\u30b8\u30e5\u30a2\u30eb\u30de\u30c3\u30c1\u306f\u7df4\u7fd2\u3068\u697d\u3057\u3080\u305f\u3081\u306e\u3082\u306e\u3067\u3042\u308a\u3001\u30e9\u30f3\u30af\u30de\u30c3\u30c1\u306f\u3042\u306a\u305f\u306e\u30e9\u30f3\u30ad\u30f3\u30b0\u30dd\u30b8\u30b7\u30e7\u30f3\u306b\u5f71\u97ff\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30e9\u30f3\u30af\u30de\u30c3\u30c1\u306f\u3088\u308a\u9ad8\u3044\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u3068\u6226\u7565\u7684\u306a\u30d7\u30ec\u30a4\u3092\u5fc5\u8981\u3068\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30e9\u30f3\u30af\u30de\u30c3\u30c1\u306e\u5831\u916c\u306f\u3088\u308a\u5927\u304d\u3044\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30e9\u30f3\u30af\u30de\u30c3\u30c1\u306b\u52dd\u5229\u3059\u308b\u3068\u9806\u4f4d\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002[\u591a\u69d8\u306a\u9078\u629e\u306e\u6bd4\u8f03\uff1a\u30ab\u30b8\u30e5\u30a2\u30eb\u30de\u30c3\u30c1\u306f\u30a6\u30a9\u30fc\u30df\u30f3\u30b0\u30a2\u30c3\u30d7\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3042\u308a\u3001\u30e9\u30f3\u30af\u30de\u30c3\u30c1\u306f\u672c\u6226\u3067\u3059\u3002]"}, {"question": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30bf\u30fc\u30ba\u3067\u6700\u3082\u4fa1\u5024\u306e\u3042\u308b\u30a4\u30f3\u30b2\u30fc\u30e0\u901a\u8ca8\u3068\u305d\u306e\u7406\u7531\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30bf\u30fc\u30ba\u3067\u6700\u3082\u4fa1\u5024\u306e\u3042\u308b\u30a4\u30f3\u30b2\u30fc\u30e0\u901a\u8ca8\u306f\u3001\u30b3\u30a4\u30f3\u3068\u30b8\u30a7\u30e0\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b3\u30a4\u30f3\u306f\u57fa\u672c\u7684\u306a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3068\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u8cfc\u5165\u306b\u4f7f\u7528\u3055\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b8\u30a7\u30e0\u306f\u5e0c\u5c11\u3067\u3042\u308a\u3001\u30d7\u30ec\u30df\u30a2\u30e0\u30d7\u30ec\u30a4\u30e4\u30fc\u3084\u30a2\u30a4\u30c6\u30e0\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30a4\u30d9\u30f3\u30c8\u3084\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u901a\u3057\u3066\u30b8\u30a7\u30e0\u3092\u7372\u5f97\u3059\u308b\u3053\u3068\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u4f1d\u8aac\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u30d1\u30c3\u30af\u300f\u306f\u30b8\u30a7\u30e0\u3067\u3057\u304b\u8cfc\u5165\u3067\u304d\u307e\u305b\u3093\u3002[\u69cb\u6210\u6bd4\u8f03\u8868\uff1a\u30b3\u30a4\u30f3\u3068\u30b8\u30a7\u30e0\u306e\u4f7f\u7528\u65b9\u6cd5\u3068\u5165\u624b\u65b9\u6cd5\u3092\u6bd4\u8f03\u3057\u3066\u3001\u512a\u5148\u9806\u4f4d\u3092\u52b9\u679c\u7684\u306b\u8a2d\u5b9a\u3057\u307e\u3059\u3002]"}, {"question": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30bf\u30fc\u30ba\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30bf\u30fc\u30ba\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u3068\u30e9\u30f3\u30ad\u30f3\u30b0\u306b\u57fa\u3065\u3044\u3066\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u30da\u30a2\u30ea\u30f3\u30b0\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b7\u30b9\u30c6\u30e0\u306f\u3042\u306a\u305f\u306e\u6700\u8fd1\u306e\u6210\u679c\u3068\u52dd\u6557\u7387\u3092\u8a55\u4fa1\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u305d\u308c\u306f\u3001\u516c\u5e73\u306a\u8a66\u5408\u3092\u4fdd\u8a3c\u3059\u308b\u305f\u3081\u306b\u3001\u4f3c\u305f\u3088\u3046\u306a\u30b9\u30c6\u30fc\u30bf\u30b9\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u3042\u306a\u305f\u3092\u30de\u30c3\u30c1\u30f3\u30b0\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30e9\u30f3\u30af\u306e\u9ad8\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3088\u308a\u5f37\u3044\u5bfe\u6226\u76f8\u624b\u3068\u5bfe\u6226\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u300170\uff05\u306e\u52dd\u7387\u3092\u6301\u3064\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u540c\u69d8\u306b\u719f\u7df4\u3057\u305f\u5bfe\u6226\u76f8\u624b\u3068\u5bfe\u6226\u3057\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u2192\u30de\u30c3\u30c1\u30f3\u30b0\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u2192\u5bfe\u6226\u76f8\u624b\u9078\u629e\u306e\u6d41\u308c\u3092\u7406\u89e3\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30bf\u30fc\u30ba\u3067\u79c1\u306e\u30e2\u30d0\u30a4\u30eb\u7248\u306e\u9032\u6357\u72b6\u6cc1\u3092PC\u306b\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30bf\u30fc\u30ba\u306e\u30e2\u30d0\u30a4\u30eb\u7248\u306e\u9032\u6357\u72b6\u6cc1\u3092PC\u306b\u8ee2\u9001\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u9032\u6357\u72b6\u6cc1\u3092\u540c\u671f\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u3068\u30a2\u30a4\u30c6\u30e0\u3092\u78ba\u8a8d\u3057\u3066\u8ee2\u9001\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u30c0\u30f3\u30af\u30de\u30b9\u30bf\u30fc\u300f\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u84c4\u7a4d\u3055\u308c\u305f\u30b3\u30a4\u30f3\u306f\u3001\u4e21\u65b9\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u8868\u793a\u3055\u308c\u308b\u306f\u305a\u3067\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u8377\u7269\u3092\u65b0\u3057\u3044\u5bb6\u306b\u79fb\u52d5\u3059\u308b\u306e\u3068\u540c\u3058\u3067\u3059\u3002\u3059\u3079\u3066\u6574\u7136\u3068\u914d\u7f6e\u3055\u308c\u3066\u3044\u308b\u306f\u305a\u3067\u3059\u3002]"}, {"question": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30bf\u30fc\u30ba\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u308b\u96a0\u3057\u5b9f\u7e3e\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30bf\u30fc\u30ba\u306b\u306f\u3001\u30e6\u30cb\u30fc\u30af\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5831\u916c\u3068\u3057\u3066\u4e0e\u3048\u308b\u3001\u3044\u304f\u3064\u304b\u306e\u96a0\u3057\u5b9f\u7e3e\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u7279\u5b9a\u306e\u6570\u306e\u6210\u529f\u3057\u305f\u30c0\u30f3\u30af\u3092\u5b9f\u884c\u3057\u3066\u300e\u30c0\u30f3\u30af\u30ad\u30f3\u30b0\u300f\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b7\u30e5\u30fc\u30c8\u3092\u30df\u30b9\u3059\u308b\u3053\u3068\u306a\u304f\u8a66\u5408\u306b\u52dd\u3061\u3001\u300e\u30d1\u30fc\u30d5\u30a7\u30af\u30c8\u30b2\u30fc\u30e0\u300f\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5358\u4e00\u8a66\u5408\u306710\u56de\u30b7\u30e5\u30fc\u30c8\u3092\u30d6\u30ed\u30c3\u30af\u3057\u3001\u300e\u30c7\u30a3\u30d5\u30a7\u30f3\u30b9\u306e\u58c1\u300f\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u30d1\u30fc\u30d5\u30a7\u30af\u30c8\u30b2\u30fc\u30e0\u300f\u3092\u7372\u5f97\u3059\u308b\u3068\u3001\u9650\u5b9a\u7684\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u30b9\u30ad\u30f3\u304c\u4e0e\u3048\u3089\u308c\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u898b\u3064\u3051\u308b\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u71b1\u5fc3\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u306f\u96a0\u3055\u308c\u305f\u5831\u916c\u3067\u3059\u3002]"}, {"question": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30bf\u30fc\u30ba\u3067\u7af6\u4e89\u529b\u306e\u3042\u308b\u30d7\u30ec\u30a4\u306e\u305f\u3081\u306b\u30d7\u30ec\u30fc\u30e4\u30fc\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u30b9\u30bf\u30fc\u30ba\u3067\u30d7\u30ec\u30fc\u30e4\u30fc\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u6226\u7565\u7684\u306a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u300e\u30b7\u30e5\u30fc\u30c8\u7cbe\u5ea6\u300f\u3068\u300e\u30b9\u30d4\u30fc\u30c9\u300f\u306e\u3088\u3046\u306a\u30ad\u30fc\u30b9\u30c6\u30fc\u30bf\u30b9\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b3\u30a4\u30f3\u3068\u30b8\u30a7\u30e0\u3092\u4f7f\u7528\u3057\u3066\u30b9\u30c6\u30fc\u30bf\u30b9\u30d6\u30fc\u30b9\u30c8\u3092\u8cfc\u5165\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7279\u5b9a\u306e\u80fd\u529b\u3092\u9ad8\u3081\u308b\u30a2\u30a4\u30c6\u30e0\u3092\u88c5\u5099\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u30b9\u30d4\u30fc\u30c9\u30b7\u30e5\u30fc\u30ba\u300f\u306e\u30a2\u30a4\u30c6\u30e0\u306f\u30d7\u30ec\u30fc\u30e4\u30fc\u306e\u79fb\u52d5\u901f\u5ea6\u3092\u9ad8\u3081\u307e\u3059\u3002[\u69cb\u6210\u6bd4\u8f03\u8868\uff1a\u30d9\u30fc\u30b9\u30b9\u30c6\u30fc\u30bf\u30b9\u3068\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u5f8c\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u6bd4\u8f03\u3057\u3066\u3001\u5f37\u5316\u306e\u5f71\u97ff\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002]"}]
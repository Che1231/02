[{"question": "\ub18d\uad6c \uc2a4\ud0c0 \ucd08\ubcf4\uc790\uac00 \ub369\ud06c\uc29b\uc744 \uc5b4\ub5bb\uac8c \ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub18d\uad6c \uc2a4\ud0c0\uc5d0\uc11c \ub369\ud06c\uc29b\uc744 \ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. \ub2e8\uacc41 - \ubc14\uc2a4\ucf13 \uadfc\ucc98\uc5d0 \ud50c\ub808\uc774\uc5b4\ub97c \ubc30\uce58\ud569\ub2c8\ub2e4. \ub2e8\uacc42 - \ud654\uba74 \uc704\ub85c \ucda9\ubd84\ud55c \ud798\uc73c\ub85c \uc2a4 \uc640\uc774\ud504\ud569\ub2c8\ub2e4. \ub2e8\uacc43 - \uc810\ud504 \uc815\uc810\uc5d0\uc11c \ub9b4\ub9ac\uc2a4\ud558\uc5ec \uc131\uacf5\uc801\uc778 \ub369\ud06c\ub97c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud30c\uc6cc \ub369\ud06c' \ub3d9\uc791\uacfc '\ub369\ud06c \ub9c8\uc2a4\ud130' \ud50c\ub808\uc774\uc5b4\ub97c \uc0ac\uc6a9\ud558\uba74 \ub4dd\uc810\ud560 \uac00\ub2a5\uc131\uc774 \ub192\uc544\uc9d1\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ub85c\ucf13\uc744 \ubc1c\uc0ac\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ud0c0\uc774\ubc0d\uacfc \ud798\uc774 \uc911\uc694\ud569\ub2c8\ub2e4.]"}, {"question": "\ub18d\uad6c \uc2a4\ud0c0 1\ub3001 \uacbd\uae30\uc5d0\uc11c \uc2b9\ub9ac\ud558\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub18d\uad6c \uc2a4\ud0c0 1\ub3001 \uacbd\uae30\uc5d0\uc11c \uc2b9\ub9ac\ud558\ub824\uba74 \uacf5\uaca9\uacfc \uc218\ube44\uc758 \uc870\ud654\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc41 - '\ud06c\ub85c\uc2a4\uc624\ubc84' \ub610\ub294 '\uc2a4\ud15d\ubc31'\uacfc \uac19\uc740 \ud50c\ub808\uc774\uc5b4\uc758 \ud2b9\uc218 \ub3d9\uc791\uc744 \uc219\ub2ec\ud569\ub2c8\ub2e4. \ub2e8\uacc42 - \uc0c1\ub300\ubc29\uc744 \uc18d\uc774\uae30 \uc704\ud574 \uac00\uc9dc \uc29b\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ub2e8\uacc43 - \uc801\uc808\ud55c \uc2dc\uc810\uc5d0 \uc2a4 \uc640\uc774\ud504\ud558\uc5ec \ud56d\uc0c1 \uc29b\uc744 \ucc28\ub2e8\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ube14\ub85d \ud0b9' \ud50c\ub808\uc774\uc5b4\ub294 \uc218\ube44\uc5d0\uc11c \ub6f0\uc5b4\ub0a9\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: '\uc288\ud305 \uc2a4\ud0c0'\uc640 \uac19\uc740 \uacf5\uaca9\ud615 \ud50c\ub808\uc774\uc5b4\ub294 \ub4dd\uc810\uc5d0 \uc88b\uace0, '\ube14\ub85d \ud0b9'\uacfc \uac19\uc740 \uc218\ube44\ud615 \ud50c\ub808\uc774\uc5b4\ub294 \uc0c1\ub300\ubc29\uc744 \ub9c9\ub294 \ub370 \ub354 \uc88b\uc2b5\ub2c8\ub2e4.]"}, {"question": "\uc65c \ub18d\uad6c \uc2a4\ud0c0\uc5d0\uc11c \uc26c\uc6b4 \uc29b\uc744 \ub193\uce58\ub294 \uac78\uae4c\uc694?", "answer": "\ub18d\uad6c \uc2a4\ud0c0\uc5d0\uc11c \uc26c\uc6b4 \uc29b\uc744 \ub193\uce58\ub294 \uac83\uc740 \uc5ec\ub7ec \uac00\uc9c0 \uc694\uc778 \ub54c\ubb38\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc41 - \ud50c\ub808\uc774\uc5b4\uc758 \uccb4\ub825\uc774 \ucda9\ubd84\ud55c\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uccb4\ub825\uc774 \ub0ae\uc73c\uba74 \uc815\ud655\ub3c4\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ub2e8\uacc42 - \uc29b \ubbf8\ud130\ub97c \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \ub108\ubb34 \uc77c\ucc0d \ub610\ub294 \ub108\ubb34 \ub2a6\uac8c \ub9b4\ub9ac\uc2a4\ud558\uba74 \uc29b\uc774 \ube57\ub098\uac11\ub2c8\ub2e4. \ub2e8\uacc43 - \ud50c\ub808\uc774\uc5b4\uc758 \uc288\ud305 \ud1b5\uacc4\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\uc0e4\ud504 \uc288\ud130' \ud50c\ub808\uc774\uc5b4\ub294 \uc131\uacf5\ub960\uc774 \ub192\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: '\uc288\ud305 \uc815\ud655\ub3c4'\uc640 '\uccb4\ub825'\uacfc \uac19\uc740 \ud1b5\uacc4\ub97c \ube44\uad50\ud558\uc5ec \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\uc2ed\uc2dc\uc624.]"}, {"question": "\ub18d\uad6c \uc2a4\ud0c0\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub97c \uc5b4\ub5bb\uac8c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub18d\uad6c \uc2a4\ud0c0\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub97c \uc7a0\uae08 \ud574\uc81c\ud558\ub824\uba74 \uac8c\uc784\uc744 \ud1b5\ud574 \ucf54\uc778\uacfc \ubcf4\uc11d\uc744 \uc5bb\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc41 - \uc77c\uc77c \ucc4c\ub9b0\uc9c0\uc640 \ub9e4\uce58\ub97c \uc644\ub8cc\ud558\uc5ec \uc790\uc6d0\uc744 \ubaa8\uc73c\uc2ed\uc2dc\uc624. \ub2e8\uacc42 - '\ud50c\ub808\uc774\uc5b4 \uc0f5'\uc744 \ubc29\ubb38\ud558\uc5ec \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub97c \uad6c\ub9e4\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc43 - \ub3c5\uc810 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \uc774\ubca4\ud2b8\uc5d0 \ucc38\uc5ec\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\uc54c\ub9ac\uc6c1 \ud0b9'\uc740 \ud2b9\ubcc4 \uc774\ubca4\ud2b8 \uae30\uac04 \ub3d9\uc548 \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud2b8\ub808\uc774\ub529 \uce74\ub4dc\ub97c \ubaa8\uc73c\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uac01 \ud50c\ub808\uc774\uc5b4\ub294 \ud300\uc5d0 \uace0\uc720\ud55c \uac00\uce58\ub97c \ub354\ud569\ub2c8\ub2e4.]"}, {"question": "\ub18d\uad6c \uc2a4\ud0c0\uc758 \uce90\uc8fc\uc5bc \ub9e4\uce58\uc640 \ub7ad\ud06c \ub9e4\uce58\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub18d\uad6c \uc2a4\ud0c0\uc758 \uce90\uc8fc\uc5bc \ub9e4\uce58\uc640 \ub7ad\ud06c \ub9e4\uce58\ub294 \uc5ec\ub7ec \uac00\uc9c0 \uba74\uc5d0\uc11c \ub2e4\ub985\ub2c8\ub2e4. \ub2e8\uacc41 - \uce90\uc8fc\uc5bc \ub9e4\uce58\ub294 \uc5f0\uc2b5 \ubc0f \uc990\uac70\uc6c0\uc744 \uc704\ud55c \uac83\uc785\ub2c8\ub2e4. \ub7ad\ud06c \ub9e4\uce58\ub294 \ub9ac\ub354\ubcf4\ub4dc \uc21c\uc704\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ub2e8\uacc42 - \ub7ad\ud06c \ub9e4\uce58\ub294 \ub354 \ub192\uc740 \uae30\uc220 \uc218\uc900\uacfc \uc804\ub7b5\uc801 \ud50c\ub808\uc774\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc43 - \ub7ad\ud06c \ub9e4\uce58\uc758 \ubcf4\uc0c1\uc774 \ub354 \ud48d\uc131\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub7ad\ud06c \ub9e4\uce58\uc5d0\uc11c \uc774\uae30\uba74 \ub7ad\ud0b9\uc774 \ud06c\uac8c \uc0c1\uc2b9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: \uce90\uc8fc\uc5bc \ub9e4\uce58\ub294 \uc608\uc5f4\uacfc \uac19\uace0, \ub7ad\ud06c \ub9e4\uce58\ub294 \ubcf8 \uacbd\uae30\uc785\ub2c8\ub2e4.]"}, {"question": "\ub18d\uad6c \uc2a4\ud0c0\uc5d0\uc11c \uac00\uc7a5 \uac00\uce58 \uc788\ub294 \uac8c\uc784 \ub0b4 \ud1b5\ud654\ub294 \ubb34\uc5c7\uc774\uba70, \uc65c \uadf8\ub7f0\uac00\uc694?", "answer": "\ub18d\uad6c \uc2a4\ud0c0\uc5d0\uc11c \uac00\uc7a5 \uac00\uce58 \uc788\ub294 \uac8c\uc784 \ub0b4 \ud1b5\ud654\ub294 \ucf54\uc778\uacfc \ubcf4\uc11d\uc785\ub2c8\ub2e4. \ub2e8\uacc41 - \ucf54\uc778\uc740 \uae30\ubcf8 \uc5c5\uadf8\ub808\uc774\ub4dc \ubc0f \ud50c\ub808\uc774\uc5b4 \uad6c\ub9e4\uc5d0 \uc0ac\uc6a9\ub429\ub2c8\ub2e4. \ub2e8\uacc42 - \ubcf4\uc11d\uc740 \ub354 \ub4dc\ubb3c\uace0 \ud504\ub9ac\ubbf8\uc5c4 \ud50c\ub808\uc774\uc5b4 \ubc0f \uc544\uc774\ud15c\uc744 \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc43 - \uc774\ubca4\ud2b8\uc640 \ucc4c\ub9b0\uc9c0\ub97c \ud1b5\ud574 \ubcf4\uc11d\uc744 \uc5bb\ub294 \ub370 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\uc804\uc124 \ud50c\ub808\uc774\uc5b4 \ud328\ud0a4\uc9c0'\ub294 \ubcf4\uc11d\uc73c\ub85c\ub9cc \uad6c\ub9e4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \ucf54\uc778\uacfc \ubcf4\uc11d\uc758 \uc0ac\uc6a9\ubc95 \ubc0f \ud68d\ub4dd \ubc29\ubc95\uc744 \ube44\uad50\ud558\uc5ec \ud6a8\uacfc\uc801\uc73c\ub85c \uc6b0\uc120\uc21c\uc704\ub97c \uc815\ud558\uc2ed\uc2dc\uc624.]"}, {"question": "\ub18d\uad6c \uc2a4\ud0c0\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "\ub18d\uad6c \uc2a4\ud0c0\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \uae30\uc220 \uc218\uc900\uacfc \ub7ad\ud0b9\uc744 \uae30\uc900\uc73c\ub85c \ud50c\ub808\uc774\uc5b4\ub97c \ud398\uc5b4\ub9c1\ud569\ub2c8\ub2e4. \ub2e8\uacc41 - \uc2dc\uc2a4\ud15c\uc740 \ucd5c\uadfc \uc131\uacfc\uc640 \uc2b9/\ud328 \ube44\uc728\uc744 \ud3c9\uac00\ud569\ub2c8\ub2e4. \ub2e8\uacc42 - \uacf5\uc815\ud55c \uacbd\uae30\ub97c \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 \uc720\uc0ac\ud55c \ud1b5\uacc4\ub97c \uac00\uc9c4 \ud50c\ub808\uc774\uc5b4\uc640 \ub9e4\uce6d\ud569\ub2c8\ub2e4. \ub2e8\uacc43 - \ub7ad\ud0b9\uc774 \ub192\uc740 \ud50c\ub808\uc774\uc5b4\ub294 \ub354 \uac15\ub825\ud55c \uc0c1\ub300\ub97c \ub9cc\ub0a9\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc2b9\ub960\uc774 70%\uc778 \ud50c\ub808\uc774\uc5b4\ub294 \uc720\uc0ac\ud55c \uae30\uc220 \uc218\uc900\uc758 \uc0c1\ub300\ub97c \ub9cc\ub0a9\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \ud50c\ub808\uc774\uc5b4 \ud1b5\uacc4 \u2192 \ub9e4\uce6d \uc54c\uace0\ub9ac\uc998 \u2192 \uc0c1\ub300 \uc120\ud0dd\uc758 \ud750\ub984\uc744 \uc774\ud574\ud558\uc2ed\uc2dc\uc624.]"}, {"question": "\ubaa8\ubc14\uc77c\uc5d0\uc11c PC\ub85c \ub18d\uad6c \uc2a4\ud0c0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub124, \ubaa8\ubc14\uc77c\uc5d0\uc11c PC\ub85c \ub18d\uad6c \uc2a4\ud0c0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc41 - \ub450 \uae30\uae30 \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc42 - \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc43 - \ud50c\ub808\uc774\uc5b4 \ud1b5\uacc4 \ubc0f \uc544\uc774\ud15c\uc744 \ud655\uc778\ud558\uc5ec \uc774\uc804\uc744 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\ub369\ud06c \ub9c8\uc2a4\ud130' \ud50c\ub808\uc774\uc5b4\uc640 \ucd95\uc801\ub41c \ucf54\uc778\uc740 \ub450 \ud50c\ub7ab\ud3fc \ubaa8\ub450\uc5d0 \ud45c\uc2dc\ub418\uc5b4\uc57c \ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc0c8\ub85c\uc6b4 \uc9d1\uc73c\ub85c \uc18c\uc9c0\ud488\uc744 \uc62e\uae30\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ubaa8\ub4e0 \uac83\uc774 \uc81c\uc790\ub9ac\uc5d0 \uc788\uc5b4\uc57c \ud569\ub2c8\ub2e4.]"}, {"question": "\ub18d\uad6c \uc2a4\ud0c0\uc5d0\uc11c \uc228\uaca8\uc9c4 \uc5c5\uc801\uc744 \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub18d\uad6c \uc2a4\ud0c0\uc5d0\ub294 \uace0\uc720\ud55c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ubcf4\uc0c1\ud558\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uc5c5\uc801\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc41 - '\ub369\ud06c \ud0b9'\uc744 \uc7a0\uae08 \ud574\uc81c\ud558\ub824\uba74 \uc131\uacf5\uc801\uc778 \ub369\ud06c\ub97c \ud2b9\uc815 \uc218\ub9cc\ud07c \uc218\ud589\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc42 - \uc29b\uc744 \ub193\uce58\uc9c0 \uc54a\uace0 \ub9e4\uce58\ub97c \uc774\uae30\uba74 '\uc644\ubcbd \uac8c\uc784'\uc744 \ud68d\ub4dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc43 - \ud55c \ub9e4\uce58\uc5d0\uc11c 10\uac1c\uc758 \uc29b\uc744 \ucc28\ub2e8\ud558\uba74 '\ubc29\uc5b4\uc758 \ubcbd'\uc744 \ud68d\ub4dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc644\ubcbd \uac8c\uc784'\uc744 \ub2ec\uc131\ud558\uba74 \ub3c5\uc810 \ud50c\ub808\uc774\uc5b4 \uc2a4\ud0a8\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uc744 \ucc3e\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc5f4\uc2ec\ud788 \ub178\ub825\ud558\ub294 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \uc228\uaca8\uc9c4 \ubcf4\uc0c1\uc785\ub2c8\ub2e4.]"}, {"question": "\ub18d\uad6c \uc2a4\ud0c0\uc5d0\uc11c \uacbd\uc7c1 \ud50c\ub808\uc774\ub97c \uc704\ud574 \ud50c\ub808\uc774\uc5b4\uc758 \ud1b5\uacc4\ub97c \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub18d\uad6c \uc2a4\ud0c0\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uc758 \ud1b5\uacc4\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc804\ub7b5\uc801\uc778 \uc5c5\uadf8\ub808\uc774\ub4dc\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc41 - '\uc288\ud305 \uc815\ud655\ub3c4'\uc640 '\uc18d\ub3c4'\uc640 \uac19\uc740 \uc8fc\uc694 \ud1b5\uacc4\uc5d0 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc42 - \ucf54\uc778\uacfc \ubcf4\uc11d\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud1b5\uacc4\ub97c \ub192\uc774\uc2ed\uc2dc\uc624. \ub2e8\uacc43 - \ud2b9\uc815 \ub2a5\ub825\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \uc544\uc774\ud15c\uc744 \uc7a5\ube44\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\uc18d\ub3c4 \uc2e0\ubc1c' \uc544\uc774\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uc758 \uc774\ub3d9 \uc18d\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \uae30\ubcf8 \ud1b5\uacc4\uc640 \uc5c5\uadf8\ub808\uc774\ub4dc\ub41c \ud1b5\uacc4\ub97c \ube44\uad50\ud558\uc5ec \ud5a5\uc0c1\uc758 \uc601\ud5a5\uc744 \ud655\uc778\ud558\uc2ed\uc2dc\uc624.]"}]
[{"question": "\u042f\u043a \u044f \u043c\u043e\u0436\u0443 \u0432\u0438\u043a\u043e\u043d\u0430\u0442\u0438 slam dunk \u0443 Basketball Stars \u044f\u043a \u043d\u043e\u0432\u0430\u0447\u043e\u043a?", "answer": "\u0429\u043e\u0431 \u0432\u0438\u043a\u043e\u043d\u0430\u0442\u0438 slam dunk \u0443 Basketball Stars, \u0432\u0438\u043a\u043e\u043d\u0430\u0439\u0442\u0435 \u0442\u0430\u043a\u0456 \u0434\u0456\u0457: \u041a\u0420\u041e\u041a 1 \u2013 \u0420\u043e\u0437\u0442\u0430\u0448\u0443\u0439\u0442\u0435 \u0441\u0432\u043e\u0433\u043e \u0433\u0440\u0430\u0432\u0446\u044f \u0431\u0456\u043b\u044f \u043a\u043e\u0448\u0438\u043a\u0430. \u041a\u0420\u041e\u041a 2 \u2013 \u041f\u0440\u043e\u0432\u0435\u0434\u0456\u0442\u044c \u043f\u0430\u043b\u044c\u0446\u0435\u043c \u0432\u0433\u043e\u0440\u0443 \u043f\u043e \u0435\u043a\u0440\u0430\u043d\u0443 \u0437 \u0434\u043e\u0441\u0442\u0430\u0442\u043d\u044c\u043e\u044e \u0441\u0438\u043b\u043e\u044e. \u041a\u0420\u041e\u041a 3 \u2013 \u0412\u0456\u0434\u043f\u0443\u0441\u0442\u0456\u0442\u044c \u0443 \u043d\u0430\u0439\u0432\u0438\u0449\u0456\u0439 \u0442\u043e\u0447\u0446\u0456 \u0441\u0442\u0440\u0438\u0431\u043a\u0430 \u0434\u043b\u044f \u0443\u0441\u043f\u0456\u0448\u043d\u043e\u0433\u043e dunk. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0440\u0443\u0445\u0443 \u00abPower Dunk\u00bb \u0433\u0440\u0430\u0432\u0446\u0435\u043c \u00abDunk Master\u00bb \u0437\u0431\u0456\u043b\u044c\u0448\u0443\u0454 \u0432\u0430\u0448\u0456 \u0448\u0430\u043d\u0441\u0438 \u043d\u0430 \u043f\u043e\u0442\u0440\u0430\u043f\u043b\u044f\u043d\u043d\u044f. [\u041f\u0440\u0438\u043a\u043b\u0430\u0434: \u0423\u044f\u0432\u0456\u0442\u044c \u0441\u043e\u0431\u0456 \u0437\u0430\u043f\u0443\u0441\u043a \u0440\u0430\u043a\u0435\u0442\u0438 \u2013 \u0447\u0430\u0441 \u0456 \u0441\u0438\u043b\u0430 \u0454 \u043a\u0440\u0438\u0442\u0438\u0447\u043d\u043e \u0432\u0430\u0436\u043b\u0438\u0432\u0438\u043c\u0438.]"}, {"question": "\u042f\u043a\u0456 \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0456 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0457 \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u043c\u043e\u0433\u0438 \u0432 \u043c\u0430\u0442\u0447\u0430\u0445 1 \u043d\u0430 1 \u0443 Basketball Stars?", "answer": "\u041f\u0435\u0440\u0435\u043c\u043e\u0433\u0430 \u0432 \u043c\u0430\u0442\u0447\u0430\u0445 1 \u043d\u0430 1 \u0443 Basketball Stars \u043f\u043e\u0442\u0440\u0435\u0431\u0443\u0454 \u043f\u043e\u0454\u0434\u043d\u0430\u043d\u043d\u044f \u043d\u0430\u0441\u0442\u0443\u043f\u0443 \u0442\u0430 \u043e\u0431\u043e\u0440\u043e\u043d\u0438. \u041a\u0420\u041e\u041a 1 \u2013 \u041e\u043f\u0430\u043d\u0443\u0439\u0442\u0435 \u0441\u043f\u0435\u0446\u0456\u0430\u043b\u044c\u043d\u0456 \u0440\u0443\u0445\u0438 \u0441\u0432\u043e\u0433\u043e \u0433\u0440\u0430\u0432\u0446\u044f, \u0442\u0430\u043a\u0456 \u044f\u043a \u00abCrossover\u00bb \u0430\u0431\u043e \u00abStep Back\u00bb. \u041a\u0420\u041e\u041a 2 \u2013 \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0444\u0435\u0439\u043a\u043e\u0432\u0456 \u043a\u0438\u0434\u043a\u0438, \u0449\u043e\u0431 \u0432\u0432\u0435\u0441\u0442\u0438 \u0432 \u043e\u043c\u0430\u043d\u0443 \u043e\u043f\u043e\u043d\u0435\u043d\u0442\u0430. \u041a\u0420\u041e\u041a 3 \u2013 \u0417\u0430\u0432\u0436\u0434\u0438 \u0431\u043b\u043e\u043a\u0443\u0439\u0442\u0435 \u043a\u0438\u0434\u043a\u0438, \u043f\u0440\u043e\u0432\u043e\u0434\u044f\u0447\u0438 \u043f\u0430\u043b\u044c\u0446\u0435\u043c \u0443 \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u0438\u0439 \u043c\u043e\u043c\u0435\u043d\u0442. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0433\u0440\u0430\u0432\u0435\u0446\u044c \u00abBlock King\u00bb \u0432\u0456\u0434\u043c\u0456\u043d\u043d\u043e \u0432\u0438\u043a\u043e\u043d\u0443\u0454 \u0437\u0430\u0445\u0438\u0441\u0442. [\u041f\u043e\u0440\u0456\u0432\u043d\u044f\u043d\u043d\u044f \u0432\u0430\u0440\u0456\u0430\u043d\u0442\u0456\u0432: \u0413\u0440\u0430\u0432\u0446\u0456 \u043d\u0430\u0441\u0442\u0443\u043f\u0443, \u0442\u0430\u043a\u0456 \u044f\u043a \u00abShooting Star\u00bb, \u0456\u0434\u0435\u0430\u043b\u044c\u043d\u043e \u043f\u0456\u0434\u0445\u043e\u0434\u044f\u0442\u044c \u0434\u043b\u044f \u043d\u0430\u0431\u0438\u0440\u0430\u043d\u043d\u044f \u043e\u0447\u043e\u043a, \u0442\u043e\u0434\u0456 \u044f\u043a \u0433\u0440\u0430\u0432\u0446\u0456 \u043e\u0431\u043e\u0440\u043e\u043d\u0438, \u0442\u0430\u043a\u0456 \u044f\u043a \u00abBlock King\u00bb, \u043a\u0440\u0430\u0449\u0435 \u0437\u0443\u043f\u0438\u043d\u044f\u044e\u0442\u044c \u0441\u0443\u043f\u0435\u0440\u043d\u0438\u043a\u0456\u0432.]"}, {"question": "\u0427\u043e\u043c\u0443 \u043c\u0456\u0439 \u0433\u0440\u0430\u0432\u0435\u0446\u044c \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u0454 \u043b\u0435\u0433\u043a\u0456 \u043a\u0438\u0434\u043a\u0438 \u0443 Basketball Stars?", "answer": "\u041f\u0440\u043e\u043f\u0443\u0449\u0435\u043d\u043d\u044f \u043b\u0435\u0433\u043a\u0438\u0445 \u043a\u0438\u0434\u043a\u0456\u0432 \u0443 Basketball Stars \u043c\u043e\u0436\u0435 \u0431\u0443\u0442\u0438 \u043f\u043e\u0432'\u044f\u0437\u0430\u043d\u043e \u0437 \u043a\u0456\u043b\u044c\u043a\u043e\u043c\u0430 \u0444\u0430\u043a\u0442\u043e\u0440\u0430\u043c\u0438. \u041a\u0420\u041e\u041a 1 \u2013 \u041f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e \u0443 \u0432\u0430\u0448\u043e\u0433\u043e \u0433\u0440\u0430\u0432\u0446\u044f \u0432\u0438\u0441\u043e\u043a\u0438\u0439 \u0440\u0456\u0432\u0435\u043d\u044c \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043b\u043e\u0441\u0442\u0456; \u043d\u0438\u0437\u044c\u043a\u0430 \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043b\u0456\u0441\u0442\u044c \u0432\u043f\u043b\u0438\u0432\u0430\u0454 \u043d\u0430 \u0442\u043e\u0447\u043d\u0456\u0441\u0442\u044c. \u041a\u0420\u041e\u041a 2 \u2013 \u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u043b\u0456\u0447\u0438\u043b\u044c\u043d\u0438\u043a \u043a\u0438\u0434\u043a\u0430; \u0437\u0430\u043d\u0430\u0434\u0442\u043e \u0448\u0432\u0438\u0434\u043a\u0435 \u0430\u0431\u043e \u043f\u0456\u0437\u043d\u0454 \u0432\u0456\u0434\u043f\u0443\u0441\u043a\u0430\u043d\u043d\u044f \u043f\u0440\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u044c \u0434\u043e \u043f\u0440\u043e\u043c\u0430\u0445\u0443. \u041a\u0420\u041e\u041a 3 \u2013 \u041e\u043d\u043e\u0432\u0456\u0442\u044c \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443 \u0441\u0442\u0440\u0456\u043b\u044c\u0431\u0438 \u0441\u0432\u043e\u0433\u043e \u0433\u0440\u0430\u0432\u0446\u044f. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0433\u0440\u0430\u0432\u0435\u0446\u044c \u00abSharp Shooter\u00bb \u043c\u0430\u0454 \u0432\u0438\u0449\u0438\u0439 \u043f\u043e\u043a\u0430\u0437\u043d\u0438\u043a \u0443\u0441\u043f\u0456\u0448\u043d\u043e\u0441\u0442\u0456. [\u0422\u0430\u0431\u043b\u0438\u0446\u044f \u043a\u043e\u043d\u0444\u0456\u0433\u0443\u0440\u0430\u0446\u0456\u0439: \u041f\u043e\u0440\u0456\u0432\u043d\u044f\u0439\u0442\u0435 \u043f\u043e\u043a\u0430\u0437\u043d\u0438\u043a\u0438, \u0442\u0430\u043a\u0456 \u044f\u043a \u00ab\u0422\u043e\u0447\u043d\u0456\u0441\u0442\u044c \u0441\u0442\u0440\u0456\u043b\u044c\u0431\u0438\u00bb \u0442\u0430 \u00ab\u0412\u0438\u0442\u0440\u0438\u0432\u0430\u043b\u0456\u0441\u0442\u044c\u00bb, \u0449\u043e\u0431 \u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c.]"}, {"question": "\u042f\u043a \u0440\u043e\u0437\u0431\u043b\u043e\u043a\u0443\u0432\u0430\u0442\u0438 \u043d\u043e\u0432\u0438\u0445 \u0433\u0440\u0430\u0432\u0446\u0456\u0432 \u0443 Basketball Stars?", "answer": "\u0420\u043e\u0437\u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u043e\u0432\u0438\u0445 \u0433\u0440\u0430\u0432\u0446\u0456\u0432 \u0443 Basketball Stars \u043f\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0430\u0454 \u0437\u0430\u0440\u043e\u0431\u043b\u044f\u043d\u043d\u044f \u043c\u043e\u043d\u0435\u0442 \u0456 \u0434\u043e\u0440\u043e\u0433\u043e\u0446\u0456\u043d\u043d\u0438\u0445 \u043a\u0430\u043c\u0435\u043d\u0456\u0432 \u0443 \u0433\u0440\u0456. \u041a\u0420\u041e\u041a 1 \u2013 \u0412\u0438\u043a\u043e\u043d\u0443\u0439\u0442\u0435 \u0449\u043e\u0434\u0435\u043d\u043d\u0456 \u0437\u0430\u0432\u0434\u0430\u043d\u043d\u044f \u0442\u0430 \u043f\u043e\u0454\u0434\u0438\u043d\u043a\u0438, \u0449\u043e\u0431 \u0437\u0456\u0431\u0440\u0430\u0442\u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u0438. \u041a\u0420\u041e\u041a 2 \u2013 \u0412\u0456\u0434\u0432\u0456\u0434\u0430\u0439\u0442\u0435 \u00ab\u041c\u0430\u0433\u0430\u0437\u0438\u043d \u0433\u0440\u0430\u0432\u0446\u0456\u0432\u00bb, \u0449\u043e\u0431 \u043f\u0440\u0438\u0434\u0431\u0430\u0442\u0438 \u043d\u043e\u0432\u0438\u0445 \u0433\u0440\u0430\u0432\u0446\u0456\u0432. \u041a\u0420\u041e\u041a 3 \u2013 \u0411\u0435\u0440\u0456\u0442\u044c \u0443\u0447\u0430\u0441\u0442\u044c \u0443 \u0437\u0430\u0445\u043e\u0434\u0430\u0445 \u0434\u043b\u044f \u043e\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f \u0435\u043a\u0441\u043a\u043b\u044e\u0437\u0438\u0432\u043d\u0438\u0445 \u0433\u0440\u0430\u0432\u0446\u0456\u0432. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u00abAlley-Oop King\u00bb \u043c\u043e\u0436\u043d\u0430 \u0440\u043e\u0437\u0431\u043b\u043e\u043a\u0443\u0432\u0430\u0442\u0438 \u043f\u0456\u0434 \u0447\u0430\u0441 \u0441\u043f\u0435\u0446\u0456\u0430\u043b\u044c\u043d\u0438\u0445 \u0437\u0430\u0445\u043e\u0434\u0456\u0432. [\u041f\u0440\u0438\u043a\u043b\u0430\u0434: \u041c\u043e\u0436\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u0442\u0438, \u0446\u0435 \u043f\u043e\u0434\u0456\u0431\u043d\u043e \u0434\u043e \u0437\u0431\u0438\u0440\u0430\u043d\u043d\u044f \u043a\u0430\u0440\u0442\u0438\u043d\u043e\u043a \u2013 \u043a\u043e\u0436\u0435\u043d \u0433\u0440\u0430\u0432\u0435\u0446\u044c \u0434\u043e\u0434\u0430\u0454 \u0443\u043d\u0456\u043a\u0430\u043b\u044c\u043d\u0443 \u0446\u0456\u043d\u043d\u0456\u0441\u0442\u044c \u0432\u0430\u0448\u0456\u0439 \u043a\u043e\u043c\u0430\u043d\u0434\u0456.]"}, {"question": "\u042f\u043a\u0456 \u043a\u043b\u044e\u0447\u043e\u0432\u0456 \u0432\u0456\u0434\u043c\u0456\u043d\u043d\u043e\u0441\u0442\u0456 \u043c\u0456\u0436 \u0432\u0438\u043f\u0430\u0434\u043a\u043e\u0432\u0438\u043c\u0438 \u0442\u0430 \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u043e\u0432\u0438\u043c\u0438 \u0456\u0433\u0440\u0430\u043c\u0438 \u0432 Basketball Stars?", "answer": "\u0412\u0438\u043f\u0430\u0434\u043a\u043e\u0432\u0456 \u0442\u0430 \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u043e\u0432\u0456 \u043c\u0430\u0442\u0447\u0456 \u0443 Basketball Stars \u0432\u0456\u0434\u0440\u0456\u0437\u043d\u044f\u044e\u0442\u044c\u0441\u044f \u043a\u0456\u043b\u044c\u043a\u043e\u043c\u0430 \u0441\u043f\u043e\u0441\u043e\u0431\u0430\u043c\u0438. \u041a\u0420\u041e\u041a 1 \u2013 \u0412\u0438\u043f\u0430\u0434\u043a\u043e\u0432\u0456 \u043c\u0430\u0442\u0447\u0456 \u0440\u043e\u0437\u0440\u0430\u0445\u043e\u0432\u0430\u043d\u0456 \u043d\u0430 \u0442\u0440\u0435\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u0430 \u0440\u043e\u0437\u0432\u0430\u0433\u0438, \u0430 \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u043e\u0432\u0456 \u043c\u0430\u0442\u0447\u0456 \u0432\u043f\u043b\u0438\u0432\u0430\u044e\u0442\u044c \u043d\u0430 \u0432\u0430\u0448\u0443 \u043f\u043e\u0437\u0438\u0446\u0456\u044e \u0432 \u0442\u0430\u0431\u043b\u0438\u0446\u0456 \u043b\u0456\u0434\u0435\u0440\u0456\u0432. \u041a\u0420\u041e\u041a 2 \u2013 \u0420\u0435\u0439\u0442\u0438\u043d\u0433\u043e\u0432\u0456 \u043c\u0430\u0442\u0447\u0456 \u0432\u0438\u043c\u0430\u0433\u0430\u044e\u0442\u044c \u0432\u0438\u0449\u043e\u0433\u043e \u0440\u0456\u0432\u043d\u044f \u043d\u0430\u0432\u0438\u0447\u043e\u043a \u0442\u0430 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0447\u043d\u043e\u0433\u043e \u043c\u0438\u0441\u043b\u0435\u043d\u043d\u044f. \u041a\u0420\u041e\u041a 3 \u2013 \u041d\u0430\u0433\u043e\u0440\u043e\u0434\u0438 \u0432 \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u043e\u0432\u0438\u0445 \u043c\u0430\u0442\u0447\u0430\u0445 \u0437\u043d\u0430\u0447\u043d\u043e \u0431\u0456\u043b\u044c\u0448\u0456. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043f\u0435\u0440\u0435\u043c\u043e\u0433\u0430 \u0432 \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u043e\u0432\u043e\u043c\u0443 \u043c\u0430\u0442\u0447\u0456 \u043c\u043e\u0436\u0435 \u0437\u043d\u0430\u0447\u043d\u043e \u043f\u0456\u0434\u0432\u0438\u0449\u0438\u0442\u0438 \u0432\u0430\u0448 \u0440\u0435\u0439\u0442\u0438\u043d\u0433. [\u041f\u043e\u0440\u0456\u0432\u043d\u044f\u043d\u043d\u044f \u0432\u0430\u0440\u0456\u0430\u043d\u0442\u0456\u0432: \u0412\u0438\u043f\u0430\u0434\u043a\u043e\u0432\u0456 \u043c\u0430\u0442\u0447\u0456 \u2013 \u0446\u0435 \u0440\u043e\u0437\u043c\u0438\u043d\u043a\u0430, \u0442\u043e\u0434\u0456 \u044f\u043a \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u043e\u0432\u0456 \u043c\u0430\u0442\u0447\u0456 \u2013 \u0433\u043e\u043b\u043e\u0432\u043d\u0435 \u043f\u043e\u0434\u0456\u044f.]"}, {"question": "\u042f\u043a\u0456 \u0432 \u0433\u0440\u0456 \u0432\u0430\u043b\u044e\u0442\u0438 \u0454 \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448 \u0446\u0456\u043d\u043d\u0438\u043c\u0438 \u0432 Basketball Stars \u0456 \u0447\u043e\u043c\u0443?", "answer": "\u041d\u0430\u0439\u0431\u0456\u043b\u044c\u0448 \u0446\u0456\u043d\u043d\u0438\u043c\u0438 \u0432\u0430\u043b\u044e\u0442\u0430\u043c\u0438 \u0432 \u0433\u0440\u0456 Basketball Stars \u0454 \u043c\u043e\u043d\u0435\u0442\u0438 \u0442\u0430 \u0434\u043e\u0440\u043e\u0433\u043e\u0446\u0456\u043d\u043d\u0456 \u043a\u0430\u043c\u0435\u043d\u0456. \u041a\u0420\u041e\u041a 1 \u2013 \u041c\u043e\u043d\u0435\u0442\u0438 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u044e\u0442\u044c\u0441\u044f \u0434\u043b\u044f \u0431\u0430\u0437\u043e\u0432\u0438\u0445 \u043e\u043d\u043e\u0432\u043b\u0435\u043d\u044c \u0442\u0430 \u043f\u0440\u0438\u0434\u0431\u0430\u043d\u043d\u044f \u0433\u0440\u0430\u0432\u0446\u0456\u0432. \u041a\u0420\u041e\u041a 2 \u2013 \u0414\u043e\u0440\u043e\u0433\u043e\u0446\u0456\u043d\u043d\u0456 \u043a\u0430\u043c\u0435\u043d\u0456 \u0440\u0456\u0434\u043a\u0456\u0441\u043d\u0456\u0448\u0456 \u0442\u0430 \u043c\u043e\u0436\u0443\u0442\u044c \u0440\u043e\u0437\u0431\u043b\u043e\u043a\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u043f\u0440\u0435\u043c\u0456\u0430\u043b\u044c\u043d\u0438\u0445 \u0433\u0440\u0430\u0432\u0446\u0456\u0432 \u0442\u0430 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0438. \u041a\u0420\u041e\u041a 3 \u2013 \u041f\u0440\u0438\u0434\u0456\u043b\u044f\u0439\u0442\u0435 \u043f\u0440\u0456\u043e\u0440\u0456\u0442\u0435\u0442 \u0437\u0430\u0440\u043e\u0431\u043b\u0435\u043d\u043d\u044e \u0434\u043e\u0440\u043e\u0433\u043e\u0446\u0456\u043d\u043d\u0438\u0445 \u043a\u0430\u043c\u0435\u043d\u0456\u0432 \u043f\u0456\u0434 \u0447\u0430\u0441 \u0437\u0430\u0445\u043e\u0434\u0456\u0432 \u0442\u0430 \u0437\u0430\u0432\u0434\u0430\u043d\u044c. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u00ab\u041b\u0435\u0433\u0435\u043d\u0434\u0430\u0440\u043d\u0438\u0439 \u043f\u0430\u043a\u0435\u0442 \u0433\u0440\u0430\u0432\u0446\u0456\u0432\u00bb \u043c\u043e\u0436\u043d\u0430 \u043f\u0440\u0438\u0434\u0431\u0430\u0442\u0438 \u043b\u0438\u0448\u0435 \u0437\u0430 \u0434\u043e\u0440\u043e\u0433\u043e\u0446\u0456\u043d\u043d\u0456 \u043a\u0430\u043c\u0435\u043d\u0456. [\u0422\u0430\u0431\u043b\u0438\u0446\u044f \u043a\u043e\u043d\u0444\u0456\u0433\u0443\u0440\u0430\u0446\u0456\u0439: \u041f\u043e\u0440\u0456\u0432\u043d\u044f\u0439\u0442\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0442\u0430 \u043c\u0435\u0442\u043e\u0434\u0438 \u043f\u0440\u0438\u0434\u0431\u0430\u043d\u043d\u044f \u043c\u043e\u043d\u0435\u0442 \u0442\u0430 \u0434\u043e\u0440\u043e\u0433\u043e\u0446\u0456\u043d\u043d\u0438\u0445 \u043a\u0430\u043c\u0435\u043d\u0456\u0432, \u0449\u043e\u0431 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u0440\u043e\u0437\u0441\u0442\u0430\u0432\u043b\u044f\u0442\u0438 \u043f\u0440\u0456\u043e\u0440\u0438\u0442\u0435\u0442\u0438.]"}, {"question": "\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u043f\u0456\u0434\u0431\u043e\u0440\u0443 \u0433\u0440\u0430\u0432\u0446\u0456\u0432 \u0443 Basketball Stars?", "answer": "\u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u043f\u0456\u0434\u0431\u043e\u0440\u0443 \u0433\u0440\u0430\u0432\u0446\u0456\u0432 \u0443 Basketball Stars \u0437\u2019\u0454\u0434\u043d\u0443\u0454 \u0433\u0440\u0430\u0432\u0446\u0456\u0432 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0456 \u0440\u0456\u0432\u043d\u044f \u043d\u0430\u0432\u0438\u0447\u043e\u043a \u0442\u0430 \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0443. \u041a\u0420\u041e\u041a 1 \u2013 \u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u043e\u0446\u0456\u043d\u044e\u0454 \u0432\u0430\u0448\u0456 \u043e\u0441\u0442\u0430\u043d\u043d\u0456 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0438 \u0442\u0430 \u043a\u043e\u0435\u0444\u0456\u0446\u0456\u0454\u043d\u0442 \u043f\u0435\u0440\u0435\u043c\u043e\u0433/\u043f\u043e\u0440\u0430\u0437\u043e\u043a. \u041a\u0420\u041e\u041a 2 \u2013 \u0412\u043e\u043d\u0430 \u0437\u2019\u0454\u0434\u043d\u0443\u0454 \u0432\u0430\u0441 \u0437 \u0433\u0440\u0430\u0432\u0446\u044f\u043c\u0438, \u044f\u043a\u0456 \u043c\u0430\u044e\u0442\u044c \u043f\u043e\u0434\u0456\u0431\u043d\u0456 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438, \u0449\u043e\u0431 \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0438\u0442\u0438 \u0447\u0435\u0441\u043d\u0443 \u0433\u0440\u0443. \u041a\u0420\u041e\u041a 3 \u2013 \u0413\u0440\u0430\u0432\u0446\u0456 \u0437 \u0432\u0438\u0449\u0438\u043c \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u043e\u043c \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u044e\u0442\u044c\u0441\u044f \u0437 \u0441\u0438\u043b\u044c\u043d\u0456\u0448\u0438\u043c\u0438 \u043e\u043f\u043e\u043d\u0435\u043d\u0442\u0430\u043c\u0438. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0433\u0440\u0430\u0432\u0435\u0446\u044c \u0437 70% \u043f\u0435\u0440\u0435\u043c\u043e\u0433 \u043c\u0430\u0442\u0438\u043c\u0435 \u0441\u0443\u043f\u0435\u0440\u043d\u0438\u043a\u0456\u0432 \u0437 \u043f\u0440\u0438\u0431\u043b\u0438\u0437\u043d\u043e \u0442\u0430\u043a\u0438\u043c\u0438 \u0436 \u043d\u0430\u0432\u0438\u0447\u043a\u0430\u043c\u0438. [\u0421\u0445\u0435\u043c\u0430 \u043f\u043e\u0442\u043e\u043a\u0443: \u041f\u043e\u0440\u043e\u0437\u0443\u043c\u0456\u0439\u0442\u0435 \u043f\u0435\u0440\u0435\u0431\u0456\u0433 \u0432\u0456\u0434 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0438 \u0433\u0440\u0430\u0432\u0446\u044f \u2192 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c\u0443 \u043f\u0456\u0434\u0431\u043e\u0440\u0443 \u0443\u0447\u0430\u0441\u043d\u0438\u043a\u0456\u0432 \u2192 \u0432\u0438\u0431\u043e\u0440\u0443 \u043e\u043f\u043e\u043d\u0435\u043d\u0442\u0430.]"}, {"question": "\u0427\u0438 \u043c\u043e\u0436\u0443 \u044f \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0442\u0438 \u0441\u0432\u0456\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441 \u0443 Basketball Stars \u0437 \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u043e\u0433\u043e \u043d\u0430 \u041f\u041a?", "answer": "\u0422\u0430\u043a, \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0442\u0438 \u0441\u0432\u0456\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441 \u0443 Basketball Stars \u0437 \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u043e\u0433\u043e \u043d\u0430 \u041f\u041a. \u041a\u0420\u041e\u041a 1 \u2013 \u041f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e \u0432\u0438 \u0443\u0432\u0456\u0439\u0448\u043b\u0438 \u0434\u043e \u0442\u0456\u0454\u0457 \u0436 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u043e\u0433\u043e \u0437\u0430\u043f\u0438\u0441\u0443 \u043d\u0430 \u043e\u0431\u043e\u0445 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044f\u0445. \u041a\u0420\u041e\u041a 2 \u2013 \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0444\u0443\u043d\u043a\u0446\u0456\u0457 \u0445\u043c\u0430\u0440\u043d\u043e\u0433\u043e \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f \u0434\u043b\u044f \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0456\u0437\u0430\u0446\u0456\u0457 \u0432\u0430\u0448\u043e\u0433\u043e \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0443. \u041a\u0420\u041e\u041a 3 \u2013 \u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0435\u043d\u043d\u044f, \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0432\u0448\u0438 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443 \u0441\u0432\u043e\u0433\u043e \u0433\u0440\u0430\u0432\u0446\u044f \u0442\u0430 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0438. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0432\u0430\u0448 \u0433\u0440\u0430\u0432\u0435\u0446\u044c \u00abDunk Master\u00bb \u0442\u0430 \u043d\u0430\u043a\u043e\u043f\u0438\u0447\u0435\u043d\u0456 \u043c\u043e\u043d\u0435\u0442\u0438 \u043f\u043e\u0432\u0438\u043d\u043d\u0456 \u0437\u2019\u044f\u0432\u0438\u0442\u0438\u0441\u044f \u043d\u0430 \u043e\u0431\u043e\u0445 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430\u0445. [\u041f\u0440\u0438\u043a\u043b\u0430\u0434: \u041c\u043e\u0436\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u0442\u0438, \u0449\u043e \u0446\u0435 \u043f\u043e\u0434\u0456\u0431\u043d\u043e \u0434\u043e \u043f\u0435\u0440\u0435\u0432\u0435\u0437\u0435\u043d\u043d\u044f \u0440\u0435\u0447\u0435\u0439 \u0443 \u043d\u043e\u0432\u0435 \u0436\u0438\u0442\u043b\u043e \u2013 \u0432\u0441\u0435 \u043c\u0430\u0454 \u0431\u0443\u0442\u0438 \u043d\u0430 \u043c\u0456\u0441\u0446\u0456.]"}, {"question": "\u042f\u043a\u0456 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u044f \u043c\u043e\u0436\u0443 \u0440\u043e\u0437\u0431\u043b\u043e\u043a\u0443\u0432\u0430\u0442\u0438 \u0443 Basketball Stars?", "answer": "Basketball Stars \u043c\u0430\u0454 \u043a\u0456\u043b\u044c\u043a\u0430 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0438\u0445 \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u044c, \u044f\u043a\u0456 \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0436\u0443\u044e\u0442\u044c \u0443\u043d\u0456\u043a\u0430\u043b\u044c\u043d\u0443 \u0433\u0440\u0443. \u041a\u0420\u041e\u041a 1 \u2013 \u0412\u0438\u043a\u043e\u043d\u0430\u0439\u0442\u0435 \u043f\u0435\u0432\u043d\u0443 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u0443\u0441\u043f\u0456\u0448\u043d\u0438\u0445 dunk, \u0449\u043e\u0431 \u0440\u043e\u0437\u0431\u043b\u043e\u043a\u0443\u0432\u0430\u0442\u0438 \u00abDunk King\u00bb. \u041a\u0420\u041e\u041a 2 \u2013 \u0412\u0438\u0433\u0440\u0430\u0439\u0442\u0435 \u043c\u0430\u0442\u0447 \u0431\u0435\u0437 \u043f\u0440\u043e\u043c\u0430\u0445\u0443, \u0449\u043e\u0431 \u0437\u0430\u0440\u043e\u0431\u0438\u0442\u0438 \u00abPerfect Game\u00bb. \u041a\u0420\u041e\u041a 3 \u2013 \u0417\u0430\u0431\u043b\u043e\u043a\u0443\u0439\u0442\u0435 10 \u043a\u0438\u0434\u043a\u0456\u0432 \u0443 \u043e\u0434\u043d\u043e\u043c\u0443 \u043c\u0430\u0442\u0447\u0456, \u0449\u043e\u0431 \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u00abWall of Defense\u00bb. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u00abPerfect Game\u00bb \u043d\u0430\u0434\u0430\u0454 \u0432\u0430\u043c \u0435\u043a\u0441\u043a\u043b\u044e\u0437\u0438\u0432\u043d\u0456 \u0448\u043a\u0456\u0440\u043a\u0438 \u0434\u043b\u044f \u0433\u0440\u0430\u0432\u0446\u0456\u0432. [\u041f\u0440\u0438\u043a\u043b\u0430\u0434: \u041c\u043e\u0436\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u0442\u0438, \u0446\u0435 \u043f\u043e\u0434\u0456\u0431\u043d\u043e \u0434\u043e \u043f\u043e\u0448\u0443\u043a\u0443 \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0438\u0445 \u044f\u0454\u0446\u044c \u2013 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0438\u0445 \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434 \u0434\u043b\u044f \u043f\u0440\u0438\u0445\u0438\u043b\u044c\u043d\u0438\u043a\u0456\u0432 \u0433\u0440\u0438.]"}, {"question": "\u042f\u043a \u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443 \u0441\u0432\u043e\u0433\u043e \u0433\u0440\u0430\u0432\u0446\u044f \u0434\u043b\u044f \u0456\u0433\u043e\u0440 \u0432\u0438\u0441\u043e\u043a\u043e\u0433\u043e \u0440\u0456\u0432\u043d\u044f \u0443 Basketball Stars?", "answer": "\u041e\u043f\u0442\u0438\u043c\u0456\u0437\u0430\u0446\u0456\u044f \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0438 \u0432\u0430\u0448\u043e\u0433\u043e \u0433\u0440\u0430\u0432\u0446\u044f \u0443 Basketball Stars \u0432\u043a\u043b\u044e\u0447\u0430\u0454 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0447\u043d\u0456 \u043e\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f. \u041a\u0420\u041e\u041a 1 \u2013 \u0417\u043e\u0441\u0435\u0440\u0435\u0434\u044c\u0442\u0435\u0441\u044f \u043d\u0430 \u043a\u043b\u044e\u0447\u043e\u0432\u0438\u0445 \u043f\u043e\u043a\u0430\u0437\u043d\u0438\u043a\u0430\u0445, \u0442\u0430\u043a\u0438\u0445 \u044f\u043a \u00ab\u0422\u043e\u0447\u043d\u0456\u0441\u0442\u044c \u0441\u0442\u0440\u0456\u043b\u044c\u0431\u0438\u00bb \u0442\u0430 \u00ab\u0428\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c\u00bb. \u041a\u0420\u041e\u041a 2 \u2013 \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u043c\u043e\u043d\u0435\u0442\u0438 \u0442\u0430 \u0434\u043e\u0440\u043e\u0433\u043e\u0446\u0456\u043d\u043d\u0456 \u043a\u0430\u043c\u0435\u043d\u0456 \u0434\u043b\u044f \u043f\u0440\u0438\u0434\u0431\u0430\u043d\u043d\u044f \u043f\u0456\u0434\u0441\u0438\u043b\u0435\u043d\u043d\u044f \u043f\u043e\u043a\u0430\u0437\u043d\u0438\u043a\u0456\u0432. \u041a\u0420\u041e\u041a 3 \u2013 \u041d\u0430\u0434\u0456\u043d\u044c\u0442\u0435 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0438, \u044f\u043a\u0456 \u043f\u043e\u043a\u0440\u0430\u0449\u0443\u044e\u0442\u044c \u043f\u0435\u0432\u043d\u0456 \u0437\u0434\u0456\u0431\u043d\u043e\u0441\u0442\u0456. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043f\u0440\u0435\u0434\u043c\u0435\u0442 \u00ab\u0428\u0432\u0438\u0434\u043a\u0456\u0441\u043d\u0456 \u0447\u0435\u0440\u0435\u0432\u0438\u043a\u0438\u00bb \u0437\u0431\u0456\u043b\u044c\u0448\u0443\u0454 \u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c \u0440\u0443\u0445\u0443 \u0433\u0440\u0430\u0432\u0446\u044f. [\u0422\u0430\u0431\u043b\u0438\u0446\u044f \u043a\u043e\u043d\u0444\u0456\u0433\u0443\u0440\u0430\u0446\u0456\u0439: \u041f\u043e\u0440\u0456\u0432\u043d\u044f\u0439\u0442\u0435 \u0431\u0430\u0437\u043e\u0432\u0456 \u043f\u043e\u043a\u0430\u0437\u043d\u0438\u043a\u0438 \u0437 \u043e\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u043c\u0438, \u0449\u043e\u0431 \u043f\u043e\u0431\u0430\u0447\u0438\u0442\u0438 \u0432\u043f\u043b\u0438\u0432 \u0443\u0434\u043e\u0441\u043a\u043e\u043d\u0430\u043b\u0435\u043d\u044c.]"}]
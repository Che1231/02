[{"question": "\u5982\u4f55\u5728\u300a\u7bee\u7403\u4e4b\u661f\u300b\u4e2d\u4f5c\u4e3a\u65b0\u624b\u5b8c\u6210\u6263\u7bee\uff1f", "answer": "\u5728\u300a\u7bee\u7403\u4e4b\u661f\u300b\u4e2d\u5b8c\u6210\u6263\u7bee\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u5c06\u4f60\u7684\u7403\u5458\u7f6e\u4e8e\u7bee\u7b50\u9644\u8fd1\u3002\u6b65\u9aa42 - \u7528\u8db3\u591f\u7684\u529b\u91cf\u5411\u4e0a\u6ed1\u52a8\u5c4f\u5e55\u3002\u6b65\u9aa43 - \u5728\u8df3\u8dc3\u9876\u5cf0\u91ca\u653e\uff0c\u5373\u53ef\u5b8c\u6210\u6263\u7bee\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u201c\u529b\u91cf\u6263\u7bee\u201d\u52a8\u4f5c\u548c\u201c\u6263\u7bee\u5927\u5e08\u201d\u7403\u5458\uff0c\u53ef\u4ee5\u589e\u52a0\u5f97\u5206\u51e0\u7387\u3002 [\u6bd4\u55bb\u8bf4\u660e: \u60f3\u8c61\u4e00\u4e0b\u53d1\u5c04\u706b\u7bad\u2014\u2014\u65f6\u673a\u548c\u529b\u91cf\u81f3\u5173\u91cd\u8981\u3002]"}, {"question": "\u5728\u300a\u7bee\u7403\u4e4b\u661f\u300b\u7684 1v1 \u5bf9\u6218\u4e2d\uff0c\u6700\u4f73\u7684\u83b7\u80dc\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300a\u7bee\u7403\u4e4b\u661f\u300b\u7684 1v1 \u5bf9\u6218\u4e2d\u83b7\u80dc\uff0c\u9700\u8981\u7ed3\u5408\u8fdb\u653b\u548c\u9632\u5b88\u3002\u6b65\u9aa41 - \u7cbe\u901a\u4f60\u7403\u5458\u7684\u7279\u6b8a\u52a8\u4f5c\uff0c\u4f8b\u5982\u201c\u4ea4\u53c9\u6b65\u201d\u6216\u201c\u540e\u64a4\u6b65\u201d\u3002\u6b65\u9aa42 - \u4f7f\u7528\u5047\u52a8\u4f5c\u8bef\u5bfc\u5bf9\u624b\u3002\u6b65\u9aa43 - \u59cb\u7ec8\u5728\u9002\u5f53\u7684\u65f6\u5019\u6ed1\u52a8\u5c4f\u5e55\u6765\u5c01\u76d6\u3002\u4f8b\u5982\uff0c\u201c\u5c01\u76d6\u4e4b\u738b\u201d\u7403\u5458\u64c5\u957f\u9632\u5b88\u3002 [\u591a\u65b9\u6848\u5bf9\u6bd4: \u8fdb\u653b\u578b\u7403\u5458\uff0c\u4f8b\u5982\u201c\u5c04\u661f\u201d\uff0c\u975e\u5e38\u9002\u5408\u5f97\u5206\uff1b\u800c\u9632\u5b88\u578b\u7403\u5458\uff0c\u4f8b\u5982\u201c\u5c01\u76d6\u4e4b\u738b\u201d\uff0c\u5219\u66f4\u64c5\u957f\u963b\u6b62\u5bf9\u624b\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u5728\u300a\u7bee\u7403\u4e4b\u661f\u300b\u4e2d\u4f1a\u9519\u8fc7\u7b80\u5355\u7684\u6295\u7bee\uff1f", "answer": "\u5728\u300a\u7bee\u7403\u4e4b\u661f\u300b\u4e2d\u9519\u8fc7\u7b80\u5355\u7684\u6295\u7bee\uff0c\u53ef\u80fd\u6709\u591a\u79cd\u539f\u56e0\u3002\u6b65\u9aa41 - \u786e\u4fdd\u4f60\u7684\u7403\u5458\u4f53\u529b\u5145\u8db3\uff1b\u4f53\u529b\u4e0d\u8db3\u4f1a\u5f71\u54cd\u51c6\u786e\u5ea6\u3002\u6b65\u9aa42 - \u68c0\u67e5\u6295\u7bee\u8ba1\u91cf\u5668\uff1b\u8fc7\u65e9\u6216\u8fc7\u8fdf\u91ca\u653e\u4f1a\u9020\u6210\u5931\u8bef\u3002\u6b65\u9aa43 - \u5347\u7ea7\u4f60\u7684\u7403\u5458\u7684\u6295\u7bee\u5c5e\u6027\u3002\u4f8b\u5982\uff0c\u201c\u7cbe\u51c6\u5c04\u624b\u201d\u7403\u5458\u7684\u547d\u4e2d\u7387\u66f4\u9ad8\u3002 [\u914d\u7f6e\u5bf9\u7167\u8868: \u6bd4\u8f83\u201c\u6295\u7bee\u51c6\u786e\u7387\u201d\u548c\u201c\u4f53\u529b\u201d\u7b49\u5c5e\u6027\u4ee5\u4f18\u5316\u6027\u80fd\u3002]"}, {"question": "\u5982\u4f55\u5728\u300a\u7bee\u7403\u4e4b\u661f\u300b\u4e2d\u89e3\u9501\u65b0\u7403\u5458\uff1f", "answer": "\u5728\u300a\u7bee\u7403\u4e4b\u661f\u300b\u4e2d\u89e3\u9501\u65b0\u7403\u5458\u9700\u8981\u901a\u8fc7\u6e38\u620f\u8d5a\u53d6\u786c\u5e01\u548c\u5b9d\u77f3\u3002\u6b65\u9aa41 - \u5b8c\u6210\u6bcf\u65e5\u6311\u6218\u548c\u6bd4\u8d5b\u4ee5\u6536\u96c6\u8d44\u6e90\u3002\u6b65\u9aa42 - \u8bbf\u95ee\u201c\u7403\u5458\u5546\u5e97\u201d\u8d2d\u4e70\u65b0\u7403\u5458\u3002\u6b65\u9aa43 - \u53c2\u52a0\u6d3b\u52a8\u4ee5\u83b7\u5f97\u72ec\u5bb6\u7403\u5458\u3002\u4f8b\u5982\uff0c\u201c\u7a7a\u4e2d\u63a5\u529b\u738b\u201d\u53ef\u4ee5\u5728\u7279\u6b8a\u6d3b\u52a8\u4e2d\u89e3\u9501\u3002 [\u6bd4\u55bb\u8bf4\u660e: \u8fd9\u5c31\u50cf\u6536\u96c6\u4ea4\u6613\u5361\u4e00\u6837\u2014\u2014\u6bcf\u4e2a\u7403\u5458\u90fd\u4f1a\u4e3a\u4f60\u7684\u7403\u961f\u589e\u52a0\u72ec\u7279\u7684\u4ef7\u503c\u3002]"}, {"question": "\u300a\u7bee\u7403\u4e4b\u661f\u300b\u4e2d\u7684\u4f11\u95f2\u8d5b\u548c\u6392\u4f4d\u8d5b\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u300a\u7bee\u7403\u4e4b\u661f\u300b\u4e2d\u7684\u4f11\u95f2\u8d5b\u548c\u6392\u4f4d\u8d5b\u5728\u5f88\u591a\u65b9\u9762\u6709\u6240\u4e0d\u540c\u3002\u6b65\u9aa41 - \u4f11\u95f2\u8d5b\u7528\u4e8e\u7ec3\u4e60\u548c\u5a31\u4e50\uff0c\u800c\u6392\u4f4d\u8d5b\u4f1a\u5f71\u54cd\u4f60\u7684\u6392\u884c\u699c\u4f4d\u7f6e\u3002\u6b65\u9aa42 - \u6392\u4f4d\u8d5b\u9700\u8981\u66f4\u9ad8\u7684\u6280\u80fd\u6c34\u5e73\u548c\u6218\u7565\u6027\u73a9\u6cd5\u3002\u6b65\u9aa43 - \u6392\u4f4d\u8d5b\u7684\u5956\u52b1\u66f4\u4e3a\u4e30\u539a\u3002\u4f8b\u5982\uff0c\u8d62\u5f97\u6392\u4f4d\u8d5b\u53ef\u4ee5\u663e\u8457\u63d0\u5347\u4f60\u7684\u6392\u540d\u3002 [\u591a\u65b9\u6848\u5bf9\u6bd4: \u4f11\u95f2\u8d5b\u5c31\u50cf\u70ed\u8eab\uff0c\u800c\u6392\u4f4d\u8d5b\u624d\u662f\u4e3b\u8981\u6bd4\u8d5b\u3002]"}, {"question": "\u300a\u7bee\u7403\u4e4b\u661f\u300b\u4e2d\u54ea\u4e9b\u6e38\u620f\u8d27\u5e01\u6700\u73cd\u8d35\uff0c\u4e3a\u4ec0\u4e48\uff1f", "answer": "\u300a\u7bee\u7403\u4e4b\u661f\u300b\u4e2d\uff0c\u6700\u73cd\u8d35\u7684\u6e38\u620f\u8d27\u5e01\u662f\u786c\u5e01\u548c\u5b9d\u77f3\u3002\u6b65\u9aa41 - \u786c\u5e01\u7528\u4e8e\u57fa\u672c\u7684\u5347\u7ea7\u548c\u7403\u5458\u8d2d\u4e70\u3002\u6b65\u9aa42 - \u5b9d\u77f3\u66f4\u4e3a\u7a00\u6709\uff0c\u53ef\u4ee5\u89e3\u9501\u9ad8\u7ea7\u7403\u5458\u548c\u7269\u54c1\u3002\u6b65\u9aa43 - \u901a\u8fc7\u6d3b\u52a8\u548c\u6311\u6218\u4f18\u5148\u83b7\u5f97\u5b9d\u77f3\u3002\u4f8b\u5982\uff0c\u201c\u4f20\u5947\u7403\u5458\u5305\u201d\u53ea\u80fd\u7528\u5b9d\u77f3\u8d2d\u4e70\u3002 [\u914d\u7f6e\u5bf9\u7167\u8868: \u6bd4\u8f83\u786c\u5e01\u548c\u5b9d\u77f3\u7684\u7528\u9014\u548c\u83b7\u53d6\u65b9\u6cd5\uff0c\u4ee5\u4fbf\u6709\u6548\u5730\u8fdb\u884c\u4f18\u5148\u7ea7\u6392\u5e8f\u3002]"}, {"question": "\u300a\u7bee\u7403\u4e4b\u661f\u300b\u7684\u5339\u914d\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u300a\u7bee\u7403\u4e4b\u661f\u300b\u7684\u5339\u914d\u7cfb\u7edf\u6839\u636e\u7403\u5458\u7684\u6280\u80fd\u6c34\u5e73\u548c\u6392\u540d\u8fdb\u884c\u914d\u5bf9\u3002\u6b65\u9aa41 - \u8be5\u7cfb\u7edf\u4f1a\u8bc4\u4f30\u4f60\u7684\u8fd1\u671f\u8868\u73b0\u548c\u80dc\u8d1f\u6bd4\u3002\u6b65\u9aa42 - \u5b83\u4f1a\u5c06\u4f60\u4e0e\u5177\u6709\u7c7b\u4f3c\u7edf\u8ba1\u6570\u636e\u7684\u7403\u5458\u5339\u914d\uff0c\u4ee5\u786e\u4fdd\u516c\u5e73\u5bf9\u6218\u3002\u6b65\u9aa43 - \u6392\u540d\u66f4\u9ad8\u7684\u7403\u5458\u4f1a\u9047\u5230\u66f4\u5f3a\u5927\u7684\u5bf9\u624b\u3002\u4f8b\u5982\uff0c\u80dc\u7387\u4e3a 70% \u7684\u7403\u5458\u5c06\u9762\u5bf9\u6280\u80fd\u76f8\u5f53\u7684\u5bf9\u624b\u3002 [\u6d41\u7a0b\u56fe\u89e3: \u4e86\u89e3\u4ece\u7403\u5458\u7edf\u8ba1\u6570\u636e \u2192 \u5339\u914d\u7b97\u6cd5 \u2192 \u5bf9\u624b\u9009\u62e9\u7684\u6d41\u7a0b\u3002]"}, {"question": "\u6211\u53ef\u4ee5\u5728\u624b\u673a\u7248\u300a\u7bee\u7403\u4e4b\u661f\u300b\u548c\u7535\u8111\u7248\u4e4b\u95f4\u8f6c\u79fb\u6e38\u620f\u8fdb\u5ea6\u5417\uff1f", "answer": "\u662f\u7684\uff0c\u4f60\u53ef\u4ee5\u5c06\u624b\u673a\u7248\u300a\u7bee\u7403\u4e4b\u661f\u300b\u7684\u6e38\u620f\u8fdb\u5ea6\u8f6c\u79fb\u5230\u7535\u8111\u7248\u3002\u6b65\u9aa41 - \u786e\u4fdd\u4f60\u5728\u4e24\u53f0\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u8d26\u6237\u3002\u6b65\u9aa42 - \u4f7f\u7528\u4e91\u5b58\u6863\u529f\u80fd\u540c\u6b65\u4f60\u7684\u8fdb\u5ea6\u3002\u6b65\u9aa43 - \u901a\u8fc7\u68c0\u67e5\u4f60\u7684\u7403\u5458\u7edf\u8ba1\u6570\u636e\u548c\u7269\u54c1\u6765\u9a8c\u8bc1\u8f6c\u79fb\u3002\u4f8b\u5982\uff0c\u4f60\u7684\u201c\u6263\u7bee\u5927\u5e08\u201d\u7403\u5458\u548c\u79ef\u7d2f\u7684\u786c\u5e01\u5e94\u8be5\u5728\u4e24\u4e2a\u5e73\u53f0\u4e0a\u90fd\u51fa\u73b0\u3002 [\u6bd4\u55bb\u8bf4\u660e: \u8fd9\u5c31\u50cf\u628a\u4f60\u7684\u7269\u54c1\u642c\u5230\u65b0\u623f\u5b50\u2014\u2014\u4e00\u5207\u90fd\u5e94\u8be5\u5230\u4f4d\u3002]"}, {"question": "\u6211\u5728\u300a\u7bee\u7403\u4e4b\u661f\u300b\u4e2d\u53ef\u4ee5\u89e3\u9501\u54ea\u4e9b\u9690\u85cf\u6210\u5c31\uff1f", "answer": "\u300a\u7bee\u7403\u4e4b\u661f\u300b\u4e2d\u6709\u4e00\u4e9b\u9690\u85cf\u6210\u5c31\uff0c\u5956\u52b1\u72ec\u7279\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u6b65\u9aa41 - \u5b8c\u6210\u4e00\u5b9a\u6570\u91cf\u7684\u6210\u529f\u6263\u7bee\u5373\u53ef\u89e3\u9501\u201c\u6263\u7bee\u738b\u201d\u3002\u6b65\u9aa42 - \u5728\u4e0d\u5931\u4e00\u7403\u7684\u60c5\u51b5\u4e0b\u8d62\u5f97\u6bd4\u8d5b\uff0c\u5373\u53ef\u83b7\u5f97\u201c\u5b8c\u7f8e\u6e38\u620f\u201d\u3002\u6b65\u9aa43 - \u5728\u5355\u573a\u6bd4\u8d5b\u4e2d\u5c01\u76d6 10 \u4e2a\u7403\u5373\u53ef\u83b7\u5f97\u201c\u9632\u5b88\u4e4b\u5899\u201d\u3002\u4f8b\u5982\uff0c\u83b7\u5f97\u201c\u5b8c\u7f8e\u6e38\u620f\u201d\u5c06\u4e3a\u4f60\u63d0\u4f9b\u72ec\u5bb6\u7684\u7403\u5458\u76ae\u80a4\u3002 [\u6bd4\u55bb\u8bf4\u660e: \u8fd9\u5c31\u50cf\u5bfb\u627e\u5f69\u86cb\u2014\u2014\u4e3a\u4e86\u81f4\u529b\u4e8e\u6e38\u620f\u7684\u73a9\u5bb6\u9690\u85cf\u7684\u5956\u52b1\u3002]"}, {"question": "\u5982\u4f55\u5728\u300a\u7bee\u7403\u4e4b\u661f\u300b\u4e2d\u4f18\u5316\u7403\u5458\u7684\u5c5e\u6027\u4ee5\u8fdb\u884c\u7ade\u6280\u6bd4\u8d5b\uff1f", "answer": "\u5728\u300a\u7bee\u7403\u4e4b\u661f\u300b\u4e2d\u4f18\u5316\u7403\u5458\u7684\u5c5e\u6027\u9700\u8981\u8fdb\u884c\u6218\u7565\u6027\u5347\u7ea7\u3002\u6b65\u9aa41 - \u4e13\u6ce8\u4e8e\u5173\u952e\u5c5e\u6027\uff0c\u5982\u201c\u6295\u7bee\u51c6\u786e\u7387\u201d\u548c\u201c\u901f\u5ea6\u201d\u3002\u6b65\u9aa42 - \u4f7f\u7528\u786c\u5e01\u548c\u5b9d\u77f3\u8d2d\u4e70\u5c5e\u6027\u63d0\u5347\u3002\u6b65\u9aa43 - \u88c5\u5907\u589e\u5f3a\u7279\u5b9a\u80fd\u529b\u7684\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u201c\u52a0\u901f\u978b\u201d\u7269\u54c1\u53ef\u4ee5\u63d0\u9ad8\u7403\u5458\u7684\u79fb\u52a8\u901f\u5ea6\u3002 [\u914d\u7f6e\u5bf9\u7167\u8868: \u6bd4\u8f83\u57fa\u7840\u5c5e\u6027\u548c\u5347\u7ea7\u540e\u7684\u5c5e\u6027\uff0c\u770b\u770b\u63d0\u5347\u7684\u5f71\u54cd\u3002]"}]
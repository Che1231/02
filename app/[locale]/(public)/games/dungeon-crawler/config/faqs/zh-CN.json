[{"question": "\u5982\u4f55\u5728\u300a\u5730\u7262\u722c\u884c\u8005\u300b\u4e2d\u8fdb\u884c\u57fa\u672c\u79fb\u52a8\u548c\u6218\u6597\uff1f", "answer": "\u5728\u5730\u7262\u722c\u884c\u8005\u4e2d\uff0c\u57fa\u672c\u79fb\u52a8\u4f7f\u7528 WASD \u952e\u6216\u65b9\u5411\u952e\u63a7\u5236\u3002\u6218\u6597\u65f6\uff0c\u5de6\u952e\u70b9\u51fb\u4f7f\u7528\u4f60\u7684\u4e3b\u8981\u6b66\u5668\u653b\u51fb\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u5251\u4f1a\u671d\u7740\u9f20\u6807\u5149\u6807\u7684\u65b9\u5411\u6325\u52a8\u3002\u8981\u8eb2\u907f\uff0c\u8bf7\u6309\u7a7a\u683c\u952e\uff0c\u8fd9\u5bf9\u4e8e\u8eb2\u907f\u654c\u4eba\u653b\u51fb\u81f3\u5173\u91cd\u8981\u3002\u8bb0\u4f4f\u8981\u7ba1\u7406\u4f60\u7684\u4f53\u529b\u6761\uff0c\u56e0\u4e3a\u8eb2\u907f\u548c\u653b\u51fb\u90fd\u4f1a\u6d88\u8017\u4f53\u529b\u3002\u4e00\u4e2a\u597d\u4e60\u60ef\u662f\u653b\u51fb\u4e24\u6b21\uff0c\u7136\u540e\u8eb2\u907f\u4ee5\u907f\u514d\u53cd\u51fb\u3002"}, {"question": "\u5728\u300a\u5730\u7262\u722c\u884c\u8005\u300b\u4e2d\uff0c\u4e3a\u4ec0\u4e48\u7269\u54c1\u7ba1\u7406\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u5728\u300a\u5730\u7262\u722c\u884c\u8005\u300b\u4e2d\uff0c\u7269\u54c1\u7ba1\u7406\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u4f60\u7684\u80cc\u5305\u7a7a\u95f4\u6709\u9650\u3002\u4f18\u5148\u8003\u8651\u5fc5\u9700\u54c1\uff0c\u4f8b\u5982\u751f\u547d\u836f\u6c34\u548c\u6b66\u5668\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u627e\u5230\u4e00\u628a\u7a00\u6709\u5251\uff0c\u4f46\u80cc\u5305\u6ee1\u4e86\uff0c\u53ef\u4ee5\u8003\u8651\u4e22\u5f03\u4e00\u4e9b\u4ef7\u503c\u8f83\u4f4e\u7684\u7269\u54c1\uff0c\u4f8b\u5982\u666e\u901a\u836f\u6c34\u3002\u6309\u5e38\u7528\u7a0b\u5ea6\u6392\u5217\u4f60\u7684\u7269\u54c1\uff0c\u5c06\u5e38\u7528\u7269\u54c1\u653e\u5728\u6613\u4e8e\u8bbf\u95ee\u7684\u4f4d\u7f6e\u3002\u8fd9\u786e\u4fdd\u4e86\u4f60\u5728\u6218\u6597\u6216\u7d27\u6025\u60c5\u51b5\u4e0b\u80fd\u591f\u5feb\u901f\u4f7f\u7528\u5b83\u4eec\u3002"}, {"question": "\u5728\u300a\u5730\u7262\u722c\u884c\u8005\u300b\u4e2d\u5feb\u901f\u5347\u7ea7\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300a\u5730\u7262\u722c\u884c\u8005\u300b\u4e2d\u5feb\u901f\u5347\u7ea7\uff0c\u4e13\u6ce8\u4e8e\u5b8c\u6210\u4efb\u52a1\u548c\u51fb\u8d25\u66f4\u9ad8\u7b49\u7ea7\u7684\u654c\u4eba\u3002\u4f8b\u5982\uff0c \"\u54e5\u5e03\u6797\u4e4b\u738b\" \u4efb\u52a1\u63d0\u4f9b\u4e30\u539a\u7684\u7ecf\u9a8c\u5956\u52b1\u3002\u6b65\u9aa4\u4e00\uff1a\u88c5\u5907\u6700\u597d\u7684\u53ef\u7528\u88c5\u5907\uff0c\u6700\u5927\u5316\u4f60\u7684\u4f24\u5bb3\u8f93\u51fa\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u533a\u57df\u6027\uff08AOE\uff09\u6cd5\u672f\u6216\u80fd\u529b\u66f4\u5feb\u5730\u6e05\u9664\u654c\u4eba\u7fa4\u4f53\u3002\u6b65\u9aa4\u4e09\uff1a\u59cb\u7ec8\u643a\u5e26\u751f\u547d\u836f\u6c34\uff0c\u4ee5\u4fbf\u5728\u4e0d\u64a4\u9000\u7684\u60c5\u51b5\u4e0b\u6301\u7eed\u66f4\u957f\u65f6\u95f4\u7684\u6218\u6597\u3002\u8fd9\u79cd\u65b9\u6cd5\u786e\u4fdd\u4e86\u6709\u6548\u7387\u7684\u7ecf\u9a8c\u83b7\u53d6\u3002"}, {"question": "\u300a\u5730\u7262\u722c\u884c\u8005\u300b\u4e2d\u7684\u5236\u4f5c\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u300a\u5730\u7262\u722c\u884c\u8005\u300b\u4e2d\u7684\u5236\u4f5c\u7cfb\u7edf\u5141\u8bb8\u73a9\u5bb6\u4f7f\u7528\u6536\u96c6\u5230\u7684\u8d44\u6e90\u5236\u4f5c\u5f3a\u5927\u7684\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5c06 3 \u4e2a\u94c1\u77ff\u77f3\u548c 1 \u4e2a\u6728\u6750\u7ec4\u5408\u53ef\u4ee5\u5236\u4f5c\u4e00\u628a\u57fa\u7840\u5251\u3002\u6b65\u9aa4\u4e00\uff1a\u901a\u8fc7\u91c7\u77ff\u6216\u63a0\u593a\u6536\u96c6\u8d44\u6e90\u3002\u6b65\u9aa4\u4e8c\uff1a\u4ece\u4f60\u7684\u80cc\u5305\u4e2d\u8bbf\u95ee\u5236\u4f5c\u83dc\u5355\u3002\u6b65\u9aa4\u4e09\uff1a\u9009\u62e9\u4f60\u60f3\u8981\u5236\u4f5c\u7684\u7269\u54c1\uff0c\u5e76\u786e\u4fdd\u4f60\u6709\u5fc5\u8981\u7684\u6750\u6599\u3002\u5236\u4f5c\u5bf9\u4e8e\u5347\u7ea7\u4f60\u7684\u88c5\u5907\u548c\u5728\u66f4\u9ad8\u7b49\u7ea7\u7684\u5730\u7262\u4e2d\u4fdd\u6301\u7ade\u4e89\u529b\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u5728\u300a\u5730\u7262\u722c\u884c\u8005\u300b\u4e2d\uff0c\u6cd5\u5e08\u804c\u4e1a\u5e94\u8be5\u4f18\u5148\u8003\u8651\u54ea\u4e9b\u6280\u80fd\uff1f", "answer": "\u5728\u300a\u5730\u7262\u722c\u884c\u8005\u300b\u4e2d\uff0c\u5bf9\u4e8e\u6cd5\u5e08\u804c\u4e1a\uff0c\u4f18\u5148\u8003\u8651\u80fd\u591f\u589e\u5f3a\u4f60\u7684\u6cd5\u672f\u80fd\u529b\u7684\u6280\u80fd\u3002\u4f8b\u5982\uff0c\"\u706b\u7403\" \u662f\u4e00\u79cd\u5f3a\u5927\u7684\u533a\u57df\u6027\u6cd5\u672f\uff0c\u53ef\u4ee5\u5feb\u901f\u6e05\u9664\u654c\u4eba\u7fa4\u4f53\u3002\u6b65\u9aa4\u4e00\uff1a\u6295\u8d44\u4e8e \"\u6cd5\u529b\u56de\u590d\" \u6765\u7ef4\u6301\u4f60\u7684\u6cd5\u672f\u65bd\u653e\u3002\u6b65\u9aa4\u4e8c\uff1a\u5347\u7ea7 \"\u6cd5\u672f\u4f24\u5bb3\" \u4ee5\u63d0\u9ad8\u4f60\u7684\u6cd5\u672f\u5a01\u529b\u3002\u6b65\u9aa4\u4e09\uff1a\u8003\u8651\"\u4f20\u9001\" \u6765\u63d0\u9ad8\u673a\u52a8\u6027\uff0c\u4ee5\u9003\u79bb\u5371\u9669\u60c5\u51b5\u3002\u6b64\u804c\u4e1a\u4e13\u6ce8\u4e8e\u6700\u5927\u5316\u4f24\u5bb3\u8f93\u51fa\uff0c\u540c\u65f6\u4fdd\u6301\u7075\u6d3b\u3002"}, {"question": "\u300a\u5730\u7262\u722c\u884c\u8005\u300b\u4e0d\u540c\u96be\u5ea6\u7b49\u7ea7\u4e4b\u95f4\u7684\u4e3b\u8981\u533a\u522b\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u5730\u7262\u722c\u884c\u8005\u300b\u63d0\u4f9b\u591a\u4e2a\u96be\u5ea6\u7b49\u7ea7\uff0c\u6bcf\u4e2a\u96be\u5ea6\u7b49\u7ea7\u90fd\u4f1a\u5bf9\u6e38\u620f\u73a9\u6cd5\u4ea7\u751f\u91cd\u5927\u5f71\u54cd\u3002\u4f8b\u5982\uff0c\u5728 \"\u7b80\u5355\" \u96be\u5ea6\u4e0b\uff0c\u654c\u4eba\u9020\u6210\u7684\u4f24\u5bb3\u8f83\u5c11\uff0c\u751f\u547d\u503c\u4e5f\u8f83\u4f4e\uff0c\u975e\u5e38\u9002\u5408\u65b0\u624b\u3002\u5728 \"\u56f0\u96be\" \u96be\u5ea6\u4e0b\uff0c\u654c\u4eba\u66f4\u52a0\u5177\u6709\u4fb5\u7565\u6027\uff0c\u8d44\u6e90\u4e5f\u66f4\u52a0\u7a00\u7f3a\uff0c\u9700\u8981\u66f4\u9ad8\u7ea7\u7684\u7b56\u7565\u3002\"\u5669\u68a6\" \u96be\u5ea6\u5f15\u5165\u4e86\u72ec\u7279\u7684\u673a\u5236\uff0c\u4f8b\u5982\u6c38\u4e45\u6b7b\u4ea1\uff0c\u6b7b\u4ea1\u4f1a\u5bfc\u81f4\u4f60\u5931\u53bb\u89d2\u8272\u3002\u9009\u62e9\u4e00\u4e2a\u7b26\u5408\u4f60\u6280\u80fd\u6c34\u5e73\u548c\u6240\u9700\u6311\u6218\u96be\u5ea6\u7684\u96be\u5ea6\u3002"}, {"question": "\u300a\u5730\u7262\u722c\u884c\u8005\u300b\u5982\u4f55\u5904\u7406\u89d2\u8272\u7684\u63d0\u5347\u548c\u5c5e\u6027\u5206\u914d\uff1f", "answer": "\u300a\u5730\u7262\u722c\u884c\u8005\u300b\u4e2d\u7684\u89d2\u8272\u63d0\u5347\u6d89\u53ca\u5347\u7ea7\u548c\u5206\u914d\u5c5e\u6027\u70b9\u6765\u589e\u5f3a\u89d2\u8272\u7684\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u6218\u58eb\u53ef\u80fd\u4f1a\u4f18\u5148\u8003\u8651\u529b\u91cf\u4ee5\u589e\u52a0\u8fd1\u6218\u4f24\u5bb3\uff0c\u800c\u76d7\u8d3c\u5219\u6ce8\u91cd\u654f\u6377\u4ee5\u83b7\u5f97\u66f4\u597d\u7684\u66b4\u51fb\u4f24\u5bb3\u3002\u6b65\u9aa4\u4e00\uff1a\u901a\u8fc7\u4efb\u52a1\u548c\u6218\u6597\u83b7\u5f97\u7ecf\u9a8c\u503c\u6765\u5347\u7ea7\u3002\u6b65\u9aa4\u4e8c\uff1a\u6839\u636e\u4f60\u9009\u62e9\u7684\u804c\u4e1a\u5206\u914d\u5c5e\u6027\u70b9\u3002\u6b65\u9aa4\u4e09\uff1a\u5b9a\u671f\u68c0\u67e5\u548c\u8c03\u6574\u4f60\u7684\u5c5e\u6027\u4ee5\u4f18\u5316\u4f60\u5728\u4e0d\u540c\u5730\u7262\u7684\u8868\u73b0\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u6211\u7684\u300a\u5730\u7262\u722c\u884c\u8005\u300b\u8fdb\u5ea6\u5417\uff1f", "answer": "\u662f\u7684\uff0c\u300a\u5730\u7262\u722c\u884c\u8005\u300b\u652f\u6301\u8de8\u5e73\u53f0\u8fdb\u5ea6\u8f6c\u79fb\u3002\u4f8b\u5982\uff0c\u4f60\u53ef\u4ee5\u5c06\u4f60\u7684\u89d2\u8272\u4ece\u7535\u8111\u8f6c\u79fb\u5230\u624b\u673a\u3002\u6b65\u9aa4\u4e00\uff1a\u786e\u4fdd\u4f60\u7684\u6e38\u620f\u5df2\u94fe\u63a5\u5230\u4e91\u7aef\u5e10\u6237\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u76f8\u540c\u7684\u5e10\u6237\u767b\u5f55\u65b0\u5e73\u53f0\u3002\u6b65\u9aa4\u4e09\uff1a\u540c\u6b65\u8fdb\u5ea6\u4ee5\u4ece\u4e2d\u65ad\u5904\u7ee7\u7eed\u3002\u6b64\u529f\u80fd\u5141\u8bb8\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u65e0\u7f1d\u6e38\u620f\uff0c\u786e\u4fdd\u4f60\u4e0d\u4f1a\u5931\u53bb\u4f60\u8f9b\u8f9b\u82e6\u82e6\u83b7\u5f97\u7684\u8fdb\u5ea6\u3002"}, {"question": "\u300a\u5730\u7262\u722c\u884c\u8005\u300b\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u5f69\u86cb\uff1f", "answer": "\u300a\u5730\u7262\u722c\u884c\u8005\u300b\u5145\u6ee1\u4e86\u9690\u85cf\u5f69\u86cb\uff0c\u5956\u52b1\u63a2\u7d22\u3002\u4f8b\u5982\uff0c\u5728 \"\u88ab\u9057\u5fd8\u7684\u5893\u7a74\" \u4e2d\uff0c\u7834\u574f\u7279\u5b9a\u5899\u58c1\u4f1a\u63ed\u793a\u4e00\u4e2a\u79d8\u5bc6\u623f\u95f4\uff0c\u5176\u4e2d\u5305\u542b\u7a00\u6709\u6218\u5229\u54c1\u3002\u53e6\u4e00\u4e2a\u5f69\u86cb\u6d89\u53ca\u88c5\u5907\u7279\u5b9a\u7ec4\u5408\u7684\u7269\u54c1\uff0c\u4ee5\u4e0e NPC \u89e3\u9501\u72ec\u7279\u7684\u5bf9\u8bdd\u3002\u8fd9\u4e9b\u9690\u85cf\u7684\u5b9d\u85cf\u589e\u52a0\u4e86\u6e38\u620f\u7684\u6df1\u5ea6\uff0c\u5956\u52b1\u90a3\u4e9b\u504f\u79bb\u5e38\u89c4\u8def\u5f84\u7684\u73a9\u5bb6\u3002"}, {"question": "\u300a\u5730\u7262\u722c\u884c\u8005\u300b\u7684\u5730\u7262\u751f\u6210\u7b97\u6cd5\u662f\u5982\u4f55\u5de5\u4f5c\u7684\uff1f", "answer": "\u300a\u5730\u7262\u722c\u884c\u8005\u300b\u4f7f\u7528\u7a0b\u5e8f\u5316\u751f\u6210\u7b97\u6cd5\u6765\u4e3a\u6bcf\u6b21\u6e38\u620f\u521b\u5efa\u72ec\u7279\u7684\u5730\u7262\u3002\u4f8b\u5982\uff0c\u8be5\u7b97\u6cd5\u5c06\u9884\u5b9a\u4e49\u7684\u623f\u95f4\u6a21\u677f\u4e0e\u968f\u673a\u5143\u7d20\uff08\u4f8b\u5982\u654c\u4eba\u4f4d\u7f6e\u548c\u6218\u5229\u54c1\u5206\u914d\uff09\u76f8\u7ed3\u5408\u3002\u8fd9\u786e\u4fdd\u4e86\u6ca1\u6709\u4e24\u4e2a\u5730\u7262\u5b8c\u5168\u76f8\u540c\uff0c\u6bcf\u6b21\u90fd\u63d0\u4f9b\u65b0\u9c9c\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u8be5\u7b97\u6cd5\u8fd8\u4f1a\u6839\u636e\u4f60\u7684\u89d2\u8272\u7b49\u7ea7\u8c03\u6574\u96be\u5ea6\uff0c\u4fdd\u6301\u6311\u6218\u7684\u5e73\u8861\u548c\u5438\u5f15\u529b\u3002"}]
[{"question": "\ub358\uc804 \ud06c\ub864\ub7ec\uc5d0\uc11c \uae30\ubcf8 \uc774\ub3d9 \ubc0f \uc804\ud22c\ub97c \uc5b4\ub5bb\uac8c \uc218\ud589\ud569\ub2c8\uae4c?", "answer": "\ub358\uc804 \ud06c\ub864\ub7ec\uc5d0\uc11c \uae30\ubcf8 \uc774\ub3d9\uc740 WASD \ud0a4 \ub610\ub294 \ud654\uc0b4\ud45c \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc81c\uc5b4\ud569\ub2c8\ub2e4. \uc804\ud22c\ub294 \uc8fc \ubb34\uae30\ub85c \uacf5\uaca9\ud558\uae30 \uc704\ud574 \uc67c\ucabd \ud074\ub9ad\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac80\uc744 \uc0ac\uc6a9\ud558\uba74 \ucee4\uc11c \ubc29\ud5a5\uc73c\ub85c \ud718\ub450\ub985\ub2c8\ub2e4. \ud68c\ud53c\ud558\ub824\uba74 \uacf5\uaca9\uc744 \ud53c\ud558\ub294 \ub370 \uc911\uc694\ud560 \uc218 \uc788\ub294 \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \ub204\ub974\uc2ed\uc2dc\uc624. \ud68c\ud53c \ubc0f \uacf5\uaca9\uc740 \uc2a4\ud0dc\ubbf8\ub098\ub97c \uc18c\ubaa8\ud558\ubbc0\ub85c \uc2a4\ud0dc\ubbf8\ub098 \ubc14\ub97c \uad00\ub9ac\ud574\uc57c \ud569\ub2c8\ub2e4. \uc88b\uc740 \ubc29\ubc95\uc740 \ub450 \ubc88 \uacf5\uaca9\ud55c \ub2e4\uc74c \uc5ed\uc2b5\uc744 \ud53c\ud558\uae30 \uc704\ud574 \ud68c\ud53c\ud558\ub294 \uac83\uc785\ub2c8\ub2e4."}, {"question": "\ub358\uc804 \ud06c\ub864\ub7ec\uc5d0\uc11c \uc778\ubca4\ud1a0\ub9ac \uad00\ub9ac\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub358\uc804 \ud06c\ub864\ub7ec\uc5d0\uc11c \uc778\ubca4\ud1a0\ub9ac \uad00\ub9ac\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubc30\ub0ad\uc5d0 \uc2ac\ub86f\uc774 \uc81c\ud55c\ub418\uc5b4 \uc788\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uac74\uac15 \ubb3c\uc57d\uacfc \ubb34\uae30\uc640 \uac19\uc740 \ud544\uc218 \uc544\uc774\ud15c\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uace0\ub824\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub4dc\ubb38 \uac80\uc744 \ubc1c\uacac\ud588\uc9c0\ub9cc \uc778\ubca4\ud1a0\ub9ac\uac00 \uac00\ub4dd \ucc3c\ub2e4\uba74 \uc77c\ubc18\uc801\uc778 \ubb3c\uc57d\uacfc \uac19\uc740 \ub35c \uac00\uce58 \uc788\ub294 \uc544\uc774\ud15c\uc744 \ubc84\ub9ac\ub294 \uac83\uc744 \uace0\ub824\ud558\uc2ed\uc2dc\uc624. \uc790\uc8fc \uc0ac\uc6a9\ud558\ub294 \uc544\uc774\ud15c\uc744 \uc190\uc27d\uac8c \uc811\uadfc\ud560 \uc218 \uc788\ub294 \uc2ac\ub86f\uc5d0 \ubc30\uce58\ud558\uc5ec \uc778\ubca4\ud1a0\ub9ac\ub97c \uc815\ub9ac\ud558\uc2ed\uc2dc\uc624. \uc774\ub807\uac8c \ud558\uba74 \uc804\ud22c\ub098 \uae34\uae09 \uc0c1\ud669\uc5d0\uc11c \ube60\ub974\uac8c \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub358\uc804 \ud06c\ub864\ub7ec\uc5d0\uc11c \ub808\ubca8\uc5c5\uc744 \ube60\ub974\uac8c \ud558\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub358\uc804 \ud06c\ub864\ub7ec\uc5d0\uc11c \ub808\ubca8\uc5c5\uc744 \ube60\ub974\uac8c \ud558\ub824\uba74 \ud018\uc2a4\ud2b8\ub97c \uc644\ub8cc\ud558\uace0 \uace0\ub808\ubca8 \ubaac\uc2a4\ud130\ub97c \ucc98\uce58\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \"\uace0\ube14\ub9b0 \uc655\" \ud018\uc2a4\ud2b8\ub294 \uc0c1\ub2f9\ud55c \uacbd\ud5d8\uce58 \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub2e8\uacc41: \ucd5c\ub300\ud55c \ub192\uc740 \ub370\ubbf8\uc9c0\ub97c \ub0bc \uc218 \uc788\ub3c4\ub85d \ucd5c\uace0\uc758 \uc7a5\ube44\ub97c \ucc29\uc6a9\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc42: \uc801 \uadf8\ub8f9\uc744 \ub354 \ube60\ub974\uac8c \uc18c\ud0d5\ud558\uae30 \uc704\ud574 \uc601\uc5ed \uc9c0\uc18d \ud6a8\uacfc(AoE) \ub9c8\ubc95\uc774\ub098 \ub2a5\ub825\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc43: \ud6c4\ud1f4\ud558\uc9c0 \uc54a\uace0 \ub354 \uae34 \uc804\ud22c\ub97c \uc9c0\uc18d\ud558\uae30 \uc704\ud574 \ud56d\uc0c1 \uccb4\ub825 \ubb3c\uc57d\uc744 \uac00\uc9c0\uace0 \ub2e4\ub2c8\uc2ed\uc2dc\uc624. \uc774 \ubc29\ubc95\uc740 \ud6a8\uc728\uc801\uc778 \uacbd\ud5d8\uce58 \ud68d\ub4dd\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "\ub358\uc804 \ud06c\ub864\ub7ec\uc5d0\uc11c \ud06c\ub798\ud504\ud305 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "\ub358\uc804 \ud06c\ub864\ub7ec\uc758 \ud06c\ub798\ud504\ud305 \uc2dc\uc2a4\ud15c\uc744 \ud1b5\ud574 \ud50c\ub808\uc774\uc5b4\ub294 \uc218\uc9d1\ud55c \uc790\uc6d0\uc73c\ub85c \uac15\ub825\ud55c \uc544\uc774\ud15c\uc744 \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 3\uac1c\uc758 \ucca0\uad11\uc11d\uacfc 1\uac1c\uc758 \ub098\ubb34\ub97c \uacb0\ud569\ud558\uba74 \uae30\ubcf8 \uac80\uc744 \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc41: \ucc44\uad11\uc774\ub098 \uc57d\ud0c8\uc744 \ud1b5\ud574 \uc790\uc6d0\uc744 \uc218\uc9d1\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc42: \uc778\ubca4\ud1a0\ub9ac\uc5d0\uc11c \ud06c\ub798\ud504\ud305 \uba54\ub274\uc5d0 \uc811\uadfc\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc43: \uc81c\uc791\ud558\ub824\ub294 \uc544\uc774\ud15c\uc744 \uc120\ud0dd\ud558\uace0 \ud544\uc694\ud55c \uc7ac\ub8cc\uac00 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \ud06c\ub798\ud504\ud305\uc740 \uc7a5\ube44\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uace0 \uace0\ub808\ubca8 \ub358\uc804\uc5d0\uc11c \uacbd\uc7c1\ub825\uc744 \uc720\uc9c0\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4."}, {"question": "\ub358\uc804 \ud06c\ub864\ub7ec\uc5d0\uc11c \ub9c8\ubc95\uc0ac \ube4c\ub4dc\uc5d0 \uc6b0\uc120\uc801\uc73c\ub85c \uace0\ub824\ud574\uc57c \ud560 \uc2a4\ud0ac\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub358\uc804 \ud06c\ub864\ub7ec\uc5d0\uc11c \ub9c8\ubc95\uc0ac \ube4c\ub4dc\uc5d0\ub294 \ub9c8\ubc95 \ub2a5\ub825\uc744 \uac15\ud654\ud558\ub294 \uc2a4\ud0ac\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uace0\ub824\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \"\ubd88\ub369\uc774\"\ub294 \uc801 \uadf8\ub8f9\uc744 \ube60\ub974\uac8c \uc18c\ud0d5\ud560 \uc218 \uc788\ub294 \uac15\ub825\ud55c AoE \ub9c8\ubc95\uc785\ub2c8\ub2e4. \ub2e8\uacc41: \ub9c8\ubc95 \uc0ac\uc6a9\uc744 \uc720\uc9c0\ud558\uae30 \uc704\ud574 \ub9c8\ub098 \ud68c\ubcf5\uc744 \ud22c\uc790\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc42: \ub9c8\ubc95\uc758 \uc704\ub825\uc744 \ub192\uc774\uae30 \uc704\ud574 \ub9c8\ubc95 \ub370\ubbf8\uc9c0\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc43: \uc704\ud5d8\ud55c \uc0c1\ud669\uc5d0\uc11c \ubc97\uc5b4\ub098\uae30 \uc704\ud574 \uc774\ub3d9\uc131\uc744 \ud655\ubcf4\ud558\uae30 \uc704\ud574 \"\ud154\ub808\ud3ec\ud2b8\"\ub97c \uace0\ub824\ud558\uc2ed\uc2dc\uc624. \uc774 \ube4c\ub4dc\ub294 \uc720\uc5f0\uc131\uc744 \uc720\uc9c0\ud558\uba74\uc11c \ucd5c\ub300 \ub370\ubbf8\uc9c0\ub97c \uadf9\ub300\ud654\ud558\ub294 \ub370 \uc911\uc810\uc744 \ub461\ub2c8\ub2e4."}, {"question": "\ub358\uc804 \ud06c\ub864\ub7ec\uc758 \ub09c\uc774\ub3c4 \ub808\ubca8 \uac04 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub358\uc804 \ud06c\ub864\ub7ec\ub294 \uac8c\uc784\ud50c\ub808\uc774\uc5d0 \uc0c1\ub2f9\ud55c \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc5ec\ub7ec \ub09c\uc774\ub3c4 \ub808\ubca8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc26c\uc6c0\" \ub09c\uc774\ub3c4\uc5d0\uc11c\ub294 \ubaac\uc2a4\ud130\uac00 \uc801\uc740 \ud53c\ud574\ub97c \uc8fc\uace0 \uccb4\ub825\uc774 \ub0ae\uc73c\ubbc0\ub85c \ucd08\ubcf4\uc790\uc5d0\uac8c \uc774\uc0c1\uc801\uc785\ub2c8\ub2e4. \"\uc5b4\ub824\uc6c0\" \ub09c\uc774\ub3c4\uc5d0\uc11c\ub294 \ubaac\uc2a4\ud130\uac00 \ub354 \uacf5\uaca9\uc801\uc774\uace0 \uc790\uc6d0\uc774 \ubd80\uc871\ud558\uc5ec \uace0\uae09 \uc804\ub7b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \"\uc9c0\uc625\" \ub09c\uc774\ub3c4\ub294 \uc0ac\ub9dd\uc2dc \uce90\ub9ad\ud130\ub97c \uc783\ub294 \uc601\uad6c \uc0ac\ub9dd\uacfc \uac19\uc740 \ub3c5\ud2b9\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \ub3c4\uc785\ud569\ub2c8\ub2e4. \uc790\uc2e0\uac10 \uc788\ub294 \uc218\uc900\uacfc \uc6d0\ud558\ub294 \ub09c\uc774\ub3c4\uc5d0 \ub9de\ub294 \ub09c\uc774\ub3c4\ub97c \uc120\ud0dd\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ub358\uc804 \ud06c\ub864\ub7ec\ub294 \uce90\ub9ad\ud130 \uc131\uc7a5\uacfc \uc2a4\ud0ef \ud560\ub2f9\uc744 \uc5b4\ub5bb\uac8c \ucc98\ub9ac\ud569\ub2c8\uae4c?", "answer": "\ub358\uc804 \ud06c\ub864\ub7ec\uc5d0\uc11c \uce90\ub9ad\ud130 \uc131\uc7a5\uc740 \ub808\ubca8\uc5c5\uacfc \uce90\ub9ad\ud130 \ub2a5\ub825\uc744 \uac15\ud654\ud558\uae30 \uc704\ud55c \uc2a4\ud0ef \uc9c0\uc810 \ud560\ub2f9\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc804\uc0ac\ub294 \uadfc\uc811 \uacf5\uaca9\ub825\uc744 \ub192\uc774\uae30 \uc704\ud574 \ud798\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uace0\ub824\ud560 \uc218 \uc788\uace0, \ub3c4\uc801\uc740 \uce58\uba85\ud0c0\ub97c \ub192\uc774\uae30 \uc704\ud574 \ubbfc\ucca9\uc131\uc5d0 \uc911\uc810\uc744 \ub458 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc41: \ud018\uc2a4\ud2b8\uc640 \uc804\ud22c\ub97c \ud1b5\ud574 \uacbd\ud5d8\uce58\ub97c \uc5bb\uc5b4 \ub808\ubca8\uc5c5\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc42: \uc120\ud0dd\ud55c \ube4c\ub4dc\uc5d0 \ub530\ub77c \uc2a4\ud0ef \uc9c0\uc810\uc744 \ud560\ub2f9\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc43: \ub2e4\ub978 \ub358\uc804\uc5d0\uc11c \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\uae30 \uc704\ud574 \uc815\uae30\uc801\uc73c\ub85c \uc2a4\ud0ef\uc744 \uac80\ud1a0\ud558\uace0 \uc870\uc815\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \ub358\uc804 \ud06c\ub864\ub7ec \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub124, \ub358\uc804 \ud06c\ub864\ub7ec\ub294 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \uc9c4\ud589 \uc0c1\ud669 \uc804\uc1a1\uc744 \uc9c0\uc6d0\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ubaa8\ubc14\uc77c\ub85c \uce90\ub9ad\ud130\ub97c \uc774\ub3d9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc41: \uac8c\uc784\uc774 \ud074\ub77c\uc6b0\ub4dc \uacc4\uc815\uc5d0 \uc5f0\uacb0\ub418\uc5b4 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc42: \uc0c8\ub85c\uc6b4 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc43: \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud558\uc5ec \uc911\ub2e8\ud588\ub358 \uacf3\ubd80\ud130 \uc774\uc5b4\ub098\uac00\uc2ed\uc2dc\uc624. \uc774 \uae30\ub2a5\uc744 \ud1b5\ud574 \uc7a5\uce58 \uac04 \uc6d0\ud65c\ud55c \uac8c\uc784\ud50c\ub808\uc774\ub97c \uac00\ub2a5\ud558\uac8c \ud558\uc5ec \ud798\ub4e0 \ub178\ub825\uc744 \ub0ad\ube44\ud558\uc9c0 \uc54a\ub3c4\ub85d \ud569\ub2c8\ub2e4."}, {"question": "\ub358\uc804 \ud06c\ub864\ub7ec\uc5d0\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub358\uc804 \ud06c\ub864\ub7ec\uc5d0\ub294 \ud0d0\ud5d8\uc744 \ubcf4\uc0c1\ud558\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ub9ce\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc78a\ud600\uc9c4 \uc9c0\ud558\ubb18\uc9c0\"\uc5d0\uc11c \ud2b9\uc815 \ubcbd\uc744 \ubd80\uc218\uba74 \ud76c\uadc0\ud55c \uc804\ub9ac\ud488\uc774 \uc788\ub294 \ube44\ubc00 \ubc29\uc774 \ub4dc\ub7ec\ub0a9\ub2c8\ub2e4. \ub2e4\ub978 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ud2b9\uc815 \uc544\uc774\ud15c \uc870\ud569\uc744 \uc7a5\ucc29\ud558\uc5ec NPC\uc640 \ub3c5\ud2b9\ud55c \ub300\ud654\ub97c \uc5f4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ubcf4\uc11d\uc740 \uac8c\uc784\uc5d0 \uae4a\uc774\ub97c \ub354\ud558\uace0 \ubed4\ud55c \uae38\uc744 \ubc97\uc5b4\ub098 \ubaa8\ud5d8\ud558\ub294 \ud50c\ub808\uc774\uc5b4\ub97c \ubcf4\uc0c1\ud569\ub2c8\ub2e4."}, {"question": "\ub358\uc804 \ud06c\ub864\ub7ec\uc758 \ub358\uc804 \uc0dd\uc131 \uc54c\uace0\ub9ac\uc998\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "\ub358\uc804 \ud06c\ub864\ub7ec\ub294 \uac01 \ud50c\ub808\uc774\ub97c \uc704\ud574 \uace0\uc720\ud55c \ub358\uc804\uc744 \uc0dd\uc131\ud558\ub294 \uc808\ucc28\uc801 \uc0dd\uc131 \uc54c\uace0\ub9ac\uc998\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc54c\uace0\ub9ac\uc998\uc740 \uc0ac\uc804 \uc815\uc758\ub41c \ubc29 \ud15c\ud50c\ub9bf\uc744 \ubaac\uc2a4\ud130 \ubc30\uce58\uc640 \uc804\ub9ac\ud488 \ubd84\ubc30\uc640 \uac19\uc740 \ubb34\uc791\uc704 \uc694\uc18c\uc640 \uacb0\ud569\ud569\ub2c8\ub2e4. \uc774\ub807\uac8c \ud558\uba74 \ub450 \ub358\uc804\uc774 \uc815\ud655\ud788 \uac19\uc9c0 \uc54a\uc544 \ub9e4\ubc88 \uc0c8\ub85c\uc6b4 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub610\ud55c \uc54c\uace0\ub9ac\uc998\uc740 \uce90\ub9ad\ud130\uc758 \ub808\ubca8\uc5d0 \ub530\ub77c \ub09c\uc774\ub3c4\ub97c \uc870\uc815\ud558\uc5ec \uade0\ud615 \uc788\uace0 \ub9e4\ub825\uc801\uc778 \ub3c4\uc804\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}]
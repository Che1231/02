[{"question": "\u5982\u4f55\u57f7\u884c\u5730\u4e0b\u57ce\u722c\u87f2\u904a\u6232\u7684\u57fa\u672c\u79fb\u52d5\u548c\u6230\u9b25\uff1f", "answer": "\u5728\u300a\u5730\u4e0b\u57ce\u722c\u87f2\u300b\u4e2d\uff0c\u57fa\u672c\u79fb\u52d5\u4f7f\u7528 WASD \u9375\u6216\u65b9\u5411\u9375\u63a7\u5236\u3002\u6230\u9b25\u6642\uff0c\u5de6\u9375\u9ede\u64ca\u4ee5\u4f7f\u7528\u4f60\u7684\u4e3b\u8981\u6b66\u5668\u653b\u64ca\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u528d\u5c07\u6703\u5411\u6e38\u6a19\u65b9\u5411\u63ee\u821e\u3002\u8981\u9583\u907f\uff0c\u8acb\u6309\u7a7a\u683c\u9375\uff0c\u9019\u5728\u907f\u514d\u6575\u4eba\u653b\u64ca\u6642\u81f3\u95dc\u91cd\u8981\u3002\u8a18\u4f4f\u7ba1\u7406\u4f60\u7684\u9ad4\u529b\u689d\uff0c\u56e0\u70ba\u9583\u907f\u548c\u653b\u64ca\u90fd\u6703\u6d88\u8017\u9ad4\u529b\u3002\u826f\u597d\u7684\u505a\u6cd5\u662f\u653b\u64ca\u5169\u6b21\uff0c\u7136\u5f8c\u9583\u907f\u4ee5\u907f\u514d\u53cd\u64ca\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u300a\u5730\u4e0b\u57ce\u722c\u87f2\u300b\u4e2d\u7684\u7269\u54c1\u7ba1\u7406\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u5728\u300a\u5730\u4e0b\u57ce\u722c\u87f2\u300b\u4e2d\uff0c\u7269\u54c1\u7ba1\u7406\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u4f60\u7684\u80cc\u5305\u7a7a\u9593\u6709\u9650\u3002\u512a\u5148\u8003\u616e\u5fc5\u8981\u7684\u7269\u54c1\uff0c\u4f8b\u5982\u751f\u547d\u85e5\u6c34\u548c\u6b66\u5668\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u767c\u73fe\u4e00\u628a\u7a00\u6709\u528d\uff0c\u4f46\u4f60\u7684\u80cc\u5305\u5df2\u6eff\uff0c\u53ef\u4ee5\u8003\u616e\u4e1f\u68c4\u4e00\u4ef6\u50f9\u503c\u8f03\u4f4e\u7684\u7269\u54c1\uff0c\u4f8b\u5982\u666e\u901a\u85e5\u6c34\u3002\u5c07\u5e38\u7528\u7269\u54c1\u653e\u7f6e\u5728\u6613\u65bc\u8a2a\u554f\u7684\u63d2\u69fd\u4e2d\uff0c\u4ee5\u78ba\u4fdd\u5728\u6230\u9b25\u6216\u7dca\u6025\u60c5\u6cc1\u4e0b\u53ef\u4ee5\u5feb\u901f\u4f7f\u7528\u5b83\u5011\u3002"}, {"question": "\u5728\u300a\u5730\u4e0b\u57ce\u722c\u87f2\u300b\u4e2d\u5feb\u901f\u63d0\u5347\u7b49\u7d1a\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u8981\u5728\u300a\u5730\u4e0b\u57ce\u722c\u87f2\u300b\u4e2d\u5feb\u901f\u63d0\u5347\u7b49\u7d1a\uff0c\u8acb\u5c08\u6ce8\u65bc\u5b8c\u6210\u4efb\u52d9\u548c\u64ca\u6557\u66f4\u9ad8\u5c64\u7d1a\u7684\u6575\u4eba\u3002\u4f8b\u5982\uff0c\u300c\u54e5\u5e03\u6797\u4e4b\u738b\u300d\u4efb\u52d9\u63d0\u4f9b\u8c50\u539a\u7684\u7d93\u9a57\u503c\u734e\u52f5\u3002\u6b65\u9a5f\u4e00\uff1a\u88dd\u5099\u6700\u4f73\u53ef\u7528\u7684\u88dd\u5099\u4ee5\u6700\u5927\u5316\u4f60\u7684\u50b7\u5bb3\u8f38\u51fa\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u7bc4\u570d\u578b\u6cd5\u8853\u6216\u80fd\u529b\u66f4\u5feb\u5730\u6e05\u9664\u6575\u4eba\u7fa4\u9ad4\u3002\u6b65\u9a5f\u4e09\uff1a\u59cb\u7d42\u651c\u5e36\u751f\u547d\u85e5\u6c34\uff0c\u4ee5\u5728\u6c92\u6709\u64a4\u9000\u7684\u60c5\u6cc1\u4e0b\u7dad\u6301\u66f4\u9577\u6642\u9593\u7684\u6230\u9b25\u3002\u9019\u7a2e\u65b9\u6cd5\u78ba\u4fdd\u6709\u6548\u5730\u7372\u5f97\u7d93\u9a57\u503c\u3002"}, {"question": "\u300a\u5730\u4e0b\u57ce\u722c\u87f2\u300b\u4e2d\u7684\u5de5\u85dd\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u300a\u5730\u4e0b\u57ce\u722c\u87f2\u300b\u4e2d\u7684\u5de5\u85dd\u7cfb\u7d71\u5141\u8a31\u73a9\u5bb6\u5f9e\u6536\u96c6\u5230\u7684\u8cc7\u6e90\u4e2d\u88fd\u4f5c\u5f37\u5927\u7684\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5c07 3 \u500b\u9435\u7926\u548c 1 \u500b\u6728\u982d\u7d44\u5408\u53ef\u4ee5\u88fd\u4f5c\u4e00\u628a\u57fa\u672c\u528d\u3002\u6b65\u9a5f\u4e00\uff1a\u901a\u904e\u63a1\u7926\u6216\u63a0\u596a\u6536\u96c6\u8cc7\u6e90\u3002\u6b65\u9a5f\u4e8c\uff1a\u5f9e\u4f60\u7684\u80cc\u5305\u4e2d\u8a2a\u554f\u5de5\u85dd\u9078\u55ae\u3002\u6b65\u9a5f\u4e09\uff1a\u9078\u64c7\u4f60\u60f3\u8981\u88fd\u4f5c\u7684\u7269\u54c1\uff0c\u4e26\u78ba\u4fdd\u4f60\u6709\u5fc5\u8981\u7684\u6750\u6599\u3002\u5de5\u85dd\u5c0d\u65bc\u5347\u7d1a\u4f60\u7684\u88dd\u5099\u548c\u5728\u66f4\u9ad8\u5c64\u7d1a\u7684\u5730\u4e0b\u57ce\u4e2d\u4fdd\u6301\u7af6\u722d\u529b\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u5728\u300a\u5730\u4e0b\u57ce\u722c\u87f2\u300b\u4e2d\uff0c\u5c0d\u6cd5\u5e2b\u89d2\u8272\u4f86\u8aaa\uff0c\u54ea\u4e9b\u6280\u80fd\u61c9\u512a\u5148\u8003\u616e\uff1f", "answer": "\u5728\u300a\u5730\u4e0b\u57ce\u722c\u87f2\u300b\u4e2d\uff0c\u5c0d\u65bc\u6cd5\u5e2b\u89d2\u8272\u4f86\u8aaa\uff0c\u512a\u5148\u8003\u616e\u90a3\u4e9b\u589e\u5f37\u6cd5\u8853\u80fd\u529b\u7684\u6280\u80fd\u3002\u4f8b\u5982\uff0c\u300c\u706b\u7130\u7403\u300d\u662f\u4e00\u500b\u5f37\u5927\u7684\u7bc4\u570d\u578b\u6cd5\u8853\uff0c\u53ef\u4ee5\u5feb\u901f\u6e05\u9664\u6575\u4eba\u7fa4\u9ad4\u3002\u6b65\u9a5f\u4e00\uff1a\u6295\u8cc7\u65bc\u300c\u9b54\u529b\u518d\u751f\u300d\u4ee5\u7dad\u6301\u4f60\u7684\u6cd5\u8853\u65bd\u653e\u3002\u6b65\u9a5f\u4e8c\uff1a\u5347\u7d1a\u300c\u6cd5\u8853\u50b7\u5bb3\u300d\u4ee5\u63d0\u9ad8\u4f60\u7684\u6cd5\u8853\u6548\u529b\u3002\u6b65\u9a5f\u4e09\uff1a\u8003\u616e\u300c\u50b3\u9001\u300d\u4f86\u63d0\u9ad8\u6a5f\u52d5\u6027\uff0c\u5f9e\u5371\u96aa\u60c5\u6cc1\u4e2d\u9003\u812b\u3002\u6b64\u89d2\u8272\u69cb\u5efa\u91cd\u9ede\u662f\u6700\u5927\u5316\u50b7\u5bb3\u8f38\u51fa\uff0c\u540c\u6642\u4fdd\u6301\u9748\u6d3b\u6027\u3002"}, {"question": "\u300a\u5730\u4e0b\u57ce\u722c\u87f2\u300b\u7684\u96e3\u5ea6\u7b49\u7d1a\u4e4b\u9593\u6709\u4ec0\u9ebc\u95dc\u9375\u5dee\u7570\uff1f", "answer": "\u300a\u5730\u4e0b\u57ce\u722c\u87f2\u300b\u63d0\u4f9b\u591a\u500b\u96e3\u5ea6\u7b49\u7d1a\uff0c\u6bcf\u500b\u96e3\u5ea6\u7b49\u7d1a\u90fd\u6703\u986f\u8457\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\u3002\u4f8b\u5982\uff0c\u5728\u300c\u7c21\u55ae\u300d\u96e3\u5ea6\u4e0b\uff0c\u6575\u4eba\u7684\u50b7\u5bb3\u8f03\u4f4e\uff0c\u751f\u547d\u503c\u4e5f\u8f03\u4f4e\uff0c\u975e\u5e38\u9069\u5408\u65b0\u624b\u3002\u5728\u300c\u56f0\u96e3\u300d\u96e3\u5ea6\u4e0b\uff0c\u6575\u4eba\u66f4\u5177\u653b\u64ca\u6027\uff0c\u8cc7\u6e90\u4e5f\u66f4\u7a00\u7f3a\uff0c\u9700\u8981\u904b\u7528\u5148\u9032\u7684\u7b56\u7565\u3002\u800c\u300c\u5669\u5922\u300d\u96e3\u5ea6\u5247\u5f15\u5165\u4e86\u7368\u7279\u7684\u6a5f\u5236\uff0c\u4f8b\u5982\u6c38\u6046\u6b7b\u4ea1\uff0c\u6b7b\u4ea1\u5c07\u5c0e\u81f4\u4f60\u7684\u4eba\u7269\u6d88\u5931\u3002\u9078\u64c7\u5339\u914d\u4f60\u7684\u6280\u80fd\u6c34\u5e73\u548c\u671f\u671b\u96e3\u5ea6\u7684\u96e3\u5ea6\u3002"}, {"question": "\u300a\u5730\u4e0b\u57ce\u722c\u87f2\u300b\u662f\u5982\u4f55\u8655\u7406\u89d2\u8272\u9032\u968e\u548c\u5c6c\u6027\u5206\u914d\u7684\uff1f", "answer": "\u300a\u5730\u4e0b\u57ce\u722c\u87f2\u300b\u4e2d\u7684\u89d2\u8272\u9032\u968e\u6d89\u53ca\u7b49\u7d1a\u63d0\u5347\u548c\u5c07\u5c6c\u6027\u9ede\u5206\u914d\u7d66\u5f37\u5316\u89d2\u8272\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u6230\u58eb\u53ef\u80fd\u6703\u512a\u5148\u8003\u616e\u529b\u91cf\u4ee5\u63d0\u9ad8\u8fd1\u6230\u50b7\u5bb3\uff0c\u800c\u76dc\u8cca\u5247\u6703\u5c07\u91cd\u9ede\u653e\u5728\u654f\u6377\u6027\u4ee5\u7372\u5f97\u66f4\u597d\u7684\u66b4\u64ca\u7387\u3002\u6b65\u9a5f\u4e00\uff1a\u901a\u904e\u4efb\u52d9\u548c\u6230\u9b25\u7372\u5f97\u7d93\u9a57\u503c\u4f86\u63d0\u5347\u7b49\u7d1a\u3002\u6b65\u9a5f\u4e8c\uff1a\u6839\u64da\u4f60\u9078\u64c7\u7684\u69cb\u5efa\u4f86\u5206\u914d\u5c6c\u6027\u9ede\u3002\u6b65\u9a5f\u4e09\uff1a\u5b9a\u671f\u6aa2\u95b1\u548c\u8abf\u6574\u4f60\u7684\u5c6c\u6027\uff0c\u4ee5\u512a\u5316\u4f60\u5728\u4e0d\u540c\u5730\u4e0b\u57ce\u7684\u8868\u73fe\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5c07\u6211\u7684\u300a\u5730\u4e0b\u57ce\u722c\u87f2\u300b\u9032\u5ea6\u8f49\u79fb\u5230\u4e0d\u540c\u7684\u5e73\u53f0\u55ce\uff1f", "answer": "\u662f\u7684\uff0c\u300a\u5730\u4e0b\u57ce\u722c\u87f2\u300b\u652f\u63f4\u8de8\u5e73\u53f0\u9032\u5ea6\u8f49\u79fb\u3002\u4f8b\u5982\uff0c\u4f60\u53ef\u4ee5\u5c07\u4f60\u7684\u89d2\u8272\u5f9e\u96fb\u8166\u8f49\u79fb\u5230\u624b\u6a5f\u3002\u6b65\u9a5f\u4e00\uff1a\u78ba\u4fdd\u4f60\u7684\u904a\u6232\u5df2\u9023\u7d50\u5230\u96f2\u7aef\u5e33\u6236\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u76f8\u540c\u7684\u5e33\u6236\u767b\u5165\u65b0\u7684\u5e73\u53f0\u3002\u6b65\u9a5f\u4e09\uff1a\u540c\u6b65\u4f60\u7684\u9032\u5ea6\uff0c\u7e7c\u7e8c\u5f9e\u4f60\u96e2\u958b\u7684\u5730\u65b9\u958b\u59cb\u3002\u6b64\u529f\u80fd\u5141\u8a31\u5728\u4e0d\u540c\u8a2d\u5099\u4e4b\u9593\u7121\u7e2b\u9032\u884c\u904a\u6232\uff0c\u78ba\u4fdd\u4f60\u4e0d\u6703\u5931\u53bb\u4f60\u8f9b\u8f9b\u82e6\u82e6\u53d6\u5f97\u7684\u9032\u5ea6\u3002"}, {"question": "\u300a\u5730\u4e0b\u57ce\u722c\u87f2\u300b\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\uff1f", "answer": "\u300a\u5730\u4e0b\u57ce\u722c\u87f2\u300b\u5145\u6eff\u4e86\u96b1\u85cf\u7684\u5f69\u86cb\uff0c\u734e\u52f5\u63a2\u7d22\u3002\u4f8b\u5982\uff0c\u5728\u300c\u907a\u5fd8\u7684\u5893\u7a74\u300d\u4e2d\uff0c\u6253\u7834\u7279\u5b9a\u7246\u58c1\u5c07\u6703\u767c\u73fe\u4e00\u500b\u79d8\u5bc6\u623f\u9593\uff0c\u4e26\u6709\u7a00\u6709\u734e\u52f5\u3002\u53e6\u4e00\u500b\u5f69\u86cb\u9700\u8981\u88dd\u5099\u7279\u5b9a\u7d44\u5408\u7684\u7269\u54c1\u624d\u80fd\u8207 NPC \u89e3\u9396\u7368\u7279\u5c0d\u8a71\u3002\u9019\u4e9b\u96b1\u85cf\u7684\u5bf6\u85cf\u70ba\u904a\u6232\u589e\u6dfb\u6df1\u5ea6\uff0c\u4e26\u734e\u52f5\u90a3\u4e9b\u504f\u96e2\u50b3\u7d71\u8def\u7dda\u7684\u73a9\u5bb6\u3002"}, {"question": "\u300a\u5730\u4e0b\u57ce\u722c\u87f2\u300b\u7684\u5730\u4e0b\u57ce\u751f\u6210\u6f14\u7b97\u6cd5\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u300a\u5730\u4e0b\u57ce\u722c\u87f2\u300b\u4f7f\u7528\u904e\u7a0b\u751f\u6210\u6f14\u7b97\u6cd5\u4f86\u70ba\u6bcf\u500b\u904a\u6232\u6d41\u7a0b\u5275\u5efa\u7368\u7279\u7684\u5730\u4e0b\u57ce\u3002\u4f8b\u5982\uff0c\u8a72\u6f14\u7b97\u6cd5\u5c07\u9810\u5b9a\u7fa9\u7684\u623f\u9593\u6a21\u677f\u8207\u96a8\u6a5f\u5143\u7d20\uff08\u4f8b\u5982\u6575\u4eba\u64fa\u653e\u548c\u734e\u52f5\u5206\u914d\uff09\u7d44\u5408\u3002\u9019\u78ba\u4fdd\u6c92\u6709\u5169\u500b\u5730\u4e0b\u57ce\u5b8c\u5168\u76f8\u540c\uff0c\u6bcf\u6b21\u90fd\u63d0\u4f9b\u65b0\u9bae\u9ad4\u9a57\u3002\u8a72\u6f14\u7b97\u6cd5\u9084\u6703\u6839\u64da\u4f60\u7684\u89d2\u8272\u7b49\u7d1a\u8abf\u6574\u96e3\u5ea6\uff0c\u4fdd\u6301\u6311\u6230\u7684\u5e73\u8861\u548c\u5f15\u4eba\u5165\u52dd\u3002"}]
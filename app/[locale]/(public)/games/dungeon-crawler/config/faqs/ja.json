[{"question": "\u30c0\u30f3\u30b8\u30e7\u30f3\u30fb\u30af\u30ed\u30a6\u30e9\u30fc\u3067\u57fa\u672c\u7684\u306a\u79fb\u52d5\u3068\u6226\u95d8\u3092\u884c\u3046\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30c0\u30f3\u30b8\u30e7\u30f3\u30fb\u30af\u30ed\u30a6\u30e9\u30fc\u3067\u306f\u3001WASD\u30ad\u30fc\u307e\u305f\u306f\u77e2\u5370\u30ad\u30fc\u3092\u4f7f\u7528\u3057\u3066\u57fa\u672c\u7684\u306a\u79fb\u52d5\u3092\u884c\u3044\u307e\u3059\u3002\u6226\u95d8\u3067\u306f\u3001\u30d7\u30e9\u30a4\u30de\u30ea\u6b66\u5668\u3067\u653b\u6483\u3059\u308b\u306b\u306f\u5de6\u30af\u30ea\u30c3\u30af\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5263\u3092\u4f7f\u3046\u3068\u3001\u30ab\u30fc\u30bd\u30eb\u306e\u5411\u304d\u306b\u5263\u304c\u632f\u3089\u308c\u307e\u3059\u3002\u56de\u907f\u3059\u308b\u306b\u306f\u3001\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u3092\u62bc\u3057\u307e\u3059\u3002\u6575\u306e\u653b\u6483\u3092\u56de\u907f\u3059\u308b\u305f\u3081\u306b\u3001\u3053\u308c\u306f\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u56de\u907f\u3068\u653b\u6483\u306b\u306f\u30b9\u30bf\u30df\u30ca\u304c\u5fc5\u8981\u306a\u306e\u3067\u3001\u30b9\u30bf\u30df\u30ca\u30d0\u30fc\u3092\u7ba1\u7406\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u653b\u6483\u30922\u56de\u884c\u3063\u3066\u304b\u3089\u56de\u907f\u3059\u308b\u3053\u3068\u3067\u3001\u53cd\u6483\u3092\u56de\u907f\u3059\u308b\u826f\u3044\u65b9\u6cd5\u3067\u3059\u3002"}, {"question": "\u30c0\u30f3\u30b8\u30e7\u30f3\u30fb\u30af\u30ed\u30a6\u30e9\u30fc\u3067\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u7ba1\u7406\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u30c0\u30f3\u30b8\u30e7\u30f3\u30fb\u30af\u30ed\u30a6\u30e9\u30fc\u3067\u306f\u3001\u30d0\u30c3\u30af\u30d1\u30c3\u30af\u306e\u7a7a\u304d\u30b9\u30ed\u30c3\u30c8\u304c\u9650\u3089\u308c\u3066\u3044\u308b\u305f\u3081\u3001\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u7ba1\u7406\u304c\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u56de\u5fa9\u85ac\u3084\u6b66\u5668\u306a\u3069\u306e\u91cd\u8981\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u8cb4\u91cd\u306a\u5263\u3092\u898b\u3064\u3051\u305f\u304c\u3001\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u304c\u3044\u3063\u3071\u3044\u306a\u3089\u3001\u666e\u901a\u306e\u85ac\u6c34\u306e\u3088\u3046\u306a\u4fa1\u5024\u306e\u4f4e\u3044\u30a2\u30a4\u30c6\u30e0\u3092\u6368\u3066\u308b\u3053\u3068\u3092\u691c\u8a0e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u983b\u7e41\u306b\u4f7f\u3046\u30a2\u30a4\u30c6\u30e0\u3092\u7c21\u5358\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u30b9\u30ed\u30c3\u30c8\u306b\u914d\u7f6e\u3059\u308b\u3053\u3068\u3067\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u3092\u6574\u7406\u3057\u307e\u3057\u3087\u3046\u3002\u6226\u95d8\u4e2d\u3084\u7dca\u6025\u6642\u306b\u3059\u3050\u306b\u305d\u308c\u3089\u3092\u4f7f\u7528\u3067\u304d\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002"}, {"question": "\u30c0\u30f3\u30b8\u30e7\u30f3\u30fb\u30af\u30ed\u30a6\u30e9\u30fc\u3067\u30ec\u30d9\u30eb\u3092\u8fc5\u901f\u306b\u4e0a\u3052\u308b\u305f\u3081\u306e\u6700\u9069\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30c0\u30f3\u30b8\u30e7\u30f3\u30fb\u30af\u30ed\u30a6\u30e9\u30fc\u3067\u30ec\u30d9\u30eb\u3092\u8fc5\u901f\u306b\u4e0a\u3052\u308b\u306b\u306f\u3001\u30af\u30a8\u30b9\u30c8\u3092\u5b8c\u4e86\u3057\u3001\u3088\u308a\u9ad8\u30ec\u30d9\u30eb\u306e\u6575\u3092\u5012\u3059\u3053\u3068\u306b\u96c6\u4e2d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u300c\u30b4\u30d6\u30ea\u30f3\u738b\u300d\u306e\u30af\u30a8\u30b9\u30c8\u3067\u306f\u3001\u304b\u306a\u308a\u306e\u7d4c\u9a13\u5024\u5831\u916c\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6700\u5927\u9650\u306e\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u305f\u3081\u306b\u3001\u5165\u624b\u53ef\u80fd\u306a\u6700\u9ad8\u306e\u88c5\u5099\u3092\u88c5\u5099\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30a8\u30ea\u30a2\u30fb\u30aa\u30d6\u30fb\u30a8\u30d5\u30a7\u30af\u30c8\uff08AoE\uff09\u546a\u6587\u307e\u305f\u306f\u80fd\u529b\u3092\u4f7f\u7528\u3057\u3066\u3001\u6575\u306e\u30b0\u30eb\u30fc\u30d7\u3092\u3088\u308a\u8fc5\u901f\u306b\u6392\u9664\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u64a4\u9000\u3059\u308b\u3053\u3068\u306a\u304f\u3001\u3088\u308a\u9577\u3044\u6226\u95d8\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u3001\u5e38\u306b\u56de\u5fa9\u85ac\u3092\u6301\u3061\u6b69\u304d\u307e\u3059\u3002\u3053\u306e\u65b9\u6cd5\u3067\u52b9\u7387\u7684\u306b\u7d4c\u9a13\u5024\u3092\u7372\u5f97\u3057\u307e\u3059\u3002"}, {"question": "\u30c0\u30f3\u30b8\u30e7\u30f3\u30fb\u30af\u30ed\u30a6\u30e9\u30fc\u3067\u306e\u30af\u30e9\u30d5\u30c8\u30b7\u30b9\u30c6\u30e0\u306e\u4ed5\u7d44\u307f\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30c0\u30f3\u30b8\u30e7\u30f3\u30fb\u30af\u30ed\u30a6\u30e9\u30fc\u306e\u30af\u30e9\u30d5\u30c8\u30b7\u30b9\u30c6\u30e0\u3067\u306f\u3001\u53ce\u96c6\u3057\u305f\u8cc7\u6e90\u304b\u3089\u5f37\u529b\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u4f5c\u6210\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u30013\u500b\u306e\u9244\u9271\u77f3\u30681\u500b\u306e\u6728\u6750\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3068\u3001\u57fa\u672c\u7684\u306a\u5263\u3092\u4f5c\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u63a1\u6398\u307e\u305f\u306f\u7565\u596a\u306b\u3088\u3063\u3066\u8cc7\u6e90\u3092\u53ce\u96c6\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u304b\u3089\u30af\u30e9\u30d5\u30c8\u30e1\u30cb\u30e5\u30fc\u306b\u30a2\u30af\u30bb\u30b9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u4f5c\u6210\u3057\u305f\u3044\u30a2\u30a4\u30c6\u30e0\u3092\u9078\u629e\u3057\u3001\u5fc5\u8981\u306a\u7d20\u6750\u304c\u3042\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30af\u30e9\u30d5\u30c8\u306f\u3001\u88c5\u5099\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u3001\u9ad8\u30ec\u30d9\u30eb\u306e\u30c0\u30f3\u30b8\u30e7\u30f3\u3067\u7af6\u4e89\u529b\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002"}, {"question": "\u30c0\u30f3\u30b8\u30e7\u30f3\u30fb\u30af\u30ed\u30a6\u30e9\u30fc\u306e\u9b54\u6cd5\u4f7f\u3044\u30d3\u30eb\u30c9\u3067\u512a\u5148\u3059\u3079\u304d\u30b9\u30ad\u30eb\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30c0\u30f3\u30b8\u30e7\u30f3\u30fb\u30af\u30ed\u30a6\u30e9\u30fc\u306e\u9b54\u6cd5\u4f7f\u3044\u30d3\u30eb\u30c9\u3067\u306f\u3001\u546a\u6587\u8a60\u5531\u80fd\u529b\u3092\u9ad8\u3081\u308b\u30b9\u30ad\u30eb\u3092\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u300c\u30d5\u30a1\u30a4\u30a2\u30dc\u30fc\u30eb\u300d\u306f\u3001\u6575\u306e\u30b0\u30eb\u30fc\u30d7\u3092\u7d20\u65e9\u304f\u4e00\u6383\u3067\u304d\u308b\u5f37\u529b\u306aAoE\u546a\u6587\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u546a\u6587\u8a60\u5531\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u300c\u30de\u30ca\u518d\u751f\u300d\u306b\u6295\u8cc7\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u546a\u6587\u306e\u5a01\u529b\u3092\u9ad8\u3081\u308b\u305f\u3081\u306b\u300c\u546a\u6587\u30c0\u30e1\u30fc\u30b8\u300d\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5371\u967a\u306a\u72b6\u6cc1\u304b\u3089\u8131\u51fa\u3059\u308b\u305f\u3081\u306e\u6a5f\u52d5\u6027\u306e\u305f\u3081\u306b\u300c\u30c6\u30ec\u30dd\u30fc\u30c8\u300d\u3092\u691c\u8a0e\u3057\u307e\u3059\u3002\u3053\u306e\u30d3\u30eb\u30c9\u306f\u3001\u67d4\u8edf\u6027\u3092\u7dad\u6301\u3057\u306a\u304c\u3089\u6700\u5927\u9650\u306e\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u3053\u3068\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u3044\u307e\u3059\u3002"}, {"question": "\u30c0\u30f3\u30b8\u30e7\u30f3\u30fb\u30af\u30ed\u30a6\u30e9\u30fc\u306e\u96e3\u6613\u5ea6\u30ec\u30d9\u30eb\u9593\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30c0\u30f3\u30b8\u30e7\u30f3\u30fb\u30af\u30ed\u30a6\u30e9\u30fc\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u5927\u304d\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u8907\u6570\u306e\u96e3\u6613\u5ea6\u30ec\u30d9\u30eb\u3092\u63d0\u4f9b\u3057\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u7c21\u5358\u300d\u3067\u306f\u3001\u6575\u306e\u4e0e\u3048\u308b\u30c0\u30e1\u30fc\u30b8\u304c\u5c11\u306a\u304f\u3001\u4f53\u529b\u3082\u4f4e\u3044\u306e\u3067\u3001\u521d\u5fc3\u8005\u5411\u3051\u3067\u3059\u3002\u300c\u56f0\u96e3\u300d\u3067\u306f\u3001\u6575\u306f\u3088\u308a\u653b\u6483\u7684\u3067\u3001\u8cc7\u6e90\u306f\u4e0d\u8db3\u3057\u3066\u3044\u308b\u306e\u3067\u3001\u9ad8\u5ea6\u306a\u6226\u7565\u304c\u5fc5\u8981\u3067\u3059\u3002\u300c\u60aa\u5922\u300d\u306e\u96e3\u6613\u5ea6\u3067\u306f\u3001\u6b7b\u4ea1\u6642\u306b\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u5931\u3046\u30d1\u30fc\u30de\u30cd\u30f3\u30c8\u30c7\u30b9\u306e\u3088\u3046\u306a\u30e6\u30cb\u30fc\u30af\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u304c\u5c0e\u5165\u3055\u308c\u307e\u3059\u3002\u81ea\u5206\u306e\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u3068\u671b\u3080\u6311\u6226\u5ea6\u306b\u5408\u308f\u305b\u305f\u96e3\u6613\u5ea6\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30c0\u30f3\u30b8\u30e7\u30f3\u30fb\u30af\u30ed\u30a6\u30e9\u30fc\u306f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u9032\u884c\u3068\u30b9\u30c6\u30fc\u30bf\u30b9\u914d\u5206\u3092\u3069\u306e\u3088\u3046\u306b\u6271\u3044\u307e\u3059\u304b\uff1f", "answer": "\u30c0\u30f3\u30b8\u30e7\u30f3\u30fb\u30af\u30ed\u30a6\u30e9\u30fc\u3067\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u9032\u884c\u306b\u306f\u3001\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u3068\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u80fd\u529b\u3092\u5f37\u5316\u3059\u308b\u305f\u3081\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u30dd\u30a4\u30f3\u30c8\u306e\u914d\u5206\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6226\u58eb\u306f\u8fd1\u63a5\u653b\u6483\u30c0\u30e1\u30fc\u30b8\u3092\u5897\u3084\u3059\u305f\u3081\u306b\u529b\u306b\u512a\u5148\u9806\u4f4d\u3092\u4ed8\u3051\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u4e00\u65b9\u3001\u5fcd\u8005\uff08\u308d\u3046\u306b\u3093\uff09\u306f\u3088\u308a\u826f\u3044\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u306e\u305f\u3081\u306b\u5668\u7528\u3055\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30af\u30a8\u30b9\u30c8\u3068\u6226\u95d8\u304b\u3089\u7d4c\u9a13\u5024\u3092\u7372\u5f97\u3057\u3066\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u9078\u629e\u3057\u305f\u30d3\u30eb\u30c9\u306b\u57fa\u3065\u3044\u3066\u30b9\u30c6\u30fc\u30bf\u30b9\u30dd\u30a4\u30f3\u30c8\u3092\u5272\u308a\u5f53\u3066\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u3055\u307e\u3056\u307e\u306a\u30c0\u30f3\u30b8\u30e7\u30f3\u3067\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u305f\u3081\u306b\u3001\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u5b9a\u671f\u7684\u306b\u898b\u76f4\u3057\u3001\u8abf\u6574\u3057\u307e\u3059\u3002"}, {"question": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u79c1\u306e\u30c0\u30f3\u30b8\u30e7\u30f3\u30fb\u30af\u30ed\u30a6\u30e9\u30fc\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30c0\u30f3\u30b8\u30e7\u30f3\u30fb\u30af\u30ed\u30a6\u30e9\u30fc\u306f\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u9032\u884c\u72b6\u6cc1\u8ee2\u9001\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001PC\u304b\u3089\u30e2\u30d0\u30a4\u30eb\u306b\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u79fb\u52d5\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b2\u30fc\u30e0\u304c\u30af\u30e9\u30a6\u30c9\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ea\u30f3\u30af\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u65b0\u3057\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u3067\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u9032\u884c\u72b6\u6cc1\u3092\u540c\u671f\u3057\u3066\u3001\u4e2d\u65ad\u3057\u305f\u3068\u3053\u308d\u304b\u3089\u30d7\u30ec\u30a4\u3092\u7d9a\u3051\u307e\u3059\u3002\u3053\u306e\u6a5f\u80fd\u306b\u3088\u308a\u3001\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u30b7\u30fc\u30e0\u30ec\u30b9\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u304c\u53ef\u80fd\u306b\u306a\u308a\u3001\u82e6\u52b4\u3057\u3066\u7372\u5f97\u3057\u305f\u9032\u884c\u72b6\u6cc1\u3092\u5931\u3046\u3053\u3068\u304c\u3042\u308a\u307e\u305b\u3093\u3002"}, {"question": "\u30c0\u30f3\u30b8\u30e7\u30f3\u30fb\u30af\u30ed\u30a6\u30e9\u30fc\u306b\u306f\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30c0\u30f3\u30b8\u30e7\u30f3\u30fb\u30af\u30ed\u30a6\u30e9\u30fc\u306b\u306f\u3001\u63a2\u691c\u3092\u5831\u3044\u308b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u305f\u304f\u3055\u3093\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u5fd8\u308c\u3089\u308c\u305f\u5893\u6240\u300d\u3067\u306f\u3001\u7279\u5b9a\u306e\u58c1\u3092\u58ca\u3059\u3068\u3001\u30ec\u30a2\u306a\u6226\u5229\u54c1\u304c\u3042\u308b\u79d8\u5bc6\u306e\u90e8\u5c4b\u304c\u73fe\u308c\u307e\u3059\u3002\u3082\u3046\u4e00\u3064\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3001\u7279\u5b9a\u306e\u30a2\u30a4\u30c6\u30e0\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u88c5\u5099\u3057\u3066NPC\u3068\u306e\u30e6\u30cb\u30fc\u30af\u306a\u4f1a\u8a71\u3092\u5f15\u304d\u51fa\u3059\u3053\u3068\u3067\u3059\u3002\u3053\u308c\u3089\u306e\u96a0\u308c\u305f\u5b9d\u77f3\u306f\u3001\u30b2\u30fc\u30e0\u306b\u5965\u884c\u304d\u3092\u52a0\u3048\u3001\u305f\u3069\u308a\u7740\u304b\u306a\u3044\u5834\u6240\u306b\u5192\u967a\u3059\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u5831\u3044\u307e\u3059\u3002"}, {"question": "\u30c0\u30f3\u30b8\u30e7\u30f3\u30fb\u30af\u30ed\u30a6\u30e9\u30fc\u306e\u30c0\u30f3\u30b8\u30e7\u30f3\u751f\u6210\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306e\u4ed5\u7d44\u307f\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30c0\u30f3\u30b8\u30e7\u30f3\u30fb\u30af\u30ed\u30a6\u30e9\u30fc\u306f\u3001\u5404\u30d7\u30ec\u30a4\u3092\u901a\u3057\u3066\u30e6\u30cb\u30fc\u30af\u306a\u30c0\u30f3\u30b8\u30e7\u30f3\u3092\u4f5c\u6210\u3059\u308b\u305f\u3081\u306e\u624b\u9806\u7684\u306a\u751f\u6210\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u3092\u4f7f\u7528\u3057\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u3053\u306e\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u3042\u3089\u304b\u3058\u3081\u5b9a\u7fa9\u3055\u308c\u305f\u90e8\u5c4b\u306e\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u3092\u3001\u6575\u306e\u914d\u7f6e\u3084\u6226\u5229\u54c1\u306e\u914d\u5e03\u306a\u3069\u306e\u30e9\u30f3\u30c0\u30e0\u306a\u8981\u7d20\u3068\u7d44\u307f\u5408\u308f\u305b\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u30012\u3064\u306e\u30c0\u30f3\u30b8\u30e7\u30f3\u304c\u5168\u304f\u540c\u3058\u306b\u306a\u308b\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u6bce\u56de\u65b0\u9bae\u306a\u4f53\u9a13\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u3053\u306e\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u3042\u306a\u305f\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u30ec\u30d9\u30eb\u306b\u57fa\u3065\u3044\u3066\u96e3\u6613\u5ea6\u3092\u8abf\u6574\u3057\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u53d6\u308c\u305f\u9b45\u529b\u7684\u306a\u6311\u6226\u3092\u7dad\u6301\u3057\u307e\u3059\u3002"}]
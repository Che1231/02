[{"question": "\u5982\u4f55\u958b\u59cb\u4ee5\u5b8c\u5168\u65b0\u624b\u7684\u8eab\u5206\u904a\u73a9\u5192\u96aa\u5bb6\u963f\u66fc\u9054 2\uff1f", "answer": "\u8981\u958b\u59cb\u904a\u73a9\u5192\u96aa\u5bb6\u963f\u66fc\u9054 2\uff0c\u9996\u5148\uff0c\u8acb\u78ba\u4fdd\u60a8\u7684\u88dd\u7f6e\u7b26\u5408\u6700\u4f4e\u7cfb\u7d71\u9700\u6c42\u3002\u7136\u5f8c\uff0c\u5f9e\u5b98\u65b9\u5546\u5e97\u6216\u7db2\u7ad9\u4e0b\u8f09\u904a\u6232\u3002\u5b89\u88dd\u5b8c\u6210\u5f8c\uff0c\u555f\u52d5\u904a\u6232\u4e26\u5b8c\u6210\u521d\u59cb\u6559\u5b78\uff0c\u6559\u5b78\u6703\u4ecb\u7d39\u57fa\u672c\u63a7\u5236\uff0c\u4f8b\u5982\u79fb\u52d5\uff08WASD \u9375\uff09\u548c\u4e92\u52d5\uff08E \u9375\uff09\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u95dc\uff0c\u60a8\u5c07\u4f7f\u7528\u9019\u4e9b\u63a7\u5236\u9375\u4f86\u5f15\u5c0e\u963f\u66fc\u9054\u7a7f\u904e\u68ee\u6797\u3002\u8a18\u4f4f\u6aa2\u67e5\u904a\u6232\u5167\u8a2d\u5b9a\uff0c\u4ee5\u6839\u64da\u60a8\u7684\u559c\u597d\u8abf\u6574\u63a7\u5236\u9805\u3002"}, {"question": "\u5728\u5192\u96aa\u5bb6\u963f\u66fc\u9054 2 \u4e2d\uff0c\u6211\u9700\u8981\u7cbe\u901a\u54ea\u4e9b\u5fc5\u8981\u7684\u63a7\u5236\u9805\uff1f", "answer": "\u5728\u5192\u96aa\u5bb6\u963f\u66fc\u9054 2 \u4e2d\u7cbe\u901a\u5fc5\u8981\u7684\u63a7\u5236\u9805\uff0c\u5305\u62ec\u7406\u89e3\u79fb\u52d5\u3001\u4e92\u52d5\u548c\u6230\u9b25\u3002\u79fb\u52d5\u4f7f\u7528 WASD \u9375\u63a7\u5236\uff0c\u800c E \u9375\u7528\u65bc\u4e92\u52d5\uff0c\u4f8b\u5982\u958b\u555f\u9580\u6216\u8207 NPC \u5c0d\u8a71\u3002\u5c0d\u65bc\u6230\u9b25\uff0c\u5de6\u9375\u7528\u65bc\u653b\u64ca\uff0c\u53f3\u9375\u7528\u65bc\u683c\u64cb\u3002\u4f8b\u5982\uff0c\u5728\u65e9\u671f\u95dc\u5361\u4e2d\uff0c\u60a8\u9700\u8981\u4f7f\u7528\u9019\u4e9b\u63a7\u5236\u9805\u4f86\u64ca\u6557\u6575\u4eba\u4e26\u89e3\u958b\u8b0e\u984c\u3002\u5728\u5b89\u5168\u5340\u57df\u7df4\u7fd2\u9019\u4e9b\u63a7\u5236\u9805\uff0c\u4ee5\u5efa\u7acb\u4fe1\u5fc3\u3002"}, {"question": "\u5728\u5192\u96aa\u5bb6\u963f\u66fc\u9054 2 \u4e2d\uff0c\u70ba\u4ec0\u9ebc\u6709\u6548\u5730\u7ba1\u7406\u7269\u54c1\u6b04\u5f88\u91cd\u8981\uff1f", "answer": "\u5728\u5192\u96aa\u5bb6\u963f\u66fc\u9054 2 \u4e2d\uff0c\u6709\u6548\u7ba1\u7406\u7269\u54c1\u6b04\u5c0d\u65bc\u6700\u5927\u5316\u8cc7\u6e90\u4e26\u78ba\u4fdd\u60a8\u64c1\u6709\u5404\u7a2e\u6311\u6230\u6240\u9700\u7684\u7269\u54c1\u81f3\u95dc\u91cd\u8981\u3002\u7269\u54c1\u6b04\u7cfb\u7d71\u5141\u8a31\u60a8\u651c\u5e36\u6709\u9650\u7684\u7269\u54c1\uff0c\u56e0\u6b64\u8acb\u512a\u5148\u8003\u616e\u5fc5\u8981\u7684\u7269\u54c1\uff0c\u4f8b\u5982\u5065\u5eb7\u85e5\u6c34\u548c\u4efb\u52d9\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5728\u300c\u5931\u843d\u795e\u5edf\u300d\u4efb\u52d9\u4e2d\uff0c\u64c1\u6709\u6b63\u78ba\u7684\u5de5\u5177\uff0c\u53ef\u80fd\u6c7a\u5b9a\u6210\u529f\u8207\u5931\u6557\u7684\u5dee\u5225\u3002\u5b9a\u671f\u6574\u7406\u60a8\u7684\u7269\u54c1\u6b04\uff0c\u4e1f\u68c4\u6216\u5132\u5b58\u4e0d\u5fc5\u8981\u7684\u7269\u54c1\u3002"}, {"question": "\u5982\u4f55\u5728\u5192\u96aa\u5bb6\u963f\u66fc\u9054 2 \u4e2d\u6700\u4f73\u5316\u6280\u80fd\u6a39\u9032\u5ea6\uff1f", "answer": "\u5728\u5192\u96aa\u5bb6\u963f\u66fc\u9054 2 \u4e2d\u6700\u4f73\u5316\u60a8\u7684\u6280\u80fd\u6a39\uff0c\u5305\u62ec\u57fa\u65bc\u60a8\u7684\u904a\u6232\u98a8\u683c\u5236\u5b9a\u7b56\u7565\u3002\u9996\u5148\uff0c\u8a55\u4f30\u53ef\u7528\u7684\u6280\u80fd\uff0c\u4e26\u9078\u64c7\u90a3\u4e9b\u80fd\u88dc\u5145\u60a8\u504f\u597d\u7684\u6230\u9b25\u98a8\u683c\u7684\u6280\u80fd\uff0c\u7121\u8ad6\u662f\u8fd1\u6230\u3001\u9060\u7a0b\u9084\u662f\u9b54\u6cd5\u3002\u5176\u6b21\uff0c\u512a\u5148\u8003\u616e\u63d0\u4f9b\u7acb\u5373\u597d\u8655\u7684\u6280\u80fd\uff0c\u4f8b\u5982\u589e\u52a0\u50b7\u5bb3\u6216\u6062\u5fa9\u751f\u547d\u503c\u3002\u4f8b\u5982\uff0c\u65e9\u671f\u6295\u8cc7\u300c\u5200\u6cd5\u5927\u5e2b\u300d\u6280\u80fd\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u60a8\u7684\u8fd1\u6230\u6230\u9b25\u6548\u7387\u3002\u6700\u5f8c\uff0c\u96a8\u8457\u904a\u6232\u9032\u5ea6\uff0c\u5b9a\u671f\u6aa2\u8996\u4e26\u8abf\u6574\u60a8\u7684\u6280\u80fd\u6a39\u3002"}, {"question": "\u6211\u53ef\u4ee5\u4f7f\u7528\u54ea\u4e9b\u7b56\u7565\u4f86\u64ca\u6557\u5192\u96aa\u5bb6\u963f\u66fc\u9054 2 \u7684\u6700\u7d42\u9996\u9818\uff1f", "answer": "\u64ca\u6557\u5192\u96aa\u5bb6\u963f\u66fc\u9054 2 \u7684\u6700\u7d42\u9996\u9818\u9700\u8981\u7d50\u5408\u6e96\u5099\u3001\u7b56\u7565\u548c\u57f7\u884c\u3002\u6b65\u9a5f\u4e00\uff1a\u88dd\u5099\u6700\u4f73\u88dd\u5099\u4e26\u5132\u5099\u5065\u5eb7\u85e5\u6c34\u3002\u6b65\u9a5f\u4e8c\uff1a\u7814\u7a76\u9996\u9818\u7684\u653b\u64ca\u6a21\u5f0f\u4e26\u5c0b\u627e\u5b89\u5168\u5730\u9ede\u4ee5\u907f\u514d\u50b7\u5bb3\u3002\u6b65\u9a5f\u4e09\uff1a\u5728\u9996\u9818\u7684\u8106\u5f31\u6642\u523b\u4f7f\u7528\u60a8\u6700\u5f37\u5927\u7684\u6280\u80fd\u3002\u4f8b\u5982\uff0c\u5728\u300c\u9ed1\u6697\u5deb\u5e2b\u300d\u9996\u9818\u6230\u9b25\u4e2d\uff0c\u5728\u5deb\u5e2b\u65bd\u6cd5\u5f8c\u767c\u52d5\u653b\u64ca\uff0c\u53ef\u4ee5\u626d\u8f49\u6230\u5c40\u3002\u7df4\u7fd2\u9019\u4e9b\u6b65\u9a5f\uff0c\u4ee5\u63d0\u9ad8\u60a8\u7684\u6210\u529f\u6a5f\u7387\u3002"}, {"question": "\u54ea\u7a2e\u968a\u4f0d\u7d44\u5408\u6700\u9069\u5408\u5192\u96aa\u5bb6\u963f\u66fc\u9054 2 \u7684\u9ad8\u968e\u5730\u7262\uff1f", "answer": "\u5728\u5192\u96aa\u5bb6\u963f\u66fc\u9054 2 \u7684\u9ad8\u968e\u5730\u7262\u4e2d\uff0c\u5e73\u8861\u7684\u968a\u4f0d\u7d44\u5408\u81f3\u95dc\u91cd\u8981\u3002\u5178\u578b\u8a2d\u7f6e\u5305\u62ec\u5766\u514b\uff08\u5438\u6536\u50b7\u5bb3\uff09\u3001\u6cbb\u7642\u5e2b\uff08\u7dad\u6301\u968a\u4f0d\u751f\u547d\uff09\u548c\u5169\u500b\u8f38\u51fa\u89d2\u8272\uff08\u9020\u6210\u50b7\u5bb3\uff09\u3002\u4f8b\u5982\uff0c\u5728\u300c\u6c38\u6046\u6df1\u6df5\u300d\u5730\u7262\u4e2d\uff0c\u4ee5\u963f\u66fc\u9054\u64d4\u4efb\u5766\u514b\u3001\u7267\u5e2b\u6cbb\u7642\u3001\u4ee5\u53ca\u5169\u4f4d\u6cd5\u5e2b\u64d4\u4efb\u8f38\u51fa\u89d2\u8272\u7684\u968a\u4f0d\uff0c\u53ef\u4ee5\u61c9\u5c0d\u5927\u90e8\u5206\u6311\u6230\u3002\u6839\u64da\u5730\u7262\u7684\u7279\u5b9a\u6a5f\u5236\u548c\u6575\u4eba\u985e\u578b\u8abf\u6574\u60a8\u7684\u968a\u4f0d\u7d44\u6210\u3002"}, {"question": "\u5192\u96aa\u5bb6\u963f\u66fc\u9054 2 \u7684\u5de5\u85dd\u7cfb\u7d71\u5982\u4f55\u63d0\u5347\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u5192\u96aa\u5bb6\u963f\u66fc\u9054 2 \u7684\u5de5\u85dd\u7cfb\u7d71\u6dfb\u52a0\u4e86\u904a\u6232\u7684\u6df1\u5ea6\uff0c\u8b93\u73a9\u5bb6\u53ef\u4ee5\u88fd\u4f5c\u5f37\u5927\u7684\u7269\u54c1\u548c\u88dd\u5099\u3002\u900f\u904e\u6536\u96c6\u8cc7\u6e90\u548c\u4f7f\u7528\u5de5\u85dd\u7ad9\uff0c\u60a8\u53ef\u4ee5\u88fd\u4f5c\u6b66\u5668\u3001\u76d4\u7532\u548c\u6d88\u8017\u54c1\uff0c\u9019\u4e9b\u901a\u5e38\u6bd4\u5728\u91ce\u5916\u627e\u5230\u7684\u66f4\u597d\u3002\u4f8b\u5982\uff0c\u88fd\u4f5c\u300c\u9f8d\u9aa8\u528d\u300d\u9700\u8981\u7a00\u6709\u6750\u6599\uff0c\u4f46\u63d0\u4f9b\u986f\u8457\u7684\u6230\u9b25\u512a\u52e2\u3002\u6b64\u7cfb\u7d71\u9f13\u52f5\u63a2\u7d22\u548c\u8cc7\u6e90\u7ba1\u7406\uff0c\u8c50\u5bcc\u6574\u9ad4\u9ad4\u9a57\u3002"}, {"question": "\u5192\u96aa\u5bb6\u963f\u66fc\u9054 2 \u7684\u4e0d\u540c\u96e3\u5ea6\u6a21\u5f0f\u4e4b\u9593\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "\u5192\u96aa\u5bb6\u963f\u66fc\u9054 2 \u7684\u4e0d\u540c\u96e3\u5ea6\u6a21\u5f0f\u6703\u5f71\u97ff\u904a\u6232\u7684\u5404\u500b\u65b9\u9762\uff0c\u5305\u62ec\u6575\u4eba\u7684\u5f37\u5ea6\u3001\u8cc7\u6e90\u7684\u53ef\u7528\u6027\u4ee5\u53ca\u7d93\u9a57\u7684\u7372\u5f97\u3002\u7c21\u55ae\u6a21\u5f0f\u5c08\u70ba\u4f11\u9592\u73a9\u5bb6\u8a2d\u8a08\uff0c\u63d0\u4f9b\u66f4\u591a\u8cc7\u6e90\u548c\u8f03\u5f31\u7684\u6575\u4eba\u3002\u666e\u901a\u6a21\u5f0f\u63d0\u4f9b\u5e73\u8861\u7684\u9ad4\u9a57\uff0c\u800c\u56f0\u96e3\u6a21\u5f0f\u5247\u6703\u6311\u6230\u73a9\u5bb6\u9762\u5c0d\u66f4\u5f37\u5927\u7684\u6575\u4eba\u548c\u6709\u9650\u7684\u8cc7\u6e90\u3002\u4f8b\u5982\uff0c\u5728\u56f0\u96e3\u6a21\u5f0f\u4e2d\uff0c\u300c\u971c\u5cf0\u300d\u5340\u57df\u7684\u6575\u4eba\u64c1\u6709\u66f4\u9ad8\u7684\u751f\u547d\u503c\u548c\u50b7\u5bb3\uff0c\u9700\u8981\u66f4\u5177\u7b56\u7565\u6027\u7684\u904a\u6232\u65b9\u5f0f\u3002"}, {"question": "\u5982\u4f55\u5728\u5192\u96aa\u5bb6\u963f\u66fc\u9054 2 \u4e2d\u5c07\u5132\u5b58\u8cc7\u6599\u5f9e\u4e00\u500b\u5e73\u53f0\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u5e73\u53f0\uff1f", "answer": "\u5728\u5192\u96aa\u5bb6\u963f\u66fc\u9054 2 \u4e2d\uff0c\u5c07\u5132\u5b58\u8cc7\u6599\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u5e73\u53f0\u9700\u8981\u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u6216\u624b\u52d5\u6a94\u6848\u8f49\u79fb\u3002\u5982\u679c\u904a\u6232\u652f\u63f4\u96f2\u7aef\u5132\u5b58\uff0c\u8acb\u78ba\u4fdd\u60a8\u5728\u5169\u500b\u5e73\u53f0\u4e0a\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u3002\u5c0d\u65bc\u624b\u52d5\u8f49\u79fb\uff0c\u8acb\u5728\u60a8\u7684\u539f\u59cb\u5e73\u53f0\u4e0a\u627e\u5230\u5132\u5b58\u6a94\u6848\uff08\u901a\u5e38\u4f4d\u65bc\u904a\u6232\u5b89\u88dd\u76ee\u9304\u4e2d\uff09\uff0c\u4e26\u5c07\u5176\u8907\u88fd\u5230\u65b0\u5e73\u53f0\u7684\u76f8\u61c9\u4f4d\u7f6e\u3002\u4f8b\u5982\uff0c\u5f9e\u96fb\u8166\u8f49\u79fb\u5230\u904a\u6232\u6a5f\uff0c\u53ef\u80fd\u9700\u8981\u4f7f\u7528 USB \u78c1\u789f\u6a5f\u4f86\u8f49\u79fb\u5132\u5b58\u6a94\u6848\u3002"}, {"question": "\u5728\u5192\u96aa\u5bb6\u963f\u66fc\u9054 2 \u4e2d\uff0c\u6211\u53ef\u4ee5\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u7684\u79d8\u5bc6\uff1f", "answer": "\u5192\u96aa\u5bb6\u963f\u66fc\u9054 2 \u4e2d\u5145\u6eff\u4e86\u96b1\u85cf\u7684\u79d8\u5bc6\uff0c\u734e\u52f5\u63a2\u7d22\u548c\u597d\u5947\u5fc3\u3002\u4e00\u500b\u986f\u8457\u7684\u79d8\u5bc6\u662f\u300c\u5fa9\u6d3b\u7bc0\u5f69\u86cb\u300d\u623f\u9593\uff0c\u901a\u904e\u89e3\u6c7a\u300c\u53e4\u4ee3\u907a\u8e5f\u300d\u5340\u57df\u4e2d\u7684\u4e00\u500b\u795e\u79d8\u8b0e\u984c\u624d\u80fd\u9032\u5165\u3002\u6b64\u623f\u9593\u5305\u542b\u7a00\u6709\u7269\u54c1\u548c\u8c50\u5bcc\u904a\u6232\u6545\u4e8b\u7684\u77e5\u8b58\u7247\u6bb5\u3002\u4f8b\u5982\uff0c\u5728\u6b64\u623f\u9593\u627e\u5230\u300c\u5931\u843d\u5377\u8ef8\u300d\uff0c\u6703\u63ed\u793a\u6709\u95dc\u904a\u6232\u4e16\u754c\u80cc\u666f\u7684\u4fe1\u606f\u3002\u8acb\u7559\u610f\u5fae\u5999\u7684\u7dda\u7d22\uff0c\u4e26\u8207\u74b0\u5883\u4e92\u52d5\uff0c\u4ee5\u767c\u73fe\u9019\u4e9b\u96b1\u85cf\u7684\u5bf6\u85cf\u3002"}]
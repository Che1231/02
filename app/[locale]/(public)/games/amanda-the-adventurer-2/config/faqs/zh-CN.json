[{"question": "\u5982\u4f55\u5f00\u59cb\u4ee5\u65b0\u624b\u8eab\u4efd\u73a9\u300a\u5192\u9669\u8005\u963f\u66fc\u8fbe2\u300b\uff1f", "answer": "\u8981\u5f00\u59cb\u73a9\u300a\u5192\u9669\u8005\u963f\u66fc\u8fbe2\u300b\uff0c\u9996\u5148\uff0c\u786e\u4fdd\u4f60\u7684\u8bbe\u5907\u6ee1\u8db3\u6700\u4f4e\u7cfb\u7edf\u8981\u6c42\u3002\u7136\u540e\uff0c\u4ece\u5b98\u65b9\u5546\u5e97\u6216\u7f51\u7ad9\u4e0b\u8f7d\u6e38\u620f\u3002\u5b89\u88c5\u5b8c\u6210\u540e\uff0c\u542f\u52a8\u6e38\u620f\u5e76\u5b8c\u6210\u521d\u59cb\u6559\u7a0b\uff0c\u8be5\u6559\u7a0b\u4ecb\u7ecd\u4e86\u57fa\u672c\u63a7\u5236\uff0c\u4f8b\u5982\u79fb\u52a8\uff08WASD\u952e\uff09\u548c\u4ea4\u4e92\uff08E\u952e\uff09\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u4e2a\u5173\u5361\u4e2d\uff0c\u4f60\u5c06\u4f7f\u7528\u8fd9\u4e9b\u63a7\u5236\u6309\u952e\u5f15\u5bfc\u963f\u66fc\u8fbe\u7a7f\u8fc7\u68ee\u6797\u3002\u8bf7\u8bb0\u5f97\u67e5\u770b\u6e38\u620f\u8bbe\u7f6e\uff0c\u4ee5\u8c03\u6574\u63a7\u5236\u952e\u4ee5\u9002\u5e94\u4f60\u7684\u559c\u597d\u3002"}, {"question": "\u5728\u300a\u5192\u9669\u8005\u963f\u66fc\u8fbe2\u300b\u4e2d\uff0c\u6211\u9700\u8981\u7cbe\u901a\u54ea\u4e9b\u5fc5\u5907\u63a7\u5236\uff1f", "answer": "\u5728\u300a\u5192\u9669\u8005\u963f\u66fc\u8fbe2\u300b\u4e2d\u7cbe\u901a\u5fc5\u5907\u63a7\u5236\uff0c\u9700\u8981\u4e86\u89e3\u79fb\u52a8\u3001\u4ea4\u4e92\u548c\u6218\u6597\u3002\u79fb\u52a8\u4f7f\u7528WASD\u952e\u63a7\u5236\uff0cE\u952e\u7528\u4e8e\u4ea4\u4e92\uff0c\u4f8b\u5982\u6253\u5f00\u95e8\u6216\u4e0eNPC\u5bf9\u8bdd\u3002\u6218\u6597\u4e2d\uff0c\u5de6\u952e\u7528\u4e8e\u653b\u51fb\uff0c\u53f3\u952e\u7528\u4e8e\u9632\u5fa1\u3002\u4f8b\u5982\uff0c\u5728\u65e9\u671f\u5173\u5361\u4e2d\uff0c\u4f60\u9700\u8981\u4f7f\u7528\u8fd9\u4e9b\u63a7\u5236\u6765\u51fb\u8d25\u654c\u4eba\u5e76\u89e3\u51b3\u8c1c\u9898\u3002\u5728\u5b89\u5168\u533a\u57df\u7ec3\u4e60\u8fd9\u4e9b\u63a7\u5236\uff0c\u4ee5\u5efa\u7acb\u4fe1\u5fc3\u3002"}, {"question": "\u5728\u300a\u5192\u9669\u8005\u963f\u66fc\u8fbe2\u300b\u4e2d\uff0c\u6709\u6548\u7ba1\u7406\u7269\u54c1\u680f\u4e3a\u4ec0\u4e48\u91cd\u8981\uff1f", "answer": "\u5728\u300a\u5192\u9669\u8005\u963f\u66fc\u8fbe2\u300b\u4e2d\uff0c\u6709\u6548\u7ba1\u7406\u7269\u54c1\u680f\u81f3\u5173\u91cd\u8981\uff0c\u5b83\u80fd\u6700\u5927\u9650\u5ea6\u5730\u5229\u7528\u4f60\u7684\u8d44\u6e90\uff0c\u786e\u4fdd\u4f60\u62e5\u6709\u5e94\u5bf9\u5404\u79cd\u6311\u6218\u6240\u9700\u7269\u54c1\u3002\u7269\u54c1\u680f\u7cfb\u7edf\u5141\u8bb8\u4f60\u643a\u5e26\u6709\u9650\u7684\u7269\u54c1\uff0c\u56e0\u6b64\u4f18\u5148\u8003\u8651\u50cf\u751f\u547d\u836f\u6c34\u548c\u4efb\u52a1\u7269\u54c1\u4e4b\u7c7b\u7684\u5fc5\u9700\u54c1\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5931\u843d\u795e\u5e99\u201d\u4efb\u52a1\u4e2d\uff0c\u62e5\u6709\u6b63\u786e\u7684\u5de5\u5177\u53ef\u4ee5\u51b3\u5b9a\u6210\u8d25\u3002\u5b9a\u671f\u6574\u7406\u4f60\u7684\u7269\u54c1\u680f\uff0c\u4e22\u5f03\u6216\u50a8\u5b58\u4e0d\u5fc5\u8981\u7684\u7269\u54c1\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u5192\u9669\u8005\u963f\u66fc\u8fbe2\u300b\u4e2d\u4f18\u5316\u6280\u80fd\u6811\u7684\u63d0\u5347\uff1f", "answer": "\u5728\u300a\u5192\u9669\u8005\u963f\u66fc\u8fbe2\u300b\u4e2d\u4f18\u5316\u4f60\u7684\u6280\u80fd\u6811\uff0c\u9700\u8981\u6839\u636e\u4f60\u7684\u6e38\u620f\u98ce\u683c\u8fdb\u884c\u6218\u7565\u89c4\u5212\u3002\u9996\u5148\uff0c\u8bc4\u4f30\u53ef\u7528\u7684\u6280\u80fd\uff0c\u5e76\u9009\u62e9\u90a3\u4e9b\u4e0e\u4f60\u504f\u7231\u7684\u6218\u6597\u98ce\u683c\u76f8\u8f85\u76f8\u6210\u7684\u6280\u80fd\uff0c\u65e0\u8bba\u662f\u8fd1\u6218\u3001\u8fdc\u7a0b\u8fd8\u662f\u9b54\u6cd5\u3002\u5176\u6b21\uff0c\u4f18\u5148\u9009\u62e9\u63d0\u4f9b\u5373\u65f6\u597d\u5904\u7684\u6280\u80fd\uff0c\u4f8b\u5982\u589e\u52a0\u4f24\u5bb3\u6216\u6062\u590d\u751f\u547d\u503c\u3002\u4f8b\u5982\uff0c\u65e9\u671f\u6295\u8d44\u201c\u5200\u6cd5\u7cbe\u901a\u201d\u6280\u80fd\u53ef\u4ee5\u663e\u8457\u589e\u5f3a\u4f60\u7684\u8fd1\u6218\u6218\u6597\u80fd\u529b\u3002\u6700\u540e\uff0c\u968f\u7740\u4f60\u7684\u6e38\u620f\u8fdb\u7a0b\uff0c\u5b9a\u671f\u56de\u987e\u5e76\u8c03\u6574\u4f60\u7684\u6280\u80fd\u6811\u3002"}, {"question": "\u6211\u53ef\u4ee5\u7528\u4ec0\u4e48\u7b56\u7565\u6765\u51fb\u8d25\u300a\u5192\u9669\u8005\u963f\u66fc\u8fbe2\u300b\u4e2d\u7684\u6700\u7ec8Boss\uff1f", "answer": "\u5728\u300a\u5192\u9669\u8005\u963f\u66fc\u8fbe2\u300b\u4e2d\u51fb\u8d25\u6700\u7ec8Boss\u9700\u8981\u7ed3\u5408\u51c6\u5907\u3001\u7b56\u7565\u548c\u6267\u884c\u3002\u6b65\u9aa41\uff1a\u88c5\u5907\u6700\u597d\u7684\u88c5\u5907\uff0c\u5e76\u5907\u8db3\u751f\u547d\u836f\u6c34\u3002\u6b65\u9aa42\uff1a\u7814\u7a76Boss\u7684\u653b\u51fb\u6a21\u5f0f\uff0c\u627e\u5230\u5b89\u5168\u7684\u5730\u65b9\u6765\u907f\u514d\u4f24\u5bb3\u3002\u6b65\u9aa43\uff1a\u5728Boss\u7684\u5f31\u70b9\u65f6\u523b\u4f7f\u7528\u4f60\u6700\u5f3a\u5927\u7684\u6280\u80fd\u3002\u4f8b\u5982\uff0c\u5728\u201c\u9ed1\u6697\u5deb\u5e08\u201dBoss\u6218\u4e2d\uff0c\u5728\u65bd\u6cd5\u540e\u53ca\u65f6\u653b\u51fb\u53ef\u4ee5\u626d\u8f6c\u6218\u5c40\u3002\u7ec3\u4e60\u8fd9\u4e9b\u6b65\u9aa4\u4ee5\u63d0\u9ad8\u4f60\u7684\u6210\u529f\u7387\u3002"}, {"question": "\u5728\u300a\u5192\u9669\u8005\u963f\u66fc\u8fbe2\u300b\u7684\u9ad8\u96be\u526f\u672c\u4e2d\uff0c\u54ea\u79cd\u961f\u4f0d\u7ec4\u5408\u6700\u6709\u6548\uff1f", "answer": "\u5728\u300a\u5192\u9669\u8005\u963f\u66fc\u8fbe2\u300b\u7684\u9ad8\u96be\u526f\u672c\u4e2d\uff0c\u5e73\u8861\u7684\u961f\u4f0d\u7ec4\u5408\u81f3\u5173\u91cd\u8981\u3002\u5178\u578b\u7684\u914d\u7f6e\u5305\u62ec\u4e00\u4e2a\u5766\u514b\uff08\u5438\u6536\u4f24\u5bb3\uff09\u3001\u4e00\u4e2a\u6cbb\u7597\u5e08\uff08\u7ef4\u6301\u961f\u4f0d\u751f\u5b58\uff09\u548c\u4e24\u4e2aDPS\uff08\u9020\u6210\u4f24\u5bb3\uff09\u3002\u4f8b\u5982\uff0c\u5728\u201c\u6c38\u6052\u6df1\u6e0a\u201d\u526f\u672c\u4e2d\uff0c\u4ee5\u963f\u66fc\u8fbe\u4e3a\u5766\u514b\uff0c\u4e00\u4e2a\u7267\u5e08\u8fdb\u884c\u6cbb\u7597\uff0c\u4e24\u4e2a\u6cd5\u5e08\u8fdb\u884cDPS\uff0c\u53ef\u4ee5\u5e94\u5bf9\u5927\u591a\u6570\u6311\u6218\u3002\u6839\u636e\u526f\u672c\u7684\u7279\u5b9a\u673a\u5236\u548c\u654c\u4eba\u7c7b\u578b\u8c03\u6574\u4f60\u7684\u961f\u4f0d\u7ec4\u5408\u3002"}, {"question": "\u300a\u5192\u9669\u8005\u963f\u66fc\u8fbe2\u300b\u4e2d\u7684\u5236\u4f5c\u7cfb\u7edf\u5982\u4f55\u63d0\u5347\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u300a\u5192\u9669\u8005\u963f\u66fc\u8fbe2\u300b\u4e2d\u7684\u5236\u4f5c\u7cfb\u7edf\u901a\u8fc7\u5141\u8bb8\u73a9\u5bb6\u5236\u4f5c\u5f3a\u5927\u7684\u7269\u54c1\u548c\u88c5\u5907\uff0c\u4f7f\u6e38\u620f\u4f53\u9a8c\u66f4\u52a0\u4e30\u5bcc\u3002\u901a\u8fc7\u6536\u96c6\u8d44\u6e90\u5e76\u4f7f\u7528\u5236\u4f5c\u53f0\uff0c\u4f60\u53ef\u4ee5\u751f\u4ea7\u6bd4\u91ce\u5916\u53d1\u73b0\u7684\u6b66\u5668\u3001\u76d4\u7532\u548c\u6d88\u8017\u54c1\u66f4\u597d\u7684\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5236\u4f5c\u201c\u9f99\u9aa8\u5251\u201d\u9700\u8981\u7a00\u6709\u6750\u6599\uff0c\u4f46\u63d0\u4f9b\u663e\u8457\u7684\u6218\u6597\u4f18\u52bf\u3002\u6b64\u7cfb\u7edf\u9f13\u52b1\u63a2\u7d22\u548c\u8d44\u6e90\u7ba1\u7406\uff0c\u4e30\u5bcc\u6574\u4f53\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u300a\u5192\u9669\u8005\u963f\u66fc\u8fbe2\u300b\u7684\u96be\u5ea6\u6a21\u5f0f\u4e4b\u95f4\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u300a\u5192\u9669\u8005\u963f\u66fc\u8fbe2\u300b\u7684\u96be\u5ea6\u6a21\u5f0f\u4f1a\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\u7684\u5404\u4e2a\u65b9\u9762\uff0c\u5305\u62ec\u654c\u4eba\u7684\u5f3a\u5ea6\u3001\u8d44\u6e90\u7684\u53ef\u7528\u6027\u548c\u7ecf\u9a8c\u7684\u83b7\u53d6\u3002\u7b80\u5355\u6a21\u5f0f\u4e13\u4e3a\u4f11\u95f2\u73a9\u5bb6\u8bbe\u8ba1\uff0c\u63d0\u4f9b\u66f4\u591a\u8d44\u6e90\u548c\u8f83\u5f31\u7684\u654c\u4eba\u3002\u666e\u901a\u6a21\u5f0f\u63d0\u4f9b\u5e73\u8861\u7684\u6e38\u620f\u4f53\u9a8c\uff0c\u800c\u56f0\u96be\u6a21\u5f0f\u5219\u901a\u8fc7\u66f4\u5f3a\u5927\u7684\u654c\u4eba\u548c\u6709\u9650\u7684\u8d44\u6e90\u6765\u6311\u6218\u73a9\u5bb6\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5bd2\u5cf0\u201d\u533a\u57df\u7684\u56f0\u96be\u6a21\u5f0f\u4e0b\uff0c\u654c\u4eba\u7684\u751f\u547d\u503c\u548c\u4f24\u5bb3\u90fd\u589e\u52a0\u4e86\uff0c\u9700\u8981\u66f4\u5177\u7b56\u7565\u6027\u7684\u6e38\u620f\u65b9\u5f0f\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u5192\u9669\u8005\u963f\u66fc\u8fbe2\u300b\u4e2d\u5c06\u5b58\u6863\u6570\u636e\u4ece\u4e00\u4e2a\u5e73\u53f0\u4f20\u8f93\u5230\u53e6\u4e00\u4e2a\u5e73\u53f0\uff1f", "answer": "\u5728\u300a\u5192\u9669\u8005\u963f\u66fc\u8fbe2\u300b\u4e2d\u4f20\u8f93\u5b58\u6863\u6570\u636e\u6d89\u53ca\u4f7f\u7528\u4e91\u5b58\u6863\u6216\u624b\u52a8\u6587\u4ef6\u4f20\u8f93\u3002\u5982\u679c\u6e38\u620f\u652f\u6301\u4e91\u5b58\u6863\uff0c\u8bf7\u786e\u4fdd\u4f60\u5728\u4e24\u4e2a\u5e73\u53f0\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u5e10\u6237\u3002\u5bf9\u4e8e\u624b\u52a8\u4f20\u8f93\uff0c\u8bf7\u5b9a\u4f4d\u539f\u59cb\u5e73\u53f0\u4e0a\u7684\u5b58\u6863\u6587\u4ef6\uff08\u901a\u5e38\u5728\u6e38\u620f\u7684\u5b89\u88c5\u76ee\u5f55\u4e2d\uff09\uff0c\u5e76\u5c06\u5176\u590d\u5236\u5230\u65b0\u5e73\u53f0\u4e0a\u7684\u5bf9\u5e94\u4f4d\u7f6e\u3002\u4f8b\u5982\uff0c\u4ece\u7535\u8111\u5230\u6e38\u620f\u673a\u79fb\u52a8\u5b58\u6863\u53ef\u80fd\u9700\u8981\u4f7f\u7528U\u76d8\u6765\u4f20\u8f93\u5b58\u6863\u6587\u4ef6\u3002"}, {"question": "\u5728\u300a\u5192\u9669\u8005\u963f\u66fc\u8fbe2\u300b\u4e2d\uff0c\u6211\u53ef\u4ee5\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u79d8\u5bc6\uff1f", "answer": "\u300a\u5192\u9669\u8005\u963f\u66fc\u8fbe2\u300b\u4e2d\u5145\u6ee1\u4e86\u9690\u85cf\u79d8\u5bc6\uff0c\u5956\u52b1\u63a2\u7d22\u548c\u597d\u5947\u5fc3\u3002\u4e00\u4e2a\u503c\u5f97\u6ce8\u610f\u7684\u79d8\u5bc6\u662f\u201c\u590d\u6d3b\u8282\u5f69\u86cb\u201d\u623f\u95f4\uff0c\u901a\u8fc7\u89e3\u51b3\u201c\u53e4\u4ee3\u9057\u8ff9\u201d\u533a\u57df\u4e2d\u7684\u4e00\u4e2a\u795e\u79d8\u8c1c\u9898\u624d\u80fd\u8fdb\u5165\u3002\u8be5\u623f\u95f4\u5305\u542b\u7a00\u6709\u7269\u54c1\u548c\u80cc\u666f\u6545\u4e8b\u7247\u6bb5\uff0c\u4e30\u5bcc\u4e86\u6e38\u620f\u7684\u6545\u4e8b\u3002\u4f8b\u5982\uff0c\u5728\u8be5\u623f\u95f4\u4e2d\u627e\u5230\u201c\u5931\u843d\u624b\u5377\u201d\u4f1a\u63ed\u793a\u5173\u4e8e\u6e38\u620f\u4e16\u754c\u7684\u80cc\u666f\u4fe1\u606f\u3002\u7559\u610f\u7ec6\u5fae\u7684\u7ebf\u7d22\uff0c\u5e76\u4e0e\u73af\u5883\u4e92\u52a8\uff0c\u4ee5\u53d1\u73b0\u8fd9\u4e9b\u9690\u85cf\u7684\u5b9d\u85cf\u3002"}]
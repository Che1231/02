[{"question": "\ucd08\ubcf4\uc790\ub85c\uc11c \uc5b4\ub5bb\uac8c \uc5b4\ub4dc\ubca4\ucc98 2\ub97c \uc2dc\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc5b4\ub4dc\ubca4\ucc98 2\ub97c \uc2dc\uc791\ud558\ub824\uba74 \uba3c\uc800 \uae30\uae30\uac00 \ucd5c\uc18c \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\uc591\uc744 \ucda9\uc871\ud558\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uadf8\ub7f0 \ub2e4\uc74c \uacf5\uc2dd \uc2a4\ud1a0\uc5b4 \ub610\ub294 \uc6f9\uc0ac\uc774\ud2b8\uc5d0\uc11c \uac8c\uc784\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc2ed\uc2dc\uc624. \uc124\uce58 \ud6c4 \uac8c\uc784\uc744 \uc2dc\uc791\ud558\uace0 \uc774\ub3d9(WASD \ud0a4) \ubc0f \uc0c1\ud638 \uc791\uc6a9(E \ud0a4)\uacfc \uac19\uc740 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc18c\uac1c\ud558\ub294 \ucd08\uae30 \ud29c\ud1a0\ub9ac\uc5bc\uc744 \uc644\ub8cc\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4 \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c\ub294 \uc774\ub7ec\ud55c \ucee8\ud2b8\ub864\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc544\ub9cc\ub2e4\ub97c \uc232\uae38\ub85c \uc548\ub0b4\ud569\ub2c8\ub2e4. \uc120\ud638\ub3c4\uc5d0 \ub9de\uac8c \ucee8\ud2b8\ub864\uc744 \uc870\uc815\ud558\ub824\uba74 \uac8c\uc784 \uc124\uc815\uc744 \ud655\uc778\ud558\uc2ed\uc2dc\uc624."}, {"question": "\uc5b4\ub4dc\ubca4\ucc98 2\uc5d0\uc11c \uc219\ub2ec\ud574\uc57c \ud558\ub294 \ud544\uc218 \ucee8\ud2b8\ub864\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc5b4\ub4dc\ubca4\ucc98 2\uc5d0\uc11c \ud544\uc218 \ucee8\ud2b8\ub864\uc744 \uc219\ub2ec\ud558\ub824\uba74 \uc774\ub3d9, \uc0c1\ud638 \uc791\uc6a9 \ubc0f \uc804\ud22c\ub97c \uc774\ud574\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774\ub3d9\uc740 WASD \ud0a4\ub85c \uc81c\uc5b4\ub418\uba70, E \ud0a4\ub294 \ubb38 \uc5f4\uae30 \ub610\ub294 NPC\uc640 \ub300\ud654\ud558\uae30\uc640 \uac19\uc740 \uc0c1\ud638 \uc791\uc6a9\uc5d0 \uc0ac\uc6a9\ub429\ub2c8\ub2e4. \uc804\ud22c\uc5d0\uc11c \uc67c\ucabd \ub9c8\uc6b0\uc2a4 \ubc84\ud2bc\uc740 \uacf5\uaca9, \uc624\ub978\ucabd \ub9c8\uc6b0\uc2a4 \ubc84\ud2bc\uc740 \ubc29\uc5b4\uc5d0 \uc0ac\uc6a9\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 \ucd08\uae30 \ub808\ubca8\uc5d0\uc11c\ub294 \uc774\ub7ec\ud55c \ucee8\ud2b8\ub864\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc801\uc744 \ubb3c\ub9ac\uce58\uace0 \ud37c\uc990\uc744 \ud480\uc5b4\uc57c \ud569\ub2c8\ub2e4. \uc548\uc804\ud55c \uc9c0\uc5ed\uc5d0\uc11c \uc774\ub7ec\ud55c \ucee8\ud2b8\ub864\uc744 \uc5f0\uc2b5\ud558\uc5ec \uc790\uc2e0\uac10\uc744 \ud0a4\uc6b0\uc2ed\uc2dc\uc624."}, {"question": "\uc5b4\ub4dc\ubca4\ucc98 2\uc5d0\uc11c \ud6a8\uc728\uc801\uc778 \uc778\ubca4\ud1a0\ub9ac \uad00\ub9ac\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc5b4\ub4dc\ubca4\ucc98 2\uc5d0\uc11c \ud6a8\uc728\uc801\uc778 \uc778\ubca4\ud1a0\ub9ac \uad00\ub9ac(\ubb3c\ud488\uad00\ub9ac)\ub294 \uc790\uc6d0\uc744 \uadf9\ub300\ud654\ud558\uace0 \ub2e4\uc591\ud55c \ucc4c\ub9b0\uc9c0\uc5d0 \ud544\uc694\ud55c \ubb3c\ud488\uc744 \ud655\ubcf4\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc778\ubca4\ud1a0\ub9ac\ub294 \uc81c\ud55c\ub41c \ubb3c\ud488\ub9cc \uc218\ub0a9\ud560 \uc218 \uc788\uc73c\ubbc0\ub85c, \uccb4\ub825 \ud3ec\uc158 \ubc0f \ud018\uc2a4\ud2b8 \uc544\uc774\ud15c\uacfc \uac19\uc740 \ud544\uc218\ud488\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uad00\ub9ac\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \"\uc783\uc5b4\ubc84\ub9b0 \uc0ac\uc6d0\" \ud018\uc2a4\ud2b8 \uc911\uc5d0 \uc62c\ubc14\ub978 \ub3c4\uad6c\ub97c \uac16\ucd94\ub294 \uac83\uc774 \uc131\uacf5\uacfc \uc2e4\ud328\uc758 \ucc28\uc774\ub97c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc815\uae30\uc801\uc73c\ub85c \uc778\ubca4\ud1a0\ub9ac\ub97c \uc815\ub9ac\ud558\uc5ec \ubd88\ud544\uc694\ud55c \ubb3c\ud488\uc744 \ubc84\ub9ac\uac70\ub098 \ubcf4\uad00\ud558\uc2ed\uc2dc\uc624."}, {"question": "\uc5b4\ub4dc\ubca4\ucc98 2\uc5d0\uc11c \uc2a4\ud0ac \ud2b8\ub9ac \uc9c4\ud589\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc5b4\ub4dc\ubca4\ucc98 2\uc5d0\uc11c \uc2a4\ud0ac \ud2b8\ub9ac\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub530\ub77c \uc804\ub7b5\uc801\uc778 \uacc4\ud68d\uc744 \uc138\uc6b0\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc6b0\uc120, \uc0ac\uc6a9 \uac00\ub2a5\ud55c \uc2a4\ud0ac\uc744 \ud3c9\uac00\ud558\uace0 \uadfc\uc811, \uc6d0\uac70\ub9ac \ub610\ub294 \ub9c8\ubc95\uacfc \uac19\uc740 \uc120\ud638\ud558\ub294 \uc804\ud22c \uc2a4\ud0c0\uc77c\uc744 \ubcf4\uc644\ud558\ub294 \uc2a4\ud0ac\uc744 \uc120\ud0dd\ud558\uc2ed\uc2dc\uc624. \ub458\uc9f8, \uc99d\uac00\ub41c \ud53c\ud574 \ub610\ub294 \uccb4\ub825 \uc7ac\uc0dd\uacfc \uac19\uc740 \uc989\uac01\uc801\uc778 \uc774\uc810\uc744 \uc81c\uacf5\ud558\ub294 \uc2a4\ud0ac\uc744 \uc6b0\uc120\uc21c\uc704\ub85c \ub450\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \"\uac80\uc220 \ub9c8\uc2a4\ud130\ub9ac\" \uc2a4\ud0ac\uc5d0 \ucd08\uae30 \ud22c\uc790\ud558\uba74 \uadfc\uc811 \uc804\ud22c \ud6a8\uc728\uc131\uc774 \ud06c\uac8c \ud5a5\uc0c1\ub429\ub2c8\ub2e4. \ub9c8\uc9c0\ub9c9\uc73c\ub85c, \uc9c4\ud589 \uc0c1\ud669\uc5d0 \ub530\ub77c \uc815\uae30\uc801\uc73c\ub85c \uc2a4\ud0ac \ud2b8\ub9ac\ub97c \uac80\ud1a0\ud558\uace0 \uc870\uc815\ud558\uc2ed\uc2dc\uc624."}, {"question": "\uc5b4\ub4dc\ubca4\ucc98 2\uc758 \ucd5c\uc885 \ubcf4\uc2a4\ub97c \ubb3c\ub9ac\uce58\uae30 \uc704\ud55c \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc5b4\ub4dc\ubca4\ucc98 2\uc758 \ucd5c\uc885 \ubcf4\uc2a4\ub97c \ubb3c\ub9ac\uce58\ub824\uba74 \uc900\ube44, \uc804\ub7b5 \ubc0f \uc2e4\ud589\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \ucd5c\uace0 \uc7a5\ube44\ub97c \ucc29\uc6a9\ud558\uace0 \uccb4\ub825 \ud3ec\uc158\uc744 \ucda9\ubd84\ud788 \uc900\ube44\ud558\uc2ed\uc2dc\uc624. 2\ub2e8\uacc4: \ubcf4\uc2a4\uc758 \uacf5\uaca9 \ud328\ud134\uc744 \uc5f0\uad6c\ud558\uace0 \ud53c\ud574\ub97c \ud53c\ud560 \uc218 \uc788\ub294 \uc548\uc804\ud55c \uc7a5\uc18c\ub97c \ucc3e\uc73c\uc2ed\uc2dc\uc624. 3\ub2e8\uacc4: \ubcf4\uc2a4\uc758 \ucde8\uc57d\ud55c \uc21c\uac04\uc5d0 \uac00\uc7a5 \uac15\ub825\ud55c \ub2a5\ub825\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4 \"\uc5b4\ub460\uc758 \ub9c8\ubc95\uc0ac\" \ubcf4\uc2a4\uc804\uc5d0\uc11c \uadf8\uc758 \uc8fc\ubb38\uc744 \uc2dc\uc804\ud55c \ud6c4 \uacf5\uaca9 \ud0c0\uc774\ubc0d\uc744 \ub9de\ucd94\uba74 \uc2b9\uae30\ub97c \uc7a1\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ub2e8\uacc4\ub97c \uc5f0\uc2b5\ud558\uc5ec \uc131\uacf5 \uac00\ub2a5\uc131\uc744 \ub192\uc774\uc2ed\uc2dc\uc624."}, {"question": "\uace0\ub09c\ub3c4 \ub358\uc804\uc5d0\uc11c \ud6a8\uacfc\uc801\uc778 \ud30c\ud2f0 \uad6c\uc131\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc5b4\ub4dc\ubca4\ucc98 2\uc758 \uace0\ub09c\ub3c4 \ub358\uc804\uc5d0\uc11c\ub294 \uade0\ud615 \uc7a1\ud78c \ud30c\ud2f0 \uad6c\uc131\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc778 \uad6c\uc131\uc740 \ud0f1\ucee4(\ud53c\ud574 \ud761\uc218), \ud790\ub7ec(\ud30c\ud2f0 \uc720\uc9c0), DPS 2\uba85(\ud53c\ud574)\uc73c\ub85c \uad6c\uc131\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc601\uc6d0\ud55c \uc2ec\uc5f0\" \ub358\uc804\uc5d0\uc11c\ub294 \ud0f1\ucee4 \uc544\ub9cc\ub2e4, \ud790\ub7ec \uc131\uc9c1\uc790, DPS \ub9c8\ubc95\uc0ac 2\uba85\uc73c\ub85c \uad6c\uc131\ub41c \ud30c\ud2f0\uac00 \ub300\ubd80\ubd84\uc758 \ucc4c\ub9b0\uc9c0\uc5d0 \ub300\ucc98\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub358\uc804\uc758 \ud2b9\uc815 \uba54\ucee4\ub2c8\uc998\uacfc \uc801 \uc720\ud615\uc5d0 \ub530\ub77c \uad6c\uc131\uc744 \uc870\uc815\ud558\uc2ed\uc2dc\uc624."}, {"question": "\uc5b4\ub4dc\ubca4\ucc98 2\uc758 \uc81c\uc791 \uc2dc\uc2a4\ud15c\uc740 \uac8c\uc774\ubc0d \uacbd\ud5d8\uc744 \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0a4\ub294\uac00?", "answer": "\uc5b4\ub4dc\ubca4\ucc98 2\uc758 \uc81c\uc791 \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uac15\ub825\ud55c \uc544\uc774\ud15c\uacfc \uc7a5\ube44\ub97c \uc81c\uc791\ud560 \uc218 \uc788\ub3c4\ub85d \ud558\uc5ec \uac8c\uc774\ubc0d \uacbd\ud5d8\uc5d0 \uae4a\uc774\ub97c \ub354\ud569\ub2c8\ub2e4. \uc790\uc6d0\uc744 \uc218\uc9d1\ud558\uace0 \uc81c\uc791 \uc2a4\ud14c\uc774\uc158\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc57c\uc0dd\uc5d0\uc11c \uc5bb\ub294 \uac83\ubcf4\ub2e4 \ub6f0\uc5b4\ub09c \ubb34\uae30, \uac11\uc637 \ubc0f \uc18c\ubaa8\ud488\uc744 \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 \"\uc6a9\uace8\uac80\"\uc744 \uc81c\uc791\ud558\ub824\uba74 \ud76c\uadc0\ud55c \uc7ac\ub8cc\uac00 \ud544\uc694\ud558\uc9c0\ub9cc \uc804\ud22c\uc5d0\uc11c \uc0c1\ub2f9\ud55c \uc774\uc810\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \ud0d0\ud5d8\uacfc \uc790\uc6d0 \uad00\ub9ac\ub97c \uc7a5\ub824\ud558\uc5ec \uc804\ubc18\uc801\uc778 \uacbd\ud5d8\uc744 \ud48d\ubd80\ud558\uac8c \ud569\ub2c8\ub2e4."}, {"question": "\uc5b4\ub4dc\ubca4\ucc98 2\uc758 \ub09c\uc774\ub3c4 \ubaa8\ub4dc \uac04\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc5b4\ub4dc\ubca4\ucc98 2\uc758 \ub09c\uc774\ub3c4 \ubaa8\ub4dc\ub294 \uc801\uc758 \uac15\ub3c4, \uc790\uc6d0 \uac00\uc6a9\uc131 \ubc0f \uacbd\ud5d8\uce58 \ud68d\ub4dd\uc744 \ud3ec\ud568\ud55c \ub2e4\uc591\ud55c \uac8c\uc774\ubc0d \uc694\uc18c\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc26c\uc6c0 \ubaa8\ub4dc\ub294 \uce90\uc8fc\uc5bc \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud574 \uc124\uacc4\ub418\uc5c8\uc73c\uba70 \ub354 \ub9ce\uc740 \uc790\uc6d0\uacfc \uc57d\ud55c \uc801\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc77c\ubc18 \ubaa8\ub4dc\ub294 \uade0\ud615 \uc7a1\ud78c \uacbd\ud5d8\uc744 \uc81c\uacf5\ud558\uba70, \uc5b4\ub824\uc6c0 \ubaa8\ub4dc\ub294 \ud50c\ub808\uc774\uc5b4\ub97c \ub354 \uac15\ub825\ud55c \uc801\uacfc \uc81c\ud55c\ub41c \uc790\uc6d0\uc73c\ub85c \ub3c4\uc804\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc5bc\uc74c\ubd09\uc6b0\ub9ac\" \uc9c0\uc5ed\uc758 \uc801\ub4e4\uc740 \uc5b4\ub824\uc6c0 \ubaa8\ub4dc\uc5d0\uc11c \uccb4\ub825\uacfc \ud53c\ud574\uac00 \uc99d\uac00\ud558\uc5ec \ub354\uc6b1 \uc804\ub7b5\uc801\uc778 \ud50c\ub808\uc774\uac00 \ud544\uc694\ud569\ub2c8\ub2e4."}, {"question": "\uc5b4\ub4dc\ubca4\ucc98 2\uc5d0\uc11c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uc800\uc7a5 \ub370\uc774\ud130\ub97c \uc804\uc1a1\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc5b4\ub4dc\ubca4\ucc98 2\uc5d0\uc11c \uc800\uc7a5 \ub370\uc774\ud130\ub97c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uc804\uc1a1\ud558\ub824\uba74 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \ub610\ub294 \uc218\ub3d9 \ud30c\uc77c \uc804\uc1a1\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uac8c\uc784\uc774 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \uc9c0\uc6d0\ud558\ub294 \uacbd\uc6b0 \ub450 \ud50c\ub7ab\ud3fc \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uc218\ub3d9 \uc804\uc1a1\uc758 \uacbd\uc6b0 \uc6d0\ub798 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc800\uc7a5 \ud30c\uc77c\uc744 \ucc3e\uc544(\ubcf4\ud1b5 \uac8c\uc784 \uc124\uce58 \ub514\ub809\ud1a0\ub9ac\uc5d0 \uc788\uc74c) \uc0c8 \ud50c\ub7ab\ud3fc\uc758 \ud574\ub2f9 \uc704\uce58\ub85c \ubcf5\uc0ac\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 PC\uc5d0\uc11c \ucf58\uc194\ub85c \uc774\ub3d9\ud558\ub824\uba74 USB \ub4dc\ub77c\uc774\ube0c\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc800\uc7a5 \ud30c\uc77c\uc744 \uc804\uc1a1\ud574\uc57c \ud569\ub2c8\ub2e4."}, {"question": "\uc5b4\ub4dc\ubca4\ucc98 2\uc5d0\uc11c \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ube44\ubc00\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc5b4\ub4dc\ubca4\ucc98 2\ub294 \ud0d0\ud5d8\uacfc \ud638\uae30\uc2ec\uc73c\ub85c \ubcf4\uc0c1\uc744 \uc5bb\uc744 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ube44\ubc00\ub85c \uac00\ub4dd\ud569\ub2c8\ub2e4. \uc8fc\ubaa9\ud560 \ub9cc\ud55c \ube44\ubc00 \uc911 \ud558\ub098\ub294 \"\uace0\ub300 \uc720\uc801\" \uc9c0\uc5ed\uc5d0\uc11c \uc218\uc218\uaed8\ub07c \ud37c\uc990\uc744 \ud480\uba74 \uc811\uadfc\ud560 \uc218 \uc788\ub294 \"\uc774\uc2a4\ud130 \uc5d0\uadf8\" \ubc29\uc785\ub2c8\ub2e4. \uc774 \ubc29\uc5d0\ub294 \uac8c\uc784 \uc2a4\ud1a0\ub9ac\ub97c \ud48d\ubd80\ud558\uac8c \ud558\ub294 \ud76c\uadc0 \uc544\uc774\ud15c\uacfc \uc9c0\uc2dd \uc870\uac01\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc774 \ubc29\uc5d0\uc11c \"\uc783\uc5b4\ubc84\ub9b0 \uc871\uc801\"\uc744 \ucc3e\uc73c\uba74 \uac8c\uc784 \uc138\uacc4\uc5d0 \ub300\ud55c \ubc30\uacbd \uc815\ubcf4\ub97c \uc54c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubbf8\ubb18\ud55c \ub2e8\uc11c\uc5d0 \uc8fc\uc758\ud558\uace0 \ud658\uacbd\uacfc \uc0c1\ud638 \uc791\uc6a9\ud558\uc5ec \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ubcf4\uc11d\uc744 \ubc1c\uacac\ud558\uc2ed\uc2dc\uc624."}]
[{"question": "\u30a2\u30de\u30f3\u30c0\u306e\u5192\u967a\u8a182\u3092\u5168\u304f\u306e\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001\u3069\u306e\u3088\u3046\u306b\u30d7\u30ec\u30a4\u3092\u59cb\u3081\u3089\u308c\u307e\u3059\u304b\uff1f", "answer": "\u30a2\u30de\u30f3\u30c0\u306e\u5192\u967a\u8a182\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u307e\u305a\u3001\u30c7\u30d0\u30a4\u30b9\u304c\u6700\u5c0f\u30b7\u30b9\u30c6\u30e0\u8981\u4ef6\u3092\u6e80\u305f\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6b21\u306b\u3001\u516c\u5f0f\u30b9\u30c8\u30a2\u307e\u305f\u306f\u30a6\u30a7\u30d6\u30b5\u30a4\u30c8\u304b\u3089\u30b2\u30fc\u30e0\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u5f8c\u3001\u30b2\u30fc\u30e0\u3092\u8d77\u52d5\u3057\u3001\u521d\u671f\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3067\u3001\u79fb\u52d5\uff08WASD\u30ad\u30fc\uff09\u3084\u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3\uff08E\u30ad\u30fc\uff09\u306a\u3069\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u304c\u7d39\u4ecb\u3055\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u3053\u308c\u3089\u306e\u64cd\u4f5c\u3092\u4f7f\u3063\u3066\u30a2\u30de\u30f3\u30c0\u3092\u68ee\u306e\u4e2d\u3092\u79fb\u52d5\u3055\u305b\u308b\u3067\u3057\u3087\u3046\u3002\u3042\u306a\u305f\u306e\u597d\u307f\u306b\u5408\u308f\u305b\u3066\u64cd\u4f5c\u3092\u8abf\u6574\u3059\u308b\u305f\u3081\u306b\u3001\u30b2\u30fc\u30e0\u5185\u306e\u8a2d\u5b9a\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30a2\u30de\u30f3\u30c0\u306e\u5192\u967a\u8a182\u3067\u30de\u30b9\u30bf\u30fc\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u91cd\u8981\u306a\u64cd\u4f5c\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30a2\u30de\u30f3\u30c0\u306e\u5192\u967a\u8a182\u3067\u91cd\u8981\u306a\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u79fb\u52d5\u3001\u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3\u3001\u6226\u95d8\u306e\u7406\u89e3\u304c\u5fc5\u8981\u3067\u3059\u3002\u79fb\u52d5\u306fWASD\u30ad\u30fc\u3067\u884c\u308f\u308c\u3001E\u30ad\u30fc\u306f\u30c9\u30a2\u3092\u958b\u3051\u308b\u3001NPC\u3068\u8a71\u3059\u306a\u3069\u306e\u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3\u306b\u4f7f\u7528\u3055\u308c\u307e\u3059\u3002\u6226\u95d8\u3067\u306f\u3001\u5de6\u30de\u30a6\u30b9\u30dc\u30bf\u30f3\u304c\u653b\u6483\u3001\u53f3\u30de\u30a6\u30b9\u30dc\u30bf\u30f3\u304c\u9632\u5fa1\u306b\u4f7f\u7528\u3055\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u521d\u671f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u3053\u308c\u3089\u306e\u64cd\u4f5c\u3092\u4f7f\u3063\u3066\u6575\u3092\u5012\u3057\u3001\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u5b89\u5168\u306a\u5834\u6240\u3067\u3059\u3050\u308c\u305f\u64cd\u4f5c\u3092\u7df4\u7fd2\u3057\u3066\u81ea\u4fe1\u3092\u6df1\u3081\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u30a2\u30de\u30f3\u30c0\u306e\u5192\u967a\u8a182\u3067\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u3092\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u30a2\u30de\u30f3\u30c0\u306e\u5192\u967a\u8a182\u3067\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u3092\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3059\u308b\u3053\u3068\u306f\u3001\u30ea\u30bd\u30fc\u30b9\u3092\u6700\u5927\u9650\u306b\u6d3b\u7528\u3057\u3001\u3055\u307e\u3056\u307e\u306a\u8ab2\u984c\u306b\u5fc5\u8981\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u78ba\u4fdd\u3059\u308b\u305f\u3081\u306b\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u30b7\u30b9\u30c6\u30e0\u3067\u306f\u3001\u6301\u3061\u904b\u3079\u308b\u30a2\u30a4\u30c6\u30e0\u306f\u9650\u3089\u308c\u3066\u3044\u307e\u3059\u3002\u305d\u306e\u305f\u3081\u3001\u56de\u5fa9\u85ac\u3084\u30af\u30a8\u30b9\u30c8\u30a2\u30a4\u30c6\u30e0\u306a\u3069\u306e\u5fc5\u9808\u30a2\u30a4\u30c6\u30e0\u3092\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u300e\u5931\u308f\u308c\u305f\u795e\u6bbf\u300f\u30af\u30a8\u30b9\u30c8\u3067\u306f\u3001\u9069\u5207\u306a\u30c4\u30fc\u30eb\u304c\u3042\u308c\u3070\u6210\u529f\u3068\u5931\u6557\u306e\u5206\u5c90\u70b9\u3068\u306a\u308a\u307e\u3059\u3002\u5b9a\u671f\u7684\u306b\u4e0d\u8981\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u51e6\u5206\u307e\u305f\u306f\u4fdd\u7ba1\u3059\u308b\u3053\u3068\u3067\u3001\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u3092\u6574\u7406\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u30a2\u30de\u30f3\u30c0\u306e\u5192\u967a\u8a182\u3067\u30b9\u30ad\u30eb\u30c4\u30ea\u30fc\u306e\u9032\u884c\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30a2\u30de\u30f3\u30c0\u306e\u5192\u967a\u8a182\u3067\u30b9\u30ad\u30eb\u30c4\u30ea\u30fc\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u3042\u306a\u305f\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u57fa\u3065\u3044\u305f\u6226\u7565\u7684\u306a\u8a08\u753b\u304c\u5fc5\u8981\u3067\u3059\u3002\u307e\u305a\u3001\u5229\u7528\u53ef\u80fd\u306a\u30b9\u30ad\u30eb\u3092\u8a55\u4fa1\u3057\u3001\u8fd1\u63a5\u3001\u9060\u8ddd\u96e2\u3001\u9b54\u6cd5\u306a\u3069\u3001\u597d\u307f\u306e\u6226\u95d8\u30b9\u30bf\u30a4\u30eb\u306b\u5408\u3046\u30b9\u30ad\u30eb\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6b21\u306b\u3001\u30c0\u30e1\u30fc\u30b8\u5897\u52a0\u3084\u4f53\u529b\u56de\u5fa9\u306a\u3069\u3001\u5373\u5ea7\u306b\u5229\u76ca\u3092\u3082\u305f\u3089\u3059\u30b9\u30ad\u30eb\u3092\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u300e\u5263\u306e\u9054\u4eba\u300f\u30b9\u30ad\u30eb\u3092\u65e9\u671f\u306b\u6295\u8cc7\u3059\u308b\u3068\u3001\u8fd1\u63a5\u6226\u95d8\u306e\u6709\u52b9\u6027\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002\u6700\u5f8c\u306b\u3001\u9032\u884c\u72b6\u6cc1\u306b\u5408\u308f\u305b\u3066\u30b9\u30ad\u30eb\u30c4\u30ea\u30fc\u3092\u5b9a\u671f\u7684\u306b\u898b\u76f4\u3057\u3001\u8abf\u6574\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30a2\u30de\u30f3\u30c0\u306e\u5192\u967a\u8a182\u3067\u6700\u7d42\u30dc\u30b9\u3092\u5012\u3059\u305f\u3081\u306b\u4f7f\u7528\u3067\u304d\u308b\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30a2\u30de\u30f3\u30c0\u306e\u5192\u967a\u8a182\u3067\u6700\u7d42\u30dc\u30b9\u3092\u5012\u3059\u305f\u3081\u306b\u306f\u3001\u6e96\u5099\u3001\u6226\u7565\u3001\u5b9f\u884c\u306e\u7d44\u307f\u5408\u308f\u305b\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6700\u9ad8\u306e\u88c5\u5099\u3092\u88c5\u7740\u3057\u3001\u56de\u5fa9\u85ac\u3092\u88dc\u7d66\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30dc\u30b9\u306e\u653b\u6483\u30d1\u30bf\u30fc\u30f3\u3092\u7814\u7a76\u3057\u3001\u30c0\u30e1\u30fc\u30b8\u3092\u53d7\u3051\u305a\u306b\u5b89\u5168\u306a\u5834\u6240\u3092\u898b\u3064\u3051\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30dc\u30b9\u306e\u5f31\u70b9\u306e\u77ac\u9593\u306b\u6700\u3082\u5f37\u529b\u306a\u80fd\u529b\u3092\u4f7f\u7528\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u300e\u95c7\u306e\u9b54\u8853\u5e2b\u300f\u30dc\u30b9\u6226\u3067\u306f\u3001\u5f7c\u306e\u546a\u6587\u8a60\u5531\u5f8c\u3059\u3050\u306b\u653b\u6483\u3092\u5f53\u3066\u308b\u3068\u3001\u72b6\u6cc1\u304c\u6709\u5229\u306b\u5909\u308f\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30b9\u30c6\u30c3\u30d7\u3092\u7df4\u7fd2\u3057\u3066\u6210\u529f\u306e\u53ef\u80fd\u6027\u3092\u9ad8\u3081\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u30a2\u30de\u30f3\u30c0\u306e\u5192\u967a\u8a182\u3067\u3001\u9ad8\u30ec\u30d9\u30eb\u30c0\u30f3\u30b8\u30e7\u30f3\u306b\u6700\u9069\u306a\u30d1\u30fc\u30c6\u30a3\u69cb\u6210\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30a2\u30de\u30f3\u30c0\u306e\u5192\u967a\u8a182\u306e\u9ad8\u30ec\u30d9\u30eb\u30c0\u30f3\u30b8\u30e7\u30f3\u3067\u306f\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u30d1\u30fc\u30c6\u30a3\u69cb\u6210\u304c\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u5178\u578b\u7684\u306a\u69cb\u6210\u306f\u3001\u30bf\u30f3\u30af\uff08\u30c0\u30e1\u30fc\u30b8\u3092\u5438\u53ce\uff09\u3001\u30d2\u30fc\u30e9\u30fc\uff08\u30d1\u30fc\u30c6\u30a3\u3092\u7dad\u6301\uff09\u3001DPS\uff08\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\uff09\u306e2\u4eba\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u6c38\u9060\u306e\u6df5\u300f\u30c0\u30f3\u30b8\u30e7\u30f3\u3067\u306f\u3001\u30a2\u30de\u30f3\u30c0\u3092\u30bf\u30f3\u30af\u3001\u8056\u8077\u8005\u3092\u30d2\u30fc\u30e9\u30fc\u30012\u4eba\u306e\u9b54\u6cd5\u4f7f\u3044\u3092DPS\u3068\u3059\u308b\u30d1\u30fc\u30c6\u30a3\u306f\u3001\u307b\u3068\u3093\u3069\u306e\u8ab2\u984c\u3092\u3053\u306a\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30c0\u30f3\u30b8\u30e7\u30f3\u306e\u5177\u4f53\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3068\u6575\u306e\u7a2e\u985e\u306b\u57fa\u3065\u3044\u3066\u3001\u69cb\u6210\u3092\u8abf\u6574\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30a2\u30de\u30f3\u30c0\u306e\u5192\u967a\u8a182\u306e\u30af\u30e9\u30d5\u30c8\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u3069\u306e\u3088\u3046\u306b\u5411\u4e0a\u3055\u305b\u307e\u3059\u304b\uff1f", "answer": "\u30a2\u30de\u30f3\u30c0\u306e\u5192\u967a\u8a182\u306e\u30af\u30e9\u30d5\u30c8\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u5f37\u529b\u306a\u30a2\u30a4\u30c6\u30e0\u3084\u88c5\u5099\u3092\u4f5c\u6210\u3067\u304d\u308b\u3088\u3046\u306b\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u5965\u884c\u304d\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002\u8cc7\u6e90\u3092\u96c6\u3081\u3001\u30af\u30e9\u30d5\u30c8\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u91ce\u751f\u306e\u3082\u306e\u3088\u308a\u3082\u512a\u308c\u305f\u6b66\u5668\u3001\u9632\u5177\u3001\u6d88\u8017\u54c1\u3092\u4f5c\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u7adc\u9aa8\u306e\u5263\u300f\u3092\u4f5c\u6210\u3059\u308b\u306b\u306f\u30ec\u30a2\u306a\u7d20\u6750\u304c\u5fc5\u8981\u3067\u3059\u304c\u3001\u6226\u95d8\u4e0a\u306e\u512a\u4f4d\u6027\u3092\u5927\u304d\u304f\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u63a2\u691c\u3068\u8cc7\u6e90\u7ba1\u7406\u3092\u4fc3\u3057\u3001\u5168\u4f53\u7684\u306a\u4f53\u9a13\u3092\u8c4a\u304b\u306b\u3057\u307e\u3059\u3002"}, {"question": "\u30a2\u30de\u30f3\u30c0\u306e\u5192\u967a\u8a182\u306e\u96e3\u6613\u5ea6\u30e2\u30fc\u30c9\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30a2\u30de\u30f3\u30c0\u306e\u5192\u967a\u8a182\u306e\u96e3\u6613\u5ea6\u30e2\u30fc\u30c9\u306f\u3001\u6575\u306e\u5f37\u3055\u3001\u8cc7\u6e90\u306e\u5165\u624b\u53ef\u80fd\u6027\u3001\u7d4c\u9a13\u5024\u306e\u7372\u5f97\u306a\u3069\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u69d8\u3005\u306a\u9762\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u30ab\u30b8\u30e5\u30a2\u30eb\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u5411\u3051\u306b\u8a2d\u8a08\u3055\u308c\u305f\u7c21\u5358\u306a\u30e2\u30fc\u30c9\u3067\u306f\u3001\u8cc7\u6e90\u304c\u591a\u304f\u3001\u6575\u304c\u5f31\u3044\u3067\u3059\u3002\u30ce\u30fc\u30de\u30eb\u30e2\u30fc\u30c9\u3067\u306f\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u7d4c\u9a13\u3092\u63d0\u4f9b\u3057\u3001\u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\u3067\u306f\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u5f37\u529b\u306a\u6575\u3068\u9650\u3089\u308c\u305f\u8cc7\u6e90\u306b\u6311\u6226\u3059\u308b\u6a5f\u4f1a\u3092\u4e0e\u3048\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\u3067\u306f\u3001\u300e\u6c37\u5cf0\u300f\u30a8\u30ea\u30a2\u306e\u6575\u306f\u4f53\u529b\u3068\u30c0\u30e1\u30fc\u30b8\u304c\u4e0a\u6607\u3057\u3001\u3088\u308a\u6226\u7565\u7684\u306a\u30d7\u30ec\u30a4\u3092\u8981\u6c42\u3057\u307e\u3059\u3002"}, {"question": "\u30a2\u30de\u30f3\u30c0\u306e\u5192\u967a\u8a182\u3067\u3001\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u3092\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30a2\u30de\u30f3\u30c0\u306e\u5192\u967a\u8a182\u3067\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u3092\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001\u30af\u30e9\u30a6\u30c9\u30bb\u30fc\u30d6\u307e\u305f\u306f\u624b\u52d5\u3067\u306e\u30d5\u30a1\u30a4\u30eb\u8ee2\u9001\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b2\u30fc\u30e0\u304c\u30af\u30e9\u30a6\u30c9\u30bb\u30fc\u30d6\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u308b\u5834\u5408\u3001\u4e21\u65b9\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u624b\u52d5\u8ee2\u9001\u306e\u5834\u5408\u3001\u5143\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\uff08\u901a\u5e38\u306f\u30b2\u30fc\u30e0\u306e\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u5185\uff09\u3067\u30bb\u30fc\u30d6\u30d5\u30a1\u30a4\u30eb\u3092\u7279\u5b9a\u3057\u3001\u65b0\u3057\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u5bfe\u5fdc\u3059\u308b\u5834\u6240\u306b\u30b3\u30d4\u30fc\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001PC\u304b\u3089\u30b3\u30f3\u30bd\u30fc\u30eb\u306b\u79fb\u52d5\u3059\u308b\u5834\u5408\u3001USB\u30c9\u30e9\u30a4\u30d6\u3092\u4f7f\u7528\u3057\u3066\u30bb\u30fc\u30d6\u30d5\u30a1\u30a4\u30eb\u3092\u8ee2\u9001\u3059\u308b\u3053\u3068\u304c\u5fc5\u8981\u306a\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30a2\u30de\u30f3\u30c0\u306e\u5192\u967a\u8a182\u3067\u3001\u3069\u306e\u3088\u3046\u306a\u96a0\u3055\u308c\u305f\u79d8\u5bc6\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30a2\u30de\u30f3\u30c0\u306e\u5192\u967a\u8a182\u306b\u306f\u3001\u63a2\u6c42\u5fc3\u3068\u597d\u5947\u5fc3\u3092\u8912\u3081\u3066\u304f\u308c\u308b\u96a0\u3055\u308c\u305f\u79d8\u5bc6\u304c\u6e80\u8f09\u3067\u3059\u3002\u300c\u53e4\u4ee3\u907a\u8de1\u300d\u30a8\u30ea\u30a2\u306e\u96e3\u89e3\u306a\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u3053\u3068\u306b\u3088\u3063\u3066\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u3001\u300c\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u300d\u90e8\u5c4b\u304c\u6ce8\u76ee\u306b\u5024\u3059\u308b\u79d8\u5bc6\u3067\u3059\u3002\u3053\u306e\u90e8\u5c4b\u306b\u306f\u3001\u30b2\u30fc\u30e0\u306e\u30b9\u30c8\u30fc\u30ea\u30fc\u3092\u8c4a\u304b\u306b\u3059\u308b\u3001\u307e\u308c\u306a\u30a2\u30a4\u30c6\u30e0\u3068\u30ed\u30a2\u30d4\u30fc\u30b9\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u5931\u308f\u308c\u305f\u5dfb\u7269\u300d\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u306e\u4e16\u754c\u306b\u95a2\u3059\u308b\u80cc\u666f\u60c5\u5831\u304c\u660e\u3089\u304b\u306b\u306a\u308a\u307e\u3059\u3002\u5fae\u5999\u306a\u624b\u304c\u304b\u308a\u3092\u63a2\u3057\u3001\u74b0\u5883\u3068\u5bfe\u8a71\u3059\u308b\u3053\u3068\u3067\u3001\u3053\u308c\u3089\u306e\u96a0\u3055\u308c\u305f\u5b9d\u77f3\u3092\u767a\u898b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}]
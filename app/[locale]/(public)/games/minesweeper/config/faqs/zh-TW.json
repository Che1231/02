[{"question": "\u6383\u96f7\u57fa\u790e\uff1a\u5982\u4f55\u958b\u59cb\u4e00\u5834\u6383\u96f7\u904a\u6232\uff0c\u4ee5\u53ca\u7b2c\u4e00\u6b21\u9ede\u64ca\u7684\u529f\u80fd\u662f\u4ec0\u9ebc\uff1f", "answer": "\u958b\u59cb\u6383\u96f7\u904a\u6232\u5f88\u7c21\u55ae\u3002\u53ea\u8981\u9ede\u64ca\u7db2\u683c\u4e0a\u7684\u4efb\u4f55\u65b9\u584a\u5373\u53ef\u3002\u7b2c\u4e00\u6b21\u9ede\u64ca\u6c38\u9060\u4e0d\u6703\u662f\u5730\u96f7\u3002\u5b83\u6703\u63ed\u793a\u4e00\u500b\u5b89\u5168\u5340\u57df\u6216\u986f\u793a\u76f8\u9130\u5730\u96f7\u6578\u7684\u6578\u5b57\u3002\u5982\u679c\u7b2c\u4e00\u6b21\u9ede\u64ca\u63ed\u793a\u4e86\u4e00\u500b\u5927\u5340\u57df\uff0c\u5247\u8868\u793a\u9644\u8fd1\u6c92\u6709\u5730\u96f7\u3002\u76ee\u6a19\u662f\u63ed\u958b\u6240\u6709\u5b89\u5168\u65b9\u584a\uff0c\u800c\u4e0d\u6703\u5f15\u7206\u4efb\u4f55\u5730\u96f7\u3002\u7bc4\u4f8b\uff1a\u9ede\u64ca\u89d2\u843d\u65b9\u584a\u901a\u5e38\u662f\u4e00\u500b\u4e0d\u932f\u7684\u958b\u59cb\uff0c\u56e0\u70ba\u5b83\u53ef\u4ee5\u5c07\u6f5b\u5728\u7684\u76f8\u9130\u5730\u96f7\u964d\u5230\u6700\u4f4e\u3002"}, {"question": "\u6383\u96f7\u4e2d\u7684\u6578\u5b57\u4ee3\u8868\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5b83\u5011\u5982\u4f55\u5e6b\u52a9\u6211\u8b58\u5225\u5b89\u5168\u5340\u57df\uff1f", "answer": "\u6383\u96f7\u4e2d\u7684\u6578\u5b57\u4ee3\u8868\u76f8\u9130\u65b9\u584a\uff08\u6c34\u5e73\u3001\u5782\u76f4\u548c\u5c0d\u89d2\u7dda\uff09\u7684\u5730\u96f7\u6578\u91cf\u3002\u5229\u7528\u9019\u4e9b\u6578\u5b57\uff0c\u60a8\u53ef\u4ee5\u63a8\u65b7\u5730\u96f7\u7684\u4f4d\u7f6e\u4e26\u6a19\u8a18\u5b83\u5011\u3002\u4f8b\u5982\uff0c\u5982\u679c\u300c1\u300d\u50c5\u8207\u4e00\u500b\u672a\u63ed\u793a\u7684\u65b9\u584a\u76f8\u9130\uff0c\u5247\u8a72\u672a\u63ed\u793a\u7684\u65b9\u584a\u4e00\u5b9a\u662f\u5730\u96f7\u3002\u7d50\u5408\u6578\u5b57\u7dda\u7d22\u4f86\u63ed\u793a\u66f4\u5927\u7684\u5b89\u5168\u5340\u57df\u3002\u914d\u7f6e\u8868\u5982\u4e0b\u6240\u793a\uff1a\n\u6578\u5b57 | \u5730\u96f7\u6578\u91cf\n---|---\n1 | \u4e00\u500b\u5730\u96f7\n2 | \u5169\u500b\u5730\u96f7\n3 | \u4e09\u500b\u5730\u96f7"}, {"question": "\u6383\u96f7\u6a19\u8a18\uff1a\u70ba\u4ec0\u9ebc\u6383\u96f7\u904a\u6232\u4e2d\u4f7f\u7528\u6a19\u8a18\u81f3\u95dc\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u6b63\u78ba\u6a19\u8a18\u6f5b\u5728\u5730\u96f7\uff1f", "answer": "\u6a19\u8a18\u5728\u6383\u96f7\u904a\u6232\u4e2d\u81f3\u95dc\u91cd\u8981\uff0c\u7528\u65bc\u6a19\u8a18\u60a8\u8a8d\u70ba\u5305\u542b\u5730\u96f7\u7684\u65b9\u584a\uff0c\u9632\u6b62\u610f\u5916\u9ede\u64ca\u548c\u5f15\u7206\u3002\u8981\u6a19\u8a18\u65b9\u584a\uff0c\u8acb\u5728\u4e0a\u9762\u9ede\u64ca\u6ed1\u9f20\u53f3\u9375\uff08\u6216\u4f7f\u7528\u884c\u52d5\u88dd\u7f6e\u4e0a\u7684\u6307\u5b9a\u6a19\u8a18\u6309\u9215\uff09\u3002\u4e00\u65e6\u6a19\u8a18\uff0c\u5247\u8a72\u65b9\u584a\u4e0d\u6703\u88ab\u610f\u5916\u9ede\u64ca\uff0c\u76f4\u5230\u6a19\u8a18\u88ab\u79fb\u9664\u3002\u6709\u6548\u5229\u7528\u6a19\u8a18\u662f\u524d\u9032\u7684\u95dc\u9375\u3002\u7bc4\u4f8b\uff1a\u5982\u679c\u60a8\u770b\u5230\u4e00\u500b\u300c1\u300d\u65c1\u908a\u6709\u4e00\u500b\u672a\u63ed\u793a\u7684\u65b9\u584a\uff0c\u8acb\u7acb\u5373\u6a19\u8a18\u5b83\u4ee5\u907f\u514d\u932f\u8aa4\u3002"}, {"question": "\u6383\u96f7\u7b56\u7565\uff1a\u91dd\u5c0d\u66f4\u5927\u904a\u6232\u677f\uff0c\u6709\u4ec0\u9ebc\u5148\u9032\u7684\u6383\u96f7\u7b56\u7565\u80fd\u6301\u7e8c\u6709\u6548\u5730\u6e05\u9664\uff1f", "answer": "\u5c0d\u65bc\u66f4\u5927\u7684\u6383\u96f7\u904a\u6232\u677f\uff0c\u8acb\u8003\u616e\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9a5f 1\uff1a\u8b58\u5225\u5e38\u898b\u6a21\u5f0f\u3002\u5c0b\u627e\u300c1-2-1\u300d\u6216\u300c1-1\u300d\u914d\u7f6e\uff0c\u5b83\u5011\u901a\u5e38\u6703\u63ed\u793a\u5730\u96f7\u3002\u6b65\u9a5f 2\uff1a\u4f7f\u7528\u5148\u9032\u7684\u63a8\u8ad6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4e00\u500b\u300c2\u300d\u65c1\u908a\u6709\u5169\u500b\u6a19\u8a18\u7684\u5730\u96f7\uff0c\u5247\u6240\u6709\u5176\u4ed6\u76f8\u9130\u65b9\u584a\u90fd\u662f\u5b89\u5168\u7684\u3002\u6b65\u9a5f 3\uff1a\u5b9a\u671f\u6383\u63cf\u904a\u6232\u677f\uff0c\u5c0b\u627e\u53ef\u89e3\u7684\u5b64\u7acb\u96c6\u7fa4\u3002\u9019\u4e9b\u7b56\u7565\u6709\u52a9\u65bc\u78ba\u4fdd\u6301\u7e8c\u6e05\u9664\u3002 \u6bd4\u55bb\u8aaa\u660e\uff1a\u6383\u96f7\u5c31\u50cf\u89e3\u8b0e\u6848\uff0c\u6309\u7167\u7dda\u7d22\u627e\u5230\u5acc\u7591\u72af\u3002"}, {"question": "\u6383\u96f7\u9023\u9396\uff1a\u5982\u4f55\u5728\u6383\u96f7\u904a\u6232\u4e2d\u4f7f\u7528\u300c\u9023\u9396\u300d\u6216\u300c\u9ede\u64ca\u300d\u5feb\u901f\u6e05\u9664\u5df2\u77e5\u5730\u96f7\u7684\u5340\u57df\uff1f", "answer": "\u9023\u9396\uff0c\u6216\u8005\u5728\u6a19\u8a18\u6b63\u78ba\u6578\u91cf\u7684\u76f8\u9130\u5730\u96f7\u5f8c\u9ede\u64ca\u5e36\u6578\u5b57\u7684\u65b9\u584a\uff0c\u5373\u53ef\u4e00\u6b21\u6e05\u9664\u6240\u6709\u5269\u9918\u7684\u76f8\u9130\u975e\u5730\u96f7\u65b9\u584a\u3002\u9019\u53ef\u4ee5\u7bc0\u7701\u5927\u91cf\u6642\u9593\u3002\u8acb\u78ba\u4fdd\u6a19\u8a18\u6e96\u78ba\u7121\u8aa4\u5f8c\u624d\u9032\u884c\u9023\u9396\u9ede\u64ca\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4e00\u500b\u300c3\u300d\u5468\u570d\u6709\u4e09\u500b\u6a19\u8a18\u7684\u5730\u96f7\uff0c\u5247\u9023\u9396\u9ede\u64ca\u5c07\u5feb\u901f\u63ed\u793a\u6240\u6709\u5176\u4ed6\u76f8\u9130\u975e\u5730\u96f7\u65b9\u584a\u3002  \u65b9\u6848\u6bd4\u8f03\uff1a\u6a19\u6e96\u9ede\u64ca\u662f\u9010\u6b65\u9ede\u64ca\uff0c\u9023\u9396\u9ede\u64ca\u4e00\u6b21\u6e05\u9664\u591a\u500b\u3002"}, {"question": "\u6383\u96f7\u6a5f\u7387\uff1a\u7576\u6211\u5728\u6383\u96f7\u904a\u6232\u4e2d\u5361\u4f4f\u6642\uff0c\u5982\u4f55\u4f7f\u7528\u6a5f\u7387\u4f86\u5b89\u5168\u5730\u731c\u6e2c\uff1f", "answer": "\u7576\u7121\u6cd5\u9032\u884c\u660e\u78ba\u7684\u63a8\u8ad6\u6642\uff0c\u8acb\u4f7f\u7528\u6a5f\u7387\u3002\u4f30\u8a08\u672a\u89e3\u6c7a\u5340\u57df\u7684\u5730\u96f7\u5bc6\u5ea6\uff0c\u4e26\u9ede\u64ca\u6a5f\u7387\u6700\u4f4e\u662f\u5730\u96f7\u7684\u65b9\u584a\u3002\u9019\u5177\u6709\u98a8\u96aa\uff0c\u4f46\u6709\u6642\u662f\u5fc5\u8981\u7684\u3002\u7bc4\u4f8b\uff1a\u5982\u679c\u60a8\u6709\u4e00\u500b\u5927\u578b\u672a\u89e3\u6c7a\u5340\u57df\uff0c\u4e26\u4e14\u5468\u570d\u6709\u4e00\u4e9b\u908a\u754c\u6578\u5b57\uff0c\u9ede\u64ca\u8a72\u672a\u89e3\u6c7a\u5340\u57df\u4e2d\u5fc3\u5340\u57df\u7684\u5730\u96f7\u5bc6\u5ea6\u53ef\u80fd\u8f03\u4f4e\u3002\u6d41\u7a0b\u5716\u5982\u4e0b\uff1a\n\u958b\u59cb -> \u63a8\u8ad6 -> \u7121\u6cd5\u89e3\u6c7a\uff1f -> \u6a5f\u7387\u4f30\u8a08 -> \u5b89\u5168\u9ede\u64ca\u3002"}, {"question": "\u6383\u96f7\u6f14\u7b97\u6cd5\uff1a\u6383\u96f7\u904a\u6232\u4e2d\u6c7a\u5b9a\u5730\u96f7\u653e\u7f6e\u65b9\u5f0f\u7684\u5e95\u5c64\u6f14\u7b97\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "\u6383\u96f7\u904a\u6232\u901a\u5e38\u4f7f\u7528\u96a8\u6a5f\u6578\u751f\u6210\u5668\u5728\u7b2c\u4e00\u6b21\u9ede\u64ca\u5f8c\u653e\u7f6e\u5730\u96f7\uff0c\u4ee5\u78ba\u4fdd\u7b2c\u4e00\u6b21\u9ede\u64ca\u59cb\u7d42\u662f\u5b89\u5168\u7684\u3002\u8a72\u6f14\u7b97\u6cd5\u6703\u6839\u64da\u8a2d\u5b9a\u7684\u96e3\u5ea6\u5728\u7db2\u683c\u4e0a\u5747\u52fb\u5206\u4f48\u5730\u96f7\u3002\u67d0\u4e9b\u7248\u672c\u53ef\u80fd\u6703\u8abf\u6574\u5730\u96f7\u653e\u7f6e\uff0c\u4ee5\u907f\u514d\u51fa\u73fe\u7121\u6cd5\u89e3\u6c7a\u7684\u904a\u6232\u72c0\u614b\u3002\u6578\u503c\u5206\u6790\u986f\u793a\u5730\u96f7\u5206\u4f48\u8207\u8a2d\u5b9a\u7684\u96e3\u5ea6\u7d1a\u5225\u4e00\u81f4\u3002\u914d\u7f6e\u53ef\u898b\uff1a\u7c21\u55ae\uff0810 \u500b\u5730\u96f7\uff09\uff0c\u4e2d\u7b49\uff0840 \u500b\u5730\u96f7\uff09\uff0c\u56f0\u96e3\uff0899 \u500b\u5730\u96f7\uff09\u3002"}, {"question": "\u6383\u96f7\u89e3\u984c\u5668\uff1a\u6383\u96f7\u89e3\u984c\u5668\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u5b83\u5011\u4f7f\u7528\u4e86\u54ea\u4e9b\u6f14\u7b97\u6cd5\u4f86\u8d0f\u5f97\u904a\u6232\uff1f", "answer": "\u6383\u96f7\u89e3\u984c\u5668\u4f7f\u7528\u908f\u8f2f\u63a8\u65b7\u548c\u6a5f\u7387\u6f14\u7b97\u6cd5\u4f86\u78ba\u5b9a\u5b89\u5168\u65b9\u584a\u3002\u5b83\u5011\u6a21\u64ec\u4eba\u985e\u7b56\u7565\uff0c\u4e26\u4ee5\u9060\u5feb\u7684\u901f\u5ea6\u5206\u6790\u6a21\u5f0f\u548c\u6a5f\u7387\u3002\u5e38\u898b\u7684\u6f14\u7b97\u6cd5\u5305\u62ec\u7d04\u675f\u6eff\u8db3\u548c\u8499\u5730\u5361\u7f85\u65b9\u6cd5\u3002\u66f4\u5148\u9032\u7684\u89e3\u984c\u5668\u53ef\u4ee5\u9054\u5230\u5c08\u5bb6\u7d1a\u5225\u3002\u904a\u6232\u89e3\u984c\u5668\u8207\u5c08\u5bb6\u73a9\u5bb6\u5728\u89e3\u6c7a\u554f\u984c\u65b9\u9762\u76f8\u4f3c\uff0c\u5118\u7ba1\u901f\u5ea6\u6709\u986f\u8457\u63d0\u5347\u3002"}, {"question": "\u8de8\u5e73\u53f0\u6383\u96f7\uff1a\u4e0d\u540c\u7684\u88dd\u7f6e\uff08\u4f8b\u5982\uff0c\u884c\u52d5\u88dd\u7f6e\u548c\u96fb\u8166\uff09\u4e0a\u7684\u6383\u96f7\u904a\u6232\u662f\u5426\u5141\u8a31\u8de8\u5e73\u53f0\u7684\u9032\u5ea6\u540c\u6b65\uff1f", "answer": "\u6383\u96f7\u904a\u6232\u662f\u5426\u5141\u8a31\u8de8\u5e73\u53f0\u9032\u5ea6\u540c\u6b65\u53d6\u6c7a\u65bc\u4f7f\u7528\u7684\u7279\u5b9a\u7248\u672c\u6216\u61c9\u7528\u7a0b\u5f0f\u3002\u67d0\u4e9b\u7248\u672c\uff0c\u5c24\u5176\u662f\u6709\u96f2\u7aef\u670d\u52d9\u6574\u5408\u7684\u73fe\u4ee3\u7248\u672c\uff0c\u5141\u8a31\u60a8\u5728\u767b\u5165\u5e33\u6236\u5f8c\u5728\u4e0d\u540c\u88dd\u7f6e\uff08\u884c\u52d5\u88dd\u7f6e\u548c\u96fb\u8166\uff09\u4e4b\u9593\u540c\u6b65\u9032\u5ea6\u3002\u7136\u800c\uff0c\u8a31\u591a\u7368\u7acb\u7248\u6216\u8f03\u820a\u7248\u672c\u5247\u4e0d\u63d0\u4f9b\u6b64\u529f\u80fd\u3002\u8acb\u67e5\u770b\u61c9\u7528\u7a0b\u5f0f\u7684\u8a2d\u5b9a\u6216\u6587\u4ef6\uff0c\u61c9\u8a72\u6709\u4e00\u500b\u900f\u904e\u5e33\u6236\u8a2d\u5b9a\u540c\u6b65\u9078\u9805\u3002 \u6bd4\u55bb\u8aaa\u660e\uff1a\u8de8\u5e73\u53f0\u9032\u5ea6\u540c\u6b65\u5c31\u50cf\u300e\u96f2\u7aef\u5132\u5b58\u300f\uff0c\u60a8\u7684\u904a\u6232\u9032\u5ea6\u5132\u5b58\u5728\u96f2\u7aef\uff0c\u4e4b\u5f8c\u53ef\u4ee5\u53d6\u56de\u3002"}, {"question": "\u6383\u96f7\u5f69\u86cb\uff1a\u662f\u5426\u5b58\u5728\u4efb\u4f55\u96b1\u85cf\u7684\u4e3b\u984c\u6216\u53ef\u81ea\u8a02\u9078\u9805\uff0c\u4ee5\u53ca\u5982\u4f55\u5728\u6383\u96f7\u904a\u6232\u4e2d\u555f\u7528\u300c\u591c\u9593\u6a21\u5f0f\u300d\uff1f", "answer": "\u8a31\u591a\u6383\u96f7\u7248\u672c\u63d0\u4f9b\u81ea\u8a02\u529f\u80fd\uff0c\u5305\u62ec\u4e3b\u984c\u548c\u8272\u5f69\u65b9\u6848\u3002\u8acb\u6aa2\u67e5\u8a2d\u5b9a\u9078\u55ae\uff0c\u67e5\u770b\u66f4\u6539\u5916\u89c0\u7684\u9078\u9805\u3002\u67d0\u4e9b\u7248\u672c\u53ef\u80fd\u5305\u542b\u7531\u7279\u5b9a\u6309\u9375\u7d44\u5408\u6216\u9ede\u64ca\u89f8\u767c\u7684\u5f69\u86cb\u3002\u300c\u591c\u9593\u6a21\u5f0f\u300d\u5982\u679c\u53ef\u7528\uff0c\u5247\u900f\u904e\u4f7f\u7528\u8f03\u6df1\u7684\u984f\u8272\u4f86\u6e1b\u5c11\u9ed1\u6697\u74b0\u5883\u7684\u8996\u529b\u75b2\u52de\u3002\u8acb\u5728\u8a2d\u5b9a\u4e2d\u5c0b\u627e\u4e3b\u984c\u914d\u7f6e\u3002\u60a8\u53ef\u80fd\u80fd\u5920\u627e\u5230\u4e00\u4e9b\u96b1\u85cf\u7684\u4e3b\u984c\u3002"}]
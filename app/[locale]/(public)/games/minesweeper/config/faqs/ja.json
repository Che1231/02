[{"question": "\u6383\u96f7\u57fa\u7840\uff1a\u5982\u4f55\u5f00\u59cb\u4e00\u573a\u6383\u96f7\u6e38\u620f\uff0c\u4ee5\u53ca\u7b2c\u4e00\u6b21\u70b9\u51fb\u4f1a\u505a\u4ec0\u4e48\uff1f", "answer": "\u5f00\u59cb\u4e00\u573a\u6383\u96f7\u6e38\u620f\u5f88\u7b80\u5355\u3002\u53ea\u9700\u70b9\u51fb\u7f51\u683c\u4e0a\u7684\u4efb\u4f55\u65b9\u5757\u3002\u7b2c\u4e00\u6b21\u70b9\u51fb\u6c38\u8fdc\u4e0d\u4f1a\u662f\u5730\u96f7\u3002\u5b83\u4f1a\u63ed\u793a\u4e00\u4e2a\u5b89\u5168\u533a\u57df\u6216\u4e00\u4e2a\u6307\u793a\u76f8\u90bb\u5730\u96f7\u7684\u6570\u91cf\u3002\u5982\u679c\u7b2c\u4e00\u6b21\u70b9\u51fb\u63ed\u793a\u4e86\u4e00\u4e2a\u5927\u533a\u57df\uff0c\u5219\u610f\u5473\u7740\u9644\u8fd1\u6ca1\u6709\u5730\u96f7\u3002\u76ee\u6807\u662f\u63ed\u5f00\u6240\u6709\u5b89\u5168\u65b9\u5757\uff0c\u800c\u4e0d\u4f1a\u5f15\u7206\u4efb\u4f55\u5730\u96f7\u3002\u793a\u4f8b\uff1a\u70b9\u51fb\u89d2\u843d\u65b9\u5757\u901a\u5e38\u662f\u4e00\u4e2a\u4e0d\u9519\u7684\u5f00\u59cb\uff0c\u56e0\u4e3a\u5b83\u53ef\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u6f5c\u5728\u7684\u76f8\u90bb\u5730\u96f7\u3002"}, {"question": "\u6383\u96f7\u4e2d\u7684\u6570\u5b57\u4ee3\u8868\u4ec0\u4e48\uff0c\u5b83\u4eec\u5982\u4f55\u5e2e\u52a9\u6211\u8bc6\u522b\u5b89\u5168\u533a\u57df\uff1f", "answer": "\u6383\u96f7\u4e2d\u7684\u6570\u5b57\u4ee3\u8868\u76f8\u90bb\u65b9\u5757\uff08\u6c34\u5e73\u3001\u5782\u76f4\u548c\u5bf9\u89d2\u7ebf\uff09\u4e2d\u5730\u96f7\u7684\u6570\u91cf\u3002\u5229\u7528\u8fd9\u4e9b\u6570\u5b57\uff0c\u60a8\u53ef\u4ee5\u63a8\u65ad\u51fa\u5730\u96f7\u6240\u5728\u4f4d\u7f6e\u5e76\u5c06\u5176\u6807\u8bb0\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4e00\u4e2a\u201c1\u201d\u4ec5\u4e0e\u4e00\u4e2a\u672a\u63ed\u5f00\u7684\u65b9\u5757\u76f8\u90bb\uff0c\u5219\u8be5\u672a\u63ed\u5f00\u7684\u65b9\u5757\u4e00\u5b9a\u662f\u5730\u96f7\u3002\u7ed3\u5408\u6570\u5b57\u7ebf\u7d22\u6765\u63ed\u793a\u66f4\u5927\u7684\u5b89\u5168\u533a\u57df\u3002\u914d\u7f6e\u8868\u5982\u4e0b\u6240\u793a\uff1a\n\u6570\u5b57 |\u5730\u96f7\u6570\u91cf\n---|---\n1|\u4e00\u679a\u5730\u96f7\n2|\u4e24\u679a\u5730\u96f7\n3|\u4e09\u679a\u5730\u96f7"}, {"question": "\u6383\u96f7\u6807\u8bb0\uff1a\u5728\u6383\u96f7\u4e2d\u4f7f\u7528\u6807\u8bb0\u4e3a\u4ec0\u4e48\u81f3\u5173\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u6b63\u786e\u6807\u8bb0\u6f5c\u5728\u7684\u5730\u96f7\uff1f", "answer": "\u5728\u6383\u96f7\u4e2d\uff0c\u6807\u5fd7\u5bf9\u4e8e\u6807\u8bb0\u60a8\u8ba4\u4e3a\u5305\u542b\u5730\u96f7\u7684\u65b9\u5757\u81f3\u5173\u91cd\u8981\uff0c\u8fd9\u53ef\u4ee5\u9632\u6b62\u610f\u5916\u70b9\u51fb\u548c\u5f15\u7206\u3002\u8981\u6807\u8bb0\u4e00\u4e2a\u65b9\u5757\uff0c\u8bf7\u53f3\u952e\u5355\u51fb\u5b83\uff08\u6216\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\u4f7f\u7528\u6307\u5b9a\u7684\u6807\u8bb0\u6309\u94ae\uff09\u3002\u4e00\u65e6\u6807\u8bb0\uff0c\u5728\u5220\u9664\u6807\u8bb0\u4e4b\u524d\uff0c\u8be5\u65b9\u5757\u4e0d\u4f1a\u88ab\u610f\u5916\u70b9\u51fb\u3002\u6709\u6548\u4f7f\u7528\u6807\u8bb0\u662f\u8fdb\u6b65\u7684\u5173\u952e\u3002\u793a\u4f8b\uff1a\u5982\u679c\u60a8\u770b\u5230\u4e00\u4e2a\u201c1\u201d\u4e0e\u4e00\u4e2a\u76f8\u90bb\u7684\u672a\u63ed\u5f00\u65b9\u5757\uff0c\u8bf7\u7acb\u5373\u6807\u8bb0\u5b83\uff0c\u4ee5\u907f\u514d\u9519\u8bef\u3002"}, {"question": "\u7b56\u7565\u6383\u96f7\uff1a\u4e3a\u4e86\u6301\u7eed\u6e05\u9664\u5927\u578b\u68cb\u76d8\uff0c\u6709\u54ea\u4e9b\u9ad8\u7ea7\u6383\u96f7\u7b56\u7565\uff1f", "answer": "\u5bf9\u4e8e\u5927\u578b\u6383\u96f7\u68cb\u76d8\uff0c\u8bf7\u8003\u8651\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9aa4 1\uff1a\u8bc6\u522b\u5e38\u89c1\u6a21\u5f0f\u3002\u5bfb\u627e\u201c1-2-1\u201d\u6216\u201c1-1\u201d\u914d\u7f6e\uff0c\u8fd9\u4e9b\u914d\u7f6e\u901a\u5e38\u4f1a\u63ed\u793a\u5730\u96f7\u3002\u6b65\u9aa4 2\uff1a\u4f7f\u7528\u9ad8\u7ea7\u6f14\u7ece\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4e00\u4e2a\u201c2\u201d\u6709\u4e24\u4e2a\u76f8\u90bb\u5df2\u6807\u8bb0\u7684\u5730\u96f7\uff0c\u5219\u6240\u6709\u5176\u4ed6\u76f8\u90bb\u65b9\u5757\u90fd\u662f\u5b89\u5168\u7684\u3002\u6b65\u9aa4 3\uff1a\u5b9a\u671f\u626b\u63cf\u68cb\u76d8\uff0c\u5bfb\u627e\u5b64\u7acb\u7684\u53ef\u89e3\u51b3\u7684\u7c07\u3002\u8fd9\u4e9b\u7b56\u7565\u6709\u52a9\u4e8e\u786e\u4fdd\u6301\u7eed\u6e05\u9664\u3002\u6bd4\u55bb\u8bf4\u660e\uff1a\u6383\u96f7\u7c7b\u4f3c\u4e8e\u4fa6\u7834\u6848\u4ef6\uff0c\u9075\u5faa\u7ebf\u7d22\u627e\u5230\u5acc\u7591\u4eba\u3002"}, {"question": "\u6383\u96f7\u8fde\u9501\uff1a\u5982\u4f55\u4f7f\u7528\u201c\u8fde\u9501\u201d\u6216\u201c\u70b9\u51fb\u201d\u5feb\u901f\u6e05\u9664\u5df2\u77e5\u5730\u96f7\u7684\u90e8\u5206\uff1f", "answer": "\u8fde\u9501\uff0c\u6216\u5728\u6807\u8bb0\u4e86\u6b63\u786e\u6570\u91cf\u7684\u76f8\u90bb\u5730\u96f7\u540e\u70b9\u51fb\u6570\u5b57\u65b9\u5757\uff0c\u4f1a\u7acb\u5373\u6e05\u9664\u6240\u6709\u5269\u4f59\u7684\u76f8\u90bb\u975e\u5730\u96f7\u65b9\u5757\u3002\u8fd9\u6781\u5927\u5730\u8282\u7701\u4e86\u65f6\u95f4\u3002\u5728\u8fde\u9501\u4e4b\u524d\uff0c\u786e\u4fdd\u6807\u8bb0\u51c6\u786e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4e00\u4e2a\u201c3\u201d\u5468\u56f4\u6709\u4e09\u4e2a\u6807\u8bb0\uff0c\u5219\u8fde\u9501\u70b9\u51fb\u5c06\u5feb\u901f\u63ed\u793a\u6240\u6709\u5176\u4ed6\u76f8\u90bb\u975e\u5730\u96f7\u65b9\u5757\u3002\u65b9\u6848\u6bd4\u8f83\uff1a\u6807\u51c6\u70b9\u51fb\u662f\u9010\u6b65\u8fdb\u884c\uff0c\u8fde\u9501\u70b9\u51fb\u4f1a\u4e00\u6b21\u6e05\u9664\u591a\u4e2a\u3002"}, {"question": "\u6383\u96f7\u6982\u7387\uff1a\u5f53\u6211\u5728\u6383\u96f7\u68cb\u76d8\u4e0a\u9047\u5230\u56f0\u96be\u65f6\uff0c\u5982\u4f55\u4f7f\u7528\u6982\u7387\u8fdb\u884c\u5b89\u5168\u731c\u6d4b\uff1f", "answer": "\u5f53\u4e0d\u80fd\u8fdb\u884c\u660e\u786e\u63a8\u65ad\u65f6\uff0c\u8bf7\u4f7f\u7528\u6982\u7387\u3002\u4f30\u7b97\u672a\u89e3\u51b3\u533a\u57df\u4e2d\u7684\u5730\u96f7\u5bc6\u5ea6\uff0c\u5e76\u70b9\u51fb\u5730\u96f7\u53ef\u80fd\u6027\u6700\u4f4e\u7684\u65b9\u5757\u3002\u8fd9\u662f\u6709\u98ce\u9669\u7684\uff0c\u4f46\u6709\u65f6\u662f\u5fc5\u8981\u7684\u3002\u793a\u4f8b\uff1a\u5982\u679c\u6709\u4e00\u4e2a\u5927\u578b\u672a\u89e3\u51b3\u533a\u57df\u548c\u4e00\u4e9b\u8fb9\u754c\u6570\u5b57\uff0c\u70b9\u51fb\u8be5\u672a\u89e3\u51b3\u533a\u57df\u7684\u4e2d\u5fc3\u533a\u57df\u53ef\u80fd\u5177\u6709\u8f83\u4f4e\u7684\u5730\u96f7\u5bc6\u5ea6\u3002\u6d41\u7a0b\u56fe\u5982\u4e0b\u6240\u793a\uff1a\n\u5f00\u59cb -> \u6f14\u7ece -> \u4e0d\u53ef\u89e3\u51b3\uff1f -> \u6982\u7387\u4f30\u8ba1 -> \u5b89\u5168\u70b9\u51fb\u3002"}, {"question": "\u6383\u96f7\u7b97\u6cd5\uff1a\u5728\u6383\u96f7\u4e2d\u786e\u5b9a\u5730\u96f7\u653e\u7f6e\u7684\u5e95\u5c42\u7b97\u6cd5\u662f\u4ec0\u4e48\uff1f", "answer": "\u6383\u96f7\u901a\u5e38\u4f7f\u7528\u968f\u673a\u6570\u751f\u6210\u5668\u5728\u7b2c\u4e00\u6b21\u70b9\u51fb\u540e\u653e\u7f6e\u5730\u96f7\uff0c\u4ee5\u786e\u4fdd\u7b2c\u4e00\u6b21\u70b9\u51fb\u603b\u662f\u5b89\u5168\u7684\u3002\u8be5\u7b97\u6cd5\u6839\u636e\u8bbe\u5b9a\u7684\u96be\u5ea6\u5c06\u5730\u96f7\u5747\u5300\u5730\u5206\u5e03\u5728\u7f51\u683c\u4e2d\u3002\u67d0\u4e9b\u7248\u672c\u53ef\u80fd\u4f1a\u8c03\u6574\u5730\u96f7\u653e\u7f6e\u4ee5\u9632\u6b62\u65e0\u6cd5\u89e3\u51b3\u7684\u68cb\u76d8\u72b6\u6001\u3002\u6570\u503c\u5206\u6790\u8868\u660e\uff0c\u5730\u96f7\u5206\u5e03\u4e0e\u8bbe\u5b9a\u7684\u96be\u5ea6\u8bbe\u7f6e\u4fdd\u6301\u4e00\u81f4\u3002\u914d\u7f6e\u5982\u4e0b\uff1a\u7b80\u5355\uff0810 \u679a\u5730\u96f7\uff09\uff0c\u4e2d\u7b49\uff0840 \u679a\u5730\u96f7\uff09\uff0c\u56f0\u96be\uff0899 \u679a\u5730\u96f7\uff09\u3002"}, {"question": "\u6383\u96f7\u6c42\u89e3\u5668\uff1a\u6383\u96f7\u6c42\u89e3\u5668\u5982\u4f55\u5de5\u4f5c\uff0c\u5b83\u4eec\u4f7f\u7528\u4e86\u54ea\u4e9b\u7b97\u6cd5\u6765\u6218\u80dc\u6e38\u620f\uff1f", "answer": "\u6383\u96f7\u6c42\u89e3\u5668\u4f7f\u7528\u903b\u8f91\u63a8\u6f14\u548c\u6982\u7387\u7b97\u6cd5\u6765\u786e\u5b9a\u5b89\u5168\u65b9\u5757\u3002\u5b83\u4eec\u6a21\u62df\u4eba\u7c7b\u7b56\u7565\u5e76\u5206\u6790\u6a21\u5f0f\u548c\u6982\u7387\uff0c\u901f\u5ea6\u8981\u5feb\u5f97\u591a\u3002\u5e38\u7528\u7684\u7b97\u6cd5\u5305\u62ec\u7ea6\u675f\u6ee1\u8db3\u548c\u8499\u7279\u5361\u7f57\u65b9\u6cd5\u3002\u66f4\u9ad8\u7ea7\u7684\u6c42\u89e3\u5668\u53ef\u4ee5\u5728\u4e13\u5bb6\u7ea7\u522b\u73a9\u6e38\u620f\u3002\u6e38\u620f\u6c42\u89e3\u5668\u5728\u89e3\u51b3\u95ee\u9898\u65b9\u9762\u4e0e\u4e13\u5bb6\u73a9\u5bb6\u76f8\u4f3c\uff0c\u5c3d\u7ba1\u901f\u5ea6\u6709\u5f88\u5927\u63d0\u9ad8\u3002"}, {"question": "\u5e73\u53f0\u901a\u7528\u6383\u96f7\uff1a\u4e0d\u540c\u7684\u8bbe\u5907\uff08\u4f8b\u5982\u79fb\u52a8\u8bbe\u5907\u548c\u4e2a\u4eba\u7535\u8111\uff09\u4e0a\u662f\u5426\u6709\u53ef\u4ee5\u540c\u6b65\u6383\u96f7\u8fdb\u5ea6\u529f\u80fd\uff1f", "answer": "\u6383\u96f7\u7684\u8de8\u5e73\u53f0\u8fdb\u5ea6\u540c\u6b65\u529f\u80fd\u7684\u53ef\u7528\u6027\u53d6\u51b3\u4e8e\u4f7f\u7528\u54ea\u4e2a\u7279\u5b9a\u7248\u672c\u6216\u5e94\u7528\u7a0b\u5e8f\u3002\u67d0\u4e9b\u7248\u672c\uff0c\u7279\u522b\u662f\u90a3\u4e9b\u4e0e\u4e91\u670d\u52a1\u96c6\u6210\u6bd4\u8f83\u5148\u8fdb\u7684\u7248\u672c\uff0c\u5982\u679c\u60a8\u767b\u5f55\u60a8\u7684\u5e10\u6237\uff0c\u5219\u5141\u8bb8\u60a8\u5728\u8bbe\u5907\u4e4b\u95f4\uff08\u79fb\u52a8\u8bbe\u5907\u548c\u4e2a\u4eba\u7535\u8111\uff09\u540c\u6b65\u60a8\u7684\u8fdb\u5ea6\u3002\u4f46\u662f\uff0c\u8bb8\u591a\u72ec\u7acb\u7248\u672c\u6216\u8f83\u65e7\u7684\u7248\u672c\u4e0d\u63d0\u4f9b\u6b64\u529f\u80fd\u3002\u8bf7\u68c0\u67e5\u5e94\u7528\u7684\u8bbe\u7f6e\u6216\u6587\u6863\uff0c\u5e94\u8be5\u6709\u4e00\u4e2a\u901a\u8fc7\u5e10\u6237\u8bbe\u7f6e\u8fdb\u884c\u540c\u6b65\u7684\u9009\u9879\u3002 \u6bd4\u55bb\u8bf4\u660e\uff1a\u8de8\u5e73\u53f0\u8fdb\u5ea6\u540c\u6b65\u5c31\u50cf\u201c\u4e91\u4fdd\u5b58\u201d\u4e00\u6837\uff0c\u60a8\u7684\u8fdb\u5ea6\u6570\u636e\u4fdd\u5b58\u5728\u4e91\u7aef\uff0c\u7a0d\u540e\u53ef\u4ee5\u68c0\u7d22\u3002"}, {"question": "\u6383\u96f7\u5f69\u86cb\uff1a\u662f\u5426\u6709\u4efb\u4f55\u9690\u85cf\u4e3b\u9898\u6216\u53ef\u81ea\u5b9a\u4e49\u9009\u9879\uff0c\u4ee5\u53ca\u5982\u4f55\u5728\u6383\u96f7\u4e2d\u542f\u7528\u201c\u591c\u95f4\u6a21\u5f0f\u201d\uff1f", "answer": "\u8bb8\u591a\u6383\u96f7\u7248\u672c\u63d0\u4f9b\u4e86\u81ea\u5b9a\u4e49\u529f\u80fd\uff0c\u5305\u62ec\u4e3b\u9898\u548c\u989c\u8272\u65b9\u6848\u3002\u8bf7\u68c0\u67e5\u8bbe\u7f6e\u83dc\u5355\u4ee5\u66f4\u6539\u5916\u89c2\u3002\u67d0\u4e9b\u7248\u672c\u53ef\u80fd\u901a\u8fc7\u7279\u5b9a\u6309\u952e\u7ec4\u5408\u6216\u70b9\u51fb\u542f\u7528\u5f69\u86cb\u3002\u201c\u591c\u95f4\u6a21\u5f0f\u201d\u5982\u679c\u53ef\u7528\uff0c\u53ef\u901a\u8fc7\u4f7f\u7528\u8f83\u6df1\u989c\u8272\u6765\u51cf\u5c11\u9ed1\u6697\u73af\u5883\u4e2d\u7684\u89c6\u89c9\u75b2\u52b3\u3002\u5728\u8bbe\u7f6e\u4e0b\u67e5\u627e\u4e3b\u9898\u914d\u7f6e\u3002\u60a8\u53ef\u80fd\u80fd\u591f\u627e\u5230\u4e00\u4e9b\u9690\u85cf\u7684\u4e3b\u9898\u3002"}]
[{"question": "\ub9c8\uc778\uc2a4\uc704\ud37c \uae30\ubcf8: \ub9c8\uc778\uc2a4\uc704\ud37c \uac8c\uc784\uc744 \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud558\uba70, \ucd08\uae30 \ud074\ub9ad\uc740 \ubb34\uc5c7\uc744 \ud569\ub2c8\uae4c?", "answer": "\ub9c8\uc778\uc2a4\uc704\ud37c \uac8c\uc784\uc744 \uc2dc\uc791\ud558\ub294 \uac83\uc740 \uac04\ub2e8\ud569\ub2c8\ub2e4. \uadf8\ub9ac\ub4dc\uc758 \uc5b4\ub5a4 \uc0ac\uac01\ud615\uc774\ub4e0 \ud074\ub9ad\ud558\uae30\ub9cc \ud558\uc138\uc694. \uccab \ubc88\uc9f8 \ud074\ub9ad\uc740 \uc9c0\ub8b0\uac00 \uc544\ub2d9\ub2c8\ub2e4. \uc548\uc804\ud55c \uc601\uc5ed \ub610\ub294 \uc778\uc811\ud55c \uc9c0\ub8b0\ub97c \ub098\ud0c0\ub0b4\ub294 \uc22b\uc790\ub97c \ub4dc\ub7ec\ub0c5\ub2c8\ub2e4. \uccab \ubc88\uc9f8 \ud074\ub9ad\uc73c\ub85c \ud070 \uc601\uc5ed\uc774 \ub4dc\ub7ec\ub09c\ub2e4\uba74 \uadfc\ucc98\uc5d0 \uc9c0\ub8b0\uac00 \uc5c6\ub2e4\ub294 \uac83\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4. \ubaa9\ud45c\ub294 \uc9c0\ub8b0\ub97c \ud3ed\ubc1c\uc2dc\ud0a4\uc9c0 \uc54a\uace0 \ubaa8\ub4e0 \uc548\uc804\ud55c \uc0ac\uac01\ud615\uc744 \ub4dc\ub7ec\ub0b4\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608: \ubaa8\uc11c\ub9ac \ud0c0\uc77c\uc744 \ud074\ub9ad\ud558\ub294 \uac83\uc774 \uc88b\uc740 \uc2dc\uc791\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc65c\ub0d0\ud558\uba74 \uc778\uc811 \uc9c0\ub8b0\uc758 \uac00\ub2a5\uc131\uc744 \ucd5c\uc18c\ud654\ud560 \uc218 \uc788\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4."}, {"question": "\ub9c8\uc778\uc2a4\uc704\ud37c \uc22b\uc790\ub294 \ubb34\uc5c7\uc744 \ub098\ud0c0\ub0b4\uba70 \uc548\uc804 \uad6c\uc5ed\uc744 \uc2dd\ubcc4\ud558\ub294 \ub370 \uc5b4\ub5bb\uac8c \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub9c8\uc778\uc2a4\uc704\ud37c\uc5d0\uc11c \uc22b\uc790\ub294 \uc778\uc811\ud55c \uc0ac\uac01\ud615(\uc218\ud3c9, \uc218\uc9c1 \ubc0f \ub300\uac01\uc120)\uc5d0 \uc788\ub294 \uc9c0\ub8b0\uc758 \uac1c\uc218\ub97c \ub098\ud0c0\ub0c5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc22b\uc790\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc9c0\ub8b0\uac00 \uc788\ub294 \uc704\uce58\ub97c \ucd94\ub860\ud558\uace0 \ud45c\uc2dc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '1'\uc774 \ud558\ub098\uc758 \ub36e\uc778 \uc0ac\uac01\ud615\ub9cc \uc778\uc811\ud574 \uc788\uc73c\uba74 \uadf8 \ub36e\uc778 \uc0ac\uac01\ud615\uc740 \uc9c0\ub8b0\uc5ec\uc57c \ud569\ub2c8\ub2e4. \uc22b\uc790 \ub2e8\uc11c\ub4e4\uc744 \uacb0\ud569\ud558\uc5ec \ub354 \ud070 \uc548\uc804 \uc601\uc5ed\uc744 \ub4dc\ub7ec\ub0b4\uc138\uc694. \uad6c\uc131 \ud45c\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4:\n\uc22b\uc790 | \uc9c0\ub8b0 \uc218\n---|---\n1|\uc9c0\ub8b0 \ud558\ub098\n2|\uc9c0\ub8b0 \ub458\n3|\uc9c0\ub8b0 \uc14b"}, {"question": "\ub9c8\uc778\uc2a4\uc704\ud37c \ud45c\uc2dc\uae30: \ub9c8\uc778\uc2a4\uc704\ud37c\uc5d0\uc11c \ud45c\uc2dc\uae30\ub97c \uc0ac\uc6a9\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70 \uc7a0\uc7ac\uc801\uc778 \uc9c0\ub8b0\ub97c \uc62c\ubc14\ub974\uac8c \ud45c\uc2dc\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud45c\uc2dc\uae30\ub294 \ub9c8\uc778\uc2a4\uc704\ud37c\uc5d0\uc11c \uc9c0\ub8b0\uac00 \uc788\ub2e4\uace0 \uc0dd\uac01\ud558\ub294 \uc0ac\uac01\ud615\uc744 \ud45c\uc2dc\ud558\uc5ec \uc2e4\uc218\ub85c \ud074\ub9ad\ud558\uace0 \ud3ed\ubc1c\ud558\ub294 \uac83\uc744 \ubc29\uc9c0\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc0ac\uac01\ud615\uc744 \ud45c\uc2dc\ud558\ub824\uba74 \ub9c8\uc6b0\uc2a4 \uc624\ub978\ucabd \ubc84\ud2bc\uc744 \ud074\ub9ad\ud558\uac70\ub098(\ub610\ub294 \ubaa8\ubc14\uc77c\uc758 \uc9c0\uc815\ub41c \ud45c\uc2dc\uae30 \ubc84\ud2bc\uc744 \uc0ac\uc6a9\ud558\uc138\uc694). \ud45c\uc2dc\uac00 \ub418\uba74, \ud45c\uc2dc\uae30\ub97c \uc81c\uac70\ud560 \ub54c\uae4c\uc9c0 \ud574\ub2f9 \uc0ac\uac01\ud615\uc740 \uc2e4\uc218\ub85c \ud074\ub9ad\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ud45c\uc2dc\uae30\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \uac83\uc774 \uc9c4\uc804\ud558\ub294 \ub370 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608: '1'\uc774 \uc778\uc811\ud55c \ub36e\uc778 \uc0ac\uac01\ud615 \ud558\ub098\uc640 \uc778\uc811\ud574 \uc788\uc73c\uba74, \uc2e4\uc218\ub97c \ud53c\ud558\uae30 \uc704\ud574 \uc989\uc2dc \ud45c\uc2dc\ud558\uc138\uc694."}, {"question": "\uc804\ub7b5\uc801 \ub9c8\uc778\uc2a4\uc704\ud37c: \ub354 \ud070 \ubcf4\ub4dc\ub97c \uc9c0\uc18d\uc801\uc73c\ub85c \ud574\uacb0\ud558\uae30 \uc704\ud55c \ub9c8\uc778\uc2a4\uc704\ud37c\uc758 \uace0\uae09 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub354 \ud070 \ub9c8\uc778\uc2a4\uc704\ud37c \ubcf4\ub4dc\uc758 \uacbd\uc6b0 \ub2e4\uc74c \uc804\ub7b5\uc744 \uace0\ub824\ud558\uc2ed\uc2dc\uc624: 1\ub2e8\uacc4: \uc77c\ubc18\uc801\uc778 \ud328\ud134\uc744 \uc2dd\ubcc4\ud569\ub2c8\ub2e4. '1-2-1' \ub610\ub294 '1-1' \uad6c\uc131\uc744 \ucc3e\uc73c\uc138\uc694. \uc774\uac83\uc740 \uc885\uc885 \uc9c0\ub8b0\ub97c \ub4dc\ub7ec\ub0c5\ub2c8\ub2e4. 2\ub2e8\uacc4: \uace0\uae09 \ucd94\ub860\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '2'\uc5d0 \uc778\uc811\ud55c \ud45c\uc2dc\ub41c \uc9c0\ub8b0\uac00 \ub458\uc774 \uc788\ub2e4\uba74 \ub2e4\ub978 \uc778\uc811\ud55c \uc0ac\uac01\ud615\uc740 \uc548\uc804\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \uc8fc\uae30\uc801\uc73c\ub85c \ubcf4\ub4dc\ub97c \uc2a4\uce94\ud558\uc5ec \ub3c5\ub9bd\uc801\uc73c\ub85c \ud574\uacb0 \uac00\ub2a5\ud55c \ud074\ub7ec\uc2a4\ud130\ub97c \ucc3e\uc73c\uc138\uc694. \uc774\ub7ec\ud55c \uc804\ub7b5\uc740 \uc9c0\uc18d\uc801\uc778 \ud574\uacb0\uc744 \ub3d5\uc2b5\ub2c8\ub2e4. \ube44\uc720: \ub9c8\uc778\uc2a4\uc704\ud37c\ub294 \ud0d0\uc815 \uc0ac\uac74\uc744 \ud478\ub294 \uac83\uacfc \ube44\uc2b7\ud569\ub2c8\ub2e4. \ub2e8\uc11c\ub97c \ub530\ub77c \uc758\uc2ec\uc2a4\ub7ec\uc6b4 \ubd80\ubd84\uc744 \ucc3e\uc73c\uc138\uc694."}, {"question": "\ub9c8\uc778\uc2a4\uc704\ud37c \uc5f0\uacb0: \uc54c\ub824\uc9c4 \uc9c0\ub8b0\uac00 \uc788\ub294 \uc139\uc158\uc744 \uc2e0\uc18d\ud558\uac8c \uc815\ub9ac\ud558\uae30 \uc704\ud574 '\uc5f0\uacb0' \ub610\ub294 '\ud074\ub9ad'\uc744 \uc5b4\ub5bb\uac8c \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc5f0\uacb0, \ub610\ub294 \uc62c\ubc14\ub978 \uc218\uc758 \uc778\uc811 \uc9c0\ub8b0\ub97c \ud45c\uc2dc\ud55c \ud6c4 \ubc88\ud638\uac00 \ub9e4\uaca8\uc9c4 \uc0ac\uac01\ud615\uc744 \ud074\ub9ad\ud558\uba74 \ubaa8\ub4e0 \uc778\uc811\ud55c \ube44\uc9c0\ub8b0 \uc0ac\uac01\ud615\uc744 \ud55c \ubc88\uc5d0 \uc815\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\uac83\uc740 \uc2dc\uac04\uc744 \ud06c\uac8c \uc808\uc57d\ud558\ub294 \ubc29\ubc95\uc785\ub2c8\ub2e4. \uc5f0\uacb0\ud558\uae30 \uc804\uc5d0 \ud45c\uc2dc\uae30\uac00 \uc815\ud655\ud55c\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '3'\uc5d0 \uc778\uc811\ud55c \uc138 \uac1c\uc758 \ud45c\uc2dc\ub41c \uc9c0\ub8b0\uac00 \uc788\ub2e4\uba74 \uc5f0\uacb0 \ud074\ub9ad\uc740 \ubaa8\ub4e0 \ub2e4\ub978 \uc778\uc811\ud55c \ube44\uc9c0\ub8b0 \uc0ac\uac01\ud615\uc744 \uc2e0\uc18d\ud558\uac8c \ub4dc\ub7ec\ub0bc \uac83\uc785\ub2c8\ub2e4. \uc2a4\ud0a4\ub9c8 \ube44\uad50: \ud45c\uc900 \ud074\ub9ad\uc740 \ub2e8\uacc4\ubcc4\uc774\uba70, \uc5f0\uacb0 \ud074\ub9ad\uc740 \uc5ec\ub7ec \uac1c\ub97c \ud55c \ubc88\uc5d0 \uc815\ub9ac\ud569\ub2c8\ub2e4."}, {"question": "\ub9c8\uc778\uc2a4\uc704\ud37c \ud655\ub960: \ub9c8\uc778\uc2a4\uc704\ud37c \ubcf4\ub4dc\uc5d0\uc11c \ub9c9\ud614\uc744 \ub54c \ud655\ub960\uc744 \uc548\uc804\ud558\uac8c \ucd94\uce21\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uba85\ud655\ud55c \ucd94\ub860\uc744 \ud560 \uc218 \uc5c6\ub294 \uacbd\uc6b0 \ud655\ub960\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. \ud480\ub9ac\uc9c0 \uc54a\uc740 \uc601\uc5ed\uc758 \uc9c0\ub8b0 \ubc00\ub3c4\ub97c \ucd94\uc815\ud558\uace0 \uc9c0\ub8b0\uac00 \ub420 \uac00\ub2a5\uc131\uc774 \uac00\uc7a5 \ub0ae\uc740 \uc0ac\uac01\ud615\uc744 \ud074\ub9ad\ud558\uc138\uc694. \uc704\ud5d8\ud558\uc9c0\ub9cc \ub54c\ub85c\ub294 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608: \uba87 \uac1c\uc758 \uacbd\uacc4 \uc22b\uc790\uac00 \uc788\ub294 \ud070 \ud480\ub9ac\uc9c0 \uc54a\uc740 \uc601\uc5ed\uc774 \uc788\ub2e4\uba74 \ud574\ub2f9 \ud480\ub9ac\uc9c0 \uc54a\uc740 \uc601\uc5ed\uc758 \uc911\uc559 \uc601\uc5ed\uc744 \ud074\ub9ad\ud558\uba74 \uc9c0\ub8b0 \ubc00\ub3c4\uac00 \ub354 \ub0ae\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud750\ub984\ub3c4\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: \n\uc2dc\uc791 -> \ucd94\ub860 -> \ud574\uacb0 \ubd88\uac00\ub2a5? -> \ud655\ub960 \ucd94\uc815 -> \uc548\uc804 \ud074\ub9ad."}, {"question": "\ub9c8\uc778\uc2a4\uc704\ud37c \uc54c\uace0\ub9ac\uc998: \ub9c8\uc778\uc2a4\uc704\ud37c\uc5d0\uc11c \uc9c0\ub8b0 \ubc30\uce58\ub97c \uacb0\uc815\ud558\ub294 \uae30\ubcf8 \uc54c\uace0\ub9ac\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub9c8\uc778\uc2a4\uc704\ud37c\ub294 \uc77c\ubc18\uc801\uc73c\ub85c \uccab \ubc88\uc9f8 \ud074\ub9ad\uc774 \ud56d\uc0c1 \uc548\uc804\ud558\ub3c4\ub85d \uccab \ubc88\uc9f8 \ud074\ub9ad \ud6c4 \uc9c0\ub8b0\ub97c \ubc30\uce58\ud558\uae30 \uc704\ud574 \ub09c\uc218 \uc0dd\uc131\uae30\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc54c\uace0\ub9ac\uc998\uc740 \uc124\uc815\ub41c \ub09c\uc774\ub3c4\uc5d0 \ub530\ub77c \uadf8\ub9ac\ub4dc\uc5d0\uc11c \uc9c0\ub8b0\ub97c \uade0\ub4f1\ud558\uac8c \ubd84\ubc30\ud569\ub2c8\ub2e4. \uc77c\ubd80 \ubc84\uc804\uc740 \ud480 \uc218 \uc5c6\ub294 \ubcf4\ub4dc \uc0c1\ud0dc\ub97c \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \uc9c0\ub8b0 \ubc30\uce58\ub97c \uc870\uc815\ud560 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. \uc218\uce58 \ubd84\uc11d\uc5d0 \ub530\ub974\uba74 \uc9c0\ub8b0 \ubd84\ud3ec\ub294 \uc124\uc815\ub41c \ub09c\uc774\ub3c4\uc640 \uc77c\uce58\ud569\ub2c8\ub2e4. \uad6c\uc131\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: \uc26c\uc6c0(10\uac1c \uc9c0\ub8b0), \uc911\uac04(40\uac1c \uc9c0\ub8b0), \uc5b4\ub824\uc6c0(99\uac1c \uc9c0\ub8b0)."}, {"question": "\ub9c8\uc778\uc2a4\uc704\ud37c \uc194\ubc84: \ub9c8\uc778\uc2a4\uc704\ud37c \uc194\ubc84\ub294 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \uac8c\uc784\uc744 \uc774\uae30\uae30 \uc704\ud574 \uc5b4\ub5a4 \uc54c\uace0\ub9ac\uc998\uc744 \uc0ac\uc6a9\ud569\ub2c8\uae4c?", "answer": "\ub9c8\uc778\uc2a4\uc704\ud37c \uc194\ubc84\ub294 \ub17c\ub9ac\uc801 \ucd94\ub860\uacfc \ud655\ub960\uc801 \uc54c\uace0\ub9ac\uc998\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc548\uc804\ud55c \uc0ac\uac01\ud615\uc744 \uacb0\uc815\ud569\ub2c8\ub2e4. \uc778\uac04\uc758 \uc804\ub7b5\uc744 \uc2dc\ubbac\ub808\uc774\uc158\ud558\uace0 \ud328\ud134\uacfc \ud655\ub960\uc744 \ud6e8\uc52c \ube60\ub974\uac8c \ubd84\uc11d\ud569\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc778 \uc54c\uace0\ub9ac\uc998\uc5d0\ub294 \uc81c\uc57d \ub9cc\uc871 \ubc0f \ubaac\ud14c \uce74\ub97c\ub85c \ubc29\ubc95\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \ub354 \uace0\uae09 \uc194\ubc84\ub294 \uc804\ubb38\uac00 \uc218\uc900\uc5d0\uc11c \ud50c\ub808\uc774\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784 \uc194\ubc84\ub294 \ubb38\uc81c \ud574\uacb0 \uce21\uba74\uc5d0\uc11c \uc804\ubb38\uac00 \ud50c\ub808\uc774\uc5b4\uc640 \uc720\uc0ac\ud558\uc9c0\ub9cc \uc18d\ub3c4\uac00 \ud604\uaca9\ud788 \ud5a5\uc0c1\ub418\uc5c8\uc2b5\ub2c8\ub2e4."}, {"question": "\ub9c8\uc778\uc2a4\uc704\ud37c \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc: \ub2e4\ub978 \uc7a5\uce58(\uc608: \ubaa8\ubc14\uc77c \ubc0f PC)\uc5d0\uc11c \ub9c8\uc778\uc2a4\uc704\ud37c\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud558\ub294 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \uae30\ub2a5\uc774 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub9c8\uc778\uc2a4\uc704\ud37c\uc758 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \uc9c4\ud589 \uc0c1\ud669 \ub3d9\uae30\ud654\uc758 \uc720\ubb34\ub294 \uc0ac\uc6a9 \uc911\uc778 \ud2b9\uc815 \ubc84\uc804 \ub610\ub294 \uc571\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. \uad6c\ub984 \uc11c\ube44\uc2a4 \ud1b5\ud569\uc744 \ud1b5\ud574 \uc81c\uacf5\ub418\ub294 \ud2b9\ud788 \ucd5c\uc2e0 \ubc84\uc804\uc758 \uacbd\uc6b0 \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uba74 \uc7a5\uce58 \uac04(\ubaa8\ubc14\uc77c \ubc0f PC) \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \ub9ce\uc740 \ub3c5\ub9bd\ud615 \ub610\ub294 \uc774\uc804 \ubc84\uc804\uc740 \uc774 \uae30\ub2a5\uc744 \uc81c\uacf5\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc571 \uc124\uc815\uc774\ub098 \uc124\uba85\uc11c\ub97c \ud655\uc778\ud558\uc138\uc694. \uacc4\uc815 \uc124\uc815\uc744 \ud1b5\ud574 \ub3d9\uae30\ud654 \uc635\uc158\uc774 \uc788\uc5b4\uc57c \ud569\ub2c8\ub2e4. \ube44\uc720: \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \uc9c4\ud589 \uc0c1\ud669 \ub3d9\uae30\ud654\ub294 '\ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5'\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc9c4\ud589 \ub370\uc774\ud130\uac00 \ud074\ub77c\uc6b0\ub4dc\uc5d0 \uc800\uc7a5\ub418\uc5b4 \ub098\uc911\uc5d0 \uac80\uc0c9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub9c8\uc778\uc2a4\uc704\ud37c \uc774\uc2a4\ud130 \uc5d0\uadf8: \uc228\uaca8\uc9c4 \ud14c\ub9c8\ub098 \uc0ac\uc6a9\uc790 \uc9c0\uc815 \uc635\uc158\uc774 \uc788\uc2b5\ub2c8\uae4c? \ub9c8\uc778\uc2a4\uc704\ud37c\uc5d0\uc11c '\uc57c\uac04 \ubaa8\ub4dc'\ub97c \uc5b4\ub5bb\uac8c \ud65c\uc131\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub9ce\uc740 \ub9c8\uc778\uc2a4\uc704\ud37c \ubc84\uc804\uc774 \uc0ac\uc6a9\uc790 \uc9c0\uc815 \uae30\ub2a5\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ud14c\ub9c8\uc640 \uc0c9\uc0c1\ud45c\ub97c \ubcc0\uacbd\ud558\ub294 \uc635\uc158\uc774 \uc788\ub294 \uc124\uc815 \uba54\ub274\ub97c \ud655\uc778\ud558\uc138\uc694. \uc77c\ubd80 \ubc84\uc804\uc5d0\ub294 \ud2b9\uc815 \ud0a4 \uc870\ud569\uc774\ub098 \ud074\ub9ad\uc73c\ub85c \ud65c\uc131\ud654\ub418\ub294 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. '\uc57c\uac04 \ubaa8\ub4dc'\uac00 \uc0ac\uc6a9 \uac00\ub2a5\ud558\uba74 \uc5b4\ub450\uc6b4 \ud658\uacbd\uc5d0\uc11c \ub208\uc758 \ud53c\ub85c\ub97c \uc904\uc774\uae30 \uc704\ud574 \ub354 \uc5b4\ub450\uc6b4 \uc0c9\uc0c1\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc124\uc815\uc5d0\uc11c \ud14c\ub9c8 \uad6c\uc131\uc744 \ucc3e\uc73c\uc138\uc694. \uc228\uaca8\uc9c4 \ud14c\ub9c8\ub97c \ucc3e\uc744 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4."}]
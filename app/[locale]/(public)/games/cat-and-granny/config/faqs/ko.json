[{"question": "\uace0\uc591\uc774\uc640 \ud560\uba38\ub2c8\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \ubc30\uc6b0\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub294 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uba74 \uace0\uc591\uc774\uc640 \ud560\uba38\ub2c8\uc5d0\uc11c \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ub9c8\uc2a4\ud130\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \ud654\uba74\uc758 \uc870\uc774\uc2a4\ud2f1\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc774\ub3d9 \ucee8\ud2b8\ub864\uc5d0 \uc775\uc219\ud574\uc9d1\ub2c8\ub2e4. \ub2e8\uacc4 2: \ud560\uba38\ub2c8\uc758 \ud568\uc815\uc744 \ud53c\ud558\ub294 \uac83\uacfc \uac19\uc740 \uc7a5\uc560\ubb3c\uc744 \uadf9\ubcf5\ud558\uae30 \uc704\ud574 \uc810\ud504\uc640 \uc6c5\ud06c\ub9ac\ub294 \uc5f0\uc2b5\uc744 \ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ubb38 \uc5f4\uae30 \ub610\ub294 \ubb3c\uac74 \uc9d1\uc5b4 \uc62c\ub9ac\uae30\uc640 \uac19\uc774 \uc561\uc158 \ubc84\ud2bc\uc744 \ud0ed\ud558\uc5ec \ubb3c\uccb4\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\ub294 \ubc29\ubc95\uc744 \ubc30\uc6c1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c\ub294 \ubd80\uc11c\uc9c4 \uacc4\ub2e8 \uc704\ub85c \uc810\ud504\ud558\uace0 \ub0ae\uac8c \ub9e4\ub2ec\ub9b0 \ube54 \uc544\ub798\ub85c \uc6c5\ud06c\ub824\uc57c \ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ucee8\ud2b8\ub864\uc744 \uac8c\uc784\uc758 ABC \uc21c\uc11c\ub85c \uc0dd\uac01\ud558\uc2ed\uc2dc\uc624. \uc0dd\uc874\uacfc \uc9c4\ud589\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4."}, {"question": "100\uc2dc\uac04\uc758 \uac8c\uc784 \ud50c\ub808\uc774 \ud6c4 \uace0\uc591\uc774\uc640 \ud560\uba38\ub2c8\uc5d0\uc11c \ud560\uba38\ub2c8\ub97c \ud53c\ud558\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "100\uc2dc\uac04 \ud6c4 \ud50c\ub808\uc774\uc5b4\ub294 \ud560\uba38\ub2c8\ub97c \ud53c\ud558\uae30 \uc704\ud55c \uace0\uae09 \uc804\ub7b5\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \ud560\uba38\ub2c8\uc758 \uc21c\ucc30 \uacbd\ub85c\uc640 \uc2dc\uac04\uc744 \uae30\uc5b5\ud558\uc5ec \uadf8\ub140\uc758 \uc6c0\uc9c1\uc784\uc744 \uc608\uce21\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uadf8\ub140\ub97c \ub2f9\uc2e0\uc758 \uae38\uc5d0\uc11c \ubc97\uc5b4\ub098\uac8c \ud558\uae30 \uc704\ud574 \ubb3c\uac74\uc744 \ub358\uc9c0\ub294 \uac83\uacfc \uac19\uc740 \uc720\uc778\ucc45\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc9c0\ub984\uae38\uacfc \uc740\ud3d0\ub41c \ud1b5\ub85c\ub97c \uc2dd\ubcc4\ud558\uc5ec \ud0c8\ucd9c \uacbd\ub85c\ub97c \ucd5c\uc801\ud654\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc9c0\ud558\uc2e4 \ub808\ubca8\uc5d0\uc11c \uacc4\ub2e8 \uadfc\ucc98\uc5d0 \uaf43\ubcd1\uc744 \ub358\uc9c0\uba74 \ud560\uba38\ub2c8\uac00 \ub534\uae38\ub85c \uc0c8\ub294 \ub3d9\uc548 \ubab0\ub798 \uc9c0\ub098\uac08 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc811\uadfc \ubc29\uc2dd\uc740 \uccb4\uc2a4\uc640 \uac19\uc2b5\ub2c8\ub2e4. \uadf8\ub140\uc758 \uc6c0\uc9c1\uc784\uc744 \uc608\uce21\ud558\uace0 \ubc18\uaca9\uc744 \uc2e0\uc911\ud558\uac8c \uacc4\ud68d\ud558\uc2ed\uc2dc\uc624."}, {"question": "\uace0\uc591\uc774\uc640 \ud560\uba38\ub2c8\uc758 \uc2a4\ud0dc\ubbf8\ub098 \uc2dc\uc2a4\ud15c\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\uace0\uc591\uc774\uc640 \ud560\uba38\ub2c8\uc758 \uc2a4\ud0dc\ubbf8\ub098 \uc2dc\uc2a4\ud15c\uc740 \uc911\uc694\ud569\ub2c8\ub2e4. \uc2a4\ud504\ub9b0\ud2b8\ud558\uac70\ub098 \ud798\ub4e0 \ud589\ub3d9\uc744 \uc5bc\ub9c8\ub098 \uc624\ub7ab\ub3d9\uc548 \ud560 \uc218 \uc788\ub294\uc9c0\ub97c \uc81c\ud55c\ud558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc2a4\ud0dc\ubbf8\ub098\uac00 \uace0\uac08\ub418\uba74 \uce90\ub9ad\ud130\uac00 \ub290\ub824\uc9c0\uace0 \ud560\uba38\ub2c8\ub97c \ud53c\ud558\uae30\uac00 \uc5b4\ub824\uc6cc\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucd94\uaca9\ub2f9\ud558\ub294 \ub3d9\uc548 \ub108\ubb34 \uc624\ub798 \uc2a4\ud504\ub9b0\ud2b8\ud558\uba74 \uac78\uc5b4\uc57c \ud558\uba70, \uc774\ub294 \ud3ec\ud68d \uc704\ud5d8\uc744 \ub192\uc785\ub2c8\ub2e4. \uc2a4\ud0dc\ubbf8\ub098\ub97c \uad00\ub9ac\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. \ub2e8\uacc4 1: \uaca9\ub82c\ud55c \uc21c\uac04\uc5d0 \uc2a4\ud0dc\ubbf8\ub098 \ubc14\ub97c \ubaa8\ub2c8\ud130\ub9c1\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ubd80\uc5cc\uc5d0\uc11c \ubc1c\uacac\ub418\ub294 \uc5d0\ub108\uc9c0 \uc74c\ub8cc\uc640 \uac19\uc740 \uc2a4\ud0dc\ubbf8\ub098 \ud68c\ubcf5 \uc544\uc774\ud15c\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ud560\uba38\ub2c8\uac00 \uadfc\ucc98\uc5d0 \uc5c6\uc744 \ub54c \uac78\uc5b4\uc11c \uc2a4\ud0dc\ubbf8\ub098\ub97c \uc808\uc57d\ud558\uae30 \uc704\ud574 \uc6c0\uc9c1\uc784\uc744 \uacc4\ud68d\ud569\ub2c8\ub2e4. \uc2a4\ud0dc\ubbf8\ub098\ub294 \uc5f0\ub8cc \ud0f1\ud06c\uc640 \uac19\uc2b5\ub2c8\ub2e4. \ud604\uba85\ud558\uac8c \uc0ac\uc6a9\ud558\uc5ec \uc55e\uc11c\ub098\uac00\uc2ed\uc2dc\uc624."}, {"question": "\uace0\uc591\uc774\uc640 \ud560\uba38\ub2c8\uc5d0\uc11c \uc0dd\uc874\uc5d0 \ud544\uc218\uc801\uc778 \uc544\uc774\ud15c\uc740 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "\uace0\uc591\uc774\uc640 \ud560\uba38\ub2c8\uc5d0\uc11c \uc5ec\ub7ec \uac00\uc9c0 \uc544\uc774\ud15c\uc774 \uc0dd\uc874\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \ub2e8\uacc4 1: \uace1\uad2d\uc774\ub294 \ucc28\uace0\uc5d0 \uc788\ub294 \uac83\uacfc \uac19\uc740 \uc7a0\uae34 \ubb38\uc744 \uc5f4\uae30 \uc704\ud574 \uc0ac\uc6a9\ub429\ub2c8\ub2e4. \ub2e8\uacc4 2: \ub4dc\ub77c\uc774\ubc84\ub294 \uc815\uc6d0\uc758 \ub36b(\uc608: \uacf0\ub36b)\uacfc \uac19\uc740 \ud568\uc815\uc744 \ube44\ud65c\uc131\ud654\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc190\uc804\ub4f1\uc740 \uc9c0\ud558\uc2e4\uacfc \uac19\uc740 \uc5b4\ub450\uc6b4 \uc9c0\uc5ed\uc744 \ube44\ucda5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uace1\uad2d\uc774\uc640 \uc190\uc804\ub4f1\uc744 \uacb0\ud569\ud558\uba74 \uc0c8\ub85c\uc6b4 \uc9c0\uc5ed\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \ud0d0\uc0c9\ud558\uace0 \uc7a0\uae08\uc744 \ud574\uc81c\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc544\uc774\ud15c\uc740 \ub3c4\uad6c \uc0c1\uc790\uc640 \uac19\uc2b5\ub2c8\ub2e4. \uac01\uac01 \ud2b9\uc815 \ubaa9\uc801\uc744 \uac00\uc9c0\uace0 \ud0c8\ucd9c\uc5d0 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\uace0\uc591\uc774\uc640 \ud560\uba38\ub2c8\uc5d0\uc11c \ud560\uba38\ub2c8\uc758 AI \ud589\ub3d9\uc740 \ub09c\uc774\ub3c4 \ub808\ubca8\uc5d0 \ub530\ub77c \uc5b4\ub5bb\uac8c \ub2ec\ub77c\uc9d1\ub2c8\uae4c?", "answer": "\ud560\uba38\ub2c8\uc758 AI \ud589\ub3d9\uc740 \ub09c\uc774\ub3c4 \ub808\ubca8\uc5d0 \ub530\ub77c \uc0c1\ub2f9\ud788 \ub2ec\ub77c\uc9d1\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc26c\uc6b4 \ub09c\uc774\ub3c4\uc5d0\uc11c \uadf8\ub140\uc758 \uc21c\ucc30 \uacbd\ub85c\ub294 \uc608\uce21 \uac00\ub2a5\ud558\uace0 \ubc18\uc751 \uc2dc\uac04\uc774 \ub290\ub9bd\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc77c\ubc18 \ub09c\uc774\ub3c4\uc5d0\uc11c \uadf8\ub140\ub294 \ub354\uc6b1 \uacbd\uacc4\uc2ec\uc744 \uac16\uace0 \ub354 \ucca0\uc800\ud558\uac8c \uc9c0\uc5ed\uc744 \ud0d0\uc0c9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc5b4\ub824\uc6b4 \ub09c\uc774\ub3c4\uc5d0\uc11c \uadf8\ub140\uc758 \uc18d\ub3c4\uc640 \uacf5\uaca9\uc131\uc774 \uc99d\uac00\ud558\uace0 \ud568\uc815\uc744 \ub354 \uc790\uc8fc \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5b4\ub824\uc6b4 \ub09c\uc774\ub3c4\uc5d0\uc11c \ud560\uba38\ub2c8\ub294 \uc8fc\uc694 \ud0c8\ucd9c \uacbd\ub85c\uc5d0 \ucd94\uac00\uc801\uc778 \uacf0\ub36b\uc744 \uc124\uce58\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc9c4\ud589\uc740 \ubd88\uc744 \ub354 \uac15\ud558\uac8c \ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ub09c\uc774\ub3c4\uac00 \ub192\uc544\uc9c8\uc218\ub85d \uadf8\ub140\uc758 \ud589\ub3d9\uc774 \ub354\uc6b1 \uae4c\ub2e4\ub85c\uc6cc\uc9d1\ub2c8\ub2e4."}, {"question": "\uace0\uc591\uc774\uc640 \ud560\uba38\ub2c8\uc758 \ubaa8\ubc14\uc77c \ubc0f PC \ubc84\uc804\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uace0\uc591\uc774\uc640 \ud560\uba38\ub2c8\uc758 \ubaa8\ubc14\uc77c \ubc0f PC \ubc84\uc804\uc740 \uc5ec\ub7ec \uac00\uc9c0 \uba74\uc5d0\uc11c \ub2e4\ub985\ub2c8\ub2e4. \ub2e8\uacc4 1: \ucee8\ud2b8\ub864 - \ubaa8\ubc14\uc77c\uc740 \ud130\uce58\uc2a4\ud06c\ub9b0 \uc785\ub825\uc744 \uc0ac\uc6a9\ud558\uace0 PC\ub294 \ud0a4\ubcf4\ub4dc\uc640 \ub9c8\uc6b0\uc2a4\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uadf8\ub798\ud53d - PC \ubc84\uc804\uc740 \ub354 \ub192\uc740 \ud574\uc0c1\ub3c4\uc640 \ub354 \uc6d0\ud65c\ud55c \uc131\ub2a5\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc811\uadfc\uc131 - \ubaa8\ubc14\uc77c\uc740 \uc5b8\uc81c \uc5b4\ub514\uc11c\ub098 \ud50c\ub808\uc774\ud560 \uc218 \uc788\uc9c0\ub9cc PC\ub294 \ub354 \ubab0\uc785\uc801\uc778 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \uc815\ubc00\ud55c \ub9c8\uc6b0\uc2a4 \uc6c0\uc9c1\uc784\uc73c\ub85c \ub300\uc0c1\uc744 \uc870\uc900\ud558\uace0 \ubb3c\uac74\uc744 \ub358\uc9c8 \uc218 \uc788\uc73c\uba70, \uc774\ub294 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ubc84\uc804\uc740 \ub3d9\uc804\uc758 \uc591\uba74\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uac01 \ubc84\uc804\uc5d0\ub294 \uace0\uc720\ud55c \uac15\uc810\uc774 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uace0\uc591\uc774\uc640 \ud560\uba38\ub2c8\uc5d0\uc11c \uc778\ubca4\ud1a0\ub9ac \uad00\ub9ac\ub97c \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uace0\uc591\uc774\uc640 \ud560\uba38\ub2c8\uc5d0\uc11c \uc778\ubca4\ud1a0\ub9ac \uad00\ub9ac\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. \ub2e8\uacc4 1: \uace1\uad2d\uc774\uc640 \uc190\uc804\ub4f1\uacfc \uac19\uc740 \ud544\uc218\ud488\uc744 \uc6b0\uc120\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ubd88\ud544\uc694\ud558\uac70\ub098 \uc0c1\ud669\uc5d0 \ub530\ub77c \uc0ac\uc6a9\ud558\uc9c0 \uc54a\ub294 \uc544\uc774\ud15c\uc744 \ubc84\ub824\uc11c \uacf5\uac04\uc744 \ud655\ubcf4\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ub098\uc911\uc5d0 \uc0ac\uc6a9\ud558\uae30 \uc704\ud574 \uc548\uc804\ud55c \uc7a5\uc18c\uc5d0 \uc544\uc774\ud15c\uc744 \ubcf4\uad00\ud558\uc5ec \ubbf8\ub9ac \uacc4\ud68d\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc9c0\ud558\uc2e4\uc5d0 \ub4dc\ub77c\uc774\ubc84\ub97c \ubcf4\uad00\ud558\uba74 \ud568\uc815\uc744 \ube44\ud65c\uc131\ud654\ud560 \ub54c \uc2dc\uac04\uc744 \uc808\uc57d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc804\ub7b5\uc740 \uc5ec\ud589 \uac00\ubc29\uc5d0 \uc9d0\uc744 \uc2f8\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc815\ub9d0 \ud544\uc694\ud55c \uac83\ub9cc \uac00\uc838\uc624\uc138\uc694."}, {"question": "\uace0\uc591\uc774\uc640 \ud560\uba38\ub2c8\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc740\ud3d0\ub41c \uc9c0\uc5ed\uc774\ub098 \ube44\ubc00\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uace0\uc591\uc774\uc640 \ud560\uba38\ub2c8\uc5d0\ub294 \uc5ec\ub7ec \uac1c\uc758 \uc740\ud3d0\ub41c \uc9c0\uc5ed\uacfc \ube44\ubc00\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \ub290\uc2a8\ud55c \ubc14\ub2e5\uc7ac\ub098 \uac08\ub77c\uc9c4 \ubcbd\uacfc \uac19\uc740 \ubbf8\ubb18\ud55c \uc2dc\uac01\uc801 \ub2e8\uc11c\ub97c \ucc3e\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc228\uaca8\uc9c4 \ud1b5\ub85c\ub97c \uc5f4\uae30 \uc704\ud574 \ud2b9\uc815 \uc544\uc774\ud15c(\uc608: \uc228\uaca8\uc9c4 \ubb38\uc744 \uc5ec\ub294 \uace1\uad2d\uc774)\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uac00\uad6c \ub4a4\ub098 \uacc4\ub2e8 \uc544\ub798\uc640 \uac19\uc774 \ub35c \ub208\uc5d0 \ub744\ub294 \uc9c0\uc5ed\uc744 \ucca0\uc800\ud788 \ud0d0\uc0c9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub2e4\ub77d\ubc29\uc5d0\ub294 \ud76c\uadc0\ud55c \uc218\uc9d1\ud488\uc774 \ub4e4\uc5b4 \uc788\ub294 \uc228\uaca8\uc9c4 \uce78\ub9c9\uc774\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ube44\ubc00\uc740 \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc2dc\uac04\uc744 \ud22c\uc790\ud558\ub294 \uc0ac\ub78c\uc5d0\uac8c \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}, {"question": "\uace0\uc591\uc774\uc640 \ud560\uba38\ub2c8\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \uc5b4\ub5a4 \uc694\uc778\uc774 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\uace0\uc591\uc774\uc640 \ud560\uba38\ub2c8\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ub2e4\uc74c\uacfc \uac19\uc740 \uc694\uc778\uc5d0 \uc758\ud574 \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc18d\ub3c4 - \ub354 \ube60\ub978 \ud0c8\ucd9c\uc740 \ub354 \ub192\uc740 \uc810\uc218\ub97c \uac00\uc838\uc635\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc740\ubc00\ud568 - \ubc1c\uac01\uc744 \ud53c\ud558\uace0 \uc18c\uc74c\uc744 \ucd5c\uc18c\ud654\ud558\uba74 \uc810\uc218\uac00 \ub192\uc544\uc9d1\ub2c8\ub2e4. \ub2e8\uacc4 3: \ud0d0\ud5d8 - \uc228\uaca8\uc9c4 \ubb3c\uac74\uacfc \uc9c0\uc5ed\uc744 \ucc3e\uc73c\uba74 \ubcf4\ub108\uc2a4 \uc810\uc218\uac00 \ucd94\uac00\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 10\ubd84 \uc774\ub0b4\uc5d0 \ubaa8\ub4e0 \uc228\uaca8\uc9c4 \ubb3c\uac74\uc744 \uc218\uc9d1\ud558\uba74\uc11c \ud0c8\ucd9c\ud558\uba74 \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \uc131\uc801\ud45c\uc640 \uac19\uc2b5\ub2c8\ub2e4. \uc5ec\ub7ec \uae30\uc900\uc5d0 \ub530\ub77c \uc131\uacfc\ub97c \ud3c9\uac00\ud569\ub2c8\ub2e4."}, {"question": "\uace0\uc591\uc774\uc640 \ud560\uba38\ub2c8\uc5d0\uc11c \ubaa8\ubc14\uc77c\uc5d0\uc11c PC\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\ud658\ud558\ub294 \ucd5c\uc0c1\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uace0\uc591\uc774\uc640 \ud560\uba38\ub2c8\uc5d0\uc11c \ubaa8\ubc14\uc77c\uc5d0\uc11c PC\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\ud658\ud558\ub824\uba74 \ub2e4\uc74c\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \ub450 \ubc84\uc804 \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815 \ub610\ub294 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uc11c\ube44\uc2a4\uc5d0 \uc5f0\uacb0\ub418\uc5b4 \uc788\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ubaa8\ub4e0 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc804\ud658\ud558\uae30 \uc804\uc5d0 \ub3d9\uae30\ud654\ub418\uc5c8\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc0c8 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc800\uc7a5 \ud30c\uc77c\uc744 \ub85c\ub4dc\ud558\uc5ec \uc804\ud658\uc744 \ud14c\uc2a4\ud2b8\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubaa8\ubc14\uc77c\uc5d0 \uc9c0\ud558\uc2e4\uc744 \uc7a0\uae08 \ud574\uc81c\ud588\ub2e4\uba74 PC\uc5d0\uc11c\ub3c4 \uc811\uadfc \uac00\ub2a5\ud55c\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. \uc774 \uacfc\uc815\uc740 \uc774\uc0ac\uc640 \uac19\uc2b5\ub2c8\ub2e4. \uc774\uc0ac\ud558\uae30 \uc804\uc5d0 \ubaa8\ub4e0 \uac83\uc774 \ud3ec\uc7a5\ub418\uc5b4 \uc788\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4."}]
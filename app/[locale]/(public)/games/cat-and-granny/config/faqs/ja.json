[{"question": "\u732b\u3068\u30b0\u30e9\u30f3\u30cb\u30fc\u3067\u3001\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u7d20\u65e9\u304f\u5b66\u3076\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u3053\u308c\u3089\u306e\u624b\u9806\u306b\u5f93\u3046\u3053\u3068\u3067\u3001\u732b\u3068\u30b0\u30e9\u30f3\u30cb\u30fc\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u753b\u9762\u306e\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u3092\u4f7f\u7528\u3057\u3066\u79fb\u52d5\u64cd\u4f5c\u306b\u6163\u308c\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b0\u30e9\u30f3\u30cb\u30fc\u306e\u7f60\u3092\u907f\u3051\u306a\u304c\u3089\u969c\u5bb3\u7269\u3092\u79fb\u52d5\u3059\u308b\u305f\u3081\u306b\u3001\u30b8\u30e3\u30f3\u30d7\u3068\u3057\u3083\u304c\u307f\u8fbc\u307f\u306e\u7df4\u7fd2\u3092\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30a2\u30af\u30b7\u30e7\u30f3\u30dc\u30bf\u30f3\u3092\u30bf\u30c3\u30d7\u3059\u308b\u3053\u3068\u3067\u3001\u30c9\u30a2\u3092\u958b\u3051\u305f\u308a\u3001\u30a2\u30a4\u30c6\u30e0\u3092\u62fe\u3063\u305f\u308a\u306a\u3069\u3001\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3068\u3084\u308a\u53d6\u308a\u3059\u308b\u65b9\u6cd5\u3092\u5b66\u3076\u3002\u305f\u3068\u3048\u3070\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u58ca\u308c\u305f\u968e\u6bb5\u3092\u30b8\u30e3\u30f3\u30d7\u3057\u3066\u3001\u4f4e\u3044\u6881\u306e\u4e0b\u306b\u3057\u3083\u304c\u3080\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u64cd\u4f5c\u306f\u3001\u30b2\u30fc\u30e0\u306eABC\u306e\u3088\u3046\u3067\u3001\u751f\u5b58\u3068\u9032\u6b69\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002"}, {"question": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u732b\u3068\u30b0\u30e9\u30f3\u30cb\u30fc\u3067\u30b0\u30e9\u30f3\u30cb\u30fc\u3092\u304b\u308f\u3059\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "100\u6642\u9593\u5f8c\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30b0\u30e9\u30f3\u30cb\u30fc\u3092\u304b\u308f\u3059\u305f\u3081\u306e\u9ad8\u5ea6\u306a\u6226\u7565\u3092\u63a1\u7528\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b0\u30e9\u30f3\u30cb\u30fc\u306e\u5de1\u56de\u30eb\u30fc\u30c8\u3068\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u8a18\u61b6\u3057\u3066\u3001\u5f7c\u5973\u306e\u52d5\u304d\u3092\u4e88\u6e2c\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5f7c\u5973\u306e\u6ce8\u610f\u3092\u5f15\u304d\u3064\u3051\u3001\u3042\u306a\u305f\u306e\u9032\u8def\u304b\u3089\u305d\u3089\u3059\u305f\u3081\u306b\u3001\u7269\u4f53\u3092\u6295\u3052\u308b\u306a\u3069\u3001\u6c17\u3092\u7d1b\u3089\u308f\u305b\u308b\u7269\u3092\u4f7f\u3046\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u3084\u96a0\u3057\u901a\u8def\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u3067\u3001\u8131\u51fa\u30eb\u30fc\u30c8\u3092\u6700\u9069\u5316\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u5730\u4e0b\u5ba4\u30ec\u30d9\u30eb\u3067\u306f\u968e\u6bb5\u306e\u8fd1\u304f\u306b\u82b1\u74f6\u3092\u6295\u3052\u308b\u3068\u3001\u30b0\u30e9\u30f3\u30cb\u30fc\u306e\u6ce8\u610f\u3092\u305d\u3089\u3059\u3053\u3068\u304c\u3067\u304d\u3001\u305d\u3063\u3068\u901a\u308a\u904e\u304e\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u3084\u308a\u65b9\u306f\u3001\u30c1\u30a7\u30b9\u306e\u3088\u3046\u3067\u3042\u308a\u3001\u5f7c\u5973\u306e\u52d5\u304d\u3092\u4e88\u6e2c\u3057\u3001\u53cd\u6483\u8a08\u753b\u3092\u7dbf\u5bc6\u306b\u7acb\u3066\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u732b\u3068\u30b0\u30e9\u30f3\u30cb\u30fc\u306e\u30b9\u30bf\u30df\u30ca\u30b7\u30b9\u30c6\u30e0\u306f\u306a\u305c\u91cd\u8981\u3067\u3042\u308a\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u732b\u3068\u30b0\u30e9\u30f3\u30cb\u30fc\u306e\u30b9\u30bf\u30df\u30ca\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u5168\u529b\u75be\u8d70\u3084\u6fc0\u3057\u3044\u884c\u52d5\u3092\u3069\u308c\u304f\u3089\u3044\u7d9a\u3051\u3089\u308c\u308b\u304b\u3092\u5236\u9650\u3059\u308b\u305f\u3081\u3001\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u30b9\u30bf\u30df\u30ca\u304c\u5c3d\u304d\u308b\u3068\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u306e\u52d5\u304d\u304c\u9045\u304f\u306a\u308a\u3001\u30b0\u30e9\u30f3\u30cb\u30fc\u304b\u3089\u9003\u3052\u308b\u306e\u304c\u96e3\u3057\u304f\u306a\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u8ffd\u3044\u304b\u3051\u3089\u308c\u308b\u9593\u306b\u9577\u6642\u9593\u5168\u529b\u75be\u8d70\u3059\u308b\u3068\u3001\u6b69\u304f\u3053\u3068\u3092\u4f59\u5100\u306a\u304f\u3055\u308c\u3001\u6355\u307e\u308b\u30ea\u30b9\u30af\u304c\u9ad8\u307e\u308a\u307e\u3059\u3002\u30b9\u30bf\u30df\u30ca\u3092\u7ba1\u7406\u3059\u308b\u306b\u306f\u3001\u30b9\u30c6\u30c3\u30d71\uff1a\u6fc0\u3057\u3044\u5834\u9762\u3067\u306f\u30b9\u30bf\u30df\u30ca\u30b2\u30fc\u30b8\u3092\u76e3\u8996\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u53f0\u6240\u3067\u624b\u306b\u5165\u308b\u30a8\u30ca\u30b8\u30fc\u98f2\u6599\u306a\u3069\u306e\u30b9\u30bf\u30df\u30ca\u56de\u5fa9\u30a2\u30a4\u30c6\u30e0\u3092\u4f7f\u7528\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b0\u30e9\u30f3\u30cb\u30fc\u304c\u8fd1\u304f\u306b\u3044\u306a\u3051\u308c\u3070\u6b69\u304f\u306a\u3069\u3001\u30b9\u30bf\u30df\u30ca\u3092\u7bc0\u7d04\u3059\u308b\u52d5\u304d\u3092\u8a08\u753b\u3059\u308b\u3002\u30b9\u30bf\u30df\u30ca\u3092\u71c3\u6599\u30bf\u30f3\u30af\u3068\u8003\u3048\u3001\u8ce2\u304f\u4f7f\u7528\u3057\u3066\u524d\u306b\u9032\u3093\u3067\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u732b\u3068\u30b0\u30e9\u30f3\u30cb\u30fc\u3067\u751f\u5b58\u306b\u4e0d\u53ef\u6b20\u306a\u30a2\u30a4\u30c6\u30e0\u306f\u4f55\u3067\u3042\u308a\u3001\u305d\u308c\u3089\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u732b\u3068\u30b0\u30e9\u30f3\u30cb\u30fc\u3067\u751f\u5b58\u306b\u4e0d\u53ef\u6b20\u306a\u30a2\u30a4\u30c6\u30e0\u306f\u3044\u304f\u3064\u304b\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30ac\u30e9\u30fc\u30b8\u306e\u9375\u304c\u304b\u304b\u3063\u305f\u30c9\u30a2\u3092\u958b\u3051\u308b\u305f\u3081\u306b\u3001\u304f\u3055\u3073\u68d2\u3092\u4f7f\u3046\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5ead\u306e\u718a\u306e\u7f60\u306a\u3069\u3001\u7f60\u3092\u7121\u52b9\u5316\u3059\u308b\u305f\u3081\u306b\u30c9\u30e9\u30a4\u30d0\u30fc\u3092\u4f7f\u7528\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5730\u4e0b\u5ba4\u306e\u3088\u3046\u306a\u6697\u3044\u5834\u6240\u3092\u7167\u3089\u3059\u305f\u3081\u306b\u61d0\u4e2d\u96fb\u706f\u3092\u4f7f\u7528\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u304f\u3055\u3073\u68d2\u3068\u61d0\u4e2d\u96fb\u706f\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3001\u65b0\u3057\u3044\u30a8\u30ea\u30a2\u3092\u52b9\u7387\u7684\u306b\u79fb\u52d5\u3057\u3001\u89e3\u9320\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30a2\u30a4\u30c6\u30e0\u306f\u3001\u3042\u306a\u305f\u306e\u30c4\u30fc\u30eb\u30ad\u30c3\u30c8\u3067\u3001\u305d\u308c\u305e\u308c\u3042\u306a\u305f\u306e\u9003\u8d70\u3092\u52a9\u3051\u308b\u305f\u3081\u306b\u7279\u5b9a\u306e\u5f79\u5272\u3092\u679c\u305f\u3057\u307e\u3059\u3002"}, {"question": "\u732b\u3068\u30b0\u30e9\u30f3\u30cb\u30fc\u3067\u30b0\u30e9\u30f3\u30cb\u30fc\u306eAI\u884c\u52d5\u306f\u3001\u96e3\u6613\u5ea6\u30ec\u30d9\u30eb\u306b\u3088\u3063\u3066\u3069\u306e\u3088\u3046\u306b\u5909\u5316\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30b0\u30e9\u30f3\u30cb\u30fc\u306eAI\u884c\u52d5\u306f\u3001\u96e3\u6613\u5ea6\u30ec\u30d9\u30eb\u306b\u3088\u3063\u3066\u5927\u304d\u304f\u5909\u5316\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6613\u3057\u3044\u30e2\u30fc\u30c9\u3067\u306f\u3001\u5f7c\u5973\u306e\u5de1\u56de\u30eb\u30fc\u30c8\u306f\u4e88\u60f3\u53ef\u80fd\u3067\u3042\u308a\u3001\u53cd\u5fdc\u6642\u9593\u306f\u9045\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u666e\u901a\u30e2\u30fc\u30c9\u3067\u306f\u3001\u5f7c\u5973\u306f\u3088\u308a\u8b66\u6212\u3057\u3001\u30a8\u30ea\u30a2\u3092\u3088\u308a\u5fb9\u5e95\u7684\u306b\u63a2\u7d22\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u96e3\u3057\u3044\u30e2\u30fc\u30c9\u3067\u306f\u3001\u5f7c\u5973\u306e\u901f\u5ea6\u3068\u653b\u6483\u6027\u304c\u4e0a\u304c\u308a\u3001\u7f60\u3092\u3088\u308a\u983b\u7e41\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u96e3\u3057\u3044\u30e2\u30fc\u30c9\u3067\u306f\u3001\u30b0\u30e9\u30f3\u30cb\u30fc\u306f\u4e3b\u8981\u306a\u8131\u51fa\u30eb\u30fc\u30c8\u306b\u3055\u3089\u306b\u718a\u306e\u7f60\u3092\u8a2d\u7f6e\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u71b1\u3092\u4e0a\u3052\u308b\u3088\u3046\u306a\u3082\u306e\u3067\u3042\u308a\u3001\u96e3\u6613\u5ea6\u304c\u9ad8\u304f\u306a\u308b\u3068\u3001\u5f7c\u5973\u306e\u884c\u52d5\u3082\u3088\u308a\u56f0\u96e3\u306b\u306a\u308a\u307e\u3059\u3002"}, {"question": "\u732b\u3068\u30b0\u30e9\u30f3\u30cb\u30fc\u306e\u30e2\u30d0\u30a4\u30eb\u7248\u3068PC\u7248\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u732b\u3068\u30b0\u30e9\u30f3\u30cb\u30fc\u306e\u30e2\u30d0\u30a4\u30eb\u7248\u3068PC\u7248\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u70b9\u3067\u7570\u306a\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u64cd\u4f5c - \u30e2\u30d0\u30a4\u30eb\u7248\u306f\u30bf\u30c3\u30c1\u30b9\u30af\u30ea\u30fc\u30f3\u5165\u529b\u3092\u4f7f\u7528\u3057\u3001PC\u7248\u306f\u30ad\u30fc\u30dc\u30fc\u30c9\u3068\u30de\u30a6\u30b9\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b0\u30e9\u30d5\u30a3\u30c3\u30af - PC\u7248\u306f\u3088\u308a\u9ad8\u89e3\u50cf\u5ea6\u3067\u30b9\u30e0\u30fc\u30ba\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30a2\u30af\u30bb\u30b7\u30d3\u30ea\u30c6\u30a3 - \u30e2\u30d0\u30a4\u30eb\u7248\u306f\u6301\u3061\u904b\u3073\u306a\u304c\u3089\u30d7\u30ec\u30a4\u3059\u308b\u3053\u3068\u3092\u53ef\u80fd\u306b\u3057\u3001PC\u7248\u306f\u3088\u308a\u6ca1\u5165\u611f\u306e\u3042\u308b\u4f53\u9a13\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001PC\u7248\u3067\u306f\u3001\u30de\u30a6\u30b9\u3092\u6b63\u78ba\u306b\u52d5\u304b\u3059\u3053\u3068\u3067\u3001\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u72d9\u3063\u3066\u6295\u3052\u308b\u3053\u3068\u304c\u3067\u304d\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5f37\u5316\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u306f\u3001\u540c\u3058\u30b3\u30a4\u30f3\u306e\u8868\u88cf\u3068\u8003\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305d\u308c\u305e\u308c\u306b\u72ec\u81ea\u306e\u5f37\u307f\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u732b\u3068\u30b0\u30e9\u30f3\u30cb\u30fc\u3067\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u7ba1\u7406\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u732b\u3068\u30b0\u30e9\u30f3\u30cb\u30fc\u3067\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u7ba1\u7406\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u6b21\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u304f\u3055\u3073\u68d2\u3084\u61d0\u4e2d\u96fb\u706f\u306a\u3069\u306e\u5fc5\u9808\u30a2\u30a4\u30c6\u30e0\u3092\u512a\u5148\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u91cd\u8907\u307e\u305f\u306f\u72b6\u6cc1\u7684\u3067\u306a\u3044\u30a2\u30a4\u30c6\u30e0\u3092\u6368\u3066\u3066\u3001\u30b9\u30da\u30fc\u30b9\u3092\u78ba\u4fdd\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5f8c\u3067\u4f7f\u7528\u3059\u308b\u30a2\u30a4\u30c6\u30e0\u3092\u5b89\u5168\u306a\u5834\u6240\u306b\u4fdd\u7ba1\u3059\u308b\u306a\u3069\u3001\u4e8b\u524d\u306b\u8a08\u753b\u3092\u7acb\u3066\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5730\u4e0b\u5ba4\u306b\u30c9\u30e9\u30a4\u30d0\u30fc\u3092\u7f6e\u3044\u3066\u304a\u304f\u3068\u3001\u7f60\u89e3\u9664\u306e\u6642\u9593\u3092\u7bc0\u7d04\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u6226\u7565\u306f\u3001\u65c5\u884c\u306b\u5fc5\u8981\u306a\u3082\u306e\u3060\u3051\u3092\u5165\u308c\u308b\u3088\u3046\u306b\u3001\u30b9\u30fc\u30c4\u30b1\u30fc\u30b9\u3092\u8a70\u3081\u308b\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002"}, {"question": "\u732b\u3068\u30b0\u30e9\u30f3\u30cb\u30fc\u3067\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u767a\u898b\u3067\u304d\u308b\u96a0\u308c\u305f\u30a8\u30ea\u30a2\u3084\u79d8\u5bc6\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u732b\u3068\u30b0\u30e9\u30f3\u30cb\u30fc\u306b\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u96a0\u308c\u305f\u30a8\u30ea\u30a2\u3084\u79d8\u5bc6\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u7de9\u3044\u5e8a\u677f\u3084\u5272\u308c\u305f\u58c1\u306a\u3069\u3001\u5fae\u5999\u306a\u8996\u899a\u7684\u306a\u624b\u304c\u304b\u308a\u3092\u63a2\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u304f\u3055\u3073\u68d2\u3092\u4f7f\u7528\u3057\u3066\u96a0\u308c\u305f\u901a\u8def\u3092\u958b\u3051\u308b\u306a\u3069\u3001\u7279\u5b9a\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u4f7f\u7528\u3057\u3066\u96a0\u3057\u901a\u8def\u3092\u958b\u3051\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5bb6\u5177\u306e\u5f8c\u308d\u3084\u968e\u6bb5\u306e\u4e0b\u306a\u3069\u3001\u3042\u307e\u308a\u76ee\u7acb\u305f\u306a\u3044\u30a8\u30ea\u30a2\u3092\u5fb9\u5e95\u7684\u306b\u63a2\u7d22\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5c4b\u6839\u88cf\u90e8\u5c4b\u306b\u306f\u3001\u96a0\u308c\u305f\u30b3\u30f3\u30d1\u30fc\u30c8\u30e1\u30f3\u30c8\u304c\u3042\u308a\u3001\u305d\u3053\u306b\u8cb4\u91cd\u306a\u53ce\u96c6\u54c1\u304c\u5165\u3063\u3066\u3044\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u79d8\u5bc6\u306f\u3001\u63a2\u3059\u6642\u9593\u3092\u5272\u304f\u4eba\u306e\u305f\u3081\u306b\u3001\u57cb\u3082\u308c\u305f\u5b9d\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002"}, {"question": "\u732b\u3068\u30b0\u30e9\u30f3\u30cb\u30fc\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u3069\u306e\u3088\u3046\u306a\u8981\u7d20\u304c\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u732b\u3068\u30b0\u30e9\u30f3\u30cb\u30fc\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6b21\u306e\u8981\u7d20\u306b\u3088\u3063\u3066\u5f71\u97ff\u3092\u53d7\u3051\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u901f\u5ea6 - \u3088\u308a\u901f\u3044\u8131\u51fa\u306f\u3001\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b9\u30c6\u30eb\u30b9 - \u691c\u51fa\u3092\u907f\u3051\u3001\u9a12\u97f3\u3092\u6700\u5c0f\u9650\u306b\u3059\u308b\u3053\u3068\u3067\u3001\u30b9\u30b3\u30a2\u3092\u9ad8\u3081\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u63a2\u7d22 - \u96a0\u3055\u308c\u305f\u30a2\u30a4\u30c6\u30e0\u3084\u30a8\u30ea\u30a2\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u3067\u3001\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u300110\u5206\u4ee5\u5185\u306b\u8131\u51fa\u3057\u3001\u3059\u3079\u3066\u306e\u96a0\u3055\u308c\u305f\u30a2\u30a4\u30c6\u30e0\u3092\u96c6\u3081\u308b\u3053\u3068\u3067\u3001\u6700\u5927\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6210\u7e3e\u8868\u306e\u3088\u3046\u306b\u3001\u8907\u6570\u306e\u57fa\u6e96\u306b\u57fa\u3065\u3044\u3066\u3042\u306a\u305f\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u8a55\u4fa1\u3057\u307e\u3059\u3002"}, {"question": "\u732b\u3068\u30b0\u30e9\u30f3\u30cb\u30fc\u3067\u3001\u30e2\u30d0\u30a4\u30eb\u7248\u304b\u3089PC\u7248\u3078\u306e\u9032\u6357\u72b6\u6cc1\u3092\u79fb\u884c\u3059\u308b\u305f\u3081\u306e\u30d9\u30b9\u30c8\u30d7\u30e9\u30af\u30c6\u30a3\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u732b\u3068\u30b0\u30e9\u30f3\u30cb\u30fc\u3067\u3001\u30e2\u30d0\u30a4\u30eb\u7248\u304b\u3089PC\u7248\u3078\u306e\u9032\u6357\u72b6\u6cc1\u3092\u79fb\u884c\u3059\u308b\u306b\u306f\u3001\u6b21\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u4e21\u65b9\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u304c\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u307e\u305f\u306f\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u30b5\u30fc\u30d3\u30b9\u306b\u30ea\u30f3\u30af\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30c7\u30d0\u30a4\u30b9\u3092\u5207\u308a\u66ff\u3048\u308b\u524d\u306b\u3001\u3059\u3079\u3066\u306e\u9032\u6357\u72b6\u6cc1\u304c\u540c\u671f\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u65b0\u3057\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u4fdd\u5b58\u30d5\u30a1\u30a4\u30eb\u3092\u8aad\u307f\u8fbc\u3080\u3053\u3068\u306b\u3088\u3063\u3066\u3001\u79fb\u884c\u3092\u30c6\u30b9\u30c8\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30e2\u30d0\u30a4\u30eb\u7248\u3067\u5730\u4e0b\u5ba4\u3092\u958b\u653e\u3057\u3066\u3044\u308b\u5834\u5408\u306f\u3001\u305d\u308c\u304cPC\u7248\u3067\u3082\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u306e\u30d7\u30ed\u30bb\u30b9\u306f\u5f15\u3063\u8d8a\u3057\u306e\u3088\u3046\u306b\u3001\u5f15\u3063\u8d8a\u3057\u524d\u306b\u3059\u3079\u3066\u306e\u3082\u306e\u304c\u8a70\u307e\u3063\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002"}]
[{"question": "\uacf5\ub8e1 \uac8c\uc784\uc5d0\uc11c \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uae30\ubcf8 \uc810\ud504\uc640 \ub355\uc544\uc6c3\uc744 \uc5b4\ub5bb\uac8c \uc218\ud589\ud569\ub2c8\uae4c?", "answer": "\uacf5\ub8e1 \uac8c\uc784\uc5d0\uc11c \uae30\ubcf8 \uc810\ud504\uc640 \ub355\uc544\uc6c3\uc740 \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc810\ud504\ud558\ub824\uba74 '\uc2a4\ud398\uc774\uc2a4\ubc14' \ub610\ub294 '\uc704\ucabd \ud654\uc0b4\ud45c \ud0a4'\ub97c \ub204\ub974\uc2ed\uc2dc\uc624. \uc774\ub807\uac8c \ud558\uba74 \uacf5\ub8e1\uc774 \uce61\uacfc \uac19\uc740 \uc2dd\ubb3c \uc704\ub85c \ub6f0\uc5b4\ub118\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub355\uc544\uc6c3\ud558\ub824\uba74 '\uc544\ub798\ucabd \ud654\uc0b4\ud45c \ud0a4'\ub97c \ub204\ub974\uba74 \uacf5\ub8e1\uc774 \ub0ae\uac8c \ub0a0\uc544\ub2e4\ub2c8\ub294 \uc0c8\ub97c \ud53c\ud558\uae30 \uc704\ud574 \uc6c5\ud06c\ub9bd\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uce61\uc774 \ub2e4\uac00\uc624\ub294 \uac83\uc744 \ubcf4\uba74 '\uc2a4\ud398\uc774\uc2a4\ubc14'\ub97c \ub20c\ub7ec \uadf8 \uc704\ub85c \ub6f0\uc5b4\ub118\uc73c\uc2ed\uc2dc\uc624. \uc0c8\uac00 \ub0ae\uac8c \ub0a0\uc544\uc624\ub294 \uac83\uc744 \ubcf4\uba74 '\uc544\ub798\ucabd \ud654\uc0b4\ud45c \ud0a4'\ub97c \ube68\ub9ac \ub20c\ub7ec \uc0c8 \uc544\ub798\ub85c \uc6c5\ud06c\ub9bd\ub2c8\ub2e4. \ubc18\uc751 \uc18d\ub3c4\uc640 \uc810\uc218\ub97c \ub192\uc774\ub824\uba74 \uc774\ub7ec\ud55c \ub3d9\uc791\uc744 \uc5f0\uc2b5\ud558\uc2ed\uc2dc\uc624."}, {"question": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub85c\uc11c \uacf5\ub8e1 \uac8c\uc784\uc5d0\uc11c \ub354 \uc624\ub798 \uc0b4\uc544\ub0a8\uae30 \uc704\ud55c \ucd5c\uc0c1\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uacf5\ub8e1 \uac8c\uc784\uc5d0\uc11c \ub354 \uc624\ub798 \uc0b4\uc544\ub0a8\uc73c\ub824\uba74 \uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \ub9ac\ub4ec, \uc608\uce21 \ubc0f \uc81c\uc5b4\ub77c\ub294 \uc138 \uac00\uc9c0 \uc8fc\uc694 \uc804\ub7b5\uc5d0 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. \uccab\uc9f8, \uc810\ud504\uc640 \ub355\uc544\uc6c3\uc744 \uc77c\uad00\ub418\uac8c \ud0c0\uc774\ubc0d\ud558\uc5ec \ub9ac\ub4ec\uc744 \uac1c\ubc1c\ud558\uc2ed\uc2dc\uc624. \ub458\uc9f8, \uc55e\uc744 \ubcf4\uace0 \uc774\ub3d9\uc744 \uacc4\ud68d\ud558\uc5ec \uc7a5\uc560\ubb3c\uc744 \uc608\uce21\ud558\uc2ed\uc2dc\uc624. \uc14b\uc9f8, \ubd88\ud544\uc694\ud55c \uc810\ud504\ub098 \ub355\uc544\uc6c3\uc744 \ud53c\ud558\uc5ec \uc81c\uc5b4\ub97c \uc720\uc9c0\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uce61\uacfc \uc0c8\uac00 \ub2e4\uac00\uc624\ub294 \uac83\uc744 \ubcf4\uba74 \uce61\uc744 \ub118\uc5b4 \ub6f0\uc5b4\ub118\uc744 \uc218 \uc788\ub3c4\ub85d \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \ub9de\ucd94\uace0 \uc989\uc2dc \uc0c8\ub97c \ud53c\ud558\uae30 \uc704\ud574 \ub355\uc544\uc6c3\ud558\uc2ed\uc2dc\uc624. \uc774\ub7ec\ud55c \ub2e8\uacc4\ub97c \uc5f0\uc2b5\ud558\uc5ec \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\uace0 \ub354 \ub192\uc740 \uc810\uc218\ub97c \ub2ec\uc131\ud558\uc2ed\uc2dc\uc624."}, {"question": "\uacf5\ub8e1 \uac8c\uc784\uc5d0\uc11c \uc7a5\uc560\ubb3c\uc758 \uc18d\ub3c4\uac00 \uc99d\uac00\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\uacf5\ub8e1 \uac8c\uc784\uc5d0\uc11c \uc7a5\uc560\ubb3c\uc758 \uc18d\ub3c4\uac00 \uc99d\uac00\ud558\ub294 \uac83\uc740 \ub354\uc6b1 \uc5b4\ub824\uc6b0\uba74\uc11c\ub3c4 \uc7ac\ubbf8\uc788\ub294 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud558\uae30 \uc704\ud55c \uac83\uc785\ub2c8\ub2e4. \uc810\uc218\uac00 \ub192\uc544\uc9d0\uc5d0 \ub530\ub77c \uac8c\uc784 \uc18d\ub3c4\uac00 \uc810\ucc28 \ube68\ub77c\uc838 \uc7a5\uc560\ubb3c\uc5d0 \ubc18\uc751\ud558\uae30\uac00 \ub354\uc6b1 \uc5b4\ub824\uc6cc\uc9d1\ub2c8\ub2e4. \uc774\ub294 \ub354 \ube60\ub978 \ubc18\uc0ac \uc2e0\uacbd\uacfc \ub354 \ub098\uc740 \ud0c0\uc774\ubc0d\uc744 \uc694\uad6c\ud558\uc5ec \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac8c\uc784 \ucd08\ubc18\uc5d0\ub294 \uce61\uc744 \ub6f0\uc5b4\ub118\uc744 \ucda9\ubd84\ud55c \uc2dc\uac04\uc774 \uc788\uc9c0\ub9cc, \uc18d\ub3c4\uac00 \ube68\ub77c\uc9c0\uba74 \ube68\ub9ac \ubc18\uc751\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\uba74 \uc99d\uac00\ud558\ub294 \ub09c\uc774\ub3c4\uc5d0 \ub300\ube44\ud558\uace0 \uc804\ubc18\uc801\uc778 \uc131\ub2a5\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub2e4\ub978 \uae30\uae30\ub85c \uacf5\ub8e1 \uac8c\uc784\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uacf5\ub8e1 \uac8c\uc784\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\ub978 \uae30\uae30\ub85c \uc804\uc1a1\ud558\ub294 \uac83\uc740 \uac8c\uc784\uc774 \uc77c\ubc18\uc801\uc73c\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc800\uc7a5\ud558\uc9c0 \uc54a\uae30 \ub54c\ubb38\uc5d0 \uc5b4\ub824\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \ube0c\ub77c\uc6b0\uc800\uc5d0\uc11c \ud50c\ub808\uc774\ud558\ub294 \uacbd\uc6b0 \ube0c\ub77c\uc6b0\uc800 \ub3d9\uae30\ud654\ub97c \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub450 \uae30\uae30 \ubaa8\ub450 \ub3d9\uc77c\ud55c \ube0c\ub77c\uc6b0\uc800 \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uba74 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc790\ub3d9\uc73c\ub85c \ub3d9\uae30\ud654\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud06c\ub86c\uc744 \uc0ac\uc6a9\ud558\ub294 \uacbd\uc6b0 \ub450 \uae30\uae30 \ubaa8\ub450 Google \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uc5ec \uac8c\uc784 \ub370\uc774\ud130\ub97c \ub3d9\uae30\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \ubc29\ubc95\uc774 \ubcf4\uc7a5\ub418\ub294 \uac83\uc740 \uc544\ub2c8\uba70, \uacf5\ub8e1 \uac8c\uc784\uc740 \uc8fc\ub85c \ub85c\uceec \uc800\uc7a5\uc18c\uc5d0 \uc758\uc874\ud558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4."}, {"question": "\uacf5\ub8e1 \uac8c\uc784\uc5d0 \uc5b4\ub5a4 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uacf5\ub8e1 \uac8c\uc784\uc5d0\ub294 \ub9e4\ub825\uc744 \ub354\ud558\ub294 \uc5ec\ub7ec \uac00\uc9c0 \uc228\uaca8\uc9c4 \uae30\ub2a5\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc8fc\ubaa9\ud560 \ub9cc\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ud2b9\uc815 \uc810\uc218\uc5d0 \ub3c4\ub2ec\ud558\uba74 \ud65c\uc131\ud654\ub418\ub294 '\uc57c\uac04 \ubaa8\ub4dc'\ub85c, \ubc30\uacbd\uc774 \ubcc4\uc774 \ube5b\ub098\ub294 \ubc24\ud558\ub298\ub85c \ubc14\ub01d\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc740 '\uc2a4\ud398\uc774\uc2a4\ubc14'\ub97c \ub204\ub974\uace0 \uc788\uc73c\uba74 \uc7a5\uc560\ubb3c \uc704\ub85c \ud65c\uacf5\ud560 \uc218 \uc788\ub294 '\ube44\ud589' \uae30\ub2a5\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 700\uc810\uc744 \ub2ec\uc131\ud558\uba74 \ubc30\uacbd\uc774 \uc57c\uac04 \ud14c\ub9c8\ub85c \ubc14\ub00c\uc5b4 \uc0c8\ub85c\uc6b4 \uc2dc\uac01\uc801 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uc694\uc18c\ub97c \ud0d0\ud5d8\ud558\uba74 \uac8c\uc784\uc744 \ub354 \uc990\uac81\uac8c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uacf5\ub8e1 \uac8c\uc784\uc5d0\uc11c \ud6a8\uc728\uc801\uc73c\ub85c \ud50c\ub808\uc774\ud558\uae30\uc5d0 \uc801\ud569\ud55c \ud0a4\ubcf4\ub4dc \uad6c\uc131\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uacf5\ub8e1 \uac8c\uc784\uc5d0 \uc801\ud569\ud55c \ud0a4\ubcf4\ub4dc \uad6c\uc131\uc740 \uac1c\uc778\uc801\uc778 \uc120\ud638\ub3c4\uc5d0 \ub530\ub77c \ub2e4\ub974\uc9c0\ub9cc \uc77c\ubc18\uc801\uc778 \uc124\uc815\uc5d0\ub294 \uc810\ud504\ub97c \uc704\ud574 '\uc2a4\ud398\uc774\uc2a4\ubc14' \ud0a4\uc640 \ub355\uc544\uc6c3\uc744 \uc704\ud574 '\uc544\ub798\ucabd \ud654\uc0b4\ud45c \ud0a4'\ub97c \uc0ac\uc6a9\ud558\ub294 \uac83\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\ub294 \uc774\ub7ec\ud55c \ud0a4\ub97c \uc810\ud504\uc5d0\ub294 'W' \ud0a4, \ub355\uc544\uc6c3\uc5d0\ub294 'S' \ud0a4\uc640 \uac19\uc774 \ub354 \uc27d\uac8c \uc811\uadfc\ud560 \uc218 \uc788\ub294 \uc704\uce58\ub85c \ub2e4\uc2dc \ub9e4\ud551\ud558\ub294 \uac83\uc744 \uc120\ud638\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc2a4\ud398\uc774\uc2a4\ubc14' \ud0a4\uac00 \ubd88\ud3b8\ud558\ub2e4\uace0 \uc0dd\uac01\ub418\uba74 \uc18c\ud504\ud2b8\uc6e8\uc5b4\ub97c \uc0ac\uc6a9\ud558\uc5ec 'W' \ud0a4\ub85c \ub2e4\uc2dc \ub9e4\ud551\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ucd5c\uc0c1\uc758 \ud6a8\uacfc\ub97c \uc5bb\uae30 \uc704\ud574 \uc5ec\ub7ec \uad6c\uc131\uc744 \uc2dc\ud5d8\ud574\ubcf4\uc2ed\uc2dc\uc624."}, {"question": "\uacf5\ub8e1 \uac8c\uc784\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uc5b4\ub5a4 \uc694\uc778\uc774 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\uacf5\ub8e1 \uac8c\uc784\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uac04\ub2e8\ud558\uc9c0\ub9cc \uc5ec\ub7ec \uac00\uc9c0 \uc694\uc778\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \uc774\ub3d9 \uac70\ub9ac\uc5d0 \ub530\ub77c \uc810\uc218\ub97c \ubc1b\uc73c\uba70, \uac70\ub9ac \ub2e8\uc704\ub9c8\ub2e4 1\uc810\uc529 \uc810\uc218\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4. \ub610\ud55c, \uac8c\uc784\uc758 \uc18d\ub3c4\ub294 \uc810\uc218\uac00 \ub192\uc544\uc9d0\uc5d0 \ub530\ub77c \ube68\ub77c\uc9c0\ubbc0\ub85c \ub3c4\uc804 \uacfc\uc81c\uac00 \ub354\uc6b1 \uc5b4\ub824\uc6cc\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 100\ub2e8\uc704 \uac70\ub9ac\ub97c \uc774\ub3d9\ud558\uba74 \uc810\uc218\ub294 100\uc810\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\uba74 \uc790\uc2e0\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ucd94\uc801\ud558\uace0 \uc790\uc2e0\uc758 \uace0\ub4dd\uc810\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uae30 \uc704\ud55c \ub2ec\uc131 \uac00\ub2a5\ud55c \ubaa9\ud45c\ub97c \uc124\uc815\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uacf5\ub8e1 \uac8c\uc784 \ucd08\ubcf4\uc790\uac00 \ud754\ud788 \uc800\uc9c0\ub974\ub294 \uc2e4\uc218\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uacf5\ub8e1 \uac8c\uc784 \ucd08\ubcf4\uc790\ub294 \uc885\uc885 \uacfc\ub3c4\ud55c \uc810\ud504, \ubc18\uc751 \uc9c0\uc5f0 \ubc0f \ubd88\ud544\uc694\ud55c \ub355\uc544\uc6c3\uacfc \uac19\uc740 \uc2e4\uc218\ub97c \uc800\uc9c0\ub985\ub2c8\ub2e4. \uacfc\ub3c4\ud55c \uc810\ud504\ub294 \ud0c0\uc774\ubc0d \uc624\ub958\uc640 \uc7a5\uc560\ubb3c \ucda9\ub3cc\ub85c \uc774\uc5b4\uc9c8 \uc218 \uc788\uc73c\uba70, \ubc18\uc751 \uc9c0\uc5f0\uc740 \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\ub294 \ub2a5\ub825\uc744 \uc800\ud558\uc2dc\ud0b5\ub2c8\ub2e4. \ubd88\ud544\uc694\ud55c \ub355\uc544\uc6c3\uc740 \ub610\ud55c \ud50c\ub808\uc774 \uc18d\ub3c4\ub97c \ub2a6\ucd9c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc2e4\uc218\ub97c \ud53c\ud558\ub824\uba74 \uc810\ud504\uc640 \ub355\uc544\uc6c3\uc758 \ud0c0\uc774\ubc0d\uc744 \uc815\ud655\ud558\uac8c \uc5f0\uc2b5\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uce61\uc744 \ubcf4\uba74 \uacfc\ub3c4\ud558\uac8c \uc810\ud504\ud558\uc9c0 \uc54a\uace0 \uce61\uc744 \ub118\ub3c4\ub85d \ub9c8\uc9c0\ub9c9 \uc21c\uac04\uc5d0 \uc810\ud504\ud558\ub294 \uc5f0\uc2b5\uc744 \ud558\uc2ed\uc2dc\uc624. \uac8c\uc784 \ud50c\ub808\uc774\uc640 \uc810\uc218\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\uae30 \uc704\ud574 \uc774\ub7ec\ud55c \uc601\uc5ed\uc5d0 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ube0c\ub77c\uc6b0\uc800 \ud655\uc7a5 \ud504\ub85c\uadf8\ub7a8\uc744 \uc0ac\uc6a9\ud558\uc5ec \uacf5\ub8e1 \uac8c\uc784 \uacbd\ud5d8\uc744 \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ube0c\ub77c\uc6b0\uc800 \ud655\uc7a5 \ud504\ub85c\uadf8\ub7a8\uc740 \uc810\uc218 \ucd94\uc801, \uc0ac\uc6a9\uc790 \uc9c0\uc815 \uc2a4\ud0a8 \ubc0f \uac8c\uc784 \uc218\uc815\uacfc \uac19\uc740 \uae30\ub2a5\uc744 \ucd94\uac00\ud558\uc5ec \uacf5\ub8e1 \uac8c\uc784 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uacf5\ub8e1 \uac8c\uc784 \uac15\ud654'\uc640 \uac19\uc740 \ud655\uc7a5 \ud504\ub85c\uadf8\ub7a8\uc744 \uc0ac\uc6a9\ud558\uba74 \uacf5\ub8e1\uc758 \ubaa8\uc591\uc744 \ubc14\uafb8\uace0 \uc790\uc2e0\uc758 \uace0\ub4dd\uc810\uc744 \ucd94\uc801\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud655\uc7a5 \ud504\ub85c\uadf8\ub7a8\uc740 \ube0c\ub77c\uc6b0\uc800\uc758 \ud655\uc7a5 \ud504\ub85c\uadf8\ub7a8 \uc2a4\ud1a0\uc5b4\uc5d0\uc11c \uc124\uce58\ud558\uace0 \uc124\uc815 \uc9c0\uce68\uc744 \ub530\ub974\uba74 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uae30\ub2a5\uc740 \ud2b9\ud788 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \ub2e4\uc591\uc131\uc744 \ucd94\uac00\ud558\ub824\ub294 \uacbd\uc6b0 \uac8c\uc784\uc744 \ub354 \uac1c\uc778\ud654\ud558\uace0 \uc990\uac81\uac8c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc6d0\ubcf8 \uacf5\ub8e1 \uac8c\uc784\uacfc \ub2e4\uc591\ud55c \uc218\uc815 \uac8c\uc784\uc758 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc6d0\ubcf8 \uacf5\ub8e1 \uac8c\uc784\uc740 \uac04\ub2e8\ud55c \ube0c\ub77c\uc6b0\uc800 \uae30\ubc18 \ub04a\uc784\uc5c6\ub294 \ub7ec\ub108 \uac8c\uc784\uc774\uc9c0\ub9cc, \uc218\uc815 \uac8c\uc784\uc740 \ub2e4\uc591\ud55c \ud5a5\uc0c1 \ubc0f \ubcc0\uacbd \uc0ac\ud56d\uc744 \ub3c4\uc785\ud569\ub2c8\ub2e4. \uc218\uc815 \uac8c\uc784\uc5d0\ub294 \uc0c8\ub85c\uc6b4 \uadf8\ub798\ud53d, \ucd94\uac00 \uc7a5\uc560\ubb3c, \ud30c\uc6cc\uc5c5 \ubc0f \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uac00 \ud3ec\ud568\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc778\uae30 \uc788\ub294 \uc218\uc815 \uac8c\uc784\uc5d0\ub294 \uacf5\ub8e1\uc774 \uacf5\uc911\uc5d0\uc11c \ub450 \ubc88 \uc810\ud504\ud560 \uc218 \uc788\ub3c4\ub85d '\ub354\ube14 \uc810\ud504' \uae30\ub2a5\uc774 \ucd94\uac00\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc218\uc815 \uac8c\uc784\uc744 \uc6d0\ubcf8 \uac8c\uc784\uacfc \ube44\uad50\ud574 \ubcf4\uba74 \ud50c\ub808\uc774\uc5b4 \uc120\ud638\ub3c4\uc640 \uac8c\uc784\uc758 \ucc38\uc5ec\ub3c4\ub97c \ub192\uc774\uba74\uc11c \ubcf5\uc7a1\uc131\uacfc \ub2e4\uc591\uc131\uc744 \uc5b4\ub5bb\uac8c \ub354\ud588\ub294\uc9c0 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4."}]
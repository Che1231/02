[{"question": "\u6050\u9f8d\u904a\u6232\u4e2d\u5982\u4f55\u57f7\u884c\u57fa\u672c\u7684\u8df3\u8e8d\u548c\u8eb2\u907f\u52d5\u4f5c\u4f86\u8eb2\u907f\u969c\u7919\u7269\uff1f", "answer": "\u5728\u6050\u9f8d\u904a\u6232\u4e2d\uff0c\u57fa\u672c\u7684\u8df3\u8e8d\u548c\u8eb2\u907f\u52d5\u4f5c\u5c0d\u65bc\u8eb2\u907f\u969c\u7919\u7269\u81f3\u95dc\u91cd\u8981\u3002\u8981\u8df3\u8e8d\uff0c\u8acb\u6309\u4e0b\u300e\u7a7a\u683c\u9375\u300f\u6216\u300e\u4e0a\u65b9\u5411\u9375\u300f\u3002\u9019\u5c07\u4f7f\u4f60\u7684\u6050\u9f8d\u8df3\u904e\u4ed9\u4eba\u638c\u3002\u8981\u8eb2\u907f\uff0c\u8acb\u6309\u4e0b\u300e\u4e0b\u65b9\u5411\u9375\u300f\uff0c\u9019\u5c07\u4f7f\u6050\u9f8d\u8e72\u4e0b\u4ee5\u8eb2\u907f\u4f4e\u7a7a\u98db\u884c\u7684\u9ce5\u985e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u770b\u5230\u4ed9\u4eba\u638c\u903c\u8fd1\uff0c\u8acb\u6309\u4e0b\u300e\u7a7a\u683c\u9375\u300f\u8df3\u904e\u5b83\u3002\u5982\u679c\u9ce5\u5152\u98db\u5f97\u5f88\u4f4e\uff0c\u8acb\u5feb\u901f\u6309\u4e0b\u300e\u4e0b\u65b9\u5411\u9375\u300f\u8eb2\u907f\u5b83\u3002\u7df4\u7fd2\u9019\u4e9b\u52d5\u4f5c\u4ee5\u63d0\u9ad8\u4f60\u7684\u53cd\u61c9\u6642\u9593\u548c\u5f97\u5206\u3002"}, {"question": "\u4f5c\u70ba\u9ad8\u7d1a\u73a9\u5bb6\uff0c\u5728\u6050\u9f8d\u904a\u6232\u4e2d\u751f\u5b58\u66f4\u9577\u6642\u9593\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u70ba\u4e86\u5728\u6050\u9f8d\u904a\u6232\u4e2d\u751f\u5b58\u66f4\u9577\u6642\u9593\uff0c\u9ad8\u7d1a\u73a9\u5bb6\u61c9\u8a72\u5c08\u6ce8\u65bc\u4e09\u500b\u95dc\u9375\u7b56\u7565\uff1a\u7bc0\u594f\u3001\u9810\u5224\u548c\u63a7\u5236\u3002\u9996\u5148\uff0c\u901a\u904e\u6301\u7e8c\u5730\u8abf\u6574\u8df3\u8e8d\u548c\u8eb2\u907f\u7684\u6642\u6a5f\u4f86\u5efa\u7acb\u7bc0\u594f\u3002\u5176\u6b21\uff0c\u901a\u904e\u5411\u524d\u770b\u4e26\u8a08\u5283\u4f60\u7684\u52d5\u4f5c\u4f86\u9810\u5224\u969c\u7919\u7269\u3002\u7b2c\u4e09\uff0c\u901a\u904e\u907f\u514d\u4e0d\u5fc5\u8981\u7684\u8df3\u8e8d\u6216\u8eb2\u907f\u4f86\u4fdd\u6301\u63a7\u5236\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u770b\u5230\u4ed9\u4eba\u638c\u548c\u9ce5\u5152\u903c\u8fd1\uff0c\u8acb\u8abf\u6574\u4f60\u7684\u8df3\u8e8d\u6642\u9593\u4ee5\u6e05\u9664\u4ed9\u4eba\u638c\uff0c\u7136\u5f8c\u7acb\u5373\u8eb2\u907f\u9ce5\u5152\u3002\u7df4\u7fd2\u9019\u4e9b\u6b65\u9a5f\u4ee5\u589e\u5f37\u4f60\u7684\u904a\u6232\u73a9\u6cd5\u4e26\u7372\u5f97\u66f4\u9ad8\u7684\u5206\u6578\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u6050\u9f8d\u904a\u6232\u4e2d\u7684\u969c\u7919\u7269\u901f\u5ea6\u6703\u589e\u52a0\uff0c\u4ee5\u53ca\u9019\u5982\u4f55\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff1f", "answer": "\u6050\u9f8d\u904a\u6232\u4e2d\u969c\u7919\u7269\u901f\u5ea6\u7684\u63d0\u9ad8\u65e8\u5728\u5275\u9020\u66f4\u5177\u6311\u6230\u6027\u548c\u53c3\u8207\u6027\u7684\u9ad4\u9a57\u3002\u96a8\u8457\u4f60\u7684\u5206\u6578\u63d0\u5347\uff0c\u904a\u6232\u6703\u9010\u6f38\u52a0\u5feb\u901f\u5ea6\uff0c\u4f7f\u5f97\u53cd\u61c9\u969c\u7919\u7269\u8b8a\u5f97\u66f4\u96e3\u3002\u9019\u901a\u904e\u8981\u6c42\u66f4\u5feb\u7684\u53cd\u61c9\u80fd\u529b\u548c\u66f4\u597d\u7684\u6642\u6a5f\u4f86\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\u3002\u4f8b\u5982\uff0c\u904a\u6232\u521d\u671f\u4f60\u53ef\u80fd\u6703\u6709\u8db3\u5920\u7684\u6642\u9593\u8df3\u904e\u4ed9\u4eba\u638c\uff0c\u4f46\u96a8\u8457\u901f\u5ea6\u7684\u589e\u52a0\uff0c\u4f60\u9700\u8981\u66f4\u5feb\u5730\u505a\u51fa\u53cd\u61c9\u3002\u7406\u89e3\u9019\u500b\u6a5f\u5236\u53ef\u4ee5\u5e6b\u52a9\u4f60\u70ba\u8d8a\u4f86\u8d8a\u9ad8\u7684\u96e3\u5ea6\u505a\u597d\u6e96\u5099\u4e26\u63d0\u5347\u4f60\u7684\u6574\u9ad4\u8868\u73fe\u3002"}, {"question": "\u5982\u4f55\u5c07\u6211\u7684\u6050\u9f8d\u904a\u6232\u9032\u5ea6\u5f9e\u4e00\u500b\u8a2d\u5099\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u8a2d\u5099\uff1f", "answer": "\u5c07\u4f60\u7684\u6050\u9f8d\u904a\u6232\u9032\u5ea6\u5f9e\u4e00\u500b\u8a2d\u5099\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u8a2d\u5099\u53ef\u80fd\u5f88\u68d8\u624b\uff0c\u56e0\u70ba\u904a\u6232\u901a\u5e38\u4e0d\u6703\u4fdd\u5b58\u9032\u5ea6\u3002\u4f46\u662f\uff0c\u5982\u679c\u4f60\u5728\u700f\u89bd\u5668\u4e0a\u73a9\u904a\u6232\uff0c\u53ef\u4ee5\u4f7f\u7528\u700f\u89bd\u5668\u540c\u6b65\u3002\u8acb\u78ba\u4fdd\u4f60\u5728\u5169\u500b\u8a2d\u5099\u4e0a\u90fd\u767b\u9304\u76f8\u540c\u7684\u700f\u89bd\u5668\u5e33\u6236\uff0c\u4f60\u7684\u9032\u5ea6\u53ef\u80fd\u6703\u81ea\u52d5\u540c\u6b65\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4f7f\u7528 Chrome\uff0c\u8acb\u5728\u5169\u500b\u8a2d\u5099\u4e0a\u767b\u9304\u4f60\u7684 Google \u5e33\u6236\uff0c\u4ee5\u6f5b\u5728\u5730\u540c\u6b65\u4f60\u7684\u904a\u6232\u6578\u64da\u3002\u8acb\u6ce8\u610f\uff0c\u6b64\u65b9\u6cd5\u4e26\u975e\u7d55\u5c0d\u4fdd\u8b49\u6210\u529f\uff0c\u56e0\u70ba\u6050\u9f8d\u904a\u6232\u4e3b\u8981\u4f9d\u8cf4\u65bc\u672c\u5730\u5b58\u5132\u3002"}, {"question": "\u6050\u9f8d\u904a\u6232\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u7684\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "\u6050\u9f8d\u904a\u6232\u5305\u542b\u4e00\u4e9b\u96b1\u85cf\u7684\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u589e\u52a0\u4e86\u5176\u9b45\u529b\u3002\u4e00\u500b\u986f\u8457\u7684\u5f69\u86cb\u662f\u300e\u591c\u9593\u6a21\u5f0f\u300f\uff0c\u5728\u9054\u5230\u4e00\u5b9a\u5206\u6578\u5f8c\u6fc0\u6d3b\uff0c\u5c07\u80cc\u666f\u66f4\u6539\u70ba\u661f\u5149\u9ede\u9ede\u7684\u591c\u7a7a\u3002\u53e6\u4e00\u500b\u96b1\u85cf\u529f\u80fd\u662f\u53ef\u4ee5\u901a\u904e\u6309\u4f4f\u300e\u7a7a\u683c\u9375\u300f\u4f86\u300e\u98db\u884c\u300f\uff0c\u8b93\u6050\u9f8d\u6ed1\u7fd4\u8d8a\u904e\u969c\u7919\u7269\u3002\u4f8b\u5982\uff0c\u5728\u9054\u5230 700 \u5206\u5f8c\uff0c\u80cc\u666f\u5c07\u8f49\u8b8a\u70ba\u591c\u9593\u4e3b\u984c\uff0c\u63d0\u4f9b\u5168\u65b0\u7684\u8996\u89ba\u9ad4\u9a57\u3002\u63a2\u7d22\u9019\u4e9b\u96b1\u85cf\u5143\u7d20\u6703\u8b93\u904a\u6232\u66f4\u4ee4\u4eba\u6109\u5feb\u3002"}, {"question": "\u54ea\u7a2e\u9375\u76e4\u914d\u7f6e\u6700\u9069\u5408\u6709\u6548\u5730\u73a9\u6050\u9f8d\u904a\u6232\uff1f", "answer": "\u6050\u9f8d\u904a\u6232\u7684\u6700\u4f73\u9375\u76e4\u914d\u7f6e\u53d6\u6c7a\u65bc\u500b\u4eba\u559c\u597d\uff0c\u4f46\u4e00\u500b\u5e38\u898b\u7684\u8a2d\u7f6e\u5305\u62ec\u4f7f\u7528\u300e\u7a7a\u683c\u9375\u300f\u8df3\u8e8d\u548c\u300e\u4e0b\u65b9\u5411\u9375\u300f\u8eb2\u907f\u3002\u4e00\u4e9b\u73a9\u5bb6\u66f4\u559c\u6b61\u5c07\u9019\u4e9b\u9375\u91cd\u65b0\u6620\u5c04\u5230\u66f4\u6613\u65bc\u89f8\u53ca\u7684\u4f4d\u7f6e\uff0c\u4f8b\u5982\u4f7f\u7528\u300eW\u300f\u9375\u8df3\u8e8d\u548c\u300eS\u300f\u9375\u8eb2\u907f\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u89ba\u5f97\u300e\u7a7a\u683c\u9375\u300f\u4e0d\u8212\u670d\uff0c\u53ef\u4ee5\u4f7f\u7528\u8edf\u9ad4\u5c07\u5176\u91cd\u65b0\u6620\u5c04\u5230\u300eW\u300f\u9375\u3002\u5617\u8a66\u4e0d\u540c\u7684\u914d\u7f6e\u4f86\u627e\u5230\u6700\u9069\u5408\u4f60\u4e26\u63d0\u9ad8\u904a\u6232\u6548\u7387\u7684\u65b9\u6cd5\u3002"}, {"question": "\u6050\u9f8d\u904a\u6232\u4e2d\u7684\u5f97\u5206\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u5b83\uff1f", "answer": "\u6050\u9f8d\u904a\u6232\u4e2d\u7684\u5f97\u5206\u7cfb\u7d71\u7c21\u55ae\u660e\u77ad\uff0c\u4f46\u53d7\u591a\u500b\u56e0\u7d20\u7684\u5f71\u97ff\u3002\u4f60\u6703\u6839\u64da\u884c\u9032\u7684\u8ddd\u96e2\u7372\u5f97\u5206\u6578\uff0c\u6bcf\u79fb\u52d5\u4e00\u500b\u55ae\u4f4d\u8ddd\u96e2\u5f97\u5206\u6703\u589e\u52a0 1 \u5206\u3002\u6b64\u5916\uff0c\u904a\u6232\u901f\u5ea6\u6703\u96a8\u8457\u4f60\u7684\u5206\u6578\u63d0\u5347\u800c\u52a0\u5feb\uff0c\u589e\u52a0\u4e86\u6311\u6230\u6027\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u79fb\u52d5\u4e86 100 \u500b\u55ae\u4f4d\u8ddd\u96e2\uff0c\u4f60\u7684\u5206\u6578\u5c31\u662f 100\u3002\u7406\u89e3\u9019\u500b\u7cfb\u7d71\u53ef\u4ee5\u5e6b\u52a9\u4f60\u8ffd\u8e2a\u9032\u5ea6\u4e26\u8a2d\u5b9a\u53ef\u5be6\u73fe\u7684\u76ee\u6a19\u4ee5\u63d0\u5347\u4f60\u7684\u6700\u9ad8\u5206\u6578\u3002"}, {"question": "\u6050\u9f8d\u904a\u6232\u4e2d\u521d\u5b78\u8005\u5e38\u72af\u54ea\u4e9b\u932f\u8aa4\uff0c\u4ee5\u53ca\u5982\u4f55\u907f\u514d\u5b83\u5011\uff1f", "answer": "\u6050\u9f8d\u904a\u6232\u4e2d\u7684\u65b0\u624b\u7d93\u5e38\u72af\u932f\u8aa4\uff0c\u4f8b\u5982\u904e\u5ea6\u8df3\u8e8d\u3001\u53cd\u61c9\u5ef6\u9072\u548c\u4e0d\u5fc5\u8981\u7684\u8eb2\u907f\u3002\u904e\u5ea6\u8df3\u8e8d\u53ef\u80fd\u5c0e\u81f4\u6642\u6a5f\u5931\u8aa4\u4e26\u649e\u5230\u969c\u7919\u7269\uff0c\u800c\u53cd\u61c9\u5ef6\u9072\u964d\u4f4e\u4e86\u4f60\u8eb2\u907f\u969c\u7919\u7269\u7684\u80fd\u529b\u3002\u4e0d\u5fc5\u8981\u7684\u8eb2\u907f\u4e5f\u6703\u6e1b\u6162\u4f60\u7684\u901f\u5ea6\u3002\u70ba\u907f\u514d\u9019\u4e9b\u932f\u8aa4\uff0c\u8acb\u7df4\u7fd2\u7cbe\u78ba\u5730\u8abf\u6574\u8df3\u8e8d\u548c\u8eb2\u907f\u7684\u6642\u6a5f\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u770b\u5230\u4ed9\u4eba\u638c\uff0c\u8acb\u7b49\u5230\u6700\u5f8c\u4e00\u523b\u518d\u8df3\u8e8d\uff0c\u78ba\u4fdd\u4f60\u80fd\u6e05\u9664\u5b83\u800c\u4e0d\u81f3\u65bc\u904e\u5ea6\u8df3\u8e8d\u3002\u5c08\u6ce8\u65bc\u9019\u4e9b\u65b9\u9762\uff0c\u4ee5\u6539\u5584\u4f60\u7684\u904a\u6232\u73a9\u6cd5\u548c\u5f97\u5206\u3002"}, {"question": "\u6211\u5982\u4f55\u4f7f\u7528\u700f\u89bd\u5668\u64f4\u5c55\u4f86\u589e\u5f37\u6211\u7684\u6050\u9f8d\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u700f\u89bd\u5668\u64f4\u5c55\u53ef\u4ee5\u901a\u904e\u6dfb\u52a0\u8af8\u5982\u5f97\u5206\u8ffd\u8e64\u3001\u81ea\u5b9a\u7fa9\u76ae\u819a\u548c\u904a\u6232\u4fee\u6539\u7b49\u529f\u80fd\u4f86\u589e\u5f37\u4f60\u7684\u6050\u9f8d\u904a\u6232\u9ad4\u9a57\u3002\u4f8b\u5982\uff0c\u300e\u6050\u9f8d\u904a\u6232\u589e\u5f37\u5668\u300f\u64f4\u5c55\u5141\u8a31\u4f60\u66f4\u6539\u6050\u9f8d\u7684\u5916\u89c0\u4e26\u8ffd\u8e64\u4f60\u7684\u6700\u9ad8\u5206\u6578\u3002\u8981\u4f7f\u7528\u9019\u4e9b\u64f4\u5c55\uff0c\u53ea\u9700\u5f9e\u700f\u89bd\u5668\u7684\u64f4\u5c55\u5546\u5e97\u4e2d\u5b89\u88dd\u64f4\u5c55\u4e26\u6309\u7167\u8a2d\u7f6e\u8aaa\u660e\u64cd\u4f5c\u3002\u9019\u53ef\u4ee5\u4f7f\u904a\u6232\u66f4\u500b\u6027\u5316\uff0c\u66f4\u4ee4\u4eba\u6109\u5feb\uff0c\u5c24\u5176\u662f\u5982\u679c\u4f60\u60f3\u8b93\u904a\u6232\u66f4\u8c50\u5bcc\u591a\u6a23\u3002"}, {"question": "\u539f\u59cb\u7684\u6050\u9f8d\u904a\u6232\u53ca\u5176\u5404\u7a2e\u4fee\u6539\u7248\u672c\u4e4b\u9593\u6709\u4ec0\u9ebc\u5340\u5225\uff1f", "answer": "\u539f\u59cb\u7684\u6050\u9f8d\u904a\u6232\u662f\u4e00\u6b3e\u7c21\u55ae\u7684\u57fa\u65bc\u700f\u89bd\u5668\u7684\u7121\u9650\u5954\u8dd1\u904a\u6232\uff0c\u800c\u5176\u4fee\u6539\u7248\u672c\u5f15\u5165\u4e86\u5404\u7a2e\u6539\u9032\u548c\u8b8a\u5316\u3002\u4fee\u6539\u7248\u672c\u53ef\u80fd\u5305\u62ec\u65b0\u7684\u5716\u5f62\u3001\u984d\u5916\u7684\u969c\u7919\u7269\u3001\u52a0\u6210\u9053\u5177\uff0c\u751a\u81f3\u591a\u4eba\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u4e00\u500b\u6d41\u884c\u7684\u4fee\u6539\u7248\u672c\u53ef\u80fd\u6703\u6dfb\u52a0\u300e\u96d9\u8df3\u300f\u529f\u80fd\uff0c\u8b93\u6050\u9f8d\u5728\u7a7a\u4e2d\u9032\u884c\u7b2c\u4e8c\u6b21\u8df3\u8e8d\u3002\u5c07\u9019\u4e9b\u4fee\u6539\u7248\u8207\u539f\u59cb\u904a\u6232\u9032\u884c\u6bd4\u8f03\uff0c\u986f\u793a\u4e86\u5b83\u5011\u5982\u4f55\u589e\u52a0\u8907\u96dc\u6027\uff0c\u4e26\u63d0\u4f9b\u66f4\u591a\u8b8a\u5316\uff0c\u4ee5\u8fce\u5408\u4e0d\u540c\u7684\u73a9\u5bb6\u504f\u597d\uff0c\u4f7f\u904a\u6232\u66f4\u5177\u5438\u5f15\u529b\u3002"}]
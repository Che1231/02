[{"question": "\u5982\u4f55\u6267\u884c\u6050\u9f99\u6e38\u620f\u4e2d\u7684\u57fa\u672c\u8df3\u8dc3\u548c\u8eb2\u907f\u52a8\u4f5c\u4ee5\u8eb2\u907f\u969c\u788d\u7269\uff1f", "answer": "\u5728\u6050\u9f99\u6e38\u620f\u4e2d\uff0c\u57fa\u672c\u8df3\u8dc3\u548c\u8eb2\u907f\u5bf9\u4e8e\u8eb2\u907f\u969c\u788d\u7269\u81f3\u5173\u91cd\u8981\u3002\u8981\u8df3\u8dc3\uff0c\u8bf7\u6309\u7a7a\u683c\u952e\u6216\u5411\u4e0a\u7bad\u5934\u952e\u3002\u8fd9\u5141\u8bb8\u4f60\u7684\u6050\u9f99\u8df3\u8fc7\u4ed9\u4eba\u638c\u3002\u8981\u8eb2\u907f\uff0c\u8bf7\u6309\u5411\u4e0b\u7bad\u5934\u952e\uff0c\u8fd9\u4f1a\u4f7f\u6050\u9f99\u8e72\u4e0b\u8eb2\u907f\u4f4e\u98de\u7684\u9e1f\u3002\u4f8b\u5982\uff0c\u5982\u679c\u770b\u5230\u4ed9\u4eba\u638c\u903c\u8fd1\uff0c\u8bf7\u6309\u7a7a\u683c\u952e\u8df3\u8fc7\u5b83\u3002\u5982\u679c\u9e1f\u98de\u5f97\u5f88\u4f4e\uff0c\u8bf7\u5feb\u901f\u6309\u5411\u4e0b\u7bad\u5934\u952e\u8eb2\u5230\u5b83\u4e0b\u9762\u3002\u7ec3\u4e60\u8fd9\u4e9b\u52a8\u4f5c\u4ee5\u63d0\u9ad8\u4f60\u7684\u53cd\u5e94\u65f6\u95f4\u548c\u5f97\u5206\u3002"}, {"question": "\u4f5c\u4e3a\u4e00\u540d\u9ad8\u7ea7\u73a9\u5bb6\uff0c\u5728\u6050\u9f99\u6e38\u620f\u4e2d\u751f\u5b58\u66f4\u957f\u65f6\u95f4\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u4e3a\u4e86\u5728\u6050\u9f99\u6e38\u620f\u4e2d\u751f\u5b58\u66f4\u957f\u65f6\u95f4\uff0c\u9ad8\u7ea7\u73a9\u5bb6\u5e94\u4e13\u6ce8\u4e8e\u4e09\u4e2a\u5173\u952e\u7b56\u7565\uff1a\u8282\u594f\u3001\u9884\u671f\u548c\u63a7\u5236\u3002\u9996\u5148\uff0c\u901a\u8fc7\u6301\u7eed\u5730\u8c03\u6574\u8df3\u8dc3\u548c\u8eb2\u907f\u7684\u65f6\u95f4\u6765\u5efa\u7acb\u8282\u594f\u3002\u5176\u6b21\uff0c\u901a\u8fc7\u89c2\u5bdf\u524d\u65b9\u5e76\u8ba1\u5212\u4f60\u7684\u884c\u52a8\u6765\u9884\u6d4b\u969c\u788d\u7269\u3002\u7b2c\u4e09\uff0c\u901a\u8fc7\u907f\u514d\u4e0d\u5fc5\u8981\u7684\u8df3\u8dc3\u6216\u8eb2\u907f\u6765\u4fdd\u6301\u63a7\u5236\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u770b\u5230\u4ed9\u4eba\u638c\u548c\u9e1f\u903c\u8fd1\uff0c\u8bf7\u8c03\u6574\u8df3\u8dc3\u65f6\u95f4\u4ee5\u6e05\u9664\u4ed9\u4eba\u638c\uff0c\u7136\u540e\u7acb\u5373\u8eb2\u907f\u9e1f\u3002\u7ec3\u4e60\u8fd9\u4e9b\u6b65\u9aa4\u4ee5\u589e\u5f3a\u4f60\u7684\u6e38\u620f\u73a9\u6cd5\u5e76\u83b7\u5f97\u66f4\u9ad8\u7684\u5206\u6570\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u6050\u9f99\u6e38\u620f\u4e2d\u7684\u969c\u788d\u7269\u901f\u5ea6\u4f1a\u589e\u52a0\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\uff1f", "answer": "\u6050\u9f99\u6e38\u620f\u4e2d\u969c\u788d\u7269\u901f\u5ea6\u7684\u589e\u52a0\u662f\u4e3a\u4e86\u521b\u9020\u66f4\u5177\u6311\u6218\u6027\u548c\u5438\u5f15\u529b\u7684\u4f53\u9a8c\u3002\u968f\u7740\u4f60\u7684\u5206\u6570\u4e0a\u5347\uff0c\u6e38\u620f\u8282\u594f\u4f1a\u9010\u6e10\u52a0\u5feb\uff0c\u4f7f\u53cd\u5e94\u969c\u788d\u7269\u53d8\u5f97\u66f4\u56f0\u96be\u3002\u8fd9\u4f1a\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\uff0c\u9700\u8981\u66f4\u5feb\u7684\u53cd\u5e94\u901f\u5ea6\u548c\u66f4\u597d\u7684\u65f6\u95f4\u63a7\u5236\u3002\u4f8b\u5982\uff0c\u6e38\u620f\u521d\u671f\uff0c\u4f60\u6709\u8db3\u591f\u7684\u65f6\u95f4\u8df3\u8fc7\u4ed9\u4eba\u638c\uff0c\u4f46\u968f\u7740\u901f\u5ea6\u7684\u589e\u52a0\uff0c\u4f60\u9700\u8981\u66f4\u5feb\u5730\u505a\u51fa\u53cd\u5e94\u3002\u7406\u89e3\u8fd9\u4e2a\u673a\u5236\u53ef\u4ee5\u5e2e\u52a9\u4f60\u4e3a\u65e5\u76ca\u589e\u52a0\u7684\u96be\u5ea6\u505a\u597d\u51c6\u5907\uff0c\u5e76\u63d0\u9ad8\u4f60\u7684\u6574\u4f53\u8868\u73b0\u3002"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684\u6050\u9f99\u6e38\u620f\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u8bbe\u5907\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u8bbe\u5907\uff1f", "answer": "\u5c06\u4f60\u7684\u6050\u9f99\u6e38\u620f\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u8bbe\u5907\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u8bbe\u5907\u53ef\u80fd\u5f88\u68d8\u624b\uff0c\u56e0\u4e3a\u6e38\u620f\u901a\u5e38\u4e0d\u4fdd\u5b58\u8fdb\u5ea6\u3002\u4f46\u662f\uff0c\u5982\u679c\u4f60\u5728\u6d4f\u89c8\u5668\u4e0a\u73a9\u6e38\u620f\uff0c\u53ef\u4ee5\u4f7f\u7528\u6d4f\u89c8\u5668\u540c\u6b65\u3002\u786e\u4fdd\u4f60\u5728\u4e24\u4e2a\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u6d4f\u89c8\u5668\u5e10\u6237\uff0c\u4f60\u7684\u8fdb\u5ea6\u53ef\u80fd\u4f1a\u81ea\u52a8\u540c\u6b65\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4f7f\u7528 Chrome\uff0c\u8bf7\u5728\u4e24\u4e2a\u8bbe\u5907\u4e0a\u767b\u5f55\u4f60\u7684\u8c37\u6b4c\u5e10\u6237\uff0c\u4ee5\u6f5c\u5728\u5730\u540c\u6b65\u4f60\u7684\u6e38\u620f\u6570\u636e\u3002\u8bf7\u6ce8\u610f\uff0c\u6b64\u65b9\u6cd5\u5e76\u975e\u7edd\u5bf9\u4fdd\u8bc1\u6210\u529f\uff0c\u56e0\u4e3a\u6050\u9f99\u6e38\u620f\u4e3b\u8981\u4f9d\u8d56\u672c\u5730\u5b58\u50a8\u3002"}, {"question": "\u6050\u9f99\u6e38\u620f\u4e2d\u662f\u5426\u5b58\u5728\u9690\u85cf\u7684\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "\u6050\u9f99\u6e38\u620f\u4e2d\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u7684\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u4f7f\u5176\u66f4\u5177\u9b45\u529b\u3002\u4e00\u4e2a\u663e\u8457\u7684\u5f69\u86cb\u662f\u201c\u591c\u95f4\u6a21\u5f0f\u201d\uff0c\u5728\u8fbe\u5230\u4e00\u5b9a\u5206\u6570\u540e\u6fc0\u6d3b\uff0c\u5c06\u80cc\u666f\u66f4\u6539\u4e3a\u661f\u5149\u591c\u7a7a\u3002\u53e6\u4e00\u4e2a\u9690\u85cf\u529f\u80fd\u662f\u901a\u8fc7\u6309\u4f4f\u7a7a\u683c\u952e\u6765\u201c\u98de\u884c\u201d\uff0c\u8ba9\u6050\u9f99\u6ed1\u8fc7\u969c\u788d\u7269\u3002\u4f8b\u5982\uff0c\u8fbe\u5230 700 \u5206\u540e\uff0c\u80cc\u666f\u5c06\u4f1a\u8f6c\u6362\u4e3a\u591c\u95f4\u4e3b\u9898\uff0c\u63d0\u4f9b\u5168\u65b0\u7684\u89c6\u89c9\u4f53\u9a8c\u3002\u63a2\u7d22\u8fd9\u4e9b\u9690\u85cf\u5143\u7d20\u53ef\u4ee5\u4f7f\u6e38\u620f\u66f4\u52a0\u6709\u8da3\u3002"}, {"question": "\u54ea\u79cd\u952e\u76d8\u914d\u7f6e\u6700\u9002\u5408\u4ee5\u9ad8\u6548\u7684\u65b9\u5f0f\u73a9\u6050\u9f99\u6e38\u620f\uff1f", "answer": "\u6050\u9f99\u6e38\u620f\u7684\u6700\u4f73\u952e\u76d8\u914d\u7f6e\u53d6\u51b3\u4e8e\u4e2a\u4eba\u559c\u597d\uff0c\u4f46\u4e00\u79cd\u5e38\u89c1\u8bbe\u7f6e\u5305\u62ec\u4f7f\u7528\u7a7a\u683c\u952e\u8fdb\u884c\u8df3\u8dc3\u548c\u5411\u4e0b\u7bad\u5934\u952e\u8fdb\u884c\u8eb2\u907f\u3002\u4e00\u4e9b\u73a9\u5bb6\u66f4\u559c\u6b22\u5c06\u8fd9\u4e9b\u6309\u952e\u91cd\u65b0\u6620\u5c04\u5230\u66f4\u5bb9\u6613\u8bbf\u95ee\u7684\u4f4d\u7f6e\uff0c\u4f8b\u5982\u4f7f\u7528\u201cW\u201d\u952e\u8fdb\u884c\u8df3\u8dc3\u548c\u201cS\u201d\u952e\u8fdb\u884c\u8eb2\u907f\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u89c9\u5f97\u7a7a\u683c\u952e\u4e0d\u592a\u65b9\u4fbf\uff0c\u53ef\u4ee5\u4f7f\u7528\u8f6f\u4ef6\u5c06\u5176\u91cd\u65b0\u6620\u5c04\u5230\u201cW\u201d\u952e\u3002\u5c1d\u8bd5\u4e0d\u540c\u7684\u914d\u7f6e\uff0c\u627e\u5230\u6700\u9002\u5408\u4f60\u5e76\u63d0\u9ad8\u6e38\u620f\u6548\u7387\u7684\u914d\u7f6e\u3002"}, {"question": "\u6050\u9f99\u6e38\u620f\u7684\u8ba1\u5206\u7cfb\u7edf\u5982\u4f55\u8fd0\u4f5c\uff0c\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u5b83\uff1f", "answer": "\u6050\u9f99\u6e38\u620f\u7684\u8ba1\u5206\u7cfb\u7edf\u7b80\u5355\u660e\u4e86\uff0c\u4f46\u53d7\u591a\u79cd\u56e0\u7d20\u7684\u5f71\u54cd\u3002\u4f60\u6839\u636e\u884c\u8fdb\u7684\u8ddd\u79bb\u83b7\u5f97\u5206\u6570\uff0c\u6bcf\u4e2a\u5355\u4f4d\u8ddd\u79bb\u7684\u5f97\u5206\u90fd\u4f1a\u589e\u52a0\u4e00\u70b9\u3002\u6b64\u5916\uff0c\u968f\u7740\u5206\u6570\u7684\u4e0a\u5347\uff0c\u6e38\u620f\u7684\u8282\u594f\u4e5f\u4f1a\u52a0\u5feb\uff0c\u589e\u52a0\u6311\u6218\u6027\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u884c\u8fdb\u4e86 100 \u4e2a\u5355\u4f4d\u7684\u8ddd\u79bb\uff0c\u4f60\u7684\u5206\u6570\u5c06\u662f 100\u3002\u7406\u89e3\u8fd9\u4e2a\u7cfb\u7edf\u53ef\u4ee5\u5e2e\u52a9\u4f60\u8ffd\u8e2a\u4f60\u7684\u8fdb\u6b65\uff0c\u5e76\u8bbe\u5b9a\u6539\u8fdb\u9ad8\u5206\u7684\u53ef\u5b9e\u73b0\u76ee\u6807\u3002"}, {"question": "\u6050\u9f99\u6e38\u620f\u4e2d\u521d\u5b66\u8005\u5e38\u72af\u54ea\u4e9b\u9519\u8bef\uff0c\u4ee5\u53ca\u5982\u4f55\u907f\u514d\u5b83\u4eec\uff1f", "answer": "\u6050\u9f99\u6e38\u620f\u4e2d\u7684\u521d\u5b66\u8005\u7ecf\u5e38\u72af\u9519\u8bef\uff0c\u4f8b\u5982\u8fc7\u5ea6\u8df3\u8dc3\u3001\u53cd\u5e94\u8fdf\u7f13\u548c\u4e0d\u5fc5\u8981\u7684\u8eb2\u907f\u3002\u8fc7\u5ea6\u8df3\u8dc3\u4f1a\u5bfc\u81f4\u65f6\u95f4\u9519\u5931\u548c\u649e\u5230\u969c\u788d\u7269\uff0c\u800c\u53cd\u5e94\u8fdf\u7f13\u4f1a\u964d\u4f4e\u907f\u514d\u969c\u788d\u7269\u7684\u80fd\u529b\u3002\u4e0d\u5fc5\u8981\u7684\u8eb2\u907f\u4e5f\u4f1a\u51cf\u6162\u4f60\u7684\u901f\u5ea6\u3002\u4e3a\u4e86\u907f\u514d\u8fd9\u4e9b\u9519\u8bef\uff0c\u8bf7\u7ec3\u4e60\u51c6\u786e\u63a7\u5236\u8df3\u8dc3\u548c\u8eb2\u907f\u7684\u65f6\u95f4\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u770b\u5230\u4ed9\u4eba\u638c\uff0c\u8bf7\u7b49\u5f85\u6700\u540e\u65f6\u523b\u624d\u8df3\u8dc3\uff0c\u786e\u4fdd\u4f60\u80fd\u591f\u5c06\u5176\u6e05\u9664\u800c\u4e0d\u53d1\u751f\u8fc7\u5ea6\u8df3\u8dc3\u3002\u4e13\u6ce8\u4e8e\u8fd9\u4e9b\u65b9\u9762\u4ee5\u6539\u8fdb\u4f60\u7684\u6e38\u620f\u73a9\u6cd5\u548c\u5f97\u5206\u3002"}, {"question": "\u5982\u4f55\u4f7f\u7528\u6d4f\u89c8\u5668\u6269\u5c55\u7a0b\u5e8f\u6765\u589e\u5f3a\u6211\u7684\u6050\u9f99\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u6d4f\u89c8\u5668\u6269\u5c55\u7a0b\u5e8f\u53ef\u4ee5\u901a\u8fc7\u6dfb\u52a0\u8bf8\u5982\u5206\u6570\u8ffd\u8e2a\u3001\u81ea\u5b9a\u4e49\u76ae\u80a4\u548c\u6e38\u620f\u4fee\u6539\u7b49\u529f\u80fd\u6765\u589e\u5f3a\u4f60\u7684\u6050\u9f99\u6e38\u620f\u4f53\u9a8c\u3002\u4f8b\u5982\uff0c\u201c\u6050\u9f99\u6e38\u620f\u589e\u5f3a\u5668\u201d\u7b49\u6269\u5c55\u7a0b\u5e8f\u5141\u8bb8\u4f60\u66f4\u6539\u6050\u9f99\u7684\u5916\u89c2\u5e76\u8ffd\u8e2a\u4f60\u7684\u9ad8\u5206\u3002\u8981\u4f7f\u7528\u8fd9\u4e9b\u6269\u5c55\u7a0b\u5e8f\uff0c\u53ea\u9700\u4ece\u4f60\u7684\u6d4f\u89c8\u5668\u6269\u5c55\u7a0b\u5e8f\u5546\u5e97\u5b89\u88c5\u6269\u5c55\u7a0b\u5e8f\u5e76\u6309\u7167\u5b89\u88c5\u8bf4\u660e\u64cd\u4f5c\u5373\u53ef\u3002\u8fd9\u53ef\u4ee5\u4f7f\u6e38\u620f\u66f4\u52a0\u4e2a\u6027\u5316\u548c\u6709\u8da3\uff0c\u7279\u522b\u662f\u5982\u679c\u4f60\u60f3\u4e3a\u4f60\u7684\u6e38\u620f\u73a9\u6cd5\u589e\u52a0\u591a\u6837\u6027\u3002"}, {"question": "\u539f\u7248\u6050\u9f99\u6e38\u620f\u53ca\u5176\u5404\u79cd\u4fee\u6539\u7248\u4e4b\u95f4\u6709\u4ec0\u4e48\u533a\u522b\uff1f", "answer": "\u539f\u7248\u6050\u9f99\u6e38\u620f\u662f\u4e00\u6b3e\u7b80\u5355\u7684\u57fa\u4e8e\u6d4f\u89c8\u5668\u7684\u65e0\u5c3d\u8dd1\u9177\u6e38\u620f\uff0c\u800c\u5b83\u7684\u4fee\u6539\u7248\u5219\u5f15\u5165\u4e86\u5404\u79cd\u589e\u5f3a\u548c\u66f4\u6539\u3002\u4fee\u6539\u7248\u53ef\u80fd\u5305\u62ec\u65b0\u7684\u56fe\u5f62\u3001\u989d\u5916\u7684\u969c\u788d\u7269\u3001\u9053\u5177\u4ee5\u53ca\u751a\u81f3\u591a\u4eba\u6e38\u620f\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u4e00\u4e2a\u53d7\u6b22\u8fce\u7684\u4fee\u6539\u7248\u53ef\u80fd\u4f1a\u6dfb\u52a0\u201c\u53cc\u8df3\u201d\u529f\u80fd\uff0c\u8ba9\u6050\u9f99\u80fd\u591f\u5728\u7a7a\u4e2d\u8fdb\u884c\u7b2c\u4e8c\u6b21\u8df3\u8dc3\u3002\u6bd4\u8f83\u8fd9\u4e9b\u4fee\u6539\u7248\u4e0e\u539f\u7248\u6e38\u620f\u53ef\u4ee5\u770b\u51fa\uff0c\u5b83\u4eec\u5982\u4f55\u589e\u52a0\u4e86\u590d\u6742\u6027\u548c\u591a\u6837\u6027\uff0c\u6ee1\u8db3\u4e0d\u540c\u73a9\u5bb6\u7684\u559c\u597d\uff0c\u5e76\u4f7f\u6e38\u620f\u66f4\u5177\u5438\u5f15\u529b\u3002"}]
[{"question": "\u5982\u4f55\u6709\u6548\u5730\u5728\u5df4\u723e\u8fea\u7684\u57fa\u790e\u904a\u6232\u4e2d\uff0c\u4f5c\u70ba\u65b0\u624b\uff0c\u5728\u5b78\u6821\u74b0\u5883\u4e2d\u884c\u52d5\uff1f", "answer": "\u5728\u5df4\u723e\u8fea\u7684\u57fa\u790e\u904a\u6232\u4e2d\uff0c\u5728\u5b78\u6821\u884c\u52d5\u9700\u8981\u4e86\u89e3\u5834\u5730\u4f48\u5c40\u548c\u95dc\u9375\u4f4d\u7f6e\u3002\u9996\u5148\uff0c\u719f\u6089\u5730\u5716\uff0c\u5730\u5716\u53ef\u4ee5\u5728\u6821\u9577\u8fa6\u516c\u5ba4\u627e\u5230\u3002\u4f7f\u7528\u8d70\u5eca\u4f86\u7a7f\u68ad\u4e0d\u540c\u623f\u9593\uff0c\u4e26\u4e14\u6642\u523b\u6ce8\u610f\u5df4\u723e\u8fea\uff0c\u5982\u679c\u807d\u5230\u566a\u97f3\uff0c\u4ed6\u5c31\u6703\u8ffd\u8d95\u4f60\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u9910\u5ef3\u807d\u5230\u5df4\u723e\u8fea\u9760\u8fd1\uff0c\u8acb\u8fc5\u901f\u524d\u5f80\u8f03\u5b89\u975c\u7684\u5340\u57df\uff0c\u4f8b\u5982\u5716\u66f8\u9928\u3002\u6b65\u9a5f1\uff1a\u7814\u7a76\u5730\u5716\uff0c\u8fa8\u8b58\u5b89\u5168\u5340\u57df\u3002\u6b65\u9a5f2\uff1a\u898f\u5283\u8def\u7dda\uff0c\u4ee5\u6700\u5927\u7a0b\u5ea6\u5730\u964d\u4f4e\u566a\u97f3\u3002\u6b65\u9a5f3\uff1a\u4f7f\u7528\u50cfBSODA\u6a5f\u5668\u7684\u5e72\u64fe\u4f86\u8f49\u79fb\u5df4\u723e\u8fea\u7684\u6ce8\u610f\u529b\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u5728\u5df4\u723e\u8fea\u7684\u57fa\u790e\u904a\u6232\u4e2d\uff0c\u7ba1\u7406\u7b46\u8a18\u672c\u7684\u4f7f\u7528\u5f88\u91cd\u8981\uff1f\u5982\u4f55\u505a\u5230\uff1f", "answer": "\u7ba1\u7406\u7b46\u8a18\u672c\u7684\u4f7f\u7528\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u4f60\u6536\u96c6\u7684\u6bcf\u4e00\u500b\u7b46\u8a18\u672c\u90fd\u6703\u589e\u52a0\u5df4\u723e\u8fea\u7684\u901f\u5ea6\u3002\u70ba\u4e86\u6700\u4f73\u5316\u4f7f\u7528\uff0c\u512a\u5148\u6536\u96c6\u5c0d\u65bc\u904a\u6232\u9032\u5ea6\u81f3\u95dc\u91cd\u8981\u7684\u7b46\u8a18\u672c\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u4eba\u6d41\u91cf\u5927\u7684\u5340\u57df\u627e\u5230\u7b46\u8a18\u672c\uff0c\u5982\u679c\u5b83\u4e0d\u662f\u5fc5\u8981\u7684\uff0c\u53ef\u4ee5\u8003\u616e\u653e\u68c4\u3002\u6b65\u9a5f1\uff1a\u8b58\u5225\u54ea\u4e9b\u7b46\u8a18\u672c\u5c0d\u65bc\u904a\u6232\u9032\u5ea6\u662f\u5fc5\u8981\u7684\u3002\u6b65\u9a5f2\uff1a\u907f\u514d\u6536\u96c6\u4e0d\u5fc5\u8981\u7684\u7b46\u8a18\u672c\uff0c\u4ee5\u4fdd\u6301\u5df4\u723e\u8fea\u7684\u901f\u5ea6\u5728\u53ef\u63a7\u7bc4\u570d\u5167\u3002\u6b65\u9a5f3\uff1a\u5229\u7528\u74b0\u5883\u512a\u52e2\uff0c\u5728\u6536\u96c6\u7b46\u8a18\u672c\u6642\u88fd\u9020\u566a\u97f3\u5e72\u64fe\u3002"}, {"question": "\u7576\u5df4\u723e\u8fea\u5728\u5df4\u723e\u8fea\u7684\u57fa\u790e\u904a\u6232\u4e2d\u958b\u59cb\u8ffd\u8d95\u4f60\u6642\uff0c\u6700\u597d\u7684\u5c0d\u7b56\u662f\u4ec0\u9ebc\uff1f", "answer": "\u7576\u5df4\u723e\u8fea\u958b\u59cb\u8ffd\u8d95\u4f60\u6642\uff0c\u6700\u597d\u7684\u7b56\u7565\u662f\u4fdd\u6301\u51b7\u975c\uff0c\u4e26\u5229\u7528\u74b0\u5883\u512a\u52e2\u3002\u5c0b\u627e\u50cfBSODA\u6a5f\u5668\u6216\u6821\u9577\u54e8\u5b50\u4e4b\u985e\u7684\u7269\u54c1\u4f86\u8f49\u79fb\u4ed6\u7684\u6ce8\u610f\u529b\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u9760\u8fd1BSODA\u6a5f\u5668\uff0c\u4f7f\u7528\u5b83\u88fd\u9020\u5de8\u5927\u7684\u566a\u97f3\u4f86\u8f49\u79fb\u5df4\u723e\u8fea\u7684\u6ce8\u610f\u529b\u3002\u6b65\u9a5f1\uff1a\u627e\u51fa\u9644\u8fd1\u7684\u5e72\u64fe\u7269\u54c1\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u7269\u54c1\u88fd\u9020\u566a\u97f3\u5e72\u64fe\u3002\u6b65\u9a5f3\uff1a\u5728\u5df4\u723e\u8fea\u5206\u5fc3\u4e4b\u969b\u8fc5\u901f\u79fb\u52d5\u5230\u5b89\u5168\u5340\u57df\u3002"}, {"question": "\u5982\u4f55\u5728\u5df4\u723e\u8fea\u7684\u57fa\u790e\u904a\u6232\u4e2d\u6709\u6548\u7387\u5730\u898f\u5283\u8def\u7dda\uff0c\u4ee5\u6536\u96c6\u6240\u6709\u7b46\u8a18\u672c\uff1f", "answer": "\u512a\u5316\u8def\u7dda\u4ee5\u6536\u96c6\u6240\u6709\u7b46\u8a18\u672c\uff0c\u9700\u8981\u898f\u5283\u548c\u4e86\u89e3\u5b78\u6821\u7684\u4f48\u5c40\u3002\u9996\u5148\uff0c\u4ed4\u7d30\u7814\u7a76\u5730\u5716\uff0c\u8fa8\u8b58\u6240\u6709\u7b46\u8a18\u672c\u7684\u4f4d\u7f6e\u3002\u7136\u5f8c\uff0c\u898f\u5283\u4e00\u689d\u80fd\u6700\u5927\u9650\u5ea6\u5730\u6e1b\u5c11\u53cd\u8986\u8def\u7a0b\u548c\u566a\u97f3\u7684\u8def\u7dda\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u77e5\u9053\u7b46\u8a18\u672c\u5728\u9ad4\u80b2\u9928\uff0c\u8a08\u5283\u5728\u53c3\u89c0\u9644\u8fd1\u7684\u5340\u57df\uff0c\u4f8b\u5982\u81ea\u52a9\u9910\u5ef3\u5f8c\uff0c\u518d\u6536\u96c6\u5b83\u3002\u6b65\u9a5f1\uff1a\u7814\u7a76\u5730\u5716\uff0c\u627e\u51fa\u6240\u6709\u7b46\u8a18\u672c\u7684\u4f4d\u7f6e\u3002\u6b65\u9a5f2\uff1a\u898f\u5283\u4e00\u689d\u80fd\u6700\u5927\u9650\u5ea6\u5730\u6e1b\u5c11\u566a\u97f3\u548c\u53cd\u8986\u8def\u7a0b\u7684\u8def\u7dda\u3002\u6b65\u9a5f3\uff1a\u5728\u6536\u96c6\u7b46\u8a18\u672c\u6642\uff0c\u5229\u7528\u5e72\u64fe\u4f86\u8f49\u79fb\u5df4\u723e\u8fea\u7684\u6ce8\u610f\u529b\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u6821\u9577\u54e8\u5b50\u5728\u5df4\u723e\u8fea\u7684\u57fa\u790e\u904a\u6232\u4e2d\u662f\u4e00\u500b\u91cd\u8981\u7684\u7269\u54c1\uff0c\u6211\u61c9\u8a72\u5982\u4f55\u4f7f\u7528\u5b83\uff1f", "answer": "\u6821\u9577\u54e8\u5b50\u662f\u4e00\u500b\u91cd\u8981\u7684\u7269\u54c1\uff0c\u56e0\u70ba\u5b83\u53ef\u4ee5\u66ab\u6642\u95dc\u9589\u5df4\u723e\u8fea\u7684\u807d\u529b\uff0c\u8b93\u4f60\u53ef\u4ee5\u81ea\u7531\u79fb\u52d5\uff0c\u800c\u4e0d\u6703\u88ab\u8ffd\u8d95\u3002\u70ba\u4e86\u6709\u6548\u4f7f\u7528\u5b83\uff0c\u7b49\u5230\u5df4\u723e\u8fea\u9760\u8fd1\u6642\uff0c\u7136\u5f8c\u555f\u52d5\u54e8\u5b50\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u72f9\u7a84\u7684\u8d70\u5eca\u88e1\uff0c\u800c\u5df4\u723e\u8fea\u6b63\u9760\u8fd1\uff0c\u4f7f\u7528\u54e8\u5b50\u66ab\u6642\u95dc\u9589\u4ed6\u7684\u807d\u529b\uff0c\u5feb\u901f\u79fb\u52d5\u5230\u66f4\u5b89\u5168\u7684\u5340\u57df\u3002\u6b65\u9a5f1\uff1a\u7b49\u5f85\u5df4\u723e\u8fea\u9760\u8fd1\u3002\u6b65\u9a5f2\uff1a\u555f\u52d5\u6821\u9577\u54e8\u5b50\u3002\u6b65\u9a5f3\uff1a\u5728\u5df4\u723e\u8fea\u88ab\u66ab\u6642\u95dc\u9589\u807d\u529b\u6642\uff0c\u79fb\u52d5\u5230\u5b89\u5168\u5340\u57df\u3002"}, {"question": "\u5df4\u723e\u8fea\u5728\u5df4\u723e\u8fea\u7684\u57fa\u790e\u904a\u6232\u4e2d\uff0c\u901f\u5ea6\u589e\u52a0\u80cc\u5f8c\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f\u6211\u5982\u4f55\u53cd\u5236\uff1f", "answer": "\u5df4\u723e\u8fea\u7684\u901f\u5ea6\u6703\u96a8\u8457\u4f60\u6536\u96c6\u7684\u6bcf\u500b\u7b46\u8a18\u672c\u800c\u589e\u52a0\uff0c\u96a8\u8457\u904a\u6232\u9032\u5c55\uff0c\u9003\u812b\u4ed6\u6703\u8b8a\u5f97\u8d8a\u4f86\u8d8a\u56f0\u96e3\u3002\u70ba\u4e86\u53cd\u5236\u9019\u4e00\u9ede\uff0c\u5c08\u6ce8\u65bc\u53ea\u6536\u96c6\u5fc5\u8981\u7684\u7b46\u8a18\u672c\uff0c\u4e26\u5229\u7528\u5e72\u64fe\u4f86\u6e1b\u7de9\u4ed6\u7684\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u6536\u96c6\u4e86\u4e09\u500b\u7b46\u8a18\u672c\uff0c\u800c\u5df4\u723e\u8fea\u7684\u901f\u5ea6\u6b63\u5728\u589e\u52a0\uff0c\u4f7f\u7528BSODA\u6a5f\u5668\u88fd\u9020\u5de8\u5927\u7684\u566a\u97f3\uff0c\u8f49\u79fb\u4ed6\u7684\u6ce8\u610f\u529b\u3002\u6b65\u9a5f1\uff1a\u9650\u5236\u4f60\u6536\u96c6\u7684\u7b46\u8a18\u672c\u6578\u91cf\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u5e72\u64fe\u4f86\u6e1b\u7de9\u5df4\u723e\u8fea\u7684\u901f\u5ea6\u3002\u6b65\u9a5f3\uff1a\u898f\u5283\u4f60\u7684\u8def\u7dda\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u6e1b\u5c11\u566a\u97f3\u4e26\u6700\u5927\u5316\u6548\u7387\u3002"}, {"question": "\u5728\u5df4\u723e\u8fea\u7684\u57fa\u790e\u904a\u6232\u4e2d\uff0c\u566a\u97f3\u6a5f\u5236\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u4ee5\u53ca\u6700\u597d\u7684\u7ba1\u7406\u65b9\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5df4\u723e\u8fea\u7684\u57fa\u790e\u904a\u6232\u4e2d\u7684\u566a\u97f3\u6a5f\u5236\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5df4\u723e\u8fea\u5982\u679c\u807d\u5230\u566a\u97f3\u5c31\u6703\u8ffd\u8d95\u4f60\u3002\u70ba\u4e86\u7ba1\u7406\u5b83\uff0c\u9664\u975e\u5fc5\u8981\uff0c\u5426\u5247\u907f\u514d\u5954\u8dd1\u6216\u88fd\u9020\u566a\u97f3\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u5716\u66f8\u9928\u88e1\uff0c\u8acb\u5b89\u975c\u5730\u8d70\u52d5\uff0c\u4ee5\u907f\u514d\u5438\u5f15\u5df4\u723e\u8fea\u7684\u6ce8\u610f\u3002\u7576\u9700\u8981\u6642\uff0c\u4f7f\u7528\u50cfBSODA\u6a5f\u5668\u6216\u6821\u9577\u54e8\u5b50\u4e4b\u985e\u7684\u7269\u54c1\u4f86\u5275\u9020\u5e72\u64fe\u3002\u6b65\u9a5f1\uff1a\u5b89\u975c\u5730\u6b65\u884c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u6e1b\u5c11\u566a\u97f3\u3002\u6b65\u9a5f2\uff1a\u7b56\u7565\u6027\u5730\u4f7f\u7528\u5e72\u64fe\u7269\u54c1\u3002\u6b65\u9a5f3\uff1a\u898f\u5283\u4f60\u7684\u52d5\u4f5c\uff0c\u907f\u514d\u9ad8\u566a\u97f3\u5340\u57df\u3002"}, {"question": "\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e0a\u904a\u73a9\u5df4\u723e\u8fea\u7684\u57fa\u790e\u904a\u6232\u6642\uff0c\u53ef\u80fd\u6703\u51fa\u73fe\u54ea\u4e9b\u76f8\u5bb9\u6027\u554f\u984c\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u6c7a\uff1f", "answer": "\u5728\u5df4\u723e\u8fea\u7684\u57fa\u790e\u904a\u6232\u4e2d\uff0c\u5728\u4e0d\u540c\u5e73\u53f0\uff08\u4f8b\u5982PC\u548c\u624b\u6a5f\uff09\u4e4b\u9593\u5207\u63db\u6642\uff0c\u53ef\u80fd\u6703\u51fa\u73fe\u76f8\u5bb9\u6027\u554f\u984c\u3002\u70ba\u4e86\u89e3\u6c7a\u9019\u4e9b\u554f\u984c\uff0c\u8acb\u78ba\u4fdd\u4f60\u7684\u904a\u6232\u5df2\u66f4\u65b0\u5230\u6700\u65b0\u7248\u672c\uff0c\u4e26\u4e14\u4f60\u7684\u8a2d\u5099\u7b26\u5408\u6700\u4f4e\u7cfb\u7d71\u9700\u6c42\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u7684\u624b\u6a5f\u8a2d\u5099\u51fa\u73fe\u5ef6\u9072\uff0c\u5617\u8a66\u964d\u4f4e\u5716\u5f62\u8a2d\u5b9a\u4ee5\u6539\u5584\u6548\u80fd\u3002\u6b65\u9a5f1\uff1a\u6aa2\u67e5\u4e26\u5b89\u88dd\u66f4\u65b0\u3002\u6b65\u9a5f2\uff1a\u9a57\u8b49\u4f60\u7684\u8a2d\u5099\u7b26\u5408\u7cfb\u7d71\u9700\u6c42\u3002\u6b65\u9a5f3\uff1a\u8abf\u6574\u8a2d\u5b9a\u4ee5\u6700\u4f73\u5316\u6548\u80fd\u3002"}, {"question": "\u5728\u5df4\u723e\u8fea\u7684\u57fa\u790e\u904a\u6232\u4e2d\uff0c\u6211\u53ef\u4ee5\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u5167\u5bb9\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9396\uff1f", "answer": "\u5df4\u723e\u8fea\u7684\u57fa\u790e\u904a\u6232\u5305\u542b\u96b1\u85cf\u5167\u5bb9\uff0c\u901a\u904e\u5fb9\u5e95\u63a2\u7d22\u904a\u6232\u53ef\u4ee5\u89e3\u9396\u3002\u4f8b\u5982\uff0c\u5b58\u5728\u53ef\u4ee5\u900f\u904e\u89e3\u8b0e\u6216\u627e\u5230\u96b1\u85cf\u958b\u95dc\u4f86\u9032\u5165\u7684\u79d8\u5bc6\u623f\u9593\u3002\u5176\u4e2d\u4e00\u500b\u623f\u9593\u662f\u5df4\u723e\u8fea\u7684\u8fa6\u516c\u5ba4\uff0c\u5b83\u53ef\u4ee5\u900f\u904e\u6536\u96c6\u6240\u6709\u7b46\u8a18\u672c\u4e26\u89e3\u958b\u7279\u5b9a\u8b0e\u984c\u4f86\u89e3\u9396\u3002\u6b65\u9a5f1\uff1a\u5fb9\u5e95\u63a2\u7d22\u5b78\u6821\uff0c\u5c0b\u627e\u96b1\u85cf\u7684\u958b\u95dc\u3002\u6b65\u9a5f2\uff1a\u89e3\u958b\u8b0e\u984c\uff0c\u4ee5\u89e3\u9396\u79d8\u5bc6\u623f\u9593\u3002\u6b65\u9a5f3\uff1a\u6536\u96c6\u6240\u6709\u7b46\u8a18\u672c\u624d\u80fd\u8a2a\u554f\u7279\u6b8a\u5167\u5bb9\u3002"}, {"question": "\u5728\u5df4\u723e\u8fea\u7684\u57fa\u790e\u904a\u6232\u4e2d\uff0c\u54ea\u4e9b\u7269\u54c1\u6700\u9069\u5408\u751f\u5b58\uff0c\u4ee5\u53ca\u61c9\u8a72\u5982\u4f55\u512a\u5148\u8003\u616e\uff1f", "answer": "\u5728\u5df4\u723e\u8fea\u7684\u57fa\u790e\u904a\u6232\u4e2d\uff0c\u6700\u9069\u5408\u751f\u5b58\u7684\u7269\u54c1\u5305\u62ec\u6821\u9577\u54e8\u5b50\u3001BSODA\u6a5f\u5668\u548c\u80fd\u91cf\u68d2\u3002\u6839\u64da\u4f60\u7684\u7576\u524d\u60c5\u6cc1\u512a\u5148\u8003\u616e\u9019\u4e9b\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5df4\u723e\u8fea\u5728\u8ffd\u8d95\u4f60\uff0c\u4f7f\u7528\u6821\u9577\u54e8\u5b50\u66ab\u6642\u95dc\u9589\u4ed6\u7684\u807d\u529b\u3002\u5982\u679c\u4f60\u9ad4\u529b\u4e0d\u8db3\uff0c\u512a\u5148\u4f7f\u7528\u80fd\u91cf\u68d2\u88dc\u5145\u4f60\u7684\u9ad4\u529b\u3002\u6b65\u9a5f1\uff1a\u8b58\u5225\u54ea\u4e9b\u7269\u54c1\u6700\u9069\u5408\u4f60\u76ee\u524d\u7684\u60c5\u6cc1\u3002\u6b65\u9a5f2\uff1a\u512a\u5148\u8003\u616e\u53ef\u5e6b\u52a9\u4f60\u9003\u812b\u6216\u5e72\u64fe\u5df4\u723e\u8fea\u7684\u7269\u54c1\u3002\u6b65\u9a5f3\uff1a\u7b56\u7565\u6027\u5730\u4f7f\u7528\u7269\u54c1\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u767c\u63ee\u5176\u6548\u7528\u3002"}]
[{"question": "\u5982\u4f55\u6709\u6548\u5730\u4f5c\u4e3a\u521d\u5b66\u8005\u5728\u5df4\u5c14\u8fea\u7684\u57fa\u7840\u77e5\u8bc6\u6e38\u620f\u4e2d\u638c\u63a7\u5b66\u6821\u73af\u5883\uff1f", "answer": "\u8981\u5728\u5df4\u5c14\u8fea\u7684\u57fa\u7840\u77e5\u8bc6\u6e38\u620f\u4e2d\u638c\u63a7\u5b66\u6821\uff0c\u4f60\u9700\u8981\u4e86\u89e3\u5e03\u5c40\u548c\u5173\u952e\u4f4d\u7f6e\u3002\u9996\u5148\u719f\u6089\u5730\u56fe\uff0c\u5730\u56fe\u53ef\u4ee5\u5728\u6821\u957f\u529e\u516c\u5ba4\u627e\u5230\u3002\u4f7f\u7528\u8d70\u5eca\u5728\u623f\u95f4\u4e4b\u95f4\u79fb\u52a8\uff0c\u5e76\u4e14\u65f6\u523b\u7559\u610f\u5df4\u5c14\u8fea\uff0c\u56e0\u4e3a\u5982\u679c\u4ed6\u542c\u5230\u566a\u97f3\uff0c\u4ed6\u5c31\u4f1a\u8ffd\u4f60\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u81ea\u52a9\u9910\u5385\u542c\u5230\u5df4\u5c14\u8fea\u9760\u8fd1\uff0c\u5219\u5feb\u901f\u79fb\u52a8\u5230\u66f4\u5b89\u9759\u7684\u5730\u65b9\uff0c\u4f8b\u5982\u56fe\u4e66\u9986\u3002\u6b65\u9aa4\u4e00\uff1a\u7814\u7a76\u5730\u56fe\uff0c\u627e\u51fa\u5b89\u5168\u533a\u57df\u3002\u6b65\u9aa4\u4e8c\uff1a\u89c4\u5212\u4f60\u7684\u8def\u7ebf\uff0c\u5c3d\u91cf\u51cf\u5c11\u566a\u97f3\u3002\u6b65\u9aa4\u4e09\uff1a\u5229\u7528BSODA\u673a\u5668\u7b49\u5e72\u6270\u7269\u8f6c\u79fb\u5df4\u5c14\u8fea\u7684\u6ce8\u610f\u529b\u3002"}, {"question": "\u5728\u5df4\u5c14\u8fea\u7684\u57fa\u7840\u77e5\u8bc6\u6e38\u620f\u4e2d\uff0c\u4e3a\u4ec0\u4e48\u7ba1\u7406\u6211\u7684\u7b14\u8bb0\u672c\u4f7f\u7528\u5f88\u91cd\u8981\uff0c\u6211\u8be5\u5982\u4f55\u505a\u5230\uff1f", "answer": "\u7ba1\u7406\u4f60\u7684\u7b14\u8bb0\u672c\u4f7f\u7528\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u6bcf\u6536\u96c6\u4e00\u4e2a\u7b14\u8bb0\u672c\uff0c\u5df4\u5c14\u8fea\u7684\u901f\u5ea6\u5c31\u4f1a\u52a0\u5feb\u3002\u4e3a\u4e86\u4f18\u5316\u4f60\u7684\u4f7f\u7528\uff0c\u4f18\u5148\u6536\u96c6\u5bf9\u6e38\u620f\u8fdb\u7a0b\u81f3\u5173\u91cd\u8981\u7684\u7b14\u8bb0\u672c\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u4eba\u6d41\u91cf\u5927\u7684\u533a\u57df\u53d1\u73b0\u4e00\u4e2a\u7b14\u8bb0\u672c\uff0c\u5982\u679c\u5b83\u4e0d\u662f\u5fc5\u9700\u7684\uff0c\u53ef\u4ee5\u8003\u8651\u653e\u5f03\u3002\u6b65\u9aa4\u4e00\uff1a\u786e\u5b9a\u54ea\u4e9b\u7b14\u8bb0\u672c\u5bf9\u4e8e\u6e38\u620f\u8fdb\u5ea6\u662f\u5fc5\u987b\u7684\u3002\u6b65\u9aa4\u4e8c\uff1a\u907f\u514d\u6536\u96c6\u4e0d\u5fc5\u8981\u7684\u7b14\u8bb0\u672c\uff0c\u4ee5\u63a7\u5236\u5df4\u5c14\u8fea\u7684\u901f\u5ea6\u3002\u6b65\u9aa4\u4e09\uff1a\u5229\u7528\u73af\u5883\u4f18\u52bf\uff0c\u5728\u6536\u96c6\u7b14\u8bb0\u672c\u65f6\u5236\u9020\u566a\u97f3\u5e72\u6270\u3002"}, {"question": "\u5f53\u5df4\u5c14\u8fea\u5728\u5df4\u5c14\u8fea\u7684\u57fa\u7840\u77e5\u8bc6\u6e38\u620f\u4e2d\u5f00\u59cb\u8ffd\u8d76\u4f60\u65f6\uff0c\u6700\u597d\u7684\u5e94\u5bf9\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5f53\u5df4\u5c14\u8fea\u5f00\u59cb\u8ffd\u8d76\u4f60\u65f6\uff0c\u6700\u597d\u7684\u7b56\u7565\u662f\u4fdd\u6301\u51b7\u9759\uff0c\u5e76\u5229\u7528\u73af\u5883\u4f18\u52bf\u3002\u5bfb\u627e\u8bf8\u5982BSODA\u673a\u5668\u6216\u6821\u957f\u53e3\u54e8\u7b49\u7269\u54c1\u6765\u8f6c\u79fb\u4ed6\u7684\u6ce8\u610f\u529b\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u9760\u8fd1BSODA\u673a\u5668\uff0c\u4f7f\u7528\u5b83\u5236\u9020\u5de8\u5927\u7684\u566a\u97f3\u6765\u8f6c\u79fb\u5df4\u5c14\u8fea\u7684\u6ce8\u610f\u529b\u3002\u6b65\u9aa4\u4e00\uff1a\u627e\u51fa\u9644\u8fd1\u7684\u5e72\u6270\u7269\u54c1\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u8fd9\u4e9b\u7269\u54c1\u5236\u9020\u566a\u97f3\u5e72\u6270\u3002\u6b65\u9aa4\u4e09\uff1a\u5728\u5df4\u5c14\u8fea\u5206\u5fc3\u7684\u65f6\u5019\u8fc5\u901f\u8f6c\u79fb\u5230\u5b89\u5168\u533a\u57df\u3002"}, {"question": "\u5982\u4f55\u5728\u5df4\u5c14\u8fea\u7684\u57fa\u7840\u77e5\u8bc6\u6e38\u620f\u4e2d\u6709\u6548\u5730\u4f18\u5316\u8def\u7ebf\uff0c\u4ee5\u9ad8\u6548\u5730\u6536\u96c6\u6240\u6709\u7b14\u8bb0\u672c\uff1f", "answer": "\u4f18\u5316\u4f60\u7684\u8def\u7ebf\uff0c\u4ee5\u6709\u6548\u5730\u6536\u96c6\u6240\u6709\u7b14\u8bb0\u672c\uff0c\u9700\u8981\u89c4\u5212\u548c\u4e86\u89e3\u5b66\u6821\u7684\u5e03\u5c40\u3002\u9996\u5148\u7814\u7a76\u5730\u56fe\uff0c\u627e\u51fa\u6240\u6709\u7b14\u8bb0\u672c\u7684\u4f4d\u7f6e\u3002\u7136\u540e\uff0c\u89c4\u5212\u4e00\u6761\u5c3d\u91cf\u51cf\u5c11\u5f80\u8fd4\u548c\u566a\u97f3\u7684\u8def\u7ebf\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u77e5\u9053\u4e00\u4e2a\u7b14\u8bb0\u672c\u5728\u4f53\u80b2\u9986\uff0c\u8ba1\u5212\u5728\u53c2\u89c2\u9644\u8fd1\u7684\u81ea\u52a9\u9910\u5385\u7b49\u533a\u57df\u540e\u518d\u53bb\u6536\u96c6\u5b83\u3002\u6b65\u9aa4\u4e00\uff1a\u7814\u7a76\u5730\u56fe\uff0c\u627e\u5230\u6240\u6709\u7b14\u8bb0\u672c\u7684\u4f4d\u7f6e\u3002\u6b65\u9aa4\u4e8c\uff1a\u89c4\u5212\u4e00\u6761\u5c3d\u91cf\u51cf\u5c11\u566a\u97f3\u548c\u5f80\u8fd4\u7684\u8def\u7ebf\u3002\u6b65\u9aa4\u4e09\uff1a\u5229\u7528\u5e72\u6270\u7269\u8f6c\u79fb\u5df4\u5c14\u8fea\u7684\u6ce8\u610f\u529b\uff0c\u4ee5\u65b9\u4fbf\u6536\u96c6\u7b14\u8bb0\u672c\u3002"}, {"question": "\u5728\u5df4\u5c14\u8fea\u7684\u57fa\u7840\u77e5\u8bc6\u6e38\u620f\u4e2d\uff0c\u4e3a\u4ec0\u4e48\u6821\u957f\u53e3\u54e8\u662f\u4e00\u4e2a\u5173\u952e\u9053\u5177\uff0c\u6211\u5e94\u8be5\u5982\u4f55\u4f7f\u7528\u5b83\uff1f", "answer": "\u6821\u957f\u53e3\u54e8\u662f\u4e00\u4e2a\u5173\u952e\u9053\u5177\uff0c\u56e0\u4e3a\u5b83\u53ef\u4ee5\u6682\u65f6\u5c4f\u853d\u5df4\u5c14\u8fea\u7684\u542c\u529b\uff0c\u8ba9\u4f60\u5728\u4e0d\u88ab\u8ffd\u8d76\u7684\u60c5\u51b5\u4e0b\u81ea\u7531\u79fb\u52a8\u3002\u4e3a\u4e86\u6709\u6548\u5730\u4f7f\u7528\u5b83\uff0c\u7b49\u5230\u5df4\u5c14\u8fea\u63a5\u8fd1\u65f6\uff0c\u518d\u5439\u54cd\u53e3\u54e8\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4eec\u5728\u72ed\u7a84\u7684\u8d70\u5eca\u91cc\uff0c\u5df4\u5c14\u8fea\u6b63\u5728\u9760\u8fd1\uff0c\u4f7f\u7528\u53e3\u54e8\u6765\u5c4f\u853d\u4ed6\u7684\u542c\u529b\uff0c\u5e76\u8fc5\u901f\u79fb\u52a8\u5230\u4e00\u4e2a\u66f4\u5b89\u5168\u7684\u5730\u65b9\u3002\u6b65\u9aa4\u4e00\uff1a\u7b49\u5f85\u5df4\u5c14\u8fea\u9760\u8fd1\u3002\u6b65\u9aa4\u4e8c\uff1a\u5439\u54cd\u6821\u957f\u53e3\u54e8\u3002\u6b65\u9aa4\u4e09\uff1a\u5728\u5df4\u5c14\u8fea\u88ab\u5c4f\u853d\u65f6\u79fb\u52a8\u5230\u5b89\u5168\u533a\u57df\u3002"}, {"question": "\u5728\u5df4\u5c14\u8fea\u7684\u57fa\u7840\u77e5\u8bc6\u6e38\u620f\u4e2d\uff0c\u5df4\u5c14\u8fea\u901f\u5ea6\u589e\u52a0\u7684\u673a\u5236\u662f\u4ec0\u4e48\uff0c\u6211\u8be5\u5982\u4f55\u53cd\u5236\uff1f", "answer": "\u5df4\u5c14\u8fea\u7684\u901f\u5ea6\u4f1a\u968f\u7740\u4f60\u6536\u96c6\u7684\u6bcf\u4e2a\u7b14\u8bb0\u672c\u800c\u589e\u52a0\uff0c\u968f\u7740\u6e38\u620f\u7684\u8fdb\u884c\uff0c\u9003\u8131\u4ed6\u53d8\u5f97\u8d8a\u6765\u8d8a\u96be\u3002\u4e3a\u4e86\u53cd\u5236\u8fd9\u4e00\u70b9\uff0c\u4e13\u6ce8\u4e8e\u53ea\u6536\u96c6\u5fc5\u8981\u7684\u7b14\u8bb0\u672c\uff0c\u5e76\u4f7f\u7528\u5e72\u6270\u7269\u6765\u51cf\u6162\u4ed6\u7684\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u6536\u96c6\u4e86\u4e09\u4e2a\u7b14\u8bb0\u672c\uff0c\u800c\u5df4\u5c14\u8fea\u7684\u901f\u5ea6\u52a0\u5feb\u4e86\uff0c\u4f7f\u7528BSODA\u673a\u5668\u5236\u9020\u5de8\u5927\u7684\u566a\u97f3\uff0c\u8f6c\u79fb\u4ed6\u7684\u6ce8\u610f\u529b\u3002\u6b65\u9aa4\u4e00\uff1a\u9650\u5236\u4f60\u6536\u96c6\u7684\u7b14\u8bb0\u672c\u6570\u91cf\u3002\u6b65\u9aa4\u4e8c\uff1a\u5229\u7528\u5e72\u6270\u7269\u51cf\u6162\u5df4\u5c14\u8fea\u7684\u901f\u5ea6\u3002\u6b65\u9aa4\u4e09\uff1a\u89c4\u5212\u4f60\u7684\u8def\u7ebf\uff0c\u5c3d\u91cf\u51cf\u5c11\u566a\u97f3\uff0c\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u6548\u7387\u3002"}, {"question": "\u5728\u5df4\u5c14\u8fea\u7684\u57fa\u7840\u77e5\u8bc6\u6e38\u620f\u4e2d\uff0c\u566a\u97f3\u673a\u5236\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u6700\u597d\u7684\u7ba1\u7406\u65b9\u6cd5\u662f\u4ec0\u4e48\uff1f", "answer": "\u5df4\u5c14\u8fea\u7684\u57fa\u7840\u77e5\u8bc6\u6e38\u620f\u4e2d\u7684\u566a\u97f3\u673a\u5236\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5982\u679c\u5df4\u5c14\u8fea\u542c\u5230\u566a\u97f3\uff0c\u4ed6\u5c31\u4f1a\u8ffd\u4f60\u3002\u4e3a\u4e86\u7ba1\u7406\u5b83\uff0c\u5c3d\u91cf\u907f\u514d\u8dd1\u6b65\u6216\u53d1\u51fa\u5927\u58f0\u566a\u97f3\uff0c\u9664\u975e\u5fc5\u8981\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u56fe\u4e66\u9986\uff0c\u8d70\u8def\u65f6\u8bf7\u4fdd\u6301\u5b89\u9759\uff0c\u4ee5\u907f\u514d\u5438\u5f15\u5df4\u5c14\u8fea\u3002\u5fc5\u8981\u65f6\uff0c\u4f7f\u7528BSODA\u673a\u5668\u6216\u6821\u957f\u53e3\u54e8\u7b49\u7269\u54c1\u5236\u9020\u5e72\u6270\u3002\u6b65\u9aa4\u4e00\uff1a\u8d70\u8def\u65f6\u4fdd\u6301\u5b89\u9759\uff0c\u5c3d\u91cf\u51cf\u5c11\u566a\u97f3\u3002\u6b65\u9aa4\u4e8c\uff1a\u6218\u7565\u6027\u5730\u4f7f\u7528\u5e72\u6270\u7269\u54c1\u3002\u6b65\u9aa4\u4e09\uff1a\u89c4\u5212\u4f60\u7684\u884c\u52a8\uff0c\u907f\u514d\u566a\u97f3\u8f83\u5927\u7684\u533a\u57df\u3002"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u73a9\u5df4\u5c14\u8fea\u7684\u57fa\u7840\u77e5\u8bc6\u6e38\u620f\u65f6\uff0c\u4f1a\u51fa\u73b0\u54ea\u4e9b\u517c\u5bb9\u6027\u95ee\u9898\uff0c\u6211\u8be5\u5982\u4f55\u89e3\u51b3\uff1f", "answer": "\u5728\u5df4\u5c14\u8fea\u7684\u57fa\u7840\u77e5\u8bc6\u6e38\u620f\u4e2d\uff0c\u5728PC\u548c\u79fb\u52a8\u8bbe\u5907\u7b49\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u5207\u6362\u65f6\uff0c\u53ef\u80fd\u4f1a\u51fa\u73b0\u517c\u5bb9\u6027\u95ee\u9898\u3002\u4e3a\u4e86\u89e3\u51b3\u8fd9\u4e9b\u95ee\u9898\uff0c\u8bf7\u786e\u4fdd\u4f60\u7684\u6e38\u620f\u66f4\u65b0\u5230\u6700\u65b0\u7248\u672c\uff0c\u5e76\u4e14\u4f60\u7684\u8bbe\u5907\u7b26\u5408\u6700\u4f4e\u7cfb\u7edf\u8981\u6c42\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\u9047\u5230\u5ef6\u8fdf\uff0c\u8bf7\u5c1d\u8bd5\u964d\u4f4e\u56fe\u5f62\u8bbe\u7f6e\u4ee5\u63d0\u9ad8\u6027\u80fd\u3002\u6b65\u9aa4\u4e00\uff1a\u68c0\u67e5\u5e76\u5b89\u88c5\u66f4\u65b0\u3002\u6b65\u9aa4\u4e8c\uff1a\u9a8c\u8bc1\u4f60\u7684\u8bbe\u5907\u662f\u5426\u7b26\u5408\u7cfb\u7edf\u8981\u6c42\u3002\u6b65\u9aa4\u4e09\uff1a\u8c03\u6574\u8bbe\u7f6e\u4ee5\u4f18\u5316\u6027\u80fd\u3002"}, {"question": "\u5728\u5df4\u5c14\u8fea\u7684\u57fa\u7840\u77e5\u8bc6\u6e38\u620f\u4e2d\uff0c\u6211\u53ef\u4ee5\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u5185\u5bb9\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9501\uff1f", "answer": "\u5df4\u5c14\u8fea\u7684\u57fa\u7840\u77e5\u8bc6\u5305\u542b\u9690\u85cf\u5185\u5bb9\uff0c\u53ef\u4ee5\u901a\u8fc7\u5f7b\u5e95\u63a2\u7d22\u6e38\u620f\u6765\u89e3\u9501\u3002\u4f8b\u5982\uff0c\u53ef\u4ee5\u901a\u8fc7\u89e3\u8c1c\u6216\u627e\u5230\u9690\u85cf\u5f00\u5173\u6765\u8bbf\u95ee\u79d8\u5bc6\u623f\u95f4\u3002\u5176\u4e2d\u4e00\u4e2a\u8fd9\u6837\u7684\u623f\u95f4\u662f\u5df4\u5c14\u8fea\u7684\u529e\u516c\u5ba4\uff0c\u53ef\u4ee5\u901a\u8fc7\u6536\u96c6\u6240\u6709\u7b14\u8bb0\u672c\u5e76\u89e3\u51b3\u7279\u5b9a\u8c1c\u9898\u6765\u89e3\u9501\u3002\u6b65\u9aa4\u4e00\uff1a\u5f7b\u5e95\u63a2\u7d22\u5b66\u6821\uff0c\u5bfb\u627e\u9690\u85cf\u7684\u5f00\u5173\u3002\u6b65\u9aa4\u4e8c\uff1a\u89e3\u51b3\u8c1c\u9898\uff0c\u89e3\u9501\u79d8\u5bc6\u623f\u95f4\u3002\u6b65\u9aa4\u4e09\uff1a\u6536\u96c6\u6240\u6709\u7b14\u8bb0\u672c\uff0c\u4ee5\u8bbf\u95ee\u7279\u6b8a\u5185\u5bb9\u3002"}, {"question": "\u5728\u5df4\u5c14\u8fea\u7684\u57fa\u7840\u77e5\u8bc6\u6e38\u620f\u4e2d\uff0c\u54ea\u4e9b\u7269\u54c1\u5bf9\u751f\u5b58\u6700\u6709\u7528\uff0c\u6211\u5e94\u8be5\u5982\u4f55\u4f18\u5148\u8003\u8651\uff1f", "answer": "\u5728\u5df4\u5c14\u8fea\u7684\u57fa\u7840\u77e5\u8bc6\u6e38\u620f\u4e2d\uff0c\u5bf9\u751f\u5b58\u6700\u6709\u7528\u7684\u7269\u54c1\u5305\u62ec\u6821\u957f\u53e3\u54e8\u3001BSODA\u673a\u5668\u548c\u80fd\u91cf\u68d2\u3002\u6839\u636e\u4f60\u7684\u5f53\u524d\u60c5\u51b5\u4f18\u5148\u8003\u8651\u8fd9\u4e9b\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5df4\u5c14\u8fea\u6b63\u5728\u8ffd\u8d76\u4f60\uff0c\u8bf7\u4f7f\u7528\u6821\u957f\u53e3\u54e8\u6765\u5c4f\u853d\u4ed6\u7684\u542c\u529b\u3002\u5982\u679c\u4f60\u4f53\u529b\u4e0d\u8db3\uff0c\u8bf7\u4f18\u5148\u4f7f\u7528\u80fd\u91cf\u68d2\u6765\u6062\u590d\u8010\u529b\u3002\u6b65\u9aa4\u4e00\uff1a\u8bc6\u522b\u5728\u5f53\u524d\u60c5\u51b5\u4e0b\u54ea\u4e9b\u7269\u54c1\u6700\u6709\u7528\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f18\u5148\u8003\u8651\u90a3\u4e9b\u53ef\u4ee5\u5e2e\u52a9\u4f60\u9003\u8131\u6216\u8f6c\u79fb\u5df4\u5c14\u8fea\u6ce8\u610f\u529b\u7684\u7269\u54c1\u3002\u6b65\u9aa4\u4e09\uff1a\u6218\u7565\u6027\u5730\u4f7f\u7528\u7269\u54c1\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u53d1\u6325\u5176\u6548\u7528\u3002"}]
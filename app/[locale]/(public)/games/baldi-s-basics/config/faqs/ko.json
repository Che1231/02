[{"question": "\ubc1c\ub514\uc758 \uae30\ubcf8\uc5d0\uc11c \ucd08\ubcf4\uc790\ub85c\uc11c \ud559\uad50 \ud658\uacbd\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \ud0d0\uc0c9\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubc1c\ub514\uc758 \uae30\ubcf8\uc5d0\uc11c \ud559\uad50\ub97c \ud0d0\uc0c9\ud558\ub824\uba74 \ubc30\uce58\uc640 \uc8fc\uc694 \uc7a5\uc18c\ub97c \uc774\ud574\ud574\uc57c \ud569\ub2c8\ub2e4. \ucc98\uc74c\uc73c\ub85c \uad50\uc7a5\uc2e4\uc5d0 \uc788\ub294 \uc9c0\ub3c4\ub97c \uc219\uc9c0\ud558\uc138\uc694. \ubcf5\ub3c4\ub97c \uc774\uc6a9\ud558\uc5ec \ubc29\ub4e4\uc744 \uc774\ub3d9\ud558\uace0, \uc18c\uc74c\uc744 \ub4e4\uc73c\uba74 \ubc1c\ub514\uac00 \ub2f9\uc2e0\uc744 \ucad3\uc744 \uac83\uc774\ubbc0\ub85c \ud56d\uc0c1 \ubc1c\ub514\ub97c \uc8fc\uc2dc\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uae09\uc2dd\uc2e4\uc5d0 \uc788\uace0 \ubc1c\ub514\uac00 \ub2e4\uac00\uc624\ub294 \uc18c\ub9ac\uac00 \ub4e4\ub9ac\uba74 \ub3c4\uc11c\uad00\uacfc \uac19\uc774 \uc870\uc6a9\ud55c \uc7a5\uc18c\ub85c \uc2e0\uc18d\ud558\uac8c \uc774\ub3d9\ud558\uc138\uc694. STEP1: \uc548\uc804 \uad6c\uc5ed\uc744 \uc2dd\ubcc4\ud558\uae30 \uc704\ud574 \uc9c0\ub3c4\ub97c \uacf5\ubd80\ud558\uc138\uc694. STEP2: \uc18c\uc74c\uc744 \ucd5c\uc18c\ud654\ud558\uae30 \uc704\ud574 \uacbd\ub85c\ub97c \uacc4\ud68d\ud558\uc138\uc694. STEP3: BSODA \uae30\uacc4\uc640 \uac19\uc740 \ubc29\ud574\ubb3c\uc744 \uc0ac\uc6a9\ud558\uc5ec \ubc1c\ub514\uc758 \uc8fc\uc758\ub97c \ubd84\uc0b0\uc2dc\ud0a4\uc138\uc694."}, {"question": "\ubc1c\ub514\uc758 \uae30\ubcf8\uc5d0\uc11c \uc218\ucca9 \uc0ac\uc6a9\uc744 \uad00\ub9ac\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\uc640 \uadf8\ub807\uac8c \ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc218\ucca9 \uc0ac\uc6a9\uc744 \uad00\ub9ac\ud558\ub294 \uac83\uc740 \uac01 \uc218\ucca9\uc744 \ubaa8\uc744 \ub54c\ub9c8\ub2e4 \ubc1c\ub514\uc758 \uc18d\ub3c4\uac00 \ube68\ub77c\uc9c0\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc0ac\uc6a9\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uac8c\uc784 \uc9c4\ud589\uc5d0 \ud544\uc218\uc801\uc778 \uc218\ucca9\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \ubaa8\uc73c\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ubd81\uc801\uc774\ub294 \uc9c0\uc5ed\uc5d0\uc11c \uc218\ucca9\uc744 \ubc1c\uacac\ud558\uba74 \ud544\uc694\ud558\uc9c0 \uc54a\ub2e4\uba74 \uadf8\ub0e5 \ub450\uc138\uc694. STEP1: \uc9c4\ud589\uc5d0 \ud544\uc218\uc801\uc778 \uc218\ucca9\uc744 \uc2dd\ubcc4\ud558\uc138\uc694. STEP2: \ubc1c\ub514\uc758 \uc18d\ub3c4\ub97c \uad00\ub9ac\ud558\uae30 \uc704\ud574 \ubd88\ud544\uc694\ud55c \uc218\ucca9\uc744 \ubaa8\uc73c\ub294 \uac83\uc744 \ud53c\ud558\uc138\uc694. STEP3: \uc218\ucca9\uc744 \ubaa8\uc744 \ub54c \uc18c\uc74c \ubc29\ud574\ub97c \ub9cc\ub4e4\uace0 \ud658\uacbd\uc744 \ud65c\uc6a9\ud558\uc138\uc694."}, {"question": "\ubc1c\ub514\uac00 \ub2f9\uc2e0\uc744 \ucad3\uae30 \uc2dc\uc791\ud588\uc744 \ub54c \ubc1c\ub514\uc758 \uae30\ubcf8\uc5d0\uc11c \ubc1c\ub514\ub97c \ub2e4\ub8e8\ub294 \uac00\uc7a5 \uc88b\uc740 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubc1c\ub514\uac00 \ub2f9\uc2e0\uc744 \ucad3\uae30 \uc2dc\uc791\ud558\uba74 \uac00\uc7a5 \uc88b\uc740 \uc804\ub7b5\uc740 \ucc28\ubd84\ud558\uac8c \uc720\uc9c0\ud558\uace0 \ud658\uacbd\uc744 \ud65c\uc6a9\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. BSODA \uae30\uacc4\ub098 \uad50\uc7a5\uc758 \ud718\uc2ac\uacfc \uac19\uc740 \ubb3c\uac74\ub4e4\uc744 \ucc3e\uc544 \uadf8\uc758 \uc8fc\uc758\ub97c \ubd84\uc0b0\uc2dc\ud0a4\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, BSODA \uae30\uacc4 \uadfc\ucc98\uc5d0 \uc788\ub2e4\uba74 \uc2dc\ub044\ub7ec\uc6b4 \uc18c\uc74c\uc744 \ub0b4\uc5b4 \ubc1c\ub514\uc758 \uc8fc\uc758\ub97c \ub3cc\ub9ac\uc138\uc694. STEP1: \uadfc\ucc98\uc5d0 \uc788\ub294 \ubc29\ud574 \ubb3c\uac74\ub4e4\uc744 \ucc3e\uc73c\uc138\uc694. STEP2: \uadf8 \ubb3c\uac74\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc18c\uc74c\uc73c\ub85c \uc8fc\uc758\ub97c \ubd84\uc0b0\uc2dc\ud0a4\uc138\uc694. STEP3: \ubc1c\ub514\uac00 \uc8fc\uc758\ub97c \ubd84\uc0b0\uc2dc\ud0a4\ub294 \ub3d9\uc548 \uc2e0\uc18d\ud558\uac8c \uc548\uc804\ud55c \uc9c0\uc5ed\uc73c\ub85c \uc774\ub3d9\ud558\uc138\uc694."}, {"question": "\ubc1c\ub514\uc758 \uae30\ubcf8\uc5d0\uc11c \ubaa8\ub4e0 \uc218\ucca9\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \ubaa8\uc73c\uae30 \uc704\ud55c \uacbd\ub85c\ub97c \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubaa8\ub4e0 \uc218\ucca9\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \ubaa8\uc73c\uae30 \uc704\ud55c \uacbd\ub85c\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \ud559\uad50\uc758 \ubc30\uce58\ub97c \uacc4\ud68d\ud558\uace0 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uba3c\uc800 \uc9c0\ub3c4\ub97c \ubcf4\uace0 \ubaa8\ub4e0 \uc218\ucca9\uc758 \uc704\uce58\ub97c \ud30c\uc545\ud558\uc138\uc694. \uadf8\ub7f0 \ub2e4\uc74c, \ub418\ub3cc\uc544\uac00\ub294 \uac83\uc744 \ucd5c\uc18c\ud654\ud558\uace0 \uc18c\uc74c\uc744 \ucd5c\uc18c\ud654\ud558\ub294 \uacbd\ub85c\ub97c \uacc4\ud68d\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc218\ucca9\uc774 \uccb4\uc721\uad00\uc5d0 \uc788\ub2e4\uba74 \uae09\uc2dd\uc2e4\uacfc \uac19\uc740 \uadfc\ucc98 \uc9c0\uc5ed\uc744 \ubc29\ubb38\ud55c \ud6c4 \uc218\ucca9\uc744 \ubaa8\uc73c\uc138\uc694. STEP1: \uc9c0\ub3c4\ub97c \ubcf4\uace0 \ubaa8\ub4e0 \uc218\ucca9\uc758 \uc704\uce58\ub97c \ud30c\uc545\ud558\uc138\uc694. STEP2: \uc18c\uc74c\uacfc \ub418\ub3cc\uc544\uac00\ub294 \uac83\uc744 \ucd5c\uc18c\ud654\ud558\ub294 \uacbd\ub85c\ub97c \uacc4\ud68d\ud558\uc138\uc694. STEP3: \uc218\ucca9\uc744 \ubaa8\uc744 \ub54c \ubc1c\ub514\ub97c \ubc29\ud574\ud560 \uc218 \uc788\ub294 \ubc29\ud574\ubb3c\uc744 \uc0ac\uc6a9\ud558\uc138\uc694."}, {"question": "\uc65c \ubc1c\ub514\uc758 \uae30\ubcf8\uc5d0\uc11c \uad50\uc7a5\uc758 \ud718\uc2ac\uc774 \uc911\uc694\ud55c \ubb3c\uac74\uc774\uba70 \uc5b4\ub5bb\uac8c \uc0ac\uc6a9\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\uad50\uc7a5\uc758 \ud718\uc2ac\uc740 \ubc1c\ub514\uc758 \uccad\uac01\uc744 \uc77c\uc2dc\uc801\uc73c\ub85c \ub9c8\ube44\uc2dc\ud0ac \uc218 \uc788\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud55c \ubb3c\uac74\uc785\ub2c8\ub2e4. \uc774\ub97c \ud1b5\ud574 \ucad3\uae30\uc9c0 \uc54a\uace0 \uc790\uc720\ub86d\uac8c \uc774\ub3d9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub824\uba74 \ubc1c\ub514\uac00 \uac00\uae4c\uc774 \uc788\uc744 \ub54c \ud718\uc2ac\uc744 \uc791\ub3d9\uc2dc\ud0a4\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc881\uc740 \ubcf5\ub3c4\uc5d0\uc11c \ubc1c\ub514\uac00 \ub2e4\uac00\uc624\uace0 \uc788\ub2e4\uba74 \ud718\uc2ac\uc744 \uc0ac\uc6a9\ud558\uc5ec \uccad\uac01\uc744 \ub9c8\ube44\uc2dc\ud0a4\uace0 \ub354 \uc548\uc804\ud55c \uc9c0\uc5ed\uc73c\ub85c \uc2e0\uc18d\ud558\uac8c \uc774\ub3d9\ud558\uc138\uc694. STEP1: \ubc1c\ub514\uac00 \uac00\uae4c\uc774 \uc788\uc744 \ub54c \uae30\ub2e4\ub9ac\uc138\uc694. STEP2: \uad50\uc7a5\uc758 \ud718\uc2ac\uc744 \uc791\ub3d9\uc2dc\ud0a4\uc138\uc694. STEP3: \ubc1c\ub514\uac00 \ub9c8\ube44\ub41c \ub3d9\uc548 \uc548\uc804\ud55c \uc9c0\uc5ed\uc73c\ub85c \uc774\ub3d9\ud558\uc138\uc694."}, {"question": "\ubc1c\ub514\uc758 \uae30\ubcf8\uc5d0\uc11c \ubc1c\ub514\uc758 \uc18d\ub3c4\uac00 \uc99d\uac00\ud558\ub294 \uc6d0\ub9ac\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ub300\uc751\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ubc1c\ub514\uc758 \uc18d\ub3c4\ub294 \ub2f9\uc2e0\uc774 \ubaa8\uc73c\ub294 \uac01 \uc218\ucca9\uacfc \ud568\uaed8 \uc99d\uac00\ud558\uc5ec \uac8c\uc784\uc774 \uc9c4\ud589\ub428\uc5d0 \ub530\ub77c \uadf8\uc758 \ucd94\uaca9\uc744 \ud53c\ud558\ub294 \uac83\uc774 \ub354 \uc5b4\ub824\uc6cc\uc9d1\ub2c8\ub2e4. \uc774\uc5d0 \ub300\uc751\ud558\ub824\uba74 \ud544\uc218\uc801\uc778 \uc218\ucca9\ub9cc \ubaa8\uc73c\uace0 \ubc29\ud574\ubb3c\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc18d\ub3c4\ub97c \ub2a6\ucd94\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc138 \uac1c\uc758 \uc218\ucca9\uc744 \ubaa8\uc558\uace0 \ubc1c\ub514\uc758 \uc18d\ub3c4\uac00 \ube68\ub77c\uc9c0\uba74 BSODA \uae30\uacc4\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud070 \uc18c\uc74c\uc744 \ub0b4\uace0 \uadf8\uc758 \uc8fc\uc758\ub97c \ubd84\uc0b0\uc2dc\ud0a4\uc138\uc694. STEP1: \uc218\ucca9\uc744 \ubaa8\uc73c\ub294 \uc22b\uc790\ub97c \uc81c\ud55c\ud558\uc138\uc694. STEP2: \ubc1c\ub514\uc758 \uc18d\ub3c4\ub97c \ub2a6\ucd94\uae30 \uc704\ud574 \ubc29\ud574\ubb3c\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. STEP3: \uacbd\ub85c\ub97c \uacc4\ud68d\ud558\uc5ec \uc18c\uc74c\uc744 \ucd5c\uc18c\ud654\ud558\uace0 \ud6a8\uc728\uc744 \ub192\uc774\uc138\uc694."}, {"question": "\ubc1c\ub514\uc758 \uae30\ubcf8\uc5d0\uc11c \uc18c\uc74c \uba54\ucee4\ub2c8\uc998\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \uad00\ub9ac\ud558\ub294 \uac00\uc7a5 \uc88b\uc740 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubc1c\ub514\uc758 \uae30\ubcf8\uc5d0\uc11c \uc18c\uc74c \uba54\ucee4\ub2c8\uc998\uc740 \ubc1c\ub514\uac00 \uc18c\uc74c\uc744 \ub4e4\uc73c\uba74 \ub2f9\uc2e0\uc744 \ucad3\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \uad00\ub9ac\ud558\ub824\uba74 \ud544\uc694\ud558\uc9c0 \uc54a\uc740 \uacbd\uc6b0\ub97c \uc81c\uc678\ud558\uace0 \ub2ec\ub9ac\uac70\ub098 \ud070 \uc18c\uc74c\uc744 \ub0b4\uc9c0 \ub9c8\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub3c4\uc11c\uad00\uc5d0 \uc788\ub2e4\uba74 \ubc1c\ub514\uc758 \uc8fc\uc758\ub97c \ub04c\uc9c0 \uc54a\uae30 \uc704\ud574 \uc870\uc6a9\ud788 \uac78\uc73c\uc138\uc694. \ud544\uc694\ud55c \uacbd\uc6b0 BSODA \uae30\uacc4\ub098 \uad50\uc7a5\uc758 \ud718\uc2ac\uacfc \uac19\uc740 \ubb3c\uac74\uc744 \uc774\uc6a9\ud558\uc5ec \ubc29\ud574\ubb3c\uc744 \ub9cc\ub4dc\uc138\uc694. STEP1: \uc18c\uc74c\uc744 \ucd5c\uc18c\ud654\ud558\uae30 \uc704\ud574 \uc870\uc6a9\ud788 \uac78\uc73c\uc138\uc694. STEP2: \ubc29\ud574 \ubb3c\uac74\ub4e4\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc138\uc694. STEP3: \uc18c\uc74c\uc774 \ub9ce\uc774 \ub098\ub294 \uc9c0\uc5ed\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uc774\ub3d9\uc744 \uacc4\ud68d\ud558\uc138\uc694."}, {"question": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ubc1c\ub514\uc758 \uae30\ubcf8\uc744 \ud50c\ub808\uc774\ud560 \ub54c \ud638\ud658\uc131 \ubb38\uc81c\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud574\uacb0\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ubc1c\ub514\uc758 \uae30\ubcf8\uc5d0\uc11c PC\uc640 \ubaa8\ubc14\uc77c\uacfc \uac19\uc774 \ud50c\ub7ab\ud3fc\uc744 \uc804\ud658\ud560 \ub54c \ud638\ud658\uc131 \ubb38\uc81c\uac00 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub97c \ud574\uacb0\ud558\ub824\uba74 \uac8c\uc784\uc744 \ucd5c\uc2e0 \ubc84\uc804\uc73c\ub85c \uc5c5\ub370\uc774\ud2b8\ud558\uace0 \uc7a5\uce58\uac00 \ucd5c\uc18c \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc744 \ucda9\uc871\ud558\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ubaa8\ubc14\uc77c \uc7a5\uce58\uc5d0\uc11c \ub809\uc774 \ubc1c\uc0dd\ud558\uba74 \uc131\ub2a5\uc744 \uac1c\uc120\ud558\uae30 \uc704\ud574 \uadf8\ub798\ud53d \uc124\uc815\uc744 \ub0ae\ucdb0\ubcf4\uc138\uc694. STEP1: \uc5c5\ub370\uc774\ud2b8\ub97c \ud655\uc778\ud558\uace0 \uc124\uce58\ud558\uc138\uc694. STEP2: \uc7a5\uce58\uac00 \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc744 \ucda9\uc871\ud558\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. STEP3: \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\uae30 \uc704\ud574 \uc124\uc815\uc744 \uc870\uc815\ud558\uc138\uc694."}, {"question": "\ubc1c\ub514\uc758 \uae30\ubcf8\uc5d0\uc11c \uc5b4\ub5a4 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \ubc1c\uacac\ud560 \uc218 \uc788\uc73c\uba70, \uc5b4\ub5bb\uac8c \ud574\uc81c\ud569\ub2c8\uae4c?", "answer": "\ubc1c\ub514\uc758 \uae30\ubcf8\uc5d0\ub294 \uac8c\uc784\uc744 \ucca0\uc800\ud788 \ud0d0\ud5d8\ud568\uc73c\ub85c\uc368 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud37c\uc990\uc744 \ud480\uac70\ub098 \uc228\uaca8\uc9c4 \uc2a4\uc704\uce58\ub97c \ucc3e\uc74c\uc73c\ub85c\uc368 \uc561\uc138\uc2a4\ud560 \uc218 \uc788\ub294 \ube44\ubc00 \ubc29\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub7ec\ud55c \ubc29 \uc911 \ud558\ub098\ub294 \ubaa8\ub4e0 \uc218\ucca9\uc744 \ubaa8\uc73c\uace0 \ud2b9\uc815 \ud37c\uc990\uc744 \ud480\uba74 \uc7a0\uae08 \ud574\uc81c\ub418\ub294 '\ubc1c\ub514\uc758 \uc0ac\ubb34\uc2e4'\uc785\ub2c8\ub2e4. STEP1: \uc228\uaca8\uc9c4 \uc2a4\uc704\uce58\ub97c \ucc3e\uae30 \uc704\ud574 \ud559\uad50\ub97c \ucca0\uc800\ud788 \ud0d0\uc0c9\ud558\uc138\uc694. STEP2: \ud37c\uc990\uc744 \ud480\uc5b4 \ube44\ubc00 \ubc29\uc744 \ud574\uc81c\ud558\uc138\uc694. STEP3: \ubaa8\ub4e0 \uc218\ucca9\uc744 \ubaa8\uc544 \ud2b9\ubcc4\ud55c \ucf58\ud150\uce20\uc5d0 \uc561\uc138\uc2a4\ud558\uc138\uc694."}, {"question": "\ubc1c\ub514\uc758 \uae30\ubcf8\uc5d0\uc11c \uc0dd\uc874\uc5d0 \uac00\uc7a5 \uc720\uc6a9\ud55c \ubb3c\uac74\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \uc6b0\uc120\uc21c\uc704\ub97c \uc815\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\ubc1c\ub514\uc758 \uae30\ubcf8\uc5d0\uc11c \uc0dd\uc874\uc5d0 \uac00\uc7a5 \uc720\uc6a9\ud55c \ubb3c\uac74\uc740 \uad50\uc7a5\uc758 \ud718\uc2ac, BSODA \uae30\uacc4, \uc5d0\ub108\uc9c0 \ubc14\uc785\ub2c8\ub2e4. \ud604\uc7ac \uc0c1\ud669\uc5d0 \ub530\ub77c \uc774 \ubb3c\uac74\ub4e4\uc744 \uc6b0\uc120\uc21c\uc704\ub97c \ub450\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ubc1c\ub514\uac00 \ub2f9\uc2e0\uc744 \ucad3\uace0 \uc788\ub2e4\uba74 \uadf8\uc758 \uccad\uac01\uc744 \ub9c8\ube44\uc2dc\ud0a4\uae30 \uc704\ud574 \uad50\uc7a5\uc758 \ud718\uc2ac\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. \uc5d0\ub108\uc9c0\uac00 \ubd80\uc871\ud558\ub2e4\uba74 \uccb4\ub825\uc744 \ubcf4\ucda9\ud558\uae30 \uc704\ud574 \uc5d0\ub108\uc9c0 \ubc14\ub97c \uc6b0\uc120\uc2dc\ud558\uc138\uc694. STEP1: \ud604\uc7ac \uc0c1\ud669\uc5d0 \uac00\uc7a5 \uc720\uc6a9\ud55c \ubb3c\uac74\uc744 \uc2dd\ubcc4\ud558\uc138\uc694. STEP2: \ubc1c\ub514\ub97c \ud53c\ud558\uac70\ub098 \ubc29\ud574\ud560 \uc218 \uc788\ub294 \ubb3c\uac74\uc744 \uc6b0\uc120\uc2dc\ud558\uc138\uc694. STEP3: \ucd5c\ub300\ud55c \ud6a8\uacfc\ub97c \ub0b4\uae30 \uc704\ud574 \ubb3c\uac74\ub4e4\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc138\uc694."}]
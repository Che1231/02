[{"question": "\u30d0\u30eb\u30c7\u30a3\u306e\u57fa\u672c\u3067\u3001\u521d\u5fc3\u8005\u3068\u3057\u3066\u5b66\u6821\u74b0\u5883\u3092\u52b9\u679c\u7684\u306b\u3069\u306e\u3088\u3046\u306b\u30ca\u30d3\u30b2\u30fc\u30c8\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30eb\u30c7\u30a3\u306e\u57fa\u672c\u3067\u5b66\u6821\u3092\u30ca\u30d3\u30b2\u30fc\u30c8\u3059\u308b\u306b\u306f\u3001\u30ec\u30a4\u30a2\u30a6\u30c8\u3068\u4e3b\u8981\u306a\u5834\u6240\u3092\u7406\u89e3\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u6821\u9577\u5ba4\u306b\u3042\u308b\u30de\u30c3\u30d7\u3092\u6700\u521d\u306b\u78ba\u8a8d\u3057\u307e\u3057\u3087\u3046\u3002\u5eca\u4e0b\u3092\u4f7f\u3063\u3066\u90e8\u5c4b\u3092\u79fb\u52d5\u3057\u3001\u5e38\u306b\u9a12\u97f3\u306b\u6c17\u3065\u3044\u305f\u30d0\u30eb\u30c7\u30a3\u306b\u8ffd\u3044\u304b\u3051\u3089\u308c\u306a\u3044\u3088\u3046\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u98df\u5802\u306b\u3044\u3066\u30d0\u30eb\u30c7\u30a3\u304c\u8fd1\u3065\u3044\u3066\u304f\u308b\u97f3\u304c\u805e\u3053\u3048\u305f\u3089\u3001\u56f3\u66f8\u9928\u306e\u3088\u3046\u306a\u9759\u304b\u306a\u5834\u6240\u306b\u3059\u3050\u306b\u79fb\u52d5\u3057\u3066\u304f\u3060\u3055\u3044\u3002STEP1\uff1a\u5b89\u5168\u306a\u5834\u6240\u3092\u7279\u5b9a\u3059\u308b\u305f\u3081\u306b\u30de\u30c3\u30d7\u3092\u7814\u7a76\u3057\u307e\u3059\u3002STEP2\uff1a\u9a12\u97f3\u3092\u6700\u5c0f\u9650\u306b\u3059\u308b\u305f\u3081\u306b\u30eb\u30fc\u30c8\u3092\u8a08\u753b\u3057\u307e\u3059\u3002STEP3\uff1a\u30d0\u30eb\u30c7\u30a3\u306e\u6ce8\u610f\u3092\u305d\u3089\u3059\u305f\u3081\u306bBSODA\u30de\u30b7\u30f3\u306e\u3088\u3046\u306a\u697d\u3057\u307f\u3092\u5229\u7528\u3057\u307e\u3059\u3002"}, {"question": "\u300c\u30d0\u30eb\u30c7\u30a3\u306e\u57fa\u672c\u300d\u3067\u30ce\u30fc\u30c8\u30d6\u30c3\u30af\u306e\u4f7f\u7528\u3092\u7ba1\u7406\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u3069\u306e\u3088\u3046\u306b\u7ba1\u7406\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30ce\u30fc\u30c8\u30d6\u30c3\u30af\u306e\u4f7f\u7528\u3092\u7ba1\u7406\u3059\u308b\u3053\u3068\u306f\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u53ce\u96c6\u3059\u308b\u5404\u30ce\u30fc\u30c8\u30d6\u30c3\u30af\u306f\u3001\u30d0\u30eb\u30c7\u30a3\u306e\u901f\u5ea6\u3092\u5897\u5927\u3055\u305b\u307e\u3059\u3002\u4f7f\u7528\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u30b2\u30fc\u30e0\u306e\u9032\u884c\u306b\u3068\u3063\u3066\u5fc5\u9808\u306e\u30ce\u30fc\u30c8\u30d6\u30c3\u30af\u3092\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u6df7\u96d1\u3057\u305f\u5834\u6240\u306b\u30ce\u30fc\u30c8\u30d6\u30c3\u30af\u304c\u898b\u3064\u304b\u3063\u305f\u5834\u5408\u3001\u5fc5\u8981\u3067\u306a\u3044\u5834\u5408\u306f\u653e\u7f6e\u3059\u308b\u3053\u3068\u3092\u691c\u8a0e\u3057\u3066\u304f\u3060\u3055\u3044\u3002STEP1\uff1a\u9032\u884c\u306b\u5fc5\u9808\u306e\u30ce\u30fc\u30c8\u30d6\u30c3\u30af\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002STEP2\uff1a\u30d0\u30eb\u30c7\u30a3\u306e\u901f\u5ea6\u3092\u7ba1\u7406\u3059\u308b\u305f\u3081\u306b\u3001\u4e0d\u8981\u306a\u30ce\u30fc\u30c8\u30d6\u30c3\u30af\u306e\u53ce\u96c6\u3092\u907f\u3051\u307e\u3059\u3002STEP3\uff1a\u30ce\u30fc\u30c8\u30d6\u30c3\u30af\u3092\u53ce\u96c6\u3059\u308b\u3068\u304d\u306e\u9a12\u97f3\u306e\u90aa\u9b54\u306b\u74b0\u5883\u3092\u5229\u7528\u3057\u307e\u3059\u3002"}, {"question": "\u300c\u30d0\u30eb\u30c7\u30a3\u306e\u57fa\u672c\u300d\u3067\u30d0\u30eb\u30c7\u30a3\u304c\u8ffd\u3044\u304b\u3051\u3066\u304d\u305f\u3068\u304d\u3001\u5bfe\u5fdc\u3059\u308b\u6700\u9069\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d0\u30eb\u30c7\u30a3\u304c\u8ffd\u3044\u304b\u3051\u3066\u304d\u305f\u3068\u304d\u3001\u843d\u3061\u7740\u3044\u3066\u74b0\u5883\u3092\u6709\u5229\u306b\u4f7f\u3046\u306e\u304c\u6700\u9069\u306a\u6226\u7565\u3067\u3059\u3002BSODA\u30de\u30b7\u30f3\u3084\u6821\u9577\u5148\u751f\u30db\u30a4\u30c3\u30b9\u30eb\u306e\u3088\u3046\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u63a2\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001BSODA\u30de\u30b7\u30f3\u4ed8\u8fd1\u306b\u3044\u308b\u5834\u5408\u3001\u5927\u304d\u306a\u97f3\u3092\u7acb\u3066\u3066\u30d0\u30eb\u30c7\u30a3\u306e\u6ce8\u610f\u3092\u305d\u3089\u3059\u305f\u3081\u306b\u5229\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002STEP1\uff1a\u8fd1\u304f\u306e\u90aa\u9b54\u306b\u306a\u308b\u30a2\u30a4\u30c6\u30e0\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002STEP2\uff1a\u305d\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u4f7f\u3063\u3066\u9a12\u97f3\u306e\u969c\u5bb3\u3092\u4f5c\u308a\u307e\u3059\u3002STEP3\uff1a\u30d0\u30eb\u30c7\u30a3\u304c\u6c17\u3092\u53d6\u3089\u308c\u3066\u3044\u308b\u9593\u306b\u3001\u5b89\u5168\u306a\u5834\u6240\u306b\u3059\u3050\u306b\u79fb\u52d5\u3057\u307e\u3059\u3002"}, {"question": "\u300c\u30d0\u30eb\u30c7\u30a3\u306e\u57fa\u672c\u300d\u3067\u3059\u3079\u3066\u306e\u30ce\u30fc\u30c8\u30d6\u30c3\u30af\u3092\u52b9\u7387\u7684\u306b\u53ce\u96c6\u3059\u308b\u305f\u3081\u306e\u30eb\u30fc\u30c8\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u3059\u3079\u3066\u306e\u30ce\u30fc\u30c8\u30d6\u30c3\u30af\u3092\u52b9\u7387\u7684\u306b\u53ce\u96c6\u3059\u308b\u305f\u3081\u306e\u30eb\u30fc\u30c8\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u8a08\u753b\u3068\u5b66\u6821\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u306e\u7406\u89e3\u304c\u5fc5\u8981\u3067\u3059\u3002\u307e\u305a\u3001\u3059\u3079\u3066\u306e\u30ce\u30fc\u30c8\u30d6\u30c3\u30af\u306e\u5834\u6240\u3092\u7279\u5b9a\u3059\u308b\u305f\u3081\u306b\u30de\u30c3\u30d7\u3092\u7814\u7a76\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305d\u308c\u304b\u3089\u3001\u7121\u99c4\u306a\u5f80\u5fa9\u3084\u9a12\u97f3\u3092\u6700\u5c0f\u9650\u306b\u3059\u308b\u30eb\u30fc\u30c8\u3092\u8a08\u753b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u4f53\u80b2\u9928\u306b\u30ce\u30fc\u30c8\u30d6\u30c3\u30af\u304c\u3042\u308b\u3053\u3068\u304c\u5206\u304b\u3063\u3066\u3044\u308b\u5834\u5408\u3001\u98df\u5802\u306a\u3069\u306e\u8fd1\u304f\u306e\u30a8\u30ea\u30a2\u3092\u8a2a\u308c\u305f\u5f8c\u3067\u53ce\u96c6\u3059\u308b\u8a08\u753b\u3092\u7acb\u3066\u3066\u304f\u3060\u3055\u3044\u3002STEP1\uff1a\u3059\u3079\u3066\u306e\u30ce\u30fc\u30c8\u30d6\u30c3\u30af\u306e\u5834\u6240\u3092\u78ba\u8a8d\u3059\u308b\u305f\u3081\u306b\u30de\u30c3\u30d7\u3092\u7814\u7a76\u3057\u307e\u3059\u3002STEP2\uff1a\u9a12\u97f3\u3068\u7121\u99c4\u306a\u5f80\u5fa9\u3092\u6700\u5c0f\u9650\u306b\u3059\u308b\u30eb\u30fc\u30c8\u3092\u8a08\u753b\u3057\u307e\u3059\u3002STEP3\uff1a\u30ce\u30fc\u30c8\u30d6\u30c3\u30af\u3092\u53ce\u96c6\u3057\u306a\u304c\u3089\u3001\u30d0\u30eb\u30c7\u30a3\u306e\u6ce8\u610f\u3092\u305d\u3089\u3059\u305f\u3081\u306b\u90aa\u9b54\u3092\u5229\u7528\u3057\u307e\u3059\u3002"}, {"question": "\u300c\u30d0\u30eb\u30c7\u30a3\u306e\u57fa\u672c\u300d\u3067\u6821\u9577\u5148\u751f\u30db\u30a4\u30c3\u30b9\u30eb\u304c\u91cd\u8981\u306a\u30a2\u30a4\u30c6\u30e0\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u3069\u306e\u3088\u3046\u306b\u4f7f\u7528\u3059\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u6821\u9577\u5148\u751f\u30db\u30a4\u30c3\u30b9\u30eb\u306f\u3001\u30d0\u30eb\u30c7\u30a3\u306e\u8074\u899a\u3092\u4e00\u6642\u7684\u306b\u906e\u65ad\u3057\u3066\u3001\u8ffd\u3044\u304b\u3051\u308b\u3053\u3068\u306a\u304f\u81ea\u7531\u306b\u52d5\u3051\u308b\u305f\u3081\u91cd\u8981\u306a\u30a2\u30a4\u30c6\u30e0\u3067\u3059\u3002\u52b9\u679c\u7684\u306b\u4f7f\u3046\u305f\u3081\u306b\u306f\u3001\u30d0\u30eb\u30c7\u30a3\u304c\u8fd1\u4ed8\u3044\u3066\u304d\u305f\u3089\u30db\u30a4\u30c3\u30b9\u30eb\u3092\u9cf4\u3089\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u72ed\u3044\u5eca\u4e0b\u3067\u30d0\u30eb\u30c7\u30a3\u304c\u8fd1\u3065\u3044\u3066\u304f\u308b\u5834\u5408\u306f\u3001\u30db\u30a4\u30c3\u30b9\u30eb\u3092\u4f7f\u3063\u3066\u5f7c\u306e\u8074\u899a\u3092\u906e\u65ad\u3057\u3001\u5b89\u5168\u306a\u5834\u6240\u306b\u3059\u3050\u306b\u79fb\u52d5\u3057\u3066\u304f\u3060\u3055\u3044\u3002STEP1\uff1a\u30d0\u30eb\u30c7\u30a3\u304c\u8fd1\u4ed8\u3044\u3066\u304d\u305f\u3089\u5f85\u3061\u307e\u3059\u3002STEP2\uff1a\u6821\u9577\u5148\u751f\u30db\u30a4\u30c3\u30b9\u30eb\u3092\u9cf4\u3089\u3057\u307e\u3059\u3002STEP3\uff1a\u30d0\u30eb\u30c7\u30a3\u304c\u906e\u65ad\u3055\u308c\u3066\u3044\u308b\u9593\u306b\u5b89\u5168\u306a\u5834\u6240\u306b\u79fb\u52d5\u3057\u307e\u3059\u3002"}, {"question": "\u300c\u30d0\u30eb\u30c7\u30a3\u306e\u57fa\u672c\u300d\u3067\u30d0\u30eb\u30c7\u30a3\u306e\u30b9\u30d4\u30fc\u30c9\u5897\u52a0\u306e\u4ed5\u7d44\u307f\u306f\u4f55\u3067\u3059\u304b\uff1f\u3069\u306e\u3088\u3046\u306b\u5bfe\u51e6\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30eb\u30c7\u30a3\u306e\u901f\u5ea6\u306f\u3001\u53ce\u96c6\u3059\u308b\u5404\u30ce\u30fc\u30c8\u30d6\u30c3\u30af\u304c\u5897\u3048\u308b\u306b\u3064\u308c\u3001\u30b2\u30fc\u30e0\u304c\u9032\u3080\u306b\u3064\u308c\u3066\u3001\u5f7c\u304b\u3089\u9003\u308c\u308b\u306e\u304c\u96e3\u3057\u304f\u306a\u308a\u307e\u3059\u3002\u3053\u308c\u3092\u6253\u3061\u6d88\u3059\u305f\u3081\u306b\u306f\u3001\u5fc5\u8981\u306a\u30ce\u30fc\u30c8\u30d6\u30c3\u30af\u3060\u3051\u3092\u96c6\u3081\u3001\u90aa\u9b54\u3092\u4f7f\u3063\u3066\u5f7c\u306e\u901f\u5ea6\u3092\u9045\u3089\u305b\u308b\u3053\u3068\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u4f8b\u3048\u3070\u30013\u3064\u306e\u30ce\u30fc\u30c8\u30d6\u30c3\u30af\u3092\u96c6\u3081\u3066\u30d0\u30eb\u30c7\u30a3\u306e\u30b9\u30d4\u30fc\u30c9\u304c\u5897\u52a0\u3057\u3066\u3044\u308b\u5834\u5408\u3001BSODA\u30de\u30b7\u30f3\u3067\u5927\u304d\u306a\u97f3\u3092\u7acb\u3066\u3066\u5f7c\u306e\u6ce8\u610f\u3092\u305d\u3089\u3059\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002STEP1\uff1a\u53ce\u96c6\u3059\u308b\u30ce\u30fc\u30c8\u30d6\u30c3\u30af\u306e\u6570\u3092\u5236\u9650\u3057\u307e\u3059\u3002STEP2\uff1a\u90aa\u9b54\u3092\u4f7f\u3063\u3066\u30d0\u30eb\u30c7\u30a3\u306e\u901f\u5ea6\u3092\u843d\u3068\u3057\u307e\u3059\u3002STEP3\uff1a\u30eb\u30fc\u30c8\u3092\u8a08\u753b\u3057\u3066\u3001\u9a12\u97f3\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u3001\u52b9\u7387\u3092\u6700\u5927\u9650\u306b\u9ad8\u3081\u307e\u3059\u3002"}, {"question": "\u300c\u30d0\u30eb\u30c7\u30a3\u306e\u57fa\u672c\u300d\u3067\u9a12\u97f3\u30e1\u30ab\u30cb\u30ba\u30e0\u306e\u4ed5\u7d44\u307f\u306f\u4f55\u3067\u3059\u304b\uff1f\u3069\u306e\u3088\u3046\u306b\u7ba1\u7406\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u300c\u30d0\u30eb\u30c7\u30a3\u306e\u57fa\u672c\u300d\u306e\u9a12\u97f3\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u91cd\u8981\u3067\u3059\u3002\u30d0\u30eb\u30c7\u30a3\u306f\u9a12\u97f3\u306b\u6c17\u3065\u304f\u3068\u3001\u3042\u306a\u305f\u3092\u8ffd\u3044\u304b\u3051\u308b\u304b\u3089\u3067\u3059\u3002\u305d\u308c\u3092\u7ba1\u7406\u3059\u308b\u306b\u306f\u3001\u5fc5\u8981\u3067\u306a\u3044\u9650\u308a\u3001\u8d70\u308a\u56de\u3063\u305f\u308a\u5927\u304d\u306a\u97f3\u3092\u7acb\u3066\u305f\u308a\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u56f3\u66f8\u9928\u306b\u3044\u308b\u5834\u5408\u306f\u3001\u30d0\u30eb\u30c7\u30a3\u306e\u6ce8\u610f\u3092\u5f15\u304d\u4ed8\u3051\u306a\u3044\u3088\u3046\u306b\u9759\u304b\u306b\u6b69\u304d\u307e\u3057\u3087\u3046\u3002\u5fc5\u8981\u306b\u5fdc\u3058\u3066\u3001BSODA\u30de\u30b7\u30f3\u3084\u6821\u9577\u5148\u751f\u30db\u30a4\u30c3\u30b9\u30eb\u306a\u3069\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u4f7f\u3063\u3066\u90aa\u9b54\u3092\u4f5c\u308a\u307e\u3059\u3002STEP1\uff1a\u9a12\u97f3\u3092\u6700\u5c0f\u9650\u306b\u3059\u308b\u305f\u3081\u306b\u9759\u304b\u306b\u6b69\u304d\u307e\u3059\u3002STEP2\uff1a\u90aa\u9b54\u306b\u306a\u308b\u30a2\u30a4\u30c6\u30e0\u3092\u6226\u7565\u7684\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002STEP3\uff1a\u9a12\u97f3\u306e\u591a\u3044\u30a8\u30ea\u30a2\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u79fb\u52d5\u3092\u8a08\u753b\u3057\u307e\u3059\u3002"}, {"question": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u300c\u30d0\u30eb\u30c7\u30a3\u306e\u57fa\u672c\u300d\u3092\u30d7\u30ec\u30a4\u3059\u308b\u3068\u304d\u306e\u4e92\u63db\u6027\u554f\u984c\u306f\u4f55\u3067\u3059\u304b\uff1f\u3069\u306e\u3088\u3046\u306b\u89e3\u6c7a\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u300c\u30d0\u30eb\u30c7\u30a3\u306e\u57fa\u672c\u300d\u306e\u4e92\u63db\u6027\u306e\u554f\u984c\u306f\u3001PC\u3068\u30e2\u30d0\u30a4\u30eb\u306a\u3069\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u5207\u308a\u66ff\u3048\u308b\u969b\u306b\u767a\u751f\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3092\u89e3\u6c7a\u3059\u308b\u306b\u306f\u3001\u30b2\u30fc\u30e0\u3092\u6700\u65b0\u30d0\u30fc\u30b8\u30e7\u30f3\u306b\u66f4\u65b0\u3057\u3001\u30c7\u30d0\u30a4\u30b9\u304c\u6700\u5c0f\u30b7\u30b9\u30c6\u30e0\u8981\u4ef6\u3092\u6e80\u305f\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u3067\u30e9\u30b0\u304c\u767a\u751f\u3057\u3066\u3044\u308b\u5834\u5408\u306f\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6539\u5584\u3059\u308b\u305f\u3081\u306b\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3092\u4e0b\u3052\u3066\u304f\u3060\u3055\u3044\u3002STEP1\uff1a\u66f4\u65b0\u3092\u78ba\u8a8d\u3057\u3001\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u307e\u3059\u3002STEP2\uff1a\u30c7\u30d0\u30a4\u30b9\u304c\u30b7\u30b9\u30c6\u30e0\u8981\u4ef6\u3092\u6e80\u305f\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002STEP3\uff1a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u305f\u3081\u306b\u8a2d\u5b9a\u3092\u8abf\u6574\u3057\u307e\u3059\u3002"}, {"question": "\u300c\u30d0\u30eb\u30c7\u30a3\u306e\u57fa\u672c\u300d\u3067\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u306f\u4f55\u3067\u3059\u304b\uff1f\u3069\u306e\u3088\u3046\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u300c\u30d0\u30eb\u30c7\u30a3\u306e\u57fa\u672c\u300d\u306b\u306f\u3001\u30b2\u30fc\u30e0\u3092\u5fb9\u5e95\u7684\u306b\u63a2\u6c42\u3059\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30d1\u30ba\u30eb\u3092\u89e3\u3044\u305f\u308a\u3001\u96a0\u3055\u308c\u305f\u30b9\u30a4\u30c3\u30c1\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u3067\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u79d8\u5bc6\u306e\u90e8\u5c4b\u304c\u3042\u308a\u307e\u3059\u3002\u300c\u30d0\u30eb\u30c7\u30a3\u306e\u30aa\u30d5\u30a3\u30b9\u300d\u306f\u3001\u3059\u3079\u3066\u306e\u30ce\u30fc\u30c8\u30d6\u30c3\u30af\u3092\u96c6\u3081\u3066\u7279\u5b9a\u306e\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u308b\u90e8\u5c4b\u306e\u4f8b\u3067\u3059\u3002STEP1\uff1a\u96a0\u3055\u308c\u305f\u30b9\u30a4\u30c3\u30c1\u3092\u898b\u3064\u3051\u308b\u305f\u3081\u306b\u5b66\u6821\u3092\u5fb9\u5e95\u7684\u306b\u63a2\u3057\u307e\u3059\u3002STEP2\uff1a\u30d1\u30ba\u30eb\u3092\u89e3\u3044\u3066\u79d8\u5bc6\u306e\u90e8\u5c4b\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u307e\u3059\u3002STEP3\uff1a\u3059\u3079\u3066\u306e\u30ce\u30fc\u30c8\u30d6\u30c3\u30af\u3092\u96c6\u3081\u3066\u7279\u5225\u306a\u30b3\u30f3\u30c6\u30f3\u30c4\u306b\u30a2\u30af\u30bb\u30b9\u3057\u307e\u3059\u3002"}, {"question": "\u300c\u30d0\u30eb\u30c7\u30a3\u306e\u57fa\u672c\u300d\u3067\u751f\u304d\u6b8b\u308b\u305f\u3081\u306b\u6700\u3082\u5f79\u7acb\u3064\u30a2\u30a4\u30c6\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f\u3069\u306e\u3088\u3046\u306b\u512a\u5148\u9806\u4f4d\u3092\u3064\u3051\u307e\u3059\u304b\uff1f", "answer": "\u300c\u30d0\u30eb\u30c7\u30a3\u306e\u57fa\u672c\u300d\u3067\u751f\u304d\u6b8b\u308b\u305f\u3081\u306b\u6700\u3082\u5f79\u7acb\u3064\u30a2\u30a4\u30c6\u30e0\u306b\u306f\u3001\u6821\u9577\u5148\u751f\u30db\u30a4\u30c3\u30b9\u30eb\u3001BSODA\u30de\u30b7\u30f3\u3001\u30a8\u30cd\u30eb\u30ae\u30fc\u30d0\u30fc\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u73fe\u5728\u306e\u72b6\u6cc1\u306b\u57fa\u3065\u3044\u3066\u3053\u308c\u3089\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u30d0\u30eb\u30c7\u30a3\u304c\u8ffd\u3044\u304b\u3051\u3066\u304f\u308b\u5834\u5408\u306f\u3001\u6821\u9577\u5148\u751f\u30db\u30a4\u30c3\u30b9\u30eb\u3092\u4f7f\u3063\u3066\u5f7c\u306e\u8074\u899a\u3092\u906e\u65ad\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30a8\u30cd\u30eb\u30ae\u30fc\u304c\u4f4e\u3044\u5834\u5408\u306f\u3001\u30b9\u30bf\u30df\u30ca\u3092\u56de\u5fa9\u3059\u308b\u305f\u3081\u306b\u30a8\u30cd\u30eb\u30ae\u30fc\u30d0\u30fc\u3092\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002STEP1\uff1a\u73fe\u5728\u306e\u72b6\u6cc1\u3067\u6700\u3082\u5f79\u306b\u7acb\u3064\u30a2\u30a4\u30c6\u30e0\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002STEP2\uff1a\u30d0\u30eb\u30c7\u30a3\u304b\u3089\u9003\u3052\u308b\u304b\u6ce8\u610f\u3092\u305d\u3089\u3059\u3053\u3068\u304c\u3067\u304d\u308b\u30a2\u30a4\u30c6\u30e0\u3092\u512a\u5148\u3057\u307e\u3059\u3002STEP3\uff1a\u30a2\u30a4\u30c6\u30e0\u3092\u6226\u7565\u7684\u306b\u4f7f\u7528\u3057\u3066\u3001\u52b9\u679c\u3092\u6700\u5927\u9650\u306b\u9ad8\u3081\u307e\u3059\u3002"}]
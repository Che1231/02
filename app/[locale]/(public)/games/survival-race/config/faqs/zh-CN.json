[{"question": "\u5982\u4f55\u5f00\u59cb\u751f\u5b58\u7ade\u901f\u8d5b\u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u5f00\u59cb\u751f\u5b58\u7ade\u901f\u8d5b\uff0c\u4f60\u9700\u8981\u719f\u6089\u57fa\u672c\u63a7\u5236\u3002\u5de6\u64cd\u7eb5\u6746\u6216\u65b9\u5411\u952e\u7528\u4e8e\u79fb\u52a8\uff0c\u800c\u53f3\u64cd\u7eb5\u6746\u6216\u9f20\u6807\u63a7\u5236\u6444\u50cf\u673a\u3002'A'\u952e\u6216\u7a7a\u683c\u952e\u7528\u4e8e\u8df3\u8dc3\uff0c'B'\u952e\u6216'E'\u952e\u7528\u4e8e\u4e0e\u7269\u4f53\u4e92\u52a8\u3002\u4f8b\u5982\uff0c\u62fe\u53d6\u8865\u7ed9\u5305\uff0c\u9760\u8fd1\u5b83\u5e76\u6309\u4e0b'B'\u952e\u3002\u6b64\u5916\uff0c'X'\u952e\u6216'Q'\u952e\u7528\u4e8e\u653b\u51fb\u654c\u4eba\u3002\u5728\u6559\u7a0b\u5173\u5361\u7ec3\u4e60\u8fd9\u4e9b\u63a7\u5236\uff0c\u611f\u53d7\u6e38\u620f\u673a\u5236\u3002"}, {"question": "\u5728\u751f\u5b58\u7ade\u901f\u8d5b\u4e2d\u751f\u5b58\u66f4\u957f\u65f6\u95f4\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u751f\u5b58\u7ade\u901f\u8d5b\u4e2d\u751f\u5b58\u66f4\u957f\u65f6\u95f4\u9700\u8981\u7b56\u7565\u548c\u6280\u5de7\u7684\u7ed3\u5408\u3002\u6b65\u9aa41\uff1a\u65f6\u523b\u6ce8\u610f\u4f60\u7684\u751f\u547d\u503c\u548c\u62a4\u7532\u3002\u627e\u5230\u8865\u7ed9\u5305\u548c\u62a4\u7532\u540e\u7acb\u5373\u4f7f\u7528\u3002\u6b65\u9aa42\uff1a\u660e\u667a\u5730\u7ba1\u7406\u4f60\u7684\u8d44\u6e90\u3002\u4e0d\u8981\u6d6a\u8d39\u5f39\u836f\u5728\u5f31\u5c0f\u7684\u654c\u4eba\u8eab\u4e0a\uff1b\u4f7f\u7528\u8fd1\u6218\u653b\u51fb\u4ee3\u66ff\u3002\u6b65\u9aa43\uff1a\u4fdd\u6301\u79fb\u52a8\u3002\u9759\u6b62\u4e0d\u52a8\u4f1a\u8ba9\u4f60\u6210\u4e3a\u4e00\u4e2a\u5bb9\u6613\u7684\u76ee\u6807\u3002\u4f8b\u5982\uff0c\u5728\u201c\u6c99\u6f20\u524d\u54e8\u201d\u5173\u5361\u4e2d\uff0c\u5229\u7528\u6c99\u4e18\u63a9\u62a4\uff0c\u4e0d\u65ad\u79fb\u52a8\u4ee5\u907f\u514d\u654c\u4eba\u653b\u51fb\u3002\u6b64\u5916\uff0c\u5b66\u4e60\u654c\u4eba\u7684\u5237\u65b0\u70b9\uff0c\u6709\u6548\u5730\u9884\u6d4b\u548c\u53cd\u51fb\u4ed6\u4eec\u7684\u653b\u51fb\u3002"}, {"question": "\u5728\u751f\u5b58\u7ade\u901f\u8d5b\u4e2d\uff0c\u54ea\u4e9b\u6b66\u5668\u6700\u6709\u6548\u5730\u5bf9\u6297\u4e0d\u540c\u7c7b\u578b\u7684\u654c\u4eba\uff1f", "answer": "\u5728\u751f\u5b58\u7ade\u901f\u8d5b\u4e2d\uff0c\u4e0d\u540c\u7684\u6b66\u5668\u5bf9\u7279\u5b9a\u7c7b\u578b\u7684\u654c\u4eba\u6709\u6548\u3002\u9730\u5f39\u67aa\u6700\u9002\u5408\u8fd1\u8ddd\u79bb\u6218\u6597\uff0c\u5c24\u5176\u9002\u5408\u5feb\u901f\u79fb\u52a8\u7684\u654c\u4eba\uff0c\u4f8b\u5982\u201c\u63a0\u98df\u8005\u7fa4\u201d\u3002\u7a81\u51fb\u6b65\u67aa\u7528\u9014\u5e7f\u6cdb\uff0c\u5bf9\u4e2d\u8ddd\u79bb\u654c\u4eba\uff0c\u4f8b\u5982\u201c\u52ab\u63a0\u8005\u201d\u6709\u6548\u3002\u5bf9\u4e8e\u8fdc\u7a0b\u4f5c\u6218\uff0c\u72d9\u51fb\u6b65\u67aa\u6700\u9002\u5408\u6d88\u706d\u201c\u72d9\u51fb\u624b\u201d\u548c\u201c\u91cd\u706b\u529b\u67aa\u624b\u201d\u3002\u4f8b\u5982\uff0c\u5728\u201c\u4e1b\u6797\u5e9f\u589f\u201d\u5173\u5361\u4e2d\uff0c\u4f7f\u7528\u9730\u5f39\u67aa\u6e05\u9664\u63a0\u98df\u8005\u7fa4\uff0c\u7136\u540e\u5207\u6362\u5230\u72d9\u51fb\u6b65\u67aa\u8fdc\u7a0b\u6d88\u706d\u91cd\u706b\u529b\u67aa\u624b\u3002\u8981\u5e94\u5bf9\u5404\u79cd\u5a01\u80c1\uff0c\u52a1\u5fc5\u643a\u5e26\u4e0d\u540c\u7c7b\u578b\u7684\u6b66\u5668\u3002"}, {"question": "\u751f\u5b58\u7ade\u901f\u8d5b\u4e2d\u7684\u62a4\u7532\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u751f\u5b58\u7ade\u901f\u8d5b\u4e2d\u7684\u62a4\u7532\u7cfb\u7edf\u63d0\u4f9b\u989d\u5916\u7684\u4fdd\u62a4\u5c42\uff0c\u62b5\u5fa1\u4f24\u5bb3\u3002\u62a4\u7532\u5438\u6536\u4f60\u6240\u53d7\u5230\u4f24\u5bb3\u7684\u4e00\u90e8\u5206\uff0c\u51cf\u5c11\u5bf9\u751f\u547d\u503c\u7684\u51b2\u51fb\u3002\u53ef\u4ee5\u901a\u8fc7\u62fe\u53d6\u5173\u5361\u4e2d\u6563\u843d\u7684\u62a4\u7532\u5305\u6765\u8865\u5145\u62a4\u7532\u3002\u4f8b\u5982\uff0c\u5728\u201c\u57ce\u5e02\u5e9f\u589f\u201d\u5173\u5361\u4e2d\uff0c\u4f60\u53ef\u4ee5\u5728\u5730\u4e0b\u505c\u8f66\u573a\u627e\u5230\u62a4\u7532\u5305\u3002\u4f60\u80fd\u643a\u5e26\u7684\u62a4\u7532\u6570\u91cf\u6709\u9650\uff0c\u56e0\u6b64\u52a1\u5fc5\u7b56\u7565\u6027\u5730\u4f7f\u7528\u5b83\u3002\u5f53\u4f60\u7684\u62a4\u7532\u8017\u5c3d\u65f6\uff0c\u4f60\u5c06\u76f4\u63a5\u53d7\u5230\u751f\u547d\u503c\u7684\u4f24\u5bb3\uff0c\u6240\u4ee5\u52a1\u5fc5\u65f6\u523b\u5173\u6ce8\u4f60\u7684\u62a4\u7532\u7b49\u7ea7\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u8d44\u6e90\u7ba1\u7406\u5728\u751f\u5b58\u7ade\u901f\u8d5b\u4e2d\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u8d44\u6e90\u7ba1\u7406\u5728\u751f\u5b58\u7ade\u901f\u8d5b\u4e2d\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u76f4\u63a5\u5f71\u54cd\u4f60\u7684\u751f\u5b58\u80fd\u529b\u548c\u8fdb\u5ea6\u3002\u5f39\u836f\u3001\u8865\u7ed9\u5305\u548c\u62a4\u7532\u90fd\u662f\u6709\u9650\u7684\uff0c\u6d6a\u8d39\u5b83\u4eec\u4f1a\u5728\u5173\u952e\u65f6\u523b\u4f7f\u4f60\u5904\u4e8e\u5371\u9669\u5883\u5730\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5c71\u8def\u201d\u5173\u5361\u4e2d\uff0c\u901a\u8fc7\u5bf9\u8f83\u5f31\u654c\u4eba\u4f7f\u7528\u8fd1\u6218\u653b\u51fb\u6765\u8282\u7701\u5f39\u836f\uff0c\u53ef\u4ee5\u4e3a\u5bf9\u4ed8\u50cf\u201c\u5766\u514b\u201d\u8fd9\u6837\u7684\u66f4\u5f3a\u5927\u7684\u654c\u4eba\u4fdd\u7559\u5b50\u5f39\u3002\u6b64\u5916\uff0c\u5373\u4f7f\u4f60\u4e0d\u9700\u8981\uff0c\u4e5f\u52a1\u5fc5\u4f18\u5148\u62fe\u53d6\u8d44\u6e90\u3002\u9ad8\u6548\u7684\u8d44\u6e90\u7ba1\u7406\u53ef\u4ee5\u786e\u4fdd\u4f60\u968f\u65f6\u51c6\u5907\u8fce\u63a5\u4e0b\u4e00\u4e2a\u6311\u6218\u3002"}, {"question": "\u751f\u5b58\u7ade\u901f\u8d5b\u4e2d\u4e0d\u540c\u96be\u5ea6\u7b49\u7ea7\u4e4b\u95f4\u7684\u4e3b\u8981\u533a\u522b\u662f\u4ec0\u4e48\uff1f", "answer": "\u751f\u5b58\u7ade\u901f\u8d5b\u4e2d\u4e0d\u540c\u96be\u5ea6\u7b49\u7ea7\u7684\u4e3b\u8981\u533a\u522b\u5728\u4e8e\u654c\u4eba\u7684\u5f3a\u5ea6\u3001\u8d44\u6e90\u7684\u53ef\u7528\u6027\u548c\u68c0\u67e5\u70b9\u51fa\u73b0\u7684\u9891\u7387\u3002\u201c\u7b80\u5355\u201d\u6a21\u5f0f\u4e0b\uff0c\u654c\u4eba\u9020\u6210\u7684\u4f24\u5bb3\u8f83\u5c11\uff0c\u8d44\u6e90\u8f83\u4e30\u5bcc\u3002\u201c\u666e\u901a\u201d\u6a21\u5f0f\u63d0\u4f9b\u5e73\u8861\u7684\u6e38\u620f\u4f53\u9a8c\uff0c\u654c\u4eba\u5f3a\u5ea6\u548c\u8d44\u6e90\u53ef\u7528\u6027\u9002\u4e2d\u3002\u201c\u56f0\u96be\u201d\u6a21\u5f0f\u589e\u52a0\u4e86\u654c\u4eba\u7684\u751f\u547d\u503c\u548c\u4f24\u5bb3\uff0c\u540c\u65f6\u51cf\u5c11\u4e86\u8d44\u6e90\u548c\u68c0\u67e5\u70b9\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5de5\u5382\u7efc\u5408\u4f53\u201d\u5173\u5361\u4e2d\uff0c\u201c\u56f0\u96be\u201d\u6a21\u5f0f\u4e0b\u7684\u654c\u4eba\u6570\u91cf\u548c\u8865\u7ed9\u5305\u6570\u91cf\u5c06\u6bd4\u201c\u7b80\u5355\u201d\u6a21\u5f0f\u4e0b\u5c11\u3002\u9009\u62e9\u9002\u5408\u4f60\u7684\u6280\u80fd\u548c\u7ecf\u9a8c\u7684\u96be\u5ea6\u7b49\u7ea7\uff0c\u624d\u80fd\u83b7\u5f97\u6700\u4f73\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u5982\u4f55\u5728\u751f\u5b58\u7ade\u901f\u8d5b\u4e2d\u4f18\u5316\u4e0d\u540c\u5173\u5361\u7684\u89d2\u8272\u914d\u7f6e\uff1f", "answer": "\u5728\u751f\u5b58\u7ade\u901f\u8d5b\u4e2d\u4f18\u5316\u4e0d\u540c\u5173\u5361\u7684\u89d2\u8272\u914d\u7f6e\uff0c\u9700\u8981\u4e3a\u5373\u5c06\u9762\u4e34\u7684\u6311\u6218\u9009\u62e9\u5408\u9002\u7684\u6b66\u5668\u548c\u88c5\u5907\u3002\u6b65\u9aa41\uff1a\u8bc4\u4f30\u5173\u5361\u7684\u73af\u5883\u548c\u654c\u4eba\u7c7b\u578b\u3002\u4f8b\u5982\uff0c\u5728\u201c\u6cbc\u6cfd\u5730\u201d\u5173\u5361\u4e2d\uff0c\u4f60\u5c06\u9762\u4e34\u8bb8\u591a\u8fd1\u8ddd\u79bb\u654c\u4eba\uff0c\u6240\u4ee5\u88c5\u5907\u9730\u5f39\u67aa\u548c\u8fd1\u6218\u6b66\u5668\u3002\u6b65\u9aa42\uff1a\u5e73\u8861\u4f60\u7684\u914d\u7f6e\uff0c\u6df7\u5408\u4f7f\u7528\u8fd1\u8ddd\u79bb\u3001\u4e2d\u8ddd\u79bb\u548c\u8fdc\u7a0b\u6b66\u5668\u3002\u6b65\u9aa43\uff1a\u59cb\u7ec8\u643a\u5e26\u4e00\u4e9b\u624b\u69b4\u5f39\u6216\u70b8\u5f39\uff0c\u7528\u4e8e\u5bf9\u4ed8\u654c\u4eba\u7fa4\u6216\u5f3a\u5927\u7684Boss\u3002\u6839\u636e\u5173\u5361\u7684\u5177\u4f53\u9700\u6c42\u8c03\u6574\u4f60\u7684\u88c5\u5907\uff0c\u4ee5\u6700\u5927\u5316\u4f60\u7684\u6548\u7387\u3002"}, {"question": "\u751f\u5b58\u7ade\u901f\u8d5b\u7684\u8de8\u5e73\u53f0\u517c\u5bb9\u6027\u9009\u9879\u6709\u54ea\u4e9b\uff1f", "answer": "\u751f\u5b58\u7ade\u901f\u8d5b\u63d0\u4f9b\u8de8\u5e73\u53f0\u517c\u5bb9\u6027\uff0c\u5141\u8bb8\u73a9\u5bb6\u5728\u591a\u79cd\u8bbe\u5907\u4e0a\u4eab\u53d7\u6e38\u620f\u3002\u6e38\u620f\u652f\u6301\u8de8\u5b58\u6863\u529f\u80fd\uff0c\u8ba9\u4f60\u53ef\u4ee5\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u4f60\u53ef\u4ee5\u5728\u7535\u8111\u4e0a\u5f00\u59cb\u6e38\u620f\uff0c\u7136\u540e\u5728\u4f60\u7684\u6e38\u620f\u673a\u4e0a\u7ee7\u7eed\uff0c\u800c\u4e0d\u4f1a\u4e22\u5931\u4efb\u4f55\u8fdb\u5ea6\u3002\u6b64\u5916\uff0c\u8de8\u5e73\u53f0\u591a\u4eba\u6e38\u620f\u4e5f\u53ef\u4f7f\u7528\uff0c\u8ba9\u4f60\u53ef\u4ee5\u4e0e\u670b\u53cb\u7ec4\u961f\uff0c\u65e0\u8bba\u4ed6\u4eec\u4f7f\u7528\u4ec0\u4e48\u8bbe\u5907\u3002\u786e\u4fdd\u4f60\u7684\u4e92\u8054\u7f51\u8fde\u63a5\u7a33\u5b9a\uff0c\u5e76\u8de8\u5e73\u53f0\u94fe\u63a5\u4f60\u7684\u8d26\u53f7\uff0c\u5145\u5206\u5229\u7528\u8fd9\u4e9b\u529f\u80fd\u3002"}, {"question": "\u5728\u751f\u5b58\u7ade\u901f\u8d5b\u4e2d\u53ef\u4ee5\u627e\u5230\u54ea\u4e9b\u9690\u85cf\u5f69\u86cb\uff1f", "answer": "\u751f\u5b58\u7ade\u901f\u8d5b\u4e2d\u5145\u6ee1\u4e86\u9690\u85cf\u5f69\u86cb\uff0c\u4e3a\u6e38\u620f\u589e\u6dfb\u4e86\u989d\u5916\u7684\u4e50\u8da3\u3002\u503c\u5f97\u6ce8\u610f\u7684\u4e00\u4e2a\u5f69\u86cb\u662f\u9690\u85cf\u5728\u201c\u5de5\u5382\u7efc\u5408\u4f53\u201d\u5173\u5361\u4e2d\u7684\u201c\u5f00\u53d1\u4eba\u5458\u623f\u95f4\u201d\u3002\u8981\u627e\u5230\u5b83\uff0c\u8bf7\u5bfb\u627e\u5899\u4e0a\u4e00\u7cfb\u5217\u7279\u5b9a\u6d82\u9e26\uff0c\u5e76\u6309\u7167\u7279\u5b9a\u987a\u5e8f\u4e0e\u4e4b\u4ea4\u4e92\u3002\u4e00\u65e6\u8fdb\u5165\uff0c\u4f60\u5c31\u4f1a\u53d1\u73b0\u4e00\u4e2a\u5145\u6ee1\u5f00\u53d1\u4eba\u5458\u7b14\u8bb0\u548c\u6982\u5ff5\u827a\u672f\u7684\u623f\u95f4\u3002\u53e6\u4e00\u4e2a\u5f69\u86cb\u662f\u201c\u57ce\u5e02\u5e9f\u589f\u201d\u5173\u5361\u4e2d\u7684\u201c\u590d\u53e4\u8857\u673a\u201d\uff0c\u5728\u90a3\u91cc\u4f60\u53ef\u4ee5\u73a9\u4e00\u4e2a\u5c0f\u6e38\u620f\uff0c\u7c7b\u4f3c\u4e8e\u7ecf\u5178\u8857\u673a\u5c04\u51fb\u6e38\u620f\u3002\u63a2\u7d22\u6bcf\u4e00\u4e2a\u89d2\u843d\uff0c\u90fd\u80fd\u53d1\u73b0\u8fd9\u4e9b\u9690\u85cf\u7684\u73cd\u5b9d\u3002"}, {"question": "\u751f\u5b58\u7ade\u901f\u8d5b\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u751f\u5b58\u7ade\u901f\u8d5b\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u591a\u4e2a\u56e0\u7d20\uff0c\u5305\u62ec\u51fb\u6740\u6570\u3001\u7206\u5934\u547d\u4e2d\u7387\u3001\u51c6\u786e\u6027\u548c\u65f6\u95f4\u3002\u6bcf\u6b21\u51fb\u6740\u90fd\u4f1a\u7ed9\u4f60\u79ef\u5206\uff0c\u7206\u5934\u548c\u5077\u88ad\u51fb\u6740\u4f1a\u989d\u5916\u52a0\u5206\u3002\u51c6\u786e\u7387\u8ba1\u7b97\u4e3a\u6210\u529f\u5c04\u51fb\u7684\u767e\u5206\u6bd4\uff0c\u66f4\u9ad8\u7684\u51c6\u786e\u7387\u4f1a\u83b7\u5f97\u66f4\u591a\u79ef\u5206\u3002\u6b64\u5916\uff0c\u66f4\u5feb\u5730\u5b8c\u6210\u5173\u5361\u4f1a\u5956\u52b1\u4f60\u65f6\u95f4\u5956\u52b1\u3002\u4f8b\u5982\uff0c\u5728\u201c\u4e1b\u6797\u5e9f\u589f\u201d\u5173\u5361\u4e2d\uff0c\u9ad8\u51c6\u786e\u7387\u548c\u5feb\u901f\u5b8c\u6210\u5173\u5361\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u5206\u6570\u3002\u4e3a\u4e86\u6700\u5927\u5316\u4f60\u7684\u5f97\u5206\u5e76\u5728\u6392\u884c\u699c\u4e0a\u540d\u5217\u524d\u8305\uff0c\u4f60\u9700\u8981\u7cbe\u51c6\u548c\u9ad8\u6548\u3002"}]
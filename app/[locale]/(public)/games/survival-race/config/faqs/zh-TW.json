[{"question": "\u5982\u4f55\u5728\u300a\u751f\u5b58\u7af6\u8cfd\u300b\u4e2d\u958b\u59cb\u4f7f\u7528\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u958b\u59cb\u300a\u751f\u5b58\u7af6\u8cfd\u300b\uff0c\u60a8\u9700\u8981\u719f\u6089\u57fa\u672c\u63a7\u5236\u3002\u5de6\u624b\u67c4\u6216\u65b9\u5411\u9375\u7528\u65bc\u79fb\u52d5\uff0c\u800c\u53f3\u624b\u67c4\u6216\u6ed1\u9f20\u5247\u63a7\u5236\u76f8\u6a5f\u3002'A' \u9375\u6216\u7a7a\u683c\u9375\u7528\u65bc\u8df3\u8e8d\uff0c'B' \u9375\u6216 'E' \u9375\u7528\u65bc\u8207\u7269\u4ef6\u4e92\u52d5\u3002\u4f8b\u5982\uff0c\u8981\u64bf\u8d77\u88dc\u7d66\u5305\uff0c\u9760\u8fd1\u5b83\u4e26\u6309\u4e0b 'B' \u9375\u3002\u6b64\u5916\uff0c'X' \u9375\u6216 'Q' \u9375\u7528\u65bc\u653b\u64ca\u6575\u4eba\u3002\u5728\u6559\u5b78\u95dc\u5361\u7df4\u7fd2\u9019\u4e9b\u63a7\u5236\uff0c\u4ee5\u4e86\u89e3\u904a\u6232\u6a5f\u5236\u3002"}, {"question": "\u5728\u300a\u751f\u5b58\u7af6\u8cfd\u300b\u4e2d\uff0c\u5ef6\u9577\u751f\u5b58\u6642\u9593\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u300a\u751f\u5b58\u7af6\u8cfd\u300b\u4e2d\uff0c\u5ef6\u9577\u751f\u5b58\u6642\u9593\u9700\u8981\u7b56\u7565\u548c\u6280\u5de7\u7684\u7d50\u5408\u3002\u6b65\u9a5f 1\uff1a\u59cb\u7d42\u6ce8\u610f\u81ea\u5df1\u7684\u751f\u547d\u503c\u548c\u88dd\u7532\u3002\u627e\u5230\u88dc\u7d66\u5305\u548c\u88dd\u7532\u6642\uff0c\u8acb\u76e1\u5feb\u4f7f\u7528\u3002\u6b65\u9a5f 2\uff1a\u6709\u6548\u7ba1\u7406\u8cc7\u6e90\u3002\u4e0d\u8981\u6d6a\u8cbb\u5b50\u5f48\u5728\u5f31\u5c0f\u7684\u6575\u4eba\u8eab\u4e0a\uff1b\u6539\u7528\u8fd1\u8eab\u653b\u64ca\u3002\u6b65\u9a5f 3\uff1a\u6301\u7e8c\u79fb\u52d5\u3002\u975c\u6b62\u4e0d\u52d5\u6703\u8b93\u4f60\u6210\u70ba\u5bb9\u6613\u7684\u76ee\u6a19\u3002\u4f8b\u5982\uff0c\u5728\u300e\u6c99\u6f20\u64da\u9ede\u300f\u95dc\u5361\u4e2d\uff0c\u5229\u7528\u6c99\u4e18\u4f5c\u70ba\u63a9\u9ad4\uff0c\u4e26\u6301\u7e8c\u79fb\u52d5\u4ee5\u8eb2\u907f\u6575\u4eba\u7684\u653b\u64ca\u3002\u6b64\u5916\uff0c\u77ad\u89e3\u6575\u4eba\u7684\u751f\u6210\u9ede\uff0c\u624d\u80fd\u6709\u6548\u9810\u6e2c\u548c\u53cd\u64ca\u4ed6\u5011\u7684\u653b\u64ca\u3002"}, {"question": "\u5728\u300a\u751f\u5b58\u7af6\u8cfd\u300b\u4e2d\uff0c\u54ea\u4e9b\u6b66\u5668\u6700\u6709\u6548\u5c0d\u4ed8\u4e0d\u540c\u985e\u578b\u7684\u6575\u4eba\uff1f", "answer": "\u5728\u300a\u751f\u5b58\u7af6\u8cfd\u300b\u4e2d\uff0c\u4e0d\u540c\u7684\u6b66\u5668\u5c0d\u4ed8\u7279\u5b9a\u6575\u4eba\u985e\u578b\u6700\u6709\u6548\u3002\u9730\u5f48\u69cd\u6700\u9069\u5408\u8fd1\u8ddd\u96e2\u6230\u9b25\uff0c\u5c24\u5176\u5c0d\u4ed8\u50cf\u300e\u63a0\u596a\u8005\u7fa4\u300f\u9019\u6a23\u5feb\u901f\u79fb\u52d5\u7684\u6575\u4eba\u3002\u7a81\u64ca\u6b65\u69cd\u9069\u7528\u65bc\u4e2d\u8ddd\u96e2\u6575\u4eba\uff0c\u4f8b\u5982\u300e\u63a0\u596a\u8005\u300f\u3002\u5c0d\u65bc\u9060\u8ddd\u96e2\u6230\u9b25\uff0c\u72d9\u64ca\u6b65\u69cd\u6700\u9069\u5408\u64ca\u4e2d\u300e\u72d9\u64ca\u624b\u300f\u548c\u300e\u91cd\u6a5f\u69cd\u624b\u300f\u3002\u4f8b\u5982\uff0c\u5728\u300e\u53e2\u6797\u5ee2\u589f\u300f\u95dc\u5361\u4e2d\uff0c\u53ef\u4ee5\u4f7f\u7528\u9730\u5f48\u69cd\u6e05\u9664\u63a0\u596a\u8005\u7fa4\uff0c\u518d\u5207\u63db\u5230\u72d9\u64ca\u6b65\u69cd\u5f9e\u9060\u8ddd\u96e2\u6d88\u6ec5\u91cd\u6a5f\u69cd\u624b\u3002\u59cb\u7d42\u651c\u5e36\u5404\u7a2e\u6b66\u5668\u4f86\u61c9\u5c0d\u5404\u7a2e\u5a01\u8105\u3002"}, {"question": "\u300a\u751f\u5b58\u7af6\u8cfd\u300b\u4e2d\u7684\u88dd\u7532\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u300a\u751f\u5b58\u7af6\u8cfd\u300b\u4e2d\u7684\u88dd\u7532\u7cfb\u7d71\u63d0\u4f9b\u984d\u5916\u7684\u4fdd\u8b77\u5c64\u4f86\u62b5\u79a6\u50b7\u5bb3\u3002\u88dd\u7532\u6703\u5438\u6536\u60a8\u6240\u53d7\u5230\u50b7\u5bb3\u7684\u4e00\u90e8\u5206\uff0c\u964d\u4f4e\u5c0d\u751f\u547d\u503c\u7684\u5f71\u97ff\u3002\u53ef\u4ee5\u5728\u5404\u95dc\u5361\u4e2d\u64bf\u53d6\u6563\u843d\u7684\u88dd\u7532\u5305\u4f86\u88dc\u5145\u88dd\u7532\u3002\u4f8b\u5982\uff0c\u5728\u300e\u57ce\u5e02\u5ee2\u589f\u300f\u95dc\u5361\u4e2d\uff0c\u53ef\u4ee5\u5728\u5730\u4e0b\u505c\u8eca\u5834\u627e\u5230\u88dd\u7532\u5305\u3002\u60a8\u80fd\u651c\u5e36\u7684\u88dd\u7532\u6578\u91cf\u6709\u9650\uff0c\u56e0\u6b64\u5fc5\u9808\u7b56\u7565\u6027\u5730\u4f7f\u7528\u5b83\u3002\u7576\u88dd\u7532\u8017\u76e1\u6642\uff0c\u60a8\u5c07\u6703\u76f4\u63a5\u53d7\u5230\u50b7\u5bb3\uff0c\u6240\u4ee5\u8acb\u96a8\u6642\u6ce8\u610f\u88dd\u7532\u7b49\u7d1a\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u8cc7\u6e90\u7ba1\u7406\u5728\u300a\u751f\u5b58\u7af6\u8cfd\u300b\u4e2d\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u5728\u300a\u751f\u5b58\u7af6\u8cfd\u300b\u4e2d\uff0c\u8cc7\u6e90\u7ba1\u7406\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u76f4\u63a5\u5f71\u97ff\u60a8\u751f\u5b58\u548c\u9032\u5c55\u7684\u80fd\u529b\u3002\u5b50\u5f48\u3001\u88dc\u7d66\u5305\u548c\u88dd\u7532\u6578\u91cf\u6709\u9650\uff0c\u6d6a\u8cbb\u5b83\u5011\u6703\u8b93\u60a8\u5728\u95dc\u9375\u6642\u523b\u8655\u65bc\u5f31\u52e2\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5c71\u5340\u901a\u9053\u300f\u95dc\u5361\u4e2d\uff0c\u901a\u904e\u5c0d\u8f03\u5f31\u6575\u4eba\u4f7f\u7528\u8fd1\u8eab\u653b\u64ca\u4f86\u7bc0\u7d04\u5f48\u85e5\uff0c\u53ef\u4ee5\u70ba\u5c0d\u4ed8\u50cf\u300e\u5766\u514b\u300f\u9019\u6a23\u7684\u5f37\u6575\u5132\u5099\u5f48\u85e5\u3002\u6b64\u5916\uff0c\u8acb\u59cb\u7d42\u512a\u5148\u64bf\u53d6\u627e\u5230\u7684\u8cc7\u6e90\uff0c\u5373\u4f7f\u60a8\u76ee\u524d\u4e0d\u9700\u8981\u5b83\u5011\u3002\u6709\u6548\u7684\u8cc7\u6e90\u7ba1\u7406\u5c07\u78ba\u4fdd\u60a8\u96a8\u6642\u6e96\u5099\u8fce\u63a5\u4e0b\u4e00\u500b\u6311\u6230\u3002"}, {"question": "\u300a\u751f\u5b58\u7af6\u8cfd\u300b\u4e2d\u5404\u7a2e\u96e3\u5ea6\u7b49\u7d1a\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "\u300a\u751f\u5b58\u7af6\u8cfd\u300b\u4e2d\u5404\u7a2e\u96e3\u5ea6\u7b49\u7d1a\u7684\u4e3b\u8981\u5dee\u7570\u5728\u65bc\u6575\u4eba\u7684\u5f37\u5ea6\u3001\u8cc7\u6e90\u7684\u8c50\u5ea6\u548c\u6aa2\u67e5\u9ede\u7684\u983b\u7387\u3002\u300e\u7c21\u55ae\u300f\u6a21\u5f0f\u4e0b\uff0c\u6575\u4eba\u9020\u6210\u7684\u50b7\u5bb3\u8f03\u4f4e\uff0c\u8cc7\u6e90\u4e5f\u8f03\u8c50\u5bcc\u3002\u300e\u666e\u901a\u300f\u6a21\u5f0f\u63d0\u4f9b\u5e73\u8861\u7684\u904a\u6232\u9ad4\u9a57\uff0c\u6575\u4eba\u7684\u5f37\u5ea6\u548c\u8cc7\u6e90\u7684\u8c50\u5ea6\u90fd\u9069\u4e2d\u3002\u300e\u56f0\u96e3\u300f\u6a21\u5f0f\u6703\u589e\u52a0\u6575\u4eba\u7684\u751f\u547d\u503c\u548c\u50b7\u5bb3\uff0c\u540c\u6642\u6e1b\u5c11\u8cc7\u6e90\u548c\u6aa2\u67e5\u9ede\u7684\u6578\u91cf\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5de5\u5ee0\u8907\u5408\u9ad4\u300f\u95dc\u5361\u4e2d\uff0c\u8207\u300e\u7c21\u55ae\u300f\u6a21\u5f0f\u76f8\u6bd4\uff0c\u5728\u300e\u56f0\u96e3\u300f\u6a21\u5f0f\u4e0b\uff0c\u60a8\u5c07\u9047\u5230\u66f4\u591a\u6575\u4eba\uff0c\u4f46\u88dc\u7d66\u5305\u4e5f\u6703\u6e1b\u5c11\u3002\u8acb\u9078\u64c7\u8207\u60a8\u7684\u6280\u80fd\u548c\u7d93\u9a57\u76f8\u7b26\u7684\u96e3\u5ea6\u7b49\u7d1a\uff0c\u4ee5\u7372\u5f97\u6700\u4f73\u7684\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u751f\u5b58\u7af6\u8cfd\u300b\u4e2d\u91dd\u5c0d\u4e0d\u540c\u95dc\u5361\u6700\u4f73\u5316\u89d2\u8272\u88dd\u5099\uff1f", "answer": "\u5728\u300a\u751f\u5b58\u7af6\u8cfd\u300b\u4e2d\uff0c\u91dd\u5c0d\u4e0d\u540c\u95dc\u5361\u6700\u4f73\u5316\u89d2\u8272\u88dd\u5099\u5305\u62ec\u9078\u64c7\u9069\u5408\u5373\u5c07\u8fce\u6230\u6311\u6230\u7684\u6b66\u5668\u548c\u88dd\u5099\u3002\u6b65\u9a5f 1\uff1a\u8a55\u4f30\u95dc\u5361\u74b0\u5883\u548c\u6575\u4eba\u985e\u578b\u3002\u4f8b\u5982\uff0c\u5728\u300e\u6cbc\u6fa4\u5730\u300f\u95dc\u5361\u4e2d\uff0c\u60a8\u5c07\u9762\u5c0d\u8a31\u591a\u8fd1\u8ddd\u96e2\u6575\u4eba\uff0c\u56e0\u6b64\u8acb\u88dd\u5099\u9730\u5f48\u69cd\u548c\u8fd1\u6230\u6b66\u5668\u3002\u6b65\u9a5f 2\uff1a\u5c07\u60a8\u7684\u88dd\u5099\u5e73\u8861\u70ba\u8fd1\u3001\u4e2d\u548c\u9060\u8ddd\u96e2\u6b66\u5668\u7684\u6df7\u5408\u3002\u6b65\u9a5f 3\uff1a\u59cb\u7d42\u651c\u5e36\u4e00\u4e9b\u624b\u69b4\u5f48\u6216\u7206\u70b8\u7269\uff0c\u4ee5\u61c9\u5c0d\u6575\u4eba\u7fa4\u6216\u96e3\u7e8f\u7684 boss\u3002\u6839\u64da\u95dc\u5361\u7684\u7279\u5b9a\u9700\u6c42\u8abf\u6574\u60a8\u7684\u88dd\u5099\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u60a8\u7684\u6548\u7387\u3002"}, {"question": "\u300a\u751f\u5b58\u7af6\u8cfd\u300b\u7684\u8de8\u5e73\u53f0\u76f8\u5bb9\u6027\u9078\u9805\u662f\u4ec0\u9ebc\uff1f", "answer": "\u300a\u751f\u5b58\u7af6\u8cfd\u300b\u63d0\u4f9b\u8de8\u5e73\u53f0\u76f8\u5bb9\u6027\uff0c\u8b93\u73a9\u5bb6\u80fd\u5920\u5728\u591a\u500b\u88dd\u7f6e\u4e0a\u4eab\u53d7\u904a\u6232\u3002\u904a\u6232\u652f\u63f4\u8de8\u5132\u5b58\u529f\u80fd\uff0c\u8b93\u60a8\u53ef\u4ee5\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u9593\u8f49\u79fb\u60a8\u7684\u904a\u6232\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u60a8\u53ef\u4ee5\u5728\u96fb\u8166\u4e0a\u958b\u59cb\u904a\u6232\uff0c\u7136\u5f8c\u7e7c\u7e8c\u5728\u4e3b\u6a5f\u4e0a\u904a\u6232\uff0c\u800c\u4e0d\u6703\u907a\u5931\u4efb\u4f55\u9032\u5ea6\u3002\u6b64\u5916\uff0c\u8de8\u5e73\u53f0\u591a\u4eba\u904a\u6232\u4e5f\u53ef\u7528\uff0c\u8b93\u60a8\u80fd\u5920\u8207\u670b\u53cb\u7d44\u968a\uff0c\u800c\u7121\u8ad6\u4ed6\u5011\u4f7f\u7528\u7684\u88dd\u7f6e\u70ba\u4f55\u3002\u8acb\u78ba\u4fdd\u60a8\u64c1\u6709\u7a69\u5b9a\u7684\u7db2\u8def\u9023\u7dda\uff0c\u4e26\u9023\u7d50\u4e0d\u540c\u5e73\u53f0\u7684\u5e33\u6236\uff0c\u4ee5\u5145\u5206\u5229\u7528\u9019\u4e9b\u529f\u80fd\u3002"}, {"question": "\u300a\u751f\u5b58\u7af6\u8cfd\u300b\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\uff1f", "answer": "\u300a\u751f\u5b58\u7af6\u8cfd\u300b\u5145\u6eff\u4e86\u96b1\u85cf\u7684\u5f69\u86cb\uff0c\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u984d\u5916\u7684\u6a02\u8da3\u3002\u4e00\u500b\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\u300e\u958b\u767c\u5718\u968a\u623f\u9593\u300f\uff0c\u5b83\u96b1\u85cf\u5728\u300e\u5de5\u5ee0\u8907\u5408\u9ad4\u300f\u95dc\u5361\u4e2d\u3002\u8981\u627e\u5230\u5b83\uff0c\u8acb\u5c0b\u627e\u7246\u4e0a\u7279\u5b9a\u5857\u9d09\uff0c\u4e26\u6309\u7167\u7279\u5b9a\u9806\u5e8f\u8207\u5b83\u5011\u4e92\u52d5\u3002\u4e00\u65e6\u9032\u5165\uff0c\u60a8\u5c31\u6703\u767c\u73fe\u4e00\u500b\u5145\u6eff\u958b\u767c\u7b46\u8a18\u548c\u6982\u5ff5\u7f8e\u8853\u7684\u623f\u9593\u3002\u53e6\u4e00\u500b\u5f69\u86cb\u662f\u300e\u5fa9\u53e4\u8857\u6a5f\u300f\uff0c\u5b83\u96b1\u85cf\u5728\u300e\u57ce\u5e02\u5ee2\u589f\u300f\u95dc\u5361\u4e2d\uff0c\u60a8\u53ef\u4ee5\u5728\u90a3\u88e1\u73a9\u5230\u985e\u4f3c\u7d93\u5178\u8857\u6a5f\u5c04\u64ca\u904a\u6232\u7684\u5c0f\u904a\u6232\u3002\u63a2\u7d22\u6bcf\u500b\u89d2\u843d\u90fd\u6709\u53ef\u80fd\u767c\u73fe\u9019\u4e9b\u96b1\u85cf\u7684\u5bf6\u85cf\u3002"}, {"question": "\u300a\u751f\u5b58\u7af6\u8cfd\u300b\u7684\u5206\u6578\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u300a\u751f\u5b58\u7af6\u8cfd\u300b\u7684\u5206\u6578\u7cfb\u7d71\u57fa\u65bc\u591a\u500b\u56e0\u7d20\uff0c\u5305\u62ec\u64ca\u6bba\u6578\u3001\u7206\u982d\u6578\u3001\u547d\u4e2d\u7387\u548c\u6642\u9593\u3002\u6bcf\u6b21\u64ca\u6bba\u90fd\u6703\u7372\u5f97\u5206\u6578\uff0c\u7206\u982d\u548c\u6f5b\u884c\u64ca\u6bba\u6703\u984d\u5916\u7372\u5f97\u5206\u6578\u3002\u547d\u4e2d\u7387\u662f\u8a08\u7b97\u6210\u529f\u7684\u5c04\u64ca\u6bd4\u4f8b\uff0c\u66f4\u9ad8\u7684\u547d\u4e2d\u7387\u6703\u7372\u5f97\u66f4\u591a\u5206\u6578\u3002\u6b64\u5916\uff0c\u66f4\u5feb\u5730\u5b8c\u6210\u5404\u95dc\u5361\u6703\u7372\u5f97\u6642\u9593\u734e\u52f5\u3002\u4f8b\u5982\uff0c\u5728\u300e\u53e2\u6797\u5ee2\u589f\u300f\u95dc\u5361\u4e2d\uff0c\u9ad8\u547d\u4e2d\u7387\u548c\u5feb\u901f\u5b8c\u6210\u95dc\u5361\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u60a8\u7684\u5206\u6578\u3002\u8ffd\u6c42\u7cbe\u6e96\u6027\u548c\u6548\u7387\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u60a8\u7684\u5206\u6578\u4e26\u6500\u767b\u6392\u884c\u699c\u3002"}]
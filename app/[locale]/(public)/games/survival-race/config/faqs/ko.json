[{"question": "\uc11c\ubc14\uc774\ubc8c \ub808\uc774\uc2a4\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc11c\ubc14\uc774\ubc8c \ub808\uc774\uc2a4\ub97c \uc2dc\uc791\ud558\ub824\uba74 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc5d0 \uc775\uc219\ud574\uc838\uc57c \ud569\ub2c8\ub2e4. \uc67c\ucabd \uc870\uc774\uc2a4\ud2f1\uc774\ub098 \ud654\uc0b4\ud45c \ud0a4\ub294 \uc774\ub3d9\uc5d0 \uc0ac\uc6a9\ub418\uba70, \uc624\ub978\ucabd \uc870\uc774\uc2a4\ud2f1\uc774\ub098 \ub9c8\uc6b0\uc2a4\ub294 \uce74\uba54\ub77c\ub97c \uc81c\uc5b4\ud569\ub2c8\ub2e4. 'A' \ubc84\ud2bc\uc774\ub098 \uc2a4\ud398\uc774\uc2a4\ubc14\ub294 \uc810\ud504\ub97c \uc704\ud574 \uc0ac\uc6a9\ub418\uace0, 'B' \ubc84\ud2bc\uc774\ub098 'E' \ud0a4\ub294 \ubb3c\uccb4\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\ub294 \ub370 \uc0ac\uc6a9\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccb4\ub825 \ud68c\ubcf5 \ud0a4\ud2b8\ub97c \uc90d\uae30 \uc704\ud574\uc11c\ub294 \ud0a4\ud2b8\uc5d0 \uc811\uadfc\ud558\uc5ec 'B' \ubc84\ud2bc\uc744 \ub204\ub974\uc138\uc694. \ub610\ud55c, 'X' \ubc84\ud2bc\uc774\ub098 'Q' \ud0a4\ub294 \uc801\uc744 \uacf5\uaca9\ud558\ub294 \ub370 \uc0ac\uc6a9\ub429\ub2c8\ub2e4. \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\uace0\uc790 \ud55c\ub2e4\uba74 \ud29c\ud1a0\ub9ac\uc5bc \ub808\ubca8\uc5d0\uc11c \uc774\ub7ec\ud55c \ucee8\ud2b8\ub864\uc744 \uc5f0\uc2b5\ud558\uc138\uc694."}, {"question": "\uc11c\ubc14\uc774\ubc8c \ub808\uc774\uc2a4\uc5d0\uc11c \ub354 \uc624\ub798 \uc0dd\uc874\ud558\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc11c\ubc14\uc774\ubc8c \ub808\uc774\uc2a4\uc5d0\uc11c \ub354 \uc624\ub798 \uc0dd\uc874\ud558\ub824\uba74 \uc804\ub7b5\uacfc \uae30\uc220\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc41: \ud56d\uc0c1 \uccb4\ub825\uacfc \ubc29\uc5b4\ub825\uc744 \uc8fc\uc2dc\ud558\uc138\uc694. \uccb4\ub825 \ud68c\ubcf5 \ud0a4\ud2b8\uc640 \ubc29\uc5b4\ub825 \uc544\uc774\ud15c\uc744 \ubc1c\uacac\ud558\ub294 \uc989\uc2dc \uc0ac\uc6a9\ud558\uc138\uc694. \ub2e8\uacc42: \uc790\uc6d0\uc744 \ud604\uba85\ud558\uac8c \uad00\ub9ac\ud558\uc138\uc694. \uc57d\ud55c \uc801\uc5d0\uac8c\ub294 \ud0c4\uc57d\uc744 \ub0ad\ube44\ud558\uc9c0 \ub9d0\uace0, \uadfc\uc811 \uacf5\uaca9\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. \ub2e8\uacc43: \uc6c0\uc9c1\uc784\uc744 \uc720\uc9c0\ud558\uc138\uc694. \uc815\uc9c0\ud574 \uc788\ub294 \uac83\uc740 \uc27d\uac8c \ud45c\uc801\uc774 \ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc0ac\ub9c9 \uc804\ucd08 \uae30\uc9c0' \ub808\ubca8\uc5d0\uc11c\ub294 \ubaa8\ub798 \uc5b8\ub355\uc744 \uc774\uc6a9\ud558\uc5ec \uc740\uc2e0\ucc98\ub85c \uc0bc\uace0 \uc801\uc758 \uacf5\uaca9\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uacc4\uc18d \uc6c0\uc9c1\uc774\uc138\uc694. \ub610\ud55c, \uc801\uc758 \ucd9c\ud604 \uc9c0\uc810\uc744 \ud30c\uc545\ud558\uc5ec \uacf5\uaca9\uc744 \uc608\uce21\ud558\uace0 \ud6a8\uacfc\uc801\uc73c\ub85c \ub300\uc751\ud558\ub294 \ubc95\uc744 \ubc30\uc6b0\uc138\uc694."}, {"question": "\uc11c\ubc14\uc774\ubc8c \ub808\uc774\uc2a4\uc5d0\uc11c \ub2e4\uc591\ud55c \uc801 \uc885\ub958\uc5d0 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ubb34\uae30\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc11c\ubc14\uc774\ubc8c \ub808\uc774\uc2a4\uc5d0\uc11c \uac01 \ubb34\uae30\ub294 \ud2b9\uc815 \uc801 \uc885\ub958\uc5d0 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. \uc0b0\ud0c4\ucd1d\uc740 \uadfc\uc811\uc804\uc5d0 \ud6a8\uacfc\uc801\uc774\uba70, \ud2b9\ud788 '\ub7a9\ud130 \ubb34\ub9ac'\uc640 \uac19\uc740 \ube60\ub974\uac8c \uc6c0\uc9c1\uc774\ub294 \uc801\uc5d0\uac8c \uc88b\uc2b5\ub2c8\ub2e4. \ub3cc\uaca9 \uc18c\ucd1d\uc740 \uc911\uac70\ub9ac \uc801, \uc608\ub97c \ub4e4\uc5b4 '\uc57d\ud0c8\uc790'\uc5d0\uac8c \ub2e4\uc7ac\ub2e4\ub2a5\ud558\uace0 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. \uc7a5\uac70\ub9ac \uad50\uc804\uc5d0\uc11c\ub294 \uc800\uaca9 \uc18c\ucd1d\uc774 '\uc800\uaca9\uc218'\uc640 '\uc911\ud654\uae30\ubcd1'\uc744 \uc81c\uac70\ud558\ub294 \ub370 \uc774\uc0c1\uc801\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc815\uae00 \ud3d0\ud5c8' \ub808\ubca8\uc5d0\uc11c\ub294 \uc0b0\ud0c4\ucd1d\uc73c\ub85c \ub7a9\ud130 \ubb34\ub9ac\ub97c \uc81c\uac70\ud558\uace0 \uc800\uaca9 \uc18c\ucd1d\uc73c\ub85c \uba40\ub9ac\uc11c \uc911\ud654\uae30\ubcd1\uc744 \uc81c\uac70\ud558\uc138\uc694. \ub2e4\uc591\ud55c \uc704\ud611\uc5d0 \ub300\ucc98\ud558\uae30 \uc704\ud574 \uc5ec\ub7ec \uc885\ub958\uc758 \ubb34\uae30\ub97c \ud56d\uc0c1 \ud734\ub300\ud558\uc138\uc694."}, {"question": "\uc11c\ubc14\uc774\ubc8c \ub808\uc774\uc2a4\uc758 \ubc29\uc5b4 \uc7a5\ube44 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "\uc11c\ubc14\uc774\ubc8c \ub808\uc774\uc2a4\uc758 \ubc29\uc5b4 \uc7a5\ube44 \uc2dc\uc2a4\ud15c\uc740 \ud53c\ud574\ub97c \ub9c9\ub294 \ucd94\uac00\uc801\uc778 \ubcf4\ud638 \uae30\ub2a5\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ubc29\uc5b4 \uc7a5\ube44\ub294 \ubc1b\ub294 \ud53c\ud574\uc758 \uc77c\ubd80\ub97c \ud761\uc218\ud558\uc5ec \uccb4\ub825\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc744 \uc904\uc5ec\uc90d\ub2c8\ub2e4. \ubc29\uc5b4 \uc7a5\ube44\ub294 \ub808\ubca8 \uacf3\uacf3\uc5d0 \ud769\uc5b4\uc838 \uc788\ub294 \ubc29\uc5b4 \uc7a5\ube44 \ud0a4\ud2b8\ub97c \ud68d\ub4dd\ud558\uc5ec \ubcf4\ucda9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub3c4\uc2dc \ud3d0\ud5c8' \ub808\ubca8\uc5d0\uc11c\ub294 \uc9c0\ud558 \uc8fc\ucc28\uc7a5\uc5d0\uc11c \ubc29\uc5b4 \uc7a5\ube44 \ud0a4\ud2b8\ub97c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud734\ub300\ud560 \uc218 \uc788\ub294 \ubc29\uc5b4 \uc7a5\ube44\uc758 \uc591\uc5d0\ub294 \ud55c\uacc4\uac00 \uc788\uc73c\ubbc0\ub85c \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \ubc29\uc5b4 \uc7a5\ube44\uac00 \uc18c\uc9c4\ub418\uba74 \uccb4\ub825\uc5d0 \uc9c1\uc811\uc801\uc778 \ud53c\ud574\ub97c \uc785\uac8c \ub418\ubbc0\ub85c \ud56d\uc0c1 \ubc29\uc5b4 \uc7a5\ube44 \uc218\uc900\uc744 \uc8fc\uc758 \uae4a\uac8c \ud655\uc778\ud558\uc138\uc694."}, {"question": "\uc11c\ubc14\uc774\ubc8c \ub808\uc774\uc2a4\uc5d0\uc11c \uc790\uc6d0 \uad00\ub9ac\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc11c\ubc14\uc774\ubc8c \ub808\uc774\uc2a4\uc5d0\uc11c \uc790\uc6d0 \uad00\ub9ac\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \uc0dd\uc874\uacfc \uc9c4\ud589\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \ud0c4\uc57d, \uccb4\ub825 \ud68c\ubcf5 \ud0a4\ud2b8, \ubc29\uc5b4 \uc7a5\ube44\ub294 \ud55c\uc815\uc801\uc774\uba70, \uc774\ub97c \ub0ad\ube44\ud558\uba74 \uc704\uae09\ud55c \uc21c\uac04 \ucde8\uc57d\ud574\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc0b0\uc545 \uace0\uac1c' \ub808\ubca8\uc5d0\uc11c\ub294 \uc57d\ud55c \uc801\uc5d0\uac8c \uadfc\uc811 \uacf5\uaca9\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud0c4\uc57d\uc744 \uc808\uc57d\ud558\uc5ec '\ud0f1\ud06c'\uc640 \uac19\uc740 \uac15\ub825\ud55c \uc801\uc5d0\uac8c \ud0c4\uc57d\uc744 \uc544\uaef4 \uc4f8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \ud544\uc694\ud558\uc9c0 \uc54a\ub354\ub77c\ub3c4 \uc790\uc6d0\uc744 \ubc1c\uacac\ud558\ub294 \uc989\uc2dc \ud68d\ub4dd\ud558\ub294 \uac83\uc774 \ud56d\uc0c1 \uc911\uc694\ud569\ub2c8\ub2e4. \ud6a8\uc728\uc801\uc778 \uc790\uc6d0 \uad00\ub9ac\ub97c \ud1b5\ud574 \ub2e4\uc74c \ub3c4\uc804\uc5d0 \ud56d\uc0c1 \ub300\ube44\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc11c\ubc14\uc774\ubc8c \ub808\uc774\uc2a4\uc758 \ub2e4\uc591\ud55c \ub09c\uc774\ub3c4 \ub808\ubca8 \uac04\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc11c\ubc14\uc774\ubc8c \ub808\uc774\uc2a4\uc758 \ub09c\uc774\ub3c4 \ub808\ubca8 \uac04\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \uc801\uc758 \uac15\ub3c4, \uc790\uc6d0\uc758 \uac00\uc6a9\uc131, \uccb4\ud06c\ud3ec\uc778\ud2b8\uc758 \ube48\ub3c4\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. '\uc26c\uc6c0' \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uc801\uc758 \ud53c\ud574\ub7c9\uc774 \uc801\uace0 \uc790\uc6d0\uc774 \ud48d\ubd80\ud569\ub2c8\ub2e4. '\ubcf4\ud1b5' \ubaa8\ub4dc\ub294 \uc801\uc808\ud55c \uc801\uc758 \uac15\ub3c4\uc640 \uc790\uc6d0\uc758 \uac00\uc6a9\uc131\uc73c\ub85c \uade0\ud615 \uc7a1\ud78c \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. '\uc5b4\ub824\uc6c0' \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uc801\uc758 \uccb4\ub825\uacfc \ud53c\ud574\ub7c9\uc774 \uc99d\uac00\ud558\uace0 \uc790\uc6d0\uacfc \uccb4\ud06c\ud3ec\uc778\ud2b8\uc758 \uc218\uac00 \uc904\uc5b4\ub4ed\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uacf5\uc7a5 \ub2e8\uc9c0' \ub808\ubca8\uc5d0\uc11c\ub294 '\uc26c\uc6c0' \ubaa8\ub4dc\ubcf4\ub2e4 '\uc5b4\ub824\uc6c0' \ubaa8\ub4dc\uc5d0\uc11c \uc801\uc774 \ub354 \ub9ce\uace0 \uccb4\ub825 \ud68c\ubcf5 \ud0a4\ud2b8\uac00 \uc801\uc2b5\ub2c8\ub2e4. \ucd5c\uace0\uc758 \uac8c\uc784 \uacbd\ud5d8\uc744 \uc704\ud574 \uc790\uc2e0\uc758 \uae30\uc220\uacfc \uacbd\ud5d8\uc5d0 \ub9de\ub294 \ub09c\uc774\ub3c4 \ub808\ubca8\uc744 \uc120\ud0dd\ud558\uc138\uc694."}, {"question": "\uc11c\ubc14\uc774\ubc8c \ub808\uc774\uc2a4\uc5d0\uc11c \ub2e4\uc591\ud55c \ub808\ubca8\uc5d0 \ub9de\ucdb0 \uce90\ub9ad\ud130 \uc7a5\ube44\ub97c \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc11c\ubc14\uc774\ubc8c \ub808\uc774\uc2a4\uc5d0\uc11c \ub2e4\uc591\ud55c \ub808\ubca8\uc5d0 \ub9de\ucdb0 \uce90\ub9ad\ud130 \uc7a5\ube44\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc55e\uc73c\ub85c\uc758 \ub3c4\uc804\uc5d0 \uc801\ud569\ud55c \ubb34\uae30\uc640 \uc7a5\ube44\ub97c \uc120\ud0dd\ud574\uc57c \ud569\ub2c8\ub2e4. \ub2e8\uacc41: \ub808\ubca8\uc758 \ud658\uacbd\uacfc \uc801\uc758 \uc885\ub958\ub97c \ud3c9\uac00\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\ub2aa\uc9c0\ub300' \ub808\ubca8\uc5d0\uc11c\ub294 \uadfc\uc811 \uacf5\uaca9 \uc801\ub4e4\uc774 \ub9ce\uc73c\ubbc0\ub85c \uc0b0\ud0c4\ucd1d\uacfc \uadfc\uc811 \ubb34\uae30\ub97c \uc7a5\ube44\ud558\uc138\uc694. \ub2e8\uacc42: \uadfc\uc811, \uc911\uac70\ub9ac, \uc6d0\uac70\ub9ac \ubb34\uae30\uc758 \ud63c\ud569\uc73c\ub85c \uc7a5\ube44\ub97c \uade0\ud615 \uc788\uac8c \uad6c\uc131\ud558\uc138\uc694. \ub2e8\uacc43: \uc801\uad70 \uadf8\ub8f9\uc774\ub098 \uac15\ub825\ud55c \ubcf4\uc2a4\ub97c \uc0c1\ub300\ud558\uae30 \uc704\ud574 \uc218\ub958\ud0c4\uc774\ub098 \ud3ed\ubc1c\ubb3c\uc744 \ud56d\uc0c1 \ud734\ub300\ud558\uc138\uc694. \ub808\ubca8\uc758 \ud2b9\uc815 \uc694\uad6c\uc0ac\ud56d\uc5d0 \ub530\ub77c \uc7a5\ube44\ub97c \uc870\uc815\ud558\uc5ec \ud6a8\uacfc\ub97c \uadf9\ub300\ud654\ud558\uc138\uc694."}, {"question": "\uc11c\ubc14\uc774\ubc8c \ub808\uc774\uc2a4\uc758 \ub2e4\uc911 \ud50c\ub7ab\ud3fc \ud638\ud658 \uc635\uc158\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc11c\ubc14\uc774\ubc8c \ub808\uc774\uc2a4\ub294 \ub2e4\uc911 \ud50c\ub7ab\ud3fc \ud638\ud658 \uae30\ub2a5\uc744 \uc81c\uacf5\ud558\uc5ec \ud50c\ub808\uc774\uc5b4\uac00 \uc5ec\ub7ec \uae30\uae30\uc5d0\uc11c \uac8c\uc784\uc744 \uc990\uae38 \uc218 \uc788\ub3c4\ub85d \uc9c0\uc6d0\ud569\ub2c8\ub2e4. \uac8c\uc784\uc740 \ud06c\ub85c\uc2a4 \uc138\uc774\ube0c \uae30\ub2a5\uc744 \uc9c0\uc6d0\ud558\uc5ec \ud50c\ub7ab\ud3fc \uac04\uc5d0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \uac8c\uc784\uc744 \uc2dc\uc791\ud558\uc5ec \ucf58\uc194\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc783\uc9c0 \uc54a\uace0 \uacc4\uc18d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \ub2e4\uc911 \ud50c\ub7ab\ud3fc \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uae30\uae30\uc640 \uc0c1\uad00\uc5c6\uc774 \uce5c\uad6c\ub4e4\uacfc \ud300\uc744 \uc774\ub8f0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uae30\ub2a5\uc744 \ucd5c\ub300\ud55c \ud65c\uc6a9\ud558\ub824\uba74 \uc548\uc815\uc801\uc778 \uc778\ud130\ub137 \uc5f0\uacb0\uc744 \uc720\uc9c0\ud558\uace0 \uacc4\uc815\uc744 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \uc5f0\uacb0\ud574\uc57c \ud569\ub2c8\ub2e4."}, {"question": "\uc11c\ubc14\uc774\ubc8c \ub808\uc774\uc2a4\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc11c\ubc14\uc774\ubc8c \ub808\uc774\uc2a4\uc5d0\ub294 \uac8c\uc784\uc5d0 \uc7ac\ubbf8\ub97c \ub354\ud558\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uac00\ub4dd\ud569\ub2c8\ub2e4. \uc8fc\ubaa9\ud560 \ub9cc\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 '\uacf5\uc7a5 \ub2e8\uc9c0' \ub808\ubca8\uc5d0 \uc228\uaca8\uc9c4 '\uac1c\ubc1c\uc790\uc758 \ubc29'\uc785\ub2c8\ub2e4. \ubc29\uc744 \ucc3e\uc73c\ub824\uba74 \ubcbd\uc5d0 \ud2b9\uc815 \uadf8\ub9bc\uc744 \ucc3e\uace0 \ud2b9\uc815 \uc21c\uc11c\ub300\ub85c \uc0c1\ud638 \uc791\uc6a9\ud558\uc138\uc694. \uc548\uc73c\ub85c \ub4e4\uc5b4\uac00\uba74 \uac1c\ubc1c\uc790 \uba54\ubaa8\uc640 \ucee8\uc149 \uc544\ud2b8\uac00 \uac00\ub4dd\ud55c \ubc29\uc744 \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 '\ub3c4\uc2dc \ud3d0\ud5c8' \ub808\ubca8\uc758 '\ub808\ud2b8\ub85c \uc544\ucf00\uc774\ub4dc'\ub85c, \ud074\ub798\uc2dd \uc544\ucf00\uc774\ub4dc \uc288\ud305 \uac8c\uc784\uc744 \uc5f0\uc0c1\uc2dc\ud0a4\ub294 \ubbf8\ub2c8 \uac8c\uc784\uc744 \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubaa8\ub4e0 \uad6c\uc11d\uad6c\uc11d\uc744 \ud0d0\ud5d8\ud558\uba74 \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uc744 \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc11c\ubc14\uc774\ubc8c \ub808\uc774\uc2a4\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "\uc11c\ubc14\uc774\ubc8c \ub808\uc774\uc2a4\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ud0ac, \ud5e4\ub4dc\uc0f7, \uc815\ud655\ub3c4 \ubc0f \uc2dc\uac04\uc744 \ud3ec\ud568\ud55c \uc5ec\ub7ec \uc694\uc18c\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uac01 \ud0ac\uc740 \uc810\uc218\ub97c \uc81c\uacf5\ud558\uba70, \ud5e4\ub4dc\uc0f7\uacfc \u30b9\u30c6\u30eb\uc2a4 \ud0ac\uc5d0\ub294 \ubcf4\ub108\uc2a4 \uc810\uc218\uac00 \ubd80\uc5ec\ub429\ub2c8\ub2e4. \uc815\ud655\ub3c4\ub294 \uc131\uacf5\ud55c \uc0f7\uc758 \ubc31\ubd84\uc728\ub85c \uacc4\uc0b0\ub418\uba70, \uc815\ud655\ub3c4\uac00 \ub192\uc744\uc218\ub85d \ub354 \ub9ce\uc740 \uc810\uc218\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \ub808\ubca8\uc744 \ub354 \ube68\ub9ac \uc644\ub8cc\ud558\uba74 \uc2dc\uac04 \ubcf4\ub108\uc2a4\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc815\uae00 \ud3d0\ud5c8' \ub808\ubca8\uc5d0\uc11c \ub192\uc740 \uc815\ud655\ub3c4\ub97c \ub2ec\uc131\ud558\uace0 \ub808\ubca8\uc744 \ube60\ub974\uac8c \uc644\ub8cc\ud558\uba74 \uc810\uc218\uac00 \ud06c\uac8c \ud5a5\uc0c1\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc815\ud655\uc131\uacfc \ud6a8\uc728\uc131\uc744 \ucd94\uad6c\ud558\uc5ec \uc810\uc218\ub97c \uadf9\ub300\ud654\ud558\uace0 \ub9ac\ub354\ubcf4\ub4dc\ub97c \uc0c1\uc704\ub85c \uc62c\ub77c\uac00\uc138\uc694."}]
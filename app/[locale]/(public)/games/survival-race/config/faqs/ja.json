[{"question": "\u30b5\u30d0\u30a4\u30d0\u30eb\u30ec\u30fc\u30b9\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3067\u59cb\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30b5\u30d0\u30a4\u30d0\u30eb\u30ec\u30fc\u30b9\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u7406\u89e3\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u5de6\u306e\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u307e\u305f\u306f\u65b9\u5411\u30ad\u30fc\u3067\u79fb\u52d5\u3057\u3001\u53f3\u306e\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u307e\u305f\u306f\u30de\u30a6\u30b9\u3067\u30ab\u30e1\u30e9\u3092\u64cd\u4f5c\u3057\u307e\u3059\u3002'A'\u30dc\u30bf\u30f3\u307e\u305f\u306f\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u3067\u30b8\u30e3\u30f3\u30d7\u3057\u3001'B'\u30dc\u30bf\u30f3\u307e\u305f\u306f'E'\u30ad\u30fc\u3067\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3068\u5bfe\u8a71\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30d8\u30eb\u30b9\u30dd\u30fc\u30b7\u30e7\u30f3\u3092\u53d6\u5f97\u3059\u308b\u306b\u306f\u3001\u305d\u308c\u306b\u8fd1\u3065\u304d\u3001'B'\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001'X'\u30dc\u30bf\u30f3\u307e\u305f\u306f'Q'\u30ad\u30fc\u3067\u6575\u3092\u653b\u6483\u3057\u307e\u3059\u3002\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30ec\u30d9\u30eb\u3067\u3053\u308c\u3089\u306e\u64cd\u4f5c\u3092\u7df4\u7fd2\u3057\u3066\u3001\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u30b5\u30d0\u30a4\u30d0\u30eb\u30ec\u30fc\u30b9\u3067\u3088\u308a\u9577\u304f\u751f\u304d\u6b8b\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b5\u30d0\u30a4\u30d0\u30eb\u30ec\u30fc\u30b9\u3067\u9577\u304f\u751f\u304d\u6b8b\u308b\u306b\u306f\u3001\u6226\u7565\u3068\u30b9\u30ad\u30eb\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5e38\u306b\u81ea\u5206\u306e\u4f53\u529b\u3068\u9632\u5177\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30d8\u30eb\u30b9\u30dd\u30fc\u30b7\u30e7\u30f3\u3068\u9632\u5177\u3092\u62fe\u3063\u305f\u3089\u3059\u3050\u306b\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u8cc7\u6e90\u3092\u8ce2\u304f\u7ba1\u7406\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u5f31\u3044\u6575\u306b\u306f\u5f3e\u85ac\u3092\u7121\u99c4\u306b\u305b\u305a\u3001\u8fd1\u63a5\u653b\u6483\u3092\u4f7f\u7528\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u52d5\u3044\u3066\u3044\u307e\u3057\u3087\u3046\u3002\u3058\u3063\u3068\u3057\u3066\u3044\u308b\u3068\u7c21\u5358\u306b\u6a19\u7684\u306b\u3055\u308c\u3066\u3057\u307e\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u7802\u6f20\u306e\u62e0\u70b9\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u7802\u4e18\u3092\u30ab\u30d0\u30fc\u306b\u4f7f\u3044\u3001\u6575\u306e\u653b\u6483\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u52d5\u304d\u7d9a\u3051\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002\u3055\u3089\u306b\u3001\u6575\u306e\u51fa\u73fe\u5730\u70b9\u3092\u5b66\u3073\u3001\u5f7c\u3089\u306e\u653b\u6483\u3092\u52b9\u679c\u7684\u306b\u4e88\u6e2c\u3057\u3001\u5bfe\u6297\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u30b5\u30d0\u30a4\u30d0\u30eb\u30ec\u30fc\u30b9\u3067\u3001\u3055\u307e\u3056\u307e\u306a\u6575\u306e\u7a2e\u985e\u306b\u5bfe\u3057\u3066\u6700\u3082\u52b9\u679c\u7684\u306a\u6b66\u5668\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b5\u30d0\u30a4\u30d0\u30eb\u30ec\u30fc\u30b9\u3067\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u6b66\u5668\u304c\u7279\u5b9a\u306e\u6575\u306e\u7a2e\u985e\u306b\u5bfe\u3057\u3066\u52b9\u679c\u7684\u3067\u3059\u3002\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\u306f\u3001\u7279\u306b\u300c\u731b\u79bd\u306e\u7fa4\u308c\u300d\u306e\u3088\u3046\u306a\u9ad8\u901f\u79fb\u52d5\u3059\u308b\u6575\u306b\u5bfe\u3057\u3066\u8fd1\u8ddd\u96e2\u6226\u95d8\u306b\u6700\u9069\u3067\u3059\u3002\u30a2\u30b5\u30eb\u30c8\u30e9\u30a4\u30d5\u30eb\u306f\u3001\u4e2d\u8ddd\u96e2\u306e\u6575\u3067\u3042\u308b\u300c\u7565\u596a\u8005\u300d\u306b\u5bfe\u3057\u3066\u591a\u7528\u9014\u3067\u52b9\u679c\u7684\u3067\u3059\u3002\u9577\u8ddd\u96e2\u6226\u95d8\u3067\u306f\u3001\u30b9\u30ca\u30a4\u30d1\u30fc\u30e9\u30a4\u30d5\u30eb\u306f\u300c\u30b9\u30ca\u30a4\u30d1\u30fc\u300d\u3084\u300c\u91cd\u706b\u5668\u5175\u300d\u3092\u5012\u3059\u306e\u306b\u6700\u9069\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30b8\u30e3\u30f3\u30b0\u30eb\u907a\u8de1\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\u3067\u731b\u79bd\u306e\u7fa4\u308c\u3092\u6392\u9664\u3057\u3001\u30b9\u30ca\u30a4\u30d1\u30fc\u30e9\u30a4\u30d5\u30eb\u3067\u9060\u8ddd\u96e2\u304b\u3089\u91cd\u706b\u5668\u5175\u3092\u6392\u9664\u3057\u307e\u3057\u3087\u3046\u3002\u69d8\u3005\u306a\u8105\u5a01\u306b\u5bfe\u51e6\u3059\u308b\u305f\u3081\u306b\u3001\u3055\u307e\u3056\u307e\u306a\u6b66\u5668\u3092\u5e38\u306b\u6301\u3061\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u30b5\u30d0\u30a4\u30d0\u30eb\u30ec\u30fc\u30b9\u306e\u9632\u5177\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30b5\u30d0\u30a4\u30d0\u30eb\u30ec\u30fc\u30b9\u306e\u9632\u5177\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30c0\u30e1\u30fc\u30b8\u304b\u3089\u8ffd\u52a0\u306e\u4fdd\u8b77\u5c64\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u9632\u5177\u306f\u53d7\u3051\u305f\u30c0\u30e1\u30fc\u30b8\u306e\u4e00\u90e8\u3092\u5438\u53ce\u3057\u3001\u4f53\u529b\u306e\u5f71\u97ff\u3092\u8efd\u6e1b\u3057\u307e\u3059\u3002\u9632\u5177\u306f\u3001\u30ec\u30d9\u30eb\u5168\u4f53\u306b\u6563\u3089\u3070\u3063\u3066\u3044\u308b\u9632\u5177\u30d1\u30c3\u30af\u3092\u62fe\u3046\u3053\u3068\u3067\u88dc\u5145\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u90fd\u5e02\u907a\u8de1\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u5730\u4e0b\u99d0\u8eca\u5834\u3067\u9632\u5177\u30d1\u30c3\u30af\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u6301\u3061\u904b\u3073\u3067\u304d\u308b\u9632\u5177\u306e\u91cf\u306f\u9650\u3089\u308c\u3066\u3044\u307e\u3059\u306e\u3067\u3001\u6226\u7565\u7684\u306b\u4f7f\u7528\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u9632\u5177\u304c\u306a\u304f\u306a\u308b\u3068\u4f53\u529b\u3078\u306e\u76f4\u63a5\u7684\u306a\u30c0\u30e1\u30fc\u30b8\u3092\u53d7\u3051\u59cb\u3081\u307e\u3059\u306e\u3067\u3001\u5e38\u306b\u9632\u5177\u30ec\u30d9\u30eb\u3092\u78ba\u8a8d\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u30b5\u30d0\u30a4\u30d0\u30eb\u30ec\u30fc\u30b9\u3067\u8cc7\u6e90\u7ba1\u7406\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u30b5\u30d0\u30a4\u30d0\u30eb\u30ec\u30fc\u30b9\u3067\u8cc7\u6e90\u7ba1\u7406\u304c\u91cd\u8981\u306a\u306e\u306f\u3001\u751f\u5b58\u3068\u9032\u6b69\u306b\u76f4\u63a5\u5f71\u97ff\u3059\u308b\u305f\u3081\u3067\u3059\u3002\u5f3e\u85ac\u3001\u30d8\u30eb\u30b9\u30dd\u30fc\u30b7\u30e7\u30f3\u3001\u9632\u5177\u306f\u9650\u3089\u308c\u3066\u3044\u307e\u3059\u3002\u305d\u308c\u3089\u3092\u7121\u99c4\u306b\u3059\u308b\u3053\u3068\u306f\u3001\u91cd\u8981\u306a\u5834\u9762\u3067\u8106\u5f31\u306b\u306a\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u5c71\u5cb3\u901a\u904e\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u3088\u308a\u5f31\u3044\u6575\u306b\u5bfe\u3059\u308b\u8fd1\u63a5\u653b\u6483\u3067\u5f3e\u85ac\u3092\u7bc0\u7d04\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u5f37\u529b\u306a\u6575\u3067\u3042\u308b\u300c\u6226\u8eca\u300d\u306e\u3088\u3046\u306a\u6575\u306b\u5bfe\u3057\u3066\u5f3e\u85ac\u3092\u7bc0\u7d04\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u5fc5\u8981\u306a\u5834\u5408\u3067\u3082\u3001\u8cc7\u6e90\u3092\u898b\u3064\u3051\u305f\u5834\u5408\u306f\u5e38\u306b\u512a\u5148\u3057\u3066\u62fe\u3044\u307e\u3057\u3087\u3046\u3002\u52b9\u679c\u7684\u306a\u8cc7\u6e90\u7ba1\u7406\u306f\u3001\u5e38\u306b\u6b21\u306e\u6311\u6226\u306b\u5099\u3048\u3066\u3044\u308b\u3053\u3068\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002"}, {"question": "\u30b5\u30d0\u30a4\u30d0\u30eb\u30ec\u30fc\u30b9\u306e\u3055\u307e\u3056\u307e\u306a\u96e3\u6613\u5ea6\u30ec\u30d9\u30eb\u306e\u9593\u306b\u306f\u3001\u3069\u306e\u3088\u3046\u306a\u4e3b\u306a\u9055\u3044\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30b5\u30d0\u30a4\u30d0\u30eb\u30ec\u30fc\u30b9\u306e\u96e3\u6613\u5ea6\u30ec\u30d9\u30eb\u9593\u306e\u4e3b\u306a\u9055\u3044\u306f\u3001\u6575\u306e\u5f37\u3055\u3001\u8cc7\u6e90\u306e\u5165\u624b\u53ef\u80fd\u6027\u3001\u30c1\u30a7\u30c3\u30af\u30dd\u30a4\u30f3\u30c8\u306e\u983b\u5ea6\u3067\u3059\u3002\u7c21\u5358\u30e2\u30fc\u30c9\u3067\u306f\u3001\u6575\u306e\u653b\u6483\u529b\u306f\u4f4e\u304f\u3001\u8cc7\u6e90\u306f\u8c4a\u5bcc\u3067\u3059\u3002\u666e\u901a\u30e2\u30fc\u30c9\u3067\u306f\u3001\u4e2d\u7a0b\u5ea6\u306e\u6575\u306e\u5f37\u3055\u3068\u8cc7\u6e90\u306e\u5165\u624b\u53ef\u80fd\u6027\u3067\u30d0\u30e9\u30f3\u30b9\u306e\u53d6\u308c\u305f\u7d4c\u9a13\u304c\u3067\u304d\u307e\u3059\u3002\u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\u3067\u306f\u3001\u6575\u306e\u4f53\u529b\u3068\u653b\u6483\u529b\u304c\u4e0a\u304c\u308a\u3001\u8cc7\u6e90\u3068\u30c1\u30a7\u30c3\u30af\u30dd\u30a4\u30f3\u30c8\u306e\u6570\u304c\u6e1b\u5c11\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u5de5\u5834\u8907\u5408\u65bd\u8a2d\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u7c21\u5358\u30e2\u30fc\u30c9\u3068\u6bd4\u3079\u3066\u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\u3067\u306f\u3088\u308a\u591a\u304f\u306e\u6575\u3068\u3001\u3088\u308a\u5c11\u306a\u3044\u30d8\u30eb\u30b9\u30dd\u30fc\u30b7\u30e7\u30f3\u306b\u51fa\u304f\u308f\u3057\u307e\u3059\u3002\u6700\u9ad8\u306e\u30b2\u30fc\u30e0\u4f53\u9a13\u306e\u305f\u3081\u306b\u3001\u81ea\u5206\u306e\u30b9\u30ad\u30eb\u3068\u7d4c\u9a13\u306b\u5408\u3063\u305f\u96e3\u6613\u5ea6\u3092\u9078\u629e\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u30b5\u30d0\u30a4\u30d0\u30eb\u30ec\u30fc\u30b9\u3067\u3001\u3055\u307e\u3056\u307e\u306a\u30ec\u30d9\u30eb\u306b\u5408\u308f\u305b\u3066\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u88c5\u5099\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30b5\u30d0\u30a4\u30d0\u30eb\u30ec\u30fc\u30b9\u3067\u3001\u3055\u307e\u3056\u307e\u306a\u30ec\u30d9\u30eb\u306b\u5408\u308f\u305b\u3066\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u88c5\u5099\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u5148\u306b\u3042\u308b\u8ab2\u984c\u306b\u5bfe\u5fdc\u3059\u308b\u9069\u5207\u306a\u6b66\u5668\u3084\u88c5\u5099\u3092\u9078\u629e\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30ec\u30d9\u30eb\u306e\u74b0\u5883\u3068\u6575\u306e\u7a2e\u985e\u3092\u8a55\u4fa1\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u6cbc\u5730\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u591a\u304f\u306e\u8fd1\u63a5\u6575\u306b\u906d\u9047\u3057\u307e\u3059\u306e\u3067\u3001\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\u3068\u8fd1\u63a5\u6b66\u5668\u3092\u88c5\u5099\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u8fd1\u8ddd\u96e2\u3001\u4e2d\u8ddd\u96e2\u3001\u9577\u8ddd\u96e2\u306e\u6b66\u5668\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u88c5\u5099\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6575\u96c6\u56e3\u3084\u5f37\u529b\u306a\u30dc\u30b9\u306b\u5bfe\u51e6\u3059\u308b\u305f\u3081\u306b\u3001\u30b0\u30ec\u30cd\u30fc\u30c9\u3084\u7206\u767a\u7269\u3092\u5e38\u306b\u6301\u3061\u307e\u3057\u3087\u3046\u3002\u30ec\u30d9\u30eb\u306e\u5177\u4f53\u7684\u306a\u8981\u6c42\u306b\u57fa\u3065\u3044\u3066\u88c5\u5099\u3092\u8abf\u6574\u3057\u3066\u3001\u52b9\u679c\u3092\u6700\u5927\u5316\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u30b5\u30d0\u30a4\u30d0\u30eb\u30ec\u30fc\u30b9\u306e\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u4e92\u63db\u6027\u30aa\u30d7\u30b7\u30e7\u30f3\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b5\u30d0\u30a4\u30d0\u30eb\u30ec\u30fc\u30b9\u306f\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u4e92\u63db\u6027\u3092\u5099\u3048\u3066\u304a\u308a\u3001\u8907\u6570\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u30b2\u30fc\u30e0\u3092\u697d\u3057\u3080\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306f\u30af\u30ed\u30b9\u30bb\u30fc\u30d6\u6a5f\u80fd\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u308b\u306e\u3067\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u81ea\u5206\u306e\u9032\u884c\u72b6\u6cc1\u3092\u79fb\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001PC\u3067\u30b2\u30fc\u30e0\u3092\u59cb\u3081\u3001\u30b3\u30f3\u30bd\u30fc\u30eb\u3067\u7d9a\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u5229\u7528\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u30c7\u30d0\u30a4\u30b9\u306b\u304b\u304b\u308f\u3089\u305a\u30d5\u30ec\u30f3\u30c9\u3068\u30c1\u30fc\u30e0\u3092\u7d44\u3080\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u6a5f\u80fd\u3092\u6700\u5927\u9650\u306b\u6d3b\u7528\u3059\u308b\u306b\u306f\u3001\u5b89\u5b9a\u3057\u305f\u30a4\u30f3\u30bf\u30fc\u30cd\u30c3\u30c8\u63a5\u7d9a\u3092\u78ba\u4fdd\u3057\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30ea\u30f3\u30af\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30b5\u30d0\u30a4\u30d0\u30eb\u30ec\u30fc\u30b9\u3067\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b5\u30d0\u30a4\u30d0\u30eb\u30ec\u30fc\u30b9\u306b\u306f\u3001\u30b2\u30fc\u30e0\u306b\u3055\u3089\u306b\u697d\u3057\u3055\u3092\u52a0\u3048\u308b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u6570\u591a\u304f\u5b58\u5728\u3057\u307e\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3001\u300c\u5de5\u5834\u8907\u5408\u65bd\u8a2d\u300d\u30ec\u30d9\u30eb\u306b\u96a0\u3055\u308c\u305f\u300c\u958b\u767a\u8005\u306e\u90e8\u5c4b\u300d\u3067\u3059\u3002\u898b\u3064\u3051\u308b\u306b\u306f\u3001\u58c1\u306b\u63cf\u304b\u308c\u305f\u7279\u5b9a\u306e\u843d\u66f8\u304d\u3092\u898b\u3064\u3051\u3066\u3001\u7279\u5b9a\u306e\u9806\u5e8f\u3067\u3053\u308c\u3089\u3068\u5bfe\u8a71\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u5165\u308b\u3068\u3001\u958b\u767a\u8005\u306e\u30e1\u30e2\u3084\u30b3\u30f3\u30bb\u30d7\u30c8\u30a2\u30fc\u30c8\u304c\u6e80\u8f09\u306e\u90e8\u5c4b\u304c\u3042\u308a\u307e\u3059\u3002\u3082\u30461\u3064\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3001\u300c\u90fd\u5e02\u907a\u8de1\u300d\u30ec\u30d9\u30eb\u306b\u3042\u308b\u3001\u6614\u306a\u304c\u3089\u306e\u30a2\u30fc\u30af\u30a8\u30a4\u30c0\u30fc\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0\u30b2\u30fc\u30e0\u3092\u5f77\u5f7f\u3068\u3055\u305b\u308b\u30df\u30cb\u30b2\u30fc\u30e0\u300c\u30ec\u30c8\u30ed\u30a2\u30fc\u30b1\u30fc\u30c9\u300d\u3067\u3059\u3002\u9685\u3005\u307e\u3067\u63a2\u7d22\u3059\u308b\u3053\u3068\u3067\u3001\u3053\u308c\u3089\u306e\u96a0\u3055\u308c\u305f\u5b9d\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30b5\u30d0\u30a4\u30d0\u30eb\u30ec\u30fc\u30b9\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30b5\u30d0\u30a4\u30d0\u30eb\u30ec\u30fc\u30b9\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30ad\u30eb\u6570\u3001\u30d8\u30c3\u30c9\u30b7\u30e7\u30c3\u30c8\u3001\u6b63\u78ba\u6027\u3001\u6642\u9593\u306a\u3069\u306e\u8907\u6570\u306e\u8981\u56e0\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u5404\u30ad\u30eb\u3067\u30dd\u30a4\u30f3\u30c8\u304c\u4e0e\u3048\u3089\u308c\u3001\u30d8\u30c3\u30c9\u30b7\u30e7\u30c3\u30c8\u3068\u30b9\u30c6\u30eb\u30b9\u30ad\u30eb\u3067\u306f\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u304c\u4e0e\u3048\u3089\u308c\u307e\u3059\u3002\u6b63\u78ba\u6027\u306f\u6210\u529f\u3057\u305f\u30b7\u30e7\u30c3\u30c8\u306e\u30d1\u30fc\u30bb\u30f3\u30c6\u30fc\u30b8\u3068\u3057\u3066\u8a08\u7b97\u3055\u308c\u3001\u3088\u308a\u9ad8\u3044\u6b63\u78ba\u6027\u307b\u3069\u591a\u304f\u306e\u30dd\u30a4\u30f3\u30c8\u304c\u5f97\u3089\u308c\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30ec\u30d9\u30eb\u3092\u65e9\u304f\u5b8c\u4e86\u3059\u308c\u3070\u3001\u6642\u9593\u30dc\u30fc\u30ca\u30b9\u304c\u4e0e\u3048\u3089\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30b8\u30e3\u30f3\u30b0\u30eb\u907a\u8de1\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u9ad8\u3044\u6b63\u78ba\u6027\u3068\u3001\u30ec\u30d9\u30eb\u306e\u8fc5\u901f\u306a\u5b8c\u4e86\u306f\u30b9\u30b3\u30a2\u3092\u5927\u5e45\u306b\u5897\u52a0\u3055\u305b\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u7cbe\u5ea6\u3068\u52b9\u7387\u3092\u8ffd\u6c42\u3057\u3066\u3001\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3057\u3001\u30e9\u30f3\u30ad\u30f3\u30b0\u3092\u4e0a\u6607\u3055\u305b\u307e\u3057\u3087\u3046\u3002"}]
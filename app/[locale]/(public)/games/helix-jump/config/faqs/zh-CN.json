[{"question": "\u5982\u4f55\u6709\u6548\u63a7\u5236\u65b0\u624b\u5728\u87ba\u65cb\u8df3\u8dc3\u6e38\u620f\u4e2d\u7403\u7684\u79fb\u52a8\uff1f", "answer": "\u8981\u6709\u6548\u63a7\u5236\u87ba\u65cb\u8df3\u8dc3\u6e38\u620f\u4e2d\u7684\u7403\uff0c\u8bf7\u9075\u5faa\u4ee5\u4e0b\u6b65\u9aa4\uff1a**\u6b65\u9aa4 1**: \u8f7b\u89e6\u5c4f\u5e55\u4ee5\u542f\u52a8\u7403\u7684\u4e0b\u843d\u3002**\u6b65\u9aa4 2**: \u89c2\u5bdf\u87ba\u65cb\u5f62\u4e2d\u7684\u95f4\u9699\uff0c\u5e76\u6839\u636e\u65f6\u673a\u8f7b\u89e6\u4ee5\u5f15\u5bfc\u7403\u7a7f\u8fc7\u5b83\u4eec\u3002**\u6b65\u9aa4 3**: \u901a\u8fc7\u7cbe\u786e\u7684\u8f7b\u89e6\u8c03\u6574\u7403\u7684\u8f68\u8ff9\uff0c\u907f\u514d\u649e\u51fb\u7ea2\u8272\u6216\u9ed1\u8272\u533a\u57df\u3002\u4f8b\u5982\uff0c\u5982\u679c\u87ba\u65cb\u5f62\u6709\u72ed\u7a84\u7684\u95f4\u9699\uff0c\u8bf7\u7b49\u5230\u7403\u5b8c\u5168\u5bf9\u51c6\u540e\u518d\u8f7b\u89e6\u3002 \u4f7f\u7528**\u6d41\u7a0b\u56fe**\u53ef\u89c6\u5316\u65f6\u673a\uff1a\u8f7b\u89e6 \u2192 \u5bf9\u51c6 \u2192 \u901a\u8fc7\u3002\u6b64\u65b9\u6cd5\u53ef\u786e\u4fdd\u66f4\u987a\u7545\u7684\u8fdb\u7a0b\u548c\u66f4\u9ad8\u7684\u5206\u6570\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u87ba\u65cb\u8df3\u8dc3\u6e38\u620f\u4e2d\u7684\u7403\u6709\u65f6\u4f1a\u53d1\u751f\u4e0d\u53ef\u9884\u6d4b\u7684\u5f39\u8df3\uff0c\u4ee5\u53ca\u5982\u4f55\u9632\u6b62\u8fd9\u79cd\u60c5\u51b5\u53d1\u751f\uff1f", "answer": "\u87ba\u65cb\u8df3\u8dc3\u6e38\u620f\u4e2d\u7403\u7684\u4e0d\u53ef\u9884\u6d4b\u5f39\u8df3\u901a\u5e38\u662f\u7531\u4e8e\u8f7b\u89e6\u5931\u51c6\u6216\u649e\u51fb\u87ba\u65cb\u5f62\u7684\u8fb9\u7f18\u5bfc\u81f4\u7684\u3002\u4e3a\u4e86\u9632\u6b62\u8fd9\u79cd\u60c5\u51b5\u53d1\u751f\uff1a**\u6b65\u9aa4 1**: \u8f7b\u89e6\u4ee5\u4fdd\u6301\u63a7\u5236\u3002**\u6b65\u9aa4 2**: \u907f\u514d\u5feb\u901f\u6216\u5927\u529b\u8f7b\u89e6\uff0c\u8fd9\u53ef\u80fd\u4f1a\u5bfc\u81f4\u7403\u8fc7\u5ea6\u504f\u79bb\u3002**\u6b65\u9aa4 3**: \u4e13\u6ce8\u4e8e\u7403\u76f8\u5bf9\u4e8e\u95f4\u9699\u7684\u4f4d\u7f6e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u7403\u5f39\u8df3\u5230\u7ea2\u8272\u533a\u57df\uff0c\u5219\u5f88\u53ef\u80fd\u662f\u60a8\u8f7b\u89e6\u8fc7\u65e9\u3002\u4f7f\u7528**\u914d\u7f6e\u8868**\u6bd4\u8f83\u8f7b\u89e6\u5f3a\u5ea6\u53ca\u5176\u5f71\u54cd\uff1a\u8f7b\u89e6 \u2192 \u5e73\u7a33\u4e0b\u964d\uff0c\u5927\u529b\u89e6 \u2192 \u4e0d\u53ef\u9884\u6d4b\u5f39\u8df3\u3002\u638c\u63e1\u6b64\u6280\u5de7\u53ef\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u9519\u8bef\u5e76\u589e\u5f3a\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u6bcf\u4e2a\u65b0\u73a9\u5bb6\u90fd\u5e94\u8be5\u4e86\u89e3\u87ba\u65cb\u8df3\u8dc3\u7684\u57fa\u672c\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "\u87ba\u65cb\u8df3\u8dc3\u7684\u57fa\u672c\u673a\u5236\u56f4\u7ed5\u7740\u5f15\u5bfc\u7403\u7a7f\u8fc7\u65cb\u8f6c\u7684\u87ba\u65cb\u5f62\u3002\u4ee5\u4e0b\u662f\u60a8\u9700\u8981\u4e86\u89e3\u7684\u5185\u5bb9\uff1a**1**. \u7403\u4f1a\u81ea\u52a8\u4e0b\u964d\uff0c\u60a8\u7684\u8f7b\u89e6\u63a7\u5236\u5b83\u7684\u65b9\u5411\u3002**2**. \u87ba\u65cb\u5f62\u7531\u5f69\u8272\u90e8\u5206\u7ec4\u6210\u2014\u2014\u84dd\u8272\u8868\u793a\u5b89\u5168\uff0c\u800c\u7ea2\u8272\u548c\u9ed1\u8272\u5219\u8868\u793a\u5931\u8d25\u3002**3**. \u76ee\u6807\u662f\u5728\u4e0d\u649e\u51fb\u4e0d\u5b89\u5168\u533a\u57df\u7684\u60c5\u51b5\u4e0b\u5230\u8fbe\u5e95\u90e8\u3002\u4f8b\u5982\uff0c\u5982\u679c\u87ba\u65cb\u5f62\u6709\u4e00\u4e2a\u72ed\u7a84\u7684\u84dd\u8272\u95f4\u9699\uff0c\u8bf7\u8c03\u6574\u60a8\u7684\u8f7b\u89e6\u65f6\u673a\uff0c\u4ee5\u7a7f\u8fc7\u5b83\u3002\u4f7f\u7528**\u6bd4\u8f83\u8868**\u533a\u5206\u533a\u57df\uff1a\u84dd\u8272 \u2192 \u5b89\u5168\uff0c\u7ea2\u8272/\u9ed1\u8272 \u2192 \u5931\u8d25\u3002\u7406\u89e3\u8fd9\u4e9b\u673a\u5236\u5bf9\u4e8e\u5728\u6e38\u620f\u4e2d\u53d6\u5f97\u8fdb\u5c55\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u5728\u73a9\u8d85\u8fc7 100 \u5c0f\u65f6\u540e\uff0c\u5982\u4f55\u4f18\u5316\u6211\u7684\u87ba\u65cb\u8df3\u8dc3\u6e38\u620f\u7b56\u7565\uff1f", "answer": "\u5728\u87ba\u65cb\u8df3\u8dc3\u6e38\u620f\u4e2d\u73a9\u8d85\u8fc7 100 \u5c0f\u65f6\u540e\uff0c\u8bf7\u4f7f\u7528\u4ee5\u4e0b\u6b65\u9aa4\u4f18\u5316\u60a8\u7684\u7b56\u7565\uff1a**\u6b65\u9aa4 1**: \u7814\u7a76\u87ba\u65cb\u5f62\u56fe\u6848\u5e76\u8bb0\u4f4f\u5e38\u89c1\u95f4\u9699\u4f4d\u7f6e\u3002**\u6b65\u9aa4 2**: \u4f7f\u7528\u6700\u5c11\u7684\u8f7b\u89e6\u6765\u8282\u7701\u80fd\u91cf\u5e76\u4fdd\u6301\u63a7\u5236\u3002**\u6b65\u9aa4 3**: \u9884\u89c1\u5177\u6709\u6311\u6218\u6027\u7684\u90e8\u5206\u5e76\u76f8\u5e94\u5730\u8c03\u6574\u60a8\u7684\u8f7b\u89e6\u65f6\u673a\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4e00\u4e2a\u87ba\u65cb\u5f62\u7531\u4ea4\u66ff\u7684\u7ea2\u8272\u548c\u84dd\u8272\u90e8\u5206\u7ec4\u6210\uff0c\u8bf7\u7b49\u5f85\u84dd\u8272\u95f4\u9699\u5b8c\u5168\u5bf9\u9f50\u540e\u8f7b\u89e6\u3002\u4f7f\u7528**\u6d41\u7a0b\u56fe**\u7ed8\u5236\u9ad8\u7ea7\u7b56\u7565\uff1a\u89c2\u5bdf \u2192 \u8bb0\u5fc6 \u2192 \u6267\u884c\u3002\u6b64\u65b9\u6cd5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u6548\u7387\uff0c\u5e76\u5e2e\u52a9\u60a8\u83b7\u5f97\u66f4\u9ad8\u7684\u5206\u6570\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u65f6\u95f4\u63a7\u5236\u5728\u87ba\u65cb\u8df3\u8dc3\u4e2d\u81f3\u5173\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u63d0\u9ad8\u5b83\uff1f", "answer": "\u65f6\u95f4\u63a7\u5236\u5728\u87ba\u65cb\u8df3\u8dc3\u4e2d\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u51b3\u5b9a\u4e86\u7403\u662f\u7a7f\u8fc7\u95f4\u9699\u8fd8\u662f\u649e\u51fb\u4e0d\u5b89\u5168\u533a\u57df\u3002\u8981\u6539\u8fdb\uff1a**\u6b65\u9aa4 1**: \u7ec3\u4e60\u4e0e\u87ba\u65cb\u5f62\u65cb\u8f6c\u540c\u6b65\u8f7b\u89e6\u3002**\u6b65\u9aa4 2**: \u4e13\u6ce8\u4e8e\u7403\u7684\u901f\u5ea6\u5e76\u76f8\u5e94\u5730\u8c03\u6574\u60a8\u7684\u8f7b\u89e6\u3002**\u6b65\u9aa4 3**: \u4f7f\u7528\u89c6\u89c9\u7ebf\u7d22\uff0c\u4f8b\u5982\u95f4\u9699\u7684\u5bf9\u9f50\uff0c\u4ee5\u5b8c\u5584\u60a8\u7684\u8f7b\u89e6\u65f6\u673a\u3002\u4f8b\u5982\uff0c\u5982\u679c\u87ba\u65cb\u5f62\u65cb\u8f6c\u901f\u5ea6\u5f88\u5feb\uff0c\u5219\u5e94\u8f7b\u89e6\u5f97\u66f4\u65e9\u4e00\u4e9b\u4ee5\u5f25\u8865\u3002\u4f7f\u7528**\u6bd4\u8f83\u8868**\u5206\u6790\u65f6\u95f4\u5f71\u54cd\uff1a\u8f7b\u89e6\u8fc7\u65e9 \u2192 \u9519\u8fc7\u95f4\u9699\uff0c\u5b8c\u7f8e\u8f7b\u89e6 \u2192 \u901a\u8fc7\u95f4\u9699\u3002\u638c\u63e1\u65f6\u95f4\u63a7\u5236\u53ef\u786e\u4fdd\u66f4\u987a\u7545\u7684\u6e38\u620f\u4f53\u9a8c\u548c\u66f4\u9ad8\u7684\u6210\u529f\u7387\u3002"}, {"question": "\u54ea\u4e9b\u9ad8\u7ea7\u6280\u5de7\u53ef\u4ee5\u5e2e\u52a9\u6211\u5728\u87ba\u65cb\u8df3\u8dc3\u6e38\u620f\u4e2d\u83b7\u5f97\u66f4\u9ad8\u7684\u5206\u6570\uff1f", "answer": "\u8981\u83b7\u5f97\u87ba\u65cb\u8df3\u8dc3\u6e38\u620f\u4e2d\u66f4\u9ad8\u7684\u5206\u6570\uff0c\u8bf7\u91c7\u7528\u4ee5\u4e0b\u9ad8\u7ea7\u6280\u5de7\uff1a**\u6b65\u9aa4 1**: \u638c\u63e1\u6700\u5c0f\u8f7b\u89e6\u7684\u827a\u672f\uff0c\u4ee5\u4fdd\u6301\u7cbe\u786e\u7684\u63a7\u5236\u3002**\u6b65\u9aa4 2**: \u8bc6\u522b\u5e76\u5229\u7528\u87ba\u65cb\u5f62\u7ed3\u6784\u4e2d\u7684\u6377\u5f84\u3002**\u6b65\u9aa4 3**: \u5728\u5feb\u8282\u594f\u7684\u90e8\u5206\u4fdd\u6301\u51b7\u9759\uff0c\u5e76\u4e13\u6ce8\u4e8e\u65f6\u95f4\u63a7\u5236\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4e00\u4e2a\u87ba\u65cb\u5f62\u6709\u4e00\u4e2a\u5927\u7684\u84dd\u8272\u90e8\u5206\uff0c\u65e8\u5728\u5c06\u7403\u7784\u51c6\u5176\u4e2d\u5fc3\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u5b89\u5168\u6027\u3002\u4f7f\u7528**\u6d41\u7a0b\u56fe**\u6982\u8ff0\u8be5\u8fc7\u7a0b\uff1a\u89c2\u5bdf \u2192 \u8bc6\u522b \u2192 \u6267\u884c\u3002\u8fd9\u4e9b\u6280\u5de7\u5e2e\u52a9\u60a8\u9a7e\u9a6d\u590d\u6742\u5173\u5361\uff0c\u663e\u8457\u63d0\u5347\u5206\u6570\u3002"}, {"question": "\u87ba\u65cb\u5f62\u65cb\u8f6c\u901f\u5ea6\u5728\u87ba\u65cb\u8df3\u8dc3\u6e38\u620f\u4e2d\u626e\u6f14\u4ec0\u4e48\u89d2\u8272\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u87ba\u65cb\u8df3\u8dc3\u6e38\u620f\u4e2d\u7684\u87ba\u65cb\u5f62\u65cb\u8f6c\u901f\u5ea6\u76f4\u63a5\u5f71\u54cd\u6e38\u620f\u96be\u5ea6\u3002\u65cb\u8f6c\u901f\u5ea6\u8d8a\u5feb\uff0c\u9700\u8981\u8d8a\u5feb\u7684\u53cd\u5e94\u901f\u5ea6\u548c\u66f4\u7cbe\u786e\u7684\u65f6\u673a\u3002\u4f8b\u5982\uff0c\u5982\u679c\u87ba\u65cb\u5f62\u65cb\u8f6c\u901f\u5ea6\u5f88\u5feb\uff0c\u5219\u5fc5\u987b\u66f4\u65e9\u8f7b\u89e6\uff0c\u624d\u80fd\u4f7f\u7403\u4e0e\u95f4\u9699\u5bf9\u9f50\u3002\u4f7f\u7528**\u914d\u7f6e\u8868**\u6bd4\u8f83\u901f\u5ea6\uff1a\u6162\u901f\u65cb\u8f6c \u2192 \u66f4\u5bb9\u6613\u63a7\u5236\uff0c\u5feb\u901f\u65cb\u8f6c \u2192 \u5177\u6709\u6311\u6218\u6027\u7684\u65f6\u673a\u3002\u7406\u89e3\u6b64\u673a\u5236\u53ef\u5e2e\u52a9\u60a8\u9002\u5e94\u4e0d\u540c\u7ea7\u522b\u7684\u6e38\u620f\uff0c\u5e76\u63d0\u9ad8\u60a8\u7684\u8868\u73b0\u3002"}, {"question": "\u87ba\u65cb\u8df3\u8dc3\u4e2d\u7684\u8ba1\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u5b83\uff1f", "answer": "\u87ba\u65cb\u8df3\u8dc3\u6e38\u620f\u4e2d\u7684\u8ba1\u5206\u7cfb\u7edf\u57fa\u4e8e\u7403\u7684\u98de\u884c\u8ddd\u79bb\u548c\u901a\u8fc7\u7684\u5b89\u5168\u533a\u57df\u6570\u91cf\u3002\u5f71\u54cd\u5206\u6570\u7684\u56e0\u7d20\u5305\u62ec\uff1a**1**. \u907f\u514d\u7ea2\u8272\u548c\u9ed1\u8272\u533a\u57df\u3002**2**. \u6301\u7eed\u901a\u8fc7\u84dd\u8272\u533a\u57df\u3002**3**. \u5feb\u901f\u5b8c\u6210\u5173\u5361\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u6ca1\u6709\u9519\u8bef\u7684\u60c5\u51b5\u4e0b\u901a\u8fc7 10 \u4e2a\u84dd\u8272\u533a\u57df\uff0c\u60a8\u7684\u5206\u6570\u5c31\u4f1a\u663e\u8457\u589e\u52a0\u3002\u4f7f\u7528**\u6bd4\u8f83\u8868**\u7a81\u51fa\u663e\u793a\u8ba1\u5206\u56e0\u7d20\uff1a\u5b89\u5168\u901a\u8fc7 \u2192 \u66f4\u9ad8\u5206\u6570\uff0c\u9519\u8bef \u2192 \u66f4\u4f4e\u5206\u6570\u3002\u638c\u63e1\u8fd9\u4e9b\u8981\u7d20\u53ef\u786e\u4fdd\u83b7\u5f97\u66f4\u9ad8\u7684\u5206\u6570\u548c\u66f4\u597d\u7684\u6392\u540d\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5c06\u6211\u7684\u87ba\u65cb\u8df3\u8dc3\u6e38\u620f\u8fdb\u5ea6\u8f6c\u79fb\u5230\u4e0d\u540c\u7684\u8bbe\u5907\u4e0a\u5417\uff0c\u4ee5\u53ca\u5982\u4f55\uff1f", "answer": "\u662f\u7684\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u5c06\u6e38\u620f\u8d26\u6237\u94fe\u63a5\u5230\u4e91\u670d\u52a1\uff08\u4f8b\u5982 Google Play \u6216 Apple Game Center\uff09\u6765\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u8f6c\u79fb\u60a8\u7684\u87ba\u65cb\u8df3\u8dc3\u6e38\u620f\u8fdb\u5ea6\u3002**\u6b65\u9aa4 1**: \u6253\u5f00\u6e38\u620f\u8bbe\u7f6e\u5e76\u627e\u5230\u8d26\u6237\u94fe\u63a5\u9009\u9879\u3002**\u6b65\u9aa4 2**: \u767b\u5f55\u60a8\u7684\u4e91\u670d\u52a1\u8d26\u6237\u3002**\u6b65\u9aa4 3**: \u5728\u65b0\u8bbe\u5907\u4e0a\u5b89\u88c5\u87ba\u65cb\u8df3\u8dc3\u6e38\u620f\uff0c\u5e76\u767b\u5f55\u76f8\u540c\u7684\u8d26\u6237\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u4ece Android \u5207\u6362\u5230 iPhone\uff0c\u8bf7\u4f7f\u7528 Apple Game Center \u540c\u6b65\u60a8\u7684\u8fdb\u5ea6\u3002\u4f7f\u7528**\u6d41\u7a0b\u56fe**\u7b80\u5316\u8be5\u8fc7\u7a0b\uff1a\u6253\u5f00\u8bbe\u7f6e \u2192 \u94fe\u63a5\u8d26\u6237 \u2192 \u540c\u6b65\u8fdb\u5ea6\u3002\u8fd9\u53ef\u786e\u4fdd\u5728\u4e0d\u540c\u8bbe\u5907\u4e0a\u90fd\u80fd\u6d41\u7545\u6e38\u620f\u3002"}, {"question": "\u5728\u87ba\u65cb\u8df3\u8dc3\u6e38\u620f\u4e2d\uff0c\u6709\u54ea\u4e9b\u9690\u85cf\u7684\u529f\u80fd\u6216\u5f69\u86cb\uff0c\u73a9\u5bb6\u53ef\u80fd\u4f1a\u5ffd\u7565\uff1f", "answer": "\u87ba\u65cb\u8df3\u8dc3\u6e38\u620f\u5305\u542b\u9690\u85cf\u529f\u80fd\uff0c\u4f8b\u5982\u79d8\u5bc6\u6377\u5f84\u548c\u72ec\u7279\u7684\u87ba\u65cb\u5f62\u8bbe\u8ba1\uff0c\u4ee5\u6b64\u5956\u52b1\u63a2\u7d22\u3002\u4f8b\u5982\uff0c\u4e00\u4e9b\u5173\u5361\u62e5\u6709\u9690\u85cf\u8def\u5f84\uff0c\u53ef\u4ee5\u7ed5\u8fc7\u5177\u6709\u6311\u6218\u6027\u7684\u90e8\u5206\u3002\u8981\u53d1\u73b0\u8fd9\u4e9b\uff1a**\u6b65\u9aa4 1**: \u5c1d\u8bd5\u4e0d\u540c\u7684\u8f7b\u89e6\u6a21\u5f0f\u3002**\u6b65\u9aa4 2**: \u5bfb\u627e\u4e0d\u5bfb\u5e38\u7684\u87ba\u65cb\u5f62\u7ed3\u6784\u6216\u989c\u8272\u53d8\u5316\u3002**\u6b65\u9aa4 3**: \u4e0e\u793e\u533a\u5206\u4eab\u60a8\u7684\u53d1\u73b0\uff0c\u4ee5\u53d1\u73b0\u66f4\u591a\u79d8\u5bc6\u3002\u4f7f\u7528**\u6bd4\u8f83\u8868**\u7a81\u51fa\u663e\u793a\u5df2\u77e5\u7684\u5f69\u86cb\uff1a\u9690\u85cf\u8def\u5f84 \u2192 \u66f4\u5feb\u7684\u8fdb\u5c55\uff0c\u72ec\u7279\u7684\u8bbe\u8ba1 \u2192 \u7f8e\u89c2\u6027\u3002\u63a2\u7d22\u8fd9\u4e9b\u529f\u80fd\u4e3a\u6e38\u620f\u4f53\u9a8c\u589e\u6dfb\u4e86\u6df1\u5ea6\u3002"}]
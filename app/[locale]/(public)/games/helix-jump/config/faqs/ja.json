[{"question": "\u30d8\u30ea\u30c3\u30af\u30b9\u30b8\u30e3\u30f3\u30d7\u3067\u521d\u5fc3\u8005\u3068\u3057\u3066\u30dc\u30fc\u30eb\u306e\u52d5\u304d\u3092\u52b9\u679c\u7684\u306b\u5236\u5fa1\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d8\u30ea\u30c3\u30af\u30b9\u30b8\u30e3\u30f3\u30d7\u3067\u30dc\u30fc\u30eb\u3092\u52b9\u679c\u7684\u306b\u5236\u5fa1\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3057\u3087\u3046\u3002**\u624b\u98061**: \u753b\u9762\u3092\u8efd\u304f\u30bf\u30c3\u30d7\u3057\u3066\u30dc\u30fc\u30eb\u306e\u843d\u4e0b\u3092\u958b\u59cb\u3057\u307e\u3059\u3002**\u624b\u98062**: \u30d8\u30ea\u30c3\u30af\u30b9\u306e\u9699\u9593\u3092\u89b3\u5bdf\u3057\u3001\u30bf\u30c3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u8abf\u6574\u3057\u3066\u30dc\u30fc\u30eb\u304c\u305d\u308c\u3089\u3092\u901a\u904e\u3059\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002**\u624b\u98063**: \u6b63\u78ba\u306a\u30bf\u30c3\u30d7\u3067\u30dc\u30fc\u30eb\u306e\u8ecc\u9053\u3092\u8abf\u6574\u3057\u3001\u8d64\u3044\u90e8\u5206\u3084\u9ed2\u3044\u90e8\u5206\u306b\u5f53\u305f\u3089\u306a\u3044\u3088\u3046\u306b\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d8\u30ea\u30c3\u30af\u30b9\u306b\u72ed\u3044\u9699\u9593\u304c\u3042\u308b\u5834\u5408\u306f\u3001\u30dc\u30fc\u30eb\u304c\u5b8c\u5168\u306b\u4f4d\u7f6e\u5408\u308f\u305b\u3055\u308c\u308b\u307e\u3067\u30bf\u30c3\u30d7\u3092\u5f85\u3061\u307e\u3059\u3002\u300c\u30bf\u30c3\u30d7\u2192\u4f4d\u7f6e\u5408\u308f\u305b\u2192\u901a\u904e\u300d\u3068\u3044\u3046\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3067\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u8996\u899a\u5316\u3059\u308b\u3068\u5f79\u7acb\u3061\u307e\u3059\u3002\u3053\u306e\u65b9\u6cd5\u3092\u4f7f\u3046\u3068\u3001\u30b9\u30e0\u30fc\u30ba\u306a\u9032\u884c\u3068\u9ad8\u5f97\u70b9\u3092\u5b9f\u73fe\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u306a\u305c\u30d8\u30ea\u30c3\u30af\u30b9\u30b8\u30e3\u30f3\u30d7\u3067\u30dc\u30fc\u30eb\u304c\u4e88\u6e2c\u3067\u304d\u306a\u3044\u3088\u3046\u306b\u8df3\u306d\u8fd4\u308b\u3053\u3068\u304c\u3042\u308b\u306e\u3067\u3057\u3087\u3046\u304b\u3002\u307e\u305f\u3001\u3069\u306e\u3088\u3046\u306b\u9632\u3052\u307e\u3059\u304b\uff1f", "answer": "\u30d8\u30ea\u30c3\u30af\u30b9\u30b8\u30e3\u30f3\u30d7\u3067\u30dc\u30fc\u30eb\u304c\u4e88\u6e2c\u3067\u304d\u306a\u3044\u3088\u3046\u306b\u8df3\u306d\u8fd4\u308b\u3053\u3068\u304c\u3042\u308b\u306e\u306f\u3001\u30bf\u30c3\u30d7\u304c\u305a\u308c\u3066\u3044\u308b\u304b\u3001\u30d8\u30ea\u30c3\u30af\u30b9\u306e\u30a8\u30c3\u30b8\u306b\u5f53\u305f\u3063\u3066\u3044\u308b\u3053\u3068\u304c\u539f\u56e0\u3067\u3042\u308b\u3053\u3068\u304c\u591a\u304f\u306a\u308a\u307e\u3057\u305f\u3002\u3053\u308c\u3092\u9632\u3050\u306b\u306f\u3001**\u624b\u98061**: \u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u8efd\u304f\u30bf\u30c3\u30d7\u3057\u307e\u3059\u3002**\u624b\u98062**: \u65e9\u3059\u304e\u308b\u30bf\u30c3\u30d7\u3084\u5f37\u3059\u304e\u308b\u30bf\u30c3\u30d7\u306f\u3001\u30dc\u30fc\u30eb\u304c\u30aa\u30fc\u30d0\u30fc\u30b7\u30e5\u30fc\u30c8\u3057\u3066\u3057\u307e\u3046\u305f\u3081\u907f\u3051\u3066\u304f\u3060\u3055\u3044\u3002**\u624b\u98063**: \u9699\u9593\u306b\u5bfe\u3059\u308b\u30dc\u30fc\u30eb\u306e\u4f4d\u7f6e\u95a2\u4fc2\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30dc\u30fc\u30eb\u304c\u8d64\u3044\u90e8\u5206\u306b\u8df3\u306d\u8fd4\u3063\u305f\u5834\u5408\u306f\u3001\u30bf\u30c3\u30d7\u304c\u65e9\u3059\u304e\u305f\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u30bf\u30c3\u30d7\u306e\u5f37\u5ea6\u3068\u305d\u306e\u5f71\u97ff\u3092\u6bd4\u8f03\u3057\u305f**\u69cb\u6210\u8868**\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u8efd\u3044\u30bf\u30c3\u30d7\u2192\u30b9\u30e0\u30fc\u30ba\u306a\u4e0b\u964d\u3001\u5f37\u3044\u30bf\u30c3\u30d7\u2192\u4e88\u6e2c\u3067\u304d\u306a\u3044\u8df3\u306d\u8fd4\u308a\u3002\u3053\u306e\u30c6\u30af\u30cb\u30c3\u30af\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u3067\u3001\u30a8\u30e9\u30fc\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5411\u4e0a\u3055\u305b\u3089\u308c\u307e\u3059\u3002"}, {"question": "\u3059\u3079\u3066\u306e\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u7406\u89e3\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u3001\u30d8\u30ea\u30c3\u30af\u30b9\u30b8\u30e3\u30f3\u30d7\u306e\u57fa\u672c\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d8\u30ea\u30c3\u30af\u30b9\u30b8\u30e3\u30f3\u30d7\u306e\u57fa\u672c\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u56de\u8ee2\u3059\u308b\u30d8\u30ea\u30c3\u30af\u30b9\u3092\u901a\u3057\u3066\u30dc\u30fc\u30eb\u3092\u8a98\u5c0e\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u77e5\u3063\u3066\u304a\u304f\u3079\u304d\u3053\u3068\u306f\u4ee5\u4e0b\u306e\u3068\u304a\u308a\u3067\u3059\u3002**1**. \u30dc\u30fc\u30eb\u306f\u81ea\u52d5\u7684\u306b\u4e0b\u964d\u3057\u3001\u30bf\u30c3\u30d7\u3067\u65b9\u5411\u304c\u5236\u5fa1\u3055\u308c\u307e\u3059\u3002**2**. \u30d8\u30ea\u30c3\u30af\u30b9\u306f\u8272\u5206\u3051\u3055\u308c\u305f\u30bb\u30af\u30b7\u30e7\u30f3\u3067\u69cb\u6210\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u9752\u306f\u5b89\u5168\u3001\u8d64\u3068\u9ed2\u306f\u5931\u6557\u3092\u5f15\u304d\u8d77\u3053\u3057\u307e\u3059\u3002**3**. \u5b89\u5168\u3067\u306a\u3044\u30bb\u30af\u30b7\u30e7\u30f3\u306b\u5f53\u305f\u3089\u306a\u3044\u3088\u3046\u306b\u3001\u30d8\u30ea\u30c3\u30af\u30b9\u306e\u4e0b\u90e8\u307e\u3067\u5230\u9054\u3059\u308b\u3053\u3068\u304c\u76ee\u6a19\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d8\u30ea\u30c3\u30af\u30b9\u306b\u9752\u3044\u72ed\u3044\u9699\u9593\u304c\u3042\u308b\u5834\u5408\u306f\u3001\u30bf\u30c3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5408\u308f\u305b\u3066\u901a\u904e\u3057\u307e\u3059\u3002\u30bb\u30af\u30b7\u30e7\u30f3\u306e\u9055\u3044\u3092\u793a\u3059**\u6bd4\u8f03\u8868**\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u9752\u2192\u5b89\u5168\u3001\u8d64/\u9ed2\u2192\u5931\u6557\u3002\u3053\u308c\u3089\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u30b2\u30fc\u30e0\u3092\u9032\u3081\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002"}, {"question": "100\u6642\u9593\u4ee5\u4e0a\u30d8\u30ea\u30c3\u30af\u30b9\u30b8\u30e3\u30f3\u30d7\u3092\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u3069\u306e\u3088\u3046\u306b\u6226\u7565\u3092\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "100\u6642\u9593\u4ee5\u4e0a\u30d8\u30ea\u30c3\u30af\u30b9\u30b8\u30e3\u30f3\u30d7\u3092\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u3053\u308c\u3089\u306e\u624b\u9806\u3067\u6226\u7565\u3092\u6700\u9069\u5316\u3057\u307e\u3057\u3087\u3046\u3002**\u624b\u98061**: \u30d8\u30ea\u30c3\u30af\u30b9\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u7814\u7a76\u3057\u3001\u4e00\u822c\u7684\u306a\u9699\u9593\u4f4d\u7f6e\u3092\u8a18\u61b6\u3057\u307e\u3059\u3002**\u624b\u98062**: \u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u7bc0\u7d04\u3057\u3001\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u3001\u6700\u5c0f\u9650\u306e\u30bf\u30c3\u30d7\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002**\u624b\u98063**: \u56f0\u96e3\u306a\u30bb\u30af\u30b7\u30e7\u30f3\u3092\u4e88\u6e2c\u3057\u3001\u305d\u308c\u306b\u5fdc\u3058\u3066\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d8\u30ea\u30c3\u30af\u30b9\u304c\u4ea4\u4e92\u306b\u8d64\u3068\u9752\u306e\u30bb\u30af\u30b7\u30e7\u30f3\u304c\u3042\u308b\u5834\u5408\u306f\u3001\u9752\u3044\u9699\u9593\u304c\u5b8c\u5168\u306b\u63c3\u3046\u306e\u3092\u5f85\u3061\u307e\u3059\u3002\u9ad8\u5ea6\u306a\u6226\u7565\u3092\u30de\u30c3\u30d4\u30f3\u30b0\u3059\u308b**\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8**\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u89b3\u5bdf\u2192\u8a18\u61b6\u2192\u5b9f\u884c\u3002\u3053\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u52b9\u7387\u3092\u6700\u5927\u5316\u3057\u3001\u9ad8\u5f97\u70b9\u9054\u6210\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30d8\u30ea\u30c3\u30af\u30b9\u30b8\u30e3\u30f3\u30d7\u3067\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\u3002\u307e\u305f\u3001\u3069\u306e\u3088\u3046\u306b\u6539\u5584\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d8\u30ea\u30c3\u30af\u30b9\u30b8\u30e3\u30f3\u30d7\u3067\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u306a\u306e\u306f\u3001\u30dc\u30fc\u30eb\u304c\u9699\u9593\u3092\u901a\u904e\u3059\u308b\u304b\u3001\u5b89\u5168\u3067\u306a\u3044\u30bb\u30af\u30b7\u30e7\u30f3\u306b\u5f53\u305f\u308b\u304b\u3092\u6c7a\u5b9a\u3059\u308b\u304b\u3089\u3067\u3059\u3002\u6539\u5584\u3059\u308b\u306b\u306f\u3001**\u624b\u98061**: \u30d8\u30ea\u30c3\u30af\u30b9\u306e\u56de\u8ee2\u306b\u5408\u308f\u305b\u3066\u30bf\u30c3\u30d7\u3059\u308b\u7df4\u7fd2\u3092\u3057\u307e\u3059\u3002**\u624b\u98062**: \u30dc\u30fc\u30eb\u901f\u5ea6\u306b\u6ce8\u610f\u3057\u3001\u305d\u308c\u306b\u5408\u308f\u305b\u3066\u30bf\u30c3\u30d7\u3092\u8abf\u6574\u3057\u307e\u3059\u3002**\u624b\u98063**: \u9699\u9593\u306e\u4f4d\u7f6e\u5408\u308f\u305b\u306a\u3069\u306e\u8996\u899a\u7684\u624b\u304c\u304b\u308a\u3092\u4f7f\u7528\u3057\u3066\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u6b63\u78ba\u306b\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d8\u30ea\u30c3\u30af\u30b9\u304c\u901f\u304f\u56de\u8ee2\u3057\u3066\u3044\u308b\u5834\u5408\u306f\u3001\u88dc\u6b63\u3059\u308b\u305f\u3081\u306b\u308f\u305a\u304b\u306b\u65e9\u304f\u30bf\u30c3\u30d7\u3057\u307e\u3059\u3002\u30bf\u30a4\u30df\u30f3\u30b0\u306e\u5f71\u97ff\u3092\u5206\u6790\u3059\u308b\u305f\u3081\u306e**\u6bd4\u8f03\u8868**\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30bf\u30c3\u30d7\u304c\u65e9\u3044\u2192\u9699\u9593\u3092\u9003\u3059\u3001\u5b8c\u74a7\u306a\u30bf\u30c3\u30d7\u2192\u9699\u9593\u3092\u901a\u904e\u3002\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3068\u3001\u30b9\u30e0\u30fc\u30ba\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3068\u6210\u529f\u7387\u306e\u5411\u4e0a\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002"}, {"question": "\u30d8\u30ea\u30c3\u30af\u30b9\u30b8\u30e3\u30f3\u30d7\u3067\u9ad8\u5f97\u70b9\u3092\u5f97\u308b\u305f\u3081\u306b\u5f79\u7acb\u3064\u9ad8\u5ea6\u306a\u30c6\u30af\u30cb\u30c3\u30af\u306f\uff1f", "answer": "\u30d8\u30ea\u30c3\u30af\u30b9\u30b8\u30e3\u30f3\u30d7\u3067\u9ad8\u5f97\u70b9\u3092\u5f97\u308b\u306b\u306f\u3001\u3053\u308c\u3089\u306e\u9ad8\u5ea6\u306a\u30c6\u30af\u30cb\u30c3\u30af\u3092\u4f7f\u7528\u3057\u307e\u3057\u3087\u3046\u3002**\u624b\u98061**: \u7cbe\u5ea6\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u3001\u6700\u5c0f\u9650\u306e\u30bf\u30c3\u30d7\u3092\u30de\u30b9\u30bf\u30fc\u3057\u307e\u3059\u3002**\u624b\u98062**: \u30d8\u30ea\u30c3\u30af\u30b9\u69cb\u9020\u306e\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u3092\u898b\u3064\u3051\u3066\u6d3b\u7528\u3057\u307e\u3059\u3002**\u624b\u98063**: \u9ad8\u901f\u306a\u30bb\u30af\u30b7\u30e7\u30f3\u3067\u3082\u843d\u3061\u7740\u3044\u3066\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u306b\u96c6\u4e2d\u3057\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d8\u30ea\u30c3\u30af\u30b9\u306b\u5927\u304d\u306a\u9752\u3044\u30bb\u30af\u30b7\u30e7\u30f3\u304c\u3042\u308b\u5834\u5408\u306f\u3001\u5b89\u5168\u6027\u3092\u6700\u5927\u9650\u306b\u3059\u308b\u305f\u3081\u306b\u305d\u306e\u4e2d\u592e\u3092\u72d9\u3044\u307e\u3059\u3002\u30d7\u30ed\u30bb\u30b9\u3092\u307e\u3068\u3081\u308b**\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8**\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u89b3\u5bdf\u2192\u7279\u5b9a\u2192\u5b9f\u884c\u3002\u3053\u308c\u3089\u306e\u30c6\u30af\u30cb\u30c3\u30af\u3092\u4f7f\u3046\u3053\u3068\u3067\u3001\u8907\u96d1\u306a\u30ec\u30d9\u30eb\u3092\u4e57\u308a\u8d8a\u3048\u3001\u30b9\u30b3\u30a2\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d8\u30ea\u30c3\u30af\u30b9\u30b8\u30e3\u30f3\u30d7\u306b\u304a\u3051\u308b\u30d8\u30ea\u30c3\u30af\u30b9\u56de\u8ee2\u901f\u5ea6\u306e\u5f79\u5272\u3001\u305d\u3057\u3066\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3078\u306e\u5f71\u97ff\u306f\uff1f", "answer": "\u30d8\u30ea\u30c3\u30af\u30b9\u30b8\u30e3\u30f3\u30d7\u306b\u304a\u3051\u308b\u30d8\u30ea\u30c3\u30af\u30b9\u306e\u56de\u8ee2\u901f\u5ea6\u306f\u3001\u30b2\u30fc\u30e0\u306e\u96e3\u6613\u5ea6\u3092\u76f4\u63a5\u7684\u306b\u5de6\u53f3\u3057\u307e\u3059\u3002\u56de\u8ee2\u304c\u901f\u304f\u306a\u308b\u3068\u3001\u3088\u308a\u7d20\u65e9\u3044\u53cd\u5fdc\u3068\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u6c42\u3081\u3089\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d8\u30ea\u30c3\u30af\u30b9\u304c\u9ad8\u901f\u3067\u56de\u8ee2\u3057\u3066\u3044\u308b\u5834\u5408\u306f\u3001\u30dc\u30fc\u30eb\u3092\u9699\u9593\u3068\u4e00\u81f4\u3055\u305b\u308b\u305f\u3081\u306b\u3001\u3088\u308a\u65e9\u304f\u30bf\u30c3\u30d7\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u901f\u5ea6\u3092\u6bd4\u8f03\u3059\u308b\u305f\u3081\u306e**\u69cb\u6210\u8868**\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u9045\u3044\u56de\u8ee2\u2192\u5236\u5fa1\u304c\u5bb9\u6613\u3001\u9ad8\u901f\u56de\u8ee2\u2192\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u96e3\u3057\u3044\u3002\u3053\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u69d8\u3005\u306a\u30ec\u30d9\u30eb\u306b\u9069\u5fdc\u3057\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d8\u30ea\u30c3\u30af\u30b9\u30b8\u30e3\u30f3\u30d7\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u3069\u306e\u3088\u3046\u306a\u8981\u7d20\u304c\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d8\u30ea\u30c3\u30af\u30b9\u30b8\u30e3\u30f3\u30d7\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30dc\u30fc\u30eb\u306e\u79fb\u52d5\u8ddd\u96e2\u3068\u5b89\u5168\u306a\u30bb\u30af\u30b7\u30e7\u30f3\u306e\u901a\u904e\u6570\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u30b9\u30b3\u30a2\u306b\u5f71\u97ff\u3059\u308b\u8981\u7d20\u306b\u306f\u6b21\u306e\u3082\u306e\u304c\u3042\u308a\u307e\u3059\u3002**1**. \u8d64\u3044\u30bb\u30af\u30b7\u30e7\u30f3\u3084\u9ed2\u3044\u30bb\u30af\u30b7\u30e7\u30f3\u3092\u907f\u3051\u308b\u3002**2**. \u9752\u3044\u30bb\u30af\u30b7\u30e7\u30f3\u3092\u7d99\u7d9a\u7684\u306b\u901a\u904e\u3059\u308b\u3002**3**. \u30ec\u30d9\u30eb\u3092\u7d20\u65e9\u304f\u30af\u30ea\u30a2\u3059\u308b\u3002\u305f\u3068\u3048\u3070\u300110\u500b\u306e\u9752\u3044\u30bb\u30af\u30b7\u30e7\u30f3\u3092\u30df\u30b9\u306a\u304f\u901a\u904e\u3059\u308b\u3068\u3001\u30b9\u30b3\u30a2\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u8981\u56e0\u3092\u5f37\u8abf\u3059\u308b**\u6bd4\u8f03\u8868**\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u5b89\u5168\u306a\u901a\u904e\u2192\u9ad8\u5f97\u70b9\u3001\u30a8\u30e9\u30fc\u2192\u4f4e\u5f97\u70b9\u3002\u3053\u308c\u3089\u306e\u8981\u7d20\u3092\u7fd2\u5f97\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u3068\u30e9\u30f3\u30ad\u30f3\u30b0\u5411\u4e0a\u306b\u7e4b\u304c\u308a\u307e\u3059\u3002"}, {"question": "\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u30d8\u30ea\u30c3\u30af\u30b9\u30b8\u30e3\u30f3\u30d7\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u3053\u3068\u306f\u3067\u304d\u307e\u3059\u304b\uff1f\u3082\u3057\u3067\u304d\u308b\u306a\u3089\u3001\u3069\u306e\u3088\u3046\u306b\uff1f", "answer": "\u306f\u3044\u3001Google Play\u3084Apple Game Center\u306e\u3088\u3046\u306a\u30af\u30e9\u30a6\u30c9\u30b5\u30fc\u30d3\u30b9\u306b\u30b2\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30ea\u30f3\u30af\u3059\u308b\u3053\u3068\u3067\u3001\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u30d8\u30ea\u30c3\u30af\u30b9\u30b8\u30e3\u30f3\u30d7\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3067\u304d\u307e\u3059\u3002**\u624b\u98061**: \u30b2\u30fc\u30e0\u8a2d\u5b9a\u3092\u958b\u304d\u3001\u30a2\u30ab\u30a6\u30f3\u30c8\u9023\u643a\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u63a2\u3057\u307e\u3059\u3002**\u624b\u98062**: \u30af\u30e9\u30a6\u30c9\u30b5\u30fc\u30d3\u30b9\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002**\u624b\u98063**: \u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u30d8\u30ea\u30c3\u30af\u30b9\u30b8\u30e3\u30f3\u30d7\u3092\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u3001\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001Android\u304b\u3089iPhone\u306b\u5207\u308a\u66ff\u3048\u308b\u5834\u5408\u306f\u3001Apple Game Center\u3092\u4f7f\u7528\u3057\u3066\u9032\u884c\u72b6\u6cc1\u3092\u540c\u671f\u3057\u307e\u3059\u3002\u30d7\u30ed\u30bb\u30b9\u3092\u7c21\u7d20\u5316\u3059\u308b**\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8**\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u8a2d\u5b9a\u3092\u958b\u304f\u2192\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30ea\u30f3\u30af\u3059\u308b\u2192\u9032\u884c\u72b6\u6cc1\u3092\u540c\u671f\u3059\u308b\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u30b7\u30fc\u30e0\u30ec\u30b9\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u304c\u4fdd\u8a3c\u3055\u308c\u307e\u3059\u3002"}, {"question": "\u30d8\u30ea\u30c3\u30af\u30b9\u30b8\u30e3\u30f3\u30d7\u306b\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u898b\u843d\u3068\u3057\u304c\u3061\u306a\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30d8\u30ea\u30c3\u30af\u30b9\u30b8\u30e3\u30f3\u30d7\u306b\u306f\u3001\u79d8\u5bc6\u306e\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u3084\u30e6\u30cb\u30fc\u30af\u306a\u30d8\u30ea\u30c3\u30af\u30b9\u30c7\u30b6\u30a4\u30f3\u306e\u3088\u3046\u306a\u3001\u63a2\u7d22\u3092\u5831\u3044\u308b\u96a0\u3057\u6a5f\u80fd\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u3044\u304f\u3064\u304b\u306e\u30ec\u30d9\u30eb\u306b\u306f\u3001\u56f0\u96e3\u306a\u30bb\u30af\u30b7\u30e7\u30f3\u3092\u30d0\u30a4\u30d1\u30b9\u3059\u308b\u96a0\u3057\u30d1\u30b9\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u767a\u898b\u3059\u308b\u306b\u306f\u3001**\u624b\u98061**: \u69d8\u3005\u306a\u30bf\u30c3\u30d7\u30d1\u30bf\u30fc\u30f3\u3092\u8a66\u3057\u307e\u3059\u3002**\u624b\u98062**: \u7570\u5e38\u306a\u30d8\u30ea\u30c3\u30af\u30b9\u69cb\u9020\u3084\u8272\u306e\u5909\u5316\u3092\u63a2\u3057\u307e\u3059\u3002**\u624b\u98063**: \u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u3068\u767a\u898b\u3092\u5171\u6709\u3057\u3001\u3088\u308a\u591a\u304f\u306e\u79d8\u5bc6\u3092\u660e\u3089\u304b\u306b\u3057\u307e\u3059\u3002\u65e2\u77e5\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u5f37\u8abf\u3059\u308b**\u6bd4\u8f03\u8868**\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u96a0\u3055\u308c\u305f\u30d1\u30b9\u2192\u3088\u308a\u9ad8\u901f\u306a\u9032\u884c\u3001\u30e6\u30cb\u30fc\u30af\u306a\u30c7\u30b6\u30a4\u30f3\u2192\u5be9\u7f8e\u7684\u306a\u9b45\u529b\u3002\u3053\u308c\u3089\u306e\u6a5f\u80fd\u3092\u63a2\u6c42\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u6df1\u307f\u304c\u5897\u3057\u307e\u3059\u3002"}]
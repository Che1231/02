[{"question": "\ucd08\ubcf4\uc790\ub97c \uc704\ud55c \ud380\ub2c8 \ub9e4\ub4dc \ub808\uc774\uc2f1\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud380\ub2c8 \ub9e4\ub4dc \ub808\uc774\uc2f1\uc5d0\uc11c \uae30\ubcf8 \ucee8\ud2b8\ub864\uc740 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \ud654\uc0b4\ud45c \ud0a4 \ub610\ub294 WASD \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc774\ub3d9\ud569\ub2c8\ub2e4. \uc2a4\ud398\uc774\uc2a4\ubc14\ub294 \uc810\ud504, \uc2dc\ud504\ud2b8\ub294 \ubd80\uc2a4\ud2b8\uc5d0 \uc0ac\uc6a9\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uacbd\uc0ac\ub85c\uc5d0 \uc811\uadfc\ud560 \ub54c \uc810\ud504\ud558\ub824\uba74 \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c, \uacf5\uc911\uc5d0\uc11c \ucd94\uac00 \uac70\ub9ac\ub97c \uc704\ud574 \ubd80\uc2a4\ud2b8\ud558\ub824\uba74 \uc2dc\ud504\ud2b8\ub97c \ub204\ub974\uc138\uc694. [\ube44\uc720 \uc124\uba85: \ucee8\ud2b8\ub864\uc744 \uc790\ub3d9\ucc28 \uc6b4\uc804\uacfc \ube44\uc720\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc5ec\uae30\uc11c \uc2a4\ud398\uc774\uc2a4\ubc14\ub294 \uc810\ud504\ub97c \uc704\ud55c \ube0c\ub808\uc774\ud06c\uc785\ub2c8\ub2e4.]"}, {"question": "100\uc2dc\uac04 \uc774\uc0c1 \ud50c\ub808\uc774\ud55c \ud6c4 \ud380\ub2c8 \ub9e4\ub4dc \ub808\uc774\uc2f1\uc5d0\uc11c \ub808\uc774\uc2a4 \uc2b9\ub9ac \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "100\uc2dc\uac04 \ud50c\ub808\uc774 \ud6c4\uc5d0\ub294 \uace0\uae09 \uc804\ub7b5 \uc219\ub2ec\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. STEP1: \ucf54\ub108\uc640 \uc810\ud504\ub97c \uc608\uce21\ud558\uae30 \uc704\ud574 \ud2b8\ub799\uc744 \uc644\ubcbd\ud788 \uc219\uc9c0\ud558\uc138\uc694. STEP2: \ubd80\uc2a4\ud2b8\ub294 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc138\uc694. \uace1\uc120\ubcf4\ub2e4\ub294 \uc9c1\uc120 \ucf54\uc2a4\uc5d0 \uc0ac\uc6a9\ud558\uc138\uc694. STEP3: \uc18d\ub3c4\uc640 \uc81c\uc5b4\ub97c \uade0\ud615 \uc788\uac8c \ud558\ub3c4\ub85d \ucc28\ub7c9\uc744 \ub9de\ucda4 \uc124\uc815\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uce90\ub144 \ub7f0' \ud2b8\ub799\uc5d0\uc11c \uc2dc\uc791 \uc2dc \ubd80\uc2a4\ud2b8\ub97c \uc0ac\uc6a9\ud558\uba74 \ucd08\ubc18 \uc120\ub450\ub97c \uc7a1\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \ub2e4\uc591\ud55c \ud2b8\ub799\uc5d0\uc11c \ubd80\uc2a4\ud2b8 \uc0ac\uc6a9]"}, {"question": "\ud380\ub2c8 \ub9e4\ub4dc \ub808\uc774\uc2f1\uc5d0 \ucc28\ub7c9 \ub9de\ucda4 \uc124\uc815 \uc2dc\uc2a4\ud15c\uc774 \ud3ec\ud568\ub41c \uc774\uc720\uc640 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "\ud380\ub2c8 \ub9e4\ub4dc \ub808\uc774\uc2f1\uc758 \ucc28\ub7c9 \ub9de\ucda4\uc124\uc815 \uc2dc\uc2a4\ud15c\uc744 \ud1b5\ud574 \ud50c\ub808\uc774\uc5b4\ub294 \ucd5c\uc801\uc758 \uc131\ub2a5\uc744 \uc704\ud574 \uc790\ub3d9\ucc28\ub97c \uc870\uc815\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc11c\uc2a4\ud39c\uc158 \uc870\uc815\uc740 \uac70\uce5c \uc9c0\ud615\uc5d0\uc11c\uc758 \ud578\ub4e4\ub9c1\uc744 \uac1c\uc120\ud558\uace0, \uc5d4\uc9c4 \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \uc18d\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uba38\ub514 \uba54\uc774\ud5f4' \ud2b8\ub799\uc5d0\uc11c \uc11c\uc2a4\ud39c\uc158 \uc124\uc815\uc744 \ub192\uc774\uba74 \ub118\uc5b4\uc9c0\ub294 \uac83\uc744 \ubc29\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \ub2e4\uc591\ud55c \ub808\uc774\uc2a4 \ud658\uacbd\uc5d0 \uc801\uc751\ud560 \uc218 \uc788\ub3c4\ub85d \uae4a\uc774\ub97c \ub354\ud569\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \ub9de\ucda4 \uc124\uc815\uc758 \uc131\ub2a5 \uc601\ud5a5]"}, {"question": "\ud380\ub2c8 \ub9e4\ub4dc \ub808\uc774\uc2f1\uc740 \uc5b4\ub5a4 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc9c0\uc6d0\ub418\uba70, \uac8c\uc784 \ub370\uc774\ud130\ub97c \ub2e4\ub978 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud380\ub2c8 \ub9e4\ub4dc \ub808\uc774\uc2f1\uc740 PC, PlayStation \ubc0f Xbox\uc5d0\uc11c \uc774\uc6a9 \uac00\ub2a5\ud569\ub2c8\ub2e4. \ub370\uc774\ud130\ub97c \uc804\uc1a1\ud558\ub824\uba74 \uac8c\uc784 \uc124\uc815 \uba54\ub274\ub97c \ud1b5\ud574 \uac8c\uc784 \uacc4\uc815\uc744 \uc911\uc559 \ud504\ub85c\ud544\uc5d0 \uc5f0\uacb0\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \uc124\uc815 > \uacc4\uc815 > \ud504\ub85c\ud544 \uc5f0\uacb0\uc744 \ud074\ub9ad\ud558\uace0 \uc548\ub0b4\ub97c \ub530\ub974\uc138\uc694. \uc774\ub807\uac8c \ud558\uba74 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \uc9c4\ud589 \uc0c1\ud669\uacfc \uc7a0\uae08 \ud574\uc81c\ub41c \ud56d\ubaa9\uc774 \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\ubc95 \ube44\uad50: \uac01 \ud50c\ub7ab\ud3fc\uc758 \ub370\uc774\ud130 \uc804\uc1a1 \ub2e8\uacc4]"}, {"question": "\ud380\ub2c8 \ub9e4\ub4dc \ub808\uc774\uc2f1 \ud2b8\ub799\uc5d0\uc11c \uc228\uaca8\uc9c4 \uc9c0\ub984\uae38\uc744 \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\ub098\uc694?", "answer": "\uc228\uaca8\uc9c4 \uc9c0\ub984\uae38\uc740 \uacbd\uc7c1\ub825\uc744 \ub192\uc5ec\uc90d\ub2c8\ub2e4. \ubd80\uc11c\uc9c4 \uc6b8\ud0c0\ub9ac\ub098 \ud2b9\uc774\ud55c \uc9c8\uac10\uacfc \uac19\uc740 \ubbf8\ubb18\ud55c \ud658\uacbd \ub2e8\uc11c\ub97c \ucc3e\uc544\ubcf4\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\ub3c4\uc2dc \uc815\uae00' \ud2b8\ub799\uc5d0\ub294 \ubcbd\ud654\uac00 \uadf8\ub824\uc9c4 \uace8\ubaa9\uae38\uc744 \ud1b5\ud574 \uc9c0\ub984\uae38\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc8fc\uc694 \uacbd\ub85c\uc5d0\uc11c \ubc97\uc5b4\ub098 \uc2e4\ud5d8\ud574\ubcf4\uba74 \uc885\uc885 \uc774\ub7ec\ud55c \ube44\ubc00\ub4e4\uc744 \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc9c0\ub984\uae38\uc744 \ubbf8\ub85c\uc758 \ube44\ubc00 \ud1b5\ub85c\ub77c\uace0 \uc0dd\uac01\ud558\uc138\uc694.]"}, {"question": "\ud380\ub2c8 \ub9e4\ub4dc \ub808\uc774\uc2f1\uc758 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \ud2b8\ub799 \uc219\ub2ec\uacfc \ucc4c\ub9b0\uc9c0 \uc644\ub8cc\uc5d0 \ucd08\uc810\uc744 \ub9de\ucd94\ub294 \ubc18\uba74, \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \uc2e4\uc2dc\uac04 \uacbd\uc7c1\uc5d0 \ucd08\uc810\uc744 \ub9de\ucda5\ub2c8\ub2e4. \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \ub808\uc774\uc2a4\ub97c \uc77c\uc2dc \uc815\uc9c0\ud558\uace0 \ub2e4\uc2dc \uc2dc\ub3c4\ud560 \uc218 \uc788\uc9c0\ub9cc, \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \ube60\ub978 \ubc18\uc751 \uc18d\ub3c4\uc640 \uc804\ub7b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c \uc801\uc808\ud55c \ud0c0\uc774\ubc0d\uc758 \ubd80\uc2a4\ud2b8 \uc0ac\uc6a9\uc73c\ub85c \uc5ec\ub7ec \uc0c1\ub300\ub97c \uc81c\uce60 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\ubc95 \ube44\uad50: \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc \uae30\ub2a5]"}, {"question": "\ud380\ub2c8 \ub9e4\ub4dc \ub808\uc774\uc2f1\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \ucd5c\uc885 \uc810\uc218\uc5d0 \uc5b4\ub5a4 \uc694\uc18c\uac00 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "\ud380\ub2c8 \ub9e4\ub4dc \ub808\uc774\uc2f1\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ub808\uc774\uc2a4 \uc21c\uc704, \ub7a9 \uc2dc\uac04 \ubc0f \uc218\ud589\ud55c \uc2a4\ud134\ud2b8\ub97c \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. \ub192\uc740 \uc21c\uc704\uc640 \ube60\ub978 \ub7a9\uc740 \ub354 \ub9ce\uc740 \uc810\uc218\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ud284\uacfc \ub4dc\ub9ac\ud504\ud2b8\uc640 \uac19\uc740 \uc2a4\ud134\ud2b8\ub294 \ubcf4\ub108\uc2a4 \uc810\uc218\ub97c \ucd94\uac00\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud558\ub298 \ub192\uc774' \ud2b8\ub799\uc5d0\uc11c \uc5ec\ub7ec \ubc88 \ud284 \uccab \ubc88\uc9f8 \uc21c\uc704\ub97c \ucc28\uc9c0\ud558\uba74 \uc810\uc218\uac00 \ucd5c\ub300\ud654\ub429\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \uc694\uc18c\ubcc4 \uc810\uc218 \ubd84\ub958]"}, {"question": "\ud380\ub2c8 \ub9e4\ub4dc \ub808\uc774\uc2f1\uc5d0\uc11c \uac8c\uc784 \ub0b4 \ud1b5\ud654\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \ud68d\ub4dd\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uac8c\uc784 \ub0b4 \ud1b5\ud654\ub97c \ud68d\ub4dd\ud558\ub294 \ubc29\ubc95\uc740 \ub808\uc774\uc2a4 \uc2b9\ub9ac, \uc77c\uc77c \ucc4c\ub9b0\uc9c0 \uc644\ub8cc \ubc0f \uc0ac\uc6a9\ud558\uc9c0 \uc54a\ub294 \ucc28\ub7c9 \ubd80\ud488 \ud310\ub9e4 \ub4f1\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc0ac\ub9c9 \ub2ec\ub9ac\uae30' \ub808\uc774\uc2a4\ub97c \uc5b4\ub824\uc6c0 \ub09c\uc774\ub3c4\ub85c \uc774\uae30\uba74 \uc0c1\ub2f9\ub7c9\uc758 \ud1b5\ud654\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc77c\uc77c \ucc4c\ub9b0\uc9c0\ub294 \ub354 \uc801\uc740 \ub178\ub825\uc73c\ub85c \ub354 \ub9ce\uc740 \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \ud1b5\ud654 \ud68d\ub4dd \ubc29\ubc95]"}, {"question": "\uae30\uc0c1 \uc870\uac74\uc774 \ud380\ub2c8 \ub9e4\ub4dc \ub808\uc774\uc2f1 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "\ube44\uc640 \uc548\uac1c\uc640 \uac19\uc740 \ub0a0\uc528 \uc870\uac74\uc740 \uc2dc\uc57c\uc640 \ucc28\ub7c9 \ud578\ub4e4\ub9c1\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ube44\uac00 \uc624\uba74 \ud2b8\ub799\uc774 \ubbf8\ub044\ub7ec\uc6cc\uc9c0\ubbc0\ub85c \uc8fc\uc758 \uae4a\uc740 \uc81c\ub3d9\uc774 \ud544\uc694\ud558\uace0, \uc548\uac1c\ub294 \uc2dc\uc57c\ub97c \uac10\uc18c\uc2dc\ucf1c \ucf54\ub108\ub97c \ud30c\uc545\ud558\uae30 \uc5b4\ub835\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud3ed\ud48d\uc6b0 \uc11c\ud0b7' \ud2b8\ub799\uc5d0\uc11c \ube44\uac00 \uc624\uba74 \ubbf8\ub044\ub7ec\uc9c8 \uc704\ud5d8\uc774 \ucee4\uc9d1\ub2c8\ub2e4. \ub0a0\uc528\uc5d0 \ub9de\ucdb0 \uc6b4\uc804 \uc2a4\ud0c0\uc77c\uc744 \uc870\uc815\ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ub0a0\uc528\ub97c \ud2b8\ub799\uc5d0\uc11c\uc758 \ub610 \ub2e4\ub978 \uc0c1\ub300\ub77c\uace0 \uc0dd\uac01\ud558\uc138\uc694.]"}, {"question": "\ud380\ub2c8 \ub9e4\ub4dc \ub808\uc774\uc2f1\uc5d0\uc11c \ub4dc\ub9ac\ud504\ud2b8 \uae30\uc220\uc744 \uc219\ub2ec\ud558\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub4dc\ub9ac\ud504\ud2b8\ub97c \uc219\ub2ec\ud558\ub824\uba74 \ud0c0\uc774\ubc0d\uacfc \uc81c\uc5b4\uac00 \uc911\uc694\ud569\ub2c8\ub2e4. STEP1: \ucf54\ub108\uc5d0 \uc801\ub2f9\ud55c \uc18d\ub3c4\ub85c \uc811\uadfc\ud558\uc138\uc694. STEP2: \ube0c\ub808\uc774\ud06c\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub4dc\ub9ac\ud504\ud2b8\ub97c \uc2dc\uc791\ud558\uc138\uc694. STEP3: \ubc29\ud5a5 \uc870\uc815\uc744 \ud1b5\ud574 \uc81c\uc5b4\ub97c \uc720\uc9c0\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uaf2c\ubd88\uaf2c\ubd88 \ud2b8\ub799' \ucf54\uc2a4\uc5d0\uc11c \uc798 \uc218\ud589\ub41c \ub4dc\ub9ac\ud504\ud2b8\ub294 \ub7a9 \uc2dc\uac04\uc744 \ub2e8\ucd95\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub0ae\uc740 \ubca0\ud305 \ub808\uc774\uc2a4\uc5d0\uc11c \uc5f0\uc2b5\ud558\uc5ec \uae30\uc220\uc744 \uc644\ubcbd\ud558\uac8c \ud558\uc138\uc694. [\ub2e4\uc591\ud55c \ubc29\ubc95 \ube44\uad50: \ub2e4\uc591\ud55c \ud2b8\ub799\uc5d0\uc11c\uc758 \ub4dc\ub9ac\ud504\ud2b8 \uae30\ubc95]"}]
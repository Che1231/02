f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u96a0\u3055\u308c\u305f\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u306f\u3001\u3042\u306a\u305f\u306b\u7af6\u4e89\u4e0a\u306e\u512a\u4f4d\u6027\u3092\u3082\u305f\u3089\u3057\u307e\u3059\u3002\u58ca\u308c\u305f\u30d5\u30a7\u30f3\u30b9\u3084\u5947\u5999\u306a\u30c6\u30af\u30b9\u30c1\u30e3\u306a\u3069\u3001\u74b0\u5883\u306e\u5fae\u5999\u306a\u624b\u304c\u304b\u308a\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u300c\u90fd\u5e02\u306e\u30b8\u30e3\u30f3\u30b0\u30eb\u300d\u30b3\u30fc\u30b9\u3067\u306f\u3001\u843d\u66f8\u304d\u306e\u58c1\u3067\u793a\u3055\u308c\u308b\u901a\u308a\u306b\u3042\u308b\u88cf\u8def\u5730\u3092\u4ecb\u3057\u305f\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u304c\u3042\u308a\u307e\u3059\u3002\u30e1\u30a4\u30f3\u306e\u30eb\u30fc\u30c8\u304b\u3089\u5916\u308c\u3066\u5b9f\u9a13\u3059\u308b\u3068\u3001\u3053\u308c\u3089\u306e\u79d8\u5bc6\u304c\u898b\u3064\u304b\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002[\u4f8b\u3048\u8a71\uff1a\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u306f\u8ff7\u8def\u306e\u79d8\u5bc6\u901a\u8def\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "Funny Mad Racing\u306e\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u3001\u30b3\u30fc\u30b9\u3092\u30de\u30b9\u30bf\u30fc\u3057\u3001\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u304a\u308a\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u306e\u7af6\u4e89\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u3044\u307e\u3059\u3002\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3067\u306f\u3001\u30ec\u30fc\u30b9\u3092\u4e00\u6642\u505c\u6b62\u3057\u3066\u3084\u308a\u76f4\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304c\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3067\u306f\u3001\u7d20\u65e9\u3044\u53cd\u5fdc\u3068\u6226\u7565\u304c\u5fc5\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3067\u306f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u306e\u826f\u3044\u30d6\u30fc\u30b9\u30c8\u3067\u8907\u6570\u306e\u5bfe\u6226\u76f8\u624b\u3092\u8ffd\u3044\u629c\u304f\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03\u8868\uff1a\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306e\u6a5f\u80fd]"}, {"question": "Funny Mad Racing\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u6700\u7d42\u7684\u306a\u30b9\u30b3\u30a2\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u8981\u56e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Funny Mad Racing\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30ec\u30fc\u30b9\u9806\u4f4d\u3001\u30e9\u30c3\u30d7\u30bf\u30a4\u30e0\u3001\u5b9f\u884c\u3057\u305f\u30b9\u30bf\u30f3\u30c8\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u4e0a\u4f4d\u306e\u9806\u4f4d\u3068\u901f\u3044\u30e9\u30c3\u30d7\u30bf\u30a4\u30e0\u306f\u3001\u3088\u308a\u591a\u304f\u306e\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u30d5\u30ea\u30c3\u30d7\u3084\u30c9\u30ea\u30d5\u30c8\u306a\u3069\u306e\u30b9\u30bf\u30f3\u30c8\u306f\u3001\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30b9\u30ab\u30a4\u30cf\u30a4\u300d\u30b3\u30fc\u30b9\u30671\u4f4d\u3067\u8907\u6570\u306e\u30d5\u30ea\u30c3\u30d7\u3092\u7372\u5f97\u3059\u308c\u3070\u3001\u6700\u5927\u9650\u306e\u30b9\u30b3\u30a2\u304c\u5f97\u3089\u308c\u307e\u3059\u3002[\u5bfe\u5fdc\u8868\uff1a\u8981\u56e0\u5225\u306e\u30b9\u30b3\u30a2\u306e\u5272\u5408]"}, {"question": "Funny Mad Racing\u3067\u30b2\u30fc\u30e0\u5185\u901a\u8ca8\u3092\u7a3c\u3050\u6700\u3082\u52b9\u679c\u7684\u306a\u65b9\u6cd5\u306f\uff1f", "answer": "\u30b2\u30fc\u30e0\u5185\u901a\u8ca8\u3092\u7a3c\u3050\u305f\u3081\u306b\u306f\u3001\u30ec\u30fc\u30b9\u3067\u52dd\u5229\u3059\u308b\u3053\u3068\u3001\u65e5\u3005\u306e\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3001\u4f7f\u7528\u3057\u306a\u3044\u8eca\u4e21\u30d1\u30fc\u30c4\u3092\u58f2\u5374\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u7802\u6f20\u306e\u30c0\u30c3\u30b7\u30e5\u300d\u30ec\u30fc\u30b9\u3092\u30cf\u30fc\u30c9\u96e3\u6613\u5ea6\u3067\u52dd\u5229\u3059\u308b\u3068\u3001\u304b\u306a\u308a\u306e\u91cf\u306e\u901a\u8ca8\u304c\u3082\u3089\u3048\u307e\u3059\u3002\u65e5\u3005\u306e\u30c1\u30e3\u30ec\u30f3\u30b8\u3067\u306f\u3001\u5c11\u306a\u3044\u52aa\u529b\u3067\u3088\u308a\u591a\u304f\u306e\u5831\u916c\u3092\u5f97\u3089\u308c\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30b2\u30fc\u30e0\u5185\u901a\u8ca8\u306e\u7372\u5f97\u65b9\u6cd5]"}, {"question": "\u5929\u5019\u306fFunny Mad Racing\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u96e8\u3084\u9727\u306a\u3069\u306e\u5929\u5019\u306f\u3001\u8996\u754c\u3068\u8eca\u4e21\u306e\u64cd\u4f5c\u6027\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u96e8\u306f\u30b3\u30fc\u30b9\u3092\u6ed1\u308a\u3084\u3059\u304f\u3057\u3001\u614e\u91cd\u306a\u30d6\u30ec\u30fc\u30ad\u304c\u5fc5\u8981\u306b\u306a\u308a\u307e\u3059\u3002\u4e00\u65b9\u3001\u9727\u306f\u8996\u754c\u3092\u72ed\u3081\u3001\u30b3\u30fc\u30ca\u30fc\u3092\u898b\u3064\u3051\u308b\u306e\u304c\u96e3\u3057\u304f\u306a\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u5d50\u306e\u30b5\u30fc\u30ad\u30c3\u30c8\u300d\u30b3\u30fc\u30b9\u3067\u306f\u3001\u96e8\u306b\u3088\u3063\u3066\u30b9\u30ad\u30c3\u30c9\u306e\u30ea\u30b9\u30af\u304c\u9ad8\u307e\u308a\u307e\u3059\u3002\u5929\u5019\u306b\u5fdc\u3058\u305f\u904b\u8ee2\u30b9\u30bf\u30a4\u30eb\u306e\u8abf\u6574\u304c\u91cd\u8981\u3067\u3059\u3002[\u4f8b\u3048\u8a71\uff1a\u5929\u5019\u306f\u30b3\u30fc\u30b9\u4e0a\u306e\u5225\u306e\u5bfe\u6226\u76f8\u624b\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "Funny Mad Racing\u3067\u306e\u30c9\u30ea\u30d5\u30c8\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u305f\u3081\u306e\u6700\u5584\u306e\u65b9\u6cd5\u306f\uff1f", "answer": "\u30c9\u30ea\u30d5\u30c8\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b3\u30fc\u30ca\u30fc\u306b\u4e2d\u7a0b\u5ea6\u306e\u901f\u5ea6\u3067\u5165\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30cf\u30f3\u30c9\u30d6\u30ec\u30fc\u30ad\u3092\u4f7f\u7528\u3057\u3066\u30c9\u30ea\u30d5\u30c8\u3092\u958b\u59cb\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30ab\u30a6\u30f3\u30bf\u30fc\u30b9\u30c6\u30a2\u30ea\u30f3\u30b0\u3067\u5236\u5fa1\u3092\u7dad\u6301\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u66f2\u304c\u308a\u304f\u306d\u3063\u305f\u30b3\u30fc\u30b9\u300d\u30b3\u30fc\u30b9\u3067\u306f\u3001\u3046\u307e\u304f\u5b9f\u884c\u3055\u308c\u305f\u30c9\u30ea\u30d5\u30c8\u306b\u3088\u308a\u30e9\u30c3\u30d7\u30bf\u30a4\u30e0\u3092\u6570\u79d2\u77ed\u7e2e\u3067\u304d\u307e\u3059\u3002\u6280\u8853\u3092\u5b8c\u74a7\u306b\u3059\u308b\u305f\u3081\u306b\u3001\u30ea\u30b9\u30af\u306e\u4f4e\u3044\u30ec\u30fc\u30b9\u3067\u7df4\u7fd2\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u6bd4\u8f03\u8868\uff1a\u7570\u306a\u308b\u30b3\u30fc\u30b9\u306b\u5bfe\u5fdc\u3059\u308b\u30c9\u30ea\u30d5\u30c8\u306e\u30c6\u30af\u30cb\u30c3\u30af]"}]
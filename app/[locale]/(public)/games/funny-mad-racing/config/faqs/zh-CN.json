[{"question": "\u65b0\u624b\u5982\u4f55\u8fdb\u884c\u5feb\u4e50\u75af\u72c2\u8d5b\u8f66\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u5728\u5feb\u4e50\u75af\u72c2\u8d5b\u8f66\u4e2d\uff0c\u57fa\u672c\u64cd\u4f5c\u5bf9\u4e8e\u65b0\u624b\u81f3\u5173\u91cd\u8981\u3002\u4f7f\u7528\u65b9\u5411\u952e\u6216 WASD \u952e\u8fdb\u884c\u79fb\u52a8\u3002\u7a7a\u683c\u952e\u7528\u4e8e\u8df3\u8dc3\uff0cShift \u952e\u7528\u4e8e\u52a0\u901f\u3002\u4f8b\u5982\uff0c\u5f53\u63a5\u8fd1\u5761\u9053\u65f6\uff0c\u6309\u7a7a\u683c\u952e\u8df3\u8dc3\uff0c\u5e76\u6309 Shift \u952e\u5728\u7a7a\u4e2d\u52a0\u901f\u4ee5\u83b7\u5f97\u989d\u5916\u8ddd\u79bb\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u8fd9\u4e9b\u64cd\u4f5c\u60f3\u8c61\u6210\u9a7e\u9a76\u6c7d\u8f66\uff0c\u5176\u4e2d\u7a7a\u683c\u952e\u662f\u8df3\u8dc3\u7684\u5239\u8f66]\u3002"}, {"question": "\u5728\u73a9\u5feb\u4e50\u75af\u72c2\u8d5b\u8f66 100 \u5c0f\u65f6\u540e\uff0c\u8d62\u5f97\u6bd4\u8d5b\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "100 \u5c0f\u65f6\u540e\uff0c\u638c\u63e1\u9ad8\u7ea7\u7b56\u7565\u81f3\u5173\u91cd\u8981\u3002\u6b65\u9aa4\u4e00\uff1a\u6df1\u5165\u4e86\u89e3\u8d5b\u9053\uff0c\u9884\u5224\u8f6c\u5f2f\u548c\u8df3\u8dc3\u3002\u6b65\u9aa4\u4e8c\uff1a\u7b56\u7565\u6027\u5730\u4f7f\u7528\u52a0\u901f\uff0c\u5c06\u5176\u4fdd\u7559\u5728\u76f4\u9053\u4e0a\u800c\u4e0d\u662f\u5f2f\u9053\u4e0a\u3002\u6b65\u9aa4\u4e09\uff1a\u81ea\u5b9a\u4e49\u8f66\u8f86\u4ee5\u5e73\u8861\u901f\u5ea6\u548c\u63a7\u5236\u529b\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5ce1\u8c37\u8d5b\u9053\u201d\u4e0a\uff0c\u6bd4\u8d5b\u5f00\u59cb\u65f6\u4f7f\u7528\u52a0\u901f\u53ef\u4ee5\u83b7\u5f97\u9886\u5148\u4f18\u52bf\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u4e0d\u540c\u8d5b\u9053\u4e0a\u7684\u52a0\u901f\u4f7f\u7528]"}, {"question": "\u4e3a\u4ec0\u4e48\u5feb\u4e50\u75af\u72c2\u8d5b\u8f66\u5305\u542b\u8f66\u8f86\u81ea\u5b9a\u4e49\u7cfb\u7edf\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\uff1f", "answer": "\u5feb\u4e50\u75af\u72c2\u8d5b\u8f66\u7684\u8f66\u8f86\u81ea\u5b9a\u4e49\u7cfb\u7edf\u5141\u8bb8\u73a9\u5bb6\u8c03\u6574\u8f66\u8f86\u4ee5\u83b7\u5f97\u6700\u4f73\u6027\u80fd\u3002\u8c03\u6574\u60ac\u6302\u53ef\u4ee5\u6539\u5584\u5728\u5d0e\u5c96\u5730\u5f62\u4e0a\u7684\u64cd\u63a7\u6027\uff0c\u800c\u5f15\u64ce\u5347\u7ea7\u5219\u53ef\u4ee5\u63d0\u9ad8\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u201c\u6ce5\u6cde\u72c2\u66b4\u201d\u8d5b\u9053\u4e0a\uff0c\u66f4\u9ad8\u7684\u60ac\u6302\u8bbe\u7f6e\u53ef\u4ee5\u9632\u6b62\u7ffb\u8f66\u3002\u8be5\u7cfb\u7edf\u589e\u52a0\u4e86\u6df1\u5ea6\uff0c\u8ba9\u73a9\u5bb6\u80fd\u591f\u9002\u5e94\u5404\u79cd\u8d5b\u8f66\u60c5\u51b5\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u81ea\u5b9a\u4e49\u5bf9\u6027\u80fd\u7684\u5f71\u54cd]"}, {"question": "\u54ea\u4e9b\u5e73\u53f0\u652f\u6301\u5feb\u4e50\u75af\u72c2\u8d5b\u8f66\uff0c\u4ee5\u53ca\u5982\u4f55\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u6e38\u620f\u6570\u636e\uff1f", "answer": "\u5feb\u4e50\u75af\u72c2\u8d5b\u8f66\u53ef\u5728 PC\u3001PlayStation \u548c Xbox \u5e73\u53f0\u4e0a\u6e38\u73a9\u3002\u8981\u8f6c\u79fb\u6570\u636e\uff0c\u8bf7\u901a\u8fc7\u6e38\u620f\u8bbe\u7f6e\u83dc\u5355\u5c06\u60a8\u7684\u6e38\u620f\u8d26\u6237\u94fe\u63a5\u5230\u4e2d\u592e\u4e2a\u4eba\u8d44\u6599\u3002\u4f8b\u5982\uff0c\u5728 PC \u4e0a\uff0c\u8f6c\u5230\u201c\u8bbe\u7f6e\u201d>\u201c\u5e10\u6237\u201d>\u201c\u94fe\u63a5\u4e2a\u4eba\u8d44\u6599\u201d\uff0c\u5e76\u6309\u7167\u63d0\u793a\u64cd\u4f5c\u3002\u8fd9\u786e\u4fdd\u4e86\u60a8\u7684\u8fdb\u5ea6\u548c\u89e3\u9501\u5185\u5bb9\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u540c\u6b65\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6bcf\u4e2a\u5e73\u53f0\u7684\u6570\u636e\u8f6c\u79fb\u6b65\u9aa4]"}, {"question": "\u5982\u4f55\u5728\u5feb\u4e50\u75af\u72c2\u8d5b\u8f66\u7684\u8d5b\u9053\u4e0a\u627e\u5230\u9690\u85cf\u7684\u6377\u5f84\uff1f", "answer": "\u9690\u85cf\u7684\u6377\u5f84\u53ef\u4ee5\u4e3a\u60a8\u63d0\u4f9b\u7ade\u4e89\u4f18\u52bf\u3002\u5bfb\u627e\u7ec6\u5fae\u7684\u73af\u5883\u7ebf\u7d22\uff0c\u4f8b\u5982\u635f\u574f\u7684\u6805\u680f\u6216\u4e0d\u5bfb\u5e38\u7684\u7eb9\u7406\u3002\u4f8b\u5982\uff0c\u5728\u201c\u57ce\u5e02\u4e1b\u6797\u201d\u8d5b\u9053\u4e0a\uff0c\u901a\u8fc7\u6d82\u9e26\u5899\u6807\u8bb0\u7684\u5df7\u9053\u4e2d\u6709\u4e00\u4e2a\u6377\u5f84\u3002\u79bb\u5f00\u4e3b\u8def\u8fdb\u884c\u5c1d\u8bd5\uff0c\u901a\u5e38\u4f1a\u53d1\u73b0\u8fd9\u4e9b\u79d8\u5bc6\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u6377\u5f84\u60f3\u8c61\u6210\u8ff7\u5bab\u4e2d\u7684\u79d8\u5bc6\u901a\u9053\u3002]"}, {"question": "\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u5728\u5feb\u4e50\u75af\u72c2\u8d5b\u8f66\u4e2d\u7684\u4e3b\u8981\u533a\u522b\u662f\u4ec0\u4e48\uff1f", "answer": "\u5355\u4eba\u6a21\u5f0f\u4e13\u6ce8\u4e8e\u638c\u63e1\u8d5b\u9053\u548c\u5b8c\u6210\u6311\u6218\uff0c\u800c\u591a\u4eba\u6a21\u5f0f\u5219\u4fa7\u91cd\u4e8e\u5b9e\u65f6\u7ade\u4e89\u3002\u5728\u5355\u4eba\u6a21\u5f0f\u4e2d\uff0c\u60a8\u53ef\u4ee5\u6682\u505c\u5e76\u91cd\u8bd5\u6bd4\u8d5b\uff0c\u800c\u591a\u4eba\u6a21\u5f0f\u5219\u9700\u8981\u5feb\u901f\u53cd\u5e94\u548c\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f7f\u7528\u65f6\u673a\u6070\u5f53\u7684\u52a0\u901f\u53ef\u4ee5\u8d85\u8d8a\u591a\u4e2a\u5bf9\u624b\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u5355\u4eba\u6a21\u5f0f\u4e0e\u591a\u4eba\u6a21\u5f0f\u529f\u80fd]"}, {"question": "\u5feb\u4e50\u75af\u72c2\u8d5b\u8f66\u7684\u8ba1\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u6700\u7ec8\u5f97\u5206\uff1f", "answer": "\u5feb\u4e50\u75af\u72c2\u8d5b\u8f66\u7684\u8ba1\u5206\u7cfb\u7edf\u57fa\u4e8e\u6bd4\u8d5b\u6392\u540d\u3001\u5708\u901f\u548c\u5b8c\u6210\u7684\u6280\u5de7\u3002\u66f4\u9ad8\u7684\u6392\u540d\u548c\u66f4\u5feb\u7684\u5708\u901f\u4f1a\u83b7\u5f97\u66f4\u591a\u79ef\u5206\u3002\u7ffb\u8f6c\u548c\u6f02\u79fb\u7b49\u6280\u5de7\u4f1a\u589e\u52a0\u989d\u5916\u79ef\u5206\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5929\u7a7a\u4e4b\u9ad8\u201d\u8d5b\u9053\u4e0a\u83b7\u5f97\u7b2c\u4e00\u540d\u5e76\u5b8c\u6210\u591a\u6b21\u7ffb\u8f6c\u53ef\u4ee5\u6700\u5927\u5316\u60a8\u7684\u5f97\u5206\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6309\u56e0\u7d20\u5212\u5206\u7684\u5f97\u5206\u7ec6\u5206]"}, {"question": "\u5728\u5feb\u4e50\u75af\u72c2\u8d5b\u8f66\u4e2d\u83b7\u5f97\u6e38\u620f\u5185\u8d27\u5e01\u7684\u6700\u6709\u6548\u65b9\u6cd5\u6709\u54ea\u4e9b\uff1f", "answer": "\u901a\u8fc7\u8d62\u5f97\u6bd4\u8d5b\u3001\u5b8c\u6210\u6bcf\u65e5\u6311\u6218\u548c\u51fa\u552e\u672a\u4f7f\u7528\u8f66\u8f86\u96f6\u4ef6\u53ef\u4ee5\u83b7\u5f97\u6e38\u620f\u5185\u8d27\u5e01\u3002\u4f8b\u5982\uff0c\u4ee5\u56f0\u96be\u96be\u5ea6\u8d62\u5f97\u201c\u6c99\u6f20\u51b2\u523a\u201d\u6bd4\u8d5b\u5c06\u5956\u52b1\u5927\u91cf\u8d27\u5e01\u3002\u6bcf\u65e5\u6311\u6218\u901a\u5e38\u4f1a\u4ee5\u66f4\u5c11\u7684\u52aa\u529b\u83b7\u5f97\u66f4\u9ad8\u7684\u5956\u52b1\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u8d27\u5e01\u83b7\u5f97\u65b9\u6cd5]"}, {"question": "\u5929\u6c14\u6761\u4ef6\u5982\u4f55\u5728\u5feb\u4e50\u75af\u72c2\u8d5b\u8f66\u4e2d\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\uff1f", "answer": "\u96e8\u5929\u548c\u96fe\u5929\u7b49\u5929\u6c14\u4f1a\u5f71\u54cd\u80fd\u89c1\u5ea6\u548c\u8f66\u8f86\u64cd\u63a7\u3002\u4e0b\u96e8\u4f7f\u8d5b\u9053\u53d8\u5f97\u6e7f\u6ed1\uff0c\u9700\u8981\u5c0f\u5fc3\u5239\u8f66\uff0c\u800c\u96fe\u5929\u964d\u4f4e\u4e86\u80fd\u89c1\u5ea6\uff0c\u4f7f\u8f6c\u5f2f\u66f4\u96be\u53d1\u73b0\u3002\u4f8b\u5982\uff0c\u5728\u201c\u66b4\u98ce\u96e8\u8d5b\u9053\u201d\u4e0a\uff0c\u4e0b\u96e8\u4f1a\u589e\u52a0\u6253\u6ed1\u7684\u98ce\u9669\u3002\u8c03\u6574\u60a8\u7684\u9a7e\u9a76\u98ce\u683c\u4ee5\u9002\u5e94\u5929\u6c14\u81f3\u5173\u91cd\u8981\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u5929\u6c14\u60f3\u8c61\u6210\u8d5b\u9053\u4e0a\u7684\u989d\u5916\u5bf9\u624b]"}, {"question": "\u5728\u5feb\u4e50\u75af\u72c2\u8d5b\u8f66\u4e2d\u638c\u63e1\u6f02\u79fb\u6280\u5de7\u7684\u6700\u4f73\u5b9e\u8df5\u662f\u4ec0\u4e48\uff1f", "answer": "\u638c\u63e1\u6f02\u79fb\u9700\u8981\u65f6\u673a\u548c\u63a7\u5236\u529b\u3002\u6b65\u9aa4\u4e00\uff1a\u4ee5\u4e2d\u7b49\u901f\u5ea6\u8fdb\u5165\u5f2f\u9053\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u5239\u8f66\u952e\u542f\u52a8\u6f02\u79fb\u3002\u6b65\u9aa4\u4e09\uff1a\u53cd\u6253\u65b9\u5411\u76d8\u4fdd\u6301\u63a7\u5236\u3002\u4f8b\u5982\uff0c\u5728\u201c\u873f\u8712\u8d5b\u9053\u201d\u4e0a\uff0c\u6267\u884c\u826f\u597d\u7684\u6f02\u79fb\u53ef\u4ee5\u7f29\u77ed\u60a8\u7684\u5708\u901f\u3002\u5728\u4f4e\u98ce\u9669\u6bd4\u8d5b\u4e2d\u7ec3\u4e60\u53ef\u5b8c\u5584\u60a8\u7684\u6280\u672f\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u4e0d\u540c\u8d5b\u9053\u7684\u6f02\u79fb\u6280\u5de7]"}]
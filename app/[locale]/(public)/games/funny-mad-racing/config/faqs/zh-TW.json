[{"question": "\u65b0\u624b\u5982\u4f55\u9032\u884c\u760b\u72c2\u8cfd\u8eca\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u5728\u760b\u72c2\u8cfd\u8eca\u4e2d\uff0c\u57fa\u672c\u64cd\u4f5c\u5c0d\u65b0\u624b\u81f3\u95dc\u91cd\u8981\u3002\u4f7f\u7528\u65b9\u5411\u9375\u6216 WASD \u9375\u9032\u884c\u79fb\u52d5\u3002\u7a7a\u683c\u9375\u7528\u65bc\u8df3\u8e8d\uff0cShift \u9375\u7528\u65bc\u52a0\u901f\u3002\u4f8b\u5982\uff0c\u5728\u63a5\u8fd1\u659c\u5761\u6642\uff0c\u6309\u4e0b\u7a7a\u683c\u9375\u8df3\u8e8d\uff0c\u4e26\u5728\u7a7a\u4e2d\u6309\u4e0b Shift \u9375\u52a0\u901f\uff0c\u4ee5\u7372\u5f97\u984d\u5916\u7684\u8ddd\u96e2\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u64cd\u4f5c\u60f3\u50cf\u6210\u958b\u8eca\uff0c\u5176\u4e2d\u7a7a\u683c\u9375\u662f\u4f60\u7684\u8df3\u8e8d\u524e\u8eca\u3002]"}, {"question": "\u5728\u73a9\u760b\u72c2\u8cfd\u8eca 100 \u5c0f\u6642\u5f8c\uff0c\u8d0f\u5f97\u6bd4\u8cfd\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u73a9\u4e86 100 \u5c0f\u6642\u5f8c\uff0c\u638c\u63e1\u5148\u9032\u7b56\u7565\u81f3\u95dc\u91cd\u8981\u3002\u6b65\u9a5f 1\uff1a\u719f\u6089\u8cfd\u9053\uff0c\u9810\u6e2c\u8f49\u5f4e\u548c\u8df3\u8e8d\u3002\u6b65\u9a5f 2\uff1a\u7b56\u7565\u6027\u5730\u4f7f\u7528\u52a0\u901f\u5668\uff1b\u5c07\u5176\u5132\u5b58\u8d77\u4f86\u7528\u65bc\u76f4\u7dda\u8def\u6bb5\uff0c\u800c\u4e0d\u662f\u5f4e\u9053\u3002\u6b65\u9a5f 3\uff1a\u81ea\u8a02\u4f60\u7684\u8eca\u8f1b\uff0c\u5e73\u8861\u901f\u5ea6\u548c\u63a7\u5236\u529b\u3002\u4f8b\u5982\uff0c\u5728\u300c\u5cfd\u8c37\u8cfd\u9053\u300d\u4e0a\uff0c\u8d77\u8dd1\u6642\u52a0\u901f\u53ef\u4ee5\u8b93\u4f60\u5728\u4e00\u958b\u59cb\u5c31\u9818\u5148\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u4e0d\u540c\u8cfd\u9053\u4e0a\u7684\u52a0\u901f\u5668\u4f7f\u7528]"}, {"question": "\u70ba\u4ec0\u9ebc\u760b\u72c2\u8cfd\u8eca\u5305\u542b\u8eca\u8f1b\u81ea\u8a02\u7cfb\u7d71\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff1f", "answer": "\u760b\u72c2\u8cfd\u8eca\u7684\u8eca\u8f1b\u81ea\u8a02\u7cfb\u7d71\u5141\u8a31\u73a9\u5bb6\u8abf\u6574\u4ed6\u5011\u7684\u8eca\u8f1b\uff0c\u4ee5\u7372\u5f97\u6700\u4f73\u6548\u80fd\u3002\u8abf\u6574\u61f8\u540a\u53ef\u4ee5\u6539\u5584\u5728\u5d0e\u5d87\u5730\u5f62\u4e0a\u7684\u64cd\u63a7\u6027\uff0c\u800c\u5f15\u64ce\u5347\u7d1a\u5247\u6703\u63d0\u9ad8\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u300c\u6ce5\u6fd8\u72c2\u66b4\u300d\u8cfd\u9053\u4e0a\uff0c\u66f4\u9ad8\u7684\u61f8\u540a\u8a2d\u5b9a\u53ef\u4ee5\u9632\u6b62\u7ffb\u8eca\u3002\u9019\u500b\u7cfb\u7d71\u589e\u52a0\u4e86\u6df1\u5ea6\uff0c\u8b93\u73a9\u5bb6\u80fd\u5920\u9069\u61c9\u5404\u7a2e\u8cfd\u8eca\u689d\u4ef6\u3002[\u6d41\u7a0b\u5716\u89e3: \u81ea\u8a02\u5c0d\u6548\u80fd\u7684\u5f71\u97ff]"}, {"question": "\u54ea\u4e9b\u5e73\u53f0\u652f\u63f4\u760b\u72c2\u8cfd\u8eca\uff0c\u4ee5\u53ca\u5982\u4f55\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u9593\u8f49\u79fb\u6211\u7684\u904a\u6232\u6578\u64da\uff1f", "answer": "\u760b\u72c2\u8cfd\u8eca\u53ef\u5728 PC\u3001PlayStation \u548c Xbox \u5e73\u53f0\u4e0a\u904a\u73a9\u3002\u8981\u8f49\u79fb\u6578\u64da\uff0c\u8acb\u900f\u904e\u904a\u6232\u8a2d\u5b9a\u9078\u55ae\u5c07\u60a8\u7684\u904a\u6232\u5e33\u6236\u9023\u7d50\u5230\u4e2d\u592e\u500b\u4eba\u8cc7\u6599\u3002\u4f8b\u5982\uff0c\u5728 PC \u4e0a\uff0c\u8acb\u524d\u5f80\u300c\u8a2d\u5b9a\u300d>\u300c\u5e33\u6236\u300d>\u300c\u9023\u7d50\u500b\u4eba\u8cc7\u6599\u300d\uff0c\u4e26\u6309\u7167\u8aaa\u660e\u64cd\u4f5c\u3002\u9019\u78ba\u4fdd\u4e86\u60a8\u7684\u9032\u5ea6\u548c\u89e3\u9396\u5167\u5bb9\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u540c\u6b65\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u5404\u5e73\u53f0\u7684\u6578\u64da\u8f49\u79fb\u6b65\u9a5f]"}, {"question": "\u5982\u4f55\u5728\u760b\u72c2\u8cfd\u8eca\u7684\u8cfd\u9053\u4e0a\u627e\u5230\u96b1\u85cf\u7684\u6377\u5f91\uff1f", "answer": "\u96b1\u85cf\u7684\u6377\u5f91\u53ef\u4ee5\u8b93\u4f60\u64c1\u6709\u7af6\u722d\u512a\u52e2\u3002\u5c0b\u627e\u7d30\u5fae\u7684\u74b0\u5883\u7dda\u7d22\uff0c\u4f8b\u5982\u7834\u640d\u7684\u67f5\u6b04\u6216\u4e0d\u5c0b\u5e38\u7684\u7d0b\u7406\u3002\u4f8b\u5982\uff0c\u5728\u300c\u57ce\u5e02\u53e2\u6797\u300d\u8cfd\u9053\u4e2d\uff0c\u6709\u4e00\u500b\u901a\u904e\u5857\u9d09\u7246\u6a19\u8a18\u7684\u5c0f\u5df7\u6377\u5f91\u3002\u5617\u8a66\u96e2\u958b\u4e3b\u8981\u8def\u7dda\uff0c\u7d93\u5e38\u6703\u767c\u73fe\u9019\u4e9b\u79d8\u5bc6\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u6377\u5f91\u60f3\u50cf\u6210\u8ff7\u5bae\u4e2d\u7684\u79d8\u5bc6\u901a\u9053\u3002]"}, {"question": "\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u5728\u760b\u72c2\u8cfd\u8eca\u4e2d\u6709\u54ea\u4e9b\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "\u55ae\u4eba\u6a21\u5f0f\u5074\u91cd\u65bc\u638c\u63e1\u8cfd\u9053\u548c\u5b8c\u6210\u6311\u6230\uff0c\u800c\u591a\u4eba\u6a21\u5f0f\u5247\u5f37\u8abf\u5be6\u6642\u7af6\u722d\u3002\u5728\u55ae\u4eba\u6a21\u5f0f\u4e2d\uff0c\u60a8\u53ef\u4ee5\u66ab\u505c\u4e26\u91cd\u8a66\u6bd4\u8cfd\uff0c\u800c\u591a\u4eba\u6a21\u5f0f\u5247\u9700\u8981\u5feb\u901f\u53cd\u61c9\u548c\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f7f\u7528\u53ca\u6642\u7684\u52a0\u901f\u5668\u53ef\u4ee5\u8d85\u8d8a\u591a\u500b\u5c0d\u624b\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u55ae\u4eba\u6a21\u5f0f\u8207\u591a\u4eba\u6a21\u5f0f\u7684\u529f\u80fd]"}, {"question": "\u760b\u72c2\u8cfd\u8eca\u7684\u5206\u6578\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u6700\u7d42\u5206\u6578\uff1f", "answer": "\u760b\u72c2\u8cfd\u8eca\u7684\u5206\u6578\u7cfb\u7d71\u57fa\u65bc\u6bd4\u8cfd\u4f4d\u7f6e\u3001\u5708\u901f\u548c\u5b8c\u6210\u7684\u7279\u6280\u52d5\u4f5c\u3002\u66f4\u9ad8\u7684\u6392\u540d\u548c\u66f4\u5feb\u7684\u5708\u901f\u6703\u7372\u5f97\u66f4\u591a\u7684\u5206\u6578\u3002\u4f8b\u5982\uff0c\u5728\u300c\u5929\u7a7a\u4e4b\u5dd4\u300d\u8cfd\u9053\u4e0a\uff0c\u5b8c\u6210\u7b2c\u4e00\u540d\u4e26\u5b8c\u6210\u591a\u8d77\u7279\u6280\u52d5\u4f5c\u5c07\u6703\u6700\u5927\u5316\u4f60\u7684\u5206\u6578\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u57fa\u65bc\u5404\u56e0\u7d20\u7684\u5206\u6578\u5206\u89e3]"}, {"question": "\u5728\u760b\u72c2\u8cfd\u8eca\u4e2d\u7372\u5f97\u904a\u6232\u8ca8\u5e63\u7684\u6700\u6709\u6548\u65b9\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "\u7372\u5f97\u904a\u6232\u8ca8\u5e63\u7684\u65b9\u6cd5\u5305\u62ec\u8d0f\u5f97\u6bd4\u8cfd\u3001\u5b8c\u6210\u6bcf\u65e5\u6311\u6230\u4ee5\u53ca\u51fa\u552e\u672a\u4f7f\u7528\u7684\u8eca\u8f1b\u96f6\u4ef6\u3002\u4f8b\u5982\uff0c\u5728\u300c\u6c99\u6f20\u885d\u523a\u300d\u8cfd\u9053\u4e2d\u4ee5\u56f0\u96e3\u96e3\u5ea6\u8d0f\u5f97\u6bd4\u8cfd\uff0c\u5c07\u6703\u734e\u52f5\u5927\u91cf\u8ca8\u5e63\u3002\u6bcf\u65e5\u6311\u6230\u901a\u5e38\u5728\u8f03\u5c11\u52aa\u529b\u7684\u60c5\u6cc1\u4e0b\uff0c\u6709\u8f03\u9ad8\u7684\u734e\u52f5\u3002[\u6d41\u7a0b\u5716\u89e3: \u8ca8\u5e63\u7372\u53d6\u65b9\u6cd5]"}, {"question": "\u5929\u6c23\u689d\u4ef6\u5982\u4f55\u5728\u760b\u72c2\u8cfd\u8eca\u4e2d\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff1f", "answer": "\u4e0b\u96e8\u548c\u9727\u7b49\u5929\u6c23\u689d\u4ef6\u6703\u5f71\u97ff\u80fd\u898b\u5ea6\u548c\u8eca\u8f1b\u64cd\u63a7\u3002\u4e0b\u96e8\u4f7f\u8cfd\u9053\u6fd5\u6ed1\uff0c\u9700\u8981\u5c0f\u5fc3\u5236\u52d5\uff0c\u800c\u9727\u6c23\u5247\u964d\u4f4e\u80fd\u898b\u5ea6\uff0c\u4f7f\u5f97\u8f49\u5f4e\u66f4\u96e3\u767c\u73fe\u3002\u4f8b\u5982\uff0c\u5728\u300c\u66b4\u98a8\u96fb\u8def\u300d\u8cfd\u9053\u4e0a\uff0c\u4e0b\u96e8\u6703\u589e\u52a0\u6253\u6ed1\u7684\u98a8\u96aa\u3002\u8abf\u6574\u4f60\u7684\u99d5\u99db\u98a8\u683c\u4ee5\u9069\u61c9\u5929\u6c23\u81f3\u95dc\u91cd\u8981\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u5929\u6c23\u60f3\u50cf\u6210\u8cfd\u9053\u4e0a\u7684\u984d\u5916\u5c0d\u624b\u3002]"}, {"question": "\u5728\u760b\u72c2\u8cfd\u8eca\u4e2d\u638c\u63e1\u6f02\u79fb\u6a5f\u5236\u7684\u6700\u4f73\u505a\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "\u638c\u63e1\u6f02\u79fb\u9700\u8981\u6e96\u78ba\u7684\u6642\u9593\u548c\u63a7\u5236\u3002\u6b65\u9a5f 1\uff1a\u4ee5\u9069\u4e2d\u7684\u901f\u5ea6\u9032\u5165\u5f4e\u9053\u3002\u6b65\u9a5f 2\uff1a\u4f7f\u7528\u524e\u8eca\u4f86\u555f\u52d5\u6f02\u79fb\u3002\u6b65\u9a5f 3\uff1a\u53cd\u5411\u8f49\u5411\u4ee5\u4fdd\u6301\u63a7\u5236\u3002\u4f8b\u5982\uff0c\u5728\u300c\u5f4e\u9053\u8ff7\u5bae\u300d\u8cfd\u9053\u4e2d\uff0c\u57f7\u884c\u826f\u597d\u7684\u6f02\u79fb\u52d5\u4f5c\u53ef\u4ee5\u7e2e\u77ed\u4f60\u7684\u5708\u901f\u3002\u5728\u8f03\u4f4e\u7684\u8ced\u6ce8\u6bd4\u8cfd\u4e2d\u7df4\u7fd2\uff0c\u624d\u80fd\u7cbe\u9032\u4f60\u7684\u6280\u5de7\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u4e0d\u540c\u8cfd\u9053\u4e0a\u7684\u6f02\u79fb\u6280\u5de7]"}]
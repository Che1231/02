[{"question": "\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001\u30b9\u30a4\u30ab\u30b2\u30fc\u30e0\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u65b9\u6cd5\u3092\u6559\u3048\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "\u30b9\u30a4\u30ab\u30b2\u30fc\u30e0\u3067\u306f\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u306f\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u307e\u305a\u3001\u65b9\u5411\u30d1\u30c3\u30c9\u3092\u4f7f\u3063\u3066\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u52d5\u304b\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u4e0a\u300f\u30ad\u30fc\u3092\u62bc\u3059\u3068\u30b8\u30e3\u30f3\u30d7\u3057\u3001\u300e\u5de6/\u53f3\u300f\u30ad\u30fc\u3092\u62bc\u3059\u3068\u6c34\u5e73\u65b9\u5411\u306b\u79fb\u52d5\u3067\u304d\u307e\u3059\u3002\u6b21\u306b\u3001\u300eA\u300f\u30ad\u30fc\u3092\u62bc\u3057\u3066\u30a2\u30a4\u30c6\u30e0\u3084\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3068\u5bfe\u8a71\u3057\u307e\u3059\u3002\u6700\u5f8c\u306b\u3001\u300eB\u300f\u30ad\u30fc\u3092\u62bc\u3057\u3066\u6575\u3078\u306e\u653b\u6483\u306a\u3069\u3001\u7279\u5225\u306a\u30a2\u30af\u30b7\u30e7\u30f3\u3092\u5b9f\u884c\u3057\u307e\u3059\u3002\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30ec\u30d9\u30eb\u3067\u3053\u308c\u3089\u306e\u64cd\u4f5c\u3092\u7df4\u7fd2\u3057\u3066\u6163\u308c\u308b\u3053\u3068\u3092\u304a\u52e7\u3081\u3057\u307e\u3059\u3002"}, {"question": "100\u6642\u9593\u30d7\u30ec\u30a4\u5f8c\u3001\u30b9\u30a4\u30ab\u30b2\u30fc\u30e0\u3067\u9577\u304f\u751f\u304d\u6b8b\u308b\u305f\u3081\u306e\u91cd\u8981\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30a4\u30ab\u30b2\u30fc\u30e0\u3067100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u751f\u5b58\u6226\u7565\u306f\u91cd\u8981\u306b\u306a\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u56de\u5fa9\u85ac\u306a\u3069\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u53ce\u96c6\u30fb\u4fdd\u5b58\u3059\u308b\u3053\u3068\u3067\u3001\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u3092\u30de\u30b9\u30bf\u30fc\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30dc\u30b9\u6226\u306e\u305f\u3081\u306b\u56de\u5fa9\u85ac\u3092\u7bc0\u7d04\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6575\u306e\u653b\u6483\u30d1\u30bf\u30fc\u30f3\u3092\u5b66\u3073\u307e\u3059\u3002\u5404\u6575\u306b\u306f\u72ec\u81ea\u306e\u653b\u6483\u30d1\u30bf\u30fc\u30f3\u304c\u3042\u308a\u307e\u3059\u3002\u9069\u5207\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u56de\u907f\u3059\u308b\u3053\u3068\u3067\u3001\u4f53\u529b\u3092\u5b88\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u88c5\u5099\u3092\u5b9a\u671f\u7684\u306b\u5f37\u5316\u3057\u307e\u3059\u3002\u3088\u308a\u826f\u3044\u88c5\u5099\u306f\u751f\u5b58\u7387\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002\u5e38\u306b\u653b\u6483\u529b\u3068\u9632\u5fa1\u529b\u306e\u30d0\u30e9\u30f3\u30b9\u3092\u6700\u9069\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u305f\u3081\u306b\u4fdd\u3063\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30b9\u30a4\u30ab\u30b2\u30fc\u30e0\u306e\u30c0\u30e1\u30fc\u30b8\u8a08\u7b97\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u306a\u305c\u91cd\u8981\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30a4\u30ab\u30b2\u30fc\u30e0\u306e\u30c0\u30e1\u30fc\u30b8\u8a08\u7b97\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u6700\u9069\u5316\u306b\u3068\u3063\u3066\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u30c0\u30e1\u30fc\u30b8\u306f\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u653b\u6483\u529b\u3001\u6575\u306e\u9632\u5fa1\u529b\u3001\u30d0\u30d5/\u30c7\u30d0\u30d5\u306b\u57fa\u3065\u3044\u3066\u8a08\u7b97\u3055\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u3042\u306a\u305f\u306e\u653b\u6483\u529b\u304c50\u3067\u3001\u6575\u306e\u9632\u5fa1\u529b\u304c20\u306e\u5834\u5408\u3001\u4e0e\u3048\u3089\u308c\u308b\u30c0\u30e1\u30fc\u30b8\u306f30\u3067\u3059\u3002\u3055\u3089\u306b\u3001\u7279\u5b9a\u306e\u30a2\u30a4\u30c6\u30e0\uff08\u4f8b\uff1a\u300e\u30d1\u30ef\u30fc\u30b0\u30ed\u30fc\u30d6\u300f\uff09\u306f\u653b\u6483\u529b\u3092\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u3001+10\u306e\u5897\u52a0\u3092\u3082\u305f\u3089\u3057\u307e\u3059\u3002\u3053\u308c\u3092\u77e5\u308c\u3070\u3001\u6226\u95d8\u306e\u6226\u7565\u3092\u7acb\u3066\u3001\u9069\u5207\u306a\u88c5\u5099\u3092\u9078\u629e\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30b9\u30a4\u30ab\u30b2\u30fc\u30e0\u306e\u9032\u884c\u72b6\u6cc1\u3092\u5225\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u79fb\u884c\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30a4\u30ab\u30b2\u30fc\u30e0\u306e\u9032\u884c\u72b6\u6cc1\u3092\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u79fb\u884c\u3059\u308b\u306e\u306f\u7c21\u5358\u3067\u3059\u3002\u307e\u305a\u3001\u30b2\u30fc\u30e0\u8a2d\u5b9a\u3067\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u6709\u52b9\u306b\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5143\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u300e\u8a2d\u5b9a\u300f\u3092\u958b\u304d\u3001\u300e\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u300f\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u6b21\u306b\u3001\u65b0\u3057\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u6700\u5f8c\u306b\u3001\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3066\u3001\u9032\u884c\u72b6\u6cc1\u3092\u7d9a\u3051\u307e\u3059\u3002\u3053\u306e\u65b9\u6cd5\u3067\u3001\u3059\u3079\u3066\u306e\u9054\u6210\u72b6\u6cc1\u3068\u30b2\u30fc\u30e0\u306e\u72b6\u614b\u304c\u4fdd\u5b58\u3055\u308c\u307e\u3059\u3002"}, {"question": "\u30b9\u30a4\u30ab\u30b2\u30fc\u30e0\u306e\u96a0\u3057\u30a8\u30ea\u30a2\u3067\u3001\u8ffd\u52a0\u5831\u916c\u3092\u5f97\u308b\u4fa1\u5024\u304c\u3042\u308b\u5834\u6240\u306f\u3069\u3053\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30a4\u30ab\u30b2\u30fc\u30e0\u306b\u306f\u3001\u8ffd\u52a0\u5831\u916c\u3092\u63d0\u4f9b\u3059\u308b\u8907\u6570\u306e\u96a0\u3057\u30a8\u30ea\u30a2\u304c\u3042\u308a\u307e\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u30a8\u30ea\u30a2\u306e1\u3064\u306f\u3001\u300e\u68ee\u306e\u30ec\u30d9\u30eb\u300f\u306b\u3042\u308b\u96a0\u3057\u30b9\u30a4\u30c3\u30c1\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u3067\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u300e\u79d8\u5bc6\u306e\u5ead\u5712\u300f\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30de\u30c3\u30d7\u53f3\u5074\u306e\u5927\u304d\u306a\u6728\u306e\u5f8c\u308d\u306b\u30b9\u30a4\u30c3\u30c1\u304c\u3042\u308a\u307e\u3059\u3002\u30a2\u30af\u30c6\u30a3\u30d6\u5316\u3059\u308b\u3068\u3001\u79d8\u5bc6\u306e\u5ead\u5712\u306b\u901a\u3058\u308b\u9053\u304c\u958b\u304d\u3001\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u5f37\u5316\u3059\u308b\u300e\u30b4\u30fc\u30eb\u30c7\u30f3\u30b9\u30a4\u30ab\u300f\u306a\u3069\u306e\u30ec\u30a2\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30a8\u30ea\u30a2\u3092\u63a2\u691c\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30b9\u30a4\u30ab\u30b2\u30fc\u30e0\u3067\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u52b9\u679c\u7684\u306b\u4f7f\u7528\u3057\u3066\u30a2\u30c9\u30d0\u30f3\u30c6\u30fc\u30b8\u3092\u5f97\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30a4\u30ab\u30b2\u30fc\u30e0\u3067\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u52b9\u679c\u7684\u306b\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u5927\u304d\u306a\u30a2\u30c9\u30d0\u30f3\u30c6\u30fc\u30b8\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u4f7f\u7528\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u6b63\u78ba\u306b\u5224\u65ad\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6642\u9593\u5236\u9650\u306e\u3042\u308b\u30c1\u30e3\u30ec\u30f3\u30b8\u3067\u306f\u300e\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u300f\u3092\u4f7f\u3044\u3001\u3088\u308a\u65e9\u304f\u30af\u30ea\u30a2\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u7d44\u307f\u5408\u308f\u305b\u3066\u6700\u5927\u9650\u306e\u52b9\u679c\u3092\u5f15\u304d\u51fa\u3057\u307e\u3059\u3002\u300e\u529b\u56de\u5fa9\u85ac\u300f\u3068\u300e\u30b7\u30fc\u30eb\u30c9\u300f\u3092\u7d44\u307f\u5408\u308f\u305b\u3066\u3001\u3088\u308a\u5f37\u304f\u3001\u3088\u308a\u30ec\u30b8\u30ea\u30a8\u30f3\u30c8\u306b\u306a\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30ec\u30a2\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u3001\u30dc\u30b9\u6226\u3084\u96e3\u3057\u3044\u30ec\u30d9\u30eb\u306a\u3069\u3001\u91cd\u8981\u306a\u5834\u9762\u306b\u7bc0\u7d04\u3057\u307e\u3059\u3002\u6226\u7565\u7684\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306e\u4f7f\u7528\u306f\u3001\u6226\u6cc1\u3092\u6709\u5229\u306b\u5909\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30b9\u30a4\u30ab\u30b2\u30fc\u30e0\u306e\u30ec\u30d9\u30eb\u4e0a\u3052\u30b7\u30b9\u30c6\u30e0\u306e\u4ed5\u7d44\u307f\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30a4\u30ab\u30b2\u30fc\u30e0\u306e\u30ec\u30d9\u30eb\u4e0a\u3052\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6575\u3092\u5012\u3057\u305f\u308a\u3001\u30af\u30a8\u30b9\u30c8\u3092\u5b8c\u4e86\u3057\u305f\u308a\u3059\u308b\u3053\u3068\u3067\u7372\u5f97\u3055\u308c\u308b\u7d4c\u9a13\u5024\uff08XP\uff09\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u30b0\u30ea\u30fc\u30f3\u30b9\u30e9\u30a4\u30e0\u300f\u3092\u5012\u3059\u306810XP\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002XP\u3092\u8caf\u3081\u308b\u3053\u3068\u3067\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306f\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u3057\u3001\u4f53\u529b\u3084\u653b\u6483\u529b\u306a\u3069\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u304c\u4e0a\u304c\u308a\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u5404\u30ec\u30d9\u30eb\u306b\u5fc5\u8981\u306aXP\u306f\u5f90\u3005\u306b\u5897\u52a0\u3057\u307e\u3059\u3002\u3053\u306e\u4ed5\u7d44\u307f\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u7d99\u7d9a\u7684\u306a\u9032\u6b69\u3068\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u6210\u9577\u3092\u78ba\u4fdd\u3059\u308b\u305f\u3081\u306b\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u8a08\u753b\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30b9\u30a4\u30ab\u30b2\u30fc\u30e0\u306e\u8a2d\u5b9a\u3092\u6700\u9069\u5316\u3057\u3066\u3001\u6700\u9ad8\u306e\u6027\u80fd\u3092\u5f15\u304d\u51fa\u3059\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30a4\u30ab\u30b2\u30fc\u30e0\u306e\u8a2d\u5b9a\u3092\u6700\u9069\u5316\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u307e\u305a\u3001\u30c7\u30d0\u30a4\u30b9\u306e\u80fd\u529b\u306b\u57fa\u3065\u3044\u3066\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30e9\u30b0\u304c\u767a\u751f\u3059\u308b\u5834\u5408\u306f\u89e3\u50cf\u5ea6\u3092\u4e0b\u3052\u307e\u3059\u3002\u6b21\u306b\u3001\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u5408\u308f\u305b\u305f\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u30b9\u30ad\u30fc\u30e0\u3092\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30dc\u30bf\u30f3\u3092\u518d\u5272\u308a\u5f53\u3066\u3057\u3066\u64cd\u4f5c\u3092\u3088\u308a\u7c21\u5358\u306b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u6700\u5f8c\u306b\u3001\u300e\u9ad8\u30d5\u30ec\u30fc\u30e0\u30ec\u30fc\u30c8\u300f\u306a\u3069\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u30e2\u30fc\u30c9\uff08\u30b5\u30dd\u30fc\u30c8\u3055\u308c\u3066\u3044\u308b\u5834\u5408\uff09\u3092\u6709\u52b9\u306b\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u8abf\u6574\u306b\u3088\u308a\u3001\u3088\u308a\u30b9\u30e0\u30fc\u30ba\u3067\u53cd\u5fdc\u6027\u306e\u826f\u3044\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u304c\u4fdd\u8a3c\u3055\u308c\u307e\u3059\u3002"}, {"question": "\u30b9\u30a4\u30ab\u30b2\u30fc\u30e0\u3067\u30ec\u30a2\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u52b9\u7387\u7684\u306b\u96c6\u3081\u308b\u306b\u306f\u3069\u306e\u3088\u3046\u306a\u65b9\u6cd5\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30b9\u30a4\u30ab\u30b2\u30fc\u30e0\u3067\u30ec\u30a2\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u96c6\u3081\u308b\u305f\u3081\u306b\u306f\u3001\u6226\u7565\u7684\u306a\u8a08\u753b\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30c9\u30ed\u30c3\u30d7\u7387\u306e\u9ad8\u3044\u5834\u6240\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u30af\u30ea\u30b9\u30bf\u30eb\u6d1e\u7a9f\u300f\u306f\u300e\u30df\u30b9\u30c6\u30a3\u30c3\u30af\u30b7\u30e3\u30fc\u30c9\u300f\u306e\u30c9\u30ed\u30c3\u30d7\u7387\u304c\u9ad8\u3044\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5e78\u904b\u3092\u9ad8\u3081\u308b\u30a2\u30a4\u30c6\u30e0\uff08\u4f8b\uff1a\u300e\u30e9\u30c3\u30ad\u30fc\u30c1\u30e3\u30fc\u30e0\u300f\uff09\u3092\u88c5\u5099\u3059\u308b\u3053\u3068\u3067\u3001\u30a2\u30a4\u30c6\u30e0\u30c9\u30ed\u30c3\u30d7\u7387\u3092\u4e0a\u3052\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30ec\u30a2\u30a2\u30a4\u30c6\u30e0\u304c\u30c9\u30ed\u30c3\u30d7\u3057\u3084\u3059\u3044\u7279\u5b9a\u306e\u30af\u30a8\u30b9\u30c8\u3084\u30ec\u30d9\u30eb\u3092\u7e70\u308a\u8fd4\u3057\u30d7\u30ec\u30a4\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u65b9\u6cd5\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3001\u8cb4\u91cd\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u306b\u8ffd\u52a0\u3059\u308b\u53ef\u80fd\u6027\u3092\u6700\u5927\u5316\u3057\u307e\u3059\u3002"}, {"question": "\u30b9\u30a4\u30ab\u30b2\u30fc\u30e0\u306e\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u3001\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u3069\u306e\u3088\u3046\u306b\u5f37\u5316\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30b9\u30a4\u30ab\u30b2\u30fc\u30e0\u306e\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u3001\u30e6\u30cb\u30fc\u30af\u3067\u5f37\u5316\u3055\u308c\u305f\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u5354\u529b\u3057\u3066\u6311\u6226\u7684\u306a\u30af\u30a8\u30b9\u30c8\u306b\u53d6\u308a\u7d44\u3093\u3060\u308a\u3001PvP\u6226\u95d8\u3067\u7af6\u3044\u5408\u3063\u305f\u308a\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5354\u529b\u30e2\u30fc\u30c9\u3067\u306f\u3001\u5404\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u9577\u6240\u3092\u751f\u304b\u3057\u3001\u5f37\u529b\u306a\u30dc\u30b9\u3092\u5012\u3059\u305f\u3081\u306b\u53cb\u9054\u3068\u6226\u7565\u3092\u7df4\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u3001\u30b2\u30fc\u30e0\u306b\u5965\u884c\u304d\u3092\u52a0\u3048\u308b\u3001\u9650\u5b9a\u7684\u306a\u5831\u916c\u3084\u9054\u6210\u611f\u3092\u5c0e\u5165\u3057\u307e\u3059\u3002\u3053\u306e\u30e2\u30fc\u30c9\u306f\u3001\u5354\u529b\u3068\u7af6\u4e89\u3092\u4fc3\u9032\u3057\u3001\u30b2\u30fc\u30e0\u3092\u3088\u308a\u9b45\u529b\u7684\u3067\u30c0\u30a4\u30ca\u30df\u30c3\u30af\u306b\u3057\u307e\u3059\u3002"}]
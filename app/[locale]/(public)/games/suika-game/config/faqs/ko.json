[{"question": "\uc288\uc774\uce74 \uac8c\uc784 \ucd08\ubcf4\uc790\ub85c\uc11c \uae30\ubcf8 \uc6c0\uc9c1\uc784\uc740 \uc5b4\ub5bb\uac8c \uc218\ud589\ud569\ub2c8\uae4c?", "answer": "\uc288\uc774\uce74 \uac8c\uc784\uc5d0\uc11c \uae30\ubcf8 \uc6c0\uc9c1\uc784\uc740 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uba3c\uc800 \ubc29\ud5a5\ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uce90\ub9ad\ud130\ub97c \uc774\ub3d9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc704\ucabd \ubc29\ud5a5\ud0a4\ub97c \ub204\ub974\uba74 \uc810\ud504\ud558\uace0, \uc88c\uc6b0 \ubc29\ud5a5\ud0a4\ub97c \ub204\ub974\uba74 \uc218\ud3c9\uc73c\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4. \ub458\uc9f8, \ubb3c\uac74\uacfc \uc0c1\ud638 \uc791\uc6a9\ud558\ub824\uba74 'A' \ubc84\ud2bc\uc744 \ub204\ub985\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc544\uc774\ud15c\uc744 \uc9d1\ub294 \uac83\uc785\ub2c8\ub2e4. \ub9c8\uc9c0\ub9c9\uc73c\ub85c, \uc801\uc744 \uacf5\uaca9\ud558\ub294 \ub4f1 \ud2b9\uc218 \ub3d9\uc791\uc744 \uc218\ud589\ud558\ub824\uba74 'B' \ubc84\ud2bc\uc744 \ub204\ub985\ub2c8\ub2e4. \uc219\ub828\ub3c4\ub97c \ub192\uc774\uae30 \uc704\ud574 \ud29c\ud1a0\ub9ac\uc5bc \ub808\ubca8\uc5d0\uc11c \uc774\ub7ec\ud55c \uc6c0\uc9c1\uc784\uc744 \uc5f0\uc2b5\ud558\uc2ed\uc2dc\uc624."}, {"question": "100\uc2dc\uac04 \ud50c\ub808\uc774 \ud6c4 \uc288\uc774\uce74 \uac8c\uc784\uc5d0\uc11c \ub354 \uc624\ub798 \uc0dd\uc874\ud558\uae30 \uc704\ud55c \uc8fc\uc694 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc288\uc774\uce74 \uac8c\uc784\uc5d0\uc11c 100\uc2dc\uac04\uc774 \uc9c0\ub098\uba74 \uc0dd\uc874 \uc804\ub7b5\uc774 \uc911\uc694\ud574\uc9d1\ub2c8\ub2e4. \ub2e8\uacc4 1: \uccb4\ub825 \ud3ec\uc158\uacfc \uac19\uc740 \uc544\uc774\ud15c\uc744 \uc218\uc9d1\ud558\uace0 \ubcf4\uc874\ud558\uc5ec \uc790\uc6d0 \uad00\ub9ac\ub97c \uc219\ub2ec\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubcf4\uc2a4\uc804\uc744 \uc704\ud574 \ud3ec\uc158\uc744 \uc544\uaef4\ub461\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc801 \ud328\ud134\uc744 \ud559\uc2b5\ud569\ub2c8\ub2e4. \uac01 \uc801\uc740 \uace0\uc720\ud55c \uacf5\uaca9 \uc21c\uc11c\ub97c \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc801\uc808\ud55c \ud0c0\uc774\ubc0d\uc5d0 \ud68c\ud53c\ud558\uba74 \uccb4\ub825\uc744 \uc544\ub084 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc7a5\ube44\ub97c \uc815\uae30\uc801\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud569\ub2c8\ub2e4. \ub354 \ub098\uc740 \uc7a5\ube44\ub294 \uc0dd\uc874 \uac00\ub2a5\uc131\uc744 \ud06c\uac8c \ub192\uc785\ub2c8\ub2e4. \ucd5c\uc801\uc758 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc704\ud574 \uacf5\uaca9\ub825\uacfc \ubc29\uc5b4\ub825\uc758 \uade0\ud615\uc744 \ud56d\uc0c1 \ub9de\ucd94\uc2ed\uc2dc\uc624."}, {"question": "\uc288\uc774\uce74 \uac8c\uc784\uc758 \ud53c\ud574 \uacc4\uc0b0 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc288\uc774\uce74 \uac8c\uc784\uc758 \ud53c\ud574 \uacc4\uc0b0 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ucd5c\uc801\ud654\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \ud53c\ud574\ub294 \uce90\ub9ad\ud130\uc758 \uacf5\uaca9\ub825, \uc801\uc758 \ubc29\uc5b4\ub825, \ubc84\ud504/\ub514\ubc84\ud504\uc5d0 \ub530\ub77c \uacc4\uc0b0\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uacf5\uaca9\ub825\uc774 50\uc774\uace0 \uc801\uc758 \ubc29\uc5b4\ub825\uc774 20\uc774\uba74 \ud53c\ud574\ub294 30\uc785\ub2c8\ub2e4. \ub610\ud55c, \ud2b9\uc815 \uc544\uc774\ud15c\uc740 \uacf5\uaca9\ub825\uc744 \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ud30c\uc6cc \uae00\ub7ec\ube0c\"\ub294 +10\uc744 \ucd94\uac00\ud569\ub2c8\ub2e4. \uc774\ub97c \uc774\ud574\ud558\uba74 \uc804\ud22c \uc804\ub7b5\uc744 \uc138\uc6b0\uace0 \uc801\uc808\ud55c \uc7a5\ube44\ub97c \uc120\ud0dd\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\uc288\uc774\uce74 \uac8c\uc784\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uc804\uc1a1\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc288\uc774\uce74 \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \uc804\uc1a1\ud558\ub294 \uac83\uc740 \uac04\ub2e8\ud569\ub2c8\ub2e4. \uba3c\uc800 \uac8c\uc784 \uc124\uc815\uc5d0\uc11c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ud65c\uc131\ud654\ud588\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc6d0\ub798 \ud50c\ub7ab\ud3fc\uc5d0\uc11c '\uc124\uc815'\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec '\ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5'\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. \ub458\uc9f8, \uc0c8 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. \ub9c8\uc9c0\ub9c9\uc73c\ub85c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc5b4\ub098\uac11\ub2c8\ub2e4. \uc774 \ubc29\ubc95\uc744 \ud1b5\ud574 \ubaa8\ub4e0 \uc5c5\uc801 \ubc0f \uac8c\uc784 \uc0c1\ud0dc\uac00 \ubcf4\uc874\ub429\ub2c8\ub2e4."}, {"question": "\uc288\uc774\uce74 \uac8c\uc784\uc758 \uc228\uaca8\uc9c4 \uc9c0\uc5ed \uc911 \ucd94\uac00 \ubcf4\uc0c1\uc744 \uc5bb\uc744 \ub9cc\ud55c \uc9c0\uc5ed\uc740 \uc5b4\ub514\uc785\ub2c8\uae4c?", "answer": "\uc288\uc774\uce74 \uac8c\uc784\uc5d0\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uc9c0\uc5ed\uc774 \uc788\uc73c\uba70 \ucd94\uac00 \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc8fc\ubaa9\ud560 \ub9cc\ud55c \uc9c0\uc5ed \uc911 \ud558\ub098\ub294 '\ube44\ubc00 \uc815\uc6d0'\uc785\ub2c8\ub2e4. '\uc232 \ub808\ubca8'\uc5d0\uc11c \uc228\uaca8\uc9c4 \uc2a4\uc704\uce58\ub97c \ucc3e\uc73c\uba74 \uc811\uadfc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc2a4\uc704\uce58\ub294 \uc9c0\ub3c4 \uc624\ub978\ucabd\uc5d0 \uc788\ub294 \ud070 \ub098\ubb34 \ub4a4\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \ud65c\uc131\ud654\ud558\uba74 '\ube44\ubc00 \uc815\uc6d0'\uc73c\ub85c \uac00\ub294 \uae38\uc774 \uc5f4\ub9ac\uace0 '\uace8\ub4e0 \uc288\uc774\uce74'\uc640 \uac19\uc740 \ud76c\uadc0 \uc544\uc774\ud15c\uc744 \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc9c0\uc5ed\uc744 \ud0d0\ud5d8\ud558\uba74 \uac8c\uc784 \uacbd\ud5d8\uc744 \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc288\uc774\uce74 \uac8c\uc784\uc5d0\uc11c \uac15\uc810\uc744 \uc5bb\uae30 \uc704\ud574 \ud30c\uc6cc\uc5c5\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc288\uc774\uce74 \uac8c\uc784\uc5d0\uc11c \ud30c\uc6cc\uc5c5\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uba74 \uc0c1\ub2f9\ud55c \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud560 \uc801\uc808\ud55c \uc2dc\uc810\uc744 \ud30c\uc545\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc18d\ub3c4 \ubd80\uc2a4\ud130'\ub97c \uc2dc\uac04 \uc81c\ud55c \ucc4c\ub9b0\uc9c0 \uc911\uc5d0 \uc0ac\uc6a9\ud558\uc5ec \ub354 \ube60\ub974\uac8c \uc644\ub8cc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 2: \ucd5c\ub300 \ud6a8\uacfc\ub97c \uc704\ud574 \ud30c\uc6cc\uc5c5\uc744 \uacb0\ud569\ud569\ub2c8\ub2e4. '\uac15\ud654 \ud3ec\uc158'\uacfc '\uc274\ub4dc'\ub97c \uc0ac\uc6a9\ud558\uba74 \ub354 \uac15\ud558\uace0 \ub354 \uac15\uc778\ud574\uc9d1\ub2c8\ub2e4. \ub2e8\uacc4 3: \ud76c\uadc0 \ud30c\uc6cc\uc5c5\uc740 \ubcf4\uc2a4\uc804\uc774\ub098 \uc5b4\ub824\uc6b4 \ub808\ubca8\uacfc \uac19\uc740 \uc911\uc694\ud55c \uc21c\uac04\uc744 \uc704\ud574 \uc800\uc7a5\ud569\ub2c8\ub2e4. \ud30c\uc6cc\uc5c5\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uba74 \uac8c\uc784\uc758 \ud750\ub984\uc744 \ubc14\uafc0 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc288\uc774\uce74 \uac8c\uc784\uc758 \ub808\ubca8 \uc2dc\uc2a4\ud15c \ub4a4\uc5d0 \uc228\uaca8\uc9c4 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc288\uc774\uce74 \uac8c\uc784\uc758 \ub808\ubca8 \uc2dc\uc2a4\ud15c\uc740 \uc801\uc744 \ubb3c\ub9ac\uce58\uace0 \ud018\uc2a4\ud2b8\ub97c \uc644\ub8cc\ud558\uc5ec \uc5bb\ub294 \uacbd\ud5d8\uce58(XP)\ub97c \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub179\uc0c9 \uc2ac\ub77c\uc784'\uc744 \ubb3c\ub9ac\uce58\uba74 10 XP\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. XP\ub97c \ucd95\uc801\ud558\uba74 \uce90\ub9ad\ud130\uac00 \ub808\ubca8\uc5c5\ud558\uc5ec \uccb4\ub825\uacfc \uacf5\uaca9\ub825\uacfc \uac19\uc740 \ub2a5\ub825\uce58\uac00 \ud5a5\uc0c1\ub429\ub2c8\ub2e4. \ub610\ud55c, \uac01 \ub808\ubca8\uc5d0\ub294 \uc810\ucc28\uc801\uc73c\ub85c \ub354 \ub9ce\uc740 XP\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \uc774 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\uba74 \uc9c0\uc18d\uc801\uc778 \uc9c4\ud589\uacfc \uce90\ub9ad\ud130 \uac1c\ubc1c\uc744 \uc704\ud55c \uac8c\uc784 \ud50c\ub808\uc774 \uacc4\ud68d\uc5d0 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\ucd5c\uc0c1\uc758 \uc131\ub2a5\uc744 \uc704\ud574 \uc288\uc774\uce74 \uac8c\uc784 \uc124\uc815\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc288\uc774\uce74 \uac8c\uc784 \uc124\uc815\uc744 \ucd5c\uc801\ud654\ud558\uba74 \uac8c\uc784 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uccab\uc9f8, \uc7a5\uce58\uc758 \uc131\ub2a5\uc5d0 \ub530\ub77c \uadf8\ub798\ud53d \uc124\uc815\uc744 \uc870\uc815\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc9c0\uc5f0 \ud604\uc0c1\uc774 \ubc1c\uc0dd\ud558\uba74 \ud574\uc0c1\ub3c4\ub97c \ub0ae\ucd94\uc2ed\uc2dc\uc624. \ub458\uc9f8, \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uacfc \ub9de\ub294 \uc81c\uc5b4 \ubc29\uc2dd\uc744 \uc0ac\uc6a9\uc790 \uc9c0\uc815\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ubc84\ud2bc\uc744 \ub2e4\uc2dc \ub9e4\ud551\ud558\uc5ec \uc561\uc138\uc2a4\ub97c \ub354 \uc27d\uac8c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub9c8\uc9c0\ub9c9\uc73c\ub85c, \uc9c0\uc6d0\ub418\ub294 \uacbd\uc6b0 '\uace0 \ud504\ub808\uc784 \uc18d\ub3c4'\uc640 \uac19\uc740 \uc131\ub2a5 \ubaa8\ub4dc\ub97c \ud65c\uc131\ud654\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc870\uc815\uc740 \ub354 \uc6d0\ud65c\ud558\uace0 \ubc18\uc751\uc131\uc774 \uc88b\uc740 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "\uc288\uc774\uce74 \uac8c\uc784\uc5d0\uc11c \ud76c\uadc0 \uc544\uc774\ud15c\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \ud68d\ub4dd\ud558\ub294 \ucd5c\uc0c1\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc288\uc774\uce74 \uac8c\uc784\uc5d0\uc11c \ud76c\uadc0 \uc544\uc774\ud15c\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \ud68d\ub4dd\ud558\ub824\uba74 \uc804\ub7b5\uc801\uc778 \uacc4\ud68d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \ub4dc\ub86d\ub960\uc774 \ub192\uc740 \uc9c0\uc5ed\uc744 \ud30c\uc545\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud06c\ub9ac\uc2a4\ud0c8 \ub3d9\uad74'\uc740 '\uc2e0\ube44\ud55c \uc870\uac01'\uc774 \ub354 \uc798 \ub728\ub294 \uacf3\uc785\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc6b4\uc744 \ub192\uc774\ub294 \uc544\uc774\ud15c(\uc608: '\ud589\uc6b4\uc758 \ubd80\uc801')\uc744 \uc7a5\ucc29\ud558\uc5ec \uc544\uc774\ud15c \ub4dc\ub86d\ub960\uc744 \ub192\uc785\ub2c8\ub2e4. \ub2e8\uacc4 3: \ud76c\uadc0 \uc544\uc774\ud15c\uc774 \ub728\uae30 \uc798 \uc54c\ub824\uc9c4 \ud2b9\uc815 \ud018\uc2a4\ud2b8\ub098 \ub808\ubca8\uc744 \ubc18\ubcf5\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ubc29\ubc95\uc744 \uacb0\ud569\ud558\uba74 \uc778\ubca4\ud1a0\ub9ac\uc5d0 \uadc0\uc911\ud55c \uc544\uc774\ud15c\uc744 \uc5bb\uc744 \uac00\ub2a5\uc131\uc744 \uadf9\ub300\ud654\ud569\ub2c8\ub2e4."}, {"question": "\uc288\uc774\uce74 \uac8c\uc784\uc758 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \uac8c\uc784 \uacbd\ud5d8\uc744 \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0a4\ub098\uc694?", "answer": "\uc288\uc774\uce74 \uac8c\uc784\uc758 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \ub3c5\ud2b9\ud558\uace0 \ud5a5\uc0c1\ub41c \uac8c\uc784 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\ub294 \ud300\uc744 \uc774\ub8e8\uc5b4 \ub3c4\uc804\uc801\uc778 \ud018\uc2a4\ud2b8\uc5d0 \ucc38\uc5ec\ud558\uac70\ub098 PvP \uc804\ud22c\uc5d0 \ucc38\uc5ec\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud611\ub825 \ubaa8\ub4dc\uc5d0\uc11c \uac01 \ud50c\ub808\uc774\uc5b4\uc758 \uac15\uc810\uc744 \ud65c\uc6a9\ud558\uc5ec \uce5c\uad6c\uc640 \uc804\ub7b5\uc744 \uc138\uc6cc \uac15\ub825\ud55c \ubcf4\uc2a4\ub97c \ubb3c\ub9ac\uce60 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \ub3c5\uc810\uc801\uc778 \ubcf4\uc0c1 \ubc0f \uc5c5\uc801\uc744 \uc81c\uacf5\ud558\uc5ec \uac8c\uc784\uc5d0 \uae4a\uc774\ub97c \ub354\ud569\ub2c8\ub2e4. \uc774 \ubaa8\ub4dc\ub294 \ud611\ub825\uacfc \uacbd\uc7c1\uc744 \uc870\uc131\ud558\uc5ec \uac8c\uc784\uc744 \ub354\uc6b1 \ub9e4\ub825\uc801\uc774\uace0 \uc5ed\ub3d9\uc801\uc73c\ub85c \ub9cc\ub4ed\ub2c8\ub2e4."}]
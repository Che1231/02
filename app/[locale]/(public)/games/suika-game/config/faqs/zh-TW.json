[{"question": "\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u5728\u300aSuika \u904a\u6232\u300b\u4e2d\u9032\u884c\u57fa\u790e\u52d5\u4f5c\uff1f", "answer": "\u5728\u300aSuika \u904a\u6232\u300b\u4e2d\uff0c\u57fa\u790e\u52d5\u4f5c\u5c0d\u65bc\u65b0\u73a9\u5bb6\u81f3\u95dc\u91cd\u8981\u3002\u9996\u5148\uff0c\u4f7f\u7528\u65b9\u5411\u9375\u79fb\u52d5\u89d2\u8272\u3002\u4f8b\u5982\uff0c\u6309\u4e0b\"\u4e0a\"\u9375\u8df3\u8e8d\uff0c\u6309\u4e0b\"\u5de6/\u53f3\"\u9375\u6c34\u5e73\u79fb\u52d5\u3002\u5176\u6b21\uff0c\u6309\u4e0b\"A\"\u9375\u8207\u7269\u4ef6\u4e92\u52d5\uff0c\u4f8b\u5982\u64bf\u53d6\u7269\u54c1\u3002\u6700\u5f8c\uff0c\u6309\u4e0b\"B\"\u9375\u57f7\u884c\u7279\u6b8a\u52d5\u4f5c\uff0c\u4f8b\u5982\u653b\u64ca\u6575\u4eba\u3002\u8acb\u8a18\u4f4f\uff0c\u5728\u6559\u5b78\u95dc\u5361\u7df4\u7fd2\u9019\u4e9b\u52d5\u4f5c\uff0c\u624d\u80fd\u66f4\u5f97\u5fc3\u61c9\u624b\u3002"}, {"question": "\u5728\u300aSuika \u904a\u6232\u300b\u73a9\u8d85\u904e 100 \u5c0f\u6642\u5f8c\uff0c\u5982\u4f55\u7dad\u6301\u66f4\u4e45\u7684\u751f\u5b58\uff1f", "answer": "\u5728\u300aSuika \u904a\u6232\u300b\u73a9\u8d85\u904e 100 \u5c0f\u6642\u5f8c\uff0c\u751f\u5b58\u7b56\u7565\u8b8a\u5f97\u81f3\u95dc\u91cd\u8981\u3002\u6b65\u9a5f\u4e00\uff1a\u719f\u7df4\u7ba1\u7406\u8cc7\u6e90\uff0c\u6536\u96c6\u4e26\u4fdd\u5b58\u7269\u54c1\uff0c\u4f8b\u5982\u751f\u547d\u85e5\u6c34\u3002\u4f8b\u5982\uff0c\u5c07\u85e5\u6c34\u5132\u5099\u7528\u65bc\u6253boss\u6230\u3002\u6b65\u9a5f\u4e8c\uff1a\u5b78\u7fd2\u6575\u4eba\u7684\u653b\u64ca\u6a21\u5f0f\u3002\u6bcf\u500b\u6575\u4eba\u90fd\u5177\u6709\u7368\u7279\u7684\u653b\u64ca\u5e8f\u5217\uff1b\u5728\u6b63\u78ba\u7684\u6642\u9593\u9583\u907f\u53ef\u4ee5\u4fdd\u5b58\u751f\u547d\u3002\u6b65\u9a5f\u4e09\uff1a\u5b9a\u671f\u5347\u7d1a\u4f60\u7684\u88dd\u5099\u3002\u66f4\u597d\u7684\u88dd\u5099\u986f\u8457\u589e\u52a0\u4f60\u7684\u751f\u5b58\u6a5f\u6703\u3002\u59cb\u7d42\u5e73\u8861\u653b\u64ca\u548c\u9632\u79a6\uff0c\u4ee5\u7372\u5f97\u6700\u4f73\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u7406\u89e3\u300aSuika \u904a\u6232\u300b\u7684\u50b7\u5bb3\u8a08\u7b97\u7cfb\u7d71\u5f88\u91cd\u8981\uff1f", "answer": "\u77ad\u89e3\u300aSuika \u904a\u6232\u300b\u7684\u50b7\u5bb3\u8a08\u7b97\u7cfb\u7d71\u5c0d\u65bc\u512a\u5316\u904a\u6232\u9ad4\u9a57\u81f3\u95dc\u91cd\u8981\u3002\u50b7\u5bb3\u7684\u8a08\u7b97\u57fa\u65bc\u89d2\u8272\u7684\u653b\u64ca\u529b\u3001\u6575\u4eba\u7684\u9632\u79a6\u529b\u4ee5\u53ca\u4efb\u4f55\u589e\u76ca/\u6e1b\u76ca\u6548\u679c\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u7684\u653b\u64ca\u529b\u70ba 50\uff0c\u6575\u4eba\u7684\u9632\u79a6\u529b\u70ba 20\uff0c\u5247\u9020\u6210\u7684\u50b7\u5bb3\u70ba 30\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u7269\u54c1\u53ef\u4ee5\u63d0\u5347\u4f60\u7684\u653b\u64ca\u529b\uff0c\u4f8b\u5982\u300c\u529b\u91cf\u624b\u5957\u300d\uff0c\u53ef\u589e\u52a0 +10 \u7684\u653b\u64ca\u529b\u3002\u77e5\u9053\u9019\u4e00\u9ede\u6709\u52a9\u65bc\u5236\u5b9a\u6230\u9b25\u7b56\u7565\u4e26\u9078\u64c7\u5408\u9069\u7684\u88dd\u5099\u3002"}, {"question": "\u5982\u4f55\u5c07\u300aSuika \u904a\u6232\u300b\u7684\u904a\u6232\u9032\u5ea6\u5f9e\u4e00\u500b\u5e73\u53f0\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u5e73\u53f0\uff1f", "answer": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u9593\u8f49\u79fb\u300aSuika \u904a\u6232\u300b\u7684\u904a\u6232\u9032\u5ea6\u975e\u5e38\u7c21\u55ae\u3002\u9996\u5148\uff0c\u78ba\u4fdd\u5728\u904a\u6232\u8a2d\u5b9a\u4e2d\u555f\u7528\u4e86\u96f2\u7aef\u5132\u5b58\u3002\u4f8b\u5982\uff0c\u5728\u539f\u59cb\u5e73\u53f0\u4e0a\uff0c\u524d\u5f80\u300c\u8a2d\u5b9a\u300d\u4e26\u9078\u64c7\u300c\u96f2\u7aef\u5132\u5b58\u300d\u3002\u5176\u6b21\uff0c\u767b\u5165\u65b0\u5e73\u53f0\u4e0a\u7684\u76f8\u540c\u5e33\u6236\u3002\u6700\u5f8c\uff0c\u4e0b\u8f09\u96f2\u7aef\u5132\u5b58\u4ee5\u7e7c\u7e8c\u904a\u6232\u9032\u5ea6\u3002\u6b64\u65b9\u6cd5\u53ef\u78ba\u4fdd\u4fdd\u7559\u6240\u6709\u4f60\u7684\u6210\u5c31\u548c\u904a\u6232\u72c0\u614b\u3002"}, {"question": "\u300aSuika \u904a\u6232\u300b\u4e2d\u54ea\u4e9b\u96b1\u85cf\u5340\u57df\u503c\u5f97\u63a2\u7d22\u4ee5\u7372\u5f97\u984d\u5916\u734e\u52f5\uff1f", "answer": "\u300aSuika \u904a\u6232\u300b\u4e2d\u6709\u5e7e\u500b\u96b1\u85cf\u5340\u57df\u63d0\u4f9b\u984d\u5916\u734e\u52f5\u3002\u503c\u5f97\u6ce8\u610f\u7684\u5340\u57df\u662f\u300c\u79d8\u5bc6\u82b1\u5712\u300d\uff0c\u53ef\u900f\u904e\u5728\u300c\u68ee\u6797\u95dc\u5361\u300d\u627e\u5230\u96b1\u85cf\u958b\u95dc\u4f86\u9032\u5165\u3002\u300c\u79d8\u5bc6\u82b1\u5712\u300d\u7684\u958b\u95dc\u85cf\u5728\u5730\u5716\u53f3\u5074\u7684\u4e00\u68f5\u5927\u6a39\u5f8c\u9762\u3002\u4e00\u65e6\u555f\u7528\uff0c\u4e00\u689d\u901a\u5f80\u79d8\u5bc6\u82b1\u5712\u7684\u8def\u5f91\u5c07\u958b\u555f\uff0c\u60a8\u53ef\u4ee5\u5728\u5176\u4e2d\u627e\u5230\u7a00\u6709\u7269\u54c1\uff0c\u4f8b\u5982\u300c\u9ec3\u91d1 Suika\u300d\uff0c\u5b83\u53ef\u4ee5\u63d0\u5347\u4f60\u7684\u5c6c\u6027\u3002\u63a2\u7d22\u9019\u4e9b\u5340\u57df\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u4f60\u7684\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u5982\u4f55\u6709\u6548\u5730\u4f7f\u7528\u300aSuika \u904a\u6232\u300b\u4e2d\u7684\u589e\u5f37\u6548\u679c\u4f86\u7372\u53d6\u512a\u52e2\uff1f", "answer": "\u6709\u6548\u5730\u4f7f\u7528\u300aSuika \u904a\u6232\u300b\u4e2d\u7684\u589e\u5f37\u6548\u679c\u53ef\u4ee5\u8b93\u4f60\u7372\u5f97\u986f\u8457\u512a\u52e2\u3002\u6b65\u9a5f\u4e00\uff1a\u78ba\u5b9a\u4f7f\u7528\u589e\u5f37\u6548\u679c\u7684\u6700\u4f73\u6642\u6a5f\u3002\u4f8b\u5982\uff0c\u5728\u9650\u6642\u6311\u6230\u4e2d\u4f7f\u7528\u300c\u52a0\u901f\u300d\u4f86\u66f4\u5feb\u5730\u5b8c\u6210\u6311\u6230\u3002\u6b65\u9a5f\u4e8c\uff1a\u7d44\u5408\u589e\u5f37\u6548\u679c\u4ee5\u9054\u5230\u6700\u5927\u6548\u679c\u3002\u4f7f\u7528\u300c\u529b\u91cf\u85e5\u6c34\u300d\u8207\u300c\u8b77\u76fe\u300d\u53ef\u4ee5\u8b93\u4f60\u540c\u6642\u8b8a\u5f97\u66f4\u5f37\u5927\u548c\u66f4\u5805\u97cc\u3002\u6b65\u9a5f\u4e09\uff1a\u5c07\u7a00\u6709\u589e\u5f37\u6548\u679c\u5132\u5b58\u8d77\u4f86\uff0c\u7528\u65bc\u95dc\u9375\u6642\u523b\uff0c\u4f8b\u5982\u6253 boss \u6230\u6216\u56f0\u96e3\u95dc\u5361\u3002\u7b56\u7565\u6027\u5730\u4f7f\u7528\u589e\u5f37\u6548\u679c\u53ef\u4ee5\u626d\u8f49\u5c40\u52e2\u3002"}, {"question": "\u300aSuika \u904a\u6232\u300b\u7684\u7b49\u7d1a\u7cfb\u7d71\u80cc\u5f8c\u7684\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "\u300aSuika \u904a\u6232\u300b\u7684\u7b49\u7d1a\u7cfb\u7d71\u57fa\u65bc\u5f9e\u64ca\u6557\u6575\u4eba\u548c\u5b8c\u6210\u4efb\u52d9\u7372\u5f97\u7684\u7d93\u9a57\u503c\uff08XP\uff09\u3002\u4f8b\u5982\uff0c\u300c\u7da0\u8272\u53f2\u840a\u59c6\u300d\u7d66\u4f60 10 \u9ede XP\u3002\u7d2f\u7a4d XP \u8b93\u4f60\u7684\u89d2\u8272\u5347\u7d1a\uff0c\u63d0\u5347\u4f8b\u5982\u751f\u547d\u503c\u548c\u653b\u64ca\u529b\u7b49\u5c6c\u6027\u3002\u6b64\u5916\uff0c\u6bcf\u500b\u7b49\u7d1a\u90fd\u9700\u8981\u8d8a\u4f86\u8d8a\u591a\u7684 XP\u3002\u7406\u89e3\u9019\u500b\u6a5f\u5236\u6709\u52a9\u65bc\u8a08\u5283\u4f60\u7684\u904a\u6232\u65b9\u5f0f\uff0c\u4ee5\u78ba\u4fdd\u6301\u7e8c\u7684\u9032\u5c55\u548c\u89d2\u8272\u7684\u767c\u5c55\u3002"}, {"question": "\u5982\u4f55\u512a\u5316\u6211\u7684\u300aSuika \u904a\u6232\u300b\u8a2d\u5b9a\u4ee5\u7372\u5f97\u6700\u4f73\u6548\u80fd\uff1f", "answer": "\u512a\u5316\u300aSuika \u904a\u6232\u300b\u8a2d\u5b9a\u53ef\u4ee5\u63d0\u5347\u4f60\u7684\u904a\u6232\u9ad4\u9a57\u3002\u9996\u5148\uff0c\u6839\u64da\u4f60\u7684\u8a2d\u5099\u80fd\u529b\u8abf\u6574\u5716\u5f62\u8a2d\u5b9a\u3002\u4f8b\u5982\uff0c\u5982\u6709\u5ef6\u9072\u554f\u984c\uff0c\u8acb\u964d\u4f4e\u89e3\u6790\u5ea6\u3002\u5176\u6b21\uff0c\u6839\u64da\u4f60\u7684\u904a\u6232\u98a8\u683c\u81ea\u8a02\u63a7\u5236\u65b9\u6848\uff0c\u4f8b\u5982\u91cd\u65b0\u6620\u5c04\u6309\u9215\u4ee5\u65b9\u4fbf\u5b58\u53d6\u3002\u6700\u5f8c\uff0c\u5982\u679c\u652f\u63f4\uff0c\u8acb\u555f\u7528\u300c\u9ad8\u5e40\u7387\u300d\u7b49\u6548\u80fd\u6a21\u5f0f\u3002\u9019\u4e9b\u8abf\u6574\u5c07\u78ba\u4fdd\u66f4\u9806\u66a2\u7684\u904a\u6232\u9ad4\u9a57\u548c\u66f4\u597d\u7684\u53cd\u61c9\u529b\u3002"}, {"question": "\u5728\u300aSuika \u904a\u6232\u300b\u4e2d\u5982\u4f55\u6709\u6548\u6253\u6488\u7a00\u6709\u7269\u54c1\uff1f", "answer": "\u5728\u300aSuika \u904a\u6232\u300b\u4e2d\u6253\u6488\u7a00\u6709\u7269\u54c1\u9700\u8981\u6230\u7565\u898f\u5283\u3002\u6b65\u9a5f\u4e00\uff1a\u627e\u51fa\u6389\u843d\u7387\u9ad8\u7684\u5730\u9ede\u3002\u4f8b\u5982\uff0c\u300c\u6c34\u6676\u6d1e\u7a74\u300d\u6389\u843d\u300c\u795e\u79d8\u788e\u7247\u300d\u7684\u6a5f\u7387\u66f4\u9ad8\u3002\u6b65\u9a5f\u4e8c\uff1a\u88dd\u5099\u80fd\u589e\u52a0\u5e78\u904b\u7684\u7269\u54c1\uff0c\u4f8b\u5982\u300c\u5e78\u904b\u7b26\u300d\uff0c\u53ef\u4ee5\u63d0\u5347\u7269\u54c1\u6389\u843d\u7387\u3002\u6b65\u9a5f\u4e09\uff1a\u91cd\u8907\u7279\u5b9a\u4ee5\u5176\u6389\u843d\u7a00\u6709\u7269\u54c1\u800c\u805e\u540d\u7684\u4efb\u52d9\u6216\u95dc\u5361\u3002\u7d50\u5408\u9019\u4e9b\u65b9\u6cd5\u53ef\u4ee5\u6700\u5927\u5316\u4f60\u7372\u5f97\u73cd\u8cb4\u7269\u54c1\u7684\u6a5f\u6703\u3002"}, {"question": "\u300aSuika \u904a\u6232\u300b\u7684\u591a\u4eba\u6a21\u5f0f\u5982\u4f55\u63d0\u5347\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u300aSuika \u904a\u6232\u300b\u7684\u591a\u4eba\u6a21\u5f0f\u63d0\u4f9b\u7368\u7279\u4e14\u589e\u5f37\u7684\u904a\u6232\u9ad4\u9a57\u3002\u73a9\u5bb6\u53ef\u4ee5\u7d44\u968a\u4e00\u8d77\u61c9\u5c0d\u5177\u6709\u6311\u6230\u6027\u7684\u4efb\u52d9\u6216\u5728 PvP \u6230\u9b25\u4e2d\u6bd4\u8cfd\u3002\u4f8b\u5982\uff0c\u5728\u5408\u4f5c\u6a21\u5f0f\u4e2d\uff0c\u60a8\u53ef\u4ee5\u8207\u670b\u53cb\u7b56\u7565\u6027\u5730\u64ca\u6557\u5f37\u5927\u7684 boss\uff0c\u5229\u7528\u6bcf\u500b\u73a9\u5bb6\u7684\u512a\u52e2\u3002\u6b64\u5916\uff0c\u591a\u4eba\u6a21\u5f0f\u9084\u5f15\u5165\u4e86\u7368\u7279\u7684\u734e\u52f5\u548c\u6210\u5c31\uff0c\u589e\u52a0\u4e86\u904a\u6232\u7684\u6df1\u5ea6\u3002\u9019\u500b\u6a21\u5f0f\u4fc3\u9032\u4e86\u5408\u4f5c\u548c\u7af6\u722d\uff0c\u4f7f\u904a\u6232\u8b8a\u5f97\u66f4\u6709\u5438\u5f15\u529b\u4e14\u66f4\u5177\u6d3b\u529b\u3002"}]
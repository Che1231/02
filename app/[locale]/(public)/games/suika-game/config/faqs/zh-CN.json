[{"question": "\u65b0\u624b\u5728\u300a\u82cf\u4f0a\u5361\u6e38\u620f\u300b\u4e2d\u5982\u4f55\u8fdb\u884c\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u5728\u300a\u82cf\u4f0a\u5361\u6e38\u620f\u300b\u4e2d\uff0c\u57fa\u672c\u64cd\u4f5c\u5bf9\u4e8e\u65b0\u73a9\u5bb6\u81f3\u5173\u91cd\u8981\u3002\u9996\u5148\uff0c\u4f7f\u7528\u65b9\u5411\u952e\u79fb\u52a8\u89d2\u8272\u3002\u4f8b\u5982\uff0c\u6309\"\u4e0a\"\u952e\u8df3\u8dc3\uff0c\u6309\"\u5de6/\u53f3\"\u952e\u6c34\u5e73\u79fb\u52a8\u3002\u5176\u6b21\uff0c\u6309\"A\"\u952e\u4e0e\u5bf9\u8c61\u4e92\u52a8\uff0c\u4f8b\u5982\u62fe\u53d6\u7269\u54c1\u3002\u6700\u540e\uff0c\u6309\"B\"\u952e\u6267\u884c\u7279\u6b8a\u52a8\u4f5c\uff0c\u4f8b\u5982\u653b\u51fb\u654c\u4eba\u3002\u8bb0\u4f4f\uff0c\u5728\u6559\u7a0b\u5173\u5361\u7ec3\u4e60\u8fd9\u4e9b\u64cd\u4f5c\uff0c\u4ee5\u4fbf\u719f\u7ec3\u638c\u63e1\u3002"}, {"question": "\u5728\u300a\u82cf\u4f0a\u5361\u6e38\u620f\u300b\u901a\u5173100\u5c0f\u65f6\u540e\uff0c\u5982\u4f55\u5ef6\u957f\u751f\u5b58\u65f6\u95f4\uff1f", "answer": "\u5728\u300a\u82cf\u4f0a\u5361\u6e38\u620f\u300b\u4e2d\u901a\u5173100\u5c0f\u65f6\u540e\uff0c\u751f\u5b58\u7b56\u7565\u53d8\u5f97\u81f3\u5173\u91cd\u8981\u3002\u6b65\u9aa41\uff1a\u901a\u8fc7\u6536\u96c6\u548c\u4fdd\u5b58\u7269\u54c1\uff08\u5982\u751f\u547d\u836f\u6c34\uff09\u6765\u638c\u63e1\u8d44\u6e90\u7ba1\u7406\u3002\u4f8b\u5982\uff0c\u5c06\u836f\u6c34\u7559\u7ed9\u6700\u7ec8BOSS\u6218\u3002\u6b65\u9aa42\uff1a\u5b66\u4e60\u654c\u4eba\u7684\u653b\u51fb\u6a21\u5f0f\u3002\u6bcf\u4e2a\u654c\u4eba\u90fd\u6709\u72ec\u7279\u7684\u653b\u51fb\u987a\u5e8f\uff1b\u5728\u6b63\u786e\u7684\u65f6\u95f4\u8eb2\u907f\u53ef\u4ee5\u8282\u7701\u751f\u547d\u503c\u3002\u6b65\u9aa43\uff1a\u5b9a\u671f\u5347\u7ea7\u4f60\u7684\u88c5\u5907\u3002\u66f4\u597d\u7684\u88c5\u5907\u4f1a\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u751f\u5b58\u51e0\u7387\u3002\u4e3a\u4e86\u6700\u4f73\u6e38\u620f\u4f53\u9a8c\uff0c\u8bf7\u59cb\u7ec8\u4fdd\u6301\u653b\u51fb\u529b\u548c\u9632\u5fa1\u529b\u7684\u5e73\u8861\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u7406\u89e3\u300a\u82cf\u4f0a\u5361\u6e38\u620f\u300b\u7684\u4f24\u5bb3\u8ba1\u7b97\u7cfb\u7edf\u5f88\u91cd\u8981\uff1f", "answer": "\u7406\u89e3\u300a\u82cf\u4f0a\u5361\u6e38\u620f\u300b\u7684\u4f24\u5bb3\u8ba1\u7b97\u7cfb\u7edf\u5bf9\u4e8e\u4f18\u5316\u6e38\u620f\u4f53\u9a8c\u81f3\u5173\u91cd\u8981\u3002\u4f24\u5bb3\u8ba1\u7b97\u57fa\u4e8e\u89d2\u8272\u7684\u653b\u51fb\u529b\u3001\u654c\u4eba\u7684\u9632\u5fa1\u529b\u4ee5\u53ca\u4efb\u4f55\u589e\u76ca/\u51cf\u76ca\u6548\u679c\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u7684\u653b\u51fb\u529b\u4e3a50\uff0c\u654c\u4eba\u7684\u9632\u5fa1\u529b\u4e3a20\uff0c\u5219\u9020\u6210\u7684\u4f24\u5bb3\u4e3a30\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u7269\u54c1\u53ef\u4ee5\u63d0\u9ad8\u4f60\u7684\u653b\u51fb\u529b\uff0c\u4f8b\u5982\"\u529b\u91cf\u624b\u5957\"\uff0c\u53ef\u4ee5\u589e\u52a0+10\u3002\u4e86\u89e3\u8fd9\u4e00\u70b9\u6709\u52a9\u4e8e\u5236\u5b9a\u6218\u6597\u7b56\u7565\u5e76\u9009\u62e9\u5408\u9002\u7684\u88c5\u5907\u3002"}, {"question": "\u5982\u4f55\u5c06\u300a\u82cf\u4f0a\u5361\u6e38\u620f\u300b\u7684\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u5e73\u53f0\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u5e73\u53f0\uff1f", "answer": "\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e0a\u8f6c\u79fb\u300a\u82cf\u4f0a\u5361\u6e38\u620f\u300b\u8fdb\u5ea6\u975e\u5e38\u7b80\u5355\u3002\u9996\u5148\uff0c\u786e\u4fdd\u5728\u6e38\u620f\u8bbe\u7f6e\u4e2d\u542f\u7528\u4e86\u4e91\u4fdd\u5b58\u529f\u80fd\u3002\u4f8b\u5982\uff0c\u5728\u539f\u59cb\u5e73\u53f0\u4e0a\uff0c\u8f6c\u5230\"\u8bbe\u7f6e\"\u5e76\u9009\u62e9\"\u4e91\u4fdd\u5b58\"\u3002\u5176\u6b21\uff0c\u5728\u65b0\u5e73\u53f0\u4e0a\u767b\u5f55\u540c\u4e00\u4e2a\u5e10\u6237\u3002\u6700\u540e\uff0c\u4e0b\u8f7d\u4e91\u4fdd\u5b58\u6765\u7ee7\u7eed\u4f60\u7684\u8fdb\u5ea6\u3002\u8fd9\u79cd\u65b9\u6cd5\u53ef\u4ee5\u786e\u4fdd\u6240\u6709\u4f60\u7684\u6210\u5c31\u548c\u6e38\u620f\u72b6\u6001\u90fd\u5f97\u5230\u4fdd\u5b58\u3002"}, {"question": "\u300a\u82cf\u4f0a\u5361\u6e38\u620f\u300b\u4e2d\u54ea\u4e9b\u9690\u85cf\u533a\u57df\u503c\u5f97\u63a2\u7d22\u4ee5\u83b7\u5f97\u989d\u5916\u5956\u52b1\uff1f", "answer": "\u300a\u82cf\u4f0a\u5361\u6e38\u620f\u300b\u4e2d\u6709\u4e00\u4e9b\u9690\u85cf\u533a\u57df\u53ef\u4ee5\u63d0\u4f9b\u989d\u5916\u5956\u52b1\u3002\u5176\u4e2d\u4e00\u4e2a\u503c\u5f97\u6ce8\u610f\u7684\u533a\u57df\u662f\"\u79d8\u5bc6\u82b1\u56ed\"\uff0c\u53ef\u4ee5\u901a\u8fc7\u5728\"\u68ee\u6797\u5173\u5361\"\u4e2d\u627e\u5230\u4e00\u4e2a\u9690\u85cf\u7684\u5f00\u5173\u6765\u8fdb\u5165\u3002\u4f8b\u5982\uff0c\u8be5\u5f00\u5173\u4f4d\u4e8e\u5730\u56fe\u53f3\u4fa7\u7684\u4e00\u68f5\u5927\u6811\u540e\u9762\u3002\u4e00\u65e6\u6fc0\u6d3b\uff0c\u4e00\u6761\u901a\u5f80\u79d8\u5bc6\u82b1\u56ed\u7684\u8def\u5f84\u5c31\u4f1a\u6253\u5f00\uff0c\u5728\u90a3\u91cc\u4f60\u53ef\u4ee5\u627e\u5230\u7a00\u6709\u7269\u54c1\uff0c\u5982\"\u9ec4\u91d1\u82cf\u4f0a\u5361\"\uff0c\u53ef\u4ee5\u63d0\u5347\u4f60\u7684\u5c5e\u6027\u3002\u63a2\u7d22\u8fd9\u4e9b\u533a\u57df\u53ef\u4ee5\u663e\u8457\u63d0\u5347\u4f60\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u82cf\u4f0a\u5361\u6e38\u620f\u300b\u4e2d\u6709\u6548\u5730\u4f7f\u7528\u589e\u76ca\u9053\u5177\u6765\u83b7\u5f97\u4f18\u52bf\uff1f", "answer": "\u5728\u300a\u82cf\u4f0a\u5361\u6e38\u620f\u300b\u4e2d\u6709\u6548\u5730\u4f7f\u7528\u589e\u76ca\u9053\u5177\u53ef\u4ee5\u7ed9\u4f60\u5e26\u6765\u663e\u8457\u7684\u4f18\u52bf\u3002\u6b65\u9aa41\uff1a\u8bc6\u522b\u4f7f\u7528\u589e\u76ca\u9053\u5177\u7684\u6700\u4f73\u65f6\u673a\u3002\u4f8b\u5982\uff0c\u5728\u9650\u65f6\u6311\u6218\u4e2d\u4f7f\u7528\"\u901f\u5ea6\u52a0\u6210\"\u53ef\u4ee5\u66f4\u5feb\u5730\u5b8c\u6210\u6311\u6218\u3002\u6b65\u9aa42\uff1a\u5c06\u589e\u76ca\u9053\u5177\u7ec4\u5408\u4f7f\u7528\u4ee5\u8fbe\u5230\u6700\u5927\u6548\u679c\u3002\u4f7f\u7528\"\u529b\u91cf\u836f\u6c34\"\u4e0e\"\u62a4\u76fe\"\u76f8\u7ed3\u5408\uff0c\u8ba9\u4f60\u65e2\u66f4\u5f3a\u58ee\uff0c\u53c8\u66f4\u6709\u97e7\u6027\u3002\u6b65\u9aa43\uff1a\u5c06\u7a00\u6709\u589e\u76ca\u9053\u5177\u7559\u7ed9\u5173\u952e\u65f6\u523b\uff0c\u4f8b\u5982BOSS\u6218\u6216\u56f0\u96be\u5173\u5361\u3002\u6218\u7565\u6027\u5730\u4f7f\u7528\u589e\u76ca\u9053\u5177\u53ef\u4ee5\u626d\u8f6c\u5c40\u52bf\u3002"}, {"question": "\u300a\u82cf\u4f0a\u5361\u6e38\u620f\u300b\u7684\u7b49\u7ea7\u7cfb\u7edf\u80cc\u540e\u662f\u4ec0\u4e48\u673a\u5236\uff1f", "answer": "\u300a\u82cf\u4f0a\u5361\u6e38\u620f\u300b\u7684\u7b49\u7ea7\u7cfb\u7edf\u57fa\u4e8e\u4ece\u51fb\u8d25\u654c\u4eba\u548c\u5b8c\u6210\u4efb\u52a1\u4e2d\u83b7\u5f97\u7684\u7ecf\u9a8c\u503c\uff08XP\uff09\u3002\u4f8b\u5982\uff0c\u51fb\u8d25\u4e00\u53ea\"\u7eff\u8272\u53f2\u83b1\u59c6\"\u4f1a\u7ed9\u4f6010\u70b9\u7ecf\u9a8c\u3002\u79ef\u7d2f\u7ecf\u9a8c\u503c\u53ef\u4ee5\u8ba9\u4f60\u89d2\u8272\u5347\u7ea7\uff0c\u63d0\u5347\u5c5e\u6027\uff0c\u4f8b\u5982\u751f\u547d\u503c\u548c\u653b\u51fb\u529b\u3002\u6b64\u5916\uff0c\u6bcf\u4e00\u7ea7\u90fd\u9700\u8981\u8d8a\u6765\u8d8a\u591a\u7684\u7ecf\u9a8c\u3002\u4e86\u89e3\u8fd9\u4e2a\u673a\u5236\u6709\u52a9\u4e8e\u8ba1\u5212\u4f60\u7684\u6e38\u620f\u65b9\u5f0f\uff0c\u786e\u4fdd\u6301\u7eed\u7684\u8fdb\u6b65\u548c\u89d2\u8272\u53d1\u5c55\u3002"}, {"question": "\u5982\u4f55\u4f18\u5316\u6211\u7684\u300a\u82cf\u4f0a\u5361\u6e38\u620f\u300b\u8bbe\u7f6e\u4ee5\u83b7\u5f97\u6700\u4f73\u6027\u80fd\uff1f", "answer": "\u4f18\u5316\u300a\u82cf\u4f0a\u5361\u6e38\u620f\u300b\u8bbe\u7f6e\u53ef\u4ee5\u63d0\u5347\u4f60\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u9996\u5148\uff0c\u6839\u636e\u4f60\u7684\u8bbe\u5907\u80fd\u529b\u8c03\u6574\u56fe\u5f62\u8bbe\u7f6e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u51fa\u73b0\u5ef6\u8fdf\uff0c\u964d\u4f4e\u5206\u8fa8\u7387\u3002\u5176\u6b21\uff0c\u6839\u636e\u4f60\u7684\u6e38\u620f\u98ce\u683c\u81ea\u5b9a\u4e49\u63a7\u5236\u65b9\u6848\uff0c\u4f8b\u5982\u91cd\u65b0\u6620\u5c04\u6309\u94ae\u4ee5\u65b9\u4fbf\u4f7f\u7528\u3002\u6700\u540e\uff0c\u5982\u679c\u652f\u6301\uff0c\u542f\u7528\u4f8b\u5982\"\u9ad8\u5e27\u7387\"\u4e4b\u7c7b\u7684\u6027\u80fd\u6a21\u5f0f\u3002\u8fd9\u4e9b\u8c03\u6574\u53ef\u4ee5\u786e\u4fdd\u66f4\u6d41\u7545\u7684\u6e38\u620f\u4f53\u9a8c\u548c\u66f4\u597d\u7684\u54cd\u5e94\u901f\u5ea6\u3002"}, {"question": "\u5728\u300a\u82cf\u4f0a\u5361\u6e38\u620f\u300b\u4e2d\uff0c\u6709\u54ea\u4e9b\u65b9\u6cd5\u53ef\u4ee5\u6709\u6548\u6253\u635e\u7a00\u6709\u7269\u54c1\uff1f", "answer": "\u5728\u300a\u82cf\u4f0a\u5361\u6e38\u620f\u300b\u4e2d\u6253\u635e\u7a00\u6709\u7269\u54c1\u9700\u8981\u6218\u7565\u89c4\u5212\u3002\u6b65\u9aa41\uff1a\u786e\u5b9a\u6389\u843d\u7387\u9ad8\u7684\u533a\u57df\u3002\u4f8b\u5982\uff0c\"\u6c34\u6676\u6d1e\u7a74\"\u66f4\u6709\u53ef\u80fd\u6389\u843d\"\u795e\u79d8\u788e\u7247\"\u3002\u6b65\u9aa42\uff1a\u88c5\u5907\u53ef\u4ee5\u589e\u52a0\u5e78\u8fd0\u7684\u7269\u54c1\uff0c\u4f8b\u5982\"\u5e78\u8fd0\u7b26\"\uff0c\u53ef\u4ee5\u63d0\u9ad8\u7269\u54c1\u6389\u843d\u7387\u3002\u6b65\u9aa43\uff1a\u91cd\u590d\u5df2\u77e5\u6389\u843d\u7a00\u6709\u7269\u54c1\u7684\u4efb\u52a1\u6216\u5173\u5361\u3002\u7ed3\u5408\u8fd9\u4e9b\u65b9\u6cd5\u53ef\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u83b7\u5f97\u73cd\u8d35\u7269\u54c1\u7684\u673a\u4f1a\u3002"}, {"question": "\u300a\u82cf\u4f0a\u5361\u6e38\u620f\u300b\u7684\u591a\u4eba\u6a21\u5f0f\u5982\u4f55\u63d0\u5347\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u300a\u82cf\u4f0a\u5361\u6e38\u620f\u300b\u7684\u591a\u4eba\u6a21\u5f0f\u63d0\u4f9b\u72ec\u7279\u7684\u589e\u5f3a\u578b\u6e38\u620f\u4f53\u9a8c\u3002\u73a9\u5bb6\u53ef\u4ee5\u7ec4\u961f\u5b8c\u6210\u5177\u6709\u6311\u6218\u6027\u7684\u4efb\u52a1\u6216\u5728\u73a9\u5bb6\u5bf9\u6218\u4e2d\u7ade\u4e89\u3002\u4f8b\u5982\uff0c\u5728\u5408\u4f5c\u6a21\u5f0f\u4e2d\uff0c\u4f60\u53ef\u4ee5\u4e0e\u670b\u53cb\u5408\u4f5c\u7b56\u7565\u6027\u5730\u51fb\u8d25\u5f3a\u5927\u7684BOSS\uff0c\u5229\u7528\u6bcf\u4e2a\u73a9\u5bb6\u7684\u4f18\u52bf\u3002\u6b64\u5916\uff0c\u591a\u4eba\u6a21\u5f0f\u5f15\u5165\u4e86\u72ec\u6709\u7684\u5956\u52b1\u548c\u6210\u5c31\uff0c\u589e\u52a0\u4e86\u6e38\u620f\u7684\u6df1\u5ea6\u3002\u8fd9\u79cd\u6a21\u5f0f\u4fc3\u8fdb\u4e86\u534f\u4f5c\u548c\u7ade\u4e89\uff0c\u4f7f\u6e38\u620f\u66f4\u5177\u5438\u5f15\u529b\u548c\u6d3b\u529b\u3002"}]
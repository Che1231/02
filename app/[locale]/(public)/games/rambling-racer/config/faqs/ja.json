[{"question": "\u521d\u5fc3\u8005\u5411\u3051\u306b\u3001Rambling Racer\u306e\u57fa\u672c\u64cd\u4f5c\u65b9\u6cd5\u3092\u6559\u3048\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "Rambling Racer\u3067\u306f\u3001\u57fa\u672c\u64cd\u4f5c\u306f\u65b0\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u77e2\u5370\u30ad\u30fc\u307e\u305f\u306fWASD\u30ad\u30fc\u3092\u4f7f\u3063\u3066\u79fb\u52d5\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u52a0\u901f\u3059\u308b\u306b\u306f'W'\u30ad\u30fc\u3001\u30d6\u30ec\u30fc\u30ad\u3059\u308b\u306b\u306f'S'\u30ad\u30fc\u3092\u62bc\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3068\u3001\u6700\u521d\u306e\u30b3\u30fc\u30b9\u3092\u30b9\u30e0\u30fc\u30ba\u306b\u9032\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u4f8b\u3048: \u64cd\u4f5c\u3092\u8eca\u306e\u30b9\u30c6\u30a2\u30ea\u30f3\u30b0\u30db\u30a4\u30fc\u30eb\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u6b63\u78ba\u306a\u64cd\u4f5c\u307b\u3069\u826f\u3044\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002]"}, {"question": "100\u6642\u9593\u30d7\u30ec\u30a4\u5f8c\u3001Rambling Racer\u3067\u5bfe\u6226\u76f8\u624b\u3092\u8ffd\u3044\u629c\u304f\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "100\u6642\u9593\u30d7\u30ec\u30a4\u5f8c\u3001\u5bfe\u6226\u76f8\u624b\u3092\u8ffd\u3044\u629c\u304f\u306b\u306f\u9ad8\u5ea6\u306a\u6226\u7565\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6700\u9069\u306a\u8ffd\u3044\u629c\u304d\u5834\u6240\u3092\u898b\u3064\u3051\u308b\u305f\u3081\u306b\u3001\u30b3\u30fc\u30b9\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u7814\u7a76\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5bfe\u6226\u76f8\u624b\u306e\u5f8c\u65b9\u306b\u5bc4\u308a\u6dfb\u3046\u3053\u3068\u3067\u3001\u8ffd\u3044\u629c\u304d\u52a0\u901f\u52b9\u679c\u3092\u6d3b\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5f7c\u3089\u3092\u78ba\u5b9f\u306b\u8ffd\u3044\u629c\u304f\u3088\u3046\u306b\u3001\u52a0\u901f\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u6b63\u78ba\u306b\u5408\u308f\u305b\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30ef\u30a4\u30f3\u30c7\u30a3\u30f3\u30b0\u30ed\u30fc\u30c9\u300d\u30b3\u30fc\u30b9\u3067\u306f\u3001\u6700\u7d42\u76f4\u7dda\u304c\u8ffd\u3044\u629c\u304f\u306e\u306b\u9069\u3057\u3066\u3044\u307e\u3059\u3002[\u5bfe\u5fdc\u8868: \u3055\u307e\u3056\u307e\u306a\u30b3\u30fc\u30b9\u306e\u8ffd\u3044\u629c\u304d\u5834\u6240\u3092\u6bd4\u8f03\u3057\u3066\u7406\u89e3\u3092\u6df1\u3081\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "Rambling Racer\u3067\u30c9\u30ea\u30d5\u30c8\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u306a\u305c\u91cd\u8981\u3067\u3059\u304b\uff1f", "answer": "\u30c9\u30ea\u30d5\u30c8\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u91cd\u8981\u3067\u3059\u3002\u306a\u305c\u306a\u3089\u3001\u3088\u308a\u30bf\u30a4\u30c8\u306a\u30bf\u30fc\u30f3\u3068\u3088\u308a\u901f\u3044\u30b3\u30fc\u30ca\u30fc\u30ea\u30f3\u30b0\u3092\u5b9f\u73fe\u3067\u304d\u308b\u304b\u3089\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30b3\u30eb\u30cd\u30c3\u30c8\u30ab\u30fc\u30d6\u300d\u30b3\u30fc\u30b9\u3067\u306f\u3001\u3046\u307e\u304f\u30c9\u30ea\u30d5\u30c8\u3092\u5b9f\u884c\u3059\u308b\u3053\u3068\u3067\u8cb4\u91cd\u306a\u6642\u9593\u3092\u7bc0\u7d04\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8: \u30c9\u30ea\u30d5\u30c8\u306e\u904e\u7a0b\u3092\u8996\u899a\u5316\u3057\u307e\u3059\uff1a\u30b3\u30fc\u30ca\u30fc\u30a2\u30d7\u30ed\u30fc\u30c1\u2192\u30c9\u30ea\u30d5\u30c8\u958b\u59cb\u2192\u89d2\u5ea6\u8abf\u6574\u2192\u30c9\u30ea\u30d5\u30c8\u7d42\u4e86\u3002]"}, {"question": "\u7af6\u4e89\u529b\u3092\u9ad8\u3081\u308b\u305f\u3081\u306bRambling Racer\u3067\u512a\u5148\u3059\u3079\u304d\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u7af6\u4e89\u529b\u3092\u9ad8\u3081\u308b\u305f\u3081\u306b\u3001'\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8'\u3084'\u30b7\u30fc\u30eb\u30c9'\u306a\u3069\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u300e\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u300f\u306f\u76f4\u7dda\u533a\u9593\u3067\u30b2\u30fc\u30e0\u3092\u5909\u3048\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u3001\u300e\u30b7\u30fc\u30eb\u30c9\u300f\u306f\u969c\u5bb3\u7269\u304b\u3089\u4fdd\u8b77\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30cf\u30a4\u30a6\u30a7\u30a4\u30cf\u30b6\u30fc\u30c9\u300f\u30b3\u30fc\u30b9\u3067\u300e\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u300f\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u30ea\u30fc\u30c9\u3092\u7dad\u6301\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002[\u6bd4\u8f03\u8868: \u69d8\u3005\u306a\u30ec\u30fc\u30b9\u30b7\u30ca\u30ea\u30aa\u306b\u304a\u3051\u308b\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306e\u6709\u52b9\u6027\u3092\u6bd4\u8f03\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "Rambling Racer\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u3092\u3069\u306e\u3088\u3046\u306b\u8a55\u4fa1\u3057\u307e\u3059\u304b\uff1f", "answer": "Rambling Racer\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u57fa\u3065\u3044\u3066\u30dd\u30a4\u30f3\u30c8\u3092\u4ed8\u4e0e\u3059\u308b\u3053\u3068\u3067\u3001\u3055\u307e\u3056\u307e\u306a\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u3092\u8a55\u4fa1\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u7a4d\u6975\u7684\u306a\u30c9\u30e9\u30a4\u30d0\u30fc\u306f\u30aa\u30fc\u30d0\u30fc\u30c6\u30a4\u30af\u3068\u30c9\u30ea\u30d5\u30c8\u3067\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u3001\u614e\u91cd\u306a\u30c9\u30e9\u30a4\u30d0\u30fc\u306f\u30af\u30ea\u30fc\u30f3\u306a\u30e9\u30c3\u30d7\u3068\u885d\u7a81\u56de\u907f\u3067\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u307e\u3059\u3002[\u4f8b\u3048: \u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u6210\u7e3e\u8868\u306e\u3088\u3046\u306b\u3001\u3042\u306a\u305f\u306e\u30c9\u30e9\u30a4\u30d3\u30f3\u30b0\u30b9\u30bf\u30a4\u30eb\u3068\u30b9\u30ad\u30eb\u3092\u53cd\u6620\u3057\u3066\u3044\u307e\u3059\u3002]"}, {"question": "Rambling Racer\u306e\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u4e3b\u306a\u9055\u3044\u306f\u3001\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u306eAI\u306e\u884c\u52d5\u3068\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u306e\u5b9f\u969b\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u884c\u52d5\u3067\u3059\u3002\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u306f\u3001AI\u306f\u4e88\u6e2c\u53ef\u80fd\u306a\u30d1\u30bf\u30fc\u30f3\u306b\u5f93\u3044\u307e\u3059\u304c\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u306f\u4e88\u6e2c\u3067\u304d\u306a\u3044\u4eba\u9593\u306e\u6226\u7565\u304c\u5c0e\u5165\u3055\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u306f\u3001\u5f93\u6765\u306e\u8ffd\u3044\u629c\u304d\u6226\u8853\u3092\u4f7f\u3046\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u51fa\u4f1a\u3046\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002[\u6bd4\u8f03\u8868\uff1a\u4e21\u30e2\u30fc\u30c9\u306b\u304a\u3051\u308bAI\u306e\u884c\u52d5\u3068\u4eba\u9593\u306e\u6226\u7565\u3092\u6bd4\u8f03\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "Rambling Racer\u3067\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u5207\u308a\u66ff\u3048\u308b\u969b\u306b\u3001\u30b9\u30e0\u30fc\u30ba\u306a\u30c7\u30fc\u30bf\u79fb\u884c\u3092\u78ba\u4fdd\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30e0\u30fc\u30ba\u306a\u30c7\u30fc\u30bf\u79fb\u884c\u3092\u78ba\u4fdd\u3059\u308b\u306b\u306f\u3001Google Play\u3084Apple ID\u306a\u3069\u306e\u30e6\u30cb\u30d0\u30fc\u30b5\u30eb\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u306b\u30b2\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30ea\u30f3\u30af\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30ea\u30f3\u30af\u3059\u308b\u3053\u3068\u3067\u3001PC\u304b\u3089\u30e2\u30d0\u30a4\u30eb\u306b\u5207\u308a\u66ff\u3048\u3066\u3082\u9032\u6357\u72b6\u6cc1\u3092\u5931\u3046\u3053\u3068\u306a\u304f\u30d7\u30ec\u30a4\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u624b\u9806\u3092\u793a\u3057\u307e\u3059\uff1a\u8a2d\u5b9a\u3092\u958b\u304f\u2192\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30ea\u30f3\u30af\u3059\u308b\u2192\u79fb\u884c\u3092\u78ba\u8a8d\u3059\u308b\u3002]"}, {"question": "Rambling Racer\u3067\u7279\u5b9a\u306e\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u9054\u6210\u3059\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u7279\u5b9a\u306e\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u5b8c\u4e86\u3059\u308b\u3068\u3001\u30e6\u30cb\u30fc\u30af\u306a\u8eca\u4f53\u30b9\u30ad\u30f3\u3084\u30b3\u30fc\u30b9\u306a\u3069\u306e\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u3059\u3079\u3066\u306e\u300c\u30bf\u30a4\u30e0\u30c8\u30e9\u30a4\u30a2\u30eb\u300d\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u5b8c\u4e86\u3059\u308b\u3068\u3001\u300c\u30ec\u30c8\u30ed\u30ec\u30fc\u30b5\u30fc\u300d\u30b9\u30ad\u30f3\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002[\u6bd4\u8f03\u8868: \u3055\u307e\u3056\u307e\u306a\u30c1\u30e3\u30ec\u30f3\u30b8\u30bf\u30a4\u30d7\u306e\u5831\u916c\u3092\u6bd4\u8f03\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "Rambling Racer\u306e\u5929\u5019\u30b7\u30b9\u30c6\u30e0\u306f\u30ec\u30fc\u30b9\u6226\u7565\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u5929\u5019\u30b7\u30b9\u30c6\u30e0\u306f\u30b3\u30fc\u30b9\u72b6\u6cc1\u3092\u5909\u3048\u308b\u3053\u3068\u3067\u3001\u30ec\u30fc\u30b9\u6226\u7565\u306b\u5927\u304d\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u96e8\u306f\u30c8\u30e9\u30af\u30b7\u30e7\u30f3\u3092\u4f4e\u4e0b\u3055\u305b\u3001\u614e\u91cd\u306a\u30d6\u30ec\u30fc\u30ad\u3068\u30bf\u30fc\u30f3\u304c\u5fc5\u8981\u306b\u306a\u308a\u307e\u3059\u3002[\u4f8b\u3048: \u5929\u5019\u3092\u30b2\u30fc\u30e0\u306e\u30c0\u30a4\u30ca\u30df\u30af\u30b9\u3092\u4e88\u671f\u305b\u306c\u5f62\u3067\u5909\u5316\u3055\u305b\u308b\u30ef\u30a4\u30eb\u30c9\u30ab\u30fc\u30c9\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "Rambling Racer\u3067\u30a4\u30f3\u30b2\u30fc\u30e0\u901a\u8ca8\u3092\u52b9\u679c\u7684\u306b\u7372\u5f97\u3059\u308b\u6700\u3082\u6709\u52b9\u306a\u65b9\u6cd5\u306f\uff1f", "answer": "\u30c7\u30a4\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u5b8c\u4e86\u3057\u3001\u30a4\u30d9\u30f3\u30c8\u306b\u53c2\u52a0\u3059\u308b\u3053\u3068\u3067\u3001\u30a4\u30f3\u30b2\u30fc\u30e0\u901a\u8ca8\u3092\u52b9\u679c\u7684\u306b\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u9031\u9593\u30ec\u30fc\u30b9\u300d\u30a4\u30d9\u30f3\u30c8\u306f\u5927\u304d\u306a\u5831\u916c\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002[\u6bd4\u8f03\u8868\uff1a\u3055\u307e\u3056\u307e\u306a\u30a2\u30af\u30c6\u30a3\u30d3\u30c6\u30a3\u304b\u3089\u306e\u901a\u8ca8\u5831\u916c\u3092\u6bd4\u8f03\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}]
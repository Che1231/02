[{"question": "\u5982\u4f55\u5728\u65b0\u624b\u6a21\u5f0f\u4e0b\u64cd\u4f5c\u6f02\u79fb\u8cfd\u8eca\u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u5728\u6f02\u79fb\u8cfd\u8eca\u4e2d\uff0c\u57fa\u672c\u63a7\u5236\u5c0d\u65bc\u65b0\u624b\u73a9\u5bb6\u81f3\u95dc\u91cd\u8981\u3002\u4f7f\u7528\u65b9\u5411\u9375\u6216 WASD \u9375\u9032\u884c\u79fb\u52d5\u3002\u4f8b\u5982\uff0c\u6309\u4e0b\"W\"\u9375\u52a0\u901f\uff0c\u6309\u4e0b\"S\"\u9375\u6e1b\u901f\u3002\u719f\u7df4\u638c\u63e1\u9019\u4e9b\u63a7\u5236\u65b9\u6cd5\u5c07\u6709\u52a9\u65bc\u60a8\u9806\u5229\u5730\u5728\u521d\u59cb\u8cfd\u9053\u4e0a\u99d5\u99db\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u63a7\u5236\u60f3\u50cf\u6210\u6c7d\u8eca\u65b9\u5411\u76e4\uff0c\u7cbe\u6e96\u7684\u64cd\u4f5c\u5c07\u5e36\u4f86\u66f4\u597d\u7684\u8868\u73fe\u3002]"}, {"question": "\u5728\u73a9\u6f02\u79fb\u8cfd\u8eca 100 \u5c0f\u6642\u5f8c\uff0c\u8d85\u8d8a\u5c0d\u624b\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "100 \u5c0f\u6642\u5f8c\uff0c\u8d85\u8d8a\u5c0d\u624b\u9700\u8981\u66f4\u9032\u968e\u7684\u7b56\u7565\u3002\u6b65\u9a5f 1\uff1a\u4ed4\u7d30\u7814\u7a76\u8cfd\u9053\u4f48\u5c40\uff0c\u627e\u51fa\u6700\u4f73\u7684\u8d85\u8d8a\u9ede\u3002\u6b65\u9a5f 2\uff1a\u5229\u7528\u5c3e\u6d41\u6548\u61c9\uff0c\u7dca\u8ddf\u5728\u5c0d\u624b\u8eab\u5f8c\u4ee5\u7372\u5f97\u901f\u5ea6\u3002\u6b65\u9a5f 3\uff1a\u7cbe\u6e96\u5730\u63a7\u5236\u52a0\u901f\u6642\u6a5f\uff0c\u4ee5\u4fbf\u8d85\u8d8a\u5c0d\u624b\u3002\u4f8b\u5982\uff0c\u5728\"\u873f\u8712\u5c0f\u5f91\"\u8cfd\u9053\u4e0a\uff0c\u6700\u5f8c\u7684\u76f4\u7dda\u8def\u6bb5\u662f\u8d85\u8d8a\u5c0d\u624b\u7684\u7406\u60f3\u4f4d\u7f6e\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u6bd4\u8f03\u4e0d\u540c\u8cfd\u9053\u7684\u8d85\u8d8a\u9ede\u4ee5\u7372\u5f97\u66f4\u4f73\u7684\u7406\u89e3\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u4e86\u89e3\u6f02\u79fb\u6a5f\u5236\u5728\u6f02\u79fb\u8cfd\u8eca\u4e2d\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u4e86\u89e3\u6f02\u79fb\u6a5f\u5236\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u80fd\u8b93\u60a8\u5728\u5f4e\u9053\u4e2d\u57f7\u884c\u66f4\u7dca\u5bc6\u7684\u8f49\u5f4e\u4e26\u66f4\u5feb\u5730\u904e\u5f4e\u3002\u4f8b\u5982\uff0c\u5728\"\u87ba\u65cb\u5f0f\u5f4e\u9053\"\u4e0a\uff0c\u719f\u7df4\u7684\u6f02\u79fb\u6280\u5de7\u53ef\u4ee5\u7bc0\u7701\u5bf6\u8cb4\u7684\u6642\u9593\u3002[\u6d41\u7a0b\u5716\u89e3: \u60f3\u50cf\u6f02\u79fb\u7684\u904e\u7a0b\uff1a\u9032\u5165\u5f4e\u9053 \u2192 \u958b\u59cb\u6f02\u79fb \u2192 \u8abf\u6574\u89d2\u5ea6 \u2192 \u96e2\u958b\u6f02\u79fb\u3002]"}, {"question": "\u5728\u6f02\u79fb\u8cfd\u8eca\u4e2d\uff0c\u70ba\u7372\u5f97\u7af6\u722d\u512a\u52e2\uff0c\u54ea\u4e9b\u589e\u5f37\u9053\u5177\u61c9\u512a\u5148\u8003\u616e\uff1f", "answer": "\u70ba\u4e86\u7372\u5f97\u7af6\u722d\u512a\u52e2\uff0c\u61c9\u512a\u5148\u8003\u616e\"\u52a0\u901f\u589e\u5f37\"\u548c\"\u9632\u8b77\u76fe\"\u7b49\u589e\u5f37\u9053\u5177\u3002\"\u52a0\u901f\u589e\u5f37\"\u5728\u76f4\u7dda\u8def\u6bb5\u53ef\u4ee5\u5e36\u4f86\u7a81\u7834\u6027\u7684\u6539\u8b8a\uff0c\u800c\"\u9632\u8b77\u76fe\"\u5247\u53ef\u4ee5\u4fdd\u8b77\u60a8\u514d\u53d7\u969c\u7919\u7269\u7684\u5f71\u97ff\u3002\u4f8b\u5982\uff0c\u5728\"\u9ad8\u901f\u516c\u8def\u72c2\u98c6\"\u8cfd\u9053\u4e0a\u4f7f\u7528\"\u52a0\u901f\u589e\u5f37\"\u53ef\u4ee5\u5e6b\u52a9\u60a8\u4fdd\u6301\u9818\u5148\u5730\u4f4d\u3002[\u591a\u65b9\u6848\u6bd4\u8f03: \u6bd4\u8f03\u4e0d\u540c\u589e\u5f37\u9053\u5177\u5728\u5404\u7a2e\u8cfd\u4e8b\u60c5\u5883\u4e2d\u7684\u6548\u80fd\u3002]"}, {"question": "\u6f02\u79fb\u8cfd\u8eca\u7684\u7a4d\u5206\u7cfb\u7d71\u5982\u4f55\u734e\u52f5\u4e0d\u540c\u7684\u904a\u6232\u98a8\u683c\uff1f", "answer": "\u6f02\u79fb\u8cfd\u8eca\u7684\u7a4d\u5206\u7cfb\u7d71\u900f\u904e\u6839\u64da\u8868\u73fe\u5206\u914d\u5206\u6578\u4f86\u734e\u52f5\u5404\u7a2e\u904a\u6232\u98a8\u683c\u3002\u4f8b\u5982\uff0c\u7a4d\u6975\u7684\u99d5\u99db\u54e1\u6703\u56e0\u70ba\u8d85\u8d8a\u548c\u6f02\u79fb\u800c\u7372\u5f97\u5206\u6578\uff0c\u800c\u8b39\u614e\u7684\u99d5\u99db\u54e1\u6703\u56e0\u70ba\u4e7e\u6de8\u7684\u5708\u901f\u548c\u907f\u514d\u78b0\u649e\u800c\u7372\u5f97\u5206\u6578\u3002[\u6bd4\u55bb\u8aaa\u660e: \u7a4d\u5206\u7cfb\u7d71\u5c31\u50cf\u6210\u7e3e\u55ae\uff0c\u53cd\u6620\u4e86\u60a8\u7684\u99d5\u99db\u98a8\u683c\u548c\u6280\u5de7\u3002]"}, {"question": "\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u5728\u6f02\u79fb\u8cfd\u8eca\u4e2d\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "\u4e3b\u8981\u5dee\u7570\u5728\u65bc\u55ae\u4eba\u6a21\u5f0f\u4e2d AI \u7684\u884c\u70ba\u548c\u591a\u4eba\u6a21\u5f0f\u4e2d\u771f\u5be6\u73a9\u5bb6\u7684\u7b56\u7565\u3002\u5728\u55ae\u4eba\u6a21\u5f0f\u4e2d\uff0cAI \u6703\u9075\u5faa\u53ef\u9810\u6e2c\u7684\u6a21\u5f0f\uff0c\u800c\u591a\u4eba\u6a21\u5f0f\u5247\u5f15\u5165\u4e86\u4e0d\u53ef\u9810\u6e2c\u7684\u4eba\u985e\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u60a8\u53ef\u80fd\u6703\u9047\u5230\u4f7f\u7528\u975e\u5e38\u898f\u8d85\u8d8a\u7b56\u7565\u7684\u73a9\u5bb6\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u6bd4\u8f03\u5169\u7a2e\u6a21\u5f0f\u7684 AI \u884c\u70ba\u548c\u4eba\u985e\u7b56\u7565\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u66f4\u63db\u5e73\u53f0\u6642\u78ba\u4fdd\u6f02\u79fb\u8cfd\u8eca\u7684\u8cc7\u6599\u5e73\u7a69\u9077\u79fb\uff1f", "answer": "\u70ba\u4e86\u78ba\u4fdd\u8cc7\u6599\u5e73\u7a69\u9077\u79fb\uff0c\u8acb\u5c07\u60a8\u7684\u904a\u6232\u5e33\u6236\u9023\u7d50\u5230\u901a\u7528\u500b\u4eba\u6a94\u6848\uff0c\u4f8b\u5982 Google Play \u6216 Apple ID\u3002\u4f8b\u5982\uff0c\u9023\u7d50\u5e33\u6236\u8b93\u60a8\u53ef\u4ee5\u5728 PC \u548c\u624b\u6a5f\u4e4b\u9593\u5207\u63db\u800c\u4e0d\u6703\u907a\u5931\u9032\u5ea6\u3002[\u6d41\u7a0b\u5716\u89e3: \u986f\u793a\u6b65\u9a5f\uff1a\u958b\u555f\u8a2d\u5b9a \u2192 \u9023\u7d50\u5e33\u6236 \u2192 \u78ba\u8a8d\u9077\u79fb\u3002]"}, {"question": "\u5b8c\u6210\u7279\u5b9a\u6311\u6230\u53ef\u4ee5\u5728\u6f02\u79fb\u8cfd\u8eca\u4e2d\u89e3\u9396\u54ea\u4e9b\u96b1\u85cf\u5167\u5bb9\uff1f", "answer": "\u5b8c\u6210\u7279\u5b9a\u6311\u6230\u53ef\u4ee5\u89e3\u9396\u96b1\u85cf\u5167\u5bb9\uff0c\u4f8b\u5982\u7368\u7279\u7684\u8eca\u6b3e\u5916\u89c0\u548c\u8cfd\u9053\u3002\u4f8b\u5982\uff0c\u5b8c\u6210\u6240\u6709\"\u8a08\u6642\u8cfd\"\u6311\u6230\u53ef\u4ee5\u89e3\u9396\"\u5fa9\u53e4\u8cfd\u8eca\u624b\"\u5916\u89c0\u3002[\u591a\u65b9\u6848\u6bd4\u8f03: \u6bd4\u8f03\u4e0d\u540c\u6311\u6230\u985e\u578b\u7684\u734e\u52f5\u3002]"}, {"question": "\u6f02\u79fb\u8cfd\u8eca\u4e2d\u7684\u5929\u6c23\u7cfb\u7d71\u5982\u4f55\u5f71\u97ff\u8cfd\u4e8b\u7b56\u7565\uff1f", "answer": "\u5929\u6c23\u7cfb\u7d71\u6703\u986f\u8457\u5730\u5f71\u97ff\u8cfd\u4e8b\u7b56\u7565\uff0c\u56e0\u70ba\u5b83\u6703\u6539\u8b8a\u8cfd\u9053\u72c0\u6cc1\u3002\u4f8b\u5982\uff0c\u4e0b\u96e8\u6703\u964d\u4f4e\u6469\u64e6\u529b\uff0c\u9700\u8981\u5c0f\u5fc3\u5730\u63a7\u5236\u715e\u8eca\u548c\u8f49\u5411\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u5929\u6c23\u60f3\u50cf\u6210\u4e00\u500b\u8b8a\u6578\uff0c\u6703\u4e0d\u53ef\u9810\u6e2c\u5730\u6539\u8b8a\u904a\u6232\u7684\u52d5\u614b\u3002]"}, {"question": "\u5728\u6f02\u79fb\u8cfd\u8eca\u4e2d\uff0c\u7372\u5f97\u904a\u6232\u5167\u8ca8\u5e63\u7684\u6700\u6709\u6548\u65b9\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "\u900f\u904e\u5b8c\u6210\u6bcf\u65e5\u6311\u6230\u548c\u53c3\u8207\u6d3b\u52d5\u4f86\u6709\u6548\u5730\u7372\u5f97\u904a\u6232\u5167\u8ca8\u5e63\u3002\u4f8b\u5982\uff0c\"\u6bcf\u5468\u8cfd\u4e8b\"\u6d3b\u52d5\u63d0\u4f9b\u8c50\u539a\u7684\u734e\u52f5\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u6bd4\u8f03\u4e0d\u540c\u6d3b\u52d5\u7372\u5f97\u8ca8\u5e63\u7684\u734e\u52f5\u3002]"}]
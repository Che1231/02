[{"question": "\ucd08\ubcf4\uc790\uac00 Rambling Racer\uc5d0\uc11c \uae30\ubcf8 \uc81c\uc5b4 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Rambling Racer\uc5d0\uc11c \uae30\ubcf8 \uc81c\uc5b4\ub294 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \ubc29\ud5a5\ud0a4 \ub610\ub294 WASD\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc774\ub3d9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac00\uc18d\ud558\ub824\uba74 'W'\ub97c, \uc81c\ub3d9\ud558\ub824\uba74 'S'\ub97c \ub204\ub974\uc138\uc694. \uc774\ub7ec\ud55c \uc81c\uc5b4\ub97c \uc219\ub2ec\ud558\uba74 \ucd08\uae30 \ud2b8\ub799\uc744 \uc6d0\ud65c\ud558\uac8c \uc774\ub3d9\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc81c\uc5b4\ub294 \ucc28\ub7c9\uc758 \uc2a4\ud2f0\uc5b4\ub9c1 \ud720\uacfc \uac19\uc73c\uba70, \uc815\ud655\uc131\uc740 \ub354 \ub098\uc740 \uc131\ub2a5\uc73c\ub85c \uc774\uc5b4\uc9d1\ub2c8\ub2e4.]"}, {"question": "Rambling Racer\uc5d0\uc11c 100\uc2dc\uac04 \ud50c\ub808\uc774 \ud6c4 \uc0c1\ub300\ub97c \ucd94\uc6d4\ud558\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "100\uc2dc\uac04 \ud50c\ub808\uc774 \ud6c4 \ucd94\uc6d4\uc5d0\ub294 \uace0\uae09 \uc804\ub7b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \ucd5c\uc801\uc758 \ucd94\uc6d4 \uc9c0\uc810\uc744 \ucc3e\uae30 \uc704\ud574 \ud2b8\ub799 \ub808\uc774\uc544\uc6c3\uc744 \uc5f0\uad6c\ud569\ub2c8\ub2e4. STEP2: \uc0c1\ub300 \ub4a4\ucabd\uc5d0 \uac00\uae4c\uc774 \ubd99\uc5b4 \ucd94\uc6d4 \uc2dc \uc18d\ub3c4\ub97c \ub192\uc774\ub294 \uc2ac\ub9bd\uc2a4\ud2b8\ub9bc \ud6a8\uacfc\ub97c \ud65c\uc6a9\ud569\ub2c8\ub2e4. STEP3: \uc0c1\ub300\ub97c \ucd94\uc6d4\ud558\uae30 \uc704\ud574 \uac00\uc18d \uc2dc\uae30\ub97c \uc815\ud655\ud558\uac8c \uc870\uc808\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'Twisty Trails' \ud2b8\ub799\uc5d0\uc11c \ub9c8\uc9c0\ub9c9 \uc9c1\uc120\uc740 \ucd94\uc6d4\ud558\uae30\uc5d0 \uc774\uc0c1\uc801\uc785\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \ub2e4\uc591\ud55c \ud2b8\ub799\uc758 \ucd94\uc6d4 \uc9c0\uc810\uc744 \ube44\uad50\ud558\uc5ec \uc774\ud574\ub97c \ub192\uc774\uc138\uc694.]"}, {"question": "Rambling Racer\uc5d0\uc11c \ub4dc\ub9ac\ud504\ud2b8 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub4dc\ub9ac\ud504\ud2b8 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \uc881\uc740 \ucf54\ub108\uc640 \ube60\ub978 \ucf54\ub108\ub9c1\uc744 \uac00\ub2a5\ud558\uac8c \ud558\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'Corkscrew Curve' \ud2b8\ub799\uc5d0\uc11c \uc798 \uc2e4\ud589\ub41c \ub4dc\ub9ac\ud504\ud2b8\ub294 \uadc0\uc911\ud55c \uc2dc\uac04\uc744 \uc808\uc57d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \ub3c4\ud45c: \ub4dc\ub9ac\ud504\ud2b8 \uacfc\uc815\uc744 \uc2dc\uac01\ud654\ud558\uc138\uc694: \ucf54\ub108 \uc811\uadfc \u2192 \ub4dc\ub9ac\ud504\ud2b8 \uc2dc\uc791 \u2192 \uac01\ub3c4 \uc870\uc808 \u2192 \ub4dc\ub9ac\ud504\ud2b8 \uc885\ub8cc.]"}, {"question": "Rambling Racer\uc5d0\uc11c \uacbd\uc7c1\ub825\uc744 \ud655\ubcf4\ud558\uae30 \uc704\ud574 \uc6b0\uc120\uc21c\uc704\ub97c \ub450\uc5b4\uc57c \ud560 \ud30c\uc6cc\uc5c5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uacbd\uc7c1\ub825\uc744 \ud655\ubcf4\ud558\uae30 \uc704\ud574 '\uc18d\ub3c4 \ubd80\uc2a4\ud130'\uc640 '\uc274\ub4dc'\uc640 \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc6b0\uc120\uc21c\uc704\ub85c \ud558\uc138\uc694. '\uc18d\ub3c4 \ubd80\uc2a4\ud130'\ub294 \uc9c1\uc120 \uad6c\uac04\uc5d0\uc11c \uac8c\uc784\uc744 \ubc14\uafc0 \uc218 \uc788\ub294 \uc694\uc18c\uc774\uba70, '\uc274\ub4dc'\ub294 \uc7a5\uc560\ubb3c\ub85c\ubd80\ud130 \ubcf4\ud638\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'Highway Havoc' \ud2b8\ub799\uc5d0\uc11c '\uc18d\ub3c4 \ubd80\uc2a4\ud130'\ub97c \uc0ac\uc6a9\ud558\uba74 \uc120\ub450\ub97c \uc720\uc9c0\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc635\uc158 \ube44\uad50: \ub2e4\uc591\ud55c \uacbd\uc8fc \uc2dc\ub098\ub9ac\uc624\uc5d0\uc11c \ud30c\uc6cc\uc5c5\uc758 \ud6a8\uacfc\ub97c \ube44\uad50\ud558\uc138\uc694.]"}, {"question": "Rambling Racer\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ub2e4\uc591\ud55c \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc744 \uc5b4\ub5bb\uac8c \ubcf4\uc0c1\ud558\ub098\uc694?", "answer": "Rambling Racer\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc131\ub2a5\uc5d0 \ub530\ub77c \uc810\uc218\ub97c \ubd80\uc5ec\ud558\uc5ec \ub2e4\uc591\ud55c \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc744 \ubcf4\uc0c1\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uacf5\uaca9\uc801\uc778 \uc6b4\uc804\uc790\ub294 \ucd94\uc6d4\uacfc \ub4dc\ub9ac\ud504\ud2b8\ub85c \uc810\uc218\ub97c \uc5bb\uace0, \uc2e0\uc911\ud55c \uc6b4\uc804\uc790\ub294 \uae68\ub057\ud55c \ub7a9\uacfc \ucda9\ub3cc \ud68c\ud53c\ub85c \uc810\uc218\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ub9c8\uce58 \uc131\uc801\ud45c\uc640 \uac19\uc544\uc11c \uc6b4\uc804 \uc2a4\ud0c0\uc77c\uacfc \uae30\uc220\uc744 \ubc18\uc601\ud569\ub2c8\ub2e4.]"}, {"question": "Rambling Racer\uc758 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc8fc\uc694 \ucc28\uc774\uc810\uc740 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4\uc758 AI \ud589\ub3d9\uacfc \uba40\ud2f0 \ud50c\ub808\uc774\uc5b4\uc758 \uc2e4\uc81c \ud50c\ub808\uc774\uc5b4\uc758 \ud589\ub3d9\uc785\ub2c8\ub2e4. \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4\uc5d0\uc11c\ub294 AI\uac00 \uc608\uce21 \uac00\ub2a5\ud55c \ud328\ud134\uc744 \ub530\ub974\uc9c0\ub9cc, \uba40\ud2f0 \ud50c\ub808\uc774\uc5b4\uc5d0\uc11c\ub294 \uc608\uce21 \ubd88\uac00\ub2a5\ud55c \uc778\uac04 \uc804\ub7b5\uc774 \ub4f1\uc7a5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uba40\ud2f0 \ud50c\ub808\uc774\uc5b4\uc5d0\uc11c\ub294 \ube44\ud45c\uc900\uc801\uc778 \ucd94\uc6d4 \uc804\uc220\uc744 \uc0ac\uc6a9\ud558\ub294 \ud50c\ub808\uc774\uc5b4\ub97c \ub9cc\ub0a0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \ub450 \ubaa8\ub4dc\uc5d0\uc11c AI \ud589\ub3d9\uacfc \uc778\uac04 \uc804\ub7b5\uc744 \ube44\uad50\ud558\uc138\uc694.]"}, {"question": "\ud50c\ub808\uc774\uc5b4\uac00 Rambling Racer\uc5d0\uc11c \ud50c\ub7ab\ud3fc\uc744 \ubcc0\uacbd\ud560 \ub54c \uc6d0\ud65c\ud55c \ub370\uc774\ud130 \ub9c8\uc774\uadf8\ub808\uc774\uc158\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud558\ub098\uc694?", "answer": "\uc6d0\ud65c\ud55c \ub370\uc774\ud130 \ub9c8\uc774\uadf8\ub808\uc774\uc158\uc744 \ubcf4\uc7a5\ud558\ub824\uba74 Google Play \ub610\ub294 Apple ID\uc640 \uac19\uc740 \ubc94\uc6a9 \ud504\ub85c\ud544\uc5d0 \uac8c\uc784 \uacc4\uc815\uc744 \uc5f0\uacb0\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4 \uacc4\uc815\uc744 \uc5f0\uacb0\ud558\uba74 PC\uc5d0\uc11c \ubaa8\ubc14\uc77c\ub85c \uc804\ud658\ud574\ub3c4 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc783\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \ub3c4\ud45c: \ub2e8\uacc4\ub97c \ubcf4\uc5ec\uc8fc\uc138\uc694: \uc124\uc815 \uc5f4\uae30 \u2192 \uacc4\uc815 \uc5f0\uacb0 \u2192 \ub9c8\uc774\uadf8\ub808\uc774\uc158 \ud655\uc778.]"}, {"question": "Rambling Racer\uc5d0\uc11c \ud2b9\uc815 \ucc4c\ub9b0\uc9c0 \uc644\ub8cc\ub97c \ud1b5\ud574 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \uc5b4\ub5bb\uac8c \ud574\uc81c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud2b9\uc815 \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\uba74 \ub3c5\ud2b9\ud55c \ucc28\ub7c9 \uc2a4\ud0a8\uacfc \ud2b8\ub799 \ub4f1 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\uac00 \ud574\uc81c\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubaa8\ub4e0 '\ud0c0\uc784 \ud2b8\ub77c\uc774\uc5bc' \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\uba74 '\ub808\ud2b8\ub85c \ub808\uc774\uc11c' \uc2a4\ud0a8\uc774 \ud574\uc81c\ub429\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc635\uc158 \ube44\uad50: \uc11c\ub85c \ub2e4\ub978 \ucc4c\ub9b0\uc9c0 \uc720\ud615\uc758 \ubcf4\uc0c1\uc744 \ube44\uad50\ud558\uc138\uc694.]"}, {"question": "Rambling Racer\uc758 \ub0a0\uc528 \uc2dc\uc2a4\ud15c\uc740 \uacbd\uc8fc \uc804\ub7b5\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "\ub0a0\uc528 \uc2dc\uc2a4\ud15c\uc740 \ud2b8\ub799 \uc0c1\ud0dc\ub97c \ubcc0\uacbd\ud558\uc5ec \uacbd\uc8fc \uc804\ub7b5\uc5d0 \uc0c1\ub2f9\ud55c \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ube44\ub294 \ub9c8\ucc30\ub825\uc744 \uac10\uc18c\uc2dc\ucf1c \uc8fc\uc758 \uae4a\uc740 \uc81c\ub3d9 \ubc0f \ud68c\uc804\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ub0a0\uc528\ub294 \uac8c\uc784\uc758 \uc5ed\ud559\uc744 \uc608\uce21 \ubd88\uac00\ub2a5\ud558\uac8c \ubc14\uafc0 \uc218 \uc788\ub294 \ubcc0\uc218\uc640 \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "Rambling Racer\uc5d0\uc11c \uac8c\uc784 \ub0b4 \ud1b5\ud654\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \ud68d\ub4dd\ud558\ub294 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub9e4\uc77c \ucc4c\ub9b0\uc9c0 \uc644\ub8cc \ubc0f \uc774\ubca4\ud2b8 \ucc38\uc5ec\ub97c \ud1b5\ud574 \uac8c\uc784 \ub0b4 \ud1b5\ud654\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \ud68d\ub4dd\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uc8fc\uac04 \uacbd\uc8fc' \uc774\ubca4\ud2b8\ub294 \uc0c1\ub2f9\ud55c \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.[\uc124\uc815 \ube44\uad50\ud45c: \ub2e4\uc591\ud55c \ud65c\ub3d9\uc5d0\uc11c \uc5bb\ub294 \ud1b5\ud654 \ubcf4\uc0c1\uc744 \ube44\uad50\ud558\uc138\uc694.]"}]
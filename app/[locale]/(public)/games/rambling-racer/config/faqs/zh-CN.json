[{"question": "\u5982\u4f55\u5728\u65b0\u624b\u6a21\u5f0f\u4e0b\u8fdb\u884c\u8d5b\u8f66\u7ade\u901f\u6e38\u620f\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u5728\u8d5b\u8f66\u7ade\u901f\u6e38\u620f\u4e2d\uff0c\u65b0\u624b\u73a9\u5bb6\u5fc5\u987b\u638c\u63e1\u57fa\u672c\u64cd\u4f5c\u3002\u4f7f\u7528\u65b9\u5411\u952e\u6216 WASD \u8fdb\u884c\u79fb\u52a8\u3002\u4f8b\u5982\uff0c\u6309\"W\"\u52a0\u901f\uff0c\u6309\"S\"\u5239\u8f66\u3002\u719f\u7ec3\u638c\u63e1\u8fd9\u4e9b\u64cd\u4f5c\uff0c\u624d\u80fd\u987a\u5229\u5730\u5728\u521d\u59cb\u8d5b\u9053\u4e0a\u884c\u9a76\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u628a\u64cd\u4f5c\u60f3\u8c61\u6210\u6c7d\u8f66\u7684\u65b9\u5411\u76d8\uff0c\u7cbe\u51c6\u7684\u64cd\u4f5c\u624d\u80fd\u83b7\u5f97\u66f4\u597d\u7684\u6027\u80fd\u3002]"}, {"question": "\u5728\u6e38\u620f\u4e2d\u73a9\u6ee1 100 \u5c0f\u65f6\u540e\uff0c\u5982\u4f55\u5236\u5b9a\u8d85\u8d8a\u5bf9\u624b\u7684\u6700\u4f73\u7b56\u7565\uff1f", "answer": "100 \u5c0f\u65f6\u540e\uff0c\u8d85\u8d8a\u5bf9\u624b\u9700\u8981\u66f4\u9ad8\u7ea7\u7684\u7b56\u7565\u3002\u6b65\u9aa4\u4e00\uff1a\u7814\u7a76\u8d5b\u9053\u5e03\u5c40\uff0c\u627e\u51fa\u6700\u4f73\u7684\u8d85\u8d8a\u4f4d\u7f6e\u3002\u6b65\u9aa4\u4e8c\uff1a\u5229\u7528\u5c3e\u6d41\u6548\u5e94\uff0c\u7d27\u8ddf\u5bf9\u624b\u83b7\u5f97\u901f\u5ea6\u3002\u6b65\u9aa4\u4e09\uff1a\u5b8c\u7f8e\u5730\u63a7\u5236\u52a0\u901f\u65f6\u673a\uff0c\u8d85\u8d8a\u5bf9\u624b\u3002\u4f8b\u5982\uff0c\u5728\"\u873f\u8712\u8d5b\u9053\"\u8d5b\u9053\u4e0a\uff0c\u6700\u540e\u7684\u76f4\u9053\u662f\u8d85\u8d8a\u7684\u7406\u60f3\u4f4d\u7f6e\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6bd4\u8f83\u4e0d\u540c\u8d5b\u9053\u4e0a\u7684\u8d85\u8d8a\u4f4d\u7f6e\uff0c\u4ee5\u4fbf\u66f4\u597d\u5730\u7406\u89e3\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u7406\u89e3\u6f02\u79fb\u673a\u5236\u5728\u8d5b\u8f66\u7ade\u901f\u6e38\u620f\u4e2d\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u7406\u89e3\u6f02\u79fb\u673a\u5236\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u5141\u8bb8\u73a9\u5bb6\u5728\u5f2f\u9053\u4e2d\u66f4\u7d27\u51d1\u5730\u8f6c\u5411\uff0c\u5e76\u66f4\u5feb\u5730\u8fc7\u5f2f\u3002\u4f8b\u5982\uff0c\u5728\"\u87ba\u65cb\u5f62\u5f2f\u9053\"\u8d5b\u9053\u4e0a\uff0c\u4e00\u6b21\u6210\u529f\u7684\u6f02\u79fb\u53ef\u4ee5\u8282\u7701\u5b9d\u8d35\u7684\u65f6\u95f4\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u53ef\u89c6\u5316\u6f02\u79fb\u8fc7\u7a0b\uff1a\u8fdb\u5165\u5f2f\u9053 \u2192 \u5f00\u59cb\u6f02\u79fb \u2192 \u8c03\u6574\u89d2\u5ea6 \u2192 \u7ed3\u675f\u6f02\u79fb\u3002]"}, {"question": "\u4e3a\u4e86\u5728\u8d5b\u8f66\u7ade\u901f\u6e38\u620f\u4e2d\u83b7\u5f97\u7ade\u4e89\u4f18\u52bf\uff0c\u5e94\u8be5\u4f18\u5148\u8003\u8651\u54ea\u4e9b\u9053\u5177\uff1f", "answer": "\u4e3a\u4e86\u83b7\u5f97\u7ade\u4e89\u4f18\u52bf\uff0c\u4f18\u5148\u8003\u8651\"\u52a0\u901f\"\u548c\"\u62a4\u76fe\"\u7b49\u9053\u5177\u3002\"\u52a0\u901f\"\u9053\u5177\u5728\u76f4\u9053\u4e0a\u53ef\u4ee5\u8d77\u5230\u5173\u952e\u4f5c\u7528\uff0c\u800c\"\u62a4\u76fe\"\u5219\u53ef\u4ee5\u5e2e\u52a9\u73a9\u5bb6\u62b5\u5fa1\u969c\u788d\u7269\u3002\u4f8b\u5982\uff0c\u5728\"\u9ad8\u901f\u516c\u8def\u72c2\u98d9\"\u8d5b\u9053\u4e0a\u4f7f\u7528\"\u52a0\u901f\"\u9053\u5177\u53ef\u4ee5\u5e2e\u52a9\u4f60\u4fdd\u6301\u9886\u5148\u5730\u4f4d\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6bd4\u8f83\u4e0d\u540c\u9053\u5177\u5728\u5404\u79cd\u6bd4\u8d5b\u573a\u666f\u4e2d\u7684\u6709\u6548\u6027\u3002]"}, {"question": "\u8d5b\u8f66\u7ade\u901f\u6e38\u620f\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u5982\u4f55\u5956\u52b1\u4e0d\u540c\u7684\u6e38\u620f\u98ce\u683c\uff1f", "answer": "\u8d5b\u8f66\u7ade\u901f\u6e38\u620f\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u901a\u8fc7\u6839\u636e\u8868\u73b0\u5206\u914d\u70b9\u6570\u6765\u5956\u52b1\u5404\u79cd\u6e38\u620f\u98ce\u683c\u3002\u4f8b\u5982\uff0c\u6fc0\u8fdb\u7684\u9a7e\u9a76\u5458\u4f1a\u56e0\u8d85\u8d8a\u548c\u6f02\u79fb\u800c\u83b7\u5f97\u5206\u6570\uff0c\u800c\u8c28\u614e\u7684\u9a7e\u9a76\u5458\u4f1a\u56e0\u5e72\u51c0\u7684\u5708\u901f\u548c\u907f\u514d\u78b0\u649e\u800c\u83b7\u5f97\u5206\u6570\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u8bc4\u5206\u7cfb\u7edf\u5c31\u50cf\u6210\u7ee9\u5355\u4e00\u6837\uff0c\u53cd\u6620\u4e86\u4f60\u7684\u9a7e\u9a76\u98ce\u683c\u548c\u6280\u80fd\u3002]"}, {"question": "\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u5728\u8d5b\u8f66\u7ade\u901f\u6e38\u620f\u4e2d\u7684\u4e3b\u8981\u533a\u522b\u662f\u4ec0\u4e48\uff1f", "answer": "\u4e3b\u8981\u533a\u522b\u5728\u4e8e\u5355\u4eba\u6a21\u5f0f\u4e2d AI \u7684\u884c\u4e3a\u4e0e\u591a\u4eba\u6a21\u5f0f\u4e2d\u771f\u5b9e\u73a9\u5bb6\u7684\u884c\u4e3a\u4e0d\u540c\u3002\u5728\u5355\u4eba\u6a21\u5f0f\u4e2d\uff0cAI \u4f1a\u9075\u5faa\u53ef\u9884\u6d4b\u7684\u6a21\u5f0f\uff0c\u800c\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u73a9\u5bb6\u5219\u4f1a\u91c7\u7528\u4e0d\u53ef\u9884\u6d4b\u7684\u4eba\u7c7b\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f60\u53ef\u80fd\u4f1a\u9047\u5230\u4f7f\u7528\u975e\u5e38\u89c4\u8d85\u8d8a\u6218\u672f\u7684\u73a9\u5bb6\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6bd4\u8f83\u4e24\u79cd\u6a21\u5f0f\u4e0b AI \u884c\u4e3a\u548c\u4eba\u7c7b\u7b56\u7565\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u66f4\u6362\u5e73\u53f0\u65f6\u786e\u4fdd\u8d5b\u8f66\u7ade\u901f\u6e38\u620f\u6570\u636e\u7684\u5e73\u7a33\u8fc1\u79fb\uff1f", "answer": "\u4e3a\u4e86\u786e\u4fdd\u6570\u636e\u5e73\u7a33\u8fc1\u79fb\uff0c\u8bf7\u5c06\u6e38\u620f\u5e10\u6237\u94fe\u63a5\u5230\u901a\u7528\u4e2a\u4eba\u8d44\u6599\uff0c\u4f8b\u5982 Google Play \u6216 Apple ID\u3002\u4f8b\u5982\uff0c\u94fe\u63a5\u60a8\u7684\u5e10\u6237\u5141\u8bb8\u60a8\u4ece PC \u5207\u6362\u5230\u79fb\u52a8\u8bbe\u5907\uff0c\u800c\u4e0d\u4f1a\u4e22\u5931\u8fdb\u5ea6\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u5c55\u793a\u6b65\u9aa4\uff1a\u6253\u5f00\u8bbe\u7f6e \u2192 \u94fe\u63a5\u5e10\u6237 \u2192 \u786e\u8ba4\u8fc1\u79fb\u3002]"}, {"question": "\u901a\u8fc7\u5b8c\u6210\u8d5b\u8f66\u7ade\u901f\u6e38\u620f\u4e2d\u7684\u7279\u5b9a\u6311\u6218\uff0c\u53ef\u4ee5\u89e3\u9501\u54ea\u4e9b\u9690\u85cf\u5185\u5bb9\uff1f", "answer": "\u5b8c\u6210\u7279\u5b9a\u6311\u6218\u53ef\u4ee5\u89e3\u9501\u9690\u85cf\u5185\u5bb9\uff0c\u4f8b\u5982\u72ec\u7279\u7684\u8d5b\u8f66\u76ae\u80a4\u548c\u8d5b\u9053\u3002\u4f8b\u5982\uff0c\u5b8c\u6210\u6240\u6709\"\u8ba1\u65f6\u8d5b\"\u6311\u6218\u53ef\u4ee5\u89e3\u9501\"\u590d\u53e4\u8d5b\u8f66\u624b\"\u76ae\u80a4\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6bd4\u8f83\u4e0d\u540c\u6311\u6218\u7c7b\u578b\u7684\u5956\u52b1\u3002]"}, {"question": "\u8d5b\u8f66\u7ade\u901f\u6e38\u620f\u4e2d\u7684\u5929\u6c14\u7cfb\u7edf\u5982\u4f55\u5f71\u54cd\u8d5b\u8f66\u7b56\u7565\uff1f", "answer": "\u8d5b\u8f66\u7ade\u901f\u6e38\u620f\u4e2d\u7684\u5929\u6c14\u7cfb\u7edf\u4f1a\u901a\u8fc7\u6539\u53d8\u8d5b\u9053\u72b6\u51b5\u6765\u663e\u8457\u5f71\u54cd\u8d5b\u8f66\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u4e0b\u96e8\u4f1a\u964d\u4f4e\u9644\u7740\u529b\uff0c\u9700\u8981\u5c0f\u5fc3\u5730\u5239\u8f66\u548c\u8f6c\u5411\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u628a\u5929\u6c14\u60f3\u8c61\u6210\u6e38\u620f\u4e2d\u7684\u4e00\u4e2a\u53d8\u6570\uff0c\u5b83\u4f1a\u4e0d\u53ef\u9884\u6d4b\u5730\u6539\u53d8\u6e38\u620f\u7684\u52a8\u6001\u3002]"}, {"question": "\u5728\u8d5b\u8f66\u7ade\u901f\u6e38\u620f\u4e2d\u83b7\u5f97\u6e38\u620f\u5185\u8d27\u5e01\u7684\u6700\u6709\u6548\u65b9\u5f0f\u662f\u4ec0\u4e48\uff1f", "answer": "\u901a\u8fc7\u5b8c\u6210\u6bcf\u65e5\u6311\u6218\u548c\u53c2\u4e0e\u6d3b\u52a8\u6765\u6709\u6548\u5730\u83b7\u5f97\u6e38\u620f\u5185\u8d27\u5e01\u3002\u4f8b\u5982\uff0c\"\u6bcf\u5468\u6bd4\u8d5b\"\u6d3b\u52a8\u63d0\u4f9b\u4e86\u4e30\u539a\u7684\u5956\u52b1\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6bd4\u8f83\u4e0d\u540c\u6d3b\u52a8\u83b7\u5f97\u7684\u8d27\u5e01\u5956\u52b1\u3002]"}]
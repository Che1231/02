[{"question": "\u65b0\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u94c1\u5320\u300b\u6e38\u620f\u4e2d\u9ad8\u6548\u7ba1\u7406\u8d44\u6e90\uff1f", "answer": "\u5728\u300a\u94c1\u5320\u300b\u4e2d\uff0c\u9ad8\u6548\u7684\u8d44\u6e90\u7ba1\u7406\u81f3\u5173\u91cd\u8981\u3002\u9996\u5148\uff0c\u4f18\u5148\u5236\u4f5c\u9ad8\u9700\u6c42\u7684\u6b66\u5668\uff0c\u5b83\u4eec\u4f1a\u4ea7\u751f\u66f4\u591a\u7684\u91d1\u5e01\u3002\u4f8b\u5982\uff0c\u5236\u4f5c\u4e00\u628a\u5251\u901a\u5e38\u6bd4\u5236\u4f5c\u4e00\u628a\u5315\u9996\u7684\u56de\u62a5\u66f4\u597d\u3002\u6b65\u9aa4\u4e00\uff1a\u521d\u671f\u9636\u6bb5\u4e13\u6ce8\u4e8e\u6536\u96c6\u6750\u6599\u3002\u6b65\u9aa4\u4e8c\uff1a\u5c06\u8d44\u6e90\u5206\u914d\u7ed9\u5236\u4f5c\u9700\u6c42\u91cf\u9ad8\u7684\u6b66\u5668\u3002\u6b65\u9aa4\u4e09\uff1a\u5c06\u6536\u76ca\u518d\u6295\u8d44\u4e8e\u5347\u7ea7\u4f60\u7684\u7194\u7089\u548c\u5de5\u5177\uff0c\u4ee5\u63d0\u9ad8\u751f\u4ea7\u529b\u3002\u4f7f\u7528\u6d41\u7a0b\u56fe\u6765\u8ddf\u8e2a\u8d44\u6e90\u5206\u914d\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u6548\u7387\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u5728\u300a\u94c1\u5320\u300b\u6e38\u620f\u4e2d\u5347\u7ea7\u7194\u7089\u5f88\u91cd\u8981\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\uff1f", "answer": "\u5728\u300a\u94c1\u5320\u300b\u4e2d\u5347\u7ea7\u7194\u7089\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u76f4\u63a5\u5f71\u54cd\u6b66\u5668\u5236\u4f5c\u7684\u8d28\u91cf\u548c\u901f\u5ea6\u3002\u66f4\u9ad8\u7b49\u7ea7\u7684\u7194\u7089\u53ef\u4ee5\u5236\u4f5c\u51fa\u66f4\u9ad8\u54c1\u8d28\u7684\u6b66\u5668\uff0c\u8fd9\u4e9b\u6b66\u5668\u53ef\u4ee5\u5356\u5230\u66f4\u9ad8\u7684\u4ef7\u683c\u3002\u4f8b\u5982\uff0c\u5347\u7ea7\u5230\u4e09\u7ea7\u7194\u7089\u53ef\u4ee5\u5236\u4f5c\u51fa\u6df1\u53d7\u73a9\u5bb6\u6b22\u8fce\u7684\u9644\u9b54\u5251\u3002\u6b65\u9aa4\u4e00\uff1a\u4ece\u521d\u59cb\u9500\u552e\u4e2d\u8282\u7701\u91d1\u5e01\u3002\u6b65\u9aa4\u4e8c\uff1a\u5c3d\u5feb\u6295\u8d44\u4e8e\u7194\u7089\u5347\u7ea7\u3002\u6b65\u9aa4\u4e09\uff1a\u6301\u7eed\u5347\u7ea7\u4ee5\u89e3\u9501\u9ad8\u7ea7\u7684\u5236\u4f5c\u9009\u9879\u3002\u4e00\u4e2a\u5bf9\u6bd4\u7194\u7089\u7b49\u7ea7\u53ca\u5176\u597d\u5904\u7684\u914d\u7f6e\u8868\u53ef\u4ee5\u5e2e\u52a9\u4f60\u505a\u51fa\u660e\u667a\u7684\u51b3\u7b56\u3002"}, {"question": "\u300a\u94c1\u5320\u300b\u6e38\u620f\u4e2d\u5236\u4f5c\u6b66\u5668\u548c\u76d4\u7532\u7684\u5173\u952e\u533a\u522b\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300a\u94c1\u5320\u300b\u4e2d\uff0c\u5236\u4f5c\u6b66\u5668\u548c\u76d4\u7532\u7684\u76ee\u7684\u4e0d\u540c\uff0c\u9700\u8981\u4e0d\u540c\u7684\u7b56\u7565\u3002\u6b66\u5668\u4e3b\u8981\u7528\u4e8e\u5b8c\u6210\u8ba2\u5355\u548c\u8d5a\u53d6\u91d1\u5e01\uff0c\u800c\u76d4\u7532\u901a\u5e38\u7528\u4e8e\u589e\u5f3a\u73a9\u5bb6\u5728\u7279\u5b9a\u6311\u6218\u4e2d\u7684\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u5236\u4f5c\u4e00\u9762\u76fe\u724c\u53ef\u4ee5\u5728\u6218\u6597\u573a\u666f\u4e2d\u63d0\u4f9b\u989d\u5916\u7684\u9632\u5fa1\u3002\u6b65\u9aa4\u4e00\uff1a\u786e\u5b9a\u5f53\u524d\u6b66\u5668\u548c\u76d4\u7532\u7684\u9700\u6c42\u91cf\u3002\u6b65\u9aa4\u4e8c\uff1a\u6839\u636e\u5373\u65f6\u9700\u6c42\u548c\u957f\u671f\u76ee\u6807\u5206\u914d\u8d44\u6e90\u3002\u6b65\u9aa4\u4e09\uff1a\u5728\u4e24\u8005\u4e4b\u95f4\u5e73\u8861\u5236\u4f5c\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u6574\u4f53\u6548\u7387\u3002\u4e00\u4e2a\u591a\u65b9\u6848\u5bf9\u6bd4\u56fe\u8868\u53ef\u4ee5\u5e2e\u52a9\u786e\u5b9a\u6700\u4f73\u65b9\u6cd5\u3002"}, {"question": "\u54ea\u4e9b\u9ad8\u7ea7\u7b56\u7565\u53ef\u4ee5\u5e2e\u52a9\u73a9\u5bb6\u5728\u300a\u94c1\u5320\u300b\u4e2d\u6700\u5927\u5316\u4ed6\u4eec\u7684\u6536\u76ca\uff1f", "answer": "\u4e3a\u4e86\u5728\u300a\u94c1\u5320\u300b\u4e2d\u6700\u5927\u5316\u6536\u76ca\uff0c\u73a9\u5bb6\u5e94\u8be5\u4e13\u6ce8\u4e8e\u9ad8\u7ea7\u7b56\u7565\uff0c\u4f8b\u5982\u6279\u91cf\u5236\u4f5c\u548c\u4f18\u5316\u4f9b\u5e94\u94fe\u3002\u4f8b\u5982\uff0c\u5728\u4e00\u4e2a\u56de\u5408\u4e2d\u5236\u4f5c\u591a\u628a\u5251\u53ef\u4ee5\u7531\u4e8e\u51cf\u5c11\u51c6\u5907\u65f6\u95f4\u800c\u5e26\u6765\u66f4\u9ad8\u7684\u5229\u6da6\u3002\u6b65\u9aa4\u4e00\uff1a\u5206\u6790\u4e0d\u540c\u6b66\u5668\u7684\u5e02\u573a\u9700\u6c42\u3002\u6b65\u9aa4\u4e8c\uff1a\u4e3a\u9ad8\u9700\u6c42\u7269\u54c1\u5b89\u6392\u6279\u91cf\u5236\u4f5c\u65f6\u95f4\u3002\u6b65\u9aa4\u4e09\uff1a\u7b80\u5316\u6750\u6599\u6536\u96c6\u8fc7\u7a0b\uff0c\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u505c\u673a\u65f6\u95f4\u3002\u7528\u4e00\u4e2a\u6bd4\u55bb\uff0c\u628a\u4f60\u7684\u7194\u7089\u60f3\u8c61\u6210\u4e00\u4e2a\u5de5\u5382\uff0c\u6548\u7387\u7b49\u4e8e\u5229\u6da6\u3002"}, {"question": "\u6750\u6599\u8d28\u91cf\u5982\u4f55\u5f71\u54cd\u300a\u94c1\u5320\u300b\u4e2d\u7684\u6700\u7ec8\u4ea7\u54c1\uff1f", "answer": "\u5728\u300a\u94c1\u5320\u300b\u4e2d\uff0c\u6750\u6599\u8d28\u91cf\u4f1a\u663e\u8457\u5f71\u54cd\u6700\u7ec8\u4ea7\u54c1\u7684\u4ef7\u503c\u548c\u6709\u6548\u6027\u3002\u66f4\u9ad8\u54c1\u8d28\u7684\u6750\u6599\u4f1a\u4ea7\u751f\u66f4\u9ad8\u54c1\u8d28\u7684\u6b66\u5668\uff0c\u8fd9\u4e9b\u6b66\u5668\u7684\u552e\u4ef7\u66f4\u9ad8\u3002\u4f8b\u5982\uff0c\u7528\u7cbe\u91d1\u4ee3\u66ff\u94c1\u6765\u5236\u4f5c\u4e00\u628a\u5251\uff0c\u53ef\u4ee5\u4f7f\u5b83\u7684\u552e\u4ef7\u7ffb\u500d\u3002\u6b65\u9aa4\u4e00\uff1a\u4ece\u4e00\u5f00\u59cb\u5c31\u4f18\u5148\u6536\u96c6\u9ad8\u8d28\u91cf\u7684\u6750\u6599\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u8fd9\u4e9b\u6750\u6599\u5236\u4f5c\u9ad8\u9700\u6c42\u6b66\u5668\u3002\u6b65\u9aa4\u4e09\uff1a\u6301\u7eed\u5bfb\u627e\u66f4\u597d\u7684\u6750\u6599\u6765\u63d0\u5347\u4f60\u7684\u4ea7\u54c1\u7cfb\u5217\u3002\u4e00\u4e2a\u8be6\u7ec6\u8bf4\u660e\u6750\u6599\u8d28\u91cf\u53ca\u5176\u5f71\u54cd\u7684\u914d\u7f6e\u8868\u53ef\u4ee5\u6307\u5bfc\u4f60\u7684\u5236\u4f5c\u51b3\u7b56\u3002"}, {"question": "\u300a\u94c1\u5320\u300b\u6e38\u620f\u4e2d\u5e93\u5b58\u7ba1\u7406\u7684\u6700\u4f73\u5b9e\u8df5\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u94c1\u5320\u300b\u6e38\u620f\u4e2d\u6709\u6548\u7684\u5e93\u5b58\u7ba1\u7406\u5305\u62ec\u5e73\u8861\u6750\u6599\u50a8\u5b58\u4e0e\u5236\u4f5c\u9700\u6c42\u3002\u4f8b\u5982\uff0c\u50a8\u5b58\u94c1\u548c\u6728\u6750\u53ef\u4ee5\u786e\u4fdd\u4f60\u53ef\u4ee5\u5728\u6ca1\u6709\u5ef6\u8fdf\u7684\u60c5\u51b5\u4e0b\u5236\u4f5c\u57fa\u672c\u7684\u6b66\u5668\u3002\u6b65\u9aa4\u4e00\uff1a\u5b9a\u671f\u8bc4\u4f30\u4f60\u7684\u6750\u6599\u5e93\u5b58\u3002\u6b65\u9aa4\u4e8c\uff1a\u51fa\u552e\u591a\u4f59\u7684\u6750\u6599\u6216\u5236\u4f5c\u591a\u4f59\u7684\u7269\u54c1\u4ee5\u817e\u51fa\u7a7a\u95f4\u3002\u6b65\u9aa4\u4e09\uff1a\u6295\u8d44\u4e8e\u5e93\u5b58\u5347\u7ea7\u4ee5\u589e\u52a0\u50a8\u5b58\u5bb9\u91cf\u3002\u4e00\u4e2a\u8bf4\u660e\u5e93\u5b58\u7ba1\u7406\u6b65\u9aa4\u7684\u6d41\u7a0b\u56fe\u53ef\u4ee5\u5e2e\u52a9\u4f60\u7ef4\u6301\u4e00\u4e2a\u9ad8\u6548\u7684\u7cfb\u7edf\u3002"}, {"question": "\u300a\u94c1\u5320\u300b\u6e38\u620f\u4e2d\u7684\u5236\u4f5c\u7cfb\u7edf\u5982\u4f55\u5904\u7406\u73a9\u5bb6\u7684\u8fdb\u5ea6\uff1f", "answer": "\u300a\u94c1\u5320\u300b\u6e38\u620f\u4e2d\u7684\u5236\u4f5c\u7cfb\u7edf\u65e8\u5728\u968f\u7740\u73a9\u5bb6\u7684\u8fdb\u6b65\u800c\u63d0\u5347\uff0c\u968f\u7740\u73a9\u5bb6\u7684\u8fdb\u6b65\uff0c\u5b83\u4f1a\u63d0\u4f9b\u66f4\u590d\u6742\u548c\u66f4\u6709\u56de\u62a5\u7684\u914d\u65b9\u3002\u4f8b\u5982\uff0c\u65e9\u671f\u73a9\u5bb6\u5236\u4f5c\u7b80\u5355\u7684\u5315\u9996\uff0c\u800c\u9ad8\u7ea7\u73a9\u5bb6\u53ef\u4ee5\u5236\u4f5c\u9644\u9b54\u6b66\u5668\u3002\u6b65\u9aa4\u4e00\uff1a\u4ece\u57fa\u672c\u7684\u914d\u65b9\u5f00\u59cb\uff0c\u5efa\u7acb\u57fa\u7840\u6280\u80fd\u3002\u6b65\u9aa4\u4e8c\uff1a\u9010\u6b65\u63a5\u53d7\u66f4\u590d\u6742\u7684\u5236\u4f5c\u6311\u6218\u3002\u6b65\u9aa4\u4e09\uff1a\u5229\u7528\u9ad8\u7ea7\u5de5\u5177\u548c\u6750\u6599\u5236\u4f5c\u9ad8\u4ef7\u503c\u7269\u54c1\u3002\u4e00\u4e2a\u5c06\u5236\u4f5c\u590d\u6742\u5ea6\u6620\u5c04\u5230\u73a9\u5bb6\u7b49\u7ea7\u7684\u8fdb\u5ea6\u56fe\u8868\u53ef\u4ee5\u63d0\u4f9b\u6e05\u6670\u7684\u8def\u7ebf\u56fe\u3002"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728\u300a\u94c1\u5320\u300b\u4e2d\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "\u300a\u94c1\u5320\u300b\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u589e\u52a0\u4e86\u6e38\u620f\u73a9\u6cd5\u7684\u6df1\u5ea6\u3002\u4f8b\u5982\uff0c\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u5b8c\u6210\u7279\u5b9a\u4efb\u52a1\u5e8f\u5217\u6765\u627e\u5230\u4f20\u8bf4\u6b66\u5668\u7684\u79d8\u5bc6\u914d\u65b9\u3002\u6b65\u9aa4\u4e00\uff1a\u5f7b\u5e95\u63a2\u7d22\u6e38\u620f\u4e16\u754c\u7684\u6240\u6709\u533a\u57df\u3002\u6b65\u9aa4\u4e8c\uff1a\u6ce8\u610f\u73af\u5883\u4e2d\u7684\u5fae\u5999\u63d0\u793a\u548c\u7ebf\u7d22\u3002\u6b65\u9aa4\u4e09\uff1a\u5c1d\u8bd5\u4e0d\u540c\u7684\u5236\u4f5c\u7ec4\u5408\uff0c\u4ee5\u53d1\u73b0\u9690\u85cf\u7684\u914d\u65b9\u3002\u4e00\u4e2a\u8be6\u7ec6\u6807\u6ce8\u6f5c\u5728\u5f69\u86cb\u4f4d\u7f6e\u7684\u5730\u56fe\u53ef\u4ee5\u589e\u5f3a\u53d1\u73b0\u4f53\u9a8c\u3002"}, {"question": "\u300a\u94c1\u5320\u300b\u5982\u4f55\u786e\u4fdd\u4e0d\u540c\u5e73\u53f0\u7684\u517c\u5bb9\u6027\uff1f", "answer": "\u300a\u94c1\u5320\u300b\u901a\u8fc7\u4f7f\u7528\u4e00\u4e2a\u7edf\u4e00\u7684\u6e38\u620f\u5f15\u64ce\u6765\u786e\u4fdd\u8de8\u4e0d\u540c\u5e73\u53f0\u7684\u517c\u5bb9\u6027\uff0c\u8be5\u5f15\u64ce\u4f1a\u9002\u5e94\u5404\u79cd\u786c\u4ef6\u89c4\u683c\u3002\u4f8b\u5982\uff0c\u6e38\u620f\u4f1a\u81ea\u52a8\u8c03\u6574\u56fe\u5f62\u8bbe\u7f6e\uff0c\u4ee5\u4fdd\u6301\u5728\u9ad8\u7aef PC \u548c\u79fb\u52a8\u8bbe\u5907\u4e0a\u7684\u6027\u80fd\u3002\u6b65\u9aa4\u4e00\uff1a\u4f7f\u7528\u8de8\u5e73\u53f0\u5f15\u64ce\u5f00\u53d1\u6e38\u620f\u3002\u6b65\u9aa4\u4e8c\uff1a\u5b9e\u65bd\u81ea\u9002\u5e94\u8bbe\u7f6e\uff0c\u4ee5\u8fce\u5408\u4e0d\u540c\u7684\u8bbe\u5907\u3002\u6b65\u9aa4\u4e09\uff1a\u5b9a\u671f\u66f4\u65b0\u6e38\u620f\uff0c\u4ee5\u4f18\u5316\u6240\u6709\u5e73\u53f0\u4e0a\u7684\u6027\u80fd\u3002\u4e00\u4e2a\u5bf9\u6bd4\u5e73\u53f0\u7279\u5b9a\u8bbe\u7f6e\u7684\u914d\u7f6e\u8868\u53ef\u4ee5\u5e2e\u52a9\u73a9\u5bb6\u4e86\u89e3\u8fd9\u4e9b\u9002\u5e94\u6027\u3002"}, {"question": "\u5728 PC \u4e0a\u6d41\u7545\u8fd0\u884c\u300a\u94c1\u5320\u300b\u7684\u7cfb\u7edf\u8981\u6c42\u662f\u4ec0\u4e48\uff1f", "answer": "\u8981\u5728 PC \u4e0a\u6d41\u7545\u8fd0\u884c\u300a\u94c1\u5320\u300b\uff0c\u7cfb\u7edf\u5fc5\u987b\u6ee1\u8db3\u7279\u5b9a\u8981\u6c42\u3002\u4f8b\u5982\uff0c\u53cc\u6838\u5904\u7406\u5668\u548c 4GB \u5185\u5b58\u8db3\u4ee5\u8fdb\u884c\u57fa\u672c\u6e38\u620f\uff0c\u4f46\u56db\u6838\u5904\u7406\u5668\u548c 8GB \u5185\u5b58\u5bf9\u4e8e\u6700\u4f73\u6027\u80fd\u662f\u63a8\u8350\u7684\u3002\u6b65\u9aa4\u4e00\uff1a\u68c0\u67e5\u6700\u4f4e\u548c\u63a8\u8350\u7684\u7cfb\u7edf\u8981\u6c42\u3002\u6b65\u9aa4\u4e8c\uff1a\u786e\u4fdd\u4f60\u7684 PC \u6ee1\u8db3\u6216\u8d85\u8fc7\u8fd9\u4e9b\u89c4\u683c\u3002\u6b65\u9aa4\u4e09\uff1a\u8c03\u6574\u6e38\u620f\u5185\u8bbe\u7f6e\uff0c\u4ee5\u5e73\u8861\u6027\u80fd\u548c\u89c6\u89c9\u8d28\u91cf\u3002\u4e00\u4e2a\u6bd4\u8f83\u7cfb\u7edf\u8981\u6c42\u53ca\u5176\u5bf9\u6e38\u620f\u73a9\u6cd5\u5f71\u54cd\u7684\u5bf9\u6bd4\u8868\u53ef\u4ee5\u6307\u5bfc\u8bbe\u7f6e\u51b3\u7b56\u3002"}]
[{"question": "\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306fJacksmith\u3067\u30ea\u30bd\u30fc\u30b9\u3092\u52b9\u7387\u7684\u306b\u7ba1\u7406\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Jacksmith\u3067\u306f\u3001\u52b9\u7387\u7684\u306a\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u304c\u91cd\u8981\u3067\u3059\u3002\u307e\u305a\u3001\u3088\u308a\u591a\u304f\u306e\u30b3\u30a4\u30f3\u3092\u7372\u5f97\u3059\u308b\u9ad8\u9700\u8981\u306e\u6b66\u5668\u306e\u4f5c\u6210\u3092\u512a\u5148\u3059\u308b\u3053\u3068\u304b\u3089\u59cb\u3081\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5263\u3092\u4f5c\u6210\u3059\u308b\u3053\u3068\u306f\u3001\u77ed\u5263\u3088\u308a\u3082\u826f\u3044\u30ea\u30bf\u30fc\u30f3\u3092\u5f97\u308b\u3053\u3068\u304c\u3088\u304f\u3042\u308a\u307e\u3059\u3002STEP1\uff1a\u521d\u671f\u6bb5\u968e\u3067\u306f\u3001\u6750\u6599\u306e\u53ce\u96c6\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002STEP2\uff1a\u9ad8\u9700\u8981\u306e\u6b66\u5668\u3092\u4f5c\u6210\u3059\u308b\u305f\u3081\u306b\u30ea\u30bd\u30fc\u30b9\u3092\u5272\u308a\u5f53\u3066\u307e\u3059\u3002STEP3\uff1a\u53ce\u76ca\u3092\u518d\u6295\u8cc7\u3057\u3066\u3001\u935b\u51b6\u5834\u3084\u5de5\u5177\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u3001\u751f\u7523\u6027\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002\u30ea\u30bd\u30fc\u30b9\u306e\u5272\u308a\u5f53\u3066\u3092\u8ffd\u8de1\u3059\u308b\u305f\u3081\u306e\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u52b9\u7387\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002"}, {"question": "Jacksmith\u3067\u935b\u51b6\u5834\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u304b\uff1f", "answer": "Jacksmith\u3067\u935b\u51b6\u5834\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3053\u3068\u306f\u3001\u6b66\u5668\u306e\u4f5c\u6210\u306e\u8cea\u3068\u901f\u5ea6\u306b\u76f4\u63a5\u5f71\u97ff\u3059\u308b\u305f\u3081\u3001\u91cd\u8981\u3067\u3059\u3002\u30ec\u30d9\u30eb\u306e\u9ad8\u3044\u935b\u51b6\u5834\u3067\u3001\u3088\u308a\u512a\u308c\u305f\u6b66\u5668\u3092\u4f5c\u6210\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u3001\u3088\u308a\u591a\u304f\u306e\u30b3\u30a4\u30f3\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb3\u306e\u935b\u51b6\u5834\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3068\u3001\u975e\u5e38\u306b\u4eba\u6c17\u306e\u3042\u308b\u9b54\u6cd5\u306e\u5263\u3092\u4f5c\u6210\u3067\u304d\u307e\u3059\u3002STEP1\uff1a\u521d\u671f\u306e\u8ca9\u58f2\u304b\u3089\u30b3\u30a4\u30f3\u3092\u7bc0\u7d04\u3057\u307e\u3059\u3002STEP2\uff1a\u3067\u304d\u308b\u3060\u3051\u65e9\u304f\u935b\u51b6\u5834\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u6295\u8cc7\u3057\u307e\u3059\u3002STEP3\uff1a\u7d99\u7d9a\u7684\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u3066\u3001\u9ad8\u5ea6\u306a\u30af\u30e9\u30d5\u30c8\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u307e\u3059\u3002\u935b\u51b6\u5834\u306e\u30ec\u30d9\u30eb\u3068\u305d\u306e\u5229\u70b9\u3092\u6bd4\u8f03\u3059\u308b\u69cb\u6210\u8868\u306f\u3001\u610f\u601d\u6c7a\u5b9a\u3092\u30b5\u30dd\u30fc\u30c8\u3067\u304d\u307e\u3059\u3002"}, {"question": "Jacksmith\u3067\u6b66\u5668\u3068\u9632\u5177\u3092\u4f5c\u6210\u3059\u308b\u969b\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Jacksmith\u3067\u6b66\u5668\u3068\u9632\u5177\u3092\u4f5c\u6210\u3059\u308b\u3053\u3068\u306f\u3001\u7570\u306a\u308b\u76ee\u7684\u3092\u679c\u305f\u3057\u3001\u7570\u306a\u308b\u6226\u7565\u3092\u5fc5\u8981\u3068\u3057\u307e\u3059\u3002\u6b66\u5668\u306f\u4e3b\u306b\u6ce8\u6587\u3092\u6e80\u305f\u3057\u3001\u30b3\u30a4\u30f3\u3092\u7372\u5f97\u3059\u308b\u305f\u3081\u306b\u4f7f\u7528\u3055\u308c\u307e\u3059\u304c\u3001\u9632\u5177\u306f\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u80fd\u529b\u3092\u7279\u5b9a\u306e\u8ab2\u984c\u3067\u5f37\u5316\u3059\u308b\u305f\u3081\u306b\u4f7f\u7528\u3055\u308c\u308b\u3053\u3068\u304c\u3088\u304f\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u76fe\u3092\u4f5c\u6210\u3059\u308b\u3068\u3001\u6226\u95d8\u30b7\u30ca\u30ea\u30aa\u3067\u8ffd\u52a0\u306e\u9632\u5fa1\u529b\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002STEP1\uff1a\u73fe\u5728\u306e\u6b66\u5668\u3068\u9632\u5177\u306e\u9700\u8981\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002STEP2\uff1a\u76f4\u3061\u306e\u30cb\u30fc\u30ba\u3068\u9577\u671f\u7684\u306a\u76ee\u6a19\u306b\u57fa\u3065\u3044\u3066\u30ea\u30bd\u30fc\u30b9\u3092\u5272\u308a\u5f53\u3066\u307e\u3059\u3002STEP3\uff1a\u5168\u4f53\u7684\u306a\u52b9\u7387\u3092\u6700\u5927\u5316\u3059\u308b\u305f\u3081\u306b\u3001\u4e21\u65b9\u306e\u30af\u30e9\u30d5\u30c8\u3092\u30d0\u30e9\u30f3\u30b9\u3055\u305b\u307e\u3059\u3002\u30de\u30eb\u30c1\u30b9\u30ad\u30fc\u30e0\u6bd4\u8f03\u30c1\u30e3\u30fc\u30c8\u306f\u3001\u6700\u9069\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u3092\u6c7a\u5b9a\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "Jacksmith\u3067\u53ce\u76ca\u3092\u6700\u5927\u5316\u3059\u308b\u305f\u3081\u306b\u5f79\u7acb\u3064\u9ad8\u5ea6\u306a\u6226\u7565\u306f\u3069\u308c\u3067\u3059\u304b\uff1f", "answer": "Jacksmith\u3067\u53ce\u76ca\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u5927\u91cf\u30af\u30e9\u30d5\u30c8\u3084\u30b5\u30d7\u30e9\u30a4\u30c1\u30a7\u30fc\u30f3\u306e\u6700\u9069\u5316\u306a\u3069\u306e\u9ad8\u5ea6\u306a\u6226\u7565\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u4e00\u5ea6\u306b\u8907\u6570\u306e\u5263\u3092\u4f5c\u6210\u3059\u308b\u3068\u3001\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7\u6642\u9593\u304c\u77ed\u7e2e\u3055\u308c\u308b\u305f\u3081\u3001\u3088\u308a\u9ad8\u3044\u5229\u76ca\u306b\u3064\u306a\u304c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002STEP1\uff1a\u3055\u307e\u3056\u307e\u306a\u6b66\u5668\u306e\u5e02\u5834\u9700\u8981\u3092\u5206\u6790\u3057\u307e\u3059\u3002STEP2\uff1a\u9ad8\u9700\u8981\u306e\u30a2\u30a4\u30c6\u30e0\u306b\u3064\u3044\u3066\u306f\u3001\u5927\u91cf\u30af\u30e9\u30d5\u30c8\u30bb\u30c3\u30b7\u30e7\u30f3\u3092\u30b9\u30b1\u30b8\u30e5\u30fc\u30eb\u3057\u307e\u3059\u3002STEP3\uff1a\u30c0\u30a6\u30f3\u30bf\u30a4\u30e0\u3092\u6700\u5c0f\u9650\u306b\u3059\u308b\u305f\u3081\u306b\u3001\u6750\u6599\u306e\u53ce\u96c6\u30d7\u30ed\u30bb\u30b9\u3092\u5408\u7406\u5316\u3057\u307e\u3059\u3002\u6bd4\u55a9\u7684\u306b\u8a00\u3048\u3070\u3001\u935b\u51b6\u5834\u3092\u52b9\u7387\u304c\u5229\u76ca\u306b\u7b49\u3057\u3044\u5de5\u5834\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u6750\u6599\u306e\u54c1\u8cea\u306f\u3001Jacksmith\u3067\u306e\u6700\u7d42\u88fd\u54c1\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "Jacksmith\u3067\u306f\u3001\u6750\u6599\u306e\u54c1\u8cea\u306f\u6700\u7d42\u88fd\u54c1\u306e\u4fa1\u5024\u3068\u6709\u52b9\u6027\u306b\u5927\u304d\u304f\u5f71\u97ff\u3057\u307e\u3059\u3002\u3088\u308a\u9ad8\u54c1\u8cea\u306e\u6750\u6599\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u3088\u308a\u512a\u308c\u305f\u6b66\u5668\u304c\u4f5c\u6210\u3055\u308c\u3001\u3088\u308a\u9ad8\u3044\u4fa1\u683c\u3067\u58f2\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5263\u306b\u9244\u306e\u4ee3\u308f\u308a\u306b\u30df\u30b5\u30a4\u30eb\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u8ca9\u58f2\u4fa1\u683c\u306f2\u500d\u306b\u306a\u308a\u307e\u3059\u3002STEP1\uff1a\u6700\u521d\u304b\u3089\u9ad8\u54c1\u8cea\u306e\u6750\u6599\u3092\u53ce\u96c6\u3059\u308b\u3053\u3068\u3092\u512a\u5148\u3057\u307e\u3059\u3002STEP2\uff1a\u3053\u308c\u3089\u306e\u6750\u6599\u3092\u4f7f\u7528\u3057\u3066\u3001\u9ad8\u9700\u8981\u306e\u6b66\u5668\u3092\u4f5c\u6210\u3057\u307e\u3059\u3002STEP3\uff1a\u88fd\u54c1\u30e9\u30a4\u30f3\u3092\u5f37\u5316\u3059\u308b\u305f\u3081\u306b\u3001\u3088\u308a\u826f\u3044\u6750\u6599\u3092\u7d99\u7d9a\u7684\u306b\u63a2\u3057\u307e\u3059\u3002\u6750\u6599\u306e\u54c1\u8cea\u3068\u305d\u306e\u5f71\u97ff\u3092\u8a73\u7d30\u306b\u793a\u3059\u69cb\u6210\u8868\u306f\u3001\u30af\u30e9\u30d5\u30c8\u306e\u610f\u601d\u6c7a\u5b9a\u3092\u30ac\u30a4\u30c9\u3067\u304d\u307e\u3059\u3002"}, {"question": "Jacksmith\u3067\u306e\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u7ba1\u7406\u306e\u30d9\u30b9\u30c8\u30d7\u30e9\u30af\u30c6\u30a3\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Jacksmith\u3067\u306e\u52b9\u679c\u7684\u306a\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u7ba1\u7406\u306f\u3001\u6750\u6599\u306e\u4fdd\u7ba1\u3068\u30af\u30e9\u30d5\u30c8\u306e\u30cb\u30fc\u30ba\u3092\u30d0\u30e9\u30f3\u30b9\u3055\u305b\u308b\u3053\u3068\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u9244\u3068\u6728\u6750\u306e\u8caf\u8535\u3092\u7dad\u6301\u3059\u308b\u3053\u3068\u3067\u3001\u6b66\u5668\u3092\u4f5c\u6210\u3059\u308b\u969b\u306b\u9045\u5ef6\u304c\u767a\u751f\u3059\u308b\u306e\u3092\u9632\u3050\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002STEP1\uff1a\u5b9a\u671f\u7684\u306b\u6750\u6599\u306e\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u3092\u8a55\u4fa1\u3057\u307e\u3059\u3002STEP2\uff1a\u4f59\u5270\u306e\u6750\u6599\u3092\u58f2\u5374\u3057\u305f\u308a\u3001\u4f59\u5270\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u4f5c\u6210\u3057\u305f\u308a\u3057\u3066\u3001\u30b9\u30da\u30fc\u30b9\u3092\u7a7a\u3051\u307e\u3059\u3002STEP3\uff1a\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u306e\u5bb9\u91cf\u3092\u5897\u3084\u3059\u305f\u3081\u306b\u3001\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u6295\u8cc7\u3057\u307e\u3059\u3002\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u7ba1\u7406\u624b\u9806\u3092\u793a\u3059\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u306f\u3001\u52b9\u7387\u7684\u306a\u30b7\u30b9\u30c6\u30e0\u3092\u7dad\u6301\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "Jacksmith\u306e\u30af\u30e9\u30d5\u30c8\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u9032\u884c\u72b6\u6cc1\u3092\u3069\u306e\u3088\u3046\u306b\u51e6\u7406\u3057\u307e\u3059\u304b\uff1f", "answer": "Jacksmith\u306e\u30af\u30e9\u30d5\u30c8\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u9032\u884c\u72b6\u6cc1\u306b\u5408\u308f\u305b\u3066\u8abf\u6574\u3059\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u304a\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u9032\u3080\u306b\u3064\u308c\u3066\u3001\u3088\u308a\u8907\u96d1\u3067\u5831\u916c\u306e\u591a\u3044\u30ec\u30b7\u30d4\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u521d\u671f\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u5358\u7d14\u306a\u77ed\u5263\u3092\u4f5c\u6210\u3057\u307e\u3059\u304c\u3001\u4e0a\u7d1a\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u9b54\u6cd5\u306e\u6b66\u5668\u3092\u4f5c\u6210\u3067\u304d\u307e\u3059\u3002STEP1\uff1a\u57fa\u672c\u7684\u306a\u30ec\u30b7\u30d4\u304b\u3089\u59cb\u3081\u3066\u3001\u57fa\u790e\u30b9\u30ad\u30eb\u3092\u69cb\u7bc9\u3057\u307e\u3059\u3002STEP2\uff1a\u5f90\u3005\u306b\u3088\u308a\u8907\u96d1\u306a\u30af\u30e9\u30d5\u30c8\u306e\u8ab2\u984c\u306b\u53d6\u308a\u7d44\u3080\u3002STEP3\uff1a\u9ad8\u5ea6\u306a\u30c4\u30fc\u30eb\u3068\u6750\u6599\u3092\u4f7f\u7528\u3057\u3066\u3001\u9ad8\u4fa1\u5024\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u4f5c\u6210\u3057\u307e\u3059\u3002\u30af\u30e9\u30d5\u30c8\u306e\u8907\u96d1\u3055\u3092\u30d7\u30ec\u30fc\u30e4\u30fc\u30ec\u30d9\u30eb\u306b\u5bfe\u5fdc\u3055\u305b\u305f\u9032\u884c\u8868\u306f\u3001\u660e\u78ba\u306a\u30ed\u30fc\u30c9\u30de\u30c3\u30d7\u3092\u63d0\u4f9b\u3067\u304d\u307e\u3059\u3002"}, {"question": "Jacksmith\u3067\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u3088\u3046\u306a\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Jacksmith\u306b\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u6df1\u307f\u3092\u52a0\u3048\u308b\u3001\u3044\u304f\u3064\u304b\u306e\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3068\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u7279\u5b9a\u306e\u30bf\u30b9\u30af\u306e\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3067\u3001\u4f1d\u8aac\u306e\u6b66\u5668\u306e\u79d8\u5bc6\u306e\u30ec\u30b7\u30d4\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002STEP1\uff1a\u30b2\u30fc\u30e0\u4e16\u754c\u306e\u3059\u3079\u3066\u306e\u9818\u57df\u3092\u5fb9\u5e95\u7684\u306b\u8abf\u67fb\u3057\u307e\u3059\u3002STEP2\uff1a\u74b0\u5883\u306b\u304a\u3051\u308b\u5fae\u5999\u306a\u30d2\u30f3\u30c8\u3084\u624b\u304c\u304b\u308a\u306b\u6ce8\u610f\u3092\u6255\u3044\u307e\u3059\u3002STEP3\uff1a\u3055\u307e\u3056\u307e\u306a\u30af\u30e9\u30d5\u30c8\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u8a66\u3057\u3066\u3001\u96a0\u3055\u308c\u305f\u30ec\u30b7\u30d4\u3092\u767a\u898b\u3057\u307e\u3059\u3002\u6f5c\u5728\u7684\u306a\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306e\u4f4d\u7f6e\u3092\u793a\u3059\u8a73\u7d30\u306a\u30de\u30c3\u30d7\u306f\u3001\u767a\u898b\u4f53\u9a13\u3092\u5f37\u5316\u3067\u304d\u307e\u3059\u3002"}, {"question": "Jacksmith\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u306e\u4e92\u63db\u6027\u3092\u3069\u306e\u3088\u3046\u306b\u4fdd\u8a3c\u3057\u3066\u3044\u307e\u3059\u304b\uff1f", "answer": "Jacksmith\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u30cf\u30fc\u30c9\u30a6\u30a7\u30a2\u4ed5\u69d8\u306b\u5408\u308f\u305b\u3066\u8abf\u6574\u3059\u308b\u7d71\u4e00\u3055\u308c\u305f\u30b2\u30fc\u30e0\u30a8\u30f3\u30b8\u30f3\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u3055\u307e\u3056\u307e\u306a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u306e\u4e92\u63db\u6027\u3092\u4fdd\u8a3c\u3057\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30b2\u30fc\u30e0\u306f\u3001\u9ad8\u6027\u80fd\u306ePC\u3068\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u306e\u4e21\u65b9\u3067\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u3001\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3092\u81ea\u52d5\u7684\u306b\u8abf\u6574\u3057\u307e\u3059\u3002STEP1\uff1a\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30a8\u30f3\u30b8\u30f3\u3092\u4f7f\u7528\u3057\u3066\u30b2\u30fc\u30e0\u3092\u958b\u767a\u3057\u307e\u3059\u3002STEP2\uff1a\u3055\u307e\u3056\u307e\u306a\u30c7\u30d0\u30a4\u30b9\u306b\u5bfe\u5fdc\u3059\u308b\u305f\u3081\u306e\u9069\u5fdc\u8a2d\u5b9a\u3092\u5b9f\u88c5\u3057\u307e\u3059\u3002STEP3\uff1a\u3059\u3079\u3066\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u305f\u3081\u306b\u3001\u30b2\u30fc\u30e0\u3092\u5b9a\u671f\u7684\u306b\u66f4\u65b0\u3057\u307e\u3059\u3002\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u56fa\u6709\u306e\u8a2d\u5b9a\u3092\u6bd4\u8f03\u3059\u308b\u69cb\u6210\u8868\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u9069\u5fdc\u3092\u7406\u89e3\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "PC\u3067Jacksmith\u3092\u30b9\u30e0\u30fc\u30ba\u306b\u5b9f\u884c\u3059\u308b\u305f\u3081\u306e\u30b7\u30b9\u30c6\u30e0\u8981\u4ef6\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "PC\u3067Jacksmith\u3092\u30b9\u30e0\u30fc\u30ba\u306b\u5b9f\u884c\u3059\u308b\u306b\u306f\u3001\u30b7\u30b9\u30c6\u30e0\u304c\u7279\u5b9a\u306e\u8981\u4ef6\u3092\u6e80\u305f\u3057\u3066\u3044\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30c7\u30e5\u30a2\u30eb\u30b3\u30a2\u30d7\u30ed\u30bb\u30c3\u30b5\u30684GB\u306eRAM\u306f\u57fa\u672c\u7684\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u5341\u5206\u3067\u3059\u304c\u3001\u6700\u9069\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5f97\u308b\u305f\u3081\u306b\u306f\u3001\u30af\u30a2\u30c3\u30c9\u30b3\u30a2\u30d7\u30ed\u30bb\u30c3\u30b5\u30688GB\u306eRAM\u304c\u63a8\u5968\u3055\u308c\u307e\u3059\u3002STEP1\uff1a\u6700\u5c0f\u9650\u3068\u63a8\u5968\u3055\u308c\u308b\u30b7\u30b9\u30c6\u30e0\u8981\u4ef6\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002STEP2\uff1aPC\u304c\u3053\u308c\u3089\u306e\u4ed5\u69d8\u3092\u6e80\u305f\u3057\u3066\u3044\u308b\u304b\u3001\u305d\u308c\u4ee5\u4e0a\u3067\u3042\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002STEP3\uff1a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3068\u8996\u899a\u54c1\u8cea\u3092\u30d0\u30e9\u30f3\u30b9\u3055\u305b\u308b\u305f\u3081\u306b\u3001\u30b2\u30fc\u30e0\u8a2d\u5b9a\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u30b7\u30b9\u30c6\u30e0\u8981\u4ef6\u3068\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3078\u306e\u5f71\u97ff\u3092\u6bd4\u8f03\u3059\u308b\u6bd4\u8f03\u8868\u306f\u3001\u8a2d\u5b9a\u306e\u6c7a\u5b9a\u3092\u30ac\u30a4\u30c9\u3067\u304d\u307e\u3059\u3002"}]
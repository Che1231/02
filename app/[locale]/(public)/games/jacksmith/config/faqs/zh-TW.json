[{"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u9435\u5320\u300b\u4e2d\u6709\u6548\u5730\u7ba1\u7406\u8cc7\u6e90\uff1f", "answer": "\u5728\u300a\u9435\u5320\u300b\u4e2d\uff0c\u6709\u6548\u7684\u8cc7\u6e90\u7ba1\u7406\u81f3\u95dc\u91cd\u8981\u3002\u9996\u5148\uff0c\u512a\u5148\u6253\u9020\u9ad8\u9700\u6c42\u6b66\u5668\uff0c\u9019\u4e9b\u6b66\u5668\u53ef\u4ee5\u7522\u751f\u66f4\u591a\u91d1\u5e63\u3002\u4f8b\u5982\uff0c\u935b\u9020\u4e00\u628a\u528d\u901a\u5e38\u6bd4\u5315\u9996\u80fd\u5e36\u4f86\u66f4\u597d\u7684\u56de\u5831\u3002\u6b65\u9a5f1\uff1a\u5728\u904a\u6232\u521d\u671f\u6ce8\u91cd\u6536\u96c6\u6750\u6599\u3002\u6b65\u9a5f2\uff1a\u5c07\u8cc7\u6e90\u5206\u914d\u7d66\u6253\u9020\u9ad8\u9700\u6c42\u6b66\u5668\u3002\u6b65\u9a5f3\uff1a\u5c07\u6536\u76ca\u91cd\u65b0\u6295\u8cc7\u65bc\u5347\u7d1a\u4f60\u7684\u935b\u9020\u7210\u548c\u5de5\u5177\uff0c\u4ee5\u63d0\u9ad8\u751f\u7522\u529b\u3002\u4f7f\u7528\u6d41\u7a0b\u5716\u4f86\u8ffd\u8e64\u8cc7\u6e90\u5206\u914d\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u6548\u7387\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u5728\u300a\u9435\u5320\u300b\u4e2d\u5347\u7d1a\u935b\u9020\u7210\u5f88\u91cd\u8981\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff1f", "answer": "\u5728\u300a\u9435\u5320\u300b\u4e2d\u5347\u7d1a\u935b\u9020\u7210\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u76f4\u63a5\u5f71\u97ff\u6b66\u5668\u7684\u54c1\u8cea\u548c\u935b\u9020\u901f\u5ea6\u3002\u66f4\u9ad8\u968e\u7684\u935b\u9020\u7210\u53ef\u4ee5\u6253\u9020\u51fa\u66f4\u512a\u826f\u7684\u6b66\u5668\uff0c\u9019\u4e9b\u6b66\u5668\u53ef\u4ee5\u8ce3\u5230\u66f4\u591a\u91d1\u5e63\u3002\u4f8b\u5982\uff0c\u5347\u7d1a\u5230\u4e09\u7d1a\u935b\u9020\u7210\u53ef\u4ee5\u935b\u9020\u51fa\u88ab\u65bd\u52a0\u9b54\u6cd5\u7684\u528d\uff0c\u9019\u985e\u528d\u975e\u5e38\u6436\u624b\u3002\u6b65\u9a5f1\uff1a\u5f9e\u6700\u521d\u7684\u92b7\u552e\u4e2d\u5132\u84c4\u91d1\u5e63\u3002\u6b65\u9a5f2\uff1a\u5118\u5feb\u6295\u8cc7\u65bc\u935b\u9020\u7210\u7684\u5347\u7d1a\u3002\u6b65\u9a5f3\uff1a\u6301\u7e8c\u5347\u7d1a\u4ee5\u89e3\u9396\u9ad8\u7d1a\u935b\u9020\u9078\u9805\u3002\u6bd4\u8f03\u935b\u9020\u7210\u7b49\u7d1a\u53ca\u5176\u597d\u8655\u7684\u914d\u7f6e\u8868\uff0c\u53ef\u4ee5\u5e6b\u52a9\u60a8\u505a\u51fa\u660e\u667a\u7684\u6c7a\u7b56\u3002"}, {"question": "\u5728\u300a\u9435\u5320\u300b\u4e2d\uff0c\u6253\u9020\u6b66\u5668\u548c\u76d4\u7532\u6709\u4ec0\u9ebc\u95dc\u9375\u5dee\u7570\uff1f", "answer": "\u5728\u300a\u9435\u5320\u300b\u4e2d\uff0c\u6253\u9020\u6b66\u5668\u548c\u76d4\u7532\u7684\u76ee\u7684\u4e0d\u540c\uff0c\u4e5f\u9700\u8981\u4e0d\u540c\u7684\u7b56\u7565\u3002\u6b66\u5668\u4e3b\u8981\u7528\u65bc\u5b8c\u6210\u8a02\u55ae\u548c\u8cfa\u53d6\u91d1\u5e63\uff0c\u800c\u76d4\u7532\u901a\u5e38\u7528\u65bc\u589e\u5f37\u73a9\u5bb6\u5728\u7279\u5b9a\u6311\u6230\u4e2d\u7684\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u6253\u9020\u4e00\u584a\u76fe\u724c\u53ef\u4ee5\u5728\u6230\u9b25\u60c5\u5883\u4e2d\u63d0\u4f9b\u984d\u5916\u7684\u9632\u79a6\u3002\u6b65\u9a5f1\uff1a\u8b58\u5225\u7576\u524d\u6b66\u5668\u8207\u76d4\u7532\u7684\u9700\u6c42\u3002\u6b65\u9a5f2\uff1a\u6839\u64da\u7576\u52d9\u4e4b\u6025\u548c\u9577\u671f\u76ee\u6a19\u5206\u914d\u8cc7\u6e90\u3002\u6b65\u9a5f3\uff1a\u5728\u96d9\u65b9\u6253\u9020\u4e4b\u9593\u53d6\u5f97\u5e73\u8861\uff0c\u4ee5\u6700\u5927\u5316\u6574\u9ad4\u6548\u7387\u3002\u591a\u65b9\u6848\u6bd4\u8f03\u5716\u8868\u53ef\u4ee5\u5e6b\u52a9\u78ba\u5b9a\u6700\u4f73\u65b9\u6cd5\u3002"}, {"question": "\u54ea\u4e9b\u5148\u9032\u7b56\u7565\u53ef\u4ee5\u5e6b\u52a9\u73a9\u5bb6\u5728\u300a\u9435\u5320\u300b\u4e2d\u6700\u5927\u5316\u6536\u76ca\uff1f", "answer": "\u70ba\u4e86\u5728\u300a\u9435\u5320\u300b\u4e2d\u6700\u5927\u5316\u6536\u76ca\uff0c\u73a9\u5bb6\u61c9\u8a72\u5c08\u6ce8\u65bc\u5148\u9032\u7b56\u7565\uff0c\u4f8b\u5982\u6279\u91cf\u6253\u9020\u548c\u512a\u5316\u4f9b\u61c9\u93c8\u3002\u4f8b\u5982\uff0c\u5728\u4e00\u6b21\u935b\u9020\u904e\u7a0b\u4e2d\u6253\u9020\u591a\u628a\u528d\uff0c\u7531\u65bc\u7e2e\u77ed\u4e86\u6e96\u5099\u6642\u9593\uff0c\u53ef\u4ee5\u5e36\u4f86\u66f4\u9ad8\u7684\u5229\u6f64\u3002\u6b65\u9a5f1\uff1a\u5206\u6790\u4e0d\u540c\u6b66\u5668\u7684\u5e02\u5834\u9700\u6c42\u3002\u6b65\u9a5f2\uff1a\u70ba\u9ad8\u9700\u6c42\u7269\u54c1\u5b89\u6392\u6279\u91cf\u935b\u9020\u6642\u9593\u3002\u6b65\u9a5f3\uff1a\u7c21\u5316\u6750\u6599\u6536\u96c6\u904e\u7a0b\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u6e1b\u5c11\u505c\u6a5f\u6642\u9593\u3002\u7528\u96b1\u55bb\u4f86\u8aaa\uff0c\u628a\u4f60\u7684\u935b\u9020\u7210\u60f3\u50cf\u6210\u4e00\u500b\u5de5\u5ee0\uff0c\u6548\u7387\u7b49\u65bc\u5229\u6f64\u3002"}, {"question": "\u6750\u6599\u54c1\u8cea\u5982\u4f55\u5f71\u97ff\u300a\u9435\u5320\u300b\u4e2d\u7684\u6700\u7d42\u7522\u54c1\uff1f", "answer": "\u5728\u300a\u9435\u5320\u300b\u4e2d\uff0c\u6750\u6599\u54c1\u8cea\u986f\u8457\u5f71\u97ff\u6700\u7d42\u7522\u54c1\u7684\u50f9\u503c\u548c\u6548\u80fd\u3002\u66f4\u9ad8\u54c1\u8cea\u7684\u6750\u6599\u6703\u7522\u751f\u66f4\u512a\u826f\u7684\u6b66\u5668\uff0c\u4e26\u80fd\u53d6\u5f97\u66f4\u9ad8\u7684\u50f9\u683c\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u7cbe\u91d1\u88fd\u4f5c\u528d\uff0c\u800c\u4e0d\u662f\u9435\uff0c\u53ef\u4ee5\u5c07\u5176\u92b7\u552e\u50f9\u683c\u7ffb\u500d\u3002\u6b65\u9a5f1\uff1a\u5f9e\u4e00\u958b\u59cb\u5c31\u512a\u5148\u6536\u96c6\u9ad8\u54c1\u8cea\u6750\u6599\u3002\u6b65\u9a5f2\uff1a\u5c07\u9019\u4e9b\u6750\u6599\u7528\u65bc\u6253\u9020\u9ad8\u9700\u6c42\u6b66\u5668\u3002\u6b65\u9a5f3\uff1a\u4e0d\u65b7\u5c0b\u627e\u66f4\u597d\u7684\u6750\u6599\u4f86\u63d0\u5347\u4f60\u7684\u7522\u54c1\u7dda\u3002\u95dc\u65bc\u6750\u6599\u8cea\u91cf\u53ca\u5176\u6548\u679c\u7684\u914d\u7f6e\u8868\u53ef\u4ee5\u6307\u5c0e\u4f60\u7684\u935b\u9020\u6c7a\u7b56\u3002"}, {"question": "\u300a\u9435\u5320\u300b\u4e2d\u5eab\u5b58\u7ba1\u7406\u7684\u6700\u4f73\u5be6\u52d9\u662f\u4ec0\u9ebc\uff1f", "answer": "\u300a\u9435\u5320\u300b\u4e2d\u6709\u6548\u7684\u5eab\u5b58\u7ba1\u7406\u5305\u62ec\u5e73\u8861\u6750\u6599\u5132\u5b58\u8207\u935b\u9020\u9700\u6c42\u3002\u4f8b\u5982\uff0c\u4fdd\u6301\u9435\u548c\u6728\u6750\u7684\u5132\u5099\u53ef\u4ee5\u78ba\u4fdd\u4f60\u53ef\u4ee5\u5728\u6c92\u6709\u5ef6\u9072\u7684\u60c5\u6cc1\u4e0b\u935b\u9020\u57fa\u672c\u6b66\u5668\u3002\u6b65\u9a5f1\uff1a\u5b9a\u671f\u8a55\u4f30\u4f60\u7684\u6750\u6599\u5eab\u5b58\u3002\u6b65\u9a5f2\uff1a\u51fa\u552e\u591a\u9918\u6750\u6599\u6216\u6253\u9020\u591a\u9918\u7269\u54c1\u4ee5\u9a30\u51fa\u7a7a\u9593\u3002\u6b65\u9a5f3\uff1a\u6295\u8cc7\u5eab\u5b58\u5347\u7d1a\u4ee5\u589e\u52a0\u5132\u5b58\u5bb9\u91cf\u3002\u8aaa\u660e\u5eab\u5b58\u7ba1\u7406\u6b65\u9a5f\u7684\u6d41\u7a0b\u5716\u6709\u52a9\u65bc\u7dad\u6301\u9ad8\u6548\u7684\u7cfb\u7d71\u3002"}, {"question": "\u904a\u6232\u5728\u300a\u9435\u5320\u300b\u4e2d\u7684\u935b\u9020\u7cfb\u7d71\u662f\u5982\u4f55\u8655\u7406\u73a9\u5bb6\u9032\u5c55\u7684\uff1f", "answer": "\u300a\u9435\u5320\u300b\u4e2d\u7684\u935b\u9020\u7cfb\u7d71\u65e8\u5728\u96a8\u8457\u73a9\u5bb6\u9032\u5c55\u800c\u8abf\u6574\uff0c\u96a8\u8457\u73a9\u5bb6\u7684\u63d0\u5347\uff0c\u6703\u63d0\u4f9b\u66f4\u8907\u96dc\u4e14\u66f4\u503c\u5f97\u56de\u5831\u7684\u914d\u65b9\u3002\u4f8b\u5982\uff0c\u65e9\u671f\u73a9\u5bb6\u935b\u9020\u7c21\u55ae\u7684\u5315\u9996\uff0c\u800c\u9ad8\u7d1a\u73a9\u5bb6\u5247\u53ef\u4ee5\u6253\u9020\u9644\u52a0\u9b54\u6cd5\u7684\u6b66\u5668\u3002\u6b65\u9a5f1\uff1a\u5f9e\u57fa\u672c\u914d\u65b9\u958b\u59cb\uff0c\u57f9\u990a\u57fa\u790e\u6280\u80fd\u3002\u6b65\u9a5f2\uff1a\u9010\u6b65\u63a5\u53d7\u66f4\u8907\u96dc\u7684\u935b\u9020\u6311\u6230\u3002\u6b65\u9a5f3\uff1a\u5229\u7528\u5148\u9032\u7684\u5de5\u5177\u548c\u6750\u6599\u6253\u9020\u9ad8\u50f9\u503c\u7269\u54c1\u3002\u986f\u793a\u935b\u9020\u8907\u96dc\u5ea6\u8207\u73a9\u5bb6\u7b49\u7d1a\u7684\u9032\u5c55\u5716\u8868\uff0c\u53ef\u4ee5\u63d0\u4f9b\u6e05\u6670\u7684\u8def\u7dda\u5716\u3002"}, {"question": "\u73a9\u5bb6\u5728\u300a\u9435\u5320\u300b\u4e2d\u53ef\u4ee5\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "\u300a\u9435\u5320\u300b\u5305\u542b\u4e00\u4e9b\u96b1\u85cf\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u9019\u4e9b\u529f\u80fd\u548c\u5f69\u86cb\u589e\u6dfb\u4e86\u904a\u6232\u7684\u6df1\u5ea6\u3002\u4f8b\u5982\uff0c\u73a9\u5bb6\u901a\u904e\u5b8c\u6210\u7279\u5b9a\u4efb\u52d9\u5e8f\u5217\uff0c\u53ef\u4ee5\u627e\u5230\u50b3\u5947\u6b66\u5668\u7684\u79d8\u5bc6\u914d\u65b9\u3002\u6b65\u9a5f1\uff1a\u5fb9\u5e95\u63a2\u7d22\u904a\u6232\u4e16\u754c\u7684\u6240\u6709\u5340\u57df\u3002\u6b65\u9a5f2\uff1a\u6ce8\u610f\u74b0\u5883\u4e2d\u7684\u7d30\u5fae\u63d0\u793a\u548c\u7dda\u7d22\u3002\u6b65\u9a5f3\uff1a\u5617\u8a66\u4e0d\u540c\u7684\u935b\u9020\u7d44\u5408\u4f86\u767c\u73fe\u96b1\u85cf\u914d\u65b9\u3002\u8a73\u7d30\u6a19\u793a\u6f5b\u5728\u5f69\u86cb\u4f4d\u7f6e\u7684\u5730\u5716\uff0c\u53ef\u4ee5\u63d0\u5347\u767c\u73fe\u9ad4\u9a57\u3002"}, {"question": "\u300a\u9435\u5320\u300b\u5982\u4f55\u78ba\u4fdd\u4e0d\u540c\u5e73\u53f0\u7684\u76f8\u5bb9\u6027\uff1f", "answer": "\u300a\u9435\u5320\u300b\u901a\u904e\u4f7f\u7528\u7d71\u4e00\u7684\u904a\u6232\u5f15\u64ce\u4f86\u78ba\u4fdd\u4e0d\u540c\u5e73\u53f0\u7684\u76f8\u5bb9\u6027\uff0c\u8a72\u5f15\u64ce\u6703\u9069\u61c9\u5404\u7a2e\u786c\u9ad4\u898f\u683c\u3002\u4f8b\u5982\uff0c\u904a\u6232\u6703\u81ea\u52d5\u8abf\u6574\u5716\u5f62\u8a2d\u5b9a\uff0c\u4ee5\u4fdd\u6301\u5728\u9ad8\u7aef\u96fb\u8166\u548c\u884c\u52d5\u88dd\u7f6e\u4e0a\u7684\u6548\u80fd\u3002\u6b65\u9a5f1\uff1a\u4f7f\u7528\u8de8\u5e73\u53f0\u5f15\u64ce\u958b\u767c\u904a\u6232\u3002\u6b65\u9a5f2\uff1a\u5be6\u65bd\u81ea\u9069\u61c9\u8a2d\u5b9a\uff0c\u4ee5\u6eff\u8db3\u4e0d\u540c\u88dd\u7f6e\u7684\u9700\u6c42\u3002\u6b65\u9a5f3\uff1a\u5b9a\u671f\u66f4\u65b0\u904a\u6232\u4ee5\u512a\u5316\u6240\u6709\u5e73\u53f0\u4e0a\u7684\u6548\u80fd\u3002\u6bd4\u8f03\u7279\u5b9a\u5e73\u53f0\u8a2d\u5b9a\u7684\u914d\u7f6e\u8868\uff0c\u53ef\u4ee5\u5e6b\u52a9\u73a9\u5bb6\u4e86\u89e3\u9069\u61c9\u6027\u3002"}, {"question": "\u5728\u96fb\u8166\u4e0a\u9806\u5229\u904b\u884c\u300a\u9435\u5320\u300b\u7684\u7cfb\u7d71\u9700\u6c42\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u96fb\u8166\u4e0a\u9806\u5229\u904b\u884c\u300a\u9435\u5320\u300b\uff0c\u7cfb\u7d71\u5fc5\u9808\u6eff\u8db3\u7279\u5b9a\u7684\u9700\u6c42\u3002\u4f8b\u5982\uff0c\u96d9\u6838\u8655\u7406\u5668\u548c 4GB \u8a18\u61b6\u9ad4\u8db3\u4ee5\u9032\u884c\u57fa\u672c\u904a\u6232\uff0c\u4f46\u5efa\u8b70\u4f7f\u7528\u56db\u6838\u8655\u7406\u5668\u548c 8GB \u8a18\u61b6\u9ad4\u4ee5\u7372\u5f97\u6700\u4f73\u6548\u80fd\u3002\u6b65\u9a5f1\uff1a\u6aa2\u67e5\u6700\u4f4e\u548c\u63a8\u85a6\u7684\u7cfb\u7d71\u9700\u6c42\u3002\u6b65\u9a5f2\uff1a\u78ba\u4fdd\u60a8\u7684\u96fb\u8166\u7b26\u5408\u6216\u8d85\u904e\u9019\u4e9b\u898f\u683c\u3002\u6b65\u9a5f3\uff1a\u8abf\u6574\u904a\u6232\u8a2d\u5b9a\uff0c\u4ee5\u5e73\u8861\u6548\u80fd\u548c\u8996\u89ba\u54c1\u8cea\u3002\u7cfb\u7d71\u9700\u6c42\u53ca\u5176\u5c0d\u904a\u6232\u73a9\u6cd5\u5f71\u97ff\u7684\u6bd4\u8f03\u8868\uff0c\u53ef\u4ee5\u6307\u5c0e\u8a2d\u5b9a\u6c7a\u7b56\u3002"}]
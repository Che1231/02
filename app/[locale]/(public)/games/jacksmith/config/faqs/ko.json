[{"question": "\uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 Jacksmith\uc5d0\uc11c \uc790\uc6d0\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Jacksmith\uc5d0\uc11c \ud6a8\uc728\uc801\uc778 \uc790\uc6d0 \uad00\ub9ac\uac00 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc6b0\uc120 \uc218\uc694\uac00 \ub192\uc740 \ubb34\uae30\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \uc81c\uc791\ud558\ub294 \uac83\uc73c\ub85c \uc2dc\uc791\ud558\uc2ed\uc2dc\uc624. \uc774\ub294 \ub354 \ub9ce\uc740 \ucf54\uc778\uc744 \uc5bb\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac80\uc744 \uc81c\uc791\ud558\ub294 \uac83\uc774 \ub2e8\uac80\ubcf4\ub2e4 \ub354 \ub098\uc740 \uc218\uc775\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub2e8\uacc41: \ucd08\uae30 \ub2e8\uacc4\uc5d0\uc11c \uc790\uc6d0\uc744 \uc218\uc9d1\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc42: \uc218\uc694\uac00 \ub192\uc740 \ubb34\uae30\ub97c \uc81c\uc791\ud558\ub294 \ub370 \uc790\uc6d0\uc744 \ud560\ub2f9\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc43: \uc218\uc775\uc744 \uc7ac\ud22c\uc790\ud558\uc5ec \uc81c\ub828\uc18c \ubc0f \ub3c4\uad6c\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc5ec \uc0dd\uc0b0\uc131\uc744 \ub192\uc774\uc2ed\uc2dc\uc624. \uc790\uc6d0 \ubc30\ubd84\uc744 \ucd94\uc801\ud558\uae30 \uc704\ud55c \ud50c\ub85c\uc6b0\ucc28\ud2b8\ub97c \uc0ac\uc6a9\ud558\uba74 \ud6a8\uc728\uc131\uc744 \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Jacksmith\uc5d0\uc11c \uc81c\ub828\uc18c\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uac8c\uc784\ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "Jacksmith\uc5d0\uc11c \uc81c\ub828\uc18c\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \uac83\uc740 \ubb34\uae30 \uc81c\uc791\uc758 \ud488\uc9c8\uacfc \uc18d\ub3c4\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \ub354 \ub192\uc740 \ub808\ubca8\uc758 \uc81c\ub828\uc18c\ub294 \ub354 \uc6b0\uc218\ud55c \ubb34\uae30\ub97c \ub9cc\ub4e4 \uc218 \uc788\uc73c\uba70, \uc774\ub294 \ub354 \ub9ce\uc740 \ucf54\uc778\uc73c\ub85c \ud310\ub9e4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 3\ub808\ubca8 \uc81c\ub828\uc18c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uba74 \ub9e4\ud639\uc801\uc778 \uac80\uc744 \uc81c\uc791\ud560 \uc218 \uc788\uc73c\uba70, \uc774\ub294 \ub9e4\uc6b0 \uc778\uae30\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc41: \ucd08\uae30 \ud310\ub9e4\uc5d0\uc11c \ucf54\uc778\uc744 \uc800\ucd95\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc42: \uac00\ub2a5\ud55c \ud55c \ube68\ub9ac \uc81c\ub828\uc18c \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0 \ud22c\uc790\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc43: \uace0\uae09 \uc81c\uc791 \uc635\uc158\uc744 \uc7a0\uae08 \ud574\uc81c\ud558\uae30 \uc704\ud574 \uc9c0\uc18d\uc801\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc2ed\uc2dc\uc624. \uc81c\ub828\uc18c \ub808\ubca8\uacfc \uadf8 \uc774\uc810\uc744 \ube44\uad50\ud558\ub294 \uad6c\uc131\ud45c\ub294 \uc815\ubcf4\uc5d0 \uc785\uac01\ud55c \uacb0\uc815\uc744 \ub0b4\ub9ac\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Jacksmith\uc5d0\uc11c \ubb34\uae30\uc640 \uac11\uc637 \uc81c\uc791\uc758 \ud575\uc2ec\uc801\uc778 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Jacksmith\uc5d0\uc11c \ubb34\uae30\uc640 \uac11\uc637 \uc81c\uc791\uc740 \uc11c\ub85c \ub2e4\ub978 \ubaa9\uc801\uc744 \uac00\uc9c0\uace0 \uc788\uc73c\uba70 \uc11c\ub85c \ub2e4\ub978 \uc804\ub7b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ubb34\uae30\ub294 \uc8fc\ub85c \uc8fc\ubb38\uc744 \uc218\ud589\ud558\uace0 \ucf54\uc778\uc744 \ubc8c\uc774\uae30 \uc704\ud574 \uc0ac\uc6a9\ub418\ub294 \ubc18\uba74, \uac11\uc637\uc740 \ud2b9\uc815 \ucc4c\ub9b0\uc9c0\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uc758 \ub2a5\ub825\uc744 \uac15\ud654\ud558\ub294 \ub370 \uc790\uc8fc \uc0ac\uc6a9\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubc29\ud328\ub97c \uc81c\uc791\ud558\uba74 \uc804\ud22c \uc0c1\ud669\uc5d0\uc11c \ucd94\uac00\uc801\uc778 \ubc29\uc5b4\ub825\uc744 \uc81c\uacf5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc41: \ud604\uc7ac \ubb34\uae30\uc640 \uac11\uc637\uc5d0 \ub300\ud55c \uc218\uc694\ub97c \ud30c\uc545\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc42: \uc989\uac01\uc801\uc778 \ud544\uc694\uc640 \uc7a5\uae30\uc801\uc778 \ubaa9\ud45c\uc5d0 \ub530\ub77c \uc790\uc6d0\uc744 \ud560\ub2f9\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc43: \ucd5c\ub300 \ud6a8\uc728\uc744 \ucc3d\ucd9c\ud558\uae30 \uc704\ud574 \ub458 \ub2e4 \uc81c\uc791\uc758 \uade0\ud615\uc744 \ub9de\ucdb0\uc57c \ud569\ub2c8\ub2e4. \ub2e4\uc911 \uc2a4\ud0a4\ub9c8 \ube44\uad50 \ucc28\ud2b8\ub294 \uac00\uc7a5 \uc88b\uc740 \uc811\uadfc \ubc29\uc2dd\uc744 \uacb0\uc815\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Jacksmith\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 \uc218\uc775\uc744 \uadf9\ub300\ud654\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ub294 \uace0\uae09 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Jacksmith\uc5d0\uc11c \uc218\uc775\uc744 \uadf9\ub300\ud654\ud558\ub824\uba74 \ub300\ub7c9 \uc81c\uc791 \ubc0f \uacf5\uae09\ub9dd \ucd5c\uc801\ud654\uc640 \uac19\uc740 \uace0\uae09 \uc804\ub7b5\uc5d0 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud55c \ubc88\uc5d0 \uc5ec\ub7ec \uac1c\uc758 \uac80\uc744 \uc81c\uc791\ud558\uba74 \uc124\uc815 \uc2dc\uac04\uc774 \uc904\uc5b4\ub4e4\uae30 \ub54c\ubb38\uc5d0 \ub354 \ub192\uc740 \uc218\uc775\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc41: \ub2e4\uc591\ud55c \ubb34\uae30\uc758 \uc2dc\uc7a5 \uc218\uc694\ub97c \ubd84\uc11d\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc42: \uace0\uc218\uc694 \ud488\ubaa9\uc5d0 \ub300\ud55c \ub300\ub7c9 \uc81c\uc791 \uc138\uc158\uc744 \uacc4\ud68d\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc43: \uc791\uc5c5 \uc911\ub2e8 \uc2dc\uac04\uc744 \ucd5c\uc18c\ud654\ud558\uae30 \uc704\ud574 \uc790\uc7ac \uc218\uc9d1 \uacfc\uc815\uc744 \uac04\uc18c\ud654\ud558\uc2ed\uc2dc\uc624. \uc740\uc720\uc801\uc73c\ub85c \ub9d0\ud574\uc11c, \uc81c\ub828\uc18c\ub97c \ud6a8\uc728\uc131\uc774 \uc774\uc775\uacfc \uac19\uc740 \uacf5\uc7a5\uc73c\ub85c \uc0dd\uac01\ud574 \ubcf4\uc2ed\uc2dc\uc624."}, {"question": "Jacksmith\uc5d0\uc11c \uc790\uc7ac \ud488\uc9c8\uc774 \ucd5c\uc885 \uc81c\ud488\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "Jacksmith\uc5d0\uc11c \uc790\uc7ac \ud488\uc9c8\uc740 \ucd5c\uc885 \uc81c\ud488\uc758 \uac00\uce58\uc640 \ud6a8\uacfc\uc5d0 \uc0c1\ub2f9\ud55c \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ub354 \ub192\uc740 \ud488\uc9c8\uc758 \uc790\uc7ac\ub294 \ub354 \uc6b0\uc218\ud55c \ubb34\uae30\ub97c \ub9cc\ub4e4\uc5b4 \ub354 \ub192\uc740 \uac00\uaca9\uc5d0 \ud310\ub9e4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac80\uc5d0 \ucca0 \ub300\uc2e0 \ubbf8\uc2a4\ub9b4\uc744 \uc0ac\uc6a9\ud558\uba74 \ud310\ub9e4 \uac00\uaca9\uc774 \ub450 \ubc30\ub85c \ub298\uc5b4\ub0a0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc41: \ucc98\uc74c\ubd80\ud130 \uace0\ud488\uc9c8 \uc790\uc7ac\ub97c \ud655\ubcf4\ud558\ub294 \ub370 \uc6b0\uc120\uc21c\uc704\ub97c \ub450\uc2ed\uc2dc\uc624. \ub2e8\uacc42: \uc774 \uc790\uc7ac\ub97c \uc218\uc694\uac00 \ub192\uc740 \ubb34\uae30\ub97c \uc81c\uc791\ud558\ub294 \ub370 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc43: \uc81c\ud488 \ub77c\uc778\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uae30 \uc704\ud574 \uc9c0\uc18d\uc801\uc73c\ub85c \ub354 \ub098\uc740 \uc790\uc7ac\ub97c \ucc3e\uc73c\uc2ed\uc2dc\uc624. \uc790\uc7ac \ud488\uc9c8\uacfc \uadf8 \ud6a8\uacfc\ub97c \uc790\uc138\ud788 \uc124\uba85\ud55c \uad6c\uc131\ud45c\ub294 \uc81c\uc791 \uacb0\uc815\uc744 \ub0b4\ub9ac\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Jacksmith\uc5d0\uc11c \uc7ac\uace0 \uad00\ub9ac\ub97c \uc704\ud55c \ucd5c\uc0c1\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Jacksmith\uc5d0\uc11c \ud6a8\uacfc\uc801\uc778 \uc7ac\uace0 \uad00\ub9ac\uc5d0\ub294 \uc790\uc7ac \uc800\uc7a5\uacfc \uc81c\uc791 \ud544\uc694\uc131 \uac04\uc758 \uade0\ud615\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucca0\uacfc \ub098\ubb34\ub97c \uc800\uc7a5\ud574 \ub450\uba74 \uc9c0\uc5f0 \uc5c6\uc774 \uae30\ubcf8 \ubb34\uae30\ub97c \uc81c\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc41: \uc815\uae30\uc801\uc73c\ub85c \uc790\uc7ac \uc7ac\uace0\ub97c \ud3c9\uac00\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc42: \uc5ec\ubd84\uc758 \uc790\uc7ac\ub97c \ud310\ub9e4\ud558\uac70\ub098 \ucd08\uacfc\ub7c9\uc744 \uc81c\uc791\ud558\uc5ec \uacf5\uac04\uc744 \ud655\ubcf4\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc43: \uc800\uc7a5 \uc6a9\ub7c9\uc744 \ub298\ub9ac\uae30 \uc704\ud574 \uc7ac\uace0 \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0 \ud22c\uc790\ud558\uc2ed\uc2dc\uc624. \uc7ac\uace0 \uad00\ub9ac \ub2e8\uacc4\ub97c \uc124\uba85\ud558\ub294 \ud50c\ub85c\uc6b0\ucc28\ud2b8\ub294 \ud6a8\uc728\uc801\uc778 \uc2dc\uc2a4\ud15c\uc744 \uc720\uc9c0\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Jacksmith\uc758 \uac8c\uc784 \uc81c\uc791 \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \ucc98\ub9ac\ud569\ub2c8\uae4c?", "answer": "Jacksmith\uc758 \uc81c\uc791 \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uc758 \uc9c4\ud589 \uc0c1\ud669\uacfc \ud568\uaed8 \ud655\uc7a5\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5b4 \uc788\uc73c\uba70, \ud50c\ub808\uc774\uc5b4\uac00 \uc9c4\ud589\ub428\uc5d0 \ub530\ub77c \ub354 \ubcf5\uc7a1\ud558\uace0 \ubcf4\ub78c \uc788\ub294 \ub808\uc2dc\ud53c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucd08\ubcf4 \ud50c\ub808\uc774\uc5b4\ub294 \uac04\ub2e8\ud55c \ub2e8\uac80\uc744 \uc81c\uc791\ud558\ub294 \ubc18\uba74, \uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \ub9e4\ud639\uc801\uc778 \ubb34\uae30\ub97c \uc81c\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc41: \uae30\ucd08 \uae30\uc220\uc744 \uad6c\ucd95\ud558\uae30 \uc704\ud574 \uae30\ubcf8 \ub808\uc2dc\ud53c\ub85c \uc2dc\uc791\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc42: \uc810\ucc28\uc801\uc73c\ub85c \ub354 \ubcf5\uc7a1\ud55c \uc81c\uc791 \ucc4c\ub9b0\uc9c0\uc5d0 \ub3c4\uc804\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc43: \uace0\uae09 \ub3c4\uad6c \ubc0f \uc790\uc7ac\ub97c \uc0ac\uc6a9\ud558\uc5ec \uace0\uac00\uc758 \uc544\uc774\ud15c\uc744 \uc81c\uc791\ud558\uc2ed\uc2dc\uc624. \uc81c\uc791\uc758 \ubcf5\uc7a1\uc131\uc744 \ud50c\ub808\uc774\uc5b4 \ub808\ubca8\uc5d0 \ub9e4\ud551\ud558\ub294 \uc9c4\ud589\ub3c4 \ucc28\ud2b8\ub294 \uba85\ud655\ud55c \ub85c\ub4dc\ub9f5\uc744 \uc81c\uacf5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Jacksmith\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Jacksmith\uc5d0\ub294 \uac8c\uc784\ud50c\ub808\uc774\uc5d0 \uae4a\uc774\uac10\uc744 \ub354\ud558\ub294 \uc5ec\ub7ec \uac00\uc9c0 \uc228\uaca8\uc9c4 \uae30\ub2a5\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud50c\ub808\uc774\uc5b4\ub294 \ud2b9\uc815 \uc791\uc5c5 \uc21c\uc11c\ub97c \uc644\ub8cc\ud558\uc5ec \uc804\uc124\uc801\uc778 \ubb34\uae30\ub97c \uc81c\uc791\ud558\ub294 \ube44\ubc00 \ub808\uc2dc\ud53c\ub97c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc41: \uac8c\uc784 \uc138\uacc4\uc758 \ubaa8\ub4e0 \uc9c0\uc5ed\uc744 \ucca0\uc800\ud788 \ud0d0\uc0c9\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc42: \ud658\uacbd\uc5d0\uc11c \ubbf8\ubb18\ud55c \ud78c\ud2b8\uc640 \ub2e8\uc11c\uc5d0 \uc8fc\uc758\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc43: \ub2e4\uc591\ud55c \uc81c\uc791 \uc870\ud569\uc744 \uc2dc\ub3c4\ud558\uc5ec \uc228\uaca8\uc9c4 \ub808\uc2dc\ud53c\ub97c \ubc1c\uacac\ud558\uc2ed\uc2dc\uc624. \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8 \uc704\uce58\ub97c \uac15\uc870\ud558\ub294 \uc790\uc138\ud55c \uc9c0\ub3c4\ub294 \ubc1c\uacac \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Jacksmith\ub294 \ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc \uac04\uc758 \ud638\ud658\uc131\uc744 \uc5b4\ub5bb\uac8c \ubcf4\uc7a5\ud569\ub2c8\uae4c?", "answer": "Jacksmith\ub294 \ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc \uac04\uc758 \ud638\ud658\uc131\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 \ub2e4\uc591\ud55c \ud558\ub4dc\uc6e8\uc5b4 \uc0ac\uc591\uc5d0 \uc801\uc751\ud558\ub294 \ud1b5\ud569 \uac8c\uc784 \uc5d4\uc9c4\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac8c\uc784\uc740 \uace0\uc131\ub2a5 PC\uc640 \ubaa8\ubc14\uc77c \uae30\uae30 \ubaa8\ub450\uc5d0\uc11c \uc131\ub2a5\uc744 \uc720\uc9c0\ud558\uae30 \uc704\ud574 \uadf8\ub798\ud53d \uc124\uc815\uc744 \uc790\ub3d9\uc73c\ub85c \uc870\uc815\ud569\ub2c8\ub2e4. \ub2e8\uacc41: \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \uc5d4\uc9c4\uc744 \uc0ac\uc6a9\ud558\uc5ec \uac8c\uc784\uc744 \uac1c\ubc1c\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc42: \ub2e4\uc591\ud55c \uae30\uae30\uc5d0 \ub9de\uac8c \uc801\uc751\ud615 \uc124\uc815\uc744 \uad6c\ud604\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc43: \ubaa8\ub4e0 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\uae30 \uc704\ud574 \uac8c\uc784\uc744 \uc815\uae30\uc801\uc73c\ub85c \uc5c5\ub370\uc774\ud2b8\ud558\uc2ed\uc2dc\uc624. \ud50c\ub7ab\ud3fc\ubcc4 \uc124\uc815\uc744 \ube44\uad50\ud558\ub294 \uad6c\uc131\ud45c\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uc801\uc751\uc744 \uc774\ud574\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "PC\uc5d0\uc11c Jacksmith\ub97c \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ud558\uae30 \uc704\ud55c \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "PC\uc5d0\uc11c Jacksmith\ub97c \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ud558\ub824\uba74 \uc2dc\uc2a4\ud15c\uc774 \ud2b9\uc815 \uc694\uad6c \uc0ac\ud56d\uc744 \ucda9\uc871\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub4c0\uc5bc \ucf54\uc5b4 \ud504\ub85c\uc138\uc11c\uc640 4GB\uc758 RAM\uc740 \uae30\ubcf8 \uac8c\uc784\ud50c\ub808\uc774\uc5d0 \ucda9\ubd84\ud558\uc9c0\ub9cc, \ucffc\ub4dc \ucf54\uc5b4 \ud504\ub85c\uc138\uc11c\uc640 8GB\uc758 RAM\uc740 \ucd5c\uc801\uc758 \uc131\ub2a5\uc744 \uc704\ud574 \uad8c\uc7a5\ub429\ub2c8\ub2e4. \ub2e8\uacc41: \ucd5c\uc18c \ubc0f \uad8c\uc7a5 \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc744 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc42: PC\uac00 \uc774\ub7ec\ud55c \uc0ac\uc591\uc744 \ucda9\uc871\ud558\uac70\ub098 \ucd08\uacfc\ud558\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc43: \uac8c\uc784 \ub0b4 \uc124\uc815\uc744 \uc870\uc815\ud558\uc5ec \uc131\ub2a5\uacfc \uc2dc\uac01\uc801 \ud488\uc9c8\uc758 \uade0\ud615\uc744 \ub9de\ucd94\uc2ed\uc2dc\uc624. \uac8c\uc784\ud50c\ub808\uc774\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc744 \ubcf4\uc5ec\uc8fc\ub294 \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d \ube44\uad50 \ud45c\ub294 \uc124\uc815 \uacb0\uc815\uc744 \ub0b4\ub9ac\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
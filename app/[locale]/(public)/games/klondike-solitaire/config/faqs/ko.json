[{"question": "\ud074\ub860\ub2e4\uc774\ud06c \uc194\ub9ac\ud14c\uc5b4: \ucd08\ubcf4\uc790\ub85c\uc11c \uccab \ubc88\uc9f8 \ub3d9\uc791\uc744 \uc5b4\ub5bb\uac8c \uc218\ud589\ud558\uba70, \uc774 \ud074\ub798\uc2dd \uce74\ub4dc \uac8c\uc784\uc5d0\uc11c \uce74\ub4dc \uc774\ub3d9 \uaddc\uce59\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud074\ub860\ub2e4\uc774\ud06c \uc194\ub9ac\ud14c\uc5b4 \ucd08\ubcf4\uc790\ub85c\uc11c \uccab \ubc88\uc9f8 \ub3d9\uc791\uc740 \ud14c\uc774\ube14\ub85c\ubd80\ud130 \uce74\ub4dc\ub97c \ub4dc\ub7ec\ub0b4\ub294 \uac83\uc785\ub2c8\ub2e4. \uc6d0\ud558\ub294 \uc5f4\uc758 \ubaa8\ub4e0 \ub4b7\uba74 \uce74\ub4dc\ub97c \ud3bc\uce69\ub2c8\ub2e4. \uae30\ubcf8\uc801\uc778 \uaddc\uce59\uc740 \uc22b\uc790\uac00 \ud558\ub098 \ub192\uace0 \uc0c9\uae54\uc774 \ub2e4\ub978 \uce74\ub4dc \uc704\uc5d0 \uce74\ub4dc\ub97c \ub193\uc744 \uc218 \uc788\ub2e4\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac80\uc740\uc0c9 7 \uc704\uc5d0 \ube68\uac04\uc0c9 6\uc744 \ub193\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubaa9\ud45c\ub294 \ub354 \ub9ce\uc740 \ub4b7\uba74 \uce74\ub4dc\ub97c \ub4dc\ub7ec\ub0b4\uace0 \uacb0\uad6d \ubaa8\ub4e0 \uce74\ub4dc\ub97c \uae30\ubcf8 \uce74\ub4dc \ub354\ubbf8\uc5d0 \uc774\ub3d9\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uad6c\uccb4\uc801\uc73c\ub85c, \ube68\uac04\uc0c9 7 \uc704\uc5d0 \uac80\uc740\uc0c9 6\uc744 \ub193\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2dc\uac01\uc801 \uc548\ub0b4\ub294 \uac01 \uc5f4\uc758 \uc5f0\uc18d\uc801\uc778 \uce74\ub4dc\ub098 \uc774\uc5b4\uc9c0\ub294 \uce74\ub4dc \uc21c\uc11c\ub97c \ubcf4\uc5ec\uc90d\ub2c8\ub2e4."}, {"question": "\ud074\ub860\ub2e4\uc774\ud06c \uc194\ub9ac\ud14c\uc5b4\uc5d0\uc11c \uce74\ub4dc\ub97c \uc774\ub3d9\ud560 \uc218 \uc5c6\ub294 \uc774\uc720\uac00 \ubb34\uc5c7\uc774\uba70, \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub4e4\uc774 \ud558\ub294 \uc77c\ubc18\uc801\uc778 \uc2e4\uc218\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub54c\ub54c\ub85c \uce74\ub4dc\ub97c \uc774\ub3d9\ud560 \uc218 \uc5c6\ub294 \uc774\uc720\ub294 \uc774\uc804 \uc774\ub3d9\uc774 \uacf5\uac04\uc744 \ud655\ubcf4\ud558\uae30 \uc704\ud574 \ud544\uc694\ud558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \ub9ce\uc740 \ucd08\ubcf4 \ud50c\ub808\uc774\uc5b4\ub294 \uce74\ub4dc\uac00 \uae30\ubcf8 \ub354\ubbf8\ub85c \uc9c1\uc811 \uc774\ub3d9\ud560 \uc218 \uc788\ub2e4\uace0 \uc798\ubabb \uc0dd\uac01\ud569\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \ud14c\uc774\ube14\uc758 \uce74\ub4dc\ub294 \ub0b4\ub9bc\ucc28\uc21c\uc774\uace0 \uad50\ub300\ub85c \uc0c9\uc0c1\uc774 \ubc14\ub00c\uc5b4\uc57c \ud569\ub2c8\ub2e4. \ub300\uc0c1 \uce74\ub4dc\uac00 \uac00\ub824\uc838 \uc788\uc9c0 \uc54a\uc740\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uc77c\ubc18\uc801\uc778 \uc2e4\uc218\ub85c\ub294 \ud0b9\uc744 \ube44\uc5b4\uc788\ub294 \uc5f4\uc5d0 \uc0ac\uc6a9\ud558\uc9c0 \uc54a\uac70\ub098 \ud14c\uc774\ube14\uc5d0\uc11c \ucda9\ubd84\ud55c \uce74\ub4dc\ub97c \ub4dc\ub7ec\ub0b4\uc9c0 \uc54a\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac80\uc740\uc0c9 4 \uc704\uc5d0 \ube68\uac04\uc0c9 4\ub97c \ub193\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uc885\uc885 \ud574\uacb0\ucc45\uc740 \ub418\ub3cc\uc544\uac00\uc11c \uc804\ub7b5\uc744 \uc7ac\ud3c9\uac00\ud558\uace0 \uc911\uc694\ud55c \ub4b7\uba74 \uce74\ub4dc\ub97c \ub4dc\ub7ec\ub0b4\uba70 \uc0c8\ub85c\uc6b4 \uc774\ub3d9\uc744 \ud655\ubcf4\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \ud750\ub984\ub3c4\ub294 \uae30\ubcf8\uc774 \ud0b9\uc774\uc5b4\uc57c \ube44\uc5b4\uc788\ub294 \ud14c\uc774\ube14 \uc5f4\ub85c \uc21c\uc11c\ub97c \uc774\ub3d9\ud560 \uc218 \uc788\uc74c\uc744 \uac15\uc870\ud569\ub2c8\ub2e4."}, {"question": "\ud074\ub860\ub2e4\uc774\ud06c \uc194\ub9ac\ud14c\uc5b4\uc5d0\uc11c \uc2a4\ud0c1(\ub610\ub294 \ub4dc\ub85c \ub371)\uc758 \ubaa9\uc801\uc740 \ubb34\uc5c7\uc774\uba70, \uc2b9\uc0b0\uc744 \ub192\uc774\uae30 \uc704\ud574 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc2a4\ud0c1\uc740 \ud14c\uc774\ube14\uc5d0\uc11c \uc989\uc2dc \uc774\ub3d9\ud560 \uc218 \uc788\ub294 \ubc29\ubc95\uc774 \uc5c6\uc744 \ub54c \uce74\ub4dc\uc758 \ubcf4\uc870 \uc6d0\ucc9c\uc785\ub2c8\ub2e4. \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub824\uba74 \uce74\ub4dc\ub97c \ud55c \ubc88\uc5d0 \ud558\ub098\uc529 \ub4a4\uc9d1\uace0 \ubbf8\ub798 \uc774\ub3d9\uc5d0 \uc720\uc6a9\ud560 \uc218 \uc788\ub294 \uce74\ub4dc\ub97c \uae30\ub85d\ud569\ub2c8\ub2e4. \uce74\ub4dc\uac00 \ud14c\uc774\ube14\uc5d0 \ub9de\uc744 \uc218 \uc788\uac70\ub098 \uae30\ubcf8 \ub354\ubbf8\uc5d0 \uc801\ud569\ud560 \uc218 \uc788\ub294\uc9c0 \uace0\ub824\ud569\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \uc804\ub7b5\uc801 \uacc4\ud68d \uc5c6\uc774 \uc2a4\ud0c1\uc744 \ub9c8\uad6c \ub4a4\uc9d1\uc9c0 \ub9c8\uc2ed\uc2dc\uc624. \uae30\ud68c\ub97c \ub193\uce60 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4\ubcc4 \uc811\uadfc \ubc29\uc2dd\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: \ub2e8\uacc4 1 - \ud55c \uc7a5\uc758 \uce74\ub4dc\ub97c \ub4a4\uc9d1\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 2 - \uc774\uac83\uc774 \uc989\uc2dc \uc0ac\uc6a9 \uac00\ub2a5\ud55c\uc9c0 \ud3c9\uac00\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3 - \uadf8\ub807\uc9c0 \uc54a\uc73c\uba74 \ub098\uc911\uc744 \uc704\ud574 \uc218\ud2b8\uc640 \ub7ad\ud06c\ub97c \ucd94\uc801\ud569\ub2c8\ub2e4. \uac01 \uc5f4\uc5d0 \ud544\uc694\ud55c \uce74\ub4dc\uc758 \uc815\uc2e0 \uc9c0\ub3c4\ub97c \ub9cc\ub4dc\ub294 \uac83\uc744 \uace0\ub824\ud574\ubcf4\uc2ed\uc2dc\uc624."}, {"question": "\uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \uc9c8\ubb38: \uc2b9\ub960\uc744 \ub192\uc774\uae30 \uc704\ud55c \ud074\ub860\ub2e4\uc774\ud06c \uc194\ub9ac\ud14c\uc5b4\uc758 \uace0\uae09 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc774\uba70, \uce74\ub4dc \uad00\ub9ac\uc640 \uc804\uc220\uc801 \ud50c\ub808\uc774\uc5d0 \uc911\uc810\uc744 \ub461\ub2c8\ub2e4?", "answer": "\uace0\uae09 \ud074\ub860\ub2e4\uc774\ud06c \uc194\ub9ac\ud14c\uc5b4 \uc804\ub7b5\uc740 \ud6a8\uc728\uc801\uc778 \uce74\ub4dc \uad00\ub9ac\ub97c \uc911\uc2ec\uc73c\ub85c \ud569\ub2c8\ub2e4. \ud6a8\uacfc\uc801\uc778 \ud50c\ub808\uc774 \uc911 \ud558\ub098\ub294 \ub9ce\uc740 \uc228\uaca8\uc9c4 \uce74\ub4dc\uac00 \uc788\ub294 \uc5f4\uc5d0\uc11c \ub4b7\uba74 \uce74\ub4dc\ub97c \ub4dc\ub7ec\ub0b4\ub294 \uac83\uc744 \uc6b0\uc120\uc2dc\ud558\uc5ec \uc120\ud0dd\uc9c0\ub97c \uadf9\ub300\ud654\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uc811\uadfc \ubc29\uc2dd\uc740 \uae30\ubcf8 \ub354\ubbf8\uc5d0 \uce74\ub4dc\ub97c \uc774\ub3d9\ud558\ub294 \uac83\uacfc \ub2e4\ub978 \uce74\ub4dc\ub97c \ub9c9\uae30 \uc704\ud574 \uce74\ub4dc\ub97c \uc720\uc9c0\ud558\ub294 \uac83 \uc0ac\uc774\uc758 \uade0\ud615\uc744 \ub9de\ucd94\ub294 \uac83\uc785\ub2c8\ub2e4. \uc5d0\uc774\uc2a4\ub098 2\ub97c \uae30\ubcf8 \ub354\ubbf8\uc5d0 \uc774\ub3d9\ud558\uae30 \uc804\uc5d0 \uc774\ub7ec\ud55c \uce74\ub4dc\ub97c \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \ubaa8\ub4e0 \uc5f4\uc744 \ud3c9\uac00\ud569\ub2c8\ub2e4. \ub108\ubb34 \uc131\uae09\ud558\uac8c \uce74\ub4dc\ub97c \uc774\ub3d9\ud558\uc9c0 \ub9c8\uc2ed\uc2dc\uc624. \ub2e8\uacc4 1: \ud14c\uc774\ube14\uc758 \uc7a0\uc7ac\uc801 \ud574\uc81c\ub97c \ud3c9\uac00\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc2a4\ud0c1\uc758 \ub2e4\uc74c \uba87 \uac00\uc9c0 \uc774\ub3d9\uc744 \ud3c9\uac00\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc804\ub7b5\uc801\uc73c\ub85c \ub354 \ub9ce\uc740 \uce74\ub4dc\ub97c \ub4dc\ub7ec\ub0b4\ub294 \ub370 \uc720\ub9ac\ud560 \uacbd\uc6b0\uc5d0\ub9cc \uce74\ub4dc\ub97c \uc774\ub3d9\ud569\ub2c8\ub2e4."}, {"question": "\ud074\ub860\ub2e4\uc774\ud06c \uc194\ub9ac\ud14c\uc5b4: \ud14c\uc774\ube14 \uc5f4\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \ube44\uc6b0\ub294 \uac83\uc774 \uace0\uae09 \uae30\uc220\ub85c \uac04\uc8fc\ub418\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc774 \uc774\ub3d9\uc744 \ucd5c\ub300\ud654\ud558\uae30 \uc704\ud574 \uc5b8\uc81c \uc6b0\uc120\uc2dc\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\ud14c\uc774\ube14 \uc5f4\uc744 \ube44\uc6b0\ub294 \uac83\uc740 \ud0b9(\ubc0f \ud574\ub2f9 \uc21c\uc11c)\uc744 \uc704\ud55c \uacf5\uac04\uc744 \ub9cc\ub4dc\ub294 \uc911\uc694\ud55c \uace0\uae09 \uae30\uc220\uc785\ub2c8\ub2e4. \uc774 \uc870\uce58\ub294 \ub2e4\ub978 \ubc29\ubc95\uc774 \ucc28\ub2e8\ub420 \ub54c \uae34 \uce74\ub4dc \uc21c\uc11c\ub97c \uc774\ub3d9\ud560 \uc218 \uc788\ub294 \ub6f0\uc5b4\ub09c \uc720\uc5f0\uc131\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc5ec\ub7ec \uac1c\uc758 \ud0b9\uc774 \uc788\uac70\ub098 \uc228\uaca8\uc9c4 \uce74\ub4dc\ub97c \uae34 \ud14c\uc774\ube14 \ub354\ubbf8 \uc544\ub798\uc5d0\uc11c \uac00\uc838\uc640\uc57c \ud560 \ub54c \uc5f4\uc744 \ube44\uc6b0\ub294 \uac83\uc744 \uc6b0\uc120\uc2dc\ud558\uc2ed\uc2dc\uc624. \uadf8\ub7ec\ub098 \ud0b9\uc758 \uc218\ud2b8\ub97c \uace0\ub824\ud558\uc9c0 \uc54a\uace0 \uc5f4\uc744 \uc790\ub3d9\uc73c\ub85c \ube44\uc6b0\ub294 \uac83\uc744 \ud53c\ud558\uc2ed\uc2dc\uc624. \uac00\ub2a5\ud55c \uae30\ubcf8 \ub9e4\uce6d\uc5d0 \ub300\ud574 \uc218\ud2b8\ub97c \uc815\ub82c\ud558\uc5ec \uc720\uc6a9\ud55c \uc774\ub3d9\uc73c\ub85c \ub9cc\ub4dc\uc2ed\uc2dc\uc624. \uc5f4\uc758 \ucd1d \uce74\ub4dc\uc640 \uc228\uaca8\uc9c4 \uce74\ub4dc\uc758 \ube44\uad50 \uadf8\ub798\ud504\ub294 \uc5b4\ub5a4 \uc5f4\uc744 \uba3c\uc800 \ube44\uc6b8\uc9c0 \uc2dc\uac01\uc801\uc73c\ub85c \ubcf4\uc5ec\uc90d\ub2c8\ub2e4."}, {"question": "\ud2b9\uc815 \uce74\ub4dc\ub97c \ubf51\uc744 \ud655\ub960\uc5d0 \ub300\ud55c \uc2ec\uce35\uc801\uc778 \ubd84\uc11d\uc774 \ud074\ub860\ub2e4\uc774\ud06c \uc194\ub9ac\ud14c\uc5b4 \ud50c\ub808\uc774\ub97c \uac1c\uc120\ud558\ub294 \ub370 \uc5b4\ub5a4 \ub3c4\uc6c0\uc744 \uc8fc\uba70, \uc5b4\ub5a4 \ub9ac\uc18c\uc2a4\uac00 \uc774 \uce21\uba74\uc5d0\uc11c \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud2b9\uc815 \uce74\ub4dc\ub97c \ubf51\uc744 \ud655\ub960\uc744 \uc774\ud574\ud558\uba74 \uc0c1\ub2f9\ud55c \uc774\uc810\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uac01 \ub7ad\ud06c\ub9c8\ub2e4 \ub124 \uac1c\uc529 \uc788\ub2e4\ub294 \uac83\uc744 \uc54c\uba74 \uc5b8\uc81c \uc5b4\ub514\uc11c \ud2b9\uc815 \uce74\ub4dc\uac00 \ub098\ud0c0\ub0a0\uc9c0 \uc608\uc0c1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc9c0\uc2dd\uc740 \uce74\ub4dc \uc774\ub3d9 \ubc0f \uc5f4 \uac1c\ubc29\uc5d0 \ub300\ud55c \ub354 \ud604\uba85\ud55c \uacb0\uc815\uc744 \ub0b4\ub9ac\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \uc219\ub828\ub41c \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\ub294 \uc5f4\uc5d0\uc11c \uac00\uc7a5 \ub9ce\uc740 \uc228\uaca8\uc9c4 \uce74\ub4dc\uac00 \uc788\ub294 \uc218\ud2b8/\ub7ad\ud06c\ub97c \ucd94\uc801\ud558\uc5ec \uc815\ubcf4\uc5d0 \uc785\uac01\ud55c \uacb0\uc815\uc744 \ub0b4\ub9bd\ub2c8\ub2e4. \uc194\ub9ac\ud14c\uc5b4 \uc194\ubc84 \ub610\ub294 \uae30\ud0c0 \ubd84\uc11d \uc18c\ud504\ud2b8\uc6e8\uc5b4\uc640 \uac19\uc740 \ub9ac\uc18c\uc2a4\ub294 \uac8c\uc784 \uc0c1\ud0dc\ub97c \ubd84\uc11d\ud558\uace0 \ud655\ub960 \ucd94\uc815\uce58\ub97c \uc81c\uacf5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud655\ub960 \uacc4\uc0b0\uc740 \uce74\ub4dc \uac8c\uc784\uc758 \ud604\uc7ac \uc0c1\ud0dc(\uc54c\ub824\uc9c4 \uce74\ub4dc \uc218\uc640 \uc218\ud2b8)\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4."}, {"question": "\ud074\ub860\ub2e4\uc774\ud06c \uc194\ub9ac\ud14c\uc5b4\uc5d0\uc11c \uce74\ub4dc\ub97c \ub098\ub204\ub294 \uae30\ubcf8 \uc54c\uace0\ub9ac\uc998\uc774\ub098 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc774\uba70, \uc774\ub7ec\ud55c \uc54c\uace0\ub9ac\uc998\uc740 \uac8c\uc784\uc758 \uc5b4\ub824\uc6c0\uc5d0 \uc5b4\ub5bb\uac8c \uc601\ud5a5\uc744 \uc90d\ub2c8\uae4c?", "answer": "\ud074\ub860\ub2e4\uc774\ud06c \uc194\ub9ac\ud14c\uc5b4\uc758 \uce74\ub4dc \ub098\ub214\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \uc758\uc0ac\ub09c\uc218 \uc0dd\uc131\uae30(PRNG)\uc5d0 \uc758\ud574 \uc9c0\ubc30\ub429\ub2c8\ub2e4. \uc774\ub294 \ud14c\uc774\ube14\uacfc \uc2a4\ud0c1\uc5d0\uc11c \uce74\ub4dc\uc758 \ucd08\uae30 \ubc30\uce58 \ubc0f \uc21c\uc11c\ub97c \uacb0\uc815\ud569\ub2c8\ub2e4. \ub514\uc9c0\ud138 \uad6c\ud604\uc758 \uce74\ub4dc \uc154\ud50c \ub8e8\ud2f4\uacfc \ubb3c\ub9ac\uc801 \ubc84\uc804\uc758 \uc0ac\uc6a9\uc790 \uad00\ub9ac \uc154\ud50c\ub3c4 \uae30\uc5ec\ud569\ub2c8\ub2e4. \uc54c\uace0\ub9ac\uc998\uc740 \ud2b9\uc815 \ubc30\uce58\uc758 \uac00\ub2a5\uc131\uc5d0 \uc601\ud5a5\uc744 \uc8fc\ub3c4\ub85d \uac00\uc911\ub420 \uc218 \uc788\uc73c\uba70, \uc774\ub294 \uc77c\ubd80 \uc2dc\ub098\ub9ac\uc624\uac00 \ub2e4\ub978 \uc2dc\ub098\ub9ac\uc624\ubcf4\ub2e4 \ub354 \ud480\uae30 \uc26c\uc6cc \uac8c\uc784\uc758 \ub09c\uc774\ub3c4\ub97c \uc9c1\uc811 \uc870\uc815\ud569\ub2c8\ub2e4. PRNG\ub294 \ub610\ud55c \uac8c\uc784\uc774 \ub108\ubb34 \uc27d\uac8c \uc774\uae30\uac70\ub098 \ub108\ubb34 \uc27d\uac8c \uc9c0\uc9c0 \uc54a\ub3c4\ub85d '\uacf5\uc815\uc131'\uc744 \ubcf4\uc7a5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uac12\uc744 \ube44\uad50\ud558\uc5ec \uac00\uc911\uce58\uac00 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ud074\ub860\ub2e4\uc774\ud06c \uc194\ub9ac\ud14c\uc5b4\uc758 \ub2e4\ub978 \ubcc0\ud615(\uc608: \ubca0\uac00\uc2a4 \uc194\ub9ac\ud14c\uc5b4)\uc740 \ud575\uc2ec \uaddc\uce59\uc744 \uc5b4\ub5bb\uac8c \uc218\uc815\ud558\uba70, \uac8c\uc784\uc758 \ubcf5\uc7a1\uc131 \ubc0f \uc804\ub7b5\uc801 \uae4a\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ud074\ub860\ub2e4\uc774\ud06c \uc194\ub9ac\ud14c\uc5b4\uc5d0\ub294 \ud575\uc2ec \uaddc\uce59\uc744 \uc218\uc815\ud558\uc5ec \ubcf5\uc7a1\uc131\uacfc \uc804\ub7b5\uc801 \uae4a\uc774\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc5ec\ub7ec \uac00\uc9c0 \ubcc0\ud615\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 \ubca0\uac00\uc2a4 \uc194\ub9ac\ud14c\uc5b4\ub294 \uc2a4\ud14c\uc774\ud06c\ub85c \uc2dc\uc791\ud558\uace0 \ub3c8\uc744 \uc5bb\uac70\ub098 \uc783\ub294 \ub3c4\ubc15 \uc694\uc18c\ub97c \ub3c4\uc785\ud569\ub2c8\ub2e4. \uc774\ub294 \uae08\uc804\uc801 \uce21\uba74\uc744 \ucd94\uac00\ud558\uc5ec \uc2b9\ub9ac \uc870\uac74\uc744 \ubcc0\uacbd\ud569\ub2c8\ub2e4. \ucc28\uc774\uc810\uc740 \uce74\ub4dc \ub098\ub204\uae30, \uc2a4\ud0c1\uc5d0\uc11c \uce74\ub4dc \uc218, \uae30\ubcf8 \ub354\ubbf8 \uad6c\uc131, \uc2ec\uc9c0\uc5b4 \uc810\uc218 \uacc4\uc0b0\uacfc \uac19\uc740 \ud45c\uc900 \uaddc\uce59\uc758 \uc218\uc815\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ubcc0\ud654\ub97c \ube44\uad50\ud558\uba74 \uc774\ub7ec\ud55c \ubbf8\ubb18\ud55c \ubcc0\ud654\uac00 \uc21c\uc218\ud55c \uce74\ub4dc \uc21c\uc11c\uc5d0\uc11c \uc704\ud5d8 \uad00\ub9ac\uc5d0 \ucd08\uc810\uc744 \ub9de\ucd9c \uc218 \uc788\ub294 \ubc29\ubc95\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4. \uc2a4\ud0c1\uc744 \ud1b5\uacfc\ud558\ub294 \ud69f\uc218\ub294 \uc194\ub9ac\ud14c\uc5b4 \uac8c\uc784\uc758 \ubcf5\uc7a1\uc131\uc744 \uc99d\uac00 \ub610\ub294 \uac10\uc18c\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub2e4\uc591\ud55c \uae30\uae30(PC, iOS, Android)\uc5d0\uc11c \ud074\ub860\ub2e4\uc774\ud06c \uc194\ub9ac\ud14c\uc5b4\ub97c \ud50c\ub808\uc774\ud560 \ub54c \uc77c\ubc18\uc801\uc778 \ud638\ud658\uc131 \ubb38\uc81c\ub294 \ubb34\uc5c7\uc774\uba70, \uc800\uc7a5\ub41c \uac8c\uc784 \uc804\uc1a1\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \uc9c0\uc6d0\ub429\ub2c8\uae4c?", "answer": "\ud638\ud658\uc131 \ubb38\uc81c\ub294 \ud2b9\uc815 \ud074\ub860\ub2e4\uc774\ud06c \uc194\ub9ac\ud14c\uc5b4 \uc571\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. \ucc28\uc774\uc810\uc5d0\ub294 \uc2dc\uac01\uc801 \ub808\uc774\uc544\uc6c3, \ud130\uce58\uc2a4\ud06c\ub9b0 \ubc18\uc751\uc131 \ubc0f \uc0ac\uc6a9 \uac00\ub2a5\ud55c \uae30\ub2a5\uc774 \ud3ec\ud568\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc800\uc7a5\ub41c \uac8c\uc784 \ub370\uc774\ud130\ub97c \uc804\uc1a1\ud558\ub294 \uac83\uc740 \uc885\uc885 \uc81c\ud55c\ub429\ub2c8\ub2e4. \ub9ce\uc740 \ubc84\uc804\uc740 \ub2e4\ub978 \ud30c\uc77c \ud615\uc2dd\uc774\ub098 \ud074\ub77c\uc6b0\ub4dc \ud1b5\ud569\uc758 \ubd80\uc7ac\ub85c \uc778\ud574 \ud50c\ub7ab\ud3fc \uac04 \ub3d9\uae30\ud654\ub97c \uc9c0\uc6d0\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uba85\ud655\ud55c \ub2f5\ubcc0\uc744 \uc5bb\uc73c\ub824\uba74 \uac1c\ubc1c\uc790\uc758 \uba85\uc2dc\ub41c \uc9c0\uc6d0 \uc815\ubcf4\ub97c \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc6f9 \uae30\ubc18 \ubc84\uc804\uc740 \uc885\uc885 \ube0c\ub77c\uc6b0\uc800 \ucfe0\ud0a4\uc5d0 \uc800\uc7a5\ud558\uc5ec \uc0ac\uc6a9\ud558\ub294\ub370, \uc774\ub294 iOS \ub610\ub294 Android \uc571\uc73c\ub85c \uc6d0\ud65c\ud558\uac8c \uc774\uc804\ub418\uc9c0 \uc54a\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\uc815 \uac8c\uc784 \ubc84\uc804\uc774 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ud074\ub860\ub2e4\uc774\ud06c \uc194\ub9ac\ud14c\uc5b4\uc758 \ud45c\uc900 \uac8c\uc784 \uc678\uc5d0 \uc228\uaca8\uc9c4 \ud14c\ub9c8, \uc7a0\uae08 \ud574\uc81c \uac00\ub2a5\ud55c \uc0ac\uc6a9\uc790 \uc9c0\uc815 \ub610\ub294 \ud2b9\ubcc4\ud55c \uce74\ub4dc \ub371\uc774 \uc788\uc2b5\ub2c8\uae4c? \uc774\ub7ec\ud55c \uc694\uc18c\uc5d0 \uc811\uadfc\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub9ce\uc740 \ud074\ub860\ub2e4\uc774\ud06c \uc194\ub9ac\ud14c\uc5b4 \uad6c\ud604\uc740 \uc228\uaca8\uc9c4 \ud14c\ub9c8, \uc7a0\uae08 \ud574\uc81c \uac00\ub2a5\ud55c \uc0ac\uc6a9\uc790 \uc9c0\uc815 \ub610\ub294 \ud2b9\ubcc4\ud55c \uce74\ub4dc \ub371\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc694\uc18c\ub294 \uc885\uc885 \uc5f0\uc18d\ub41c \uc2b9\ub9ac, \ub192\uc740 \uc810\uc218 \ub2ec\uc131 \ub610\ub294 \uc0ac\uc6a9\uc790 \uc778\ud130\ud398\uc774\uc2a4\uc758 \ube44\ubc00 \ud074\ub9ad \uc870\ud569\uc744 \ubc1c\uacac\ud558\ub294 \uac83\uacfc \uac19\uc740 \ud2b9\uc815 \uac8c\uc784 \ub0b4 \uc131\uacfc\ub97c \uc644\ub8cc\ud558\uc5ec \uc561\uc138\uc2a4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc131\uacfc\ub294 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub85c \uad6c\ud604\ub418\uba70 \uc77c\ubc18\uc801\uc73c\ub85c \ud074\ub860\ub2e4\uc774\ud06c \uc194\ub9ac\ud14c\uc5b4 \uac8c\uc784\uc5d0\uc11c \ubb38\uc11c\ud654\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uba54\ub274\ub97c \uc870\uc0ac\ud558\uace0 \ucee4\ubba4\ub2c8\ud2f0 \ud3ec\ub7fc\uc5d0\uc11c \ub2e8\uc11c\ub97c \ucc3e\uc544\ubcf4\uc2ed\uc2dc\uc624. \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ud2b9\uc815 \uce74\ub4dc\ub97c \ud074\ub9ad\ud558\uac70\ub098 \ud2b9\uc774\ud55c \ub3d9\uc791\uc744 \uc218\ud589\ud558\uc5ec \uc228\uaca8\uc9c4 \uc774\ubca4\ud2b8\ub97c \ud2b8\ub9ac\uac70\ud558\uace0 \uc0c8 \ucf58\ud150\uce20\ub97c \uc7a0\uae08 \ud574\uc81c\ud558\ub294 \uac83\uc744 \ud3ec\ud568\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\uac83\uc740 \ud50c\ub808\uc774\ud558\ub294 \ud074\ub860\ub2e4\uc774\ud06c \uac8c\uc784 \ubc84\uc804\uc5d0 \ub530\ub77c \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc874\uc7ac\ud558\ub294\uc9c0 \uc5ec\ubd80\uac00 \uacb0\uc815\ub429\ub2c8\ub2e4."}]
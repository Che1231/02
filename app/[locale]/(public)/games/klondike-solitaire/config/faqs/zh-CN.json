[{"question": "\u514b\u9686\u6234\u514b\u7eb8\u724c\uff1a\u521d\u5b66\u8005\u5982\u4f55\u8fdb\u884c\u7b2c\u4e00\u6b65\u64cd\u4f5c\uff0c\u4ee5\u53ca\u5728\u8fd9\u4e2a\u7ecf\u5178\u7eb8\u724c\u6e38\u620f\u4e2d\u79fb\u52a8\u7eb8\u724c\u7684\u89c4\u5219\u662f\u4ec0\u4e48\uff1f", "answer": "\u5bf9\u4e8e\u514b\u9686\u6234\u514b\u7eb8\u724c\u7684\u521d\u5b66\u8005\u6765\u8bf4\uff0c\u7b2c\u4e00\u6b65\u64cd\u4f5c\u662f\u7ffb\u5f00\u724c\u5c40\u4e2d\u7684\u724c\u3002\u9009\u62e9\u4efb\u610f\u4e00\u5217\uff0c\u63ed\u5f00\u6240\u6709\u80cc\u9762\u671d\u4e0b\u7684\u724c\u3002\u4e3b\u8981\u89c4\u5219\u89c4\u5b9a\uff0c\u5982\u679c\u4e00\u5f20\u724c\u7684\u70b9\u6570\u6bd4\u53e6\u4e00\u5f20\u724c\u5927 1\uff0c\u5e76\u4e14\u989c\u8272\u76f8\u53cd\uff0c\u5219\u53ef\u4ee5\u5c06\u6b64\u724c\u79fb\u52a8\u5230\u53e6\u4e00\u5f20\u724c\u4e0a\u3002\u4f8b\u5982\uff0c\u4f60\u53ef\u4ee5\u5c06\u7ea2 6 \u79fb\u52a8\u5230\u9ed1 7 \u4e0a\u3002\u76ee\u6807\u662f\u63ed\u5f00\u66f4\u591a\u80cc\u9762\u671d\u4e0b\u7684\u724c\uff0c\u6700\u7ec8\u5c06\u6240\u6709\u724c\u79fb\u52a8\u5230\u57fa\u7840\u724c\u5806\u3002\u5177\u4f53\u6765\u8bf4\uff0c\u4f60\u53ef\u4ee5\u5c06\u9ed1 6 \u79fb\u52a8\u5230\u7ea2 7 \u4e0a\u3002\u4e00\u4e2a\u5f62\u8c61\u7684\u6307\u5357\u5c06\u663e\u793a\u6bcf\u5217\u7684\u6392\u5217\u65b9\u5f0f\u4ee5\u53ca\u5408\u9002\u7684\u724c\u987a\u5e8f\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u5373\u4f7f\u770b\u8d77\u6765\u9075\u5faa\u4e86\u89c4\u5219\uff0c\u6211\u4ecd\u7136\u65e0\u6cd5\u5728\u514b\u9686\u6234\u514b\u7eb8\u724c\u4e2d\u79fb\u52a8\u7eb8\u724c\uff0c\u4ee5\u53ca\u65b0\u624b\u73a9\u5bb6\u5e38\u72af\u7684\u9519\u8bef\u662f\u4ec0\u4e48\uff1f", "answer": "\u6709\u65f6\uff0c\u4f60\u65e0\u6cd5\u79fb\u52a8\u4e00\u5f20\u724c\uff0c\u56e0\u4e3a\u5148\u524d\u7684\u64cd\u4f5c\u5fc5\u987b\u5b8c\u6210\u624d\u80fd\u817e\u51fa\u7a7a\u95f4\u3002\u8bb8\u591a\u65b0\u624b\u73a9\u5bb6\u9519\u8bef\u5730\u8ba4\u4e3a\u4e00\u5f20\u724c\u53ef\u4ee5\u76f4\u63a5\u79fb\u52a8\u5230\u57fa\u7840\u724c\u5806\u3002\u4f46\u662f\uff0c\u724c\u5c40\u4e2d\u7684\u724c\u5fc5\u987b\u6309\u7167\u964d\u5e8f\u548c\u4ea4\u66ff\u989c\u8272\u987a\u5e8f\u79fb\u52a8\u3002\u8bf7\u68c0\u67e5\u76ee\u6807\u724c\u662f\u5426\u6ca1\u6709\u88ab\u906e\u6321\u3002\u5e38\u89c1\u9519\u8bef\u5305\u62ec\uff1a\u6ca1\u6709\u5229\u7528\u7a7a\u5217\u653e\u7f6e\u56fd\u738b\u724c\u4ee5\u53ca\u6ca1\u6709\u5728\u724c\u5c40\u4e2d\u63ed\u793a\u8db3\u591f\u7684\u724c\u3002\u4f8b\u5982\uff0c\u4f60\u4e0d\u80fd\u5c06\u7ea2 4 \u79fb\u52a8\u5230\u9ed1 4 \u4e0a\u3002\u901a\u5e38\uff0c\u89e3\u51b3\u65b9\u6cd5\u662f\u56de\u6eaf\u5e76\u91cd\u65b0\u8bc4\u4f30\u4f60\u7684\u7b56\u7565\uff0c\u63ed\u793a\u5173\u952e\u7684\u80cc\u9762\u671d\u4e0b\u7684\u724c\u5e76\u89e3\u9501\u65b0\u64cd\u4f5c\u3002\u6d41\u7a0b\u56fe\u5c06\u7a81\u51fa\u663e\u793a\uff0c\u57fa\u7840\u5fc5\u987b\u662f\u56fd\u738b\u724c\u624d\u80fd\u5c06\u5e8f\u5217\u79fb\u52a8\u5230\u7a7a\u7684\u724c\u5c40\u3002"}, {"question": "\u514b\u9686\u6234\u514b\u7eb8\u724c\u4e2d\u724c\u5806\uff08\u6216\u53d1\u724c\u5806\uff09\u7684\u4f5c\u7528\u662f\u4ec0\u4e48\uff1f\u4ee5\u53ca\u5982\u4f55\u6709\u6548\u5730\u4f7f\u7528\u5b83\u6765\u63d0\u9ad8\u83b7\u80dc\u7684\u51e0\u7387\uff1f", "answer": "\u5f53\u724c\u5c40\u4e2d\u6ca1\u6709\u7acb\u5373\u53ef\u7528\u7684\u64cd\u4f5c\u65f6\uff0c\u724c\u5806\u662f\u4f60\u83b7\u53d6\u724c\u7684\u6b21\u8981\u6765\u6e90\u3002\u4e3a\u4e86\u6709\u6548\u5730\u5229\u7528\u5b83\uff0c\u4e00\u6b21\u7ffb\u5f00\u4e00\u5f20\u724c\uff0c\u5e76\u7559\u610f\u54ea\u4e9b\u724c\u53ef\u80fd\u5bf9\u672a\u6765\u7684\u64cd\u4f5c\u6709\u7528\u3002\u8003\u8651\u5b83\u4eec\u5982\u4f55\u9002\u5408\u724c\u5c40\u6216\u9002\u5408\u57fa\u7840\u724c\u5806\u3002\u7136\u800c\uff0c\u4e0d\u8981\u6ca1\u6709\u7b56\u7565\u5730\u7ffb\u770b\u724c\u5806\uff0c\u5426\u5219\u4f60\u53ef\u80fd\u4f1a\u9519\u8fc7\u673a\u4f1a\u3002\u5faa\u5e8f\u6e10\u8fdb\u7684\u65b9\u6cd5\u5982\u4e0b\uff1a\u6b65\u9aa4 1 - \u7ffb\u5f00\u4e00\u5f20\u724c\uff1b\u6b65\u9aa4 2 - \u8bc4\u4f30\u5b83\u662f\u5426\u7acb\u5373\u53ef\u7528\uff1b\u6b65\u9aa4 3 - \u5982\u679c\u4e0d\u53ef\u7528\uff0c\u5219\u8bb0\u5f55\u82b1\u8272\u548c\u70b9\u6570\u4ee5\u4fbf\u4ee5\u540e\u4f7f\u7528\u3002\u8003\u8651\u5728\u5fc3\u4e2d\u7ed8\u5236\u4e00\u5f20\u724c\u7684\u5206\u5e03\u56fe\uff0c\u65b9\u4fbf\u8bb0\u5fc6\u3002"}, {"question": "\u5bf9\u4e8e\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\uff1a\u6211\u53ef\u4ee5\u5728\u514b\u9686\u6234\u514b\u7eb8\u724c\u4e2d\u4f7f\u7528\u54ea\u4e9b\u9ad8\u7ea7\u7b56\u7565\u6765\u63d0\u9ad8\u83b7\u80dc\u7387\uff0c\u91cd\u70b9\u662f\u724c\u7684\u7ba1\u7406\u548c\u6218\u672f\u64cd\u4f5c\uff1f", "answer": "\u9ad8\u7ea7\u514b\u9686\u6234\u514b\u7eb8\u724c\u7b56\u7565\u4e3b\u8981\u56f4\u7ed5\u6709\u6548\u5730\u7ba1\u7406\u724c\u3002\u4e00\u79cd\u6709\u6548\u7684\u7b56\u7565\u662f\u4f18\u5148\u63ed\u793a\u5305\u542b\u8bb8\u591a\u9690\u85cf\u724c\u7684\u724c\u5217\u4e2d\u7684\u80cc\u9762\u671d\u4e0b\u7684\u724c\uff0c\u4ee5\u6700\u5927\u5316\u9009\u62e9\u3002\u53e6\u4e00\u79cd\u65b9\u6cd5\u5728\u4e8e\u5e73\u8861\u5c06\u724c\u79fb\u52a8\u5230\u57fa\u7840\u724c\u5806\u4e0e\u4fdd\u7559\u5b83\u4eec\u4ee5\u89e3\u5f00\u5176\u4ed6\u724c\u4e4b\u95f4\u7684\u5173\u7cfb\u3002\u5728\u5c06 A \u6216 2 \u79fb\u52a8\u5230\u57fa\u7840\u724c\u5806\u4e4b\u524d\uff0c\u8bc4\u4f30\u6240\u6709\u53ef\u80fd\u53d7\u76ca\u4e8e\u8fd9\u4e9b\u724c\u7684\u724c\u5217\u3002\u4e0d\u8981\u8fc7\u65e9\u79fb\u52a8\u724c\u3002\u6b65\u9aa4 1\uff1a\u8bc4\u4f30\u724c\u5c40\u4e2d\u6f5c\u5728\u7684\u89e3\u9501\u3002\u6b65\u9aa4 2\uff1a\u8bc4\u4f30\u724c\u5806\u4e2d\u63a5\u4e0b\u6765\u7684\u51e0\u6b21\u79fb\u52a8\u3002\u6b65\u9aa4 3\uff1a\u53ea\u6709\u5f53\u724c\u53ef\u4ee5\u6218\u7565\u6027\u5730\u6709\u5229\u4e8e\u63ed\u793a\u66f4\u591a\u724c\u65f6\u624d\u79fb\u52a8\u3002"}, {"question": "\u514b\u9686\u6234\u514b\u7eb8\u724c\uff1a\u4e3a\u4ec0\u4e48\u5728\u514b\u9686\u6234\u514b\u7eb8\u724c\u4e2d\u6218\u7565\u6027\u5730\u6e05\u7a7a\u724c\u5c40\u5217\u88ab\u8ba4\u4e3a\u662f\u9ad8\u7ea7\u6280\u5de7\uff0c\u4ee5\u53ca\u5728\u4f55\u65f6\u5e94\u8be5\u4f18\u5148\u6267\u884c\u6b64\u64cd\u4f5c\u4ee5\u6700\u5927\u5316\u5176\u76ca\u5904\uff1f", "answer": "\u6e05\u7a7a\u724c\u5c40\u5217\u662f\u4e00\u4e2a\u5173\u952e\u7684\u9ad8\u7ea7\u6280\u5de7\uff0c\u56e0\u4e3a\u5b83\u521b\u5efa\u4e86\u4e00\u4e2a\u4e13\u95e8\u7528\u4e8e\u653e\u7f6e\u56fd\u738b\u724c\uff08\u4ee5\u53ca\u4efb\u4f55\u9644\u52a0\u5e8f\u5217\uff09\u7684\u7a7a\u95f4\u3002\u6b64\u64cd\u4f5c\u63d0\u4f9b\u6781\u5927\u7684\u7075\u6d3b\u6027\uff0c\u4f7f\u4f60\u80fd\u591f\u5728\u5176\u4ed6\u9014\u5f84\u53d7\u963b\u65f6\u79fb\u52a8\u8f83\u957f\u7684\u724c\u5e8f\u5217\u3002\u5f53\u4f60\u6709\u591a\u4e2a\u56fd\u738b\u724c\u53ef\u7528\u6216\u9700\u8981\u68c0\u7d22\u9690\u85cf\u5728\u8f83\u957f\u724c\u5806\u4e0b\u9762\u7684\u724c\u65f6\uff0c\u4f18\u5148\u8003\u8651\u6e05\u7a7a\u724c\u5217\u3002\u4f46\u662f\uff0c\u4e0d\u8981\u81ea\u52a8\u6e05\u7a7a\u724c\u5217\u800c\u4e0d\u8003\u8651\u4f60\u7684\u56fd\u738b\u724c\u7684\u82b1\u8272\uff1b\u5c1d\u8bd5\u4f7f\u82b1\u8272\u4e0e\u6f5c\u5728\u7684\u57fa\u7840\u724c\u5339\u914d\uff0c\u4ee5\u4f7f\u5176\u6210\u4e3a\u503c\u5f97\u7684\u64cd\u4f5c\u3002\u4e00\u5f20\u5217\u5bf9\u6bd4\u56fe\uff0c\u5217\u51fa\u6bcf\u4e00\u5217\u7684\u603b\u724c\u6570\u548c\u9690\u85cf\u724c\u6570\u91cf\uff0c\u5c06\u76f4\u89c2\u5730\u5c55\u793a\u54ea\u4e2a\u724c\u5217\u5e94\u8be5\u5148\u6e05\u7a7a\u3002"}, {"question": "\u6df1\u5165\u7814\u7a76\u62bd\u53d6\u7279\u5b9a\u7eb8\u724c\u7684\u6982\u7387\u5982\u4f55\u589e\u5f3a\u4f60\u5728\u514b\u9686\u6234\u514b\u7eb8\u724c\u4e2d\u7684\u6e38\u620f\u73a9\u6cd5\uff0c\u4ee5\u53ca\u54ea\u4e9b\u8d44\u6e90\u53ef\u4ee5\u5e2e\u52a9\u8fd9\u4e00\u65b9\u9762\uff1f", "answer": "\u7406\u89e3\u62bd\u53d6\u7279\u5b9a\u7eb8\u724c\u7684\u6982\u7387\u53ef\u4ee5\u5e26\u6765\u663e\u8457\u4f18\u52bf\u3002\u77e5\u9053\u6bcf\u79cd\u70b9\u6570\u90fd\u6709\u56db\u5f20\u724c\uff0c\u53ef\u4ee5\u5e2e\u52a9\u4f60\u9884\u6d4b\u4f55\u65f6\u4f55\u5730\u67d0\u4e9b\u724c\u53ef\u80fd\u4f1a\u51fa\u73b0\u3002\u8fd9\u4e9b\u77e5\u8bc6\u6709\u52a9\u4e8e\u4f60\u5728\u79fb\u52a8\u724c\u548c\u6253\u5f00\u724c\u5217\u65b9\u9762\u505a\u51fa\u66f4\u660e\u667a\u7684\u51b3\u7b56\u3002\u4e00\u4e9b\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u4f1a\u8ffd\u8e2a\u67d0\u5f20\u82b1\u8272/\u724c\u70b9\u5728\u67d0\u724c\u5217\u4e2d\u9690\u85cf\u7684\u724c\u6570\u91cf\u6700\u591a\uff0c\u4ee5\u505a\u51fa\u660e\u667a\u7684\u51b3\u7b56\u3002\u50cf\u7eb8\u724c\u89e3\u9898\u5668\u6216\u5176\u4ed6\u5206\u6790\u8f6f\u4ef6\u4e4b\u7c7b\u7684\u8d44\u6e90\u53ef\u4ee5\u5206\u6790\u6e38\u620f\u72b6\u6001\u5e76\u63d0\u4f9b\u6982\u7387\u4f30\u8ba1\u3002\u6982\u7387\u8ba1\u7b97\u5c06\u53d6\u51b3\u4e8e\u7eb8\u724c\u6e38\u620f\u5f53\u524d\u7684\u72b6\u6001\uff08\u5df2\u77e5\u7684\u724c\u6570\u91cf\u53ca\u5176\u82b1\u8272\uff09\u3002"}, {"question": "\u54ea\u4e9b\u5e95\u5c42\u7b97\u6cd5\u6216\u673a\u5236\u63a7\u5236\u7740\u514b\u9686\u6234\u514b\u7eb8\u724c\u4e2d\u7eb8\u724c\u7684\u53d1\u724c\u8fc7\u7a0b\uff1f\u8fd9\u4e9b\u7b97\u6cd5\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u7684 perceived \u96be\u5ea6\uff1f", "answer": "\u514b\u9686\u6234\u514b\u7eb8\u724c\u7684\u53d1\u724c\u8fc7\u7a0b\u901a\u5e38\u53d7\u4f2a\u968f\u673a\u6570\u751f\u6210\u5668 (PRNG) \u63a7\u5236\u3002\u8fd9\u51b3\u5b9a\u4e86\u724c\u5c40\u4e2d\u724c\u7684\u521d\u59cb\u5e03\u5c40\u548c\u987a\u5e8f\uff0c\u4ee5\u53ca\u724c\u5806\u4e2d\u7684\u987a\u5e8f\u3002\u6570\u5b57\u5316\u5b9e\u73b0\u4e2d\u7684\u6d17\u724c\u7a0b\u5e8f\u4ee5\u53ca\u5b9e\u4f53\u7248\u672c\u4e2d\u7528\u6237\u7ba1\u7406\u7684\u6d17\u724c\u65b9\u5f0f\u4e5f\u8d77\u4f5c\u7528\u3002\u7b97\u6cd5\u53ef\u80fd\u4f1a\u88ab\u8d4b\u4e88\u52a0\u6743\uff0c\u4ee5\u5f71\u54cd\u67d0\u4e9b\u5e03\u5c40\u51fa\u73b0\u7684\u53ef\u80fd\u6027\uff0c\u8fd9\u76f4\u63a5\u51b3\u5b9a\u4e86\u6e38\u620f\u7684\u96be\u5ea6\uff0c\u56e0\u4e3a\u67d0\u4e9b\u60c5\u666f\u6bd4\u5176\u4ed6\u60c5\u666f\u66f4\u5bb9\u6613\u89e3\u51b3\u3002PRNG \u4e5f\u53ef\u80fd\u4f1a\u786e\u4fdd\u4e00\u5b9a\u7684'\u516c\u5e73\u6027'\uff0c\u4ee5\u786e\u4fdd\u6e38\u620f\u4e0d\u4f1a\u592a\u5bb9\u6613\u8d62\u6216\u592a\u5bb9\u6613\u8f93\u3002\u6bd4\u8f83\u8fd9\u4e9b\u503c\uff0c\u4ee5\u4e86\u89e3\u5b83\u4eec\u662f\u5426\u52a0\u6743\u3002"}, {"question": "\u4e0d\u540c\u7684\u514b\u9686\u6234\u514b\u7eb8\u724c\u53d8\u4f53\uff08\u4f8b\u5982\uff0c\u62c9\u65af\u7ef4\u52a0\u65af\u7eb8\u724c\uff09\u5982\u4f55\u4fee\u6539\u6838\u5fc3\u89c4\u5219\uff0c\u5e76\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u7684\u590d\u6742\u6027\u548c\u6218\u7565\u6df1\u5ea6\uff1f", "answer": "\u514b\u9686\u6234\u514b\u7eb8\u724c\u6709\u51e0\u4e2a\u53d8\u4f53\uff0c\u5b83\u4eec\u4f1a\u4fee\u6539\u6838\u5fc3\u89c4\u5219\uff0c\u4ece\u800c\u5f71\u54cd\u590d\u6742\u6027\u548c\u6218\u7565\u6df1\u5ea6\u3002\u4f8b\u5982\uff0c\u62c9\u65af\u7ef4\u52a0\u65af\u7eb8\u724c\u5f15\u5165\u4e86\u8d4c\u535a\u5143\u7d20\uff0c\u4f60\u4ece\u8d4c\u6ce8\u5f00\u59cb\uff0c\u5e76\u8d62\u5f97/\u8f93\u6389\u91d1\u94b1\u3002\u8fd9\u589e\u52a0\u4e86\u91d1\u878d\u5c42\uff0c\u6539\u53d8\u4e86\u83b7\u80dc\u6761\u4ef6\u3002\u5dee\u5f02\u5728\u4e8e\u5bf9\u6807\u51c6\u89c4\u5219\u7684\u4fee\u6539\uff1a\u7eb8\u724c\u53d1\u724c\u65b9\u5f0f\u3001\u4ece\u724c\u5806\u53d1\u724c\u7684\u6570\u91cf\u3001\u57fa\u7840\u724c\u5806\u7684\u6784\u5efa\u65b9\u5f0f\uff0c\u751a\u81f3\u8ba1\u5206\u3002\u6bd4\u8f83\u8fd9\u4e9b\u4fee\u6539\u8bf4\u660e\u4e86\u6b64\u7c7b\u7ec6\u5fae\u53d8\u5316\u5982\u4f55\u5c06\u91cd\u70b9\u4ece\u7eaf\u7cb9\u7684\u7eb8\u724c\u6392\u5e8f\u8f6c\u79fb\u5230\u98ce\u9669\u7ba1\u7406\u3002\u4ece\u724c\u5806\u901a\u8fc7\u5230\u7684\u6b21\u6570\u53ef\u4ee5\u589e\u52a0\u6216\u9650\u5236\u7eb8\u724c\u6e38\u620f\u7684\u590d\u6742\u6027\u3002"}, {"question": "\u5728\u4e0d\u540c\u8bbe\u5907\uff08PC\u3001iOS\u3001Android\uff09\u4e0a\u73a9\u514b\u9686\u6234\u514b\u7eb8\u724c\u65f6\uff0c\u5e38\u89c1\u7684\u517c\u5bb9\u6027\u95ee\u9898\u6709\u54ea\u4e9b\uff1f\u901a\u5e38\u652f\u6301\u4fdd\u5b58\u6e38\u620f\u7684\u8f6c\u79fb\u5417\uff1f", "answer": "\u517c\u5bb9\u6027\u95ee\u9898\u56e0\u5177\u4f53\u7684\u514b\u9686\u6234\u514b\u7eb8\u724c\u5e94\u7528\u7a0b\u5e8f\u800c\u5f02\u3002\u5dee\u5f02\u53ef\u80fd\u5305\u62ec\u89c6\u89c9\u5e03\u5c40\u3001\u89e6\u6478\u5c4f\u54cd\u5e94\u6027\u548c\u53ef\u7528\u529f\u80fd\u3002\u8f6c\u79fb\u4fdd\u5b58\u7684\u6e38\u620f\u6570\u636e\u901a\u5e38\u53d7\u5230\u9650\u5236\uff1b\u8bb8\u591a\u7248\u672c\u4e0d\u652f\u6301\u8de8\u5e73\u53f0\u540c\u6b65\uff0c\u56e0\u4e3a\u6587\u4ef6\u683c\u5f0f\u4e0d\u540c\u6216\u7f3a\u4e4f\u4e91\u96c6\u6210\u3002\u4e3a\u4e86\u83b7\u5f97\u660e\u786e\u7684\u7b54\u6848\uff0c\u8bf7\u67e5\u770b\u5f00\u53d1\u4eba\u5458\u7684\u5df2\u58f0\u660e\u652f\u6301\u4fe1\u606f\u3002\u4f8b\u5982\uff0c\u57fa\u4e8e\u7f51\u7edc\u7684\u7248\u672c\u901a\u5e38\u4f9d\u8d56\u4e8e\u6d4f\u89c8\u5668 Cookie \u8fdb\u884c\u4fdd\u5b58\uff0c\u8fd9\u53ef\u80fd\u65e0\u6cd5\u5e73\u7a33\u5730\u8fc1\u79fb\u5230 iOS \u6216 Android \u5e94\u7528\u7a0b\u5e8f\u3002\u8bf7\u68c0\u67e5\u7279\u5b9a\u7248\u672c\u7684\u6e38\u620f\u662f\u5426\u80fd\u591f\u4f7f\u7528\u4e91\u4fdd\u5b58\u529f\u80fd\u3002"}, {"question": "\u9664\u4e86\u6807\u51c6\u6e38\u620f\u73a9\u6cd5\u4e4b\u5916\uff0c\u5728\u514b\u9686\u6234\u514b\u7eb8\u724c\u4e2d\u662f\u5426\u5b58\u5728\u4efb\u4f55\u9690\u85cf\u7684\u4e3b\u9898\u3001\u53ef\u89e3\u9501\u7684\u81ea\u5b9a\u4e49\u6216\u7279\u6b8a\u7eb8\u724c\u7ec4\uff0c\u4ee5\u53ca\u5982\u4f55\u8bbf\u95ee\u5b83\u4eec\uff1f", "answer": "\u8bb8\u591a\u514b\u9686\u6234\u514b\u7eb8\u724c\u5b9e\u73b0\u90fd\u63d0\u4f9b\u9690\u85cf\u4e3b\u9898\u3001\u53ef\u89e3\u9501\u81ea\u5b9a\u4e49\u6216\u7279\u6b8a\u7eb8\u724c\u7ec4\u3002\u8fd9\u4e9b\u901a\u5e38\u53ef\u4ee5\u901a\u8fc7\u5b8c\u6210\u6e38\u620f\u4e2d\u7684\u7279\u5b9a\u6210\u5c31\u6765\u8bbf\u95ee\uff0c\u4f8b\u5982\u8fde\u80dc\u4e00\u5b9a\u6b21\u6570\u3001\u8fbe\u5230\u9ad8\u5206\u6216\u5728\u7528\u6237\u754c\u9762\u4e2d\u53d1\u73b0\u79d8\u5bc6\u70b9\u51fb\u7ec4\u5408\u3002\u8fd9\u4e9b\u6210\u5c31\u88ab\u5b9e\u73b0\u4e3a\u5f69\u86cb\uff0c\u901a\u5e38\u6ca1\u6709\u88ab\u8bb0\u5f55\u5728\u514b\u9686\u6234\u514b\u7eb8\u724c\u6e38\u620f\u4e2d\u3002\u68c0\u67e5\u83dc\u5355\u5e76\u67e5\u770b\u793e\u533a\u8bba\u575b\u4ee5\u83b7\u53d6\u7ebf\u7d22\uff1b\u5f69\u86cb\u53ef\u80fd\u6d89\u53ca\u70b9\u51fb\u7279\u5b9a\u7eb8\u724c\u6216\u6267\u884c\u4e0d\u5bfb\u5e38\u7684\u64cd\u4f5c\u6765\u89e6\u53d1\u9690\u85cf\u4e8b\u4ef6\u5e76\u89e3\u9501\u65b0\u5185\u5bb9\u3002\u8fd9\u53d6\u51b3\u4e8e\u4f60\u6b63\u5728\u73a9\u54ea\u4e2a\u7248\u672c\u7684\u514b\u9686\u6234\u514b\u6e38\u620f\uff0c\u662f\u5426\u5b58\u5728\u5f69\u86cb\u3002"}]
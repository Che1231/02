[{"question": "\u30af\u30ed\u30fc\u30c7\u30a3\u30c3\u30af\u30fb\u30bd\u30ed\uff1a\u521d\u5fc3\u8005\u304c\u6700\u521d\u306e\u52d5\u304d\u3092\u3059\u308b\u65b9\u6cd5\u3068\u3001\u3053\u306e\u30af\u30e9\u30b7\u30c3\u30af\u306a\u30ab\u30fc\u30c9\u30b2\u30fc\u30e0\u3067\u30ab\u30fc\u30c9\u3092\u52d5\u304b\u3059\u30eb\u30fc\u30eb\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30af\u30ed\u30fc\u30c7\u30a3\u30c3\u30af\u30fb\u30bd\u30ed\u306e\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001\u6700\u521d\u306e\u52d5\u304d\u306f\u3001\u30c6\u30fc\u30d6\u30eb\u304b\u3089\u30ab\u30fc\u30c9\u3092\u958b\u793a\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u9078\u629e\u3057\u305f\u4efb\u610f\u306e\u5217\u306b\u3042\u308b\u3059\u3079\u3066\u306e\u8868\u88cf\u30ab\u30fc\u30c9\u3092\u516c\u958b\u3057\u307e\u3059\u3002\u4e3b\u306a\u30eb\u30fc\u30eb\u306f\u3001\u30e9\u30f3\u30af\u304c1\u3064\u9ad8\u304f\u3001\u8272\u304c\u53cd\u5bfe\u306e\u30ab\u30fc\u30c9\u306b\u30ab\u30fc\u30c9\u3092\u52d5\u304b\u3059\u3053\u3068\u304c\u3067\u304d\u308b\u3068\u3044\u3046\u3053\u3068\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u9ed2\u306e7\u306e\u4e0a\u306b\u8d64\u30446\u3092\u7f6e\u304f\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u76ee\u6a19\u306f\u3001\u3088\u308a\u591a\u304f\u306e\u8868\u88cf\u30ab\u30fc\u30c9\u3092\u516c\u958b\u3057\u3001\u6700\u7d42\u7684\u306b\u3059\u3079\u3066\u306e\u30ab\u30fc\u30c9\u3092\u30d5\u30a1\u30a6\u30f3\u30c7\u30fc\u30b7\u30e7\u30f3\u30fb\u30d1\u30a4\u30eb\u306b\u79fb\u52d5\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u5177\u4f53\u7684\u306b\u306f\u3001\u8d64\u30447\u306e\u4e0a\u306b\u9ed2\u30446\u3092\u52d5\u304b\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u8996\u899a\u7684\u306a\u30ac\u30a4\u30c9\u306f\u3001\u5404\u30ab\u30b9\u30b1\u30fc\u30c9\u72b6\u306e\u5217\u3068\u9069\u5207\u306a\u30ab\u30fc\u30c9\u306e\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u793a\u3057\u307e\u3059\u3002"}, {"question": "\u30eb\u30fc\u30eb\u306b\u5f93\u3063\u3066\u3044\u308b\u3088\u3046\u306b\u898b\u3048\u308b\u306e\u306b\u3001\u30af\u30ed\u30fc\u30c7\u30a3\u30c3\u30af\u30fb\u30bd\u30ed\u3067\u30ab\u30fc\u30c9\u3092\u52d5\u304b\u305b\u306a\u3044\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u72af\u3057\u304c\u3061\u306a\u5171\u901a\u306e\u30df\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ab\u30fc\u30c9\u3092\u52d5\u304b\u305b\u306a\u3044\u306e\u306f\u3001\u4ee5\u524d\u306e\u52d5\u304d\u304c\u30b9\u30da\u30fc\u30b9\u3092\u958b\u653e\u3059\u308b\u305f\u3081\u306b\u5fc5\u8981\u3068\u3055\u308c\u3066\u3044\u308b\u305f\u3081\u3067\u3059\u3002\u591a\u304f\u306e\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30ab\u30fc\u30c9\u304c\u3059\u3050\u306b\u30d5\u30a1\u30a6\u30f3\u30c7\u30fc\u30b7\u30e7\u30f3\u306b\u79fb\u52d5\u3067\u304d\u308b\u3068\u8aa4\u3063\u3066\u8003\u3048\u3066\u3044\u307e\u3059\u3002\u3057\u304b\u3057\u3001\u30c6\u30fc\u30d6\u30eb\u5185\u306e\u30ab\u30fc\u30c9\u306f\u964d\u9806\u3067\u4ea4\u4e92\u306e\u8272\u9806\u306b\u5f93\u3046\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u76ee\u7684\u5730\u30ab\u30fc\u30c9\u304c\u96a0\u3055\u308c\u3066\u3044\u306a\u3044\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u5171\u901a\u306e\u30df\u30b9\u306b\u306f\u3001\u30ad\u30f3\u30b0\u306e\u305f\u3081\u306b\u7a7a\u306e\u5217\u3092\u5229\u7528\u3057\u306a\u3044\u3053\u3068\u3001\u30c6\u30fc\u30d6\u30eb\u3067\u5341\u5206\u306a\u30ab\u30fc\u30c9\u3092\u516c\u958b\u3057\u306a\u3044\u3053\u3068\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u9ed2\u306e4\u306e\u4e0a\u306b\u8d64\u30444\u3092\u7f6e\u304f\u3053\u3068\u306f\u3067\u304d\u307e\u305b\u3093\u3002\u591a\u304f\u306e\u5834\u5408\u3001\u89e3\u6c7a\u7b56\u306f\u3001\u91cd\u8981\u306a\u8868\u88cf\u30ab\u30fc\u30c9\u3092\u516c\u958b\u3057\u3066\u65b0\u3057\u3044\u52d5\u304d\u3092\u89e3\u9664\u3059\u308b\u305f\u3081\u306b\u3001\u624b\u9806\u3092\u5143\u306b\u623b\u3057\u3066\u6226\u7565\u3092\u518d\u691c\u8a0e\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u306f\u3001\u57fa\u672c\u304c\u30ad\u30f3\u30b0\u3067\u3042\u308b\u5fc5\u8981\u304c\u3042\u308b\u3053\u3068\u3092\u5f37\u8abf\u3057\u3001\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u7a7a\u306e\u30c6\u30fc\u30d6\u30eb\u306b\u79fb\u52d5\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30af\u30ed\u30fc\u30c7\u30a3\u30c3\u30af\u30fb\u30bd\u30ed\u306e\u30b9\u30c8\u30c3\u30af\uff08\u307e\u305f\u306f\u5f15\u304d\u672d\uff09\u306e\u76ee\u7684\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u52dd\u5229\u306e\u53ef\u80fd\u6027\u3092\u9ad8\u3081\u308b\u305f\u3081\u306b\u305d\u308c\u3092\u52b9\u679c\u7684\u306b\u3069\u306e\u3088\u3046\u306b\u4f7f\u7528\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30b9\u30c8\u30c3\u30af\u306f\u3001\u30c6\u30fc\u30d6\u30eb\u306b\u3059\u3050\u4f7f\u3048\u308b\u52d5\u304d\u304c\u306a\u3044\u5834\u5408\u306e\u3001\u30ab\u30fc\u30c9\u306e2\u6b21\u30bd\u30fc\u30b9\u3067\u3059\u3002\u305d\u308c\u3092\u52b9\u679c\u7684\u306b\u6d3b\u7528\u3059\u308b\u306b\u306f\u3001\u30ab\u30fc\u30c9\u30921\u679a\u305a\u3064\u88cf\u8fd4\u3057\u3001\u5c06\u6765\u306e\u52d5\u304d\u306b\u5f79\u7acb\u3061\u305d\u3046\u306a\u30ab\u30fc\u30c9\u3092\u30e1\u30e2\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305d\u308c\u3089\u304c\u30c6\u30fc\u30d6\u30eb\u306b\u3069\u306e\u3088\u3046\u306b\u9069\u5408\u3059\u308b\u304b\u3001\u307e\u305f\u306f\u30d5\u30a1\u30a6\u30f3\u30c7\u30fc\u30b7\u30e7\u30f3\u306b\u9069\u3057\u3066\u3044\u308b\u304b\u3092\u691c\u8a0e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3057\u304b\u3057\u3001\u6226\u7565\u7684\u306a\u8a08\u753b\u306a\u3057\u3067\u3001\u30b9\u30c8\u30c3\u30af\u3092\u7121\u95c7\u306b\u88cf\u8fd4\u3055\u306a\u3044\u3088\u3046\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305d\u3046\u3059\u308b\u3068\u3001\u30c1\u30e3\u30f3\u30b9\u3092\u9003\u3059\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u6bb5\u968e\u7684\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u304c\u5f79\u7acb\u3061\u307e\u3059\uff1a\u30b9\u30c6\u30c3\u30d71-1\u679a\u306e\u30ab\u30fc\u30c9\u3092\u88cf\u8fd4\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72-\u305d\u308c\u304c\u3059\u3050\u306b\u4f7f\u7528\u3067\u304d\u308b\u304b\u3069\u3046\u304b\u8a55\u4fa1\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73- \u305d\u3046\u3067\u306a\u3044\u5834\u5408\u306f\u3001\u5f8c\u3067\u4f7f\u7528\u3059\u308b\u305f\u3081\u306b\u3001\u30b9\u30fc\u30c8\u3068\u30e9\u30f3\u30af\u3092\u8a18\u9332\u3057\u307e\u3059\u3002\u5404\u5217\u306b\u5fc5\u8981\u306a\u30ab\u30fc\u30c9\u306e\u30e1\u30f3\u30bf\u30eb\u30de\u30c3\u30d7\u3092\u4f5c\u6210\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u719f\u7df4\u3057\u305f\u30d7\u30ec\u30a4\u30e4\u30fc\u5411\u3051\uff1a\u30af\u30ed\u30fc\u30c7\u30a3\u30c3\u30af\u30fb\u30bd\u30ed\u3067\u52dd\u7387\u3092\u9ad8\u3081\u308b\u305f\u3081\u306b\u4f7f\u7528\u3067\u304d\u308b\u9ad8\u5ea6\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f\u30ab\u30fc\u30c9\u7ba1\u7406\u3068\u6226\u8853\u7684\u306a\u30d7\u30ec\u30a4\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "\u9ad8\u5ea6\u306a\u30af\u30ed\u30fc\u30c7\u30a3\u30c3\u30af\u30fb\u30bd\u30ed\u6226\u7565\u306f\u3001\u52b9\u7387\u7684\u306a\u30ab\u30fc\u30c9\u7ba1\u7406\u3092\u4e2d\u5fc3\u306b\u5c55\u958b\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u52b9\u679c\u7684\u306a\u30d7\u30ec\u30a4\u306e1\u3064\u306f\u3001\u591a\u304f\u306e\u96a0\u3055\u308c\u305f\u30ab\u30fc\u30c9\u3092\u542b\u3080\u5217\u3067\u8868\u88cf\u30ab\u30fc\u30c9\u3092\u516c\u958b\u3059\u308b\u3053\u3068\u306b\u512a\u5148\u9806\u4f4d\u3092\u4ed8\u3051\u308b\u3053\u3068\u3067\u3001\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u6700\u5927\u5316\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u3082\u30461\u3064\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u3001\u30ab\u30fc\u30c9\u3092\u30d5\u30a1\u30a6\u30f3\u30c7\u30fc\u30b7\u30e7\u30f3\u306b\u79fb\u52d5\u3059\u308b\u3053\u3068\u3068\u3001\u4ed6\u306e\u30ab\u30fc\u30c9\u3092\u30d6\u30ed\u30c3\u30af\u3057\u306a\u3044\u3088\u3046\u306b\u4fdd\u6301\u3059\u308b\u3053\u3068\u306e\u30d0\u30e9\u30f3\u30b9\u3092\u3068\u308b\u3053\u3068\u3067\u3059\u3002\u30a8\u30fc\u30b9\u307e\u305f\u306f2\u3092\u30d5\u30a1\u30a6\u30f3\u30c7\u30fc\u30b7\u30e7\u30f3\u306b\u79fb\u52d5\u3059\u308b\u524d\u306b\u3001\u3053\u308c\u3089\u306e\u30ab\u30fc\u30c9\u304b\u3089\u6f5c\u5728\u7684\u306b\u5229\u76ca\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u3059\u3079\u3066\u306e\u5217\u3092\u8a55\u4fa1\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30ab\u30fc\u30c9\u3092\u65e9\u8a08\u306b\u79fb\u52d5\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30c6\u30fc\u30d6\u30eb\u306e\u6f5c\u5728\u7684\u306a\u89e3\u653e\u3092\u8a55\u4fa1\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b9\u30c8\u30c3\u30af\u306e\u6b21\u306e\u6570\u56de\u306e\u52d5\u304d\u3092\u8a55\u4fa1\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30ab\u30fc\u30c9\u3092\u79fb\u52d5\u3059\u308b\u306e\u306f\u3001\u3088\u308a\u591a\u304f\u306e\u30ab\u30fc\u30c9\u3092\u516c\u958b\u3059\u308b\u305f\u3081\u306e\u6226\u7565\u7684\u306b\u6709\u5229\u306a\u5834\u5408\u3060\u3051\u3067\u3059\u3002"}, {"question": "\u30af\u30ed\u30fc\u30c7\u30a3\u30c3\u30af\u30fb\u30bd\u30ed\uff1a\u30c6\u30fc\u30d6\u30eb\u306e\u5217\u3092\u7a7a\u306b\u3059\u308b\u3053\u3068\u3092\u9ad8\u5ea6\u306a\u30c6\u30af\u30cb\u30c3\u30af\u3068\u898b\u306a\u3055\u308c\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u306e\u6069\u6075\u3092\u6700\u5927\u9650\u306b\u6d3b\u304b\u3059\u305f\u3081\u306b\u3001\u3044\u3064\u3053\u306e\u52d5\u304d\u3092\u512a\u5148\u3059\u3079\u304d\u3067\u3057\u3087\u3046\u304b\uff1f", "answer": "\u30c6\u30fc\u30d6\u30eb\u306e\u5217\u3092\u7a7a\u306b\u3059\u308b\u3053\u3068\u306f\u3001\u30ad\u30f3\u30b0\uff08\u304a\u3088\u3073\u305d\u308c\u306b\u4ed8\u968f\u3059\u308b\u30b7\u30fc\u30b1\u30f3\u30b9\uff09\u5c02\u7528\u306e\u30b9\u307a\u30fc\u30b9\u3092\u4f5c\u308a\u51fa\u3059\u3068\u3044\u3046\u91cd\u8981\u306a\u9ad8\u5ea6\u306a\u30c6\u30af\u30cb\u30c3\u30af\u3067\u3059\u3002\u3053\u306e\u52d5\u304d\u306f\u3001\u67d4\u8edf\u6027\u3092\u6975\u3081\u307e\u3059\u3002\u4ed6\u306e\u624b\u6bb5\u304c\u30d6\u30ed\u30c3\u30af\u3055\u308c\u3066\u3044\u308b\u5834\u5408\u3067\u3082\u3001\u9577\u3044\u30ab\u30fc\u30c9\u306e\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u30b7\u30d5\u30c8\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u8907\u6570\u306e\u30ad\u30f3\u30b0\u304c\u4f7f\u7528\u3067\u304d\u308b\u5834\u5408\u3001\u307e\u305f\u306f\u9577\u3044\u30c6\u30fc\u30d6\u30eb\u306e\u30ab\u30fc\u30c9\u306e\u5c71\u306e\u4e0b\u306b\u3042\u308b\u96a0\u3055\u308c\u305f\u30ab\u30fc\u30c9\u3092\u53d6\u308a\u623b\u3059\u5fc5\u8981\u304c\u3042\u308b\u5834\u5408\u306b\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3060\u3057\u3001\u30ad\u30f3\u30b0\u306e\u30b9\u30fc\u30c8\u3092\u8003\u616e\u305b\u305a\u306b\u5217\u3092\u81ea\u52d5\u7684\u306b\u7a7a\u306b\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002\u6f5c\u5728\u7684\u306a\u30d5\u30a1\u30a6\u30f3\u30c7\u30fc\u30b7\u30e7\u30f3\u3068\u306e\u4e00\u81f4\u306b\u30b9\u30fc\u30c8\u3092\u5408\u308f\u305b\u3088\u3046\u3068\u3057\u3066\u3001\u305d\u306e\u52d5\u304d\u306b\u898b\u5408\u3046\u4fa1\u5024\u304c\u3042\u308b\u304b\u3069\u3046\u304b\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u5217\u3054\u3068\u306e\u5408\u8a08\u3068\u96a0\u3055\u308c\u305f\u30ab\u30fc\u30c9\u306e\u6bd4\u8f03\u8868\u306f\u3001\u6700\u521d\u306b\u3069\u306e\u5217\u3092\u7a7a\u306b\u3059\u308b\u3079\u304d\u304b\u3092\u8996\u899a\u7684\u306b\u793a\u3057\u307e\u3059\u3002"}, {"question": "\u7279\u5b9a\u306e\u30ab\u30fc\u30c9\u3092\u5f15\u304f\u78ba\u7387\u3092\u6df1\u304f\u5206\u6790\u3059\u308b\u3053\u3068\u3067\u3001\u30af\u30ed\u30fc\u30c7\u30a3\u30c3\u30af\u30fb\u30bd\u30ed\u306e\u30d7\u30ec\u30a4\u3092\u3069\u306e\u3088\u3046\u306b\u5f37\u5316\u3067\u304d\u307e\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u3053\u306e\u9762\u3067\u5f79\u7acb\u3064\u30ea\u30bd\u30fc\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u7279\u5b9a\u306e\u30ab\u30fc\u30c9\u3092\u5f15\u304f\u78ba\u7387\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u5927\u304d\u306a\u5229\u70b9\u3068\u306a\u308a\u307e\u3059\u3002\u5404\u30e9\u30f3\u30af\u304c4\u679a\u3042\u308b\u3053\u3068\u3092\u77e5\u308c\u3070\u3001\u7279\u5b9a\u306e\u30ab\u30fc\u30c9\u304c\u3044\u3064\u3069\u3053\u3067\u73fe\u308c\u308b\u304b\u3092\u4e88\u6e2c\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u77e5\u8b58\u306f\u3001\u30ab\u30fc\u30c9\u3092\u79fb\u52d5\u3057\u3001\u5217\u3092\u958b\u3051\u308b\u305f\u3081\u306e\u3088\u308a\u8ce2\u660e\u306a\u6c7a\u5b9a\u3092\u5bb9\u6613\u306b\u3057\u307e\u3059\u3002\u4e00\u90e8\u306e\u71b1\u5fc3\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u60c5\u5831\u3092\u57fa\u306b\u6c7a\u5b9a\u3059\u308b\u305f\u3081\u306b\u3001\u5217\u3067\u3069\u306e\u30b9\u30fc\u30c4/\u30e9\u30f3\u30af\u306b\u591a\u304f\u306e\u96a0\u3055\u308c\u305f\u30ab\u30fc\u30c9\u304c\u3042\u308b\u304b\u3092\u8ffd\u8de1\u3057\u3066\u3044\u307e\u3059\u3002\u30bd\u30ea\u30c6\u30a3\u30a2\u30fb\u30bd\u30eb\u30d0\u30fc\u3084\u305d\u306e\u4ed6\u306e\u5206\u6790\u30bd\u30d5\u30c8\u30a6\u30a7\u30a2\u306a\u3069\u306e\u30ea\u30bd\u30fc\u30b9\u306f\u3001\u30b2\u30fc\u30e0\u306e\u72b6\u614b\u3092\u5206\u6790\u3057\u3001\u78ba\u7387\u306e\u898b\u7a4d\u3082\u308a\u3092\u63d0\u4f9b\u3067\u304d\u307e\u3059\u3002\u78ba\u7387\u306e\u8a08\u7b97\u306f\u3001\u30ab\u30fc\u30c9\u30b2\u30fc\u30e0\u306e\u73fe\u72b6\uff08\u65e2\u77e5\u306e\u30ab\u30fc\u30c9\u306e\u6570\u3068\u305d\u306e\u30b9\u30fc\u30c4\uff09\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u3002"}, {"question": "\u30af\u30ed\u30fc\u30c7\u30a3\u30c3\u30af\u30fb\u30bd\u30ed\u3067\u30ab\u30fc\u30c9\u3092\u914d\u308b\u3053\u3068\u3092\u652f\u914d\u3059\u308b\u57fa\u790e\u3068\u306a\u308b\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u3084\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u3053\u308c\u3089\u306e\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u30b2\u30fc\u30e0\u306e\u96e3\u6613\u5ea6\u3092\u3069\u306e\u3088\u3046\u306b\u5de6\u53f3\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30af\u30ed\u30fc\u30c7\u30a3\u30c3\u30af\u30fb\u30bd\u30ed\u306e\u30ab\u30fc\u30c9\u914d\u308a\u306f\u901a\u5e38\u3001\u64ec\u4f3c\u4e71\u6570\u30b8\u30a7\u30cd\u30ec\u30fc\u30bf\u30fc\uff08PRNG\uff09\u306b\u3088\u3063\u3066\u652f\u914d\u3055\u308c\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u30c6\u30fc\u30d6\u30eb\u3068\u30b9\u30c8\u30c3\u30af\u306e\u6700\u521d\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3068\u30ab\u30fc\u30c9\u306e\u9806\u5e8f\u3092\u6c7a\u5b9a\u3057\u307e\u3059\u3002\u30c7\u30b8\u30bf\u30eb\u5b9f\u88c5\u306b\u304a\u3051\u308b\u30ab\u30fc\u30c9\u30b7\u30e3\u30c3\u30d5\u30eb\u30eb\u30fc\u30c1\u30f3\u3084\u3001\u7269\u7406\u30d0\u30fc\u30b8\u30e7\u30f3\u3067\u306e\u30e6\u30fc\u30b6\u30fc\u306b\u3088\u308b\u30b7\u30e3\u30c3\u30d5\u30eb\u3082\u8ca2\u732e\u3057\u307e\u3059\u3002\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u7279\u5b9a\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u306e\u51fa\u73fe\u78ba\u7387\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u3053\u308c\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u30b7\u30ca\u30ea\u30aa\u304c\u4ed6\u306e\u30b7\u30ca\u30ea\u30aa\u3088\u308a\u3082\u89e3\u304d\u3084\u3059\u3044\u3068\u3044\u3046\u4e8b\u5b9f\u3092\u901a\u3057\u3066\u3001\u76f4\u63a5\u30b2\u30fc\u30e0\u306e\u96e3\u6613\u5ea6\u3092\u6c7a\u5b9a\u3057\u307e\u3059\u3002PRNG\u306f\u3001\u30b2\u30fc\u30e0\u304c\u7c21\u5358\u3059\u304e\u308b\u304b\u96e3\u3057\u3059\u304e\u308b\u72b6\u614b\u306b\u306a\u3089\u306a\u3044\u3088\u3046\u306b\u300c\u516c\u5e73\u6027\u300d\u3092\u78ba\u4fdd\u3059\u308b\u53ef\u80fd\u6027\u3082\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u5024\u3092\u6bd4\u8f03\u3057\u3066\u3001\u305d\u308c\u3089\u304c\u30a6\u30a7\u30a4\u30c8\u3055\u308c\u3066\u3044\u308b\u304b\u3069\u3046\u304b\u3092\u7406\u89e3\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u3055\u307e\u3056\u307e\u306a\u30d0\u30ea\u30a2\u30f3\u30c8\uff08\u305f\u3068\u3048\u3070\u3001\u30d9\u30ac\u30b9\u30fb\u30bd\u30ed\uff09\u306f\u30af\u30ed\u30fc\u30c7\u30a3\u30c3\u30af\u30fb\u30bd\u30ed\u306e\u57fa\u672c\u30eb\u30fc\u30eb\u3092\u3069\u306e\u3088\u3046\u306b\u4fee\u6b63\u3057\u3001\u30b2\u30fc\u30e0\u306e\u8907\u96d1\u3055\u3068\u6226\u7565\u7684\u6df1\u3055\u306b\u3069\u306e\u3088\u3046\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u304b\uff1f", "answer": "\u30af\u30ed\u30fc\u30c7\u30a3\u30c3\u30af\u30fb\u30bd\u30ed\u306b\u306f\u3001\u8907\u96d1\u3055\u3068\u6226\u7565\u7684\u6df1\u3055\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u3001\u30b3\u30a2\u30eb\u30fc\u30eb\u3092\u5909\u66f4\u3059\u308b\u3044\u304f\u3064\u304b\u306e\u30d0\u30ea\u30a2\u30f3\u30c8\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d9\u30ac\u30b9\u30fb\u30bd\u30ed\u306f\u3001\u8ced\u3051\u306e\u8981\u7d20\u3092\u8ffd\u52a0\u3057\u3001\u3042\u306a\u305f\u306f\u8ced\u3051\u91d1\u3067\u30d7\u30ec\u30fc\u3092\u59cb\u3081\u3001\u52dd\u3061\u8ca0\u3051\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u8ca1\u52d9\u7684\u306a\u5c64\u3092\u8ffd\u52a0\u3057\u3001\u52dd\u5229\u6761\u4ef6\u3092\u5909\u66f4\u3059\u308b\u3082\u306e\u3067\u3059\u3002\u9055\u3044\u306f\u3001\u30ab\u30fc\u30c9\u306e\u51fa\u3057\u65b9\u3001\u30b9\u30c8\u30c3\u30af\u304b\u3089\u306e\u30ab\u30fc\u30c9\u6570\u3001\u30d5\u30a1\u30a6\u30f3\u30c7\u30fc\u30b7\u30e7\u30f3\u306e\u69cb\u7bc9\u3001\u3055\u3089\u306b\u306f\u30b9\u30b3\u30a2\u4ed8\u3051\u3068\u3044\u3063\u305f\u6a19\u6e96\u30eb\u30fc\u30eb\u3078\u306e\u4fee\u6b63\u306b\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u5909\u66f4\u3092\u6bd4\u8f03\u3059\u308b\u3053\u3068\u3067\u3001\u305d\u306e\u3088\u3046\u306a\u5fae\u5999\u306a\u5909\u66f4\u304c\u7d14\u7c8b\u306a\u30ab\u30fc\u30c9\u306e\u30b7\u30fc\u30b1\u30f3\u30b9\u304b\u3089\u30ea\u30b9\u30af\u7ba1\u7406\u3078\u306e\u7126\u70b9\u3092\u3069\u306e\u3088\u3046\u306b\u5909\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u306e\u304b\u304c\u308f\u304b\u308a\u307e\u3059\u3002\u30b9\u30c8\u30c3\u30af\u3092\u30d1\u30b9\u3059\u308b\u56de\u6570\u306b\u3088\u3063\u3066\u3001\u30bd\u30ea\u30c6\u30a3\u30a2\u30b2\u30fc\u30e0\u306e\u8907\u96d1\u3055\u304c\u5897\u3057\u305f\u308a\u3001\u5236\u9650\u3055\u308c\u305f\u308a\u3057\u307e\u3059\u3002"}, {"question": "PC\u3001iOS\u3001Android\u306a\u3069\u306e\u3055\u307e\u3056\u307e\u306a\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u30af\u30ed\u30fc\u30c7\u30a3\u30c3\u30af\u30fb\u30bd\u30ed\u3092\u30d7\u30ec\u30a4\u3059\u308b\u969b\u306b\u4e00\u822c\u7684\u306a\u4e92\u63db\u6027\u554f\u984c\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u306e\u8ee2\u9001\u306f\u901a\u5e38\u30b5\u30dd\u30fc\u30c8\u3055\u308c\u3066\u3044\u307e\u3059\u304b\uff1f", "answer": "\u4e92\u63db\u6027\u554f\u984c\u306f\u3001\u7279\u5b9a\u306e\u30af\u30ed\u30fc\u30c7\u30a3\u30c3\u30af\u30fb\u30bd\u30ed\u30a2\u30d7\u30ea\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u3002\u9055\u3044\u306b\u306f\u3001\u8996\u899a\u7684\u306a\u30ec\u30a4\u30a2\u30a6\u30c8\u3001\u30bf\u30c3\u30c1\u30b9\u30af\u30ea\u30fc\u30f3\u306e\u53cd\u5fdc\u529b\u3001\u304a\u3088\u3073\u5229\u7528\u53ef\u80fd\u306a\u6a5f\u80fd\u304c\u542b\u307e\u308c\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u306e\u8ee2\u9001\u306f\u983b\u7e41\u306b\u5236\u9650\u3055\u308c\u307e\u3059\u3002\u591a\u304f\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u306f\u3001\u7570\u306a\u308b\u30d5\u30a1\u30a4\u30eb\u5f62\u5f0f\u3084\u30af\u30e9\u30a6\u30c9\u7d71\u5408\u306e\u6b20\u5982\u306e\u305f\u3081\u3001\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u540c\u671f\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u307e\u305b\u3093\u3002\u6c7a\u5b9a\u7684\u306a\u7b54\u3048\u3092\u5f97\u308b\u306b\u306f\u3001\u958b\u767a\u8005\u306e\u660e\u793a\u7684\u306a\u30b5\u30dd\u30fc\u30c8\u60c5\u5831\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u3001Web\u30d9\u30fc\u30b9\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u306f\u3001\u30d6\u30e9\u30a6\u30b6\u306eCookie\u306b\u30bb\u30fc\u30d6\u3092\u4f9d\u5b58\u3059\u308b\u3053\u3068\u304c\u591a\u304f\u3001\u3053\u308c\u306fiOS\u307e\u305f\u306fAndroid\u30a2\u30d7\u30ea\u306b\u30b9\u30e0\u30fc\u30ba\u306b\u79fb\u884c\u3055\u308c\u306a\u3044\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306e\u7279\u5b9a\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u304c\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u7528\u3067\u304d\u308b\u304b\u3069\u3046\u304b\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30af\u30ed\u30fc\u30c7\u30a3\u30c3\u30af\u30fb\u30bd\u30ed\u306e\u6a19\u6e96\u7684\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u8d85\u3048\u3066\u3001\u96a0\u3055\u308c\u305f\u30c6\u30fc\u30de\u3001\u30a2\u30f3\u30ed\u30c3\u30af\u53ef\u80fd\u306a\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3001\u307e\u305f\u306f\u7279\u5225\u306a\u30ab\u30fc\u30c9\u30c7\u30c3\u30ad\u306f\u3042\u308a\u307e\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u306b\u30a2\u30af\u30bb\u30b9\u3059\u308b\u65b9\u6cd5\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u591a\u304f\u306e\u30af\u30ed\u30fc\u30c7\u30a3\u30c3\u30af\u30fb\u30bd\u30ed\u306e\u5b9f\u88c5\u3067\u306f\u3001\u96a0\u3055\u308c\u305f\u30c6\u30fc\u30de\u3001\u30a2\u30f3\u30ed\u30c3\u30af\u53ef\u80fd\u306a\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3001\u307e\u305f\u306f\u7279\u5225\u306a\u30ab\u30fc\u30c9\u30c7\u30c3\u30ad\u304c\u63d0\u4f9b\u3055\u308c\u3066\u3044\u308b\u3002\u305d\u308c\u3089\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u306e\u306f\u3001\u7279\u5b9a\u306e\u30b2\u30fc\u30e0\u5185\u9054\u6210\u3092\u5b8c\u4e86\u3057\u305f\u5834\u5408\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u9023\u7d9a\u3057\u3066\u4e00\u5b9a\u6570\u306e\u30b2\u30fc\u30e0\u306b\u52dd\u5229\u3059\u308b\u3001\u9ad8\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u3001\u30e6\u30fc\u30b6\u30fc\u30a4\u30f3\u30bf\u30fc\u30d5\u30a7\u30fc\u30b9\u5185\u306e\u79d8\u5bc6\u306e\u30af\u30ea\u30c3\u30af\u7d44\u307f\u5408\u308f\u305b\u3092\u767a\u898b\u3059\u308b\u306a\u3069\u306e\u9054\u6210\u3067\u3059\u3002\u3053\u308c\u3089\u306e\u9054\u6210\u306f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3068\u3057\u3066\u5b9f\u88c5\u3055\u308c\u3066\u304a\u308a\u3001\u4e00\u822c\u7684\u306b\u30af\u30ed\u30fc\u30c7\u30a3\u30c3\u30af\u30fb\u30bd\u30ed\u30b2\u30fc\u30e0\u3067\u6587\u66f8\u5316\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002\u30d2\u30f3\u30c8\u3092\u5f97\u308b\u305f\u3081\u3001\u30e1\u30cb\u30e5\u30fc\u3092\u8abf\u3079\u3066\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u30d5\u30a9\u30fc\u30e9\u30e0\u3092\u78ba\u8a8d\u3057\u3001\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u7279\u5b9a\u306e\u30ab\u30fc\u30c9\u3092\u30af\u30ea\u30c3\u30af\u3059\u308b\u3053\u3068\u3084\u3001\u7570\u5e38\u306a\u884c\u52d5\u3092\u5b9f\u884c\u3057\u3066\u96a0\u3057\u30a4\u30d9\u30f3\u30c8\u3092\u30c8\u30ea\u30ac\u30fc\u3057\u3001\u65b0\u3057\u3044\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u3053\u3068\u3092\u542b\u307f\u307e\u3059\u3002\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u3042\u308b\u304b\u3069\u3046\u304b\u306f\u3001\u3069\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u306e\u30b2\u30fc\u30e0\u3092\u30d7\u30ec\u30a4\u3057\u3066\u3044\u308b\u304b\u306b\u4f9d\u5b58\u3057\u307e\u3059\u3002"}]
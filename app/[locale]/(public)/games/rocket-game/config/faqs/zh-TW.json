[{"question": "\u5982\u4f55\u5728\u706b\u7bad\u904a\u6232\u4e2d\u57f7\u884c\u57fa\u790e\u706b\u7bad\u767c\u5c04\uff1f", "answer": "\u5728\u706b\u7bad\u904a\u6232\u4e2d\u57f7\u884c\u57fa\u790e\u706b\u7bad\u767c\u5c04\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u78ba\u4fdd\u60a8\u7684\u706b\u7bad\u5df2\u5b8c\u5168\u52a0\u6eff\u71c3\u6599\u3002\u6b65\u9a5f2 - \u6309\u4e0b\u87a2\u5e55\u4e2d\u592e\u7684\"\u767c\u5c04\"\u6309\u9215\u3002\u6b65\u9a5f3 - \u4f7f\u7528\u65b9\u5411\u9375\u63a7\u5236\u60a8\u7684\u706b\u7bad\u3002\u4f8b\u5982\uff0c\u767c\u5c04\"\u5165\u9580\u706b\u7bad\"\u81f3\u5c11\u9700\u8981 100 \u55ae\u4f4d\u71c3\u6599\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u767c\u5c04\u904e\u7a0b\u60f3\u50cf\u6210\u9ede\u71c3\u7159\u706b\uff1b\u60a8\u9700\u8981\u9069\u91cf\u7684\u71c3\u6599\u548c\u7cbe\u78ba\u7684\u63a7\u5236\u624d\u80fd\u9054\u5230\u9810\u671f\u7684\u9ad8\u5ea6\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u7684\u706b\u7bad\u5728\u706b\u7bad\u904a\u6232\u4e2d\u6703\u5931\u63a7\u65cb\u8f49\uff1f", "answer": "\u60a8\u7684\u706b\u7bad\u53ef\u80fd\u56e0\u91cd\u91cf\u5206\u914d\u4e0d\u7576\u6216\u63a8\u529b\u904e\u5927\u800c\u5931\u63a7\u65cb\u8f49\u3002\u70ba\u89e3\u6c7a\u6b64\u554f\u984c\uff1a\u6b65\u9a5f1 - \u6aa2\u67e5\"\u706b\u7bad\u914d\u7f6e\"\u9078\u55ae\u4e2d\u7684\u91cd\u91cf\u5e73\u8861\u3002\u6b65\u9a5f2 - \u8abf\u6574\u63a8\u529b\u7d1a\u5225\u4ee5\u5339\u914d\u706b\u7bad\u8a2d\u8a08\u3002\u6b65\u9a5f3 - \u4f7f\u7528\u7a69\u5b9a\u7ffc\u4ee5\u6539\u5584\u63a7\u5236\u529b\u3002\u4f8b\u5982\uff0c\"\u7375\u9df9X\"\u6a21\u578b\u5982\u679c\u63a8\u529b\u8d85\u904e80%\u5247\u5bb9\u6613\u65cb\u8f49\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u6bd4\u8f03\u63a8\u529b\u7d1a\u5225\u548c\u91cd\u91cf\u5206\u914d\u4ee5\u9054\u5230\u6700\u4f73\u6548\u80fd\u3002]"}, {"question": "\u5728\u706b\u7bad\u904a\u6232\u4e2d\uff0c\u6211\u9700\u8981\u638c\u63e1\u54ea\u4e9b\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u5728\u706b\u7bad\u904a\u6232\u4e2d\u638c\u63e1\u57fa\u672c\u63a7\u5236\uff0c\u5305\u62ec\u4e86\u89e3\u767c\u5c04\u3001\u64cd\u63a7\u548c\u8457\u9678\u6a5f\u5236\u3002\u95dc\u9375\u63a7\u5236\u5305\u62ec\"\u767c\u5c04\"\u6309\u9215\u3001\u7528\u65bc\u64cd\u63a7\u7684\u65b9\u5411\u9375\u548c\"\u524e\u8eca\"\u6309\u9215\u7528\u65bc\u8457\u9678\u3002\u4f8b\u5982\uff0c\u6709\u6548\u5730\u4f7f\u7528\u65b9\u5411\u9375\u53ef\u4ee5\u5e6b\u52a9\u60a8\u5728\u5c0f\u884c\u661f\u5e36\u4e2d\u7a7f\u68ad\u3002[\u6d41\u7a0b\u5716\u89e3: \u53ef\u8996\u5316\u63a7\u5236\u4f48\u5c40\u53ca\u5176\u529f\u80fd\u4ee5\u66f4\u597d\u5730\u7406\u89e3\u3002]"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u53ef\u4ee5\u5e6b\u52a9\u6211\u5728\u706b\u7bad\u904a\u6232\u4e2d\u7372\u5f97\u9ad8\u5206\uff1f", "answer": "\u5728\u706b\u7bad\u904a\u6232\u4e2d\u7372\u5f97\u9ad8\u5206\u9700\u8981\u7d50\u5408\u9ad8\u6548\u7684\u71c3\u6599\u7ba1\u7406\u3001\u7cbe\u78ba\u7684\u64cd\u63a7\u548c\u7b56\u7565\u6027\u5730\u4f7f\u7528\u9053\u5177\u3002\u6b65\u9a5f1 - \u898f\u5283\u8def\u7dda\u4ee5\u6700\u5927\u7a0b\u5ea6\u5730\u6e1b\u5c11\u71c3\u6599\u6d88\u8017\u3002\u6b65\u9a5f2 - \u6536\u96c6\u5982\"\u52a0\u901f\"\u548c\"\u9632\u8b77\u7f69\"\u7b49\u9053\u5177\u3002\u6b65\u9a5f3 - \u907f\u514d\u969c\u7919\u7269\u548c\u6575\u4eba\u3002\u4f8b\u5982\uff0c\u5728\u6b63\u78ba\u7684\u6642\u6a5f\u4f7f\u7528\"\u52a0\u901f\"\u53ef\u4ee5\u5e6b\u52a9\u60a8\u66f4\u5feb\u5730\u8986\u84cb\u66f4\u591a\u8ddd\u96e2\u3002[\u591a\u65b9\u6848\u6bd4\u8f03: \u6bd4\u8f03\u5404\u7a2e\u71c3\u6599\u7ba1\u7406\u548c\u969c\u7919\u7269\u907f\u514d\u7b56\u7565\u3002]"}, {"question": "\u5982\u4f55\u5728\u706b\u7bad\u904a\u6232\u4e2d\u512a\u5316\u706b\u7bad\u7684\u71c3\u6599\u6548\u7387\uff1f", "answer": "\u512a\u5316\u706b\u7bad\u71c3\u6599\u6548\u7387\u9700\u8981\u4ed4\u7d30\u7684\u898f\u5283\u548c\u57f7\u884c\u3002\u6b65\u9a5f1 - \u9078\u64c7\u6700\u76f4\u63a5\u7684\u8def\u7dda\u5230\u9054\u76ee\u7684\u5730\u3002\u6b65\u9a5f2 - \u4f7f\u7528\"\u7bc0\u7701\u6a21\u5f0f\"\u4f86\u6e1b\u5c11\u71c3\u6599\u6d88\u8017\u3002\u6b65\u9a5f3 - \u907f\u514d\u4e0d\u5fc5\u8981\u7684\u64cd\u4f5c\u3002\u4f8b\u5982\uff0c\"\u7da0\u8272\u706b\u7bad\" \u6a21\u578b\u4e2d\u7684\"\u7bc0\u7701\u6a21\u5f0f\"\u53ef\u4ee5\u7bc0\u7701\u9ad8\u905420%\u7684\u71c3\u6599\u3002 [\u6bd4\u55bb\u8aaa\u660e: \u5c07\u71c3\u6599\u6548\u7387\u60f3\u50cf\u6210\u958b\u8eca\uff1b\u5e73\u7a69\u4e14\u7a69\u5b9a\u7684\u99d5\u99db\u53ef\u4ee5\u7bc0\u7701\u66f4\u591a\u6c7d\u6cb9\u3002]"}, {"question": "\u5728\u706b\u7bad\u904a\u6232\u4e2d\uff0c\u5b89\u5168\u8457\u9678\u7684\u6700\u4f73\u5be6\u52d9\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u706b\u7bad\u904a\u6232\u4e2d\u5b89\u5168\u8457\u9678\u9700\u8981\u7cbe\u78ba\u6027\u548c\u6642\u6a5f\u3002\u6b65\u9a5f1 - \u4ee5\u53d7\u63a7\u901f\u5ea6\u63a5\u8fd1\u8457\u9678\u5340\u3002\u6b65\u9a5f2 - \u4f7f\u7528\"\u524e\u8eca\"\u6309\u9215\u6e1b\u901f\u3002\u6b65\u9a5f3 - \u5c07\u706b\u7bad\u8207\u8457\u9678\u5e73\u53f0\u5c0d\u9f4a\u3002\u4f8b\u5982\uff0c\u8b93\"\u5165\u9580\u706b\u7bad\"\u7684\u8457\u9678\u901f\u5ea6\u4f4e\u65bc 50 \u55ae\u4f4d\u53ef\u78ba\u4fdd\u5b89\u5168\u8457\u9678\u3002[\u6d41\u7a0b\u5716\u89e3: \u9010\u6b65\u53ef\u8996\u5316\u8457\u9678\u904e\u7a0b\u4ee5\u66f4\u597d\u5730\u57f7\u884c\u3002]"}, {"question": "\u904a\u6232\u7684\u7269\u7406\u5f15\u64ce\u5982\u4f55\u5728\u706b\u7bad\u904a\u6232\u4e2d\u5f71\u97ff\u706b\u7bad\u6548\u80fd\uff1f", "answer": "\u706b\u7bad\u904a\u6232\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u6a21\u64ec\u73fe\u5be6\u7269\u7406\uff0c\u901a\u904e\u91cd\u529b\u3001\u63a8\u529b\u548c\u7a7a\u6c23\u963b\u529b\u7b49\u56e0\u7d20\u5f71\u97ff\u706b\u7bad\u6548\u80fd\u3002\u4f8b\u5982\uff0c\"\u91cd\u529b\u4e95\"\u529f\u80fd\u6703\u5728\u9ad8\u91cd\u529b\u5340\u57df\u589e\u52a0\u71c3\u6599\u6d88\u8017\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u6bd4\u8f03\u4e0d\u540c\u91cd\u529b\u5340\u57df\u7684\u706b\u7bad\u6548\u80fd\u4ee5\u9054\u5230\u6700\u4f73\u7b56\u7565\u3002]"}, {"question": "\u4e0d\u540c\u7a2e\u985e\u7684\u71c3\u6599\u5728\u706b\u7bad\u904a\u6232\u4e2d\u5982\u4f55\u5f71\u97ff\u706b\u7bad\u901f\u5ea6\uff1f", "answer": "\u706b\u7bad\u904a\u6232\u4e2d\u4e0d\u540c\u7684\u71c3\u6599\u7a2e\u985e\u6703\u5f71\u97ff\u706b\u7bad\u7684\u901f\u5ea6\u548c\u6548\u7387\u3002\u6b65\u9a5f1 - \u57fa\u65bc\u4efb\u52d9\u9700\u6c42\u9078\u64c7\u71c3\u6599\u985e\u578b\u3002\u6b65\u9a5f2 - \"\u9ad8\u80fd\u71c3\u6599\"\u6703\u63d0\u9ad8\u901f\u5ea6\uff0c\u4f46\u6d88\u8017\u66f4\u591a\u71c3\u6599\u3002\u6b65\u9a5f3 - \"\u7bc0\u7701\u71c3\u6599\"\u901f\u5ea6\u8f03\u6162\uff0c\u4f46\u6548\u7387\u66f4\u9ad8\u3002\u4f8b\u5982\uff0c\"\u5feb\u901f\u706b\u7bad\"\u4e2d\u7684\"\u9ad8\u80fd\u71c3\u6599\"\u53ef\u4ee5\u5c07\u901f\u5ea6\u63d0\u5347 30%\u3002[\u591a\u65b9\u6848\u6bd4\u8f03: \u6bd4\u8f03\u4e0d\u540c\u71c3\u6599\u985e\u578b\u7684\u512a\u7f3a\u9ede\u4ee5\u9069\u7528\u65bc\u5404\u7a2e\u4efb\u52d9\u3002]"}, {"question": "\u5982\u4f55\u5728\u706b\u7bad\u904a\u6232\u4e2d\u5c07\u6211\u7684\u904a\u6232\u9032\u5ea6\u8f49\u79fb\u5230\u65b0\u88dd\u7f6e\uff1f", "answer": "\u5c07\u706b\u7bad\u904a\u6232\u9032\u5ea6\u8f49\u79fb\u5230\u65b0\u88dd\u7f6e\u975e\u5e38\u7c21\u55ae\u3002\u6b65\u9a5f1 - \u78ba\u4fdd\u60a8\u7684\u904a\u6232\u5df2\u9023\u63a5\u5230\u60a8\u7684\u5e33\u6236\u3002\u6b65\u9a5f2 - \u5728\u60a8\u7684\u65b0\u88dd\u7f6e\u4e0a\u767b\u5165\u76f8\u540c\u7684\u5e33\u6236\u3002\u6b65\u9a5f3 - \u5f9e\u96f2\u7aef\u540c\u6b65\u60a8\u7684\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u5c07\u60a8\u7684\u904a\u6232\u9023\u7d50\u5230\"\u706b\u7bad\u904a\u6232\u5e33\u6236\"\u53ef\u78ba\u4fdd\u7121\u7e2b\u8cc7\u6599\u8f49\u79fb\u3002[\u6d41\u7a0b\u5716\u89e3: \u53ef\u8996\u5316\u5e33\u6236\u9023\u7d50\u548c\u8cc7\u6599\u540c\u6b65\u6b65\u9a5f\u3002]"}, {"question": "\u6211\u5728\u706b\u7bad\u904a\u6232\u4e2d\u54ea\u88e1\u53ef\u4ee5\u627e\u5230\u96b1\u85cf\u7684\u6536\u96c6\u54c1\uff1f", "answer": "\u706b\u7bad\u904a\u6232\u4e2d\u7684\u96b1\u85cf\u6536\u96c6\u54c1\u901a\u5e38\u4f4d\u65bc\u96b1\u853d\u6216\u96e3\u4ee5\u5230\u9054\u7684\u5340\u57df\u3002\u6b65\u9a5f1 - \u63a2\u7d22\u5730\u5716\u4e0a\u7684\u6bcf\u500b\u89d2\u843d\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u5982\"X \u5c04\u7dda\u8996\u89ba\"\u7b49\u9053\u5177\u4f86\u767c\u73fe\u96b1\u85cf\u7269\u54c1\u3002\u6b65\u9a5f3 - \u6aa2\u67e5\u969c\u7919\u7269\u5f8c\u9762\u548c\u6d1e\u7a74\u5167\u3002\u4f8b\u5982\uff0c\"\u91d1\u8272\u706b\u7bad\u90e8\u4ef6\"\u96b1\u85cf\u5728\"\u6c34\u6676\u6d1e\u7a9f\"\u7b49\u7d1a\u7684\u7011\u5e03\u5f8c\u9762\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u96b1\u85cf\u6536\u96c6\u54c1\u60f3\u50cf\u6210\u5f69\u86cb\uff1b\u5b83\u5011\u9700\u8981\u5fb9\u5e95\u63a2\u7d22\u624d\u80fd\u627e\u5230\u3002]"}]
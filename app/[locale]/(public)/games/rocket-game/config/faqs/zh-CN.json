[{"question": "\u5982\u4f55\u5728\u706b\u7bad\u6e38\u620f\u4e2d\u8fdb\u884c\u57fa\u672c\u706b\u7bad\u53d1\u5c04\uff1f", "answer": "\u8981\u5728\u706b\u7bad\u6e38\u620f\u4e2d\u8fdb\u884c\u57fa\u672c\u706b\u7bad\u53d1\u5c04\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u786e\u4fdd\u60a8\u7684\u706b\u7bad\u5df2\u5b8c\u5168\u52a0\u6ee1\u71c3\u6599\u3002\u6b65\u9aa42 - \u6309\u5c4f\u5e55\u4e2d\u5fc3\u5904\u7684\"\u53d1\u5c04\"\u6309\u94ae\u3002\u6b65\u9aa43 - \u4f7f\u7528\u65b9\u5411\u76d8\u63a7\u5236\u60a8\u7684\u706b\u7bad\u3002\u4f8b\u5982\uff0c\u53d1\u5c04\"\u5165\u95e8\u706b\u7bad\"\u81f3\u5c11\u9700\u8981 100 \u4e2a\u5355\u4f4d\u7684\u71c3\u6599\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u53d1\u5c04\u8fc7\u7a0b\u60f3\u8c61\u4e3a\u70b9\u71c3\u70df\u82b1; \u60a8\u9700\u8981\u6b63\u786e\u7684\u71c3\u6599\u91cf\u548c\u7cbe\u786e\u7684\u63a7\u5236\u65b9\u5411\u624d\u80fd\u8fbe\u5230\u9884\u671f\u7684\u9ad8\u5ea6\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u7684\u706b\u7bad\u5728\u706b\u7bad\u6e38\u620f\u4e2d\u4f1a\u5931\u63a7\u65cb\u8f6c\uff1f", "answer": "\u60a8\u7684\u706b\u7bad\u53ef\u80fd\u7531\u4e8e\u91cd\u91cf\u5206\u5e03\u4e0d\u5747\u6216\u63a8\u529b\u8fc7\u5927\u800c\u5931\u63a7\u65cb\u8f6c\u3002\u8981\u89e3\u51b3\u8fd9\u4e2a\u95ee\u9898\uff1a\u6b65\u9aa41 - \u68c0\u67e5\"\u706b\u7bad\u914d\u7f6e\"\u83dc\u5355\u4e2d\u7684\u91cd\u91cf\u5e73\u8861\u3002\u6b65\u9aa42 - \u8c03\u6574\u63a8\u529b\u6c34\u5e73\u4ee5\u5339\u914d\u706b\u7bad\u7684\u8bbe\u8ba1\u3002\u6b65\u9aa43 - \u4f7f\u7528\u7a33\u5b9a\u5668\u7ffc\u7247\u6765\u63d0\u9ad8\u63a7\u5236\u529b\u3002\u4f8b\u5982\uff0c\u5982\u679c\"\u730e\u9e70 X\"\u578b\u53f7\u7684\u63a8\u529b\u8d85\u8fc7 80%\uff0c\u5219\u5bb9\u6613\u65cb\u8f6c\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6bd4\u8f83\u63a8\u529b\u6c34\u5e73\u548c\u91cd\u91cf\u5206\u5e03\uff0c\u4ee5\u83b7\u5f97\u6700\u4f73\u6027\u80fd\u3002]"}, {"question": "\u5728\u706b\u7bad\u6e38\u620f\u4e2d\uff0c\u6211\u9700\u8981\u638c\u63e1\u54ea\u4e9b\u5fc5\u4e0d\u53ef\u5c11\u7684\u63a7\u5236\uff1f", "answer": "\u5728\u706b\u7bad\u6e38\u620f\u4e2d\u638c\u63e1\u5fc5\u4e0d\u53ef\u5c11\u7684\u63a7\u5236\uff0c\u9700\u8981\u7406\u89e3\u53d1\u5c04\u3001\u8f6c\u5411\u548c\u7740\u9646\u673a\u5236\u3002\u5173\u952e\u63a7\u5236\u5305\u62ec\"\u53d1\u5c04\"\u6309\u94ae\u3001\u7528\u4e8e\u8f6c\u5411\u7684\u65b9\u5411\u76d8\u548c\u7528\u4e8e\u7740\u9646\u7684\"\u5239\u8f66\"\u6309\u94ae\u3002\u4f8b\u5982\uff0c\u6709\u6548\u5730\u4f7f\u7528\u65b9\u5411\u76d8\u53ef\u4ee5\u5e2e\u52a9\u60a8\u5728\u5c0f\u884c\u661f\u5e26\u4e2d\u5bfc\u822a\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u53ef\u89c6\u5316\u63a7\u5236\u5e03\u5c40\u53ca\u5176\u529f\u80fd\uff0c\u4ee5\u66f4\u597d\u5730\u7406\u89e3\u3002]"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u53ef\u4ee5\u5e2e\u52a9\u6211\u5728\u706b\u7bad\u6e38\u620f\u4e2d\u83b7\u5f97\u9ad8\u5206\uff1f", "answer": "\u5728\u706b\u7bad\u6e38\u620f\u4e2d\u83b7\u5f97\u9ad8\u5206\u9700\u8981\u7ed3\u5408\u9ad8\u6548\u7684\u71c3\u6599\u7ba1\u7406\u3001\u7cbe\u786e\u7684\u8f6c\u5411\u548c\u6218\u7565\u6027\u7684\u9053\u5177\u4f7f\u7528\u3002\u6b65\u9aa41 - \u8ba1\u5212\u60a8\u7684\u8def\u7ebf\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u71c3\u6599\u6d88\u8017\u3002\u6b65\u9aa42 - \u6536\u96c6\u8bf8\u5982\"\u52a0\u901f\"\u548c\"\u62a4\u76fe\"\u4e4b\u7c7b\u7684\u9053\u5177\u3002\u6b65\u9aa43 - \u907f\u514d\u969c\u788d\u7269\u548c\u654c\u4eba\u3002\u4f8b\u5982\uff0c\u5728\u9002\u5f53\u7684\u65f6\u5019\u4f7f\u7528\"\u52a0\u901f\"\u53ef\u4ee5\u5e2e\u52a9\u60a8\u66f4\u5feb\u5730\u8986\u76d6\u66f4\u591a\u8ddd\u79bb\u3002[\u591a\u79cd\u65b9\u6848\u6bd4\u8f83\uff1a\u6bd4\u8f83\u4e0d\u540c\u7684\u71c3\u6599\u7ba1\u7406\u548c\u969c\u788d\u7269\u89c4\u907f\u7b56\u7565\u3002]"}, {"question": "\u5982\u4f55\u5728\u706b\u7bad\u6e38\u620f\u4e2d\u4f18\u5316\u706b\u7bad\u7684\u71c3\u6cb9\u6548\u7387\uff1f", "answer": "\u4f18\u5316\u706b\u7bad\u7684\u71c3\u6cb9\u6548\u7387\u9700\u8981\u4ed4\u7ec6\u7684\u8ba1\u5212\u548c\u6267\u884c\u3002\u6b65\u9aa41 - \u9009\u62e9\u901a\u5f80\u76ee\u6807\u7684\u6700\u76f4\u63a5\u8def\u7ebf\u3002\u6b65\u9aa42 - \u4f7f\u7528\"\u8282\u6cb9\u6a21\u5f0f\"\u6765\u51cf\u5c11\u71c3\u6599\u6d88\u8017\u3002\u6b65\u9aa43 - \u907f\u514d\u4e0d\u5fc5\u8981\u7684\u64cd\u7eb5\u3002\u4f8b\u5982\uff0c\"\u7eff\u8272\u706b\u7bad\"\u578b\u53f7\u7684\"\u8282\u6cb9\u6a21\u5f0f\"\u53ef\u4ee5\u8282\u7ea6\u591a\u8fbe 20% \u7684\u71c3\u6599\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u71c3\u6cb9\u6548\u7387\u60f3\u8c61\u4e3a\u9a7e\u9a76\u6c7d\u8f66\uff1b\u5e73\u7a33\u548c\u7a33\u5b9a\u7684\u9a7e\u9a76\u53ef\u4ee5\u8282\u7701\u66f4\u591a\u6c7d\u6cb9\u3002]"}, {"question": "\u5728\u706b\u7bad\u6e38\u620f\u4e2d\u5b89\u5168\u7740\u9646\u7684\u6700\u4f73\u5b9e\u8df5\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u706b\u7bad\u6e38\u620f\u4e2d\u5b89\u5168\u7740\u9646\u9700\u8981\u7cbe\u786e\u548c\u65f6\u673a\u3002\u6b65\u9aa41 - \u4ee5\u53d7\u63a7\u901f\u5ea6\u63a5\u8fd1\u7740\u9646\u533a\u3002\u6b65\u9aa42 - \u4f7f\u7528\"\u5239\u8f66\"\u6309\u94ae\u51cf\u901f\u3002\u6b65\u9aa43 - \u5c06\u60a8\u7684\u706b\u7bad\u4e0e\u7740\u9646\u5e73\u53f0\u5bf9\u9f50\u3002\u4f8b\u5982\uff0c\u4ee5\u4f4e\u4e8e 50 \u4e2a\u5355\u4f4d\u7684\u901f\u5ea6\u7740\u9646\"\u5165\u95e8\u706b\u7bad\"\u53ef\u786e\u4fdd\u5b89\u5168\u7740\u9646\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u9010\u6b65\u53ef\u89c6\u5316\u7740\u9646\u8fc7\u7a0b\uff0c\u4ee5\u4fbf\u66f4\u597d\u5730\u6267\u884c\u3002]"}, {"question": "\u6e38\u620f\u7269\u7406\u5f15\u64ce\u5982\u4f55\u5f71\u54cd\u706b\u7bad\u5728\u706b\u7bad\u6e38\u620f\u4e2d\u7684\u6027\u80fd\uff1f", "answer": "Rocket Game \u4e2d\u7684\u7269\u7406\u5f15\u64ce\u6a21\u62df\u771f\u5b9e\u4e16\u754c\u7684\u7269\u7406\uff0c\u901a\u8fc7\u8bf8\u5982\u91cd\u529b\u3001\u63a8\u529b\u548c\u7a7a\u6c14\u963b\u529b\u7b49\u56e0\u7d20\u5f71\u54cd\u706b\u7bad\u6027\u80fd\u3002\u4f8b\u5982\uff0c\"\u5f15\u529b\u4e95\"\u529f\u80fd\u4f1a\u589e\u52a0\u9ad8\u91cd\u529b\u533a\u57df\u7684\u71c3\u6599\u6d88\u8017\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6bd4\u8f83\u4e0d\u540c\u91cd\u529b\u533a\u57df\u7684\u706b\u7bad\u6027\u80fd\uff0c\u4ee5\u83b7\u5f97\u6700\u4f73\u7b56\u7565\u3002]"}, {"question": "\u4e0d\u540c\u7c7b\u578b\u7684\u71c3\u6599\u5bf9\u706b\u7bad\u901f\u5ea6\u6709\u4f55\u5f71\u54cd\uff1f", "answer": "Rocket Game \u4e2d\u7684\u4e0d\u540c\u71c3\u6599\u7c7b\u578b\u4f1a\u5f71\u54cd\u706b\u7bad\u7684\u901f\u5ea6\u548c\u6548\u7387\u3002\u6b65\u9aa41 - \u6839\u636e\u60a8\u7684\u4efb\u52a1\u9700\u6c42\u9009\u62e9\u71c3\u6599\u7c7b\u578b\u3002\u6b65\u9aa42 - \"\u9ad8\u80fd\u71c3\u6599\"\u4f1a\u63d0\u9ad8\u901f\u5ea6\uff0c\u4f46\u6d88\u8017\u66f4\u591a\u71c3\u6599\u3002\u6b65\u9aa43 - \"\u8282\u6cb9\u71c3\u6599\"\u901f\u5ea6\u8f83\u6162\uff0c\u4f46\u6548\u7387\u66f4\u9ad8\u3002\u4f8b\u5982\uff0c\"\u52a0\u901f\u706b\u7bad\"\u4e2d\u7684\"\u9ad8\u80fd\u71c3\u6599\"\u53ef\u4ee5\u5c06\u901f\u5ea6\u63d0\u9ad8 30%\u3002[\u591a\u79cd\u65b9\u6848\u6bd4\u8f83\uff1a\u6bd4\u8f83\u4e0d\u540c\u71c3\u6599\u7c7b\u578b\u7684\u4f18\u7f3a\u70b9\uff0c\u4ee5\u9002\u5e94\u5404\u79cd\u4efb\u52a1\u3002]"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684\u706b\u7bad\u6e38\u620f\u8fdb\u5ea6\u8f6c\u79fb\u5230\u65b0\u8bbe\u5907\uff1f", "answer": "\u5c06\u60a8\u7684\u706b\u7bad\u6e38\u620f\u8fdb\u5ea6\u8f6c\u79fb\u5230\u65b0\u8bbe\u5907\u975e\u5e38\u7b80\u5355\u3002\u6b65\u9aa41 - \u786e\u4fdd\u60a8\u7684\u6e38\u620f\u5df2\u94fe\u63a5\u5230\u60a8\u7684\u5e10\u6237\u3002\u6b65\u9aa42 - \u5728\u60a8\u7684\u65b0\u8bbe\u5907\u4e0a\u767b\u5f55\u540c\u4e00\u5e10\u6237\u3002\u6b65\u9aa43 - \u4ece\u4e91\u7aef\u540c\u6b65\u60a8\u7684\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u5c06\u60a8\u7684\u6e38\u620f\u94fe\u63a5\u5230\"\u706b\u7bad\u6e38\u620f\u5e10\u6237\"\u53ef\u786e\u4fdd\u65e0\u7f1d\u6570\u636e\u4f20\u8f93\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u53ef\u89c6\u5316\u5e10\u6237\u94fe\u63a5\u548c\u6570\u636e\u540c\u6b65\u7684\u6b65\u9aa4\u3002]"}, {"question": "\u5728\u54ea\u91cc\u53ef\u4ee5\u627e\u5230\u706b\u7bad\u6e38\u620f\u4e2d\u9690\u85cf\u7684\u6536\u85cf\u54c1\uff1f", "answer": "Rocket Game \u4e2d\u7684\u9690\u85cf\u6536\u85cf\u54c1\u901a\u5e38\u4f4d\u4e8e\u96be\u4ee5\u5230\u8fbe\u6216\u504f\u8fdc\u7684\u5730\u65b9\u3002\u6b65\u9aa41 - \u63a2\u7d22\u5730\u56fe\u7684\u6bcf\u4e00\u4e2a\u89d2\u843d\u3002\u6b65\u9aa42 - \u4f7f\u7528\u8bf8\u5982\"X \u5149\u89c6\u91ce\"\u4e4b\u7c7b\u7684\u9053\u5177\u6765\u53d1\u73b0\u9690\u85cf\u7269\u54c1\u3002\u6b65\u9aa43 - \u68c0\u67e5\u969c\u788d\u7269\u540e\u9762\u548c\u6d1e\u7a74\u4e2d\u3002\u4f8b\u5982\uff0c\"\u91d1\u706b\u7bad\u90e8\u4ef6\"\u9690\u85cf\u5728\"\u6c34\u6676\u6d1e\u7a74\"\u5173\u5361\u7011\u5e03\u540e\u9762\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u9690\u85cf\u7684\u6536\u85cf\u54c1\u60f3\u8c61\u4e3a\u5f69\u86cb\uff1b\u5b83\u4eec\u9700\u8981\u5f7b\u5e95\u7684\u63a2\u7d22\u624d\u80fd\u627e\u5230\u3002]"}]
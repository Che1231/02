[{"question": "\ub85c\ucf13 \uac8c\uc784\uc5d0\uc11c \uae30\ubcf8\uc801\uc778 \ub85c\ucf13 \ubc1c\uc0ac\ub294 \uc5b4\ub5bb\uac8c \uc218\ud589\ud569\ub2c8\uae4c?", "answer": "\ub85c\ucf13 \uac8c\uc784\uc5d0\uc11c \uae30\ubcf8\uc801\uc778 \ub85c\ucf13 \ubc1c\uc0ac\ub97c \ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: \ub2e8\uacc4 1 - \ub85c\ucf13\uc774 \uc644\uc804\ud788 \uc5f0\ub8cc\uac00 \ucc44\uc6cc\uc84c\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2 - \ud654\uba74 \uc911\uc559\uc758 '\ubc1c\uc0ac' \ubc84\ud2bc\uc744 \ub204\ub985\ub2c8\ub2e4. \ub2e8\uacc4 3 - \ubc29\ud5a5 \ud328\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub85c\ucf13\uc744 \uc870\uc885\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc2a4\ud0c0\ud130 \ub85c\ucf13'\uc744 \ubc1c\uc0ac\ud558\ub824\uba74 \ucd5c\uc18c 100 \ub2e8\uc704\uc758 \uc5f0\ub8cc\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ubc1c\uc0ac \uacfc\uc815\uc744 \ubd88\uaf43\ub180\uc774\uc5d0 \ube44\uc720\ud558\uba74, \uc6d0\ud558\ub294 \uace0\ub3c4\uc5d0 \ub3c4\ub2ec\ud558\uae30 \uc704\ud574 \uc801\uc808\ud55c \uc591\uc758 \uc5f0\ub8cc\uc640 \uc815\ud655\ud55c \uc870\ud5a5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.]"}, {"question": "\ub85c\ucf13 \uac8c\uc784\uc5d0\uc11c \ub85c\ucf13\uc774 \uc65c \uc81c\uc5b4 \ubd88\ub2a5 \uc0c1\ud0dc\ub85c \uacc4\uc18d \ud68c\uc804\ud569\ub2c8\uae4c?", "answer": "\ub85c\ucf13\uc774 \uc81c\uc5b4 \ubd88\ub2a5 \uc0c1\ud0dc\ub85c \ud68c\uc804\ud558\ub294 \uc6d0\uc778\uc740 \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \ubb34\uac8c \ubd84\ud3ec \ub610\ub294 \uacfc\ub3c4\ud55c \ucd94\uc9c4\ub825 \ub54c\ubb38\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub97c \ud574\uacb0\ud558\ub824\uba74 \ub2e4\uc74c\uc744 \uc218\ud589\ud558\uc138\uc694: \ub2e8\uacc4 1 - '\ub85c\ucf13 \uad6c\uc131' \uba54\ub274\uc5d0\uc11c \ubb34\uac8c \uade0\ud615\uc744 \ud655\uc778\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2 - \ub85c\ucf13\uc758 \uc124\uacc4\uc5d0 \ub9de\ucdb0 \ucd94\uc9c4\ub825 \uc218\uc900\uc744 \uc870\uc815\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3 - \uc548\uc815\ud310\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc81c\uc5b4\ub825\uc744 \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud314\ucf58 X' \ubaa8\ub378\uc740 \ucd94\uc9c4\ub825\uc774 80%\ub97c \ucd08\uacfc\ud558\uba74 \ud68c\uc804\ud558\ub294 \uacbd\ud5a5\uc774 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ub300\uc870\ud45c: \ucd5c\uc801\uc758 \uc131\ub2a5\uc744 \uc704\ud574 \ucd94\uc9c4\ub825 \uc218\uc900\uacfc \ubb34\uac8c \ubd84\ud3ec\ub97c \ube44\uad50\ud569\ub2c8\ub2e4.]"}, {"question": "\ub85c\ucf13 \uac8c\uc784\uc5d0\uc11c \uc219\ub2ec\ud574\uc57c \ud558\ub294 \ud544\uc218 \uc870\uc791\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub85c\ucf13 \uac8c\uc784\uc5d0\uc11c \ud544\uc218 \uc870\uc791\uc744 \uc219\ub2ec\ud558\ub824\uba74 \ubc1c\uc0ac, \uc870\ud5a5 \ubc0f \ucc29\ub959 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud574\uc57c \ud569\ub2c8\ub2e4. \uc8fc\uc694 \uc870\uc791\uc740 '\ubc1c\uc0ac' \ubc84\ud2bc, \uc870\ud5a5\uc744 \uc704\ud55c \ubc29\ud5a5 \ud328\ub4dc, \ucc29\ub959\uc744 \uc704\ud55c '\ube0c\ub808\uc774\ud06c' \ubc84\ud2bc\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubc29\ud5a5 \ud328\ub4dc\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uba74 \uc18c\ud589\uc131\ub300\ub97c \ud0d0\uc0c9\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4 \ud574\uc124: \uc870\uc791 \ub808\uc774\uc544\uc6c3\uacfc \uae30\ub2a5\uc744 \ub354 \uc798 \uc774\ud574\ud558\uae30 \uc704\ud574 \uc2dc\uac01\uc801\uc73c\ub85c \ud45c\ud604\ud569\ub2c8\ub2e4.]"}, {"question": "\ub85c\ucf13 \uac8c\uc784\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ub294 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub85c\ucf13 \uac8c\uc784\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc73c\ub824\uba74 \ud6a8\uc728\uc801\uc778 \uc5f0\ub8cc \uad00\ub9ac, \uc815\ud655\ud55c \uc870\ud5a5 \ubc0f \uc804\ub7b5\uc801\uc778 \ud30c\uc6cc\uc5c5 \uc0ac\uc6a9\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1 - \uc5f0\ub8cc \uc18c\ube44\ub97c \ucd5c\uc18c\ud654\ud558\uae30 \uc704\ud574 \uacbd\ub85c\ub97c \uacc4\ud68d\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2 - '\uc18d\ub3c4 \uc99d\uac00' \ubc0f '\ubc29\ud328'\uc640 \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc218\uc9d1\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3 - \uc7a5\uc560\ubb3c\uacfc \uc801\uc744 \ud53c\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc801\uc808\ud55c \uc2dc\uae30\uc5d0 '\uc18d\ub3c4 \uc99d\uac00'\ub97c \uc0ac\uc6a9\ud558\uba74 \ub354 \uba3c \uac70\ub9ac\ub97c \ube60\ub974\uac8c \uc774\ub3d9\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. [\uc5ec\ub7ec \ubc29\uc548 \ube44\uad50: \uc5f0\ub8cc \uad00\ub9ac \ubc0f \uc7a5\uc560\ubb3c \ud68c\ud53c\ub97c \uc704\ud55c \ub2e4\uc591\ud55c \uc804\ub7b5\uc744 \ube44\uad50\ud569\ub2c8\ub2e4.]"}, {"question": "\ub85c\ucf13 \uac8c\uc784\uc5d0\uc11c \ub85c\ucf13\uc758 \uc5f0\ub8cc \ud6a8\uc728\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\ub85c\ucf13 \uac8c\uc784\uc5d0\uc11c \ub85c\ucf13\uc758 \uc5f0\ub8cc \ud6a8\uc728\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc2e0\uc911\ud55c \uacc4\ud68d\uacfc \uc2e4\ud589\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1 - \ubaa9\uc801\uc9c0\uae4c\uc9c0 \uac00\uc7a5 \uc9c1\uc811\uc801\uc778 \uacbd\ub85c\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2 - '\uc5d0\ucf54 \ubaa8\ub4dc'\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc5f0\ub8cc \uc18c\ube44\ub97c \uc904\uc785\ub2c8\ub2e4. \ub2e8\uacc4 3 - \ubd88\ud544\uc694\ud55c \uc870\uc791\uc744 \ud53c\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub179\uc0c9 \ub85c\ucf13' \ubaa8\ub378\uc758 '\uc5d0\ucf54 \ubaa8\ub4dc'\ub294 \ucd5c\ub300 20%\uc758 \uc5f0\ub8cc\ub97c \uc808\uc57d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc5f0\ub8cc \ud6a8\uc728\uc740 \uc790\ub3d9\ucc28 \uc6b4\uc804\uc5d0 \ube44\uc720\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubd80\ub4dc\ub7fd\uace0 \uc548\uc815\uc801\uc778 \uc6b4\uc804\uc774 \ub354 \ub9ce\uc740 \uc5f0\ub8cc\ub97c \uc808\uc57d\ud569\ub2c8\ub2e4.]"}, {"question": "\ub85c\ucf13 \uac8c\uc784\uc5d0\uc11c \uc548\uc804\ud558\uac8c \ucc29\ub959\ud558\ub294 \ucd5c\uc120\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub85c\ucf13 \uac8c\uc784\uc5d0\uc11c \uc548\uc804\ud558\uac8c \ucc29\ub959\ud558\ub824\uba74 \uc815\ud655\uc131\uacfc \ud0c0\uc774\ubc0d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1 - \uc81c\uc5b4\ub41c \uc18d\ub3c4\ub85c \ucc29\ub959 \uc9c0\uc810\uc5d0 \uc811\uadfc\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2 - '\ube0c\ub808\uc774\ud06c' \ubc84\ud2bc\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc18d\ub3c4\ub97c \uc904\uc785\ub2c8\ub2e4. \ub2e8\uacc4 3 - \ub85c\ucf13\uc744 \ucc29\ub959\uc7a5\uacfc \uc815\ub82c\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc2a4\ud0c0\ud130 \ub85c\ucf13'\uc744 50 \ub2e8\uc704 \ubbf8\ub9cc\uc758 \uc18d\ub3c4\ub85c \ucc29\ub959\ud558\uba74 \uc548\uc804\ud558\uac8c \ucc29\ub959\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4 \ud574\uc124: \ucc29\ub959 \uacfc\uc815\uc744 \ub2e8\uacc4\ubcc4\ub85c \uc2dc\uac01\ud654\ud558\uba74 \uc2e4\ud589\uc774 \ub354\uc6b1 \uc6a9\uc774\ud574\uc9d1\ub2c8\ub2e4.]"}, {"question": "\uac8c\uc784\uc758 \ubb3c\ub9ac \uc5d4\uc9c4\uc740 \ub85c\ucf13 \uac8c\uc784\uc5d0\uc11c \ub85c\ucf13 \uc131\ub2a5\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ub85c\ucf13 \uac8c\uc784\uc758 \ubb3c\ub9ac \uc5d4\uc9c4\uc740 \uc911\ub825, \ucd94\uc9c4\ub825 \ubc0f \uacf5\uae30 \uc800\ud56d\uacfc \uac19\uc740 \uc694\uc18c\ub97c \ud1b5\ud574 \ud604\uc2e4 \uc138\uacc4\uc758 \ubb3c\ub9ac\ub97c \uc2dc\ubbac\ub808\uc774\uc158\ud558\uc5ec \ub85c\ucf13 \uc131\ub2a5\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc911\ub825 \uc6f0' \uae30\ub2a5\uc740 \uace0\uc911\ub825 \uc9c0\uc5ed\uc5d0\uc11c \uc5f0\ub8cc \uc18c\ube44\ub97c \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4. [\uad6c\uc131 \ub300\uc870\ud45c: \ucd5c\uc801\uc758 \uc804\ub7b5\uc744 \uc704\ud574 \uc11c\ub85c \ub2e4\ub978 \uc911\ub825 \uc9c0\uc5ed\uc5d0\uc11c\uc758 \ub85c\ucf13 \uc131\ub2a5\uc744 \ube44\uad50\ud569\ub2c8\ub2e4.]"}, {"question": "\ub2e4\uc591\ud55c \uc5f0\ub8cc \uc720\ud615\uc740 \ub85c\ucf13 \uac8c\uc784\uc5d0\uc11c \ub85c\ucf13 \uc18d\ub3c4\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ub85c\ucf13 \uac8c\uc784\uc5d0\uc11c \ub2e4\uc591\ud55c \uc5f0\ub8cc \uc720\ud615\uc740 \ub85c\ucf13 \uc18d\ub3c4\uc640 \ud6a8\uc728\uc131\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ub2e8\uacc4 1 - \uc784\ubb34 \uc694\uad6c\uc0ac\ud56d\uc5d0 \ub530\ub77c \uc5f0\ub8cc \uc720\ud615\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2 - '\uace0\uc5d0\ub108\uc9c0 \uc5f0\ub8cc'\ub294 \uc18d\ub3c4\ub97c \ub192\uc774\uc9c0\ub9cc \ub354 \ub9ce\uc740 \uc5f0\ub8cc\ub97c \uc18c\ube44\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3 - '\uc5d0\ucf54 \uc5f0\ub8cc'\ub294 \ub290\ub9ac\uc9c0\ub9cc \ub354 \ud6a8\uc728\uc801\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc2a4\ud53c\ub4dc\uc2a4\ud130 \ub85c\ucf13'\uc758 '\uace0\uc5d0\ub108\uc9c0 \uc5f0\ub8cc'\ub294 \uc18d\ub3c4\ub97c 30% \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc5ec\ub7ec \ubc29\uc548 \ube44\uad50: \ub2e4\uc591\ud55c \uc784\ubb34\uc5d0 \uc801\ud569\ud55c \uc5f0\ub8cc \uc720\ud615\uc758 \uc7a5\ub2e8\uc810\uc744 \ube44\uad50\ud569\ub2c8\ub2e4.]"}, {"question": "\uc0c8\ub85c\uc6b4 \uae30\uae30\ub85c \ub85c\ucf13 \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc0c8\ub85c\uc6b4 \uae30\uae30\ub85c \ub85c\ucf13 \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\ub294 \uac83\uc740 \uac04\ub2e8\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1 - \uac8c\uc784\uc774 \uacc4\uc815\uacfc \uc5f0\uacb0\ub418\uc5c8\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2 - \uc0c8 \uae30\uae30\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3 - \ud074\ub77c\uc6b0\ub4dc\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac8c\uc784\uc744 '\ub85c\ucf13 \uac8c\uc784 \uacc4\uc815'\uacfc \uc5f0\uacb0\ud558\uba74 \ub370\uc774\ud130\uac00 \uc6d0\ud65c\ud558\uac8c \uc804\uc1a1\ub429\ub2c8\ub2e4. [\ud750\ub984\ub3c4 \ud574\uc124: \uacc4\uc815 \uc5f0\uacb0 \ubc0f \ub370\uc774\ud130 \ub3d9\uae30\ud654 \ub2e8\uacc4\ub97c \uc2dc\uac01\uc801\uc73c\ub85c \ud45c\ud604\ud569\ub2c8\ub2e4.]"}, {"question": "\ub85c\ucf13 \uac8c\uc784\uc5d0\uc11c \uc228\uaca8\uc9c4 \uc218\uc9d1\ud488\uc740 \uc5b4\ub514\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub85c\ucf13 \uac8c\uc784\uc758 \uc228\uaca8\uc9c4 \uc218\uc9d1\ud488\uc740 \uc885\uc885 \uc228\uaca8\uc9c4 \uc704\uce58\ub098 \ub3c4\ub2ec\ud558\uae30 \uc5b4\ub824\uc6b4 \uc9c0\uc5ed\uc5d0 \uc704\uce58\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1 - \uc9c0\ub3c4\uc758 \ubaa8\ub4e0 \uad6c\uc11d\uc744 \ud0d0\ud5d8\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2 - '\uc5d1\uc2a4\ub808\uc774 \ube44\uc804'\uacfc \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc228\uaca8\uc9c4 \uc544\uc774\ud15c\uc744 \ucc3e\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 3 - \uc7a5\uc560\ubb3c \ub4a4\uc640 \ub3d9\uad74 \uc548\ucabd\uc744 \ud655\uc778\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud06c\ub9ac\uc2a4\ud0c8 \ub3d9\uad74' \ub2e8\uacc4\uc758 \ud3ed\ud3ec \ub4a4\uc5d0\ub294 '\uace8\ub4e0 \ub85c\ucf13 \ubd80\ud488'\uc774 \uc228\uaca8\uc838 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc228\uaca8\uc9c4 \uc218\uc9d1\ud488\uc740 \uc774\uc2a4\ud130 \uc5d0\uadf8\uc5d0 \ube44\uc720\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uaf3c\uaf3c\ud788 \ud0d0\ud5d8\ud574\uc57c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}]
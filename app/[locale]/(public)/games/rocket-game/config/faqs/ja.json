[{"question": "\u30ed\u30b1\u30c3\u30c8\u30b2\u30fc\u30e0\u3067\u57fa\u672c\u7684\u306a\u30ed\u30b1\u30c3\u30c8\u6253\u3061\u4e0a\u3052\u3092\u884c\u3046\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30ed\u30b1\u30c3\u30c8\u30b2\u30fc\u30e0\u3067\u57fa\u672c\u7684\u306a\u30ed\u30b1\u30c3\u30c8\u6253\u3061\u4e0a\u3052\u3092\u884c\u3046\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\u3002 STEP1 - \u30ed\u30b1\u30c3\u30c8\u304c\u5b8c\u5168\u306b\u71c3\u6599\u4f9b\u7d66\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002 STEP2 - \u753b\u9762\u4e2d\u592e\u306e\u300c\u6253\u3061\u4e0a\u3052\u300d\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u307e\u3059\u3002 STEP3 - \u65b9\u5411\u30d1\u30c3\u30c9\u3092\u4f7f\u7528\u3057\u3066\u30ed\u30b1\u30c3\u30c8\u3092\u64cd\u8235\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30b9\u30bf\u30fc\u30bf\u30fc\u30ed\u30b1\u30c3\u30c8\u300d\u306e\u6253\u3061\u4e0a\u3052\u306b\u306f\u3001\u5c11\u306a\u304f\u3068\u3082100\u5358\u4f4d\u306e\u71c3\u6599\u304c\u5fc5\u8981\u3067\u3059\u3002 [\u6bd4\u55a9\u8aac\u660e: \u6253\u3061\u4e0a\u3052\u30d7\u30ed\u30bb\u30b9\u3092\u82b1\u706b\u306e\u70b9\u706b\u3068\u6349\u3048\u307e\u3057\u3087\u3046\u3002\u9069\u5207\u306a\u71c3\u6599\u91cf\u3068\u6b63\u78ba\u306a\u64cd\u8235\u304c\u5fc5\u8981\u3067\u3059\u3002]"}, {"question": "\u30ed\u30b1\u30c3\u30c8\u30b2\u30fc\u30e0\u3067\u30ed\u30b1\u30c3\u30c8\u304c\u5236\u5fa1\u4e0d\u80fd\u306b\u30b9\u30d4\u30f3\u3059\u308b\u7406\u7531\u306f\uff1f", "answer": "\u30ed\u30b1\u30c3\u30c8\u304c\u5236\u5fa1\u4e0d\u80fd\u306b\u30b9\u30d4\u30f3\u3059\u308b\u539f\u56e0\u306f\u3001\u91cd\u91cf\u914d\u5206\u306e\u4e0d\u5099\u307e\u305f\u306f\u904e\u5270\u306a\u63a8\u9032\u529b\u3067\u3059\u3002\u3053\u308c\u3092\u4fee\u6b63\u3059\u308b\u306b\u306f\uff1a STEP1 - \u300c\u30ed\u30b1\u30c3\u30c8\u8a2d\u5b9a\u300d\u30e1\u30cb\u30e5\u30fc\u3067\u91cd\u91cf\u30d0\u30e9\u30f3\u30b9\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002 STEP2 - \u30ed\u30b1\u30c3\u30c8\u306e\u8a2d\u8a08\u306b\u5408\u308f\u305b\u3066\u63a8\u9032\u529b\u30ec\u30d9\u30eb\u3092\u8abf\u6574\u3057\u307e\u3059\u3002 STEP3 - \u30b9\u30bf\u30d3\u30e9\u30a4\u30b6\u30fc\u30d5\u30a3\u30f3\u3092\u4f7f\u7528\u3057\u3066\u5236\u5fa1\u6027\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30d5\u30a1\u30eb\u30b3\u30f3X\u300d\u30e2\u30c7\u30eb\u306f\u3001\u63a8\u9032\u529b\u304c80%\u3092\u8d85\u3048\u308b\u3068\u30b9\u30d4\u30f3\u3059\u308b\u50be\u5411\u304c\u3042\u308a\u307e\u3059\u3002[\u69cb\u6210\u5bfe\u7167\u8868: \u6700\u9069\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306e\u305f\u3081\u306b\u63a8\u9032\u529b\u30ec\u30d9\u30eb\u3068\u91cd\u91cf\u914d\u5206\u3092\u6bd4\u8f03\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30ed\u30b1\u30c3\u30c8\u30b2\u30fc\u30e0\u3067\u30de\u30b9\u30bf\u30fc\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u5fc5\u9808\u306e\u64cd\u4f5c\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ed\u30b1\u30c3\u30c8\u30b2\u30fc\u30e0\u3067\u5fc5\u9808\u306e\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u6253\u3061\u4e0a\u3052\u3001\u64cd\u8235\u3001\u7740\u9678\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4e3b\u306a\u64cd\u4f5c\u306b\u306f\u3001\u300c\u6253\u3061\u4e0a\u3052\u300d\u30dc\u30bf\u30f3\u3001\u64cd\u8235\u306e\u305f\u3081\u306e\u65b9\u5411\u30d1\u30c3\u30c9\u3001\u7740\u9678\u306e\u305f\u3081\u306e\u300c\u30d6\u30ec\u30fc\u30ad\u300d\u30dc\u30bf\u30f3\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u65b9\u5411\u30d1\u30c3\u30c9\u3092\u52b9\u679c\u7684\u306b\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u5c0f\u60d1\u661f\u5e2f\u3092\u30ca\u30d3\u30b2\u30fc\u30c8\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8: \u64cd\u4f5c\u30ec\u30a4\u30a2\u30a6\u30c8\u3068\u305d\u306e\u6a5f\u80fd\u3092\u8996\u899a\u5316\u3057\u3066\u7406\u89e3\u3092\u6df1\u3081\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30ed\u30b1\u30c3\u30c8\u30b2\u30fc\u30e0\u3067\u9ad8\u5f97\u70b9\u3092\u7372\u5f97\u3059\u308b\u306e\u306b\u5f79\u7acb\u3064\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ed\u30b1\u30c3\u30c8\u30b2\u30fc\u30e0\u3067\u9ad8\u5f97\u70b9\u3092\u7372\u5f97\u3059\u308b\u306b\u306f\u3001\u52b9\u7387\u7684\u306a\u71c3\u6599\u7ba1\u7406\u3001\u6b63\u78ba\u306a\u64cd\u8235\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306e\u6226\u7565\u7684\u306a\u4f7f\u7528\u306e\u7d44\u307f\u5408\u308f\u305b\u304c\u5fc5\u8981\u3067\u3059\u3002 STEP1 - \u71c3\u6599\u6d88\u8cbb\u3092\u6700\u5c0f\u9650\u306b\u3059\u308b\u305f\u3081\u306b\u30eb\u30fc\u30c8\u3092\u8a08\u753b\u3057\u307e\u3059\u3002 STEP2 - \u300c\u901f\u5ea6\u5f37\u5316\u300d\u3084\u300c\u30b7\u30fc\u30eb\u30c9\u300d\u306a\u3069\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u96c6\u3081\u307e\u3059\u3002 STEP3 - \u969c\u5bb3\u7269\u3084\u6575\u3092\u907f\u3051\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u9069\u5207\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u300c\u901f\u5ea6\u5f37\u5316\u300d\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u591a\u304f\u306e\u8ddd\u96e2\u3092\u8fc5\u901f\u306b\u30ab\u30d0\u30fc\u3067\u304d\u307e\u3059\u3002[\u591a\u65b9\u6848\u6bd4\u8f03: \u71c3\u6599\u7ba1\u7406\u3068\u969c\u5bb3\u7269\u56de\u907f\u306e\u305f\u3081\u306e\u3055\u307e\u3056\u307e\u306a\u6226\u7565\u3092\u6bd4\u8f03\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30ed\u30b1\u30c3\u30c8\u30b2\u30fc\u30e0\u3067\u30ed\u30b1\u30c3\u30c8\u306e\u71c3\u6599\u52b9\u7387\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30ed\u30b1\u30c3\u30c8\u306e\u71c3\u6599\u52b9\u7387\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u614e\u91cd\u306a\u8a08\u753b\u3068\u5b9f\u884c\u304c\u5fc5\u8981\u3067\u3059\u3002 STEP1 - \u76ee\u7684\u5730\u3078\u306e\u6700\u3082\u76f4\u63a5\u7684\u306a\u30eb\u30fc\u30c8\u3092\u9078\u629e\u3057\u307e\u3059\u3002 STEP2 - \u300c\u30a8\u30b3\u30e2\u30fc\u30c9\u300d\u3092\u4f7f\u7528\u3057\u3066\u71c3\u6599\u6d88\u8cbb\u3092\u524a\u6e1b\u3057\u307e\u3059\u3002 STEP3 - \u4e0d\u8981\u306a\u64cd\u4f5c\u3092\u907f\u3051\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u300c\u30b0\u30ea\u30fc\u30f3\u30ed\u30b1\u30c3\u30c8\u300d\u30e2\u30c7\u30eb\u306e\u300c\u30a8\u30b3\u30e2\u30fc\u30c9\u300d\u3067\u6700\u592720%\u306e\u71c3\u6599\u3092\u7bc0\u7d04\u3067\u304d\u307e\u3059\u3002 [\u6bd4\u55a9\u8aac\u660e: \u71c3\u6599\u52b9\u7387\u3092\u81ea\u52d5\u8eca\u306e\u904b\u8ee2\u3068\u6349\u3048\u307e\u3057\u3087\u3046\u3002\u30b9\u30e0\u30fc\u30ba\u3067\u5b89\u5b9a\u3057\u305f\u904b\u8ee2\u304c\u3088\u308a\u591a\u304f\u306e\u30ac\u30bd\u30ea\u30f3\u3092\u7bc0\u7d04\u3057\u307e\u3059\u3002]"}, {"question": "\u30ed\u30b1\u30c3\u30c8\u30b2\u30fc\u30e0\u3067\u5b89\u5168\u306b\u7740\u9678\u3059\u308b\u305f\u3081\u306e\u30d9\u30b9\u30c8\u30d7\u30e9\u30af\u30c6\u30a3\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ed\u30b1\u30c3\u30c8\u30b2\u30fc\u30e0\u3067\u5b89\u5168\u306b\u7740\u9678\u3059\u308b\u306b\u306f\u3001\u6b63\u78ba\u3055\u3068\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u5fc5\u8981\u3067\u3059\u3002 STEP1 - \u5236\u5fa1\u3055\u308c\u305f\u901f\u5ea6\u3067\u7740\u9678\u5730\u70b9\u306b\u63a5\u8fd1\u3057\u307e\u3059\u3002 STEP2 - \u300c\u30d6\u30ec\u30fc\u30ad\u300d\u30dc\u30bf\u30f3\u3092\u4f7f\u7528\u3057\u3066\u901f\u5ea6\u3092\u843d\u3068\u3057\u307e\u3059\u3002 STEP3 - \u30ed\u30b1\u30c3\u30c8\u3092\u7740\u9678\u30d1\u30c3\u30c9\u306b\u5408\u308f\u305b\u308b\u3002\u4f8b\u3048\u3070\u3001\u300c\u30b9\u30bf\u30fc\u30bf\u30fc\u30ed\u30b1\u30c3\u30c8\u300d\u309250\u5358\u4f4d\u4ee5\u4e0b\u306e\u901f\u5ea6\u3067\u7740\u9678\u3055\u305b\u308b\u3053\u3068\u3067\u3001\u5b89\u5168\u306a\u7740\u9678\u3092\u78ba\u4fdd\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8: \u7740\u9678\u30d7\u30ed\u30bb\u30b9\u3092\u6bb5\u968e\u7684\u306b\u8996\u899a\u5316\u3057\u3066\u3001\u3088\u308a\u826f\u3044\u5b9f\u884c\u3092\u76ee\u6307\u3057\u307e\u3057\u3087\u3046\u3002]"}, {"question": "\u30b2\u30fc\u30e0\u306e\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u306f\u3001\u30ed\u30b1\u30c3\u30c8\u30b2\u30fc\u30e0\u3067\u30ed\u30b1\u30c3\u30c8\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30ed\u30b1\u30c3\u30c8\u30b2\u30fc\u30e0\u306e\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u306f\u3001\u91cd\u529b\u3001\u63a8\u9032\u529b\u3001\u7a7a\u6c17\u62b5\u6297\u306a\u3069\u3001\u73fe\u5b9f\u4e16\u754c\u306e\u7269\u7406\u6cd5\u5247\u3092\u30b7\u30df\u30e5\u30ec\u30fc\u30c8\u3057\u3001\u30ed\u30b1\u30c3\u30c8\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u5f71\u97ff\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u91cd\u529b\u4e95\u6238\u300d\u6a5f\u80fd\u306f\u3001\u9ad8\u91cd\u529b\u5e2f\u3067\u71c3\u6599\u6d88\u8cbb\u91cf\u3092\u5897\u3084\u3057\u307e\u3059\u3002[\u69cb\u6210\u5bfe\u7167\u8868: \u6700\u9069\u306a\u6226\u7565\u306e\u305f\u3081\u306b\u3001\u3055\u307e\u3056\u307e\u306a\u91cd\u529b\u5e2f\u3067\u306e\u30ed\u30b1\u30c3\u30c8\u6027\u80fd\u3092\u6bd4\u8f03\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30ed\u30b1\u30c3\u30c8\u30b2\u30fc\u30e0\u3067\u7570\u306a\u308b\u71c3\u6599\u306e\u7a2e\u985e\u306f\u3001\u30ed\u30b1\u30c3\u30c8\u306e\u901f\u5ea6\u306b\u3069\u306e\u3088\u3046\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u304b\uff1f", "answer": "\u30ed\u30b1\u30c3\u30c8\u30b2\u30fc\u30e0\u3067\u7570\u306a\u308b\u71c3\u6599\u306e\u7a2e\u985e\u306f\u3001\u30ed\u30b1\u30c3\u30c8\u306e\u901f\u5ea6\u3068\u52b9\u7387\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002 STEP1 - \u30df\u30c3\u30b7\u30e7\u30f3\u8981\u4ef6\u306b\u57fa\u3065\u3044\u3066\u71c3\u6599\u306e\u7a2e\u985e\u3092\u9078\u629e\u3057\u307e\u3059\u3002 STEP2 - \u300c\u30cf\u30a4\u30a8\u30cd\u30eb\u30ae\u30fc\u71c3\u6599\u300d\u306f\u901f\u5ea6\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u304c\u3001\u71c3\u6599\u6d88\u8cbb\u91cf\u3082\u5897\u3048\u307e\u3059\u3002 STEP3 - \u300c\u30a8\u30b3\u71c3\u6599\u300d\u306f\u3086\u3063\u304f\u308a\u3067\u3059\u304c\u52b9\u7387\u7684\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30b9\u30d4\u30fc\u30c9\u30b9\u30bf\u30fc\u30ed\u30b1\u30c3\u30c8\u300d\u306e\u300c\u30cf\u30a4\u30a8\u30cd\u30eb\u30ae\u30fc\u71c3\u6599\u300d\u306f\u901f\u5ea6\u309230%\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u591a\u65b9\u6848\u6bd4\u8f03: \u3055\u307e\u3056\u307e\u306a\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u7570\u306a\u308b\u71c3\u6599\u306e\u7a2e\u985e\u306e\u9577\u6240\u3068\u77ed\u6240\u3092\u6bd4\u8f03\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30ed\u30b1\u30c3\u30c8\u30b2\u30fc\u30e0\u306e\u9032\u6357\u3092\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u79fb\u884c\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30ed\u30b1\u30c3\u30c8\u30b2\u30fc\u30e0\u306e\u9032\u6357\u3092\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u79fb\u884c\u3059\u308b\u306e\u306f\u7c21\u5358\u3067\u3059\u3002 STEP1 - \u30b2\u30fc\u30e0\u304c\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ea\u30f3\u30af\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002 STEP2 - \u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002 STEP3 - \u30af\u30e9\u30a6\u30c9\u304b\u3089\u9032\u6357\u72b6\u6cc1\u3092\u540c\u671f\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b2\u30fc\u30e0\u3092\u300c\u30ed\u30b1\u30c3\u30c8\u30b2\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\u300d\u306b\u30ea\u30f3\u30af\u3059\u308b\u3053\u3068\u3067\u3001\u30b9\u30e0\u30fc\u30ba\u306a\u30c7\u30fc\u30bf\u8ee2\u9001\u304c\u4fdd\u8a3c\u3055\u308c\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8: \u30a2\u30ab\u30a6\u30f3\u30c8\u306e\u30ea\u30f3\u30af\u3068\u30c7\u30fc\u30bf\u540c\u671f\u306e\u624b\u9806\u3092\u8996\u899a\u5316\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30ed\u30b1\u30c3\u30c8\u30b2\u30fc\u30e0\u3067\u96a0\u3055\u308c\u305f\u30b3\u30ec\u30af\u30c6\u30a3\u30d6\u30eb\u30a2\u30a4\u30c6\u30e0\u306f\u3069\u3053\u306b\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30ed\u30b1\u30c3\u30c8\u30b2\u30fc\u30e0\u306e\u96a0\u3055\u308c\u305f\u30b3\u30ec\u30af\u30c6\u30a3\u30d6\u30eb\u30a2\u30a4\u30c6\u30e0\u306f\u3001\u591a\u304f\u306e\u5834\u5408\u3001\u308f\u304b\u308a\u306b\u304f\u3044\u3001\u307e\u305f\u306f\u5230\u9054\u3057\u306b\u304f\u3044\u5834\u6240\u306b\u3042\u308a\u307e\u3059\u3002 STEP1 - \u30de\u30c3\u30d7\u306e\u9685\u3005\u307e\u3067\u63a2\u308a\u307e\u3059\u3002 STEP2 - \u300cX\u7dda\u8996\u529b\u300d\u306a\u3069\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3057\u3066\u3001\u96a0\u308c\u305f\u30a2\u30a4\u30c6\u30e0\u3092\u898b\u3064\u3051\u307e\u3059\u3002 STEP3 - \u969c\u5bb3\u7269\u3084\u6d1e\u7a9f\u306e\u5f8c\u308d\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30af\u30ea\u30b9\u30bf\u30eb\u6d1e\u7a9f\u300d\u30ec\u30d9\u30eb\u306e\u6edd\u306e\u5f8c\u308d\u306b\u300c\u30b4\u30fc\u30eb\u30c7\u30f3\u30ed\u30b1\u30c3\u30c8\u30d1\u30fc\u30c4\u300d\u304c\u96a0\u3055\u308c\u3066\u3044\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e: \u96a0\u3055\u308c\u305f\u30b3\u30ec\u30af\u30c6\u30a3\u30d6\u30eb\u30a2\u30a4\u30c6\u30e0\u3092\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3068\u6349\u3048\u307e\u3057\u3087\u3046\u3002\u5fb9\u5e95\u7684\u306a\u63a2\u6c42\u304c\u5fc5\u8981\u3067\u3059\u3002]"}]
[{"question": "wings.io\u5165\u9580\u30ac\u30a4\u30c9\uff1a\u521d\u5fc3\u8005\u306e\u65b9\u3001\u57fa\u790e\u98db\u884c\u64cd\u4f5c\u3092\u8fc5\u901f\u306b\u7fd2\u5f97\u3057\u3001\u589c\u843d\u3092\u56de\u907f\u3059\u308b\u306b\u306f\uff1f", "answer": "wings.io\u306e\u521d\u5fc3\u8005\u306b\u3068\u3063\u3066\u6700\u3082\u91cd\u8981\u306a\u3053\u3068\u306f\u3001\u57fa\u790e\u98db\u884c\u64cd\u4f5c\u3092\u7fd2\u5f97\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u307e\u305a\u3001\u30de\u30a6\u30b9\u3092\u4f7f\u3063\u3066\u98db\u884c\u65b9\u5411\u3092\u5236\u5fa1\u3057\u3001\u5de6\u30af\u30ea\u30c3\u30af\u3067\u52a0\u901f\u3001\u53f3\u30af\u30ea\u30c3\u30af\u3067\u6e1b\u901f\u3057\u307e\u3059\u3002\u521d\u671f\u6bb5\u968e\u3067\u306f\u3001\u7fa4\u8846\u306b\u76f4\u63a5\u7a81\u3063\u8fbc\u3080\u306e\u3092\u907f\u3051\u3001\u307e\u305a\u306f\u7fbd\u3092\u62fe\u3063\u3066\u81ea\u8eab\u306e\u5f37\u5316\u3092\u512a\u5148\u3057\u307e\u3057\u3087\u3046\u3002\u30b2\u30fc\u30e0\u5185\u306e\u5177\u4f53\u7684\u306a\u4f8b\uff1a\u52a0\u901f\u3092\u4f7f\u3063\u3066\u6575\u306e\u5f3e\u3092\u304b\u308f\u3057\u3001\u6e1b\u901f\u3057\u3066\u65cb\u56de\u3057\u3066\u5b64\u7acb\u3057\u305f\u6575\u3092\u653b\u6483\u3059\u308b\u3053\u3068\u3002\u751f\u5b58\u304c\u6700\u512a\u5148\u3067\u3059\uff01\n[\u6bd4\u55a9\u8aac\u660e]\uff1awings.io\u306e\u98db\u884c\u64cd\u4f5c\u3092\u51e7\u63da\u3052\u306b\u4f8b\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u51e7\u7cf8\uff08\u30de\u30a6\u30b9\uff09\u3067\u65b9\u5411\u3092\u3001\u98a8\u529b\uff08\u52a0\u901f/\u6e1b\u901f\uff09\u3067\u9ad8\u5ea6\u3068\u901f\u5ea6\u3092\u5236\u5fa1\u3057\u307e\u3059\u3002\u67d4\u8edf\u306b\u6d3b\u7528\u3059\u308c\u3070\u3001\u7a7a\u3092\u81ea\u7531\u306b\u98db\u3073\u56de\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "wings.io\u3067\u3001\u521d\u5fc3\u8005\u306b\u3068\u3063\u3066\u512a\u5148\u3059\u3079\u304d\u521d\u671f\u306e\u5f37\u529b\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u306f\u3069\u308c\u3067\u3059\u304b\uff1f\u907f\u3051\u308b\u3079\u304d\u3082\u306e\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "wings.io\u306e\u521d\u671f\u3067\u6700\u3082\u512a\u5148\u3059\u3079\u304d\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u306f\u3001\u4f53\u529b\u3092\u5897\u52a0\u3055\u305b\u3001\u5f3e\u901f\u3092\u5411\u4e0a\u3055\u305b\u308b\u3082\u306e\u3067\u3059\u3002\u4f53\u529b\u5897\u52a0\u306f\u30a8\u30e9\u30fc\u8010\u6027\u3092\u9ad8\u3081\u3001\u5f3e\u901f\u306f\u6575\u3092\u3088\u308a\u5bb9\u6613\u306b\u30d2\u30c3\u30c8\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u907f\u3051\u308b\u3079\u304d\u306f\u3001\u5927\u304d\u3055\u3092\u5897\u52a0\u3055\u305b\u308b\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3067\u3059\u3002\u5927\u304d\u3055\u304c\u5927\u304d\u304f\u306a\u308b\u3068\u3001\u653b\u6483\u3092\u53d7\u3051\u3084\u3059\u3044\u3067\u3059\u3002\u30b2\u30fc\u30e0\u5185\u306e\u5177\u4f53\u7684\u306a\u4f8b\uff1a\u7dd1\u8272\u306e\u4f53\u529b\u5897\u52a0\u30a2\u30a4\u30c6\u30e0\u3092\u512a\u5148\u7684\u306b\u62fe\u3046\u3068\u3001\u751f\u5b58\u7387\u3092\u52b9\u679c\u7684\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n[\u8907\u6570\u6848\u6bd4\u8f03]\uff1a\u4f53\u529b\u5897\u52a0vs\u5927\u304d\u3055\u5897\u52a0\u3001\u524d\u8005\u306f\u751f\u5b58\u529b\u3092\u5411\u4e0a\u3055\u305b\u3001\u5f8c\u8005\u306f\u653b\u6483\u3092\u53d7\u3051\u3084\u3059\u3044\u72b6\u614b\u306b\u306a\u308a\u307e\u3059\u3002\u5f3e\u901f\u5897\u52a0vs\u5f3e\u6570\u5897\u52a0\u3001\u524d\u8005\u306f\u547d\u4e2d\u7387\u3092\u9ad8\u3081\u3001\u5f8c\u8005\u306f\u9ad8\u3044\u64cd\u4f5c\u6280\u8853\u304c\u5fc5\u8981\u3067\u3059\u3002"}, {"question": "wings.io\u3067\u306f\u3001\u901a\u5e38\u306e\u30ad\u30eb\u4ee5\u5916\u306b\u3001\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u307e\u305f\u306f\u5831\u916c\u3092\u5f97\u308b\u65b9\u6cd5\u306f\u3042\u308a\u307e\u305b\u3093\u304b\uff1f", "answer": "\u6575\u3092\u6483\u7834\u3059\u308b\u4ee5\u5916\u306b\u3082\u3001wings.io\u3067\u306f\u738b\u51a0\u3092\u5360\u9818\u3059\u308b\u3053\u3068\u3067\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u738b\u51a0\u3092\u9577\u671f\u9593\u5360\u9818\u3059\u308b\u3053\u3068\u3067\u3001\u3055\u3089\u306a\u308b\u5831\u916c\u304c\u5f97\u3089\u308c\u307e\u3059\u3002\u307e\u305f\u3001\u6575\u3092\u9023\u7d9a\u3057\u3066\u6483\u7834\u3059\u308b\u3068\u3001\u9023\u30ad\u30eb\u30dc\u30fc\u30ca\u30b9\u304c\u30c8\u30ea\u30ac\u30fc\u3055\u308c\u307e\u3059\u3002\u30b2\u30fc\u30e0\u5185\u306e\u5177\u4f53\u7684\u306a\u4f8b\uff1a\u30de\u30c3\u30d7\u306e\u4e2d\u592e\u306b\u73fe\u308c\u308b\u738b\u51a0\u30a8\u30ea\u30a2\u3067\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u5236\u5fa1\u3057\u3066\u305d\u306e\u30a8\u30ea\u30a2\u306b\u5165\u308b\u3068\u5360\u9818\u3067\u304d\u307e\u3059\u3002\n[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8]\uff1a\u738b\u51a0\u3092\u898b\u3064\u3051\u308b \u2192 \u738b\u51a0\u306b\u8fd1\u3065\u304f \u2192 \u738b\u51a0\u3092\u5360\u9818\u3059\u308b \u2192 \u7d99\u7d9a\u7684\u306b\u5360\u9818\u3059\u308b \u2192 \u3055\u3089\u306a\u308b\u5831\u916c\u3092\u7372\u5f97\u3059\u308b"}, {"question": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u305f\u3081\u306e\u30b9\u30c6\u30c3\u30d7\u30a2\u30c3\u30d7\uff1awings.io\u306e\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u3069\u306e\u3088\u3046\u306b\u30de\u30c3\u30d7\u74b0\u5883\u3092\u6d3b\u7528\u3057\u3066\u6226\u8853\u7684\u306a\u52d5\u304d\u3068\u6b63\u78ba\u306a\u653b\u6483\u3092\u3057\u3066\u3044\u307e\u3059\u304b\uff1f", "answer": "wings.io\u306e\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30de\u30c3\u30d7\u74b0\u5883\u3092\u5341\u5206\u306b\u6d3b\u7528\u3057\u3066\u6226\u8853\u7684\u306a\u52d5\u304d\u3092\u884c\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30de\u30c3\u30d7\u306e\u7aef\u3092\u5229\u7528\u3057\u3066\u7d20\u65e9\u304f\u65cb\u56de\u3057\u305f\u308a\u3001
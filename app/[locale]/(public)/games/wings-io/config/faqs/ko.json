[{"question": "wings.io \uc2dc\uc791 \uac00\uc774\ub4dc: \ucd08\ubcf4\uc790\ub294 \uc5b4\ub5bb\uac8c \uae30\ubcf8 \ube44\ud589 \uc870\uc791\uc744 \ube60\ub974\uac8c \uc219\ub2ec\ud558\uace0 \ucc29\ub959\ud558\uc9c0 \uc54a\uc744 \uc218 \uc788\uc744\uae4c\uc694?", "answer": "wings.io \ucd08\ubcf4\uc790\ub294 \uae30\ubcf8 \ube44\ud589 \uc870\uc791\uc744 \uc219\ub2ec\ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uba3c\uc800 \ub9c8\uc6b0\uc2a4\ub85c \ube44\ud589 \ubc29\ud5a5\uc744 \uc870\uc885\ud558\uace0, \uc67c\ucabd \ud074\ub9ad\uc73c\ub85c \uac00\uc18d\ud558\uace0, \uc624\ub978\ucabd \ud074\ub9ad\uc73c\ub85c \uac10\uc18d\ud569\ub2c8\ub2e4. \ucd08\uae30\uc5d0\ub294 \uc0ac\ub78c\ub4e4\ud55c\ud14c \uc9c1\uc811 \ucda9\ub3cc\ud558\ub294 \uac83\uc744 \ud53c\ud558\uace0 \uae43\ud138\uc744 \uc6b0\uc120 \uc218\uc9d1\ud558\uc5ec \uc790\uc2e0\uc744 \uac15\ud654\ud558\uc138\uc694. \uac8c\uc784 \ub0b4 \uad6c\uccb4\uc801\uc778 \uc608\uc2dc: \uac00\uc18d\uc744 \uc774\uc6a9\ud558\uc5ec \uc801\uc758 \ucd1d\uc54c\uc744 \ud53c\ud558\uace0, \uac10\uc18d\ud558\uc5ec \ud640\ub85c \uc788\ub294 \uc801\uc744 \uacf5\uaca9\ud558\ub294 \ubc29\ud5a5\uc73c\ub85c \uc804\ud658\ud558\uc138\uc694. \uae30\uc5b5\ud558\uc138\uc694, \uc0dd\uc874\uc774 \ucd5c\uc6b0\uc120\uc785\ub2c8\ub2e4!\n[\ube44\uc720 \uc124\uba85]: wings.io\uc758 \ube44\ud589 \uc870\uc791\uc744 \uc5f0, \ud48d\uc120\uc744 \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694. \ud48d\uc120\uc904(\ub9c8\uc6b0\uc2a4)\ub85c \ubc29\ud5a5\uc744 \uc870\uc885\ud558\uace0, \ubc14\ub78c\uc758 \uc138\uae30(\uac00\uc18d/\uac10\uc18d)\ub85c \ub192\uc774\uc640 \uc18d\ub3c4\ub97c \uc81c\uc5b4\ud558\uc5ec \ub0a0\uc544\ub2e4\ub2d0 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "wings.io \ucd08\ubcf4\uc790\uac00 \uc6b0\uc120\uc21c\uc704\ub85c \uace0\ub824\ud574\uc57c \ud560 \ucd5c\uace0\uc758 \ucd08\ubc18 \ud30c\uc6cc\uc5c5\uc740 \ubb34\uc5c7\uc774\uba70, \ud53c\ud574\uc57c \ud560 \ud30c\uc6cc\uc5c5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "wings.io \ucd08\ubc18\uc5d0 \uac00\uc7a5 \uc6b0\uc120\uc2dc\ud574\uc57c \ud560 \ud30c\uc6cc\uc5c5\uc740 \uccb4\ub825\uacfc \ucd1d\uc54c \uc18d\ub3c4 \uc99d\uac00\uc785\ub2c8\ub2e4. \uccb4\ub825 \uc99d\uac00\ub294 \uc624\ub958 \ud5c8\uc6a9\ub960\uc744 \ub192\uc5ec\uc8fc\uace0, \ucd1d\uc54c \uc18d\ub3c4\ub294 \uc801\uc744 \ub354 \uc27d\uac8c \ub9de\ud790 \uc218 \uc788\ub3c4\ub85d \ud574\uc90d\ub2c8\ub2e4. \ud53c\ud574\uc57c \ud560 \uac83\uc740 \ud06c\uae30 \uc99d\uac00 \ud30c\uc6cc\uc5c5\uc785\ub2c8\ub2e4. \ud06c\uae30\uac00 \ucee4\uc9c0\uba74 \uacf5\uaca9\uc744 \ubc1b\uae30 \uc27d\uc2b5\ub2c8\ub2e4. \uac8c\uc784 \ub0b4 \uad6c\uccb4\uc801\uc778 \uc608\uc2dc: \ub179\uc0c9 \uccb4\ub825 \uc99d\uac00\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \ud68d\ub4dd\ud558\uba74 \uc0dd\uc874\ub825\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n[\ub2e4\uc911 \uc194\ub8e8\uc158 \ube44\uad50]: \uccb4\ub825 \uc99d\uac00 vs \ud06c\uae30 \uc99d\uac00, \uc804\uc790\ub294 \uc0dd\uc874\ub825\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uace0, \ud6c4\uc790\ub294 \uacf5\uaca9\uc744 \ubc1b\uc744 \uac00\ub2a5\uc131\uc744 \ub192\uc785\ub2c8\ub2e4. \ucd1d\uc54c \uc18d\ub3c4 \uc99d\uac00 vs \ucd1d\uc54c \uc218 \uc99d\uac00, \uc804\uc790\ub294 \uba85\uc911\ub960\uc744 \ub192\uc774\uace0, \ud6c4\uc790\ub294 \ub354 \ub192\uc740 \uc870\uc791 \uc219\ub828\ub3c4\uac00 \ud544\uc694\ud569\ub2c8\ub2e4."}, {"question": "wings.io\uc5d0\uc11c \uc77c\ubc18\uc801\uc778 \uc0ac\uc0b4 \uc678\uc5d0 \uc810\uc218 \ub610\ub294 \ubcf4\uc0c1\uc744 \ub354 \ub192\uc77c \uc218 \uc788\ub294 \ubc29\ubc95\uc740 \uc5c6\uc744\uae4c\uc694?", "answer": "\uc801\uc744 \uc0ac\uc0b4\ud558\ub294 \uac83 \uc678\uc5d0\ub3c4, wings.io\uc5d0\uc11c \uc655\uad00\uc744 \uc7a5\uc545\ud558\uba74 \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc655\uad00\uc744 \uc7a5\uae30\uac04 \uc7a5\uc545\ud558\uba74 \ucd94\uac00 \ubcf4\uc0c1\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uc801\uc744 \uc5f0\uc18d\ud574\uc11c \uc0ac\uc0b4\ud558\uba74 \uc5f0\uc18d \ud0ac \ubcf4\uc0c1\uc774 \ud65c\uc131\ud654\ub429\ub2c8\ub2e4. \uac8c\uc784 \ub0b4 \uad6c\uccb4\uc801\uc778 \uc608\uc2dc: \uc9c0\ub3c4 \uc911\uc559\uc5d0 \ub098\ud0c0\ub098\ub294 \uc655\uad00 \uc9c0\uc5ed\uc73c\ub85c \uce90\ub9ad\ud130\ub97c \uc774\ub3d9\ud558\uc5ec \uc7a5\uc545\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n[\ud504\ub85c\uc138\uc2a4 \ub3c4\ud45c]: \uc655\uad00 \ucc3e\uae30 -> \uc655\uad00 \uadfc\ucc98\ub85c \uc774\ub3d9 -> \uc655\uad00 \uc7a5\uc545 -> \uc9c0\uc18d\uc801\uc778 \uc7a5\uc545 -> \ucd94\uac00 \ubcf4\uc0c1 \ud68d\ub4dd"}, {"question": "\ubca0\ud14c\ub791 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \uc219\ub2ec: wings.io \uace0\uc218 \ud50c\ub808\uc774\uc5b4\ub294 \uc9c0\ub3c4 \ud658\uacbd\uc744 \uc5b4\ub5bb\uac8c \ud65c\uc6a9\ud558\uc5ec \uc804\uc220\uc801\uc778 \uc774\ub3d9\uacfc \uc815\ud655\ud55c \ud0c0\uaca9\uc744 \uc2dc\ud589\ud558\ub294\uac00?", "answer": "wings.io \uace0\uc218 \ud50c\ub808\uc774\uc5b4\ub294 \uc9c0\ub3c4 \ud658\uacbd\uc744 \uc801\uadf9\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\uc5ec \uc804\uc220\uc801\uc778 \uc774\ub3d9\uc744 \uc218\ud589\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc9c0\ub3c4 \uac00\uc7a5\uc790\ub9ac\ub97c \ud65c\uc6a9\ud558\uc5ec \ube60\ub974\uac8c \ubc29\ud5a5\uc744 \uc804\ud658\ud558\uac70\ub098, \uc7a5\uc560\ubb3c\uc744 \uc774\uc6a9\ud558\uc5ec \uacf5\uaca9\uc744 \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc815\ud655\ud55c \ud0c0\uaca9\uc744 \uc704\ud574\uc11c\ub294 \uc801\uc758 \ud589\ub3d9 \uacbd\ub85c\ub97c \uc608\uce21\ud574\uc57c \ud569\ub2c8\ub2e4. STEP1: \uc801\uc758 \ube44\ud589 \uacbd\ub85c \uad00\ucc30. STEP2: \uc801\uc758 \ub2e4\uc74c \ud589\ub3d9 \uc608\uce21. STEP3: \uc801\uc774 \ubaa9\ud45c \uc704\uce58\uc5d0 \ub3c4\ub2ec\ud558\uae30 \uc804\uc5d0 \uc0ac\uaca9 \uc2dc\uc791. \uac8c\uc784 \ub0b4 \uad6c\uccb4\uc801\uc778 \uc608\uc2dc: \uc9c0\ub3c4 \uac00\uc7a5\uc790\ub9ac\ub97c \uc774\uc6a9\ud558\uc5ec \ucd1d\uc54c\uc744 \ubc18\uc0ac\uc2dc\ucf1c \uc2dc\uc57c\uac00 \uac00\ub824\uc9c4 \uc801\uc744 \uacf5\uaca9\ud569\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c]: \ub0ae\uc740 \ubbfc\uac10\ub3c4\ub294 \uc815\ud655\ud55c \uc0ac\uaca9\uc5d0 \uc801\ud569\ud558\uace0, \ub192\uc740 \ubbfc\uac10\ub3c4\ub294 \ube60\ub978 \ubc29\ud5a5 \uc804\ud658\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4."}, {"question": "\uc77c\ubd80 wings.io \ud50c\ub808\uc774\uc5b4\uac00 \ubb34\uc801\ucc98\ub7fc \ubcf4\uc774\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uac8c\uc784\uc744 \uc9c0\ubc30\ud560 \uc218 \uc788\ub3c4\ub85d \ud558\ub294 \uc804\ub7b5 \ubc0f \ud30c\uc6cc\uc5c5 \uc870\ud569\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "wings.io\uc5d0\uc11c \ubb34\uc801\ucc98\ub7fc \ubcf4\uc774\ub294 \ud50c\ub808\uc774\uc5b4\ub294 \uc77c\ubc18\uc801\uc73c\ub85c \ud575\uc2ec \uc0dd\uc874 \uc804\ub7b5\uacfc \ud30c\uc6cc\uc5c5 \uc870\ud569\uc744 \uc219\ub2ec\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub4e4\uc740 \uace0\uccb4\ub825\uacfc \ubc29\ud328\uc640 \uac19\uc740 \ubc29\uc5b4\ud615 \ud30c\uc6cc\uc5c5\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uc120\ud0dd\ud569\ub2c8\ub2e4. \ub610\ud55c, \uc9c0\ud615\uc744 \ud65c\uc6a9\ud558\uc5ec \ud53c\ud558\uace0 \uc801\uc808\ud55c \uacf5\uaca9 \uc2dc\uae30\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. STEP1: \uccb4\ub825 \ubc0f \ubc29\ud328 \uc99d\uac00\ub97c \uc6b0\uc120 \ud68d\ub4dd. STEP2: \uc9c0\ub3c4 \uac00\uc7a5\uc790\ub9ac\uc640 \uc7a5\uc560\ubb3c\uc744 \uc774\uc6a9\ud558\uc5ec \ud53c\ud558\uae30. STEP3: \uc801\uc808\ud55c \uc2dc\uae30\uc5d0 \ubc18\uaca9\ud558\uace0, \uc77c\ubc18\uc801\uc73c\ub85c \ucd1d\uc54c \uc18d\ub3c4\uc640 \uc0ac\uc815\uac70\ub9ac\uc640 \uc870\ud569\ud574\uc11c \uc0ac\uc6a9\ud569\ub2c8\ub2e4.\n[\ube44\uc720 \uc124\uba85]: \uadf8\ub4e4\uc740 \uac15\ub825\ud55c \ubc29\uc5b4\ub825\uacfc \uce58\uba85\uc801\uc778 \ubc18\uaca9\uc744 \uac16\ucd98 \uc644\ubcbd\ud55c \uac11\uc637\uc744 \uc785\uc740 \uba67\ub3fc\uc9c0\uc640 \uac19\uc2b5\ub2c8\ub2e4."}, {"question": "wings.io \ud6c4\ubc18\uc5d0\ub294 \uc6b4\uc601\uacfc \uc790\uc6d0 \uad00\ub9ac\ub97c \ud1b5\ud574 \uc5b4\ub5bb\uac8c \uc9c0\uc18d\uc801\uc778 \uc6b0\uc704\ub97c \uc720\uc9c0\ud558\uace0 \ucd5c\uc885 \uc2b9\uc790\uac00 \ub420 \uc218 \uc788\uc744\uae4c\uc694?", "answer": "wings.io \ud6c4\ubc18 \uc6b4\uc601\uc740 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc9c0\ub3c4 \uc0c1\uc758 \uc790\uc6d0 \uc9c0\uc810\uc744 \uc9c0\uc18d\uc801\uc73c\ub85c \uad00\ub9ac\ud558\uace0 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uc758 \ubc1c\uc804\uc744 \ub9c9\uc544\uc57c \ud569\ub2c8\ub2e4. \ub3d9\uc2dc\uc5d0 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uc758 \ub3d9\ud5a5\uc744 \uc8fc\uc2dc\ud558\uc5ec \ud3ec\uc704 \uacf5\uaca9\uc744 \ud53c\ud574\uc57c \ud569\ub2c8\ub2e4. \uac8c\uc784 \ub0b4 \uad6c\uccb4\uc801\uc778 \uc608\uc2dc: \uc790\uc2e0\uc774 \uc548\uc804\ud55c \uc0c1\ud0dc\ub97c \uc720\uc9c0\ud558\ub294 \uac00\uc6b4\ub370 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uac00 \ubc84\ub9b0 \uae43\ud138\uc744 \uc57d\ud0c8\ud569\ub2c8\ub2e4.\nSTEP1: \uc9c0\ub3c4 \uc0c1\uc758 \uc790\uc6d0\uc744 \uc9c0\uc18d\uc801\uc73c\ub85c \uc218\uc9d1.STEP2: \uc801\uc758 \ud589\ub3d9\uc744 \uad00\ucc30\ud558\uace0 \ubd84\uc11d.STEP3: \uc548\uc804 \uac70\ub9ac\ub97c \uc720\uc9c0\ud558\uba70 \ubb34\ubaa8\ud55c \uc804\ud22c\ub97c \ud53c\ud558\uc2ed\uc2dc\uc624.\n[\ub2e4\uc911 \uc194\ub8e8\uc158 \ube44\uad50]: \uacf5\uaca9\uc801\uc778 \uacf5\uc138 vs \uc548\uc815\uc801\uc778 \ubc29\uc5b4, \ud6c4\ubc18\uc5d0\ub294 \uc2e4\uc218\ub97c \ud53c\ud558\uae30 \uc704\ud574 \uc548\uc815\uc801\uc778 \ubc29\uc5b4\ub97c \ucd94\ucc9c\ud569\ub2c8\ub2e4."}, {"question": "wings.io\uc758 \ud53c\ud574 \uacc4\uc0b0 \uba54\ucee4\ub2c8\uc998\uc740 \uc5b4\ub5bb\uac8c \ub418\ub098\uc694? \uc11c\ub85c \ub2e4\ub978 \uc720\ud615\uc758 \ucd1d\uc54c\uc774\ub098 \uc2a4\ud0ac\uc5d0 \ud53c\ud574 \ucc28\uc774\uac00 \uc788\ub098\uc694?", "answer": "wings.io\uc758 \ud53c\ud574 \uacc4\uc0b0\uc740 \uc5ec\ub7ec \uc694\uc18c\ub97c \ud3ec\ud568\ud558\uba70, \ucd1d\uc54c \uc720\ud615, \ube44\ud589 \uc18d\ub3c4, \uc0c1\ub300\uc758 \ubc29\uc5b4\ub825\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \uc11c\ub85c \ub2e4\ub978 \ucd1d\uc54c \uc720\ud615\uc758 \ud53c\ud574\ub294 \ub2e4\ub97c \uc218 \uc788\uc73c\uba70, \ud2b9\uc815 \ud2b9\uc218 \ucd1d\uc54c\uc740 \uae30\ubcf8 \ud53c\ud574 \ub610\ub294 \uad00\ud1b5\ub825\uc774 \ub354 \ub192\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubc29\uc5b4\ub825\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \ud68d\ub4dd\ud55c \uccb4\ub825\uacfc \ubc29\ud328 \ub4f1\uc758 \uc99d\uac00\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4. \uad6c\uccb4\uc801\uc778 \uac12\uc740 \uacf5\uc2dd\uc801\uc73c\ub85c \uacf5\uac1c\ub418\uc9c0 \uc54a\uc558\uc73c\ubbc0\ub85c \uc2e4\uc804\uc744 \ud1b5\ud574 \ub290\uaef4\uc57c \ud569\ub2c8\ub2e4.\n[\uc124\uc815 \ube44\uad50\ud45c]: \ucd1d\uc54c \uc720\ud615 | \ud53c\ud574 | \ud2b9\uc9d5, \uc77c\ubc18 \ucd1d\uc54c | \ub0ae\uc74c | \ubc1c\uc0ac \uc18d\ub3c4\uac00 \ube60\ub984, \ud2b9\uc218 \ucd1d\uc54c | \ub192\uc74c | \ud2b9\uc218 \ud6a8\uacfc\uac00 \uc788\uc74c."}, {"question": "wings.io\uc5d0\uc11c \uac00\uc18d\ub3c4\uc640 \uae30\ub3d9\uc131\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uae30\ubcf8\uc801\uc778 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc774\uba70, \uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\ub294 \uc774\ub97c \uc5b4\ub5bb\uac8c \ud65c\uc6a9\ud558\ub098\uc694?", "answer": "wings.io\uc758 \uac00\uc18d\ub3c4\uc640 \uae30\ub3d9\uc131\uc740 \ud604\uc7ac \uc18d\ub3c4, \uce90\ub9ad\ud130 \ubb34\uac8c(\uae43\ud138 \uc218) \ubc0f \ubc29\ud5a5 \uc804\ud658 \ubbfc\uac10\ub3c4 \ub4f1 \uc5ec\ub7ec \uba54\ucee4\ub2c8\uc998\uc5d0 \uc758\ud574 \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\ub294 \uc18d\ub3c4\uc640 \ubc29\ud5a5\uc744 \uc9c0\uc18d\uc801\uc73c\ub85c \uc870\uc815\ud558\uc5ec \uc720\uc5f0\ud55c \uae30\ub3d9\uc131\uc744 \ubc1c\ud718\ud569\ub2c8\ub2e4. \uadf8\ub4e4\uc740 \uc800\uc18d \uc0c1\ud0dc\uc5d0\uc11c \uc815\ud655\ud55c \ubc29\ud5a5 \uc804\ud658\uc744 \ud558\uace0, \uace0\uc18d \uc0c1\ud0dc\uc5d0\uc11c \ube60\ub974\uac8c \uc774\ub3d9\ud569\ub2c8\ub2e4. \uae43\ud138 \uc218\uac00 \ub108\ubb34 \ub9ce\uc73c\uba74 \uae30\ub3d9\uc131\uc774 \uc800\ud558\ub418\ubbc0\ub85c \uc2e0\uc911\ud558\uac8c \uc120\ud0dd\ud574\uc57c \ud569\ub2c8\ub2e4. \uac8c\uc784 \ub0b4 \uad6c\uccb4\uc801\uc778 \uc608\uc2dc: \uacf5\uaca9\uc744 \ud53c\ud558\uac70\ub098 \ud68c\ud53c\ud560 \ub54c \ube60\ub974\uac8c \uc18d\ub3c4\ub97c \uc904\uc5ec \uae09\ud68c\uc804\ud569\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \ub3c4\ud45c]: \uace0\uc18d \ube44\ud589 -> \uc7a5\uc560\ubb3c \ubc1c\uc0dd -> \ube60\ub978 \uac10\uc18d -> \uc815\ud655\ud55c \ubc29\ud5a5 \uc804\ud658 -> \uacc4\uc18d \ube44\ud589."}, {"question": "wings.io\uc5d0\uc11c \ud50c\ub7ab\ud3fc \uac04 \ud50c\ub808\uc774\uac00 \uac00\ub2a5\ud55c\uac00\uc694? \ub2e4\ub978 \uae30\uae30\uc5d0\uc11c \uce5c\uad6c\uc640 \uac8c\uc784\uc744 \ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud604\uc7ac\uae4c\uc9c0 wings.io\uc5d0\ub294 \uacf5\uc2dd\uc801\uc778 \uba40\ud2f0 \ud50c\ub7ab\ud3fc \uac8c\uc784 \uae30\ub2a5\uc774 \uc5c6\uc2b5\ub2c8\ub2e4. \uc989, PC\uc640 \ubaa8\ubc14\uc77c \uac8c\uc784 \ubaa8\ub450\uc5d0\uc11c \ud50c\ub808\uc774\ud560 \uc218 \uc788\uc9c0\ub9cc, \uc11c\ub85c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc758 \ud50c\ub808\uc774\uc5b4\ub4e4\uacfc \ubc14\ub85c \uac8c\uc784\uc744 \ud560 \uc218 \uc5c6\ub2e4\ub294 \ub73b\uc785\ub2c8\ub2e4. \ub530\ub77c\uc11c \ub2e4\ub978 \uae30\uae30\ub97c \uc0ac\uc6a9\ud558\ub294 \uce5c\uad6c\uc640 \ud568\uaed8 wings.io\ub97c \uc9c1\uc811 \ud50c\ub808\uc774\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.\n[\ub2e4\uc911 \uc194\ub8e8\uc158 \ube44\uad50]: \uba40\ud2f0 \ud50c\ub7ab\ud3fc \uac8c\uc784 | \uc7a5\uc810 | \ub2e8\uc810, \uc788\uc74c | \ud50c\ub808\uc774\uc5b4 \ubc94\uc704 \ud655\uc7a5, \ud300 \uacb0\uc131 \uc6a9\uc774 | \ubc38\ub7f0\uc2a4 \ubb38\uc81c \ubc1c\uc0dd \uac00\ub2a5. \uc5c6\uc74c | \uac8c\uc784 \uacbd\ud5d8 \uc77c\uad00\uc131 | \ud50c\ub808\uc774\uc5b4 \ubc94\uc704 \uc81c\ud55c."}, {"question": "wings.io\uc5d0 \uc228\uaca8\uc9c4 \uc2a4\ud0a8\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\ub098\uc694? \uc5b4\ub5bb\uac8c \ud65c\uc131\ud654\ud558\uac70\ub098 \ud574\uc81c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "wings.io\uc5d0\ub294 \uc228\uaca8\uc9c4 \uc2a4\ud0a8\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc2a4\ud0a8\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \ud2b9\uc815 \uc5c5\uc801\uc744 \ub2ec\uc131\ud558\uac70\ub098 \uc228\uaca8\uc9c4 \uc870\uac74\uc744 \ucda9\uc871\ud574\uc57c \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud2b9\uc815 \uc218\uc758 \uc801\uc744 \uc5f0\uc18d\ud574\uc11c \uc81c\uac70\ud558\uac70\ub098 \uc9c0\ub3c4\uc758 \ud2b9\uc218\ud55c \uc704\uce58\uc5d0 \uc77c\uc815 \uc2dc\uac04 \uba38\ubb34\ub974\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uad6c\uccb4\uc801\uc778 \ud65c\uc131\ud654 \ubc29\ubc95\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc9c1\uc811 \ud0d0\uc0c9\ud574\uc57c \ud558\uba70, \uac8c\uc784\uc758 \uc7ac\ubbf8\ub97c \ub192\uc785\ub2c8\ub2e4. \uac8c\uc784 \ub0b4 \uad6c\uccb4\uc801\uc778 \uc608\uc2dc: \uc9c0\ub3c4 \uc911\uc559\uc5d0 \uc624\ub7ab\ub3d9\uc548 \uba38\ubb3c\ub7ec \uc788\uc73c\uba74 \ud2b9\ubcc4 \uc774\ubca4\ud2b8\uac00 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc73c\uba70, \uc228\uaca8\uc9c4 \uc2a4\ud0a8\uc744 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n[\ube44\uc720 \uc124\uba85]: \uc228\uaca8\uc9c4 \uc2a4\ud0a8\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ucc3e\ub294 \uac83\uc740 \ubcf4\ubb3c\ucc3e\uae30\uc640 \uac19\uc73c\uba70, \uc778\ub0b4\uc2ec\uacfc \uc138\uc2ec\ud568\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."}]
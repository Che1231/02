[{"question": "\u65b0\u624b\u5982\u4f55\u5f00\u59cb\u73a9\u7cd6\u679c\u7403\u6e38\u620f\uff1f", "answer": "\u8981\u5f00\u59cb\u73a9\u7cd6\u679c\u7403\uff0c\u9996\u5148\u9700\u8981\u4ece\u5e94\u7528\u5546\u5e97\u4e0b\u8f7d\u6e38\u620f\u3002\u5b89\u88c5\u540e\uff0c\u6253\u5f00\u6e38\u620f\uff0c\u6309\u7167\u5c4f\u5e55\u4e0a\u7684\u6559\u7a0b\u8fdb\u884c\u64cd\u4f5c\uff0c\u8fd9\u5c06\u6307\u5bfc\u4f60\u638c\u63e1\u6e38\u620f\u7684\u57fa\u672c\u673a\u5236\u3002\u4f8b\u5982\uff0c\u4f60\u5c06\u5b66\u4e60\u5982\u4f55\u6ed1\u52a8\u6765\u53d1\u5c04\u7cd6\u679c\u7403\u4ee5\u53ca\u5982\u4f55\u5339\u914d\u989c\u8272\u6765\u5f97\u5206\u3002\u786e\u4fdd\u5b8c\u6210\u6559\u5b66\uff0c\u4ee5\u4fbf\u7406\u89e3\u6838\u5fc3\u6e38\u620f\u5faa\u73af\u3002"}, {"question": "\u6bcf\u4e2a\u65b0\u73a9\u5bb6\u90fd\u5e94\u8be5\u638c\u63e1\u7cd6\u679c\u7403\u4e2d\u7684\u54ea\u4e9b\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u7cd6\u679c\u7403\u4e2d\u7684\u57fa\u672c\u64cd\u4f5c\u5305\u62ec\u6ed1\u52a8\u7784\u51c6\u548c\u53d1\u5c04\u7cd6\u679c\u7403\uff0c\u70b9\u51fb\u4f7f\u7528\u9053\u5177\uff0c\u4ee5\u53ca\u6309\u4f4f\u6765\u5145\u80fd\u7279\u6b8a\u5c04\u51fb\u3002\u4f8b\u5982\uff0c\u7cbe\u786e\u6ed1\u52a8\u53ef\u4ee5\u5e2e\u52a9\u4f60\u8fde\u9501\u5339\u914d\uff0c\u63d0\u9ad8\u5f97\u5206\u3002\u5728\u65e9\u671f\u5173\u5361\u7ec3\u4e60\u8fd9\u4e9b\u64cd\u4f5c\uff0c\u53ef\u4ee5\u63d0\u5347\u4f60\u7684\u6280\u80fd\u3002"}, {"question": "\u5728\u7cd6\u679c\u7403\u4e2d\u5339\u914d\u989c\u8272\u4e3a\u4ec0\u4e48\u91cd\u8981\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u54cd\u6e38\u620f\uff1f", "answer": "\u5728\u7cd6\u679c\u7403\u4e2d\u5339\u914d\u989c\u8272\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u53ef\u4ee5\u6e05\u9664\u68cb\u76d8\u5e76\u83b7\u5f97\u5206\u6570\u3002\u5f53\u4f60\u5339\u914d\u4e09\u4e2a\u6216\u4e09\u4e2a\u4ee5\u4e0a\u76f8\u540c\u989c\u8272\u7684\u7cd6\u679c\u65f6\uff0c\u5b83\u4eec\u4f1a\u6d88\u5931\uff0c\u65b0\u7684\u7cd6\u679c\u4f1a\u6389\u843d\u4e0b\u6765\u3002\u4f8b\u5982\uff0c\u8fde\u7eed\u5339\u914d\u4e94\u4e2a\u7ea2\u8272\u7cd6\u679c\u53ef\u4ee5\u89e6\u53d1\u8fde\u51fb\uff0c\u83b7\u5f97\u989d\u5916\u5206\u6570\u548c\u9053\u5177\u3002"}, {"question": "\u5728\u73a9\u4e86\u8d85\u8fc7100\u5c0f\u65f6\u540e\uff0c\u5982\u4f55\u6539\u8fdb\u6211\u5728\u7cd6\u679c\u7403\u4e2d\u7684\u7b56\u7565\uff1f", "answer": "\u5728\u73a9\u4e86100\u5c0f\u65f6\u540e\uff0c\u4e13\u6ce8\u4e8e\u66f4\u9ad8\u7ea7\u7684\u7b56\u7565\uff0c\u4f8b\u5982\u63d0\u524d\u89c4\u5212\u4f60\u7684\u52a8\u4f5c\u5e76\u7b56\u7565\u6027\u5730\u4f7f\u7528\u9053\u5177\u3002\u6b65\u9aa41\uff1a\u5728\u5c04\u51fb\u524d\uff0c\u59cb\u7ec8\u5bfb\u627e\u6f5c\u5728\u7684\u8fde\u51fb\u7ec4\u5408\u3002\u6b65\u9aa42\uff1a\u5c06\u9053\u5177\u7559\u5230\u6311\u6218\u6027\u5173\u5361\u4f7f\u7528\u3002\u6b65\u9aa43\uff1a\u7ec3\u4e60\u7784\u51c6\u7279\u5b9a\u76ee\u6807\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u6548\u7387\u3002\u4f8b\u5982\uff0c\u572850\u7ea7\u5173\u5361\u4e2d\uff0c\u4f7f\u7528\u70b8\u5f39\u9053\u5177\u53ef\u4ee5\u6e05\u9664\u68cb\u76d8\u7684\u5927\u7247\u533a\u57df\uff0c\u4ece\u800c\u66f4\u5bb9\u6613\u5b8c\u6210\u5173\u5361\u3002"}, {"question": "\u5982\u4f55\u5728\u7cd6\u679c\u7403\u4e2d\u83b7\u5f97\u9ad8\u5206\uff1f", "answer": "\u4e3a\u4e86\u83b7\u5f97\u9ad8\u5206\uff0c\u4e13\u6ce8\u4e8e\u521b\u5efa\u8fde\u51fb\u5e76\u6709\u6548\u5730\u4f7f\u7528\u9053\u5177\u3002\u6b65\u9aa41\uff1a\u7784\u51c6\u540c\u4e00\u989c\u8272\u7684\u7cd6\u679c\u7c07\u4ee5\u89e6\u53d1\u8fde\u9501\u53cd\u5e94\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u5f69\u8679\u7403\u7b49\u9053\u5177\u4e00\u6b21\u6e05\u9664\u591a\u79cd\u989c\u8272\u3002\u6b65\u9aa43\uff1a\u89c4\u5212\u4f60\u7684\u52a8\u4f5c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u5355\u6b21\u5c04\u51fb\u6e05\u9664\u7684\u7cd6\u679c\u6570\u91cf\u3002\u4f8b\u5982\uff0c\u572875\u7ea7\u5173\u5361\u4e2d\uff0c\u5c06\u5f69\u8679\u7403\u4e0e\u70b8\u5f39\u7ed3\u5408\u4f7f\u7528\u53ef\u4ee5\u6e05\u9664\u6574\u4e2a\u68cb\u76d8\uff0c\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u5206\u6570\u3002"}, {"question": "\u54ea\u4e9b\u7cd6\u679c\u7403\u9053\u5177\u5bf9\u9ad8\u7ea7\u73a9\u5bb6\u6765\u8bf4\u6700\u6709\u6548\uff1f", "answer": "\u9ad8\u7ea7\u73a9\u5bb6\u53d1\u73b0\u70b8\u5f39\u548c\u5f69\u8679\u7403\u9053\u5177\u6700\u6709\u6548\u3002\u70b8\u5f39\u53ef\u4ee5\u6e05\u9664\u5927\u8303\u56f4\u533a\u57df\uff0c\u800c\u5f69\u8679\u7403\u53ef\u4ee5\u5339\u914d\u4efb\u4f55\u989c\u8272\u3002\u4f8b\u5982\uff0c\u5728100\u7ea7\u5173\u5361\u4e2d\uff0c\u4f7f\u7528\u5f69\u8679\u7403\u6e05\u9664\u4e00\u7ec4\u4e0d\u540c\u989c\u8272\u7684\u7cd6\u679c\u53ef\u4ee5\u4ea7\u751f\u591a\u7c73\u8bfa\u9aa8\u724c\u6548\u5e94\uff0c\u4ece\u800c\u83b7\u5f97\u9ad8\u5206\u3002\u4e0e\u4e4b\u76f8\u6bd4\uff0c\u7ebf\u7206\u5f39\u867d\u7136\u6709\u7528\uff0c\u4f46\u7075\u6d3b\u6027\u8f83\u5dee\u3002"}, {"question": "\u7cd6\u679c\u7403\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u5b83\uff1f", "answer": "\u7cd6\u679c\u7403\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u6e05\u9664\u7684\u7cd6\u679c\u6570\u91cf\u548c\u5236\u9020\u7684\u5339\u914d\u7c7b\u578b\u3002\u4f8b\u5982\uff0c\u5339\u914d\u56db\u4e2a\u7cd6\u679c\u7684\u5206\u6570\u9ad8\u4e8e\u4e09\u4e2a\uff0c\u5e76\u4e14\u8fde\u51fb\u4f1a\u5c06\u4f60\u7684\u5206\u6570\u4e58\u500d\u3002\u6e38\u620f\u8fd8\u4f1a\u8003\u8651\u9053\u5177\u7684\u4f7f\u7528\u548c\u5173\u5361\u7684\u96be\u5ea6\u3002\u8be6\u7ec6\u7684\u8bc4\u5206\u56fe\u8868\u53ef\u4ee5\u5e2e\u52a9\u4f60\u7406\u89e3\u6bcf\u4e2a\u64cd\u4f5c\u5bf9\u4f60\u7684\u603b\u5206\u6570\u7684\u8d21\u732e\u3002"}, {"question": "\u54ea\u4e9b\u6f5c\u5728\u7684\u673a\u5236\u4f1a\u5f71\u54cd\u7cd6\u679c\u7403\u7684\u6e38\u620f\u51b3\u7b56\uff1f", "answer": "\u6f5c\u5728\u673a\u5236\u5305\u62ec\u91cd\u529b\uff0c\u5b83\u4f1a\u4f7f\u7cd6\u679c\u6389\u843d\u5230\u7a7a\u7f3a\u7a7a\u95f4\uff0c\u4ee5\u53ca\u989c\u8272\u5339\u914d\u7cfb\u7edf\uff0c\u5b83\u51b3\u5b9a\u4e86\u7cd6\u679c\u7684\u4ea4\u4e92\u65b9\u5f0f\u3002\u4f8b\u5982\uff0c\u4e86\u89e3\u91cd\u529b\u53ef\u4ee5\u5e2e\u52a9\u4f60\u9884\u6d4b\u65b0\u7cd6\u679c\u7684\u7740\u9646\u4f4d\u7f6e\uff0c\u4ece\u800c\u89c4\u5212\u4f60\u7684\u4e0b\u4e00\u6b65\u884c\u52a8\u3002\u7cd6\u679c\u79fb\u52a8\u7684\u6d41\u7a0b\u56fe\u53ef\u4ee5\u6e05\u6670\u5730\u8bf4\u660e\u8fd9\u4e9b\u673a\u5236\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5c06\u6211\u7684\u7cd6\u679c\u7403\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u8bbe\u5907\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u8bbe\u5907\u5417\uff1f", "answer": "\u662f\u7684\uff0c\u4f60\u53ef\u4ee5\u901a\u8fc7\u5c06\u6e38\u620f\u94fe\u63a5\u5230\u4e91\u8d26\u6237\uff08\u4f8b\u5982Google Play\u6216Apple Game Center\uff09\u6765\u8f6c\u79fb\u4f60\u7684\u7cd6\u679c\u7403\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4eceiPhone\u5207\u6362\u5230Android\u8bbe\u5907\uff0c\u767b\u5f55\u540c\u4e00\u4e2a\u4e91\u8d26\u6237\u5c06\u540c\u6b65\u4f60\u7684\u8fdb\u5ea6\u3002\u8bf7\u786e\u4fdd\u5728\u8f6c\u79fb\u8fc7\u7a0b\u4e2d\u4f60\u7684\u7f51\u7edc\u8fde\u63a5\u7a33\u5b9a\u3002"}, {"question": "\u7cd6\u679c\u7403\u4e2d\u662f\u5426\u5b58\u5728\u73a9\u5bb6\u53ef\u80fd\u9519\u8fc7\u7684\u9690\u85cf\u5173\u5361\u6216\u79d8\u5bc6\u5185\u5bb9\uff1f", "answer": "\u662f\u7684\uff0c\u7cd6\u679c\u7403\u4e2d\u5b58\u5728\u9690\u85cf\u5173\u5361\uff0c\u5728\u5b8c\u6210\u67d0\u4e9b\u6210\u5c31\u540e\u89e3\u9501\u3002\u4f8b\u5982\uff0c\u5728\u4e0d\u4f7f\u7528\u4efb\u4f55\u9053\u5177\u7684\u60c5\u51b5\u4e0b\u5b8c\u621050\u4e2a\u5173\u5361\u53ef\u4ee5\u89e3\u9501\u4e00\u4e2a\u5177\u6709\u72ec\u7279\u6311\u6218\u7684\u79d8\u5bc6\u5173\u5361\u3002\u5bc6\u5207\u5173\u6ce8\u6210\u5c31\u5217\u8868\u4ee5\u53d1\u73b0\u8fd9\u4e9b\u9690\u85cf\u7684\u5b9d\u85cf\u3002"}]
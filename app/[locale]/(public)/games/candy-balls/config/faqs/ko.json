[{"question": "\uc644\uc804\ud788 \ucd08\ubcf4\uc790\ub85c\uc11c \uce94\ub514 \ubcfc \uac8c\uc784\uc744 \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\uce94\ub514 \ubcfc \uac8c\uc784\uc744 \uc2dc\uc791\ud558\ub824\uba74 \uba3c\uc800 \uc571 \uc2a4\ud1a0\uc5b4\uc5d0\uc11c \uac8c\uc784\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc2ed\uc2dc\uc624. \uc124\uce58 \ud6c4 \uac8c\uc784\uc744 \uc5f4\uace0 \ud654\uba74\uc758 \ud29c\ud1a0\ub9ac\uc5bc\uc744 \ub530\ub77c \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc744 \ubc30\uc6b0\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uce94\ub514 \ubcfc\uc744 \uc3d8\uae30 \uc704\ud574 \uc2a4 \uc640\uc774\ud504 \ud558\ub294 \ubc29\ubc95\uacfc \uc810\uc218\ub97c \uc5bb\uae30 \uc704\ud574 \uc0c9\uc0c1\uc744 \ub9e4\uce6d\ud558\ub294 \ubc29\ubc95\uc744 \ubc30\uc6b8 \uac83\uc785\ub2c8\ub2e4. \ud575\uc2ec \uac8c\uc784 \ub8e8\ud504\ub97c \uc774\ud574\ud558\uae30 \uc704\ud574 \ud29c\ud1a0\ub9ac\uc5bc\uc744 \uc644\ub8cc\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ubaa8\ub4e0 \uc2e0\uaddc \ud50c\ub808\uc774\uc5b4\uac00 \uc219\ub2ec\ud574\uc57c \ud558\ub294 \uce94\ub514 \ubcfc\uc758 \ud544\uc218 \ucee8\ud2b8\ub864\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uce94\ub514 \ubcfc\uc758 \ud544\uc218 \ucee8\ud2b8\ub864\uc5d0\ub294 \uce94\ub514 \ubcfc\uc744 \uc870\uc900\ud558\uace0 \uc3d8\uae30 \uc704\ud574 \uc2a4 \uc640\uc774\ud504 \ud558\ub294 \uac83, \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud558\uae30 \uc704\ud574 \ud0ed\ud558\ub294 \uac83, \ud2b9\uc218 \uc0f7\uc744 \ucda9\uc804\ud558\ub824\uba74 \ub204\ub974\ub294 \uac83\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc815\ud655\ud558\uac8c \uc2a4 \uc640\uc774\ud504 \ud558\uba74 \uc5ec\ub7ec \ubc88 \ub9e4\uce6d\uc744 \uc5f0\uc18d\uc801\uc73c\ub85c \ud574\uc11c \uc810\uc218\ub97c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ucd08\uae30 \ub808\ubca8\uc5d0\uc11c \uc774\ub7ec\ud55c \ucee8\ud2b8\ub864\uc744 \uc5f0\uc2b5\ud558\uc5ec \uae30\uc220\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uc2ed\uc2dc\uc624."}, {"question": "\uce94\ub514 \ubcfc\uc5d0\uc11c \uc0c9\uc0c1\uc744 \ub9e4\uce6d\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\uce94\ub514 \ubcfc\uc5d0\uc11c \uc0c9\uc0c1\uc744 \ub9e4\uce6d\ud558\ub294 \uac83\uc740 \ubcf4\ub4dc\ub97c \uc9c0\uc6b0\uace0 \uc810\uc218\ub97c \uc5bb\uae30 \ub54c\ubb38\uc5d0 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uac19\uc740 \uc0c9\uc0c1\uc758 \uce94\ub514 \uc138 \uac1c \uc774\uc0c1\uc744 \ub9e4\uce6d\ud558\uba74 \uce94\ub514\uac00 \uc0ac\ub77c\uc9c0\uace0 \uc0c8\ub85c\uc6b4 \uce94\ub514\uac00 \uc790\ub9ac \uc7a1\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc77c\ub82c\ub85c 5\uac1c\uc758 \ube68\uac04\uc0c9 \uce94\ub514\ub97c \ub9e4\uce6d\ud558\uba74 \ucf64\ubcf4\uac00 \ubc1c\uc0dd\ud558\uc5ec \ucd94\uac00 \uc810\uc218\uc640 \ud30c\uc6cc\uc5c5\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "100\uc2dc\uac04 \uc774\uc0c1 \ud50c\ub808\uc774\ud55c \ud6c4 \uce94\ub514 \ubcfc\uc5d0\uc11c \uc804\ub7b5\uc744 \uc5b4\ub5bb\uac8c \uac1c\uc120\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "100\uc2dc\uac04 \ud6c4\uc5d0\ub294 \uc55e\uc73c\ub85c \uc6c0\uc9c1\uc784\uc744 \uacc4\ud68d\ud558\uace0 \ud30c\uc6cc\uc5c5\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \ub4f1\uc758 \uace0\uae09 \uc804\ub7b5\uc5d0 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 1: \uc288\ud305\ud558\uae30 \uc804\uc5d0 \uc7a0\uc7ac\uc801\uc778 \ucf64\ubcf4\ub97c \ud56d\uc0c1 \ucc3e\uc73c\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \uc5b4\ub824\uc6b4 \ub808\ubca8\uc744 \uc704\ud574 \ud30c\uc6cc\uc5c5\uc744 \uc800\uc7a5\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \ud6a8\uc728\uc131\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \ud2b9\uc815 \ub300\uc0c1\uc744 \uc870\uc900\ud558\ub294 \uc5f0\uc2b5\uc744 \ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 50\uc5d0\uc11c \ud3ed\ud0c4 \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud558\uba74 \ubcf4\ub4dc\uc758 \ud070 \ubd80\ubd84\uc744 \uc9c0\uc6cc \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uae30\uac00 \ub354 \uc26c\uc6cc\uc9d1\ub2c8\ub2e4."}, {"question": "\uce94\ub514 \ubcfc\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\ub294 \uac00\uc7a5 \uc88b\uc740 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc73c\ub824\uba74 \ucf64\ubcf4\ub97c \ub9cc\ub4e4\uace0 \ud30c\uc6cc\uc5c5\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 1: \uccb4\uc778 \ubc18\uc751\uc744 \uc720\ubc1c\ud558\uae30 \uc704\ud574 \uac19\uc740 \uc0c9\uc0c1\uc758 \ud074\ub7ec\uc2a4\ud130\ub97c \uc870\uc900\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \uc77c\uc2dc\uc5d0 \uc5ec\ub7ec \uc0c9\uc0c1\uc744 \uc9c0\uc6b0\ub294 \ubb34\uc9c0\uac1c \ubcfc\uacfc \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \ud55c \ubc88\uc758 \uc0f7\uc73c\ub85c \uc9c0\uc6cc\uc9c0\ub294 \uce94\ub514\uc758 \uc218\ub97c \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \uc6c0\uc9c1\uc784\uc744 \uacc4\ud68d\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 75\uc5d0\uc11c \ubb34\uc9c0\uac1c \ubcfc\uacfc \ud3ed\ud0c4\uc744 \uacb0\ud569\ud558\uba74 \uc804\uccb4 \ubcf4\ub4dc\ub97c \uc9c0\uc6cc \uc810\uc218\ub97c \ud06c\uac8c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uce94\ub514 \ubcfc\uc5d0\uc11c \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ud30c\uc6cc\uc5c5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \ud3ed\ud0c4\uacfc \ubb34\uc9c0\uac1c \ubcfc \ud30c\uc6cc\uc5c5\uc744 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc774\ub77c\uace0 \uc0dd\uac01\ud569\ub2c8\ub2e4. \ud3ed\ud0c4\uc740 \ud070 \uc601\uc5ed\uc744 \uc9c0\uc6b0\uace0 \ubb34\uc9c0\uac1c \ubcfc\uc740 \ubaa8\ub4e0 \uc0c9\uc0c1\uc744 \ub9e4\uce6d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 100\uc5d0\uc11c \ubb34\uc9c0\uac1c \ubcfc\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc5ec\ub7ec \uac00\uc9c0 \uc0c9\uc0c1\uc758 \ud074\ub7ec\uc2a4\ud130\ub97c \uc9c0\uc6b0\uba74 \ub3c4\ubbf8\ub178 \ud6a8\uacfc\uac00 \ubc1c\uc0dd\ud558\uc5ec \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub77c\uc778 \ube14\ub798\uc2a4\ud130\ub294 \uc720\uc6a9\ud558\uc9c0\ub9cc \ub2e4\uc7ac\ub2e4\ub2a5\uc131\uc774 \ub5a8\uc5b4\uc9d1\ub2c8\ub2e4."}, {"question": "\uce94\ub514 \ubcfc\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \uc5b4\ub5a4 \uc694\uc778\uc774 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\uce94\ub514 \ubcfc\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc9c0\uc6cc\uc9c4 \uce94\ub514\uc758 \uc218\uc640 \ub9cc\ub4e4\uc5b4\uc9c4 \ub9e4\uce6d\uc758 \uc720\ud615\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 4\uac1c\uc758 \uce94\ub514\ub97c \ub9e4\uce6d\ud558\ub294 \uac83\uc774 3\uac1c\uc758 \uce94\ub514\ub97c \ub9e4\uce6d\ud558\ub294 \uac83\ubcf4\ub2e4 \uc810\uc218\uac00 \ub192\uace0, \ucf64\ubcf4\ub294 \uc810\uc218\ub97c \uacf1\ud569\ub2c8\ub2e4. \ub610\ud55c \ud30c\uc6cc\uc5c5 \uc0ac\uc6a9\uacfc \ub808\ubca8\uc758 \ub09c\uc774\ub3c4\ub97c \uace0\ub824\ud569\ub2c8\ub2e4. \uc790\uc138\ud55c \uc810\uc218 \ucc28\ud2b8\ub97c \ud1b5\ud574 \uac01 \uc791\uc5c5\uc774 \ucd1d \uc810\uc218\uc5d0 \uc5b4\ub5bb\uac8c \uae30\uc5ec\ud558\ub294\uc9c0 \uc774\ud574\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uac8c\uc784 \ud50c\ub808\uc774 \uacb0\uc815\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uce94\ub514 \ubcfc\uc758 \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc5d0\ub294 \uce94\ub514\uac00 \ube48 \uacf5\uac04\uc73c\ub85c \ub5a8\uc5b4\uc9c0\ub294 \uc911\ub825\uacfc \uce94\ub514\uac00 \uc0c1\ud638 \uc791\uc6a9\ud558\ub294 \ubc29\uc2dd\uc744 \uacb0\uc815\ud558\ub294 \uc0c9\uc0c1 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc911\ub825\uc744 \uc774\ud574\ud558\uba74 \ub2e4\uc74c \uc6c0\uc9c1\uc784\uc744 \uacc4\ud68d\ud560 \uc218 \uc788\ub3c4\ub85d \uc0c8\ub85c\uc6b4 \uce94\ub514\uac00 \uc5b4\ub514\uc5d0 \ub5a8\uc5b4\uc9c8\uc9c0 \uc608\uce21\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \uce94\ub514\uc758 \uc6c0\uc9c1\uc784 \ud750\ub984\ub3c4\ub294 \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \uba85\ud655\ud558\uac8c \uc124\uba85\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\ub2e4\ub978 \uae30\uae30\ub85c \uce94\ub514 \ubcfc \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub124, Google Play \ub610\ub294 Apple Game Center\uc640 \uac19\uc740 \ud074\ub77c\uc6b0\ub4dc \uacc4\uc815\uc5d0 \uac8c\uc784\uc744 \uc5f0\uacb0\ud558\uc5ec \uce94\ub514 \ubcfc \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, iPhone\uc5d0\uc11c Android \uae30\uae30\ub85c \uc804\ud658\ud558\uba74 \uac19\uc740 \ud074\ub77c\uc6b0\ub4dc \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc804\uc1a1 \uc911\uc5d0 \uc548\uc815\uc801\uc778 \uc778\ud130\ub137 \uc5f0\uacb0\uc774 \ub418\ub3c4\ub85d \ud558\uc2ed\uc2dc\uc624."}, {"question": "\uc228\uaca8\uc9c4 \ub808\ubca8 \ub610\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \ub193\uce60 \uc218 \uc788\ub294 \uce94\ub514 \ubcfc\uc758 \ube44\ubc00 \ucf58\ud150\uce20\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub124, \uce94\ub514 \ubcfc\uc5d0\ub294 \ud2b9\uc815 \uc5c5\uc801\uc744 \ub2ec\uc131\ud558\uba74 \uc5f4\ub9ac\ub294 \uc228\uaca8\uc9c4 \ub808\ubca8\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud558\uc9c0 \uc54a\uace0 50\uac1c \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uba74 \uace0\uc720\ud55c \ucc4c\ub9b0\uc9c0\uac00 \uc788\ub294 \ube44\ubc00 \ub808\ubca8\uc744 \uc5f4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ubcf4\uc11d\uc744 \ubc1c\uacac\ud558\uae30 \uc704\ud574 \uc5c5\uc801 \ubaa9\ub85d\uc744 \ud655\uc778\ud558\uc2ed\uc2dc\uc624."}]
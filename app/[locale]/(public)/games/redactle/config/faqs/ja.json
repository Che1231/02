[{"question": "Redactle\u306f\u521d\u5fc3\u8005\u306b\u3068\u3063\u3066\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u30b2\u30fc\u30e0\u3092\u59cb\u3081\u308b\u305f\u3081\u306e\u57fa\u672c\u7684\u306a\u624b\u9806\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Redactle\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u5358\u8a9e\u3092\u5f53\u3066\u3066\u96a0\u3055\u308c\u305f\u8a18\u4e8b\u3092\u660e\u3089\u304b\u306b\u3059\u308b\u5358\u8a9e\u30d1\u30ba\u30eb\u30b2\u30fc\u30e0\u3067\u3059\u3002\u59cb\u3081\u308b\u306b\u306f\u3001Redactle\u306e\u30a6\u30a7\u30d6\u30b5\u30a4\u30c8\u306b\u30a2\u30af\u30bb\u30b9\u3057\u3001\u300e\u65b0\u898f\u30b2\u30fc\u30e0\u300f\u3092\u30af\u30ea\u30c3\u30af\u3057\u307e\u3059\u3002\u30b2\u30fc\u30e0\u3067\u306f\u3001\u5927\u5e45\u306b\u9ed2\u5857\u308a\u3055\u308c\u305fWikipedia\u306e\u8a18\u4e8b\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002\u3042\u306a\u305f\u306e\u76ee\u6a19\u306f\u3001\u8a18\u4e8b\u306b\u51fa\u3066\u304f\u308b\u5358\u8a9e\u3092\u5f53\u3066\u308b\u3053\u3068\u3067\u3059\u3002\u5165\u529b\u30dc\u30c3\u30af\u30b9\u306b\u3042\u306a\u305f\u306e\u63a8\u6e2c\u3092\u5165\u529b\u3057\u3001Enter\u30ad\u30fc\u3092\u62bc\u3057\u307e\u3059\u3002\u6b63\u3057\u3044\u63a8\u6e2c\u306f\u3001\u8a18\u4e8b\u306e\u4e2d\u3067\u305d\u306e\u5358\u8a9e\u306e\u3059\u3079\u3066\u306e\u30a4\u30f3\u30b9\u30bf\u30f3\u30b9\u3092\u660e\u3089\u304b\u306b\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300ethe\u300f\u3092\u5f53\u3066\u308b\u3068\u3001\u30c6\u30ad\u30b9\u30c8\u306e\u4e2d\u306e\u3059\u3079\u3066\u306e\u300ethe\u300f\u304c\u660e\u3089\u304b\u306b\u306a\u308a\u307e\u3059\u3002\u8a18\u4e8b\u306e\u30c8\u30d4\u30c3\u30af\u3092\u63a8\u6e2c\u3067\u304d\u308b\u307e\u3067\u3001\u63a8\u6e2c\u3092\u7d9a\u3051\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u300ethe\u300f\u3001\u300eand\u300f\u3001\u300eof\u300f\u306a\u3069\u306e\u4e00\u822c\u7684\u306a\u5358\u8a9e\u304b\u3089\u59cb\u3081\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u660e\u3089\u304b\u306b\u306a\u3063\u305f\u5358\u8a9e\u3092\u4f7f\u3063\u3066\u3001\u30c8\u30d4\u30c3\u30af\u306b\u95a2\u3059\u308b\u4eee\u8aac\u3092\u7acb\u3066\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u3088\u308a\u5177\u4f53\u7684\u306a\u5358\u8a9e\u3092\u5f53\u3066\u3066\u3001\u30c8\u30d4\u30c3\u30af\u3092\u7d5e\u308a\u8fbc\u307f\u307e\u3057\u3087\u3046\u3002"}, {"question": "Redactle\u3067\u8a18\u4e8b\u3092\u6b63\u3057\u304f\u5f53\u3066\u308b\u3053\u3068\u306f\u306a\u305c\u91cd\u8981\u3067\u3042\u308a\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "Redactle\u3067\u8a18\u4e8b\u3092\u6b63\u3057\u304f\u5f53\u3066\u308b\u3053\u3068\u306f\u3001\u52b9\u7387\u6027\u3068\u6210\u529f\u7387\u306b\u76f4\u63a5\u5f71\u97ff\u3059\u308b\u305f\u3081\u3001\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u6b63\u3057\u3044\u63a8\u6e2c\u306f\u3001\u8a18\u4e8b\u306e\u3088\u308a\u591a\u304f\u306e\u90e8\u5206\u3092\u660e\u3089\u304b\u306b\u3057\u3001\u5168\u4f53\u7684\u306a\u30c8\u30d4\u30c3\u30af\u306b\u95a2\u3059\u308b\u624b\u304c\u304b\u308a\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30a2\u30e1\u30ea\u30ab\u5408\u8846\u56fd\u300f\u3092\u5f53\u3066\u3066\u3001\u305d\u308c\u304c\u983b\u7e41\u306b\u51fa\u3066\u304d\u305f\u5834\u5408\u3001\u8a18\u4e8b\u306f\u7c73\u56fd\u53f2\u307e\u305f\u306f\u5730\u7406\u306b\u95a2\u3059\u308b\u3082\u306e\u3060\u3068\u63a8\u6e2c\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u6226\u7565\u7684\u306a\u63a8\u6e2c\u306b\u3088\u308a\u3001\u8a18\u4e8b\u5168\u4f53\u3092\u660e\u3089\u304b\u306b\u3059\u308b\u305f\u3081\u306b\u5fc5\u8981\u306a\u8a66\u884c\u56de\u6570\u3092\u6e1b\u3089\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u660e\u3089\u304b\u306b\u306a\u3063\u305f\u5358\u8a9e\u306e\u983b\u5ea6\u3068\u6587\u8108\u3092\u5206\u6790\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6d6e\u304b\u3073\u4e0a\u304c\u3063\u3066\u304d\u305f\u30d1\u30bf\u30fc\u30f3\u306b\u57fa\u3065\u3044\u3066\u3001\u7684\u78ba\u306a\u63a8\u6e2c\u3092\u7acb\u3066\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u9ad8\u3044\u30a4\u30f3\u30d1\u30af\u30c8\u3092\u6301\u3064\u5358\u8a9e\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3053\u3068\u3067\u3001\u6226\u7565\u3092\u6d17\u7df4\u3059\u308b\u3002\u3053\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u3001\u6642\u9593\u7bc0\u7d04\u3060\u3051\u3067\u306a\u304f\u3001\u30b2\u30fc\u30e0\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306e\u7406\u89e3\u3092\u6df1\u3081\u308b\u52b9\u679c\u3082\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u304cRedactle\u3092\u30de\u30b9\u30bf\u30fc\u3057\u3001\u9ad8\u3044\u7cbe\u5ea6\u3092\u9054\u6210\u3059\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Redactle\u306e\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u7cbe\u5ea6\u3068\u52b9\u7387\u3092\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u306b\u3044\u304f\u3064\u304b\u306e\u6226\u7565\u3092\u4f7f\u7528\u3067\u304d\u307e\u3059\u3002\u307e\u305a\u3001\u591a\u304f\u306e\u8a18\u4e8b\u3067\u51fa\u73fe\u3059\u308b\u53ef\u80fd\u6027\u304c\u9ad8\u3044\u3001\u9ad8\u3044\u983b\u5ea6\u306e\u5358\u8a9e\uff08\u300e\u6b74\u53f2\u300f\u3001\u300e\u79d1\u5b66\u300f\u3001\u300e\u6280\u8853\u300f\u306a\u3069\uff09\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u6b21\u306b\u3001\u53ef\u80fd\u306a\u30c8\u30d4\u30c3\u30af\u3092\u7d5e\u308a\u8fbc\u3080\u305f\u3081\u306b\u3001\u6d88\u53bb\u6cd5\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u8a18\u4e8b\u306b\u65e5\u4ed8\u304c\u591a\u304f\u542b\u307e\u308c\u3066\u3044\u308b\u5834\u5408\u306f\u3001\u6b74\u53f2\u7684\u51fa\u6765\u4e8b\u306b\u95a2\u3059\u308b\u3082\u306e\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u7b2c\u4e09\u306b\u3001\u4e00\u822c\u7684\u306aWikipedia\u8a18\u4e8b\u69cb\u9020\u306e\u77e5\u8b58\u3092\u6d3b\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u660e\u3089\u304b\u306b\u306a\u3063\u305f\u30c6\u30ad\u30b9\u30c8\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u7279\u5b9a\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6587\u8108\u306e\u30d2\u30f3\u30c8\u3092\u4f7f\u7528\u3057\u3066\u95a2\u9023\u3059\u308b\u7528\u8a9e\u3092\u63a8\u6e2c\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u65e2\u77e5\u306eWikipedia\u306e\u30ab\u30c6\u30b4\u30ea\u30fc\u3068\u63a8\u6e2c\u3092\u7167\u5408\u3059\u308b\u3002\u3053\u306e\u591a\u89d2\u7684\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u306b\u3088\u308a\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4f53\u9a13\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002"}, {"question": "Redactle\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u6700\u7d42\u30b9\u30b3\u30a2\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u8981\u56e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Redactle\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u8a18\u4e8b\u306e\u30c8\u30d4\u30c3\u30af\u3092\u6b63\u3057\u304f\u7279\u5b9a\u3059\u308b\u307e\u3067\u306b\u5fc5\u8981\u306a\u63a8\u6e2c\u56de\u6570\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u63a8\u6e2c\u56de\u6570\u304c\u5c11\u306a\u3044\u307b\u3069\u3001\u30b9\u30b3\u30a2\u306f\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002\u30b9\u30b3\u30a2\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u8981\u56e0\u306b\u306f\u3001\u63a8\u6e2c\u306e\u52b9\u7387\u6027\u3068\u3001\u660e\u3089\u304b\u306b\u306a\u3063\u305f\u5358\u8a9e\u304b\u3089\u30c8\u30d4\u30c3\u30af\u3092\u63a8\u6e2c\u3059\u308b\u80fd\u529b\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u7269\u7406\u5b66\u95a2\u9023\u306e\u8a18\u4e8b\u3067\u521d\u671f\u306b\u300e\u30a2\u30a4\u30f3\u30b7\u30e5\u30bf\u30a4\u30f3\u300f\u3092\u5f53\u3066\u308c\u3070\u3001\u30b9\u30b3\u30a2\u306f\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u8907\u6570\u306e\u30a4\u30f3\u30b9\u30bf\u30f3\u30b9\u3092\u660e\u3089\u304b\u306b\u3059\u308b\u9ad8\u3044\u5f71\u97ff\u529b\u3092\u6301\u3064\u5358\u8a9e\u3092\u512a\u5148\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6587\u8108\u306e\u30d2\u30f3\u30c8\u3092\u4f7f\u7528\u3057\u3066\u3001\u7684\u78ba\u306a\u63a8\u6e2c\u3092\u884c\u3046\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u78ba\u7387\u306e\u9ad8\u3044\u7528\u8a9e\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3053\u3068\u3067\u3001\u30e9\u30f3\u30c0\u30e0\u306a\u63a8\u6e2c\u3092\u6700\u5c0f\u9650\u306b\u3059\u308b\u3002\u3053\u308c\u3089\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u6700\u9069\u5316\u3057\u3001\u3088\u308a\u826f\u3044\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Redactle\u306e\u6280\u8853\u7684\u306a\u5074\u9762\u3092\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u7406\u89e3\u3057\u3066\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5411\u4e0a\u3055\u305b\u308b\u306b\u306f\uff1f", "answer": "Redactle\u306e\u6280\u8853\u7684\u306a\u5074\u9762\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002\u91cd\u8981\u306a\u8981\u7d20\u306b\u306f\u3001\u30b2\u30fc\u30e0\u306e\u5358\u8a9e\u983b\u5ea6\u5206\u6790\u3068Wikipedia\u8a18\u4e8b\u306e\u69cb\u9020\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u7279\u5b9a\u306e\u6587\u8108\u3067\u300e\u4e16\u7d00\u300f\u3084\u300e\u653f\u5e9c\u300f\u306e\u3088\u3046\u306a\u7279\u5b9a\u306e\u5358\u8a9e\u304c\u983b\u7e41\u306b\u51fa\u73fe\u3059\u308b\u3068\u3044\u3046\u3053\u3068\u3092\u77e5\u3063\u3066\u3044\u308c\u3070\u3001\u63a8\u6e2c\u3092\u5c0e\u304f\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u4e00\u822c\u7684\u306aWikipedia\u306e\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u3084\u30ab\u30c6\u30b4\u30ea\u30fc\u306b\u7cbe\u901a\u3059\u308b\u3053\u3068\u3067\u3001\u8cb4\u91cd\u306a\u6d1e\u5bdf\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u7570\u306a\u308b\u30c8\u30d4\u30c3\u30af\u306b\u304a\u3051\u308b\u4e00\u822c\u7684\u306a\u5358\u8a9e\u306e\u983b\u5ea6\u3092\u7814\u7a76\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u4e00\u822c\u7684\u306aWikipedia\u8a18\u4e8b\u306e\u69cb\u9020\u3092\u5206\u6790\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u3053\u306e\u77e5\u8b58\u3092\u9069\u7528\u3057\u3066\u3001\u3088\u308a\u60c5\u5831\u306b\u57fa\u3065\u3044\u305f\u63a8\u6e2c\u3092\u884c\u3046\u3002\u3053\u306e\u6280\u8853\u7684\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u306b\u3088\u308a\u3001\u30b2\u30fc\u30e0\u3067\u7af6\u4e89\u4e0a\u306e\u512a\u4f4d\u6027\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002"}, {"question": "Redactle\u306e\u9032\u884c\u72b6\u6cc1\u3084\u30c7\u30fc\u30bf\u3092\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u79fb\u884c\u3059\u308b\u306b\u306f\uff1f", "answer": "Redactle\u306e\u9032\u884c\u72b6\u6cc1\u3084\u30c7\u30fc\u30bf\u3092\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u79fb\u884c\u3059\u308b\u3053\u3068\u306f\u3001\u73fe\u5728\u3001\u30b2\u30fc\u30e0\u306e\u30c7\u30b6\u30a4\u30f3\u3067\u306f\u30b5\u30dd\u30fc\u30c8\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002Redactle\u306f\u3001\u30e6\u30fc\u30b6\u30fc\u30a2\u30ab\u30a6\u30f3\u30c8\u3084\u30ed\u30fc\u30ab\u30eb\u3067\u306e\u9032\u884c\u72b6\u6cc1\u306e\u4fdd\u5b58\u306f\u4e0d\u8981\u306a\u30d6\u30e9\u30a6\u30b6\u30d9\u30fc\u30b9\u306e\u30b2\u30fc\u30e0\u3067\u3059\u3002\u5404\u30b2\u30fc\u30e0\u30bb\u30c3\u30b7\u30e7\u30f3\u306f\u72ec\u7acb\u3057\u3066\u304a\u308a\u3001\u65b0\u3057\u3044\u30b2\u30fc\u30e0\u3092\u59cb\u3081\u308b\u305f\u3073\u306b\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u6700\u521d\u304b\u3089\u3084\u308a\u76f4\u3057\u307e\u3059\u3002\u305f\u3060\u3057\u3001\u30b9\u30b3\u30a2\u3084\u6226\u7565\u3092\u8a18\u9332\u3059\u308b\u3053\u3068\u3067\u3001\u624b\u52d5\u3067\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u8ffd\u8de1\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5404\u30c8\u30d4\u30c3\u30af\u306b\u5fc5\u8981\u306a\u63a8\u6e2c\u56de\u6570\u3092\u8a18\u9332\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u624b\u52d5\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u3001\u81ea\u52d5\u5316\u3055\u308c\u305f\u30c7\u30fc\u30bf\u8ee2\u9001\u306a\u3057\u3067\u3082\u3001\u6642\u9593\u306e\u7d4c\u904e\u306b\u4f34\u3046\u3042\u306a\u305f\u306e\u6539\u5584\u3092\u76e3\u8996\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "Redactle\u3067\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\uff1f", "answer": "Redactle\u306b\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u5411\u4e0a\u3055\u305b\u308b\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u3044\u304f\u3064\u304b\u3042\u308a\u307e\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u7279\u5fb4\u306e1\u3064\u306f\u3001\u63a8\u6e2c\u5c65\u6b74\u3092\u8868\u793a\u3059\u308b\u6a5f\u80fd\u3067\u3042\u308a\u3001\u6226\u7565\u3092\u5206\u6790\u3057\u3001\u4eca\u5f8c\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5411\u4e0a\u3055\u305b\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u4e00\u90e8\u306e\u8a18\u4e8b\u306b\u306f\u3001\u30b2\u30fc\u30e0\u306b\u697d\u3057\u307f\u3092\u52a0\u3048\u308b\u96a0\u3055\u308c\u305f\u30b8\u30e7\u30fc\u30af\u3084\u53c2\u7167\u304c\u542b\u307e\u308c\u3066\u3044\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6709\u540d\u306a\u30b3\u30e1\u30c7\u30a3\u30a2\u30f3\u306b\u95a2\u3059\u308b\u8a18\u4e8b\u306b\u306f\u3001\u30e6\u30fc\u30e2\u30e9\u30b9\u306a\u9ed2\u5857\u308a\u3055\u308c\u305f\u30bb\u30af\u30b7\u30e7\u30f3\u304c\u542b\u307e\u308c\u3066\u3044\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u96a0\u3055\u308c\u305f\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u767a\u898b\u3059\u308b\u305f\u3081\u306b\u3001\u30b2\u30fc\u30e0\u30a4\u30f3\u30bf\u30fc\u30d5\u30a7\u30fc\u30b9\u3092\u5fb9\u5e95\u7684\u306b\u63a2\u7d22\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u8a18\u4e8b\u306e\u4e2d\u306e\u73cd\u3057\u3044\u30d1\u30bf\u30fc\u30f3\u3084\u53c2\u7167\u306b\u6ce8\u610f\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u3068\u767a\u898b\u3092\u5171\u6709\u3057\u3066\u3001\u77e5\u8b58\u3092\u5171\u540c\u3067\u9ad8\u3081\u308b\u3002\u3053\u308c\u3089\u306e\u96a0\u3055\u308c\u305f\u8981\u7d20\u306b\u3088\u308a\u3001\u30b2\u30fc\u30e0\u306f\u3055\u3089\u306b\u9b45\u529b\u7684\u3067\u697d\u3057\u3044\u3082\u306e\u306b\u306a\u308b\u3067\u3057\u3087\u3046\u3002"}, {"question": "Redactle\u306e\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u3069\u306e\u5358\u8a9e\u3092\u9ed2\u5857\u308a\u306b\u3059\u308b\u304b\u3092\u3069\u306e\u3088\u3046\u306b\u6c7a\u5b9a\u3057\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3053\u308c\u3092\u3069\u306e\u3088\u3046\u306b\u6709\u5229\u306b\u5229\u7528\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Redactle\u306e\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u8a18\u4e8b\u306e\u4e2d\u306e\u5358\u8a9e\u306e\u983b\u5ea6\u3068\u95a2\u9023\u6027\u306b\u57fa\u3065\u3044\u3066\u5358\u8a9e\u3092\u9ed2\u5857\u308a\u3057\u307e\u3059\u3002\u300ethe\u300f\u3084\u300eand\u300f\u306e\u3088\u3046\u306a\u5171\u901a\u306e\u5358\u8a9e\u306f\u3001\u901a\u5e38\u9ed2\u5857\u308a\u3055\u308c\u305a\u3001\u3088\u308a\u5177\u4f53\u7684\u306a\u7528\u8a9e\u306f\u96a0\u3055\u308c\u307e\u3059\u3002\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u591a\u304f\u306e\u8a18\u4e8b\u3067\u51fa\u73fe\u3059\u308b\u53ef\u80fd\u6027\u304c\u9ad8\u3044\u3001\u9ad8\u3044\u983b\u5ea6\u306e\u5358\u8a9e\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3053\u3068\u3067\u3001\u3053\u308c\u3092\u6709\u5229\u306b\u5229\u7528\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u653f\u6cbb\u8a18\u4e8b\u3067\u300e\u30a2\u30e1\u30ea\u30ab\u5408\u8846\u56fd\u300f\u3092\u5f53\u3066\u308c\u3070\u3001\u8907\u6570\u306e\u30a4\u30f3\u30b9\u30bf\u30f3\u30b9\u304c\u660e\u3089\u304b\u306b\u306a\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u9ed2\u5857\u308a\u3055\u308c\u3066\u3044\u306a\u3044\u53ef\u80fd\u6027\u304c\u9ad8\u3044\u4e00\u822c\u7684\u306a\u5358\u8a9e\u3092\u7279\u5b9a\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u3053\u308c\u3089\u306e\u5358\u8a9e\u3092\u4f7f\u3063\u3066\u3001\u8a18\u4e8b\u306e\u30c8\u30d4\u30c3\u30af\u306b\u95a2\u3059\u308b\u4eee\u8aac\u3092\u7acb\u3066\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u660e\u3089\u304b\u306b\u306a\u3063\u305f\u30b3\u30f3\u30c6\u30ad\u30b9\u30c8\u306b\u57fa\u3065\u3044\u3066\u3001\u63a8\u6e2c\u3092\u7d5e\u308a\u8fbc\u3080\u3002\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306e\u8ad6\u7406\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u6226\u7565\u7684\u306a\u63a8\u6e2c\u3092\u884c\u3046\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Redactle\u3067\u521d\u5fc3\u8005\u304c\u6700\u3082\u3088\u304f\u72af\u3059\u30df\u30b9\u3068\u305d\u306e\u56de\u907f\u7b56\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Redactle\u306e\u521d\u5fc3\u8005\u306b\u3088\u304f\u3042\u308b\u30df\u30b9\u306f\u3001\u6226\u7565\u306a\u3057\u3067\u30e9\u30f3\u30c0\u30e0\u306a\u5358\u8a9e\u3092\u5f53\u3066\u308b\u3053\u3068\u3067\u3059\u3002\u3053\u308c\u306f\u3001\u591a\u304f\u306e\u9593\u9055\u3063\u305f\u63a8\u6e2c\u306b\u3064\u306a\u304c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3082\u30461 \u3064\u306e\u3088\u304f\u3042\u308b\u9593\u9055\u3044\u306f\u3001\u300ethe\u300f\u3084\u300eand\u300f\u306e\u3088\u3046\u306a\u3001\u8a18\u4e8b\u306e\u5927\u90e8\u5206\u3092\u660e\u3089\u304b\u306b\u3067\u304d\u308b\u4e00\u822c\u7684\u306a\u5358\u8a9e\u3092\u7121\u8996\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u3053\u308c\u3089\u306e\u30df\u30b9\u3092\u907f\u3051\u308b\u306b\u306f\u3001\u307e\u305a\u9ad8\u983b\u5ea6\u306e\u5358\u8a9e\u3092\u5f53\u3066\u3066\u3001\u660e\u3089\u304b\u306b\u306a\u3063\u305f\u30c6\u30ad\u30b9\u30c8\u3092\u6b21\u306e\u63a8\u6e2c\u306e\u30ac\u30a4\u30c9\u3068\u3057\u3066\u4f7f\u7528\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300ethe\u300f\u304c\u8907\u6570\u306e\u30a4\u30f3\u30b9\u30bf\u30f3\u30b9\u3092\u660e\u3089\u304b\u306b\u3057\u305f\u5834\u5408\u306f\u3001\u8a18\u4e8b\u306e\u4e00\u822c\u7684\u306a\u69cb\u9020\u3092\u63a8\u6e2c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u8a18\u4e8b\u3092\u591a\u304f\u660e\u3089\u304b\u306b\u3059\u308b\u305f\u3081\u306b\u3001\u4e00\u822c\u7684\u306a\u5358\u8a9e\u3092\u512a\u5148\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u660e\u3089\u304b\u306b\u306a\u3063\u305f\u5358\u8a9e\u3092\u4f7f\u3063\u3066\u3001\u30c8\u30d4\u30c3\u30af\u306b\u95a2\u3059\u308b\u4eee\u8aac\u3092\u7acb\u3066\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u78ba\u7387\u306e\u9ad8\u3044\u7528\u8a9e\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3053\u3068\u3067\u3001\u30e9\u30f3\u30c0\u30e0\u306a\u63a8\u6e2c\u3092\u907f\u3051\u308b\u3002\u3053\u306e\u69cb\u9020\u5316\u3055\u308c\u305f\u30a2\u30d7\u30ed\u30fc\u30c1\u306b\u3088\u308a\u3001\u521d\u5fc3\u8005\u3082\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001Redactle\u3092\u3069\u306e\u3088\u3046\u306b\u4f7f\u7528\u3057\u3066\u3001\u3055\u307e\u3056\u307e\u306a\u30c8\u30d4\u30c3\u30af\u306b\u95a2\u3059\u308b\u77e5\u8b58\u3092\u697d\u3057\u307f\u306a\u304c\u3089\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Redactle\u306f\u3001\u697d\u3057\u304f\u6311\u6226\u7684\u306a\u30b2\u30fc\u30e0\u306e\u4e2d\u3067\u5e45\u5e83\u3044\u5206\u91ce\u306b\u95a2\u3059\u308b\u77e5\u8b58\u3092\u5b66\u3076\u305f\u3081\u306e\u72ec\u7279\u306e\u65b9\u6cd5\u3092\u63d0\u4f9b\u3057\u3066\u3044\u307e\u3059\u3002\u5358\u8a9e\u3092\u5f53\u3066\u3066Wikipedia\u306e\u8a18\u4e8b\u3092\u660e\u3089\u304b\u306b\u3059\u308b\u3053\u3068\u306b\u3088\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u305d\u3046\u3067\u306a\u3051\u308c\u3070\u691c\u8a0e\u3057\u306a\u304b\u3063\u305f\u3067\u3042\u308d\u3046\u30c8\u30d4\u30c3\u30af\u306b\u95a2\u3059\u308b\u65b0\u3057\u3044\u60c5\u5831\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u7269\u7406\u5b66\u306e\u8a18\u4e8b\u3067\u300e\u91cf\u5b50\u300f\u3092\u5f53\u3066\u308b\u3068\u3001\u91cf\u5b50\u529b\u5b66\u3092\u5b66\u3076\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u77e5\u8b58\u3092\u5e83\u3052\u308b\u305f\u3081\u306b\u3001\u672a\u77e5\u306e\u30c8\u30d4\u30c3\u30af\u306b\u95a2\u3059\u308b\u8a18\u4e8b\u3092\u9078\u629e\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b2\u30fc\u30e0\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u4f7f\u7528\u3057\u3066\u3001\u91cd\u8981\u306a\u7528\u8a9e\u3068\u6982\u5ff5\u3092\u660e\u3089\u304b\u306b\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u660e\u3089\u304b\u306b\u306a\u3063\u305f\u60c5\u5831\u3092\u7814\u7a76\u3057\u3066\u3001\u7406\u89e3\u3092\u6df1\u3081\u308b\u3002\u3053\u306e\u6559\u80b2\u7684\u306a\u5074\u9762\u306b\u3088\u308a\u3001Redactle\u306f\u5358\u306a\u308b\u30b2\u30fc\u30e0\u3067\u306f\u306a\u304f\u3001\u8cb4\u91cd\u306a\u5b66\u7fd2\u30c4\u30fc\u30eb\u3068\u306a\u3063\u3066\u3044\u307e\u3059\u3002"}]
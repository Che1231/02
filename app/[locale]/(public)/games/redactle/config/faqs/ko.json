[{"question": "\ucd08\ubcf4\uc790\ub97c \uc704\ud55c Redactle\uc758 \uc791\ub3d9 \ubc29\uc2dd\uacfc \uac8c\uc784 \uc2dc\uc791\uc744 \uc704\ud55c \uae30\ubcf8 \ub2e8\uacc4\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Redactle\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc228\uaca8\uc9c4 \ubb38\uc11c\ub97c \ubc1d\ud788\uae30 \uc704\ud574 \ub2e8\uc5b4\ub97c \ucd94\uce21\ud558\ub294 \ub2e8\uc5b4 \ud37c\uc990 \uac8c\uc784\uc785\ub2c8\ub2e4. \uc2dc\uc791\ud558\ub824\uba74 Redactle \uc6f9\uc0ac\uc774\ud2b8\uc5d0 \uc811\uc18d\ud558\uc5ec '\uc0c8\ub85c\uc6b4 \uac8c\uc784'\uc744 \ud074\ub9ad\ud558\uc2ed\uc2dc\uc624. \uac8c\uc784\uc740 \ub9e4\uc6b0 \uc228\uaca8\uc9c4 \uc704\ud0a4\ud53c\ub514\uc544 \ubb38\uc11c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ubaa9\ud45c\ub294 \ubb38\uc11c\uc5d0 \ub098\ud0c0\ub098\ub294 \ub2e8\uc5b4\ub97c \ucd94\uce21\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc785\ub825 \uc0c1\uc790\uc5d0 \ucd94\uce21\uc744 \uc785\ub825\ud558\uace0 \uc5d4\ud130 \ud0a4\ub97c \ub204\ub974\uc2ed\uc2dc\uc624. \uc62c\ubc14\ub978 \ucd94\uce21\uc740 \ubb38\uc11c\uc5d0\uc11c \ud574\ub2f9 \ub2e8\uc5b4\uc758 \ubaa8\ub4e0 \uc608\uc2dc\ub97c \ub4dc\ub7ec\ub0c5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'the'\ub97c \ucd94\uce21\ud558\uba74 \ud14d\uc2a4\ud2b8\uc5d0\uc11c \ubaa8\ub4e0 'the'\uac00 \ub4dc\ub7ec\ub0a9\ub2c8\ub2e4. \ubb38\uc11c\uc758 \uc8fc\uc81c\ub97c \uc720\ucd94\ud560 \uc218 \uc788\uc744 \ub54c\uae4c\uc9c0 \uacc4\uc18d \ucd94\uce21\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 1: 'the', 'and', 'of'\uc640 \uac19\uc740 \uc77c\ubc18\uc801\uc778 \ub2e8\uc5b4\ub85c \uc2dc\uc791\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \ub4dc\ub7ec\ub09c \ub2e8\uc5b4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc8fc\uc81c\uc5d0 \ub300\ud55c \uac00\uc124\uc744 \uc138\uc6b0\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \ub354 \uad6c\uccb4\uc801\uc778 \ub2e8\uc5b4\ub97c \ucd94\uce21\ud558\uc5ec \uc8fc\uc81c\ub97c \uc881\ud788\uc2ed\uc2dc\uc624."}, {"question": "Redactle\uc5d0\uc11c \ubb38\uc11c\ub97c \uc815\ud655\ud558\uac8c \ucd94\uce21\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "Redactle\uc5d0\uc11c \ubb38\uc11c\ub97c \uc815\ud655\ud558\uac8c \ucd94\uce21\ud558\ub294 \uac83\uc740 \ud6a8\uc728\uc131\uacfc \uc131\uacf5\ub960\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc815\ud655\ud55c \ucd94\uce21\uc740 \ubb38\uc11c\uc758 \ub354 \ub9ce\uc740 \ubd80\ubd84\uc744 \ub4dc\ub7ec\ub0b4 \uc804\uccb4 \uc8fc\uc81c\uc5d0 \ub300\ud55c \ub2e8\uc11c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ubbf8\uad6d\"\uc744 \ucd94\uce21\ud558\uace0 \uc790\uc8fc \ub098\ud0c0\ub098\uba74 \ubb38\uc11c\uac00 \ubbf8\uad6d \uc5ed\uc0ac \ub610\ub294 \uc9c0\ub9ac\uc5d0 \uad00\ud55c \ub0b4\uc6a9\uc77c \uac00\ub2a5\uc131\uc774 \ub192\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc804\ub7b5\uc801\uc778 \ucd94\uce21\uc740 \uc804\uccb4 \ubb38\uc11c\ub97c \ubc1d\ud788\ub294 \ub370 \ud544\uc694\ud55c \uc2dc\ub3c4 \ud69f\uc218\ub97c \uc904\uc785\ub2c8\ub2e4. \ub2e8\uacc4 1: \ub4dc\ub7ec\ub09c \ub2e8\uc5b4\uc758 \ube48\ub3c4\uc640 \ub9e5\ub77d\uc744 \ubd84\uc11d\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \ub098\ud0c0\ub098\ub294 \ud328\ud134\uc744 \ubc14\ud0d5\uc73c\ub85c \uad50\uc721\uc801\uc778 \ucd94\uce21\uc744 \uc0dd\uc131\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \uc601\ud5a5\ub825\uc774 \ud070 \ub2e8\uc5b4\uc5d0 \uc9d1\uc911\ud558\uc5ec \uc804\ub7b5\uc744 \uac1c\uc120\ud558\uc2ed\uc2dc\uc624. \uc774\ub7ec\ud55c \uc811\uadfc \ubc29\uc2dd\uc740 \uc2dc\uac04\uc744 \uc808\uc57d\ud560 \ubfd0\ub9cc \uc544\ub2c8\ub77c \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc5d0 \ub300\ud55c \uc774\ud574\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4."}, {"question": "Redactle\uc744 \ub9c8\uc2a4\ud130\ud558\uace0 \ub192\uc740 \uc815\ud655\ub3c4\ub97c \ub2ec\uc131\ud558\uae30 \uc704\ud55c \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uc758 \ucd5c\uc0c1\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Redactle\uc758 \uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \uc815\ud655\uc131\uacfc \ud6a8\uc728\uc131\uc744 \ub192\uc774\uae30 \uc704\ud574 \uc5ec\ub7ec \uc804\ub7b5\uc744 \ud65c\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uccab\uc9f8, \"\uc5ed\uc0ac\", \"\uacfc\ud559\" \ub610\ub294 \"\uae30\uc220\"\uacfc \uac19\uc774 \ub9ce\uc740 \ubb38\uc11c\uc5d0 \ub098\ud0c0\ub0a0 \uac00\ub2a5\uc131\uc774 \ub192\uc740 \uace0\ube48\ub3c4 \ub2e8\uc5b4\uc5d0 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \ub458\uc9f8, \uc81c\uac70 \uacfc\uc815\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc7a0\uc7ac\uc801\uc778 \uc8fc\uc81c\ub97c \uc881\ud788\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ubb38\uc11c\uc5d0 \ub9ce\uc740 \ub0a0\uc9dc\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\ub2e4\uba74 \uc5ed\uc0ac\uc801 \uc0ac\uac74\uc5d0 \uad00\ud55c \ub0b4\uc6a9\uc77c \uac00\ub2a5\uc131\uc774 \ub192\uc2b5\ub2c8\ub2e4. \uc14b\uc9f8, \uc77c\ubc18\uc801\uc778 \uc704\ud0a4\ud53c\ub514\uc544 \ubb38\uc11c \uad6c\uc870\ub97c \ud65c\uc6a9\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 1: \ub4dc\ub7ec\ub09c \ud14d\uc2a4\ud2b8\uc758 \ud328\ud134\uc744 \ud30c\uc545\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \ub9e5\ub77d \ub2e8\uc11c\ub97c \uc0ac\uc6a9\ud558\uc5ec \uad00\ub828 \uc6a9\uc5b4\ub97c \ucd94\uce21\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \uc54c\ub824\uc9c4 \uc704\ud0a4\ud53c\ub514\uc544 \uce74\ud14c\uace0\ub9ac\uc640 \ucd94\uce21\uc744 \uad50\ucc28 \ucc38\uc870\ud558\uc2ed\uc2dc\uc624. \uc774 \ub2e4\uba74\uc801\uc778 \uc811\uadfc \ubc29\uc2dd\uc740 \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uac83\uc785\ub2c8\ub2e4."}, {"question": "Redactle\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \ucd5c\uc885 \uc810\uc218\uc5d0 \uc5b4\ub5a4 \uc694\uc18c\uac00 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "Redactle\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ubb38\uc11c\uc758 \uc8fc\uc81c\ub97c \uc815\ud655\ud558\uac8c \uc2dd\ubcc4\ud558\uae30 \uc804\uc5d0 \uc0ac\uc6a9\ud558\ub294 \ucd94\uce21 \ud69f\uc218\ub97c \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. \ucd94\uce21 \ud69f\uc218\uac00 \uc801\uc744\uc218\ub85d \uc810\uc218\uac00 \ub192\uc2b5\ub2c8\ub2e4. \uc810\uc218\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc694\uc18c\ub294 \ucd94\uce21\uc758 \ud6a8\uc728\uc131\uacfc \ub4dc\ub7ec\ub09c \ub2e8\uc5b4\ub85c\ubd80\ud130 \uc8fc\uc81c\ub97c \uc720\ucd94\ud558\ub294 \ub2a5\ub825\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubb3c\ub9ac\ud559 \uad00\ub828 \ubb38\uc11c\uc5d0\uc11c \ucd08\uae30\uc5d0 \"\uc544\uc778\uc288\ud0c0\uc778\"\uc744 \ucd94\uce21\ud558\uba74 \uc810\uc218\uac00 \ub192\uc744 \uac83\uc785\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc5ec\ub7ec \uc608\uc2dc\ub97c \ub4dc\ub7ec\ub0b4\ub294 \uc601\ud5a5\ub825\uc774 \ud070 \ub2e8\uc5b4\ub97c \uc6b0\uc120\uc2dc\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \ub9e5\ub77d \ub2e8\uc11c\ub97c \uc0ac\uc6a9\ud558\uc5ec \uad50\uc721\uc801\uc778 \ucd94\uce21\uc744 \ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \uac00\uc7a5 \uac00\ub2a5\uc131\uc774 \ub192\uc740 \uc6a9\uc5b4\uc5d0 \uc9d1\uc911\ud558\uc5ec \ubb34\uc791\uc704 \ucd94\uce21\uc744 \ucd5c\uc18c\ud654\ud558\uc2ed\uc2dc\uc624. \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\uba74 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ucd5c\uc801\ud654\ud558\uace0 \ub354 \ub098\uc740 \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Redactle\uc758 \uc5b4\ub5a4 \uae30\uc220\uc801\uc778 \uce21\uba74\uc744 \uc774\ud574\ud558\uba74 \uc131\ub2a5\uc744 \uac1c\uc120\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Redactle\uc758 \uae30\uc220\uc801\uc778 \uce21\uba74\uc744 \uc774\ud574\ud558\uba74 \uc131\ub2a5\uc744 \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud575\uc2ec \uc694\uc18c\uc5d0\ub294 \uac8c\uc784\uc758 \ub2e8\uc5b4 \ube48\ub3c4 \ubd84\uc11d\uacfc \uc704\ud0a4\ud53c\ub514\uc544 \ubb38\uc11c\uc758 \uad6c\uc870\uac00 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud2b9\uc815 \ub9e5\ub77d\uc5d0\uc11c \"\uc138\uae30\" \ub610\ub294 \"\uc815\ubd80\"\uc640 \uac19\uc740 \ud2b9\uc815 \ub2e8\uc5b4\uac00 \uc790\uc8fc \ub098\ud0c0\ub09c\ub2e4\ub294 \uac83\uc744 \uc544\ub294 \uac83\uc740 \ucd94\uce21\uc744 \uc548\ub0b4\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \uc77c\ubc18\uc801\uc778 \uc704\ud0a4\ud53c\ub514\uc544 \ud15c\ud50c\ub9bf\uacfc \uce74\ud14c\uace0\ub9ac\ub97c \uc219\uc9c0\ud558\uba74 \uadc0\uc911\ud55c \ud1b5\ucc30\ub825\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \ub2e4\uc591\ud55c \uc8fc\uc81c\uc5d0\uc11c \uc77c\ubc18\uc801\uc778 \ub2e8\uc5b4 \ube48\ub3c4\ub97c \uc5f0\uad6c\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \uc77c\ubc18\uc801\uc778 \uc704\ud0a4\ud53c\ub514\uc544 \ubb38\uc11c\uc758 \uad6c\uc870\ub97c \ubd84\uc11d\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \uc774 \uc9c0\uc2dd\uc744 \uc801\uc6a9\ud558\uc5ec \ub354 \uc815\ubcf4\uc5d0 \uc785\uac01\ud55c \ucd94\uce21\uc744 \ud558\uc2ed\uc2dc\uc624. \uc774 \uae30\uc220\uc801\uc778 \uc811\uadfc \ubc29\uc2dd\uc740 \uac8c\uc784\uc5d0\uc11c \uacbd\uc7c1 \uc6b0\uc704\ub97c \ud655\ubcf4\ud558\ub294 \ub370 \ub3c4\uc6c0\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c Redactle\uc758 \uc9c4\ud589 \uc0c1\ud669\uacfc \ub370\uc774\ud130\ub97c \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Redactle\uc758 \uc9c4\ud589 \uc0c1\ud669\uacfc \ub370\uc774\ud130\ub97c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uc804\uc1a1\ud558\ub294 \uae30\ub2a5\uc740 \ud604\uc7ac \uac8c\uc784 \uc124\uacc4\uc5d0\uc11c \uc9c0\uc6d0\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. Redactle\uc740 \uc0ac\uc6a9\uc790 \uacc4\uc815\uc774\ub098 \ub85c\uceec \uc800\uc7a5 \uc9c4\ud589 \uc0c1\ud669\uc774 \ud544\uc694\ud558\uc9c0 \uc54a\uc740 \uc6f9 \uae30\ubc18 \uac8c\uc784\uc785\ub2c8\ub2e4. \uac01 \uac8c\uc784 \uc138\uc158\uc740 \ub3c5\ub9bd\uc801\uc774\uba70 \ud50c\ub808\uc774\uc5b4\ub294 \uc0c8\ub85c\uc6b4 \uac8c\uc784\uc744 \uc2dc\uc791\ud560 \ub54c\ub9c8\ub2e4 \uc0c8\ub85c \uc2dc\uc791\ud569\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \uc810\uc218\uc640 \uc804\ub7b5\uc744 \uae30\ub85d\ud558\uc5ec \uc218\ub3d9\uc801\uc73c\ub85c \uc131\uacfc\ub97c \ucd94\uc801\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac01 \uc8fc\uc81c\uc5d0 \uc0ac\uc6a9\ub41c \ucd94\uce21 \ud69f\uc218\ub97c \uae30\ub85d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc218\ub3d9\uc801\uc778 \ubc29\ubc95\uc740 \uc790\ub3d9 \ub370\uc774\ud130 \uc804\uc1a1\uc774 \uc5c6\uc5b4\ub3c4 \uc2dc\uac04\uc774 \uc9c0\ub0a8\uc5d0 \ub530\ub77c \uac1c\uc120 \uc0c1\ud669\uc744 \ubaa8\ub2c8\ud130\ub9c1\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Redactle\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Redactle\uc5d0\ub294 \ud50c\ub808\uc774\uc5b4 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uae30\ub2a5\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ud55c \uac00\uc9c0 \uc8fc\ubaa9\ud560 \ub9cc\ud55c \uae30\ub2a5\uc740 \ucd94\uce21 \uc774\ub825\uc744 \ubcfc \uc218 \uc788\ub294 \uae30\ub2a5\uc73c\ub85c, \uc804\ub7b5\uc744 \ubd84\uc11d\ud558\uace0 \ubbf8\ub798\uc758 \uc131\ub2a5\uc744 \uac1c\uc120\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uc77c\ubd80 \ubb38\uc11c\uc5d0\ub294 \uac8c\uc784\uc5d0 \uc7ac\ubbf8\ub97c \ub354\ud558\ub294 \uc228\uaca8\uc9c4 \uc720\uba38 \ub610\ub294 \ucc38\uc870\uac00 \ud3ec\ud568\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc720\uba85 \ucf54\ubbf8\ub514\uc5b8\uc5d0 \uad00\ud55c \ubb38\uc11c\uc5d0\ub294 \uc7ac\ubbf8\uc788\ub294 \uc228\uaca8\uc9c4 \ubd80\ubd84\uc774 \ud3ec\ud568\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc228\uaca8\uc9c4 \uc635\uc158\uc744 \ubc1c\uacac\ud558\uae30 \uc704\ud574 \uac8c\uc784 \uc778\ud130\ud398\uc774\uc2a4\ub97c \ucca0\uc800\ud788 \ud0d0\uc0c9\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \ubb38\uc11c\uc5d0\uc11c \uc774\uc0c1\ud55c \ud328\ud134\uc774\ub098 \ucc38\uc870\uc5d0\uc8fc\uc758\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \ucee4\ubba4\ub2c8\ud2f0\uc640 \ud568\uaed8 \ubc1c\uacac \uc0ac\ud56d\uc744 \uacf5\uc720\ud558\uc5ec \uc9d1\ub2e8\uc801 \uc9c0\uc2dd\uc744 \ub192\uc774\uc2ed\uc2dc\uc624. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uc694\uc18c\ub294 \uac8c\uc784\uc744 \ub354\uc6b1 \ub9e4\ub825\uc801\uc774\uace0 \uc990\uac81\uac8c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Redactle\uc758 \uc54c\uace0\ub9ac\uc998\uc774 \uc5b4\ub5a4 \ub2e8\uc5b4\ub97c \uc228\uae38\uc9c0 \uc5b4\ub5bb\uac8c \uacb0\uc815\ud558\uba70, \ud50c\ub808\uc774\uc5b4\ub294 \uc774\ub97c \uc5b4\ub5bb\uac8c \ud65c\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Redactle\uc758 \uc54c\uace0\ub9ac\uc998\uc740 \ubb38\uc11c\uc5d0\uc11c \ub2e8\uc5b4\uc758 \ube48\ub3c4\uc640 \uad00\ub828\uc131\uc744 \ubc14\ud0d5\uc73c\ub85c \ub2e8\uc5b4\ub97c \uc228\uae41\ub2c8\ub2e4. \"the\" \ubc0f \"and\"\uc640 \uac19\uc740 \uc77c\ubc18\uc801\uc778 \ub2e8\uc5b4\ub294 \uc885\uc885 \uc228\uaca8\uc9c0\uc9c0 \uc54a\uace0, \ub354 \uad6c\uccb4\uc801\uc778 \uc6a9\uc5b4\ub294 \uc228\uaca8\uc9d1\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\ub294 \ub9ce\uc740 \ubb38\uc11c\uc5d0 \ub098\ud0c0\ub0a0 \uac00\ub2a5\uc131\uc774 \ub192\uc740 \uace0\ube48\ub3c4 \ub2e8\uc5b4\uc5d0 \uc9d1\uc911\ud558\uc5ec \uc774\ub97c \ud65c\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc815\uce58 \ubb38\uc11c\uc5d0\uc11c \"\ubbf8\uad6d\"\uc744 \ucd94\uce21\ud558\uba74 \uc5ec\ub7ec \ubc88 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc228\uaca8\uc9c0\uc9c0 \uc54a\uc744 \uac00\ub2a5\uc131\uc774 \ub192\uc740 \uc77c\ubc18\uc801\uc778 \ub2e8\uc5b4\ub97c \uc2dd\ubcc4\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \uc774\ub7ec\ud55c \ub2e8\uc5b4\ub97c \uc0ac\uc6a9\ud558\uc5ec \ubb38\uc11c\uc758 \uc8fc\uc81c\uc5d0 \ub300\ud55c \uac00\uc124\uc744 \uc124\uc815\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \ub4dc\ub7ec\ub09c \ub9e5\ub77d\uc744 \ubc14\ud0d5\uc73c\ub85c \ucd94\uce21\uc744 \uc881\ud788\uc2ed\uc2dc\uc624. \uc54c\uace0\ub9ac\uc998\uc758 \ub17c\ub9ac\ub97c \uc774\ud574\ud558\uba74 \ub354 \uc804\ub7b5\uc801\uc778 \ucd94\uce21\uc744 \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Redactle\uc5d0\uc11c \ucd08\ubcf4\uc790\uac00 \ud754\ud788 \uc800\uc9c0\ub974\ub294 \uc2e4\uc218\ub294 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \uc774\ub97c \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Redactle\uc5d0\uc11c \ucd08\ubcf4\uc790\ub294 \uc885\uc885 \uc804\ub7b5 \uc5c6\uc774 \ubb34\uc791\uc704 \ub2e8\uc5b4\ub97c \ucd94\uce21\ud558\ub294 \uc2e4\uc218\ub97c \uc800\uc9c0\ub974\uba70, \uc774\ub294 \ub9ce\uc740 \uc798\ubabb\ub41c \ucd94\uce21\uc73c\ub85c \uc774\uc5b4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uc77c\ubc18\uc801\uc778 \uc2e4\uc218\ub294 \"the\" \ubc0f \"and\"\uc640 \uac19\uc740 \uc77c\ubc18\uc801\uc778 \ub2e8\uc5b4\uc758 \uc911\uc694\uc131\uc744 \uac04\uacfc\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ub2e8\uc5b4\ub294 \ubb38\uc11c\uc758 \uc0c1\ub2f9 \ubd80\ubd84\uc744 \ub4dc\ub7ec\ub0bc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc2e4\uc218\ub97c \ud53c\ud558\uae30 \uc704\ud574 \uace0\ube48\ub3c4 \ub2e8\uc5b4\ub97c \uba3c\uc800 \ucd94\uce21\ud558\uace0 \ub4dc\ub7ec\ub09c \ud14d\uc2a4\ud2b8\ub97c \ub2e4\uc74c \ucd94\uce21\uc744 \uc548\ub0b4\ud558\ub294 \ub370 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \"the\"\uac00 \uc5ec\ub7ec \ubc88 \ub4dc\ub7ec\ub09c\ub2e4\uba74 \ubb38\uc11c\uc758 \uc77c\ubc18\uc801\uc778 \uad6c\uc870\ub97c \ucd94\ub860\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \ubb38\uc11c\uc758 \ub354 \ub9ce\uc740 \ubd80\ubd84\uc744 \ub4dc\ub7ec\ub0b4\uae30 \uc704\ud574 \uc77c\ubc18\uc801\uc778 \ub2e8\uc5b4\ub97c \uc6b0\uc120\uc2dc\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \ub4dc\ub7ec\ub09c \ub2e8\uc5b4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc8fc\uc81c\uc5d0 \ub300\ud55c \uac00\uc124\uc744 \uc124\uc815\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \uac00\uc7a5 \uac00\ub2a5\uc131\uc774 \ub192\uc740 \uc6a9\uc5b4\uc5d0 \uc9d1\uc911\ud558\uc5ec \ubb34\uc791\uc704 \ucd94\uce21\uc744 \ud53c\ud558\uc2ed\uc2dc\uc624. \uc774\ub7ec\ud55c \uccb4\uacc4\uc801\uc778 \uc811\uadfc \ubc29\uc2dd\uc740 \ucd08\ubcf4\uc790\uc758 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uac1c\uc120\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 Redactle\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub2e4\uc591\ud55c \uc8fc\uc81c\uc5d0 \ub300\ud55c \uc9c0\uc2dd\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uace0 \uc990\uac70\uc6c0\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Redactle\uc740 \uc7ac\ubbf8\uc788\uace0 \ub3c4\uc804\uc801\uc778 \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud558\uba74\uc11c \ub2e4\uc591\ud55c \uc8fc\uc81c\uc5d0 \ub300\ud55c \uc9c0\uc2dd\uc744 \ud655\uc7a5\ud558\ub294 \ub3c5\ud2b9\ud55c \ubc29\ubc95\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub2e8\uc5b4\ub97c \ucd94\uce21\ud558\uace0 \uc704\ud0a4\ud53c\ub514\uc544 \ubb38\uc11c\ub97c \ubc1d\ud798\uc73c\ub85c\uc368, \ud50c\ub808\uc774\uc5b4\ub294 \uadf8\ub807\uc9c0 \uc54a\uc558\ub2e4\uba74 \ud0d0\uc0c9\ud558\uc9c0 \uc54a\uc558\uc744 \uc8fc\uc81c\uc5d0 \ub300\ud55c \uc0c8\ub85c\uc6b4 \uc815\ubcf4\ub97c \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubb3c\ub9ac\ud559 \ubb38\uc11c\uc5d0\uc11c \"\uc591\uc790\"\ub97c \ucd94\uce21\ud558\uba74 \uc591\uc790 \uc5ed\ud559\uc5d0 \ub300\ud55c \ud559\uc2b5\uc73c\ub85c \uc774\uc5b4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc790\uc2e0\uc774 \ubaa8\ub974\ub294 \uc8fc\uc81c\uc5d0 \ub300\ud55c \ubb38\uc11c\ub97c \uc120\ud0dd\ud558\uc5ec \uc9c0\uc2dd\uc744 \ud655\uc7a5\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud575\uc2ec \uc6a9\uc5b4 \ubc0f \uac1c\ub150\uc744 \ubc1d\ud600\ub0b4\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \ub4dc\ub7ec\ub09c \uc815\ubcf4\ub97c \uc5f0\uad6c\ud558\uc5ec \uc774\ud574\ub3c4\ub97c \uc2ec\ud654\ud558\uc2ed\uc2dc\uc624. \uc774\ub7ec\ud55c \uad50\uc721\uc801\uc778 \uce21\uba74\uc740 Redactle\uc744 \ub2e8\uc21c\ud55c \uac8c\uc784\uc774 \uc544\ub2c8\ub77c \uadc0\uc911\ud55c \ud559\uc2b5 \ub3c4\uad6c\ub85c \ub9cc\ub4ed\ub2c8\ub2e4."}]
[{"question": "Redactle \u5c0d\u521d\u5b78\u8005\u4f86\u8aaa\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f\u958b\u59cb\u904a\u6232\u7684\u57fa\u672c\u6b65\u9a5f\u662f\u4ec0\u9ebc\uff1f", "answer": "Redactle \u662f\u4e00\u6b3e\u6587\u5b57\u8b0e\u984c\u904a\u6232\uff0c\u73a9\u5bb6\u9700\u8981\u731c\u6e2c\u55ae\u5b57\u4f86\u63ed\u66c9\u96b1\u85cf\u7684\u6587\u7ae0\u3002\u8981\u958b\u59cb\u904a\u6232\uff0c\u8acb\u524d\u5f80 Redactle \u7db2\u7ad9\uff0c\u9ede\u64ca\u300e\u65b0\u904a\u6232\u300f\u3002\u904a\u6232\u6703\u5448\u73fe\u4e00\u7bc7\u5927\u91cf\u522a\u7bc0\u7684\u7dad\u57fa\u767e\u79d1\u6587\u7ae0\u3002\u60a8\u7684\u76ee\u6a19\u662f\u731c\u51fa\u6587\u7ae0\u4e2d\u51fa\u73fe\u7684\u55ae\u5b57\u3002\u5728\u8f38\u5165\u6846\u4e2d\u8f38\u5165\u60a8\u7684\u731c\u6e2c\uff0c\u4e26\u6309\u4e0b Enter \u9375\u3002\u6b63\u78ba\u7684\u731c\u6e2c\u5c07\u6703\u986f\u793a\u6587\u7ae0\u4e2d\u8a72\u55ae\u5b57\u7684\u6240\u6709\u51fa\u73fe\u4f4d\u7f6e\u3002\u4f8b\u5982\uff0c\u731c\u6e2c\u300ethe\u300f\u5c07\u6703\u63ed\u793a\u6587\u7ae0\u4e2d\u6240\u6709\u300ethe\u300f\u3002\u7e7c\u7e8c\u731c\u6e2c\uff0c\u76f4\u5230\u60a8\u80fd\u63a8\u65b7\u51fa\u6587\u7ae0\u7684\u4e3b\u984c\u3002\u6b65\u9a5f 1\uff1a\u5f9e\u5e38\u898b\u7684\u55ae\u5b57\u958b\u59cb\uff0c\u4f8b\u5982\u300ethe\u300f\u3001\u300eand\u300f\u3001\u300eof\u300f\u3002\u6b65\u9a5f 2\uff1a\u4f7f\u7528\u63ed\u793a\u7684\u55ae\u5b57\u69cb\u601d\u95dc\u65bc\u4e3b\u984c\u7684\u5047\u8a2d\u3002\u6b65\u9a5f 3\uff1a\u900f\u904e\u731c\u6e2c\u66f4\u5177\u9ad4\u7684\u55ae\u5b57\u4f86\u7e2e\u5c0f\u4e3b\u984c\u7bc4\u570d\u3002"}, {"question": "\u5728 Redactle \u4e2d\u6b63\u78ba\u731c\u6e2c\u6587\u7ae0\u70ba\u4f55\u91cd\u8981\uff0c\u4ee5\u53ca\u9019\u5982\u4f55\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff1f", "answer": "\u5728 Redactle \u4e2d\u6b63\u78ba\u731c\u6e2c\u6587\u7ae0\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u76f4\u63a5\u5f71\u97ff\u60a8\u7684\u6548\u7387\u548c\u6210\u529f\u7387\u3002\u6b63\u78ba\u7684\u731c\u6e2c\u5c07\u63ed\u793a\u66f4\u591a\u6587\u7ae0\u5167\u5bb9\uff0c\u63d0\u4f9b\u4e3b\u984c\u7684\u7dda\u7d22\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u731c\u6e2c\u300e\u7f8e\u570b\u300f\uff0c\u800c\u4e14\u5b83\u51fa\u73fe\u983b\u7e41\uff0c\u60a8\u53ef\u80fd\u6703\u63a8\u65b7\u6587\u7ae0\u662f\u95dc\u65bc\u7f8e\u570b\u6b77\u53f2\u6216\u5730\u7406\u3002\u9019\u7a2e\u7b56\u7565\u6027\u7684\u731c\u6e2c\u53ef\u4ee5\u6e1b\u5c11\u63ed\u66c9\u6574\u7bc7\u6587\u7ae0\u6240\u9700\u7684\u5617\u8a66\u6b21\u6578\u3002\u6b65\u9a5f 1\uff1a\u5206\u6790\u63ed\u793a\u55ae\u5b57\u7684\u983b\u7387\u548c\u8a9e\u5883\u3002\u6b65\u9a5f 2\uff1a\u6839\u64da\u51fa\u73fe\u7684\u6a21\u5f0f\uff0c\u63d0\u51fa\u6839\u64da\u4e8b\u5be6\u7684\u731c\u6e2c\u3002\u6b65\u9a5f 3\uff1a\u5c08\u6ce8\u65bc\u9ad8\u5f71\u97ff\u529b\u7684\u55ae\u5b57\u4f86\u7cbe\u934a\u60a8\u7684\u7b56\u7565\u3002\u9019\u7a2e\u65b9\u6cd5\u4e0d\u50c5\u53ef\u4ee5\u7bc0\u7701\u6642\u9593\uff0c\u9084\u80fd\u589e\u9032\u60a8\u5c0d\u904a\u6232\u6a5f\u5236\u4e86\u89e3\u3002"}, {"question": "\u5c0d\u65bc\u9032\u968e\u73a9\u5bb6\u4f86\u8aaa\uff0c\u7cbe\u901a Redactle \u4e26\u9054\u6210\u66f4\u9ad8\u6e96\u78ba\u5ea6\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "Redactle \u7684\u9032\u968e\u73a9\u5bb6\u53ef\u4ee5\u4f7f\u7528\u5e7e\u7a2e\u7b56\u7565\u4f86\u63d0\u9ad8\u6e96\u78ba\u6027\u548c\u6548\u7387\u3002\u9996\u5148\uff0c\u5c08\u6ce8\u65bc\u9ad8\u983b\u7387\u55ae\u5b57\uff0c\u9019\u4e9b\u55ae\u5b57\u5728\u8a31\u591a\u6587\u7ae0\u4e2d\u5f88\u53ef\u80fd\u6703\u51fa\u73fe\uff0c\u4f8b\u5982\u300e\u6b77\u53f2\u300f\u3001\u300e\u79d1\u5b78\u300f\u6216\u300e\u79d1\u6280\u300f\u3002\u5176\u6b21\uff0c\u5229\u7528\u6392\u9664\u6cd5\u4f86\u7e2e\u5c0f\u6f5b\u5728\u4e3b\u984c\u7684\u7bc4\u570d\u3002\u4f8b\u5982\uff0c\u5982\u679c\u6587\u7ae0\u5305\u542b\u8a31\u591a\u65e5\u671f\uff0c\u5b83\u53ef\u80fd\u8207\u6b77\u53f2\u4e8b\u4ef6\u6709\u95dc\u3002\u7b2c\u4e09\uff0c\u5229\u7528\u60a8\u5c0d\u5e38\u898b\u7dad\u57fa\u767e\u79d1\u6587\u7ae0\u7d50\u69cb\u7684\u77ad\u89e3\u3002\u6b65\u9a5f 1\uff1a\u8b58\u5225\u63ed\u793a\u6587\u672c\u4e2d\u7684\u6a21\u5f0f\u3002\u6b65\u9a5f 2\uff1a\u4f7f\u7528\u8a9e\u5883\u7dda\u7d22\u4f86\u731c\u6e2c\u76f8\u95dc\u8a5e\u5f59\u3002\u6b65\u9a5f 3\uff1a\u5c07\u60a8\u7684\u731c\u6e2c\u8207\u5df2\u77e5\u7684\u7dad\u57fa\u767e\u79d1\u5206\u985e\u9032\u884c\u4ea4\u53c9\u53c3\u8003\u3002\u9019\u7a2e\u591a\u65b9\u9762\u7684\u4f5c\u6cd5\u5c07\u986f\u8457\u63d0\u5347\u60a8\u7684\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "Redactle \u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u60a8\u7684\u6700\u7d42\u5f97\u5206\uff1f", "answer": "Redactle \u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u60a8\u5728\u6b63\u78ba\u8b58\u5225\u6587\u7ae0\u4e3b\u984c\u4e4b\u524d\u6240\u505a\u7684\u731c\u6e2c\u6b21\u6578\u3002\u731c\u6e2c\u6b21\u6578\u8d8a\u5c11\uff0c\u5f97\u5206\u8d8a\u9ad8\u3002\u5f71\u97ff\u60a8\u5f97\u5206\u7684\u56e0\u7d20\u5305\u62ec\u60a8\u7684\u731c\u6e2c\u6548\u7387\u4ee5\u53ca\u60a8\u5f9e\u63ed\u793a\u7684\u55ae\u5b57\u4e2d\u63a8\u65b7\u4e3b\u984c\u7684\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u8207\u7269\u7406\u5b78\u76f8\u95dc\u7684\u6587\u7ae0\u4e2d\u65e9\u671f\u731c\u51fa\u300e\u611b\u56e0\u65af\u5766\u300f\uff0c\u60a8\u7684\u5f97\u5206\u6703\u66f4\u9ad8\u3002\u6b65\u9a5f 1\uff1a\u512a\u5148\u8003\u616e\u9ad8\u5f71\u97ff\u529b\u7684\u55ae\u5b57\uff0c\u9019\u4e9b\u55ae\u5b57\u53ef\u4ee5\u63ed\u793a\u591a\u500b\u5be6\u4f8b\u3002\u6b65\u9a5f 2\uff1a\u4f7f\u7528\u8a9e\u5883\u7dda\u7d22\u63d0\u51fa\u6839\u64da\u4e8b\u5be6\u7684\u731c\u6e2c\u3002\u6b65\u9a5f 3\uff1a\u5c07\u96a8\u6a5f\u731c\u6e2c\u964d\u5230\u6700\u4f4e\uff0c\u5c08\u6ce8\u65bc\u6700\u53ef\u80fd\u7684\u8a5e\u5f59\u3002\u77ad\u89e3\u9019\u4e9b\u6a5f\u5236\u53ef\u4ee5\u5e6b\u52a9\u60a8\u512a\u5316\u904a\u6232\u73a9\u6cd5\u4e26\u9054\u6210\u66f4\u597d\u7684\u5f97\u5206\u3002"}, {"question": "\u73a9\u5bb6\u61c9\u8a72\u77ad\u89e3 Redactle \u7684\u54ea\u4e9b\u6280\u8853\u5c64\u9762\u624d\u80fd\u63d0\u5347\u8868\u73fe\uff1f", "answer": "\u4e86\u89e3 Redactle \u7684\u6280\u8853\u5c64\u9762\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u60a8\u7684\u8868\u73fe\u3002\u95dc\u9375\u8981\u7d20\u5305\u62ec\u904a\u6232\u7684\u8a5e\u983b\u5206\u6790\u548c\u7dad\u57fa\u767e\u79d1\u6587\u7ae0\u7684\u7d50\u69cb\u3002\u4f8b\u5982\uff0c\u77e5\u9053\u67d0\u4e9b\u8a5e\u5f59\uff0c\u5982\u300e\u4e16\u7d00\u300f\u6216\u300e\u653f\u5e9c\u300f\uff0c\u5728\u7279\u5b9a\u8a9e\u5883\u4e2d\u51fa\u73fe\u983b\u7387\u9ad8\uff0c\u53ef\u4ee5\u6307\u5c0e\u60a8\u7684\u731c\u6e2c\u3002\u6b64\u5916\uff0c\u719f\u6089\u5e38\u898b\u7684\u7dad\u57fa\u767e\u79d1\u6a21\u677f\u548c\u5206\u985e\u53ef\u4ee5\u63d0\u4f9b\u5bf6\u8cb4\u7684\u6d1e\u5bdf\u529b\u3002\u6b65\u9a5f 1\uff1a\u7814\u7a76\u4e0d\u540c\u4e3b\u984c\u4e2d\u5e38\u898b\u7684\u8a5e\u983b\u3002\u6b65\u9a5f 2\uff1a\u5206\u6790\u5178\u578b\u7684\u7dad\u57fa\u767e\u79d1\u6587\u7ae0\u7d50\u69cb\u3002\u6b65\u9a5f 3\uff1a\u5c07\u6b64\u77e5\u8b58\u61c9\u7528\u65bc\u505a\u51fa\u66f4\u6709\u6839\u64da\u7684\u731c\u6e2c\u3002\u9019\u7a2e\u6280\u8853\u6027\u7684\u4f5c\u6cd5\u80fd\u8b93\u60a8\u5728\u904a\u6232\u4e2d\u64c1\u6709\u7af6\u722d\u512a\u52e2\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u9593\u50b3\u8f38\u4ed6\u5011\u7684 Redactle \u9032\u5ea6\u548c\u6578\u64da\uff1f", "answer": "\u76ee\u524d\uff0c\u904a\u6232\u8a2d\u8a08\u4e0d\u652f\u6301\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u9593\u50b3\u8f38 Redactle \u9032\u5ea6\u548c\u6578\u64da\u3002Redactle \u662f\u4e00\u6b3e\u57fa\u65bc\u700f\u89bd\u5668\u7684\u904a\u6232\uff0c\u4e0d\u9700\u8981\u4f7f\u7528\u8005\u5e33\u6236\u6216\u672c\u5730\u5132\u5b58\u9032\u5ea6\u3002\u6bcf\u6b21\u904a\u6232\u6703\u8a71\u90fd\u662f\u7368\u7acb\u7684\uff0c\u6bcf\u6b21\u65b0\u904a\u6232\u6642\uff0c\u73a9\u5bb6\u90fd\u6703\u91cd\u65b0\u958b\u59cb\u3002\u4f46\u662f\uff0c\u60a8\u53ef\u4ee5\u900f\u904e\u8a18\u9304\u5206\u6578\u548c\u7b56\u7565\u4f86\u624b\u52d5\u8ffd\u8e64\u60a8\u7684\u8868\u73fe\u3002\u4f8b\u5982\uff0c\u60a8\u53ef\u4ee5\u8a18\u9304\u6bcf\u6b21\u4e3b\u984c\u6240\u4f7f\u7528\u7684\u731c\u6e2c\u6b21\u6578\u3002\u5373\u4f7f\u6c92\u6709\u81ea\u52d5\u8cc7\u6599\u50b3\u8f38\uff0c\u9019\u7a2e\u624b\u52d5\u65b9\u6cd5\u4e5f\u80fd\u5920\u5e6b\u52a9\u60a8\u96a8\u8457\u6642\u9593\u63a8\u79fb\u76e3\u63a7\u81ea\u5df1\u7684\u9032\u6b65\u3002"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728 Redactle \u4e2d\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u7684\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "Redactle \u5305\u542b\u4e00\u4e9b\u96b1\u85cf\u7684\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u53ef\u4ee5\u63d0\u5347\u73a9\u5bb6\u9ad4\u9a57\u3002\u4e00\u500b\u986f\u8457\u7684\u529f\u80fd\u662f\u67e5\u770b\u60a8\u7684\u731c\u6e2c\u6b77\u53f2\uff0c\u9019\u53ef\u4ee5\u5e6b\u52a9\u60a8\u5206\u6790\u60a8\u7684\u7b56\u7565\uff0c\u4e26\u6539\u5584\u672a\u4f86\u7684\u8868\u73fe\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u6587\u7ae0\u53ef\u80fd\u5305\u542b\u96b1\u85cf\u7684\u7b11\u8a71\u6216\u53c3\u8003\uff0c\u9019\u8b93\u904a\u6232\u66f4\u6709\u8da3\u3002\u4f8b\u5982\uff0c\u95dc\u65bc\u77e5\u540d\u559c\u5287\u6f14\u54e1\u7684\u6587\u7ae0\u53ef\u80fd\u6703\u5305\u542b\u4e00\u4e9b\u5e7d\u9ed8\u7684\u522a\u7bc0\u90e8\u5206\u3002\u6b65\u9a5f 1\uff1a\u4ed4\u7d30\u63a2\u7d22\u904a\u6232\u4ecb\u9762\uff0c\u4ee5\u767c\u73fe\u96b1\u85cf\u9078\u9805\u3002\u6b65\u9a5f 2\uff1a\u6ce8\u610f\u6587\u7ae0\u4e2d\u4e0d\u5c0b\u5e38\u7684\u6a21\u5f0f\u6216\u53c3\u8003\u3002\u6b65\u9a5f 3\uff1a\u8207\u793e\u7fa4\u5206\u4eab\u60a8\u7684\u767c\u73fe\uff0c\u4ee5\u589e\u9032\u96c6\u9ad4\u77e5\u8b58\u3002\u9019\u4e9b\u96b1\u85cf\u7684\u5143\u7d20\u53ef\u4ee5\u8b93\u904a\u6232\u66f4\u5f15\u4eba\u5165\u52dd\u4e14\u4ee4\u4eba\u6109\u6085\u3002"}, {"question": "Redactle \u7684\u6f14\u7b97\u6cd5\u662f\u5982\u4f55\u6c7a\u5b9a\u8981\u522a\u7bc0\u54ea\u4e9b\u55ae\u5b57\uff0c\u4ee5\u53ca\u73a9\u5bb6\u5982\u4f55\u5229\u7528\u9019\u4e00\u9ede\u4f86\u63d0\u5347\u81ea\u5df1\u7684\u8868\u73fe\uff1f", "answer": "Redactle \u7684\u6f14\u7b97\u6cd5\u6703\u6839\u64da\u55ae\u5b57\u5728\u6587\u7ae0\u4e2d\u7684\u983b\u7387\u548c\u76f8\u95dc\u6027\u4f86\u522a\u7bc0\u55ae\u5b57\u3002\u5e38\u898b\u7684\u55ae\u5b57\uff0c\u4f8b\u5982\u300ethe\u300f\u548c\u300eand\u300f\uff0c\u901a\u5e38\u6703\u4fdd\u7559\uff0c\u800c\u8f03\u5177\u9ad4\u7684\u8a5e\u5f59\u5247\u6703\u88ab\u96b1\u85cf\u3002\u73a9\u5bb6\u53ef\u4ee5\u5229\u7528\u6b64\u4f86\u63d0\u5347\u81ea\u5df1\u7684\u8868\u73fe\uff0c\u5c08\u6ce8\u65bc\u9ad8\u983b\u7387\u55ae\u5b57\uff0c\u9019\u4e9b\u55ae\u5b57\u5728\u8a31\u591a\u6587\u7ae0\u4e2d\u5f88\u53ef\u80fd\u6703\u51fa\u73fe\u3002\u4f8b\u5982\uff0c\u5728\u653f\u6cbb\u6587\u7ae0\u4e2d\u731c\u6e2c\u300e\u7f8e\u570b\u300f\u6703\u63ed\u793a\u591a\u500b\u5be6\u4f8b\u3002\u6b65\u9a5f 1\uff1a\u627e\u51fa\u5e38\u898b\u7684\u55ae\u5b57\uff0c\u9019\u4e9b\u55ae\u5b57\u53ef\u80fd\u6709\u6a5f\u6703\u4e0d\u88ab\u522a\u7bc0\u3002\u6b65\u9a5f 2\uff1a\u4f7f\u7528\u9019\u4e9b\u55ae\u5b57\u69cb\u601d\u95dc\u65bc\u6587\u7ae0\u4e3b\u984c\u7684\u5047\u8a2d\u3002\u6b65\u9a5f 3\uff1a\u6839\u64da\u63ed\u793a\u7684\u5167\u5bb9\u7e2e\u5c0f\u60a8\u7684\u731c\u6e2c\u7bc4\u570d\u3002\u4e86\u89e3\u6f14\u7b97\u6cd5\u7684\u908f\u8f2f\u53ef\u4ee5\u5e6b\u52a9\u60a8\u505a\u51fa\u66f4\u7b56\u7565\u6027\u7684\u731c\u6e2c\u3002"}, {"question": "Redactle \u521d\u5b78\u8005\u6700\u5e38\u72af\u54ea\u4e9b\u932f\u8aa4\uff0c\u4ee5\u53ca\u5982\u4f55\u907f\u514d\u9019\u4e9b\u932f\u8aa4\uff1f", "answer": "Redactle \u7684\u521d\u5b78\u8005\u5e38\u5e38\u72af\u932f\uff0c\u4ed6\u5011\u6703\u96a8\u6a5f\u731c\u6e2c\u55ae\u5b57\uff0c\u800c\u6c92\u6709\u7b56\u7565\uff0c\u9019\u53ef\u80fd\u6703\u5c0e\u81f4\u8a31\u591a\u4e0d\u6b63\u78ba\u7684\u731c\u6e2c\u3002\u53e6\u4e00\u500b\u5e38\u898b\u932f\u8aa4\u662f\u5ffd\u7565\u5e38\u898b\u55ae\u5b57\uff0c\u4f8b\u5982\u300ethe\u300f\u548c\u300eand\u300f\u7684\u91cd\u8981\u6027\uff0c\u9019\u4e9b\u55ae\u5b57\u53ef\u4ee5\u63ed\u793a\u6587\u7ae0\u7684\u5927\u90e8\u5206\u5167\u5bb9\u3002\u70ba\u4e86\u907f\u514d\u9019\u4e9b\u932f\u8aa4\uff0c\u8acb\u5f9e\u731c\u6e2c\u9ad8\u983b\u7387\u55ae\u5b57\u958b\u59cb\uff0c\u4e26\u4f7f\u7528\u63ed\u793a\u7684\u6587\u5b57\u4f86\u6307\u5c0e\u60a8\u7684\u4e0b\u4e00\u6b21\u731c\u6e2c\u3002\u4f8b\u5982\uff0c\u5982\u679c\u300ethe\u300f\u63ed\u793a\u4e86\u591a\u500b\u5be6\u4f8b\uff0c\u60a8\u53ef\u4ee5\u63a8\u65b7\u51fa\u6587\u7ae0\u7684\u6574\u9ad4\u7d50\u69cb\u3002\u6b65\u9a5f 1\uff1a\u5c07\u5e38\u898b\u55ae\u5b57\u5217\u70ba\u512a\u5148\u9806\u5e8f\uff0c\u4ee5\u63ed\u793a\u66f4\u591a\u6587\u7ae0\u5167\u5bb9\u3002\u6b65\u9a5f 2\uff1a\u4f7f\u7528\u63ed\u793a\u7684\u55ae\u5b57\u69cb\u601d\u95dc\u65bc\u4e3b\u984c\u7684\u5047\u8a2d\u3002\u6b65\u9a5f 3\uff1a\u907f\u514d\u96a8\u6a5f\u731c\u6e2c\uff0c\u5c08\u6ce8\u65bc\u6700\u53ef\u80fd\u7684\u8a5e\u5f59\u3002\u9019\u7a2e\u6709\u7d50\u69cb\u7684\u65b9\u6cd5\u53ef\u4ee5\u5e6b\u52a9\u521d\u5b78\u8005\u63d0\u5347\u4ed6\u5011\u7684\u904a\u6232\u8868\u73fe\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5229\u7528 Redactle \u5728\u4eab\u53d7\u6a02\u8da3\u7684\u540c\u6642\u589e\u9032\u4e0d\u540c\u4e3b\u984c\u7684\u77e5\u8b58\uff1f", "answer": "Redactle \u63d0\u4f9b\u4e86\u4e00\u7a2e\u7368\u7279\u7684\u65b9\u5f0f\uff0c\u8b93\u73a9\u5bb6\u5728\u53c3\u8207\u6709\u8da3\u4e14\u5177\u6709\u6311\u6230\u6027\u7684\u904a\u6232\u7684\u540c\u6642\uff0c\u5b78\u7fd2\u5404\u7a2e\u4e3b\u984c\u7684\u77e5\u8b58\u3002\u900f\u904e\u731c\u6e2c\u55ae\u5b57\u4e26\u63ed\u66c9\u7dad\u57fa\u767e\u79d1\u6587\u7ae0\uff0c\u73a9\u5bb6\u53ef\u4ee5\u767c\u73fe\u4ed6\u5011\u53ef\u80fd\u5426\u5247\u4e0d\u6703\u63a2\u7d22\u7684\u4e3b\u984c\u7684\u65b0\u8cc7\u8a0a\u3002\u4f8b\u5982\uff0c\u5728\u7269\u7406\u5b78\u6587\u7ae0\u4e2d\u731c\u6e2c\u300e\u91cf\u5b50\u300f\uff0c\u53ef\u4ee5\u5f15\u5c0e\u4ed6\u5011\u5b78\u7fd2\u91cf\u5b50\u529b\u5b78\u3002\u6b65\u9a5f 1\uff1a\u9078\u64c7\u95dc\u65bc\u4e0d\u719f\u6089\u4e3b\u984c\u7684\u6587\u7ae0\uff0c\u4ee5\u64f4\u5c55\u60a8\u7684\u77e5\u8b58\u3002\u6b65\u9a5f 2\uff1a\u4f7f\u7528\u904a\u6232\u6a5f\u5236\u63ed\u793a\u95dc\u9375\u8a5e\u5f59\u548c\u6982\u5ff5\u3002\u6b65\u9a5f 3\uff1a\u7814\u7a76\u63ed\u793a\u7684\u8cc7\u8a0a\uff0c\u4ee5\u52a0\u6df1\u60a8\u7684\u4e86\u89e3\u3002\u9019\u7a2e\u6559\u80b2\u5c64\u9762\u8b93 Redactle \u4e0d\u50c5\u50c5\u662f\u904a\u6232\uff0c\u66f4\u662f\u4e00\u500b\u5bf6\u8cb4\u7684\u5b78\u7fd2\u5de5\u5177\u3002"}]
[{"question": "\u5982\u4f55\u4f5c\u4e3a\u5b8c\u5168\u7684\u65b0\u624b\u5f00\u59cb\u73a9\u300e\u731c\u6d4b\u4ed6\u4eec\u7684\u7b54\u6848\u300f\u6e38\u620f\uff1f", "answer": "\u8981\u5f00\u59cb\u73a9\u300e\u731c\u6d4b\u4ed6\u4eec\u7684\u7b54\u6848\u300f\u6e38\u620f\uff0c\u9996\u5148\u9700\u8981\u4ece\u4f60\u559c\u6b22\u7684\u5e94\u7528\u5546\u5e97\u4e0b\u8f7d\u6e38\u620f\u3002\u542f\u52a8\u6e38\u620f\u540e\uff0c\u4f60\u5c06\u4f1a\u88ab\u5f15\u5bfc\u5b8c\u6210\u4e00\u4e2a\u6559\u7a0b\uff0c\u8fd9\u4e2a\u6559\u7a0b\u4f1a\u89e3\u91ca\u6e38\u620f\u7684\u57fa\u672c\u673a\u5236\u3002\u4f8b\u5982\uff0c\u4f60\u5c06\u5b66\u4e60\u5982\u4f55\u731c\u6d4b\u8bf8\u5982\u201c\u6cd5\u56fd\u7684\u9996\u90fd\u662f\u4ec0\u4e48\uff1f\u201d\u4e4b\u7c7b\u7684\u95ee\u9898\u7684\u6700\u5e38\u89c1\u7b54\u6848\uff0c\u901a\u8fc7\u9009\u62e9\u201c\u5df4\u9ece\u201d\u3002\u8fd9\u4e2a\u521d\u59cb\u9636\u6bb5\u5bf9\u4e8e\u7406\u89e3\u6e38\u620f\u6838\u5fc3\u6982\u5ff5\u81f3\u5173\u91cd\u8981\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u6559\u7a0b\u60f3\u8c61\u6210\u4e00\u5f20\u5730\u56fe\uff0c\u6307\u5f15\u4f60\u7a7f\u8fc7\u6e38\u620f\u7684\u573a\u666f\u3002]"}, {"question": "\u5728\u73a9\u300e\u731c\u6d4b\u4ed6\u4eec\u7684\u7b54\u6848\u300f\u6e38\u620f100\u5c0f\u65f6\u540e\uff0c\u54ea\u4e9b\u7b56\u7565\u6700\u6709\u5229\u4e8e\u83b7\u5f97\u9ad8\u5206\uff1f", "answer": "\u5728\u73a9\u4e86100\u5c0f\u65f6\u540e\uff0c\u638c\u63e1\u9884\u6d4b\u5e38\u89c1\u7b54\u6848\u7684\u6280\u5de7\u662f\u5173\u952e\u3002\u4ee5\u4e0b\u662f\u5206\u6b65\u7b56\u7565\uff1a\u6b65\u9aa41\uff1a\u5206\u6790\u95ee\u9898\u7c7b\u522b\uff08\u4f8b\u5982\uff0c\u5730\u7406\u3001\u6d41\u884c\u6587\u5316\uff09\u3002\u6b65\u9aa42\uff1a\u56de\u5fc6\u4f60\u5728\u4e4b\u524d\u6e38\u620f\u4e2d\u6700\u5e38\u7ed9\u51fa\u7684\u7b54\u6848\u3002\u6b65\u9aa43\uff1a\u8fd0\u7528\u903b\u8f91\u63a8\u7406\u6765\u7f29\u5c0f\u9009\u9879\u8303\u56f4\u3002\u4f8b\u5982\uff0c\u5982\u679c\u95ee\u9898\u662f\u201c\u4e00\u79cd\u7ea2\u8272\u7684\u6c34\u679c\u540d\u79f0\u201d\uff0c\u800c\u4f60\u8bb0\u5f97\u201c\u82f9\u679c\u201d\u662f\u7ecf\u5e38\u88ab\u7ed9\u51fa\u7684\u7b54\u6848\uff0c\u90a3\u5c31\u9009\u62e9\u5b83\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u867d\u7136\u201c\u8349\u8393\u201d\u4e5f\u662f\u7ea2\u8272\u7684\uff0c\u4f46\u201c\u82f9\u679c\u201d\u51fa\u73b0\u7684\u9891\u7387\u66f4\u9ad8\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u300e\u731c\u6d4b\u4ed6\u4eec\u7684\u7b54\u6848\u300f\u6e38\u620f\u4f7f\u7528\u57fa\u4e8e\u79ef\u5206\u7684\u8bc4\u5206\u7cfb\u7edf\uff0c\u4ee5\u53ca\u5b83\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u300e\u731c\u6d4b\u4ed6\u4eec\u7684\u7b54\u6848\u300f\u6e38\u620f\u91c7\u7528\u57fa\u4e8e\u79ef\u5206\u7684\u8bc4\u5206\u7cfb\u7edf\uff0c\u662f\u4e3a\u4e86\u589e\u52a0\u7ade\u4e89\u6027\uff0c\u5e76\u8861\u91cf\u73a9\u5bb6\u7684\u6280\u80fd\u3002\u79ef\u5206\u6839\u636e\u4f60\u7684\u731c\u6d4b\u51c6\u786e\u6027\u548c\u901f\u5ea6\u6765\u9881\u53d1\u3002\u4f8b\u5982\uff0c\u5728\u201c\u7f8e\u56fd\u7684\u4e00\u4e2a\u57ce\u5e02\u540d\u79f0\u201d\u7684\u95ee\u9898\u4e2d\u731c\u5230\u201c\u7ebd\u7ea6\u201d\uff0c\u5982\u679c\u5b83\u5728\u6700\u4f73\u7b54\u6848\u4e4b\u5217\uff0c\u4f60\u5c06\u83b7\u5f97\u79ef\u5206\u3002\u8be5\u7cfb\u7edf\u9f13\u52b1\u73a9\u5bb6\u5feb\u901f\u51c6\u786e\u5730\u601d\u8003\uff0c\u4ece\u800c\u63d0\u5347\u6574\u4f53\u6e38\u620f\u4f53\u9a8c\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u5bf9\u4e8e\u4e0d\u90a3\u4e48\u5e38\u89c1\u4f46\u4ecd\u7136\u6b63\u786e\u7684\u7b54\u6848\uff0c\u79ef\u5206\u4f1a\u66f4\u9ad8\uff0c\u5e73\u8861\u98ce\u9669\u548c\u56de\u62a5\u3002]"}, {"question": "\u300e\u731c\u6d4b\u4ed6\u4eec\u7684\u7b54\u6848\u300f\u6e38\u620f\u54ea\u4e9b\u6e38\u620f\u673a\u5236\u6700\u6709\u5229\u4e8e\u957f\u671f\u53c2\u4e0e\uff1f", "answer": "\u5728\u300e\u731c\u6d4b\u4ed6\u4eec\u7684\u7b54\u6848\u300f\u6e38\u620f\u4e2d\uff0c\u57f9\u517b\u957f\u671f\u53c2\u4e0e\u5ea6\u7684\u673a\u5236\u5305\u62ec\u6bcf\u65e5\u6311\u6218\u548c\u6392\u884c\u699c\u7cfb\u7edf\u3002\u6bcf\u65e5\u6311\u6218\u6bcf\u5929\u63d0\u4f9b\u65b0\u7684\u95ee\u9898\uff0c\u4fdd\u6301\u5185\u5bb9\u65b0\u9c9c\u3002\u6392\u884c\u699c\u7cfb\u7edf\u8ba9\u73a9\u5bb6\u4e0e\u670b\u53cb\u548c\u5168\u7403\u793e\u533a\u7ade\u4e89\uff0c\u57f9\u517b\u6210\u5c31\u611f\u3002\u4f8b\u5982\uff0c\u5b8c\u6210\u6bcf\u65e5\u6311\u6218\u53ef\u80fd\u9700\u8981\u731c\u6d4b\u201c\u5496\u5561\u201d\u662f\u201c\u4eba\u4eec\u65e9\u4e0a\u559d\u4ec0\u4e48\uff1f\u201d\u6700\u5e38\u89c1\u7684\u7b54\u6848\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u6bcf\u65e5\u6311\u6218\u2192\u65b0\u9c9c\u5185\u5bb9\u2192\u53c2\u4e0e\u5ea6\u589e\u52a0\u2192\u6392\u884c\u699c\u7ade\u4e89\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u8fc1\u79fb\u300e\u731c\u6d4b\u4ed6\u4eec\u7684\u7b54\u6848\u300f\u6570\u636e\uff1f", "answer": "\u5982\u679c\u5728\u4e0d\u540c\u5e73\u53f0\u4f7f\u7528\u540c\u4e00\u4e2a\u8d26\u6237\uff0c\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u8fc1\u79fb\u300e\u731c\u6d4b\u4ed6\u4eec\u7684\u7b54\u6848\u300f\u6570\u636e\u975e\u5e38\u7b80\u5355\u3002\u53ea\u9700\u5728\u65b0\u8bbe\u5907\u4e0a\u4f7f\u7528\u4f60\u7684\u539f\u59cb\u8d26\u6237\u51ed\u8bc1\u767b\u5f55\u5373\u53ef\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4eceiPhone\u5207\u6362\u5230Android\u8bbe\u5907\uff0c\u4f7f\u7528\u4f60\u7684Apple ID\u6216Google\u8d26\u6237\u767b\u5f55\u5c06\u540c\u6b65\u4f60\u7684\u8fdb\u5ea6\uff0c\u5305\u62ec\u4f60\u7684\u5206\u6570\u548c\u5df2\u89e3\u9501\u7684\u5185\u5bb9\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u4f60\u7684\u6e38\u620f\u6570\u636e\u60f3\u8c61\u6210\u4e00\u4e2a\u4e91\u7aef\uff0c\u8ddf\u968f\u4f60\u5728\u4efb\u4f55\u767b\u5f55\u7684\u5730\u65b9\u3002]"}, {"question": "\u300e\u731c\u6d4b\u4ed6\u4eec\u7684\u7b54\u6848\u300f\u6e38\u620f\u6709\u54ea\u4e9b\u9690\u85cf\u5185\u5bb9\uff0c\u4ee5\u53ca\u5982\u4f55\u53d1\u73b0\u5b83\u4eec\uff1f", "answer": "\u300e\u731c\u6d4b\u4ed6\u4eec\u7684\u7b54\u6848\u300f\u6e38\u620f\u5305\u542b\u9690\u85cf\u5185\u5bb9\uff0c\u4f8b\u5982\u7a00\u6709\u95ee\u9898\u548c\u7279\u6b8a\u5956\u52b1\uff0c\u53ef\u4ee5\u901a\u8fc7\u8fbe\u5230\u7279\u5b9a\u91cc\u7a0b\u7891\u6765\u89e3\u9501\u3002\u4f8b\u5982\uff0c\u6b63\u786e\u56de\u7b54100\u4e2a\u95ee\u9898\u53ef\u80fd\u4f1a\u89e3\u9501\u4e00\u4e2a\u7279\u6b8a\u7c7b\u522b\uff0c\u4f8b\u5982\u201c\u5386\u53f2\u4e8b\u4ef6\u201d\u3002\u53d1\u73b0\u8fd9\u4e9b\u9690\u85cf\u5185\u5bb9\u9700\u8981\u6301\u7eed\u6e38\u620f\uff0c\u5e76\u5173\u6ce8\u6e38\u620f\u7684\u8fdb\u5ea6\u7cfb\u7edf\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u867d\u7136\u6709\u4e9b\u9690\u85cf\u5185\u5bb9\u53ea\u662f\u7eaf\u7cb9\u7684\u88c5\u9970\uff0c\u4f46\u53e6\u4e00\u4e9b\u5219\u63d0\u4f9b\u4e86\u65b0\u7684\u6e38\u620f\u6311\u6218\u3002]"}, {"question": "\u300e\u731c\u6d4b\u4ed6\u4eec\u7684\u7b54\u6848\u300f\u6e38\u620f\u4e2d\u95ee\u9898\u7684\u96be\u5ea6\u662f\u5982\u4f55\u968f\u7740\u73a9\u5bb6\u8fdb\u5ea6\u7684\u63d0\u5347\u800c\u53d8\u5316\u7684\uff1f", "answer": "\u300e\u731c\u6d4b\u4ed6\u4eec\u7684\u7b54\u6848\u300f\u6e38\u620f\u4e2d\u95ee\u9898\u7684\u96be\u5ea6\u6839\u636e\u4f60\u7684\u8868\u73b0\u548c\u4f60\u7684\u64c5\u957f\u7c7b\u522b\u800c\u8c03\u6574\u3002\u968f\u7740\u4f60\u7684\u8fdb\u6b65\uff0c\u6e38\u620f\u5c06\u5f15\u5165\u66f4\u590d\u6742\u7684\u95ee\u9898\u548c\u4e0d\u592a\u5e38\u89c1\u7684\u7b54\u6848\u3002\u4f8b\u5982\uff0c\u5728\u638c\u63e1\u4e86\u57fa\u7840\u5730\u7406\u95ee\u9898\u540e\uff0c\u4f60\u53ef\u80fd\u4f1a\u9047\u5230\u4e00\u4e9b\u66f4\u96be\u4ee5\u6349\u6478\u7684\u95ee\u9898\uff0c\u4f8b\u5982\u201c\u4e0d\u4e39\u7684\u4e00\u4e2a\u57ce\u5e02\u540d\u79f0\u201d\u3002\u8fd9\u79cd\u8c03\u6574\u786e\u4fdd\u6e38\u620f\u4fdd\u6301\u6311\u6218\u6027\u548c\u5438\u5f15\u529b\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6e38\u620f\u65e9\u671f\u7684\u95ee\u9898\u8303\u56f4\u66f4\u5e7f\uff0c\u800c\u540e\u671f\u7684\u95ee\u9898\u5219\u9700\u8981\u66f4\u4e13\u4e1a\u7684\u77e5\u8bc6\u3002]"}, {"question": "\u5728\u300e\u731c\u6d4b\u4ed6\u4eec\u7684\u7b54\u6848\u300f\u6e38\u620f\u4e2d\uff0c\u63d0\u9ad8\u53cd\u5e94\u65f6\u95f4\u7684\u6709\u6548\u65b9\u6cd5\u6709\u54ea\u4e9b\uff1f", "answer": "\u63d0\u9ad8\u300e\u731c\u6d4b\u4ed6\u4eec\u7684\u7b54\u6848\u300f\u6e38\u620f\u7684\u53cd\u5e94\u65f6\u95f4\u9700\u8981\u7ec3\u4e60\u548c\u719f\u6089\u5e38\u89c1\u7b54\u6848\u3002\u4ee5\u4e0b\u662f\u5206\u6b65\u65b9\u6cd5\uff1a\u6b65\u9aa41\uff1a\u5b9a\u671f\u6e38\u620f\u4ee5\u5efa\u7acb\u808c\u8089\u8bb0\u5fc6\u3002\u6b65\u9aa42\uff1a\u5173\u6ce8\u5e38\u89c1\u95ee\u9898\u7c7b\u522b\uff0c\u4ee5\u4fbf\u5feb\u901f\u9884\u6d4b\u7b54\u6848\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u6e38\u620f\u7684\u7ec3\u4e60\u6a21\u5f0f\u6a21\u62df\u5b9e\u65f6\u731c\u6d4b\uff0c\u65e0\u9700\u60e9\u7f5a\u3002\u4f8b\u5982\uff0c\u7ec3\u4e60\u8bf8\u5982\u201c\u540d\u79f0\u989c\u8272\u201d\u7684\u95ee\u9898\u53ef\u4ee5\u5e2e\u52a9\u4f60\u5feb\u901f\u56de\u5fc6\u201c\u84dd\u8272\u201d\u6216\u201c\u7ea2\u8272\u201d\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u4f60\u7684\u5927\u8111\u60f3\u8c61\u6210\u4e00\u4e2a\u968f\u7740\u91cd\u590d\u800c\u53d8\u5f97\u66f4\u5feb\u7684\u53cd\u5c04\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u300e\u731c\u6d4b\u4ed6\u4eec\u7684\u7b54\u6848\u300f\u6e38\u620f\u4e2d\u7684\u67d0\u4e9b\u7c7b\u522b\u6bd4\u5176\u4ed6\u7c7b\u522b\u66f4\u5177\u6311\u6218\u6027\uff1f", "answer": "\u300e\u731c\u6d4b\u4ed6\u4eec\u7684\u7b54\u6848\u300f\u6e38\u620f\u4e2d\u7684\u67d0\u4e9b\u7c7b\u522b\u66f4\u5177\u6311\u6218\u6027\uff0c\u8fd9\u662f\u56e0\u4e3a\u53ef\u80fd\u7b54\u6848\u7684\u591a\u6837\u6027\u548c\u5177\u4f53\u6027\u3002\u4f8b\u5982\uff0c\u201c\u79d1\u5b66\u201d\u95ee\u9898\u53ef\u80fd\u9700\u8981\u6bd4\u201c\u6d41\u884c\u6587\u5316\u201d\u95ee\u9898\u66f4\u4e13\u4e1a\u7684\u77e5\u8bc6\u3002\u8fd9\u79cd\u591a\u6837\u6027\u786e\u4fdd\u4e86\u4e0d\u540c\u4e13\u957f\u7684\u73a9\u5bb6\u90fd\u80fd\u627e\u5230\u8ba9\u4eba\u6295\u5165\u4e14\u5e73\u8861\u7684\u6e38\u620f\u4f53\u9a8c\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u867d\u7136\u201c\u6d41\u884c\u6587\u5316\u201d\u95ee\u9898\u6709\u66f4\u591a\u53ef\u9884\u6d4b\u7684\u7b54\u6848\uff0c\u201c\u79d1\u5b66\u201d\u95ee\u9898\u53ef\u80fd\u66f4\u62bd\u8c61\u4e14\u591a\u6837\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u4f18\u5316\u8bbe\u5907\u8bbe\u7f6e\u4ee5\u83b7\u5f97\u6700\u4f73\u7684\u300e\u731c\u6d4b\u4ed6\u4eec\u7684\u7b54\u6848\u300f\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u4f18\u5316\u8bbe\u5907\u8bbe\u7f6e\u4ee5\u83b7\u5f97\u6700\u4f73\u7684\u300e\u731c\u6d4b\u4ed6\u4eec\u7684\u7b54\u6848\u300f\u6e38\u620f\u4f53\u9a8c\uff0c\u9700\u8981\u786e\u4fdd\u6d41\u7545\u7684\u6027\u80fd\u548c\u5c3d\u91cf\u51cf\u5c11\u5e72\u6270\u3002\u5177\u4f53\u65b9\u6cd5\u5982\u4e0b\uff1a\u6b65\u9aa41\uff1a\u66f4\u65b0\u8bbe\u5907\u7684\u64cd\u4f5c\u7cfb\u7edf\u548c\u6e38\u620f\u5230\u6700\u65b0\u7248\u672c\u3002\u6b65\u9aa42\uff1a\u5173\u95ed\u540e\u53f0\u5e94\u7528\u4ee5\u91ca\u653e\u5185\u5b58\u3002\u6b65\u9aa43\uff1a\u8c03\u6574\u5c4f\u5e55\u4eae\u5ea6\u548c\u58f0\u97f3\u8bbe\u7f6e\uff0c\u4ee5\u83b7\u5f97\u8212\u9002\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u4f8b\u5982\uff0c\u5728\u957f\u65f6\u95f4\u6e38\u620f\u65f6\u964d\u4f4e\u5c4f\u5e55\u4eae\u5ea6\u53ef\u4ee5\u5e2e\u52a9\u4f60\u9884\u9632\u773c\u775b\u75b2\u52b3\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u4f60\u7684\u8bbe\u5907\u60f3\u8c61\u6210\u4e00\u53f0\u7ecf\u8fc7\u7cbe\u7ec6\u8c03\u6574\u7684\u4e50\u5668\uff0c\u9700\u8981\u5b9a\u671f\u7ef4\u62a4\u624d\u80fd\u8fbe\u5230\u6700\u4f73\u6027\u80fd\u3002]"}]
[{"question": "\u5168\u304f\u306e\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001\u30af\u30a4\u30ba\u300eGuess Their Answer\u300f\u3092\u59cb\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u300eGuess Their Answer\u300f\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u307e\u305a\u304a\u597d\u307f\u306e\u30a2\u30d7\u30ea\u30b9\u30c8\u30a2\u304b\u3089\u30b2\u30fc\u30e0\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u8d77\u52d5\u3059\u308b\u3068\u3001\u57fa\u672c\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u8aac\u660e\u3059\u308b\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30d5\u30e9\u30f3\u30b9\u306e\u9996\u90fd\u306f\u4f55\u3067\u3059\u304b\uff1f\u300f\u306e\u3088\u3046\u306a\u8cea\u554f\u306b\u5bfe\u3059\u308b\u6700\u3082\u4e00\u822c\u7684\u306a\u7b54\u3048\u3067\u3042\u308b\u300e\u30d1\u30ea\u300f\u3092\u9078\u629e\u3059\u308b\u3053\u3068\u3067\u3001\u4e00\u822c\u7684\u306a\u7b54\u3048\u3092\u63a8\u6e2c\u3059\u308b\u65b9\u6cd5\u3092\u5b66\u3073\u307e\u3059\u3002\u3053\u306e\u521d\u671f\u6bb5\u968e\u306f\u3001\u30b2\u30fc\u30e0\u306e\u57fa\u672c\u6982\u5ff5\u3092\u7406\u89e3\u3059\u308b\u4e0a\u3067\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002[\u4f8b\u3048\u306b\u3088\u308b\u8aac\u660e: \u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u306f\u3001\u30b2\u30fc\u30e0\u306e\u4e16\u754c\u3092\u6848\u5185\u3059\u308b\u5730\u56f3\u3060\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u306e\u300eGuess Their Answer\u300f\u3067\u9ad8\u5f97\u70b9\u3092\u53d6\u308b\u305f\u3081\u306e\u6700\u5584\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u4e00\u822c\u7684\u306a\u56de\u7b54\u3092\u4e88\u6e2c\u3059\u308b\u6280\u8853\u3092\u7fd2\u5f97\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002\u4ee5\u4e0b\u306f\u6bb5\u968e\u7684\u306a\u6226\u7565\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71: \u8cea\u554f\u306e\u30ab\u30c6\u30b4\u30ea\uff08\u4f8b\uff1a\u5730\u7406\u3001\u30dd\u30c3\u30d7\u30ab\u30eb\u30c1\u30e3\u30fc\uff09\u3092\u5206\u6790\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72: \u4ee5\u524d\u306b\u30d7\u30ec\u30a4\u3057\u305f\u30b2\u30fc\u30e0\u3067\u6700\u3082\u983b\u7e41\u306b\u4e0e\u3048\u3089\u308c\u305f\u7b54\u3048\u3092\u601d\u3044\u51fa\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73: \u8ad6\u7406\u7684\u306a\u63a8\u8ad6\u3092\u4f7f\u7528\u3057\u3066\u9078\u629e\u80a2\u3092\u7d5e\u308a\u8fbc\u307f\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u8d64\u3044\u679c\u7269\u540d\u300d\u3068\u3044\u3046\u8cea\u554f\u3067\u3001\u300c\u30ea\u30f3\u30b4\u300d\u304c\u983b\u7e41\u306a\u7b54\u3048\u3068\u3057\u3066\u8a18\u61b6\u3055\u308c\u3066\u3044\u308b\u5834\u5408\u3001\u305d\u308c\u3092\u9078\u629e\u3057\u307e\u3057\u3087\u3046\u3002[\u8907\u6570\u306e\u9078\u629e\u80a2\u306e\u6bd4\u8f03: \u300c\u30a4\u30c1\u30b4\u300d\u3082\u8d64\u3044\u3067\u3059\u304c\u3001\u300c\u30ea\u30f3\u30b4\u300d\u306e\u65b9\u304c\u3088\u308a\u4e00\u822c\u7684\u306b\u63a8\u6e2c\u3055\u308c\u3066\u3044\u307e\u3059\u3002]"}, {"question": "\u300eGuess Their Answer\u300f\u306f\u306a\u305c\u30dd\u30a4\u30f3\u30c8\u30d9\u30fc\u30b9\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u3092\u4f7f\u7528\u3057\u3066\u304a\u308a\u3001\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u300eGuess Their Answer\u300f\u306f\u3001\u7af6\u4e89\u5fc3\u3092\u9ad8\u3081\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b9\u30ad\u30eb\u3092\u6e2c\u5b9a\u3059\u308b\u305f\u3081\u306b\u30dd\u30a4\u30f3\u30c8\u30d9\u30fc\u30b9\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u3092\u63a1\u7528\u3057\u3066\u3044\u307e\u3059\u3002\u30dd\u30a4\u30f3\u30c8\u306f\u3001\u63a8\u6e2c\u306e\u6b63\u78ba\u3055\u3001\u53ca\u3073\u901f\u3055\u306b\u3088\u3063\u3066\u4e0e\u3048\u3089\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30a2\u30e1\u30ea\u30ab\u5408\u8846\u56fd\u306e\u90fd\u5e02\u540d\u306b\u95a2\u3059\u308b\u8cea\u554f\u3067\u300e\u30cb\u30e5\u30fc\u30e8\u30fc\u30af\u300f\u3068\u63a8\u6e2c\u3057\u3001\u305d\u308c\u304c\u30c8\u30c3\u30d7\u56de\u7b54\u306e\u4e00\u3064\u3067\u3042\u308c\u3070\u3001\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u8fc5\u901f\u304b\u3064\u6b63\u78ba\u306a\u601d\u8003\u3092\u5968\u52b1\u3057\u3001\u5168\u4f53\u7684\u306a\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u9ad8\u3081\u307e\u3059\u3002[\u8a2d\u5b9a\u6bd4\u8f03\u8868: \u305d\u308c\u307b\u3069\u4e00\u822c\u7684\u3067\u306a\u3044\u3082\u306e\u306e\u3001\u4f9d\u7136\u3068\u3057\u3066\u6b63\u89e3\u306e\u56de\u7b54\u306b\u5bfe\u3057\u3066\u306f\u3001\u30ea\u30b9\u30af\u3068\u30ea\u30bf\u30fc\u30f3\u306e\u30d0\u30e9\u30f3\u30b9\u304c\u53d6\u308c\u305f\u9ad8\u3044\u30dd\u30a4\u30f3\u30c8\u304c\u4e0e\u3048\u3089\u308c\u307e\u3059\u3002]"}, {"question": "\u300eGuess Their Answer\u300f\u306e\u3069\u306e\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u304c\u9577\u671f\u7684\u306a\u30a8\u30f3\u30b2\u30fc\u30b8\u30e1\u30f3\u30c8\u306b\u6700\u3082\u6709\u76ca\u3067\u3059\u304b\uff1f", "answer": "\u300eGuess Their Answer\u300f\u306b\u304a\u3044\u3066\u9577\u671f\u7684\u306a\u30a8\u30f3\u30b2\u30fc\u30b8\u30e1\u30f3\u30c8\u3092\u4fc3\u9032\u3059\u308b\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u306f\u3001\u65e5\u3005\u306e\u8ab2\u984c\u3068\u30ea\u30fc\u30c0\u30fc\u30dc\u30fc\u30c9\u30b7\u30b9\u30c6\u30e0\u304c\u3042\u308a\u307e\u3059\u3002\u65e5\u3005\u306e\u8ab2\u984c\u306f\u3001\u6bce\u65e5\u65b0\u3057\u3044\u8cea\u554f\u3092\u63d0\u4f9b\u3057\u3001\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u65b0\u9bae\u306b\u4fdd\u3061\u307e\u3059\u3002\u30ea\u30fc\u30c0\u30fc\u30dc\u30fc\u30c9\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u53cb\u4eba\u3084\u30b0\u30ed\u30fc\u30d0\u30eb\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u3068\u7af6\u3044\u5408\u3046\u3053\u3068\u3092\u53ef\u80fd\u306b\u3057\u3001\u9054\u6210\u611f\u3092\u9ad8\u3081\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u65e5\u3005\u306e\u8ab2\u984c\u3092\u5b8c\u4e86\u3059\u308b\u305f\u3081\u306b\u306f\u3001\u300c\u671d\u4f55\u3067\u3059\u304b\uff1f\u300d\u3068\u3044\u3046\u8cea\u554f\u3067\u6700\u3082\u4e00\u822c\u7684\u306a\u7b54\u3048\u3067\u3042\u308b\u300c\u30b3\u30fc\u30d2\u30fc\u300d\u3092\u63a8\u6e2c\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8: \u65e5\u3005\u306e\u8ab2\u984c\u2192\u65b0\u9bae\u306a\u30b3\u30f3\u30c6\u30f3\u30c4\u2192\u30a8\u30f3\u30b2\u30fc\u30b8\u30e1\u30f3\u30c8\u5411\u4e0a\u2192\u30ea\u30fc\u30c0\u30fc\u30dc\u30fc\u30c9\u306e\u7af6\u4e89\u3002]"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u3069\u306e\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u300eGuess Their Answer\u300f\u306e\u30c7\u30fc\u30bf\u3092\u79fb\u884c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u5168\u4f53\u3067\u4f7f\u7528\u3057\u3066\u3044\u308b\u5834\u5408\u3001\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u300eGuess Their Answer\u300f\u30c7\u30fc\u30bf\u3092\u79fb\u884c\u3059\u308b\u3053\u3068\u306f\u7c21\u5358\u3067\u3059\u3002\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u5143\u306e\u30a2\u30ab\u30a6\u30f3\u30c8\u8cc7\u683c\u60c5\u5831\u3092\u4f7f\u7528\u3057\u3066\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3060\u3051\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001iPhone\u304b\u3089Android\u30c7\u30d0\u30a4\u30b9\u306b\u5207\u308a\u66ff\u3048\u308b\u5834\u5408\u3001Apple ID\u307e\u305f\u306fGoogle\u30a2\u30ab\u30a6\u30f3\u30c8\u3067\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3068\u3001\u30b9\u30b3\u30a2\u3084\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u542b\u3080\u9032\u6357\u72b6\u6cc1\u304c\u540c\u671f\u3055\u308c\u307e\u3059\u3002[\u4f8b\u3048\u306b\u3088\u308b\u8aac\u660e: \u30b2\u30fc\u30e0\u30c7\u30fc\u30bf\u306f\u3001\u3042\u306a\u305f\u304c\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u5834\u6240\u3092\u305f\u3069\u308b\u30af\u30e9\u30a6\u30c9\u3060\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u300eGuess Their Answer\u300f\u3067\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u306f\u4f55\u3067\u3059\u304b\uff1f\u307e\u305f\u3001\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u767a\u898b\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u300eGuess Their Answer\u300f\u306b\u306f\u3001\u7279\u5b9a\u306e\u76ee\u6a19\u3092\u9054\u6210\u3059\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u308b\u3001\u73cd\u3057\u3044\u554f\u984c\u3084\u7279\u5225\u306a\u5831\u916c\u306a\u3069\u306e\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001100\u554f\u6b63\u89e3\u3059\u308b\u3068\u3001\u300c\u6b74\u53f2\u7684\u51fa\u6765\u4e8b\u300d\u306e\u3088\u3046\u306a\u7279\u5225\u306a\u30ab\u30c6\u30b4\u30ea\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u3053\u308c\u3089\u306e\u767a\u898b\u306b\u306f\u3001\u7d99\u7d9a\u7684\u306a\u30d7\u30ec\u30a4\u3068\u30b2\u30fc\u30e0\u306e\u9032\u884c\u30b7\u30b9\u30c6\u30e0\u3078\u306e\u6ce8\u610f\u304c\u5fc5\u8981\u3067\u3059\u3002[\u8907\u6570\u306e\u9078\u629e\u80a2\u306e\u6bd4\u8f03: \u4e00\u90e8\u306e\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u306f\u7d14\u7c8b\u306b\u88c5\u98fe\u7684\u306a\u3082\u306e\u3067\u3059\u304c\u3001\u4ed6\u306e\u3082\u306e\u306b\u306f\u65b0\u3057\u3044\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u8ab2\u984c\u304c\u63d0\u4f9b\u3055\u308c\u307e\u3059\u3002]"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u9032\u6357\u72b6\u6cc1\u3068\u5171\u306b\u3001\u300eGuess Their Answer\u300f\u306e\u8cea\u554f\u306e\u96e3\u6613\u5ea6\u306f\u3069\u306e\u3088\u3046\u306b\u5909\u5316\u3057\u307e\u3059\u304b\uff1f", "answer": "\u300eGuess Their Answer\u300f\u306e\u8cea\u554f\u306e\u96e3\u6613\u5ea6\u306f\u304a\u5ba2\u69d8\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3068\u5f97\u610f\u306a\u30ab\u30c6\u30b4\u30ea\u306b\u57fa\u3065\u3044\u3066\u5909\u5316\u3057\u307e\u3059\u3002\u9032\u6b69\u3059\u308b\u306b\u3064\u308c\u3066\u3001\u30b2\u30fc\u30e0\u306f\u3088\u308a\u8907\u96d1\u306a\u8cea\u554f\u3068\u3001\u3088\u308a\u73cd\u3057\u3044\u7b54\u3048\u3092\u5c0e\u5165\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u57fa\u672c\u7684\u306a\u5730\u7406\u306e\u8cea\u554f\u3092\u30de\u30b9\u30bf\u30fc\u3057\u305f\u5f8c\u3001\u300c\u30d6\u30fc\u30bf\u30f3\u306e\u90fd\u5e02\u540d\u300d\u306e\u3088\u3046\u306a\u3001\u3088\u308a\u73cd\u3057\u3044\u8cea\u554f\u306b\u906d\u9047\u3059\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u3053\u306e\u30b9\u30b1\u30fc\u30ea\u30f3\u30b0\u306b\u3088\u308a\u3001\u30b2\u30fc\u30e0\u306f\u5e38\u306b\u6311\u6226\u7684\u3067\u697d\u3057\u3044\u72b6\u614b\u3092\u7dad\u6301\u3057\u307e\u3059\u3002[\u8a2d\u5b9a\u6bd4\u8f03\u8868: \u521d\u671f\u30b2\u30fc\u30e0\u306e\u8cea\u554f\u306f\u5e83\u7bc4\u56f2\u3067\u3059\u304c\u3001\u5f8c\u671f\u306e\u8cea\u554f\u306f\u3088\u308a\u5c02\u9580\u7684\u306a\u77e5\u8b58\u3092\u5fc5\u8981\u3068\u3057\u307e\u3059\u3002]"}, {"question": "\u300eGuess Their Answer\u300f\u3067\u53cd\u5fdc\u6642\u9593\u3092\u5411\u4e0a\u3055\u305b\u308b\u6700\u3082\u52b9\u679c\u7684\u306a\u65b9\u6cd5\u306f\uff1f", "answer": "\u300eGuess Their Answer\u300f\u3067\u53cd\u5fdc\u6642\u9593\u3092\u5411\u4e0a\u3055\u305b\u308b\u306b\u306f\u3001\u7df4\u7fd2\u3068\u4e00\u822c\u7684\u306a\u56de\u7b54\u3078\u306e\u7cbe\u901a\u304c\u5fc5\u8981\u3067\u3059\u3002\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71: \u53cd\u5fa9\u7df4\u7fd2\u3092\u901a\u3057\u3066\u7b4b\u8089\u8a18\u61b6\u3092\u69cb\u7bc9\u3059\u308b\u305f\u3081\u306b\u3001\u5b9a\u671f\u7684\u306b\u30b2\u30fc\u30e0\u3092\u30d7\u30ec\u30a4\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72: \u4e00\u822c\u7684\u306a\u8cea\u554f\u306e\u30ab\u30c6\u30b4\u30ea\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3053\u3068\u3067\u3001\u8fc5\u901f\u306b\u56de\u7b54\u3092\u4e88\u6e2c\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73: \u30da\u30ca\u30eb\u30c6\u30a3\u306a\u3057\u3067\u3001\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u306e\u63a8\u6e2c\u3092\u6a21\u64ec\u3059\u308b\u305f\u3081\u306b\u3001\u30b2\u30fc\u30e0\u306e\u7df4\u7fd2\u30e2\u30fc\u30c9\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u8272\u540d\u300d\u306e\u3088\u3046\u306a\u554f\u984c\u3092\u7df4\u7fd2\u3059\u308b\u3053\u3068\u3067\u3001\u300c\u9752\u300d\u3084\u300c\u8d64\u300d\u3092\u3059\u3070\u3084\u304f\u601d\u3044\u51fa\u3059\u3053\u3068\u304c\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002[\u4f8b\u3048\u306b\u3088\u308b\u8aac\u660e: \u3042\u306a\u305f\u306e\u8133\u3092\u3001\u7e70\u308a\u8fd4\u3059\u3053\u3068\u3067\u901f\u304f\u306a\u308b\u53cd\u5c04\u3060\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u300eGuess Their Answer\u300f\u306e\u7279\u5b9a\u306e\u30ab\u30c6\u30b4\u30ea\u306f\u3001\u4ed6\u306e\u30ab\u30c6\u30b4\u30ea\u3088\u308a\u3082\u96e3\u3057\u3044\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u300eGuess Their Answer\u300f\u306e\u7279\u5b9a\u306e\u30ab\u30c6\u30b4\u30ea\u306f\u3001\u53ef\u80fd\u306a\u7b54\u3048\u306e\u591a\u69d8\u6027\u3068\u7279\u7570\u6027\u306e\u305f\u3081\u306b\u3001\u4ed6\u306e\u30ab\u30c6\u30b4\u30ea\u3088\u308a\u3082\u96e3\u3057\u3044\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u79d1\u5b66\u300d\u306e\u8cea\u554f\u306f\u3001\u300c\u30dd\u30c3\u30d7\u30ab\u30eb\u30c1\u30e3\u30fc\u300d\u306b\u6bd4\u8f03\u3057\u3066\u3088\u308a\u5c02\u9580\u7684\u306a\u77e5\u8b58\u3092\u5fc5\u8981\u3068\u3059\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u3053\u306e\u591a\u69d8\u6027\u306b\u3088\u308a\u3001\u3055\u307e\u3056\u307e\u306a\u5c02\u9580\u77e5\u8b58\u3092\u6301\u3064\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30b2\u30fc\u30e0\u306b\u9b45\u529b\u3068\u30d0\u30e9\u30f3\u30b9\u3092\u898b\u51fa\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u8907\u6570\u306e\u9078\u629e\u80a2\u306e\u6bd4\u8f03: \u300c\u30dd\u30c3\u30d7\u30ab\u30eb\u30c1\u30e3\u30fc\u300d\u306e\u8cea\u554f\u306b\u306f\u3088\u308a\u4e88\u6e2c\u53ef\u80fd\u306a\u7b54\u3048\u304c\u3042\u308b\u4e00\u65b9\u3067\u3001\u300c\u79d1\u5b66\u300d\u306e\u8cea\u554f\u306f\u3088\u308a\u62bd\u8c61\u7684\u3067\u591a\u69d8\u3067\u3042\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002]"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u6700\u9ad8\u306e\u300eGuess Their Answer\u300f\u4f53\u9a13\u3092\u5f97\u308b\u305f\u3081\u306b\u3001\u30c7\u30d0\u30a4\u30b9\u8a2d\u5b9a\u3092\u3069\u306e\u3088\u3046\u306b\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u300eGuess Their Answer\u300f\u306e\u6700\u9ad8\u306e\u4f53\u9a13\u3092\u5f97\u308b\u305f\u3081\u3001\u30c7\u30d0\u30a4\u30b9\u306e\u8a2d\u5b9a\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u30b9\u30e0\u30fc\u30ba\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3068\u6700\u5c0f\u9650\u306e\u90aa\u9b54\u3092\u78ba\u4fdd\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u5177\u4f53\u7684\u306a\u65b9\u6cd5\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71: \u30c7\u30d0\u30a4\u30b9\u306e\u30aa\u30da\u30ec\u30fc\u30c6\u30a3\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u3068\u30b2\u30fc\u30e0\u3092\u6700\u65b0\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u306b\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72: \u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u30a2\u30d7\u30ea\u3092\u9589\u3058\u3001\u30e1\u30e2\u30ea\u3092\u89e3\u653e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73: \u753b\u9762\u660e\u308b\u3055\u3084\u30b5\u30a6\u30f3\u30c9\u8a2d\u5b9a\u3092\u8abf\u6574\u3057\u3001\u5feb\u9069\u306b\u30d7\u30ec\u30a4\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u9577\u6642\u9593\u306e\u30bb\u30c3\u30b7\u30e7\u30f3\u4e2d\u306f\u3001\u753b\u9762\u306e\u660e\u308b\u3055\u3092\u843d\u3068\u3059\u3068\u3001\u76ee\u306e\u75b2\u52b4\u3092\u9632\u3050\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u4f8b\u3048\u306b\u3088\u308b\u8aac\u660e: \u30c7\u30d0\u30a4\u30b9\u306f\u3001\u6700\u9ad8\u306e\u6027\u80fd\u3092\u767a\u63ee\u3059\u308b\u305f\u3081\u306b\u5b9a\u671f\u7684\u306a\u30e1\u30f3\u30c6\u30ca\u30f3\u30b9\u3092\u5fc5\u8981\u3068\u3059\u308b\u3001\u7cbe\u5bc6\u306b\u8abf\u6574\u3055\u308c\u305f\u697d\u5668\u3060\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}]
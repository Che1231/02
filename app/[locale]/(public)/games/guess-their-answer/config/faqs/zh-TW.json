[{"question": "\u5982\u4f55\u958b\u59cb\u73a9\u300e\u731c\u731c\u4ed6\u5011\u7684\u7b54\u6848\u300f\u9019\u500b\u904a\u6232\uff0c\u4f5c\u70ba\u5b8c\u5168\u7684\u521d\u5b78\u8005\uff1f", "answer": "\u8981\u958b\u59cb\u73a9\u300e\u731c\u731c\u4ed6\u5011\u7684\u7b54\u6848\u300f\uff0c\u9996\u5148\u9700\u8981\u5f9e\u60a8\u504f\u597d\u7684\u61c9\u7528\u7a0b\u5f0f\u5546\u5e97\u4e0b\u8f09\u904a\u6232\u3002\u555f\u52d5\u5f8c\uff0c\u60a8\u5c07\u6703\u88ab\u5f15\u5c0e\u5b8c\u6210\u6559\u5b78\u8ab2\u7a0b\uff0c\u5b78\u7fd2\u904a\u6232\u7684\u57fa\u672c\u6a5f\u5236\u3002\u4f8b\u5982\uff0c\u60a8\u5c07\u6703\u5b78\u7fd2\u5982\u4f55\u731c\u6e2c\u50cf\u300e\u6cd5\u570b\u7684\u9996\u90fd\u662f\u4ec0\u9ebc\uff1f\u300f\u9019\u6a23\u7684\u554f\u984c\u4e2d\u6700\u5e38\u898b\u7684\u7b54\u6848\uff0c\u900f\u904e\u9078\u64c7\u300e\u5df4\u9ece\u300f\u3002\u9019\u500b\u521d\u59cb\u968e\u6bb5\u5c0d\u65bc\u7406\u89e3\u904a\u6232\u7684\u6838\u5fc3\u6982\u5ff5\u81f3\u95dc\u91cd\u8981\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u6559\u5b78\u8ab2\u7a0b\u60f3\u6210\u4e00\u5f35\u5730\u5716\uff0c\u5f15\u5c0e\u60a8\u7a7f\u68ad\u5728\u904a\u6232\u7684\u5404\u500b\u9818\u57df\u3002]"}, {"question": "\u5728\u73a9\u300e\u731c\u731c\u4ed6\u5011\u7684\u7b54\u6848\u300f\u8d85\u904e100\u5c0f\u6642\u5f8c\uff0c\u600e\u6a23\u7684\u7b56\u7565\u624d\u80fd\u7372\u5f97\u9ad8\u5206\uff1f", "answer": "\u5728\u73a9\u4e86100\u5c0f\u6642\u5f8c\uff0c\u638c\u63e1\u9810\u6e2c\u5e38\u898b\u7b54\u6848\u7684\u6280\u5de7\u662f\u95dc\u9375\u3002\u4ee5\u4e0b\u662f\u4e00\u500b\u9010\u6b65\u7684\u7b56\u7565\uff1a\u6b65\u9a5f1\uff1a\u5206\u6790\u554f\u984c\u985e\u5225\uff08\u4f8b\u5982\uff0c\u5730\u7406\u3001\u6d41\u884c\u6587\u5316\uff09\u3002\u6b65\u9a5f2\uff1a\u56de\u60f3\u60a8\u5728\u5148\u524d\u904a\u6232\u4e2d\uff0c\u6700\u5e38\u7d66\u51fa\u7684\u7b54\u6848\u3002\u6b65\u9a5f3\uff1a\u904b\u7528\u908f\u8f2f\u63a8\u7406\uff0c\u7e2e\u5c0f\u9078\u9805\u7bc4\u570d\u3002\u4f8b\u5982\uff0c\u5982\u679c\u554f\u984c\u662f\u300e\u8acb\u8aaa\u51fa\u4e00\u500b\u7d05\u8272\u7684\u6c34\u679c\u300f\uff0c\u800c\u60a8\u8a18\u5f97\u300e\u860b\u679c\u300f\u66fe\u7d93\u662f\u4e00\u500b\u5e38\u898b\u7684\u7b54\u6848\uff0c\u90a3\u9ebc\u5c31\u9078\u64c7\u5b83\u3002[\u591a\u65b9\u6bd4\u8f03: \u96d6\u7136\u300e\u8349\u8393\u300f\u4e5f\u662f\u7d05\u8272\u7684\uff0c\u4f46\u300e\u860b\u679c\u300f\u88ab\u731c\u4e2d\u7684\u6a5f\u7387\u66f4\u9ad8\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u300e\u731c\u731c\u4ed6\u5011\u7684\u7b54\u6848\u300f\u6703\u4f7f\u7528\u57fa\u65bc\u9ede\u6578\u7684\u8a08\u5206\u7cfb\u7d71\uff0c\u4ee5\u53ca\u5b83\u7684\u904b\u4f5c\u65b9\u5f0f\u70ba\u4f55\uff1f", "answer": "\u300e\u731c\u731c\u4ed6\u5011\u7684\u7b54\u6848\u300f\u63a1\u7528\u57fa\u65bc\u9ede\u6578\u7684\u8a08\u5206\u7cfb\u7d71\uff0c\u76ee\u7684\u662f\u70ba\u4e86\u589e\u6dfb\u7af6\u722d\u6027\uff0c\u4e26\u8861\u91cf\u73a9\u5bb6\u7684\u6280\u5de7\u3002\u9ede\u6578\u6703\u6839\u64da\u60a8\u7684\u731c\u6e2c\u6e96\u78ba\u6027\u548c\u901f\u5ea6\u800c\u7d66\u4e88\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5728\u300e\u8acb\u8aaa\u51fa\u7f8e\u570b\u7684\u4e00\u500b\u57ce\u5e02\u300f\u7684\u554f\u984c\u4e2d\uff0c\u731c\u5230\u300e\u7d10\u7d04\u300f\uff0c\u4e26\u4e14\u5b83\u5728\u6700\u4f73\u7b54\u6848\u4e4b\u5217\uff0c\u60a8\u5c31\u6703\u7372\u5f97\u9ede\u6578\u3002\u9019\u500b\u7cfb\u7d71\u9f13\u52f5\u73a9\u5bb6\u5feb\u901f\u4e14\u6e96\u78ba\u5730\u601d\u8003\uff0c\u63d0\u5347\u6574\u9ad4\u904a\u6232\u9ad4\u9a57\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u5c11\u898b\u4f46\u6b63\u78ba\u7684\u7b54\u6848\u53ef\u4ee5\u7372\u5f97\u8f03\u9ad8\u7684\u9ede\u6578\uff0c\u5e73\u8861\u98a8\u96aa\u548c\u56de\u5831\u3002]"}, {"question": "\u300e\u731c\u731c\u4ed6\u5011\u7684\u7b54\u6848\u300f\u54ea\u4e9b\u904a\u6232\u6a5f\u5236\u6700\u6709\u5229\u65bc\u9577\u671f\u53c3\u8207\uff1f", "answer": "\u5728\u300e\u731c\u731c\u4ed6\u5011\u7684\u7b54\u6848\u300f\u4e2d\uff0c\u6709\u52a9\u65bc\u9577\u671f\u53c3\u8207\u7684\u6a5f\u5236\u5305\u62ec\u6bcf\u65e5\u6311\u6230\u548c\u6392\u884c\u699c\u7cfb\u7d71\u3002\u6bcf\u65e5\u6311\u6230\u6bcf\u5929\u90fd\u6703\u63d0\u4f9b\u65b0\u7684\u554f\u984c\uff0c\u4fdd\u6301\u5167\u5bb9\u7684\u65b0\u9bae\u5ea6\u3002\u6392\u884c\u699c\u7cfb\u7d71\u8b93\u73a9\u5bb6\u53ef\u4ee5\u8207\u670b\u53cb\u548c\u5168\u7403\u793e\u7fa4\u7af6\u722d\uff0c\u57f9\u990a\u6210\u5c31\u611f\u3002\u4f8b\u5982\uff0c\u5b8c\u6210\u6bcf\u65e5\u6311\u6230\u53ef\u80fd\u9700\u8981\u731c\u51fa\u300e\u5496\u5561\u300f\u662f\u5c0d\u300e\u4eba\u5011\u65e9\u4e0a\u559d\u4ec0\u9ebc\uff1f\u300f\u9019\u500b\u554f\u984c\u6700\u5e38\u898b\u7684\u7b54\u6848\u3002[\u6d41\u7a0b\u5716\u89e3: \u6bcf\u65e5\u6311\u6230 \u2192 \u65b0\u9bae\u5167\u5bb9 \u2192 \u53c3\u8207\u5ea6\u63d0\u5347 \u2192 \u6392\u884c\u699c\u7af6\u722d\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u4e0d\u540c\u88dd\u7f6e\u9593\u9077\u79fb\u300e\u731c\u731c\u4ed6\u5011\u7684\u7b54\u6848\u300f\u7684\u8cc7\u6599\uff1f", "answer": "\u5982\u679c\u60a8\u5728\u4e0d\u540c\u5e73\u53f0\u4f7f\u7528\u76f8\u540c\u7684\u5e33\u6236\uff0c\u5247\u5728\u4e0d\u540c\u88dd\u7f6e\u9593\u9077\u79fb\u300e\u731c\u731c\u4ed6\u5011\u7684\u7b54\u6848\u300f\u8cc7\u6599\u975e\u5e38\u7c21\u55ae\u3002\u53ea\u9700\u5728\u65b0\u7684\u88dd\u7f6e\u4e0a\u4f7f\u7528\u539f\u59cb\u5e33\u6236\u6191\u8b49\u767b\u5165\u5373\u53ef\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9e iPhone \u5207\u63db\u5230 Android \u88dd\u7f6e\uff0c\u4f7f\u7528\u60a8\u7684 Apple ID \u6216 Google \u5e33\u6236\u767b\u5165\uff0c\u5c07\u6703\u540c\u6b65\u60a8\u7684\u9032\u5ea6\uff0c\u5305\u62ec\u60a8\u7684\u5206\u6578\u548c\u89e3\u9396\u7684\u5167\u5bb9\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u60a8\u7684\u904a\u6232\u8cc7\u6599\u60f3\u50cf\u6210\u6703\u8ffd\u96a8\u60a8\u5728\u4efb\u4f55\u767b\u5165\u88dd\u7f6e\u4e0a\u7684\u96f2\u7aef\u3002]"}, {"question": "\u5728\u300e\u731c\u731c\u4ed6\u5011\u7684\u7b54\u6848\u300f\u4e2d\uff0c\u53ef\u4ee5\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u5167\u5bb9\uff0c\u4ee5\u53ca\u5982\u4f55\u767c\u73fe\uff1f", "answer": "\u300e\u731c\u731c\u4ed6\u5011\u7684\u7b54\u6848\u300f\u5305\u542b\u96b1\u85cf\u5167\u5bb9\uff0c\u4f8b\u5982\u7a00\u6709\u554f\u984c\u548c\u7279\u6b8a\u734e\u52f5\uff0c\u900f\u904e\u9054\u6210\u7279\u5b9a\u91cc\u7a0b\u7891\u4f86\u89e3\u9396\u3002\u4f8b\u5982\uff0c\u6b63\u78ba\u56de\u7b54 100 \u500b\u554f\u984c\u53ef\u80fd\u6703\u89e3\u9396\u4e00\u500b\u7279\u6b8a\u7684\u985e\u5225\uff0c\u4f8b\u5982\u300e\u6b77\u53f2\u4e8b\u4ef6\u300f\u3002\u767c\u73fe\u9019\u4e9b\u5167\u5bb9\u9700\u8981\u6301\u7e8c\u904a\u73a9\u4e26\u95dc\u6ce8\u904a\u6232\u7684\u9032\u5ea6\u7cfb\u7d71\u3002[\u591a\u65b9\u6bd4\u8f03: \u96d6\u7136\u6709\u4e9b\u96b1\u85cf\u5167\u5bb9\u7d14\u7cb9\u662f\u5916\u89c0\u4e0a\u7684\uff0c\u4f46\u53e6\u4e00\u4e9b\u5247\u63d0\u4f9b\u4e86\u65b0\u7684\u904a\u6232\u6311\u6230\u3002]"}, {"question": "\u300e\u731c\u731c\u4ed6\u5011\u7684\u7b54\u6848\u300f\u4e2d\u554f\u984c\u7684\u96e3\u5ea6\u662f\u5982\u4f55\u96a8\u8457\u73a9\u5bb6\u9032\u5ea6\u800c\u8abf\u6574\uff1f", "answer": "\u300e\u731c\u731c\u4ed6\u5011\u7684\u7b54\u6848\u300f\u4e2d\u554f\u984c\u7684\u96e3\u5ea6\u53d6\u6c7a\u65bc\u60a8\u7684\u8868\u73fe\u548c\u64c5\u9577\u7684\u985e\u5225\u3002\u96a8\u8457\u60a8\u7684\u9032\u5ea6\uff0c\u904a\u6232\u5c07\u5f15\u5165\u66f4\u8907\u96dc\u7684\u554f\u984c\u548c\u8f03\u4e0d\u5e38\u898b\u7684\u7b54\u6848\u3002\u4f8b\u5982\uff0c\u5728\u638c\u63e1\u4e86\u57fa\u672c\u5730\u7406\u554f\u984c\u5f8c\uff0c\u60a8\u53ef\u80fd\u6703\u9047\u5230\u4e00\u4e9b\u66f4\u96e3\u7684\u554f\u984c\uff0c\u4f8b\u5982\u300e\u8acb\u8aaa\u51fa\u4e0d\u4e39\u7684\u4e00\u500b\u57ce\u5e02\u300f\u3002\u9019\u7a2e\u8abf\u6574\u78ba\u4fdd\u904a\u6232\u4fdd\u6301\u6709\u6311\u6230\u6027\u4e14\u5f15\u4eba\u5165\u52dd\u3002 [\u914d\u7f6e\u5c0d\u7167\u8868: \u904a\u6232\u521d\u671f\u554f\u984c\u7bc4\u570d\u8f03\u5ee3\uff0c\u800c\u5f8c\u7e8c\u554f\u984c\u5247\u9700\u8981\u66f4\u5c08\u696d\u7684\u77e5\u8b58\u3002]"}, {"question": "\u5728\u300e\u731c\u731c\u4ed6\u5011\u7684\u7b54\u6848\u300f\u4e2d\uff0c\u63d0\u9ad8\u53cd\u61c9\u6642\u9593\u6700\u6709\u6548\u7684\u9014\u5f91\u662f\u4ec0\u9ebc\uff1f", "answer": "\u63d0\u9ad8\u300e\u731c\u731c\u4ed6\u5011\u7684\u7b54\u6848\u300f\u7684\u53cd\u61c9\u6642\u9593\u9700\u8981\u7df4\u7fd2\u548c\u719f\u6089\u5e38\u898b\u7b54\u6848\u3002\u4ee5\u4e0b\u662f\u4e00\u500b\u5faa\u5e8f\u6f38\u9032\u7684\u65b9\u6cd5\uff1a\u6b65\u9a5f 1\uff1a\u5b9a\u671f\u904a\u6232\u4ee5\u5efa\u7acb\u808c\u8089\u8a18\u61b6\u3002\u6b65\u9a5f 2\uff1a\u5c08\u6ce8\u65bc\u7d93\u5e38\u51fa\u73fe\u7684\u985e\u5225\uff0c\u4ee5\u4fbf\u5feb\u901f\u9810\u6e2c\u7b54\u6848\u3002\u6b65\u9a5f 3\uff1a\u4f7f\u7528\u904a\u6232\u7684\u7df4\u7fd2\u6a21\u5f0f\u6a21\u64ec\u5be6\u6642\u731c\u6e2c\uff0c\u907f\u514d\u61f2\u7f70\u3002\u4f8b\u5982\uff0c\u7df4\u7fd2\u5305\u542b\u300c\u8acb\u8aaa\u51fa\u984f\u8272\u300d\u7684\u554f\u984c\uff0c\u5c07\u6709\u52a9\u65bc\u60a8\u8fc5\u901f\u60f3\u8d77\u300c\u85cd\u8272\u300d\u6216\u300c\u7d05\u8272\u300d\u7b49\u7b54\u6848\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u60a8\u7684\u8166\u888b\u60f3\u50cf\u6210\u6703\u96a8\u8457\u91cd\u8907\u800c\u8b8a\u5f97\u66f4\u5feb\u7684\u53cd\u5c04\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u300e\u731c\u731c\u4ed6\u5011\u7684\u7b54\u6848\u300f\u4e2d\u67d0\u4e9b\u985e\u5225\u6bd4\u5176\u4ed6\u985e\u5225\u66f4\u5177\u6311\u6230\u6027\uff1f", "answer": "\u300e\u731c\u731c\u4ed6\u5011\u7684\u7b54\u6848\u300f\u4e2d\u67d0\u4e9b\u985e\u5225\u66f4\u5177\u6311\u6230\u6027\uff0c\u662f\u56e0\u70ba\u53ef\u80fd\u7684\u7b54\u6848\u7a2e\u985e\u548c\u7279\u6027\u591a\u6a23\u4e14\u7279\u5b9a\u3002\u4f8b\u5982\uff0c\u300e\u79d1\u5b78\u300f\u985e\u554f\u984c\u53ef\u80fd\u9700\u8981\u8f03\u591a\u7684\u5c08\u696d\u77e5\u8b58\uff0c\u8207\u300e\u6d41\u884c\u6587\u5316\u300f\u985e\u554f\u984c\u76f8\u6bd4\u3002\u9019\u7a2e\u591a\u6a23\u6027\u78ba\u4fdd\u4e86\u4e0d\u540c\u5c08\u9577\u80cc\u666f\u7684\u73a9\u5bb6\u90fd\u80fd\u5728\u904a\u6232\u4e2d\u627e\u5230\u6a02\u8da3\uff0c\u4e14\u904a\u6232\u5177\u6709\u5e73\u8861\u6027\u3002[\u591a\u65b9\u6bd4\u8f03: \u96d6\u7136\u300e\u6d41\u884c\u6587\u5316\u300f\u554f\u984c\u6709\u8f03\u53ef\u9810\u6e2c\u7684\u7b54\u6848\uff0c\u4f46\u300e\u79d1\u5b78\u300f\u554f\u984c\u53ef\u80fd\u66f4\u62bd\u8c61\u4e14\u8b8a\u5316\u66f4\u5927\u3002]"}, {"question": "\u5982\u4f55\u6700\u4f73\u5316\u88dd\u7f6e\u8a2d\u5b9a\uff0c\u4ee5\u7372\u5f97\u6700\u4f73\u7684\u300e\u731c\u731c\u4ed6\u5011\u7684\u7b54\u6848\u300f\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u6700\u4f73\u5316\u88dd\u7f6e\u8a2d\u5b9a\u4ee5\u7372\u5f97\u6700\u4f73\u7684\u300e\u731c\u731c\u4ed6\u5011\u7684\u7b54\u6848\u300f\u904a\u6232\u9ad4\u9a57\uff0c\u5305\u62ec\u78ba\u4fdd\u9806\u66a2\u7684\u6548\u80fd\u548c\u76e1\u53ef\u80fd\u6e1b\u5c11\u5e72\u64fe\u3002\u4ee5\u4e0b\u662f\u5982\u4f55\u64cd\u4f5c\uff1a\u6b65\u9a5f 1\uff1a\u66f4\u65b0\u60a8\u7684\u88dd\u7f6e\u4f5c\u696d\u7cfb\u7d71\u548c\u904a\u6232\u81f3\u6700\u65b0\u7248\u672c\u3002\u6b65\u9a5f 2\uff1a\u95dc\u9589\u80cc\u666f\u61c9\u7528\u7a0b\u5f0f\uff0c\u4ee5\u91cb\u653e\u8a18\u61b6\u9ad4\u3002\u6b65\u9a5f 3\uff1a\u8abf\u6574\u87a2\u5e55\u4eae\u5ea6\u548c\u8072\u97f3\u8a2d\u5b9a\uff0c\u4ee5\u7372\u5f97\u8212\u9069\u7684\u904a\u6232\u9ad4\u9a57\u3002\u4f8b\u5982\uff0c\u5728\u9577\u6642\u9593\u904a\u6232\u6642\u964d\u4f4e\u87a2\u5e55\u4eae\u5ea6\u53ef\u4ee5\u5e6b\u52a9\u9810\u9632\u773c\u775b\u75b2\u52de\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u60a8\u7684\u88dd\u7f6e\u60f3\u50cf\u6210\u4e00\u53f0\u7d93\u904e\u7cbe\u7dfb\u8abf\u6821\u7684\u7cbe\u5bc6\u5100\u5668\uff0c\u9700\u8981\u5b9a\u671f\u4fdd\u990a\u624d\u80fd\u767c\u63ee\u6700\u4f73\u6548\u80fd\u3002]"}]
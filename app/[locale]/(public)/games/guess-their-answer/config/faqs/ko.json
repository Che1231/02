[{"question": "\ucd08\ubcf4\uc790\ub97c \uc704\ud55c \ud034\uc988 \ub2f5\ubcc0 \uac8c\uc784 \uc2dc\uc791 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud034\uc988 \ub2f5\ubcc0 \uac8c\uc784\uc744 \uc2dc\uc791\ud558\ub824\uba74 \uba3c\uc800 \uc6d0\ud558\ub294 \uc571 \uc2a4\ud1a0\uc5b4\uc5d0\uc11c \uac8c\uc784\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud569\ub2c8\ub2e4. \uc2e4\ud589\ud558\uba74 \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc744 \uc124\uba85\ud558\ub294 \ud29c\ud1a0\ub9ac\uc5bc\uc774 \uc548\ub0b4\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud504\ub791\uc2a4\uc758 \uc218\ub3c4\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?'\uc640 \uac19\uc740 \uc9c8\ubb38\uc5d0 \uac00\uc7a5 \ud754\ud55c \ub2f5\ubcc0\uc778 '\ud30c\ub9ac'\ub97c \uc120\ud0dd\ud558\uc5ec \uc5b4\ub5bb\uac8c \ucd94\uce21\ud558\ub294\uc9c0 \ubc30\uc6b8 \uac83\uc785\ub2c8\ub2e4. \uc774 \ucd08\uae30 \ub2e8\uacc4\ub294 \uac8c\uc784\uc758 \ud575\uc2ec \uac1c\ub150\uc744 \uc774\ud574\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud29c\ud1a0\ub9ac\uc5bc\uc740 \uac8c\uc784\uc758 \uc9c0\ud615\uc744 \uc548\ub0b4\ud558\ub294 \uc9c0\ub3c4\uc640 \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "100\uc2dc\uac04 \ud50c\ub808\uc774 \ud6c4 \ud034\uc988 \ub2f5\ubcc0 \uac8c\uc784\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "100\uc2dc\uac04 \ud50c\ub808\uc774 \ud6c4 \uc77c\ubc18\uc801\uc778 \ub2f5\ubcc0\uc744 \uc608\uce21\ud558\ub294 \uae30\uc220\uc744 \uc775\ud788\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4\ubcc4 \uc804\ub7b5\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: \ub2e8\uacc4 1: \uc9c8\ubb38\uc758 \ubd84\ub958(\uc608: \uc9c0\ub9ac, \ub300\uc911 \ubb38\ud654)\ub97c \ubd84\uc11d\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc774\uc804 \uac8c\uc784\uc5d0\uc11c \uac00\uc7a5 \uc790\uc8fc \uc81c\uc2dc\ub41c \ub2f5\ubcc0\uc744 \uae30\uc5b5\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ub17c\ub9ac\uc801 \ucd94\ub860\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc635\uc158\uc744 \uc881\ud799\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc9c8\ubb38\uc774 '\ube68\uac04\uc0c9 \uacfc\uc77c\uc758 \uc774\ub984\uc744 \ub9d0\ud558\uc2ed\uc2dc\uc624'\uc774\uace0 '\uc0ac\uacfc'\uac00 \uc790\uc8fc \ub098\uc624\ub294 \ub2f5\ubcc0\uc774\ub77c\uba74 \uadf8 \ub2f5\ubcc0\uc744 \uc120\ud0dd\ud558\uc2ed\uc2dc\uc624. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: '\ub538\uae30'\ub3c4 \ube68\uac04\uc0c9\uc774\uc9c0\ub9cc, '\uc0ac\uacfc'\uac00 \ub354 \uc790\uc8fc \ucd94\uce21\ub418\ub294 \ub2f5\ubcc0\uc785\ub2c8\ub2e4.]"}, {"question": "\ud034\uc988 \ub2f5\ubcc0 \uac8c\uc784\uc774 \uc810\uc218 \uae30\ubc18 \uc2dc\uc2a4\ud15c\uc744 \uc0ac\uc6a9\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "\ud034\uc988 \ub2f5\ubcc0 \uac8c\uc784\uc740 \uacbd\uc7c1\ub825\uc744 \ub192\uc774\uace0 \ud50c\ub808\uc774\uc5b4\uc758 \uae30\uc220\uc744 \ud3c9\uac00\ud558\uae30 \uc704\ud574 \uc810\uc218 \uae30\ubc18 \uc2dc\uc2a4\ud15c\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc810\uc218\ub294 \uc815\ud655\uc131\uacfc \ucd94\uce21 \uc18d\ub3c4\uc5d0 \ub530\ub77c \ubd80\uc5ec\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ubbf8\uad6d \ub3c4\uc2dc\uc758 \uc774\ub984\uc744 \ub9d0\ud558\uc2ed\uc2dc\uc624'\uc5d0 \ub300\ud55c \ub2f5\ubcc0\uc73c\ub85c '\ub274\uc695'\uc744 \ub9de\ucd94\uba74 \uc0c1\uc704 \ub2f5\ubcc0 \uc911 \ud558\ub098\uc5d0 \ud574\ub2f9\ub420 \uacbd\uc6b0 \uc810\uc218\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc2e0\uc18d\ud558\uace0 \uc815\ud655\ud558\uac8c \uc0dd\uac01\ud558\ub3c4\ub85d \uc7a5\ub824\ud558\uc5ec \uc804\ubc18\uc801\uc778 \uac8c\uc784 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4. [\uc124\uc815 \ub300\uc870\ud45c: \ub35c \uc77c\ubc18\uc801\uc774\uc9c0\ub9cc \uc5ec\uc804\ud788 \uc815\ud655\ud55c \ub2f5\ubcc0\uc5d0 \ub300\ud55c \uc810\uc218\uac00 \ub354 \ub192\uc544 \uc704\ud5d8\uacfc \ubcf4\uc0c1\uc758 \uade0\ud615\uc744 \ub9de\ucda5\ub2c8\ub2e4.]"}, {"question": "\ud034\uc988 \ub2f5\ubcc0 \uac8c\uc784\uc5d0\uc11c \uc7a5\uae30\uc801\uc778 \ucc38\uc5ec\uc5d0 \uac00\uc7a5 \uc720\uc775\ud55c \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud034\uc988 \ub2f5\ubcc0 \uac8c\uc784\uc5d0\uc11c \uc7a5\uae30\uc801\uc778 \ucc38\uc5ec\ub97c \ucd09\uc9c4\ud558\ub294 \uba54\ucee4\ub2c8\uc998\uc5d0\ub294 \ub9e4\uc77c \ucc4c\ub9b0\uc9c0\uc640 \ub9ac\ub354\ubcf4\ub4dc \uc2dc\uc2a4\ud15c\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ub9e4\uc77c \ucc4c\ub9b0\uc9c0\ub294 \ub9e4\uc77c \uc0c8\ub85c\uc6b4 \uc9c8\ubb38\uc744 \uc81c\uacf5\ud558\uc5ec \ucf58\ud150\uce20\ub97c \uc0c8\ub86d\uac8c \uc720\uc9c0\ud569\ub2c8\ub2e4. \ub9ac\ub354\ubcf4\ub4dc \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uce5c\uad6c \ubc0f \uc804 \uc138\uacc4 \ucee4\ubba4\ub2c8\ud2f0\uc640 \uacbd\uc7c1\ud560 \uc218 \uc788\ub3c4\ub85d \ud558\uc5ec \uc131\ucde8\uac10\uc744 \uc870\uc131\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub9e4\uc77c \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\ub824\uba74 '\uc544\uce68\uc5d0 \uc0ac\ub78c\ub4e4\uc774 \ubb34\uc5c7\uc744 \ub9c8\uc2ed\ub2c8\uae4c?'\uc5d0 \ub300\ud55c \uac00\uc7a5 \uc77c\ubc18\uc801\uc778 \ub2f5\ubcc0\uc73c\ub85c '\ucee4\ud53c'\ub97c \ub9de\ucdb0\uc57c \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \ub9e4\uc77c \ucc4c\ub9b0\uc9c0 \u2192 \uc2e0\uc120\ud55c \ucf58\ud150\uce20 \u2192 \ucc38\uc5ec \uc99d\uac00 \u2192 \ub9ac\ub354\ubcf4\ub4dc \uacbd\uc7c1.]"}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \uc790\uc2e0\uc758 \ud034\uc988 \ub2f5\ubcc0 \uac8c\uc784 \ub370\uc774\ud130\ub97c \ub2e4\ub978 \uae30\uae30 \uac04\uc5d0 \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud50c\ub7ab\ud3fc \uc804\uccb4\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc744 \uc0ac\uc6a9\ud558\ub294 \uacbd\uc6b0 \ud034\uc988 \ub2f5\ubcc0 \uac8c\uc784 \ub370\uc774\ud130\ub97c \ub2e4\ub978 \uae30\uae30 \uac04\uc5d0 \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud558\ub294 \uac83\uc740 \uac04\ub2e8\ud569\ub2c8\ub2e4. \uc0c8 \uae30\uae30\uc5d0\uc11c \uc6d0\ub798 \uacc4\uc815 \uc790\uaca9 \uc99d\uba85\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uae30\ub9cc \ud558\uba74 \ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, iPhone\uc5d0\uc11c Android \uae30\uae30\ub85c \uc804\ud658\ud558\ub294 \uacbd\uc6b0 Apple ID \ub610\ub294 Google \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uba74 \uc810\uc218 \ubc0f \uc7a0\uae08 \ud574\uc81c\ub41c \ucf58\ud150\uce20\ub97c \ud3ec\ud568\ud55c \uc9c4\ud589 \uc0c1\ud669\uc774 \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uac8c\uc784 \ub370\uc774\ud130\ub294 \ub85c\uadf8\uc778\ud558\ub294 \uc7a5\uc18c\ub97c \ub530\ub77c\ub2e4\ub2c8\ub294 \ud074\ub77c\uc6b0\ub4dc\uc640 \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ud034\uc988 \ub2f5\ubcc0 \uac8c\uc784\uc5d0\uc11c \uc5b4\ub5a4 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \ubc1c\uacac\ud560 \uc218 \uc788\uc73c\uba70, \uc5b4\ub5bb\uac8c \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud034\uc988 \ub2f5\ubcc0 \uac8c\uc784\uc5d0\ub294 \ud2b9\uc815 \uc774\uc815\ud45c\ub97c \ub2ec\uc131\ud558\uc5ec \uc7a0\uae08 \ud574\uc81c\ub418\ub294 \ud2b9\ubcc4\ud55c \uc9c8\ubb38\uacfc \ubcf4\uc0c1\uacfc \uac19\uc740 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 100\uac1c\uc758 \uc9c8\ubb38\uc5d0 \uc815\ub2f5\uc744 \ub9de\ucd94\uba74 '\uc5ed\uc0ac\uc801 \uc0ac\uac74'\uacfc \uac19\uc740 \ud2b9\ubcc4\ud55c \ubd84\ub958\uac00 \uc7a0\uae08 \ud574\uc81c\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ucf58\ud150\uce20\ub97c \ubc1c\uacac\ud558\ub824\uba74 \uc9c0\uc18d\uc801\uc778 \ud50c\ub808\uc774\uc640 \uac8c\uc784\uc758 \uc9c4\ud589 \uc2dc\uc2a4\ud15c\uc5d0 \ub300\ud55c \uc8fc\uc758\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: \uc77c\ubd80 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub294 \uc21c\uc804\ud788 \ubbf8\uc801\uc774\uc9c0\ub9cc, \ub2e4\ub978 \ucf58\ud150\uce20\ub294 \uc0c8\ub85c\uc6b4 \uac8c\uc784 \uacfc\uc81c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4.]"}, {"question": "\ud034\uc988 \ub2f5\ubcc0 \uac8c\uc784\uc5d0\uc11c \uc9c8\ubb38\uc758 \ub09c\uc774\ub3c4\ub294 \ud50c\ub808\uc774\uc5b4\uc758 \uc9c4\ud589 \uc0c1\ud669\uc5d0 \ub530\ub77c \uc5b4\ub5bb\uac8c \uc870\uc815\ub429\ub2c8\uae4c?", "answer": "\ud034\uc988 \ub2f5\ubcc0 \uac8c\uc784\uc5d0\uc11c \uc9c8\ubb38\uc758 \ub09c\uc774\ub3c4\ub294 \ud50c\ub808\uc774\uc5b4\uc758 \uc131\uacfc\uc640 \uc6b0\uc218\ud55c \ubd84\ub958\uc5d0 \ub530\ub77c \uc870\uc815\ub429\ub2c8\ub2e4. \uc9c4\ud589 \uc0c1\ud669\uc5d0 \ub530\ub77c \uac8c\uc784\uc740 \ub354 \ubcf5\uc7a1\ud55c \uc9c8\ubb38\uacfc \ub35c \uc77c\ubc18\uc801\uc778 \ub2f5\ubcc0\uc744 \uc81c\uc2dc\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uae30\ubcf8\uc801\uc778 \uc9c0\ub9ac \uc9c8\ubb38\uc744 \ub9c8\uc2a4\ud130\ud55c \ud6c4 '\ubd80\ud0c4\uc758 \ub3c4\uc2dc \uc774\ub984\uc744 \ub9d0\ud558\uc2ed\uc2dc\uc624'\uc640 \uac19\uc774 \ub354 \uc0dd\uc18c\ud55c \uc9c8\ubb38\uc5d0 \uc9c1\uba74\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc870\uc815\uc744 \ud1b5\ud574 \uac8c\uc784\uc774 \uc9c0\uc18d\uc801\uc73c\ub85c \uc5b4\ub824\uc6b0\uba74\uc11c\ub3c4 \ub9e4\ub825\uc801\uc774\ub3c4\ub85d \ud569\ub2c8\ub2e4. [\uc124\uc815 \ub300\uc870\ud45c: \ucd08\uae30 \uac8c\uc784 \uc9c8\ubb38\uc740 \ub354 \uad11\ubc94\uc704\ud558\uc9c0\ub9cc, \ud6c4\uae30 \uc9c8\ubb38\uc740 \ub354 \uad6c\uccb4\uc801\uc778 \uc9c0\uc2dd\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.]"}, {"question": "\ud034\uc988 \ub2f5\ubcc0 \uac8c\uc784\uc5d0\uc11c \ubc18\uc751 \uc2dc\uac04\uc744 \uac1c\uc120\ud558\ub294 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud034\uc988 \ub2f5\ubcc0 \uac8c\uc784\uc5d0\uc11c \ubc18\uc751 \uc2dc\uac04\uc744 \uac1c\uc120\ud558\ub824\uba74 \uc5f0\uc2b5\uacfc \uc77c\ubc18\uc801\uc778 \ub2f5\ubcc0\uc5d0 \ub300\ud55c \uc219\ub2ec\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4\ubcc4 \ubc29\ubc95\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: \ub2e8\uacc4 1: \uadfc\uc721 \uae30\uc5b5\ub825\uc744 \uad6c\ucd95\ud558\uae30 \uc704\ud574 \uc815\uae30\uc801\uc73c\ub85c \ud50c\ub808\uc774\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc790\uc8fc \ub4f1\uc7a5\ud558\ub294 \ubd84\ub958\uc5d0 \uc9d1\uc911\ud558\uc5ec \ub2f5\ubcc0\uc744 \uc2e0\uc18d\ud558\uac8c \uc608\uc0c1\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uac8c\uc784\uc758 \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud398\ub110\ud2f0 \uc5c6\uc774 \uc2e4\uc2dc\uac04 \ucd94\uce21\uc744 \uc2dc\ubbac\ub808\uc774\uc158\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc0c9\uae54\uc744 \ub9d0\ud558\uc2ed\uc2dc\uc624'\uc640 \uac19\uc740 \uc9c8\ubb38\uc744 \uc5f0\uc2b5\ud558\uba74 '\ud30c\ub780\uc0c9'\uc774\ub098 '\ube68\uac04\uc0c9'\uacfc \uac19\uc740 \ub2f5\ubcc0\uc744 \uc2e0\uc18d\ud558\uac8c \uae30\uc5b5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ub1cc\ub97c \ubc18\ubcf5\uc744 \ud1b5\ud574 \ub354 \ube68\ub77c\uc9c0\ub294 \ubc18\uc0ac \uc791\uc6a9\uc73c\ub85c \uc0dd\uac01\ud558\uc2ed\uc2dc\uc624.]"}, {"question": "\uc65c \ud034\uc988 \ub2f5\ubcc0 \uac8c\uc784\uc758 \ud2b9\uc815 \ubd84\ub958\ub294 \ub2e4\ub978 \ubd84\ub958\ubcf4\ub2e4 \ub354 \uc5b4\ub824\uc6b4\uac00\uc694?", "answer": "\ud034\uc988 \ub2f5\ubcc0 \uac8c\uc784\uc758 \ud2b9\uc815 \ubd84\ub958\ub294 \uac00\ub2a5\ud55c \ub2f5\ubcc0\uc758 \ub2e4\uc591\uc131\uacfc \ud2b9\uc218\uc131\uc73c\ub85c \uc778\ud574 \ub2e4\ub978 \ubd84\ub958\ubcf4\ub2e4 \ub354 \uc5b4\ub835\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uacfc\ud559' \uc9c8\ubb38\uc740 '\ub300\uc911 \ubb38\ud654' \uc9c8\ubb38\uacfc \ube44\uad50\ud558\uc5ec \ub354 \uc804\ubb38\uc801\uc778 \uc9c0\uc2dd\uc774 \ud544\uc694\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ubcc0\ud654\ub97c \ud1b5\ud574 \ub2e4\uc591\ud55c \uc804\ubb38\uc131\uc744 \uac00\uc9c4 \ud50c\ub808\uc774\uc5b4\uac00 \uac8c\uc784\uc744 \ub9e4\ub825\uc801\uc774\uace0 \uade0\ud615 \uc788\uac8c \ub290\ub084 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: '\ub300\uc911 \ubb38\ud654' \uc9c8\ubb38\uc740 \ub354 \uc608\uce21 \uac00\ub2a5\ud55c \ub2f5\ubcc0\uc744 \uac00\uc9c0\uc9c0\ub9cc, '\uacfc\ud559' \uc9c8\ubb38\uc740 \ub354 \ucd94\uc0c1\uc801\uc774\uace0 \ub2e4\uc591\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \ucd5c\uace0\uc758 \ud034\uc988 \ub2f5\ubcc0 \uac8c\uc784 \uacbd\ud5d8\uc744 \uc704\ud574 \uae30\uae30 \uc124\uc815\uc744 \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud034\uc988 \ub2f5\ubcc0 \uac8c\uc784\uc5d0 \ucd5c\uc801\uc758 \uae30\uae30 \uc124\uc815\uc744 \uc704\ud574\uc11c\ub294 \uc6d0\ud65c\ud55c \uc131\ub2a5\uacfc \ucd5c\uc18c\ud55c\uc758 \ubc29\ud574 \uc694\uc18c\ub97c \ud655\ubcf4\ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \ub2e4\uc74c\uacfc \uac19\uc774 \uc218\ud589\ud558\uc2ed\uc2dc\uc624: \ub2e8\uacc4 1: \uae30\uae30\uc758 \uc6b4\uc601 \uccb4\uc81c\uc640 \uac8c\uc784\uc744 \ucd5c\uc2e0 \ubc84\uc804\uc73c\ub85c \uc5c5\ub370\uc774\ud2b8\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ubc30\uacbd \uc571\uc744 \ub2eb\uc544 \uba54\ubaa8\ub9ac\ub97c \ud655\ubcf4\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ud3b8\uc548\ud55c \ud50c\ub808\uc774\ub97c \uc704\ud574 \ud654\uba74 \ubc1d\uae30\uc640 \uc0ac\uc6b4\ub4dc \uc124\uc815\uc744 \uc870\uc815\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud654\uba74 \ubc1d\uae30\ub97c \uc904\uc774\uba74 \uc7a5\uc2dc\uac04 \uc138\uc158 \uc911 \ub208\uc758 \ud53c\ub85c\ub97c \uc904\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uae30\uae30\ub97c \ucd5c\uace0 \uc131\ub2a5\uc744 \uc720\uc9c0\ud558\uae30 \uc704\ud574 \uc815\uae30\uc801\uc778 \uc720\uc9c0 \ubcf4\uc218\uac00 \ud544\uc694\ud55c \uc815\uad50\ud558\uac8c \uc870\uc815\ub41c \uc545\uae30\ub85c \uc0dd\uac01\ud558\uc2ed\uc2dc\uc624.]"}]
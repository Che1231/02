[{"question": "\u6781\u901f\u8d5b\u8f663D\uff1a\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u6267\u884c\u57fa\u7840\u64cd\u4f5c\uff0c\u4f8b\u5982\u52a0\u901f\u548c\u5236\u52a8\uff1f", "answer": "\u5bf9\u4e8e\u6781\u901f\u8d5b\u8f663D\u7684\u65b0\u624b\u73a9\u5bb6\u6765\u8bf4\uff0c\u901a\u5e38\u53ef\u4ee5\u901a\u8fc7\u70b9\u51fb\u5c4f\u5e55\u4e0a\u7684\u6cb9\u95e8\u8e0f\u677f\u6765\u5b9e\u73b0\u52a0\u901f\u3002\u5236\u52a8\u540c\u6837\u53ef\u4ee5\u901a\u8fc7\u70b9\u51fb\u5236\u52a8\u8e0f\u677f\u6765\u5b9e\u73b0\u3002\u5728\u8bbe\u7f6e\u4e2d\u53ef\u80fd\u4f1a\u6709\u4e0d\u540c\u7684\u63a7\u5236\u65b9\u6848\u3002\u4f8b\u5982\uff0c\u5c1d\u8bd5\"\u503e\u659c\u63a7\u5236\u65b9\u5411\"\u4ee5\u83b7\u5f97\u66f4\u8eab\u4e34\u5176\u5883\u7684\u4f53\u9a8c\uff0c\u751a\u81f3\u53ef\u4ee5\u81ea\u5b9a\u4e49\u6309\u94ae\u3002\u4ece\u7ec3\u4e60\u8d5b\u9053\u5f00\u59cb\uff1b\u8fd9\u786e\u4fdd\u60a8\u5728\u6bd4\u8d5b\u4e4b\u524d\u611f\u5230\u8212\u9002\uff0c\u5e76\u4e14\u53ef\u4ee5\u8c03\u6574\u7075\u654f\u5ea6\u4ee5\u63d0\u9ad8\u63a7\u5236\u529b\u5e76\u51cf\u5c11\u901f\u5ea6\u635f\u5931\u3002\u8bb0\u4f4f\u5728\u8d77\u6b65\u9636\u6bb5\u6b63\u786e\u63a7\u5236\u65b9\u5411\u76d8\uff0c\u4ee5\u907f\u514d\u4e0d\u5fc5\u8981\u7684\u78b0\u649e\uff0c\u4f8b\u5982\u649e\u5230\u8d5b\u9053\u8fb9\u7f18\u3002\u4f8b\u5982\uff0c\u5c1d\u8bd5\"\u57ce\u5e02\u8d5b\u9053\"\u5173\u5361\u4f5c\u4e3a\u5b66\u4e60\u7684\u826f\u597d\u8d77\u70b9\u3002"}, {"question": "\u5728\u6781\u901f\u8d5b\u8f663D\u4e2d\uff0c\u4e3a\u4e86\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u6211\u7684\u6bd4\u8d5b\u8868\u73b0\uff0c\u54ea\u4e9b\u662f\u6e38\u620f\u521d\u671f\u6700\u597d\u7684\u6c7d\u8f66\u5347\u7ea7\u91cd\u70b9\uff1f", "answer": "\u5728\u6781\u901f\u8d5b\u8f663D\u7684\u6e38\u620f\u521d\u671f\uff0c\u5347\u7ea7\u5f15\u64ce\u548c\u8f6e\u80ce\u662f\u91cd\u70b9\u3002\u6539\u8fdb\u7684\u5f15\u64ce\u6027\u80fd\u53ef\u4ee5\u63d0\u5347\u901f\u5ea6\u3002\u5347\u7ea7\u7684\u8f6e\u80ce\u53ef\u4ee5\u63d0\u9ad8\u64cd\u63a7\u6027\u80fd\uff0c\u4ece\u800c\u6539\u5584\u8f6c\u5f2f\u7a33\u5b9a\u6027\u548c\u6293\u5730\u529b\u3002\u6700\u521d\u4e0d\u8981\u5347\u7ea7\u89c6\u89c9\u5916\u89c2\u3002\u6b65\u9aa41 - \u5347\u7ea7\u5f15\u64ce\uff1a\u4f18\u5148\u5347\u7ea7\"\u5f15\u64ce\"\uff0c\u4ee5\u63d0\u9ad8\u6700\u9ad8\u901f\u5ea6\u548c\u52a0\u901f\u80fd\u529b\u3002\u6b65\u9aa42 - \u5347\u7ea7\u8f6e\u80ce\uff1a\u4e13\u6ce8\u4e8e\u5347\u7ea7\"\u8f6e\u80ce\"\u4ee5\u63d0\u9ad8\u64cd\u63a7\u6027\u548c\u8fc7\u5f2f\u6027\u80fd\u3002\u6b65\u9aa43 - \u5e73\u8861\u5347\u7ea7\uff1a\u4e3a\u4e86\u83b7\u5f97\u6700\u4f73\u6027\u80fd\uff0c\u5728\u5f15\u64ce\u548c\u8f6e\u80ce\u5347\u7ea7\u4e4b\u95f4\u4fdd\u6301\u5e73\u8861\uff0c\u4ee5\u786e\u4fdd\u60a8\u5e73\u8861\u9a6c\u529b\u548c\u63a7\u5236\u529b\u3002\u8fd9\u6837\uff0c\u60a8\u5c31\u4e0d\u4f1a\u62e5\u6709\u65e0\u6cd5\u638c\u63a7\u7684\u5de8\u5927\u529b\u91cf\u3002\u6bd4\u8f83\u4e0d\u540c\u6c7d\u8f66\u7684\u57fa\u7840\u6570\u636e\u4e0e\u5347\u7ea7\u6210\u672c\uff0c\u4ee5\u4e86\u89e3\u4e0d\u540c\u6c7d\u8f66\u3002"}, {"question": "\u5728\u6781\u901f\u8d5b\u8f663D\u4e2d\uff0c\u6211\u53ef\u4ee5\u4f7f\u7528\u54ea\u4e9b\u7b56\u7565\u6709\u6548\u5730\u7ba1\u7406\u6211\u7684\u6c2e\u6c14\u52a0\u901f\uff0c\u4ee5\u5728\u5bf9\u624b\u4e2d\u83b7\u5f97\u4f18\u52bf\uff1f", "answer": "\u6c2e\u6c14\u52a0\u901f\u5728\u6781\u901f\u8d5b\u8f663D\u4e2d\u81f3\u5173\u91cd\u8981\uff0c\u7528\u4e8e\u8d85\u8d8a\u5bf9\u624b\u5e76\u4fdd\u6301\u901f\u5ea6\u3002\u7b56\u7565\u5305\u62ec\u660e\u667a\u5730\u5c06\u5176\u7528\u4e8e\u76f4\u9053\uff0c\u5e76\u907f\u514d\u8f6c\u5f2f\u3002\u8282\u7ea6\u662f\u5173\u952e\u3002\u6b65\u9aa41 - \u76f4\u9053\uff1a\u5728\u8d5b\u9053\u7684\u76f4\u7ebf\u6bb5\u4f7f\u7528\u52a0\u901f\uff0c\u56e0\u4e3a\u60a8\u7684\u901f\u5ea6\u5728\u8fd9\u4e2a\u65f6\u5019\u8fbe\u5230\u6700\u4f73\u3002\u6b65\u9aa42 - \u907f\u514d\u8f6c\u5f2f\uff1a\u5728\u6025\u5f2f\u4e2d\u907f\u514d\u4f7f\u7528\u52a0\u901f\uff1b\u8fd9\u901a\u5e38\u4f1a\u5bfc\u81f4\u65b9\u5411\u8fc7\u5ea6\u504f\u79fb\u5e76\u6d6a\u8d39\u6c2e\u6c14\u3002\u6b65\u9aa43 - \u963b\u6321\u5bf9\u624b\uff1a\u4f7f\u7528\u77ed\u65f6\u95f4\u7684\u52a0\u901f\u6765\u963b\u6321\u8bd5\u56fe\u8d85\u8d8a\u4f60\u7684\u5bf9\u624b\u3002\u628a\u5b83\u60f3\u6210\u8c61\u68cb\u6e38\u620f\u2014\u2014\u6c2e\u6c14\u52a0\u901f\u5c31\u662f\u4f60\u7684\u68cb\u738b\uff01\u4f8b\u5982\uff0c\u5728\u5761\u9053\u524d\u4f7f\u7528\u77ed\u6682\u7684\u52a0\u901f\u5c06\u4f7f\u60a8\u5728\u6bd4\u8d5b\u4e2d\u83b7\u5f97\u4e00\u5b9a\u4f18\u52bf\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u7684\u6e38\u620f\u5728\u6781\u901f\u8d5b\u8f663D\u4e2d\u4f1a\u51fa\u73b0\u5361\u987f\u548c\u56fe\u5f62\u9519\u8bef\uff0c\u4ee5\u53ca\u6211\u53ef\u4ee5\u5728\u4e2d\u7b49\u914d\u7f6e\u7684\u8bbe\u5907\u4e0a\u91c7\u53d6\u54ea\u4e9b\u6b65\u9aa4\u6765\u89e3\u51b3\u8fd9\u4e2a\u95ee\u9898\uff1f", "answer": "\u5728\u4e2d\u7b49\u914d\u7f6e\u7684\u8bbe\u5907\u4e0a\u73a9\u6781\u901f\u8d5b\u8f663D\u65f6\uff0c\u5361\u987f\u548c\u56fe\u5f62\u9519\u8bef\u901a\u5e38\u6e90\u4e8e\u8f83\u9ad8\u7684\u56fe\u5f62\u8bbe\u7f6e\u3002\u89e3\u51b3\u65b9\u6848\u5305\u62ec\u964d\u4f4e\u8bbe\u7f6e\u3002\u6b65\u9aa41 - \u964d\u4f4e\u56fe\u5f62\u8d28\u91cf\uff1a\u5728\u8bbe\u7f6e\u4e2d\uff0c\u5c06\"\u56fe\u5f62\u8d28\u91cf\"\u964d\u4f4e\u5230\"\u4e2d\u7b49\"\u6216\"\u4f4e\"\u3002\u6b65\u9aa42 - \u7981\u7528\u7279\u6b8a\u6548\u679c\uff1a\u5173\u95ed\u8bf8\u5982\"\u8fd0\u52a8\u6a21\u7cca\"\u3001\"\u53cd\u5c04\"\u548c\"\u9634\u5f71\"\u7b49\u6548\u679c\u3002\u6b65\u9aa43 - \u5173\u95ed\u540e\u53f0\u5e94\u7528\u7a0b\u5e8f\uff1a\u5173\u95ed\u540e\u53f0\u8fd0\u884c\u7684\u4efb\u4f55\u5e94\u7528\u7a0b\u5e8f\u4ee5\u91ca\u653e\u5185\u5b58\u3002\u8003\u8651\u4f7f\u7528\"\u6e38\u620f\u52a0\u901f\u5668\"\u5e94\u7528\u7a0b\u5e8f\uff0c\u4f46\u8bf7\u8c28\u614e\u3002\u5bf9\u4e8e\u67d0\u4e9b\u8bbe\u5907\uff0c\u6e38\u620f\u53ef\u80fd\u672a\u9488\u5bf9\u67d0\u4e9b\u8f83\u65e7\u6216\u8f83\u4e0d\u5e38\u89c1\u7684\u578b\u53f7\u8fdb\u884c\u4f18\u5316\u3002"}, {"question": "\u5728\u6781\u901f\u8d5b\u8f663D\u4e2d\uff0c\u4e0d\u540c\u7c7b\u578b\u7684\u6c7d\u8f66\u6709\u4ec0\u4e48\u610f\u4e49\uff0c\u4e3a\u4ec0\u4e48\u6211\u5e94\u8be5\u9009\u62e9\u4e00\u79cd\u800c\u4e0d\u662f\u53e6\u4e00\u79cd\uff1f", "answer": "\u6781\u901f\u8d5b\u8f663D\u4e2d\u4e0d\u540c\u7c7b\u578b\u7684\u6c7d\u8f66\u8fce\u5408\u5404\u79cd\u8d5b\u8f66\u98ce\u683c\uff0c\u6bcf\u8f86\u8f66\u5728\u4e0d\u540c\u9886\u57df\u90fd\u6709\u6240\u64c5\u957f\u3002\u8dd1\u8f66\u4f18\u5148\u8003\u8651\u901f\u5ea6\u548c\u64cd\u63a7\u6027\uff0c\u800c\u808c\u8089\u578b\u8f66\u5219\u63d0\u4f9b\u52a8\u529b\u548c\u6f02\u79fb\u3002\u6700\u4f73\u9009\u62e9\u53d6\u51b3\u4e8e\u60a8\u7684\u8d5b\u8f66\u98ce\u683c\u548c\u8d5b\u9053\u7c7b\u578b\u3002\u8dd1\u8f66\u5728\u5f2f\u9053\u7d27\u51d1\u7684\u8d5b\u9053\u4e0a\u8868\u73b0\u51fa\u8272\uff0c\u800c\u808c\u8089\u578b\u8f66\u5219\u5728\u76f4\u9053\u4e0a\u5360\u4e3b\u5bfc\u5730\u4f4d\u3002\u5bf9\u4e8e\u65b0\u624b\u8d5b\u8f66\u624b\u6765\u8bf4\uff0c\"Horizon GT\" \u662f\u4e00\u6b3e\u4e0d\u9519\u7684\u5165\u95e8\u8f66\u578b\uff0c\u5b83\u4e3a\u65b0\u624b\u63d0\u4f9b\u5e73\u8861\u7684\u8d5b\u8f66\u98ce\u683c\u3002"}, {"question": "\u6781\u901f\u8d5b\u8f663D\u5982\u4f55\u786e\u5b9a\u6bd4\u8d5b\u5956\u52b1\uff0c\u4ee5\u53ca\u54ea\u4e9b\u7279\u5b9a\u56e0\u7d20\u4f1a\u5f71\u54cd\u6211\u5728\u6bcf\u6b21\u6bd4\u8d5b\u540e\u83b7\u5f97\u7684\u6e38\u620f\u8d27\u5e01\u6570\u91cf\uff1f", "answer": "\u6781\u901f\u8d5b\u8f663D\u7684\u6bd4\u8d5b\u5956\u52b1\u53d6\u51b3\u4e8e\u51e0\u4e2a\u5173\u952e\u56e0\u7d20\uff0c\u4e3b\u8981\u5305\u62ec\u6bd4\u8d5b\u96be\u5ea6\u3001\u60a8\u7684\u6700\u7ec8\u4f4d\u7f6e\u4ee5\u53ca\u7279\u5b9a\u5956\u52b1\u4fee\u6b63\u5668\u7684\u4f7f\u7528\u3002\u6bd4\u8d5b\u96be\u5ea6\u8d8a\u9ad8\uff0c\u5956\u52b1\u4e5f\u4f1a\u5927\u5f97\u591a\uff0c\u4f46\u5bf9\u5347\u7ea7\u548c\u6280\u80fd\u7684\u8981\u6c42\u4e5f\u66f4\u9ad8\u3002\u8d62\u5f97\u6bd4\u8d5b\u5c06\u83b7\u5f97\u6700\u9ad8\u7684\u5956\u52b1\u3002\u8bb8\u591a\u6bd4\u8d5b\u8fd8\u5e26\u6709\u76f8\u5173\u7684\u53ef\u9009\u4fee\u6b63\u5668\uff0c\u4f8b\u5982 \"\u6f02\u79fb\u5956\u52b1\" \u6216\u5176\u4ed6\u7279\u6b8a\u6761\u4ef6\u3002\u4f5c\u4e3a\u7ecf\u9a8c\u4e30\u5bcc\u7684\u8d5b\u8f66\u624b\uff0c\u5c1d\u8bd5\u53c2\u52a0\"\u4e13\u4e1a\u8d5b\u9053\"\u4ee5\u83b7\u5f97\u66f4\u5927\u5956\u52b1\u3002"}, {"question": "\u6781\u901f\u8d5b\u8f663D\uff1a\u5982\u4f55\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\uff08\u4f8b\u5982Android\u548ciOS\uff09\u8f6c\u79fb\u6211\u7684\u6e38\u620f\u8fdb\u5ea6\uff1f", "answer": "\u5728\u4e0d\u540c\u8bbe\u5907\uff08\u4f8b\u5982 Android \u548c iOS\uff09\u4e4b\u95f4\u8f6c\u79fb\u6e38\u620f\u8fdb\u5ea6\u53d6\u51b3\u4e8e\u6e38\u620f\u7684\u5907\u4efd\u9009\u9879\u3002\u5927\u591a\u6570\u60c5\u51b5\u4e0b\uff0c\u5b83\u4f1a\u4fdd\u5b58\u5230\u4e91\u7aef\u3002\u6b65\u9aa41 - \u68c0\u67e5\u4e91\u7aef\u4fdd\u5b58\uff1a\u5728\u6e38\u620f\u8bbe\u7f6e\u4e2d\u67e5\u627e\"\u4e91\u7aef\u4fdd\u5b58\"\u3001\"\u8d26\u6237\u540c\u6b65\"\u6216\u7c7b\u4f3c\u9009\u9879\u3002\u6b65\u9aa42 - \u8d26\u53f7\u94fe\u63a5\uff1a\u5982\u679c\u53ef\u7528\uff0c\u8bf7\u5c06\u60a8\u7684\u6e38\u620f\u8fdb\u5ea6\u94fe\u63a5\u5230\u793e\u4ea4\u5a92\u4f53\u5e10\u6237\uff08\u4f8b\u5982\uff0cFacebook\u3001Google Play\uff09\u6216\u4e13\u7528\u7684\u6e38\u620f\u5e10\u6237\u3002\u6b65\u9aa43 - \u5e73\u53f0\u8de8\u8d8a\u53ef\u7528\u6027\uff1a\u68c0\u67e5\u540c\u6b65\u529f\u80fd\u662f\u5426\u652f\u6301\u8de8\u5e73\u53f0\u3002\u67d0\u4e9b\u540c\u6b65\u529f\u80fd\u4ec5\u5728\u540c\u4e00\u64cd\u4f5c\u7cfb\u7edf\u7c7b\u578b\u5185\u5de5\u4f5c\u3002\u5728\u8bb8\u591a\u60c5\u51b5\u4e0b\uff0c\u9700\u8981\u624b\u52a8\u6fc0\u6d3b\u4e91\u7aef\u4fdd\u5b58\u3002\u5728\u5207\u6362\u8bbe\u5907\u4e4b\u524d\uff0c\u52a1\u5fc5\u5148\u6267\u884c\u6b64\u64cd\u4f5c\uff0c\u56e0\u4e3a\u6e38\u620f\u4e0d\u4f1a\u81ea\u52a8\u5c06\u6570\u636e\u4fdd\u5b58\u5230\u5176\u4e2d\u3002"}, {"question": "\u6e38\u620f\u4e2d\u4e0d\u540c\u7684\u5c5e\u6027\u70b9\uff0c\u4f8b\u5982\"\u64cd\u63a7\"\u548c\"\u52a0\u901f\"\uff0c\u5728\u6781\u901f\u8d5b\u8f663D\u4e2d\u8d77\u4ec0\u4e48\u4f5c\u7528\uff1f", "answer": "\u6781\u901f\u8d5b\u8f663D\u4e2d\u7684\u6bcf\u4e2a\u5c5e\u6027\u90fd\u76f4\u63a5\u5f71\u54cd\u6c7d\u8f66\u6027\u80fd\u3002\u64cd\u63a7\u6027\u51b3\u5b9a\u4e86\u6c7d\u8f66\u7684\u8fc7\u5f2f\u80fd\u529b\uff0c\u6216\u8005\u8bf4\u5728\u4e0d\u635f\u5931\u901f\u5ea6\u7684\u60c5\u51b5\u4e0b\uff0c\u60a8\u53ef\u4ee5\u8f7b\u677e\u5730\u8f6c\u5f2f\u3002\u52a0\u901f\u63a7\u5236\u7740\u6c7d\u8f66\u8fbe\u5230\u6700\u9ad8\u901f\u5ea6\u7684\u901f\u5ea6\u3002\u901f\u5ea6\u662f\u60a8\u53ef\u4ee5\u8fbe\u5230\u7684\u6700\u5927\u901f\u5ea6\uff0c\u6c2e\u6c14\u52a0\u901f\u63a7\u5236\u7740\u60a8\u53ef\u4ee5\u6301\u7eed\u6309\u4e0b\u52a0\u901f\u5668\u7684\u6301\u7eed\u65f6\u95f4\u3002\u64cd\u63a7\u6027\u9ad8\u7684\u6c7d\u8f66\u5728\u8d5b\u9053\u4e0a\u8868\u73b0\u51fa\u8272\uff0c\u4f46\u901f\u5ea6\u8f83\u6162\u7684\u6c7d\u8f66\u5728\u62e5\u6709\u826f\u597d\u7684\u6c2e\u6c14\u52a0\u901f\u5347\u7ea7\u7684\u60c5\u51b5\u4e0b\u5c06\u8868\u73b0\u51fa\u8272\u3002\u5982\u679c\u60a8\u662f\u65b0\u624b\uff0c\u64cd\u63a7\u6027\u5c24\u5176\u6709\u7528\u3002"}, {"question": "\u6781\u901f\u8d5b\u8f663D\uff1a\u662f\u5426\u6709\u529e\u6cd5\u89e3\u9501\u5177\u6709\u72ec\u7279\u5c5e\u6027\u52a0\u6210\u7684\u7279\u6b8a\u6c7d\u8f66\u76ae\u80a4\u6216\u81ea\u5b9a\u4e49\u5185\u5bb9\uff1f\uff08\u6210\u5c31\u730e\u4eba\uff09", "answer": "\u6781\u901f\u8d5b\u8f663D\u901a\u5e38\u5305\u542b\u53ef\u4ee5\u901a\u8fc7\u6210\u5c31\u3001\u5b8c\u6210\u6311\u6218\u6216\u7279\u6b8a\u6e38\u620f\u4e8b\u4ef6\u89e3\u9501\u7684\u7279\u6b8a\u6c7d\u8f66\u76ae\u80a4\u6216\u81ea\u5b9a\u4e49\u5185\u5bb9\u3002\u8fd9\u4e9b\u72ec\u7279\u7684\u88c5\u9970\u901a\u5e38\u5177\u6709\u5c5e\u6027\u52a0\u6210\u3002\u57fa\u4e8e\u6210\u5c31\u7684\u89e3\u9501\u901a\u5e38\u9700\u8981\u5728\u6bd4\u8d5b\u4e2d\u5b8c\u6210\u7279\u5b9a\u4efb\u52a1\uff08\u4f8b\u5982\uff0c\u5728\u4e00\u5b9a\u8ddd\u79bb\u5185\u6f02\u79fb\u3001\u4f7f\u7528\u7279\u5b9a\u6c7d\u8f66\u83b7\u80dc\uff09\u3002\u8bf7\u7559\u610f\u6e38\u620f\u4e2d\u7684\u6301\u7eed\u6e38\u620f\u6d3b\u52a8\uff0c\u8fd9\u4e9b\u6d3b\u52a8\u63d0\u4f9b\u8d85\u51fa\u4ec5\u4ec5\u662f\u7f8e\u89c2\u5347\u7ea7\u7684\u72ec\u5bb6\u5956\u52b1\u3002\u67d0\u4e9b\u76ae\u80a4\u53ef\u80fd\u6dfb\u52a0\"\u6293\u5730\u529b\"\u52a0\u6210\u6216\u7c7b\u4f3c\u52a0\u6210\u3002\u68c0\u67e5\u6e38\u620f\u6210\u5c31\u4ee5\u83b7\u53d6\u5217\u8868\uff01"}, {"question": "\u4e3a\u4ec0\u4e48\u6781\u901f\u8d5b\u8f663D\u7684\u8fc7\u573a\u52a8\u753b\u6709\u65f6\u4f1a\u8df3\u8fc7\uff0c\u4ee5\u53ca\u8981\u89e3\u9501\u4ec0\u4e48\u5b9e\u9645\u6545\u4e8b\uff1f", "answer": "\u5982\u679c\u6e38\u620f\u6587\u4ef6\u635f\u574f\uff0c\u6e38\u620f\u5b58\u5728\u9519\u8bef\uff0c\u6216\u8005\u60a8\u70b9\u51fb\u4e86\u8df3\u8fc7\u952e\uff0c\u6781\u901f\u8d5b\u8f663D\u4e2d\u7684\u6545\u4e8b\u8fc7\u573a\u52a8\u753b\u53ef\u80fd\u4f1a\u8df3\u8fc7\u3002\u4f46\u662f\uff0c\u6545\u4e8b\u4e5f\u53ef\u4ee5\u901a\u8fc7\u6587\u5b57\u5bf9\u8bdd\u548c\u4e0e NPC \u5bf9\u8bdd\u6765\u5c55\u73b0\u3002\u8d5b\u8f66\u8fc7\u573a\u52a8\u753b\u53ef\u4ee5\u89e3\u9501\u591a\u4e2a\u6545\u4e8b\u73af\u8282\uff0c\u5e76\u4e14\u901a\u5e38\u5305\u542b\u9690\u85cf\u7684\u4fe1\u606f\u3002\u8fd9\u53ef\u80fd\u5305\u62ec\u8d5b\u8f66\u624b\u8d44\u6599\u3001\u80cc\u666f\u6545\u4e8b\u6216\u79d8\u5bc6\u8d5b\u9053\u3002\u8bf7\u68c0\u67e5\u6e38\u620f\u8bbe\u7f6e\u548c\u5728\u7ebf\u6e38\u620f\u6307\u5357\u4ee5\u83b7\u53d6\u8be6\u7ec6\u4fe1\u606f\u3002"}]
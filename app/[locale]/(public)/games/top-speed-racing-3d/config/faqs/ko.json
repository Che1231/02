[{"question": "Top Speed Racing 3D: \ucd08\ubcf4 \ud50c\ub808\uc774\uc5b4\ub85c\uc11c \uac00\uc18d \ubc0f \uc81c\ub3d9\uacfc \uac19\uc740 \uae30\ubcf8 \ub3d9\uc791\uc740 \uc5b4\ub5bb\uac8c \uc218\ud589\ud569\ub2c8\uae4c?", "answer": "Top Speed Racing 3D\ub97c \ucc98\uc74c \uc2dc\uc791\ud558\ub294 \ucd08\ubcf4 \ud50c\ub808\uc774\uc5b4\ub77c\uba74, \uac00\uc18d\uc740 \ud654\uba74\uc758 \uac00\uc18d \ud398\ub2ec\uc744 \ud0ed\ud558\uc5ec \uc77c\ubc18\uc801\uc73c\ub85c \uc218\ud589\ub429\ub2c8\ub2e4. \uc81c\ub3d9 \uc5ed\uc2dc \ube0c\ub808\uc774\ud06c \ud398\ub2ec\uc744 \ud0ed\ud558\uc5ec \uc218\ud589\ub429\ub2c8\ub2e4. \ub2e4\ub978 \uc81c\uc5b4 \ubc29\uc2dd\uc740 \uc124\uc815\uc5d0\uc11c \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub354\uc6b1 \ubab0\uc785\uc801\uc778 \uacbd\ud5d8\uc744 \uc704\ud574 '\ud2f8\ud2b8 \ud22c \uc2a4\ud2f0\uc5b4'\ub97c \uc2dc\ub3c4\ud558\uac70\ub098 \ubc84\ud2bc\uc744 \uc0ac\uc6a9\uc790 \uc9c0\uc815\ud574 \ubcfc \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. \uc5f0\uc2b5 \ud2b8\ub799\ubd80\ud130 \uc2dc\uc791\ud558\uc5ec \uacbd\uc8fc\uc5d0 \ub300\ud55c \uc790\uc2e0\uac10\uc744 \uac00\uc9c4 \ud6c4\uc5d0 \uc870\uc791 \uac10\ub3c4\ub97c \uc870\uc815\ud558\uc5ec \uc81c\uc5b4\ub97c \uac1c\uc120\ud558\uace0 \uc18d\ub3c4 \uc190\uc2e4\uc744 \uc904\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2dc\uc791 \ub2e8\uacc4\uc5d0\uc11c \uacbd\uae30\uc7a5 \uac00\uc7a5\uc790\ub9ac \ucda9\ub3cc\uacfc \uac19\uc740 \ubd88\ud544\uc694\ud55c \ucda9\ub3cc\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \uc2a4\ud2f0\uc5b4\ub9c1\uc744 \uc62c\ubc14\ub974\uac8c \uc870\uc791\ud558\ub294 \uac83\uc744 \uae30\uc5b5\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \"\ub3c4\uc2dc \ub808\uc774\uc2a4\" \ub808\ubca8\uc744 \ud559\uc2b5\uc6a9 \uc2dc\uc791 \uc9c0\uc810\uc73c\ub85c \uc0ac\uc6a9\ud574 \ubcf4\uc138\uc694."}, {"question": "Top Speed Racing 3D\uc5d0\uc11c \ub808\uc774\uc2f1 \uc131\ub2a5\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \ucd08\ubc18 \uac8c\uc784\uc5d0\uc11c \uc9d1\uc911\ud574\uc57c \ud560 \ucd5c\uace0\uc758 \ucc28\ub7c9 \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Top Speed Racing 3D\uc758 \ucd08\ubc18 \uac8c\uc784 \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0 \uc9d1\uc911\ud558\ub294 \uac83\uc740 \uc5d4\uc9c4\uacfc \ud0c0\uc774\uc5b4\uc785\ub2c8\ub2e4. \uc5d4\uc9c4 \uc131\ub2a5 \uac1c\uc120\uc740 \uc18d\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4. \uc5c5\uadf8\ub808\uc774\ub4dc\ub41c \ud0c0\uc774\uc5b4\ub294 \ub354 \ub098\uc740 \ud578\ub4e4\ub9c1\uc744 \uc81c\uacf5\ud558\uc5ec \ud68c\uc804 \uc548\uc815\uc131\uacfc \uadf8\ub9bd\uc744 \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4. \ucc98\uc74c\uc5d0\ub294 \uc2dc\uac01\uc801 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \ud53c\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 1 - \uc5d4\uc9c4 \uc5c5\uadf8\ub808\uc774\ub4dc: \ucd5c\uace0 \uc18d\ub3c4\uc640 \uac00\uc18d\uc744 \ub192\uc774\uae30 \uc704\ud574 '\uc5d4\uc9c4' \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \uc9c4\ud589\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2 - \ud0c0\uc774\uc5b4 \uc5c5\uadf8\ub808\uc774\ub4dc: \ud5a5\uc0c1\ub41c \ud578\ub4e4\ub9c1\uacfc \ucf54\ub108\ub9c1\uc744 \uc704\ud574 '\ud0c0\uc774\uc5b4'\uc5d0 \uc9d1\uc911\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3 - \uc5c5\uadf8\ub808\uc774\ub4dc \uade0\ud615: \ucd5c\uc801\uc758 \uc131\ub2a5\uc744 \uc704\ud574 \uc5d4\uc9c4\uacfc \ud0c0\uc774\uc5b4 \uc5c5\uadf8\ub808\uc774\ub4dc \uc0ac\uc774\uc758 \uade0\ud615\uc744 \uc720\uc9c0\ud569\ub2c8\ub2e4. \uc774\ub807\uac8c \ud558\uba74 \uad00\ub9ac\ud560 \uc218 \uc5c6\ub294 \uc5c4\uccad\ub09c \ucd9c\ub825\uc744 \uac16\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc11c\ub85c \ub2e4\ub978 \ucc28\ub7c9\uc744 \ud655\uc778\ud558\uc5ec \uc5c5\uadf8\ub808\uc774\ub4dc \ube44\uc6a9 \ub300\ube44 \uae30\ubcf8 \ud1b5\uacc4\ub97c \uc774\ud574\ud569\ub2c8\ub2e4."}, {"question": "Top Speed Racing 3D\uc5d0\uc11c \uc0c1\ub300\ubc29\ubcf4\ub2e4 \uc774\uc810\uc744 \uc5bb\uae30 \uc704\ud574 \ub2c8\ud2b8\ub85c \ubd80\uc2a4\ud2b8\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\uae30 \uc704\ud55c \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Top Speed Racing 3D\uc5d0\uc11c \ub2c8\ud2b8\ub85c \ubd80\uc2a4\ud2b8\ub294 \uc0c1\ub300\ubc29\uc744 \ucd94\uc6d4\ud558\uace0 \uc18d\ub3c4\ub97c \uc720\uc9c0\ud558\ub294 \ub370 \uc911\uc694\ud569\ub2c8\ub2e4. \uc804\ub7b5\uc740 \uc9c1\uc120 \uad6c\uac04\uc5d0\uc11c \ub2c8\ud2b8\ub85c \ubd80\uc2a4\ud2b8\ub97c \ud604\uba85\ud558\uac8c \uc0ac\uc6a9\ud558\uace0 \ucf54\ub108\uc5d0\uc11c \uc0ac\uc6a9\uc744 \ud53c\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc808\uc57d\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1 - \uc9c1\uc120 \uad6c\uac04: \uc18d\ub3c4\uac00 \ucd5c\uc801\ud654\ub41c \uacbd\uae30\uc7a5\uc758 \uc9c1\uc120 \uad6c\uac04\uc5d0\uc11c \ubd80\uc2a4\ud2b8\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2 - \ucf54\ub108 \ud68c\ud53c: \uc881\uc740 \ucf54\ub108\ub9c1 \uad6c\uac04\uc5d0\uc11c \ubd80\uc2a4\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc9c0 \uc54a\uace0 \ucf54\ub108\ub97c \uc548\uc804\ud558\uac8c \ud1b5\uacfc\ud569\ub2c8\ub2e4. \uc774\uac83\uc740 \uc885\uc885 \uacfc\ub3c4\ud55c \uc2a4\ud2f0\uc5b4\ub9c1\uc73c\ub85c \uc774\uc5b4\uc838 \ub2c8\ud2b8\ub85c\uac00 \ub0ad\ube44\ub429\ub2c8\ub2e4. \ub2e8\uacc4 3 - \uc0c1\ub300 \ucc28\ub7c9 \ucc28\ub2e8: \uc0c1\ub300\ubc29\uc774 \ub2f9\uc2e0\uc744 \ucd94\uc6d4\ud558\ub824\ub294 \uacbd\uc6b0 \uc9e7\uc740 \ubd80\uc2a4\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc5ec \ucc28\ub2e8\ud569\ub2c8\ub2e4. \uccb4\uc2a4 \uac8c\uc784\ucc98\ub7fc \uc0dd\uac01\ud558\uc138\uc694 - \ub2c8\ud2b8\ub85c \ubd80\uc2a4\ud2b8\ub294 \ub2f9\uc2e0\uc758 \uae30\uc0ac\uc785\ub2c8\ub2e4! \uc608\ub97c \ub4e4\uc5b4, \ub7a8\ud504 \uc55e\uc5d0\uc11c \uc9e7\uc740 \ubd80\uc2a4\ud2b8\ub97c \uc0ac\uc6a9\ud558\uba74 \uacbd\uc8fc \uc911\uc5d0 \uc57d\uac04\uc758 \uac70\ub9ac\ub97c \ud655\ubcf4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Top Speed Racing 3D\uc5d0\uc11c \uc65c \uac8c\uc784\uc774 \uc911\uae09 \uae30\uae30\uc5d0\uc11c \uc9c0\uc5f0\ub418\uace0 \uadf8\ub798\ud53d \uc624\ub958\uac00 \ubc1c\uc0dd\ud558\uba70 \uc774 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud55c \ub2e8\uacc4\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Top Speed Racing 3D\ub97c \uc911\uae09 \uae30\uae30\uc5d0\uc11c \ud50c\ub808\uc774\ud560 \ub54c \uc9c0\uc5f0 \ubc0f \uadf8\ub798\ud53d \uc624\ub958\ub294 \uc77c\ubc18\uc801\uc73c\ub85c \uace0\uae09 \uadf8\ub798\ud53d \uc124\uc815 \ub54c\ubb38\uc785\ub2c8\ub2e4. \ud574\uacb0 \ubc29\ubc95\uc740 \uc124\uc815\uc744 \ub0ae\ucd94\ub294 \uac83\uc785\ub2c8\ub2e4. \ub2e8\uacc4 1 - \uadf8\ub798\ud53d \ud488\uc9c8 \uac10\uc18c: \uc124\uc815\uc5d0\uc11c '\uadf8\ub798\ud53d \ud488\uc9c8'\uc744 '\uc911' \ub610\ub294 '\uc800'\ub85c \uc904\uc785\ub2c8\ub2e4. \ub2e8\uacc4 2 - \ud2b9\uc218 \ud6a8\uacfc \ud574\uc81c: '\ubaa8\uc158 \ube14\ub7ec', '\ubc18\uc0ac', '\uadf8\ub9bc\uc790' \ub4f1\uc758 \ud6a8\uacfc\ub97c \ud574\uc81c\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3 - \ubc31\uadf8\ub77c\uc6b4\ub4dc \uc571 \ub2eb\uae30: \ubc31\uadf8\ub77c\uc6b4\ub4dc\uc5d0\uc11c \uc2e4\ud589 \uc911\uc778 \uc571\uc744 \ub2eb\uc544 RAM\uc744 \ud655\ubcf4\ud569\ub2c8\ub2e4. '\uac8c\uc784 \ubd80\uc2a4\ud130' \uc571\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc9c0\ub9cc \uc8fc\uc758\ud558\uc2ed\uc2dc\uc624. \ud2b9\uc815 \uae30\uae30\uc758 \uacbd\uc6b0 \uac8c\uc784\uc774 \uc77c\ubd80 \uc624\ub798\ub418\uac70\ub098 \ub35c \uc77c\ubc18\uc801\uc778 \ubaa8\ub378\uc5d0 \ucd5c\uc801\ud654\ub418\uc9c0 \uc54a\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Top Speed Racing 3D\uc5d0\uc11c \uc11c\ub85c \ub2e4\ub978 \ucc28\uc885\uc740 \uc5b4\ub5a4 \uc758\ubbf8\uac00 \uc788\uc73c\uba70, \uc65c \ub2e4\ub978 \ucc28\uc885\uc744 \uc120\ud0dd\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "Top Speed Racing 3D\uc5d0\uc11c \uc11c\ub85c \ub2e4\ub978 \ucc28\uc885\uc740 \ub2e4\uc591\ud55c \ub808\uc774\uc2f1 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\ucdb0\uc838 \uc788\uc73c\uba70, \uac01 \ucc28\ub7c9\uc740 \ub2e4\ub978 \uc601\uc5ed\uc5d0\uc11c \ub6f0\uc5b4\ub0a9\ub2c8\ub2e4. \uc2a4\ud3ec\uce20\uce74\ub294 \uc18d\ub3c4\uc640 \ud578\ub4e4\ub9c1\uc744 \uc911\uc2dc\ud558\uba70, \ubba4\uc9c1\uce74\ub294 \ucd9c\ub825\uacfc \ub4dc\ub9ac\ud504\ud2b8\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ucd5c\uace0\uc758 \uc120\ud0dd\uc740 \ub808\uc774\uc2f1 \uc2a4\ud0c0\uc77c\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. \uc2a4\ud3ec\uce20\uce74\ub294 \uc881\uc740 \ucf54\ub108\uac00 \ub9ce\uc740 \ud2b8\ub799\uc5d0\uc11c \ube5b\ub098\uace0, \ubba4\uc9c1\uce74\ub294 \uc9c1\uc120 \uad6c\uac04\uc5d0\uc11c \uc8fc\ub3c4\ud569\ub2c8\ub2e4. \ucd08\ubcf4 \ub808\uc774\uc11c\uc5d0\uac8c \uc88b\uc740 \ucc28\ub7c9\uc740 \uade0\ud615 \uc7a1\ud78c \ub808\uc774\uc2f1 \uc2a4\ud0c0\uc77c\uc744 \uc81c\uacf5\ud558\ub294 '\ud638\ub77c\uc774\uc98c GT'\uc785\ub2c8\ub2e4."}, {"question": "Top Speed Racing 3D\uc5d0\uc11c \uacbd\uc8fc \ubcf4\uc0c1\uc740 \uc5b4\ub5bb\uac8c \uacb0\uc815\ub418\uba70, \uac01 \uacbd\uc8fc \ud6c4\uc5d0 \ubc1b\ub294 \uac8c\uc784 \ub0b4 \ud1b5\ud654\ub7c9\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uad6c\uccb4\uc801\uc778 \uc694\uc778\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Top Speed Racing 3D\uc5d0\uc11c \uacbd\uc8fc \ubcf4\uc0c1\uc740 \uc5ec\ub7ec \uc8fc\uc694 \uc694\uc778\uc5d0 \ub530\ub77c \uacb0\uc815\ub429\ub2c8\ub2e4. \uc8fc\ub85c \uacbd\uc8fc\uc758 \ub09c\uc774\ub3c4, \ub2f9\uc2e0\uc758 \uc21c\uc704, \uadf8\ub9ac\uace0 \ud2b9\uc815 \ubcf4\ub108\uc2a4 \uc218\uc815\uc790\uc758 \uc0ac\uc6a9\uc785\ub2c8\ub2e4. \uacbd\uc8fc\uc758 \ub09c\uc774\ub3c4\uac00 \ub192\uc744\uc218\ub85d \ub354 \ud070 \ubcf4\uc0c1\uc744 \uc5bb\uc9c0\ub9cc, \uc5c5\uadf8\ub808\uc774\ub4dc\uc640 \uae30\uc220\uc5d0 \ub300\ud55c \uc694\uad6c \uc0ac\ud56d\ub3c4 \ub192\uc544\uc9d1\ub2c8\ub2e4. \uacbd\uc8fc\uc5d0\uc11c 1\ub4f1\uc744 \ud558\uba74 \ucd5c\uace0\uc758 \ubcf4\uc0c1\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \ub9ce\uc740 \uacbd\uc8fc\uc5d0\ub294 '\ub4dc\ub9ac\ud504\ud2b8 \ubcf4\ub108\uc2a4'\uc640 \uac19\uc740 \ucd94\uac00\uc801\uc778 \ud2b9\ubcc4 \uc870\uac74\uacfc \uad00\ub828\ub41c \uc120\ud0dd\uc801 \uc218\uc815\uc790\ub3c4 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc219\ub828\ub41c \ub808\uc774\uc11c\ub85c\uc11c \ub354 \ud070 \ubcf4\uc0c1\uc744 \ubc1b\uc73c\ub824\uba74 '\ud504\ub85c \uc11c\ud0b7'\uc5d0\uc11c \uacbd\uc8fc\ud574 \ubcf4\uc138\uc694."}, {"question": "Top Speed Racing 3D: \ub2e4\ub978 \uae30\uae30(\uc608: \uc548\ub4dc\ub85c\uc774\ub4dc\uc640 iOS) \uac04\uc5d0 \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc548\ub4dc\ub85c\uc774\ub4dc\uc640 iOS\uc640 \uac19\uc740 \ub2e4\ub978 \uae30\uae30 \uac04\uc5d0 \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub294 \uac83\uc740 \uac8c\uc784\uc758 \ub370\uc774\ud130 \ubc31\uc5c5 \uc635\uc158\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. \ub300\ubd80\ubd84\uc740 \ud074\ub77c\uc6b0\ub4dc\uc5d0 \uc800\uc7a5\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1 - \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \ud655\uc778: \uac8c\uc784 \uc124\uc815 \ub0b4\uc5d0\uc11c '\ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5', '\uacc4\uc815 \ub3d9\uae30\ud654' \ub610\ub294 \uc720\uc0ac\ud55c \uc635\uc158\uc744 \ucc3e\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 2 - \uacc4\uc815 \uc5f0\uacb0: \uc0ac\uc6a9 \uac00\ub2a5\ud55c \uacbd\uc6b0 \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc18c\uc15c \ubbf8\ub514\uc5b4 \uacc4\uc815(\uc608: \ud398\uc774\uc2a4\ubd81, \uad6c\uae00 \ud50c\ub808\uc774) \ub610\ub294 \uc804\uc6a9 \uac8c\uc784 \uacc4\uc815\uc5d0 \uc5f0\uacb0\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3 - \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \uc0ac\uc6a9 \uac00\ub2a5 \uc5ec\ubd80: \ub3d9\uae30\ud654 \uae30\ub2a5\uc774 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc0ac\uc6a9 \uac00\ub2a5\ud55c\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. \uc77c\ubd80 \ub3d9\uae30\ud654 \uae30\ub2a5\uc740 \ub3d9\uc77c\ud55c \uc6b4\uc601 \uccb4\uc81c \uc720\ud615 \ub0b4\uc5d0\uc11c\ub9cc \uc791\ub3d9\ud569\ub2c8\ub2e4. \ub300\ubd80\ubd84\uc758 \uacbd\uc6b0, \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc740 \uc218\ub3d9\uc73c\ub85c \ud65c\uc131\ud654\ud574\uc57c \ud569\ub2c8\ub2e4. \uae30\uae30\ub97c \uc804\ud658\ud558\uae30 \uc804\uc5d0 \uc774 \uc791\uc5c5\uc744 \uc218\ud589\ud574\uc57c \ud569\ub2c8\ub2e4. \uac8c\uc784\uc740 \uc790\ub3d9\uc73c\ub85c \ub370\uc774\ud130\ub97c \ud574\ub2f9 \uae30\uae30\uc5d0 \uc800\uc7a5\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."}, {"question": "'\ud578\ub4e4\ub9c1'\uacfc '\uac00\uc18d'\uacfc \uac19\uc740 \uc11c\ub85c \ub2e4\ub978 \ud1b5\uacc4 \uc810\uc218\ub294 Top Speed Racing 3D \uac8c\uc784\uc5d0\uc11c \uc5b4\ub5a4 \uc5ed\ud560\uc744 \ud569\ub2c8\uae4c?", "answer": "Top Speed Racing 3D\uc758 \uac01 \ud1b5\uacc4\ub294 \ucc28\ub7c9 \uc131\ub2a5\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ud578\ub4e4\ub9c1\uc740 \ucc28\ub7c9\uc758 \ucf54\ub108\ub9c1 \ub2a5\ub825, \uc989 \uc18d\ub3c4\ub97c \uc783\uc9c0 \uc54a\uace0 \ucf54\ub108\ub97c \ub3cc \uc218 \uc788\ub294 \uc815\ub3c4\ub97c \ub098\ud0c0\ub0c5\ub2c8\ub2e4. \uac00\uc18d\uc740 \ucc28\ub7c9\uc774 \ucd5c\uace0 \uc18d\ub3c4\uc5d0 \ub3c4\ub2ec\ud558\ub294 \uc18d\ub3c4\ub97c \uc81c\uc5b4\ud569\ub2c8\ub2e4. \uc18d\ub3c4\ub294 \ub3c4\ub2ec\ud560 \uc218 \uc788\ub294 \ucd5c\ub300 \uc18d\ub3c4\uc774\uace0, \ub2c8\ud2b8\ub85c\ub294 \ubd80\uc2a4\ud130\ub97c \ub204\ub97c \uc218 \uc788\ub294 \uc2dc\uac04\uc744 \uc81c\uc5b4\ud569\ub2c8\ub2e4. \ud578\ub4e4\ub9c1\uc774 \ub192\uc740 \ucc28\ub7c9\uc740 \ud2b8\ub799\uc5d0\uc11c \ud0c1\uc6d4\ud558\uc9c0\ub9cc, \ub290\ub9b0 \ucc28\ub7c9\uc740 \uc88b\uc740 \ub2c8\ud2b8\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ub85c \ub9e4\uc6b0 \uc798 \uc218\ud589\ub420 \uac83\uc785\ub2c8\ub2e4. \uc219\ub828\ub418\uc9c0 \uc54a\uc558\ub2e4\uba74 \ud578\ub4e4\ub9c1\uc740 \ud2b9\ud788 \uc720\uc6a9\ud569\ub2c8\ub2e4."}, {"question": "Top Speed Racing 3D\uc5d0\uc11c \ud2b9\ubcc4\ud55c \ucc28\ub7c9 \uc2a4\ud0a8 \ub610\ub294 \uace0\uc720\ud55c \ud1b5\uacc4 \ubcf4\ub108\uc2a4\ub97c \uac00\uc9c4 \ub9de\ucda4 \uc124\uc815\uc744 \uc5b4\ub5bb\uac8c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c? (\uc5c5\uc801 \ud5cc\ud130)", "answer": "Top Speed Racing 3D\uc5d0\ub294 \uc885\uc885 \uc5c5\uc801, \ucc4c\ub9b0\uc9c0 \uc644\ub8cc \ub610\ub294 \ud2b9\ubcc4 \uac8c\uc784 \uc774\ubca4\ud2b8\ub97c \ud1b5\ud574 \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\ub294 \ud2b9\ubcc4\ud55c \ucc28\ub7c9 \uc2a4\ud0a8 \ub610\ub294 \ub9de\ucda4 \uc124\uc815\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uace0\uc720\ud55c \ubbf8\uc801 \uc694\uc18c\uc5d0\ub294 \uc885\uc885 \ud1b5\uacc4 \ubcf4\ub108\uc2a4\uac00 \uc81c\uacf5\ub429\ub2c8\ub2e4. \uc5c5\uc801 \uae30\ubc18 \uc7a0\uae08 \ud574\uc81c\uc5d0\ub294 \uc77c\ubc18\uc801\uc73c\ub85c \uacbd\uc8fc\uc5d0\uc11c \ud2b9\uc815 \uc5c5\uc801\uc744 \uc218\ud589\ud574\uc57c \ud569\ub2c8\ub2e4(\uc608: \ud2b9\uc815 \uac70\ub9ac\ub97c \ub4dc\ub9ac\ud504\ud2b8\ud558\uac70\ub098 \ud2b9\uc815 \ucc28\ub7c9\uc73c\ub85c \uc6b0\uc2b9\ud558\uae30). \uac8c\uc784\uc5d0\uc11c \ud2b9\ubcc4\ud55c \ubbf8\uc801 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \ub118\uc5b4 \ub3c5\uc810 \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud558\ub294 \uc9c4\ud589 \uc911\uc778 \uac8c\uc784 \uc774\ubca4\ud2b8\ub97c \ucc3e\uc544\ubcf4\uc138\uc694. \ud2b9\uc815 \uc2a4\ud0a8\uc740 '\uadf8\ub9bd' \ubcf4\ub108\uc2a4 \ub4f1\uc744 \ucd94\uac00\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784 \uc5c5\uc801\uc744 \ud655\uc778\ud558\uc5ec \ubaa9\ub85d\uc744 \ud655\uc778\ud558\uc138\uc694!"}, {"question": "Top Speed Racing 3D\uc5d0\uc11c '\ucef7\uc2e0'\uc774 \ub54c\ub54c\ub85c \uac74\ub108\ub6f0\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5a4 '\uc774\uc57c\uae30'\ub97c \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\uae4c?", "answer": "Top Speed Racing 3D\uc758 \uc774\uc57c\uae30 \ucef7\uc2e0\uc774 \uac74\ub108\ub6f8 \uc218 \uc788\ub294 \uc774\uc720\ub294 \uac8c\uc784 \ud30c\uc77c\uc774 \uc190\uc0c1\ub418\uc5c8\uac70\ub098 \uac8c\uc784 \ubc84\uadf8\uac00 \uc788\uac70\ub098 \uac74\ub108\ub6f0\uae30\ub97c \ub204\ub978 \uacbd\uc6b0\uc785\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \uc774\uc57c\uae30\ub294 \ud14d\uc2a4\ud2b8 \uae30\ubc18 \ub300\ud654\ub97c \ud1b5\ud574 \ubcf4\uc5ec\uc9c0\uace0 NPC\uc5d0\uac8c \ub9d0\uc744 \uac78\uba74\uc11c \ubcf4\uc5ec\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub808\uc774\uc2f1 \ucef7\uc2e0\uc740 \uc5ec\ub7ec \uac00\uc9c0 \uc774\uc57c\uae30 \uc870\uac01\uc744 \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc73c\uba70, \uc77c\ubc18\uc801\uc73c\ub85c \uc228\uaca8\uc9c4 \uc815\ubcf4\ub97c \ud3ec\ud568\ud569\ub2c8\ub2e4. \uc5ec\uae30\uc5d0\ub294 \ub808\uc774\uc11c \ud504\ub85c\ud544, \ubc30\uacbd \uc774\uc57c\uae30 \ub610\ub294 \ube44\ubc00 \ub808\uc774\uc2f1 \ud2b8\ub799\uc774 \ud3ec\ud568\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc790\uc138\ud55c \ub0b4\uc6a9\uc740 \uac8c\uc784 \uc124\uc815 \ubc0f \uc628\ub77c\uc778 \ud50c\ub808\uc774\uc5b4 \uac00\uc774\ub4dc\ub97c \ucc38\uc870\ud558\uc138\uc694."}]
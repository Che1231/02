[{"question": "\ucd08\ubcf4\uc790\ub85c\uc11c Brutal.io\uc5d0\uc11c \uc5b4\ub5bb\uac8c \ud6a8\uacfc\uc801\uc73c\ub85c \uc774\ub3d9\ud558\uace0 \uacf5\uaca9\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Brutal.io\uc5d0\uc11c \uc774\ub3d9\uacfc \uacf5\uaca9\uc740 \ub9c8\uc6b0\uc2a4\ub85c \uc81c\uc5b4\ub429\ub2c8\ub2e4. \uc774\ub3d9\ud558\ub824\uba74 \uc6d0\ud558\ub294 \ubc29\ud5a5\uc73c\ub85c \ucee4\uc11c\ub97c \uac00\ub9ac\ud0a4\uae30\ub9cc \ud558\uba74 \uce90\ub9ad\ud130\uac00 \ub530\ub77c\uac11\ub2c8\ub2e4. \uacf5\uaca9\ud558\ub824\uba74 \uc67c\ucabd \ub9c8\uc6b0\uc2a4 \ubc84\ud2bc\uc744 \ud074\ub9ad\ud558\uc5ec \ucee4\uc11c \ubc29\ud5a5\uc73c\ub85c \ubb34\uae30\ub97c \ud718\ub450\ub985\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc624\ub978\ucabd\uc5d0 \uc788\ub294 \uc801\uc744 \uacf5\uaca9\ud558\ub824\uba74 \ucee4\uc11c\ub97c \uc624\ub978\ucabd\uc73c\ub85c \uc6c0\uc9c1\uc774\uace0 \ud074\ub9ad\ud558\uba74 \ub429\ub2c8\ub2e4. \ucd08\ubc18 \ub2e8\uacc4\uc5d0\uc11c \uc774\ub7ec\ud55c \uae30\ubcf8 \uc81c\uc5b4\ub97c \uc5f0\uc2b5\ud558\uc5ec \uc775\uc219\ud574\uc9c0\uc2ed\uc2dc\uc624. \uae30\uc5b5\ud574\uc57c \ud560 \uc810\uc740 \uc704\uce58 \uc120\uc815\uc774 \uc911\uc694\ud558\ub2e4\ub294 \uac83\uc785\ub2c8\ub2e4. \uc801\uc744 \uacf5\uaca9\ud558\uba74\uc11c \uc801\uc758 \uacf5\uaca9\uc744 \ud53c\ud558\uae30 \uc704\ud574 \ubb34\uae30 \uc0ac\uac70\ub9ac \uac00\uc7a5\uc790\ub9ac\uc5d0 \uba38\ubb34\ub974\ub824\uace0 \ud558\uc2ed\uc2dc\uc624."}, {"question": "Brutal.io\uc5d0\uc11c \ub354 \uc624\ub798 \uc0b4\uc544\ub0a8\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Brutal.io\uc5d0\uc11c \ub354 \uc624\ub798 \uc0b4\uc544\ub0a8\uc73c\ub824\uba74 \uc2e0\uc911\ud568\uacfc \uacf5\uaca9\uc131\uc758 \uc870\ud569\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \ud56d\uc0c1 \uc8fc\ubcc0 \ud658\uacbd\uc744 \ud30c\uc545\ud558\uc2ed\uc2dc\uc624. \ubbf8\ub2c8\ub9f5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc801\uc744 \ubc1c\uacac\ud558\uace0 \ud3ec\uc704\ub418\ub294 \uac83\uc744 \ud53c\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \uc810\uc218\ub97c \ub192\uc774\uace0 \ud30c\uc6cc\uc5c5\ud558\uae30 \uc704\ud574 \uc57d\ud558\uac70\ub098 \uace0\ub9bd\ub41c \uc801\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uacf5\uaca9\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \ud658\uacbd\uc744 \ud65c\uc6a9\ud558\uc5ec \uc7a5\uc560\ubb3c \ub4a4\uc5d0 \uc228\uac70\ub098 \uc801\uc744 \ud568\uc815\uc73c\ub85c \uc720\uc778\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ud50c\ub808\uc774\uc5b4 \uadf8\ub8f9\uc774 \uc2f8\uc6b0\ub294 \uac83\uc744 \ubcf8\ub2e4\uba74 \uc11c\ub85c \uc57d\ud654\ub420 \ub54c\uae4c\uc9c0 \uae30\ub2e4\ub838\ub2e4\uac00 \ucc38\uc5ec\ud558\uc2ed\uc2dc\uc624. \uc774 \uc804\ub7b5\uc740 \uc0dd\uba85\ub825\uc744 \uc808\uc57d\ud558\uba74\uc11c \uc810\uc218\ub97c \uadf9\ub300\ud654\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "Brutal.io\uc5d0\uc11c \ub54c\ub54c\ub85c \uce90\ub9ad\ud130\uac00 \ub290\ub9ac\uac8c \ub290\uaef4\uc9c0\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Brutal.io\uc5d0\uc11c \uce90\ub9ad\ud130\uc758 \uc18d\ub3c4\ub294 \uc810\uc218\uc640 \ubb34\uae30 \ud06c\uae30\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4. \uc810\uc218\uac00 \ub192\uc544\uc9c0\uba74 \uce90\ub9ad\ud130\uac00 \ucee4\uc838\uc11c \uc774\ub3d9\uc774 \ub290\ub9ac\uac8c \ub290\uaef4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \ub9dd\uce58\ub098 \ub3c4\ub07c\uc640 \uac19\uc740 \ubb34\uac70\uc6b4 \ubb34\uae30\ub294 \uac80\uacfc \uac19\uc740 \uac00\ubcbc\uc6b4 \ubb34\uae30\uc5d0 \ube44\ud574 \uc18d\ub3c4\ub97c \ub2a6\ucd9c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub9dd\uce58\ub97c \ud68d\ub4dd\ud558\uba74 \uc18d\ub3c4\uac00 \uc57d\uac04 \uac10\uc18c\ud558\ub294 \uac83\uc744 \uc54c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub97c \uc0c1\uc1c4\ud558\ub824\uba74 \ubb34\uae30\ub97c \uc804\ub7b5\uc801\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uace0 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\uc9c0 \uc54a\ub294 \uc544\uc774\ud15c\uc744 \ud53c\ud558\uc2ed\uc2dc\uc624."}, {"question": "Brutal.io\uc5d0\uc11c \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ubb34\uae30\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Brutal.io\uc5d0\uc11c \uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \uc885\uc885 \uc18d\ub3c4, \uc0ac\uac70\ub9ac \ubc0f \ud53c\ud574\ub97c \uade0\ud615 \uc788\uac8c \uc720\uc9c0\ud558\ub294 \ubb34\uae30\ub97c \uc120\ud638\ud569\ub2c8\ub2e4. \uac80\uc740 \ube60\ub978 \uacf5\uaca9\uacfc \uc801\uc808\ud55c \uc0ac\uac70\ub9ac\ub85c \uc778\ud574 \ub300\ubd80\ubd84\uc758 \uc0c1\ud669\uc5d0\uc11c \ub2e4\uc7ac\ub2e4\ub2a5\ud55c \uc778\uae30 \uc120\ud0dd\uc785\ub2c8\ub2e4. \ub9dd\uce58\ub294 \ub290\ub9ac\uc9c0\ub9cc \uac15\ub825\ud55c \ud53c\ud574\ub97c \uc785\ud788\uace0 \uc57d\ud55c \uc801\uc744 \ud55c \ubc29\uc5d0 \uc81c\uac70\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub9dd\uce58\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud50c\ub808\uc774\uc5b4 \uadf8\ub8f9\uc744 \uae30\uc2b5\ud558\ub294 \uac83\uc740 \ub9e4\uc6b0 \ud6a8\uacfc\uc801\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\ub978 \ubb34\uae30\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \uc801\ud569\ud55c \ubb34\uae30\ub97c \ucc3e\uc73c\uc2ed\uc2dc\uc624."}, {"question": "Brutal.io\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \uc810\uc218\ub97c \uadf9\ub300\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Brutal.io\uc5d0\uc11c \uc810\uc218\ub294 \uc801\uc744 \ubb3c\ub9ac\uce58\uace0 \uada4\uc801\uc744 \uc218\uc9d1\ud558\uc5ec \uc99d\uac00\ud569\ub2c8\ub2e4. \uac01 \uc801\uc744 \ucc98\uce58\ud560 \ub54c\ub9c8\ub2e4 \uc810\uc218\uac00 \uc99d\uac00\ud558\uace0, \ub9f5 \uacf3\uacf3\uc5d0 \ud769\uc5b4\uc838 \uc788\ub294 \uada4\uc801\uc740 \ucd94\uac00 \uc810\uc218\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc810\uc218\ub97c \uadf9\ub300\ud654\ud558\ub824\uba74 \uc5f0\uc774\uc5b4 \uc5ec\ub7ec \uc801\uc744 \ubb3c\ub9ac\uce58\ub294 \ub370 \uc9d1\uc911\ud558\ub294 \uac83\uc774 \uc911\uc694\ud558\uba70, \uc774\ub807\uac8c \ud558\uba74 \ucf64\ubcf4 \ubc30\uc218\uac00 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5f0\uc18d\ud574\uc11c \uc138 \uba85\uc758 \uc801\uc744 \ucc98\uce58\ud558\uba74 \uc810\uc218\uac00 \ud06c\uac8c \uc99d\uac00\ud569\ub2c8\ub2e4. \ub610\ud55c, \ud2b9\ud788 \ucd08\ubc18\uc5d0 \uada4\uc801\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uc218\uc9d1\ud558\uc5ec \uc810\uc218\ub97c \uc704\ud55c \uac15\ub825\ud55c \uae30\ubc18\uc744 \uad6c\ucd95\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ubaa8\ub4e0 \ud50c\ub808\uc774\uc5b4\uac00 \uc774\ud574\ud574\uc57c \ud558\ub294 Brutal.io\uc758 \uc8fc\uc694 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Brutal.io\ub294 \uc774\ub3d9, \uc804\ud22c \ubc0f \uc131\uc7a5\uc774\ub77c\ub294 \uc138 \uac00\uc9c0 \ud575\uc2ec \uba54\ucee4\ub2c8\uc998\uc744 \uc911\uc2ec\uc73c\ub85c \ud569\ub2c8\ub2e4. \uc774\ub3d9\uc740 \ub9c8\uc6b0\uc2a4\ub85c \uc81c\uc5b4\ub418\uba70, \uce90\ub9ad\ud130\ub294 \ucee4\uc11c\ub97c \ub530\ub985\ub2c8\ub2e4. \uc804\ud22c\ub294 \ucee4\uc11c \ubc29\ud5a5\uc73c\ub85c \ubb34\uae30\ub97c \ud718\ub450\ub974\uba74\uc11c \uc801\uc744 \uacf5\uaca9\ud569\ub2c8\ub2e4. \uc810\uc218\uac00 \ub192\uc544\uc9d0\uc5d0 \ub530\ub77c \uce90\ub9ad\ud130\uac00 \ucee4\uc9c0\uace0 \uac15\ub825\ud574\uc9c0\ubbc0\ub85c \uc131\uc7a5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc131\uc7a5\ud568\uc5d0 \ub530\ub77c \ubb34\uae30\uc758 \uc0ac\uac70\ub9ac\uc640 \ud53c\ud574\ub3c4 \uc99d\uac00\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \uac8c\uc784\uc744 \ub9c8\uc2a4\ud130\ud558\uace0 \ub2e4\uc591\ud55c \uc0c1\ud669\uc5d0 \uc801\uc751\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4."}, {"question": "Brutal.io\uc5d0\uc11c \uce90\ub9ad\ud130 \ud06c\uae30\uac00 \uac8c\uc784\ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "Brutal.io\uc5d0\uc11c \uce90\ub9ad\ud130\uc758 \ud06c\uae30\ub294 \uc18d\ub3c4, \ubb34\uae30 \uc0ac\uac70\ub9ac \ubc0f \uc2dc\uc57c\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc810\uc218\uac00 \ub192\uc544\uc9c0\uba74 \uce90\ub9ad\ud130\uac00 \ucee4\uc9c0\uba74\uc11c \uc774\ub3d9 \uc18d\ub3c4\uac00 \ub290\ub824\uc9c0\uc9c0\ub9cc \ubb34\uae30 \uc0ac\uac70\ub9ac\uc640 \ud53c\ud574\ub294 \ub298\uc5b4\ub0a9\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud070 \uce90\ub9ad\ud130\ub294 \uc7a5\uac70\ub9ac\uc5d0\uc11c \uc801\uc744 \uacf5\uaca9\ud560 \uc218 \uc788\uc9c0\ub9cc \uacf5\uaca9\uc744 \ud53c\ud558\uae30 \uc5b4\ub824\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc131\uc7a5\uacfc \uc804\ub7b5\uc801 \uc704\uce58 \uc120\uc815\uc758 \uade0\ud615\uc744 \ub9de\ucd94\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \ud655\uc7a5\ub41c \uc0ac\uac70\ub9ac\ub97c \ud65c\uc6a9\ud558\uc5ec \uc804\ud22c\ub97c \uc9c0\ubc30\ud558\uba74\uc11c \ub3d9\uc2dc\uc5d0 \uc81c\ud55c\ub41c \uc774\ub3d9\uc131\uc744 \uc778\uc9c0\ud558\uc2ed\uc2dc\uc624."}, {"question": "Brutal.io\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\ub978 \uae30\uae30\ub85c \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud604\uc7ac Brutal.io\ub294 \ud50c\ub7ab\ud3fc \uac04 \uc9c4\ud589 \uc0c1\ud669 \uc774\uc804\uc744 \uc9c0\uc6d0\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uac8c\uc784 \ub370\uc774\ud130\ub294 \ud50c\ub808\uc774\ud558\ub294 \uae30\uae30\uc758 \ub85c\uceec\uc5d0 \uc800\uc7a5\ub418\ubbc0\ub85c \ud55c \uae30\uae30\uc5d0\uc11c\uc758 \uc9c4\ud589 \uc0c1\ud669\uc740 \ub2e4\ub978 \uae30\uae30\ub85c \uc774\uc804\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ud50c\ub808\uc774\ud55c \ud6c4 \ubaa8\ubc14\uc77c \uae30\uae30\ub85c \uc804\ud658\ud558\uba74 \ucc98\uc74c\ubd80\ud130 \uc2dc\uc791\ud574\uc57c \ud569\ub2c8\ub2e4. \uc9c4\ud589 \uc0c1\ud669\uc744 \uc783\uc9c0 \uc54a\uc73c\ub824\uba74 \ub2e8\uc77c \uae30\uae30\ub97c \uc0ac\uc6a9\ud558\uac70\ub098 \uac00\ub2a5\ud55c \ud55c \ub85c\uceec \ub370\uc774\ud130\ub97c \ubc31\uc5c5\ud558\uc138\uc694."}, {"question": "Brutal.io\uc5d0\ub294 \uc228\uaca8\uc9c4 \uba54\ucee4\ub2c8\uc998\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Brutal.io\uc5d0\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uba54\ucee4\ub2c8\uc998\uc774 \uc788\uc5b4\uc11c \uc720\ub9ac\ud558\uac8c \ud65c\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud2b9\uc815 \ubb34\uae30\uc5d0\ub294 \uace0\uc720\ud55c \ud2b9\uc131\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ub9dd\uce58\ub294 \uc801\uc744 \uae30\uc808\uc2dc\ud0ac \uc218 \uc788\uc73c\uba70, \uac80\uc740 \uacf5\uaca9 \uc18d\ub3c4\uac00 \ub354 \ube60\ub985\ub2c8\ub2e4. \ub610\ud55c, \uc77c\ubd80 \ub9f5 \uc601\uc5ed\uc5d0\ub294 \ubc1c\uacac\ud558\uae30 \uc5b4\ub824\uc6b4 \uc228\uaca8\uc9c4 \uada4\uc801\uc774 \uc788\uc73c\ub098 \uc0c1\ub2f9\ud55c \uc810\uc218 \uc99d\uac00\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub9f5\uc744 \ucca0\uc800\ud788 \ud0d0\ud5d8\ud558\uace0 \ub2e4\uc591\ud55c \ubb34\uae30\ub97c \uc2e4\ud5d8\ud558\uba74 \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uc694\uc18c\ub97c \ubc1c\uacac\ud558\uace0 \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Brutal.io\uc5d0\uc11c \uc5ec\ub7ec \uc801\uc744 \ucc98\ub9ac\ud558\ub294 \ucd5c\uc120\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Brutal.io\uc5d0\uc11c \uc5ec\ub7ec \uc801\uc744 \ucc98\ub9ac\ud558\ub824\uba74 \uc704\uce58 \uc120\uc815\uacfc \ud0c0\uc774\ubc0d\uc758 \uc870\ud569\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \ud3ec\uc704\ub2f9\ud558\uc9c0 \uc54a\ub3c4\ub85d \uacc4\uc18d \uc774\ub3d9\ud558\uc2ed\uc2dc\uc624. \ubbf8\ub2c8\ub9f5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc801\uc758 \uc704\uce58\ub97c \ud30c\uc545\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \uc704\ud611\uc744 \uc904\uc774\uae30 \uc704\ud574 \uc57d\ud55c \uc801\uc744 \uba3c\uc800 \ucc98\ub9ac\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \ubb34\uae30\uc758 \uc0ac\uac70\ub9ac\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub3d9\uc2dc\uc5d0 \uc5ec\ub7ec \uc801\uc744 \ud0c0\uaca9\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uac80\uc73c\ub85c\ub294 \uc5ec\ub7ec \uc801\uc5d0\uac8c \ub3d9\uc2dc\uc5d0 \ud53c\ud574\ub97c \uc904 \uc218 \uc788\ub3c4\ub85d \uc6d0\uc744 \uadf8\ub9ac\ub4ef\uc774 \ud718\ub450\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc811\uadfc \ubc29\uc2dd\uc740 \uc555\ub3c4\ub2f9\ud560 \uc704\ud5d8\uc744 \uc904\uc774\uace0 \uc0b4\uc544\ub0a8\uc744 \uac00\ub2a5\uc131\uc744 \uadf9\ub300\ud654\ud569\ub2c8\ub2e4."}]
[{"question": "\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u5728Brutal.io\u4e2d\u6709\u6548\u5730\u79fb\u52a8\u548c\u653b\u51fb\uff1f", "answer": "\u5728Brutal.io\u4e2d\uff0c\u79fb\u52a8\u548c\u653b\u51fb\u90fd\u7531\u9f20\u6807\u63a7\u5236\u3002\u8981\u79fb\u52a8\uff0c\u53ea\u9700\u5c06\u9f20\u6807\u5149\u6807\u6307\u5411\u6240\u9700\u65b9\u5411\uff0c\u60a8\u7684\u89d2\u8272\u5c31\u4f1a\u8ddf\u968f\u3002\u8981\u653b\u51fb\uff0c\u8bf7\u70b9\u51fb\u9f20\u6807\u5de6\u952e\uff0c\u6b66\u5668\u5c06\u671d\u7740\u5149\u6807\u7684\u65b9\u5411\u6325\u821e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u60f3\u653b\u51fb\u53f3\u8fb9\u7684\u654c\u4eba\uff0c\u8bf7\u5c06\u9f20\u6807\u5149\u6807\u79fb\u5230\u53f3\u8fb9\u5e76\u70b9\u51fb\u3002\u5728\u6e38\u620f\u521d\u671f\u7ec3\u4e60\u8fd9\u4e9b\u57fa\u672c\u64cd\u4f5c\uff0c\u4f7f\u81ea\u5df1\u719f\u6089\u5b83\u4eec\u3002\u8bb0\u4f4f\uff0c\u4f4d\u7f6e\u81f3\u5173\u91cd\u8981\u2014\u2014\u5c3d\u91cf\u4fdd\u6301\u5728\u6b66\u5668\u653b\u51fb\u8303\u56f4\u8fb9\u7f18\uff0c\u4ee5\u51fb\u4e2d\u654c\u4eba\u5e76\u907f\u514d\u53d7\u5230\u653b\u51fb\u3002"}, {"question": "\u5728Brutal.io\u4e2d\u751f\u5b58\u66f4\u957f\u65f6\u95f4\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728Brutal.io\u4e2d\u751f\u5b58\u66f4\u957f\u65f6\u95f4\u9700\u8981\u8c28\u614e\u548c\u4fb5\u7565\u76f8\u7ed3\u5408\u3002\u6b65\u9aa4\u4e00\uff1a\u65f6\u523b\u6ce8\u610f\u5468\u56f4\u73af\u5883\u3002\u4f7f\u7528\u8ff7\u4f60\u5730\u56fe\u53d1\u73b0\u654c\u4eba\u5e76\u907f\u514d\u88ab\u5305\u56f4\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f18\u5148\u653b\u51fb\u8f83\u5f31\u6216\u5b64\u7acb\u7684\u654c\u4eba\uff0c\u4ee5\u63d0\u5347\u5206\u6570\u548c\u63d0\u5347\u5b9e\u529b\u3002\u6b65\u9aa4\u4e09\uff1a\u5229\u7528\u73af\u5883\u4f18\u52bf\u2014\u2014\u8eb2\u5728\u969c\u788d\u7269\u540e\u9762\u6216\u5f15\u8bf1\u654c\u4eba\u8fdb\u5165\u9677\u9631\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u770b\u5230\u4e00\u7ec4\u73a9\u5bb6\u6b63\u5728\u6218\u6597\uff0c\u8bf7\u7b49\u5f85\u4ed6\u4eec\u76f8\u4e92\u524a\u5f31\u540e\u518d\u53c2\u4e0e\u6218\u6597\u3002\u8fd9\u79cd\u7b56\u7565\u6709\u52a9\u4e8e\u60a8\u8282\u7701\u751f\u547d\u503c\uff0c\u540c\u65f6\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u5206\u6570\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u7684\u89d2\u8272\u6709\u65f6\u5728Brutal.io\u4e2d\u611f\u89c9\u53d8\u6162\u4e86\uff1f", "answer": "Brutal.io\u4e2d\u89d2\u8272\u7684\u901f\u5ea6\u53d7\u5206\u6570\u548c\u6b66\u5668\u5927\u5c0f\u7684\u5f71\u54cd\u3002\u968f\u7740\u5206\u6570\u7684\u589e\u52a0\uff0c\u89d2\u8272\u4f1a\u53d8\u5f97\u66f4\u5927\uff0c\u8fd9\u53ef\u80fd\u4f1a\u4f7f\u79fb\u52a8\u611f\u89c9\u53d8\u6162\u3002\u6b64\u5916\uff0c\u50cf\u9524\u5b50\u6216\u65a7\u5934\u8fd9\u6837\u7684\u91cd\u578b\u6b66\u5668\u4e0e\u5251\u4e4b\u7c7b\u7684\u8f7b\u578b\u6b66\u5668\u76f8\u6bd4\u53ef\u80fd\u4f1a\u964d\u4f4e\u60a8\u7684\u79fb\u52a8\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u62ff\u8d77\u9524\u5b50\uff0c\u60a8\u4f1a\u6ce8\u610f\u5230\u901f\u5ea6\u7565\u6709\u964d\u4f4e\u3002\u4e3a\u4e86\u62b5\u6d88\u8fd9\u79cd\u60c5\u51b5\uff0c\u8bf7\u4e13\u6ce8\u4e8e\u6218\u7565\u6027\u5730\u5347\u7ea7\u6b66\u5668\uff0c\u907f\u514d\u62fe\u53d6\u4e0d\u9002\u5408\u60a8\u6e38\u620f\u98ce\u683c\u7684\u7269\u54c1\u3002"}, {"question": "\u5bf9\u4e8eBrutal.io\u4e2d\u7684\u9ad8\u7ea7\u73a9\u5bb6\u6765\u8bf4\uff0c\u54ea\u4e9b\u6b66\u5668\u6700\u6709\u6548\uff1f", "answer": "Brutal.io\u4e2d\u7684\u9ad8\u7ea7\u73a9\u5bb6\u901a\u5e38\u66f4\u559c\u6b22\u90a3\u4e9b\u5728\u901f\u5ea6\u3001\u5c04\u7a0b\u548c\u4f24\u5bb3\u65b9\u9762\u8fbe\u5230\u5e73\u8861\u7684\u6b66\u5668\u3002\u5251\u662f\u53d7\u6b22\u8fce\u7684\u9009\u62e9\uff0c\u56e0\u4e3a\u5b83\u5177\u6709\u5feb\u901f\u653b\u51fb\u548c\u4e0d\u9519\u7684\u5c04\u7a0b\uff0c\u4f7f\u5176\u5728\u5927\u591a\u6570\u60c5\u51b5\u4e0b\u90fd\u9002\u7528\u3002\u867d\u7136\u9524\u5b50\u6bd4\u8f83\u6162\uff0c\u4f46\u5b83\u9020\u6210\u7684\u4f24\u5bb3\u5de8\u5927\uff0c\u53ef\u4ee5\u4e00\u51fb\u51fb\u6740\u8f83\u5f31\u7684\u654c\u4eba\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u9524\u5b50\u4f0f\u51fb\u4e00\u7fa4\u73a9\u5bb6\u975e\u5e38\u6709\u6548\u3002\u5c1d\u8bd5\u4f7f\u7528\u4e0d\u540c\u7684\u6b66\u5668\uff0c\u627e\u5230\u4e0e\u60a8\u7684\u6e38\u620f\u98ce\u683c\u548c\u7b56\u7565\u76f8\u5339\u914d\u7684\u6b66\u5668\u3002"}, {"question": "Brutal.io\u4e2d\u7684\u5f97\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u5927\u5316\u6211\u7684\u5f97\u5206\uff1f", "answer": "\u5728Brutal.io\u4e2d\uff0c\u901a\u8fc7\u51fb\u8d25\u654c\u4eba\u548c\u6536\u96c6\u80fd\u91cf\u7403\u6765\u63d0\u9ad8\u5206\u6570\u3002\u6bcf\u6b21\u51fb\u6740\u654c\u4eba\u90fd\u4f1a\u589e\u52a0\u5206\u6570\uff0c\u5730\u56fe\u4e0a\u6563\u843d\u7684\u80fd\u91cf\u7403\u4f1a\u63d0\u4f9b\u989d\u5916\u5206\u6570\u3002\u4e3a\u4e86\u6700\u5927\u5316\u5206\u6570\uff0c\u8bf7\u96c6\u4e2d\u7cbe\u529b\u5feb\u901f\u8fde\u7eed\u51fb\u8d25\u591a\u4e2a\u654c\u4eba\uff0c\u8fd9\u53ef\u4ee5\u89e6\u53d1\u8fde\u51fb\u500d\u7387\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u8fde\u7eed\u51fb\u6740\u4e09\u4e2a\u654c\u4eba\uff0c\u60a8\u7684\u5206\u6570\u5c06\u4f1a\u663e\u8457\u589e\u52a0\u3002\u6b64\u5916\uff0c\u4f18\u5148\u6536\u96c6\u80fd\u91cf\u7403\uff0c\u5c24\u5176\u662f\u5728\u6e38\u620f\u521d\u671f\uff0c\u4e3a\u60a8\u7684\u5206\u6570\u5efa\u7acb\u575a\u5b9e\u7684\u57fa\u7840\u3002"}, {"question": "\u6bcf\u4e2a\u73a9\u5bb6\u90fd\u5e94\u8be5\u4e86\u89e3Brutal.io\u7684\u5173\u952e\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "Brutal.io\u56f4\u7ed5\u4e09\u4e2a\u6838\u5fc3\u673a\u5236\u5c55\u5f00\uff1a\u79fb\u52a8\u3001\u6218\u6597\u548c\u6210\u957f\u3002\u79fb\u52a8\u7531\u9f20\u6807\u63a7\u5236\uff0c\u60a8\u7684\u89d2\u8272\u4f1a\u8ddf\u968f\u9f20\u6807\u5149\u6807\u3002\u6218\u6597\u5305\u62ec\u671d\u7740\u9f20\u6807\u5149\u6807\u7684\u65b9\u5411\u6325\u821e\u6b66\u5668\u653b\u51fb\u654c\u4eba\u3002\u968f\u7740\u5206\u6570\u7684\u589e\u52a0\uff0c\u89d2\u8272\u4f1a\u53d8\u5f97\u66f4\u5927\u3001\u66f4\u5f3a\u5927\uff0c\u8fd9\u662f\u6210\u957f\u3002\u4f8b\u5982\uff0c\u968f\u7740\u89d2\u8272\u7684\u6210\u957f\uff0c\u6b66\u5668\u7684\u5c04\u7a0b\u548c\u4f24\u5bb3\u4e5f\u4f1a\u589e\u52a0\u3002\u7406\u89e3\u8fd9\u4e9b\u673a\u5236\u5bf9\u4e8e\u638c\u63e1\u6e38\u620f\u5e76\u9002\u5e94\u4e0d\u540c\u60c5\u51b5\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u6211\u7684\u89d2\u8272\u5927\u5c0f\u5982\u4f55\u5728Brutal.io\u4e2d\u5f71\u54cd\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "Brutal.io\u4e2d\u89d2\u8272\u7684\u5927\u5c0f\u76f4\u63a5\u5f71\u54cd\u60a8\u7684\u901f\u5ea6\u3001\u6b66\u5668\u5c04\u7a0b\u548c\u89c6\u91ce\u3002\u968f\u7740\u5206\u6570\u7684\u589e\u52a0\uff0c\u60a8\u7684\u89d2\u8272\u4f1a\u53d8\u5f97\u66f4\u5927\uff0c\u8fd9\u4f1a\u964d\u4f4e\u79fb\u52a8\u901f\u5ea6\uff0c\u4f46\u4f1a\u589e\u52a0\u6b66\u5668\u5c04\u7a0b\u548c\u4f24\u5bb3\u3002\u4f8b\u5982\uff0c\u4f53\u578b\u66f4\u5927\u7684\u89d2\u8272\u53ef\u4ee5\u4ece\u66f4\u8fdc\u7684\u5730\u65b9\u653b\u51fb\u654c\u4eba\uff0c\u4f46\u53ef\u80fd\u4f1a\u96be\u4ee5\u8eb2\u907f\u653b\u51fb\u3002\u5e73\u8861\u6210\u957f\u4e0e\u6218\u7565\u6027\u4f4d\u7f6e\u81f3\u5173\u91cd\u8981\u2014\u2014\u5229\u7528\u589e\u5f3a\u7684\u5c04\u7a0b\u6765\u638c\u63a7\u6218\u6597\uff0c\u540c\u65f6\u6ce8\u610f\u964d\u4f4e\u7684\u673a\u52a8\u6027\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5728\u4e0d\u540c\u7684\u8bbe\u5907\u4e4b\u95f4\u8f6c\u79fb\u6211\u7684Brutal.io\u8fdb\u5ea6\u5417\uff1f", "answer": "\u76ee\u524d\uff0cBrutal.io\u4e0d\u652f\u6301\u8de8\u5e73\u53f0\u8fdb\u5ea6\u8f6c\u79fb\u3002\u60a8\u7684\u6e38\u620f\u6570\u636e\u5b58\u50a8\u5728\u60a8\u6b63\u5728\u4f7f\u7528\u7684\u8bbe\u5907\u7684\u672c\u5730\uff0c\u8fd9\u610f\u5473\u7740\u5728\u4e00\u4e2a\u8bbe\u5907\u4e0a\u7684\u8fdb\u5ea6\u4e0d\u4f1a\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u8bbe\u5907\u4e0a\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728PC\u4e0a\u73a9\uff0c\u7136\u540e\u5207\u6362\u5230\u79fb\u52a8\u8bbe\u5907\uff0c\u60a8\u9700\u8981\u4ece\u5934\u5f00\u59cb\u3002\u4e3a\u4e86\u907f\u514d\u4e22\u5931\u8fdb\u5ea6\uff0c\u8bf7\u575a\u6301\u4f7f\u7528\u540c\u4e00\u8bbe\u5907\uff0c\u6216\u8005\u5982\u6709\u53ef\u80fd\uff0c\u786e\u4fdd\u60a8\u7684\u672c\u5730\u6570\u636e\u8fdb\u884c\u4e86\u5907\u4efd\u3002"}, {"question": "Brutal.io\u4e2d\u662f\u5426\u5b58\u5728\u4efb\u4f55\u9690\u85cf\u673a\u5236\u6216\u5f69\u86cb\uff1f", "answer": "Brutal.io\u4e2d\u6709\u4e00\u4e9b\u9690\u85cf\u673a\u5236\u53ef\u4ee5\u4e3a\u60a8\u63d0\u4f9b\u4f18\u52bf\u3002\u4f8b\u5982\uff0c\u67d0\u4e9b\u6b66\u5668\u5177\u6709\u72ec\u7279\u7684\u5c5e\u6027\u2014\u2014\u9524\u5b50\u53ef\u4ee5\u51fb\u6655\u654c\u4eba\uff0c\u800c\u5251\u5219\u5177\u6709\u66f4\u5feb\u7684\u653b\u51fb\u901f\u5ea6\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u5730\u56fe\u533a\u57df\u5305\u542b\u96be\u4ee5\u53d1\u73b0\u7684\u9690\u85cf\u80fd\u91cf\u7403\uff0c\u4f46\u4f1a\u63d0\u4f9b\u663e\u8457\u7684\u5206\u6570\u63d0\u5347\u3002\u5f7b\u5e95\u63a2\u7d22\u5730\u56fe\u5e76\u5c1d\u8bd5\u4f7f\u7528\u4e0d\u540c\u7684\u6b66\u5668\u53ef\u4ee5\u5e2e\u52a9\u60a8\u53d1\u73b0\u8fd9\u4e9b\u9690\u85cf\u5143\u7d20\u5e76\u83b7\u5f97\u4f18\u52bf\u3002"}, {"question": "\u5728Brutal.io\u4e2d\u5982\u4f55\u6700\u597d\u5730\u5904\u7406\u591a\u4e2a\u654c\u4eba\uff1f", "answer": "\u5728Brutal.io\u4e2d\u5904\u7406\u591a\u4e2a\u654c\u4eba\u9700\u8981\u4f4d\u7f6e\u548c\u65f6\u95f4\u7684\u7ed3\u5408\u3002\u6b65\u9aa4\u4e00\uff1a\u4fdd\u6301\u79fb\u52a8\uff0c\u907f\u514d\u88ab\u5305\u56f4\u3002\u4f7f\u7528\u8ff7\u4f60\u5730\u56fe\u8ffd\u8e2a\u654c\u4eba\u7684\u4f4d\u7f6e\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f18\u5148\u6d88\u706d\u8f83\u5f31\u7684\u654c\u4eba\uff0c\u4ee5\u51cf\u5c11\u5a01\u80c1\u6570\u91cf\u3002\u6b65\u9aa4\u4e09\uff1a\u4f7f\u7528\u6b66\u5668\u7684\u5c04\u7a0b\u4e00\u6b21\u653b\u51fb\u591a\u4e2a\u654c\u4eba\u3002\u4f8b\u5982\uff0c\u7528\u5251\uff0c\u60a8\u53ef\u4ee5\u6325\u821e\u5728\u4e00\u4e2a\u5f27\u5f62\u4e2d\uff0c\u540c\u65f6\u5bf9\u591a\u4e2a\u654c\u4eba\u9020\u6210\u4f24\u5bb3\u3002\u8fd9\u79cd\u65b9\u6cd5\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u4e86\u88ab\u538b\u5236\u7684\u673a\u4f1a\uff0c\u540c\u65f6\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u4e86\u751f\u5b58\u7684\u673a\u4f1a\u3002"}]
[{"question": "\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001Brutal.io\u3067\u52b9\u679c\u7684\u306b\u79fb\u52d5\u3057\u3066\u653b\u6483\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Brutal.io\u3067\u306f\u3001\u30de\u30a6\u30b9\u3067\u79fb\u52d5\u3068\u653b\u6483\u3092\u5236\u5fa1\u3057\u307e\u3059\u3002\u79fb\u52d5\u3059\u308b\u306b\u306f\u3001\u30de\u30a6\u30b9\u30ab\u30fc\u30bd\u30eb\u3092\u76ee\u7684\u306e\u65b9\u5411\u306b\u5408\u308f\u305b\u308b\u3068\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u305d\u308c\u306b\u5f93\u3044\u307e\u3059\u3002\u653b\u6483\u3059\u308b\u306b\u306f\u3001\u5de6\u306e\u30de\u30a6\u30b9\u30dc\u30bf\u30f3\u3092\u30af\u30ea\u30c3\u30af\u3059\u308b\u3068\u3001\u6b66\u5668\u304c\u30ab\u30fc\u30bd\u30eb\u306e\u65b9\u5411\u306b\u632f\u308a\u56de\u3055\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u53f3\u5074\u306e\u6575\u3092\u653b\u6483\u3057\u305f\u3044\u5834\u5408\u306f\u3001\u30ab\u30fc\u30bd\u30eb\u3092\u53f3\u306b\u79fb\u52d5\u3057\u3066\u30af\u30ea\u30c3\u30af\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u521d\u671f\u6bb5\u968e\u3067\u306f\u3001\u3053\u308c\u3089\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u7df4\u7fd2\u3057\u3066\u6163\u308c\u3066\u304f\u3060\u3055\u3044\u3002\u91cd\u8981\u306a\u306e\u306f\u3001\u6575\u3092\u653b\u6483\u3057\u306a\u304c\u3089\u81ea\u5206\u306e\u653b\u6483\u7bc4\u56f2\u306e\u7aef\u306b\u3068\u3069\u307e\u3063\u3066\u3001\u6575\u306e\u653b\u6483\u3092\u907f\u3051\u308b\u3053\u3068\u3067\u3059\u3002"}, {"question": "Brutal.io\u3067\u3088\u308a\u9577\u304f\u751f\u304d\u6b8b\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Brutal.io\u3067\u3088\u308a\u9577\u304f\u751f\u304d\u6b8b\u308b\u305f\u3081\u306b\u306f\u3001\u6ce8\u610f\u3068\u653b\u6483\u306e\u4e21\u65b9\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5e38\u306b\u5468\u56f2\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30df\u30cb\u30de\u30c3\u30d7\u3092\u4f7f\u3063\u3066\u6575\u3092\u767a\u898b\u3057\u3001\u5305\u56f2\u3055\u308c\u306a\u3044\u3088\u3046\u306b\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b9\u30b3\u30a2\u3092\u7a4d\u307f\u4e0a\u3052\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3059\u308b\u305f\u3081\u306b\u3001\u307e\u305a\u5f31\u3044\u307e\u305f\u306f\u5b64\u7acb\u3057\u305f\u6575\u306b\u96c6\u4e2d\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u74b0\u5883\u3092\u6709\u5229\u306b\u6d3b\u7528\u3057\u307e\u3057\u3087\u3046\u3002\u969c\u5bb3\u7269\u306e\u5f8c\u308d\u306b\u96a0\u308c\u305f\u308a\u3001\u6575\u3092\u7f60\u306b\u8a98\u5c0e\u3057\u305f\u308a\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u8907\u6570\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u6226\u3063\u3066\u3044\u308b\u306e\u3092\u898b\u305f\u3089\u3001\u4e92\u3044\u306b\u5f31\u3089\u305b\u308b\u306e\u3092\u5f85\u3063\u3066\u304b\u3089\u3001\u53c2\u52a0\u3057\u307e\u3057\u3087\u3046\u3002\u3053\u306e\u6226\u7565\u306f\u3001\u3042\u306a\u305f\u306e\u5065\u5eb7\u3092\u7dad\u6301\u3057\u306a\u304c\u3089\u3001\u3042\u306a\u305f\u306e\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u306a\u305c\u3001Brutal.io\u3067\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u6642\u3005\u9045\u304f\u611f\u3058\u308b\u306e\u3067\u3059\u304b\uff1f", "answer": "Brutal.io\u3067\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u901f\u5ea6\u306f\u3001\u3042\u306a\u305f\u306e\u30b9\u30b3\u30a2\u3068\u6b66\u5668\u306e\u30b5\u30a4\u30ba\u306b\u3088\u3063\u3066\u5f71\u97ff\u3055\u308c\u307e\u3059\u3002\u30b9\u30b3\u30a2\u304c\u5897\u52a0\u3059\u308b\u3068\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u5927\u304d\u304f\u306a\u308a\u3001\u79fb\u52d5\u304c\u9045\u304f\u611f\u3058\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30cf\u30f3\u30de\u30fc\u3084\u65a7\u306a\u3069\u306e\u91cd\u3044\u6b66\u5668\u306f\u3001\u5263\u306a\u3069\u306e\u8efd\u3044\u6b66\u5668\u306b\u6bd4\u3079\u3066\u901f\u5ea6\u304c\u9045\u304f\u306a\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30cf\u30f3\u30de\u30fc\u3092\u62fe\u3046\u3068\u3001\u308f\u305a\u304b\u306b\u901f\u5ea6\u304c\u4f4e\u4e0b\u3059\u308b\u3053\u3068\u306b\u6c17\u4ed8\u304f\u3067\u3057\u3087\u3046\u3002\u3053\u308c\u306b\u5bfe\u6297\u3059\u308b\u306b\u306f\u3001\u6b66\u5668\u3092\u6226\u7565\u7684\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u3001\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u5408\u308f\u306a\u3044\u30a2\u30a4\u30c6\u30e0\u3092\u62fe\u308f\u306a\u3044\u3088\u3046\u306b\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u3001Brutal.io\u3067\u6700\u3082\u52b9\u679c\u7684\u306a\u6b66\u5668\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Brutal.io\u306e\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u901a\u5e38\u3001\u901f\u5ea6\u3001\u5c04\u7a0b\u3001\u30c0\u30e1\u30fc\u30b8\u306e\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u6b66\u5668\u3092\u597d\u307f\u307e\u3059\u3002\u5263\u306f\u3001\u7d20\u65e9\u3044\u653b\u6483\u3068\u9069\u5207\u306a\u5c04\u7a0b\u3067\u3001\u307b\u3068\u3093\u3069\u306e\u72b6\u6cc1\u3067\u4e07\u80fd\u306a\u305f\u3081\u3001\u4eba\u6c17\u304c\u3042\u308a\u307e\u3059\u3002\u30cf\u30f3\u30de\u30fc\u306f\u3001\u901f\u5ea6\u304c\u9045\u304f\u306a\u308a\u307e\u3059\u304c\u3001\u5927\u304d\u306a\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u3001\u3088\u308a\u5f31\u3044\u6575\u3092\u4e00\u5ea6\u3067\u5012\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30cf\u30f3\u30de\u30fc\u3092\u4f7f\u3063\u3066\u8907\u6570\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u5947\u8972\u3059\u308b\u3053\u3068\u306f\u975e\u5e38\u306b\u52b9\u679c\u7684\u3067\u3059\u3002\u69d8\u3005\u306a\u6b66\u5668\u3092\u8a66\u3057\u3066\u3001\u3042\u306a\u305f\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u3068\u6226\u7565\u306b\u6700\u9069\u306a\u6b66\u5668\u3092\u898b\u3064\u3051\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "Brutal.io\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u3069\u306e\u3088\u3046\u306b\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Brutal.io\u3067\u306f\u3001\u6575\u3092\u5012\u3057\u305f\u308a\u30aa\u30fc\u30d6\u3092\u96c6\u3081\u305f\u308a\u3059\u308b\u3053\u3068\u3067\u3001\u30b9\u30b3\u30a2\u304c\u5897\u52a0\u3057\u307e\u3059\u3002\u5404\u6575\u3092\u5012\u3059\u305f\u3073\u306b\u3001\u30b9\u30b3\u30a2\u306b\u52a0\u7b97\u3055\u308c\u3001\u30de\u30c3\u30d7\u4e0a\u306b\u6563\u3089\u3070\u3063\u3066\u3044\u308b\u30aa\u30fc\u30d6\u306f\u8ffd\u52a0\u306e\u30dd\u30a4\u30f3\u30c8\u3092\u4e0e\u3048\u3066\u304f\u308c\u307e\u3059\u3002\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u8907\u6570\u306e\u6575\u3092\u6b21\u3005\u3068\u5012\u3059\u3053\u3068\u306b\u96c6\u4e2d\u3057\u3001\u3053\u308c\u306b\u3088\u308a\u30b3\u30f3\u30dc\u500d\u7387\u304c\u30c8\u30ea\u30ac\u30fc\u3055\u308c\u3001\u30b9\u30b3\u30a2\u304c\u5927\u5e45\u306b\u5897\u52a0\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\uff13\u9023\u7d9a\u3067\u6575\u3092\u5012\u3059\u3068\u3001\u30b9\u30b3\u30a2\u304c\u5927\u5e45\u306b\u5897\u52a0\u3057\u307e\u3059\u3002\u7279\u306b\u521d\u671f\u30b2\u30fc\u30e0\u3067\u306f\u3001\u30aa\u30fc\u30d6\u3092\u96c6\u3081\u308b\u3053\u3068\u3092\u512a\u5148\u3059\u308b\u3053\u3068\u3067\u3001\u30b9\u30b3\u30a2\u3092\u69cb\u7bc9\u3059\u308b\u305f\u3081\u306e\u5805\u5b9f\u306a\u571f\u53f0\u3092\u7bc9\u304f\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Brutal.io\u306e\u3001\u3059\u3079\u3066\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u7406\u89e3\u3059\
[{"question": "\u5982\u4f55\u624d\u80fd\u5728\u65b0\u624b\u968e\u6bb5\u6709\u6548\u5730\u5728Brutal.io\u4e2d\u79fb\u52d5\u548c\u653b\u64ca\uff1f", "answer": "\u5728Brutal.io\u4e2d\uff0c\u79fb\u52d5\u548c\u653b\u64ca\u7531\u6ed1\u9f20\u63a7\u5236\u3002\u8981\u79fb\u52d5\uff0c\u53ea\u9700\u5c07\u6e38\u6a19\u6307\u5411\u6240\u9700\u65b9\u5411\uff0c\u60a8\u7684\u89d2\u8272\u5c31\u6703\u8ddf\u96a8\u3002\u8981\u653b\u64ca\uff0c\u8acb\u9ede\u64ca\u6ed1\u9f20\u5de6\u9375\uff0c\u9019\u5c07\u4f7f\u60a8\u7684\u6b66\u5668\u671d\u5411\u6e38\u6a19\u7684\u65b9\u5411\u63ee\u821e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u60f3\u653b\u64ca\u60a8\u53f3\u908a\u7684\u6575\u4eba\uff0c\u8acb\u5c07\u6e38\u6a19\u79fb\u52d5\u5230\u53f3\u5074\u4e26\u9ede\u64ca\u3002\u5728\u904a\u6232\u521d\u671f\u7df4\u7fd2\u9019\u4e9b\u57fa\u672c\u63a7\u5236\uff0c\u4ee5\u4f7f\u60a8\u611f\u5230\u8212\u9069\u3002\u8acb\u8a18\u4f4f\uff0c\u4f4d\u7f6e\u81f3\u95dc\u91cd\u8981 - \u5617\u8a66\u505c\u7559\u5728\u6b66\u5668\u5c04\u7a0b\u908a\u7de3\uff0c\u4ee5\u64ca\u4e2d\u6575\u4eba\u4e26\u907f\u514d\u4ed6\u5011\u7684\u653b\u64ca\u3002"}, {"question": "\u5728Brutal.io\u4e2d\u751f\u5b58\u66f4\u9577\u6642\u9593\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728Brutal.io\u4e2d\u751f\u5b58\u66f4\u9577\u6642\u9593\u9700\u8981\u8b39\u614e\u548c\u4fb5\u7565\u6027\u7684\u7d50\u5408\u3002\u6b65\u9a5f1\uff1a\u59cb\u7d42\u6ce8\u610f\u60a8\u7684\u5468\u570d\u74b0\u5883\u3002\u4f7f\u7528\u8ff7\u4f60\u5730\u5716\u4f86\u767c\u73fe\u6575\u4eba\u4e26\u907f\u514d\u88ab\u5305\u570d\u3002\u6b65\u9a5f2\uff1a\u9996\u5148\u5c08\u6ce8\u65bc\u8f03\u5f31\u6216\u5b64\u7acb\u7684\u6575\u4eba\uff0c\u4ee5\u5efa\u7acb\u60a8\u7684\u5206\u6578\u4e26\u63d0\u5347\u80fd\u529b\u3002\u6b65\u9a5f3\uff1a\u5229\u7528\u74b0\u5883\u4f86\u512a\u52e2 - \u8eb2\u5728\u969c\u7919\u7269\u5f8c\u9762\u6216\u5f15\u8a98\u6575\u4eba\u9032\u5165\u9677\u9631\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u770b\u5230\u4e00\u7fa4\u73a9\u5bb6\u5728\u6230\u9b25\uff0c\u8acb\u7b49\u5f85\u4ed6\u5011\u4e92\u76f8\u524a\u5f31\uff0c\u7136\u5f8c\u518d\u53c3\u8207\u6230\u9b25\u3002\u9019\u7a2e\u7b56\u7565\u6709\u52a9\u65bc\u60a8\u4fdd\u7559\u751f\u547d\u503c\u4e26\u6700\u5927\u5316\u60a8\u7684\u5206\u6578\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u7684\u89d2\u8272\u6709\u6642\u5728Brutal.io\u4e2d\u611f\u89ba\u8f03\u6162\uff1f", "answer": "Brutal.io\u4e2d\u89d2\u8272\u7684\u901f\u5ea6\u53d7\u60a8\u7684\u5206\u6578\u548c\u6b66\u5668\u5927\u5c0f\u7684\u5f71\u97ff\u3002\u96a8\u8457\u60a8\u7684\u5206\u6578\u589e\u52a0\uff0c\u60a8\u7684\u89d2\u8272\u6703\u8b8a\u5927\uff0c\u9019\u53ef\u80fd\u6703\u4f7f\u79fb\u52d5\u611f\u89ba\u8f03\u6162\u3002\u6b64\u5916\uff0c\u91cd\u6b66\u5668\uff08\u4f8b\u5982\u9318\u5b50\u6216\u65a7\u982d\uff09\u8207\u8f15\u6b66\u5668\uff08\u4f8b\u5982\u528d\uff09\u76f8\u6bd4\uff0c\u53ef\u80fd\u6703\u4f7f\u60a8\u884c\u52d5\u8b8a\u6162\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u62ff\u8d77\u9318\u5b50\uff0c\u60a8\u6703\u6ce8\u610f\u5230\u901f\u5ea6\u7565\u6709\u964d\u4f4e\u3002\u70ba\u4e86\u89e3\u6c7a\u9019\u500b\u554f\u984c\uff0c\u8acb\u5c08\u6ce8\u65bc\u7b56\u7565\u6027\u5730\u5347\u7d1a\u60a8\u7684\u6b66\u5668\uff0c\u4e26\u907f\u514d\u64bf\u53d6\u4e0d\u9069\u5408\u60a8\u7684\u904a\u6232\u98a8\u683c\u7684\u7269\u54c1\u3002"}, {"question": "\u5728Brutal.io\u4e2d\uff0c\u54ea\u4e9b\u6b66\u5668\u6700\u9069\u5408\u9ad8\u7d1a\u73a9\u5bb6\uff1f", "answer": "Brutal.io\u4e2d\u7684\u9ad8\u7d1a\u73a9\u5bb6\u901a\u5e38\u66f4\u559c\u6b61\u5e73\u8861\u901f\u5ea6\u3001\u5c04\u7a0b\u548c\u50b7\u5bb3\u7684\u6b66\u5668\u3002\u528d\u662f\u6d41\u884c\u7684\u9078\u64c7\uff0c\u56e0\u70ba\u5b83\u5177\u6709\u5feb\u901f\u7684\u653b\u64ca\u548c\u4e0d\u932f\u7684\u5c04\u7a0b\uff0c\u4f7f\u5176\u5728\u5927\u591a\u6578\u60c5\u6cc1\u4e0b\u90fd\u591a\u529f\u80fd\u3002\u96d6\u7136\u9318\u5b50\u8f03\u6162\uff0c\u4f46\u5b83\u9020\u6210\u7684\u50b7\u5bb3\u5de8\u5927\uff0c\u53ef\u4ee5\u4e00\u64ca\u64ca\u6bba\u8f03\u5f31\u7684\u6575\u4eba\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u9318\u5b50\u4f0f\u64ca\u4e00\u7fa4\u73a9\u5bb6\u53ef\u80fd\u975e\u5e38\u6709\u6548\u3002\u5617\u8a66\u4e0d\u540c\u7684\u6b66\u5668\uff0c\u4ee5\u627e\u5230\u6700\u9069\u5408\u60a8\u7684\u904a\u6232\u98a8\u683c\u548c\u7b56\u7565\u7684\u6b66\u5668\u3002"}, {"question": "Brutal.io\u4e2d\u7684\u8a08\u5206\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u5927\u5316\u6211\u7684\u5206\u6578\uff1f", "answer": "\u5728Brutal.io\u4e2d\uff0c\u60a8\u7684\u5206\u6578\u6703\u901a\u904e\u64ca\u6557\u6575\u4eba\u548c\u6536\u96c6\u5bf6\u73e0\u4f86\u589e\u52a0\u3002\u60a8\u6bba\u6b7b\u7684\u6bcf\u500b\u6575\u4eba\u90fd\u6703\u589e\u52a0\u60a8\u7684\u5206\u6578\uff0c\u800c\u6563\u843d\u5728\u5730\u5716\u4e0a\u7684\u5bf6\u73e0\u6703\u63d0\u4f9b\u984d\u5916\u7684\u5206\u6578\u3002\u8981\u6700\u5927\u5316\u60a8\u7684\u5206\u6578\uff0c\u8acb\u5c08\u6ce8\u65bc\u5feb\u901f\u9023\u7e8c\u64ca\u6557\u591a\u500b\u6575\u4eba\uff0c\u56e0\u70ba\u9019\u53ef\u80fd\u6703\u89f8\u767c\u9023\u64ca\u500d\u6578\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u9023\u7e8c\u64ca\u6bba\u4e09\u500b\u6575\u4eba\uff0c\u60a8\u7684\u5206\u6578\u5c07\u986f\u8457\u589e\u52a0\u3002\u6b64\u5916\uff0c\u512a\u5148\u6536\u96c6\u5bf6\u73e0\uff0c\u5c24\u5176\u662f\u5728\u904a\u6232\u521d\u671f\uff0c\u4ee5\u5efa\u7acb\u60a8\u5206\u6578\u7684\u5805\u5be6\u57fa\u790e\u3002"}, {"question": "Brutal.io\u4e2d\u6bcf\u500b\u73a9\u5bb6\u90fd\u61c9\u8a72\u4e86\u89e3\u54ea\u4e9b\u95dc\u9375\u6a5f\u5236\uff1f", "answer": "Brutal.io\u570d\u7e5e\u4e09\u500b\u6838\u5fc3\u6a5f\u5236\u904b\u4f5c\uff1a\u79fb\u52d5\u3001\u6230\u9b25\u548c\u6210\u9577\u3002\u79fb\u52d5\u7531\u6ed1\u9f20\u63a7\u5236\uff0c\u60a8\u7684\u89d2\u8272\u6703\u8ddf\u96a8\u6e38\u6a19\u3002\u6230\u9b25\u5305\u62ec\u671d\u5411\u6e38\u6a19\u7684\u65b9\u5411\u63ee\u821e\u6b66\u5668\u653b\u64ca\u6575\u4eba\u3002\u96a8\u8457\u60a8\u7684\u5206\u6578\u589e\u52a0\uff0c\u60a8\u7684\u89d2\u8272\u6703\u8b8a\u5f97\u66f4\u5927\u3001\u66f4\u5f37\u5927\uff0c\u9019\u5c31\u662f\u6210\u9577\u3002\u4f8b\u5982\uff0c\u96a8\u8457\u60a8\u7684\u6210\u9577\uff0c\u6b66\u5668\u7684\u5c04\u7a0b\u548c\u50b7\u5bb3\u4e5f\u6703\u589e\u52a0\u3002\u4e86\u89e3\u9019\u4e9b\u6a5f\u5236\u5c0d\u65bc\u638c\u63e1\u904a\u6232\u4e26\u9069\u61c9\u4e0d\u540c\u60c5\u6cc1\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u6211\u7684\u89d2\u8272\u5927\u5c0f\u5982\u4f55\u5728Brutal.io\u4e2d\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff1f", "answer": "Brutal.io\u4e2d\u89d2\u8272\u7684\u5927\u5c0f\u6703\u76f4\u63a5\u5f71\u97ff\u60a8\u7684\u901f\u5ea6\u3001\u6b66\u5668\u5c04\u7a0b\u548c\u53ef\u898b\u5ea6\u3002\u96a8\u8457\u60a8\u7684\u5206\u6578\u589e\u52a0\uff0c\u60a8\u7684\u89d2\u8272\u6703\u8b8a\u5927\uff0c\u9019\u6703\u6e1b\u6162\u79fb\u52d5\u901f\u5ea6\uff0c\u4f46\u6703\u589e\u52a0\u6b66\u5668\u5c04\u7a0b\u548c\u50b7\u5bb3\u3002\u4f8b\u5982\uff0c\u8f03\u5927\u7684\u89d2\u8272\u53ef\u4ee5\u5f9e\u66f4\u9060\u7684\u8ddd\u96e2\u64ca\u4e2d\u6575\u4eba\uff0c\u4f46\u53ef\u80fd\u96e3\u4ee5\u8eb2\u907f\u653b\u64ca\u3002\u5e73\u8861\u6210\u9577\u8207\u7b56\u7565\u6027\u4f48\u7f6e\u81f3\u95dc\u91cd\u8981 - \u5229\u7528\u60a8\u589e\u52a0\u7684\u5c04\u7a0b\u4f86\u4e3b\u5c0e\u6230\u9b25\uff0c\u540c\u6642\u6ce8\u610f\u60a8\u7684\u884c\u52d5\u80fd\u529b\u964d\u4f4e\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5728\u4e0d\u540c\u7684\u8a2d\u5099\u4e4b\u9593\u8f49\u79fb\u6211\u7684Brutal.io\u9032\u5ea6\u55ce\uff1f", "answer": "\u76ee\u524d\uff0cBrutal.io \u4e0d\u652f\u63f4\u8de8\u5e73\u53f0\u9032\u5ea6\u8f49\u79fb\u3002\u60a8\u7684\u904a\u6232\u8cc7\u6599\u5132\u5b58\u5728\u60a8\u6b63\u5728\u4f7f\u7528\u7684\u88dd\u7f6e\u7684\u672c\u5730\u7aef\uff0c\u9019\u8868\u793a\u4e00\u500b\u88dd\u7f6e\u4e0a\u7684\u9032\u5ea6\u4e0d\u6703\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u88dd\u7f6e\u4e0a\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5728\u96fb\u8166\u4e0a\u73a9\u904a\u6232\uff0c\u7136\u5f8c\u5207\u63db\u5230\u884c\u52d5\u88dd\u7f6e\uff0c\u60a8\u9700\u8981\u5f9e\u982d\u958b\u59cb\u3002\u70ba\u907f\u514d\u5931\u53bb\u9032\u5ea6\uff0c\u8acb\u5805\u6301\u4f7f\u7528\u55ae\u4e00\u88dd\u7f6e\uff0c\u6216\u5982\u679c\u53ef\u80fd\uff0c\u8acb\u78ba\u4fdd\u5099\u4efd\u60a8\u7684\u672c\u5730\u8cc7\u6599\u3002"}, {"question": "Brutal.io\u4e2d\u6709\u4efb\u4f55\u96b1\u85cf\u7684\u6a5f\u5236\u6216\u5f69\u86cb\u55ce\uff1f", "answer": "Brutal.io\u6709\u4e00\u4e9b\u96b1\u85cf\u7684\u6a5f\u5236\u53ef\u4ee5\u8b93\u60a8\u8655\u65bc\u512a\u52e2\u5730\u4f4d\u3002\u4f8b\u5982\uff0c\u67d0\u4e9b\u6b66\u5668\u5177\u6709\u7368\u7279\u7684\u5c6c\u6027 - \u9318\u5b50\u53ef\u4ee5\u64ca\u6688\u6575\u4eba\uff0c\u800c\u528d\u5177\u6709\u66f4\u5feb\u7684\u653b\u64ca\u901f\u5ea6\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u5730\u5716\u5340\u57df\u5305\u542b\u96e3\u4ee5\u767c\u73fe\u4f46\u63d0\u4f9b\u986f\u8457\u5206\u6578\u63d0\u5347\u7684\u96b1\u85cf\u5bf6\u73e0\u3002\u5fb9\u5e95\u63a2\u7d22\u5730\u5716\u4e26\u5617\u8a66\u4e0d\u540c\u7684\u6b66\u5668\uff0c\u53ef\u4ee5\u5e6b\u52a9\u60a8\u767c\u73fe\u9019\u4e9b\u96b1\u85cf\u5143\u7d20\u4e26\u7372\u5f97\u512a\u52e2\u3002"}, {"question": "\u5728Brutal.io\u4e2d\u8655\u7406\u591a\u500b\u6575\u4eba\u7684\u6700\u4f73\u65b9\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728Brutal.io\u4e2d\u8655\u7406\u591a\u500b\u6575\u4eba\u9700\u8981\u4f4d\u7f6e\u548c\u6642\u9593\u7684\u7d50\u5408\u3002\u6b65\u9a5f1\uff1a\u4fdd\u6301\u79fb\u52d5\uff0c\u907f\u514d\u88ab\u5305\u570d\u3002\u4f7f\u7528\u8ff7\u4f60\u5730\u5716\u4f86\u8ffd\u8e64\u6575\u4eba\u7684\u4f4d\u7f6e\u3002\u6b65\u9a5f2\uff1a\u9996\u5148\u5c08\u6ce8\u65bc\u64ca\u6bba\u8f03\u5f31\u7684\u6575\u4eba\uff0c\u4ee5\u6e1b\u5c11\u5a01\u8105\u6578\u91cf\u3002\u6b65\u9a5f3\uff1a\u4f7f\u7528\u6b66\u5668\u7684\u5c04\u7a0b\u4e00\u6b21\u64ca\u4e2d\u591a\u500b\u6575\u4eba\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u528d\uff0c\u60a8\u53ef\u4ee5\u63ee\u821e\u6210\u5f27\u5f62\u4f86\u540c\u6642\u50b7\u5bb3\u591a\u500b\u6575\u4eba\u3002\u9019\u7a2e\u65b9\u6cd5\u5c07\u4f7f\u60a8\u907f\u514d\u88ab\u58d3\u57ae\uff0c\u4e26\u6700\u5927\u5316\u60a8\u7684\u751f\u5b58\u6a5f\u6703\u3002"}]
[{"question": "\ub098\uc774\ud2b8 \uc2dc\ud2f0 \ub808\uc774\uc2f1\uc5d0\uc11c \ucc28\ub7c9\uc744 \uc5b4\ub5bb\uac8c \uac1c\uc870\ud558\uc5ec \uc131\ub2a5\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\ub098\uc694?", "answer": "\ub098\uc774\ud2b8 \uc2dc\ud2f0 \ub808\uc774\uc2f1\uc5d0\uc11c \ucc28\ub7c9 \uc131\ub2a5\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1 - \ucc28\uace0 \uba54\ub274\ub97c \ubc29\ubb38\ud558\uc5ec '\uac1c\uc870'\ub97c \uc120\ud0dd\ud558\uc138\uc694. STEP2 - \ub354 \ub098\uc740 \uc18d\ub3c4\uc640 \uac00\uc18d\uc744 \uc704\ud574 \uc5d4\uc9c4\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud130\ubcf4 V8 \uc5d4\uc9c4\uc740 \uc18d\ub3c4\ub97c 15% \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4. STEP3 - \ub098\uc774\ud2b8 \uc2dc\ud2f0\uc758 \ubbf8\ub044\ub7ec\uc6b4 \ub3c4\ub85c\uc5d0\uc11c \ud5a5\uc0c1\ub41c \uadf8\ub9bd\uc744 \uc704\ud574 \ub354 \ub098\uc740 \ud0c0\uc774\uc5b4\ub97c \uc7a5\ucc29\ud558\uc138\uc694. '\uc131\ub2a5 \ube44\uad50' \ud45c\ub97c \uc0ac\uc6a9\ud558\uc5ec GripMaster \ub300 SpeedDemon \ud0c0\uc774\uc5b4\uc640 \uac19\uc740 \uc635\uc158\uc744 \uace0\ub824\ud558\uc138\uc694. \ub610\ud55c, \ub354 \ub0a0\uce74\ub85c\uc6b4 \ucf54\ub108\ub9c1\uc744 \uc704\ud574 \uc11c\uc2a4\ud39c\uc158\uc744 \uc870\uc815\ud558\uc138\uc694. \uc18d\ub3c4\uc640 \uc81c\uc5b4\uc758 \uade0\ud615\uc774 \uc911\uc694\ud558\ub2e4\ub294 \uc810\uc744 \uae30\uc5b5\ud558\uc138\uc694."}, {"question": "\ub098\uc774\ud2b8 \uc2dc\ud2f0 \ub808\uc774\uc2f1\uc758 \ube44\uac00 \uc624\ub294 \ubaa8\ub4dc\uc5d0\uc11c \ucc28\ub7c9\uc774 \ud578\ub4e4\ub9c1\uc774 \ub2e4\ub978 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub098\uc774\ud2b8 \uc2dc\ud2f0 \ub808\uc774\uc2f1\uc5d0\uc11c \ube44\uac00 \uc624\ub294 \ubaa8\ub4dc\ub294 \uc816\uc740 \ub3c4\ub85c\ub97c \ub3c4\uc785\ud558\uc5ec \uc811\uc9c0\ub825\uc744 \uac10\uc18c\uc2dc\ud0a4\uace0 \ud578\ub4e4\ub9c1\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc774\ub294 \uace0\uae09 \ubb3c\ub9ac \uc2dc\ubbac\ub808\uc774\uc158\uc744 \ud1b5\ud574 \uad6c\ud604\ub429\ub2c8\ub2e4. \ud0c0\uc774\uc5b4\ub294 30%\uc758 \uc811\uc9c0\ub825\uc744 \uc783\uace0 \uc81c\ub3d9 \uac70\ub9ac\ub294 20% \uc99d\uac00\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uae30\ubcf8 \ud0c0\uc774\uc5b4\ub294 \uae09\uaca9\ud55c \ucf54\ub108\uc5d0\uc11c \ubbf8\ub044\ub7ec\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\uc5d0 \uc801\uc751\ud558\ub824\uba74 AquaTread\uc640 \uac19\uc740 \ube44\uc6a9 \ud0c0\uc774\uc5b4\ub85c \uad50\uccb4\ud558\uc5ec \uc811\uc9c0\ub825\uc744 25% \ud5a5\uc0c1\uc2dc\ud0a4\uc138\uc694. \ucf54\ub108 \uc9c4\uc785 \uc804 \uc18d\ub3c4\ub97c \uc904\uc774\uace0 \uae09\uc81c\ub3d9\uc744 \ud53c\ud558\ub294 \uc6b4\uc804 \uc2a4\ud0c0\uc77c\uc744 \uc870\uc815\ud558\uc138\uc694. '\ud578\ub4e4\ub9c1 \ud750\ub984\ub3c4'\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc5b8\uc81c \uc18d\ub3c4\ub97c \uc904\uc774\uac70\ub098 \uac00\uc18d\ud560\uc9c0 \uacb0\uc815\ud558\uc138\uc694. \ube44 \ubaa8\ub4dc\ub294 \ud604\uc2e4\uac10\uc744 \ub354\ud558\uc9c0\ub9cc \uc804\ub7b5\uc801\uc778 \uc870\uc815\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."}, {"question": "\uc911\uae09 PC\uc5d0\uc11c \ub098\uc774\ud2b8 \uc2dc\ud2f0 \ub808\uc774\uc2f1\uc758 \ucd5c\uc801 \uc124\uc815\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc911\uae09 PC\uc5d0\uc11c \ub098\uc774\ud2b8 \uc2dc\ud2f0 \ub808\uc774\uc2f1\uc758 \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \ub2e4\uc74c \uc124\uc815\uc744 \uc870\uc815\ud558\uc138\uc694: STEP1 - \uc2dc\uac01\uc801 \ud488\uc9c8\uacfc \uc131\ub2a5\uc758 \uade0\ud615\uc744 \uc704\ud574 '\ud14d\uc2a4\ucc98 \ud488\uc9c8'\uc744 \uc911\uc73c\ub85c \uc124\uc815\ud569\ub2c8\ub2e4. STEP2 - FPS\ub97c 20-30% \uc99d\uac00\uc2dc\ud0a4\uae30 \uc704\ud574 '\ub808\uc774 \ud2b8\ub808\uc774\uc2f1'\uc744 \ube44\ud65c\uc131\ud654\ud558\uc138\uc694. STEP3 - \uadf8\ub9bc\uc790\ub294 \uc790\uc6d0\uc744 \ub9ce\uc774 \uc18c\ube44\ud558\ubbc0\ub85c '\uadf8\ub9bc\uc790 \ud488\uc9c8'\uc744 \ub0ae\uc74c \ub610\ub294 \uc911\uc73c\ub85c \ub0ae\ucd94\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, GTX 1660\uc5d0\uc11c\ub294 \uc774\ub7ec\ud55c \ubcc0\uacbd \uc0ac\ud56d\uc73c\ub85c FPS\uac00 40\uc5d0\uc11c 60\uc73c\ub85c \uc99d\uac00\ud569\ub2c8\ub2e4. '\uc124\uc815 \ube44\uad50' \ud45c\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc870\ud569\uc744 \ud14c\uc2a4\ud2b8\ud558\uc138\uc694. \ub610\ud55c \ud654\uba74 \ucc22\uae40\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud574 VSync\ub97c \ud65c\uc131\ud654\ud558\uc138\uc694. \uc774\ub7ec\ud55c \uc870\uc815\uc744 \ud1b5\ud574 \uc2dc\uac01\uc801 \ud488\uc9c8\uc744 \uc800\ud558\uc2dc\ud0a4\uc9c0 \uc54a\uace0\ub3c4 \ub9e4\ub044\ub7ec\uc6b4 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "\ub098\uc774\ud2b8 \uc2dc\ud2f0 \ub808\uc774\uc2f1\uc5d0\uc11c \ube44\ubc00 '\ub124\uc628 \uace0\uc2a4\ud2b8' \ucc28\ub7c9\uc744 \uc5b4\ub5bb\uac8c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\ub098\uc694?", "answer": " '\ub124\uc628 \uace0\uc2a4\ud2b8' \ucc28\ub7c9\uc744 \uc7a0\uae08 \ud574\uc81c\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1 - \ubaa8\ub4e0 15\uac1c\uc758 \ub098\uc774\ud2b8 \uc2dc\ud2f0 \uac70\ub9ac \ub808\uc774\uc2a4\ub97c \uc644\ub8cc\ud558\uc138\uc694. STEP2 - \uac01 \ub808\uc774\uc2a4\uc5d0\uc11c 3\uc131 \ub4f1\uae09\uc744 \ub2ec\uc131\ud558\uc5ec \ucda9\ub3cc \uc5c6\uc774 \ube60\ub978 \ub7a9 \ud0c0\uc784\uc744 \ud655\ubcf4\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\ub2e4\uc6b4\ud0c0\uc6b4 \ub300\uc2dc' \ub808\uc774\uc2a4\uc5d0\uc11c 2\uc2dc\uac04 30\ubd84 \uc774\ub0b4\uc5d0 \uc644\uc8fc\ud558\uc138\uc694. STEP3 - \uc790\uc815(\uac8c\uc784 \uc2dc\uac04)\uc5d0 \uc0b0\uc5c5 \uc9c0\uc5ed\uc758 \uc228\uaca8\uc9c4 \ucc28\uace0\ub97c \ubc29\ubb38\ud558\uc138\uc694. '\ub124\uc628 \uace0\uc2a4\ud2b8'\ub294 \uace0\uc18d\uc774\uace0 \uc2a4\ud154\uc2a4 \ud14c\ub9c8\uc758 \ucc28\ub7c9\uc73c\ub85c \ub3c5\ud2b9\ud55c \ube5b\ub098\ub294 \ub370\uce7c\uc774 \uc7a5\ucc29\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. '\uc7a0\uae08 \ud574\uc81c \uc9c4\ud589 \uc0c1\ud669 \ucd94\uc801\uae30'\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc131\ucde8\ub3c4\ub97c \ubaa8\ub2c8\ud130\ub9c1\ud558\uc138\uc694. \uc774 \ucc28\ub7c9\uc740 \uc219\ub2ec\uacfc \uc778\ub0b4\uc2ec\uc5d0 \ub300\ud55c \ubcf4\uc0c1\uc785\ub2c8\ub2e4."}, {"question": "\ub808\ubca8\uc5c5\uc744 \uc704\ud574 \ub098\uc774\ud2b8 \uc2dc\ud2f0 \ub808\uc774\uc2f1\uc5d0\uc11c \uc5b4\ub5a4 \ub808\uc774\uc2a4 \uc720\ud615\uc774 \uac00\uc7a5 \ub9ce\uc740 XP\ub97c \uc81c\uacf5\ud558\ub098\uc694?", "answer": "\ub098\uc774\ud2b8 \uc2dc\ud2f0 \ub808\uc774\uc2f1\uc758 '\ub0b4\uad6c\uc131 \ub808\uc774\uc2a4'\ub294 \uae38\uc774\uc640 \ub09c\uc774\ub3c4 \ub54c\ubb38\uc5d0 \uac00\uc7a5 \ub9ce\uc740 XP\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub098\uc774\ud2b8 \uc2dc\ud2f0 \ub9c8\ub77c\ud1a4'\uc740 30\ubd84 \ub808\uc774\uc2a4\uc5d0 \ub300\ud574 5,000 XP\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc774\uc775\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 STEP1 - \ud0c0\uc774\ud0c4 GT\uc640 \uac19\uc774 \ub0b4\uad6c\uc131\uc774 \ub192\uc740 \ucc28\ub7c9\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. STEP2 - \ubcf4\ub108\uc2a4 XP\ub97c \uc5bb\uae30 \uc704\ud574 \uc77c\uad00\ub41c \ub7a9 \ud0c0\uc784\uc744 \uc720\uc9c0\ud558\uc138\uc694. STEP3 - \ucda9\ub3cc\uacfc \uac19\uc740 \ud398\ub110\ud2f0\ub97c \ud53c\ud558\uba74 XP\uac00 10% \uac10\uc18c\ud569\ub2c8\ub2e4. '\ub808\uc774\uc2a4 XP \ube44\uad50' \ucc28\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc635\uc158\uc744 \ud3c9\uac00\ud558\uc138\uc694. \ub0b4\uad6c\uc131 \ub808\uc774\uc2a4\ub294 \ube60\ub974\uac8c \ub808\ubca8\uc5c5\ud558\uace0 \uae30\uc220\uc744 \uac08\uace0\ub2e6\uc73c\ub824\ub294 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc774\uc0c1\uc801\uc785\ub2c8\ub2e4."}, {"question": "\ub098\uc774\ud2b8 \uc2dc\ud2f0 \ub808\uc774\uc2f1\uc758 AI \ub09c\uc774\ub3c4 \uc870\uc815\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "\ub098\uc774\ud2b8 \uc2dc\ud2f0 \ub808\uc774\uc2f1\uc758 AI\ub294 \uc5ed\ub3d9\uc801\uc778 \uc2a4\ucf00\uc77c\ub9c1 \uc2dc\uc2a4\ud15c\uc744 \uc0ac\uc6a9\ud558\uc5ec \uadc0\ud558\uc758 \uae30\uc220 \uc218\uc900\uc5d0 \uc801\uc751\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc138 \ubc88 \uc5f0\uc18d \ub808\uc774\uc2a4\ub97c \uc774\uae30\uba74 AI \uc0c1\ub300\ubc29\uc758 \uc18d\ub3c4\uac00 15% \ube68\ub77c\uc9c0\uace0 \ub354 \uacf5\uaca9\uc801\uc73c\ub85c \ubcc0\ud569\ub2c8\ub2e4. \ubc18\ub300\ub85c \uc5ec\ub7ec \ubc88 \ub808\uc774\uc2a4\uc5d0\uc11c \ud328\ubc30\ud558\uba74 \ub09c\uc774\ub3c4\uac00 10% \uac10\uc18c\ud569\ub2c8\ub2e4. \uc774\ub294 \uade0\ud615 \uc7a1\ud78c \uacbd\uc7c1\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4. 'AI \ud589\ub3d9 \ucc28\ud2b8'\ub97c \uc0ac\uc6a9\ud558\uc5ec \ubcc0\uacbd \uc0ac\ud56d\uc744 \uc608\uce21\ud558\uc138\uc694. \ub09c\uc774\ub3c4\ub97c \uc7ac\uc124\uc815\ud558\ub824\uba74 5\uac1c\uc758 \ub808\uc774\uc2a4\ub97c \uc774\uae30\uc9c0 \uc54a\uace0 \uc644\ub8cc\ud558\uc138\uc694. \uc774 \uc2dc\uc2a4\ud15c\uc740 \ucd08\ubcf4\uc790\uc640 \ubca0\ud14c\ub791 \ubaa8\ub450\uc5d0\uac8c \uc801\ud569\ud558\ub3c4\ub85d \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc5b4\ub835\uac8c \ud558\uc9c0\ub9cc \uacf5\uc815\ud558\uac8c \uc720\uc9c0\ud569\ub2c8\ub2e4."}, {"question": "'\ub098\uc774\ud2b8 \uc2dc\ud2f0 \uc11c\ud0b7' \uc21c\uc704\ud45c\uc758 \uc911\uc694\uc131\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "'\ub098\uc774\ud2b8 \uc2dc\ud2f0 \uc11c\ud0b7' \uc21c\uc704\ud45c\ub294 \uac8c\uc784\uc5d0\uc11c \uac00\uc7a5 \uc5b4\ub824\uc6b4 \ub808\uc774\uc2a4\uc5d0\uc11c\uc758 \uc131\ub2a5\uc5d0 \ub530\ub77c \ud50c\ub808\uc774\uc5b4\ub97c \uc21c\uc704 \ub9e4\uae41\ub2c8\ub2e4. \ub7a9 \ud0c0\uc784, \ucda9\ub3cc\ub960 \ubc0f \uc804\ubc18\uc801\uc778 \uc77c\uad00\uc131\uacfc \uac19\uc740 \uc9c0\ud45c\ub97c \ucd94\uc801\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc0c1\uc704 10\uba85\uc758 \ud50c\ub808\uc774\uc5b4\ub294 \uc885\uc885 '\ud2b8\uc640\uc77c\ub77c\uc774\ud2b8 \ub8e8\ud504'\uc5d0\uc11c 1\uc2dc\uac04 45\ubd84 \ubbf8\ub9cc\uc758 \ub7a9 \ud0c0\uc784\uc744 \uae30\ub85d\ud569\ub2c8\ub2e4. \uc21c\uc704\ud45c\ub294 '\uc11c\ud0b7 \ucc54\ud53c\uc5b8' \ub370\uce7c\uacfc \uac19\uc740 \ub3c5\uc810 \uc544\uc774\ud15c\uc744 \ubcf4\uc0c1\ud569\ub2c8\ub2e4. \uc0c1\uc704 \ud50c\ub808\uc774\uc5b4\uc640 \uadc0\ud558\uc758 \ud1b5\uacc4\ub97c \ube44\uad50\ud558\uae30 \uc704\ud574 '\uc21c\uc704\ud45c \ubd84\uc11d' \ub3c4\uad6c\ub97c \uc0ac\uc6a9\ud558\uc138\uc694. \uc21c\uc704\ub97c \ub192\uc774\ub824\uba74 \uc815\ud655\uc131, \uc804\ub7b5 \ubc0f \uc5f0\uc2b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."}, {"question": "PC\uc5d0\uc11c \ucf58\uc194\ub85c \ub098\uc774\ud2b8 \uc2dc\ud2f0 \ub808\uc774\uc2f1 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub124, \ub098\uc774\ud2b8 \uc2dc\ud2f0 \ub808\uc774\uc2f1\uc740 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ud1b5\ud574 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \uc9c4\ud589 \uc0c1\ud669 \uc804\uc1a1\uc744 \uc9c0\uc6d0\ud569\ub2c8\ub2e4. STEP1 - \uc591\ucabd \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uc138\uc694. STEP2 - \uc124\uc815 \uba54\ub274\uc758 '\ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5' \uc635\uc158\uc744 \ud1b5\ud574 \ub370\uc774\ud130\ub97c \ub3d9\uae30\ud654\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc7a0\uae08 \ud574\uc81c\ub41c \ucc28\ub7c9\uacfc \ub808\uc774\uc2a4 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc0c8 \ud50c\ub7ab\ud3fc\uc5d0 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \ud50c\ub7ab\ud3fc\ubcc4 \ub2ec\uc131\ud55c \uc5c5\uc801\uc740 \uc804\uc1a1\ub418\uc9c0 \uc54a\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubb38\uc81c \ud574\uacb0\uc744 \uc704\ud574 '\ub370\uc774\ud130 \ub9c8\uc774\uadf8\ub808\uc774\uc158 \uac00\uc774\ub4dc'\ub97c \ucc38\uace0\ud558\uc138\uc694. \uc774 \uae30\ub2a5\uc740 \ub2e4\uc591\ud55c \uc7a5\uce58\uc5d0\uc11c \uc6d0\ud65c\ud55c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "\ub098\uc774\ud2b8 \uc2dc\ud2f0 \ub808\uc774\uc2f1\uc5d0\uc11c \ucc28\ub7c9 \uc5f0\ube44\ub97c \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub098\uc774\ud2b8 \uc2dc\ud2f0 \ub808\uc774\uc2f1\uc5d0\uc11c \uc5f0\ube44\ub97c \uac1c\uc120\ud558\ub824\uba74 \ub2e4\uc74c\uc744 \uc218\ud589\ud558\uc138\uc694: STEP1 - EcoDrive\uc640 \uac19\uc774 \ud558\uc774\ube0c\ub9ac\ub4dc \ub610\ub294 \uc804\uae30 \uc5d4\uc9c4\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc5ec \uc5f0\ub8cc \uc18c\ube44\ub7c9\uc744 40% \uc904\uc774\uc138\uc694. STEP2 - \uac00\uc18d\uc744 \uc81c\ud55c\ud558\uace0 \uc548\uc815\uc801\uc778 \uc18d\ub3c4\ub97c \uc720\uc9c0\ud558\ub294 '\uc5d0\ucf54 \ubaa8\ub4dc' \ub4dc\ub77c\uc774\ube59 \uc5b4\uc2dc\uc2a4\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\ub3c4\uc2ec \uc2a4\ud504\ub9b0\ud2b8' \ub808\uc774\uc2a4\uc5d0\uc11c \uc5d0\ucf54 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uba74 \uc5f0\ub8cc\ub97c 20% \uc808\uc57d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP3 - \ubd88\ud544\uc694\ud55c \ubd80\uc2a4\ud2b8\uc640 \uacf5\uaca9\uc801\uc778 \uc6b4\uc804\uc744 \ud53c\ud558\uace0 \uc5f0\ub8cc \uc0ac\uc6a9\ub7c9\uc744 \uc99d\uac00\uc2dc\ud0a4\uc138\uc694. \uc5d4\uc9c4\uc744 \ube44\uad50\ud558\uae30 \uc704\ud574 '\uc5f0\ub8cc \ud6a8\uc728 \ucc28\ud2b8'\ub97c \uc0ac\uc6a9\ud558\uc138\uc694. \ud6a8\uc728\uc801\uc778 \uc6b4\uc804\uc740 \uc790\uc6d0\uc744 \uc808\uc57d\ud560 \ubfd0\ub9cc \uc544\ub2c8\ub77c \ud53c\ud2b8 \uc2a4\ud1b1\ub3c4 \uc904\uc785\ub2c8\ub2e4."}, {"question": "\ub098\uc774\ud2b8 \uc2dc\ud2f0 \ub808\uc774\uc2f1 \uc9c0\ub3c4\uc5d0 \uc228\uaca8\uc9c4 \ubc30\uacbd \uc815\ubcf4\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub098\uc774\ud2b8 \uc2dc\ud2f0 \ub808\uc774\uc2f1 \uc9c0\ub3c4\uc5d0\ub294 \uc228\uaca8\uc9c4 \ubc30\uacbd \uc815\ubcf4\uac00 \ud48d\ubd80\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uae08\uc735 \uc9c0\uad6c\uc758 \ubc84\ub824\uc9c4 '\uc2a4\uce74\uc774\ub77c\uc778 \ud0c0\uc6cc'\uc5d0\ub294 \uc2e4\ud328\ud55c \uae30\uc5c5 \ud22c\uc790\uc5d0 \ub300\ud55c \uc774\uc57c\uae30\uac00 \uc788\uc2b5\ub2c8\ub2e4. 'CEO\uc758 \uc77c\uae30'\uc640 \uac19\uc740 \uceec\ub809\uc158 \uc544\uc774\ud15c\uc744 \ucc3e\uc73c\ub824\uba74 \ub0b4\ubd80\ub97c \ud0d0\ud5d8\ud558\uc138\uc694. \ub9c8\ucc2c\uac00\uc9c0\ub85c '\uc61b \ubd80\ub450' \uc9c0\uc5ed\uc5d0\ub294 \ubc00\uc218\uafbc\uc758 \uc774\uc57c\uae30\ub97c \uc5b8\uae09\ud558\ub294 \uadf8\ub798\ud53c\ud2f0\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ubc1c\uacac \uc0ac\ud56d\uc744 \uae30\ub85d\ud558\uae30 \uc704\ud574 '\uc9c0\uc2dd \ucd94\uc801\uae30'\ub97c \uc0ac\uc6a9\ud558\uc138\uc694. \uc774\ub7ec\ud55c \uc138\ubd80 \uc815\ubcf4\ub294 \uc774\uc57c\uae30\uc640 \ud0d0\ud5d8\uc744 \uc990\uae30\ub294 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc5b4\ud544\ud558\ub294 \uac8c\uc784 \uc138\uacc4\uc5d0 \uae4a\uc774\ub97c \ub354\ud569\ub2c8\ub2e4."}]
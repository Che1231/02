[{"question": "\u30ca\u30a4\u30c8\u30b7\u30c6\u30a3\u30ec\u30fc\u30b7\u30f3\u30b0\u3067\u8eca\u306e\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3092\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u5411\u4e0a\u306b\u5f79\u7acb\u3066\u3089\u308c\u307e\u3059\u304b\uff1f", "answer": "\u30ca\u30a4\u30c8\u30b7\u30c6\u30a3\u30ec\u30fc\u30b7\u30f3\u30b0\u3067\u8eca\u306e\u6027\u80fd\u3092\u5411\u4e0a\u3055\u305b\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002STEP1 - \u8eca\u5eab\u30e1\u30cb\u30e5\u30fc\u306b\u30a2\u30af\u30bb\u30b9\u3057\u3001\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3092\u9078\u629e\u3057\u307e\u3059\u3002STEP2 - \u30a8\u30f3\u30b8\u30f3\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u3066\u3001\u901f\u5ea6\u3068\u52a0\u901f\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30bf\u30fc\u30dcV8\u30a8\u30f3\u30b8\u30f3\u306f\u901f\u5ea6\u309215%\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002STEP3 - \u30ca\u30a4\u30c8\u30b7\u30c6\u30a3\u306e\u6ed1\u308a\u3084\u3059\u3044\u9053\u8def\u3067\u30b0\u30ea\u30c3\u30d7\u529b\u3092\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u306b\u3001\u3088\u308a\u512a\u308c\u305f\u30bf\u30a4\u30e4\u3092\u88c5\u7740\u3057\u307e\u3059\u3002\u30b0\u30ea\u30c3\u30d7\u30de\u30b9\u30bf\u30fc\u3068\u30b9\u30d4\u30fc\u30c9\u30c7\u30e2\u30f3\u30bf\u30a4\u30e4\u306a\u3069\u306e\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u6bd4\u8f03\u3059\u308b\u305f\u3081\u306b\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u6bd4\u8f03\u8868\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3055\u3089\u306b\u3001\u30b5\u30b9\u30da\u30f3\u30b7\u30e7\u30f3\u3092\u8abf\u6574\u3057\u3066\u3001\u3088\u308a\u92ed\u3044\u30bf\u30fc\u30f3\u3092\u5b9f\u73fe\u3057\u307e\u3059\u3002\u901f\u5ea6\u3068\u5236\u5fa1\u306e\u30d0\u30e9\u30f3\u30b9\u3092\u3068\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002"}, {"question": "\u306a\u305c\u30ca\u30a4\u30c8\u30b7\u30c6\u30a3\u30ec\u30fc\u30b7\u30f3\u30b0\u306e\u96e8\u30e2\u30fc\u30c9\u3067\u8eca\u306e\u30cf\u30f3\u30c9\u30ea\u30f3\u30b0\u304c\u5909\u308f\u308b\u306e\u3067\u3059\u304b\uff1f", "answer": "\u30ca\u30a4\u30c8\u30b7\u30c6\u30a3\u30ec\u30fc\u30b7\u30f3\u30b0\u306e\u96e8\u30e2\u30fc\u30c9\u3067\u306f\u3001\u8def\u9762\u304c\u6fe1\u308c\u308b\u305f\u3081\u30c8\u30e9\u30af\u30b7\u30e7\u30f3\u304c\u4f4e\u4e0b\u3057\u3001\u30cf\u30f3\u30c9\u30ea\u30f3\u30b0\u306b\u5f71\u97ff\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u9ad8\u5ea6\u306a\u7269\u7406\u30b7\u30df\u30e5\u30ec\u30fc\u30b7\u30e7\u30f3\u3067\u5b9f\u73fe\u3055\u308c\u3066\u304a\u308a\u3001\u30bf\u30a4\u30e4\u306e\u30b0\u30ea\u30c3\u30d7\u529b\u304c30%\u4f4e\u4e0b\u3057\u3001\u30d6\u30ec\u30fc\u30ad\u8ddd\u96e2\u304c20%\u5897\u52a0\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30c7\u30d5\u30a9\u30eb\u30c8\u306e\u30bf\u30a4\u30e4\u306f\u6025\u306a\u30ab\u30fc\u30d6\u3067\u30b9\u30ea\u30c3\u30d7\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u5bfe\u5fdc\u3059\u308b\u305f\u3081\u306b\u3001\u30a2\u30af\u30a2\u30c8\u30ec\u30c3\u30c9\u306e\u3088\u3046\u306a\u96e8\u5c02\u7528\u306e\u30bf\u30a4\u30e4\u306b\u5207\u308a\u66ff\u3048\u307e\u3057\u3087\u3046\u3002\u3053\u308c\u306f\u30b0\u30ea\u30c3\u30d7\u529b\u309225%\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002\u904b\u8ee2\u30b9\u30bf\u30a4\u30eb\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u30ab\u30fc\u30d6\u306e\u524d\u306b\u901f\u5ea6\u3092\u843d\u3068\u3057\u3001\u6025\u30d6\u30ec\u30fc\u30ad\u3092\u907f\u3051\u307e\u3057\u3087\u3046\u3002\u30cf\u30f3\u30c9\u30ea\u30f3\u30b0\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u4f7f\u7528\u3057\u3066\u3001\u901f\u5ea6\u3092\u843d\u3068\u3059\u304b\u52a0\u901f\u3059\u308b\u304b\u3092\u5224\u65ad\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u96e8\u30e2\u30fc\u30c9\u306f\u30ea\u30a2\u30ea\u30c6\u30a3\u3092\u8ffd\u52a0\u3057\u307e\u3059\u304c\u3001\u6226\u7565\u7684\u306a\u8abf\u6574\u304c\u5fc5\u8981\u3067\u3059\u3002"}, {"question": "\u30df\u30c3\u30c9\u30ec\u30f3\u30b8PC\u3067\u30ca\u30a4\u30c8\u30b7\u30c6\u30a3\u30ec\u30fc\u30b7\u30f3\u30b0\u306e\u6700\u9069\u306a\u8a2d\u5b9a\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30df\u30c3\u30c9\u30ec\u30f3\u30b8PC\u306e\u5834\u5408\u306f\u3001\u4ee5\u4e0b\u306e\u8a2d\u5b9a\u3092\u8abf\u6574\u3057\u3066\u30ca\u30a4\u30c8\u30b7\u30c6\u30a3\u30ec\u30fc\u30b7\u30f3\u30b0\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3057\u307e\u3059\u3002STEP1 - \u30c6\u30af\u30b9\u30c1\u30e3\u54c1\u8cea\u3092\u30df\u30c7\u30a3\u30a2\u30e0\u306b\u8a2d\u5b9a\u3057\u3066\u3001\u8996\u899a\u3068\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306e\u30d0\u30e9\u30f3\u30b9\u3092\u53d6\u308a\u307e\u3059\u3002STEP2 - \u30ec\u30a4\u30c8\u30ec\u30fc\u30b7\u30f3\u30b0\u3092\u7121\u52b9\u306b\u3057\u3066\u3001FPS\u309220\u301c30%\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002STEP3 - \u5f71\u306e\u54c1\u8cea\u3092\u30ed\u30fc\u307e\u305f\u306f\u30df\u30c7\u30a3\u30a2\u30e0\u306b\u4e0b\u3052\u307e\u3059\u3002\u5f71\u306f\u30ea\u30bd\u30fc\u30b9\u3092\u6d88\u8cbb\u3057\u307e\u3059\u3002 \u4f8b\u3048\u3070\u3001GTX 1660\u3067\u306f\u3001\u3053\u308c\u3089\u306e\u5909\u66f4\u306b\u3088\u308aFPS\u304c40\u304b\u308960\u306b\u4e0a\u304c\u308a\u307e\u3059\u3002\u8a2d\u5b9a\u6bd4\u8f03\u8868\u3092\u4f7f\u7528\u3057\u3066\u3001\u7d44\u307f\u5408\u308f\u305b\u3092\u30c6\u30b9\u30c8\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u753b\u9762\u306e\u30c6\u30a3\u30a2\u30ea\u30f3\u30b0\u3092\u9632\u3050\u305f\u3081\u306bVSync\u3092\u6709\u52b9\u306b\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u8abf\u6574\u306b\u3088\u308a\u3001\u8996\u899a\u6027\u3092\u640d\u306a\u3046\u3053\u3068\u306a\u304f\u30b9\u30e0\u30fc\u30ba\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5b9f\u73fe\u3057\u307e\u3059\u3002"}, {"question": "\u30ca\u30a4\u30c8\u30b7\u30c6\u30a3\u30ec\u30fc\u30b7\u30f3\u30b0\u3067\u79d8\u5bc6\u306e\u8eca\u300c\u30cd\u30aa\u30f3\u30b4\u30fc\u30b9\u30c8\u300d\u3092\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u300c\u30cd\u30aa\u30f3\u30b4\u30fc\u30b9\u30c8\u300d\u8eca\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002STEP1 - \u5168\u3066\u306e15\u306e\u30ca\u30a4\u30c8\u30b7\u30c6\u30a3\u30b9\u30c8\u30ea\u30fc\u30c8\u30ec\u30fc\u30b9\u3092\u5b8c\u4e86\u3057\u307e\u3059\u3002STEP2 - \u5404\u30ec\u30fc\u30b9\u30673\u3064\u661f\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u885d\u7a81\u3092\u907f\u3051\u3001\u9ad8\u901f\u30e9\u30c3\u30d7\u30bf\u30a4\u30e0\u3092\u9054\u6210\u3059\u308b\u3053\u3068\u3092\u610f\u5473\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30c0\u30a6\u30f3\u30bf\u30a6\u30f3\u30c0\u30c3\u30b7\u30e5\u300d\u30ec\u30fc\u30b9\u3067\u306f\u30012\u520630\u79d2\u4ee5\u5185\u306b\u30b4\u30fc\u30eb\u3057\u3066\u304f\u3060\u3055\u3044\u3002STEP3 - \u591c\u534a\uff08\u30b2\u30fc\u30e0\u6642\u9593\uff09\u306b\u7523\u696d\u5730\u533a\u306e\u96a0\u308c\u30ac\u30ec\u30fc\u30b8\u3092\u8a2a\u308c\u3066\u304f\u3060\u3055\u3044\u3002 \u300c\u30cd\u30aa\u30f3\u30b4\u30fc\u30b9\u30c8\u300d\u306f\u3001\u72ec\u7279\u306e\u5149\u308b\u30c7\u30ab\u30fc\u30eb\u3092\u5099\u3048\u305f\u9ad8\u901f\u3067\u30b9\u30c6\u30eb\u30b9\u3092\u30c6\u30fc\u30de\u306b\u3057\u305f\u8eca\u3067\u3059\u3002\u30a2\u30f3\u30ed\u30c3\u30af\u9032\u6357\u30c8\u30e9\u30c3\u30ab\u30fc\u3092\u4f7f\u7528\u3057\u3066\u3001\u3042\u306a\u305f\u306e\u9054\u6210\u72b6\u6cc1\u3092\u8ffd\u8de1\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u306e\u8eca\u306f\u3001\u5353\u8d8a\u6027\u3068\u5fcd\u8010\u3078\u306e\u5831\u916c\u3067\u3059\u3002"}, {"question": "\u30ca\u30a4\u30c8\u30b7\u30c6\u30a3\u30ec\u30fc\u30b7\u30f3\u30b0\u3067\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u306b\u6700\u3082XP\u3092\u7372\u5f97\u3067\u304d\u308b\u30ec\u30fc\u30b9\u306e\u7a2e\u985e\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ca\u30a4\u30c8\u30b7\u30c6\u30a3\u30ec\u30fc\u30b7\u30f3\u30b0\u306e\u8010\u4e45\u30ec\u30fc\u30b9\u306f\u3001\u305d\u306e\u9577\u3055\u3084\u96e3\u6613\u5ea6\u304b\u3089\u6700\u3082\u591a\u304f\u306eXP\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30ca\u30a4\u30c8\u30b7\u30c6\u30a3\u30de\u30e9\u30bd\u30f3\u300d\u306f30\u5206\u306e\u30ec\u30fc\u30b9\u30675,000XP\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u7372\u5f97\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\uff1aSTEP1 - \u30bf\u30a4\u30bf\u30f3GT\u306e\u3088\u3046\u306a\u8010\u4e45\u6027\u304c\u9ad8\u3044\u8eca\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044 STEP2 - \u4e00\u8cab\u3057\u305f\u30e9\u30c3\u30d7\u30bf\u30a4\u30e0\u3092\u7dad\u6301\u3057\u3066\u3001\u30dc\u30fc\u30ca\u30b9XP\u3092\u7372\u5f97\u3057\u307e\u3059\u3002STEP3 - \u885d\u7a81\u306a\u3069\u306e\u30da\u30ca\u30eb\u30c6\u30a3\u3092\u907f\u3051\u307e\u3057\u3087\u3046\u3002\u885d\u7a81\u306fXP\u309210%\u6e1b\u5c11\u3055\u305b\u307e\u3059\u3002\u30ec\u30fc\u30b9XP\u6bd4\u8f03\u8868\u3092\u4f7f\u7528\u3057\u3066\u3001\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u8a55\u4fa1\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u8010\u4e45\u30ec\u30fc\u30b9\u306f\u3001\u30b9\u30ad\u30eb\u3092\u78e8\u304f\u4e00\u65b9\u3067\u3001\u7d20\u65e9\u304f\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u3092\u76ee\u6307\u3057\u305f\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u6700\u9069\u3067\u3059\u3002"}, {"question": "\u30ca\u30a4\u30c8\u30b7\u30c6\u30a3\u30ec\u30fc\u30b7\u30f3\u30b0\u306eAI\u306e\u96e3\u6613\u5ea6\u8abf\u6574\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30ca\u30a4\u30c8\u30b7\u30c6\u30a3\u30ec\u30fc\u30b7\u30f3\u30b0\u306eAI\u306f\u3001\u30c0\u30a4\u30ca\u30df\u30c3\u30af\u306a\u8abf\u6574\u30b7\u30b9\u30c6\u30e0\u3092\u4f7f\u7528\u3057\u3066\u3042\u306a\u305f\u306e\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u306b\u9069\u5fdc\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u30013\u9023\u7d9a\u3067\u30ec\u30fc\u30b9\u306b\u52dd\u3064\u3068\u3001AI\u306e\u5bfe\u6226\u76f8\u624b\u306f15%\u9ad8\u901f\u5316\u3057\u3001\u3088\u308a\u653b\u6483\u7684\u306b\u306a\u308a\u307e\u3059\u3002\u9006\u306b\u3001\u8907\u6570\u56de\u30ec\u30fc\u30b9\u306b\u8ca0\u3051\u308b\u3053\u3068\u3067\u3001\u5f7c\u3089\u306e\u96e3\u6613\u5ea6\u306f10%\u4f4e\u4e0b\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u7af6\u4e89\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002AI\u884c\u52d5\u30c1\u30e3\u30fc\u30c8\u3092\u4f7f\u7528\u3057\u3066\u3001\u5909\u5316\u3092\u4e88\u6e2c\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u96e3\u6613\u5ea6\u3092\u30ea\u30bb\u30c3\u30c8\u3059\u308b\u306b\u306f\u30015\u56de\u9023\u7d9a\u3067\u30ec\u30fc\u30b9\u306b\u52dd\u3064\u3053\u3068\u306a\u304f\u7d42\u4e86\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u521d\u5fc3\u8005\u3068\u30d9\u30c6\u30e9\u30f3\u306e\u4e21\u65b9\u306b\u5bfe\u5fdc\u3057\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u6311\u6226\u7684\u3067\u3042\u308a\u306a\u304c\u3089\u516c\u5e73\u306a\u3082\u306e\u306b\u3057\u307e\u3059\u3002"}, {"question": "\u300c\u30ca\u30a4\u30c8\u30b7\u30c6\u30a3\u30b5\u30fc\u30ad\u30c3\u30c8\u300d\u306e\u30ea\u30fc\u30c0\u30fc\u30dc\u30fc\u30c9\u306e\u91cd\u8981\u6027\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u300c\u30ca\u30a4\u30c8\u30b7\u30c6\u30a3\u30b5\u30fc\u30ad\u30c3\u30c8\u300d\u306e\u30ea\u30fc\u30c0\u30fc\u30dc\u30fc\u30c9\u306f\u3001\u30b2\u30fc\u30e0\u3067\u6700\u3082\u96e3\u3057\u3044\u30ec\u30fc\u30b9\u3067\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u57fa\u3065\u3044\u3066\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u30e9\u30f3\u30af\u4ed8\u3051\u3057\u307e\u3059\u3002\u30e9\u30c3\u30d7\u30bf\u30a4\u30e0\u3001\u885d\u7a81\u7387\u3001\u5168\u4f53\u7684\u306a\u4e00\u8cab\u6027\u306a\u3069\u306e\u6307\u6a19\u3092\u8ffd\u8de1\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30c8\u30c3\u30d710\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u901a\u5e38\u3001\u300c\u5915\u66ae\u308c\u30eb\u30fc\u30d7\u300d\u30671\u520645\u79d2\u672a\u6e80\u306e\u30e9\u30c3\u30d7\u30bf\u30a4\u30e0\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002\u30ea\u30fc\u30c0\u30fc\u30dc\u30fc\u30c9\u306f\u3001\u30b5\u30fc\u30ad\u30c3\u30c8\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u30c7\u30ab\u30fc\u30eb\u306a\u3069\u306e\u72ec\u5360\u30a2\u30a4\u30c6\u30e0\u3092\u5831\u916c\u3068\u3057\u3066\u63d0\u4f9b\u3057\u307e\u3059\u3002\u30ea\u30fc\u30c0\u30fc\u30dc\u30fc\u30c9\u5206\u6790\u30c4\u30fc\u30eb\u3092\u4f7f\u7528\u3057\u3066\u3001\u30c8\u30c3\u30d7\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u306e\u3042\u306a\u305f\u306e\u7d71\u8a08\u3092\u6bd4\u8f03\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30e9\u30f3\u30af\u3092\u4e0a\u3052\u308b\u306b\u306f\u3001\u6b63\u78ba\u3055\u3001\u6226\u7565\u3001\u7df4\u7fd2\u304c\u5fc5\u8981\u3067\u3059\u3002"}, {"question": "PC\u304b\u3089\u30b3\u30f3\u30bd\u30fc\u30eb\u306b\u30ca\u30a4\u30c8\u30b7\u30c6\u30a3\u30ec\u30fc\u30b7\u30f3\u30b0\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30ca\u30a4\u30c8\u30b7\u30c6\u30a3\u30ec\u30fc\u30b7\u30f3\u30b0\u306f\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u3063\u3066\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3067\u304d\u307e\u3059\u3002STEP1 - \u4e21\u65b9\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002STEP2 - \u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u306e\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u30aa\u30d7\u30b7\u30e7\u30f3\u304b\u3089\u30c7\u30fc\u30bf\u3092\u540c\u671f\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u305f\u8eca\u3084\u30ec\u30fc\u30b9\u306e\u9032\u884c\u72b6\u6cc1\u306f\u3001\u65b0\u3057\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u3082\u8868\u793a\u3055\u308c\u307e\u3059\u3002\u3057\u304b\u3057\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u56fa\u6709\u306e\u9054\u6210\u70b9\u306f\u8ee2\u9001\u3055\u308c\u306a\u3044\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u30c7\u30fc\u30bf\u79fb\u884c\u30ac\u30a4\u30c9\u3092\u4f7f\u7528\u3057\u3066\u3001\u554f\u984c\u3092\u89e3\u6c7a\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u306e\u6a5f\u80fd\u306f\u3001\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u30b7\u30fc\u30e0\u30ec\u30b9\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002"}, {"question": "\u30ca\u30a4\u30c8\u30b7\u30c6\u30a3\u30ec\u30fc\u30b7\u30f3\u30b0\u3067\u8eca\u306e\u71c3\u6599\u52b9\u7387\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30ca\u30a4\u30c8\u30b7\u30c6\u30a3\u30ec\u30fc\u30b7\u30f3\u30b0\u3067\u71c3\u6599\u52b9\u7387\u3092\u5411\u4e0a\u3055\u305b\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u30b9\u30c6\u30c3\u30d7\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\uff1aSTEP1 - \u30a8\u30b3\u30c9\u30e9\u30a4\u30d6\u306e\u3088\u3046\u306a\u30cf\u30a4\u30d6\u30ea\u30c3\u30c9\u307e\u305f\u306f\u96fb\u6c17\u30a8\u30f3\u30b8\u30f3\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u71c3\u6599\u6d88\u8cbb\u91cf\u309240%\u524a\u6e1b\u3057\u307e\u3059\u3002STEP2 - \u52a0\u901f\u3092\u5236\u9650\u3057\u3001\u4e00\u5b9a\u306e\u901f\u5ea6\u3092\u7dad\u6301\u3059\u308b\u30a8\u30b3\u30e2\u30fc\u30c9\u904b\u8ee2\u30a2\u30b7\u30b9\u30c8\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u90fd\u5e02\u30b9\u30d7\u30ea\u30f3\u30c8\u300d\u30ec\u30fc\u30b9\u3067\u306f\u3001\u30a8\u30b3\u30e2\u30fc\u30c9\u306b\u3088\u3063\u3066\u71c3\u6599\u309220%\u7bc0\u7d04\u3067\u304d\u307e\u3059\u3002STEP3 - \u4e0d\u8981\u306a\u30d6\u30fc\u30b9\u30c8\u3084\u7a4d\u6975\u7684\u306a\u904b\u8ee2\u3092\u907f\u3051\u307e\u3057\u3087\u3046\u3002\u3053\u308c\u3089\u306f\u71c3\u6599\u6d88\u8cbb\u91cf\u3092\u5897\u3084\u3057\u307e\u3059\u3002\u71c3\u6599\u52b9\u7387\u30c1\u30e3\u30fc\u30c8\u3092\u4f7f\u7528\u3057\u3066\u3001\u30a8\u30f3\u30b8\u30f3\u3092\u6bd4\u8f03\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u52b9\u7387\u7684\u306a\u904b\u8ee2\u306f\u3001\u30ea\u30bd\u30fc\u30b9\u3092\u7bc0\u7d04\u3059\u308b\u3060\u3051\u3067\u306a\u304f\u3001\u30d4\u30c3\u30c8\u30b9\u30c8\u30c3\u30d7\u3092\u524a\u6e1b\u3059\u308b\u52b9\u679c\u3082\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30ca\u30a4\u30c8\u30b7\u30c6\u30a3\u30ec\u30fc\u30b7\u30f3\u30b0\u306e\u30de\u30c3\u30d7\u306b\u96a0\u3055\u308c\u305f\u30ed\u30a2\u306e\u8a73\u7d30\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ca\u30a4\u30c8\u30b7\u30c6\u30a3\u30ec\u30fc\u30b7\u30f3\u30b0\u306e\u30de\u30c3\u30d7\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u30ed\u30a2\u304c\u8c4a\u5bcc\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u91d1\u878d\u5730\u533a\u306e\u653e\u68c4\u3055\u308c\u305f\u30b9\u30ab\u30a4\u30e9\u30a4\u30f3\u30bf\u30ef\u30fc\u306f\u3001\u5931\u6557\u3057\u305f\u4f01\u696d\u4e8b\u696d\u306b\u95a2\u3059\u308b\u80cc\u666f\u30b9\u30c8\u30fc\u30ea\u30fc\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002\u30b3\u30ec\u30af\u30c6\u30a3\u30d6\u3067\u3042\u308bCEO\u306e\u65e5\u8a18\u306e\u3088\u3046\u306a\u3082\u306e\u3092\u5185\u90e8\u3092\u63a2\u691c\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u540c\u69d8\u306b\u3001\u300c\u65e7\u30c9\u30c3\u30af\u300d\u30a8\u30ea\u30a2\u306b\u306f\u3001\u5bc6\u8f38\u696d\u8005\u306b\u95a2\u3059\u308b\u8a71\u3092\u53c2\u7167\u3059\u308b\u843d\u66f8\u304d\u304c\u3042\u308a\u307e\u3059\u3002\u30ed\u30a2\u30c8\u30e9\u30c3\u30ab\u30fc\u3092\u4f7f\u7528\u3057\u3066\u3001\u767a\u898b\u5185\u5bb9\u3092\u8a18\u9332\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u3089\u306e\u8a73\u7d30\u306b\u3088\u308a\u3001\u7269\u8a9e\u3084\u63a2\u691c\u3092\u697d\u3057\u3080\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u30a2\u30d4\u30fc\u30eb\u3059\u308b\u30b2\u30fc\u30e0\u306e\u4e16\u754c\u306b\u6df1\u307f\u304c\u5897\u3057\u307e\u3059\u3002"}]
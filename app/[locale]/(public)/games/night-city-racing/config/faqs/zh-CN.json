[{"question": "\u5982\u4f55\u5728\u591c\u4e4b\u57ce\u8d5b\u8f66\u4e2d\u5b9a\u5236\u6211\u7684\u8d5b\u8f66\u4ee5\u63d0\u5347\u6027\u80fd\uff1f", "answer": "\u8981\u63d0\u5347\u591c\u4e4b\u57ce\u8d5b\u8f66\u7684\u8d5b\u8f66\u6027\u80fd\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u524d\u5f80\u8f66\u5e93\u83dc\u5355\uff0c\u9009\u62e9\u201c\u5b9a\u5236\u201d\u3002\u6b65\u9aa42 - \u5347\u7ea7\u5f15\u64ce\u4ee5\u83b7\u5f97\u66f4\u597d\u7684\u901f\u5ea6\u548c\u52a0\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u6da1\u8f6e\u589e\u538bV8\u5f15\u64ce\u53ef\u5c06\u901f\u5ea6\u63d0\u9ad815%\u3002\u6b65\u9aa43 - \u5b89\u88c5\u66f4\u597d\u7684\u8f6e\u80ce\uff0c\u4ee5\u6539\u5584\u5728\u591c\u4e4b\u57ce\u5149\u6ed1\u8857\u9053\u4e0a\u7684\u6293\u5730\u529b\u3002\u4f7f\u7528\u201c\u6027\u80fd\u6bd4\u8f83\u201d\u8868\u6743\u8861\u5404\u79cd\u9009\u9879\uff0c\u4f8b\u5982GripMaster\u548cSpeedDemon\u8f6e\u80ce\u3002\u6b64\u5916\uff0c\u8c03\u6574\u60ac\u6302\u7cfb\u7edf\uff0c\u4f7f\u8f6c\u5f2f\u66f4\u654f\u6377\u3002\u8bb0\u4f4f\uff0c\u5e73\u8861\u901f\u5ea6\u548c\u64cd\u63a7\u6027\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u7684\u8d5b\u8f66\u5728\u591c\u4e4b\u57ce\u8d5b\u8f66\u7684\u96e8\u5929\u6a21\u5f0f\u4e0b\u64cd\u63a7\u611f\u89c9\u4e0d\u540c\uff1f", "answer": "\u5728\u591c\u4e4b\u57ce\u8d5b\u8f66\u4e2d\uff0c\u96e8\u5929\u6a21\u5f0f\u4f1a\u4f7f\u9053\u8def\u53d8\u6e7f\uff0c\u964d\u4f4e\u6293\u5730\u529b\u5e76\u5f71\u54cd\u64cd\u63a7\u6027\u3002\u8fd9\u901a\u8fc7\u5148\u8fdb\u7684\u7269\u7406\u5f15\u64ce\u6a21\u62df\uff1a\u8f6e\u80ce\u6293\u5730\u529b\u4e0b\u964d30%\uff0c\u5236\u52a8\u8ddd\u79bb\u589e\u52a020%\u3002\u4f8b\u5982\uff0c\u9ed8\u8ba4\u8f6e\u80ce\u5728\u6025\u8f6c\u5f2f\u65f6\u53ef\u80fd\u4f1a\u6253\u6ed1\u3002\u4e3a\u4e86\u9002\u5e94\uff0c\u5207\u6362\u5230\u96e8\u5929\u4e13\u7528\u8f6e\u80ce\uff0c\u4f8b\u5982AquaTread\uff0c\u53ef\u5c06\u6293\u5730\u529b\u63d0\u9ad825%\u3002\u8c03\u6574\u9a7e\u9a76\u98ce\u683c\uff1a\u5728\u8f6c\u5f2f\u524d\u964d\u4f4e\u901f\u5ea6\uff0c\u907f\u514d\u7a81\u7136\u5236\u52a8\u3002\u4f7f\u7528\u201c\u64cd\u63a7\u6d41\u7a0b\u56fe\u201d\u6765\u51b3\u5b9a\u4f55\u65f6\u51cf\u901f\u6216\u52a0\u901f\u3002\u96e8\u5929\u6a21\u5f0f\u589e\u52a0\u4e86\u771f\u5b9e\u611f\uff0c\u4f46\u9700\u8981\u8fdb\u884c\u6218\u7565\u8c03\u6574\u3002"}, {"question": "\u5728\u4e2d\u7aefPC\u4e0a\uff0c\u591c\u4e4b\u57ce\u8d5b\u8f66\u7684\u6700\u4f73\u8bbe\u7f6e\u662f\u4ec0\u4e48\uff1f", "answer": "\u5bf9\u4e8e\u4e2d\u7aefPC\uff0c\u901a\u8fc7\u8c03\u6574\u4ee5\u4e0b\u8bbe\u7f6e\u6765\u4f18\u5316\u591c\u4e4b\u57ce\u8d5b\u8f66\u7684\u6027\u80fd\uff1a\u6b65\u9aa41 - \u5c06\u201c\u7eb9\u7406\u8d28\u91cf\u201d\u8bbe\u7f6e\u4e3a\u4e2d\u7b49\uff0c\u4ee5\u5e73\u8861\u89c6\u89c9\u6548\u679c\u548c\u6027\u80fd\u3002\u6b65\u9aa42 - \u5173\u95ed\u201c\u5149\u7ebf\u8ffd\u8e2a\u201d\uff0c\u4ee5\u5c06FPS\u63d0\u9ad820-30%\u3002\u6b65\u9aa43 - \u5c06\u201c\u9634\u5f71\u8d28\u91cf\u201d\u964d\u4f4e\u5230\u4f4e\u6216\u4e2d\u7b49\uff0c\u56e0\u4e3a\u9634\u5f71\u5360\u7528\u8d44\u6e90\u8f83\u591a\u3002\u4f8b\u5982\uff0c\u5728GTX 1660\u4e0a\uff0c\u8fd9\u4e9b\u66f4\u6539\u5c06FPS\u4ece40\u63d0\u9ad8\u523060\u3002\u4f7f\u7528\u201c\u914d\u7f6e\u6bd4\u8f83\u201d\u8868\u6d4b\u8bd5\u7ec4\u5408\u3002\u6b64\u5916\uff0c\u542f\u7528\u5782\u76f4\u540c\u6b65\u4ee5\u9632\u6b62\u753b\u9762\u6495\u88c2\u3002\u8fd9\u4e9b\u8c03\u6574\u53ef\u786e\u4fdd\u6d41\u7545\u7684\u6e38\u620f\u4f53\u9a8c\uff0c\u540c\u65f6\u4e0d\u5f71\u54cd\u89c6\u89c9\u6548\u679c\u3002"}, {"question": "\u5982\u4f55\u5728\u591c\u4e4b\u57ce\u8d5b\u8f66\u4e2d\u89e3\u9501\u9690\u85cf\u7684\u201c\u9713\u8679\u5e7d\u7075\u201d\u8d5b\u8f66\uff1f", "answer": "\u8981\u89e3\u9501\u201c\u9713\u8679\u5e7d\u7075\u201d\u8d5b\u8f66\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u5b8c\u6210\u6240\u670915\u573a\u591c\u4e4b\u57ce\u8857\u5934\u8d5b\u3002\u6b65\u9aa42 - \u5728\u6bcf\u4e00\u573a\u6bd4\u8d5b\u4e2d\u83b7\u5f973\u661f\u8bc4\u7ea7\uff0c\u786e\u4fdd\u6ca1\u6709\u78b0\u649e\u5e76\u4e14\u5708\u901f\u5f88\u5feb\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5e02\u4e2d\u5fc3\u51b2\u523a\u201d\u6bd4\u8d5b\u4e2d\uff0c\u5b8c\u6210\u65f6\u95f4\u4f4e\u4e8e2\u520630\u79d2\u3002\u6b65\u9aa43 - \u5728\u5348\u591c\uff08\u6e38\u620f\u65f6\u95f4\uff09\u8bbf\u95ee\u5de5\u4e1a\u533a\u9690\u85cf\u7684\u8f66\u5e93\u3002\u201c\u9713\u8679\u5e7d\u7075\u201d\u662f\u4e00\u6b3e\u9ad8\u901f\u3001\u9690\u79d8\u4e3b\u9898\u7684\u8d5b\u8f66\uff0c\u5e26\u6709\u72ec\u7279\u7684\u53d1\u5149\u8d34\u7eb8\u3002\u4f7f\u7528\u201c\u89e3\u9501\u8fdb\u5ea6\u8ffd\u8e2a\u5668\u201d\u6765\u76d1\u63a7\u60a8\u7684\u6210\u5c31\u3002\u8fd9\u6b3e\u8f66\u662f\u5956\u52b1\u73a9\u5bb6\u7cbe\u901a\u548c\u575a\u6301\u4e0d\u61c8\u7684\u56de\u62a5\u3002"}, {"question": "\u591c\u4e4b\u57ce\u8d5b\u8f66\u4e2d\u7684\u54ea\u79cd\u6bd4\u8d5b\u7c7b\u578b\u4e3a\u5347\u7ea7\u63d0\u4f9b\u6700\u591a\u7684XP\uff1f", "answer": "\u591c\u4e4b\u57ce\u8d5b\u8f66\u4e2d\u7684\u201c\u8010\u529b\u8d5b\u201d\u7531\u4e8e\u5176\u957f\u5ea6\u548c\u96be\u5ea6\uff0c\u4e3a\u5347\u7ea7\u63d0\u4f9b\u6700\u591a\u7684XP\u3002\u4f8b\u5982\uff0c\u201c\u591c\u4e4b\u57ce\u9a6c\u62c9\u677e\u201d\u6bd4\u8d5b\u7684\u6301\u7eed\u65f6\u95f4\u4e3a30\u5206\u949f\uff0c\u5956\u52b15000 XP\u3002\u4e3a\u4e86\u6700\u5927\u5316\u6536\u76ca\uff1a\u6b65\u9aa41 - \u4f7f\u7528\u8010\u4e45\u6027\u9ad8\u7684\u8d5b\u8f66\uff0c\u4f8b\u5982Titan GT\u3002\u6b65\u9aa42 - \u4fdd\u6301\u7a33\u5b9a\u7684\u5708\u901f\u4ee5\u83b7\u5f97\u989d\u5916XP\u3002\u6b65\u9aa43 - \u907f\u514d\u78b0\u649e\u7b49\u5904\u7f5a\uff0c\u8fd9\u4f1a\u4f7fXP\u964d\u4f4e10%\u3002\u4f7f\u7528\u201c\u6bd4\u8d5bXP\u6bd4\u8f83\u201d\u56fe\u8868\u6765\u8bc4\u4f30\u9009\u9879\u3002\u8010\u529b\u8d5b\u975e\u5e38\u9002\u5408\u90a3\u4e9b\u5e0c\u671b\u5feb\u901f\u5347\u7ea7\u5e76\u78e8\u7ec3\u6280\u80fd\u7684\u73a9\u5bb6\u3002"}, {"question": "\u591c\u4e4b\u57ce\u8d5b\u8f66\u7684AI\u96be\u5ea6\u7f29\u653e\u662f\u5982\u4f55\u5de5\u4f5c\u7684\uff1f", "answer": "\u591c\u4e4b\u57ce\u8d5b\u8f66\u7684AI\u4f7f\u7528\u52a8\u6001\u7f29\u653e\u7cfb\u7edf\u9002\u5e94\u60a8\u7684\u6280\u80fd\u6c34\u5e73\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u8d62\u5f97\u4e09\u573a\u8fde\u7eed\u6bd4\u8d5b\uff0cAI\u5bf9\u624b\u7684\u901f\u5ea6\u548c\u653b\u51fb\u6027\u5c06\u63d0\u9ad815%\u3002\u76f8\u53cd\uff0c\u8f93\u6389\u591a\u573a\u6bd4\u8d5b\u4f1a\u964d\u4f4e\u4ed6\u4eec\u7684\u96be\u5ea610%\u3002\u8fd9\u786e\u4fdd\u4e86\u5e73\u8861\u7684\u7ade\u4e89\u3002\u4f7f\u7528\u201cAI\u884c\u4e3a\u56fe\u8868\u201d\u6765\u9884\u6d4b\u53d8\u5316\u3002\u8981\u91cd\u7f6e\u96be\u5ea6\uff0c\u8bf7\u5728\u4e0d\u83b7\u80dc\u7684\u60c5\u51b5\u4e0b\u5b8c\u6210\u4e94\u573a\u8d5b\u8f66\u3002\u8be5\u7cfb\u7edf\u4fdd\u6301\u6e38\u620f\u5177\u6709\u6311\u6218\u6027\u4f46\u516c\u5e73\uff0c\u8fce\u5408\u521d\u5b66\u8005\u548c\u8001\u624b\u3002"}, {"question": "\u201c\u591c\u4e4b\u57ce\u8d5b\u9053\u201d\u6392\u884c\u699c\u7684\u610f\u4e49\u662f\u4ec0\u4e48\uff1f", "answer": "\u201c\u591c\u4e4b\u57ce\u8d5b\u9053\u201d\u6392\u884c\u699c\u6839\u636e\u73a9\u5bb6\u5728\u6e38\u620f\u4e2d\u6700\u5177\u6311\u6218\u6027\u7684\u6bd4\u8d5b\u4e2d\u7684\u8868\u73b0\u5bf9\u73a9\u5bb6\u8fdb\u884c\u6392\u540d\u3002\u5b83\u8ddf\u8e2a\u8bf8\u5982\u5708\u901f\u3001\u78b0\u649e\u7387\u548c\u6574\u4f53\u4e00\u81f4\u6027\u7b49\u6307\u6807\u3002\u4f8b\u5982\uff0c\u524d10\u540d\u73a9\u5bb6\u5728\u201c\u66ae\u8272\u73af\u5f62\u8def\u201d\u6bd4\u8d5b\u4e2d\u7684\u5708\u901f\u901a\u5e38\u4f4e\u4e8e1\u520645\u79d2\u3002\u201c\u6392\u884c\u699c\u201d\u5956\u52b1\u72ec\u5bb6\u7269\u54c1\uff0c\u4f8b\u5982\u201c\u8d5b\u9053\u51a0\u519b\u201d\u8d34\u7eb8\u3002\u4f7f\u7528\u201c\u6392\u884c\u699c\u5206\u6790\u201d\u5de5\u5177\u5c06\u60a8\u7684\u7edf\u8ba1\u6570\u636e\u4e0e\u9876\u7ea7\u73a9\u5bb6\u8fdb\u884c\u6bd4\u8f83\u3002\u6500\u767b\u6392\u884c\u699c\u9700\u8981\u7cbe\u786e\u6027\u3001\u7b56\u7565\u548c\u7ec3\u4e60\u3002"}, {"question": "\u6211\u80fd\u5426\u5c06\u6211\u7684\u591c\u4e4b\u57ce\u8d5b\u8f66PC\u8fdb\u5ea6\u8f6c\u79fb\u5230\u6e38\u620f\u673a\uff1f", "answer": "\u662f\u7684\uff0c\u591c\u4e4b\u57ce\u8d5b\u8f66\u652f\u6301\u901a\u8fc7\u4e91\u4fdd\u5b58\u8fdb\u884c\u8de8\u5e73\u53f0\u8fdb\u5ea6\u8f6c\u79fb\u3002\u6b65\u9aa41 - \u5728\u4e24\u4e2a\u5e73\u53f0\u4e0a\u767b\u5f55\u60a8\u7684\u5e10\u6237\u3002\u6b65\u9aa42 - \u901a\u8fc7\u8bbe\u7f6e\u83dc\u5355\u4e2d\u7684\u201c\u4e91\u4fdd\u5b58\u201d\u9009\u9879\u540c\u6b65\u60a8\u7684\u6570\u636e\u3002\u4f8b\u5982\uff0c\u60a8\u89e3\u9501\u7684\u8d5b\u8f66\u548c\u6bd4\u8d5b\u8fdb\u5ea6\u5c06\u663e\u793a\u5728\u65b0\u5e73\u53f0\u4e0a\u3002\u4f46\u662f\uff0c\u8bf7\u6ce8\u610f\uff0c\u5e73\u53f0\u7279\u5b9a\u7684\u6210\u5c31\u53ef\u80fd\u65e0\u6cd5\u8f6c\u79fb\u3002\u4f7f\u7528\u201c\u6570\u636e\u8fc1\u79fb\u6307\u5357\u201d\u6765\u89e3\u51b3\u4efb\u4f55\u95ee\u9898\u3002\u6b64\u529f\u80fd\u786e\u4fdd\u4e86\u8de8\u8bbe\u5907\u7684\u6d41\u7545\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u5982\u4f55\u5728\u591c\u4e4b\u57ce\u8d5b\u8f66\u4e2d\u4f18\u5316\u8d5b\u8f66\u7684\u71c3\u6cb9\u6548\u7387\uff1f", "answer": "\u8981\u5728\u591c\u4e4b\u57ce\u8d5b\u8f66\u4e2d\u63d0\u9ad8\u71c3\u6cb9\u6548\u7387\uff1a\u6b65\u9aa41 - \u5347\u7ea7\u5230\u6df7\u5408\u52a8\u529b\u6216\u7535\u52a8\u5f15\u64ce\uff0c\u4f8b\u5982EcoDrive\uff0c\u53ef\u5c06\u71c3\u6cb9\u6d88\u8017\u964d\u4f4e40%\u3002\u6b65\u9aa42 - \u4f7f\u7528\u201c\u8282\u80fd\u6a21\u5f0f\u201d\u9a7e\u9a76\u8f85\u52a9\u7cfb\u7edf\uff0c\u8be5\u7cfb\u7edf\u4f1a\u9650\u5236\u52a0\u901f\u5e76\u4fdd\u6301\u7a33\u5b9a\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u201c\u57ce\u5e02\u51b2\u523a\u201d\u6bd4\u8d5b\u4e2d\uff0c\u8282\u80fd\u6a21\u5f0f\u53ef\u8282\u770120%\u7684\u71c3\u6cb9\u3002\u6b65\u9aa43 - \u907f\u514d\u4e0d\u5fc5\u8981\u7684\u52a0\u901f\u548c\u6fc0\u8fdb\u9a7e\u9a76\uff0c\u8fd9\u4f1a\u589e\u52a0\u71c3\u6cb9\u6d88\u8017\u3002\u4f7f\u7528\u201c\u71c3\u6cb9\u6548\u7387\u56fe\u201d\u6bd4\u8f83\u5f15\u64ce\u3002\u9ad8\u6548\u9a7e\u9a76\u4e0d\u4ec5\u53ef\u4ee5\u8282\u7701\u8d44\u6e90\uff0c\u8fd8\u53ef\u4ee5\u51cf\u5c11\u52a0\u6cb9\u7ad9\u505c\u9760\u65f6\u95f4\u3002"}, {"question": "\u591c\u4e4b\u57ce\u8d5b\u8f66\u5730\u56fe\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u7684\u80cc\u666f\u6545\u4e8b\u7ec6\u8282\uff1f", "answer": "\u591c\u4e4b\u57ce\u8d5b\u8f66\u7684\u5730\u56fe\u5145\u6ee1\u4e86\u9690\u85cf\u7684\u80cc\u666f\u6545\u4e8b\u3002\u4f8b\u5982\uff0c\u91d1\u878d\u533a\u5e9f\u5f03\u7684\u201c\u5929\u9645\u5854\u201d\u6709\u4e00\u4e2a\u5173\u4e8e\u5931\u8d25\u7684\u4f01\u4e1a\u9879\u76ee\u7684\u80cc\u666f\u6545\u4e8b\u3002\u63a2\u7d22\u5176\u5185\u90e8\u533a\u57df\u4ee5\u6536\u96c6\u201c\u9996\u5e2d\u6267\u884c\u5b98\u65e5\u8bb0\u672c\u201d\u7b49\u6536\u85cf\u54c1\u3002\u7c7b\u4f3c\u5730\uff0c\u201c\u8001\u7801\u5934\u201d\u533a\u57df\u7684\u6d82\u9e26\u63d0\u5230\u4e86\u4e00\u4e2a\u8d70\u79c1\u8005\u7684\u6545\u4e8b\u3002\u4f7f\u7528\u201c\u80cc\u666f\u6545\u4e8b\u8ffd\u8e2a\u5668\u201d\u6765\u8bb0\u5f55\u53d1\u73b0\u3002\u8fd9\u4e9b\u7ec6\u8282\u4e3a\u6e38\u620f\u4e16\u754c\u589e\u6dfb\u4e86\u6df1\u5ea6\uff0c\u5438\u5f15\u4e86\u559c\u6b22\u6545\u4e8b\u548c\u63a2\u7d22\u7684\u73a9\u5bb6\u3002"}]
[{"question": "\u041a\u0430\u043a \u043c\u043e\u0436\u043d\u043e \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0441\u0432\u043e\u0439 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c \u0432 \u0433\u043e\u043d\u043a\u0430\u0445 Night City \u0434\u043b\u044f \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438?", "answer": "\u0414\u043b\u044f \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0432\u0430\u0448\u0435\u0433\u043e \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f \u0432 \u0433\u043e\u043d\u043a\u0430\u0445 Night City \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u0435 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435 \u0448\u0430\u0433\u0438: \u042d\u0422\u0410\u041f 1 - \u041f\u0435\u0440\u0435\u0439\u0434\u0438\u0442\u0435 \u0432 \u043c\u0435\u043d\u044e \u00ab\u0413\u0430\u0440\u0430\u0436\u00bb \u0438 \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u00ab\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u00bb. \u042d\u0422\u0410\u041f 2 - \u0423\u043b\u0443\u0447\u0448\u0438\u0442\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c \u0434\u043b\u044f \u043b\u0443\u0447\u0448\u0435\u0439 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u0438 \u0440\u0430\u0437\u0433\u043e\u043d\u0430. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044c Turbo V8 \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u043d\u0430 15%. \u042d\u0422\u0410\u041f 3 - \u0423\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u043b\u0443\u0447\u0448\u0438\u0435 \u0448\u0438\u043d\u044b \u0434\u043b\u044f \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u043d\u043e\u0433\u043e \u0441\u0446\u0435\u043f\u043b\u0435\u043d\u0438\u044f \u043d\u0430 \u0441\u043a\u043e\u043b\u044c\u0437\u043a\u0438\u0445 \u0443\u043b\u0438\u0446\u0430\u0445 Night City. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0442\u0430\u0431\u043b\u0438\u0446\u0443 \u00ab\u0421\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438\u00bb, \u0447\u0442\u043e\u0431\u044b \u0432\u0437\u0432\u0435\u0441\u0438\u0442\u044c \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b, \u0442\u0430\u043a\u0438\u0435 \u043a\u0430\u043a \u0448\u0438\u043d\u044b GripMaster \u0438 SpeedDemon. \u041a\u0440\u043e\u043c\u0435 \u0442\u043e\u0433\u043e, \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u0442\u0435 \u043f\u043e\u0434\u0432\u0435\u0441\u043a\u0443 \u0434\u043b\u044f \u0431\u043e\u043b\u0435\u0435 \u0440\u0435\u0437\u043a\u0438\u0445 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043e\u0432. \u041f\u043e\u043c\u043d\u0438\u0442\u0435, \u0447\u0442\u043e \u0431\u0430\u043b\u0430\u043d\u0441 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043a\u043b\u044e\u0447\u043e\u043c."}, {"question": "\u041f\u043e\u0447\u0435\u043c\u0443 \u043c\u043e\u0435 \u0430\u0432\u0442\u043e \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0438\u043d\u0430\u0447\u0435 \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 \u0434\u043e\u0436\u0434\u044f \u0432 \u0433\u043e\u043d\u043a\u0430\u0445 Night City?", "answer": "\u0412 \u0433\u043e\u043d\u043a\u0430\u0445 Night City \u0440\u0435\u0436\u0438\u043c \u0434\u043e\u0436\u0434\u044f \u0432\u0432\u043e\u0434\u0438\u0442 \u043c\u043e\u043a\u0440\u044b\u0435 \u0434\u043e\u0440\u043e\u0433\u0438, \u0443\u043c\u0435\u043d\u044c\u0448\u0430\u044f \u0441\u0446\u0435\u043f\u043b\u0435\u043d\u0438\u0435 \u0438 \u0432\u043b\u0438\u044f\u044f \u043d\u0430 \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u043c\u043e\u0441\u0442\u044c. \u042d\u0442\u043e \u043c\u043e\u0434\u0435\u043b\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043f\u0440\u043e\u0434\u0432\u0438\u043d\u0443\u0442\u043e\u0439 \u0444\u0438\u0437\u0438\u043a\u0438: \u0448\u0438\u043d\u044b \u0442\u0435\u0440\u044f\u044e\u0442 30% \u0441\u0446\u0435\u043f\u043b\u0435\u043d\u0438\u044f, \u0430 \u0442\u043e\u0440\u043c\u043e\u0437\u043d\u043e\u0439 \u043f\u0443\u0442\u044c \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043d\u0430 20%. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0448\u0442\u0430\u0442\u043d\u044b\u0435 \u0448\u0438\u043d\u044b \u043c\u043e\u0433\u0443\u0442 \u0437\u0430\u043d\u043e\u0441\u0438\u0442\u044c \u043d\u0430 \u0440\u0435\u0437\u043a\u0438\u0445 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430\u0445. \u0414\u043b\u044f \u0430\u0434\u0430\u043f\u0442\u0430\u0446\u0438\u0438 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u0441\u044c \u043d\u0430 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0448\u0438\u043d\u044b \u0434\u043b\u044f \u0434\u043e\u0436\u0434\u044f, \u0442\u0430\u043a\u0438\u0435 \u043a\u0430\u043a AquaTread, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0443\u043b\u0443\u0447\u0448\u0430\u044e\u0442 \u0441\u0446\u0435\u043f\u043b\u0435\u043d\u0438\u0435 \u043d\u0430 25%. \u0418\u0437\u043c\u0435\u043d\u0438\u0442\u0435 \u0441\u0442\u0438\u043b\u044c \u0432\u043e\u0436\u0434\u0435\u043d\u0438\u044f: \u0441\u043d\u0438\u0437\u044c\u0442\u0435 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u043f\u0435\u0440\u0435\u0434 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u0430\u043c\u0438 \u0438 \u0438\u0437\u0431\u0435\u0433\u0430\u0439\u0442\u0435 \u0440\u0435\u0437\u043a\u043e\u0433\u043e \u0442\u043e\u0440\u043c\u043e\u0436\u0435\u043d\u0438\u044f. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u00ab\u0414\u0438\u0430\u0433\u0440\u0430\u043c\u043c\u0443 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f\u00bb \u0434\u043b\u044f \u043f\u0440\u0438\u043d\u044f\u0442\u0438\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u043e \u0442\u043e\u043c, \u043a\u043e\u0433\u0434\u0430 \u043d\u0443\u0436\u043d\u043e \u0441\u0431\u0430\u0432\u0438\u0442\u044c \u0438\u043b\u0438 \u0443\u0441\u043a\u043e\u0440\u0438\u0442\u044c\u0441\u044f. \u0420\u0435\u0436\u0438\u043c \u0434\u043e\u0436\u0434\u044f \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u0442 \u0440\u0435\u0430\u043b\u0438\u0437\u043c, \u043d\u043e \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a."}, {"question": "\u041a\u0430\u043a\u0438\u0435 \u043b\u0443\u0447\u0448\u0438\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0434\u043b\u044f Night City Racing \u043d\u0430 \u041f\u041a \u0441\u0440\u0435\u0434\u043d\u0435\u0433\u043e \u043a\u043b\u0430\u0441\u0441\u0430?", "answer": "\u0414\u043b\u044f \u041f\u041a \u0441\u0440\u0435\u0434\u043d\u0435\u0433\u043e \u043a\u043b\u0430\u0441\u0441\u0430 \u043e\u043f\u0442\u0438\u043c\u0438\u0437\u0438\u0440\u0443\u0439\u0442\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c Night City Racing, \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u0432 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b: \u042d\u0422\u0410\u041f 1 - \u0423\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u00ab\u041a\u0430\u0447\u0435\u0441\u0442\u0432\u043e \u0442\u0435\u043a\u0441\u0442\u0443\u0440\u00bb \u043d\u0430 \u00ab\u0421\u0440\u0435\u0434\u043d\u0435\u0435\u00bb, \u0447\u0442\u043e\u0431\u044b \u0441\u0431\u0430\u043b\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0432\u0438\u0437\u0443\u0430\u043b\u044c\u043d\u044b\u0435 \u044d\u0444\u0444\u0435\u043a\u0442\u044b \u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c. \u042d\u0422\u0410\u041f 2 - \u041e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u00ab\u0422\u0440\u0430\u0441\u0441\u0438\u0440\u043e\u0432\u043a\u0443 \u043b\u0443\u0447\u0435\u0439\u00bb, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0432\u044b\u0441\u0438\u0442\u044c FPS \u043d\u0430 20-30%. \u042d\u0422\u0410\u041f 3 - \u0421\u043d\u0438\u0437\u044c\u0442\u0435 \u00ab\u041a\u0430\u0447\u0435\u0441\u0442\u0432\u043e \u0442\u0435\u043d\u0435\u0439\u00bb \u0434\u043e \u00ab\u041d\u0438\u0437\u043a\u043e\u0433\u043e\u00bb \u0438\u043b\u0438 \u00ab\u0421\u0440\u0435\u0434\u043d\u0435\u0433\u043e\u00bb, \u0442\u0430\u043a \u043a\u0430\u043a \u0442\u0435\u043d\u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u043e\u0435\u043c\u043a\u0438. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043d\u0430 GTX 1660 \u044d\u0442\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u044e\u0442 FPS \u0441 40 \u0434\u043e 60. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0442\u0430\u0431\u043b\u0438\u0446\u0443 \u00ab\u0421\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a\u00bb, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438. \u041a\u0440\u043e\u043c\u0435 \u0442\u043e\u0433\u043e, \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u0435 VSync, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0442\u0438\u0442\u044c \u0440\u0430\u0437\u0440\u044b\u0432\u044b \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f. \u042d\u0442\u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u044e\u0442 \u043f\u043b\u0430\u0432\u043d\u0443\u044e \u0438\u0433\u0440\u0443, \u043d\u0435 \u0436\u0435\u0440\u0442\u0432\u0443\u044f \u0432\u0438\u0437\u0443\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0449\u0435\u0439."}, {"question": "\u041a\u0430\u043a \u0440\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0441\u0435\u043a\u0440\u0435\u0442\u043d\u044b\u0439 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c \u00ab\u041d\u0435\u043e\u043d\u043e\u0432\u044b\u0439 \u043f\u0440\u0438\u0437\u0440\u0430\u043a\u00bb \u0432 \u0433\u043e\u043d\u043a\u0430\u0445 Night City?", "answer": "\u0427\u0442\u043e\u0431\u044b \u0440\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c \u00ab\u041d\u0435\u043e\u043d\u043e\u0432\u044b\u0439 \u043f\u0440\u0438\u0437\u0440\u0430\u043a\u00bb, \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u0435 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435 \u0448\u0430\u0433\u0438: \u042d\u0422\u0410\u041f 1 - \u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u0432\u0441\u0435 15 \u0443\u043b\u0438\u0447\u043d\u044b\u0445 \u0433\u043e\u043d\u043e\u043a Night City. \u042d\u0422\u0410\u041f 2 - \u0414\u043e\u0441\u0442\u0438\u0433\u043d\u0438\u0442\u0435 \u043e\u0446\u0435\u043d\u043a\u0438 3 \u0437\u0432\u0435\u0437\u0434\u044b \u0432 \u043a\u0430\u0436\u0434\u043e\u0439 \u0433\u043e\u043d\u043a\u0435, \u0438\u0437\u0431\u0435\u0433\u0430\u044f \u0441\u0442\u043e\u043b\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u0439 \u0438 \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u044f \u0431\u044b\u0441\u0442\u0440\u044b\u0435 \u043a\u0440\u0443\u0433\u0438. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0432 \u0433\u043e\u043d\u043a\u0435 \u00ab\u041c\u0447\u0430\u0449\u0438\u0439\u0441\u044f \u043f\u043e \u0446\u0435\u043d\u0442\u0440\u0443\u00bb \u0444\u0438\u043d\u0438\u0448\u0438\u0440\u0443\u0439\u0442\u0435 \u0437\u0430 2:30 \u043c\u0438\u043d\u0443\u0442\u044b. \u042d\u0422\u0410\u041f 3 - \u041f\u043e\u0441\u0435\u0442\u0438\u0442\u0435 \u0441\u043a\u0440\u044b\u0442\u044b\u0439 \u0433\u0430\u0440\u0430\u0436 \u0432 \u043f\u0440\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043e\u0439 \u0437\u043e\u043d\u0435 \u0432 \u043f\u043e\u043b\u043d\u043e\u0447\u044c (\u0432 \u0438\u0433\u0440\u043e\u0432\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438). \u00ab\u041d\u0435\u043e\u043d\u043e\u0432\u044b\u0439 \u043f\u0440\u0438\u0437\u0440\u0430\u043a\u00bb \u2014 \u044d\u0442\u043e \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u043d\u043e\u0439 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c \u0441 \u0442\u0435\u043c\u0430\u0442\u0438\u043a\u043e\u0439 \u0441\u0442\u0435\u043b\u0441 \u0438 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u0441\u0432\u0435\u0442\u044f\u0449\u0438\u043c\u0438\u0441\u044f \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0430\u043c\u0438. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u00ab\u0422\u0440\u0435\u043a\u0435\u0440 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0430 \u0440\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0438\u00bb, \u0447\u0442\u043e\u0431\u044b \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u0438 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f. \u042d\u0442\u0430 \u043c\u0430\u0448\u0438\u043d\u0430 \u2014 \u043d\u0430\u0433\u0440\u0430\u0434\u0430 \u0437\u0430 \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043e \u0438 \u043d\u0430\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u043e\u0441\u0442\u044c."}, {"question": "\u041a\u0430\u043a\u043e\u0439 \u0442\u0438\u043f \u0433\u043e\u043d\u043e\u043a \u0432 Night City Racing \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u0435\u0442 \u043d\u0430\u0438\u0431\u043e\u043b\u044c\u0448\u0435\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043e\u043f\u044b\u0442\u0430 \u0434\u043b\u044f \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u044f \u0443\u0440\u043e\u0432\u043d\u044f?", "answer": "\u00ab\u0413\u043e\u043d\u043a\u0438 \u043d\u0430 \u0432\u044b\u043d\u043e\u0441\u043b\u0438\u0432\u043e\u0441\u0442\u044c\u00bb \u0432 Night City Racing \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442 \u043d\u0430\u0438\u0431\u043e\u043b\u044c\u0448\u0435\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043e\u043f\u044b\u0442\u0430 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0438\u0445 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0438 \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u00ab\u041d\u043e\u0447\u043d\u043e\u0439 \u043c\u0430\u0440\u0430\u0444\u043e\u043d Night City\u00bb \u043d\u0430\u0433\u0440\u0430\u0436\u0434\u0430\u0435\u0442 5000 \u043e\u0447\u043a\u043e\u0432 \u043e\u043f\u044b\u0442\u0430 \u0437\u0430 \u0433\u043e\u043d\u043a\u0443 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c\u044e 30 \u043c\u0438\u043d\u0443\u0442. \u0414\u043b\u044f \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u043e\u043f\u044b\u0442\u0430: \u042d\u0422\u0410\u041f 1 - \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c \u0441 \u0432\u044b\u0441\u043e\u043a\u043e\u0439 \u043f\u0440\u043e\u0447\u043d\u043e\u0441\u0442\u044c\u044e, \u0442\u0430\u043a\u043e\u0439 \u043a\u0430\u043a Titan GT. \u042d\u0422\u0410\u041f 2 - \u041f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u044b\u0435 \u043a\u0440\u0443\u0433\u0438, \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0431\u043e\u043d\u0443\u0441\u043d\u044b\u0439 \u043e\u043f\u044b\u0442. \u042d\u0422\u0410\u041f 3 - \u0418\u0437\u0431\u0435\u0433\u0430\u0439\u0442\u0435 \u0448\u0442\u0440\u0430\u0444\u043e\u0432, \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a \u0441\u0442\u043e\u043b\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0443\u043c\u0435\u043d\u044c\u0448\u0430\u044e\u0442 \u043e\u043f\u044b\u0442 \u043d\u0430 10%. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0442\u0430\u0431\u043b\u0438\u0446\u0443 \u00ab\u0421\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \u043e\u043f\u044b\u0442\u0430 \u0433\u043e\u043d\u043e\u043a\u00bb, \u0447\u0442\u043e\u0431\u044b \u043e\u0446\u0435\u043d\u0438\u0442\u044c \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b. \u0413\u043e\u043d\u043a\u0438 \u043d\u0430 \u0432\u044b\u043d\u043e\u0441\u043b\u0438\u0432\u043e\u0441\u0442\u044c \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0442 \u0434\u043b\u044f \u0438\u0433\u0440\u043e\u043a\u043e\u0432, \u0441\u0442\u0440\u0435\u043c\u044f\u0449\u0438\u0445\u0441\u044f \u0431\u044b\u0441\u0442\u0440\u043e \u043f\u043e\u0432\u044b\u0441\u0438\u0442\u044c \u0443\u0440\u043e\u0432\u0435\u043d\u044c, \u043e\u0442\u0442\u0430\u0447\u0438\u0432\u0430\u044f \u0441\u0432\u043e\u0438 \u043d\u0430\u0432\u044b\u043a\u0438."}, {"question": "\u041a\u0430\u043a \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0418\u0418 \u0432 \u0433\u043e\u043d\u043a\u0430\u0445 Night City?", "answer": "\u0418\u0418 \u0433\u043e\u043d\u043e\u043a Night City \u0430\u0434\u0430\u043f\u0442\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u043a \u0432\u0430\u0448\u0435\u043c\u0443 \u0443\u0440\u043e\u0432\u043d\u044e \u043d\u0430\u0432\u044b\u043a\u043e\u0432 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0435\u0441\u043b\u0438 \u0432\u044b \u0432\u044b\u0438\u0433\u0440\u044b\u0432\u0430\u0435\u0442\u0435 \u0442\u0440\u0438 \u0433\u043e\u043d\u043a\u0438 \u043f\u043e\u0434\u0440\u044f\u0434, \u0441\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u0438 \u0418\u0418 \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0442\u0441\u044f \u043d\u0430 15% \u0431\u044b\u0441\u0442\u0440\u0435\u0435 \u0438 \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u0435\u0435. \u041d\u0430\u043e\u0431\u043e\u0440\u043e\u0442, \u043f\u0440\u043e\u0438\u0433\u0440\u044b\u0448 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u0433\u043e\u043d\u043e\u043a \u0443\u043c\u0435\u043d\u044c\u0448\u0430\u0435\u0442 \u0438\u0445 \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043d\u0430 10%. \u042d\u0442\u043e \u0433\u0430\u0440\u0430\u043d\u0442\u0438\u0440\u0443\u0435\u0442 \u0441\u0431\u0430\u043b\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0443\u044e \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0446\u0438\u044e. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u00ab\u0414\u0438\u0430\u0433\u0440\u0430\u043c\u043c\u0443 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0418\u0418\u00bb, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u0442\u044c \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f. \u0414\u043b\u044f \u0441\u0431\u0440\u043e\u0441\u0430 \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u043f\u044f\u0442\u044c \u0433\u043e\u043d\u043e\u043a, \u043d\u0435 \u043e\u0434\u0435\u0440\u0436\u0430\u0432 \u043d\u0438 \u043e\u0434\u043d\u043e\u0439 \u043f\u043e\u0431\u0435\u0434\u044b. \u042d\u0442\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442 \u0438\u0433\u0440\u0443 \u0441\u043b\u043e\u0436\u043d\u043e\u0439, \u043d\u043e \u0441\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u043e\u0439, \u0443\u0434\u043e\u0432\u043b\u0435\u0442\u0432\u043e\u0440\u044f\u044f \u043a\u0430\u043a \u043d\u043e\u0432\u0438\u0447\u043a\u043e\u0432, \u0442\u0430\u043a \u0438 \u0432\u0435\u0442\u0435\u0440\u0430\u043d\u043e\u0432."}, {"question": "\u041a\u0430\u043a\u043e\u0432\u043e \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u0442\u0430\u0431\u043b\u0438\u0446\u044b \u043b\u0438\u0434\u0435\u0440\u043e\u0432 \u00ab\u0422\u0440\u0430\u0441\u0441\u0430 Night City\u00bb?", "answer": "\u0422\u0430\u0431\u043b\u0438\u0446\u0430 \u043b\u0438\u0434\u0435\u0440\u043e\u0432 \u00ab\u0422\u0440\u0430\u0441\u0441\u0430 Night City\u00bb \u0440\u0430\u043d\u0436\u0438\u0440\u0443\u0435\u0442 \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u0438\u0445 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432 \u0432 \u0441\u0430\u043c\u044b\u0445 \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u0433\u043e\u043d\u043a\u0430\u0445 \u0438\u0433\u0440\u044b. \u041e\u043d\u0430 \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u0435\u0442 \u0442\u0430\u043a\u0438\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438, \u043a\u0430\u043a \u0432\u0440\u0435\u043c\u044f \u043a\u0440\u0443\u0433\u0430, \u0447\u0430\u0441\u0442\u043e\u0442\u0430 \u0441\u0442\u043e\u043b\u043a\u043d\u043e\u0432\u0435\u043d\u0438\u0439 \u0438 \u043e\u0431\u0449\u0430\u044f \u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u044c. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0443 10 \u043b\u0443\u0447\u0448\u0438\u0445 \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0447\u0430\u0441\u0442\u043e \u0432\u0440\u0435\u043c\u044f \u043a\u0440\u0443\u0433\u0430 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u043c\u0435\u043d\u0435\u0435 1:45 \u043c\u0438\u043d\u0443\u0442\u044b \u0432 \u00ab\u0417\u0430\u043a\u0430\u0442\u043d\u043e\u043c \u043a\u043e\u043b\u044c\u0446\u0435\u00bb. \u0422\u0430\u0431\u043b\u0438\u0446\u0430 \u043b\u0438\u0434\u0435\u0440\u043e\u0432 \u043d\u0430\u0433\u0440\u0430\u0436\u0434\u0430\u0435\u0442 \u044d\u043a\u0441\u043a\u043b\u044e\u0437\u0438\u0432\u043d\u044b\u043c\u0438 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430\u043c\u0438, \u0442\u0430\u043a\u0438\u043c\u0438 \u043a\u0430\u043a \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0430 \u00ab\u0427\u0435\u043c\u043f\u0438\u043e\u043d \u0442\u0440\u0430\u0441\u0441\u044b\u00bb. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u00ab\u0410\u043d\u0430\u043b\u0438\u0437 \u0442\u0430\u0431\u043b\u0438\u0446\u044b \u043b\u0438\u0434\u0435\u0440\u043e\u0432\u00bb, \u0447\u0442\u043e\u0431\u044b \u0441\u0440\u0430\u0432\u043d\u0438\u0442\u044c \u0441\u0432\u043e\u0438 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u0441 \u043b\u0443\u0447\u0448\u0438\u043c\u0438 \u0438\u0433\u0440\u043e\u043a\u0430\u043c\u0438. \u041f\u043e\u0434\u044a\u0435\u043c \u043f\u043e \u0440\u0435\u0439\u0442\u0438\u043d\u0433\u0443 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438, \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0438 \u0438 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0438."}, {"question": "\u041c\u043e\u0433\u0443 \u043b\u0438 \u044f \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0442\u0438 \u0441\u0432\u043e\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441 \u0432 \u0433\u043e\u043d\u043a\u0430\u0445 Night City \u0441 \u041f\u041a \u043d\u0430 \u043a\u043e\u043d\u0441\u043e\u043b\u044c?", "answer": "\u0414\u0430, \u0433\u043e\u043d\u043a\u0438 Night City \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0442 \u043f\u0435\u0440\u0435\u043d\u043e\u0441 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0430 \u043c\u0435\u0436\u0434\u0443 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430\u043c\u0438 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043e\u0431\u043b\u0430\u0447\u043d\u044b\u0445 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0439. \u042d\u0422\u0410\u041f 1 - \u0412\u043e\u0439\u0434\u0438\u0442\u0435 \u0432 \u0441\u0432\u043e\u044e \u0443\u0447\u0435\u0442\u043d\u0443\u044e \u0437\u0430\u043f\u0438\u0441\u044c \u043d\u0430 \u043e\u0431\u0435\u0438\u0445 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430\u0445. \u042d\u0422\u0410\u041f 2 - \u0421\u0438\u043d\u0445\u0440\u043e\u043d\u0438\u0437\u0438\u0440\u0443\u0439\u0442\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u0447\u0435\u0440\u0435\u0437 \u043e\u043f\u0446\u0438\u044e \u00ab\u041e\u0431\u043b\u0430\u0447\u043d\u043e\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435\u00bb \u0432 \u043c\u0435\u043d\u044e \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0432\u0430\u0448\u0438 \u0440\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u0438 \u0438 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441 \u0432 \u0433\u043e\u043d\u043a\u0430\u0445 \u0431\u0443\u0434\u0443\u0442 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0442\u044c\u0441\u044f \u043d\u0430 \u043d\u043e\u0432\u043e\u0439 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0435. \u041e\u0434\u043d\u0430\u043a\u043e \u043e\u0431\u0440\u0430\u0442\u0438\u0442\u0435 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435, \u0447\u0442\u043e \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f, \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u043d\u044b\u0435 \u0434\u043b\u044f \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u044b, \u043c\u043e\u0433\u0443\u0442 \u043d\u0435 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0442\u0438\u0441\u044c. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u00ab\u0420\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u043e \u043f\u043e \u043c\u0438\u0433\u0440\u0430\u0446\u0438\u0438 \u0434\u0430\u043d\u043d\u044b\u0445\u00bb, \u0447\u0442\u043e\u0431\u044b \u0443\u0441\u0442\u0440\u0430\u043d\u0438\u0442\u044c \u043b\u044e\u0431\u044b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b. \u0414\u0430\u043d\u043d\u0430\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u044f \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0431\u0435\u0441\u0448\u043e\u0432\u043d\u0443\u044e \u0438\u0433\u0440\u0443 \u043d\u0430 \u0440\u0430\u0437\u043d\u044b\u0445 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430\u0445."}, {"question": "\u041a\u0430\u043a \u043e\u043f\u0442\u0438\u043c\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0442\u043e\u043f\u043b\u0438\u0432\u043d\u0443\u044e \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u043c\u043e\u0435\u0433\u043e \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044f \u0432 \u0433\u043e\u043d\u043a\u0430\u0445 Night City?", "answer": "\u0414\u043b\u044f \u043f\u043e\u0432\u044b\u0448\u0435\u043d\u0438\u044f \u0442\u043e\u043f\u043b\u0438\u0432\u043d\u043e\u0439 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0432 \u0433\u043e\u043d\u043a\u0430\u0445 Night City: \u042d\u0422\u0410\u041f 1 - \u041e\u0431\u043d\u043e\u0432\u0438\u0442\u0435 \u0434\u043e \u0433\u0438\u0431\u0440\u0438\u0434\u043d\u043e\u0433\u043e \u0438\u043b\u0438 \u044d\u043b\u0435\u043a\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u044f, \u0442\u0430\u043a\u043e\u0433\u043e \u043a\u0430\u043a EcoDrive, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0441\u043d\u0438\u0436\u0430\u0435\u0442 \u043f\u043e\u0442\u0440\u0435\u0431\u043b\u0435\u043d\u0438\u0435 \u0442\u043e\u043f\u043b\u0438\u0432\u0430 \u043d\u0430 40%. \u042d\u0422\u0410\u041f 2 - \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0444\u0443\u043d\u043a\u0446\u0438\u044e \u00ab\u042d\u043a\u043e\u043d\u043e\u043c\u043d\u044b\u0439 \u0440\u0435\u0436\u0438\u043c\u00bb \u0432\u0441\u043f\u043e\u043c\u043e\u0433\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0432\u043e\u0436\u0434\u0435\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u0440\u0430\u0437\u0433\u043e\u043d \u0438 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u0443\u044e \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0432 \u0433\u043e\u043d\u043a\u0435 \u00ab\u0423\u043b\u0438\u0447\u043d\u044b\u0439 \u0441\u043f\u0440\u0438\u043d\u0442\u00bb \u0440\u0435\u0436\u0438\u043c EcoMode \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0442 20% \u0442\u043e\u043f\u043b\u0438\u0432\u0430. \u042d\u0422\u0410\u041f 3 - \u0418\u0437\u0431\u0435\u0433\u0430\u0439\u0442\u0435 \u043d\u0435\u043d\u0443\u0436\u043d\u044b\u0445 \u0431\u0443\u0441\u0442\u043e\u0432 \u0438 \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u043e\u0433\u043e \u0432\u043e\u0436\u0434\u0435\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u044e\u0442 \u0440\u0430\u0441\u0445\u043e\u0434 \u0442\u043e\u043f\u043b\u0438\u0432\u0430. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u00ab\u0414\u0438\u0430\u0433\u0440\u0430\u043c\u043c\u0443 \u0442\u043e\u043f\u043b\u0438\u0432\u043d\u043e\u0439 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438\u00bb, \u0447\u0442\u043e\u0431\u044b \u0441\u0440\u0430\u0432\u043d\u0438\u0442\u044c \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043b\u0438. \u042d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0435 \u0432\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0442 \u0440\u0435\u0441\u0443\u0440\u0441\u044b, \u043d\u043e \u0438 \u0441\u043e\u043a\u0440\u0430\u0449\u0430\u0435\u0442 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u043d\u0430 \u043f\u0438\u0442-\u0441\u0442\u043e\u043f\u0430\u0445."}, {"question": "\u041a\u0430\u043a\u0438\u0435 \u0441\u043a\u0440\u044b\u0442\u044b\u0435 \u0434\u0435\u0442\u0430\u043b\u0438 \u043b\u043e\u0440\u0430 \u0435\u0441\u0442\u044c \u043d\u0430 \u043a\u0430\u0440\u0442\u0435 Night City Racing?", "answer": "\u041a\u0430\u0440\u0442\u0430 Night City Racing \u0431\u043e\u0433\u0430\u0442\u0430 \u0441\u043a\u0440\u044b\u0442\u044b\u043c\u0438 \u0434\u0435\u0442\u0430\u043b\u044f\u043c\u0438 \u043b\u043e\u0440\u0430. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0437\u0430\u0431\u0440\u043e\u0448\u0435\u043d\u043d\u044b\u0439 \u00ab\u041d\u0435\u0431\u043e\u0441\u043a\u0440\u0451\u0431 Skyline\u00bb \u0432 \u0424\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u043e\u043c \u0440\u0430\u0439\u043e\u043d\u0435 \u0438\u043c\u0435\u0435\u0442 \u0438\u0441\u0442\u043e\u0440\u0438\u044e \u043e \u043f\u0440\u043e\u0432\u0430\u043b\u0438\u0432\u0448\u0435\u043c\u0441\u044f \u043a\u043e\u0440\u043f\u043e\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u043c \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u044f\u0442\u0438\u0438. \u0418\u0441\u0441\u043b\u0435\u0434\u0443\u0439\u0442\u0435 \u0435\u0433\u043e \u0438\u043d\u0442\u0435\u0440\u044c\u0435\u0440 \u0432 \u043f\u043e\u0438\u0441\u043a\u0430\u0445 \u043a\u043e\u043b\u043b\u0435\u043a\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u043e\u0432, \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a \u00ab\u0416\u0443\u0440\u043d\u0430\u043b CEO\u00bb. \u0410\u043d\u0430\u043b\u043e\u0433\u0438\u0447\u043d\u043e, \u0432 \u0440\u0430\u0439\u043e\u043d\u0435 \u00ab\u0421\u0442\u0430\u0440\u044b\u0435 \u0434\u043e\u043a\u0438\u00bb \u0435\u0441\u0442\u044c \u0433\u0440\u0430\u0444\u0444\u0438\u0442\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0430\u043c\u0435\u043a\u0430\u044e\u0442 \u043d\u0430 \u0438\u0441\u0442\u043e\u0440\u0438\u044e \u043a\u043e\u043d\u0442\u0440\u0430\u0431\u0430\u043d\u0434\u0438\u0441\u0442\u0430. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u00ab\u0422\u0440\u0435\u043a\u0435\u0440 \u043b\u043e\u0440\u0430\u00bb, \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u044f. \u042d\u0442\u0438 \u0434\u0435\u0442\u0430\u043b\u0438 \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u044e\u0442 \u0433\u043b\u0443\u0431\u0438\u043d\u044b \u043c\u0438\u0440\u0443 \u0438\u0433\u0440\u044b, \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u044e\u0442 \u0438\u0433\u0440\u043e\u043a\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043b\u044e\u0431\u044f\u0442 \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u044b \u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f."}]
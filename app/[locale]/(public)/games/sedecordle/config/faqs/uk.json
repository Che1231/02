[{"question": "\u042f\u043a \u0440\u043e\u0437\u043f\u043e\u0447\u0430\u0442\u0438 \u0433\u0440\u0443 \u0432 Sedecordle \u044f\u043a \u043f\u043e\u0447\u0430\u0442\u043a\u0456\u0432\u0435\u0446\u044c?", "answer": "\u0429\u043e\u0431 \u0440\u043e\u0437\u043f\u043e\u0447\u0430\u0442\u0438 \u0433\u0440\u0443 \u0432 Sedecordle, \u0432\u0438\u043a\u043e\u043d\u0430\u0439\u0442\u0435 \u0442\u0430\u043a\u0456 \u0434\u0456\u0457: \u041a\u0420\u041e\u041a 1 - \u0412\u0456\u0434\u0432\u0456\u0434\u0430\u0439\u0442\u0435 \u043e\u0444\u0456\u0446\u0456\u0439\u043d\u0438\u0439 \u0432\u0435\u0431-\u0441\u0430\u0439\u0442 Sedecordle \u0430\u0431\u043e \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0442\u0435 \u0434\u043e\u0434\u0430\u0442\u043e\u043a. \u041a\u0420\u041e\u041a 2 - \u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \"\u041d\u043e\u0432\u0430 \u0433\u0440\u0430\", \u0449\u043e\u0431 \u043f\u043e\u0447\u0430\u0442\u0438. \u041a\u0420\u041e\u041a 3 - \u0412\u0438 \u043f\u043e\u0431\u0430\u0447\u0438\u0442\u0435 \u0441\u0456\u0442\u043a\u0443 \u0437 16 \u043e\u043a\u0440\u0435\u043c\u0438\u043c\u0438 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0430\u043c\u0438 Wordle. \u0421\u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0432\u0433\u0430\u0434\u0430\u0442\u0438 \u043f'\u044f\u0442\u0438\u043b\u0456\u0442\u0435\u0440\u043d\u0435 \u0441\u043b\u043e\u0432\u043e \u0434\u043b\u044f \u043f\u0435\u0440\u0448\u043e\u0457 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0438. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u044f\u043a\u0449\u043e \u0432\u0438 \u0432\u0433\u0430\u0434\u0430\u0454\u0442\u0435 \"CRANE\", \u0456 \u043b\u0456\u0442\u0435\u0440\u0438 \u0441\u0442\u0430\u043d\u0443\u0442\u044c \u0437\u0435\u043b\u0435\u043d\u0438\u043c\u0438, \u0446\u0435 \u043e\u0437\u043d\u0430\u0447\u0430\u0454, \u0449\u043e \u0432\u043e\u043d\u0438 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0456. \u041f\u043e\u0432\u0442\u043e\u0440\u0456\u0442\u044c \u0446\u0435\u0439 \u043f\u0440\u043e\u0446\u0435\u0441 \u0434\u043b\u044f \u0432\u0441\u0456\u0445 16 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043e\u043a. [\u041f\u0440\u0438\u043a\u043b\u0430\u0434: \u0423\u044f\u0432\u0456\u0442\u044c \u0446\u0435 \u044f\u043a \u0440\u043e\u0437\u0432'\u044f\u0437\u0430\u043d\u043d\u044f 16 \u043c\u0456\u043d\u0456-Wordle \u043e\u0434\u043d\u043e\u0447\u0430\u0441\u043d\u043e, \u043a\u043e\u0436\u043d\u0430 \u0437 \u044f\u043a\u0438\u0445 \u0432\u043d\u043e\u0441\u0438\u0442\u044c \u0432\u043a\u043b\u0430\u0434 \u0443 \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u0435 \u0432\u0438\u043a\u043b\u0438\u043a\u0443 Sedecordle.]"}, {"question": "\u042f\u043a\u0456 \u043e\u0441\u043d\u043e\u0432\u043d\u0456 \u043f\u0440\u0430\u0432\u0438\u043b\u0430 Sedecordle, \u044f\u043a\u0456 \u043f\u043e\u0432\u0438\u043d\u0435\u043d \u0437\u043d\u0430\u0442\u0438 \u043a\u043e\u0436\u0435\u043d \u043d\u043e\u0432\u0438\u0439 \u0433\u0440\u0430\u0432\u0435\u0446\u044c?", "answer": "\u041e\u0441\u043d\u043e\u0432\u043d\u0456 \u043f\u0440\u0430\u0432\u0438\u043b\u0430 Sedecordle \u043f\u0440\u043e\u0441\u0442\u0456: 1) \u0423 \u0432\u0430\u0441 \u0454 21 \u0441\u043f\u0440\u043e\u0431\u0430 \u0440\u043e\u0437\u0432'\u044f\u0437\u0430\u0442\u0438 16 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043e\u043a Wordle. 2) \u0414\u043b\u044f \u043a\u043e\u0436\u043d\u043e\u0457 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0438 \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u043e \u0432\u0433\u0430\u0434\u0430\u0442\u0438 \u043f'\u044f\u0442\u0438\u043b\u0456\u0442\u0435\u0440\u043d\u0435 \u0441\u043b\u043e\u0432\u043e. 3) \u041f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0456 \u043b\u0456\u0442\u0435\u0440\u0438 \u0443 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u043c\u0443 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u0456 \u0441\u0442\u0430\u044e\u0442\u044c \u0437\u0435\u043b\u0435\u043d\u0438\u043c\u0438, \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0456 \u043b\u0456\u0442\u0435\u0440\u0438 \u0432 \u043d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u043c\u0443 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u043d\u0456 \u0441\u0442\u0430\u044e\u0442\u044c \u0436\u043e\u0432\u0442\u0438\u043c\u0438, \u0430 \u043d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0456 \u043b\u0456\u0442\u0435\u0440\u0438 \u2013 \u0441\u0456\u0440\u0438\u043c\u0438. \u041f\u0440\u0438\u043a\u043b\u0430\u0434: \u044f\u043a\u0449\u043e \u0432\u0438 \u0432\u0433\u0430\u0434\u0430\u043b\u0438 \"PLANT\", \u0456 \"P\" \u0442\u0430 \"T\" \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0456, \u0432\u043e\u043d\u0438 \u0441\u0442\u0430\u043d\u0443\u0442\u044c \u0437\u0435\u043b\u0435\u043d\u0438\u043c\u0438. [\u0422\u0430\u0431\u043b\u0438\u0446\u044f \u043f\u043e\u0440\u0456\u0432\u043d\u044f\u043d\u043d\u044f: Sedecordle \u043f\u0440\u043e\u0442\u0438 Wordle \u2013 Sedecordle \u043c\u0430\u0454 16 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043e\u043a \u043f\u0440\u043e\u0442\u0438 Wordle 1, \u0430 21 \u0441\u043f\u0440\u043e\u0431\u0430 \u043f\u0440\u043e\u0442\u0438 Wordle 6.]"}, {"question": "\u042f\u043a\u0456 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0457 \u043c\u043e\u0436\u0443\u0442\u044c \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0442\u0438 \u043c\u0435\u043d\u0456 \u043f\u043e\u043a\u0440\u0430\u0449\u0438\u0442\u0438 \u0441\u0432\u043e\u044e \u0433\u0440\u0443 \u0432 Sedecordle \u044f\u043a \u043f\u043e\u0447\u0430\u0442\u043a\u0456\u0432\u0446\u044e?", "answer": "\u041f\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u043d\u044f \u0433\u0440\u0438 \u0432 Sedecordle \u0432\u043a\u043b\u044e\u0447\u0430\u0454 \u0446\u0456 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0457: \u041a\u0420\u041e\u041a 1 - \u041f\u043e\u0447\u043d\u0456\u0442\u044c \u0456\u0437 \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u0438\u0445 \u043f'\u044f\u0442\u0438\u043b\u0456\u0442\u0435\u0440\u043d\u0438\u0445 \u0441\u043b\u0456\u0432, \u044f\u043a\u0456 \u043c\u0456\u0441\u0442\u044f\u0442\u044c \u0431\u0430\u0433\u0430\u0442\u043e \u0433\u043e\u043b\u043e\u0441\u043d\u0438\u0445, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \"AUDIO\". \u041a\u0420\u041e\u041a 2 - \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0437\u0432\u043e\u0440\u043e\u0442\u043d\u0438\u0439 \u0437\u0432'\u044f\u0437\u043e\u043a \u0432\u0456\u0434 \u043a\u043e\u0436\u043d\u043e\u0433\u043e \u0432\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u043d\u044f, \u0449\u043e\u0431 \u0432\u0438\u043a\u043b\u044e\u0447\u0430\u0442\u0438 \u043d\u0435\u043c\u043e\u0436\u043b\u0438\u0432\u0456 \u043b\u0456\u0442\u0435\u0440\u0438 \u0434\u043b\u044f \u0456\u043d\u0448\u0438\u0445 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043e\u043a. \u041a\u0420\u041e\u041a 3 - \u0421\u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0443\u0439\u0442\u0435\u0441\u044f \u043d\u0430 \u0432\u0438\u0440\u0456\u0448\u0435\u043d\u043d\u0456 \u043b\u0435\u0433\u0448\u0438\u0445 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043e\u043a \u0441\u043f\u043e\u0447\u0430\u0442\u043a\u0443, \u0449\u043e\u0431 \u043f\u0440\u0438\u0441\u043a\u043e\u0440\u0438\u0442\u0438 \u043f\u0440\u043e\u0446\u0435\u0441. \u041f\u0440\u0438\u043a\u043b\u0430\u0434: \u044f\u043a\u0449\u043e \"AUDIO\" \u0432\u0438\u044f\u0432\u0438\u0442\u044c\u0441\u044f \u0442\u0430\u043a\u0438\u043c, \u0449\u043e \"A\" \u0456 \"I\" \u0454 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0438\u043c\u0438, \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0446\u044e \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044e \u0434\u043b\u044f \u0432\u0441\u0456\u0445 16 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043e\u043a. [\u041f\u043e\u0440\u0456\u0432\u043d\u044f\u043d\u043d\u044f \u0440\u0456\u0437\u043d\u0438\u0445 \u0432\u0430\u0440\u0456\u0430\u043d\u0442\u0456\u0432: \u043f\u043e\u0447\u0430\u0442\u0438 \u0437 \"AUDIO\" \u043f\u0440\u043e\u0442\u0438 \"CRANE\" \u2013 \"AUDIO\" \u043e\u0445\u043e\u043f\u043b\u044e\u0454 \u0431\u0456\u043b\u044c\u0448\u0435 \u0433\u043e\u043b\u043e\u0441\u043d\u0438\u0445, \u0449\u043e \u043c\u043e\u0436\u0435 \u0431\u0443\u0442\u0438 \u0431\u0456\u043b\u044c\u0448 \u043a\u043e\u0440\u0438\u0441\u043d\u0438\u043c \u0441\u043f\u043e\u0447\u0430\u0442\u043a\u0443.]"}, {"question": "\u0427\u043e\u043c\u0443 \u0432\u0430\u0436\u043b\u0438\u0432\u043e \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u043a\u0435\u0440\u0443\u0432\u0430\u0442\u0438 \u0441\u043f\u0440\u043e\u0431\u0430\u043c\u0438 \u0432 Sedecordle \u0456 \u044f\u043a \u0446\u0435 \u0437\u0440\u043e\u0431\u0438\u0442\u0438?", "answer": "\u0415\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0435 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0441\u043f\u0440\u043e\u0431\u0430\u043c\u0438 \u0432 Sedecordle \u0454 \u0432\u0430\u0436\u043b\u0438\u0432\u0438\u043c, \u043e\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u0443 \u0432\u0430\u0441 \u0454 \u043b\u0438\u0448\u0435 21 \u0441\u043f\u0440\u043e\u0431\u0430 \u0440\u043e\u0437\u0432'\u044f\u0437\u0430\u0442\u0438 16 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043e\u043a. \u041a\u0420\u041e\u041a 1 - \u0420\u043e\u0437\u043f\u043e\u0434\u0456\u043b\u0456\u0442\u044c \u0441\u043f\u0440\u043e\u0431\u0438 \u0437\u0430\u043b\u0435\u0436\u043d\u043e \u0432\u0456\u0434 \u0441\u043a\u043b\u0430\u0434\u043d\u043e\u0441\u0442\u0456 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043e\u043a; \u0440\u043e\u0437\u0432\u2019\u044f\u0437\u0443\u0439\u0442\u0435 \u043b\u0435\u0433\u0448\u0456 \u0441\u043f\u043e\u0447\u0430\u0442\u043a\u0443. \u041a\u0420\u041e\u041a 2 - \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0441\u043f\u0456\u043b\u044c\u043d\u0456 \u043b\u0456\u0442\u0435\u0440\u0438 \u043c\u0456\u0436 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0430\u043c\u0438, \u0449\u043e\u0431 \u043c\u0430\u043a\u0441\u0438\u043c\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u043e\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u0457. \u041a\u0420\u041e\u041a 3 - \u0423\u043d\u0438\u043a\u0430\u0439\u0442\u0435 \u0437\u0430\u0439\u0432\u0438\u0445 \u0441\u043f\u0440\u043e\u0431, \u0441\u0442\u0435\u0436\u0430\u0447\u0438 \u0437\u0430 \u0432\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u043c\u0438 \u043b\u0456\u0442\u0435\u0440\u0430\u043c\u0438. \u041f\u0440\u0438\u043a\u043b\u0430\u0434: \u044f\u043a\u0449\u043e \"CRANE\" \u0432\u0438\u043a\u043b\u044e\u0447\u0430\u0454 \"C\" \u0456 \"R\" \u0432 \u0434\u0435\u043a\u0456\u043b\u044c\u043a\u043e\u0445 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0430\u0445, \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u043e\u0441\u0435\u0440\u0435\u0434\u0438\u0442\u0438\u0441\u044f \u043d\u0430 \u0456\u043d\u0448\u0438\u0445 \u043b\u0456\u0442\u0435\u0440\u0430\u0445. [\u0421\u0445\u0435\u043c\u0430\u0442\u0438\u0447\u043d\u0435 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f \u043f\u0440\u043e\u0446\u0435\u0441\u0443: \u041f\u043e\u0442\u0456\u043a \u0440\u043e\u0437\u043f\u043e\u0434\u0456\u043b\u0443 \u0441\u043f\u0440\u043e\u0431 - \u041b\u0435\u0433\u043a\u0456 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0438 \u2192 \u0421\u043f\u0456\u043b\u044c\u043d\u0456 \u043b\u0456\u0442\u0435\u0440\u0438 \u2192 \u0412\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f \u0437\u0430\u0439\u0432\u0438\u0445.]"}, {"question": "\u042f\u043a\u0456 \u0440\u043e\u0437\u0448\u0438\u0440\u0435\u043d\u0456 \u0442\u0435\u0445\u043d\u0456\u043a\u0438 \u043c\u043e\u0436\u0443\u0442\u044c \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0442\u0438 \u043c\u0435\u043d\u0456 \u0448\u0432\u0438\u0434\u0448\u0435 \u0440\u043e\u0437\u0432\u2019\u044f\u0437\u0430\u0442\u0438 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0438 Sedecordle?", "answer": "\u0420\u043e\u0437\u0448\u0438\u0440\u0435\u043d\u0456 \u0442\u0435\u0445\u043d\u0456\u043a\u0438 \u0434\u043b\u044f \u0448\u0432\u0438\u0434\u0448\u043e\u0433\u043e \u0440\u043e\u0437\u0432\u2019\u044f\u0437\u0430\u043d\u043d\u044f \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043e\u043a Sedecordle \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442\u044c: \u041a\u0420\u041e\u041a 1 - \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u043f\u0456\u0434\u0445\u0456\u0434 \u00ab\u0431\u0430\u043d\u043a \u0441\u043b\u0456\u0432\u00bb, \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u044e\u0447\u0438 \u0441\u043f\u0438\u0441\u043e\u043a \u043c\u043e\u0436\u043b\u0438\u0432\u0438\u0445 \u0441\u043b\u0456\u0432 \u0434\u043b\u044f \u043a\u043e\u0436\u043d\u043e\u0457 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0438. \u041a\u0420\u041e\u041a 2 - \u0420\u0435\u0430\u043b\u0456\u0437\u0443\u0439\u0442\u0435 \u00ab\u0430\u043d\u0430\u043b\u0456\u0437 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043e\u043a \u043f\u0435\u0440\u0435\u0445\u0440\u0435\u0441\u043d\u043e\u00bb, \u0449\u043e\u0431 \u0432\u0438\u044f\u0432\u0438\u0442\u0438 \u043f\u0435\u0440\u0435\u043a\u0440\u0438\u0432\u0430\u044e\u0442\u044c\u0441\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0438 \u043b\u0456\u0442\u0435\u0440. \u041a\u0420\u041e\u041a 3 - \u041d\u0430\u0434\u0430\u0439\u0442\u0435 \u043f\u0440\u0456\u043e\u0440\u0438\u0442\u0435\u0442 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0430\u043c \u0437 \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448\u0438\u043c\u0438 \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u043d\u044f\u043c\u0438, \u0449\u043e\u0431 \u0437\u043c\u0435\u043d\u0448\u0438\u0442\u0438 \u043d\u0435\u0432\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u0456\u0441\u0442\u044c. \u041f\u0440\u0438\u043a\u043b\u0430\u0434: \u044f\u043a\u0449\u043e \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0430 1 \u043c\u0430\u0454 \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043d\u0456 \"A\" \u0442\u0430 \"E\", \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0446\u0435 \u0434\u043b\u044f \u0437\u0432\u0443\u0436\u0435\u043d\u043d\u044f \u043c\u043e\u0436\u043b\u0438\u0432\u043e\u0441\u0442\u0435\u0439 \u0432 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0430\u0445 2-16. [\u041f\u0440\u0438\u043a\u043b\u0430\u0434: \u0423\u044f\u0432\u0456\u0442\u044c \u0446\u0435 \u044f\u043a \u0448\u0430\u0445\u043e\u0432\u0443 \u0433\u0440\u0443, \u0434\u0435 \u043a\u043e\u0436\u0435\u043d \u0445\u0456\u0434 (\u0432\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u043d\u044f) \u0432\u043f\u043b\u0438\u0432\u0430\u0454 \u043d\u0430 \u0434\u0435\u043a\u0456\u043b\u044c\u043a\u0430 \u0434\u043e\u0449\u043e\u043a (\u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043e\u043a) \u043e\u0434\u043d\u043e\u0447\u0430\u0441\u043d\u043e.]"}, {"question": "\u042f\u043a \u044f \u043c\u043e\u0436\u0443 \u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0441\u0432\u043e\u044e \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u044e \u0432\u0438\u0431\u043e\u0440\u0443 \u0441\u043b\u0456\u0432 \u0432 Sedecordle?", "answer": "\u041e\u043f\u0442\u0438\u043c\u0456\u0437\u0430\u0446\u0456\u044f \u0432\u0438\u0431\u043e\u0440\u0443 \u0441\u043b\u0456\u0432 \u0432 Sedecordle \u043f\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0430\u0454: \u041a\u0420\u041e\u041a 1 - \u0412\u0438\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u0441\u043b\u043e\u0432\u0430, \u044f\u043a\u0456 \u043e\u0445\u043e\u043f\u043b\u044e\u044e\u0442\u044c \u0448\u0438\u0440\u043e\u043a\u0438\u0439 \u0434\u0456\u0430\u043f\u0430\u0437\u043e\u043d \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u0438\u0445 \u043b\u0456\u0442\u0435\u0440 \u0442\u0430 \u0433\u043e\u043b\u043e\u0441\u043d\u0438\u0445. \u041a\u0420\u041e\u041a 2 - \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u043f\u0440\u043e\u0446\u0435\u0441 \u0432\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f, \u0449\u043e\u0431 \u0432\u0456\u0434\u043a\u0438\u043d\u0443\u0442\u0438 \u0441\u043b\u043e\u0432\u0430, \u044f\u043a\u0456 \u043d\u0435 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0430\u044e\u0442\u044c \u0437\u0432\u043e\u0440\u043e\u0442\u043d\u043e\u043c\u0443 \u0437\u0432'\u044f\u0437\u043a\u0443. \u041a\u0420\u041e\u041a 3 - \u041f\u043e\u0432\u0442\u043e\u0440\u043d\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043d\u0456 \u043b\u0456\u0442\u0435\u0440\u0438 \u043c\u0456\u0436 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0430\u043c\u0438, \u0449\u043e\u0431 \u0437\u0432\u0435\u0441\u0442\u0438 \u0434\u043e \u043c\u0456\u043d\u0456\u043c\u0443\u043c\u0443 \u0432\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u043d\u044f. \u041f\u0440\u0438\u043a\u043b\u0430\u0434: \u044f\u043a\u0449\u043e \"AUDIO\" \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0443\u0454 \"A\" \u0442\u0430 \"I\", \u043d\u0430\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u043f\u0440\u0456\u043e\u0440\u0438\u0442\u0435\u0442 \u0441\u043b\u043e\u0432\u0430\u043c, \u044f\u043a\u0456 \u043c\u0456\u0441\u0442\u044f\u0442\u044c \u0446\u0456 \u043b\u0456\u0442\u0435\u0440\u0438 \u0432 \u0456\u043d\u0448\u0438\u0445 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0430\u0445. [\u0422\u0430\u0431\u043b\u0438\u0446\u044f \u043f\u043e\u0440\u0456\u0432\u043d\u044f\u043d\u043d\u044f: \u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u044f \u0432\u0438\u0431\u043e\u0440\u0443 \u0441\u043b\u0456\u0432 \u2013 \u0448\u0438\u0440\u043e\u043a\u0435 \u043e\u0445\u043e\u043f\u043b\u0435\u043d\u043d\u044f \u043f\u0440\u043e\u0442\u0438 \u0432\u0443\u0437\u044c\u043a\u043e\u0457 \u0444\u043e\u043a\u0443\u0441\u0443\u0432\u0430\u043d\u043d\u044f, \u0437 \u043f\u0440\u0438\u043a\u043b\u0430\u0434\u0430\u043c\u0438, \u044f\u043a \"AUDIO\" \u043f\u0440\u043e\u0442\u0438 \"CRANE\".]"}, {"question": "\u042f\u043a\u0456 \u043c\u0435\u0445\u0430\u043d\u0456\u0437\u043c\u0438 \u043b\u0435\u0436\u0430\u0442\u044c \u0432 \u043e\u0441\u043d\u043e\u0432\u0456 \u0441\u0438\u0441\u0442\u0435\u043c\u0438 \u043e\u0446\u0456\u043d\u044e\u0432\u0430\u043d\u043d\u044f Sedecordle?", "answer": "\u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u043e\u0446\u0456\u043d\u044e\u0432\u0430\u043d\u043d\u044f Sedecordle \u0431\u0430\u0437\u0443\u0454\u0442\u044c\u0441\u044f \u043d\u0430 \u043a\u0456\u043b\u044c\u043a\u043e\u0441\u0442\u0456 \u0441\u043f\u0440\u043e\u0431, \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u0438\u0445 \u0434\u043b\u044f \u0440\u043e\u0437\u0432\u2019\u044f\u0437\u0430\u043d\u043d\u044f \u0432\u0441\u0456\u0445 16 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043e\u043a. \u0427\u0438\u043c \u043c\u0435\u043d\u0448\u0435 \u0441\u043f\u0440\u043e\u0431 \u0432\u0438 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454\u0442\u0435, \u0442\u0438\u043c \u0432\u0438\u0449\u0438\u0439 \u0432\u0430\u0448 \u0431\u0430\u043b. \u041f\u0440\u0438\u043a\u043b\u0430\u0434: \u0440\u043e\u0437\u0432\u2019\u044f\u0437\u0430\u043d\u043d\u044f \u0432\u0441\u0456\u0445 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043e\u043a \u0437\u0430 15 \u0441\u043f\u0440\u043e\u0431 \u0434\u0430\u0454 \u0432\u0438\u0449\u0438\u0439 \u0431\u0430\u043b, \u043d\u0456\u0436 \u0440\u043e\u0437\u0432\u2019\u044f\u0437\u0430\u043d\u043d\u044f \u0457\u0445 \u0437\u0430 20 \u0441\u043f\u0440\u043e\u0431. [\u0410\u043d\u0430\u043b\u0456\u0437 \u0441\u0438\u0441\u0442\u0435\u043c\u0438: \u041c\u0435\u0445\u0430\u043d\u0456\u0437\u043c\u0438 \u043e\u0446\u0456\u043d\u044e\u0432\u0430\u043d\u043d\u044f \u2013 \u043a\u043e\u0436\u043d\u0430 \u0441\u043f\u0440\u043e\u0431\u0430 \u0437\u043d\u0438\u0436\u0443\u0454 \u0432\u0430\u0448 \u043f\u043e\u0442\u0435\u043d\u0446\u0456\u0439\u043d\u0438\u0439 \u0431\u0430\u043b, \u0430 \u043d\u0435\u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u0456 \u0441\u043f\u0440\u043e\u0431\u0438 \u0434\u043e\u0434\u0430\u044e\u0442\u044c \u0431\u043e\u043d\u0443\u0441\u043d\u0456 \u0431\u0430\u043b\u0438. \u0424\u043e\u0440\u043c\u0443\u043b\u0430: \u041e\u0446\u0456\u043d\u043a\u0430 = (21 - \u041a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u0438\u0445 \u0441\u043f\u0440\u043e\u0431) * 10 + \u0411\u043e\u043d\u0443\u0441.]"}, {"question": "\u042f\u043a \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0456\u0457 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043e\u043a Sedecordle \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0443\u0454 \u0441\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u0456\u0441\u0442\u044c \u0442\u0430 \u0440\u0456\u0437\u043d\u043e\u043c\u0430\u043d\u0456\u0442\u043d\u0456\u0441\u0442\u044c?", "answer": "\u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0456\u0457 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043e\u043a Sedecordle \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0443\u0454 \u0441\u043f\u0440\u0430\u0432\u0435\u0434\u043b\u0438\u0432\u0456\u0441\u0442\u044c \u0442\u0430 \u0440\u0456\u0437\u043d\u043e\u043c\u0430\u043d\u0456\u0442\u043d\u0456\u0441\u0442\u044c, \u0437\u0430\u0432\u0434\u044f\u043a\u0438: 1) \u0412\u0438\u043f\u0430\u0434\u043a\u043e\u0432\u043e\u043c\u0443 \u0432\u0438\u0431\u043e\u0440\u0443 \u0441\u043b\u0456\u0432 \u0456\u0437 \u0432\u0456\u0434\u0456\u0431\u0440\u0430\u043d\u043e\u0433\u043e \u0441\u043f\u0438\u0441\u043a\u0443 \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u0438\u0445 \u043f'\u044f\u0442\u0438\u043b\u0456\u0442\u0435\u0440\u043d\u0438\u0445 \u0441\u043b\u0456\u0432. 2) \u0417\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u043d\u043d\u044e \u0442\u043e\u0433\u043e, \u0449\u043e \u043a\u043e\u0436\u043d\u0430 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0430 \u0454 \u043d\u0435\u0437\u0430\u043b\u0435\u0436\u043d\u043e\u044e, \u0430\u043b\u0435 \u043c\u043e\u0436\u0435 \u0434\u0456\u043b\u0438\u0442\u0438\u0441\u044f \u043b\u0456\u0442\u0435\u0440\u0430\u043c\u0438 \u0437 \u0456\u043d\u0448\u0438\u043c\u0438. 3) \u0417\u0431\u0430\u043b\u0430\u043d\u0441\u043e\u0432\u0430\u043d\u0430 \u0441\u043a\u043b\u0430\u0434\u043d\u0456\u0441\u0442\u044c, \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0447\u0438 \u044f\u043a \u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0456, \u0442\u0430\u043a \u0456 \u043c\u0435\u043d\u0448 \u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0456 \u0441\u043b\u043e\u0432\u0430. \u041f\u0440\u0438\u043a\u043b\u0430\u0434: \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0430 1 \u043c\u043e\u0436\u0435 \u043c\u0430\u0442\u0438 \u00abCRANE\u00bb, \u0430 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0430 2 \u2013 \u00abPLANT\u00bb, \u043f\u043e\u0434\u0456\u043b\u044f\u044e\u0447\u0438 \u043b\u0456\u0442\u0435\u0440\u0443 \u00abA\u00bb. [\u0410\u043d\u0430\u043b\u0456\u0437 \u0441\u0438\u0441\u0442\u0435\u043c\u0438: \u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0456\u0457 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043e\u043a \u2013 \u0412\u0438\u043f\u0430\u0434\u043a\u043e\u0432\u0438\u0439 \u0432\u0438\u0431\u0456\u0440 + \u041d\u0435\u0437\u0430\u043b\u0435\u0436\u043d\u0456 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0438 + \u0417\u0431\u0430\u043b\u0430\u043d\u0441\u043e\u0432\u0430\u043d\u0430 \u0441\u043a\u043b\u0430\u0434\u043d\u0456\u0441\u0442\u044c.]"}, {"question": "\u0427\u0438 \u043c\u043e\u0436\u0443 \u044f \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0442\u0438 \u0441\u0432\u0456\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441 \u0432 Sedecordle \u043c\u0456\u0436 \u0440\u0456\u0437\u043d\u0438\u043c\u0438 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044f\u043c\u0438?", "answer": "\u0422\u0430\u043a, \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0442\u0438 \u0441\u0432\u0456\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441 \u0432 Sedecordle \u043c\u0456\u0436 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044f\u043c\u0438. \u041a\u0420\u041e\u041a 1 - \u041f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e \u0432\u0438 \u0432\u0432\u0456\u0439\u0448\u043b\u0438 \u0432 \u0442\u0443 \u0436 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441 \u043d\u0430 \u043e\u0431\u043e\u0445 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044f\u0445. \u041a\u0420\u041e\u041a 2 - \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0444\u0443\u043d\u043a\u0446\u0456\u044e \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f \u0432 \u0445\u043c\u0430\u0440\u0456, \u0449\u043e\u0431 \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0441\u0432\u0456\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441. \u041a\u0420\u041e\u041a 3 - \u042f\u043a\u0449\u043e \u0432\u0438 \u0437\u0456\u0442\u043a\u043d\u0435\u0442\u0435\u0441\u044f \u0437 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430\u043c\u0438, \u043e\u0447\u0438\u0441\u0442\u0456\u0442\u044c \u043a\u0435\u0448 \u0456 \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0449\u0435 \u0440\u0430\u0437. \u041f\u0440\u0438\u043a\u043b\u0430\u0434: \u041f\u0440\u043e\u0433\u0440\u0435\u0441 \u0437 \u0432\u0430\u0448\u043e\u0433\u043e \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443 \u043c\u043e\u0436\u043d\u0430 \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u043d\u0430 \u0432\u0430\u0448\u043e\u043c\u0443 \u043f\u043b\u0430\u043d\u0448\u0435\u0442\u0456, \u0432\u0432\u0456\u0432\u0448\u0438 \u0432 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441. [\u041f\u043e\u0440\u0456\u0432\u043d\u044f\u043d\u043d\u044f \u0440\u0456\u0437\u043d\u0438\u0445 \u0432\u0430\u0440\u0456\u0430\u043d\u0442\u0456\u0432: \u0421\u0438\u043d\u0445\u0440\u043e\u043d\u0456\u0437\u0430\u0446\u0456\u044f \u0432 \u0445\u043c\u0430\u0440\u0456 \u043f\u0440\u043e\u0442\u0438 \u0440\u0443\u0447\u043d\u043e\u0433\u043e \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f \u2013 \u0421\u0438\u043d\u0445\u0440\u043e\u043d\u0456\u0437\u0430\u0446\u0456\u044f \u0432 \u0445\u043c\u0430\u0440\u0456 \u0454 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e\u044e, \u0430\u043b\u0435 \u043f\u043e\u0442\u0440\u0435\u0431\u0443\u0454 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u043e\u0433\u043e \u0437\u0430\u043f\u0438\u0441\u0443, \u0442\u043e\u0434\u0456 \u044f\u043a \u0440\u0443\u0447\u043d\u0435 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f \u0454 \u0430\u0432\u0442\u043e\u043d\u043e\u043c\u043d\u0438\u043c, \u0430\u043b\u0435 \u043c\u0435\u043d\u0448 \u0437\u0440\u0443\u0447\u043d\u0438\u043c.]"}, {"question": "\u0427\u0438 \u0454 \u0432 Sedecordle \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 \u0444\u0443\u043d\u043a\u0446\u0456\u0457 \u0430\u0431\u043e \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0456 \u044f\u0439\u0446\u044f, \u043f\u0440\u043e \u044f\u043a\u0456 \u0433\u0440\u0430\u0432\u0446\u0456 \u043c\u043e\u0436\u0443\u0442\u044c \u043d\u0435 \u0437\u043d\u0430\u0442\u0438?", "answer": "Sedecordle \u043c\u0456\u0441\u0442\u0438\u0442\u044c \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 \u0444\u0443\u043d\u043a\u0446\u0456\u0457, \u0442\u0430\u043a\u0456 \u044f\u043a: 1) \"\u0422\u0435\u043c\u043d\u0438\u0439 \u0440\u0435\u0436\u0438\u043c\" \u0434\u043b\u044f \u043a\u0440\u0430\u0449\u043e\u0457 \u0433\u0440\u0438 \u0432\u043d\u043e\u0447\u0456. 2) \u041f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u0434\u043b\u044f \u0440\u043e\u0437\u0432\u2019\u044f\u0437\u0430\u043d\u043d\u044f \u0432\u0441\u0456\u0445 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043e\u043a \u0437\u0430 \u0440\u0435\u043a\u043e\u0440\u0434\u043d\u0438\u0439 \u0447\u0430\u0441. 3) \u0421\u043f\u0435\u0446\u0456\u0430\u043b\u044c\u043d\u0456 \u0430\u043d\u0456\u043c\u0430\u0446\u0456\u0457 \u043f\u0440\u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u0456 \u0432\u0441\u0456\u0445 16 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043e\u043a. \u041f\u0440\u0438\u043a\u043b\u0430\u0434: \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u044f \u0432\u0441\u0456\u0445 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043e\u043a \u043c\u0435\u043d\u0448 \u043d\u0456\u0436 \u0437\u0430 15 \u0441\u043f\u0440\u043e\u0431 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0454 \u0441\u043f\u0435\u0446\u0456\u0430\u043b\u044c\u043d\u0443 \u0430\u043d\u0456\u043c\u0430\u0446\u0456\u044e \u0444\u0435\u0454\u0440\u0432\u0435\u0440\u043a\u0456\u0432. [\u041f\u043e\u0448\u0443\u043a \u0441\u0435\u043a\u0440\u0435\u0442\u0456\u0432: \u041f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 \u0444\u0443\u043d\u043a\u0446\u0456\u0457 \u2013 \u0422\u0435\u043c\u043d\u0438\u0439 \u0440\u0435\u0436\u0438\u043c, \u041f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f, \u0421\u043f\u0435\u0446\u0456\u0430\u043b\u044c\u043d\u0456 \u0430\u043d\u0456\u043c\u0430\u0446\u0456\u0457.]"}]
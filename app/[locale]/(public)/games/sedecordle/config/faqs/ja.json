[{"question": "\u521d\u3081\u3066\u306e\u65b9\u3067\u30bb\u30c7\u30b3\u30fc\u30c9\u30eb\u3092\u59cb\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30bb\u30c7\u30b3\u30fc\u30c9\u30eb\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002STEP1 - \u516c\u5f0f\u306e\u30bb\u30c7\u30b3\u30fc\u30c9\u30eb\u30a6\u30a7\u30d6\u30b5\u30a4\u30c8\u307e\u305f\u306f\u30a2\u30d7\u30ea\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002STEP2 - \u300c\u65b0\u898f\u30b2\u30fc\u30e0\u300d\u3092\u30af\u30ea\u30c3\u30af\u3057\u3066\u958b\u59cb\u3057\u307e\u3059\u3002STEP3 - 16\u500b\u306e\u500b\u5225\u306e\u30ef\u30fc\u30c9\u30eb\u30d1\u30ba\u30eb\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002\u6700\u521d\u306e\u30d1\u30ba\u30eb\u306e\u305f\u3081\u306b5\u6587\u5b57\u306e\u5358\u8a9e\u3092\u63a8\u6e2c\u3059\u308b\u3053\u3068\u304b\u3089\u59cb\u3081\u307e\u3059\u3002\u4f8b\uff1a'CRANE'\u3092\u63a8\u6e2c\u3057\u3001\u6587\u5b57\u304c\u7dd1\u8272\u306b\u5909\u308f\u308c\u3070\u3001\u305d\u308c\u306f\u6b63\u3057\u3044\u3053\u3068\u3092\u610f\u5473\u3057\u307e\u3059\u3002\u3053\u306e\u30d7\u30ed\u30bb\u30b9\u309216\u500b\u3059\u3079\u3066\u306e\u30d1\u30ba\u30eb\u3067\u7e70\u308a\u8fd4\u3057\u307e\u3059\u3002[\u4f8b\u3048\uff1a16\u500b\u306e\u30df\u30cb\u30ef\u30fc\u30c9\u30eb\u3092\u540c\u6642\u306b\u89e3\u304f\u306e\u3068\u8003\u3048\u307e\u3057\u3087\u3046\u3002\u305d\u308c\u305e\u308c\u304c\u5927\u304d\u306a\u30bb\u30c7\u30b3\u30fc\u30c9\u30eb\u306e\u8ab2\u984c\u306b\u8ca2\u732e\u3057\u307e\u3059\u3002]"}, {"question": "\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30bb\u30c7\u30b3\u30fc\u30c9\u30eb\u306e\u57fa\u672c\u30eb\u30fc\u30eb\u3092\u3069\u308c\u304f\u3089\u3044\u77e5\u3063\u3066\u304a\u304f\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u30bb\u30c7\u30b3\u30fc\u30c9\u30eb\u306e\u57fa\u672c\u30eb\u30fc\u30eb\u306f\u30b7\u30f3\u30d7\u30eb\u3067\u3059\u30021\uff0916\u500b\u306e\u30ef\u30fc\u30c9\u30eb\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u305f\u3081\u306b21\u56de\u306e\u624b\u304c\u304b\u308a\u304c\u3042\u308a\u307e\u3059\u30022\uff09\u5404\u30d1\u30ba\u30eb\u306b\u306f5\u6587\u5b57\u306e\u5358\u8a9e\u306e\u63a8\u6e2c\u304c\u5fc5\u8981\u3067\u3059\u30023\uff09\u6b63\u3057\u3044\u4f4d\u7f6e\u306b\u3042\u308b\u6b63\u3057\u3044\u6587\u5b57\u306f\u7dd1\u8272\u306b\u306a\u308a\u3001\u9593\u9055\u3063\u305f\u4f4d\u7f6e\u306b\u3042\u308b\u6b63\u3057\u3044\u6587\u5b57\u306f\u9ec4\u8272\u306b\u306a\u308a\u3001\u9593\u9055\u3063\u305f\u6587\u5b57\u306f\u7070\u8272\u306b\u306a\u308a\u307e\u3059\u3002\u4f8b\uff1a'PLANT'\u3092\u63a8\u6e2c\u3057\u3001'P'\u3068'T'\u304c\u6b63\u3057\u3044\u3068\u3059\u308b\u3068\u3001\u7dd1\u8272\u306b\u306a\u308a\u307e\u3059\u3002[\u6bd4\u8f03\u8868: \u30bb\u30c7\u30b3\u30fc\u30c9\u30eb\u5bfe\u30ef\u30fc\u30c9\u30eb - \u30bb\u30c7\u30b3\u30fc\u30c9\u30eb\u306f16\u500b\u306e\u30d1\u30ba\u30eb\u306b\u5bfe\u3057\u30661\u3064\u3001\u305d\u3057\u3066\u30ef\u30fc\u30c9\u30eb\u306f6\u56de\u306b\u5bfe\u3057\u306621\u56de\u306e\u624b\u304c\u304b\u308a\u3002]"}, {"question": "\u521d\u5fc3\u8005\u3068\u3057\u3066\u30bb\u30c7\u30b3\u30fc\u30c9\u30eb\u306e\u30d7\u30ec\u30a4\u3092\u6539\u5584\u3059\u308b\u306e\u306b\u5f79\u7acb\u3064\u6226\u7565\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30bb\u30c7\u30b3\u30fc\u30c9\u30eb\u306e\u30d7\u30ec\u30a4\u3092\u6539\u5584\u3059\u308b\u306b\u306f\u3001\u3053\u308c\u3089\u306e\u6226\u7565\u304c\u6709\u52b9\u3067\u3059\u3002STEP1 - \u591a\u304f\u306e\u6bcd\u97f3\u3092\u542b\u3080\u4e00\u822c\u7684\u306a5\u6587\u5b57\u306e\u5358\u8a9e\uff08\u4f8b\u3048\u3070\u300c\u30aa\u30fc\u30c7\u30a3\u30aa\u300d\uff09\u304b\u3089\u59cb\u3081\u307e\u3059\u3002STEP2 - \u5404\u624b\u304c\u304b\u308a\u304b\u3089\u3001\u4ed6\u306e\u30d1\u30ba\u30eb\u3067\u4e0d\u53ef\u80fd\u306a\u6587\u5b57\u3092\u6392\u9664\u3057\u307e\u3059\u3002STEP3 - \u52e2\u3044\u3092\u4ed8\u3051\u308b\u305f\u3081\u306b\u3001\u307e\u305a\u7c21\u5358\u306a\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u3053\u3068\u306b\u96c6\u4e2d\u3057\u307e\u3059\u3002\u4f8b\uff1a'\u30aa\u30fc\u30c7\u30a3\u30aa'\u304c'A'\u3068'I'\u304c\u6b63\u3057\u3044\u3068\u5224\u660e\u3057\u305f\u5834\u5408\u3001\u3053\u306e\u60c5\u5831\u309216\u500b\u3059\u3079\u3066\u306e\u30d1\u30ba\u30eb\u3067\u4f7f\u7528\u3057\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u30aa\u30fc\u30c7\u30a3\u30aa\u3067\u59cb\u3081\u308b\u5834\u5408\u3068\u30af\u30ec\u30fc\u30f3\u3067\u59cb\u3081\u308b\u5834\u5408 - \u30aa\u30fc\u30c7\u30a3\u30aa\u306f\u6700\u521d\u306e\u6bb5\u968e\u3067\u3088\u308a\u591a\u304f\u306e\u6bcd\u97f3\u3092\u542b\u307f\u3001\u3088\u308a\u591a\u304f\u306e\u60c5\u5831\u3092\u4e0e\u3048\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002]"}, {"question": "\u30bb\u30c7\u30b3\u30fc\u30c9\u30eb\u3067\u52b9\u7387\u7684\u306b\u624b\u304c\u304b\u308a\u3092\u4f7f\u3046\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u3069\u306e\u3088\u3046\u306b\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30bb\u30c7\u30b3\u30fc\u30c9\u30eb\u3067\u52b9\u7387\u7684\u306b\u624b\u304c\u304b\u308a\u3092\u4f7f\u3046\u3053\u3068\u306f\u91cd\u8981\u3067\u3059\u3002\u7406\u7531\u306f16\u500b\u306e\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u305f\u3081\u306b21\u56de\u306e\u624b\u304c\u304b\u308a\u3057\u304b\u306a\u3044\u304b\u3089\u3067\u3059\u3002STEP1 - \u30d1\u30ba\u30eb\u306e\u96e3\u6613\u5ea6\u306b\u57fa\u3065\u3044\u3066\u624b\u304c\u304b\u308a\u3092\u5272\u308a\u5f53\u3066\u3001\u7c21\u5358\u306a\u3082\u306e\u304b\u3089\u89e3\u304d\u307e\u3059\u3002STEP2 - \u30d1\u30ba\u30eb\u9593\u306e\u5171\u901a\u6587\u5b57\u3092\u4f7f\u7528\u3057\u3066\u60c5\u5831\u3092\u6700\u5927\u9650\u306b\u6d3b\u7528\u3057\u307e\u3059\u3002STEP3 - \u6392\u9664\u3055\u308c\u305f\u6587\u5b57\u3092\u8a18\u9332\u3059\u308b\u3053\u3068\u3067\u3001\u91cd\u8907\u3059\u308b\u63a8\u6e2c\u3092\u907f\u3051\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\uff1a'\u30af\u30ec\u30fc\u30f3'\u304c\u8907\u6570\u306e\u30d1\u30ba\u30eb\u3067'C'\u3068'R'\u3092\u6392\u9664\u3057\u305f\u5834\u5408\u3001\u4ed6\u306e\u6587\u5b57\u306b\u96c6\u4e2d\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u624b\u304c\u304b\u308a\u5272\u308a\u5f53\u3066\u30d5\u30ed\u30fc - \u7c21\u5358\u306a\u30d1\u30ba\u30eb\u2192\u5171\u901a\u6587\u5b57\u2192\u91cd\u8907\u306e\u6392\u9664\u3002]"}, {"question": "\u30bb\u30c7\u30b3\u30fc\u30c9\u30eb\u3092\u3088\u308a\u65e9\u304f\u89e3\u304f\u305f\u3081\u306e\u4e0a\u7d1a\u30c6\u30af\u30cb\u30c3\u30af\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30bb\u30c7\u30b3\u30fc\u30c9\u30eb\u3092\u3088\u308a\u65e9\u304f\u89e3\u304f\u305f\u3081\u306e\u4e0a\u7d1a\u30c6\u30af\u30cb\u30c3\u30af\u306b\u306f\u3001STEP1 - \u5404\u30d1\u30ba\u30eb\u306b\u5bfe\u3059\u308b\u53ef\u80fd\u6027\u306e\u3042\u308b\u5358\u8a9e\u306e\u30ea\u30b9\u30c8\u3092\u4fdd\u6301\u3059\u308b\u300c\u5358\u8a9e\u30d0\u30f3\u30af\u300d\u30a2\u30d7\u30ed\u30fc\u30c1\u3092\u4f7f\u7528\u3059\u308b\u3002STEP2 - \u91cd\u8907\u3059\u308b\u6587\u5b57\u30d1\u30bf\u30fc\u30f3\u3092\u7279\u5b9a\u3059\u308b\u305f\u3081\u306e\u300c\u30af\u30ed\u30b9\u30d1\u30ba\u30eb\u5206\u6790\u300d\u3092\u5b9f\u88c5\u3059\u308b\u3002STEP3 - \u4e0d\u78ba\u5b9f\u6027\u3092\u6e1b\u3089\u3059\u305f\u3081\u306b\u3001\u5236\u7d04\u304c\u591a\u3044\u30d1\u30ba\u30eb\u3092\u512a\u5148\u3059\u308b\u3053\u3068\u3002\u4f8b\uff1a\u30d1\u30ba\u30eb1\u304c'A'\u3068'E'\u304c\u78ba\u5b9a\u3057\u3066\u3044\u308b\u5834\u5408\u3001\u3053\u306e\u60c5\u5831\u3092\u30d1\u30ba\u30eb2\uff5e16\u3067\u53ef\u80fd\u6027\u3092\u7d5e\u308b\u305f\u3081\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u5404\u624b\uff08\u63a8\u6e2c\uff09\u304c\u8907\u6570\u306e\u76e4\u9762\uff08\u30d1\u30ba\u30eb\uff09\u306b\u540c\u6642\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u5c06\u68cb\u306e\u3088\u3046\u306a\u30b2\u30fc\u30e0\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30bb\u30c7\u30b3\u30fc\u30c9\u30eb\u3067\u5358\u8a9e\u9078\u629e\u6226\u7565\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30bb\u30c7\u30b3\u30fc\u30c9\u30eb\u3067\u5358\u8a9e\u9078\u629e\u6226\u7565\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001STEP1 - \u4e00\u822c\u7684\u306a\u6587\u5b57\u3068\u6bcd\u97f3\u3092\u7db2\u7f85\u7684\u306b\u542b\u3080\u5358\u8a9e\u3092\u9078\u3076\u3002STEP2 - \u30d5\u30a3\u30fc\u30c9\u30d0\u30c3\u30af\u306b\u5408\u308f\u306a\u3044\u5358\u8a9e\u3092\u6392\u9664\u3059\u308b\u3002STEP3 - \u78ba\u5b9f\u306a\u6587\u5b57\u3092\u30d1\u30ba\u30eb\u9593\u3067\u518d\u5229\u7528\u3057\u3001\u63a8\u6e2c\u56de\u6570\u3092\u6e1b\u3089\u3059\u3002\u4f8b\uff1a'\u30aa\u30fc\u30c7\u30a3\u30aa'\u304c'A'\u3068'I'\u3092\u78ba\u5b9a\u3057\u3066\u3044\u308b\u5834\u5408\u3001\u4ed6\u306e\u30d1\u30ba\u30eb\u3067\u3053\u308c\u3089\u306e\u6587\u5b57\u304c\u542b\u307e\u308c\u308b\u5358\u8a9e\u3092\u512a\u5148\u3057\u307e\u3059\u3002[\u6bd4\u8f03\u8868\uff1a\u5358\u8a9e\u9078\u629e\u6226\u7565 - \u5e83\u7bc4\u306a\u30ab\u30d0\u30fc\u7bc4\u56f2\u5bfe\u72ed\u9698\u306a\u30d5\u30a9\u30fc\u30ab\u30b9\u3001\u30aa\u30fc\u30c7\u30a3\u30aa\u5bfe\u30af\u30ec\u30fc\u30f3\u306a\u3069\u306e\u4f8b\u3002]"}, {"question": "\u30bb\u30c7\u30b3\u30fc\u30c9\u30eb\u306e\u63a1\u70b9\u30b7\u30b9\u30c6\u30e0\u306e\u57fa\u790e\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30bb\u30c7\u30b3\u30fc\u30c9\u30eb\u306e\u63a1\u70b9\u30b7\u30b9\u30c6\u30e0\u306f\u300116\u500b\u3059\u3079\u3066\u306e\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u305f\u3081\u306b\u4f7f\u7528\u3057\u305f\u624b\u304c\u304b\u308a\u306e\u6570\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u4f7f\u7528\u3057\u305f\u624b\u304c\u304b\u308a\u304c\u5c11\u306a\u3044\u307b\u3069\u3001\u30b9\u30b3\u30a2\u304c\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002\u4f8b\uff1a15\u56de\u306e\u624b\u304c\u304b\u308a\u3067\u3059\u3079\u3066\u306e\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u3068\u300120\u56de\u306e\u624b\u304c\u304b\u308a\u3067\u4f7f\u7528\u3057\u3066\u89e3\u304f\u3088\u308a\u3082\u9ad8\u3044\u30b9\u30b3\u30a2\u306b\u306a\u308a\u307e\u3059\u3002[\u30b7\u30b9\u30c6\u30e0\u89e3\u6790\uff1a\u63a1\u70b9\u30e1\u30ab\u30cb\u30ba\u30e0 - \u5404\u624b\u304c\u304b\u308a\u306f\u6f5c\u5728\u7684\u306a\u30b9\u30b3\u30a2\u3092\u6e1b\u3089\u3057\u3001\u672a\u4f7f\u7528\u306e\u624b\u304c\u304b\u308a\u306f\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u3092\u52a0\u7b97\u3057\u307e\u3059\u3002\u516c\u5f0f\u306f\u30b9\u30b3\u30a2 = \uff0821 - \u4f7f\u7528\u3057\u305f\u624b\u304c\u304b\u308a\uff09\u00d7 10 + \u30dc\u30fc\u30ca\u30b9\u3002]"}, {"question": "\u30bb\u30c7\u30b3\u30fc\u30c9\u30eb\u306e\u30d1\u30ba\u30eb\u751f\u6210\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u304c\u516c\u5e73\u3055\u3068\u591a\u69d8\u6027\u3092\u3069\u306e\u3088\u3046\u306b\u4fdd\u8a3c\u3059\u308b\u306e\u3067\u3059\u304b\uff1f", "answer": "\u30bb\u30c7\u30b3\u30fc\u30c9\u30eb\u306e\u30d1\u30ba\u30eb\u751f\u6210\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u516c\u5e73\u3055\u3068\u591a\u69d8\u6027\u3092\u4fdd\u8a3c\u3059\u308b\u305f\u3081\u306b\u30011\uff09\u4e00\u822c\u7684\u306a5\u6587\u5b57\u306e\u5358\u8a9e\u306e\u53b3\u9078\u3055\u308c\u305f\u30ea\u30b9\u30c8\u304b\u3089\u30e9\u30f3\u30c0\u30e0\u306b\u5358\u8a9e\u3092\u9078\u629e\u3059\u308b\u30022\uff09\u5404\u30d1\u30ba\u30eb\u306f\u72ec\u7acb\u3057\u3066\u3044\u308b\u304c\u3001\u4ed6\u306e\u30d1\u30ba\u30eb\u3068\u6587\u5b57\u3092\u5171\u6709\u3067\u304d\u308b\u30023\uff09\u4e00\u822c\u7684\u306a\u5358\u8a9e\u3068\u305d\u3046\u3067\u306a\u3044\u5358\u8a9e\u3092\u7d44\u307f\u8fbc\u3080\u3053\u3068\u3067\u96e3\u6613\u5ea6\u3092\u30d0\u30e9\u30f3\u30b9\u3092\u3068\u308b\u3002\u4f8b\uff1a\u30d1\u30ba\u30eb1\u306f'\u30af\u30ec\u30fc\u30f3'\u3067\u3042\u308b\u4e00\u65b9\u3001\u30d1\u30ba\u30eb2\u306f'PLANT'\u3067\u3001\u6587\u5b57'A'\u3092\u5171\u6709\u3057\u307e\u3059\u3002[\u30b7\u30b9\u30c6\u30e0\u89e3\u6790\uff1a\u30d1\u30ba\u30eb\u751f\u6210\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0 - \u30e9\u30f3\u30c0\u30e0\u9078\u629e + \u72ec\u7acb\u3057\u305f\u30d1\u30ba\u30eb + \u96e3\u6613\u5ea6\u30d0\u30e9\u30f3\u30b9\u3002]"}, {"question": "\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u30bb\u30c7\u30b3\u30fc\u30c9\u30eb\u306e\u9032\u6357\u72b6\u6cc1\u3092\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u30bb\u30c7\u30b3\u30fc\u30c9\u30eb\u306e\u9032\u6357\u72b6\u6cc1\u3092\u8ee2\u9001\u3067\u304d\u307e\u3059\u3002STEP1 - \u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002STEP2 - \u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u9032\u6357\u72b6\u6cc1\u3092\u540c\u671f\u3057\u307e\u3059\u3002STEP3 - \u554f\u984c\u304c\u767a\u751f\u3057\u305f\u5834\u5408\u306f\u3001\u30ad\u30e3\u30c3\u30b7\u30e5\u3092\u30af\u30ea\u30a2\u3057\u3066\u3082\u3046\u4e00\u5ea6\u8a66\u3057\u307e\u3059\u3002\u4f8b\uff1a\u30b9\u30de\u30fc\u30c8\u30d5\u30a9\u30f3\u304b\u3089\u306e\u9032\u6357\u72b6\u6cc1\u306f\u3001\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3053\u3068\u3067\u3001\u30bf\u30d6\u30ec\u30c3\u30c8\u3067\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u30af\u30e9\u30a6\u30c9\u540c\u671f\u5bfe\u624b\u52d5\u4fdd\u5b58 - \u30af\u30e9\u30a6\u30c9\u540c\u671f\u306f\u81ea\u52d5\u5316\u3055\u308c\u3066\u3044\u307e\u3059\u304c\u30a2\u30ab\u30a6\u30f3\u30c8\u304c\u5fc5\u8981\u3067\u3059\u3002\u4e00\u65b9\u3001\u624b\u52d5\u4fdd\u5b58\u306f\u30aa\u30d5\u30e9\u30a4\u30f3\u3067\u3059\u304c\u3001\u3042\u307e\u308a\u4fbf\u5229\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002]"}, {"question": "\u30bb\u30c7\u30b3\u30fc\u30c9\u30eb\u306b\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u77e5\u3089\u306a\u3044\u304b\u3082\u3057\u308c\u306a\u3044\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30bb\u30c7\u30b3\u30fc\u30c9\u30eb\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3092\u542b\u307f\u307e\u3059\uff1a1\uff09\u591c\u9593\u306e\u30d7\u30ec\u30a4\u306b\u6700\u9069\u306a\u300c\u30c0\u30fc\u30af\u30e2\u30fc\u30c9\u300d\u304c\u3042\u308a\u307e\u3059\u30022\uff09\u8a18\u9332\u7684\u306a\u6642\u9593\u3067\u3059\u3079\u3066\u306e\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u305f\u3081\u306e\u96a0\u3055\u308c\u305f\u5b9f\u7e3e\u30023\uff0916\u500b\u3059\u3079\u3066\u306e\u30d1\u30ba\u30eb\u3092\u5b8c\u4e86\u3059\u308b\u3068\u304d\u306e\u7279\u5225\u306a\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3\u3002\u4f8b\uff1a15\u56de\u672a\u6e80\u306e\u624b\u304c\u304b\u308a\u3067\u3059\u3079\u3066\u306e\u30d1\u30ba\u30eb\u3092\u9054\u6210\u3059\u308b\u3068\u3001\u7279\u5225\u306a\u82b1\u706b\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3\u304c\u30c8\u30ea\u30ac\u30fc\u3055\u308c\u307e\u3059\u3002[\u5f69\u86cb\uff1a\u96a0\u3055\u308c\u305f\u6a5f\u80fd - \u30c0\u30fc\u30af\u30e2\u30fc\u30c9\u3001\u96a0\u3055\u308c\u305f\u5b9f\u7e3e\u3001\u7279\u5225\u306a\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3\u3002]"}]
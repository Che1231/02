[{"question": "\ucd08\ubcf4\uc790\uac00 Sedecordle\uc744 \uc2dc\uc791\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sedecordle\uc744 \uc2dc\uc791\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. STEP1 - \uacf5\uc2dd Sedecordle \uc6f9\uc0ac\uc774\ud2b8 \ub610\ub294 \uc571\uc744 \ubc29\ubb38\ud569\ub2c8\ub2e4. STEP2 - '\uc0c8 \uac8c\uc784'\uc744 \ud074\ub9ad\ud558\uc5ec \uc2dc\uc791\ud569\ub2c8\ub2e4. STEP3 - 16\uac1c\uc758 \uac1c\ubcc4 Wordle \ud37c\uc990\uc774 \uc788\ub294 \uadf8\ub9ac\ub4dc\uac00 \ud45c\uc2dc\ub429\ub2c8\ub2e4. \uba3c\uc800 \uccab \ubc88\uc9f8 \ud37c\uc990\uc5d0 \ub300\ud55c 5\uae00\uc790 \ub2e8\uc5b4\ub97c \ucd94\uce21\ud574 \ubcf4\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, 'CRANE'\uc744 \ucd94\uce21\ud558\uace0 \uae00\uc790\uac00 \ucd08\ub85d\uc0c9\uc73c\ub85c \ubcc0\ud658\ub418\uba74 \uc62c\ubc14\ub978 \uae00\uc790\uc784\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4. \uc774 \uacfc\uc815\uc744 \ubaa8\ub4e0 16\uac1c \ud37c\uc990\uc5d0 \ub300\ud574 \ubc18\ubcf5\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: 16\uac1c\uc758 \ubbf8\ub2c8 Wordle \ud37c\uc990\uc744 \ub3d9\uc2dc\uc5d0 \ud478\ub294 \uac83\uc73c\ub85c \uc0dd\uac01\ud558\uc2ed\uc2dc\uc624. \uac01 \ud37c\uc990\uc740 \ub354 \ud070 Sedecordle \ucc4c\ub9b0\uc9c0\uc5d0 \uae30\uc5ec\ud569\ub2c8\ub2e4.]"}, {"question": "\ubaa8\ub4e0 \uc0c8 \ud50c\ub808\uc774\uc5b4\uac00 \uc54c\uc544\uc57c \ud560 Sedecordle\uc758 \uae30\ubcf8 \uaddc\uce59\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sedecordle\uc758 \uae30\ubcf8 \uaddc\uce59\uc740 \uac04\ub2e8\ud569\ub2c8\ub2e4. 1) 16\uac1c\uc758 Wordle \ud37c\uc990\uc744 \ud480\uae30 \uc704\ud574 21\ubc88\uc758 \uc2dc\ub3c4\uac00 \uc8fc\uc5b4\uc9d1\ub2c8\ub2e4. 2) \uac01 \ud37c\uc990\uc5d0\ub294 5\uae00\uc790 \ub2e8\uc5b4 \ucd94\uce21\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. 3) \uc62c\ubc14\ub978 \uc704\uce58\uc758 \uc62c\ubc14\ub978 \uae00\uc790\ub294 \ucd08\ub85d\uc0c9, \uc798\ubabb\ub41c \uc704\uce58\uc758 \uc62c\ubc14\ub978 \uae00\uc790\ub294 \ub178\ub780\uc0c9, \uc798\ubabb\ub41c \uae00\uc790\ub294 \ud68c\uc0c9\uc73c\ub85c \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'PLANT'\ub97c \ucd94\uce21\ud558\uace0 'P'\uc640 'T'\uac00 \uc62c\ubc14\ub974\uba74 \ucd08\ub85d\uc0c9\uc73c\ub85c \ubcc0\ud569\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: Sedecordle \ub300 Wordle - Sedecordle\uc740 16\uac1c\uc758 \ud37c\uc990 \ub300 Wordle\uc758 1\uac1c, \uadf8\ub9ac\uace0 21\ubc88\uc758 \uc2dc\ub3c4 \ub300 Wordle\uc758 6\ubc88\uc785\ub2c8\ub2e4.]"}, {"question": "\ucd08\ubcf4\uc790\ub85c\uc11c Sedecordle \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uac1c\uc120\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ub294 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sedecordle \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uac1c\uc120\ud558\ub294 \ub370 \ud544\uc694\ud55c \uc804\ub7b5\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. STEP1 - 'AUDIO'\uc640 \uac19\uc774 \ub9ce\uc740 \ubaa8\uc74c\uc744 \ud3ec\ud568\ud558\ub294 \uc77c\ubc18\uc801\uc778 5\uae00\uc790 \ub2e8\uc5b4\ub85c \uc2dc\uc791\ud569\ub2c8\ub2e4. STEP2 - \uac01 \ucd94\uce21\uc5d0\uc11c \uc5bb\uc740 \ud53c\ub4dc\ubc31\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub2e4\ub978 \ud37c\uc990\uc5d0 \ub300\ud55c \ubd88\uac00\ub2a5\ud55c \uae00\uc790\ub97c \uc81c\uac70\ud569\ub2c8\ub2e4. STEP3 - \uba3c\uc800 \ub354 \uc26c\uc6b4 \ud37c\uc990\uc744 \ud480\uc5b4\uc11c momentum\uc744 \uc5bb\ub294 \ub370 \uc9d1\uc911\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'AUDIO'\uac00 'A'\uc640 'I'\uac00 \ub9de\ub294 \uac83\uc73c\ub85c \ud310\uba85\ub418\uba74 16\uac1c\uc758 \ubaa8\ub4e0 \ud37c\uc990\uc5d0\uc11c \uc774 \uc815\ubcf4\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. [\ub2e4\uc911 \uc635\uc158 \ube44\uad50: 'AUDIO'\ub85c \uc2dc\uc791\ud558\uae30 \ub300 'CRANE'\uc73c\ub85c \uc2dc\uc791\ud558\uae30 - 'AUDIO'\ub294 \ucc98\uc74c\uc5d0 \ub354 \ub9ce\uc740 \uc815\ubcf4\ub97c \uc904 \uc218 \uc788\ub294 \ub354 \ub9ce\uc740 \ubaa8\uc74c\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4.]"}, {"question": "Sedecordle\uc5d0\uc11c \uc2dc\ub3c4\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Sedecordle\uc5d0\uc11c \uc2dc\ub3c4\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \uac83\uc740 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. 16\uac1c\uc758 \ud37c\uc990\uc744 \ud480\uae30 \uc704\ud55c \uc2dc\ub3c4 \ud69f\uc218\ub294 21\ubc88\uc5d0 \ubd88\uacfc\ud558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. STEP1 - \ud37c\uc990 \ub09c\uc774\ub3c4\uc5d0 \ub530\ub77c \uc2dc\ub3c4\ub97c \ud560\ub2f9\ud558\uace0 \uba3c\uc800 \ub354 \uc26c\uc6b4 \ud37c\uc990\uc744 \ud489\ub2c8\ub2e4. STEP2 - \ud37c\uc990 \uac04 \uacf5\uc720\ub418\ub294 \uae00\uc790\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc815\ubcf4 \uc5bb\uae30\ub97c \uadf9\ub300\ud654\ud569\ub2c8\ub2e4. STEP3 - \uc81c\uac70\ub41c \uae00\uc790\ub97c \ucd94\uc801\ud558\uc5ec \uc911\ubcf5\ub41c \ucd94\uce21\uc744 \ud53c\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, 'CRANE'\uc774 \uc5ec\ub7ec \ud37c\uc990\uc5d0\uc11c 'C'\uc640 'R'\uc744 \uc81c\uac70\ud558\uba74 \ub2e4\ub978 \uae00\uc790\uc5d0 \uc9d1\uc911\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc2dc\ub3c4 \ud560\ub2f9 \ud750\ub984 - \uc26c\uc6b4 \ud37c\uc990 \u2192 \uacf5\uc720\ub41c \uae00\uc790 \u2192 \uc911\ubcf5 \uc81c\uac70.]"}, {"question": "Sedecordle \ud37c\uc990\uc744 \ub354 \ube60\ub974\uac8c \ud478\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ub294 \uace0\uae09 \uae30\uc220\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sedecordle \ud37c\uc990\uc744 \ub354 \ube60\ub974\uac8c \ud478\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ub294 \uace0\uae09 \uae30\uc220\ub85c\ub294 \ub2e4\uc74c\uc774 \uc788\uc2b5\ub2c8\ub2e4. STEP1 - \uac01 \ud37c\uc990\uc5d0 \ub300\ud55c \uac00\ub2a5\ud55c \ub2e8\uc5b4 \ubaa9\ub85d\uc744 \uc720\uc9c0\ud558\ub294 '\ub2e8\uc5b4 \uc740\ud589' \uc811\uadfc \ubc29\uc2dd\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. STEP2 - \uc911\ubcf5\ub418\ub294 \uae00\uc790 \ud328\ud134\uc744 \uc2dd\ubcc4\ud558\uae30 \uc704\ud574 '\ud37c\uc990 \uac04 \ubd84\uc11d'\uc744 \uad6c\ud604\ud569\ub2c8\ub2e4. STEP3 - \ubd88\ud655\uc2e4\uc131\uc744 \uc904\uc774\uae30 \uc704\ud574 \uc81c\uc57d\uc774 \uac00\uc7a5 \ub9ce\uc740 \ud37c\uc990\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \ud574\uacb0\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud37c\uc990 1\uc774 'A'\uc640 'E'\ub97c \ud655\uc778\ud558\uba74 \ud37c\uc990 2-16\uc5d0\uc11c \uac00\ub2a5\uc131\uc744 \uc881\ud788\ub294 \ub370 \uc774\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uac01 \uc774\ub3d9(\ucd94\uce21)\uc774 \uc5ec\ub7ec \ubcf4\ub4dc(\ud37c\uc990)\uc5d0 \ub3d9\uc2dc\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uccb4\uc2a4 \uac8c\uc784\uc73c\ub85c \uc0dd\uac01\ud574\ubcf4\uc2ed\uc2dc\uc624.]"}, {"question": "Sedecordle\uc5d0\uc11c \ub2e8\uc5b4 \uc120\ud0dd \uc804\ub7b5\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sedecordle\uc5d0\uc11c \ub2e8\uc5b4 \uc120\ud0dd \uc804\ub7b5\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \ub2e4\uc74c\uc744 \uc218\ud589\ud574\uc57c \ud569\ub2c8\ub2e4. STEP1 - \uc77c\ubc18\uc801\uc778 \uae00\uc790\uc640 \ubaa8\uc74c\uc758 \ud3ed\ub113\uc740 \ubc94\uc704\ub97c \ucee4\ubc84\ud558\ub294 \ub2e8\uc5b4\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. STEP2 - \ud53c\ub4dc\ubc31\uc5d0 \ub9de\uc9c0 \uc54a\ub294 \ub2e8\uc5b4\ub294 \uc81c\uc678\ud558\ub294 \uc81c\uac70 \uacfc\uc815\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. STEP3 - \ud655\uc778\ub41c \uae00\uc790\ub97c \ud37c\uc990 \uc804\uccb4\uc5d0 \uc7ac\uc0ac\uc6a9\ud558\uc5ec \ucd94\uce21 \ud69f\uc218\ub97c \ucd5c\uc18c\ud654\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'AUDIO'\uac00 'A'\uc640 'I'\ub97c \ud655\uc778\ud558\uba74 \uc774 \uae00\uc790\ub4e4\uc744 \ud3ec\ud568\ud558\ub294 \ub2e8\uc5b4\ub97c \ub2e4\ub978 \ud37c\uc990\uc5d0\uc11c \uc6b0\uc120\uc801\uc73c\ub85c \uace0\ub824\ud569\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \ub2e8\uc5b4 \uc120\ud0dd \uc804\ub7b5 - \uad11\ubc94\uc704 \ucee4\ubc84 \ub300 \uc881\uc740 \ucd08\uc810, 'AUDIO' \ub300 'CRANE'\uacfc \uac19\uc740 \uc608\uc2dc.]"}, {"question": "Sedecordle\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc758 \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sedecordle\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ubaa8\ub4e0 16\uac1c \ud37c\uc990\uc744 \ud478\ub294 \ub370 \uc0ac\uc6a9\ub41c \uc2dc\ub3c4 \ud69f\uc218\ub97c \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. \uc2dc\ub3c4 \ud69f\uc218\uac00 \uc801\uc744\uc218\ub85d \uc810\uc218\uac00 \ub192\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 15\ubc88\uc758 \uc2dc\ub3c4\ub85c \ubaa8\ub4e0 \ud37c\uc990\uc744 \ud478\ub294 \uac83\uc774 20\ubc88\uc758 \uc2dc\ub3c4\ub85c \ud478\ub294 \uac83\ubcf4\ub2e4 \ub192\uc740 \uc810\uc218\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. [\uc2dc\uc2a4\ud15c \ubd84\uc11d: \uc810\uc218 \uba54\ucee4\ub2c8\uc998 - \uac01 \uc2dc\ub3c4\ub294 \uc7a0\uc7ac\uc801 \uc810\uc218\ub97c \uac10\uc18c\uc2dc\ud0a4\uace0, \uc0ac\uc6a9\ub418\uc9c0 \uc54a\uc740 \uc2dc\ub3c4\ub294 \ubcf4\ub108\uc2a4 \uc810\uc218\ub97c \ucd94\uac00\ud569\ub2c8\ub2e4. \uacf5\uc2dd\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc810\uc218 = (21 - \uc0ac\uc6a9 \uc2dc\ub3c4) * 10 + \ubcf4\ub108\uc2a4.]"}, {"question": "Sedecordle\uc758 \ud37c\uc990 \uc0dd\uc131 \uc54c\uace0\ub9ac\uc998\uc774 \uacf5\uc815\uc131\uacfc \ub2e4\uc591\uc131\uc744 \ubcf4\uc7a5\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sedecordle\uc758 \ud37c\uc990 \uc0dd\uc131 \uc54c\uace0\ub9ac\uc998\uc740 \ub2e4\uc74c\uacfc \uac19\uc740 \ubc29\ubc95\uc73c\ub85c \uacf5\uc815\uc131\uacfc \ub2e4\uc591\uc131\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4. 1) \uc77c\ubc18\uc801\uc778 5\uae00\uc790 \ub2e8\uc5b4\uc758 \uc120\ud0dd\ub41c \ubaa9\ub85d\uc5d0\uc11c \ubb34\uc791\uc704\ub85c \ub2e8\uc5b4\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. 2) \uac01 \ud37c\uc990\uc740 \ub3c5\ub9bd\uc801\uc774\uc9c0\ub9cc \ub2e4\ub978 \ud37c\uc990\uacfc \uae00\uc790\ub97c \uacf5\uc720\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 3) \uc77c\ubc18\uc801\uc778 \ub2e8\uc5b4\uc640 \ub35c \uc77c\ubc18\uc801\uc778 \ub2e8\uc5b4\ub97c \ud3ec\ud568\ud558\uc5ec \ub09c\uc774\ub3c4\ub97c \uc870\uc815\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud37c\uc990 1\uc5d0\ub294 'CRANE'\uc774 \uc788\uc744 \uc218 \uc788\uace0, \ud37c\uc990 2\uc5d0\ub294 'PLANT'\uac00 \uc788\uc73c\uba70, 'A'\ub77c\ub294 \uae00\uc790\ub97c \uacf5\uc720\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc2dc\uc2a4\ud15c \ubd84\uc11d: \ud37c\uc990 \uc0dd\uc131 \uc54c\uace0\ub9ac\uc998 - \ubb34\uc791\uc704 \uc120\ud0dd + \ub3c5\ub9bd\uc801 \ud37c\uc990 + \ub09c\uc774\ub3c4 \uc870\uc815.]"}, {"question": "\ub2e4\ub978 \uae30\uae30\uc5d0\uc11c Sedecordle \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub124, \ub2e4\ub978 \uae30\uae30\uc5d0\uc11c Sedecordle \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1 - \ub450 \uae30\uae30 \ubaa8\ub450\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. STEP2 - \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud569\ub2c8\ub2e4. STEP3 - \ubb38\uc81c\uac00 \ubc1c\uc0dd\ud558\uba74 \uce90\uc2dc\ub97c \uc9c0\uc6b0\uace0 \ub2e4\uc2dc \uc2dc\ub3c4\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud734\ub300\ud3f0\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc740 \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uc5ec \ud0dc\ube14\ub9bf\uc5d0\uc11c \uc561\uc138\uc2a4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc911 \uc635\uc158 \ube44\uad50: \ud074\ub77c\uc6b0\ub4dc \ub3d9\uae30\ud654 \ub300 \uc218\ub3d9 \uc800\uc7a5 - \ud074\ub77c\uc6b0\ub4dc \ub3d9\uae30\ud654\ub294 \uc790\ub3d9\uc774\uc9c0\ub9cc \uacc4\uc815\uc774 \ud544\uc694\ud558\uace0, \uc218\ub3d9 \uc800\uc7a5\uc740 \uc624\ud504\ub77c\uc778\uc774\uc9c0\ub9cc \ub35c \ud3b8\ub9ac\ud569\ub2c8\ub2e4.]"}, {"question": "Sedecordle\uc5d0 \ud50c\ub808\uc774\uc5b4\uac00 \ubaa8\ub974\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Sedecordle\uc5d0\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. 1) \uc57c\uac04 \ud50c\ub808\uc774\ub97c \uc704\ud574 '\ub2e4\ud06c \ubaa8\ub4dc' \uc124\uc815\uc774 \uc788\uc2b5\ub2c8\ub2e4. 2) \ubaa8\ub4e0 \ud37c\uc990\uc744 \uae30\ub85d \uc2dc\uac04 \ub0b4\uc5d0 \ud478\ub294 \uc228\uaca8\uc9c4 \uc5c5\uc801\uc774 \uc788\uc2b5\ub2c8\ub2e4. 3) \ubaa8\ub4e0 16\uac1c \ud37c\uc990\uc744 \uc644\ub8cc\ud560 \ub54c \ud2b9\ubcc4\ud55c \uc560\ub2c8\uba54\uc774\uc158\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubaa8\ub4e0 \ud37c\uc990\uc744 15\ud68c \ubbf8\ub9cc\uc758 \uc2dc\ub3c4\ub85c \uc644\ub8cc\ud558\uba74 \ud2b9\ubcc4\ud55c \ubd88\uaf43\ub180\uc774 \uc560\ub2c8\uba54\uc774\uc158\uc774 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. [\uc228\uaca8\uc9c4 \uc694\uc18c \ud0d0\uc0c9: \uc228\uaca8\uc9c4 \uae30\ub2a5 - \ub2e4\ud06c \ubaa8\ub4dc, \uc228\uaca8\uc9c4 \uc5c5\uc801, \ud2b9\ubcc4 \uc560\ub2c8\uba54\uc774\uc158.]"}]
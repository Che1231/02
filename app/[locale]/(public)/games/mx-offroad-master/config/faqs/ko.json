[{"question": "MX \uc624\ud504\ub85c\ub4dc \ub9c8\uc2a4\ud130\uc5d0\uc11c \ubd80\ub4dc\ub7ec\uc6b4 \uc2dc\uc791\uc744 \uc704\ud55c \uae30\ubcf8 \ucee8\ud2b8\ub864\uc740 \uc5b4\ub5bb\uac8c \uc218\ud589\ud569\ub2c8\uae4c?", "answer": "MX \uc624\ud504\ub85c\ub4dc \ub9c8\uc2a4\ud130\ub97c \uc2dc\uc791\ud558\ub824\uba74 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc5d0 \uc775\uc219\ud574\uc838\uc57c \ud569\ub2c8\ub2e4. \uc2a4\ud06c\ub9b0 \uc870\uc774\uc2a4\ud2f1\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc870\ud5a5\ud558\uace0, \uac00\uc18d \ubc84\ud2bc\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc804\uc9c4\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ucd08\ubcf4\uc790 \ud2b8\ub808\uc77c' \ub808\ubca8\uc5d0\uc11c \uc9c4\ud759 \uc9c0\ud615\uc5d0\uc11c \ubbf8\ub044\ub7ec\uc9d0\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \uac00\uc18d \ubc84\ud2bc\uc744 \ubd80\ub4dc\ub7fd\uac8c \ud0ed\ud569\ub2c8\ub2e4. \uc81c\ub3d9\uc740 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uae09\ud68c\uc804 \uc804\uc5d0 \uc81c\ub3d9 \ubc84\ud2bc\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc18d\ub3c4\ub97c \uc904\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ucee8\ud2b8\ub864\uc744 \ud6c8\ub828 \ubaa8\ub4dc\uc5d0\uc11c \uc5f0\uc2b5\ud558\uc5ec \uc790\uc2e0\uac10\uc744 \uac16\ub3c4\ub85d \ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ucee8\ud2b8\ub864\uc744 \uc2e4\uc81c ATV\ub97c \uc6b4\uc804\ud558\ub294 \uac83\uacfc \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uc2ed\uc2dc\uc624. \ubd80\ub4dc\ub7ec\uc6b4 \uc785\ub825\uc774 \ub354 \ub098\uc740 \uc870\uc791\uc73c\ub85c \uc774\uc5b4\uc9d1\ub2c8\ub2e4.]"}, {"question": "\uac8c\uc784 \ud50c\ub808\uc774 \uc2dc\uac04 100\uc2dc\uac04 \ud6c4 MX \uc624\ud504\ub85c\ub4dc \ub9c8\uc2a4\ud130\ub97c \ub9c8\uc2a4\ud130\ud558\uae30 \uc704\ud55c \ud544\uc218 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "100\uc2dc\uac04\uc774 \uc9c0\ub098\uba74 \uc911\ub7c9 \ubd84\ubc30 \ubc0f \uc9c0\ud615 \ubd84\uc11d\uacfc \uac19\uc740 \uace0\uae09 \uc804\ub7b5\uc5d0 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. STEP1: \uc9c0\ud615\uc744 \uad00\ucc30\ud558\uc2ed\uc2dc\uc624. \ubc14\uc704\uac00 \ub9ce\uc740 \uae38\uc740 \uc18d\ub3c4\ub97c \ub2a6\ucd94\uace0, \ubaa8\ub798 \uc9c0\uc5ed\uc740 \ucd94\uc9c4\ub825\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP2: \uae30\uc6b8\uae30 \ucee8\ud2b8\ub864\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc804\ubc29 \ub610\ub294 \ud6c4\ubc29\uc73c\ub85c \ucc28\ub7c9\uc758 \uc911\ub7c9\uc744 \uc870\uc808\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\uce90\ub144 \ud074\ub77c\uc774\ubc0d' \ub808\ubca8\uc5d0\uc11c \uc804\ubc29\uc73c\ub85c \uae30\uc6b8\uc774\uba74 \uac00\ud30c\ub978 \uacbd\uc0ac\ub85c\uc758 \uc811\uc9c0\ub825\uc744 \uc720\uc9c0\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. STEP3: \uc18d\ub3c4\ub97c \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \ub2c8\ud2b8\ub85c \ubd80\uc2a4\ud2b8\ub97c \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uace0, \ud3c9\ud3c9\ud55c \uad6c\uac04\uc5d0 \uc800\uc7a5\ud558\uc2ed\uc2dc\uc624. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: \ucd08\ubcf4\uc790\ub294 \uc18d\ub3c4\uc5d0 \uc758\uc874\ud558\ub294 \ubc18\uba74, \uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\ub294 \uc815\ud655\uc131\uacfc\uc758 \uc18d\ub3c4 \uade0\ud615\uc744 \ub9de\ucda5\ub2c8\ub2e4.]"}, {"question": "MX \uc624\ud504\ub85c\ub4dc \ub9c8\uc2a4\ud130\uc5d0\uc11c \ucc28\ub7c9 \ub9de\ucda4 \uc124\uc815\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "MX \uc624\ud504\ub85c\ub4dc \ub9c8\uc2a4\ud130\uc5d0\uc11c \ucc28\ub7c9 \ub9de\ucda4 \uc124\uc815\uc740 \uc131\ub2a5\uc5d0 \uc0c1\ub2f9\ud55c \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ud2b9\uc815 \uc9c0\ud615\uc5d0\uc11c\uc758 \uadf8\ub9bd\ub825\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uae30 \uc704\ud574 \ud0c0\uc774\uc5b4\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc2ed\uc2dc\uc624. \uc2b5\ud55c \uc9c0\uc5ed\uc5d0\ub294 \uc9c4\ud759 \ud0c0\uc774\uc5b4\ub97c, \ubcf5\uc7a1\ud55c \uc9c0\ud615\uc5d0\ub294 \uc624\ud504\ub85c\ub4dc \ud0c0\uc774\uc5b4\ub97c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\ub2aa\uc9c0\ub300 \ucc4c\ub9b0\uc9c0' \ub808\ubca8\uc5d0\uc11c\ub294 \uc9c4\ud759 \ud0c0\uc774\uc5b4\uac00 \ubbf8\ub044\ub7ec\uc9d0\uc744 \uc904\uc785\ub2c8\ub2e4. \uc11c\uc2a4\ud39c\uc158 \uc124\uc815\uc744 \uc870\uc815\ud558\uc2ed\uc2dc\uc624. \ubd80\ub4dc\ub7ec\uc6b4 \uc11c\uc2a4\ud39c\uc158\uc740 \uc6b8\ud241\ubd88\ud241\ud55c \ud2b8\ub808\uc77c\uc744 \uc704\ud574 \uc774\uc0c1\uc801\uc774\uba70, \ub2e8\ub2e8\ud55c \uc11c\uc2a4\ud39c\uc158\uc740 \ud3c9\ud3c9\ud55c \ud2b8\ub799\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4. \uc791\uc804 \ubaa8\ub4dc\ub97c \uc2e4\ud5d8\ud558\uace0 \uc2e4\uc81c \ubaa8\ub4dc\uc5d0\uc11c \ud14c\uc2a4\ud2b8\ud558\uae30 \uc704\ud574 \ucc28\uace0 \uba54\ub274\ub97c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. [\uc124\uc815 \ube44\uad50\ud45c: \uc9c4\ud759 \ud0c0\uc774\uc5b4 \u2013 \uc2b5\ud55c \uc9c0\ud615/\uc624\ud504\ub85c\ub4dc \ud0c0\uc774\uc5b4 \u2013 \ub2e4\uc591\ud55c \uc9c0\ud615/\uc11c\uc2a4\ud39c\uc158 \uc124\uc815 \u2013 \ud2b8\ub808\uc77c \uc720\ud615\uc5d0 \ub9de\uac8c \uc870\uc815.]"}, {"question": "MX \uc624\ud504\ub85c\ub4dc \ub9c8\uc2a4\ud130\uc758 \ubb3c\ub9ac \uc5d4\uc9c4\uc740 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "MX \uc624\ud504\ub85c\ub4dc \ub9c8\uc2a4\ud130\uc758 \ubb3c\ub9ac \uc5d4\uc9c4\uc740 \ud604\uc2e4\uc801\uc778 \uc5ed\ud559\uc744 \uc2dc\ubbac\ub808\uc774\uc158\ud558\uc5ec \ucc28\ub7c9 \uc870\uc791 \ubc0f \ud658\uacbd \uc0c1\ud638 \uc791\uc6a9\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubc14\uc704 \uc704\ub97c \uc6b4\uc804\ud558\uba74 \ud604\uc2e4\uc801\uc778 \ucda9\uaca9\uc774 \ubc1c\uc0dd\ud558\uace0, \uc9c4\ud759\uc740 \uc811\uc9c0\ub825\uacfc \uc18d\ub3c4\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc5d4\uc9c4\uc740 \uc911\ub7c9 \ubd84\ubc30, \ucd94\uc9c4\ub825 \ubc0f \uc9c0\ud615 \uc800\ud56d\uc744 \uacc4\uc0b0\ud558\uc5ec \uac01 \uc8fc\ud589\uc744 \ub3c5\ud2b9\ud558\uac8c \ub9cc\ub4ed\ub2c8\ub2e4. '\ubc14\uc704 \uc5b8\ub355' \ub808\ubca8\uc5d0\uc11c \uc911\ub7c9 \ubd84\ubc30\uac00 \uc798\ubabb\ub418\uba74 \ub4a4\uc9d1\ud790 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\uba74 \ud50c\ub808\uc774\uc5b4\uac00 \uc6b4\uc804 \uc2a4\ud0c0\uc77c\uc5d0 \uc801\uc751\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ubb3c\ub9ac \uc5d4\uc9c4\uc740 \ubaa8\ub4e0 \uc694\ucca0\uacfc \ubbf8\ub044\ub7ec\uc9d0\uc744 \uacc4\uc0b0\ud558\ub294 \uac00\uc0c1 \uc9c0\ud615 \uacfc\ud559\uc790\uc640 \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ub2e4\uc591\ud55c \uc9c0\ud615\uc5d0 \uac00\uc7a5 \uc801\ud569\ud55c MX \uc624\ud504\ub85c\ub4dc \ub9c8\uc2a4\ud130 \ucc28\ub7c9\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "MX \uc624\ud504\ub85c\ub4dc \ub9c8\uc2a4\ud130\ub294 \ub2e4\uc591\ud55c \ucc28\ub7c9\uc744 \uc81c\uacf5\ud558\uba70, \uac01\uac01 \ud2b9\uc815 \uc9c0\ud615\uc5d0 \ucd5c\uc801\ud654\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. ATV\ub294 \uac00\ubcbc\uc6c0\uacfc \ubbfc\ucca9\uc131\uc73c\ub85c \uc778\ud574 \uc9c4\ud759\uacfc \uc232 \uc9c0\uc5ed\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4. \ubc14\uc704\uac00 \ub9ce\uc740 \uc9c0\ud615\uc758 \uacbd\uc6b0 4x4 SUV\ub294 \uc548\uc815\uc131\uacfc \uac15\ub825\ud55c \uc131\ub2a5\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. '\uc0ac\ub9c9 \ub300\uc2dc' \ub808\ubca8\uc5d0\uc11c \uc0ac\ub9c9 \uc9c0\ud615 \uc790\ub3d9\ucc28\ub294 \ubaa8\ub798\uc5d0\uc11c\uc758 \uc18d\ub3c4\uc640 \uc870\uc791\uc131\uc73c\ub85c \ub2e4\ub978 \ucc28\ub7c9\ubcf4\ub2e4 \ub6f0\uc5b4\ub0a9\ub2c8\ub2e4. \ucc28\ub7c9 \uc120\ud0dd \uba54\ub274\uc5d0\uc11c \ub2e4\ub978 \ucc28\ub7c9\uc744 \uc2dc\ud5d8\ud574\ubcf4\uace0 \uac01 \ub808\ubca8\uc5d0 \uac00\uc7a5 \uc801\ud569\ud55c \ucc28\ub7c9\uc744 \ucc3e\uc73c\uc2ed\uc2dc\uc624. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: ATV \u2013 \uc9c4\ud759 / 4x4 SUV \u2013 \ubc14\uc704 / \uc0ac\ub9c9 \uc9c0\ud615 \uc790\ub3d9\ucc28 \u2013 \ubaa8\ub798.]"}, {"question": "MX \uc624\ud504\ub85c\ub4dc \ub9c8\uc2a4\ud130\uc758 \uc2dc\uac04 \uc2dc\ud5d8 \ubaa8\ub4dc\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc2dc\uac04 \uc2dc\ud5d8\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc73c\ub824\uba74 \uc815\ud655\uc131\uacfc \uc18d\ub3c4 \ucd5c\uc801\ud654\uc5d0 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. STEP1: \ucf54\uc2a4 \ubc30\uce58\ub97c \uc554\uae30\ud558\uc5ec \ud68c\uc804\uacfc \uc7a5\uc560\ubb3c\uc744 \uc608\uce21\ud558\uc2ed\uc2dc\uc624. STEP2: \ub2c8\ud2b8\ub85c \ubd80\uc2a4\ud2b8\ub97c \uc9c1\uc120 \uad6c\uac04\uc5d0\uc11c \uc0ac\uc6a9\ud558\uc5ec \uc18d\ub3c4\ub97c \uadf9\ub300\ud654\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\uc232 \uc2a4\ud504\ub9b0\ud2b8' \ub808\ubca8\uc5d0\uc11c \ub9c8\uc9c0\ub9c9 \uad6c\uac04\uc5d0 \ub2c8\ud2b8\ub85c\ub97c \uc800\uc7a5\ud558\uc2ed\uc2dc\uc624. STEP3: \uace1\uc120\uc744 \ubd80\ub4dc\ub7fd\uac8c \ud1b5\uacfc\ud558\uc5ec \uc81c\ub3d9\uc744 \ucd5c\uc18c\ud654\ud558\uc2ed\uc2dc\uc624. \uc5ec\ub7ec \ubc88 \uc5f0\uc2b5\ud558\uc5ec \uc2dc\uac04\uc744 \ub2e8\ucd95\ud558\uc2ed\uc2dc\uc624. [\uc808\ucc28\ub3c4 \uc124\uba85: \ucf54\uc2a4 \uc554\uae30 \u2192 \ub2c8\ud2b8\ub85c \uc804\ub7b5\uc801 \uc0ac\uc6a9 \u2192 \ubd80\ub4dc\ub7ec\uc6b4 \ud68c\uc804 \u2192 \ub192\uc740 \uc810\uc218.]"}, {"question": "PC \ubc0f \ubaa8\ubc14\uc77c MX \uc624\ud504\ub85c\ub4dc \ub9c8\uc2a4\ud130\uc758 \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "MX \uc624\ud504\ub85c\ub4dc \ub9c8\uc2a4\ud130\ub294 \ucd5c\uc801\uc758 \uc131\ub2a5\uc744 \uc704\ud574 \ud2b9\uc815 \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. PC\uc5d0\uc11c\ub294 \ucd5c\uc18c\ud55c \uc778\ud154 i5 \ud504\ub85c\uc138\uc11c, 8GB RAM \ubc0f NVIDIA GTX 1050\uacfc \uac19\uc740 \uc804\uc6a9 GPU\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ubaa8\ubc14\uc77c\uc5d0\uc11c\ub294 \uc548\ub4dc\ub85c\uc774\ub4dc 8.0 \uc774\uc0c1 \ubc0f iOS 12 \uc774\uc0c1, \ucd5c\uc18c 2GB RAM\uc744 \uc9c0\uc6d0\ud569\ub2c8\ub2e4. \uc7a5\uce58\uac00 \uc774\ub7ec\ud55c \uc0ac\uc591\uc744 \ucda9\uc871\ud558\ub294\uc9c0 \ud655\uc778\ud558\uc5ec \uc6d0\ud65c\ud55c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc990\uae30\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc800\uc0ac\uc591 \uc7a5\uce58\ub294 '\uc0b0 \uc815\uc0c1'\uacfc \uac19\uc740 \uadf8\ub798\ud53d\uc801\uc73c\ub85c \uc9d1\uc911\uc801\uc778 \ub808\ubca8\uc5d0\uc11c \uc9c0\uc5f0\uc774 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: PC \u2013 \uc778\ud154 i5 / 8GB RAM / NVIDIA GTX 1050 | \ubaa8\ubc14\uc77c \u2013 \uc548\ub4dc\ub85c\uc774\ub4dc 8.0 \uc774\uc0c1 / iOS 12 \uc774\uc0c1 / 2GB RAM.]"}, {"question": "MX \uc624\ud504\ub85c\ub4dc \ub9c8\uc2a4\ud130\uc5d0\uc11c \uc5ec\ub7ec \uc7a5\uce58 \uac04\uc5d0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "MX \uc624\ud504\ub85c\ub4dc \ub9c8\uc2a4\ud130\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub824\uba74 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. STEP1: \uc6d0\ub798 \uc7a5\uce58\uc5d0\uc11c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uace0 \uc124\uc815 \uba54\ub274\uc5d0\uc11c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ud65c\uc131\ud654\ud558\uc2ed\uc2dc\uc624. STEP2: \uc0c8 \uc7a5\uce58\uc5d0\uc11c \uac8c\uc784\uc744 \uc124\uce58\ud558\uace0 \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uc2ed\uc2dc\uc624. STEP3: \ud074\ub77c\uc6b0\ub4dc\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ubaa8\ubc14\uc77c\uc5d0\uc11c PC\ub85c \uc804\ud658\ud558\uba74 \uc7a0\uae08 \ud574\uc81c\ub41c \ucc28\ub7c9 \ubc0f \ub808\ubca8\uc774 \uc804\ub2ec\ub429\ub2c8\ub2e4. \ud504\ub85c\uc138\uc2a4 \uc911\uc5d0 \uc548\uc815\uc801\uc778 \uc778\ud130\ub137 \uc5f0\uacb0\uc744 \uc720\uc9c0\ud558\uc2ed\uc2dc\uc624. [\ube44\uc720 \uc124\uba85: \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc740 \ub9c8\uce58 \ub514\uc9c0\ud138 \ubc30\ub0ad\uacfc \uac19\uc73c\uba70, \uc5b4\ub514\ub4e0\uc9c0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uac00\uc9c0\uace0 \ub2e4\ub2d0 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "MX \uc624\ud504\ub85c\ub4dc \ub9c8\uc2a4\ud130\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "MX \uc624\ud504\ub85c\ub4dc \ub9c8\uc2a4\ud130\uc5d0\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. '\ud3d0\ud5c8\uac00 \ub41c \uad11\uc0b0' \ub808\ubca8\uc5d0\uc11c \ud3ed\ud3ec \ub4a4\uc758 \uc881\uc740 \uae38\uc744 \ub530\ub77c \uc6b4\uc804\ud558\uc5ec \ube44\ubc00 \ub3d9\uad74\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc548\uc5d0\uc11c \ud76c\uadc0\ud55c \ucc28\ub7c9 \uc2a4\ud0a8\uc744 \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 '\ub3c4\uc2dc \ud0c8\ucd9c' \ub808\ubca8\uc5d0\uc11c \ud2b9\uc815 \uac04\ud310 \uadfc\ucc98\uc5d0\uc11c \uacbd\uc801\uc744 \uc6b8\ub9ac\uba74 \ub3c5\ud2b9\ud55c \uc0ac\uc6b4\ub4dc \ud6a8\uacfc\uac00 \ubc1c\uc0dd\ud569\ub2c8\ub2e4. \ubc97\uc5b4\ub09c \uacf3\uc744 \ud0d0\ud5d8\ud558\uc5ec \uc774\ub7ec\ud55c \ub180\ub77c\uc6c0\uc744 \ubc1c\uacac\ud558\uc2ed\uc2dc\uc624. [\ube44\uc720 \uc124\uba85: \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb3b\ud78c \ubcf4\ubb3c\uacfc \uac19\uc73c\uba70, \ud638\uae30\uc2ec\uacfc \ud0d0\ud5d8\uc744 \ubcf4\uc0c1\ud569\ub2c8\ub2e4.]"}, {"question": "'\ud654\uc0b0 \ub4f1\ubc18'\uacfc \uac19\uc740 MX \uc624\ud504\ub85c\ub4dc \ub9c8\uc2a4\ud130\uc758 \uac00\uc7a5 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc744 \uc5b4\ub5bb\uac8c \uadf9\ubcf5\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "'\ud654\uc0b0 \ub4f1\ubc18'\uacfc \uac19\uc740 \ub09c\uc774\ub3c4\uac00 \ub192\uc740 \ub808\ubca8\uc744 \uc815\ubcf5\ud558\ub824\uba74 \uc804\ub7b5\uc801\uc778 \uc811\uadfc \ubc29\uc2dd\uc744 \ucc44\ud0dd\ud558\uc2ed\uc2dc\uc624. STEP1: \uc5f0\uc2b5 \ubaa8\ub4dc\uc5d0\uc11c \ub808\ubca8 \ubc30\uce58\ub97c \uc5f0\uad6c\ud558\uc5ec \uc5b4\ub824\uc6b4 \uad6c\uac04\uc744 \ud30c\uc545\ud558\uc2ed\uc2dc\uc624. STEP2: \uc9c0\ud615\uc5d0 \ub9de\ub294 \ucd5c\uace0\uc758 \ud0c0\uc774\uc5b4\uc640 \uc11c\uc2a4\ud39c\uc158\uc73c\ub85c \ucc28\ub7c9\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\ud654\uc0b0 \ub4f1\ubc18'\uc5d0\uc11c\ub294 \uc6a9\uc554 \uc9c0\uc5ed\uc5d0 \uacac\ub51c \uc218 \uc788\ub294 \ub0b4\uc5f4\uc131 \ud0c0\uc774\uc5b4\ub97c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. STEP3: \ucc38\uc744\uc131\uc744 \uc720\uc9c0\ud558\uace0 \uc11c\ub450\ub974\uc9c0 \ub9c8\uc2ed\uc2dc\uc624. \uc815\ud655\uc131\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \ubc18\ubcf5\uc801\uc778 \uc5f0\uc2b5\uc744 \ud1b5\ud574 \ub808\ubca8\uc758 \ubbf8\ubb18\ud568\uc744 \ub9c8\uc2a4\ud130\ud558\uc2ed\uc2dc\uc624. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: \uc11c\ub450\ub974\uba74 \uc2e4\uc218\uac00 \ubc1c\uc0dd\ud558\uace0 / \uc778\ub0b4\ub294 \uc131\uacf5\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4.]"}]
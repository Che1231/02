[{"question": "\u5982\u4f55\u4ee5\u9806\u5229\u7684\u65b9\u5f0f\u5728MX Offroad Master\u4e2d\u57f7\u884c\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u958b\u59cb\u4f7f\u7528MX Offroad Master\uff0c\u8acb\u5148\u719f\u6089\u57fa\u672c\u63a7\u5236\u3002\u4f7f\u7528\u87a2\u5e55\u4e0a\u7684\u64cd\u7e31\u687f\u9032\u884c\u65b9\u5411\u76e4\u63a7\u5236\uff0c\u4e26\u4f7f\u7528\u52a0\u901f\u6309\u9215\u524d\u9032\u3002\u4f8b\u5982\uff0c\u5728\u300e\u521d\u5b78\u8005\u5c0f\u5f91\u300f\u95dc\u5361\u4e2d\uff0c\u8f15\u8f15\u9ede\u64ca\u52a0\u901f\u6309\u9215\u4ee5\u907f\u514d\u5728\u6ce5\u6fd8\u5730\u5f62\u4e0a\u6253\u6ed1\u3002\u524e\u8eca\u81f3\u95dc\u91cd\u8981\uff1b\u5728\u6025\u8f49\u5f4e\u524d\u4f7f\u7528\u524e\u8eca\u6309\u9215\u6e1b\u901f\u3002\u5728\u8a13\u7df4\u6a21\u5f0f\u4e2d\u7df4\u7fd2\u9019\u4e9b\u63a7\u5236\uff0c\u4ee5\u5efa\u7acb\u4fe1\u5fc3\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u63a7\u5236\u60f3\u50cf\u6210\u99d5\u99db\u771f\u5be6\u8d8a\u91ce\u8eca\uff0c\u8f15\u67d4\u7684\u8f38\u5165\u5c07\u6709\u52a9\u65bc\u66f4\u597d\u7684\u64cd\u63a7\u3002]"}, {"question": "\u5728\u904a\u6232\u5b8c\u6210100\u5c0f\u6642\u5f8c\uff0c\u8981\u638c\u63e1MX Offroad Master\uff0c\u54ea\u4e9b\u7b56\u7565\u662f\u5fc5\u8981\u7684\uff1f", "answer": "\u5b8c\u6210100\u5c0f\u6642\u5f8c\uff0c\u8acb\u5c08\u6ce8\u65bc\u66f4\u9ad8\u7d1a\u7684\u7b56\u7565\uff0c\u4f8b\u5982\u91cd\u91cf\u5206\u4f48\u548c\u5730\u5f62\u5206\u6790\u3002\u6b65\u9a5f\u4e00\uff1a\u89c0\u5bdf\u5730\u5f62\u2014\u2014\u5ca9\u77f3\u8def\u9762\u9700\u8981\u964d\u4f4e\u901f\u5ea6\uff0c\u800c\u6c99\u5730\u5247\u9700\u8981\u52d5\u91cf\u3002\u6b65\u9a5f\u4e8c\uff1a\u900f\u904e\u50be\u659c\u63a7\u5236\u5411\u524d\u6216\u5411\u5f8c\u8abf\u6574\u8eca\u8f1b\u91cd\u91cf\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5cfd\u8c37\u6500\u767b\u300f\u95dc\u5361\u4e2d\uff0c\u5411\u524d\u50be\u659c\u6709\u52a9\u65bc\u5728\u9661\u5ced\u659c\u5761\u4e0a\u7dad\u6301\u727d\u5f15\u529b\u3002\u6b65\u9a5f\u4e09\uff1a\u7b56\u7565\u6027\u5730\u4f7f\u7528\u6c2e\u6c23\u589e\u5f37\uff0c\u5c07\u5176\u5132\u5b58\u65bc\u5e73\u5766\u8def\u6bb5\u4ee5\u6700\u5927\u5316\u901f\u5ea6\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u8207\u4f9d\u8cf4\u901f\u5ea6\u7684\u521d\u5b78\u8005\u4e0d\u540c\uff0c\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u5247\u5e73\u8861\u901f\u5ea6\u8207\u7cbe\u6e96\u5ea6\u3002]"}, {"question": "\u5728MX Offroad Master\u4e2d\uff0c\u70ba\u4ec0\u9ebc\u8eca\u8f1b\u5ba2\u88fd\u5316\u5f88\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u512a\u5316\u5b83\uff1f", "answer": "MX Offroad Master\u4e2d\u7684\u8eca\u8f1b\u5ba2\u88fd\u5316\u986f\u8457\u5f71\u97ff\u8868\u73fe\u3002\u5347\u7d1a\u60a8\u7684\u8f2a\u80ce\uff0c\u4ee5\u5728\u7279\u5b9a\u5730\u5f62\u4e0a\u7372\u5f97\u66f4\u597d\u7684\u6293\u5730\u529b\u2014\u2014\u6ce5\u5730\u8f2a\u80ce\u9069\u7528\u65bc\u6f6e\u6fd5\u5340\u57df\uff0c\u5168\u5730\u5f62\u8f2a\u80ce\u9069\u7528\u65bc\u6df7\u5408\u5730\u5f62\u3002\u4f8b\u5982\uff0c\u5728\u300e\u6cbc\u6fa4\u6311\u6230\u300f\u4e2d\uff0c\u6ce5\u5730\u8f2a\u80ce\u53ef\u6e1b\u5c11\u6253\u6ed1\u3002\u8abf\u6574\u61f8\u540a\u8a2d\u5b9a\uff1b\u8f03\u8edf\u7684\u61f8\u540a\u9069\u5408\u5d0e\u5d87\u7684\u9053\u8def\uff0c\u800c\u8f03\u786c\u7684\u61f8\u540a\u9069\u5408\u5e73\u5766\u7684\u8def\u7dda\u3002\u4f7f\u7528\u8eca\u5eab\u9078\u55ae\u4f86\u5617\u8a66\u8a2d\u5b9a\u4e26\u5728\u7df4\u7fd2\u6a21\u5f0f\u4e2d\u6e2c\u8a66\u5b83\u5011\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6ce5\u5730\u8f2a\u80ce - \u6f6e\u6fd5\u5730\u5f62 / \u5168\u5730\u5f62\u8f2a\u80ce - \u6df7\u5408\u5730\u5f62 / \u61f8\u540a\u8a2d\u5b9a - \u4f9d\u5730\u5f62\u985e\u578b\u8abf\u6574\u3002]"}, {"question": "MX Offroad Master\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u5982\u4f55\u5f71\u97ff\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "MX Offroad Master\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u6a21\u64ec\u771f\u5be6\u4e16\u754c\u7684\u52d5\u529b\u5b78\uff0c\u5f71\u97ff\u8eca\u8f1b\u64cd\u63a7\u548c\u74b0\u5883\u4e92\u52d5\u3002\u4f8b\u5982\uff0c\u99d5\u99db\u8d8a\u904e\u5ca9\u77f3\u6703\u7522\u751f\u771f\u5be6\u7684\u9707\u52d5\uff0c\u800c\u6ce5\u571f\u6703\u5f71\u97ff\u6293\u5730\u529b\u53ca\u901f\u5ea6\u3002\u5f15\u64ce\u6703\u8a08\u7b97\u91cd\u91cf\u5206\u4f48\u3001\u52d5\u91cf\u548c\u5730\u5f62\u963b\u529b\uff0c\u8b93\u6bcf\u4e00\u6b21\u7684\u9a0e\u4e58\u90fd\u7368\u4e00\u7121\u4e8c\u3002\u5728\u300e\u5ca9\u77f3\u5c71\u810a\u300f\u95dc\u5361\u4e2d\uff0c\u4e0d\u6b63\u78ba\u7684\u91cd\u91cf\u5206\u4f48\u53ef\u80fd\u5c0e\u81f4\u7ffb\u8eca\u3002\u4e86\u89e3\u9019\u4e9b\u6a5f\u5236\u6709\u52a9\u65bc\u73a9\u5bb6\u8abf\u6574\u4ed6\u5011\u7684\u99d5\u99db\u98a8\u683c\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u7269\u7406\u5f15\u64ce\u5c31\u50cf\u4e00\u500b\u865b\u64ec\u7684\u5730\u5f62\u79d1\u5b78\u5bb6\uff0c\u8a08\u7b97\u8457\u6bcf\u4e00\u500b\u985b\u7c38\u548c\u6ed1\u52d5\u3002]"}, {"question": "\u54ea\u4e9bMX Offroad Master\u8eca\u8f1b\u6700\u9069\u5408\u4e0d\u540c\u7684\u5730\u5f62\uff1f", "answer": "MX Offroad Master\u63d0\u4f9b\u5404\u7a2e\u8eca\u8f1b\uff0c\u6bcf\u6b3e\u8eca\u8f1b\u90fd\u91dd\u5c0d\u7279\u5b9a\u5730\u5f62\u9032\u884c\u6700\u4f73\u5316\u3002ATV\u64c5\u9577\u65bc\u6ce5\u6fd8\u548c\u68ee\u6797\u5730\u5340\uff0c\u7531\u65bc\u5176\u8f15\u5de7\u4e14\u9748\u6d3b\u3002\u5c0d\u65bc\u5ca9\u77f3\u5730\u5f62\uff0c4x4\u904b\u52d5\u578b\u4f11\u65c5\u8eca\u63d0\u4f9b\u7a69\u5b9a\u6027\u548c\u52d5\u529b\u3002\u5728\u300e\u6c99\u6f20\u885d\u523a\u300f\u95dc\u5361\u4e2d\uff0c\u6c99\u7058\u8eca\u5728\u6c99\u5730\u4e0a\u64c1\u6709\u901f\u5ea6\u548c\u64cd\u63a7\u4e0a\u7684\u512a\u52e2\u3002\u5728\u8eca\u8f1b\u9078\u55ae\u4e2d\u5617\u8a66\u4e0d\u540c\u7684\u8eca\u8f1b\uff0c\u4ee5\u627e\u5230\u6700\u9069\u5408\u6bcf\u500b\u95dc\u5361\u7684\u8eca\u8f1b\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1aATV - \u6ce5\u6fd8 / 4x4\u904b\u52d5\u578b\u4f11\u65c5\u8eca - \u5ca9\u77f3 / \u6c99\u7058\u8eca - \u6c99\u5730\u3002]"}, {"question": "\u5982\u4f55\u5728MX Offroad Master\u7684\u6642\u9593\u8a66\u7149\u6a21\u5f0f\u4e2d\u53d6\u5f97\u9ad8\u5206\uff1f", "answer": "\u8981\u5728\u6642\u9593\u8a66\u7149\u6a21\u5f0f\u4e2d\u53d6\u5f97\u9ad8\u5206\uff0c\u8acb\u5c08\u6ce8\u65bc\u7cbe\u6e96\u5ea6\u548c\u901f\u5ea6\u6700\u4f73\u5316\u3002\u6b65\u9a5f\u4e00\uff1a\u8a18\u4f4f\u8cfd\u9053\u4f48\u5c40\uff0c\u4ee5\u9810\u6e2c\u8f49\u5f4e\u548c\u969c\u7919\u7269\u3002\u6b65\u9a5f\u4e8c\uff1a\u5728\u76f4\u7dda\u8def\u6bb5\u4f7f\u7528\u6c2e\u6c23\u589e\u5f37\u4ee5\u6700\u5927\u5316\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u300e\u68ee\u6797\u885d\u523a\u300f\u95dc\u5361\u4e2d\uff0c\u8acb\u5c07\u6c2e\u6c23\u5132\u5b58\u5230\u6700\u5f8c\u4e00\u6bb5\u8def\u7a0b\u3002\u6b65\u9a5f\u4e09\uff1a\u900f\u904e\u5e73\u7a69\u7684\u8def\u7dda\u901a\u904e\u5f4e\u9053\uff0c\u5c07\u524e\u8eca\u6e1b\u5230\u6700\u4f4e\u3002\u53cd\u8986\u7df4\u7fd2\uff0c\u4ee5\u7e2e\u77ed\u60a8\u7684\u6642\u9593\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u8a18\u4f4f\u8cfd\u9053 \u2192 \u7b56\u7565\u6027\u5730\u4f7f\u7528\u6c2e\u6c23\u589e\u5f37 \u2192 \u5e73\u7a69\u8f49\u5f4e \u2192 \u9ad8\u5206\u3002]"}, {"question": "MX Offroad Master\u5728\u96fb\u8166\u548c\u5e73\u677f\u96fb\u8166\u4e0a\u7684\u7cfb\u7d71\u9700\u6c42\u70ba\u4f55\uff1f", "answer": "MX Offroad Master\u6709\u7279\u5b9a\u7684\u7cfb\u7d71\u9700\u6c42\uff0c\u4ee5\u9054\u5230\u6700\u4f73\u6027\u80fd\u3002\u5728\u96fb\u8166\u4e0a\uff0c\u5b83\u81f3\u5c11\u9700\u8981\u82f1\u7279\u723e i5 \u8655\u7406\u5668\u30018GB RAM \u548c NVIDIA GTX 1050 \u7b49\u5c08\u7528 GPU\u3002\u5c0d\u65bc\u884c\u52d5\u88dd\u7f6e\uff0c\u5b83\u652f\u63f4 Android 8.0 \u4ee5\u4e0a\u548c iOS 12 \u4ee5\u4e0a\uff0c\u4e14\u81f3\u5c11\u9700\u8981 2GB RAM\u3002\u78ba\u4fdd\u60a8\u7684\u88dd\u7f6e\u7b26\u5408\u9019\u4e9b\u898f\u7bc4\uff0c\u4ee5\u4eab\u53d7\u9806\u66a2\u7684\u904a\u6232\u9ad4\u9a57\u3002\u4f8b\u5982\uff0c\u4f4e\u968e\u88dd\u7f6e\u5728\u5716\u5f62\u5bc6\u96c6\u7684\u95dc\u5361\uff08\u4f8b\u5982\u300e\u5c71\u5cf0\u300f\uff09\u4e2d\u53ef\u80fd\u6703\u51fa\u73fe\u5ef6\u9072\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u96fb\u8166 - \u82f1\u7279\u723e i5 / 8GB RAM / NVIDIA GTX 1050 | \u884c\u52d5\u88dd\u7f6e - Android 8.0 \u4ee5\u4e0a / iOS 12 \u4ee5\u4e0a / 2GB RAM\u3002]"}, {"question": "\u5982\u4f55\u5728\u4e0d\u540c\u7684\u88dd\u7f6e\u4e4b\u9593\u8f49\u79fbMX Offroad Master\u7684\u904a\u6232\u9032\u5ea6\uff1f", "answer": "\u8981\u8f49\u79fb MX Offroad Master \u7684\u904a\u6232\u9032\u5ea6\uff0c\u8acb\u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u3002\u6b65\u9a5f\u4e00\uff1a\u767b\u5165\u539f\u59cb\u88dd\u7f6e\u4e0a\u7684\u5e33\u6236\uff0c\u4e26\u5728\u8a2d\u5b9a\u9078\u55ae\u4e2d\u555f\u7528\u96f2\u7aef\u5132\u5b58\u3002\u6b65\u9a5f\u4e8c\uff1a\u5728\u65b0\u88dd\u7f6e\u4e0a\u5b89\u88dd\u904a\u6232\u4e26\u4f7f\u7528\u76f8\u540c\u7684\u5e33\u6236\u767b\u5165\u3002\u6b65\u9a5f\u4e09\uff1a\u540c\u6b65\u96f2\u7aef\u4e0a\u7684\u904a\u6232\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9e\u884c\u52d5\u88dd\u7f6e\u5207\u63db\u5230\u96fb\u8166\uff0c\u60a8\u89e3\u9396\u7684\u8eca\u8f1b\u548c\u95dc\u5361\u5c07\u6703\u651c\u5e36\u904e\u4f86\u3002\u8acb\u78ba\u4fdd\u904e\u7a0b\u4e2d\u7db2\u8def\u9023\u7dda\u7a69\u5b9a\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u96f2\u7aef\u5132\u5b58\u5c31\u50cf\u4e00\u500b\u6578\u4f4d\u80cc\u5305\uff0c\u5c07\u60a8\u7684\u9032\u5ea6\u5e36\u5230\u4efb\u4f55\u5730\u65b9\u3002]"}, {"question": "MX Offroad Master\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\uff1f", "answer": "MX Offroad Master\u5305\u542b\u8a31\u591a\u96b1\u85cf\u7684\u5f69\u86cb\uff0c\u4f9b\u73a9\u5bb6\u767c\u73fe\u3002\u5728\u300e\u5ee2\u68c4\u7926\u5751\u300f\u95dc\u5361\u4e2d\uff0c\u6709\u4e00\u500b\u79d8\u5bc6\u6d1e\u7a74\uff0c\u53ef\u900f\u904e\u7011\u5e03\u5f8c\u9762\u7684\u72f9\u7a84\u5c0f\u5f91\u5230\u9054\u3002\u88e1\u9762\uff0c\u60a8\u6703\u627e\u5230\u7a00\u6709\u7684\u8eca\u8f1b\u5916\u89c0\u3002\u53e6\u4e00\u500b\u5f69\u86cb\u5728\u300e\u57ce\u5e02\u9003\u812b\u300f\u95dc\u5361\u4e2d\uff0c\u5728\u7279\u5b9a\u5ee3\u544a\u724c\u9644\u8fd1\u6309\u5587\u53ed\u5c07\u6703\u89f8\u767c\u7368\u7279\u7684\u97f3\u6548\u3002\u63a2\u7d22\u504f\u9060\u5730\u5340\uff0c\u4ee5\u767c\u73fe\u9019\u4e9b\u9a5a\u559c\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5f69\u86cb\u5c31\u50cf\u57cb\u85cf\u7684\u73cd\u5bf6\uff0c\u734e\u52f5\u597d\u5947\u5fc3\u548c\u63a2\u7d22\u3002]"}, {"question": "\u5982\u4f55\u514b\u670dMX Offroad Master\u4e2d\u6700\u5177\u6311\u6230\u6027\u7684\u95dc\u5361\uff1f", "answer": "\u8981\u5f81\u670d\u50cf\u300e\u706b\u5c71\u6500\u767b\u300f\u9019\u6a23\u7684\u6311\u6230\u95dc\u5361\uff0c\u8acb\u63a1\u884c\u7b56\u7565\u6027\u65b9\u6cd5\u3002\u6b65\u9a5f\u4e00\uff1a\u5728\u7df4\u7fd2\u6a21\u5f0f\u4e2d\u7814\u7a76\u95dc\u5361\u4f48\u5c40\uff0c\u4ee5\u8b58\u5225\u68d8\u624b\u7684\u5340\u57df\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u6700\u4f73\u8f2a\u80ce\u548c\u61f8\u540a\u5c07\u8eca\u8f1b\u5347\u7d1a\uff0c\u4ee5\u9069\u61c9\u5730\u5f62\u3002\u4f8b\u5982\uff0c\u5728\u300e\u706b\u5c71\u6500\u767b\u300f\u4e2d\uff0c\u4f7f\u7528\u8010\u71b1\u8f2a\u80ce\u4ee5\u627f\u53d7\u7194\u5ca9\u5340\u57df\u3002\u6b65\u9a5f\u4e09\uff1a\u4fdd\u6301\u8010\u5fc3\uff0c\u907f\u514d\u6025\u8e81\uff1b\u7cbe\u6e96\u5ea6\u662f\u95dc\u9375\u3002\u53cd\u8986\u7df4\u7fd2\uff0c\u638c\u63e1\u95dc\u5361\u7684\u7cbe\u9ad3\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u6025\u8e81\u5c0e\u81f4\u932f\u8aa4 / \u8010\u5fc3\u78ba\u4fdd\u6210\u529f\u3002]"}]
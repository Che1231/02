[{"question": "\u5982\u4f55\u6d41\u7545\u5730\u542f\u52a8MX\u8d8a\u91ce\u5927\u5e08\u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u5f00\u59cb\u4f7f\u7528MX\u8d8a\u91ce\u5927\u5e08\uff0c\u8bf7\u719f\u6089\u57fa\u672c\u63a7\u5236\u3002\u4f7f\u7528\u5c4f\u5e55\u4e0a\u7684\u64cd\u7eb5\u6746\u8fdb\u884c\u8f6c\u5411\uff0c\u4f7f\u7528\u52a0\u901f\u6309\u94ae\u5411\u524d\u79fb\u52a8\u3002\u4f8b\u5982\uff0c\u5728\"\u65b0\u624b\u8d5b\u9053\"\u7ea7\u522b\uff0c\u8f7b\u8f7b\u70b9\u51fb\u52a0\u901f\u6309\u94ae\u4ee5\u907f\u514d\u5728\u6ce5\u6cde\u5730\u5f62\u4e0a\u6253\u6ed1\u3002\u5236\u52a8\u81f3\u5173\u91cd\u8981\uff1b\u5728\u6025\u8f6c\u5f2f\u524d\u4f7f\u7528\u5236\u52a8\u6309\u94ae\u51cf\u901f\u3002\u5728\u8bad\u7ec3\u6a21\u5f0f\u4e2d\u7ec3\u4e60\u8fd9\u4e9b\u63a7\u5236\uff0c\u4ee5\u5efa\u7acb\u4fe1\u5fc3\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u8fd9\u4e9b\u63a7\u4ef6\u60f3\u8c61\u6210\u9a7e\u9a76\u771f\u6b63\u7684\u56db\u8f6e\u8d8a\u91ce\u8f66\u2014\u2014\u8f7b\u67d4\u7684\u8f93\u5165\u4f1a\u5bfc\u81f4\u66f4\u597d\u7684\u64cd\u63a7\u6027\u3002]"}, {"question": "\u5728\u73a9\u4e86100\u5c0f\u65f6\u540e\uff0c\u638c\u63e1MX\u8d8a\u91ce\u5927\u5e08\u7684\u5173\u952e\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "100\u5c0f\u65f6\u540e\uff0c\u4e13\u6ce8\u4e8e\u66f4\u9ad8\u7ea7\u7684\u7b56\u7565\uff0c\u4f8b\u5982\u91cd\u91cf\u5206\u914d\u548c\u5730\u5f62\u5206\u6790\u3002\u6b65\u9aa41\uff1a\u89c2\u5bdf\u5730\u5f62\u2014\u2014\u5ca9\u77f3\u8def\u9700\u8981\u8f83\u6162\u7684\u901f\u5ea6\uff0c\u800c\u6c99\u5730\u9700\u8981\u52a8\u91cf\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u503e\u659c\u63a7\u5236\u5411\u524d\u6216\u5411\u540e\u503e\u659c\u8c03\u6574\u8f66\u8f86\u91cd\u91cf\u3002\u4f8b\u5982\uff0c\u5728\"\u5ce1\u8c37\u6500\u767b\"\u7ea7\u522b\uff0c\u5411\u524d\u503e\u659c\u6709\u52a9\u4e8e\u5728\u9661\u5ced\u7684\u659c\u5761\u4e0a\u4fdd\u6301\u7275\u5f15\u529b\u3002\u6b65\u9aa43\uff1a\u6218\u7565\u6027\u5730\u4f7f\u7528\u6c2e\u6c14\u63d0\u5347\uff0c\u5c06\u5176\u4fdd\u5b58\u5230\u5e73\u5766\u7684\u8def\u6bb5\u4ee5\u6700\u5927\u5316\u901f\u5ea6\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u4e0e\u4f9d\u8d56\u901f\u5ea6\u7684\u65b0\u624b\u73a9\u5bb6\u4e0d\u540c\uff0c\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u5e73\u8861\u901f\u5ea6\u4e0e\u7cbe\u786e\u6027\u3002]"}, {"question": "\u5728MX\u8d8a\u91ce\u5927\u5e08\u4e2d\uff0c\u8f66\u8f86\u81ea\u5b9a\u4e49\u4e3a\u4ec0\u4e48\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u4f18\u5316\u5b83\uff1f", "answer": "MX\u8d8a\u91ce\u5927\u5e08\u4e2d\u7684\u8f66\u8f86\u81ea\u5b9a\u4e49\u4f1a\u663e\u8457\u5f71\u54cd\u6027\u80fd\u3002\u5347\u7ea7\u8f6e\u80ce\u4ee5\u6539\u5584\u7279\u5b9a\u5730\u5f62\u4e0a\u7684\u6293\u5730\u529b\u2014\u2014\u6e7f\u5730\u4f7f\u7528\u6ce5\u5730\u8f6e\u80ce\uff0c\u6df7\u5408\u8def\u51b5\u4f7f\u7528\u5168\u5730\u5f62\u8f6e\u80ce\u3002\u4f8b\u5982\uff0c\u5728\"\u6cbc\u6cfd\u6311\u6218\"\u4e2d\uff0c\u6ce5\u5730\u8f6e\u80ce\u51cf\u5c11\u4e86\u6253\u6ed1\u3002\u8c03\u6574\u60ac\u6302\u8bbe\u7f6e\uff1b\u98a0\u7c38\u7684\u8d5b\u9053\u5efa\u8bae\u4f7f\u7528\u8f83\u8f6f\u7684\u60ac\u6302\uff0c\u800c\u5e73\u5766\u7684\u8d5b\u9053\u9002\u5408\u4f7f\u7528\u8f83\u786c\u7684\u60ac\u6302\u3002\u4f7f\u7528\u8f66\u5e93\u83dc\u5355\u6765\u8bd5\u9a8c\u8bbe\u7f6e\u5e76\u5728\u7ec3\u4e60\u6a21\u5f0f\u4e2d\u6d4b\u8bd5\u5b83\u4eec\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6ce5\u5730\u8f6e\u80ce - \u6f6e\u6e7f\u5730\u5f62 / \u5168\u5730\u5f62\u8f6e\u80ce - \u6df7\u5408\u5730\u5f62 / \u60ac\u6302\u8bbe\u7f6e - \u6839\u636e\u8d5b\u9053\u7c7b\u578b\u8c03\u6574\u3002]"}, {"question": "MX\u8d8a\u91ce\u5927\u5e08\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\uff1f", "answer": "MX\u8d8a\u91ce\u5927\u5e08\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u6a21\u62df\u73b0\u5b9e\u4e16\u754c\u4e2d\u7684\u52a8\u6001\uff0c\u5f71\u54cd\u8f66\u8f86\u64cd\u63a7\u548c\u73af\u5883\u4e92\u52a8\u3002\u4f8b\u5982\uff0c\u5728\u5ca9\u77f3\u4e0a\u884c\u9a76\u4f1a\u5bfc\u81f4\u771f\u5b9e\u7684\u9707\u52a8\uff0c\u800c\u6ce5\u571f\u4f1a\u5f71\u54cd\u7275\u5f15\u529b\u548c\u901f\u5ea6\u3002\u8be5\u5f15\u64ce\u8ba1\u7b97\u91cd\u91cf\u5206\u914d\u3001\u52a8\u91cf\u548c\u5730\u5f62\u963b\u529b\uff0c\u4f7f\u6bcf\u4e00\u6b21\u9a7e\u9a76\u90fd\u72ec\u4e00\u65e0\u4e8c\u3002\u5728\"\u5ca9\u77f3\u5c71\u810a\"\u7ea7\u522b\u4e2d\uff0c\u4e0d\u6b63\u786e\u7684\u91cd\u91cf\u5206\u914d\u53ef\u80fd\u5bfc\u81f4\u7ffb\u8f66\u3002\u4e86\u89e3\u8fd9\u4e9b\u673a\u5236\u6709\u52a9\u4e8e\u73a9\u5bb6\u8c03\u6574\u81ea\u5df1\u7684\u9a7e\u9a76\u98ce\u683c\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u7269\u7406\u5f15\u64ce\u5c31\u50cf\u4e00\u4e2a\u865a\u62df\u5730\u5f62\u79d1\u5b66\u5bb6\uff0c\u8ba1\u7b97\u6bcf\u4e00\u5904\u98a0\u7c38\u548c\u6ed1\u52a8\u3002]"}, {"question": "\u54ea\u4e9bMX\u8d8a\u91ce\u5927\u5e08\u8f66\u8f86\u6700\u9002\u5408\u4e0d\u540c\u5730\u5f62\uff1f", "answer": "MX\u8d8a\u91ce\u5927\u5e08\u63d0\u4f9b\u5404\u79cd\u8f66\u8f86\uff0c\u6bcf\u8f86\u90fd\u9488\u5bf9\u7279\u5b9a\u5730\u5f62\u8fdb\u884c\u4e86\u4f18\u5316\u3002\u56db\u8f6e\u9a71\u52a8\u8d8a\u91ce\u8f66\u7531\u4e8e\u5176\u8f7b\u4fbf\u7075\u6d3b\uff0c\u975e\u5e38\u9002\u5408\u6ce5\u6cde\u548c\u68ee\u6797\u533a\u57df\u3002\u5bf9\u4e8e\u5ca9\u77f3\u5730\u5f62\uff0c\u56db\u9a71SUV\u63d0\u4f9b\u7a33\u5b9a\u6027\u548c\u52a8\u529b\u3002\u5728\"\u6c99\u6f20\u51b2\u523a\"\u7ea7\u522b\u4e2d\uff0c\u6c99\u4e18\u8d8a\u91ce\u8f66\u51ed\u501f\u5176\u5728\u6c99\u5730\u4e0a\u7684\u901f\u5ea6\u548c\u64cd\u63a7\u6027\u5728\u5176\u4ed6\u8f66\u8f86\u4e2d\u8131\u9896\u800c\u51fa\u3002\u5728\u8f66\u8f86\u9009\u62e9\u83dc\u5355\u4e2d\u5c1d\u8bd5\u4e0d\u540c\u7684\u8f66\u8f86\uff0c\u627e\u5230\u6700\u9002\u5408\u6bcf\u4e2a\u7ea7\u522b\u7684\u8f66\u8f86\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u56db\u8f6e\u9a71\u52a8\u8d8a\u91ce\u8f66 - \u6ce5\u5730 / \u56db\u9a71SUV - \u5ca9\u77f3\u5730 / \u6c99\u4e18\u8d8a\u91ce\u8f66 - \u6c99\u5730\u3002]"}, {"question": "\u5982\u4f55\u5728MX\u8d8a\u91ce\u5927\u5e08\u7684\u65f6\u95f4\u8bd5\u70bc\u6a21\u5f0f\u4e2d\u53d6\u5f97\u9ad8\u5206\uff1f", "answer": "\u8981\u5728\u65f6\u95f4\u8bd5\u70bc\u6a21\u5f0f\u4e2d\u83b7\u5f97\u9ad8\u5206\uff0c\u8bf7\u4e13\u6ce8\u4e8e\u7cbe\u786e\u6027\u548c\u901f\u5ea6\u4f18\u5316\u3002\u6b65\u9aa41\uff1a\u8bb0\u4f4f\u8d5b\u9053\u5e03\u5c40\uff0c\u4ee5\u4fbf\u9884\u6d4b\u8f6c\u5f2f\u548c\u969c\u788d\u3002\u6b65\u9aa42\uff1a\u5728\u76f4\u9053\u4e0a\u4f7f\u7528\u6c2e\u6c14\u63d0\u5347\u6765\u6700\u5927\u5316\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\"\u68ee\u6797\u51b2\u523a\"\u7ea7\u522b\u4e2d\uff0c\u5c06\u6c2e\u6c14\u63d0\u5347\u4fdd\u7559\u5230\u6700\u540e\u7684\u76f4\u9053\u3002\u6b65\u9aa43\uff1a\u901a\u8fc7\u66f2\u7ebf\u5e73\u7a33\u5730\u884c\u9a76\uff0c\u5c3d\u91cf\u51cf\u5c11\u5236\u52a8\u3002\u91cd\u590d\u7ec3\u4e60\u4ee5\u7f29\u77ed\u60a8\u7684\u65f6\u95f4\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u8bb0\u4f4f\u8d5b\u9053\u2192\u6218\u7565\u6027\u5730\u4f7f\u7528\u6c2e\u6c14\u63d0\u5347\u2192\u5e73\u7a33\u8f6c\u5f2f\u2192\u9ad8\u5206\u3002]"}, {"question": "MX\u8d8a\u91ce\u5927\u5e08\u5728PC\u548c\u79fb\u52a8\u8bbe\u5907\u4e0a\u7684\u7cfb\u7edf\u8981\u6c42\u662f\u4ec0\u4e48\uff1f", "answer": "MX\u8d8a\u91ce\u5927\u5e08\u5177\u6709\u7279\u5b9a\u7684\u7cfb\u7edf\u8981\u6c42\uff0c\u4ee5\u83b7\u5f97\u6700\u4f73\u6027\u80fd\u3002\u5728PC\u4e0a\uff0c\u5b83\u9700\u8981\u81f3\u5c11\u82f1\u7279\u5c14i5\u5904\u7406\u5668\u30018GB\u5185\u5b58\u548cNVIDIA GTX 1050\u4e4b\u7c7b\u7684\u4e13\u7528GPU\u3002\u5bf9\u4e8e\u79fb\u52a8\u8bbe\u5907\uff0c\u5b83\u652f\u6301Android 8.0\u4ee5\u4e0a\u548ciOS 12\u4ee5\u4e0a\uff0c\u4e14\u5185\u5b58\u81f3\u5c11\u4e3a2GB\u3002\u786e\u4fdd\u60a8\u7684\u8bbe\u5907\u7b26\u5408\u8fd9\u4e9b\u89c4\u683c\u4ee5\u4eab\u53d7\u6d41\u7545\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u4f8b\u5982\uff0c\u4f4e\u7aef\u8bbe\u5907\u5728\u56fe\u5f62\u5bc6\u96c6\u578b\u5173\u5361\uff08\u4f8b\u5982\"\u5c71\u5cf0\"\uff09\u4e2d\u53ef\u80fd\u4f1a\u51fa\u73b0\u5ef6\u8fdf\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1aPC - \u82f1\u7279\u5c14i5 / 8GB\u5185\u5b58 / NVIDIA GTX 1050 | \u79fb\u52a8\u8bbe\u5907 - Android 8.0\u4ee5\u4e0a / iOS 12\u4ee5\u4e0a / 2GB\u5185\u5b58\u3002]"}, {"question": "\u5982\u4f55\u5728MX\u8d8a\u91ce\u5927\u5e08\u4e4b\u95f4\u5728\u8bbe\u5907\u4e4b\u95f4\u8f6c\u79fb\u8fdb\u5ea6\uff1f", "answer": "\u8981\u5728MX\u8d8a\u91ce\u5927\u5e08\u4e4b\u95f4\u8f6c\u79fb\u8fdb\u5ea6\uff0c\u8bf7\u4f7f\u7528\u4e91\u4fdd\u5b58\u529f\u80fd\u3002\u6b65\u9aa41\uff1a\u767b\u5f55\u539f\u59cb\u8bbe\u5907\u4e0a\u7684\u5e10\u6237\u5e76\u542f\u7528\u8bbe\u7f6e\u83dc\u5355\u4e2d\u7684\u4e91\u4fdd\u5b58\u3002\u6b65\u9aa42\uff1a\u5728\u65b0\u8bbe\u5907\u4e0a\u5b89\u88c5\u6e38\u620f\u5e76\u4f7f\u7528\u76f8\u540c\u7684\u5e10\u6237\u767b\u5f55\u3002\u6b65\u9aa43\uff1a\u4ece\u4e91\u7aef\u540c\u6b65\u60a8\u7684\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u4ece\u79fb\u52a8\u8bbe\u5907\u5207\u6362\u5230PC\uff0c\u5219\u5df2\u89e3\u9501\u7684\u8f66\u8f86\u548c\u5173\u5361\u5c06\u968f\u4e4b\u8f6c\u79fb\u3002\u8fc7\u7a0b\u671f\u95f4\u8bf7\u786e\u4fdd\u7a33\u5b9a\u7684\u4e92\u8054\u7f51\u8fde\u63a5\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u4e91\u4fdd\u5b58\u5c31\u50cf\u4e00\u4e2a\u6570\u5b57\u80cc\u5305\uff0c\u65e0\u8bba\u60a8\u8d70\u5230\u54ea\u91cc\uff0c\u90fd\u643a\u5e26\u7740\u60a8\u7684\u8fdb\u5ea6\u3002]"}, {"question": "\u5728MX\u8d8a\u91ce\u5927\u5e08\u4e2d\uff0c\u53ef\u4ee5\u627e\u5230\u54ea\u4e9b\u9690\u85cf\u7684\u5f69\u86cb\uff1f", "answer": "MX\u8d8a\u91ce\u5927\u5e08\u4e2d\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u7684\u5f69\u86cb\uff0c\u4f9b\u73a9\u5bb6\u53d1\u73b0\u3002\u5728\"\u5e9f\u5f03\u77ff\u4e95\"\u7ea7\u522b\u4e2d\uff0c\u5728\u7011\u5e03\u540e\u9762\u7684\u72ed\u7a84\u8def\u5f84\u4e2d\u53ef\u4ee5\u627e\u5230\u4e00\u4e2a\u79d8\u5bc6\u6d1e\u7a74\u3002\u91cc\u9762\uff0c\u4f60\u4f1a\u53d1\u73b0\u4e00\u79cd\u7a00\u6709\u8f66\u8f86\u76ae\u80a4\u3002\u53e6\u4e00\u4e2a\u5f69\u86cb\u4f4d\u4e8e\"\u57ce\u5e02\u9003\u4ea1\"\u7ea7\u522b\uff0c\u5728\u7279\u5b9a\u7684\u5e7f\u544a\u724c\u9644\u8fd1\u9e23\u5587\u53ed\u4f1a\u89e6\u53d1\u72ec\u7279\u7684\u97f3\u6548\u3002\u63a2\u7d22\u504f\u50fb\u533a\u57df\u4ee5\u53d1\u73b0\u8fd9\u4e9b\u60ca\u559c\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5f69\u86cb\u5c31\u50cf\u57cb\u85cf\u7684\u5b9d\u85cf\uff0c\u5956\u52b1\u597d\u5947\u5fc3\u548c\u63a2\u7d22\u7cbe\u795e\u3002]"}, {"question": "\u5982\u4f55\u5728MX\u8d8a\u91ce\u5927\u5e08\u4e2d\u514b\u670d\u6700\u5177\u6311\u6218\u6027\u7684\u5173\u5361\uff1f", "answer": "\u8981\u5f81\u670d\u50cf\"\u706b\u5c71\u6500\u767b\"\u8fd9\u6837\u7684\u5177\u6709\u6311\u6218\u6027\u7684\u5173\u5361\uff0c\u8bf7\u91c7\u7528\u6218\u7565\u65b9\u6cd5\u3002\u6b65\u9aa41\uff1a\u5728\u7ec3\u4e60\u6a21\u5f0f\u4e2d\u7814\u7a76\u5173\u5361\u5e03\u5c40\uff0c\u4ee5\u8bc6\u522b\u68d8\u624b\u90e8\u5206\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u6700\u9002\u5408\u8be5\u5730\u5f62\u7684\u6700\u4f73\u8f6e\u80ce\u548c\u60ac\u6302\u6765\u5347\u7ea7\u60a8\u7684\u8f66\u8f86\u3002\u4f8b\u5982\uff0c\u5728\"\u706b\u5c71\u6500\u767b\"\u4e2d\u4f7f\u7528\u8010\u9ad8\u6e29\u8f6e\u80ce\u6765\u627f\u53d7\u7194\u5ca9\u533a\u57df\u3002\u6b65\u9aa43\uff1a\u4fdd\u6301\u8010\u5fc3\uff0c\u907f\u514d\u5306\u5fd9\uff1b\u7cbe\u786e\u6027\u81f3\u5173\u91cd\u8981\u3002\u91cd\u590d\u7ec3\u4e60\u4ee5\u638c\u63e1\u5173\u5361\u7684\u7ec6\u5fae\u4e4b\u5904\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u5306\u5fd9\u4f1a\u5bfc\u81f4\u9519\u8bef / \u8010\u5fc3\u4fdd\u8bc1\u6210\u529f\u3002]"}]
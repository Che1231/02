[{"question": "Dordle\uc758 \uac8c\uc784 \ud50c\ub808\uc774 \uba54\ucee4\ub2c8\uc998\uc774 \uc804\ud1b5\uc801\uc778 \ub2e8\uc5b4 \uac8c\uc784\uacfc \uc5b4\ub5bb\uac8c \ub2e4\ub978\uac00\uc694?", "answer": "Dordle\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \ub3d9\uc2dc\uc5d0 \ub450 \uac1c\uc758 \ub2e8\uc5b4 \ud37c\uc990\uc744 \ud480\uc5b4\uc57c \ud55c\ub2e4\ub294 \ub3c5\ud2b9\ud55c \uc694\uc18c\ub97c \ucd94\uac00\ud569\ub2c8\ub2e4. \uc804\ud1b5\uc801\uc778 \ub2e8\uc5b4 \uac8c\uc784\uacfc \ub2ec\ub9ac Dordle\uc5d0\uc11c\ub294 \ud55c \ubc88\uc5d0 \ud55c \uac1c\uc758 \ub2e8\uc5b4\uc5d0 \uc9d1\uc911\ud558\ub294 \ub300\uc2e0 \ub450 \uac1c\uc758 \ubcc4\ub3c4 \uadf8\ub9ac\ub4dc\ub97c \uad00\ub9ac\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud55c \ud37c\uc990\uc5d0 \ub300\ud574 'CRANE'\uc744 \ucd94\uce21\ud558\ub294 \ub3d9\uc548 \ub2e4\ub978 \ud37c\uc990\uc5d0 \ub300\ud574\uc11c\ub294 'PLANT'\ub97c \uace0\ub824\ud574\uc57c \ud560 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc774\uc911 \uc791\uc5c5 \uc811\uadfc \ubc29\uc2dd\uc740 \uc778\uc9c0 \ubd80\ud558\uc640 \uc804\ub7b5\uc801 \uacc4\ud68d\uc744 \uac15\ud654\ud558\uc5ec \ub2e4\uc911 \uc791\uc5c5\uc744 \uc990\uae30\ub294 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ub354\uc6b1 \ub9e4\ub825\uc801\uc73c\ub85c \ub9cc\ub4ed\ub2c8\ub2e4."}, {"question": "\ucd08\uc2ec\uc790\uac00 Dordle \uae30\uc220\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uae30 \uc704\ud574 \ucde8\ud574\uc57c \ud560 \uccab \ubc88\uc9f8 \uc138 \uac00\uc9c0 \ub2e8\uacc4\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "STEP1: \ud754\ud788 \uc0ac\uc6a9\ub418\ub294 5\uae00\uc790 \ub2e8\uc5b4\uc5d0 \uc775\uc219\ud574\uc9c0\uc138\uc694. \uc774 \uae30\ubcf8\uc801\uc778 \uc5b4\ud718\ub294 \uc219\ub828\ub41c \ucd94\uce21\uc744 \ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4. STEP2: \uae00\uc790 \ube48\ub3c4\uc640 \uc704\uce58\uc5d0 \uc8fc\uc758\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, 'E'\uc640 'A'\uc640 \uac19\uc740 \uae00\uc790\ub294 \uc885\uc885 \ud2b9\uc815 \uc790\ub9ac\uc5d0 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. STEP3: \ud55c \ubc88\uc5d0 \ud55c \uac1c\uc758 \ud37c\uc990\uc5d0 \uc9d1\uc911\ud558\ub294 \ub300\uc2e0 \ub450 \uac1c\uc758 \ud37c\uc990\uc744 \ub3d9\uc2dc\uc5d0 \ud478\ub294 \ubc29\ubc95\uc73c\ub85c \uc774\uc911 \uc791\uc5c5 \uad00\ub9ac \uc5f0\uc2b5\uc744 \ud558\uc138\uc694. \uc774 \uc811\uadfc \ubc29\uc2dd\uc740 \ud544\uc694\ud55c \ub2e4\uc911 \uc791\uc5c5 \uae30\uc220\uc744 \uac1c\ubc1c\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4."}, {"question": "\uae00\uc790 \ube48\ub3c4\ub97c \uc774\ud574\ud558\ub294 \uac83\uc774 Dordle\uc744 \ub9c8\uc2a4\ud130\ud558\ub294 \ub370 \uc65c \uc911\uc694\ud55c\uac00\uc694?", "answer": "\uae00\uc790 \ube48\ub3c4\ub97c \uc774\ud574\ud558\ub294 \uac83\uc740 \ub354 \uc798\ubabb\ub41c \ucd94\uce21\uc744 \ud560 \uc218 \uc788\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'E', 'A', 'R'\uacfc \uac19\uc740 \uae00\uc790\ub294 \uc601\uc5b4 \ub2e8\uc5b4\uc5d0\uc11c \ub354 \uc790\uc8fc \ub098\ud0c0\ub098\ubbc0\ub85c \uc774\ub7ec\ud55c \uae00\uc790\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \uace0\ub824\ud558\uba74 \uc131\uacf5 \uac00\ub2a5\uc131\uc774 \ub192\uc544\uc9d1\ub2c8\ub2e4. Dordle\uc5d0\uc11c\ub294 \ub450 \uac1c\uc758 \ud37c\uc990\uc744 \uad00\ub9ac\ud574\uc57c \ud558\ubbc0\ub85c \uc774\ub7ec\ud55c \uc9c0\uc2dd\uc740 \ub450 \uadf8\ub9ac\ub4dc \ubaa8\ub450\uc5d0\uc11c \ucd94\uce21\uc744 \ucd5c\uc801\ud654\ud558\uc5ec \uadc0\uc911\ud55c \uc2dc\ub3c4\ub97c \uc808\uc57d\ud558\uace0 \uc804\ubc18\uc801\uc778 \ud6a8\uc728\uc131\uc744 \ub192\uc774\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 Dordle\uc5d0\uc11c \ub6f0\uc5b4\ub098\uae30 \uc704\ud574 \ud328\ud134 \uc778\uc2dd\uc744 \uc5b4\ub5bb\uac8c \ud65c\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \uc77c\ubc18\uc801\uc778 \ub2e8\uc5b4 \uad6c\uc870\uc640 \uae00\uc790 \uc870\ud569\uc744 \uc2dd\ubcc4\ud568\uc73c\ub85c\uc368 \ud328\ud134 \uc778\uc2dd\uc744 \ud65c\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 \ub9ce\uc740 \ub2e8\uc5b4\uac00 'ING'\ub85c \ub05d\ub098\uac70\ub098 'TH'\ub85c \uc2dc\uc791\ud55c\ub2e4\ub294 \uac83\uc744 \uc778\uc2dd\ud558\uba74 \uac00\ub2a5\uc131\uc744 \ud06c\uac8c \uc881\ud790 \uc218 \uc788\uc2b5\ub2c8\ub2e4. Dordle\uc5d0\uc11c \uc774\ub97c \ub450 \uac1c\uc758 \ud37c\uc990 \ubaa8\ub450\uc5d0 \uc801\uc6a9\ud558\uba74 \ub354 \uc804\ub7b5\uc801\uc778 \ucd94\uce21\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\ub294 \uc774\ub7ec\ud55c \ud328\ud134\uc744 \ub9e4\ud551\ud568\uc73c\ub85c\uc368 \ud544\uc694\ud55c \uc2dc\ub3c4 \uc218\ub97c \uc904\uc774\uace0 \uc131\uacf5\ub960\uc744 \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Dordle\uc744 \ud50c\ub808\uc774\ud560 \ub54c \uc778\uc9c0 \ubd80\ud558\ub97c \uad00\ub9ac\ud558\uae30 \uc704\ud574 \ud50c\ub808\uc774\uc5b4\uac00 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc778\uc9c0 \ubd80\ud558\ub97c \uad00\ub9ac\ud558\ub824\uba74 \ud50c\ub808\uc774\uc5b4\ub294 \uccb4\uacc4\uc801\uc778 \uc811\uadfc \ubc29\uc2dd\uc744 \ucc44\ud0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \uac01 \ud37c\uc990\uc5d0 \ud2b9\uc815 \uc2dc\ub3c4\ub97c \ubc88\uac08\uc544 \ud560\ub2f9\ud569\ub2c8\ub2e4. STEP2: \uac01 \uadf8\ub9ac\ub4dc\uc758 \uac00\ub2a5\ud55c \ub2e8\uc5b4\ub97c \ucd94\uc801\ud558\uae30 \uc704\ud574 \uc815\uc2e0\uc801 \ub610\ub294 \ubb3c\ub9ac\uc801 \uba54\ubaa8\ub97c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. STEP3: \ub2e4\ub978 \ud37c\uc990\ub85c \uc804\ud658\ud558\uae30 \uc804\uc5d0 \ud55c \ud37c\uc990\uc744 \ubd80\ubd84\uc801\uc73c\ub85c \ud480\uace0 \uc9d1\uc911\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ub2e8\uacc4\uc801 \ubc29\ubc95\uc740 \uc815\uc2e0 \ud53c\ub85c\ub97c \uc904\uc774\uace0 \uc9d1\uc911\ub825\uc744 \ud5a5\uc0c1\uc2dc\ucf1c Dordle\uc758 \uc774\uc911 \uc791\uc5c5 \ud2b9\uc131\uc744 \ub354 \uc27d\uac8c \ucc98\ub9ac\ud560 \uc218 \uc788\uac8c \ud569\ub2c8\ub2e4."}, {"question": "Dordle\uc5d0\uc11c \uac8c\uc784 \ud50c\ub808\uc774 \uc7ac\ubbf8\ub97c \ub192\uc774\ub294 \uac8c\uc784 \ub0b4 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Dordle\uc758 \uc7ac\ubbf8\ub294 \uc774\uc911 \ud37c\uc990 \uba54\ucee4\ub2c8\uc998\uacfc \uc77c\uc77c \ucc4c\ub9b0\uc9c0 \ubaa8\ub4dc\uc5d0 \uc758\ud574 \uc8fc\ub3c4\ub429\ub2c8\ub2e4. \ub3d9\uc2dc\uc5d0 \ub450 \uac1c\uc758 \ud37c\uc990\uc744 \ud480\uc5b4\uc57c \ud558\ub294 \uc694\uad6c \uc0ac\ud56d\uc740 \uac01 \uac8c\uc784 \uc138\uc158\uc774 \uace0\uc720\ud558\ub3c4\ub85d \ud569\ub2c8\ub2e4. \ub610\ud55c \uc77c\uc77c \ucc4c\ub9b0\uc9c0\ub294 \ub9e4\uc77c \uc0c8\ub85c\uc6b4 \ub2e8\uc5b4 \uc138\ud2b8\ub97c \uc81c\uacf5\ud558\uc5ec \ud50c\ub808\uc774\uc5b4\uac00 \uc815\uae30\uc801\uc73c\ub85c \ub3cc\uc544\uc624\ub3c4\ub85d \uc7a5\ub824\ud569\ub2c8\ub2e4. \uc774 \uac8c\uc784\uc758 \ub514\uc790\uc778\uc5d0\ub294 \ub610\ud55c \uce90\uc8fc\uc5bc \ud50c\ub808\uc774\uc5b4\uc640 \ub354 \uac15\ub82c\ud55c \ub3c4\uc804\uc744 \ucd94\uad6c\ud558\ub294 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub450\ub97c \uc704\ud55c \ub2e4\uc591\ud55c \ub09c\uc774\ub3c4\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Dordle\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \uc5b4\ub5a4 \uc694\uc778\uc774 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "Dordle\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ub450 \uac1c\uc758 \ud37c\uc990\uc744 \ud478\ub294 \ub370 \uc0ac\uc6a9\ub41c \uc2dc\ub3c4 \ud69f\uc218\ub97c \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. \uac01 \uc2dc\ub3c4\ub294 \uc810\uc218\ub97c \uc904\uc774\ubbc0\ub85c \ud6a8\uc728\uc131\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc810\uc218\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc694\uc778\uc5d0\ub294 \ucd94\uce21 \uc18d\ub3c4\uc640 \ub2e8\uc5b4 \uc120\ud0dd\uc758 \uc815\ud655\uc131\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub354 \uc801\uc740 \uc2dc\ub3c4\ub85c \ub450 \uac1c\uc758 \ud37c\uc990 \ubaa8\ub450\ub97c \ud478\ub294 \uac83\uc740 \ub354 \ub192\uc740 \uc810\uc218\ub97c \uc758\ubbf8\ud569\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \uc18d\ub3c4\uc640 \uc815\ud655\uc131\uc744 \uade0\ud615 \uc788\uac8c \uc720\uc9c0\ud560 \uc218 \uc788\ub294 \ud50c\ub808\uc774\uc5b4\ub97c \ubcf4\uc0c1\ud558\uc5ec \uac8c\uc784\uc5d0 \uacbd\uc7c1\uc801\uc778 \uc694\uc18c\ub97c \ucd94\uac00\ud569\ub2c8\ub2e4."}, {"question": "\ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c Dordle\uc744 \ud50c\ub808\uc774\ud558\uae30 \uc704\ud55c \uae30\uc220\uc801 \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Dordle\uc740 \ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uac00\ubccd\uace0 \uc811\uadfc\ud558\uae30 \uc26c\uc6b4 \uac8c\uc784\uc73c\ub85c \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ucd5c\uc18c\ud55c\uc758 \ud558\ub4dc\uc6e8\uc5b4 \uc0ac\uc591\uc774 \ud544\uc694\ud558\ubbc0\ub85c \ub300\ubd80\ubd84\uc758 \uae30\uae30\ub97c \uc9c0\uc6d0\ud569\ub2c8\ub2e4. \uc6f9 \ube0c\ub77c\uc6b0\uc800\uc758 \uacbd\uc6b0 \ucd5c\uc2e0 \ubc84\uc804\uc758 Chrome, Firefox \ubc0f Safari\ub97c \uc9c0\uc6d0\ud569\ub2c8\ub2e4. \ubaa8\ubc14\uc77c \uae30\uae30\uc758 \uacbd\uc6b0 \uc548\uc815\uc801\uc778 \uc778\ud130\ub137 \uc5f0\uacb0\ub85c iOS \ubc0f Android\uc5d0\uc11c \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ub429\ub2c8\ub2e4. \uc774 \uac8c\uc784\uc758 \ub2e8\uc21c\uc131\uc740 \uace0\uae09 \ud558\ub4dc\uc6e8\uc5b4\uac00 \ud544\uc694\ud558\uc9c0 \uc54a\uace0 \uc990\uae38 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4."}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 \uc7a5\uce58\ub97c \uc804\ud658\ud560 \ub54c Dordle\uc5d0\uc11c\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc800\uc7a5\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc9c4\ud589 \uc0c1\ud669\uc744 \uc800\uc7a5\ud558\ub824\uba74 \ud50c\ub808\uc774\uc5b4\uac00 \uc7a5\uce58 \uac04\uc5d0 \uc77c\uad00\ub41c \uacc4\uc815 \ub610\ub294 \ub85c\uadf8\uc778 \ubc29\ubc95\uc744 \uc0ac\uc6a9\ud574\uc57c \ud569\ub2c8\ub2e4. Dordle\uc740 Google Play \ub610\ub294 Apple Game Center\uc640 \uac19\uc740 \ud50c\ub7ab\ud3fc\uc744 \ud1b5\ud574 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \uc9c0\uc6d0\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud734\ub300\ud3f0\uacfc \ud0dc\ube14\ub9bf\uc5d0\uc11c \ub3d9\uc77c\ud55c Google \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uba74 \uc9c4\ud589 \uc0c1\ud669\uc774 \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. \uc774 \uae30\ub2a5\uc740 \uc7a5\uce58\ub97c \uc790\uc8fc \uc804\ud658\ud558\ub294 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ud2b9\ud788 \uc720\uc6a9\ud558\uba70, \uc774\ub7ec\ud55c \ud50c\ub808\uc774\uc5b4\uc758 \uc5c5\uc801\uacfc \uc77c\uc77c \ucc4c\ub9b0\uc9c0\ub294 \ud56d\uc0c1 \ucd5c\uc2e0 \uc0c1\ud0dc\ub97c \uc720\uc9c0\ud569\ub2c8\ub2e4."}, {"question": "\ud50c\ub808\uc774\uc5b4\uac00 Dordle\uc5d0\uc11c \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Dordle\uc5d0\ub294 \uac8c\uc784 \ud658\uacbd\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc8fc\ubaa9\ud560 \ub9cc\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8 \uc911 \ud558\ub098\ub294 \ud2b9\uc815 \uc774\uc815\ud45c\ub97c \ub2ec\uc131\ud558\uc5ec \ud2b9\ubcc4\ud55c \ud14c\ub9c8\ub97c \ud574\uc81c\ud560 \uc218 \uc788\ub294 \uae30\ub2a5\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5f0\uc18d\uc73c\ub85c \ud2b9\uc815 \uc218\uc758 \ud37c\uc990\uc744 \ud480\uba74 \ub3c5\ud2b9\ud55c \uc0c9\uc0c1 \uad6c\uc131\ud45c \ub610\ub294 \ubc30\uacbd\uc744 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uc694\uc18c\ub294 \uc804\ub150\ud558\ub294 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ucd94\uac00\uc801\uc778 \ub3d9\uae30 \ubd80\uc5ec\uc640 \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud558\uc5ec \uc9c0\uc18d\uc801\uc778 \ucc38\uc5ec\ub97c \uc7a5\ub824\ud569\ub2c8\ub2e4."}]
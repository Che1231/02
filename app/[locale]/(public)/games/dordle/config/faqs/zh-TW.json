[{"question": "Dordle \u7684\u904a\u6232\u6a5f\u5236\u8207\u50b3\u7d71\u6587\u5b57\u904a\u6232\u6709\u4f55\u4e0d\u540c\uff1f", "answer": "Dordle \u7368\u7279\u4e4b\u8655\u5728\u65bc\u8981\u6c42\u73a9\u5bb6\u540c\u6642\u89e3\u5169\u500b\u6587\u5b57\u8b0e\u984c\u3002\u8207\u50b3\u7d71\u6587\u5b57\u904a\u6232\u4e00\u6b21\u53ea\u5c08\u6ce8\u65bc\u4e00\u500b\u55ae\u5b57\u4e0d\u540c\uff0cDordle \u6311\u6230\u73a9\u5bb6\u540c\u6642\u7ba1\u7406\u5169\u500b\u4e0d\u540c\u7684\u683c\u7dda\u3002\u4f8b\u5982\uff0c\u5728\u731c\u6e2c\u4e00\u500b\u8b0e\u984c\u7684\u300cCRANE\u300d\u6642\uff0c\u4f60\u4e5f\u8a31\u9084\u9700\u8981\u8003\u616e\u53e6\u4e00\u500b\u8b0e\u984c\u7684\u300cPLANT\u300d\u3002\u9019\u7a2e\u96d9\u4efb\u52d9\u7684\u8a2d\u8a08\u589e\u5f37\u4e86\u8a8d\u77e5\u8ca0\u64d4\u548c\u7b56\u7565\u898f\u5283\uff0c\u8b93\u559c\u6b61\u591a\u5de5\u7684\u73a9\u5bb6\u66f4\u6295\u5165\u3002"}, {"question": "\u521d\u5b78\u8005\u8981\u5982\u4f55\u63d0\u5347 Dordle \u7684\u6280\u80fd\uff0c\u524d\u4e09\u6b65\u9a5f\u70ba\u4f55\uff1f", "answer": "\u6b65\u9a5f\u4e00\uff1a\u5148\u719f\u6089\u5e38\u898b\u7684\u4e94\u500b\u5b57\u6bcd\u55ae\u5b57\u3002\u9019\u9805\u57fa\u790e\u8a5e\u5f59\u5c07\u6709\u52a9\u65bc\u4f60\u505a\u51fa\u5408\u7406\u7684\u731c\u6e2c\u3002\u6b65\u9a5f\u4e8c\uff1a\u6ce8\u610f\u5b57\u6bcd\u7684\u983b\u7387\u548c\u4f4d\u7f6e\u3002\u4f8b\u5982\uff0c\u300cE\u300d\u548c\u300cA\u300d\u7b49\u5b57\u6bcd\u7d93\u5e38\u51fa\u73fe\u5728\u7279\u5b9a\u7684\u4f4d\u7f6e\u3002\u6b65\u9a5f\u4e09\uff1a\u7df4\u7fd2\u540c\u6642\u8655\u7406\u5169\u500b\u8b0e\u984c\uff0c\u800c\u4e0d\u662f\u4e00\u6b21\u53ea\u5c08\u6ce8\u65bc\u4e00\u500b\u3002\u9019\u7a2e\u65b9\u6cd5\u5c07\u6709\u52a9\u65bc\u4f60\u767c\u5c55\u5fc5\u8981\u7684\u540c\u6642\u8655\u7406\u591a\u9805\u4efb\u52d9\u7684\u80fd\u529b\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u4e86\u89e3\u5b57\u6bcd\u983b\u7387\u5c0d\u65bc\u7cbe\u901a Dordle \u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u4e86\u89e3\u5b57\u6bcd\u983b\u7387\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u80fd\u8b93\u4f60\u505a\u51fa\u66f4\u660e\u667a\u7684\u731c\u6e2c\u3002\u4f8b\u5982\uff0c\u300cE\u300d\u3001\u300cA\u300d\u548c\u300cR\u300d\u7b49\u5b57\u6bcd\u5728\u82f1\u6587\u55ae\u5b57\u4e2d\u51fa\u73fe\u983b\u7387\u8f03\u9ad8\uff0c\u56e0\u6b64\u512a\u5148\u8003\u616e\u9019\u4e9b\u5b57\u6bcd\u53ef\u4ee5\u589e\u52a0\u4f60\u7684\u6210\u529f\u6a5f\u7387\u3002\u5728 Dordle \u4e2d\uff0c\u7531\u65bc\u4f60\u8981\u540c\u6642\u8655\u7406\u5169\u500b\u8b0e\u984c\uff0c\u9019\u9805\u77e5\u8b58\u6709\u52a9\u65bc\u4f60\u5728\u5169\u500b\u683c\u7dda\u4e0a\u512a\u5316\u4f60\u7684\u731c\u6e2c\uff0c\u7bc0\u7701\u5bf6\u8cb4\u7684\u5617\u8a66\u6b21\u6578\uff0c\u4e26\u63d0\u5347\u6574\u9ad4\u6548\u7387\u3002"}, {"question": "\u9032\u968e\u73a9\u5bb6\u5982\u4f55\u5229\u7528\u6a21\u5f0f\u8b58\u5225\u4f86\u5728 Dordle \u4e2d\u812b\u7a4e\u800c\u51fa\uff1f", "answer": "\u9032\u968e\u73a9\u5bb6\u53ef\u4ee5\u85c9\u7531\u8b58\u5225\u5e38\u898b\u7684\u55ae\u5b57\u7d50\u69cb\u548c\u5b57\u6bcd\u7d44\u5408\u4f86\u904b\u7528\u6a21\u5f0f\u8b58\u5225\u3002\u4f8b\u5982\uff0c\u8fa8\u8b58\u8a31\u591a\u55ae\u5b57\u4ee5\u300cING\u300d\u7d50\u5c3e\u6216\u4ee5\u300cTH\u300d\u958b\u982d\uff0c\u53ef\u4ee5\u5927\u5e45\u7e2e\u5c0f\u53ef\u80fd\u6027\u3002\u5728 Dordle \u4e2d\uff0c\u5728\u5169\u500b\u8b0e\u984c\u4e0a\u61c9\u7528\u6b64\u65b9\u6cd5\u5141\u8a31\u66f4\u7b56\u7565\u6027\u7684\u731c\u6e2c\u3002\u900f\u904e\u7e6a\u88fd\u9019\u4e9b\u6a21\u5f0f\uff0c\u73a9\u5bb6\u53ef\u4ee5\u6e1b\u5c11\u6240\u9700\u7684\u5617\u8a66\u6b21\u6578\u4e26\u63d0\u9ad8\u6210\u529f\u7387\u3002"}, {"question": "\u73a9\u5bb6\u5728\u73a9 Dordle \u6642\uff0c\u5982\u4f55\u7ba1\u7406\u8a8d\u77e5\u8ca0\u64d4\uff1f", "answer": "\u70ba\u4e86\u7ba1\u7406\u8a8d\u77e5\u8ca0\u64d4\uff0c\u73a9\u5bb6\u53ef\u4ee5\u63a1\u7528\u7cfb\u7d71\u5316\u7684\u65b9\u5f0f\uff1a\u6b65\u9a5f\u4e00\uff1a\u8f2a\u6d41\u5206\u914d\u7279\u5b9a\u5617\u8a66\u6b21\u6578\u7d66\u6bcf\u500b\u8b0e\u984c\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u5fc3\u7406\u6216\u7269\u7406\u7b46\u8a18\u4f86\u8ffd\u8e64\u6bcf\u500b\u683c\u7dda\u7684\u53ef\u80fd\u55ae\u5b57\u3002\u6b65\u9a5f\u4e09\uff1a\u5c08\u6ce8\u65bc\u90e8\u5206\u89e3\u6c7a\u4e00\u500b\u8b0e\u984c\uff0c\u7136\u5f8c\u518d\u5207\u63db\u5230\u53e6\u4e00\u500b\u3002\u9019\u7a2e\u5206\u968e\u6bb5\u7684\u65b9\u6cd5\u6e1b\u5c11\u4e86\u7cbe\u795e\u75b2\u52de\uff0c\u4e26\u63d0\u9ad8\u5c08\u6ce8\u529b\uff0c\u4f7f\u5176\u66f4\u5bb9\u6613\u8655\u7406 Dordle \u7684\u96d9\u4efb\u52d9\u6027\u8cea\u3002"}, {"question": "Dordle \u4e2d\u54ea\u4e9b\u904a\u6232\u6a5f\u5236\u6709\u52a9\u65bc\u5176\u91cd\u73a9\u6027\uff1f", "answer": "Dordle \u7684\u91cd\u73a9\u6027\u662f\u7531\u5176\u96d9\u8b0e\u984c\u6a5f\u5236\u548c\u6bcf\u65e5\u6311\u6230\u6a21\u5f0f\u9a45\u52d5\u3002\u9700\u8981\u540c\u6642\u89e3\u5169\u500b\u8b0e\u984c\u7684\u6a5f\u5236\u78ba\u4fdd\u6bcf\u6b21\u904a\u6232\u90fd\u80fd\u7368\u4e00\u7121\u4e8c\u3002\u6b64\u5916\uff0c\u6bcf\u65e5\u6311\u6230\u6bcf\u5929\u63d0\u4f9b\u4e00\u7d44\u65b0\u7684\u55ae\u5b57\uff0c\u9f13\u52f5\u73a9\u5bb6\u5b9a\u671f\u56de\u8a2a\u3002\u904a\u6232\u8a2d\u8a08\u4e5f\u5305\u62ec\u4e0d\u540c\u7684\u96e3\u5ea6\u7b49\u7d1a\uff0c\u4ee5\u6eff\u8db3\u4f11\u9592\u73a9\u5bb6\u548c\u5c0b\u627e\u66f4\u523a\u6fc0\u6311\u6230\u7684\u73a9\u5bb6\u7684\u9700\u6c42\u3002"}, {"question": "Dordle \u7684\u8a08\u5206\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff0c\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u5b83\uff1f", "answer": "Dordle \u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u89e3\u958b\u5169\u500b\u8b0e\u984c\u6240\u9700\u7684\u5617\u8a66\u6b21\u6578\u3002\u6bcf\u6b21\u5617\u8a66\u90fd\u6703\u964d\u4f4e\u4f60\u7684\u5206\u6578\uff0c\u56e0\u6b64\u6548\u7387\u81f3\u95dc\u91cd\u8981\u3002\u5f71\u97ff\u5206\u6578\u7684\u56e0\u7d20\u5305\u62ec\u4f60\u731c\u6e2c\u7684\u901f\u5ea6\u548c\u55ae\u5b57\u9078\u64c7\u7684\u6e96\u78ba\u6027\u3002\u4f8b\u5982\uff0c\u5728\u8f03\u5c11\u7684\u5617\u8a66\u6b21\u6578\u4e2d\u89e3\u958b\u5169\u500b\u8b0e\u984c\u5c07\u6703\u7372\u5f97\u8f03\u9ad8\u5206\u6578\u3002\u8a72\u7cfb\u7d71\u734e\u52f5\u90a3\u4e9b\u80fd\u5920\u5e73\u8861\u901f\u5ea6\u548c\u7cbe\u78ba\u5ea6\u7684\u73a9\u5bb6\uff0c\u70ba\u904a\u6232\u589e\u6dfb\u7af6\u722d\u512a\u52e2\u3002"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u73a9 Dordle \u9700\u8981\u54ea\u4e9b\u6280\u8853\u8981\u6c42\uff1f", "answer": "Dordle \u7684\u8a2d\u8a08\u8f15\u5de7\u4e14\u53ef\u5728\u591a\u500b\u5e73\u53f0\u4e0a\u4f7f\u7528\u3002\u5b83\u9700\u8981\u6700\u5c11\u7684\u786c\u9ad4\u898f\u683c\uff0c\u4f7f\u5176\u8207\u5927\u591a\u6578\u88dd\u7f6e\u76f8\u5bb9\u3002\u5c0d\u65bc\u7db2\u9801\u700f\u89bd\u5668\uff0c\u5b83\u652f\u63f4\u6700\u65b0\u7248\u672c\u7684 Chrome\u3001Firefox \u548c Safari\u3002\u5728\u884c\u52d5\u88dd\u7f6e\u4e0a\uff0c\u5b83\u5728\u7a69\u5b9a\u7684\u7db2\u8def\u9023\u7dda\u4e0b\u53ef\u5728 iOS \u548c Android \u4e0a\u9806\u5229\u904b\u884c\u3002\u904a\u6232\u7684\u7c21\u55ae\u6027\u78ba\u4fdd\u4e86\u73a9\u5bb6\u53ef\u4ee5\u5728\u6c92\u6709\u9ad8\u7aef\u786c\u9ad4\u7684\u60c5\u6cc1\u4e0b\u4eab\u53d7\u904a\u6232\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u4e0d\u540c\u88dd\u7f6e\u9593\u78ba\u4fdd Dordle \u9032\u5ea6\u5f97\u4ee5\u5132\u5b58\uff1f", "answer": "\u70ba\u4e86\u78ba\u4fdd\u9032\u5ea6\u5132\u5b58 \uff0c\u73a9\u5bb6\u61c9\u8a72\u5728\u4e0d\u540c\u88dd\u7f6e\u4e0a\u4f7f\u7528\u4e00\u81f4\u7684\u5e33\u6236\u6216\u767b\u5165\u65b9\u6cd5\u3002Dordle \u652f\u63f4\u900f\u904e Google Play \u6216 Apple Game Center \u7b49\u5e73\u53f0\u9032\u884c\u96f2\u7aef\u5132\u5b58\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u540c\u4e00\u500b Google \u5e33\u6236\u5728\u4f60\u7684\u624b\u6a5f\u548c\u5e73\u677f\u96fb\u8166\u4e0a\u767b\u5165\u5c07\u6703\u540c\u6b65\u4f60\u7684\u9032\u5ea6\u3002\u6b64\u529f\u80fd\u5c0d\u65bc\u7d93\u5e38\u5728\u4e0d\u540c\u88dd\u7f6e\u9593\u5207\u63db\u7684\u73a9\u5bb6\u4f86\u8aaa\u7279\u5225\u6709\u7528\uff0c\u78ba\u4fdd\u4ed6\u5011\u7684\u6210\u5c31\u548c\u6bcf\u65e5\u6311\u6230\u59cb\u7d42\u4fdd\u6301\u6700\u65b0\u3002"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728 Dordle \u4e2d\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "Dordle \u5305\u62ec\u4e00\u4e9b\u96b1\u85cf\u529f\u80fd\uff0c\u4ee5\u589e\u5f37\u904a\u6232\u9ad4\u9a57\u3002\u4e00\u500b\u986f\u8457\u7684\u5f69\u86cb\u662f\u53ef\u4ee5\u900f\u904e\u9054\u6210\u7279\u5b9a\u91cc\u7a0b\u7891\u4f86\u89e3\u9396\u7279\u6b8a\u4e3b\u984c\uff0c\u4f8b\u5982\u9023\u7e8c\u89e3\u958b\u4e00\u5b9a\u6578\u91cf\u7684\u8b0e\u984c\u3002\u4f8b\u5982\uff0c\u5728\u6c92\u6709\u55ae\u4e00\u5931\u6557\u7684\u60c5\u6cc1\u4e0b\u5b8c\u6210 50 \u500b\u8b0e\u984c\u53ef\u80fd\u6703\u89e3\u9396\u7368\u7279\u7684\u914d\u8272\u6216\u80cc\u666f\u3002\u9019\u4e9b\u96b1\u85cf\u5143\u7d20\u70ba\u5c08\u6ce8\u73a9\u5bb6\u589e\u6dfb\u984d\u5916\u7684\u52d5\u6a5f\u548c\u56de\u994b\uff0c\u9f13\u52f5\u6301\u7e8c\u53c3\u8207\u3002"}]
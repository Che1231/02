[{"question": "Dordle\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u304a\u3044\u3066\u3001\u5f93\u6765\u306e\u5358\u8a9e\u30b2\u30fc\u30e0\u3068\u3069\u306e\u3088\u3046\u306b\u7570\u306a\u308b\u306e\u3067\u3059\u304b\uff1f", "answer": "Dordle\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u540c\u6642\u306b2\u3064\u306e\u5358\u8a9e\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u5fc5\u8981\u304c\u3042\u308b\u3068\u3044\u3046\u72ec\u7279\u306e\u8981\u7d20\u3092\u52a0\u3048\u3066\u3044\u307e\u3059\u3002\u5f93\u6765\u306e\u5358\u8a9e\u30b2\u30fc\u30e0\u3067\u306f\u4e00\u5ea6\u306b1\u3064\u306e\u5358\u8a9e\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u304c\u3001Dordle\u3067\u306f2\u3064\u306e\u5225\u3005\u306e\u30b0\u30ea\u30c3\u30c9\u3092\u7ba1\u7406\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u3042\u308b\u30d1\u30ba\u30eb\u3067\u300cCRANE\u300d\u3092\u63a8\u6e2c\u3057\u3066\u3044\u308b\u5834\u5408\u3001\u3082\u3046\u4e00\u65b9\u306e\u30d1\u30ba\u30eb\u3067\u306f\u300cPLANT\u300d\u3082\u8003\u616e\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u3053\u306e\u30c7\u30e5\u30a2\u30eb\u30bf\u30b9\u30af\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u3001\u30de\u30eb\u30c1\u30bf\u30b9\u30af\u3092\u697d\u3057\u3080\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u3001\u8a8d\u77e5\u8ca0\u8377\u3068\u6226\u7565\u7684\u8a08\u753b\u3092\u5f37\u5316\u3057\u3001\u3088\u308a\u9b45\u529b\u7684\u306a\u3082\u306e\u306b\u3057\u307e\u3059\u3002"}, {"question": "Dordle\u306e\u30b9\u30ad\u30eb\u3092\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u306b\u3001\u521d\u5fc3\u8005\u3068\u3057\u3066\u6700\u521d\u306b\u5b9f\u884c\u3059\u308b\u3079\u304d\u6700\u521d\u306e3\u3064\u306e\u30b9\u30c6\u30c3\u30d7\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30c6\u30c3\u30d71\uff1a\u4e00\u822c\u7684\u306a5\u6587\u5b57\u306e\u5358\u8a9e\u306b\u6163\u308c\u308b\u3053\u3068\u304b\u3089\u59cb\u3081\u307e\u3059\u3002\u3053\u306e\u57fa\u672c\u7684\u306a\u8a9e\u5f59\u306f\u3001\u9069\u5207\u306a\u63a8\u6e2c\u3092\u884c\u3046\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6587\u5b57\u306e\u983b\u5ea6\u3068\u4f4d\u7f6e\u306b\u6ce8\u610f\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300cE\u300d\u3084\u300cA\u300d\u306a\u3069\u306e\u6587\u5b57\u306f\u3001\u7279\u5b9a\u306e\u5834\u6240\u306b\u983b\u7e41\u306b\u767b\u5834\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u4e00\u5ea6\u306b1\u3064\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u4e21\u65b9\u306e\u30d1\u30ba\u30eb\u3092\u540c\u6642\u306b\u89e3\u304f\u3053\u3068\u3067\u3001\u30c7\u30e5\u30a2\u30eb\u30bf\u30b9\u30af\u306e\u7ba1\u7406\u3092\u5b9f\u8df5\u3057\u307e\u3059\u3002\u3053\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u306b\u3088\u308a\u3001\u5fc5\u8981\u306a\u30de\u30eb\u30c1\u30bf\u30b9\u30af\u30b9\u30ad\u30eb\u3092\u958b\u767a\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u306a\u305cDordle\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u305f\u3081\u306b\u3001\u6587\u5b57\u306e\u983b\u5ea6\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u3067\u3057\u3087\u3046\u304b\uff1f", "answer": "\u6587\u5b57\u306e\u983b\u5ea6\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u91cd\u8981\u3067\u3059\u3002\u306a\u305c\u306a\u3089\u3001\u3088\u308a\u60c5\u5831\u306b\u57fa\u3065\u3044\u305f\u63a8\u6e2c\u3092\u884c\u3046\u3053\u3068\u304c\u3067\u304d\u308b\u304b\u3089\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300cE\u300d\u3001\u300cA\u300d\u3001\u300cR\u300d\u306a\u3069\u306e\u6587\u5b57\u306f\u82f1\u8a9e\u306e\u5358\u8a9e\u3067\u983b\u7e41\u306b\u767b\u5834\u3059\u308b\u305f\u3081\u3001\u3053\u308c\u3089\u3092\u512a\u5148\u3059\u308b\u3053\u3068\u306f\u3001\u6210\u529f\u3059\u308b\u53ef\u80fd\u6027\u3092\u9ad8\u3081\u307e\u3059\u3002Dordle\u3067\u306f\u30012\u3064\u306e\u30d1\u30ba\u30eb\u3092\u7ba1\u7406\u3057\u3066\u3044\u308b\u305f\u3081\u3001\u3053\u306e\u77e5\u8b58\u306f\u3001\u4e21\u65b9\u306e\u30b0\u30ea\u30c3\u30c9\u5168\u4f53\u3067\u63a8\u6e2c\u3092\u6700\u9069\u5316\u3057\u3001\u8cb4\u91cd\u306a\u8a66\u884c\u3092\u7bc0\u7d04\u3057\u3001\u5168\u4f53\u7684\u306a\u52b9\u7387\u3092\u5411\u4e0a\u3055\u305b\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001Dordle\u3067\u512a\u4f4d\u306b\u7acb\u3064\u305f\u3081\u306b\u3001\u30d1\u30bf\u30fc\u30f3\u8a8d\u8b58\u3092\u3069\u306e\u3088\u3046\u306b\u6d3b\u7528\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u4e00\u822c\u7684\u306a\u5358\u8a9e\u69cb\u9020\u3068\u6587\u5b57\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u7279\u5b9a\u3059\u308b\u3053\u3068\u3067\u3001\u30d1\u30bf\u30fc\u30f3\u8a8d\u8b58\u3092\u6d3b\u7528\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300cING\u300d\u3067\u7d42\u308f\u308b\u5358\u8a9e\u3084\u300cTH\u300d\u3067\u59cb\u307e\u308b\u5358\u8a9e\u306f\u3001\u53ef\u80fd\u6027\u3092\u5927\u5e45\u306b\u7d5e\u308a\u8fbc\u3080\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002Dordle\u3067\u306f\u3001\u4e21\u65b9\u306e\u30d1\u30ba\u30eb\u306b\u308f\u305f\u3063\u3066\u3053\u308c\u3092\u9069\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u6226\u7565\u7684\u306a\u63a8\u6e2c\u304c\u53ef\u80fd\u306b\u306a\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u30de\u30c3\u30d4\u30f3\u30b0\u3059\u308b\u3053\u3068\u3067\u3001\u5fc5\u8981\u306a\u8a66\u884c\u56de\u6570\u3092\u6e1b\u3089\u3057\u3001\u6210\u529f\u7387\u3092\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Dordle\u306e\u30d7\u30ec\u30a4\u6642\u306b\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u8a8d\u77e5\u8ca0\u8377\u3092\u7ba1\u7406\u3059\u308b\u305f\u3081\u306b\u3069\u306e\u3088\u3046\u306a\u6226\u7565\u3092\u4f7f\u7528\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u8a8d\u77e5\u8ca0\u8377\u3092\u7ba1\u7406\u3059\u308b\u305f\u3081\u306b\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u4f53\u7cfb\u7684\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u3092\u63a1\u7528\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5404\u30d1\u30ba\u30eb\u306b\u7279\u5b9a\u306e\u8a66\u884c\u3092\u4ea4\u4e92\u306b\u5272\u308a\u5f53\u3066\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5404\u30b0\u30ea\u30c3\u30c9\u306e\u53ef\u80fd\u306a\u5358\u8a9e\u3092\u8ffd\u8de1\u3059\u308b\u305f\u3081\u306b\u3001\u30de\u30a4\u30f3\u30c9\u30de\u30c3\u30d7\u307e\u305f\u306f\u30e1\u30e2\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u4e00\u65b9\u306e\u30d1\u30ba\u30eb\u3092\u90e8\u5206\u7684\u306b\u89e3\u6c7a\u3057\u3066\u304b\u3089\u3001\u3082\u3046\u4e00\u65b9\u306e\u30d1\u30ba\u30eb\u306b\u79fb\u884c\u3057\u307e\u3059\u3002\u3053\u306e\u6bb5\u968e\u7684\u306a\u65b9\u6cd5\u306f\u3001\u7cbe\u795e\u7684\u306a\u75b2\u52b4\u3092\u8efd\u6e1b\u3057\u3001\u96c6\u4e2d\u529b\u3092\u9ad8\u3081\u3001Dordle\u306e\u30c7\u30e5\u30a2\u30eb\u30bf\u30b9\u30af\u306e\u6027\u8cea\u3092\u3088\u308a\u7c21\u5358\u306b\u51e6\u7406\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002"}, {"question": "Dordle\u306e\u3069\u306e\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u304c\u3001\u305d\u306e\u7e70\u308a\u8fd4\u3057\u53ef\u80fd\u6027\u306b\u8ca2\u732e\u3057\u3066\u3044\u307e\u3059\u304b\uff1f", "answer": "Dordle\u306e\u7e70\u308a\u8fd4\u3057\u53ef\u80fd\u6027\u306f\u3001\u305d\u306e\u30c7\u30e5\u30a2\u30eb\u30d1\u30ba\u30eb\u30e1\u30ab\u30cb\u30ba\u30e0\u3068\u6bce\u65e5\u306e\u6311\u6226\u30e2\u30fc\u30c9\u306b\u3088\u3063\u3066\u63a8\u9032\u3055\u308c\u307e\u3059\u3002\u540c\u6642\u306b2\u3064\u306e\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u5fc5\u8981\u304c\u3042\u308b\u3053\u3068\u3067\u3001\u5404\u30b2\u30fc\u30e0\u30bb\u30c3\u30b7\u30e7\u30f3\u306f\u30e6\u30cb\u30fc\u30af\u306a\u3082\u306e\u306b\u306a\u308a\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u6bce\u65e5\u306e\u6311\u6226\u30e2\u30fc\u30c9\u306b\u3088\u308a\u3001\u6bce\u65e5\u65b0\u3057\u3044\u5358\u8a9e\u30bb\u30c3\u30c8\u304c\u63d0\u4f9b\u3055\u308c\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u5b9a\u671f\u7684\u306b\u623b\u3063\u3066\u304f\u308b\u3088\u3046\u4fc3\u3055\u308c\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306e\u8a2d\u8a08\u306b\u306f\u3001\u30ab\u30b8\u30e5\u30a2\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u3088\u308a\u672c\u683c\u7684\u306a\u6311\u6226\u3092\u6c42\u3081\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u4e21\u65b9\u306b\u5bfe\u5fdc\u3059\u308b\u3001\u3055\u307e\u3056\u307e\u306a\u96e3\u6613\u5ea6\u30ec\u30d9\u30eb\u3082\u542b\u307e\u308c\u307e\u3059\u3002"}, {"question": "Dordle\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u3069\u306e\u3088\u3046\u306a\u8981\u56e0\u304c\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "Dordle\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u4e21\u65b9\u306e\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u305f\u3081\u306b\u4f7f\u7528\u3055\u308c\u305f\u8a66\u884c\u56de\u6570\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u5404\u8a66\u884c\u306f\u30b9\u30b3\u30a2\u3092\u6e1b\u3089\u3059\u305f\u3081\u3001\u52b9\u7387\u304c\u91cd\u8981\u3067\u3059\u3002\u30b9\u30b3\u30a2\u306e\u8981\u56e0\u306b\u306f\u3001\u63a8\u6e2c\u306e\u901f\u5ea6\u3068\u5358\u8a9e\u9078\u629e\u306e\u6b63\u78ba\u3055\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u4e21\u65b9\u306e\u30d1\u30ba\u30eb\u3092\u5c11\u306a\u3044\u8a66\u884c\u56de\u6570\u3067\u89e3\u304f\u3068\u3001\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u306b\u306a\u308a\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u901f\u5ea6\u3068\u7cbe\u5ea6\u3092\u30d0\u30e9\u30f3\u30b9\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u8912\u3081\u3066\u304a\u308a\u3001\u30b2\u30fc\u30e0\u306b\u7af6\u4e89\u529b\u3092\u52a0\u3048\u3066\u3044\u307e\u3059\u3002"}, {"question": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067Dordle\u3092\u30d7\u30ec\u30a4\u3059\u308b\u305f\u3081\u306e\u6280\u8853\u7684\u306a\u8981\u4ef6\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Dordle\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u8efd\u91cf\u304b\u3064\u30a2\u30af\u30bb\u30b9\u3057\u3084\u3059\u304f\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u305d\u308c\u306f\u3001\u307b\u3068\u3093\u3069\u306e\u30c7\u30d0\u30a4\u30b9\u3068\u4e92\u63db\u6027\u306e\u3042\u308b\u6700\u5c0f\u9650\u306e\u30cf\u30fc\u30c9\u30a6\u30a7\u30a2\u4ed5\u69d8\u3092\u5fc5\u8981\u3068\u3057\u307e\u3059\u3002\u30a6\u30a7\u30d6\u30d6\u30e9\u30a6\u30b6\u3067\u306f\u3001Chrome\u3001Firefox\u3001Safari\u306e\u6700\u65b0\u30d0\u30fc\u30b8\u30e7\u30f3\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u307e\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u3067\u306f\u3001\u5b89\u5b9a\u3057\u305f\u30a4\u30f3\u30bf\u30fc\u30cd\u30c3\u30c8\u63a5\u7d9a\u3067iOS\u3068Android\u306e\u4e21\u65b9\u3067\u30b9\u30e0\u30fc\u30ba\u306b\u52d5\u4f5c\u3057\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306e\u30b7\u30f3\u30d7\u30eb\u3055\u306f\u3001\u30cf\u30a4\u30a8\u30f3\u30c9\u306e\u30cf\u30fc\u30c9\u30a6\u30a7\u30a2\u3092\u5fc5\u8981\u3068\u305b\u305a\u306b\u697d\u3057\u3080\u3053\u3068\u304c\u3067\u304d\u308b\u3053\u3068\u3092\u4fdd\u8a3c\u3057\u3066\u3044\u307e\u3059\u3002"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30c7\u30d0\u30a4\u30b9\u3092\u5207\u308a\u66ff\u3048\u305f\u3068\u304d\u306bDordle\u306e\u9032\u884c\u72b6\u6cc1\u3092\u4fdd\u5b58\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u9032\u884c\u72b6\u6cc1\u3092\u4fdd\u5b58\u3059\u308b\u306b\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u4e00\u8cab\u3057\u305f\u30a2\u30ab\u30a6\u30f3\u30c8\u307e\u305f\u306f\u30ed\u30b0\u30a4\u30f3\u65b9\u6cd5\u3092\u3055\u307e\u3056\u307e\u306a\u30c7\u30d0\u30a4\u30b9\u3067\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002Dordle\u306f\u3001Google Play\u3084Apple Game Center\u306a\u3069\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u4ecb\u3057\u3066\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30b9\u30de\u30fc\u30c8\u30d5\u30a9\u30f3\u3068\u30bf\u30d6\u30ec\u30c3\u30c8\u306e\u4e21\u65b9\u3067\u540c\u3058Google\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3068\u3001\u9032\u884c\u72b6\u6cc1\u304c\u540c\u671f\u3055\u308c\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u30c7\u30d0\u30a4\u30b9\u3092\u5207\u308a\u66ff\u3048\u308b\u3053\u3068\u304c\u983b\u7e41\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u7279\u306b\u4fbf\u5229\u3067\u3059\u3002\u305d\u306e\u5834\u5408\u3001\u5f7c\u3089\u306e\u9054\u6210\u3068\u65e5\u3005\u306e\u6311\u6226\u304c\u5e38\u306b\u6700\u65b0\u306e\u72b6\u614b\u306b\u306a\u308a\u307e\u3059\u3002"}, {"question": "Dordle\u306b\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u767a\u898b\u3067\u304d\u308b\u96a0\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "Dordle\u306b\u306f\u3001\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u5f37\u5316\u3059\u308b\u3044\u304f\u3064\u304b\u306e\u96a0\u308c\u305f\u6a5f\u80fd\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306e1\u3064\u306f\u3001\u7279\u5b9a\u306e\u7bc0\u76ee\uff08\u305f\u3068\u3048\u3070\u3001\u9023\u7d9a\u3059\u308b\u7279\u5b9a\u306e\u6570\u306e\u30d1\u30ba\u30eb\u306e\u89e3\u6c7a\uff09\u3092\u9054\u6210\u3059\u308b\u3053\u3068\u3067\u7279\u5225\u306a\u30c6\u30fc\u30de\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u308b\u6a5f\u80fd\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u300150\u56de\u306e\u30d1\u30ba\u30eb\u3092\u640d\u5931\u3059\u308b\u3053\u3068\u306a\u304f\u5b8c\u4e86\u3059\u308b\u3068\u3001\u72ec\u7279\u306e\u8272\u4f7f\u3044\u3084\u80cc\u666f\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u96a0\u308c\u305f\u8981\u7d20\u306f\u3001\u732e\u8eab\u7684\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u305f\u3081\u306e\u30e2\u30c1\u30d9\u30fc\u30b7\u30e7\u30f3\u3068\u5831\u916c\u306e\u8ffd\u52a0\u5c64\u3092\u8ffd\u52a0\u3057\u3001\u7d99\u7d9a\u7684\u306a\u30a8\u30f3\u30b2\u30fc\u30b8\u30e1\u30f3\u30c8\u3092\u4fc3\u3057\u307e\u3059\u3002"}]
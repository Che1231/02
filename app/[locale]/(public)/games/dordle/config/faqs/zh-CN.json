[{"question": "Dordle \u7684\u6e38\u620f\u673a\u5236\u4e0e\u4f20\u7edf\u5b57\u8c1c\u6e38\u620f\u6709\u4f55\u4e0d\u540c\uff1f", "answer": "Dordle \u5f15\u5165\u4e86\u4e00\u4e2a\u72ec\u7279\u7684\u53d8\u5316\uff0c\u8981\u6c42\u73a9\u5bb6\u540c\u65f6\u89e3\u51b3\u4e24\u4e2a\u5b57\u8c1c\u6e38\u620f\u3002\u4e0e\u4f20\u7edf\u5b57\u8c1c\u6e38\u620f\u4e00\u6b21\u4e13\u6ce8\u4e00\u4e2a\u5355\u8bcd\u4e0d\u540c\uff0cDordle \u6311\u6218\u73a9\u5bb6\u540c\u65f6\u7ba1\u7406\u4e24\u4e2a\u72ec\u7acb\u7684\u65b9\u683c\u3002\u4f8b\u5982\uff0c\u5728\u731c\u6d4b\u4e00\u4e2a\u8c1c\u9898\u7684\u201cCRANE\u201d\u65f6\uff0c\u4f60\u53ef\u80fd\u8fd8\u9700\u8981\u8003\u8651\u53e6\u4e00\u4e2a\u8c1c\u9898\u7684\u201cPLANT\u201d\u3002\u8fd9\u79cd\u53cc\u4efb\u52a1\u65b9\u6cd5\u63d0\u9ad8\u4e86\u8ba4\u77e5\u8d1f\u8377\u548c\u6218\u7565\u89c4\u5212\uff0c\u8ba9\u559c\u6b22\u591a\u4efb\u52a1\u5904\u7406\u7684\u73a9\u5bb6\u66f4\u6295\u5165\u3002"}, {"question": "\u521d\u5b66\u8005\u5e94\u8be5\u91c7\u53d6\u54ea\u4e9b\u6b65\u9aa4\u6765\u63d0\u9ad8\u4ed6\u4eec\u7684 Dordle \u6280\u80fd\uff1f", "answer": "\u6b65\u9aa4\u4e00\uff1a\u9996\u5148\u719f\u6089\u5e38\u89c1\u7684\u4e94\u4e2a\u5b57\u6bcd\u5355\u8bcd\u3002\u8fd9\u65b9\u9762\u7684\u57fa\u7840\u8bcd\u6c47\u5c06\u5e2e\u52a9\u60a8\u8fdb\u884c\u5408\u7406\u7684\u731c\u6d4b\u3002\u6b65\u9aa4\u4e8c\uff1a\u6ce8\u610f\u5b57\u6bcd\u7684\u9891\u7387\u548c\u4f4d\u7f6e\u3002\u4f8b\u5982\uff0c\u201cE\u201d\u548c\u201cA\u201d\u4e4b\u7c7b\u7684\u5b57\u6bcd\u7ecf\u5e38\u51fa\u73b0\u5728\u7279\u5b9a\u4f4d\u7f6e\u3002\u6b65\u9aa4\u4e09\uff1a\u7ec3\u4e60\u540c\u65f6\u89e3\u51b3\u4e24\u4e2a\u8c1c\u9898\uff0c\u800c\u4e0d\u662f\u4e00\u6b21\u4e13\u6ce8\u4e8e\u4e00\u4e2a\u8c1c\u9898\u3002\u8fd9\u79cd\u65b9\u6cd5\u5c06\u5e2e\u52a9\u4f60\u57f9\u517b\u5fc5\u8981\u7684\u5e76\u884c\u5904\u7406\u6280\u80fd\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u7406\u89e3\u5b57\u6bcd\u9891\u7387\u5bf9\u4e8e\u638c\u63e1 Dordle \u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u7406\u89e3\u5b57\u6bcd\u9891\u7387\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u5141\u8bb8\u60a8\u505a\u51fa\u66f4\u660e\u667a\u7684\u731c\u6d4b\u3002\u4f8b\u5982\uff0c\u201cE\u201d\u3001\u201cA\u201d\u548c\u201cR\u201d\u7b49\u5b57\u6bcd\u5728\u82f1\u8bed\u5355\u8bcd\u4e2d\u51fa\u73b0\u7684\u9891\u7387\u66f4\u9ad8\uff0c\u56e0\u6b64\u4f18\u5148\u8003\u8651\u8fd9\u4e9b\u5b57\u6bcd\u53ef\u4ee5\u63d0\u9ad8\u60a8\u6210\u529f\u7684\u51e0\u7387\u3002\u5728 Dordle \u4e2d\uff0c\u60a8\u9700\u8981\u540c\u65f6\u7ba1\u7406\u4e24\u4e2a\u8c1c\u9898\uff0c\u8fd9\u4e9b\u77e5\u8bc6\u6709\u52a9\u4e8e\u60a8\u4f18\u5316\u4e24\u4e2a\u65b9\u683c\u4e2d\u7684\u731c\u6d4b\uff0c\u8282\u7701\u5b9d\u8d35\u7684\u5c1d\u8bd5\u6b21\u6570\uff0c\u63d0\u9ad8\u6574\u4f53\u6548\u7387\u3002"}, {"question": "\u9ad8\u7ea7\u73a9\u5bb6\u5982\u4f55\u5229\u7528\u6a21\u5f0f\u8bc6\u522b\u5728 Dordle \u4e2d\u8131\u9896\u800c\u51fa\uff1f", "answer": "\u9ad8\u7ea7\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u8bc6\u522b\u5e38\u89c1\u7684\u5355\u8bcd\u7ed3\u6784\u548c\u5b57\u6bcd\u7ec4\u5408\u6765\u5229\u7528\u6a21\u5f0f\u8bc6\u522b\u3002\u4f8b\u5982\uff0c\u8bc6\u522b\u8bb8\u591a\u5355\u8bcd\u4ee5\u201cING\u201d\u7ed3\u5c3e\u6216\u4ee5\u201cTH\u201d\u5f00\u5934\u53ef\u4ee5\u663e\u8457\u7f29\u5c0f\u53ef\u80fd\u6027\u3002\u5728 Dordle \u4e2d\uff0c\u5728\u4e24\u4e2a\u8c1c\u9898\u4e2d\u5e94\u7528\u8fd9\u79cd\u65b9\u6cd5\u53ef\u4ee5\u8fdb\u884c\u66f4\u5177\u6218\u7565\u6027\u7684\u731c\u6d4b\u3002\u901a\u8fc7\u7ed8\u5236\u8fd9\u4e9b\u6a21\u5f0f\uff0c\u73a9\u5bb6\u53ef\u4ee5\u51cf\u5c11\u6240\u9700\u7684\u5c1d\u8bd5\u6b21\u6570\u5e76\u63d0\u9ad8\u6210\u529f\u7387\u3002"}, {"question": "\u73a9\u5bb6\u5728\u73a9 Dordle \u65f6\u5982\u4f55\u7ba1\u7406\u8ba4\u77e5\u8d1f\u8377\uff1f", "answer": "\u4e3a\u4e86\u7ba1\u7406\u8ba4\u77e5\u8d1f\u8377\uff0c\u73a9\u5bb6\u53ef\u4ee5\u91c7\u53d6\u7cfb\u7edf\u7684\u65b9\u6cd5\uff1a\u6b65\u9aa4\u4e00\uff1a\u4ea4\u66ff\u5730\u4e3a\u6bcf\u4e2a\u8c1c\u9898\u5206\u914d\u7279\u5b9a\u7684\u5c1d\u8bd5\u6b21\u6570\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u5fc3\u7406\u6216\u7269\u7406\u7b14\u8bb0\u8ddf\u8e2a\u6bcf\u4e2a\u65b9\u683c\u7684\u53ef\u80fd\u5355\u8bcd\u3002\u6b65\u9aa4\u4e09\uff1a\u5728\u5207\u6362\u5230\u53e6\u4e00\u4e2a\u8c1c\u9898\u4e4b\u524d\uff0c\u4e13\u6ce8\u4e8e\u90e8\u5206\u89e3\u51b3\u4e00\u4e2a\u8c1c\u9898\u3002\u8fd9\u79cd\u5206\u9636\u6bb5\u7684\u65b9\u6cd5\u53ef\u4ee5\u51cf\u5c11\u7cbe\u795e\u75b2\u52b3\uff0c\u589e\u5f3a\u4e13\u6ce8\u529b\uff0c\u8ba9\u73a9\u5bb6\u66f4\u5bb9\u6613\u5e94\u5bf9 Dordle \u7684\u53cc\u4efb\u52a1\u7279\u6027\u3002"}, {"question": "Dordle \u4e2d\u54ea\u4e9b\u6e38\u620f\u673a\u5236\u4fc3\u8fdb\u4e86\u5b83\u7684\u53ef\u91cd\u590d\u6027\uff1f", "answer": "Dordle \u7684\u53ef\u91cd\u590d\u6027\u7531\u5176\u53cc\u8c1c\u9898\u673a\u5236\u548c\u6bcf\u65e5\u6311\u6218\u6a21\u5f0f\u9a71\u52a8\u3002\u540c\u65f6\u89e3\u51b3\u4e24\u4e2a\u8c1c\u9898\u786e\u4fdd\u6bcf\u6b21\u6e38\u620f\u4f53\u9a8c\u90fd\u662f\u72ec\u7279\u7684\u3002\u6b64\u5916\uff0c\u6bcf\u65e5\u6311\u6218\u6bcf\u5929\u63d0\u4f9b\u4e00\u7ec4\u65b0\u7684\u5355\u8bcd\uff0c\u9f13\u52b1\u73a9\u5bb6\u5b9a\u671f\u8fd4\u56de\u3002\u6e38\u620f\u7684\u8a2d\u8a08\u8fd8\u5305\u542b\u4e0d\u540c\u7684\u96be\u5ea6\u7b49\u7ea7\uff0c\u6ee1\u8db3\u4f11\u95f2\u73a9\u5bb6\u548c\u5bfb\u6c42\u66f4\u9ad8\u6311\u6218\u73a9\u5bb6\u7684\u9700\u6c42\u3002"}, {"question": "Dordle \u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u5b83\uff1f", "answer": "Dordle \u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u89e3\u51b3\u4e24\u4e2a\u8c1c\u9898\u6240\u4f7f\u7528\u7684\u5c1d\u8bd5\u6b21\u6570\u3002\u6bcf\u6b21\u5c1d\u8bd5\u90fd\u4f1a\u964d\u4f4e\u60a8\u7684\u5206\u6570\uff0c\u56e0\u6b64\u6548\u7387\u81f3\u5173\u91cd\u8981\u3002\u5f71\u54cd\u5206\u6570\u7684\u56e0\u7d20\u5305\u62ec\u60a8\u731c\u6d4b\u7684\u901f\u5ea6\u548c\u5355\u8bcd\u9009\u62e9\u7684\u51c6\u786e\u6027\u3002\u4f8b\u5982\uff0c\u5728\u8f83\u5c11\u7684\u5c1d\u8bd5\u6b21\u6570\u5185\u89e3\u51b3\u8fd9\u4e24\u4e2a\u8c1c\u9898\u5c06\u83b7\u5f97\u66f4\u9ad8\u7684\u5206\u6570\u3002\u8be5\u7cfb\u7edf\u5956\u52b1\u90a3\u4e9b\u80fd\u591f\u5e73\u8861\u901f\u5ea6\u548c\u7cbe\u5ea6\u7684\u73a9\u5bb6\uff0c\u4e3a\u6e38\u620f\u589e\u6dfb\u4e86\u7ade\u4e89\u6027\u3002"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u73a9 Dordle \u9700\u8981\u54ea\u4e9b\u6280\u672f\u8981\u6c42\uff1f", "answer": "Dordle \u8bbe\u8ba1\u8f7b\u5de7\u4e14\u6613\u4e8e\u8bbf\u95ee\u5404\u79cd\u5e73\u53f0\u3002\u5b83\u9700\u8981\u6700\u5c0f\u7684\u786c\u4ef6\u89c4\u683c\uff0c\u4f7f\u5176\u4e0e\u5927\u591a\u6570\u8bbe\u5907\u517c\u5bb9\u3002\u5bf9\u4e8e\u7f51\u9875\u6d4f\u89c8\u5668\uff0c\u5b83\u652f\u6301 Chrome\u3001Firefox \u548c Safari \u7684\u6700\u65b0\u7248\u672c\u3002\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\uff0c\u5b83\u5728\u7a33\u5b9a\u7684\u4e92\u8054\u7f51\u8fde\u63a5\u4e0b\u53ef\u5728 iOS \u548c Android \u8bbe\u5907\u4e0a\u6d41\u7545\u8fd0\u884c\u3002\u6e38\u620f\u7684\u7b80\u6d01\u6027\u786e\u4fdd\u65e0\u9700\u9ad8\u7ea7\u786c\u4ef6\u5373\u53ef\u4eab\u53d7\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u786e\u4fdd\u5728\u66f4\u6362\u8bbe\u5907\u65f6 Dordle \u4e2d\u7684\u8fdb\u5ea6\u5f97\u5230\u4fdd\u5b58\uff1f", "answer": "\u4e3a\u4e86\u786e\u4fdd\u8fdb\u5ea6\u4fdd\u5b58\uff0c\u73a9\u5bb6\u5e94\u8be5\u5728\u4e0d\u540c\u8bbe\u5907\u4e0a\u4f7f\u7528\u4e00\u81f4\u7684\u5e10\u6237\u6216\u767b\u5f55\u65b9\u6cd5\u3002Dordle \u901a\u8fc7 Google Play \u6216 Apple Game Center \u7b49\u5e73\u53f0\u652f\u6301\u4e91\u4fdd\u5b58\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u76f8\u540c\u7684 Google \u8d26\u6237\u5728\u60a8\u7684\u624b\u673a\u548c\u5e73\u677f\u7535\u8111\u4e0a\u767b\u5f55\u5c06\u540c\u6b65\u60a8\u7684\u8fdb\u5ea6\u3002\u5bf9\u4e8e\u7ecf\u5e38\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u5207\u6362\u7684\u73a9\u5bb6\u6765\u8bf4\uff0c\u6b64\u529f\u80fd\u7279\u522b\u6709\u7528\uff0c\u786e\u4fdd\u4ed6\u4eec\u7684\u6210\u5c31\u548c\u6bcf\u65e5\u6311\u6218\u59cb\u7ec8\u4fdd\u6301\u6700\u65b0\u3002"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728 Dordle \u4e2d\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "Dordle \u5305\u542b\u4e00\u4e9b\u9690\u85cf\u529f\u80fd\uff0c\u589e\u5f3a\u4e86\u6e38\u620f\u4f53\u9a8c\u3002\u4e00\u4e2a\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\u901a\u8fc7\u5b9e\u73b0\u7279\u5b9a\u91cc\u7a0b\u7891\u6765\u89e3\u9501\u7279\u6b8a\u4e3b\u9898\uff0c\u4f8b\u5982\u8fde\u7eed\u89e3\u51b3\u4e00\u5b9a\u6570\u91cf\u7684\u8c1c\u9898\u3002\u4f8b\u5982\uff0c\u5728\u6ca1\u6709\u4efb\u4f55\u5931\u8d25\u7684\u60c5\u51b5\u4e0b\u5b8c\u6210 50 \u4e2a\u8c1c\u9898\u53ef\u80fd\u4f1a\u89e3\u9501\u72ec\u7279\u7684\u914d\u8272\u65b9\u6848\u6216\u80cc\u666f\u3002\u8fd9\u4e9b\u9690\u85cf\u5143\u7d20\u4e3a\u4e13\u6ce8\u7684\u73a9\u5bb6\u63d0\u4f9b\u4e86\u989d\u5916\u7684\u6fc0\u52b1\u548c\u5956\u52b1\uff0c\u9f13\u52b1\u6301\u7eed\u53c2\u4e0e\u3002"}]
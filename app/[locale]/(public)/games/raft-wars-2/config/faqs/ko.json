[{"question": "\ub77c\ud504\ud2b8 \uc6cc\uc988 2\uc5d0\uc11c \uc5b4\ub5bb\uac8c \uc81c \ud504\ub85c\uc81d\ud0c0\uc77c\uc758 \uada4\uc801\uc744 \uc81c\uc5b4\ud560 \uc218 \uc788\uc73c\uba70, \uc219\ub2ec\ud574\uc57c \ud558\ub294 \uae30\ubcf8\uc801\uc778 \uc870\uc791\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub77c\ud504\ud2b8 \uc6cc\uc988 2\uc5d0\uc11c \ud504\ub85c\uc81d\ud0c0\uc77c\uc758 \uada4\uc801 \uc81c\uc5b4\ub294 \uc131\uacf5\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uae30\ubcf8\uc801\uc778 \uc870\uc791\uc740 \uc870\uc900\uc744 \uc704\ud574 \ud0ed\ud558\uace0 \ub204\ub974\uace0, \uadf8\ub7f0 \ub2e4\uc74c \ubc1c\uc0ac\ud558\uae30 \uc704\ud574 \ub193\ub294 \uac83\uc785\ub2c8\ub2e4. \uc774\ub97c \uc219\ub2ec\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. \ub2e8\uacc4 1 \u2013 \ub300\uc0c1\uc744 \ud5a5\ud574 \uce90\ub9ad\ud130\ub97c \ubc30\uce58\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2 \u2013 \uc870\uc900\uc120\uc744 \ud45c\uc2dc\ud558\ub824\uba74 \ud0ed\ud558\uace0 \ub204\ub985\ub2c8\ub2e4. \ub2e8\uacc4 3 \u2013 \uc190\uac00\ub77d\uc744 \uc704\uc544\ub798\ub85c \uc6c0\uc9c1\uc5ec \uac01\ub3c4\uc640 \ud798\uc744 \uc870\uc815\ud55c \ub2e4\uc74c \ubc1c\uc0ac\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub354 \ub192\uc740 \ud50c\ub7ab\ud3fc\uc5d0 \uc788\ub294 \uc801\uc744 \uc870\uc900\ud560 \ub54c \uc911\ub825\uc744 \uace0\ub824\ud558\uc5ec \uc57d\uac04 \ub354 \ub192\uac8c \uc870\uc900\ud569\ub2c8\ub2e4. \uc774 \uae30\uc220\uc744 \uc0ac\uc6a9\ud558\uba74 \uc815\ud655\ud558\uace0 \ud6a8\uacfc\uc801\uc778 \uc0ac\uaca9\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "\ub77c\ud504\ud2b8 \uc6cc\uc988 2\uc5d0\uc11c \ubcf4\uc2a4\ub97c \ubb3c\ub9ac\uce58\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc774\uba70, \uc774\ub7ec\ud55c \ub9cc\ub0a8\uc5d0 \uc5b4\ub5bb\uac8c \ub300\ube44\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub77c\ud504\ud2b8 \uc6cc\uc988 2\uc5d0\uc11c \ubcf4\uc2a4\ub97c \ubb3c\ub9ac\uce58\ub824\uba74 \uc804\ub7b5\uacfc \uc900\ube44\uc758 \uc870\ud569\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e4\uc74c\uc740 \ub2e8\uacc4\ubcc4 \uc811\uadfc \ubc29\uc2dd\uc785\ub2c8\ub2e4. \ub2e8\uacc4 1 \u2013 \ubcf4\uc2a4\uc804\uc5d0 \uc218\ub958\ud0c4 \ubc1c\uc0ac\uae30 \ub610\ub294 \ub85c\ucf13 \ubc1c\uc0ac\uae30\uc640 \uac19\uc740 \uac15\ub825\ud55c \ubb34\uae30\ub97c \ucda9\ubd84\ud788 \uc900\ube44\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2 \u2013 \uc608\ub97c \ub4e4\uc5b4, \ud574\uc801\uc655\uc740 \uc608\uce21 \uac00\ub2a5\ud55c \uada4\uc801\uc73c\ub85c \ud3ed\ud0c4\uc744 \uc790\uc8fc \ub358\uc9c0\ubbc0\ub85c \ubcf4\uc2a4\uc758 \uacf5\uaca9 \ud328\ud134\uc744 \uc5f0\uad6c\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3 \u2013 \ud574\uc801\uc655\uc758 \ubaa8\uc790\uc640 \uac19\uc740 \uc57d\uc810\uc744 \ub178\ub824 \ucd94\uac00 \ud53c\ud574\ub97c \uc785\ud799\ub2c8\ub2e4. \ub610\ud55c \uccb4\ub825\uc744 \ucd5c\ub300\ub85c \uc720\uc9c0\ud558\uace0 \uc801\uc808\ud788 \uc5c4\ud3d0\ud558\uc5ec \ubd88\ud544\uc694\ud55c \ud53c\ud574\ub97c \ubc29\uc9c0\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc900\ube44\ub294 \uc2b9\ub9ac \uac00\ub2a5\uc131\uc744 \ud06c\uac8c \ub192\uc785\ub2c8\ub2e4."}, {"question": "\ub77c\ud504\ud2b8 \uc6cc\uc988 2\uc758 \ubb34\uae30 \uc5c5\uadf8\ub808\uc774\ub4dc \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \ucd08\ubcf4\uc790\uc5d0\uac8c \uac00\uc7a5 \ud070 \uac00\uce58\ub97c \uc81c\uacf5\ud558\ub294 \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub77c\ud504\ud2b8 \uc6cc\uc988 2\uc758 \ubb34\uae30 \uc5c5\uadf8\ub808\uc774\ub4dc \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \ub354 \ud6a8\uacfc\uc801\uc778 \uc804\ud22c\ub97c \uc704\ud574 \ubb34\uae30\ub97c \uac15\ud654\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uc5ec \uc5bb\uc740 \ucf54\uc778\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uad6c\ub9e4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ucd08\ubcf4\uc790\uc5d0\uac8c \uac00\uc7a5 \uac00\uce58 \uc788\ub294 \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. 1) **\ud53c\ud574 \uc99d\uac00** \u2013 \ud55c \ubc88\uc758 \uc0ac\uaca9\uc73c\ub85c \ub354 \ub9ce\uc740 \ud53c\ud574\ub97c \uc785\ud788\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. 2) **\ud0c4\uc57d \uc6a9\ub7c9** \u2013 \uc7ac\uc7a5\uc804 \uc804\uc5d0 \ub354 \ub9ce\uc740 \ubc1c\uc0ac\uac00 \uac00\ub2a5\ud569\ub2c8\ub2e4. 3) **\uc815\ud655\ub3c4 \ud5a5\uc0c1** \u2013 \uc0ac\uaca9\uc758 \uc815\ud655\ub3c4\ub97c \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucd08\uae30 \ub2e8\uacc4\uc5d0\uc11c \uc2ac\ub9c1\uc0f7\uc758 \ud53c\ud574\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uba74 \uc801\uc744 \ub354 \ube60\ub974\uac8c \ubb3c\ub9ac\uce58\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784 \uc9c4\ud589\uc744 \ub354\uc6b1 \uc218\uc6d4\ud558\uace0 \uc990\uac81\uac8c \ud558\ub824\uba74 \uc774\ub7ec\ud55c \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \uace0\ub824\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ub77c\ud504\ud2b8 \uc6cc\uc988 2\uc5d0\uc11c \uc81c\uacf5\ub418\ub294 \ubb34\uae30\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc774\uba70, \uac01 \ub808\ubca8\uc5d0 \uc801\ud569\ud55c \ubb34\uae30\ub97c \uc5b4\ub5bb\uac8c \uc120\ud0dd\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\ub77c\ud504\ud2b8 \uc6cc\uc988 2\uc5d0\uc11c \uac01 \ubb34\uae30\ub294 \uace0\uc720\ud55c \ud2b9\uc131\uc744 \uac00\uc9c0\uace0 \uc788\uc5b4 \ub2e4\uc591\ud55c \uc0c1\ud669\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4. \ube44\uad50\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. 1) **\uc2ac\ub9c1\uc0f7** \u2013 \uae30\ubcf8 \ubb34\uae30, \ucd08\ubc18 \ub808\ubca8\uc5d0 \uac00\uc7a5 \uc801\ud569\ud569\ub2c8\ub2e4. 2) **\uc218\ub958\ud0c4 \ubc1c\uc0ac\uae30** \u2013 \ub192\uc740 \ud53c\ud574, \uc9d1\uc911\ub41c \uc801\uc5d0\uac8c \uc774\uc0c1\uc801\uc785\ub2c8\ub2e4. 3) **\ub85c\ucf13 \ubc1c\uc0ac\uae30** \u2013 \ud3ed\ubc1c\ub825\uc774 \uac15\ud574 \uac15\ub825\ud55c \uc801\uc744 \uc81c\uac70\ud558\ub294 \ub370 \uc801\ud569\ud569\ub2c8\ub2e4. \uc801\uc808\ud55c \ubb34\uae30\ub97c \uc120\ud0dd\ud558\ub824\uba74 \ub808\ubca8\uc758 \ub808\uc774\uc544\uc6c3\uacfc \uc801 \uc720\ud615\uc744 \uace0\ub824\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc5ec\ub7ec \uba85\uc758 \uc801\uc774 \uac00\uae4c\uc6b4 \ub808\ubca8\uc5d0\uc11c\ub294 \uc2ac\ub9c1\uc0f7\ubcf4\ub2e4 \uc218\ub958\ud0c4 \ubc1c\uc0ac\uae30\uac00 \ub354 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ucc28\uc774\uc810\uc744 \uc774\ud574\ud558\uba74 \uc804\ub7b5\uc801\uc778 \uacb0\uc815\uc744 \ub0b4\ub9ac\uace0 \ud6a8\uc728\uc801\uc73c\ub85c \uc9c4\ud589\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\ub77c\ud504\ud2b8 \uc6cc\uc988 2\uc5d0\uc11c \ud56d\uc0c1 \ucda9\ubd84\ud55c \ud0c4\uc57d\uacfc \uccb4\ub825\uc744 \ud655\ubcf4\ud558\uae30 \uc704\ud574 \uc790\uc6d0 \uad00\ub9ac\ub97c \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub77c\ud504\ud2b8 \uc6cc\uc988 2\uc5d0\uc11c \uc790\uc6d0 \uad00\ub9ac\ub97c \ucd5c\uc801\ud654\ud558\ub294 \uac83\uc740 \uc2e0\uc911\ud55c \uacc4\ud68d\uacfc \uc790\uc6d0\uc758 \ud6a8\uc728\uc801\uc778 \ud65c\uc6a9\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ubc29\ubc95\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1 \u2013 \ud56d\uc0c1 \uba85\uc911 \ub610\ub294 \uc57d\uc810\uc744 \ub178\ub824 \ud0c4\uc57d\uc744 \uc808\uc57d\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2 \u2013 \uc5c4\ud3d0\ubb3c\uc744 \uc0ac\uc6a9\ud558\uc5ec \uccb4\ub825 \uc190\uc2e4\uc744 \ucd5c\uc18c\ud654\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc0c1\uc790 \ub4a4\uc5d0 \uc228\uc5b4 \uc801\uc758 \uacf5\uaca9\uc744 \ud53c\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3 \u2013 \uc4f0\ub7ec\uc9c4 \uc801\uacfc \ud30c\uad34 \uac00\ub2a5\ud55c \ubb3c\uccb4\uc5d0\uc11c \ucf54\uc778\uacfc \uccb4\ub825 \ud68c\ubcf5 \uc544\uc774\ud15c\uc744 \uc218\uc9d1\ud569\ub2c8\ub2e4. \ub610\ud55c, \ub354 \uae34 \uc804\ud22c\ub97c \uc9c0\uc18d\ud560 \uc218 \uc788\ub3c4\ub85d \ud0c4\uc57d \uc6a9\ub7c9\uacfc \uccb4\ub825 \ud68c\ubcf5 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \uace0\ub824\ud569\ub2c8\ub2e4. \uc774 \uc804\ub7b5\uc744 \uc0ac\uc6a9\ud558\uba74 \uc55e\uc73c\ub85c \ub098\uc544\uac00\ub294 \ub370 \ud56d\uc0c1 \uc900\ube44\ub41c \uc0c1\ud0dc\ub97c \uc720\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub300\ubd80\ubd84\uc758 \ud50c\ub808\uc774\uc5b4\uac00 \ub193\uce60 \uc218 \uc788\ub294 \ub77c\ud504\ud2b8 \uc6cc\uc988 2\uc758 \uc228\uaca8\uc9c4 \ube44\ubc00\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub4e4\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub77c\ud504\ud2b8 \uc6cc\uc988 2\ub294 \uac8c\uc784\uc758 \ub9e4\ub825\uc744 \ub354\ud558\ub294 \uc228\uaca8\uc9c4 \ube44\ubc00\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\ub85c \uac00\ub4dd\ud569\ub2c8\ub2e4. \ub208\uc5d0 \ub744\ub294 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ud2b9\uc815 \ub808\ubca8\uc5d0\uc11c \ud2b9\uc815 \uc9c0\uc810\uc744 \uc870\uc900\ud558\uc5ec \ucc3e\uc744 \uc218 \uc788\ub294 **\ud669\uae08 \ubb3c\uace0\uae30**\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 10\uc5d0\uc11c \ud654\uba74 \uc624\ub978\ucabd \uc0c1\ub2e8\uc744 \uc870\uc900\ud558\uba74 \ud669\uae08 \ubb3c\uace0\uae30\ub97c \ucc3e\uc744 \uc218 \uc788\uc73c\uba70, \uc774\ub294 \ucd94\uac00 \ucf54\uc778\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \ube44\ubc00\uc740 \ud30c\uad34\ud558\uae30 \uc5b4\ub824\uc6b4 \ub3cc\uc744 \ud30c\uad34\ud558\uc5ec \uc811\uadfc\ud560 \uc218 \uc788\ub294 \ub808\ubca8 15\uc758 **\uc228\uaca8\uc9c4 \ub3d9\uad74**\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uc694\uc18c\ub97c \ud0d0\ud5d8\ud558\uba74 \ubcf4\uc0c1\uc744 \uc5bb\uc744 \ubfd0\ub9cc \uc544\ub2c8\ub77c \uc804\uccb4\uc801\uc778 \uac8c\uc784 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4."}, {"question": "\ub77c\ud504\ud2b8 \uc6cc\uc988 2\uc758 \ubb3c\ub9ac \uc5d4\uc9c4\uc740 \uac8c\uc784\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\uba70, \ud50c\ub808\uc774\uc5b4\ub294 \ubb34\uc5c7\uc744 \uc54c\uc544\uc57c \ud569\ub2c8\uae4c?", "answer": "\ub77c\ud504\ud2b8 \uc6cc\uc988 2\uc758 \ubb3c\ub9ac \uc5d4\uc9c4\uc740 \ud504\ub85c\uc81d\ud0c0\uc77c\uc758 \uada4\uc801\uacfc \ud658\uacbd \uc0c1\ud638\uc791\uc6a9\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uccd0 \uac8c\uc784\ud50c\ub808\uc774\uc5d0 \uc911\uc694\ud55c \uc5ed\ud560\uc744 \ud569\ub2c8\ub2e4. \uc8fc\uc694 \uce21\uba74\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. 1) **\uc911\ub825** \u2013 \ud504\ub85c\uc81d\ud0c0\uc77c\uc758 \uace1\uc120\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uac01\ub3c4\uac00 \ub192\uc744\uc218\ub85d \uace1\uc120\uc774 \ub354 \uac00\ud30c\ub985\ub2c8\ub2e4. 2) **\ubc14\ub78c** \u2013 \uc0ac\uaca9 \uacbd\ub85c\ub97c \ubcc0\uacbd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\uc5d0 \ub530\ub77c \uc870\uc900\uc744 \uc870\uc815\ud569\ub2c8\ub2e4. 3) **\ucda9\ub3cc** \u2013 \uc0c1\uc790\uc640 \uac19\uc740 \ubb3c\uccb4\ub294 \ud504\ub85c\uc81d\ud0c0\uc77c\uc744 \ucc28\ub2e8\ud558\uac70\ub098 \ubc29\ud5a5\uc744 \ubc14\uafc0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud070 \uac04\uaca9\uc744 \ub118\uc5b4 \uc0ac\uaca9\ud560 \ub54c \uc911\ub825\uc744 \uace0\ub824\ud558\uc5ec \uc57d\uac04 \ub354 \ub192\uac8c \uc870\uc900\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ubb3c\ub9ac \uc6d0\ub9ac\ub97c \uc774\ud574\ud558\uba74 \ud50c\ub808\uc774\uc5b4\uac00 \ub354 \uc815\ud655\ud55c \uc0ac\uaca9\uc744 \ud558\uace0 \uc804\ub7b5\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc138\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub2e4\ub978 \uae30\uae30 \uac04\uc5d0 \ub77c\ud504\ud2b8 \uc6cc\uc988 2\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud560 \uc218 \uc788\uc73c\uba70, \uc774 \ud504\ub85c\uc138\uc2a4\ub294 \uc5b4\ub5bb\uac8c \ucc98\ub9ac\ub429\ub2c8\uae4c?", "answer": "\ub2e4\ub978 \uae30\uae30 \uac04\uc5d0 \ub77c\ud504\ud2b8 \uc6cc\uc988 2\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud560 \uc218 \uc788\uc9c0\ub9cc \uba87 \uac00\uc9c0 \ub2e8\uacc4\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \uc6b0\uc120 \ub450 \uae30\uae30 \ubaa8\ub450 \uac19\uc740 \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, Android\uc5d0\uc11c Google Play \uacc4\uc815\uc744 \uc0ac\uc6a9\ud558\ub294 \uacbd\uc6b0 \uc0c8 \uae30\uae30\uc5d0\uc11c\ub3c4 \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. \uadf8\ub7f0 \ub2e4\uc74c \uac8c\uc784 \uc124\uc815\uc5d0\uc11c \uc0ac\uc6a9 \uac00\ub2a5\ud55c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \ud1b5\ud574 \uac8c\uc784 \ub370\uc774\ud130\ub97c \ub3d9\uae30\ud654\ud569\ub2c8\ub2e4. \uc774 \ud504\ub85c\uc138\uc2a4\ub294 \uc644\ub8cc\ud55c \ub808\ubca8\uacfc \uad6c\ub9e4\ud55c \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \ud3ec\ud568\ud55c \uc9c4\ud589 \uc0c1\ud669\uc774 \uc6d0\ud65c\ud558\uac8c \uc804\uc1a1\ub418\ub3c4\ub85d \ud569\ub2c8\ub2e4. \uae30\uae30\ub97c \ubcc0\uacbd\ud558\uae30 \uc804\uc5d0 \ud56d\uc0c1 \ub370\uc774\ud130\ub97c \ubc31\uc5c5\ud558\uc5ec \uc190\uc2e4\uc744 \ubc29\uc9c0\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ub77c\ud504\ud2b8 \uc6cc\uc988 2\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \ud754\ud788 \uc800\uc9c0\ub974\ub294 \uc2e4\uc218\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \uc774\ub7ec\ud55c \uc2e4\uc218\ub97c \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub77c\ud504\ud2b8 \uc6cc\uc988 2\uc758 \uc2e0\uaddc \ud50c\ub808\uc774\uc5b4\ub294 \uc9c4\ud589 \uc0c1\ud669\uc744 \ubc29\ud574\ud560 \uc218 \uc788\ub294 \uc2e4\uc218\ub97c \ud754\ud788 \uc800\uc9c0\ub985\ub2c8\ub2e4. \ud754\ud55c \uc2e4\uc218\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. 1) **\uc870\uc900\ub825 \ubd80\uc871** \u2013 \uc911\ub825\uacfc \ubc14\ub78c\uc744 \uace0\ub824\ud558\uc9c0 \uc54a\uc544 \uc0ac\uaca9\uc744 \ub193\uce69\ub2c8\ub2e4. 2) **\uc790\uc6d0 \uad00\ub9ac \ubbf8\ud761** \u2013 \uc6b0\uc120\uc21c\uc704\uac00 \ub0ae\uc740 \ub300\uc0c1\uc5d0 \ud0c4\uc57d\uc744 \ub0ad\ube44\ud569\ub2c8\ub2e4. 3) **\uc5c4\ud3d0\ubb3c \ubb34\uc2dc** \u2013 \ud658\uacbd \ubcf4\ud638\ub97c \uc0ac\uc6a9\ud558\uc9c0 \uc54a\uc544 \ubd88\ud544\uc694\ud55c \ud53c\ud574\ub97c \uc785\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc2e4\uc218\ub97c \ud53c\ud558\ub824\uba74 \uc11c\ub85c \ub2e4\ub978 \uac01\ub3c4\ub85c \uc870\uc900 \uc5f0\uc2b5\uc744 \ud558\uace0, \uac00\uce58\uac00 \ub192\uc740 \ub300\uc0c1\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \ud0c0\uac9f\ud305\ud558\uace0, \ud56d\uc0c1 \uc5c4\ud3d0\ubb3c\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud53c\ud574\ub97c \ucd5c\uc18c\ud654\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 5\uc5d0\uc11c \ubaa9\uc7ac \ud310\uc790\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc801\uc758 \uacf5\uaca9\uc73c\ub85c\ubd80\ud130 \uc790\uc2e0\uc744 \ubcf4\ud638\ud558\uba74\uc11c \uc815\ud655\ud55c \uc0ac\uaca9\uc744 \uac00\ud569\ub2c8\ub2e4."}, {"question": "\ub77c\ud504\ud2b8 \uc6cc\uc988 2\uc758 \ud658\uacbd \uc694\uc18c\ub294 \uc804\ub7b5\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\uba70, \ud6a8\uacfc\uc801\uc778 \ud65c\uc6a9 \uc0ac\ub840\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub77c\ud504\ud2b8 \uc6cc\uc988 2\uc758 \ud658\uacbd \uc694\uc18c\ub294 \uc7a5\uc560\ubb3c\uacfc \uae30\ud68c\ub97c \uc81c\uacf5\ud558\uc5ec \uc804\ub7b5\uc5d0 \uc0c1\ub2f9\ud55c \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc8fc\uc694 \uc694\uc18c\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. 1) **\uc0c1\uc790** \u2013 \ucf54\uc778\uc744 \uc5bb\uac70\ub098 \uc5c4\ud3d0\ubb3c\ub85c \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 2) **\ubb3c** \u2013 \ud504\ub85c\uc81d\ud0c0\uc77c \uada4\uc801\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ubb3c \uc704\ub85c \uc0ac\uaca9\ud560 \ub54c\ub294 \ub192\uac8c \uc870\uc900\ud569\ub2c8\ub2e4. 3) **\ud3ed\ubc1c\uc131 \ud1b5** \u2013 \uadfc\ucc98\uc758 \uc801\uc5d0\uac8c \ub300\ub7c9\uc758 \ud53c\ud574\ub97c \uc785\ud790 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 12\uc5d0\uc11c \ud3ed\ubc1c\uc131 \ud1b5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc5ec\ub7ec \uba85\uc758 \uc801\uc744 \ud55c\uaebc\ubc88\uc5d0 \uc81c\uac70\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc694\uc18c\ub97c \uc774\ud574\ud558\uace0 \ud65c\uc6a9\ud558\uba74 \ub354\uc6b1 \uc804\ub7b5\uc801\uc774\uace0 \ud6a8\uc728\uc801\uc778 \uac8c\uc784\ud50c\ub808\uc774\uac00 \uac00\ub2a5\ud569\ub2c8\ub2e4."}]
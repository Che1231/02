[{"question": "\u5982\u4f55\u63a7\u5236\u6211\u5728\u7b4f\u62302\u4e2d\u7684\u5f48\u9053\uff0c\u4ee5\u53ca\u9700\u8981\u638c\u63e1\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u5728\u7b4f\u62302\u4e2d\uff0c\u63a7\u5236\u4f60\u7684\u5f48\u9053\u5c0d\u65bc\u6210\u529f\u81f3\u95dc\u91cd\u8981\u3002\u57fa\u672c\u64cd\u4f5c\u5305\u62ec\u9ede\u64ca\u4e26\u6309\u4f4f\u7784\u6e96\uff0c\u7136\u5f8c\u9b06\u958b\u767c\u5c04\u3002\u8981\u638c\u63e1\u9019\u4e00\u9ede\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u5c07\u4f60\u7684\u89d2\u8272\u9762\u5411\u76ee\u6a19\u3002\u6b65\u9a5f2 - \u9ede\u64ca\u4e26\u6309\u4f4f\u4ee5\u986f\u793a\u7784\u6e96\u7dda\u3002\u6b65\u9a5f3 - \u900f\u904e\u5411\u4e0a\u6216\u5411\u4e0b\u79fb\u52d5\u624b\u6307\u4f86\u8abf\u6574\u89d2\u5ea6\u548c\u529b\u91cf\uff0c\u7136\u5f8c\u9b06\u958b\u767c\u5c04\u3002\u4f8b\u5982\uff0c\u7576\u7784\u6e96\u4f4d\u65bc\u8f03\u9ad8\u5e73\u53f0\u4e0a\u7684\u6575\u4eba\u6642\uff0c\u70ba\u8003\u616e\u91cd\u529b\uff0c\u61c9\u7565\u5fae\u5411\u4e0a\u7784\u6e96\u3002\u6b64\u6280\u5de7\u78ba\u4fdd\u4f60\u7684\u5c04\u64ca\u6e96\u78ba\u6709\u6548\u3002"}, {"question": "\u5728\u7b4f\u62302\u4e2d\u64ca\u6557\u9996\u9818\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5982\u4f55\u70ba\u9019\u4e9b\u906d\u9047\u505a\u597d\u6e96\u5099\uff1f", "answer": "\u5728\u7b4f\u62302\u4e2d\u64ca\u6557\u9996\u9818\u9700\u8981\u7b56\u7565\u548c\u6e96\u5099\u7684\u7d50\u5408\u3002\u9019\u88e1\u6709\u4e00\u500b\u5206\u6b65\u65b9\u6cd5\uff1a\u6b65\u9a5f1 - \u5728\u6230\u9b25\u524d\u5148\u5132\u5099\u5f37\u529b\u7684\u6b66\u5668\uff0c\u4f8b\u5982\u69b4\u5f48\u767c\u5c04\u5668\u6216\u706b\u7bad\u767c\u5c04\u5668\u3002\u6b65\u9a5f2 - \u7814\u7a76\u9996\u9818\u7684\u653b\u64ca\u6a21\u5f0f\uff1b\u4f8b\u5982\uff0c\u6d77\u76dc\u738b\u7d93\u5e38\u4ee5\u53ef\u9810\u6e2c\u7684\u5f27\u7dda\u6295\u64f2\u70b8\u5f48\u3002\u6b65\u9a5f3 - \u7784\u6e96\u5f31\u9ede\uff0c\u4f8b\u5982\u6d77\u76dc\u738b\u7684\u5e3d\u5b50\uff0c\u53ef\u9020\u6210\u984d\u5916\u50b7\u5bb3\u3002\u6b64\u5916\uff0c\u78ba\u4fdd\u4f60\u7684\u751f\u547d\u503c\u6700\u5927\u5316\uff0c\u4e26\u6709\u6548\u5730\u4f7f\u7528\u63a9\u9ad4\u4ee5\u907f\u514d\u4e0d\u5fc5\u8981\u7684\u50b7\u5bb3\u3002\u6b64\u6e96\u5099\u5c07\u986f\u8457\u63d0\u9ad8\u4f60\u7684\u52dd\u5229\u6a5f\u7387\u3002"}, {"question": "\u7b4f\u62302\u4e2d\u7684\u6b66\u5668\u5347\u7d1a\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff0c\u54ea\u4e9b\u5347\u7d1a\u5c0d\u65bc\u65b0\u624b\u4f86\u8aaa\u6700\u6709\u50f9\u503c\uff1f", "answer": "\u7b4f\u62302\u4e2d\u7684\u6b66\u5668\u5347\u7d1a\u7cfb\u7d71\u5141\u8a31\u73a9\u5bb6\u5f37\u5316\u4ed6\u5011\u7684\u6b66\u5668\u5eab\uff0c\u4ee5\u4fbf\u9032\u884c\u66f4\u6709\u6548\u7684\u6230\u9b25\u3002\u5347\u7d1a\u53ef\u4ee5\u7528\u5f9e\u5b8c\u6210\u7b49\u7d1a\u7372\u5f97\u7684\u786c\u5e63\u8cfc\u8cb7\u3002\u5c0d\u65bc\u65b0\u624b\u4f86\u8aaa\uff0c\u6700\u6709\u50f9\u503c\u7684\u5347\u7d1a\u5305\u62ec\uff1a1) **\u50b7\u5bb3\u63d0\u5347** - \u6bcf\u767c\u5b50\u5f48\u9020\u6210\u66f4\u591a\u50b7\u5bb3\uff0c\u81f3\u95dc\u91cd\u8981\u30022) **\u5f48\u85e5\u5bb9\u91cf** - \u5728\u91cd\u65b0\u88dd\u586b\u4e4b\u524d\u53ef\u4ee5\u767c\u5c04\u66f4\u591a\u5b50\u5f48\u30023) **\u6e96\u78ba\u5ea6\u63d0\u5347** - \u63d0\u9ad8\u4f60\u7684\u5c04\u64ca\u6e96\u78ba\u5ea6\u3002\u4f8b\u5982\uff0c\u53ca\u65e9\u5347\u7d1a\u5f48\u5f13\u7684\u50b7\u5bb3\u503c\uff0c\u53ef\u4ee5\u5e6b\u52a9\u4f60\u66f4\u5feb\u5730\u64ca\u6557\u6575\u4eba\u3002\u512a\u5148\u5347\u7d1a\u9019\u4e9b\u5347\u7d1a\uff0c\u8b93\u904a\u6232\u8b8a\u5f97\u66f4\u6613\u65bc\u63a7\u5236\u548c\u4eab\u53d7\u3002"}, {"question": "\u7b4f\u62302\u4e2d\u53ef\u7528\u7684\u6b66\u5668\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5982\u4f55\u70ba\u6bcf\u500b\u7d1a\u5225\u9078\u64c7\u6b63\u78ba\u7684\u6b66\u5668\uff1f", "answer": "\u5728 Raft Wars 2 \u4e2d\uff0c\u6bcf\u7a2e\u6b66\u5668\u90fd\u6709\u5176\u7368\u7279\u7684\u7279\u6027\uff0c\u4f7f\u5176\u9069\u7528\u65bc\u4e0d\u540c\u7684\u5834\u666f\u3002\u4ee5\u4e0b\u662f\u4e00\u4e9b\u6bd4\u8f03\uff1a1) **\u5f48\u5f13** - \u521d\u7d1a\u6b66\u5668\uff0c\u6700\u9069\u5408\u65e9\u671f\u7b49\u7d1a\u30022) **\u69b4\u5f48\u767c\u5c04\u5668** - \u50b7\u5bb3\u9ad8\uff0c\u9069\u5408\u96c6\u4e2d\u6575\u4eba\u30023) **\u706b\u7bad\u767c\u5c04\u5668** - \u7206\u70b8\u529b\u5f37\uff0c\u9069\u5408\u64ca\u5012\u5f37\u6575\u3002\u8981\u9078\u64c7\u6b63\u78ba\u7684\u6b66\u5668\uff0c\u8acb\u8003\u616e\u7d1a\u5225\u7684\u4f48\u5c40\u548c\u6575\u4eba\u7684\u985e\u578b\u3002\u4f8b\u5982\uff0c\u5728\u6575\u4eba\u805a\u96c6\u5728\u4e00\u8d77\u7684\u7d1a\u5225\u4e2d\uff0c\u69b4\u5f48\u767c\u5c04\u5668\u6bd4\u5f48\u5f13\u66f4\u6709\u6548\u3002\u4e86\u89e3\u9019\u4e9b\u5dee\u7570\u80fd\u5e6b\u52a9\u4f60\u505a\u51fa\u6230\u7565\u6027\u6c7a\u5b9a\u4e26\u6709\u6548\u5730\u9032\u884c\u904a\u6232\u9032\u7a0b\u3002"}, {"question": "\u5982\u4f55\u5728\u7b4f\u62302\u4e2d\u512a\u5316\u6211\u7684\u8cc7\u6e90\u7ba1\u7406\uff0c\u4ee5\u78ba\u4fdd\u6211\u7e3d\u662f\u64c1\u6709\u8db3\u5920\u7684\u5f48\u85e5\u548c\u751f\u547d\u503c\uff1f", "answer": "\u5728\u7b4f\u62302\u4e2d\u512a\u5316\u8cc7\u6e90\u7ba1\u7406\u9700\u8981\u4ed4\u7d30\u7684\u898f\u5283\u548c\u6709\u6548\u5730\u5229\u7528\u53ef\u7528\u8cc7\u6e90\u3002\u65b9\u6cd5\u5982\u4e0b\uff1a\u6b65\u9a5f1 - \u59cb\u7d42\u7784\u6e96\u6575\u4eba\u7684\u982d\u90e8\u6216\u5f31\u9ede\u4ee5\u7bc0\u7d04\u5f48\u85e5\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u63a9\u9ad4\u4f86\u6700\u5927\u7a0b\u5ea6\u5730\u6e1b\u5c11\u751f\u547d\u503c\u640d\u5931\uff1b\u4f8b\u5982\uff0c\u8eb2\u5728\u7bb1\u5b50\u5f8c\u9762\u4f86\u907f\u958b\u6575\u4eba\u7684\u706b\u529b\u3002\u6b65\u9a5f3 - \u5f9e\u88ab\u64ca\u6557\u7684\u6575\u4eba\u548c\u53ef\u7834\u58de\u7684\u7269\u4ef6\u6536\u96c6\u786c\u5e63\u548c\u751f\u547d\u85e5\u6c34\u3002\u6b64\u5916\uff0c\u512a\u5148\u5347\u7d1a\u5f48\u85e5\u5bb9\u91cf\u548c\u751f\u547d\u503c\u6062\u5fa9\uff0c\u4ee5\u7dad\u6301\u66f4\u9577\u6642\u9593\u7684\u6230\u9b25\u3002\u6b64\u7b56\u7565\u80fd\u78ba\u4fdd\u4f60\u59cb\u7d42\u70ba\u5373\u5c07\u9762\u81e8\u7684\u6311\u6230\u505a\u597d\u6e96\u5099\u3002"}, {"question": "\u7b4f\u62302\u4e2d\u6709\u4ec0\u9ebc\u96b1\u85cf\u7684\u79d8\u5bc6\u6216\u5f69\u86cb\uff0c\u5927\u591a\u6578\u73a9\u5bb6\u53ef\u80fd\u6703\u932f\u904e\uff1f", "answer": "\u7b4f\u62302\u5145\u6eff\u4e86\u96b1\u85cf\u7684\u79d8\u5bc6\u548c\u5f69\u86cb\uff0c\u589e\u6dfb\u4e86\u904a\u6232\u7684\u9b45\u529b\u3002\u4e00\u500b\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f**\u91d1\u8272\u9b5a**\uff0c\u53ef\u4ee5\u901a\u904e\u5728\u7279\u5b9a\u7d1a\u5225\u5c04\u64ca\u7279\u5b9a\u9ede\u4f86\u627e\u5230\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 10 \u7d1a\uff0c\u7784\u6e96\u87a2\u5e55\u53f3\u4e0a\u89d2\u624d\u80fd\u767c\u73fe\u91d1\u8272\u9b5a\uff0c\u5b83\u6703\u8d08\u9001\u984d\u5916\u786c\u5e63\u3002\u53e6\u4e00\u500b\u79d8\u5bc6\u662f\u7b2c 15 \u7d1a\u7684**\u96b1\u85cf\u6d1e\u7a74**\uff0c\u901a\u904e\u6467\u6bc0\u770b\u4f3c\u5805\u4e0d\u53ef\u6467\u7684\u5ca9\u77f3\u624d\u80fd\u901a\u8def\u3002\u63a2\u7d22\u9019\u4e9b\u96b1\u85cf\u5143\u7d20\u4e0d\u50c5\u6703\u63d0\u4f9b\u734e\u52f5\uff0c\u9084\u6703\u589e\u5f37\u6574\u9ad4\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u7b4f\u62302\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u5982\u4f55\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff0c\u73a9\u5bb6\u61c9\u8a72\u77e5\u9053\u54ea\u4e9b\u65b9\u9762\uff1f", "answer": "\u7b4f\u62302\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u5728\u904a\u6232\u73a9\u6cd5\u4e2d\u626e\u6f14\u8457\u91cd\u8981\u89d2\u8272\uff0c\u5f71\u97ff\u8457\u5f48\u9053\u7684\u8ecc\u8de1\u548c\u74b0\u5883\u4ea4\u4e92\u3002\u95dc\u9375\u65b9\u9762\u5305\u62ec\uff1a1) **\u91cd\u529b** - \u5f71\u97ff\u5f48\u9053\u5f27\u5ea6\uff1b\u89d2\u5ea6\u8d8a\u9ad8\uff0c\u5f27\u5ea6\u8d8a\u9661\u30022) **\u98a8** - \u80fd\u6539\u8b8a\u4f60\u7684\u5c04\u64ca\u8def\u5f91\uff1b\u61c9\u76f8\u61c9\u8abf\u6574\u7784\u6e96\u30023) **\u78b0\u649e** - \u50cf\u7bb1\u5b50\u9019\u6a23\u7684\u7269\u9ad4\u53ef\u4ee5\u963b\u64cb\u6216\u6539\u8b8a\u5f48\u9053\u7684\u65b9\u5411\u3002\u4f8b\u5982\uff0c\u7576\u5728\u4e00\u500b\u5927\u9593\u9694\u4e0a\u5c04\u64ca\u6642\uff0c\u61c9\u8003\u616e\u91cd\u529b\uff0c\u56e0\u6b64\u9700\u8981\u7565\u5fae\u5411\u4e0a\u7784\u6e96\u3002\u4e86\u89e3\u9019\u4e9b\u7269\u7406\u539f\u7406\u53ef\u4ee5\u5e6b\u52a9\u73a9\u5bb6\u66f4\u6e96\u78ba\u5730\u5c04\u64ca\u4e26\u6709\u6548\u5730\u5236\u5b9a\u7b56\u7565\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5c07\u6211\u7684\u7b4f\u62302\u904a\u6232\u9032\u5ea6\u8f49\u79fb\u5230\u4e0d\u540c\u7684\u88dd\u7f6e\u4e0a\u55ce\uff1f\u6b64\u904e\u7a0b\u5982\u4f55\u8655\u7406\uff1f", "answer": "\u5c07\u4f60\u7684\u7b4f\u62302\u904a\u6232\u9032\u5ea6\u8f49\u79fb\u5230\u4e0d\u540c\u7684\u8a2d\u5099\u4e0a\u662f\u53ef\u80fd\u7684\uff0c\u4f46\u9700\u8981\u5e7e\u500b\u6b65\u9a5f\u3002\u9996\u5148\uff0c\u78ba\u4fdd\u4f60\u5728\u5169\u500b\u8a2d\u5099\u4e0a\u90fd\u767b\u5165\u4e86\u540c\u4e00\u500b\u5e33\u6236\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728 Android \u4e0a\u4f7f\u7528 Google Play \u5e33\u6236\uff0c\u8acb\u5728\u65b0\u8a2d\u5099\u4e0a\u767b\u5165\u3002\u63a5\u4e0b\u4f86\uff0c\u900f\u904e\u904a\u6232\u8a2d\u5b9a\u4e2d\u53ef\u7528\u7684\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u540c\u6b65\u4f60\u7684\u904a\u6232\u8cc7\u6599\u3002\u9019\u500b\u904e\u7a0b\u78ba\u4fdd\u4f60\u7684\u9032\u5ea6\uff0c\u5305\u62ec\u5b8c\u6210\u7684\u7b49\u7d1a\u548c\u8cfc\u8cb7\u7684\u5347\u7d1a\uff0c\u6703\u9806\u5229\u5730\u8f49\u79fb\u904e\u53bb\u3002\u5728\u66f4\u63db\u8a2d\u5099\u4e4b\u524d\uff0c\u8acb\u52d9\u5fc5\u5099\u4efd\u4f60\u7684\u8cc7\u6599\uff0c\u4ee5\u907f\u514d\u4efb\u4f55\u640d\u5931\u3002"}, {"question": "\u65b0\u624b\u73a9\u5bb6\u5728\u7b4f\u62302\u4e2d\u6700\u5e38\u72af\u7684\u932f\u8aa4\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5982\u4f55\u907f\u514d\u9019\u4e9b\u932f\u8aa4\uff1f", "answer": "\u7b4f\u62302\u7684\u65b0\u624b\u73a9\u5bb6\u7d93\u5e38\u72af\u4e00\u4e9b\u6703\u963b\u7919\u4ed6\u5011\u9032\u5c55\u7684\u932f\u8aa4\u3002\u5e38\u898b\u7684\u9677\u9631\u5305\u62ec\uff1a1) **\u7784\u6e96\u4e0d\u6e96** - \u672a\u8003\u616e\u91cd\u529b\u548c\u98a8\uff0c\u5c0e\u81f4\u5c04\u5931\u30022) **\u8cc7\u6e90\u7ba1\u7406\u4e0d\u7576** - \u6d6a\u8cbb\u5f48\u85e5\u5728\u4f4e\u512a\u5148\u7d1a\u76ee\u6a19\u4e0a\u30023) **\u5ffd\u8996\u63a9\u9ad4** - \u900f\u904e\u4e0d\u4f7f\u7528\u74b0\u5883\u4fdd\u8b77\u4f86\u627f\u53d7\u4e0d\u5fc5\u8981\u7684\u50b7\u5bb3\u3002\u8981\u907f\u514d\u9019\u4e9b\u932f\u8aa4\uff0c\u8acb\u7df4\u7fd2\u5404\u7a2e\u89d2\u5ea6\u7684\u7784\u6e96\u3001\u512a\u5148\u8003\u616e\u9ad8\u50f9\u503c\u76ee\u6a19\uff0c\u4e26\u59cb\u7d42\u4f7f\u7528\u63a9\u9ad4\u4f86\u6700\u5927\u7a0b\u5ea6\u5730\u6e1b\u5c11\u640d\u5931\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 5 \u7d1a\uff0c\u4f7f\u7528\u6728\u677f\u4f86\u4fdd\u8b77\u81ea\u5df1\u514d\u53d7\u6575\u4eba\u706b\u529b\u7684\u50b7\u5bb3\uff0c\u540c\u6642\u9032\u884c\u7cbe\u78ba\u7684\u5c04\u64ca\u3002"}, {"question": "\u7b4f\u62302\u4e2d\u7684\u74b0\u5883\u5143\u7d20\u5982\u4f55\u5f71\u97ff\u7b56\u7565\uff0c\u4ee5\u53ca\u4e00\u4e9b\u6709\u6548\u7684\u904b\u7528\u7bc4\u4f8b\uff1f", "answer": "\u7b4f\u62302\u4e2d\u7684\u74b0\u5883\u5143\u7d20\u6703\u986f\u8457\u5730\u5f71\u97ff\u7b56\u7565\uff0c\u56e0\u70ba\u5b83\u5011\u63d0\u4f9b\u4e86\u969c\u7919\u548c\u6a5f\u6703\u3002\u95dc\u9375\u5143\u7d20\u5305\u62ec\uff1a1) **\u7bb1\u5b50** - \u53ef\u4ee5\u88ab\u6467\u6bc0\u4ee5\u7372\u5f97\u786c\u5e63\u6216\u7528\u4f5c\u63a9\u9ad4\u30022) **\u6c34** - \u5f71\u97ff\u5f48\u9053\u7684\u8ecc\u8de1\uff1b\u7576\u5c04\u64ca\u8d85\u904e\u6c34\u6642\uff0c\u8981\u7784\u6e96\u5f97\u66f4\u9ad8\u30023) **\u70b8\u5f48\u6876** - \u53ef\u4ee5\u89f8\u767c\u5c0d\u9644\u8fd1\u6575\u4eba\u9020\u6210\u5de8\u5927\u50b7\u5bb3\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 12 \u7d1a\uff0c\u53ef\u4ee5\u4f7f\u7528\u70b8\u5f48\u6876\u4e00\u6b21\u6027\u6e05\u9664\u591a\u500b\u6575\u4eba\u3002\u4e86\u89e3\u548c\u5229\u7528\u9019\u4e9b\u5143\u7d20\u53ef\u4ee5\u8b93\u904a\u6232\u73a9\u6cd5\u66f4\u5177\u7b56\u7565\u6027\u548c\u6548\u7387\u3002"}]
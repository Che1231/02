[{"question": "\u5982\u4f55\u5728\u300a\u7b4f\u62182\u300b\u4e2d\u63a7\u5236\u6211\u7684\u6295\u5c04\u7269\u8f68\u8ff9\uff0c\u4ee5\u53ca\u9700\u8981\u638c\u63e1\u54ea\u4e9b\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u5728\u300a\u7b4f\u62182\u300b\u4e2d\uff0c\u63a7\u5236\u6295\u5c04\u7269\u8f68\u8ff9\u5bf9\u4e8e\u53d6\u5f97\u6210\u529f\u81f3\u5173\u91cd\u8981\u3002\u57fa\u672c\u64cd\u4f5c\u5305\u62ec\u70b9\u51fb\u5e76\u6309\u4f4f\u8fdb\u884c\u7784\u51c6\uff0c\u7136\u540e\u677e\u5f00\u8fdb\u884c\u5c04\u51fb\u3002\u8981\u638c\u63e1\u8fd9\u4e00\u70b9\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u5c06\u89d2\u8272\u9762\u5411\u76ee\u6807\u3002\u6b65\u9aa42 - \u70b9\u51fb\u5e76\u6309\u4f4f\u4ee5\u663e\u793a\u7784\u51c6\u7ebf\u3002\u6b65\u9aa43 - \u901a\u8fc7\u4e0a\u4e0b\u79fb\u52a8\u624b\u6307\u6765\u8c03\u6574\u89d2\u5ea6\u548c\u529b\u91cf\uff0c\u7136\u540e\u677e\u5f00\u8fdb\u884c\u5c04\u51fb\u3002\u4f8b\u5982\uff0c\u5f53\u76ee\u6807\u662f\u4f4d\u4e8e\u8f83\u9ad8\u5e73\u53f0\u4e0a\u7684\u654c\u4eba\u65f6\uff0c\u4e3a\u4e86\u62b5\u6d88\u91cd\u529b\u6548\u5e94\uff0c\u8bf7\u7a0d\u5fae\u5411\u4e0a\u7784\u51c6\u3002\u6b64\u6280\u5de7\u53ef\u786e\u4fdd\u60a8\u7684\u5c04\u51fb\u7cbe\u51c6\u6709\u6548\u3002"}, {"question": "\u5728\u300a\u7b4f\u62182\u300b\u4e2d\u51fb\u8d25\u9996\u9886\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5982\u4f55\u4e3a\u8fd9\u4e9b\u906d\u9047\u505a\u597d\u51c6\u5907\uff1f", "answer": "\u5728\u300a\u7b4f\u62182\u300b\u4e2d\u51fb\u8d25\u9996\u9886\u9700\u8981\u7ed3\u5408\u7b56\u7565\u548c\u51c6\u5907\u3002\u4ee5\u4e0b\u662f\u4e00\u6b65\u4e00\u6b65\u7684\u65b9\u6cd5\uff1a\u6b65\u9aa41 - \u5728\u6218\u6597\u524d\uff0c\u50a8\u5907\u5f3a\u5927\u7684\u6b66\u5668\uff0c\u4f8b\u5982\u69b4\u5f39\u53d1\u5c04\u5668\u6216\u706b\u7bad\u53d1\u5c04\u5668\u3002\u6b65\u9aa42 - \u7814\u7a76\u9996\u9886\u7684\u653b\u51fb\u6a21\u5f0f\uff1b\u4f8b\u5982\uff0c\u6d77\u76d7\u738b\u7ecf\u5e38\u4ee5\u53ef\u9884\u6d4b\u7684\u5f27\u7ebf\u6295\u63b7\u70b8\u5f39\u3002\u6b65\u9aa43 - \u7784\u51c6\u5f31\u70b9\uff0c\u4f8b\u5982\u6d77\u76d7\u738b\u7684\u5e3d\u5b50\uff0c\u53ef\u4ee5\u9020\u6210\u989d\u5916\u4f24\u5bb3\u3002\u6b64\u5916\uff0c\u786e\u4fdd\u60a8\u7684\u751f\u547d\u503c\u8fbe\u5230\u6700\u5927\u503c\uff0c\u5e76\u6709\u6548\u5730\u5229\u7528\u63a9\u4f53\u4ee5\u907f\u514d\u4e0d\u5fc5\u8981\u7684\u4f24\u5bb3\u3002\u8fd9\u79cd\u51c6\u5907\u5c06\u6781\u5927\u5730\u63d0\u9ad8\u60a8\u7684\u83b7\u80dc\u51e0\u7387\u3002"}, {"question": "\u300a\u7b4f\u62182\u300b\u4e2d\u7684\u6b66\u5668\u5347\u7ea7\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u54ea\u4e9b\u5347\u7ea7\u5bf9\u4e8e\u65b0\u624b\u6765\u8bf4\u6700\u6709\u4ef7\u503c\uff1f", "answer": "\u300a\u7b4f\u62182\u300b\u4e2d\u7684\u6b66\u5668\u5347\u7ea7\u7cfb\u7edf\u5141\u8bb8\u73a9\u5bb6\u589e\u5f3a\u4ed6\u4eec\u7684\u6b66\u5668\u5e93\uff0c\u4ee5\u8fdb\u884c\u66f4\u6709\u6548\u7684\u6218\u6597\u3002\u5347\u7ea7\u53ef\u4ee5\u4f7f\u7528\u4ece\u5b8c\u6210\u5173\u5361\u83b7\u5f97\u7684\u786c\u5e01\u8d2d\u4e70\u3002\u5bf9\u4e8e\u65b0\u624b\u6765\u8bf4\uff0c\u6700\u6709\u4ef7\u503c\u7684\u5347\u7ea7\u5305\u62ec\uff1a1) **\u4f24\u5bb3\u63d0\u5347** - \u5bf9\u4e8e\u6bcf\u53d1\u5b50\u5f39\u9020\u6210\u66f4\u591a\u4f24\u5bb3\u81f3\u5173\u91cd\u8981\u30022) **\u5f39\u836f\u5bb9\u91cf** - \u5728\u91cd\u65b0\u88c5\u586b\u524d\u53ef\u4ee5\u53d1\u5c04\u66f4\u591a\u5b50\u5f39\u30023) **\u7cbe\u5ea6\u63d0\u5347** - \u63d0\u9ad8\u60a8\u7684\u5c04\u51fb\u7cbe\u5ea6\u3002\u4f8b\u5982\uff0c\u65e9\u671f\u5347\u7ea7\u6295\u77f3\u7d22\u7684\u4f24\u5bb3\u53ef\u4ee5\u5e2e\u52a9\u60a8\u66f4\u5feb\u5730\u51fb\u8d25\u654c\u4eba\u3002\u4f18\u5148\u5347\u7ea7\u8fd9\u4e9b\u6b66\u5668\uff0c\u4ee5\u4f7f\u6e38\u620f\u66f4\u6613\u4e8e\u638c\u63a7\u548c\u4eab\u53d7\u3002"}, {"question": "\u300a\u7b4f\u62182\u300b\u4e2d\u5404\u79cd\u6b66\u5668\u4e4b\u95f4\u7684\u4e3b\u8981\u533a\u522b\u662f\u4ec0\u4e48\uff1f\u4ee5\u53ca\u5982\u4f55\u4e3a\u6bcf\u4e2a\u5173\u5361\u9009\u62e9\u5408\u9002\u7684\u6b66\u5668\uff1f", "answer": "\u5728\u300a\u7b4f\u62182\u300b\u4e2d\uff0c\u6bcf\u79cd\u6b66\u5668\u90fd\u6709\u72ec\u7279\u7684\u7279\u6027\uff0c\u4f7f\u5176\u9002\u7528\u4e8e\u4e0d\u540c\u7684\u573a\u666f\u3002\u4ee5\u4e0b\u662f\u4e00\u4e9b\u6bd4\u8f83\uff1a1) **\u6295\u77f3\u7d22** - \u57fa\u672c\u6b66\u5668\uff0c\u6700\u9002\u5408\u65e9\u671f\u5173\u5361\u30022) **\u69b4\u5f39\u53d1\u5c04\u5668** - \u9ad8\u4f24\u5bb3\uff0c\u975e\u5e38\u9002\u5408\u5bc6\u96c6\u654c\u4eba\u30023) **\u706b\u7bad\u53d1\u5c04\u5668** - \u7206\u70b8\u6027\u529b\u91cf\uff0c\u975e\u5e38\u9002\u5408\u6d88\u706d\u5f3a\u5927\u7684\u76ee\u6807\u3002\u8981\u9009\u62e9\u5408\u9002\u7684\u6b66\u5668\uff0c\u8bf7\u8003\u8651\u5173\u5361\u7684\u5e03\u5c40\u548c\u654c\u4eba\u7c7b\u578b\u3002\u4f8b\u5982\uff0c\u5728\u654c\u4eba\u805a\u96c6\u5728\u4e00\u8d77\u7684\u5173\u5361\u4e2d\uff0c\u69b4\u5f39\u53d1\u5c04\u5668\u7684\u6548\u679c\u6bd4\u6295\u77f3\u7d22\u66f4\u597d\u3002\u7406\u89e3\u8fd9\u4e9b\u533a\u522b\u6709\u52a9\u4e8e\u60a8\u505a\u51fa\u6218\u7565\u51b3\u7b56\u5e76\u6709\u6548\u5730\u53d6\u5f97\u8fdb\u5c55\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u7b4f\u62182\u300b\u4e2d\u4f18\u5316\u6211\u7684\u8d44\u6e90\u7ba1\u7406\uff0c\u4ee5\u786e\u4fdd\u6211\u59cb\u7ec8\u62e5\u6709\u8db3\u591f\u7684\u5f39\u836f\u548c\u751f\u547d\u503c\uff1f", "answer": "\u5728\u300a\u7b4f\u62182\u300b\u4e2d\u4f18\u5316\u8d44\u6e90\u7ba1\u7406\u9700\u8981\u4ed4\u7ec6\u7684\u8ba1\u5212\u548c\u6709\u6548\u5730\u5229\u7528\u53ef\u7528\u8d44\u6e90\u3002\u4ee5\u4e0b\u662f\u5982\u4f55\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u59cb\u7ec8\u7784\u51c6\u5934\u90e8\u6216\u5f31\u70b9\u4ee5\u8282\u7701\u5f39\u836f\u3002\u6b65\u9aa42 - \u5229\u7528\u63a9\u4f53\u6765\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u751f\u547d\u503c\u635f\u5931\uff1b\u4f8b\u5982\uff0c\u8eb2\u5728\u7bb1\u5b50\u540e\u9762\u4ee5\u907f\u514d\u654c\u4eba\u7684\u706b\u529b\u3002\u6b65\u9aa43 - \u4ece\u88ab\u6253\u8d25\u7684\u654c\u4eba\u548c\u53ef\u7834\u574f\u7269\u4f53\u4e2d\u6536\u96c6\u786c\u5e01\u548c\u751f\u547d\u836f\u5242\u3002\u6b64\u5916\uff0c\u4f18\u5148\u5347\u7ea7\u5f39\u836f\u5bb9\u91cf\u548c\u751f\u547d\u503c\u6062\u590d\u529f\u80fd\uff0c\u4ee5\u7ef4\u6301\u66f4\u957f\u7684\u6218\u6597\u3002\u6b64\u7b56\u7565\u53ef\u786e\u4fdd\u60a8\u59cb\u7ec8\u4e3a\u672a\u6765\u7684\u6311\u6218\u505a\u597d\u51c6\u5907\u3002"}, {"question": "\u300a\u7b4f\u62182\u300b\u4e2d\u9690\u85cf\u7684\u79d8\u5bc6\u6216\u5f69\u86cb\u6709\u54ea\u4e9b\uff0c\u5927\u591a\u6570\u73a9\u5bb6\u53ef\u80fd\u4f1a\u9519\u8fc7\uff1f", "answer": "\u300a\u7b4f\u62182\u300b\u5145\u6ee1\u4e86\u9690\u85cf\u7684\u79d8\u5bc6\u548c\u5f69\u86cb\uff0c\u589e\u6dfb\u4e86\u6e38\u620f\u7684\u9b45\u529b\u3002\u4e00\u4e2a\u663e\u7740\u7684\u5f69\u86cb\u662f**\u91d1\u9c7c**\uff0c\u53ef\u4ee5\u901a\u8fc7\u5c04\u51fb\u7279\u5b9a\u4f4d\u7f6e\u5728\u67d0\u4e9b\u5173\u5361\u4e2d\u627e\u5230\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 10 \u5173\uff0c\u7784\u51c6\u5c4f\u5e55\u53f3\u4e0a\u89d2\u53ef\u4ee5\u53d1\u73b0\u91d1\u9c7c\uff0c\u53ef\u4ee5\u83b7\u5f97\u989d\u5916\u786c\u5e01\u3002\u53e6\u4e00\u4e2a\u79d8\u5bc6\u662f\u7b2c 15 \u5173\u7684**\u9690\u85cf\u6d1e\u7a74**\uff0c\u53ef\u4ee5\u901a\u8fc7\u6467\u6bc1\u770b\u4f3c\u575a\u4e0d\u53ef\u6467\u7684\u5ca9\u77f3\u624d\u80fd\u8fdb\u5165\u3002\u63a2\u7d22\u8fd9\u4e9b\u9690\u85cf\u5143\u7d20\u4e0d\u4ec5\u53ef\u4ee5\u83b7\u5f97\u5956\u52b1\uff0c\u8fd8\u53ef\u4ee5\u589e\u5f3a\u6574\u4f53\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u300a\u7b4f\u62182\u300b\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\uff0c\u73a9\u5bb6\u5e94\u8be5\u4e86\u89e3\u54ea\u4e9b\u65b9\u9762\uff1f", "answer": "\u300a\u7b4f\u62182\u300b\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u5728\u6e38\u620f\u73a9\u6cd5\u4e2d\u8d77\u7740\u91cd\u8981\u4f5c\u7528\uff0c\u5f71\u54cd\u6295\u5c04\u7269\u7684\u8f68\u8ff9\u548c\u73af\u5883\u4e92\u52a8\u3002\u5173\u952e\u65b9\u9762\u5305\u62ec\uff1a1) **\u91cd\u529b** - \u5f71\u54cd\u6295\u5c04\u7269\u7684\u8f68\u8ff9\uff1b\u66f4\u5927\u7684\u89d2\u5ea6\u4f1a\u4ea7\u751f\u66f4\u9661\u5ced\u7684\u5f27\u7ebf\u30022) **\u98ce** - \u53ef\u4ee5\u6539\u53d8\u60a8\u7684\u5c04\u51fb\u8def\u5f84\uff1b\u76f8\u5e94\u5730\u8c03\u6574\u7784\u51c6\u30023) **\u78b0\u649e** - \u7bb1\u5b50\u7b49\u7269\u4f53\u53ef\u4ee5\u963b\u6321\u6216\u504f\u8f6c\u6295\u5c04\u7269\u3002\u4f8b\u5982\uff0c\u5f53\u5728\u5bbd\u9614\u7684\u7a7a\u5730\u4e0a\u5c04\u51fb\u65f6\uff0c\u8981\u8003\u8651\u5230\u91cd\u529b\uff0c\u9700\u8981\u7a0d\u5fae\u5411\u4e0a\u7784\u51c6\u3002\u7406\u89e3\u8fd9\u4e9b\u7269\u7406\u539f\u7406\u6709\u52a9\u4e8e\u73a9\u5bb6\u8fdb\u884c\u66f4\u7cbe\u51c6\u7684\u5c04\u51fb\u5e76\u6709\u6548\u5730\u5236\u5b9a\u7b56\u7565\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5728\u4e0d\u540c\u7684\u8bbe\u5907\u4e4b\u95f4\u8f6c\u79fb\u6211\u7684\u300a\u7b4f\u62182\u300b\u8fdb\u5ea6\u5417\uff1f\u8fd9\u4e2a\u8fc7\u7a0b\u662f\u5982\u4f55\u5904\u7406\u7684\uff1f", "answer": "\u5728\u4e0d\u540c\u7684\u8bbe\u5907\u4e4b\u95f4\u8f6c\u79fb\u60a8\u7684\u300a\u7b4f\u62182\u300b\u8fdb\u5ea6\u662f\u53ef\u80fd\u7684\uff0c\u4f46\u9700\u8981\u4e00\u4e9b\u6b65\u9aa4\u3002\u9996\u5148\uff0c\u786e\u4fdd\u60a8\u5728\u4e24\u53f0\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u8d26\u6237\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728 Android \u8bbe\u5907\u4e0a\u4f7f\u7528 Google Play \u8d26\u6237\uff0c\u8bf7\u5728\u65b0\u8bbe\u5907\u4e0a\u767b\u5f55\u3002\u63a5\u4e0b\u6765\uff0c\u901a\u8fc7\u6e38\u620f\u8bbe\u7f6e\u4e2d\u53ef\u7528\u7684\u4e91\u7aef\u4fdd\u5b58\u529f\u80fd\u540c\u6b65\u60a8\u7684\u6e38\u620f\u6570\u636e\u3002\u6b64\u8fc7\u7a0b\u786e\u4fdd\u60a8\u7684\u8fdb\u5ea6\uff0c\u5305\u62ec\u5df2\u5b8c\u6210\u7684\u5173\u5361\u548c\u8d2d\u4e70\u7684\u5347\u7ea7\uff0c\u53ef\u4ee5\u65e0\u7f1d\u5730\u8f6c\u79fb\u3002\u5728\u5207\u6362\u8bbe\u5907\u4e4b\u524d\uff0c\u8bf7\u52a1\u5fc5\u5907\u4efd\u60a8\u7684\u6570\u636e\uff0c\u4ee5\u907f\u514d\u4efb\u4f55\u635f\u5931\u3002"}, {"question": "\u65b0\u73a9\u5bb6\u5728\u300a\u7b4f\u62182\u300b\u4e2d\u6700\u5e38\u89c1\u7684\u9519\u8bef\u662f\u4ec0\u4e48\uff1f\u4ee5\u53ca\u5982\u4f55\u907f\u514d\u8fd9\u4e9b\u9519\u8bef\uff1f", "answer": "\u300a\u7b4f\u62182\u300b\u7684\u65b0\u73a9\u5bb6\u7ecf\u5e38\u4f1a\u72af\u9519\u8bef\uff0c\u53ef\u80fd\u4f1a\u963b\u788d\u4ed6\u4eec\u7684\u8fdb\u6b65\u3002\u5e38\u89c1\u7684\u9677\u9631\u5305\u62ec\uff1a1) **\u7784\u51c6\u4e0d\u51c6\u786e** - \u6ca1\u6709\u8003\u8651\u5230\u91cd\u529b\u548c\u98ce\uff0c\u5bfc\u81f4\u9519\u5931\u5c04\u51fb\u30022) **\u8d44\u6e90\u7ba1\u7406\u4e0d\u5f53** - \u5c06\u5f39\u836f\u6d6a\u8d39\u5728\u4f4e\u4f18\u5148\u7ea7\u76ee\u6807\u4e0a\u30023) **\u5ffd\u7565\u63a9\u4f53** - \u901a\u8fc7\u4e0d\u4f7f\u7528\u73af\u5883\u4fdd\u62a4\u63aa\u65bd\u800c\u9020\u6210\u4e0d\u5fc5\u8981\u7684\u4f24\u5bb3\u3002\u4e3a\u4e86\u907f\u514d\u8fd9\u4e9b\u9519\u8bef\uff0c\u8bf7\u7ec3\u4e60\u7528\u4e0d\u540c\u7684\u89d2\u5ea6\u7784\u51c6\uff0c\u4f18\u5148\u9009\u62e9\u9ad8\u4ef7\u503c\u76ee\u6807\uff0c\u5e76\u59cb\u7ec8\u4f7f\u7528\u63a9\u4f53\u6765\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u4f24\u5bb3\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 5 \u5173\u65f6\uff0c\u53ef\u4ee5\u4f7f\u7528\u6728\u677f\u63a9\u62a4\u81ea\u5df1\uff0c\u907f\u514d\u654c\u4eba\u7684\u706b\u529b\uff0c\u540c\u65f6\u8fdb\u884c\u7cbe\u786e\u5c04\u51fb\u3002"}, {"question": "\u300a\u7b4f\u62182\u300b\u4e2d\u7684\u73af\u5883\u8981\u7d20\u5982\u4f55\u5f71\u54cd\u7b56\u7565\uff0c\u4ee5\u53ca\u4e00\u4e9b\u6709\u6548\u7684\u5e94\u7528\u793a\u4f8b\uff1f", "answer": "\u300a\u7b4f\u62182\u300b\u4e2d\u7684\u73af\u5883\u8981\u7d20\u901a\u8fc7\u63d0\u4f9b\u969c\u788d\u548c\u673a\u9047\uff0c\u5bf9\u7b56\u7565\u4ea7\u751f\u91cd\u5927\u5f71\u54cd\u3002\u5173\u952e\u8981\u7d20\u5305\u62ec\uff1a1) **\u7bb1\u5b50** - \u53ef\u4ee5\u88ab\u6467\u6bc1\u4ee5\u83b7\u5f97\u786c\u5e01\u6216\u7528\u4f5c\u63a9\u4f53\u30022) **\u6c34** - \u5f71\u54cd\u5f39\u9053\uff1b\u5728\u5c04\u51fb\u6c34\u9762\u65f6\uff0c\u5e94\u7784\u51c6\u5f97\u66f4\u9ad8\u30023) **\u6613\u71c3\u6876** - \u53ef\u4ee5\u88ab\u89e6\u53d1\u4ee5\u5bf9\u9644\u8fd1\u7684\u654c\u4eba\u9020\u6210\u5de8\u5927\u4f24\u5bb3\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 12 \u5173\uff0c\u53ef\u4ee5\u4f7f\u7528\u6613\u71c3\u6876\u4e00\u6b21\u6027\u6e05\u9664\u591a\u4e2a\u654c\u4eba\u3002\u7406\u89e3\u548c\u5229\u7528\u8fd9\u4e9b\u8981\u7d20\u53ef\u4ee5\u4f7f\u6e38\u620f\u73a9\u6cd5\u66f4\u52a0\u6218\u7565\u6027\u548c\u9ad8\u6548\u6027\u3002"}]
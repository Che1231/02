\uff1a\u5c04\u6483\u306e\u8ecc\u9053\u3092\u5909\u66f4\u3057\u307e\u3059\u3002\u9069\u5207\u306b\u7167\u6e96\u3092\u5408\u308f\u305b\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u30023) \u885d\u7a81\uff1a\u6728\u7bb1\u306a\u3069\u306e\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306f\u3001\u5c04\u6483\u3092\u30d6\u30ed\u30c3\u30af\u3057\u305f\u308a\u3001\u65b9\u5411\u3092\u5909\u3048\u305f\u308a\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5927\u304d\u306a\u9699\u9593\u3092\u8d85\u3048\u3066\u5c04\u6483\u3059\u308b\u969b\u3001\u91cd\u529b\u3092\u8003\u616e\u3057\u3066\u5c11\u3057\u9ad8\u304f\u72d9\u3046\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u7269\u7406\u6cd5\u5247\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u6b63\u78ba\u306a\u5c04\u6483\u3092\u884c\u3044\u3001\u52b9\u679c\u7684\u306b\u6226\u7565\u3092\u7acb\u3066\u3089\u308c\u307e\u3059\u3002"}, {"question": "\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u9593\u3067Raft Wars 2\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u3053\u3068\u306f\u3067\u304d\u307e\u3059\u304b\uff1f\u305d\u306e\u30d7\u30ed\u30bb\u30b9\u306f\u3069\u306e\u3088\u3046\u306b\u51e6\u7406\u3055\u308c\u307e\u3059\u304b\uff1f", "answer": "\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u9593\u3067Raft Wars 2\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u3053\u3068\u306f\u53ef\u80fd\u3067\u3059\u3002\u3057\u304b\u3057\u3001\u3044\u304f\u3064\u304b\u306e\u624b\u9806\u304c\u5fc5\u8981\u3067\u3059\u3002\u307e\u305a\u3001\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001Android\u3067Google Play\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u4f7f\u7528\u3057\u3066\u3044\u308b\u5834\u5408\u3001\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u3082\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u6b21\u306b\u3001\u30b2\u30fc\u30e0\u306e\u8a2d\u5b9a\u306b\u3042\u308b\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u3001\u30b2\u30fc\u30e0\u30c7\u30fc\u30bf\u3092\u540c\u671f\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u30af\u30ea\u30a2\u3057\u305f\u30ec\u30d9\u30eb\u3084\u8cfc\u5165\u6e08\u307f\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306a\u3069\u3001\u3042\u306a\u305f\u306e\u9032\u884c\u72b6\u6cc1\u304c\u30b7\u30fc\u30e0\u30ec\u30b9\u306b\u8ee2\u9001\u3055\u308c\u307e\u3059\u3002\u30c7\u30d0\u30a4\u30b9\u3092\u5909\u66f4\u3059\u308b\u524d\u306b\u3001\u5fc5\u305a\u30c7\u30fc\u30bf\u3092\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u3057\u3066\u3001\u640d\u5931\u3092\u907f\u3051\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002"}, {"question": "Raft Wars 2\u3067\u3001\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u3088\u304f\u72af\u3059\u4e00\u822c\u7684\u306a\u30df\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u308c\u3089\u3092\u907f\u3051\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Raft Wars 2\u306e\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u9032\u6b69\u3092\u963b\u5bb3\u3059\u308b\u53ef\u80fd\u6027\u306e\u3042\u308b\u30df\u30b9\u3092\u72af\u3057\u304c\u3061\u3067\u3059\u3002\u4e00\u822c\u7684\u306a\u843d\u3068\u3057\u7a74\u306f\u4ee5\u4e0b\u306e\u3068\u304a\u308a\u3067\u3059\uff1a1\uff09\u7167\u6e96\u304c\u7518\u3044\uff1a\u91cd\u529b\u3084\u98a8\u306e\u5f71\u97ff\u3092\u8003\u616e\u305b\u305a\u3001\u7684\u3092\u5916\u3057\u3066\u3057\u307e\u3046\u30022\uff09\u8cc7\u6e90\u306e\u7ba1\u7406\u30df\u30b9\uff1a\u512a\u5148\u5ea6\u306e\u4f4e\u3044\u30bf\u30fc\u30b2\u30c3\u30c8\u306b\u5f3e\u85ac\u3092\u7121\u99c4\u9063\u3044\u3059\u308b\u30023\uff09\u30ab\u30d0\u30fc\u3092\u7121\u8996\u3059\u308b\uff1a\u74b0\u5883\u306e\u4fdd\u8b77\u3092\u5229\u7528\u305b\u305a\u3001\u4e0d\u8981\u306a\u30c0\u30e1\u30fc\u30b8\u3092\u53d7\u3051\u308b\u3002 \u3053\u308c\u3089\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u3001\u3055\u307e\u3056\u307e\u306a\u89d2\u5ea6\u3067\u7167\u6e96\u306e\u7df4\u7fd2\u3092\u884c\u3044\u3001\u9ad8\u4fa1\u5024\u306e\u30bf\u30fc\u30b2\u30c3\u30c8\u3092\u512a\u5148\u3057\u3001\u5e38\u306b\u30ab\u30d0\u30fc\u3092\u4f7f\u7528\u3057\u3066\u30c0\u30e1\u30fc\u30b8\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u308b\u3053\u3068\u304c\u5927\u5207\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb5\u3067\u306f\u3001\u6575\u306e\u653b\u6483\u304b\u3089\u8eab\u3092\u8b77\u308a\u306a\u304c\u3089\u6b63\u78ba\u306a\u5c04\u6483\u3092\u884c\u3046\u305f\u3081\u306b\u6728\u677f\u3092\u5229\u7528\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "Raft Wars 2\u306e\u74b0\u5883\u8981\u7d20\u306f\u3001\u6226\u7565\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f\u52b9\u679c\u7684\u306a\u4f7f\u7528\u65b9\u6cd5\u306e\u4f8b\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Raft Wars 2\u306e\u74b0\u5883\u8981\u7d20\u306f\u3001\u969c\u5bb3\u7269\u3068\u6a5f\u4f1a\u306e\u4e21\u65b9\u3092\u4e0e\u3048\u308b\u3053\u3068\u3067\u3001\u6226\u7565\u306b\u5927\u304d\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u4e3b\u306a\u8981\u7d20\u306f\u4ee5\u4e0b\u306e\u3068\u304a\u308a\u3067\u3059\uff1a1\uff09\u6728\u7bb1\uff1a\u30b3\u30a4\u30f3\u3092\u5f97\u308b\u305f\u3081\u306b\u7834\u58ca\u3059\u308b\u3053\u3068\u3082\u3001\u30ab\u30d0\u30fc\u3068\u3057\u3066\u5229\u7528\u3059\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u30022\uff09\u6c34\uff1a\u5c04\u6483\u306e\u8ecc\u9053\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u6c34\u306e\u4e0a\u3092\u5c04\u6483\u3059\u308b\u3068\u304d\u306f\u3001\u3088\u308a\u9ad8\u3044\u4f4d\u7f6e\u3092\u72d9\u3046\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u30023\uff09\u7206\u767a\u6027\u306e\u6a3d\uff1a\u8fd1\u304f\u306e\u6575\u306b\u5927\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u305f\u3081\u306b\u7206\u767a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb12\u3067\u306f\u3001\u7206\u767a\u6027\u306e\u6a3d\u3092\u4f7f\u7528\u3057\u3066\u3001\u8907\u6570\u306e\u6575\u3092\u4e00\u6c17\u306b\u6392\u9664\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u8981\u7d20\u3092\u7406\u89e3\u3057\u3001\u6d3b\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u6226\u7565\u7684\u3067\u52b9\u7387\u7684\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u304c\u53ef\u80fd\u306b\u306a\u308a\u307e\u3059\u3002"}]
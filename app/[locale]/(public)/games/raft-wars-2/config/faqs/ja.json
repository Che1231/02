[{"question": "Raft Wars 2\u3067\u5c04\u6483\u8ecc\u9053\u3092\u3069\u306e\u3088\u3046\u306b\u5236\u5fa1\u3057\u3001\u30de\u30b9\u30bf\u30fc\u3059\u3079\u304d\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Raft Wars 2\u3067\u306f\u3001\u5c04\u6483\u8ecc\u9053\u3092\u5236\u5fa1\u3059\u308b\u3053\u3068\u306f\u6210\u529f\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u306b\u306f\u3001\u30bf\u30fc\u30b2\u30c3\u30c8\u3092\u5b9a\u3081\u308b\u305f\u3081\u306b\u30bf\u30c3\u30d7\u3057\u3066\u4fdd\u6301\u3057\u3001\u653e\u3057\u3066\u5c04\u6483\u3059\u308b\u3053\u3068\u306a\u3069\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u3053\u308c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u30bf\u30fc\u30b2\u30c3\u30c8\u306b\u5411\u3051\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u7167\u6e96\u7dda\u3092\u8868\u793a\u3059\u308b\u305f\u3081\u306b\u30bf\u30c3\u30d7\u3057\u3066\u4fdd\u6301\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6307\u3092\u4e0a\u4e0b\u306b\u52d5\u304b\u3059\u3053\u3068\u3067\u89d2\u5ea6\u3068\u529b\u3092\u8abf\u6574\u3057\u3001\u653e\u3057\u3066\u5c04\u6483\u3059\u308b\u3002\u305f\u3068\u3048\u3070\u3001\u3088\u308a\u9ad8\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u4e0a\u306e\u6575\u3092\u30bf\u30fc\u30b2\u30c3\u30c8\u306b\u3059\u308b\u5834\u5408\u306f\u3001\u91cd\u529b\u3092\u8003\u616e\u3057\u3066\u5c11\u3057\u9ad8\u304f\u7167\u6e96\u3092\u5408\u308f\u305b\u307e\u3059\u3002\u3053\u306e\u30c6\u30af\u30cb\u30c3\u30af\u306b\u3088\u308a\u3001\u5c04\u6483\u306f\u6b63\u78ba\u3067\u52b9\u679c\u7684\u3067\u3059\u3002"}, {"question": "Raft Wars 2\u3067\u30dc\u30b9\u3092\u5012\u3059\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u3053\u308c\u3089\u306e\u30a8\u30f3\u30ab\u30a6\u30f3\u30bf\u30fc\u306b\u3069\u306e\u3088\u3046\u306b\u5099\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Raft Wars 2\u3067\u30dc\u30b9\u3092\u5012\u3059\u306b\u306f\u3001\u6226\u7565\u3068\u6e96\u5099\u306e\u7d44\u307f\u5408\u308f\u305b\u304c\u5fc5\u8981\u3067\u3059\u3002\u624b\u9806\u306f\u4ee5\u4e0b\u306e\u3068\u304a\u308a\u3067\u3059\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u30b0\u30ec\u30cd\u30fc\u30c9\u30e9\u30f3\u30c1\u30e3\u30fc\u3084\u30ed\u30b1\u30c3\u30c8\u30e9\u30f3\u30c1\u30e3\u30fc\u306a\u3069\u306e\u5f37\u529b\u306a\u6b66\u5668\u3092\u30dc\u30b9\u6226\u306e\u524d\u306b\u7528\u610f\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30dc\u30b9\u306e\u653b\u6483\u30d1\u30bf\u30fc\u30f3\u3092\u7814\u7a76\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u6d77\u8cca\u738b\u306f\u4e88\u6e2c\u53ef\u80fd\u306a\u8ecc\u9053\u3067\u7206\u5f3e\u3092\u6295\u3052\u308b\u3053\u3068\u304c\u591a\u3044\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6d77\u8cca\u738b\u306e\u5e3d\u5b50\u306a\u3069\u306e\u5f31\u70b9\u306b\u72d9\u3044\u3092\u5b9a\u3081\u3001\u8ffd\u52a0\u306e\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u3002\u307e\u305f\u3001\u4f53\u529b\u306f\u6700\u5927\u9650\u306b\u56de\u5fa9\u3055\u305b\u3001\u9069\u5207\u306b\u30ab\u30d0\u30fc\u3092\u4f7f\u3063\u3066\u4e0d\u8981\u306a\u30c0\u30e1\u30fc\u30b8\u3092\u907f\u3051\u308b\u3002\u3053\u306e\u6e96\u5099\u306b\u3088\u308a\u3001\u52dd\u5229\u3059\u308b\u53ef\u80fd\u6027\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002"}, {"question": "Raft Wars 2\u306e\u6b66\u5668\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u521d\u5fc3\u8005\u306b\u3068\u3063\u3066\u3069\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u304c\u6700\u3082\u4fa1\u5024\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "Raft Wars 2\u306e\u6b66\u5668\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u30b7\u30b9\u30c6\u30e0\u3067\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3088\u308a\u52b9\u679c\u7684\u306a\u6226\u95d8\u306e\u305f\u3081\u306b\u6b66\u5668\u3092\u5f37\u5316\u3067\u304d\u307e\u3059\u3002\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u3001\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u3053\u3068\u3067\u7372\u5f97\u3067\u304d\u308b\u30b3\u30a4\u30f3\u3092\u4f7f\u7528\u3057\u3066\u8cfc\u5165\u3067\u304d\u307e\u3059\u3002\u521d\u5fc3\u8005\u306b\u3068\u3063\u3066\u3001\u6700\u3082\u4fa1\u5024\u306e\u3042\u308b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\uff1a1\uff09\u30c0\u30e1\u30fc\u30b8\u5897\u52a0\uff1a1\u767a\u5f53\u305f\u308a\u306e\u30c0\u30e1\u30fc\u30b8\u3092\u5897\u3084\u3059\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u30022\uff09\u5f3e\u85ac\u6570\uff1a\u518d\u88c5\u586b\u3059\u308b\u524d\u306b\u3088\u308a\u591a\u304f\u306e\u30b7\u30e7\u30c3\u30c8\u3092\u884c\u3046\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u30023\uff09\u6b63\u78ba\u6027\u5411\u4e0a\uff1a\u5c04\u6483\u306e\u7cbe\u5ea6\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u521d\u671f\u6bb5\u968e\u3067\u30b9\u30ea\u30f3\u30b0\u30b7\u30e7\u30c3\u30c8\u306e\u30c0\u30e1\u30fc\u30b8\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3068\u3001\u6575\u3092\u3088\u308a\u65e9\u304f\u5012\u3059\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u512a\u5148\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u3092\u3088\u308a\u7c21\u5358\u306b\u3001\u305d\u3057\u3066\u697d\u3057\u304f\u30d7\u30ec\u30a4\u3067\u304d\u307e\u3059\u3002"}, {"question": "Raft Wars 2\u3067\u5229\u7528\u53ef\u80fd\u306a\u6b66\u5668\u9593\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f\u3069\u306e\u30ec\u30d9\u30eb\u306b\u9069\u3057\u305f\u6b66\u5668\u3092\u9078\u629e\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Raft Wars 2\u3067\u306f\u3001\u5404\u6b66\u5668\u306f\u72ec\u7279\u306e\u7279\u6027\u3092\u6301\u3063\u3066\u304a\u308a\u3001\u3055\u307e\u3056\u307e\u306a\u72b6\u6cc1\u306b\u9069\u3057\u3066\u3044\u307e\u3059\u3002\u6bd4\u8f03\u306f\u4ee5\u4e0b\u306e\u3068\u304a\u308a\u3067\u3059\uff1a1\uff09\u30b9\u30ea\u30f3\u30b0\u30b7\u30e7\u30c3\u30c8\uff1a\u57fa\u672c\u7684\u306a\u6b66\u5668\u3067\u3001\u521d\u671f\u30ec\u30d9\u30eb\u306b\u6700\u9069\u3067\u3059\u30022\uff09\u30b0\u30ec\u30cd\u30fc\u30c9\u30e9\u30f3\u30c1\u30e3\u30fc\uff1a\u30c0\u30e1\u30fc\u30b8\u304c\u5927\u304d\u304f\u3001\u584a\u3067\u96c6\u307e\u3063\u3066\u3044\u308b\u6575\u306b\u6700\u9069\u3067\u3059\u30023\uff09\u30ed\u30b1\u30c3\u30c8\u30e9\u30f3\u30c1\u30e3\u30fc\uff1a\u7206\u767a\u529b\u304c\u5927\u304d\u304f\u3001\u5f37\u529b\u306a\u6575\u3092\u5012\u3059\u306e\u306b\u9069\u3057\u3066\u3044\u307e\u3059\u3002\u9069\u5207\u306a\u6b66\u5668\u3092\u9078\u629e\u3059\u308b\u306b\u306f\u3001\u30ec\u30d9\u30eb\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3068\u6575\u306e\u7a2e\u985e\u3092\u8003\u616e\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6575\u304c\u5bc6\u96c6\u3057\u3066\u3044\u308b\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30b9\u30ea\u30f3\u30b0\u30b7\u30e7\u30c3\u30c8\u3088\u308a\u3082\u30b0\u30ec\u30cd\u30fc\u30c9\u30e9\u30f3\u30c1\u30e3\u30fc\u306e\u65b9\u304c\u52b9\u679c\u7684\u3067\u3059\u3002\u3053\u308c\u3089\u306e\u9055\u3044\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u6226\u7565\u7684\u306a\u5224\u65ad\u3092\u4e0b\u3057\u3001\u52b9\u7387\u7684\u306b\u9032\u6b69\u3067\u304d\u307e\u3059\u3002"}, {"question": "Raft Wars 2\u3067\u8cc7\u6e90\u7ba1\u7406\u3092\u6700\u9069\u5316\u3057\u3066\u3001\u5e38\u306b\u5341\u5206\u306a\u5f3e\u85ac\u3068\u4f53\u529b\u3092\u6301\u7d9a\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Raft Wars 2\u3067\u8cc7\u6e90\u7ba1\u7406\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u7dbf\u5bc6\u306a\u8a08\u753b\u3068\u3001\u5229\u7528\u53ef\u80fd\u306a\u8cc7\u6e90\u306e\u52b9\u7387\u7684\u306a\u4f7f\u7528\u304c\u5fc5\u8981\u3067\u3059\u3002\u3084\u308a\u65b9\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u5e38\u306b\u30d8\u30c3\u30c9\u30b7\u30e7\u30c3\u30c8\u307e\u305f\u306f\u5f31\u70b9\u3092\u72d9\u3063\u3066\u5f3e\u85ac\u3092\u7bc0\u7d04\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30ab\u30d0\u30fc\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u4f53\u529b\u306e\u640d\u5931\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6575\u306e\u653b\u6483\u304b\u3089\u9003\u308c\u308b\u305f\u3081\u306b\u3001\u7269\u9670\u306b\u96a0\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5012\u3057\u305f\u6575\u3084\u58ca\u305b\u308b\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u304b\u3089\u30b3\u30a4\u30f3\u3084\u4f53\u529b\u56de\u5fa9\u30a2\u30a4\u30c6\u30e0\u3092\u53ce\u96c6\u3059\u308b\u3002\u3055\u3089\u306b\u3001\u3088\u308a\u9577\u3044\u6226\u95d8\u3092\u652f\u3048\u308b\u305f\u3081\u306b\u3001\u5f3e\u85ac\u306e\u5897\u52a0\u91cf\u3068\u4f53\u529b\u56de\u5fa9\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u512a\u5148\u3059\u308b\u3002\u3053\u306e\u6226\u7565\u306b\u3088\u308a\u3001\u5e38\u306b\u4eca\u5f8c\u306e\u8ab2\u984c\u306b\u5099\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Raft Wars 2\u3067\u3001\u307b\u3068\u3093\u3069\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u9003\u3057\u3066\u3057\u307e\u3046\u96a0\u3055\u308c\u305f\u79d8\u5bc6\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Raft Wars 2\u306b\u306f\u3001\u30b2\u30fc\u30e0\u306e\u9b45\u529b\u3092\u8db3\u3059\u96a0\u3055\u308c\u305f\u79d8\u5bc6\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u305f\u304f\u3055\u3093\u3042\u308a\u307e\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306e1\u3064\u306f\u3001\u7279\u5b9a\u306e\u5834\u6240\u306b\u
[{"question": "\u5766\u514b\u65b0\u73a9\u5bb6\u5982\u4f55\u5feb\u901f\u638c\u63e1\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1\u5766\u514b\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u719f\u6089\u79fb\u52a8\u952e\uff08WASD\uff09\u548c\u9f20\u6807\u7784\u51c6\u3002\u6b65\u9aa42 - \u7ec3\u4e60\u5c04\u51fb\u56fa\u5b9a\u76ee\u6807\uff0c\u611f\u53d7\u5766\u514b\u70ae\u5854\u7684\u6027\u80fd\u3002\u6b65\u9aa43 - \u5728\u6559\u7a0b\u4efb\u52a1\u4e2d\u8fd0\u7528\u8fd9\u4e9b\u6280\u5de7\uff0c\u5728\u53d7\u63a7\u73af\u5883\u4e2d\u5b9e\u8df5\u3002\u4f8b\u5982\uff0c\u5728\u201c\u9996\u6b21\u6253\u51fb\u201d\u4efb\u52a1\u4e2d\uff0c\u4f60\u5c06\u5b66\u4e60\u540c\u65f6\u8fdb\u884c\u5bfc\u822a\u548c\u5c04\u51fb\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c31\u50cf\u5b66\u4e60\u5f00\u8f66\u4e00\u6837\uff1b\u5148\u6162\u901f\u8fdb\u884c\uff0c\u7136\u540e\u518d\u9010\u6e10\u63d0\u9ad8\u901f\u5ea6\u548c\u590d\u6742\u6027\u3002]"}, {"question": "\u5728\u73a9\u5766\u514b100\u5c0f\u65f6\u540e\uff0c\u54ea\u4e9b\u662f\u8d62\u5f97\u6bd4\u8d5b\u7684\u5173\u952e\u7b56\u7565\uff1f", "answer": "100\u5c0f\u65f6\u540e\uff0c\u8bf7\u5173\u6ce8\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9aa41 - \u5730\u56fe\u610f\u8bc6\uff1a\u59cb\u7ec8\u4e86\u89e3\u5730\u5f62\uff0c\u5e76\u5c06\u5176\u4f5c\u4e3a\u4f18\u52bf\uff0c\u4f8b\u5982\u85cf\u5728\u4e18\u9675\u540e\u9762\u3002\u6b65\u9aa42 - \u56e2\u961f\u534f\u4f5c\uff1a\u4e0e\u961f\u53cb\u6c9f\u901a\uff0c\u4ee5\u4fa7\u7ffc\u653b\u51fb\u654c\u4eba\u6216\u9632\u5b88\u5173\u952e\u70b9\u3002\u6b65\u9aa43 - \u8d44\u6e90\u7ba1\u7406\uff1a\u5728\u5173\u952e\u65f6\u523b\u8282\u7ea6\u5f39\u836f\u548c\u533b\u7597\u5305\u3002\u4f8b\u5982\uff0c\u5728\u201c\u8981\u585e\u56f4\u653b\u201d\u5730\u56fe\u4e2d\uff0c\u5229\u7528\u9ad8\u5730\u53ef\u4ee5\u83b7\u5f97\u663e\u8457\u4f18\u52bf\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u6bd4\u8f83\u4e0d\u540c\u5766\u514b\u7c7b\u578b\u53ca\u5176\u5728\u5404\u79cd\u573a\u666f\u4e0b\u7684\u6700\u4f73\u7528\u9014\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u7406\u89e3\u5766\u514b\u7684\u4f24\u5bb3\u673a\u5236\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u7406\u89e3\u4f24\u5bb3\u673a\u5236\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u4f7f\u4f60\u80fd\u591f\u6700\u5927\u9650\u5ea6\u5730\u53d1\u6325\u6218\u6597\u4e2d\u7684\u6548\u529b\u3002\u4e0d\u540c\u7684\u5766\u514b\u5177\u6709\u4e0d\u540c\u7684\u88c5\u7532\u539a\u5ea6\u548c\u5f31\u70b9\u3002\u4f8b\u5982\uff0c\u51fb\u4e2d\u91cd\u578b\u5766\u514b\u7684\u540e\u90e8\u6bd4\u6b63\u9762\u653b\u51fb\u9020\u6210\u66f4\u591a\u4f24\u5bb3\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u7c7b\u578b\u7684\u5f39\u836f\uff0c\u4f8b\u5982\u7a7f\u7532\u5f39\uff08AP\uff09\u5bf9\u88c5\u7532\u76ee\u6807\u66f4\u6709\u6548\uff0c\u800c\u9ad8\u7206\u5f39\uff08HE\uff09\u5bf9\u8f6f\u76ee\u6807\u66f4\u597d\u3002[\u6d41\u7a0b\u56fe\u89e3: \u53ef\u89c6\u5316\u6765\u81ea\u4e0d\u540c\u89d2\u5ea6\u548c\u5f39\u836f\u7c7b\u578b\u7684\u4f24\u5bb3\u6d41\u3002]"}, {"question": "\u5728\u5766\u514b\u6e38\u620f\u4e2d\uff0c\u4e0d\u540c\u6218\u6597\u573a\u666f\u4e0b\u6211\u5e94\u8be5\u9009\u62e9\u54ea\u79cd\u5766\u514b\u7c7b\u578b\uff1f", "answer": "\u9009\u62e9\u6b63\u786e\u7684\u5766\u514b\u7c7b\u578b\u53d6\u51b3\u4e8e\u6218\u6597\u573a\u666f\uff1a\u8f7b\u578b\u5766\u514b\u975e\u5e38\u9002\u5408\u4fa6\u5bdf\u548c\u5feb\u901f\u7a81\u51fb\uff0c\u4e2d\u578b\u5766\u514b\u5728\u901f\u5ea6\u548c\u706b\u529b\u4e4b\u95f4\u53d6\u5f97\u5e73\u8861\uff0c\u91cd\u578b\u5766\u514b\u6700\u9002\u5408\u524d\u7ebf\u653b\u51fb\u3002\u4f8b\u5982\uff0c\u5728\u201c\u57ce\u5e02\u7a81\u88ad\u201d\u4e2d\uff0c\u4e2d\u578b\u5766\u514b\u53ef\u4ee5\u5728\u72ed\u7a84\u7a7a\u95f4\u5185\u8fdb\u884c\u673a\u52a8\uff0c\u540c\u65f6\u63d0\u4f9b\u8db3\u591f\u7684\u706b\u529b\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u6bd4\u8f83\u4e0d\u540c\u5766\u514b\u7c7b\u578b\u5728\u4e0d\u540c\u573a\u666f\uff08\u5982\u7a7a\u65f7\u5730\u533a\u4e0e\u57ce\u5e02\u73af\u5883\uff09\u4e2d\u7684\u4f18\u7f3a\u70b9\u3002]"}, {"question": "\u5982\u4f55\u5728\u5766\u514b\u6e38\u620f\u4e2d\u6709\u6548\u4f7f\u7528\u4f2a\u88c5\u6765\u907f\u514d\u88ab\u53d1\u73b0\uff1f", "answer": "\u8981\u6709\u6548\u5730\u4f7f\u7528\u4f2a\u88c5\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u9009\u62e9\u4e0e\u73af\u5883\u76f8\u7b26\u7684\u4f2a\u88c5\u56fe\u6848\uff0c\u4f8b\u5982\u6c99\u6f20\u6216\u68ee\u6797\u3002\u6b65\u9aa42 - \u4fdd\u6301\u9759\u6b62\u6216\u7f13\u6162\u79fb\u52a8\u4ee5\u907f\u514d\u88ab\u53d1\u73b0\u3002\u6b65\u9aa43 - \u4f7f\u7528\u704c\u6728\u548c\u5ca9\u77f3\u7b49\u81ea\u7136\u63a9\u4f53\u8fdb\u884c\u4f2a\u88c5\u3002\u4f8b\u5982\uff0c\u5728\u201c\u6c99\u6f20\u4f0f\u51fb\u201d\u5730\u56fe\u4e2d\uff0c\u4f7f\u7528\u6c99\u8272\u4f2a\u88c5\u53ef\u4ee5\u8ba9\u4f60\u51e0\u4e4e\u9690\u5f62\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c31\u50cf\u53d8\u8272\u9f99\u6539\u53d8\u989c\u8272\u4ee5\u878d\u5165\u5468\u56f4\u73af\u5883\u4e00\u6837\u3002]"}, {"question": "\u5766\u514b\u6e38\u620f\u4e2d\u6709\u6548\u7684\u56e2\u961f\u6c9f\u901a\u65b9\u5f0f\u6709\u54ea\u4e9b\uff1f", "answer": "\u6709\u6548\u7684\u56e2\u961f\u6c9f\u901a\u5305\u62ec\uff1a\u6b65\u9aa41 - \u4f7f\u7528\u8bed\u97f3\u804a\u5929\u6216\u5feb\u901f\u6307\u4ee4\u5feb\u901f\u4f20\u9012\u4fe1\u606f\u3002\u6b65\u9aa42 - \u4e3a\u6bcf\u4e2a\u56e2\u961f\u6210\u5458\u5206\u914d\u89d2\u8272\uff0c\u4f8b\u5982\u4fa6\u5bdf\u5175\u3001\u72d9\u51fb\u624b\u548c\u5766\u514b\u624b\u3002\u6b65\u9aa43 - \u5b9a\u671f\u5411\u56e2\u961f\u66f4\u65b0\u654c\u4eba\u7684\u4f4d\u7f6e\u548c\u4f60\u7684\u72b6\u6001\u3002\u4f8b\u5982\uff0c\u5728\u201c\u56e2\u961f\u6b7b\u4ea1\u7ade\u8d5b\u201d\u6a21\u5f0f\u4e2d\uff0c\u6307\u51fa\u654c\u4eba\u7684\u4f4d\u7f6e\u53ef\u4ee5\u5bfc\u81f4\u534f\u8c03\u7684\u51fb\u6740\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u6bd4\u8f83\u4e0d\u540c\u7684\u6c9f\u901a\u5de5\u5177\u53ca\u5176\u5728\u4e0d\u540c\u573a\u666f\u4e0b\u7684\u6709\u6548\u6027\u3002]"}, {"question": "\u5766\u514b\u6e38\u620f\u7684\u5339\u914d\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u5766\u514b\u6e38\u620f\u7684\u5339\u914d\u7cfb\u7edf\u4f7f\u7528\u4e00\u79cd\u7b97\u6cd5\uff0c\u8be5\u7b97\u6cd5\u8003\u8651\u73a9\u5bb6\u6280\u80fd\u3001\u5766\u514b\u7b49\u7ea7\u548c\u6700\u8fd1\u7684\u8868\u73b0\u6765\u521b\u5efa\u5e73\u8861\u7684\u5339\u914d\u3002\u4f8b\u5982\uff0c\u4f7f\u75285\u7ea7\u5766\u514b\u4e14\u62e5\u6709\u9ad8\u80dc\u7387\u7684\u73a9\u5bb6\u5c06\u88ab\u5339\u914d\u5230\u62e5\u6709\u7c7b\u4f3c\u6280\u80fd\u7684\u5bf9\u624b\u3002\u8be5\u7cfb\u7edf\u8fd8\u4f18\u5148\u8003\u8651\u5feb\u901f\u5339\u914d\uff0c\u56e0\u6b64\u6709\u65f6\u4f60\u53ef\u80fd\u4f1a\u9047\u5230\u7565\u5fae\u66f4\u5f3a\u6216\u66f4\u5f31\u7684\u5bf9\u624b\u3002[\u6d41\u7a0b\u56fe\u89e3: \u53ef\u89c6\u5316\u5339\u914d\u8fc7\u7a0b\uff0c\u4ece\u6392\u961f\u5230\u5339\u914d\u5f00\u59cb\u3002]"}, {"question": "PC\u7248\u548c\u4e3b\u673a\u7248\u5766\u514b\u6e38\u620f\u4e4b\u95f4\u6709\u54ea\u4e9b\u5173\u952e\u533a\u522b\uff1f", "answer": "PC\u7248\u548c\u4e3b\u673a\u7248\u5766\u514b\u6e38\u620f\u4e4b\u95f4\u7684\u5173\u952e\u533a\u522b\u5305\u62ec\u63a7\u5236\u65b9\u6848\u3001\u56fe\u5f62\u8bbe\u7f6e\u548c\u7528\u6237\u754c\u9762\u3002PC\u73a9\u5bb6\u901a\u5e38\u4f7f\u7528\u952e\u76d8\u548c\u9f20\u6807\u8fdb\u884c\u7cbe\u786e\u7784\u51c6\uff0c\u800c\u4e3b\u673a\u73a9\u5bb6\u5219\u4f9d\u9760\u5177\u6709\u7784\u51c6\u8f85\u52a9\u529f\u80fd\u7684\u63a7\u5236\u5668\u3002\u6b64\u5916\uff0cPC\u7248\u672c\u53ef\u80fd\u4f1a\u63d0\u4f9b\u66f4\u9ad8\u7684\u56fe\u5f62\u4fdd\u771f\u5ea6\u548c\u53ef\u81ea\u5b9a\u4e49\u7684\u6309\u952e\u7ed1\u5b9a\u3002\u4f8b\u5982\uff0cPC\u4e0a\u7684\u201c\u56fe\u5f62\u8bbe\u7f6e\u201d\u83dc\u5355\u5141\u8bb8\u8fdb\u884c\u8be6\u7ec6\u8c03\u6574\uff0c\u4e3b\u673a\u7248\u672c\u5219\u6ca1\u6709\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u6bd4\u8f83PC\u7248\u548c\u4e3b\u673a\u7248\u6e38\u620f\u7684\u63a7\u5236\u65b9\u6848\u548c\u56fe\u5f62\u9009\u9879\u3002]"}, {"question": "\u5982\u4f55\u5728\u5766\u514b\u6e38\u620f\u4e2d\u627e\u5230\u5e76\u89e3\u9501\u9690\u85cf\u5766\u514b\uff1f", "answer": "\u8981\u627e\u5230\u548c\u89e3\u9501\u9690\u85cf\u5766\u514b\uff0c\u4f60\u9700\u8981\u5b8c\u6210\u7279\u5b9a\u6311\u6218\u6216\u627e\u5230\u79d8\u5bc6\u5730\u70b9\u3002\u4f8b\u5982\uff0c\u53ef\u4ee5\u901a\u8fc7\u5728\u201c\u88ab\u8bc5\u5492\u6218\u573a\u201d\u5730\u56fe\u4e2d\u5b8c\u6210\u6240\u6709\u4efb\u52a1\u4e14\u4e0d\u53d7\u5230\u4efb\u4f55\u4f24\u5bb3\u6765\u89e3\u9501\u201c\u5e7d\u7075\u5766\u514b\u201d\u3002\u6b64\u5916\uff0c\u4e00\u4e9b\u5766\u514b\u9690\u85cf\u5728\u5f69\u86cb\u4e2d\uff0c\u4f8b\u5982\u4e3b\u83dc\u5355\u4e2d\u7279\u5b9a\u6309\u94ae\u7684\u987a\u5e8f\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c31\u50cf\u5bfb\u5b9d\u6e38\u620f\u4e00\u6837\uff1b\u8ddf\u7740\u7ebf\u7d22\u4f60\u5c31\u80fd\u627e\u5230\u5956\u54c1\u3002]"}, {"question": "\u5982\u4f55\u6709\u6548\u5730\u4f7f\u7528\u5766\u514b\u4e2d\u7684\u70ae\u5175\uff1f", "answer": "\u6709\u6548\u5730\u4f7f\u7528\u70ae\u5175\u5305\u62ec\uff1a\u6b65\u9aa41 - \u5728\u8fdc\u79bb\u524d\u7ebf\u7684\u5b89\u5168\u8ddd\u79bb\u5904\u90e8\u7f72\u3002\u6b65\u9aa42 - \u9884\u6d4b\u654c\u4eba\u7684\u884c\u52a8\uff0c\u5e76\u5bf9\u5176\u9884\u671f\u7684\u8def\u5f84\u8fdb\u884c\u5c04\u51fb\u3002\u6b65\u9aa43 - \u4e0e\u961f\u53cb\u534f\u8c03\uff0c\u8bc6\u522b\u76ee\u6807\u5e76\u63d0\u4f9b\u63a9\u62a4\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5f00\u9614\u5e73\u539f\u201d\u5730\u56fe\u4e2d\uff0c\u4f7f\u7528\u70ae\u5175\u8f70\u51fb\u654c\u4eba\u7684\u8865\u7ed9\u7ebf\u53ef\u4ee5\u6270\u4e71\u4ed6\u4eec\u7684\u6218\u7565\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u6bd4\u8f83\u4e0d\u540c\u70ae\u5175\u7c7b\u578b\u53ca\u5176\u5728\u5404\u79cd\u573a\u666f\u4e0b\u7684\u6700\u4f73\u7528\u9014\u3002]"}]
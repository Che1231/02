[{"question": "\ud0f1\ud06c\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \uc219\ub2ec\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud0f1\ud06c\uc5d0\uc11c \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc219\ub2ec\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1 - WASD \uc774\ub3d9 \ud0a4\uc640 \ub9c8\uc6b0\uc2a4 \uc870\uc900\uc5d0 \uc775\uc219\ud574\uc9d1\ub2c8\ub2e4. STEP2 - \ud0f1\ud06c\uc758 \ub300\ud3ec \uac10\uac01\uc744 \uc5bb\uae30 \uc704\ud574 \uc815\uc9c0\ub41c \ud45c\uc801\uc744 \uc5f0\uc2b5\ud569\ub2c8\ub2e4. STEP3 - \ud1b5\uc81c\ub41c \ud658\uacbd\uc5d0\uc11c \uc774\ub7ec\ud55c \uae30\uc220\uc744 \uc801\uc6a9\ud558\uae30 \uc704\ud574 \ud29c\ud1a0\ub9ac\uc5bc \ubbf8\uc158\uc5d0 \ucc38\uc5ec\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uccab \ubc88\uc9f8 \uacf5\uaca9' \ubbf8\uc158\uc5d0\uc11c\ub294 \ub3d9\uc2dc\uc5d0 \uc774\ub3d9\ud558\uace0 \uc0ac\uaca9\ud558\ub294 \ubc95\uc744 \ubc30\uc6c1\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc6b4\uc804\uc744 \ubc30\uc6b0\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ucc9c\ucc9c\ud788 \uc2dc\uc791\ud574\uc11c \uc810\ucc28 \uc18d\ub3c4\uc640 \ubcf5\uc7a1\uc131\uc744 \ub192\uc774\uc138\uc694.]"}, {"question": "100\uc2dc\uac04 \ud50c\ub808\uc774 \ud6c4 \ud0f1\ud06c\uc5d0\uc11c \uc2b9\ub9ac\ud558\ub294 \ub370 \ud544\uc218\uc801\uc778 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "100\uc2dc\uac04 \ud50c\ub808\uc774 \ud6c4, \ub2e4\uc74c \uc804\ub7b5\uc5d0 \uc9d1\uc911\ud558\uc138\uc694: STEP1 - \uc9c0\ud615 \uc778\uc2dd: \uc5b8\ub355 \ub4a4\uc5d0 \uc228\ub294 \uac83\uacfc \uac19\uc774 \ud56d\uc0c1 \uc9c0\ud615\uc744 \ud30c\uc545\ud558\uace0 \uc774\ub97c \ud65c\uc6a9\ud558\uc138\uc694. STEP2 - \ud300 \ud611\ub825: \uc801\uc744 \uae30\uc2b5\ud558\uac70\ub098 \uc8fc\uc694 \uc9c0\uc810\uc744 \ubc29\uc5b4\ud558\uae30 \uc704\ud574 \ud300\uc6d0\uacfc \uc18c\ud1b5\ud558\uc138\uc694. STEP3 - \uc790\uc6d0 \uad00\ub9ac: \uc911\uc694\ud55c \uc21c\uac04\uc744 \uc704\ud574 \ud0c4\uc57d\uacfc \uccb4\ub825 \ud68c\ubcf5\uc81c\ub97c \uc808\uc57d\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uc694\uc0c8 \uacf5\uaca9' \uc9c0\ub3c4\uc5d0\uc11c\ub294 \uace0\uc9c0\ub300\ub97c \ud65c\uc6a9\ud558\uba74 \uc0c1\ub2f9\ud55c \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \ub2e4\uc591\ud55c \uc0c1\ud669\uc5d0\uc11c \uc11c\ub85c \ub2e4\ub978 \ud0f1\ud06c \uc720\ud615\uacfc \uadf8 \ud65c\uc6a9\ubc95\uc744 \ube44\uad50\ud558\uc138\uc694.]"}, {"question": "\ud0f1\ud06c\uc5d0\uc11c \ud53c\ud574 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud53c\ud574 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \uc804\ud22c\uc5d0\uc11c \ud6a8\uacfc\ub97c \uadf9\ub300\ud654\ud560 \uc218 \uc788\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc11c\ub85c \ub2e4\ub978 \ud0f1\ud06c\ub294 \ub2e4\uc591\ud55c \uc7a5\uac11 \ub450\uaed8\uc640 \uc57d\uc810\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc911\uc804\ucc28\uc758 \ud6c4\uba74\uc744 \uacf5\uaca9\ud558\ub294 \uac83\uc774 \uc804\uba74 \uacf5\uaca9\ubcf4\ub2e4 \ub354 \ud070 \ud53c\ud574\ub97c \uc785\ud799\ub2c8\ub2e4. \ub610\ud55c, AP(\uc7a5\uac11 \uad00\ud1b5) \ud0c4\uc57d\uacfc \uac19\uc740 \ud2b9\uc815 \uc885\ub958\uc758 \ud0c4\uc57d\uc740 \uc7a5\uac11 \ud45c\uc801\uc5d0 \ub354 \ud6a8\uacfc\uc801\uc774\uace0, HE(\uace0\ud3ed) \ud0c4\uc57d\uc740 \ubd80\ub4dc\ub7ec\uc6b4 \ud45c\uc801\uc5d0 \ub354 \uc801\ud569\ud569\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \ub2e4\uc591\ud55c \uac01\ub3c4\uc640 \ud0c4\uc57d \uc720\ud615\uc5d0\uc11c\uc758 \ud53c\ud574 \ud750\ub984\uc744 \uc2dc\uac01\ud654\ud558\uc138\uc694.]"}, {"question": "\ud0f1\ud06c\uc5d0\uc11c \ub2e4\uc591\ud55c \uc804\ud22c \uc0c1\ud669\uc5d0 \ub9de\ub294 \uc5b4\ub5a4 \ud0f1\ud06c \ud074\ub798\uc2a4\ub97c \uc120\ud0dd\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\uc801\uc808\ud55c \ud0f1\ud06c \ud074\ub798\uc2a4 \uc120\ud0dd\uc740 \uc804\ud22c \uc0c1\ud669\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4. \uacbd\uc804\ucc28\ub294 \uc815\ucc30 \ubc0f \ube60\ub978 \uacf5\uaca9\uc5d0 \uc801\ud569\ud558\uace0, \uc911\uc804\ucc28\ub294 \uc18d\ub3c4\uc640 \ud654\ub825\uc758 \uade0\ud615\uc744 \uc81c\uacf5\ud558\uba70, \uc911\uc804\ucc28\ub294 \uc804\uc120 \uacf5\uaca9\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub3c4\uc2dc \uacf5\uaca9'\uc5d0\uc11c \uc911\uc804\ucc28\ub294 \uc881\uc740 \uacf5\uac04\uc744 \uc774\ub3d9\ud558\uba74\uc11c \ucda9\ubd84\ud55c \ud654\ub825\uc744 \uc81c\uacf5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc635\uc158 \ube44\uad50: \uac1c\ubc29\ub41c \uc9c0\uc5ed \ub300 \ub3c4\uc2dc \ud658\uacbd\uacfc \uac19\uc740 \ub2e4\uc591\ud55c \uc0c1\ud669\uc5d0\uc11c \uac01 \ud0f1\ud06c \ud074\ub798\uc2a4\uc758 \uc7a5\ub2e8\uc810\uc744 \ube44\uad50\ud558\uc138\uc694.]"}, {"question": "\ud0f1\ud06c\uc5d0\uc11c \uc740\ud3d0\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc5ec \ud0d0\uc9c0\ub418\ub294 \uac83\uc744 \uc5b4\ub5bb\uac8c \ubc29\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc740\ud3d0\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1 - \uc0ac\ub9c9\uc774\ub098 \uc232\uacfc \uac19\uc740 \ud658\uacbd\uc5d0 \ub9de\ub294 \uc740\ud3d0 \ud328\ud134\uc744 \uc120\ud0dd\ud558\uc138\uc694. STEP2 - \ud0d0\uc9c0\ub418\uc9c0 \uc54a\ub3c4\ub85d \uac00\ub9cc\ud788 \uc788\uac70\ub098 \ucc9c\ucc9c\ud788 \uc774\ub3d9\ud558\uc138\uc694. STEP3 - \ub364\ubd88\uc774\ub098 \ubc14\uc704\uc640 \uac19\uc740 \uc790\uc5f0\uc801\uc778 \uc7a5\uc560\ubb3c\uc744 \uc774\uc6a9\ud558\uc5ec \uc228\uc73c\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uc0ac\ub9c9 \ub9e4\ubcf5' \uc9c0\ub3c4\uc5d0\uc11c \ubaa8\ub798\uc0c9 \uc740\ud3d0\ub97c \uc0ac\uc6a9\ud558\uba74 \uac70\uc758 \ubcf4\uc774\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uce74\uba5c\ub808\uc628\uc774 \uc8fc\ubcc0 \ud658\uacbd\uc5d0 \ub9de\ucdb0 \uc0c9\uae54\uc744 \ubc14\uafb8\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ud0f1\ud06c\uc5d0\uc11c \ud300 \ucee4\ubba4\ub2c8\ucf00\uc774\uc158\uc744 \uc704\ud55c \ucd5c\uc0c1\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud6a8\uacfc\uc801\uc778 \ud300 \ucee4\ubba4\ub2c8\ucf00\uc774\uc158\uc5d0\ub294 \ub2e4\uc74c\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4: STEP1 - \uc74c\uc131 \ucc44\ud305\uc774\ub098 \ube60\ub978 \uba85\ub839\uc5b4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc815\ubcf4\ub97c \uc2e0\uc18d\ud558\uac8c \uc804\ub2ec\ud558\uc138\uc694. STEP2 - \uc815\ucc30\ubcd1, \uc800\uaca9\uc218, \ud0f1\ucee4\uc640 \uac19\uc740 \uc5ed\ud560\uc744 \uac01 \ud300\uc6d0\uc5d0\uac8c \ud560\ub2f9\ud558\uc138\uc694. STEP3 - \uc815\uae30\uc801\uc73c\ub85c \ud300\uc6d0\ub4e4\uc5d0\uac8c \uc801\uc758 \uc704\uce58\uc640 \uc790\uc2e0\uc758 \uc0c1\ud0dc\ub97c \uc54c\ub824\uc8fc\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\ud300 \ub370\uc2a4\ub9e4\uce58' \ubaa8\ub4dc\uc5d0\uc11c \uc801\uc758 \uc704\uce58\ub97c \uc54c\ub9ac\uba74 \uc870\uc815\ub41c \uacf5\uaca9\uc744 \uac00\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \ub2e4\uc591\ud55c \uc0c1\ud669\uc5d0\uc11c \uc11c\ub85c \ub2e4\ub978 \ucee4\ubba4\ub2c8\ucf00\uc774\uc158 \ub3c4\uad6c\uc758 \ud6a8\uacfc\ub97c \ube44\uad50\ud558\uc138\uc694.]"}, {"question": "\ud0f1\ud06c\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "\ud0f1\ud06c\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uc758 \uc219\ub828\ub3c4, \ud0f1\ud06c \ud2f0\uc5b4, \ucd5c\uadfc \uc131\ub2a5\uc744 \uace0\ub824\ud558\ub294 \uc54c\uace0\ub9ac\uc998\uc744 \uc0ac\uc6a9\ud558\uc5ec \uade0\ud615 \uc7a1\ud78c \ub9e4\uce58\ub97c \uc0dd\uc131\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uace0\uc2b9\ub960\uc744 \uac00\uc9c4 Tier 5 \ud0f1\ud06c\ub97c \uc0ac\uc6a9\ud558\ub294 \ud50c\ub808\uc774\uc5b4\ub294 \ube44\uc2b7\ud55c \uc219\ub828\ub3c4\ub97c \uac00\uc9c4 \uc0c1\ub300\uc640 \ub9e4\uce58\ub420 \uac83\uc785\ub2c8\ub2e4. \uc2dc\uc2a4\ud15c\uc740 \ub610\ud55c \ube60\ub978 \ub9e4\uce6d\uc744 \uc6b0\uc120\uc2dc\ud558\uae30 \ub54c\ubb38\uc5d0 \ub54c\ub85c\ub294 \uc57d\uac04 \ub354 \uac15\ud558\uac70\ub098 \uc57d\ud55c \uc0c1\ub300\ub97c \ub9cc\ub0a0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \ub300\uae30\uc5d0\uc11c \ub9e4\uce58 \uc2dc\uc791\uae4c\uc9c0 \ub9e4\uce6d \ud504\ub85c\uc138\uc2a4\ub97c \uc2dc\uac01\ud654\ud558\uc138\uc694.]"}, {"question": "PC \ubc84\uc804\uacfc \ucf58\uc194 \ubc84\uc804\uc758 \ud0f1\ud06c \uac04 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "PC \ubc84\uc804\uacfc \ucf58\uc194 \ubc84\uc804\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc5d0\ub294 \ucee8\ud2b8\ub864 \ubc29\uc2dd, \uadf8\ub798\ud53d \uc124\uc815, \uc0ac\uc6a9\uc790 \uc778\ud130\ud398\uc774\uc2a4\uac00 \ud3ec\ud568\ub429\ub2c8\ub2e4. PC \ud50c\ub808\uc774\uc5b4\ub294 \uc815\ud655\ud55c \uc870\uc900\uc744 \uc704\ud574 \ud0a4\ubcf4\ub4dc\uc640 \ub9c8\uc6b0\uc2a4\ub97c \uc790\uc8fc \uc0ac\uc6a9\ud558\ub294 \ubc18\uba74, \ucf58\uc194 \ud50c\ub808\uc774\uc5b4\ub294 \uc870\uc900 \ubcf4\uc870 \uae30\ub2a5\uc774 \uc788\ub294 \ucee8\ud2b8\ub864\ub7ec\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ub610\ud55c, PC \ubc84\uc804\uc740 \ub354 \ub192\uc740 \uadf8\ub798\ud53d \uc815\ubc00\ub3c4\uc640 \uc0ac\uc6a9\uc790 \uc9c0\uc815 \uac00\ub2a5\ud55c \ud0a4 \ubc14\uc778\ub529\uc744 \uc81c\uacf5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc758 '\uadf8\ub798\ud53d \uc124\uc815' \uba54\ub274\uc5d0\uc11c\ub294 \ucf58\uc194\uc5d0\uc11c \uc0ac\uc6a9\ud560 \uc218 \uc5c6\ub294 \uc138\ubd80 \uc870\uc815\uc744 \uc218\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc635\uc158 \ube44\uad50: PC\uc640 \ucf58\uc194 \ubc84\uc804 \uac04\uc758 \ucee8\ud2b8\ub864 \ubc29\uc2dd \ubc0f \uadf8\ub798\ud53d \uc635\uc158\uc744 \ube44\uad50\ud558\uc138\uc694.]"}, {"question": "\ud0f1\ud06c\uc5d0\uc11c \uc228\uaca8\uc9c4 \ud0f1\ud06c\ub97c \ucc3e\uace0 \ud574\uae08\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc228\uaca8\uc9c4 \ud0f1\ud06c\ub97c \ucc3e\uace0 \ud574\uae08\ud558\ub824\uba74 \ud2b9\uc815 \ucc4c\ub9b0\uc9c0 \ub610\ub294 \ube44\ubc00 \uc7a5\uc18c\ub97c \uc644\ub8cc\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc720\ub839 \ud0f1\ud06c'\ub294 '\uc720\ub839 \uc804\uc7a5' \uc9c0\ub3c4\uc5d0\uc11c \uc544\ubb34\ub7f0 \ud53c\ud574 \uc5c6\uc774 \ubaa8\ub4e0 \ubbf8\uc158\uc744 \uc644\ub8cc\ud558\uba74 \ud574\uae08\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uc77c\ubd80 \ud0f1\ud06c\ub294 \uba54\uc778 \uba54\ub274\uc5d0\uc11c \ud2b9\uc815 \ubc84\ud2bc \uc870\ud569\uacfc \uac19\uc774 \uc774\uc2a4\ud130 \uc5d0\uadf8\uc5d0 \uc228\uaca8\uc838 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ubcf4\ubb3c \ucc3e\uae30\uc640 \uac19\uc2b5\ub2c8\ub2e4. \ub2e8\uc11c\ub97c \ub530\ub77c\uac00\uba74 \ubcf4\uc0c1\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ud3ec\uaca9\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \ucd5c\uace0\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud3ec\uaca9\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub824\uba74 \ub2e4\uc74c\uc744 \uc218\ud589\ud574\uc57c \ud569\ub2c8\ub2e4: STEP1 - \uc804\uc120\uc5d0\uc11c \uc548\uc804\ud55c \uac70\ub9ac\uc5d0 \uc704\uce58\ud558\uc138\uc694. STEP2 - \uc801\uc758 \uc774\ub3d9\uc744 \uc608\uce21\ud558\uace0 \uc608\uc0c1 \uacbd\ub85c\ub97c \ud0c0\uaca9\ud558\uc138\uc694. STEP3 - \ud300\uc6d0\uacfc \ud611\ub825\ud558\uc5ec \ud45c\uc801\uc744 \uc9c0\uc815\ud558\uace0 \ubcf4\ud638\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uac1c\ubc29\ub41c \ud3c9\uc6d0' \uc9c0\ub3c4\uc5d0\uc11c\ub294 \uc801\uc758 \ubcf4\uae09\ub85c\ub97c \ud3ec\uaca9\uc73c\ub85c \ud3ed\uaca9\ud558\uc5ec \uadf8\ub4e4\uc758 \uc804\ub7b5\uc744 \uad50\ub780\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \ub2e4\uc591\ud55c \uc0c1\ud669\uc5d0\uc11c \uc11c\ub85c \ub2e4\ub978 \ud3ec\uaca9 \uc720\ud615\uacfc \uadf8 \ud65c\uc6a9\ubc95\uc744 \ube44\uad50\ud558\uc138\uc694.]"}]
[{"question": "\u5766\u514b\u65b0\u73a9\u5bb6\u5982\u4f55\u5feb\u901f\u638c\u63e1\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1\u5766\u514b\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f\u4e00 - \u719f\u6089\u79fb\u52d5\u9375\uff08WASD\uff09\u548c\u6ed1\u9f20\u7784\u6e96\u3002\u6b65\u9a5f\u4e8c - \u7df4\u7fd2\u5c04\u64ca\u975c\u6b62\u76ee\u6a19\uff0c\u611f\u53d7\u5766\u514b\u7832\u7684\u6027\u80fd\u3002\u6b65\u9a5f\u4e09 - \u5728\u6559\u5b78\u4efb\u52d9\u4e2d\u61c9\u7528\u9019\u4e9b\u6280\u80fd\uff0c\u5728\u53d7\u63a7\u74b0\u5883\u4e0b\u7df4\u7fd2\u3002\u4f8b\u5982\uff0c\u5728\u300e\u7b2c\u4e00\u64ca\u300f\u4efb\u52d9\u4e2d\uff0c\u4f60\u5c07\u5b78\u7fd2\u540c\u6642\u9032\u884c\u79fb\u52d5\u548c\u5c04\u64ca\u3002[\u6bd4\u55bb\u8aaa\u660e: \u60f3\u60f3\u5b78\u7fd2\u958b\u8eca\uff0c\u5148\u6162\u901f\u7df4\u7fd2\uff0c\u518d\u6f38\u6f38\u589e\u52a0\u901f\u5ea6\u548c\u8907\u96dc\u5ea6\u3002]"}, {"question": "\u5728\u73a9\u5766\u514b100\u5c0f\u6642\u5f8c\uff0c\u4ec0\u9ebc\u662f\u8d0f\u5f97\u6bd4\u8cfd\u7684\u95dc\u9375\u7b56\u7565\uff1f", "answer": "100\u5c0f\u6642\u5f8c\uff0c\u8acb\u5c08\u6ce8\u65bc\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9a5f\u4e00 - \u5730\u5f62\u610f\u8b58\uff1a\u59cb\u7d42\u77ad\u89e3\u5730\u5f62\uff0c\u4e26\u5229\u7528\u5730\u5f62\u512a\u52e2\uff0c\u4f8b\u5982\u8eb2\u5728\u5c0f\u5c71\u5f8c\u9762\u3002\u6b65\u9a5f\u4e8c - \u5718\u968a\u5408\u4f5c\uff1a\u8207\u968a\u53cb\u6e9d\u901a\uff0c\u4ee5\u5305\u570d\u6575\u4eba\u6216\u9632\u5b88\u95dc\u9375\u9ede\u3002\u6b65\u9a5f\u4e09 - \u8cc7\u6e90\u7ba1\u7406\uff1a\u5728\u95dc\u9375\u6642\u523b\u7bc0\u7d04\u5f48\u85e5\u548c\u91ab\u7642\u5305\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5821\u58d8\u570d\u653b\u300f\u5730\u5716\u4e2d\uff0c\u5229\u7528\u9ad8\u5730\u53ef\u4ee5\u7372\u5f97\u986f\u8457\u512a\u52e2\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u6bd4\u8f03\u4e0d\u540c\u5766\u514b\u985e\u578b\u53ca\u5176\u5728\u5404\u7a2e\u60c5\u6cc1\u4e0b\u7684\u6700\u4f73\u7528\u9014\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u7406\u89e3\u5766\u514b\u7684\u50b7\u5bb3\u6a5f\u5236\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u7406\u89e3\u50b7\u5bb3\u6a5f\u5236\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u80fd\u8b93\u4f60\u6700\u5927\u9650\u5ea6\u5730\u767c\u63ee\u6230\u9b25\u529b\u3002\u4e0d\u540c\u7684\u5766\u514b\u5177\u6709\u4e0d\u540c\u7684\u88dd\u7532\u539a\u5ea6\u548c\u5f31\u9ede\u3002\u4f8b\u5982\uff0c\u64ca\u4e2d\u91cd\u578b\u5766\u514b\u7684\u5f8c\u65b9\u6bd4\u6b63\u9762\u653b\u64ca\u9020\u6210\u66f4\u591a\u50b7\u5bb3\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u5f48\u85e5\u985e\u578b\uff08\u4f8b\u5982\u7a7f\u7532\u5f48\uff09\u5c0d\u88dd\u7532\u76ee\u6a19\u66f4\u6709\u6548\uff0c\u800c\u9ad8\u7206\u5f48\u5247\u66f4\u9069\u5408\u5c0d\u4ed8\u8f03\u8106\u5f31\u7684\u76ee\u6a19\u3002[\u6d41\u7a0b\u5716\u89e3: \u8aaa\u660e\u5f9e\u4e0d\u540c\u89d2\u5ea6\u548c\u5f48\u85e5\u985e\u578b\u7522\u751f\u7684\u50b7\u5bb3\u6d41\u5411\u3002]"}, {"question": "\u5728\u5766\u514b\u904a\u6232\u4e2d\uff0c\u6211\u61c9\u8a72\u6839\u64da\u4e0d\u540c\u7684\u6230\u9b25\u5834\u666f\u9078\u64c7\u54ea\u7a2e\u5766\u514b\uff1f", "answer": "\u9078\u64c7\u6b63\u78ba\u7684\u5766\u514b\u985e\u578b\u53d6\u6c7a\u65bc\u6230\u9b25\u5834\u666f\uff1a\u8f15\u578b\u5766\u514b\u9069\u5408\u5075\u5bdf\u548c\u5feb\u901f\u7a81\u8972\uff0c\u4e2d\u578b\u5766\u514b\u5247\u517c\u9867\u901f\u5ea6\u548c\u706b\u529b\uff0c\u91cd\u578b\u5766\u514b\u5247\u6700\u9069\u5408\u6b63\u9762\u885d\u92d2\u3002\u4f8b\u5982\uff0c\u5728\u300e\u57ce\u5e02\u7a81\u8972\u300f\u4e2d\uff0c\u4e2d\u578b\u5766\u514b\u53ef\u4ee5\u5728\u72f9\u7a84\u7a7a\u9593\u5167\u884c\u52d5\uff0c\u4e26\u63d0\u4f9b\u8db3\u5920\u7684\u706b\u529b\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u6bd4\u8f03\u4e0d\u540c\u5766\u514b\u985e\u578b\u5728\u4e0d\u540c\u5834\u666f\uff08\u4f8b\u5982\uff1a\u66e0\u91ce vs. \u57ce\u5e02\u74b0\u5883\uff09\u4e2d\u7684\u512a\u7f3a\u9ede\u3002]"}, {"question": "\u5982\u4f55\u5728\u5766\u514b\u904a\u6232\u4e2d\u6709\u6548\u5730\u4f7f\u7528\u507d\u88dd\u4f86\u907f\u514d\u88ab\u5075\u5bdf\u5230\uff1f", "answer": "\u8981\u6709\u6548\u4f7f\u7528\u507d\u88dd\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f\u4e00 - \u9078\u64c7\u8207\u74b0\u5883\u76f8\u7b26\u7684\u507d\u88dd\u5716\u6848\uff0c\u4f8b\u5982\u6c99\u6f20\u6216\u68ee\u6797\u3002\u6b65\u9a5f\u4e8c - \u4fdd\u6301\u975c\u6b62\u6216\u7de9\u6162\u79fb\u52d5\uff0c\u4ee5\u907f\u514d\u88ab\u5075\u5bdf\u5230\u3002\u6b65\u9a5f\u4e09 - \u5229\u7528\u81ea\u7136\u63a9\u9ad4\uff0c\u4f8b\u5982\u704c\u6728\u53e2\u548c\u5ca9\u77f3\uff0c\u878d\u5165\u74b0\u5883\u3002\u4f8b\u5982\uff0c\u5728\u300e\u6c99\u6f20\u4f0f\u64ca\u300f\u5730\u5716\u4e2d\uff0c\u4f7f\u7528\u6c99\u8272\u507d\u88dd\u53ef\u4ee5\u8b93\u4f60\u5e7e\u4e4e\u96b1\u5f62\u3002[\u6bd4\u55bb\u8aaa\u660e: \u60f3\u60f3\u8b8a\u8272\u9f8d\u6539\u8b8a\u984f\u8272\u4ee5\u878d\u5165\u5468\u570d\u74b0\u5883\u3002]"}, {"question": "\u5766\u514b\u904a\u6232\u4e2d\u6709\u6548\u7684\u5718\u968a\u6e9d\u901a\u65b9\u5f0f\u6709\u54ea\u4e9b\uff1f", "answer": "\u6709\u6548\u7684\u5718\u968a\u6e9d\u901a\u5305\u62ec\uff1a\u6b65\u9a5f\u4e00 - \u4f7f\u7528\u8a9e\u97f3\u804a\u5929\u6216\u5feb\u6377\u6307\u4ee4\u5feb\u901f\u50b3\u905e\u8cc7\u8a0a\u3002\u6b65\u9a5f\u4e8c - \u5c07\u89d2\u8272\u5206\u914d\u7d66\u5404\u968a\u54e1\uff0c\u4f8b\u5982\u5075\u5bdf\u5175\u3001\u72d9\u64ca\u624b\u548c\u4e3b\u6230\u5766\u514b\u3002\u6b65\u9a5f\u4e09 - \u5b9a\u671f\u5411\u968a\u4f0d\u66f4\u65b0\u6575\u65b9\u4f4d\u7f6e\u548c\u4f60\u7684\u72c0\u614b\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5718\u968a\u6b7b\u4ea1\u8cfd\u300f\u6a21\u5f0f\u4e2d\uff0c\u6307\u51fa\u6575\u65b9\u4f4d\u7f6e\u53ef\u4ee5\u5c0e\u81f4\u5354\u540c\u653b\u64ca\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u6bd4\u8f03\u4e0d\u540c\u6e9d\u901a\u5de5\u5177\u53ca\u5176\u5728\u5404\u7a2e\u60c5\u6cc1\u4e0b\u7684\u6709\u6548\u6027\u3002]"}, {"question": "\u5766\u514b\u7684\u914d\u5c0d\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u5766\u514b\u7684\u914d\u5c0d\u7cfb\u7d71\u4f7f\u7528\u8003\u616e\u73a9\u5bb6\u6280\u80fd\u3001\u5766\u514b\u7b49\u7d1a\u548c\u8fd1\u671f\u8868\u73fe\u7684\u6f14\u7b97\u6cd5\u4f86\u5efa\u7acb\u5e73\u8861\u7684\u6bd4\u8cfd\u3002\u4f8b\u5982\uff0c\u64c1\u6709\u9ad8\u52dd\u7387\u4e14\u4f7f\u75285\u7d1a\u5766\u514b\u7684\u73a9\u5bb6\u5c07\u8207\u540c\u6a23\u6280\u80fd\u7684\u5c0d\u624b\u914d\u5c0d\u3002\u8a72\u7cfb\u7d71\u4e5f\u512a\u5148\u8003\u616e\u5feb\u901f\u914d\u5c0d\uff0c\u56e0\u6b64\u6709\u6642\u4f60\u53ef\u80fd\u6703\u9047\u5230\u7565\u5f37\u6216\u7565\u5f31\u7684\u5c0d\u624b\u3002[\u6d41\u7a0b\u5716\u89e3: \u8aaa\u660e\u914d\u5c0d\u904e\u7a0b\uff0c\u5f9e\u6392\u968a\u5230\u958b\u59cb\u5339\u914d\u3002]"}, {"question": "PC\u7248\u548c\u4e3b\u6a5f\u7248\u7684\u5766\u514b\u4e4b\u9593\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "PC\u7248\u548c\u4e3b\u6a5f\u7248\u5766\u514b\u7684\u4e3b\u8981\u5dee\u7570\u5305\u62ec\u64cd\u63a7\u65b9\u6848\u3001\u5716\u5f62\u8a2d\u5b9a\u548c\u4f7f\u7528\u8005\u4ecb\u9762\u3002PC\u73a9\u5bb6\u901a\u5e38\u4f7f\u7528\u9375\u76e4\u548c\u6ed1\u9f20\u9032\u884c\u7cbe\u78ba\u7784\u6e96\uff0c\u800c\u4e3b\u6a5f\u73a9\u5bb6\u5247\u4f9d\u8cf4\u5177\u6709\u7784\u6e96\u8f14\u52a9\u529f\u80fd\u7684\u624b\u67c4\u3002\u6b64\u5916\uff0cPC\u7248\u53ef\u80fd\u63d0\u4f9b\u66f4\u9ad8\u7684\u5716\u5f62\u4fdd\u771f\u5ea6\u548c\u53ef\u81ea\u5b9a\u7fa9\u7684\u9375\u76e4\u7d81\u5b9a\u3002\u4f8b\u5982\uff0cPC\u4e0a\u7684\u300c\u5716\u5f62\u8a2d\u5b9a\u300d\u9078\u55ae\u5141\u8a31\u9032\u884c\u8a73\u7d30\u8abf\u6574\uff0c\u9019\u4e9b\u8abf\u6574\u5728\u4e3b\u6a5f\u4e0a\u4e0d\u53ef\u7528\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4 : \u6bd4\u8f03PC\u7248\u548c\u4e3b\u6a5f\u7248\u4e4b\u9593\u7684\u64cd\u63a7\u65b9\u6848\u548c\u5716\u5f62\u9078\u9805\u3002]"}, {"question": "\u5982\u4f55\u5728\u5766\u514b\u904a\u6232\u4e2d\u627e\u5230\u4e26\u89e3\u9396\u96b1\u85cf\u7684\u5766\u514b\uff1f", "answer": "\u8981\u627e\u5230\u4e26\u89e3\u9396\u96b1\u85cf\u7684\u5766\u514b\uff0c\u4f60\u9700\u8981\u5b8c\u6210\u7279\u5b9a\u6311\u6230\u6216\u627e\u5230\u79d8\u5bc6\u4f4d\u7f6e\u3002\u4f8b\u5982\uff0c\u300e\u5e7d\u9748\u5766\u514b\u300f\u53ef\u900f\u904e\u5728\u300e\u9b3c\u5f71\u6230\u5834\u300f\u5730\u5716\u4e2d\u5b8c\u6210\u6240\u6709\u4efb\u52d9\uff0c\u4e14\u4e0d\u53d7\u5230\u4efb\u4f55\u50b7\u5bb3\u4f86\u89e3\u9396\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u5766\u514b\u96b1\u85cf\u5728\u5f69\u86cb\u4e2d\uff0c\u4f8b\u5982\u4e3b\u9078\u55ae\u4e2d\u7684\u7279\u5b9a\u6309\u9375\u9806\u5e8f\u3002[\u6bd4\u55bb\u8aaa\u660e: \u60f3\u60f3\u5c0b\u5bf6\u904a\u6232\uff0c\u9075\u5faa\u7dda\u7d22\uff0c\u4f60\u5c31\u80fd\u627e\u5230\u734e\u52f5\u3002]"}, {"question": "\u4f7f\u7528\u5766\u514b\u5927\u7832\u7684\u6700\u6709\u6548\u65b9\u6cd5\u6709\u54ea\u4e9b\uff1f", "answer": "\u6709\u6548\u4f7f\u7528\u5927\u7832\u5305\u62ec\uff1a\u6b65\u9a5f\u4e00 - \u5c07\u81ea\u5df1\u5b89\u7f6e\u5728\u9060\u96e2\u524d\u7dda\u7684\u5b89\u5168\u4f4d\u7f6e\u3002\u6b65\u9a5f\u4e8c - \u9810\u6e2c\u6575\u4eba\u79fb\u52d5\u4e26\u5728\u9810\u671f\u8def\u5f91\u4e0a\u958b\u706b\u3002\u6b65\u9a5f\u4e09 - \u8207\u968a\u53cb\u5354\u8abf\uff0c\u4ee5\u4fbf\u8fa8\u5225\u76ee\u6a19\u4e26\u63d0\u4f9b\u63a9\u8b77\u3002\u4f8b\u5982\uff0c\u5728\u300e\u958b\u95ca\u5e73\u539f\u300f\u5730\u5716\u4e2d\uff0c\u4f7f\u7528\u5927\u7832\u8f5f\u64ca\u6575\u65b9\u7269\u8cc7\u7dda\u53ef\u4ee5\u6253\u4e82\u4ed6\u5011\u7684\u7b56\u7565\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u6bd4\u8f03\u4e0d\u540c\u5927\u7832\u985e\u578b\u53ca\u5176\u5728\u5404\u7a2e\u60c5\u6cc1\u4e0b\u7684\u6700\u4f73\u7528\u9014\u3002]"}]
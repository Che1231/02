[{"question": "\ube14\ub85d\ud5e4\ub4dc \uc2e0\uaddc \ud50c\ub808\uc774\uc5b4\uac00 \ucd08\ubc18\uc5d0 \uc790\uc6d0\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc218\uc9d1\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ube14\ub85d\ud5e4\ub4dc\uc5d0\uc11c \uc2e0\uaddc \ud50c\ub808\uc774\uc5b4\ub294 \ud544\uc218 \ub3c4\uad6c\uc640 \uc8fc\uac70\ub97c \uac74\uc124\ud558\uae30 \uc704\ud574 \ub098\ubb34\uc640 \ub3cc\uacfc \uac19\uc740 \uae30\ubcf8 \uc790\uc6d0\uc744 \uc218\uc9d1\ud558\ub294 \ub370 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. \ub2e8\uacc41: \ub098\ubb34\ub97c \uccd0\uc11c \ub098\ubb34\ub97c \uc218\uc9d1\ud569\ub2c8\ub2e4. \ub2e8\uacc42: \ub098\ubb34\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub3cc\uc744 \ucc44\uad74\ud560 \uc218 \uc788\ub294 \ub098\ubb34 \uace1\uad2d\uc774\ub97c \ub9cc\ub4ed\ub2c8\ub2e4. \ub2e8\uacc43: \ub3cc\ub85c \ub354 \ud6a8\uc728\uc801\uc778 \uc790\uc6d0 \uc218\uc9d1\uc744 \uc704\ud55c \ub3cc \ub9dd\uce58\uc640 \uace1\uad2d\uc774\ub97c \ub9cc\ub4ed\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub3cc \ub9dd\uce58\ub294 \ub098\ubb34 \uc218\uc9d1 \uc18d\ub3c4\ub97c \ud06c\uac8c \ub192\uc785\ub2c8\ub2e4. [\uad6c\uc131\ud45c]\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub2e4\uc591\ud55c \ub3c4\uad6c\uc758 \ud6a8\uc728\uc131\uc744 \ube44\uad50\ud558\uc2ed\uc2dc\uc624: \ub098\ubb34 \ub9dd\uce58 (\uc18d\ub3c4 2\ubc30), \ub3cc \ub9dd\uce58 (\uc18d\ub3c4 3\ubc30), \ucca0 \ub9dd\uce58 (\uc18d\ub3c4 4\ubc30). \uc774 \ubc29\ubc95\uc740 \uae30\ubcf8 \ub3c4\uad6c\uc5d0\uc11c \uace0\uae09 \ub3c4\uad6c\ub85c \uc6d0\ud65c\ud558\uac8c \uc804\ud658\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\ube14\ub85d\ud5e4\ub4dc\uc5d0\uc11c \uc778\ubca4\ud1a0\ub9ac\ub97c \uc2e0\uc911\ud558\uac8c \uad00\ub9ac\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ube14\ub85d\ud5e4\ub4dc\uc5d0\uc11c \uc778\ubca4\ud1a0\ub9ac \uad00\ub9ac\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \uc81c\ud55c\ub41c \uacf5\uac04\uc774 \uc9c4\ud589\uc744 \ubc29\ud574\ud560 \uc218 \uc788\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \ub2e8\uacc41: \ub3c4\uad6c, \uc74c\uc2dd \ubc0f \uac74\uc124 \uc790\uc7ac\uc640 \uac19\uc740 \ud544\uc218\ud488\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \ucc98\ub9ac\ud569\ub2c8\ub2e4. \ub2e8\uacc42: \uc815\uae30\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc9c0 \uc54a\ub294 \ubb3c\ud488\uc740 \uc0c1\uc790\uc5d0 \ubcf4\uad00\ud558\uc5ec \ud65c\ub3d9\uc801\uc778 \uc791\uc5c5\uc744 \uc704\ud55c \uacf5\uac04\uc744 \ud655\ubcf4\ud569\ub2c8\ub2e4. \ub2e8\uacc43: \uad11\ubb3c\uacfc \uc74c\uc2dd\uacfc \uac19\uc740 \ub2e4\ub978 \uc0c1\uc790\ub85c \ubb3c\ud488\uc744 \ubd84\ub958\ud558\uc5ec \uc778\ubca4\ud1a0\ub9ac\ub97c \uc815\uae30\uc801\uc73c\ub85c \uc815\ub3c8\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc81c\uc791 \uc601\uc5ed \uadfc\ucc98\uc758 \uc0c1\uc790\uc5d0 \ucd94\uac00 \ub098\ubb34\ub97c \ubcf4\uad00\ud558\uba74 \uc2dc\uac04\uc744 \uc808\uc57d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4]\ub294 \ud504\ub85c\uc138\uc2a4\ub97c \uc2dc\uac01\ud654\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4: \uc218\uc9d1 \u2192 \ubd84\ub958 \u2192 \ubcf4\uad00 \u2192 \uac80\uc0c9. \uc774 \uc2dc\uc2a4\ud15c\uc744 \ud1b5\ud574 \uc815\ub9ac\uac00 \ub418\uc9c0 \uc54a\uc544 \ud544\uc694\ud55c \ubb3c\ud488\uc744 \ud56d\uc0c1 \uac16\uac8c \ub429\ub2c8\ub2e4."}, {"question": "\ube14\ub85d\ud5e4\ub4dc\uc5d0\uc11c \uc9c0\uc0c1 \ubc0f \uc9c0\ud558 \ud658\uacbd\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc774\uba70, \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \uc801\uc751\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\ube14\ub85d\ud5e4\ub4dc\uc758 \uc9c0\uc0c1\uacfc \uc9c0\ud558 \ud658\uacbd\uc740 \uc11c\ub85c \ub2e4\ub978 \ub3c4\uc804\uacfc \uc790\uc6d0\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc9c0\uc0c1\uc5d0\uc11c\ub294 \ud48d\ubd80\ud55c \ub098\ubb34, \ub3cc \ubc0f \uc74c\uc2dd\uc744 \ucc3e\uc744 \uc218 \uc788\uc73c\ubbc0\ub85c \ucd08\ubcf4\uc790\uc5d0\uac8c \uc774\uc0c1\uc801\uc785\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \uc9c0\ud558\uc5d0\ub294 \ucca0\uacfc \uae08\uacfc \uac19\uc740 \ud76c\uadc0 \uad11\ubb3c\uc774 \uc788\uc9c0\ub9cc \ub354 \ub098\uc740 \ub3c4\uad6c\uc640 \uc870\uba85\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc41: \uc9c0\ud558 \ucc44\uad74 \uc804\uc5d0 \ub3cc \uace1\uad2d\uc774\ub97c \uc7a5\ucc29\ud569\ub2c8\ub2e4. \ub2e8\uacc42: \uc5b4\ub450\uc6b4 \uc9c0\uc5ed\uc744 \ubc1d\ud788\uace0 \ubaac\uc2a4\ud130\uc758 \ucd9c\ud604\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \ub4f1\ubd88\uc744 \ub9cc\ub4ed\ub2c8\ub2e4. \ub2e8\uacc43: \uc7a5\uae30 \ucc44\uad74 \uc5ec\uc815\uc744 \uc704\ud574 \ucd94\uac00 \uc74c\uc2dd\uacfc \ub3c4\uad6c\ub97c \ud56d\uc0c1 \ud734\ub300\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc9c0\ud558\uc5d0\uc11c \ucca0\uad11\uc11d\uc744 \ucc3e\uc73c\uba74 \ub354 \uac15\ud55c \ub3c4\uad6c\ub97c \uc81c\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uad50\ud45c]\ub97c \uc0ac\uc6a9\ud558\uc5ec \ucc28\uc774\uc810\uc744 \uac15\uc870\ud569\ub2c8\ub2e4: \uc9c0\uc0c1 (\ub098\ubb34, \ub3cc, \ud587\ube5b) \ub300 \uc9c0\ud558 (\uad11\ubb3c, \uc5b4\ub460, \ubaac\uc2a4\ud130). \uc774\ub7ec\ud55c \ud658\uacbd\uc5d0 \uc801\uc751\ud558\uba74 \ud6a8\uc728\uc774 \uadf9\ub300\ud654\ub429\ub2c8\ub2e4."}, {"question": "\ube14\ub85d\ud5e4\ub4dc\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 \ub354 \ube60\ub974\uac8c \uc9c4\ud589\ud558\uae30 \uc704\ud574 \uc81c\uc791 \uc804\ub7b5\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ube14\ub85d\ud5e4\ub4dc\uc5d0\uc11c \uc81c\uc791\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \ud544\uc218\ud488\uc744 \uc6b0\uc120 \uc21c\uc704\ub85c \uc815\ud558\uace0 \ub3c4\uad6c\ub97c \uccb4\uacc4\uc801\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \uac83\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \ub2e8\uacc41: \ub098\ubb34 \uace1\uad2d\uc774\uc640 \ub9dd\uce58\uc640 \uac19\uc740 \uae30\ubcf8 \ub3c4\uad6c\ub85c \uc2dc\uc791\ud569\ub2c8\ub2e4. \ub2e8\uacc42: \ub354 \ub0b4\uad6c\uc131 \uc788\ub294 \ub3cc \ub3c4\uad6c\ub97c \ub9cc\ub4e4\uae30 \uc704\ud574 \ub3cc\uc744 \uc218\uc9d1\ud569\ub2c8\ub2e4. \ub2e8\uacc43: \uad11\ubb3c\uc744 \uae08\uc18d \ub3c4\uad6c\ub85c \uc6a9\uad11\ub85c\uc5d0 \uc81c\ub828\ud558\uc5ec \ub354 \ud6a8\uc728\uc801\uc774\ub3c4\ub85d \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucca0 \uace1\uad2d\uc774\ub294 \ub3cc \uace1\uad2d\uc774\ubcf4\ub2e4 \ube14\ub85d\uc744 \ub354 \ube60\ub974\uac8c \ucc44\uad74\ud569\ub2c8\ub2e4. [\ub2e8\uacc4\ubcc4 \ud750\ub984\ub3c4]\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc81c\uc791 \ud504\ub85c\uc138\uc2a4\ub97c \uc548\ub0b4\ud569\ub2c8\ub2e4: \uc790\uc6d0 \uc218\uc9d1 \u2192 \uae30\ubcf8 \ub3c4\uad6c \uc81c\uc791 \u2192 \ub3cc\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc \u2192 \uad11\ubb3c \uc81c\ub828 \u2192 \uae08\uc18d \ub3c4\uad6c \uc81c\uc791. \uc774 \uc804\ub7b5\uc740 \uafb8\uc900\ud55c \uc9c4\ud589\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "\ube14\ub85d\ud5e4\ub4dc\uc5d0\uc11c \uc9c0\uc18d \uac00\ub2a5\ud55c \uae30\uc9c0\ub97c \uac74\uc124\ud558\ub294 \ub370 \uac00\uc7a5 \uc88b\uc740 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ube14\ub85d\ud5e4\ub4dc\uc5d0\uc11c \uc9c0\uc18d \uac00\ub2a5\ud55c \uae30\uc9c0\ub97c \uac74\uc124\ud558\ub824\uba74 \uacc4\ud68d\uacfc \uc790\uc6d0 \uad00\ub9ac\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc41: \ub098\ubb34\uc640 \ubb3c\uacfc \uac19\uc740 \ud544\uc218 \uc790\uc6d0 \uadfc\ucc98\uc5d0 \uc704\uce58\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. \ub2e8\uacc42: \ubaac\uc2a4\ud130\ub85c\ubd80\ud130 \ubcf4\ud638\ud558\uae30 \uc704\ud574 \ubcbd\uacfc \uc9c0\ubd95\uc774 \uc788\ub294 \uae30\ubcf8 \uc8fc\uac70\ub97c \uac74\uc124\ud569\ub2c8\ub2e4. \ub2e8\uacc43: \uc74c\uc2dd\uc744 \uc704\ud55c \ub18d\uc7a5\uacfc \uc800\uc7a5\uc744 \uc704\ud55c \uc0c1\uc790\ub97c \ucd94\uac00\ud558\uc5ec \uae30\uc9c0\ub97c \ud655\uc7a5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubc00 \ub18d\uc7a5\uc740 \uafb8\uc900\ud55c \uc2dd\ub7c9 \uacf5\uae09\uc6d0\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. [\ube44\uad50\ud45c]\ub97c \uc0ac\uc6a9\ud558\uc5ec \uae30\uc9c0 \uc704\uce58\ub97c \ud3c9\uac00\ud569\ub2c8\ub2e4: \ub098\ubb34 \uadfc\ucc98 (\ub098\ubb34 \uc27d\uac8c \uc5bb\uae30) \ub300 \ubb3c \uadfc\ucc98 (\ub18d\uc0ac \uc27d\uac8c \uc9d3\uae30). \uc774 \uc811\uadfc \ubc29\uc2dd\uc740 \uc7a5\uae30\uc801\uc778 \uc0dd\uc874\uacfc \ud6a8\uc728\uc131\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "\ube14\ub85d\ud5e4\ub4dc\uc5d0\uc11c\uc758 \ub0ae\uacfc \ubc24 \uc8fc\uae30\ub294 \uac8c\uc784\ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\uba70, \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \uc900\ube44\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\ube14\ub85d\ud5e4\ub4dc\uc5d0\uc11c\uc758 \ub0ae\uacfc \ubc24 \uc8fc\uae30\ub294 \ub2e4\ub978 \ub3c4\uc804\uacfc \uae30\ud68c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub0ae\uc5d0\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uc548\uc804\ud558\uac8c \uc790\uc6d0\uc744 \uc218\uc9d1\ud558\uace0 \ud0d0\ud5d8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubc24\uc5d0\ub294 \ubaac\uc2a4\ud130\uac00 \ucd9c\ud604\ud558\uc5ec \ubc16\uc73c\ub85c \ub098\uac00\ub294 \uac83\uc774 \uc704\ud5d8\ud569\ub2c8\ub2e4. \ub2e8\uacc41: \ub0ae \ub3d9\uc548 \ud544\uc218 \uc790\uc6d0\uc744 \uc218\uc9d1\ud558\uace0 \uc8fc\uac70\ub97c \uac74\uc124\ud569\ub2c8\ub2e4. \ub2e8\uacc42: \uc8fc\uac70\ub97c \ubc1d\ud788\uace0 \ubaac\uc2a4\ud130 \ucd9c\ud604\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \ub4f1\ubd88\uc744 \ub9cc\ub4ed\ub2c8\ub2e4. \ub2e8\uacc43: \uce68\ub300\uc5d0\uc11c \uc790\uc11c \ubc24\uc744 \uac74\ub108\ub6f0\uace0 \uc704\ud5d8\uc744 \ud53c\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uce68\ub300\uc5d0\uc11c \uc790\uba74 \uccb4\ub825\uc774 \ud68c\ubcf5\ub418\uace0 \ubc24 \uc8fc\uae30\uac00 \uac74\ub108\ub701\ub2c8\ub2e4. [\uc2dc\uac04\ud45c \uadf8\ub9bc]\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc8fc\uae30\ub97c \ubcf4\uc5ec\uc90d\ub2c8\ub2e4: \ub0ae (\uc548\uc804, \uc218\uc9d1) \u2192 \ubc24 (\uc704\ud5d8, \uc7a0\uc790\uae30). \ubc24\uc5d0 \ub300\ube44\ud558\ub294 \uac83\uc740 \uc548\uc804\uacfc \ud6a8\uc728\uc131\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "\ube14\ub85d\ud5e4\ub4dc\uc5d0\uc11c \ub18d\uc5c5\uc758 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc774\uba70, \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \uc218\ud655\ub7c9\uc744 \uadf9\ub300\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ube14\ub85d\ud5e4\ub4dc\uc5d0\uc11c \ub18d\uc5c5\uc740 \uc528\uc557\uc744 \uc2ec\uace0, \uc791\ubb3c\uc5d0 \ubb3c\uc744 \uc8fc\uace0, \uc218\ud655\ud558\ub294 \uac83\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \ub2e8\uacc41: \ud480\uc744 \ubd80\uc218\uac70\ub098 \uc57c\uc0dd \uc2dd\ubb3c\uc744 \uc218\ud655\ud558\uc5ec \uc528\uc557\uc744 \uc218\uc9d1\ud569\ub2c8\ub2e4. \ub2e8\uacc42: \uad2d\uc774\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub545\uc744 \uac08\uace0 \uc528\uc557\uc744 \uc2ec\uc2b5\ub2c8\ub2e4. \ub2e8\uacc43: \uc791\ubb3c\uc774 \ub354 \ube68\ub9ac \uc790\ub784 \uc218 \uc788\ub3c4\ub85d \uc815\uae30\uc801\uc73c\ub85c \ubb3c\uc744 \uc90d\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubc00 \uc528\uc557\uc740 \ubc00\ub85c \uc790\ub77c\uba70 \ubc00\uc740 \ube75\uc73c\ub85c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uad50\ud45c]\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc131\uc7a5 \uc2dc\uac04\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4: \ubc00 (5\ubd84) \ub300 \ub2f9\uadfc (7\ubd84). \uc218\ud655\ub7c9\uc744 \uadf9\ub300\ud654\ud558\ub824\uba74 \uc904\uc5d0 \uc2ec\uace0 \ubb3c\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uc0ac\uc6a9\ud569\ub2c8\ub2e4."}, {"question": "\ube14\ub85d\ud5e4\ub4dc\uc758 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \uac8c\uc784 \ud658\uacbd\uc744 \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0a4\uba70, \uc8fc\uc694 \uace0\ub824 \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ube14\ub85d\ud5e4\ub4dc\uc758 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \ud611\ub825\ud558\uace0 \uc790\uc6d0\uc744 \uacf5\uc720\ud558\uace0 \ub354 \ud070 \ud504\ub85c\uc81d\ud2b8\ub97c \uad6c\ucd95\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. \ub2e8\uacc41: \uc11c\ubc84\uc5d0 \ucc38\uc5ec\ud558\uac70\ub098 \uce5c\uad6c\ub97c \ucd08\ub300\ud558\uc5ec \uc138\uc0c1\uc744 \uacf5\uc720\ud569\ub2c8\ub2e4. \ub2e8\uacc42: \uad11\ubd80, \uac74\uc124\uc790 \ub610\ub294 \ub18d\ubd80\uc640 \uac19\uc774 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc5ed\ud560\uc744 \ud560\ub2f9\ud558\uc5ec \ud6a8\uc728\uc131\uc744 \ub192\uc785\ub2c8\ub2e4. \ub2e8\uacc43: \ucc44\ud305\uc774\ub098 \ud45c\uc9c0\ud310\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc758\uc0ac\uc18c\ud1b5\ud558\uace0 \uc791\uc5c5\uc744 \uc870\uc815\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud300\uc740 \ub178\ub3d9\uc744 \ub098\ub204\uc5b4 \uac70\ub300\ud55c \uc131\uc744 \uac74\uc124\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uad50\ud45c]\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc774\uc810\uc744 \uac15\uc870\ud569\ub2c8\ub2e4: \uc2f1\uae00\ud50c\ub808\uc774\uc5b4 (\uc194\ub85c, \ub290\ub9bc) \ub300 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 (\ud611\ub825, \ube60\ub984). \uc911\uc694\ud55c \uace0\ub824 \uc0ac\ud56d\uc740 \uc2e0\ub8b0\uc640 \uba85\ud655\ud55c \uc758\uc0ac\uc18c\ud1b5\uc785\ub2c8\ub2e4."}, {"question": "\ud55c \uae30\uae30\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30\ub85c \ube14\ub85d\ud5e4\ub4dc \uc138\uacc4\ub97c \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud558\ub294 \ub2e8\uacc4\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ube14\ub85d\ud5e4\ub4dc \uc138\uacc4\ub97c \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud558\ub824\uba74 \uc138\uacc4 \ud30c\uc77c\uc744 \ub0b4\ubcf4\ub0b4\uace0 \uac00\uc838\uc624\ub294 \uac83\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc41: \uc6d0\ub798 \uae30\uae30\uc5d0\uc11c \uc138\uacc4 \uc124\uc815\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec \"\uc138\uacc4 \ub0b4\ubcf4\ub0b4\uae30\"\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. \ub2e8\uacc42: \ud074\ub77c\uc6b0\ub4dc \uc11c\ube44\uc2a4 \ub610\ub294 USB\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub0b4\ubcf4\ub0b8 \ud30c\uc77c\uc744 \uc0c8 \uae30\uae30\uc5d0 \uc804\uc1a1\ud569\ub2c8\ub2e4. \ub2e8\uacc43: \uc0c8 \uae30\uae30\uc5d0\uc11c \ube14\ub85d\ud5e4\ub4dc\ub97c \uc5f4\uace0 \"\uc138\uacc4 \uac00\uc838\uc624\uae30\"\ub97c \uc120\ud0dd\ud558\uc5ec \ud30c\uc77c\uc744 \ub85c\ub4dc\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, Google \ub4dc\ub77c\uc774\ube0c\ub97c \uc0ac\uc6a9\ud558\uba74 \uc6d0\ud65c\ud55c \uc804\uc1a1\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4. [\ud750\ub984\ub3c4]\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud504\ub85c\uc138\uc2a4\ub97c \uc2dc\uac01\ud654\ud569\ub2c8\ub2e4: \ub0b4\ubcf4\ub0b4\uae30 \u2192 \uc804\uc1a1 \u2192 \uac00\uc838\uc624\uae30. \uc774 \ubc29\ubc95\uc744 \ud1b5\ud574 \uc5ec\ub7ec \uae30\uae30\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc720\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ube14\ub85d\ud5e4\ub4dc\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc774\uba70, \uac8c\uc784\uc744 \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\uae4c?", "answer": "\ube14\ub85d\ud5e4\ub4dc\uc5d0\ub294 \ud76c\uadc0\ud55c \uc0dd\ud0dc\uacc4\uc640 \ube44\ubc00 \uad6c\uc870\ubb3c\uacfc \uac19\uc740 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc41: \uc2dc\uc791 \uc9c0\uc810\uc5d0\uc11c \uba40\ub9ac \ud0d0\ud5d8\ud558\uc5ec \uc0ac\ub9c9\uc774\ub098 \uc815\uae00\uacfc \uac19\uc740 \ub3c5\ud2b9\ud55c \uc0dd\ud0dc\uacc4\ub97c \ucc3e\uc73c\uc138\uc694. \ub2e8\uacc42: \uadc0\uc911\ud488\uc774 \uc788\ub294 \uc9c0\ud558 \ub358\uc804\uc744 \ucc3e\uc73c\uc138\uc694. \ub2e8\uacc43: \ud658\uacbd\uc5d0\uc11c \uc228\uaca8\uc9c4 \uba54\uc2dc\uc9c0\ub098 \ud328\ud134\uc744 \ud574\ub3c5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc0ac\ub9c9 \uc2e0\uc804\uc744 \ucc3e\uc73c\uba74 \uc885\uc885 \ud76c\uadc0\ud55c \uc544\uc774\ud15c\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc9c0\ub3c4\ub3c4\ud45c]\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc228\uaca8\uc9c4 \uae30\ub2a5\uc758 \uc7a0\uc7ac\uc801 \uc704\uce58\ub97c \ud45c\uc2dc\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ubc1c\uacac\uc740 \uac8c\uc784\uc5d0 \uae4a\uc774\uc640 \ud765\ubd84\uc744 \ub354\ud569\ub2c8\ub2e4."}]
[{"question": "\u30d6\u30ed\u30c3\u30af\u30d8\u30c3\u30c9\u306e\u65b0\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u65e9\u671f\u30b2\u30fc\u30e0\u3067\u3069\u306e\u3088\u3046\u306b\u52b9\u679c\u7684\u306b\u8cc7\u6e90\u3092\u96c6\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d6\u30ed\u30c3\u30af\u30d8\u30c3\u30c9\u3067\u306f\u3001\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u6728\u3084\u77f3\u306a\u3069\u306e\u57fa\u672c\u7684\u306a\u8cc7\u6e90\u3092\u96c6\u3081\u3066\u3001\u91cd\u8981\u306a\u30c4\u30fc\u30eb\u3084\u30b7\u30a7\u30eb\u30bf\u30fc\u3092\u69cb\u7bc9\u3059\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002STEP1\uff1a\u6728\u3092\u63a1\u53d6\u3059\u308b\u305f\u3081\u306b\u6728\u3092\u53e9\u304d\u59cb\u3081\u307e\u3059\u3002STEP2\uff1a\u6728\u6750\u3092\u4f7f\u3063\u3066\u6728\u88fd\u306e\u30d4\u30c3\u30b1\u30eb\u3092\u88fd\u4f5c\u3057\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u77f3\u3092\u63a1\u6398\u3067\u304d\u307e\u3059\u3002STEP3\uff1a\u77f3\u3092\u4f7f\u3063\u3066\u3001\u3088\u308a\u52b9\u7387\u7684\u306b\u8cc7\u6e90\u3092\u96c6\u3081\u308b\u305f\u3081\u306e\u77f3\u306e\u65a7\u3068\u30d4\u30c3\u30b1\u30eb\u3092\u88fd\u4f5c\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u77f3\u306e\u65a7\u306f\u6728\u3092\u53ce\u96c6\u3059\u308b\u901f\u5ea6\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002[\u69cb\u6210\u8868]\u3092\u4f7f\u7528\u3057\u3066\u3001\u3055\u307e\u3056\u307e\u306a\u30c4\u30fc\u30eb\u306e\u52b9\u7387\u3092\u6bd4\u8f03\u3057\u307e\u3059\u3002\u6728\u306e\u65a7\uff08\u901f\u5ea62\u500d\uff09\u3001\u77f3\u306e\u65a7\uff08\u901f\u5ea63\u500d\uff09\u3001\u9244\u306e\u65a7\uff08\u901f\u5ea64\u500d\uff09\u3002\u3053\u306e\u65b9\u6cd5\u306b\u3088\u308a\u3001\u57fa\u672c\u7684\u306a\u30c4\u30fc\u30eb\u304b\u3089\u9ad8\u5ea6\u306a\u30c4\u30fc\u30eb\u3078\u306e\u30b9\u30e0\u30fc\u30ba\u306a\u79fb\u884c\u304c\u4fdd\u8a3c\u3055\u308c\u307e\u3059\u3002"}, {"question": "\u30d6\u30ed\u30c3\u30af\u30d8\u30c3\u30c9\u3067\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u3092\u6ce8\u610f\u6df1\u304f\u7ba1\u7406\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u3069\u306e\u3088\u3046\u306b\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d6\u30ed\u30c3\u30af\u30d8\u30c3\u30c9\u306b\u304a\u3051\u308b\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u306e\u7ba1\u7406\u306f\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u306a\u305c\u306a\u3089\u3001\u9650\u3089\u308c\u305f\u30b9\u30da\u30fc\u30b9\u304c\u9032\u884c\u3092\u963b\u5bb3\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308b\u304b\u3089\u3067\u3059\u3002STEP1\uff1a\u30c4\u30fc\u30eb\u3001\u98df\u6599\u3001\u5efa\u7bc9\u8cc7\u6750\u306e\u3088\u3046\u306a\u91cd\u8981\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u512a\u5148\u3057\u307e\u3059\u3002STEP2\uff1a\u983b\u7e41\u306b\u4f7f\u7528\u3057\u306a\u3044\u30a2\u30a4\u30c6\u30e0\u3092\u4fdd\u7ba1\u3059\u308b\u305f\u3081\u306b\u30c1\u30a7\u30b9\u30c8\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u30a2\u30af\u30c6\u30a3\u30d6\u306a\u30bf\u30b9\u30af\u306b\u5fc5\u8981\u306a\u30b9\u30da\u30fc\u30b9\u304c\u78ba\u4fdd\u3055\u308c\u307e\u3059\u3002STEP3\uff1a\u9271\u77f3\u7528\u3068\u98df\u6599\u7528\u306a\u3069\u3001\u30a2\u30a4\u30c6\u30e0\u3092\u7570\u306a\u308b\u30c1\u30a7\u30b9\u30c8\u306b\u5206\u985e\u3057\u3066\u3001\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u3092\u5b9a\u671f\u7684\u306b\u6574\u7406\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30af\u30e9\u30d5\u30c8\u30a8\u30ea\u30a2\u8fd1\u304f\u306e\u30c1\u30a7\u30b9\u30c8\u306b\u4f59\u5206\u306a\u6728\u6750\u3092\u4fdd\u7ba1\u3059\u308b\u3053\u3068\u3067\u3001\u6642\u9593\u3092\u7bc0\u7d04\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8]\u3067\u30d7\u30ed\u30bb\u30b9\u3092\u8996\u899a\u5316\u3067\u304d\u307e\u3059\u3002\u53ce\u96c6\u2192\u5206\u985e\u2192\u4fdd\u7ba1\u2192\u53d6\u5f97\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306b\u3088\u308a\u3001\u3054\u3061\u3083\u3054\u3061\u3083\u3059\u308b\u3053\u3068\u306a\u304f\u5e38\u306b\u5fc5\u8981\u306a\u3082\u306e\u3092\u78ba\u4fdd\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d6\u30ed\u30c3\u30af\u30d8\u30c3\u30c9\u306e\u5730\u4e0a\u74b0\u5883\u3068\u5730\u4e0b\u74b0\u5883\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u3088\u3046\u306b\u9069\u5fdc\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30d6\u30ed\u30c3\u30af\u30d8\u30c3\u30c9\u306e\u5730\u4e0a\u74b0\u5883\u3068\u5730\u4e0b\u74b0\u5883\u306b\u306f\u3001\u7570\u306a\u308b\u8ab2\u984c\u3068\u8cc7\u6e90\u304c\u7528\u610f\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u5730\u4e0a\u3067\u306f\u3001\u6728\u3001\u77f3\u3001\u98df\u6599\u304c\u8c4a\u5bcc\u306b\u3042\u308b\u305f\u3081\u3001\u521d\u5fc3\u8005\u306b\u3068\u3063\u3066\u7406\u60f3\u7684\u306a\u74b0\u5883\u3067\u3059\u3002\u3057\u304b\u3057\u3001\u5730\u4e0b\u306b\u306f\u9244\u3084\u91d1\u306e\u3088\u3046\u306a\u5e0c\u5c11\u306a\u9271\u77f3\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u304c\u3001\u3088\u308a\u826f\u3044\u30c4\u30fc\u30eb\u3068\u7167\u660e\u304c\u5fc5\u8981\u3067\u3059\u3002STEP1\uff1a\u5730\u4e0b\u3092\u63a1\u6398\u3059\u308b\u524d\u306b\u77f3\u306e\u30d4\u30c3\u30b1\u30eb\u3092\u88c5\u5099\u3057\u307e\u3059\u3002STEP2\uff1a\u6697\u3044\u30a8\u30ea\u30a2\u3092\u7167\u3089\u3057\u3001\u30e2\u30f3\u30b9\u30bf\u30fc\u306e\u51fa\u73fe\u3092\u9632\u3050\u305f\u3081\u306b\u3001\u305f\u3044\u307e\u3064\u3092\u4f5c\u308a\u307e\u3059\u3002STEP3\uff1a\u62e1\u5f35\u3055\u308c\u305f\u63a1\u6398\u65c5\u306e\u969b\u306b\u3001\u5e38\u306b\u4f59\u5206\u306a\u98df\u6599\u3068\u30c4\u30fc\u30eb\u3092\u643a\u5e2f\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5730\u4e0b\u3067\u9244\u9271\u77f3\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u5f37\u529b\u306a\u30c4\u30fc\u30eb\u3092\u4f5c\u308b\u3053\u3068\u304c\u53ef\u80fd\u306b\u306a\u308a\u307e\u3059\u3002[\u6bd4\u8f03\u8868]\u3092\u4f7f\u7528\u3057\u3066\u3001\u9055\u3044\u3092\u5f37\u8abf\u3057\u307e\u3059\u3002\u5730\u4e0a\uff08\u6728\u3001\u77f3\u3001\u65e5\u5149\uff09\u5bfe\u5730\u4e0b\uff08\u9271\u77f3\u3001\u6697\u95c7\u3001\u30e2\u30f3\u30b9\u30bf\u30fc\uff09\u3002\u3053\u308c\u3089\u306e\u74b0\u5883\u306b\u9069\u5fdc\u3059\u308b\u3053\u3068\u306f\u3001\u52b9\u7387\u3092\u6700\u5927\u9650\u306b\u9ad8\u3081\u307e\u3059\u3002"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30d6\u30ed\u30c3\u30af\u30d8\u30c3\u30c9\u3067\u30af\u30e9\u30d5\u30c8\u6226\u7565\u3092\u6700\u9069\u5316\u3057\u3066\u3001\u3088\u308a\u65e9\u304f\u9032\u6b69\u3055\u305b\u308b\u305f\u3081\u306b\u4f55\u3092\u3059\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u30d6\u30ed\u30c3\u30af\u30d8\u30c3\u30c9\u3067\u306e\u30af\u30e9\u30d5\u30c8\u306e\u6700\u9069\u5316\u306f\u3001\u91cd\u8981\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u512a\u5148\u3057\u3001\u30c4\u30fc\u30eb\u3092\u4f53\u7cfb\u7684\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3053\u3068\u3092\u542b\u307f\u307e\u3059\u3002STEP1\uff1a\u6728\u88fd\u306e\u30d4\u30c3\u30b1\u30eb\u3084\u65a7\u306a\u3069\u306e\u57fa\u672c\u7684\u306a\u30c4\u30fc\u30eb\u304b\u3089\u59cb\u3081\u307e\u3059\u3002STEP2\uff1a\u3088\u308a\u8010\u4e45\u6027\u306e\u3042\u308b\u77f3\u306e\u30c4\u30fc\u30eb\u3092\u4f5c\u6210\u3059\u308b\u305f\u3081\u306b\u77f3\u3092\u96c6\u3081\u307e\u3059\u3002STEP3\uff1a\u9271\u77f3\u3092\u91d1\u5c5e\u30c4\u30fc\u30eb\u306b\u6eb6\u9271\u3059\u308b\u7089\u88fd\u4f5c\u306b\u96c6\u4e2d\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u3088\u308a\u52b9\u7387\u7684\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u9244\u306e\u30d4\u30c3\u30b1\u30eb\u306f\u3001\u77f3\u306e\u30d4\u30c3\u30b1\u30eb\u3088\u308a\u3082\u30d6\u30ed\u30c3\u30af\u3092\u65e9\u304f\u63a1\u6398\u3057\u307e\u3059\u3002[\u30b9\u30c6\u30c3\u30d7\u30d0\u30a4\u30b9\u30c6\u30c3\u30d7\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8]\u3092\u4f7f\u7528\u3057\u3066\u3001\u30af\u30e9\u30d5\u30c8\u30d7\u30ed\u30bb\u30b9\u3092\u30ac\u30a4\u30c9\u3057\u307e\u3059\u3002\u8cc7\u6e90\u53ce\u96c6\u2192\u57fa\u672c\u7684\u306a\u30c4\u30fc\u30eb\u306e\u30af\u30e9\u30d5\u30c8\u2192\u77f3\u3078\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u2192\u9271\u77f3\u306e\u6eb6\u9271\u2192\u91d1\u5c5e\u30c4\u30fc\u30eb\u306e\u30af\u30e9\u30d5\u30c8\u3002\u3053\u306e\u6226\u7565\u306b\u3088\u308a\u3001\u7740\u5b9f\u306a\u9032\u884c\u304c\u4fdd\u8a3c\u3055\u308c\u307e\u3059\u3002"}, {"question": "\u6301\u7d9a\u53ef\u80fd\u306a\u57fa\u5730\u3092\u30d6\u30ed\u30c3\u30af\u30d8\u30c3\u30c9\u3067\u69cb\u7bc9\u3059\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d6\u30ed\u30c3\u30af\u30d8\u30c3\u30c9\u3067\u6301\u7d9a\u53ef\u80fd\u306a\u57fa\u5730\u3092\u69cb\u7bc9\u3059\u308b\u306b\u306f\u3001\u8a08\u753b\u3068\u8cc7\u6e90\u7ba1\u7406\u304c\u5fc5\u8981\u3067\u3059\u3002STEP1\uff1a\u6728\u3084\u6c34\u306a\u3069\u306e\u91cd\u8981\u306a\u8cc7\u6e90\u306e\u8fd1\u304f\u306b\u5834\u6240\u3092\u9078\u3073\u307e\u3059\u3002STEP2\uff1a\u30e2\u30f3\u30b9\u30bf\u30fc\u304b\u3089\u8eab\u3092\u5b88\u308b\u305f\u3081\u306e\u58c1\u3068\u5c4b\u6839\u306e\u3042\u308b\u57fa\u672c\u7684\u306a\u30b7\u30a7\u30eb\u30bf\u30fc\u3092\u5efa\u8a2d\u3057\u307e\u3059\u3002STEP3\uff1a\u98df\u6599\u306e\u8fb2\u5834\u3084\u4fdd\u7ba1\u7528\u306e\u30c1\u30a7\u30b9\u30c8\u3092\u8ffd\u52a0\u3057\u3066\u3001\u57fa\u5730\u3092\u62e1\u5f35\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5c0f\u9ea6\u7551\u306f\u5b89\u5b9a\u3057\u305f\u98df\u6599\u6e90\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002[\u6bd4\u8f03\u8868]\u3092\u4f7f\u7528\u3057\u3066\u3001\u57fa\u5730\u306e\u5834\u6240\u3092\u8a55\u4fa1\u3057\u307e\u3059\u3002\u6728\u306e\u8fd1\u304f\uff08\u6728\u304c\u7c21\u5358\uff09\u5bfe\u6c34\u306e\u8fd1\u304f\uff08\u8fb2\u696d\u304c\u7c21\u5358\uff09\u3002\u3053\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u306b\u3088\u308a\u3001\u9577\u671f\u7684\u306a\u751f\u5b58\u3068\u52b9\u7387\u304c\u4fdd\u8a3c\u3055\u308c\u307e\u3059\u3002"}, {"question": "\u30d6\u30ed\u30c3\u30af\u30d8\u30c3\u30c9\u306e\u65e5\u4e2d\u30b5\u30a4\u30af\u30eb\u306f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u4f55\u3092\u6e96\u5099\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30d6\u30ed\u30c3\u30af\u30d8\u30c3\u30c9\u306e\u65e5\u4e2d\u30b5\u30a4\u30af\u30eb\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u8ab2\u984c\u3068\u6a5f\u4f1a\u3092\u3082\u305f\u3089\u3057\u307e\u3059\u3002\u663c\u9593\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u8cc7\u6e90\u3092\u96c6\u3081\u3066\u5b89\u5168\u306b\u63a2\u7d22\u3067\u304d\u307e\u3059\u3002\u591c\u306b\u306a\u308b\u3068\u3001\u30e2\u30f3\u30b9\u30bf\u30fc\u304c\u51fa\u73fe\u3057\u3001\u5916\u3078\u51fa\u308b\u3053\u3068\u306f\u5371\u967a\u306b\u306a\u308a\u307e\u3059\u3002STEP1\uff1a\u663c\u9593\u306b\u5fc5\u9808\u306e\u8cc7\u6e90\u3092\u96c6\u3081\u3066\u30b7\u30a7\u30eb\u30bf\u30fc\u3092\u69cb\u7bc9\u3057\u307e\u3059\u3002STEP2\uff1a\u57fa\u5730\u3092\u7167\u3089\u3057\u3001\u30e2\u30f3\u30b9\u30bf\u30fc\u306e\u51fa\u73fe\u3092\u9632\u3050\u305f\u3081\u306b\u3001\u305f\u3044\u307e\u3064\u3092\u4f5c\u308a\u307e\u3059\u3002STEP3\uff1a\u30d9\u30c3\u30c9\u3067\u5bdd\u3066\u591c\u3092\u98db\u3070\u3057\u3001\u5371\u967a\u3092\u56de\u907f\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d9\u30c3\u30c9\u3067\u5bdd\u308b\u3068\u3001\u4f53\u529b\u306f\u56de\u5fa9\u3057\u3001\u591c\u306e\u30b5\u30a4\u30af\u30eb\u306f\u30b9\u30ad\u30c3\u30d7\u3055\u308c\u307e\u3059\u3002[\u30bf\u30a4\u30e0\u30e9\u30a4\u30f3\u56f3]\u3092\u4f7f\u7528\u3057\u3066\u3001\u30b5\u30a4\u30af\u30eb\u3092\u793a\u3057\u307e\u3059\u3002\u65e5\uff08\u5b89\u5168\u3001\u53ce\u96c6\uff09\u2192\u591c\uff08\u5371\u967a\u3001\u7761\u7720\uff09\u3002\u591c\u306b\u5411\u3051\u3066\u6e96\u5099\u3059\u308b\u3053\u3068\u306f\u3001\u5b89\u5168\u3055\u3068\u52b9\u7387\u306e\u78ba\u4fdd\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002"}, {"question": "\u30d6\u30ed\u30c3\u30af\u30d8\u30c3\u30c9\u3067\u306e\u8fb2\u696d\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u3088\u3046\u306b\u53ce\u91cf\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d6\u30ed\u30c3\u30af\u30d8\u30c3\u30c9\u3067\u306e\u8fb2\u696d\u306f\u3001\u7a2e\u3092\u690d\u3048\u3001\u4f5c\u7269\u3092\u6c34\u3084\u308a\u3057\u3001\u53ce\u7a6b\u3059\u308b\u3053\u3068\u3067\u3059\u3002STEP1\uff1a\u829d\u751f\u3092\u7834\u58ca\u3059\u308b\u304b\u3001\u91ce\u751f\u690d\u7269\u3092\u53ce\u7a6b\u3059\u308b\u3053\u3068\u3067\u7a2e\u3092\u96c6\u3081\u307e\u3059\u3002STEP2\uff1a\u92e4\u3092\u4f7f\u3063\u3066\u571f\u3092\u8015\u3057\u3001\u7a2e\u3092\u690d\u3048\u307e\u3059\u3002STEP3\uff1a\u4f5c\u7269\u304c\u3088\u308a\u65e9\u304f\u6210\u9577\u3059\u308b\u3088\u3046\u306b\u3001\u4f5c\u7269\u3092\u5b9a\u671f\u7684\u306b\u6c34\u3084\u308a\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5c0f\u9ea6\u306e\u7a2e\u306f\u5c0f\u9ea6\u306b\u306a\u308a\u3001\u5c0f\u9ea6\u306f\u30d1\u30f3\u306a\u3069\u306b\u52a0\u5de5\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03\u8868]\u3092\u4f7f\u7528\u3057\u3066\u3001\u6210\u9577\u6642\u9593\u3092\u793a\u3057\u307e\u3059\u3002\u5c0f\u9ea6\uff085\u5206\u9593\uff09\u5bfe\u30cb\u30f3\u30b8\u30f3\uff087\u5206\u9593\uff09\u3002\u53ce\u91cf\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u4e26\u884c\u3057\u3066\u690d\u3048\u3001\u6c34\u3092\u52b9\u7387\u7684\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002"}, {"question": "\u30d6\u30ed\u30c3\u30af\u30d8\u30c3\u30c9\u306e\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u3001\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u3069\u306e\u3088\u3046\u306b\u5411\u4e0a\u3055\u305b\u307e\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u4e3b\u8981\u306a\u8003\u616e\u4e8b\u9805\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d6\u30ed\u30c3\u30af\u30d8\u30c3\u30c9\u306e\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3067\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u5354\u529b\u3057\u3001\u8cc7\u6e90\u3092\u5171\u6709\u3057\u3001\u3088\u308a\u5927\u304d\u306a\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u3092\u69cb\u7bc9\u3067\u304d\u307e\u3059\u3002STEP1\uff1a\u30b5\u30fc\u30d0\u30fc\u306b\u53c2\u52a0\u3059\u308b\u304b\u3001\u53cb\u4eba\u3092\u304a\u8a98\u3044\u3057\u3066\u3042\u306a\u305f\u306e\u4e16\u754c\u306b\u53c2\u52a0\u3055\u305b\u307e\u3059\u3002STEP2\uff1a\u30de\u30a4\u30ca\u30fc\u3001\u30d3\u30eb\u30c0\u30fc\u3001\u30d5\u30a1\u30fc\u30de\u30fc\u306a\u3069\u306e\u5f79\u5272\u3092\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u5272\u308a\u5f53\u3066\u308b\u3053\u3068\u3067\u3001\u52b9\u7387\u3092\u6700\u9069\u5316\u3057\u307e\u3059\u3002STEP3\uff1a\u30c1\u30e3\u30c3\u30c8\u3084\u770b\u677f\u3092\u4f7f\u7528\u3057\u3066\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u3092\u53d6\u308a\u3001\u30bf\u30b9\u30af\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30c1\u30fc\u30e0\u306f\u52b4\u50cd\u3092\u5206\u3051\u308b\u3053\u3068\u3067\u3001\u5de8\u5927\u306a\u57ce\u3092\u5efa\u8a2d\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03\u8868]\u3092\u4f7f\u7528\u3057\u3066\u3001\u5229\u70b9\u3092\u5f37\u8abf\u3057\u307e\u3059\u3002\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\uff08\u30bd\u30ed\u3001\u9045\u3044\uff09\u5bfe\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\uff08\u5354\u529b\u3001\u901f\u3044\uff09\u3002\u91cd\u8981\u306a\u8003\u616e\u4e8b\u9805\u306b\u306f\u3001\u4fe1\u983c\u3068\u660e\u78ba\u306a\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u304c\u542b\u307e\u308c\u307e\u3059\u3002"}, {"question": "\u30d6\u30ed\u30c3\u30af\u30d8\u30c3\u30c9\u306e\u4e16\u754c\u3092\u5225\u306e\u30c7\u30d0\u30a4\u30b9\u306b\u79fb\u884c\u3059\u308b\u306b\u306f\u3001\u3069\u306e\u3088\u3046\u306a\u624b\u9806\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30d6\u30ed\u30c3\u30af\u30d8\u30c3\u30c9\u306e\u4e16\u754c\u3092\u5225\u306e\u30c7\u30d0\u30a4\u30b9\u306b\u79fb\u884c\u3059\u308b\u306b\u306f\u3001\u4e16\u754c\u30d5\u30a1\u30a4\u30eb\u3092\u30a8\u30af\u30b9\u30dd\u30fc\u30c8\u3057\u3066\u30a4\u30f3\u30dd\u30fc\u30c8\u3057\u307e\u3059\u3002STEP1\uff1a\u5143\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u3001\u4e16\u754c\u306e\u8a2d\u5b9a\u306b\u79fb\u52d5\u3057\u3001\u300c\u4e16\u754c\u3092\u30a8\u30af\u30b9\u30dd\u30fc\u30c8\u300d\u3092\u9078\u629e\u3057\u307e\u3059\u3002STEP2\uff1a\u30a8\u30af\u30b9\u30dd\u30fc\u30c8\u3055\u308c\u305f\u30d5\u30a1\u30a4\u30eb\u3092\u30af\u30e9\u30a6\u30c9\u30b5\u30fc\u30d3\u30b9\u307e\u305f\u306fUSB\u3092\u4f7f\u7528\u3057\u3066\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u8ee2\u9001\u3057\u307e\u3059\u3002STEP3\uff1a\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u30d6\u30ed\u30c3\u30af\u30d8\u30c3\u30c9\u3092\u958b\u304d\u3001\u300c\u4e16\u754c\u3092\u30a4\u30f3\u30dd\u30fc\u30c8\u300d\u3092\u9078\u629e\u3057\u3066\u30d5\u30a1\u30a4\u30eb\u3092\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001Google\u30c9\u30e9\u30a4\u30d6\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u30b9\u30e0\u30fc\u30ba\u306a\u8ee2\u9001\u304c\u4fdd\u8a3c\u3055\u308c\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8]\u3092\u4f7f\u7528\u3057\u3066\u3001\u30d7\u30ed\u30bb\u30b9\u3092\u8996\u899a\u5316\u3057\u307e\u3059\u3002\u30a8\u30af\u30b9\u30dd\u30fc\u30c8\u2192\u8ee2\u9001\u2192\u30a4\u30f3\u30dd\u30fc\u30c8\u3002\u3053\u306e\u65b9\u6cd5\u306b\u3088\u308a\u3001\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u3042\u306a\u305f\u306e\u9032\u884c\u72b6\u6cc1\u304c\u4fdd\u5b58\u3055\u308c\u307e\u3059\u3002"}, {"question": "\u30d6\u30ed\u30c3\u30af\u30d8\u30c3\u30c9\u3067\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u306f\u30b2\u30fc\u30e0\u3092\u3069\u306e\u3088\u3046\u306b\u5411\u4e0a\u3055\u305b\u307e\u3059\u304b\uff1f", "answer": "\u30d6\u30ed\u30c3\u30af\u30d8\u30c3\u30c9\u306b\u306f\u3001\u73cd\u3057\u3044\u30d0\u30a4\u30aa\u30fc\u30e0\u3084\u79d8\u5bc6\u306e\u69cb\u9020\u7269\u306a\u3069\u306e\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u304c\u3042\u308a\u307e\u3059\u3002STEP1\uff1a\u958b\u59cb\u5730\u70b9\u304b\u3089\u9060\u304f\u3092\u63a2\u691c\u3057\u3066\u3001\u7802\u6f20\u3084\u30b8\u30e3\u30f3\u30b0\u30eb\u306a\u3069\u306e\u30e6\u30cb\u30fc\u30af\u306a\u30d0\u30a4\u30aa\u30fc\u30e0\u3092\u898b\u3064\u3051\u307e\u3059\u3002STEP2\uff1a\u8cb4\u91cd\u306a\u6226\u5229\u54c1\u304c\u3042\u308b\u5730\u4e0b\u30c0\u30f3\u30b8\u30e7\u30f3\u3092\u63a2\u3057\u307e\u3059\u3002STEP3\uff1a\u74b0\u5883\u5185\u306e\u96a0\u3055\u308c\u305f\u30e1\u30c3\u30bb\u30fc\u30b8\u3084\u30d1\u30bf\u30fc\u30f3\u3092\u89e3\u8aad\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u7802\u6f20\u306e\u5bfa\u9662\u3092\u767a\u898b\u3059\u308b\u3068\u3001\u901a\u5e38\u306f\u73cd\u3057\u3044\u30a2\u30a4\u30c6\u30e0\u304c\u5f97\u3089\u308c\u307e\u3059\u3002\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u306e\u6f5c\u5728\u7684\u306a\u5834\u6240\u3092\u793a\u3059[\u30de\u30c3\u30d7\u56f3]\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u767a\u898b\u306b\u3088\u308a\u3001\u30b2\u30fc\u30e0\u306b\u5965\u884c\u304d\u3068\u8208\u596e\u304c\u52a0\u308f\u308a\u307e\u3059\u3002"}]
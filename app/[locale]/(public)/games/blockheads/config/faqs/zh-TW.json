[{"question": "\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u65b9\u584a\u982d\u300b\u65e9\u671f\u904a\u6232\u4e2d\u6709\u6548\u5730\u6536\u96c6\u8cc7\u6e90\uff1f", "answer": "\u5728\u300a\u65b9\u584a\u982d\u300b\u4e2d\uff0c\u65b0\u624b\u73a9\u5bb6\u61c9\u5c08\u6ce8\u65bc\u6536\u96c6\u57fa\u672c\u7684\u8cc7\u6e90\uff0c\u4f8b\u5982\u6728\u6750\u548c\u77f3\u982d\uff0c\u4ee5\u5efa\u9020\u5fc5\u8981\u7684\u5de5\u5177\u548c\u5e87\u8b77\u6240\u3002\u6b65\u9a5f1\uff1a\u9996\u5148\u6572\u64ca\u6a39\u6728\u6536\u96c6\u6728\u6750\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u6728\u6750\u88fd\u4f5c\u6728\u982d\u65a7\u982d\uff0c\u7528\u65bc\u958b\u63a1\u77f3\u982d\u3002\u6b65\u9a5f3\uff1a\u7528\u77f3\u982d\u88fd\u4f5c\u77f3\u982d\u65a7\u982d\u548c\u77f3\u982d\u93ac\uff0c\u4ee5\u66f4\u6709\u6548\u5730\u6536\u96c6\u8cc7\u6e90\u3002\u4f8b\u5982\uff0c\u77f3\u982d\u65a7\u982d\u986f\u8457\u5730\u52a0\u5feb\u4e86\u6728\u6750\u6536\u96c6\u901f\u5ea6\u3002\u4f7f\u7528[\u914d\u7f6e\u8868\u683c]\u6bd4\u8f03\u4e0d\u540c\u5de5\u5177\u7684\u6548\u7387\uff1a\u6728\u65a7\u982d\uff08\u901f\u5ea6x2\uff09\uff0c\u77f3\u65a7\u982d\uff08\u901f\u5ea6x3\uff09\uff0c\u9435\u65a7\u982d\uff08\u901f\u5ea6x4\uff09\u3002\u6b64\u65b9\u6cd5\u78ba\u4fdd\u5e73\u7a69\u5730\u5f9e\u57fa\u672c\u7684\u5de5\u5177\u904e\u6e21\u5230\u9ad8\u7d1a\u5de5\u5177\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u5728\u300a\u65b9\u584a\u982d\u300b\u4e2d\u4ed4\u7d30\u7ba1\u7406\u4f60\u7684\u7269\u54c1\u6b04\u5f88\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u6709\u6548\u5730\u505a\u5230\u9019\u4e00\u9ede\uff1f", "answer": "\u300a\u65b9\u584a\u982d\u300b\u4e2d\u7684\u7269\u54c1\u6b04\u7ba1\u7406\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u6709\u9650\u7684\u7a7a\u9593\u6703\u963b\u7919\u9032\u5ea6\u3002\u6b65\u9a5f1\uff1a\u512a\u5148\u8003\u616e\u5fc5\u8981\u7684\u7269\u54c1\uff0c\u4f8b\u5982\u5de5\u5177\u3001\u98df\u7269\u548c\u5efa\u7bc9\u6750\u6599\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u7bb1\u5b50\u5b58\u5132\u4e0d\u592a\u5e38\u7528\u7684\u7269\u54c1\uff0c\u70ba\u7a4d\u6975\u4efb\u52d9\u9a30\u51fa\u7a7a\u9593\u3002\u6b65\u9a5f3\uff1a\u5b9a\u671f\u6574\u7406\u60a8\u7684\u7269\u54c1\u6b04\uff0c\u5c07\u7269\u54c1\u5206\u985e\u5230\u4e0d\u540c\u7684\u7bb1\u5b50\u4e2d\uff0c\u4f8b\u5982\u4e00\u500b\u7528\u65bc\u7926\u77f3\uff0c\u53e6\u4e00\u500b\u7528\u65bc\u98df\u7269\u3002\u4f8b\u5982\uff0c\u5728\u4f60\u7684\u88fd\u4f5c\u5340\u57df\u9644\u8fd1\u653e\u7f6e\u984d\u5916\u7684\u6728\u6750\u5230\u7bb1\u5b50\u88e1\u53ef\u4ee5\u7bc0\u7701\u6642\u9593\u3002[\u6d41\u7a0b\u5716]\u53ef\u4ee5\u5e6b\u52a9\u53ef\u8996\u5316\u9019\u500b\u904e\u7a0b\uff1a\u6536\u96c6\u2192\u5206\u985e\u2192\u5132\u5b58\u2192\u63d0\u53d6\u3002\u6b64\u7cfb\u7d71\u78ba\u4fdd\u60a8\u59cb\u7d42\u64c1\u6709\u6240\u9700\u7269\u54c1\uff0c\u800c\u4e0d\u6703\u96dc\u4e82\u7121\u7ae0\u3002"}, {"question": "\u300a\u65b9\u584a\u982d\u300b\u4e2d\u5730\u9762\u74b0\u5883\u548c\u5730\u4e0b\u74b0\u5883\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff0c\u73a9\u5bb6\u61c9\u8a72\u5982\u4f55\u9069\u61c9\uff1f", "answer": "\u300a\u65b9\u584a\u982d\u300b\u4e2d\u7684\u5730\u9762\u548c\u5730\u4e0b\u74b0\u5883\u63d0\u4f9b\u4e86\u4e0d\u540c\u7684\u6311\u6230\u548c\u8cc7\u6e90\u3002\u5728\u5730\u9762\u4e0a\uff0c\u73a9\u5bb6\u6703\u767c\u73fe\u8c50\u5bcc\u7684\u6728\u6750\u3001\u77f3\u982d\u548c\u98df\u7269\uff0c\u9019\u5c0d\u65bc\u521d\u5b78\u8005\u4f86\u8aaa\u975e\u5e38\u7406\u60f3\u3002\u7136\u800c\uff0c\u5730\u4e0b\u537b\u5305\u542b\u4e86\u7a00\u6709\u7926\u77f3\uff0c\u5982\u9435\u548c\u9ec3\u91d1\uff0c\u4f46\u9700\u8981\u66f4\u597d\u7684\u5de5\u5177\u548c\u7167\u660e\u3002\u6b65\u9a5f1\uff1a\u5728\u958b\u59cb\u6316\u6398\u5730\u4e0b\u4e4b\u524d\uff0c\u88dd\u5099\u77f3\u982d\u93ac\u3002\u6b65\u9a5f2\uff1a\u88fd\u4f5c\u706b\u628a\u7167\u4eae\u9ed1\u6697\u5340\u57df\uff0c\u4e26\u9632\u6b62\u602a\u7269\u751f\u6210\u3002\u6b65\u9a5f3\uff1a\u651c\u5e36\u984d\u5916\u7684\u98df\u7269\u548c\u5de5\u5177\uff0c\u4ee5\u9032\u884c\u9577\u6642\u9593\u7684\u63a1\u7926\u4e4b\u65c5\u3002\u4f8b\u5982\uff0c\u5728\u5730\u4e0b\u767c\u73fe\u9435\u7926\u77f3\u53ef\u4ee5\u88fd\u4f5c\u66f4\u5805\u56fa\u7684\u5de5\u5177\u3002\u4f7f\u7528[\u6bd4\u8f03\u8868]\u7a81\u51fa\u986f\u793a\u5dee\u7570\uff1a\u5730\u9762\uff08\u6728\u6750\u3001\u77f3\u982d\u3001\u65e5\u5149\uff09\u8207\u5730\u4e0b\uff08\u7926\u77f3\u3001\u9ed1\u6697\u3001\u602a\u7269\uff09\u3002\u9069\u61c9\u9019\u4e9b\u74b0\u5883\u53ef\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u6548\u7387\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u65b9\u584a\u982d\u300b\u4e2d\u512a\u5316\u4ed6\u5011\u7684\u88fd\u4f5c\u7b56\u7565\u4ee5\u66f4\u5feb\u5730\u9032\u6b65\uff1f", "answer": "\u5728\u300a\u65b9\u584a\u982d\u300b\u4e2d\u512a\u5316\u88fd\u4f5c\u9700\u8981\u512a\u5148\u8003\u616e\u5fc5\u8981\u7684\u7269\u54c1\u4e26\u7cfb\u7d71\u5730\u5347\u7d1a\u5de5\u5177\u3002\u6b65\u9a5f1\uff1a\u5f9e\u57fa\u672c\u7684\u5de5\u5177\uff0c\u4f8b\u5982\u6728\u982d\u93ac\u548c\u65a7\u982d\u958b\u59cb\u3002\u6b65\u9a5f2\uff1a\u6536\u96c6\u77f3\u982d\u4ee5\u88fd\u4f5c\u66f4\u5805\u56fa\u7684\u77f3\u982d\u5de5\u5177\u3002\u6b65\u9a5f3\uff1a\u5c08\u6ce8\u65bc\u88fd\u4f5c\u7194\u7210\uff0c\u5c07\u7926\u7269\u51b6\u7149\u6210\u91d1\u5c6c\u5de5\u5177\uff0c\u9019\u4e9b\u5de5\u5177\u6548\u7387\u66f4\u9ad8\u3002\u4f8b\u5982\uff0c\u9435\u93ac\u6bd4\u77f3\u982d\u93ac\u6316\u6398\u65b9\u584a\u66f4\u5feb\u3002\u4f7f\u7528[\u5206\u6b65\u6d41\u7a0b\u5716]\u6307\u5c0e\u88fd\u4f5c\u904e\u7a0b\uff1a\u6536\u96c6\u8cc7\u6e90\u2192\u88fd\u4f5c\u57fa\u672c\u5de5\u5177\u2192\u5347\u7d1a\u5230\u77f3\u982d\u2192\u51b6\u7149\u7926\u77f3\u2192\u88fd\u4f5c\u91d1\u5c6c\u5de5\u5177\u3002\u6b64\u7b56\u7565\u78ba\u4fdd\u6301\u7e8c\u7684\u9032\u6b65\u3002"}, {"question": "\u5728\u300a\u65b9\u584a\u982d\u300b\u4e2d\u5efa\u7acb\u53ef\u6301\u7e8c\u57fa\u5730\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u300a\u65b9\u584a\u982d\u300b\u4e2d\u5efa\u7acb\u53ef\u6301\u7e8c\u57fa\u5730\u9700\u8981\u898f\u5283\u548c\u8cc7\u6e90\u7ba1\u7406\u3002\u6b65\u9a5f1\uff1a\u9078\u64c7\u9760\u8fd1\u57fa\u672c\u8cc7\u6e90\uff08\u4f8b\u5982\u6a39\u6728\u548c\u6c34\uff09\u7684\u4f4d\u7f6e\u3002\u6b65\u9a5f2\uff1a\u5efa\u9020\u5e36\u6709\u7246\u58c1\u548c\u5c4b\u9802\u7684\u57fa\u672c\u5e87\u8b77\u6240\uff0c\u4ee5\u4fdd\u8b77\u514d\u53d7\u602a\u7269\u8972\u64ca\u3002\u6b65\u9a5f3\uff1a\u901a\u904e\u6dfb\u52a0\u8fb2\u5834\uff08\u7528\u65bc\u98df\u7269\uff09\u548c\u7bb1\u5b50\uff08\u7528\u65bc\u5132\u5b58\uff09\u4f86\u64f4\u5c55\u4f60\u7684\u57fa\u5730\u3002\u4f8b\u5982\uff0c\u9ea5\u7530\u63d0\u4f9b\u7a69\u5b9a\u7684\u98df\u7269\u4f86\u6e90\u3002\u4f7f\u7528[\u6bd4\u8f03\u8868]\u8a55\u4f30\u57fa\u5730\u4f4d\u7f6e\uff1a\u9760\u8fd1\u6a39\u6728\uff08\u5bb9\u6613\u7372\u5f97\u6728\u6750\uff09\u8207\u9760\u8fd1\u6c34\u6e90\uff08\u5bb9\u6613\u9032\u884c\u8015\u4f5c\uff09\u3002\u9019\u7a2e\u65b9\u6cd5\u78ba\u4fdd\u9577\u671f\u7684\u751f\u5b58\u548c\u6548\u7387\u3002"}, {"question": "\u300a\u65b9\u584a\u982d\u300b\u4e2d\u7684\u665d\u591c\u5faa\u74b0\u5982\u4f55\u5f71\u97ff\u904a\u6232\uff0c\u73a9\u5bb6\u61c9\u8a72\u505a\u4e9b\u4ec0\u9ebc\u6e96\u5099\uff1f", "answer": "\u300a\u65b9\u584a\u982d\u300b\u4e2d\u7684\u665d\u591c\u5faa\u74b0\u5f15\u5165\u4e86\u4e0d\u540c\u7684\u6311\u6230\u548c\u6a5f\u9047\u3002\u767d\u5929\uff0c\u73a9\u5bb6\u53ef\u4ee5\u5b89\u5168\u5730\u6536\u96c6\u8cc7\u6e90\u548c\u63a2\u7d22\u3002\u665a\u4e0a\uff0c\u602a\u7269\u751f\u6210\uff0c\u4f7f\u5916\u51fa\u8b8a\u5f97\u5371\u96aa\u3002\u6b65\u9a5f1\uff1a\u5229\u7528\u767d\u5929\u6536\u96c6\u5fc5\u8981\u7684\u8cc7\u6e90\u4e26\u5efa\u9020\u5e87\u8b77\u6240\u3002\u6b65\u9a5f2\uff1a\u88fd\u4f5c\u706b\u628a\u7167\u4eae\u4f60\u7684\u57fa\u5730\u4e26\u9632\u6b62\u602a\u7269\u751f\u6210\u3002\u6b65\u9a5f3\uff1a\u7761\u5728\u5e8a\u4e0a\u8df3\u904e\u591c\u665a\u4e26\u907f\u514d\u5371\u96aa\u3002\u4f8b\u5982\uff0c\u7761\u5728\u5e8a\u4e0a\u53ef\u4ee5\u6062\u5fa9\u5065\u5eb7\u4e26\u8df3\u904e\u591c\u665a\u5faa\u74b0\u3002\u4f7f\u7528[\u6642\u9593\u8ef8\u5716\u8868]\u4f86\u8aaa\u660e\u5faa\u74b0\uff1a\u767d\u5929\uff08\u5b89\u5168\uff0c\u6536\u96c6\uff09\u2192\u665a\u4e0a\uff08\u5371\u96aa\uff0c\u7761\u7720\uff09\u3002\u70ba\u665a\u4e0a\u505a\u597d\u6e96\u5099\uff0c\u78ba\u4fdd\u5b89\u5168\u548c\u6548\u7387\u3002"}, {"question": "\u300a\u65b9\u584a\u982d\u300b\u4e2d\u8fb2\u696d\u80cc\u5f8c\u7684\u6a5f\u5236\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u5927\u5316\u7522\u91cf\uff1f", "answer": "\u300a\u65b9\u584a\u982d\u300b\u4e2d\u7684\u8fb2\u696d\u5305\u62ec\u7a2e\u690d\u7a2e\u5b50\u3001\u6f86\u6c34\u4f5c\u7269\u548c\u6536\u7a6b\u4f5c\u7269\u3002\u6b65\u9a5f1\uff1a\u901a\u904e\u7834\u58de\u8349\u5730\u6216\u6536\u7a6b\u91ce\u8349\u4f86\u6536\u96c6\u7a2e\u5b50\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u92e4\u982d\u8015\u5730\u4e26\u7a2e\u690d\u7a2e\u5b50\u3002\u6b65\u9a5f3\uff1a\u5b9a\u671f\u6f86\u6c34\u4f5c\u7269\u4ee5\u78ba\u4fdd\u5b83\u5011\u751f\u9577\u66f4\u5feb\u3002\u4f8b\u5982\uff0c\u9ea5\u7a2e\u5b50\u6703\u9577\u6210\u5c0f\u9ea5\uff0c\u53ef\u4ee5\u88fd\u4f5c\u6210\u9eb5\u5305\u3002\u4f7f\u7528[\u6bd4\u8f03\u8868]\u986f\u793a\u751f\u9577\u6642\u9593\uff1a\u5c0f\u9ea5\uff085\u5206\u9418\uff09vs. \u80e1\u863f\u8514\uff087\u5206\u9418\uff09\u3002\u6700\u5927\u5316\u7522\u91cf\u5305\u62ec\u6309\u884c\u7a2e\u690d\u4e26\u6709\u6548\u5730\u4f7f\u7528\u6c34\u3002"}, {"question": "\u300a\u65b9\u584a\u982d\u300b\u4e2d\u7684\u591a\u4eba\u6a21\u5f0f\u5982\u4f55\u589e\u5f37\u904a\u6232\u9ad4\u9a57\uff0c\u4ee5\u53ca\u9700\u8981\u6ce8\u610f\u54ea\u4e9b\u95dc\u9375\u4e8b\u9805\uff1f", "answer": "\u300a\u65b9\u584a\u982d\u300b\u4e2d\u7684\u591a\u4eba\u6a21\u5f0f\u5141\u8a31\u73a9\u5bb6\u5408\u4f5c\u3001\u5171\u4eab\u8cc7\u6e90\u548c\u5efa\u9020\u66f4\u5927\u7684\u9805\u76ee\u3002\u6b65\u9a5f1\uff1a\u52a0\u5165\u4f3a\u670d\u5668\u6216\u9080\u8acb\u670b\u53cb\u5230\u4f60\u7684\u4e16\u754c\u3002\u6b65\u9a5f2\uff1a\u5206\u914d\u89d2\u8272\u7d66\u4e0d\u540c\u7684\u73a9\u5bb6\uff0c\u4f8b\u5982\u63a1\u7926\u8005\u3001\u5efa\u7bc9\u8005\u6216\u8fb2\u592b\uff0c\u4ee5\u512a\u5316\u6548\u7387\u3002\u6b65\u9a5f3\uff1a\u4f7f\u7528\u804a\u5929\u6216\u6a19\u8a8c\u9032\u884c\u6e9d\u901a\u548c\u5354\u8abf\u4efb\u52d9\u3002\u4f8b\u5982\uff0c\u4e00\u500b\u5718\u968a\u53ef\u4ee5\u901a\u904e\u5206\u5de5\u4f86\u5efa\u9020\u4e00\u5ea7\u5de8\u5927\u7684\u57ce\u5821\u3002\u4f7f\u7528[\u6bd4\u8f03\u8868]\u7a81\u51fa\u986f\u793a\u597d\u8655\uff1a\u55ae\u4eba\u6a21\u5f0f\uff08\u7368\u81ea\u4e00\u4eba\uff0c\u901f\u5ea6\u8f03\u6162\uff09\u8207\u591a\u4eba\u6a21\u5f0f\uff08\u5408\u4f5c\uff0c\u901f\u5ea6\u8f03\u5feb\uff09\u3002\u95dc\u9375\u8003\u91cf\u5305\u62ec\u4fe1\u4efb\u548c\u6e05\u6670\u7684\u6e9d\u901a\u3002"}, {"question": "\u5728\u300a\u65b9\u584a\u982d\u300b\u5982\u4f55\u5c07\u4f60\u7684\u4e16\u754c\u5f9e\u4e00\u500b\u8a2d\u5099\u9077\u79fb\u5230\u53e6\u4e00\u500b\u8a2d\u5099\uff1f", "answer": "\u5c07\u4f60\u7684\u300a\u65b9\u584a\u982d\u300b\u4e16\u754c\u9077\u79fb\u5230\u53e6\u4e00\u500b\u8a2d\u5099\u9700\u8981\u5c0e\u51fa\u548c\u5c0e\u5165\u4e16\u754c\u6a94\u6848\u3002\u6b65\u9a5f1\uff1a\u5728\u539f\u59cb\u8a2d\u5099\u4e0a\uff0c\u524d\u5f80\u4e16\u754c\u8a2d\u7f6e\u4e26\u9078\u64c7\u300c\u5c0e\u51fa\u4e16\u754c\u300d\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u96f2\u7aef\u670d\u52d9\u6216 USB \u5c07\u5c0e\u51fa\u7684\u6a94\u6848\u50b3\u8f38\u5230\u65b0\u8a2d\u5099\u3002\u6b65\u9a5f3\uff1a\u5728\u65b0\u8a2d\u5099\u4e0a\u6253\u958b\u300a\u65b9\u584a\u982d\u300b\u4e26\u9078\u64c7\u300c\u5c0e\u5165\u4e16\u754c\u300d\u4f86\u8f09\u5165\u6a94\u6848\u3002\u4f8b\u5982\uff0c\u4f7f\u7528 Google \u96f2\u7aef\u786c\u789f\u53ef\u4ee5\u78ba\u4fdd\u5e73\u7a69\u7684\u50b3\u8f38\u3002\u4f7f\u7528[\u6d41\u7a0b\u5716]\u53ef\u8996\u5316\u8a72\u904e\u7a0b\uff1a\u5c0e\u51fa\u2192\u50b3\u8f38\u2192\u5c0e\u5165\u3002\u6b64\u65b9\u6cd5\u4fdd\u7559\u60a8\u5728\u4e0d\u540c\u8a2d\u5099\u4e0a\u7684\u9032\u5ea6\u3002"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728\u300a\u65b9\u584a\u982d\u300b\u4e2d\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff0c\u4ee5\u53ca\u5b83\u5011\u5982\u4f55\u8c50\u5bcc\u904a\u6232\uff1f", "answer": "\u300a\u65b9\u584a\u982d\u300b\u5305\u542b\u96b1\u85cf\u529f\u80fd\uff0c\u4f8b\u5982\u7a00\u6709\u7684\u751f\u7269\u7fa4\u7cfb\u548c\u79d8\u5bc6\u7d50\u69cb\u3002\u6b65\u9a5f1\uff1a\u63a2\u7d22\u9060\u96e2\u4f60\u8d77\u59cb\u9ede\u7684\u5730\u65b9\uff0c\u4ee5\u627e\u5230\u7368\u7279\u7684\u751f\u7269\u7fa4\u7cfb\uff0c\u4f8b\u5982\u6c99\u6f20\u6216\u53e2\u6797\u3002\u6b65\u9a5f2\uff1a\u5c0b\u627e\u5177\u6709\u73cd\u8cb4\u6230\u5229\u54c1\u7684\u5730\u4e0b\u5730\u7262\u3002\u6b65\u9a5f3\uff1a\u89e3\u78bc\u74b0\u5883\u4e2d\u96b1\u85cf\u7684\u4fe1\u606f\u6216\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u627e\u5230\u6c99\u6f20\u795e\u5edf\u901a\u5e38\u6703\u7522\u751f\u7a00\u6709\u7269\u54c1\u3002\u4f7f\u7528[\u5730\u5716\u5716\u8868]\u6a19\u8a18\u6f5b\u5728\u96b1\u85cf\u529f\u80fd\u7684\u4f4d\u7f6e\u3002\u9019\u4e9b\u767c\u73fe\u589e\u52a0\u4e86\u904a\u6232\u7684\u6df1\u5ea6\u548c\u523a\u6fc0\u6027\u3002"}]
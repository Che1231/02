[{"question": "\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u65b9\u5757\u5934\u300b\u65e9\u671f\u6e38\u620f\u4e2d\u6709\u6548\u5730\u6536\u96c6\u8d44\u6e90\uff1f", "answer": "\u5728\u300a\u65b9\u5757\u5934\u300b\u4e2d\uff0c\u65b0\u73a9\u5bb6\u5e94\u4e13\u6ce8\u4e8e\u6536\u96c6\u6728\u6750\u548c\u77f3\u5934\u7b49\u57fa\u672c\u8d44\u6e90\uff0c\u4ee5\u5efa\u9020\u5fc5\u5907\u5de5\u5177\u548c\u4f4f\u6240\u3002\u7b2c\u4e00\u6b65\uff1a\u9996\u5148\u6572\u51fb\u6811\u6728\u6536\u96c6\u6728\u6750\u3002\u7b2c\u4e8c\u6b65\uff1a\u4f7f\u7528\u6728\u6750\u5236\u4f5c\u6728\u9550\uff0c\u8fd9\u4f7f\u60a8\u53ef\u4ee5\u5f00\u91c7\u77f3\u5934\u3002\u7b2c\u4e09\u6b65\uff1a\u5229\u7528\u77f3\u5934\u5236\u4f5c\u66f4\u6709\u6548\u7387\u7684\u77f3\u65a7\u548c\u77f3\u9550\u6765\u6536\u96c6\u66f4\u591a\u8d44\u6e90\u3002\u4f8b\u5982\uff0c\u77f3\u65a7\u53ef\u4ee5\u663e\u8457\u52a0\u5feb\u6728\u6750\u7684\u6536\u96c6\u901f\u5ea6\u3002\u4f7f\u7528[\u914d\u7f6e\u8868]\u6bd4\u8f83\u4e0d\u540c\u5de5\u5177\u7684\u6548\u7387\uff1a\u6728\u65a7\uff082\u500d\u901f\u5ea6\uff09\uff0c\u77f3\u65a7\uff083\u500d\u901f\u5ea6\uff09\uff0c\u94c1\u65a7\uff084\u500d\u901f\u5ea6\uff09\u3002\u8fd9\u79cd\u65b9\u6cd5\u786e\u4fdd\u4e86\u4ece\u57fa\u672c\u5de5\u5177\u5230\u9ad8\u7ea7\u5de5\u5177\u7684\u5e73\u6ed1\u8fc7\u6e21\u3002"}, {"question": "\u5728\u300a\u65b9\u5757\u5934\u300b\u4e2d\uff0c\u4e3a\u4ec0\u4e48\u4ed4\u7ec6\u7ba1\u7406\u4f60\u7684\u7269\u54c1\u680f\u5f88\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u6709\u6548\u5730\u505a\u5230\u8fd9\u4e00\u70b9\uff1f", "answer": "\u5728\u300a\u65b9\u5757\u5934\u300b\u4e2d\uff0c\u7269\u54c1\u680f\u7ba1\u7406\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u6709\u9650\u7684\u7a7a\u95f4\u4f1a\u963b\u788d\u8fdb\u5ea6\u3002\u7b2c\u4e00\u6b65\uff1a\u4f18\u5148\u8003\u8651\u5de5\u5177\u3001\u98df\u7269\u548c\u5efa\u7b51\u6750\u6599\u7b49\u5fc5\u9700\u54c1\u3002\u7b2c\u4e8c\u6b65\uff1a\u4f7f\u7528\u7bb1\u5b50\u6765\u5b58\u50a8\u4e0d\u592a\u5e38\u7528\u7684\u7269\u54c1\uff0c\u4e3a\u6d3b\u8dc3\u4efb\u52a1\u817e\u51fa\u7a7a\u95f4\u3002\u7b2c\u4e09\u6b65\uff1a\u5b9a\u671f\u6574\u7406\u4f60\u7684\u7269\u54c1\u680f\uff0c\u5c06\u7269\u54c1\u5206\u7c7b\u5230\u4e0d\u540c\u7684\u7bb1\u5b50\u4e2d\uff0c\u4f8b\u5982\u4e00\u4e2a\u7528\u4e8e\u77ff\u7269\uff0c\u53e6\u4e00\u4e2a\u7528\u4e8e\u98df\u7269\u3002\u4f8b\u5982\uff0c\u5c06\u591a\u4f59\u7684\u6728\u6750\u50a8\u5b58\u5728\u9760\u8fd1\u4f60\u7684\u5236\u4f5c\u533a\u7684\u7bb1\u5b50\u4e2d\u53ef\u4ee5\u8282\u7701\u65f6\u95f4\u3002[\u6d41\u7a0b\u56fe]\u53ef\u4ee5\u5e2e\u52a9\u4f60\u5c06\u8be5\u8fc7\u7a0b\u53ef\u89c6\u5316\uff1a\u6536\u96c6\u2192\u5206\u7c7b\u2192\u5b58\u50a8\u2192\u63d0\u53d6\u3002\u6b64\u7cfb\u7edf\u786e\u4fdd\u4f60\u59cb\u7ec8\u62e5\u6709\u6240\u9700\u7684\u4e1c\u897f\uff0c\u800c\u4e0d\u4f1a\u6742\u4e71\u65e0\u7ae0\u3002"}, {"question": "\u300a\u65b9\u5757\u5934\u300b\u4e2d\u5730\u9762\u548c\u5730\u4e0b\u73af\u5883\u7684\u5173\u952e\u533a\u522b\u662f\u4ec0\u4e48\uff0c\u73a9\u5bb6\u5e94\u8be5\u5982\u4f55\u9002\u5e94\uff1f", "answer": "\u300a\u65b9\u5757\u5934\u300b\u4e2d\u5730\u9762\u548c\u5730\u4e0b\u73af\u5883\u63d0\u4f9b\u4e86\u4e0d\u540c\u7684\u6311\u6218\u548c\u8d44\u6e90\u3002\u5728\u5730\u9762\u4e0a\uff0c\u73a9\u5bb6\u53ef\u4ee5\u627e\u5230\u4e30\u5bcc\u7684\u6728\u6750\u3001\u77f3\u5934\u548c\u98df\u7269\uff0c\u8fd9\u4f7f\u5f97\u5b83\u975e\u5e38\u9002\u5408\u65b0\u624b\u3002\u7136\u800c\uff0c\u5730\u4e0b\u5374\u8574\u85cf\u7740\u94c1\u3001\u91d1\u7b49\u7a00\u6709\u77ff\u7269\uff0c\u4f46\u9700\u8981\u66f4\u597d\u7684\u5de5\u5177\u548c\u7167\u660e\u3002\u7b2c\u4e00\u6b65\uff1a\u5728\u5f00\u91c7\u5730\u4e0b\u77ff\u7269\u4e4b\u524d\uff0c\u88c5\u5907\u77f3\u9550\u3002\u7b2c\u4e8c\u6b65\uff1a\u5236\u4f5c\u706b\u628a\u6765\u7167\u4eae\u9ed1\u6697\u533a\u57df\u5e76\u9632\u6b62\u602a\u7269\u51fa\u73b0\u3002\u7b2c\u4e09\u6b65\uff1a\u643a\u5e26\u989d\u5916\u7684\u98df\u7269\u548c\u5de5\u5177\u4ee5\u8fdb\u884c\u957f\u65f6\u95f4\u7684\u91c7\u77ff\u65c5\u7a0b\u3002\u4f8b\u5982\uff0c\u5728\u5730\u4e0b\u627e\u5230\u94c1\u77ff\uff0c\u53ef\u4ee5\u5236\u4f5c\u66f4\u5f3a\u5927\u7684\u5de5\u5177\u3002\u4f7f\u7528[\u6bd4\u8f83\u8868]\u7a81\u51fa\u663e\u793a\u5dee\u5f02\uff1a\u5730\u9762\uff08\u6728\u6750\u3001\u77f3\u5934\u3001\u65e5\u5149\uff09\u4e0e\u5730\u4e0b\uff08\u77ff\u7269\u3001\u9ed1\u6697\u3001\u602a\u7269\uff09\u3002\u9002\u5e94\u8fd9\u4e9b\u73af\u5883\u53ef\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u6548\u7387\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u65b9\u5757\u5934\u300b\u4e2d\u4f18\u5316\u4ed6\u4eec\u7684\u5236\u4f5c\u7b56\u7565\u4ee5\u66f4\u5feb\u5730\u8fdb\u6b65\uff1f", "answer": "\u5728\u300a\u65b9\u5757\u5934\u300b\u4e2d\u4f18\u5316\u5236\u4f5c\u8fc7\u7a0b\u5305\u62ec\u4f18\u5148\u8003\u8651\u5fc5\u9700\u54c1\uff0c\u5e76\u7cfb\u7edf\u5730\u5347\u7ea7\u5de5\u5177\u3002\u7b2c\u4e00\u6b65\uff1a\u4ece\u6728\u9550\u548c\u65a7\u5934\u7b49\u57fa\u672c\u5de5\u5177\u5f00\u59cb\u3002\u7b2c\u4e8c\u6b65\uff1a\u6536\u96c6\u77f3\u5934\u6765\u5236\u4f5c\u66f4\u8010\u7528\u7684\u77f3\u5236\u5de5\u5177\u3002\u7b2c\u4e09\u6b65\uff1a\u4e13\u6ce8\u4e8e\u5236\u4f5c\u7194\u7089\uff0c\u5c06\u77ff\u7269\u51b6\u70bc\u6210\u91d1\u5c5e\u5de5\u5177\uff0c\u8fd9\u4e9b\u5de5\u5177\u6548\u7387\u66f4\u9ad8\u3002\u4f8b\u5982\uff0c\u94c1\u9550\u6bd4\u77f3\u9550\u5f00\u91c7\u65b9\u5757\u7684\u901f\u5ea6\u66f4\u5feb\u3002\u4f7f\u7528[\u5206\u6b65\u6d41\u7a0b\u56fe]\u6307\u5bfc\u5236\u4f5c\u8fc7\u7a0b\uff1a\u6536\u96c6\u8d44\u6e90\u2192\u5236\u4f5c\u57fa\u672c\u5de5\u5177\u2192\u5347\u7ea7\u5230\u77f3\u5236\u5de5\u5177\u2192\u63d0\u70bc\u77ff\u7269\u2192\u5236\u4f5c\u91d1\u5c5e\u5de5\u5177\u3002\u6b64\u7b56\u7565\u53ef\u786e\u4fdd\u7a33\u5b9a\u8fdb\u6b65\u3002"}, {"question": "\u5728\u300a\u65b9\u5757\u5934\u300b\u4e2d\u5efa\u7acb\u53ef\u6301\u7eed\u57fa\u5730\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300a\u65b9\u5757\u5934\u300b\u4e2d\u5efa\u7acb\u53ef\u6301\u7eed\u57fa\u5730\u9700\u8981\u89c4\u5212\u548c\u8d44\u6e90\u7ba1\u7406\u3002\u7b2c\u4e00\u6b65\uff1a\u9009\u62e9\u9760\u8fd1\u91cd\u8981\u8d44\u6e90\uff08\u5982\u6811\u6728\u548c\u6c34\uff09\u7684\u4f4d\u7f6e\u3002\u7b2c\u4e8c\u6b65\uff1a\u5efa\u9020\u5e26\u6709\u5899\u58c1\u548c\u5c4b\u9876\u7684\u57fa\u672c\u4f4f\u6240\uff0c\u4ee5\u62b5\u5fa1\u602a\u7269\u3002\u7b2c\u4e09\u6b65\uff1a\u901a\u8fc7\u6dfb\u52a0\u519c\u573a\u79cd\u690d\u98df\u7269\u548c\u7bb1\u5b50\u5b58\u50a8\u8d44\u6e90\u6765\u6269\u5c55\u4f60\u7684\u57fa\u5730\u3002\u4f8b\u5982\uff0c\u5c0f\u9ea6\u519c\u573a\u63d0\u4f9b\u7a33\u5b9a\u7684\u98df\u7269\u6765\u6e90\u3002\u4f7f\u7528[\u6bd4\u8f83\u8868]\u8bc4\u4f30\u57fa\u5730\u4f4d\u7f6e\uff1a\u9760\u8fd1\u6811\u6728\uff08\u5bb9\u6613\u83b7\u5f97\u6728\u6750\uff09\u4e0e\u9760\u8fd1\u6c34\u6e90\uff08\u5bb9\u6613\u79cd\u690d\u519c\u4f5c\u7269\uff09\u3002\u8fd9\u79cd\u65b9\u6cd5\u786e\u4fdd\u4e86\u957f\u671f\u7684\u751f\u5b58\u548c\u6548\u7387\u3002"}, {"question": "\u300a\u65b9\u5757\u5934\u300b\u4e2d\u7684\u663c\u591c\u5faa\u73af\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\uff0c\u73a9\u5bb6\u5e94\u8be5\u505a\u4e9b\u4ec0\u4e48\u6765\u51c6\u5907\uff1f", "answer": "\u300a\u65b9\u5757\u5934\u300b\u4e2d\u7684\u663c\u591c\u5faa\u73af\u5f15\u5165\u4e86\u4e0d\u540c\u7684\u6311\u6218\u548c\u673a\u9047\u3002\u767d\u5929\uff0c\u73a9\u5bb6\u53ef\u4ee5\u5b89\u5168\u5730\u6536\u96c6\u8d44\u6e90\u548c\u63a2\u7d22\u3002\u665a\u4e0a\uff0c\u602a\u7269\u4f1a\u51fa\u73b0\uff0c\u4f7f\u5916\u51fa\u53d8\u5f97\u5371\u9669\u3002\u7b2c\u4e00\u6b65\uff1a\u5229\u7528\u767d\u5929\u6536\u96c6\u5fc5\u8981\u7684\u8d44\u6e90\u5e76\u5efa\u9020\u4f4f\u6240\u3002\u7b2c\u4e8c\u6b65\uff1a\u5236\u4f5c\u706b\u628a\u6765\u7167\u4eae\u4f60\u7684\u57fa\u5730\u5e76\u9632\u6b62\u602a\u7269\u51fa\u73b0\u3002\u7b2c\u4e09\u6b65\uff1a\u7761\u5728\u5e8a\u4e0a\u4ee5\u8df3\u8fc7\u591c\u665a\u5e76\u907f\u514d\u5371\u9669\u3002\u4f8b\u5982\uff0c\u7761\u5728\u5e8a\u4e0a\u53ef\u4ee5\u6062\u590d\u5065\u5eb7\u5e76\u8df3\u8fc7\u591c\u95f4\u5faa\u73af\u3002\u4f7f\u7528[\u65f6\u95f4\u8f74\u56fe\u8868]\u6765\u8bf4\u660e\u8be5\u5faa\u73af\uff1a\u767d\u5929\uff08\u5b89\u5168\uff0c\u6536\u96c6\uff09\u2192\u591c\u665a\uff08\u5371\u9669\uff0c\u7761\u89c9\uff09\u3002\u4e3a\u591c\u665a\u505a\u597d\u51c6\u5907\uff0c\u786e\u4fdd\u5b89\u5168\u548c\u6548\u7387\u3002"}, {"question": "\u300a\u65b9\u5757\u5934\u300b\u4e2d\u79cd\u690d\u7684\u673a\u5236\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u73a9\u5bb6\u5982\u4f55\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u4ea7\u91cf\uff1f", "answer": "\u300a\u65b9\u5757\u5934\u300b\u4e2d\u7684\u79cd\u690d\u5305\u62ec\u79cd\u690d\u79cd\u5b50\u3001\u6d47\u6c34\u548c\u6536\u5272\u4f5c\u7269\u3002\u7b2c\u4e00\u6b65\uff1a\u901a\u8fc7\u7834\u574f\u8349\u6216\u6536\u5272\u91ce\u8349\u6765\u6536\u96c6\u79cd\u5b50\u3002\u7b2c\u4e8c\u6b65\uff1a\u4f7f\u7528\u9504\u5934\u7ffb\u8015\u571f\u58e4\u5e76\u64ad\u79cd\u3002\u7b2c\u4e09\u6b65\uff1a\u5b9a\u671f\u7ed9\u4f5c\u7269\u6d47\u6c34\uff0c\u4ee5\u786e\u4fdd\u5b83\u4eec\u957f\u5f97\u66f4\u5feb\u3002\u4f8b\u5982\uff0c\u5c0f\u9ea6\u79cd\u5b50\u4f1a\u751f\u957f\u4e3a\u5c0f\u9ea6\uff0c\u5c0f\u9ea6\u53ef\u4ee5\u7528\u6765\u5236\u4f5c\u9762\u5305\u3002\u4f7f\u7528[\u6bd4\u8f83\u8868]\u663e\u793a\u751f\u957f\u65f6\u95f4\uff1a\u5c0f\u9ea6\uff085\u5206\u949f\uff09\u4e0e\u80e1\u841d\u535c\uff087\u5206\u949f\uff09\u3002\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u4ea7\u91cf\u6d89\u53ca\u6309\u884c\u79cd\u690d\u5e76\u6709\u6548\u5730\u4f7f\u7528\u6c34\u3002"}, {"question": "\u300a\u65b9\u5757\u5934\u300b\u4e2d\u7684\u591a\u4eba\u6a21\u5f0f\u5982\u4f55\u589e\u5f3a\u6e38\u620f\u4f53\u9a8c\uff0c\u4ee5\u53ca\u5173\u952e\u8003\u8651\u56e0\u7d20\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u65b9\u5757\u5934\u300b\u4e2d\u7684\u591a\u4eba\u6a21\u5f0f\u5141\u8bb8\u73a9\u5bb6\u534f\u4f5c\u3001\u5206\u4eab\u8d44\u6e90\u5e76\u5efa\u9020\u66f4\u5927\u7684\u9879\u76ee\u3002\u7b2c\u4e00\u6b65\uff1a\u52a0\u5165\u670d\u52a1\u5668\u6216\u9080\u8bf7\u670b\u53cb\u5230\u4f60\u7684\u4e16\u754c\u3002\u7b2c\u4e8c\u6b65\uff1a\u4e3a\u73a9\u5bb6\u5206\u914d\u89d2\u8272\uff0c\u4f8b\u5982\u77ff\u5de5\u3001\u5efa\u7b51\u5e08\u6216\u519c\u6c11\uff0c\u4ee5\u4f18\u5316\u6548\u7387\u3002\u7b2c\u4e09\u6b65\uff1a\u4f7f\u7528\u804a\u5929\u6216\u544a\u793a\u724c\u8fdb\u884c\u6c9f\u901a\u548c\u534f\u8c03\u4efb\u52a1\u3002\u4f8b\u5982\uff0c\u4e00\u4e2a\u56e2\u961f\u53ef\u4ee5\u901a\u8fc7\u5206\u5de5\u6765\u5efa\u9020\u5de8\u5927\u7684\u57ce\u5821\u3002\u4f7f\u7528[\u6bd4\u8f83\u8868]\u7a81\u51fa\u663e\u793a\u76ca\u5904\uff1a\u5355\u4eba\u6e38\u620f\uff08\u72ec\u5904\uff0c\u8f83\u6162\uff09\u4e0e\u591a\u4eba\u6e38\u620f\uff08\u534f\u4f5c\uff0c\u66f4\u5feb\uff09\u3002\u5173\u952e\u8003\u8651\u56e0\u7d20\u5305\u62ec\u4fe1\u4efb\u548c\u6e05\u6670\u7684\u6c9f\u901a\u3002"}, {"question": "\u5c06\u300a\u65b9\u5757\u5934\u300b\u4e16\u754c\u4ece\u4e00\u4e2a\u8bbe\u5907\u8fc1\u79fb\u5230\u53e6\u4e00\u4e2a\u8bbe\u5907\u7684\u6b65\u9aa4\u662f\u4ec0\u4e48\uff1f", "answer": "\u5c06\u300a\u65b9\u5757\u5934\u300b\u4e16\u754c\u8fc1\u79fb\u5230\u53e6\u4e00\u4e2a\u8bbe\u5907\u6d89\u53ca\u5bfc\u51fa\u548c\u5bfc\u5165\u4e16\u754c\u6587\u4ef6\u3002\u7b2c\u4e00\u6b65\uff1a\u5728\u539f\u59cb\u8bbe\u5907\u4e0a\uff0c\u8f6c\u5230\u4e16\u754c\u8bbe\u7f6e\u5e76\u9009\u62e9\u201c\u5bfc\u51fa\u4e16\u754c\u201d\u3002\u7b2c\u4e8c\u6b65\uff1a\u4f7f\u7528\u4e91\u670d\u52a1\u6216 USB \u5c06\u5bfc\u51fa\u7684\u6587\u4ef6\u4f20\u8f93\u5230\u65b0\u8bbe\u5907\u3002\u7b2c\u4e09\u6b65\uff1a\u5728\u65b0\u8bbe\u5907\u4e0a\u6253\u5f00\u300a\u65b9\u5757\u5934\u300b\u5e76\u9009\u62e9\u201c\u5bfc\u5165\u4e16\u754c\u201d\u6765\u52a0\u8f7d\u8be5\u6587\u4ef6\u3002\u4f8b\u5982\uff0c\u4f7f\u7528 Google \u4e91\u7aef\u786c\u76d8\u53ef\u786e\u4fdd\u987a\u5229\u4f20\u8f93\u3002\u4f7f\u7528[\u6d41\u7a0b\u56fe]\u53ef\u89c6\u5316\u8be5\u8fc7\u7a0b\uff1a\u5bfc\u51fa\u2192\u4f20\u8f93\u2192\u5bfc\u5165\u3002\u6b64\u65b9\u6cd5\u53ef\u4fdd\u7559\u60a8\u5728\u4e0d\u540c\u8bbe\u5907\u4e0a\u7684\u6e38\u620f\u8fdb\u5ea6\u3002"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728\u300a\u65b9\u5757\u5934\u300b\u4e2d\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff0c\u4ee5\u53ca\u5b83\u4eec\u5982\u4f55\u589e\u5f3a\u6e38\u620f\uff1f", "answer": "\u300a\u65b9\u5757\u5934\u300b\u5305\u542b\u9690\u85cf\u529f\u80fd\uff0c\u4f8b\u5982\u7a00\u6709\u751f\u7269\u7fa4\u7cfb\u548c\u79d8\u5bc6\u7ed3\u6784\u3002\u7b2c\u4e00\u6b65\uff1a\u63a2\u7d22\u8fdc\u79bb\u4f60\u8d77\u59cb\u70b9\u7684\u5730\u65b9\uff0c\u4ee5\u53d1\u73b0\u72ec\u7279\u7684\u751f\u7269\u7fa4\u7cfb\uff0c\u5982\u6c99\u6f20\u6216\u4e1b\u6797\u3002\u7b2c\u4e8c\u6b65\uff1a\u5bfb\u627e\u5e26\u6709\u5b9d\u8d35\u6218\u5229\u54c1\u7684\u5730\u4e0b\u5730\u7262\u3002\u7b2c\u4e09\u6b65\uff1a\u7834\u8bd1\u73af\u5883\u4e2d\u9690\u85cf\u7684\u4fe1\u606f\u6216\u56fe\u6848\u3002\u4f8b\u5982\uff0c\u627e\u5230\u6c99\u6f20\u795e\u5e99\u901a\u5e38\u4f1a\u4ea7\u751f\u7a00\u6709\u7269\u54c1\u3002\u4f7f\u7528[\u5730\u56fe\u56fe]\u6807\u8bb0\u6f5c\u5728\u7684\u9690\u85cf\u529f\u80fd\u4f4d\u7f6e\u3002\u8fd9\u4e9b\u53d1\u73b0\u4e3a\u6e38\u620f\u589e\u52a0\u4e86\u6df1\u5ea6\u548c\u5174\u594b\u611f\u3002"}]
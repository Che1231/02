[{"question": "\u5982\u4f55\u4f5c\u4e3a\u5b8c\u5168\u65b0\u624b\u5f00\u59cb\u73a9PolyTrack\u6e38\u620f\uff1f", "answer": "\u8981\u5f00\u59cb\u73a9PolyTrack\uff0c\u9996\u5148\uff0c\u8bf7\u4ece\u5b98\u65b9\u7f51\u7ad9\u6216\u60a8\u504f\u597d\u7684\u5e94\u7528\u5546\u5e97\u4e0b\u8f7d\u5e76\u5b89\u88c5\u6e38\u620f\u3002\u521b\u5efa\u4e00\u4e2a\u5e10\u6237\u5e76\u5b8c\u6210\u6559\u7a0b\uff0c\u6559\u7a0b\u4f1a\u6307\u5bfc\u60a8\u8fdb\u884c\u57fa\u672c\u64cd\u4f5c\u548c\u6e38\u620f\u673a\u5236\u3002\u4f8b\u5982\uff0c\u60a8\u5c06\u5b66\u4e60\u5982\u4f55\u901a\u8fc7\u6ed1\u52a8\u548c\u70b9\u51fb\u6765\u5bfc\u822a\u5730\u56fe\u3002\u8bf7\u52a1\u5fc5\u68c0\u67e5\u8bbe\u7f6e\uff0c\u4ee5\u8c03\u6574\u63a7\u4ef6\u4ee5\u7b26\u5408\u60a8\u7684\u504f\u597d\u3002"}, {"question": "\u5728PolyTrack\u4e2d\uff0c\u6211\u9700\u8981\u638c\u63e1\u54ea\u4e9b\u5fc5\u8981\u7684\u63a7\u5236\uff1f", "answer": "\u7cbe\u901aPolyTrack\u6d89\u53ca\u7406\u89e3\u5176\u6838\u5fc3\u63a7\u5236\uff1a\u5bfc\u822a\u3001\u4ea4\u4e92\u548c\u81ea\u5b9a\u4e49\u3002\u5bf9\u4e8e\u5bfc\u822a\uff0c\u4f7f\u7528\u6ed1\u52a8\u79fb\u52a8\u76f8\u673a\uff0c\u70b9\u51fb\u9009\u62e9\u7269\u4f53\u3002\u4ea4\u4e92\u5bf9\u4e8e\u4e0e\u6e38\u620f\u5143\u7d20\u4e92\u52a8\u81f3\u5173\u91cd\u8981\u2014\u2014\u70b9\u51fb\u56fe\u6807\u6536\u96c6\u8d44\u6e90\u3002\u81ea\u5b9a\u4e49\u5141\u8bb8\u60a8\u901a\u8fc7\u8bbe\u7f6e\u83dc\u5355\u5b9a\u5236\u60a8\u7684\u6e38\u620f\u4f53\u9a8c\uff0c\u60a8\u53ef\u4ee5\u5728\u5176\u4e2d\u8c03\u6574\u7075\u654f\u5ea6\u548c\u6309\u952e\u7ed1\u5b9a\u3002"}, {"question": "\u4e3a\u4ec0\u4e48PolyTrack\u4e2d\u7684\u8d44\u6e90\u7ba1\u7406\u81f3\u5173\u91cd\u8981\uff0c\u4ee5\u53ca\u6211\u8be5\u5982\u4f55\u6539\u8fdb\u5b83\uff1f", "answer": "\u5728PolyTrack\u4e2d\uff0c\u8d44\u6e90\u7ba1\u7406\u5bf9\u4e8e\u6301\u7eed\u7684\u8fdb\u6b65\u548c\u6210\u529f\u81f3\u5173\u91cd\u8981\u3002\u6709\u6548\u5730\u7ba1\u7406\u8d44\u6e90\u53ef\u786e\u4fdd\u60a8\u80fd\u591f\u5728\u4e0d\u5ef6\u8bef\u7684\u60c5\u51b5\u4e0b\u5efa\u9020\u548c\u5347\u7ea7\u5efa\u7b51\u7269\u3002\u4f8b\u5982\uff0c\u6e38\u620f\u521d\u671f\uff0c\u59cb\u7ec8\u4f18\u5148\u6536\u96c6\u6728\u6750\u548c\u77f3\u5934\u3002\u4f7f\u7528\u4ea4\u66ff\u6536\u96c6\u8d44\u6e90\u548c\u5efa\u9020\u7684\u7b56\u7565\u6765\u4fdd\u6301\u7a33\u5b9a\u7684\u8d44\u6e90\u6d41\u3002\u5b9a\u671f\u68c0\u67e5\u60a8\u7684\u5e93\u5b58\uff0c\u907f\u514d\u56e4\u79ef\u4e0d\u592a\u6709\u7528\u7684\u7269\u54c1\u3002"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u53ef\u4ee5\u5e2e\u52a9\u6211\u5728PolyTrack\u7684\u591a\u4eba\u6a21\u5f0f\u4e2d\u53d6\u5f97\u4f18\u52bf\uff1f", "answer": "\u5728PolyTrack\u7684\u591a\u4eba\u6a21\u5f0f\u4e2d\u53d6\u5f97\u4f18\u52bf\u9700\u8981\u6218\u7565\u89c4\u5212\u548c\u56e2\u961f\u5408\u4f5c\u3002\u9996\u5148\uff0c\u4e0e\u60a8\u7684\u56e2\u961f\u6709\u6548\u6c9f\u901a\uff0c\u534f\u8c03\u653b\u51fb\u548c\u9632\u5fa1\u3002\u5176\u6b21\uff0c\u4e13\u6ce8\u4e8e\u5347\u7ea7\u60a8\u7684\u5355\u4f4d\u548c\u5efa\u7b51\u7269\uff0c\u4ee5\u83b7\u5f97\u8d85\u8d8a\u5bf9\u624b\u7684\u4f18\u52bf\u3002\u7b2c\u4e09\uff0c\u6839\u636e\u4e0d\u65ad\u53d8\u5316\u7684\u6e38\u620f\u52a8\u6001\u8c03\u6574\u60a8\u7684\u7b56\u7565\u2014\u2014\u4fdd\u6301\u7075\u6d3b\uff0c\u5e76\u51c6\u5907\u597d\u5fc5\u8981\u65f6\u505a\u51fa\u8c03\u6574\u3002"}, {"question": "\u5982\u4f55\u5728PolyTrack\u4e2d\u4f18\u5316\u6211\u7684\u57fa\u5730\u5e03\u5c40\uff0c\u4ee5\u8fbe\u5230\u6700\u5927\u7684\u6548\u7387\uff1f", "answer": "\u5728PolyTrack\u4e2d\u4f18\u5316\u60a8\u7684\u57fa\u5730\u5e03\u5c40\uff0c\u9700\u8981\u5bf9\u5efa\u7b51\u7269\u548c\u8d44\u6e90\u8fdb\u884c\u6218\u7565\u6027\u653e\u7f6e\u3002\u5c06\u8d44\u6e90\u751f\u6210\u5efa\u7b51\u7269\uff08\u4f8b\u5982\u77ff\u4e95\u548c\u519c\u573a\uff09\u653e\u7f6e\u5728\u4e2d\u5fc3\u9644\u8fd1\uff0c\u4ee5\u65b9\u4fbf\u8bbf\u95ee\u3002\u9632\u5fa1\u5efa\u7b51\u7269\u5e94\u653e\u7f6e\u5728\u5468\u8fb9\u5730\u533a\uff0c\u4ee5\u9632\u6b62\u653b\u51fb\u3002\u4f7f\u7528\u7f51\u683c\u7cfb\u7edf\u89c4\u5212\u5e03\u5c40\uff0c\u786e\u4fdd\u6709\u8db3\u591f\u7684\u7a7a\u95f4\u8fdb\u884c\u672a\u6765\u7684\u6269\u5c55\u548c\u5347\u7ea7\u3002"}, {"question": "PolyTrack\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "PolyTrack\u7684\u5355\u4eba\u6a21\u5f0f\u4e13\u6ce8\u4e8e\u4ee5\u6545\u4e8b\u4e3a\u9a71\u52a8\u7684\u60c5\u8282\u4efb\u52a1\u548c\u5355\u4eba\u6311\u6218\uff0c\u5141\u8bb8\u73a9\u5bb6\u4ee5\u81ea\u5df1\u7684\u8282\u594f\u63a2\u7d22\u6e38\u620f\u3002\u7136\u800c\uff0c\u591a\u4eba\u6a21\u5f0f\u5f3a\u8c03\u7ade\u4e89\u548c\u5408\u4f5c\uff0c\u8981\u6c42\u73a9\u5bb6\u5236\u5b9a\u7b56\u7565\u5e76\u534f\u540c\u5de5\u4f5c\u4ee5\u5b9e\u73b0\u76ee\u6807\u3002\u7531\u4e8e\u5176\u4ed6\u73a9\u5bb6\u7684\u53c2\u4e0e\uff0c\u591a\u4eba\u6a21\u5f0f\u7684\u52a8\u6001\u66f4\u52a0\u96be\u4ee5\u9884\u6d4b\uff0c\u589e\u52a0\u4e86\u590d\u6742\u6027\u548c\u523a\u6fc0\u6027\u3002"}, {"question": "PolyTrack\u7684\u8fdb\u5ea6\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u91cc\u7a0b\u7891\u662f\u4ec0\u4e48\uff1f", "answer": "PolyTrack\u7684\u8fdb\u5ea6\u7cfb\u7edf\u57fa\u4e8e\u7ecf\u9a8c\u503c (XP)\uff0c\u901a\u8fc7\u5b8c\u6210\u4efb\u52a1\u3001\u51fb\u8d25\u654c\u4eba\u548c\u5efa\u9020\u5efa\u7b51\u7269\u6765\u83b7\u5f97\u3002\u91cc\u7a0b\u7891\u5305\u62ec\u5347\u7ea7\u7b49\u7ea7\u3001\u89e3\u9501\u65b0\u80fd\u529b\u548c\u8bbf\u95ee\u9ad8\u7ea7\u5185\u5bb9\u3002\u4f8b\u5982\uff0c\u8fbe\u5230 10 \u7ea7\u89e3\u9501\u5efa\u9020\u9ad8\u7ea7\u5efa\u7b51\u7269\u7684\u80fd\u529b\uff0c\u589e\u5f3a\u60a8\u7684\u6e38\u620f\u4f53\u9a8c\u548c\u6218\u7565\u9009\u62e9\u3002"}, {"question": "\u54ea\u4e9b\u56e0\u7d20\u5f71\u54cdPolyTrack\u5728\u4e0d\u540c\u8bbe\u5907\u4e0a\u7684\u517c\u5bb9\u6027\uff1f", "answer": "PolyTrack\u5728\u4e0d\u540c\u8bbe\u5907\u4e0a\u7684\u517c\u5bb9\u6027\u53d7\u786c\u4ef6\u89c4\u683c\u3001\u64cd\u4f5c\u7cfb\u7edf\u7248\u672c\u548c\u5c4f\u5e55\u5206\u8fa8\u7387\u7684\u5f71\u54cd\u3002\u786e\u4fdd\u60a8\u7684\u8bbe\u5907\u6ee1\u8db3\u6700\u4f4e\u8981\u6c42\uff0c\u4f8b\u5982\u62e5\u6709\u8db3\u591f\u7684 RAM \u548c\u517c\u5bb9\u7684\u64cd\u4f5c\u7cfb\u7edf\u7248\u672c\u3002\u6b64\u5916\uff0cPolyTrack\u9488\u5bf9\u5404\u79cd\u5c4f\u5e55\u5c3a\u5bf8\u8fdb\u884c\u4e86\u4f18\u5316\uff0c\u4f46\u6027\u80fd\u53ef\u80fd\u56e0\u8bbe\u5907\u7684\u5904\u7406\u80fd\u529b\u548c\u56fe\u5f62\u80fd\u529b\u800c\u5f02\u3002"}, {"question": "\u6211\u5728PolyTrack\u4e2d\u53ef\u4ee5\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u7684\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "PolyTrack\u5145\u6ee1\u4e86\u9690\u85cf\u7684\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u4e3a\u6e38\u620f\u589e\u6dfb\u4e86\u6df1\u5ea6\u548c\u4e50\u8da3\u3002\u4f8b\u5982\uff0c\u591a\u6b21\u70b9\u51fb\u68ee\u6797\u4e2d\u7279\u5b9a\u7684\u6811\u6728\u53ef\u80fd\u4f1a\u53d1\u73b0\u9690\u85cf\u7684\u5b9d\u7bb1\u3002\u63a2\u7d22\u5730\u56fe\u7684\u6bcf\u4e00\u4e2a\u89d2\u843d\u90fd\u6709\u53ef\u80fd\u53d1\u73b0\u79d8\u5bc6\u533a\u57df\u548c\u7a00\u6709\u7269\u54c1\uff0c\u5956\u52b1\u597d\u5947\u548c\u6709\u6bc5\u529b\u7684\u73a9\u5bb6\u4ee5\u72ec\u7279\u7684\u5956\u52b1\u548c\u60ca\u559c\u3002"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684PolyTrack\u6e38\u620f\u6570\u636e\u4ece\u4e00\u4e2a\u8bbe\u5907\u4f20\u8f93\u5230\u53e6\u4e00\u4e2a\u8bbe\u5907\uff1f", "answer": "\u5982\u679c\u4f7f\u7528\u4e91\u4fdd\u5b58\u529f\u80fd\uff0c\u5219\u5728\u8bbe\u5907\u4e4b\u95f4\u4f20\u8f93\u60a8\u7684PolyTrack\u6e38\u620f\u6570\u636e\u975e\u5e38\u7b80\u5355\u3002\u9996\u5148\uff0c\u786e\u4fdd\u60a8\u5728\u4e24\u4e2a\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u5e10\u6237\u3002\u8f6c\u5230\u8bbe\u7f6e\u83dc\u5355\uff0c\u9009\u62e9\u201c\u4e91\u4fdd\u5b58\u201d\u5c06\u5f53\u524d\u6e38\u620f\u6570\u636e\u4e0a\u4f20\u3002\u5728\u65b0\u8bbe\u5907\u4e0a\uff0c\u767b\u5f55\u5e76\u4e0b\u8f7d\u4fdd\u5b58\u7684\u6570\u636e\uff0c\u5373\u53ef\u65e0\u7f1d\u7ee7\u7eed\u60a8\u7684\u8fdb\u5ea6\uff0c\u65e0\u9700\u4e22\u5931\u4efb\u4f55\u6210\u5c31\u6216\u7269\u54c1\u3002"}]
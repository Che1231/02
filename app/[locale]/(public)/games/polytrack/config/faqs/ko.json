[{"question": "\ucd08\ubcf4\uc790\ub85c\uc11c PolyTrack \uac8c\uc784\uc744 \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud560 \uc218 \uc788\ub098\uc694?", "answer": "PolyTrack \uac8c\uc784\uc744 \uc2dc\uc791\ud558\ub824\uba74 \uba3c\uc800 \uacf5\uc2dd \uc6f9\uc0ac\uc774\ud2b8\ub098 \uc6d0\ud558\ub294 \uc571 \uc2a4\ud1a0\uc5b4\uc5d0\uc11c \uac8c\uc784\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uace0 \uc124\uce58\ud558\uc138\uc694. \uacc4\uc815\uc744 \uc0dd\uc131\ud558\uace0 \uae30\ubcf8 \ucee8\ud2b8\ub864\uacfc \uba54\ucee4\ub2c8\uc998\uc744 \uc548\ub0b4\ud558\ub294 \ud29c\ud1a0\ub9ac\uc5bc\uc744 \uc644\ub8cc\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc4f8\uc5b4\uc11c \uc6c0\uc9c1\uc774\uac70\ub098 \ud0ed\ud558\uc5ec \uc9c0\ub3c4\ub97c \ud0d0\uc0c9\ud558\ub294 \ubc29\ubc95\uc744 \ubc30\uc6b0\uac8c \ub420 \uac83\uc785\ub2c8\ub2e4. \uae30\ubcf8 \uc124\uc815\uc744 \uc0ac\uc6a9\uc790\uc758 \uc120\ud638\ub3c4\uc5d0 \ub9de\uac8c \uc870\uc815\ud558\ub294 \uac83\uc744 \ud655\uc778\ud558\uc2ed\uc2dc\uc624."}, {"question": "PolyTrack\uc5d0\uc11c \uc219\ub2ec\ud574\uc57c \ud558\ub294 \ud544\uc218 \ucee8\ud2b8\ub864\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "PolyTrack \uc219\ub2ec\uc744 \uc704\ud574\uc11c\ub294 \ud575\uc2ec \ucee8\ud2b8\ub864\uc778 \ud0d0\uc0c9, \uc0c1\ud638 \uc791\uc6a9 \ubc0f \uc0ac\uc6a9\uc790 \uc9c0\uc815\uc744 \uc774\ud574\ud574\uc57c \ud569\ub2c8\ub2e4. \ud0d0\uc0c9\uc758 \uacbd\uc6b0 \uce74\uba54\ub77c\ub97c \uc6c0\uc9c1\uc774\ub824\uba74 \uc4f8\uace0, \uac1c\uccb4\ub97c \uc120\ud0dd\ud558\ub824\uba74 \ud0ed\ud558\uc138\uc694. \uc0c1\ud638 \uc791\uc6a9\uc740 \uac8c\uc784 \uc694\uc18c\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\ub294 \ub370 \uc911\uc694\ud569\ub2c8\ub2e4. \uc544\uc774\ucf58\uc744 \ud0ed\ud558\uc5ec \uc790\uc6d0\uc744 \uc218\uc9d1\ud558\uc138\uc694. \uc0ac\uc6a9\uc790 \uc9c0\uc815\uc744 \ud1b5\ud574 \uc124\uc815 \uba54\ub274\uc5d0\uc11c \uac10\ub3c4\uc640 \ud0a4 \ubc14\uc778\ub529\uc744 \uc870\uc815\ud558\uc5ec \uc0ac\uc6a9\uc790 \uacbd\ud5d8\uc744 \ub9de\ucda4 \uc124\uc815\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "PolyTrack\uc5d0\uc11c \uc790\uc6d0 \uad00\ub9ac\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \uac1c\uc120\ud560 \uc218 \uc788\ub098\uc694?", "answer": "PolyTrack\uc5d0\uc11c \uc790\uc6d0 \uad00\ub9ac\ub97c \ud1b5\ud574 \uc9c0\uc18d\uc801\uc778 \ubc1c\uc804\uacfc \uc131\uacf5\uc744 \ud655\ubcf4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc790\uc6d0\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\uba74 \uc9c0\uc5f0 \uc5c6\uc774 \uad6c\uc870\ubb3c\uc744 \uac74\uc124\ud558\uace0 \uc5c5\uadf8\ub808\uc774\ub4dc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac8c\uc784 \ucd08\uae30\uc5d0 \ub098\ubb34\uc640 \ub3cc\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uc218\uc9d1\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \uc790\uc6d0 \uc218\uc9d1\uacfc \uac74\uc124\uc744 \ubc88\uac08\uc544 \uac00\uba70 \uc9c4\ud589\ud558\uc5ec \uafb8\uc900\ud55c \uc720\uc785\uc744 \uc720\uc9c0\ud558\ub294 \uc804\ub7b5\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \ubd88\ud544\uc694\ud55c \uc544\uc774\ud15c \uacfc\uc789 \ubcf4\uc720\ub97c \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \uc815\uae30\uc801\uc73c\ub85c \uc778\ubca4\ud1a0\ub9ac\ub97c \ud655\uc778\ud558\uc2ed\uc2dc\uc624."}, {"question": "PolyTrack\uc758 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c \uc2b9\ub9ac\ud560 \uc218 \uc788\ub294 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "PolyTrack\uc758 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c \uc2b9\ub9ac\ud558\ub824\uba74 \uc804\ub7b5\uc801 \uacc4\ud68d\uacfc \ud300\uc6cc\ud06c\uac00 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uba3c\uc800 \ud300\uacfc \ud6a8\uacfc\uc801\uc73c\ub85c \uc18c\ud1b5\ud558\uc5ec \uacf5\uaca9\uacfc \ubc29\uc5b4\ub97c \uc870\uc728\ud558\uc138\uc694. \ub450 \ubc88\uc9f8\ub85c, \uc0c1\ub300\ubc29\uc744 \uc555\ub3c4\ud558\uae30 \uc704\ud574 \uc720\ub2db\uacfc \uac74\ubb3c\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \uc138 \ubc88\uc9f8\ub85c, \uac8c\uc784 \uc0c1\ud669\uc774 \ubcc0\ud654\ud568\uc5d0 \ub530\ub77c \uc804\ub7b5\uc744 \uc801\uc751\uc2dc\ud0a4\uc138\uc694. \ud544\uc694\uc5d0 \ub530\ub77c \uc720\uc5f0\ud558\uace0 \uc804\ub7b5\uc744 \uc804\ud658\ud560 \uc900\ube44\ub97c \ud558\uc138\uc694."}, {"question": "PolyTrack\uc5d0\uc11c \ucd5c\ub300 \ud6a8\uc728\uc744 \uc704\ud574 \uae30\uc9c0 \ub808\uc774\uc544\uc6c3\uc744 \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\ub098\uc694?", "answer": "PolyTrack\uc5d0\uc11c \uae30\uc9c0 \ub808\uc774\uc544\uc6c3\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uac74\ubb3c\uacfc \uc790\uc6d0\uc758 \uc804\ub7b5\uc801 \ubc30\uce58\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \uad11\uc0b0\uacfc \ub18d\uc7a5\uacfc \uac19\uc740 \uc790\uc6d0 \uc0dd\uc131 \uac74\ubb3c\uc740 \uc27d\uac8c \uc811\uadfc\ud560 \uc218 \uc788\ub3c4\ub85d \uc911\uc559 \uadfc\ucc98\uc5d0 \ubc30\uce58\ud558\uc138\uc694. \ubc29\uc5b4 \uad6c\uc870\ubb3c\uc740 \uacf5\uaca9\uc73c\ub85c\ubd80\ud130 \ubcf4\ud638\ud558\uae30 \uc704\ud574 \uc8fc\ubcc0\uc5d0 \ubc30\uce58\ud558\uc138\uc694. \ubbf8\ub798 \ud655\uc7a5\uacfc \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc704\ud55c \ucda9\ubd84\ud55c \uacf5\uac04\uc744 \ud655\ubcf4\ud558\uba74\uc11c \ub808\uc774\uc544\uc6c3\uc744 \uacc4\ud68d\ud558\uae30 \uc704\ud574 \uadf8\ub9ac\ub4dc \uc2dc\uc2a4\ud15c\uc744 \uc0ac\uc6a9\ud558\uc138\uc694."}, {"question": "PolyTrack\uc758 \uc2f1\uae00\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "PolyTrack\uc758 \uc2f1\uae00\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \uc2a4\ud1a0\ub9ac \uc911\uc2ec\uc758 \ubbf8\uc158\uacfc \uc194\ub85c \ucc4c\ub9b0\uc9c0\uc5d0 \uc911\uc810\uc744 \ub450\uc5b4 \ud50c\ub808\uc774\uc5b4\uac00 \uc790\uc2e0\uc758 \uc18d\ub3c4\ub85c \uac8c\uc784\uc744 \ud0d0\ud5d8\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. \ubc18\uba74 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \uacbd\uc7c1\uacfc \ud611\ub825\uc5d0 \uc911\uc810\uc744 \ub450\uc5b4 \ud50c\ub808\uc774\uc5b4\uac00 \uc804\ub7b5\uc744 \uc138\uc6b0\uace0 \ubaa9\ud45c\ub97c \ub2ec\uc131\ud558\uae30 \uc704\ud574 \ud568\uaed8 \ud611\ub825\ud574\uc57c \ud569\ub2c8\ub2e4. \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uc758 \ucc38\uc5ec\ub85c \uc778\ud574 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4\uc758 \uc0c1\ud669\uc740 \uc608\uce21\ud558\uae30 \uc5b4\ub824\uc6cc \ubcf5\uc7a1\ud558\uace0 \ud765\ubbf8\uc9c4\uc9c4\ud55c \uc694\uc18c\ub97c \ub354\ud569\ub2c8\ub2e4."}, {"question": "PolyTrack\uc758 \uc9c4\ud589 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \uc774\uc815\ud45c\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "PolyTrack\uc758 \uc9c4\ud589 \uc2dc\uc2a4\ud15c\uc740 \ubbf8\uc158 \uc644\ub8cc, \uc801 \ucc98\uce58 \ubc0f \uad6c\uc870\ubb3c \uac74\uc124\uc744 \ud1b5\ud574 \uc5bb\uc740 \uacbd\ud5d8\uce58(XP)\ub97c \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. \uc774\uc815\ud45c\uc5d0\ub294 \ub808\ubca8 \uc5c5, \uc0c8\ub85c\uc6b4 \ub2a5\ub825 \ud574\uc81c \ubc0f \uace0\uae09 \ucf58\ud150\uce20 \uc811\uadfc\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 \ub808\ubca8 10\uc5d0 \ub3c4\ub2ec\ud558\uba74 \uace0\uae09 \uad6c\uc870\ubb3c\uc744 \uac74\uc124\ud558\ub294 \ub2a5\ub825\uc744 \ud574\uc81c\ud558\uc5ec \ud50c\ub808\uc774 \uacbd\ud5d8\uacfc \uc804\ub7b5\uc801\uc778 \uc635\uc158\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "PolyTrack\uc758 \ud638\ud658\uc131\uc774 \ub2e4\uc591\ud55c \uae30\uae30\uc5d0\uc11c \uc5b4\ub5bb\uac8c \uc601\ud5a5\uc744 \ubc1b\ub098\uc694?", "answer": "PolyTrack\uc758 \ud638\ud658\uc131\uc740 \ub2e4\uc591\ud55c \uae30\uae30\uc5d0\uc11c \ud558\ub4dc\uc6e8\uc5b4 \uc0ac\uc591, \uc6b4\uc601\uccb4\uc81c \ubc84\uc804 \ubc0f \ud654\uba74 \ud574\uc0c1\ub3c4\uc5d0 \ub530\ub77c \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \ucda9\ubd84\ud55c RAM\uacfc \ud638\ud658 \uac00\ub2a5\ud55c OS \ubc84\uc804\uacfc \uac19\uc774 \uc7a5\uce58\uac00 \ucd5c\uc18c \uc694\uad6c \uc0ac\ud56d\uc744 \ucda9\uc871\ud558\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \ub610\ud55c PolyTrack\uc740 \ub2e4\uc591\ud55c \ud654\uba74 \ud06c\uae30\uc5d0 \ucd5c\uc801\ud654\ub418\uc5b4 \uc788\uc9c0\ub9cc, \uc131\ub2a5\uc740 \uae30\uae30\uc758 \ucc98\ub9ac \uc131\ub2a5\uacfc \uadf8\ub798\ud53d \uae30\ub2a5\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "PolyTrack\uc5d0\uc11c \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "PolyTrack\uc740 \uac8c\uc784\uc5d0 \uae4a\uc774\uc640 \uc7ac\ubbf8\ub97c \ub354\ud558\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\ub85c \uac00\ub4dd\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc232 \uc18d\uc758 \ud2b9\uc815 \ub098\ubb34\ub97c \uc5ec\ub7ec \ubc88 \ud0ed\ud558\uba74 \uc228\uaca8\uc9c4 \ubcf4\ubb3c \uc0c1\uc790\uac00 \ub098\ud0c0\ub0a0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc9c0\ub3c4\uc758 \ubaa8\ub4e0 \uad6c\uc11d\uad6c\uc11d\uc744 \ud0d0\ud5d8\ud558\uba74 \ube44\ubc00 \uc9c0\uc5ed\uacfc \ud76c\uadc0 \uc544\uc774\ud15c\uc744 \ubc1c\uacac\ud560 \uc218 \uc788\uc73c\uba70, \ud638\uae30\uc2ec \ub9ce\uace0 \ub048\uae30 \uc788\ub294 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ud2b9\ubcc4\ud55c \ubcf4\ub108\uc2a4\uc640 \ub180\ub77c\uc6c0\uc744 \uc120\uc0ac\ud569\ub2c8\ub2e4."}, {"question": "PolyTrack \uac8c\uc784 \ub370\uc774\ud130\ub97c \ud55c \uae30\uae30\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30\ub85c \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \uc0ac\uc6a9\ud558\uba74 PolyTrack \uac8c\uc784 \ub370\uc774\ud130\ub97c \uae30\uae30 \uac04\uc5d0 \uc27d\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uba3c\uc800 \ub450 \uae30\uae30 \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uc124\uc815 \uba54\ub274\ub85c \uc774\ub3d9\ud558\uc5ec '\ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5'\uc744 \uc120\ud0dd\ud558\uc5ec \ud604\uc7ac \uac8c\uc784 \ub370\uc774\ud130\ub97c \uc5c5\ub85c\ub4dc\ud569\ub2c8\ub2e4. \uc0c8\ub85c\uc6b4 \uae30\uae30\uc5d0\uc11c \ub85c\uadf8\uc778\ud558\uace0 \uc800\uc7a5\ub41c \ub370\uc774\ud130\ub97c \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc5ec \uc544\ubb34\ub7f0 \uc131\ucde8\ub3c4\ub098 \uc544\uc774\ud15c\ub3c4 \uc783\uc9c0 \uc54a\uace0 \uc9c4\ud589\uc744 \uc6d0\ud65c\ud558\uac8c \uc774\uc5b4\uac08 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
[{"question": "\u5982\u4f55\u958b\u59cb\u4ee5\u5b8c\u5168\u65b0\u624b\u8eab\u4efd\u904a\u73a9 PolyTrack\uff1f", "answer": "\u8981\u958b\u59cb\u904a\u73a9 PolyTrack\uff0c\u9996\u5148\uff0c\u8acb\u5f9e\u5b98\u65b9\u7db2\u7ad9\u6216\u60a8\u504f\u597d\u7684\u61c9\u7528\u7a0b\u5f0f\u5546\u5e97\u4e0b\u8f09\u4e26\u5b89\u88dd\u904a\u6232\u3002\u5efa\u7acb\u5e33\u6236\u4e26\u5b8c\u6210\u6559\u5b78\uff0c\u6559\u5b78\u6703\u6307\u5c0e\u60a8\u5b8c\u6210\u57fa\u672c\u63a7\u5236\u548c\u6a5f\u5236\u3002\u4f8b\u5982\uff0c\u60a8\u5c07\u5b78\u7fd2\u5982\u4f55\u900f\u904e\u6ed1\u52d5\u548c\u8f15\u89f8\u4f86\u700f\u89bd\u5730\u5716\u3002\u8acb\u52d9\u5fc5\u6aa2\u67e5\u8a2d\u5b9a\u4ee5\u8abf\u6574\u63a7\u5236\u9805\u4ee5\u7b26\u5408\u60a8\u7684\u504f\u597d\u3002"}, {"question": "\u5728 PolyTrack \u4e2d\uff0c\u6211\u9700\u8981\u638c\u63e1\u54ea\u4e9b\u5fc5\u8981\u63a7\u5236\u9805\uff1f", "answer": "\u7cbe\u901a PolyTrack \u9700\u8981\u4e86\u89e3\u5176\u6838\u5fc3\u63a7\u5236\u9805\uff1a\u5c0e\u822a\u3001\u4e92\u52d5\u548c\u5ba2\u88fd\u5316\u3002\u5c0d\u65bc\u5c0e\u822a\uff0c\u8acb\u4f7f\u7528\u6ed1\u52d5\u4f86\u79fb\u52d5\u651d\u5f71\u6a5f\uff0c\u4e26\u4f7f\u7528\u8f15\u89f8\u4f86\u9078\u64c7\u7269\u4ef6\u3002\u4e92\u52d5\u5c0d\u65bc\u8207\u904a\u6232\u5143\u7d20\u4e92\u52d5\u81f3\u95dc\u91cd\u8981\u2014\u2014\u8f15\u89f8\u5716\u793a\u5373\u53ef\u6536\u96c6\u8cc7\u6e90\u3002\u5ba2\u88fd\u5316\u5141\u8a31\u60a8\u900f\u904e\u8a2d\u5b9a\u9078\u55ae\u4f86\u5ba2\u88fd\u5316\u60a8\u7684\u9ad4\u9a57\uff0c\u60a8\u53ef\u4ee5\u5728\u5176\u4e2d\u8abf\u6574\u654f\u611f\u5ea6\u548c\u9375\u76e4\u7d81\u5b9a\u3002"}, {"question": "\u5728 PolyTrack \u4e2d\u8cc7\u6e90\u7ba1\u7406\u70ba\u4f55\u81f3\u95dc\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u6539\u5584\u5b83\uff1f", "answer": "\u5728 PolyTrack \u4e2d\uff0c\u8cc7\u6e90\u7ba1\u7406\u5c0d\u65bc\u6301\u7e8c\u9032\u6b65\u548c\u6210\u529f\u81f3\u95dc\u91cd\u8981\u3002\u6709\u6548\u5730\u7ba1\u7406\u8cc7\u6e90\uff0c\u78ba\u4fdd\u60a8\u53ef\u4ee5\u5efa\u7acb\u548c\u5347\u7d1a\u7d50\u69cb\uff0c\u800c\u4e0d\u6703\u5ef6\u8aa4\u3002\u4f8b\u5982\uff0c\u904a\u6232\u521d\u671f\uff0c\u8acb\u59cb\u7d42\u512a\u5148\u6536\u96c6\u6728\u6750\u548c\u77f3\u982d\u3002\u4f7f\u7528\u7b56\u7565\uff0c\u4ea4\u66ff\u9032\u884c\u8cc7\u6e90\u6536\u96c6\u548c\u5efa\u7bc9\uff0c\u4ee5\u7dad\u6301\u7a69\u5b9a\u6d41\u91cf\u3002\u5b9a\u671f\u6aa2\u67e5\u60a8\u7684\u5b58\u8ca8\uff0c\u907f\u514d\u56e4\u7a4d\u4e0d\u592a\u6709\u7528\u7684\u7269\u54c1\u3002"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u53ef\u4ee5\u5e6b\u52a9\u6211\u5728 PolyTrack \u7684\u591a\u4eba\u6a21\u5f0f\u4e2d\u4f54\u64da\u4e3b\u5c0e\u5730\u4f4d\uff1f", "answer": "\u8981\u5728 PolyTrack \u7684\u591a\u4eba\u6a21\u5f0f\u4e2d\u4f54\u64da\u4e3b\u5c0e\u5730\u4f4d\uff0c\u9700\u8981\u7b56\u7565\u898f\u5283\u548c\u5718\u968a\u5408\u4f5c\u3002\u9996\u5148\uff0c\u8207\u60a8\u7684\u5718\u968a\u6709\u6548\u6e9d\u901a\uff0c\u5354\u8abf\u653b\u64ca\u548c\u9632\u79a6\u3002\u5176\u6b21\uff0c\u5c08\u6ce8\u65bc\u5347\u7d1a\u60a8\u7684\u55ae\u4f4d\u548c\u5efa\u7bc9\u7269\uff0c\u4ee5\u7372\u5f97\u512a\u52e2\u3002\u7b2c\u4e09\uff0c\u6839\u64da\u4e0d\u65b7\u8b8a\u5316\u7684\u904a\u6232\u52d5\u614b\u8abf\u6574\u60a8\u7684\u7b56\u7565\u2014\u2014\u4fdd\u6301\u5f48\u6027\uff0c\u4e26\u96a8\u6642\u6e96\u5099\u8f49\u8b8a\u7b56\u7565\u3002"}, {"question": "\u5982\u4f55\u5728 PolyTrack \u4e2d\u6700\u4f73\u5316\u57fa\u5730\u4f48\u5c40\u4ee5\u9054\u5230\u6700\u5927\u6548\u7387\uff1f", "answer": "\u5728 PolyTrack \u4e2d\u6700\u4f73\u5316\u57fa\u5730\u4f48\u5c40\uff0c\u9700\u8981\u6709\u7b56\u7565\u6027\u5730\u653e\u7f6e\u5efa\u7bc9\u7269\u548c\u8cc7\u6e90\u3002\u5c07\u8cc7\u6e90\u751f\u6210\u5efa\u7bc9\u7269\uff08\u5982\u7926\u4e95\u548c\u8fb2\u5834\uff09\u653e\u7f6e\u5728\u4e2d\u5fc3\u9644\u8fd1\uff0c\u4ee5\u4fbf\u8f15\u9b06\u53d6\u5f97\u3002\u9632\u79a6\u7d50\u69cb\u61c9\u4f4d\u65bc\u5468\u908a\uff0c\u4ee5\u9632\u79a6\u653b\u64ca\u3002\u4f7f\u7528\u7db2\u683c\u7cfb\u7d71\u898f\u5283\u4f48\u5c40\uff0c\u78ba\u4fdd\u6709\u8db3\u5920\u7684\u7a7a\u9593\u7528\u65bc\u672a\u4f86\u7684\u64f4\u5c55\u548c\u5347\u7d1a\u3002"}, {"question": "PolyTrack \u7684\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "PolyTrack \u7684\u55ae\u4eba\u6a21\u5f0f\u5c08\u6ce8\u65bc\u5287\u60c5\u9a45\u52d5\u7684\u4efb\u52d9\u548c\u55ae\u4eba\u6311\u6230\uff0c\u8b93\u73a9\u5bb6\u53ef\u4ee5\u6309\u7167\u81ea\u5df1\u7684\u7bc0\u594f\u63a2\u7d22\u904a\u6232\u3002\u7136\u800c\uff0c\u591a\u4eba\u6a21\u5f0f\u5f37\u8abf\u7af6\u722d\u548c\u5408\u4f5c\uff0c\u8981\u6c42\u73a9\u5bb6\u7b56\u7565\u6027\u601d\u8003\u4e26\u5171\u540c\u52aa\u529b\u4ee5\u9054\u6210\u76ee\u6a19\u3002\u7531\u65bc\u5176\u4ed6\u73a9\u5bb6\u7684\u53c3\u8207\uff0c\u591a\u4eba\u6a21\u5f0f\u7684\u52d5\u614b\u66f4\u96e3\u4ee5\u9810\u6e2c\uff0c\u589e\u52a0\u4e86\u8907\u96dc\u6027\u548c\u523a\u6fc0\u6027\u3002"}, {"question": "PolyTrack \u7684\u9032\u5ea6\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u4ee5\u53ca\u91cc\u7a0b\u7891\u662f\u4ec0\u9ebc\uff1f", "answer": "PolyTrack \u7684\u9032\u5ea6\u7cfb\u7d71\u57fa\u65bc\u900f\u904e\u5b8c\u6210\u4efb\u52d9\u3001\u64ca\u6557\u6575\u4eba\u548c\u5efa\u9020\u7d50\u69cb\u800c\u7372\u5f97\u7684\u7d93\u9a57\u503c (XP)\u3002\u91cc\u7a0b\u7891\u5305\u62ec\u7b49\u7d1a\u63d0\u5347\u3001\u89e3\u9396\u65b0\u80fd\u529b\u548c\u53d6\u5f97\u9ad8\u7d1a\u5167\u5bb9\u3002\u4f8b\u5982\uff0c\u9054\u5230 10 \u7d1a\u89e3\u9396\u5efa\u9020\u5148\u9032\u7d50\u69cb\u7684\u80fd\u529b\uff0c\u589e\u5f37\u60a8\u7684\u904a\u6232\u9ad4\u9a57\u548c\u7b56\u7565\u9078\u64c7\u3002"}, {"question": "\u54ea\u4e9b\u56e0\u7d20\u5f71\u97ff PolyTrack \u5728\u4e0d\u540c\u88dd\u7f6e\u4e0a\u7684\u76f8\u5bb9\u6027\uff1f", "answer": "PolyTrack \u5728\u4e0d\u540c\u88dd\u7f6e\u4e0a\u7684\u76f8\u5bb9\u6027\u53d7\u786c\u9ad4\u898f\u683c\u3001\u4f5c\u696d\u7cfb\u7d71\u7248\u672c\u548c\u87a2\u5e55\u89e3\u6790\u5ea6\u5f71\u97ff\u3002\u8acb\u78ba\u4fdd\u60a8\u7684\u88dd\u7f6e\u7b26\u5408\u6700\u4f4e\u9700\u6c42\uff0c\u4f8b\u5982\u5177\u6709\u8db3\u5920\u7684 RAM \u548c\u76f8\u5bb9\u7684\u4f5c\u696d\u7cfb\u7d71\u7248\u672c\u3002\u6b64\u5916\uff0cPolyTrack \u512a\u5316\u7528\u65bc\u5404\u7a2e\u87a2\u5e55\u5c3a\u5bf8\uff0c\u4f46\u6548\u80fd\u53ef\u80fd\u6839\u64da\u88dd\u7f6e\u7684\u8655\u7406\u80fd\u529b\u548c\u5716\u5f62\u529f\u80fd\u800c\u7570\u3002"}, {"question": "\u6211\u5728 PolyTrack \u4e2d\u53ef\u4ee5\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "PolyTrack \u5145\u6eff\u4e86\u96b1\u85cf\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u6df1\u5ea6\u548c\u6a02\u8da3\u3002\u4f8b\u5982\uff0c\u591a\u6b21\u8f15\u89f8\u68ee\u6797\u4e2d\u7279\u5b9a\u7684\u6a39\u6728\u53ef\u80fd\u6703\u63ed\u9732\u96b1\u85cf\u7684\u5bf6\u7bb1\u3002\u63a2\u7d22\u5730\u5716\u7684\u6bcf\u4e00\u500b\u89d2\u843d\u548c\u96b1\u85cf\u5340\u57df\uff0c\u53ef\u80fd\u6703\u767c\u73fe\u79d8\u5bc6\u5340\u57df\u548c\u7a00\u6709\u7269\u54c1\uff0c\u734e\u52f5\u597d\u5947\u4e14\u6301\u7e8c\u63a2\u7d22\u7684\u73a9\u5bb6\u4ee5\u7368\u7279\u7684\u734e\u52f5\u548c\u9a5a\u559c\u3002"}, {"question": "\u5982\u4f55\u5c07\u6211\u7684 PolyTrack \u904a\u6232\u8cc7\u6599\u5f9e\u4e00\u500b\u88dd\u7f6e\u50b3\u8f38\u5230\u53e6\u4e00\u500b\u88dd\u7f6e\uff1f", "answer": "\u5982\u679c\u60a8\u4f7f\u7528\u96f2\u7aef\u5132\u5b58\uff0c\u5247\u5728\u88dd\u7f6e\u4e4b\u9593\u50b3\u8f38\u60a8\u7684 PolyTrack \u904a\u6232\u8cc7\u6599\u975e\u5e38\u7c21\u55ae\u3002\u9996\u5148\uff0c\u8acb\u78ba\u4fdd\u60a8\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u767b\u5165\u76f8\u540c\u7684\u5e33\u6236\u3002\u524d\u5f80\u8a2d\u5b9a\u9078\u55ae\uff0c\u7136\u5f8c\u9078\u64c7\u300c\u96f2\u7aef\u5132\u5b58\u300d\u4ee5\u4e0a\u50b3\u60a8\u7684\u7576\u524d\u904a\u6232\u8cc7\u6599\u3002\u5728\u65b0\u88dd\u7f6e\u4e0a\u767b\u5165\u4e26\u4e0b\u8f09\u5132\u5b58\u7684\u8cc7\u6599\uff0c\u5373\u53ef\u9806\u5229\u7e7c\u7e8c\u60a8\u7684\u9032\u5ea6\uff0c\u800c\u4e0d\u6703\u907a\u5931\u4efb\u4f55\u6210\u5c31\u6216\u7269\u54c1\u3002"}]
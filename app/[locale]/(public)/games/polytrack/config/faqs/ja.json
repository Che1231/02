[{"question": "\u30dd\u30ea\u30a2\u30c8\u30e9\u30c3\u30af\u3092\u5168\u304f\u306e\u521d\u5fc3\u8005\u3068\u3057\u3066\u59cb\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30dd\u30ea\u30a2\u30c8\u30e9\u30c3\u30af\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u307e\u305a\u516c\u5f0f\u30a6\u30a7\u30d6\u30b5\u30a4\u30c8\u307e\u305f\u306f\u304a\u597d\u307f\u306e\u30a2\u30d7\u30ea\u30b9\u30c8\u30a2\u304b\u3089\u30b2\u30fc\u30e0\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3066\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u307e\u3059\u3002\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u4f5c\u6210\u3057\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3068\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u6848\u5185\u3059\u308b\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3092\u5b8c\u4e86\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u3001\u30b9\u30ef\u30a4\u30d7\u3084\u30bf\u30c3\u30d7\u306b\u3088\u3063\u3066\u30de\u30c3\u30d7\u3092\u79fb\u52d5\u3059\u308b\u65b9\u6cd5\u3092\u5b66\u3073\u307e\u3059\u3002\u8a2d\u5b9a\u3092\u78ba\u8a8d\u3057\u3066\u3001\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u3092\u597d\u307f\u306b\u5408\u308f\u305b\u3066\u8abf\u6574\u3059\u308b\u3053\u3068\u3082\u91cd\u8981\u3067\u3059\u3002"}, {"question": "\u30dd\u30ea\u30a2\u30c8\u30e9\u30c3\u30af\u3067\u30de\u30b9\u30bf\u30fc\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u91cd\u8981\u306a\u64cd\u4f5c\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30dd\u30ea\u30a2\u30c8\u30e9\u30c3\u30af\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u30ca\u30d3\u30b2\u30fc\u30b7\u30e7\u30f3\u3001\u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3\u3001\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3068\u3044\u3046\u30b3\u30a2\u64cd\u4f5c\u3092\u7406\u89e3\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30ca\u30d3\u30b2\u30fc\u30b7\u30e7\u30f3\u3067\u306f\u3001\u30ab\u30e1\u30e9\u3092\u79fb\u52d5\u3059\u308b\u306b\u306f\u30b9\u30ef\u30a4\u30d7\u3001\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u9078\u629e\u3059\u308b\u306b\u306f\u30bf\u30c3\u30d7\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3\u306f\u30b2\u30fc\u30e0\u8981\u7d20\u3068\u306e\u3084\u308a\u53d6\u308a\u306b\u4e0d\u53ef\u6b20\u3067\u3042\u308a\u3001\u30a2\u30a4\u30b3\u30f3\u3092\u30bf\u30c3\u30d7\u3057\u3066\u30ea\u30bd\u30fc\u30b9\u3092\u96c6\u3081\u307e\u3059\u3002\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u306f\u3001\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u3092\u901a\u3058\u3066\u611f\u5ea6\u3084\u30ad\u30fc\u30d0\u30a4\u30f3\u30c9\u3092\u8abf\u6574\u3057\u3001\u30d7\u30ec\u30a4\u4f53\u9a13\u3092\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3059\u308b\u3053\u3068\u3092\u53ef\u80fd\u306b\u3057\u307e\u3059\u3002"}, {"question": "\u30dd\u30ea\u30a2\u30c8\u30e9\u30c3\u30af\u3067\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u307e\u305f\u3001\u3069\u306e\u3088\u3046\u306b\u6539\u5584\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30dd\u30ea\u30a2\u30c8\u30e9\u30c3\u30af\u306b\u304a\u3051\u308b\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u306f\u3001\u6301\u7d9a\u7684\u306a\u9032\u884c\u3068\u6210\u529f\u306e\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u30ea\u30bd\u30fc\u30b9\u3092\u52b9\u7387\u7684\u306b\u7ba1\u7406\u3059\u308b\u3053\u3068\u3067\u3001\u9045\u5ef6\u3059\u308b\u3053\u3068\u306a\u304f\u69cb\u9020\u7269\u3092\u69cb\u7bc9\u304a\u3088\u3073\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b2\u30fc\u30e0\u521d\u671f\u306f\u5e38\u306b\u6728\u6750\u3068\u77f3\u306e\u53ce\u96c6\u3092\u512a\u5148\u3057\u307e\u3057\u3087\u3046\u3002\u30ea\u30bd\u30fc\u30b9\u53ce\u96c6\u3068\u5efa\u7bc9\u3092\u4ea4\u4e92\u306b\u884c\u3046\u6226\u7565\u3067\u5b89\u5b9a\u3057\u305f\u4f9b\u7d66\u3092\u7dad\u6301\u3057\u307e\u3057\u3087\u3046\u3002\u4e0d\u8981\u306a\u30a2\u30a4\u30c6\u30e0\u306e\u904e\u5270\u5728\u5eab\u3092\u9632\u3050\u305f\u3081\u3001\u5b9a\u671f\u7684\u306b\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30dd\u30ea\u30a2\u30c8\u30e9\u30c3\u30af\u306e\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3067\u512a\u4f4d\u306b\u7acb\u3064\u305f\u3081\u306b\u5f79\u7acb\u3064\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30dd\u30ea\u30a2\u30c8\u30e9\u30c3\u30af\u306e\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3067\u512a\u4f4d\u306b\u7acb\u3064\u306b\u306f\u3001\u6226\u7565\u7684\u306a\u8a08\u753b\u3068\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u304c\u5fc5\u8981\u3067\u3059\u3002\u307e\u305a\u3001\u653b\u6483\u3084\u9632\u5fa1\u3092\u8abf\u6574\u3059\u308b\u305f\u3081\u306b\u30c1\u30fc\u30e0\u3068\u52b9\u679c\u7684\u306b\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u3092\u3068\u308a\u307e\u3059\u3002\u5176\u6b21\uff0c \u512a\u4f4d\u306b\u7acb\u3064\u305f\u3081\u306b\u3001\u30e6\u30cb\u30c3\u30c8\u3084\u5efa\u7269\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3053\u3068\u306b\u91cd\u70b9\u3092\u7f6e\u304d\u307e\u3059\u3002\u7b2c\u4e09\u306b\u3001\u5909\u5316\u3059\u308b\u30b2\u30fc\u30e0\u306e\u30c0\u30a4\u30ca\u30df\u30af\u30b9\u306b\u57fa\u3065\u3044\u3066\u6226\u7565\u3092\u9069\u5fdc\u3055\u305b\u307e\u3057\u3087\u3046\u3002\u5fc5\u8981\u306b\u5fdc\u3058\u3066\u67d4\u8edf\u306b\u5bfe\u5fdc\u3067\u304d\u308b\u4f53\u5236\u3092\u6574\u3048\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30dd\u30ea\u30a2\u30c8\u30e9\u30c3\u30af\u3067\u6700\u5927\u306e\u52b9\u7387\u306e\u305f\u3081\u306b\u30d9\u30fc\u30b9\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30dd\u30ea\u30a2\u30c8\u30e9\u30c3\u30af\u3067\u30d9\u30fc\u30b9\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u5efa\u7269\u306e\u914d\u7f6e\u3068\u30ea\u30bd\u30fc\u30b9\u306e\u6226\u7565\u7684\u306a\u914d\u7f6e\u304c\u5fc5\u8981\u3067\u3059\u3002\u63a1\u6398\u5834\u3084\u8fb2\u5834\u306a\u3069\u306e\u30ea\u30bd\u30fc\u30b9\u751f\u6210\u65bd\u8a2d\u306f\u3001\u30a2\u30af\u30bb\u30b9\u3057\u3084\u3059\u304f\u3059\u308b\u305f\u3081\u306b\u4e2d\u592e\u4ed8\u8fd1\u306b\u914d\u7f6e\u3057\u307e\u3059\u3002\u9632\u885b\u65bd\u8a2d\u306f\u3001\u653b\u6483\u304b\u3089\u5b88\u308b\u305f\u3081\u306b\u5468\u56f2\u306b\u914d\u7f6e\u3059\u308b\u3079\u304d\u3067\u3059\u3002\u30b0\u30ea\u30c3\u30c9\u30b7\u30b9\u30c6\u30e0\u3092\u4f7f\u7528\u3057\u3066\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u8a08\u753b\u3057\u3001\u5c06\u6765\u306e\u62e1\u5f35\u3084\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306e\u305f\u3081\u306e\u5341\u5206\u306a\u30b9\u30da\u30fc\u30b9\u3092\u78ba\u4fdd\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30dd\u30ea\u30a2\u30c8\u30e9\u30c3\u30af\u306e\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30dd\u30ea\u30a2\u30c8\u30e9\u30c3\u30af\u306e\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u30b9\u30c8\u30fc\u30ea\u30fc\u91cd\u8996\u306e\u30df\u30c3\u30b7\u30e7\u30f3\u3068\u30bd\u30ed\u30c1\u30e3\u30ec\u30f3\u30b8\u306b\u7126\u70b9\u3092\u5f53\u3066\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u81ea\u5206\u306e\u30da\u30fc\u30b9\u3067\u30b2\u30fc\u30e0\u3092\u63a2\u7d22\u3059\u308b\u3053\u3068\u3092\u53ef\u80fd\u306b\u3057\u307e\u3059\u3002\u4e00\u65b9\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u7af6\u4e89\u3068\u5354\u529b\u306b\u91cd\u70b9\u3092\u7f6e\u304d\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u6226\u7565\u3092\u7acb\u3066\u3066\u5354\u529b\u3057\u3066\u76ee\u6a19\u3092\u9054\u6210\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u95a2\u4e0e\u306b\u3088\u308a\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30c0\u30a4\u30ca\u30df\u30af\u30b9\u306f\u4e88\u6e2c\u4e0d\u80fd\u306b\u306a\u308a\u3001\u8907\u96d1\u3055\u3068\u8208\u596e\u304c\u52a0\u308f\u308a\u307e\u3059\u3002"}, {"question": "\u30dd\u30ea\u30a2\u30c8\u30e9\u30c3\u30af\u306e\u9032\u884c\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u30de\u30a4\u30eb\u30b9\u30c8\u30fc\u30f3\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30dd\u30ea\u30a2\u30c8\u30e9\u30c3\u30af\u306e\u9032\u884c\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30df\u30c3\u30b7\u30e7\u30f3\u306e\u5b8c\u4e86\u3001\u6575\u306e\u6483\u7834\u3001\u69cb\u9020\u7269\u306e\u5efa\u8a2d\u3092\u901a\u3058\u3066\u5f97\u3089\u308c\u308b\u7d4c\u9a13\u30dd\u30a4\u30f3\u30c8\uff08XP\uff09\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u30de\u30a4\u30eb\u30b9\u30c8\u30fc\u30f3\u306b\u306f\u3001\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u3001\u65b0\u3057\u3044\u80fd\u529b\u306e\u30a2\u30f3\u30ed\u30c3\u30af\u3001\u9ad8\u5ea6\u306a\u30b3\u30f3\u30c6\u30f3\u30c4\u3078\u306e\u30a2\u30af\u30bb\u30b9\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb10\u306b\u5230\u9054\u3059\u308b\u3068\u3001\u9ad8\u5ea6\u306a\u69cb\u9020\u7269\u306e\u5efa\u8a2d\u304c\u53ef\u80fd\u306b\u306a\u308a\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4f53\u9a13\u3068\u6226\u7565\u7684\u306a\u9078\u629e\u80a2\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002"}, {"question": "\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u306e\u30dd\u30ea\u30a2\u30c8\u30e9\u30c3\u30af\u306e\u4e92\u63db\u6027\u306b\u5f71\u97ff\u3059\u308b\u8981\u56e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u306e\u30dd\u30ea\u30a2\u30c8\u30e9\u30c3\u30af\u306e\u4e92\u63db\u6027\u306f\u3001\u30cf\u30fc\u30c9\u30a6\u30a7\u30a2\u4ed5\u69d8\u3001\u30aa\u30da\u30ec\u30fc\u30c6\u30a3\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u3001\u753b\u9762\u89e3\u50cf\u5ea6\u306b\u3088\u3063\u3066\u5f71\u97ff\u3055\u308c\u307e\u3059\u3002\u30c7\u30d0\u30a4\u30b9\u304c\u3001\u5341\u5206\u306aRAM\u3068\u4e92\u63db\u6027\u306e\u3042\u308bOS\u30d0\u30fc\u30b8\u30e7\u30f3\u306a\u3069\u3001\u6700\u4f4e\u9650\u306e\u8981\u4ef6\u3092\u6e80\u305f\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3055\u3089\u306b\u3001\u30dd\u30ea\u30a2\u30c8\u30e9\u30c3\u30af\u306f\u3055\u307e\u3056\u307e\u306a\u753b\u9762\u30b5\u30a4\u30ba\u306b\u5bfe\u5fdc\u3057\u3066\u3044\u307e\u3059\u304c\u3001\u30c7\u30d0\u30a4\u30b9\u306e\u51e6\u7406\u80fd\u529b\u3068\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u30b9\u80fd\u529b\u306b\u57fa\u3065\u3044\u3066\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306f\u7570\u306a\u308a\u307e\u3059\u3002"}, {"question": "\u30dd\u30ea\u30a2\u30c8\u30e9\u30c3\u30af\u3067\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30dd\u30ea\u30a2\u30c8\u30e9\u30c3\u30af\u306b\u306f\u3001\u30b2\u30fc\u30e0\u306b\u5965\u884c\u304d\u3068\u697d\u3057\u3055\u3092\u52a0\u3048\u308b\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3068\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u305f\u304f\u3055\u3093\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u68ee\u306b\u3042\u308b\u7279\u5b9a\u306e\u6728\u3092\u8907\u6570\u56de\u30bf\u30c3\u30d7\u3059\u308b\u3068\u3001\u96a0\u3055\u308c\u305f\u5b9d\u7bb1\u304c\u51fa\u3066\u304f\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u30de\u30c3\u30d7\u306e\u9685\u3005\u307e\u3067\u63a2\u7d22\u3059\u308b\u3068\u3001\u79d8\u5bc6\u306e\u30a8\u30ea\u30a2\u3084\u73cd\u3057\u3044\u30a2\u30a4\u30c6\u30e0\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u3001\u597d\u5947\u5fc3\u65fa\u76db\u3067\u7c98\u308a\u5f37\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30e6\u30cb\u30fc\u30af\u306a\u30dc\u30fc\u30ca\u30b9\u3084\u9a5a\u304d\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30dd\u30ea\u30a2\u30c8\u30e9\u30c3\u30af\u306e\u30b2\u30fc\u30e0\u30c7\u30fc\u30bf\u3092\u30011\u3064\u306e\u30c7\u30d0\u30a4\u30b9\u304b\u3089\u5225\u306e\u30c7\u30d0\u30a4\u30b9\u306b\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u4f7f\u7528\u3059\u308c\u3070\u3001\u30dd\u30ea\u30a2\u30c8\u30e9\u30c3\u30af\u306e\u30b2\u30fc\u30e0\u30c7\u30fc\u30bf\u3092\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u7c21\u5358\u306b\u8ee2\u9001\u3067\u304d\u307e\u3059\u3002\u307e\u305a\u3001\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u306b\u30a2\u30af\u30bb\u30b9\u3057\u3001\u300e\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u300f\u3092\u9078\u629e\u3057\u3066\u73fe\u5728\u306e\u30b2\u30fc\u30e0\u30c7\u30fc\u30bf\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u30ed\u30b0\u30a4\u30f3\u3057\u3001\u4fdd\u5b58\u3055\u308c\u305f\u30c7\u30fc\u30bf\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3066\u3001\u9054\u6210\u611f\u3084\u30a2\u30a4\u30c6\u30e0\u3092\u5931\u3046\u3053\u3068\u306a\u304f\u3001\u30b9\u30e0\u30fc\u30ba\u306b\u9032\u884c\u3092\u7d9a\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}]
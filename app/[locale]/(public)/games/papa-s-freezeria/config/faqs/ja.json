[{"question": "\u30d1\u30d1\u30b9\u30d5\u30ea\u30fc\u30bc\u30ea\u30a2\u3092\u59cb\u3081\u308b\u521d\u5fc3\u8005\u306f\u3069\u306e\u3088\u3046\u306b\u3059\u308c\u3070\u3088\u304f\u3001\u57fa\u672c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u305f\u3081\u306e\u6700\u521d\u306e\u30b9\u30c6\u30c3\u30d7\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30b9\u30d5\u30ea\u30fc\u30bc\u30ea\u30a2\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u307e\u305a\u30b2\u30fc\u30e0\u30a4\u30f3\u30bf\u30fc\u30d5\u30a7\u30fc\u30b9\u306b\u6163\u308c\u308b\u3053\u3068\u3067\u3059\u3002\u30e1\u30a4\u30f3\u753b\u9762\u306b\u306f\u3001\u30aa\u30fc\u30c0\u30fc\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u3001\u30d6\u30ec\u30f3\u30c9\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u3001\u30c8\u30c3\u30d4\u30f3\u30b0\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002\u6700\u521d\u306e\u30b9\u30c6\u30c3\u30d7\u306f\u3001\u9867\u5ba2\u304b\u3089\u306e\u30aa\u30fc\u30c0\u30fc\u3092\u53d7\u3051\u53d6\u308b\u3068\u3044\u3046\u3053\u3068\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u9867\u5ba2\u304c\"\u30b9\u30c8\u30ed\u30d9\u30ea\u30fc\u30d5\u30ea\u30fc\u30ba\"\u3092\u6ce8\u6587\u3057\u305f\u5834\u5408\u3001\u30d5\u30ec\u30fc\u30d0\u30fc\u3068\u30b5\u30a4\u30ba\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6b21\u306b\u3001\u30d6\u30ec\u30f3\u30c9\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u306b\u9032\u3093\u3067\u3001\u6b63\u3057\u3044\u6750\u6599\uff08\u3053\u306e\u5834\u5408\u306f\u30b9\u30c8\u30ed\u30d9\u30ea\u30fc\u30b7\u30ed\u30c3\u30d7\u3068\u6c37\uff09\u3092\u9078\u629e\u3057\u3001\u30bf\u30a4\u30de\u30fc\u306b\u5f93\u3063\u3066\u30d6\u30ec\u30f3\u30c9\u3057\u307e\u3059\u3002\u6700\u5f8c\u306b\u3001\u8981\u6c42\u3055\u308c\u305f\u30c8\u30c3\u30d4\u30f3\u30b0\u3092\u8ffd\u52a0\u3057\u3066\u3001\u30d5\u30ea\u30fc\u30ba\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u57fa\u672c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u3067\u3001\u30b9\u30e0\u30fc\u30ba\u306b\u9032\u6b69\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "100\u6642\u9593\u30d7\u30ec\u30a4\u5f8c\u3001\u30d1\u30d1\u30b9\u30d5\u30ea\u30fc\u30bc\u30ea\u30a2\u3067\u30c1\u30c3\u30d7\u3092\u6700\u5927\u9650\u306b\u5f15\u304d\u51fa\u3059\u305f\u3081\u306e\u4e3b\u8981\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "100\u6642\u9593\u30d7\u30ec\u30a4\u5f8c\u3001\u30d1\u30d1\u30b9\u30d5\u30ea\u30fc\u30bc\u30ea\u30a2\u3067\u30c1\u30c3\u30d7\u3092\u6700\u5927\u9650\u306b\u5f15\u304d\u51fa\u3059\u306b\u306f\u3001\u6b63\u78ba\u3055\u3068\u52b9\u7387\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30bf\u30a4\u30de\u30fc\u3092\u6b63\u78ba\u306b\u5b88\u308b\u3053\u3068\u3067\u3001\u5e38\u306b\u5b8c\u74a7\u306a\u30d6\u30ec\u30f3\u30c9\u3092\u76ee\u6307\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\"\u30c1\u30e7\u30b3\u30ec\u30fc\u30c8\u30d5\u30ea\u30fc\u30ba\"\u306e\"\u5b8c\u74a7\u306a\u30d6\u30ec\u30f3\u30c9\"\u306b\u306f\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u9867\u5ba2\u306e\u597d\u307f\u3092\u899a\u3048\u3066\u6ce8\u6587\u3092\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3057\u307e\u3059\u3002\u9867\u5ba2\u304c\u30db\u30a4\u30c3\u30d7\u30af\u30ea\u30fc\u30e0\u3092 extra \u597d\u3080\u5834\u5408\u306f\u3001\u5e38\u306b\u8ffd\u52a0\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u9867\u5ba2\u306e\u4e0d\u6a5f\u5acc\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u8fc5\u901f\u306b\u63d0\u4f9b\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u6226\u7565\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3001\u30c1\u30c3\u30d7\u3092\u5927\u5e45\u306b\u5897\u3084\u3057\u3001\u5168\u4f53\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u30b9\u30d5\u30ea\u30fc\u30bc\u30ea\u30a2\u306b\u304a\u3051\u308b\u30aa\u30fc\u30c0\u30fc\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u9867\u5ba2\u6e80\u8db3\u5ea6\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30b9\u30d5\u30ea\u30fc\u30bc\u30ea\u30a2\u306b\u304a\u3051\u308b\u30aa\u30fc\u30c0\u30fc\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u306f\u3001\u9867\u5ba2\u6e80\u8db3\u5ea6\u306b\u76f4\u63a5\u5f71\u97ff\u3059\u308b\u305f\u3081\u91cd\u8981\u3067\u3059\u3002\u5404\u9867\u5ba2\u306b\u306f\u3001\u6642\u9593\u304c\u7d4c\u3064\u306b\u3064\u308c\u3066\u6e1b\u5c11\u3059\u308b\u5fcd\u8010\u529b\u30b2\u30fc\u30b8\u304c\u3042\u308a\u307e\u3059\u3002\u6ce8\u6587\u3092\u5b8c\u4e86\u3059\u308b\u306e\u306b\u6642\u9593\u304c\u304b\u304b\u308a\u3059\u304e\u308b\u3068\u3001\u9867\u5ba2\u304c\u96e2\u308c\u3066\u3057\u307e\u3044\u3001\u58f2\u4e0a\u304c\u5931\u308f\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\"\u30d0\u30cb\u30e9\u30d5\u30ea\u30fc\u30ba\"\u306e\u8abf\u7406\u306b\u6642\u9593\u304c\u304b\u304b\u308a\u3059\u304e\u308b\u3068\u3001\u9867\u5ba2\u306f\u30a4\u30e9\u30a4\u30e9\u3057\u3066\u51fa\u3066\u884c\u3063\u3066\u3057\u307e\u3044\u307e\u3059\u3002\u3053\u308c\u3089\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u3001\u30aa\u30fc\u30c0\u30fc\u306e\u53d7\u3051\u53d6\u308a\u3001\u6e96\u5099\u3001\u63d0\u4f9b\u306b\u304a\u3044\u3066\u3001\u5e38\u306b\u30b9\u30d4\u30fc\u30c9\u3068\u6b63\u78ba\u6027\u3092\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u52b9\u7387\u7684\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u306f\u3001\u9867\u5ba2\u3092\u6e80\u8db3\u3055\u305b\u3001\u30c1\u30c3\u30d7\u3092\u5897\u3084\u3057\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u30b9\u30d5\u30ea\u30fc\u30bc\u30ea\u30a2\u306e\u30d6\u30ec\u30f3\u30c9\u30d7\u30ed\u30bb\u30b9\u3092\u652f\u3048\u308b\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u3088\u3046\u306b\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30b9\u30d5\u30ea\u30fc\u30bc\u30ea\u30a2\u306e\u30d6\u30ec\u30f3\u30c9\u30d7\u30ed\u30bb\u30b9\u306f\u3001\u6b63\u3057\u3044\u6750\u6599\u3092\u9078\u629e\u3057\u3001\u9069\u5207\u306a\u6642\u9593\u3060\u3051\u30d6\u30ec\u30f3\u30c9\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u305d\u308c\u305e\u308c\u306e\u30d6\u30ec\u30f3\u30c9\u306b\u306f\u7279\u5b9a\u306e\u30bf\u30a4\u30de\u30fc\u304c\u3042\u308a\u3001\"\u5b8c\u74a7\u306a\u30d6\u30ec\u30f3\u30c9\"\u306e\u30de\u30fc\u30af\u3092\u9054\u6210\u3059\u308b\u3053\u3068\u304c\u54c1\u8cea\u306b\u3068\u3063\u3066\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\"\u30d0\u30ca\u30ca\u30d5\u30ea\u30fc\u30ba\"\u3092\u30d6\u30ec\u30f3\u30c9\u3059\u308b\u306b\u306f\u3001\u30d0\u30ca\u30ca\u30b7\u30ed\u30c3\u30d7\u3068\u6c37\u304c\u5fc5\u8981\u3067\u3059\u3002\u305d\u3057\u3066\u3001\u30bf\u30a4\u30de\u30fc\u3092\u6b63\u78ba\u306b\"\u5b8c\u74a7\u306a\u30d6\u30ec\u30f3\u30c9\"\u306e\u30be\u30fc\u30f3\u3067\u505c\u6b62\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u5e38\u306b\u30bf\u30a4\u30de\u30fc\u306b\u6ce8\u610f\u3057\u3001\u30d6\u30ec\u30f3\u30c9\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u7df4\u7fd2\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u9ad8\u54c1\u8cea\u306e\u30d5\u30ea\u30fc\u30ba\u3068\u6e80\u8db3\u3057\u305f\u9867\u5ba2\u304c\u5f97\u3089\u308c\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u30b9\u30d5\u30ea\u30fc\u30bc\u30ea\u30a2\u306e\u30c8\u30c3\u30d4\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306e\u4ed5\u7d44\u307f\u306f\u4f55\u3067\u3059\u304b\uff1f\u30c8\u30c3\u30d4\u30f3\u30b0\u3092\u8ffd\u52a0\u3059\u308b\u969b\u306e\u30d9\u30b9\u30c8\u30d7\u30e9\u30af\u30c6\u30a3\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30b9\u30d5\u30ea\u30fc\u30bc\u30ea\u30a2\u306e\u30c8\u30c3\u30d4\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u3067\u306f\u3001\u9867\u5ba2\u306e\u597d\u307f\u306b\u57fa\u3065\u3044\u3066\u3001\u3055\u307e\u3056\u307e\u306a\u30c8\u30c3\u30d4\u30f3\u30b0\u3092\u30d5\u30ea\u30fc\u30ba\u306b\u8ffd\u52a0\u3067\u304d\u307e\u3059\u3002\u5404\u30c8\u30c3\u30d4\u30f3\u30b0\u306b\u306f\u3001\u7279\u5b9a\u306e\u914d\u7f6e\u3068\u91cf\u304c\u8a2d\u5b9a\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u9867\u5ba2\u304c\"\u30df\u30f3\u30c8\u30d5\u30ea\u30fc\u30ba\"\u306b\u30db\u30a4\u30c3\u30d7\u30af\u30ea\u30fc\u30e0\u3068\u30b9\u30d7\u30ea\u30f3\u30af\u30eb\u3092\u6ce8\u6587\u3057\u305f\u5834\u5408\u3001\u6700\u521d\u306b\u30db\u30a4\u30c3\u30d7\u30af\u30ea\u30fc\u30e0\u3092\u8ffd\u52a0\u3057\u3001\u6b21\u306b\u30b9\u30d7\u30ea\u30f3\u30af\u30eb\u3092\u8ffd\u52a0\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30d9\u30b9\u30c8\u30d7\u30e9\u30af\u30c6\u30a3\u30b9\u306f\u4ee5\u4e0b\u306e\u901a\u308a\u3067\u3059\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u5e38\u306b\u6ce8\u6587\u306b\u7279\u5b9a\u306e\u30c8\u30c3\u30d4\u30f3\u30b0\u6307\u793a\u304c\u3042\u308b\u304b\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6b63\u3057\u3044\u9806\u5e8f\u3068\u91cf\u3067\u30c8\u30c3\u30d4\u30f3\u30b0\u3092\u8ffd\u52a0\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30c8\u30c3\u30d4\u30f3\u30b0\u304c\u5747\u7b49\u306b\u5206\u5e03\u3057\u3066\u3001\u8996\u899a\u7684\u306b\u9b45\u529b\u7684\u306a\u30d5\u30ea\u30fc\u30ba\u306b\u306a\u308b\u3088\u3046\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u3089\u306e\u30d7\u30e9\u30af\u30c6\u30a3\u30b9\u306b\u5f93\u3046\u3053\u3068\u3067\u3001\u9867\u5ba2\u6e80\u8db3\u5ea6\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u30b9\u30d5\u30ea\u30fc\u30bc\u30ea\u30a2\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306b\u5f71\u97ff\u3059\u308b\u8981\u56e0\u306f\u4f55\u3067\u3059\u304b\uff1f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u3088\u3046\u306b\u30b9\u30b3\u30a2\u3092\u6539\u5584\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30b9\u30d5\u30ea\u30fc\u30bc\u30ea\u30a2\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6ce8\u6587\u306e\u6b63\u78ba\u6027\u3001\u30d6\u30ec\u30f3\u30c9\u306e\u8cea\u3001\u30c8\u30c3\u30d4\u30f3\u30b0\u306e\u914d\u7f6e\u3001\u63d0\u4f9b\u901f\u5ea6\u306e4\u3064\u306e\u8981\u7d20\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\"\u30d6\u30eb\u30fc\u30d9\u30ea\u30fc\u30d5\u30ea\u30fc\u30ba\"\u306e\"\u5b8c\u74a7\u306a\u30d6\u30ec\u30f3\u30c9\"\u306b\u3001\u6b63\u78ba\u306a\u30c8\u30c3\u30d4\u30f3\u30b0\u3068\u8fc5\u901f\u306a\u30b5\u30fc\u30d3\u30b9\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3068\u3001\u9ad8\u30b9\u30b3\u30a2\u306b\u306a\u308a\u307e\u3059\u3002\u30b9\u30b3\u30a2\u3092\u6539\u5584\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u304f\u3060\u3055\u3044\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u30bf\u30a4\u30de\u30fc\u3092\u9069\u5207\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u505c\u6b62\u3055\u305b\u3066\u30d6\u30ec\u30f3\u30c9\u3092\u5b8c\u74a7\u306b\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6b63\u78ba\u3067\u6b63\u3057\u3044\u9806\u5e8f\u3067\u30c8\u30c3\u30d4\u30f3\u30b0\u3092\u8ffd\u52a0\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6ce8\u6587\u3092\u3067\u304d\u308b\u3060\u3051\u65e9\u304f\u63d0\u4f9b\u3059\u308b\u3002\u3053\u308c\u3089\u306e\u8981\u7d20\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u3068\u512a\u308c\u305f\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5b9f\u73fe\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u30d1\u30d1\u30b9\u30d5\u30ea\u30fc\u30bc\u30ea\u30a2\u3092\u5b9f\u884c\u3059\u308b\u305f\u3081\u306e\u6280\u8853\u7684\u306a\u8981\u4ef6\u306f\u4f55\u3067\u3059\u304b\uff1f\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306f\u3069\u306e\u3088\u3046\u306b\u7570\u306a\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30b9\u30d5\u30ea\u30fc\u30bc\u30ea\u30a2\u306f\u3001PC\u3001\u30e2\u30d0\u30a4\u30eb\u3001\u30bf\u30d6\u30ec\u30c3\u30c8\u306a\u3069\u3001\u8907\u6570\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u5229\u7528\u3067\u304d\u307e\u3059\u3002\u6280\u8853\u7684\u306a\u8981\u4ef6\u306f\u308f\u305a\u304b\u306b\u7570\u306a\u308a\u307e\u3059\u3002PC\u306f\u4e00\u822c\u7684\u306b\u57fa\u672c\u7684\u306a\u30a6\u30a7\u30d6\u30d6\u30e9\u30a6\u30b6\u3068\u30a4\u30f3\u30bf\u30fc\u30cd\u30c3\u30c8\u63a5\u7d9a\u304c\u5fc5\u8981\u3067\u3059\u304c\u3001\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u306f\u6700\u65b0\u306eOS\u30d0\u30fc\u30b8\u30e7\u30f3\u3068\u5341\u5206\u306a\u30b9\u30c8\u30ec\u30fc\u30b8\u304c\u5fc5\u8981\u3067\u3059\u3002\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u5168\u4f53\u3067\u901a\u5e38\u30b9\u30e0\u30fc\u30ba\u3067\u3059\u304c\u3001PC\u306f\u5927\u304d\u306a\u753b\u9762\u3068\u512a\u308c\u305f\u51e6\u7406\u80fd\u529b\u306b\u3088\u308a\u3001\u3088\u308a\u5b89\u5b9a\u3057\u305f\u4f53\u9a13\u3092\u63d0\u4f9b\u3059\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u9ad8\u89e3\u50cf\u5ea6\u306e\u30e2\u30cb\u30bf\u30fc\u3067PC\u3067\u30d7\u30ec\u30a4\u3059\u308b\u3068\u3001\u5c0f\u3055\u306a\u30e2\u30d0\u30a4\u30eb\u753b\u9762\u3068\u6bd4\u8f03\u3057\u3066\u8996\u899a\u4f53\u9a13\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u30011\u3064\u306e\u30c7\u30d0\u30a4\u30b9\u304b\u3089\u5225\u306e\u30c7\u30d0\u30a4\u30b9\u306b\u30d1\u30d1\u30b9\u30d5\u30ea\u30fc\u30bc\u30ea\u30a2\u306e\u9032\u884c\u72b6\u6cc1\u3092\u79fb\u884c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u30d1\u30d1\u30b9\u30d5\u30ea\u30fc\u30bc\u30ea\u30a2\u306e\u9032\u884c\u72b6\u6cc1\u3092\u79fb\u884c\u3059\u308b\u306b\u306f\u3001\u30b2\u30fc\u30e0\u30c7\u30fc\u30bf\u3092\u30af\u30e9\u30a6\u30c9\u306b\u4fdd\u5b58\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u73fe\u5728\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u30b2\u30fc\u30e0\u306e\u8a2d\u5b9a\u306b\u30a2\u30af\u30bb\u30b9\u3057\u3001\"\u30af\u30e9\u30a6\u30c9\u306b\u4fdd\u5b58\"\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30af\u30e9\u30a6\u30c9\u304b\u3089\u4fdd\u5b58\u3057\u305f\u30c7\u30fc\u30bf\u3092\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u3067\u30d7\u30ec\u30a4\u3057\u3066PC\u306b\u5207\u308a\u66ff\u3048\u305f\u3044\u5834\u5408\u3001\u624b\u9806\u306b\u5f93\u3046\u3053\u3068\u3067\u3001\u9032\u884c\u72b6\u6cc1\u304c\u30b7\u30fc\u30e0\u30ec\u30b9\u306b\u79fb\u884c\u3055\u308c\u307e\u3059\u3002\u3053\u306e\u65b9\u6cd5\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u30b2\u30fc\u30e0\u30c7\u30fc\u30bf\u3092\u5931\u3046\u3053\u3068\u306a\u304f\u30b9\u30e0\u30fc\u30ba\u306b\u5207\u308a\u66ff\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u30b9\u30d5\u30ea\u30fc\u30bc\u30ea\u30a2\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30b9\u30d5\u30ea\u30fc\u30bc\u30ea\u30a2\u306b\u306f\u3001\u30b2\u30fc\u30e0\u3092\u697d\u3057\u304f\u3059\u308b\u3044\u304f\u3064\u304b\u306e\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30b2\u30fc\u30e0\u3067\"\u30d1\u30d1\u30fb\u30eb\u30a4\"\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u7e70\u308a\u8fd4\u3057\u30af\u30ea\u30c3\u30af\u3059\u308b\u3068\u3001\u7279\u6b8a\u306a\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3\u3092\u5b9f\u884c\u3057\u305f\u308a\u3001\u30e6\u30cb\u30fc\u30af\u306a\u30b3\u30e1\u30f3\u30c8\u3092\u4e0e\u3048\u305f\u308a\u3059\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u7279\u5b9a\u306e\u6750\u6599\u3084\u30c8\u30c3\u30d4\u30f3\u30b0\u306e\u7d44\u307f\u5408\u308f\u305b\u306f\u3001\u9867\u5ba2\u304b\u3089\u7279\u6b8a\u306a\u53cd\u5fdc\u3092\u5f15\u304d\u8d77\u3053\u3059\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u96a0\u3055\u308c\u305f\u8981\u7d20\u3092\u63a2\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u3001\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u5f37\u5316\u3057\u3001\u8ffd\u52a0\u306e\u30a8\u30f3\u30bf\u30fc\u30c6\u30a4\u30e1\u30f3\u30c8\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30d7\u30ec\u30a4\u4e2d\u306b\u3053\u308c\u3089\u306e\u5fae\u5999\u306a\u8a73\u7d30\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30d1\u30d1\u30b9\u30d5\u30ea\u30fc\u30bc\u30ea\u30a2\u306e\u96e3\u6613\u5ea6\u9032\u884c\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u9032\u6b69\u3059\u308b\u306b\u3064\u308c\u3066\u3001\u3069\u306e\u3088\u3046\u306a\u3053\u3068\u3092\u671f\u5f85\u3059\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30b9\u30d5\u30ea\u30fc\u30bc\u30ea\u30a2\u306e\u96e3\u6613\u5ea6\u9032\u884c\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u65b0\u3057\u3044\u30ec\u30d9\u30eb\u3084\u6a5f\u80fd\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u306b\u3064\u308c\u3066\u5897\u52a0\u3057\u307e\u3059\u3002\u521d\u671f\u306f\u3001\u57fa\u672c\u7684\u306a\u6ce8\u6587\u3068\u7c21\u5358\u306a\u30d6\u30ec\u30f3\u30c9\u304c\u5c0e\u5165\u3055\u308c\u307e\u3059\u3002\u9032\u6b69\u3059\u308b\u306b\u3064\u308c\u3066\u3001\u8907\u6570\u306e\u6750\u6599\u3068\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u5fc5\u8981\u306a\u975e\u5e38\u306b\u8907\u96d1\u306a\u6ce8\u6587\u306b\u306a\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u521d\u671f\u30ec\u30d9\u30eb\u306f\"\u30b7\u30f3\u30b0\u30eb\u30d5\u30ec\u30fc\u30d0\u30fc\u30d5\u30ea\u30fc\u30ba\"\u3067\u3059\u304c\u3001\u5f8c\u3005\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u8907\u96d1\u306a\u30c8\u30c3\u30d4\u30f3\u30b0\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u6301\u3064\"\u30de\u30eb\u30c1\u30d5\u30ec\u30fc\u30d0\u30fc\u30d5\u30ea\u30fc\u30ba\"\u304c\u767b\u5834\u3057\u307e\u3059\u3002\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30d6\u30ec\u30f3\u30c9\u3001\u30c8\u30c3\u30d4\u30f3\u30b0\u306e\u914d\u7f6e\u3001\u30aa\u30fc\u30c0\u30fc\u7ba1\u7406\u306e\u30b9\u30ad\u30eb\u3092\u78e8\u304f\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u96e3\u6613\u5ea6\u306e\u5897\u52a0\u306b\u5bfe\u5fdc\u3057\u3001\u9ad8\u3044\u9867\u5ba2\u6e80\u8db3\u5ea6\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u3002"}]
[{"question": "\u5982\u4f55\u8b93\u65b0\u624b\u958b\u59cb\u73a9 Papa's Freezeria \u4e26\u4e14\u5982\u4f55\u5feb\u901f\u638c\u63e1\u57fa\u672c\u64cd\u4f5c?", "answer": "\u8981\u958b\u59cb\u73a9 Papa's Freezeria\uff0c\u9996\u5148\uff0c\u8acb\u5148\u719f\u6089\u904a\u6232\u4ecb\u9762\u3002\u4e3b\u756b\u9762\u986f\u793a\u8a02\u55ae\u7ad9\u3001\u652a\u62cc\u7ad9\u548c\u88dd\u98fe\u7ad9\u3002\u4f60\u7684\u7b2c\u4e00\u6b65\u662f\u63a5\u53d7\u9867\u5ba2\u7684\u8a02\u55ae\u3002\u4f8b\u5982\uff0c\u5982\u679c\u9867\u5ba2\u9ede\u4e86\u300e\u8349\u8393\u971c\u6dc7\u6dcb\u300f\uff0c\u8acb\u8a18\u4e0b\u53e3\u5473\u548c\u5927\u5c0f\u3002\u63a5\u4e0b\u4f86\uff0c\u524d\u5f80\u652a\u62cc\u7ad9\uff0c\u9078\u64c7\u6b63\u78ba\u7684\u6750\u6599\uff08\u5728\u672c\u4f8b\u4e2d\u70ba\u8349\u8393\u91ac\u548c\u51b0\uff09\uff0c\u4e26\u6309\u7167\u8a08\u6642\u5668\u652a\u62cc\u3002\u6700\u5f8c\uff0c\u6309\u7167\u8981\u6c42\u6dfb\u52a0\u914d\u6599\u4e26\u5c07\u971c\u6dc7\u6dcb\u9001\u4e0a\u3002\u638c\u63e1\u9019\u4e9b\u57fa\u672c\u64cd\u4f5c\u5c07\u6709\u52a9\u65bc\u4f60\u9806\u5229\u9032\u5c55\u3002"}, {"question": "\u5728\u73a9 Papa's Freezeria 100 \u5c0f\u6642\u5f8c\uff0c\u6709\u54ea\u4e9b\u95dc\u9375\u7b56\u7565\u53ef\u4ee5\u6700\u5927\u5316\u5c0f\u8cbb?", "answer": "\u5728\u73a9 Papa's Freezeria 100 \u5c0f\u6642\u5f8c\uff0c\u8981\u6700\u5927\u5316\u5c0f\u8cbb\uff0c\u9700\u8981\u7cbe\u78ba\u548c\u9ad8\u6548\u3002\u6b65\u9a5f\u4e00\uff1a\u59cb\u7d42\u81f4\u529b\u65bc\u5b8c\u7f8e\u652a\u62cc\uff0c\u6e96\u78ba\u5730\u9075\u5faa\u8a08\u6642\u5668\u3002\u4f8b\u5982\uff0c\u300e\u5de7\u514b\u529b\u971c\u6dc7\u6dcb\u300f\u7684\u300e\u5b8c\u7f8e\u652a\u62cc\u300f\u9700\u8981\u7cbe\u78ba\u7684\u8a08\u6642\u3002\u6b65\u9a5f\u4e8c\uff1a\u6839\u64da\u9867\u5ba2\u7684\u559c\u597d\u5ba2\u88fd\u5316\u8a02\u55ae\u3002\u5982\u679c\u9867\u5ba2\u559c\u6b61\u984d\u5916\u7684\u9bae\u5976\u6cb9\uff0c\u8acb\u52d9\u5fc5\u6dfb\u52a0\u3002\u6b65\u9a5f\u4e09\uff1a\u5feb\u901f\u670d\u52d9\u4ee5\u907f\u514d\u9867\u5ba2\u4e0d\u8010\u7169\u3002\u900f\u904e\u7d50\u5408\u9019\u4e9b\u7b56\u7565\uff0c\u60a8\u53ef\u4ee5\u986f\u8457\u589e\u52a0\u5c0f\u8cbb\u4e26\u63d0\u5347\u6574\u9ad4\u8868\u73fe\u3002"}, {"question": "\u5728 Papa's Freezeria \u4e2d\uff0c\u70ba\u4f55\u8a02\u55ae\u6642\u9593\u81f3\u95dc\u91cd\u8981\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u97ff\u9867\u5ba2\u6eff\u610f\u5ea6?", "answer": "\u5728 Papa's Freezeria \u4e2d\uff0c\u8a02\u55ae\u6642\u9593\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u76f4\u63a5\u5f71\u97ff\u9867\u5ba2\u6eff\u610f\u5ea6\u3002\u6bcf\u500b\u9867\u5ba2\u90fd\u6709\u500b\u8010\u6027\u8a08\uff0c\u96a8\u8457\u6642\u9593\u6d41\u901d\u800c\u6e1b\u5c11\u3002\u5982\u679c\u82b1\u8cbb\u592a\u9577\u6642\u9593\u5b8c\u6210\u8a02\u55ae\uff0c\u9867\u5ba2\u53ef\u80fd\u6703\u96e2\u958b\uff0c\u5c0e\u81f4\u6536\u5165\u640d\u5931\u3002\u4f8b\u5982\uff0c\u5982\u679c\u300e\u9999\u8349\u971c\u6dc7\u6dcb\u300f\u7684\u6e96\u5099\u6642\u9593\u904e\u9577\uff0c\u9867\u5ba2\u53ef\u80fd\u6703\u8b8a\u5f97\u4e0d\u8010\u7169\u800c\u96e2\u958b\u3002\u70ba\u4e86\u907f\u514d\u9019\u7a2e\u60c5\u6cc1\uff0c\u8acb\u59cb\u7d42\u512a\u5148\u8003\u616e\u5728\u63a5\u55ae\u3001\u6e96\u5099\u548c\u9001\u9910\u6642\u7684\u5feb\u901f\u548c\u6e96\u78ba\u3002\u6709\u6548\u7684\u6642\u9593\u63a7\u5236\u78ba\u4fdd\u9867\u5ba2\u6eff\u610f\u548c\u66f4\u9ad8\u7684\u5c0f\u8cbb\u3002"}, {"question": "Papa's Freezeria \u4e2d\u652a\u62cc\u904e\u7a0b\u80cc\u5f8c\u7684\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f\u73a9\u5bb6\u5982\u4f55\u512a\u5316\u9019\u500b\u904e\u7a0b\uff1f", "answer": "Papa's Freezeria \u7684\u652a\u62cc\u904e\u7a0b\u5305\u62ec\u9078\u64c7\u6b63\u78ba\u7684\u6750\u6599\u4e26\u652a\u62cc\u9069\u7576\u7684\u6642\u9593\u3002\u6bcf\u500b\u652a\u62cc\u90fd\u6709\u7279\u5b9a\u7684\u8a08\u6642\u5668\uff0c\u4e26\u64ca\u4e2d\u300e\u5b8c\u7f8e\u652a\u62cc\u300f\u6a19\u8a18\u5c0d\u65bc\u54c1\u8cea\u81f3\u95dc\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u652a\u62cc\u300e\u9999\u8549\u971c\u6dc7\u6dcb\u300f\u9700\u8981\u9999\u8549\u91ac\u548c\u51b0\uff0c\u8a08\u6642\u5668\u5fc5\u9808\u7cbe\u78ba\u5730\u505c\u5728\u300c\u5b8c\u7f8e\u652a\u62cc\u300d\u5340\u3002\u70ba\u512a\u5316\uff0c\u8acb\u52d9\u5fc5\u6ce8\u610f\u8a08\u6642\u5668\u4e26\u7df4\u7fd2\u8a08\u6642\u4f60\u7684\u652a\u62cc\u3002\u9019\u78ba\u4fdd\u4e86\u9ad8\u54c1\u8cea\u7684\u971c\u6dc7\u6dcb\u548c\u9867\u5ba2\u6eff\u610f\u5ea6\u3002"}, {"question": "Papa's Freezeria \u4e2d\u7684\u88dd\u98fe\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff1f\u6dfb\u52a0\u914d\u6599\u7684\u6700\u4f73\u5be6\u52d9\u662f\u4ec0\u9ebc\uff1f", "answer": "Papa's Freezeria \u7684\u88dd\u98fe\u7cfb\u7d71\u5141\u8a31\u73a9\u5bb6\u6839\u64da\u9867\u5ba2\u559c\u597d\u5411\u4ed6\u5011\u7684\u971c\u6dc7\u6dcb\u6dfb\u52a0\u5404\u7a2e\u914d\u6599\u3002\u6bcf\u7a2e\u914d\u6599\u90fd\u6709\u7279\u5b9a\u7684\u4f4d\u7f6e\u548c\u6578\u91cf\u3002\u4f8b\u5982\uff0c\u5982\u679c\u9867\u5ba2\u9ede\u4e86\u300e\u8584\u8377\u971c\u6dc7\u6dcb\u300f\uff0c\u642d\u914d\u9bae\u5976\u6cb9\u548c\u7cd6\u971c\uff0c\u4f60\u5fc5\u9808\u5148\u6dfb\u52a0\u9bae\u5976\u6cb9\uff0c\u7136\u5f8c\u518d\u6dfb\u52a0\u7cd6\u971c\u3002\u6700\u4f73\u5be6\u52d9\u5305\u62ec\uff1a\u6b65\u9a5f\u4e00\uff1a\u59cb\u7d42\u6aa2\u67e5\u8a02\u55ae\u4e0a\u7684\u7279\u5b9a\u914d\u6599\u8aaa\u660e\u3002\u6b65\u9a5f\u4e8c\uff1a\u6309\u7167\u6b63\u78ba\u7684\u9806\u5e8f\u548c\u6578\u91cf\u6dfb\u52a0\u914d\u6599\u3002\u6b65\u9a5f\u4e09\uff1a\u78ba\u4fdd\u914d\u6599\u5747\u52fb\u5206\u4f48\uff0c\u8b93\u971c\u6dc7\u6dcb\u770b\u8d77\u4f86\u66f4\u5177\u5438\u5f15\u529b\u3002\u9075\u5faa\u9019\u4e9b\u5be6\u52d9\u53ef\u63d0\u5347\u9867\u5ba2\u6eff\u610f\u5ea6\u3002"}, {"question": "\u54ea\u4e9b\u56e0\u7d20\u5f71\u97ff Papa's Freezeria \u7684\u8a08\u5206\u7cfb\u7d71\uff1f\u73a9\u5bb6\u5982\u4f55\u63d0\u9ad8\u4ed6\u5011\u7684\u5f97\u5206\uff1f", "answer": "Papa's Freezeria \u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u5e7e\u500b\u56e0\u7d20\uff1a\u8a02\u55ae\u6e96\u78ba\u5ea6\u3001\u652a\u62cc\u54c1\u8cea\u3001\u914d\u6599\u64fa\u653e\u4f4d\u7f6e\u548c\u670d\u52d9\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u300e\u85cd\u8393\u971c\u6dc7\u6dcb\u300f\u7684\u300e\u5b8c\u7f8e\u652a\u62cc\u300f\uff0c\u642d\u914d\u6e96\u78ba\u7684\u914d\u6599\u548c\u5feb\u901f\u670d\u52d9\uff0c\u5c07\u6703\u7372\u5f97\u9ad8\u5206\u3002\u70ba\u4e86\u63d0\u9ad8\u5f97\u5206\uff0c\u8acb\u5c08\u6ce8\u65bc\uff1a\u6b65\u9a5f\u4e00\uff1a\u901a\u904e\u5728\u6b63\u78ba\u7684\u6642\u9593\u505c\u6b62\u8a08\u6642\u5668\u4f86\u5b8c\u5584\u4f60\u7684\u652a\u62cc\u3002\u6b65\u9a5f\u4e8c\uff1a\u6e96\u78ba\u5730\u6309\u7167\u6b63\u78ba\u7684\u9806\u5e8f\u6dfb\u52a0\u914d\u6599\u3002\u6b65\u9a5f\u4e09\uff1a\u76e1\u5feb\u670d\u52d9\u8a02\u55ae\u3002\u900f\u904e\u638c\u63e1\u9019\u4e9b\u5143\u7d20\uff0c\u60a8\u53ef\u4ee5\u7372\u5f97\u66f4\u9ad8\u7684\u5206\u6578\u548c\u66f4\u597d\u7684\u8868\u73fe\u3002"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u904b\u884c Papa's Freezeria \u9700\u8981\u54ea\u4e9b\u6280\u8853\u8981\u6c42\uff1f\u6548\u80fd\u6703\u5982\u4f55\u8b8a\u5316\uff1f", "answer": "Papa's Freezeria \u53ef\u5728\u591a\u500b\u5e73\u53f0\u4e0a\u4f7f\u7528\uff0c\u5305\u62ec PC\u3001\u884c\u52d5\u88dd\u7f6e\u548c\u5e73\u677f\u96fb\u8166\u3002\u6280\u8853\u8981\u6c42\u7565\u6709\u4e0d\u540c\uff1aPC \u901a\u5e38\u9700\u8981\u57fa\u672c\u7684\u7db2\u9801\u700f\u89bd\u5668\u548c\u7db2\u8def\u9023\u7dda\uff0c\u800c\u884c\u52d5\u88dd\u7f6e\u5247\u9700\u8981\u6700\u65b0\u7684\u4f5c\u696d\u7cfb\u7d71\u7248\u672c\u548c\u8db3\u5920\u7684\u5132\u5b58\u7a7a\u9593\u3002\u4e0d\u540c\u5e73\u53f0\u7684\u6548\u80fd\u901a\u5e38\u90fd\u5f88\u9806\u66a2\uff0c\u4f46\u7531\u65bc\u87a2\u5e55\u8f03\u5927\u4e14\u8655\u7406\u80fd\u529b\u8f03\u5f37\uff0cPC \u7684\u9ad4\u9a57\u53ef\u80fd\u66f4\u7a69\u5b9a\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u9ad8\u89e3\u6790\u5ea6\u87a2\u5e55\u7684 PC \u53ef\u4ee5\u6bd4\u8f03\u5c0f\u7684\u884c\u52d5\u88dd\u7f6e\u87a2\u5e55\u589e\u5f37\u8996\u89ba\u9ad4\u9a57\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5c07\u4ed6\u5011\u7684 Papa's Freezeria \u9032\u5ea6\u5f9e\u4e00\u500b\u88dd\u7f6e\u9077\u79fb\u5230\u53e6\u4e00\u500b\uff1f", "answer": "\u5728\u4e0d\u540c\u88dd\u7f6e\u4e4b\u9593\u9077\u79fb Papa's Freezeria \u9032\u5ea6\uff0c\u53ef\u4ee5\u5c07\u904a\u6232\u8cc7\u6599\u5132\u5b58\u5230\u96f2\u7aef\u3002\u6b65\u9a5f\u4e00\uff1a\u5728\u60a8\u7576\u524d\u7684\u88dd\u7f6e\u4e0a\uff0c\u524d\u5f80\u904a\u6232\u8a2d\u5b9a\u4e26\u9078\u64c7\u300c\u5132\u5b58\u5230\u96f2\u7aef\u300d\u9078\u9805\u3002\u6b65\u9a5f\u4e8c\uff1a\u5728\u60a8\u7684\u65b0\u88dd\u7f6e\u4e0a\u4f7f\u7528\u76f8\u540c\u7684\u5e33\u6236\u767b\u5165\u3002\u6b65\u9a5f\u4e09\uff1a\u5f9e\u96f2\u7aef\u8f09\u5165\u60a8\u7684\u5132\u5b58\u8cc7\u6599\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u884c\u52d5\u88dd\u7f6e\u4e0a\u904a\u73a9\uff0c\u60f3\u5207\u63db\u5230 PC\uff0c\u8acb\u9075\u5faa\u9019\u4e9b\u6b65\u9a5f\uff0c\u78ba\u4fdd\u60a8\u7684\u9032\u5ea6\u9806\u5229\u8f49\u79fb\u3002\u6b64\u65b9\u6cd5\u4f7f\u7121\u7e2b\u8f49\u63db\uff0c\u4e0d\u6703\u640d\u5931\u4efb\u4f55\u904a\u6232\u8cc7\u6599\u3002"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728 Papa's Freezeria \u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "Papa's Freezeria \u6709\u4e00\u4e9b\u96b1\u85cf\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u589e\u6dfb\u4e86\u6a02\u8da3\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u904a\u6232\u4e2d\u53cd\u8986\u9ede\u64ca\u300ePapa Louie\u300f\u89d2\u8272\uff0c\u4ed6\u53ef\u80fd\u6703\u57f7\u884c\u7279\u6b8a\u52d5\u756b\u6216\u8aaa\u660e\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u6750\u6599\u6216\u914d\u6599\u7684\u7d44\u5408\u53ef\u80fd\u6703\u89f8\u767c\u9867\u5ba2\u7684\u7279\u6b8a\u53cd\u61c9\u3002\u63a2\u7d22\u9019\u4e9b\u96b1\u85cf\u5143\u7d20\u53ef\u4ee5\u63d0\u5347\u4f60\u7684\u904a\u6232\u9ad4\u9a57\u4e26\u63d0\u4f9b\u984d\u5916\u7684\u5a1b\u6a02\u3002\u5728\u904a\u6232\u904e\u7a0b\u4e2d\uff0c\u8acb\u7559\u610f\u9019\u4e9b\u7d30\u5fae\u7684\u7d30\u7bc0\u3002"}, {"question": "Papa's Freezeria \u4e2d\u7684\u96e3\u5ea6\u63d0\u5347\u5982\u4f55\u5f71\u97ff\u904a\u6232\u9ad4\u9a57\uff1f\u73a9\u5bb6\u5728\u9032\u968e\u6642\u61c9\u8a72\u9810\u671f\u4ec0\u9ebc\uff1f", "answer": "\u96a8\u8457\u73a9\u5bb6\u89e3\u9396\u65b0\u7684\u95dc\u5361\u548c\u529f\u80fd\uff0cPapa's Freezeria \u7684\u96e3\u5ea6\u4e5f\u6703\u589e\u52a0\u3002\u8d77\u521d\uff0c\u904a\u6232\u6703\u4ecb\u7d39\u57fa\u672c\u8a02\u55ae\u548c\u7c21\u55ae\u7684\u652a\u62cc\u3002\u96a8\u8457\u4f60\u7684\u9032\u968e\uff0c\u8a02\u55ae\u5c07\u8b8a\u5f97\u66f4\u8907\u96dc\uff0c\u9700\u8981\u591a\u7a2e\u6750\u6599\u548c\u7cbe\u78ba\u7684\u8a08\u6642\u3002\u4f8b\u5982\uff0c\u65e9\u671f\u95dc\u5361\u53ef\u80fd\u6d89\u53ca\u300e\u55ae\u4e00\u98a8\u5473\u971c\u6dc7\u6dcb\u300f\uff0c\u800c\u5f8c\u671f\u7684\u95dc\u5361\u5247\u6703\u5f15\u5165\u300e\u591a\u98a8\u5473\u971c\u6dc7\u6dcb\u300f\uff0c\u914d\u6709\u591a\u7a2e\u8907\u96dc\u7684\u914d\u6599\u7d44\u5408\u3002\u73a9\u5bb6\u61c9\u8a72\u9810\u671f\u9700\u8981\u767c\u5c55\u4ed6\u5011\u7684\u652a\u62cc\u3001\u914d\u6599\u64fa\u653e\u548c\u8a02\u55ae\u7ba1\u7406\u6280\u5de7\uff0c\u4ee5\u8ddf\u4e0a\u96e3\u5ea6\u7684\u63d0\u5347\u4e26\u7dad\u6301\u9ad8\u9867\u5ba2\u6eff\u610f\u5ea6\u3002"}]
[{"question": "\u521d\u5b66\u8005\u5982\u4f55\u5f00\u59cb\u73a9Papa's Freezeria\uff0c\u4ee5\u53ca\u638c\u63e1\u57fa\u7840\u7684\u6b65\u9aa4\u6709\u54ea\u4e9b\uff1f", "answer": "\u5f00\u59cb\u73a9Papa's Freezeria\uff0c\u9996\u5148\u8981\u719f\u6089\u6e38\u620f\u754c\u9762\u3002\u4e3b\u5c4f\u5e55\u663e\u793a\u4e86\u8ba2\u5355\u7ad9\u3001\u6df7\u5408\u7ad9\u548c\u914d\u6599\u7ad9\u3002\u4f60\u7684\u7b2c\u4e00\u6b65\u662f\u4ece\u987e\u5ba2\u90a3\u91cc\u63a5\u5355\u3002\u4f8b\u5982\uff0c\u5982\u679c\u987e\u5ba2\u70b9\u4e86\u4e00\u4efd\u201c\u8349\u8393\u51bb\u201d\uff0c\u8bf7\u6ce8\u610f\u53e3\u5473\u548c\u5927\u5c0f\u3002\u63a5\u4e0b\u6765\uff0c\u524d\u5f80\u6df7\u5408\u7ad9\uff0c\u9009\u62e9\u6b63\u786e\u7684\u98df\u6750\uff08\u5728\u672c\u4f8b\u4e2d\u662f\u8349\u8393\u7cd6\u6d46\u548c\u51b0\uff09\uff0c\u5e76\u6839\u636e\u8ba1\u65f6\u5668\u8fdb\u884c\u6df7\u5408\u3002\u6700\u540e\uff0c\u6839\u636e\u8981\u6c42\u6dfb\u52a0\u914d\u6599\u5e76\u63d0\u4f9b\u51bb\u54c1\u3002\u638c\u63e1\u8fd9\u4e9b\u57fa\u7840\u77e5\u8bc6\u5c06\u5e2e\u52a9\u4f60\u987a\u5229\u63d0\u5347\u3002"}, {"question": "\u5728\u73a9Papa's Freezeria 100 \u5c0f\u65f6\u540e\uff0c\u5982\u4f55\u6700\u5927\u5316\u5c0f\u8d39\uff1f", "answer": "\u5728\u73a9Papa's Freezeria 100 \u5c0f\u65f6\u540e\uff0c\u6700\u5927\u5316\u5c0f\u8d39\u9700\u8981\u7cbe\u786e\u548c\u9ad8\u6548\u3002\u6b65\u9aa4\u4e00\uff1a\u59cb\u7ec8\u52aa\u529b\u505a\u5230\u5b8c\u7f8e\u6df7\u5408\uff0c\u51c6\u786e\u9075\u5faa\u8ba1\u65f6\u5668\u3002\u4f8b\u5982\uff0c\u4e00\u4efd\u201c\u5de7\u514b\u529b\u51bb\u201d\u7684\u201c\u5b8c\u7f8e\u6df7\u5408\u201d\u9700\u8981\u7cbe\u786e\u7684\u65f6\u673a\u3002\u6b65\u9aa4\u4e8c\uff1a\u901a\u8fc7\u8bb0\u4f4f\u987e\u5ba2\u504f\u597d\u6765\u5b9a\u5236\u8ba2\u5355\u3002\u5982\u679c\u987e\u5ba2\u559c\u6b22\u989d\u5916\u52a0\u5976\u6cb9\uff0c\u8bf7\u52a1\u5fc5\u6dfb\u52a0\u3002\u6b65\u9aa4\u4e09\uff1a\u5feb\u901f\u670d\u52a1\u4ee5\u907f\u514d\u987e\u5ba2\u4e0d\u8010\u70e6\u3002\u901a\u8fc7\u7ed3\u5408\u8fd9\u4e9b\u7b56\u7565\uff0c\u4f60\u53ef\u4ee5\u663e\u8457\u589e\u52a0\u4f60\u7684\u5c0f\u8d39\u5e76\u63d0\u9ad8\u4f60\u7684\u6574\u4f53\u8868\u73b0\u3002"}, {"question": "Papa's Freezeria \u4e2d\u7684\u8ba2\u5355\u65f6\u95f4\u4e3a\u4ec0\u4e48\u81f3\u5173\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u5f71\u54cd\u987e\u5ba2\u6ee1\u610f\u5ea6\uff1f", "answer": "Papa's Freezeria \u4e2d\u7684\u8ba2\u5355\u65f6\u95f4\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u76f4\u63a5\u5f71\u54cd\u987e\u5ba2\u6ee1\u610f\u5ea6\u3002\u6bcf\u4e2a\u987e\u5ba2\u90fd\u6709\u4e00\u4e2a\u968f\u7740\u65f6\u95f4\u7684\u63a8\u79fb\u800c\u51cf\u5c11\u7684\u8010\u5fc3\u503c\u3002\u5982\u679c\u60a8\u82b1\u8d39\u8fc7\u957f\u65f6\u95f4\u6765\u5b8c\u6210\u8ba2\u5355\uff0c\u987e\u5ba2\u53ef\u80fd\u4f1a\u79bb\u5f00\uff0c\u4ece\u800c\u5bfc\u81f4\u6536\u5165\u635f\u5931\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4e00\u4efd\u201c\u9999\u8349\u51bb\u201d\u7684\u5236\u4f5c\u65f6\u95f4\u592a\u957f\uff0c\u987e\u5ba2\u53ef\u80fd\u4f1a\u53d8\u5f97\u4e0d\u8010\u70e6\u5e76\u79bb\u5f00\u3002\u4e3a\u4e86\u907f\u514d\u8fd9\u79cd\u60c5\u51b5\uff0c\u8bf7\u59cb\u7ec8\u4f18\u5148\u8003\u8651\u63a5\u5355\u3001\u5236\u4f5c\u548c\u9001\u9910\u7684\u901f\u5ea6\u548c\u51c6\u786e\u6027\u3002\u9ad8\u6548\u7684\u8ba1\u65f6\u53ef\u4ee5\u786e\u4fdd\u987e\u5ba2\u6ee1\u610f\u5ea6\u9ad8\uff0c\u5e76\u83b7\u5f97\u66f4\u591a\u5c0f\u8d39\u3002"}, {"question": "Papa's Freezeria \u4e2d\u7684\u6df7\u5408\u8fc7\u7a0b\u673a\u5236\u662f\u4ec0\u4e48\uff0c\u73a9\u5bb6\u5982\u4f55\u4f18\u5316\u5b83\uff1f", "answer": "Papa's Freezeria \u4e2d\u7684\u6df7\u5408\u8fc7\u7a0b\u5305\u62ec\u9009\u62e9\u6b63\u786e\u7684\u914d\u6599\u5e76\u5c06\u5176\u6df7\u5408\u9002\u5f53\u7684\u65f6\u95f4\u3002\u6bcf\u79cd\u6df7\u5408\u7269\u90fd\u6709\u4e00\u4e2a\u7279\u5b9a\u7684\u8ba1\u65f6\u5668\uff0c\u8fbe\u5230\u201c\u5b8c\u7f8e\u6df7\u5408\u201d\u81f3\u5173\u91cd\u8981\uff0c\u8fd9\u5bf9\u4ea7\u54c1\u8d28\u91cf\u81f3\u5173\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u6df7\u5408\u201c\u9999\u8549\u51bb\u201d\u9700\u8981\u9999\u8549\u7cd6\u6d46\u548c\u51b0\uff0c\u5e76\u4e14\u8ba1\u65f6\u5668\u5fc5\u987b\u5728\u201c\u5b8c\u7f8e\u6df7\u5408\u201d\u533a\u57df\u7cbe\u786e\u505c\u6b62\u3002\u4e3a\u4e86\u4f18\u5316\uff0c\u8bf7\u59cb\u7ec8\u6ce8\u610f\u8ba1\u65f6\u5668\u5e76\u7ec3\u4e60\u8ba1\u65f6\u6df7\u5408\u3002\u8fd9\u786e\u4fdd\u4e86\u9ad8\u8d28\u91cf\u7684\u51bb\u54c1\u548c\u6ee1\u610f\u7684\u987e\u5ba2\u3002"}, {"question": "Papa's Freezeria \u4e2d\u7684\u914d\u6599\u7cfb\u7edf\u5982\u4f55\u8fd0\u4f5c\uff0c\u4ee5\u53ca\u6dfb\u52a0\u914d\u6599\u7684\u6700\u4f73\u5b9e\u8df5\u662f\u4ec0\u4e48\uff1f", "answer": "Papa's Freezeria \u7684\u914d\u6599\u7cfb\u7edf\u5141\u8bb8\u73a9\u5bb6\u6839\u636e\u5ba2\u6237\u504f\u597d\u5411\u51bb\u54c1\u4e2d\u6dfb\u52a0\u5404\u79cd\u914d\u6599\u3002\u6bcf\u79cd\u914d\u6599\u90fd\u6709\u7279\u5b9a\u7684\u4f4d\u7f6e\u548c\u6570\u91cf\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5ba2\u6237\u70b9\u4e86\u4e00\u4efd\u52a0\u5976\u6cb9\u548c\u7cd6\u971c\u7684\u201c\u8584\u8377\u51bb\u201d\uff0c\u60a8\u5fc5\u987b\u5148\u6dfb\u52a0\u5976\u6cb9\uff0c\u7136\u540e\u662f\u7cd6\u971c\u3002\u6700\u4f73\u5b9e\u8df5\u5305\u62ec\uff1a\u6b65\u9aa4\u4e00\uff1a\u59cb\u7ec8\u68c0\u67e5\u8ba2\u5355\u4e2d\u7684\u7279\u5b9a\u914d\u6599\u8bf4\u660e\u3002\u6b65\u9aa4\u4e8c\uff1a\u6309\u6b63\u786e\u7684\u987a\u5e8f\u548c\u6570\u91cf\u6dfb\u52a0\u914d\u6599\u3002\u6b65\u9aa4\u4e09\uff1a\u786e\u4fdd\u914d\u6599\u5747\u5300\u5206\u5e03\uff0c\u4f7f\u51bb\u54c1\u770b\u8d77\u6765\u66f4\u5177\u5438\u5f15\u529b\u3002\u9075\u5faa\u8fd9\u4e9b\u505a\u6cd5\u53ef\u4ee5\u63d0\u9ad8\u987e\u5ba2\u6ee1\u610f\u5ea6\u3002"}, {"question": "Papa's Freezeria \u4e2d\u7684\u5206\u6570\u7cfb\u7edf\u53d6\u51b3\u4e8e\u54ea\u4e9b\u56e0\u7d20\uff0c\u73a9\u5bb6\u5982\u4f55\u63d0\u9ad8\u5206\u6570\uff1f", "answer": "Papa's Freezeria \u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u51e0\u4e2a\u56e0\u7d20\uff1a\u8ba2\u5355\u51c6\u786e\u6027\u3001\u6df7\u5408\u8d28\u91cf\u3001\u914d\u6599\u653e\u7f6e\u548c\u670d\u52a1\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u4e00\u4efd\u201c\u84dd\u8393\u51bb\u201d\u7684\u201c\u5b8c\u7f8e\u6df7\u5408\u201d\uff0c\u914d\u6599\u51c6\u786e\uff0c\u670d\u52a1\u8fc5\u901f\u5c06\u83b7\u5f97\u9ad8\u5206\u3002\u4e3a\u4e86\u63d0\u9ad8\u5206\u6570\uff0c\u8bf7\u96c6\u4e2d\u7cbe\u529b\u4e8e\uff1a\u6b65\u9aa4\u4e00\uff1a\u901a\u8fc7\u5728\u6b63\u786e\u7684\u65f6\u95f4\u505c\u6b62\u8ba1\u65f6\u5668\u6765\u5b8c\u5584\u4f60\u7684\u6df7\u5408\u3002\u6b65\u9aa4\u4e8c\uff1a\u51c6\u786e\u65e0\u8bef\u5730\u6309\u7167\u6b63\u786e\u7684\u987a\u5e8f\u6dfb\u52a0\u914d\u6599\u3002\u6b65\u9aa4\u4e09\uff1a\u5c3d\u53ef\u80fd\u5feb\u901f\u5730\u670d\u52a1\u8ba2\u5355\u3002\u901a\u8fc7\u638c\u63e1\u8fd9\u4e9b\u8981\u7d20\uff0c\u4f60\u53ef\u4ee5\u83b7\u5f97\u66f4\u9ad8\u7684\u5206\u6570\u548c\u66f4\u597d\u7684\u8868\u73b0\u3002"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u8fd0\u884c Papa's Freezeria \u9700\u8981\u54ea\u4e9b\u6280\u672f\u8981\u6c42\uff0c\u4ee5\u53ca\u6027\u80fd\u5982\u4f55\u53d8\u5316\uff1f", "answer": "Papa's Freezeria \u53ef\u5728\u591a\u4e2a\u5e73\u53f0\u4e0a\u8fd0\u884c\uff0c\u5305\u62ec PC\u3001\u79fb\u52a8\u8bbe\u5907\u548c\u5e73\u677f\u7535\u8111\u3002\u6280\u672f\u8981\u6c42\u7565\u6709\u4e0d\u540c\uff1aPC \u901a\u5e38\u9700\u8981\u57fa\u672c\u7684\u7f51\u9875\u6d4f\u89c8\u5668\u548c\u4e92\u8054\u7f51\u8fde\u63a5\uff0c\u800c\u79fb\u52a8\u8bbe\u5907\u5219\u9700\u8981\u6700\u65b0\u7684\u64cd\u4f5c\u7cfb\u7edf\u7248\u672c\u548c\u8db3\u591f\u7684\u5b58\u50a8\u7a7a\u95f4\u3002\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u7684\u6027\u80fd\u901a\u5e38\u5f88\u6d41\u7545\uff0c\u4f46\u7531\u4e8e\u5c4f\u5e55\u66f4\u5927\u3001\u5904\u7406\u80fd\u529b\u66f4\u597d\uff0cPC \u53ef\u80fd\u63d0\u4f9b\u66f4\u7a33\u5b9a\u7684\u4f53\u9a8c\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u9ad8\u5206\u8fa8\u7387\u663e\u793a\u5668\u7684 PC \u53ef\u4ee5\u589e\u5f3a\u89c6\u89c9\u4f53\u9a8c\uff0c\u76f8\u6bd4\u4e8e\u8f83\u5c0f\u7684\u79fb\u52a8\u5c4f\u5e55\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5c06 Papa's Freezeria \u7684\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u8bbe\u5907\u8fc1\u79fb\u5230\u53e6\u4e00\u4e2a\u8bbe\u5907\uff1f", "answer": "\u5728\u4e0d\u540c\u7684\u8bbe\u5907\u4e4b\u95f4\u8fc1\u79fb Papa's Freezeria \u7684\u8fdb\u5ea6\u53ef\u4ee5\u901a\u8fc7\u5c06\u6e38\u620f\u6570\u636e\u4fdd\u5b58\u5230\u4e91\u7aef\u5b9e\u73b0\u3002\u6b65\u9aa4\u4e00\uff1a\u5728\u5f53\u524d\u8bbe\u5907\u4e0a\uff0c\u8bbf\u95ee\u6e38\u620f\u7684\u8bbe\u7f6e\uff0c\u5e76\u9009\u62e9\u201c\u4fdd\u5b58\u5230\u4e91\u7aef\u201d\u9009\u9879\u3002\u6b65\u9aa4\u4e8c\uff1a\u5728\u60a8\u7684\u65b0\u8bbe\u5907\u4e0a\u4f7f\u7528\u76f8\u540c\u7684\u5e10\u6237\u767b\u5f55\u3002\u6b65\u9aa4\u4e09\uff1a\u4ece\u4e91\u7aef\u52a0\u8f7d\u60a8\u7684\u4fdd\u5b58\u6570\u636e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\u73a9\u6e38\u620f\uff0c\u5e76\u4e14\u60f3\u5207\u6362\u5230 PC\uff0c\u8bf7\u6309\u7167\u8fd9\u4e9b\u6b65\u9aa4\u64cd\u4f5c\uff0c\u4ee5\u786e\u4fdd\u60a8\u7684\u8fdb\u5ea6\u987a\u5229\u5730\u8f6c\u79fb\u3002\u8fd9\u79cd\u65b9\u6cd5\u5141\u8bb8\u60a8\u5728\u4e0d\u4e22\u5931\u4efb\u4f55\u6e38\u620f\u6570\u636e\u7684\u60c5\u51b5\u4e0b\u987a\u5229\u8fc7\u6e21\u3002"}, {"question": "\u73a9\u5bb6\u5728 Papa's Freezeria \u4e2d\u53ef\u4ee5\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u7684\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "Papa's Freezeria \u5305\u542b\u4e00\u4e9b\u9690\u85cf\u7684\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u8fd9\u4e9b\u529f\u80fd\u548c\u5f69\u86cb\u589e\u52a0\u4e86\u6e38\u620f\u7684\u4e50\u8da3\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u53cd\u590d\u70b9\u51fb\u6e38\u620f\u4e2d\u7684\u201cPapa Louie\u201d\u89d2\u8272\uff0c\u4ed6\u53ef\u80fd\u4f1a\u6267\u884c\u7279\u6b8a\u52a8\u753b\u6216\u53d1\u8868\u72ec\u7279\u7684\u8bc4\u8bba\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u98df\u6750\u6216\u914d\u6599\u7684\u7ec4\u5408\u53ef\u80fd\u4f1a\u5f15\u8d77\u987e\u5ba2\u7684\u7279\u522b\u53cd\u5e94\u3002\u63a2\u7d22\u8fd9\u4e9b\u9690\u85cf\u5143\u7d20\u53ef\u4ee5\u589e\u5f3a\u60a8\u7684\u6e38\u620f\u4f53\u9a8c\u5e76\u63d0\u4f9b\u989d\u5916\u7684\u5a31\u4e50\u3002\u5728\u6e38\u620f\u4e2d\uff0c\u8bf7\u7559\u610f\u8fd9\u4e9b\u7ec6\u5fae\u7684\u7ec6\u8282\u3002"}, {"question": "Papa's Freezeria \u4e2d\u7684\u96be\u5ea6\u63d0\u5347\u5982\u4f55\u5f71\u54cd\u6e38\u620f\uff0c\u73a9\u5bb6\u5728\u63d0\u5347\u8fc7\u7a0b\u4e2d\u5e94\u8be5\u671f\u5f85\u4ec0\u4e48\uff1f", "answer": "\u968f\u7740\u73a9\u5bb6\u89e3\u9501\u65b0\u7684\u7b49\u7ea7\u548c\u529f\u80fd\uff0cPapa's Freezeria \u7684\u96be\u5ea6\u4f1a\u9010\u6e10\u63d0\u5347\u3002\u6700\u521d\uff0c\u6e38\u620f\u4f1a\u4ecb\u7ecd\u57fa\u672c\u7684\u8ba2\u5355\u548c\u7b80\u5355\u7684\u6df7\u5408\u3002\u968f\u7740\u60a8\u7684\u63d0\u5347\uff0c\u8ba2\u5355\u4f1a\u53d8\u5f97\u66f4\u590d\u6742\uff0c\u9700\u8981\u591a\u79cd\u914d\u6599\u548c\u7cbe\u786e\u7684\u8ba1\u65f6\u3002\u4f8b\u5982\uff0c\u65e9\u671f\u5173\u5361\u53ef\u80fd\u6d89\u53ca\u201c\u5355\u53e3\u5473\u51bb\u54c1\u201d\uff0c\u800c\u540e\u671f\u5173\u5361\u5219\u4f1a\u5f15\u5165\u201c\u591a\u53e3\u5473\u51bb\u54c1\u201d\uff0c\u642d\u914d\u590d\u6742\u7684\u914d\u6599\u7ec4\u5408\u3002\u73a9\u5bb6\u5e94\u8be5\u671f\u5f85\u53d1\u5c55\u4ed6\u4eec\u5728\u6df7\u5408\u3001\u914d\u6599\u6446\u653e\u548c\u8ba2\u5355\u7ba1\u7406\u65b9\u9762\u7684\u6280\u80fd\uff0c\u4ee5\u8ddf\u4e0a\u4e0d\u65ad\u589e\u52a0\u7684\u96be\u5ea6\uff0c\u5e76\u4fdd\u6301\u9ad8\u987e\u5ba2\u6ee1\u610f\u5ea6\u3002"}]
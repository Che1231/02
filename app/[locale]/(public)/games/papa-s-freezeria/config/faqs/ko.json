[{"question": "\ud30c\ud30c\uc2a4 \ud504\ub9ac\uc81c\ub9ac\uc544\ub97c \ucc98\uc74c \uc2dc\uc791\ud558\ub294 \ucd08\ubcf4\uc790\ub294 \uc5b4\ub5bb\uac8c \uac8c\uc784\uc744 \uc2dc\uc791\ud558\uace0 \uae30\ubcf8 \uae30\uc220\uc744 \ub9c8\uc2a4\ud130\ud558\uae30 \uc704\ud55c \uccab \ub2e8\uacc4\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud504\ub9ac\uc81c\ub9ac\uc544\ub97c \uc2dc\uc791\ud558\ub824\uba74 \uba3c\uc800 \uac8c\uc784 \uc778\ud130\ud398\uc774\uc2a4\ub97c \uc775\uc219\ud574\uc9c0\uc138\uc694. \uba54\uc778 \ud654\uba74\uc5d0\ub294 \uc8fc\ubb38 \uc2a4\ud14c\uc774\uc158, \ube14\ub80c\ub529 \uc2a4\ud14c\uc774\uc158, \ud1a0\ud551 \uc2a4\ud14c\uc774\uc158\uc774 \ud45c\uc2dc\ub429\ub2c8\ub2e4. \uccab \ubc88\uc9f8 \ub2e8\uacc4\ub294 \uace0\uac1d\uc73c\ub85c\ubd80\ud130 \uc8fc\ubb38\uc744 \ubc1b\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uace0\uac1d\uc774 '\ub538\uae30 \ub0c9\ub3d9 \ub514\uc800\ud2b8'\ub97c \uc8fc\ubb38\ud558\uba74 \ub9db\uacfc \ud06c\uae30\ub97c \uae30\ub85d\ud558\uc138\uc694. \ub2e4\uc74c\uc73c\ub85c \ube14\ub80c\ub529 \uc2a4\ud14c\uc774\uc158\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec \uc62c\ubc14\ub978 \uc7ac\ub8cc(\uc774 \uacbd\uc6b0 \ub538\uae30 \uc2dc\ub7fd\uacfc \uc5bc\uc74c)\ub97c \uc120\ud0dd\ud558\uace0 \ud0c0\uc774\uba38\uc5d0 \ub530\ub77c \ud63c\ud569\ud558\uc138\uc694. \ub9c8\uc9c0\ub9c9\uc73c\ub85c \uc694\uccad\ub41c \ud1a0\ud551\uc744 \ucd94\uac00\ud558\uace0 \ub0c9\ub3d9 \ub514\uc800\ud2b8\ub97c \uc81c\uacf5\ud558\uc138\uc694. \uc774\ub7ec\ud55c \uae30\ubcf8 \uae30\uc220\uc744 \ub9c8\uc2a4\ud130\ud558\uba74 \uac8c\uc784 \uc9c4\ud589\uc774 \uc6d0\ud65c\ud574\uc9d1\ub2c8\ub2e4."}, {"question": "100\uc2dc\uac04 \uc774\uc0c1 \ud30c\ud30c\uc2a4 \ud504\ub9ac\uc81c\ub9ac\uc544\ub97c \ud50c\ub808\uc774\ud55c \ud6c4 \ud301\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud55c \uc8fc\uc694 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "100\uc2dc\uac04 \uc774\uc0c1 \ud30c\ud30c\uc2a4 \ud504\ub9ac\uc81c\ub9ac\uc544\ub97c \ud50c\ub808\uc774\ud55c \ud6c4 \ud301\uc744 \uadf9\ub300\ud654\ud558\ub294 \uac83\uc740 \uc815\ud655\uc131\uacfc \ud6a8\uc728\uc131\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. STEP1: \ud56d\uc0c1 \ud0c0\uc774\uba38\ub97c \uc815\ud655\ud788 \ub530\ub77c \uc644\ubcbd\ud55c \ud63c\ud569\uc744 \ubaa9\ud45c\ub85c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ucd08\ucf5c\ub9bf \ub0c9\ub3d9 \ub514\uc800\ud2b8'\uc758 '\uc644\ubcbd\ud55c \ud63c\ud569'\uc740 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP2: \uace0\uac1d\uc758 \uc120\ud638\ub3c4\ub97c \uae30\uc5b5\ud558\uc5ec \uc8fc\ubb38\uc744 \ub9de\ucda4\ud654\ud558\uc138\uc694. \uace0\uac1d\uc774 \ucd94\uac00 \ud718\ud551 \ud06c\ub9bc\uc744 \uc88b\uc544\ud55c\ub2e4\uba74 \ud56d\uc0c1 \ucd94\uac00\ud574\uc8fc\uc138\uc694. STEP3: \uace0\uac1d\uc758 \ubd88\ub9cc\uc744 \uc904\uc774\uae30 \uc704\ud574 \uc2e0\uc18d\ud558\uac8c \uc8fc\ubb38\uc744 \uc81c\uacf5\ud558\uc138\uc694. \uc774\ub7ec\ud55c \uc804\ub7b5\uc744 \uacb0\ud569\ud558\uba74 \ud301\uc744 \ud06c\uac8c \ub298\ub9ac\uace0 \uc804\uccb4 \uc131\ub2a5\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c\uc2a4 \ud504\ub9ac\uc81c\ub9ac\uc544\uc5d0\uc11c \uc8fc\ubb38 \uc2dc\uac04\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70 \uace0\uac1d \ub9cc\uc871\ub3c4\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud504\ub9ac\uc81c\ub9ac\uc544\uc5d0\uc11c \uc8fc\ubb38 \uc2dc\uac04\uc740 \uace0\uac1d \ub9cc\uc871\ub3c4\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \uac01 \uace0\uac1d\uc740 \uc2dc\uac04\uc774 \uc9c0\ub0a8\uc5d0 \ub530\ub77c \uc778\ub0b4\ub3c4 \uac8c\uc774\uc9c0\uac00 \uc904\uc5b4\ub4ed\ub2c8\ub2e4. \uc8fc\ubb38\uc744 \uc644\ub8cc\ud558\ub294 \ub370 \ub108\ubb34 \uc624\ub79c \uc2dc\uac04\uc774 \uac78\ub9ac\uba74 \uace0\uac1d\uc774 \ub5a0\ub0a0 \uc218 \uc788\uc73c\uba70 \uc774\ub294 \uc218\uc785 \uc190\uc2e4\ub85c \uc774\uc5b4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ubc14\ub2d0\ub77c \ub0c9\ub3d9 \ub514\uc800\ud2b8' \uc900\ube44\uc5d0 \ub108\ubb34 \uc624\ub79c \uc2dc\uac04\uc774 \uac78\ub9ac\uba74 \uace0\uac1d\uc774 \ubd88\uc548\ud574\uc838\uc11c \ub5a0\ub0a0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub97c \ubc29\uc9c0\ud558\ub824\uba74 \uc8fc\ubb38 \ubc1b\uae30, \uc900\ube44\ud558\uae30, \uc81c\uacf5\ud558\ub294 \ub370 \ud56d\uc0c1 \uc18d\ub3c4\uc640 \uc815\ud655\uc131\uc744 \uc6b0\uc120\uc2dc\ud558\uc138\uc694. \ud6a8\uc728\uc801\uc778 \uc2dc\uac04 \uad00\ub9ac\ub97c \ud1b5\ud574 \uace0\uac1d \ub9cc\uc871\ub3c4\ub97c \ub192\uc774\uace0 \ub354 \ub9ce\uc740 \ud301\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c\uc2a4 \ud504\ub9ac\uc81c\ub9ac\uc544\uc758 \ube14\ub80c\ub529 \uacfc\uc815\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud504\ub9ac\uc81c\ub9ac\uc544\uc758 \ube14\ub80c\ub529 \uacfc\uc815\uc740 \uc62c\ubc14\ub978 \uc7ac\ub8cc\ub97c \uc120\ud0dd\ud558\uace0 \uc801\uc808\ud55c \uc2dc\uac04 \ub3d9\uc548 \ud63c\ud569\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uac01 \ud63c\ud569\uc5d0\ub294 \ud2b9\uc815 \ud0c0\uc774\uba38\uac00 \uc788\uc73c\uba70 '\uc644\ubcbd\ud55c \ud63c\ud569' \ud45c\uc2dc\ub97c \ub9de\ucd94\ub294 \uac83\uc774 \ud488\uc9c8\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ubc14\ub098\ub098 \ub0c9\ub3d9 \ub514\uc800\ud2b8'\ub97c \ud63c\ud569\ud558\ub824\uba74 \ubc14\ub098\ub098 \uc2dc\ub7fd\uacfc \uc5bc\uc74c\uc774 \ud544\uc694\ud558\uba70 \ud0c0\uc774\uba38\ub97c '\uc644\ubcbd\ud55c \ud63c\ud569' \uad6c\uc5ed\uc5d0\uc11c \uc815\ud655\ud788 \uba48\ucdb0\uc57c \ud569\ub2c8\ub2e4. \ucd5c\uc801\ud654\ud558\ub824\uba74 \ud56d\uc0c1 \ud0c0\uc774\uba38\uc5d0 \uc720\uc758\ud558\uace0 \ud63c\ud569 \ud0c0\uc774\ubc0d \uc5f0\uc2b5\uc744 \ud558\uc138\uc694. \uc774\ub807\uac8c \ud558\uba74 \ub192\uc740 \ud488\uc9c8\uc758 \ub0c9\ub3d9 \ub514\uc800\ud2b8\uc640 \uace0\uac1d \ub9cc\uc871\ub3c4\ub97c \ud655\ubcf4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c\uc2a4 \ud504\ub9ac\uc81c\ub9ac\uc544\uc758 \ud1a0\ud551 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \ud1a0\ud551\uc744 \ucd94\uac00\ud558\ub294 \ucd5c\uc120\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud504\ub9ac\uc81c\ub9ac\uc544\uc758 \ud1a0\ud551 \uc2dc\uc2a4\ud15c\uc744 \ud1b5\ud574 \ud50c\ub808\uc774\uc5b4\ub294 \uace0\uac1d\uc758 \uc120\ud638\ub3c4\uc5d0 \ub530\ub77c \ub2e4\uc591\ud55c \ud1a0\ud551\uc744 \ub0c9\ub3d9 \ub514\uc800\ud2b8\uc5d0 \ucd94\uac00\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac01 \ud1a0\ud551\uc5d0\ub294 \ud2b9\uc815 \uc704\uce58\uc640 \uc591\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uace0\uac1d\uc774 '\ubbfc\ud2b8 \ub0c9\ub3d9 \ub514\uc800\ud2b8'\uc5d0 \ud718\ud551 \ud06c\ub9bc\uacfc  sprinkles\uc744 \uc694\uccad\ud558\uba74 \uba3c\uc800 \ud718\ud551 \ud06c\ub9bc\uc744, \uadf8 \ub2e4\uc74c sprinkles\uc744 \ucd94\uac00\ud574\uc57c \ud569\ub2c8\ub2e4. \ucd5c\uc120\uc758 \ubc29\ubc95\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: STEP1: \ud56d\uc0c1 \uc8fc\ubb38\uc5d0 \ud2b9\uc815 \ud1a0\ud551 \uc9c0\uc2dc\uac00 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. STEP2: \uc62c\ubc14\ub978 \uc21c\uc11c\uc640 \uc591\uc73c\ub85c \ud1a0\ud551\uc744 \ucd94\uac00\ud558\uc138\uc694. STEP3: \ud1a0\ud551\uc774 \uace0\ub974\uac8c \ubd84\ubc30\ub418\uc5b4 \uc2dc\uac01\uc801\uc73c\ub85c \ub9e4\ub825\uc801\uc778 \ub0c9\ub3d9 \ub514\uc800\ud2b8\ub97c \ub9cc\ub4e4\ub3c4\ub85d \ud558\uc138\uc694. \uc774\ub7ec\ud55c \ubc29\ubc95\uc744 \ub530\ub974\uba74 \uace0\uac1d \ub9cc\uc871\ub3c4\ub97c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c\uc2a4 \ud504\ub9ac\uc81c\ub9ac\uc544\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc694\uc18c\ub294 \ubb34\uc5c7\uc774\uba70 \ud50c\ub808\uc774\uc5b4\ub294 \uc810\uc218\ub97c \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud504\ub9ac\uc81c\ub9ac\uc544\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc8fc\ubb38 \uc815\ud655\uc131, \ud63c\ud569 \ud488\uc9c8, \ud1a0\ud551 \ubc30\uce58 \ubc0f \uc81c\uacf5 \uc18d\ub3c4 \ub4f1 \uc5ec\ub7ec \uc694\uc18c\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ube14\ub8e8\ubca0\ub9ac \ub0c9\ub3d9 \ub514\uc800\ud2b8'\uc758 '\uc644\ubcbd\ud55c \ud63c\ud569'\uc5d0 \uc815\ud655\ud55c \ud1a0\ud551\uacfc \ube60\ub978 \uc81c\uacf5\uc774 \ub354\ud574\uc9c0\uba74 \ub192\uc740 \uc810\uc218\uac00 \uc8fc\uc5b4\uc9d1\ub2c8\ub2e4. \uc810\uc218\ub97c \ub192\uc774\ub824\uba74 \ub2e4\uc74c\uc5d0 \uc9d1\uc911\ud558\uc138\uc694: STEP1: \ud0c0\uc774\uba38\ub97c \uc815\ud655\ud55c \uc21c\uac04\uc5d0 \uba48\ucd94\uba74\uc11c \ud63c\ud569\uc5d0 \uc644\ubcbd\ub3c4\ub97c \ub192\uc774\uc138\uc694. STEP2: \ud1a0\ud551\uc744 \uc815\ud655\ud558\uace0 \uc62c\ubc14\ub978 \uc21c\uc11c\ub300\ub85c \ucd94\uac00\ud558\uc138\uc694. STEP3: \uac00\ub2a5\ud55c \ud55c \ube68\ub9ac \uc8fc\ubb38\uc744 \uc81c\uacf5\ud558\uc138\uc694. \uc774\ub7ec\ud55c \uc694\uc18c\ub97c \ub9c8\uc2a4\ud130\ud558\uba74 \ub354 \ub192\uc740 \uc810\uc218\uc640 \ub354 \ub098\uc740 \uc131\ub2a5\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ud30c\ud30c\uc2a4 \ud504\ub9ac\uc81c\ub9ac\uc544\ub97c \uc2e4\ud589\ud558\ub294 \ub370 \ud544\uc694\ud55c \uae30\uc220\uc801 \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc774\uba70 \uc131\ub2a5\uc740 \uc5b4\ub5bb\uac8c \ub2ec\ub77c\uc9d1\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud504\ub9ac\uc81c\ub9ac\uc544\ub294 PC, \ubaa8\ubc14\uc77c \ubc0f \ud0dc\ube14\ub9bf\uc744 \ud3ec\ud568\ud55c \uc5ec\ub7ec \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc774\uc6a9 \uac00\ub2a5\ud569\ub2c8\ub2e4. \uae30\uc220\uc801 \uc694\uad6c \uc0ac\ud56d\uc740 \uc57d\uac04 \ub2e4\ub985\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc73c\ub85c PC\uc5d0\ub294 \uae30\ubcf8 \uc6f9 \ube0c\ub77c\uc6b0\uc800\uc640 \uc778\ud130\ub137 \uc5f0\uacb0\uc774 \ud544\uc694\ud558\uba70, \ubaa8\ubc14\uc77c \uae30\uae30\ub294 \ucd5c\uc2e0 OS \ubc84\uc804\uacfc \ucda9\ubd84\ud55c \uc800\uc7a5 \uacf5\uac04\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ud50c\ub7ab\ud3fc \uac04 \uc131\ub2a5\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \uc6d0\ud65c\ud558\uc9c0\ub9cc, PC\ub294 \ub354 \ud070 \ud654\uba74\uacfc \ub354 \ub098\uc740 \ucc98\ub9ac \uc131\ub2a5\uc73c\ub85c \uc778\ud574 \ub354 \uc548\uc815\uc801\uc778 \ud658\uacbd\uc744 \uc81c\uacf5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uace0\ud574\uc0c1\ub3c4 \ubaa8\ub2c8\ud130\uac00 \uc788\ub294 PC\uc5d0\uc11c \ud50c\ub808\uc774\ud558\uba74 \uc791\uc740 \ubaa8\ubc14\uc77c \ud654\uba74\ubcf4\ub2e4 \uc2dc\uac01\uc801 \uacbd\ud5d8\uc774 \ud5a5\uc0c1\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \ud55c \uae30\uae30\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30\ub85c \ud30c\ud30c\uc2a4 \ud504\ub9ac\uc81c\ub9ac\uc544\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud55c \uae30\uae30\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30\ub85c \ud30c\ud30c\uc2a4 \ud504\ub9ac\uc81c\ub9ac\uc544\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\ub824\uba74 \uac8c\uc784 \ub370\uc774\ud130\ub97c \ud074\ub77c\uc6b0\ub4dc\uc5d0 \uc800\uc7a5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \ud604\uc7ac \uae30\uae30\uc5d0\uc11c \uac8c\uc784 \uc124\uc815\uc5d0 \uc811\uc18d\ud558\uc5ec '\ud074\ub77c\uc6b0\ub4dc\uc5d0 \uc800\uc7a5' \uc635\uc158\uc744 \uc120\ud0dd\ud558\uc138\uc694. STEP2: \uc0c8 \uae30\uae30\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uc138\uc694. STEP3: \ud074\ub77c\uc6b0\ub4dc\uc5d0\uc11c \uc800\uc7a5\ub41c \ub370\uc774\ud130\ub97c \ub85c\ub4dc\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ubaa8\ubc14\uc77c \uae30\uae30\uc5d0\uc11c \ud50c\ub808\uc774\ud558\uc5ec PC\ub85c \uc804\ud658\ud558\ub824\uba74 \uc774 \ub2e8\uacc4\ub97c \ub530\ub974\uba74 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc6d0\ud65c\ud558\uac8c \uc804\uc1a1\ub429\ub2c8\ub2e4. \uc774 \ubc29\ubc95\uc744 \ud1b5\ud574 \uac8c\uc784 \ub370\uc774\ud130 \uc190\uc2e4 \uc5c6\uc774 \uc6d0\ud65c\ud558\uac8c \uc804\ud658\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c\uc2a4 \ud504\ub9ac\uc81c\ub9ac\uc544\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud504\ub9ac\uc81c\ub9ac\uc544\uc5d0\ub294 \uc7ac\ubbf8\ub97c \ub354\ud574\uc8fc\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uae30\ub2a5\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac8c\uc784 \ub0b4 '\ud30c\ud30c \ub8e8\uc774' \uce90\ub9ad\ud130\ub97c \ubc18\ubcf5\ud574\uc11c \ud074\ub9ad\ud558\uba74 \ud2b9\ubcc4\ud55c \uc560\ub2c8\uba54\uc774\uc158\uc744 \uc218\ud589\ud558\uac70\ub098 \ub3c5\ud2b9\ud55c \ucf54\uba58\ud2b8\ub97c \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \ud2b9\uc815 \uc7ac\ub8cc \ub610\ub294 \ud1a0\ud551 \uc870\ud569\uc73c\ub85c \uc778\ud574 \uace0\uac1d\uc73c\ub85c\ubd80\ud130 \ud2b9\ubcc4\ud55c \ubc18\uc751\uc774 \ub098\ud0c0\ub0a0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uc694\uc18c\ub97c \ud0d0\uc0c9\ud558\uba74 \uac8c\uc784 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uace0 \ucd94\uac00\uc801\uc778 \uc5d4\ud130\ud14c\uc778\uba3c\ud2b8\ub97c \uc81c\uacf5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud50c\ub808\uc774\ud558\uba74\uc11c \uc774\ub7ec\ud55c \ubbf8\ubb18\ud55c \uc138\ubd80 \uc0ac\ud56d\uc744 \uc8fc\uc758 \uae4a\uac8c \uc0b4\ud3b4\ubcf4\uc138\uc694."}, {"question": "\ud30c\ud30c\uc2a4 \ud504\ub9ac\uc81c\ub9ac\uc544\uc758 \ub09c\uc774\ub3c4 \uc99d\uac00\ub294 \uac8c\uc784\ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\uba70 \uc9c4\ud589\ud558\uba74\uc11c \ud50c\ub808\uc774\uc5b4\ub294 \ubb34\uc5c7\uc744 \uae30\ub300\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud504\ub9ac\uc81c\ub9ac\uc544\uc758 \ub09c\uc774\ub3c4\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uc0c8\ub85c\uc6b4 \ub808\ubca8\uacfc \uae30\ub2a5\uc744 \ud68d\ub4dd\ud568\uc5d0 \ub530\ub77c \uc99d\uac00\ud569\ub2c8\ub2e4. \ucc98\uc74c\uc5d0\ub294 \uac8c\uc784\uc740 \uae30\ubcf8 \uc8fc\ubb38\uacfc \uac04\ub2e8\ud55c \ud63c\ud569\uc744 \uc18c\uac1c\ud569\ub2c8\ub2e4. \uc9c4\ud589\ud568\uc5d0 \ub530\ub77c \uc8fc\ubb38\uc740 \ubcf5\uc7a1\ud574\uc838\uc11c \uc5ec\ub7ec \uc7ac\ub8cc\uc640 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uc774 \ud544\uc694\ud574\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucd08\uae30 \ub808\ubca8\uc740 '\ub2e8\uc77c \ub9db \ub0c9\ub3d9 \ub514\uc800\ud2b8'\ub97c \ud3ec\ud568\ud560 \uc218 \uc788\uc9c0\ub9cc, \ud6c4\ubc18 \ub808\ubca8\uc740 \ubcf5\uc7a1\ud55c \ud1a0\ud551 \uc870\ud569\uc744 \uac00\uc9c4 '\ub2e4\uc911 \ub9db \ub0c9\ub3d9 \ub514\uc800\ud2b8'\ub97c \uc18c\uac1c\ud569\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\ub294 \ud63c\ud569, \ud1a0\ud551 \ubc30\uce58 \ubc0f \uc8fc\ubb38 \uad00\ub9ac \uae30\uc220\uc744 \uac1c\ubc1c\ud558\uc5ec \uc99d\uac00\ud558\ub294 \ub09c\uc774\ub3c4\uc5d0 \ub300\ucc98\ud558\uace0 \ub192\uc740 \uace0\uac1d \ub9cc\uc871\ub3c4\ub97c \uc720\uc9c0\ud574\uc57c \ud569\ub2c8\ub2e4."}]
[{"question": "\u9280\u884c\u5f37\u76d7\u3067\u521d\u5fc3\u8005\u3068\u3057\u3066\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u3059\u3050\u306b\u7406\u89e3\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "\u9280\u884c\u5f37\u76d7\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u7d20\u65e9\u304f\u7406\u89e3\u3059\u308b\u306b\u306f\u3001\u79fb\u52d5\u30ad\u30fc\uff08WASD\uff09\u3068\u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3\u30ad\u30fc\uff08E\uff09\u306b\u6163\u308c\u308b\u3053\u3068\u304b\u3089\u59cb\u3081\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u91d1\u5eab\u3092\u958b\u3051\u308b\u306b\u306f\u3001\u91d1\u5eab\u306b\u8fd1\u3065\u3044\u3066E\u30ad\u30fc\u3092\u62bc\u3057\u307e\u3059\u3002\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30ec\u30d9\u30eb\u3067\u3053\u308c\u3089\u306e\u64cd\u4f5c\u3092\u7df4\u7fd2\u3059\u308b\u3068\u3001\u5b9f\u9a13\u3059\u308b\u305f\u3081\u306e\u5b89\u5168\u306a\u74b0\u5883\u304c\u63d0\u4f9b\u3055\u308c\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30b2\u30fc\u30e0\u5185\u306e\u64cd\u4f5c\u8a2d\u5b9a\u3092\u4f7f\u7528\u3057\u3066\u3001\u30ad\u30fc\u30d0\u30a4\u30f3\u30c9\u3092\u81ea\u5206\u306e\u597d\u307f\u306b\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3059\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u3002\u6700\u521d\u306e\u30d7\u30ec\u30a4\u4e2d\u306f\u3001\u64cd\u4f5c\u306e\u53c2\u8003\u30ab\u30fc\u30c9\u3092\u3059\u3050\u306b\u624b\u5143\u306b\u7f6e\u3044\u3066\u304a\u304f\u306e\u304c\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u9280\u884c\u5f37\u76d7\u3067\u5f37\u76d7\u3092\u6210\u529f\u3055\u305b\u308b\u305f\u3081\u306e\u91cd\u8981\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u9280\u884c\u5f37\u76d7\u3067\u5f37\u76d7\u3092\u6210\u529f\u3055\u305b\u308b\u306b\u306f\u3001\u7dbf\u5bc6\u306a\u8a08\u753b\u3068\u5b9f\u884c\u304c\u5fc5\u8981\u3067\u3059\u3002STEP1\uff1a\u9280\u884c\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u8abf\u3079\u3066\u3001\u76e3\u8996\u30ab\u30e1\u30e9\u3068\u8b66\u5099\u54e1\u306e\u30d1\u30c8\u30ed\u30fc\u30eb\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002STEP2\uff1a\u89e3\u9320\u30c4\u30fc\u30eb\u3084\u30b5\u30a4\u30ec\u30f3\u30b5\u30fc\u4ed8\u304d\u6b66\u5668\u306a\u3069\u306e\u9069\u5207\u306a\u30c4\u30fc\u30eb\u3092\u7528\u610f\u3057\u3066\u3001\u767a\u898b\u3092\u907f\u3051\u307e\u3057\u3087\u3046\u3002STEP3\uff1a\u30c1\u30fc\u30e0\u3068\u9023\u643a\u3057\u3066\u3001\u540c\u6642\u306b\u8b66\u5831\u3092\u89e3\u9664\u3057\u3001\u91d1\u5eab\u3092\u78ba\u4fdd\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30c0\u30a6\u30f3\u30bf\u30a6\u30f3\u9280\u884c\u300d\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u8b66\u5099\u54e1\u4ea4\u4ee3\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u306b\u5408\u308f\u305b\u3066\u884c\u52d5\u3092\u5408\u308f\u305b\u308b\u3068\u3001\u767a\u898b\u306e\u30ea\u30b9\u30af\u3092\u5927\u5e45\u306b\u6e1b\u3089\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u5e38\u306b\u8131\u51fa\u8a08\u753b\u3092\u7528\u610f\u3057\u3001\u30c1\u30fc\u30e0\u5168\u54e1\u304c\u305d\u308c\u3092\u8a8d\u8b58\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002"}, {"question": "\u9280\u884c\u5f37\u76d7\u3067\u30c1\u30fc\u30e0\u306e\u30b9\u30ad\u30eb\u3092\u7ba1\u7406\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u3069\u306e\u3088\u3046\u306b\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u9280\u884c\u5f37\u76d7\u3067\u30c1\u30fc\u30e0\u306e\u30b9\u30ad\u30eb\u3092\u7ba1\u7406\u3059\u308b\u3053\u3068\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u8ab2\u984c\u3092\u514b\u670d\u3059\u308b\u305f\u3081\u306b\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u5404\u30c1\u30fc\u30e0\u30e1\u30f3\u30d0\u30fc\u306b\u306f\u3001\u7279\u5b9a\u306e\u5f79\u5272\u306b\u6700\u9069\u5316\u3067\u304d\u308b\u56fa\u6709\u306e\u80fd\u529b\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30cf\u30c3\u30ab\u30fc\u306f\u30bb\u30ad\u30e5\u30ea\u30c6\u30a3\u30b7\u30b9\u30c6\u30e0\u3092\u3088\u308a\u65e9\u304f\u7121\u52b9\u5316\u3067\u304d\u3001\u89e3\u9320\u5c02\u9580\u5bb6\u306f\u91d1\u5eab\u3092\u3088\u308a\u52b9\u7387\u7684\u306b\u958b\u3051\u3089\u308c\u307e\u3059\u3002\u30b9\u30ad\u30eb\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u5404\u30e1\u30f3\u30d0\u30fc\u306e\u5f37\u307f\u306b\u57fa\u3065\u3044\u3066\u5f79\u5272\u3092\u5272\u308a\u5f53\u3066\u3001\u6210\u529f\u3057\u305f\u5f37\u76d7\u304b\u3089\u7372\u5f97\u3057\u305f\u30b9\u30ad\u30eb\u30dd\u30a4\u30f3\u30c8\u3092\u4f7f\u7528\u3057\u3066\u5f7c\u3089\u306e\u80fd\u529b\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u307e\u3059\u3002\u76f8\u88dc\u7684\u306a\u30b9\u30ad\u30eb\u3092\u6301\u3064\u30d0\u30e9\u30f3\u30b9\u306e\u53d6\u308c\u305f\u30c1\u30fc\u30e0\u306f\u3001\u5f37\u76d7\u3092\u6210\u529f\u3055\u305b\u308b\u53ef\u80fd\u6027\u3092\u9ad8\u3081\u307e\u3059\u3002"}, {"question": "\u9280\u884c\u5f37\u76d7\u3067\u306e\u30b9\u30c6\u30eb\u30b9\u30e1\u30ab\u30cb\u30ba\u30e0\u306e\u4ed5\u7d44\u307f\u3068\u3001\u767a\u898b\u3055\u308c\u306a\u3044\u305f\u3081\u306e\u30d9\u30b9\u30c8\u30d7\u30e9\u30af\u30c6\u30a3\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u9280\u884c\u5f37\u76d7\u3067\u306e\u30b9\u30c6\u30eb\u30b9\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u8b66\u5099\u54e1\u3068\u306e\u8996\u7dda\u63a5\u89e6\u3092\u907f\u3051\u3001\u9a12\u97f3\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u308b\u3053\u3068\u306b\u4f9d\u5b58\u3057\u307e\u3059\u3002\u767a\u898b\u3055\u308c\u306a\u3044\u305f\u3081\u306b\u3001\u5f71\u306b\u96a0\u308c\u3001\u5fc5\u8981\u306b\u5fdc\u3058\u3066\u30b5\u30a4\u30ec\u30f3\u30b5\u30fc\u4ed8\u304d\u6b66\u5668\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u90ca\u5916\u9280\u884c\u300d\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u91cd\u88c5\u5099\u306e\u30a8\u30ea\u30a2\u3092\u8fc2\u56de\u3059\u308b\u305f\u3081\u306b\u63db\u6c17\u30b7\u30b9\u30c6\u30e0\u3092\u4f7f\u7528\u3059\u308b\u3068\u975e\u5e38\u306b\u52b9\u679c\u7684\u3067\u3059\u3002\u3055\u3089\u306b\u3001\u5e38\u306b\u5468\u56f2\u306b\u6ce8\u610f\u3092\u6255\u3044\u3001\u8b66\u5099\u54e1\u306e\u6ce8\u610f\u3092\u305d\u3089\u3059\u305f\u3081\u306b\u3001\u7269\u4f53\u3092\u6295\u3052\u305f\u308a\u306a\u3069\u306e\u3044\u305f\u305a\u3089\u3092\u4f7f\u3046\u3053\u3068\u3082\u91cd\u8981\u3067\u3059\u3002\u30ea\u30b9\u30af\u306e\u4f4e\u3044\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u3053\u308c\u3089\u306e\u30c6\u30af\u30cb\u30c3\u30af\u3092\u7df4\u7fd2\u3057\u3001\u81ea\u4fe1\u3092\u69cb\u7bc9\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30bd\u30ed\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306e\u9280\u884c\u5f37\u76d7\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u306b\u5fdc\u3058\u3066\u79c1\u306e\u6226\u7565\u3092\u3069\u306e\u3088\u3046\u306b\u8abf\u6574\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30bd\u30ed\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306e\u9280\u884c\u5f37\u76d7\u306e\u4e3b\u306a\u9055\u3044\u306f\u3001\u9023\u643a\u306e\u30ec\u30d9\u30eb\u3068\u30bf\u30b9\u30af\u306e\u8907\u96d1\u3055\u3067\u3059\u3002\u30bd\u30ed\u30e2\u30fc\u30c9\u3067\u306f\u3001\u4e00\u4eba\u3067\u3059\u3079\u3066\u306e\u5f79\u5272\u3092\u62c5\u308f\u306a\u3051\u308c\u3070\u306a\u3089\u306a\u3044\u305f\u3081\u3001\u3088\u308a\u614e\u91cd\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u304c\u5fc5\u8981\u306b\u306a\u308a\u307e\u3059\u3002\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u306f\u3001\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u304c\u4e0d\u53ef\u6b20\u3067\u3042\u308a\u3001\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u304c\u91cd\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u5e02\u8857\u4e2d\u5fc3\u9280\u884c\u300d\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u540c\u6642\u306b\u8b66\u5831\u3092\u89e3\u9664\u3057\u3001\u91d1\u5eab\u3092\u5b89\u5168\u306b\u78ba\u4fdd\u3059\u308b\u305f\u3081\u306b\u3001\u30c1\u30fc\u30e0\u30e1\u30a4\u30c8\u3068\u9023\u643a\u3059\u308b\u3053\u3068\u304c\u3088\u308a\u30b9\u30e0\u30fc\u30ba\u306a\u5f37\u76d7\u306b\u3064\u306a\u304c\u308b\u3067\u3057\u3087\u3046\u3002\u5404\u30c1\u30fc\u30e0\u30e1\u30f3\u30d0\u30fc\u306b\u7279\u5b9a\u306e\u5f79\u5272\u3092\u5272\u308a\u5f53\u3066\u3001\u30ea\u30b9\u30af\u306e\u4f4e\u3044\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u9023\u643a\u3092\u7df4\u7fd2\u3059\u308b\u3053\u3068\u3067\u3001\u6226\u7565\u3092\u8abf\u6574\u3057\u307e\u3059\u3002"}, {"question": "\u9280\u884c\u5f37\u76d7\u3067\u30b2\u30fc\u30e0\u306e\u7d4c\u6e08\u30b7\u30b9\u30c6\u30e0\u3092\u52b9\u679c\u7684\u306b\u6d3b\u7528\u3057\u3066\u3001\u30ea\u30bd\u30fc\u30b9\u3092\u6700\u5927\u9650\u306b\u6d3b\u7528\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u9280\u884c\u5f37\u76d7\u3067\u30b2\u30fc\u30e0\u306e\u7d4c\u6e08\u30b7\u30b9\u30c6\u30e0\u3092\u52b9\u679c\u7684\u306b\u6d3b\u7528\u3059\u308b\u306b\u306f\u3001\u652f\u51fa\u3068\u53ce\u5165\u306e\u30d0\u30e9\u30f3\u30b9\u3092\u53d6\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002\u30b3\u30b9\u30e1\u30a2\u30a4\u30c6\u30e0\u3088\u308a\u3082\u3001\u3088\u308a\u826f\u3044\u30c4\u30fc\u30eb\u3084\u6b66\u5668\u306a\u3069\u306e\u5fc5\u9808\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u512a\u5148\u3055\u305b\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u521d\u671f\u6bb5\u968e\u3067\u9ad8\u54c1\u8cea\u306e\u89e3\u9320\u5de5\u5177\u306b\u6295\u8cc7\u3057\u3066\u304a\u304f\u3068\u3001\u5f37\u76d7\u4e2d\u306b\u6642\u9593\u3068\u30ea\u30b9\u30af\u3092\u6e1b\u3089\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30b5\u30a4\u30c9\u30df\u30c3\u30b7\u30e7\u30f3\u3084\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u5b8c\u4e86\u3057\u3066\u3001\u8ffd\u52a0\u306e\u8cc7\u91d1\u3068\u30ea\u30bd\u30fc\u30b9\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u5e38\u306b\u4eca\u5f8c\u306e\u5f37\u76d7\u306b\u57fa\u3065\u3044\u3066\u8cfc\u5165\u3092\u8a08\u753b\u3057\u3001\u5fc5\u8981\u306a\u88c5\u5099\u3092\u78ba\u4fdd\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u9280\u884c\u5f37\u76d7\u306b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u3092\u3069\u306e\u3088\u3046\u306b\u767a\u898b\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u9280\u884c\u5f37\u76d7\u306f\u3001\u597d\u5947\u5fc3\u65fa\u76db\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u5831\u916c\u3092\u4e0e\u3048\u308b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3067\u3044\u3063\u3071\u3044\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u6b74\u53f2\u7684\u9280\u884c\u300d\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u30de\u30cd\u30fc\u30b8\u30e3\u30fc\u306e\u30aa\u30d5\u30a3\u30b9\u306b\u3042\u308b\u7279\u5b9a\u306e\u7d75\u753b\u3068\u5bfe\u8a71\u3059\u308b\u3068\u79d8\u5bc6\u306e\u901a\u8def\u304c\u73fe\u308c\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u898b\u3064\u3051\u308b\u305f\u3081\u306b\u306f\u3001\u5404\u30ec\u30d9\u30eb\u3092\u5fb9\u5e95\u7684\u306b\u63a2\u7d22\u3057\u3001\u4e00\u898b\u3042\u308a\u3075\u308c\u305f\u7269\u4f53\u3068\u5bfe\u8a71\u3057\u307e\u3059\u3002\u74b0\u5883\u624b\u304c\u304b\u308a\uff08\u73cd\u3057\u3044\u5370\u307e\u305f\u306f\u5834\u6240\u4e0d\u9069\u5207\u306a\u30a2\u30a4\u30c6\u30e0\u306a\u3069\uff09\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u3089\u306f\u3001\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u793a\u5506\u3057\u3066\u3044\u308b\u3053\u3068\u304c\u3088\u304f\u3042\u308a\u307e\u3059\u3002\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u3068\u5354\u529b\u3059\u308b\u3053\u3068\u3082\u3001\u3053\u308c\u3089\u306e\u79d8\u5bc6\u3092\u898b\u3064\u3051\u308b\u305f\u3081\u306e\u8cb4\u91cd\u306a\u6d1e\u5bdf\u3092\u4e0e\u3048\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u9280\u884c\u5f37\u76d7\u306b\u304a\u3051\u308b\u8b66\u5099\u54e1\u306eAI\u884c\u52d5\u306f\u3001\u79c1\u306e\u5f37\u76d7\u8a08\u753b\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u5f7c\u3089\u306e\u884c\u52d5\u3092\u3069\u306e\u3088\u3046\u306b\u4e88\u6e2c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u9280\u884c\u5f37\u76d7\u306b\u304a\u3051\u308b\u8b66\u5099\u54e1\u306eAI\u884c\u52d5\u306f\u3001\u5f37\u76d7\u8a08\u753b\u306b\u5927\u304d\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u8b66\u5099\u54e1\u306f\u4e88\u6e2c\u53ef\u80fd\u306a\u30d1\u30c8\u30ed\u30fc\u30eb\u30eb\u30fc\u30c8\u306b\u5f93\u3044\u3001\u30c8\u30e9\u30d6\u30eb\u304c\u767a\u751f\u3059\u308b\u3068\u53cd\u5fdc\u3059\u308b\u304b\u3089\u3067\u3059\u3002\u5f7c\u3089\u306e\u884c\u52d5\u3092\u4e88\u6e2c\u3059\u308b\u306b\u306f\u3001\u5075\u5bdf\u6bb5\u968e\u3067\u5f7c\u3089\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u89b3\u5bdf\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u7523\u696d\u9280\u884c\u300d\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u8b66\u5099\u54e1\u306f\u7279\u5b9a\u306e\u30d1\u30c8\u30ed\u30fc\u30eb\u30b5\u30a4\u30af\u30eb\u3092\u6301\u3061\u3001\u884c\u52d5\u306e\u305f\u3081\u306e\u5b89\u5168\u306a\u7a93\u3092\u4f5c\u6210\u3059\u308b\u305f\u3081\u306b\u5229\u7528\u3067\u304d\u307e\u3059\u3002\u90aa\u9b54\u3092\u3059\u308b\u3053\u3068\u3067\u5f7c\u3089\u306e\u7d4c\u8def\u3092\u64cd\u4f5c\u3057\u3001\u901a\u5e38\u30eb\u30fc\u30c8\u304b\u3089\u9038\u8131\u3057\u305f\u5834\u5408\u306e\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u30d7\u30e9\u30f3\u3092\u5e38\u306b\u7528\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u9280\u884c\u5f37\u76d7\u3092\u5b9f\u884c\u3059\u308b\u305f\u3081\u306e\u6280\u8853\u7684\u306a\u8981\u4ef6\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u30b9\u30e0\u30fc\u30ba\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u78ba\u4fdd\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u9280\u884c\u5f37\u76d7\u3092\u30b9\u30e0\u30fc\u30ba\u306b\u5b9f\u884c\u3059\u308b\u306b\u306f\u3001\u30b2\u30fc\u30e0\u306e\u6280\u8853\u7684\u306a\u8981\u4ef6\u3092\u6e80\u305f\u3059\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002PC\u306e\u5834\u5408\u3001\u30b7\u30b9\u30c6\u30e0\u306b\u5c11\u306a\u304f\u3068\u3082Intel i5\u30d7\u30ed\u30bb\u30c3\u30b5\u30018GB RAM\u3001GTX 970\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u30ab\u30fc\u30c9\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b3\u30f3\u30bd\u30fc\u30eb\u306e\u5834\u5408\u3001\u6700\u65b0\u306e\u30b7\u30b9\u30c6\u30e0\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u305f\u3081\u306b\u3001\u30e9\u30b0\u304c\u767a\u751f\u3059\u308b\u5834\u5408\u306f\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3092\u4e0b\u3052\u3001\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u30a2\u30d7\u30ea\u30b1\u30fc\u30b7\u30e7\u30f3\u3092\u9589\u3058\u307e\u3059\u3002\u30c9\u30e9\u30a4\u30d0\u30fc\u3068\u30b2\u30fc\u30e0\u81ea\u4f53\u3092\u5b9a\u671f\u7684\u306b\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3059\u308b\u3053\u3068\u3082\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b7\u30b9\u30c6\u30e0\u306e\u4ed5\u69d8\u3092\u30b2\u30fc\u30e0\u306e\u8981\u4ef6\u3068\u6bd4\u8f03\u3059\u308b\u3053\u3068\u3067\u3001\u4e92\u63db\u6027\u3092\u78ba\u8a8d\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u9280\u884c\u5f37\u76d7\u3067\u3001\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u306e\u904e\u7a0b\u3067\u4f55\u306b\u6ce8\u610f\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u9280\u884c\u5f37\u76d7\u3067\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001Steam\u3084Epic Games\u30a2\u30ab\u30a6\u30f3\u30c8\u306a\u3069\u3001\u666e\u904d\u7684\u306a\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u3078\u306e\u30b2\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\u306e\u9023\u643a\u304c\u6c42\u3081\u3089\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001PC\u304b\u3089\u30b3\u30f3\u30bd\u30fc\u30eb\u306b\u79fb\u52d5\u3059\u308b\u5834\u5408\u3001\u4e21\u65b9\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u304c\u30af\u30ed\u30b9\u30d7\u30ed\u30b0\u30ec\u30b9\u306b\u5bfe\u5fdc\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u8ee2\u9001\u4e2d\u306b\u3001\u30c7\u30fc\u30bf\u640d\u5931\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u30bb\u30fc\u30d6\u30d5\u30a1\u30a4\u30eb\u3092\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4e00\u90e8\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u56fa\u6709\u306e\u9054\u6210\u4e8b\u9805\u3084\u30a2\u30a4\u30c6\u30e0\u304c\u8ee2\u9001\u3055\u308c\u306a\u3044\u53ef\u80fd\u6027\u304c\u3042\u308b\u305f\u3081\u3001\u4e8b\u524d\u306b\u30b2\u30fc\u30e0\u306e\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30dd\u30ea\u30b7\u30fc\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u3089\u306e\u624b\u9806\u306b\u5f93\u3046\u3053\u3068\u3067\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u306e\u30b9\u30e0\u30fc\u30ba\u306a\u79fb\u884c\u3092\u78ba\u4fdd\u3067\u304d\u307e\u3059\u3002"}]
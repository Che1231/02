[{"question": "\ucd08\ubcf4\uc790\uac00 \uc740\ud589 \uac15\ub3c4 \uac8c\uc784\uc5d0\uc11c \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \uc774\ud574\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc740\ud589 \uac15\ub3c4 \uac8c\uc784\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \uc774\ud574\ud558\ub824\uba74 \uc6c0\uc9c1\uc784 \ud0a4(WASD)\uc640 \uc0c1\ud638\uc791\uc6a9 \ud0a4(E)\ub97c \uba3c\uc800 \uc775\uc219\ud574\uc9c0\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uae08\uace0\ub97c \uc5f4\ub824\uba74 \uae08\uace0\uc5d0 \ub2e4\uac00\uac00 E \ud0a4\ub97c \ub204\ub974\uc138\uc694. \uc548\uc804\ud55c \ud658\uacbd\uc5d0\uc11c \uc2e4\ud5d8\ud560 \uc218 \uc788\ub294 \ud29c\ud1a0\ub9ac\uc5bc \ub808\ubca8\uc5d0\uc11c \uc774\ub7ec\ud55c \ucee8\ud2b8\ub864\uc744 \uc5f0\uc2b5\ud558\uc138\uc694. \ub610\ud55c, \uac8c\uc784 \ub0b4 \ucee8\ud2b8\ub864 \uc124\uc815\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud0a4 \ubc14\uc778\ub529\uc744 \uc6d0\ud558\ub294 \ub300\ub85c \uc0ac\uc6a9\uc790 \uc815\uc758\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ucd08\uae30 \ud50c\ub808\uc774 \uc911\uc5d0\ub294 \ucee8\ud2b8\ub864 \ucc38\uace0 \uce74\ub4dc\ub97c \uc190\uc27d\uac8c \uac16\uace0 \uc788\uc73c\uba74 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4."}, {"question": "\uc740\ud589 \uac15\ub3c4 \uac8c\uc784\uc5d0\uc11c \uac15\ub3c4\ub97c \uc131\uacf5\uc801\uc73c\ub85c \uc644\ub8cc\ud558\uae30 \uc704\ud55c \ud544\uc218 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc740\ud589 \uac15\ub3c4 \uac8c\uc784\uc5d0\uc11c \uac15\ub3c4\ub97c \uc131\uacf5\uc801\uc73c\ub85c \uc644\ub8cc\ud558\ub824\uba74 \uc2e0\uc911\ud55c \uacc4\ud68d\uacfc \uc2e4\ud589\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \uc740\ud589 \ub808\uc774\uc544\uc6c3\uc744 \uc870\uc0ac\ud558\uc5ec \ubcf4\uc548 \uce74\uba54\ub77c\uc640 \uacbd\ube44\uc6d0 \uc21c\ucc30 \uacbd\ub85c\ub97c \ud30c\uc545\ud569\ub2c8\ub2e4. STEP2: \uc7a0\uae08 \uc7a5\uce58\uc640 \ubb34\uc74c \ubb34\uae30\ub97c \ud3ec\ud568\ud55c \uc62c\ubc14\ub978 \ub3c4\uad6c\ub85c \ud300\uc744 \uc7a5\ube44\ud558\uc5ec \uac10\uc9c0\ub418\uc9c0 \uc54a\ub3c4\ub85d \ud569\ub2c8\ub2e4. STEP3: \ud300\uc6d0\ub4e4\uacfc \ud611\ub825\ud558\uc5ec \ub3d9\uc2dc\uc5d0 \uacbd\ubcf4\ub97c \ud574\uc81c\ud558\uace0 \uae08\uace0\ub97c \ud655\ubcf4\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub3c4\uc2ec \uc740\ud589' \ubbf8\uc158\uc5d0\uc11c \uacbd\ube44\uc6d0 \uad50\ub300 \uc2dc\uc810\uacfc \ub3d9\uc2dc\uc5d0 \ud589\ub3d9\ud558\uba74 \uac10\uc9c0 \uc704\ud5d8\uc744 \ud06c\uac8c \uc904\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud56d\uc0c1 \ud0c8\ucd9c \uacc4\ud68d\uc744 \uc900\ube44\ud558\uace0 \ubaa8\ub4e0 \ud300\uc6d0\uc774 \uc774\ub97c \uc54c\uace0 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694."}, {"question": "\uc740\ud589 \uac15\ub3c4 \uac8c\uc784\uc5d0\uc11c \ud300\uc758 \uae30\uc220\uc744 \uad00\ub9ac\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc740\ud589 \uac15\ub3c4 \uac8c\uc784\uc5d0\uc11c \ud300\uc758 \uae30\uc220\uc744 \uad00\ub9ac\ud558\ub294 \uac83\uc740 \ub2e4\uc591\ud55c \uc5b4\ub824\uc6c0\uc744 \uadf9\ubcf5\ud558\ub294 \ub370 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uac01 \ud300\uc6d0\uc740 \ud2b9\uc815 \uc5ed\ud560\uc5d0 \ucd5c\uc801\ud654\ub420 \uc218 \uc788\ub294 \uace0\uc720\ud55c \ub2a5\ub825\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud574\ucee4\ub294 \ubcf4\uc548 \uc2dc\uc2a4\ud15c\uc744 \ub354 \ube60\ub974\uac8c \ube44\ud65c\uc131\ud654\ud560 \uc218 \uc788\uace0, \uc7a0\uae08 \uc7a5\uce58\ub294 \uae08\uace0\ub97c \ub354 \ud6a8\uc728\uc801\uc73c\ub85c \uc5f4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uae30\uc220\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uac01 \uad6c\uc131\uc6d0\uc758 \uac15\uc810\uc744 \uae30\ubc18\uc73c\ub85c \uc5ed\ud560\uc744 \ud560\ub2f9\ud558\uace0 \uc131\uacf5\uc801\uc778 \uac15\ub3c4\uc5d0\uc11c \uc5bb\uc740 \uc2a4\ud0ac \ud3ec\uc778\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub2a5\ub825\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc138\uc694. \uc0c1\ud638 \ubcf4\uc644\uc801\uc778 \uae30\uc220\uc744 \uac00\uc9c4 \uade0\ud615 \uc7a1\ud78c \ud300\uc740 \uc131\uacf5\uc801\uc778 \uac15\ub3c4\uc758 \uac00\ub2a5\uc131\uc744 \ub192\uc785\ub2c8\ub2e4."}, {"question": "\uc740\ud589 \uac15\ub3c4 \uac8c\uc784\uc758 \uc2a4\ud154\uc2a4 \uba54\ucee4\ub2c8\uc998\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uac10\uc9c0\ub418\uc9c0 \uc54a\uace0 \uc6c0\uc9c1\uc774\ub294 \ucd5c\uace0\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc740\ud589 \uac15\ub3c4 \uac8c\uc784\uc758 \uc2a4\ud154\uc2a4 \uba54\ucee4\ub2c8\uc998\uc740 \uacbd\ube44\uc6d0\uc758 \uc2dc\uc57c\ub97c \ud53c\ud558\uace0 \uc18c\uc74c\uc744 \ucd5c\uc18c\ud654\ud558\ub294 \ub370 \uae30\ubc18\ud569\ub2c8\ub2e4. \uac10\uc9c0\ub418\uc9c0 \uc54a\uc73c\ub824\uba74 \uadf8\ub9bc\uc790\uc5d0 \uba38\ubb3c\uace0 \ud544\uc694\uc5d0 \ub530\ub77c \ubb34\uc74c \ubb34\uae30\ub97c \uc0ac\uc6a9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uc8fc\ud0dd\uac00 \uc740\ud589' \ubbf8\uc158\uc5d0\uc11c \ubc29\ub300\ud55c \uacbd\ube44 \ubd80\ub300\uac00 \uc788\ub294 \uc9c0\uc5ed\uc744 \uc6b0\ud68c\ud558\uae30 \uc704\ud574 \ud658\uae30 \uc2dc\uc2a4\ud15c\uc744 \uc774\uc6a9\ud558\ub294 \uac83\uc774 \ub9e4\uc6b0 \ud6a8\uacfc\uc801\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uc8fc\ubcc0 \ud658\uacbd\uc744 \ud56d\uc0c1 \uc778\uc9c0\ud558\uace0 \ubb3c\uac74\uc744 \ub358\uc838 \uacbd\ube44\uc6d0\uc758 \uc8fc\uc758\ub97c \uc0b0\ub9cc\ud558\uac8c \ud558\ub294 \ub4f1\uc758 \ubc29\ud574 \uc804\ub7b5\uc744 \uc0ac\uc6a9\ud574\uc57c \ud569\ub2c8\ub2e4. \uc704\ud5d8\ub3c4\uac00 \uc801\uc740 \ubbf8\uc158\uc5d0\uc11c \uc774\ub7ec\ud55c \uae30\uc220\uc744 \uc5f0\uc2b5\ud558\uc5ec \uc790\uc2e0\uac10\uc744 \ud0a4\uc6b0\uc138\uc694."}, {"question": "\uc740\ud589 \uac15\ub3c4 \uac8c\uc784\uc758 \uc194\ub85c \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5a4 \uc804\ub7b5\uc744 \uc801\uc6a9\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\uc740\ud589 \uac15\ub3c4 \uac8c\uc784\uc758 \uc194\ub85c \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \uc870\uc815 \uc218\uc900\uacfc \uc791\uc5c5\uc758 \ubcf5\uc7a1\uc131\uc785\ub2c8\ub2e4. \uc194\ub85c \ubaa8\ub4dc\uc5d0\uc11c\ub294 \ubaa8\ub4e0 \uc5ed\ud560\uc744 \uc9c1\uc811 \uc218\ud589\ud574\uc57c \ud558\ubbc0\ub85c \ub354\uc6b1 \uc2e0\uc911\ud55c \uc811\uadfc \ubc29\uc2dd\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \ud611\uc5c5\uc774 \uc911\uc694\ud558\uba70 \uc18c\ud1b5\uc774 \ud575\uc2ec\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub3c4\uc2ec \uc911\uc2ec \uc740\ud589' \ubbf8\uc158\uc5d0\uc11c \ud300\uc6d0\ub4e4\uacfc \ud611\ub825\ud558\uc5ec \ub3d9\uc2dc\uc5d0 \uacbd\ubcf4\ub97c \ud574\uc81c\ud558\uace0 \uae08\uace0\ub97c \ud655\ubcf4\ud558\uba74 \ub354\uc6b1 \uc6d0\ud65c\ud55c \uac15\ub3c4\uac00 \uac00\ub2a5\ud569\ub2c8\ub2e4. \uac01 \ud300\uc6d0\uc5d0\uac8c \ud2b9\uc815 \uc5ed\ud560\uc744 \ud560\ub2f9\ud558\uace0 \uc704\ud5d8\ub3c4\uac00 \ub0ae\uc740 \ubbf8\uc158\uc5d0\uc11c \ud611\ub825\uc744 \uc5f0\uc2b5\ud558\uc5ec \uc804\ub7b5\uc744 \uc870\uc815\ud558\uc138\uc694."}, {"question": "\uc740\ud589 \uac15\ub3c4 \uac8c\uc784\uc758 \uacbd\uc81c \uc2dc\uc2a4\ud15c\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\uc5ec \uc790\uc6d0\uc744 \uadf9\ub300\ud654\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\uc740\ud589 \uac15\ub3c4 \uac8c\uc784\uc758 \uacbd\uc81c \uc2dc\uc2a4\ud15c\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\ub824\uba74 \uc9c0\ucd9c\uacfc \uc218\uc785\uc758 \uade0\ud615\uc744 \ub9de\ucd94\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc7a5\uc2dd\ud488\ubcf4\ub2e4 \ud544\uc218\uc801\uc778 \uc5c5\uadf8\ub808\uc774\ub4dc, \uc608\ub97c \ub4e4\uc5b4 \ub354 \ub098\uc740 \ub3c4\uad6c\uc640 \ubb34\uae30 \ub4f1\uc5d0 \uc6b0\uc120\uc21c\uc704\ub97c \ub450\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uace0\ud488\uc9c8 \uc7a0\uae08 \uc7a5\uce58\uc5d0 \ucd08\uae30\uc5d0 \ud22c\uc790\ud558\uba74 \uac15\ub3c4 \uc911 \uc2dc\uac04\uacfc \uc704\ud5d8\uc744 \uc904\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \ucd94\uac00 \uc218\uc785\uacfc \uc790\uc6d0\uc744 \uc5bb\uae30 \uc704\ud574 \ubd80\uc218\uc801\uc778 \ubbf8\uc158\uacfc \ucc4c\ub9b0\uc9c0\ub4e4\uc744 \uc644\ub8cc\ud558\uc138\uc694. \ud56d\uc0c1 \uc55e\uc73c\ub85c \uc788\uc744 \uac15\ub3c4\uc5d0 \ub530\ub77c \uad6c\ub9e4\ub97c \uacc4\ud68d\ud558\uc5ec \ud544\uc694\ud55c \uc7a5\ube44\ub97c \ud655\ubcf4\ud558\uc138\uc694."}, {"question": "\uc740\ud589 \uac15\ub3c4 \uac8c\uc784\uc758 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub4e4\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc740\ud589 \uac15\ub3c4 \uac8c\uc784\uc5d0\ub294 \ud638\uae30\uc2ec \ub9ce\uc740 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub4e4\uc774 \uac00\ub4dd\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc5ed\uc0ac \uc740\ud589' \ubbf8\uc158\uc5d0\uc11c \uacbd\uc601\uc9c4 \uc0ac\ubb34\uc2e4\uc758 \ud2b9\uc815 \uadf8\ub9bc\uc5d0 \ubc18\uc751\ud558\uba74 \ube44\ubc00 \ud1b5\ub85c\ub97c \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ubc1c\uacac\ud558\ub824\uba74 \uac01 \ub808\ubca8\uc744 \uaf3c\uaf3c\ud788 \ud0d0\uc0c9\ud558\uace0 \ud3c9\ubc94\ud574 \ubcf4\uc774\ub294 \ubb3c\uac74\ub4e4\uacfc \uc0c1\ud638 \uc791\uc6a9\ud574\ubcf4\uc138\uc694. \ud2b9\uc774\ud55c \ud45c\uc2dd\uc774\ub098 \uc5b4\uc6b8\ub9ac\uc9c0 \uc54a\ub294 \ubb3c\uac74\uacfc \uac19\uc740 \ud658\uacbd \ub2e8\uc11c\uc5d0 \uc8fc\uc758\ud558\uc5ec \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \uc5ff\ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ucee4\ubba4\ub2c8\ud2f0\uc640 \ud611\ub825\ud558\ub294 \uac83\ub3c4 \uc774\ub7ec\ud55c \ube44\ubc00\uc744 \ucc3e\ub294 \ub370 \uadc0\uc911\ud55c \ud1b5\ucc30\ub825\uc744 \uc81c\uacf5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc740\ud589 \uac15\ub3c4 \uac8c\uc784\uc5d0\uc11c \uacbd\ube44\uc6d0\uc758 AI \ud589\ub3d9\uc740 \uac15\ub3c4 \uacc4\ud68d\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\uba70, \uacbd\ube44\uc6d0\uc758 \uc6c0\uc9c1\uc784\uc744 \uc5b4\ub5bb\uac8c \uc608\uce21\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc740\ud589 \uac15\ub3c4 \uac8c\uc784\uc5d0\uc11c \uacbd\ube44\uc6d0\uc758 AI \ud589\ub3d9\uc740 \uac15\ub3c4 \uacc4\ud68d\uc5d0 \ud070 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uacbd\ube44\uc6d0\ub4e4\uc740 \uc608\uce21 \uac00\ub2a5\ud55c \uc21c\ucc30 \uacbd\ub85c\ub97c \ub530\ub974\uace0 \ubc29\ud574 \ud589\uc704\uc5d0 \ubc18\uc751\ud569\ub2c8\ub2e4. \uacbd\ube44\uc6d0\uc758 \uc6c0\uc9c1\uc784\uc744 \uc608\uce21\ud558\ub824\uba74 \uc870\uc0ac \ub2e8\uacc4\uc5d0\uc11c \uadf8\ub4e4\uc758 \ud328\ud134\uc744 \uad00\ucc30\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uc0b0\uc5c5 \uc740\ud589' \ubbf8\uc158\uc5d0\uc11c \uacbd\ube44\uc6d0\ub4e4\uc740 \ud2b9\uc815 \uc21c\ucc30 \uc8fc\uae30\ub97c \ub530\ub974\uae30 \ub54c\ubb38\uc5d0 \uc774\ub97c \uc774\uc6a9\ud558\uc5ec \uc548\uc804\ud55c \ud589\ub3d9 \uc2dc\uac04\uc744 \ucc3d\ucd9c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubc29\ud574\ub97c \ud1b5\ud574 \uadf8\ub4e4\uc758 \uacbd\ub85c\ub97c \uc870\uc791\ud558\uace0, \uc608\uc0c1\uce58 \ubabb\ud55c \uacbd\ub85c \ubcc0\uacbd\uc5d0 \ub300\ube44\ud55c \ubc31\uc5c5 \uacc4\ud68d\uc744 \ud56d\uc0c1 \uc900\ube44\ud558\uc138\uc694."}, {"question": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc740\ud589 \uac15\ub3c4 \uac8c\uc784\uc744 \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ud558\uae30 \uc704\ud574 \ud544\uc694\ud55c \uae30\uc220 \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \uc6d0\ud65c\ud55c \uc131\ub2a5\uc744 \ubcf4\uc7a5\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc740\ud589 \uac15\ub3c4 \uac8c\uc784\uc744 \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ud558\ub824\uba74 \uac8c\uc784\uc758 \uae30\uc220\uc801 \uc694\uad6c \uc0ac\ud56d\uc744 \ucda9\uc871\ud574\uc57c \ud569\ub2c8\ub2e4. PC\uc758 \uacbd\uc6b0, \uc2dc\uc2a4\ud15c\uc5d0 \ucd5c\uc18c \uc778\ud154 i5 \ud504\ub85c\uc138\uc11c, 8GB RAM \ubc0f GTX 970 \uadf8\ub798\ud53d \uce74\ub4dc\uac00 \uc788\uc5b4\uc57c \ud569\ub2c8\ub2e4. \ucf58\uc194\uc758 \uacbd\uc6b0 \ucd5c\uc2e0 \uc2dc\uc2a4\ud15c \uc5c5\ub370\uc774\ud2b8\ub97c \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc9c0\uc5f0 \ud604\uc0c1\uc774 \ubc1c\uc0dd\ud560 \uacbd\uc6b0 \uadf8\ub798\ud53d \uc124\uc815\uc744 \ub0ae\ucd94\uace0 \ubc31\uadf8\ub77c\uc6b4\ub4dc \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc744 \ub2eb\uc73c\uc138\uc694. \ub4dc\ub77c\uc774\ubc84\uc640 \uac8c\uc784 \uc790\uccb4\ub97c \uc815\uae30\uc801\uc73c\ub85c \uc5c5\ub370\uc774\ud2b8\ud558\uba74 \uc131\ub2a5\ub3c4 \ud5a5\uc0c1\ub429\ub2c8\ub2e4. \uc2dc\uc2a4\ud15c \uc0ac\uc591\uc744 \uac8c\uc784 \uc694\uad6c \uc0ac\ud56d\uacfc \ube44\uad50\ud558\uc5ec \ud638\ud658\uc131\uc744 \ud655\uc778\ud558\uc138\uc694."}, {"question": "\uc740\ud589 \uac15\ub3c4 \uac8c\uc784\uc5d0\uc11c \ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\uc73c\uba70, \uadf8 \uacfc\uc815\uc5d0\uc11c \uc5b4\ub5a4 \uc810\uc5d0 \uc720\uc758\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\uc740\ud589 \uac15\ub3c4 \uac8c\uc784\uc5d0\uc11c \ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub824\uba74 \uac8c\uc784 \uacc4\uc815\uc744 Steam \ub610\ub294 Epic Games \uacc4\uc815\uacfc \uac19\uc740 \ubcf4\ud3b8\uc801\uc778 \ud504\ub85c\ud544\uc5d0 \uc5f0\uacb0\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ucf58\uc194\ub85c \uc774\ub3d9\ud558\ub294 \uacbd\uc6b0 \ud574\ub2f9 \ud50c\ub7ab\ud3fc \ubaa8\ub450 \ud06c\ub85c\uc2a4 \uc9c4\ud589\uc744 \uc9c0\uc6d0\ud574\uc57c \ud569\ub2c8\ub2e4. \uc804\uc1a1\ud558\ub294 \ub3d9\uc548 \ub370\uc774\ud130 \uc190\uc2e4\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \uc800\uc7a5 \ud30c\uc77c\uc744 \ubc31\uc5c5\ud558\uc138\uc694. \uc77c\ubd80 \ud50c\ub7ab\ud3fc\ubcc4 \uc5c5\uc801 \ub610\ub294 \uc544\uc774\ud15c\uc774 \uc804\uc1a1\ub418\uc9c0 \uc54a\uc744 \uc218 \uc788\uc73c\ubbc0\ub85c \uc0ac\uc804\uc5d0 \uac8c\uc784\uc758 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \uc815\ucc45\uc744 \uac80\ud1a0\ud558\uc138\uc694. \uc774\ub7ec\ud55c \ub2e8\uacc4\ub97c \ub530\ub974\uba74 \ud50c\ub7ab\ud3fc \uac04 \uc6d0\ud65c\ud55c \uc804\ud658\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4."}]
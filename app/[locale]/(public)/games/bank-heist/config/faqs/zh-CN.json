[{"question": "\u5982\u4f55\u5feb\u901f\u7406\u89e3\u300a\u94f6\u884c\u62a2\u52ab\u300b\u65b0\u624b\u5165\u95e8\u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1\u300a\u94f6\u884c\u62a2\u52ab\u300b\u7684\u57fa\u672c\u63a7\u5236\uff0c\u9996\u5148\u719f\u6089\u79fb\u52a8\u952e\uff08WASD\uff09\u548c\u4ea4\u4e92\u952e\uff08E\uff09\u3002\u4f8b\u5982\uff0c\u8981\u6253\u5f00\u4fdd\u9669\u5e93\uff0c\u9760\u8fd1\u5b83\u5e76\u6309E\u3002\u5728\u6559\u7a0b\u5173\u5361\u7ec3\u4e60\u8fd9\u4e9b\u63a7\u5236\uff0c\u8fd9\u63d0\u4f9b\u4e86\u4e00\u4e2a\u5b89\u5168\u7684\u73af\u5883\u8fdb\u884c\u5b9e\u9a8c\u3002\u6b64\u5916\uff0c\u4f7f\u7528\u6e38\u620f\u4e2d\u7684\u63a7\u5236\u8bbe\u7f6e\u81ea\u5b9a\u4e49\u6309\u952e\u7ed1\u5b9a\u4ee5\u6ee1\u8db3\u60a8\u7684\u504f\u597d\u3002\u4e00\u4e2a\u6709\u7528\u7684\u6280\u5de7\u662f\u5728\u60a8\u521d\u6b21\u6e38\u620f\u65f6\u968f\u65f6\u51c6\u5907\u597d\u63a7\u5236\u53c2\u8003\u5361\u3002"}, {"question": "\u6210\u529f\u5b8c\u6210\u300a\u94f6\u884c\u62a2\u52ab\u300b\u4efb\u52a1\u7684\u5173\u952e\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u6210\u529f\u5b8c\u6210\u300a\u94f6\u884c\u62a2\u52ab\u300b\u7684\u4efb\u52a1\u9700\u8981\u4ed4\u7ec6\u7684\u8ba1\u5212\u548c\u6267\u884c\u3002\u6b65\u9aa41\uff1a\u4fa6\u5bdf\u94f6\u884c\u5e03\u5c40\uff0c\u8bc6\u522b\u5b89\u5168\u6444\u50cf\u5934\u548c\u8b66\u536b\u5de1\u903b\u8def\u7ebf\u3002\u6b65\u9aa42\uff1a\u4e3a\u60a8\u7684\u56e2\u961f\u914d\u5907\u5408\u9002\u7684\u5de5\u5177\uff0c\u4f8b\u5982\u64ac\u9501\u5de5\u5177\u548c\u6d88\u97f3\u6b66\u5668\uff0c\u4ee5\u907f\u514d\u88ab\u53d1\u73b0\u3002\u6b65\u9aa43\uff1a\u4e0e\u60a8\u7684\u56e2\u961f\u534f\u8c03\uff0c\u540c\u65f6\u7981\u7528\u8b66\u62a5\u5e76\u9501\u5b9a\u4fdd\u9669\u5e93\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5e02\u4e2d\u5fc3\u94f6\u884c\u201d\u4efb\u52a1\u4e2d\uff0c\u4f7f\u60a8\u7684\u884c\u52a8\u4e0e\u8b66\u536b\u8f6e\u73ed\u65f6\u95f4\u76f8\u543b\u5408\u53ef\u4ee5\u663e\u8457\u964d\u4f4e\u88ab\u53d1\u73b0\u7684\u98ce\u9669\u3002\u59cb\u7ec8\u51c6\u5907\u597d\u9003\u751f\u8ba1\u5212\uff0c\u5e76\u786e\u4fdd\u6240\u6709\u56e2\u961f\u6210\u5458\u90fd\u4e86\u89e3\u5b83\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u5728\u300a\u94f6\u884c\u62a2\u52ab\u300b\u4e2d\u7ba1\u7406\u56e2\u961f\u6280\u80fd\u5f88\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u4f18\u5316\u5b83\u4eec\uff1f", "answer": "\u5728\u300a\u94f6\u884c\u62a2\u52ab\u300b\u4e2d\u7ba1\u7406\u56e2\u961f\u6280\u80fd\u5bf9\u4e8e\u514b\u670d\u5404\u79cd\u6311\u6218\u81f3\u5173\u91cd\u8981\u3002\u6bcf\u4e2a\u56e2\u961f\u6210\u5458\u90fd\u6709\u72ec\u7279\u7684\u6280\u80fd\uff0c\u53ef\u4ee5\u9488\u5bf9\u7279\u5b9a\u89d2\u8272\u8fdb\u884c\u4f18\u5316\u3002\u4f8b\u5982\uff0c\u9ed1\u5ba2\u53ef\u4ee5\u66f4\u5feb\u5730\u7981\u7528\u5b89\u5168\u7cfb\u7edf\uff0c\u800c\u64ac\u9501\u4e13\u5bb6\u53ef\u4ee5\u66f4\u9ad8\u6548\u5730\u6253\u5f00\u4fdd\u9669\u5e93\u3002\u4e3a\u4e86\u4f18\u5316\u6280\u80fd\uff0c\u6839\u636e\u6bcf\u4e2a\u6210\u5458\u7684\u4f18\u52bf\u5206\u914d\u89d2\u8272\uff0c\u5e76\u4f7f\u7528\u4ece\u6210\u529f\u62a2\u52ab\u4e2d\u83b7\u5f97\u7684\u6280\u80fd\u70b9\u6765\u5347\u7ea7\u4ed6\u4eec\u7684\u80fd\u529b\u3002\u4e00\u4e2a\u62e5\u6709\u4e92\u8865\u6280\u80fd\u7684\u5e73\u8861\u56e2\u961f\u4f1a\u589e\u52a0\u6210\u529f\u62a2\u52ab\u7684\u673a\u4f1a\u3002"}, {"question": "\u300a\u94f6\u884c\u62a2\u52ab\u300b\u4e2d\u7684\u9690\u853d\u673a\u5236\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u4fdd\u6301\u4e0d\u88ab\u53d1\u73b0\u7684\u6700\u4f73\u5b9e\u8df5\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u94f6\u884c\u62a2\u52ab\u300b\u4e2d\u7684\u9690\u853d\u673a\u5236\u4f9d\u8d56\u4e8e\u907f\u514d\u4e0e\u8b66\u536b\u7684\u89c6\u7ebf\u63a5\u89e6\u5e76\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u566a\u97f3\u3002\u4e3a\u4e86\u4e0d\u88ab\u53d1\u73b0\uff0c\u8eb2\u5728\u9634\u5f71\u4e2d\uff0c\u5fc5\u8981\u65f6\u4f7f\u7528\u6d88\u97f3\u6b66\u5668\u3002\u4f8b\u5982\uff0c\u5728\u201c\u90ca\u533a\u94f6\u884c\u201d\u4efb\u52a1\u4e2d\uff0c\u4f7f\u7528\u901a\u98ce\u7cfb\u7edf\u7ed5\u8fc7\u91cd\u5175\u628a\u5b88\u7684\u533a\u57df\u975e\u5e38\u6709\u6548\u3002\u6b64\u5916\uff0c\u59cb\u7ec8\u6ce8\u610f\u5468\u56f4\u73af\u5883\uff0c\u5e76\u4f7f\u7528\u8bf8\u5982\u6295\u63b7\u7269\u54c1\u4e4b\u7c7b\u7684\u5e72\u6270\u63aa\u65bd\u6765\u8f6c\u79fb\u8b66\u536b\u7684\u6ce8\u610f\u529b\u3002\u5728\u98ce\u9669\u8f83\u4f4e\u7684\u4efb\u52a1\u4e2d\u7ec3\u4e60\u8fd9\u4e9b\u6280\u5de7\uff0c\u4ee5\u5efa\u7acb\u4fe1\u5fc3\u3002"}, {"question": "\u300a\u94f6\u884c\u62a2\u52ab\u300b\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u4e4b\u95f4\u7684\u4e3b\u8981\u533a\u522b\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u6211\u5e94\u8be5\u5982\u4f55\u76f8\u5e94\u5730\u8c03\u6574\u6211\u7684\u7b56\u7565\uff1f", "answer": "\u300a\u94f6\u884c\u62a2\u52ab\u300b\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u4e4b\u95f4\u7684\u4e3b\u8981\u533a\u522b\u5728\u4e8e\u534f\u8c03\u7684\u7a0b\u5ea6\u548c\u4efb\u52a1\u7684\u590d\u6742\u6027\u3002\u5728\u5355\u4eba\u6a21\u5f0f\u4e2d\uff0c\u60a8\u5fc5\u987b\u81ea\u5df1\u5904\u7406\u6240\u6709\u89d2\u8272\uff0c\u9700\u8981\u91c7\u53d6\u66f4\u8c28\u614e\u7684\u65b9\u5f0f\u3002\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u56e2\u961f\u5408\u4f5c\u81f3\u5173\u91cd\u8981\uff0c\u6c9f\u901a\u662f\u5173\u952e\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5e02\u4e2d\u5fc3\u94f6\u884c\u201d\u4efb\u52a1\u4e2d\uff0c\u4e0e\u961f\u53cb\u534f\u8c03\u540c\u65f6\u7981\u7528\u8b66\u62a5\u5e76\u9501\u5b9a\u4fdd\u9669\u5e93\u53ef\u4ee5\u4f7f\u62a2\u52ab\u66f4\u52a0\u987a\u5229\u3002\u901a\u8fc7\u4e3a\u6bcf\u4e2a\u56e2\u961f\u6210\u5458\u5206\u914d\u7279\u5b9a\u89d2\u8272\u5e76\u5728\u5927\u89c4\u6a21\u6d4b\u8bd5\u4e2d\u7ec3\u4e60\u534f\u8c03\uff0c\u4ece\u800c\u8c03\u6574\u60a8\u7684\u7b56\u7565\u3002"}, {"question": "\u5982\u4f55\u6709\u6548\u5730\u5229\u7528\u300a\u94f6\u884c\u62a2\u52ab\u300b\u7684\u6e38\u620f\u7ecf\u6d4e\u7cfb\u7edf\u6765\u6700\u5927\u5316\u6211\u7684\u8d44\u6e90\uff1f", "answer": "\u5728\u300a\u94f6\u884c\u62a2\u52ab\u300b\u4e2d\u6709\u6548\u5229\u7528\u6e38\u620f\u7ecf\u6d4e\u7cfb\u7edf\uff0c\u9700\u8981\u5e73\u8861\u60a8\u7684\u652f\u51fa\u548c\u6536\u5165\u3002\u4f18\u5148\u8003\u8651\u5fc5\u8981\u7684\u5347\u7ea7\uff0c\u4f8b\u5982\u66f4\u597d\u7684\u5de5\u5177\u548c\u6b66\u5668\uff0c\u800c\u4e0d\u662f\u88c5\u9970\u6027\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5c3d\u65e9\u6295\u8d44\u9ad8\u8d28\u91cf\u7684\u64ac\u9501\u5de5\u5177\uff0c\u53ef\u4ee5\u8282\u7701\u65f6\u95f4\uff0c\u5e76\u5728\u62a2\u52ab\u8fc7\u7a0b\u4e2d\u964d\u4f4e\u98ce\u9669\u3002\u6b64\u5916\uff0c\u5b8c\u6210\u652f\u7ebf\u4efb\u52a1\u548c\u6311\u6218\u4ee5\u8d5a\u53d6\u989d\u5916\u73b0\u91d1\u548c\u8d44\u6e90\u3002\u59cb\u7ec8\u6839\u636e\u5373\u5c06\u8fdb\u884c\u7684\u62a2\u52ab\u4e8b\u5148\u8ba1\u5212\u597d\u60a8\u7684\u8d2d\u4e70\uff0c\u4ee5\u786e\u4fdd\u60a8\u62e5\u6709\u6240\u9700\u7684\u8bbe\u5907\u3002"}, {"question": "\u300a\u94f6\u884c\u62a2\u52ab\u300b\u4e2d\u7684\u9690\u85cf\u5f69\u86cb\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5982\u4f55\u53d1\u73b0\u5b83\u4eec\uff1f", "answer": "\u300a\u94f6\u884c\u62a2\u52ab\u300b\u5145\u6ee1\u4e86\u5956\u52b1\u597d\u5947\u73a9\u5bb6\u7684\u9690\u85cf\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5386\u53f2\u94f6\u884c\u201d\u4efb\u52a1\u4e2d\uff0c\u4e0e\u7ecf\u7406\u529e\u516c\u5ba4\u91cc\u7684\u4e00\u5e45\u7279\u5b9a\u7ed8\u753b\u4e92\u52a8\uff0c\u4f1a\u63ed\u793a\u4e00\u4e2a\u79d8\u5bc6\u901a\u9053\u3002\u8981\u53d1\u73b0\u8fd9\u4e9b\u5f69\u86cb\uff0c\u8bf7\u5f7b\u5e95\u63a2\u7d22\u6bcf\u4e2a\u5173\u5361\uff0c\u5e76\u4e0e\u770b\u4f3c\u666e\u901a\u7684\u7269\u54c1\u4e92\u52a8\u3002\u6ce8\u610f\u73af\u5883\u7ebf\u7d22\uff0c\u4f8b\u5982\u4e0d\u5bfb\u5e38\u7684\u6807\u8bb0\u6216\u4e0d\u5408\u9002\u7684\u7269\u54c1\uff0c\u8fd9\u4e9b\u7ebf\u7d22\u901a\u5e38\u6697\u793a\u9690\u85cf\u7684\u5185\u5bb9\u3002\u4e0e\u793e\u533a\u5408\u4f5c\u4e5f\u53ef\u4ee5\u63d0\u4f9b\u6709\u5173\u5b9a\u4f4d\u8fd9\u4e9b\u79d8\u5bc6\u7684\u6709\u4ef7\u503c\u7684\u89c1\u89e3\u3002"}, {"question": "\u300a\u94f6\u884c\u62a2\u52ab\u300b\u4e2d\u8b66\u536b\u7684 AI \u884c\u4e3a\u5982\u4f55\u5f71\u54cd\u6211\u7684\u62a2\u52ab\u8ba1\u5212\uff0c\u4ee5\u53ca\u5982\u4f55\u9884\u6d4b\u4ed6\u4eec\u7684\u884c\u52a8\uff1f", "answer": "\u300a\u94f6\u884c\u62a2\u52ab\u300b\u4e2d\u8b66\u536b\u7684 AI \u884c\u4e3a\u4f1a\u663e\u8457\u5730\u5f71\u54cd\u62a2\u52ab\u8ba1\u5212\uff0c\u56e0\u4e3a\u4ed6\u4eec\u4f1a\u9075\u5faa\u53ef\u9884\u6d4b\u7684\u5de1\u903b\u8def\u7ebf\u5e76\u5bf9\u5e72\u6270\u505a\u51fa\u53cd\u5e94\u3002\u8981\u9884\u6d4b\u4ed6\u4eec\u7684\u884c\u52a8\uff0c\u8bf7\u5728\u4fa6\u5bdf\u9636\u6bb5\u89c2\u5bdf\u4ed6\u4eec\u7684\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5de5\u4e1a\u94f6\u884c\u201d\u4efb\u52a1\u4e2d\uff0c\u8b66\u536b\u6709\u7279\u5b9a\u7684\u5de1\u903b\u5468\u671f\uff0c\u53ef\u4ee5\u5229\u7528\u8fd9\u4e9b\u5468\u671f\u6765\u521b\u9020\u884c\u52a8\u7684\u5b89\u5168\u7a97\u53e3\u3002\u4f7f\u7528\u5e72\u6270\u63aa\u65bd\u6765\u64cd\u7eb5\u4ed6\u4eec\u7684\u8def\u5f84\uff0c\u5e76\u59cb\u7ec8\u62e5\u6709\u5e94\u5bf9\u65b9\u6848\uff0c\u4ee5\u9632\u4ed6\u4eec\u504f\u79bb\u60ef\u5e38\u7684\u8def\u7ebf\u3002"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u8fd0\u884c\u300a\u94f6\u884c\u62a2\u52ab\u300b\u7684\u6280\u672f\u8981\u6c42\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5982\u4f55\u786e\u4fdd\u6d41\u7545\u7684\u6027\u80fd\uff1f", "answer": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u6d41\u7545\u8fd0\u884c\u300a\u94f6\u884c\u62a2\u52ab\u300b\u9700\u8981\u6ee1\u8db3\u6e38\u620f\u7684\u6280\u672f\u8981\u6c42\u3002\u5bf9\u4e8e PC\uff0c\u786e\u4fdd\u60a8\u7684\u7cfb\u7edf\u81f3\u5c11\u5177\u6709\u82f1\u7279\u5c14 i5 \u5904\u7406\u5668\u30018GB \u5185\u5b58\u548c GTX 970 \u56fe\u5f62\u5361\u3002\u5bf9\u4e8e\u6e38\u620f\u673a\uff0c\u8bf7\u68c0\u67e5\u6700\u65b0\u7684\u7cfb\u7edf\u66f4\u65b0\u3002\u4e3a\u4e86\u4f18\u5316\u6027\u80fd\uff0c\u5982\u679c\u51fa\u73b0\u5ef6\u8fdf\uff0c\u8bf7\u964d\u4f4e\u56fe\u5f62\u8bbe\u7f6e\uff0c\u5e76\u5173\u95ed\u540e\u53f0\u5e94\u7528\u7a0b\u5e8f\u3002\u5b9a\u671f\u66f4\u65b0\u60a8\u7684\u9a71\u52a8\u7a0b\u5e8f\u548c\u6e38\u620f\u672c\u8eab\u4e5f\u53ef\u4ee5\u63d0\u9ad8\u6027\u80fd\u3002\u5c06\u60a8\u7684\u7cfb\u7edf\u89c4\u683c\u4e0e\u6e38\u620f\u7684\u9700\u6c42\u8fdb\u884c\u6bd4\u8f83\uff0c\u4ee5\u786e\u4fdd\u517c\u5bb9\u6027\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u94f6\u884c\u62a2\u52ab\u300b\u4e2d\u5c06\u6211\u7684\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u5e73\u53f0\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u5e73\u53f0\uff0c\u4ee5\u53ca\u5728\u8be5\u8fc7\u7a0b\u4e2d\u9700\u8981\u6ce8\u610f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300a\u94f6\u884c\u62a2\u52ab\u300b\u4e2d\u5c06\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u5e73\u53f0\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u5e73\u53f0\uff0c\u9700\u8981\u5c06\u60a8\u7684\u6e38\u620f\u8d26\u6237\u94fe\u63a5\u5230\u901a\u7528\u914d\u7f6e\u6587\u4ef6\uff0c\u4f8b\u5982\u60a8\u7684 Steam \u6216 Epic Games \u8d26\u6237\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4ece PC \u79fb\u52a8\u5230\u6e38\u620f\u673a\uff0c\u8bf7\u786e\u4fdd\u4e24\u4e2a\u5e73\u53f0\u90fd\u652f\u6301\u8de8\u5e73\u53f0\u8fdb\u5ea6\u3002\u5728\u8f6c\u79fb\u8fc7\u7a0b\u4e2d\uff0c\u5907\u4efd\u60a8\u7684\u5b58\u6863\u6587\u4ef6\u4ee5\u907f\u514d\u6570\u636e\u4e22\u5931\u3002\u8bf7\u6ce8\u610f\uff0c\u67d0\u4e9b\u5e73\u53f0\u7279\u5b9a\u7684\u6210\u5c31\u6216\u7269\u54c1\u53ef\u80fd\u65e0\u6cd5\u8f6c\u79fb\uff0c\u56e0\u6b64\u8bf7\u4e8b\u5148\u67e5\u770b\u6e38\u620f\u7684\u8de8\u5e73\u53f0\u7b56\u7565\u3002"}]
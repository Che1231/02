[{"question": "\u65b0\u624b\u5982\u4f55\u5feb\u901f\u4e86\u89e3\u300a\u9280\u884c\u6436\u52ab\u6848\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1\u300a\u9280\u884c\u6436\u52ab\u6848\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u8acb\u5148\u719f\u6089\u79fb\u52d5\u9375\uff08WASD\uff09\u548c\u4e92\u52d5\u9375\uff08E\uff09\u3002\u4f8b\u5982\uff0c\u8981\u6253\u958b\u4fdd\u96aa\u7bb1\uff0c\u9760\u8fd1\u5b83\u4e26\u6309\u4e0bE\u9375\u3002\u5728\u6559\u5b78\u95dc\u5361\u7df4\u7fd2\u9019\u4e9b\u64cd\u4f5c\uff0c\u90a3\u88e1\u63d0\u4f9b\u4e86\u4e00\u500b\u5b89\u5168\u7684\u74b0\u5883\u8b93\u4f60\u5be6\u9a57\u3002\u6b64\u5916\uff0c\u4f7f\u7528\u904a\u6232\u63a7\u5236\u8a2d\u5b9a\u81ea\u8a02\u9375\u76e4\u5feb\u6377\u9375\u4ee5\u7b26\u5408\u4f60\u7684\u559c\u597d\u3002\u4e00\u500b\u6709\u7528\u7684\u6280\u5de7\u662f\uff0c\u5728\u4f60\u7684\u521d\u59cb\u904a\u6232\u904e\u7a0b\u4e2d\uff0c\u5c07\u63a7\u5236\u53c3\u8003\u5361\u96a8\u6642\u651c\u5e36\u5728\u8eab\u908a\u3002"}, {"question": "\u5728\u300a\u9280\u884c\u6436\u52ab\u6848\u300b\u4e2d\uff0c\u6210\u529f\u5b8c\u6210\u6436\u52ab\u7684\u5fc5\u8981\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u300a\u9280\u884c\u6436\u52ab\u6848\u300b\u4e2d\u6210\u529f\u5b8c\u6210\u6436\u52ab\u9700\u8981\u4ed4\u7d30\u7684\u7b56\u5283\u548c\u57f7\u884c\u3002\u6b65\u9a5f\u4e00\uff1a\u5075\u5bdf\u9280\u884c\u4f48\u5c40\uff0c\u8b58\u5225\u76e3\u8996\u5668\u548c\u8b66\u885b\u5de1\u908f\u8def\u7dda\u3002\u6b65\u9a5f\u4e8c\uff1a\u7528\u5408\u9069\u7684\u5de5\u5177\uff0c\u4f8b\u5982\u958b\u9396\u5de5\u5177\u548c\u6d88\u97f3\u6b66\u5668\uff0c\u88dd\u5099\u4f60\u7684\u5718\u968a\uff0c\u4ee5\u907f\u514d\u88ab\u5075\u6e2c\u5230\u3002\u6b65\u9a5f\u4e09\uff1a\u8207\u4f60\u7684\u5718\u968a\u5354\u8abf\uff0c\u540c\u6642\u95dc\u9589\u8b66\u5831\u4e26\u78ba\u4fdd\u4fdd\u96aa\u7bb1\u5b89\u5168\u3002\u4f8b\u5982\uff0c\u5728\u300c\u5e02\u4e2d\u5fc3\u9280\u884c\u300d\u4efb\u52d9\u4e2d\uff0c\u4f7f\u4f60\u7684\u884c\u52d5\u8207\u8b66\u885b\u63db\u73ed\u6642\u9593\u540c\u6b65\u53ef\u4ee5\u986f\u8457\u964d\u4f4e\u88ab\u5075\u6e2c\u7684\u98a8\u96aa\u3002\u52d9\u5fc5\u6e96\u5099\u597d\u9003\u751f\u8a08\u5283\uff0c\u4e26\u78ba\u4fdd\u6240\u6709\u5718\u968a\u6210\u54e1\u90fd\u4e86\u89e3\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u5728\u300a\u9280\u884c\u6436\u52ab\u6848\u300b\u4e2d\u7ba1\u7406\u5718\u968a\u6280\u80fd\u5f88\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u512a\u5316\u5b83\u5011\uff1f", "answer": "\u5728\u300a\u9280\u884c\u6436\u52ab\u6848\u300b\u4e2d\u7ba1\u7406\u5718\u968a\u6280\u80fd\u5c0d\u65bc\u514b\u670d\u5404\u7a2e\u6311\u6230\u81f3\u95dc\u91cd\u8981\u3002\u6bcf\u500b\u5718\u968a\u6210\u54e1\u90fd\u64c1\u6709\u7368\u7279\u7684\u6280\u80fd\uff0c\u53ef\u4ee5\u91dd\u5c0d\u7279\u5b9a\u89d2\u8272\u9032\u884c\u512a\u5316\u3002\u4f8b\u5982\uff0c\u99ed\u5ba2\u53ef\u4ee5\u66f4\u5feb\u5730\u95dc\u9589\u5b89\u5168\u7cfb\u7d71\uff0c\u800c\u958b\u9396\u8005\u53ef\u4ee5\u66f4\u6709\u6548\u5730\u6253\u958b\u4fdd\u96aa\u7bb1\u3002\u8981\u512a\u5316\u6280\u80fd\uff0c\u8acb\u6839\u64da\u6bcf\u500b\u6210\u54e1\u7684\u512a\u52e2\u5206\u914d\u89d2\u8272\uff0c\u4e26\u4f7f\u7528\u5f9e\u6210\u529f\u6436\u52ab\u4e2d\u7372\u5f97\u7684\u6280\u80fd\u9ede\u4f86\u5347\u7d1a\u4ed6\u5011\u7684\u6280\u80fd\u3002\u4e00\u500b\u6280\u80fd\u4e92\u88dc\u7684\u5e73\u8861\u5718\u968a\u63d0\u9ad8\u6210\u529f\u6436\u52ab\u7684\u6a5f\u7387\u3002"}, {"question": "\u300a\u9280\u884c\u6436\u52ab\u6848\u300b\u4e2d\u7684\u6f5b\u884c\u6a5f\u5236\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f\u4fdd\u6301\u4e0d\u88ab\u5075\u6e2c\u5230\u7684\u6700\u4f73\u505a\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "\u300a\u9280\u884c\u6436\u52ab\u6848\u300b\u7684\u6f5b\u884c\u6a5f\u5236\u4f9d\u8cf4\u65bc\u907f\u514d\u8207\u8b66\u885b\u7684\u8996\u7dda\u63a5\u89f8\uff0c\u4e26\u5c07\u566a\u97f3\u964d\u5230\u6700\u4f4e\u3002\u8981\u4fdd\u6301\u4e0d\u88ab\u5075\u6e2c\u5230\uff0c\u8acb\u5f85\u5728\u9670\u5f71\u4e2d\uff0c\u5fc5\u8981\u6642\u4f7f\u7528\u6d88\u97f3\u6b66\u5668\u3002\u4f8b\u5982\uff0c\u5728\u300c\u90ca\u5340\u9280\u884c\u300d\u4efb\u52d9\u4e2d\uff0c\u4f7f\u7528\u901a\u98a8\u7ba1\u9053\u7e5e\u904e\u91cd\u5175\u9632\u5b88\u5340\u57df\u975e\u5e38\u6709\u6548\u3002\u6b64\u5916\uff0c\u59cb\u7d42\u6ce8\u610f\u4f60\u7684\u5468\u570d\u74b0\u5883\uff0c\u4e26\u4f7f\u7528\u5206\u6563\u6ce8\u610f\u529b\u7684\u65b9\u6cd5\uff0c\u4f8b\u5982\u6295\u64f2\u7269\u54c1\uff0c\u4ee5\u8f49\u79fb\u8b66\u885b\u7684\u6ce8\u610f\u529b\u3002\u5728\u98a8\u96aa\u8f03\u4f4e\u7684\u4efb\u52d9\u4e2d\u7df4\u7fd2\u9019\u4e9b\u6280\u5de7\uff0c\u5efa\u7acb\u4fe1\u5fc3\u3002"}, {"question": "\u300a\u9280\u884c\u6436\u52ab\u6848\u300b\u7684\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f\u6211\u61c9\u8a72\u5982\u4f55\u6839\u64da\u9019\u4e9b\u5dee\u7570\u8abf\u6574\u7b56\u7565\uff1f", "answer": "\u300a\u9280\u884c\u6436\u52ab\u6848\u300b\u7684\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u5728\u65bc\u5354\u8abf\u7684\u7a0b\u5ea6\u548c\u4efb\u52d9\u7684\u8907\u96dc\u6027\u3002\u5728\u55ae\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f60\u5fc5\u9808\u81ea\u5df1\u8655\u7406\u6240\u6709\u89d2\u8272\uff0c\u9700\u8981\u66f4\u8b39\u614e\u7684\u7b56\u7565\u3002\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u5718\u968a\u5408\u4f5c\u81f3\u95dc\u91cd\u8981\uff0c\u6e9d\u901a\u662f\u95dc\u9375\u3002\u4f8b\u5982\uff0c\u5728\u300c\u5e02\u4e2d\u5fc3\u9280\u884c\u300d\u4efb\u52d9\u4e2d\uff0c\u8207\u5718\u968a\u6210\u54e1\u5354\u8abf\u540c\u6642\u95dc\u9589\u8b66\u5831\u4e26\u78ba\u4fdd\u4fdd\u96aa\u7bb1\u5b89\u5168\uff0c\u53ef\u4ee5\u8b93\u6436\u52ab\u66f4\u52a0\u9806\u5229\u3002\u900f\u904e\u70ba\u6bcf\u500b\u5718\u968a\u6210\u54e1\u5206\u914d\u7279\u5b9a\u89d2\u8272\uff0c\u4e26\u5728\u98a8\u96aa\u8f03\u4f4e\u7684\u4efb\u52d9\u4e2d\u7df4\u7fd2\u5354\u8abf\uff0c\u4f86\u8abf\u6574\u4f60\u7684\u7b56\u7565\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u9280\u884c\u6436\u52ab\u6848\u300b\u4e2d\u6709\u6548\u5229\u7528\u904a\u6232\u7d93\u6fdf\u7cfb\u7d71\u4f86\u6700\u5927\u5316\u8cc7\u6e90\uff1f", "answer": "\u5728\u300a\u9280\u884c\u6436\u52ab\u6848\u300b\u4e2d\u6709\u6548\u5229\u7528\u904a\u6232\u7d93\u6fdf\u7cfb\u7d71\u9700\u8981\u5e73\u8861\u4f60\u7684\u652f\u51fa\u548c\u6536\u5165\u3002\u512a\u5148\u8003\u616e\u5fc5\u8981\u7684\u5347\u7d1a\uff0c\u4f8b\u5982\u66f4\u597d\u7684\u5de5\u5177\u548c\u6b66\u5668\uff0c\u800c\u4e0d\u662f\u88dd\u98fe\u54c1\u3002\u4f8b\u5982\uff0c\u53ca\u65e9\u6295\u8cc7\u9ad8\u54c1\u8cea\u958b\u9396\u5de5\u5177\uff0c\u53ef\u4ee5\u5728\u6436\u52ab\u904e\u7a0b\u4e2d\u7bc0\u7701\u6642\u9593\u4e26\u964d\u4f4e\u98a8\u96aa\u3002\u6b64\u5916\uff0c\u5b8c\u6210\u652f\u7dda\u4efb\u52d9\u548c\u6311\u6230\u4ee5\u8cfa\u53d6\u984d\u5916\u73fe\u91d1\u548c\u8cc7\u6e90\u3002\u6839\u64da\u5373\u5c07\u767c\u751f\u7684\u6436\u52ab\u8a08\u5283\u4f60\u7684\u63a1\u8cfc\uff0c\u78ba\u4fdd\u64c1\u6709\u5fc5\u8981\u7684\u88dd\u5099\u3002"}, {"question": "\u300a\u9280\u884c\u6436\u52ab\u6848\u300b\u4e2d\u96b1\u85cf\u7684\u5f69\u86cb\u662f\u4ec0\u9ebc\uff1f\u5982\u4f55\u767c\u73fe\u5b83\u5011\uff1f", "answer": "\u300a\u9280\u884c\u6436\u52ab\u6848\u300b\u5145\u6eff\u4e86\u96b1\u85cf\u5f69\u86cb\uff0c\u734e\u52f5\u597d\u5947\u7684\u73a9\u5bb6\u3002\u4f8b\u5982\uff0c\u5728\u300c\u6b77\u53f2\u9280\u884c\u300d\u4efb\u52d9\u4e2d\uff0c\u8207\u7d93\u7406\u8fa6\u516c\u5ba4\u7684\u7279\u5b9a\u756b\u4f5c\u4e92\u52d5\uff0c\u6703\u767c\u73fe\u4e00\u689d\u79d8\u5bc6\u901a\u9053\u3002\u8981\u767c\u73fe\u9019\u4e9b\u5f69\u86cb\uff0c\u8acb\u5fb9\u5e95\u63a2\u7d22\u6bcf\u500b\u5340\u57df\uff0c\u4e26\u8207\u770b\u4f3c\u666e\u901a\u7684\u7269\u54c1\u4e92\u52d5\u3002\u95dc\u6ce8\u74b0\u5883\u63d0\u793a\uff0c\u4f8b\u5982\u4e0d\u5c0b\u5e38\u7684\u6a19\u8a18\u6216\u4e0d\u5354\u8abf\u7684\u7269\u54c1\uff0c\u9019\u4e9b\u901a\u5e38\u6697\u793a\u96b1\u85cf\u7684\u5167\u5bb9\u3002\u8207\u793e\u7fa4\u5408\u4f5c\u4e5f\u53ef\u4ee5\u63d0\u4f9b\u6709\u95dc\u5982\u4f55\u627e\u5230\u9019\u4e9b\u79d8\u5bc6\u7684\u5bf6\u8cb4\u8cc7\u8a0a\u3002"}, {"question": "\u300a\u9280\u884c\u6436\u52ab\u6848\u300b\u4e2d\u8b66\u885b\u7684AI\u884c\u70ba\u5982\u4f55\u5f71\u97ff\u6211\u7684\u6436\u52ab\u8a08\u756b\uff1f\u5982\u4f55\u9810\u6e2c\u4ed6\u5011\u7684\u884c\u52d5\uff1f", "answer": "\u300a\u9280\u884c\u6436\u52ab\u6848\u300b\u4e2d\u8b66\u885b\u7684AI\u884c\u70ba\u6703\u986f\u8457\u5f71\u97ff\u6436\u52ab\u8a08\u5283\uff0c\u56e0\u70ba\u4ed6\u5011\u9075\u5faa\u53ef\u9810\u6e2c\u7684\u5de1\u908f\u8def\u7dda\uff0c\u4e26\u5c0d\u5e72\u64fe\u505a\u51fa\u53cd\u61c9\u3002\u8981\u9810\u6e2c\u4ed6\u5011\u7684\u884c\u52d5\uff0c\u8acb\u5728\u5075\u5bdf\u968e\u6bb5\u89c0\u5bdf\u4ed6\u5011\u7684\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u5728\u300c\u5de5\u696d\u9280\u884c\u300d\u4efb\u52d9\u4e2d\uff0c\u8b66\u885b\u6709\u7279\u5b9a\u7684\u5de1\u908f\u5faa\u74b0\uff0c\u53ef\u4ee5\u5229\u7528\u9019\u4e9b\u5faa\u74b0\u5275\u9020\u5b89\u5168\u7684\u884c\u52d5\u6642\u9593\u3002\u4f7f\u7528\u5e72\u64fe\u4f86\u64cd\u7e31\u4ed6\u5011\u7684\u8def\u7dda\uff0c\u4e26\u59cb\u7d42\u6e96\u5099\u5099\u7528\u8a08\u5283\uff0c\u4ee5\u9632\u4ed6\u5011\u504f\u96e2\u5e73\u5e38\u7684\u8def\u7dda\u3002"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u904b\u884c\u300a\u9280\u884c\u6436\u52ab\u6848\u300b\u7684\u6280\u8853\u9700\u6c42\u662f\u4ec0\u9ebc\uff1f\u5982\u4f55\u78ba\u4fdd\u9806\u66a2\u7684\u6027\u80fd\uff1f", "answer": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u9806\u5229\u904b\u4f5c\u300a\u9280\u884c\u6436\u52ab\u6848\u300b\u9700\u8981\u6eff\u8db3\u904a\u6232\u7684\u6280\u8853\u8981\u6c42\u3002\u5c0d\u65bcPC\uff0c\u8acb\u78ba\u4fdd\u4f60\u7684\u7cfb\u7d71\u81f3\u5c11\u914d\u5099\u82f1\u7279\u723ei5\u8655\u7406\u5668\u30018GB\u8a18\u61b6\u9ad4\u548cGTX 970\u986f\u793a\u5361\u3002\u5c0d\u65bc\u4e3b\u6a5f\uff0c\u8acb\u6aa2\u67e5\u6700\u65b0\u7684\u7cfb\u7d71\u66f4\u65b0\u3002\u82e5\u6709\u5ef6\u9072\u554f\u984c\uff0c\u8acb\u964d\u4f4e\u5716\u5f62\u8a2d\u5b9a\uff0c\u4e26\u95dc\u9589\u80cc\u666f\u61c9\u7528\u7a0b\u5f0f\u4ee5\u512a\u5316\u6548\u80fd\u3002\u5b9a\u671f\u66f4\u65b0\u9a45\u52d5\u7a0b\u5f0f\u548c\u904a\u6232\u672c\u8eab\u4e5f\u80fd\u589e\u5f37\u6548\u80fd\u3002\u5c07\u4f60\u7684\u7cfb\u7d71\u898f\u683c\u8207\u904a\u6232\u8981\u6c42\u9032\u884c\u6bd4\u8f03\uff0c\u78ba\u4fdd\u76f8\u5bb9\u6027\u3002"}, {"question": "\u5982\u4f55\u5c07\u6211\u5728\u300a\u9280\u884c\u6436\u52ab\u6848\u300b\u4e2d\u7684\u9032\u5ea6\u5f9e\u4e00\u500b\u5e73\u53f0\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u5e73\u53f0\uff1f\u5728\u904e\u7a0b\u4e2d\u9700\u8981\u6ce8\u610f\u4ec0\u9ebc\uff1f", "answer": "\u5c07\u4f60\u5728\u300a\u9280\u884c\u6436\u52ab\u6848\u300b\u4e2d\u7684\u9032\u5ea6\u5f9e\u4e00\u500b\u5e73\u53f0\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u5e73\u53f0\uff0c\u9700\u8981\u5c07\u4f60\u7684\u904a\u6232\u5e33\u6236\u9023\u7d50\u5230\u901a\u7528\u500b\u4eba\u6a94\u6848\uff0c\u4f8b\u5982\u4f60\u7684Steam\u6216Epic Games\u5e33\u6236\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5f9ePC\u8f49\u79fb\u5230\u4e3b\u6a5f\uff0c\u8acb\u78ba\u4fdd\u5169\u500b\u5e73\u53f0\u652f\u63f4\u8de8\u5e73\u53f0\u9032\u5ea6\u3002\u5728\u8f49\u79fb\u904e\u7a0b\u4e2d\uff0c\u5099\u4efd\u4f60\u7684\u5132\u5b58\u6a94\u4ee5\u907f\u514d\u8cc7\u6599\u907a\u5931\u3002\u8acb\u6ce8\u610f\uff0c\u6709\u4e9b\u7279\u5b9a\u65bc\u5e73\u53f0\u7684\u6210\u5c31\u6216\u7269\u54c1\u53ef\u80fd\u7121\u6cd5\u8f49\u79fb\uff0c\u56e0\u6b64\u8acb\u4e8b\u5148\u5be9\u95b1\u904a\u6232\u7684\u8de8\u5e73\u53f0\u653f\u7b56\u3002"}]
[{"question": "\ucd08\uc2ec\uc790\uac00 Merge & Construct \uac8c\uc784\uc744 \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Merge & Construct \uac8c\uc784\uc744 \uc2dc\uc791\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1 - \uc6d0\ud558\ub294 \uc571 \uc2a4\ud1a0\uc5b4\uc5d0\uc11c \uac8c\uc784\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uace0 \uc124\uce58\ud569\ub2c8\ub2e4. STEP2 - \ubcd1\ud569 \ubc0f \uac74\ucd95\uc758 \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\uae30 \uc704\ud574 \ud29c\ud1a0\ub9ac\uc5bc\uc744 \uc644\ub8cc\ud569\ub2c8\ub2e4. STEP3 - \ub450 \uac1c\uc758 \ub808\ubca8 1 \uc544\uc774\ud15c\uc744 \uacb0\ud569\ud558\uc5ec \ub808\ubca8 2 \uc544\uc774\ud15c\uc744 \ub9cc\ub4dc\ub294 \uac83\uacfc \uac19\uc740 \uac04\ub2e8\ud55c \ubcd1\ud569\ubd80\ud130 \uc2dc\uc791\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub450 \uac1c\uc758 \ub808\ubca8 1 \ub098\ubb34\ud1a0\ub9c9\uc744 \ubcd1\ud569\ud558\uba74 \ub808\ubca8 2 \ud310\uc790\uac00 \uc0dd\uc131\ub429\ub2c8\ub2e4. \uc774 \uae30\ubcf8\uc801\uc778 \uc811\uadfc \ubc29\uc2dd\uc740 \ud575\uc2ec \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ube60\ub974\uac8c \uc774\ud574\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ubcd1\ud569\uc740 \ube14\ub85d\uc744 \uc313\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4; \uac01 \ubcd1\ud569\uc740 \uac74\uc124\uc5d0 \uc0c8\ub85c\uc6b4 \uce35\uc744 \ucd94\uac00\ud569\ub2c8\ub2e4.]"}, {"question": "Merge & Construct\uc5d0\uc11c \uc790\uc6d0 \uad00\ub9ac\ub97c \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Merge & Construct\uc5d0\uc11c \ud6a8\uacfc\uc801\uc778 \uc790\uc6d0 \uad00\ub9ac\ub97c \uc704\ud574 \ub2e4\uc74c\uacfc \uac19\uc774 \ud558\uc2ed\uc2dc\uc624: STEP1 - \ub354 \ub192\uc740 \ub808\ubca8\uc758 \uc790\uc6d0\uc744 \uc0dd\uc131\ud558\ub294 \uc544\uc774\ud15c \ubcd1\ud569\uc744 \uc6b0\uc120\uc2dc\ud569\ub2c8\ub2e4. STEP2 - \ud544\uc218 \uc544\uc774\ud15c\ub9cc \ubcf4\uad00\ud558\uc5ec \uc800\uc7a5 \uacf5\uac04\uc744 \ud604\uba85\ud558\uac8c \ud560\ub2f9\ud569\ub2c8\ub2e4. STEP3 - \uc815\uae30\uc801\uc73c\ub85c \uc778\ubca4\ud1a0\ub9ac\ub97c \ud655\uc778\ud558\uc5ec \ubd88\ud544\uc694\ud55c \ubb3c\uac74\uc744 \uc81c\uac70\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc138 \uac1c\uc758 \ub808\ubca8 2 \ud310\uc790\ub97c \ubcd1\ud569\ud558\uba74 \ub808\ubca8 3 \ub098\ubb34\ubcf4\uac15\uc7ac\uac00 \uc0dd\uc131\ub418\ub294\ub370, \uc774\ub294 \ub354 \uac00\uce58 \uc788\ub294 \uc790\uc6d0\uc785\ub2c8\ub2e4. [\ub2e4\uc911 \uc804\ub7b5 \ube44\uad50: \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\ub294 \uc790\uc6d0\uc744 \ube44\ucd95\ud558\ub294 \uac83\uc744 \uc120\ud638\ud558\uc9c0\ub9cc, \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub294 \uc989\uac01\uc801\uc778 \ubcd1\ud569\uc5d0 \uc9d1\uc911\ud569\ub2c8\ub2e4. \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\ub294 \uade0\ud615\uc744 \ucc3e\uc73c\uc2ed\uc2dc\uc624.]"}, {"question": "Merge & Construct\uc5d0\uc11c \ud2b9\uc815 \uc544\uc774\ud15c \ubcd1\ud569\uc5d0 \uc9d1\uc911\ud574\uc57c \ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Merge & Construct\uc5d0\uc11c \ud2b9\uc815 \uc544\uc774\ud15c\uc5d0 \uc9d1\uc911\ud558\uba74 \uc9c4\ud589 \uc0c1\ud669\uc774 \ud06c\uac8c \ud5a5\uc0c1\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc138 \uac1c\uc758 \ub808\ubca8 3 \ub098\ubb34\ubcf4\uac15\uc7ac\ub97c \ubcd1\ud569\ud558\uba74 \ub808\ubca8 4 \uc9c0\uc9c0\ub300\uac00 \uc0dd\uc131\ub418\ub294\ub370, \uc774\ub294 \uace0\uae09 \uad6c\uc870\ubb3c \uac74\uc124\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc9d1\uc911\uc801\uc778 \ubcd1\ud569\uc740 \uc790\uc6d0\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\uace0 \ub354 \ub192\uc740 \ub808\ubca8\uc758 \uac74\uc124\uc744 \ub354 \ube60\ub974\uac8c \ub2ec\uc131\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc774\ub294 \uc9d1\uc911 \ud22c\uc790\uc640 \uac19\uc2b5\ub2c8\ub2e4; \ud2b9\uc815 \uc544\uc774\ud15c \ubcd1\ud569\uc740 \uace0\uc218\uc775 \uc8fc\uc2dd\uc5d0 \ud22c\uc790\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "Merge & Construct\uc5d0\uc11c \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uac00\uc7a5 \uc720\uc775\ud55c \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Merge & Construct\uc5d0\uc11c \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uac00\uc7a5 \uc720\uc775\ud55c \uac83\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4 : STEP1 - \uc5ec\ub7ec \uc544\uc774\ud15c\uc744 \ube60\ub974\uac8c \ubcd1\ud569\ud560 \uc218 \uc788\ub294 \uc790\ub3d9 \ubcd1\ud569 \uae30\ub2a5. STEP2 - \uc790\uc138\ud55c \uac74\uc124 \uacc4\ud68d\uc744 \uc81c\uacf5\ud558\ub294 \uccad\uc0ac\uc9c4 \uc2dc\uc2a4\ud15c. STEP3 - \ud2b9\uc815 \uc791\uc5c5\uc744 \uc644\ub8cc\ud558\uba74 \ub3c5\ud2b9\ud55c \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud558\ub294 \uc774\ubca4\ud2b8 \uc2dc\uc2a4\ud15c. \uc608\ub97c \ub4e4\uc5b4, \uccad\uc0ac\uc9c4 \uc2dc\uc2a4\ud15c\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub808\ubca8 5 \ub2e4\ub9ac\ub97c \uac74\uc124\ud558\uba74 \uc0c8\ub85c\uc6b4 \uc9c0\uc5ed\uc744 \uc5f4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \uc790\ub3d9 \ubcd1\ud569\uacfc \uc218\ub3d9 \ubcd1\ud569\uc758 \uc7a5\ub2e8\uc810\uc744 \ube44\uad50\ud558\uc5ec \uace0\uae09 \uc804\ub7b5\uc5d0 \uc801\ud569\ud55c \ubc29\uc2dd\uc744 \ud655\uc778\ud558\uc2ed\uc2dc\uc624.]"}, {"question": "Merge & Construct\uc5d0\uc11c \ubcd1\ud569 \uc2dc\uc2a4\ud15c\uc740 \uac8c\uc784 \uc9c4\ud589\uc5d0 \uc5b4\ub5a4 \uc5ed\ud560\uc744 \ud558\ub098\uc694?", "answer": "Merge & Construct\uc758 \ubcd1\ud569 \uc2dc\uc2a4\ud15c\uc740 \uac8c\uc784 \uc9c4\ud589\uc5d0 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uac01 \ubcd1\ud569\uc740 \uc544\uc774\ud15c \ub808\ubca8\uc744 \ub192\uc5ec \uc0c8\ub85c\uc6b4 \uac00\ub2a5\uc131\uc744 \uc5f4\uc5b4\uc90d\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub450 \uac1c\uc758 \ub808\ubca8 4 \uc9c0\uc9c0\ub300\ub97c \ubcd1\ud569\ud558\uba74 \ub808\ubca8 5 \uac15\ud654 \uc9c0\uc9c0\ub300\uac00 \uc0dd\uc131\ub418\ub294\ub370, \uc774\ub294 \ub354 \ud070 \uac74\ubb3c\uc744 \uac74\uc124\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \ub354 \ub192\uc740 \ub808\ubca8\uc758 \uc544\uc774\ud15c\uacfc \uad6c\uc870\ubb3c\uc744 \ud68d\ub4dd\ud568\uc73c\ub85c\uc368 \uc9c0\uc18d\uc801\uc73c\ub85c \uc9c4\ud589\ub418\ub3c4\ub85d \ud569\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \ub808\ubca8 1\uc5d0\uc11c \ub808\ubca8 5\uae4c\uc9c0\uc758 \ubcd1\ud569 \uc9c4\ud589 \uacfc\uc815\uc744 \uc2dc\uac01\ud654\ud558\uc5ec \ud750\ub984\uc744 \uc774\ud574\ud558\uc2ed\uc2dc\uc624.]"}, {"question": "Merge & Construct\uc758 \ubb34\ub8cc \ubc84\uc804\uacfc \ud504\ub9ac\ubbf8\uc5c4 \ubc84\uc804\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Merge & Construct\uc758 \ubb34\ub8cc \ubc84\uc804\uacfc \ud504\ub9ac\ubbf8\uc5c4 \ubc84\uc804\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: STEP1 - \ud504\ub9ac\ubbf8\uc5c4 \ubc84\uc804\uc5d0\uc11c \ub3c5\uc810 \uc544\uc774\ud15c\uacfc \uad6c\uc870\ubb3c\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP2 - \uad11\uace0\uac00 \uc81c\uac70\ub418\uc5b4 \uc6d0\ud65c\ud55c \uac8c\uc784 \ud658\uacbd\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. STEP3 - \ucd94\uac00 \uc800\uc7a5 \uacf5\uac04\uacfc \ub354 \ube60\ub978 \uc790\uc6d0 \uc7ac\uc0dd\uc774 \uc81c\uacf5\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud504\ub9ac\ubbf8\uc5c4 \ud50c\ub808\uc774\uc5b4\ub294 \ubb34\ub8cc \ubc84\uc804\uc5d0\uc11c\ub294 \uc0ac\uc6a9\ud560 \uc218 \uc5c6\ub294 \ub808\ubca8 6 \ud2f0\ud0c0\ub284 \ubcf4\uac15\uc7ac\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc911 \uc804\ub7b5 \ube44\uad50: \ubb34\ub8cc \ubc84\uc804\uacfc \ud504\ub9ac\ubbf8\uc5c4 \ubc84\uc804\uc758 \uc7a5\ub2e8\uc810\uc744 \ube44\uad50\ud558\uc5ec \uc790\uc2e0\uc5d0\uac8c \uc801\ud569\ud55c \ubc84\uc804\uc744 \uacb0\uc815\ud558\uc2ed\uc2dc\uc624.]"}, {"question": "Merge & Construct\uc5d0\uc11c \uac8c\uc784 \ub370\uc774\ud130\ub97c \uc0c8 \uae30\uae30\ub85c \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Merge & Construct\uc5d0\uc11c \uac8c\uc784 \ub370\uc774\ud130\ub97c \uc0c8 \uae30\uae30\ub85c \uc804\uc1a1\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1 - \uac8c\uc784\uc774 Google Play \ub610\ub294 Apple Game Center\uc640 \uac19\uc740 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uacc4\uc815\uc5d0 \uc5f0\uacb0\ub418\uc5b4 \uc788\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. STEP2 - \uc0c8 \uae30\uae30\uc5d0\uc11c Merge & Construct\ub97c \uc124\uce58\ud558\uace0 \ub3d9\uc77c\ud55c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. STEP3 - \ud074\ub77c\uc6b0\ub4dc\uc5d0\uc11c \uc800\uc7a5\ub41c \ub370\uc774\ud130\ub97c \ub85c\ub4dc\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 7 \uc2a4\uce74\uc774 \uc2a4\ud06c\ub798\ud37c\ub97c \uac74\uc124 \uc911\uc774\ub77c\uba74 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc720\uc9c0\ub429\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \uc548\ub4dc\ub85c\uc774\ub4dc\uc640 iOS \uae30\uae30\uc758 \ub2e8\uacc4\ub97c \ube44\uad50\ud558\uc5ec \uc6d0\ud65c\ud55c \ub370\uc774\ud130 \uc804\uc1a1\uc744 \ubcf4\uc7a5\ud558\uc2ed\uc2dc\uc624.]"}, {"question": "Merge & Construct\uc5d0\uc11c \uc5b4\ub5a4 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ubc1c\uacac\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Merge & Construct\uc5d0\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ub9ce\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud2b9\uc815 \ud328\ud134\uc73c\ub85c \uc138 \uac1c\uc758 \ub808\ubca8 5 \uac15\ud654 \uc9c0\uc9c0\ub300\ub97c \ubcd1\ud569\ud558\uba74 \ub3c5\ud2b9\ud55c \uad6c\uc870\ubb3c\uc5d0 \ub300\ud55c \uc228\uaca8\uc9c4 \uccad\uc0ac\uc9c4\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\uc591\ud55c \ubcd1\ud569 \uc870\ud569\uc744 \ud0d0\ud5d8\ud558\uace0 \uac8c\uc784 \ub0b4 \ubbf8\ubb18\ud55c \ud78c\ud2b8\uc5d0 \uc8fc\uc758\ud558\uba74 \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ubcf4\uc11d\uc744 \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc774\ubca4\ud2b8 \ucc3e\uae30: \ud2b9\uc774\ud55c \ubcd1\ud569 \ud328\ud134\uc774\ub098 \uac8c\uc784 \ub0b4 \ud78c\ud2b8\ub97c \ucc3e\uc544 \uc774\ub7ec\ud55c \ube44\ubc00\uc744 \ud30c\ud5e4\uce58\uc2ed\uc2dc\uc624.]"}, {"question": "Merge & Construct\uc758 \uc774\ubca4\ud2b8 \uc2dc\uc2a4\ud15c\uc740 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0a4\ub098\uc694?", "answer": "Merge & Construct\uc758 \uc774\ubca4\ud2b8 \uc2dc\uc2a4\ud15c\uc740 \ub3c5\ud2b9\ud55c \ucc4c\ub9b0\uc9c0\uc640 \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud568\uc73c\ub85c\uc368 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc8fc\ub9d0 \uc774\ubca4\ud2b8\uc5d0 \ucc38\uc5ec\ud558\ub824\uba74 \ud2b9\uc815 \uc2dc\uac04 \uc81c\ud55c \ub0b4\uc5d0 \ud2b9\uc815 \uad6c\uc870\ubb3c\uc744 \uac74\uc124\ud574\uc57c \ud558\ub294\ub370, \uc774\ub97c \ud1b5\ud574 \ud76c\uadc0\ud55c \uc544\uc774\ud15c\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \uac8c\uc784\uc5d0 \ub2e4\uc591\uc131\uacfc \ud765\ubd84\uc744 \ub354\ud558\uace0, \ud50c\ub808\uc774\uc5b4\uac00 \ub354 \uae4a\uc774 \ucc38\uc5ec\ud558\ub3c4\ub85d \ub3c5\ub824\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc774\ubca4\ud2b8\ub294 \uacc4\uc808 \ucd95\uc81c\uc640 \uac19\uc2b5\ub2c8\ub2e4; \uadf8\ub4e4\uc740 \uac8c\uc784\uc5d0 \uc0c8\ub85c\uc6b4 \ud65c\ub3d9\uacfc \ubcf4\uc0c1\uc744 \uac00\uc838\uc635\ub2c8\ub2e4.]"}, {"question": "Merge & Construct\uc5d0\uc11c \ucd5c\uc801\uc758 \uac74\uc124\uc744 \uc704\ud574 \uc5b4\ub5a4 \uc544\uc774\ud15c \ubcd1\ud569\uc744 \uc6b0\uc120\uc2dc\ud574\uc57c \ud558\ub098\uc694?", "answer": "Merge & Construct\uc5d0\uc11c \ucd5c\uc801\uc758 \uac74\uc124\uc744 \uc704\ud574 \ud604\uc7ac \uac74\uc124 \ud504\ub85c\uc81d\ud2b8\uc5d0 \ud544\uc218\uc801\uc778 \uc544\uc774\ud15c \ubcd1\ud569\uc744 \uc6b0\uc120\uc2dc\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc138 \uac1c\uc758 \ub808\ubca8 3 \ub098\ubb34\ubcf4\uac15\uc7ac\ub97c \ubcd1\ud569\ud558\uc5ec \ub808\ubca8 4 \uc9c0\uc9c0\ub300\ub97c \ub9cc\ub4dc\ub294 \uac83\uc740 \uc548\uc815\uc801\uc778 \uae30\ubc18\uc744 \uad6c\ucd95\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud575\uc2ec \uc544\uc774\ud15c\uc5d0 \uc9d1\uc911\ud558\uba74 \uac74\uc124\uc774 \ud6a8\uc728\uc801\uc774\uace0 \ud6a8\uacfc\uc801\uc73c\ub85c \uc774\ub8e8\uc5b4\uc9d1\ub2c8\ub2e4. [\ub2e4\uc911 \uc804\ub7b5 \ube44\uad50: \uc11c\ub85c \ub2e4\ub978 \uc544\uc774\ud15c\uc744 \ubcd1\ud569\ud558\ub294 \uc774\uc810\uc744 \ube44\uad50\ud558\uc5ec \ud504\ub85c\uc81d\ud2b8\uc5d0 \uac00\uc7a5 \uac00\uce58\uc788\ub294 \uc544\uc774\ud15c\uc744 \ud655\uc778\ud558\uc2ed\uc2dc\uc624.]"}]
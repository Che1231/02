[{"question": "\u5982\u4f55\u4f5c\u4e3a\u65b0\u624b\u5f00\u59cb\u73a9\u300a\u5408\u5e76\u4e0e\u5efa\u9020\u300b\uff1f", "answer": "\u8981\u5f00\u59cb\u73a9\u300a\u5408\u5e76\u4e0e\u5efa\u9020\u300b\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41-\u4ece\u60a8\u559c\u6b22\u7684\u5e94\u7528\u5546\u5e97\u4e0b\u8f7d\u5e76\u5b89\u88c5\u6e38\u620f\uff1b\u6b65\u9aa42-\u5b8c\u6210\u6559\u7a0b\u4ee5\u4e86\u89e3\u5408\u5e76\u548c\u5efa\u9020\u7684\u57fa\u672c\u673a\u5236\uff1b\u6b65\u9aa43-\u4ece\u7b80\u5355\u7684\u5408\u5e76\u5f00\u59cb\uff0c\u4f8b\u5982\u5c06\u4e24\u4e2a\u4e00\u7ea7\u7269\u54c1\u5408\u5e76\u6210\u4e8c\u7ea7\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5408\u5e76\u4e24\u4e2a\u4e00\u7ea7\u6728\u6750\u53ef\u4ee5\u521b\u5efa\u4e00\u4e2a\u4e8c\u7ea7\u6728\u677f\u3002\u8fd9\u79cd\u57fa\u7840\u65b9\u6cd5\u5c06\u5e2e\u52a9\u60a8\u5feb\u901f\u638c\u63e1\u6838\u5fc3\u6e38\u620f\u73a9\u6cd5\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u5408\u5e76\u60f3\u8c61\u6210\u79ef\u6728\uff1b\u6bcf\u6b21\u5408\u5e76\u90fd\u4f1a\u4e3a\u60a8\u7684\u5efa\u9020\u589e\u52a0\u4e00\u5c42\u65b0\u7684\u7ed3\u6784\u3002]"}, {"question": "\u5728\u300a\u5408\u5e76\u4e0e\u5efa\u9020\u300b\u4e2d\uff0c\u8d44\u6e90\u7ba1\u7406\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u5408\u5e76\u4e0e\u5efa\u9020\u300b\u4e2d\u6709\u6548\u7684\u8d44\u6e90\u7ba1\u7406\u5305\u62ec\uff1a\u6b65\u9aa41-\u4f18\u5148\u5408\u5e76\u80fd\u591f\u4ea7\u751f\u66f4\u9ad8\u7b49\u7ea7\u8d44\u6e90\u7684\u7269\u54c1\uff1b\u6b65\u9aa42-\u660e\u667a\u5730\u5206\u914d\u5b58\u50a8\u7a7a\u95f4\uff0c\u53ea\u4fdd\u7559\u5fc5\u8981\u7684\u7269\u54c1\uff1b\u6b65\u9aa43-\u5b9a\u671f\u68c0\u67e5\u60a8\u7684\u5e93\u5b58\uff0c\u907f\u514d\u6742\u4e71\u65e0\u7ae0\u3002\u4f8b\u5982\uff0c\u5408\u5e76\u4e09\u4e2a\u4e8c\u7ea7\u6728\u677f\u5c06\u521b\u5efa\u4e00\u4e2a\u4e09\u7ea7\u6728\u6881\uff0c\u5b83\u66f4\u6709\u4ef7\u503c\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u867d\u7136\u6709\u4e9b\u73a9\u5bb6\u559c\u6b22\u56e4\u79ef\u8d44\u6e90\uff0c\u4f46\u5176\u4ed6\u4eba\u5219\u4e13\u6ce8\u4e8e\u7acb\u5373\u5408\u5e76\uff1b\u627e\u5230\u9002\u5408\u60a8\u6e38\u620f\u98ce\u683c\u7684\u5e73\u8861\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u5e94\u8be5\u4e13\u6ce8\u4e8e\u5728\u300a\u5408\u5e76\u4e0e\u5efa\u9020\u300b\u4e2d\u5408\u5e76\u7279\u5b9a\u7269\u54c1\uff1f", "answer": "\u4e13\u6ce8\u4e8e\u300a\u5408\u5e76\u4e0e\u5efa\u9020\u300b\u4e2d\u7684\u7279\u5b9a\u7269\u54c1\u53ef\u4ee5\u663e\u8457\u63d0\u5347\u60a8\u7684\u6e38\u620f\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u5408\u5e76\u4e09\u4e2a\u4e09\u7ea7\u6728\u6881\u5c06\u521b\u5efa\u4e00\u4e2a\u56db\u7ea7\u652f\u6491\u6881\uff0c\u8fd9\u5bf9\u4e8e\u5efa\u9020\u9ad8\u7ea7\u7ed3\u6784\u81f3\u5173\u91cd\u8981\u3002\u8fd9\u79cd\u6709\u9488\u5bf9\u6027\u7684\u5408\u5e76\u6709\u52a9\u4e8e\u6709\u6548\u5730\u5229\u7528\u8d44\u6e90\u5e76\u66f4\u5feb\u5730\u5b9e\u73b0\u66f4\u9ad8\u7b49\u7ea7\u7684\u5efa\u9020\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u8fd9\u79cd\u60c5\u51b5\u89c6\u4e3a\u4e13\u6ce8\u7684\u6295\u8d44\uff1b\u5408\u5e76\u7279\u5b9a\u7269\u54c1\u5c31\u50cf\u6295\u8d44\u9ad8\u6536\u76ca\u80a1\u7968\u4e00\u6837\u3002]"}, {"question": "\u300a\u5408\u5e76\u4e0e\u5efa\u9020\u300b\u4e2d\u54ea\u4e9b\u6e38\u620f\u673a\u5236\u5bf9\u9ad8\u7ea7\u73a9\u5bb6\u6700\u6709\u5229\uff1f", "answer": "\u300a\u5408\u5e76\u4e0e\u5efa\u9020\u300b\u4e2d\u7684\u9ad8\u7ea7\u73a9\u5bb6\u6700\u53d7\u76ca\u4e8e\uff1a\u6b65\u9aa41-\u81ea\u52a8\u5408\u5e76\u529f\u80fd\uff0c\u5141\u8bb8\u5feb\u901f\u5408\u5e76\u591a\u4e2a\u7269\u54c1\uff1b\u6b65\u9aa42-\u84dd\u56fe\u7cfb\u7edf\uff0c\u63d0\u4f9b\u8be6\u7ec6\u7684\u5efa\u9020\u8ba1\u5212\uff1b\u6b65\u9aa43-\u4e8b\u4ef6\u7cfb\u7edf\uff0c\u4e3a\u5b8c\u6210\u7279\u5b9a\u4efb\u52a1\u63d0\u4f9b\u72ec\u7279\u7684\u5956\u52b1\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u84dd\u56fe\u7cfb\u7edf\u5efa\u9020\u4e94\u7ea7\u6865\u6881\u53ef\u4ee5\u89e3\u9501\u65b0\u7684\u533a\u57df\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6bd4\u8f83\u81ea\u52a8\u5408\u5e76\u4e0e\u624b\u52a8\u5408\u5e76\u7684\u597d\u5904\uff0c\u770b\u770b\u54ea\u79cd\u66f4\u9002\u5408\u60a8\u7684\u9ad8\u7ea7\u7b56\u7565\u3002]"}, {"question": "\u300a\u5408\u5e76\u4e0e\u5efa\u9020\u300b\u4e2d\u7684\u5408\u5e76\u7cfb\u7edf\u5728\u6e38\u620f\u8fdb\u5ea6\u65b9\u9762\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u300a\u5408\u5e76\u4e0e\u5efa\u9020\u300b\u4e2d\u7684\u5408\u5e76\u7cfb\u7edf\u5bf9\u4e8e\u6e38\u620f\u8fdb\u5ea6\u81f3\u5173\u91cd\u8981\u3002\u6bcf\u6b21\u5408\u5e76\u90fd\u4f1a\u63d0\u9ad8\u7269\u54c1\u7b49\u7ea7\uff0c\u89e3\u9501\u65b0\u7684\u53ef\u80fd\u6027\u3002\u4f8b\u5982\uff0c\u5408\u5e76\u4e24\u4e2a\u56db\u7ea7\u652f\u6491\u6881\u5c06\u521b\u5efa\u4e00\u4e2a\u4e94\u7ea7\u52a0\u56fa\u6881\uff0c\u5bf9\u4e8e\u5efa\u9020\u66f4\u5927\u7684\u5efa\u7b51\u7269\u81f3\u5173\u91cd\u8981\u3002\u6b64\u7cfb\u7edf\u786e\u4fdd\u73a9\u5bb6\u901a\u8fc7\u89e3\u9501\u66f4\u9ad8\u7b49\u7ea7\u7684\u7269\u54c1\u548c\u7ed3\u6784\u800c\u6301\u7eed\u8fdb\u6b65\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u53ef\u89c6\u5316\u4ece\u4e00\u7ea7\u5230\u4e94\u7ea7\u7684\u5408\u5e76\u8fdb\u5ea6\uff0c\u4ee5\u4e86\u89e3\u6d41\u7a0b\u3002]"}, {"question": "\u300a\u5408\u5e76\u4e0e\u5efa\u9020\u300b\u7684\u514d\u8d39\u7248\u548c\u9ad8\u7ea7\u7248\u4e4b\u95f4\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u300a\u5408\u5e76\u4e0e\u5efa\u9020\u300b\u7684\u514d\u8d39\u7248\u548c\u9ad8\u7ea7\u7248\u4e4b\u95f4\u7684\u5173\u952e\u533a\u522b\u5305\u62ec\uff1a\u6b65\u9aa41-\u9ad8\u7ea7\u7248\u4e2d\u53ef\u4ee5\u83b7\u5f97\u72ec\u5bb6\u7269\u54c1\u548c\u7ed3\u6784\uff1b\u6b65\u9aa42-\u79fb\u9664\u5e7f\u544a\uff0c\u63d0\u4f9b\u6d41\u7545\u7684\u6e38\u620f\u4f53\u9a8c\uff1b\u6b65\u9aa43- \u989d\u5916\u5b58\u50a8\u7a7a\u95f4\u548c\u66f4\u5feb\u7684\u8d44\u6e90\u518d\u751f\u3002\u4f8b\u5982\uff0c\u9ad8\u7ea7\u73a9\u5bb6\u53ef\u4ee5\u8bbf\u95ee\u516d\u7ea7\u949b\u6881\uff0c\u8fd9\u5728\u514d\u8d39\u7248\u4e2d\u4e0d\u53ef\u7528\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6bd4\u8f83\u514d\u8d39\u7248\u548c\u9ad8\u7ea7\u7248\u7684\u597d\u5904\uff0c\u4ee5\u51b3\u5b9a\u54ea\u4e2a\u7248\u672c\u66f4\u9002\u5408\u60a8\u7684\u9700\u6c42\u3002]"}, {"question": "\u5982\u4f55\u5728\u300a\u5408\u5e76\u4e0e\u5efa\u9020\u300b\u4e2d\u5c06\u6211\u7684\u6e38\u620f\u6570\u636e\u8f6c\u79fb\u5230\u65b0\u8bbe\u5907\uff1f", "answer": "\u8981\u5c06\u300a\u5408\u5e76\u4e0e\u5efa\u9020\u300b\u4e2d\u7684\u6e38\u620f\u6570\u636e\u8f6c\u79fb\u5230\u65b0\u8bbe\u5907\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41-\u786e\u4fdd\u60a8\u7684\u6e38\u620f\u5df2\u94fe\u63a5\u5230\u4e91\u4fdd\u5b58\u8d26\u53f7\uff0c\u4f8b\u5982 Google Play \u6216 Apple Game Center\uff1b\u6b65\u9aa42-\u5728\u65b0\u8bbe\u5907\u4e0a\u5b89\u88c5\u300a\u5408\u5e76\u4e0e\u5efa\u9020\u300b\uff0c\u5e76\u767b\u5f55\u540c\u4e00\u4e91\u4fdd\u5b58\u8d26\u53f7\uff1b\u6b65\u9aa43-\u4ece\u4e91\u7aef\u52a0\u8f7d\u60a8\u7684\u4fdd\u5b58\u6570\u636e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u6b63\u5728\u5efa\u9020\u4e03\u7ea7\u6469\u5929\u5927\u697c\uff0c\u60a8\u7684\u8fdb\u5ea6\u5c06\u5f97\u5230\u4fdd\u7559\u3002 [\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6bd4\u8f83 Android \u548c iOS \u8bbe\u5907\u7684\u6b65\u9aa4\uff0c\u4ee5\u786e\u4fdd\u5e73\u7a33\u7684\u8f6c\u79fb\u3002]"}, {"question": "\u5728\u300a\u5408\u5e76\u4e0e\u5efa\u9020\u300b\u4e2d\uff0c\u6211\u80fd\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "\u300a\u5408\u5e76\u4e0e\u5efa\u9020\u300b\u5145\u6ee1\u4e86\u9690\u85cf\u529f\u80fd\u548c\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u4ee5\u7279\u5b9a\u6a21\u5f0f\u5408\u5e76\u4e09\u4e2a\u4e94\u7ea7\u52a0\u56fa\u6881\u53ef\u4ee5\u89e3\u9501\u72ec\u7279\u7ed3\u6784\u7684\u9690\u85cf\u84dd\u56fe\u3002\u63a2\u7d22\u4e0d\u540c\u7684\u5408\u5e76\u7ec4\u5408\u5e76\u6ce8\u610f\u6e38\u620f\u4e2d\u7ec6\u5fae\u7684\u63d0\u793a\u53ef\u4ee5\u5e2e\u52a9\u53d1\u73b0\u8fd9\u4e9b\u9690\u85cf\u7684\u5b9d\u85cf\u3002[\u5f69\u86cb\u6316\u6398\uff1a\u7559\u610f\u4e0d\u5bfb\u5e38\u7684\u5408\u5e76\u6a21\u5f0f\u6216\u6e38\u620f\u4e2d\u7684\u7ebf\u7d22\u6765\u53d1\u73b0\u8fd9\u4e9b\u79d8\u5bc6\u3002]"}, {"question": "\u300a\u5408\u5e76\u4e0e\u5efa\u9020\u300b\u4e2d\u7684\u4e8b\u4ef6\u7cfb\u7edf\u5982\u4f55\u589e\u5f3a\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u300a\u5408\u5e76\u4e0e\u5efa\u9020\u300b\u4e2d\u7684\u4e8b\u4ef6\u7cfb\u7edf\u901a\u8fc7\u63d0\u4f9b\u72ec\u7279\u7684\u6311\u6218\u548c\u5956\u52b1\u6765\u663e\u8457\u589e\u5f3a\u6e38\u620f\u4f53\u9a8c\u3002\u4f8b\u5982\uff0c\u53c2\u52a0\u5468\u672b\u6d3b\u52a8\u53ef\u80fd\u9700\u8981\u60a8\u5728\u89c4\u5b9a\u7684\u65f6\u95f4\u5185\u5efa\u9020\u7279\u5b9a\u7684\u7ed3\u6784\uff0c\u5e76\u5956\u52b1\u60a8\u7a00\u6709\u7684\u7269\u54c1\u3002\u6b64\u7cfb\u7edf\u4e3a\u6e38\u620f\u589e\u6dfb\u4e86\u591a\u6837\u6027\u548c\u5174\u594b\u611f\uff0c\u9f13\u52b1\u73a9\u5bb6\u66f4\u6df1\u5165\u5730\u53c2\u4e0e\u5176\u4e2d\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u4e8b\u4ef6\u89c6\u4e3a\u5b63\u8282\u6027\u8282\u65e5\uff1b\u5b83\u4eec\u4e3a\u6e38\u620f\u4e2d\u5e26\u6765\u65b0\u7684\u6d3b\u52a8\u548c\u5956\u52b1\u3002]"}, {"question": "\u5728\u300a\u5408\u5e76\u4e0e\u5efa\u9020\u300b\u4e2d\uff0c\u4e3a\u4e86\u6700\u4f73\u5efa\u9020\uff0c\u6211\u5e94\u8be5\u4f18\u5148\u5408\u5e76\u54ea\u4e9b\u7269\u54c1\uff1f", "answer": "\u5728\u300a\u5408\u5e76\u4e0e\u5efa\u9020\u300b\u4e2d\u4e3a\u4e86\u6700\u4f73\u5efa\u9020\uff0c\u4f18\u5148\u5408\u5e76\u5f53\u524d\u5efa\u7b51\u9879\u76ee\u6240\u9700\u7684\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5408\u5e76\u4e09\u4e2a\u4e09\u7ea7\u6728\u6881\u4ee5\u521b\u5efa\u56db\u7ea7\u652f\u6491\u6881\u5bf9\u4e8e\u5efa\u9020\u7a33\u5b9a\u57fa\u7840\u81f3\u5173\u91cd\u8981\u3002\u4e13\u6ce8\u4e8e\u8fd9\u4e9b\u5173\u952e\u7269\u54c1\uff0c\u786e\u4fdd\u60a8\u7684\u5efa\u9020\u65e2\u9ad8\u6548\u53c8\u6709\u6548\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6bd4\u8f83\u5408\u5e76\u4e0d\u540c\u7269\u54c1\u7684\u597d\u5904\uff0c\u770b\u770b\u54ea\u4e9b\u7269\u54c1\u5bf9\u60a8\u7684\u9879\u76ee\u6700\u6709\u4ef7\u503c\u3002]"}]
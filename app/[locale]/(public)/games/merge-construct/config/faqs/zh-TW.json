[{"question": "\u5982\u4f55\u8b93\u65b0\u624b\u958b\u59cb\u73a9\u5408\u4f75\u5efa\u9020\u904a\u6232\uff1f", "answer": "\u8981\u958b\u59cb\u73a9\u5408\u4f75\u5efa\u9020\u904a\u6232\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f 1 - \u5f9e\u60a8\u559c\u6b61\u7684\u61c9\u7528\u7a0b\u5f0f\u5546\u5e97\u4e0b\u8f09\u4e26\u5b89\u88dd\u904a\u6232\u3002\u6b65\u9a5f 2 - \u5b8c\u6210\u6559\u5b78\uff0c\u4e86\u89e3\u5408\u4f75\u548c\u5efa\u9020\u7684\u57fa\u672c\u6a5f\u5236\u3002\u6b65\u9a5f 3 - \u5f9e\u7c21\u55ae\u7684\u5408\u4f75\u958b\u59cb\uff0c\u4f8b\u5982\u5c07\u5169\u500b\u4e00\u7d1a\u7269\u54c1\u5408\u4f75\u6210\u4e8c\u7d1a\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5408\u4f75\u5169\u500b\u4e00\u7d1a\u6728\u982d\u6703\u7522\u751f\u4e00\u500b\u4e8c\u7d1a\u6728\u677f\u3002\u9019\u7a2e\u57fa\u790e\u65b9\u6cd5\u5c07\u5e6b\u52a9\u60a8\u5feb\u901f\u638c\u63e1\u6838\u5fc3\u904a\u6232\u73a9\u6cd5\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u5408\u4f75\u60f3\u50cf\u6210\u7a4d\u6728\uff1b\u6bcf\u6b21\u5408\u4f75\u90fd\u6703\u70ba\u60a8\u7684\u5efa\u7bc9\u589e\u6dfb\u4e00\u5c64\u65b0\u5143\u7d20\u3002]"}, {"question": "\u5728\u5408\u4f75\u5efa\u9020\u904a\u6232\u4e2d\uff0c\u6700\u4f73\u7684\u8cc7\u6e90\u7ba1\u7406\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u5408\u4f75\u5efa\u9020\u904a\u6232\u4e2d\uff0c\u6709\u6548\u7684\u8cc7\u6e90\u7ba1\u7406\u5305\u62ec\uff1a\u6b65\u9a5f 1 - \u512a\u5148\u5408\u4f75\u80fd\u7522\u751f\u66f4\u9ad8\u968e\u8cc7\u6e90\u7684\u7269\u54c1\u3002\u6b65\u9a5f 2 - \u901a\u904e\u53ea\u4fdd\u7559\u5fc5\u8981\u7269\u54c1\u4f86\u660e\u667a\u5730\u5206\u914d\u5132\u5b58\u7a7a\u9593\u3002\u6b65\u9a5f 3 - \u5b9a\u671f\u6aa2\u67e5\u60a8\u7684\u7269\u54c1\u5eab\u5b58\uff0c\u907f\u514d\u7269\u54c1\u96dc\u4e82\u3002\u4f8b\u5982\uff0c\u5408\u4f75\u4e09\u500b\u4e8c\u7d1a\u6728\u677f\u6703\u7522\u751f\u4e09\u7d1a\u6728\u6a11\uff0c\u9019\u66f4\u6709\u50f9\u503c\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u96d6\u7136\u6709\u4e9b\u73a9\u5bb6\u559c\u6b61\u56e4\u7a4d\u8cc7\u6e90\uff0c\u4f46\u5176\u4ed6\u4eba\u5247\u5c08\u6ce8\u65bc\u7acb\u5373\u5408\u4f75\uff1b\u627e\u5230\u9069\u5408\u60a8\u904a\u6232\u98a8\u683c\u7684\u5e73\u8861\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u61c9\u8a72\u5c08\u6ce8\u65bc\u5728\u5408\u4f75\u5efa\u9020\u904a\u6232\u4e2d\u5408\u4f75\u7279\u5b9a\u7269\u54c1\uff1f", "answer": "\u5728\u5408\u4f75\u5efa\u9020\u904a\u6232\u4e2d\u5c08\u6ce8\u65bc\u7279\u5b9a\u7269\u54c1\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u60a8\u7684\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u5408\u4f75\u4e09\u500b\u4e09\u7d1a\u6728\u6a11\u6703\u7522\u751f\u56db\u7d1a\u652f\u6490\u6a11\uff0c\u9019\u5c0d\u65bc\u5efa\u9020\u9ad8\u7d1a\u7d50\u69cb\u81f3\u95dc\u91cd\u8981\u3002\u9019\u7a2e\u6709\u91dd\u5c0d\u6027\u7684\u5408\u4f75\u6709\u52a9\u65bc\u6709\u6548\u5229\u7528\u8cc7\u6e90\u4e26\u66f4\u5feb\u5730\u9054\u5230\u66f4\u9ad8\u968e\u7684\u5efa\u9020\u3002[\u6bd4\u55bb\u8aaa\u660e: \u53ef\u4ee5\u5c07\u5176\u8996\u70ba\u5c08\u6ce8\u7684\u6295\u8cc7\uff1b\u5408\u4f75\u7279\u5b9a\u7269\u54c1\u5c31\u50cf\u6295\u8cc7\u9ad8\u56de\u5831\u80a1\u7968\u4e00\u6a23\u3002]"}, {"question": "\u5408\u4f75\u5efa\u9020\u904a\u6232\u4e2d\u54ea\u4e9b\u904a\u6232\u6a5f\u5236\u6700\u9069\u5408\u9ad8\u7d1a\u73a9\u5bb6\uff1f", "answer": "\u5408\u4f75\u5efa\u9020\u904a\u6232\u4e2d\u7684\u9ad8\u7d1a\u73a9\u5bb6\u6700\u53d7\u76ca\u65bc\uff1a\u6b65\u9a5f 1 - \u81ea\u52d5\u5408\u4f75\u529f\u80fd\uff0c\u5141\u8a31\u5feb\u901f\u5408\u4f75\u591a\u500b\u7269\u54c1\u3002\u6b65\u9a5f 2 - \u85cd\u5716\u7cfb\u7d71\uff0c\u63d0\u4f9b\u8a73\u7d30\u7684\u5efa\u9020\u8a08\u5283\u3002\u6b65\u9a5f 3 - \u6d3b\u52d5\u7cfb\u7d71\uff0c\u70ba\u5b8c\u6210\u7279\u5b9a\u4efb\u52d9\u63d0\u4f9b\u7368\u7279\u7684\u734e\u52f5\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u85cd\u5716\u7cfb\u7d71\u5efa\u9020\u4e94\u7d1a\u6a4b\u6a11\u53ef\u4ee5\u89e3\u9396\u65b0\u7684\u5340\u57df\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u6bd4\u8f03\u81ea\u52d5\u5408\u4f75\u8207\u624b\u52d5\u5408\u4f75\u7684\u597d\u8655\uff0c\u770b\u770b\u54ea\u500b\u66f4\u9069\u5408\u60a8\u7684\u9ad8\u7d1a\u7b56\u7565\u3002]"}, {"question": "\u5408\u4f75\u5efa\u9020\u904a\u6232\u4e2d\u7684\u5408\u4f75\u7cfb\u7d71\u5982\u4f55\u5f71\u97ff\u904a\u6232\u9032\u5ea6\uff1f", "answer": "\u5408\u4f75\u5efa\u9020\u904a\u6232\u4e2d\u7684\u5408\u4f75\u7cfb\u7d71\u5c0d\u65bc\u904a\u6232\u9032\u5ea6\u81f3\u95dc\u91cd\u8981\u3002\u6bcf\u6b21\u5408\u4f75\u90fd\u6703\u63d0\u5347\u7269\u54c1\u7b49\u7d1a\uff0c\u89e3\u9396\u65b0\u7684\u53ef\u80fd\u6027\u3002\u4f8b\u5982\uff0c\u5408\u4f75\u5169\u6839\u56db\u7d1a\u652f\u6490\u6a11\u6703\u7522\u751f\u4e94\u7d1a\u52a0\u56fa\u6a11\uff0c\u5c0d\u65bc\u5efa\u9020\u5927\u578b\u5efa\u7bc9\u7269\u81f3\u95dc\u91cd\u8981\u3002\u9019\u500b\u7cfb\u7d71\u78ba\u4fdd\u73a9\u5bb6\u4e0d\u65b7\u901a\u904e\u89e3\u9396\u66f4\u9ad8\u968e\u7684\u7269\u54c1\u548c\u7d50\u69cb\u4f86\u53d6\u5f97\u9032\u5c55\u3002[\u6d41\u7a0b\u5716\u89e3: \u7e6a\u88fd\u5408\u4f75\u9032\u5ea6\u5716\uff0c\u5f9e\u4e00\u7d1a\u5230\u4e94\u7d1a\uff0c\u4e86\u89e3\u6d41\u7a0b\u3002]"}, {"question": "\u5408\u4f75\u5efa\u9020\u904a\u6232\u7684\u514d\u8cbb\u548c\u4ed8\u8cbb\u7248\u672c\u4e4b\u9593\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "\u5408\u4f75\u5efa\u9020\u904a\u6232\u7684\u514d\u8cbb\u548c\u4ed8\u8cbb\u7248\u672c\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u5305\u62ec\uff1a\u6b65\u9a5f 1 - \u4ed8\u8cbb\u7248\u672c\u53ef\u4ee5\u7372\u5f97\u7368\u7279\u7684\u7269\u54c1\u548c\u7d50\u69cb\u3002\u6b65\u9a5f 2 - \u514d\u9664\u5ee3\u544a\uff0c\u63d0\u4f9b\u7121\u7e2b\u7684\u904a\u6232\u9ad4\u9a57\u3002\u6b65\u9a5f 3 -  \u984d\u5916\u7684\u5132\u5b58\u7a7a\u9593\u548c\u66f4\u5feb\u7684\u8cc7\u6e90\u518d\u751f\u3002\u4f8b\u5982\uff0c\u4ed8\u8cbb\u73a9\u5bb6\u53ef\u4ee5\u53d6\u5f97\u516d\u7d1a\u9226\u91d1\u5c6c\u6a11\uff0c\u800c\u514d\u8cbb\u7248\u672c\u5247\u7121\u6cd5\u53d6\u5f97\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u6bd4\u8f03\u514d\u8cbb\u548c\u4ed8\u8cbb\u7248\u672c\u7684\u597d\u8655\uff0c\u4ee5\u6c7a\u5b9a\u54ea\u500b\u7248\u672c\u66f4\u9069\u5408\u60a8\u7684\u9700\u6c42\u3002]"}, {"question": "\u5982\u4f55\u5728\u5408\u4f75\u5efa\u9020\u904a\u6232\u4e2d\u5c07\u904a\u6232\u6578\u64da\u8f49\u79fb\u5230\u65b0\u88dd\u7f6e\uff1f", "answer": "\u8981\u5c07\u5408\u4f75\u5efa\u9020\u904a\u6232\u7684\u904a\u6232\u6578\u64da\u8f49\u79fb\u5230\u65b0\u88dd\u7f6e\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f 1 - \u78ba\u4fdd\u60a8\u7684\u904a\u6232\u5df2\u9023\u7d50\u5230\u96f2\u7aef\u5132\u5b58\u5e33\u6236\uff0c\u4f8b\u5982 Google Play \u6216 Apple Game Center\u3002\u6b65\u9a5f 2 - \u5728\u60a8\u7684\u65b0\u88dd\u7f6e\u4e0a\u5b89\u88dd\u5408\u4f75\u5efa\u9020\u904a\u6232\u4e26\u767b\u5165\u76f8\u540c\u7684\u96f2\u7aef\u5132\u5b58\u5e33\u6236\u3002\u6b65\u9a5f 3 - \u5f9e\u96f2\u7aef\u8f09\u5165\u60a8\u7684\u5132\u5b58\u8cc7\u6599\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u6b63\u5728\u5efa\u9020\u4e03\u7d1a\u6469\u5929\u5927\u6a13\uff0c\u90a3\u9ebc\u60a8\u7684\u9032\u5ea6\u6703\u88ab\u4fdd\u7559\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u6bd4\u8f03 Android \u548c iOS \u88dd\u7f6e\u7684\u6b65\u9a5f\uff0c\u4ee5\u78ba\u4fdd\u5e73\u7a69\u7684\u8f49\u79fb\u3002]"}, {"question": "\u5728\u5408\u4f75\u5efa\u9020\u904a\u6232\u4e2d\uff0c\u6211\u80fd\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "\u5408\u4f75\u5efa\u9020\u904a\u6232\u4e2d\u5145\u6eff\u4e86\u96b1\u85cf\u529f\u80fd\u548c\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u4ee5\u7279\u5b9a\u6a21\u5f0f\u5408\u4f75\u4e09\u500b\u4e94\u7d1a\u52a0\u56fa\u6a11\u53ef\u4ee5\u89e3\u9396\u7368\u7279\u7d50\u69cb\u7684\u96b1\u85cf\u85cd\u5716\u3002\u63a2\u7d22\u4e0d\u540c\u7684\u5408\u4f75\u7d44\u5408\uff0c\u4e26\u6ce8\u610f\u904a\u6232\u4e2d\u7684\u7d30\u5fae\u63d0\u793a\uff0c\u53ef\u4ee5\u767c\u73fe\u9019\u4e9b\u96b1\u85cf\u7684\u5bf6\u85cf\u3002[\u5f69\u86cb\u6316\u6398: \u6ce8\u610f\u4e0d\u5c0b\u5e38\u7684\u5408\u4f75\u6a21\u5f0f\u6216\u904a\u6232\u4e2d\u7684\u7dda\u7d22\uff0c\u4ee5\u63ed\u958b\u9019\u4e9b\u79d8\u5bc6\u3002]"}, {"question": "\u5408\u4f75\u5efa\u9020\u904a\u6232\u4e2d\u7684\u6d3b\u52d5\u7cfb\u7d71\u5982\u4f55\u63d0\u5347\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u5408\u4f75\u5efa\u9020\u904a\u6232\u4e2d\u7684\u6d3b\u52d5\u7cfb\u7d71\u900f\u904e\u63d0\u4f9b\u7368\u7279\u7684\u6311\u6230\u548c\u734e\u52f5\u4f86\u986f\u8457\u63d0\u5347\u904a\u6232\u9ad4\u9a57\u3002\u4f8b\u5982\uff0c\u53c3\u8207\u9031\u672b\u6d3b\u52d5\u53ef\u80fd\u9700\u8981\u5728\u9650\u5b9a\u6642\u9593\u5167\u5efa\u9020\u7279\u5b9a\u7d50\u69cb\uff0c\u734e\u52f5\u60a8\u7a00\u6709\u7269\u54c1\u3002\u9019\u500b\u7cfb\u7d71\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u591a\u6a23\u6027\u548c\u523a\u6fc0\u6027\uff0c\u9f13\u52f5\u73a9\u5bb6\u66f4\u6df1\u5165\u5730\u53c3\u8207\u904a\u6232\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u6d3b\u52d5\u60f3\u50cf\u6210\u5b63\u7bc0\u6027\u6176\u5178\uff1b\u5b83\u5011\u70ba\u904a\u6232\u5e36\u4f86\u65b0\u7684\u6d3b\u52d5\u548c\u734e\u52f5\u3002]"}, {"question": "\u5728\u5408\u4f75\u5efa\u9020\u904a\u6232\u4e2d\uff0c\u70ba\u4e86\u6700\u4f73\u7684\u5efa\u7bc9\uff0c\u6211\u61c9\u8a72\u512a\u5148\u5408\u4f75\u54ea\u4e9b\u7269\u54c1\uff1f", "answer": "\u5728\u5408\u4f75\u5efa\u9020\u904a\u6232\u4e2d\uff0c\u70ba\u4e86\u6700\u4f73\u7684\u5efa\u7bc9\uff0c\u8acb\u512a\u5148\u5408\u4f75\u5c0d\u60a8\u7576\u524d\u5efa\u7bc9\u9805\u76ee\u81f3\u95dc\u91cd\u8981\u7684\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5408\u4f75\u4e09\u500b\u4e09\u7d1a\u6728\u6a11\u4ee5\u88fd\u4f5c\u56db\u7d1a\u652f\u6490\u6a11\u5c0d\u65bc\u5efa\u9020\u7a69\u56fa\u7684\u57fa\u790e\u81f3\u95dc\u91cd\u8981\u3002\u5c08\u6ce8\u65bc\u9019\u4e9b\u95dc\u9375\u7269\u54c1\uff0c\u80fd\u78ba\u4fdd\u60a8\u7684\u5efa\u7bc9\u65e2\u6709\u6548\u7387\u53c8\u6709\u6548\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u6bd4\u8f03\u5408\u4f75\u4e0d\u540c\u7269\u54c1\u7684\u597d\u8655\uff0c\u770b\u770b\u54ea\u4e9b\u7269\u54c1\u80fd\u70ba\u60a8\u7684\u5c08\u6848\u5e36\u4f86\u6700\u5927\u7684\u50f9\u503c\u3002]"}]
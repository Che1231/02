[{"question": "\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001Merge & Construct\u3092\u3069\u306e\u3088\u3046\u306b\u30d7\u30ec\u30a4\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "Merge & Construct\u3092\u30d7\u30ec\u30a4\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71: \u304a\u597d\u307f\u306e\u30a2\u30d7\u30ea\u30b9\u30c8\u30a2\u304b\u3089\u30b2\u30fc\u30e0\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3066\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72: \u5408\u4f75\u3068\u5efa\u8a2d\u306e\u57fa\u672c\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u305f\u3081\u306b\u3001\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3092\u5b8c\u4e86\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73: \u30ec\u30d9\u30eb1\u306e\u30a2\u30a4\u30c6\u30e0\u30922\u3064\u7d44\u307f\u5408\u308f\u305b\u308b\u306a\u3069\u3001\u7c21\u5358\u306a\u5408\u4f75\u304b\u3089\u59cb\u3081\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb1\u306e\u30ed\u30b0\u30922\u3064\u30de\u30fc\u30b8\u3059\u308b\u3068\u3001\u30ec\u30d9\u30eb2\u306e\u677f\u306b\u306a\u308a\u307e\u3059\u3002\u3053\u306e\u57fa\u672c\u7684\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u3001\u30b2\u30fc\u30e0\u306e\u57fa\u672c\u7684\u306a\u6d41\u308c\u3092\u8fc5\u901f\u306b\u7406\u89e3\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002[\u4f8b\u55a9\u8aac\u660e: \u5408\u4f75\u306f\u7a4d\u307f\u6728\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u5404\u5408\u4f75\u306b\u3088\u308a\u3001\u5efa\u8a2d\u306b\u65b0\u3057\u3044\u5c64\u304c\u8ffd\u52a0\u3055\u308c\u307e\u3059\u3002]"}, {"question": "Merge & Construct\u3067\u30ea\u30bd\u30fc\u30b9\u3092\u7ba1\u7406\u3059\u308b\u4e0a\u3067\u3001\u6700\u9069\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Merge & Construct\u3067\u52b9\u679c\u7684\u306a\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u3092\u884c\u3046\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71: \u3088\u308a\u9ad8\u30ec\u30d9\u30eb\u306e\u30ea\u30bd\u30fc\u30b9\u3092\u751f\u307f\u51fa\u3059\u30a2\u30a4\u30c6\u30e0\u306e\u5408\u4f75\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72: \u4e0d\u8981\u306a\u30a2\u30a4\u30c6\u30e0\u3060\u3051\u3092\u6b8b\u3057\u3066\u3001\u4fdd\u7ba1\u30b9\u30da\u30fc\u30b9\u3092\u8ce2\u304f\u5272\u308a\u5f53\u3066\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73: \u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u3092\u5b9a\u671f\u7684\u306b\u78ba\u8a8d\u3057\u3066\u3001\u6574\u7406\u3055\u308c\u3066\u3044\u306a\u3044\u30a2\u30a4\u30c6\u30e0\u3092\u907f\u3051\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb2\u306e\u677f\u30923\u3064\u30de\u30fc\u30b8\u3059\u308b\u3068\u3001\u30ec\u30d9\u30eb3\u306e\u6750\u6728\u6881\u306b\u306a\u308a\u307e\u3059\u3002\u3053\u308c\u306f\u3088\u308a\u4fa1\u5024\u304c\u3042\u308a\u307e\u3059\u3002[\u591a\u69d8\u306a\u6226\u7565\u306e\u6bd4\u8f03: \u4e00\u90e8\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u8cc7\u6e90\u3092\u84c4\u3048\u304c\u3061\u3067\u3059\u304c\u3001\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u5373\u5ea7\u306b\u5408\u4f75\u3059\u308b\u3053\u3068\u306b\u91cd\u70b9\u3092\u7f6e\u3044\u3066\u3044\u307e\u3059; \u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u5408\u3063\u305f\u30d0\u30e9\u30f3\u30b9\u3092\u898b\u3064\u3051\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "Merge & Construct\u3067\u7279\u5b9a\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u30de\u30fc\u30b8\u3059\u308b\u3053\u3068\u306b\u91cd\u70b9\u3092\u7f6e\u304f\u3079\u304d\u7406\u7531\u306f\uff1f", "answer": "Merge & Construct\u3067\u7279\u5b9a\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u30de\u30fc\u30b8\u3059\u308b\u3053\u3068\u306b\u91cd\u70b9\u3092\u7f6e\u304f\u3053\u3068\u3067\u3001\u9032\u884c\u72b6\u6cc1\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb3\u306e\u6750\u6728\u6881\u30923\u3064\u30de\u30fc\u30b8\u3059\u308b\u3068\u3001\u30ec\u30d9\u30eb4\u306e\u652f\u67f1\u306b\u306a\u308a\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u9ad8\u5ea6\u306a\u69cb\u9020\u3092\u69cb\u7bc9\u3059\u308b\u4e0a\u3067\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u3053\u306e\u30bf\u30fc\u30b2\u30c3\u30c8\u6307\u5411\u306e\u5408\u4f75\u306f\u3001\u30ea\u30bd\u30fc\u30b9\u3092\u52b9\u7387\u7684\u306b\u6d3b\u7528\u3057\u3001\u3088\u308a\u9ad8\u3044\u30ec\u30d9\u30eb\u306e\u5efa\u8a2d\u3092\u8fc5\u901f\u306b\u9054\u6210\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002[\u4f8b\u55a9\u8aac\u660e: \u3053\u308c\u306f\u3001\u7279\u5b9a\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u30de\u30fc\u30b8\u3059\u308b\u3053\u3068\u3068\u3001\u9ad8\u53ce\u76ca\u682a\u3078\u306e\u6295\u8cc7\u3092\u6bd4\u8f03\u3057\u3066\u3044\u308b\u3068\u8003\u3048\u3089\u308c\u307e\u3059\u3002]"}, {"question": "Merge & Construct\u3067\u3001\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u6700\u3082\u6709\u76ca\u306a\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3069\u308c\u3067\u3059\u304b\uff1f", "answer": "Merge & Construct\u3067\u3001\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u6700\u3082\u6709\u76ca\u306a\u306e\u306f\u4ee5\u4e0b\u306e\u901a\u308a\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71:\u8907\u6570\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u8fc5\u901f\u306b\u30de\u30fc\u30b8\u3067\u304d\u308b\u81ea\u52d5\u30de\u30fc\u30b8\u6a5f\u80fd\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d72:\u8a73\u7d30\u306a\u5efa\u8a2d\u30d7\u30e9\u30f3\u3092\u63d0\u4f9b\u3059\u308b\u8a2d\u8a08\u56f3\u30b7\u30b9\u30c6\u30e0\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d73:\u7279\u5b9a\u306e\u30bf\u30b9\u30af\u3092\u5b8c\u4e86\u3057\u305f\u969b\u306b\u3001\u30e6\u30cb\u30fc\u30af\u306a\u5831\u916c\u3092\u63d0\u4f9b\u3059\u308b\u30a4\u30d9\u30f3\u30c8\u30b7\u30b9\u30c6\u30e0\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u8a2d\u8a08\u56f3\u30b7\u30b9\u30c6\u30e0\u3092\u4f7f\u7528\u3057\u3066\u30ec\u30d9\u30eb5\u306e\u6a4b\u3092\u5efa\u8a2d\u3059\u308b\u3068\u3001\u65b0\u3057\u3044\u30a8\u30ea\u30a2\u304c\u958b\u304b\u308c\u307e\u3059\u3002[\u6a5f\u80fd\u6bd4\u8f03\u8868:\u81ea\u52d5\u30de\u30fc\u30b8\u3068\u624b\u52d5\u30de\u30fc\u30b8\u306e\u5229\u70b9\u3092\u6bd4\u8f03\u3057\u3066\u3001\u4e0a\u7d1a\u6226\u7565\u306b\u6700\u9069\u306a\u3082\u306e\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "Merge & Construct\u306b\u304a\u3051\u308b\u5408\u4f75\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u306e\u9032\u884c\u306b\u304a\u3044\u3066\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "Merge & Construct\u306b\u304a\u3051\u308b\u5408\u4f75\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u306e\u9032\u884c\u306b\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u5404\u5408\u4f75\u306b\u3088\u308a\u30a2\u30a4\u30c6\u30e0\u306e\u30ec\u30d9\u30eb\u304c\u4e0a\u6607\u3057\u3001\u65b0\u3057\u3044\u53ef\u80fd\u6027\u304c\u958b\u304b\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb4\u306e\u652f\u67f1\u30922\u3064\u30de\u30fc\u30b8\u3059\u308b\u3068\u3001\u30ec\u30d9\u30eb5\u306e\u88dc\u5f37\u6881\u306b\u306a\u308a\u3001\u3088\u308a\u5927\u304d\u306a\u5efa\u9020\u7269\u306e\u5efa\u8a2d\u306b\u4e0d\u53ef\u6b20\u306b\u306a\u308a\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u3088\u308a\u9ad8\u3044\u30ec\u30d9\u30eb\u306e\u30a2\u30a4\u30c6\u30e0\u3084\u69cb\u9020\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u3053\u3068\u3067\u3001\u7d99\u7d9a\u7684\u306b\u9032\u884c\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8: \u30ec\u30d9\u30eb1\u304b\u3089\u30ec\u30d9\u30eb5\u307e\u3067\u306e\u5408\u4f75\u306e\u9032\u884c\u3092\u8996\u899a\u5316\u3057\u3066\u3001\u6d41\u308c\u3092\u7406\u89e3\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "Merge & Construct\u306e\u7121\u6599\u7248\u3068\u30d7\u30ec\u30df\u30a2\u30e0\u7248\u306e\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Merge & Construct\u306e\u7121\u6599\u7248\u3068\u30d7\u30ec\u30df\u30a2\u30e0\u7248\u306e\u9055\u3044\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71: \u30d7\u30ec\u30df\u30a2\u30e0\u7248\u3067\u306f\u3001\u9650\u5b9a\u30a2\u30a4\u30c6\u30e0\u3084\u69cb\u9020\u7269\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72: \u5e83\u544a\u304c\u524a\u9664\u3055\u308c\u3001\u30b7\u30fc\u30e0\u30ec\u30b9\u306a\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73: \u8ffd\u52a0\u306e\u4fdd\u7ba1\u30b9\u30da\u30fc\u30b9\u3068\u3001\u3088\u308a\u901f\u3044\u30ea\u30bd\u30fc\u30b9\u306e\u518d\u751f\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d7\u30ec\u30df\u30a2\u30e0\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u7121\u6599\u7248\u3067\u306f\u5165\u624b\u3067\u304d\u306a\u3044\u30ec\u30d9\u30eb6\u30c1\u30bf\u30f3\u30d3\u30fc\u30e0\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059\u3002[\u591a\u69d8\u306a\u6226\u7565\u306e\u6bd4\u8f03: \u7121\u6599\u7248\u3068\u30d7\u30ec\u30df\u30a2\u30e0\u7248\u306e\u5229\u70b9\u3092\u6bd4\u8f03\u3057\u3066\u3001\u30cb\u30fc\u30ba\u306b\u5408\u3063\u305f\u30d0\u30fc\u30b8\u30e7\u30f3\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "Merge & Construct\u3067\u30b2\u30fc\u30e0\u30c7\u30fc\u30bf\u3092\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Merge & Construct\u3067\u30b2\u30fc\u30e0\u30c7\u30fc\u30bf\u3092\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u3
[{"question": "\u5982\u4f55\u8ba9\u65b0\u73a9\u5bb6\u5feb\u901f\u638c\u63e1\u300a\u5929\u7a7a\u9a91\u624b\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u638c\u63e1\u300a\u5929\u7a7a\u9a91\u624b\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u901a\u8fc7\u6559\u7a0b\u5173\u5361\u719f\u6089\u79fb\u52a8\u64cd\u4f5c\u3002\u6b65\u9aa42 - \u5728\u6218\u6597\u6a21\u62df\u5668\u4e2d\u7ec3\u4e60\u4f7f\u7528\u653b\u51fb\u548c\u9632\u5fa1\u6309\u94ae\u3002\u6b65\u9aa43 - \u5728\u5b89\u5168\u73af\u5883\u4e2d\u5c1d\u8bd5\u4f7f\u7528\u7279\u6b8a\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u201c\u7a7a\u4e2d\u51b2\u523a\u201d\u80fd\u529b\u6765\u8eb2\u907f\u654c\u4eba\u7684\u653b\u51fb\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u64cd\u4f5c\u60f3\u8c61\u6210\u5b66\u4e60\u9a91\u81ea\u884c\u8f66\uff0c\u591a\u7ec3\u4e60\u5c31\u80fd\u719f\u7ec3\u638c\u63e1\u3002]"}, {"question": "\u5728\u300a\u5929\u7a7a\u9a91\u624b\u300b\u7684\u9ad8\u7ea7\u5173\u5361\u4e2d\uff0c\u54ea\u4e9b\u5173\u952e\u7b56\u7565\u53ef\u4ee5\u5e2e\u52a9\u73a9\u5bb6\u751f\u5b58\u66f4\u957f\u65f6\u95f4\uff1f", "answer": "\u5728\u9ad8\u7ea7\u5173\u5361\u4e2d\u751f\u5b58\u66f4\u957f\u65f6\u95f4\u9700\u8981\u6218\u7565\u89c4\u5212\u3002\u6b65\u9aa41 - \u4f18\u5148\u5347\u7ea7\u89d2\u8272\u7684\u751f\u547d\u503c\u548c\u4f53\u529b\u3002\u6b65\u9aa42 - \u5229\u7528\u73af\u5883\u4f18\u52bf\uff0c\u4f8b\u5982\u9ad8\u5730\uff0c\u83b7\u5f97\u66f4\u597d\u7684\u89c6\u91ce\u3002\u6b65\u9aa43 - \u660e\u667a\u5730\u7ba1\u7406\u4f60\u7684\u8d44\u6e90\uff1b\u5728\u5173\u952e\u65f6\u523b\u4fdd\u5b58\u836f\u5242\u3002\u4f8b\u5982\uff0c\u5f53\u4f60\u7684\u751f\u547d\u503c\u4f4e\u4e8e30%\u65f6\uff0c\u4f7f\u7528\u201c\u751f\u547d\u836f\u5242\u201d\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u6bd4\u8f83\u4e0d\u540c\u5347\u7ea7\u7684\u6709\u6548\u6027\uff0c\u505a\u51fa\u660e\u667a\u7684\u51b3\u7b56\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u5728\u300a\u5929\u7a7a\u9a91\u624b\u300b\u4e2d\u7406\u89e3\u5236\u4f5c\u7cfb\u7edf\u5f88\u91cd\u8981\uff1f", "answer": "\u7406\u89e3\u5236\u4f5c\u7cfb\u7edf\u5bf9\u4e8e\u63d0\u5347\u4f60\u7684\u6e38\u620f\u4f53\u9a8c\u81f3\u5173\u91cd\u8981\u3002\u5b83\u5141\u8bb8\u4f60\u521b\u9020\u5f3a\u5927\u7684\u6b66\u5668\u548c\u76d4\u7532\uff0c\u5728\u6218\u6597\u4e2d\u7ed9\u4f60\u4f18\u52bf\u3002\u4f8b\u5982\uff0c\u5236\u4f5c\u201c\u5929\u7a7a\u4e4b\u5203\u201d\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u653b\u51fb\u529b\u3002[\u6d41\u7a0b\u56fe\u89e3: \u6309\u7167\u6b65\u9aa4\u6307\u5357\uff0c\u4ece\u6536\u96c6\u8d44\u6e90\u5230\u6700\u7ec8\u5b8c\u6210\u4ea7\u54c1\uff0c\u4e86\u89e3\u5236\u4f5c\u7269\u54c1\u7684\u6b65\u9aa4\u3002]"}, {"question": "\u73a9\u5bb6\u5728\u300a\u5929\u7a7a\u9a91\u624b\u300b\u4e2d\u5e94\u8be5\u4e13\u6ce8\u4e8e\u54ea\u4e9b\u6280\u80fd\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u6548\u7387\uff1f", "answer": "\u73a9\u5bb6\u5e94\u8be5\u4e13\u6ce8\u4e8e\u4e0e\u81ea\u8eab\u6e38\u620f\u98ce\u683c\u76f8\u5339\u914d\u7684\u6280\u80fd\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u559c\u6b22\u8fd1\u8eab\u6218\u6597\uff0c\u90a3\u4e48\u6295\u8d44\u4e8e\u201c\u8fd1\u6218\u7cbe\u901a\u201d\u3002\u5bf9\u4e8e\u8fdc\u7a0b\u653b\u51fb\uff0c\u5219\u4f18\u5148\u8003\u8651\u201c\u7cbe\u51c6\u5c04\u51fb\u201d\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u6bd4\u8f83\u4e0d\u540c\u6280\u80fd\u7ec4\u5408\u7684\u76ca\u5904\uff0c\u4ee5\u786e\u5b9a\u6700\u9002\u5408\u4f60\u7684\u7b56\u7565\u3002]"}, {"question": "\u300a\u5929\u7a7a\u9a91\u624b\u300b\u4e2d\u7684\u5339\u914d\u7cfb\u7edf\u5982\u4f55\u786e\u4fdd\u516c\u5e73\u7684\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u300a\u5929\u7a7a\u9a91\u624b\u300b\u7684\u5339\u914d\u7cfb\u7edf\u4f7f\u7528\u7b97\u6cd5\u5c06\u73a9\u5bb6\u4e0e\u6280\u80fd\u6c34\u5e73\u76f8\u4f3c\u7684\u73a9\u5bb6\u914d\u5bf9\u3002\u8fd9\u786e\u4fdd\u4e86\u4e00\u4e2a\u5e73\u8861\u4e14\u6709\u7ade\u4e89\u529b\u7684\u73af\u5883\u3002\u4f8b\u5982\uff0c\u65b0\u73a9\u5bb6\u4e0d\u4f1a\u88ab\u5339\u914d\u5230\u62e5\u6709500\u5c0f\u65f6\u6e38\u620f\u7ecf\u9a8c\u7684\u8001\u73a9\u5bb6\u3002[\u6bd4\u55bb\u8bf4\u660e: \u8fd9\u5c31\u50cf\u4e00\u4e2a\u4f53\u80b2\u8054\u76df\uff0c\u7403\u961f\u6839\u636e\u7ee9\u6548\u6c34\u5e73\u5206\u7ec4\u3002]"}, {"question": "\u5728\u300a\u5929\u7a7a\u9a91\u624b\u300b\u4e2d\u52a0\u5165\u516c\u4f1a\u6709\u4ec0\u4e48\u597d\u5904\uff1f", "answer": "\u5728\u300a\u5929\u7a7a\u9a91\u624b\u300b\u4e2d\u52a0\u5165\u516c\u4f1a\u6709\u5f88\u591a\u597d\u5904\uff0c\u5305\u62ec\u83b7\u5f97\u4e13\u5c5e\u4efb\u52a1\u3001\u5171\u4eab\u8d44\u6e90\u548c\u652f\u6301\u6027\u793e\u533a\u3002\u4f8b\u5982\uff0c\u516c\u4f1a\u6210\u5458\u53ef\u4ee5\u534f\u4f5c\u51fb\u8d25\u6311\u6218\u6027\u7684\u9996\u9886\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u8bc4\u4f30\u4e0d\u540c\u5de5\u4f1a\u7684\u4f18\u52bf\uff0c\u627e\u5230\u4e00\u4e2a\u7b26\u5408\u4f60\u76ee\u6807\u7684\u516c\u4f1a\u3002]"}, {"question": "\u5982\u4f55\u5728\u300a\u5929\u7a7a\u9a91\u624b\u300b\u4e2d\u4f18\u5316\u89d2\u8272\u6784\u5efa\uff1f", "answer": "\u4f18\u5316\u89d2\u8272\u6784\u5efa\u9700\u8981\u5e73\u8861\u5c5e\u6027\u548c\u6280\u80fd\u3002\u6b65\u9aa41 - \u5206\u6790\u4f60\u7684\u6e38\u620f\u98ce\u683c\u5e76\u9009\u62e9\u80fd\u591f\u589e\u5f3a\u4f60\u7684\u6e38\u620f\u98ce\u683c\u7684\u5c5e\u6027\u3002\u6b65\u9aa42 - \u9009\u62e9\u4e0e\u4f60\u9009\u62e9\u7684\u5c5e\u6027\u76f8\u8f85\u76f8\u6210\u7684\u6280\u80fd\u3002\u6b65\u9aa43 - \u5b9a\u671f\u56de\u987e\u5e76\u6839\u636e\u8868\u73b0\u8c03\u6574\u4f60\u7684\u6784\u5efa\u3002\u4f8b\u5982\uff0c\u5e73\u8861\u6784\u5efa\u53ef\u80fd\u5305\u62ec\u529b\u91cf\u548c\u654f\u6377\u6027\u7684\u6df7\u5408\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u6bd4\u8f83\u4e0d\u540c\u7684\u5c5e\u6027\u5206\u5e03\uff0c\u627e\u5230\u6700\u4f73\u8bbe\u7f6e\u3002]"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u8fd0\u884c\u300a\u5929\u7a7a\u9a91\u624b\u300b\u7684\u7cfb\u7edf\u8981\u6c42\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u5929\u7a7a\u9a91\u624b\u300b\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u7684\u7cfb\u7edf\u8981\u6c42\u6709\u6240\u4e0d\u540c\u3002\u5bf9\u4e8ePC\uff0c\u8bf7\u786e\u4fdd\u4f60\u81f3\u5c11\u62e5\u6709\u82f1\u7279\u5c14i5\u5904\u7406\u5668\u548c8GB\u5185\u5b58\u3002\u5bf9\u4e8e\u6e38\u620f\u673a\uff0c\u8be5\u6e38\u620f\u5728PS5\u548cXbox Series X\u4e0a\u90fd\u80fd\u6d41\u7545\u8fd0\u884c\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u6bd4\u8f83PC\u548c\u6e38\u620f\u673a\u7684\u7cfb\u7edf\u8981\u6c42\uff0c\u4ee5\u786e\u4fdd\u517c\u5bb9\u6027\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u5929\u7a7a\u9a91\u624b\u300b\u4e2d\u5c06\u4ed6\u4eec\u7684\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u5e73\u53f0\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u5e73\u53f0\uff1f", "answer": "\u4e3a\u4e86\u5728\u300a\u5929\u7a7a\u9a91\u624b\u300b\u4e2d\u8f6c\u79fb\u8fdb\u5ea6\uff0c\u8bf7\u4f7f\u7528\u6e38\u620f\u7684\u4e91\u7aef\u5b58\u6863\u529f\u80fd\u3002\u6b65\u9aa41 - \u767b\u5f55\u5230\u539f\u59cb\u5e73\u53f0\u4e0a\u7684\u5e10\u6237\u5e76\u4e0a\u4f20\u4f60\u7684\u5b58\u6863\u6570\u636e\u3002\u6b65\u9aa42 - \u767b\u5f55\u5230\u65b0\u5e73\u53f0\u4e0a\u7684\u540c\u4e00\u4e2a\u5e10\u6237\u5e76\u4e0b\u8f7d\u5b58\u6863\u6570\u636e\u3002\u4f8b\u5982\uff0c\u4ecePC\u8f6c\u79fb\u5230PlayStation\u9700\u8981\u8fd9\u4e9b\u7b80\u5355\u7684\u6b65\u9aa4\u3002[\u6d41\u7a0b\u56fe\u89e3: \u6309\u7167\u53ef\u89c6\u6307\u5357\uff0c\u786e\u4fdd\u987a\u7545\u7684\u8f6c\u79fb\u8fc7\u7a0b\u3002]"}, {"question": "\u73a9\u5bb6\u5728\u300a\u5929\u7a7a\u9a91\u624b\u300b\u4e2d\u53ef\u4ee5\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u7684\u5f69\u86cb\uff1f", "answer": "\u300a\u5929\u7a7a\u9a91\u624b\u300b\u5145\u6ee1\u4e86\u9690\u85cf\u5f69\u86cb\uff0c\u5956\u52b1\u73a9\u5bb6\u63a2\u7d22\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5929\u7a7a\u4e4b\u5cf0\u201d\u533a\u57df\u627e\u5230\u4e00\u4e2a\u9690\u85cf\u6d1e\u7a74\u53ef\u4ee5\u89e3\u9501\u7a00\u6709\u7269\u54c1\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u5f69\u86cb\u60f3\u8c61\u6210\u9690\u85cf\u7684\u5b9d\u85cf\uff0c\u7b49\u5f85\u597d\u5947\u7684\u5192\u9669\u5bb6\u53bb\u53d1\u73b0\u3002]"}]
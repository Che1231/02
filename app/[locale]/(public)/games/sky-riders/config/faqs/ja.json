[{"question": "\u30b9\u30ab\u30a4\u30e9\u30a4\u30c0\u30fc\u306e\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u7d20\u65e9\u304f\u7fd2\u5f97\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30ab\u30a4\u30e9\u30a4\u30c0\u30fc\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30ec\u30d9\u30eb\u3092\u30ca\u30d3\u30b2\u30fc\u30c8\u3057\u3066\u3001\u79fb\u52d5\u64cd\u4f5c\u306b\u6163\u308c\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6226\u95d8\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc\u3067\u653b\u6483\u3068\u9632\u5fa1\u30dc\u30bf\u30f3\u306e\u4f7f\u7528\u7df4\u7fd2\u3092\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5b89\u5168\u306a\u74b0\u5883\u3067\u30b9\u30da\u30b7\u30e3\u30eb\u30a2\u30d3\u30ea\u30c6\u30a3\u3092\u8a66\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30b9\u30ab\u30a4\u30c0\u30c3\u30b7\u30e5\u300f\u30a2\u30d3\u30ea\u30c6\u30a3\u3092\u4f7f\u3063\u3066\u6575\u306e\u653b\u6483\u3092\u56de\u907f\u3059\u308b\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u64cd\u4f5c\u3092\u81ea\u8ee2\u8eca\u306e\u4e57\u308a\u65b9\u306b\u306a\u305e\u3089\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u7df4\u7fd2\u3059\u308c\u3070\u81ea\u7136\u3068\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002]"}, {"question": "\u30b9\u30ab\u30a4\u30e9\u30a4\u30c0\u30fc\u306e\u9ad8\u5ea6\u306a\u30ec\u30d9\u30eb\u3067\u9577\u304f\u751f\u304d\u6b8b\u308b\u305f\u3081\u306e\u91cd\u8981\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u9ad8\u5ea6\u306a\u30ec\u30d9\u30eb\u3067\u9577\u304f\u751f\u304d\u6b8b\u308b\u305f\u3081\u306b\u306f\u3001\u6226\u7565\u7684\u306a\u8a08\u753b\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u4f53\u529b\u3068\u30b9\u30bf\u30df\u30ca\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3053\u3068\u3092\u512a\u5148\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u9ad8\u5730\u306a\u3069\u3001\u3088\u308a\u9ad8\u3044\u8996\u754c\u3092\u5f97\u3089\u308c\u308b\u74b0\u5883\u306e\u5229\u70b9\u3092\u6d3b\u7528\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30ea\u30bd\u30fc\u30b9\u3092\u8ce2\u304f\u7ba1\u7406\u3057\u3001\u91cd\u8981\u306a\u5834\u9762\u3067\u30dd\u30fc\u30b7\u30e7\u30f3\u3092\u7bc0\u7d04\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u4f53\u529b\u304c30%\u3092\u4e0b\u56de\u3063\u305f\u3089\u300e\u4f53\u529b\u56de\u5fa9\u85ac\u300f\u3092\u4f7f\u3046\u3002[\u914d\u7f6e\u5bfe\u7167\u8868\uff1a\u3055\u307e\u3056\u307e\u306a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306e\u52b9\u679c\u3092\u6bd4\u8f03\u3057\u3066\u3001\u8ce2\u660e\u306a\u5224\u65ad\u3092\u4e0b\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30b9\u30ab\u30a4\u30e9\u30a4\u30c0\u30fc\u306e\u30af\u30e9\u30d5\u30c8\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u306a\u305c\u91cd\u8981\u3067\u3059\u304b\uff1f", "answer": "\u30af\u30e9\u30d5\u30c8\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5f37\u5316\u3059\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u5f37\u529b\u306a\u6b66\u5668\u3084\u9632\u5177\u3092\u4f5c\u6210\u3067\u304d\u308b\u305f\u3081\u3001\u6226\u95d8\u3067\u6709\u5229\u306b\u306a\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30b9\u30ab\u30a4\u30d6\u30ec\u30fc\u30c9\u300f\u3092\u30af\u30e9\u30d5\u30c8\u3059\u308b\u3053\u3068\u3067\u3001\u653b\u6483\u529b\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u8cc7\u6e90\u306e\u53ce\u96c6\u304b\u3089\u88fd\u54c1\u306e\u5b8c\u6210\u307e\u3067\u3001\u30a2\u30a4\u30c6\u30e0\u88fd\u4f5c\u306e\u624b\u9806\u3092\u30b9\u30c6\u30c3\u30d7\u30d0\u30a4\u30b9\u30c6\u30c3\u30d7\u3067\u30ac\u30a4\u30c9\u3059\u308b\u3002]"}, {"question": "\u30b9\u30ab\u30a4\u30e9\u30a4\u30c0\u30fc\u3067\u52b9\u7387\u3092\u6700\u5927\u9650\u306b\u9ad8\u3081\u308b\u305f\u3081\u306b\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u30b9\u30ad\u30eb\u306b\u96c6\u4e2d\u3059\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u81ea\u5206\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u9069\u3057\u305f\u30b9\u30ad\u30eb\u306b\u96c6\u4e2d\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u8fd1\u63a5\u6226\u95d8\u3092\u597d\u3080\u5834\u5408\u306f\u3001\u300e\u8fd1\u63a5\u6226\u95d8\u8853\u300f\u306b\u6295\u8cc7\u3057\u307e\u3059\u3002\u9060\u8ddd\u96e2\u653b\u6483\u3092\u597d\u3080\u5834\u5408\u306f\u3001\u300e\u7cbe\u5bc6\u5c04\u6483\u300f\u3092\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u8907\u6570\u6848\u6bd4\u8f03\uff1a\u3055\u307e\u3056\u307e\u306a\u30b9\u30ad\u30eb\u30bb\u30c3\u30c8\u306e\u5229\u70b9\u3092\u6bd4\u8f03\u3057\u3066\u3001\u6700\u9069\u306a\u6226\u7565\u306b\u5408\u3063\u305f\u3082\u306e\u3092\u6c7a\u5b9a\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30b9\u30ab\u30a4\u30e9\u30a4\u30c0\u30fc\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u516c\u5e73\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u3069\u306e\u3088\u3046\u306b\u4fdd\u8a3c\u3057\u3066\u3044\u307e\u3059\u304b\uff1f", "answer": "\u30b9\u30ab\u30a4\u30e9\u30a4\u30c0\u30fc\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u985e\u4f3c\u3057\u305f\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306b\u3088\u3063\u3066\u30da\u30a2\u30ea\u30f3\u30b0\u3057\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u7af6\u4e89\u74b0\u5883\u304c\u4fdd\u8a3c\u3055\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001500\u6642\u9593\u30d7\u30ec\u30a4\u7d4c\u9a13\u306e\u3042\u308b\u30d9\u30c6\u30e9\u30f3\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u30de\u30c3\u30c1\u30f3\u30b0\u3055\u308c\u307e\u305b\u3093\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u3053\u308c\u306f\u3001\u30c1\u30fc\u30e0\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u57fa\u3065\u3044\u3066\u30c1\u30fc\u30e0\u3092\u30b0\u30eb\u30fc\u30d7\u5316\u3059\u308b\u30b9\u30dd\u30fc\u30c4\u30ea\u30fc\u30b0\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002]"}, {"question": "\u30b9\u30ab\u30a4\u30e9\u30a4\u30c0\u30fc\u3067\u30ae\u30eb\u30c9\u306b\u53c2\u52a0\u3059\u308b\u30e1\u30ea\u30c3\u30c8\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30ab\u30a4\u30e9\u30a4\u30c0\u30fc\u3067\u30ae\u30eb\u30c9\u306b\u53c2\u52a0\u3059\u308b\u3068\u3001\u9650\u5b9a\u30af\u30a8\u30b9\u30c8\u3001\u5171\u6709\u8cc7\u6e90\u3001\u305d\u3057\u3066\u30b5\u30dd\u30fc\u30c8\u7684\u306a\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u3078\u306e\u30a2\u30af\u30bb\u30b9\u306a\u3069\u3001\u591a\u304f\u306e\u30e1\u30ea\u30c3\u30c8\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ae\u30eb\u30c9\u30e1\u30f3\u30d0\u30fc\u306f\u5354\u529b\u3057\u3066\u3001\u56f0\u96e3\u306a\u30dc\u30b9\u3092\u5012\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u8907\u6570\u6848\u6bd4\u8f03\uff1a\u3055\u307e\u3056\u307e\u306a\u30ae\u30eb\u30c9\u306e\u9577\u6240\u3092\u8a55\u4fa1\u3057\u3066\u3001\u76ee\u6a19\u306b\u5408\u81f4\u3059\u308b\u30ae\u30eb\u30c9\u3092\u898b\u3064\u3051\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30b9\u30ab\u30a4\u30e9\u30a4\u30c0\u30fc\u3067\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30d3\u30eb\u30c9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30d3\u30eb\u30c9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u5c5e\u6027\u3068\u30b9\u30ad\u30eb\u3092\u30d0\u30e9\u30f3\u30b9\u3055\u305b\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u3092\u5206\u6790\u3057\u3001\u305d\u308c\u3092\u5f37\u5316\u3059\u308b\u5c5e\u6027\u3092\u9078\u629e\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u9078\u629e\u3057\u305f\u5c5e\u6027\u3068\u76f8\u4e57\u52b9\u679c\u306e\u3042\u308b\u30b9\u30ad\u30eb\u3092\u9078\u629e\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u57fa\u3065\u3044\u3066\u3001\u5b9a\u671f\u7684\u306b\u30d3\u30eb\u30c9\u3092\u898b\u76f4\u3057\u3001\u8abf\u6574\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u53d6\u308c\u305f\u30d3\u30eb\u30c9\u306b\u306f\u3001\u529b\u3068\u4fca\u654f\u6027\u306e\u7d44\u307f\u5408\u308f\u305b\u304c\u542b\u307e\u308c\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002[\u914d\u7f6e\u5bfe\u7167\u8868\uff1a\u3055\u307e\u3056\u307e\u306a\u5c5e\u6027\u5206\u5e03\u3092\u6bd4\u8f03\u3057\u3066\u3001\u6700\u9069\u306a\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7\u3092\u898b\u3064\u3051\u51fa\u3059\u3002]"}, {"question": "\u30b9\u30ab\u30a4\u30e9\u30a4\u30c0\u30fc\u3092\u3055\u307e\u3056\u307e\u306a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u5b9f\u884c\u3059\u308b\u305f\u3081\u306e\u30b7\u30b9\u30c6\u30e0\u8981\u4ef6\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30ab\u30a4\u30e9\u30a4\u30c0\u30fc\u306f\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u3088\u3063\u3066\u30b7\u30b9\u30c6\u30e0\u8981\u4ef6\u304c\u7570\u306a\u308a\u307e\u3059\u3002PC\u306e\u5834\u5408\u3001Intel i5\u30d7\u30ed\u30bb\u30c3\u30b5\u30688GB\u306eRAM\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b3\u30f3\u30bd\u30fc\u30eb\u306e\u5834\u5408\u3001PlayStation 5\u3068Xbox Series X\u306e\u4e21\u65b9\u3067\u30b9\u30e0\u30fc\u30ba\u306b\u52d5\u4f5c\u3057\u307e\u3059\u3002[\u914d\u7f6e\u5bfe\u7167\u8868\uff1aPC\u3068\u30b3\u30f3\u30bd\u30fc\u30eb\u306e\u30b7\u30b9\u30c6\u30e0\u8981\u4ef6\u3092\u6bd4\u8f03\u3057\u3066\u4e92\u63db\u6027\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30b9\u30ab\u30a4\u30e9\u30a4\u30c0\u30fc\u3067\u3001\u3042\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u304b\u3089\u5225\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u9032\u884c\u72b6\u6cc1\u3092\u79fb\u884c\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30ab\u30a4\u30e9\u30a4\u30c0\u30fc\u3067\u9032\u884c\u72b6\u6cc1\u3092\u79fb\u884c\u3059\u308b\u306b\u306f\u3001\u30b2\u30fc\u30e0\u306e\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5143\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3001\u4fdd\u5b58\u30c7\u30fc\u30bf\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u65b0\u3057\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3001\u4fdd\u5b58\u30c7\u30fc\u30bf\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001PC\u304b\u3089PlayStation\u3078\u306e\u79fb\u884c\u306b\u306f\u3001\u3053\u308c\u3089\u306e\u7c21\u5358\u306a\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30b9\u30e0\u30fc\u30ba\u306a\u8ee2\u9001\u30d7\u30ed\u30bb\u30b9\u3092\u4fdd\u8a3c\u3059\u308b\u305f\u3081\u306e\u8996\u899a\u7684\u306a\u30ac\u30a4\u30c9\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30b9\u30ab\u30a4\u30e9\u30a4\u30c0\u30fc\u3067\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u3088\u3046\u306a\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30b9\u30ab\u30a4\u30e9\u30a4\u30c0\u30fc\u306f\u3001\u63a2\u7d22\u3092\u5831\u3044\u308b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3067\u3044\u3063\u3071\u3044\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30b9\u30ab\u30a4\u30d4\u30fc\u30af\u30b9\u300f\u30a8\u30ea\u30a2\u306e\u96a0\u3055\u308c\u305f\u6d1e\u7a9f\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u3067\u3001\u30ec\u30a2\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u5165\u624b\u3067\u304d\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u3001\u597d\u5947\u5fc3\u65fa\u76db\u306a\u5192\u967a\u8005\u304c\u767a\u898b\u3059\u308b\u5f85\u3061\u53d7\u3051\u3066\u3044\u308b\u79d8\u5b9d\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}]
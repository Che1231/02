[{"question": "\uc2a4\uce74\uc774 \ub77c\uc774\ub354\uc2a4\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \ub9c8\uc2a4\ud130\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc2a4\uce74\uc774 \ub77c\uc774\ub354\uc2a4\uc5d0\uc11c \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ub9c8\uc2a4\ud130\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1 - \ud29c\ud1a0\ub9ac\uc5bc \ub808\ubca8\uc744 \ud1b5\ud574 \uc774\ub3d9 \ucee8\ud2b8\ub864\uc5d0 \uc775\uc219\ud574\uc9c0\uc138\uc694. STEP2 - \uc804\ud22c \uc2dc\ubbac\ub808\uc774\ud130\uc5d0\uc11c \uacf5\uaca9 \ubc0f \ubc29\uc5b4 \ubc84\ud2bc \uc0ac\uc6a9\ubc95\uc744 \uc5f0\uc2b5\ud558\uc138\uc694. STEP3 - \uc548\uc804\ud55c \ud658\uacbd\uc5d0\uc11c \ud2b9\uc218 \ub2a5\ub825\uc744 \uc2e4\ud5d8\ud574 \ubcf4\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uc2a4\uce74\uc774 \ub300\uc2dc' \ub2a5\ub825\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc801\uc758 \uacf5\uaca9\uc744 \ud68c\ud53c\ud558\uc138\uc694. [\ube44\uc720 \uc124\uba85: \ucee8\ud2b8\ub864\uc744 \uc790\uc804\uac70 \ud0c0\ub294 \ubc95\uc744 \ubc30\uc6b0\ub294 \uac83\uc73c\ub85c \uc0dd\uac01\ud558\uc138\uc694; \uc5f0\uc2b5\uc744 \ud1b5\ud574 \uc790\uc5f0\uc2a4\ub7ec\uc6cc\uc9d1\ub2c8\ub2e4.]"}, {"question": "\uc2a4\uce74\uc774 \ub77c\uc774\ub354\uc2a4\uc758 \uace0\uae09 \ub808\ubca8\uc5d0\uc11c \ub354 \uc624\ub798 \uc0dd\uc874\ud558\ub294 \uc8fc\uc694 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uace0\uae09 \ub808\ubca8\uc5d0\uc11c \ub354 \uc624\ub798 \uc0dd\uc874\ud558\ub824\uba74 \uc804\ub7b5\uc801\uc778 \uacc4\ud68d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1 - \uce90\ub9ad\ud130\uc758 \uccb4\ub825\uacfc \uc2a4\ud0dc\ubbf8\ub098\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \ub370 \uc6b0\uc120 \uc21c\uc704\ub97c \ub450\uc138\uc694. STEP2 - \ud658\uacbd\uc801 \uc774\uc810, \uc608\ub97c \ub4e4\uc5b4 \ub354 \ub098\uc740 \uc2dc\uc57c \ud655\ubcf4\ub97c \uc704\ud55c \uace0\uc9c0\ub300\ub97c \ud65c\uc6a9\ud558\uc138\uc694. STEP3 - \uc790\uc6d0\uc744 \ud604\uba85\ud558\uac8c \uad00\ub9ac\ud558\uc138\uc694; \uc911\uc694\ud55c \uc21c\uac04\uc744 \uc704\ud574 \ud3ec\uc158\uc744 \uc808\uc57d\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uccb4\ub825\uc774 30% \ubbf8\ub9cc\uc73c\ub85c \ub5a8\uc5b4\uc9c0\uba74 '\uccb4\ub825 \ud3ec\uc158'\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. [\uad6c\uc131 \ube44\uad50\ud45c: \ub2e4\uc591\ud55c \uc5c5\uadf8\ub808\uc774\ub4dc\uc758 \ud6a8\uacfc\ub97c \ube44\uad50\ud558\uc5ec \uc815\ubcf4\uc5d0 \uc785\uac01\ud55c \uacb0\uc815\uc744 \ub0b4\ub9ac\uc138\uc694.]"}, {"question": "\uc2a4\uce74\uc774 \ub77c\uc774\ub354\uc2a4\uc5d0\uc11c \uc81c\uc791 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc2a4\uce74\uc774 \ub77c\uc774\ub354\uc2a4\uc5d0\uc11c \uc81c\uc791 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uac15\ub825\ud55c \ubb34\uae30\uc640 \uac11\uc637\uc744 \uc81c\uc791\ud560 \uc218 \uc788\uc73c\ubbc0\ub85c \uc804\ud22c\uc5d0\uc11c \uc6b0\uc704\ub97c \uc810\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc2a4\uce74\uc774 \ube14\ub808\uc774\ub4dc'\ub97c \uc81c\uc791\ud558\uba74 \uacf5\uaca9\ub825\uc774 \ud06c\uac8c \uc99d\uac00\ud569\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \ub2e4\uc774\uc5b4\uadf8\ub7a8: \uc790\uc6d0 \uc218\uc9d1\ubd80\ud130 \uc81c\ud488 \uc644\uc131\uae4c\uc9c0 \uc544\uc774\ud15c \uc81c\uc791 \ub2e8\uacc4\ubcc4 \uac00\uc774\ub4dc\ub97c \ub530\ub974\uc138\uc694.]"}, {"question": "\uc2a4\uce74\uc774 \ub77c\uc774\ub354\uc2a4\uc5d0\uc11c \ud6a8\uc728\uc131\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \ud50c\ub808\uc774\uc5b4\uac00 \uc9d1\uc911\ud574\uc57c \ud560 \uae30\uc220\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud50c\ub808\uc774\uc5b4\ub294 \uc790\uc2e0\uc758 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\ub294 \uae30\uc220\uc5d0 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uadfc\uc811 \uc804\ud22c\ub97c \uc120\ud638\ud55c\ub2e4\uba74 '\uadfc\uc811 \uc804\ud22c \ub9c8\uc2a4\ud130\ub9ac'\uc5d0 \ud22c\uc790\ud558\uc138\uc694. \uc6d0\uac70\ub9ac \uacf5\uaca9\uc744 \uc120\ud638\ud55c\ub2e4\uba74 '\uc815\ubc00 \uc0ac\uaca9'\uc5d0 \uc6b0\uc120 \uc21c\uc704\ub97c \ub450\uc138\uc694. [\ub2e4\uc591\ud55c \uc635\uc158 \ube44\uad50: \uc804\ub7b5\uc5d0 \uac00\uc7a5 \uc801\ud569\ud55c \uae30\uc220 \uc138\ud2b8\ub97c \uacb0\uc815\ud558\uae30 \uc704\ud574 \ub2e4\uc591\ud55c \uae30\uc220 \uc138\ud2b8\uc758 \uc774\uc810\uc744 \ube44\uad50\ud558\uc138\uc694.]"}, {"question": "\uc2a4\uce74\uc774 \ub77c\uc774\ub354\uc2a4\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \uacf5\uc815\ud55c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc5b4\ub5bb\uac8c \ubcf4\uc7a5\ud569\ub2c8\uae4c?", "answer": "\uc2a4\uce74\uc774 \ub77c\uc774\ub354\uc2a4\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \uc720\uc0ac\ud55c \uae30\uc220 \uc218\uc900\uc758 \ud50c\ub808\uc774\uc5b4\ub97c \ub9e4\uce6d\ud558\ub294 \uc54c\uace0\ub9ac\uc998\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc774\ub294 \uade0\ud615 \uc788\uace0 \uacbd\uc7c1\uc801\uc778 \ud658\uacbd\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc2e0\uaddc \ud50c\ub808\uc774\uc5b4\ub294 500\uc2dc\uac04\uc758 \uac8c\uc784 \uacbd\ud5d8\uc744 \uac00\uc9c4 \ubca0\ud14c\ub791\uacfc \ub9e4\uce6d\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ub9c8\uce58 \ud300 \uc131\uc801 \uae30\uc900\uc73c\ub85c \ud300\uc774 \uadf8\ub8f9\ud654\ub418\ub294 \uc2a4\ud3ec\uce20 \ub9ac\uadf8\uc640 \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\uc2a4\uce74\uc774 \ub77c\uc774\ub354\uc2a4\uc5d0\uc11c \uae38\ub4dc\uc5d0 \uac00\uc785\ud558\ub294 \uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc2a4\uce74\uc774 \ub77c\uc774\ub354\uc2a4\uc5d0\uc11c \uae38\ub4dc\uc5d0 \uac00\uc785\ud558\uba74 \ub3c5\uc810 \ud018\uc2a4\ud2b8, \uacf5\uc720 \uc790\uc6d0 \ubc0f \uc9c0\uc6d0\uc801\uc778 \ucee4\ubba4\ub2c8\ud2f0\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\ub294 \ub4f1 \ub9ce\uc740 \uc774\uc810\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uae38\ub4dc\uc6d0\uc740 \ud568\uaed8 \uc5b4\ub824\uc6b4 \ubcf4\uc2a4\ub97c \ubb3c\ub9ac\uce60 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc635\uc158 \ube44\uad50: \ubaa9\ud45c\uc5d0 \ubd80\ud569\ud558\ub294 \uae38\ub4dc\ub97c \ucc3e\uae30 \uc704\ud574 \ub2e4\uc591\ud55c \uae38\ub4dc\uc758 \uc7a5\uc810\uc744 \ud3c9\uac00\ud558\uc138\uc694.]"}, {"question": "\uc2a4\uce74\uc774 \ub77c\uc774\ub354\uc2a4\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\ub294 \uc790\uc2e0\uc758 \uce90\ub9ad\ud130 \ube4c\ub4dc\ub97c \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uce90\ub9ad\ud130 \ube4c\ub4dc\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \ud2b9\uc131\uacfc \uae30\uc220\uc744 \uade0\ud615 \uc788\uac8c \uc870\uc815\ud574\uc57c \ud569\ub2c8\ub2e4. STEP1 - \uc790\uc2e0\uc758 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\ucdb0 \ud2b9\uc131\uc744 \ubd84\uc11d\ud558\uace0 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ud2b9\uc131\uc744 \uc120\ud0dd\ud558\uc138\uc694. STEP2 - \uc120\ud0dd\ud55c \ud2b9\uc131\uacfc \uc798 \uc2dc\ub108\uc9c0 \ud6a8\uacfc\ub97c \ub0b4\ub294 \uae30\uc220\uc744 \uc120\ud0dd\ud558\uc138\uc694. STEP3 - \uc131\ub2a5\uc744 \uae30\ubc18\uc73c\ub85c \ube4c\ub4dc\ub97c \uc815\uae30\uc801\uc73c\ub85c \uac80\ud1a0\ud558\uace0 \uc870\uc815\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uade0\ud615 \uc7a1\ud78c \ube4c\ub4dc\ub294 \ud798\uacfc \ubbfc\ucca9\uc131\uc744 \ud63c\ud569\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \ucd5c\uc801\uc758 \uc124\uc815\uc744 \ucc3e\uae30 \uc704\ud574 \ub2e4\uc591\ud55c \ud2b9\uc131 \ubc30\ubd84\uc744 \ube44\uad50\ud558\uc138\uc694.]"}, {"question": "\uc2a4\uce74\uc774 \ub77c\uc774\ub354\uc2a4\ub97c \ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc2e4\ud589\ud558\uae30 \uc704\ud55c \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc2a4\uce74\uc774 \ub77c\uc774\ub354\uc2a4\ub294 \ud50c\ub7ab\ud3fc\uc5d0 \ub530\ub77c \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc774 \ub2e4\ub985\ub2c8\ub2e4. PC\uc758 \uacbd\uc6b0 \uc778\ud154 i5 \ud504\ub85c\uc138\uc11c\uc640 8GB RAM \uc774\uc0c1\uc744 \uac16\ucd94\uc5b4\uc57c \ud569\ub2c8\ub2e4. \ucf58\uc194\uc758 \uacbd\uc6b0 PlayStation 5\uc640 Xbox Series X\uc5d0\uc11c \ubaa8\ub450 \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ub429\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: PC\uc640 \ucf58\uc194\uc758 \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc744 \ube44\uad50\ud558\uc5ec \ud638\ud658\uc131\uc744 \ud655\uc778\ud558\uc138\uc694.]"}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 \uc2a4\uce74\uc774 \ub77c\uc774\ub354\uc2a4\uc5d0\uc11c \ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc2a4\uce74\uc774 \ub77c\uc774\ub354\uc2a4\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub824\uba74 \uac8c\uc784\uc758 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. STEP1 - \uc6d0\ub798 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uace0 \uc800\uc7a5 \ub370\uc774\ud130\ub97c \uc5c5\ub85c\ub4dc\ud558\uc138\uc694. STEP2 - \uc0c8 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uace0 \uc800\uc7a5 \ub370\uc774\ud130\ub97c \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c PlayStation\uc73c\ub85c \uc804\uc1a1\ud558\ub294 \ub370\ub294 \uc774\ub7ec\ud55c \uac04\ub2e8\ud55c \ub2e8\uacc4\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \ub2e4\uc774\uc5b4\uadf8\ub7a8: \uc6d0\ud65c\ud55c \uc804\uc1a1 \uacfc\uc815\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud55c \uc2dc\uac01\uc801 \uac00\uc774\ub4dc\ub97c \ub530\ub974\uc138\uc694.]"}, {"question": "\uc2a4\uce74\uc774 \ub77c\uc774\ub354\uc2a4\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc2a4\uce74\uc774 \ub77c\uc774\ub354\uc2a4\ub294 \ud0d0\ud5d8\uc744 \ubcf4\uc0c1\ud558\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub85c \uac00\ub4dd \ucc28 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc2a4\uce74\uc774 \ud53d\uc2a4' \uc9c0\uc5ed\uc758 \uc228\uaca8\uc9c4 \ub3d9\uad74\uc744 \ucc3e\uc73c\uba74 \ud76c\uadc0\ud55c \uc544\uc774\ud15c\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud0d0\ud5d8\uc801\uc778 \ubaa8\ud5d8\uac00\ub4e4\uc774 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ubcf4\ubb3c\ub85c \uc0dd\uac01\ud558\uc138\uc694.]"}]
[{"question": "\u5982\u4f55\u8b93\u65b0\u73a9\u5bb6\u5feb\u901f\u638c\u63e1\u300a\u5929\u7a7a\u9a0e\u58eb\u300b\u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u638c\u63e1\u300a\u5929\u7a7a\u9a0e\u58eb\u300b\u7684\u57fa\u672c\u63a7\u5236\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u901a\u904e\u6559\u7a0b\u95dc\u5361\u719f\u6089\u79fb\u52d5\u63a7\u5236\u3002\u6b65\u9a5f2 - \u5728\u6230\u9b25\u6a21\u64ec\u5668\u4e2d\u7df4\u7fd2\u4f7f\u7528\u653b\u64ca\u548c\u9632\u79a6\u6309\u9215\u3002\u6b65\u9a5f3 - \u5728\u5b89\u5168\u74b0\u5883\u4e2d\u5617\u8a66\u4f7f\u7528\u7279\u6b8a\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u300c\u5929\u7a7a\u885d\u523a\u300d\u80fd\u529b\u4f86\u8eb2\u907f\u6575\u4eba\u653b\u64ca\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u63a7\u5236\u60f3\u50cf\u6210\u5b78\u7fd2\u9a0e\u81ea\u884c\u8eca\uff1b\u591a\u7df4\u7fd2\u5f8c\u5c31\u6703\u8b8a\u6210\u81ea\u7136\u53cd\u61c9\u3002]"}, {"question": "\u5728\u300a\u5929\u7a7a\u9a0e\u58eb\u300b\u7684\u9ad8\u7d1a\u95dc\u5361\u4e2d\uff0c\u54ea\u4e9b\u95dc\u9375\u7b56\u7565\u53ef\u4ee5\u5e6b\u52a9\u73a9\u5bb6\u5b58\u6d3b\u66f4\u4e45\uff1f", "answer": "\u5728\u9ad8\u7d1a\u95dc\u5361\u4e2d\u5b58\u6d3b\u66f4\u4e45\u9700\u8981\u7b56\u7565\u6027\u898f\u5283\u3002\u6b65\u9a5f1 - \u512a\u5148\u5347\u7d1a\u89d2\u8272\u7684\u751f\u547d\u503c\u548c\u9ad4\u529b\u3002\u6b65\u9a5f2 - \u5229\u7528\u74b0\u5883\u512a\u52e2\uff0c\u4f8b\u5982\u9ad8\u5730\u4ee5\u7372\u5f97\u66f4\u597d\u7684\u8996\u91ce\u3002\u6b65\u9a5f3 - \u660e\u667a\u5730\u7ba1\u7406\u8cc7\u6e90\uff1b\u5728\u95dc\u9375\u6642\u523b\u7bc0\u7d04\u85e5\u6c34\u3002\u4f8b\u5982\uff0c\u7576\u751f\u547d\u503c\u964d\u81f3 30% \u4ee5\u4e0b\u6642\uff0c\u4f7f\u7528\u300c\u751f\u547d\u85e5\u6c34\u300d\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6bd4\u8f03\u4e0d\u540c\u5347\u7d1a\u7684\u6709\u6548\u6027\uff0c\u5f9e\u800c\u505a\u51fa\u660e\u667a\u7684\u6c7a\u5b9a\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u77ad\u89e3\u300a\u5929\u7a7a\u9a0e\u58eb\u300b\u7684\u935b\u9020\u7cfb\u7d71\u5f88\u91cd\u8981\uff1f", "answer": "\u77ad\u89e3\u935b\u9020\u7cfb\u7d71\u5c0d\u65bc\u63d0\u5347\u904a\u6232\u9ad4\u9a57\u81f3\u95dc\u91cd\u8981\u3002\u5b83\u5141\u8a31\u4f60\u88fd\u4f5c\u5f37\u5927\u7684\u6b66\u5668\u548c\u9632\u5177\uff0c\u5728\u6230\u9b25\u4e2d\u7372\u5f97\u512a\u52e2\u3002\u4f8b\u5982\uff0c\u935b\u9020\u300c\u5929\u7a7a\u4e4b\u5203\u300d\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u4f60\u7684\u653b\u64ca\u529b\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u9075\u5faa\u9010\u6b65\u6307\u5357\uff0c\u5f9e\u6536\u96c6\u8cc7\u6e90\u5230\u6700\u7d42\u5b8c\u6210\u7522\u54c1\u7684\u935b\u9020\u6d41\u7a0b\u3002]"}, {"question": "\u73a9\u5bb6\u5728\u300a\u5929\u7a7a\u9a0e\u58eb\u300b\u4e2d\u61c9\u8a72\u5c08\u6ce8\u65bc\u54ea\u4e9b\u6280\u80fd\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u6548\u7387\uff1f", "answer": "\u73a9\u5bb6\u61c9\u8a72\u5c08\u6ce8\u65bc\u8207\u5176\u904a\u6232\u98a8\u683c\u76f8\u8f14\u76f8\u6210\u7684\u6280\u80fd\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u504f\u611b\u8fd1\u6230\uff0c\u5247\u6295\u8cc7\u300c\u8fd1\u6230\u5c08\u7cbe\u300d\u3002\u5c0d\u65bc\u9060\u7a0b\u653b\u64ca\uff0c\u5247\u512a\u5148\u8003\u616e\u300c\u7cbe\u6e96\u5c04\u64ca\u300d\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u6bd4\u8f03\u4e0d\u540c\u6280\u80fd\u7d44\u5408\u7684\u597d\u8655\uff0c\u4ee5\u78ba\u5b9a\u54ea\u7a2e\u7d44\u5408\u6700\u9069\u5408\u4f60\u7684\u7b56\u7565\u3002]"}, {"question": "\u300a\u5929\u7a7a\u9a0e\u58eb\u300b\u7684\u5339\u914d\u7cfb\u7d71\u5982\u4f55\u78ba\u4fdd\u516c\u5e73\u7684\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u300a\u5929\u7a7a\u9a0e\u58eb\u300b\u7684\u5339\u914d\u7cfb\u7d71\u4f7f\u7528\u6f14\u7b97\u6cd5\u5c07\u73a9\u5bb6\u914d\u5c0d\u5230\u6280\u80fd\u6c34\u5e73\u76f8\u8fd1\u7684\u5c0d\u624b\u3002\u9019\u78ba\u4fdd\u4e86\u5e73\u8861\u4e14\u7af6\u722d\u6027\u7684\u904a\u6232\u74b0\u5883\u3002\u4f8b\u5982\uff0c\u65b0\u73a9\u5bb6\u4e0d\u6703\u8207\u64c1\u6709 500 \u5c0f\u6642\u904a\u6232\u7d93\u9a57\u7684\u8001\u73a9\u5bb6\u5339\u914d\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u9019\u5c31\u50cf\u4e00\u9805\u904b\u52d5\u806f\u76df\uff0c\u968a\u4f0d\u6839\u64da\u5176\u8868\u73fe\u6c34\u5e73\u9032\u884c\u5206\u7d44\u3002]"}, {"question": "\u5728\u300a\u5929\u7a7a\u9a0e\u58eb\u300b\u4e2d\u52a0\u5165\u5de5\u6703\u6709\u54ea\u4e9b\u597d\u8655\uff1f", "answer": "\u5728\u300a\u5929\u7a7a\u9a0e\u58eb\u300b\u4e2d\u52a0\u5165\u5de5\u6703\u6709\u5f88\u591a\u597d\u8655\uff0c\u5305\u62ec\u7372\u5f97\u7368\u5bb6\u4efb\u52d9\u3001\u5171\u4eab\u8cc7\u6e90\u548c\u652f\u6301\u6027\u793e\u7fa4\u3002\u4f8b\u5982\uff0c\u5de5\u6703\u6210\u54e1\u53ef\u4ee5\u5408\u4f5c\u64ca\u6557\u5177\u6709\u6311\u6230\u6027\u7684\u9996\u9818\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u8a55\u4f30\u4e0d\u540c\u5de5\u6703\u7684\u512a\u52e2\uff0c\u4ee5\u627e\u5230\u7b26\u5408\u4f60\u76ee\u6a19\u7684\u5de5\u6703\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u5929\u7a7a\u9a0e\u58eb\u300b\u4e2d\u512a\u5316\u89d2\u8272\u7684\u7d44\u6210\uff1f", "answer": "\u512a\u5316\u89d2\u8272\u7d44\u6210\u9700\u8981\u5e73\u8861\u5c6c\u6027\u548c\u6280\u80fd\u3002\u6b65\u9a5f1 - \u5206\u6790\u4f60\u7684\u904a\u6232\u98a8\u683c\uff0c\u9078\u64c7\u589e\u5f37\u904a\u6232\u98a8\u683c\u7684\u5c6c\u6027\u3002\u6b65\u9a5f2 - \u9078\u64c7\u8207\u4f60\u9078\u64c7\u7684\u5c6c\u6027\u76f8\u8f14\u76f8\u6210\u7684\u6280\u80fd\u3002\u6b65\u9a5f3 - \u5b9a\u671f\u6aa2\u8996\u548c\u8abf\u6574\u4f60\u7684\u7d44\u6210\uff0c\u6839\u64da\u8868\u73fe\u9032\u884c\u8abf\u6574\u3002\u4f8b\u5982\uff0c\u5e73\u8861\u7d44\u6210\u53ef\u80fd\u5305\u542b\u529b\u91cf\u548c\u654f\u6377\u7684\u7d44\u5408\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6bd4\u8f03\u4e0d\u540c\u7684\u5c6c\u6027\u5206\u914d\uff0c\u4ee5\u627e\u5230\u6700\u4f73\u8a2d\u5b9a\u3002]"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u904b\u884c\u300a\u5929\u7a7a\u9a0e\u58eb\u300b\u7684\u7cfb\u7d71\u9700\u6c42\u70ba\u4f55\uff1f", "answer": "\u300a\u5929\u7a7a\u9a0e\u58eb\u300b\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u7684\u7cfb\u7d71\u9700\u6c42\u5404\u4e0d\u76f8\u540c\u3002\u5c0d\u65bc PC\uff0c\u8acb\u78ba\u4fdd\u81f3\u5c11\u5177\u6709\u82f1\u7279\u723e i5 \u8655\u7406\u5668\u548c 8GB \u8a18\u61b6\u9ad4\u3002\u5c0d\u65bc\u4e3b\u6a5f\uff0c\u9019\u6b3e\u904a\u6232\u5728 PlayStation 5 \u548c Xbox Series X \u4e0a\u90fd\u80fd\u9806\u66a2\u904b\u884c\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6bd4\u8f03 PC \u548c\u4e3b\u6a5f\u7684\u7cfb\u7d71\u9700\u6c42\uff0c\u4ee5\u78ba\u4fdd\u76f8\u5bb9\u6027\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u5929\u7a7a\u9a0e\u58eb\u300b\u4e2d\u5c07\u9032\u5ea6\u5f9e\u4e00\u500b\u5e73\u53f0\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u5e73\u53f0\uff1f", "answer": "\u8981\u8f49\u79fb\u300a\u5929\u7a7a\u9a0e\u58eb\u300b\u4e2d\u7684\u9032\u5ea6\uff0c\u8acb\u4f7f\u7528\u904a\u6232\u7684\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u3002\u6b65\u9a5f1 - \u767b\u5165\u539f\u59cb\u5e73\u53f0\u7684\u5e33\u6236\u4e26\u4e0a\u50b3\u5132\u5b58\u8cc7\u6599\u3002\u6b65\u9a5f2 - \u767b\u5165\u65b0\u5e73\u53f0\u7684\u76f8\u540c\u5e33\u6236\u4e26\u4e0b\u8f09\u5132\u5b58\u8cc7\u6599\u3002\u4f8b\u5982\uff0c\u5f9e PC \u8f49\u79fb\u5230 PlayStation \u9700\u8981\u57f7\u884c\u9019\u4e9b\u7c21\u55ae\u6b65\u9a5f\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u9075\u5faa\u8996\u89ba\u6307\u5357\uff0c\u78ba\u4fdd\u9806\u5229\u8f49\u79fb\u6d41\u7a0b\u3002]"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728\u300a\u5929\u7a7a\u9a0e\u58eb\u300b\u4e2d\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\uff1f", "answer": "\u300a\u5929\u7a7a\u9a0e\u58eb\u300b\u5145\u6eff\u4e86\u96b1\u85cf\u7684\u5f69\u86cb\uff0c\u734e\u52f5\u73a9\u5bb6\u63a2\u7d22\u3002\u4f8b\u5982\uff0c\u5728\u300c\u5929\u7a7a\u5cf0\u300d\u5340\u57df\u627e\u5230\u96b1\u85cf\u7684\u5c71\u6d1e\u53ef\u4ee5\u89e3\u9396\u7a00\u6709\u7269\u54c1\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u5f69\u86cb\u60f3\u50cf\u6210\u6b63\u5728\u7b49\u5f85\u597d\u5947\u7684\u5192\u96aa\u8005\u767c\u73fe\u7684\u5bf6\u85cf\u3002]"}]
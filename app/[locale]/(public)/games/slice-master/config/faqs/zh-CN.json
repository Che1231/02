[{"question": "\u65b0\u624b\u5982\u4f55\u4f7f\u7528\u5207\u7247\u5927\u5e08\u4e2d\u7684\u5207\u7247\u673a\u5236\uff1f", "answer": "\u5207\u7247\u5927\u5e08\u7684\u5207\u7247\u673a\u5236\u76f4\u89c2\u6613\u61c2\uff0c\u4f46\u4e5f\u9700\u8981\u7cbe\u786e\u64cd\u4f5c\u3002\u4f8b\u5982\uff0c\u5207\u897f\u74dc\u65f6\uff0c\u60a8\u9700\u8981\u5728\u5c4f\u5e55\u4e0a\u4ee5\u6240\u9700\u65b9\u5411\u6ed1\u52a8\u624b\u6307\u3002\u6e38\u620f\u4f1a\u6839\u636e\u51c6\u786e\u6027\u5956\u52b1\u66f4\u9ad8\u7684\u5206\u6570\u3002\u6b65\u9aa41\uff1a\u786e\u5b9a\u76ee\u6807\u3002\u6b65\u9aa42\uff1a\u7cbe\u786e\u6ed1\u52a8\u3002\u6b65\u9aa43\uff1a\u7784\u51c6\u4e2d\u5fc3\u4ee5\u83b7\u5f97\u6700\u5927\u5206\u6570\u3002\u6b64\u673a\u5236\u65e8\u5728\u8ba9\u65b0\u73a9\u5bb6\u8f7b\u677e\u4e0a\u624b\uff0c\u540c\u65f6\u63d0\u4f9b\u7cbe\u901a\u7684\u6df1\u5ea6\u3002"}, {"question": "\u5728\u73a9\u5207\u7247\u5927\u5e08100\u5c0f\u65f6\u540e\uff0c\u54ea\u4e9b\u7b56\u7565\u80fd\u83b7\u5f97\u9ad8\u5206\uff1f", "answer": "100\u5c0f\u65f6\u540e\uff0c\u73a9\u5bb6\u5e94\u8be5\u4e13\u6ce8\u4e8e\u8fde\u51fb\u548c\u7cbe\u786e\u5ea6\u3002\u4f8b\u5982\uff0c\u5feb\u901f\u8fde\u7eed\u5207\u4e2d\u591a\u4e2a\u76ee\u6807\uff0c\u4e0d\u5931\u8bef\u4f1a\u63d0\u9ad8\u4f60\u7684\u500d\u6570\u3002\u6b65\u9aa41\uff1a\u4f18\u5148\u9009\u62e9\u5f7c\u6b64\u9760\u8fd1\u7684\u76ee\u6807\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u5feb\u901f\u3001\u7cbe\u786e\u7684\u6ed1\u52a8\u3002\u6b65\u9aa43\uff1a\u4fdd\u6301\u8282\u594f\uff0c\u8ba9\u8fde\u51fb\u6301\u7eed\u4e0b\u53bb\u3002\u8fd9\u79cd\u7b56\u7565\u7ed3\u5408\u4e86\u901f\u5ea6\u548c\u7cbe\u786e\u6027\uff0c\u5bf9\u4e8e\u9ad8\u5206\u81f3\u5173\u91cd\u8981\u3002[\u6d41\u7a0b\u56fe\uff1a\u76ee\u6807\u9009\u62e9 \u2192 \u6ed1\u52a8\u6267\u884c \u2192 \u8fde\u51fb\u7ef4\u62a4]"}, {"question": "\u4e3a\u4ec0\u4e48\u5207\u7247\u5927\u5e08\u7684\u8bc4\u5206\u7cfb\u7edf\u88ab\u8ba4\u4e3a\u5bf9\u4f11\u95f2\u548c\u786c\u6838\u73a9\u5bb6\u90fd\u5e73\u8861\uff1f", "answer": "\u5207\u7247\u5927\u5e08\u7684\u8bc4\u5206\u7cfb\u7edf\u4e4b\u6240\u4ee5\u5e73\u8861\uff0c\u662f\u56e0\u4e3a\u5b83\u5956\u52b1\u5feb\u901f\u4f11\u95f2\u7684\u73a9\u6cd5\uff0c\u4e5f\u5956\u52b1\u7cbe\u7ec6\u7684\u786c\u6838\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u4f11\u95f2\u73a9\u5bb6\u53ef\u4ee5\u4ee5\u81ea\u5df1\u7684\u8282\u594f\u5207\u5206\u76ee\u6807\uff0c\u800c\u786c\u6838\u73a9\u5bb6\u5219\u53ef\u4ee5\u8ffd\u6c42\u5b8c\u7f8e\u7684\u5207\u5206\u4ee5\u6700\u5927\u5316\u5f97\u5206\u3002\u8be5\u7cfb\u7edf\u4f7f\u7528\u500d\u6570\uff0c\u968f\u7740\u8fde\u7eed\u51c6\u786e\u7684\u5207\u5206\u800c\u589e\u52a0\uff0c\u5bf9\u6240\u6709\u6280\u80fd\u6c34\u5e73\u90fd\u516c\u5e73\u3002[\u6bd4\u8f83\uff1a\u4f11\u95f2\u4e0e\u786c\u6838\u8bc4\u5206]"}, {"question": "\u54ea\u4e9b\u9ad8\u7ea7\u6280\u5de7\u53ef\u4ee5\u5e2e\u52a9\u5728\u5207\u7247\u5927\u5e08\u4e2d\u5b9e\u73b0\u5b8c\u7f8e\u5207\u5206\uff1f", "answer": "\u5728\u5207\u7247\u5927\u5e08\u4e2d\u5b9e\u73b0\u5b8c\u7f8e\u5207\u5206\u9700\u8981\u638c\u63e1\u9ad8\u7ea7\u6280\u5de7\uff0c\u4f8b\u5982\u9884\u6d4b\u6ed1\u52a8\u548c\u89d2\u5ea6\u4f18\u5316\u3002\u4f8b\u5982\uff0c\u5f53\u5207\u5206\u79fb\u52a8\u76ee\u6807\u65f6\uff0c\u9884\u6d4b\u5176\u8def\u5f84\u5e76\u76f8\u5e94\u5730\u8c03\u6574\u60a8\u7684\u6ed1\u52a8\u3002\u6b65\u9aa41\uff1a\u89c2\u5bdf\u76ee\u6807\u79fb\u52a8\u3002\u6b65\u9aa42\uff1a\u9884\u6d4b\u8f68\u8ff9\u3002\u6b65\u9aa43\uff1a\u6267\u884c\u7cbe\u786e\u7684\u6ed1\u52a8\u3002\u6b64\u6280\u5de7\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u9519\u8bef\u5e76\u6700\u5927\u5316\u5f97\u5206\u6f5c\u529b\u3002[\u56fe\u8868\uff1a\u9884\u6d4b\u6ed1\u52a8\u8def\u5f84]"}, {"question": "\u6e38\u620f\u300a\u5207\u7247\u5927\u5e08\u300b\u5982\u4f55\u5904\u7406\u8de8\u5e73\u53f0\u6570\u636e\u8fc1\u79fb\uff1f", "answer": "\u300a\u5207\u7247\u5927\u5e08\u300b\u901a\u8fc7\u4e91\u4fdd\u5b58\u652f\u6301\u8de8\u5e73\u53f0\u6570\u636e\u8fc1\u79fb\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u4ece iOS \u8bbe\u5907\u5207\u6362\u5230 Android \u8bbe\u5907\uff0c\u60a8\u7684\u8fdb\u5ea6\u5c06\u88ab\u4fdd\u5b58\uff0c\u5e76\u53ef\u4ee5\u901a\u8fc7\u767b\u5f55\u60a8\u7684\u5e10\u6237\u6765\u68c0\u7d22\u3002\u6e38\u620f\u4f7f\u7528\u5b89\u5168\u4e14\u52a0\u5bc6\u7684\u4e91\u7cfb\u7edf\u6765\u786e\u4fdd\u6570\u636e\u5b8c\u6574\u6027\u3002\u6b64\u529f\u80fd\u5141\u8bb8\u73a9\u5bb6\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u65e0\u7f1d\u5730\u7ee7\u7eed\u4ed6\u4eec\u7684\u65c5\u7a0b\u3002[\u914d\u7f6e\uff1a\u4e91\u4fdd\u5b58\u8bbe\u7f6e]"}, {"question": "\u901a\u8fc7\u7279\u5b9a\u6210\u5c31\u53ef\u4ee5\u5728\u5207\u7247\u5927\u5e08\u4e2d\u89e3\u9501\u54ea\u4e9b\u9690\u85cf\u5185\u5bb9\uff1f", "answer": "\u300a\u5207\u7247\u5927\u5e08\u300b\u5305\u542b\u53ef\u901a\u8fc7\u5b8c\u6210\u7279\u5b9a\u6210\u5c31\u89e3\u9501\u7684\u9690\u85cf\u5185\u5bb9\u3002\u4f8b\u5982\uff0c\u8fde\u7eed\u5b8c\u7f8e\u5207\u5206100\u6b21\u5373\u53ef\u89e3\u9501\u7279\u6b8a\u5200\u7247\u76ae\u80a4\u3002\u6b64\u5185\u5bb9\u589e\u52a0\u4e86\u6e38\u620f\u7684\u6df1\u5ea6\uff0c\u5e76\u5956\u52b1\u6709\u6052\u5fc3\u7684\u73a9\u5bb6\u3002\u8fd9\u4e9b\u6210\u5c31\u65e8\u5728\u6311\u6218\u73a9\u5bb6\u5e76\u63d0\u4f9b\u6709\u610f\u4e49\u7684\u5956\u52b1\u3002[\u5217\u8868\uff1a\u6210\u5c31\u5956\u52b1]"}, {"question": "\u5207\u7247\u5927\u5e08\u4e2d\u7684\u76ee\u6807\u751f\u6210\u7b97\u6cd5\u662f\u5982\u4f55\u5de5\u4f5c\u7684\uff1f", "answer": "\u300a\u5207\u7247\u5927\u5e08\u300b\u4e2d\u7684\u76ee\u6807\u751f\u6210\u7b97\u6cd5\u65e8\u5728\u5e73\u8861\u96be\u5ea6\u548c\u53c2\u4e0e\u5ea6\u3002\u4f8b\u5982\uff0c\u76ee\u6807\u4f1a\u6839\u636e\u73a9\u5bb6\u5f53\u524d\u5f97\u5206\u548c\u8868\u73b0\u751f\u6210\u3002\u968f\u7740\u73a9\u5bb6\u7684\u8fdb\u6b65\uff0c\u8be5\u7b97\u6cd5\u4f1a\u63d0\u9ad8\u751f\u6210\u7387\u548c\u590d\u6742\u6027\uff0c\u786e\u4fdd\u52a8\u6001\u4e14\u5177\u6709\u6311\u6218\u6027\u7684\u4f53\u9a8c\u3002\u6b64\u7cfb\u7edf\u8ba9\u65b0\u8001\u73a9\u5bb6\u90fd\u4fdd\u6301\u6e38\u620f\u7684\u53c2\u4e0e\u5ea6\u3002[\u6d41\u7a0b\u56fe\uff1a\u751f\u6210\u7387\u8c03\u6574]"}, {"question": "\u4e3a\u4ec0\u4e48\u300a\u5207\u7247\u5927\u5e08\u300b\u4f7f\u7528\u52a8\u6001\u96be\u5ea6\u8c03\u6574\u7cfb\u7edf\uff1f", "answer": "\u300a\u5207\u7247\u5927\u5e08\u300b\u91c7\u7528\u52a8\u6001\u96be\u5ea6\u8c03\u6574\u7cfb\u7edf\uff0c\u4ee5\u9002\u5e94\u4e0d\u540c\u6280\u80fd\u6c34\u5e73\u7684\u73a9\u5bb6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u73a9\u5bb6\u9762\u4e34\u56f0\u96be\uff0c\u6e38\u620f\u4f1a\u964d\u4f4e\u76ee\u6807\u7684\u751f\u6210\u7387\u548c\u590d\u6742\u6027\u3002\u76f8\u53cd\uff0c\u5982\u679c\u73a9\u5bb6\u8868\u73b0\u51fa\u8272\uff0c\u6e38\u620f\u4f1a\u63d0\u9ad8\u6311\u6218\u6027\u3002\u6b64\u7cfb\u7edf\u786e\u4fdd\u6240\u6709\u73a9\u5bb6\u90fd\u80fd\u83b7\u5f97\u5e73\u8861\u4e14\u6109\u5feb\u7684\u6e38\u620f\u4f53\u9a8c\u3002[\u6bd4\u8f83\uff1a\u52a8\u6001\u4e0e\u9759\u6001\u96be\u5ea6]"}, {"question": "\u300a\u5207\u7247\u5927\u5e08\u300b\u4e2d\u4e0d\u540c\u5200\u7247\u7c7b\u578b\u4e4b\u95f4\u7684\u4e3b\u8981\u533a\u522b\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u5207\u7247\u5927\u5e08\u300b\u4e2d\u7684\u5200\u7247\u7c7b\u578b\u5728\u901f\u5ea6\u3001\u7cbe\u786e\u5ea6\u548c\u7279\u6b8a\u6548\u679c\u65b9\u9762\u6709\u6240\u4e0d\u540c\u3002\u4f8b\u5982\uff0c\u201c\u8fc5\u6377\u5200\u7247\u201d\u5141\u8bb8\u66f4\u5feb\u5730\u6ed1\u52a8\uff0c\u4f46\u7cbe\u5ea6\u8f83\u4f4e\uff0c\u800c\u201c\u7cbe\u786e\u5200\u7247\u201d\u5219\u5728\u8f83\u6162\u7684\u901f\u5ea6\u4e0b\u63d0\u4f9b\u66f4\u9ad8\u7684\u51c6\u786e\u6027\u3002\u6bcf\u79cd\u5200\u7247\u7c7b\u578b\u90fd\u9002\u5408\u4e0d\u540c\u7684\u6e38\u620f\u98ce\u683c\u548c\u7b56\u7565\u3002\u73a9\u5bb6\u53ef\u4ee5\u9009\u62e9\u6700\u9002\u5408\u5176\u5207\u7247\u65b9\u6cd5\u7684\u5200\u7247\u3002[\u8868\u683c\uff1a\u5200\u7247\u7c7b\u578b\u6bd4\u8f83]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u9650\u65f6\u6d3b\u52a8\u671f\u95f4\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u300a\u5207\u7247\u5927\u5e08\u300b\u4e2d\u7684\u6548\u7387\uff1f", "answer": "\u5728\u300a\u5207\u7247\u5927\u5e08\u300b\u7684\u9650\u65f6\u6d3b\u52a8\u671f\u95f4\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u6548\u7387\u9700\u8981\u6218\u7565\u89c4\u5212\u548c\u5feb\u901f\u6267\u884c\u3002\u4f8b\u5982\uff0c\u4e13\u6ce8\u4e8e\u9ad8\u4ef7\u503c\u76ee\u6807\u5e76\u4f7f\u7528\u9053\u5177\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u60a8\u7684\u5f97\u5206\u3002\u6b65\u9aa4 1\uff1a\u8bc6\u522b\u9ad8\u4ef7\u503c\u76ee\u6807\u3002\u6b65\u9aa4 2\uff1a\u6218\u7565\u6027\u5730\u5229\u7528\u9053\u5177\u3002\u6b65\u9aa4 3\uff1a\u4fdd\u6301\u5feb\u901f\u800c\u7cbe\u786e\u7684\u5207\u7247\u8282\u594f\u3002\u8fd9\u79cd\u65b9\u6cd5\u6709\u52a9\u4e8e\u73a9\u5bb6\u5728\u6709\u9650\u7684\u65f6\u95f4\u5185\u53d1\u6325\u6700\u5927\u7684\u4f5c\u7528\u3002[\u56fe\u8868\uff1a\u9650\u65f6\u6d3b\u52a8\u7b56\u7565]"}]
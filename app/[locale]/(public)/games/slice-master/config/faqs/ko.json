[{"question": "\uc2ac\ub77c\uc774\uc2a4 \ub9c8\uc2a4\ud130 \ucd08\ubcf4\uc790\ub97c \uc704\ud55c \uc2ac\ub77c\uc774\uc2f1 \uba54\ucee4\ub2c8\uc998\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "\uc2ac\ub77c\uc774\uc2a4 \ub9c8\uc2a4\ud130\uc5d0\uc11c \uc2ac\ub77c\uc774\uc2f1 \uba54\ucee4\ub2c8\uc998\uc740 \uc9c1\uad00\uc801\uc774\uc9c0\ub9cc \uc815\ud655\uc131\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc218\ubc15\uc744 \uc2ac\ub77c\uc774\uc2a4\ud560 \ub54c\ub294 \ud654\uba74 \uc0c1 \uc6d0\ud558\ub294 \ubc29\ud5a5\uc73c\ub85c \uc190\uac00\ub77d\uc744 \uc4f8\uc5b4\uc57c \ud569\ub2c8\ub2e4. \uac8c\uc784\uc740 \uc815\ud655\uc131\uc5d0 \ub530\ub77c \ub192\uc740 \uc810\uc218\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \ub300\uc0c1 \uc2dd\ubcc4. \ub2e8\uacc4 2: \uc815\ud655\ud558\uac8c \uc4f8\uae30. \ub2e8\uacc4 3: \ucd5c\ub300 \uc810\uc218\ub97c \uc704\ud574 \uc911\uc559\uc744 \ubaa9\ud45c\ub85c \ud569\ub2c8\ub2e4. \uc774 \uba54\ucee4\ub2c8\uc998\uc740 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c\ub294 \uc811\uadfc\uc131\uc774 \uc788\uc73c\uba74\uc11c, \uc219\ub2ec\uc744 \uc704\ud574 \uc2ec\ub3c4\ub97c \uc81c\uacf5\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4."}, {"question": "100\uc2dc\uac04 \uc774\uc0c1 \ud50c\ub808\uc774\ud55c \ud6c4 \uc2ac\ub77c\uc774\uc2a4 \ub9c8\uc2a4\ud130\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "100\uc2dc\uac04\uc774 \uc9c0\ub09c \ud6c4, \ud50c\ub808\uc774\uc5b4\ub294 \ucf64\ubcf4 \uccb4\uc778\uacfc \uc815\ud655\uc131\uc5d0 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc2e4\uc218 \uc5c6\uc774 \uc5ec\ub7ec \ub300\uc0c1\uc744 \uc5f0\uc18d\uc73c\ub85c \uc2ac\ub77c\uc774\uc2f1\ud558\uba74 \uba40\ud2f0\ud50c\ub77c\uc774\uc5b4\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \uac00\uae4c\uc774 \uc788\ub294 \ub300\uc0c1\uc744 \uc6b0\uc120\uc2dc\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ube60\ub974\uace0 \uc2e0\uc911\ud558\uac8c \uc4f8\uc5b4\uc90d\ub2c8\ub2e4. \ub2e8\uacc4 3: \ucf64\ubcf4\ub97c \uc720\uc9c0\ud558\uae30 \uc704\ud574 \ub9ac\ub4ec\uc744 \uc720\uc9c0\ud569\ub2c8\ub2e4. \uc774 \uc804\ub7b5\uc740 \ub192\uc740 \uc810\uc218\uc5d0 \ud544\uc218\uc801\uc778 \uc18d\ub3c4\uc640 \uc815\ud655\uc131 \ubaa8\ub450\ub97c \ud65c\uc6a9\ud569\ub2c8\ub2e4. [\uc21c\uc11c\ub3c4: \ub300\uc0c1 \uc120\ud0dd \u2192 \uc4f8\uae30 \uc2e4\ud589 \u2192 \ucf64\ubcf4 \uc720\uc9c0]"}, {"question": "\uc2ac\ub77c\uc774\uc2a4 \ub9c8\uc2a4\ud130\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc774 \uce90\uc8fc\uc5bc \ubc0f \ud558\ub4dc\ucf54\uc5b4 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub450\uc5d0\uac8c \uade0\ud615 \uc7a1\ud78c \uac83\uc73c\ub85c \uc5ec\uaca8\uc9c0\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc2ac\ub77c\uc774\uc2a4 \ub9c8\uc2a4\ud130\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ube60\ub974\uace0 \uce90\uc8fc\uc5bc\ud55c \ud50c\ub808\uc774\uc640 \uaf3c\uaf3c\ud558\uace0 \ud558\ub4dc\ucf54\uc5b4\ud55c \uc804\ub7b5 \ubaa8\ub450\uc5d0 \ubcf4\uc0c1\ud558\uae30 \ub54c\ubb38\uc5d0 \uade0\ud615\uc774 \ub9de\ucdb0\uc838 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uce90\uc8fc\uc5bc \ud50c\ub808\uc774\uc5b4\ub294 \uc790\uc2e0\uc758 \uc18d\ub3c4\ub85c \ub300\uc0c1\uc744 \uc2ac\ub77c\uc774\uc2f1\ud558\ub294 \uac83\uc744 \uc990\uae38 \uc218 \uc788\uace0, \ud558\ub4dc\ucf54\uc5b4 \ud50c\ub808\uc774\uc5b4\ub294 \uc644\ubcbd\ud55c \uc2ac\ub77c\uc774\uc2a4\ub97c \ubaa9\ud45c\ub85c \ud558\uc5ec \ucd5c\ub300 \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2dc\uc2a4\ud15c\uc740 \uc5f0\uc18d\uc801\uc778 \uc815\ud655\ud55c \uc2ac\ub77c\uc774\uc2a4\uc5d0 \ub530\ub77c \uc99d\uac00\ud558\ub294 \uba40\ud2f0\ud50c\ub77c\uc774\uc5b4\ub97c \uc0ac\uc6a9\ud558\uc5ec \ubaa8\ub4e0 \uc2e4\ub825 \ub808\ubca8\uc5d0\uac8c \uacf5\uc815\ud569\ub2c8\ub2e4. [\ube44\uad50: \uce90\uc8fc\uc5bc \ub300 \ud558\ub4dc\ucf54\uc5b4 \uc810\uc218]"}, {"question": "\uc2ac\ub77c\uc774\uc2a4 \ub9c8\uc2a4\ud130\uc5d0\uc11c \uc644\ubcbd\ud55c \uc2ac\ub77c\uc774\uc2a4\ub97c \ub2ec\uc131\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ub294 \uace0\uae09 \uae30\uc220\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc2ac\ub77c\uc774\uc2a4 \ub9c8\uc2a4\ud130\uc5d0\uc11c \uc644\ubcbd\ud55c \uc2ac\ub77c\uc774\uc2a4\ub97c \ub2ec\uc131\ud558\ub824\uba74 \uc608\uce21 \uc4f8\uae30 \ubc0f \uac01\ub3c4 \ucd5c\uc801\ud654\uc640 \uac19\uc740 \uace0\uae09 \uae30\uc220\uc744 \uc219\ub2ec\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc6c0\uc9c1\uc774\ub294 \ub300\uc0c1\uc744 \uc2ac\ub77c\uc774\uc2f1\ud560 \ub54c\ub294 \uadf8 \uacbd\ub85c\ub97c \uc608\uce21\ud558\uace0 \uc4f8\uae30\ub97c \uc870\uc815\ud574\uc57c \ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \ub300\uc0c1 \uc6c0\uc9c1\uc784 \uad00\ucc30. \ub2e8\uacc4 2: \uada4\uc801 \uc608\uce21. \ub2e8\uacc4 3: \uc815\ud655\ud55c \uc4f8\uae30\ub97c \uc2e4\ud589\ud569\ub2c8\ub2e4. \uc774 \uae30\uc220\uc740 \uc624\ub958\ub97c \ucd5c\uc18c\ud654\ud558\uace0 \uc810\uc218\ub97c \uadf9\ub300\ud654\ud569\ub2c8\ub2e4. [\ub3c4\ud45c: \uc608\uce21 \uc4f8\uae30 \uacbd\ub85c]"}, {"question": "\uac8c\uc784 \uc2ac\ub77c\uc774\uc2a4 \ub9c8\uc2a4\ud130\ub294 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ub370\uc774\ud130 \ub9c8\uc774\uadf8\ub808\uc774\uc158\uc744 \uc5b4\ub5bb\uac8c \ucc98\ub9ac\ud569\ub2c8\uae4c?", "answer": "\uc2ac\ub77c\uc774\uc2a4 \ub9c8\uc2a4\ud130\ub294 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ud1b5\ud574 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ub370\uc774\ud130 \ub9c8\uc774\uadf8\ub808\uc774\uc158\uc744 \uc9c0\uc6d0\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 iOS \uc7a5\uce58\uc5d0\uc11c Android \uc7a5\uce58\ub85c \uc804\ud658\ud558\uba74 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc800\uc7a5\ub418\uace0 \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uc5ec \uac80\uc0c9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784\uc740 \ub370\uc774\ud130 \ubb34\uacb0\uc131\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 \uc548\uc804\ud558\uace0 \uc554\ud638\ud654\ub41c \ud074\ub77c\uc6b0\ub4dc \uc2dc\uc2a4\ud15c\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc774 \uae30\ub2a5\uc744 \ud1b5\ud574 \ud50c\ub808\uc774\uc5b4\ub294 \uc11c\ub85c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc6d0\ud65c\ud558\uac8c \uc5ec\uc815\uc744 \uacc4\uc18d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131: \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uc124\uc815]"}, {"question": "\ud2b9\uc815 \uc5c5\uc801\uc744 \ud1b5\ud574 \uc2ac\ub77c\uc774\uc2a4 \ub9c8\uc2a4\ud130\uc5d0\uc11c \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \uc5b4\ub5bb\uac8c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc2ac\ub77c\uc774\uc2a4 \ub9c8\uc2a4\ud130\uc5d0\ub294 \ud2b9\uc815 \uc5c5\uc801\uc744 \uc644\ub8cc\ud558\uc5ec \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5f0\uc18d 100\ubc88\uc758 \uc644\ubcbd\ud55c \uc2ac\ub77c\uc774\uc2a4\ub97c \ub2ec\uc131\ud558\uba74 \ud2b9\ubcc4\ud55c \ube14\ub808\uc774\ub4dc \uc2a4\ud0a8\uc744 \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \ucf58\ud150\uce20\ub294 \uac8c\uc784\uc5d0 \uc2ec\ub3c4\ub97c \ub354\ud558\uace0 \uc5f4\uc815\uc801\uc778 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ubcf4\uc0c1\ud569\ub2c8\ub2e4. \uc5c5\uc801\uc740 \ud50c\ub808\uc774\uc5b4\ub97c \ub3c4\uc804\ud558\uace0 \uc758\ubbf8 \uc788\ub294 \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. [\ubaa9\ub85d: \uc5c5\uc801 \ubcf4\uc0c1]"}, {"question": "\uc2ac\ub77c\uc774\uc2a4 \ub9c8\uc2a4\ud130\uc5d0\uc11c \ub300\uc0c1 \uc0dd\uc131 \uc54c\uace0\ub9ac\uc998\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "\uc2ac\ub77c\uc774\uc2a4 \ub9c8\uc2a4\ud130\uc758 \ub300\uc0c1 \uc0dd\uc131 \uc54c\uace0\ub9ac\uc998\uc740 \ub09c\uc774\ub3c4\uc640 \ucc38\uc5ec\ub3c4\ub97c \uade0\ud615 \uc788\uac8c \uc720\uc9c0\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub300\uc0c1\uc740 \ud50c\ub808\uc774\uc5b4\uc758 \ud604\uc7ac \uc810\uc218\uc640 \uc131\ub2a5\uc5d0 \ub530\ub77c \uc0dd\uc131\ub429\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\uac00 \uc9c4\ud589\ud568\uc5d0 \ub530\ub77c \uc54c\uace0\ub9ac\uc998\uc740 \uc0dd\uc131 \uc18d\ub3c4\uc640 \ubcf5\uc7a1\uc131\uc744 \ub192\uc5ec \uc5ed\ub3d9\uc801\uc774\uace0 \ub3c4\uc804\uc801\uc778 \uacbd\ud5d8\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uc640 \uacbd\ud5d8\uc774 \ud48d\ubd80\ud55c \ud50c\ub808\uc774\uc5b4 \ubaa8\ub450\uc5d0\uac8c \uac8c\uc784\uc744 \ub9e4\ub825\uc801\uc73c\ub85c \uc720\uc9c0\ud569\ub2c8\ub2e4. [\uc21c\uc11c\ub3c4: \uc0dd\uc131 \uc18d\ub3c4 \uc870\uc808]"}, {"question": "\uc2ac\ub77c\uc774\uc2a4 \ub9c8\uc2a4\ud130\uac00 \ub3d9\uc801 \ub09c\uc774\ub3c4 \uc870\uc815 \uc2dc\uc2a4\ud15c\uc744 \uc0ac\uc6a9\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc2ac\ub77c\uc774\uc2a4 \ub9c8\uc2a4\ud130\ub294 \ud50c\ub808\uc774\uc5b4\uc758 \ub2e4\uc591\ud55c \uc2e4\ub825 \uc218\uc900\uc744 \uace0\ub824\ud558\uae30 \uc704\ud574 \ub3d9\uc801 \ub09c\uc774\ub3c4 \uc870\uc815 \uc2dc\uc2a4\ud15c\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud50c\ub808\uc774\uc5b4\uac00 \uc5b4\ub824\uc6c0\uc744 \uacaa\uc73c\uba74 \uac8c\uc784\uc740 \ub300\uc0c1\uc758 \uc0dd\uc131 \uc18d\ub3c4\uc640 \ubcf5\uc7a1\uc131\uc744 \uc904\uc785\ub2c8\ub2e4. \ubc18\ub300\ub85c, \ud50c\ub808\uc774\uc5b4\uac00 \ub6f0\uc5b4\ub098\uba74 \uac8c\uc784\uc740 \ub09c\uc774\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc744 \ud1b5\ud574 \ubaa8\ub4e0 \ud50c\ub808\uc774\uc5b4\uac00 \uade0\ud615 \uc788\uace0 \uc990\uac70\uc6b4 \uacbd\ud5d8\uc744 \ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. [\ube44\uad50: \ub3d9\uc801 \ub300 \uc815\uc801 \ub09c\uc774\ub3c4]"}, {"question": "\uc2ac\ub77c\uc774\uc2a4 \ub9c8\uc2a4\ud130\uc758 \ub2e4\uc591\ud55c \ube14\ub808\uc774\ub4dc \uc720\ud615 \uac04\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc2ac\ub77c\uc774\uc2a4 \ub9c8\uc2a4\ud130\uc758 \ube14\ub808\uc774\ub4dc \uc720\ud615\uc740 \uc18d\ub3c4, \uc815\ubc00\ub3c4 \ubc0f \ud2b9\uc218 \ud6a8\uacfc\uac00 \ub2e4\ub985\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ube60\ub978 \ube14\ub808\uc774\ub4dc\"\ub294 \ub354 \ube60\ub978 \uc4f8\uae30\ub97c \ud5c8\uc6a9\ud558\uc9c0\ub9cc \uc815\ubc00\ub3c4\uac00 \ub0ae\uc740 \ubc18\uba74, \"\uc815\ubc00 \ube14\ub808\uc774\ub4dc\"\ub294 \ub354 \ub290\ub9b0 \uc18d\ub3c4\ub85c \ub354 \ub192\uc740 \uc815\ud655\ub3c4\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \uac01 \ube14\ub808\uc774\ub4dc \uc720\ud615\uc740 \ub2e4\ub978 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uacfc \uc804\ub7b5\uc5d0 \ub9de\ucdb0\uc838 \uc788\uc2b5\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\ub294 \uc2ac\ub77c\uc774\uc2f1\uc5d0 \uac00\uc7a5 \uc801\ud569\ud55c \ube14\ub808\uc774\ub4dc\ub97c \uc120\ud0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud45c: \ube14\ub808\uc774\ub4dc \uc720\ud615 \ube44\uad50]"}, {"question": "\ud0c0\uc784 \uc774\ubca4\ud2b8 \uae30\uac04 \ub3d9\uc548 \uc2ac\ub77c\uc774\uc2a4 \ub9c8\uc2a4\ud130\uc5d0\uc11c \ud6a8\uc728\uc744 \uadf9\ub300\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc2ac\ub77c\uc774\uc2a4 \ub9c8\uc2a4\ud130\uc5d0\uc11c \ud0c0\uc784 \uc774\ubca4\ud2b8 \uae30\uac04 \ub3d9\uc548 \ud6a8\uc728\uc744 \uadf9\ub300\ud654\ud558\ub824\uba74 \uc804\ub7b5\uc801\uc778 \uacc4\ud68d\uacfc \uc2e0\uc18d\ud55c \uc2e4\ud589\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uace0\uac00\uce58 \ub300\uc0c1\uc5d0 \uc9d1\uc911\ud558\uace0 \uac15\ud654 \uc544\uc774\ud15c\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uba74 \uc810\uc218\ub97c \ud06c\uac8c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \uace0\uac00\uce58 \ub300\uc0c1 \uc2dd\ubcc4. \ub2e8\uacc4 2: \uac15\ud654 \uc544\uc774\ud15c\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \ud65c\uc6a9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ube60\ub974\uba74\uc11c\ub3c4 \uc815\ud655\ud55c \uc2ac\ub77c\uc774\uc2f1 \ub9ac\ub4ec\uc744 \uc720\uc9c0\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc811\uadfc \ubc29\uc2dd\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc81c\ud55c\ub41c \uc2dc\uac04\uc744 \ucd5c\ub300\ud55c \ud65c\uc6a9\ud558\ub3c4\ub85d \ub3d5\uc2b5\ub2c8\ub2e4. [\ub3c4\ud45c: \ud0c0\uc784 \uc774\ubca4\ud2b8 \uc804\ub7b5]"}]
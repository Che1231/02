[{"question": "\u65b0\u624b\u73a9\u5bb6\u5728\u300a\u5207\u7247\u5927\u5e2b\u300b\u4e2d\u5207\u7247\u6a5f\u5236\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u5728\u300a\u5207\u7247\u5927\u5e2b\u300b\u4e2d\uff0c\u5207\u7247\u6a5f\u5236\u76f4\u89c0\u6613\u61c2\uff0c\u4f46\u9700\u8981\u7cbe\u6e96\u7684\u64cd\u4f5c\u3002\u4f8b\u5982\uff0c\u5207\u897f\u74dc\u6642\uff0c\u60a8\u9700\u8981\u5728\u87a2\u5e55\u4e0a\u4ee5\u60a8\u60f3\u8981\u7684\u65b9\u56ae\u6ed1\u52d5\u60a8\u7684\u624b\u6307\u3002\u904a\u6232\u6703\u6839\u64da\u7cbe\u78ba\u5ea6\u734e\u52f5\u66f4\u9ad8\u5206\u6578\u3002\u6b65\u9a5f 1\uff1a\u8b58\u5225\u76ee\u6a19\u3002\u6b65\u9a5f 2\uff1a\u7cbe\u78ba\u6ed1\u52d5\u3002\u6b65\u9a5f 3\uff1a\u7784\u6e96\u4e2d\u5fc3\u4ee5\u6700\u5927\u5316\u5f97\u5206\u3002\u6b64\u6a5f\u5236\u8a2d\u8a08\u8b93\u65b0\u73a9\u5bb6\u6613\u65bc\u4e0a\u624b\uff0c\u540c\u6642\u4e5f\u63d0\u4f9b\u4e86\u9032\u968e\u73a9\u5bb6\u6311\u6230\u7684\u6df1\u5ea6\u3002"}, {"question": "\u5728\u300a\u5207\u7247\u5927\u5e2b\u300b\u904a\u6232\u4e2d\uff0c\u7d93\u904e 100 \u5c0f\u6642\u7684\u904a\u6232\u5f8c\uff0c\u5982\u4f55\u624d\u80fd\u7372\u5f97\u9ad8\u5206\uff1f", "answer": "\u7d93\u904e 100 \u500b\u5c0f\u6642\u7684\u904a\u6232\u5f8c\uff0c\u73a9\u5bb6\u61c9\u8a72\u5c08\u6ce8\u65bc\u9023\u64ca\u548c\u7cbe\u6e96\u5ea6\u3002\u4f8b\u5982\uff0c\u5feb\u901f\u9023\u7e8c\u5207\u7247\u591a\u500b\u76ee\u6a19\uff0c\u4e14\u4e0d\u5931\u8aa4\uff0c\u53ef\u63d0\u5347\u4f60\u7684\u500d\u6578\u3002\u6b65\u9a5f 1\uff1a\u512a\u5148\u9078\u64c7\u5f7c\u6b64\u9760\u8fd1\u7684\u76ee\u6a19\u3002\u6b65\u9a5f 2\uff1a\u4f7f\u7528\u5feb\u901f\u4e14\u7cbe\u78ba\u7684\u6ed1\u52d5\u3002\u6b65\u9a5f 3\uff1a\u4fdd\u6301\u7bc0\u594f\uff0c\u4fdd\u6301\u9023\u64ca\u3002\u6b64\u7b56\u7565\u904b\u7528\u901f\u5ea6\u548c\u7cbe\u78ba\u5ea6\uff0c\u9019\u5c0d\u65bc\u9ad8\u5206\u81f3\u95dc\u91cd\u8981\u3002 [\u6d41\u7a0b\u5716\uff1a\u76ee\u6a19\u9078\u64c7 \u2192 \u6ed1\u52d5\u57f7\u884c \u2192 \u9023\u64ca\u7dad\u8b77]"}, {"question": "\u70ba\u4ec0\u9ebc\u300a\u5207\u7247\u5927\u5e2b\u300b\u7684\u8a08\u5206\u7cfb\u7d71\u88ab\u8a8d\u70ba\u5c0d\u4f11\u9592\u73a9\u5bb6\u548c\u6838\u5fc3\u73a9\u5bb6\u4f86\u8aaa\u90fd\u5747\u8861\uff1f", "answer": "\u300a\u5207\u7247\u5927\u5e2b\u300b\u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5747\u8861\u7684\uff0c\u56e0\u70ba\u5b83\u734e\u52f5\u5feb\u901f\u3001\u4f11\u9592\u7684\u904a\u6232\u65b9\u5f0f\u548c\u4ed4\u7d30\u3001\u6838\u5fc3\u7684\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u4f11\u9592\u73a9\u5bb6\u53ef\u4ee5\u6309\u7167\u81ea\u5df1\u7684\u6b65\u8abf\u5207\u7247\u76ee\u6a19\uff0c\u800c\u6838\u5fc3\u73a9\u5bb6\u5247\u53ef\u4ee5\u8ffd\u6c42\u5b8c\u7f8e\u7684\u5207\u7247\u4ee5\u6700\u5927\u5316\u5f97\u5206\u3002\u6b64\u7cfb\u7d71\u4f7f\u7528\u500d\u6578\uff0c\u96a8\u8457\u9023\u7e8c\u7cbe\u78ba\u5207\u7247\u6703\u589e\u52a0\uff0c\u6240\u4ee5\u5c0d\u6240\u6709\u6280\u80fd\u7b49\u7d1a\u90fd\u516c\u5e73\u3002 [\u6bd4\u8f03\uff1a\u4f11\u9592\u73a9\u5bb6 vs. \u6838\u5fc3\u73a9\u5bb6\u7684\u8a08\u5206]"}, {"question": "\u5728\u300a\u5207\u7247\u5927\u5e2b\u300b\u4e2d\uff0c\u54ea\u4e9b\u5148\u9032\u6280\u8853\u53ef\u4ee5\u5e6b\u52a9\u73a9\u5bb6\u7372\u5f97\u5b8c\u7f8e\u7684\u5207\u7247\uff1f", "answer": "\u5728\u300a\u5207\u7247\u5927\u5e2b\u300b\u4e2d\uff0c\u8981\u5be6\u73fe\u5b8c\u7f8e\u7684\u5207\u7247\uff0c\u9700\u8981\u638c\u63e1\u5148\u9032\u6280\u5de7\uff0c\u4f8b\u5982\u9810\u6e2c\u6ed1\u52d5\u548c\u89d2\u5ea6\u512a\u5316\u3002\u4f8b\u5982\uff0c\u7576\u5207\u7247\u79fb\u52d5\u76ee\u6a19\u6642\uff0c\u8acb\u9810\u6e2c\u5176\u8def\u5f91\u4e26\u76f8\u61c9\u5730\u8abf\u6574\u6ed1\u52d5\u3002\u6b65\u9a5f 1\uff1a\u89c0\u5bdf\u76ee\u6a19\u7684\u79fb\u52d5\u3002\u6b65\u9a5f 2\uff1a\u9810\u6e2c\u8ecc\u8de1\u3002\u6b65\u9a5f 3\uff1a\u57f7\u884c\u7cbe\u78ba\u7684\u6ed1\u52d5\u3002\u6b64\u6280\u8853\u53ef\u6e1b\u5c11\u932f\u8aa4\u4e26\u6700\u5927\u5316\u5f97\u5206\u6f5b\u529b\u3002 [\u5716\u89e3\uff1a\u9810\u6e2c\u6ed1\u52d5\u8def\u5f91]"}, {"question": "\u300a\u5207\u7247\u5927\u5e2b\u300b\u5982\u4f55\u8655\u7406\u8de8\u5e73\u53f0\u7684\u8cc7\u6599\u9077\u79fb\uff1f", "answer": "\u300a\u5207\u7247\u5927\u5e2b\u300b\u652f\u63f4\u900f\u904e\u96f2\u7aef\u5132\u5b58\u4f86\u9032\u884c\u8de8\u5e73\u53f0\u8cc7\u6599\u9077\u79fb\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9e iOS \u88dd\u7f6e\u5207\u63db\u5230 Android \u88dd\u7f6e\uff0c\u60a8\u7684\u9032\u5ea6\u6703\u5132\u5b58\uff0c\u4e26\u53ef\u900f\u904e\u767b\u5165\u60a8\u7684\u5e33\u6236\u4f86\u6aa2\u7d22\u3002\u904a\u6232\u4f7f\u7528\u5b89\u5168\u7684\u52a0\u5bc6\u96f2\u7aef\u7cfb\u7d71\u4f86\u78ba\u4fdd\u8cc7\u6599\u5b8c\u6574\u6027\u3002\u6b64\u529f\u80fd\u8b93\u73a9\u5bb6\u53ef\u4ee5\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u7121\u7e2b\u5730\u7e7c\u7e8c\u4ed6\u5011\u7684\u65c5\u7a0b\u3002 [\u8a2d\u5b9a\uff1a\u96f2\u7aef\u5132\u5b58\u8a2d\u5b9a]"}, {"question": "\u900f\u904e\u7279\u5b9a\u6210\u5c31\uff0c\u53ef\u4ee5\u5728\u300a\u5207\u7247\u5927\u5e2b\u300b\u4e2d\u89e3\u9396\u54ea\u4e9b\u96b1\u85cf\u5167\u5bb9\uff1f", "answer": "\u300a\u5207\u7247\u5927\u5e2b\u300b\u5305\u542b\u53ef\u900f\u904e\u5b8c\u6210\u7279\u5b9a\u6210\u5c31\u89e3\u9396\u7684\u96b1\u85cf\u5167\u5bb9\u3002\u4f8b\u5982\uff0c\u5728\u4e00\u9023\u4e32 100 \u6b21\u5b8c\u7f8e\u5207\u7247\u5f8c\uff0c\u6703\u89e3\u9396\u7279\u6b8a\u5200\u7247\u5916\u89c0\u3002\u6b64\u5167\u5bb9\u70ba\u904a\u6232\u589e\u6dfb\u6df1\u5ea6\uff0c\u4e26\u734e\u52f5\u52aa\u529b\u7684\u73a9\u5bb6\u3002\u6210\u5c31\u8a2d\u8a08\u7528\u65bc\u6311\u6230\u73a9\u5bb6\uff0c\u4e26\u63d0\u4f9b\u6709\u610f\u7fa9\u7684\u734e\u52f5\u3002 [\u6e05\u55ae\uff1a\u6210\u5c31\u734e\u52f5]"}, {"question": "\u300a\u5207\u7247\u5927\u5e2b\u300b\u4e2d\u7684\u76ee\u6a19\u7522\u751f\u6f14\u7b97\u6cd5\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u300a\u5207\u7247\u5927\u5e2b\u300b\u4e2d\u7684\u76ee\u6a19\u7522\u751f\u6f14\u7b97\u6cd5\u65e8\u5728\u5e73\u8861\u96e3\u5ea6\u548c\u53c3\u8207\u5ea6\u3002\u4f8b\u5982\uff0c\u76ee\u6a19\u6703\u6839\u64da\u73a9\u5bb6\u76ee\u524d\u7684\u5f97\u5206\u548c\u8868\u73fe\u800c\u7522\u751f\u3002\u96a8\u8457\u73a9\u5bb6\u9032\u968e\uff0c\u6f14\u7b97\u6cd5\u6703\u589e\u52a0\u7522\u751f\u7684\u901f\u7387\u548c\u8907\u96dc\u5ea6\uff0c\u78ba\u4fdd\u904a\u6232\u7d93\u9a57\u65e2\u52d5\u614b\u53c8\u5177\u6311\u6230\u6027\u3002\u6b64\u7cfb\u7d71\u8b93\u65b0\u73a9\u5bb6\u548c\u8cc7\u6df1\u73a9\u5bb6\u90fd\u80fd\u5920\u4fdd\u6301\u904a\u6232\u7684\u53c3\u8207\u5ea6\u3002 [\u6d41\u7a0b\u5716\uff1a\u7522\u51fa\u901f\u7387\u8abf\u6574]"}, {"question": "\u70ba\u4ec0\u9ebc\u300a\u5207\u7247\u5927\u5e2b\u300b\u4f7f\u7528\u52d5\u614b\u96e3\u5ea6\u8abf\u6574\u7cfb\u7d71\uff1f", "answer": "\u300a\u5207\u7247\u5927\u5e2b\u300b\u63a1\u7528\u52d5\u614b\u96e3\u5ea6\u8abf\u6574\u7cfb\u7d71\uff0c\u4ee5\u6eff\u8db3\u4e0d\u540c\u6280\u80fd\u6c34\u5e73\u7684\u73a9\u5bb6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u73a9\u5bb6\u6709\u56f0\u96e3\uff0c\u904a\u6232\u6703\u964d\u4f4e\u76ee\u6a19\u7522\u751f\u901f\u7387\u548c\u8907\u96dc\u5ea6\u3002\u76f8\u53cd\u5730\uff0c\u5982\u679c\u73a9\u5bb6\u8868\u73fe\u51fa\u8272\uff0c\u904a\u6232\u5247\u6703\u589e\u52a0\u6311\u6230\u3002\u6b64\u7cfb\u7d71\u78ba\u4fdd\u6240\u6709\u73a9\u5bb6\u90fd\u80fd\u7372\u5f97\u5747\u8861\u4e14\u6109\u5feb\u7684\u904a\u6232\u9ad4\u9a57\u3002 [\u6bd4\u8f03\uff1a\u52d5\u614b\u96e3\u5ea6 vs. \u975c\u614b\u96e3\u5ea6]"}, {"question": "\u300a\u5207\u7247\u5927\u5e2b\u300b\u4e2d\u5404\u7a2e\u5200\u7247\u985e\u578b\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "\u300a\u5207\u7247\u5927\u5e2b\u300b\u4e2d\u7684\u5200\u7247\u985e\u578b\u5728\u901f\u5ea6\u3001\u7cbe\u6e96\u5ea6\u548c\u7279\u6b8a\u6548\u679c\u65b9\u9762\u6709\u6240\u4e0d\u540c\u3002\u4f8b\u5982\uff0c\u300c\u8fc5\u6377\u5200\u7247\u300d\u5141\u8a31\u66f4\u5feb\u7684\u6ed1\u52d5\uff0c\u4f46\u7cbe\u6e96\u5ea6\u8f03\u4f4e\uff1b\u800c\u300c\u7cbe\u78ba\u5200\u7247\u300d\u5247\u63d0\u4f9b\u8f03\u9ad8\u7684\u7cbe\u78ba\u5ea6\uff0c\u4f46\u901f\u5ea6\u8f03\u6162\u3002\u6bcf\u7a2e\u5200\u7247\u985e\u578b\u90fd\u9069\u5408\u4e0d\u540c\u7684\u904a\u6232\u98a8\u683c\u548c\u7b56\u7565\u3002\u73a9\u5bb6\u53ef\u4ee5\u9078\u64c7\u6700\u9069\u5408\u4ed6\u5011\u5207\u7247\u65b9\u6cd5\u7684\u5200\u7247\u3002 [\u8868\u683c\uff1a\u5200\u7247\u985e\u578b\u6bd4\u8f03]"}, {"question": "\u5728\u300a\u5207\u7247\u5927\u5e2b\u300b\u7684\u9650\u6642\u6d3b\u52d5\u4e2d\uff0c\u73a9\u5bb6\u5982\u4f55\u6700\u5927\u5316\u6548\u7387\uff1f", "answer": "\u5728\u300a\u5207\u7247\u5927\u5e2b\u300b\u7684\u9650\u6642\u6d3b\u52d5\u4e2d\uff0c\u6700\u5927\u5316\u6548\u7387\u9700\u8981\u7b56\u7565\u898f\u5283\u548c\u5feb\u901f\u57f7\u884c\u3002\u4f8b\u5982\uff0c\u5c08\u6ce8\u65bc\u9ad8\u50f9\u503c\u76ee\u6a19\u4e26\u4f7f\u7528\u589e\u5f37\u9053\u5177\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u60a8\u7684\u5f97\u5206\u3002\u6b65\u9a5f 1\uff1a\u8b58\u5225\u9ad8\u50f9\u503c\u76ee\u6a19\u3002\u6b65\u9a5f 2\uff1a\u7b56\u7565\u6027\u5730\u5229\u7528\u589e\u5f37\u9053\u5177\u3002\u6b65\u9a5f 3\uff1a\u4fdd\u6301\u5feb\u901f\u4e14\u7cbe\u78ba\u7684\u5207\u7247\u7bc0\u594f\u3002\u6b64\u65b9\u6cd5\u6709\u52a9\u65bc\u73a9\u5bb6\u5145\u5206\u5229\u7528\u6709\u9650\u7684\u6642\u9593\u3002 [\u5716\u89e3\uff1a\u9650\u6642\u6d3b\u52d5\u7b56\u7565]"}]
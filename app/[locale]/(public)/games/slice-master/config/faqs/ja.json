[{"question": "\u30b9\u30e9\u30a4\u30b9\u30de\u30b9\u30bf\u30fc\u306e\u521d\u5fc3\u8005\u5411\u3051\u306e\u30b9\u30e9\u30a4\u30b9\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30b9\u30e9\u30a4\u30b9\u30de\u30b9\u30bf\u30fc\u306e\u30b9\u30e9\u30a4\u30b9\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u76f4\u611f\u7684\u3067\u3042\u308a\u306a\u304c\u3089\u3001\u6b63\u78ba\u3055\u3092\u5fc5\u8981\u3068\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b9\u30a4\u30ab\u3092\u30b9\u30e9\u30a4\u30b9\u3059\u308b\u969b\u306b\u3001\u753b\u9762\u4e0a\u3067\u5fc5\u8981\u306a\u65b9\u5411\u306b\u6307\u3092\u306a\u305e\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306f\u6b63\u78ba\u3055\u306b\u5fdc\u3058\u3066\u9ad8\u5f97\u70b9\u3092\u4e0e\u3048\u307e\u3059\u3002\u624b\u98061\uff1a\u76ee\u6a19\u3092\u7279\u5b9a\u3059\u308b\u3002\u624b\u98062\uff1a\u6b63\u78ba\u306b\u306a\u305e\u308b\u3002\u624b\u98063\uff1a\u30dd\u30a4\u30f3\u30c8\u3092\u6700\u5927\u5316\u3059\u308b\u305f\u3081\u306b\u4e2d\u5fc3\u3092\u72d9\u3046\u3002\u3053\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u65b0\u3057\u3044\u30d7\u30ec\u30fc\u30e4\u30fc\u306b\u3068\u3063\u3066\u30a2\u30af\u30bb\u30b9\u3057\u3084\u3059\u304f\u3001\u540c\u6642\u306b\u719f\u7df4\u8005\u306b\u3068\u3063\u3066\u5965\u884c\u304d\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "100\u6642\u9593\u30d7\u30ec\u30a4\u5f8c\u3001\u30b9\u30e9\u30a4\u30b9\u30de\u30b9\u30bf\u30fc\u3067\u9ad8\u5f97\u70b9\u3092\u7372\u5f97\u3059\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "100\u6642\u9593\u30d7\u30ec\u30a4\u5f8c\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30b3\u30f3\u30dc\u30c1\u30a7\u30fc\u30f3\u3068\u6b63\u78ba\u3055\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30df\u30b9\u3059\u308b\u3053\u3068\u306a\u304f\u3001\u8907\u6570\u306e\u6a19\u7684\u3092\u9023\u7d9a\u3057\u3066\u30b9\u30e9\u30a4\u30b9\u3059\u308b\u3068\u3001\u4e57\u6570\u304c\u4e0a\u6607\u3057\u307e\u3059\u3002\u624b\u98061\uff1a\u8fd1\u63a5\u3057\u3066\u3044\u308b\u6a19\u7684\u3092\u512a\u5148\u3059\u308b\u3002\u624b\u98062\uff1a\u7d20\u65e9\u304f\u614e\u91cd\u306b\u30b9\u30e9\u30a4\u30b9\u3059\u308b\u3002\u624b\u98063\uff1a\u30b3\u30f3\u30dc\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u30ea\u30ba\u30e0\u3092\u7dad\u6301\u3059\u308b\u3002\u3053\u306e\u6226\u7565\u306f\u3001\u9ad8\u5f97\u70b9\u7372\u5f97\u306b\u4e0d\u53ef\u6b20\u306a\u901f\u5ea6\u3068\u6b63\u78ba\u6027\u306e\u4e21\u65b9\u3092\u6d3b\u7528\u3057\u3066\u3044\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30bf\u30fc\u30b2\u30c3\u30c8\u9078\u629e\u2192\u30b9\u30ef\u30a4\u30d7\u5b9f\u884c\u2192\u30b3\u30f3\u30dc\u7dad\u6301]"}, {"question": "\u30b9\u30e9\u30a4\u30b9\u30de\u30b9\u30bf\u30fc\u306e\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30ab\u30b8\u30e5\u30a2\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u30cf\u30fc\u30c9\u30b3\u30a2\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u4e21\u65b9\u306b\u3068\u3063\u3066\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u30b7\u30b9\u30c6\u30e0\u3068\u898b\u306a\u3055\u308c\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30e9\u30a4\u30b9\u30de\u30b9\u30bf\u30fc\u306e\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u8fc5\u901f\u306a\u30ab\u30b8\u30e5\u30a2\u30eb\u306a\u30d7\u30ec\u30a4\u3068\u7dbf\u5bc6\u306a\u30cf\u30fc\u30c9\u30b3\u30a2\u306e\u6226\u7565\u306e\u4e21\u65b9\u306b\u5bfe\u3057\u3066\u5831\u916c\u3092\u4e0e\u3048\u308b\u305f\u3081\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u30b7\u30b9\u30c6\u30e0\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ab\u30b8\u30e5\u30a2\u30eb\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u81ea\u5206\u306e\u30da\u30fc\u30b9\u3067\u6a19\u7684\u3092\u30b9\u30e9\u30a4\u30b9\u3092\u697d\u3057\u3080\u3053\u3068\u304c\u3067\u304d\u3001\u30cf\u30fc\u30c9\u30b3\u30a2\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u5b8c\u74a7\u306a\u30b9\u30e9\u30a4\u30b9\u3092\u76ee\u6307\u3057\u3066\u30dd\u30a4\u30f3\u30c8\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u3002\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u9023\u7d9a\u3057\u305f\u6b63\u78ba\u306a\u30b9\u30e9\u30a4\u30b9\u3068\u4e57\u6570\u3092\u5897\u3084\u3059\u3053\u3068\u3067\u3001\u3059\u3079\u3066\u306e\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u306b\u5bfe\u3057\u3066\u516c\u5e73\u306b\u306a\u308a\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u30ab\u30b8\u30e5\u30a2\u30eb vs. \u30cf\u30fc\u30c9\u30b3\u30a2\u5f97\u70b9]"}, {"question": "\u30b9\u30e9\u30a4\u30b9\u30de\u30b9\u30bf\u30fc\u3067\u5b8c\u74a7\u306a\u30b9\u30e9\u30a4\u30b9\u3092\u9054\u6210\u3059\u308b\u305f\u3081\u306b\u5f79\u7acb\u3064\u9ad8\u5ea6\u306a\u30c6\u30af\u30cb\u30c3\u30af\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30e9\u30a4\u30b9\u30de\u30b9\u30bf\u30fc\u3067\u5b8c\u74a7\u306a\u30b9\u30e9\u30a4\u30b9\u3092\u9054\u6210\u3059\u308b\u306b\u306f\u3001\u4e88\u6e2c\u7684\u306a\u30b9\u30ef\u30a4\u30d7\u3068\u89d2\u5ea6\u6700\u9069\u5316\u306a\u3069\u306e\u9ad8\u5ea6\u306a\u30c6\u30af\u30cb\u30c3\u30af\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u79fb\u52d5\u3059\u308b\u30bf\u30fc\u30b2\u30c3\u30c8\u3092\u30b9\u30e9\u30a4\u30b9\u3059\u308b\u3068\u304d\u306f\u3001\u305d\u306e\u7d4c\u8def\u3092\u4e88\u6e2c\u3057\u3001\u305d\u308c\u306b\u5fdc\u3058\u3066\u30b9\u30ef\u30a4\u30d7\u3092\u8abf\u6574\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u624b\u98061\uff1a\u30bf\u30fc\u30b2\u30c3\u30c8\u306e\u52d5\u304d\u3092\u89b3\u5bdf\u3059\u308b\u3002\u624b\u98062\uff1a\u8ecc\u9053\u3092\u4e88\u6e2c\u3059\u308b\u3002\u624b\u98063\uff1a\u6b63\u78ba\u306a\u30b9\u30ef\u30a4\u30d7\u3092\u5b9f\u884c\u3059\u308b\u3002\u3053\u306e\u30c6\u30af\u30cb\u30c3\u30af\u306f\u3001\u30a8\u30e9\u30fc\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u3001\u5f97\u70b9\u306e\u53ef\u80fd\u6027\u3092\u6700\u5927\u5316\u3057\u307e\u3059\u3002[\u56f3\uff1a\u4e88\u6e2c\u30b9\u30ef\u30a4\u30d7\u30d1\u30b9]"}, {"question": "\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u30c7\u30fc\u30bf\u79fb\u884c\u3092\u30b9\u30e9\u30a4\u30b9\u30de\u30b9\u30bf\u30fc\u3067\u3069\u306e\u3088\u3046\u306b\u51e6\u7406\u3057\u3066\u3044\u307e\u3059\u304b\uff1f", "answer": "\u30b9\u30e9\u30a4\u30b9\u30de\u30b9\u30bf\u30fc\u306f\u3001\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u901a\u3058\u3066\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u30c7\u30fc\u30bf\u79fb\u884c\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001iOS\u30c7\u30d0\u30a4\u30b9\u304b\u3089Android\u30c7\u30d0\u30a4\u30b9\u306b\u5207\u308a\u66ff\u3048\u305f\u5834\u5408\u3001\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3053\u3068\u3067\u3001\u9032\u6357\u72b6\u6cc1\u304c\u4fdd\u5b58\u3055\u308c\u3001\u53d6\u5f97\u3067\u304d\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306f\u3001\u30c7\u30fc\u30bf\u306e\u5b8c\u5168\u6027\u3092\u78ba\u4fdd\u3059\u308b\u305f\u3081\u306b\u3001\u5b89\u5168\u306a\u6697\u53f7\u5316\u3055\u308c\u305f\u30af\u30e9\u30a6\u30c9\u30b7\u30b9\u30c6\u30e0\u3092\u4f7f\u7528\u3057\u3066\u3044\u307e\u3059\u3002\u3053\u306e\u6a5f\u80fd\u306b\u3088\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u3082\u30b7\u30fc\u30e0\u30ec\u30b9\u306b\u30b2\u30fc\u30e0\u3092\u7d9a\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u8a2d\u5b9a\uff1a\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u8a2d\u5b9a]"}, {"question": "\u7279\u5b9a\u306e\u9054\u6210\u306b\u3088\u3063\u3066\u3001\u30b9\u30e9\u30a4\u30b9\u30de\u30b9\u30bf\u30fc\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u308b\u96a0\u3057\u30b3\u30f3\u30c6\u30f3\u30c4\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30e9\u30a4\u30b9\u30de\u30b9\u30bf\u30fc\u306b\u306f\u3001\u7279\u5b9a\u306e\u9054\u6210\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u308b\u96a0\u3057\u30b3\u30f3\u30c6\u30f3\u30c4\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001100\u56de\u9023\u7d9a\u3057\u3066\u5b8c\u74a7\u306a\u30b9\u30e9\u30a4\u30b9\u3092\u9054\u6210\u3059\u308b\u3068\u3001\u7279\u5225\u306a\u30d6\u30ec\u30fc\u30c9\u30b9\u30ad\u30f3\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u3053\u306e\u30b3\u30f3\u30c6\u30f3\u30c4\u306f\u3001\u30b2\u30fc\u30e0\u306b\u5965\u884c\u304d\u3092\u4e0e\u3048\u3001\u732e\u8eab\u7684\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u5831\u916c\u3092\u4e0e\u3048\u307e\u3059\u3002\u9054\u6210\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u6311\u6226\u3055\u305b\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u304a\u308a\u3001\u610f\u5473\u306e\u3042\u308b\u5831\u916c\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002[\u30ea\u30b9\u30c8\uff1a\u9054\u6210\u5831\u916c]"}, {"question": "\u30b9\u30e9\u30a4\u30b9\u30de\u30b9\u30bf\u30fc\u306e\u30bf\u30fc\u30b2\u30c3\u30c8\u51fa\u73fe\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30b9\u30e9\u30a4\u30b9\u30de\u30b9\u30bf\u30fc\u306e\u30bf\u30fc\u30b2\u30c3\u30c8\u51fa\u73fe\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u96e3\u6613\u5ea6\u3068\u30a8\u30f3\u30b2\u30fc\u30b8\u30e1\u30f3\u30c8\u306e\u30d0\u30e9\u30f3\u30b9\u3092\u53d6\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30bf\u30fc\u30b2\u30c3\u30c8\u306f\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u73fe\u5728\u306e\u30b9\u30b3\u30a2\u3068\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u57fa\u3065\u3044\u3066\u51fa\u73fe\u3057\u307e\u3059\u3002\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u9032\u6357\u72b6\u6cc1\u306b\u5fdc\u3058\u3066\u51fa\u73fe\u7387\u3068\u8907\u96d1\u3055\u3092\u5897\u3084\u3057\u3001\u30c0\u30a4\u30ca\u30df\u30c3\u30af\u3067\u6311\u6226\u7684\u306a\u4f53\u9a13\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u7d4c\u9a13\u8c4a\u5bcc\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u4e21\u65b9\u306b\u3068\u3063\u3066\u30b2\u30fc\u30e0\u3092\u9b45\u529b\u7684\u306b\u4fdd\u3061\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u51fa\u73fe\u7387\u8abf\u6574]"}, {"question": "\u30b9\u30e9\u30a4\u30b9\u30de\u30b9\u30bf\u30fc\u306f\u3001\u306a\u305c\u52d5\u7684\u306a\u96e3\u6613\u5ea6\u8abf\u6574\u30b7\u30b9\u30c6\u30e0\u3092\u4f7f\u7528\u3057\u3066\u3044\u307e\u3059\u304b\uff1f", "answer": "\u30b9\u30e9\u30a4\u30b9\u30de\u30b9\u30bf\u30fc\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u5bfe\u5fdc\u3059\u308b\u305f\u3081\u306b\u3001\u52d5\u7684\u306a\u96e3\u6613\u5ea6\u8abf\u6574\u30b7\u30b9\u30c6\u30e0\u3092\u63a1\u7528\u3057\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u82e6\u6226\u3057\u3066\u3044\u308b\u5834\u5408\u306f\u3001\u30b2\u30fc\u30e0\u306f\u30bf\u30fc\u30b2\u30c3\u30c8\u306e\u51fa\u73fe\u7387\u3068\u8907\u96d1\u3055\u3092\u4e0b\u3052\u307e\u3059\u3002\u9006\u306b\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u5353\u8d8a\u3057\u3066\u3044\u308b\u5834\u5408\u306f\u3001\u30b2\u30fc\u30e0\u306f\u6311\u6226\u3092\u9ad8\u3081\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u3059\u3079\u3066\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u697d\u3057\u3044\u4f53\u9a13\u3092\u3059\u308b\u3053\u3068\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u52d5\u7684 vs. \u9759\u7684\u96e3\u6613\u5ea6]"}, {"question": "\u30b9\u30e9\u30a4\u30b9\u30de\u30b9\u30bf\u30fc\u306e\u3055\u307e\u3056\u307e\u306a\u30d6\u30ec\u30fc\u30c9\u30bf\u30a4\u30d7\u9593\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30e9\u30a4\u30b9\u30de\u30b9\u30bf\u30fc\u306e\u30d6\u30ec\u30fc\u30c9\u30bf\u30a4\u30d7\u306f\u3001\u901f\u5ea6\u3001\u6b63\u78ba\u6027\u3001\u7279\u6b8a\u52b9\u679c\u304c\u7570\u306a\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30b9\u30a6\u30a3\u30d5\u30c8\u30d6\u30ec\u30fc\u30c9\u300d\u306f\u3088\u308a\u901f\u3044\u30b9\u30ef\u30a4\u30d7\u304c\u53ef\u80fd\u3067\u3059\u304c\u3001\u6b63\u78ba\u6027\u306f\u4f4e\u304f\u3001\u300c\u30d7\u30ec\u30b7\u30b8\u30e7\u30d6\u30ec\u30fc\u30c9\u300d\u306f\u9045\u3044\u901f\u5ea6\u3067\u9ad8\u3044\u6b63\u78ba\u6027\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u5404\u30d6\u30ec\u30fc\u30c9\u30bf\u30a4\u30d7\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u3068\u6226\u7565\u306b\u5bfe\u5fdc\u3057\u3066\u3044\u307e\u3059\u3002\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30b9\u30e9\u30a4\u30b9\u306b\u6700\u9069\u306a\u30d6\u30ec\u30fc\u30c9\u3092\u9078\u629e\u3067\u304d\u307e\u3059\u3002[\u8868\uff1a\u30d6\u30ec\u30fc\u30c9\u30bf\u30a4\u30d7\u6bd4\u8f03]"}, {"question": "\u30bf\u30a4\u30e0\u30a4\u30d9\u30f3\u30c8\u4e2d\u306b\u30b9\u30e9\u30a4\u30b9\u30de\u30b9\u30bf\u30fc\u3067\u306e\u52b9\u7387\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30bf\u30a4\u30e0\u30a4\u30d9\u30f3\u30c8\u4e2d\u306b\u30b9\u30e9\u30a4\u30b9\u30de\u30b9\u30bf\u30fc\u3067\u306e\u52b9\u7387\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u6226\u7565\u7684\u306a\u8a08\u753b\u3068\u8fc5\u901f\u306a\u5b9f\u884c\u304c\u5fc5\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u9ad8\u4fa1\u5024\u306e\u30bf\u30fc\u30b2\u30c3\u30c8\u306b\u7126\u70b9\u3092\u5f53\u3066\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u6d3b\u7528\u3059\u308b\u3068\u3001\u30b9\u30b3\u30a2\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u624b\u98061\uff1a\u9ad8\u4fa1\u5024\u306e\u30bf\u30fc\u30b2\u30c3\u30c8\u3092\u7279\u5b9a\u3059\u308b\u3002\u624b\u98062\uff1a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u6226\u7565\u7684\u306b\u5229\u7528\u3059\u308b\u3002\u624b\u98063\uff1a\u901f\u304f\u3066\u6b63\u78ba\u306a\u30b9\u30e9\u30a4\u30b9\u30ea\u30ba\u30e0\u3092\u7dad\u6301\u3059\u308b\u3002\u3053\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u9650\u3089\u308c\u305f\u6642\u9593\u306e\u4e2d\u3067\u6700\u9ad8\u306e\u7d50\u679c\u3092\u51fa\u3059\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002[\u56f3\uff1a\u30bf\u30a4\u30e0\u30a4\u30d9\u30f3\u30c8\u6226\u7565]"}]
[{"question": "\ucd08\uc2ec\uc790\uac00 Mini Chef Overcooked\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "Mini Chef Overcooked\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1 - \uc67c\ucabd \uc870\uc774\uc2a4\ud2f1\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc8fc\ubc29\uc5d0\uc11c \uce90\ub9ad\ud130\ub97c \uc774\ub3d9\ud569\ub2c8\ub2e4. STEP2 - 'A' \ubc84\ud2bc\uc744 \ub20c\ub7ec \uc7ac\ub8cc\uc640 \uc694\ub9ac\ub97c \uc9d1\uac70\ub098 \ub0b4\ub824\ub193\uc2b5\ub2c8\ub2e4. STEP3 - 'X' \ubc84\ud2bc\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc7ac\ub8cc\ub97c \ub2e4\uc9c0\uace0 'Y' \ubc84\ud2bc\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc694\ub9ac\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac04\ub2e8\ud55c \uc0d0\ub7ec\ub4dc\ub97c \ub9cc\ub4e4\ub824\uba74 'A' \ubc84\ud2bc\uc73c\ub85c \uc0c1\ucd94\ub97c \uc9d1\uc5b4 'X' \ubc84\ud2bc\uc73c\ub85c \ub2e4\uc9c0\uace0 \uc811\uc2dc\uc5d0 \ub193\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc8fc\ubc29\uc744 \uac01 \ubc84\ud2bc\uc774 \ud37c\uc990\uc744 \ud478\ub294 \ub3c4\uad6c\uc778 \ud37c\uc990\ucc98\ub7fc \uc0dd\uac01\ud574 \ubcf4\uc138\uc694.]"}, {"question": "Mini Chef Overcooked\uc5d0\uc11c \ud611\ub3d9\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \ud611\ub3d9\uc2ec\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Mini Chef Overcooked\uc5d0\uc11c \ud611\ub3d9\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \uac8c\uc784\uc774 \ud300\uc6cc\ud06c\uc640 \uc2dc\uac04 \uad00\ub9ac\uc5d0 \uae30\ubc18\ud558\uc5ec \uc124\uacc4\ub418\uc5c8\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \ud611\ub3d9\uc2ec\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ubc29\ubc95: STEP1 - \uac01 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ub2e4\uc9d0, \uc608\ub97c \ub4e4\uc5b4 \ud55c \uba85\uc740 \ub2e4\uc9c0\uace0 \ub2e4\ub978 \ud55c \uba85\uc740 \uc694\ub9ac\ud558\ub294 \uc5ed\ud560\uc744 \ud560\ub2f9\ud569\ub2c8\ub2e4. STEP2 - \ub2e4\uc74c\uc5d0 \uc218\ud589\ud574\uc57c \ud560 \uc791\uc5c5\uc5d0 \ub300\ud574 \uc9c0\uc18d\uc801\uc73c\ub85c \uc18c\ud1b5\ud569\ub2c8\ub2e4. STEP3 - \uc5ec\ub7ec \ubc88 \ub808\ubca8\uc744 \uc5f0\uc2b5\ud558\uc5ec \uc791\uc5c5 \ud750\ub984\uc744 \uc774\ud574\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc2a4\uc2dc \ub300\uacb0' \ub808\ubca8\uc5d0\uc11c\ub294 \ud55c \ud50c\ub808\uc774\uc5b4\uac00 \ubc25 \uc900\ube44\uc5d0 \uc9d1\uc911\ud558\uace0 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub294 \uc0dd\uc120\uc744 \ub2e4\ub8f9\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: \uc194\ub85c \uac8c\uc784\uacfc \ub2ec\ub9ac Mini Chef Overcooked\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \ub2e8\uc77c \ud300\ucc98\ub7fc \ud589\ub3d9\ud574\uc57c \ud569\ub2c8\ub2e4.]"}, {"question": "Mini Chef Overcooked\uc5d0\uc11c \ud544\uc218\uc801\uc778 \uc8fc\ubc29 \ub3c4\uad6c\ub294 \ubb34\uc5c7\uc774\uba70, \uac01\uac01 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "Mini Chef Overcooked\uc758 \ud544\uc218\uc801\uc778 \uc8fc\ubc29 \ub3c4\uad6c\ub294 \ub2e4\ub4ec\ub294 \ubcf4\ub4dc, \uc2a4\ud1a0\ube0c \ubc0f \uc11c\ube59 \uce74\uc6b4\ud130\uc785\ub2c8\ub2e4. \ub2e4\ub4ec\ub294 \ubcf4\ub4dc\ub294 'X' \ubc84\ud2bc\uc744 \ub20c\ub7ec \uc7ac\ub8cc\ub97c \uc900\ube44\ud558\ub294 \ub370 \uc0ac\uc6a9\ub429\ub2c8\ub2e4. \uc2a4\ud1a0\ube0c\ub294 'Y' \ubc84\ud2bc\uc744 \ub20c\ub7ec \uc7ac\ub8cc\ub97c \uc694\ub9ac\ud569\ub2c8\ub2e4. \uc11c\ube59 \uce74\uc6b4\ud130\ub294 \uc644\uc131\ub41c \uc694\ub9ac\ub97c \ub193\uc544 \uc810\uc218\ub97c \uc5bb\ub294 \uacf3\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud584\ubc84\uac70\ub97c \ub9cc\ub4e4\ub824\uba74 \ub2e4\ub4ec\ub294 \ubcf4\ub4dc\uc5d0\uc11c \uc0c1\ucd94\uc640 \ud1a0\ub9c8\ud1a0\ub97c \ub2e4\uc9c0\uace0, \uc2a4\ud1a0\ube0c\uc5d0\uc11c \ud328\ud2f0\ub97c \uc694\ub9ac\ud558\uace0, \ube75 \uc704\uc5d0 \ubaa8\ub4e0 \uac83\uc744 \uc62c\ub824 \uc11c\ube59 \uce74\uc6b4\ud130\uc5d0 \ub193\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \ub2e4\ub4ec\ub294 \ubcf4\ub4dc - 'X', \uc2a4\ud1a0\ube0c - 'Y', \uc11c\ube59 \uce74\uc6b4\ud130 - 'A'.]"}, {"question": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\uac00 Mini Chef Overcooked\uc5d0\uc11c \uc791\uc5c5 \ud750\ub984\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 Mini Chef Overcooked\uc5d0\uc11c \ub2e4\uc74c\uacfc \uac19\uc774 \uc791\uc5c5 \ud750\ub984\uc744 \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4: STEP1 - \uc5ec\ub7ec \uc7ac\ub8cc\ub97c \ub3d9\uc2dc\uc5d0 \uc900\ube44\ud569\ub2c8\ub2e4. STEP2 - \uc8fc\ubc29 \ub808\uc774\uc544\uc6c3\uc744 \ud65c\uc6a9\ud558\uc5ec \uc774\ub3d9\uc744 \ucd5c\uc18c\ud654\ud569\ub2c8\ub2e4. STEP3 - \ubcf5\uc7a1\uc131\uacfc \uc2dc\uac04\uc744 \uae30\uc900\uc73c\ub85c \uc8fc\ubb38\uc744 \uc6b0\uc120\uc21c\uc704\ud654\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud53c\uc790 \uacf5\ud3ec' \ub808\ubca8\uc5d0\uc11c\ub294 \uc624\ube10\uc774 \uc608\uc5f4\ub418\ub294 \ub3d9\uc548 \ubc18\uc8fd\uacfc \uc18c\uc2a4\ub97c \uc900\ube44\ud55c \ub2e4\uc74c \ud53c\uc790\ub97c \ube60\ub974\uac8c \uc870\ub9bd\ud558\uace0 \uc694\ub9ac\ud569\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \ub2e4\uc774\uc5b4\uadf8\ub7a8: \uc7ac\ub8cc \uc900\ube44 \u2192 \uc694\ub9ac \u2192 \uc11c\ube59 \u2192 \ubc18\ubcf5.]"}, {"question": "Mini Chef Overcooked\uc5d0\uc11c \ub192\uc740 \uc555\ub825 \ub808\ubca8\uc744 \ucc98\ub9ac\ud558\ub294 \ub370 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Mini Chef Overcooked\uc5d0\uc11c \ub192\uc740 \uc555\ub825 \ub808\ubca8\uc744 \ucc98\ub9ac\ud558\ub294 \ud6a8\uacfc\uc801\uc778 \uc804\ub7b5\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: STEP1 - \ucc28\ubd84\ud558\uac8c \uc720\uc9c0\ud558\uace0 \ud55c \ubc88\uc5d0 \ud558\ub098\uc758 \uc791\uc5c5\uc5d0 \uc9d1\uc911\ud569\ub2c8\ub2e4. STEP2 - \ubc14\ub85c \uac00\uae30\ub97c \uc0ac\uc6a9\ud558\uace0 \uc8fc\ubc29 \ub3c4\uad6c\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. STEP3 - \uc2e4\uc218\ub97c \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \ub3d9\ub8cc\uc640 \uba85\ud655\ud558\uac8c \uc18c\ud1b5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud584\ubc84\uac70 \ud3ed\ubc1c' \ub808\ubca8\uc5d0\uc11c\ub294 \ud55c \ud50c\ub808\uc774\uc5b4\uac00 \uadf8\ub9b4\uc744 \uad00\ub9ac\ud558\uace0 \ub2e4\ub978 \ud55c \ud50c\ub808\uc774\uc5b4\ub294 \ud1a0\ud551\uc744 \ucc98\ub9ac\ud558\uc5ec \uc18d\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: \uc11c\ub450\ub974\uba74 \uc2e4\uc218\uac00 \ubc1c\uc0dd\ud558\uace0, \uafb8\uc900\ud55c \uc18d\ub3c4\ub294 \uc815\ud655\uc131\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4.]"}, {"question": "\uc8fc\ubc29 \ub808\uc774\uc544\uc6c3\uc774 Mini Chef Overcooked \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc8fc\ubc29 \ub808\uc774\uc544\uc6c3\uc740 Mini Chef Overcooked \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \ud070 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc774\ub3d9 \ud6a8\uc728\uacfc \uc791\uc5c5 \ud750\ub984\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubd84\ud560\ub41c \uc8fc\ubc29\uc774 \uc788\ub294 \ub808\ubca8\uc5d0\uc11c\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uac04\uaca9\uc744 \ub450\uace0 \uc7ac\ub8cc\ub97c \uc804\ub2ec\ud558\uae30 \uc704\ud574 \ud611\ub825\ud574\uc57c \ud569\ub2c8\ub2e4. \ucd5c\uc801\uc758 \ub808\uc774\uc544\uc6c3\uc740 \ubd88\ud544\uc694\ud55c \uc774\ub3d9\uc744 \uc904\uc5ec \uc8fc\ubb38\uc744 \ub354 \ube68\ub9ac \uc644\ub8cc\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc8fc\ubc29\uc744 \uc131\uacf5\uc73c\ub85c \uc774\ub044\ub294 \ucd5c\ub2e8 \uac70\ub9ac\uac00 \uc788\ub294 \ubbf8\ub85c\ub77c\uace0 \uc0dd\uac01\ud574\ubcf4\uc138\uc694.]"}, {"question": "Mini Chef Overcooked\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uc5b4\ub5a4 \uc694\uc18c\uac00 \uc810\uc218\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "Mini Chef Overcooked\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc644\ub8cc\ub41c \uc8fc\ubb38 \uc218, \uc8fc\ubb38\uc758 \ubcf5\uc7a1\uc131 \ubc0f \uc18c\uc694 \uc2dc\uac04\uc744 \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. \uc810\uc218\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc694\uc18c\uc5d0\ub294 \uc694\ub9ac\uc758 \uc815\ud655\uc131, \ubc30\ub2ec \uc18d\ub3c4 \ubc0f \ubcf4\ub108\uc2a4 \uc544\uc774\ud15c \uc0ac\uc6a9\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc644\ubcbd\ud55c \uc2a4\uc2dc \ud50c\ub798\ud130\ub97c \ube60\ub974\uac8c \ubc30\ub2ec\ud558\ub294 \uac83\uc740 \uac04\ub2e8\ud55c \uc0d0\ub7ec\ub4dc\ubcf4\ub2e4 \ub354 \ub9ce\uc740 \uc810\uc218\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \uac04\ub2e8\ud55c \uc694\ub9ac - 100\uc810, \ubcf5\uc7a1\ud55c \uc694\ub9ac - 300\uc810, \ubcf4\ub108\uc2a4 \uc544\uc774\ud15c - +50\uc810.]"}, {"question": "\ucf58\uc194\uacfc PC\uc5d0\uc11c Mini Chef Overcooked\ub97c \ud50c\ub808\uc774\ud558\ub294 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ucf58\uc194\uacfc PC\uc5d0\uc11c Mini Chef Overcooked\ub97c \ud50c\ub808\uc774\ud558\ub294 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ucee8\ud2b8\ub864 \ubc29\uc2dd\uacfc \uc131\ub2a5\uc785\ub2c8\ub2e4. \ucf58\uc194 \ud50c\ub808\uc774\uc5b4\ub294 \uac8c\uc784 \ud328\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc9c1\uad00\uc801\uc778 \uba74\uc774 \uc788\uc73c\uba70 PC \ud50c\ub808\uc774\uc5b4\ub294 \ud0a4\ubcf4\ub4dc\ub098 \uc0ac\uc6a9\uc790 \uc815\uc758 \ucee8\ud2b8\ub864\ub7ec\ub97c \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc131\ub2a5\uba74\uc5d0\uc11c PC\ub294 \ud558\ub4dc\uc6e8\uc5b4\uc5d0 \ub530\ub77c \ud504\ub808\uc784 \uc18d\ub3c4\uc640 \ud574\uc0c1\ub3c4\uac00 \ub192\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: \ucf58\uc194 - \ud50c\ub7ec\uadf8 \uc564 \ud50c\ub808\uc774, PC - \uc0ac\uc6a9\uc790 \uc815\uc758 \uc124\uc815.]"}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 Mini Chef Overcooked\uc5d0\uc11c \uc228\uaca8\uc9c4 \ub808\ubca8\uacfc \uce90\ub9ad\ud130\ub97c \uc5b4\ub5bb\uac8c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud50c\ub808\uc774\uc5b4\ub294 Mini Chef Overcooked\uc5d0\uc11c \ud2b9\uc815 \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\uace0 \ud2b9\uc815 \ub808\ubca8\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc74c\uc73c\ub85c\uc368 \uc228\uaca8\uc9c4 \ub808\ubca8\uacfc \uce90\ub9ad\ud130\ub97c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \uc8fc\ubc29\uc758 \ubaa8\ub4e0 \ub808\ubca8\uc5d0\uc11c 3\uc131\uc744 \uc5bb\uc73c\uba74 \ube44\ubc00 \ub808\ubca8\uc774 \uc7a0\uae08 \ud574\uc81c\ub429\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \uc7a0\uae08 \ud574\uc81c\ud558\ub294 \uac83\uc740 \uc77c\ub828\uc758 \ud37c\uc990\uc744 \ud480\uace0 \ubcf4\ubb3c\uc744 \ucc3e\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}]
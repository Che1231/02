[{"question": "\u521d\u5b78\u8005\u5982\u4f55\u5728\u8ff7\u4f60\u5eda\u5e2bOvercooked\u904a\u6232\u4e2d\u5feb\u901f\u4e0a\u624b\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u5feb\u901f\u4e0a\u624b\u8ff7\u4f60\u5eda\u5e2bOvercooked\u904a\u6232\u7684\u57fa\u672c\u63a7\u5236\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1- \u4f7f\u7528\u5de6\u6416\u687f\u79fb\u52d5\u4f60\u7684\u89d2\u8272\u5728\u5eda\u623f\u4e2d\u3002\u6b65\u9a5f2- \u6309\u4e0b\u300eA\u9375\u300f\u62fe\u53d6\u6216\u653e\u4e0b\u98df\u6750\u548c\u83dc\u991a\u3002\u6b65\u9a5f3- \u4f7f\u7528\u300eX\u9375\u300f\u5207\u788e\u98df\u6750\uff0c\u4f7f\u7528\u300eY\u9375\u300f\u70f9\u98ea\u3002\u4f8b\u5982\uff0c\u8981\u88fd\u4f5c\u7c21\u55ae\u7684\u6c99\u62c9\uff0c\u5148\u7528\u300eA\u9375\u300f\u62fe\u53d6\u751f\u83dc\uff0c\u518d\u7528\u300eX\u9375\u300f\u5207\u788e\uff0c\u7136\u5f8c\u5c07\u5176\u653e\u5728\u76e4\u5b50\u4e0a\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u5eda\u623f\u662f\u4e00\u500b\u62fc\u5716\uff0c\u6bcf\u500b\u6309\u9375\u90fd\u662f\u89e3\u958b\u62fc\u5716\u7684\u5de5\u5177\u3002]"}, {"question": "\u5728\u8ff7\u4f60\u5eda\u5e2bOvercooked\u904a\u6232\u4e2d\uff0c\u5354\u8abf\u6027\u70ba\u4f55\u81f3\u95dc\u91cd\u8981\uff1f\u73a9\u5bb6\u5982\u4f55\u63d0\u5347\u5354\u8abf\u6027\uff1f", "answer": "\u5728\u8ff7\u4f60\u5eda\u5e2bOvercooked\u904a\u6232\u4e2d\uff0c\u5354\u8abf\u6027\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u904a\u6232\u8a2d\u8a08\u57fa\u65bc\u5718\u968a\u5408\u4f5c\u548c\u6642\u9593\u7ba1\u7406\u3002\u8981\u63d0\u5347\u5354\u8abf\u6027\uff1a\u6b65\u9a5f1- \u70ba\u6bcf\u4f4d\u73a9\u5bb6\u5206\u914d\u7279\u5b9a\u89d2\u8272\uff0c\u4f8b\u5982\u4e00\u4eba\u5207\u83dc\uff0c\u53e6\u4e00\u4eba\u70f9\u98ea\u3002\u6b65\u9a5f2- \u4e0d\u65b7\u6e9d\u901a\u63a5\u4e0b\u4f86\u9700\u8981\u505a\u7684\u4e8b\u60c5\u3002\u6b65\u9a5f3- \u53cd\u8986\u7df4\u7fd2\u95dc\u5361\uff0c\u4ee5\u4e86\u89e3\u4efb\u52d9\u6d41\u7a0b\u3002\u4f8b\u5982\uff0c\u5728\u300c\u58fd\u53f8\u5927\u6230\u300d\u95dc\u5361\u4e2d\uff0c\u4e00\u4f4d\u73a9\u5bb6\u53ef\u4ee5\u5c08\u6ce8\u65bc\u6e96\u5099\u7c73\u98ef\uff0c\u800c\u53e6\u4e00\u4f4d\u5247\u8ca0\u8cac\u8655\u7406\u9b5a\u8089\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u8207\u55ae\u4eba\u904a\u6232\u4e0d\u540c\uff0c\u8ff7\u4f60\u5eda\u5e2bOvercooked\u9700\u8981\u73a9\u5bb6\u4f5c\u70ba\u55ae\u4e00\u5718\u968a\u904b\u4f5c\u3002]"}, {"question": "\u8ff7\u4f60\u5eda\u5e2bOvercooked\u904a\u6232\u4e2d\u54ea\u4e9b\u5fc5\u5099\u5eda\u623f\u5de5\u5177\uff0c\u4ee5\u53ca\u5b83\u5011\u7684\u529f\u80fd\u70ba\u4f55\uff1f", "answer": "\u8ff7\u4f60\u5eda\u5e2bOvercooked\u904a\u6232\u4e2d\u5fc5\u5099\u7684\u5eda\u623f\u5de5\u5177\u5305\u62ec\u7827\u677f\u3001\u7210\u5b50\u4ee5\u53ca\u64fa\u76e4\u53f0\u3002\u7827\u677f\u7528\u65bc\u6e96\u5099\u98df\u6750\uff0c\u65b9\u6cd5\u662f\u7528\u300eX\u9375\u300f\u3002\u7210\u5b50\u7528\u65bc\u5728\u6309\u4e0b\u300eY\u9375\u300f\u6642\u70f9\u98ea\u98df\u6750\u3002\u64fa\u76e4\u53f0\u662f\u7528\u65bc\u5c07\u5b8c\u6210\u7684\u83dc\u991a\u653e\u7f6e\u5728\u4e0a\u9762\u4ee5\u7372\u5f97\u5f97\u5206\u3002\u4f8b\u5982\uff0c\u8981\u88fd\u4f5c\u6f22\u5821\uff0c\u53ef\u5728\u7827\u677f\u4e0a\u5207\u788e\u751f\u83dc\u548c\u756a\u8304\uff0c\u5728\u7210\u5b50\u4e0a\u70f9\u98ea\u8089\u9905\uff0c\u7136\u5f8c\u5728\u9eb5\u5305\u4e0a\u7d44\u88dd\u6240\u6709\u98df\u6750\uff0c\u6700\u5f8c\u5c07\u5176\u653e\u5728\u64fa\u76e4\u53f0\u4e0a\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u7827\u677f -'X'\uff0c\u7210\u5b50 - 'Y'\uff0c\u64fa\u76e4\u53f0 - 'A'\u3002]"}, {"question": "\u9032\u968e\u73a9\u5bb6\u5982\u4f55\u5728\u8ff7\u4f60\u5eda\u5e2bOvercooked\u904a\u6232\u4e2d\u512a\u5316\u5de5\u4f5c\u6d41\u7a0b\uff1f", "answer": "\u9032\u968e\u73a9\u5bb6\u53ef\u5728\u8ff7\u4f60\u5eda\u5e2bOvercooked\u904a\u6232\u4e2d\u901a\u904e\u4ee5\u4e0b\u65b9\u5f0f\u512a\u5316\u5de5\u4f5c\u6d41\u7a0b\uff1a\u6b65\u9a5f1- \u540c\u6642\u6e96\u5099\u591a\u7a2e\u98df\u6750\u3002\u6b65\u9a5f2- \u5229\u7528\u5eda\u623f\u4f48\u5c40\u6700\u5927\u9650\u5ea6\u5730\u6e1b\u5c11\u79fb\u52d5\u3002\u6b65\u9a5f3- \u57fa\u65bc\u8907\u96dc\u6027\u548c\u6642\u9593\u512a\u5148\u9806\u5e8f\u5b89\u6392\u8a02\u55ae\u3002\u4f8b\u5982\uff0c\u5728\u300c\u62ab\u85a9\u6050\u614c\u300d\u95dc\u5361\u4e2d\uff0c\u5148\u6e96\u5099\u9eb5\u7cf0\u548c\u91ac\u6599\uff0c\u540c\u6642\u9810\u71b1\u70e4\u7bb1\uff0c\u7136\u5f8c\u5feb\u901f\u7d44\u88dd\u4e26\u70f9\u98ea\u62ab\u85a9\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u98df\u6750\u6e96\u5099 \u2192 \u70f9\u98ea \u2192 \u64fa\u76e4 \u2192 \u91cd\u8907\u3002]"}, {"question": "\u5728\u8ff7\u4f60\u5eda\u5e2bOvercooked\u904a\u6232\u4e2d\uff0c\u8655\u7406\u9ad8\u58d3\u95dc\u5361\u6700\u6709\u6548\u7684\u7b56\u7565\u6709\u54ea\u4e9b\uff1f", "answer": "\u5728\u8ff7\u4f60\u5eda\u5e2bOvercooked\u904a\u6232\u4e2d\uff0c\u8655\u7406\u9ad8\u58d3\u95dc\u5361\u7684\u6709\u6548\u7b56\u7565\u5305\u62ec\uff1a\u6b65\u9a5f1- \u4fdd\u6301\u51b7\u975c\uff0c\u4e00\u6b21\u5c08\u6ce8\u65bc\u4e00\u500b\u4efb\u52d9\u3002\u6b65\u9a5f2- \u6709\u6548\u4f7f\u7528\u6377\u5f91\u548c\u5eda\u623f\u5de5\u5177\u3002\u6b65\u9a5f3- \u8207\u968a\u53cb\u6e05\u695a\u6e9d\u901a\uff0c\u907f\u514d\u932f\u8aa4\u3002\u4f8b\u5982\uff0c\u5728\u300c\u6f22\u5821\u72c2\u6f6e\u300d\u95dc\u5361\u4e2d\uff0c\u5206\u914d\u4e00\u4f4d\u73a9\u5bb6\u7ba1\u7406\u70e4\u76e4\uff0c\u800c\u53e6\u4e00\u4f4d\u5247\u8ca0\u8cac\u8655\u7406\u914d\u6599\uff0c\u4ee5\u52a0\u5feb\u6d41\u7a0b\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u5009\u4fc3\u5c0e\u81f4\u932f\u8aa4\uff0c\u800c\u7a69\u5b9a\u7684\u7bc0\u594f\u78ba\u4fdd\u6e96\u78ba\u6027\u3002]"}, {"question": "\u5eda\u623f\u4f48\u5c40\u5982\u4f55\u5728\u8ff7\u4f60\u5eda\u5e2bOvercooked\u904a\u6232\u7684\u904a\u6232\u6027\u4e2d\u7522\u751f\u5f71\u97ff\uff1f", "answer": "\u5eda\u623f\u4f48\u5c40\u986f\u8457\u5f71\u97ff\u8ff7\u4f60\u5eda\u5e2bOvercooked\u904a\u6232\u7684\u904a\u6232\u6027\uff0c\u5b83\u6703\u5f71\u97ff\u52d5\u4f5c\u6548\u7387\u548c\u4efb\u52d9\u6d41\u7a0b\u3002\u4f8b\u5982\uff0c\u5728\u64c1\u6709\u5206\u9694\u5eda\u623f\u7684\u95dc\u5361\u4e2d\uff0c\u73a9\u5bb6\u5fc5\u9808\u5354\u8abf\u901a\u904e\u7a7a\u9699\u50b3\u905e\u98df\u6750\u3002\u6700\u4f73\u4f48\u5c40\u6e1b\u5c11\u4e0d\u5fc5\u8981\u7684\u79fb\u52d5\uff0c\u5141\u8a31\u66f4\u5feb\u5730\u5b8c\u6210\u8a02\u55ae\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u628a\u5eda\u623f\u60f3\u50cf\u6210\u8ff7\u5bae\uff0c\u6700\u77ed\u7684\u8def\u5f91\u901a\u5f80\u6210\u529f\u3002]"}, {"question": "\u8ff7\u4f60\u5eda\u5e2bOvercooked\u904a\u6232\u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u5b83\uff1f", "answer": "\u8ff7\u4f60\u5eda\u5e2bOvercooked\u904a\u6232\u7684\u8a08\u5206\u7cfb\u7d71\u6839\u64da\u5b8c\u6210\u8a02\u55ae\u6578\u91cf\u3001\u8a02\u55ae\u8907\u96dc\u5ea6\u548c\u5b8c\u6210\u6642\u9593\u3002\u5f71\u97ff\u5206\u6578\u7684\u56e0\u7d20\u5305\u62ec\u83dc\u991a\u7684\u6e96\u78ba\u6027\u3001\u4ea4\u4ed8\u901f\u5ea6\u4ee5\u53ca\u984d\u5916\u7269\u54c1\u7684\u4f7f\u7528\u3002\u4f8b\u5982\uff0c\u5feb\u901f\u4ea4\u4ed8\u5b8c\u7f8e\u7684\u58fd\u53f8\u76e4\u6bd4\u7c21\u55ae\u7684\u6c99\u62c9\u7372\u5f97\u66f4\u591a\u5206\u6578\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u7c21\u55ae\u83dc\u991a - 100 \u5206\uff0c\u8907\u96dc\u83dc\u991a - 300 \u5206\uff0c\u984d\u5916\u7269\u54c1 - +50 \u5206\u3002]"}, {"question": "\u5728\u4e3b\u6a5f\u548c\u96fb\u8166\u4e0a\u73a9\u8ff7\u4f60\u5eda\u5e2bOvercooked\u904a\u6232\u6709\u4ec0\u9ebc\u95dc\u9375\u5dee\u7570\uff1f", "answer": "\u5728\u4e3b\u6a5f\u548c\u96fb\u8166\u4e0a\u73a9\u8ff7\u4f60\u5eda\u5e2bOvercooked\u904a\u6232\u7684\u95dc\u9375\u5dee\u7570\u5305\u62ec\u63a7\u5236\u65b9\u6848\u548c\u6548\u80fd\u3002\u4e3b\u6a5f\u73a9\u5bb6\u4f7f\u7528\u904a\u6232\u624b\u67c4\uff0c\u9019\u5c0d\u67d0\u4e9b\u4eba\u4f86\u8aaa\u53ef\u80fd\u66f4\u76f4\u89c0\uff0c\u800c\u96fb\u8166\u73a9\u5bb6\u5247\u53ef\u4ee5\u9078\u64c7\u4f7f\u7528\u9375\u76e4\u6216\u81ea\u5b9a\u7fa9\u63a7\u5236\u5668\u3002\u5728\u6548\u80fd\u65b9\u9762\uff0c\u96fb\u8166\u53ef\u80fd\u63d0\u4f9b\u66f4\u9ad8\u7684\u5e40\u7387\u548c\u89e3\u6790\u5ea6\uff0c\u53d6\u6c7a\u65bc\u786c\u9ad4\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u4e3b\u6a5f - \u5373\u63d2\u5373\u7528\uff0c\u96fb\u8166 - \u53ef\u81ea\u5b9a\u7fa9\u8a2d\u5b9a\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u89e3\u9396\u8ff7\u4f60\u5eda\u5e2bOvercooked\u904a\u6232\u4e2d\u7684\u96b1\u85cf\u95dc\u5361\u548c\u89d2\u8272\uff1f", "answer": "\u73a9\u5bb6\u53ef\u901a\u904e\u5b8c\u6210\u7279\u5b9a\u6311\u6230\u4e26\u5728\u67d0\u4e9b\u95dc\u5361\u4e2d\u53d6\u5f97\u9ad8\u5206\u4f86\u89e3\u9396\u8ff7\u4f60\u5eda\u5e2bOvercooked\u904a\u6232\u4e2d\u7684\u96b1\u85cf\u95dc\u5361\u548c\u89d2\u8272\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u500b\u5eda\u623f\u7684\u6240\u6709\u95dc\u5361\u4e2d\u7372\u5f97\u4e09\u661f\u734e\u52f5\uff0c\u5373\u53ef\u89e3\u9396\u79d8\u5bc6\u95dc\u5361\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u89e3\u9396\u96b1\u85cf\u5167\u5bb9\u5c31\u50cf\u5728\u89e3\u6c7a\u4e00\u7cfb\u5217\u8b0e\u984c\u5f8c\u627e\u5230\u5bf6\u85cf\u3002]"}]
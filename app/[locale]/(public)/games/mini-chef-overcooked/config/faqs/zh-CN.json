[{"question": "\u65b0\u624b\u5982\u4f55\u5feb\u901f\u638c\u63e1\u8ff7\u4f60\u53a8\u5e08\u8fc7\u5173\u70f9\u996a\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1\u8ff7\u4f60\u53a8\u5e08\u8fc7\u5173\u70f9\u996a\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u4f7f\u7528\u5de6\u6447\u6746\u79fb\u52a8\u89d2\u8272\u5728\u53a8\u623f\u4e2d\u3002\u6b65\u9aa42 - \u6309\u4e0b'A'\u952e\u62fe\u53d6\u6216\u653e\u4e0b\u98df\u6750\u548c\u83dc\u80b4\u3002\u6b65\u9aa43 - \u4f7f\u7528'X'\u952e\u5207\u788e\u98df\u6750\uff0c\u4f7f\u7528'Y'\u952e\u70f9\u996a\u3002\u4f8b\u5982\uff0c\u8981\u5236\u4f5c\u7b80\u5355\u7684\u6c99\u62c9\uff0c\u7528'A'\u952e\u62fe\u53d6\u751f\u83dc\uff0c\u7528'X'\u952e\u5207\u788e\uff0c\u7136\u540e\u5c06\u5176\u653e\u5728\u76d8\u5b50\u4e0a\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u53a8\u623f\u60f3\u8c61\u6210\u4e00\u4e2a\u9700\u8981\u4f7f\u7528\u6bcf\u4e2a\u6309\u94ae\u4f5c\u4e3a\u5de5\u5177\u7684\u8c1c\u9898\u3002]"}, {"question": "\u5728\u8ff7\u4f60\u53a8\u5e08\u8fc7\u5173\u70f9\u996a\u6e38\u620f\u4e2d\uff0c\u534f\u8c03\u6027\u4e3a\u4f55\u81f3\u5173\u91cd\u8981\uff1f\u73a9\u5bb6\u5982\u4f55\u63d0\u9ad8\u534f\u8c03\u6027\uff1f", "answer": "\u5728\u8ff7\u4f60\u53a8\u5e08\u8fc7\u5173\u70f9\u996a\u6e38\u620f\u4e2d\uff0c\u534f\u8c03\u6027\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u6e38\u620f\u7684\u8bbe\u8ba1\u56f4\u7ed5\u7740\u56e2\u961f\u5408\u4f5c\u548c\u65f6\u95f4\u7ba1\u7406\u3002\u8981\u63d0\u9ad8\u534f\u8c03\u6027\uff1a\u6b65\u9aa41 - \u4e3a\u6bcf\u4e2a\u73a9\u5bb6\u5206\u914d\u7279\u5b9a\u7684\u89d2\u8272\uff0c\u4f8b\u5982\u4e00\u4e2a\u4eba\u5207\u83dc\uff0c\u53e6\u4e00\u4e2a\u4eba\u70f9\u996a\u3002\u6b65\u9aa42 - \u4e0d\u65ad\u6c9f\u901a\u4e0b\u4e00\u6b65\u9700\u8981\u505a\u4ec0\u4e48\u3002\u6b65\u9aa43 - \u591a\u6b21\u7ec3\u4e60\u5173\u5361\uff0c\u4e86\u89e3\u4efb\u52a1\u6d41\u7a0b\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5bff\u53f8\u5bf9\u51b3\u201d\u5173\u5361\u4e2d\uff0c\u4e00\u540d\u73a9\u5bb6\u53ef\u4ee5\u4e13\u6ce8\u4e8e\u51c6\u5907\u7c73\u996d\uff0c\u800c\u53e6\u4e00\u540d\u73a9\u5bb6\u5219\u8d1f\u8d23\u5904\u7406\u9c7c\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u4e0e\u5355\u4eba\u6e38\u620f\u4e0d\u540c\uff0c\u8ff7\u4f60\u53a8\u5e08\u8fc7\u5173\u70f9\u996a\u9700\u8981\u73a9\u5bb6\u4f5c\u4e3a\u4e00\u4e2a\u6574\u4f53\u884c\u52a8\u3002]"}, {"question": "\u8ff7\u4f60\u53a8\u5e08\u8fc7\u5173\u70f9\u996a\u4e2d\u7684\u5fc5\u5907\u53a8\u623f\u5de5\u5177\u6709\u54ea\u4e9b\uff0c\u5b83\u4eec\u7684\u529f\u80fd\u662f\u4ec0\u4e48\uff1f", "answer": "\u8ff7\u4f60\u53a8\u5e08\u8fc7\u5173\u70f9\u996a\u4e2d\u5fc5\u5907\u7684\u53a8\u623f\u5de5\u5177\u5305\u62ec\u5207\u83dc\u677f\u3001\u7089\u7076\u548c\u670d\u52a1\u53f0\u3002\u5207\u83dc\u677f\u7528\u4e8e\u901a\u8fc7\u6309\u4e0b'X'\u952e\u51c6\u5907\u98df\u6750\u3002\u7089\u7076\u5728\u6309\u4e0b'Y'\u952e\u65f6\u70f9\u996a\u98df\u6750\u3002\u670d\u52a1\u53f0\u662f\u653e\u7f6e\u5df2\u5b8c\u6210\u7684\u83dc\u80b4\u4ee5\u83b7\u5f97\u5206\u6570\u7684\u5730\u65b9\u3002\u4f8b\u5982\uff0c\u8981\u5236\u4f5c\u6c49\u5821\uff0c\u8bf7\u5728\u5207\u83dc\u677f\u4e0a\u5207\u788e\u751f\u83dc\u548c\u756a\u8304\uff0c\u5728\u7089\u7076\u4e0a\u70f9\u996a\u8089\u997c\uff0c\u5e76\u5728\u5c06\u6c49\u5821\u653e\u5728\u670d\u52a1\u53f0\u4e0a\u4e4b\u524d\u5c06\u6240\u6709\u98df\u6750\u653e\u5728\u9762\u5305\u4e0a\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u5207\u83dc\u677f - 'X'\uff0c\u7089\u7076 - 'Y'\uff0c\u670d\u52a1\u53f0 - 'A'\u3002]"}, {"question": "\u9ad8\u7ea7\u73a9\u5bb6\u5982\u4f55\u5728\u8ff7\u4f60\u53a8\u5e08\u8fc7\u5173\u70f9\u996a\u4e2d\u4f18\u5316\u5de5\u4f5c\u6d41\u7a0b\uff1f", "answer": "\u9ad8\u7ea7\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u4ee5\u4e0b\u65b9\u5f0f\u5728\u8ff7\u4f60\u53a8\u5e08\u8fc7\u5173\u70f9\u996a\u4e2d\u4f18\u5316\u5de5\u4f5c\u6d41\u7a0b\uff1a\u6b65\u9aa41 - \u540c\u65f6\u51c6\u5907\u591a\u79cd\u98df\u6750\u3002\u6b65\u9aa42 - \u5229\u7528\u53a8\u623f\u5e03\u5c40\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u79fb\u52a8\u3002\u6b65\u9aa43 - \u6839\u636e\u590d\u6742\u6027\u548c\u65f6\u95f4\u4f18\u5148\u5904\u7406\u8ba2\u5355\u3002\u4f8b\u5982\uff0c\u5728\u201c\u62ab\u8428\u6050\u614c\u201d\u5173\u5361\u4e2d\uff0c\u5728\u70e4\u7bb1\u9884\u70ed\u7684\u540c\u65f6\u5f00\u59cb\u51c6\u5907\u9762\u56e2\u548c\u9171\u6c41\uff0c\u7136\u540e\u5feb\u901f\u7ec4\u88c5\u548c\u70f9\u996a\u62ab\u8428\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u98df\u6750\u51c6\u5907 \u2192 \u70f9\u996a \u2192 \u4e0a\u83dc \u2192 \u91cd\u590d\u3002]"}, {"question": "\u5728\u8ff7\u4f60\u53a8\u5e08\u8fc7\u5173\u70f9\u996a\u4e2d\uff0c\u5e94\u5bf9\u9ad8\u538b\u5173\u5361\u6700\u6709\u6548\u7684\u7b56\u7565\u6709\u54ea\u4e9b\uff1f", "answer": "\u5728\u8ff7\u4f60\u53a8\u5e08\u8fc7\u5173\u70f9\u996a\u4e2d\u5e94\u5bf9\u9ad8\u538b\u5173\u5361\u7684\u6709\u6548\u7b56\u7565\u5305\u62ec\uff1a\u6b65\u9aa41 - \u4fdd\u6301\u51b7\u9759\uff0c\u4e00\u6b21\u4e13\u6ce8\u4e8e\u4e00\u9879\u4efb\u52a1\u3002\u6b65\u9aa42 - \u9ad8\u6548\u5730\u4f7f\u7528\u5feb\u6377\u65b9\u5f0f\u548c\u53a8\u623f\u5de5\u5177\u3002\u6b65\u9aa43 - \u4e0e\u961f\u53cb\u6e05\u6670\u5730\u6c9f\u901a\u4ee5\u907f\u514d\u9519\u8bef\u3002\u4f8b\u5982\uff0c\u5728\u201c\u6c49\u5821\u95ea\u7535\u6218\u201d\u5173\u5361\u4e2d\uff0c\u5206\u914d\u4e00\u540d\u73a9\u5bb6\u8d1f\u8d23\u7ba1\u7406\u70e4\u67b6\uff0c\u53e6\u4e00\u540d\u73a9\u5bb6\u8d1f\u8d23\u5904\u7406\u914d\u6599\u4ee5\u52a0\u5feb\u6d41\u7a0b\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u5306\u5fd9\u4f1a\u5bfc\u81f4\u9519\u8bef\uff0c\u800c\u7a33\u5b9a\u7684\u8282\u594f\u4fdd\u8bc1\u51c6\u786e\u6027\u3002]"}, {"question": "\u53a8\u623f\u5e03\u5c40\u5bf9\u8ff7\u4f60\u53a8\u5e08\u8fc7\u5173\u70f9\u996a\u6e38\u620f\u4f53\u9a8c\u6709\u4ec0\u4e48\u5f71\u54cd\uff1f", "answer": "\u53a8\u623f\u5e03\u5c40\u5bf9\u8ff7\u4f60\u53a8\u5e08\u8fc7\u5173\u70f9\u996a\u6e38\u620f\u4f53\u9a8c\u6709\u663e\u8457\u5f71\u54cd\uff0c\u5b83\u4f1a\u5f71\u54cd\u884c\u52a8\u6548\u7387\u548c\u4efb\u52a1\u6d41\u7a0b\u3002\u4f8b\u5982\uff0c\u5728\u5e26\u6709\u5206\u9694\u53a8\u623f\u7684\u5173\u5361\u4e2d\uff0c\u73a9\u5bb6\u5fc5\u987b\u534f\u8c03\u914d\u5408\u624d\u80fd\u5728\u95f4\u9694\u4e2d\u4f20\u9012\u98df\u6750\u3002\u6700\u4f73\u7684\u5e03\u5c40\u53ef\u4ee5\u51cf\u5c11\u4e0d\u5fc5\u8981\u7684\u79fb\u52a8\uff0c\u4ece\u800c\u66f4\u5feb\u5730\u5b8c\u6210\u8ba2\u5355\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u53a8\u623f\u60f3\u8c61\u6210\u4e00\u4e2a\u8ff7\u5bab\uff0c\u6700\u77ed\u8def\u5f84\u901a\u5411\u6210\u529f\u3002]"}, {"question": "\u8ff7\u4f60\u53a8\u5e08\u8fc7\u5173\u70f9\u996a\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u8bc4\u5206\uff1f", "answer": "\u8ff7\u4f60\u53a8\u5e08\u8fc7\u5173\u70f9\u996a\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u5b8c\u6210\u8ba2\u5355\u7684\u6570\u91cf\u3001\u8ba2\u5355\u7684\u590d\u6742\u7a0b\u5ea6\u548c\u5b8c\u6210\u8ba2\u5355\u6240\u9700\u7684\u65f6\u95f4\u3002\u5f71\u54cd\u5206\u6570\u7684\u56e0\u7d20\u5305\u62ec\u83dc\u80b4\u7684\u51c6\u786e\u6027\u3001\u914d\u9001\u901f\u5ea6\u4ee5\u53ca\u4f7f\u7528\u5956\u52b1\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5feb\u901f\u9012\u9001\u5b8c\u7f8e\u7684\u5bff\u53f8\u76d8\u6bd4\u7b80\u5355\u7684\u6c99\u62c9\u5f97\u5206\u66f4\u9ad8\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u7b80\u5355\u83dc\u80b4 - 100 \u5206\uff0c\u590d\u6742\u83dc\u80b4 - 300 \u5206\uff0c\u5956\u52b1\u7269\u54c1 - +50 \u5206\u3002]"}, {"question": "\u5728\u6e38\u620f\u673a\u548c\u4e2a\u4eba\u7535\u8111\u4e0a\u73a9\u8ff7\u4f60\u53a8\u5e08\u8fc7\u5173\u70f9\u996a\u6709\u4ec0\u4e48\u4e3b\u8981\u533a\u522b\uff1f", "answer": "\u5728\u6e38\u620f\u673a\u548c\u4e2a\u4eba\u7535\u8111\u4e0a\u73a9\u8ff7\u4f60\u53a8\u5e08\u8fc7\u5173\u70f9\u996a\u7684\u4e3b\u8981\u533a\u522b\u5305\u62ec\u63a7\u5236\u65b9\u6848\u548c\u6027\u80fd\u3002\u6e38\u620f\u673a\u73a9\u5bb6\u4f7f\u7528\u6e38\u620f\u624b\u67c4\uff0c\u8fd9\u5bf9\u4e8e\u67d0\u4e9b\u4eba\u6765\u8bf4\u53ef\u80fd\u66f4\u76f4\u89c2\uff0c\u800c\u4e2a\u4eba\u7535\u8111\u73a9\u5bb6\u53ef\u4ee5\u9009\u62e9\u4f7f\u7528\u952e\u76d8\u6216\u81ea\u5b9a\u4e49\u63a7\u5236\u5668\u3002\u5c31\u6027\u80fd\u800c\u8a00\uff0c\u4e2a\u4eba\u7535\u8111\u53ef\u80fd\u4f1a\u63d0\u4f9b\u66f4\u9ad8\u7684\u5e27\u901f\u7387\u548c\u5206\u8fa8\u7387\uff0c\u5177\u4f53\u53d6\u51b3\u4e8e\u786c\u4ef6\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6e38\u620f\u673a - \u5373\u63d2\u5373\u7528\uff0c\u4e2a\u4eba\u7535\u8111 - \u53ef\u81ea\u5b9a\u4e49\u8bbe\u7f6e\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u8ff7\u4f60\u53a8\u5e08\u8fc7\u5173\u70f9\u996a\u4e2d\u89e3\u9501\u9690\u85cf\u5173\u5361\u548c\u89d2\u8272\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u5b8c\u6210\u7279\u5b9a\u7684\u6311\u6218\u4ee5\u53ca\u5728\u67d0\u4e9b\u5173\u5361\u4e2d\u83b7\u5f97\u9ad8\u5206\u6765\u89e3\u9501\u9690\u85cf\u5173\u5361\u548c\u89d2\u8272\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u95f4\u53a8\u623f\u7684\u6240\u6709\u5173\u5361\u4e2d\u5f97\u5206\u4e09\u661f\u5c06\u89e3\u9501\u4e00\u4e2a\u79d8\u5bc6\u5173\u5361\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u89e3\u9501\u9690\u85cf\u5185\u5bb9\u5c31\u50cf\u5728\u89e3\u51b3\u4e00\u7cfb\u5217\u8c1c\u9898\u540e\u627e\u5230\u5b9d\u85cf\u4e00\u6837\u3002]"}]
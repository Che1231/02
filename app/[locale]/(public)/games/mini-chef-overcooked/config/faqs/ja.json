[{"question": "\u30df\u30cb\u30b7\u30a7\u30d5\u30aa\u30fc\u30d0\u30fc\u30af\u30c3\u30af\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u3001\u521d\u5fc3\u8005\u306e\u65b9\u3005\u304c\u8fc5\u901f\u306b\u59cb\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30df\u30cb\u30b7\u30a7\u30d5\u30aa\u30fc\u30d0\u30fc\u30af\u30c3\u30af\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u8fc5\u901f\u306b\u59cb\u3081\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71 - \u5de6\u306e\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u3092\u4f7f\u3063\u3066\u3001\u30ad\u30c3\u30c1\u30f3\u5185\u3067\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u79fb\u52d5\u3055\u305b\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - \u300eA\u300f\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u3066\u3001\u98df\u6750\u3084\u6599\u7406\u3092\u62fe\u3044\u4e0a\u3052\u305f\u308a\u3001\u7f6e\u3044\u305f\u308a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u300eX\u300f\u30dc\u30bf\u30f3\u3092\u4f7f\u3063\u3066\u98df\u6750\u3092\u523b\u307f\u3001\u300eY\u300f\u30dc\u30bf\u30f3\u3092\u4f7f\u3063\u3066\u8abf\u7406\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u7c21\u5358\u306a\u30b5\u30e9\u30c0\u3092\u4f5c\u308b\u306b\u306f\u3001\u300eA\u300f\u30dc\u30bf\u30f3\u3067\u30ec\u30bf\u30b9\u3092\u62fe\u3044\u3001\u300eX\u300f\u30dc\u30bf\u30f3\u3067\u523b\u307f\u3001\u300eY\u300f\u30dc\u30bf\u30f3\u3067\u76bf\u306e\u4e0a\u306b\u7f6e\u3051\u3070\u5b8c\u4e86\u3067\u3059\u3002[\u4f8b\u3048: \u30ad\u30c3\u30c1\u30f3\u306e\u4f5c\u696d\u3092\u3001\u5404\u30dc\u30bf\u30f3\u304c\u30c4\u30fc\u30eb\u3068\u306a\u308b\u30d1\u30ba\u30eb\u3068\u8003\u3048\u307e\u3057\u3087\u3046\u3002]"}, {"question": "\u30df\u30cb\u30b7\u30a7\u30d5\u30aa\u30fc\u30d0\u30fc\u30af\u30c3\u30af\u306b\u304a\u3044\u3066\u3001\u9023\u643a\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u307e\u305f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u3088\u3046\u306b\u9023\u643a\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30df\u30cb\u30b7\u30a7\u30d5\u30aa\u30fc\u30d0\u30fc\u30af\u30c3\u30af\u306b\u304a\u3044\u3066\u3001\u9023\u643a\u304c\u91cd\u8981\u306a\u306e\u306f\u3001\u3053\u306e\u30b2\u30fc\u30e0\u304c\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u3068\u6642\u9593\u7ba1\u7406\u3092\u91cd\u8996\u3057\u3066\u8a2d\u8a08\u3055\u308c\u3066\u3044\u308b\u304b\u3089\u3067\u3059\u3002\u9023\u643a\u3092\u5411\u4e0a\u3055\u305b\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71 - \u5404\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3001\u98df\u6750\u306e\u523b\u307f\u4f5c\u696d\u8005\u3084\u8abf\u7406\u62c5\u5f53\u8005\u306a\u3069\u3001\u5177\u4f53\u7684\u306a\u5f79\u5272\u3092\u5272\u308a\u5f53\u3066\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - \u6b21\u306b\u884c\u3046\u3079\u304d\u3053\u3068\u3092\u5e38\u306b\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u3067\u5171\u6709\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u30ec\u30d9\u30eb\u3092\u8907\u6570\u56de\u7df4\u7fd2\u3057\u3066\u3001\u30bf\u30b9\u30af\u306e\u6d41\u308c\u3092\u7406\u89e3\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u5bff\u53f8\u5bfe\u6c7a\u300d\u30ec\u30d9\u30eb\u3067\u306f\u30011\u4eba\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u3054\u98ef\u306e\u6e96\u5099\u306b\u96c6\u4e2d\u3057\u3001\u3082\u30461\u4eba\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u9b5a\u4ecb\u306e\u6e96\u5099\u3092\u3053\u306a\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03:\u30bd\u30ed\u30b2\u30fc\u30e0\u3068\u306f\u7570\u306a\u308a\u3001\u30df\u30cb\u30b7\u30a7\u30d5\u30aa\u30fc\u30d0\u30fc\u30af\u30c3\u30af\u3067\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u4e00\u4f53\u3068\u306a\u3063\u3066\u884c\u52d5\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002]"}, {"question": "\u30df\u30cb\u30b7\u30a7\u30d5\u30aa\u30fc\u30d0\u30fc\u30af\u30c3\u30af\u3067\u91cd\u8981\u306a\u30ad\u30c3\u30c1\u30f3\u30c4\u30fc\u30eb\u306f\u4f55\u3067\u3059\u304b\uff1f\u307e\u305f\u3001\u305d\u308c\u3089\u306e\u6a5f\u80fd\u306f\u3069\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u304b\uff1f", "answer": "\u30df\u30cb\u30b7\u30a7\u30d5\u30aa\u30fc\u30d0\u30fc\u30af\u30c3\u30af\u3067\u91cd\u8981\u306a\u30ad\u30c3\u30c1\u30f3\u30c4\u30fc\u30eb\u306f\u3001\u5305\u4e01\u677f\u3001\u30b3\u30f3\u30ed\u3001\u305d\u3057\u3066\u914d\u81b3\u30ab\u30a6\u30f3\u30bf\u30fc\u3067\u3059\u3002\u5305\u4e01\u677f\u306f\u300eX\u300f\u30dc\u30bf\u30f3\u3092\u62bc\u3059\u3053\u3068\u3067\u98df\u6750\u3092\u6e96\u5099\u3059\u308b\u305f\u3081\u306b\u4f7f\u7528\u3055\u308c\u307e\u3059\u3002\u30b3\u30f3\u30ed\u306f\u300eY\u300f\u30dc\u30bf\u30f3\u3092\u62bc\u3059\u3053\u3068\u3067\u98df\u6750\u3092\u8abf\u7406\u3057\u307e\u3059\u3002\u914d\u81b3\u30ab\u30a6\u30f3\u30bf\u30fc\u306f\u3001\u5b8c\u6210\u3057\u305f\u6599\u7406\u3092\u7f6e\u304d\u3001\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3059\u308b\u5834\u6240\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30cf\u30f3\u30d0\u30fc\u30ac\u30fc\u3092\u4f5c\u308b\u306b\u306f\u3001\u5305\u4e01\u677f\u3067\u30ec\u30bf\u30b9\u3084\u30c8\u30de\u30c8\u3092\u523b\u307f\u3001\u30b3\u30f3\u30ed\u3067\u30d1\u30c6\u30a3\u3092\u8abf\u7406\u3057\u3001\u30d0\u30f3\u30ba\u306e\u4e0a\u306b\u5168\u3066\u3092\u4e57\u305b\u3066\u914d\u81b3\u30ab\u30a6\u30f3\u30bf\u30fc\u306b\u7f6e\u304d\u307e\u3059\u3002[\u8868: \u5305\u4e01\u677f - \u300eX\u300f\u3001\u30b3\u30f3\u30ed - \u300eY\u300f\u3001\u914d\u81b3\u30ab\u30a6\u30f3\u30bf\u30fc - \u300eA\u300f\u3002]"}, {"question": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30df\u30cb\u30b7\u30a7\u30d5\u30aa\u30fc\u30d0\u30fc\u30af\u30c3\u30af\u3067\u4f5c\u696d\u52b9\u7387\u3092\u3069\u306e\u3088\u3046\u306b\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30df\u30cb\u30b7\u30a7\u30d5\u30aa\u30fc\u30d0\u30fc\u30af\u30c3\u30af\u3067\u4f5c\u696d\u52b9\u7387\u3092\u6700\u9069\u5316\u3059\u308b\u305f\u3081\u306b\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3046\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71 - \u8907\u6570\u306e\u98df\u6750\u3092\u540c\u6642\u306b\u4e0b\u3054\u3057\u3089\u3048\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72 - \u30ad\u30c3\u30c1\u30f3\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u6d3b\u7528\u3057\u3066\u79fb\u52d5\u3092\u6700\u5c0f\u9650\u306b\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73 - \u4f5c\u696d\u306e\u8907\u96d1\u3055\u3084\u6240\u8981\u6642\u9593\u306b\u57fa\u3065\u304d\u3001\u512a\u5148\u9806\u4f4d\u3092\u4ed8\u3051\u308b\u3002\u4f8b\u3048\u3070\u3001\u300c\u30d4\u30b6\u30d1\u30cb\u30c3\u30af\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30aa\u30fc\u30d6\u30f3\u304c\u4e88\u71b1\u3057\u3066\u3044\u308b\u9593\u306b\u751f\u5730\u3084\u30bd\u30fc\u30b9\u306e\u6e96\u5099\u3092\u59cb\u3081\u3001\u305d\u306e\u5f8c\u3001\u8fc5\u901f\u306b\u30d4\u30b6\u3092\u7d44\u307f\u7acb\u3066\u3066\u8abf\u7406\u3057\u307e\u3059\u3002[\u56f3: \u98df\u6750\u4e0b\u3054\u3057\u3089\u3048 \u2192 \u8abf\u7406 \u2192 \u914d\u81b3 \u2192 \u7e70\u308a\u8fd4\u3057\u3002]"}, {"question": "\u30df\u30cb\u30b7\u30a7\u30d5\u30aa\u30fc\u30d0\u30fc\u30af\u30c3\u30af\u3067\u3001\u9ad8\u5727\u306a\u30ec\u30d9\u30eb\u306b\u5bfe\u5fdc\u3059\u308b\u305f\u3081\u306b\u6709\u52b9\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30df\u30cb\u30b7\u30a7\u30d5\u30aa\u30fc\u30d0\u30fc\u30af\u30c3\u30af\u3067\u3001\u9ad8\u5727\u306a\u30ec\u30d9\u30eb\u306b\u5bfe\u5fdc\u3059\u308b\u305f\u3081\u306b\u6709\u52b9\u306a\u6226\u7565\u306f\u3001\u4ee5\u4e0b\u306e\u901a\u308a\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71 - \u843d\u3061\u7740\u3044\u3066\u3001\u4e00\u5ea6\u306b\u4e00\u3064\u306e\u30bf\u30b9\u30af\u306b\u96c6\u4e2d\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72 - \u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u3084\u30ad\u30c3\u30c1\u30f3\u30c4\u30fc\u30eb\u3092\u52b9\u7387\u7684\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u30c1\u30fc\u30e0\u30e1\u30a4\u30c8\u3068\u660e\u78ba\u306a\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u3092\u56f3\u308a\u3001\u30df\u30b9\u3092\u907f\u3051\u308b\u3002\u4f8b\u3048\u3070\u3001\u300c\u30cf\u30f3\u30d0\u30fc\u30ac\u30fc\u6025\u8972\u300d\u30ec\u30d9\u30eb\u3067\u306f\u30011\u4eba\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30b0\u30ea\u30eb\u3092\u7ba1\u7406\u3057\u3001\u3082\u30461\u4eba\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30c8\u30c3\u30d4\u30f3\u30b0\u3092\u7ba1\u7406\u3057\u3066\u3001\u4f5c\u696d\u3092\u30b9\u30d4\u30fc\u30c9\u30a2\u30c3\u30d7\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03: \u65e9\u6025\u306b\u7126\u3063\u3066\u3057\u307e\u3046\u3068\u30df\u30b9\u306b\u3064\u306a\u304c\u308a\u3001\u4e00\u5b9a\u306e\u30da\u30fc\u30b9\u3067\u4f5c\u696d\u3092\u7d9a\u3051\u308b\u3053\u3068\u304c\u6b63\u78ba\u6027\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002]"}, {"question": "\u30df\u30cb\u30b7\u30a7\u30d5\u30aa\u30fc\u30d0\u30fc\u30af\u30c3\u30af\u306b\u304a\u3051\u308b\u3001\u30ad\u30c3\u30c1\u30f3\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u306f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u304b\uff1f", "answer": "\u30df\u30cb\u30b7\u30a7\u30d5\u30aa\u30fc\u30d0\u30fc\u30af\u30c3\u30af\u306b\u304a\u3051\u308b\u3001\u30ad\u30c3\u30c1\u30f3\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u306f\u3001\u79fb\u52d5\u52b9\u7387\u3068\u4f5c\u696d\u306e\u6d41\u308c\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u305f\u3081\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u5927\u304d\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ad\u30c3\u30c1\u30f3\u304c\u5206\u304b\u308c\u3066\u3044\u308b\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u98df\u6750\u3092\u9699\u9593\u3092\u6e21\u3059\u305f\u3081\u306b\u9023\u643a\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u6700\u9069\u306a\u30ec\u30a4\u30a2\u30a6\u30c8\u306f\u4e0d\u8981\u306a\u52d5\u304d\u3092\u6e1b\u3089\u3057\u3001\u3088\u308a\u8fc5\u901f\u306a\u6ce8\u6587\u5b8c\u4e86\u3092\u53ef\u80fd\u306b\u3057\u307e\u3059\u3002[\u4f8b\u3048: \u30ad\u30c3\u30c1\u30f3\u306f\u3001\u6700\u77ed\u306e\u9053\u304c\u6210\u529f\u3078\u306e\u9375\u3068\u306a\u308b\u8ff7\u8def\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002]"}, {"question": "\u30df\u30cb\u30b7\u30a7\u30d5\u30aa\u30fc\u30d0\u30fc\u30af\u30c3\u30af\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u3069\u306e\u3088\u3046\u306a\u8981\u7d20\u304c\u30b9\u30b3\u30a2\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30df\u30cb\u30b7\u30a7\u30d5\u30aa\u30fc\u30d0\u30fc\u30af\u30c3\u30af\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u5b8c\u4e86\u3057\u305f\u6ce8\u6587\u6570\u3001\u305d\u306e\u8907\u96d1\u3055\u3001\u6240\u8981\u6642\u9593\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u30b9\u30b3\u30a2\u306b\u5f71\u97ff\u3059\u308b\u8981\u7d20\u306b\u306f\u3001\u6599\u7406\u306e\u6b63\u78ba\u3055\u3001\u914d\u9001\u901f\u5ea6\u3001\u30dc\u30fc\u30ca\u30b9\u30a2\u30a4\u30c6\u30e0\u306e\u4f7f\u7528\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5b8c\u74a7\u306a\u5bff\u53f8\u3092\u8fc5\u901f\u306b\u63d0\u4f9b\u3059\u308b\u3053\u3068\u306f\u3001\u30b7\u30f3\u30d7\u30eb\u306a\u30b5\u30e9\u30c0\u3088\u308a\u3082\u591a\u304f\u306e\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u307e\u3059\u3002[\u8868: \u7c21\u5358\u306a\u6599\u7406 - 100\u30dd\u30a4\u30f3\u30c8\u3001\u8907\u96d1\u306a\u6599\u7406 - 300\u30dd\u30a4\u30f3\u30c8\u3001\u30dc\u30fc\u30ca\u30b9\u30a2\u30a4\u30c6\u30e0 - +50\u30dd\u30a4\u30f3\u30c8\u3002]"}, {"question": "\u30b3\u30f3\u30bd\u30fc\u30eb\u7248\u3068PC\u7248\u306e\u30df\u30cb\u30b7\u30a7\u30d5\u30aa\u30fc\u30d0\u30fc\u30af\u30c3\u30af\u306e\u30d7\u30ec\u30a4\u306b\u304a\u3044\u3066\u3001\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b3\u30f3\u30bd\u30fc\u30eb\u7248\u3068PC\u7248\u306e\u30df\u30cb\u30b7\u30a7\u30d5\u30aa\u30fc\u30d0\u30fc\u30af\u30c3\u30af\u306e\u30d7\u30ec\u30a4\u306b\u304a\u3044\u3066\u306f\u3001\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u306e\u7a2e\u985e\u3068\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u304c\u4e3b\u306a\u9055\u3044\u3067\u3059\u3002\u30b3\u30f3\u30bd\u30fc\u30eb\u7248\u3067\u306f\u30b2\u30fc\u30e0\u30d1\u30c3\u30c9\u3092\u4f7f\u7528\u3059\u308b\u70ba\u3001\u64cd\u4f5c\u6027\u304c\u76f4\u611f\u7684\u3067\u3042\u308b\u5834\u5408\u3082\u3042\u308a\u307e\u3059\u4e00\u65b9\u3001PC\u7248\u3067\u306f\u30ad\u30fc\u30dc\u30fc\u30c9\u3084\u30ab\u30b9\u30bf\u30e0\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u9762\u3067\u306f\u3001\u30cf\u30fc\u30c9\u30a6\u30a7\u30a2\u306e\u6027\u80fd\u6b21\u7b2c\u3067\u3059\u304c\u3001PC\u7248\u306f\u30b3\u30f3\u30bd\u30fc\u30eb\u7248\u3088\u308a\u9ad8\u3044\u30d5\u30ec\u30fc\u30e0\u30ec\u30fc\u30c8\u3068\u89e3\u50cf\u5ea6\u3092\u5b9f\u73fe\u3059\u308b\u5834\u5408\u3082\u3042\u308a\u307e\u3059\u3002[\u6bd4\u8f03: \u30b3\u30f3\u30bd\u30fc\u30eb - \u30d7\u30e9\u30b0\u30a2\u30f3\u30c9\u30d7\u30ec\u30a4\u3001PC - \u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u53ef\u80fd\u306a\u8a2d\u5b9a\u3002]"}, {"question": "\u30df\u30cb\u30b7\u30a7\u30d5\u30aa\u30fc\u30d0\u30fc\u30af\u30c3\u30af\u3067\u3001\u96a0\u3057\u30ec\u30d9\u30eb\u3084\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306f\u3069\u306e\u3088\u3046\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30df\u30cb\u30b7\u30a7\u30d5\u30aa\u30fc\u30d0\u30fc\u30af\u30c3\u30af\u3067\u3001\u96a0\u3057\u30ec\u30d9\u30eb\u3084\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u306b\u306f\u3001\u7279\u5b9a\u306e\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u30af\u30ea\u30a2\u3057\u3001\u7279\u5b9a\u306e\u30ec\u30d9\u30eb\u3067\u9ad8\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6700\u521d\u306e\u30ad\u30c3\u30c1\u30f3\u306e\u5168\u3066\u306e\u30ec\u30d9\u30eb\u30673\u3064\u661f\u3092\u7372\u5f97\u3059\u308b\u3068\u3001\u79d8\u5bc6\u306e\u30ec\u30d9\u30eb\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002[\u4f8b\u3048: \u96a0\u3057\u30b3\u30f3\u30c6\u30f3\u30c4\u306e\u30a2\u30f3\u30ed\u30c3\u30af\u306f\u3001\u4e00\u9023\u306e\u30d1\u30ba\u30eb\u3092\u89e3\u3044\u3066\u5b9d\u7269\u3092\u63a2\u3059\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002]"}]
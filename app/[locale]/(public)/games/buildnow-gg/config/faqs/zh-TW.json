[{"question": "\u5982\u4f55\u8b93\u65b0\u73a9\u5bb6\u5feb\u901f\u5b78\u7fd2 BuildNow GG \u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u65b0\u73a9\u5bb6\u53ef\u4ee5\u5148\u5b8c\u6210\u904a\u6232\u5167\u6559\u5b78\uff0c\u8a72\u6559\u5b78\u6db5\u84cb\u4e86\u79fb\u52d5\u3001\u5efa\u7bc9\u548c\u8207\u7269\u4ef6\u4e92\u52d5\u7b49\u57fa\u672c\u64cd\u4f5c\u3002\u4f8b\u5982\uff0c\u8981\u5efa\u9020\u4e00\u500b\u57fa\u672c\u7d50\u69cb\uff0c\u8acb\u6309\u300eB\u300f\u9375\u958b\u555f\u5efa\u7bc9\u9078\u55ae\uff0c\u9078\u64c7\u6240\u9700\u7684\u65b9\u584a\uff0c\u7136\u5f8c\u9ede\u64ca\u6ed1\u9f20\u5de6\u9375\u653e\u7f6e\u3002\u6b64\u5916\uff0c\u63a7\u5236\u8a2d\u5b9a\u9078\u55ae\u5141\u8a31\u81ea\u8a02\u9375\u76e4\u7d81\u5b9a\uff0c\u4ee5\u6eff\u8db3\u500b\u4eba\u504f\u597d\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u6559\u5b78\u60f3\u50cf\u6210\u6307\u5f15\u4f60\u5b8c\u6210 BuildNow GG \u521d\u671f\u6b65\u9a5f\u7684\u8def\u7dda\u5716\u3002]"}, {"question": "\u5728 BuildNow GG \u73a9\u4e86 100 \u5c0f\u6642\u5f8c\uff0c\u54ea\u4e9b\u8cc7\u6e90\u7ba1\u7406\u7b56\u7565\u6700\u6709\u6548\uff1f", "answer": "\u5728\u73a9\u4e86 100 \u5c0f\u6642\u5f8c\uff0c\u73a9\u5bb6\u61c9\u8a72\u5c08\u6ce8\u65bc\u512a\u5316\u8cc7\u6e90\u6536\u96c6\u548c\u4f7f\u7528\u3002\u6b65\u9a5f\u4e00\uff1a\u5728\u4e0d\u540c\u751f\u7269\u7fa4\u843d\u5efa\u7acb\u591a\u500b\u8cc7\u6e90\u64da\u9ede\uff0c\u4ee5\u78ba\u4fdd\u7a69\u5b9a\u4f9b\u61c9\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u5148\u9032\u5de5\u5177\uff0c\u4f8b\u5982\u81ea\u52d5\u6536\u96c6\u5668\uff0c\u4ee5\u6700\u5927\u5316\u6548\u7387\u3002\u6b65\u9a5f\u4e09\uff1a\u512a\u5148\u88fd\u4f5c\u63d0\u4f9b\u6700\u4f73\u8cc7\u6e90\u6548\u76ca\u6bd4\u7684\u9ad8\u968e\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u53ca\u65e9\u88fd\u4f5c\u947d\u77f3\u93ac\u53ef\u4ee5\u986f\u8457\u52a0\u5feb\u63a1\u7926\u4f5c\u696d\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6bd4\u8f03\u4e0d\u540c\u5de5\u5177\u7684\u8cc7\u6e90\u7522\u91cf\uff0c\u4ee5\u8fa8\u5225\u6700\u6709\u6548\u7387\u7684\u9078\u9805\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u4e86\u89e3\u904a\u6232\u7684\u7269\u7406\u5f15\u64ce\u5c0d\u65bc BuildNow GG \u7684\u9ad8\u7d1a\u5efa\u7bc9\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "BuildNow GG \u7684\u7269\u7406\u5f15\u64ce\u6c7a\u5b9a\u4e86\u5efa\u7bc9\u7269\u5728\u5404\u7a2e\u60c5\u6cc1\u4e0b\u7684\u884c\u70ba\u65b9\u5f0f\u3002\u4f8b\u5982\uff0c\u6c92\u6709\u9069\u7576\u652f\u6490\u5efa\u9020\u9ad8\u5854\u53ef\u80fd\u6703\u5c0e\u81f4\u5012\u584c\u3002\u4e86\u89e3\u9019\u4e9b\u6a5f\u5236\u8b93\u73a9\u5bb6\u53ef\u4ee5\u5275\u9020\u66f4\u8907\u96dc\u4e14\u7a69\u5b9a\u7684\u7d50\u69cb\u3002\u4f7f\u7528\u300c\u652f\u6490\u6a11\u300d\u7269\u54c1\u52a0\u56fa\u5efa\u7bc9\u7269\uff0c\u4e26\u9632\u6b62\u7d50\u69cb\u6545\u969c\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u5c07\u7d50\u69cb\u4e0a\u7684\u61c9\u529b\u9ede\u53ef\u8996\u5316\uff0c\u4ee5\u78ba\u5b9a\u52a0\u56fa\u9700\u6c42\u6240\u5728\u3002]"}, {"question": "BuildNow GG \u4e2d\u54ea\u4e9b\u904a\u6232\u6d3b\u52d5\u5c0d\u6210\u5c31\u7375\u4eba\u4f86\u8aaa\u734e\u52f5\u6700\u8c50\u539a\uff1f", "answer": "\u50cf\u300c\u51ac\u5b63\u7bc0\u6176\u300d\u548c\u300c\u8c50\u6536\u6708\u300d\u7b49\u5b63\u7bc0\u6027\u6d3b\u52d5\u63d0\u4f9b\u7368\u5bb6\u734e\u52f5\uff0c\u4f8b\u5982\u7a00\u6709\u76ae\u819a\u548c\u5716\u7d19\u3002\u4f8b\u5982\uff0c\u5b8c\u6210\u6240\u6709\u51ac\u5b63\u7bc0\u6176\u6311\u6230\u53ef\u7372\u5f97\u300c\u96ea\u82b1\u5efa\u7bc9\u5e2b\u300d\u982d\u929c\u3002\u9019\u4e9b\u6d3b\u52d5\u6642\u9593\u6709\u9650\uff0c\u56e0\u6b64\u63d0\u524d\u898f\u5283\u4e26\u7a4d\u6975\u53c3\u8207\u662f\u6700\u5927\u5316\u734e\u52f5\u7684\u95dc\u9375\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u6bd4\u8f03\u4e0d\u540c\u6d3b\u52d5\u7684\u734e\u52f5\uff0c\u4ee5\u4fbf\u6839\u64da\u60a8\u7684\u76ee\u6a19\u512a\u5148\u53c3\u8207\u3002]"}, {"question": "\u591a\u4eba\u6a21\u5f0f\u5982\u4f55\u5728 BuildNow GG \u4e2d\u63d0\u5347\u65b0\u73a9\u5bb6\u7684\u6e38\u620f\u9ad4\u9a57\uff1f", "answer": "\u591a\u4eba\u6a21\u5f0f\u5141\u8a31\u65b0\u73a9\u5bb6\u5408\u4f5c\u9032\u884c\u5927\u578b\u5c08\u6848\uff0c\u4e26\u5f9e\u7d93\u9a57\u8c50\u5bcc\u7684\u5efa\u7bc9\u5e2b\u8eab\u4e0a\u5b78\u7fd2\u3002\u4f8b\u5982\uff0c\u52a0\u5165\u793e\u7fa4\u4f3a\u670d\u5668\u53ef\u4ee5\u7372\u5f97\u9810\u5efa\u7d50\u69cb\u548c\u5171\u4eab\u8cc7\u6e90\u7684\u6a5f\u6703\uff0c\u8b93\u65b0\u73a9\u5bb6\u66f4\u5bb9\u6613\u4e0a\u624b\u3002\u793e\u4ea4\u65b9\u9762\u4e5f\u589e\u52a0\u4e86\u6a02\u8da3\u548c\u52d5\u529b\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u591a\u4eba\u6a21\u5f0f\u60f3\u50cf\u6210\u4e00\u500b\u5408\u4f5c\u5de5\u4f5c\u574a\uff0c\u6bcf\u500b\u4eba\u90fd\u70ba\u5171\u4eab\u9858\u666f\u505a\u51fa\u8ca2\u737b\u3002]"}, {"question": "\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u7684\u7d93\u6fdf\u9ad4\u7cfb\u5728 BuildNow GG \u4e2d\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u5225\uff1f", "answer": "\u5728\u55ae\u4eba\u6a21\u5f0f\u4e2d\uff0c\u7d93\u6fdf\u9ad4\u7cfb\u662f\u7368\u7acb\u7684\uff0c\u8cc7\u6e90\u7531\u55ae\u7368\u7684\u73a9\u5bb6\u7522\u751f\u548c\u6d88\u8017\u3002\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u8cc7\u6e90\u53ef\u4ee5\u9032\u884c\u4ea4\u6613\u548c\u5206\u4eab\uff0c\u7522\u751f\u4e00\u500b\u52d5\u614b\u7684\u5e02\u5834\u3002\u4f8b\u5982\uff0c\u67d0\u751f\u7269\u7fa4\u843d\u4e2d\u627e\u5230\u7684\u7a00\u6709\u6750\u6599\u53ef\u4ee5\u8207\u5176\u4ed6\u751f\u7269\u7fa4\u843d\u4e2d\u7684\u4e0d\u540c\u8cc7\u6e90\u9032\u884c\u4ea4\u6613\u3002\u9019\u7a2e\u76f8\u4e92\u4f9d\u5b58\u6027\u4fc3\u9032\u4e86\u5408\u4f5c\u7684\u904a\u6232\u74b0\u5883\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6bd4\u8f03\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u4e2d\u7684\u8cc7\u6e90\u53ef\u7528\u6027\u8207\u4ea4\u6613\u50f9\u503c\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5c07 BuildNow GG \u5728 PC \u4e0a\u7684\u9032\u5ea6\u9077\u79fb\u5230\u4e3b\u6a5f\u5e73\u53f0\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u900f\u904e\u5c07\u904a\u6232\u5e33\u6236\u9023\u7d50\u5230\u5168\u5e73\u53f0 BuildNow GG ID \u4f86\u9077\u79fb\u9032\u5ea6\u3002\u6b65\u9a5f\u4e00\uff1a\u767b\u5165 PC \u7248\u5e33\u6236\uff0c\u4e26\u700f\u89bd\u300e\u5e33\u6236\u8a2d\u7f6e\u300f\u9078\u55ae\u3002\u6b65\u9a5f\u4e8c\uff1a\u751f\u6210\u9077\u79fb\u4ee3\u78bc\u3002\u6b65\u9a5f\u4e09\uff1a\u5728\u4e3b\u6a5f\u7248\u8f38\u5165\u6b64\u4ee3\u78bc\u4ee5\u540c\u6b65\u60a8\u7684\u6578\u64da\u3002\u6b64\u904e\u7a0b\u78ba\u4fdd\u6240\u6709\u5efa\u7bc9\u548c\u6210\u5c31\u90fd\u80fd\u5728\u5e73\u53f0\u4e4b\u9593\u4fdd\u7559\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u9010\u6b65\u5448\u73fe\u9077\u79fb\u904e\u7a0b\u7684\u5716\u5f62\uff0c\u4ee5\u78ba\u4fdd\u9806\u5229\u8f49\u63db\u3002]"}, {"question": "\u73a9\u5bb6\u5728 BuildNow GG \u4e2d\u53ef\u4ee5\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "BuildNow GG \u5145\u6eff\u4e86\u96b1\u85cf\u529f\u80fd\uff0c\u4f8b\u5982\u900f\u904e\u63a2\u7d22\u504f\u9060\u5340\u57df\u53ef\u4ee5\u89e3\u9396\u7684\u79d8\u5bc6\u5716\u7d19\u3002\u4f8b\u5982\uff0c\u5728\u6c99\u6f20\u751f\u7269\u7fa4\u843d\u4e2d\u627e\u5230\u300c\u5931\u843d\u795e\u5edf\u300d\u53ef\u4ee5\u7372\u5f97\u7368\u7279\u7684\u5efa\u7bc9\u98a8\u683c\u3002\u9019\u4e9b\u767c\u73fe\u589e\u6dfb\u4e86\u9a5a\u559c\u548c\u63a2\u7d22\u7684\u6a02\u8da3\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u9019\u4e9b\u96b1\u85cf\u529f\u80fd\u60f3\u50cf\u6210\u7b49\u5f85\u5728 BuildNow GG \u5ee3\u95ca\u4e16\u754c\u4e2d\u88ab\u767c\u73fe\u7684\u5bf6\u7bb1\u3002]"}, {"question": "BuildNow GG \u4e2d\u4e0d\u540c\u7684\u751f\u7269\u7fa4\u843d\u5982\u4f55\u5f71\u97ff\u5efa\u7bc9\u7b56\u7565\uff1f", "answer": "BuildNow GG \u4e2d\u7684\u6bcf\u500b\u751f\u7269\u7fa4\u843d\u90fd\u63d0\u4f9b\u7368\u7279\u7684\u8cc7\u6e90\u548c\u6311\u6230\u3002\u4f8b\u5982\uff0c\u68ee\u6797\u751f\u7269\u7fa4\u843d\u5bcc\u542b\u6728\u6750\uff0c\u4f46\u77f3\u982d\u8cc7\u6e90\u6709\u9650\uff1b\u800c\u5c71\u8108\u751f\u7269\u7fa4\u843d\u64c1\u6709\u8c50\u5bcc\u7684\u7926\u7269\uff0c\u4f46\u96e3\u4ee5\u901a\u884c\u3002\u9069\u61c9\u9019\u4e9b\u689d\u4ef6\u7684\u5efa\u7bc9\u7b56\u7565\u81f3\u95dc\u91cd\u8981\u3002\u4f7f\u7528\u300c\u5730\u5f62\u6383\u63cf\u5668\u300d\u8a55\u4f30\u8cc7\u6e90\u53ef\u7528\u6027\uff0c\u7136\u5f8c\u518d\u958b\u59cb\u5c08\u6848\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u6bd4\u8f03\u5728\u4e0d\u540c\u751f\u7269\u7fa4\u843d\u4e2d\u5efa\u7bc9\u7684\u512a\u52a3\u52e2\uff0c\u4ee5\u512a\u5316\u7b56\u7565\u3002]"}, {"question": "\u5982\u4f55\u6700\u4f73\u5316\u5730\u5728 BuildNow GG \u5167\u4f7f\u7528\u5148\u9032\u7684\u5de5\u5320\u7cfb\u7d71\uff1f", "answer": "\u5148\u9032\u7684\u5de5\u5320\u7cfb\u7d71\u5141\u8a31\u73a9\u5bb6\u5275\u9020\u8907\u96dc\u7684\u7269\u54c1\u548c\u6a5f\u68b0\u3002\u6b65\u9a5f\u4e00\uff1a\u6536\u96c6\u7a00\u6709\u6750\u6599\uff0c\u4f8b\u5982\u9226\u548c\u9ed1\u66dc\u77f3\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u300c\u4e8c\u4ee3\u5de5\u5320\u53f0\u300d\u89e3\u9396\u66f4\u9ad8\u968e\u7684\u914d\u65b9\u3002\u6b65\u9a5f\u4e09\uff1a\u5c07\u6750\u6599\u7d44\u5408\u88fd\u4f5c\u5f37\u5927\u7684\u5de5\u5177\u548c\u8a2d\u5099\uff0c\u4f8b\u5982\u300c\u91cf\u5b50\u767c\u96fb\u6a5f\u300d\uff0c\u5b83\u63d0\u4f9b\u7121\u9650\u80fd\u91cf\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6bd4\u8f03\u4e0d\u540c\u5148\u9032\u88fd\u4f5c\u7269\u54c1\u7684\u512a\u52e2\uff0c\u4ee5\u6c7a\u5b9a\u6700\u9069\u5408\u60a8\u904a\u6232\u98a8\u683c\u7684\u7269\u54c1\u3002]"}]
[{"question": "BuildNow GG\u3067\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u57fa\u672c\u64cd\u4f5c\u3092\u7d20\u65e9\u304f\u5b66\u3076\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u307e\u305a\u30b2\u30fc\u30e0\u5185\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3067\u59cb\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3067\u306f\u3001\u79fb\u52d5\u3001\u5efa\u7bc9\u3001\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3068\u306e\u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3\u3068\u3044\u3063\u305f\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u304c\u7db2\u7f85\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u57fa\u672c\u7684\u306a\u69cb\u9020\u7269\u3092\u5efa\u8a2d\u3059\u308b\u306b\u306f\u3001\u300eB\u300f\u30ad\u30fc\u3092\u62bc\u3057\u3066\u5efa\u7bc9\u30e1\u30cb\u30e5\u30fc\u3092\u958b\u304d\u3001\u76ee\u7684\u306e\u30d6\u30ed\u30c3\u30af\u3092\u9078\u629e\u3057\u3001\u5de6\u30af\u30ea\u30c3\u30af\u3067\u914d\u7f6e\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u3067\u306f\u3001\u500b\u3005\u306e\u597d\u307f\u306b\u5408\u308f\u305b\u3066\u30ad\u30fc\u30d0\u30a4\u30f3\u30c9\u3092\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3067\u304d\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u306f\u3001BuildNow GG\u3067\u306e\u6700\u521d\u306e\u30b9\u30c6\u30c3\u30d7\u3092\u6848\u5185\u3059\u308b\u9053\u6a19\u3060\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30d7\u30ec\u30a4\u6642\u9593100\u6642\u9593\u3092\u8d85\u3048\u305fBuildNow GG\u3067\u8cc7\u6e90\u7ba1\u7406\u306e\u6700\u3082\u52b9\u679c\u7684\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "100\u6642\u9593\u3092\u8d85\u3048\u305f\u5f8c\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u8cc7\u6e90\u306e\u53ce\u96c6\u3068\u5229\u7528\u3092\u6700\u9069\u5316\u3059\u308b\u3053\u3068\u306b\u91cd\u70b9\u3092\u7f6e\u304f\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002STEP1\uff1a\u591a\u69d8\u306a\u30d0\u30a4\u30aa\u30fc\u30e0\u306b\u8907\u6570\u306e\u8cc7\u6e90\u62e0\u70b9\u3092\u8a2d\u7f6e\u3057\u3066\u3001\u5b89\u5b9a\u7684\u306a\u4f9b\u7d66\u3092\u78ba\u4fdd\u3057\u307e\u3059\u3002STEP2\uff1a\u81ea\u52d5\u53ce\u96c6\u6a5f\u306a\u3069\u306e\u9ad8\u5ea6\u306a\u30c4\u30fc\u30eb\u3092\u4f7f\u7528\u3057\u3066\u52b9\u7387\u3092\u6700\u5927\u5316\u3057\u307e\u3059\u3002STEP3\uff1a\u30ea\u30bd\u30fc\u30b9\u5bfe\u5229\u76ca\u6bd4\u304c\u6700\u3082\u9ad8\u3044\u4e0a\u4f4d\u30a2\u30a4\u30c6\u30e0\u306e\u30af\u30e9\u30d5\u30c8\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30c0\u30a4\u30e4\u30e2\u30f3\u30c9\u306e\u30c4\u30eb\u30cf\u30b7\u3092\u65e9\u671f\u306b\u30af\u30e9\u30d5\u30c8\u3059\u308b\u3053\u3068\u3067\u3001\u63a1\u6398\u4f5c\u696d\u3092\u5927\u5e45\u306b\u9ad8\u901f\u5316\u3067\u304d\u307e\u3059\u3002[\u914d\u7f6e\u5bfe\u7167\u8868\uff1a\u3055\u307e\u3056\u307e\u306a\u30c4\u30fc\u30eb\u306e\u8cc7\u6e90\u53ce\u76ca\u3092\u6bd4\u8f03\u3057\u3066\u3001\u6700\u3082\u52b9\u7387\u7684\u306a\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002]"}, {"question": "\u30b2\u30fc\u30e0\u306e\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001BuildNow GG\u306e\u9ad8\u5ea6\u306a\u5efa\u7bc9\u306b\u306a\u305c\u91cd\u8981\u306a\u306e\u3067\u3059\u304b\uff1f", "answer": "BuildNow GG\u306e\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u6761\u4ef6\u4e0b\u3067\u306e\u69cb\u9020\u7269\u306e\u6319\u52d5\u3092\u6c7a\u5b9a\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u9069\u5207\u306a\u30b5\u30dd\u30fc\u30c8\u306a\u3057\u306b\u9ad8\u3044\u5854\u3092\u5efa\u8a2d\u3059\u308b\u3068\u3001\u5d29\u58ca\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3088\u308a\u8907\u96d1\u3067\u5b89\u5b9a\u3057\u305f\u69cb\u9020\u7269\u3092\u69cb\u7bc9\u3067\u304d\u307e\u3059\u3002\u5efa\u7269\u306b\u88dc\u5f37\u6750\u3092\u9069\u7528\u3057\u3001\u69cb\u9020\u4e0a\u306e\u6b20\u9665\u3092\u9632\u3050\u305f\u3081\u306b\u300c\u30b5\u30dd\u30fc\u30c8\u30d3\u30fc\u30e0\u300d\u30a2\u30a4\u30c6\u30e0\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u69cb\u9020\u7269\u306e\u5fdc\u529b\u70b9\u3092\u8996\u899a\u5316\u3057\u3066\u3001\u88dc\u5f37\u304c\u5fc5\u8981\u306a\u5834\u6240\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002]"}, {"question": "BuildNow GG\u306e\u3069\u306e\u30b2\u30fc\u30e0\u30a4\u30d9\u30f3\u30c8\u304c\u3001\u9054\u6210\u5ea6\u30cf\u30f3\u30bf\u30fc\u306b\u3068\u3063\u3066\u6700\u9069\u306a\u5831\u916c\u3092\u63d0\u4f9b\u3057\u307e\u3059\u304b\uff1f", "answer": "\u300c\u51ac\u796d\u308a\u300d\u3084\u300c\u53ce\u7a6b\u796d\u300d\u306a\u3069\u306e\u5b63\u7bc0\u30a4\u30d9\u30f3\u30c8\u306f\u3001\u30ec\u30a2\u306a\u30b9\u30ad\u30f3\u3084\u8a2d\u8a08\u56f3\u306a\u3069\u306e\u9650\u5b9a\u5831\u916c\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u51ac\u796d\u308a\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u3059\u3079\u3066\u5b8c\u4e86\u3059\u308b\u3068\u3001\u300c\u96ea\u306e\u5efa\u7bc9\u5bb6\u300d\u306e\u79f0\u53f7\u304c\u4e0e\u3048\u3089\u308c\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30a4\u30d9\u30f3\u30c8\u306f\u671f\u9593\u9650\u5b9a\u306a\u306e\u3067\u3001\u8a08\u753b\u3092\u7acb\u3066\u3001\u7a4d\u6975\u7684\u306b\u53c2\u52a0\u3059\u308b\u3053\u3068\u3067\u5831\u916c\u3092\u6700\u5927\u5316\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002[\u8907\u6570\u306e\u9078\u629e\u80a2\u306e\u6bd4\u8f03\uff1a\u3055\u307e\u3056\u307e\u306a\u30a4\u30d9\u30f3\u30c8\u306e\u5831\u916c\u3092\u6bd4\u8f03\u3057\u3066\u3001\u76ee\u6a19\u306b\u57fa\u3065\u3044\u3066\u53c2\u52a0\u3092\u512a\u5148\u3057\u307e\u3059\u3002]"}, {"question": "BuildNow GG\u306e\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u3001\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u3069\u306e\u3088\u3046\u306b\u5411\u4e0a\u3055\u305b\u307e\u3059\u304b\uff1f", "answer": "\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3067\u306f\u3001\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u5927\u304d\u306a\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u3067\u5354\u529b\u3057\u3001\u7d4c\u9a13\u8c4a\u5bcc\u306a\u5efa\u7bc9\u5bb6\u304b\u3089\u5b66\u3076\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u30b5\u30fc\u30d0\u30fc\u306b\u53c2\u52a0\u3059\u308b\u3068\u3001\u65e2\u5b58\u306e\u69cb\u9020\u7269\u3084\u5171\u6709\u8cc7\u6e90\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u305f\u3081\u3001\u958b\u59cb\u304c\u5bb9\u6613\u306b\u306a\u308a\u307e\u3059\u3002\u307e\u305f\u3001\u30bd\u30fc\u30b7\u30e3\u30eb\u306a\u5074\u9762\u306f\u3001\u697d\u3057\u307f\u3068\u30e2\u30c1\u30d9\u30fc\u30b7\u30e7\u30f3\u306e\u5c64\u3082\u52a0\u3048\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u7686\u304c\u5171\u901a\u306e\u30d3\u30b8\u30e7\u30f3\u306b\u8ca2\u732e\u3059\u308b\u5171\u540c\u4f5c\u696d\u5834\u3060\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "BuildNow GG\u306e\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u7d4c\u6e08\u306b\u306f\u3001\u3069\u306e\u3088\u3046\u306a\u91cd\u8981\u306a\u9055\u3044\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u306f\u3001\u7d4c\u6e08\u306f\u81ea\u5df1\u5b8c\u7d50\u578b\u3067\u3042\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u81ea\u8eab\u306b\u3088\u3063\u3066\u8cc7\u6e90\u304c\u751f\u6210\u3055\u308c\u3001\u6d88\u8cbb\u3055\u308c\u307e\u3059\u3002\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u306f\u3001\u8cc7\u6e90\u304c\u30d7\u30ec\u30a4\u30e4\u30fc\u9593\u3067\u53d6\u5f15\u3055\u308c\u3001\u5171\u6709\u3055\u308c\u308b\u305f\u3081\u3001\u30c0\u30a4\u30ca\u30df\u30c3\u30af\u306a\u5e02\u5834\u304c\u5f62\u6210\u3055\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u3042\u308b\u30d0\u30a4\u30aa\u30fc\u30e0\u3067\u767a\u898b\u3055\u308c\u305f\u5e0c\u5c11\u306a\u6750\u6599\u304c\u3001\u5225\u306e\u30d0\u30a4\u30aa\u30fc\u30e0\u306e\u7570\u306a\u308b\u8cc7\u6e90\u3068\u53d6\u5f15\u3055\u308c\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u306e\u76f8\u4e92\u4f9d\u5b58\u306f\u3001\u5354\u8abf\u7684\u306a\u30b2\u30fc\u30e0\u74b0\u5883\u3092\u4fc3\u9032\u3057\u307e\u3059\u3002[\u914d\u7f6e\u5bfe\u7167\u8868\uff1a\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306b\u304a\u3051\u308b\u8cc7\u6e90\u306e\u5165\u624b\u53ef\u80fd\u6027\u3068\u53d6\u5f15\u4fa1\u5024\u3092\u6bd4\u8f03\u3057\u307e\u3059\u3002]"}, {"question": "PC\u304b\u3089\u30b3\u30f3\u30bd\u30fc\u30eb\u306bBuildNow GG\u306e\u9032\u884c\u72b6\u6cc1\u3092\u79fb\u884c\u3059\u308b\u306b\u306f\u3001\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30b2\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30e6\u30cb\u30d0\u30fc\u30b5\u30ebBuildNow GG ID\u306b\u30ea\u30f3\u30af\u3059\u308b\u3053\u3068\u3067\u9032\u884c\u72b6\u6cc1\u3092\u79fb\u884c\u3067\u304d\u307e\u3059\u3002STEP1\uff1aPC\u7248\u306e\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3001\u300c\u30a2\u30ab\u30a6\u30f3\u30c8\u8a2d\u5b9a\u300d\u30e1\u30cb\u30e5\u30fc\u306b\u79fb\u52d5\u3057\u307e\u3059\u3002STEP2\uff1a\u79fb\u884c\u30b3\u30fc\u30c9\u3092\u751f\u6210\u3057\u307e\u3059\u3002STEP3\uff1a\u3053\u306e\u30b3\u30fc\u30c9\u3092\u30b3\u30f3\u30bd\u30fc\u30eb\u7248\u306b\u5165\u529b\u3057\u3066\u30c7\u30fc\u30bf\u3092\u540c\u671f\u3057\u307e\u3059\u3002\u3053\u306e\u30d7\u30ed\u30bb\u30b9\u306b\u3088\u308a\u3001\u3059\u3079\u3066\u306e\u5efa\u7bc9\u7269\u3068\u9054\u6210\u5ea6\u304c\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u4fdd\u5b58\u3055\u308c\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30b9\u30e0\u30fc\u30ba\u306a\u79fb\u884c\u3092\u4fdd\u8a3c\u3059\u308b\u305f\u3081\u306b\u3001\u6bb5\u968e\u7684\u306b\u79fb\u884c\u30d7\u30ed\u30bb\u30b9\u3092\u8996\u899a\u5316\u3057\u307e\u3059\u3002]"}, {"question": "BuildNow GG\u306b\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "BuildNow GG\u306b\u306f\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u304c\u305f\u304f\u3055\u3093\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u9060\u9694\u5730\u3092\u63a2\u7d22\u3059\u308b\u3053\u3068\u3067\u89e3\u304d\u30ed\u30c3\u30af\u3067\u304d\u308b\u79d8\u5bc6\u306e\u8a2d\u8a08\u56f3\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u7802\u6f20\u30d0\u30a4\u30aa\u30fc\u30e0\u306e\u300c\u5931\u308f\u308c\u305f\u795e\u6bbf\u300d\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u3067\u3001\u72ec\u7279\u306e\u5efa\u7bc9\u69d8\u5f0f\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u767a\u898b\u306f\u3001\u9a5a\u304d\u3068\u63a2\u7d22\u306e\u8981\u7d20\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u3053\u308c\u3089\u306e\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u306f\u3001BuildNow GG\u306e\u5e83\u5927\u306a\u4e16\u754c\u306e\u4e2d\u306e\u5b9d\u7bb1\u3060\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "BuildNow GG\u306e\u7570\u306a\u308b\u30d0\u30a4\u30aa\u30fc\u30e0\u306f\u3001\u5efa\u7bc9\u6226\u7565\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "BuildNow GG\u306e\u5404\u30d0\u30a4\u30aa\u30fc\u30e0\u306f\u3001\u72ec\u81ea\u306e\u8cc7\u6e90\u3068\u8ab2\u984c\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u68ee\u6797\u30d0\u30a4\u30aa\u30fc\u30e0\u306f\u6728\u6750\u306b\u5bcc\u3093\u3067\u3044\u307e\u3059\u304c\u3001\u77f3\u306f\u9650\u3089\u308c\u3066\u3044\u307e\u3059\u3002\u4e00\u65b9\u3001\u5c71\u5cb3\u30d0\u30a4\u30aa\u30fc\u30e0\u306f\u8c4a\u5bcc\u306a\u9271\u7269\u8cc7\u6e90\u3092\u6709\u3059\u308b\u4e00\u65b9\u3067\u3001\u79fb\u52d5\u304c\u56f0\u96e3\u3067\u3059\u3002\u3053\u308c\u3089\u306e\u6761\u4ef6\u306b\u5408\u308f\u305b\u3066\u5efa\u7bc9\u6226\u7565\u3092\u9069\u5fdc\u3055\u305b\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u3092\u958b\u59cb\u3059\u308b\u524d\u306b\u3001\u300c\u5730\u5f62\u30b9\u30ad\u30e3\u30ca\u30fc\u300d\u3092\u4f7f\u7528\u3057\u3066\u8cc7\u6e90\u306e\u5165\u624b\u53ef\u80fd\u6027\u3092\u8a55\u4fa1\u3057\u307e\u3059\u3002[\u8907\u6570\u306e\u9078\u629e\u80a2\u306e\u6bd4\u8f03\uff1a\u3055\u307e\u3056\u307e\u306a\u30d0\u30a4\u30aa\u30fc\u30e0\u3067\u5efa\u7bc9\u3092\u884c\u3046\u3053\u3068\u306e\u5229\u70b9\u3068\u6b20\u70b9\u3092\u6bd4\u8f03\u3057\u3066\u3001\u6226\u7565\u3092\u6700\u9069\u5316\u3057\u307e\u3059\u3002]"}, {"question": "BuildNow GG\u306e\u9ad8\u5ea6\u306a\u30af\u30e9\u30d5\u30c8\u30b7\u30b9\u30c6\u30e0\u3092\u6700\u3082\u52b9\u679c\u7684\u306b\u5229\u7528\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u9ad8\u5ea6\u306a\u30af\u30e9\u30d5\u30c8\u30b7\u30b9\u30c6\u30e0\u306b\u3088\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u8907\u96d1\u306a\u30a2\u30a4\u30c6\u30e0\u3084\u6a5f\u68b0\u3092\u4f5c\u6210\u3067\u304d\u307e\u3059\u3002STEP1\uff1a\u30c1\u30bf\u30f3\u3084\u30aa\u30d6\u30b7\u30c7\u30a3\u30a2\u30f3\u306a\u3069\u306e\u5e0c\u5c11\u306a\u6750\u6599\u3092\u96c6\u3081\u307e\u3059\u3002STEP2\uff1a\u300e\u30af\u30e9\u30d5\u30c8\u30c6\u30fc\u30d6\u30ebMk.II\u300f\u3092\u4f7f\u7528\u3057\u3066\u3001\u4e0a\u4f4d\u30ec\u30b7\u30d4\u3092\u89e3\u304d\u30ed\u30c3\u30af\u3057\u307e\u3059\u3002STEP3\uff1a\u6750\u6599\u3092\u7d44\u307f\u5408\u308f\u305b\u3001\u5f37\u529b\u306a\u30c4\u30fc\u30eb\u3084\u88c5\u7f6e\uff08\u7121\u9650\u306e\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u63d0\u4f9b\u3059\u308b\u300c\u91cf\u5b50\u30b8\u30a7\u30cd\u30ec\u30fc\u30bf\u30fc\u300d\u306a\u3069\uff09\u3092\u30af\u30e9\u30d5\u30c8\u3057\u307e\u3059\u3002[\u914d\u7f6e\u5bfe\u7167\u8868\uff1a\u3055\u307e\u3056\u307e\u306a\u9ad8\u5ea6\u306a\u30af\u30e9\u30d5\u30c8\u30a2\u30a4\u30c6\u30e0\u306e\u5229\u70b9\u3092\u6bd4\u8f03\u3057\u3001\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u6700\u9069\u306a\u3082\u306e\u3092\u6c7a\u5b9a\u3057\u307e\u3059\u3002]"}]
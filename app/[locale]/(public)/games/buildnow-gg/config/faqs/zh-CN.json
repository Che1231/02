[{"question": "\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u5feb\u901f\u638c\u63e1BuildNow GG\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u65b0\u73a9\u5bb6\u53ef\u4ee5\u4ece\u6e38\u620f\u4e2d\u5b8c\u6210\u6559\u7a0b\u5f00\u59cb\uff0c\u6559\u7a0b\u6db5\u76d6\u4e86\u79fb\u52a8\u3001\u5efa\u9020\u548c\u4e0e\u7269\u54c1\u4ea4\u4e92\u7b49\u57fa\u672c\u64cd\u4f5c\u3002\u4f8b\u5982\uff0c\u8981\u5efa\u9020\u4e00\u4e2a\u7b80\u5355\u7684\u7ed3\u6784\uff0c\u8bf7\u6309'B'\u952e\u6253\u5f00\u5efa\u9020\u83dc\u5355\uff0c\u9009\u62e9\u6240\u9700\u7684\u65b9\u5757\uff0c\u7136\u540e\u5de6\u952e\u70b9\u51fb\u653e\u7f6e\u3002\u6b64\u5916\uff0c\u63a7\u5236\u8bbe\u7f6e\u83dc\u5355\u5141\u8bb8\u81ea\u5b9a\u4e49\u6309\u952e\u7ed1\u5b9a\uff0c\u4ee5\u6ee1\u8db3\u4e2a\u4eba\u504f\u597d\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u6559\u7a0b\u89c6\u4e3a\u6307\u5f15\u4f60\u5b8c\u6210BuildNow GG\u521d\u59cb\u6b65\u9aa4\u7684\u8def\u7ebf\u56fe\u3002]"}, {"question": "\u5728\u6e38\u620f\u73a9\u4e86100\u5c0f\u65f6\u540e\uff0c\u5728BuildNow GG\u4e2d\u7ba1\u7406\u8d44\u6e90\u6700\u6709\u6548\u7684\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u73a9\u4e86100\u5c0f\u65f6\u540e\uff0c\u73a9\u5bb6\u5e94\u8be5\u4e13\u6ce8\u4e8e\u4f18\u5316\u8d44\u6e90\u91c7\u96c6\u548c\u4f7f\u7528\u3002\u6b65\u9aa4\u4e00\uff1a\u5728\u4e0d\u540c\u7684\u751f\u7269\u7fa4\u843d\u5efa\u7acb\u591a\u4e2a\u8d44\u6e90\u636e\u70b9\uff0c\u4ee5\u786e\u4fdd\u7a33\u5b9a\u7684\u4f9b\u5e94\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u9ad8\u7ea7\u5de5\u5177\uff0c\u4f8b\u5982\u81ea\u52a8\u91c7\u96c6\u5668\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u6548\u7387\u3002\u6b65\u9aa4\u4e09\uff1a\u4f18\u5148\u5236\u4f5c\u63d0\u4f9b\u6700\u4f73\u8d44\u6e90\u56de\u62a5\u6bd4\u7684\u9ad8\u7ea7\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u65e9\u671f\u5236\u4f5c\u94bb\u77f3\u9550\u53ef\u4ee5\u663e\u8457\u52a0\u5feb\u91c7\u77ff\u64cd\u4f5c\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u6bd4\u8f83\u4e0d\u540c\u5de5\u5177\u7684\u8d44\u6e90\u4ea7\u51fa\uff0c\u4ee5\u8bc6\u522b\u6700\u6709\u6548\u7684\u9009\u9879\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u7406\u89e3\u6e38\u620f\u7684\u7269\u7406\u5f15\u64ce\u5bf9\u4e8eBuildNow GG\u7684\u9ad8\u7ea7\u5efa\u9020\u81f3\u5173\u91cd\u8981\uff1f", "answer": "BuildNow GG\u7684\u7269\u7406\u5f15\u64ce\u51b3\u5b9a\u4e86\u7ed3\u6784\u5728\u5404\u79cd\u6761\u4ef6\u4e0b\u7684\u884c\u4e3a\u3002\u4f8b\u5982\uff0c\u5728\u6ca1\u6709\u9002\u5f53\u652f\u6491\u7684\u60c5\u51b5\u4e0b\u5efa\u9020\u9ad8\u5854\u53ef\u80fd\u4f1a\u5bfc\u81f4\u5012\u584c\u3002\u7406\u89e3\u8fd9\u4e9b\u673a\u5236\u5141\u8bb8\u73a9\u5bb6\u521b\u5efa\u66f4\u590d\u6742\u548c\u7a33\u5b9a\u7684\u7ed3\u6784\u3002\u4f7f\u7528\u201c\u652f\u6491\u6881\u201d\u7269\u54c1\u6765\u52a0\u5f3a\u5efa\u7b51\u7269\u5e76\u9632\u6b62\u7ed3\u6784\u7834\u574f\u3002[\u6d41\u7a0b\u56fe\u89e3: \u53ef\u89c6\u5316\u7ed3\u6784\u7684\u53d7\u529b\u70b9\uff0c\u4ee5\u786e\u5b9a\u9700\u8981\u52a0\u56fa\u7684\u4f4d\u7f6e\u3002]"}, {"question": "BuildNow GG\u4e2d\u54ea\u4e9b\u6e38\u620f\u4e8b\u4ef6\u4e3a\u6210\u5c31\u730e\u4eba\u5728\u6e38\u620f\u4e2d\u63d0\u4f9b\u4e86\u6700\u4f73\u5956\u52b1\uff1f", "answer": "\u50cf\u201c\u51ac\u5b63\u8282\u65e5\u201d\u548c\u201c\u4e30\u6536\u6708\u201d\u8fd9\u6837\u7684\u5b63\u8282\u6027\u6d3b\u52a8\u63d0\u4f9b\u72ec\u5bb6\u5956\u52b1\uff0c\u4f8b\u5982\u7a00\u6709\u76ae\u80a4\u548c\u56fe\u7eb8\u3002\u4f8b\u5982\uff0c\u5b8c\u6210\u6240\u6709\u51ac\u5b63\u8282\u65e5\u6311\u6218\u5373\u53ef\u83b7\u5f97\u201c\u96ea\u82b1\u5efa\u7b51\u5e08\u201d\u79f0\u53f7\u3002\u8fd9\u4e9b\u6d3b\u52a8\u65f6\u95f4\u6709\u9650\uff0c\u56e0\u6b64\u63d0\u524d\u89c4\u5212\u5e76\u79ef\u6781\u53c2\u4e0e\u662f\u6700\u5927\u5316\u5956\u52b1\u7684\u5173\u952e\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u6bd4\u8f83\u4e0d\u540c\u4e8b\u4ef6\u7684\u5956\u52b1\uff0c\u4ee5\u4fbf\u6839\u636e\u4f60\u7684\u76ee\u6807\u4f18\u5148\u53c2\u4e0e\u3002]"}, {"question": "\u591a\u4eba\u6a21\u5f0f\u5982\u4f55\u589e\u5f3aBuildNow GG\u65b0\u73a9\u5bb6\u7684\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u591a\u4eba\u6a21\u5f0f\u5141\u8bb8\u65b0\u73a9\u5bb6\u5408\u4f5c\u5b8c\u6210\u5927\u578b\u9879\u76ee\u5e76\u5411\u7ecf\u9a8c\u4e30\u5bcc\u7684\u5efa\u9020\u8005\u5b66\u4e60\u3002\u4f8b\u5982\uff0c\u52a0\u5165\u793e\u533a\u670d\u52a1\u5668\u53ef\u4ee5\u83b7\u5f97\u9884\u5148\u5efa\u9020\u7684\u7ed3\u6784\u548c\u5171\u4eab\u8d44\u6e90\uff0c\u8fd9\u4f7f\u5f97\u4e0a\u624b\u66f4\u5bb9\u6613\u3002\u793e\u4ea4\u65b9\u9762\u4e5f\u589e\u52a0\u4e86\u4e50\u8da3\u548c\u52a8\u529b\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u591a\u4eba\u6a21\u5f0f\u89c6\u4e3a\u4e00\u4e2a\u534f\u4f5c\u7684\u5de5\u623f\uff0c\u6bcf\u4e2a\u4eba\u90fd\u8d21\u732e\u4e8e\u5171\u540c\u7684\u613f\u666f\u3002]"}, {"question": "\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u7684\u7ecf\u6d4e\u4f53\u7cfb\u5728BuildNow GG\u4e2d\u6709\u4ec0\u4e48\u4e3b\u8981\u533a\u522b\uff1f", "answer": "\u5728\u5355\u4eba\u6a21\u5f0f\u4e2d\uff0c\u7ecf\u6d4e\u4f53\u7cfb\u662f\u72ec\u7acb\u7684\uff0c\u8d44\u6e90\u7531\u73a9\u5bb6\u5355\u72ec\u751f\u6210\u548c\u6d88\u8017\u3002\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u8d44\u6e90\u53ef\u4ee5\u8fdb\u884c\u4ea4\u6613\u548c\u5171\u4eab\uff0c\u4ece\u800c\u521b\u9020\u4e00\u4e2a\u52a8\u6001\u7684\u5e02\u573a\u3002\u4f8b\u5982\uff0c\u5728\u4e00\u4e2a\u751f\u7269\u7fa4\u843d\u4e2d\u53d1\u73b0\u7684\u7a00\u6709\u6750\u6599\u53ef\u4ee5\u4e0e\u53e6\u4e00\u4e2a\u751f\u7269\u7fa4\u843d\u4e2d\u7684\u4e0d\u540c\u8d44\u6e90\u8fdb\u884c\u4ea4\u6613\u3002\u8fd9\u79cd\u76f8\u4e92\u4f9d\u8d56\u6027\u4fc3\u8fdb\u4e86\u5408\u4f5c\u7684\u6e38\u620f\u73af\u5883\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u6bd4\u8f83\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u4e2d\u8d44\u6e90\u7684\u53ef\u7528\u6027\u548c\u4ea4\u6613\u4ef7\u503c\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5c06BuildNow GG\u5728PC\u4e0a\u7684\u8fdb\u5ea6\u8fc1\u79fb\u5230\u4e3b\u673a\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u5c06\u6e38\u620f\u8d26\u6237\u94fe\u63a5\u5230\u901a\u7528\u7684BuildNow GG ID\u6765\u8fc1\u79fb\u8fdb\u5ea6\u3002\u6b65\u9aa4\u4e00\uff1a\u767b\u5f55PC\u7248\u672c\u7684\u8d26\u6237\u5e76\u5bfc\u822a\u5230\u201c\u8d26\u6237\u8bbe\u7f6e\u201d\u83dc\u5355\u3002\u6b65\u9aa4\u4e8c\uff1a\u751f\u6210\u8fc1\u79fb\u4ee3\u7801\u3002\u6b65\u9aa4\u4e09\uff1a\u5728\u4e3b\u673a\u7248\u672c\u4e0a\u8f93\u5165\u6b64\u4ee3\u7801\u4ee5\u540c\u6b65\u60a8\u7684\u6570\u636e\u3002\u6b64\u8fc7\u7a0b\u786e\u4fdd\u60a8\u5728\u6240\u6709\u5e73\u53f0\u4e0a\u90fd\u80fd\u4fdd\u7559\u6240\u6709\u5efa\u7b51\u548c\u6210\u5c31\u3002[\u6d41\u7a0b\u56fe\u89e3: \u9010\u6b65\u53ef\u89c6\u5316\u8fc1\u79fb\u8fc7\u7a0b\uff0c\u4ee5\u786e\u4fdd\u5e73\u7a33\u8fc7\u6e21\u3002]"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728BuildNow GG\u4e2d\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "BuildNow GG\u4e2d\u5145\u6ee1\u4e86\u9690\u85cf\u529f\u80fd\uff0c\u4f8b\u5982\u901a\u8fc7\u63a2\u7d22\u504f\u8fdc\u5730\u533a\u53ef\u4ee5\u89e3\u9501\u7684\u79d8\u5bc6\u56fe\u7eb8\u3002\u4f8b\u5982\uff0c\u5728\u6c99\u6f20\u751f\u7269\u7fa4\u843d\u4e2d\u627e\u5230\u201c\u5931\u843d\u7684\u5bfa\u5e99\u201d\u5373\u53ef\u83b7\u5f97\u72ec\u7279\u7684\u5efa\u7b51\u98ce\u683c\u3002\u8fd9\u4e9b\u53d1\u73b0\u589e\u52a0\u4e86\u60ca\u559c\u548c\u63a2\u7d22\u7684\u5956\u52b1\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u8fd9\u4e9b\u9690\u85cf\u529f\u80fd\u89c6\u4e3a\u7b49\u5f85\u5728BuildNow GG\u5e7f\u9614\u4e16\u754c\u4e2d\u88ab\u53d1\u73b0\u7684\u5b9d\u7bb1\u3002]"}, {"question": "BuildNow GG\u4e2d\u7684\u4e0d\u540c\u751f\u7269\u7fa4\u843d\u5982\u4f55\u5f71\u54cd\u5efa\u7b51\u7b56\u7565\uff1f", "answer": "BuildNow GG\u4e2d\u7684\u6bcf\u4e2a\u751f\u7269\u7fa4\u843d\u90fd\u63d0\u4f9b\u72ec\u7279\u8d44\u6e90\u548c\u6311\u6218\u3002\u4f8b\u5982\uff0c\u68ee\u6797\u751f\u7269\u7fa4\u843d\u5bcc\u542b\u6728\u6750\uff0c\u4f46\u77f3\u6750\u6709\u9650\uff0c\u800c\u5c71\u5730\u751f\u7269\u7fa4\u843d\u5219\u8574\u85cf\u7740\u4e30\u5bcc\u7684\u77ff\u7269\uff0c\u4f46\u96be\u4ee5\u901a\u884c\u3002\u6839\u636e\u8fd9\u4e9b\u6761\u4ef6\u8c03\u6574\u5efa\u7b51\u7b56\u7565\u81f3\u5173\u91cd\u8981\u3002\u4f7f\u7528\u201c\u5730\u5f62\u626b\u63cf\u4eea\u201d\u8bc4\u4f30\u8d44\u6e90\u53ef\u7528\u6027\uff0c\u7136\u540e\u518d\u5f00\u59cb\u9879\u76ee\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u6bd4\u8f83\u5728\u4e0d\u540c\u751f\u7269\u7fa4\u843d\u4e2d\u5efa\u9020\u7684\u4f18\u7f3a\u70b9\uff0c\u4ee5\u4f18\u5316\u4f60\u7684\u7b56\u7565\u3002]"}, {"question": "\u5982\u4f55\u6700\u597d\u5730\u5229\u7528BuildNow GG\u4e2d\u9ad8\u7ea7\u7684\u5236\u4f5c\u7cfb\u7edf\uff1f", "answer": "\u9ad8\u7ea7\u5236\u4f5c\u7cfb\u7edf\u5141\u8bb8\u73a9\u5bb6\u521b\u5efa\u590d\u6742\u7269\u54c1\u548c\u673a\u68b0\u3002\u6b65\u9aa4\u4e00\uff1a\u6536\u96c6\u7a00\u6709\u6750\u6599\uff0c\u5982\u949b\u548c\u9ed1\u66dc\u77f3\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u201c\u5236\u4f5c\u53f0Mk.II\u201d\u89e3\u9501\u66f4\u9ad8\u7b49\u7ea7\u7684\u914d\u65b9\u3002\u6b65\u9aa4\u4e09\uff1a\u5c06\u6750\u6599\u7ec4\u5408\u8d77\u6765\u5236\u4f5c\u5f3a\u5927\u7684\u5de5\u5177\u548c\u8bbe\u5907\uff0c\u4f8b\u5982\u201c\u91cf\u5b50\u53d1\u751f\u5668\u201d\uff0c\u5b83\u63d0\u4f9b\u65e0\u9650\u80fd\u91cf\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u6bd4\u8f83\u4e0d\u540c\u9ad8\u7ea7\u5236\u4f5c\u7269\u54c1\u7684\u597d\u5904\uff0c\u4ee5\u786e\u5b9a\u6700\u9002\u5408\u4f60\u7684\u6e38\u620f\u98ce\u683c\u7684\u7269\u54c1\u3002]"}]
[{"question": "BuildNow GG\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \ubc30\uc6b0\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub294 \uac8c\uc784 \ub0b4 \ud29c\ud1a0\ub9ac\uc5bc\uc744 \uc644\ub8cc\ud558\uc5ec \uc2dc\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \ud29c\ud1a0\ub9ac\uc5bc\uc740 \uc774\ub3d9, \uac74\uc124, \uadf8\ub9ac\uace0 \ubb3c\uccb4\uc640\uc758 \uc0c1\ud638 \uc791\uc6a9\uacfc \uac19\uc740 \ud544\uc218 \ucee8\ud2b8\ub864\uc744 \ub2e4\ub8f9\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uae30\ubcf8 \uad6c\uc870\ub97c \uc9d3\uae30 \uc704\ud574\uc11c\ub294 'B' \ud0a4\ub97c \ub20c\ub7ec \uac74\uc124 \uba54\ub274\ub97c \uc5f4\uace0 \uc6d0\ud558\ub294 \ube14\ub85d\uc744 \uc120\ud0dd\ud558\uace0 \uc67c\ucabd \ud074\ub9ad\uc73c\ub85c \ubc30\uce58\ud558\uba74 \ub429\ub2c8\ub2e4. \ub610\ud55c, \ucee8\ud2b8\ub864 \uc124\uc815 \uba54\ub274\ub97c \ud1b5\ud574 \uac1c\uc778\uc801\uc778 \uc120\ud638\ub3c4\uc5d0 \ub9de\ucdb0 \ud0a4 \ubc14\uc778\ub529\uc744 \uc0ac\uc6a9\uc790 \uc815\uc758\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud29c\ud1a0\ub9ac\uc5bc\uc740 BuildNow GG \uc5ec\uc815\uc758 \ucd08\uae30 \ub2e8\uacc4\ub97c \uc548\ub0b4\ud558\ub294 \uc9c0\ub3c4\uc640 \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\uac8c\uc784 \ud50c\ub808\uc774 100\uc2dc\uac04 \ud6c4 BuildNow GG\uc5d0\uc11c \uc790\uc6d0 \uad00\ub9ac\ub97c \uc704\ud55c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "100\uc2dc\uac04\uc774 \uc9c0\ub09c \ud6c4\uc5d0\ub294 \ud50c\ub808\uc774\uc5b4\ub294 \uc790\uc6d0 \uc218\uc9d1 \ubc0f \ud65c\uc6a9\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ub370 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. STEP1: \ub2e4\uc591\ud55c \uc0dd\ud0dc\uacc4\uc5d0 \uc5ec\ub7ec \uc790\uc6d0 \uac70\uc810\uc744 \uc124\ub9bd\ud558\uc5ec \uc548\uc815\uc801\uc778 \uacf5\uae09\uc744 \ud655\ubcf4\ud569\ub2c8\ub2e4. STEP2: \uc790\ub3d9 \uc218\uc9d1\uae30\uc640 \uac19\uc740 \uace0\uae09 \ub3c4\uad6c\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud6a8\uc728\uc131\uc744 \uadf9\ub300\ud654\ud569\ub2c8\ub2e4. STEP3: \uac00\uc7a5 \ub192\uc740 \uc790\uc6d0 \ub300 \ud6a8\uc728 \ube44\uc728\uc744 \uc81c\uacf5\ud558\ub294 \uace0\uae09 \uc544\uc774\ud15c \uc81c\uc791\uc5d0 \uc6b0\uc120\uc21c\uc704\ub97c \ub461\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucd08\uae30\uc5d0 \ub2e4\uc774\uc544\ubaac\ub4dc \uace1\uad2d\uc774\ub97c \uc81c\uc791\ud558\uba74 \uad11\ubb3c \ucc44\uad74 \uc791\uc5c5\uc744 \ud06c\uac8c \uac00\uc18d\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ub300\uc870\ud45c: \uc11c\ub85c \ub2e4\ub978 \ub3c4\uad6c\uc758 \uc790\uc6d0 \uc218\ud655\ub7c9\uc744 \ube44\uad50\ud558\uc5ec \uac00\uc7a5 \ud6a8\uc728\uc801\uc778 \uc635\uc158\uc744 \ud30c\uc545\ud558\uc2ed\uc2dc\uc624.]"}, {"question": "BuildNow GG\uc5d0\uc11c \uace0\uae09 \uac74\uc124\uc5d0 \ud544\uc218\uc801\uc778 \uac8c\uc784 \ubb3c\ub9ac \uc5d4\uc9c4 \uc774\ud574\uc758 \uc911\uc694\uc131\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "BuildNow GG\uc758 \ubb3c\ub9ac \uc5d4\uc9c4\uc740 \ub2e4\uc591\ud55c \uc870\uac74 \ud558\uc5d0\uc11c \uad6c\uc870\ubb3c\uc774 \uc5b4\ub5bb\uac8c \uc791\uc6a9\ud558\ub294\uc9c0 \uacb0\uc815\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc801\uc808\ud55c \uc9c0\uc9c0 \uc5c6\uc774 \ub192\uc740 \ud0d1\uc744 \uac74\uc124\ud558\uba74 \ubb34\ub108\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\uba74 \ud50c\ub808\uc774\uc5b4\ub294 \ub354 \ubcf5\uc7a1\ud558\uace0 \uc548\uc815\uc801\uc778 \uad6c\uc870\ubb3c\uc744 \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac74\ubb3c\uc744 \uac15\ud654\ud558\uace0 \uad6c\uc870\uc801 \uacb0\ud568\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud574 '\uc9c0\uc9c0\ub300' \uc544\uc774\ud15c\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. [\ud750\ub984\ub3c4: \uad6c\uc870\ubb3c\uc758 \uc751\ub825 \uc9c0\uc810\uc744 \uc2dc\uac01\ud654\ud558\uc5ec \ubcf4\uac15\uc774 \ud544\uc694\ud55c \uc704\uce58\ub97c \uc2dd\ubcc4\ud558\uc2ed\uc2dc\uc624.]"}, {"question": "BuildNow GG\uc5d0\uc11c \uc131\ucde8 \ud5cc\ud130\ub97c \uc704\ud55c \ucd5c\uace0\uc758 \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud558\ub294 \uac8c\uc784 \ub0b4 \uc774\ubca4\ud2b8\ub294 \uc5b4\ub5a4 \uac83\uc778\uac00\uc694?", "answer": "'\uaca8\uc6b8 \ucd95\uc81c'\uc640 '\ucd94\uc218 \uac10\uc0ac\uc808'\uacfc \uac19\uc740 \uacc4\uc808 \uc774\ubca4\ud2b8\ub294 \ud76c\uadc0 \uc2a4\ud0a8\uacfc \uc124\uacc4\ub3c4\uc640 \uac19\uc740 \ub3c5\uc810 \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubaa8\ub4e0 \uaca8\uc6b8 \ucd95\uc81c \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\uba74 '\ub208\uc1a1\uc774 \uac74\ucd95\uac00'\ub77c\ub294 \ud0c0\uc774\ud2c0\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc774\ubca4\ud2b8\ub294 \uc2dc\uac04 \uc81c\ud55c\uc774 \uc788\uc73c\ubbc0\ub85c \ubbf8\ub9ac \uacc4\ud68d\ud558\uace0 \uc801\uadf9\uc801\uc73c\ub85c \ucc38\uc5ec\ud558\ub294 \uac83\uc774 \ubcf4\uc0c1\uc744 \uadf9\ub300\ud654\ud558\ub294 \ub370 \uc911\uc694\ud569\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc635\uc158 \ube44\uad50: \ubaa9\ud45c\uc5d0 \ub530\ub77c \ucc38\uc5ec \uc6b0\uc120\uc21c\uc704\ub97c \uc815\ud558\uae30 \uc704\ud574 \uc11c\ub85c \ub2e4\ub978 \uc774\ubca4\ud2b8\uc758 \ubcf4\uc0c1\uc744 \ube44\uad50\ud558\uc2ed\uc2dc\uc624.]"}, {"question": "BuildNow GG\uc758 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uc758 \uac8c\uc784 \uacbd\ud5d8\uc744 \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0a4\ub098\uc694?", "answer": "\uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \ub300\uaddc\ubaa8 \ud504\ub85c\uc81d\ud2b8\ub97c \ud611\ub825\ud558\uc5ec \uc9c4\ud589\ud558\uace0 \uc219\ub828\ub41c \uac74\ucd95\uac00\ub85c\ubd80\ud130 \ubc30\uc6b0\ub3c4\ub85d \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucee4\ubba4\ub2c8\ud2f0 \uc11c\ubc84\uc5d0 \ucc38\uc5ec\ud558\uba74 \uc0ac\uc804 \uc81c\uc791\ub41c \uad6c\uc870\ubb3c\uacfc \uacf5\uc720 \uc790\uc6d0\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\uc73c\ubbc0\ub85c \uc2dc\uc791\ud558\uae30\uac00 \ub354 \uc26c\uc6cc\uc9d1\ub2c8\ub2e4. \ub610\ud55c, \uc0ac\ud68c\uc801 \uce21\uba74\uc740 \uc990\uac70\uc6c0\uacfc \ub3d9\uae30\ub97c \ub354\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \ubaa8\ub450\uac00 \uacf5\uc720 \ube44\uc804\uc5d0 \uae30\uc5ec\ud558\ub294 \ud611\uc5c5 \uc6cc\ud06c\uc20d\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "BuildNow GG\uc758 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4\uc640 \uba40\ud2f0 \ud50c\ub808\uc774\uc5b4 \uacbd\uc81c\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc2f1\uae00 \ud50c\ub808\uc774\uc5b4\uc5d0\uc11c\ub294 \uacbd\uc81c\uac00 \uc790\uccb4\uc801\uc73c\ub85c \uc644\uacb0\ub418\uc5b4 \uc788\uc73c\uba70 \uc790\uc6d0\uc740 \ud50c\ub808\uc774\uc5b4 \ud63c\uc790 \uc0dd\uc131\ub418\uace0 \uc18c\ube44\ub429\ub2c8\ub2e4. \uba40\ud2f0 \ud50c\ub808\uc774\uc5b4\uc5d0\uc11c\ub294 \uc790\uc6d0\uc744 \uc11c\ub85c \uac70\ub798\ud558\uace0 \uacf5\uc720\ud560 \uc218 \uc788\uc73c\ubbc0\ub85c \uc5ed\ub3d9\uc801\uc778 \uc2dc\uc7a5\uc774 \ud615\uc131\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud2b9\uc815 \uc0dd\ud0dc\uacc4\uc5d0\uc11c \ubc1c\uacac\ub418\ub294 \ud76c\uadc0\ud55c \uc7ac\ub8cc\ub97c \ub2e4\ub978 \uc0dd\ud0dc\uacc4\uc758 \uc790\uc6d0\uacfc \uad50\ud658\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc0c1\ud638 \uc758\uc874\uc131\uc740 \ud611\ub825\uc801\uc778 \uac8c\uc784 \ud658\uacbd\uc744 \uc870\uc131\ud569\ub2c8\ub2e4. [\uc124\uc815 \ub300\uc870\ud45c: \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ub300 \uba40\ud2f0 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c \uc790\uc6d0 \uac00\uc6a9\uc131 \ubc0f \uac70\ub798 \uac00\uce58\ub97c \ube44\uad50\ud558\uc2ed\uc2dc\uc624.]"}, {"question": "\ud50c\ub808\uc774\uc5b4\uac00 PC\uc5d0\uc11c \ucf58\uc194\ub85c BuildNow GG\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud50c\ub808\uc774\uc5b4\ub294 \uac8c\uc784 \uacc4\uc815\uc744 \ubcf4\ud3b8\uc801\uc778 BuildNow GG ID\uc640 \uc5f0\uacb0\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: PC \ubc84\uc804\uc5d0\uc11c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uace0 '\uacc4\uc815 \uc124\uc815' \uba54\ub274\ub85c \uc774\ub3d9\ud558\uc138\uc694. STEP2: \ub9c8\uc774\uadf8\ub808\uc774\uc158 \ucf54\ub4dc\ub97c \uc0dd\uc131\ud569\ub2c8\ub2e4. STEP3: \uc774 \ucf54\ub4dc\ub97c \ucf58\uc194 \ubc84\uc804\uc5d0 \uc785\ub825\ud558\uc5ec \ub370\uc774\ud130\ub97c \ub3d9\uae30\ud654\ud569\ub2c8\ub2e4. \uc774 \uacfc\uc815\uc744 \ud1b5\ud574 \ubaa8\ub4e0 \uac74\uc124\ubb3c\uacfc \uc5c5\uc801\uc774 \ubaa8\ub4e0 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ubcf4\uc874\ub429\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc6d0\ud65c\ud55c \uc804\ud658\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 \ub9c8\uc774\uadf8\ub808\uc774\uc158 \uacfc\uc815\uc744 \ub2e8\uacc4\ubcc4\ub85c \uc2dc\uac01\ud654\ud558\uc138\uc694.]"}, {"question": "BuildNow GG\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\ub098\uc694?", "answer": "BuildNow GG\uc5d0\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774 \ub9ce\uc2b5\ub2c8\ub2e4. \uba3c\uc9c0 \ud0d0\ud5d8\uc744 \ud1b5\ud574 \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\ub294 \ube44\ubc00 \uc124\uacc4\ub3c4\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc0ac\ub9c9 \uc0dd\ud0dc\uacc4\uc758 '\uc783\uc5b4\ubc84\ub9b0 \uc0ac\uc6d0'\uc744 \ucc3e\uc73c\uba74 \ub3c5\ud2b9\ud55c \uac74\ucd95 \uc591\uc2dd\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ubc1c\uacac\uc740 \ub180\ub77c\uc6c0\uacfc \ud0d0\ud5d8\uc5d0 \ub300\ud55c \ubcf4\uc0c1\uc744 \ub354\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uae30\ub2a5\uc740 BuildNow GG\uc758 \uad11\ud65c\ud55c \uc138\uacc4\uc5d0\uc11c \ubc1c\uacac\ub420 \ubcf4\ubb3c \uc0c1\uc790\uc640 \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "BuildNow GG\uc758 \uc11c\ub85c \ub2e4\ub978 \uc0dd\ud0dc\uacc4\ub294 \uac74\uc124 \uc804\ub7b5\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "BuildNow GG\uc758 \uac01 \uc0dd\ud0dc\uacc4\ub294 \uace0\uc720\ud55c \uc790\uc6d0\uacfc \uc5b4\ub824\uc6c0\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc232 \uc0dd\ud0dc\uacc4\ub294 \ub098\ubb34\uac00 \ud48d\ubd80\ud558\uc9c0\ub9cc \ub3cc\uc774 \uc81c\ud55c\ub418\uc5b4 \uc788\uc73c\uba70, \uc0b0 \uc0dd\ud0dc\uacc4\ub294 \ud48d\ubd80\ud55c \uad11\ubb3c\uc744 \uc81c\uacf5\ud558\uc9c0\ub9cc \uc774\ub3d9\uc774 \uc5b4\ub835\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc870\uac74\uc5d0 \ub9de\uac8c \uac74\uc124 \uc804\ub7b5\uc744 \uc801\uc751\uc2dc\ud0a4\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \ud504\ub85c\uc81d\ud2b8\ub97c \uc2dc\uc791\ud558\uae30 \uc804\uc5d0 '\uc9c0\ud615 \uc2a4\uce90\ub108'\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc790\uc6d0 \uac00\uc6a9\uc131\uc744 \ud3c9\uac00\ud558\uc2ed\uc2dc\uc624. [\ub2e4\uc591\ud55c \uc635\uc158 \ube44\uad50: \uc804\ub7b5\uc744 \ucd5c\uc801\ud654\ud558\uae30 \uc704\ud574 \uc11c\ub85c \ub2e4\ub978 \uc0dd\ud0dc\uacc4\uc5d0\uc11c \uac74\uc124\uc758 \uc7a5\ub2e8\uc810\uc744 \ube44\uad50\ud558\uc138\uc694.]"}, {"question": "BuildNow GG\uc758 \uace0\uae09 \uc81c\uc791 \uc2dc\uc2a4\ud15c\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\ub294 \ucd5c\uc120\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uace0\uae09 \uc81c\uc791 \uc2dc\uc2a4\ud15c\uc744 \ud1b5\ud574 \ud50c\ub808\uc774\uc5b4\ub294 \ubcf5\uc7a1\ud55c \uc544\uc774\ud15c\uacfc \uae30\uacc4\ub97c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \ud2f0\ud0c0\ub284\uacfc \ud751\uc694\uc11d\uacfc \uac19\uc740 \ud76c\uadc0 \uc790\uc6d0\uc744 \uc218\uc9d1\ud569\ub2c8\ub2e4. STEP2: '\uc81c\uc791\ub300 Mk.II'\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub354 \ub192\uc740 \ub808\ubca8\uc758 \ub808\uc2dc\ud53c\ub97c \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4. STEP3: \uc790\uc6d0\uc744 \uacb0\ud569\ud558\uc5ec '\uc591\uc790 \ubc1c\uc804\uae30'\uc640 \uac19\uc774 \ubb34\uc81c\ud55c \uc5d0\ub108\uc9c0\ub97c \uc81c\uacf5\ud558\ub294 \uac15\ub825\ud55c \ub3c4\uad6c\uc640 \uc7a5\uce58\ub97c \uc81c\uc791\ud569\ub2c8\ub2e4. [\uc124\uc815 \ub300\uc870\ud45c: \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \uac00\uc7a5 \uc720\uc6a9\ud55c \uace0\uae09 \uc81c\uc791 \uc544\uc774\ud15c\uc758 \uc774\uc810\uc744 \ube44\uad50\ud558\uc2ed\uc2dc\uc624.]"}]
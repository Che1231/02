[{"question": "Swingo\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ucd08\ubcf4\uc790\uac00 \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Swingo\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc2dc\uc791\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. STEP1 - \ub2e4\uc591\ud55c \uac8c\uc784 \ubaa8\ub4dc\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\ub294 \uba54\uc778 \uba54\ub274\ub97c \uc775\uc219\ud574\uc9c0\uc138\uc694. STEP2 - \uc67c\ucabd, \uc624\ub978\ucabd, \uc704, \uc544\ub798\ub85c \uc2a4\uc640\uc774\ud504\ud558\ub294 \uac83\uc744 \ud3ec\ud568\ud55c \ud29c\ud1a0\ub9ac\uc5bc \ubaa8\ub4dc\uc5d0\uc11c \uae30\ubcf8 \uc774\ub3d9 \ucee8\ud2b8\ub864\uc744 \uc5f0\uc2b5\ud558\uc138\uc694. STEP3 - \ubc30\uc6b4 \ub0b4\uc6a9\uc744 \uc2e4\uc81c \uac8c\uc784 \uc0c1\ud669\uc5d0 \uc801\uc6a9\ud558\uae30 \uc704\ud574 '\ube60\ub978 \ub9e4\uce58' \ubaa8\ub4dc\ub97c \uc2dc\ub3c4\ud574 \ubcf4\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\ube60\ub978 \ub9e4\uce58'\uc5d0\uc11c \uc0c9\uc0c1\uacfc \ubaa8\uc591\uc744 \ub9e4\uce58\ud558\uae30 \uc704\ud574 \ube60\ub974\uac8c \uc2a4\uc640\uc774\ud504\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774 \ub2e8\uacc4\ubcc4 \uc811\uadfc \ubc29\uc2dd\uc740 \ucd08\ubcf4\uc790\ub97c \uc704\ud55c \uc6d0\ud65c\ud55c \ud559\uc2b5 \uace1\uc120\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "Swingo\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uac8c\uc784\uc5d0\uc11c \ubc1c\uc804\ud558\ub294 \ub370 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Swingo\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \uc9c4\ud589 \uc0c1\ud669\uacfc \uc21c\uc704\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc18d\ub3c4, \uc815\ud655\uc131 \ubc0f \ucf64\ubcf4 \ubc30\uc218\uc758 \uc870\ud569\uc744 \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5f0\uc18d\uc73c\ub85c 3\uac1c\uc758 \ubaa8\uc591\uc744 \ube60\ub974\uac8c \ub9e4\uce58\ud558\uba74 \ucf64\ubcf4 \ubc30\uc218\uac00 \uc801\uc6a9\ub418\uc5b4 \uc810\uc218\uac00 \ud06c\uac8c \uc0c1\uc2b9\ud569\ub2c8\ub2e4. \uc810\uc218\ub97c \uadf9\ub300\ud654\ud558\ub824\uba74 \ub354 \uae34 \ucf64\ubcf4\ub97c \ub9cc\ub4dc\ub294 \ub370 \uc9d1\uc911\ud558\uace0 \uc815\ud655\uc131\uc744 \uc720\uc9c0\ud558\uc138\uc694. \uc774 \uc9c0\uc2dd\uc740 \uc804\ub7b5\uc744 \ub354 \uc798 \uc138\uc6b0\uace0 \ub9ac\ub354\ubcf4\ub4dc\ub97c \ub354 \ube60\ub974\uac8c \uc624\ub974\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "Swingo\uc758 \uace0\uae09 \uc804\ub7b5\uc744 \uc219\ub2ec\ud558\uae30 \uc704\ud55c \ud544\uc218 \ud301\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Swingo\uc758 \uace0\uae09 \uc804\ub7b5\uc744 \uc219\ub2ec\ud558\ub824\uba74 \ub2e4\uc74c\uacfc \uac19\uc740 \uba87 \uac00\uc9c0 \uc8fc\uc694 \ud301\uc774 \uc788\uc2b5\ub2c8\ub2e4. STEP1 - \ud328\ud134\uc744 \uad00\ucc30\ud558\uc5ec \ub2e4\uc74c \ubaa8\uc591 \uc138\ud2b8\ub97c \uc608\uce21\ud558\ub294 \ubc95\uc744 \ubc30\uc6b0\uc138\uc694. STEP2 - \ud2b9\uc815 \uc0c9\uc0c1\uc758 \ubaa8\ub4e0 \ubaa8\uc591\uc744 \uc81c\uac70\ud558\ub294 '\uceec\ub7ec \ud3ed\ud0c4'\uacfc \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\uc138\uc694. STEP3 - \ub354 \ub192\uc740 \uc555\ubc15\uac10 \uc544\ub798\uc5d0\uc11c \uae30\uc220\uc744 \uc5f0\ub9c8\ud558\uae30 \uc704\ud574 '\uc804\ubb38\uac00 \ubaa8\ub4dc'\uc5d0\uc11c \uc5f0\uc2b5\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uc804\ubb38\uac00 \ubaa8\ub4dc'\uc5d0\uc11c\ub294 \ubc18\uc751 \uc2dc\uac04\uc774 \ub354 \ube60\ub978 \ube60\ub978 \ubaa8\uc591 \uc2dc\ud000\uc2a4\ub97c \ub9cc\ub098\uac8c \ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ub2e8\uacc4\ub294 \ucd08\ubcf4 \ud50c\ub808\uc774\uc5b4\ub97c \uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\ub85c \ud6a8\uacfc\uc801\uc73c\ub85c \uc804\ud658\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4."}, {"question": "\uc5b4\ub5a4 Swingo \uac8c\uc784 \ubaa8\ub4dc\uac00 \ubc18\uc751 \uc2dc\uac04 \ud5a5\uc0c1\uc744 \uc704\ud55c \ucd5c\uc0c1\uc758 \uc5f0\uc2b5\uc744 \uc81c\uacf5\ud569\ub2c8\uae4c?", "answer": "Swingo\uc5d0\uc11c \ubc18\uc751 \uc2dc\uac04\uc744 \uac1c\uc120\ud558\ub824\uba74 \ub2e4\uc74c \uac8c\uc784 \ubaa8\ub4dc\uc5d0 \uc9d1\uc911\ud558\uc138\uc694. '\uc2dc\uac04 \uacf5\uaca9'\uacfc '\ube14\ub9ac\uce20 \ubaa8\ub4dc'. '\uc2dc\uac04 \uacf5\uaca9'\uc740 \uc124\uc815\ub41c \uc2dc\uac04 \ub0b4\uc5d0 \uac00\ub2a5\ud55c \ud55c \ub9ce\uc740 \ub9e4\uce58\ub97c \uc644\ub8cc\ud558\ub3c4\ub85d \ub3c4\uc804\ud558\uc5ec \uc2e0\uc18d\ud55c \uc758\uc0ac \uacb0\uc815\uc744 \uc694\uad6c\ud569\ub2c8\ub2e4. '\ube14\ub9ac\uce20 \ubaa8\ub4dc'\ub294 \ubaa8\uc591 \uc2dc\ud000\uc2a4\uc758 \uc18d\ub3c4\ub97c \uc810\uc9c4\uc801\uc73c\ub85c \ub192\uc5ec \ubc18\uc751 \ud55c\uacc4\ub97c \ub113\ud799\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ube14\ub9ac\uce20 \ubaa8\ub4dc'\uc5d0\uc11c \ub290\ub9b0 \uc2dc\ud000\uc2a4\ub85c \uc2dc\uc791\ud558\uc9c0\ub9cc \ub808\ubca8 5\uac00 \ub418\uba74 \uc18d\ub3c4\uac00 \ud06c\uac8c \ube68\ub77c\uc9d1\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ubaa8\ub4dc\ub294 \ubc18\uc0ac \uc2e0\uacbd\uacfc \uc18d\ub3c4\ub97c \uc5f0\ub9c8\ud558\ub294 \ub370 \ud0c1\uc6d4\ud569\ub2c8\ub2e4."}, {"question": "Swingo\uc758 \uc54c\uace0\ub9ac\uc998\uc740 \ubaa8\uc591 \uc2dc\ud000\uc2a4\uc758 \ub09c\uc774\ub3c4\ub97c \uc5b4\ub5bb\uac8c \uacb0\uc815\ud569\ub2c8\uae4c?", "answer": "Swingo\uc758 \uc54c\uace0\ub9ac\uc998\uc740 \ud50c\ub808\uc774\uc5b4\uc758 \uae30\uc220 \uc218\uc900, \ud604\uc7ac \uc810\uc218 \ubc0f \uac8c\uc784 \ubaa8\ub4dc\uc640 \uac19\uc740 \uc5ec\ub7ec \uc694\uc18c\ub97c \uae30\ubc18\uc73c\ub85c \ubaa8\uc591 \uc2dc\ud000\uc2a4\uc758 \ub09c\uc774\ub3c4\ub97c \uacb0\uc815\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud504\ub85c\uadf8\ub808\uc2dc\ube0c \ubaa8\ub4dc'\uc5d0\uc11c \uc810\uc218\uac00 \uc0c1\uc2b9\ud568\uc5d0 \ub530\ub77c \uc54c\uace0\ub9ac\uc998\uc740 \ubaa8\uc591\uacfc \uc18d\ub3c4\uc758 \ubcf5\uc7a1\uc131\uc744 \ub192\uc785\ub2c8\ub2e4. \uc2dc\uc2a4\ud15c\uc740 \ub610\ud55c \uc131\uacfc\uc5d0 \ub530\ub77c \uc801\uc751\ud558\uc5ec \uade0\ud615 \uc7a1\ud78c \ub3c4\uc804\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4. \uc774 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\uba74 \ub354 \uc5b4\ub824\uc6b4 \uc2dc\ud000\uc2a4\ub97c \uc608\uce21\ud558\uace0 \uc900\ube44\ud558\uc5ec \uc804\ubc18\uc801\uc778 \uac8c\uc784 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c Swingo\ub97c \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ud558\uae30 \uc704\ud55c \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c Swingo\ub97c \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ud558\ub824\uba74 \uc7a5\uce58\uac00 \ub2e4\uc74c \uc694\uad6c \uc0ac\ud56d\uc744 \ucda9\uc871\ud558\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \ubaa8\ubc14\uc77c \uc7a5\uce58\uc758 \uacbd\uc6b0 iOS 11 \uc774\uc0c1 \ubc0f Android 7.0 \uc774\uc0c1\uc774\uba70 \ucd5c\uc18c 2GB RAM\uc744 \ud544\uc694\ub85c \ud569\ub2c8\ub2e4. PC\uc758 \uacbd\uc6b0 Windows 10 \uc774\uc0c1, \ub4c0\uc5bc \ucf54\uc5b4 \ud504\ub85c\uc138\uc11c \ubc0f 4GB RAM\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, iPhone 8\uc5d0\uc11c Swingo\ub294 60 FPS\ub85c \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ub429\ub2c8\ub2e4. \uc124\uce58 \uc804\uc5d0 \uc774\ub7ec\ud55c \uc0ac\uc591\uc744 \ud655\uc778\ud558\uba74 \uc7a5\uce58 \uac04\uc5d0 \ucd5c\uc801\uc758 \uc131\ub2a5\uacfc \uc9c0\uc5f0 \uc5c6\ub294 \uac8c\uc784 \uacbd\ud5d8\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "\ud50c\ub808\uc774\uc5b4\uac00 \ud55c \uc7a5\uce58\uc5d0\uc11c \ub2e4\ub978 \uc7a5\uce58\ub85c Swingo \uc9c4\ud589 \uc0c1\ud669\uc744 \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud55c \uc7a5\uce58\uc5d0\uc11c \ub2e4\ub978 \uc7a5\uce58\ub85c Swingo \uc9c4\ud589 \uc0c1\ud669\uc744 \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. STEP1 - \ub450 \uc7a5\uce58 \ubaa8\ub450\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. STEP2 - \uac8c\uc784 \uc124\uc815 \uba54\ub274\uc5d0\uc11c \uc0ac\uc6a9 \uac00\ub2a5\ud55c '\ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5' \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. STEP3 - \uc0c8 \uc7a5\uce58\uc5d0\uc11c '\ud074\ub77c\uc6b0\ub4dc\uc5d0\uc11c \ubd88\ub7ec\uc624\uae30'\ub97c \uc120\ud0dd\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \ubcf5\uc6d0\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, Android \ud734\ub300\ud3f0\uc5d0\uc11c iPad\ub85c \uc804\ud658\ud558\uba74 \uc131\ucde8\ub3c4\uc640 \uc7a0\uae08 \ud574\uc81c\ub41c \ub808\ubca8\uc774 \uc6d0\ud65c\ud558\uac8c \uc804\uc1a1\ub429\ub2c8\ub2e4. \uc774 \ud504\ub85c\uc138\uc2a4\ub294 \uac8c\uc784 \uacbd\ud5d8\uc758 \uc5f0\uc18d\uc131\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "\ud50c\ub808\uc774\uc5b4\uac00 Swingo\uc5d0\uc11c \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Swingo\uc5d0\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uae30\ub2a5 \ubc0f \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ub208\uc5d0 \ub744\ub294 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uc784\uc758\ub85c \ub098\ud0c0\ub098\uace0 \ub9e4\uce58 \uc2dc \uac70\ub300\ud55c \uc810\uc218 \ubcf4\ub108\uc2a4\ub97c \uc81c\uacf5\ud558\ub294 '\uace8\ub4e0 \ubaa8\uc591'\uc785\ub2c8\ub2e4. \ub610\ud55c '\uba54\ub274' \ubc84\ud2bc\uc744 10\ucd08 \ub3d9\uc548 \ub204\ub974\uace0 \uc788\uc73c\uba74 \ube44\ubc00 \ubbf8\ub2c8 \uac8c\uc784\uc774 \uc5f4\ub9bd\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubbf8\ub2c8 \uac8c\uc784\uc5d0\uc11c \uace0\uc18d \ub9e4\uce58 \ucc4c\ub9b0\uc9c0\uc5d0\uc11c \uae30\uc220\uc744 \ud14c\uc2a4\ud2b8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uc694\uc18c\ub97c \ud0d0\uc0c9\ud558\uba74 \uac8c\uc784\uc5d0 \ucd94\uac00\uc801\uc778 \ud765\ubd84\uacfc \ubc1c\uacac\uc758 \uacc4\uce35\uc744 \ub354\ud569\ub2c8\ub2e4."}, {"question": "Swingo\uc758 '\ucf64\ubcf4 \uccb4\uc778' \uba54\ucee4\ub2c8\uc998\uc774 \ub192\uc740 \uc810\uc218\ub97c \uc704\ud55c \uac8c\uc784 \uccb4\uc778\uc800\uc778 \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Swingo\uc758 '\ucf64\ubcf4 \uccb4\uc778' \uba54\ucee4\ub2c8\uc998\uc740 \uc5f0\uc18d\uc801\uc778 \ub9e4\uce58\ub85c \uc810\uc218\ub97c \uae30\ud558\uae09\uc218\uc801\uc73c\ub85c \uc99d\uac00\uc2dc\ud0a4\ub294 \uac8c\uc784 \uccb4\uc778\uc800\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 4\uac1c\uc758 \ubaa8\uc591\uc744 \uc5f0\uc18d\uc73c\ub85c \ub9e4\uce58\ud558\uba74 \uae30\ubcf8 \uc810\uc218\uac00 2\ubc30\uac00 \ub418\uace0, 5\uac1c\uc758 \ubaa8\uc591\uc744 \ub9e4\uce58\ud558\uba74 3\ubc30\uac00 \ub429\ub2c8\ub2e4. \uc774\ub97c \uadf9\ub300\ud654\ud558\ub824\uba74 \uc6c0\uc9c1\uc784\uc744 \ubbf8\ub9ac \uacc4\ud68d\ud558\uc5ec \ub354 \uae34 \uccb4\uc778\uc744 \ub9cc\ub4dc\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \uc774 \uba54\ucee4\ub2c8\uc998\uc740 \uc810\uc218\ub97c \ub192\uc774\ub294 \uac83\ubfd0\ub9cc \uc544\ub2c8\ub77c \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc804\ub7b5\uc801 \uae4a\uc774\ub97c \ub354\ud558\uc5ec \uace0\ub4dd\uc810 \ucd94\uad6c\uc790\uc5d0\uac8c \ud544\uc218\uc801\uc785\ub2c8\ub2e4."}, {"question": "Swingo\uc758 '\uc801\uc751\ud615 AI'\uac00 \ucd08\ubcf4\uc790\uc640 \uc804\ubb38\uac00 \ubaa8\ub450\uc5d0\uac8c \ud50c\ub808\uc774\uc5b4 \uacbd\ud5d8\uc744 \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0a4\ub098\uc694?", "answer": "Swingo\uc758 '\uc801\uc751\ud615 AI'\ub294 \ud50c\ub808\uc774\uc5b4 \uc131\ub2a5\uc5d0 \ub530\ub77c \uac8c\uc784\uc758 \ub09c\uc774\ub3c4\ub97c \ub3d9\uc801\uc73c\ub85c \uc870\uc815\ud558\uc5ec \ud50c\ub808\uc774\uc5b4 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4. \ucd08\ubcf4\uc790\uc758 \uacbd\uc6b0 \ub2e8\uc21c\ud55c \uc2dc\ud000\uc2a4\ub97c \ub3c4\uc785\ud558\uc5ec \ubd80\ub4dc\ub7ec\uc6b4 \ud559\uc2b5 \uace1\uc120\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4. \uc804\ubb38\uac00\uc758 \uacbd\uc6b0 \ubcf5\uc7a1\ud55c \ud328\ud134\uacfc \ube60\ub978 \uc18d\ub3c4\ub85c \ub3c4\uc804 \uc218\uc900\uc744 \ub192\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc9c0\uc18d\uc801\uc73c\ub85c \uc88b\uc740 \uc131\ub2a5\uc744 \ubcf4\uc774\uba74 AI\ub294 \ub354 \ubcf5\uc7a1\ud55c \ubaa8\uc591\uacfc \ub354 \ube60\ub978 \uc2dc\ud000\uc2a4\ub97c \ub3c4\uc785\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ub9de\ucda4\ud615 \uc811\uadfc \ubc29\uc2dd\uc740 \ubaa8\ub4e0 \uae30\uc220 \uc218\uc900\uc5d0 \ub300\ud574 \uac8c\uc784\uc744 \ub9e4\ub825\uc801\uc774\uace0 \uc801\uc808\ud558\uac8c \uc5b4\ub824\uc6b4 \uc218\uc900\uc73c\ub85c \uc720\uc9c0\ud569\ub2c8\ub2e4."}]
[{"question": "\u09b8\u09cd\u09af\u09bf\u0982\u0997\u09cb\u09b0 \u09ae\u09cc\u09b2\u09bf\u0995 \u09a8\u09bf\u09af\u09bc\u09a8\u09cd\u09a4\u09cd\u09b0\u09a3\u0997\u09c1\u09b2\u09bf \u09a6\u09cd\u09b0\u09c1\u09a4 \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09b6\u09c1\u09b0\u09c1\u0995\u09be\u09b0\u09c0\u09b0\u09be \u0995\u09bf\u09ad\u09be\u09ac\u09c7 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7?", "answer": "\u09b8\u09cd\u09af\u09bf\u0982\u0997\u09cb\u09b0 \u09ae\u09cc\u09b2\u09bf\u0995 \u09a8\u09bf\u09af\u09bc\u09a8\u09cd\u09a4\u09cd\u09b0\u09a3\u0997\u09c1\u09b2\u09bf \u09a6\u09cd\u09b0\u09c1\u09a4 \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af, \u098f\u0987 \u09a7\u09be\u09aa\u0997\u09c1\u09b2\u09bf \u0985\u09a8\u09c1\u09b8\u09b0\u09a3 \u0995\u09b0\u09c1\u09a8: \u09a7\u09be\u09aa \u09e7 - \u09aa\u09cd\u09b0\u09a7\u09be\u09a8 \u09ae\u09c7\u09a8\u09c1\u09a4\u09c7 \u09aa\u09b0\u09bf\u099a\u09bf\u09a4 \u09b9\u09a8, \u09af\u09c7\u0996\u09be\u09a8\u09c7 \u0986\u09aa\u09a8\u09bf \u09ac\u09bf\u09ad\u09bf\u09a8\u09cd\u09a8 \u0997\u09c7\u09ae \u09ae\u09cb\u09a1 \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964 \u09a7\u09be\u09aa \u09e8 - \u099f\u09bf\u0989\u099f\u09cb\u09b0\u09bf\u09af\u09bc\u09be\u09b2 \u09ae\u09cb\u09a1\u09c7 \u09ae\u09cc\u09b2\u09bf\u0995 \u0986\u09a8\u09cd\u09a6\u09cb\u09b2\u09a8 \u09a8\u09bf\u09af\u09bc\u09a8\u09cd\u09a4\u09cd\u09b0\u09a3\u0997\u09c1\u09b2\u09bf \u0985\u09a8\u09c1\u09b6\u09c0\u09b2\u09a8 \u0995\u09b0\u09c1\u09a8, \u09af\u09be \u09ac\u09be\u09ae\u09c7, \u09a1\u09be\u09a8\u09c7, \u0989\u09aa\u09b0\u09c7 \u098f\u09ac\u0982 \u09a8\u09bf\u099a\u09c7 \u09b8\u09cb\u09af\u09bc\u09be\u0987\u09aa \u0995\u09b0\u09be\u0995\u09c7 \u0985\u09a8\u09cd\u09a4\u09b0\u09cd\u09ad\u09c1\u0995\u09cd\u09a4 \u0995\u09b0\u09c7\u0964 \u09a7\u09be\u09aa \u09e9 - \u0986\u09aa\u09a8\u09bf \u09af\u09be \u09b6\u09bf\u0996\u09c7\u099b\u09c7\u09a8 \u09a4\u09be \u098f\u0995\u099f\u09bf \u09ac\u09be\u09b8\u09cd\u09a4\u09ac \u0997\u09c7\u09ae\u09c7\u09b0 \u09aa\u09b0\u09bf\u09b8\u09cd\u09a5\u09bf\u09a4\u09bf\u09a4\u09c7 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u0997 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af '\u0995\u09c1\u0987\u0995 \u09ae\u09cd\u09af\u09be\u099a' \u09ae\u09cb\u09a1 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c1\u09a8\u0964 \u0989\u09a6\u09be\u09b9\u09b0\u09a3\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa, '\u0995\u09c1\u0987\u0995 \u09ae\u09cd\u09af\u09be\u099a'-\u098f \u09b0\u0982 \u098f\u09ac\u0982 \u0986\u0995\u09be\u09b0 \u09ae\u09c7\u09b2\u09be\u09a4\u09c7 \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u09a6\u09cd\u09b0\u09c1\u09a4 \u09b8\u09cb\u09af\u09bc\u09be\u0987\u09aa \u0995\u09b0\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964 \u098f\u0987 \u09a7\u09be\u09aa\u09c7 \u09a7\u09be\u09aa\u09c7 \u09aa\u09a6\u09cd\u09a7\u09a4\u09bf \u09b6\u09c1\u09b0\u09c1\u0995\u09be\u09b0\u09c0\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u098f\u0995\u099f\u09bf \u09ae\u09b8\u09c3\u09a3 \u09b6\u09c7\u0996\u09be\u09b0 \u09ac\u0995\u09cd\u09b0\u09b0\u09c7\u0996\u09be \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u09c7\u0964"}, {"question": "\u0997\u09c7\u09ae\u09c7 \u098f\u0997\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u0993\u09af\u09bc\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u09cd\u09af\u09bf\u0982\u0997\u09cb\u09b0 \u09b8\u09cd\u0995\u09cb\u09b0\u09bf\u0982 \u09b8\u09bf\u09b8\u09cd\u099f\u09c7\u09ae \u09ac\u09cb\u099d\u09be \u0995\u09c7\u09a8 \u0997\u09c1\u09b0\u09c1\u09a4\u09cd\u09ac\u09aa\u09c2\u09b0\u09cd\u09a3?", "answer": "\u09b8\u09cd\u09af\u09bf\u0982\u0997\u09cb\u09b0 \u09b8\u09cd\u0995\u09cb\u09b0\u09bf\u0982 \u09b8\u09bf\u09b8\u09cd\u099f\u09c7\u09ae \u09ac\u09cb\u099d\u09be \u0997\u09c1\u09b0\u09c1\u09a4\u09cd\u09ac\u09aa\u09c2\u09b0\u09cd\u09a3 \u0995\u09be\u09b0\u09a3 \u098f\u099f\u09bf \u09b8\u09b0\u09be\u09b8\u09b0\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u0997\u09cd\u09b0\u0997\u09a4\u09bf \u098f\u09ac\u0982 \u09b0\u200c\u09cd\u09af\u09be\u0999\u09cd\u0995\u09bf\u0982\u0995\u09c7 \u09aa\u09cd\u09b0\u09ad\u09be\u09ac\u09bf\u09a4 \u0995\u09b0\u09c7\u0964 \u09b8\u09cd\u0995\u09cb\u09b0\u09bf\u0982 \u09b8\u09bf\u09b8\u09cd\u099f\u09c7\u09ae \u0997\u09a4\u09bf, \u09b8\u09a0\u09bf\u0995\u09a4\u09be \u098f\u09ac\u0982 \u0995\u09ae\u09cd\u09ac\u09cb \u0997\u09c1\u09a3\u0995\u09c7\u09b0 \u09b8\u09ae\u09a8\u09cd\u09ac\u09af\u09bc\u09c7 \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u0964 \u0989\u09a6\u09be\u09b9\u09b0\u09a3\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa, \u09af\u09a6\u09bf \u0986\u09aa\u09a8\u09bf \u09a6\u09cd\u09b0\u09c1\u09a4 \u098f\u0995\u09c7\u09b0 \u09aa\u09b0 \u098f\u0995 \u09a4\u09bf\u09a8\u099f\u09bf \u0986\u0995\u09be\u09b0 \u09ae\u09bf\u09b2\u09bf\u09af\u09bc\u09c7 \u09ab\u09c7\u09b2\u09c7\u09a8, \u09a4\u09be\u09b9\u09b2\u09c7 \u0986\u09aa\u09a8\u09bf \u098f\u0995\u099f\u09bf \u0995\u09ae\u09cd\u09ac\u09cb \u0997\u09c1\u09a3\u0995 \u0985\u09b0\u09cd\u099c\u09a8 \u0995\u09b0\u09ac\u09c7\u09a8, \u09af\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09cd\u0995\u09cb\u09b0\u0995\u09c7 \u0989\u09b2\u09cd\u09b2\u09c7\u0996\u09af\u09cb\u0997\u09cd\u09af\u09ad\u09be\u09ac\u09c7 \u09ac\u09c3\u09a6\u09cd\u09a7\u09bf \u0995\u09b0\u09ac\u09c7\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09cd\u0995\u09cb\u09b0\u0995\u09c7 \u09b8\u09b0\u09cd\u09ac\u09cb\u099a\u09cd\u099a \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af, \u09a6\u09c0\u09b0\u09cd\u0998 \u0995\u09ae\u09cd\u09ac\u09cb \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09a4\u09c7 \u098f\u09ac\u0982 \u09b8\u09a0\u09bf\u0995\u09a4\u09be \u09ac\u099c\u09be\u09af\u09bc \u09b0\u09be\u0996\u09a4\u09c7 \u09ae\u09a8\u09cb\u09af\u09cb\u0997 \u09a6\u09bf\u09a8\u0964 \u098f\u0987 \u099c\u09cd\u099e\u09be\u09a8 \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u0986\u09b0\u0993 \u09ad\u09be\u09b2\u09cb\u09ad\u09be\u09ac\u09c7 \u0995\u09cc\u09b6\u09b2\u09aa\u09c2\u09b0\u09cd\u09a3\u09ad\u09be\u09ac\u09c7 \u0995\u09be\u099c \u0995\u09b0\u09a4\u09c7 \u098f\u09ac\u0982 \u09b2\u09bf\u09a1\u09be\u09b0\u09ac\u09cb\u09b0\u09cd\u09a1\u09c7 \u09a6\u09cd\u09b0\u09c1\u09a4 \u0989\u09a0\u09a4\u09c7 \u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af \u0995\u09b0\u09c7\u0964"}, {"question": "\u09b8\u09cd\u09af\u09bf\u0982\u0997\u09cb\u09b0 \u0989\u09a8\u09cd\u09a8\u09a4 \u0995\u09cc\u09b6\u09b2\u0997\u09c1\u09b2\u09bf \u0986\u09af\u09bc\u09a4\u09cd\u09a4 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u09c0\u09af\u09bc \u099f\u09bf\u09aa\u09b8 \u0995\u09cb\u09a8\u0997\u09c1\u09b2\u09bf?", "answer": "\u09b8\u09cd\u09af\u09bf\u0982\u0997\u09cb\u09b0 \u0989\u09a8\u09cd\u09a8\u09a4 \u0995\u09cc\u09b6\u09b2\u0997\u09c1\u09b2\u09bf \u0986\u09af\u09bc\u09a4\u09cd\u09a4 \u0995\u09b0\u09a4\u09c7 \u09ac\u09c7\u09b6 \u0995\u09af\u09bc\u09c7\u0995\u099f\u09bf \u0997\u09c1\u09b0\u09c1\u09a4\u09cd\u09ac\u09aa\u09c2\u09b0\u09cd\u09a3 \u099f\u09bf\u09aa\u09b8 \u09b0\u09af\u09bc\u09c7\u099b\u09c7: \u09a7\u09be\u09aa \u09e7 - \u09aa\u09b0\u09c7\u09b0 \u09b8\u09c7\u099f\u09c7\u09b0 \u0986\u0995\u09be\u09b0\u0997\u09c1\u09b2\u09bf \u09aa\u09cd\u09af\u09be\u099f\u09be\u09b0\u09cd\u09a8 \u09aa\u09b0\u09cd\u09af\u09ac\u09c7\u0995\u09cd\u09b7\u09a3 \u0995\u09b0\u09c7 \u09ad\u09ac\u09bf\u09b7\u09cd\u09af\u09a6\u09cd\u09ac\u09be\u09a3\u09c0 \u0995\u09b0\u09a4\u09c7 \u09b6\u09bf\u0996\u09c1\u09a8\u0964 \u09a7\u09be\u09aa \u09e8 - \u0995\u09cc\u09b6\u09b2\u0997\u09a4\u09ad\u09be\u09ac\u09c7 \u09aa\u09be\u0993\u09af\u09bc\u09be\u09b0-\u0986\u09aa \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c1\u09a8, \u09af\u09c7\u09ae\u09a8 '\u09b0\u0982 \u09ac\u09cb\u09ae\u09cd\u09ac\u09be' \u09af\u09be \u09a8\u09bf\u09b0\u09cd\u09a6\u09bf\u09b7\u09cd\u099f \u09b0\u0999\u09c7\u09b0 \u09b8\u09ae\u09b8\u09cd\u09a4 \u0986\u0995\u09be\u09b0 \u09aa\u09b0\u09bf\u09b7\u09cd\u0995\u09be\u09b0 \u0995\u09b0\u09c7\u0964 \u09a7\u09be\u09aa \u09e9 - \u0989\u099a\u09cd\u099a \u099a\u09be\u09aa\u09c7\u09b0 \u0985\u09a7\u09c0\u09a8\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09a6\u0995\u09cd\u09b7\u09a4\u09be \u09aa\u09b0\u09bf\u09b6\u09c0\u09b2\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af '\u098f\u0995\u09cd\u09b8\u09aa\u09be\u09b0\u09cd\u099f \u09ae\u09cb\u09a1\u09c7' \u0985\u09a8\u09c1\u09b6\u09c0\u09b2\u09a8 \u0995\u09b0\u09c1\u09a8\u0964 \u0989\u09a6\u09be\u09b9\u09b0\u09a3\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa, '\u098f\u0995\u09cd\u09b8\u09aa\u09be\u09b0\u09cd\u099f \u09ae\u09cb\u09a1\u09c7', \u0986\u09aa\u09a8\u09bf \u09a6\u09cd\u09b0\u09c1\u09a4\u09a4\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8 \u098f\u09ae\u09a8 \u09a6\u09cd\u09b0\u09c1\u09a4 \u0986\u0995\u09be\u09b0\u09c7\u09b0 \u0995\u09cd\u09b0\u09ae\u09c7 \u09aa\u09be\u09ac\u09c7\u09a8\u0964 \u098f\u0987 \u09a7\u09be\u09aa\u0997\u09c1\u09b2\u09bf \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09be\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b8\u09be\u09a5\u09c7 \u098f\u0995\u099f\u09bf \u0985\u09ad\u09bf\u099c\u09cd\u099e \u0996\u09c7\u09b2\u09cb\u09af\u09bc\u09be\u09a1\u09bc\u09c7 \u09b0\u09c2\u09aa\u09be\u09a8\u09cd\u09a4\u09b0\u09bf\u09a4 \u0995\u09b0\u09a4\u09c7 \u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af \u0995\u09b0\u09ac\u09c7\u0964"}, {"question": "\u0995\u09cb\u09a8 \u09b8\u09cd\u09af\u09bf\u0982\u0997\u09cb \u0997\u09c7\u09ae \u09ae\u09cb\u09a1 \u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be \u09b8\u09ae\u09af\u09bc \u0989\u09a8\u09cd\u09a8\u09a4 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u09b0\u09cd\u09ac\u09cb\u09a4\u09cd\u09a4\u09ae \u0985\u09a8\u09c1\u09b6\u09c0\u09b2\u09a8 \u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u0995\u09b0\u09c7?", "answer": "'\u099f\u09be\u0987\u09ae \u0985\u09cd\u09af\u09be\u099f\u09be\u0995' \u098f\u09ac\u0982 '\u09ac\u09cd\u09b2\u09bf\u09a4\u099c \u09ae\u09cb\u09a1'-\u098f \u09b8\u09cd\u09af\u09bf\u0982\u0997\u09cb\u09a4\u09c7 \u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be \u09b8\u09ae\u09af\u09bc \u0989\u09a8\u09cd\u09a8\u09a4 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09ae\u09a8\u09cb\u09af\u09cb\u0997 \u09a6\u09bf\u09a8\u0964 '\u099f\u09be\u0987\u09ae \u0985\u09cd\u09af\u09be\u099f\u09be\u0995' \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u09a8\u09bf\u09b0\u09cd\u09a6\u09bf\u09b7\u09cd\u099f \u09b8\u09ae\u09af\u09bc\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u09af\u09a4\u099f\u09be \u09b8\u09ae\u09cd\u09ad\u09ac \u09ae\u09cd\u09af\u09be\u099a \u09b8\u09ae\u09cd\u09aa\u09a8\u09cd\u09a8 \u0995\u09b0\u09be\u09b0 \u099a\u09cd\u09af\u09be\u09b2\u09c7\u099e\u09cd\u099c \u09a6\u09c7\u09af\u09bc, \u09af\u09be \u09a6\u09cd\u09b0\u09c1\u09a4 \u0928\u093f\u0930\u094d\u0923\u092f\u0997\u09cd\u09b0\u09b9\u09a3\u09c7\u09b0 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8 \u0995\u09b0\u09c7\u0964 '\u09ac\u09cd\u09b2\u09bf\u09a4\u099c \u09ae\u09cb\u09a1' \u0995\u09cd\u09b0\u09ae\u09b6 \u0986\u0995\u09be\u09b0\u09c7\u09b0 \u0995\u09cd\u09b0\u09ae\u09c7\u09b0 \u0997\u09a4\u09bf \u09ac\u09be\u09a1\u09bc\u09be\u09af\u09bc, \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be\u09b0 \u09b8\u09c0\u09ae\u09be \u099a\u09be\u09aa\u09bf\u09af\u09bc\u09c7 \u09a6\u09c7\u09af\u09bc\u0964 \u0989\u09a6\u09be\u09b9\u09b0\u09a3\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa, '\u09ac\u09cd\u09b2\u09bf\u09a4\u099c \u09ae\u09cb\u09a1\u09c7', \u0986\u09aa\u09a8\u09bf \u09a7\u09c0\u09b0 \u0995\u09cd\u09b0\u09ae \u09a6\u09bf\u09af\u09bc\u09c7 \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8, \u09a4\u09ac\u09c7 \u09eb\u09ae \u09b2\u09c7\u09ad\u09c7\u09b2 \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u0997\u09a4\u09bf \u0989\u09b2\u09cd\u09b2\u09c7\u0996\u09af\u09cb\u0997\u09cd\u09af\u09ad\u09be\u09ac\u09c7 \u09ac\u09c7\u09a1\u09bc\u09c7 \u09af\u09be\u09af\u09bc\u0964 \u098f\u0987 \u09ae\u09cb\u09a1\u0997\u09c1\u09b2\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be\u09ac\u09cb\u09a7\u09c7\u09b0 \u0995\u09b0\u09cd\u09ae\u0995\u09cd\u09b7\u09ae\u09a4\u09be \u098f\u09ac\u0982 \u0997\u09a4\u09bf \u09aa\u09b0\u09bf\u09b6\u09c0\u09b2\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09a6\u09c1\u09b0\u09cd\u09a6\u09be\u09a8\u09cd\u09a4\u0964"}, {"question": "\u0986\u0995\u09be\u09b0\u09c7\u09b0 \u0995\u09cd\u09b0\u09ae\u09c7\u09b0 \u0995\u09a0\u09bf\u09a8\u09a4\u09be \u09b8\u09cd\u09af\u09bf\u0982\u0997\u09cb\u09b0 \u0985\u09cd\u09af\u09be\u09b2\u0997\u09b0\u09bf\u09a6\u09ae \u0995\u09bf\u09ad\u09be\u09ac\u09c7 \u09a8\u09bf\u09b0\u09cd\u09a7\u09be\u09b0\u09a3 \u0995\u09b0\u09c7?", "answer": "\u0996\u09c7\u09b2\u09cb\u09af\u09bc\u09be\u09a1\u09bc\u09c7\u09b0 \u09a6\u0995\u09cd\u09b7\u09a4\u09be \u09b8\u09cd\u09a4\u09b0, \u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8 \u09b8\u09cd\u0995\u09cb\u09b0 \u098f\u09ac\u0982 \u0997\u09c7\u09ae \u09ae\u09cb\u09a1\u09c7\u09b0 \u0989\u09aa\u09b0 \u09a8\u09bf\u09b0\u09cd\u09ad\u09b0 \u0995\u09b0\u09c7 \u09b8\u09cd\u09af\u09bf\u0982\u0997\u09cb\u09b0 \u0985\u09cd\u09af\u09be\u09b2\u0997\u09b0\u09bf\u09a6\u09ae \u0986\u0995\u09be\u09b0 \u0995\u09cd\u09b0\u09ae\u09c7\u09b0 \u0995\u09a0\u09bf\u09a8\u09a4\u09be \u09a8\u09bf\u09b0\u09cd\u09a7\u09be\u09b0\u09a3 \u0995\u09b0\u09c7\u0964 \u0989\u09a6\u09be\u09b9\u09b0\u09a3\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa, '\u09aa\u09cd\u09b0\u09cb\u0997\u09cd\u09b0\u09c7\u09b8\u09bf\u09ad \u09ae\u09cb\u09a1\u09c7', \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09cd\u0995\u09cb\u09b0 \u09ac\u09c3\u09a6\u09cd\u09a7\u09bf\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b8\u09be\u09a5\u09c7 \u0985\u09cd\u09af\u09be\u09b2\u0997\u09b0\u09bf\u09a6\u09ae \u0986\u0995\u09be\u09b0\u09c7\u09b0 \u099c\u099f\u09bf\u09b2\u09a4\u09be \u098f\u09ac\u0982 \u0997\u09a4\u09bf \u09ac\u09be\u09a1\u09bc\u09be\u09af\u09bc\u0964 \u09b8\u09bf\u09b8\u09cd\u099f\u09c7\u09ae\u099f\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u0995\u09b0\u09cd\u09ae\u0995\u09cd\u09b7\u09ae\u09a4\u09be\u09b0 \u09b8\u09be\u09a5\u09c7 \u0996\u09be\u09aa \u0996\u09be\u09af\u09bc, \u09af\u09be \u09b8\u09a0\u09bf\u0995 \u099a\u09cd\u09af\u09be\u09b2\u09c7\u099e\u09cd\u099c \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u09c7\u0964 \u098f\u0987 \u09aa\u09cd\u09b0\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be \u09ac\u09c1\u099d\u09c7 \u0986\u09aa\u09a8\u09bf \u0995\u09a0\u09bf\u09a8 \u0995\u09cd\u09b0\u09ae\u09c7\u09b0 \u09aa\u09c2\u09b0\u09cd\u09ac\u09be\u09ad\u09be\u09b8 \u09a6\u09bf\u09a4\u09c7 \u098f\u09ac\u0982 \u09aa\u09cd\u09b0\u09b8\u09cd\u09a4\u09c1\u09a4\u09bf \u09a8\u09bf\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8, \u09af\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09be\u09ae\u0997\u09cd\u09b0\u09bf\u0995 \u0997\u09c7\u09ae\u09bf\u0982 \u0985\u09ad\u09bf\u099c\u09cd\u099e\u09a4\u09be \u0989\u09a8\u09cd\u09a8\u09a4 \u0995\u09b0\u09c7\u0964"}, {"question": "\u09ac\u09bf\u09ad\u09bf\u09a8\u09cd\u09a8 \u09aa\u09cd\u09b2\u09cd\u09af\u09be\u099f\u09ab\u09b0\u09cd\u09ae\u09c7 \u09b8\u09cd\u09af\u09bf\u0982\u0997\u09cb \u09ae\u09b8\u09c3\u09a3\u09ad\u09be\u09ac\u09c7 \u099a\u09be\u09b2\u09be\u09a8\u09cb\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u09bf\u09b8\u09cd\u099f\u09c7\u09ae\u09c7\u09b0 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u09c0\u09af\u09bc\u09a4\u09be\u0997\u09c1\u09b2\u09bf \u0995\u09c0 \u0995\u09c0?", "answer": "\u09ac\u09bf\u09ad\u09bf\u09a8\u09cd\u09a8 \u09aa\u09cd\u09b2\u09cd\u09af\u09be\u099f\u09ab\u09b0\u09cd\u09ae\u09c7 \u09b8\u09cd\u09af\u09bf\u0982\u0997\u09cb \u09ae\u09b8\u09c3\u09a3\u09ad\u09be\u09ac\u09c7 \u099a\u09be\u09b2\u09be\u09a8\u09cb\u09b0 \u099c\u09a8\u09cd\u09af, \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u09c1\u09a8 \u09af\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09a1\u09bf\u09ad\u09be\u0987\u09b8 \u098f\u0987 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u09c0\u09af\u09bc\u09a4\u09be \u09aa\u09c2\u09b0\u09a3 \u0995\u09b0\u09c7: \u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u09a1\u09bf\u09ad\u09be\u0987\u09b8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af, iOS 11 \u09ac\u09be \u09aa\u09b0\u09ac\u09b0\u09cd\u09a4\u09c0 \u098f\u09ac\u0982 Android 7.0 \u09ac\u09be \u09aa\u09b0\u09ac\u09b0\u09cd\u09a4\u09c0 \u0985\u09a8\u09cd\u09a4\u09a4 2GB RAM\u0964 \u09aa\u09bf\u09b8\u09bf\u09b0 \u099c\u09a8\u09cd\u09af, Windows 10 \u09ac\u09be \u09aa\u09b0\u09ac\u09b0\u09cd\u09a4\u09c0\u09a4\u09c7 \u09a6\u09c1\u0987-\u0995\u09cb\u09b0 \u09aa\u09cd\u09b0\u09b8\u09c7\u09b8\u09b0 \u098f\u09ac\u0982 4GB RAM\u0964 \u0989\u09a6\u09be\u09b9\u09b0\u09a3\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa, iPhone 8-\u098f, \u09b8\u09cd\u09af\u09bf\u0982\u0997\u09cb 60 FPS-\u098f \u09ae\u09b8\u09c3\u09a3\u09ad\u09be\u09ac\u09c7 \u099a\u09b2\u09c7\u0964 \u0987\u09a8\u09b8\u09cd\u099f\u09b2\u09c7\u09b6\u09a8\u09c7\u09b0 \u0986\u0997\u09c7 \u098f\u0987 \u09b8\u09cd\u09aa\u09c7\u09b8\u09bf\u09ab\u09bf\u0995\u09c7\u09b6\u09a8 \u099a\u09c7\u0995 \u0995\u09b0\u09b2\u09c7 \u09a1\u09bf\u09ad\u09be\u0987\u09b8\u0997\u09c1\u09b2\u09bf\u09a4\u09c7 \u09b8\u09b0\u09cd\u09ac\u09cb\u09a4\u09cd\u09a4\u09ae \u0995\u09b0\u09cd\u09ae\u0995\u09cd\u09b7\u09ae\u09a4\u09be \u098f\u09ac\u0982 \u09b2\u09c7\u0997-\u09ab\u09cd\u09b0\u09bf \u0997\u09c7\u09ae\u09bf\u0982 \u0985\u09ad\u09bf\u099c\u09cd\u099e\u09a4\u09be \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u09c7\u0964"}, {"question": "\u0996\u09c7\u09b2\u09cb\u09af\u09bc\u09be\u09a1\u09bc\u09b0\u09be \u098f\u0995 \u09a1\u09bf\u09ad\u09be\u0987\u09b8 \u09a5\u09c7\u0995\u09c7 \u0985\u09a8\u09cd\u09af \u09a1\u09bf\u09ad\u09be\u0987\u09b8\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0 \u09b8\u09cd\u09af\u09bf\u0982\u0997\u09cb\u09b0 \u0985\u0997\u09cd\u09b0\u0997\u09a4\u09bf \u0995\u09c0\u09ad\u09be\u09ac\u09c7 \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u09a8\u09cd\u09a4\u09b0 \u0995\u09b0\u09c7?", "answer": "\u098f\u0995\u099f\u09bf \u09a1\u09bf\u09ad\u09be\u0987\u09b8 \u09a5\u09c7\u0995\u09c7 \u0985\u09a8\u09cd\u09af \u09a1\u09bf\u09ad\u09be\u0987\u09b8\u09c7 \u09b8\u09cd\u09af\u09bf\u0982\u0997\u09cb\u09b0 \u0985\u0997\u09cd\u09b0\u0997\u09a4\u09bf \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u09a8\u09cd\u09a4\u09b0 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af, \u098f\u0987 \u09a7\u09be\u09aa\u0997\u09c1\u09b2\u09bf \u0985\u09a8\u09c1\u09b8\u09b0\u09a3 \u0995\u09b0\u09c1\u09a8: \u09a7\u09be\u09aa \u09e7 - \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u09c1\u09a8 \u09af\u09c7 \u0986\u09aa\u09a8\u09bf \u0989\u09ad\u09af\u09bc \u09a1\u09bf\u09ad\u09be\u0987\u09b8\u09c7\u0987 \u098f\u0995\u0987 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f\u09c7 \u09b2\u0997 \u0987\u09a8 \u0995\u09b0\u09c7\u099b\u09c7\u09a8\u0964 \u09a7\u09be\u09aa \u09e8 - \u0997\u09c7\u09ae\u09c7\u09b0 \u09b8\u09c7\u099f\u09bf\u0982\u09b8 \u09ae\u09c7\u09a8\u09c1\u09a4\u09c7 \u09aa\u09be\u0993\u09af\u09bc\u09be '\u0995\u09cd\u09b2\u09be\u0989\u09a1 \u09b8\u09c7\u09ad' \u09ab\u09bf\u099a\u09be\u09b0 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c1\u09a8\u0964 \u09a7\u09be\u09aa \u09e9 - \u09a8\u09a4\u09c1\u09a8 \u09a1\u09bf\u09ad\u09be\u0987\u09b8\u09c7 '\u0995\u09cd\u09b2\u09be\u0989\u09a1 \u09a5\u09c7\u0995\u09c7 \u09b2\u09cb\u09a1' \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u0997\u09cd\u09b0\u0997\u09a4\u09bf \u09aa\u09c1\u09a8\u09b0\u09c1\u09a6\u09cd\u09a7\u09be\u09b0 \u0995\u09b0\u09c1\u09a8\u0964 \u0989\u09a6\u09be\u09b9\u09b0\u09a3\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa, \u09af\u09a6\u09bf \u0986\u09aa\u09a8\u09bf \u098f\u0995\u099f\u09bf Android \u09ab\u09cb\u09a8 \u09a5\u09c7\u0995\u09c7 iPad-\u098f \u09b8\u09cd\u09af\u09c1\u0987\u099a \u0995\u09b0\u09c7\u09a8, \u09a4\u09be\u09b9\u09b2\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09b0\u09cd\u099c\u09a8 \u098f\u09ac\u0982 \u0905\u0928\u0932\u0949\u0915\u0995\u09c3\u09a4 \u09b8\u09cd\u09a4\u09b0 \u09b8\u09b9\u099c\u09c7\u0987 \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u09a8\u09cd\u09a4\u09b0\u09bf\u09a4 \u09b9\u09ac\u09c7\u0964 \u098f\u0987 \u09aa\u09cd\u09b0\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u0997\u09c7\u09ae\u09bf\u0982 \u0985\u09ad\u09bf\u099c\u09cd\u099e\u09a4\u09be\u09af\u09bc \u09b8\u09a8\u09cd\u09a4\u09c1\u09b7\u09cd\u099f\u09bf \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u09c7\u0964"}, {"question": "\u09b8\u09cd\u09af\u09bf\u0982\u0997\u09cb\u09a4\u09c7 \u0997\u09cb\u09aa\u09a8 \u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af \u09ac\u09be \u0908\u09b8\u09cd\u099f\u09be\u09b0 \u098f\u0997\u0997\u09c1\u09b2\u09bf \u0996\u09c7\u09b2\u09cb\u09af\u09bc\u09be\u09a1\u09bc\u09b0\u09be \u0995\u09bf\u09ad\u09be\u09ac\u09c7 \u0986\u09ac\u09bf\u09b7\u09cd\u0995\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7?", "answer": "\u09b8\u09cd\u09af\u09bf\u0982\u0997\u09cb\u09a4\u09c7 \u0996\u09c7\u09b2\u09cb\u09af\u09bc\u09be\u09a1\u09bc\u09b0\u09be \u0986\u09ac\u09bf\u09b7\u09cd\u0995\u09be\u09b0 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09ac\u09bf\u09ad\u09bf\u09a8\u09cd\u09a8 \u0997\u09cb\u09aa\u09a8 \u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af \u098f\u09ac\u0982 \u0908\u09b8\u09cd\u099f\u09be\u09b0 \u098f\u0997 \u09b0\u09af\u09bc\u09c7\u099b\u09c7\u0964 \u098f\u0995\u099f\u09bf \u0909\u0932\u094d\u0932\u0947\u0916\u0928\u0940\u092f \u0908\u09b8\u09cd\u099f\u09be\u09b0 \u098f\u0997 \u09b9\u09b2 '\u09b8\u09cb\u09a8\u09be\u09b0 \u0986\u0995\u09be\u09b0', \u09af\u09be \u098f\u09b2\u09cb\u09ae\u09c7\u09b2\u09cb\u09ad\u09be\u09ac\u09c7 \u099a\u09b2\u09c7 \u0986\u09b8\u09c7 \u098f\u09ac\u0982 \u09ae\u09bf\u09b2\u09be\u09a8\u09cb \u09b9\u09b2\u09c7 \u09ac\u09bf\u09b6\u09be\u09b2 \u09b8\u09cd\u0995\u09cb\u09b0 \u09ac\u09c3\u09a6\u09cd\u09a7\u09bf \u09a6\u09c7\u09af\u09bc\u0964 \u098f\u099b\u09be\u09a1\u09bc\u09be\u0993, '\u09ae\u09c7\u09a8\u09c1' \u09ac\u09cb\u09a4\u09be\u09ae 10 \u09b8\u09c7\u0995\u09c7\u09a8\u09cd\u09a1 \u09a7\u09b0\u09c7 \u09a7\u09b0\u09c7 \u09b0\u09be\u0996\u09b2\u09c7 \u098f\u0995\u099f\u09bf \u0997\u09cb\u09aa\u09a8 \u09ae\u09bf\u09a8\u09bf-\u0997\u09c7\u09ae \u0905\u0928\u0932\u0949\u0915 \u09b9\u09ac\u09c7\u0964 \u0989\u09a6\u09be\u09b9\u09b0\u09a3\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa, \u09ae\u09bf\u09a8\u09bf-\u0997\u09c7\u09ae\u09c7, \u0986\u09aa\u09a8\u09bf \u098f\u0995\u099f\u09bf \u0985\u09a8\u09a8\u09cd\u09af, \u0989\u099a\u09cd\u099a-\u0997\u09a4\u09bf\u09b0 \u09ae\u09cd\u09af\u09be\u099a \u099a\u09cd\u09af\u09be\u09b2\u09c7\u099e\u09cd\u099c\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09a6\u0995\u09cd\u09b7\u09a4\u09be \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964 \u098f\u0987 \u0997\u09cb\u09aa\u09a8 \u0989\u09aa\u09be\u09a6\u09be\u09a8\u0997\u09c1\u09b2\u09bf \u0997\u09c7\u09ae\u09c7 \u0985\u09a4\u09bf\u09b0\u09bf\u0995\u09cd\u09a4 \u0989\u09a4\u09cd\u09a4\u09c7\u099c\u09a8\u09be \u098f\u09ac\u0982 \u0986\u09ac\u09bf\u09b7\u09cd\u0995\u09be\u09b0\u09c7\u09b0 \u09b8\u09cd\u09a4\u09b0 \u09af\u09cb\u0997 \u0995\u09b0\u09c7\u0964"}, {"question": "'\u0995\u09ae\u09cd\u09ac\u09cb \u099a\u09c7\u0987\u09a8' \u09ae\u09c7\u0995\u09be\u09a8\u09bf\u0995 \u09b8\u09cd\u09af\u09bf\u0982\u0997\u09cb\u09a4\u09c7 \u0989\u099a\u09cd\u099a \u09b8\u09cd\u0995\u09cb\u09b0\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0995\u09c7\u09a8 \u098f\u0995\u099f\u09bf \u0997\u09c7\u09ae-\u099a\u09c7\u099e\u09cd\u099c\u09be\u09b0?", "answer": "\u09b8\u09cd\u09af\u09bf\u0982\u0997\u09cb\u09a4\u09c7 '\u0995\u09ae\u09cd\u09ac\u09cb \u099a\u09c7\u0987\u09a8' \u09ae\u09c7\u0995\u09be\u09a8\u09bf\u0995 \u098f\u0995\u099f\u09bf \u0997\u09c7\u09ae-\u099a\u09c7\u099e\u09cd\u099c\u09be\u09b0 \u0995\u09be\u09b0\u09a3 \u098f\u099f\u09bf \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u0995\u09cd\u09b0\u09ae\u09bf\u0995 \u09ae\u09cd\u09af\u09be\u099a\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09cd\u0995\u09cb\u09b0\u0995\u09c7 \u09a6\u09cd\u09b0\u09c1\u09a4 \u09ac\u09c3\u09a6\u09cd\u09a7\u09bf \u0995\u09b0\u09c7\u0964 \u0989\u09a6\u09be\u09b9\u09b0\u09a3\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa, \u09b8\u09be\u09b0\u09bf\u09a4\u09c7 \u099a\u09be\u09b0\u099f\u09bf \u0986\u0995\u09be\u09b0 \u09ae\u09c7\u09b2\u09be\u09b2\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09ac\u09c7\u09b8 \u09b8\u09cd\u0995\u09cb\u09b0 \u09a6\u09cd\u09ac\u09bf\u0997\u09c1\u09a3 \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7, \u0986\u09b0 \u09aa\u09be\u0981\u099a\u099f\u09bf \u0986\u0995\u09be\u09b0 \u09ae\u09c7\u09b2\u09be\u09b2\u09c7 \u09a4\u09cd\u09b0\u09bf\u0997\u09c1\u09a3 \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964 \u098f\u099f\u09bf \u09b8\u09b0\u09cd\u09ac\u09be\u09a7\u09bf\u0995 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af, \u0986\u09aa\u09a8\u09be\u09b0 \u0986\u0997\u09be\u09ae\u09c0 \u09aa\u09a6\u0995\u09cd\u09b7\u09c7\u09aa \u09aa\u09b0\u09bf\u0995\u09b2\u09cd\u09aa\u09a8\u09be \u0995\u09b0\u09c7 \u0986\u09b0\u0993 \u09a6\u09c0\u09b0\u09cd\u0998 \u099a\u09c7\u0987\u09a8 \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09be\u09b0 \u0989\u09aa\u09b0 \u09ae\u09a8\u09cb\u09af\u09cb\u0997 \u09a6\u09bf\u09a8\u0964 \u098f\u0987 \u09ae\u09c7\u0995\u09be\u09a8\u09bf\u0995 \u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09b0 \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09cd\u0995\u09cb\u09b0\u0987 \u09ac\u09be\u09a1\u09bc\u09be\u09af\u09bc \u09a8\u09be, \u09ac\u09b0\u0982 \u0997\u09c7\u09ae\u09c7 \u098f\u0995\u099f\u09bf \u0995\u09cc\u09b6\u09b2\u0997\u09a4 \u0997\u09ad\u09c0\u09b0\u09a4\u09be \u09af\u09cb\u0997 \u0995\u09b0\u09c7, \u09af\u09be \u0989\u099a\u09cd\u099a \u09b8\u09cd\u0995\u09cb\u09b0 \u099a\u09c7\u099c\u09be\u09b0\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0985\u09aa\u09b0\u09bf\u09b9\u09be\u09b0\u09cd\u09af \u0995\u09b0\u09c7 \u09a4\u09cb\u09b2\u09c7\u0964"}, {"question": "\u09b6\u09c1\u09b0\u09c1\u0995\u09be\u09b0\u09c0 \u098f\u09ac\u0982 \u09ac\u09bf\u09b6\u09c7\u09b7\u099c\u09cd\u099e \u0989\u09ad\u09af\u09bc\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u09cd\u09af\u09bf\u0982\u0997\u09cb\u09b0 '\u0985\u09cd\u09af\u09be\u09a1\u09be\u09aa\u09cd\u099f\u09bf\u09ad \u098f\u0986\u0987' \u0996\u09c7\u09b2\u09cb\u09af\u09bc\u09be\u09a1\u09bc\u09c7\u09b0 \u0985\u09ad\u09bf\u099c\u09cd\u099e\u09a4\u09be \u0995\u09c0\u09ad\u09be\u09ac\u09c7 \u0989\u09a8\u09cd\u09a8\u09a4 \u0995\u09b0\u09c7?", "answer": "\u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09be\u09b0\u09ab\u09b0\u09ae\u09cd\u09af\u09be\u09a8\u09cd\u09b8\u09c7\u09b0 \u0989\u09aa\u09b0 \u09a8\u09bf\u09b0\u09cd\u09ad\u09b0 \u0995\u09b0\u09c7 \u0997\u09c7\u09ae\u09c7\u09b0 \u0995\u09a0\u09bf\u09a8\u09a4\u09be\u099f\u09bf\u0995\u09c7 \u0997\u09a4\u09bf\u09b6\u09c0\u09b2\u09ad\u09be\u09ac\u09c7 \u09b8\u09ae\u09a8\u09cd\u09ac\u09af\u09bc \u0995\u09b0\u09c7 \u09b8\u09cd\u09af\u09bf\u0982\u0997\u09cb\u09b0 '\u0985\u09cd\u09af\u09be\u09a1\u09be\u09aa\u09cd\u099f\u09bf\u09ad \u098f\u0986\u0987' \u0996\u09c7\u09b2\u09cb\u09af\u09bc\u09be\u09a1\u09bc\u09c7\u09b0 \u0985\u09ad\u09bf\u099c\u09cd\u099e\u09a4\u09be \u0989\u09a8\u09cd\u09a8\u09a4 \u0995\u09b0\u09c7\u0964 \u09b6\u09c1\u09b0\u09c1\u0995\u09be\u09b0\u09c0\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af, \u098f\u099f\u09bf \u09b8\u09b9\u099c \u09b6\u09c3\u0999\u09cd\u0996\u09b2\u09be \u0989\u09aa\u09b8\u09cd\u09a5\u09be\u09aa\u09a8 \u0995\u09b0\u09c7 \u09a7\u09c0\u09b0\u09c7 \u09a7\u09c0\u09b0\u09c7 \u09b6\u09c7\u0996\u09be\u09b0 \u09ac\u0995\u09cd\u09b0\u09b0\u09c7\u0996\u09be \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u09c7\u0964 \u09ac\u09bf\u09b6\u09c7\u09b7\u099c\u09cd\u099e\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af, \u098f\u099f\u09bf \u099c\u099f\u09bf\u09b2 \u09aa\u09cd\u09af\u09be\u099f\u09be\u09b0\u09cd\u09a8 \u098f\u09ac\u0982 \u09a6\u09cd\u09b0\u09c1\u09a4 \u0997\u09a4\u09bf\u09a4\u09c7 \u099a\u09cd\u09af\u09be\u09b2\u09c7\u099e\u09cd\u099c\u09c7\u09b0 \u09a4\u09c0\u09ac\u09cd\u09b0\u09a4\u09be \u09ac\u09c3\u09a6\u09cd\u09a7\u09bf \u0995\u09b0\u09c7\u0964 \u0989\u09a6\u09be\u09b9\u09b0\u09a3\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa, \u09af\u09a6\u09bf \u0986\u09aa\u09a8\u09bf \u09b8\u09cd\u09a5\u09bf\u09b0\u09ad\u09be\u09ac\u09c7 \u09ad\u09be\u09b2\u09cb \u0995\u09b0\u09cd\u09ae\u0995\u09cd\u09b7\u09ae\u09a4\u09be \u09a6\u09c7\u0996\u09be\u09a8, \u09a4\u09be\u09b9\u09b2\u09c7 \u098f\u0986\u0987 \u0986\u09b0\u0993 \u099c\u099f\u09bf\u09b2 \u0986\u0995\u09be\u09b0 \u098f\u09ac\u0982 \u09a6\u09cd\u09b0\u09c1\u09a4 \u0995\u09cd\u09b0\u09ae \u099a\u09be\u09b2\u09c1 \u0995\u09b0\u09ac\u09c7\u0964 \u098f\u0987 \u0995\u09be\u09b8\u09cd\u099f\u09ae\u09be\u0987\u099c\u09a1 \u09aa\u09a6\u09cd\u09a7\u09a4\u09bf \u09b8\u0995\u09b2 \u09a6\u0995\u09cd\u09b7\u09a4\u09be \u09b8\u09cd\u09a4\u09b0\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0997\u09c7\u09ae\u099f\u09bf\u0995\u09c7 \u0986\u0995\u09b0\u09cd\u09b7\u09a3\u09c0\u09af\u09bc \u098f\u09ac\u0982 \u0989\u09aa\u09af\u09c1\u0995\u09cd\u09a4 \u099a\u09cd\u09af\u09be\u09b2\u09c7\u099e\u09cd\u099c\u09bf\u0982 \u09b0\u09be\u0996\u09c7\u0964"}]
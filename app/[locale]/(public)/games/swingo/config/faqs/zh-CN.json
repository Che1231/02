[{"question": "\u521d\u5b66\u8005\u5982\u4f55\u5feb\u901f\u4e0a\u624bSwingo\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u5feb\u901f\u4e0a\u624bSwingo\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u719f\u6089\u4e3b\u83dc\u5355\uff0c\u4ece\u4e2d\u8bbf\u95ee\u4e0d\u540c\u7684\u6e38\u620f\u6a21\u5f0f\u3002\u6b65\u9aa42 - \u5728\u6559\u7a0b\u6a21\u5f0f\u4e2d\u7ec3\u4e60\u57fa\u672c\u79fb\u52a8\u63a7\u5236\uff0c\u5176\u4e2d\u5305\u62ec\u5de6\u53f3\u3001\u4e0a\u4e0b\u6ed1\u52a8\u3002\u6b65\u9aa43 - \u5c1d\u8bd5\u300e\u5feb\u901f\u5339\u914d\u300f\u6a21\u5f0f\uff0c\u5728\u771f\u5b9e\u7684\u6bd4\u8d5b\u573a\u666f\u4e2d\u8fd0\u7528\u6240\u5b66\u77e5\u8bc6\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5feb\u901f\u5339\u914d\u300f\u4e2d\uff0c\u60a8\u9700\u8981\u5feb\u901f\u6ed1\u52a8\u4ee5\u5339\u914d\u989c\u8272\u548c\u5f62\u72b6\u3002\u8fd9\u79cd\u5206\u6b65\u65b9\u6cd5\u786e\u4fdd\u521d\u5b66\u8005\u80fd\u591f\u8f7b\u677e\u4e0a\u624b\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u7406\u89e3Swingo\u7684\u8bc4\u5206\u7cfb\u7edf\u5bf9\u4e8e\u6e38\u620f\u4e2d\u664b\u7ea7\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u7406\u89e3Swingo\u7684\u8bc4\u5206\u7cfb\u7edf\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u76f4\u63a5\u5f71\u54cd\u60a8\u7684\u8fdb\u5ea6\u548c\u6392\u540d\u3002\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u901f\u5ea6\u3001\u51c6\u786e\u6027\u548c\u8fde\u51fb\u500d\u6570\u7684\u7ec4\u5408\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5feb\u901f\u8fde\u7eed\u5339\u914d\u4e09\u4e2a\u5f62\u72b6\uff0c\u60a8\u5c06\u83b7\u5f97\u8fde\u51fb\u500d\u6570\uff0c\u663e\u8457\u63d0\u9ad8\u60a8\u7684\u5f97\u5206\u3002\u4e3a\u4e86\u6700\u5927\u5316\u5f97\u5206\uff0c\u8bf7\u4e13\u6ce8\u4e8e\u521b\u5efa\u66f4\u957f\u7684\u8fde\u51fb\u5e76\u4fdd\u6301\u51c6\u786e\u6027\u3002\u8fd9\u4e9b\u77e5\u8bc6\u6709\u52a9\u4e8e\u60a8\u66f4\u597d\u5730\u5236\u5b9a\u7b56\u7565\uff0c\u5e76\u66f4\u5feb\u5730\u6500\u767b\u6392\u884c\u699c\u3002"}, {"question": "\u638c\u63e1Swingo\u7684\u9ad8\u7ea7\u7b56\u7565\u6709\u54ea\u4e9b\u5173\u952e\u6280\u5de7\uff1f", "answer": "\u638c\u63e1Swingo\u7684\u9ad8\u7ea7\u7b56\u7565\u9700\u8981\u4e00\u4e9b\u5173\u952e\u6280\u5de7\uff1a\u6b65\u9aa41 - \u901a\u8fc7\u89c2\u5bdf\u6a21\u5f0f\u9884\u6d4b\u4e0b\u4e00\u7ec4\u5f62\u72b6\u3002\u6b65\u9aa42 - \u6709\u7b56\u7565\u5730\u4f7f\u7528\u9053\u5177\uff0c\u4f8b\u5982\u300e\u989c\u8272\u70b8\u5f39\u300f\uff0c\u5b83\u53ef\u4ee5\u6e05\u9664\u6240\u6709\u7279\u5b9a\u989c\u8272\u7684\u5f62\u72b6\u3002\u6b65\u9aa43 - \u5728\u300e\u4e13\u5bb6\u6a21\u5f0f\u300f\u4e2d\u7ec3\u4e60\uff0c\u4ee5\u5728\u66f4\u9ad8\u7684\u538b\u529b\u4e0b\u78e8\u7ec3\u60a8\u7684\u6280\u80fd\u3002\u4f8b\u5982\uff0c\u5728\u300e\u4e13\u5bb6\u6a21\u5f0f\u300f\u4e2d\uff0c\u60a8\u5c06\u9047\u5230\u66f4\u5feb\u7684\u5f62\u72b6\u5e8f\u5217\uff0c\u9700\u8981\u66f4\u5feb\u7684\u53cd\u5e94\u901f\u5ea6\u3002\u8fd9\u4e9b\u6b65\u9aa4\u5c06\u5e2e\u52a9\u60a8\u6709\u6548\u5730\u4ece\u65b0\u624b\u8fc7\u6e21\u5230\u9ad8\u7ea7\u73a9\u5bb6\u3002"}, {"question": "\u54ea\u4e9bSwingo\u6e38\u620f\u6a21\u5f0f\u6700\u9002\u5408\u63d0\u9ad8\u53cd\u5e94\u65f6\u95f4\uff1f", "answer": "\u8981\u63d0\u9ad8Swingo\u4e2d\u7684\u53cd\u5e94\u65f6\u95f4\uff0c\u8bf7\u5173\u6ce8\u4ee5\u4e0b\u6e38\u620f\u6a21\u5f0f\uff1a\u300e\u65f6\u95f4\u653b\u51fb\u300f\u548c\u300e\u95ea\u7535\u6a21\u5f0f\u300f\u3002\u300e\u65f6\u95f4\u653b\u51fb\u300f\u6311\u6218\u60a8\u5728\u89c4\u5b9a\u7684\u65f6\u95f4\u5185\u5b8c\u6210\u5c3d\u53ef\u80fd\u591a\u7684\u5339\u914d\uff0c\u8feb\u4f7f\u60a8\u5feb\u901f\u505a\u51fa\u51b3\u7b56\u3002\u300e\u95ea\u7535\u6a21\u5f0f\u300f\u4f1a\u9010\u6b65\u589e\u52a0\u5f62\u72b6\u5e8f\u5217\u7684\u901f\u5ea6\uff0c\u63d0\u5347\u60a8\u7684\u53cd\u5e94\u6781\u9650\u3002\u4f8b\u5982\uff0c\u5728\u300e\u95ea\u7535\u6a21\u5f0f\u300f\u4e2d\uff0c\u60a8\u53ef\u80fd\u4ece\u6162\u901f\u5e8f\u5217\u5f00\u59cb\uff0c\u4f46\u5230\u7b2c5\u7ea7\uff0c\u901f\u5ea6\u4f1a\u53d8\u5f97\u975e\u5e38\u5feb\u3002\u8fd9\u4e9b\u6a21\u5f0f\u975e\u5e38\u9002\u5408\u78e8\u7ec3\u60a8\u7684\u53cd\u5e94\u901f\u5ea6\u3002"}, {"question": "Swingo\u7684\u7b97\u6cd5\u5982\u4f55\u786e\u5b9a\u5f62\u72b6\u5e8f\u5217\u7684\u96be\u5ea6\uff1f", "answer": "Swingo\u7684\u7b97\u6cd5\u6839\u636e\u4ee5\u4e0b\u51e0\u4e2a\u56e0\u7d20\u786e\u5b9a\u5f62\u72b6\u5e8f\u5217\u7684\u96be\u5ea6\uff1a\u73a9\u5bb6\u6280\u80fd\u6c34\u5e73\u3001\u5f53\u524d\u5f97\u5206\u548c\u6e38\u620f\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u5728\u300e\u6e10\u8fdb\u6a21\u5f0f\u300f\u4e2d\uff0c\u968f\u7740\u60a8\u7684\u5f97\u5206\u63d0\u9ad8\uff0c\u7b97\u6cd5\u4f1a\u589e\u52a0\u5f62\u72b6\u548c\u901f\u5ea6\u7684\u590d\u6742\u5ea6\u3002\u8be5\u7cfb\u7edf\u8fd8\u4f1a\u6839\u636e\u60a8\u7684\u8868\u73b0\u8fdb\u884c\u8c03\u6574\uff0c\u786e\u4fdd\u6311\u6218\u7684\u5e73\u8861\u3002\u4e86\u89e3\u6b64\u673a\u5236\u6709\u52a9\u4e8e\u60a8\u9884\u6d4b\u548c\u51c6\u5907\u66f4\u5177\u6311\u6218\u6027\u7684\u5e8f\u5217\uff0c\u4ece\u800c\u589e\u5f3a\u60a8\u7684\u6574\u4f53\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e0a\u5e73\u7a33\u8fd0\u884cSwingo\u9700\u8981\u54ea\u4e9b\u7cfb\u7edf\u8981\u6c42\uff1f", "answer": "\u8981\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e0a\u5e73\u7a33\u8fd0\u884cSwingo\uff0c\u8bf7\u786e\u4fdd\u60a8\u7684\u8bbe\u5907\u6ee1\u8db3\u4ee5\u4e0b\u8981\u6c42\uff1a\u5bf9\u4e8e\u79fb\u52a8\u8bbe\u5907\uff0ciOS 11\u6216\u66f4\u9ad8\u7248\u672c\u4ee5\u53caAndroid 7.0\u6216\u66f4\u9ad8\u7248\u672c\uff0c\u4e14\u81f3\u5c11\u9700\u89812GB\u5185\u5b58\u3002\u5bf9\u4e8ePC\uff0cWindows 10\u6216\u66f4\u9ad8\u7248\u672c\uff0c\u53cc\u6838\u5904\u7406\u5668\u548c4GB\u5185\u5b58\u3002\u4f8b\u5982\uff0c\u5728iPhone 8\u4e0a\uff0cSwingo\u53ef\u572860\u5e27\u6bcf\u79d2\u7684\u901f\u5ea6\u4e0b\u5e73\u7a33\u8fd0\u884c\u3002\u5728\u5b89\u88c5\u4e4b\u524d\u68c0\u67e5\u8fd9\u4e9b\u89c4\u683c\uff0c\u53ef\u4ee5\u5728\u5404\u79cd\u8bbe\u5907\u4e0a\u786e\u4fdd\u6700\u4f73\u6027\u80fd\u548c\u65e0\u5ef6\u8fdf\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5c06Swingo\u7684\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u8bbe\u5907\u8fc1\u79fb\u5230\u53e6\u4e00\u4e2a\u8bbe\u5907\uff1f", "answer": "\u8981\u5c06Swingo\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u8bbe\u5907\u8fc1\u79fb\u5230\u53e6\u4e00\u4e2a\u8bbe\u5907\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u786e\u4fdd\u60a8\u5728\u4e24\u4e2a\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u5e10\u6237\u3002\u6b65\u9aa42 - \u4f7f\u7528\u6e38\u620f\u8bbe\u7f6e\u83dc\u5355\u4e2d\u63d0\u4f9b\u7684\u300e\u4e91\u4fdd\u5b58\u300f\u529f\u80fd\u3002\u6b65\u9aa43 - \u5728\u65b0\u8bbe\u5907\u4e0a\u9009\u62e9\u300e\u4ece\u4e91\u7aef\u52a0\u8f7d\u300f\u6765\u6062\u590d\u60a8\u7684\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u4eceAndroid\u624b\u673a\u5207\u6362\u5230iPad\uff0c\u60a8\u7684\u6210\u5c31\u548c\u5df2\u89e3\u9501\u7684\u5173\u5361\u5c06\u65e0\u7f1d\u5730\u8f6c\u79fb\u3002\u6b64\u8fc7\u7a0b\u786e\u4fdd\u4e86\u60a8\u7684\u6e38\u620f\u4f53\u9a8c\u7684\u8fde\u7eed\u6027\u3002"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728Swingo\u4e2d\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "Swingo\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u529f\u80fd\u548c\u5f69\u86cb\u7b49\u5f85\u73a9\u5bb6\u53d1\u73b0\u3002\u4e00\u4e2a\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\u300e\u91d1\u8272\u5f62\u72b6\u300f\uff0c\u5b83\u4f1a\u968f\u673a\u51fa\u73b0\uff0c\u5e76\u5728\u5339\u914d\u65f6\u63d0\u4f9b\u5927\u91cf\u5f97\u5206\u52a0\u6210\u3002\u6b64\u5916\uff0c\u6309\u4f4f\u300e\u83dc\u5355\u300f\u6309\u94ae 10 \u79d2\u949f\u53ef\u4ee5\u89e3\u9501\u4e00\u4e2a\u79d8\u5bc6\u5c0f\u6e38\u620f\u3002\u4f8b\u5982\uff0c\u5728\u5c0f\u6e38\u620f\u4e2d\uff0c\u60a8\u53ef\u4ee5\u6d4b\u8bd5\u81ea\u5df1\u5728\u72ec\u7279\u7684\u9ad8\u901f\u5339\u914d\u6311\u6218\u4e2d\u7684\u6280\u80fd\u3002\u63a2\u7d22\u8fd9\u4e9b\u9690\u85cf\u5143\u7d20\u4e3a\u6e38\u620f\u4e2d\u589e\u6dfb\u4e86\u989d\u5916\u7684\u5174\u594b\u548c\u53d1\u73b0\u4e50\u8da3\u3002"}, {"question": "Swingo\u4e2d\u7684\u300e\u8fde\u51fb\u94fe\u300f\u673a\u5236\u4e3a\u4ec0\u4e48\u5bf9\u9ad8\u5206\u73a9\u5bb6\u6765\u8bf4\u662f\u6e38\u620f\u6539\u53d8\u8005\uff1f", "answer": "Swingo\u4e2d\u7684\u300e\u8fde\u51fb\u94fe\u300f\u673a\u5236\u4e4b\u6240\u4ee5\u662f\u6e38\u620f\u6539\u53d8\u8005\uff0c\u56e0\u4e3a\u5b83\u4f1a\u968f\u7740\u6bcf\u6b21\u8fde\u7eed\u5339\u914d\u800c\u5448\u6307\u6570\u7ea7\u589e\u52a0\u60a8\u7684\u5f97\u5206\u3002\u4f8b\u5982\uff0c\u8fde\u7eed\u5339\u914d\u56db\u4e2a\u5f62\u72b6\u53ef\u4ee5\u5c06\u60a8\u7684\u57fa\u672c\u5f97\u5206\u7ffb\u500d\uff0c\u800c\u5339\u914d\u4e94\u4e2a\u5f62\u72b6\u53ef\u4ee5\u5c06\u5176\u7ffb\u4e09\u500d\u3002\u4e3a\u4e86\u6700\u5927\u5316\u8fd9\u4e00\u70b9\uff0c\u8bf7\u4e13\u6ce8\u4e8e\u901a\u8fc7\u63d0\u524d\u89c4\u5212\u60a8\u7684\u4e3e\u52a8\u6765\u521b\u5efa\u66f4\u957f\u7684\u8fde\u51fb\u3002\u6b64\u673a\u5236\u4e0d\u4ec5\u4f1a\u63d0\u9ad8\u60a8\u7684\u5f97\u5206\uff0c\u8fd8\u4f1a\u589e\u52a0\u6e38\u620f\u7684\u7b56\u7565\u6df1\u5ea6\uff0c\u8fd9\u5bf9\u4e8e\u8ffd\u6c42\u9ad8\u5206\u7684\u73a9\u5bb6\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "Swingo\u7684\u300e\u81ea\u9002\u5e94AI\u300f\u5982\u4f55\u589e\u5f3a\u521d\u5b66\u8005\u548c\u4e13\u5bb6\u73a9\u5bb6\u7684\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "Swingo\u7684\u300e\u81ea\u9002\u5e94AI\u300f\u901a\u8fc7\u6839\u636e\u60a8\u7684\u8868\u73b0\u52a8\u6001\u8c03\u6574\u6e38\u620f\u96be\u5ea6\u6765\u589e\u5f3a\u73a9\u5bb6\u4f53\u9a8c\u3002\u5bf9\u4e8e\u521d\u5b66\u8005\uff0c\u5b83\u786e\u4fdd\u4e86\u5e73\u7f13\u7684\u5b66\u4e60\u66f2\u7ebf\uff0c\u901a\u8fc7\u5f15\u5165\u66f4\u7b80\u5355\u7684\u5e8f\u5217\u3002\u5bf9\u4e8e\u4e13\u5bb6\uff0c\u5b83\u4f1a\u901a\u8fc7\u590d\u6742\u7684\u6a21\u5f0f\u548c\u66f4\u5feb\u7684\u901f\u5ea6\u6765\u589e\u52a0\u6311\u6218\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u8868\u73b0\u826f\u597d\uff0cAI\u4f1a\u5f15\u5165\u66f4\u590d\u6742\u7684\u5f62\u72b6\u548c\u66f4\u5feb\u7684\u5e8f\u5217\u3002\u8fd9\u79cd\u5b9a\u5236\u65b9\u6cd5\u8ba9\u6e38\u620f\u5bf9\u6240\u6709\u6280\u80fd\u6c34\u5e73\u7684\u73a9\u5bb6\u90fd\u5145\u6ee1\u5438\u5f15\u529b\u548c\u9002\u5f53\u7684\u6311\u6218\u3002"}]
[{"question": "\u5982\u4f55\u8b93\u65b0\u624b\u5feb\u901f\u4e0a\u624bSwingo\u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u958b\u59cb\u4f7f\u7528Swingo\u7684\u57fa\u672c\u63a7\u5236\uff0c\u8acb\u6309\u7167\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u719f\u6089\u4e3b\u9078\u55ae\uff0c\u60a8\u53ef\u4ee5\u5728\u5176\u4e2d\u5b58\u53d6\u4e0d\u540c\u7684\u904a\u6232\u6a21\u5f0f\u3002\u6b65\u9a5f2 - \u5728\u6559\u5b78\u6a21\u5f0f\u4e2d\u7df4\u7fd2\u57fa\u672c\u79fb\u52d5\u63a7\u5236\uff0c\u5176\u4e2d\u5305\u542b\u5de6\u53f3\u3001\u4e0a\u4e0b\u6ed1\u52d5\u3002\u6b65\u9a5f3 - \u5617\u8a66\u300e\u5feb\u901f\u5339\u914d\u300f\u6a21\u5f0f\uff0c\u5c07\u60a8\u5b78\u5230\u7684\u61c9\u7528\u65bc\u771f\u5be6\u904a\u6232\u60c5\u5883\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5feb\u901f\u5339\u914d\u300f\u4e2d\uff0c\u60a8\u9700\u8981\u5feb\u901f\u6ed1\u52d5\u4ee5\u5339\u914d\u984f\u8272\u548c\u5f62\u72c0\u3002\u9019\u7a2e\u5faa\u5e8f\u6f38\u9032\u7684\u65b9\u6cd5\u78ba\u4fdd\u4e86\u65b0\u624b\u80fd\u5920\u9806\u5229\u4e0a\u624b\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u4e86\u89e3Swingo\u7684\u8a08\u5206\u7cfb\u7d71\u5c0d\u65bc\u904a\u6232\u9032\u968e\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u4e86\u89e3Swingo\u7684\u8a08\u5206\u7cfb\u7d71\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u76f4\u63a5\u5f71\u97ff\u60a8\u7684\u9032\u5ea6\u548c\u6392\u540d\u3002\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u901f\u5ea6\u3001\u6e96\u78ba\u6027\u548c\u9023\u64ca\u500d\u6578\u7684\u7d44\u5408\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5feb\u901f\u9023\u7e8c\u5339\u914d\u4e09\u500b\u5f62\u72c0\uff0c\u60a8\u5c07\u7372\u5f97\u9023\u64ca\u500d\u6578\uff0c\u5927\u5e45\u63d0\u5347\u60a8\u7684\u5f97\u5206\u3002\u70ba\u4e86\u6700\u5927\u5316\u5f97\u5206\uff0c\u8acb\u5c08\u6ce8\u65bc\u5275\u9020\u66f4\u9577\u7684\u9023\u64ca\u4e26\u4fdd\u6301\u6e96\u78ba\u6027\u3002\u9019\u9805\u77e5\u8b58\u6709\u52a9\u65bc\u60a8\u66f4\u597d\u5730\u5236\u5b9a\u7b56\u7565\uff0c\u4e26\u66f4\u5feb\u5730\u6500\u5347\u6392\u884c\u699c\u3002"}, {"question": "\u638c\u63e1Swingo\u7684\u9ad8\u968e\u7b56\u7565\u6709\u4ec0\u9ebc\u5fc5\u8981\u7684\u6280\u5de7\uff1f", "answer": "\u638c\u63e1Swingo\u7684\u9ad8\u968e\u7b56\u7565\u9700\u8981\u4e00\u4e9b\u95dc\u9375\u6280\u5de7\uff1a\u6b65\u9a5f1 - \u901a\u904e\u89c0\u5bdf\u6a21\u5f0f\u4f86\u9810\u6e2c\u4e0b\u4e00\u7d44\u5f62\u72c0\u3002\u6b65\u9a5f2 - \u7b56\u7565\u6027\u5730\u4f7f\u7528\u9053\u5177\uff0c\u4f8b\u5982\u300e\u984f\u8272\u70b8\u5f48\u300f\uff0c\u5b83\u53ef\u4ee5\u6e05\u9664\u6240\u6709\u7279\u5b9a\u984f\u8272\u7684\u5f62\u72c0\u3002\u6b65\u9a5f3 - \u5728\u300e\u5c08\u5bb6\u6a21\u5f0f\u300f\u4e2d\u7df4\u7fd2\uff0c\u5728\u66f4\u9ad8\u7684\u58d3\u529b\u4e0b\u78e8\u7df4\u60a8\u7684\u6280\u5de7\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5c08\u5bb6\u6a21\u5f0f\u300f\u4e2d\uff0c\u60a8\u5c07\u9047\u5230\u66f4\u5feb\u7684\u5f62\u72c0\u5e8f\u5217\uff0c\u9700\u8981\u66f4\u5feb\u7684\u53cd\u61c9\u3002\u9019\u4e9b\u6b65\u9a5f\u5c07\u6709\u6548\u5730\u5e6b\u52a9\u60a8\u5f9e\u65b0\u624b\u8f49\u8b8a\u70ba\u9ad8\u7d1a\u73a9\u5bb6\u3002"}, {"question": "\u54ea\u4e9bSwingo\u904a\u6232\u6a21\u5f0f\u6700\u9069\u5408\u7528\u65bc\u63d0\u9ad8\u53cd\u61c9\u6642\u9593\uff1f", "answer": "\u8981\u63d0\u9ad8Swingo\u7684\u53cd\u61c9\u6642\u9593\uff0c\u8acb\u5c08\u6ce8\u65bc\u4ee5\u4e0b\u904a\u6232\u6a21\u5f0f\uff1a\u300e\u6642\u9593\u653b\u64ca\u300f\u548c\u300e\u9583\u96fb\u6a21\u5f0f\u300f\u3002\u300e\u6642\u9593\u653b\u64ca\u300f\u6311\u6230\u60a8\u5728\u9650\u5b9a\u6642\u9593\u5167\u5b8c\u6210\u76e1\u53ef\u80fd\u591a\u7684\u5339\u914d\uff0c\u8feb\u4f7f\u60a8\u5feb\u901f\u505a\u51fa\u6c7a\u7b56\u3002\u300e\u9583\u96fb\u6a21\u5f0f\u300f\u6703\u9010\u6f38\u63d0\u9ad8\u5f62\u72c0\u5e8f\u5217\u7684\u901f\u5ea6\uff0c\u6311\u6230\u60a8\u7684\u53cd\u61c9\u6975\u9650\u3002\u4f8b\u5982\uff0c\u5728\u300e\u9583\u96fb\u6a21\u5f0f\u300f\u4e2d\uff0c\u60a8\u53ef\u80fd\u6703\u5f9e\u6162\u901f\u5e8f\u5217\u958b\u59cb\uff0c\u4f46\u5230\u7b2c 5 \u7d1a\uff0c\u901f\u5ea6\u5c31\u6703\u8b8a\u5f97\u660e\u986f\u66f4\u5feb\u3002\u9019\u4e9b\u6a21\u5f0f\u975e\u5e38\u9069\u5408\u78e8\u7df4\u60a8\u7684\u53cd\u61c9\u901f\u5ea6\u3002"}, {"question": "Swingo\u7684\u6f14\u7b97\u6cd5\u5982\u4f55\u6c7a\u5b9a\u5f62\u72c0\u5e8f\u5217\u7684\u96e3\u5ea6\uff1f", "answer": "Swingo\u7684\u6f14\u7b97\u6cd5\u57fa\u65bc\u591a\u500b\u56e0\u7d20\u4f86\u6c7a\u5b9a\u5f62\u72c0\u5e8f\u5217\u7684\u96e3\u5ea6\uff1a\u73a9\u5bb6\u6280\u80fd\u7b49\u7d1a\u3001\u7576\u524d\u5f97\u5206\u548c\u904a\u6232\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u5728\u300e\u6f38\u9032\u6a21\u5f0f\u300f\u4e2d\uff0c\u96a8\u8457\u60a8\u7684\u5f97\u5206\u63d0\u5347\uff0c\u6f14\u7b97\u6cd5\u6703\u63d0\u9ad8\u5f62\u72c0\u548c\u901f\u5ea6\u7684\u8907\u96dc\u5ea6\u3002\u7cfb\u7d71\u4e5f\u6703\u6839\u64da\u60a8\u7684\u8868\u73fe\u9032\u884c\u8abf\u6574\uff0c\u78ba\u4fdd\u6311\u6230\u5e73\u8861\u3002\u4e86\u89e3\u9019\u500b\u6a5f\u5236\u6709\u52a9\u65bc\u60a8\u9810\u6e2c\u4e26\u6e96\u5099\u597d\u61c9\u5c0d\u66f4\u8271\u96e3\u7684\u5e8f\u5217\uff0c\u589e\u5f37\u60a8\u7684\u6574\u9ad4\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u9806\u5229\u904b\u884cSwingo\u9700\u8981\u54ea\u4e9b\u7cfb\u7d71\u9700\u6c42\uff1f", "answer": "\u8981\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u9806\u5229\u904b\u884cSwingo\uff0c\u8acb\u78ba\u4fdd\u60a8\u7684\u8a2d\u5099\u7b26\u5408\u4ee5\u4e0b\u9700\u6c42\uff1a\u5c0d\u65bc\u884c\u52d5\u88dd\u7f6e\uff0ciOS 11 \u6216\u66f4\u9ad8\u7248\u672c\u548c Android 7.0 \u6216\u66f4\u9ad8\u7248\u672c\uff0c\u4e14\u81f3\u5c11\u9700\u8981 2GB \u8a18\u61b6\u9ad4\u3002\u5c0d\u65bc\u96fb\u8166\uff0cWindows 10 \u6216\u66f4\u9ad8\u7248\u672c\uff0c\u96d9\u6838\u5fc3\u8655\u7406\u5668\u548c 4GB \u8a18\u61b6\u9ad4\u3002\u4f8b\u5982\uff0c\u5728 iPhone 8 \u4e0a\uff0cSwingo \u5728 60 FPS \u4e0b\u904b\u884c\u9806\u66a2\u3002\u5728\u5b89\u88dd\u524d\u6aa2\u67e5\u9019\u4e9b\u898f\u683c\uff0c\u78ba\u4fdd\u5728\u5404\u7a2e\u88dd\u7f6e\u4e0a\u7372\u5f97\u6700\u4f73\u6548\u80fd\u548c\u7121\u5ef6\u9072\u7684\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5c07Swingo\u7684\u904a\u6232\u9032\u5ea6\u5f9e\u4e00\u500b\u8a2d\u5099\u9077\u79fb\u5230\u53e6\u4e00\u500b\u8a2d\u5099\uff1f", "answer": "\u8981\u5c07Swingo\u7684\u904a\u6232\u9032\u5ea6\u5f9e\u4e00\u500b\u8a2d\u5099\u9077\u79fb\u5230\u53e6\u4e00\u500b\u8a2d\u5099\uff0c\u8acb\u6309\u7167\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f 1 - \u78ba\u4fdd\u60a8\u5728\u5169\u500b\u8a2d\u5099\u4e0a\u90fd\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u3002\u6b65\u9a5f 2 - \u4f7f\u7528\u904a\u6232\u8a2d\u5b9a\u9078\u55ae\u4e2d\u53ef\u7528\u7684\u300e\u96f2\u7aef\u5132\u5b58\u300f\u529f\u80fd\u3002\u6b65\u9a5f 3 - \u5728\u65b0\u8a2d\u5099\u4e0a\u9078\u64c7\u300e\u5f9e\u96f2\u7aef\u8f09\u5165\u300f\u4ee5\u6062\u5fa9\u60a8\u7684\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9e Android \u624b\u6a5f\u8f49\u79fb\u5230 iPad\uff0c\u60a8\u7684\u6210\u5c31\u548c\u89e3\u9396\u7684\u7b49\u7d1a\u5c07\u6703\u7121\u7e2b\u8f49\u79fb\u3002\u6b64\u7a0b\u5e8f\u78ba\u4fdd\u4e86\u60a8\u904a\u6232\u9ad4\u9a57\u7684\u9023\u7e8c\u6027\u3002"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728Swingo\u4e2d\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "Swingo \u6709\u4e00\u4e9b\u96b1\u85cf\u529f\u80fd\u548c\u5f69\u86cb\u4f9b\u73a9\u5bb6\u767c\u73fe\u3002\u4e00\u500b\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\u300e\u9ec3\u91d1\u5f62\u72c0\u300f\uff0c\u5b83\u6703\u96a8\u6a5f\u51fa\u73fe\uff0c\u4e26\u5728\u5339\u914d\u6642\u63d0\u4f9b\u5de8\u5927\u7684\u5f97\u5206\u63d0\u5347\u3002\u6b64\u5916\uff0c\u6309\u4f4f\u300e\u9078\u55ae\u300f\u6309\u9215 10 \u79d2\u9418\u6703\u89e3\u9396\u4e00\u500b\u79d8\u5bc6\u5c0f\u904a\u6232\u3002\u4f8b\u5982\uff0c\u5728\u5c0f\u904a\u6232\u4e2d\uff0c\u60a8\u53ef\u4ee5\u6e2c\u8a66\u60a8\u5728\u7368\u7279\u7684\u9ad8\u901f\u914d\u5c0d\u6311\u6230\u4e2d\u7684\u6280\u80fd\u3002\u63a2\u7d22\u9019\u4e9b\u96b1\u85cf\u5143\u7d20\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u984d\u5916\u7684\u523a\u6fc0\u548c\u767c\u73fe\u3002"}, {"question": "Swingo\u4e2d\u7684\u300e\u9023\u64ca\u300f\u6a5f\u5236\u70ba\u4ec0\u9ebc\u5c0d\u65bc\u9ad8\u5206\u73a9\u5bb6\u4f86\u8aaa\u662f\u904a\u6232\u7684\u6539\u8b8a\u8005\uff1f", "answer": "Swingo\u4e2d\u7684\u300e\u9023\u64ca\u300f\u6a5f\u5236\u4e4b\u6240\u4ee5\u662f\u904a\u6232\u7684\u6539\u8b8a\u8005\uff0c\u662f\u56e0\u70ba\u5b83\u6703\u96a8\u8457\u6bcf\u6b21\u9023\u7e8c\u5339\u914d\u5448\u6307\u6578\u7d1a\u5730\u589e\u52a0\u60a8\u7684\u5f97\u5206\u3002\u4f8b\u5982\uff0c\u9023\u7e8c\u5339\u914d\u56db\u500b\u5f62\u72c0\u53ef\u4ee5\u5c07\u60a8\u7684\u57fa\u790e\u5f97\u5206\u52a0\u500d\uff0c\u800c\u5339\u914d\u4e94\u500b\u5f62\u72c0\u53ef\u4ee5\u5c07\u5176\u589e\u52a0\u4e09\u500d\u3002\u70ba\u4e86\u6700\u5927\u5316\u6b64\u6548\u679c\uff0c\u8acb\u5c08\u6ce8\u65bc\u900f\u904e\u898f\u5283\u52d5\u4f5c\u4f86\u5275\u9020\u66f4\u9577\u7684\u9023\u64ca\u3002\u9019\u9805\u6a5f\u5236\u4e0d\u50c5\u6703\u63d0\u9ad8\u60a8\u7684\u5f97\u5206\uff0c\u9084\u6703\u589e\u52a0\u904a\u6232\u7684\u7b56\u7565\u6df1\u5ea6\uff0c\u5c0d\u65bc\u8ffd\u6c42\u9ad8\u5206\u7684\u73a9\u5bb6\u4f86\u8aaa\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "Swingo\u7684\u300e\u81ea\u9069\u61c9AI\u300f\u5982\u4f55\u589e\u5f37\u521d\u5b78\u8005\u548c\u5c08\u5bb6\u73a9\u5bb6\u7684\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "Swingo\u7684\u300e\u81ea\u9069\u61c9AI\u300f\u901a\u904e\u52d5\u614b\u8abf\u6574\u904a\u6232\u96e3\u5ea6\u4f86\u589e\u5f37\u73a9\u5bb6\u7684\u904a\u6232\u9ad4\u9a57\uff0c\u9019\u53d6\u6c7a\u65bc\u60a8\u7684\u8868\u73fe\u3002\u5c0d\u65bc\u521d\u5b78\u8005\uff0c\u5b83\u78ba\u4fdd\u4e86\u5e73\u7de9\u7684\u5b78\u7fd2\u66f2\u7dda\uff0c\u4e26\u5f15\u5165\u4e86\u66f4\u7c21\u55ae\u7684\u5e8f\u5217\u3002\u5c0d\u65bc\u5c08\u5bb6\uff0c\u5b83\u6703\u900f\u904e\u8907\u96dc\u7684\u6a21\u5f0f\u548c\u66f4\u5feb\u7684\u901f\u5ea6\u4f86\u63d0\u5347\u6311\u6230\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u8868\u73fe\u51fa\u8272\uff0cAI \u5c07\u6703\u5f15\u5165\u66f4\u8907\u96dc\u7684\u5f62\u72c0\u548c\u66f4\u5feb\u7684\u5e8f\u5217\u3002\u9019\u7a2e\u91cf\u8eab\u6253\u9020\u7684\u65b9\u6cd5\u8b93\u904a\u6232\u5c0d\u6240\u6709\u6280\u80fd\u7b49\u7d1a\u7684\u73a9\u5bb6\u90fd\u4fdd\u6301\u5438\u5f15\u529b\u548c\u9069\u7576\u7684\u6311\u6230\uff0c"}]
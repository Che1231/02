[{"question": "Swingo\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u3001\u521d\u5fc3\u8005\u306e\u65b9\u3005\u304c\u3059\u3050\u306b\u4f7f\u3044\u3053\u306a\u305b\u308b\u3088\u3046\u306b\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3057\u3087\u3046\u304b\uff1f", "answer": "Swingo\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u3059\u3050\u306b\u4f7f\u3044\u3053\u306a\u3059\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71. \u4e3b\u8981\u30e1\u30cb\u30e5\u30fc\u3092\u899a\u3048\u307e\u3057\u3087\u3046\u3002\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u3078\u306e\u30a2\u30af\u30bb\u30b9\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72. \u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30e2\u30fc\u30c9\u3067\u57fa\u672c\u7684\u306a\u64cd\u4f5c\uff08\u5de6\u3001\u53f3\u3001\u4e0a\u3001\u4e0b\u3078\u306e\u30b9\u30ef\u30a4\u30d7\uff09\u3092\u7df4\u7fd2\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d73. \u5b66\u7fd2\u3057\u305f\u5185\u5bb9\u3092\u5b9f\u969b\u306e\u30b2\u30fc\u30e0\u3067\u9069\u7528\u3059\u308b\u305f\u3081\u306b\u300e\u30af\u30a4\u30c3\u30af\u30de\u30c3\u30c1\u300f\u30e2\u30fc\u30c9\u3092\u8a66\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u300e\u30af\u30a4\u30c3\u30af\u30de\u30c3\u30c1\u300f\u3067\u306f\u3001\u8272\u3084\u5f62\u3092\u5408\u308f\u305b\u308b\u305f\u3081\u306b\u7d20\u65e9\u304f\u30b9\u30ef\u30a4\u30d7\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u306e\u6bb5\u968e\u7684\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u306b\u3088\u308a\u3001\u521d\u5fc3\u8005\u306e\u65b9\u3067\u3082\u30b9\u30e0\u30fc\u30ba\u306b\u5b66\u7fd2\u3067\u304d\u307e\u3059\u3002"}, {"question": "Swingo\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u30b2\u30fc\u30e0\u5185\u3067\u9032\u6b69\u3059\u308b\u305f\u3081\u306b\u306a\u305c\u91cd\u8981\u306a\u306e\u3067\u3057\u3087\u3046\u304b\uff1f", "answer": "Swingo\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u9032\u6b69\u3068\u30e9\u30f3\u30ad\u30f3\u30b0\u306b\u76f4\u63a5\u5f71\u97ff\u3059\u308b\u305f\u3081\u91cd\u8981\u3067\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b9\u30d4\u30fc\u30c9\u3001\u6b63\u78ba\u6027\u3001\u30b3\u30f3\u30dc\u500d\u7387\u306e\u7d44\u307f\u5408\u308f\u305b\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u30013\u3064\u306e\u5f62\u3092\u9023\u7d9a\u3057\u3066\u7d20\u65e9\u304f\u5408\u308f\u305b\u308b\u3068\u3001\u30b3\u30f3\u30dc\u500d\u7387\u3092\u7372\u5f97\u3057\u3001\u30b9\u30b3\u30a2\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002\u30b9\u30b3\u30a2\u3092\u6700\u5927\u9650\u306b\u9ad8\u3081\u308b\u306b\u306f\u3001\u3088\u308a\u9577\u3044\u30b3\u30f3\u30dc\u3092\u4f5c\u6210\u3057\u3001\u6b63\u78ba\u6027\u3092\u7dad\u6301\u3059\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u307e\u3057\u3087\u3046\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u6226\u7565\u3092\u7acb\u3066\u3001\u30e9\u30f3\u30ad\u30f3\u30b0\u3092\u3088\u308a\u901f\u304f\u4e0a\u6607\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Swingo\u306e\u9ad8\u5ea6\u306a\u6226\u7565\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u305f\u3081\u306e\u91cd\u8981\u306a\u30d2\u30f3\u30c8\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Swingo\u306e\u9ad8\u5ea6\u306a\u6226\u7565\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u91cd\u8981\u306a\u30d2\u30f3\u30c8\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71. \u30d1\u30bf\u30fc\u30f3\u3092\u89b3\u5bdf\u3057\u3066\u3001\u6b21\u306e\u5f62\u72b6\u30bb\u30c3\u30c8\u3092\u4e88\u6e2c\u3059\u308b\u3053\u3068\u3092\u5b66\u3073\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d72. \u8272\u306e\u584a\u306e\u3088\u3046\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u3092\u6226\u7565\u7684\u306b\u6d3b\u7528\u3057\u307e\u3057\u3087\u3046\u3002\u3053\u308c\u306f\u7279\u5b9a\u306e\u8272\u3059\u3079\u3066\u306e\u5f62\u72b6\u3092\u6d88\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73. \u3088\u308a\u9ad8\u3044\u30d7\u30ec\u30c3\u30b7\u30e3\u30fc\u306e\u4e2d\u3067\u30b9\u30ad\u30eb\u3092\u7814\u304e\u6f84\u307e\u3059\u305f\u3081\u306b\u3001\u300e\u30a8\u30ad\u30b9\u30d1\u30fc\u30c8\u30e2\u30fc\u30c9\u300f\u3067\u7df4\u7fd2\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u300e\u30a8\u30ad\u30b9\u30d1\u30fc\u30c8\u30e2\u30fc\u30c9\u300f\u3067\u306f\u3001\u3088\u308a\u901f\u3044\u5f62\u72b6\u306e\u30b7\u30fc\u30b1\u30f3\u30b9\u304c\u767a\u751f\u3057\u3001\u3088\u308a\u8fc5\u901f\u306a\u53cd\u5fdc\u304c\u5fc5\u8981\u306b\u306a\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30b9\u30c6\u30c3\u30d7\u3067\u3001\u521d\u5fc3\u8005\u304b\u3089\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u3078\u3068\u52b9\u679c\u7684\u306b\u79fb\u884c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Swingo\u306e\u3069\u306e\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u304c\u3001\u53cd\u5fdc\u6642\u9593\u3092\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u306e\u6700\u9069\u306a\u7df4\u7fd2\u3092\u63d0\u4f9b\u3057\u307e\u3059\u304b\uff1f", "answer": "Swingo\u3067\u53cd\u5fdc\u6642\u9593\u3092\u5411\u4e0a\u3055\u305b\u308b\u306b\u306f\u3001\u6b21\u306e\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u306b\u96c6\u4e2d\u3057\u307e\u3057\u3087\u3046\u3002\u300e\u30bf\u30a4\u30e0\u30a2\u30bf\u30c3\u30af\u300f\u30e2\u30fc\u30c9\u3068\u300e\u30d6\u30e9\u30a4\u30c8\u30e2\u30fc\u30c9\u300f\u3067\u3059\u3002\u300e\u30bf\u30a4\u30e0\u30a2\u30bf\u30c3\u30af\u300f\u3067\u306f\u3001\u8a2d\u5b9a\u3055\u308c\u305f\u6642\u9593\u5185\u306b\u53ef\u80fd\u306a\u9650\u308a\u591a\u304f\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u3092\u884c\u3044\u3001\u8fc5\u901f\u306a\u610f\u601d\u6c7a\u5b9a\u3092\u8feb\u3089\u308c\u307e\u3059\u3002\u300e\u30d6\u30e9\u30a4\u30c8\u30e2\u30fc\u30c9\u300f\u3067\u306f\u3001\u5f62\u72b6\u30b7\u30fc\u30b1\u30f3\u30b9\u306e\u901f\u5ea6\u3092\u6bb5\u968e\u7684\u306b\u901f\u3081\u3001\u3042\u306a\u305f\u306e\u53cd\u5fdc\u9650\u754c\u306b\u6311\u6226\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30d6\u30e9\u30a4\u30c8\u30e2\u30fc\u30c9\u300f\u3067\u306f\u3001\u6700\u521d\u306f\u9045\u3044\u30b7\u30fc\u30b1\u30f3\u30b9\u304b\u3089\u59cb\u307e\u308a\u3001\u30ec\u30d9\u30eb5\u3067\u901f\u5ea6\u304c\u5927\u5e45\u306b\u901f\u304f\u306a\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30e2\u30fc\u30c9\u306f\u3001\u3042\u306a\u305f\u306e\u53cd\u5c04\u795e\u7d4c\u3068\u30b9\u30d4\u30fc\u30c9\u3092\u9ad8\u3081\u308b\u306e\u306b\u6700\u9069\u3067\u3059\u3002"}, {"question": "Swingo\u306e\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u5f62\u72b6\u30b7\u30fc\u30b1\u30f3\u30b9\u306e\u96e3\u6613\u5ea6\u3092\u3069\u306e\u3088\u3046\u306b\u6c7a\u5b9a\u3057\u307e\u3059\u304b\uff1f", "answer": "Swingo\u306e\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u3001\u73fe\u5728\u306e\u30b9\u30b3\u30a2\u3001\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u306a\u3069\u3001\u3044\u304f\u3064\u304b\u306e\u8981\u7d20\u306b\u57fa\u3065\u3044\u3066\u5f62\u72b6\u30b7\u30fc\u30b1\u30f3\u30b9\u306e\u96e3\u6613\u5ea6\u3092\u6c7a\u5b9a\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30d7\u30ed\u30b0\u30ec\u30c3\u30b7\u30d6\u30e2\u30fc\u30c9\u300f\u3067\u306f\u3001\u3042\u306a\u305f\u306e\u30b9\u30b3\u30a2\u304c\u4e0a\u6607\u3059\u308b\u306b\u3064\u308c\u3066\u3001\u5f62\u72b6\u306e\u8907\u96d1\u3055\u3068\u901f\u5ea6\u304c\u5897\u52a0\u3057\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u3042\u306a\u305f\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u3082\u9069\u5fdc\u3057\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u53d6\u308c\u305f\u96e3\u6613\u5ea6\u3092\u7dad\u6301\u3057\u307e\u3059\u3002\u3053\u306e\u4ed5\u7d44\u307f\u3092\u7406\u89e3\u305
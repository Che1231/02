[{"question": "FNF Minus\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "FNF Minus\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc740 \uc74c\uc545\uacfc \uc77c\uce58\ud558\uc5ec \ud654\uc0b4\ud45c \ud0a4(\uc704, \uc544\ub798, \uc67c\ucabd, \uc624\ub978\ucabd)\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub178\ud2b8\ub97c \uce58\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub178\ud2b8\uac00 \ud574\ub2f9 \ud654\uc0b4\ud45c\ub85c \ub0b4\ub824\uc624\uba74 \ud574\ub2f9 \ud0a4\ub97c \ub204\ub974\uc2ed\uc2dc\uc624. \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub824\uba74 \ud0c0\uc774\ubc0d\uc5d0 \uc9d1\uc911\ud558\uc5ec \ub178\ud2b8\uac00 \ud45c\uc2dc\uae30\uc640 \uc815\ub82c\ub420 \ub54c \ud0a4\ub97c \ub204\ub974\uc2ed\uc2dc\uc624. \ud29c\ud1a0\ub9ac\uc5bc \ubaa8\ub4dc\uc5d0\uc11c \uc5f0\uc2b5\ud558\uc5ec \ub9ac\ub4ec\uc5d0 \uc775\uc219\ud574\uc9c0\uc2ed\uc2dc\uc624. \uae30\uc5b5\ud558\uc138\uc694, \ub108\ubb34 \uc774\ub974\uac70\ub098 \ub2a6\uc740 \ub2ff\uae30\ub294 \uc810\uc218\uc5d0 \uc601\ud5a5\uc744 \uc904 \uc218 \uc788\uc73c\ubbc0\ub85c \uc815\ud655\uc131\uc744 \uc704\ud574 \ub178\ub825\ud558\uc2ed\uc2dc\uc624. \ucd08\ubcf4\uc790\uc5d0\uac8c \uc77c\ubc18\uc801\uc778 \ud0a4 \uc7bc\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uac00\ubccd\uac8c \ud0ed\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4."}, {"question": "\uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub85c\uc11c FNF Minus\uc5d0\uc11c \uc815\ud655\uc131\uc744 \ub192\uc774\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "FNF Minus\uc5d0\uc11c \uc815\ud655\uc131\uc744 \ub192\uc774\ub824\uba74 \uafb8\uc900\ud55c \uc5f0\uc2b5\uacfc \uac8c\uc784\uc758 \ub9ac\ub4ec \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud574\uc57c \ud569\ub2c8\ub2e4. \uc790\uc2e0\uac10\uc744 \ud0a4\uc6b0\uae30 \uc704\ud574 \uc26c\uc6b4 \uace1\ubd80\ud130 \uc2dc\uc791\ud558\uc2ed\uc2dc\uc624. \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc5b4\ub824\uc6b4 \ubd80\ubd84\uc744 \ubc18\ubcf5\ud558\uc2ed\uc2dc\uc624. \uc2dc\uac01\uc801\uc778 \ud050\uc5d0 \uc9d1\uc911\ud558\uace0 \ud788\ud2b8 \uc601\uc5ed\uc5d0 \ub3c4\ub2ec\ud558\uae30 \uc804\uc5d0 \ub178\ud2b8\ub97c \uc608\uce21\ud558\ub824\uace0 \ud558\uc2ed\uc2dc\uc624. \uac8c\uc784 \uc678\ubd80\uc5d0\uc11c \uc74c\uc545\uc744 \ub4e4\uc5b4 \ub9ac\ub4ec \ud328\ud134\uc744 \ub0b4\uba74\ud654\ud558\ub294 \uac83\uc774 \uc88b\uc740 \uc804\ub7b5\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ud29c\ud1a0\ub9ac\uc5bc\"\uc774\ub77c\ub294 \ub178\ub798\uc5d0\uc11c \ub178\ud2b8\ub294 \ub4dc\ub7fc \ube44\ud2b8\uc640 \ub3d9\uae30\ud654\ub418\ubbc0\ub85c \ud0a4\ub97c \uce60 \uc2dc\uae30\ub97c \uc608\uce21\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \uae30\ubcf8 \uc124\uc815\uc774 \ubd88\ud3b8\ud558\ub2e4\uba74 \ud0a4\ubcf4\ub4dc\ub098 \ucee8\ud2b8\ub864\ub7ec \uc124\uc815\uc744 \uc870\uc815\ud558\uc2ed\uc2dc\uc624."}, {"question": "FNF Minus\uc5d0\uc11c \uacc4\uc18d \ub178\ud2b8\ub97c \ub193\uce58\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud574\uacb0\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "FNF Minus\uc5d0\uc11c \ub178\ud2b8\ub97c \ub193\uce58\ub294 \uac83\uc740 \uc885\uc885 \ud0c0\uc774\ubc0d\uc774 \uc88b\uc9c0 \uc54a\uac70\ub098 \ub178\ub798\uc758 \ub9ac\ub4ec\uc5d0 \uc775\uc219\ud558\uc9c0 \uc54a\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc774\ub97c \ud574\uacb0\ud558\ub824\uba74 \uba3c\uc800 \ud558\ub4dc\uc6e8\uc5b4\uac00 \ubc18\uc751\uc131\uc774 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uc9c0\uc5f0\uc774 \uc788\ub294 \ud0a4\ubcf4\ub4dc\ub294 \ub204\ub77d\uc744 \uc57c\uae30\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784\uc758 \uc624\ub514\uc624 \ub3d9\uae30\ud654\ub97c \uc124\uc815\uc5d0\uc11c \uc2dc\uc2a4\ud15c\uc758 \uc9c0\uc5f0 \uc2dc\uac04\uacfc \uc77c\uce58\ud558\ub3c4\ub85d \uc870\uc815\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ub178\ud2b8\uac00 \ub2a6\uac8c \uc624\ub294 \uac83 \uac19\uc73c\uba74 \uc624\ud504\uc14b\uc744 \ub298\ub9ac\uc2ed\uc2dc\uc624. \uc5f0\uc2b5 \ubaa8\ub4dc\uc5d0\uc11c \ub178\ub798 \uc18d\ub3c4\ub97c \ub2a6\ucd94\uc5b4 \ub178\ud2b8 \ubc00\ub3c4\uac00 \ub192\uc740 \ubd80\ubd84\uc744 \uc5f0\uc2b5\ud558\uc2ed\uc2dc\uc624. \ub610\ud55c \uc190\uc744 \ud3b8\uc548\ud558\uac8c \uc720\uc9c0\ud558\uc2ed\uc2dc\uc624. \uae34\uc7a5\ud558\uba74 \ud0c0\uc774\ubc0d\uc774 \uc798\ubabb\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2dc\uac04\uc774 \uc9c0\ub0a8\uc5d0 \ub530\ub77c \uadfc\uc721 \uae30\uc5b5\uc774 \ud615\uc131\ub418\uc5b4 \ub204\ub77d \ube48\ub3c4\uac00 \uc904\uc5b4\ub4ed\ub2c8\ub2e4."}, {"question": "FNF Minus\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uae30 \uc704\ud574 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \uace0\uae09 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "FNF Minus\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc73c\ub824\uba74 \uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \ucf64\ubcf4 \uccb4\uc778\uc744 \uc720\uc9c0\ud558\uace0 \uacf1\uc148\uae30\ub97c \uadf9\ub300\ud654\ud558\ub294 \ub370 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. STEP1: \ucf64\ubcf4\ub97c \ub04a\uc9c0 \uc54a\uace0 \uc5f0\uc18d\uc801\uc73c\ub85c \ub178\ud2b8\ub97c \uce58\ub294 \uac83\uc744 \uc6b0\uc120\uc2dc\ud574\uc57c \ud569\ub2c8\ub2e4. STEP2: \ub178\ud2b8\ub97c \uc644\ubcbd\ud558\uac8c \uce58\uace0 \uc810\uc218\uc5d0 \ub354 \ub9ce\uc740 \uae30\uc5ec\ub97c \ud558\ub294 \"Sick\" \ub4f1\uae09\uc744 \ubaa9\ud45c\ub85c \ud558\uc2ed\uc2dc\uc624. STEP3: \ud398\ub110\ud2f0 \uc5c6\uc774 \uc5f0\uc2b5\ud560 \uc218 \uc788\ub294 \"\uace0\uc2a4\ud2b8 \ud0ed\" \uae30\ub2a5\uc744 \ud65c\uc6a9\ud558\uc5ec \ud0c0\uc774\ubc0d\uc744 \uac1c\uc120\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc0ac\uc6b0\uc2a4\"\ub77c\ub294 \ub178\ub798\uc5d0\uc11c \ube60\ub978 \ub178\ud2b8 \uc2dc\ud000\uc2a4\ub294 \ud328\ud134\uc744 \uc608\uce21\ud558\uace0 \uafb8\uc900\ud788 \uc5f0\uc2b5\ud558\uc5ec \uc219\ub2ec\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \ubc18\uc751 \uc2dc\uac04\uc744 \uc904\uc774\uae30 \uc704\ud574 \ucc28\ud2b8 \ud328\ud134\uc744 \ube60\ub974\uac8c \uc77d\ub294 \ubc95\uc744 \ubc30\uc6b0\uc2ed\uc2dc\uc624."}, {"question": "FNF Minus\uc5d0\uc11c \ube60\ub974\uac8c \uc9c4\ud589\ub418\ub294 \ub178\ub798\ub97c \ucf64\ubcf4\ub97c \ub193\uce58\uc9c0 \uc54a\uace0 \uc5b4\ub5bb\uac8c \ucc98\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "FNF Minus\uc5d0\uc11c \ube60\ub974\uac8c \uc9c4\ud589\ub418\ub294 \ub178\ub798\ub97c \ucc98\ub9ac\ud558\ub824\uba74 \uc5f0\uc2b5\uacfc \uc804\ub7b5\uc758 \uc870\ud569\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \uc5ec\ub7ec \ubc88 \ub178\ub798\ub97c \ub4e4\uc5b4 \ub178\ub798\uc758 \ub9ac\ub4ec\uc5d0 \uc775\uc219\ud574\uc9c0\uc2ed\uc2dc\uc624. STEP2: \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub178\ub798 \uc18d\ub3c4\ub97c \ub2a6\ucd94\uace0 \uc790\uc2e0\uac10\uc744 \uc5bb\ub294 \ub300\ub85c \uc810\ucc28 \uc18d\ub3c4\ub97c \ub192\uc774\uc2ed\uc2dc\uc624. STEP3: \uc804\uccb4 \ud2b8\ub799 \ub300\uc2e0 \ub178\ub798\uc758 \uc791\uc740 \ubd80\ubd84\uc5d0 \uc9d1\uc911\ud558\uc5ec \uad00\ub9ac \uac00\ub2a5\ud55c \ubd80\ubd84\uc73c\ub85c \ub098\ub215\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"M.I.L.F\"\uc5d0\uc11c \ud6c4\ub834\uad6c\ub294 \ube60\ub978 \uc77c\ub828\uc758 \ub178\ud2b8\ub97c \uac00\uc9c0\uace0 \uc788\uc73c\uba70, \uc774 \ubd80\ubd84\uc744 \ubd84\ub9ac\ud558\uace0 \ubc18\ubcf5\ud558\uc5ec \uc219\ub2ec\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \uc190\uac00\ub77d\uc744 \ud3b8\uc548\ud558\uac8c \uc720\uc9c0\ud558\uc5ec \uc18d\ub3c4\uc640 \uc815\ud655\uc131\uc744 \uc720\uc9c0\ud558\uc2ed\uc2dc\uc624."}, {"question": "FNF Minus\uc5d0\uc11c \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\uae30 \uc704\ud55c \ucd5c\uc0c1\uc758 \uc124\uc815\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "FNF Minus\uc5d0\uc11c \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uac8c\uc784 \ub0b4 \ubc0f \uc2dc\uc2a4\ud15c \uc124\uc815 \ubaa8\ub450\ub97c \uc870\uc815\ud574\uc57c \ud569\ub2c8\ub2e4. \uac8c\uc784 \ub0b4\uc5d0\uc11c \ub178\ud2b8 \uc18d\ub3c4\ub97c \ud3b8\uc548\ud55c \uc218\uc900\uc73c\ub85c \uc870\uc815\ud558\uc2ed\uc2dc\uc624. \uc18d\ub3c4\uac00 \ube60\ub974\uba74 \ud63c\ub780\uc774 \uc904\uc5b4\ub4e4 \uc218 \uc788\uc9c0\ub9cc \ub354 \ube60\ub978 \ubc18\uc0ac \uc2e0\uacbd\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc624\ub514\uc624 \ub3d9\uae30\ub97c \uc870\uc815\ud558\uc5ec \uc785\ub825 \uc9c0\uc5f0\uc744 \ucd5c\uc18c\ud654\ud558\uc2ed\uc2dc\uc624. \uc2dc\uc2a4\ud15c \uce21\uba74\uc5d0\uc11c \ucef4\ud4e8\ud130\uac00 \uac8c\uc784\uc758 \ucd5c\uc18c \uc694\uad6c \uc0ac\ud56d\uc744 \ucda9\uc871\ud558\uace0 \ubc31\uadf8\ub77c\uc6b4\ub4dc \uc751\uc6a9 \ud504\ub85c\uadf8\ub7a8\uc744 \ub2eb\uc544 \ub9ac\uc18c\uc2a4\ub97c \ud655\ubcf4\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub178\ud2b8 \uc18d\ub3c4\ub97c 1.5\ubc30\ub85c \uc124\uc815\ud558\uba74 \"\uc8fc\uac04 7\"\uc758 \ub178\ub798\uc5d0\uc11c \ub178\ud2b8\uac00 \ud37c\uc838 \ub098\uac00\ubbc0\ub85c \uad00\ub9ac\ud558\uae30\uac00 \ub354 \uc26c\uc6cc\uc9d1\ub2c8\ub2e4. \ub610\ud55c \uc720\uc120 \ud0a4\ubcf4\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc785\ub825 \uc9c0\uc5f0\uc744 \uc904\uc774\uba74 \uc815\ud655\uc131\uc744 \uc720\uc9c0\ud558\ub294 \ub370 \uc911\uc694\ud569\ub2c8\ub2e4."}, {"question": "FNF Minus\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \ucd5c\uc885 \uc810\uc218\uc5d0 \uc5b4\ub5a4 \uc694\uc18c\uac00 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "FNF Minus\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ub178\ud2b8 \ud788\ud2b8\uc758 \uc815\ud655\uc131\uacfc \ud0c0\uc774\ubc0d\uc744 \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. \uac01 \ub178\ud2b8\ub294 \"Sick\"(\uc644\ubcbd), \"Good\", \"Bad\", \"Shit\" \ub4f1\uae09\uc744 \uac00\uc9c0\uba70, \"Sick\"\uc740 \uc810\uc218\uc5d0 \uac00\uc7a5 \ud070 \uae30\uc5ec\ub97c \ud569\ub2c8\ub2e4. \ucf64\ubcf4 \uccb4\uc778\uc740 \uc810\uc218\ub97c \uacf1\ud558\uae30 \ub54c\ubb38\uc5d0 \ub192\uc740 \ucf64\ubcf4\ub97c \uc720\uc9c0\ud558\ub294 \uac83\uc774 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc8fc\uac04 4\"\uc5d0\uc11c \ubaa8\ub4e0 \ub178\ud2b8\ub97c \"Sick\" \ub4f1\uae09\uc73c\ub85c \uce58\uba74 \ucd5c\uc885 \uc810\uc218\uac00 \ud06c\uac8c \ub192\uc544\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \ub178\ud2b8\ub97c \ub193\uce58\uac70\ub098 \ucf64\ubcf4\ub97c \uae68\uba74 \uc810\uc218\uac00 \ub0ae\uc544\uc9d1\ub2c8\ub2e4. \uac8c\uc784\uc740 \ub610\ud55c \ub108\ubb34 \uc774\ub974\uac70\ub098 \ub2a6\uc740 \ud788\ud2b8\ub97c \ud398\ub110\ud2f0\ub85c \ubd80\uacfc\ud558\ubbc0\ub85c \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uc740 \uc810\uc218 \uadf9\ub300\ud654\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4."}, {"question": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c FNF Minus\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud604\uc7ac FNF Minus\ub294 \ub2e4\ub978 \ud50c\ub7ab\ud3fc \uac04\uc758 \uc9c4\ud589 \uc0c1\ud669 \uc804\uc1a1\uc744 \uc9c0\uc6d0\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uac8c\uc784 \ub370\uc774\ud130(\uc810\uc218 \ubc0f \uc7a0\uae08 \ud574\uc81c\ub41c \ucf58\ud150\uce20 \ud3ec\ud568)\ub294 \ud50c\ub808\uc774\ud558\ub294 \uae30\uae30\uc758 \ub85c\uceec\uc5d0 \uc800\uc7a5\ub429\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \ub3d9\uc77c\ud55c \uc6b4\uc601 \uccb4\uc81c\ub97c \uc0ac\uc6a9\ud558\ub294 \uacbd\uc6b0 \uac8c\uc784 \uc800\uc7a5 \ud30c\uc77c\uc744 \uc218\ub3d9\uc73c\ub85c \ubc31\uc5c5\ud558\uc5ec \ub2e4\ub978 \uae30\uae30\uc5d0 \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, Windows\uc5d0\uc11c \uac8c\uc784 \ub514\ub809\ud130\ub9ac\uc5d0\uc11c \uc800\uc7a5 \ud30c\uc77c\uc744 \ucc3e\uc544 \ub2e4\ub978 PC\uc5d0 \ubcf5\uc0ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \ud504\ub85c\uc138\uc2a4\uc5d0\ub294 \uae30\uc220\uc801 \uc9c0\uc2dd\uc774 \ud544\uc694\ud558\uace0 \uacf5\uc2dd\uc801\uc73c\ub85c \uc9c0\uc6d0\ub418\uc9c0 \uc54a\uc744 \uc218 \uc788\uc73c\ubbc0\ub85c \ub370\uc774\ud130 \uc190\uc2e4\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uc8fc\uc758\ud558\uc5ec \uc9c4\ud589\ud558\uc2ed\uc2dc\uc624."}, {"question": "\"FNF Minus\"\uc5d0 \uc8fc\ubaa9\ud574\uc57c \ud560 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8 \ub610\ub294 \ube44\ubc00\uc774 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub124, FNF Minus\uc5d0\ub294 \uac8c\uc784\uc5d0 \uae4a\uc774\ub97c \ub354\ud558\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uc640 \ube44\ubc00\uc774 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc8fc\uac04 3\"\uc5d0\uc11c \"Philly Nice\"\uc5d0\uc11c \uc644\ubcbd\ud55c \ucf64\ubcf4\ub97c \ub2ec\uc131\ud558\uba74 \ud2b9\ubcc4\ud55c \uc560\ub2c8\uba54\uc774\uc158 \ubc0f \ub300\ud654 \uc2dc\ud000\uc2a4\uac00 \ud2b8\ub9ac\uac70\ub418\uc5b4 \ucd94\uac00\uc801\uc778 \ubc30\uacbd \uc774\uc57c\uae30\ub97c \ub4dc\ub7ec\ub0c5\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uc608\ub294 \uba54\uc778 \uba54\ub274\uc5d0\uc11c \ud2b9\uc815 \ucf54\ub4dc\ub97c \uc785\ub825\ud558\uba74 \uc561\uc138\uc2a4\ud560 \uc218 \uc788\ub294 \"\ud14c\uc2a4\ud2b8\" \ubaa8\ub4dc\uc785\ub2c8\ub2e4. \uc774 \ubaa8\ub4dc\ub97c \ud1b5\ud574 \uc0ac\uc6a9\uc790 \uc815\uc758 \ub178\ud2b8 \ud328\ud134\uc744 \uc2e4\ud5d8\ud574 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ube44\ubc00\uc744 \ud0d0\uc0c9\ud558\uba74 \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uace0 \uac8c\uc784 \uac1c\ubc1c \ubc0f \uc2a4\ud1a0\ub9ac\uc5d0 \ub300\ud55c \ud1b5\ucc30\ub825\uc744 \uc81c\uacf5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
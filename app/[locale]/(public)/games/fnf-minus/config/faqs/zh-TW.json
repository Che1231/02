[{"question": "FNF Minus \u7684\u57fa\u672c\u63a7\u5236\u6309\u9375\u662f\u4ec0\u9ebc\uff1f\u5982\u4f55\u6709\u6548\u5730\u4f7f\u7528\u5b83\u5011\uff1f", "answer": "\u5728 FNF Minus \u4e2d\uff0c\u57fa\u672c\u63a7\u5236\u6309\u9375\u4f7f\u7528\u65b9\u5411\u9375\uff08\u4e0a\u3001\u4e0b\u3001\u5de6\u3001\u53f3\uff09\u6309\u6642\u64ca\u4e2d\u6a02\u8b5c\u4e0a\u7684\u97f3\u7b26\u3002\u4f8b\u5982\uff0c\u7576\u97f3\u7b26\u6efe\u52d5\u5230\u5c0d\u61c9\u7684\u7bad\u982d\u6642\uff0c\u6309\u4e0b\u8a72\u9375\u3002\u8981\u6709\u6548\u5730\u4f7f\u7528\u5b83\u5011\uff0c\u9996\u5148\u8981\u5c08\u6ce8\u65bc\u7bc0\u594f\uff1b\u7576\u97f3\u7b26\u8207\u6307\u6a19\u5c0d\u9f4a\u6642\u6309\u4e0b\u76f8\u61c9\u7684\u9375\u3002\u5728\u6559\u5b78\u6a21\u5f0f\u4e2d\u7df4\u7fd2\uff0c\u4ee5\u7fd2\u6163\u7bc0\u594f\u3002\u8acb\u8a18\u4f4f\uff0c\u63d0\u524d\u6216\u5ef6\u9072\u64ca\u6253\u97f3\u7b26\u6703\u5f71\u97ff\u5f97\u5206\uff0c\u56e0\u6b64\u52d9\u6c42\u6e96\u78ba\u3002\u4e00\u500b\u6709\u5e6b\u52a9\u7684\u6280\u5de7\u662f\u8f15\u8f15\u9ede\u64ca\uff0c\u4ee5\u907f\u514d\u521d\u5b78\u8005\u5e38\u898b\u7684\u6309\u9375\u5361\u4f4f\u7684\u554f\u984c\u3002"}, {"question": "\u4f5c\u70ba\u65b0\u73a9\u5bb6\uff0c\u5982\u4f55\u63d0\u9ad8\u5728 FNF Minus \u4e2d\u7684\u6e96\u78ba\u6027\uff1f", "answer": "\u63d0\u9ad8 FNF Minus \u4e2d\u7684\u6e96\u78ba\u6027\uff0c\u9700\u8981\u6301\u7e8c\u7df4\u7fd2\u4e26\u7406\u89e3\u904a\u6232\u7684\u7bc0\u594f\u6a5f\u5236\u3002\u9996\u5148\uff0c\u5f9e\u8f03\u5bb9\u6613\u7684\u6b4c\u66f2\u958b\u59cb\uff0c\u5efa\u7acb\u4fe1\u5fc3\u3002\u4f7f\u7528\u7df4\u7fd2\u6a21\u5f0f\u91cd\u64ad\u6311\u6230\u6027\u6bb5\u843d\u3002\u5c08\u6ce8\u65bc\u8996\u89ba\u63d0\u793a\uff0c\u4e26\u5617\u8a66\u5728\u97f3\u7b26\u5230\u9054\u64ca\u6253\u5340\u57df\u4e4b\u524d\u9810\u6e2c\u97f3\u7b26\u3002\u4e00\u500b\u597d\u7b56\u7565\u662f\u807d\u904a\u6232\u5916\u7684\u97f3\u6a02\uff0c\u5167\u5316\u7bc0\u62cd\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u5728\u300e\u6559\u5b78\u300f\u6b4c\u66f2\u4e2d\uff0c\u97f3\u7b26\u8207\u9f13\u9ede\u540c\u6b65\uff0c\u9019\u53ef\u4ee5\u5e6b\u52a9\u4f60\u9810\u6e2c\u4f55\u6642\u6309\u4e0b\u9375\u76e4\u3002\u6b64\u5916\uff0c\u5982\u679c\u89ba\u5f97\u9810\u8a2d\u8a2d\u7f6e\u4e0d\u8212\u9069\uff0c\u8acb\u8abf\u6574\u4f60\u7684\u9375\u76e4\u6216\u63a7\u5236\u5668\u8a2d\u7f6e\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u5728 FNF Minus \u4e2d\u4e0d\u65b7\u932f\u904e\u97f3\u7b26\uff1f\u5982\u4f55\u89e3\u6c7a\u9019\u500b\u554f\u984c\uff1f", "answer": "\u5728 FNF Minus \u4e2d\u932f\u904e\u97f3\u7b26\uff0c\u901a\u5e38\u662f\u7531\u65bc\u7bc0\u594f\u638c\u63e1\u4e0d\u597d\u6216\u4e0d\u719f\u6089\u6b4c\u66f2\u7684\u7bc0\u594f\u3002\u70ba\u4e86\u89e3\u6c7a\u9019\u500b\u554f\u984c\uff0c\u9996\u5148\u78ba\u4fdd\u4f60\u7684\u786c\u9ad4\u53cd\u61c9\u9748\u654f\uff1b\u9375\u76e4\u5ef6\u9072\u6703\u5c0e\u81f4\u932f\u904e\u97f3\u7b26\u3002\u5728\u8a2d\u5b9a\u4e2d\u6821\u6e96\u904a\u6232\u7684\u97f3\u8a0a\u540c\u6b65\uff0c\u4ee5\u5339\u914d\u4f60\u7684\u7cfb\u7d71\u5ef6\u9072\u3002\u4f8b\u5982\uff0c\u5982\u679c\u97f3\u7b26\u4f3c\u4e4e\u4f86\u665a\u4e86\uff0c\u8acb\u589e\u52a0\u504f\u79fb\u91cf\u3002\u5728\u7df4\u7fd2\u6a21\u5f0f\u4e2d\uff0c\u900f\u904e\u964d\u4f4e\u6b4c\u66f2\u901f\u5ea6\u4f86\u7df4\u7fd2\u9ad8\u5bc6\u5ea6\u97f3\u7b26\u6bb5\u843d\u3002\u6b64\u5916\uff0c\u8a66\u8457\u653e\u9b06\u4f60\u7684\u624b\uff1b\u624b\u90e8\u7dca\u5f35\u6703\u5c0e\u81f4\u6309\u9375\u5931\u8aa4\u3002\u96a8\u8457\u6642\u9593\u63a8\u79fb\uff0c\u808c\u8089\u8a18\u61b6\u6703\u9010\u6f38\u5f62\u6210\uff0c\u6e1b\u5c11\u932f\u904e\u97f3\u7b26\u7684\u983b\u7387\u3002"}, {"question": "\u5728 FNF Minus \u4e2d\uff0c\u6211\u53ef\u4ee5\u4f7f\u7528\u54ea\u4e9b\u9ad8\u7d1a\u7b56\u7565\u4f86\u7372\u5f97\u9ad8\u5206\uff1f", "answer": "\u5728 FNF Minus \u4e2d\u7372\u5f97\u9ad8\u5206\uff0c\u9ad8\u7d1a\u73a9\u5bb6\u61c9\u8a72\u5c08\u6ce8\u65bc\u7dad\u6301\u9023\u64ca\u548c\u6700\u5927\u5316\u500d\u6578\u3002\u6b65\u9a5f\u4e00\uff1a\u512a\u5148\u9023\u7e8c\u64ca\u4e2d\u97f3\u7b26\uff0c\u4e0d\u9593\u65b7\u9023\u64ca\u3002\u6b65\u9a5f\u4e8c\uff1a\u900f\u904e\u5b8c\u7f8e\u64ca\u4e2d\u97f3\u7b26\uff0c\u76ee\u6a19\u662f\u9054\u5230\u300c\u51fa\u8272\u300d\u8a55\u7d1a\uff08Sick\uff09\uff0c\u56e0\u70ba\u5b83\u5011\u5c0d\u4f60\u7684\u5206\u6578\u8ca2\u737b\u66f4\u5927\u3002\u6b65\u9a5f\u4e09\uff1a\u5229\u7528\u300c\u9b3c\u64ca\u300d\u529f\u80fd\u4f86\u7df4\u7fd2\uff0c\u6c92\u6709\u61f2\u7f70\uff0c\u8b93\u4f60\u7cbe\u7149\u4f60\u7684\u7bc0\u594f\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5357\u300f\u6b4c\u66f2\u4e2d\uff0c\u5feb\u901f\u97f3\u7b26\u5e8f\u5217\u53ef\u4ee5\u900f\u904e\u9810\u6e2c\u6a21\u5f0f\u4e26\u6301\u7e8c\u7df4\u7fd2\u4f86\u638c\u63e1\u3002\u6b64\u5916\uff0c\u5feb\u901f\u95b1\u8b80\u8b5c\u9762\u6a21\u5f0f\uff0c\u4ee5\u6e1b\u5c11\u53cd\u61c9\u6642\u9593\u3002"}, {"question": "\u5982\u4f55\u5728 FNF Minus \u7684\u5feb\u7bc0\u594f\u6b4c\u66f2\u4e2d\u7dad\u6301\u9023\u64ca\uff1f", "answer": "\u5728 FNF Minus \u4e2d\u8655\u7406\u5feb\u7bc0\u594f\u6b4c\u66f2\uff0c\u9700\u8981\u7d50\u5408\u7df4\u7fd2\u548c\u7b56\u7565\u3002\u6b65\u9a5f\u4e00\uff1a\u53cd\u8986\u8046\u807d\u6b4c\u66f2\uff0c\u719f\u6089\u6b4c\u66f2\u7684\u7bc0\u594f\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u7df4\u7fd2\u6a21\u5f0f\uff0c\u5c07\u6b4c\u66f2\u901f\u5ea6\u653e\u6162\uff0c\u4e26\u5728\u719f\u6089\u5f8c\u9010\u6f38\u63d0\u9ad8\u901f\u5ea6\u3002\u6b65\u9a5f\u4e09\uff1a\u5c08\u6ce8\u65bc\u6b4c\u66f2\u8f03\u5c0f\u7684\u90e8\u5206\uff0c\u800c\u4e0d\u662f\u6574\u500b\u6b4c\u66f2\uff0c\u5c07\u5176\u5206\u89e3\u6210\u53ef\u7ba1\u7406\u7684\u90e8\u5206\u3002\u4f8b\u5982\uff0c\u5728\u300eM.I.L.F\u300f\u6b4c\u66f2\u4e2d\uff0c\u526f\u6b4c\u6709\u5feb\u901f\u7684\u97f3\u7b26\u5e8f\u5217\uff0c\u53ef\u4ee5\u900f\u904e\u9694\u96e2\u548c\u91cd\u8907\u8a72\u90e8\u5206\u4f86\u638c\u63e1\u3002\u6b64\u5916\uff0c\u78ba\u4fdd\u4f60\u7684\u624b\u6307\u653e\u9b06\uff0c\u4ee5\u4fdd\u6301\u901f\u5ea6\u548c\u6e96\u78ba\u6027\u3002"}, {"question": "\u5728 FNF Minus \u4e2d\uff0c\u54ea\u4e9b\u8a2d\u5b9a\u6700\u9069\u5408\u512a\u5316\u6548\u80fd\uff1f", "answer": "\u5728 FNF Minus \u4e2d\u512a\u5316\u6548\u80fd\uff0c\u6d89\u53ca\u8abf\u6574\u904a\u6232\u5167\u548c\u7cfb\u7d71\u8a2d\u5b9a\u3002\u5728\u904a\u6232\u5167\uff0c\u8abf\u6574\u97f3\u7b26\u901f\u5ea6\u5230\u8212\u9069\u7684\u6c34\u5e73\uff1b\u8f03\u5feb\u7684\u901f\u5ea6\u53ef\u4ee5\u6e1b\u5c11\u96dc\u8a0a\uff0c\u4f46\u9700\u8981\u66f4\u5feb\u7684\u53cd\u61c9\u901f\u5ea6\u3002\u6821\u6e96\u97f3\u8a0a\u540c\u6b65\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u6e1b\u5c11\u8f38\u5165\u5ef6\u9072\u3002\u5728\u7cfb\u7d71\u7aef\uff0c\u78ba\u4fdd\u4f60\u7684\u96fb\u8166\u7b26\u5408\u904a\u6232\u7684\u6700\u4f4e\u9700\u6c42\uff0c\u4e26\u95dc\u9589\u80cc\u666f\u61c9\u7528\u7a0b\u5f0f\uff0c\u91cb\u653e\u8cc7\u6e90\u3002\u4f8b\u5982\uff0c\u5c07\u97f3\u7b26\u901f\u5ea6\u8a2d\u5b9a\u70ba1.5\u500d\u901f\uff0c\u53ef\u4ee5\u8b93\u300e\u7b2c\u4e03\u9031\u300f\u6b4c\u66f2\u66f4\u5bb9\u6613\u8655\u7406\uff0c\u56e0\u70ba\u5b83\u4f7f\u97f3\u7b26\u66f4\u5206\u6563\u3002\u6b64\u5916\uff0c\u4f7f\u7528\u6709\u7dda\u9375\u76e4\u4ee5\u6e1b\u5c11\u8f38\u5165\u5ef6\u9072\uff0c\u9019\u5c0d\u65bc\u7dad\u6301\u6e96\u78ba\u6027\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "FNF Minus \u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u6211\u7684\u6700\u7d42\u5f97\u5206\uff1f", "answer": "FNF Minus \u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u97f3\u7b26\u64ca\u4e2d\u7684\u6e96\u78ba\u6027\u548c\u7bc0\u594f\u3002\u6bcf\u500b\u97f3\u7b26\u90fd\u6709\u8a55\u7d1a\uff1a\u300e\u51fa\u8272\u300f (\u5b8c\u7f8e)\u3001\u300e\u826f\u597d\u300f\u3001\u300e\u4e0d\u597d\u300f\u548c\u300e\u721b\u300f\uff0c\u5176\u4e2d\u300e\u51fa\u8272\u300f\u5c0d\u4f60\u7684\u5206\u6578\u8ca2\u737b\u6700\u5927\u3002\u9023\u64ca\u4e5f\u6703\u4e58\u4ee5\u4f60\u7684\u5206\u6578\uff0c\u56e0\u6b64\u7dad\u6301\u9ad8\u9023\u64ca\u81f3\u95dc\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5728\u300e\u7b2c\u56db\u9031\u300f\u4e2d\uff0c\u7528\u300e\u51fa\u8272\u300f\u8a55\u7d1a\u64ca\u4e2d\u6240\u6709\u97f3\u7b26\uff0c\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u4f60\u7684\u6700\u7d42\u5f97\u5206\u3002\u6b64\u5916\uff0c\u932f\u904e\u97f3\u7b26\u6216\u6253\u7834\u9023\u64ca\u6703\u964d\u4f4e\u4f60\u7684\u5f97\u5206\u3002\u904a\u6232\u4e5f\u6703\u61f2\u7f70\u63d0\u524d\u6216\u5ef6\u9072\u64ca\u6253\uff0c\u56e0\u6b64\u6e96\u78ba\u7684\u7bc0\u594f\u5c0d\u65bc\u6700\u5927\u5316\u4f60\u7684\u5206\u6578\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5c07 FNF Minus \u7684\u9032\u5ea6\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u9593\u8f49\u79fb\u55ce\uff1f", "answer": "\u76ee\u524d\uff0cFNF Minus \u4e0d\u652f\u63f4\u8de8\u5e73\u53f0\u9032\u5ea6\u8f49\u79fb\u3002\u4f60\u7684\u904a\u6232\u8cc7\u6599\uff0c\u5305\u62ec\u5f97\u5206\u548c\u89e3\u9396\u5167\u5bb9\uff0c\u5132\u5b58\u5728\u4f60\u6b63\u5728\u4f7f\u7528\u7684\u88dd\u7f6e\u7684\u672c\u5730\u7aef\u3002\u4e0d\u904e\uff0c\u4f60\u53ef\u4ee5\u624b\u52d5\u5099\u4efd\u4f60\u7684\u5132\u5b58\u6a94\uff0c\u4e26\u5c07\u5176\u8f49\u79fb\u5230\u53e6\u4e00\u88dd\u7f6e\uff0c\u5982\u679c\u5169\u8005\u90fd\u904b\u884c\u76f8\u540c\u7684\u4f5c\u696d\u7cfb\u7d71\u3002\u4f8b\u5982\uff0c\u5728 Windows \u4e0a\uff0c\u4f60\u53ef\u4ee5\u627e\u5230\u904a\u6232\u8cc7\u6599\u593e\u4e2d\u7684\u5132\u5b58\u6a94\u6848\uff0c\u4e26\u5c07\u5176\u8907\u88fd\u5230\u53e6\u4e00\u53f0\u96fb\u8166\u3002\u8acb\u52d9\u5fc5\u6ce8\u610f\uff0c\u6b64\u904e\u7a0b\u9700\u8981\u6280\u8853\u77e5\u8b58\uff0c\u4e14\u53ef\u80fd\u672a\u7372\u5f97\u5b98\u65b9\u652f\u63f4\uff0c\u56e0\u6b64\u8acb\u8b39\u614e\u884c\u4e8b\uff0c\u907f\u514d\u8cc7\u6599\u907a\u5931\u3002"}, {"question": "FNF Minus \u4e2d\u662f\u5426\u6709\u4efb\u4f55\u96b1\u85cf\u7684\u5f69\u86cb\u6216\u79d8\u5bc6\uff1f", "answer": "\u662f\u7684\uff0cFNF Minus \u5305\u542b\u5e7e\u500b\u96b1\u85cf\u7684\u5f69\u86cb\u548c\u79d8\u5bc6\uff0c\u589e\u52a0\u4e86\u904a\u6232\u7684\u6df1\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u300e\u7b2c\u4e09\u9031\u300f\u4e2d\uff0c\u5982\u679c\u4f60\u5728\u300e\u8cbb\u57ce\u4e4b\u591c\u300f\u53d6\u5f97\u5b8c\u6574\u7684\u9023\u64ca\uff0c\u4e00\u500b\u7279\u6b8a\u7684\u52d5\u756b\u548c\u5c0d\u8a71\u5e8f\u5217\u5c07\u89f8\u767c\uff0c\u63ed\u793a\u984d\u5916\u7684\u904a\u6232\u80cc\u666f\u6545\u4e8b\u3002\u53e6\u4e00\u500b\u4f8b\u5b50\u662f\u300e\u6e2c\u8a66\u300f\u4fee\u6539\uff0c\u53ef\u85c9\u7531\u5728\u4e3b\u9078\u55ae\u8f38\u5165\u7279\u5b9a\u4ee3\u78bc\u5b58\u53d6\uff0c\u8b93\u4f60\u6e2c\u8a66\u81ea\u8a02\u97f3\u7b26\u6a21\u5f0f\u3002\u63a2\u7d22\u9019\u4e9b\u79d8\u5bc6\u53ef\u4ee5\u589e\u5f37\u4f60\u7684\u904a\u6232\u9ad4\u9a57\uff0c\u4e26\u63d0\u4f9b\u95dc\u65bc\u904a\u6232\u958b\u767c\u548c\u5287\u60c5\u7684\u4e00\u4e9b\u898b\u89e3\u3002"}]
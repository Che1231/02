[{"question": "FNF Minus\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3068\u3001\u52b9\u679c\u7684\u306a\u4f7f\u3044\u65b9\u3092\u6559\u3048\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "FNF Minus\u306e\u57fa\u672c\u64cd\u4f5c\u306f\u3001\u77e2\u5370\u30ad\u30fc\uff08\u4e0a\u3001\u4e0b\u3001\u5de6\u3001\u53f3\uff09\u3092\u4f7f\u3063\u3066\u97f3\u697d\u306b\u5408\u308f\u305b\u3066\u30ce\u30fc\u30c4\u3092\u53e9\u304f\u3053\u3068\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ce\u30fc\u30c4\u304c\u5bfe\u5fdc\u3059\u308b\u77e2\u5370\u306b\u30b9\u30af\u30ed\u30fc\u30eb\u3057\u3066\u304d\u305f\u3089\u3001\u305d\u306e\u30ad\u30fc\u3092\u62bc\u3057\u307e\u3059\u3002\u52b9\u679c\u7684\u306b\u4f7f\u3046\u305f\u3081\u306b\u306f\u3001\u307e\u305a\u30bf\u30a4\u30df\u30f3\u30b0\u306b\u96c6\u4e2d\u3057\u307e\u3057\u3087\u3046\u3002\u30ce\u30fc\u30c4\u304c\u30a4\u30f3\u30b8\u30b1\u30fc\u30bf\u30fc\u3068\u4e00\u81f4\u3057\u305f\u3068\u304d\u306b\u30ad\u30fc\u3092\u62bc\u3057\u307e\u3059\u3002\u30ea\u30ba\u30e0\u306b\u6163\u308c\u308b\u305f\u3081\u306b\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30e2\u30fc\u30c9\u3067\u7df4\u7fd2\u3057\u307e\u3057\u3087\u3046\u3002\u65e9\u3059\u304e\u308b\u30d2\u30c3\u30c8\u3084\u9045\u3059\u304e\u308b\u30d2\u30c3\u30c8\u306f\u30b9\u30b3\u30a2\u306b\u5f71\u97ff\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308b\u306e\u3067\u3001\u6b63\u78ba\u6027\u3092\u5fc3\u304c\u3051\u307e\u3057\u3087\u3046\u3002\u521d\u5fc3\u8005\u306e\u5834\u5408\u306f\u3001\u30ad\u30fc\u3092\u62bc\u3057\u3059\u304e\u306a\u3044\u3088\u3046\u306b\u8efd\u304f\u53e9\u304f\u306e\u304c\u30b3\u30c4\u3067\u3059\u3002"}, {"question": "\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u3057\u3066\u3001FNF Minus\u3067\u6b63\u78ba\u6027\u3092\u5411\u4e0a\u3055\u305b\u308b\u65b9\u6cd5\u3092\u6559\u3048\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "FNF Minus\u3067\u6b63\u78ba\u6027\u3092\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u306b\u306f\u3001\u7d99\u7d9a\u7684\u306a\u7df4\u7fd2\u3068\u30b2\u30fc\u30e0\u306e\u30ea\u30ba\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u306e\u7406\u89e3\u304c\u5fc5\u8981\u3067\u3059\u3002\u307e\u305a\u306f\u3001\u81ea\u4fe1\u3092\u3064\u3051\u308b\u305f\u3081\u306b\u7c21\u5358\u306a\u66f2\u304b\u3089\u30d7\u30ec\u30a4\u3092\u59cb\u3081\u307e\u3057\u3087\u3046\u3002\u7df4\u7fd2\u30e2\u30fc\u30c9\u3092\u4f7f\u3063\u3066\u3001\u96e3\u3057\u3044\u90e8\u5206\u3092\u7e70\u308a\u8fd4\u3057\u30d7\u30ec\u30a4\u3057\u307e\u3057\u3087\u3046\u3002\u8996\u899a\u7684\u306a\u30ad\u30e5\u30fc\u306b\u6ce8\u610f\u3092\u6255\u3044\u3001\u30ce\u30fc\u30c4\u304c\u30d2\u30c3\u30c8\u30a8\u30ea\u30a2\u306b\u5230\u9054\u3059\u308b\u524d\u306b\u4e88\u6e2c\u3059\u308b\u3088\u3046\u306b\u3057\u307e\u3057\u3087\u3046\u3002\u30b2\u30fc\u30e0\u306e\u5916\u3067\u97f3\u697d\u3092\u805e\u3044\u3066\u3001\u30d3\u30fc\u30c8\u30d1\u30bf\u30fc\u30f3\u3092\u5185\u9762\u5316\u3059\u308b\u306e\u3082\u826f\u3044\u6226\u7565\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u300d\u3068\u3044\u3046\u66f2\u3067\u306f\u3001\u30ce\u30fc\u30c4\u304c\u30c9\u30e9\u30e0\u306e\u30d3\u30fc\u30c8\u3068\u540c\u671f\u3057\u3066\u3044\u308b\u306e\u3067\u3001\u30ad\u30fc\u3092\u62bc\u3059\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u4e88\u6e2c\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u307e\u305f\u3001\u30ad\u30fc\u30dc\u30fc\u30c9\u3084\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u306e\u8a2d\u5b9a\u3092\u3001\u30c7\u30d5\u30a9\u30eb\u30c8\u8a2d\u5b9a\u304c\u4e0d\u5feb\u3060\u3068\u611f\u3058\u308b\u5834\u5408\u306f\u8abf\u6574\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "FNF Minus\u3067\u30ce\u30fc\u30c4\u3092\u4f55\u5ea6\u3082\u30df\u30b9\u3057\u3066\u3057\u307e\u3046\u7406\u7531\u3068\u3001\u305d\u308c\u3092\u4fee\u6b63\u3059\u308b\u65b9\u6cd5\u3092\u6559\u3048\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "FNF Minus\u3067\u30ce\u30fc\u30c4\u3092\u30df\u30b9\u3057\u3066\u3057\u307e\u3046\u306e\u306f\u3001\u591a\u304f\u306e\u5834\u5408\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u60aa\u304b\u3063\u305f\u308a\u3001\u66f2\u306e\u30ea\u30ba\u30e0\u306b\u6163\u308c\u3066\u3044\u306a\u3044\u3053\u3068\u304c\u539f\u56e0\u3067\u3059\u3002\u307e\u305a\u3001\u30cf\u30fc\u30c9\u30a6\u30a7\u30a2\u304c\u53cd\u5fdc\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3057\u3087\u3046\u3002\u9045\u5ef6\u3057\u305f\u30ad\u30fc\u30dc\u30fc\u30c9\u3067\u306f\u30df\u30b9\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306e\u97f3\u58f0\u540c\u671f\u3092\u30b7\u30b9\u30c6\u30e0\u306e\u30ec\u30a4\u30c6\u30f3\u30b7\u306b\u5408\u308f\u305b\u3066\u8a2d\u5b9a\u3067\u8abf\u6574\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u30ce\u30fc\u30c4\u304c\u9045\u308c\u3066\u805e\u3053\u3048\u308b\u5834\u5408\u306f\u3001\u30aa\u30d5\u30bb\u30c3\u30c8\u3092\u5897\u3084\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u7df4\u7fd2\u30e2\u30fc\u30c9\u3067\u66f2\u306e\u901f\u5ea6\u3092\u843d\u3068\u3057\u3001\u30ce\u30fc\u30c4\u5bc6\u5ea6\u304c\u9ad8\u3044\u90e8\u5206\u3092\u7df4\u7fd2\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u307e\u305f\u3001\u30ea\u30e9\u30c3\u30af\u30b9\u3057\u3066\u624b\u3092\u4f7f\u3063\u3066\u3082\u3089\u3044\u307e\u3057\u3087\u3046\u3002\u7dca\u5f35\u3059\u308b\u3068\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5916\u3057\u3066\u3057\u307e\u3046\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u6642\u9593\u304c\u7d4c\u3064\u3068\u3001\u7b4b\u8089\u306e\u8a18\u61b6\u304c\u8eab\u306b\u3064\u304d\u3001\u30df\u30b9\u3059\u308b\u56de\u6570\u3092\u6e1b\u3089\u3059\u52b9\u679c\u304c\u898b\u3089\u308c\u307e\u3059\u3002"}, {"question": "FNF Minus\u3067\u9ad8\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u305f\u3081\u306b\u4f7f\u7528\u3067\u304d\u308b\u4e0a\u7d1a\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "FNF Minus\u3067\u9ad8\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u306b\u306f\u3001\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30b3\u30f3\u30dc\u30c1\u30a7\u30fc\u30f3\u3092\u7dad\u6301\u3057\u3001\u30de\u30eb\u30c1\u30d7\u30e9\u30a4\u30e4\u30fc\u3092\u6700\u5927\u5316\u3059\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b3\u30f3\u30dc\u3092\u4e2d\u65ad\u3059\u308b\u3053\u3068\u306a\u304f\u3001\u30ce\u30fc\u30c4\u3092\u9023\u7d9a\u3057\u3066\u53e9\u304f\u3053\u3068\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30ce\u30fc\u30c4\u3092\u5b8c\u74a7\u306b\u53e9\u304f\u3053\u3068\u3067\u300cSick\u300d\u306e\u8a55\u4fa1\u3092\u76ee\u6307\u3057\u307e\u3057\u3087\u3046\u3001\u3053\u308c\u306b\u3088\u308a\u30b9\u30b3\u30a2\u304c\u3088\u308a\u591a\u304f\u52a0\u7b97\u3055\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30da\u30ca\u30eb\u30c6\u30a3\u306a\u3057\u3067\u7df4\u7fd2\u3067\u304d\u308b\u300cGhost Tapping\u300d\u6a5f\u80fd\u3092\u6d3b\u7528\u3057\u3066\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5fae\u8abf\u6574\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u300c\u30b5\u30a6\u30b9\u300d\u3068\u3044\u3046\u66f2\u3067\u306f\u3001\u6025\u901f\u306a\u30ce\u30fc\u30c4\u306e\u9023\u7d9a\u306f\u3001\u30d1\u30bf\u30fc\u30f3\u3092\u4e88\u6e2c\u3057\u3001\u7d99\u7d9a\u7684\u306b\u7df4\u7fd2\u3059\u308b\u3053\u3068\u3067\u30de\u30b9\u30bf\u30fc\u3067\u304d\u307e\u3059\u3002\u307e\u305f\u3001\u30c1\u30e3\u30fc\u30c8\u30d1\u30bf\u30fc\u30f3\u3092\u7d20\u65e9\u304f\u8aad\u3080\u3053\u3068\u3067\u3001\u53cd\u5fdc\u6642\u9593\u3092\u77ed\u7e2e\u3067\u304d\u307e\u3059\u3002"}, {"question": "FNF Minus\u3067\u30c6\u30f3\u30dd\u306e\u901f\u3044\u66f2\u3092\u30b3\u30f3\u30dc\u3092\u843d\u3068\u3055\u305a\u306b\u30d7\u30ec\u30a4\u3059\u308b\u65b9\u6cd5\u3092\u6559\u3048\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "FNF Minus\u3067\u30c6\u30f3\u30dd\u306e\u901f\u3044\u66f2\u3092\u30b3\u30f3\u30dc\u3092\u843d\u3068\u3055\u305a\u306b\u30d7\u30ec\u30a4\u3059\u308b\u306b\u306f\u3001\u7df4\u7fd2\u3068\u6226\u7565\u306e\u7d44\u307f\u5408\u308f\u305b\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u66f2\u306e\u30ea\u30ba\u30e0\u306b\u6163\u308c\u3066\u304a\u304f\u305f\u3081\u306b\u3001\u8907\u6570\u56de\u805e\u3044\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u7df4\u7fd2\u30e2\u30fc\u30c9\u3092\u4f7f\u7528\u3057\u3066\u3001\u66f2\u3092\u9045\u304f\u3057\u3001\u6163\u308c\u3066\u304d\u305f\u3089\u5f90\u3005\u306b\u30b9\u30d4\u30fc\u30c9\u3092\u4e0a\u3052\u3066\u3044\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u66f2\u3092\u5168\u4f53\u3067\u306f\u306a\u304f\u3001\u6271\u3044\u3084\u3059\u3044\u90e8\u5206\u306b\u5206\u5272\u3057\u3001\u5c0f\u3055\u306a\u90e8\u5206\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u300cM.I.L.F\u300d\u306e\u30b3\u30fc\u30e9\u30b9\u306b\u306f\u3001\u305d\u306e\u90e8\u5206\u3092\u5206\u96e2\u3057\u3066\u7e70\u308a\u8fd4\u3057\u7df4\u7fd2\u3059\u308b\u3053\u3068\u3067\u30de\u30b9\u30bf\u30fc\u3067\u304d\u308b\u901f\u3044\u30ce\u30fc\u30c4\u306e\u9023\u7d9a\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u307e\u305f\u3001\u6307\u3092\u30ea\u30e9\u30c3\u30af\u30b9\u3055\u305b\u3066\u30b9\u30d4\u30fc\u30c9\u3068\u6b63\u78ba\u6027\u3092\u7dad\u6301\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "FNF Minus\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u305f\u3081\u306e\u6700\u9069\u306a\u8a2d\u5b9a\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "FNF Minus\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u30b2\u30fc\u30e0\u5185\u3068\u30b7\u30b9\u30c6\u30e0\u306e\u8a2d\u5b9a\u306e\u4e21\u65b9\u3092\u8abf\u6574\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b2\u30fc\u30e0\u5185\u3067\u306f\u3001\u30ce\u30fc\u30c4\u306e\u901f\u5ea6\u3092\u5feb\u9069\u306a\u30ec\u30d9\u30eb\u306b\u8abf\u6574\u3057\u307e\u3057\
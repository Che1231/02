[{"question": "\u09aa\u09cd\u09b0\u09a5\u09ae \u09b6\u09b9\u09b0\u099f\u09bf \u0995\u09c0\u09ad\u09be\u09ac\u09c7 \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09ac\u09c7\u09a8?", "answer": "\u09b8\u09bf\u099f\u09bf \u09ac\u09cd\u09b2\u0995\u09b8\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09a5\u09ae \u09b6\u09b9\u09b0 \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af, \u098f\u0987 \u09a7\u09be\u09aa\u0997\u09c1\u09b2\u09bf \u0985\u09a8\u09c1\u09b8\u09b0\u09a3 \u0995\u09b0\u09c1\u09a8: \u09a7\u09be\u09aa 1 - \u0986\u09aa\u09a8\u09be\u09b0 \u09b6\u09b9\u09b0\u09c7\u09b0 \u09b9\u09b2, \u09af\u09be \u09ae\u09c2\u09b2 \u09ad\u09ac\u09a8, \u09b8\u09c7\u099f\u09bf \u09b0\u09be\u0996\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u098f\u0995\u099f\u09bf \u09b8\u09ae\u09a4\u09b2 \u098f\u09b2\u09be\u0995\u09be \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8\u0964 \u09a7\u09be\u09aa 2 - \u0985\u09a8\u09cd\u09af\u09be\u09a8\u09cd\u09af \u09ad\u09ac\u09a8\u0997\u09c1\u09b2\u09bf\u09b0 \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b6\u09b9\u09b0\u09c7\u09b0 \u09b9\u09b2\u09c7 \u09b0\u09be\u09b8\u09cd\u09a4\u09be \u09b8\u0982\u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\u0964 \u09a7\u09be\u09aa 3 - \u09b0\u09be\u09b8\u09cd\u09a4\u09be\u09b0 \u0995\u09be\u099b\u09be\u0995\u09be\u099b\u09bf \u09ac\u09be\u09b8\u09b8\u09cd\u09a5\u09be\u09a8 \u098f\u09b2\u09be\u0995\u09be \u09b8\u09cd\u09a5\u09be\u09aa\u09a8 \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09c1\u09a8\u0964 \u0989\u09a6\u09be\u09b9\u09b0\u09a3\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa, \u098f\u0995\u099f\u09bf '\u0989\u09aa\u0995\u09a3\u09cd\u09a0 \u09ac\u09be\u09b8\u09ad\u09ac\u09a8' \u09b8\u09cd\u09a5\u09be\u09aa\u09a8\u09c7\u09b0 \u09ab\u09b2\u09c7 \u09a8\u09be\u0997\u09b0\u09bf\u0995\u09b0\u09be \u0986\u0995\u09b0\u09cd\u09b7\u09bf\u09a4 \u09b9\u09a4\u09c7 \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09ac\u09c7\u0964 \u09b8\u09b0\u09cd\u09ac\u09cb\u09a4\u09cd\u09a4\u09ae \u09ac\u09c3\u09a6\u09cd\u09a7\u09bf\u09b0 \u099c\u09a8\u09cd\u09af \u09ac\u09be\u09b8\u09b8\u09cd\u09a5\u09be\u09a8, \u09ac\u09cd\u09af\u09ac\u09b8\u09be \u098f\u09ac\u0982 \u09b6\u09bf\u09b2\u09cd\u09aa \u098f\u09b2\u09be\u0995\u09be\u09b0 \u09ad\u09be\u09b0\u09b8\u09be\u09ae\u09cd\u09af \u09ac\u099c\u09be\u09af\u09bc \u09b0\u09be\u0996\u09a4\u09c7 \u09ae\u09a8\u09c7 \u09b0\u09be\u0996\u09ac\u09c7\u09a8\u0964"}, {"question": "\u09aa\u09b0\u09cd\u09af\u09be\u09aa\u09cd\u09a4 \u09ac\u09be\u09b8\u09b8\u09cd\u09a5\u09be\u09a8 \u098f\u09b2\u09be\u0995\u09be \u09a5\u09be\u0995\u09be \u09b8\u09a4\u09cd\u09a4\u09cd\u09ac\u09c7\u0993 \u0986\u09ae\u09be\u09b0 \u09b8\u09bf\u099f\u09bf \u09ac\u09cd\u09b2\u0995\u09b8 \u09b6\u09b9\u09b0 \u0995\u09c7\u09a8 \u09ac\u09c3\u09a6\u09cd\u09a7\u09bf \u09aa\u09be\u099a\u09cd\u099b\u09c7 \u09a8\u09be?", "answer": "\u092f\u0926\u093f \u0906\u092a\u0915\u093e \u0938\u093f\u091f\u0940 \u092c\u094d\u0932\u0949\u0915\u094d\u0938 \u0936\u0939\u0930 \u092a\u0930\u094d\u092f\u093e\u092a\u094d\u0924 \u0906\u0935\u093e\u0938\u0940\u092f \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0939\u094b\u0928\u0947 \u0915\u0947 \u092c\u093e\u0935\u091c\u0942\u0926 \u092c\u0922\u093c \u0928\u0939\u0940\u0902 \u0930\u0939\u093e \u0939\u0948, \u0924\u094b \u0907\u0928 \u0915\u093e\u0930\u0915\u094b\u0902 \u0915\u0940 \u091c\u093e\u0901\u091a \u0915\u0930\u0947\u0902: \u091a\u0930\u0923 1 - \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f \u0906\u092a\u0915\u0947 \u0906\u0935\u093e\u0938\u0940\u092f \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0938\u0921\u093c\u0915\u094b\u0902 \u0938\u0947 \u091c\u0941\u0921\u093c\u0947 \u0939\u0941\u090f \u0939\u0948\u0902 \u0914\u0930 \u092a\u093e\u0928\u0940 \u0914\u0930 \u092c\u093f\u091c\u0932\u0940 \u091c\u0948\u0938\u0940 \u092c\u0941\u0928\u093f\u092f\u093e\u0926\u0940 \u0938\u0947\u0935\u093e\u0913\u0902 \u0924\u0915 \u092a\u0939\u0941\u0902\u091a \u0939\u0948\u0964 \u091a\u0930\u0923 2 - \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f \u0935\u093e\u0923\u093f\u091c\u094d\u092f\u093f\u0915 \u092f\u093e \u0914\u0926\u094d\u092f\u094b\u0917\u093f\u0915 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u094b\u0902 \u092e\u0947\u0902 \u092a\u0930\u094d\u092f\u093e\u092a\u094d\u0924 \u0928\u094c\u0915\u0930\u0940 \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u0964 \u091a\u0930\u0923 3 - \u0905\u092a\u0928\u0947 \u0928\u093e\u0917\u0930\u093f\u0915\u094b\u0902 \u0915\u0940 \u0916\u0941\u0936\u0940 \u0915\u0947 \u0938\u094d\u0924\u0930 \u0915\u0940 \u0928\u093f\u0917\u0930\u093e\u0928\u0940 \u0915\u0930\u0947\u0902; \u0915\u092e \u0916\u0941\u0936\u0940 \u0935\u093f\u0915\u093e\u0938 \u0915\u094b \u0930\u094b\u0915 \u0938\u0915\u0924\u0940 \u0939\u0948\u0964 \u0909\u0926\u093e\u0939\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f, \u0906\u0935\u093e\u0938\u0940\u092f \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u094b\u0902 \u0915\u0947 \u092a\u093e\u0938 \u090f\u0915 '\u092a\u093e\u0930\u094d\u0915' \u091c\u094b\u0921\u093c\u0928\u0947 \u0938\u0947 \u0916\u0941\u0936\u0940 \u092e\u0947\u0902 \u0935\u0943\u0926\u094d\u0927\u093f \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948 \u0914\u0930 \u091c\u0928\u0938\u0902\u0916\u094d\u092f\u093e \u0935\u0943\u0926\u094d\u0927\u093f \u0915\u094b \u092a\u094d\u0930\u094b\u0924\u094d\u0938\u093e\u0939\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964"}, {"question": "\u09b8\u09bf\u099f\u09bf \u09ac\u09cd\u09b2\u0995\u09b8\u09c7 \u09ac\u09be\u09b8\u09b8\u09cd\u09a5\u09be\u09a8\u09c7\u09b0 \u098f\u09b2\u09be\u0995\u09be\u09b0 \u09a7\u09b0\u09a3\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u09ae\u09c2\u09b2 \u09aa\u09be\u09b0\u09cd\u09a5\u0995\u09cd\u09af\u0997\u09c1\u09b2\u09bf \u0995\u09c0?", "answer": "\u09b8\u09bf\u099f\u09bf \u09ac\u09cd\u09b2\u0995\u09b8\u09c7, \u09ac\u09be\u09b8\u09b8\u09cd\u09a5\u09be\u09a8 \u098f\u09b2\u09be\u0995\u09be\u09b0 \u09a7\u09b0\u09a3 \u0998\u09a8\u09a4\u09cd\u09ac \u098f\u09ac\u0982 \u099c\u09a8\u09b8\u0982\u0996\u09cd\u09af\u09be\u09b0 \u09a7\u09be\u09b0\u09a3\u0995\u09cd\u09b7\u09ae\u09a4\u09be\u09b0 \u0989\u09aa\u09b0 \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf \u0995\u09b0\u09c7 \u0986\u09b2\u09be\u09a6\u09be\u0964 '\u0989\u09aa\u0995\u09a3\u09cd\u09a0 \u09ac\u09be\u09b8\u09ad\u09ac\u09a8' \u098f\u09b0 \u09ae\u09a4\u09cb \u0995\u09ae \u0998\u09a8\u09a4\u09cd\u09ac\u09c7\u09b0 \u098f\u09b2\u09be\u0995\u09be \u0995\u09ae \u09ae\u09be\u09a8\u09c1\u09b7\u0995\u09c7 \u0986\u09b6\u09cd\u09b0\u09af\u09bc \u09a6\u09c7\u09af\u09bc \u09a4\u09ac\u09c7 \u09b8\u09c1\u0996 \u09ac\u09c3\u09a6\u09cd\u09a7\u09bf \u0995\u09b0\u09c7\u0964 '\u0985\u09cd\u09af\u09be\u09aa\u09be\u09b0\u09cd\u099f\u09ae\u09c7\u09a8\u09cd\u099f \u0995\u09ae\u09aa\u09cd\u09b2\u09c7\u0995\u09cd\u09b8' \u098f\u09b0 \u09ae\u09a4\u09cb \u09ae\u09be\u099d\u09be\u09b0\u09bf \u0998\u09a8\u09a4\u09cd\u09ac\u09c7\u09b0 \u098f\u09b2\u09be\u0995\u09be \u0986\u09b0\u0993 \u09ac\u09c7\u09b6\u09bf \u09a8\u09be\u0997\u09b0\u09bf\u0995\u0995\u09c7 \u0986\u09b6\u09cd\u09b0\u09af\u09bc \u09a6\u09c7\u09af\u09bc \u09a4\u09ac\u09c7 \u0986\u09b0\u0993 \u09ac\u09c7\u09b6\u09bf \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be\u09b0 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8 \u09b9\u09af\u09bc\u0964 '\u09b8\u09cd\u0995\u09be\u0987\u09b8\u09cd\u0995\u09cd\u09b0\u09c7\u09aa\u09be\u09b0' \u098f\u09b0 \u09ae\u09a4\u09cb \u0989\u099a\u09cd\u099a \u0998\u09a8\u09a4\u09cd\u09ac\u09c7\u09b0 \u098f\u09b2\u09be\u0995\u09be \u099c\u09a8\u09b8\u0982\u0996\u09cd\u09af\u09be\u0995\u09c7 \u09b8\u09b0\u09cd\u09ac\u09cb\u099a\u09cd\u099a \u0995\u09b0\u09be\u09b0 \u09b8\u09c1\u09af\u09cb\u0997 \u09a6\u09c7\u09af\u09bc \u09a4\u09ac\u09c7 \u09af\u09be\u09a8\u099c\u099f\u09c7\u09b0 \u09b8\u09ae\u09b8\u09cd\u09af\u09be \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964 \u0989\u09a6\u09be\u09b9\u09b0\u09a3\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa, \u0995\u09ae \u09af\u09be\u09a8 \u099a\u09b2\u09be\u099a\u09b2\u09c7\u09b0 \u098f\u09b2\u09be\u0995\u09be\u09af\u09bc '\u0989\u09aa\u0995\u09a3\u09cd\u09a0 \u09ac\u09be\u09b8\u09ad\u09ac\u09a8' \u09b8\u09cd\u09a5\u09be\u09aa\u09a8 \u0995\u09b0\u09be \u09b6\u09c1\u09b0\u09c1\u0995\u09be\u09b0\u09c0\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09a6\u09b0\u09cd\u09b6, \u098f\u09ac\u0982 \u099c\u099f\u09bf\u09b2 \u09b6\u09b9\u09b0\u09c7\u09b0 \u09a8\u0995\u09b6\u09be \u09aa\u09b0\u09bf\u099a\u09be\u09b2\u09a8\u09be \u0995\u09b0\u09c7 \u098f\u09ae\u09a8 \u0985\u0997\u09cd\u09b0\u09b8\u09b0\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af '\u09b8\u09cd\u0995\u09be\u0987\u09b8\u09cd\u0995\u09cd\u09b0\u09c7\u09aa\u09be\u09b0' \u0986\u09b0\u0993 \u0989\u09aa\u09af\u09c1\u0995\u09cd\u09a4\u0964"}, {"question": "\u0986\u09ae\u09be\u09b0 \u09b8\u09bf\u099f\u09bf \u09ac\u09cd\u09b2\u0995\u09b8 \u09ae\u09b9\u09be\u09a8\u0997\u09b0\u09c0\u09a4\u09c7 \u09af\u09be\u09a8\u099c\u099f \u0995\u09c0\u09ad\u09be\u09ac\u09c7 \u0995\u09be\u09b0\u09cd\u09af\u0995\u09b0\u09ad\u09be\u09ac\u09c7 \u0989\u09a8\u09cd\u09a8\u09a4 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09bf?", "answer": "\u09b8\u09bf\u099f\u09bf \u09ac\u09cd\u09b2\u0995\u09b8\u09c7 \u09af\u09be\u09a8\u099c\u099f \u0989\u09a8\u09cd\u09a8\u09a4 \u0995\u09b0\u09a4\u09c7 \u0995\u09cc\u09b6\u09b2\u0997\u09a4 \u09aa\u09b0\u09bf\u0995\u09b2\u09cd\u09aa\u09a8\u09be \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8: \u09a7\u09be\u09aa 1 - \u099b\u09c7\u09a6 \u09ac\u09bf\u09a8\u09cd\u09a6\u09c1 \u09b9\u09cd\u09b0\u09be\u09b8 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0997\u09cd\u09b0\u09bf\u09a1 \u09ac\u09be \u09b0\u09c7\u09a1\u09bf\u09af\u09bc\u09be\u09b2 \u09b0\u09be\u09b8\u09cd\u09a4\u09be\u09b0 \u09a8\u0995\u09b6\u09be \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c1\u09a8\u0964 \u09a7\u09be\u09aa 2 - \u0989\u099a\u09cd\u099a \u099a\u09b2\u09be\u099a\u09b2 \u098f\u09b2\u09be\u0995\u09be\u09b0 \u0995\u09be\u099b\u09be\u0995\u09be\u099b\u09bf \u09ac\u09be\u09b8\u09c7\u09b0 \u09b8\u09cd\u099f\u09aa\u09c7\u09b0 \u09ae\u09a4\u09cb \u09aa\u09be\u09ac\u09b2\u09bf\u0995 \u099f\u09cd\u09b0\u09be\u09a8\u09cd\u09b8\u09aa\u09cb\u09b0\u09cd\u099f \u09b8\u09cd\u09a5\u09be\u09aa\u09a8 \u0995\u09b0\u09c1\u09a8\u0964 \u09a7\u09be\u09aa 3 - \u09af\u09be\u09a8\u099c\u099f \u09b9\u09cd\u09b0\u09be\u09b8 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09b0\u09be\u09b8\u09cd\u09a4\u09be \u0989\u09a8\u09cd\u09a8\u09c0\u09a4 \u0995\u09b0\u09c1\u09a8 \u09ac\u09be \u098f\u0995\u09ae\u09c1\u0996\u09c0 \u09b0\u09be\u09b8\u09cd\u09a4\u09be \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\u0964 \u0989\u09a6\u09be\u09b9\u09b0\u09a3\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa, \u09b9\u09be\u0987\u0993\u09af\u09bc\u09c7 \u09a6\u09bf\u09af\u09bc\u09c7 \u098f\u0995\u099f\u09bf \u09b6\u09bf\u09b2\u09cd\u09aa \u098f\u09b2\u09be\u0995\u09be \u098f\u0995\u099f\u09bf \u09ac\u09be\u09a3\u09bf\u099c\u09cd\u09af\u09bf\u0995 \u098f\u09b2\u09be\u0995\u09be\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b8\u0982\u09af\u09c1\u0995\u09cd\u09a4 \u0995\u09b0\u09be \u09af\u09be\u09a8\u099c\u099f\u09c7\u09b0 \u09b8\u09ae\u09b8\u09cd\u09af\u09be\u0997\u09c1\u09b2\u09bf \u0989\u09b2\u09cd\u09b2\u09c7\u0996\u09af\u09cb\u0997\u09cd\u09af\u09ad\u09be\u09ac\u09c7 \u09b9\u09cd\u09b0\u09be\u09b8 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964"}, {"question": "\u09b8\u09bf\u099f\u09bf \u09ac\u09cd\u09b2\u0995\u09b8\u09c7 \u0986\u09af\u09bc\u0995\u09c7 \u09b8\u09b0\u09cd\u09ac\u09be\u09a7\u09bf\u0995 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0995\u09cb\u09a8 \u0989\u09a8\u09cd\u09a8\u09a4 \u0995\u09cc\u09b6\u09b2 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09bf?", "answer": "\u09b8\u09bf\u099f\u09bf \u09ac\u09cd\u09b2\u0995\u09b8\u09c7 \u0986\u09af\u09bc \u09b8\u09b0\u09cd\u09ac\u09be\u09a7\u09bf\u0995 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af, \u098f\u0987 \u0995\u09cc\u09b6\u09b2\u0997\u09c1\u09b2\u09bf\u0995\u09c7 \u09ac\u09bf\u09ac\u09c7\u099a\u09a8\u09be \u0995\u09b0\u09c1\u09a8: \u09a7\u09be\u09aa 1 - \u0986\u09b0\u0993 \u09ac\u09c7\u09b6\u09bf \u0986\u09af\u09bc \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af '\u09b6\u09aa\u09bf\u0982 \u09ae\u09b2' \u098f\u09b0 \u09ae\u09a4\u09cb \u0989\u099a\u09cd\u099a \u0998\u09a8\u09a4\u09cd\u09ac\u09c7\u09b0 \u09ac\u09be\u09a3\u09bf\u099c\u09cd\u09af\u09bf\u0995 \u098f\u09b2\u09be\u0995\u09be\u09af\u09bc \u09ab\u09cb\u0995\u09be\u09b8 \u0995\u09b0\u09c1\u09a8\u0964 \u09a7\u09be\u09aa 2 - '\u09b8\u09bf\u099f\u09bf \u099f\u09be\u0993\u09af\u09bc\u09be\u09b0' \u098f\u09b0 \u09ae\u09a4\u09cb \u09a6\u09b0\u09cd\u09b6\u09a8\u09c0\u09af\u09bc \u09b8\u09cd\u09a5\u09be\u09aa\u09a8\u09be \u09a8\u09bf\u09b0\u09cd\u09ae\u09be\u09a3 \u0995\u09b0\u09c7 \u09aa\u09b0\u09cd\u09af\u099f\u09a8 \u0989\u09a8\u09cd\u09a8\u09a4 \u0995\u09b0\u09c1\u09a8\u0964 \u09a7\u09be\u09aa 3 - \u0995\u09b0 \u09b8\u09be\u09ac\u09a7\u09be\u09a8\u09c7 \u09ad\u09be\u09b0\u09b8\u09be\u09ae\u09cd\u09af \u09ac\u099c\u09be\u09af\u09bc \u09b0\u09be\u0996\u09c1\u09a8; \u0996\u09c1\u09ac \u09ac\u09c7\u09b6\u09bf \u09b9\u09b2\u09c7 \u09a8\u09be\u0997\u09b0\u09bf\u0995\u09b0\u09be \u099a\u09b2\u09c7 \u09af\u09be\u09ac\u09c7; \u0996\u09c1\u09ac \u0995\u09ae \u09b9\u09b2\u09c7 \u0986\u09af\u09bc \u0995\u09ae\u09c7 \u09af\u09be\u09ac\u09c7\u0964 \u0989\u09a6\u09be\u09b9\u09b0\u09a3\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa, \u0989\u099a\u09cd\u099a \u09b8\u09c1\u0996\u09c0 \u09ac\u09be\u09b8\u09b8\u09cd\u09a5\u09be\u09a8 \u098f\u09b2\u09be\u0995\u09be\u09b0 \u0995\u09be\u099b\u09c7 '\u09b6\u09aa\u09bf\u0982 \u09ae\u09b2' \u09b0\u09be\u0996\u09b2\u09c7 \u0989\u09b2\u09cd\u09b2\u09c7\u0996\u09af\u09cb\u0997\u09cd\u09af \u09b2\u09be\u09ad \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964"}, {"question": "\u09b8\u09bf\u099f\u09bf \u09ac\u09cd\u09b2\u0995\u09b8\u09c7 \u09a6\u09c2\u09b7\u09a3\u09c7\u09b0 \u09ae\u09be\u09a4\u09cd\u09b0\u09be \u0995\u09c0\u09ad\u09be\u09ac\u09c7 \u0995\u09be\u09b0\u09cd\u09af\u0995\u09b0\u09ad\u09be\u09ac\u09c7 \u09aa\u09b0\u09bf\u099a\u09be\u09b2\u09a8\u09be \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09bf?", "answer": "\u09b8\u09bf\u099f\u09bf \u09ac\u09cd\u09b2\u0995\u09b8\u09c7 \u09a6\u09c2\u09b7\u09a3 \u09aa\u09b0\u09bf\u099a\u09be\u09b2\u09a8\u09be \u0995\u09b0\u09a4\u09c7 \u098f\u0995\u09be\u09a7\u09bf\u0995 \u09a7\u09be\u09aa \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8: \u09a7\u09be\u09aa 1 - \u09ac\u09be\u09b8\u09b8\u09cd\u09a5\u09be\u09a8 \u098f\u09b2\u09be\u0995\u09be \u09a5\u09c7\u0995\u09c7 \u09b6\u09bf\u09b2\u09cd\u09aa \u098f\u09b2\u09be\u0995\u09be \u09a6\u09c2\u09b0\u09c7 \u09b0\u09be\u0996\u09c1\u09a8 \u098f\u09ac\u0982 \u09ac\u09be\u09ab\u09be\u09b0 \u09b9\u09bf\u09b8\u09be\u09ac\u09c7 \u0997\u09be\u099b \u09ac\u09be \u09aa\u09be\u09b0\u09cd\u0995 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c1\u09a8\u0964 \u09a7\u09be\u09aa 2 - '\u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09c2\u09b2 \u0995\u09be\u09b0\u0996\u09be\u09a8\u09be' \u098f\u09b0 \u09ae\u09a4\u09cb \u09aa\u09b0\u09bf\u09ac\u09c7\u09b6 \u09ac\u09be\u09a8\u09cd\u09a7\u09ac \u09aa\u09cd\u09b0\u09af\u09c1\u0995\u09cd\u09a4\u09bf\u09a4\u09c7 \u09b6\u09bf\u09b2\u09cd\u09aa \u09ad\u09ac\u09a8 \u0989\u09a8\u09cd\u09a8\u09a4 \u0995\u09b0\u09c1\u09a8\u0964 \u09a7\u09be\u09aa 3 - \u09af\u09be\u09a8\u09ac\u09be\u09b9\u09a8 \u09a8\u09bf\u09b0\u09cd\u0997\u09ae\u09a8 \u0995\u09ae\u09be\u09a4\u09c7 \u099c\u09a8\u0997\u09a3\u09c7\u09b0 \u09aa\u09b0\u09bf\u09ac\u09b9\u09a8\u09c7 \u09ac\u09bf\u09a8\u09bf\u09af\u09bc\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\u0964 \u0989\u09a6\u09be\u09b9\u09b0\u09a3\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa, '\u0995\u09af\u09bc\u09b2\u09be \u09ac\u09bf\u09a6\u09cd\u09af\u09c1\u09ce \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0' '\u09b8\u09cc\u09b0 \u0995\u09c3\u09b7\u09bf' \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09aa\u09cd\u09b0\u09a4\u09bf\u09b8\u09cd\u09a5\u09be\u09aa\u09a8 \u09a6\u09cd\u09b0\u09c1\u09a4 \u09a6\u09c2\u09b7\u09a3\u09c7\u09b0 \u09ae\u09be\u09a4\u09cd\u09b0\u09be \u0995\u09ae\u09be\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964"}, {"question": "\u09b8\u09bf\u099f\u09bf \u09ac\u09cd\u09b2\u0995\u09b8\u09c7 \u09b8\u09c1\u0996\u09c7\u09b0 \u09ae\u09bf\u099f\u09be\u09b0\u09c7\u09b0 \u09ad\u09c2\u09ae\u09bf\u0995\u09be \u0995\u09c0, \u098f\u09ac\u0982 \u098f\u099f\u09bf \u0997\u09c7\u09ae\u09aa\u09cd\u09b2\u09c7\u09a4\u09c7 \u0995\u09c0\u09ad\u09be\u09ac\u09c7 \u09aa\u09cd\u09b0\u09ad\u09be\u09ac \u09ab\u09c7\u09b2\u09c7?", "answer": "\u09b8\u09bf\u099f\u09bf \u09ac\u09cd\u09b2\u0995\u09b8\u09c7\u09b0 \u09b8\u09c1\u0996\u09c7\u09b0 \u09ae\u09bf\u099f\u09be\u09b0 \u09a8\u09be\u0997\u09b0\u09bf\u0995\u09a6\u09c7\u09b0 \u09b8\u09a8\u09cd\u09a4\u09c1\u09b7\u09cd\u099f\u09bf \u09aa\u09cd\u09b0\u09a4\u09bf\u09ab\u09b2\u09bf\u09a4 \u0995\u09b0\u09c7 \u098f\u09ac\u0982 \u09b8\u09b0\u09be\u09b8\u09b0\u09bf \u09b6\u09b9\u09b0\u09c7\u09b0 \u09ac\u09c3\u09a6\u09cd\u09a7\u09bf \u098f\u09ac\u0982 \u0986\u09af\u09bc\u0995\u09c7 \u09aa\u09cd\u09b0\u09ad\u09be\u09ac\u09bf\u09a4 \u0995\u09b0\u09c7\u0964 \u0989\u099a\u09cd\u099a \u09b8\u09c1\u0996 \u099c\u09a8\u09b8\u0982\u0996\u09cd\u09af\u09be \u09ac\u09c3\u09a6\u09cd\u09a7\u09bf \u098f\u09ac\u0982 \u0995\u09b0 \u0986\u09af\u09bc \u09ac\u09be\u09a1\u09bc\u09be\u09af\u09bc, \u098f\u09ac\u0982 \u0995\u09ae \u09b8\u09c1\u0996 \u09a8\u09be\u0997\u09b0\u09bf\u0995\u09a6\u09c7\u09b0 \u099a\u09b2\u09c7 \u09af\u09be\u0993\u09af\u09bc\u09be\u09b0 \u0995\u09be\u09b0\u09a3 \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8, \u0995\u09ae \u09a6\u09c2\u09b7\u09a3 \u098f\u09ac\u0982 \u0995\u09be\u099b\u09be\u0995\u09be\u099b\u09bf \u09aa\u09be\u09b0\u09cd\u0995 \u09b8\u09c1\u0996\u0995\u09c7 \u09aa\u09cd\u09b0\u09ad\u09be\u09ac\u09bf\u09a4 \u0995\u09b0\u09c7\u0964 \u0989\u09a6\u09be\u09b9\u09b0\u09a3\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa, \u09ac\u09be\u09b8\u09b8\u09cd\u09a5\u09be\u09a8 \u098f\u09b2\u09be\u0995\u09be\u09b0 \u0995\u09be\u099b\u09c7 '\u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09a6\u09be\u09af\u09bc \u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0' \u09b8\u09cd\u09a5\u09be\u09aa\u09a8 \u0995\u09b0\u09be \u0985\u09a4\u09cd\u09af\u09a8\u09cd\u09a4 \u09ac\u09c7\u09b6\u09bf \u09b8\u09c1\u0996 \u09ac\u09c3\u09a6\u09cd\u09a7\u09bf \u0995\u09b0\u09a4\u09c7 \u098f\u09ac\u0982 \u09b6\u09b9\u09b0\u09c7\u09b0 \u09b8\u09be\u09ae\u0997\u09cd\u09b0\u09bf\u0995 \u0995\u09b0\u09cd\u09ae\u0995\u09cd\u09b7\u09ae\u09a4\u09be \u0989\u09a8\u09cd\u09a8\u09a4 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964"}, {"question": "\u09b8\u09bf\u099f\u09bf \u09ac\u09cd\u09b2\u0995\u09b8\u09c7\u09b0 \u099c\u09cb\u09a8\u09bf\u0982 \u09b8\u09bf\u09b8\u09cd\u099f\u09c7\u09ae \u0995\u09c0\u09ad\u09be\u09ac\u09c7 \u0995\u09be\u099c \u0995\u09b0\u09c7, \u098f\u09ac\u0982 \u098f\u09b0 \u09ae\u09c2\u09b2 \u09aa\u09cd\u09b0\u09af\u09c1\u0995\u09cd\u09a4\u09bf \u0995\u09c0?", "answer": "\u09b8\u09bf\u099f\u09bf \u09ac\u09cd\u09b2\u0995\u09b8\u09c7\u09b0 \u099c\u09cb\u09a8\u09bf\u0982 \u09b8\u09bf\u09b8\u09cd\u099f\u09c7\u09ae \u09ac\u09be\u09b8\u09b8\u09cd\u09a5\u09be\u09a8, \u09ac\u09cd\u09af\u09ac\u09b8\u09be \u098f\u09ac\u0982 \u09b6\u09bf\u09b2\u09cd\u09aa \u098f\u09b2\u09be\u0995\u09be\u09af\u09bc \u09ac\u09bf\u09ad\u0995\u09cd\u09a4, \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09c7\u0995\u09c7 \u0986\u09b2\u09be\u09a6\u09be \u0989\u09a6\u09cd\u09a6\u09c7\u09b6\u09cd\u09af \u09aa\u09c2\u09b0\u09a3 \u0995\u09b0\u09c7\u0964 \u09ac\u09be\u09b8\u09b8\u09cd\u09a5\u09be\u09a8 \u098f\u09b2\u09be\u0995\u09be \u09a8\u09be\u0997\u09b0\u09bf\u0995\u09a6\u09c7\u09b0 \u0986\u09ac\u09be\u09b8\u09b8\u09cd\u09a5\u09b2, \u09ac\u09cd\u09af\u09ac\u09b8\u09be\u09b0 \u098f\u09b2\u09be\u0995\u09be \u0986\u09af\u09bc \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09c7 \u098f\u09ac\u0982 \u09b6\u09bf\u09b2\u09cd\u09aa \u098f\u09b2\u09be\u0995\u09be \u099a\u09be\u0995\u09b0\u09bf \u098f\u09ac\u0982 \u09b8\u09ae\u09cd\u09aa\u09a6 \u09b8\u09b0\u09ac\u09b0\u09be\u09b9 \u0995\u09b0\u09c7\u0964 \u09b8\u09bf\u09b8\u09cd\u099f\u09c7\u09ae\u099f\u09bf \u09a8\u09bf\u0995\u099f\u09a4\u09be \u098f\u09ac\u0982 \u09b8\u0982\u09af\u09cb\u0997\u09c7\u09b0 \u0989\u09aa\u09b0 \u09a8\u09bf\u09b0\u09cd\u09ad\u09b0 \u0995\u09b0\u09c7; \u0989\u09a6\u09be\u09b9\u09b0\u09a3\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa, \u09ac\u09be\u09b8\u09b8\u09cd\u09a5\u09be\u09a8 \u098f\u09b2\u09be\u0995\u09be\u09b0 \u09aa\u09be\u09b6\u09c7 \u09ac\u09be\u09a3\u09bf\u099c\u09cd\u09af\u09bf\u0995 \u098f\u09b2\u09be\u0995\u09be \u09b0\u09be\u0996\u09b2\u09c7 \u09a8\u09be\u0997\u09b0\u09bf\u0995\u09a6\u09c7\u09b0 \u09a6\u09cb\u0995\u09be\u09a8\u09c7 \u09b8\u09b9\u099c\u09c7\u0987 \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8 \u0985\u09b0\u09cd\u099c\u09a8 \u0995\u09b0\u09be \u09af\u09be\u09af\u09bc\u0964 \u0989\u09aa\u09b0\u09a8\u09cd\u09a4\u09c1, \u099c\u09cb\u09a8 \u0998\u09a8\u09a4\u09cd\u09ac (\u0995\u09ae, \u09ae\u09be\u099d\u09be\u09b0\u09bf, \u0989\u099a\u09cd\u099a) \u099c\u09a8\u09b8\u0982\u0996\u09cd\u09af\u09be\u09b0 \u09a7\u09be\u09b0\u09a3\u0995\u09cd\u09b7\u09ae\u09a4\u09be \u098f\u09ac\u0982 \u09b8\u09ae\u09cd\u09aa\u09a6\u09c7\u09b0 \u099a\u09be\u09b9\u09bf\u09a6\u09be\u0995\u09c7 \u09aa\u09cd\u09b0\u09ad\u09be\u09ac\u09bf\u09a4 \u0995\u09b0\u09c7\u0964"}, {"question": "\u0986\u09ae\u09bf \u0995\u09bf \u09ac\u09bf\u09ad\u09bf\u09a8\u09cd\u09a8 \u09aa\u09cd\u09b2\u09cd\u09af\u09be\u099f\u09ab\u09b0\u09cd\u09ae\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u0986\u09ae\u09be\u09b0 \u09b8\u09bf\u099f\u09bf \u09ac\u09cd\u09b2\u0995\u09b8 \u09b8\u09c7\u09ad \u09a1\u09c7\u099f\u09be \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u09a8\u09cd\u09a4\u09b0 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09bf, \u098f\u09ac\u0982 \u0995\u09c0\u09ad\u09be\u09ac\u09c7?", "answer": "\u0939\u093e\u0902, \u0906\u092a \u0915\u094d\u0932\u093e\u0909\u0921 \u0938\u0947\u0935\u093f\u0902\u0917 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0905\u092a\u0928\u0947 \u0938\u093f\u091f\u0940 \u092c\u094d\u0932\u0949\u0915\u094d\u0938 \u0938\u0947\u0935 \u0921\u0947\u091f\u093e \u0915\u094b \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0938\u094d\u0925\u093e\u0928\u093e\u0902\u0924\u0930\u093f\u0924 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u091a\u0930\u0923 1 - \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f \u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u0917\u0947\u092e \u0915\u0947 \u0915\u094d\u0932\u093e\u0909\u0921 \u0938\u0947\u0935\u093e \u0938\u0947 \u091c\u0941\u0921\u093c\u093e \u090f\u0915 \u0916\u093e\u0924\u093e \u0939\u0948\u0964 \u091a\u0930\u0923 2 - \u0905\u092a\u0928\u0947 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u0930 \u0905\u092a\u0928\u0947 \u0917\u0947\u092e \u092a\u094d\u0930\u0917\u0924\u093f \u0915\u094b \u0915\u094d\u0932\u093e\u0909\u0921 \u092a\u0930 \u0938\u0939\u0947\u091c\u0947\u0902\u0964 \u091a\u0930\u0923 3 - \u0928\u090f \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u0930 \u0909\u0938\u0940 \u0916\u093e\u0924\u0947 \u092e\u0947\u0902 \u0932\u0949\u0917 \u0907\u0928 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0915\u094d\u0932\u093e\u0909\u0921 \u0938\u0947\u0935 \u0932\u094b\u0921 \u0915\u0930\u0947\u0902\u0964 \u0909\u0926\u093e\u0939\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f, \u092f\u0926\u093f \u0906\u092a \u092a\u0940\u0938\u0940 \u0938\u0947 \u092e\u094b\u092c\u093e\u0907\u0932 \u092a\u0930 \u091c\u093e \u0930\u0939\u0947 \u0939\u0948\u0902, \u0924\u094b \u092c\u0938 \u092e\u094b\u092c\u093e\u0907\u0932 \u0910\u092a \u092a\u0930 \u0905\u092a\u0928\u0947 \u0916\u093e\u0924\u0947 \u092e\u0947\u0902 \u0932\u0949\u0917 \u0907\u0928 \u0915\u0930\u0947\u0902 \u0924\u093e\u0915\u093f \u0906\u092a \u0905\u092a\u0928\u0947 \u0938\u0939\u0947\u091c\u0947 \u0917\u090f \u0936\u0939\u0930 \u0924\u0915 \u092a\u0939\u0941\u0901\u091a \u0938\u0915\u0947\u0902\u0964"}, {"question": "\u09b8\u09bf\u099f\u09bf \u09ac\u09cd\u09b2\u0995\u09b8\u09c7 \u0995\u09cb\u09a8 \u0997\u09cb\u09aa\u09a8 \u0987\u09b8\u09cd\u099f\u09be\u09b0 \u098f\u0997 \u09ac\u09be \u0997\u09cb\u09aa\u09a8 \u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af\u0997\u09c1\u09b2\u09bf \u0986\u09ae\u09bf \u0986\u09ac\u09bf\u09b7\u09cd\u0995\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09bf?", "answer": "\u09b8\u09bf\u099f\u09bf \u09ac\u09cd\u09b2\u0995\u09b8\u09c7 \u0996\u09c7\u09b2\u09cb\u09af\u09bc\u09be\u09a1\u09bc\u09b0\u09be \u0986\u09ac\u09bf\u09b7\u09cd\u0995\u09be\u09b0 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09ac\u09c7\u09b6 \u0995\u09af\u09bc\u09c7\u0995\u099f\u09bf \u0997\u09cb\u09aa\u09a8 \u0987\u09b8\u09cd\u099f\u09be\u09b0 \u098f\u0997 \u098f\u09ac\u0982 \u0997\u09cb\u09aa\u09a8 \u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af \u09b0\u09af\u09bc\u09c7\u099b\u09c7\u0964 \u098f\u0995\u099f\u09bf \u0989\u09b2\u09cd\u09b2\u09c7\u0996\u09af\u09cb\u0997\u09cd\u09af \u0989\u09a6\u09be\u09b9\u09b0\u09a3 \u09b9\u09b2 '\u09b8\u09cb\u09a8\u09be\u09b0 \u09ae\u09c2\u09b0\u09cd\u09a4\u09bf', \u09af\u09be 30 \u099f\u09bf \u09a7\u09be\u09b0\u09be\u09ac\u09be\u09b9\u09bf\u0995 \u09a6\u09bf\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af 95% \u09b8\u09c1\u0996\u09c7\u09b0 \u09ae\u09be\u09a4\u09cd\u09b0\u09be \u0985\u09b0\u09cd\u099c\u09a8 \u0995\u09b0\u09c7 \u0989\u09a8\u09cd\u09ae\u09c1\u0995\u09cd\u09a4 \u0995\u09b0\u09be \u09af\u09be\u09af\u09bc\u0964 \u0986\u09b0\u09c7\u0995\u099f\u09bf \u09b9\u09b2 '\u09b0\u09b9\u09b8\u09cd\u09af\u09ae\u09af\u09bc \u09ae\u09c7\u099f\u09cd\u09b0\u09cb', \u098f\u0995\u099f\u09bf \u0997\u09cb\u09aa\u09a8 \u09aa\u09b0\u09bf\u09ac\u09b9\u09a8 \u09ac\u09bf\u0995\u09b2\u09cd\u09aa \u09af\u09be 50 \u099f\u09bf \u09ae\u09c7\u099f\u09cd\u09b0\u09cb \u09b8\u09cd\u099f\u09c7\u09b6\u09a8 \u09a4\u09c8\u09b0\u09bf\u09b0 \u09aa\u09b0\u09c7 \u09a6\u09c7\u0996\u09be \u09af\u09be\u09af\u09bc\u0964 \u098f\u0987 \u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af\u0997\u09c1\u09b2\u09bf \u0997\u09c7\u09ae\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u09a6\u09bf\u0995 \u0985\u09a8\u09cd\u09ac\u09c7\u09b7\u09a3\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09a8\u09bf\u09ac\u09c7\u09a6\u09bf\u09a4 \u0996\u09c7\u09b2\u09cb\u09af\u09bc\u09be\u09a1\u09bc\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u098f\u0995\u099f\u09bf \u0986\u09a8\u09a8\u09cd\u09a6 \u098f\u09ac\u0982 \u09aa\u09c1\u09b0\u09b8\u09cd\u0995\u09be\u09b0\u09c7\u09b0 \u09b8\u09cd\u09a4\u09b0 \u09af\u09c1\u0995\u09cd\u09a4 \u0995\u09b0\u09c7\u0964"}]
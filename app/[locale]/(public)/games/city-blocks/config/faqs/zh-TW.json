[{"question": "\u65b0\u624b\u5982\u4f55\u958b\u59cb\u5728\u300a\u57ce\u5e02\u65b9\u584a\u300b\u4e2d\u5efa\u9020\u7b2c\u4e00\u5ea7\u57ce\u5e02\uff1f", "answer": "\u8981\u958b\u59cb\u5728\u300a\u57ce\u5e02\u65b9\u584a\u300b\u4e2d\u5efa\u9020\u7b2c\u4e00\u5ea7\u57ce\u5e02\uff0c\u8acb\u9075\u5faa\u9019\u4e9b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u9078\u64c7\u4e00\u584a\u5e73\u5766\u7684\u5730\u5340\u653e\u7f6e\u5e02\u653f\u5ef3\uff0c\u9019\u662f\u6838\u5fc3\u5efa\u7bc9\u3002\u6b65\u9a5f2 - \u5c07\u9053\u8def\u9023\u63a5\u5230\u5e02\u653f\u5ef3\uff0c\u4ee5\u4fbf\u5176\u4ed6\u5efa\u7bc9\u7269\u80fd\u5920\u901a\u884c\u3002\u6b65\u9a5f3 - \u5728\u9053\u8def\u9644\u8fd1\u958b\u59cb\u653e\u7f6e\u4f4f\u5b85\u5340\u3002\u4f8b\u5982\uff0c\u653e\u7f6e\u300c\u90ca\u5340\u4f4f\u5b85\u300d\u5c07\u958b\u59cb\u5438\u5f15\u5c45\u6c11\u3002\u8acb\u8a18\u5f97\u5e73\u8861\u4f4f\u5b85\u3001\u5546\u696d\u548c\u5de5\u696d\u5340\uff0c\u4ee5\u5be6\u73fe\u6700\u4f73\u7684\u57ce\u5e02\u767c\u5c55\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u5728\u300a\u57ce\u5e02\u65b9\u584a\u300b\u4e2d\u7684\u57ce\u5e02\u6c92\u6709\u767c\u5c55\uff0c\u5118\u7ba1\u6709\u8db3\u5920\u7684\u4f4f\u5b85\u5340\uff1f", "answer": "\u5982\u679c\u60a8\u7684\u300a\u57ce\u5e02\u65b9\u584a\u300b\u57ce\u5e02\u6c92\u6709\u767c\u5c55\uff0c\u8acb\u6aa2\u67e5\u4ee5\u4e0b\u56e0\u7d20\uff1a\u6b65\u9a5f1 - \u78ba\u4fdd\u60a8\u7684\u4f4f\u5b85\u5340\u9023\u63a5\u5230\u9053\u8def\uff0c\u4e26\u64c1\u6709\u5982\u6c34\u96fb\u7b49\u57fa\u672c\u670d\u52d9\u3002\u6b65\u9a5f2 - \u9a57\u8b49\u5546\u696d\u6216\u5de5\u696d\u5340\u662f\u5426\u6709\u8db3\u5920\u7684\u5de5\u4f5c\u6a5f\u6703\u3002\u6b65\u9a5f3 - \u76e3\u63a7\u5e02\u6c11\u7684\u5e78\u798f\u6307\u6578\uff1b\u4f4e\u5e78\u798f\u6307\u6578\u53ef\u80fd\u6703\u5c0e\u81f4\u767c\u5c55\u505c\u6eef\u3002\u4f8b\u5982\uff0c\u5728\u4f4f\u5b85\u5340\u9644\u8fd1\u6dfb\u52a0\u300c\u516c\u5712\u300d\u53ef\u4ee5\u63d0\u5347\u5e78\u798f\u611f\u4e26\u9f13\u52f5\u4eba\u53e3\u589e\u9577\u3002"}, {"question": "\u300a\u57ce\u5e02\u65b9\u584a\u300b\u4e2d\u4e0d\u540c\u4f4f\u5b85\u5340\u985e\u578b\u4e4b\u9593\u7684\u4e3b\u8981\u5340\u5225\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u300a\u57ce\u5e02\u65b9\u584a\u300b\u4e2d\uff0c\u4f4f\u5b85\u5340\u6839\u64da\u5bc6\u5ea6\u548c\u4eba\u53e3\u5bb9\u91cf\u800c\u6709\u6240\u4e0d\u540c\u3002\u4f4e\u5bc6\u5ea6\u5340\uff0c\u4f8b\u5982\u300c\u90ca\u5340\u4f4f\u5b85\u300d\uff0c\u5bb9\u7d0d\u7684\u4eba\u53e3\u8f03\u5c11\uff0c\u4f46\u5e78\u798f\u611f\u6703\u589e\u52a0\u3002\u4e2d\u5bc6\u5ea6\u5340\uff0c\u4f8b\u5982\u300c\u516c\u5bd3\u5927\u6a13\u300d\uff0c\u5bb9\u7d0d\u7684\u4eba\u53e3\u66f4\u591a\uff0c\u4f46\u4e5f\u9700\u8981\u66f4\u591a\u670d\u52d9\u3002\u9ad8\u5bc6\u5ea6\u5340\uff0c\u4f8b\u5982\u300c\u6469\u5929\u5927\u6a13\u300d\uff0c\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u4e86\u4eba\u53e3\uff0c\u4f46\u53ef\u80fd\u6703\u5c0e\u81f4\u4ea4\u901a\u64c1\u5835\u3002\u4f8b\u5982\uff0c\u5728\u4ea4\u901a\u6d41\u91cf\u4f4e\u7684\u5730\u5340\u653e\u7f6e\u300c\u90ca\u5340\u4f4f\u5b85\u300d\u975e\u5e38\u9069\u5408\u521d\u5b78\u8005\uff0c\u800c\u300c\u6469\u5929\u5927\u6a13\u300d\u66f4\u9069\u5408\u7ba1\u7406\u8907\u96dc\u57ce\u5e02\u4f48\u5c40\u7684\u9ad8\u7d1a\u73a9\u5bb6\u3002"}, {"question": "\u5982\u4f55\u512a\u5316\u300a\u57ce\u5e02\u65b9\u584a\u300b\u5927\u90fd\u5e02\u7684\u4ea4\u901a\u6d41\u91cf\uff1f", "answer": "\u512a\u5316\u300a\u57ce\u5e02\u65b9\u584a\u300b\u7684\u4ea4\u901a\u6d41\u91cf\u9700\u8981\u6709\u7b56\u7565\u7684\u898f\u5283\uff1a\u6b65\u9a5f1 - \u4f7f\u7528\u7db2\u683c\u6216\u8f3b\u5c04\u72c0\u9053\u8def\u4f48\u5c40\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u6e1b\u5c11\u4ea4\u53c9\u53e3\u3002\u6b65\u9a5f2 - \u5728\u4ea4\u901a\u6d41\u91cf\u9ad8\u7684\u5340\u57df\u9644\u8fd1\u653e\u7f6e\u516c\u5171\u4ea4\u901a\u5de5\u5177\uff0c\u4f8b\u5982\u5df4\u58eb\u7ad9\u3002\u6b65\u9a5f3 - \u5c07\u9053\u8def\u5347\u7d1a\u70ba\u9ad8\u901f\u516c\u8def\u6216\u6dfb\u52a0\u55ae\u884c\u9053\uff0c\u4ee5\u6e1b\u5c11\u64c1\u5835\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u9ad8\u901f\u516c\u8def\u5c07\u5de5\u696d\u5340\u9023\u63a5\u5230\u5546\u696d\u5340\uff0c\u53ef\u4ee5\u986f\u8457\u6e1b\u5c11\u4ea4\u901a\u74f6\u9838\u3002"}, {"question": "\u6211\u53ef\u4ee5\u4f7f\u7528\u54ea\u4e9b\u5148\u9032\u7b56\u7565\u4f86\u6700\u5927\u5316\u300a\u57ce\u5e02\u65b9\u584a\u300b\u7684\u6536\u5165\uff1f", "answer": "\u8981\u5728\u300a\u57ce\u5e02\u65b9\u584a\u300b\u4e2d\u6700\u5927\u5316\u6536\u5165\uff0c\u8acb\u8003\u616e\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9a5f1 - \u96c6\u4e2d\u65bc\u9ad8\u5bc6\u5ea6\u5546\u696d\u5340\uff0c\u4f8b\u5982\u300c\u8cfc\u7269\u4e2d\u5fc3\u300d\uff0c\u4ee5\u7522\u751f\u66f4\u591a\u6536\u5165\u3002\u6b65\u9a5f2 - \u6295\u8cc7\u65bc\u89c0\u5149\u696d\uff0c\u5efa\u9020\u5730\u6a19\u6027\u5efa\u7bc9\uff0c\u4f8b\u5982\u300c\u57ce\u5e02\u5854\u300d\u3002\u6b65\u9a5f3 - \u8b39\u614e\u5e73\u8861\u7a05\u6536\uff1b\u7a05\u7387\u904e\u9ad8\uff0c\u5e02\u6c11\u6703\u642c\u8d70\uff1b\u7a05\u7387\u904e\u4f4e\uff0c\u6536\u5165\u6703\u4e0b\u964d\u3002\u4f8b\u5982\uff0c\u5728\u5c45\u6c11\u5e78\u798f\u6307\u6578\u9ad8\u4e14\u9130\u8fd1\u4f4f\u5b85\u5340\u7684\u5340\u57df\u653e\u7f6e\u300c\u8cfc\u7269\u4e2d\u5fc3\u300d\u53ef\u4ee5\u7522\u751f\u53ef\u89c0\u7684\u5229\u6f64\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u57ce\u5e02\u65b9\u584a\u300b\u4e2d\u6709\u6548\u7ba1\u7406\u6c61\u67d3\u6c34\u5e73\uff1f", "answer": "\u5728\u300a\u57ce\u5e02\u65b9\u584a\u300b\u4e2d\u7ba1\u7406\u6c61\u67d3\u9700\u8981\u591a\u6b65\u9a5f\u65b9\u6cd5\uff1a\u6b65\u9a5f1 - \u5c07\u5de5\u696d\u5340\u8207\u4f4f\u5b85\u5340\u9694\u958b\uff0c\u4e26\u4f7f\u7528\u6a39\u6728\u6216\u516c\u5712\u4f5c\u70ba\u7de9\u885d\u5340\u3002\u6b65\u9a5f2 - \u5c07\u5de5\u696d\u5efa\u7bc9\u5347\u7d1a\u70ba\u66f4\u74b0\u4fdd\u7684\u6280\u8853\uff0c\u4f8b\u5982\u300c\u74b0\u4fdd\u5de5\u5ee0\u300d\u3002\u6b65\u9a5f3 - \u6295\u8cc7\u516c\u5171\u4ea4\u901a\u5de5\u5177\u4ee5\u6e1b\u5c11\u8eca\u8f1b\u6392\u653e\u3002\u4f8b\u5982\uff0c\u7528\u300c\u592a\u967d\u80fd\u8fb2\u5834\u300d\u53d6\u4ee3\u300c\u71c3\u7164\u96fb\u5ee0\u300d\u53ef\u4ee5\u986f\u8457\u964d\u4f4e\u6c61\u67d3\u6c34\u5e73\u3002"}, {"question": "\u300a\u57ce\u5e02\u65b9\u584a\u300b\u4e2d\u5e78\u798f\u6307\u6578\u7684\u4f5c\u7528\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff1f", "answer": "\u300a\u57ce\u5e02\u65b9\u584a\u300b\u4e2d\u7684\u5e78\u798f\u6307\u6578\u53cd\u6620\u4e86\u5e02\u6c11\u7684\u6eff\u610f\u5ea6\uff0c\u4e26\u76f4\u63a5\u5f71\u97ff\u57ce\u5e02\u767c\u5c55\u548c\u6536\u5165\u3002\u9ad8\u5e78\u798f\u6307\u6578\u6703\u589e\u52a0\u4eba\u53e3\u589e\u9577\u548c\u7a05\u6536\u6536\u5165\uff0c\u800c\u4f4e\u5e78\u798f\u6307\u6578\u5247\u53ef\u80fd\u5c0e\u81f4\u5e02\u6c11\u5916\u6d41\u3002\u5f71\u97ff\u5e78\u798f\u611f\u7684\u56e0\u7d20\u5305\u62ec\u670d\u52d9\u7684\u53ef\u53ca\u6027\u3001\u4f4e\u6c61\u67d3\u548c\u9644\u8fd1\u516c\u5712\u3002\u4f8b\u5982\uff0c\u5728\u4f4f\u5b85\u5340\u9644\u8fd1\u653e\u7f6e\u300c\u793e\u5340\u4e2d\u5fc3\u300d\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u5e78\u798f\u611f\uff0c\u4e26\u6539\u5584\u6574\u9ad4\u57ce\u5e02\u8868\u73fe\u3002"}, {"question": "\u300a\u57ce\u5e02\u65b9\u584a\u300b\u4e2d\u7684\u5206\u5340\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff0c\u5176\u80cc\u5f8c\u7684\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "\u300a\u57ce\u5e02\u65b9\u584a\u300b\u7684\u5206\u5340\u7cfb\u7d71\u5206\u70ba\u4f4f\u5b85\u5340\u3001\u5546\u696d\u5340\u548c\u5de5\u696d\u5340\uff0c\u6bcf\u500b\u5340\u90fd\u5177\u6709\u4e0d\u540c\u7684\u529f\u80fd\u3002\u4f4f\u5b85\u5340\u5bb9\u7d0d\u5e02\u6c11\uff0c\u5546\u696d\u5340\u7522\u751f\u6536\u5165\uff0c\u5de5\u696d\u5340\u63d0\u4f9b\u5de5\u4f5c\u548c\u8cc7\u6e90\u3002\u8a72\u7cfb\u7d71\u4f9d\u8cf4\u65bc\u9130\u8fd1\u6027\u548c\u9023\u901a\u6027\uff1b\u4f8b\u5982\uff0c\u5728\u4f4f\u5b85\u5340\u9644\u8fd1\u653e\u7f6e\u5546\u696d\u5340\uff0c\u78ba\u4fdd\u5e02\u6c11\u53ef\u4ee5\u8f15\u9b06\u5730\u524d\u5f80\u5546\u5e97\u3002\u6b64\u5916\uff0c\u5340\u57df\u5bc6\u5ea6\uff08\u4f4e\u3001\u4e2d\u3001\u9ad8\uff09\u6703\u5f71\u97ff\u4eba\u53e3\u5bb9\u91cf\u548c\u8cc7\u6e90\u9700\u6c42\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e4b\u9593\u8f49\u79fb\u6211\u7684\u300a\u57ce\u5e02\u65b9\u584a\u300b\u5132\u5b58\u6578\u64da\u55ce\uff1f\u5982\u679c\u53ef\u4ee5\uff0c\u5982\u4f55\u8f49\u79fb\uff1f", "answer": "\u662f\u7684\uff0c\u60a8\u53ef\u4ee5\u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e4b\u9593\u8f49\u79fb\u300a\u57ce\u5e02\u65b9\u584a\u300b\u5132\u5b58\u6578\u64da\u3002\u6b65\u9a5f1 - \u78ba\u4fdd\u60a8\u5df2\u5c07\u5e33\u6236\u9023\u7d50\u5230\u904a\u6232\u7684\u96f2\u7aef\u670d\u52d9\u3002\u6b65\u9a5f2 - \u5728\u60a8\u7576\u524d\u5e73\u53f0\u5c07\u904a\u6232\u9032\u5ea6\u5132\u5b58\u5230\u96f2\u7aef\u3002\u6b65\u9a5f3 - \u5728\u65b0\u5e73\u53f0\u767b\u5165\u76f8\u540c\u7684\u5e33\u6236\u4e26\u8f09\u5165\u96f2\u7aef\u5132\u5b58\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u8981\u628a\u904a\u6232\u5f9e\u96fb\u8166\u5e73\u53f0\u8f49\u79fb\u5230\u624b\u6a5f\u5e73\u53f0\uff0c\u53ea\u9700\u5728\u624b\u6a5f\u61c9\u7528\u7a0b\u5f0f\u4e0a\u767b\u5165\u60a8\u7684\u5e33\u6236\u5373\u53ef\u5b58\u53d6\u60a8\u5132\u5b58\u7684\u57ce\u5e02\u3002"}, {"question": "\u5728\u300a\u57ce\u5e02\u65b9\u584a\u300b\u4e2d\uff0c\u6211\u53ef\u4ee5\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\u6216\u79d8\u5bc6\u529f\u80fd\uff1f", "answer": "\u300a\u57ce\u5e02\u65b9\u584a\u300b\u5305\u542b\u4e00\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\u548c\u79d8\u5bc6\u529f\u80fd\uff0c\u4f9b\u73a9\u5bb6\u63a2\u7d22\u767c\u73fe\u3002\u4e00\u500b\u503c\u5f97\u6ce8\u610f\u7684\u4f8b\u5b50\u662f\u300c\u9ec3\u91d1\u96d5\u50cf\u300d\uff0c\u73a9\u5bb6\u53ef\u4ee5\u900f\u904e\u9023\u7e8c 30 \u5929\u5c07\u5e78\u798f\u6307\u6578\u7dad\u6301\u5728 95% \u4f86\u89e3\u9396\u3002\u53e6\u4e00\u500b\u662f\u300c\u795e\u79d8\u5730\u9435\u300d\uff0c\u4e00\u7a2e\u96b1\u85cf\u7684\u4ea4\u901a\u9078\u9805\uff0c\u5728\u5efa\u9020 50 \u500b\u5730\u9435\u7ad9\u5f8c\u51fa\u73fe\u3002\u9019\u4e9b\u529f\u80fd\u70ba\u5c08\u6ce8\u65bc\u63a2\u7d22\u904a\u6232\u6240\u6709\u5c64\u9762\u7684\u71b1\u8877\u73a9\u5bb6\u589e\u6dfb\u4e86\u6a02\u8da3\u548c\u734e\u52f5\u3002"}]
[{"question": "\u6211\u5982\u4f55\u4f5c\u4e3a\u65b0\u624b\u5728\u300a\u57ce\u5e02\u65b9\u5757\u300b\u4e2d\u5f00\u59cb\u5efa\u9020\u6211\u7684\u7b2c\u4e00\u4e2a\u57ce\u5e02\uff1f", "answer": "\u8981\u5728\u300a\u57ce\u5e02\u65b9\u5757\u300b\u4e2d\u5f00\u59cb\u5efa\u9020\u4f60\u7684\u7b2c\u4e00\u4e2a\u57ce\u5e02\uff0c\u8bf7\u9075\u5faa\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u9009\u62e9\u4e00\u5757\u5e73\u5766\u7684\u533a\u57df\u653e\u7f6e\u5e02\u653f\u5385\uff0c\u8fd9\u662f\u6838\u5fc3\u5efa\u7b51\u3002\u6b65\u9aa42 - \u5c06\u9053\u8def\u8fde\u63a5\u5230\u5e02\u653f\u5385\uff0c\u4ee5\u4fbf\u5176\u4ed6\u5efa\u7b51\u7269\u80fd\u591f\u901a\u884c\u3002\u6b65\u9aa43 - \u5f00\u59cb\u5728\u9053\u8def\u9644\u8fd1\u653e\u7f6e\u4f4f\u5b85\u533a\u3002\u4f8b\u5982\uff0c\u653e\u7f6e\u201c\u90ca\u533a\u4f4f\u5b85\u201d\u5c06\u5f00\u59cb\u5438\u5f15\u5c45\u6c11\u3002\u8bb0\u4f4f\u8981\u5e73\u8861\u4f4f\u5b85\u3001\u5546\u4e1a\u548c\u5de5\u4e1a\u533a\uff0c\u4ee5\u5b9e\u73b0\u6700\u4f73\u589e\u957f\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u7684\u300a\u57ce\u5e02\u65b9\u5757\u300b\u57ce\u5e02\u5c3d\u7ba1\u6709\u8db3\u591f\u7684\u4f4f\u5b85\u533a\u5374\u65e0\u6cd5\u589e\u957f\uff1f", "answer": "\u5982\u679c\u4f60\u7684\u300a\u57ce\u5e02\u65b9\u5757\u300b\u57ce\u5e02\u6ca1\u6709\u589e\u957f\uff0c\u8bf7\u68c0\u67e5\u4ee5\u4e0b\u56e0\u7d20\uff1a\u6b65\u9aa41 - \u786e\u4fdd\u4f60\u7684\u4f4f\u5b85\u533a\u8fde\u63a5\u5230\u9053\u8def\uff0c\u5e76\u53ef\u4ee5\u83b7\u5f97\u57fa\u672c\u670d\u52a1\uff0c\u4f8b\u5982\u6c34\u548c\u7535\u529b\u3002\u6b65\u9aa42 - \u786e\u8ba4\u5546\u4e1a\u6216\u5de5\u4e1a\u533a\u6709\u8db3\u591f\u7684\u5de5\u4f5c\u5c97\u4f4d\u3002\u6b65\u9aa43 - \u76d1\u63a7\u5c45\u6c11\u7684\u5e78\u798f\u6307\u6570\uff1b\u5e78\u798f\u6307\u6570\u4f4e\u4f1a\u963b\u788d\u589e\u957f\u3002\u4f8b\u5982\uff0c\u5728\u4f4f\u5b85\u533a\u9644\u8fd1\u6dfb\u52a0\u201c\u516c\u56ed\u201d\u53ef\u4ee5\u63d0\u5347\u5e78\u798f\u6307\u6570\u5e76\u9f13\u52b1\u4eba\u53e3\u589e\u957f\u3002"}, {"question": "\u300a\u57ce\u5e02\u65b9\u5757\u300b\u4e2d\u7684\u4f4f\u5b85\u533a\u7c7b\u578b\u4e4b\u95f4\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u5728\u300a\u57ce\u5e02\u65b9\u5757\u300b\u4e2d\uff0c\u4f4f\u5b85\u533a\u6839\u636e\u5bc6\u5ea6\u548c\u4eba\u53e3\u5bb9\u91cf\u800c\u6709\u6240\u4e0d\u540c\u3002\u4f4e\u5bc6\u5ea6\u533a\u5982\u201c\u90ca\u533a\u4f4f\u5b85\u201d\u5bb9\u7eb3\u7684\u4eba\u53e3\u8f83\u5c11\uff0c\u4f46\u5e78\u798f\u611f\u4f1a\u63d0\u9ad8\u3002\u4e2d\u7b49\u5bc6\u5ea6\u533a\u5982\u201c\u516c\u5bd3\u697c\u201d\u5bb9\u7eb3\u7684\u4eba\u53e3\u66f4\u591a\uff0c\u4f46\u9700\u8981\u66f4\u591a\u670d\u52a1\u3002\u9ad8\u5bc6\u5ea6\u533a\u5982\u201c\u6469\u5929\u5927\u697c\u201d\u6700\u5927\u5316\u4eba\u53e3\uff0c\u4f46\u53ef\u80fd\u4f1a\u9020\u6210\u4ea4\u901a\u62e5\u5835\u3002\u4f8b\u5982\uff0c\u5c06\u201c\u90ca\u533a\u4f4f\u5b85\u201d\u7f6e\u4e8e\u4ea4\u901a\u91cf\u4f4e\u7684\u533a\u57df\u5bf9\u4e8e\u65b0\u624b\u6765\u8bf4\u662f\u7406\u60f3\u7684\u9009\u62e9\uff0c\u800c\u201c\u6469\u5929\u5927\u697c\u201d\u66f4\u9002\u5408\u7ba1\u7406\u590d\u6742\u57ce\u5e02\u5e03\u5c40\u7684\u9ad8\u7ea7\u73a9\u5bb6\u3002"}, {"question": "\u5982\u4f55\u4f18\u5316\u6211\u7684\u300a\u57ce\u5e02\u65b9\u5757\u300b\u5927\u90fd\u5e02\u7684\u4ea4\u901a\u6d41\u91cf\uff1f", "answer": "\u4f18\u5316\u300a\u57ce\u5e02\u65b9\u5757\u300b\u4e2d\u7684\u4ea4\u901a\u6d41\u91cf\u9700\u8981\u8fdb\u884c\u6218\u7565\u89c4\u5212\uff1a\u6b65\u9aa41 - \u4f7f\u7528\u7f51\u683c\u6216\u653e\u5c04\u72b6\u9053\u8def\u5e03\u5c40\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u4ea4\u53c9\u53e3\u3002\u6b65\u9aa42 - \u5728\u9ad8\u6d41\u91cf\u533a\u57df\u9644\u8fd1\u653e\u7f6e\u516c\u5171\u4ea4\u901a\u5de5\u5177\uff0c\u4f8b\u5982\u516c\u4ea4\u8f66\u7ad9\u3002\u6b65\u9aa43 - \u5c06\u9053\u8def\u5347\u7ea7\u4e3a\u9ad8\u901f\u516c\u8def\u6216\u6dfb\u52a0\u5355\u884c\u9053\u4ee5\u51cf\u5c11\u62e5\u5835\u3002\u4f8b\u5982\uff0c\u7528\u9ad8\u901f\u516c\u8def\u8fde\u63a5\u5de5\u4e1a\u533a\u548c\u5546\u4e1a\u533a\u53ef\u4ee5\u663e\u8457\u51cf\u5c11\u4ea4\u901a\u74f6\u9888\u3002"}, {"question": "\u6211\u53ef\u4ee5\u4f7f\u7528\u54ea\u4e9b\u9ad8\u7ea7\u7b56\u7565\u6765\u6700\u5927\u5316\u300a\u57ce\u5e02\u65b9\u5757\u300b\u4e2d\u7684\u6536\u5165\uff1f", "answer": "\u8981\u5728\u300a\u57ce\u5e02\u65b9\u5757\u300b\u4e2d\u6700\u5927\u5316\u6536\u5165\uff0c\u8bf7\u8003\u8651\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9aa41 - \u4e13\u6ce8\u4e8e\u9ad8\u5bc6\u5ea6\u5546\u4e1a\u533a\uff0c\u4f8b\u5982\u201c\u8d2d\u7269\u4e2d\u5fc3\u201d\uff0c\u4ee5\u521b\u9020\u66f4\u591a\u6536\u5165\u3002\u6b65\u9aa42 - \u901a\u8fc7\u5efa\u9020\u5730\u6807\u6027\u5efa\u7b51\u7269\uff0c\u4f8b\u5982\u201c\u57ce\u5e02\u5854\u201d\uff0c\u6765\u6295\u8d44\u65c5\u6e38\u4e1a\u3002\u6b65\u9aa43 - \u8c28\u614e\u5e73\u8861\u7a0e\u6536\uff1b\u7a0e\u7387\u8fc7\u9ad8\uff0c\u516c\u6c11\u4f1a\u79bb\u5f00\uff1b\u7a0e\u7387\u8fc7\u4f4e\uff0c\u6536\u5165\u4f1a\u4e0b\u964d\u3002\u4f8b\u5982\uff0c\u5728\u62e5\u6709\u9ad8\u5e78\u798f\u6307\u6570\u7684\u4f4f\u5b85\u533a\u9644\u8fd1\u653e\u7f6e\u201c\u8d2d\u7269\u4e2d\u5fc3\u201d\u53ef\u4ee5\u4ea7\u751f\u53ef\u89c2\u7684\u5229\u6da6\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u57ce\u5e02\u65b9\u5757\u300b\u4e2d\u6709\u6548\u5730\u7ba1\u7406\u6c61\u67d3\u6c34\u5e73\uff1f", "answer": "\u5728\u300a\u57ce\u5e02\u65b9\u5757\u300b\u4e2d\u7ba1\u7406\u6c61\u67d3\u9700\u8981\u591a\u6b65\u9aa4\u65b9\u6cd5\uff1a\u6b65\u9aa41 - \u5c06\u5de5\u4e1a\u533a\u8fdc\u79bb\u4f4f\u5b85\u533a\uff0c\u5e76\u4f7f\u7528\u6811\u6728\u6216\u516c\u56ed\u4f5c\u4e3a\u7f13\u51b2\u3002\u6b65\u9aa42 - \u5c06\u5de5\u4e1a\u5efa\u7b51\u5347\u7ea7\u4e3a\u66f4\u6e05\u6d01\u7684\u6280\u672f\uff0c\u4f8b\u5982\u201c\u73af\u4fdd\u5de5\u5382\u201d\u3002\u6b65\u9aa43 - \u6295\u8d44\u516c\u5171\u4ea4\u901a\u4ee5\u51cf\u5c11\u8f66\u8f86\u6392\u653e\u3002\u4f8b\u5982\uff0c\u7528\u201c\u592a\u9633\u80fd\u519c\u573a\u201d\u66ff\u6362\u201c\u7164\u70ad\u53d1\u7535\u5382\u201d\u53ef\u4ee5\u5927\u5e45\u964d\u4f4e\u6c61\u67d3\u6c34\u5e73\u3002"}, {"question": "\u5e78\u798f\u5ea6\u8ba1\u5728\u300a\u57ce\u5e02\u65b9\u5757\u300b\u4e2d\u7684\u4f5c\u7528\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\uff1f", "answer": "\u300a\u57ce\u5e02\u65b9\u5757\u300b\u4e2d\u7684\u5e78\u798f\u5ea6\u53cd\u6620\u4e86\u516c\u6c11\u7684\u6ee1\u610f\u5ea6\uff0c\u5e76\u76f4\u63a5\u5f71\u54cd\u57ce\u5e02\u53d1\u5c55\u548c\u6536\u5165\u3002\u9ad8\u5e78\u798f\u6307\u6570\u4f1a\u589e\u52a0\u4eba\u53e3\u589e\u957f\u548c\u7a0e\u6536\u6536\u5165\uff0c\u800c\u4f4e\u5e78\u798f\u6307\u6570\u5219\u4f1a\u5bfc\u81f4\u516c\u6c11\u5916\u6d41\u3002\u5f71\u54cd\u5e78\u798f\u611f\u7684\u56e0\u7d20\u5305\u62ec\u83b7\u5f97\u670d\u52a1\u7684\u4fbf\u5229\u6027\u3001\u4f4e\u6c61\u67d3\u548c\u9644\u8fd1\u7684\u516c\u56ed\u3002\u4f8b\u5982\uff0c\u5728\u4f4f\u5b85\u533a\u9644\u8fd1\u653e\u7f6e\u201c\u793e\u533a\u4e2d\u5fc3\u201d\u53ef\u4ee5\u663e\u8457\u63d0\u5347\u5e78\u798f\u611f\u5e76\u6539\u5584\u6574\u4f53\u57ce\u5e02\u8868\u73b0\u3002"}, {"question": "\u300a\u57ce\u5e02\u65b9\u5757\u300b\u4e2d\u7684\u5206\u533a\u7cfb\u7edf\u5982\u4f55\u8fd0\u4f5c\uff0c\u4ee5\u53ca\u5176\u80cc\u540e\u7684\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u57ce\u5e02\u65b9\u5757\u300b\u7684\u5206\u533a\u7cfb\u7edf\u5206\u4e3a\u4f4f\u5b85\u533a\u3001\u5546\u4e1a\u533a\u548c\u5de5\u4e1a\u533a\uff0c\u6bcf\u4e2a\u533a\u57df\u90fd\u6709\u4e0d\u540c\u7684\u7528\u9014\u3002\u4f4f\u5b85\u533a\u5bb9\u7eb3\u516c\u6c11\uff0c\u5546\u4e1a\u533a\u4ea7\u751f\u6536\u5165\uff0c\u5de5\u4e1a\u533a\u63d0\u4f9b\u5de5\u4f5c\u5c97\u4f4d\u548c\u8d44\u6e90\u3002\u8be5\u7cfb\u7edf\u4f9d\u8d56\u4e8e\u90bb\u8fd1\u6027\u548c\u8fde\u901a\u6027\uff1b\u4f8b\u5982\uff0c\u5728\u4f4f\u5b85\u533a\u9644\u8fd1\u653e\u7f6e\u5546\u4e1a\u533a\u53ef\u4ee5\u786e\u4fdd\u516c\u6c11\u53ef\u4ee5\u65b9\u4fbf\u5730\u524d\u5f80\u5546\u5e97\u3002\u6b64\u5916\uff0c\u533a\u57df\u5bc6\u5ea6\uff08\u4f4e\u3001\u4e2d\u3001\u9ad8\uff09\u4f1a\u5f71\u54cd\u4eba\u53e3\u5bb9\u91cf\u548c\u8d44\u6e90\u9700\u6c42\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u6211\u7684\u300a\u57ce\u5e02\u65b9\u5757\u300b\u5b58\u6863\u6570\u636e\u5417\uff0c\u4ee5\u53ca\u5982\u4f55\u64cd\u4f5c\uff1f", "answer": "\u662f\u7684\uff0c\u60a8\u53ef\u4ee5\u4f7f\u7528\u4e91\u5b58\u6863\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u60a8\u7684\u300a\u57ce\u5e02\u65b9\u5757\u300b\u5b58\u6863\u6570\u636e\u3002\u6b65\u9aa41 - \u786e\u4fdd\u60a8\u5df2\u5c06\u5e10\u6237\u94fe\u63a5\u5230\u6e38\u620f\u7684\u4e91\u670d\u52a1\u3002\u6b65\u9aa42 - \u5728\u5f53\u524d\u5e73\u53f0\u4e0a\u5c06\u6e38\u620f\u8fdb\u5ea6\u4fdd\u5b58\u5230\u4e91\u7aef\u3002\u6b65\u9aa43 - \u767b\u5f55\u5230\u65b0\u5e73\u53f0\u4e0a\u7684\u540c\u4e00\u5e10\u6237\u5e76\u52a0\u8f7d\u4e91\u5b58\u6863\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u8981\u4ece\u7535\u8111\u8f6c\u79fb\u5230\u624b\u673a\uff0c\u300a\u57ce\u5e02\u65b9\u5757\u300b\u6e38\u620f\u4e2d\u53ea\u8981\u767b\u5f55\u5230\u624b\u673a\u5e94\u7528\u4e0a\u7684\u540c\u4e00\u4e2a\u5e10\u6237\uff0c\u5c31\u53ef\u4ee5\u8bbf\u95ee\u60a8\u7684\u4fdd\u5b58\u57ce\u5e02\u3002"}, {"question": "\u6211\u5728\u300a\u57ce\u5e02\u65b9\u5757\u300b\u4e2d\u53ef\u4ee5\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u7684\u5f69\u86cb\u6216\u79d8\u5bc6\u529f\u80fd\uff1f", "answer": "\u300a\u57ce\u5e02\u65b9\u5757\u300b\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u7684\u5f69\u86cb\u548c\u79d8\u5bc6\u529f\u80fd\uff0c\u7b49\u5f85\u73a9\u5bb6\u53bb\u53d1\u73b0\u3002\u4e00\u4e2a\u503c\u5f97\u6ce8\u610f\u7684\u4f8b\u5b50\u662f\u201c\u9ec4\u91d1\u96d5\u50cf\u201d\uff0c\u5b83\u53ef\u4ee5\u901a\u8fc7\u8fde\u7eed30\u5929\u8ba9\u5e78\u798f\u6307\u6570\u8fbe\u523095%\u6765\u89e3\u9501\u3002\u53e6\u4e00\u4e2a\u662f\u201c\u795e\u79d8\u5730\u94c1\u201d\uff0c\u5728\u5efa\u902050\u4e2a\u5730\u94c1\u7ad9\u540e\u51fa\u73b0\u7684\u9690\u85cf\u4ea4\u901a\u9009\u9879\u3002\u8fd9\u4e9b\u529f\u80fd\u4e3a\u6709\u8010\u5fc3\u63a2\u7d22\u6e38\u620f\u6240\u6709\u5c42\u9762\u7684\u73a9\u5bb6\u589e\u6dfb\u4e86\u4e50\u8da3\u548c\u5956\u52b1\u3002"}]
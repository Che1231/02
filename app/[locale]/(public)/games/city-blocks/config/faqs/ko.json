[{"question": "\ub3c4\uc2dc \ube14\ub85d\uc5d0\uc11c \ucd08\ubcf4\uc790\uac00 \uccab \ubc88\uc9f8 \ub3c4\uc2dc\ub97c \uc5b4\ub5bb\uac8c \uac74\uc124\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub3c4\uc2dc \ube14\ub85d\uc5d0\uc11c \uccab \ubc88\uc9f8 \ub3c4\uc2dc\ub97c \uac74\uc124\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: 1\ub2e8\uacc4 - \uc2dc\uccad(\ud575\uc2ec \uac74\ubb3c)\uc744 \ubc30\uce58\ud560 \ud3c9\ud3c9\ud55c \uc9c0\uc5ed\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4 - \ub2e4\ub978 \uac74\ubb3c \uc811\uadfc\uc744 \uc704\ud574 \uc2dc\uccad\uc5d0 \ub3c4\ub85c\ub97c \uc5f0\uacb0\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4 - \ub3c4\ub85c \uadfc\ucc98\uc5d0 \uc8fc\uac70 \uc9c0\uc5ed\uc744 \ubc30\uce58\ud558\uae30 \uc2dc\uc791\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc8fc\ud0dd'\uc744 \ubc30\uce58\ud558\uba74 \uc2dc\ubbfc\ub4e4\uc774 \ubaa8\uc774\uae30 \uc2dc\uc791\ud569\ub2c8\ub2e4. \ucd5c\uc801\uc758 \uc131\uc7a5\uc744 \uc704\ud574 \uc8fc\uac70, \uc0c1\uc5c5 \ubc0f \uc0b0\uc5c5 \uc9c0\uc5ed\uc758 \uade0\ud615\uc744 \ub9de\ucd94\ub294 \uac83\uc744 \uae30\uc5b5\ud558\uc138\uc694."}, {"question": "\ub3c4\uc2dc \ube14\ub85d\uc5d0\uc11c \uc8fc\uac70 \uc9c0\uc5ed\uc774 \ucda9\ubd84\ud568\uc5d0\ub3c4 \ubd88\uad6c\ud558\uace0 \ub3c4\uc2dc\uac00 \uc131\uc7a5\ud558\uc9c0 \uc54a\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub3c4\uc2dc \ube14\ub85d\uc5d0\uc11c \ub3c4\uc2dc\uac00 \uc131\uc7a5\ud558\uc9c0 \uc54a\uc73c\uba74 \ub2e4\uc74c \uc694\uc778\uc744 \ud655\uc778\ud558\uc138\uc694: 1\ub2e8\uacc4 - \uc8fc\uac70 \uc9c0\uc5ed\uc774 \ub3c4\ub85c\uc640 \uc5f0\uacb0\ub418\uc5b4 \uc788\uc73c\uba70 \ubb3c\uacfc \uc804\uae30\uc640 \uac19\uc740 \uae30\ubcf8 \uc11c\ube44\uc2a4\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4 - \uc0c1\uc5c5 \ub610\ub294 \uc0b0\uc5c5 \uc9c0\uc5ed\uc5d0 \ucda9\ubd84\ud55c \uc77c\uc790\ub9ac\uac00 \uc788\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4 - \uc2dc\ubbfc\ub4e4\uc758 \ud589\ubcf5 \uc218\uc900\uc744 \ubaa8\ub2c8\ud130\ub9c1\ud569\ub2c8\ub2e4. \ud589\ubcf5 \uc218\uc900\uc774 \ub0ae\uc73c\uba74 \uc131\uc7a5\uc774 \uba48\ucd9c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc8fc\uac70 \uc9c0\uc5ed \uadfc\ucc98\uc5d0 '\uacf5\uc6d0'\uc744 \ucd94\uac00\ud558\uba74 \ud589\ubcf5\ub3c4\uac00 \ub192\uc544\uc9c0\uace0 \uc778\uad6c \uc131\uc7a5\uc744 \ucd09\uc9c4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub3c4\uc2dc \ube14\ub85d\uc5d0\uc11c \uc8fc\uac70 \uc9c0\uc5ed \uc720\ud615 \uac04\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub3c4\uc2dc \ube14\ub85d\uc5d0\uc11c \uc8fc\uac70 \uc9c0\uc5ed\uc740 \ubc00\ub3c4\uc640 \uc778\uad6c \uc6a9\ub7c9\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. '\uc8fc\ud0dd'\uacfc \uac19\uc740 \uc800\ubc00\ub3c4 \uc9c0\uc5ed\uc740 \uc0ac\ub78c\uc744 \uc801\uac8c \uc218\uc6a9\ud558\uc9c0\ub9cc \ud589\ubcf5\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4. '\uc544\ud30c\ud2b8 \ub2e8\uc9c0'\uc640 \uac19\uc740 \uc911\ubc00\ub3c4 \uc9c0\uc5ed\uc740 \ub354 \ub9ce\uc740 \uc2dc\ubbfc\uc744 \uc218\uc6a9\ud558\uc9c0\ub9cc \ub354 \ub9ce\uc740 \uc11c\ube44\uc2a4\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. '\uace0\uce35 \ube4c\ub529'\uacfc \uac19\uc740 \uace0\ubc00\ub3c4 \uc9c0\uc5ed\uc740 \uc778\uad6c\ub97c \uadf9\ub300\ud654\ud558\uc9c0\ub9cc \uad50\ud1b5 \uccb4\uc99d\uc774 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uad50\ud1b5\ub7c9\uc774 \uc801\uc740 \uc9c0\uc5ed\uc5d0 '\uc8fc\ud0dd'\uc744 \ubc30\uce58\ud558\uba74 \ucd08\ubcf4\uc790\uc5d0\uac8c \uc774\uc0c1\uc801\uc774\uace0, '\uace0\uce35 \ube4c\ub529'\uc740 \ubcf5\uc7a1\ud55c \ub3c4\uc2dc \ub808\uc774\uc544\uc6c3\uc744 \uad00\ub9ac\ud558\ub294 \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc801\ud569\ud569\ub2c8\ub2e4."}, {"question": "\ub3c4\uc2dc \ube14\ub85d \uba54\ud2b8\ub85c\ud3f4\ub9ac\uc2a4\uc5d0\uc11c \uad50\ud1b5 \ud750\ub984\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud558\ub098\uc694?", "answer": "\ub3c4\uc2dc \ube14\ub85d\uc5d0\uc11c \uad50\ud1b5 \ud750\ub984\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc804\ub7b5\uc801 \uacc4\ud68d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4: 1\ub2e8\uacc4 - \uad50\ucc28\ub85c\ub97c \ucd5c\uc18c\ud654\ud558\uae30 \uc704\ud574 \uadf8\ub9ac\ub4dc \ub610\ub294 \ubc29\uc0ac\ud615 \ub3c4\ub85c \ub808\uc774\uc544\uc6c3\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4 - \uace0\u00b7\uad50\ud1b5 \uc9c0\uc5ed \uadfc\ucc98\uc5d0 \ubc84\uc2a4 \uc815\ub958\uc7a5\uacfc \uac19\uc740 \ub300\uc911 \uad50\ud1b5\uc744 \ubc30\uce58\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4 - \ub3c4\ub85c\ub97c \uace0\uc18d\ub3c4\ub85c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uac70\ub098 \uc77c\ubc29\ud1b5\ud589 \ub3c4\ub85c\ub97c \ucd94\uac00\ud558\uc5ec \uc815\uccb4\ub97c \uc904\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc0b0\uc5c5 \uc9c0\uc5ed\uacfc \uc0c1\uc5c5 \uc9c0\uc5ed\uc744 \uace0\uc18d\ub3c4\ub85c\ub85c \uc5f0\uacb0\ud558\uba74 \uad50\ud1b5 \ubcd1\ubaa9 \ud604\uc0c1\uc774 \ud06c\uac8c \uc904\uc5b4\ub4ed\ub2c8\ub2e4."}, {"question": "\ub3c4\uc2dc \ube14\ub85d\uc5d0\uc11c \uc218\uc775\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \uace0\uae09 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub3c4\uc2dc \ube14\ub85d\uc5d0\uc11c \uc218\uc775\uc744 \uadf9\ub300\ud654\ud558\ub824\uba74 \ub2e4\uc74c \uc804\ub7b5\uc744 \uace0\ub824\ud558\uc138\uc694: 1\ub2e8\uacc4 - \ub354 \ub9ce\uc740 \uc218\uc785\uc744 \ucc3d\ucd9c\ud558\uae30 \uc704\ud574 '\uc1fc\ud551\ubab0'\uacfc \uac19\uc740 \uace0\ubc00\ub3c4 \uc0c1\uc5c5 \uc9c0\uc5ed\uc5d0 \uc9d1\uc911\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4 - '\ub3c4\uc2dc \ud0c0\uc6cc'\uc640 \uac19\uc740 \ub79c\ub4dc\ub9c8\ud06c\ub97c \uac74\uc124\ud558\uc5ec \uad00\uad11\uc5d0 \ud22c\uc790\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4 - \uc138\uae08\uc744 \uc2e0\uc911\ud558\uac8c \uc870\uc808\ud558\uc138\uc694. \uc138\uae08\uc774 \ub108\ubb34 \ub192\uc73c\uba74 \uc2dc\ubbfc\ub4e4\uc774 \uc774\ud0c8\ud558\uace0, \ub108\ubb34 \ub0ae\uc73c\uba74 \uc218\uc785\uc774 \uc904\uc5b4\ub4ed\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud589\ubcf5\ub3c4\uac00 \ub192\uc740 \uc8fc\uac70 \uc9c0\uc5ed \uadfc\ucc98\uc5d0 '\uc1fc\ud551\ubab0'\uc744 \ubc30\uce58\ud558\uba74 \uc0c1\ub2f9\ud55c \uc774\uc775\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub3c4\uc2dc \ube14\ub85d\uc5d0\uc11c \uc624\uc5fc \uc218\uc900\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud558\ub098\uc694?", "answer": "\ub3c4\uc2dc \ube14\ub85d\uc5d0\uc11c \uc624\uc5fc\uc744 \uad00\ub9ac\ud558\ub824\uba74 \ub2e4\ub2e8\uacc4 \uc811\uadfc \ubc29\uc2dd\uc774 \ud544\uc694\ud569\ub2c8\ub2e4: 1\ub2e8\uacc4 - \uc0b0\uc5c5 \uc9c0\uc5ed\uc744 \uc8fc\uac70 \uc9c0\uc5ed\uacfc \ub5a8\uc5b4\ub728\ub9ac\uace0 \ub098\ubb34 \ub610\ub294 \uacf5\uc6d0\uc744 \uc644\ucda9 \uc9c0\uc5ed\uc73c\ub85c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4 - \uc0b0\uc5c5 \uac74\ubb3c\uc744 '\uce5c\ud658\uacbd \uacf5\uc7a5'\uacfc \uac19\uc740 \ub354 \uae68\ub057\ud55c \uae30\uc220\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4 - \ucc28\ub7c9 \ubc30\ucd9c\ub7c9\uc744 \uc904\uc774\uae30 \uc704\ud574 \ub300\uc911 \uad50\ud1b5\uc5d0 \ud22c\uc790\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc11d\ud0c4 \ubc1c\uc804\uc18c'\ub97c '\ud0dc\uc591 \uad11 \ubc1c\uc804\uc18c'\ub85c \uad50\uccb4\ud558\uba74 \uc624\uc5fc \uc218\uc900\uc774 \ud06c\uac8c \ub0ae\uc544\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub3c4\uc2dc \ube14\ub85d\uc5d0\uc11c \ud589\ubcf5\ub3c4 \uacc4\uce21\uae30\uc758 \uc5ed\ud560\uc740 \ubb34\uc5c7\uc774\uba70, \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "\ub3c4\uc2dc \ube14\ub85d\uc5d0\uc11c \ud589\ubcf5\ub3c4 \uacc4\uce21\uae30\ub294 \uc2dc\ubbfc \ub9cc\uc871\ub3c4\ub97c \ubc18\uc601\ud558\uace0 \uc9c1\uc811 \ub3c4\uc2dc \uc131\uc7a5 \ubc0f \uc218\uc785\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ud589\ubcf5\ub3c4\uac00 \ub192\uc73c\uba74 \uc778\uad6c \uc131\uc7a5\uacfc \uc138\uc218\uac00 \uc99d\uac00\ud558\uc9c0\ub9cc, \ud589\ubcf5\ub3c4\uac00 \ub0ae\uc73c\uba74 \uc2dc\ubbfc\ub4e4\uc774 \uc774\ud0c8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud589\ubcf5\ub3c4\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc694\uc778\uc740 \uc11c\ube44\uc2a4 \uc811\uadfc\uc131, \uc624\uc5fc\uc774 \uc801\uc74c, \uadfc\ucc98 \uacf5\uc6d0 \ub4f1\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc8fc\uac70 \uc9c0\uc5ed \uadfc\ucc98\uc5d0 '\ucee4\ubba4\ub2c8\ud2f0 \uc13c\ud130'\ub97c \ubc30\uce58\ud558\uba74 \ud589\ubcf5\ub3c4\uac00 \ud06c\uac8c \ub192\uc544\uc9c0\uace0 \uc804\ubc18\uc801\uc778 \ub3c4\uc2dc \uc131\ub2a5\uc774 \ud5a5\uc0c1\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub3c4\uc2dc \ube14\ub85d\uc758 \uad6c\uc5ed \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uadf8 \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub3c4\uc2dc \ube14\ub85d\uc758 \uad6c\uc5ed \uc2dc\uc2a4\ud15c\uc740 \uc8fc\uac70, \uc0c1\uc5c5 \ubc0f \uc0b0\uc5c5 \uad6c\uc5ed\uc73c\ub85c \ub098\ub258\uba70 \uac01\uac01 \ub2e4\ub978 \ubaa9\uc801\uc744 \uc218\ud589\ud569\ub2c8\ub2e4. \uc8fc\uac70 \uad6c\uc5ed\uc740 \uc2dc\ubbfc\uc744 \uc218\uc6a9\ud558\uace0, \uc0c1\uc5c5 \uad6c\uc5ed\uc740 \uc218\uc775\uc744 \ucc3d\ucd9c\ud558\uba70, \uc0b0\uc5c5 \uad6c\uc5ed\uc740 \uc77c\uc790\ub9ac\uc640 \uc790\uc6d0\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \uadfc\uc811\uc131\uacfc \uc5f0\uacb0\uc131\uc5d0 \uc758\uc874\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc0c1\uc5c5 \uad6c\uc5ed\uc744 \uc8fc\uac70 \uad6c\uc5ed \uadfc\ucc98\uc5d0 \ubc30\uce58\ud558\uba74 \uc2dc\ubbfc\ub4e4\uc774 \uc27d\uac8c \uac00\uac8c\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uad6c\uc5ed \ubc00\ub3c4(\uc800, \uc911, \uace0)\ub294 \uc778\uad6c \uc6a9\ub7c9\uacfc \uc790\uc6d0 \uc694\uad6c\ub7c9\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4."}, {"question": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \ub3c4\uc2dc \ube14\ub85d \uc800\uc7a5 \ub370\uc774\ud130\ub97c \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694? \uc5b4\ub5bb\uac8c \uac00\ub2a5\ud55c\uac00\uc694?", "answer": "\ub124, \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub2e4\ub978 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \ub3c4\uc2dc \ube14\ub85d \uc800\uc7a5 \ub370\uc774\ud130\ub97c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 1\ub2e8\uacc4 - \uac8c\uc784\uc758 \ud074\ub77c\uc6b0\ub4dc \uc11c\ube44\uc2a4\uc5d0 \uc5f0\uacb0\ub41c \uacc4\uc815\uc744 \uac16\uace0 \uc788\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4 - \ud604\uc7ac \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \ud074\ub77c\uc6b0\ub4dc\uc5d0 \uc800\uc7a5\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4 - \uc0c8 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uace0 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ubd88\ub7ec\uc635\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ubaa8\ubc14\uc77c\ub85c \uc774\ub3d9\ud558\ub294 \uacbd\uc6b0 \ubaa8\ubc14\uc77c \uc571\uc5d0\uc11c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uae30\ub9cc \ud558\uba74 \uc800\uc7a5\ub41c \ub3c4\uc2dc\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub3c4\uc2dc \ube14\ub85d\uc5d0\uc11c \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8 \ub610\ub294 \ube44\ubc00 \uae30\ub2a5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub3c4\uc2dc \ube14\ub85d\uc5d0\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc5ec\ub7ec \uac00\uc9c0 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uc640 \ube44\ubc00 \uae30\ub2a5\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ud55c \uac00\uc9c0 \uc8fc\ubaa9\ud560 \ub9cc\ud55c \uc608\ub85c\ub294 30\uc77c \uc5f0\uc18d 95%\uc758 \ud589\ubcf5\ub3c4\ub97c \ub2ec\uc131\ud558\uba74 \uc7a0\uae08 \ud574\uc81c\ub418\ub294 '\uae08\ube5b \ub3d9\uc0c1'\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uc608\ub85c\ub294 50\uac1c\uc758 \uc9c0\ud558\ucca0\uc5ed\uc744 \uac74\uc124\ud55c \ud6c4 \ub098\ud0c0\ub098\ub294, \uc228\uaca8\uc9c4 \uad50\ud1b5 \uc635\uc158\uc778 '\ubbf8\uc2a4\ud14c\ub9ac \uc9c0\ud558\ucca0'\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uae30\ub2a5\uc740 \uac8c\uc784 \ubaa8\ub4e0 \uce21\uba74\uc744 \ud0d0\ud5d8\ud558\ub294 \uc5f4\uc815\uc801\uc778 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc7ac\ubbf8\uc640 \ubcf4\uc0c1\uc744 \ub354\ud569\ub2c8\ub2e4."}]
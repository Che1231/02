[{"question": "\u521d\u3081\u3066\u90fd\u5e02\u3092\u5efa\u8a2d\u3059\u308b\u306b\u306f\u3001\u521d\u5fc3\u8005\u5411\u3051\u306b\u300eCity Blocks\u300f\u3067\u3069\u306e\u3088\u3046\u306b\u59cb\u3081\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u300eCity Blocks\u300f\u3067\u521d\u3081\u3066\u306e\u90fd\u5e02\u5efa\u8a2d\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5e02\u5e81\u820e\uff08\u6838\u5fc3\u3068\u306a\u308b\u5efa\u7269\uff09\u3092\u914d\u7f6e\u3059\u308b\u5e73\u3089\u306a\u5834\u6240\u3092\u9078\u3073\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5e02\u5e81\u820e\u306b\u9053\u8def\u3092\u63a5\u7d9a\u3057\u3066\u4ed6\u306e\u5efa\u7269\u306e\u30a2\u30af\u30bb\u30b9\u3092\u53ef\u80fd\u306b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u9053\u8def\u306e\u8fd1\u304f\u306b\u4f4f\u5b85\u5730\u3092\u914d\u7f6e\u3057\u59cb\u3081\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u90ca\u5916\u4f4f\u5b85\u300d\u3092\u914d\u7f6e\u3059\u308b\u3068\u3001\u5e02\u6c11\u304c\u4f4f\u307f\u59cb\u3081\u307e\u3059\u3002\u6700\u9069\u306a\u6210\u9577\u306e\u305f\u3081\u306b\u4f4f\u5b85\u5730\u3001\u5546\u696d\u5730\u3001\u5de5\u696d\u5730\u3092\u30d0\u30e9\u30f3\u30b9\u3088\u304f\u914d\u7f6e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u5341\u5206\u306a\u4f4f\u5b85\u5730\u304c\u3042\u308b\u306b\u3082\u304b\u304b\u308f\u3089\u305a\u3001\u300eCity Blocks\u300f\u306e\u90fd\u5e02\u304c\u6210\u9577\u3057\u306a\u3044\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u300eCity Blocks\u300f\u306e\u90fd\u5e02\u304c\u6210\u9577\u3057\u306a\u3044\u5834\u5408\u306f\u3001\u4ee5\u4e0b\u306e\u70b9\u3092\u30c1\u30a7\u30c3\u30af\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u4f4f\u5b85\u5730\u304c\u9053\u8def\u306b\u63a5\u7d9a\u3055\u308c\u3001\u6c34\u3084\u96fb\u6c17\u306a\u3069\u306e\u57fa\u672c\u7684\u306a\u30b5\u30fc\u30d3\u30b9\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5546\u696d\u5730\u307e\u305f\u306f\u5de5\u696d\u5730\u5e2f\u306b\u5341\u5206\u306a\u4ed5\u4e8b\u304c\u3042\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5e02\u6c11\u306e\u5e78\u798f\u5ea6\u3092\u76e3\u8996\u3057\u307e\u3059\u3002\u5e78\u798f\u5ea6\u304c\u4f4e\u3044\u3068\u6210\u9577\u304c\u505c\u6ede\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u4f4f\u5b85\u5730\u306e\u8fd1\u304f\u306b\u300c\u516c\u5712\u300d\u3092\u8ffd\u52a0\u3059\u308b\u3068\u3001\u5e78\u798f\u5ea6\u3092\u9ad8\u3081\u3001\u4eba\u53e3\u5897\u52a0\u3092\u4fc3\u9032\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u300eCity Blocks\u300f\u306e\u4f4f\u5b85\u5730\u30bf\u30a4\u30d7\u9593\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u300eCity Blocks\u300f\u3067\u306f\u3001\u4f4f\u5b85\u5730\u306f\u5bc6\u5ea6\u3068\u4eba\u53e3\u53ce\u5bb9\u80fd\u529b\u306b\u57fa\u3065\u3044\u3066\u7570\u306a\u308a\u307e\u3059\u3002\u4f4e\u5bc6\u5ea6\u306e\u4f4f\u5b85\u5730\u3067\u3042\u308b\u300c\u90ca\u5916\u4f4f\u5b85\u300d\u306f\u3001\u4eba\u3005\u306f\u5c11\u306a\u3044\u3082\u306e\u306e\u3001\u5e78\u798f\u5ea6\u3092\u9ad8\u3081\u307e\u3059\u3002\u4e2d\u5bc6\u5ea6\u306e\u4f4f\u5b85\u5730\u3067\u3042\u308b\u300c\u30a2\u30d1\u30fc\u30c8\u300d\u306f\u3001\u3088\u308a\u591a\u304f\u306e\u5e02\u6c11\u3092\u53ce\u5bb9\u3057\u307e\u3059\u304c\u3001\u3088\u308a\u591a\u304f\u306e\u30b5\u30fc\u30d3\u30b9\u304c\u5fc5\u8981\u3067\u3059\u3002\u9ad8\u5bc6\u5ea6\u306e\u4f4f\u5b85\u5730\u3067\u3042\u308b\u300c\u9ad8\u5c64\u30d3\u30eb\u300d\u306f\u3001\u4eba\u53e3\u3092\u6700\u5927\u9650\u306b\u6d3b\u7528\u3067\u304d\u307e\u3059\u304c\u3001\u4ea4\u901a\u6e0b\u6ede\u306b\u3064\u306a\u304c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u4ea4\u901a\u91cf\u306e\u5c11\u306a\u3044\u5730\u57df\u306b\u300c\u90ca\u5916\u4f4f\u5b85\u300d\u3092\u914d\u7f6e\u3059\u308b\u306e\u306f\u521d\u5fc3\u8005\u306b\u3068\u3063\u3066\u6700\u9069\u3067\u3059\u3002\u300c\u9ad8\u5c64\u30d3\u30eb\u300d\u306f\u3001\u8907\u96d1\u306a\u90fd\u5e02\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u7ba1\u7406\u3059\u308b\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u9069\u3057\u3066\u3044\u307e\u3059\u3002"}, {"question": "\u300eCity Blocks\u300f\u306e\u90fd\u5e02\u90e8\u306b\u304a\u3051\u308b\u4ea4\u901a\u306e\u6d41\u308c\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u300eCity Blocks\u300f\u306e\u4ea4\u901a\u306e\u6d41\u308c\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u6226\u7565\u7684\u306a\u8a08\u753b\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u4ea4\u5dee\u70b9\u3092\u6700\u5c0f\u9650\u306b\u3059\u308b\u305f\u3081\u3001\u30b0\u30ea\u30c3\u30c9\u72b6\u307e\u305f\u306f\u653e\u5c04\u72b6\u306e\u9053\u8def\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u9ad8\u4ea4\u901a\u91cf\u306e\u5730\u57df\u8fd1\u304f\u306b\u30d0\u30b9\u505c\u306a\u3069\u306e\u516c\u5171\u4ea4\u901a\u6a5f\u95a2\u3092\u914d\u7f6e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u9053\u8def\u3092\u9ad8\u901f\u9053\u8def\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u305f\u308a\u3001\u4e00\u65b9\u901a\u884c\u306e\u9053\u8def\u3092\u8ffd\u52a0\u3057\u305f\u308a\u3057\u3066\u6e0b\u6ede\u3092\u8efd\u6e1b\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5de5\u696d\u5730\u5e2f\u3068\u5546\u696d\u5730\u5e2f\u3092\u9ad8\u901f\u9053\u8def\u3067\u63a5\u7d9a\u3059\u308b\u3068\u3001\u4ea4\u901a\u306e\u30dc\u30c8\u30eb\u30cd\u30c3\u30af\u3092\u5927\u5e45\u306b\u8efd\u6e1b\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u300eCity Blocks\u300f\u3067\u53ce\u76ca\u3092\u6700\u5927\u5316\u3059\u308b\u4e0a\u7d1a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u300eCity Blocks\u300f\u3067\u53ce\u76ca\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u6226\u7565\u3092\u691c\u8a0e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u3088\u308a\u591a\u304f\u306e\u53ce\u5165\u3092\u751f\u307f\u51fa\u3059\u300c\u30b7\u30e7\u30c3\u30d4\u30f3\u30b0\u30e2\u30fc\u30eb\u300d\u306a\u3069\u306e\u9ad8\u5bc6\u5ea6\u5546\u696d\u5730\u306b\u7740\u76ee\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u300c\u30b7\u30c6\u30a3\u30bf\u30ef\u30fc\u300d\u306a\u3069\u306e\u30e9\u30f3\u30c9\u30de\u30fc\u30af\u3092\u5efa\u8a2d\u3057\u3066\u89b3\u5149\u306b\u6295\u8cc7\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u8ab2\u7a0e\u3092\u614e\u91cd\u306b\u8abf\u6574\u3057\u307e\u3059\u3002\u8ab2\u7a0e\u304c\u9ad8\u3059\u304e\u308b\u3068\u5e02\u6c11\u304c\u53bb\u308a\u3001\u4f4e\u3059\u304e\u308b\u3068\u53ce\u76ca\u304c\u6e1b\u5c11\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u9ad8\u3044\u5e78\u798f\u5ea6\u306e\u5c45\u4f4f\u5730\u57df\u306b\u300c\u30b7\u30e7\u30c3\u30d4\u30f3\u30b0\u30e2\u30fc\u30eb\u300d\u3092\u914d\u7f6e\u3059\u308b\u3068\u3001\u304b\u306a\u308a\u306e\u5229\u76ca\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u300eCity Blocks\u300f\u3067\u6392\u51fa\u91cf\u3092\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u300eCity Blocks\u300f\u3067\u6392\u51fa\u91cf\u3092\u7ba1\u7406\u3059\u308b\u306b\u306f\u3001\u6bb5\u968e\u7684\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5de5\u696d\u5730\u5e2f\u3092\u4f4f\u5b85\u5730\u304b\u3089\u96e2\u3057\u3001\u6728\u3084\u516c\u5712\u3092\u7de9\u885d\u6750\u3068\u3057\u3066\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5de5\u696d\u65bd\u8a2d\u3092\u300c\u30a8\u30b3\u30d5\u30ec\u30f3\u30c9\u30ea\u30fc\u5de5\u5834\u300d\u306e\u3088\u3046\u306a\u30af\u30ea\u30fc\u30f3\u306a\u6280\u8853\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u516c\u5171\u4ea4\u901a\u6a5f\u95a2\u3078\u306e\u6295\u8cc7\u306b\u3088\u308a\u3001\u8eca\u4e21\u6392\u51fa\u30ac\u30b9\u3092\u524a\u6e1b\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u77f3\u70ad\u706b\u529b\u767a\u96fb\u6240\u300d\u3092\u300c\u592a\u967d\u5149\u767a\u96fb\u6240\u300d\u306b\u7f6e\u304d\u63db\u3048\u308b\u3053\u3068\u3067\u3001\u6392\u51fa\u91cf\u3092\u5927\u5e45\u306b\u524a\u6e1b\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u300eCity Blocks\u300f\u306b\u304a\u3051\u308b\u5e78\u798f\u5ea6\u8a08\u306e\u5f79\u5272\u306f\u4f55\u3067\u3042\u308a\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u300eCity Blocks\u300f\u306e\u5e78\u798f\u5ea6\u8a08\u306f\u3001\u5e02\u6c11\u306e\u6e80\u8db3\u5ea6\u3092\u53cd\u6620\u3057\u3001\u90fd\u5e02\u306e\u6210\u9577\u3068\u53ce\u76ca\u306b\u76f4\u63a5\u5f71\u97ff\u3057\u307e\u3059\u3002\u5e78\u798f\u5ea6\u304c\u9ad8\u3044\u3068\u3001\u4eba\u53e3\u5897\u52a0\u3068\u7a0e\u53ce\u304c\u5897\u52a0\u3057\u307e\u3059\u304c\u3001\u5e78\u798f\u5ea6\u304c\u4f4e\u3044\u3068\u5e02\u6c11\u304c\u79fb\u52d5\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u5e78\u798f\u5ea6\u3092\u5de6\u53f3\u3059\u308b\u8981\u56e0\u3068\u3057\u3066\u306f\u3001\u30b5\u30fc\u30d3\u30b9\u3078\u306e\u30a2\u30af\u30bb\u30b9\u3001\u4f4e\u6392\u51fa\u91cf\u3001\u8fd1\u96a3\u306e\u516c\u5712\u306a\u3069\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u4f4f\u5b85\u5730\u306e\u8fd1\u304f\u306b\u300c\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u30bb\u30f3\u30bf\u30fc\u300d\u3092\u914d\u7f6e\u3059\u308b\u3068\u3001\u5e78\u798f\u5ea6\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u3001\u90fd\u5e02\u5168\u4f53\u306e\u6027\u80fd\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002"}, {"question": "\u300eCity Blocks\u300f\u306e\u30be\u30fc\u30f3\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u305d\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306e\u6839\u5e95\u306b\u3042\u308b\u3082\u306e\u3068\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u300eCity Blocks\u300f\u306e\u30be\u30fc\u30f3\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u4f4f\u5b85\u5730\u3001\u5546\u696d\u5730\u3001\u5de5\u696d\u5730\u306e3\u3064\u306e\u30be\u30fc\u30f3\u306b\u5206\u304b\u308c\u3066\u304a\u308a\u3001\u305d\u308c\u305e\u308c\u306b\u7570\u306a\u308b\u76ee\u7684\u304c\u3042\u308a\u307e\u3059\u3002\u4f4f\u5b85\u5730\u306f\u5e02\u6c11\u3092\u53ce\u5bb9\u3057\u3001\u5546\u696d\u5730\u306f\u53ce\u76ca\u3092\u751f\u307f\u51fa\u3057\u3001\u5de5\u696d\u5730\u5e2f\u306f\u4ed5\u4e8b\u3068\u8cc7\u6e90\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u8fd1\u63a5\u6027\u3068\u63a5\u7d9a\u6027\u3092\u524d\u63d0\u3068\u3057\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5546\u696d\u5730\u3092\u4f4f\u5b85\u5730\u306e\u8fd1\u304f\u306a\u3069\u306b\u914d\u7f6e\u3059\u308b\u3053\u3068\u3067\u3001\u5e02\u6c11\u304c\u304a\u5e97\u306b\u7c21\u5358\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30be\u30fc\u30f3\u306e\u5bc6\u5ea6\uff08\u4f4e\u3001\u4e2d\u3001\u9ad8\uff09\u306f\u3001\u4eba\u53e3\u53ce\u5bb9\u80fd\u529b\u3068\u8cc7\u6e90\u9700\u8981\u306b\u5f71\u97ff\u3057\u307e\u3059\u3002"}, {"question": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u300eCity Blocks\u300f\u306e\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u3092\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f\u305d\u306e\u65b9\u6cd5\u306f\uff1f", "answer": "\u306f\u3044\u3001\u30af\u30e9\u30a6\u30c9\u30bb\u30fc\u30d6\u3092\u4f7f\u7528\u3057\u3066\u3001\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u300eCity Blocks\u300f\u306e\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u3092\u8ee2\u9001\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff11\uff1a\u30b2\u30fc\u30e0\u306e\u30af\u30e9\u30a6\u30c9\u30b5\u30fc\u30d3\u30b9\u306b\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30ea\u30f3\u30af\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u73fe\u5728\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u30b2\u30fc\u30e0\u306e\u9032\u884c\u72b6\u6cc1\u3092\u30af\u30e9\u30a6\u30c9\u306b\u4fdd\u5b58\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u65b0\u3057\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3001\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u8aad\u307f\u8fbc\u307f\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001PC\u304b\u3089\u30e2\u30d0\u30a4\u30eb\u306b\u79fb\u884c\u3059\u308b\u5834\u5408\u3001\u30e2\u30d0\u30a4\u30eb\u30a2\u30d7\u30ea\u3067\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3060\u3051\u3067\u3001\u4fdd\u5b58\u3057\u305f\u90fd\u5e02\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u300eCity Blocks\u300f\u3067\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3084\u79d8\u5bc6\u306e\u6a5f\u80fd\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u300eCity Blocks\u300f\u306b\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u767a\u898b\u3067\u304d\u308b\u3044\u304f\u3064\u304b\u306e\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3084\u79d8\u5bc6\u306e\u6a5f\u80fd\u304c\u3042\u308a\u307e\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u4f8b\u306f\u3001\u300c\u91d1\u306e\u5f6b\u523b\u50cf\u300d\u3067\u3001\u3053\u308c\u306f\u9023\u7d9a30\u65e5\u9593\u5e78\u798f\u5ea6\u30ec\u30d9\u30eb\u309295\uff05\u306b\u9054\u6210\u3059\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u3002\u3082\u30461\u3064\u306f\u3001\u300c\u8b0e\u306e\u5730\u4e0b\u9244\u300d\u3067\u300150\u306e\u5730\u4e0b\u9244\u99c5\u3092\u5efa\u8a2d\u3057\u305f\u5f8c\u3001\u767b\u5834\u3059\u308b\u96a0\u3055\u308c\u305f\u8f38\u9001\u624b\u6bb5\u3067\u3059\u3002\u3053\u308c\u3089\u306e\u6a5f\u80fd\u306f\u3001\u30b2\u30fc\u30e0\u306e\u3042\u3089\u3086\u308b\u5074\u9762\u3092\u63a2\u6c42\u3059\u308b\u71b1\u5fc3\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u305f\u3081\u306b\u3001\u697d\u3057\u3055\u3068\u5831\u916c\u306e\u5c64\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002"}]
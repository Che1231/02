[{"question": "\u5982\u4f55\u958b\u59cb\u5728Papa's Cupcakeria\u88fd\u4f5c\u57fa\u672c\u86cb\u7cd5\u6372\uff1f", "answer": "\u8981\u958b\u59cb\u5728Papa's Cupcakeria\u7d44\u88dd\u86cb\u7cd5\u6372\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u5f9e\u9078\u55ae\u4e2d\u9078\u64c7\u86cb\u7cd5\u6372\u5e95\u5ea7\uff0c\u4f8b\u5982\u9999\u8349\u6216\u5de7\u514b\u529b\u3002\u6b65\u9a5f2 - \u9078\u64c7\u4e00\u7a2e\u7cd6\u971c\u53e3\u5473\uff0c\u4f8b\u5982\u8349\u8393\u6216\u5976\u6cb9\u4e73\u916a\u3002\u6b65\u9a5f3 - \u52a0\u5165\u5982\u7cd6\u971c\u6216\u6c34\u679c\u7b49\u88dd\u98fe\u3002\u4f8b\u5982\uff0c\u4e00\u7a2e\u5ee3\u53d7\u6b61\u8fce\u7684\u9078\u64c7\u662f\u9999\u8349\u5e95\u5ea7\uff0c\u8349\u8393\u7cd6\u971c\u548c\u5f69\u8679\u7cd6\u971c\u3002\u9019\u7a2e\u7c21\u55ae\u7684\u7d44\u5408\u975e\u5e38\u9069\u5408\u521d\u5b78\u8005\u638c\u63e1\u57fa\u790e\u77e5\u8b58\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u5728Papa's Cupcakeria\u4e2d\u591a\u5de5\u5f88\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u6539\u5584\u5b83\uff1f", "answer": "\u5728Papa's Cupcakeria\u4e2d\uff0c\u591a\u5de5\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u80fd\u6709\u6548\u5730\u70ba\u9867\u5ba2\u670d\u52d9\uff0c\u589e\u52a0\u5c0f\u8cbb\u548c\u6574\u9ad4\u5f97\u5206\u3002\u8981\u6539\u5584\u591a\u5de5\u80fd\u529b\uff1a\u6b65\u9a5f1 - \u6839\u64da\u9867\u5ba2\u8010\u5fc3\u7a0b\u5ea6\u512a\u5148\u8655\u7406\u4efb\u52d9\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u7df4\u7fd2\u6a21\u5f0f\u78e8\u7df4\u6280\u80fd\uff0c\u907f\u514d\u6642\u9593\u58d3\u529b\u3002\u6b65\u9a5f3 - \u6ce8\u610f\u8a02\u55ae\u968a\u5217\uff0c\u9810\u671f\u5373\u5c07\u5230\u4f86\u7684\u4efb\u52d9\u3002\u4f8b\u5982\uff0c\u5728\u70d8\u57f9\u5de7\u514b\u529b\u86cb\u7cd5\u6372\u6642\uff0c\u60a8\u53ef\u4ee5\u958b\u59cb\u6e96\u5099\u4e0b\u4e00\u5f35\u8a02\u55ae\u7684\u7cd6\u971c\u3002\u6b64\u7b56\u7565\u6709\u52a9\u65bc\u9806\u5229\u8655\u7406\u591a\u500b\u8a02\u55ae\u3002"}, {"question": "\u5728Papa's Cupcakeria\u4e2d\u6700\u5927\u5316\u5c0f\u8cbb\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728Papa's Cupcakeria\u4e2d\u6700\u5927\u5316\u5c0f\u8cbb\u9700\u8981\u901f\u5ea6\u3001\u6e96\u78ba\u6027\u548c\u9867\u5ba2\u6eff\u610f\u5ea6\u7684\u7d50\u5408\u3002\u6b65\u9a5f1 - \u59cb\u7d42\u6aa2\u67e5\u9867\u5ba2\u7684\u8a02\u55ae\u504f\u597d\u4e26\u76f8\u61c9\u5730\u5ba2\u88fd\u5316\u3002\u6b65\u9a5f2 - \u5feb\u901f\u8655\u7406\u8a02\u55ae\u4ee5\u4fdd\u6301\u9867\u5ba2\u6eff\u610f\u3002\u6b65\u9a5f3 - \u5118\u53ef\u80fd\u4f7f\u7528\u9ad8\u7d1a\u98df\u6750\uff0c\u56e0\u70ba\u5b83\u5011\u53ef\u4ee5\u589e\u52a0\u5c0f\u8cbb\u91d1\u984d\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u9032\u53e3\u9999\u8349\u7cbe\u8403\u53d6\u4ee3\u666e\u901a\u9999\u8349\u7cbe\u8403\uff0c\u53ef\u4ee5\u5c07\u60a8\u7684\u5c0f\u8cbb\u63d0\u9ad8 10%\u3002\u8acb\u8a18\u4f4f\uff0c\u5feb\u6a02\u7684\u9867\u5ba2\u66f4\u6709\u53ef\u80fd\u7559\u4e0b\u6177\u6168\u7684\u5c0f\u8cbb\u3002"}, {"question": "\u5728Papa's Cupcakeria\u4e2d\uff0c\u70ba\u4e86\u63d0\u5347\u904a\u6232\u9ad4\u9a57\uff0c\u61c9\u8a72\u512a\u5148\u5347\u7d1a\u54ea\u4e9b\u9805\u76ee\uff1f", "answer": "\u5728Papa's Cupcakeria\u4e2d\u512a\u5148\u5347\u7d1a\u9805\u76ee\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u60a8\u7684\u904a\u6232\u9ad4\u9a57\u3002\u6b65\u9a5f1 - \u9996\u5148\u5347\u7d1a\u70e4\u7bb1\u4ee5\u7e2e\u77ed\u70d8\u57f9\u6642\u9593\u3002\u6b65\u9a5f2 - \u6295\u8cc7\u66f4\u597d\u7684\u7cd6\u971c\u5de5\u5177\u4f86\u52a0\u5feb\u7cd6\u971c\u904e\u7a0b\u3002\u6b65\u9a5f3 - \u5347\u7d1a\u60a8\u7684\u88dd\u98fe\u53f0\u4ee5\u89e3\u9396\u66f4\u591a\u9078\u9805\u4e26\u63d0\u9ad8\u6548\u7387\u3002\u4f8b\u5982\uff0c\u5347\u7d1a\u5f8c\u7684\u70e4\u7bb1\u53ef\u4ee5\u5c07\u86cb\u7cd5\u6372\u7684\u70d8\u57f9\u901f\u5ea6\u63d0\u9ad8 20%\uff0c\u8b93\u60a8\u8655\u7406\u66f4\u591a\u8a02\u55ae\u3002\u9019\u4e9b\u5347\u7d1a\u5c0d\u65bc\u5e0c\u671b\u512a\u5316\u5176\u7e3e\u6548\u7684\u9ad8\u7d1a\u73a9\u5bb6\u4f86\u8aaa\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "Papa's Cupcakeria\u4e2d\u7684\u8a08\u5206\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff0c\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u5b83\uff1f", "answer": "Papa's Cupcakeria\u7684\u8a08\u5206\u7cfb\u7d71\u53d7\u5e7e\u500b\u56e0\u7d20\u5f71\u97ff\uff1a\u6e96\u78ba\u6027\u3001\u901f\u5ea6\u548c\u9867\u5ba2\u6eff\u610f\u5ea6\u3002\u6b65\u9a5f1 - \u6e96\u78ba\u5730\u9075\u5faa\u9867\u5ba2\u7684\u8a02\u55ae\u8a73\u7d30\u8cc7\u6599\u81f3\u95dc\u91cd\u8981\u3002\u6b65\u9a5f2 - \u6e96\u5099\u548c\u63d0\u4f9b\u86cb\u7cd5\u6372\u7684\u901f\u5ea6\u6703\u7a4d\u6975\u5f71\u97ff\u60a8\u7684\u5f97\u5206\u3002\u6b65\u9a5f3 - \u9867\u5ba2\u6eff\u610f\u5ea6\uff0c\u4ee5\u9867\u5ba2\u7684\u5feb\u6a02\u7a0b\u5ea6\u8868\u793a\uff0c\u4e5f\u626e\u6f14\u8457\u81f3\u95dc\u91cd\u8981\u7684\u89d2\u8272\u3002\u4f8b\u5982\uff0c\u5b8c\u7f8e\u7d44\u88dd\u7684\u86cb\u7cd5\u6372\uff0c\u5feb\u901f\u5730\u63d0\u4f9b\u7d66\u5feb\u6a02\u7684\u9867\u5ba2\uff0c\u53ef\u4ee5\u7372\u5f97\u9ad8\u5206\u3002\u77ad\u89e3\u9019\u4e9b\u56e0\u7d20\u6709\u52a9\u65bc\u5236\u5b9a\u66f4\u597d\u7684\u7b56\u7565\u3002"}, {"question": "Papa's Cupcakeria\u4e2d\uff0c\u73a9\u5bb6\u53ef\u80fd\u6703\u5ffd\u7565\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "Papa's Cupcakeria\u5305\u542b\u4e00\u4e9b\u96b1\u85cf\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u53ef\u4ee5\u63d0\u5347\u60a8\u7684\u904a\u6232\u9ad4\u9a57\u3002\u4e00\u500b\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\uff0c\u901a\u904e\u4f7f\u7528\u6240\u6709\u53ef\u7528\u7684\u88dd\u98fe\uff0c\u53ef\u4ee5\u88fd\u4f5c\u51fa\u7279\u5225\u7684\u300c\u5f69\u8679\u7f8e\u5473\u300d\u86cb\u7cd5\u6372\u3002\u9019\u500b\u7368\u7279\u7684\u5275\u4f5c\u4e0d\u50c5\u80fd\u7d66\u9867\u5ba2\u7559\u4e0b\u6df1\u523b\u5370\u8c61\uff0c\u9084\u80fd\u89e3\u9396\u7279\u6b8a\u7684\u6210\u5c31\u3002\u53e6\u4e00\u500b\u96b1\u85cf\u529f\u80fd\u662f\u79d8\u5bc6\u83dc\u55ae\uff0c\u900f\u904e\u6309\u4f4f\u9078\u55ae\u6309\u9215 5 \u79d2\u9418\u5373\u53ef\u958b\u555f\uff0c\u9019\u63d0\u4f9b\u7a00\u6709\u4e14\u9ad8\u7d1a\u7684\u98df\u6750\u3002\u63a2\u7d22\u9019\u4e9b\u96b1\u85cf\u5143\u7d20\uff0c\u8b93\u904a\u6232\u589e\u6dfb\u4e86\u984d\u5916\u7684\u6a02\u8da3\u548c\u767c\u73fe\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728Papa's Cupcakeria\u6709\u6548\u5730\u7ba1\u7406\u6642\u9593\u4f86\u8655\u7406\u591a\u500b\u8a02\u55ae\uff1f", "answer": "\u5728Papa's Cupcakeria\u4e2d\u6709\u6548\u5730\u7ba1\u7406\u6642\u9593\u662f\u6210\u529f\u8655\u7406\u591a\u500b\u8a02\u55ae\u7684\u95dc\u9375\u3002\u6b65\u9a5f1 - \u5f9e\u6574\u7406\u5de5\u4f5c\u5834\u6240\u958b\u59cb\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u6e1b\u5c11\u4efb\u52d9\u9593\u7684\u79fb\u52d5\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u6bcf\u500b\u8a02\u55ae\u7684\u8a08\u6642\u5668\uff0c\u512a\u5148\u6e96\u5099\u54ea\u500b\u86cb\u7cd5\u6372\u3002\u6b65\u9a5f3 - \u901a\u904e\u540c\u6642\u6e96\u5099\u591a\u500b\u5e95\u5ea7\u4e26\u5728\u5176\u4ed6\u86cb\u7cd5\u6372\u4e0a\u5857\u62b9\u7cd6\u971c\u4f86\u5206\u914d\u4efb\u52d9\u3002\u4f8b\u5982\uff0c\u60a8\u53ef\u4ee5\u70d8\u57f9\u9999\u8349\u86cb\u7cd5\u6372\uff0c\u540c\u6642\u5728\u5de7\u514b\u529b\u86cb\u7cd5\u6372\u4e0a\u5857\u62b9\u7cd6\u971c\uff0c\u78ba\u4fdd\u4e0d\u6d6a\u8cbb\u6642\u9593\u3002\u9019\u7a2e\u65b9\u6cd5\u6709\u52a9\u65bc\u7dad\u6301\u7a69\u5b9a\u7684\u8a02\u55ae\u6d41\uff0c\u800c\u4e0d\u6703\u8b93\u81ea\u5df1\u611f\u5230\u4e0d\u582a\u91cd\u8ca0\u3002"}, {"question": "Papa's Cupcakeria\u7684\u884c\u52d5\u7248\u548c\u684c\u9762\u7248\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "Papa's Cupcakeria\u7684\u884c\u52d5\u7248\u548c\u684c\u9762\u7248\u7684\u4e3b\u8981\u5dee\u7570\u5728\u65bc\u63a7\u5236\u6a5f\u5236\u548c\u87a2\u5e55\u6700\u4f73\u5316\u3002\u5728\u884c\u52d5\u7248\u4e0a\uff0c\u904a\u6232\u4f7f\u7528\u89f8\u63a7\u63a7\u5236\uff0c\u9019\u5c0d\u65bc\u5feb\u901f\u9ede\u64ca\u548c\u6ed1\u52d5\u66f4\u76f4\u89c0\u3002\u5728\u684c\u9762\u7248\u4e0a\uff0c\u904a\u6232\u4f9d\u8cf4\u65bc\u6ed1\u9f20\u9ede\u64ca\uff0c\u9019\u53ef\u4ee5\u63d0\u4f9b\u66f4\u7cbe\u78ba\u7684\u63a7\u5236\u3002\u6b64\u5916\uff0c\u684c\u9762\u7248\u901a\u5e38\u5177\u6709\u66f4\u597d\u7684\u87a2\u5e55\u89e3\u6790\u5ea6\u548c\u66f4\u8a73\u7d30\u7684\u5716\u5f62\u3002\u4f8b\u5982\uff0c\u684c\u9762\u7248\u53ef\u80fd\u6703\u986f\u793a\u66f4\u7cbe\u7d30\u7684\u86cb\u7cd5\u6372\u8a2d\u8a08\uff0c\u589e\u5f37\u8996\u89ba\u9ad4\u9a57\u3002\u73a9\u5bb6\u61c9\u8a72\u9078\u64c7\u6700\u9069\u5408\u5176\u904a\u6232\u98a8\u683c\u548c\u8a2d\u5099\u529f\u80fd\u7684\u5e73\u53f0\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728Papa's Cupcakeria\u4e2d\u9054\u6210\u300c\u5927\u5e2b\u9eb5\u5305\u5e2b\u300d\u6210\u5c31\uff1f", "answer": "\u5728Papa's Cupcakeria\u4e2d\u9054\u6210\u300c\u5927\u5e2b\u9eb5\u5305\u5e2b\u300d\u6210\u5c31\uff0c\u9700\u8981\u638c\u63e1\u86cb\u7cd5\u6372\u6e96\u5099\u548c\u9867\u5ba2\u670d\u52d9\u7684\u6240\u6709\u65b9\u9762\u3002\u6b65\u9a5f1 - \u901a\u904e\u6e96\u78ba\u5730\u6301\u7e8c\u9075\u5faa\u8a02\u55ae\u8a73\u60c5\u4f86\u5b8c\u5584\u60a8\u7684\u86cb\u7cd5\u6372\u7d44\u88dd\u3002\u6b65\u9a5f2 - \u901a\u904e\u7df4\u7fd2\u591a\u5de5\u548c\u6709\u6548\u7684\u5de5\u4f5c\u6d41\u7a0b\u7ba1\u7406\u4f86\u63d0\u9ad8\u901f\u5ea6\u3002\u6b65\u9a5f3 - \u901a\u904e\u4f7f\u7528\u9ad8\u7d1a\u98df\u6750\u548c\u5feb\u901f\u8655\u7406\u8a02\u55ae\uff0c\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u9867\u5ba2\u6eff\u610f\u5ea6\u3002\u4f8b\u5982\uff0c\u6301\u7e8c\u5728\u6e96\u78ba\u6027\u548c\u901f\u5ea6\u4e0a\u7372\u5f97\u9ad8\u5206\u7684\u73a9\u5bb6\uff0c\u540c\u6642\u4fdd\u6301\u9867\u5ba2\u9ad8\u8208\uff0c\u5c07\u89e3\u9396\u6b64\u53d7\u4eba\u5c0a\u656c\u7684\u6210\u5c31\u3002\u5949\u737b\u548c\u7df4\u7fd2\u662f\u6210\u70ba\u300c\u5927\u5e2b\u9eb5\u5305\u5e2b\u300d\u7684\u95dc\u9375\u3002"}, {"question": "\u5728Papa's Cupcakeria\u4e2d\u6709\u6548\u5229\u7528\u904a\u6232\u8ca8\u5e63\u7684\u6700\u4f73\u65b9\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728Papa's Cupcakeria\u4e2d\u6709\u6548\u5229\u7528\u904a\u6232\u8ca8\u5e63\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u60a8\u7684\u904a\u6232\u9ad4\u9a57\u3002\u6b65\u9a5f1 - \u6295\u8cc7\u5fc5\u8981\u7684\u5347\u7d1a\uff0c\u4f8b\u5982\u70e4\u7bb1\u548c\u7cd6\u971c\u5de5\u5177\uff0c\u4ee5\u63d0\u9ad8\u6548\u7387\u3002\u6b65\u9a5f2 - \u8cfc\u8cb7\u9ad8\u7d1a\u98df\u6750\u4ee5\u63d0\u9ad8\u9867\u5ba2\u6eff\u610f\u5ea6\u548c\u5c0f\u8cbb\u3002\u6b65\u9a5f3 - \u4fdd\u5b58\u4e00\u4e9b\u8ca8\u5e63\u4ee5\u53c3\u52a0\u7279\u6b8a\u6d3b\u52d5\u6216\u9650\u6642\u512a\u60e0\uff0c\u53ef\u80fd\u63d0\u4f9b\u7368\u5bb6\u597d\u8655\u3002\u4f8b\u5982\uff0c\u8cfc\u8cb7\u9ad8\u7d1a\u5de7\u514b\u529b\u5e95\u5ea7\u53ef\u4ee5\u5e36\u4f86\u66f4\u9ad8\u7684\u9867\u5ba2\u5c0f\u8cbb\u548c\u66f4\u597d\u7684\u9867\u5ba2\u8a55\u50f9\u3002\u6709\u7b56\u7565\u5730\u82b1\u8cbb\uff0c\u78ba\u4fdd\u60a8\u7684\u8ca8\u5e63\u88ab\u7528\u65bc\u6700\u5927\u5316\u9577\u671f\u597d\u8655\u3002"}]
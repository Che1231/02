[{"question": "\u5982\u4f55\u5728\u300a\u7238\u7238\u7684\u86cb\u7cd5\u5e97\u300b\u6e38\u620f\u4e2d\u5f00\u59cb\u5236\u4f5c\u57fa\u7840\u86cb\u7cd5\uff1f", "answer": "\u8981\u5728\u300a\u7238\u7238\u7684\u86cb\u7cd5\u5e97\u300b\u4e2d\u5f00\u59cb\u7ec4\u88c5\u86cb\u7cd5\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u4ece\u83dc\u5355\u4e2d\u9009\u62e9\u4e00\u4e2a\u86cb\u7cd5\u5e95\u5ea7\uff0c\u4f8b\u5982\u9999\u8349\u6216\u5de7\u514b\u529b\u3002\u6b65\u9aa42 - \u9009\u62e9\u4e00\u79cd\u7cd6\u971c\u53e3\u5473\uff0c\u4f8b\u5982\u8349\u8393\u6216\u5976\u6cb9\u7cd6\u971c\u3002\u6b65\u9aa43 - \u6dfb\u52a0\u88c5\u9970\uff0c\u4f8b\u5982\u5f69\u8272\u7cd6\u971c\u6216\u6c34\u679c\u3002\u4f8b\u5982\uff0c\u4e00\u4e2a\u53d7\u6b22\u8fce\u7684\u9009\u62e9\u662f\u9999\u8349\u5e95\u5ea7\uff0c\u8349\u8393\u7cd6\u971c\u548c\u5f69\u8679\u7cd6\u971c\u3002\u8fd9\u79cd\u7b80\u5355\u7684\u7ec4\u5408\u975e\u5e38\u9002\u5408\u521d\u5b66\u8005\u638c\u63e1\u57fa\u7840\u77e5\u8bc6\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u300a\u7238\u7238\u7684\u86cb\u7cd5\u5e97\u300b\u4e2d\u591a\u4efb\u52a1\u5904\u7406\u5f88\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u6539\u8fdb\uff1f", "answer": "\u5728\u300a\u7238\u7238\u7684\u86cb\u7cd5\u5e97\u300b\u4e2d\uff0c\u591a\u4efb\u52a1\u5904\u7406\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u80fd\u8ba9\u60a8\u9ad8\u6548\u5730\u4e3a\u5ba2\u6237\u670d\u52a1\uff0c\u589e\u52a0\u5c0f\u8d39\u548c\u6574\u4f53\u5f97\u5206\u3002\u8981\u6539\u8fdb\u591a\u4efb\u52a1\u5904\u7406\uff1a\u6b65\u9aa41 - \u6839\u636e\u5ba2\u6237\u7684\u8010\u5fc3\u7a0b\u5ea6\u4f18\u5148\u5b89\u6392\u4efb\u52a1\u3002\u6b65\u9aa42 - \u4f7f\u7528\u7ec3\u4e60\u6a21\u5f0f\u78e8\u7ec3\u60a8\u7684\u6280\u80fd\uff0c\u65e0\u9700\u65f6\u95f4\u538b\u529b\u3002\u6b65\u9aa43 - \u6ce8\u610f\u8ba2\u5355\u961f\u5217\uff0c\u9884\u6d4b\u5373\u5c06\u5230\u6765\u7684\u4efb\u52a1\u3002\u4f8b\u5982\uff0c\u5728\u70d8\u70e4\u5de7\u514b\u529b\u86cb\u7cd5\u7684\u540c\u65f6\uff0c\u60a8\u53ef\u4ee5\u5f00\u59cb\u4e3a\u4e0b\u4e00\u4e2a\u8ba2\u5355\u51c6\u5907\u7cd6\u971c\u3002\u8fd9\u79cd\u7b56\u7565\u6709\u52a9\u4e8e\u5e73\u7a33\u5730\u5904\u7406\u591a\u4e2a\u8ba2\u5355\u3002"}, {"question": "\u5728\u300a\u7238\u7238\u7684\u86cb\u7cd5\u5e97\u300b\u4e2d\uff0c\u5982\u4f55\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u5c0f\u8d39\uff1f", "answer": "\u5728\u300a\u7238\u7238\u7684\u86cb\u7cd5\u5e97\u300b\u4e2d\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u5c0f\u8d39\u9700\u8981\u7ed3\u5408\u901f\u5ea6\u3001\u51c6\u786e\u6027\u548c\u5ba2\u6237\u6ee1\u610f\u5ea6\u3002\u6b65\u9aa41 - \u59cb\u7ec8\u68c0\u67e5\u5ba2\u6237\u7684\u8ba2\u5355\u504f\u597d\u5e76\u76f8\u5e94\u5730\u8fdb\u884c\u5b9a\u5236\u3002\u6b65\u9aa42 - \u5feb\u901f\u63d0\u4f9b\u8ba2\u5355\u4ee5\u4fdd\u6301\u5ba2\u6237\u6ee1\u610f\u3002\u6b65\u9aa43 - \u5c3d\u53ef\u80fd\u4f7f\u7528\u4f18\u8d28\u98df\u6750\uff0c\u56e0\u4e3a\u5b83\u4eec\u53ef\u4ee5\u589e\u52a0\u5c0f\u8d39\u91d1\u989d\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u8fdb\u53e3\u9999\u8349\u7cbe\u800c\u4e0d\u662f\u666e\u901a\u9999\u8349\u7cbe\u53ef\u4ee5\u5c06\u60a8\u7684\u8fd4\u5229\u63d0\u9ad8 10%\u3002\u8bb0\u4f4f\uff0c\u5feb\u4e50\u7684\u5ba2\u6237\u66f4\u6709\u53ef\u80fd\u7559\u4e0b\u6177\u6168\u7684\u5c0f\u8d39\u3002"}, {"question": "\u5728\u300a\u7238\u7238\u7684\u86cb\u7cd5\u5e97\u300b\u4e2d\uff0c\u4e3a\u4e86\u63d0\u5347\u6e38\u620f\u4f53\u9a8c\uff0c\u5e94\u8be5\u4f18\u5148\u5347\u7ea7\u54ea\u4e9b\u5185\u5bb9\uff1f", "answer": "\u5728\u300a\u7238\u7238\u7684\u86cb\u7cd5\u5e97\u300b\u4e2d\u4f18\u5148\u5347\u7ea7\u6e38\u620f\u5185\u5bb9\u53ef\u4ee5\u663e\u8457\u63d0\u5347\u60a8\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u6b65\u9aa41 - \u9996\u5148\u5347\u7ea7\u70e4\u7bb1\u4ee5\u51cf\u5c11\u70d8\u70e4\u65f6\u95f4\u3002\u6b65\u9aa42 - \u6295\u8d44\u66f4\u597d\u7684\u7cd6\u971c\u5de5\u5177\u4ee5\u52a0\u5feb\u7cd6\u971c\u5236\u4f5c\u8fc7\u7a0b\u3002\u6b65\u9aa43 - \u5347\u7ea7\u60a8\u7684\u88c5\u9970\u53f0\u4ee5\u89e3\u9501\u66f4\u591a\u9009\u9879\u5e76\u63d0\u9ad8\u6548\u7387\u3002\u4f8b\u5982\uff0c\u5347\u7ea7\u540e\u7684\u70e4\u7bb1\u53ef\u4ee5\u5c06\u86cb\u7cd5\u70d8\u70e4\u901f\u5ea6\u63d0\u9ad8 20%\uff0c\u8ba9\u60a8\u80fd\u591f\u5904\u7406\u66f4\u591a\u8ba2\u5355\u3002\u8fd9\u4e9b\u5347\u7ea7\u5bf9\u4e8e\u5e0c\u671b\u4f18\u5316\u81ea\u5df1\u8868\u73b0\u7684\u9ad8\u7ea7\u73a9\u5bb6\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u300a\u7238\u7238\u7684\u86cb\u7cd5\u5e97\u300b\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u5b83\uff1f", "answer": "\u300a\u7238\u7238\u7684\u86cb\u7cd5\u5e97\u300b\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u53d7\u51e0\u4e2a\u56e0\u7d20\u5f71\u54cd\uff1a\u51c6\u786e\u6027\u3001\u901f\u5ea6\u548c\u5ba2\u6237\u6ee1\u610f\u5ea6\u3002\u6b65\u9aa41 - \u51c6\u786e\u5730\u9075\u5faa\u5ba2\u6237\u7684\u8ba2\u5355\u7ec6\u8282\u81f3\u5173\u91cd\u8981\u3002\u6b65\u9aa42 - \u86cb\u7cd5\u7684\u51c6\u5907\u548c\u4f9b\u5e94\u901f\u5ea6\u4f1a\u79ef\u6781\u5730\u5f71\u54cd\u60a8\u7684\u5206\u6570\u3002\u6b65\u9aa43 - \u5ba2\u6237\u6ee1\u610f\u5ea6\uff0c\u4ee5\u5ba2\u6237\u7684\u5feb\u4e50\u7a0b\u5ea6\u6765\u8861\u91cf\uff0c\u4e5f\u8d77\u7740\u81f3\u5173\u91cd\u8981\u7684\u4f5c\u7528\u3002\u4f8b\u5982\uff0c\u4e00\u4e2a\u5b8c\u7f8e\u7ec4\u88c5\u7684\u86cb\u7cd5\u4ee5\u5feb\u901f\u7684\u901f\u5ea6\u63d0\u4f9b\u7ed9\u4e00\u4e2a\u5feb\u4e50\u7684\u987e\u5ba2\uff0c\u53ef\u4ee5\u83b7\u5f97\u9ad8\u5206\u3002\u4e86\u89e3\u8fd9\u4e9b\u56e0\u7d20\u6709\u52a9\u4e8e\u5236\u5b9a\u66f4\u597d\u7684\u7b56\u7565\u4ee5\u83b7\u5f97\u66f4\u597d\u7684\u7ed3\u679c\u3002"}, {"question": "\u5728\u300a\u7238\u7238\u7684\u86cb\u7cd5\u5e97\u300b\u4e2d\uff0c\u73a9\u5bb6\u53ef\u80fd\u4f1a\u5ffd\u7565\u54ea\u4e9b\u9690\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "\u300a\u7238\u7238\u7684\u86cb\u7cd5\u5e97\u300b\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u7684\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u53ef\u4ee5\u589e\u5f3a\u60a8\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u4e00\u4e2a\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\u80fd\u591f\u901a\u8fc7\u4f7f\u7528\u6240\u6709\u53ef\u7528\u7684\u88c5\u9970\u6765\u5236\u4f5c\u4e00\u4e2a\u7279\u6b8a\u7684\u201c\u5f69\u8679\u76db\u5bb4\u201d\u86cb\u7cd5\u3002\u8fd9\u79cd\u72ec\u7279\u7684\u521b\u4f5c\u4e0d\u4ec5\u80fd\u7ed9\u5ba2\u6237\u7559\u4e0b\u6df1\u523b\u5370\u8c61\uff0c\u8fd8\u80fd\u89e3\u9501\u4e00\u9879\u7279\u6b8a\u7684\u6210\u5c31\u3002\u53e6\u4e00\u4e2a\u9690\u85cf\u529f\u80fd\u662f\u79d8\u5bc6\u83dc\u5355\uff0c\u901a\u8fc7\u6309\u4f4f\u83dc\u5355\u6309\u94ae 5 \u79d2\u624d\u80fd\u8bbf\u95ee\uff0c\u5b83\u63d0\u4f9b\u7a00\u6709\u548c\u4f18\u8d28\u7684\u98df\u6750\u3002\u63a2\u7d22\u8fd9\u4e9b\u9690\u85cf\u5143\u7d20\u4e3a\u6e38\u620f\u589e\u52a0\u4e86\u989d\u5916\u7684\u4e50\u8da3\u548c\u53d1\u73b0\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u7238\u7238\u7684\u86cb\u7cd5\u5e97\u300b\u4e2d\u6709\u6548\u5730\u7ba1\u7406\u65f6\u95f4\u4ee5\u5904\u7406\u591a\u4e2a\u8ba2\u5355\uff1f", "answer": "\u5728\u300a\u7238\u7238\u7684\u86cb\u7cd5\u5e97\u300b\u4e2d\u6709\u6548\u5730\u7ba1\u7406\u65f6\u95f4\u662f\u6210\u529f\u5904\u7406\u591a\u4e2a\u8ba2\u5355\u7684\u5173\u952e\u3002\u6b65\u9aa41 - \u9996\u5148\u6574\u7406\u60a8\u7684\u5de5\u4f5c\u533a\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u4efb\u52a1\u4e4b\u95f4\u7684\u79fb\u52a8\u3002\u6b65\u9aa42 - \u4f7f\u7528\u6bcf\u4e2a\u8ba2\u5355\u4e0a\u7684\u8ba1\u65f6\u5668\u6765\u4f18\u5148\u8003\u8651\u5148\u51c6\u5907\u54ea\u4e9b\u86cb\u7cd5\u3002\u6b65\u9aa43 - \u901a\u8fc7\u540c\u65f6\u51c6\u5907\u591a\u4e2a\u5e95\u5ea7\u5e76\u5728\u5176\u4ed6\u86cb\u7cd5\u4e0a\u6d82\u62b9\u7cd6\u971c\u6765\u5206\u914d\u4efb\u52a1\u3002\u4f8b\u5982\uff0c\u60a8\u53ef\u4ee5\u70d8\u70e4\u4e00\u4e2a\u9999\u8349\u86cb\u7cd5\uff0c\u540c\u65f6\u5728\u5de7\u514b\u529b\u86cb\u7cd5\u4e0a\u6d82\u62b9\u7cd6\u971c\uff0c\u786e\u4fdd\u4e0d\u6d6a\u8d39\u4efb\u4f55\u65f6\u95f4\u3002\u8fd9\u79cd\u65b9\u6cd5\u6709\u52a9\u4e8e\u4fdd\u6301\u8ba2\u5355\u7684\u7a33\u5b9a\u6d41\u52a8\uff0c\u800c\u4e0d\u4f1a\u8ba9\u81ea\u5df1\u611f\u5230\u4e0d\u582a\u91cd\u8d1f\u3002"}, {"question": "\u300a\u7238\u7238\u7684\u86cb\u7cd5\u5e97\u300b\u7684\u79fb\u52a8\u7248\u548c\u684c\u9762\u7248\u6709\u54ea\u4e9b\u5173\u952e\u533a\u522b\uff1f", "answer": "\u300a\u7238\u7238\u7684\u86cb\u7cd5\u5e97\u300b\u7684\u79fb\u52a8\u7248\u548c\u684c\u9762\u7248\u7684\u4e3b\u8981\u533a\u522b\u5728\u4e8e\u63a7\u5236\u673a\u5236\u548c\u5c4f\u5e55\u4f18\u5316\u3002\u5728\u79fb\u52a8\u7248\u4e2d\uff0c\u6e38\u620f\u4f7f\u7528\u89e6\u63a7\u63a7\u5236\uff0c\u8fd9\u5bf9\u4e8e\u5feb\u901f\u70b9\u51fb\u548c\u6ed1\u52a8\u53ef\u80fd\u66f4\u76f4\u89c2\u3002\u5728\u684c\u9762\u7248\u4e2d\uff0c\u6e38\u620f\u4f9d\u9760\u9f20\u6807\u70b9\u51fb\uff0c\u8fd9\u53ef\u80fd\u63d0\u4f9b\u66f4\u9ad8\u7684\u7cbe\u5ea6\u3002\u6b64\u5916\uff0c\u684c\u9762\u7248\u672c\u901a\u5e38\u5177\u6709\u66f4\u597d\u7684\u5c4f\u5e55\u5206\u8fa8\u7387\u548c\u66f4\u7cbe\u7ec6\u7684\u56fe\u5f62\u3002\u4f8b\u5982\uff0c\u684c\u9762\u7248\u672c\u53ef\u80fd\u4f1a\u663e\u793a\u66f4\u590d\u6742\u7684\u86cb\u7cd5\u8bbe\u8ba1\uff0c\u589e\u5f3a\u89c6\u89c9\u4f53\u9a8c\u3002\u73a9\u5bb6\u5e94\u8be5\u9009\u62e9\u6700\u9002\u5408\u5176\u6e38\u620f\u98ce\u683c\u548c\u8bbe\u5907\u529f\u80fd\u7684\u5e73\u53f0\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u7238\u7238\u7684\u86cb\u7cd5\u5e97\u300b\u4e2d\u83b7\u5f97\u201c\u5927\u5e08\u70d8\u7119\u5e08\u201d\u6210\u5c31\uff1f", "answer": "\u5728\u300a\u7238\u7238\u7684\u86cb\u7cd5\u5e97\u300b\u4e2d\u83b7\u5f97\u201c\u5927\u5e08\u70d8\u7119\u5e08\u201d\u6210\u5c31\u9700\u8981\u638c\u63e1\u86cb\u7cd5\u5236\u4f5c\u548c\u5ba2\u6237\u670d\u52a1\u7684\u65b9\u65b9\u9762\u9762\u3002\u6b65\u9aa41 - \u901a\u8fc7\u51c6\u786e\u5730\u59cb\u7ec8\u9075\u5faa\u8ba2\u5355\u7ec6\u8282\u6765\u5b8c\u5584\u60a8\u7684\u86cb\u7cd5\u7ec4\u88c5\u3002\u6b65\u9aa42 - \u901a\u8fc7\u7ec3\u4e60\u591a\u4efb\u52a1\u5904\u7406\u548c\u9ad8\u6548\u5de5\u4f5c\u6d41\u7a0b\u7ba1\u7406\u6765\u63d0\u9ad8\u901f\u5ea6\u3002\u6b65\u9aa43 - \u901a\u8fc7\u4f7f\u7528\u4f18\u8d28\u98df\u6750\u548c\u5feb\u901f\u9001\u8fbe\u8ba2\u5355\u6765\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u5ba2\u6237\u6ee1\u610f\u5ea6\u3002\u4f8b\u5982\uff0c\u4e00\u4e2a\u59cb\u7ec8\u5728\u51c6\u786e\u6027\u548c\u901f\u5ea6\u65b9\u9762\u83b7\u5f97\u9ad8\u5206\u7684\u73a9\u5bb6\uff0c\u540c\u65f6\u8ba9\u5ba2\u6237\u6ee1\u610f\uff0c\u5c06\u4f1a\u89e3\u9501\u8fd9\u4e00\u58f0\u671b\u6210\u5c31\u3002\u5949\u732e\u548c\u7ec3\u4e60\u662f\u6210\u4e3a\u201c\u5927\u5e08\u70d8\u7119\u5e08\u201d\u7684\u5173\u952e\u3002"}, {"question": "\u5728\u300a\u7238\u7238\u7684\u86cb\u7cd5\u5e97\u300b\u4e2d\uff0c\u5982\u4f55\u6709\u6548\u5730\u5229\u7528\u6e38\u620f\u8d27\u5e01\uff1f", "answer": "\u5728\u300a\u7238\u7238\u7684\u86cb\u7cd5\u5e97\u300b\u4e2d\u6709\u6548\u5730\u5229\u7528\u6e38\u620f\u8d27\u5e01\u53ef\u4ee5\u6781\u5927\u5730\u589e\u5f3a\u60a8\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u6b65\u9aa41 - \u6295\u8d44\u5fc5\u8981\u7684\u5347\u7ea7\uff0c\u4f8b\u5982\u70e4\u7bb1\u548c\u7cd6\u971c\u5de5\u5177\uff0c\u4ee5\u63d0\u9ad8\u6548\u7387\u3002\u6b65\u9aa42 - \u8d2d\u4e70\u4f18\u8d28\u98df\u6750\u4ee5\u63d0\u9ad8\u5ba2\u6237\u6ee1\u610f\u5ea6\u548c\u5c0f\u8d39\u3002\u6b65\u9aa43 - \u4e3a\u7279\u6b8a\u6d3b\u52a8\u6216\u9650\u65f6\u4f18\u60e0\u4fdd\u7559\u4e00\u4e9b\u6e38\u620f\u8d27\u5e01\uff0c\u5b83\u4eec\u53ef\u80fd\u63d0\u4f9b\u72ec\u5bb6\u798f\u5229\u3002\u4f8b\u5982\uff0c\u8d2d\u4e70\u4f18\u8d28\u5de7\u514b\u529b\u5e95\u5ea7\u53ef\u4ee5\u5e26\u6765\u66f4\u9ad8\u7684\u8fd4\u5229\u548c\u66f4\u597d\u7684\u5ba2\u6237\u8bc4\u4ef7\u3002\u6218\u7565\u6027\u652f\u51fa\u786e\u4fdd\u60a8\u7684\u6e38\u620f\u8d27\u5e01\u88ab\u7528\u4e8e\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u957f\u671f\u6548\u76ca\u3002"}]
[{"question": "\ud30c\ud30c's \ucef5\ucf00\uc774\ud06c\ub9ac\uc544\uc5d0\uc11c \uae30\ubcf8 \ucef5\ucf00\uc774\ud06c \uc870\ub9bd\uc744 \uc2dc\uc791\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\ud30c's \ucef5\ucf00\uc774\ud06c\ub9ac\uc544\uc5d0\uc11c \ucef5\ucf00\uc774\ud06c \uc870\ub9bd\uc744 \uc2dc\uc791\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. STEP1 - \ubc14\ub2d0\ub77c \ub610\ub294 \ucd08\ucf5c\ub9bf\uacfc \uac19\uc774 \uba54\ub274\uc5d0\uc11c \ucef5\ucf00\uc774\ud06c \ubc11\ubd80\ubd84(\ubca0\uc774\uc2a4)\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. STEP2 - \ub538\uae30 \ub610\ub294 \ubc84\ud130\ud06c\ub9bc\uacfc \uac19\uc774 \uc288\ud305\ud06c\ub9bc(frosting)\uc758 \uc885\ub958\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. STEP3 - \uc2a4\ud504\ub9c1\ud074\uc774\ub098 \uacfc\uc77c\uacfc \uac19\uc740 \ud1a0\ud551\uc744 \ucd94\uac00\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubc14\ub2d0\ub77c \ubc11\ubd80\ubd84\uc5d0 \ub538\uae30 \uc288\ud305\ud06c\ub9bc\uacfc \ubb34\uc9c0\uac1c \uc2a4\ud504\ub9c1\ud074\uc744 \uc5b9\ub294 \uac83\uc774 \uc778\uae30 \uc788\ub294 \uc120\ud0dd\uc785\ub2c8\ub2e4. \uc774 \uac04\ub2e8\ud55c \uc870\ud569\uc740 \ucd08\ubcf4\uc790\uac00 \uae30\ubcf8\uc744 \uc775\ud788\uae30\uc5d0 \uc644\ubcbd\ud569\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c's \ucef5\ucf00\uc774\ud06c\ub9ac\uc544\uc5d0\uc11c \uba40\ud2f0\ud0dc\uc2a4\ud0b9\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \uac1c\uc120\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud30c\ud30c's \ucef5\ucf00\uc774\ud06c\ub9ac\uc544\uc5d0\uc11c \uba40\ud2f0\ud0dc\uc2a4\ud0b9\uc740 \uace0\uac1d\uc5d0\uac8c \ud6a8\uc728\uc801\uc73c\ub85c \uc11c\ube44\uc2a4\ub97c \uc81c\uacf5\ud558\uc5ec \ud301\uacfc \uc804\uccb4 \uc810\uc218\ub97c \ub192\uc77c \uc218 \uc788\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \uba40\ud2f0\ud0dc\uc2a4\ud0b9\uc744 \uac1c\uc120\ud558\ub824\uba74 \ub2e4\uc74c\uacfc \uac19\uc774 \ud558\uc138\uc694. STEP1 - \uace0\uac1d\uc758 \uae30\ub2e4\ub9bc \uc815\ub3c4\ub97c \uae30\uc900\uc73c\ub85c \uc791\uc5c5 \uc6b0\uc120\uc21c\uc704\ub97c \uc815\ud569\ub2c8\ub2e4. STEP2 - \uc2dc\uac04\uc5d0 \ub300\ud55c \uc555\ubc15 \uc5c6\uc774 \uae30\uc220\uc744 \uc5f0\ub9c8\ud558\uae30 \uc704\ud574 \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. STEP3 - \uc8fc\ubb38 \ub300\uae30\uc5f4\uc744 \uc8fc\uc2dc\ud558\uc5ec \uc55e\uc73c\ub85c \ubc1c\uc0dd\ud560 \uc791\uc5c5\uc744 \uc608\uce21\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucd08\ucf5c\ub9bf \ucef5\ucf00\uc774\ud06c\ub97c \uad6c\uc6b8 \ub54c \ub2e4\uc74c \uc8fc\ubb38\uc744 \uc704\ud55c \uc288\ud305\ud06c\ub9bc\uc744 \uc900\ube44\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc804\ub7b5\uc740 \uc5ec\ub7ec \uc8fc\ubb38\uc744 \uc6d0\ud65c\ud558\uac8c \uad00\ub9ac\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c's \ucef5\ucf00\uc774\ud06c\ub9ac\uc544\uc5d0\uc11c \ud301\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\ud30c's \ucef5\ucf00\uc774\ud06c\ub9ac\uc544\uc5d0\uc11c \ud301\uc744 \uadf9\ub300\ud654\ud558\ub824\uba74 \uc18d\ub3c4, \uc815\ud655\uc131 \ubc0f \uace0\uac1d \ub9cc\uc871\ub3c4\ub97c \uacb0\ud569\ud574\uc57c \ud569\ub2c8\ub2e4. STEP1 - \ud56d\uc0c1 \uace0\uac1d\uc758 \uc8fc\ubb38 \uc120\ud638\ub3c4\ub97c \ud655\uc778\ud558\uace0 \ub9de\ucda4 \uc124\uc815\ud569\ub2c8\ub2e4. STEP2 - \uace0\uac1d \ub9cc\uc871\ub3c4\ub97c \uc720\uc9c0\ud558\uae30 \uc704\ud574 \uc8fc\ubb38\uc744 \uc2e0\uc18d\ud558\uac8c \uc81c\uacf5\ud569\ub2c8\ub2e4. STEP3 - \uac00\ub2a5\ud55c \uacbd\uc6b0 \ud504\ub9ac\ubbf8\uc5c4 \uc7ac\ub8cc\ub97c \uc0ac\uc6a9\ud558\uba74 \ud301\uc758 \uae08\uc561\uc774 \uc99d\uac00\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc77c\ubc18 \ubc14\ub2d0\ub77c \ucd94\ucd9c\ubb3c \ub300\uc2e0 \uc218\uc785 \ubc14\ub2d0\ub77c \ucd94\ucd9c\ubb3c\uc744 \uc0ac\uc6a9\ud558\uba74 \ud301\uc774 10% \uc99d\uac00\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uae30\ubd84 \uc88b\uc740 \uace0\uac1d\uc740 \ub354 \ud48d\uc131\ud55c \ud301\uc744 \ub0a8\uae38 \uac00\ub2a5\uc131\uc774 \ub192\uc2b5\ub2c8\ub2e4."}, {"question": "\uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\uae30 \uc704\ud574 \ud30c\ud30c's \ucef5\ucf00\uc774\ud06c\ub9ac\uc544\uc5d0\uc11c \uc6b0\uc120\uc801\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud574\uc57c \ud560 \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\ud30c's \ucef5\ucf00\uc774\ud06c\ub9ac\uc544\uc5d0\uc11c \uc5c5\uadf8\ub808\uc774\ub4dc \uc6b0\uc120\uc21c\uc704\ub97c \uc815\ud558\uba74 \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc774 \ud06c\uac8c \ud5a5\uc0c1\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1 - \uad7d\ub294 \uc2dc\uac04\uc744 \uc904\uc774\uae30 \uc704\ud574 \uba3c\uc800 \uc624\ube10\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. STEP2 - \uc288\ud305\ud06c\ub9bc \uc791\uc5c5 \uc18d\ub3c4\ub97c \ub192\uc774\uae30 \uc704\ud574 \ub354 \ub098\uc740 \uc288\ud305\ud06c\ub9bc \ub3c4\uad6c\uc5d0 \ud22c\uc790\ud558\uc138\uc694. STEP3 - \ub354 \ub9ce\uc740 \uc635\uc158\uc744 \uc7a0\uae08 \ud574\uc81c\ud558\uace0 \ud6a8\uc728\uc131\uc744 \ub192\uc774\uae30 \uc704\ud574 \ud1a0\ud551 \uc2a4\ud14c\uc774\uc158\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc5c5\uadf8\ub808\uc774\ub4dc\ub41c \uc624\ube10\uc740 \ucef5\ucf00\uc774\ud06c\ub97c 20% \ub354 \ube60\ub974\uac8c \uad6c\uc6b8 \uc218 \uc788\uc5b4 \ub354 \ub9ce\uc740 \uc8fc\ubb38\uc744 \ucc98\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub824\ub294 \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ud544\uc218\uc801\uc785\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c's \ucef5\ucf00\uc774\ud06c\ub9ac\uc544\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uc5b4\ub5a4 \uc694\uc18c\uac00 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ud30c\ud30c's \ucef5\ucf00\uc774\ud06c\ub9ac\uc544\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc815\ud655\uc131, \uc18d\ub3c4 \ubc0f \uace0\uac1d \ub9cc\uc871\ub3c4\uc640 \uac19\uc740 \uc5ec\ub7ec \uc694\uc18c\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. STEP1 - \uace0\uac1d\uc758 \uc8fc\ubb38 \uc138\ubd80 \uc0ac\ud56d\uc744 \uc815\ud655\ud788 \ub530\ub974\ub294 \uc815\ud655\uc131\uc740 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. STEP2 - \ucef5\ucf00\uc774\ud06c\ub97c \uc900\ube44\ud558\uace0 \uc81c\uacf5\ud558\ub294 \uc18d\ub3c4\ub294 \uc810\uc218\uc5d0 \uae0d\uc815\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. STEP3 - \uace0\uac1d\uc758 \ub9cc\uc871\ub3c4(\ud589\ubcf5 \uc218\uc900)\ub294 \uc911\uc694\ud55c \uc5ed\ud560\uc744 \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc644\ubcbd\ud558\uac8c \uc870\ub9bd\ub41c \ucef5\ucf00\uc774\ud06c\ub97c \uc2e0\uc18d\ud558\uac8c \ud589\ubcf5\ud55c \uace0\uac1d\uc5d0\uac8c \uc81c\uacf5\ud558\uba74 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc694\uc18c\ub97c \uc774\ud574\ud558\uba74 \ub354 \ub098\uc740 \uacb0\uacfc\ub97c \uc704\ud55c \uc804\ub7b5\uc744 \uc138\uc6b0\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c's \ucef5\ucf00\uc774\ud06c\ub9ac\uc544\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 \uac04\uacfc\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\ud30c's \ucef5\ucf00\uc774\ud06c\ub9ac\uc544\uc5d0\ub294 \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uae30\ub2a5\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \ub208\uc5d0 \ub744\ub294 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uc0ac\uc6a9 \uac00\ub2a5\ud55c \ubaa8\ub4e0 \ud1a0\ud551\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud2b9\ubcc4\ud55c '\ubb34\uc9c0\uac1c \ucef5\ucf00\uc774\ud06c'\ub97c \ub9cc\ub4dc\ub294 \ub2a5\ub825\uc785\ub2c8\ub2e4. \uc774 \ub3c5\ucc3d\uc801\uc778 \uc791\ud488\uc740 \uace0\uac1d\uc744 \uac10\ub3d9\uc2dc\ud0ac \ubfd0\ub9cc \uc544\ub2c8\ub77c \ud2b9\ubcc4\ud55c \uc131\ucde8\ub3c4\ub97c \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc740 \uba54\ub274 \ubc84\ud2bc\uc744 5\ucd08 \ub3d9\uc548 \ub204\ub974\uba74 \uc811\uadfc\ud560 \uc218 \uc788\ub294 \ube44\ubc00 \uba54\ub274\ub85c, \ub4dc\ubb38 \ud504\ub9ac\ubbf8\uc5c4 \uc7ac\ub8cc\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uc694\uc18c\ub97c \ud0d0\ud5d8\ud558\uba74 \uac8c\uc784\uc5d0 \uc7ac\ubbf8\uc640 \ubc1c\uacac\uc758 \ub610 \ub2e4\ub978 \uacc4\uce35\uc744 \ucd94\uac00\ud569\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c's \ucef5\ucf00\uc774\ud06c\ub9ac\uc544\uc5d0\uc11c \uc5ec\ub7ec \uc8fc\ubb38\uc744 \ucc98\ub9ac\ud558\uae30 \uc704\ud574 \uc2dc\uac04\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\ud30c's \ucef5\ucf00\uc774\ud06c\ub9ac\uc544\uc5d0\uc11c \ud6a8\uacfc\uc801\uc778 \uc2dc\uac04 \uad00\ub9ac \ub2a5\ub825\uc740 \uc5ec\ub7ec \uc8fc\ubb38\uc744 \uc131\uacf5\uc801\uc73c\ub85c \ucc98\ub9ac\ud558\ub294 \ub370 \uc911\uc694\ud569\ub2c8\ub2e4. STEP1 - \uc791\uc5c5 \uac04 \uc774\ub3d9\uc744 \ucd5c\uc18c\ud654\ud558\uae30 \uc704\ud574 \uc791\uc5c5 \uacf5\uac04\uc744 \uc815\ub9ac\ud569\ub2c8\ub2e4. STEP2 - \uac01 \uc8fc\ubb38\uc758 \ud0c0\uc774\uba38\ub97c \uc0ac\uc6a9\ud558\uc5ec \uba3c\uc800 \uc5b4\ub5a4 \ucef5\ucf00\uc774\ud06c\ub97c \uc900\ube44\ud560\uc9c0 \uc6b0\uc120\uc21c\uc704\ub97c \uc815\ud569\ub2c8\ub2e4. STEP3 - \ub2e4\ub978 \ucef5\ucf00\uc774\ud06c\uc758 \uc288\ud305\ud06c\ub9bc\uc744 \ubc14\ub974\ub294 \ub3d9\uc548 \uc5ec\ub7ec \uac1c\uc758 \ubc11\ubd80\ubd84(\ubca0\uc774\uc2a4)\uc744 \ub3d9\uc2dc\uc5d0 \uc900\ube44\ud558\uc5ec \uc791\uc5c5\uc744 \ubd84\ub2f4\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubc14\ub2d0\ub77c \ucef5\ucf00\uc774\ud06c\ub97c \uad6c\uc6b8 \ub54c \ucd08\ucf5c\ub9bf \ucef5\ucf00\uc774\ud06c\uc758 \uc288\ud305\ud06c\ub9bc\uc744 \ubc14\ub97c \uc218 \uc788\uc73c\ubbc0\ub85c \uc2dc\uac04 \ub0ad\ube44\uac00 \uc5c6\uc2b5\ub2c8\ub2e4. \uc774 \uc811\uadfc \ubc29\uc2dd\uc740 \uc2a4\uc2a4\ub85c\ub97c \uacfc\ubd80\ud558\uc2dc\ud0a4\uc9c0 \uc54a\uace0 \uc8fc\ubb38\uc758 \uafb8\uc900\ud55c \ud750\ub984\uc744 \uc720\uc9c0\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c's \ucef5\ucf00\uc774\ud06c\ub9ac\uc544\uc758 \ubaa8\ubc14\uc77c \ubc84\uc804\uacfc \ub370\uc2a4\ud06c\ud0d1 \ubc84\uc804\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\ud30c's \ucef5\ucf00\uc774\ud06c\ub9ac\uc544\uc758 \ubaa8\ubc14\uc77c \ubc84\uc804\uacfc \ub370\uc2a4\ud06c\ud0d1 \ubc84\uc804\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc5d0\ub294 \uc81c\uc5b4 \uba54\ucee4\ub2c8\uc998\uacfc \ud654\uba74 \ucd5c\uc801\ud654\uac00 \ud3ec\ud568\ub429\ub2c8\ub2e4. \ubaa8\ubc14\uc77c\uc5d0\uc11c\ub294 \ud0ed\uacfc \uc2a4\uc640\uc774\ud504\uac00 \ube60\ub974\uac8c \uc774\ub8e8\uc5b4\uc9c0\ub294 \ub370 \ub354 \uc9c1\uad00\uc801\uc778 \ud130\uce58 \uc81c\uc5b4\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ub370\uc2a4\ud06c\ud0d1\uc5d0\uc11c\ub294 \ub354 \uc815\ubc00\ud55c \ub9c8\uc6b0\uc2a4 \ud074\ub9ad\uc744 \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. \ub610\ud55c \ub370\uc2a4\ud06c\ud0d1 \ubc84\uc804\uc740 \uc885\uc885 \ub354 \ub098\uc740 \ud654\uba74 \ud574\uc0c1\ub3c4\uc640 \ub354\uc6b1 \uc0c1\uc138\ud55c \uadf8\ub798\ud53d\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub370\uc2a4\ud06c\ud0d1 \ubc84\uc804\uc740 \ucef5\ucf00\uc774\ud06c \ub514\uc790\uc778\uc744 \ub354 \ubcf5\uc7a1\ud558\uac8c \ud45c\uc2dc\ud558\uc5ec \uc2dc\uac01\uc801\uc778 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\ub294 \uc790\uc2e0\uc758 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \uac00\uc7a5 \uc801\ud569\ud558\uace0 \uc7a5\uce58 \uae30\ub2a5\uc744 \uace0\ub824\ud55c \ud50c\ub7ab\ud3fc\uc744 \uc120\ud0dd\ud574\uc57c \ud569\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c's \ucef5\ucf00\uc774\ud06c\ub9ac\uc544\uc5d0\uc11c '\ub9c8\uc2a4\ud130 \ubca0\uc774\ucee4' \ub3c4\uc804 \uacfc\uc81c\ub97c \ub2ec\uc131\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\ud30c's \ucef5\ucf00\uc774\ud06c\ub9ac\uc544\uc5d0\uc11c '\ub9c8\uc2a4\ud130 \ubca0\uc774\ucee4' \ub3c4\uc804 \uacfc\uc81c\ub97c \ub2ec\uc131\ud558\ub824\uba74 \ucef5\ucf00\uc774\ud06c \uc900\ube44\uc640 \uace0\uac1d \uc11c\ube44\uc2a4\uc758 \ubaa8\ub4e0 \uce21\uba74\uc744 \uc219\ub2ec\ud574\uc57c \ud569\ub2c8\ub2e4. STEP1 - \uc8fc\ubb38 \uc138\ubd80 \uc0ac\ud56d\uc744 \uc815\ud655\ud788 \ub530\ub77c \ucef5\ucf00\uc774\ud06c \uc870\ub9bd\uc744 \uc644\ubcbd\ud558\uac8c \ud569\ub2c8\ub2e4. STEP2 - \uba40\ud2f0\ud0dc\uc2a4\ud0b9\uacfc \ud6a8\uc728\uc801\uc778 \uc791\uc5c5 \ud750\ub984 \uad00\ub9ac\ub97c \uc5f0\uc2b5\ud558\uc5ec \uc18d\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4. STEP3 - \ud504\ub9ac\ubbf8\uc5c4 \uc7ac\ub8cc \uc0ac\uc6a9 \ubc0f \uc8fc\ubb38 \uc2e0\uc18d \uc81c\uacf5\uc73c\ub85c \uace0\uac1d \ub9cc\uc871\ub3c4\ub97c \uadf9\ub300\ud654\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc815\ud655\uc131\uacfc \uc18d\ub3c4\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc73c\uba74\uc11c \ub3d9\uc2dc\uc5d0 \uace0\uac1d\uc744 \ub9cc\uc871\uc2dc\ud0a4\ub294 \ud50c\ub808\uc774\uc5b4\ub294 \uc774 \uad8c\uc704 \uc788\ub294 \uc5c5\uc801\uc744 \uc7a0\uae08 \ud574\uc81c\ud560 \uac83\uc785\ub2c8\ub2e4. \ud5cc\uc2e0\uacfc \uc5f0\uc2b5\uc774 '\ub9c8\uc2a4\ud130 \ubca0\uc774\ucee4'\uac00 \ub418\ub294 \uc5f4\uc1e0\uc785\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c's \ucef5\ucf00\uc774\ud06c\ub9ac\uc544\uc5d0\uc11c \uac8c\uc784 \ub0b4 \ud1b5\ud654\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\ub294 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\ud30c's \ucef5\ucf00\uc774\ud06c\ub9ac\uc544\uc5d0\uc11c \uac8c\uc784 \ub0b4 \ud1b5\ud654\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\uba74 \uac8c\uc784 \ud50c\ub808\uc774\uac00 \ud06c\uac8c \ud5a5\uc0c1\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1 - \ud6a8\uc728\uc131\uc744 \ub192\uc774\uae30 \uc704\ud574 \uc624\ube10\uacfc \uc288\ud305\ud06c\ub9bc \ub3c4\uad6c\uc640 \uac19\uc740 \ud544\uc218 \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0 \ud22c\uc790\ud569\ub2c8\ub2e4. STEP2 - \uace0\uac1d \ub9cc\uc871\ub3c4\uc640 \ud301\uc744 \ub192\uc774\uae30 \uc704\ud574 \ud504\ub9ac\ubbf8\uc5c4 \uc7ac\ub8cc\ub97c \uad6c\ub9e4\ud569\ub2c8\ub2e4. STEP3 - \ud2b9\ubcc4 \uc774\ubca4\ud2b8\ub098 \uc81c\ud55c \uc2dc\uac04 \ud310\ub9e4\uc5d0\uc11c \ub3c5\uc810\uc801\uc778 \ud61c\ud0dd\uc744 \uc5bb\uc744 \uc218 \uc788\ub3c4\ub85d \uc77c\ubd80 \ud1b5\ud654\ub97c \uc800\ucd95\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud504\ub9ac\ubbf8\uc5c4 \ucd08\ucf5c\ub9bf \ubc11\ubd80\ubd84(\ubca0\uc774\uc2a4)\uc744 \uad6c\ub9e4\ud558\uba74 \ub192\uc740 \ud301\uacfc \ub354 \ub098\uc740 \uace0\uac1d \ub9ac\ubdf0\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc804\ub7b5\uc801\uc778 \uc9c0\ucd9c\uc740 \ud1b5\ud654\uac00 \uc7a5\uae30\uc801\uc778 \uc774\uc810\uc744 \uadf9\ub300\ud654\ud558\ub294 \ub370 \uc0ac\uc6a9\ub418\ub294 \ubc29\uc2dd\uc785\ub2c8\ub2e4."}]
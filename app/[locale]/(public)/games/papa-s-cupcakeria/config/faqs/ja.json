[{"question": "\u30d1\u30d1\u30fc\u30ba\u30fb\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u30ea\u30a2\u3067\u57fa\u672c\u7684\u306a\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u306e\u7d44\u307f\u7acb\u3066\u3092\u59cb\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30fc\u30ba\u30fb\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u30ea\u30a2\u3067\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u306e\u7d44\u307f\u7acb\u3066\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002STEP1 - \u30e1\u30cb\u30e5\u30fc\u304b\u3089\u30d0\u30cb\u30e9\u3084\u30c1\u30e7\u30b3\u30ec\u30fc\u30c8\u306a\u3069\u306e\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u306e\u751f\u5730\u3092\u9078\u3073\u307e\u3057\u3087\u3046\u3002STEP2 - \u30b9\u30c8\u30ed\u30d9\u30ea\u30fc\u3084\u30d0\u30bf\u30fc\u30af\u30ea\u30fc\u30e0\u306a\u3069\u3001\u304a\u597d\u307f\u306e\u30af\u30ea\u30fc\u30e0\u306e\u30d5\u30ec\u30fc\u30d0\u30fc\u3092\u9078\u3073\u307e\u3059\u3002STEP3 - \u30b9\u30d7\u30ea\u30f3\u30af\u30eb\u3084\u30d5\u30eb\u30fc\u30c4\u306a\u3069\u306e\u30c8\u30c3\u30d4\u30f3\u30b0\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d0\u30cb\u30e9\u751f\u5730\u306b\u30b9\u30c8\u30ed\u30d9\u30ea\u30fc\u30af\u30ea\u30fc\u30e0\u3068\u8679\u8272\u306e\u30b9\u30d7\u30ea\u30f3\u30af\u30eb\u3092\u98fe\u308b\u7d44\u307f\u5408\u308f\u305b\u306f\u3001\u521d\u5fc3\u8005\u306e\u65b9\u3067\u3082\u57fa\u672c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306e\u306b\u6700\u9069\u3067\u3059\u3002"}, {"question": "\u30d1\u30d1\u30fc\u30ba\u30fb\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u30ea\u30a2\u3067\u540c\u6642\u4f5c\u696d\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u3069\u306e\u3088\u3046\u306b\u6539\u5584\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30fc\u30ba\u30fb\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u30ea\u30a2\u3067\u540c\u6642\u4f5c\u696d\u306f\u3001\u52b9\u7387\u7684\u306b\u9867\u5ba2\u306b\u30b5\u30fc\u30d3\u30b9\u3092\u63d0\u4f9b\u3057\u3001\u30c1\u30c3\u30d7\u3092\u5897\u3084\u3057\u3066\u5168\u4f53\u7684\u306a\u30b9\u30b3\u30a2\u3092\u4e0a\u3052\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u540c\u6642\u4f5c\u696d\u3092\u6539\u5584\u3059\u308b\u305f\u3081\u306b\uff1aSTEP1 - \u9867\u5ba2\u306e\u5f85\u3061\u6642\u9593\u306b\u5fdc\u3058\u3066\u30bf\u30b9\u30af\u3092\u512a\u5148\u9806\u4f4d\u4ed8\u3051\u3057\u307e\u3059\u3002STEP2 - \u6642\u9593\u306e\u30d7\u30ec\u30c3\u30b7\u30e3\u30fc\u3092\u611f\u3058\u305a\u306b\u30b9\u30ad\u30eb\u3092\u78e8\u304f\u305f\u3081\u306b\u7df4\u7fd2\u30e2\u30fc\u30c9\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002STEP3 - \u6ce8\u6587\u30ad\u30e5\u30fc\u3092\u6ce8\u610f\u6df1\u304f\u898b\u3066\u3001\u4eca\u5f8c\u306e\u30bf\u30b9\u30af\u3092\u4e88\u6e2c\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30c1\u30e7\u30b3\u30ec\u30fc\u30c8\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u306e\u713c\u304d\u4e0a\u304c\u308a\u3092\u5f85\u3064\u9593\u3001\u6b21\u306e\u6ce8\u6587\u306e\u30af\u30ea\u30fc\u30e0\u306e\u6e96\u5099\u3092\u59cb\u3081\u3089\u308c\u307e\u3059\u3002\u3053\u306e\u6226\u7565\u306f\u3001\u8907\u6570\u306e\u6ce8\u6587\u3092\u30b9\u30e0\u30fc\u30ba\u306b\u7ba1\u7406\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u30fc\u30ba\u30fb\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u30ea\u30a2\u3067\u30c1\u30c3\u30d7\u3092\u6700\u5927\u5316\u3059\u308b\u306e\u306b\u6700\u9069\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30fc\u30ba\u30fb\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u30ea\u30a2\u3067\u30c1\u30c3\u30d7\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u30b9\u30d4\u30fc\u30c9\u3001\u6b63\u78ba\u3055\u3001\u305d\u3057\u3066\u9867\u5ba2\u6e80\u8db3\u5ea6\u306e\u7d44\u307f\u5408\u308f\u305b\u304c\u5fc5\u8981\u3067\u3059\u3002STEP1 - \u5e38\u306b\u9867\u5ba2\u306e\u6ce8\u6587\u306e\u597d\u307f\u3092\u78ba\u8a8d\u3057\u3001\u305d\u308c\u306b\u5408\u308f\u305b\u3066\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3057\u307e\u3059\u3002STEP2 - \u9867\u5ba2\u3092\u6e80\u8db3\u3055\u305b\u308b\u305f\u3081\u306b\u6ce8\u6587\u3092\u8fc5\u901f\u306b\u63d0\u4f9b\u3057\u307e\u3059\u3002STEP3 - \u53ef\u80fd\u306a\u9650\u308a\u30d7\u30ec\u30df\u30a2\u30e0\u306a\u6750\u6599\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u30c1\u30c3\u30d7\u306e\u91d1\u984d\u3092\u5897\u3084\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u901a\u5e38\u306e\u30d0\u30cb\u30e9\u30a8\u30c3\u30bb\u30f3\u30b9\u306e\u4ee3\u308f\u308a\u306b\u8f38\u5165\u30d0\u30cb\u30e9\u30a8\u30c3\u30bb\u30f3\u30b9\u3092\u4f7f\u3046\u3068\u3001\u30c1\u30c3\u30d7\u304c10%\u30a2\u30c3\u30d7\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u9867\u5ba2\u3092\u6e80\u8db3\u3055\u305b\u308b\u3053\u3068\u304c\u3001\u9ad8\u984d\u306a\u30c1\u30c3\u30d7\u306b\u3064\u306a\u304c\u308b\u3053\u3068\u3092\u5fd8\u308c\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30b2\u30fc\u30e0\u306e\u8cea\u3092\u9ad8\u3081\u308b\u305f\u3081\u306b\u30d1\u30d1\u30fc\u30ba\u30fb\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u30ea\u30a2\u3067\u512a\u5148\u3059\u3079\u304d\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30fc\u30ba\u30fb\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u30ea\u30a2\u3067\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u512a\u5148\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u5927\u5e45\u306b\u6539\u5584\u3067\u304d\u307e\u3059\u3002STEP1 - \u307e\u305a\u30aa\u30fc\u30d6\u30f3\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u3001\u713c\u304d\u6642\u9593\u3092\u77ed\u7e2e\u3057\u307e\u3059\u3002STEP2 - \u30af\u30ea\u30fc\u30e0\u306e\u4f5c\u696d\u6642\u9593\u3092\u77ed\u7e2e\u3059\u308b\u305f\u3081\u306b\u3001\u3088\u308a\u826f\u3044\u30af\u30ea\u30fc\u30e0\u9053\u5177\u306b\u6295\u8cc7\u3057\u307e\u3059\u3002STEP3 - \u3088\u308a\u591a\u304f\u306e\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u89e3\u7981\u3057\u3001\u52b9\u7387\u3092\u6539\u5584\u3059\u308b\u305f\u3081\u306b\u3001\u30c8\u30c3\u30d4\u30f3\u30b0\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3055\u308c\u305f\u30aa\u30fc\u30d6\u30f3\u306f\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u309220%\u901f\u304f\u713c\u304d\u4e0a\u3052\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3057\u3088\u3046\u3068\u3059\u308b\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u4e0d\u53ef\u6b20\u3067\u3059\u3002"}, {"question": "\u30d1\u30d1\u30fc\u30ba\u30fb\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u30ea\u30a2\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u3069\u306e\u3088\u3046\u306a\u8981\u56e0\u304c\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30fc\u30ba\u30fb\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u30ea\u30a2\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6b63\u78ba\u3055\u3001\u30b9\u30d4\u30fc\u30c9\u3001\u305d\u3057\u3066\u9867\u5ba2\u6e80\u8db3\u5ea6\u306b\u5f71\u97ff\u3055\u308c\u307e\u3059\u3002STEP1 - \u9867\u5ba2\u306e\u6ce8\u6587\u8a73\u7d30\u3092\u6b63\u78ba\u306b\u5b88\u308b\u3053\u3068\u306f\u81f3\u4e0a\u7684\u306b\u91cd\u8981\u3067\u3059\u3002STEP2 - \u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u306e\u6e96\u5099\u3068\u63d0\u4f9b\u306b\u304b\u304b\u308b\u30b9\u30d4\u30fc\u30c9\u306f\u3001\u30b9\u30b3\u30a2\u306b\u30d7\u30e9\u30b9\u306e\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002STEP3 - \u9867\u5ba2\u306e\u6e80\u8db3\u5ea6\uff08\u5e78\u798f\u5ea6\uff09\u3082\u91cd\u8981\u306a\u5f79\u5272\u3092\u679c\u305f\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5b8c\u74a7\u306b\u7d44\u307f\u7acb\u3066\u3089\u308c\u305f\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u3092\u8fc5\u901f\u306b\u559c\u3093\u3067\u304f\u308c\u308b\u9867\u5ba2\u306b\u63d0\u4f9b\u3059\u308b\u3068\u3001\u9ad8\u5f97\u70b9\u3092\u5f97\u3089\u308c\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u8981\u56e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u826f\u3044\u7d50\u679c\u3092\u51fa\u3059\u305f\u3081\u306e\u6226\u7565\u3092\u7acb\u3066\u3089\u308c\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u30fc\u30ba\u30fb\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u30ea\u30a2\u306b\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u898b\u843d\u3068\u3057\u304c\u3061\u306a\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30fc\u30ba\u30fb\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u30ea\u30a2\u306b\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5411\u4e0a\u3055\u305b\u308b\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u3044\u304f\u3064\u304b\u3042\u308a\u307e\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306e1\u3064\u306f\u3001\u4f7f\u7528\u53ef\u80fd\u306a\u3059\u3079\u3066\u306e\u30c8\u30c3\u30d4\u30f3\u30b0\u3092\u4f7f\u7528\u3057\u3066\u7279\u5225\u306a\u300c\u8679\u8272\u306e\u559c\u3073\u300d\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u3092\u4f5c\u6210\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u3053\u306e\u30e6\u30cb\u30fc\u30af\u306a\u4f5c\u54c1\u306f\u9867\u5ba2\u3092\u611f\u9298\u3092\u4e0e\u3048\u308b\u3060\u3051\u3067\u306a\u304f\u3001\u7279\u5225\u306a\u5b9f\u7e3e\u3082\u89e3\u7981\u3057\u307e\u3059\u3002\u3082\u30461\u3064\u306e\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u306f\u3001\u30e1\u30cb\u30e5\u30fc\u30dc\u30bf\u30f3\u30925\u79d2\u9593\u62bc\u3057\u7d9a\u3051\u308b\u3053\u3068\u3067\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u79d8\u5bc6\u306e\u30e1\u30cb\u30e5\u30fc\u3067\u3001\u5e0c\u5c11\u3067\u30d7\u30ec\u30df\u30a2\u30e0\u306a\u6750\u6599\u3092\u63d0\u4f9b\u3057\u3066\u3044\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u96a0\u3055\u308c\u305f\u8981\u7d20\u3092\u63a2\u6c42\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u306b\u3055\u3089\u306b\u697d\u3057\u3055\u3068\u767a\u898b\u3092\u8ffd\u52a0\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30d1\u30d1\u30fc\u30ba\u30fb\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u30ea\u30a2\u3067\u8907\u6570\u306e\u6ce8\u6587\u3092\u51e6\u7406\u3059\u308b\u305f\u3081\u306b\u3001\u3069\u306e\u3088\u3046\u306b\u6642\u9593\u3092\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30fc\u30ba\u30fb\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u30ea\u30a2\u3067\u8907\u6570\u306e\u6ce8\u6587\u3092\u52b9\u679c\u7684\u306b\u51e6\u7406\u3059\u308b\u305f\u3081\u306b\u3001\u6642\u9593\u7ba1\u7406\u306f\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002STEP1 - \u4f5c\u696d\u5834\u3092\u6574\u7406\u3057\u3066\u3001\u30bf\u30b9\u30af\u9593\u306e\u79fb\u52d5\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u307e\u3059\u3002STEP2 - \u5404\u6ce8\u6587\u306e\u30bf\u30a4\u30de\u30fc\u3092\u4f7f\u3063\u3066\u3001\u6700\u521d\u306b\u3069\u306e\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u3092\u6e96\u5099\u3059\u308b\u304b\u3092\u512a\u5148\u3057\u307e\u3059\u3002STEP3 - \u8907\u6570\u306e\u751f\u5730\u3092\u540c\u6642\u306b\u6e96\u5099\u3057\u3001\u4ed6\u306e\u751f\u5730\u3092\u30af\u30ea\u30fc\u30e0\u3059\u308b\u306a\u3069\u3001\u30bf\u30b9\u30af\u3092\u5206\u62c5\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d0\u30cb\u30e9\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u3092\u713c\u304d\u306a\u304c\u3089\u3001\u30c1\u30e7\u30b3\u30ec\u30fc\u30c8\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u3092\u30af\u30ea\u30fc\u30e0\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u65b9\u6cd5\u3067\u3001\u6642\u9593\u3092\u7121\u99c4\u306b\u3059\u308b\u3053\u3068\u306a\u304f\u3001\u4e00\u5b9a\u306e\u6d41\u308c\u3067\u6ce8\u6587\u3092\u51e6\u7406\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u30fc\u30ba\u30fb\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u30ea\u30a2\u306e\u30e2\u30d0\u30a4\u30eb\u7248\u3068\u30c7\u30b9\u30af\u30c8\u30c3\u30d7\u7248\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30fc\u30ba\u30fb\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u30ea\u30a2\u306e\u30e2\u30d0\u30a4\u30eb\u7248\u3068\u30c7\u30b9\u30af\u30c8\u30c3\u30d7\u7248\u306e\u4e3b\u306a\u9055\u3044\u306b\u306f\u3001\u5236\u5fa1\u65b9\u6cd5\u3068\u753b\u9762\u306e\u6700\u9069\u5316\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u7248\u3067\u306f\u3001\u7d20\u65e9\u3044\u30bf\u30c3\u30d7\u3084\u30b9\u30ef\u30a4\u30d7\u306b\u9069\u3057\u305f\u30bf\u30c3\u30c1\u64cd\u4f5c\u304c\u4f7f\u7528\u3055\u308c\u307e\u3059\u3002\u30c7\u30b9\u30af\u30c8\u30c3\u30d7\u7248\u3067\u306f\u3001\u3088\u308a\u6b63\u78ba\u306a\u64cd\u4f5c\u304c\u53ef\u80fd\u306a\u30de\u30a6\u30b9\u30af\u30ea\u30c3\u30af\u304c\u4f7f\u7528\u3055\u308c\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30c7\u30b9\u30af\u30c8\u30c3\u30d7\u7248\u306f\u901a\u5e38\u3001\u3088\u308a\u9ad8\u3044\u753b\u9762\u89e3\u50cf\u5ea6\u3068\u3088\u308a\u8a73\u7d30\u306a\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u30b9\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30c7\u30b9\u30af\u30c8\u30c3\u30d7\u7248\u3067\u306f\u3001\u8996\u899a\u4f53\u9a13\u3092\u9ad8\u3081\u308b\u305f\u3081\u306b\u3088\u308a\u7cbe\u5de7\u306a\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u306e\u30c7\u30b6\u30a4\u30f3\u304c\u8868\u793a\u3055\u308c\u308b\u5834\u5408\u3082\u3042\u308a\u307e\u3059\u3002\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u81ea\u5206\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u3084\u30c7\u30d0\u30a4\u30b9\u306e\u6a5f\u80fd\u306b\u6700\u9069\u306a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u9078\u629e\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30d1\u30d1\u30fc\u30ba\u30fb\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u30ea\u30a2\u3067\u300c\u30de\u30b9\u30bf\u30fc\u30fb\u30d9\u30fc\u30ab\u30fc\u300d\u306e\u9054\u6210\u611f\u3092\u3069\u306e\u3088\u3046\u306b\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30fc\u30ba\u30fb\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u30ea\u30a2\u3067\u300c\u30de\u30b9\u30bf\u30fc\u30fb\u30d9\u30fc\u30ab\u30fc\u300d\u306e\u9054\u6210\u611f\u3092\u9054\u6210\u3059\u308b\u306b\u306f\u3001\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u306e\u6e96\u5099\u3068\u9867\u5ba2\u30b5\u30fc\u30d3\u30b9\u306e\u3059\u3079\u3066\u306e\u5074\u9762\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002STEP1 - \u6ce8\u6587\u306e\u8a73\u7d30\u3092\u6b63\u78ba\u306b\u9806\u5b88\u3059\u308b\u3053\u3068\u3067\u3001\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u306e\u7d44\u307f\u7acb\u3066\u3092\u5b8c\u74a7\u306b\u3057\u307e\u3057\u3087\u3046\u3002STEP2 - \u8907\u6570\u306e\u4f5c\u696d\u3092\u3053\u306a\u3059\u7df4\u7fd2\u3068\u52b9\u7387\u7684\u306a\u4f5c\u696d\u7ba1\u7406\u3067\u30b9\u30d4\u30fc\u30c9\u3092\u4e0a\u3052\u307e\u3059\u3002STEP3 - \u30d7\u30ec\u30df\u30a2\u30e0\u306a\u7d20\u6750\u3092\u4f7f\u3063\u3066\u6ce8\u6587\u3092\u8fc5\u901f\u306b\u63d0\u4f9b\u3059\u308b\u3053\u3068\u3067\u3001\u9867\u5ba2\u306e\u6e80\u8db3\u5ea6\u3092\u6700\u5927\u9650\u306b\u9ad8\u3081\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6b63\u78ba\u3055\u3001\u30b9\u30d4\u30fc\u30c9\u3001\u305d\u3057\u3066\u9867\u5ba2\u6e80\u8db3\u5ea6\u3092\u5e38\u306b\u9ad8\u304f\u4fdd\u3066\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u3053\u306e\u6a29\u5a01\u3042\u308b\u9054\u6210\u611f\u3092\u9054\u6210\u3067\u304d\u307e\u3059\u3002\u732e\u8eab\u3068\u7df4\u7fd2\u304c\u3001\u300c\u30de\u30b9\u30bf\u30fc\u30fb\u30d9\u30fc\u30ab\u30fc\u300d\u306b\u306a\u308b\u305f\u3081\u306e\u9375\u3067\u3059\u3002"}, {"question": "\u30d1\u30d1\u30fc\u30ba\u30fb\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u30ea\u30a2\u306e\u30b2\u30fc\u30e0\u5185\u901a\u8ca8\u3092\u52b9\u679c\u7684\u306b\u5229\u7528\u3059\u308b\u6700\u3082\u6709\u52b9\u306a\u65b9\u6cd5\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30fc\u30ba\u30fb\u30ab\u30c3\u30d7\u30b1\u30fc\u30ad\u30ea\u30a2\u3067\u30b2\u30fc\u30e0\u5185\u901a\u8ca8\u3092\u52b9\u679c\u7684\u306b\u5229\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002STEP1 - \u30aa\u30fc\u30d6\u30f3\u3084\u30af\u30ea\u30fc\u30e0\u9053\u5177\u306a\u3069\u306e\u5fc5\u9808\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u6295\u8cc7\u3057\u3066\u52b9\u7387\u3092\u9ad8\u3081\u307e\u3059\u3002STEP2 - \u30d7\u30ec\u30df\u30a2\u30e0\u306a\u7d20\u6750\u3092\u8cfc\u5165\u3057\u3066\u9867\u5ba2\u306e\u6e80\u8db3\u5ea6\u3068\u30c1\u30c3\u30d7\u3092\u5897\u3084\u3057\u307e\u3059\u3002STEP3 - \u7279\u5225\u306a\u30a4\u30d9\u30f3\u30c8\u3084\u671f\u9593\u9650\u5b9a\u306e\u30aa\u30d5\u30a1\u30fc\uff08\u7279\u5225\u306a\u7279\u5178\u3092\u63d0\u4f9b\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308b\u3082\u306e\uff09\u306e\u305f\u3081\u306b\u3001\u4e00\u90e8\u306e\u901a\u8ca8\u3092\u7bc0\u7d04\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d7\u30ec\u30df\u30a2\u30e0\u306a\u30c1\u30e7\u30b3\u30ec\u30fc\u30c8\u751f\u5730\u3092\u8cfc\u5165\u3059\u308b\u3068\u3001\u3088\u308a\u9ad8\u3044\u30c1\u30c3\u30d7\u3068\u3088\u308a\u826f\u3044\u9867\u5ba2\u30ec\u30d3\u30e5\u30fc\u306b\u3064\u306a\u304c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u6226\u7565\u7684\u306a\u652f\u51fa\u306f\u3001\u901a\u8ca8\u304c\u9577\u671f\u7684\u306a\u5229\u76ca\u3092\u6700\u5927\u9650\u306b\u6d3b\u7528\u3059\u308b\u305f\u3081\u306b\u4f7f\u7528\u3055\u308c\u308b\u3053\u3068\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002"}]
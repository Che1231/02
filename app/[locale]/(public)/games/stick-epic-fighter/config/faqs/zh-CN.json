[{"question": "\u5982\u4f55\u8fdb\u884c\u65b0\u624b\u7248\u300a\u68cd\u5b50\u53f2\u8bd7\u683c\u6597\u300b\u7684\u57fa\u672c\u8fde\u62db\uff1f", "answer": "\u8981\u5728\u300a\u68cd\u5b50\u53f2\u8bd7\u683c\u6597\u300b\u4e2d\u6267\u884c\u57fa\u672c\u8fde\u62db\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u6309\u4e0b\u653b\u51fb\u6309\u94ae\uff08\u9ed8\u8ba4\u662f'X'\uff09\u53d1\u8d77\u8f7b\u653b\u51fb\u3002\u6b65\u9aa42\uff1a\u7acb\u5373\u518d\u6b21\u6309\u4e0b\u653b\u51fb\u6309\u94ae\uff0c\u8854\u63a5\u7b2c\u4e8c\u6ce2\u653b\u51fb\u3002\u6b65\u9aa43\uff1a\u6700\u540e\uff0c\u6309\u4e0b\u91cd\u653b\u51fb\u6309\u94ae\uff08\u9ed8\u8ba4\u662f'Y'\uff09\u4ee5\u5f3a\u529b\u6253\u51fb\u7ed3\u675f\u8fde\u62db\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u5173\u5bf9\u654c\u4eba\u4f7f\u7528\u8be5\u8fde\u62db\u53ef\u4ee5\u8fc5\u901f\u8017\u5c3d\u4ed6\u4eec\u7684\u751f\u547d\u503c\u3002\u8bf7\u8bb0\u4f4f\u8981\u6b63\u786e\u5730\u6309\u52a8\u6309\u94ae\uff0c\u4ee5\u786e\u4fdd\u8fde\u62db\u6d41\u7545\u8fdb\u884c\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u5176\u60f3\u8c61\u6210\u4e00\u6bb5\u821e\u8e48\u52a8\u4f5c\u2014\u2014\u6bcf\u4e2a\u52a8\u4f5c\u81ea\u7136\u5730\u8fc7\u6e21\u5230\u4e0b\u4e00\u4e2a\u3002]"}, {"question": "\u5bf9\u4e8e\u9ad8\u7ea7\u73a9\u5bb6\u6765\u8bf4\uff0c\u5728\u300a\u68cd\u5b50\u53f2\u8bd7\u683c\u6597\u300b\u4e2d\u7ba1\u7406\u4f53\u529b\u4e3a\u4f55\u91cd\u8981\uff1f", "answer": "\u5728\u300a\u68cd\u5b50\u53f2\u8bd7\u683c\u6597\u300b\u4e2d\uff0c\u4f53\u529b\u7ba1\u7406\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u76f4\u63a5\u5f71\u54cd\u4f60\u7684\u95ea\u907f\u3001\u683c\u6321\u548c\u6267\u884c\u8fde\u62db\u7684\u80fd\u529b\u3002\u9ad8\u7ea7\u73a9\u5bb6\u901a\u5e38\u4f1a\u9047\u5230\u653b\u51fb\u901f\u5ea6\u6781\u9ad8\u7684\u654c\u4eba\uff0c\u4f53\u529b\u8017\u5c3d\u4f1a\u4f7f\u4f60\u53d8\u5f97\u975e\u5e38\u8106\u5f31\u3002\u4f8b\u5982\uff0c\u5728\u201c\u9634\u5f71\u7ade\u6280\u573a\u201d\u7684Boss\u6218\u4e2d\uff0c\u4fdd\u5b58\u4f53\u529b\u53ef\u4ee5\u8ba9\u4f60\u8eb2\u907fBoss\u6bc1\u706d\u6027\u7684\u8303\u56f4\u653b\u51fb\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u8f7b\u653b\u51fb\uff1a10\u70b9\u4f53\u529b\uff0c\u91cd\u653b\u51fb\uff1a20\u70b9\u4f53\u529b\uff0c\u95ea\u907f\uff1a15\u70b9\u4f53\u529b\u3002]"}, {"question": "\u5728\u300a\u68cd\u5b50\u53f2\u8bd7\u683c\u6597\u300b\u4e2d\u51fb\u8d25\u6700\u7ec8Boss\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300a\u68cd\u5b50\u53f2\u8bd7\u683c\u6597\u300b\u4e2d\u51fb\u8d25\u6700\u7ec8Boss\u9700\u8981\u7ed3\u5408\u65f6\u673a\u3001\u7b56\u7565\u548c\u8d44\u6e90\u7ba1\u7406\u3002\u6b65\u9aa41\uff1a\u5728\u7b2c\u4e00\u9636\u6bb5\u7814\u7a76Boss\u7684\u653b\u51fb\u6a21\u5f0f\uff0c\u627e\u5230\u53cd\u51fb\u7684\u5b89\u5168\u65f6\u673a\u3002\u6b65\u9aa42\uff1a\u5728\u8fd9\u4e9b\u65f6\u673a\u4f7f\u7528\u4f60\u6700\u5f3a\u7684\u8fde\u62db\uff0c\u4f46\u59cb\u7ec8\u6ce8\u610f\u4f60\u7684\u4f53\u529b\u3002\u6b65\u9aa43\uff1a\u5728\u6218\u6597\u524d\u88c5\u5907\u80fd\u591f\u63d0\u5347\u653b\u51fb\u529b\u548c\u751f\u547d\u56de\u590d\u7684\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u2018\u706b\u7130\u4e4b\u5251\u2019\u548c\u2018\u751f\u547d\u836f\u6c34\u2019\u53ef\u4ee5\u6539\u53d8\u6e38\u620f\u5c40\u9762\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u65b9\u6848A\uff1a\u4ee5\u9ad8\u4f24\u5bb3\u8f93\u51fa\u8fdb\u884c\u79ef\u6781\u653b\u51fb\uff1b\u65b9\u6848B\uff1a\u4e13\u6ce8\u4e8e\u4f53\u529b\u4fdd\u5b58\u7684\u9632\u5fa1\u6027\u7b56\u7565\u3002]"}, {"question": "\u5728\u300a\u68cd\u5b50\u53f2\u8bd7\u683c\u6597\u300b\u4e2d\uff0c\u4e3a\u4e86\u5e73\u8861\u7684\u6784\u5efa\uff0c\u6211\u5e94\u8be5\u4f18\u5148\u5347\u7ea7\u54ea\u4e9b\u6280\u80fd\uff1f", "answer": "\u5728\u300a\u68cd\u5b50\u53f2\u8bd7\u683c\u6597\u300b\u4e2d\uff0c\u4e3a\u4e86\u5e73\u8861\u7684\u6784\u5efa\uff0c\u4f18\u5148\u5347\u7ea7\u80fd\u591f\u589e\u5f3a\u653b\u51fb\u529b\u548c\u9632\u5fa1\u529b\u7684\u6280\u80fd\u3002\u2018\u5251\u672f\u7cbe\u901a\u2019\u6280\u80fd\u4f1a\u63d0\u5347\u4f60\u7684\u653b\u51fb\u4f24\u5bb3\uff0c\u800c\u2018\u9632\u5fa1\u59ff\u6001\u2019\u6280\u80fd\u4f1a\u964d\u4f4e\u53d7\u5230\u7684\u4f24\u5bb3\u3002\u6b64\u5916\uff0c\u2018\u4f53\u529b\u56de\u590d\u2019\u5bf9\u4e8e\u957f\u65f6\u95f4\u6218\u6597\u81f3\u5173\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5728\u6e38\u620f\u521d\u671f\u5c06\u2018\u5251\u672f\u7cbe\u901a\u2019\u5347\u7ea7\u52303\u7ea7\u53ef\u4ee5\u663e\u8457\u63d0\u5347\u4f60\u7684\u6218\u6597\u80fd\u529b\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u6280\u80fd\u6811\u2192\u653b\u51fb\u2192\u5251\u672f\u7cbe\u901a\u2192\u5347\u7ea7\u2192\u4f24\u5bb3\u589e\u52a0\u3002]"}, {"question": "\u300a\u68cd\u5b50\u53f2\u8bd7\u683c\u6597\u300b\u4e2d\u7684\u6b66\u5668\u5347\u7ea7\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u300a\u68cd\u5b50\u53f2\u8bd7\u683c\u6597\u300b\u4e2d\u7684\u6b66\u5668\u5347\u7ea7\u7cfb\u7edf\u5141\u8bb8\u4f60\u4f7f\u7528\u4ece\u51fb\u8d25\u7684\u654c\u4eba\u548c\u5b9d\u7bb1\u4e2d\u6536\u96c6\u5230\u7684\u6750\u6599\u6765\u5f3a\u5316\u4f60\u7684\u6b66\u5668\u3002\u8981\u5347\u7ea7\uff0c\u8bf7\u524d\u5f80\u4e3b\u67a2\u7ebd\u4e2d\u7684\u94c1\u5320\u94fa\uff0c\u9009\u62e9\u4f60\u60f3\u8981\u5f3a\u5316\u6b66\u5668\u3002\u6bcf\u6b21\u5347\u7ea7\u90fd\u4f1a\u63d0\u9ad8\u6b66\u5668\u7684\u57fa\u7840\u5c5e\u6027\uff0c\u4f8b\u5982\u653b\u51fb\u529b\u548c\u66b4\u51fb\u7387\u3002\u4f8b\u5982\uff0c\u5c06\u2018\u94c1\u5251\u2019\u5347\u7ea7\u52302\u7ea7\u4f1a\u5c06\u5176\u653b\u51fb\u529b\u63d0\u9ad815%\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u94c1\u52511\u7ea7\uff1a50\u653b\u51fb\u529b\uff0c2\u7ea7\uff1a65\u653b\u51fb\u529b\uff0c3\u7ea7\uff1a80\u653b\u51fb\u529b\u3002]"}, {"question": "\u300a\u68cd\u5b50\u53f2\u8bd7\u683c\u6597\u300b\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u300a\u68cd\u5b50\u53f2\u8bd7\u683c\u6597\u300b\u4e2d\u7684\u5355\u4eba\u6a21\u5f0f\u4fa7\u91cd\u4e8e\u5177\u6709\u9010\u6b65\u63d0\u5347\u6311\u6218\u96be\u5ea6\u7684\u7ebf\u6027\u5267\u60c5\uff0c\u800c\u591a\u4eba\u6a21\u5f0f\u5219\u63d0\u4f9b\u5408\u4f5c\u548c\u7ade\u4e89\u6027\u73a9\u6cd5\u3002\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f60\u53ef\u4ee5\u4e0e\u670b\u53cb\u8054\u624b\u6311\u6218\u56f0\u96be\u7684\u526f\u672c\u6216\u8fdb\u884cPVP\u5bf9\u6218\u3002\u4f8b\u5982\uff0c\u201c\u5408\u4f5c\u526f\u672c\u201d\u6a21\u5f0f\u9700\u8981\u56e2\u961f\u5408\u4f5c\u6765\u51fb\u8d25\u5f3a\u5927\u7684Boss\uff0c\u800c\u201c\u7ade\u6280\u573a\u6218\u6597\u201d\u5219\u8ba9\u73a9\u5bb6\u76f8\u4e92\u7ade\u4e89\uff0c\u68c0\u9a8c\u6280\u672f\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u5355\u4eba\u6a21\u5f0f\uff1a\u6545\u4e8b\u9a71\u52a8\uff0c\u591a\u4eba\u6a21\u5f0f\uff1a\u57fa\u4e8e\u56e2\u961f\u6216\u7ade\u4e89\u3002]"}, {"question": "\u5982\u4f55\u5728\u300a\u68cd\u5b50\u53f2\u8bd7\u683c\u6597\u300b\u4e2d\u5c06\u6211\u7684PC\u5b58\u6863\u6570\u636e\u8f6c\u79fb\u5230\u79fb\u52a8\u8bbe\u5907\u4e0a\uff1f", "answer": "\u8981\u5c06\u300a\u68cd\u5b50\u53f2\u8bd7\u683c\u6597\u300b\u4e2d\u7684PC\u5b58\u6863\u6570\u636e\u8f6c\u79fb\u5230\u79fb\u52a8\u8bbe\u5907\u4e0a\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u786e\u4fdd\u4f60\u5728\u4e24\u4e2a\u5e73\u53f0\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u8d26\u6237\u3002\u6b65\u9aa42\uff1a\u5728PC\u7248\u672c\u4e2d\uff0c\u5bfc\u822a\u5230\u201c\u5b58\u6863\u6570\u636e\u201d\u83dc\u5355\u5e76\u9009\u62e9\u201c\u4e0a\u4f20\u5230\u4e91\u201d\u3002\u6b65\u9aa43\uff1a\u5728\u79fb\u52a8\u7248\u672c\u4e2d\uff0c\u8f6c\u5230\u76f8\u540c\u7684\u83dc\u5355\u5e76\u9009\u62e9\u201c\u4ece\u4e91\u4e0b\u8f7d\u201d\u3002\u4f8b\u5982\uff0c\u6b64\u65b9\u6cd5\u5141\u8bb8\u4f60\u5728\u5207\u6362\u8bbe\u5907\u65f6\u65e0\u7f1d\u7ee7\u7eed\u4f60\u7684\u8fdb\u5ea6\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u5176\u60f3\u8c61\u6210\u5c06\u4f60\u7684\u884c\u674e\u4ece\u4e00\u680b\u623f\u5b50\u642c\u5230\u53e6\u4e00\u680b\u623f\u5b50\u2014\u2014\u53ea\u9700\u4e0a\u4f20\u548c\u4e0b\u8f7d\u5373\u53ef\u3002]"}, {"question": "\u5728\u300a\u68cd\u5b50\u53f2\u8bd7\u683c\u6597\u300b\u4e2d\uff0c\u6211\u80fd\u627e\u5230\u54ea\u4e9b\u9690\u85cf\u7684\u5f69\u86cb\uff1f", "answer": "\u300a\u68cd\u5b50\u53f2\u8bd7\u683c\u6597\u300b\u4e2d\u5145\u6ee1\u4e86\u9690\u85cf\u7684\u5f69\u86cb\uff0c\u5956\u52b1\u63a2\u7d22\u3002\u503c\u5f97\u6ce8\u610f\u7684\u4e00\u4e2a\u5f69\u86cb\u662f\u201c\u9634\u5f71\u68ee\u6797\u201d\u5173\u5361\u4e2d\u7684\u201c\u79d8\u5bc6\u623f\u95f4\u201d\u3002\u8981\u627e\u5230\u5b83\uff0c\u8bf7\u5bfb\u627e\u6811\u540e\u9690\u85cf\u7684\u5f00\u5173\uff0c\u5b83\u4f1a\u6253\u5f00\u901a\u5f80\u5305\u542b\u7a00\u6709\u6218\u5229\u54c1\u7684\u623f\u95f4\u7684\u95e8\u3002\u53e6\u4e00\u4e2a\u5f69\u86cb\u662f\u201c\u57ce\u5821\u5e9f\u589f\u201d\u5173\u5361\u4e2d\u7684\u201c\u5f00\u53d1\u8005\u6ce8\u91ca\u201d\uff0c\u5b83\u63d0\u4f9b\u4e86\u5173\u4e8e\u6e38\u620f\u521b\u4f5c\u7684\u89c1\u89e3\u3002[\u5f69\u86cb\u6316\u6398\uff1a\u79d8\u5bc6\u623f\u95f4\u2192\u9690\u85cf\u5f00\u5173\u2192\u7a00\u6709\u6218\u5229\u54c1\uff0c\u5f00\u53d1\u8005\u6ce8\u91ca\u2192\u6e38\u620f\u5f00\u53d1\u89c1\u89e3\u3002]"}, {"question": "\u5982\u4f55\u5728\u300a\u68cd\u5b50\u53f2\u8bd7\u683c\u6597\u300b\u7684PVP\u4e2d\u4f18\u5316\u89d2\u8272\u5c5e\u6027\uff1f", "answer": "\u5728\u300a\u68cd\u5b50\u53f2\u8bd7\u683c\u6597\u300b\u7684PVP\u4e2d\u4f18\u5316\u89d2\u8272\u5c5e\u6027\u6d89\u53ca\u4e13\u6ce8\u4e8e\u654f\u6377\u6027\u548c\u66b4\u51fb\u51e0\u7387\u3002\u654f\u6377\u6027\u4f1a\u63d0\u9ad8\u4f60\u7684\u79fb\u52a8\u901f\u5ea6\u548c\u95ea\u907f\u6548\u7387\uff0c\u800c\u66b4\u51fb\u51e0\u7387\u4f1a\u63d0\u5347\u4f60\u7684\u4f24\u5bb3\u8f93\u51fa\u3002\u88c5\u5907\u80fd\u591f\u63d0\u5347\u8fd9\u4e9b\u5c5e\u6027\u7684\u88c5\u5907\uff0c\u4f8b\u5982\u2018\u8fc5\u6377\u9774\u2019\u548c\u2018\u66b4\u51fb\u624b\u5957\u2019\u3002\u4f8b\u5982\uff0c\u9ad8\u654f\u6377\u6027\u6784\u5efa\u4f7f\u4f60\u5728\u201c\u7ade\u6280\u573a\u6218\u6597\u201d\u6a21\u5f0f\u4e2d\u80fd\u591f\u66f4\u7075\u6d3b\u5730\u5e94\u5bf9\u5bf9\u624b\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u8fc5\u6377\u9774\uff1a+10\u654f\u6377\uff0c\u66b4\u51fb\u624b\u5957\uff1a+15%\u66b4\u51fb\u51e0\u7387\u3002]"}, {"question": "\u5728\u300a\u68cd\u5b50\u53f2\u8bd7\u683c\u6597\u300b\u4e2d\uff0c\u6700\u6709\u6548\u7684\u63a7\u5236\u4eba\u7fa4\u6280\u672f\u6709\u54ea\u4e9b\uff1f", "answer": "\u300a\u68cd\u5b50\u53f2\u8bd7\u683c\u6597\u300b\u4e2d\u6709\u6548\u7684\u63a7\u5236\u4eba\u7fa4\u6280\u672f\u5305\u62ec\u4f7f\u7528\u8303\u56f4\u653b\u51fb\uff08AoE\uff09\u548c\u7729\u6655\u80fd\u529b\u3002\u2018\u65cb\u98ce\u65a9\u2019\u6280\u80fd\u5c24\u5176\u9002\u7528\u4e8e\u4e00\u6b21\u6027\u5bf9\u591a\u4e2a\u654c\u4eba\u9020\u6210\u4f24\u5bb3\uff0c\u800c\u2018\u7729\u6655\u6253\u51fb\u2019\u80fd\u529b\u53ef\u4ee5\u6682\u65f6\u4f7f\u4e00\u7fa4\u654c\u4eba\u5931\u53bb\u884c\u52a8\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u5728\u2018\u9634\u5f71\u7fa4\u2019\u5173\u5361\u4e2d\u4f7f\u7528\u2018\u65cb\u98ce\u65a9\u2019\u53ef\u4ee5\u8fc5\u901f\u6e05\u7406\u6218\u573a\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u65cb\u98ce\u65a9\uff1aAoE\u4f24\u5bb3\uff0c\u7729\u6655\u6253\u51fb\uff1a\u6682\u65f6\u6027\u4f7f\u654c\u4eba\u5931\u53bb\u884c\u52a8\u80fd\u529b\u3002]"}]
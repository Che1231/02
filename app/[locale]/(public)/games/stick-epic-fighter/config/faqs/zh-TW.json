[{"question": "\u5982\u4f55\u57f7\u884c\u300a\u68cd\u5b50\u53f2\u8a69\u683c\u9b25\u300b\u521d\u5b78\u8005\u7684\u57fa\u672c\u9023\u64ca\uff1f", "answer": "\u8981\u57f7\u884c\u300a\u68cd\u5b50\u53f2\u8a69\u683c\u9b25\u300b\u7684\u57fa\u672c\u9023\u64ca\uff0c\u8acb\u6309\u7167\u4e0b\u5217\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u6309\u4e0b\u653b\u64ca\u6309\u9215\uff08\u9810\u8a2d\u70ba\u300eX\u300f\uff09\u958b\u59cb\u8f15\u653b\u64ca\u3002\u6b65\u9a5f2\uff1a\u7acb\u5373\u518d\u6b21\u6309\u4e0b\u653b\u64ca\u6309\u9215\uff0c\u9023\u7e8c\u9032\u884c\u7b2c\u4e8c\u6b21\u653b\u64ca\u3002\u6b65\u9a5f3\uff1a\u6700\u5f8c\uff0c\u6309\u4e0b\u91cd\u653b\u64ca\u6309\u9215\uff08\u9810\u8a2d\u70ba\u300eY\u300f\uff09\u4ee5\u5f37\u529b\u653b\u64ca\u7d50\u675f\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u7d1a\u5225\u5c0d\u6575\u4eba\u4f7f\u7528\u6b64\u9023\u64ca\u53ef\u4ee5\u5feb\u901f\u8017\u76e1\u4ed6\u5011\u7684\u751f\u547d\u503c\u3002\u8acb\u8a18\u5f97\u6b63\u78ba\u8a08\u6642\u6309\u9375\uff0c\u4ee5\u78ba\u4fdd\u9023\u64ca\u9806\u66a2\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4e00\u4e0b\uff0c\u9019\u5c31\u50cf\u4e00\u5957\u821e\u8e48\u52d5\u4f5c\u2014\u2014\u6bcf\u500b\u52d5\u4f5c\u90fd\u6703\u81ea\u7136\u5730\u904e\u6e21\u5230\u4e0b\u4e00\u500b\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u5728\u300a\u68cd\u5b50\u53f2\u8a69\u683c\u9b25\u300b\u4e2d\uff0c\u9032\u968e\u73a9\u5bb6\u9700\u8981\u7ba1\u7406\u9ad4\u529b\uff1f", "answer": "\u5728\u300a\u68cd\u5b50\u53f2\u8a69\u683c\u9b25\u300b\u4e2d\uff0c\u9ad4\u529b\u7ba1\u7406\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6703\u76f4\u63a5\u5f71\u97ff\u60a8\u57f7\u884c\u9583\u907f\u3001\u683c\u64cb\u548c\u57f7\u884c\u9023\u64ca\u7684\u80fd\u529b\u3002\u9032\u968e\u73a9\u5bb6\u7d93\u5e38\u9762\u5c0d\u653b\u64ca\u901f\u5ea6\u5feb\u7684\u6575\u4eba\uff0c\u9ad4\u529b\u8017\u76e1\u6703\u4f7f\u60a8\u8b8a\u5f97\u8106\u5f31\u3002\u4f8b\u5982\uff0c\u5728\u300e\u9670\u5f71\u7af6\u6280\u5834\u300f\u7684\u6700\u7d42BOSS\u6230\u4e2d\uff0c\u4fdd\u7559\u9ad4\u529b\u53ef\u4ee5\u8b93\u60a8\u9583\u907fBOSS\u7684\u6bc0\u6ec5\u6027\u7bc4\u570d\u653b\u64ca\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u8f15\u653b\u64ca\uff1a10\u9ede\u9ad4\u529b\uff0c\u91cd\u653b\u64ca\uff1a20\u9ede\u9ad4\u529b\uff0c\u9583\u907f\uff1a15\u9ede\u9ad4\u529b\u3002]"}, {"question": "\u5728\u300a\u68cd\u5b50\u53f2\u8a69\u683c\u9b25\u300b\u4e2d\u6253\u6557\u6700\u7d42BOSS\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u300a\u68cd\u5b50\u53f2\u8a69\u683c\u9b25\u300b\u4e2d\u6253\u6557\u6700\u7d42BOSS\u9700\u8981\u7d50\u5408\u8a08\u6642\u3001\u7b56\u7565\u548c\u8cc7\u6e90\u7ba1\u7406\u3002\u6b65\u9a5f1\uff1a\u5728\u7b2c\u4e00\u968e\u6bb5\u7814\u7a76BOSS\u7684\u653b\u64ca\u6a21\u5f0f\uff0c\u4ee5\u8b58\u5225\u9032\u884c\u53cd\u64ca\u7684\u5b89\u5168\u6642\u6a5f\u3002\u6b65\u9a5f2\uff1a\u5728\u9019\u4e9b\u6642\u9593\u7a97\u4f7f\u7528\u60a8\u6700\u5f37\u5927\u7684\u9023\u64ca\uff0c\u4f46\u59cb\u7d42\u6ce8\u610f\u60a8\u7684\u9ad4\u529b\u3002\u6b65\u9a5f3\uff1a\u5728\u6230\u9b25\u524d\u88dd\u5099\u63d0\u5347\u653b\u64ca\u529b\u53ca\u751f\u547d\u6062\u5fa9\u7684\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u300e\u706b\u7130\u528d\u300f\u548c\u300e\u751f\u547d\u85e5\u6c34\u300f\u53ef\u4ee5\u6539\u8b8a\u904a\u6232\u52dd\u8ca0\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u65b9\u6848A\uff1a\u7a4d\u6975\u9032\u653b\uff0c\u9020\u6210\u9ad8\u50b7\u5bb3\uff1b\u65b9\u6848B\uff1a\u9632\u5b88\u7b56\u7565\uff0c\u6ce8\u91cd\u9ad4\u529b\u4fdd\u5b58\u3002]"}, {"question": "\u5728\u300a\u68cd\u5b50\u53f2\u8a69\u683c\u9b25\u300b\u4e2d\uff0c\u70ba\u4e86\u5e73\u8861\u7684\u88dd\u5099\uff0c\u6211\u61c9\u8a72\u512a\u5148\u5347\u7d1a\u54ea\u4e9b\u6280\u80fd\uff1f", "answer": "\u5728\u300a\u68cd\u5b50\u53f2\u8a69\u683c\u9b25\u300b\u4e2d\uff0c\u70ba\u4e86\u5e73\u8861\u7684\u88dd\u5099\uff0c\u8acb\u512a\u5148\u5347\u7d1a\u80fd\u589e\u5f37\u653b\u64ca\u548c\u9632\u79a6\u7684\u6280\u80fd\u3002\u300e\u528d\u8853\u300f\u6280\u80fd\u6703\u589e\u52a0\u60a8\u7684\u653b\u64ca\u50b7\u5bb3\uff0c\u800c\u300e\u9632\u5b88\u59ff\u614b\u300f\u6703\u964d\u4f4e\u6575\u4eba\u9020\u6210\u7684\u50b7\u5bb3\u3002\u6b64\u5916\uff0c\u300e\u9ad4\u529b\u518d\u751f\u300f\u5c0d\u65bc\u9577\u6642\u9593\u6230\u9b25\u81f3\u95dc\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5728\u904a\u6232\u65e9\u671f\u5c07\u300e\u528d\u8853\u300f\u63d0\u5347\u5230\u4e09\u7d1a\uff0c\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u60a8\u7684\u6230\u9b25\u6548\u7387\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u6280\u80fd\u6a39 \u2192 \u653b\u64ca \u2192 \u528d\u8853 \u2192 \u5347\u7d1a \u2192 \u50b7\u5bb3\u589e\u52a0\u3002]"}, {"question": "\u300a\u68cd\u5b50\u53f2\u8a69\u683c\u9b25\u300b\u4e2d\u7684\u6b66\u5668\u5347\u7d1a\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff1f", "answer": "\u300a\u68cd\u5b50\u53f2\u8a69\u683c\u9b25\u300b\u4e2d\u7684\u6b66\u5668\u5347\u7d1a\u7cfb\u7d71\u5141\u8a31\u60a8\u4f7f\u7528\u5f9e\u88ab\u64ca\u6557\u7684\u6575\u4eba\u548c\u5bf6\u7bb1\u4e2d\u6536\u96c6\u7684\u6750\u6599\u4f86\u5f37\u5316\u60a8\u7684\u6b66\u5668\u3002\u8981\u5347\u7d1a\uff0c\u8acb\u524d\u5f80\u4e3b\u6a1e\u7d10\u7684\u9ed1\u9435\u5320\uff0c\u4e26\u9078\u64c7\u60a8\u60f3\u8981\u5f37\u5316\u7684\u90a3\u7a2e\u6b66\u5668\u3002\u6bcf\u6b21\u5347\u7d1a\u90fd\u6703\u63d0\u5347\u6b66\u5668\u7684\u57fa\u672c\u5c6c\u6027\uff0c\u4f8b\u5982\u653b\u64ca\u529b\u53ca\u66b4\u64ca\u7387\u3002\u4f8b\u5982\uff0c\u5c07\u300e\u9435\u528d\u300f\u5347\u7d1a\u5230\u4e8c\u7d1a\u6703\u5c07\u5176\u653b\u64ca\u529b\u63d0\u5347 15%\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u9435\u528d\u4e00\u7d1a\uff1a50\u653b\u64ca\u529b\uff0c\u4e8c\u7d1a\uff1a65\u653b\u64ca\u529b\uff0c\u4e09\u7d1a\uff1a80\u653b\u64ca\u529b\u3002]"}, {"question": "\u5728\u300a\u68cd\u5b50\u53f2\u8a69\u683c\u9b25\u300b\u4e2d\uff0c\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u4e4b\u9593\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u5225\uff1f", "answer": "\u300a\u68cd\u5b50\u53f2\u8a69\u683c\u9b25\u300b\u4e2d\u7684\u55ae\u4eba\u6a21\u5f0f\u5074\u91cd\u65bc\u5177\u6709\u9010\u6f38\u5177\u6709\u6311\u6230\u6027\u7684\u5c64\u7d1a\u7684\u7dda\u6027\u6545\u4e8b\uff0c\u800c\u591a\u4eba\u6a21\u5f0f\u5247\u63d0\u4f9b\u5408\u4f5c\u548c\u7af6\u722d\u6027\u904a\u6232\u3002\u5728\u591a\u4eba\u6a21\u5f0f\u4e0b\uff0c\u60a8\u53ef\u4ee5\u8207\u670b\u53cb\u7d44\u968a\u4f86\u61c9\u5c0d\u96e3\u95dc\u6216\u9032\u884c PvP \u5c0d\u6230\u3002\u4f8b\u5982\uff0c\u300e\u5408\u4f5c\u5730\u4e0b\u57ce\u300f\u6a21\u5f0f\u9700\u8981\u5718\u968a\u5408\u4f5c\u4f86\u6253\u6557\u5f3a\u5927\u7684BOSS\uff0c\u800c\u300e\u7af6\u6280\u5834\u6230\u9b25\u300f\u5247\u8b93\u73a9\u5bb6\u4e92\u76f8\u8f03\u91cf\u7af6\u6280\u3002 [\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u55ae\u4eba\u6a21\u5f0f\uff1a\u4ee5\u5287\u60c5\u70ba\u5c0e\u5411\uff0c\u591a\u4eba\u6a21\u5f0f\uff1a\u57fa\u65bc\u5718\u968a\u6216\u7af6\u722d\u3002]"}, {"question": "\u5982\u4f55\u5728\u300a\u68cd\u5b50\u53f2\u8a69\u683c\u9b25\u300b\u4e2d\u5c07\u6211\u7684\u96fb\u8166\u5132\u5b58\u8cc7\u6599\u8f49\u79fb\u5230\u624b\u6a5f\uff1f", "answer": "\u8981\u5728\u300a\u68cd\u5b50\u53f2\u8a69\u683c\u9b25\u300b\u4e2d\u5c07\u60a8\u7684\u96fb\u8166\u5132\u5b58\u8cc7\u6599\u8f49\u79fb\u5230\u624b\u6a5f\uff0c\u8acb\u6309\u7167\u4e0b\u5217\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u78ba\u4fdd\u60a8\u5728\u5169\u500b\u5e73\u53f0\u4e0a\u90fd\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u3002\u6b65\u9a5f2\uff1a\u5728\u96fb\u8166\u7248\u672c\u4e2d\uff0c\u5c0e\u822a\u81f3\u300e\u5132\u5b58\u8cc7\u6599\u300f\u9078\u55ae\uff0c\u4e26\u9078\u64c7\u300e\u4e0a\u50b3\u81f3\u96f2\u7aef\u300f\u3002\u6b65\u9a5f3\uff1a\u5728\u624b\u6a5f\u7248\u672c\u4e2d\uff0c\u524d\u5f80\u540c\u4e00\u9078\u55ae\uff0c\u4e26\u9078\u64c7\u300e\u5f9e\u96f2\u7aef\u4e0b\u8f09\u300f\u3002\u4f8b\u5982\uff0c\u6b64\u65b9\u6cd5\u8b93\u60a8\u5728\u66f4\u63db\u88dd\u7f6e\u6642\u53ef\u4ee5\u9806\u5229\u7e7c\u7e8c\u60a8\u7684\u9032\u5ea6\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4e00\u4e0b\uff0c\u5c07\u60a8\u7684\u7269\u54c1\u5f9e\u4e00\u68df\u623f\u5b50\u642c\u5230\u53e6\u4e00\u68df\u623f\u5b50\u2014\u2014\u53ea\u9700\u4e0a\u50b3\u548c\u4e0b\u8f09\u5373\u53ef\u3002]"}, {"question": "\u5728\u300a\u68cd\u5b50\u53f2\u8a69\u683c\u9b25\u300b\u4e2d\uff0c\u6211\u80fd\u627e\u5230\u54ea\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\uff1f", "answer": "\u300a\u68cd\u5b50\u53f2\u8a69\u683c\u9b25\u300b\u5145\u6eff\u4e86\u96b1\u85cf\u7684\u5f69\u86cb\uff0c\u734e\u52f5\u63a2\u7d22\u3002\u503c\u5f97\u6ce8\u610f\u7684\u4e00\u500b\u662f\u300e\u9670\u5f71\u68ee\u6797\u300f\u5c64\u7d1a\u4e2d\u7684\u300e\u79d8\u5bc6\u623f\u9593\u300f\u3002\u8981\u627e\u5230\u5b83\uff0c\u8acb\u5c0b\u627e\u6a39\u5f8c\u9762\u7684\u96b1\u85cf\u958b\u95dc\uff0c\u5b83\u6703\u6253\u958b\u901a\u5f80\u5305\u542b\u7a00\u6709\u6230\u5229\u54c1\u623f\u9593\u7684\u9580\u3002\u53e6\u4e00\u500b\u5f69\u86cb\u662f\u300e\u958b\u767c\u4eba\u54e1\u5099\u8a3b\u300f\uff0c\u4f4d\u65bc\u300e\u57ce\u5821\u5ee2\u589f\u300f\u5c64\u7d1a\u4e2d\uff0c\u5b83\u63d0\u4f9b\u4e86\u6709\u95dc\u904a\u6232\u958b\u767c\u7684\u898b\u89e3\u3002[\u5f69\u86cb\u6316\u6398: \u79d8\u5bc6\u623f\u9593 \u2192 \u96b1\u85cf\u958b\u95dc \u2192 \u7a00\u6709\u6230\u5229\u54c1\uff0c\u958b\u767c\u4eba\u54e1\u5099\u8a3b \u2192 \u904a\u6232\u958b\u767c\u898b\u89e3\u3002]"}, {"question": "\u5982\u4f55\u5728\u300a\u68cd\u5b50\u53f2\u8a69\u683c\u9b25\u300b\u4e2d\u512a\u5316\u6211\u7684\u89d2\u8272\u5c6c\u6027\u4ee5\u9032\u884c PvP\uff1f", "answer": "\u5728\u300a\u68cd\u5b50\u53f2\u8a69\u683c\u9b25\u300b\u4e2d\u512a\u5316\u60a8\u7684\u89d2\u8272\u5c6c\u6027\u4ee5\u9032\u884c PvP\uff0c\u9700\u8981\u96c6\u4e2d\u65bc\u654f\u6377\u6027\u548c\u66b4\u64ca\u7387\u3002\u654f\u6377\u6027\u6703\u63d0\u9ad8\u60a8\u7684\u79fb\u52d5\u901f\u5ea6\u548c\u9583\u907f\u6548\u679c\uff0c\u800c\u66b4\u64ca\u7387\u6703\u63d0\u9ad8\u60a8\u7684\u50b7\u5bb3\u8f38\u51fa\u3002\u7a7f\u6234\u80fd\u589e\u5f37\u9019\u4e9b\u5c6c\u6027\u7684\u88dd\u5099\uff0c\u4f8b\u5982\u300e\u5feb\u901f\u9774\u5b50\u300f\u548c\u300e\u66b4\u64ca\u624b\u5957\u300f\u3002\u4f8b\u5982\uff0c\u9ad8\u654f\u6377\u6027\u88dd\u5099\u8b93\u60a8\u53ef\u4ee5\u5728\u300e\u7af6\u6280\u5834\u6230\u9b25\u300f\u6a21\u5f0f\u4e2d\u8d85\u8d8a\u5c0d\u624b\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u5feb\u901f\u9774\u5b50\uff1a+10\u654f\u6377\u6027\uff0c\u66b4\u64ca\u624b\u5957\uff1a+15% \u66b4\u64ca\u7387\u3002]"}, {"question": "\u5728\u300a\u68cd\u5b50\u53f2\u8a69\u683c\u9b25\u300b\u4e2d\uff0c\u6700\u6709\u6548\u7684\u7fa4\u9ad4\u63a7\u5236\u6280\u5de7\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u300a\u68cd\u5b50\u53f2\u8a69\u683c\u9b25\u300b\u4e2d\uff0c\u6709\u6548\u7684\u7fa4\u9ad4\u63a7\u5236\u6280\u5de7\u5305\u62ec\u4f7f\u7528\u7bc4\u570d\u653b\u64ca\uff08AoE\uff09\u548c\u6688\u7729\u80fd\u529b\u3002\u300e\u65cb\u98a8\u65ac\u300f\u6280\u80fd\u5c24\u5176\u9069\u7528\u65bc\u4e00\u6b21\u5c0d\u591a\u500b\u6575\u4eba\u9020\u6210\u50b7\u5bb3\uff0c\u800c\u300e\u6688\u7729\u653b\u64ca\u300f\u80fd\u529b\u5247\u53ef\u4ee5\u66ab\u6642\u4f7f\u4e00\u7fa4\u6575\u4eba\u5931\u53bb\u884c\u52d5\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u5728\u300e\u9670\u5f71\u7fa4\u300f\u5c64\u7d1a\u4f7f\u7528\u300e\u65cb\u98a8\u65ac\u300f\u53ef\u4ee5\u5feb\u901f\u6e05\u7406\u6230\u5834\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u65cb\u98a8\u65ac\uff1a\u7bc4\u570d\u50b7\u5bb3\uff0c\u6688\u7729\u653b\u64ca\uff1a\u66ab\u6642\u4f7f\u5176\u5931\u53bb\u884c\u52d5\u80fd\u529b\u3002]"}]
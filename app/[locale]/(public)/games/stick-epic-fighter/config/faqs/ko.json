[{"question": "\ucd08\ubcf4\uc790\ub97c \uc704\ud55c \uc2a4\ud2f1 \ucc54\ud53c\uc5b8 \uaca9\ud22c\uae30\uc758 \uae30\ubcf8 \ucf64\ubcf4\ub294 \uc5b4\ub5bb\uac8c \uc218\ud589\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc2a4\ud2f1 \ucc54\ud53c\uc5b8 \uaca9\ud22c\uae30\uc5d0\uc11c \uae30\ubcf8 \ucf64\ubcf4\ub97c \uc2e4\ud589\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1: \uacf5\uaca9 \ubc84\ud2bc(\uae30\ubcf8\uac12\uc740 'X')\uc744 \ub20c\ub7ec \u8efd \uacf5\uaca9\uc744 \uc2dc\uc791\ud569\ub2c8\ub2e4. STEP2: \uc989\uc2dc \uacf5\uaca9 \ubc84\ud2bc\uc744 \ub2e4\uc2dc \ub20c\ub7ec \ub450 \ubc88\uc9f8 \uacf5\uaca9\uc73c\ub85c \uc774\uc5b4\ubd99\uc785\ub2c8\ub2e4. STEP3: \ub9c8\uc9c0\ub9c9\uc73c\ub85c \uac15\ub825\ud55c \ud0c0\uaca9\uc73c\ub85c \ub9c8\ubb34\ub9ac\ud558\uae30 \uc704\ud574 \uac15\uacf5\uaca9 \ubc84\ud2bc(\uae30\ubcf8\uac12\uc740 'Y')\uc744 \ub204\ub985\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub808\ubca8\uc758 \uc801\uc5d0\uac8c \uc774 \ucf64\ubcf4\ub97c \uc0ac\uc6a9\ud558\uba74 \uc801\uc758 \uccb4\ub825\uc744 \ube60\ub974\uac8c \uc18c\uc9c4\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ucf64\ubcf4\uac00 \uc6d0\ud65c\ud558\uac8c \uc774\uc5b4\uc9c0\ub3c4\ub85d \ubc84\ud2bc\uc744 \uc815\ud655\ud558\uac8c \uc870\uc808\ud558\uc2ed\uc2dc\uc624. [\ube44\uc720 \uc124\uba85: \ucda4 \ub3d9\uc791\uacfc \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uc138\uc694. \uac01 \ub3d9\uc791\uc740 \uc790\uc5f0\uc2a4\ub7fd\uac8c \ub2e4\uc74c \ub3d9\uc791\uc73c\ub85c \uc774\uc5b4\uc9d1\ub2c8\ub2e4.]"}, {"question": "\uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \uc2a4\ud2f1 \ucc54\ud53c\uc5b8 \uaca9\ud22c\uae30\uc5d0\uc11c \uc2a4\ud0dc\ubbf8\ub098 \uad00\ub9ac\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc2a4\ud2f1 \ucc54\ud53c\uc5b8 \uaca9\ud22c\uae30\uc5d0\uc11c \uc2a4\ud0dc\ubbf8\ub098 \uad00\ub9ac\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \ud68c\ud53c, \ubc29\uc5b4 \ubc0f \ucf64\ubcf4 \uc2e4\ud589\uacfc \uac19\uc740 \ud589\uc704\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\ub294 \uc885\uc885 \uacf5\uaca9 \uc18d\ub3c4\uac00 \ube60\ub978 \uc801\uc744 \uc0c1\ub300\ud558\uac8c \ub418\ub294\ub370, \uc2a4\ud0dc\ubbf8\ub098\uac00 \ubd80\uc871\ud558\uba74 \ucde8\uc57d\ud574\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uadf8\ub9bc\uc790 \uc544\ub808\ub098'\uc758 \ubcf4\uc2a4 \uc804\ud22c \uc911 \uc2a4\ud0dc\ubbf8\ub098\ub97c \uc808\uc57d\ud558\uba74 \ubcf4\uc2a4\uc758 \ud30c\uad34\uc801\uc778 \ub300\uc0c1 \uc601\ud5a5 \uacf5\uaca9\uc744 \ud68c\ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \u8efd \uacf5\uaca9: 10 \uc2a4\ud0dc\ubbf8\ub098, \uac15\uacf5\uaca9: 20 \uc2a4\ud0dc\ubbf8\ub098, \ud68c\ud53c: 15 \uc2a4\ud0dc\ubbf8\ub098.]"}, {"question": "\uc2a4\ud2f1 \ucc54\ud53c\uc5b8 \uaca9\ud22c\uae30\uc5d0\uc11c \ucd5c\uc885 \ubcf4\uc2a4\ub97c \ubb3c\ub9ac\uce58\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc2a4\ud2f1 \ucc54\ud53c\uc5b8 \uaca9\ud22c\uae30\uc5d0\uc11c \ucd5c\uc885 \ubcf4\uc2a4\ub97c \ubb3c\ub9ac\uce58\ub824\uba74 \ud0c0\uc774\ubc0d, \uc804\ub7b5 \ubc0f \uc790\uc6d0 \uad00\ub9ac\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \uccab \ubc88\uc9f8 \ub2e8\uacc4\uc5d0\uc11c \ubcf4\uc2a4\uc758 \uacf5\uaca9 \ud328\ud134\uc744 \ubd84\uc11d\ud558\uc5ec \ubc18\uaca9\uc744 \uc704\ud55c \uc548\uc804\ud55c \ud2c8\uc0c8\ub97c \ud30c\uc545\ud569\ub2c8\ub2e4. STEP2: \uc774\ub7ec\ud55c \ud2c8\uc0c8 \uae30\ud68c \ub3d9\uc548 \uac00\uc7a5 \uac15\ub825\ud55c \ucf64\ubcf4\ub97c \uc0ac\uc6a9\ud558\uc9c0\ub9cc \uc2a4\ud0dc\ubbf8\ub098\ub97c \ud56d\uc0c1 \uc8fc\uc2dc\ud558\uc2ed\uc2dc\uc624. STEP3: \uc804\ud22c \uc804 \uacf5\uaca9\ub825\uacfc \uccb4\ub825 \ud68c\ubcf5\uc744 \ub192\uc774\ub294 \uc544\uc774\ud15c\uc744 \uc7a5\ucc29\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\ubd88\uaf43 \uac80'\uacfc '\uccb4\ub825 \ud3ec\uc158'\uc740 \uac8c\uc784\uc758 \ud750\ub984\uc744 \ubc14\uafc0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc5ec\ub7ec \uc804\ub7b5 \ube44\uad50: \uc635\uc158 A: \ub192\uc740 \ud53c\ud574\ub7c9\uc744 \ub0b4\ub294 \uacf5\uaca9\uc801\uc778 \ud50c\ub808\uc774; \uc635\uc158 B: \uc2a4\ud0dc\ubbf8\ub098 \ubcf4\uc874\uc5d0 \uc911\uc810\uc744 \ub454 \uc218\ube44\uc801\uc778 \ud50c\ub808\uc774.]"}, {"question": "\uade0\ud615 \uc7a1\ud78c \ube4c\ub4dc\ub97c \uc704\ud574 \uc2a4\ud2f1 \ucc54\ud53c\uc5b8 \uaca9\ud22c\uae30\uc5d0\uc11c \uc5b4\ub5a4 \uc2a4\ud0ac\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud574\uc57c \ud558\ub098\uc694?", "answer": "\uc2a4\ud2f1 \ucc54\ud53c\uc5b8 \uaca9\ud22c\uae30\uc5d0\uc11c \uade0\ud615 \uc7a1\ud78c \ube4c\ub4dc\ub97c \uc704\ud574 \uacf5\uaca9\uacfc \ubc29\uc5b4\ub97c \ubaa8\ub450 \uac15\ud654\ud558\ub294 \uc2a4\ud0ac\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc138\uc694. '\uac80\uc220' \uc2a4\ud0ac\uc740 \uacf5\uaca9\ub825\uc744 \ub192\uc774\uace0, '\ubc29\uc5b4 \uc790\uc138' \uc2a4\ud0ac\uc740 \ubc1b\ub294 \ud53c\ud574\ub97c \uc904\uc785\ub2c8\ub2e4. \ub610\ud55c, \uc7a5\uae30\uac04 \uc804\ud22c\uc5d0 \ud544\uc218\uc801\uc778 '\uc2a4\ud0dc\ubbf8\ub098 \uc7ac\uc0dd' \uc2a4\ud0ac\ub3c4 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucd08\ubc18 \uac8c\uc784\uc5d0\uc11c '\uac80\uc220'\uc744 3\ub2e8\uacc4\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uba74 \uc804\ud22c \ud6a8\uc728\uc744 \ud06c\uac8c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc2a4\ud0ac \ud2b8\ub9ac \u2192 \uacf5\uaca9 \u2192 \uac80\uc220 \u2192 \ub808\ubca8 \uc5c5 \u2192 \ud53c\ud574\ub7c9 \uc99d\uac00.]"}, {"question": "\uc2a4\ud2f1 \ucc54\ud53c\uc5b8 \uaca9\ud22c\uae30\uc5d0\uc11c \ubb34\uae30 \uc5c5\uadf8\ub808\uc774\ub4dc \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "\uc2a4\ud2f1 \ucc54\ud53c\uc5b8 \uaca9\ud22c\uae30\uc758 \ubb34\uae30 \uc5c5\uadf8\ub808\uc774\ub4dc \uc2dc\uc2a4\ud15c\uc744 \ud1b5\ud574 \ucc98\uce58\ud55c \uc801\uacfc \ubcf4\ubb3c \uc0c1\uc790\uc5d0\uc11c \uc5bb\uc740 \uc7ac\ub8cc\ub97c \uc0ac\uc6a9\ud558\uc5ec \ubb34\uae30\ub97c \uac15\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub824\uba74 \uba54\uc778 \ud5c8\ube0c\uc758 \ub300\uc7a5\uc7a5\uc774\ub97c \ubc29\ubb38\ud558\uc5ec \uac15\ud654\ud558\ub824\ub294 \ubb34\uae30\ub97c \uc120\ud0dd\ud558\uc138\uc694. \uac01 \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \ubb34\uae30\uc758 \uae30\ubcf8 \ud1b5\uacc4, \uc608\ub97c \ub4e4\uc5b4 \uacf5\uaca9\ub825\uacfc \uce58\uba85\ud0c0 \ud655\ub960\uc744 \ub192\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ucca0\uac80'\uc744 2\ub2e8\uacc4\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uba74 \uacf5\uaca9\ub825\uc774 15% \uc99d\uac00\ud569\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \ucca0\uac80 1\ub2e8\uacc4: 50 \uacf5\uaca9\ub825, 2\ub2e8\uacc4: 65 \uacf5\uaca9\ub825, 3\ub2e8\uacc4: 80 \uacf5\uaca9\ub825.]"}, {"question": "\uc2a4\ud2f1 \ucc54\ud53c\uc5b8 \uaca9\ud22c\uae30\uc758 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc2a4\ud2f1 \ucc54\ud53c\uc5b8 \uaca9\ud22c\uae30\uc758 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \uc810\uc810 \uc5b4\ub824\uc6cc\uc9c0\ub294 \ub808\ubca8\uacfc \ud568\uaed8 \ud575\uc2ec \uc2a4\ud1a0\ub9ac \ub77c\uc778\uc5d0 \uc911\uc810\uc744 \ub450\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ubc18\uba74 \uba40\ud2f0 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \ud611\ub3d9 \ubc0f \uacbd\uc7c1 \ud50c\ub808\uc774\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \uba40\ud2f0 \ud50c\ub808\uc774\uc5b4\uc5d0\uc11c\ub294 \uce5c\uad6c\ub4e4\uacfc \ud611\ub825\ud558\uc5ec \uc5b4\ub824\uc6b4 \ub358\uc804\uc744 \uc815\ubcf5\ud558\uac70\ub098 PvP \uc804\ud22c\uc5d0 \ucc38\uc5ec\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud611\ub3d9 \ub358\uc804' \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uac15\ub825\ud55c \ubcf4\uc2a4\ub97c \ubb3c\ub9ac\uce58\uae30 \uc704\ud574 \ud300\uc6cc\ud06c\uac00 \ud544\uc694\ud558\uba70, '\uc544\ub808\ub098 \uc804\ud22c'\ub294 \ud50c\ub808\uc774\uc5b4\ub4e4\uc758 \uae30\uc220\uc744 \uc2dc\ud5d8\ud558\ub294 \uacbd\uc7c1 \ubaa8\ub4dc\uc785\ub2c8\ub2e4. [\uc5ec\ub7ec \uc804\ub7b5 \ube44\uad50: \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4: \uc2a4\ud1a0\ub9ac \uc911\uc2ec, \uba40\ud2f0 \ud50c\ub808\uc774\uc5b4: \ud300 \uae30\ubc18 \ub610\ub294 \uacbd\uc7c1.]"}, {"question": "PC\uc5d0\uc11c \ubaa8\ubc14\uc77c\ub85c \uc2a4\ud2f1 \ucc54\ud53c\uc5b8 \uaca9\ud22c\uae30\uc758 \uc800\uc7a5 \ub370\uc774\ud130\ub97c \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc2a4\ud2f1 \ucc54\ud53c\uc5b8 \uaca9\ud22c\uae30\uc5d0\uc11c PC \uc800\uc7a5 \ub370\uc774\ud130\ub97c \ubaa8\ubc14\uc77c\ub85c \uc804\uc1a1\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1: \ub450 \ud50c\ub7ab\ud3fc \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. STEP2: PC \ubc84\uc804\uc5d0\uc11c '\uc800\uc7a5 \ub370\uc774\ud130' \uba54\ub274\ub85c \uc774\ub3d9\ud558\uc5ec '\ud074\ub77c\uc6b0\ub4dc\uc5d0 \uc5c5\ub85c\ub4dc'\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. STEP3: \ubaa8\ubc14\uc77c \ubc84\uc804\uc5d0\uc11c \ub3d9\uc77c\ud55c \uba54\ub274\ub85c \uc774\ub3d9\ud558\uc5ec '\ud074\ub77c\uc6b0\ub4dc\uc5d0\uc11c \ub2e4\uc6b4\ub85c\ub4dc'\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc774 \ubc29\ubc95\uc744 \ud1b5\ud574 \uae30\uae30\ub97c \ubc14\uafc0 \ub54c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc6d0\ud65c\ud558\uac8c \uc774\uc5b4\uac08 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc9d1\uc548 \ubb3c\uac74\uc744 \ud55c \uc9d1\uc5d0\uc11c \ub2e4\ub978 \uc9d1\uc73c\ub85c \uc62e\uae30\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uadf8\ub0e5 \uc5c5\ub85c\ub4dc\ud558\uace0 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uba74 \ub429\ub2c8\ub2e4.]"}, {"question": "\uc2a4\ud2f1 \ucc54\ud53c\uc5b8 \uaca9\ud22c\uae30\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc2a4\ud2f1 \ucc54\ud53c\uc5b8 \uaca9\ud22c\uae30\ub294 \ud0d0\ud5d8\uc744 \ubcf4\uc0c1\ud558\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub85c \uac00\ub4dd \ucc28 \uc788\uc2b5\ub2c8\ub2e4. \uc8fc\ubaa9\ud560 \ub9cc\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 '\uadf8\ub9bc\uc790 \uc232' \ub808\ubca8\uc758 '\ube44\ubc00 \ubc29'\uc785\ub2c8\ub2e4. \ub098\ubb34 \ub4a4\uc5d0 \uc228\uaca8\uc9c4 \uc2a4\uc704\uce58\ub97c \ucc3e\uc73c\uba74 \ub4dc\ubb38 \ubcf4\uc0c1\uc744 \uc5bb\uc744 \uc218 \uc788\ub294 \ubc29\uc73c\ub85c \uc774\uc5b4\uc9c0\ub294 \ubb38\uc774 \uc5f4\ub9bd\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 '\uc131\uacfd \uc720\uc801' \ub808\ubca8\uc5d0 \uc788\ub294 '\uac1c\ubc1c\uc790\uc758 \uba54\ubaa8'\uc785\ub2c8\ub2e4. \uc774 \uba54\ubaa8\ub294 \uac8c\uc784 \uc81c\uc791\uc5d0 \ub300\ud55c \ud1b5\ucc30\ub825\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. [\uc774\uc2a4\ud130 \uc5d0\uadf8 \ud0d0\uc0c9: \ube44\ubc00 \ubc29 \u2192 \uc228\uaca8\uc9c4 \uc2a4\uc704\uce58 \u2192 \ub4dc\ubb38 \ubcf4\uc0c1, \uac1c\ubc1c\uc790\uc758 \uba54\ubaa8 \u2192 \uac8c\uc784 \uac1c\ubc1c\uc5d0 \ub300\ud55c \ud1b5\ucc30\ub825.]"}, {"question": "\uc2a4\ud2f1 \ucc54\ud53c\uc5b8 \uaca9\ud22c\uae30\uc5d0\uc11c PvP\uc6a9 \uce90\ub9ad\ud130\uc758 \uc2a4\ud15f\uc744 \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc2a4\ud2f1 \ucc54\ud53c\uc5b8 \uaca9\ud22c\uae30\uc5d0\uc11c PvP\uc6a9 \uce90\ub9ad\ud130 \uc2a4\ud15f\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \ubbfc\ucca9\uc131\uacfc \uce58\uba85\ud0c0 \ud655\ub960\uc5d0 \uc911\uc810\uc744 \ub450\uc138\uc694. \ubbfc\ucca9\uc131\uc740 \uc774\ub3d9 \uc18d\ub3c4\uc640 \ud68c\ud53c \ud6a8\uc728\uc744 \ub192\uc774\uace0, \uce58\uba85\ud0c0 \ud655\ub960\uc740 \ud53c\ud574\ub7c9\uc744 \ub192\uc785\ub2c8\ub2e4. '\ube60\ub978 \ubd80\uce20'\uc640 '\uce58\uba85\ud0c0 \uc7a5\uac11'\uacfc \uac19\uc740 \uc774\ub7ec\ud55c \uc2a4\ud15f\uc744 \uac15\ud654\ud558\ub294 \uc7a5\ube44\ub97c \ucc29\uc6a9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub192\uc740 \ubbfc\ucca9\uc131 \ube4c\ub4dc\ub294 '\uc544\ub808\ub098 \uc804\ud22c' \ubaa8\ub4dc\uc5d0\uc11c \uc0c1\ub300\ubc29\uc744 \uc81c\uc555\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \ube60\ub978 \ubd80\uce20: +10 \ubbfc\ucca9\uc131, \uce58\uba85\ud0c0 \uc7a5\uac11: +15% \uce58\uba85\ud0c0 \ud655\ub960.]"}, {"question": "\uc2a4\ud2f1 \ucc54\ud53c\uc5b8 \uaca9\ud22c\uae30\uc5d0\uc11c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \uad70\uc911 \uc81c\uc5b4 \uae30\uc220\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc2a4\ud2f1 \ucc54\ud53c\uc5b8 \uaca9\ud22c\uae30\uc5d0\uc11c \ud6a8\uacfc\uc801\uc778 \uad70\uc911 \uc81c\uc5b4 \uae30\uc220\uc5d0\ub294 \ub300\uc0c1 \uc601\ud5a5(AoE) \uacf5\uaca9\uacfc \uae30\uc808 \uae30\uc220\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. '\ud68c\uc624\ub9ac \uc77c\uaca9' \uc2a4\ud0ac\uc740 \uc5ec\ub7ec \uc801\uc5d0\uac8c \ub3d9\uc2dc\uc5d0 \ud53c\ud574\ub97c \uc785\ud788\ub294 \ub370 \ud2b9\ud788 \uc720\uc6a9\ud558\uba70, '\uae30\uc808 \ud0c0\uaca9' \uae30\uc220\uc740 \uc77c\uc2dc\uc801\uc73c\ub85c \uc801 \uadf8\ub8f9\uc744 \ub9c8\ube44\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uadf8\ub9bc\uc790 \ubb34\ub9ac' \ub808\ubca8\uc5d0\uc11c '\ud68c\uc624\ub9ac \uc77c\uaca9'\uc744 \uc0ac\uc6a9\ud558\uba74 \uc804\uc7a5\uc744 \ube60\ub974\uac8c \uc815\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc5ec\ub7ec \uc804\ub7b5 \ube44\uad50: \ud68c\uc624\ub9ac \uc77c\uaca9: AoE \ud53c\ud574, \uae30\uc808 \ud0c0\uaca9: \uc77c\uc2dc\uc801\uc778 \ub9c8\ube44.]"}]
[{"question": "\u30b9\u30c6\u30a3\u30c3\u30af\u30fb\u30a8\u30d4\u30c3\u30af\u30fb\u30d5\u30a1\u30a4\u30bf\u30fc\u306e\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001\u57fa\u672c\u7684\u306a\u30b3\u30f3\u30dc\u3092\u3069\u306e\u3088\u3046\u306b\u5b9f\u884c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30b9\u30c6\u30a3\u30c3\u30af\u30fb\u30a8\u30d4\u30c3\u30af\u30fb\u30d5\u30a1\u30a4\u30bf\u30fc\u306e\u57fa\u672c\u30b3\u30f3\u30dc\u3092\u5b9f\u884c\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u653b\u6483\u30dc\u30bf\u30f3\uff08\u30c7\u30d5\u30a9\u30eb\u30c8\u306f\u300eX\u300f\uff09\u3092\u62bc\u3057\u3066\u3001\u8efd\u653b\u6483\u3092\u958b\u59cb\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u3059\u3050\u306b\u653b\u6483\u30dc\u30bf\u30f3\u3092\u3082\u3046\u4e00\u5ea6\u62bc\u3057\u3066\u30012\u56de\u76ee\u306e\u653b\u6483\u306b\u3064\u306a\u3052\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6700\u5f8c\u306b\u3001\u5f37\u529b\u306a\u653b\u6483\u3092\u884c\u3046\u91cd\u653b\u6483\u30dc\u30bf\u30f3\uff08\u30c7\u30d5\u30a9\u30eb\u30c8\u306f\u300eY\u300f\uff09\u3092\u62bc\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u306e\u6575\u306b\u5bfe\u3057\u3066\u3053\u306e\u30b3\u30f3\u30dc\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u6575\u306e\u4f53\u529b\u306f\u3059\u3050\u306b\u6e1b\u5c11\u3057\u307e\u3059\u3002\u30b3\u30f3\u30dc\u304c\u30b9\u30e0\u30fc\u30ba\u306b\u6d41\u308c\u308b\u3088\u3046\u306b\u3001\u30dc\u30bf\u30f3\u3092\u62bc\u3059\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u6b63\u78ba\u306b\u5408\u308f\u305b\u308b\u3088\u3046\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u4f8b\u3048\uff1a\u30c0\u30f3\u30b9\u306e\u30eb\u30fc\u30c6\u30a3\u30f3\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u5404\u52d5\u304d\u306f\u81ea\u7136\u306b\u6b21\u306e\u52d5\u304d\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002]"}, {"question": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u3001\u30b9\u30c6\u30a3\u30c3\u30af\u30fb\u30a8\u30d4\u30c3\u30af\u30fb\u30d5\u30a1\u30a4\u30bf\u30fc\u3067\u30b9\u30bf\u30df\u30ca\u3092\u7ba1\u7406\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30c6\u30a3\u30c3\u30af\u30fb\u30a8\u30d4\u30c3\u30af\u30fb\u30d5\u30a1\u30a4\u30bf\u30fc\u3067\u30b9\u30bf\u30df\u30ca\u3092\u7ba1\u7406\u3059\u308b\u3053\u3068\u306f\u3001\u56de\u907f\u3001\u30d6\u30ed\u30c3\u30af\u3001\u30b3\u30f3\u30dc\u306e\u5b9f\u884c\u306a\u3069\u306e\u30a2\u30af\u30b7\u30e7\u30f3\u3092\u5b9f\u884c\u3059\u308b\u80fd\u529b\u306b\u76f4\u63a5\u5f71\u97ff\u3059\u308b\u305f\u3081\u3001\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3057\u3070\u3057\u3070\u653b\u6483\u901f\u5ea6\u306e\u9ad8\u3044\u6575\u306b\u76f4\u9762\u3057\u3066\u304a\u308a\u3001\u30b9\u30bf\u30df\u30ca\u304c\u5c3d\u304d\u3066\u3057\u307e\u3046\u3068\u3001\u8106\u5f31\u306a\u72b6\u614b\u306b\u306a\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u5f71\u306e\u7af6\u6280\u5834\u300d\u306e\u30dc\u30b9\u6226\u3067\u306f\u3001\u30b9\u30bf\u30df\u30ca\u3092\u7bc0\u7d04\u3059\u308b\u3053\u3068\u3067\u3001\u30dc\u30b9\u306e\u58ca\u6ec5\u7684\u306a\u7bc4\u56f2\u653b\u6483\u3092\u56de\u907f\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03\u8868\uff1a\u8efd\u653b\u6483\uff1a10\u30b9\u30bf\u30df\u30ca\u3001\u91cd\u653b\u6483\uff1a20\u30b9\u30bf\u30df\u30ca\u3001\u56de\u907f\uff1a15\u30b9\u30bf\u30df\u30ca\u3002]"}, {"question": "\u30b9\u30c6\u30a3\u30c3\u30af\u30fb\u30a8\u30d4\u30c3\u30af\u30fb\u30d5\u30a1\u30a4\u30bf\u30fc\u3067\u6700\u7d42\u30dc\u30b9\u3092\u5012\u3059\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30c6\u30a3\u30c3\u30af\u30fb\u30a8\u30d4\u30c3\u30af\u30fb\u30d5\u30a1\u30a4\u30bf\u30fc\u3067\u6700\u7d42\u30dc\u30b9\u3092\u5012\u3059\u306b\u306f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3001\u6226\u7565\u3001\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6700\u521d\u306e\u30d5\u30a7\u30fc\u30ba\u3067\u30dc\u30b9\u306e\u653b\u6483\u30d1\u30bf\u30fc\u30f3\u3092\u5206\u6790\u3057\u3001\u53cd\u6483\u306e\u305f\u3081\u306e\u5b89\u5168\u306a\u6a5f\u4f1a\u3092\u898b\u3064\u3051\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u3053\u308c\u3089\u306e\u6a5f\u4f1a\u306b\u5f37\u529b\u306a\u30b3\u30f3\u30dc\u3092\u4f7f\u7528\u3057\u307e\u3059\u304c\u3001\u5e38\u306b\u30b9\u30bf\u30df\u30ca\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6226\u95d8\u524d\u306b\u3001\u653b\u6483\u529b\u3068\u4f53\u529b\u56de\u5fa9\u3092\u9ad8\u3081\u308b\u30a2\u30a4\u30c6\u30e0\u3092\u88c5\u5099\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u708e\u306e\u5263\u300d\u3068\u300c\u751f\u547d\u306e\u85ac\u300d\u306f\u30b2\u30fc\u30e0\u3092\u5909\u3048\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002[\u8907\u6570\u306e\u9078\u629e\u80a2\uff1a\u30aa\u30d7\u30b7\u30e7\u30f3A\uff1a\u9ad8\u30c0\u30e1\u30fc\u30b8\u51fa\u529b\u306e\u7a4d\u6975\u7684\u306a\u30d7\u30ec\u30a4\u3001\u30aa\u30d7\u30b7\u30e7\u30f3B\uff1a\u30b9\u30bf\u30df\u30ca\u7bc0\u7d04\u306b\u7126\u70b9\u3092\u5f53\u3066\u305f\u9632\u5fa1\u7684\u306a\u30d7\u30ec\u30a4\u3002]"}, {"question": "\u30b9\u30c6\u30a3\u30c3\u30af\u30fb\u30a8\u30d4\u30c3\u30af\u30fb\u30d5\u30a1\u30a4\u30bf\u30fc\u3067\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u30d3\u30eb\u30c9\u306b\u3059\u308b\u305f\u3081\u306b\u306f\u3001\u3069\u306e\u30b9\u30ad\u30eb\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u512a\u5148\u3059\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30c6\u30a3\u30c3\u30af\u30fb\u30a8\u30d4\u30c3\u30af\u30fb\u30d5\u30a1\u30a4\u30bf\u30fc\u3067\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u30d3\u30eb\u30c9\u306b\u3059\u308b\u306b\u306f\u3001\u653b\u6483\u3068\u9632\u5fa1\u306e\u4e21\u65b9\u3092\u5f37\u5316\u3059\u308b\u30b9\u30ad\u30eb\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u300c\u5263\u306e\u9054\u4eba\u300d\u30b9\u30ad\u30eb\u306f\u653b\u6483\u30c0\u30e1\u30fc\u30b8\u3092\u9ad8\u3081\u3001\u300c\u9632\u5fa1\u59ff\u52e2\u300d\u30b9\u30ad\u30eb\u306f\u53d7\u3051\u308b\u30c0\u30e1\u30fc\u30b8\u3092\u6e1b\u3089\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u300c\u30b9\u30bf\u30df\u30ca\u56de\u5fa9\u300d\u306f\u9577\u6642\u9593\u6226\u95d8\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u521d\u671f\u306e\u30b2\u30fc\u30e0\u3067\u300c\u5263\u306e\u9054\u4eba\u300d\u3092\u30ec\u30d9\u30eb3\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3068\u3001\u6226\u95d8\u80fd\u529b\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30b9\u30ad\u30eb\u30c4\u30ea\u30fc\u2192\u653b\u6483\u2192\u5263\u306e\u9054\u4eba\u2192\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u2192\u30c0\u30e1\u30fc\u30b8\u5897\u52a0\u3002]"}, {"question": "\u30b9\u30c6\u30a3\u30c3\u30af\u30fb\u30a8\u30d4\u30c3\u30af\u30fb\u30d5\u30a1\u30a4\u30bf\u30fc\u306e\u6b66\u5668\u5f37\u5316\u30b7\u30b9\u30c6\u30e0\u306e\u4ed5\u7d44\u307f\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30c6\u30a3\u30c3\u30af\u30fb\u30a8\u30d4\u30c3\u30af\u30fb\u30d5\u30a1\u30a4\u30bf\u30fc\u306e\u6b66\u5668\u5f37\u5316\u30b7\u30b9\u30c6\u30e0\u3067\u306f\u3001\u5012\u3057\u305f\u6575\u3084\u5b9d\u7bb1\u304b\u3089\u96c6\u3081\u305f\u7d20\u6750\u3092\u4f7f\u7528\u3057\u3066\u6b66\u5668\u3092\u5f37\u5316\u3067\u304d\u307e\u3059\u3002\u5f37\u5316\u3059\u308b\u306b\u306f\u3001\u30e1\u30a4\u30f3\u30cf\u30d6\u306b\u3042\u308b\u935b\u51b6\u5c4b\u3092\u8a2a\u308c\u3001\u5f37\u5316\u3057\u305f\u3044\u6b66\u5668\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u5404\u5f37\u5316\u306b\u3088\u308a\u3001\u6b66\u5668\u306e\u57fa\u672c\u7684\u306a\u7d71\u8a08\u5024\uff08\u653b\u6483\u529b\u3001\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u7387\u306a\u3069\uff09\u304c\u5897\u52a0\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u9244\u306e\u5263\u300d\u3092\u30ec\u30d9\u30eb2\u306b\u5f37\u5316\u3059\u308b\u3068\u3001\u653b\u6483\u529b\u304c15\uff05\u5897\u52a0\u3057\u307e\u3059\u3002[\u6bd4\u8f03\u8868\uff1a\u9244\u306e\u5263\u30ec\u30d9\u30eb1\uff1a\u653b\u6483\u529b50\u3001\u30ec\u30d9\u30eb2\uff1a\u653b\u6483\u529b65\u3001\u30ec\u30d9\u30eb3\uff1a\u653b\u6483\u529b80\u3002]"}, {"question": "\u30b9\u30c6\u30a3\u30c3\u30af\u30fb\u30a8\u30d4\u30c3\u30af\u30fb\u30d5\u30a1\u30a4\u30bf\u30fc\u306e\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30c6\u30a3\u30c3\u30af\u30fb\u30a8\u30d4\u30c3\u30af\u30fb\u30d5\u30a1\u30a4\u30bf\u30fc\u306e\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u3001\u6bb5\u968e\u7684\u306b\u96e3\u6613\u5ea6\u304c\u9ad8\u307e\u308b\u30ec\u30d9\u30eb\u3092\u4f34\u3046\u76f4\u7dda\u7684\u306a\u30b9\u30c8\u30fc\u30ea\u30fc\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u3044\u307e\u3059\u3002\u4e00\u65b9\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u5354\u529b\u578b\u3068\u7af6\u4e89\u578b\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u306f\u3001\u53cb\u9054\u3068\u30c1\u30fc\u30e0\u3092\u7d44\u3093\u3067\u56f0\u96e3\u306a\u30c0\u30f3\u30b8\u30e7\u30f3\u306b\u6311\u6226\u3057\u305f\u308a\u3001PvP\u30d0\u30c8\u30eb\u306b\u53c2\u52a0\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u5354\u529b\u30c0\u30f3\u30b8\u30e7\u30f3\u300d\u30e2\u30fc\u30c9\u3067\u306f\u3001\u5f37\u529b\u306a\u30dc\u30b9\u3092\u5012\u3059\u305f\u3081\u306b\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u304c\u5fc5\u8981\u3067\u3059\u3002\u300c\u30a2\u30ea\u30fc\u30ca\u30d0\u30c8\u30eb\u300d\u306f\u30d7\u30ec\u30a4\u30e4\u30fc\u540c\u58eb\u304c\u30b9\u30ad\u30eb\u3092\u7af6\u3044\u5408\u3046\u5834\u3067\u3059\u3002[\u8907\u6570\u306e\u9078\u629e\u80a2\uff1a\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\uff1a\u30b9\u30c8\u30fc\u30ea\u30fc\u91cd\u8996\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\uff1a\u30c1\u30fc\u30e0\u30d9\u30fc\u30b9\u307e\u305f\u306f\u7af6\u4e89\u578b\u3002]"}, {"question": "\u30b9\u30c6\u30a3\u30c3\u30af\u30fb\u30a8\u30d4\u30c3\u30af\u30fb\u30d5\u30a1\u30a4\u30bf\u30fc\u3067PC\u7248\u306e\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u3092\u30e2\u30d0\u30a4\u30eb\u7248\u306b\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30c6\u30a3\u30c3\u30af\u30fb\u30a8\u30d4\u30c3\u30af\u30fb\u30d5\u30a1\u30a4\u30bf\u30fc\u3067PC\u7248\u306e\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u3092\u30e2\u30d0\u30a4\u30eb\u7248\u306b\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u4e21\u65b9\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1aPC\u7248\u3067\u300c\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u300d\u30e1\u30cb\u30e5\u30fc\u306b\u79fb\u52d5\u3057\u3001\u300c\u30af\u30e9\u30a6\u30c9\u306b\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u300d\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30e2\u30d0\u30a4\u30eb\u7248\u3067\u540c\u3058\u30e1\u30cb\u30e5\u30fc\u306b\u79fb\u52d5\u3057\u3001\u300c\u30af\u30e9\u30a6\u30c9\u304b\u3089\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u300d\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u3053\u306e\u65b9\u6cd5\u306b\u3088\u308a\u3001\u30c7\u30d0\u30a4\u30b9\u3092\u5207\u308a\u66ff\u3048\u3066\u3082\u9032\u884c\u72b6\u6cc1\u3092\u30b7\u30fc\u30e0\u30ec\u30b9\u306b\u7d9a\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u6301\u3061\u7269\u3092\u5225\u306e\u5bb6\u3078\u79fb\u52d5\u3059\u308b\u306e\u3068\u540c\u3058\u3067\u3059\u3002\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3057\u3066\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3059\u308b\u3060\u3051\u3067\u3059\u3002]"}, {"question": "\u30b9\u30c6\u30a3\u30c3\u30af\u30fb\u30a8\u30d4\u30c3\u30af\u30fb\u30d5\u30a1\u30a4\u30bf\u30fc\u3067\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30c6\u30a3\u30c3\u30af\u30fb\u30a8\u30d4\u30c3\u30af\u30fb\u30d5\u30a1\u30a4\u30bf\u30fc\u306b\u306f\u3001\u63a2\u7d22\u3092\u5831\u3044\u308b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u305f\u304f\u3055\u3093\u3042\u308a\u307e\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306e1\u3064\u306f\u3001\u300c\u5f71\u306e\u68ee\u300d\u30ec\u30d9\u30eb\u306e\u300c\u79d8\u5bc6\u306e\u90e8\u5c4b\u300d\u3067\u3059\u3002\u6728\u306e\u5f8c\u306b\u3042\u308b\u96a0\u3055\u308c\u305f\u30b9\u30a4\u30c3\u30c1\u3092\u63a2\u3059\u3068\u3001\u8cb4\u91cd\u306a\u6226\u5229\u54c1\u304c\u5165\u3063\u305f\u90e8\u5c4b\u306b\u901a\u3058\u308b\u6249\u304c\u958b\u304d\u307e\u3059\u3002\u3082\u30461\u3064\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3001\u300c\u57ce\u306e\u5ec3\u589f\u300d\u30ec\u30d9\u30eb\u306b\u3042\u308b\u300c\u958b\u767a\u8005\u30e1\u30e2\u300d\u3067\u3001\u30b2\u30fc\u30e0\u306e\u5236\u4f5c\u306b\u95a2\u3059\u308b\u6d1e\u5bdf\u304c\u5f97\u3089\u308c\u307e\u3059\u3002[\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306e\u767a\u898b\uff1a\u79d8\u5bc6\u306e\u90e8\u5c4b\u2192\u96a0\u3055\u308c\u305f\u30b9\u30a4\u30c3\u30c1\u2192\u8cb4\u91cd\u306a\u6226\u5229\u54c1\u3001\u958b\u767a\u8005\u30e1\u30e2\u2192\u30b2\u30fc\u30e0\u958b\u767a\u306b\u95a2\u3059\u308b\u6d1e\u5bdf\u3002]"}, {"question": "\u30b9\u30c6\u30a3\u30c3\u30af\u30fb\u30a8\u30d4\u30c3\u30af\u30fb\u30d5\u30a1\u30a4\u30bf\u30fc\u3067PvP\u5411\u3051\u306b\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30c6\u30a3\u30c3\u30af\u30fb\u30a8\u30d4\u30c3\u30af\u30fb\u30d5\u30a1\u30a4\u30bf\u30fc\u3067PvP\u5411\u3051\u306b\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u4fca\u654f\u6027\u3068\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u7387\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4fca\u654f\u6027\u306f\u79fb\u52d5\u901f\u5ea6\u3068\u56de\u907f\u80fd\u529b\u3092\u9ad8\u3081\u3001\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u7387\u306f\u30c0\u30e1\u30fc\u30b8\u51fa\u529b\u3092\u9ad8\u3081\u307e\u3059\u3002\u300c\u30b9\u30a6\u30a3\u30d5\u30c8\u30d6\u30fc\u30c4\u300d\u3084\u300c\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30b0\u30ed\u30fc\u30d6\u300d\u306a\u3069\u306e\u3053\u308c\u3089\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u9ad8\u3081\u308b\u88c5\u5099\u3092\u88c5\u5099\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u3001\u9ad8\u3044\u4fca\u654f\u6027\u30d3\u30eb\u30c9\u306b\u3088\u308a\u3001\u300c\u30a2\u30ea\u30fc\u30ca\u30d0\u30c8\u30eb\u300d\u30e2\u30fc\u30c9\u3067\u6575\u3092\u51fa\u3057\u629c\u304f\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03\u8868\uff1a\u30b9\u30a6\u30a3\u30d5\u30c8\u30d6\u30fc\u30c4\uff1a\u4fca\u654f\u6027\uff0b10\u3001\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30b0\u30ed\u30fc\u30d6\uff1a\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u7387\uff0b15\uff05\u3002]"}, {"question": "\u30b9\u30c6\u30a3\u30c3\u30af\u30fb\u30a8\u30d4\u30c3\u30af\u30fb\u30d5\u30a1\u30a4\u30bf\u30fc\u3067\u6700\u3082\u52b9\u679c\u7684\u306a\u96d1\u9b5a\u51e6\u7406\u30c6\u30af\u30cb\u30c3\u30af\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30c6\u30a3\u30c3\u30af\u30fb\u30a8\u30d4\u30c3\u30af\u30fb\u30d5\u30a1\u30a4\u30bf\u30fc\u3067\u52b9\u679c\u7684\u306a\u96d1\u9b5a\u51e6\u7406\u30c6\u30af\u30cb\u30c3\u30af\u306b\u306f\u3001\u7bc4\u56f2\u653b\u6483\uff08AoE\uff09\u3068\u30b9\u30bf\u30f3\u80fd\u529b\u304c\u3042\u308a\u307e\u3059\u3002\u300c\u6e26\u5dfb\u304f\u65ac\u6483\u300d\u30b9\u30ad\u30eb\u306f\u3001\u8907\u6570\u306e\u6575\u306b\u4e00\u5ea6\u306b\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u306e\u306b\u7279\u306b\u5f79\u7acb\u3061\u3001\u300c\u30b9\u30bf\u30f3\u30b9\u30c8\u30e9\u30a4\u30af\u300d\u80fd\u529b\u306f\u6575\u306e\u30b0\u30eb\u30fc\u30d7\u3092\u4e00\u6642\u7684\u306b\u7121\u52b9\u5316\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u5f71\u306e\u7fa4\u308c\u300d\u30ec\u30d9\u30eb\u3067\u300c\u6e26\u5dfb\u304f\u65ac\u6483\u300d\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u6226\u95d8\u5834\u3092\u7d20\u65e9\u304f\u30af\u30ea\u30a2\u3067\u304d\u307e\u3059\u3002[\u8907\u6570\u306e\u9078\u629e\u80a2\uff1a\u6e26\u5dfb\u304f\u65ac\u6483\uff1aAoE\u30c0\u30e1\u30fc\u30b8\u3001\u30b9\u30bf\u30f3\u30b9\u30c8\u30e9\u30a4\u30af\uff1a\u4e00\u6642\u7684\u306a\u7121\u52b9\u5316\u3002]"}]
[{"question": "\u0e09\u0e31\u0e19\u0e08\u0e30\u0e17\u0e33\u0e04\u0e2d\u0e21\u0e42\u0e1a\u0e1e\u0e37\u0e49\u0e19\u0e10\u0e32\u0e19\u0e43\u0e19 Stick Epic Fighter \u0e44\u0e14\u0e49\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e44\u0e23\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e1c\u0e39\u0e49\u0e40\u0e23\u0e34\u0e48\u0e21\u0e15\u0e49\u0e19?", "answer": "\u0e43\u0e19\u0e01\u0e32\u0e23\u0e14\u0e33\u0e40\u0e19\u0e34\u0e19\u0e01\u0e32\u0e23\u0e04\u0e2d\u0e21\u0e42\u0e1a\u0e1e\u0e37\u0e49\u0e19\u0e10\u0e32\u0e19\u0e43\u0e19 Stick Epic Fighter \u0e42\u0e1b\u0e23\u0e14\u0e17\u0e33\u0e15\u0e32\u0e21\u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e40\u0e2b\u0e25\u0e48\u0e32\u0e19\u0e35\u0e49: \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 1: \u0e01\u0e14\u0e1b\u0e38\u0e48\u0e21\u0e42\u0e08\u0e21\u0e15\u0e35 (\u0e04\u0e48\u0e32\u0e40\u0e23\u0e34\u0e48\u0e21\u0e15\u0e49\u0e19\u0e04\u0e37\u0e2d 'X') \u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e40\u0e23\u0e34\u0e48\u0e21\u0e01\u0e32\u0e23\u0e42\u0e08\u0e21\u0e15\u0e35\u0e40\u0e1a\u0e32\u0e46 \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 2: \u0e01\u0e14\u0e1b\u0e38\u0e48\u0e21\u0e42\u0e08\u0e21\u0e15\u0e35\u0e2d\u0e35\u0e01\u0e04\u0e23\u0e31\u0e49\u0e07\u0e17\u0e31\u0e19\u0e17\u0e35\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e40\u0e0a\u0e37\u0e48\u0e2d\u0e21\u0e15\u0e48\u0e2d\u0e01\u0e32\u0e23\u0e42\u0e08\u0e21\u0e15\u0e35\u0e04\u0e23\u0e31\u0e49\u0e07\u0e17\u0e35\u0e48\u0e2a\u0e2d\u0e07 \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 3: \u0e2a\u0e38\u0e14\u0e17\u0e49\u0e32\u0e22 \u0e01\u0e14\u0e1b\u0e38\u0e48\u0e21\u0e42\u0e08\u0e21\u0e15\u0e35\u0e2b\u0e19\u0e31\u0e01 (\u0e04\u0e48\u0e32\u0e40\u0e23\u0e34\u0e48\u0e21\u0e15\u0e49\u0e19\u0e04\u0e37\u0e2d 'Y') \u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e2a\u0e34\u0e49\u0e19\u0e2a\u0e38\u0e14\u0e14\u0e49\u0e27\u0e22\u0e01\u0e32\u0e23\u0e42\u0e08\u0e21\u0e15\u0e35\u0e17\u0e35\u0e48\u0e17\u0e23\u0e07\u0e1e\u0e25\u0e31\u0e07 \u0e15\u0e31\u0e27\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e40\u0e0a\u0e48\u0e19 \u0e01\u0e32\u0e23\u0e43\u0e0a\u0e49\u0e04\u0e2d\u0e21\u0e42\u0e1a\u0e19\u0e35\u0e49\u0e01\u0e31\u0e1a\u0e28\u0e31\u0e15\u0e23\u0e39\u0e43\u0e19\u0e23\u0e30\u0e14\u0e31\u0e1a\u0e41\u0e23\u0e01\u0e2a\u0e32\u0e21\u0e32\u0e23\u0e16\u0e25\u0e14\u0e40\u0e25\u0e37\u0e2d\u0e14\u0e02\u0e2d\u0e07\u0e1e\u0e27\u0e01\u0e21\u0e31\u0e19\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e23\u0e27\u0e14\u0e40\u0e23\u0e47\u0e27 \u0e42\u0e1b\u0e23\u0e14\u0e08\u0e33\u0e44\u0e27\u0e49\u0e27\u0e48\u0e32\u0e15\u0e49\u0e2d\u0e07\u0e08\u0e31\u0e1a\u0e40\u0e27\u0e25\u0e32\u0e01\u0e32\u0e23\u0e01\u0e14\u0e1b\u0e38\u0e48\u0e21\u0e43\u0e2b\u0e49\u0e16\u0e39\u0e01\u0e15\u0e49\u0e2d\u0e07\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e43\u0e2b\u0e49\u0e04\u0e2d\u0e21\u0e42\u0e1a\u0e44\u0e2b\u0e25\u0e25\u0e37\u0e48\u0e19 [\u0e15\u0e31\u0e27\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e01\u0e32\u0e23\u0e40\u0e1b\u0e23\u0e35\u0e22\u0e1a\u0e40\u0e17\u0e35\u0e22\u0e1a: \u0e25\u0e2d\u0e07\u0e19\u0e36\u0e01\u0e20\u0e32\u0e1e\u0e40\u0e2b\u0e21\u0e37\u0e2d\u0e19\u0e01\u0e32\u0e23\u0e40\u0e15\u0e49\u0e19\u0e23\u0e33 \u2013 \u0e41\u0e15\u0e48\u0e25\u0e30\u0e17\u0e48\u0e32\u0e08\u0e30\u0e19\u0e33\u0e44\u0e1b\u0e2a\u0e39\u0e48\u0e17\u0e48\u0e32\u0e16\u0e31\u0e14\u0e44\u0e1b\u0e42\u0e14\u0e22\u0e18\u0e23\u0e23\u0e21\u0e0a\u0e32\u0e15\u0e34]"}, {"question": "\u0e17\u0e33\u0e44\u0e21\u0e01\u0e32\u0e23\u0e08\u0e31\u0e14\u0e01\u0e32\u0e23\u0e2a\u0e41\u0e15\u0e21\u0e34\u0e19\u0e32\u0e08\u0e36\u0e07\u0e2a\u0e33\u0e04\u0e31\u0e0d\u0e43\u0e19 Stick Epic Fighter \u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19\u0e02\u0e31\u0e49\u0e19\u0e2a\u0e39\u0e07?", "answer": "\u0e01\u0e32\u0e23\u0e08\u0e31\u0e14\u0e01\u0e32\u0e23\u0e2a\u0e41\u0e15\u0e21\u0e34\u0e19\u0e32\u0e40\u0e1b\u0e47\u0e19\u0e2a\u0e34\u0e48\u0e07\u0e2a\u0e33\u0e04\u0e31\u0e0d\u0e43\u0e19 Stick Epic Fighter \u0e40\u0e1e\u0e23\u0e32\u0e30\u0e21\u0e31\u0e19\u0e2a\u0e48\u0e07\u0e1c\u0e25\u0e42\u0e14\u0e22\u0e15\u0e23\u0e07\u0e15\u0e48\u0e2d\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e32\u0e21\u0e32\u0e23\u0e16\u0e43\u0e19\u0e01\u0e32\u0e23\u0e1b\u0e0f\u0e34\u0e1a\u0e31\u0e15\u0e34\u0e20\u0e32\u0e23\u0e01\u0e34\u0e08\u0e15\u0e48\u0e32\u0e07\u0e46 \u0e40\u0e0a\u0e48\u0e19 \u0e2b\u0e25\u0e1a \u0e01\u0e32\u0e23\u0e1a\u0e25\u0e47\u0e2d\u0e01 \u0e41\u0e25\u0e30\u0e01\u0e32\u0e23\u0e01\u0e23\u0e30\u0e17\u0e33\u0e04\u0e2d\u0e21\u0e42\u0e1a \u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19\u0e02\u0e31\u0e49\u0e19\u0e2a\u0e39\u0e07\u0e21\u0e31\u0e01\u0e40\u0e1c\u0e0a\u0e34\u0e0d\u0e01\u0e31\u0e1a\u0e28\u0e31\u0e15\u0e23\u0e39\u0e17\u0e35\u0e48\u0e21\u0e35\u0e2d\u0e31\u0e15\u0e23\u0e32\u0e01\u0e32\u0e23\u0e42\u0e08\u0e21\u0e15\u0e35\u0e2a\u0e39\u0e07 \u0e41\u0e25\u0e30\u0e2b\u0e32\u0e01\u0e2b\u0e21\u0e14\u0e2a\u0e41\u0e15\u0e21\u0e34\u0e19\u0e32\u0e08\u0e30\u0e17\u0e33\u0e43\u0e2b\u0e49\u0e04\u0e38\u0e13\u0e2d\u0e48\u0e2d\u0e19\u0e41\u0e2d \u0e15\u0e31\u0e27\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e40\u0e0a\u0e48\u0e19 \u0e43\u0e19\u0e01\u0e32\u0e23\u0e15\u0e48\u0e2d\u0e2a\u0e39\u0e49\u0e01\u0e31\u0e1a\u0e1a\u0e2d\u0e2a\u0e43\u0e19 'Shadow Arena' \u0e01\u0e32\u0e23\u0e23\u0e31\u0e01\u0e29\u0e32\u0e2a\u0e41\u0e15\u0e21\u0e34\u0e19\u0e32\u0e08\u0e30\u0e0a\u0e48\u0e27\u0e22\u0e43\u0e2b\u0e49\u0e04\u0e38\u0e13\u0e2b\u0e25\u0e1a\u0e01\u0e32\u0e23\u0e42\u0e08\u0e21\u0e15\u0e35\u0e41\u0e1a\u0e1a\u0e04\u0e23\u0e2d\u0e1a\u0e04\u0e25\u0e38\u0e21\u0e02\u0e2d\u0e07\u0e1a\u0e2d\u0e2a [\u0e15\u0e32\u0e23\u0e32\u0e07\u0e2d\u0e49\u0e32\u0e07\u0e2d\u0e34\u0e07: \u0e01\u0e32\u0e23\u0e42\u0e08\u0e21\u0e15\u0e35\u0e40\u0e1a\u0e32:  10 \u0e2a\u0e41\u0e15\u0e21\u0e34\u0e19\u0e32, \u0e01\u0e32\u0e23\u0e42\u0e08\u0e21\u0e15\u0e35\u0e2b\u0e19\u0e31\u0e01: 20 \u0e2a\u0e41\u0e15\u0e21\u0e34\u0e19\u0e32, \u0e01\u0e32\u0e23\u0e2b\u0e25\u0e1a: 15 \u0e2a\u0e41\u0e15\u0e21\u0e34\u0e19\u0e32]"}, {"question": "\u0e01\u0e25\u0e22\u0e38\u0e17\u0e18\u0e4c\u0e17\u0e35\u0e48\u0e14\u0e35\u0e17\u0e35\u0e48\u0e2a\u0e38\u0e14\u0e43\u0e19\u0e01\u0e32\u0e23\u0e40\u0e2d\u0e32\u0e0a\u0e19\u0e30\u0e1a\u0e2d\u0e2a\u0e2a\u0e38\u0e14\u0e17\u0e49\u0e32\u0e22\u0e43\u0e19 Stick Epic Fighter \u0e04\u0e37\u0e2d\u0e2d\u0e30\u0e44\u0e23?", "answer": "\u0e01\u0e32\u0e23\u0e40\u0e2d\u0e32\u0e0a\u0e19\u0e30\u0e1a\u0e2d\u0e2a\u0e2a\u0e38\u0e14\u0e17\u0e49\u0e32\u0e22\u0e43\u0e19 Stick Epic Fighter \u0e15\u0e49\u0e2d\u0e07\u0e2d\u0e32\u0e28\u0e31\u0e22\u0e01\u0e32\u0e23\u0e1c\u0e2a\u0e21\u0e1c\u0e2a\u0e32\u0e19\u0e02\u0e2d\u0e07\u0e01\u0e32\u0e23\u0e08\u0e31\u0e1a\u0e40\u0e27\u0e25\u0e32 \u0e01\u0e25\u0e22\u0e38\u0e17\u0e18\u0e4c \u0e41\u0e25\u0e30\u0e01\u0e32\u0e23\u0e08\u0e31\u0e14\u0e01\u0e32\u0e23\u0e17\u0e23\u0e31\u0e1e\u0e22\u0e32\u0e01\u0e23 \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 1: \u0e28\u0e36\u0e01\u0e29\u0e32\u0e41\u0e1a\u0e1a\u0e41\u0e1c\u0e19\u0e01\u0e32\u0e23\u0e42\u0e08\u0e21\u0e15\u0e35\u0e02\u0e2d\u0e07\u0e1a\u0e2d\u0e2a\u0e43\u0e19\u0e40\u0e1f\u0e2a\u0e41\u0e23\u0e01\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e23\u0e30\u0e1a\u0e38\u0e0a\u0e48\u0e27\u0e07\u0e40\u0e27\u0e25\u0e32\u0e1b\u0e25\u0e2d\u0e14\u0e20\u0e31\u0e22\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e01\u0e32\u0e23\u0e15\u0e2d\u0e1a\u0e42\u0e15\u0e49 \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 2: \u0e43\u0e0a\u0e49\u0e04\u0e2d\u0e21\u0e42\u0e1a\u0e17\u0e35\u0e48\u0e17\u0e23\u0e07\u0e1e\u0e25\u0e31\u0e07\u0e17\u0e35\u0e48\u0e2a\u0e38\u0e14\u0e43\u0e19\u0e0a\u0e48\u0e27\u0e07\u0e40\u0e27\u0e25\u0e32\u0e19\u0e31\u0e49\u0e19 \u0e41\u0e15\u0e48\u0e15\u0e49\u0e2d\u0e07\u0e40\u0e1d\u0e49\u0e32\u0e23\u0e30\u0e27\u0e31\u0e07\u0e2a\u0e41\u0e15\u0e21\u0e34\u0e19\u0e32\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e40\u0e2a\u0e21\u0e2d \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 3: \u0e40\u0e15\u0e23\u0e35\u0e22\u0e21\u0e2d\u0e38\u0e1b\u0e01\u0e23\u0e13\u0e4c\u0e17\u0e35\u0e48\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e1e\u0e25\u0e31\u0e07\u0e42\u0e08\u0e21\u0e15\u0e35\u0e41\u0e25\u0e30\u0e01\u0e32\u0e23\u0e1f\u0e37\u0e49\u0e19\u0e1f\u0e39\u0e40\u0e25\u0e37\u0e2d\u0e14\u0e01\u0e48\u0e2d\u0e19\u0e01\u0e32\u0e23\u0e15\u0e48\u0e2d\u0e2a\u0e39\u0e49 \u0e15\u0e31\u0e27\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e40\u0e0a\u0e48\u0e19 '\u0e14\u0e32\u0e1a\u0e44\u0e1f' \u0e41\u0e25\u0e30 '\u0e22\u0e32\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e40\u0e25\u0e37\u0e2d\u0e14' \u0e2a\u0e32\u0e21\u0e32\u0e23\u0e16\u0e40\u0e1b\u0e25\u0e35\u0e48\u0e22\u0e19\u0e40\u0e01\u0e21\u0e44\u0e14\u0e49 [\u0e01\u0e32\u0e23\u0e40\u0e1b\u0e23\u0e35\u0e22\u0e1a\u0e40\u0e17\u0e35\u0e22\u0e1a\u0e15\u0e31\u0e27\u0e40\u0e25\u0e37\u0e2d\u0e01: \u0e15\u0e31\u0e27\u0e40\u0e25\u0e37\u0e2d\u0e01 A: \u0e01\u0e32\u0e23\u0e40\u0e25\u0e48\u0e19\u0e41\u0e1a\u0e1a\u0e23\u0e38\u0e01\u0e14\u0e49\u0e27\u0e22\u0e2d\u0e31\u0e15\u0e23\u0e32\u0e01\u0e32\u0e23\u0e17\u0e33\u0e14\u0e32\u0e40\u0e21\u0e08\u0e2a\u0e39\u0e07; \u0e15\u0e31\u0e27\u0e40\u0e25\u0e37\u0e2d\u0e01 B: \u0e01\u0e32\u0e23\u0e40\u0e25\u0e48\u0e19\u0e41\u0e1a\u0e1a\u0e1b\u0e49\u0e2d\u0e07\u0e01\u0e31\u0e19\u0e40\u0e19\u0e49\u0e19\u0e01\u0e32\u0e23\u0e23\u0e31\u0e01\u0e29\u0e32\u0e2a\u0e41\u0e15\u0e21\u0e34\u0e19\u0e32]"}, {"question": "\u0e17\u0e31\u0e01\u0e29\u0e30\u0e43\u0e14\u0e04\u0e27\u0e23\u0e40\u0e19\u0e49\u0e19\u0e01\u0e32\u0e23\u0e2d\u0e31\u0e1e\u0e40\u0e01\u0e23\u0e14\u0e43\u0e19 Stick Epic Fighter \u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e01\u0e32\u0e23\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e2a\u0e21\u0e14\u0e38\u0e25?", "answer": "\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e01\u0e32\u0e23\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e2a\u0e21\u0e14\u0e38\u0e25\u0e43\u0e19 Stick Epic Fighter \u0e42\u0e1b\u0e23\u0e14\u0e40\u0e19\u0e49\u0e19\u0e01\u0e32\u0e23\u0e2d\u0e31\u0e1e\u0e40\u0e01\u0e23\u0e14\u0e17\u0e31\u0e01\u0e29\u0e30\u0e17\u0e35\u0e48\u0e40\u0e2a\u0e23\u0e34\u0e21\u0e17\u0e31\u0e49\u0e07\u0e01\u0e32\u0e23\u0e42\u0e08\u0e21\u0e15\u0e35\u0e41\u0e25\u0e30\u0e01\u0e32\u0e23\u0e1b\u0e49\u0e2d\u0e07\u0e01\u0e31\u0e19 \u0e17\u0e31\u0e01\u0e29\u0e30 '\u0e01\u0e32\u0e23\u0e1d\u0e36\u0e01\u0e1d\u0e19\u0e14\u0e32\u0e1a' \u0e40\u0e1e\u0e34\u0e48\u0e21\u0e04\u0e27\u0e32\u0e21\u0e40\u0e2a\u0e35\u0e22\u0e2b\u0e32\u0e22\u0e08\u0e32\u0e01\u0e01\u0e32\u0e23\u0e42\u0e08\u0e21\u0e15\u0e35\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13 \u0e43\u0e19\u0e02\u0e13\u0e30\u0e17\u0e35\u0e48 '\u0e17\u0e48\u0e32\u0e17\u0e32\u0e07\u0e1b\u0e49\u0e2d\u0e07\u0e01\u0e31\u0e19' \u0e25\u0e14\u0e04\u0e27\u0e32\u0e21\u0e40\u0e2a\u0e35\u0e22\u0e2b\u0e32\u0e22\u0e17\u0e35\u0e48\u0e44\u0e14\u0e49\u0e23\u0e31\u0e1a \u0e19\u0e2d\u0e01\u0e08\u0e32\u0e01\u0e19\u0e35\u0e49 '\u0e01\u0e32\u0e23\u0e1f\u0e37\u0e49\u0e19\u0e1f\u0e39\u0e2a\u0e41\u0e15\u0e21\u0e34\u0e19\u0e32' \u0e40\u0e1b\u0e47\u0e19\u0e2a\u0e34\u0e48\u0e07\u0e2a\u0e33\u0e04\u0e31\u0e0d\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e01\u0e32\u0e23\u0e15\u0e48\u0e2d\u0e2a\u0e39\u0e49\u0e40\u0e1b\u0e47\u0e19\u0e40\u0e27\u0e25\u0e32\u0e19\u0e32\u0e19 \u0e15\u0e31\u0e27\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e40\u0e0a\u0e48\u0e19 \u0e01\u0e32\u0e23\u0e2d\u0e31\u0e1e\u0e40\u0e01\u0e23\u0e14 '\u0e01\u0e32\u0e23\u0e1d\u0e36\u0e01\u0e1d\u0e19\u0e14\u0e32\u0e1a' \u0e2a\u0e39\u0e07\u0e02\u0e36\u0e49\u0e19\u0e16\u0e36\u0e07\u0e23\u0e30\u0e14\u0e31\u0e1a 3 \u0e43\u0e19\u0e0a\u0e48\u0e27\u0e07\u0e15\u0e49\u0e19\u0e40\u0e01\u0e21\u0e2a\u0e32\u0e21\u0e32\u0e23\u0e16\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e1b\u0e23\u0e30\u0e2a\u0e34\u0e17\u0e18\u0e34\u0e20\u0e32\u0e1e\u0e01\u0e32\u0e23\u0e15\u0e48\u0e2d\u0e2a\u0e39\u0e49\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e21\u0e32\u0e01 [\u0e41\u0e1c\u0e19\u0e1c\u0e31\u0e07\u0e01\u0e32\u0e23\u0e17\u0e33\u0e07\u0e32\u0e19: \u0e15\u0e49\u0e19\u0e44\u0e21\u0e49\u0e17\u0e31\u0e01\u0e29\u0e30 \u2192 \u0e01\u0e32\u0e23\u0e42\u0e08\u0e21\u0e15\u0e35 \u2192 \u0e01\u0e32\u0e23\u0e1d\u0e36\u0e01\u0e1d\u0e19\u0e14\u0e32\u0e1a \u2192 \u0e40\u0e25\u0e40\u0e27\u0e25\u0e2d\u0e31\u0e1e \u2192 \u0e04\u0e27\u0e32\u0e21\u0e40\u0e2a\u0e35\u0e22\u0e2b\u0e32\u0e22\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e02\u0e36\u0e49\u0e19]"}, {"question": "\u0e23\u0e30\u0e1a\u0e1a\u0e01\u0e32\u0e23\u0e2d\u0e31\u0e1e\u0e40\u0e01\u0e23\u0e14\u0e2d\u0e32\u0e27\u0e38\u0e18\u0e43\u0e19 Stick Epic Fighter \u0e17\u0e33\u0e07\u0e32\u0e19\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e44\u0e23?", "answer": "\u0e23\u0e30\u0e1a\u0e1a\u0e2d\u0e31\u0e1e\u0e40\u0e01\u0e23\u0e14\u0e2d\u0e32\u0e27\u0e38\u0e18\u0e43\u0e19 Stick Epic Fighter \u0e0a\u0e48\u0e27\u0e22\u0e43\u0e2b\u0e49\u0e04\u0e38\u0e13\u0e2a\u0e32\u0e21\u0e32\u0e23\u0e16\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e1e\u0e39\u0e19\u0e2d\u0e32\u0e27\u0e38\u0e18\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e42\u0e14\u0e22\u0e43\u0e0a\u0e49\u0e27\u0e31\u0e2a\u0e14\u0e38\u0e17\u0e35\u0e48\u0e23\u0e27\u0e1a\u0e23\u0e27\u0e21\u0e08\u0e32\u0e01\u0e28\u0e31\u0e15\u0e23\u0e39\u0e17\u0e35\u0e48\u0e40\u0e2d\u0e32\u0e0a\u0e19\u0e30\u0e41\u0e25\u0e30\u0e01\u0e25\u0e48\u0e2d\u0e07\u0e2a\u0e21\u0e1a\u0e31\u0e15\u0e34 \u0e2b\u0e32\u0e01\u0e15\u0e49\u0e2d\u0e07\u0e01\u0e32\u0e23\u0e2d\u0e31\u0e1e\u0e40\u0e01\u0e23\u0e14 \u0e43\u0e2b\u0e49\u0e44\u0e1b\u0e17\u0e35\u0e48\u0e0a\u0e48\u0e32\u0e07\u0e15\u0e35\u0e40\u0e2b\u0e25\u0e47\u0e01\u0e43\u0e19\u0e28\u0e39\u0e19\u0e22\u0e4c\u0e01\u0e25\u0e32\u0e07\u0e2b\u0e25\u0e31\u0e01\u0e41\u0e25\u0e30\u0e40\u0e25\u0e37\u0e2d\u0e01\u0e27\u0e48\u0e32\u0e04\u0e38\u0e13\u0e15\u0e49\u0e2d\u0e07\u0e01\u0e32\u0e23\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e1e\u0e39\u0e19\u0e2d\u0e32\u0e27\u0e38\u0e18\u0e43\u0e14 \u0e41\u0e15\u0e48\u0e25\u0e30\u0e01\u0e32\u0e23\u0e2d\u0e31\u0e1e\u0e40\u0e01\u0e23\u0e14\u0e08\u0e30\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e04\u0e48\u0e32\u0e1e\u0e37\u0e49\u0e19\u0e10\u0e32\u0e19\u0e02\u0e2d\u0e07\u0e2d\u0e32\u0e27\u0e38\u0e18 \u0e40\u0e0a\u0e48\u0e19 \u0e1e\u0e25\u0e31\u0e07\u0e42\u0e08\u0e21\u0e15\u0e35\u0e41\u0e25\u0e30\u0e42\u0e2d\u0e01\u0e32\u0e2a\u0e27\u0e34\u0e01\u0e24\u0e15\u0e34 \u0e15\u0e31\u0e27\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e40\u0e0a\u0e48\u0e19 \u0e01\u0e32\u0e23\u0e2d\u0e31\u0e1e\u0e40\u0e01\u0e23\u0e14 '\u0e14\u0e32\u0e1a\u0e40\u0e2b\u0e25\u0e47\u0e01' \u0e40\u0e1b\u0e47\u0e19\u0e23\u0e30\u0e14\u0e31\u0e1a 2 \u0e08\u0e30\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e1e\u0e25\u0e31\u0e07\u0e42\u0e08\u0e21\u0e15\u0e35\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e02\u0e36\u0e49\u0e19 15% [\u0e15\u0e32\u0e23\u0e32\u0e07\u0e2d\u0e49\u0e32\u0e07\u0e2d\u0e34\u0e07: \u0e14\u0e32\u0e1a\u0e40\u0e2b\u0e25\u0e47\u0e01 \u0e23\u0e30\u0e14\u0e31\u0e1a 1: \u0e1e\u0e25\u0e31\u0e07\u0e42\u0e08\u0e21\u0e15\u0e35 50, \u0e23\u0e30\u0e14\u0e31\u0e1a 2: 65, \u0e23\u0e30\u0e14\u0e31\u0e1a 3: 80]"}, {"question": "\u0e04\u0e27\u0e32\u0e21\u0e41\u0e15\u0e01\u0e15\u0e48\u0e32\u0e07\u0e2b\u0e25\u0e31\u0e01\u0e23\u0e30\u0e2b\u0e27\u0e48\u0e32\u0e07\u0e42\u0e2b\u0e21\u0e14\u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19\u0e40\u0e14\u0e35\u0e48\u0e22\u0e27\u0e41\u0e25\u0e30\u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19\u0e2b\u0e25\u0e32\u0e22\u0e04\u0e19\u0e43\u0e19 Stick Epic Fighter \u0e04\u0e37\u0e2d\u0e2d\u0e30\u0e44\u0e23?", "answer": "\u0e42\u0e2b\u0e21\u0e14\u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19\u0e40\u0e14\u0e35\u0e48\u0e22\u0e27\u0e43\u0e19 Stick Epic Fighter \u0e40\u0e19\u0e49\u0e19\u0e40\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e23\u0e32\u0e27\u0e41\u0e1a\u0e1a\u0e40\u0e2a\u0e49\u0e19\u0e15\u0e23\u0e07\u0e17\u0e35\u0e48\u0e21\u0e35\u0e04\u0e27\u0e32\u0e21\u0e17\u0e49\u0e32\u0e17\u0e32\u0e22\u0e17\u0e35\u0e48\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e02\u0e36\u0e49\u0e19\u0e40\u0e23\u0e37\u0e48\u0e2d\u0e22\u0e46 \u0e43\u0e19\u0e02\u0e13\u0e30\u0e17\u0e35\u0e48\u0e42\u0e2b\u0e21\u0e14\u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19\u0e2b\u0e25\u0e32\u0e22\u0e04\u0e19\u0e19\u0e33\u0e40\u0e2a\u0e19\u0e2d\u0e01\u0e32\u0e23\u0e40\u0e25\u0e48\u0e19\u0e41\u0e1a\u0e1a\u0e23\u0e48\u0e27\u0e21\u0e21\u0e37\u0e2d\u0e41\u0e25\u0e30\u0e41\u0e02\u0e48\u0e07\u0e02\u0e31\u0e19 \u0e43\u0e19\u0e42\u0e2b\u0e21\u0e14\u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19\u0e2b\u0e25\u0e32\u0e22\u0e04\u0e19 \u0e04\u0e38\u0e13\u0e2a\u0e32\u0e21\u0e32\u0e23\u0e16\u0e23\u0e48\u0e27\u0e21\u0e17\u0e35\u0e21\u0e01\u0e31\u0e1a\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e19\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e15\u0e48\u0e2d\u0e2a\u0e39\u0e49\u0e01\u0e31\u0e1a\u0e14\u0e31\u0e19\u0e40\u0e08\u0e35\u0e49\u0e22\u0e19\u0e17\u0e35\u0e48\u0e22\u0e32\u0e01\u0e25\u0e33\u0e1a\u0e32\u0e01\u0e2b\u0e23\u0e37\u0e2d\u0e40\u0e02\u0e49\u0e32\u0e2a\u0e39\u0e48\u0e01\u0e32\u0e23\u0e15\u0e48\u0e2d\u0e2a\u0e39\u0e49\u0e41\u0e1a\u0e1a\u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19\u0e01\u0e31\u0e1a\u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19 \u0e15\u0e31\u0e27\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e40\u0e0a\u0e48\u0e19 \u0e42\u0e2b\u0e21\u0e14 '\u0e14\u0e31\u0e19\u0e40\u0e08\u0e35\u0e49\u0e22\u0e19\u0e23\u0e48\u0e27\u0e21\u0e21\u0e37\u0e2d' \u0e15\u0e49\u0e2d\u0e07\u0e01\u0e32\u0e23\u0e01\u0e32\u0e23\u0e17\u0e33\u0e07\u0e32\u0e19\u0e40\u0e1b\u0e47\u0e19\u0e17\u0e35\u0e21\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e40\u0e2d\u0e32\u0e0a\u0e19\u0e30\u0e1a\u0e2d\u0e2a\u0e17\u0e35\u0e48\u0e17\u0e23\u0e07\u0e1e\u0e25\u0e31\u0e07 \u0e43\u0e19\u0e02\u0e13\u0e30\u0e17\u0e35\u0e48 '\u0e01\u0e32\u0e23\u0e15\u0e48\u0e2d\u0e2a\u0e39\u0e49\u0e43\u0e19\u0e2a\u0e19\u0e32\u0e21\u0e1b\u0e23\u0e30\u0e25\u0e2d\u0e07' \u0e08\u0e30\u0e19\u0e33\u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19\u0e21\u0e32\u0e15\u0e48\u0e2d\u0e2a\u0e39\u0e49\u0e01\u0e31\u0e19\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e17\u0e14\u0e2a\u0e2d\u0e1a\u0e1d\u0e35\u0e21\u0e37\u0e2d [\u0e01\u0e32\u0e23\u0e40\u0e1b\u0e23\u0e35\u0e22\u0e1a\u0e40\u0e17\u0e35\u0e22\u0e1a\u0e15\u0e31\u0e27\u0e40\u0e25\u0e37\u0e2d\u0e01: \u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19\u0e40\u0e14\u0e35\u0e48\u0e22\u0e27: \u0e40\u0e19\u0e49\u0e19\u0e40\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e23\u0e32\u0e27, \u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19\u0e2b\u0e25\u0e32\u0e22\u0e04\u0e19: \u0e40\u0e19\u0e49\u0e19\u0e17\u0e35\u0e21\u0e2b\u0e23\u0e37\u0e2d\u0e01\u0e32\u0e23\u0e41\u0e02\u0e48\u0e07\u0e02\u0e31\u0e19]"}, {"question": "\u0e09\u0e31\u0e19\u0e08\u0e30\u0e16\u0e48\u0e32\u0e22\u0e42\u0e2d\u0e19\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e1a\u0e31\u0e19\u0e17\u0e36\u0e01\u0e08\u0e32\u0e01\u0e1e\u0e35\u0e0b\u0e35\u0e44\u0e1b\u0e22\u0e31\u0e07\u0e21\u0e37\u0e2d\u0e16\u0e37\u0e2d\u0e43\u0e19 Stick Epic Fighter \u0e44\u0e14\u0e49\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e44\u0e23?", "answer": "\u0e43\u0e19\u0e01\u0e32\u0e23\u0e16\u0e48\u0e32\u0e22\u0e42\u0e2d\u0e19\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e1a\u0e31\u0e19\u0e17\u0e36\u0e01\u0e08\u0e32\u0e01\u0e1e\u0e35\u0e0b\u0e35\u0e44\u0e1b\u0e22\u0e31\u0e07\u0e21\u0e37\u0e2d\u0e16\u0e37\u0e2d\u0e43\u0e19 Stick Epic Fighter \u0e42\u0e1b\u0e23\u0e14\u0e17\u0e33\u0e15\u0e32\u0e21\u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e40\u0e2b\u0e25\u0e48\u0e32\u0e19\u0e35\u0e49: \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 1: \u0e15\u0e23\u0e27\u0e08\u0e2a\u0e2d\u0e1a\u0e43\u0e2b\u0e49\u0e41\u0e19\u0e48\u0e43\u0e08\u0e27\u0e48\u0e32\u0e04\u0e38\u0e13\u0e40\u0e02\u0e49\u0e32\u0e2a\u0e39\u0e48\u0e23\u0e30\u0e1a\u0e1a\u0e14\u0e49\u0e27\u0e22\u0e1a\u0e31\u0e0d\u0e0a\u0e35\u0e40\u0e14\u0e35\u0e22\u0e27\u0e01\u0e31\u0e19\u0e17\u0e31\u0e49\u0e07\u0e2a\u0e2d\u0e07\u0e41\u0e1e\u0e25\u0e15\u0e1f\u0e2d\u0e23\u0e4c\u0e21 \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 2: \u0e43\u0e19\u0e40\u0e27\u0e2d\u0e23\u0e4c\u0e0a\u0e31\u0e19\u0e1e\u0e35\u0e0b\u0e35 \u0e43\u0e2b\u0e49\u0e44\u0e1b\u0e17\u0e35\u0e48\u0e40\u0e21\u0e19\u0e39 '\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e1a\u0e31\u0e19\u0e17\u0e36\u0e01' \u0e41\u0e25\u0e30\u0e40\u0e25\u0e37\u0e2d\u0e01\u0e23\u0e32\u0e22\u0e01\u0e32\u0e23 '\u0e2d\u0e31\u0e1b\u0e42\u0e2b\u0e25\u0e14\u0e44\u0e1b\u0e22\u0e31\u0e07\u0e04\u0e25\u0e32\u0e27\u0e14\u0e4c' \u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e35\u0e48 3: \u0e43\u0e19\u0e40\u0e27\u0e2d\u0e23\u0e4c\u0e0a\u0e31\u0e19\u0e21\u0e37\u0e2d\u0e16\u0e37\u0e2d \u0e43\u0e2b\u0e49\u0e44\u0e1b\u0e17\u0e35\u0e48\u0e40\u0e21\u0e19\u0e39\u0e40\u0e14\u0e35\u0e22\u0e27\u0e01\u0e31\u0e19\u0e41\u0e25\u0e30\u0e40\u0e25\u0e37\u0e2d\u0e01\u0e23\u0e32\u0e22\u0e01\u0e32\u0e23 '\u0e14\u0e32\u0e27\u0e19\u0e4c\u0e42\u0e2b\u0e25\u0e14\u0e08\u0e32\u0e01\u0e04\u0e25\u0e32\u0e27\u0e14\u0e4c' \u0e15\u0e31\u0e27\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e40\u0e0a\u0e48\u0e19 \u0e27\u0e34\u0e18\u0e35\u0e19\u0e35\u0e49\u0e08\u0e30\u0e0a\u0e48\u0e27\u0e22\u0e43\u0e2b\u0e49\u0e04\u0e38\u0e13\u0e14\u0e33\u0e40\u0e19\u0e34\u0e19\u0e04\u0e27\u0e32\u0e21\u0e04\u0e37\u0e1a\u0e2b\u0e19\u0e49\u0e32\u0e02\u0e2d\u0e07\u0e40\u0e01\u0e21\u0e44\u0e14\u0e49\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e15\u0e48\u0e2d\u0e40\u0e19\u0e37\u0e48\u0e2d\u0e07\u0e40\u0e21\u0e37\u0e48\u0e2d\u0e04\u0e38\u0e13\u0e40\u0e1b\u0e25\u0e35\u0e48\u0e22\u0e19\u0e2d\u0e38\u0e1b\u0e01\u0e23\u0e13\u0e4c [\u0e15\u0e31\u0e27\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e01\u0e32\u0e23\u0e40\u0e1b\u0e23\u0e35\u0e22\u0e1a\u0e40\u0e17\u0e35\u0e22\u0e1a: \u0e25\u0e2d\u0e07\u0e19\u0e36\u0e01\u0e20\u0e32\u0e1e\u0e40\u0e2b\u0e21\u0e37\u0e2d\u0e19\u0e22\u0e49\u0e32\u0e22\u0e02\u0e2d\u0e07\u0e43\u0e0a\u0e49\u0e08\u0e32\u0e01\u0e1a\u0e49\u0e32\u0e19\u0e2b\u0e19\u0e36\u0e48\u0e07\u0e44\u0e1b\u0e2d\u0e35\u0e01\u0e1a\u0e49\u0e32\u0e19\u0e2b\u0e19\u0e36\u0e48\u0e07 \u2013 \u0e40\u0e1e\u0e35\u0e22\u0e07\u0e2d\u0e31\u0e1b\u0e42\u0e2b\u0e25\u0e14\u0e41\u0e25\u0e30\u0e14\u0e32\u0e27\u0e19\u0e4c\u0e42\u0e2b\u0e25\u0e14]"}, {"question": "\u0e09\u0e31\u0e19\u0e08\u0e30\u0e2b\u0e32\u0e44\u0e02\u0e48\u0e1b\u0e32\u0e2a\u0e01\u0e32\u0e17\u0e35\u0e48\u0e0b\u0e48\u0e2d\u0e19\u0e2d\u0e22\u0e39\u0e48\u0e43\u0e19 Stick Epic Fighter \u0e44\u0e14\u0e49\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e44\u0e23?", "answer": "Stick Epic Fighter \u0e40\u0e15\u0e47\u0e21\u0e44\u0e1b\u0e14\u0e49\u0e27\u0e22\u0e44\u0e02\u0e48\u0e1b\u0e32\u0e2a\u0e01\u0e32\u0e17\u0e35\u0e48\u0e23\u0e2d\u0e43\u0e2b\u0e49\u0e04\u0e38\u0e13\u0e04\u0e49\u0e19\u0e1e\u0e1a\u0e41\u0e25\u0e30\u0e44\u0e14\u0e49\u0e23\u0e31\u0e1a\u0e23\u0e32\u0e07\u0e27\u0e31\u0e25\u0e08\u0e32\u0e01\u0e01\u0e32\u0e23\u0e2a\u0e33\u0e23\u0e27\u0e08 \u0e2b\u0e19\u0e36\u0e48\u0e07\u0e43\u0e19\u0e44\u0e02\u0e48\u0e1b\u0e32\u0e2a\u0e01\u0e32\u0e17\u0e35\u0e48\u0e19\u0e48\u0e32\u0e2a\u0e19\u0e43\u0e08\u0e04\u0e37\u0e2d '\u0e2b\u0e49\u0e2d\u0e07\u0e25\u0e31\u0e1a' \u0e43\u0e19\u0e23\u0e30\u0e14\u0e31\u0e1a '\u0e1b\u0e48\u0e32\u0e40\u0e07\u0e32' \u0e2b\u0e32\u0e01\u0e15\u0e49\u0e2d\u0e07\u0e01\u0e32\u0e23\u0e2b\u0e32\u0e43\u0e2b\u0e49\u0e21\u0e2d\u0e07\u0e2b\u0e32\u0e2a\u0e27\u0e34\u0e15\u0e0a\u0e4c\u0e0b\u0e48\u0e2d\u0e19\u0e2d\u0e22\u0e39\u0e48\u0e2b\u0e25\u0e31\u0e07\u0e15\u0e49\u0e19\u0e44\u0e21\u0e49 \u0e0b\u0e36\u0e48\u0e07\u0e08\u0e30\u0e40\u0e1b\u0e34\u0e14\u0e1b\u0e23\u0e30\u0e15\u0e39\u0e44\u0e1b\u0e2a\u0e39\u0e48\u0e2b\u0e49\u0e2d\u0e07\u0e17\u0e35\u0e48\u0e21\u0e35\u0e02\u0e2d\u0e07\u0e27\u0e34\u0e40\u0e28\u0e29\u0e2b\u0e32\u0e22\u0e32\u0e01 \u0e2d\u0e35\u0e01\u0e2b\u0e19\u0e36\u0e48\u0e07\u0e44\u0e02\u0e48\u0e1b\u0e32\u0e2a\u0e01\u0e32\u0e04\u0e37\u0e2d '\u0e2b\u0e21\u0e32\u0e22\u0e40\u0e2b\u0e15\u0e38\u0e02\u0e2d\u0e07\u0e19\u0e31\u0e01\u0e1e\u0e31\u0e12\u0e19\u0e32' \u0e17\u0e35\u0e48\u0e1e\u0e1a\u0e43\u0e19\u0e23\u0e30\u0e14\u0e31\u0e1a '\u0e01\u0e33\u0e41\u0e1e\u0e07\u0e1b\u0e23\u0e32\u0e2a\u0e32\u0e17\u0e17\u0e35\u0e48\u0e1e\u0e31\u0e07' \u0e0b\u0e36\u0e48\u0e07\u0e43\u0e2b\u0e49\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e40\u0e0a\u0e34\u0e07\u0e25\u0e36\u0e01\u0e23\u0e30\u0e2b\u0e27\u0e48\u0e32\u0e07\u0e01\u0e32\u0e23\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e40\u0e01\u0e21 [\u0e01\u0e32\u0e23\u0e04\u0e49\u0e19\u0e2b\u0e32\u0e44\u0e02\u0e48\u0e1b\u0e32\u0e2a\u0e01\u0e32: \u0e2b\u0e49\u0e2d\u0e07\u0e25\u0e31\u0e1a \u2192 \u0e2a\u0e27\u0e34\u0e15\u0e0a\u0e4c\u0e0b\u0e48\u0e2d\u0e19 \u2192 \u0e02\u0e2d\u0e07\u0e27\u0e34\u0e40\u0e28\u0e29\u0e2b\u0e32\u0e22\u0e32\u0e01, \u0e2b\u0e21\u0e32\u0e22\u0e40\u0e2b\u0e15\u0e38\u0e02\u0e2d\u0e07\u0e19\u0e31\u0e01\u0e1e\u0e31\u0e12\u0e19\u0e32 \u2192 \u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e40\u0e0a\u0e34\u0e07\u0e25\u0e36\u0e01\u0e43\u0e19\u0e01\u0e32\u0e23\u0e1e\u0e31\u0e12\u0e19\u0e32\u0e40\u0e01\u0e21]"}, {"question": "\u0e09\u0e31\u0e19\u0e08\u0e30\u0e1b\u0e23\u0e31\u0e1a\u0e1b\u0e23\u0e38\u0e07\u0e2a\u0e16\u0e34\u0e15\u0e34\u0e15\u0e31\u0e27\u0e25\u0e30\u0e04\u0e23\u0e02\u0e2d\u0e07\u0e09\u0e31\u0e19\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e01\u0e32\u0e23\u0e40\u0e25\u0e48\u0e19\u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19\u0e15\u0e48\u0e2d\u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19\u0e43\u0e19 Stick Epic Fighter \u0e44\u0e14\u0e49\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e44\u0e23?", "answer": "\u0e01\u0e32\u0e23\u0e1b\u0e23\u0e31\u0e1a\u0e1b\u0e23\u0e38\u0e07\u0e2a\u0e16\u0e34\u0e15\u0e34\u0e15\u0e31\u0e27\u0e25\u0e30\u0e04\u0e23\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e01\u0e32\u0e23\u0e40\u0e25\u0e48\u0e19\u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19\u0e15\u0e48\u0e2d\u0e1c\u0e39\u0e49\u0e40\u0e25\u0e48\u0e19\u0e43\u0e19 Stick Epic Fighter \u0e19\u0e31\u0e49\u0e19\u0e15\u0e49\u0e2d\u0e07\u0e21\u0e38\u0e48\u0e07\u0e40\u0e19\u0e49\u0e19\u0e17\u0e35\u0e48\u0e04\u0e27\u0e32\u0e21\u0e27\u0e48\u0e2d\u0e07\u0e44\u0e27\u0e41\u0e25\u0e30\u0e42\u0e2d\u0e01\u0e32\u0e2a\u0e27\u0e34\u0e01\u0e24\u0e15\u0e34 \u0e04\u0e27\u0e32\u0e21\u0e27\u0e48\u0e2d\u0e07\u0e44\u0e27\u0e0a\u0e48\u0e27\u0e22\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e04\u0e27\u0e32\u0e21\u0e40\u0e23\u0e47\u0e27\u0e43\u0e19\u0e01\u0e32\u0e23\u0e40\u0e04\u0e25\u0e37\u0e48\u0e2d\u0e19\u0e17\u0e35\u0e48\u0e41\u0e25\u0e30\u0e1b\u0e23\u0e30\u0e2a\u0e34\u0e17\u0e18\u0e34\u0e20\u0e32\u0e1e\u0e01\u0e32\u0e23\u0e2b\u0e25\u0e1a \u0e43\u0e19\u0e02\u0e13\u0e30\u0e17\u0e35\u0e48\u0e42\u0e2d\u0e01\u0e32\u0e2a\u0e27\u0e34\u0e01\u0e24\u0e15\u0e34\u0e0a\u0e48\u0e27\u0e22\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e1c\u0e25\u0e01\u0e23\u0e30\u0e17\u0e1a\u0e08\u0e32\u0e01\u0e01\u0e32\u0e23\u0e42\u0e08\u0e21\u0e15\u0e35\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13 \u0e40\u0e15\u0e23\u0e35\u0e22\u0e21\u0e2d\u0e38\u0e1b\u0e01\u0e23\u0e13\u0e4c\u0e17\u0e35\u0e48\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e2a\u0e16\u0e34\u0e15\u0e34\u0e40\u0e2b\u0e25\u0e48\u0e32\u0e19\u0e35\u0e49 \u0e40\u0e0a\u0e48\u0e19 '\u0e23\u0e2d\u0e07\u0e40\u0e17\u0e49\u0e32\u0e27\u0e34\u0e48\u0e07\u0e40\u0e23\u0e47\u0e27' \u0e41\u0e25\u0e30 '\u0e16\u0e38\u0e07\u0e21\u0e37\u0e2d\u0e27\u0e34\u0e01\u0e24\u0e15\u0e34' \u0e15\u0e31\u0e27\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e40\u0e0a\u0e48\u0e19 \u0e01\u0e32\u0e23\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e41\u0e1a\u0e1a\u0e21\u0e35\u0e04\u0e48\u0e32\u0e04\u0e27\u0e32\u0e21\u0e27\u0e48\u0e2d\u0e07\u0e44\u0e27\u0e2a\u0e39\u0e07\u0e0a\u0e48\u0e27\u0e22\u0e43\u0e2b\u0e49\u0e04\u0e38\u0e13\u0e2b\u0e25\u0e35\u0e01\u0e40\u0e25\u0e35\u0e48\u0e22\u0e07\u0e01\u0e32\u0e23\u0e15\u0e48\u0e2d\u0e2a\u0e39\u0e49\u0e01\u0e31\u0e1a\u0e04\u0e39\u0e48\u0e15\u0e48\u0e2d\u0e2a\u0e39\u0e49\u0e43\u0e19\u0e42\u0e2b\u0e21\u0e14 '\u0e01\u0e32\u0e23\u0e15\u0e48\u0e2d\u0e2a\u0e39\u0e49\u0e43\u0e19\u0e2a\u0e19\u0e32\u0e21\u0e1b\u0e23\u0e30\u0e25\u0e2d\u0e07' [\u0e15\u0e32\u0e23\u0e32\u0e07\u0e2d\u0e49\u0e32\u0e07\u0e2d\u0e34\u0e07: \u0e23\u0e2d\u0e07\u0e40\u0e17\u0e49\u0e32\u0e27\u0e34\u0e48\u0e07\u0e40\u0e23\u0e47\u0e27: \u0e40\u0e1e\u0e34\u0e48\u0e21\u0e04\u0e27\u0e32\u0e21\u0e27\u0e48\u0e2d\u0e07\u0e44\u0e27 +10, \u0e16\u0e38\u0e07\u0e21\u0e37\u0e2d\u0e27\u0e34\u0e01\u0e24\u0e15\u0e34: \u0e40\u0e1e\u0e34\u0e48\u0e21\u0e42\u0e2d\u0e01\u0e32\u0e2a\u0e27\u0e34\u0e01\u0e24\u0e15\u0e34 +15%]"}, {"question": "\u0e40\u0e17\u0e04\u0e19\u0e34\u0e04\u0e04\u0e27\u0e1a\u0e04\u0e38\u0e21\u0e1d\u0e39\u0e07\u0e0a\u0e19\u0e17\u0e35\u0e48\u0e21\u0e35\u0e1b\u0e23\u0e30\u0e2a\u0e34\u0e17\u0e18\u0e34\u0e20\u0e32\u0e1e\u0e17\u0e35\u0e48\u0e2a\u0e38\u0e14\u0e43\u0e19 Stick Epic Fighter \u0e04\u0e37\u0e2d\u0e2d\u0e30\u0e44\u0e23?", "answer": "\u0e40\u0e17\u0e04\u0e19\u0e34\u0e04\u0e04\u0e27\u0e1a\u0e04\u0e38\u0e21\u0e1d\u0e39\u0e07\u0e0a\u0e19\u0e17\u0e35\u0e48\u0e21\u0e35\u0e1b\u0e23\u0e30\u0e2a\u0e34\u0e17\u0e18\u0e34\u0e20\u0e32\u0e1e\u0e43\u0e19 Stick Epic Fighter \u0e44\u0e14\u0e49\u0e41\u0e01\u0e48 \u0e01\u0e32\u0e23\u0e43\u0e0a\u0e49\u0e01\u0e32\u0e23\u0e42\u0e08\u0e21\u0e15\u0e35\u0e41\u0e1a\u0e1a\u0e04\u0e23\u0e2d\u0e1a\u0e04\u0e25\u0e38\u0e21\u0e1e\u0e37\u0e49\u0e19\u0e17\u0e35\u0e48 (AoE) \u0e41\u0e25\u0e30\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e32\u0e21\u0e32\u0e23\u0e16\u0e43\u0e19\u0e01\u0e32\u0e23\u0e0a\u0e30\u0e07\u0e31\u0e01\u0e07\u0e31\u0e19 \u0e17\u0e31\u0e01\u0e29\u0e30 '\u0e01\u0e32\u0e23\u0e1f\u0e31\u0e19\u0e27\u0e19' \u0e19\u0e31\u0e49\u0e19\u0e21\u0e35\u0e1b\u0e23\u0e30\u0e42\u0e22\u0e0a\u0e19\u0e4c\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e22\u0e34\u0e48\u0e07\u0e43\u0e19\u0e01\u0e32\u0e23\u0e17\u0e33\u0e14\u0e32\u0e40\u0e21\u0e08\u0e01\u0e31\u0e1a\u0e28\u0e31\u0e15\u0e23\u0e39\u0e2b\u0e25\u0e32\u0e22\u0e15\u0e31\u0e27\u0e1e\u0e23\u0e49\u0e2d\u0e21\u0e46 \u0e01\u0e31\u0e19 \u0e43\u0e19\u0e02\u0e13\u0e30\u0e17\u0e35\u0e48\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e32\u0e21\u0e32\u0e23\u0e16 '\u0e01\u0e32\u0e23\u0e42\u0e08\u0e21\u0e15\u0e35\u0e0a\u0e30\u0e07\u0e31\u0e01\u0e07\u0e31\u0e19' \u0e2a\u0e32\u0e21\u0e32\u0e23\u0e16\u0e17\u0e33\u0e43\u0e2b\u0e49\u0e01\u0e25\u0e38\u0e48\u0e21\u0e28\u0e31\u0e15\u0e23\u0e39\u0e2b\u0e21\u0e14\u0e2a\u0e20\u0e32\u0e1e\u0e0a\u0e31\u0e48\u0e27\u0e04\u0e23\u0e32\u0e27 \u0e15\u0e31\u0e27\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e40\u0e0a\u0e48\u0e19 \u0e01\u0e32\u0e23\u0e43\u0e0a\u0e49 '\u0e01\u0e32\u0e23\u0e1f\u0e31\u0e19\u0e27\u0e19' \u0e43\u0e19\u0e23\u0e30\u0e14\u0e31\u0e1a '\u0e1d\u0e39\u0e07\u0e40\u0e07\u0e32' \u0e2a\u0e32\u0e21\u0e32\u0e23\u0e16\u0e40\u0e04\u0e25\u0e35\u0e22\u0e23\u0e4c\u0e2a\u0e19\u0e32\u0e21\u0e23\u0e1a\u0e44\u0e14\u0e49\u0e2d\u0e22\u0e48\u0e32\u0e07\u0e23\u0e27\u0e14\u0e40\u0e23\u0e47\u0e27 [\u0e01\u0e32\u0e23\u0e40\u0e1b\u0e23\u0e35\u0e22\u0e1a\u0e40\u0e17\u0e35\u0e22\u0e1a\u0e15\u0e31\u0e27\u0e40\u0e25\u0e37\u0e2d\u0e01: \u0e01\u0e32\u0e23\u0e1f\u0e31\u0e19\u0e27\u0e19: \u0e2d\u0e31\u0e19\u0e15\u0e23\u0e32\u0e22\u0e41\u0e1a\u0e1a\u0e04\u0e23\u0e2d\u0e1a\u0e04\u0e25\u0e38\u0e21\u0e1e\u0e37\u0e49\u0e19\u0e17\u0e35\u0e48, \u0e01\u0e32\u0e23\u0e42\u0e08\u0e21\u0e15\u0e35\u0e0a\u0e30\u0e07\u0e31\u0e01\u0e07\u0e31\u0e19: \u0e1b\u0e34\u0e14\u0e43\u0e0a\u0e49\u0e07\u0e32\u0e19\u0e0a\u0e31\u0e48\u0e27\u0e04\u0e23\u0e32\u0e27]"}]
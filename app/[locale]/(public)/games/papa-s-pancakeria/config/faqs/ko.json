[{"question": "\ud30c\ud30c\uc2a4 \ud32c\ucf00\uc774\ud06c \uac00\uac8c\uc5d0\uc11c \uc5ec\ub7ec \uac1c\uc758 \ud32c\ucf00\uc774\ud06c \uc8fc\ubb38\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud32c\ucf00\uc774\ud06c \uac00\uac8c\uc5d0\uc11c \uc5ec\ub7ec \uac1c\uc758 \ud32c\ucf00\uc774\ud06c \uc8fc\ubb38\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. \ub2e8\uacc4 1 - \uc8fc\ubb38\uc758 \ubcf5\uc7a1\uc131\uc744 \uae30\uc900\uc73c\ub85c \uc6b0\uc120\uc21c\uc704\ub97c \uc815\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2 - \ub300\uae30 \uc911\uc778 \uc8fc\ubb38\uc744 \ucd94\uc801\ud558\uae30 \uc704\ud574 '\ub300\uae30\uc5f4 \uc2dc\uc2a4\ud15c'\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3 - \uac01 \uc791\uc5c5\ub300(\uc608: \ud32c\ucf00\uc774\ud06c \ub4a4\uc9d1\uae30, \ud1a0\ud551 \ucd94\uac00)\uc5d0 \ud2b9\uc815 \uc791\uc5c5\uc744 \ud560\ub2f9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub300\ub7c9 \uc8fc\ubb38\uc744 \ucc98\ub9ac\ud560 \ub54c\ub294 \uba3c\uc800 \ubc18\uc8fd\uc744 \uc900\ube44\ud55c \ub2e4\uc74c \ub3d9\uc2dc\uc5d0 \uc694\ub9ac \ubc0f \ud1a0\ud551 \uc791\uc5c5\uc744 \uc9c4\ud589\ud558\uc138\uc694. \uc774 \ubc29\ubc95\uc744 \ud1b5\ud574 \uc6d0\ud65c\ud55c \uc791\uc5c5 \ud750\ub984\uc744 \ubcf4\uc7a5\ud558\uace0 \uc9c0\uc5f0 \uc2dc\uac04\uc744 \ucd5c\uc18c\ud654\ud569\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c\uc2a4 \ud32c\ucf00\uc774\ud06c \uac00\uac8c\uc5d0\uc11c \ub192\uc740 \uace0\uac1d \ub9cc\uc871\ub3c4 \uc810\uc218\ub97c \uc720\uc9c0\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud32c\ucf00\uc774\ud06c \uac00\uac8c\uc5d0\uc11c \ub192\uc740 \uace0\uac1d \ub9cc\uc871\ub3c4 \uc810\uc218\ub97c \uc720\uc9c0\ud558\ub294 \uac83\uc740 \uc218\uc775\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\uace0 \uc0c8\ub85c\uc6b4 \uae30\ub2a5\uc744 \ud574\uc81c\ud558\uae30 \ub54c\ubb38\uc5d0 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \ub9cc\uc871\uc2a4\ub7ec\uc6b4 \uace0\uac1d\uc740 \ub354\uc6b1 \ud48d\uc131\ud558\uac8c \ud301\uc744 \uc8fc\uace0 \uc7ac\ubc29\ubb38\ud560 \uac00\ub2a5\uc131\uc774 \ub192\uc544\uc9c0\ubbc0\ub85c \uc804\uccb4 \uc218\uc775\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4. \ub610\ud55c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc73c\uba74 \uc0c8\ub85c\uc6b4 \uc7ac\ub8cc \ubc0f \uc7a5\uc2dd\uc744 \ud574\uc81c\ud558\uc5ec \uac8c\uc784 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc644\ubcbd\ud558\uac8c \uc775\ud78c \ud32c\ucf00\uc774\ud06c\ub97c \uc815\ud655\ud55c \ud1a0\ud551\uacfc \ud568\uaed8 \uc9c0\uc18d\uc801\uc73c\ub85c \uc81c\uacf5\ud558\uba74 \uc810\uc218\uac00 \ud06c\uac8c \uc0c1\uc2b9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c\uc2a4 \ud32c\ucf00\uc774\ud06c \uac00\uac8c\uc5d0\uc11c \ub2e4\uc591\ud55c \ud32c\ucf00\uc774\ud06c \uc885\ub958 \uac04\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud32c\ucf00\uc774\ud06c \uac00\uac8c\uc5d0\uc11c \ub2e4\uc591\ud55c \ud32c\ucf00\uc774\ud06c \uc885\ub958 \uac04\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \uc870\ub9ac \uc2dc\uac04\uacfc \ud544\uc694\ud55c \ud1a0\ud551\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud074\ub798\uc2dd \ud32c\ucf00\uc774\ud06c\ub294 \ud0c0\uc9c0 \uc54a\ub3c4\ub85d \uc815\ud655\ud55c \uc2dc\uac04 \uc870\uc808\uc774 \ud544\uc694\ud558\uc9c0\ub9cc \uc870\ub9ac \uc2dc\uac04\uc740 \uc9e7\uc2b5\ub2c8\ub2e4. \ucd08\ucf5c\ub9bf\uce69\uacfc \uac19\uc740 \ud2b9\ubcc4 \ud32c\ucf00\uc774\ud06c\ub294 \ubc18\uc8fd\uc758 \ub18d\ub3c4\ub97c \uc2e0\uc911\ud558\uac8c \uad00\ucc30\ud574\uc57c \ud569\ub2c8\ub2e4. \uac01 \uc720\ud615\uc740 \ub610\ud55c \uc11c\ub85c \ub2e4\ub978 \uace0\uac1d \uc120\ud638\ub3c4\uc5d0 \ub9de\ub294 \uace0\uc720\ud55c \ud1a0\ud551 \uc870\ud569\uc744 \uac00\uc9c0\uace0 \uc788\uc5b4 \uc804\ubc18\uc801\uc778 \uc2dd\uc0ac \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c\uc2a4 \ud32c\ucf00\uc774\ud06c \uac00\uac8c\uc5d0\uc11c \uc7ac\ub8cc \uc0ac\uc6a9\uc744 \ucd5c\uc801\ud654\ud558\uc5ec \ub0ad\ube44\ub97c \uc904\uc774\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud32c\ucf00\uc774\ud06c \uac00\uac8c\uc5d0\uc11c \uc7ac\ub8cc \uc0ac\uc6a9\uc744 \ucd5c\uc801\ud654\ud558\uc5ec \ub0ad\ube44\ub97c \uc904\uc774\ub824\uba74 \uc804\ub7b5\uc801\uc778 \uacc4\ud68d \ubc0f \ud6a8\uc728\uc801\uc778 \uad00\ub9ac\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1 - \ud56d\uc0c1 \uc8fc\ubb38 \uc138\ubd80 \uc815\ubcf4\ub97c \ud655\uc778\ud558\uc5ec \ud544\uc694\ud55c \uc7ac\ub8cc\uc758 \uc815\ud655\ud55c \uc591\uc744 \ud30c\uc545\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2 - '\uc900\ube44\ub300'\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud5a5\ud6c4 \uc8fc\ubb38\uc5d0 \ud544\uc694\ud55c \uc7ac\ub8cc\ub97c \ubbf8\ub9ac \uacc4\ub7c9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3 - \uc7ac\ub8cc\uc758 \uc720\ud1b5 \uae30\ud55c\uc744 \uae30\uc900\uc73c\ub85c \uc7ac\ub8cc\ub97c \ud68c\uc804\uc2dc\ucf1c \ud488\uc9c8 \uc800\ud558\ub97c \ucd5c\uc18c\ud654\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc720\ud1b5 \uae30\ud55c\uc774 \uc9c0\ub098\uae30 \uc804\uc5d0 \uc2e0\uc120\ud55c \uacfc\uc77c\uc744 \uba3c\uc800 \uc0ac\uc6a9\ud558\uba74 \ub0ad\ube44\ub97c \ud06c\uac8c \uc904\uc774\uace0 \uc774\uc775\uc744 \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c\uc2a4 \ud32c\ucf00\uc774\ud06c \uac00\uac8c\uc5d0\uc11c \uc644\ubcbd\ud55c \uc810\uc218\ub97c \uc5bb\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ub294 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud32c\ucf00\uc774\ud06c \uac00\uac8c\uc5d0\uc11c \uc644\ubcbd\ud55c \uc810\uc218\ub97c \uc5bb\uc73c\ub824\uba74 \uba87 \uac00\uc9c0 \uc804\ub7b5\uc744 \uc219\ub2ec\ud574\uc57c \ud569\ub2c8\ub2e4. \ub2e8\uacc4 1 - \uc870\ub9ac \uacfc\uc815\uc5d0\uc11c \uc815\ud655\uc131\uc5d0 \uc9d1\uc911\ud558\uc5ec \ud32c\ucf00\uc774\ud06c\uac00 \ub35c \uc775\uac70\ub098 \ud0c0\uc9c0 \uc54a\ub3c4\ub85d \ud569\ub2c8\ub2e4. \ub2e8\uacc4 2 - \uace0\uac1d\uc758 \uc120\ud638\ub3c4\uc5d0 \uc8fc\uc758\ud558\uace0 \ub9de\ucda4\ud615 \uc8fc\ubb38\uc744 \ucc98\ub9ac\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3 - \uc9c0\uc5f0 \uc5c6\uc774 \uc5ec\ub7ec \uc8fc\ubb38\uc744 \ucc98\ub9ac\ud558\uae30 \uc704\ud574 \uc2dc\uac04\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc870\ub9ac \uc2dc\uac04\uc744 \ucd94\uc801\ud558\uae30 \uc704\ud55c \ud0c0\uc774\uba38\uc640 \ud1a0\ud551 \ubaa9\ub85d\uc744 \uc0ac\uc6a9\ud558\uba74 \uc9c0\uc18d\uc801\uc73c\ub85c \uc644\ubcbd\ud55c \uc8fc\ubb38\uc744 \uc81c\uacf5\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c\uc2a4 \ud32c\ucf00\uc774\ud06c \uac00\uac8c\uc758 \ud301 \uc2dc\uc2a4\ud15c \ub4a4\uc5d0 \uc228\uaca8\uc9c4 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud32c\ucf00\uc774\ud06c \uac00\uac8c\uc758 \ud301 \uc2dc\uc2a4\ud15c\uc740 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uba54\ucee4\ub2c8\uc998\uc5d0 \uc758\ud574 \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \uace0\uac1d\uc740 \uc8fc\ubb38\uc758 \uc815\ud655\uc131, \uc11c\ube44\uc2a4 \uc18d\ub3c4 \ubc0f \ud32c\ucf00\uc774\ud06c\uc758 \uc804\ubc18\uc801\uc778 \uc678\uad00\uc744 \uae30\uc900\uc73c\ub85c \ud301\uc744 \uc90d\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc694\uccad\ub41c \uc815\ud655\ud55c \ud1a0\ud551\uacfc \ud568\uaed8 \uc644\ubcbd\ud558\uac8c \uc775\ud78c \ud32c\ucf00\uc774\ud06c\ub97c \uc9e7\uc740 \uc2dc\uac04 \ub0b4\uc5d0 \uc81c\uacf5\ud558\uba74 \ub354 \ub192\uc740 \ud301\uc744 \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \ub9cc\uc871\ud55c \uace0\uac1d\uc758 \uc5f0\uc18d\uc131\uc744 \uc720\uc9c0\ud558\uba74 \ubcf4\ub108\uc2a4 \ud301\uc744 \ud574\uc81c\ud558\uc5ec \uc218\uc775\uc744 \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c\uc2a4 \ud32c\ucf00\uc774\ud06c \uac00\uac8c\uc5d0\uc11c \uc5b4\ub824\uc6c0\uc758 \ub09c\uc774\ub3c4\ub294 \uc5b4\ub5bb\uac8c \uc9c4\ud589\ub418\uba70 \uac01 \ub2e8\uacc4\uc5d0\uc11c \uc5b4\ub5a4 \uc810\uc744 \uae30\ub300\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud32c\ucf00\uc774\ud06c \uac00\uac8c\uc5d0\uc11c \ub09c\uc774\ub3c4\ub294 \uc810\uc9c4\uc801\uc73c\ub85c \uc9c4\ud589\ub418\uba70, \uac01 \ub2e8\uacc4\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \uacfc\uc81c\uac00 \ucd94\uac00\ub429\ub2c8\ub2e4. \ucc98\uc74c\uc5d0\ub294 \uae30\ubcf8 \ud1a0\ud551\uc744 \uc0ac\uc6a9\ud55c \uac04\ub2e8\ud55c \uc8fc\ubb38\uc744 \ucc98\ub9ac\ud569\ub2c8\ub2e4. \uc9c4\ud589\ud568\uc5d0 \ub530\ub77c \uac8c\uc784\uc740 \ub354 \ubcf5\uc7a1\ud55c \ub808\uc2dc\ud53c, \ub3d9\uc2dc \uc8fc\ubb38, \ub354\uc6b1 \uc5c4\uaca9\ud55c \uc2dc\uac04 \uc81c\uc57d\uc744 \uc18c\uac1c\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud6c4\ubc18 \ub2e8\uacc4\uc5d0\uc11c\ub294 \ud074\ub798\uc2dd \ud32c\ucf00\uc774\ud06c\uc640 \ud2b9\ubcc4 \ud32c\ucf00\uc774\ud06c\ub97c \ud63c\ud569 \uad00\ub9ac\ud574\uc57c \ud558\uba70, \uac01 \ud32c\ucf00\uc774\ud06c\uac00 \uc644\ubcbd\ud558\uac8c \uc775\ub3c4\ub85d \ud574\uc57c \ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc9c4\ud589 \ubc29\uc2dd\uc740 \uac8c\uc784\uc744 \uacc4\uc18d \ud765\ubbf8\ub86d\uac8c \ub9cc\ub4e4\uace0 \ub2e4\uc911 \uc791\uc5c5 \ub2a5\ub825\uc744 \ud14c\uc2a4\ud2b8\ud569\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c\uc2a4 \ud32c\ucf00\uc774\ud06c \uac00\uac8c\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\ub978 \uae30\uae30\ub85c \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c? \uc5b4\ub5bb\uac8c \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub124, \ud30c\ud30c\uc2a4 \ud32c\ucf00\uc774\ud06c \uac00\uac8c\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\ub978 \uae30\uae30\ub85c \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc73c\ub85c \uac8c\uc784 \uacc4\uc815\uc744 \ud074\ub77c\uc6b0\ub4dc \uc11c\ube44\uc2a4 \ub610\ub294 \uc18c\uc15c \ubbf8\ub514\uc5b4 \uacc4\uc815\uc5d0 \uc5f0\uacb0\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, iOS \uae30\uae30\uc5d0\uc11c \uac8c\uc784\uc744 \ud50c\ub808\uc774\ud558\ub294 \uacbd\uc6b0 iCloud\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub9c8\ucc2c\uac00\uc9c0\ub85c, \uc548\ub4dc\ub85c\uc774\ub4dc \uc0ac\uc6a9\uc790\ub294 Google Play \uac8c\uc784\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub370\uc774\ud130\ub97c \uc800\uc7a5\ud558\uace0 \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub97c \ud1b5\ud574 \uc131\uacfc, \ud574\uc81c\ub41c \uc544\uc774\ud15c \ubc0f \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc11c\ub85c \ub2e4\ub978 \uae30\uae30\uc5d0\uc11c \uc720\uc9c0\ub429\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c\uc2a4 \ud32c\ucf00\uc774\ud06c \uac00\uac8c\uc5d0\ub294 \ube44\ubc00 \uc7ac\ub8cc\ub098 \uc228\uaca8\uc9c4 \ub808\uc2dc\ud53c\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud32c\ucf00\uc774\ud06c \uac00\uac8c\uc5d0\ub294 \ud2b9\uc815 \uc131\uacfc\ub97c \ub2ec\uc131\ud558\uac70\ub098 \ud2b9\ubcc4\ud55c \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\uc5ec \ud574\uc81c\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc7ac\ub8cc\uc640 \uc228\uaca8\uc9c4 \ub808\uc2dc\ud53c\uac00 \uc5ec\ub7ec \uac00\uc9c0 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 50\uac1c\uc758 \uc644\ubcbd\ud55c \uc8fc\ubb38 \uc5f0\uc18d \uae30\ub85d\uc744 \ub2ec\uc131\ud558\uba74 \"\uace8\ub4e0 \uc2dc\ub7fd\"\uacfc \uac19\uc740 \ub3c5\ud2b9\ud55c \ud1a0\ud551\uc774 \ud574\uc81c\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uba87 \uac00\uc9c0 \uc228\uaca8\uc9c4 \ub808\uc2dc\ud53c\ub294 \ube44\uc815\uc0c1\uc801\uc778 \uc7ac\ub8cc \uc870\ud569 \uc2e4\ud5d8\uc744 \ud1b5\ud574 \ubc1c\uacac\ub418\uc5b4 \uac8c\uc784\uc5d0 \ub180\ub77c\uc6c0\uacfc \ucc3d\uc758\uc131\uc744 \ub354\ud569\ub2c8\ub2e4."}]
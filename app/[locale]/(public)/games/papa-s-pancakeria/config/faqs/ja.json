[{"question": "\u30d1\u30d1\u30ba\u30d1\u30f3\u30b1\u30fc\u30ad\u5c4b\u3067\u8907\u6570\u306e\u30d1\u30f3\u30b1\u30fc\u30ad\u6ce8\u6587\u3092\u52b9\u7387\u7684\u306b\u7ba1\u7406\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30ba\u30d1\u30f3\u30b1\u30fc\u30ad\u5c4b\u3067\u8907\u6570\u306e\u30d1\u30f3\u30b1\u30fc\u30ad\u6ce8\u6587\u3092\u52b9\u7387\u7684\u306b\u7ba1\u7406\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\uff1aSTEP1 - \u6ce8\u6587\u306e\u8907\u96d1\u3055\u306b\u3088\u3063\u3066\u512a\u5148\u9806\u4f4d\u3092\u4ed8\u3051\u307e\u3059\uff1bSTEP2 - \u5f85\u6a5f\u4e2d\u306e\u6ce8\u6587\u3092\u8ffd\u8de1\u3059\u308b\u305f\u3081\u306b\u300c\u30ad\u30e5\u30fc\u30b7\u30b9\u30c6\u30e0\u300d\u3092\u4f7f\u7528\u3057\u307e\u3059\uff1bSTEP3 - \u5404\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\uff08\u4f8b\u3048\u3070\u3001\u30d1\u30f3\u30b1\u30fc\u30ad\u3092\u3072\u3063\u304f\u308a\u8fd4\u3059\u3001\u30c8\u30c3\u30d4\u30f3\u30b0\u3092\u8ffd\u52a0\u3059\u308b\uff09\u306b\u7279\u5b9a\u306e\u30bf\u30b9\u30af\u3092\u5272\u308a\u5f53\u3066\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5927\u6ce8\u6587\u3092\u51e6\u7406\u3059\u308b\u5834\u5408\u3001\u307e\u305a\u751f\u5730\u306e\u5099\u3048\u4ed8\u3051\u306b\u7126\u70b9\u3092\u5f53\u3066\u3001\u6b21\u306b\u540c\u6642\u306b\u8abf\u7406\u3068\u30c8\u30c3\u30d4\u30f3\u30b0\u306b\u79fb\u308a\u307e\u3059\u3002\u3053\u306e\u65b9\u6cd5\u306b\u3088\u3063\u3066\u3001\u30b9\u30e0\u30fc\u30ba\u306a\u4f5c\u696d\u306e\u6d41\u308c\u304c\u78ba\u4fdd\u3055\u308c\u3001\u9045\u5ef6\u304c\u6700\u5c0f\u9650\u306b\u6291\u3048\u3089\u308c\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u30ba\u30d1\u30f3\u30b1\u30fc\u30ad\u5c4b\u3067\u9ad8\u3044\u9867\u5ba2\u6e80\u8db3\u5ea6\u3092\u7dad\u6301\u3059\u308b\u3053\u3068\u306f\u306a\u305c\u91cd\u8981\u306a\u306e\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30ba\u30d1\u30f3\u30b1\u30fc\u30ad\u5c4b\u3067\u9ad8\u3044\u9867\u5ba2\u6e80\u8db3\u5ea6\u3092\u7dad\u6301\u3059\u308b\u3053\u3068\u306f\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u306a\u305c\u306a\u3089\u3001\u305d\u308c\u306f\u76f4\u63a5\u53ce\u76ca\u306b\u5f71\u97ff\u3057\u3001\u65b0\u305f\u306a\u6a5f\u80fd\u306e\u30ed\u30c3\u30af\u3092\u89e3\u9664\u3059\u308b\u304b\u3089\u3067\u3059\u3002\u6e80\u8db3\u3057\u305f\u9867\u5ba2\u306f\u3088\u308a\u5bdb\u5927\u306b\u30c1\u30c3\u30d7\u3092\u304f\u308c\u307e\u3059\u3057\u3001\u307e\u305f\u30ea\u30d4\u30fc\u30c8\u3059\u308b\u53ef\u80fd\u6027\u304c\u9ad8\u304f\u306a\u308a\u3001\u5168\u4f53\u7684\u306a\u53ce\u76ca\u3092\u5897\u3084\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u9054\u6210\u3059\u308b\u3053\u3068\u3067\u3001\u65b0\u305f\u306a\u6750\u6599\u3084\u88c5\u98fe\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4f53\u9a13\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5b8c\u74a7\u306b\u713c\u304d\u4e0a\u3052\u305f\u30d1\u30f3\u30b1\u30fc\u30ad\u3092\u9069\u5207\u306a\u30c8\u30c3\u30d4\u30f3\u30b0\u3068\u5171\u306b\u63d0\u4f9b\u3059\u308b\u3053\u3068\u306b\u3088\u308a\u3001\u30b9\u30b3\u30a2\u3092\u5927\u5e45\u306b\u4e0a\u3052\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u30ba\u30d1\u30f3\u30b1\u30fc\u30ad\u5c4b\u3067\u3001\u69d8\u3005\u306a\u30d1\u30f3\u30b1\u30fc\u30ad\u306e\u7a2e\u985e\u9593\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30ba\u30d1\u30f3\u30b1\u30fc\u30ad\u5c4b\u3067\u3001\u69d8\u3005\u306a\u30d1\u30f3\u30b1\u30fc\u30ad\u306e\u7a2e\u985e\u9593\u306e\u4e3b\u306a\u9055\u3044\u306f\u3001\u8abf\u7406\u6642\u9593\u3068\u5fc5\u8981\u306a\u30c8\u30c3\u30d4\u30f3\u30b0\u306b\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30af\u30e9\u30b7\u30c3\u30af\u30d1\u30f3\u30b1\u30fc\u30ad\u306f\u8abf\u7406\u6642\u9593\u304c\u77ed\u3044\u304c\u3001\u713c\u304d\u7126\u3052\u3092\u9632\u3050\u305f\u3081\u306b\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u5fc5\u8981\u3067\u3059\u3002\u4e00\u65b9\u3001\u30c1\u30e7\u30b3\u30ec\u30fc\u30c8\u30c1\u30c3\u30d7\u306a\u3069\u306e\u30b9\u30da\u30b7\u30e3\u30eb\u30c6\u30a3\u30d1\u30f3\u30b1\u30fc\u30ad\u306f\u3001\u751f\u5730\u306e\u72b6\u614b\u3092\u6ce8\u610f\u6df1\u304f\u76e3\u8996\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u5404\u7a2e\u985e\u306b\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u9867\u5ba2\u306e\u597d\u307f\u306b\u5408\u308f\u305b\u305f\u72ec\u7279\u306a\u30c8\u30c3\u30d4\u30f3\u30b0\u306e\u7d44\u307f\u5408\u308f\u305b\u304c\u3042\u308a\u3001\u5168\u4f53\u7684\u306a\u98df\u4e8b\u4f53\u9a13\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u30ba\u30d1\u30f3\u30b1\u30fc\u30ad\u5c4b\u3067\u6750\u6599\u306e\u4f7f\u7528\u3092\u6700\u9069\u5316\u3057\u3066\u7121\u99c4\u3092\u6e1b\u3089\u3059\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30ba\u30d1\u30f3\u30b1\u30fc\u30ad\u5c4b\u3067\u6750\u6599\u306e\u4f7f\u7528\u3092\u6700\u9069\u5316\u3057\u3066\u7121\u99c4\u3092\u6e1b\u3089\u3059\u306b\u306f\u3001\u6226\u7565\u7684\u306a\u8a08\u753b\u3068\u52b9\u7387\u7684\u306a\u7ba1\u7406\u304c\u5fc5\u8981\u3067\u3059\u3002STEP1 - \u5e38\u306b\u6ce8\u6587\u306e\u8a73\u7d30\u3092\u78ba\u8a8d\u3057\u3066\u3001\u5fc5\u8981\u306a\u6750\u6599\u306e\u6b63\u78ba\u306a\u91cf\u3092\u6c7a\u5b9a\u3057\u307e\u3059\uff1bSTEP2 - \u8fd1\u3044\u5c06\u6765\u306e\u6ce8\u6587\u306e\u305f\u3081\u306b\u300c\u6e96\u5099\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u300d\u3092\u4f7f\u7528\u3057\u3066\u3001\u6750\u6599\u3092\u4e8b\u524d\u306b\u6e2c\u5b9a\u3057\u307e\u3059\uff1bSTEP3 - \u8cde\u5473\u671f\u9650\u306b\u57fa\u3065\u3044\u3066\u6750\u6599\u3092\u56de\u8ee2\u3055\u305b\u3001\u8150\u6557\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u307e\u3059\u3002 \u4f8b\u3048\u3070\u3001\u8cde\u5473\u671f\u9650\u5207\u308c\u306b\u306a\u308b\u524d\u306b\u65b0\u9bae\u306a\u30d5\u30eb\u30fc\u30c4\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u7121\u99c4\u3092\u5927\u5e45\u306b\u524a\u6e1b\u3057\u3001\u5229\u76ca\u7387\u3092\u4e0a\u3052\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u30ba\u30d1\u30f3\u30b1\u30fc\u30ad\u5c4b\u3067\u5b8c\u74a7\u306a\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u305f\u3081\u306b\u3069\u306e\u3088\u3046\u306a\u6226\u7565\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30ba\u30d1\u30f3\u30b1\u30fc\u30ad\u5c4b\u3067\u5b8c\u74a7\u306a\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u306b\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u6226\u7565\u3092\u7fd2\u5f97\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002STEP1 - \u8abf\u7406\u306e\u6b63\u78ba\u3055\u306b\u7126\u70b9\u3092\u5f53\u3066\u3001\u30d1\u30f3\u30b1\u30fc\u30ad\u304c\u713c\u304d\u8db3\u308a\u306a\u3044\u72b6\u614b\u3067\u3082\u713c\u304d\u3059\u304e\u3067\u3082\u306a\u3044\u72b6\u614b\u3092\u78ba\u4fdd\u3057\u307e\u3059\uff1bSTEP2 - \u9867\u5ba2\u306e\u597d\u307f\u306b\u6ce8\u610f\u3092\u6255\u3044\u3001\u305d\u308c\u306b\u5fdc\u3058\u3066\u6ce8\u6587\u3092\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3057\u307e\u3059\uff1bSTEP3 - \u8907\u6570\u306e\u6ce8\u6587\u3092\u9045\u5ef6\u306a\u304f\u51e6\u7406\u3059\u308b\u305f\u3081\u306b\u3001\u52b9\u7387\u7684\u306b\u6642\u9593\u3092\u7ba1\u7406\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30bf\u30a4\u30de\u30fc\u3092\u4f7f\u7528\u3057\u3066\u8abf\u7406\u6642\u9593\u3092\u8ffd\u8de1\u3057\u3001\u30c8\u30c3\u30d4\u30f3\u30b0\u306e\u30c1\u30a7\u30c3\u30af\u30ea\u30b9\u30c8\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u5b89\u5b9a\u3057\u3066\u5b8c\u74a7\u306a\u6ce8\u6587\u3092\u63d0\u4f9b\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u30ba\u30d1\u30f3\u30b1\u30fc\u30ad\u5c4b\u3067\u306e\u30c1\u30c3\u30d7\u30b7\u30b9\u30c6\u30e0\u306e\u80cc\u5f8c\u306b\u3042\u308b\u96a0\u308c\u305f\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30ba\u30d1\u30f3\u30b1\u30fc\u30ad\u5c4b\u3067\u306e\u30c1\u30c3\u30d7\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u96a0\u308c\u305f\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u3088\u3063\u3066\u5f71\u97ff\u3092\u53d7\u3051\u3066\u3044\u307e\u3059\u3002\u9867\u5ba2\u306f\u3001\u6ce8\u6587\u306e\u6b63\u78ba\u3055\u3001\u30b5\u30fc\u30d3\u30b9\u306e\u30b9\u30d4\u30fc\u30c9\u3001\u30d1\u30f3\u30b1\u30fc\u30ad\u306e\u5168\u4f53\u7684\u306a\u30d7\u30ec\u30bc\u30f3\u30c6\u30fc\u30b7\u30e7\u30f3\u306b\u57fa\u3065\u3044\u3066\u30c1\u30c3\u30d7\u3092\u304f\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5b8c\u74a7\u306b\u713c\u304d\u4e0a\u3052\u305f\u30d1\u30f3\u30b1\u30fc\u30ad\u3092\u6b63\u78ba\u306a\u30c8\u30c3\u30d4\u30f3\u30b0\u3068\u4e00\u7dd2\u306b\u3001\u77ed\u6642\u9593\u3067\u63d0\u4f9b\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u9ad8\u3044\u30c1\u30c3\u30d7\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u6e80\u8db3\u3057\u305f\u9867\u5ba2\u306e\u9023\u7d9a\u3092\u7dad\u6301\u3059\u308b\u3053\u3068\u3067\u3001\u30dc\u30fc\u30ca\u30b9\u30c1\u30c3\u30d7\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u3001\u53ce\u76ca\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u30ba\u30d1\u30f3\u30b1\u30fc\u30ad\u5c4b\u3067\u306e\u96e3\u6613\u5ea6\u66f2\u7dda\u306f\u3069\u306e\u3088\u3046\u306b\u9032\u307f\u3001\u5404\u6bb5\u968e\u3067\u4f55\u3092\u671f\u5f85\u3059\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30ba\u30d1\u30f3\u30b1\u30fc\u30ad\u5c4b\u3067\u306e\u96e3\u6613\u5ea6\u66f2\u7dda\u306f\u5f90\u3005\u306b\u4e0a\u6607\u3057\u3001\u5404\u6bb5\u968e\u3067\u65b0\u3057\u3044\u8ab2\u984c\u3092\u63d0\u793a\u3057\u307e\u3059\u3002\u6700\u521d\u306f\u3001\u57fa\u672c\u7684\u306a\u30c8\u30c3\u30d4\u30f3\u30b0\u3092\u4f7f\u3063\u305f\u7c21\u5358\u306a\u6ce8\u6587\u3092\u51e6\u7406\u3057\u307e\u3059\u3002\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u3059\u308b\u306b\u3064\u308c\u3066\u3001\u30b2\u30fc\u30e0\u3067\u306f\u3088\u308a\u8907\u96d1\u306a\u30ec\u30b7\u30d4\u3001\u540c\u6642\u6ce8\u6587\u3001\u3088\u308a\u53b3\u3057\u3044\u6642\u9593\u5236\u9650\u304c\u767b\u5834\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5f8c\u671f\u306e\u6bb5\u968e\u3067\u306f\u3001\u30af\u30e9\u30b7\u30c3\u30af\u30d1\u30f3\u30b1\u30fc\u30ad\u3068\u30b9\u30da\u30b7\u30e3\u30eb\u30c6\u30a3\u30d1\u30f3\u30b1\u30fc\u30ad\u3092\u30df\u30c3\u30af\u30b9\u3057\u306a\u304c\u3089\u3001\u305d\u308c\u305e\u308c\u304c\u5b8c\u74a7\u306b\u713c\u304d\u4e0a\u304c\u308b\u3088\u3046\u306b\u7ba1\u7406\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u3053\u306e\u9032\u5316\u306b\u3088\u308a\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306f\u9b45\u529b\u7684\u306b\u306a\u308a\u7d9a\u3051\u3001\u3042\u306a\u305f\u306e\u30de\u30eb\u30c1\u30bf\u30b9\u30ad\u30f3\u30b0\u30b9\u30ad\u30eb\u304c\u8a66\u3055\u308c\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u30ba\u30d1\u30f3\u30b1\u30fc\u30ad\u5c4b\u3067\u306e\u9032\u6357\u72b6\u6cc1\u3092\u5225\u306e\u30c7\u30d0\u30a4\u30b9\u306b\u8ee2\u9001\u3059\u308b\u3053\u3068\u306f\u3067\u304d\u307e\u3059\u304b\uff1f\u3082\u3057\u3067\u304d\u308b\u5834\u5408\u3001\u3069\u306e\u3088\u3046\u306b\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30d1\u30d1\u30ba\u30d1\u30f3\u30b1\u30fc\u30ad\u5c4b\u3067\u306e\u9032\u6357\u72b6\u6cc1\u3092\u5225\u306e\u30c7\u30d0\u30a4\u30b9\u306b\u8ee2\u9001\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u901a\u5e38\u3001\u30b2\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30af\u30e9\u30a6\u30c9\u30b5\u30fc\u30d3\u30b9\u307e\u305f\u306f\u30bd\u30fc\u30b7\u30e3\u30eb\u30e1\u30c7\u30a3\u30a2\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ea\u30f3\u30af\u3059\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u884c\u308f\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001iOS\u30c7\u30d0\u30a4\u30b9\u3067\u30d7\u30ec\u30a4\u3057\u3066\u3044\u308b\u5834\u5408\u306f\u3001iCloud\u3092\u4f7f\u7528\u3057\u3066\u9032\u6357\u72b6\u6cc1\u3092\u540c\u671f\u3067\u304d\u307e\u3059\u3002\u540c\u69d8\u306b\u3001Android\u30e6\u30fc\u30b6\u30fc\u306fGoogle Play\u30b2\u30fc\u30e0\u3092\u4f7f\u7528\u3057\u3066\u30c7\u30fc\u30bf\u3092\u4fdd\u5b58\u3057\u3001\u8ee2\u9001\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u9054\u6210\u3057\u305f\u6210\u679c\u3001\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u305f\u30a2\u30a4\u30c6\u30e0\u3001\u30b2\u30fc\u30e0\u306e\u9032\u6357\u72b6\u6cc1\u304c\u3001\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u4fdd\u5b58\u3055\u308c\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u30ba\u30d1\u30f3\u30b1\u30fc\u30ad\u5c4b\u306b\u306f\u3001\u79d8\u5bc6\u306e\u6750\u6599\u3084\u96a0\u3055\u308c\u305f\u30ec\u30b7\u30d4\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u30ba\u30d1\u30f3\u30b1\u30fc\u30ad\u5c4b\u306b\u306f\u3001\u7279\u5b9a\u306e\u6210\u679c\u3092\u9054\u6210\u3057\u305f\u308a\u3001\u7279\u5225\u306a\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u5b8c\u4e86\u3057\u305f\u308a\u3059\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u308b\u3001\u79d8\u5bc6\u306e\u6750\u6599\u3084\u96a0\u3055\u308c\u305f\u30ec\u30b7\u30d4\u304c\u3044\u304f\u3064\u304b\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u300150\u56de\u9023\u7d9a\u3057\u3066\u5b8c\u74a7\u306a\u6ce8\u6587\u3092\u51fa\u3059\u3068\u3001\u300c\u30b4\u30fc\u30eb\u30c7\u30f3\u30b7\u30ed\u30c3\u30d7\u300d\u306e\u3088\u3046\u306a\u7279\u5225\u306a\u30c8\u30c3\u30d4\u30f3\u30b0\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u3055\u3089\u306b\u3001\u4e00\u90e8\u306e\u96a0\u308c\u305f\u30ec\u30b7\u30d4\u306f\u3001\u975e\u5f93\u6765\u306e\u6750\u6599\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u8a66\u3059\u3053\u3068\u306b\u3088\u3063\u3066\u767a\u898b\u3055\u308c\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u9a5a\u304d\u3068\u5275\u9020\u6027\u3092\u52a0\u3048\u307e\u3059\u3002"}]
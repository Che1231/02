[{"question": "\u5982\u4f55\u5728\u5e15\u5e15\u7684\u714e\u997c\u5e97\u9ad8\u6548\u5730\u5904\u7406\u591a\u4efd\u714e\u997c\u8ba2\u5355\uff1f", "answer": "\u8981\u5728\u5e15\u5e15\u7684\u714e\u997c\u5e97\u9ad8\u6548\u5730\u5904\u7406\u591a\u4efd\u714e\u997c\u8ba2\u5355\uff0c\u8bf7\u9075\u5faa\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u6839\u636e\u8ba2\u5355\u7684\u590d\u6742\u7a0b\u5ea6\u8fdb\u884c\u4f18\u5148\u7ea7\u6392\u5e8f\uff1b\u6b65\u9aa42 - \u4f7f\u7528\"\u6392\u961f\u7cfb\u7edf\"\u8ddf\u8e2a\u5f85\u5904\u7406\u8ba2\u5355\uff1b\u6b65\u9aa43 - \u5c06\u7279\u5b9a\u4efb\u52a1\u5206\u914d\u7ed9\u6bcf\u4e2a\u5de5\u4f5c\u7ad9\uff08\u4f8b\u5982\uff0c\u7ffb\u714e\u997c\u3001\u6dfb\u52a0\u914d\u6599\uff09\u3002\u4f8b\u5982\uff0c\u5728\u5904\u7406\u5927\u8ba2\u5355\u65f6\uff0c\u8bf7\u5148\u4e13\u6ce8\u4e8e\u51c6\u5907\u9762\u7cca\uff0c\u7136\u540e\u540c\u65f6\u8fdb\u884c\u70f9\u996a\u548c\u6dfb\u52a0\u914d\u6599\u3002\u8fd9\u79cd\u65b9\u6cd5\u53ef\u4ee5\u786e\u4fdd\u5de5\u4f5c\u6d41\u7a0b\u987a\u5229\uff0c\u5e76\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u5ef6\u8fdf\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u5728\u5e15\u5e15\u7684\u714e\u997c\u5e97\u4fdd\u6301\u9ad8\u5ba2\u6237\u6ee1\u610f\u5ea6\u8bc4\u5206\u5f88\u91cd\u8981\uff1f", "answer": "\u5728\u5e15\u5e15\u7684\u714e\u997c\u5e97\u4fdd\u6301\u9ad8\u5ba2\u6237\u6ee1\u610f\u5ea6\u8bc4\u5206\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u4f1a\u76f4\u63a5\u5f71\u54cd\u4f60\u7684\u6536\u5165\u5e76\u89e3\u9501\u65b0\u7684\u529f\u80fd\u3002\u6ee1\u610f\u7684\u5ba2\u6237\u4f1a\u6177\u6168\u5730\u7ed9\u5c0f\u8d39\uff0c\u5e76\u4e14\u66f4\u6709\u53ef\u80fd\u518d\u6b21\u5149\u987e\uff0c\u4ece\u800c\u589e\u52a0\u4f60\u7684\u603b\u6536\u5165\u3002\u6b64\u5916\uff0c\u8fbe\u5230\u9ad8\u5206\u53ef\u4ee5\u89e3\u9501\u65b0\u7684\u914d\u6599\u548c\u88c5\u9970\uff0c\u589e\u5f3a\u4f60\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u4f8b\u5982\uff0c\u59cb\u7ec8\u63d0\u4f9b\u5b8c\u7f8e\u70f9\u5236\u7684\u714e\u997c\u548c\u6b63\u786e\u7684\u914d\u6599\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u5f97\u5206\u3002"}, {"question": "\u5e15\u5e15\u7684\u714e\u997c\u5e97\u5404\u79cd\u714e\u997c\u7c7b\u578b\u4e4b\u95f4\u7684\u4e3b\u8981\u533a\u522b\u662f\u4ec0\u4e48\uff1f", "answer": "\u5e15\u5e15\u7684\u714e\u997c\u5e97\u5404\u79cd\u714e\u997c\u7c7b\u578b\u4e4b\u95f4\u7684\u4e3b\u8981\u533a\u522b\u5728\u4e8e\u5176\u70f9\u996a\u65f6\u95f4\u548c\u6240\u9700\u7684\u914d\u6599\u3002\u4f8b\u5982\uff0c\u7ecf\u5178\u714e\u997c\u7684\u70f9\u996a\u65f6\u95f4\u8f83\u77ed\uff0c\u4f46\u9700\u8981\u7cbe\u786e\u7684\u65f6\u673a\u624d\u80fd\u907f\u514d\u70e7\u7126\uff0c\u800c\u50cf\u5de7\u514b\u529b\u82af\u7247\u8fd9\u6837\u7684\u7279\u8272\u714e\u997c\u5219\u9700\u8981\u4ed4\u7ec6\u76d1\u63a7\u9762\u7cca\u7684\u7a20\u5ea6\u3002\u6bcf\u79cd\u7c7b\u578b\u4e5f\u90fd\u6709\u72ec\u7279\u7684\u914d\u6599\u7ec4\u5408\uff0c\u4ee5\u8fce\u5408\u4e0d\u540c\u5ba2\u6237\u7684\u559c\u597d\uff0c\u589e\u5f3a\u6574\u4f53\u7528\u9910\u4f53\u9a8c\u3002"}, {"question": "\u5982\u4f55\u4f18\u5316\u6211\u7684\u914d\u6599\u4f7f\u7528\u4ee5\u51cf\u5c11\u5e15\u5e15\u7684\u714e\u997c\u5e97\u6d6a\u8d39\uff1f", "answer": "\u4f18\u5316\u5e15\u5e15\u7684\u714e\u997c\u5e97\u914d\u6599\u4f7f\u7528\u5305\u62ec\u6218\u7565\u8ba1\u5212\u548c\u9ad8\u6548\u7ba1\u7406\u3002\u6b65\u9aa41 - \u59cb\u7ec8\u68c0\u67e5\u8ba2\u5355\u660e\u7ec6\uff0c\u4ee5\u786e\u5b9a\u6240\u9700\u7684\u7cbe\u786e\u914d\u6599\u6570\u91cf\uff1b\u6b65\u9aa42 - \u4f7f\u7528\"\u51c6\u5907\u5de5\u4f5c\u7ad9\"\u9884\u5148\u6d4b\u91cf\u5373\u5c06\u5904\u7406\u8ba2\u5355\u7684\u914d\u6599\uff1b\u6b65\u9aa43 - \u6839\u636e\u4fdd\u8d28\u671f\u8f6e\u6362\u914d\u6599\uff0c\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u53d8\u8d28\u3002\u4f8b\u5982\uff0c\u4f18\u5148\u4f7f\u7528\u65b0\u9c9c\u6c34\u679c\uff0c\u7136\u540e\u518d\u5b83\u4eec\u8fc7\u671f\uff0c\u53ef\u4ee5\u663e\u8457\u51cf\u5c11\u6d6a\u8d39\uff0c\u5e76\u63d0\u9ad8\u4f60\u7684\u5229\u6da6\u7387\u3002"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u53ef\u4ee5\u5e2e\u52a9\u6211\u5728\u5e15\u5e15\u7684\u714e\u997c\u5e97\u83b7\u5f97\u5b8c\u7f8e\u5206\u6570\uff1f", "answer": "\u5728\u5e15\u5e15\u7684\u714e\u997c\u5e97\u83b7\u5f97\u5b8c\u7f8e\u5206\u6570\u9700\u8981\u638c\u63e1\u51e0\u79cd\u7b56\u7565\u3002\u6b65\u9aa41 - \u4e13\u6ce8\u4e8e\u70f9\u996a\u7684\u7cbe\u786e\u6027\uff0c\u786e\u4fdd\u714e\u997c\u65e2\u4e0d\u751f\u4e5f\u4e0d\u7126\uff1b\u6b65\u9aa42 - \u6ce8\u610f\u5ba2\u6237\u7684\u504f\u597d\u5e76\u76f8\u5e94\u5730\u5b9a\u5236\u8ba2\u5355\uff1b\u6b65\u9aa43 - \u6709\u6548\u5730\u7ba1\u7406\u4f60\u7684\u65f6\u95f4\uff0c\u5728\u4e0d\u803d\u8bef\u7684\u60c5\u51b5\u4e0b\u5904\u7406\u591a\u4efd\u8ba2\u5355\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u8ba1\u65f6\u5668\u8ddf\u8e2a\u70f9\u996a\u65f6\u95f4\uff0c\u5e76\u4f7f\u7528\u6e05\u5355\u8bb0\u5f55\u914d\u6599\uff0c\u53ef\u4ee5\u5e2e\u52a9\u4f60\u59cb\u7ec8\u5982\u4e00\u5730\u63d0\u4f9b\u5b8c\u7f8e\u7684\u8ba2\u5355\u3002"}, {"question": "\u5e15\u5e15\u7684\u714e\u997c\u5e97\u5c0f\u8d39\u7cfb\u7edf\u80cc\u540e\u7684\u79d8\u5bc6\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "\u5e15\u5e15\u7684\u714e\u997c\u5e97\u5c0f\u8d39\u7cfb\u7edf\u53d7\u591a\u79cd\u9690\u85cf\u673a\u5236\u7684\u5f71\u54cd\u3002\u5ba2\u6237\u7684\u5c0f\u8d39\u57fa\u4e8e\u8ba2\u5355\u7684\u51c6\u786e\u6027\u3001\u670d\u52a1\u901f\u5ea6\u4ee5\u53ca\u714e\u997c\u7684\u6574\u4f53\u5448\u73b0\u3002\u4f8b\u5982\uff0c\u5728\u77ed\u65f6\u95f4\u5185\u63d0\u4f9b\u4e00\u4efd\u5b8c\u7f8e\u70f9\u5236\u7684\u714e\u997c\u4ee5\u53ca\u6b63\u786e\u7684\u914d\u6599\uff0c\u53ef\u4ee5\u83b7\u5f97\u66f4\u9ad8\u7684\u63d0\u793a\u3002\u6b64\u5916\uff0c\u4fdd\u6301\u4e00\u8fde\u4e32\u6ee1\u610f\u7684\u5ba2\u6237\u53ef\u4ee5\u89e3\u9501\u989d\u5916\u7684\u5c0f\u8d39\uff0c\u589e\u52a0\u4f60\u7684\u6536\u5165\u3002"}, {"question": "\u5e15\u5e15\u7684\u714e\u997c\u5e97\u7684\u6e38\u620f\u96be\u5ea6\u662f\u5982\u4f55\u9010\u6e10\u63d0\u5347\u7684\uff0c\u5728\u6bcf\u4e2a\u9636\u6bb5\u6211\u5e94\u8be5\u671f\u5f85\u4ec0\u4e48\uff1f", "answer": "\u5e15\u5e15\u7684\u714e\u997c\u5e97\u7684\u6e38\u620f\u96be\u5ea6\u4f1a\u9010\u6e10\u63d0\u5347\uff0c\u5728\u6bcf\u4e2a\u9636\u6bb5\u90fd\u4f1a\u5f15\u5165\u65b0\u7684\u6311\u6218\u3002\u6700\u521d\uff0c\u4f60\u5c06\u5904\u7406\u5e26\u6709\u57fa\u672c\u914d\u6599\u7684\u7b80\u5355\u8ba2\u5355\u3002\u968f\u7740\u4f60\u7684\u8fdb\u6b65\uff0c\u6e38\u620f\u5c06\u5f15\u5165\u66f4\u590d\u6742\u7684\u83dc\u8c31\u3001\u591a\u4e2a\u540c\u65f6\u8fdb\u884c\u7684\u8ba2\u5355\u4ee5\u53ca\u66f4\u4e25\u683c\u7684\u65f6\u95f4\u9650\u5236\u3002\u4f8b\u5982\uff0c\u5728\u540e\u671f\u9636\u6bb5\uff0c\u4f60\u53ef\u80fd\u9700\u8981\u540c\u65f6\u7ba1\u7406\u7ecf\u5178\u548c\u7279\u8272\u714e\u997c\uff0c\u5e76\u786e\u4fdd\u6bcf\u4efd\u714e\u997c\u90fd\u70f9\u5236\u5f97\u6070\u5230\u597d\u5904\u3002\u8fd9\u79cd\u9012\u8fdb\u4f1a\u8ba9\u6e38\u620f\u66f4\u5177\u5438\u5f15\u529b\uff0c\u5e76\u6d4b\u8bd5\u4f60\u7684\u591a\u4efb\u52a1\u5904\u7406\u80fd\u529b\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5c06\u5e15\u5e15\u7684\u714e\u997c\u5e97\u7684\u6e38\u620f\u8fdb\u5ea6\u8f6c\u79fb\u5230\u53e6\u4e00\u53f0\u8bbe\u5907\u4e0a\u5417\uff1f\u5982\u4f55\u64cd\u4f5c\uff1f", "answer": "\u662f\u7684\uff0c\u4f60\u53ef\u4ee5\u5c06\u5e15\u5e15\u7684\u714e\u997c\u5e97\u7684\u6e38\u620f\u8fdb\u5ea6\u8f6c\u79fb\u5230\u53e6\u4e00\u53f0\u8bbe\u5907\u4e0a\u3002\u8fd9\u901a\u5e38\u901a\u8fc7\u5c06\u4f60\u7684\u6e38\u620f\u8d26\u53f7\u94fe\u63a5\u5230\u4e91\u670d\u52a1\u6216\u793e\u4ea4\u5a92\u4f53\u8d26\u53f7\u6765\u5b8c\u6210\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728 iOS \u8bbe\u5907\u4e0a\u73a9\u6e38\u620f\uff0c\u53ef\u4ee5\u4f7f\u7528 iCloud \u540c\u6b65\u4f60\u7684\u8fdb\u5ea6\u3002\u7c7b\u4f3c\u5730\uff0cAndroid \u7528\u6237\u53ef\u4ee5\u4f7f\u7528 Google Play \u6e38\u620f\u6765\u4fdd\u5b58\u548c\u4f20\u8f93\u4ed6\u4eec\u7684\u6570\u636e\u3002\u8fd9\u786e\u4fdd\u4f60\u5728\u4e0d\u540c\u8bbe\u5907\u4e0a\u90fd\u80fd\u4fdd\u7559\u4f60\u7684\u6210\u5c31\u3001\u89e3\u9501\u7684\u7269\u54c1\u548c\u6e38\u620f\u8fdb\u5ea6\u3002"}, {"question": "\u5e15\u5e15\u7684\u714e\u997c\u5e97\u6709\u54ea\u4e9b\u79d8\u5bc6\u914d\u6599\u6216\u9690\u85cf\u98df\u8c31\uff1f", "answer": "\u5e15\u5e15\u7684\u714e\u997c\u5e97\u5305\u542b\u4e00\u4e9b\u79d8\u5bc6\u914d\u6599\u548c\u9690\u85cf\u98df\u8c31\uff0c\u53ef\u4ee5\u901a\u8fc7\u5b8c\u6210\u7279\u5b9a\u6210\u5c31\u6216\u5b8c\u6210\u7279\u6b8a\u6311\u6218\u6765\u89e3\u9501\u3002\u4f8b\u5982\uff0c\u5b8c\u6210 50 \u6b21\u5b8c\u7f8e\u8ba2\u5355\u53ef\u80fd\u4f1a\u89e3\u9501\u4e00\u79cd\u72ec\u7279\u7684\u914d\u6599\uff0c\u5982\u201c\u9ec4\u91d1\u7cd6\u6d46\u201d\u3002\u6b64\u5916\uff0c\u4e00\u4e9b\u9690\u85cf\u7684\u98df\u8c31\u53ef\u4ee5\u901a\u8fc7\u5c1d\u8bd5\u4e0d\u5bfb\u5e38\u7684\u914d\u6599\u7ec4\u5408\u6765\u53d1\u73b0\uff0c\u8fd9\u4e3a\u6e38\u620f\u589e\u6dfb\u4e86\u60ca\u559c\u548c\u521b\u610f\u3002"}]
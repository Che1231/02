[{"question": "\u5982\u4f55\u6709\u6548\u5730\u7ba1\u7406\u6d3e\u5e15\u65af\u714e\u9905\u5c4b\u7684\u591a\u500b\u8a02\u55ae\uff1f", "answer": "\u8981\u6709\u6548\u7ba1\u7406\u6d3e\u5e15\u65af\u714e\u9905\u5c4b\u7684\u591a\u500b\u8a02\u55ae\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u57fa\u65bc\u8a02\u55ae\u7684\u8907\u96dc\u7a0b\u5ea6\u9032\u884c\u512a\u5148\u6392\u5e8f\uff1b\u6b65\u9a5f2 - \u4f7f\u7528\u300e\u6392\u968a\u7cfb\u7d71\u300f\u8ffd\u8e64\u5f85\u8655\u7406\u8a02\u55ae\uff1b\u6b65\u9a5f3 - \u6307\u6d3e\u7279\u5b9a\u4efb\u52d9\u7d66\u6bcf\u500b\u5de5\u4f5c\u7ad9\uff08\u4f8b\u5982\uff0c\u7ffb\u714e\u9905\u3001\u6dfb\u52a0\u914d\u6599\uff09\u3002\u4f8b\u5982\uff0c\u5728\u8655\u7406\u5927\u578b\u8a02\u55ae\u6642\uff0c\u5148\u5c08\u6ce8\u65bc\u6e96\u5099\u9eb5\u7cca\uff0c\u7136\u5f8c\u540c\u6642\u9032\u884c\u70f9\u98ea\u548c\u6dfb\u52a0\u914d\u6599\u3002\u6b64\u65b9\u6cd5\u53ef\u78ba\u4fdd\u9806\u66a2\u7684\u5de5\u4f5c\u6d41\u7a0b\u4e26\u6700\u5927\u9650\u5ea6\u5730\u6e1b\u5c11\u5ef6\u8aa4\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u5728\u6d3e\u5e15\u65af\u714e\u9905\u5c4b\u7dad\u8b77\u9ad8\u5ba2\u6236\u6eff\u610f\u5ea6\u5206\u6578\u5f88\u91cd\u8981\uff1f", "answer": "\u5728\u6d3e\u5e15\u65af\u714e\u9905\u5c4b\u7dad\u8b77\u9ad8\u5ba2\u6236\u6eff\u610f\u5ea6\u5206\u6578\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6703\u76f4\u63a5\u5f71\u97ff\u60a8\u7684\u6536\u76ca\u4e26\u89e3\u9396\u65b0\u7684\u529f\u80fd\u3002\u6eff\u610f\u7684\u9867\u5ba2\u6703\u7d66\u4e88\u66f4\u591a\u5c0f\u8cbb\uff0c\u4e26\u4e14\u66f4\u6709\u53ef\u80fd\u56de\u8a2a\uff0c\u5f9e\u800c\u589e\u52a0\u6574\u9ad4\u6536\u5165\u3002\u6b64\u5916\uff0c\u9054\u5230\u9ad8\u5206\u6578\u53ef\u4ee5\u89e3\u9396\u65b0\u7684\u98df\u6750\u548c\u88dd\u98fe\uff0c\u63d0\u5347\u60a8\u7684\u904a\u6232\u9ad4\u9a57\u3002\u4f8b\u5982\uff0c\u6301\u7e8c\u63d0\u4f9b\u5b8c\u7f8e\u70f9\u98ea\u7684\u714e\u9905\u4ee5\u53ca\u6b63\u78ba\u7684\u914d\u6599\uff0c\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u60a8\u7684\u5206\u6578\u3002"}, {"question": "\u6d3e\u5e15\u65af\u714e\u9905\u5c4b\u5404\u7a2e\u714e\u9905\u985e\u578b\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "\u6d3e\u5e15\u65af\u714e\u9905\u5c4b\u5404\u7a2e\u714e\u9905\u985e\u578b\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u5728\u65bc\u5176\u70f9\u98ea\u6642\u9593\u548c\u6240\u9700\u7684\u914d\u6599\u3002\u4f8b\u5982\uff0c\u7d93\u5178\u714e\u9905\u7684\u70f9\u98ea\u6642\u9593\u8f03\u77ed\uff0c\u4f46\u9700\u8981\u7cbe\u78ba\u7684\u6642\u9593\u63a7\u5236\u4ee5\u907f\u514d\u71d2\u7126\uff0c\u800c\u50cf\u5de7\u514b\u529b\u8106\u9905\u9019\u6a23\u7684\u7279\u6b8a\u714e\u9905\u5247\u9700\u8981\u4ed4\u7d30\u76e3\u63a7\u9eb5\u7cca\u7684\u7a20\u5ea6\u3002\u6bcf\u7a2e\u985e\u578b\u4e5f\u90fd\u6709\u7368\u7279\u7684\u914d\u6599\u7d44\u5408\uff0c\u4ee5\u6eff\u8db3\u4e0d\u540c\u9867\u5ba2\u7684\u559c\u597d\uff0c\u63d0\u5347\u6574\u9ad4\u7528\u9910\u9ad4\u9a57\u3002"}, {"question": "\u5982\u4f55\u512a\u5316\u98df\u6750\u4f7f\u7528\u91cf\u4ee5\u6e1b\u5c11\u6d3e\u5e15\u65af\u714e\u9905\u5c4b\u7684\u6d6a\u8cbb\uff1f", "answer": "\u512a\u5316\u6d3e\u5e15\u65af\u714e\u9905\u5c4b\u7684\u98df\u6750\u4f7f\u7528\u91cf\u9700\u8981\u7b56\u7565\u6027\u898f\u5283\u548c\u6709\u6548\u7ba1\u7406\u3002\u6b65\u9a5f1 - \u59cb\u7d42\u6aa2\u67e5\u8a02\u55ae\u8a73\u60c5\u4ee5\u78ba\u5b9a\u6240\u9700\u7684\u98df\u6750\u6578\u91cf\uff1b\u6b65\u9a5f2 - \u4f7f\u7528\u300e\u6e96\u5099\u7ad9\u300f\u9810\u5148\u6e2c\u91cf\u5373\u5c07\u5230\u4f86\u7684\u8a02\u55ae\u6240\u9700\u7684\u98df\u6750\uff1b\u6b65\u9a5f3 - \u57fa\u65bc\u98df\u6750\u7684\u4fdd\u5b58\u671f\u9650\u8f2a\u63db\u98df\u6750\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u6e1b\u5c11\u640d\u8017\u3002\u4f8b\u5982\uff0c\u512a\u5148\u4f7f\u7528\u65b0\u9bae\u6c34\u679c\uff0c\u9632\u6b62\u5176\u904e\u671f\uff0c\u53ef\u4ee5\u6709\u6548\u6e1b\u5c11\u6d6a\u8cbb\u4e26\u63d0\u9ad8\u5229\u6f64\u3002"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u53ef\u4ee5\u5e6b\u52a9\u6211\u5728\u6d3e\u5e15\u65af\u714e\u9905\u5c4b\u9054\u5230\u5b8c\u7f8e\u5206\u6578\uff1f", "answer": "\u5728\u6d3e\u5e15\u65af\u714e\u9905\u5c4b\u9054\u5230\u5b8c\u7f8e\u5206\u6578\u9700\u8981\u638c\u63e1\u4e00\u4e9b\u7b56\u7565\u3002\u6b65\u9a5f1 - \u5c08\u6ce8\u65bc\u70f9\u98ea\u7684\u7cbe\u78ba\u6027\uff0c\u78ba\u4fdd\u714e\u9905\u65e2\u4e0d\u751f\u4e5f\u4e0d\u7126\uff1b\u6b65\u9a5f2 - \u6ce8\u610f\u9867\u5ba2\u7684\u559c\u597d\uff0c\u4e26\u6839\u64da\u5be6\u969b\u60c5\u6cc1\u5ba2\u88fd\u5316\u8a02\u55ae\uff1b\u6b65\u9a5f3 - \u6709\u6548\u5730\u7ba1\u7406\u6642\u9593\uff0c\u5728\u4e0d\u5ef6\u8aa4\u7684\u60c5\u6cc1\u4e0b\u8655\u7406\u591a\u500b\u8a02\u55ae\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u8a08\u6642\u5668\u4f86\u8ffd\u8e64\u70f9\u98ea\u6642\u9593\uff0c\u4e26\u4f7f\u7528\u6e05\u55ae\u4f86\u78ba\u8a8d\u914d\u6599\uff0c\u53ef\u4ee5\u5e6b\u52a9\u60a8\u6301\u7e8c\u63d0\u4f9b\u5b8c\u7f8e\u7684\u8a02\u55ae\u3002"}, {"question": "\u6d3e\u5e15\u65af\u714e\u9905\u5c4b\u7684\u5c0f\u8cbb\u7cfb\u7d71\u80cc\u5f8c\u7684\u96b1\u85cf\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "\u6d3e\u5e15\u65af\u714e\u9905\u5c4b\u7684\u5c0f\u8cbb\u7cfb\u7d71\u53d7\u5230\u591a\u7a2e\u96b1\u85cf\u6a5f\u5236\u7684\u5f71\u97ff\u3002\u9867\u5ba2\u7684\u5c0f\u8cbb\u53d6\u6c7a\u65bc\u8a02\u55ae\u7684\u6e96\u78ba\u6027\u3001\u670d\u52d9\u901f\u5ea6\u4ee5\u53ca\u714e\u9905\u7684\u6574\u9ad4\u5448\u73fe\u3002\u4f8b\u5982\uff0c\u5728\u77ed\u6642\u9593\u5167\u63d0\u4f9b\u4e00\u4efd\u5b8c\u7f8e\u70f9\u98ea\u7684\u714e\u9905\uff0c\u4ee5\u53ca\u6b63\u78ba\u7684\u914d\u6599\uff0c\u53ef\u80fd\u6703\u7372\u5f97\u66f4\u9ad8\u7684\u5c0f\u8cbb\u3002\u6b64\u5916\uff0c\u7dad\u6301\u4e00\u9023\u4e32\u6eff\u610f\u7684\u9867\u5ba2\u53ef\u4ee5\u89e3\u9396\u984d\u5916\u7684\u5c0f\u8cbb\uff0c\u63d0\u9ad8\u60a8\u7684\u6536\u76ca\u3002"}, {"question": "\u6d3e\u5e15\u65af\u714e\u9905\u5c4b\u7684\u96e3\u5ea6\u66f2\u7dda\u662f\u5982\u4f55\u9010\u6b65\u63d0\u5347\u7684\uff0c\u5728\u6bcf\u500b\u968e\u6bb5\u6211\u61c9\u8a72\u671f\u5f85\u4ec0\u9ebc\uff1f", "answer": "\u6d3e\u5e15\u65af\u714e\u9905\u5c4b\u7684\u96e3\u5ea6\u66f2\u7dda\u6703\u9010\u6f38\u63d0\u5347\uff0c\u5728\u6bcf\u500b\u968e\u6bb5\u90fd\u6703\u5f15\u5165\u65b0\u7684\u6311\u6230\u3002\u4e00\u958b\u59cb\uff0c\u60a8\u6703\u8655\u7406\u7c21\u55ae\u7684\u8a02\u55ae\u548c\u57fa\u672c\u7684\u914d\u6599\u3002\u96a8\u8457\u60a8\u7684\u9032\u5ea6\u63d0\u5347\uff0c\u904a\u6232\u6703\u5f15\u5165\u66f4\u8907\u96dc\u7684\u98df\u8b5c\u3001\u591a\u500b\u540c\u6642\u7684\u8a02\u55ae\u548c\u66f4\u56b4\u683c\u7684\u6642\u9593\u9650\u5236\u3002\u4f8b\u5982\uff0c\u5728\u5f8c\u671f\u7684\u968e\u6bb5\uff0c\u60a8\u53ef\u80fd\u9700\u8981\u540c\u6642\u7ba1\u7406\u7d93\u5178\u548c\u7279\u6b8a\u714e\u9905\uff0c\u4e26\u78ba\u4fdd\u6bcf\u4e00\u4efd\u714e\u9905\u90fd\u70f9\u98ea\u5230\u5b8c\u7f8e\u3002\u9019\u7a2e\u9032\u5c55\u6703\u8b93\u904a\u6232\u4fdd\u6301\u8da3\u5473\u6027\uff0c\u4e26\u8003\u9a57\u60a8\u7684\u591a\u5de5\u6280\u80fd\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5c07\u6d3e\u5e15\u65af\u714e\u9905\u5c4b\u7684\u9032\u5ea6\u8f49\u79fb\u5230\u5176\u4ed6\u8a2d\u5099\u4e0a\u55ce\uff1f\u5982\u4f55\u8f49\u79fb\uff1f", "answer": "\u53ef\u4ee5\uff0c\u60a8\u53ef\u4ee5\u5c07\u6d3e\u5e15\u65af\u714e\u9905\u5c4b\u7684\u9032\u5ea6\u8f49\u79fb\u5230\u5176\u4ed6\u8a2d\u5099\u3002\u9019\u901a\u5e38\u662f\u901a\u904e\u5c07\u60a8\u7684\u904a\u6232\u5e33\u6236\u9023\u7d50\u5230\u96f2\u7aef\u670d\u52d9\u6216\u793e\u4ea4\u5a92\u9ad4\u5e33\u6236\u4f86\u5b8c\u6210\u7684\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728 iOS \u8a2d\u5099\u4e0a\u73a9\u904a\u6232\uff0c\u53ef\u4ee5\u4f7f\u7528 iCloud \u540c\u6b65\u9032\u5ea6\u3002\u540c\u6a23\u5730\uff0cAndroid \u7528\u6236\u53ef\u4ee5\u4f7f\u7528 Google Play Games \u4f86\u5132\u5b58\u548c\u8f49\u79fb\u6578\u64da\u3002\u9019\u80fd\u78ba\u4fdd\u60a8\u7684\u6210\u5c31\u3001\u89e3\u9396\u7684\u7269\u54c1\u548c\u904a\u6232\u9032\u5ea6\u5728\u4e0d\u540c\u7684\u8a2d\u5099\u4e0a\u90fd\u80fd\u4fdd\u7559\u3002"}, {"question": "\u6d3e\u5e15\u65af\u714e\u9905\u5c4b\u4e2d\u6709\u4ec0\u9ebc\u79d8\u5bc6\u98df\u6750\u6216\u96b1\u85cf\u98df\u8b5c\uff1f", "answer": "\u6d3e\u5e15\u65af\u714e\u9905\u5c4b\u5305\u542b\u4e00\u4e9b\u79d8\u5bc6\u98df\u6750\u548c\u96b1\u85cf\u98df\u8b5c\uff0c\u9019\u4e9b\u90fd\u53ef\u4ee5\u900f\u904e\u5b8c\u6210\u7279\u5b9a\u6210\u5c31\u6216\u5b8c\u6210\u7279\u6b8a\u6311\u6230\u4f86\u89e3\u9396\u3002\u4f8b\u5982\uff0c\u9054\u6210 50 \u6b21\u5b8c\u7f8e\u8a02\u55ae\u7684\u9023\u52dd\u53ef\u80fd\u89e3\u9396\u7368\u7279\u7684\u914d\u6599\uff0c\u4f8b\u5982\u300c\u9ec3\u91d1\u7cd6\u6f3f\u300d\u3002\u6b64\u5916\uff0c\u6709\u4e9b\u96b1\u85cf\u98df\u8b5c\u662f\u900f\u904e\u5617\u8a66\u4e0d\u5c0b\u5e38\u7684\u98df\u6750\u7d44\u5408\u4f86\u767c\u73fe\u7684\uff0c\u9019\u5728\u904a\u6232\u4e2d\u589e\u6dfb\u4e86\u9a5a\u559c\u548c\u5275\u9020\u529b\u3002"}]
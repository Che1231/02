[{"question": "\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001\u30b9\u30c6\u30a3\u30c3\u30af\u30de\u30f3 \u30b2\u30fc\u30e0\u300e\u30ab\u30a6\u30f3\u30c8 \u30de\u30b9\u30bf\u30fc\u30ba\u300f\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u300e\u30ab\u30a6\u30f3\u30c8 \u30de\u30b9\u30bf\u30fc\u30ba\uff1a\u30b9\u30c6\u30a3\u30c3\u30af\u30de\u30f3 \u30b2\u30fc\u30e0\u300f\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u307e\u305a\u753b\u9762\u4e0a\u306e\u30dc\u30bf\u30f3\u306b\u6163\u308c\u308b\u3053\u3068\u304b\u3089\u59cb\u3081\u307e\u3057\u3087\u3046\u3002\u5de6\u5074\u306f\u79fb\u52d5\uff08\u5de6\u53f3\uff09\u3001\u53f3\u5074\u306f\u30b8\u30e3\u30f3\u30d7\u3084\u653b\u6483\u306a\u3069\u306e\u30a2\u30af\u30b7\u30e7\u30f3\u3092\u5236\u5fa1\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u969c\u5bb3\u7269\u3092\u907f\u3051\u3001\u653b\u6483\u30dc\u30bf\u30f3\u3092\u30bf\u30c3\u30d7\u3057\u3066\u6575\u3092\u653b\u6483\u3059\u308b\u3088\u3046\u306b\u3001\u30b9\u30c6\u30a3\u30c3\u30af\u30de\u30f3\u3092\u52d5\u304b\u3059\u7df4\u7fd2\u3092\u3057\u307e\u3057\u3087\u3046\u3002\u91cd\u8981\u306a\u306e\u306f\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u3059\u3002\u9699\u9593\u3092\u30af\u30ea\u30a2\u3059\u308b\u305f\u3081\u306b\u3001\u30b8\u30e3\u30f3\u30d7\u30dc\u30bf\u30f3\u3092\u9699\u9593\u306b\u7740\u304f\u76f4\u524d\u306b\u62bc\u3059\u3053\u3068\u3092\u899a\u3048\u3066\u304a\u304d\u307e\u3057\u3087\u3046\u3002[\u4f8b\u3048\u8aac\u660e\uff1a\u64cd\u4f5c\u3092\u8eca\u306e\u904b\u8ee2\u306b\u4f8b\u3048\u308b\u3068\u3001\u6ed1\u3089\u304b\u3067\u614e\u91cd\u306a\u64cd\u4f5c\u304c\u3088\u308a\u826f\u3044\u7d50\u679c\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002]"}, {"question": "\u300e\u30ab\u30a6\u30f3\u30c8 \u30de\u30b9\u30bf\u30fc\u30ba\uff1a\u30b9\u30c6\u30a3\u30c3\u30af\u30de\u30f3 \u30b2\u30fc\u30e0\u300f\u3067\u30dc\u30b9\u3092\u5012\u3059\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u300e\u30ab\u30a6\u30f3\u30c8 \u30de\u30b9\u30bf\u30fc\u30ba\uff1a\u30b9\u30c6\u30a3\u30c3\u30af\u30de\u30f3 \u30b2\u30fc\u30e0\u300f\u3067\u30dc\u30b9\u3092\u5012\u3059\u306b\u306f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u6226\u7565\u306e\u4e21\u65b9\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff11\uff1a\u30dc\u30b9\u306e\u653b\u6483\u30d1\u30bf\u30fc\u30f3\u3092\u89b3\u5bdf\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u68ee\u306e\u30dc\u30b9\u306f3\u79d2\u3054\u3068\u306b\u6b66\u5668\u3092\u632f\u308b\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u653b\u6483\u3092\u304b\u308f\u3059\u305f\u3081\u306b\u3001\u9069\u5207\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u96e2\u308c\u308b\u304b\u30b8\u30e3\u30f3\u30d7\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30dc\u30b9\u306e\u30af\u30fc\u30eb\u30c0\u30a6\u30f3\u4e2d\u306b\u53cd\u6483\u3057\u307e\u3059\u3002\u30c0\u30d6\u30eb\u30c0\u30e1\u30fc\u30b8\u306a\u3069\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u3063\u3066\u3001\u653b\u6483\u3092\u6700\u5927\u9650\u306b\u5f37\u5316\u3057\u307e\u3057\u3087\u3046\u3002[\u8907\u6570\u306e\u6226\u7565\uff1a\u4e00\u90e8\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u9060\u8ddd\u96e2\u653b\u6483\u3092\u597d\u307f\u3001\u4e00\u65b9\u3067\u8fd1\u63a5\u653b\u6483\u306b\u983c\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u3082\u3044\u307e\u3059\u3002\u81ea\u5206\u306e\u30b9\u30bf\u30a4\u30eb\u3092\u898b\u3064\u3051\u308b\u305f\u3081\u306b\u8a66\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u306a\u305c\u300e\u30ab\u30a6\u30f3\u30c8 \u30de\u30b9\u30bf\u30fc\u30ba\uff1a\u30b9\u30c6\u30a3\u30c3\u30af\u30de\u30f3 \u30b2\u30fc\u30e0\u300f\u3067\u30b9\u30c6\u30a3\u30c3\u30af\u30de\u30f3\u306e\u4f53\u529b\u306f\u6e1b\u3063\u3066\u3057\u307e\u3046\u306e\u3067\u3057\u3087\u3046\u304b\uff1f\u307e\u305f\u3001\u3069\u306e\u3088\u3046\u306b\u3059\u308c\u3070\u9632\u3050\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u300e\u30ab\u30a6\u30f3\u30c8 \u30de\u30b9\u30bf\u30fc\u30ba\uff1a\u30b9\u30c6\u30a3\u30c3\u30af\u30de\u30f3 \u30b2\u30fc\u30e0\u300f\u3067\u30b9\u30c6\u30a3\u30c3\u30af\u30de\u30f3\u306e\u4f53\u529b\u304c\u6e1b\u308b\u306e\u306f\u3001\u4e3b\u306b\u6575\u306e\u653b\u6483\u3068\u74b0\u5883\u306e\u5371\u967a\u306a\u72b6\u6cc1\u306e\u305f\u3081\u3067\u3059\u3002\u3053\u308c\u3089\u3092\u9632\u3050\u305f\u3081\u306b\u3001\u5e38\u306b\u5371\u967a\u306a\u72b6\u6cc1\u306b\u6ce8\u610f\u3092\u6255\u3046\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6eb6\u5ca9\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u71b1\u3044\u8868\u9762\u306e\u4e0a\u306b\u7acb\u3064\u306e\u3092\u907f\u3051\u3001\u30b8\u30e3\u30f3\u30d7\u3057\u3066\u4e57\u308a\u8d8a\u3048\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b7\u30e7\u30c3\u30d7\u3067\u5f37\u5316\u3055\u308c\u305f\u30a2\u30fc\u30de\u30fc\u3092\u88c5\u5099\u3059\u308b\u3053\u3068\u3067\u3001\u3042\u306a\u305f\u306e\u4f53\u529b\u30d7\u30fc\u30eb\u3092\u5897\u3084\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u4f53\u529b\u30b2\u30fc\u30b8\u304c\u4f4e\u3044\u5834\u5408\u306f\u3001\u56de\u5fa9\u30a2\u30a4\u30c6\u30e0\u3067\u3042\u308b\u300c\u30d8\u30eb\u30b9\u30dd\u30fc\u30b7\u30e7\u30f3\u300d\u3092\u4f7f\u7528\u3057\u307e\u3057\u3087\u3046\u3002[\u88c5\u5099\u6bd4\u8f03\u8868\uff1a\u30d6\u30ed\u30f3\u30ba\u30a2\u30fc\u30de\u30fc\u306f+50 HP\u3001\u30b4\u30fc\u30eb\u30c9\u30a2\u30fc\u30de\u30fc\u306f+100 HP\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002]"}, {"question": "\u300e\u30ab\u30a6\u30f3\u30c8 \u30de\u30b9\u30bf\u30fc\u30ba\uff1a\u30b9\u30c6\u30a3\u30c3\u30af\u30de\u30f3 \u30b2\u30fc\u30e0\u300f\u3067\u3088\u308a\u65e9\u304f\u9032\u6b69\u3059\u308b\u305f\u3081\u306b\u3001\u512a\u5148\u3059\u3079\u304d\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u300e\u30ab\u30a6\u30f3\u30c8 \u30de\u30b9\u30bf\u30fc\u30ba\uff1a\u30b9\u30c6\u30a3\u30c3\u30af\u30de\u30f3 \u30b2\u30fc\u30e0\u300f\u3067\u3088\u308a\u65e9\u304f\u9032\u6b69\u3059\u308b\u306b\u306f\u3001\u30b9\u30c6\u30a3\u30c3\u30af\u30de\u30f3\u306e\u751f\u5b58\u80fd\u529b\u3068\u30c0\u30e1\u30fc\u30b8\u51fa\u529b\u3092\u5411\u4e0a\u3055\u305b\u308b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u512a\u5148\u3057\u307e\u3057\u3087\u3046\u3002\u307e\u305a\u3001\u6700\u5927HP\u3092\u5897\u3084\u3059\u305f\u3081\u306b\u4f53\u529b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u6295\u8cc7\u3057\u307e\u3057\u3087\u3046\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u3088\u308a\u591a\u304f\u306e\u30d2\u30c3\u30c8\u306b\u8010\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u6b21\u306b\u3001\u6575\u306b\u4e0e\u3048\u308b\u30c0\u30e1\u30fc\u30b8\u3092\u5897\u3084\u3059\u305f\u3081\u306b\u653b\u6483\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u6295\u8cc7\u3057\u307e\u3057\u3087\u3046\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb3\u306e\u653b\u6483\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u3001\u6d1e\u7a9f\u306e\u30dc\u30b9\u3092\u3088\u308a\u5c11\u306a\u3044\u30d2\u30c3\u30c8\u3067\u5012\u3059\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002[\u30b9\u30c6\u30c3\u30d7\uff1a\u4f53\u529b\u304c\u512a\u5148\u2192\u653b\u6483\u529b\u2192\u901f\u5ea6\u306e\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u9032\u5316\u3092\u76ee\u6307\u3057\u307e\u3057\u3087\u3046\u3002]"}, {"question": "\u300e\u30ab\u30a6\u30f3\u30c8 \u30de\u30b9\u30bf\u30fc\u30ba\uff1a\u30b9\u30c6\u30a3\u30c3\u30af\u30de\u30f3 \u30b2\u30fc\u30e0\u300f\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u3069\u306e\u3088\u3046\u306b\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u300e\u30ab\u30a6\u30f3\u30c8 \u30de\u30b9\u30bf\u30fc\u30ba\uff1a\u30b9\u30c6\u30a3\u30c3\u30af\u30de\u30f3 \u30b2\u30fc\u30e0\u300f\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6575\u306e\u6483\u7834\u6570\u3001\u30b3\u30f3\u30dc\u9023\u9396\u3001\u30ec\u30d9\u30eb\u30af\u30ea\u30a2\u306b\u304b\u304b\u3063\u305f\u6642\u9593\u306a\u3069\u306e\u8981\u7d20\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u6575\u3092\u7d20\u65e9\u304f\u9023\u7d9a\u3057\u3066\u6483\u7834\u3059\u308b\u3053\u3068\u3067\u3001\u9ad8\u3044\u30b3\u30f3\u30dc\u3092\u76ee\u6307\u3057\u307e\u3057\u3087\u3046\u3002\u305f\u3068\u3048\u3070\u3001\u7802\u6f20\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u6575\u3092\u307e\u3068\u3081\u3066\u914d\u7f6e\u3057\u3001\u5e83\u7bc4\u56f2\u653b\u6483\u306710\u500d\u306e\u30b3\u30f3\u30dc\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30ec\u30d9\u30eb\u3092\u7d20\u65e9\u304f\u30af\u30ea\u30a2\u3057\u3066\u6642\u9593\u30dc\u30fc\u30ca\u30b9\u3092\u7372\u5f97\u3057\u307e\u3057\u3087\u3046\u3002[\u4f8b\u3048\u8aac\u660e\uff1a\u30b3\u30f3\u30dc\u306f\u7a4d\u307f\u6728\u3092\u7a4d\u307f\u91cd\u306d\u308b\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u5404\u30d2\u30c3\u30c8\u306f\u5854\u306b\u8ffd\u52a0\u3055\u308c\u307e\u3059\u3002]"}, {"question": "\u300e\u30ab\u30a6\u30f3\u30c8 \u30de\u30b9\u30bf\u30fc\u30ba\uff1a\u30b9\u30c6\u30a3\u30c3\u30af\u30de\u30f3 \u30b2\u30fc\u30e0\u300f\u306e\u96a0\u3057\u5b9f\u7e3e\u306f\u4f55\u3067\u3042\u308a\u3001\u3069\u306e\u3088\u3046\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u300e\u30ab\u30a6\u30f3\u30c8 \u30de\u30b9\u30bf\u30fc\u30ba\uff1a\u30b9\u30c6\u30a3\u30c3\u30af\u30de\u30f3 \u30b2\u30fc\u30e0\u300f\u306b\u306f\u3001\u7279\u5b9a\u306e\u30a2\u30af\u30b7\u30e7\u30f3\u304c\u5fc5\u8981\u306a\u96a0\u3055\u308c\u305f\u5b9f\u7e3e\u304c\u3044\u304f\u3064\u304b\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30de\u30b9\u30bf\u30fc\u30b9\u30c8\u30e9\u30c6\u30b8\u30b9\u30c8\u300d\u306e\u9054\u6210\u306f\u3001\u30c0\u30e1\u30fc\u30b8\u3092\u53d7\u3051\u305a\u306b\u30dc\u30b9\u3092\u5012\u3059\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u3053\u308c\u3092\u5b9f\u73fe\u3059\u308b\u306b\u306f\u3001\u30dc\u30b9\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u7814\u7a76\u3057\u3001\u30b8\u30e3\u30f3\u30d7\u3092\u5b8c\u74a7\u306b\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5408\u308f\u305b\u3066\u304f\u3060\u3055\u3044\u3002\u300c\u5b9d\u63a2\u691c\u5bb6\u300d\u3068\u3044\u3046\u3082\u3046\u4e00\u3064\u306e\u96a0\u3057\u5b9f\u7e3e\u306f\u30011\u3064\u306e\u30ec\u30d9\u30eb\u3067\u96a0\u3055\u308c\u305f\u30b3\u30a4\u30f3\u3092\u3059\u3079\u3066\u96c6\u3081\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u9685\u3005\u307e\u3067\u63a2\u691c\u3057\u3001\u30de\u30c3\u30d7\u3092\u4f7f\u3063\u3066\u305d\u308c\u3089\u3092\u898b\u3064\u3051\u307e\u3057\u3087\u3046\u3002[\u30d2\u30f3\u30c8\uff1a\u4e00\u90e8\u306e\u30b3\u30a4\u30f3\u306f\u58ca\u305b\u308b\u58c1\u306e\u5f8c\u308d\u306b\u96a0\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u653b\u6483\u3092\u4f7f\u7528\u3057\u3066\u3001\u305d\u308c\u3089\u3092\u898b\u3064\u3051\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u300e\u30ab\u30a6\u30f3\u30c8 \u30de\u30b9\u30bf\u30fc\u30ba\uff1a\u30b9\u30c6\u30a3\u30c3\u30af\u30de\u30f3 \u30b2\u30fc\u30e0\u300f\u306e\u9032\u884c\u72b6\u6cc1\u3092\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u300e\u30ab\u30a6\u30f3\u30c8 \u30de\u30b9\u30bf\u30fc\u30ba\uff1a\u30b9\u30c6\u30a3\u30c3\u30af\u30de\u30f3 \u30b2\u30fc\u30e0\u300f\u306e\u9032\u884c\u72b6\u6cc1\u3092\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u307b\u3068\u3093\u3069\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001Google Play\u307e\u305f\u306fApple Game Center\u3092\u4f7f\u7528\u3057\u3066\u30b7\u30fc\u30e0\u30ec\u30b9\u306b\u540c\u671f\u3057\u3066\u3044\u307e\u3059\u3002\u5207\u308a\u66ff\u3048\u308b\u524d\u306b\u3001\u30b2\u30fc\u30e0\u306e\u8a2d\u5b9a\u306b\u30a2\u30af\u30bb\u30b9\u3057\u3066\u300c\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u300d\u3092\u9078\u629e\u3057\u3001\u624b\u52d5\u3067\u9032\u884c\u72b6\u6cc1\u3092\u4fdd\u5b58\u3057\u307e\u3059\u3002\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u30ed\u30b0\u30a4\u30f3\u3057\u3001\u4fdd\u5b58\u3055\u308c\u305f\u30c7\u30fc\u30bf\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002[\u6bd4\u8f03\uff1aAndroid\u5411\u3051\u306b\u306fGoogle Play\u3001iOS\u5411\u3051\u306b\u306fApple Game Center\u304c\u6700\u9069\u3067\u3059\u3002]"}, {"question": "\u300e\u30ab\u30a6\u30f3\u30c8 \u30de\u30b9\u30bf\u30fc\u30ba\uff1a\u30b9\u30c6\u30a3\u30c3\u30af\u30de\u30f3 \u30b2\u30fc\u30e0\u300f\u306e\u30a8\u30cd\u30eb\u30ae\u30fc\u30b7\u30b9\u30c6\u30e0\u306e\u5f79\u5272\u306f\u4f55\u3067\u3042\u308a\u3001\u3069\u306e\u3088\u3046\u306b\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u300e\u30ab\u30a6\u30f3\u30c8 \u30de\u30b9\u30bf\u30fc\u30ba\uff1a\u30b9\u30c6\u30a3\u30c3\u30af\u30de\u30f3 \u30b2\u30fc\u30e0\u300f\u306e\u30a8\u30cd\u30eb\u30ae\u30fc\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u5f85\u3061\u6642\u9593\u306a\u3057\u3067\u30d7\u30ec\u30a4\u3067\u304d\u308b\u56de\u6570\u3092\u5236\u9650\u3057\u307e\u3059\u3002\u5404\u30ec\u30d9\u30eb\u30671\u3064\u306e\u30a8\u30cd\u30eb\u30ae\u30fc\u304c\u6d88\u8cbb\u3055\u308c\u3001\u30a8\u30cd\u30eb\u30ae\u30fc\u306f\u6642\u9593\u306e\u7d4c\u904e\u3068\u3068\u3082\u306b\u56de\u5fa9\u3057\u307e\u3059\u3002\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3059\u308b\u306b\u306f\u3001\u518d\u751f\u30ec\u30fc\u30c8\uff085\u5206\u3054\u3068\u306b1\u30a8\u30cd\u30eb\u30ae\u30fc\uff09\u3092\u5ff5\u982d\u306b\u7f6e\u3044\u3066\u3001\u30b2\u30fc\u30e0\u30bb\u30c3\u30b7\u30e7\u30f3\u3092\u8a08\u753b\u3057\u307e\u3057\u3087\u3046\u3002\u305f\u3068\u3048\u3070\u3001\u30a8\u30cd\u30eb\u30ae\u30fc\u304c5\u3064\u3042\u308b\u5834\u5408\u30011\u3064\u306e\u30bb\u30c3\u30b7\u30e7\u30f3\u30675\u3064\u306e\u30ec\u30d9\u30eb\u3092\u30d7\u30ec\u30a4\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3088\u308a\u591a\u304f\u30d7\u30ec\u30a4\u3057\u305f\u3044\u5834\u5408\u306f\u3001\u30c7\u30a4\u30ea\u30fc\u30ea\u30ef\u30fc\u30c9\u307e\u305f\u306f\u30b2\u30fc\u30e0\u5185\u8cfc\u5165\u304b\u3089\u30a8\u30cd\u30eb\u30ae\u30fc\u88dc\u5145\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u6bd4\u8f03\uff1a\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u30d5\u30eb\u5145\u96fb\u3059\u308b\u306b\u306f2\u6642\u9593\u304b\u304b\u308a\u3001\u30a8\u30cd\u30eb\u30ae\u30fc\u88dc\u5145\u306f\u77ac\u6642\u306b\u56de\u5fa9\u3057\u307e\u3059\u3002]"}, {"question": "\u300e\u30ab\u30a6\u30f3\u30c8 \u30de\u30b9\u30bf\u30fc\u30ba\uff1a\u30b9\u30c6\u30a3\u30c3\u30af\u30de\u30f3 \u30b2\u30fc\u30e0\u300f\u3067\u7279\u5b9a\u306e\u30ec\u30d9\u30eb\u306e\u305f\u3081\u306b\u30b9\u30c6\u30a3\u30c3\u30af\u30de\u30f3\u306e\u88c5\u5099\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u300e\u30ab\u30a6\u30f3\u30c8 \u30de\u30b9\u30bf\u30fc\u30ba\uff1a\u30b9\u30c6\u30a3\u30c3\u30af\u30de\u30f3 \u30b2\u30fc\u30e0\u300f\u3067\u30b9\u30c6\u30a3\u30c3\u30af\u30de\u30f3\u306e\u88c5\u5099\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u30ec\u30d9\u30eb\u306e\u8ab2\u984c\u306b\u5408\u308f\u305b\u3066\u30ae\u30a2\u3068\u30b9\u30ad\u30eb\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6c37\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u6ed1\u308a\u3092\u6e1b\u3089\u3059\u305f\u3081\u306bFrost\u62b5\u6297\u9774\u3092\u88c5\u5099\u3057\u307e\u3059\u3002\u6728\u88fd\u306e\u6575\u306b\u3055\u3089\u306a\u308b\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u305f\u3081\u306b\u3001\u68ee\u306e\u30ec\u30d9\u30eb\u3067\u306f\u706b\u5263\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30ec\u30d9\u30eb\u306e\u6575\u3068\u5371\u967a\u6027\u3092\u5206\u6790\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u3053\u308c\u3089\u306e\u8ab2\u984c\u306b\u5bfe\u6297\u3059\u308b\u88c5\u5099\u3092\u88c5\u5099\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u88c5\u5099\u3092\u30c6\u30b9\u30c8\u3057\u3001\u5fc5\u8981\u306b\u5fdc\u3058\u3066\u8abf\u6574\u3057\u307e\u3059\u3002[\u624b\u9806\uff1a\u5206\u6790\u2192\u88c5\u5099\u2192\u30c6\u30b9\u30c8\u2192\u6700\u9069\u306a\u7d50\u679c\u306e\u305f\u3081\u306b\u8abf\u6574\u3057\u307e\u3059\u3002]"}, {"question": "\u300e\u30ab\u30a6\u30f3\u30c8 \u30de\u30b9\u30bf\u30fc\u30ba\uff1a\u30b9\u30c6\u30a3\u30c3\u30af\u30de\u30f3 \u30b2\u30fc\u30e0\u300f\u3067\u30b3\u30a4\u30f3\u3092\u52b9\u7387\u7684\u306b\u96c6\u3081\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u65b9\u6cd5\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u300e\u30ab\u30a6\u30f3\u30c8 \u30de\u30b9\u30bf\u30fc\u30ba\uff1a\u30b9\u30c6\u30a3\u30c3\u30af\u30de\u30f3 \u30b2\u30fc\u30e0\u300f\u3067\u52b9\u7387\u7684\u306b\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u308b\u306b\u306f\u3001\u53ce\u76ca\u6027\u306e\u9ad8\u3044\u30ec\u30d9\u30eb\u3092\u7e70\u308a\u8fd4\u3057\u30d7\u30ec\u30a4\u3057\u3001\u30c7\u30a4\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u5b8c\u4e86\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u9271\u5c71\u30ec\u30d9\u30eb\u3067\u306f\u3001\u6575\u3092\u5012\u3057\u3001\u5ca9\u3092\u7834\u58ca\u3059\u308b\u3053\u3068\u3067\u5927\u91cf\u306e\u30b3\u30a4\u30f3\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u3067\u304d\u308b\u3060\u3051\u65e9\u304f\u3001\u9ad8\u3044\u30b3\u30f3\u30dc\u3067\u30af\u30ea\u30a2\u3067\u304d\u308b\u30ec\u30d9\u30eb\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u53ce\u76ca\u3092\u6700\u5927\u5316\u3057\u307e\u3057\u3087\u3046\u3002\u3055\u3089\u306b\u3001\u30a4\u30d9\u30f3\u30c8\u306b\u53c2\u52a0\u3057\u305f\u308a\u3001\u5e83\u544a\u3092\u898b\u305f\u308a\u3057\u3066\u3001\u30dc\u30fc\u30ca\u30b9\u30b3\u30a4\u30f3\u3092\u7372\u5f97\u3057\u307e\u3057\u3087\u3046\u3002[\u4f8b\u3048\u8aac\u660e\uff1a\u30b3\u30a4\u30f3\u53ce\u96c6\u3092\u63a1\u6398\u306b\u4f8b\u3048\u308b\u3068\u3001\u6700\u9ad8\u306e\u53ce\u76ca\u3092\u5f97\u308b\u305f\u3081\u306b\u6700\u3082\u8c4a\u5bcc\u306a\u9271\u8108\u3092\u76ee\u6307\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002]"}]
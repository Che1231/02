[{"question": "\u5982\u4f55\u8b93\u65b0\u624b\u5728\u300a\u8a08\u6578\u5927\u5e2b\uff1a\u5c0f\u68cd\u4eba\u904a\u6232\u300b\u4e2d\u638c\u63e1\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u638c\u63e1\u300a\u8a08\u6578\u5927\u5e2b\uff1a\u5c0f\u68cd\u4eba\u904a\u6232\u300b\u7684\u57fa\u672c\u63a7\u5236\uff0c\u9996\u5148\u719f\u6089\u87a2\u5e55\u4e0a\u7684\u6309\u9215\u3002\u5de6\u5074\u63a7\u5236\u79fb\u52d5\uff08\u5de6\u53f3\uff09\uff0c\u53f3\u5074\u63a7\u5236\u8df3\u8e8d\u548c\u653b\u64ca\u7b49\u52d5\u4f5c\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u95dc\uff0c\u7df4\u7fd2\u79fb\u52d5\u5c0f\u68cd\u4eba\u4f86\u8eb2\u907f\u969c\u7919\u7269\uff0c\u4e26\u900f\u904e\u9ede\u64ca\u653b\u64ca\u6309\u9215\u4f86\u653b\u64ca\u6575\u4eba\u3002\u8a18\u4f4f\uff0c\u6642\u9593\u5f88\u91cd\u8981\u2014\u5728\u5230\u9054\u9593\u9699\u4e4b\u524d\u6309\u4e0b\u8df3\u8e8d\u6309\u9215\u624d\u80fd\u8de8\u8d8a\u5b83\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u63a7\u5236\u60f3\u50cf\u6210\u958b\u8eca\uff1b\u5e73\u9806\u800c\u8b39\u614e\u7684\u8f38\u5165\u6703\u5e36\u4f86\u66f4\u597d\u7684\u7d50\u679c\u3002]"}, {"question": "\u5728\u300a\u8a08\u6578\u5927\u5e2b\uff1a\u5c0f\u68cd\u4eba\u904a\u6232\u300b\u4e2d\u64ca\u6557\u9996\u9818\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u300a\u8a08\u6578\u5927\u5e2b\uff1a\u5c0f\u68cd\u4eba\u904a\u6232\u300b\u4e2d\u64ca\u6557\u9996\u9818\u9700\u8981\u6642\u9593\u548c\u7b56\u7565\u7684\u7d50\u5408\u3002\u6b65\u9a5f1\uff1a\u89c0\u5bdf\u9996\u9818\u7684\u653b\u64ca\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u68ee\u6797\u9996\u9818\u6bcf3\u79d2\u63ee\u821e\u6b66\u5668\u4e00\u6b21\u3002\u6b65\u9a5f2\uff1a\u5728\u5408\u9069\u7684\u6642\u9593\u79fb\u52d5\u6216\u8df3\u8e8d\u4f86\u8eb2\u907f\u653b\u64ca\u3002\u6b65\u9a5f3\uff1a\u5728\u9996\u9818\u51b7\u537b\u671f\u9593\u53cd\u64ca\u3002\u4f7f\u7528\u96d9\u500d\u50b7\u5bb3\u7b49\u589e\u76ca\u7269\u54c1\u4f86\u6700\u5927\u5316\u4f60\u7684\u653b\u64ca\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u67d0\u4e9b\u73a9\u5bb6\u504f\u597d\u9060\u7a0b\u653b\u64ca\uff0c\u800c\u53e6\u4e00\u4e9b\u5247\u4f9d\u8cf4\u8fd1\u6230\u2014\u5617\u8a66\u627e\u5230\u4f60\u7684\u98a8\u683c\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u7684\u5c0f\u68cd\u4eba\u5728\u300a\u8a08\u6578\u5927\u5e2b\uff1a\u5c0f\u68cd\u4eba\u904a\u6232\u300b\u4e2d\u6301\u7e8c\u640d\u5931\u751f\u547d\u503c\uff0c\u4ee5\u53ca\u5982\u4f55\u9810\u9632\uff1f", "answer": "\u5728\u300a\u8a08\u6578\u5927\u5e2b\uff1a\u5c0f\u68cd\u4eba\u904a\u6232\u300b\u4e2d\uff0c\u5c0f\u68cd\u4eba\u4e3b\u8981\u56e0\u6575\u4eba\u653b\u64ca\u548c\u74b0\u5883\u5371\u5bb3\u800c\u640d\u5931\u751f\u547d\u503c\u3002\u70ba\u4e86\u9810\u9632\uff0c\u96a8\u6642\u6ce8\u610f\u6575\u4eba\u7684\u8972\u64ca\u3002\u4f8b\u5982\uff0c\u5728\u7194\u5ca9\u95dc\u5361\u4e2d\uff0c\u907f\u514d\u8e29\u8e0f\u71b1\u706b\u9762\uff0c\u901a\u904e\u8df3\u8e8d\u8de8\u904e\u5b83\u5011\u3002\u5f9e\u5546\u5e97\u8cfc\u8cb7\u88dd\u7532\u5347\u7d1a\u4ee5\u589e\u5f37\u4f60\u7684\u751f\u547d\u503c\u6c60\u3002\u6b64\u5916\uff0c\u7576\u751f\u547d\u503c\u4f4e\u6642\uff0c\u4f7f\u7528\u50cf\u751f\u547d\u85e5\u6c34\u9019\u6a23\u7684\u6062\u5fa9\u7269\u54c1\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6bd4\u8f03\u88dd\u7532\u7684\u5c6c\u6027\u2014\u9752\u9285\u88dd\u7532\u589e\u52a0 +50 \u751f\u547d\u503c\uff0c\u800c\u9ec3\u91d1\u88dd\u7532\u589e\u52a0 +100 \u751f\u547d\u503c\u3002]"}, {"question": "\u5728\u300a\u8a08\u6578\u5927\u5e2b\uff1a\u5c0f\u68cd\u4eba\u904a\u6232\u300b\u4e2d\uff0c\u70ba\u4e86\u66f4\u5feb\u5730\u9032\u5ea6\uff0c\u6211\u61c9\u8a72\u512a\u5148\u5347\u7d1a\u54ea\u4e9b\u88dd\u5099\uff1f", "answer": "\u5728\u300a\u8a08\u6578\u5927\u5e2b\uff1a\u5c0f\u68cd\u4eba\u904a\u6232\u300b\u4e2d\uff0c\u512a\u5148\u5347\u7d1a\u80fd\u63d0\u9ad8\u5c0f\u68cd\u4eba\u5b58\u6d3b\u80fd\u529b\u548c\u50b7\u5bb3\u8f38\u51fa\u88dd\u5099\u3002\u9996\u5148\u5c08\u6ce8\u65bc\u751f\u547d\u503c\u5347\u7d1a\u4ee5\u589e\u52a0\u4f60\u7684\u6700\u5927\u751f\u547d\u503c\uff0c\u8b93\u4f60\u627f\u53d7\u66f4\u591a\u653b\u64ca\u3002\u63a5\u4e0b\u4f86\uff0c\u6295\u8cc7\u65bc\u653b\u64ca\u5347\u7d1a\u4ee5\u5c0d\u6575\u4eba\u9020\u6210\u66f4\u591a\u50b7\u5bb3\u3002\u4f8b\u5982\uff0c\u4e09\u7d1a\u653b\u64ca\u5347\u7d1a\u53ef\u4ee5\u5e6b\u52a9\u4f60\u5728\u8f03\u5c11\u6b21\u6578\u7684\u653b\u64ca\u4e0b\u64ca\u6557\u6d1e\u7a74\u9996\u9818\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u5f9e\u751f\u547d\u503c \u2192 \u653b\u64ca \u2192 \u901f\u5ea6\u958b\u59cb\uff0c\u5be6\u73fe\u5747\u8861\u7684\u9032\u5ea6\u3002]"}, {"question": "\u300a\u8a08\u6578\u5927\u5e2b\uff1a\u5c0f\u68cd\u4eba\u904a\u6232\u300b\u7684\u5206\u6578\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u5927\u5316\u5f97\u5206\uff1f", "answer": "\u300a\u8a08\u6578\u5927\u5e2b\uff1a\u5c0f\u68cd\u4eba\u904a\u6232\u300b\u7684\u5206\u6578\u7cfb\u7d71\u57fa\u65bc\u6575\u4eba\u64ca\u6bba\u3001\u9023\u64ca\u548c\u5b8c\u6210\u95dc\u5361\u6240\u82b1\u8cbb\u7684\u6642\u9593\u7b49\u56e0\u7d20\u3002\u70ba\u4e86\u6700\u5927\u5316\u5f97\u5206\uff0c\u8a66\u5716\u901a\u904e\u5feb\u901f\u9023\u7e8c\u64ca\u6557\u591a\u500b\u6575\u4eba\u4f86\u7372\u5f97\u9ad8\u9023\u64ca\u3002\u4f8b\u5982\uff0c\u5728\u6c99\u6f20\u95dc\u5361\u4e2d\uff0c\u5c07\u6575\u4eba\u805a\u96c6\u5728\u4e00\u8d77\u4e26\u4f7f\u7528\u5ee3\u57df\u653b\u64ca\u4f86\u7372\u5f97 10 \u500d\u9023\u64ca\u3002\u6b64\u5916\uff0c\u5feb\u901f\u5b8c\u6210\u95dc\u5361\u4ee5\u7372\u5f97\u6642\u9593\u734e\u52f5\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u9023\u64ca\u60f3\u50cf\u6210\u5806\u758a\u7a4d\u6728\u2014\u6bcf\u6b21\u6210\u529f\u7684\u547d\u4e2d\u90fd\u6703\u589e\u52a0\u4f60\u7684\u5efa\u7bc9\u9ad8\u5ea6\u3002]"}, {"question": "\u300a\u8a08\u6578\u5927\u5e2b\uff1a\u5c0f\u68cd\u4eba\u904a\u6232\u300b\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u6210\u5c31\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9396\uff1f", "answer": "\u300a\u8a08\u6578\u5927\u5e2b\uff1a\u5c0f\u68cd\u4eba\u904a\u6232\u300b\u5177\u6709\u9700\u8981\u7279\u5b9a\u52d5\u4f5c\u624d\u80fd\u7372\u5f97\u7684\u5e7e\u500b\u96b1\u85cf\u6210\u5c31\u3002\u4f8b\u5982\uff0c\u300c\u5927\u5e2b\u7b56\u7565\u5bb6\u300d\u6210\u5c31\u89e3\u9396\u65bc\u5728\u4e0d\u53d7\u5230\u4efb\u4f55\u640d\u50b7\u7684\u60c5\u6cc1\u4e0b\u64ca\u6557\u4e00\u4f4d\u9996\u9818\u3002\u8981\u505a\u5230\u9019\u4e00\u9ede\uff0c\u8acb\u7814\u7a76\u9996\u9818\u7684\u6a21\u5f0f\u4e26\u7cbe\u78ba\u8a08\u7b97\u4f60\u7684\u8eb2\u907f\u6642\u9593\u3002\u53e6\u4e00\u500b\u96b1\u85cf\u6210\u5c31\u300c\u5bf6\u85cf\u7375\u4eba\u300d\u9700\u8981\u4f60\u5728\u55ae\u4e00\u95dc\u5361\u4e2d\u6536\u96c6\u6240\u6709\u96b1\u85cf\u7684\u786c\u5e63\u3002\u63a2\u7d22\u89d2\u843d\u4e26\u4f7f\u7528\u4f60\u7684\u5730\u5716\u4f86\u627e\u5230\u5b83\u5011\u3002[\u5f69\u86cb\u6316\u6398\uff1a\u4e00\u4e9b\u786c\u5e63\u96b1\u85cf\u5728\u53ef\u7834\u58de\u7684\u7246\u58c1\u5f8c\u9762\u2014\u4f7f\u7528\u4f60\u7684\u653b\u64ca\u4f86\u63ed\u9732\u5b83\u5011\u3002]"}, {"question": "\u5982\u4f55\u5c07\u6211\u5728\u300a\u8a08\u6578\u5927\u5e2b\uff1a\u5c0f\u68cd\u4eba\u904a\u6232\u300b\u4e2d\u7684\u9032\u5ea6\u8f49\u79fb\u5230\u65b0\u8a2d\u5099\uff1f", "answer": "\u5c07\u4f60\u5728\u300a\u8a08\u6578\u5927\u5e2b\uff1a\u5c0f\u68cd\u4eba\u904a\u6232\u300b\u4e2d\u7684\u9032\u5ea6\u8f49\u79fb\u5230\u65b0\u8a2d\u5099\uff0c\u8acb\u78ba\u4fdd\u4f60\u5728\u5169\u500b\u8a2d\u5099\u4e0a\u90fd\u767b\u9304\u540c\u4e00\u500b\u5e33\u6236\u3002\u5927\u591a\u6578\u73a9\u5bb6\u4f7f\u7528 Google Play \u6216 Apple Game Center \u4f86\u5be6\u73fe\u7121\u7e2b\u540c\u6b65\u3002\u5728\u5207\u63db\u4e4b\u524d\uff0c\u8acb\u900f\u904e\u8a2a\u554f\u904a\u6232\u8a2d\u5b9a\u4e26\u9078\u64c7\u300e\u96f2\u7aef\u5132\u5b58\u300d\u4f86\u624b\u52d5\u5132\u5b58\u4f60\u7684\u9032\u5ea6\u3002\u5728\u65b0\u8a2d\u5099\u4e0a\u767b\u9304\u4e26\u4e0b\u8f09\u5132\u5b58\u7684\u8cc7\u6599\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1aGoogle Play \u975e\u5e38\u9069\u5408 Android\uff0c\u800c Apple Game Center \u6700\u9069\u5408 iOS\u3002]"}, {"question": "\u80fd\u6e90\u7cfb\u7d71\u5728\u300a\u8a08\u6578\u5927\u5e2b\uff1a\u5c0f\u68cd\u4eba\u904a\u6232\u300b\u4e2d\u626e\u6f14\u4ec0\u9ebc\u89d2\u8272\uff0c\u4ee5\u53ca\u5982\u4f55\u6709\u6548\u5730\u7ba1\u7406\u5b83\uff1f", "answer": "\u300a\u8a08\u6578\u5927\u5e2b\uff1a\u5c0f\u68cd\u4eba\u904a\u6232\u300b\u4e2d\u7684\u80fd\u91cf\u7cfb\u7d71\u9650\u5236\u4e86\u4f60\u6c92\u6709\u7b49\u5f85\u7684\u60c5\u6cc1\u4e0b\u73a9\u7684\u983b\u7387\u3002\u6bcf\u95dc\u5361\u6d88\u8017 1 \u9ede\u80fd\u91cf\uff0c\u80fd\u91cf\u6703\u96a8\u8457\u6642\u9593\u518d\u751f\u3002\u70ba\u4e86\u6709\u6548\u5730\u7ba1\u7406\u5b83\uff0c\u8acb\u6839\u64da\u518d\u751f\u7387\uff08\u6bcf 5 \u5206\u9418\u518d\u751f 1 \u9ede\u80fd\u91cf\uff09\u898f\u5283\u4f60\u7684\u904a\u6232\u6642\u6bb5\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u6709 5 \u9ede\u80fd\u91cf\uff0c\u4f60\u53ef\u4ee5\u5728\u4e00\u500b\u6703\u8a71\u4e2d\u73a9 5 \u95dc\u5361\u3002\u5982\u679c\u60f3\u73a9\u66f4\u591a\uff0c\u53ef\u4ee5\u5229\u7528\u6bcf\u65e5\u734e\u52f5\u6216\u904a\u6232\u5167\u8cfc\u8cb7\u4f86\u88dc\u5145\u80fd\u91cf\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u5b8c\u5168\u80fd\u91cf\u9700\u8981 2 \u500b\u5c0f\u6642\u624d\u80fd\u6062\u5fa9\uff0c\u800c\u80fd\u91cf\u88dc\u5145\u53ef\u7acb\u5373\u6062\u5fa9\u5b83\u5011\u3002]"}, {"question": "\u5982\u4f55\u5728\u300a\u8a08\u6578\u5927\u5e2b\uff1a\u5c0f\u68cd\u4eba\u904a\u6232\u300b\u4e2d\u91dd\u5c0d\u7279\u5b9a\u95dc\u5361\u6700\u4f73\u5316\u5c0f\u68cd\u4eba\u7684\u88dd\u5099\uff1f", "answer": "\u5728\u300a\u8a08\u6578\u5927\u5e2b\uff1a\u5c0f\u68cd\u4eba\u904a\u6232\u300b\u4e2d\u6700\u4f73\u5316\u4f60\u7684\u5c0f\u68cd\u4eba\u88dd\u5099\uff0c\u9700\u8981\u6839\u64da\u95dc\u5361\u7684\u6311\u6230\uff0c\u8abf\u6574\u4f60\u7684\u88dd\u5099\u548c\u6280\u80fd\u3002\u4f8b\u5982\uff0c\u5728\u51b0\u96ea\u95dc\u5361\u4e2d\uff0c\u88dd\u5099\u300c\u9632\u5bd2\u9774\u300d\u4f86\u6e1b\u5c11\u6ed1\u5012\u3002\u5728\u68ee\u6797\u95dc\u5361\u4e2d\u4f7f\u7528\u300c\u706b\u7130\u528d\u300d\u4ee5\u984d\u5916\u50b7\u5bb3\u6728\u982d\u6575\u4eba\u3002\u6b65\u9a5f1\uff1a\u5206\u6790\u95dc\u5361\u7684\u6575\u4eba\u548c\u969c\u7919\u7269\u3002\u6b65\u9a5f2\uff1a\u7a7f\u6234\u53ef\u4ee5\u61c9\u5c0d\u9019\u4e9b\u6311\u6230\u7684\u88dd\u5099\u3002\u6b65\u9a5f3\uff1a\u6e2c\u8a66\u4f60\u7684\u88dd\u5099\u4e26\u6839\u64da\u9700\u8981\u8abf\u6574\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u5206\u6790 \u2192 \u88dd\u5099 \u2192 \u6e2c\u8a66 \u2192 \u8abf\u6574\u624d\u80fd\u7372\u5f97\u6700\u4f73\u7d50\u679c\u3002]"}, {"question": "\u5728\u300a\u8a08\u6578\u5927\u5e2b\uff1a\u5c0f\u68cd\u4eba\u904a\u6232\u300b\u4e2d\uff0c\u6700\u6709\u6548\u7684\u8cfa\u53d6\u786c\u5e63\u65b9\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u300a\u8a08\u6578\u5927\u5e2b\uff1a\u5c0f\u68cd\u4eba\u904a\u6232\u300b\u4e2d\u6709\u6548\u5730\u8cfa\u53d6\u786c\u5e63\uff0c\u9700\u8981\u91cd\u73a9\u9ad8\u6536\u76ca\u95dc\u5361\u4e26\u5b8c\u6210\u6bcf\u65e5\u6311\u6230\u3002\u4f8b\u5982\uff0c\u7926\u4e95\u95dc\u5361\u63d0\u4f9b\u5927\u91cf\u786c\u5e63\uff0c\u7528\u65bc\u64ca\u6557\u6575\u4eba\u548c\u7834\u58de\u5ca9\u77f3\u3002\u5c08\u6ce8\u65bc\u4f60\u80fd\u5920\u5feb\u901f\u5b8c\u6210\u4e26\u64c1\u6709\u9ad8\u9023\u64ca\u7684\u95dc\u5361\uff0c\u4ee5\u6700\u5927\u5316\u4f60\u7684\u6536\u5165\u3002\u6b64\u5916\uff0c\u53c3\u8207\u6d3b\u52d5\u548c\u89c0\u770b\u5ee3\u544a\u4ee5\u7372\u5f97\u984d\u5916\u786c\u5e63\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u8cfa\u53d6\u786c\u5e63\u60f3\u50cf\u6210\u63a1\u7926\u2014\u91dd\u5c0d\u6700\u5bcc\u6709\u7684\u7926\u8108\u4ee5\u7372\u5f97\u6700\u4f73\u56de\u5831\u3002]"}]
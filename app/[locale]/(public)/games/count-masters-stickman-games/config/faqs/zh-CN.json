[{"question": "\u65b0\u624b\u5982\u4f55\u638c\u63e1\u300a\u6570\u7801\u5927\u5e08\uff1a\u5c0f\u68cd\u4eba\u6e38\u620f\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u638c\u63e1\u300a\u6570\u7801\u5927\u5e08\uff1a\u5c0f\u68cd\u4eba\u6e38\u620f\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u9996\u5148\u8981\u719f\u6089\u5c4f\u5e55\u4e0a\u7684\u6309\u94ae\u3002\u5de6\u4fa7\u63a7\u5236\u79fb\u52a8\uff08\u5de6\u53f3\uff09\uff0c\u53f3\u4fa7\u63a7\u5236\u52a8\u4f5c\uff0c\u4f8b\u5982\u8df3\u8dc3\u548c\u653b\u51fb\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u5173\uff0c\u7ec3\u4e60\u79fb\u52a8\u4f60\u7684\u5c0f\u68cd\u4eba\u6765\u8eb2\u907f\u969c\u788d\u7269\uff0c\u5e76\u901a\u8fc7\u70b9\u51fb\u653b\u51fb\u6309\u94ae\u653b\u51fb\u654c\u4eba\u3002\u8bb0\u4f4f\uff0c\u65f6\u673a\u5f88\u91cd\u8981\u2014\u2014\u5728\u5230\u8fbe\u7a7a\u9699\u4e4b\u524d\u6309\u4e0b\u8df3\u8dc3\u6309\u94ae\u624d\u80fd\u8de8\u8d8a\u5b83\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u628a\u8fd9\u4e9b\u64cd\u4f5c\u60f3\u8c61\u6210\u5f00\u8f66\uff1b\u5e73\u7a33\u800c\u6709\u76ee\u7684\u7684\u8f93\u5165\u624d\u80fd\u83b7\u5f97\u66f4\u597d\u7684\u7ed3\u679c\u3002]"}, {"question": "\u5728\u300a\u6570\u7801\u5927\u5e08\uff1a\u5c0f\u68cd\u4eba\u6e38\u620f\u300b\u4e2d\u51fb\u8d25\u9996\u9886\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300a\u6570\u7801\u5927\u5e08\uff1a\u5c0f\u68cd\u4eba\u6e38\u620f\u300b\u4e2d\u51fb\u8d25\u9996\u9886\u9700\u8981\u7ed3\u5408\u65f6\u673a\u548c\u7b56\u7565\u3002\u6b65\u9aa4\u4e00\uff1a\u89c2\u5bdf\u9996\u9886\u7684\u653b\u51fb\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u68ee\u6797\u9996\u9886\u6bcf\u96943\u79d2\u6325\u52a8\u6b66\u5668\u4e00\u6b21\u3002\u6b65\u9aa4\u4e8c\uff1a\u5728\u5408\u9002\u7684\u65f6\u673a\u8eb2\u907f\u653b\u51fb\uff0c\u53ef\u4ee5\u901a\u8fc7\u79fb\u52a8\u6216\u8df3\u8dc3\u6765\u8eb2\u907f\u653b\u51fb\u3002\u6b65\u9aa4\u4e09\uff1a\u5728\u9996\u9886\u51b7\u5374\u671f\u95f4\u53cd\u51fb\u3002\u4f7f\u7528\u4f8b\u5982\u53cc\u500d\u4f24\u5bb3\u4e4b\u7c7b\u7684\u589e\u76ca\u9053\u5177\u6765\u6700\u5927\u5316\u4f60\u7684\u653b\u51fb\u529b\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u4e00\u4e9b\u73a9\u5bb6\u559c\u6b22\u8fdc\u7a0b\u653b\u51fb\uff0c\u800c\u53e6\u4e00\u4e9b\u73a9\u5bb6\u5219\u4f9d\u8d56\u8fd1\u6218\u2014\u2014\u5c1d\u8bd5\u627e\u5230\u9002\u5408\u4f60\u7684\u98ce\u683c\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u7684\u5c0f\u68cd\u4eba\u5728\u300a\u6570\u7801\u5927\u5e08\uff1a\u5c0f\u68cd\u4eba\u6e38\u620f\u300b\u4e2d\u6301\u7eed\u6389\u8840\uff0c\u4ee5\u53ca\u5982\u4f55\u9632\u6b62\u8fd9\u79cd\u60c5\u51b5\uff1f", "answer": "\u5728\u300a\u6570\u7801\u5927\u5e08\uff1a\u5c0f\u68cd\u4eba\u6e38\u620f\u300b\u4e2d\uff0c\u4f60\u7684\u5c0f\u68cd\u4eba\u4e3b\u8981\u7531\u4e8e\u654c\u4eba\u7684\u653b\u51fb\u548c\u73af\u5883\u7684\u5371\u5bb3\u800c\u6389\u8840\u3002\u4e3a\u4e86\u9632\u6b62\u8fd9\u79cd\u60c5\u51b5\uff0c\u8bf7\u65f6\u523b\u6ce8\u610f\u5373\u5c06\u5230\u6765\u7684\u5a01\u80c1\u3002\u4f8b\u5982\uff0c\u5728\u7194\u5ca9\u5173\u5361\u4e2d\uff0c\u901a\u8fc7\u8df3\u8fc7\u70ed\u8868\u9762\u6765\u907f\u514d\u8e29\u5230\u70ed\u8868\u9762\u3002\u4ece\u5546\u5e97\u88c5\u5907\u76d4\u7532\u5347\u7ea7\uff0c\u4ee5\u589e\u52a0\u4f60\u7684\u8840\u91cf\u4e0a\u9650\u3002\u6b64\u5916\uff0c\u5f53\u4f60\u7684\u8840\u91cf\u4e0b\u964d\u65f6\uff0c\u53ef\u4ee5\u4f7f\u7528\u6cbb\u7597\u7269\u54c1\uff0c\u4f8b\u5982\u6d3b\u529b\u836f\u5242\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6bd4\u8f83\u76d4\u7532\u5c5e\u6027\u2014\u2014\u9752\u94dc\u76d4\u7532\u52a050\u70b9\u751f\u547d\u503c\uff0c\u800c\u9ec4\u91d1\u76d4\u7532\u5219\u52a0100\u70b9\u751f\u547d\u503c\u3002]"}, {"question": "\u5728\u300a\u6570\u7801\u5927\u5e08\uff1a\u5c0f\u68cd\u4eba\u6e38\u620f\u300b\u4e2d\uff0c\u4e3a\u4e86\u66f4\u5feb\u5730\u63d0\u5347\uff0c\u5e94\u8be5\u4f18\u5148\u5347\u7ea7\u54ea\u4e9b\u9053\u5177\uff1f", "answer": "\u5728\u300a\u6570\u7801\u5927\u5e08\uff1a\u5c0f\u68cd\u4eba\u6e38\u620f\u300b\u4e2d\uff0c\u4f18\u5148\u5347\u7ea7\u80fd\u589e\u5f3a\u5c0f\u68cd\u4eba\u751f\u5b58\u80fd\u529b\u548c\u4f24\u5bb3\u8f93\u51fa\u7684\u9053\u5177\u3002\u9996\u5148\u4e13\u6ce8\u4e8e\u751f\u547d\u503c\u5347\u7ea7\uff0c\u4ee5\u589e\u52a0\u4f60\u7684\u6700\u5927\u751f\u547d\u503c\uff0c\u8ba9\u4f60\u80fd\u627f\u53d7\u66f4\u591a\u653b\u51fb\u3002\u5176\u6b21\uff0c\u6295\u8d44\u4e8e\u653b\u51fb\u5347\u7ea7\uff0c\u4ee5\u5bf9\u654c\u4eba\u9020\u6210\u66f4\u591a\u4f24\u5bb3\u3002\u4f8b\u5982\uff0c\u7b49\u7ea73\u7684\u653b\u51fb\u5347\u7ea7\u53ef\u4ee5\u5e2e\u52a9\u4f60\u5728\u66f4\u5c11\u7684\u653b\u51fb\u6b21\u6570\u5185\u51fb\u8d25\u6d1e\u7a74\u9996\u9886\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u4ece\u751f\u547d\u503c\u2192\u653b\u51fb\u2192\u901f\u5ea6\u5f00\u59cb\uff0c\u83b7\u5f97\u5e73\u8861\u7684\u63d0\u5347\u3002]"}, {"question": "\u300a\u6570\u7801\u5927\u5e08\uff1a\u5c0f\u68cd\u4eba\u6e38\u620f\u300b\u4e2d\u7684\u5f97\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u5927\u5316\u6211\u7684\u5f97\u5206\uff1f", "answer": "\u300a\u6570\u7801\u5927\u5e08\uff1a\u5c0f\u68cd\u4eba\u6e38\u620f\u300b\u4e2d\u7684\u5f97\u5206\u7cfb\u7edf\u57fa\u4e8e\u654c\u4eba\u7684\u51fb\u6740\u6570\u3001\u8fde\u51fb\u6570\u548c\u5b8c\u6210\u5173\u5361\u6240\u9700\u7684\u65f6\u95f4\u7b49\u56e0\u7d20\u3002\u4e3a\u4e86\u6700\u5927\u5316\u4f60\u7684\u5f97\u5206\uff0c\u901a\u8fc7\u5feb\u901f\u8fde\u7eed\u51fb\u8d25\u591a\u4e2a\u654c\u4eba\u6765\u83b7\u5f97\u9ad8\u8fde\u51fb\u6570\u3002\u4f8b\u5982\uff0c\u5728\u6c99\u6f20\u5173\u5361\u4e2d\uff0c\u5c06\u654c\u4eba\u805a\u96c6\u5728\u4e00\u8d77\uff0c\u5e76\u4f7f\u7528\u5e7f\u57df\u653b\u51fb\u6765\u83b7\u5f9710\u500d\u8fde\u51fb\u3002\u6b64\u5916\uff0c\u5feb\u901f\u5b8c\u6210\u5173\u5361\u4ee5\u83b7\u5f97\u65f6\u95f4\u5956\u52b1\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u628a\u8fde\u51fb\u60f3\u8c61\u6210\u53e0\u653e\u79ef\u6728\u2014\u2014\u6bcf\u6b21\u6210\u529f\u7684\u51fb\u6740\u90fd\u4f1a\u589e\u52a0\u4f60\u7684\u9ad8\u5854\u3002]"}, {"question": "\u300a\u6570\u7801\u5927\u5e08\uff1a\u5c0f\u68cd\u4eba\u6e38\u620f\u300b\u4e2d\u7684\u9690\u85cf\u6210\u5c31\u6709\u54ea\u4e9b\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9501\u5b83\u4eec\uff1f", "answer": "\u300a\u6570\u7801\u5927\u5e08\uff1a\u5c0f\u68cd\u4eba\u6e38\u620f\u300b\u4e2d\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u6210\u5c31\uff0c\u9700\u8981\u5b8c\u6210\u7279\u5b9a\u52a8\u4f5c\u624d\u80fd\u89e3\u9501\u3002\u4f8b\u5982\uff0c\u201c\u5927\u5e08\u7b56\u7565\u5bb6\u201d\u6210\u5c31\u9700\u8981\u5728\u4e0d\u53d7\u5230\u4efb\u4f55\u4f24\u5bb3\u7684\u60c5\u51b5\u4e0b\u51fb\u8d25\u9996\u9886\u3002\u8981\u505a\u5230\u8fd9\u4e00\u70b9\uff0c\u8bf7\u7814\u7a76\u9996\u9886\u7684\u6a21\u5f0f\u5e76\u5b8c\u7f8e\u5730\u8ba1\u7b97\u4f60\u7684\u8eb2\u907f\u65f6\u673a\u3002\u53e6\u4e00\u4e2a\u9690\u85cf\u6210\u5c31\u201c\u5b9d\u85cf\u730e\u4eba\u201d\uff0c\u9700\u8981\u4f60\u5728\u5355\u4e2a\u5173\u5361\u4e2d\u6536\u96c6\u6240\u6709\u9690\u85cf\u786c\u5e01\u3002\u63a2\u7d22\u6bcf\u4e00\u4e2a\u89d2\u843d\uff0c\u5e76\u4f7f\u7528\u4f60\u7684\u5730\u56fe\u6765\u627e\u5230\u5b83\u4eec\u3002[\u5f69\u86cb\u6316\u6398\uff1a\u90e8\u5206\u786c\u5e01\u9690\u85cf\u5728\u53ef\u7834\u574f\u7684\u5899\u58c1\u540e\u9762\u2014\u2014\u4f7f\u7528\u4f60\u7684\u653b\u51fb\u6765\u63ed\u793a\u5b83\u4eec\u3002]"}, {"question": "\u5982\u4f55\u5c06\u300a\u6570\u7801\u5927\u5e08\uff1a\u5c0f\u68cd\u4eba\u6e38\u620f\u300b\u7684\u8fdb\u5ea6\u8f6c\u79fb\u5230\u65b0\u8bbe\u5907\uff1f", "answer": "\u5c06\u300a\u6570\u7801\u5927\u5e08\uff1a\u5c0f\u68cd\u4eba\u6e38\u620f\u300b\u7684\u8fdb\u5ea6\u8f6c\u79fb\u5230\u65b0\u8bbe\u5907\uff0c\u8bf7\u786e\u4fdd\u4f60\u5728\u4e24\u53f0\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u5e10\u6237\u3002\u5927\u591a\u6570\u73a9\u5bb6\u4f7f\u7528Google Play\u6216Apple Game Center\u8fdb\u884c\u65e0\u7f1d\u540c\u6b65\u3002\u5728\u5207\u6362\u4e4b\u524d\uff0c\u8bf7\u901a\u8fc7\u8bbf\u95ee\u6e38\u620f\u8bbe\u7f6e\u5e76\u9009\u62e9\u201c\u4e91\u4fdd\u5b58\u201d\u6765\u624b\u52a8\u4fdd\u5b58\u60a8\u7684\u8fdb\u5ea6\u3002\u5728\u65b0\u8bbe\u5907\u4e0a\u767b\u5f55\u5e76\u4e0b\u8f7d\u4fdd\u5b58\u7684\u6570\u636e\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1aGoogle Play\u975e\u5e38\u9002\u5408Android\u8bbe\u5907\uff0c\u800cApple Game Center\u5219\u66f4\u9002\u5408iOS\u8bbe\u5907\u3002]"}, {"question": "\u300a\u6570\u7801\u5927\u5e08\uff1a\u5c0f\u68cd\u4eba\u6e38\u620f\u300b\u4e2d\u7684\u80fd\u91cf\u7cfb\u7edf\u6709\u4ec0\u4e48\u4f5c\u7528\uff0c\u4ee5\u53ca\u5982\u4f55\u6709\u6548\u5730\u7ba1\u7406\u5b83\uff1f", "answer": "\u300a\u6570\u7801\u5927\u5e08\uff1a\u5c0f\u68cd\u4eba\u6e38\u620f\u300b\u4e2d\u7684\u80fd\u91cf\u7cfb\u7edf\u9650\u5236\u4f60\u73a9\u6e38\u620f\u800c\u4e0d\u9700\u7b49\u5f85\u7684\u9891\u7387\u3002\u6bcf\u4e2a\u5173\u5361\u6d88\u80171\u70b9\u80fd\u91cf\uff0c\u80fd\u91cf\u4f1a\u5728\u4e00\u6bb5\u65f6\u95f4\u5185\u6062\u590d\u3002\u4e3a\u4e86\u6709\u6548\u5730\u7ba1\u7406\u5b83\uff0c\u8bf7\u6839\u636e\u6062\u590d\u7387\uff08\u6bcf5\u5206\u949f\u6062\u590d1\u70b9\u80fd\u91cf\uff09\u89c4\u5212\u4f60\u7684\u6e38\u620f\u65f6\u95f4\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u67095\u70b9\u80fd\u91cf\uff0c\u4f60\u53ef\u4ee5\u5728\u4e00\u4e2a\u6e38\u620f\u4e2d\u73a95\u4e2a\u5173\u5361\u3002\u5982\u679c\u4f60\u60f3\u73a9\u66f4\u591a\u6e38\u620f\uff0c\u53ef\u4ee5\u4f7f\u7528\u6bcf\u65e5\u5956\u52b1\u6216\u6e38\u620f\u4e2d\u8d2d\u4e70\u7684\u80fd\u91cf\u8865\u5145\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u5145\u6ee1\u80fd\u91cf\u9700\u89812\u5c0f\u65f6\u624d\u80fd\u6062\u590d\uff0c\u800c\u80fd\u91cf\u8865\u5145\u5219\u4f1a\u7acb\u5373\u6062\u590d\u5b83\u3002]"}, {"question": "\u5982\u4f55\u5728\u300a\u6570\u7801\u5927\u5e08\uff1a\u5c0f\u68cd\u4eba\u6e38\u620f\u300b\u4e2d\u9488\u5bf9\u7279\u5b9a\u5173\u5361\u4f18\u5316\u5c0f\u68cd\u4eba\u7684\u88c5\u5907\uff1f", "answer": "\u5728\u300a\u6570\u7801\u5927\u5e08\uff1a\u5c0f\u68cd\u4eba\u6e38\u620f\u300b\u4e2d\u4f18\u5316\u5c0f\u68cd\u4eba\u7684\u88c5\u5907\u6d89\u53ca\u6839\u636e\u5173\u5361\u7684\u6311\u6218\u6765\u5b9a\u5236\u4f60\u7684\u88c5\u5907\u548c\u6280\u80fd\u3002\u4f8b\u5982\uff0c\u5728\u51b0\u96ea\u5173\u5361\u4e2d\uff0c\u88c5\u5907\u201c\u8010\u5bd2\u9774\u201d\u6765\u51cf\u5c11\u6ed1\u5012\u3002\u5728\u68ee\u6797\u5173\u5361\u4e2d\u4f7f\u7528\u201c\u706b\u5251\u201d\u5bf9\u6728\u5934\u654c\u4eba\u9020\u6210\u989d\u5916\u4f24\u5bb3\u3002\u6b65\u9aa4\u4e00\uff1a\u5206\u6790\u5173\u5361\u7684\u654c\u4eba\u548c\u969c\u788d\u3002\u6b65\u9aa4\u4e8c\uff1a\u88c5\u5907\u80fd\u591f\u5e94\u5bf9\u8fd9\u4e9b\u6311\u6218\u7684\u88c5\u5907\u3002\u6b65\u9aa4\u4e09\uff1a\u6d4b\u8bd5\u4f60\u7684\u88c5\u5907\uff0c\u5e76\u5728\u5fc5\u8981\u65f6\u8fdb\u884c\u8c03\u6574\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u5206\u6790\u2192\u88c5\u5907\u2192\u6d4b\u8bd5\u2192\u8c03\u6574\uff0c\u4ee5\u83b7\u5f97\u6700\u4f73\u7ed3\u679c\u3002]"}, {"question": "\u5728\u300a\u6570\u7801\u5927\u5e08\uff1a\u5c0f\u68cd\u4eba\u6e38\u620f\u300b\u4e2d\uff0c\u83b7\u5f97\u786c\u5e01\u7684\u6700\u6709\u6548\u65b9\u6cd5\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300a\u6570\u7801\u5927\u5e08\uff1a\u5c0f\u68cd\u4eba\u6e38\u620f\u300b\u4e2d\u6709\u6548\u5730\u83b7\u53d6\u786c\u5e01\uff0c\u9700\u8981\u91cd\u590d\u73a9\u9ad8\u56de\u62a5\u7387\u7684\u5173\u5361\u5e76\u5b8c\u6210\u6bcf\u65e5\u6311\u6218\u3002\u4f8b\u5982\uff0c\u77ff\u573a\u5173\u5361\u4e3a\u51fb\u8d25\u654c\u4eba\u548c\u7834\u574f\u5ca9\u77f3\u63d0\u4f9b\u4e86\u5927\u91cf\u786c\u5e01\u3002\u4e13\u6ce8\u4e8e\u4f60\u80fd\u5feb\u901f\u4e14\u83b7\u5f97\u9ad8\u8fde\u51fb\u6570\u7684\u5173\u5361\uff0c\u4ee5\u6700\u5927\u5316\u4f60\u7684\u6536\u76ca\u3002\u6b64\u5916\uff0c\u53c2\u4e0e\u6d3b\u52a8\u548c\u89c2\u770b\u5e7f\u544a\u4ee5\u83b7\u5f97\u989d\u5916\u5956\u52b1\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u628a\u83b7\u53d6\u786c\u5e01\u60f3\u8c61\u6210\u91c7\u77ff\u2014\u2014\u76ee\u6807\u662f\u83b7\u53d6\u6700\u4e30\u5bcc\u7684\u77ff\u8109\uff0c\u4ee5\u83b7\u5f97\u6700\u4f73\u56de\u62a5\u3002]"}]
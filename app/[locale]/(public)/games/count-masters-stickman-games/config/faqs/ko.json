[{"question": "\ucd08\uc2ec\uc790\ub85c\uc11c \uc2a4\ud2f1\ub9e8 \uac8c\uc784 \"\uce74\uc6b4\ud2b8 \ub9c8\uc2a4\ud130\"\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc5b4\ub5bb\uac8c \uc775\ud790 \uc218 \uc788\ub098\uc694?", "answer": "\uce74\uc6b4\ud2b8 \ub9c8\uc2a4\ud130: \uc2a4\ud2f1\ub9e8 \uac8c\uc784\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc775\ud788\ub824\uba74 \uba3c\uc800 \ud654\uba74 \ubc84\ud2bc\uc5d0 \uc775\uc219\ud574\uc9c0\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc67c\ucabd\uc740 \uc6c0\uc9c1\uc784(\uc88c/\uc6b0)\uc744, \uc624\ub978\ucabd\uc740 \uc810\ud504\uc640 \uacf5\uaca9\uacfc \uac19\uc740 \ud589\ub3d9\uc744 \uc81c\uc5b4\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c\ub294 \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\uace0 \uacf5\uaca9 \ubc84\ud2bc\uc744 \ub20c\ub7ec \uc801\uc744 \uacf5\uaca9\ud558\ub294 \uc5f0\uc2b5\uc744 \ud558\uc138\uc694. \ud0c0\uc774\ubc0d\uc774 \uc911\uc694\ud558\uba70, \ud2c8\uc0c8\ub97c \ub118\uc744 \ub54c\ub294 \ubc14\ub85c \uc810\ud504 \ubc84\ud2bc\uc744 \ub204\ub974\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ucee8\ud2b8\ub864\uc744 \uc790\ub3d9\ucc28 \uc6b4\uc804\uacfc \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uc138\uc694. \ubd80\ub4dc\ub7fd\uace0 \uc2e0\uc911\ud55c \uc785\ub825\uc774 \ub354 \ub098\uc740 \uacb0\uacfc\ub97c \uac00\uc838\uc635\ub2c8\ub2e4.]"}, {"question": "\uce74\uc6b4\ud2b8 \ub9c8\uc2a4\ud130: \uc2a4\ud2f1\ub9e8 \uac8c\uc784\uc5d0\uc11c \ubcf4\uc2a4\ub97c \ubb3c\ub9ac\uce58\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uce74\uc6b4\ud2b8 \ub9c8\uc2a4\ud130: \uc2a4\ud2f1\ub9e8 \uac8c\uc784\uc5d0\uc11c \ubcf4\uc2a4\ub97c \ubb3c\ub9ac\uce58\ub824\uba74 \ud0c0\uc774\ubc0d\uacfc \uc804\ub7b5\uc774 \ubaa8\ub450 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \ubcf4\uc2a4\uc758 \uacf5\uaca9 \ud328\ud134\uc744 \uad00\ucc30\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc232 \ubcf4\uc2a4\ub294 3\ucd08\ub9c8\ub2e4 \ubb34\uae30\ub97c \ud718\ub450\ub985\ub2c8\ub2e4. STEP2: \uc801\uc808\ud55c \uc2dc\uae30\uc5d0 \uc6c0\uc9c1\uc774\uac70\ub098 \uc810\ud504\ud558\uc5ec \uacf5\uaca9\uc744 \ud53c\ud558\uc138\uc694. STEP3: \ubcf4\uc2a4\uc758 \uacf5\uaca9 \uac04\uaca9 \ub3d9\uc548 \uc5ed\uc2b5\ud558\uc138\uc694. \ub354\ube14 \ub370\ubbf8\uc9c0 \ubc84\ud504\uc640 \uac19\uc740 \uac15\ud654 \uc544\uc774\ud15c\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud0c0\uaca9\uc744 \uadf9\ub300\ud654\ud558\uc138\uc694. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\ub294 \uc6d0\uac70\ub9ac \uacf5\uaca9\uc744 \uc120\ud638\ud558\ub294 \ubc18\uba74, \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub294 \uadfc\uc811 \uacf5\uaca9\uc5d0 \uc758\uc874\ud569\ub2c8\ub2e4. \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc744 \ucc3e\uae30 \uc704\ud574 \uc2e4\ud5d8\ud574\ubcf4\uc138\uc694.]"}, {"question": "\uce74\uc6b4\ud2b8 \ub9c8\uc2a4\ud130: \uc2a4\ud2f1\ub9e8 \uac8c\uc784\uc5d0\uc11c \uc2a4\ud2f1\ub9e8\uc774 \uccb4\ub825\uc744 \uc783\ub294 \uc774\uc720\uc640 \uc774\ub97c \uc5b4\ub5bb\uac8c \ubc29\uc9c0\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uce74\uc6b4\ud2b8 \ub9c8\uc2a4\ud130: \uc2a4\ud2f1\ub9e8 \uac8c\uc784\uc5d0\uc11c \uc2a4\ud2f1\ub9e8\uc774 \uccb4\ub825\uc744 \uc783\ub294 \uc8fc\uc694 \uc6d0\uc778\uc740 \uc801\uc758 \uacf5\uaca9\uacfc \ud658\uacbd\uc758 \uc704\ud5d8 \uc694\uc18c\uc785\ub2c8\ub2e4. \uc774\ub97c \ubc29\uc9c0\ud558\ub824\uba74 \ud56d\uc0c1 \ub2e5\uce60 \uc218 \uc788\ub294 \uc704\ud611\uc5d0 \uc8fc\uc758\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc6a9\uc554 \ub808\ubca8\uc5d0\uc11c\ub294 \ub728\uac70\uc6b4 \ud45c\uba74 \uc704\uc5d0 \uc11c\uc9c0 \uc54a\uace0 \uc810\ud504\ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc0c1\uc810\uc5d0\uc11c \ubc29\uc5b4\uad6c \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc7a5\ucc29\ud558\uc5ec \uccb4\ub825 \ud480\uc744 \ub298\ub9ac\uc138\uc694. \ub610\ud55c \uccb4\ub825\uc774 \ub0ae\uc744 \ub54c\ub294 \ud68c\ubcf5 \uc544\uc774\ud15c(\uc608: \uccb4\ub825 \ud3ec\uc158)\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. [\uad6c\uc131 \ube44\uad50\ud45c: \ubc29\uc5b4\uad6c\uc758 \uc2a4\ud15f\uc744 \ube44\uad50\ud574\ubcf4\uc138\uc694. \uccad\ub3d9 \ubc29\uc5b4\uad6c\ub294 HP\ub97c 50 \uc99d\uac00\uc2dc\ud0a4\ub294 \ubc18\uba74, \uae08 \ubc29\uc5b4\uad6c\ub294 100 \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4.]"}, {"question": "\uce74\uc6b4\ud2b8 \ub9c8\uc2a4\ud130: \uc2a4\ud2f1\ub9e8 \uac8c\uc784\uc5d0\uc11c \ub354 \ube60\ub974\uac8c \uc9c4\ud589\ud558\uae30 \uc704\ud574 \uc5b4\ub5a4 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc6b0\uc120\uc21c\uc704\ub85c \ud574\uc57c \ud558\ub098\uc694?", "answer": "\uce74\uc6b4\ud2b8 \ub9c8\uc2a4\ud130: \uc2a4\ud2f1\ub9e8 \uac8c\uc784\uc5d0\uc11c \ub354 \ube60\ub974\uac8c \uc9c4\ud589\ud558\ub824\uba74 \uc2a4\ud2f1\ub9e8\uc758 \uc0dd\uc874\ub825\uacfc \ud53c\ud574\ub7c9\uc744 \ub192\uc774\ub294 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc6b0\uc120\uc21c\uc704\ub85c \ud574\uc57c \ud569\ub2c8\ub2e4. \uba3c\uc800 \ucd5c\ub300 HP\ub97c \ub298\ub9ac\ub294 \uccb4\ub825 \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0 \uc9d1\uc911\ud558\uc5ec \ub354 \ub9ce\uc740 \uacf5\uaca9\uc744 \uacac\ub51c \uc218 \uc788\ub3c4\ub85d \ud558\uc138\uc694. \ub2e4\uc74c\uc73c\ub85c \uc801\uc5d0\uac8c \ub354 \ud070 \ud53c\ud574\ub97c \uc785\ud788\ub294 \uacf5\uaca9 \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0 \ud22c\uc790\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 3 \uacf5\uaca9 \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \ub3d9\uad74 \ubcf4\uc2a4\ub97c \ub354 \uc801\uc740 \ud0c0\uaca9\uc73c\ub85c \ubb3c\ub9ac\uce58\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uccb4\ub825 \u2192 \uacf5\uaca9 \u2192 \uc18d\ub3c4 \uc21c\uc73c\ub85c \uade0\ud615 \uc7a1\ud78c \uc9c4\ud589.]"}, {"question": "\uce74\uc6b4\ud2b8 \ub9c8\uc2a4\ud130: \uc2a4\ud2f1\ub9e8 \uac8c\uc784\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uce74\uc6b4\ud2b8 \ub9c8\uc2a4\ud130: \uc2a4\ud2f1\ub9e8 \uac8c\uc784\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc801 \ucc98\uce58, \uc5f0\uc18d \uacf5\uaca9, \ub808\ubca8 \uc644\ub8cc \uc2dc\uac04 \ub4f1 \uc5ec\ub7ec \uc694\uc18c\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud558\ub824\uba74 \ube60\ub974\uac8c \uc5ec\ub7ec \uc801\uc744 \ucc98\uce58\ud558\uc5ec \ub192\uc740 \uc5f0\uc18d \uacf5\uaca9\uc744 \ub178\ub9ac\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc0ac\ub9c9 \ub808\ubca8\uc5d0\uc11c\ub294 \uc801\ub4e4\uc744 \ubaa8\uc544 \uad11\uc5ed \uacf5\uaca9\uc73c\ub85c 10\ubc30 \uc5f0\uc18d \uacf5\uaca9\uc744 \ub2ec\uc131\ud558\uc138\uc694. \ub610\ud55c \ub808\ubca8\uc744 \ube60\ub974\uac8c \uc644\ub8cc\ud558\uc5ec \uc2dc\uac04 \ubcf4\ub108\uc2a4\ub97c \uc5bb\uc73c\uc138\uc694. [\ube44\uc720 \uc124\uba85: \uc5f0\uc18d \uacf5\uaca9\uc740 \ube14\ub85d\uc744 \uc313\ub294 \uac83\uacfc \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uc138\uc694. \uac01 \uc131\uacf5\uc801\uc778 \ud0c0\uaca9\uc740 \ud0d1\uc5d0 \ucd94\uac00\ub429\ub2c8\ub2e4.]"}, {"question": "\uce74\uc6b4\ud2b8 \ub9c8\uc2a4\ud130: \uc2a4\ud2f1\ub9e8 \uac8c\uc784\uc758 \uc228\uaca8\uc9c4 \uc5c5\uc801\uc740 \ubb34\uc5c7\uc774\uba70, \uc774\ub97c \uc5b4\ub5bb\uac8c \ud574\uc81c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uce74\uc6b4\ud2b8 \ub9c8\uc2a4\ud130: \uc2a4\ud2f1\ub9e8 \uac8c\uc784\uc5d0\ub294 \ud2b9\uc815 \ud589\ub3d9\uc774 \ud544\uc694\ud55c \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uc5c5\uc801\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc219\ub828\ub41c \uc804\ub7b5\uac00\" \uc5c5\uc801\uc740 \uc544\ubb34\ub7f0 \ud53c\ud574\ub3c4 \uc785\uc9c0 \uc54a\uace0 \ubcf4\uc2a4\ub97c \ubb3c\ub9ac\uce58\uba74 \ud574\uc81c\ub429\ub2c8\ub2e4. \uc774\ub97c \uc704\ud574 \ubcf4\uc2a4\uc758 \ud328\ud134\uc744 \uc5f0\uad6c\ud558\uace0 \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uc644\ubcbd\ud558\uac8c \ub9de\ucd94\uc138\uc694. \ub610 \ub2e4\ub978 \uc228\uaca8\uc9c4 \uc5c5\uc801 \"\ubcf4\ubb3c \uc0ac\ub0e5\uafbc\"\uc740 \ud55c \ub808\ubca8\uc5d0\uc11c \ubaa8\ub4e0 \uc228\uaca8\uc9c4 \ucf54\uc778\uc744 \ubaa8\uc73c\ub294 \uac83\uc744 \uc694\uad6c\ud569\ub2c8\ub2e4. \ubaa8\ub4e0 \uad6c\uc11d\uc744 \ud0d0\ud5d8\ud558\uace0 \uc9c0\ub3c4\ub97c \uc0ac\uc6a9\ud558\uc5ec \ucf54\uc778\uc744 \ucc3e\uc73c\uc138\uc694. [\ucd94\uac00 \ud301: \uc77c\ubd80 \ucf54\uc778\uc740 \ubd80\uc220 \uc218 \uc788\ub294 \ubcbd \ub4a4\uc5d0 \uc228\uaca8\uc838 \uc788\uc2b5\ub2c8\ub2e4. \uacf5\uaca9\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub4dc\ub7ec\ub0b4\uc138\uc694.]"}, {"question": "\uce74\uc6b4\ud2b8 \ub9c8\uc2a4\ud130: \uc2a4\ud2f1\ub9e8 \uac8c\uc784\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \uae30\uae30\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uce74\uc6b4\ud2b8 \ub9c8\uc2a4\ud130: \uc2a4\ud2f1\ub9e8 \uac8c\uc784\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \uae30\uae30\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\ub824\uba74 \ub450 \uae30\uae30 \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud574\uc57c \ud569\ub2c8\ub2e4. \ub300\ubd80\ubd84\uc758 \ud50c\ub808\uc774\uc5b4\ub294 Google Play\ub098 Apple Game Center\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc6d0\ud65c\ud558\uac8c \ub3d9\uae30\ud654\ud569\ub2c8\ub2e4. \uae30\uae30\ub97c \ubc14\uafb8\uae30 \uc804\uc5d0 \uac8c\uc784 \uc124\uc815\uc5d0 \uc811\uc18d\ud558\uc5ec \"\ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\"\uc744 \uc120\ud0dd\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \uc218\ub3d9\uc73c\ub85c \uc800\uc7a5\ud558\uc138\uc694. \uc0c8\ub85c\uc6b4 \uae30\uae30\uc5d0\uc11c \ub85c\uadf8\uc778\ud558\uace0 \uc800\uc7a5\ub41c \ub370\uc774\ud130\ub97c \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc138\uc694. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: Google Play\ub294 Android\uc5d0 \uc801\ud569\ud558\uba70, Apple Game Center\ub294 iOS\uc5d0 \uac00\uc7a5 \uc801\ud569\ud569\ub2c8\ub2e4.]"}, {"question": "\uce74\uc6b4\ud2b8 \ub9c8\uc2a4\ud130: \uc2a4\ud2f1\ub9e8 \uac8c\uc784\uc5d0\uc11c \uc5d0\ub108\uc9c0 \uc2dc\uc2a4\ud15c\uc758 \uc5ed\ud560\uc740 \ubb34\uc5c7\uc774\uba70, \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uce74\uc6b4\ud2b8 \ub9c8\uc2a4\ud130: \uc2a4\ud2f1\ub9e8 \uac8c\uc784\uc758 \uc5d0\ub108\uc9c0 \uc2dc\uc2a4\ud15c\uc740 \ub300\uae30 \uc2dc\uac04 \uc5c6\uc774 \ud50c\ub808\uc774\ud560 \uc218 \uc788\ub294 \ud69f\uc218\ub97c \uc81c\ud55c\ud569\ub2c8\ub2e4. \uac01 \ub808\ubca8\uc740 1 \uc5d0\ub108\uc9c0\ub97c \uc18c\ube44\ud558\uba70, \uc2dc\uac04\uc774 \uc9c0\ub0a8\uc5d0 \ub530\ub77c \uc5d0\ub108\uc9c0\uac00 \ud68c\ubcf5\ub429\ub2c8\ub2e4. \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub824\uba74 \ud68c\ubcf5\ub960(5\ubd84\ub9c8\ub2e4 1 \uc5d0\ub108\uc9c0)\uc744 \uace0\ub824\ud558\uc5ec \uac8c\uc784 \uc138\uc158\uc744 \uacc4\ud68d\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc5d0\ub108\uc9c0\uac00 5\uac1c \uc788\uc73c\uba74 \ud55c \uc138\uc158\uc5d0\uc11c 5\uac1c\uc758 \ub808\ubca8\uc744 \ud50c\ub808\uc774\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub354 \ub9ce\uc740 \ud50c\ub808\uc774\ub97c \uc6d0\ud55c\ub2e4\uba74 \uc77c\uc77c \ubcf4\uc0c1\uc774\ub098 \uac8c\uc784 \ub0b4 \uad6c\ub9e4\ub85c \uc5d0\ub108\uc9c0 \ubcf4\ucda9\ud15c\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. [\uad6c\uc131 \ube44\uad50\ud45c: \uc5d0\ub108\uc9c0\uac00 \uac00\ub4dd \ucc28\ub824\uba74 2\uc2dc\uac04, \uc5d0\ub108\uc9c0 \ubcf4\ucda9\ud15c\uc740 \uc989\uc2dc \uc5d0\ub108\uc9c0\ub97c \ud68c\ubcf5\ud569\ub2c8\ub2e4.]"}, {"question": "\uce74\uc6b4\ud2b8 \ub9c8\uc2a4\ud130: \uc2a4\ud2f1\ub9e8 \uac8c\uc784\uc5d0\uc11c \ud2b9\uc815 \ub808\ubca8\uc5d0 \ub9de\ucdb0 \uc2a4\ud2f1\ub9e8\uc758 \uc7a5\ube44\ub97c \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uce74\uc6b4\ud2b8 \ub9c8\uc2a4\ud130: \uc2a4\ud2f1\ub9e8 \uac8c\uc784\uc5d0\uc11c \uc2a4\ud2f1\ub9e8 \uc7a5\ube44\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \ub808\ubca8\uc758 \uc5b4\ub824\uc6c0\uc5d0 \ub9de\ucdb0 \uc7a5\ube44\uc640 \uae30\uc220\uc744 \uc870\uc815\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5bc\uc74c \ub808\ubca8\uc5d0\uc11c\ub294 \ubbf8\ub044\ub7ec\uc9d0\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \uc5bc\uc74c \uc800\ud56d \ubd80\uce20\ub97c \uc7a5\ube44\ud558\uc138\uc694. \uc232 \ub808\ubca8\uc5d0\uc11c\ub294 \ub098\ubb34 \uc801\uc5d0\uac8c \ucd94\uac00\uc801\uc778 \ud53c\ud574\ub97c \uc8fc\uae30 \uc704\ud574 \ubd88\uac80\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. STEP1: \ub808\ubca8\uc758 \uc801\uacfc \uc704\ud5d8 \uc694\uc18c\ub97c \ubd84\uc11d\ud558\uc138\uc694. STEP2: \uc774\ub7ec\ud55c \uc5b4\ub824\uc6c0\uc5d0 \ub300\ucc98\ud558\ub294 \uc7a5\ube44\ub97c \uc7a5\ucc29\ud558\uc138\uc694. STEP3: \uc7a5\ube44\ub97c \ud14c\uc2a4\ud2b8\ud558\uace0 \ud544\uc694\uc5d0 \ub530\ub77c \uc870\uc815\ud558\uc138\uc694. [\ud750\ub984\ub3c4: \ubd84\uc11d \u2192 \uc7a5\ube44 \u2192 \ud14c\uc2a4\ud2b8 \u2192 \ucd5c\uc801\uc758 \uacb0\uacfc\ub97c \uc704\ud55c \uc870\uc815.]"}, {"question": "\uce74\uc6b4\ud2b8 \ub9c8\uc2a4\ud130: \uc2a4\ud2f1\ub9e8 \uac8c\uc784\uc5d0\uc11c \ucf54\uc778\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uc218\uc9d1\ud558\ub294 \uac00\uc7a5 \uc88b\uc740 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uce74\uc6b4\ud2b8 \ub9c8\uc2a4\ud130: \uc2a4\ud2f1\ub9e8 \uac8c\uc784\uc5d0\uc11c \ucf54\uc778\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uc218\uc9d1\ud558\ub824\uba74 \uc218\uc775\uc131\uc774 \ub192\uc740 \ub808\ubca8\uc744 \ubc18\ubcf5\ud558\uace0 \uc77c\uc77c \ucc4c\ub9b0\uc9c0\uc640 \uc774\ubca4\ud2b8\ub97c \uc644\ub8cc\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uad11\uc0b0 \ub808\ubca8\uc740 \uc801\uc744 \ubb3c\ub9ac\uce58\uace0 \ub3cc\uc744 \ubd80\uc218\uba74 \ub9ce\uc740 \ucf54\uc778\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ube60\ub974\uace0 \ub192\uc740 \uc5f0\uc18d \uacf5\uaca9\uc73c\ub85c \ub808\ubca8\uc744 \uc644\ub8cc\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc5ec \uc218\uc775\uc744 \uadf9\ub300\ud654\ud558\uc138\uc694. \ub610\ud55c \uc774\ubca4\ud2b8\uc5d0 \ucc38\uc5ec\ud558\uace0 \uad11\uace0\ub97c \uc2dc\uccad\ud558\uc5ec \ubcf4\ub108\uc2a4 \ucf54\uc778\uc744 \uc5bb\uc73c\uc138\uc694. [\ube44\uc720 \uc124\uba85: \ucf54\uc778 \uc218\uc9d1\uc740 \ub9c8\uc774\ub2dd\uacfc \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uc138\uc694. \uac00\uc7a5 \ud48d\ubd80\ud55c \uad11\ub9e5\uc744 \ub178\ub824 \ucd5c\uace0\uc758 \uc218\uc775\uc744 \uc5bb\uc73c\uc138\uc694.]"}]
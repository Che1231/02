[{"question": "\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u5efa\u9020\u738b\u5ea7\u300b\u4e2d\u5feb\u901f\u638c\u63e1\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1\u300a\u5efa\u9020\u738b\u5ea7\u300b\u7684\u57fa\u672c\u63a7\u5236\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u901a\u8fc7\u6559\u7a0b\u5730\u56fe\u719f\u6089\u79fb\u52a8\u63a7\u5236\u3002\u6b65\u9aa42 - \u4f7f\u7528\u5feb\u901f\u5efa\u9020\u83dc\u5355\u7ec3\u4e60\u5efa\u9020\u5efa\u7b51\u7269\uff0c\u4f8b\u5982\u5899\u548c\u659c\u5761\uff0c\u4ee5\u5728\u6218\u6597\u4e2d\u83b7\u5f97\u4f18\u52bf\u3002\u6b65\u9aa43 - \u4e0e AI \u673a\u5668\u4eba\u8fdb\u884c\u6218\u6597\uff0c\u4e86\u89e3\u5c04\u51fb\u673a\u5236\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\"\u7a81\u51fb\u6b65\u67aa\"\u7ec3\u4e60\u7784\u51c6\u548c\u5c04\u51fb\u3002\u8bb0\u4f4f\uff0c\u6301\u7eed\u7ec3\u4e60\u662f\u63d0\u5347\u6280\u80fd\u7684\u5173\u952e\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u63a7\u5236\u60f3\u8c61\u6210\u5b66\u4e60\u9a91\u81ea\u884c\u8f66\uff1b\u4e00\u65e6\u4f60\u638c\u63e1\u4e86\u6280\u5de7\uff0c\u5b83\u5c31\u4f1a\u6210\u4e3a\u7b2c\u4e8c\u5929\u6027\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u8d44\u6e90\u7ba1\u7406\u5bf9\u4e8e\u300a\u5efa\u9020\u738b\u5ea7\u300b\u7684\u6210\u529f\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u5728\u300a\u5efa\u9020\u738b\u5ea7\u300b\u4e2d\uff0c\u8d44\u6e90\u7ba1\u7406\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u76f4\u63a5\u5f71\u54cd\u4f60\u7684\u5efa\u9020\u548c\u9632\u5fa1\u80fd\u529b\u3002\u6709\u6548\u5730\u6536\u96c6\u6728\u6750\u3001\u77f3\u5934\u548c\u91d1\u5c5e\uff0c\u53ef\u4ee5\u8ba9\u4f60\u5efa\u9020\u575a\u56fa\u7684\u9632\u5fa1\u5de5\u4e8b\u548c\u6218\u7565\u901a\u9053\u3002\u4f8b\u5982\uff0c\u5728\u4ea4\u706b\u8fc7\u7a0b\u4e2d\uff0c\u6709\u8db3\u591f\u7684\u6728\u6750\u5feb\u901f\u5efa\u9020\u5899\u58c1\u53ef\u4ee5\u4fdd\u62a4\u4f60\u514d\u53d7\u654c\u65b9\u706b\u529b\u3002\u6b64\u5916\uff0c\u7ba1\u7406\u4f60\u7684\u5f39\u836f\u786e\u4fdd\u4f60\u968f\u65f6\u51c6\u5907\u597d\u6218\u6597\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u8d44\u6e90\u7c7b\u578b - \u7528\u9014\uff1a\u6728\u6750 - \u5feb\u901f\u5efa\u9020\uff0c\u77f3\u5934 - \u8010\u7528\u5efa\u7b51\uff0c\u91d1\u5c5e - \u9ad8\u9632\u5fa1\u5efa\u7b51]"}, {"question": "\u65b0\u624b\u73a9\u5bb6\u5728\u300a\u5efa\u9020\u738b\u5ea7\u300b\u4e2d\u5e94\u8be5\u4f18\u5148\u8003\u8651\u54ea\u4e9b\u5fc5\u5907\u7269\u54c1\uff1f", "answer": "\u300a\u5efa\u9020\u738b\u5ea7\u300b\u4e2d\u7684\u65b0\u624b\u73a9\u5bb6\u5e94\u8be5\u4f18\u5148\u8003\u8651\u90a3\u4e9b\u589e\u5f3a\u751f\u5b58\u80fd\u529b\u548c\u6218\u6597\u6548\u679c\u7684\u7269\u54c1\u3002\u5fc5\u5907\u7269\u54c1\u5305\u62ec\uff1a1) \u6025\u6551\u5305\uff0c\u7528\u4e8e\u6062\u590d\u751f\u547d\uff1b2) \u7a81\u51fb\u6b65\u67aa\uff0c\u7528\u4e8e\u591a\u7528\u9014\u6218\u6597\uff1b3) \u5efa\u6750\uff0c\u4f8b\u5982\u6728\u6750\uff0c\u7528\u4e8e\u5feb\u901f\u9632\u5fa1\u3002\u4f8b\u5982\uff0c\u5728\u906d\u9047\u6218\u540e\uff0c\u59cb\u7ec8\u643a\u5e26\u6025\u6551\u5305\u4ee5\u6062\u590d\u751f\u547d\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u6025\u6551\u5305\u4e0e\u62a4\u76fe\u836f\u6c34 - \u6025\u6551\u5305\u80fd\u77ac\u95f4\u6062\u590d\u751f\u547d\uff0c\u800c\u62a4\u76fe\u836f\u6c34\u5219\u63d0\u4f9b\u4e34\u65f6\u7684\u4fdd\u62a4\u3002]"}, {"question": "\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u5efa\u9020\u738b\u5ea7\u300b\u4e2d\u4f18\u5316\u4ed6\u4eec\u7684\u5efa\u7b51\u7b56\u7565\uff1f", "answer": "\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u4ee5\u4e0b\u6b65\u9aa4\u4f18\u5316\u4ed6\u4eec\u7684\u5efa\u7b51\u7b56\u7565\uff1a\u6b65\u9aa41 - \u5728\u6218\u6597\u5f00\u59cb\u524d\uff0c\u59cb\u7ec8\u9884\u5148\u89c4\u5212\u4f60\u7684\u5efa\u7b51\u5e03\u5c40\u3002\u6b65\u9aa42 - \u4f7f\u7528\u9ad8\u7ea7\u5efa\u7b51\u6280\u5de7\uff0c\u4f8b\u5982\"90 \u5ea6\"\u548c\"\u659c\u5761\u51b2\u950b\"\uff0c\u4ee5\u83b7\u5f97\u9ad8\u5730\u4f18\u52bf\u3002\u6b65\u9aa43 - \u5c06\u5efa\u7b51\u4e0e\u5c04\u51fb\u76f8\u7ed3\u5408\uff0c\u5bf9\u5bf9\u624b\u65bd\u52a0\u538b\u529b\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u659c\u5761\u51b2\u950b\u83b7\u5f97\u9ad8\u5730\uff0c\u7136\u540e\u5feb\u901f\u5207\u6362\u5230\u9730\u5f39\u67aa\u8fdb\u884c\u8fd1\u8ddd\u79bb\u6218\u6597\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u89c4\u5212\u5e03\u5c40 -> \u6267\u884c\u5efa\u9020 -> \u53c2\u4e0e\u6218\u6597]"}, {"question": "\u4e3a\u4ec0\u4e48\u5728\u300a\u5efa\u9020\u738b\u5ea7\u300b\u7684\u540e\u671f\u6e38\u620f\u4e2d\uff0c\u4f4d\u7f6e\u5982\u6b64\u91cd\u8981\uff1f", "answer": "\u5728\u300a\u5efa\u9020\u738b\u5ea7\u300b\u7684\u540e\u671f\u6e38\u620f\u4e2d\uff0c\u4f4d\u7f6e\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u51b3\u5b9a\u4e86\u4f60\u7684\u89c6\u91ce\u548c\u5f31\u70b9\u3002\u5360\u636e\u9ad8\u5730\u53ef\u4ee5\u83b7\u5f97\u6218\u672f\u4f18\u52bf\uff0c\u8ba9\u4f60\u66f4\u5bb9\u6613\u53d1\u73b0\u5e76\u5c04\u51fb\u654c\u4eba\u3002\u4f8b\u5982\uff0c\u5728\u6700\u540e\u4e00\u5708\u65f6\uff0c\u5728\u5c0f\u5c71\u4e18\u4e0a\u5360\u636e\u4f4d\u7f6e\u53ef\u4ee5\u8ba9\u4f60\u6e05\u695a\u5730\u770b\u5230\u6218\u573a\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u4f4d\u7f6e\u60f3\u8c61\u6210\u4e0b\u68cb\uff1b\u4f60\u653e\u7f6e\u68cb\u5b50\u7684\u4f4d\u7f6e\u53ef\u4ee5\u51b3\u5b9a\u6bd4\u8d5b\u7684\u7ed3\u679c\u3002]"}, {"question": "\u300a\u5efa\u9020\u738b\u5ea7\u300b\u4e2d\uff0c\u5355\u4eba\u6e38\u620f\u548c\u56e2\u961f\u6e38\u620f\u6709\u4ec0\u4e48\u4e3b\u8981\u533a\u522b\uff1f", "answer": "\u300a\u5efa\u9020\u738b\u5ea7\u300b\u4e2d\uff0c\u5355\u4eba\u6e38\u620f\u548c\u56e2\u961f\u6e38\u620f\u7684\u4e3b\u8981\u533a\u522b\u5728\u4e8e\uff1a1) \u5355\u4eba\u6e38\u620f\u9700\u8981\u81ea\u529b\u66f4\u751f\uff0c\u800c\u56e2\u961f\u6e38\u620f\u9700\u8981\u56e2\u961f\u5408\u4f5c\u548c\u534f\u8c03\u30022) \u5728\u56e2\u961f\u6e38\u620f\u4e2d\uff0c\u4f60\u53ef\u4ee5\u590d\u6d3b\u961f\u53cb\uff0c\u589e\u52a0\u7b56\u7565\u5c42\u30023) \u5728\u56e2\u961f\u6e38\u620f\u4e2d\uff0c\u6c9f\u901a\u81f3\u5173\u91cd\u8981\uff0c\u4ee5\u4fbf\u6267\u884c\u8054\u5408\u7684\u5efa\u7b51\u548c\u6218\u6597\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u5728\u56e2\u961f\u4e2d\uff0c\u4f60\u53ef\u4ee5\u534f\u8c03\u4ece\u591a\u4e2a\u89d2\u5ea6\u540c\u65f6\u653b\u51fb\uff0c\u4ee5\u538b\u57ae\u5bf9\u624b\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u5355\u4eba\u6e38\u620f - \u72ec\u7acb\u7b56\u7565\uff0c\u56e2\u961f\u6e38\u620f - \u56e2\u961f\u534f\u8c03]"}, {"question": "\u300a\u5efa\u9020\u738b\u5ea7\u300b\u4e2d\u7684\u6b66\u5668\u7a00\u6709\u5ea6\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u300a\u5efa\u9020\u738b\u5ea7\u300b\u4e2d\u7684\u6b66\u5668\u7a00\u6709\u5ea6\u7cfb\u7edf\u6839\u636e\u6b66\u5668\u7684\u5a01\u529b\u548c\u53ef\u7528\u6027\u5bf9\u6b66\u5668\u8fdb\u884c\u5206\u7c7b\u3002\u7a00\u6709\u5ea6\u4ece\u666e\u901a\uff08\u7070\u8272\uff09\u5230\u53f2\u8bd7\uff08\u91d1\u8272\uff09\u3002\u7a00\u6709\u5ea6\u8d8a\u9ad8\u7684\u6b66\u5668\u901a\u5e38\u5177\u6709\u66f4\u597d\u7684\u5c5e\u6027\uff0c\u4f8b\u5982\u66f4\u9ad8\u7684\u4f24\u5bb3\u6216\u66f4\u5feb\u7684\u88c5\u586b\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u53f2\u8bd7\u7ea7\u7a81\u51fb\u6b65\u67aa\uff08SCAR\uff09\u7684\u4f24\u5bb3\u6bd4\u666e\u901a\u624b\u67aa\u9ad8\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u7a00\u6709\u5ea6 - \u989c\u8272 - \u5c5e\u6027\u63d0\u5347\uff1a\u666e\u901a - \u7070\u8272 - \u65e0\uff0c\u7a00\u6709 - \u7eff\u8272 - \u8f7b\u5fae\u63d0\u5347\uff0c\u53f2\u8bd7 - \u7d2b\u8272 - \u4e2d\u7b49\u63d0\u5347\uff0c\u53f2\u8bd7\u7ea7 - \u91d1\u8272 - \u663e\u8457\u63d0\u5347]"}, {"question": "\u300a\u5efa\u9020\u738b\u5ea7\u300b\u4e2d\u98ce\u66b4\u5708\u80cc\u540e\u7684\u6838\u5fc3\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u5efa\u9020\u738b\u5ea7\u300b\u4e2d\u7684\u98ce\u66b4\u5708\u662f\u4e00\u4e2a\u6536\u7f29\u7684\u533a\u57df\uff0c\u8feb\u4f7f\u73a9\u5bb6\u8fdb\u884c\u66f4\u8fd1\u8ddd\u79bb\u7684\u6218\u6597\u3002\u98ce\u66b4\u5708\u4f1a\u5206\u9636\u6bb5\u79fb\u52a8\uff0c\u5bf9\u5708\u5916\u7684\u73a9\u5bb6\u9020\u6210\u8d8a\u6765\u8d8a\u9ad8\u7684\u4f24\u5bb3\u3002\u73a9\u5bb6\u5fc5\u987b\u4e0d\u65ad\u79fb\u52a8\u624d\u80fd\u7559\u5728\u5b89\u5168\u533a\u57df\u3002\u4f8b\u5982\uff0c\u5728\u6700\u540e\u4e00\u9636\u6bb5\uff0c\u98ce\u66b4\u4f1a\u9020\u6210\u91cd\u5927\u4f24\u5bb3\uff0c\u56e0\u6b64\u7559\u5728\u5708\u5185\u81f3\u5173\u91cd\u8981\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u98ce\u66b4\u5708\u6536\u7f29 -> \u73a9\u5bb6\u8fdb\u5165 -> \u6218\u6597\u52a0\u5267]"}, {"question": "\u73a9\u5bb6\u662f\u5426\u53ef\u4ee5\u5728\u300a\u5efa\u9020\u738b\u5ea7\u300b\u4e2d\u5c06\u4ed6\u4eec\u7684PC\u8fdb\u5ea6\u8f6c\u79fb\u5230\u79fb\u52a8\u7aef\uff1f", "answer": "\u662f\u7684\uff0c\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u5c06\u4ed6\u4eec\u7684\u5e10\u6237\u94fe\u63a5\u5230\u50cf Epic Games \u8fd9\u6837\u7684\u901a\u7528\u5e73\u53f0\uff0c\u5728\u300a\u5efa\u9020\u738b\u5ea7\u300b\u4e2d\u5c06\u4ed6\u4eec\u7684 PC \u8fdb\u5ea6\u8f6c\u79fb\u5230\u79fb\u52a8\u7aef\u3002\u8fd9\u5141\u8bb8\u4f60\u5728\u4e0d\u540c\u7684\u8bbe\u5907\u4e0a\u65e0\u7f1d\u8bbf\u95ee\u4f60\u7684\u7269\u54c1\u3001\u76ae\u80a4\u548c\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728 PC \u7aef\u89e3\u9501\u4e86\u4e00\u79cd\u76ae\u80a4\uff0c\u5b83\u4e5f\u4f1a\u51fa\u73b0\u5728\u4f60\u7684\u79fb\u52a8\u7aef\u5e10\u6237\u4e2d\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u5e73\u53f0 - \u8fdb\u5ea6\u8f6c\u79fb: PC -> \u79fb\u52a8 - \u662f\uff0c\u79fb\u52a8 -> PC - \u662f]"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728\u300a\u5efa\u9020\u738b\u5ea7\u300b\u4e2d\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u7684\u5f69\u86cb\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u63a2\u7d22\u5730\u56fe\u4e0a\u8f83\u5c11\u8bbf\u95ee\u7684\u533a\u57df\u6765\u53d1\u73b0\u300a\u5efa\u9020\u738b\u5ea7\u300b\u4e2d\u7684\u9690\u85cf\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u5728\u6d1e\u7a74\u4e2d\u6709\u4e00\u4e2a\u9690\u85cf\u7684\u79d8\u5bc6\u821e\u6c60\uff0c\u6fc0\u6d3b\u540e\u4f1a\u64ad\u653e\u97f3\u4e50\u3002\u8fd9\u4e9b\u5f69\u86cb\u4e3a\u6e38\u620f\u589e\u6dfb\u4e86\u4e00\u5c42\u4e50\u8da3\u548c\u53d1\u73b0\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5bfb\u627e\u5f69\u86cb\u5c31\u50cf\u53d1\u73b0\u57cb\u85cf\u7684\u5b9d\u85cf\uff1b\u5b83\u5bf9\u597d\u5947\u7684\u63a2\u9669\u5bb6\u6765\u8bf4\u662f\u4e00\u4efd\u4e30\u539a\u7684\u60ca\u559c\u3002]"}]
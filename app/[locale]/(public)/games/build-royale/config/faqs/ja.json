[{"question": "\u30d3\u30eb\u30c8\u30fb\u30ed\u30a4\u30e4\u30eb\u3067\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u57fa\u672c\u64cd\u4f5c\u3092\u7d20\u65e9\u304f\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d3\u30eb\u30c8\u30fb\u30ed\u30a4\u30e4\u30eb\u3067\u57fa\u672c\u64cd\u4f5c\u3092\u7d20\u65e9\u304f\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\uff1a\u624b\u98061\uff1a\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30de\u30c3\u30d7\u3092\u79fb\u52d5\u3057\u3066\u3001\u79fb\u52d5\u64cd\u4f5c\u306b\u6163\u308c\u308b\u3002\u624b\u98062\uff1a\u30af\u30a4\u30c3\u30af\u30d3\u30eb\u30c9\u30e1\u30cb\u30e5\u30fc\u3092\u4f7f\u3063\u3066\u58c1\u3084\u30e9\u30f3\u30d7\u306a\u3069\u306e\u5efa\u9020\u7269\u3092\u7df4\u7fd2\u3057\u3001\u6226\u95d8\u3067\u512a\u4f4d\u306b\u7acb\u3064\u3002\u624b\u98063\uff1aAI\u30dc\u30c3\u30c8\u3068\u6226\u95d8\u306b\u53c2\u52a0\u3057\u3066\u3001\u5c04\u6483\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u300e\u30d0\u30fc\u30b9\u30c8\u30e9\u30a4\u30d5\u30eb\u300f\u3092\u4f7f\u3063\u3066\u7167\u6e96\u3068\u5c04\u6483\u306e\u7df4\u7fd2\u3092\u3059\u308b\u3002\u30b9\u30ad\u30eb\u3092\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u306b\u306f\u3001\u7d99\u7d9a\u7684\u306a\u7df4\u7fd2\u304c\u91cd\u8981\u3067\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u64cd\u4f5c\u306f\u81ea\u8ee2\u8eca\u306b\u4e57\u308b\u3053\u3068\u3092\u5b66\u3076\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u4e00\u5ea6\u30b3\u30c4\u3092\u3064\u304b\u3081\u3070\u3001\u81ea\u7136\u3068\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002]"}, {"question": "\u30d3\u30eb\u30c8\u30fb\u30ed\u30a4\u30e4\u30eb\u3067\u8cc7\u6e90\u7ba1\u7406\u304c\u6210\u529f\u306b\u4e0d\u53ef\u6b20\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u30d3\u30eb\u30c8\u30fb\u30ed\u30a4\u30e4\u30eb\u3067\u8cc7\u6e90\u7ba1\u7406\u304c\u6210\u529f\u306b\u4e0d\u53ef\u6b20\u306a\u306e\u306f\u3001\u5efa\u9020\u7269\u3068\u9632\u5fa1\u529b\u306e\u80fd\u529b\u306b\u76f4\u63a5\u5f71\u97ff\u3059\u308b\u304b\u3089\u3067\u3059\u3002\u6728\u6750\u3001\u77f3\u3001\u91d1\u5c5e\u306a\u3069\u306e\u7d20\u6750\u3092\u52b9\u7387\u7684\u306b\u53ce\u96c6\u3059\u308b\u3053\u3068\u3067\u3001\u5f37\u529b\u306a\u9632\u5fa1\u65bd\u8a2d\u3068\u6226\u7565\u7684\u306a\u901a\u8def\u3092\u69cb\u7bc9\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u9283\u6483\u6226\u4e2d\u306b\u58c1\u3092\u8fc5\u901f\u306b\u69cb\u7bc9\u3059\u308b\u305f\u3081\u306e\u6728\u6750\u304c\u3042\u308c\u3070\u3001\u6575\u306e\u653b\u6483\u304b\u3089\u8eab\u3092\u5b88\u308c\u307e\u3059\u3002\u307e\u305f\u3001\u5f3e\u85ac\u3092\u7ba1\u7406\u3059\u308b\u3053\u3068\u3067\u3001\u5e38\u306b\u6226\u95d8\u306e\u6e96\u5099\u304c\u3067\u304d\u307e\u3059\u3002[\u914d\u7f6e\u5bfe\u7167\u8868\uff1a\u8cc7\u6e90\u306e\u7a2e\u985e - \u4f7f\u7528\u6cd5\uff1a\u6728\u6750 - \u30af\u30a4\u30c3\u30af\u30d3\u30eb\u30c9\u3001\u77f3 - \u8010\u4e45\u6027\u306e\u3042\u308b\u5efa\u7bc9\u7269\u3001\u91d1\u5c5e - \u9ad8\u9632\u5fa1\u5efa\u7bc9\u7269]"}, {"question": "\u30d3\u30eb\u30c8\u30fb\u30ed\u30a4\u30e4\u30eb\u3067\u521d\u5fc3\u8005\u304c\u898b\u6975\u3081\u308b\u3079\u304d\u5fc5\u9808\u30a2\u30a4\u30c6\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d3\u30eb\u30c8\u30fb\u30ed\u30a4\u30e4\u30eb\u3067\u521d\u5fc3\u8005\u304c\u898b\u6975\u3081\u308b\u3079\u304d\u5fc5\u9808\u30a2\u30a4\u30c6\u30e0\u306f\u3001\u751f\u5b58\u80fd\u529b\u3068\u6226\u95d8\u52b9\u679c\u3092\u9ad8\u3081\u308b\u30a2\u30a4\u30c6\u30e0\u3067\u3059\u3002\u5fc5\u9808\u30a2\u30a4\u30c6\u30e0\u306b\u306f\u6b21\u306e\u3082\u306e\u304c\u3042\u308a\u307e\u3059\uff1a1) \u5065\u5eb7\u56de\u5fa9\u306e\u305f\u3081\u306e\u30e1\u30c7\u30a3\u30ad\u30c3\u30c8\u30012) \u591a\u69d8\u306a\u6226\u95d8\u306e\u305f\u3081\u306e\u30a2\u30b5\u30eb\u30c8\u30e9\u30a4\u30d5\u30eb\u30013) \u65e9\u6025\u306a\u9632\u5fa1\u306e\u305f\u3081\u306e\u6728\u6750\u306a\u3069\u306e\u5efa\u7bc9\u6750\u6599\u3002\u4f8b\u3048\u3070\u3001\u5c0f\u7af6\u308a\u5408\u3044\u306e\u5f8c\u3001\u5fc5\u305a\u5065\u5eb7\u3092\u56de\u5fa9\u3055\u305b\u308b\u305f\u3081\u306b\u30e1\u30c7\u30a3\u30ad\u30c3\u30c8\u3092\u643a\u5e2f\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u30e1\u30c7\u30a3\u30ad\u30c3\u30c8\u3068\u30b7\u30fc\u30eb\u30c9\u30dd\u30fc\u30b7\u30e7\u30f3 - \u30e1\u30c7\u30a3\u30ad\u30c3\u30c8\u306f\u5373\u5ea7\u306b\u5065\u5eb7\u3092\u56de\u5fa9\u3055\u305b\u307e\u3059\u304c\u3001\u30b7\u30fc\u30eb\u30c9\u30dd\u30fc\u30b7\u30e7\u30f3\u306f\u4e00\u6642\u7684\u306a\u4fdd\u8b77\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002]"}, {"question": "\u7d4c\u9a13\u8c4a\u5bcc\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30d3\u30eb\u30c8\u30fb\u30ed\u30a4\u30e4\u30eb\u3067\u3069\u306e\u3088\u3046\u306b\u5efa\u8a2d\u6226\u7565\u3092\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u7d4c\u9a13\u8c4a\u5bcc\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u5efa\u8a2d\u6226\u7565\u3092\u6700\u9069\u5316\u3067\u304d\u307e\u3059\uff1a\u624b\u98061\uff1a\u6226\u95d8\u306b\u53c2\u52a0\u3059\u308b\u524d\u306b\u3001\u5e38\u306b\u5efa\u8a2d\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u4e8b\u524d\u306b\u8a08\u753b\u3059\u308b\u3002\u624b\u98062\uff1a\u300e90\u5ea6\u300f\u3084\u300e\u30e9\u30f3\u30d7\u30e9\u30c3\u30b7\u30e5\u300f\u306a\u3069\u306e\u9ad8\u5ea6\u306a\u5efa\u7bc9\u30c6\u30af\u30cb\u30c3\u30af\u3092\u4f7f\u7528\u3057\u3066\u3001\u9ad8\u5730\u3092\u7372\u5f97\u3059\u308b\u3002\u624b\u98063\uff1a\u5efa\u7bc9\u3068\u5c04\u6483\u3092\u7d44\u307f\u5408\u308f\u305b\u3066\u3001\u6575\u306b\u30d7\u30ec\u30c3\u30b7\u30e3\u30fc\u3092\u304b\u3051\u308b\u3002\u4f8b\u3048\u3070\u3001\u30e9\u30f3\u30d7\u30e9\u30c3\u30b7\u30e5\u3092\u4f7f\u7528\u3057\u3066\u9ad8\u5730\u3092\u7372\u5f97\u3057\u3001\u6b21\u306b\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\u3092\u8fc5\u901f\u306b\u5207\u308a\u66ff\u3048\u3066\u3001\u8fd1\u63a5\u6226\u95d8\u3092\u884c\u3046\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30ec\u30a4\u30a2\u30a6\u30c8\u8a08\u753b\u2192\u5efa\u8a2d\u5b9f\u884c\u2192\u6226\u95d8\u53c2\u52a0]"}, {"question": "\u30d3\u30eb\u30c8\u30fb\u30ed\u30a4\u30e4\u30eb\u306e\u7d42\u76e4\u306e\u30b7\u30ca\u30ea\u30aa\u3067\u3001\u4f4d\u7f6e\u6c7a\u3081\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u30d3\u30eb\u30c8\u30fb\u30ed\u30a4\u30e4\u30eb\u306e\u7d42\u76e4\u306e\u30b7\u30ca\u30ea\u30aa\u3067\u4f4d\u7f6e\u6c7a\u3081\u304c\u91cd\u8981\u306a\u306e\u306f\u3001\u8996\u8a8d\u6027\u3068\u8106\u5f31\u6027\u306b\u5f71\u97ff\u3059\u308b\u305f\u3081\u3067\u3059\u3002\u9ad8\u5730\u306b\u3044\u308b\u3053\u3068\u3067\u3001\u6226\u8853\u7684\u306a\u512a\u4f4d\u6027\u3092\u7372\u5f97\u3057\u3001\u6575\u3092\u3088\u308a\u7c21\u5358\u306b\u767a\u898b\u3057\u3066\u6483\u3064\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6700\u7d42\u7684\u306a\u30b5\u30fc\u30af\u30eb\u4e2d\u306b\u4e18\u306e\u4e0a\u306b\u4f4d\u7f6e\u6c7a\u3081\u3059\u308b\u3053\u3068\u3067\u3001\u6226\u95d8\u306e\u5168\u4f53\u50cf\u3092\u30af\u30ea\u30a2\u306b\u898b\u6e21\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u4f4d\u7f6e\u6c7a\u3081\u306f\u30c1\u30a7\u30b9\u3092\u3059\u308b\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u99d2\u3092\u914d\u7f6e\u3059\u308b\u5834\u6240\u306b\u3088\u3063\u3066\u30b2\u30fc\u30e0\u306e\u7d50\u679c\u304c\u6c7a\u307e\u308b\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u3002]"}, {"question": "\u30d3\u30eb\u30c8\u30fb\u30ed\u30a4\u30e4\u30eb\u306b\u304a\u3051\u308b\u30bd\u30ed\u30d7\u30ec\u30a4\u3068\u30c1\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d3\u30eb\u30c8\u30fb\u30ed\u30a4\u30e4\u30eb\u306b\u304a\u3051\u308b\u30bd\u30ed\u30d7\u30ec\u30a4\u3068\u30c1\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u4e3b\u306a\u9055\u3044\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\uff1a1) \u30bd\u30ed\u30d7\u30ec\u30a4\u306f\u81ea\u5df1\u4f9d\u5b58\u3092\u5fc5\u8981\u3068\u3059\u308b\u306e\u306b\u5bfe\u3057\u3001\u30c1\u30fc\u30e0\u30d7\u30ec\u30a4\u306f\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u3068\u9023\u643a\u3092\u5fc5\u8981\u3068\u3057\u307e\u3059\u30022) \u30c1\u30fc\u30e0\u30d7\u30ec\u30a4\u3067\u306f\u3001\u30c1\u30fc\u30e0\u30e1\u30a4\u30c8\u3092\u8607\u751f\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u3001\u6226\u7565\u6027\u3092\u9ad8\u3081\u307e\u3059\u30023) \u30c1\u30fc\u30e0\u30d7\u30ec\u30a4\u3067\u306f\u3001\u9023\u643a\u3057\u305f\u5efa\u7bc9\u3068\u6226\u95d8\u6226\u7565\u3092\u5b9f\u884c\u3059\u308b\u305f\u3081\u306b\u3001\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u304c\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30c1\u30fc\u30e0\u30d7\u30ec\u30a4\u3067\u306f\u3001\u8907\u6570\u306e\u89d2\u5ea6\u304b\u3089\u306e\u540c\u6642\u653b\u6483\u3092\u8abf\u6574\u3057\u3066\u3001\u6575\u3092\u5727\u5012\u3067\u304d\u307e\u3059\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u30bd\u30ed\u30d7\u30ec\u30a4 - \u500b\u5225\u6226\u7565\u3001\u30c1\u30fc\u30e0\u30d7\u30ec\u30a4 - \u30c1\u30fc\u30e0\u9023\u643a]"}, {"question": "\u30d3\u30eb\u30c8\u30fb\u30ed\u30a4\u30e4\u30eb\u306b\u304a\u3051\u308b\u6b66\u5668\u30ec\u30a2\u30ea\u30c6\u30a3\u30b7\u30b9\u30c6\u30e0\u306e\u4ed5\u7d44\u307f\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d3\u30eb\u30c8\u30fb\u30ed\u30a4\u30e4\u30eb\u306b\u304a\u3051\u308b\u6b66\u5668\u30ec\u30a2\u30ea\u30c6\u30a3\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6b66\u5668\u306e\u529b\u3068\u5165\u624b\u53ef\u80fd\u6027\u306b\u57fa\u3065\u3044\u3066\u6b66\u5668\u3092\u5206\u985e\u3057\u307e\u3059\u3002\u30ec\u30a2\u30ea\u30c6\u30a3\u306f\u3001\u30b3\u30e2\u30f3\uff08\u30b0\u30ec\u30fc\uff09\u304b\u3089\u30ec\u30b8\u30a7\u30f3\u30c0\u30ea\u30fc\uff08\u30b4\u30fc\u30eb\u30c9\uff09\u307e\u3067\u3042\u308a\u307e\u3059\u3002\u30ec\u30a2\u30ea\u30c6\u30a3\u304c\u9ad8\u3044\u6b66\u5668\u306f\u3001\u4e00\u822c\u7684\u306b\u653b\u6483\u529b\u5411\u4e0a\u3084\u5c04\u6483\u901f\u5ea6\u5411\u4e0a\u306a\u3069\u306e\u3088\u308a\u9ad8\u3044\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30b8\u30a7\u30f3\u30c0\u30ea\u30fc\u306a\u30b9\u30ab\u30fc\uff08\u30a2\u30b5\u30eb\u30c8\u30e9\u30a4\u30d5\u30eb\uff09\u306f\u3001\u30b3\u30e2\u30f3\u306a\u30d4\u30b9\u30c8\u30eb\u3088\u308a\u3082\u653b\u6483\u529b\u304c\u5927\u304d\u3044\u3067\u3059\u3002[\u914d\u7f6e\u5bfe\u7167\u8868\uff1a\u30ec\u30a2\u30ea\u30c6\u30a3 - \u8272\u5f69 - \u30b9\u30c6\u30fc\u30bf\u30b9\u5f37\u5316\uff1a\u30b3\u30e2\u30f3 - \u30b0\u30ec\u30fc - \u306a\u3057\u3001\u30ec\u30a2 - \u7dd1 - \u30b9\u30e9\u30a4\u30c8\u30d6\u30fc\u30b9\u30c8\u3001\u30a8\u30d4\u30c3\u30af - \u30d1\u30fc\u30d7\u30eb - \u30e2\u30c7\u30ec\u30fc\u30c8\u30d6\u30fc\u30b9\u30c8\u3001\u30ec\u30b8\u30a7\u30f3\u30c0\u30ea\u30fc - \u30b4\u30fc\u30eb\u30c9 - \u30b7\u30b0\u30cb\u30d5\u30a3\u30ab\u30f3\u30c8\u30d6\u30fc\u30b9\u30c8]"}, {"question": "\u30d3\u30eb\u30c8\u30fb\u30ed\u30a4\u30e4\u30eb\u306b\u304a\u3051\u308b\u5d50\u306e\u5186\u306e\u4e2d\u5fc3\u306b\u306b\u3042\u308b\u30b3\u30a2\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d3\u30eb\u30c8\u30fb\u30ed\u30a4\u30e4\u30eb\u306b\u304a\u3051\u308b\u5d50\u306e\u5186\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u3088\u308a\u7dca\u5bc6\u306a\u6226\u95d8\u306b\u8ffd\u3044\u8fbc\u3080\u3001\u7e2e\u5c0f\u3057\u3066\u3044\u304f\u30be\u30fc\u30f3\u3067\u3059\u3002\u5186\u306f\u6bb5\u968e\u7684\u306b\u79fb\u52d5\u3057\u3001\u5186\u306e\u5916\u306b\u3044\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u5897\u52a0\u3059\u308b\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u307e\u3059\u3002\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u5e38\u306b\u5b89\u5168\u306a\u30be\u30fc\u30f3\u5185\u306b\u7559\u307e\u308b\u305f\u3081\u306b\u79fb\u52d5\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6700\u7d42\u6bb5\u968e\u3067\u306f\u3001\u5d50\u306e\u30c0\u30e1\u30fc\u30b8\u304c\u5927\u304d\u3044\u305f\u3081\u3001\u5186\u5185\u306b\u7559\u307e\u308b\u3053\u3068\u304c\u5fc5\u9808\u306b\u306a\u308a\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u5186\u304c\u7e2e\u5c0f\u3059\u308b\u2192\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u5186\u306e\u4e2d\u306b\u79fb\u52d5\u3059\u308b\u2192\u6226\u95d8\u304c\u6fc0\u5316\u3059\u308b]"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30d3\u30eb\u30c8\u30fb\u30ed\u30a4\u30e4\u30eb\u3067PC\u7248\u304b\u3089\u30e2\u30d0\u30a4\u30eb\u7248\u3078\u306e\u9032\u884c\u72b6\u6cc1\u3092\u79fb\u884c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001Epic Games\u306e\u3088\u3046\u306a\u30e6\u30cb\u30d0\u30fc\u30b5\u30eb\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30ea\u30f3\u30af\u3059\u308b\u3053\u3068\u3067\u3001\u30d3\u30eb\u30c8\u30fb\u30ed\u30a4\u30e4\u30eb\u3067PC\u7248\u304b\u3089\u30e2\u30d0\u30a4\u30eb\u7248\u3078\u306e\u9032\u884c\u72b6\u6cc1\u3092\u79fb\u884c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u3001\u30b9\u30ad\u30f3\u3001\u9032\u884c\u72b6\u6cc1\u3092\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u30b7\u30fc\u30e0\u30ec\u30b9\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001PC\u7248\u3067\u30b9\u30ad\u30f3\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u3068\u3001\u30e2\u30d0\u30a4\u30eb\u7248\u306e\u30a2\u30ab\u30a6\u30f3\u30c8\u3067\u3082\u4f7f\u7528\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002[\u914d\u7f6e\u5bfe\u7167\u8868\uff1a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0 - \u9032\u884c\u72b6\u6cc1\u79fb\u884c\uff1aPC\u2192\u30e2\u30d0\u30a4\u30eb - \u306f\u3044\u3001\u30e2\u30d0\u30a4\u30eb\u2192PC - \u306f\u3044]"}, {"question": "\u30d3\u30eb\u30c8\u30fb\u30ed\u30a4\u30e4\u30eb\u3067\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u3088\u3046\u306a\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30de\u30c3\u30d7\u306e\u3042\u307e\u308a\u8a2a\u308c\u3066\u3044\u306a\u3044\u30a8\u30ea\u30a2\u3092\u63a2\u691c\u3059\u308b\u3053\u3068\u3067\u3001\u30d3\u30eb\u30c8\u30fb\u30ed\u30a4\u30e4\u30eb\u3067\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6d1e\u7a9f\u306b\u96a0\u3055\u308c\u305f\u79d8\u5bc6\u306e\u30c0\u30f3\u30b9\u30d5\u30ed\u30a2\u304c\u3042\u308a\u3001\u8d77\u52d5\u3059\u308b\u3068\u97f3\u697d\u304c\u6d41\u308c\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3001\u30b2\u30fc\u30e0\u306b\u697d\u3057\u307f\u3068\u767a\u898b\u306e\u8981\u7d20\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u306f\u3001\u57cb\u3082\u308c\u305f\u5b9d\u7269\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u306b\u4f3c\u3066\u3044\u307e\u3059\u3002\u305d\u308c\u306f\u3001\u597d\u5947\u5fc3\u65fa\u76db\u306a\u63a2\u691c\u5bb6\u306b\u3068\u3063\u3066\u5831\u308f\u308c\u308b\u30b5\u30d7\u30e9\u30a4\u30ba\u3067\u3059\u3002]"}]
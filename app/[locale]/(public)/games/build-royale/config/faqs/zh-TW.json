[{"question": "\u5982\u4f55\u8b93\u65b0\u73a9\u5bb6\u5feb\u901f\u638c\u63e1 Build Royale \u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1 Build Royale \u7684\u57fa\u672c\u63a7\u5236\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f 1 - \u901a\u904e\u904a\u73a9\u6559\u5b78\u5730\u5716\u4f86\u719f\u6089\u79fb\u52d5\u63a7\u5236\u3002\u6b65\u9a5f 2 - \u4f7f\u7528\u5feb\u901f\u5efa\u9020\u9078\u55ae\u7df4\u7fd2\u5efa\u9020\u5efa\u7bc9\u7269\uff0c\u4f8b\u5982\u7246\u58c1\u548c\u659c\u5761\uff0c\u4ee5\u5728\u6230\u9b25\u4e2d\u7372\u53d6\u512a\u52e2\u3002\u6b65\u9a5f 3 - \u8207 AI \u6a5f\u5668\u4eba\u9032\u884c\u6230\u9b25\uff0c\u4e86\u89e3\u5c04\u64ca\u6a5f\u5236\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u300c\u885d\u92d2\u69cd\u300d\u4f86\u7df4\u7fd2\u7784\u6e96\u548c\u5c04\u64ca\u3002\u8a18\u4f4f\uff0c\u6301\u7e8c\u7684\u7df4\u7fd2\u662f\u63d0\u5347\u6280\u80fd\u7684\u95dc\u9375\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u63a7\u5236\u60f3\u50cf\u6210\u5b78\u7fd2\u9a0e\u81ea\u884c\u8eca\uff1b\u4e00\u65e6\u4f60\u638c\u63e1\u4e86\u8a23\u7ac5\uff0c\u5b83\u5c31\u6703\u8b8a\u6210\u7b2c\u4e8c\u5929\u6027\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u8cc7\u6e90\u7ba1\u7406\u5c0d\u65bc Build Royale \u7684\u6210\u529f\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u5728 Build Royale \u4e2d\uff0c\u8cc7\u6e90\u7ba1\u7406\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u76f4\u63a5\u5f71\u97ff\u4f60\u7684\u5efa\u9020\u548c\u9632\u79a6\u80fd\u529b\u3002\u6709\u6548\u5730\u6536\u96c6\u6728\u6750\u3001\u77f3\u584a\u548c\u91d1\u5c6c\uff0c\u8b93\u4f60\u80fd\u5920\u5efa\u9020\u5805\u56fa\u7684\u9632\u79a6\u5de5\u4e8b\u548c\u7b56\u7565\u6027\u7684\u9053\u8def\u3002\u4f8b\u5982\uff0c\u5728\u906d\u9047\u6230\u4e2d\uff0c\u64c1\u6709\u8db3\u5920\u7684\u6728\u6750\u5feb\u901f\u5efa\u9020\u7246\u58c1\uff0c\u80fd\u8b93\u4f60\u514d\u53d7\u6575\u4eba\u653b\u64ca\u3002\u6b64\u5916\uff0c\u7ba1\u7406\u4f60\u7684\u5f48\u85e5\u80fd\u78ba\u4fdd\u4f60\u96a8\u6642\u6e96\u5099\u6230\u9b25\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u8cc7\u6e90\u985e\u578b - \u7528\u9014\uff1a\u6728\u6750 - \u5feb\u901f\u5efa\u9020\uff0c\u77f3\u584a - \u8010\u7528\u7d50\u69cb\uff0c\u91d1\u5c6c - \u9ad8\u9632\u79a6\u7d50\u69cb]"}, {"question": "\u65b0\u624b\u5728 Build Royale \u4e2d\u61c9\u8a72\u512a\u5148\u8003\u616e\u54ea\u4e9b\u5fc5\u5099\u7269\u54c1\uff1f", "answer": "Build Royale \u4e2d\u7684\u65b0\u624b\u61c9\u8a72\u512a\u5148\u8003\u616e\u90a3\u4e9b\u589e\u5f37\u751f\u5b58\u80fd\u529b\u548c\u6230\u9b25\u6548\u679c\u7684\u7269\u54c1\u3002\u5fc5\u5099\u7269\u54c1\u5305\u62ec\uff1a1) \u6025\u6551\u5305\uff0c\u7528\u65bc\u6062\u5fa9\u751f\u547d\u503c\uff1b2) \u6b65\u69cd\uff0c\u7528\u65bc\u591a\u529f\u80fd\u6230\u9b25\uff1b\u4ee5\u53ca 3) \u5efa\u9020\u6750\u6599\uff0c\u4f8b\u5982\u6728\u6750\uff0c\u7528\u65bc\u5feb\u901f\u9632\u79a6\u3002\u4f8b\u5982\uff0c\u5728\u906d\u9047\u6230\u5f8c\uff0c\u7e3d\u662f\u651c\u5e36\u6025\u6551\u5305\u4ee5\u6062\u5fa9\u751f\u547d\u503c\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u6025\u6551\u5305\u8207\u8b77\u76fe\u85e5\u6c34 - \u6025\u6551\u5305\u80fd\u7acb\u5373\u6062\u5fa9\u751f\u547d\u503c\uff0c\u800c\u8b77\u76fe\u85e5\u6c34\u80fd\u63d0\u4f9b\u66ab\u6642\u7684\u4fdd\u8b77\u3002]"}, {"question": "\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u5982\u4f55\u5728 Build Royale \u4e2d\u512a\u5316\u4ed6\u5011\u7684\u5efa\u7bc9\u7b56\u7565\uff1f", "answer": "\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u53ef\u4ee5\u900f\u904e\u4ee5\u4e0b\u6b65\u9a5f\u512a\u5316\u4ed6\u5011\u7684\u5efa\u7bc9\u7b56\u7565\uff1a\u6b65\u9a5f 1 - \u5728\u6230\u9b25\u958b\u59cb\u524d\uff0c\u59cb\u7d42\u9810\u5148\u898f\u5283\u4f60\u7684\u5efa\u7bc9\u4f48\u5c40\u3002\u6b65\u9a5f 2 - \u4f7f\u7528\u5148\u9032\u7684\u5efa\u7bc9\u6280\u5de7\uff0c\u4f8b\u5982\u300c90 \u5ea6\u300d\u548c\u300c\u659c\u5761\u885d\u92d2\u300d\u4f86\u4f54\u64da\u9ad8\u5730\u3002\u6b65\u9a5f 3 - \u5c07\u5efa\u7bc9\u8207\u5c04\u64ca\u7d50\u5408\u8d77\u4f86\uff0c\u5c0d\u6575\u4eba\u65bd\u52a0\u58d3\u529b\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u659c\u5761\u885d\u92d2\u4f54\u64da\u9ad8\u5730\uff0c\u7136\u5f8c\u8fc5\u901f\u5207\u63db\u5230\u6563\u5f48\u69cd\u9032\u884c\u8fd1\u6230\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u898f\u5283\u4f48\u5c40 -> \u5be6\u65bd\u5efa\u9020 -> \u53c3\u8207\u6230\u9b25]"}, {"question": "\u70ba\u4ec0\u9ebc\u5728 Build Royale \u7684\u5f8c\u671f\u5834\u666f\u4e2d\uff0c\u4f4d\u7f6e\u5982\u6b64\u91cd\u8981\uff1f", "answer": "\u5728 Build Royale \u7684\u5f8c\u671f\u5834\u666f\u4e2d\uff0c\u4f4d\u7f6e\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6c7a\u5b9a\u4e86\u4f60\u7684\u53ef\u898b\u5ea6\u548c\u8106\u5f31\u6027\u3002\u4f4d\u65bc\u9ad8\u5730\u80fd\u63d0\u4f9b\u6230\u8853\u4e0a\u7684\u512a\u52e2\uff0c\u8b93\u4f60\u53ef\u4ee5\u66f4\u5bb9\u6613\u5730\u767c\u73fe\u548c\u653b\u64ca\u6575\u4eba\u3002\u4f8b\u5982\uff0c\u5728\u6700\u7d42\u5708\u7684\u6230\u9b25\u4e2d\uff0c\u4f54\u64da\u5c71\u4e18\u4f4d\u7f6e\uff0c\u80fd\u8b93\u4f60\u6e05\u695a\u5730\u770b\u5230\u6230\u5834\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u4f4d\u7f6e\u60f3\u50cf\u6210\u4e0b\u68cb\uff1b\u4f60\u653e\u7f6e\u68cb\u5b50\u7684\u4f4d\u7f6e\u6c7a\u5b9a\u6bd4\u8cfd\u7684\u7d50\u679c\u3002]"}, {"question": "\u5728 Build Royale \u4e2d\uff0c\u55ae\u4eba\u6a21\u5f0f\u548c\u5718\u968a\u6a21\u5f0f\u7684\u95dc\u9375\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728 Build Royale \u4e2d\uff0c\u55ae\u4eba\u6a21\u5f0f\u548c\u5718\u968a\u6a21\u5f0f\u7684\u95dc\u9375\u5dee\u7570\u5728\u65bc\uff1a1) \u55ae\u4eba\u6a21\u5f0f\u9700\u8981\u81ea\u6211\u4f9d\u8cf4\uff0c\u800c\u5718\u968a\u6a21\u5f0f\u9700\u8981\u5718\u968a\u5408\u4f5c\u548c\u5354\u8abf\u30022) \u5728\u5718\u968a\u6a21\u5f0f\u4e2d\uff0c\u4f60\u53ef\u4ee5\u5fa9\u6d3b\u968a\u53cb\uff0c\u589e\u52a0\u7b56\u7565\u5c64\u6b21\u30023) \u5718\u968a\u5408\u4f5c\u4e2d\uff0c\u6e9d\u901a\u81f3\u95dc\u91cd\u8981\uff0c\u624d\u80fd\u57f7\u884c\u7d9c\u5408\u7684\u5efa\u7bc9\u548c\u6230\u9b25\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u5728\u5718\u968a\u6a21\u5f0f\u4e2d\uff0c\u4f60\u53ef\u4ee5\u5354\u8abf\u5f9e\u591a\u500b\u89d2\u5ea6\u540c\u6642\u767c\u52d5\u653b\u64ca\uff0c\u4ee5\u58d3\u5012\u5c0d\u624b\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u55ae\u4eba\u6a21\u5f0f - \u7368\u7acb\u7b56\u7565\uff0c\u5718\u968a\u6a21\u5f0f - \u5718\u968a\u5354\u8abf]"}, {"question": "Build Royale \u4e2d\u7684\u6b66\u5668\u7a00\u6709\u5ea6\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "Build Royale \u4e2d\u7684\u6b66\u5668\u7a00\u6709\u5ea6\u7cfb\u7d71\u6839\u64da\u6b66\u5668\u7684\u5a01\u529b\u548c\u53ef\u7528\u6027\u5c0d\u6b66\u5668\u9032\u884c\u5206\u985e\u3002\u7a00\u6709\u5ea6\u5f9e\u5e38\u898b\uff08\u7070\u8272\uff09\u5230\u50b3\u5947\uff08\u91d1\u8272\uff09\u3002\u7a00\u6709\u5ea6\u8d8a\u9ad8\u7684\u6b66\u5668\uff0c\u901a\u5e38\u5177\u6709\u66f4\u597d\u7684\u5c6c\u6027\uff0c\u4f8b\u5982\u66f4\u9ad8\u7684\u50b7\u5bb3\u6216\u66f4\u5feb\u7684\u88dd\u586b\u6642\u9593\u3002\u4f8b\u5982\uff0c\u50b3\u5947\u7a81\u64ca\u6b65\u69cd\u7684\u50b7\u5bb3\u9ad8\u65bc\u5e38\u898b\u624b\u69cd\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u7a00\u6709\u5ea6 - \u984f\u8272 - \u5c6c\u6027\u63d0\u5347\uff1a\u5e38\u898b - \u7070\u8272 - \u7121\uff0c\u7a00\u6709 - \u7da0\u8272 - \u8f15\u5fae\u63d0\u5347\uff0c\u53f2\u8a69 - \u7d2b\u8272 - \u4e2d\u7b49\u63d0\u5347\uff0c\u50b3\u5947 - \u91d1\u8272 - \u986f\u8457\u63d0\u5347]"}, {"question": "\u66b4\u98a8\u5708\u5728 Build Royale \u4e2d\u80cc\u5f8c\u7684\u6838\u5fc3\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "Build Royale \u4e2d\u7684\u66b4\u98a8\u5708\u662f\u4e00\u500b\u6536\u7e2e\u7684\u5340\u57df\uff0c\u8feb\u4f7f\u73a9\u5bb6\u9032\u5165\u66f4\u8fd1\u8ddd\u96e2\u7684\u6230\u9b25\u3002\u66b4\u98a8\u5708\u6703\u5206\u968e\u6bb5\u79fb\u52d5\uff0c\u5c0d\u5708\u5916\u73a9\u5bb6\u9020\u6210\u8d8a\u4f86\u8d8a\u5927\u7684\u50b7\u5bb3\u3002\u73a9\u5bb6\u5fc5\u9808\u4e0d\u65b7\u79fb\u52d5\u624d\u80fd\u7559\u5728\u5b89\u5168\u5340\u57df\u3002\u4f8b\u5982\uff0c\u5728\u6700\u5f8c\u968e\u6bb5\uff0c\u66b4\u98a8\u5708\u6703\u9020\u6210\u5927\u91cf\u7684\u50b7\u5bb3\uff0c\u56e0\u6b64\u7559\u5728\u5708\u5167\u81f3\u95dc\u91cd\u8981\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u66b4\u98a8\u5708\u6536\u7e2e -> \u73a9\u5bb6\u9032\u5165 -> \u6230\u9b25\u52a0\u5287]"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728 Build Royale \u4e2d\u5c07 PC \u9032\u5ea6\u8f49\u79fb\u5230\u624b\u6a5f\u7aef\u55ce\uff1f", "answer": "\u662f\u7684\uff0c\u73a9\u5bb6\u53ef\u4ee5\u900f\u904e\u5c07\u4ed6\u5011\u7684\u5e33\u6236\u9023\u7d50\u5230\u50cf Epic Games \u9019\u6a23\u7684\u901a\u7528\u5e73\u53f0\uff0c\u5c07\u4ed6\u5011\u7684 PC \u9032\u5ea6\u8f49\u79fb\u5230\u624b\u6a5f\u7aef\u3002\u9019\u5141\u8a31\u4f60\u5728\u4e0d\u540c\u88dd\u7f6e\u4e4b\u9593\u9806\u66a2\u5730\u5b58\u53d6\u4f60\u7684\u7269\u54c1\u3001\u76ae\u819a\u548c\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728 PC \u4e0a\u89e3\u9396\u4e86\u4e00\u500b\u76ae\u819a\uff0c\u5b83\u4e5f\u6703\u5728\u4f60\u7684\u624b\u6a5f\u5e33\u6236\u4e0a\u53ef\u7528\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u5e73\u53f0 - \u9032\u5ea6\u8f49\u79fb\uff1aPC -> \u624b\u6a5f - \u662f\uff0c\u624b\u6a5f -> PC - \u662f]"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728 Build Royale \u4e2d\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u5728 Build Royale \u4e2d\u900f\u904e\u63a2\u7d22\u5730\u5716\u4e2d\u8f03\u5c11\u88ab\u63a2\u7d22\u7684\u5730\u5340\u4f86\u767c\u73fe\u96b1\u85cf\u7684\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u5728\u4e00\u500b\u6d1e\u7a74\u4e2d\u96b1\u85cf\u8457\u4e00\u500b\u79d8\u5bc6\u7684\u821e\u6c60\uff0c\u7576\u88ab\u6fc0\u6d3b\u6642\uff0c\u6703\u64ad\u653e\u97f3\u6a02\u3002\u9019\u4e9b\u5f69\u86cb\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u4e00\u5c64\u8da3\u5473\u6027\u548c\u63a2\u7d22\u6027\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c0b\u627e\u5f69\u86cb\u5c31\u50cf\u767c\u73fe\u57cb\u85cf\u7684\u5bf6\u85cf\uff1b\u5c0d\u65bc\u597d\u5947\u7684\u63a2\u96aa\u5bb6\u4f86\u8aaa\uff0c\u9019\u662f\u4e00\u500b\u4ee4\u4eba\u6109\u5feb\u7684\u9a5a\u559c\u3002]"}]
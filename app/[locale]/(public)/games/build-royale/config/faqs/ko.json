[{"question": "\ube4c\ub4dc \ub85c\uc584\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \ub9c8\uc2a4\ud130\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ube4c\ub4dc \ub85c\uc584\uc5d0\uc11c \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \ub9c8\uc2a4\ud130\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: 1\ub2e8\uacc4 - \ud29c\ud1a0\ub9ac\uc5bc \ub9f5\uc744 \ud1b5\ud574 \uc774\ub3d9 \ucee8\ud2b8\ub864\uc5d0 \uc775\uc219\ud574\uc9d1\ub2c8\ub2e4. 2\ub2e8\uacc4 - \ube60\ub978 \uac74\uc124 \uba54\ub274\ub97c \uc0ac\uc6a9\ud558\uc5ec \ubcbd\uacfc \uacbd\uc0ac\ub85c\uc640 \uac19\uc740 \uad6c\uc870\ubb3c\uc744 \uac74\uc124\ud558\uc5ec \uc804\ud22c\uc5d0\uc11c \uc6b0\uc704\ub97c \uc810\ud558\ub294 \uc5f0\uc2b5\uc744 \ud569\ub2c8\ub2e4. 3\ub2e8\uacc4 - AI \ubd07\uacfc \uc804\ud22c\uc5d0 \ucc38\uc5ec\ud558\uc5ec \uc0ac\uaca9 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ubc84\uc2a4\ud2b8 \ub77c\uc774\ud50c'\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc815\ud655\uc131\uc744 \uc5f0\uc2b5\ud569\ub2c8\ub2e4. \uafb8\uc900\ud55c \uc5f0\uc2b5\uc774 \uc2e4\ub825 \ud5a5\uc0c1\uc758 \uc5f4\uc1e0\ub77c\ub294 \uac83\uc744 \uae30\uc5b5\ud558\uc2ed\uc2dc\uc624. [\ube44\uc720 \uc124\uba85: \ucee8\ud2b8\ub864\uc744 \uc790\uc804\uac70 \ud0c0\ub294 \ubc95\uc744 \ubc30\uc6b0\ub294 \uac83\uc73c\ub85c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694. \ud55c \ubc88 \uc775\uc219\ud574\uc9c0\uba74 \uc790\uc5f0\uc2a4\ub7ec\uc6cc\uc9d1\ub2c8\ub2e4.]"}, {"question": "\ube4c\ub4dc \ub85c\uc584\uc5d0\uc11c \uc790\uc6d0 \uad00\ub9ac\uac00 \uc131\uacf5\uc5d0 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ube4c\ub4dc \ub85c\uc584\uc5d0\uc11c \uc790\uc6d0 \uad00\ub9ac\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \uac74\uc124\uacfc \ubc29\uc5b4 \ub2a5\ub825\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \ub098\ubb34, \ub3cc, \uae08\uc18d\uacfc \uac19\uc740 \uc790\uc6d0\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uc218\uc9d1\ud558\uba74 \uac15\ub825\ud55c \ubc29\uc5b4 \uc2dc\uc124\uacfc \uc804\ub7b5\uc801\uc778 \uacbd\ub85c\ub97c \uad6c\ucd95\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uad50\uc804 \uc911\uc5d0 \ubcbd\uc744 \uc2e0\uc18d\ud558\uac8c \uac74\uc124\ud558\uae30 \uc704\ud55c \ub098\ubb34\uac00 \ucda9\ubd84\ud558\uba74 \uc801\uc758 \uacf5\uaca9\uc73c\ub85c\ubd80\ud130 \uc548\uc804\ud558\uac8c \uc9c0\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \ud0c4\uc57d \uad00\ub9ac\ub97c \ud1b5\ud574 \uc5b8\uc81c\ub098 \uc804\ud22c\uc5d0 \ub300\ube44\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc790\uc6d0 \uc885\ub958 - \uc6a9\ub3c4: \ub098\ubb34 - \uc2e0\uc18d\ud55c \uac74\uc124, \ub3cc - \ub0b4\uad6c\uc131\uc774 \uac15\ud55c \uad6c\uc870\ubb3c, \uae08\uc18d - \ubc29\uc5b4\ub825\uc774 \ub192\uc740 \uad6c\uc870\ubb3c]"}, {"question": "\ube4c\ub4dc \ub85c\uc584 \ucd08\uc2ec\uc790\uac00 \uc6b0\uc120\uc801\uc73c\ub85c \uc911\uc810\uc744 \ub450\uc5b4\uc57c \ud560 \ud544\uc218 \uc544\uc774\ud15c\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ube4c\ub4dc \ub85c\uc584 \ucd08\uc2ec\uc790\ub294 \uc0dd\uc874 \ubc0f \uc804\ud22c \ud6a8\uc728\uc131\uc744 \ub192\uc774\ub294 \uc544\uc774\ud15c\uc5d0 \uc6b0\uc120\uc21c\uc704\ub97c \ub450\uc5b4\uc57c \ud569\ub2c8\ub2e4. \ud544\uc218 \uc544\uc774\ud15c\uc73c\ub85c\ub294 1) \uccb4\ub825 \ud68c\ubcf5\uc6a9 \uc758\ub8cc \ud0a4\ud2b8, 2) \ub2e4\uc6a9\ub3c4 \uc804\ud22c\uc5d0 \uc801\ud569\ud55c \ub3cc\uaca9 \uc18c\ucd1d, 3) \uc2e0\uc18d\ud55c \ubc29\uc5b4\ub97c \uc704\ud55c \ub098\ubb34\uc640 \uac19\uc740 \uac74\uc124 \uc790\uc7ac\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uad50\uc804 \ud6c4 \uccb4\ub825\uc744 \ud68c\ubcf5\ud558\uae30 \uc704\ud574 \ud56d\uc0c1 \uc758\ub8cc \ud0a4\ud2b8\ub97c \ud734\ub300\ud558\uc2ed\uc2dc\uc624. [\ub2e4\uc591\ud55c \uc120\ud0dd\uc9c0 \ube44\uad50: \uc758\ub8cc \ud0a4\ud2b8 \ub300 \ubc29\ud328 \ud3ec\uc158 - \uc758\ub8cc \ud0a4\ud2b8\ub294 \uc989\uc2dc \uccb4\ub825\uc744 \ud68c\ubcf5\ud558\ub294 \ubc18\uba74, \ubc29\ud328 \ud3ec\uc158\uc740 \uc77c\uc2dc\uc801\uc778 \ubcf4\ud638\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4.]"}, {"question": "\uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\uac00 \ube4c\ub4dc \ub85c\uc584\uc5d0\uc11c \uac74\uc124 \uc804\ub7b5\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\ub294 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uba74\uc11c \uac74\uc124 \uc804\ub7b5\uc744 \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4: 1\ub2e8\uacc4 - \ud56d\uc0c1 \uc804\ud22c\uc5d0 \ub3cc\uc785\ud558\uae30 \uc804\uc5d0 \uac74\uc124 \ub808\uc774\uc544\uc6c3\uc744 \uc0ac\uc804 \uacc4\ud68d\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4 - '90\ub3c4'\uc640 '\uacbd\uc0ac\ub85c \ub3cc\ud30c'\uc640 \uac19\uc740 \uace0\uae09 \uac74\uc124 \uae30\ubc95\uc744 \uc0ac\uc6a9\ud558\uc5ec \uace0\uc9c0\ub97c \ud655\ubcf4\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4 - \uac74\uc124\uacfc \uc0ac\uaca9\uc744 \uacb0\ud569\ud558\uc5ec \uc0c1\ub300\uc5d0\uac8c \uc555\ubc15\uc744 \uac00\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uacbd\uc0ac\ub85c \ub3cc\ud30c\ub97c \uc0ac\uc6a9\ud558\uc5ec \uace0\uc9c0\ub97c \ud655\ubcf4\ud55c \ud6c4 \uadfc\uc811 \uc804\ud22c\ub97c \uc704\ud574 \uc2e0\uc18d\ud558\uac8c \uc0b0\ud0c4\ucd1d\uc73c\ub85c \uc804\ud658\ud569\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \ub2e4\uc774\uc5b4\uadf8\ub7a8: \ub808\uc774\uc544\uc6c3 \uacc4\ud68d -> \uac74\uc124 \uc2e4\ud589 -> \uc804\ud22c \ucc38\uc5ec]"}, {"question": "\ube4c\ub4dc \ub85c\uc584\uc758 \ud6c4\ubc18\ubd80 \uc2dc\ub098\ub9ac\uc624\uc5d0\uc11c \uc704\uce58\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ube4c\ub4dc \ub85c\uc584\uc758 \ud6c4\ubc18\ubd80 \uc2dc\ub098\ub9ac\uc624\uc5d0\uc11c \uc704\uce58\ub294 \uac00\uc2dc\uc131\uacfc \ucde8\uc57d\uc131\uc744 \uacb0\uc815\ud558\uae30 \ub54c\ubb38\uc5d0 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uace0\uc9c0\ub300\uc5d0 \uc788\ub294 \uac83\uc740 \uc804\uc220\uc801 \uc6b0\uc704\ub97c \uc81c\uacf5\ud558\uc5ec \uc801\uc744 \ub354 \uc27d\uac8c \ubc1c\uacac\ud558\uace0 \uc0ac\uaca9\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub9c8\uc9c0\ub9c9 \uc11c\ud074 \ub3d9\uc548 \uc5b8\ub355\uc5d0 \uc704\uce58\ud558\uba74 \uc804\uc7a5\uc744 \uba85\ud655\ud558\uac8c \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc704\uce58 \uc120\uc815\uc744 \uccb4\uc2a4 \uac8c\uc784\uacfc \ube44\uc720\ud558\uba74, \ub9d0\uc744 \ubc30\uce58\ud558\ub294 \ubc29\uc2dd\uc774 \uac8c\uc784\uc758 \uacb0\uacfc\ub97c \uacb0\uc815\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ube4c\ub4dc \ub85c\uc584\uc5d0\uc11c \uc194\ub85c \ud50c\ub808\uc774\uc640 \uc2a4\ucffc\ub4dc \ud50c\ub808\uc774\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ube4c\ub4dc \ub85c\uc584\uc5d0\uc11c \uc194\ub85c \ud50c\ub808\uc774\uc640 \uc2a4\ucffc\ub4dc \ud50c\ub808\uc774\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: 1) \uc194\ub85c \ud50c\ub808\uc774\ub294 \uc790\ub9bd\uc744 \uc694\uad6c\ud558\ub294 \ubc18\uba74, \uc2a4\ucffc\ub4dc \ud50c\ub808\uc774\ub294 \ud300\uc6cc\ud06c\uc640 \ud611\ub825\uc744 \uc694\uad6c\ud569\ub2c8\ub2e4. 2) \uc2a4\ucffc\ub4dc \ud50c\ub808\uc774\uc5d0\uc11c\ub294 \ub3d9\ub8cc\ub97c \ubd80\ud65c\uc2dc\ud0ac \uc218 \uc788\uc73c\ubbc0\ub85c \uc804\ub7b5\uc801 \uc694\uc18c\uac00 \ub354\ud574\uc9d1\ub2c8\ub2e4. 3) \uc2a4\ucffc\ub4dc \ud50c\ub808\uc774\uc5d0\uc11c\ub294 \uacb0\ud569\ub41c \uac74\uc124 \ubc0f \uc804\ud22c \uc804\ub7b5\uc744 \uc2e4\ud589\ud558\uae30 \uc704\ud574 \uc758\uc0ac\uc18c\ud1b5\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc2a4\ucffc\ub4dc \ud50c\ub808\uc774\uc5d0\uc11c\ub294 \uc5ec\ub7ec \uac01\ub3c4\uc5d0\uc11c \ub3d9\uc2dc \uacf5\uaca9\uc744 \uc870\uc815\ud558\uc5ec \uc0c1\ub300\ub97c \uc555\ub3c4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc120\ud0dd\uc9c0 \ube44\uad50: \uc194\ub85c \ud50c\ub808\uc774 - \ub3c5\ub9bd\uc801\uc778 \uc804\ub7b5, \uc2a4\ucffc\ub4dc \ud50c\ub808\uc774 - \ud300 \ud611\ub825]"}, {"question": "\ube4c\ub4dc \ub85c\uc584\uc758 \ubb34\uae30 \ud76c\uadc0\ub3c4 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "\ube4c\ub4dc \ub85c\uc584\uc758 \ubb34\uae30 \ud76c\uadc0\ub3c4 \uc2dc\uc2a4\ud15c\uc740 \ubb34\uae30\uc758 \ub2a5\ub825\uacfc \uc774\uc6a9 \uac00\ub2a5\uc131\uc744 \uae30\uc900\uc73c\ub85c \ubb34\uae30\ub97c \ubd84\ub958\ud569\ub2c8\ub2e4. \ud76c\uadc0\ub3c4\ub294 \uc77c\ubc18(\ud68c\uc0c9)\uc5d0\uc11c \uc804\uc124(\uae08\uc0c9)\uae4c\uc9c0 \ub2e4\uc591\ud569\ub2c8\ub2e4. \ud76c\uadc0\ub3c4\uac00 \ub192\uc740 \ubb34\uae30\ub294 \uc77c\ubc18\uc801\uc73c\ub85c \uacf5\uaca9\ub825\uc774\ub098 \uc7ac\uc7a5\uc804 \uc18d\ub3c4\uc640 \uac19\uc740 \ud1b5\uacc4\uac00 \ub354 \uc88b\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc804\uc124\uc801\uc778 \uc2a4\uce74(\ub3cc\uaca9 \uc18c\ucd1d)\ub294 \uc77c\ubc18 \ud53c\uc2a4\ud1a8\ubcf4\ub2e4 \ub354 \ub9ce\uc740 \ud53c\ud574\ub97c \uc785\ud799\ub2c8\ub2e4. [\uc790\uc6d0 \uc885\ub958 - \uc6a9\ub3c4: \ud76c\uadc0\ub3c4 - \uc0c9\uc0c1 - \ud1b5\uacc4 \uc99d\uac00: \uc77c\ubc18 - \ud68c\uc0c9 - \uc5c6\uc74c, \ud76c\uadc0 - \ucd08\ub85d - \uc57d\uac04\uc758 \uc99d\uac00, \uc601\uc6c5 - \ubcf4\ub77c\uc0c9 - \uc911\uac04 \uc99d\uac00, \uc804\uc124 - \uae08\uc0c9 - \uc0c1\ub2f9\ud55c \uc99d\uac00]"}, {"question": "\ube4c\ub4dc \ub85c\uc584\uc5d0\uc11c \ud3ed\ud48d \uc11c\ud074 \ub4a4\uc5d0 \uc788\ub294 \ud575\uc2ec \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ube4c\ub4dc \ub85c\uc584\uc758 \ud3ed\ud48d \uc11c\ud074\uc740 \ud50c\ub808\uc774\uc5b4\ub97c \ub354\uc6b1 \uac00\uae4c\uc6b4 \uc804\ud22c\ub85c \uac15\uc81c\ud558\ub294 \uc218\ucd95\ud558\ub294 \uc9c0\uc5ed\uc785\ub2c8\ub2e4. \uc11c\ud074\uc740 \ub2e8\uacc4\uc801\uc73c\ub85c \uc774\ub3d9\ud558\uba74\uc11c \uc678\ubd80\uc5d0 \uc788\ub294 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc810\uc810 \ub354 \ub9ce\uc740 \ud53c\ud574\ub97c \uc785\ud799\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\ub294 \uc548\uc804 \uad6c\uc5ed \ub0b4\uc5d0 \uba38\ubb3c\ub3c4\ub85d \ub04a\uc784\uc5c6\uc774 \uc774\ub3d9\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub9c8\uc9c0\ub9c9 \ub2e8\uacc4\uc5d0\uc11c \ud3ed\ud48d\uc740 \uc0c1\ub2f9\ud55c \ud53c\ud574\ub97c \uc785\ud788\ubbc0\ub85c \uc11c\ud074 \ub0b4\uc5d0 \uba38\ubb34\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \ub2e4\uc774\uc5b4\uadf8\ub7a8: \uc11c\ud074 \ucd95\uc18c -> \ud50c\ub808\uc774\uc5b4 \ub0b4\ubd80 \uc774\ub3d9 -> \uc804\ud22c \uac15\ud654]"}, {"question": "\ud50c\ub808\uc774\uc5b4\uac00 PC\uc5d0\uc11c \ubaa8\ubc14\uc77c\ub85c \ube4c\ub4dc \ub85c\uc584\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc608, \ud50c\ub808\uc774\uc5b4\ub294 \uc5d0\ud53d \uac8c\uc784\uc988\uc640 \uac19\uc740 \ubc94\uc6a9 \ud50c\ub7ab\ud3fc\uc5d0 \uacc4\uc815\uc744 \uc5f0\uacb0\ud558\uc5ec PC\uc5d0\uc11c \ubaa8\ubc14\uc77c\ub85c \ube4c\ub4dc \ub85c\uc584\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub807\uac8c \ud558\uba74 \uc7a5\ube44, \uc2a4\ud0a8 \ubc0f \uc9c4\ud589 \uc0c1\ud669\uc5d0 \ub300\ud55c \uc6d0\ud65c\ud55c \uc561\uc138\uc2a4\ub97c \ub2e4\uc591\ud55c \uae30\uae30\uc5d0\uc11c \uc774\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \uc2a4\ud0a8\uc744 \ud68d\ub4dd\ud558\uba74 \ubaa8\ubc14\uc77c \uacc4\uc815\uc5d0\uc11c\ub3c4 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc790\uc6d0 \uc885\ub958 - \uc6a9\ub3c4: \ud50c\ub7ab\ud3fc - \uc9c4\ud589 \uc0c1\ud669 \uc804\uc1a1: PC -> \ubaa8\ubc14\uc77c - \uc608, \ubaa8\ubc14\uc77c -> PC - \uc608]"}, {"question": "\ube4c\ub4dc \ub85c\uc584\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud50c\ub808\uc774\uc5b4\ub294 \ub9f5\uc758 \ub35c \uc790\uc8fc \ubc29\ubb38\ud558\ub294 \uc9c0\uc5ed\uc744 \ud0d0\ud5d8\ud558\uc5ec \ube4c\ub4dc \ub85c\uc584\uc5d0\uc11c \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub3d9\uad74\uc5d0\ub294 \ud65c\uc131\ud654\ub418\uba74 \uc74c\uc545\uc774 \ub098\uc624\ub294 \ube44\ubc00 \ubb34\ub3c4\uc7a5\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uac8c\uc784\uc5d0 \uc7ac\ubbf8\uc640 \ud0d0\ud5d8 \uc694\uc18c\ub97c \ub354\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ucc3e\ub294 \uac83\uc740 \ubb3b\ud78c \ubcf4\ubb3c\uc744 \ubc1c\uacac\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ud638\uae30\uc2ec \ub9ce\uc740 \ud0d0\ud5d8\uac00\ub4e4\uc5d0\uac8c \ubcf4\uc0c1\uc774 \ub418\ub294 \ub180\ub77c\uc6c0\uc785\ub2c8\ub2e4.]"}]
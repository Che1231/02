[{"question": "\u65b0\u73a9\u5bb6\u5982\u4f55\u5feb\u901f\u7406\u89e3\u300a\u6846\u67b6\u300b\u4e2d\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u4e3a\u4e86\u5feb\u901f\u638c\u63e1\u300a\u6846\u67b6\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41\uff1a\u719f\u6089\u79fb\u52a8\u9762\u677f\u7684\u89e6\u63a7\u6216\u9f20\u6807\u64cd\u4f5c\u3002\u6b65\u9aa42\uff1a\u7ec3\u4e60\u91cd\u65b0\u6392\u5217\u9762\u677f\uff0c\u89c2\u5bdf\u5176\u5bf9\u573a\u666f\u7ed3\u679c\u7684\u5f71\u54cd\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u201c\u64a4\u9500\u201d\u529f\u80fd\u7ea0\u6b63\u9519\u8bef\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u5173\u4e2d\uff0c\u5c06\u9762\u677f\u5411\u5de6\u79fb\u52a8\u53ef\u4ee5\u8ba9\u89d2\u8272\u907f\u5f00\u9677\u9631\u3002\u8fd9\u79cd\u5b9e\u8df5\u65b9\u6cd5\u6709\u52a9\u4e8e\u5efa\u7acb\u4fe1\u5fc3\u5e76\u7406\u89e3\u6e38\u620f\u673a\u5236\u3002"}, {"question": "\u300a\u6846\u67b6\u300b\u4e2d\u9762\u677f\u91cd\u65b0\u6392\u5217\u7684\u65f6\u95f4\u987a\u5e8f\u4e3a\u4ec0\u4e48\u91cd\u8981\uff1f", "answer": "\u5728\u300a\u6846\u67b6\u300b\u4e2d\uff0c\u65f6\u95f4\u987a\u5e8f\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u76f4\u63a5\u5f71\u54cd\u4e8b\u4ef6\u7684\u987a\u5e8f\u3002\u6b65\u9aa41\uff1a\u89c2\u5bdf\u89d2\u8272\u7684\u79fb\u52a8\u548c\u73af\u5883\u3002\u6b65\u9aa42\uff1a\u786e\u5b9a\u6700\u4f73\u65f6\u673a\u91cd\u65b0\u6392\u5217\u9762\u677f\u4ee5\u6539\u53d8\u7ed3\u679c\u3002\u6b65\u9aa43\uff1a\u6d4b\u8bd5\u4e0d\u540c\u7684\u65f6\u95f4\u987a\u5e8f\uff0c\u89c2\u5bdf\u5176\u6548\u679c\u3002\u4f8b\u5982\uff0c\u5728\u89d2\u8272\u88ab\u8ffd\u8d76\u7684\u5173\u5361\u4e2d\uff0c\u8fc7\u65e9\u6216\u8fc7\u665a\u5730\u91cd\u65b0\u6392\u5217\u9762\u677f\u53ef\u80fd\u5bfc\u81f4\u88ab\u6355\u6216\u9003\u8131\u3002\u8fd9\u79cd\u7b56\u7565\u6027\u5143\u7d20\u589e\u52a0\u4e86\u76ca\u667a\u89e3\u8c1c\u4f53\u9a8c\u7684\u6df1\u5ea6\u3002"}, {"question": "\u300a\u6846\u67b6\u300b\u7684\u79fb\u52a8\u7aef\u548cPC\u7aef\u7248\u672c\u4e4b\u95f4\u6709\u4ec0\u4e48\u4e3b\u8981\u533a\u522b\uff1f", "answer": "\u300a\u6846\u67b6\u300b\u79fb\u52a8\u7aef\u548cPC\u7aef\u7248\u672c\u7684\u4e3b\u8981\u533a\u522b\u5728\u4e8e\u63a7\u5236\u65b9\u6848\u548c\u5c4f\u5e55\u5c3a\u5bf8\u3002\u5728\u79fb\u52a8\u7aef\uff0c\u89e6\u63a7\u64cd\u4f5c\u5141\u8bb8\u76f4\u89c2\u5730\u64cd\u4f5c\u9762\u677f\uff0c\u800c\u5728PC\u7aef\uff0c\u9f20\u6807\u64cd\u4f5c\u63d0\u4f9b\u7cbe\u786e\u5ea6\u3002\u6b64\u5916\uff0cPC\u7aef\u7684\u66f4\u5927\u5c4f\u5e55\u63d0\u4f9b\u4e86\u66f4\u8eab\u4e34\u5176\u5883\u7684\u89c6\u89c9\u4f53\u9a8c\u3002\u7136\u800c\uff0c\u4e24\u4e2a\u7248\u672c\u90fd\u4fdd\u7559\u4e86\u76f8\u540c\u7684\u6838\u5fc3\u6e38\u620f\u673a\u5236\u548c\u53d9\u4e8b\uff0c\u4fdd\u8bc1\u4e86\u8de8\u5e73\u53f0\u7684\u6301\u7eed\u4f53\u9a8c\u3002"}, {"question": "\u54ea\u4e9b\u9ad8\u7ea7\u7b56\u7565\u53ef\u4ee5\u5e2e\u52a9\u89e3\u51b3\u300a\u6846\u67b6\u300b\u4e2d\u7684\u590d\u6742\u8c1c\u9898\uff1f", "answer": "\u89e3\u51b3\u300a\u6846\u67b6\u300b\u4e2d\u590d\u6742\u8c1c\u9898\u7684\u9ad8\u7ea7\u7b56\u7565\u5305\u62ec\uff1a\u6b65\u9aa41\uff1a\u5728\u8fdb\u884c\u4efb\u4f55\u79fb\u52a8\u4e4b\u524d\u5206\u6790\u6574\u4e2a\u4e8b\u4ef6\u5e8f\u5217\u3002\u6b65\u9aa42\uff1a\u8bc6\u522b\u6bcf\u4e2a\u9762\u677f\u91cd\u65b0\u6392\u5217\u7684\u591a\u79cd\u6f5c\u5728\u7ed3\u679c\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u8bd5\u9519\u6cd5\u6d4b\u8bd5\u4e0d\u540c\u7684\u5e8f\u5217\u3002\u4f8b\u5982\uff0c\u5728\u6709\u591a\u4e2a\u9677\u9631\u7684\u5173\u5361\u4e2d\uff0c\u91cd\u65b0\u6392\u5217\u9762\u677f\u4ee5\u521b\u5efa\u5b89\u5168\u8def\u5f84\u9700\u8981\u4ed4\u7ec6\u7684\u8ba1\u5212\u548c\u6267\u884c\u3002\u8fd9\u79cd\u6709\u6761\u7406\u7684\u65b9\u6cd5\u63d0\u9ad8\u4e86\u89e3\u51b3\u95ee\u9898\u7684\u80fd\u529b\uff0c\u5e76\u589e\u52a0\u6210\u529f\u7684\u53ef\u80fd\u6027\u3002"}, {"question": "\u53d9\u4e8b\u662f\u5982\u4f55\u5f71\u54cd\u300a\u6846\u67b6\u300b\u4e2d\u7684\u8c1c\u9898\u8bbe\u8ba1\u7684\uff1f", "answer": "\u300a\u6846\u67b6\u300b\u4e2d\u7684\u53d9\u4e8b\u4e0e\u8c1c\u9898\u8bbe\u8ba1\u7d27\u5bc6\u7ed3\u5408\uff0c\u56e0\u4e3a\u6bcf\u4e2a\u5173\u5361\u90fd\u53cd\u6620\u4e86\u6545\u4e8b\u7684\u4e00\u90e8\u5206\u3002\u6b65\u9aa41\uff1a\u5173\u6ce8\u6bcf\u4e2a\u573a\u666f\u4e2d\u63d0\u4f9b\u7684\u89c6\u89c9\u63d0\u793a\u548c\u4e0a\u4e0b\u6587\u3002\u6b65\u9aa42\uff1a\u5229\u7528\u53d9\u4e8b\u6765\u9884\u6d4b\u6f5c\u5728\u7684\u7ed3\u679c\u548c\u969c\u788d\u3002\u6b65\u9aa43\uff1a\u5c06\u4f60\u7684\u89e3\u8c1c\u65b9\u6cd5\u4e0e\u6545\u4e8b\u7684\u53d1\u5c55\u5bf9\u9f50\u3002\u4f8b\u5982\uff0c\u5728\u89d2\u8272\u8bd5\u56fe\u9003\u8dd1\u7684\u5173\u5361\u4e2d\uff0c\u8c1c\u9898\u7684\u8bbe\u8ba1\u65e8\u5728\u6a21\u4eff\u53d9\u4e8b\u7684\u7d27\u8feb\u6027\u548c\u7d27\u5f20\u611f\uff0c\u521b\u9020\u51fa\u8fde\u8d2f\u4e14\u5f15\u4eba\u5165\u80dc\u7684\u4f53\u9a8c\u3002"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728\u300a\u6846\u67b6\u300b\u4e2d\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u5185\u5bb9\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u63a2\u7d22\u8c1c\u9898\u7684\u66ff\u4ee3\u65b9\u6848\u6765\u53d1\u73b0\u300a\u6846\u67b6\u300b\u4e2d\u7684\u9690\u85cf\u5185\u5bb9\u3002\u6b65\u9aa41\uff1a\u5bfb\u627e\u4e0d\u592a\u660e\u663e\u7684\u9762\u677f\u6392\u5217\uff0c\u8fd9\u4e9b\u6392\u5217\u4f1a\u5bfc\u81f4\u4e0d\u540c\u7684\u7ed3\u679c\u3002\u6b65\u9aa42\uff1a\u5c1d\u8bd5\u4e0d\u5bfb\u5e38\u7684\u5e8f\u5217\uff0c\u4ee5\u53d1\u73b0\u79d8\u5bc6\u573a\u666f\u6216\u7ed3\u5c40\u3002\u6b65\u9aa43\uff1a\u91cd\u73a9\u5173\u5361\uff0c\u4ee5\u627e\u5230\u6700\u521d\u53ef\u80fd\u9519\u8fc7\u7684\u9690\u85cf\u7ec6\u8282\u3002\u4f8b\u5982\uff0c\u5728\u540e\u7eed\u5173\u5361\u4e2d\u6309\u7167\u7279\u5b9a\u987a\u5e8f\u91cd\u65b0\u6392\u5217\u9762\u677f\uff0c\u53ef\u4ee5\u63ed\u793a\u9690\u85cf\u7684\u60c5\u8282\uff0c\u589e\u52a0\u6545\u4e8b\u7684\u6df1\u5ea6\uff0c\u5e76\u5956\u52b1\u597d\u5947\u7684\u73a9\u5bb6\u3002"}, {"question": "\u6e38\u620f\u673a\u5236\u5982\u4f55\u5728\u300a\u6846\u67b6\u300b\u4e2d\u9f13\u52b1\u521b\u9020\u6027\u7684\u95ee\u9898\u89e3\u51b3\uff1f", "answer": "\u300a\u6846\u67b6\u300b\u7684\u673a\u5236\u901a\u8fc7\u5141\u8bb8\u6bcf\u4e2a\u8c1c\u9898\u6709\u591a\u79cd\u89e3\u51b3\u65b9\u6848\u6765\u9f13\u52b1\u521b\u9020\u6027\u7684\u95ee\u9898\u89e3\u51b3\u3002\u6b65\u9aa41\uff1a\u63a2\u7d22\u4e0d\u540c\u7684\u9762\u677f\u6392\u5217\uff0c\u770b\u770b\u5b83\u4eec\u5982\u4f55\u5f71\u54cd\u7ed3\u679c\u3002\u6b65\u9aa42\uff1a\u8df3\u51fa\u601d\u7ef4\u5b9a\u52bf\uff0c\u8003\u8651\u975e\u5e38\u89c4\u7684\u5e8f\u5217\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u201c\u64a4\u9500\u201d\u529f\u80fd\u8fdb\u884c\u5b9e\u9a8c\uff0c\u65e0\u9700\u60e9\u7f5a\u3002\u4f8b\u5982\uff0c\u5728\u89d2\u8272\u5fc5\u987b\u7a7f\u8fc7\u8ff7\u5bab\u7684\u5173\u5361\u4e2d\uff0c\u73a9\u5bb6\u53ef\u4ee5\u627e\u5230\u72ec\u7279\u7684\u8def\u5f84\u5230\u8fbe\u76f8\u540c\u7684\u76ee\u6807\uff0c\u57f9\u517b\u521b\u9020\u529b\u548c\u6218\u7565\u601d\u7ef4\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u300a\u6846\u67b6\u300b\u7684\u6781\u7b80\u827a\u672f\u98ce\u683c\u6709\u6548\uff1f", "answer": "\u300a\u6846\u67b6\u300b\u7684\u6781\u7b80\u827a\u672f\u98ce\u683c\u4e4b\u6240\u4ee5\u6709\u6548\uff0c\u662f\u56e0\u4e3a\u5b83\u5c06\u73a9\u5bb6\u7684\u6ce8\u610f\u529b\u96c6\u4e2d\u5728\u6838\u5fc3\u673a\u5236\u548c\u53d9\u4e8b\u4e0a\u3002\u6b65\u9aa41\uff1a\u6ce8\u610f\u89c6\u89c9\u7684\u7b80\u5355\u6027\u5982\u4f55\u589e\u5f3a\u6e05\u6670\u5ea6\u5e76\u51cf\u5c11\u5e72\u6270\u3002\u6b65\u9aa42\uff1a\u6b23\u8d4f\u8fd9\u79cd\u827a\u672f\u98ce\u683c\u5982\u4f55\u8865\u5145\u6e38\u620f\u7684\u9ed1\u8272\u4e3b\u9898\uff0c\u589e\u5f3a\u6c1b\u56f4\u3002\u6b65\u9aa43\uff1a\u8ba4\u8bc6\u5230\u6781\u7b80\u4e3b\u4e49\u65b9\u6cd5\u5141\u8bb8\u66f4\u76f4\u89c2\u5730\u4e0e\u9762\u677f\u8fdb\u884c\u4ea4\u4e92\u3002\u8fd9\u79cd\u8bbe\u8ba1\u9009\u62e9\u786e\u4fdd\u73a9\u5bb6\u59cb\u7ec8\u4e13\u6ce8\u4e8e\u89e3\u8c1c\u548c\u8bb2\u6545\u4e8b\u7684\u5143\u7d20\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u4f18\u5316\u4ed6\u4eec\u5728\u300a\u6846\u67b6\u300b\u4e2d\u7684\u8868\u73b0\u4ee5\u83b7\u5f97\u6210\u5c31\uff1f", "answer": "\u4e3a\u4e86\u5728\u300a\u6846\u67b6\u300b\u4e2d\u4f18\u5316\u8ffd\u6c42\u6210\u5c31\u7684\u8868\u73b0\uff0c\u73a9\u5bb6\u5e94\u8be5\uff1a\u6b65\u9aa41\uff1a\u4e13\u6ce8\u4e8e\u4ee5\u6700\u5c11\u7684\u79fb\u52a8\u6b21\u6570\u5b8c\u6210\u5173\u5361\u3002\u6b65\u9aa42\uff1a\u63a2\u7d22\u6240\u6709\u53ef\u80fd\u7684\u6392\u5217\u7ec4\u5408\uff0c\u4ee5\u89e3\u9501\u9690\u85cf\u6210\u5c31\u3002\u6b65\u9aa43\uff1a\u91cd\u73a9\u5173\u5361\uff0c\u4ee5\u786e\u4fdd\u53d1\u73b0\u6240\u6709\u53d9\u4e8b\u5206\u652f\u3002\u4f8b\u5982\uff0c\u5728\u6709\u591a\u4e2a\u7ed3\u5c40\u7684\u5173\u5361\u4e2d\uff0c\u83b7\u5f97\u6bcf\u4e2a\u7ed3\u5c40\u90fd\u9700\u8981\u4e0d\u540c\u7684\u7b56\u7565\u548c\u7ec6\u81f4\u7684\u5173\u6ce8\uff0c\u589e\u5f3a\u6574\u4f53\u4f53\u9a8c\u5e76\u589e\u52a0\u83b7\u5f97\u6210\u5c31\u7684\u673a\u4f1a\u3002"}, {"question": "\u73a9\u5bb6\u7684\u4e3b\u52a8\u6027\u5728\u300a\u6846\u67b6\u300b\u7684\u6545\u4e8b\u8bb2\u8ff0\u4e2d\u626e\u6f14\u4ec0\u4e48\u89d2\u8272\uff1f", "answer": "\u300a\u6846\u67b6\u300b\u4e2d\u7684\u73a9\u5bb6\u4e3b\u52a8\u6027\u662f\u6545\u4e8b\u8bb2\u8ff0\u7684\u6838\u5fc3\uff0c\u56e0\u4e3a\u6240\u505a\u7684\u9009\u62e9\u76f4\u63a5\u5f71\u54cd\u53d9\u4e8b\u3002 \u6b65\u9aa41\uff1a\u4e86\u89e3\u6bcf\u6b21\u9762\u677f\u91cd\u65b0\u6392\u5217\u90fd\u4f1a\u6539\u53d8\u6545\u4e8b\u7684\u8fdb\u7a0b\u3002\u6b65\u9aa42\uff1a\u8ba4\u8bc6\u5230\u4e0d\u540c\u7684\u5e8f\u5217\u4f1a\u5bfc\u81f4\u4e0d\u540c\u7684\u7ed3\u679c\uff0c\u53cd\u6620\u73a9\u5bb6\u7684\u51b3\u5b9a\u3002\u6b65\u9aa43\uff1a\u6b23\u8d4f\u5141\u8bb8\u4e2a\u6027\u5316\u6545\u4e8b\u8bb2\u8ff0\u7684\u5206\u652f\u8def\u5f84\u3002\u4f8b\u5982\uff0c\u5728\u89d2\u8272\u5fc5\u987b\u5728\u4e24\u6761\u8def\u5f84\u4e2d\u505a\u51fa\u9009\u62e9\u7684\u5173\u5361\u4e2d\uff0c\u73a9\u5bb6\u7684\u9009\u62e9\u4f1a\u5f71\u54cd\u540e\u7eed\u4e8b\u4ef6\uff0c\u8ba9\u6bcf\u4e2a\u73a9\u5bb6\u7684\u53d9\u4e8b\u4f53\u9a8c\u90fd\u72ec\u4e00\u65e0\u4e8c\u3002"}]
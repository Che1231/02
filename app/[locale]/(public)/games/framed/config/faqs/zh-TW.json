[{"question": "\u5982\u4f55\u8b93\u65b0\u73a9\u5bb6\u5feb\u901f\u7406\u89e3 Framed \u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1 Framed \u7684\u57fa\u672c\u63a7\u5236\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u719f\u6089\u89f8\u63a7\u6216\u6ed1\u9f20\u63a7\u5236\u9762\u677f\u79fb\u52d5\u3002\u6b65\u9a5f2\uff1a\u7df4\u7fd2\u91cd\u65b0\u6392\u5217\u9762\u677f\uff0c\u89c0\u5bdf\u5176\u5982\u4f55\u5f71\u97ff\u5834\u666f\u7d50\u679c\u3002\u6b65\u9a5f3\uff1a\u4f7f\u7528\u300c\u5fa9\u539f\u300d\u529f\u80fd\u4fee\u6b63\u932f\u8aa4\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u95dc\u4e2d\uff0c\u5c07\u9762\u677f\u79fb\u5230\u5de6\u5074\u53ef\u4ee5\u8b93\u89d2\u8272\u907f\u958b\u9677\u9631\u3002\u9019\u7a2e\u5be6\u4f5c\u65b9\u6cd5\u6709\u52a9\u65bc\u5efa\u7acb\u4fe1\u5fc3\u4e26\u7406\u89e3\u904a\u6232\u6a5f\u5236\u3002"}, {"question": "\u70ba\u4ec0\u9ebc Framed \u4e2d\u9762\u677f\u91cd\u65b0\u6392\u5217\u7684\u6642\u9593\u9806\u5e8f\u5f88\u91cd\u8981\uff1f", "answer": "Framed \u4e2d\u7684\u6642\u9593\u9806\u5e8f\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u76f4\u63a5\u5f71\u97ff\u4e8b\u4ef6\u7684\u9806\u5e8f\u3002\u6b65\u9a5f1\uff1a\u89c0\u5bdf\u89d2\u8272\u7684\u79fb\u52d5\u548c\u74b0\u5883\u3002\u6b65\u9a5f2\uff1a\u8b58\u5225\u6700\u4f73\u7684\u6642\u523b\u91cd\u65b0\u6392\u5217\u9762\u677f\u4ee5\u6539\u8b8a\u7d50\u679c\u3002\u6b65\u9a5f3\uff1a\u6e2c\u8a66\u4e0d\u540c\u7684\u6642\u9593\u9806\u5e8f\u89c0\u5bdf\u5176\u6548\u679c\u3002\u4f8b\u5982\uff0c\u5728\u89d2\u8272\u88ab\u8ffd\u8d95\u7684\u95dc\u5361\u4e2d\uff0c\u904e\u65e9\u6216\u904e\u665a\u91cd\u65b0\u6392\u5217\u9762\u677f\u90fd\u53ef\u80fd\u5c0e\u81f4\u88ab\u6355\u6216\u9003\u812b\u3002\u9019\u500b\u7b56\u7565\u6027\u5143\u7d20\u589e\u52a0\u4e86\u76ca\u667a\u904a\u6232\u9ad4\u9a57\u7684\u6df1\u5ea6\u3002"}, {"question": "\u884c\u52d5\u88dd\u7f6e\u7248\u548c\u96fb\u8166\u7248 Framed \u7684\u4e3b\u8981\u5dee\u7570\u70ba\u4f55\uff1f", "answer": "\u884c\u52d5\u88dd\u7f6e\u7248\u548c\u96fb\u8166\u7248 Framed \u7684\u4e3b\u8981\u5dee\u7570\u5728\u65bc\u63a7\u5236\u65b9\u6848\u548c\u87a2\u5e55\u5927\u5c0f\u3002\u884c\u52d5\u88dd\u7f6e\u7248\u4f7f\u7528\u89f8\u63a7\u63a7\u5236\uff0c\u8b93\u9762\u677f\u64cd\u4f5c\u66f4\u76f4\u89ba\uff1b\u800c\u96fb\u8166\u7248\u5247\u4f7f\u7528\u6ed1\u9f20\u63a7\u5236\uff0c\u63d0\u4f9b\u66f4\u9ad8\u7684\u7cbe\u78ba\u5ea6\u3002\u6b64\u5916\uff0c\u96fb\u8166\u7248\u66f4\u5927\u7684\u87a2\u5e55\u63d0\u4f9b\u66f4\u8eab\u81e8\u5176\u5883\u7684\u8996\u89ba\u9ad4\u9a57\u3002\u7136\u800c\uff0c\u5169\u8005\u90fd\u7dad\u6301\u76f8\u540c\u7684\u6838\u5fc3\u904a\u6232\u6a5f\u5236\u548c\u6558\u4e8b\uff0c\u78ba\u4fdd\u8de8\u5e73\u53f0\u7684\u9023\u8cab\u9ad4\u9a57\u3002"}, {"question": "\u54ea\u4e9b\u5148\u9032\u7684\u7b56\u7565\u53ef\u4ee5\u5e6b\u52a9\u89e3\u6c7a Framed \u4e2d\u7684\u8907\u96dc\u8b0e\u984c\uff1f", "answer": "\u89e3\u6c7a Framed \u4e2d\u7684\u8907\u96dc\u8b0e\u984c\u7684\u5148\u9032\u7b56\u7565\u5305\u62ec\uff1a\u6b65\u9a5f1\uff1a\u5728\u9032\u884c\u4efb\u4f55\u52d5\u4f5c\u4e4b\u524d\uff0c\u5206\u6790\u6574\u500b\u4e8b\u4ef6\u9806\u5e8f\u3002\u6b65\u9a5f2\uff1a\u8b58\u5225\u6bcf\u500b\u9762\u677f\u91cd\u65b0\u6392\u5217\u7684\u6f5b\u5728\u7d50\u679c\u3002\u6b65\u9a5f3\uff1a\u4f7f\u7528\u8a66\u8aa4\u6cd5\u6e2c\u8a66\u4e0d\u540c\u7684\u9806\u5e8f\u3002\u4f8b\u5982\uff0c\u5728\u6709\u591a\u500b\u9677\u9631\u7684\u95dc\u5361\u4e2d\uff0c\u91cd\u65b0\u6392\u5217\u9762\u677f\u4ee5\u5275\u9020\u5b89\u5168\u8def\u7dda\u9700\u8981\u4ed4\u7d30\u7684\u898f\u5283\u548c\u57f7\u884c\u3002\u9019\u7a2e\u6709\u689d\u7406\u7684\u65b9\u6cd5\u589e\u5f37\u4e86\u89e3\u6c7a\u554f\u984c\u7684\u80fd\u529b\uff0c\u4e26\u63d0\u9ad8\u6210\u529f\u7684\u6a5f\u7387\u3002"}, {"question": "\u904a\u6232\u6558\u4e8b\u5982\u4f55\u5f71\u97ff Framed \u7684\u8b0e\u984c\u8a2d\u8a08\uff1f", "answer": "Framed \u7684\u6558\u4e8b\u8207\u8b0e\u984c\u8a2d\u8a08\u7dca\u5bc6\u7d50\u5408\uff0c\u56e0\u70ba\u6bcf\u4e00\u95dc\u90fd\u53cd\u6620\u4e86\u6545\u4e8b\u7684\u4e00\u90e8\u5206\u3002\u6b65\u9a5f1\uff1a\u6ce8\u610f\u6bcf\u500b\u5834\u666f\u63d0\u4f9b\u7684\u8996\u89ba\u63d0\u793a\u548c\u60c5\u5883\u3002\u6b65\u9a5f2\uff1a\u5229\u7528\u6558\u4e8b\u9810\u6e2c\u6f5b\u5728\u7684\u7d50\u679c\u548c\u969c\u7919\u3002\u6b65\u9a5f3\uff1a\u5c07\u60a8\u7684\u89e3\u984c\u65b9\u6cd5\u8207\u6545\u4e8b\u7684\u9032\u5c55\u4fdd\u6301\u4e00\u81f4\u3002\u4f8b\u5982\uff0c\u5728\u89d2\u8272\u8a66\u5716\u9003\u812b\u7684\u95dc\u5361\u4e2d\uff0c\u8b0e\u984c\u8a2d\u8a08\u6a21\u4eff\u6558\u4e8b\u4e2d\u7684\u7dca\u8feb\u611f\u548c\u5f35\u529b\uff0c\u5275\u9020\u51fa\u9023\u8cab\u4e14\u5f15\u4eba\u5165\u52dd\u7684\u9ad4\u9a57\u3002"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728 Framed \u4e2d\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u5167\u5bb9\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u900f\u904e\u63a2\u7d22\u8b0e\u984c\u7684\u66ff\u4ee3\u89e3\u6cd5\u4f86\u767c\u73fe Framed \u4e2d\u7684\u96b1\u85cf\u5167\u5bb9\u3002\u6b65\u9a5f1\uff1a\u5c0b\u627e\u4e0d\u592a\u660e\u986f\u7684\u9762\u677f\u6392\u5217\uff0c\u9019\u4e9b\u6392\u5217\u6703\u5c0e\u81f4\u4e0d\u540c\u7684\u7d50\u679c\u3002\u6b65\u9a5f2\uff1a\u5617\u8a66\u4f7f\u7528\u975e\u5e38\u898f\u9806\u5e8f\u4f86\u63ed\u793a\u79d8\u5bc6\u5834\u666f\u6216\u7d50\u5c40\u3002\u6b65\u9a5f3\uff1a\u91cd\u73a9\u95dc\u5361\uff0c\u4ee5\u767c\u73fe\u6700\u521d\u53ef\u80fd\u932f\u904e\u7684\u96b1\u85cf\u7d30\u7bc0\u3002\u4f8b\u5982\uff0c\u5728\u5f8c\u7e8c\u95dc\u5361\u4e2d\u4ee5\u7279\u5b9a\u9806\u5e8f\u91cd\u65b0\u6392\u5217\u9762\u677f\uff0c\u53ef\u4ee5\u63ed\u793a\u96b1\u85cf\u7684\u5b50\u60c5\u7bc0\uff0c\u589e\u5f37\u6545\u4e8b\u7684\u6df1\u5ea6\uff0c\u4e26\u734e\u52f5\u597d\u5947\u7684\u73a9\u5bb6\u3002"}, {"question": "\u904a\u6232\u6a5f\u5236\u5982\u4f55\u9f13\u52f5 Framed \u4e2d\u7684\u5275\u610f\u554f\u984c\u89e3\u6c7a\uff1f", "answer": "Framed \u7684\u6a5f\u5236\u9f13\u52f5\u5275\u610f\u554f\u984c\u89e3\u6c7a\uff0c\u56e0\u70ba\u6bcf\u500b\u8b0e\u984c\u5141\u8a31\u591a\u7a2e\u89e3\u6cd5\u3002\u6b65\u9a5f1\uff1a\u63a2\u7d22\u4e0d\u540c\u7684\u9762\u677f\u6392\u5217\u65b9\u5f0f\uff0c\u89c0\u5bdf\u5176\u5982\u4f55\u5f71\u97ff\u7d50\u679c\u3002\u6b65\u9a5f2\uff1a\u8df3\u51fa\u6846\u67b6\uff0c\u8003\u616e\u975e\u5e38\u898f\u9806\u5e8f\u3002\u6b65\u9a5f3\uff1a\u4f7f\u7528\u300c\u5fa9\u539f\u300d\u529f\u80fd\u9032\u884c\u5be6\u9a57\uff0c\u7121\u9700\u61f2\u7f70\u3002\u4f8b\u5982\uff0c\u5728\u89d2\u8272\u5fc5\u9808\u7a7f\u8d8a\u8ff7\u5bae\u7684\u95dc\u5361\u4e2d\uff0c\u73a9\u5bb6\u53ef\u4ee5\u627e\u5230\u7368\u7279\u7684\u8def\u7dda\uff0c\u901a\u5f80\u76f8\u540c\u7684\u76ee\u6a19\uff0c\u57f9\u990a\u5275\u9020\u529b\u548c\u7b56\u7565\u601d\u7dad\u3002"}, {"question": "\u70ba\u4ec0\u9ebc Framed \u7684\u6975\u7c21\u85dd\u8853\u98a8\u683c\u6709\u6548\uff1f", "answer": "Framed \u4e2d\u7684\u6975\u7c21\u85dd\u8853\u98a8\u683c\u6709\u6548\uff0c\u56e0\u70ba\u5b83\u5c07\u73a9\u5bb6\u7684\u6ce8\u610f\u529b\u96c6\u4e2d\u5728\u6838\u5fc3\u6a5f\u5236\u548c\u6558\u4e8b\u4e0a\u3002\u6b65\u9a5f1\uff1a\u6ce8\u610f\u8996\u89ba\u7684\u7c21\u6f54\u5982\u4f55\u589e\u5f37\u6e05\u6670\u5ea6\u4e26\u6e1b\u5c11\u5e72\u64fe\u3002\u6b65\u9a5f2\uff1a\u6b23\u8cde\u85dd\u8853\u98a8\u683c\u5982\u4f55\u88dc\u5145\u904a\u6232\u7684\u9ed1\u8272\u96fb\u5f71\u4e3b\u984c\uff0c\u70ba\u5176\u589e\u6dfb\u6c1b\u570d\u3002\u6b65\u9a5f3\uff1a\u8a8d\u8b58\u5230\u6975\u7c21\u65b9\u6cd5\u5141\u8a31\u73a9\u5bb6\u66f4\u76f4\u89ba\u5730\u8207\u9762\u677f\u4e92\u52d5\u3002\u9019\u500b\u8a2d\u8a08\u9078\u64c7\u78ba\u4fdd\u73a9\u5bb6\u59cb\u7d42\u6295\u5165\u89e3\u8b0e\u548c\u8b1b\u6545\u4e8b\u7684\u5143\u7d20\u3002"}, {"question": "\u5982\u4f55\u5728 Framed \u4e2d\u512a\u5316\u904a\u6232\u8868\u73fe\u4ee5\u8ffd\u9010\u6210\u5c31\uff1f", "answer": "\u70ba\u4e86\u5728 Framed \u4e2d\u512a\u5316\u904a\u6232\u8868\u73fe\u4ee5\u8ffd\u9010\u6210\u5c31\uff0c\u73a9\u5bb6\u61c9\u8a72\uff1a\u6b65\u9a5f1\uff1a\u5c08\u6ce8\u65bc\u4ee5\u6700\u5c11\u52d5\u4f5c\u5b8c\u6210\u95dc\u5361\u3002\u6b65\u9a5f2\uff1a\u63a2\u7d22\u6240\u6709\u53ef\u80fd\u7684\u63a7\u5236\u9762\u677f\u6392\u5217\uff0c\u89e3\u9396\u96b1\u85cf\u6210\u5c31\u3002\u6b65\u9a5f3\uff1a\u91cd\u73a9\u95dc\u5361\uff0c\u4ee5\u78ba\u4fdd\u767c\u73fe\u6240\u6709\u6558\u4e8b\u5206\u652f\u3002\u4f8b\u5982\uff0c\u5728\u6709\u591a\u500b\u7d50\u5c40\u7684\u95dc\u5361\u4e2d\uff0c\u6bcf\u500b\u7d50\u5c40\u90fd\u9700\u8981\u4e0d\u540c\u7684\u7b56\u7565\u548c\u95dc\u6ce8\u7d30\u7bc0\uff0c\u589e\u5f37\u6574\u9ad4\u9ad4\u9a57\u4e26\u63d0\u9ad8\u7372\u5f97\u6210\u5c31\u7684\u6a5f\u6703\u3002"}, {"question": "\u73a9\u5bb6\u7684\u81ea\u4e3b\u6027\u5728 Framed \u7684\u6558\u4e8b\u4e2d\u626e\u6f14\u4ec0\u9ebc\u89d2\u8272\uff1f", "answer": "Framed \u4e2d\u7684\u73a9\u5bb6\u81ea\u4e3b\u6027\u5c0d\u65bc\u6558\u4e8b\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u505a\u51fa\u7684\u9078\u64c7\u6703\u76f4\u63a5\u5f71\u97ff\u6558\u4e8b\u3002\u6b65\u9a5f1\uff1a\u4e86\u89e3\u6bcf\u500b\u9762\u677f\u91cd\u65b0\u6392\u5217\u90fd\u6703\u6539\u8b8a\u6545\u4e8b\u7684\u9032\u5c55\u3002\u6b65\u9a5f2\uff1a\u8a8d\u8b58\u5230\u4e0d\u540c\u7684\u9806\u5e8f\u5982\u4f55\u5c0e\u81f4\u5404\u7a2e\u7d50\u679c\uff0c\u53cd\u6620\u73a9\u5bb6\u7684\u6c7a\u5b9a\u3002\u6b65\u9a5f3\uff1a\u6b23\u8cde\u5141\u8a31\u500b\u4eba\u5316\u6545\u4e8b\u7684\u884d\u751f\u8def\u5f91\u3002\u4f8b\u5982\uff0c\u5728\u89d2\u8272\u5fc5\u9808\u5728\u5169\u689d\u8def\u4e0a\u505a\u51fa\u9078\u64c7\u7684\u95dc\u5361\u4e2d\uff0c\u73a9\u5bb6\u7684\u9078\u64c7\u6703\u5f71\u97ff\u5f8c\u7e8c\u4e8b\u4ef6\uff0c\u4f7f\u6bcf\u4f4d\u73a9\u5bb6\u7684\u6558\u4e8b\u9ad4\u9a57\u90fd\u7368\u4e00\u7121\u4e8c\u3002"}]
[{"question": "Framed\u306e\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u57fa\u672c\u64cd\u4f5c\u3092\u7d20\u65e9\u304f\u7406\u89e3\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Framed\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u7d20\u65e9\u304f\u7406\u89e3\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u624b\u98061\uff1a\u30d1\u30cd\u30eb\u79fb\u52d5\u306e\u30bf\u30c3\u30c1\u64cd\u4f5c\u307e\u305f\u306f\u30de\u30a6\u30b9\u64cd\u4f5c\u306b\u6163\u308c\u307e\u3057\u3087\u3046\u3002\u624b\u98062\uff1a\u30d1\u30cd\u30eb\u306e\u914d\u7f6e\u3092\u7df4\u7fd2\u3057\u3066\u3001\u305d\u308c\u304c\u30b7\u30fc\u30f3\u306e\u7d50\u679c\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3059\u308b\u304b\u3092\u78ba\u304b\u3081\u307e\u3057\u3087\u3046\u3002\u624b\u98063\uff1a\u8aa4\u308a\u3092\u4fee\u6b63\u3059\u308b\u305f\u3081\u306b\u300c\u5143\u306b\u623b\u3059\u300d\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30d1\u30cd\u30eb\u3092\u5de6\u306b\u79fb\u52d5\u3059\u308b\u3053\u3068\u3067\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u7f60\u3092\u56de\u907f\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u5b9f\u8df5\u7684\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u3001\u81ea\u4fe1\u3092\u7bc9\u304d\u3001\u30b2\u30fc\u30e0\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "Framed\u3067\u30d1\u30cd\u30eb\u306e\u914d\u7f6e\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "Framed\u306b\u304a\u3051\u308b\u30bf\u30a4\u30df\u30f3\u30b0\u306f\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u305d\u308c\u306f\u3001\u51fa\u6765\u4e8b\u306e\u30b7\u30fc\u30b1\u30f3\u30b9\u306b\u76f4\u63a5\u5f71\u97ff\u3059\u308b\u304b\u3089\u3067\u3059\u3002\u624b\u98061\uff1a\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u52d5\u304d\u3068\u74b0\u5883\u3092\u89b3\u5bdf\u3057\u307e\u3059\u3002\u624b\u98062\uff1a\u7d50\u679c\u3092\u5909\u3048\u308b\u305f\u3081\u306b\u30d1\u30cd\u30eb\u3092\u6700\u9069\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u914d\u7f6e\u3057\u307e\u3059\u3002\u624b\u98063\uff1a\u3055\u307e\u3056\u307e\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u8a66\u3057\u3066\u3001\u305d\u306e\u52b9\u679c\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u8ffd\u308f\u308c\u3066\u3044\u308b\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30d1\u30cd\u30eb\u3092\u65e9\u3059\u304e\u308b\u6216\u3044\u306f\u9045\u3059\u304e\u308b\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u914d\u7f6e\u3059\u308b\u3068\u3001\u6355\u3089\u3048\u3089\u308c\u305f\u308a\u8131\u51fa\u3057\u305f\u308a\u3059\u308b\u7d50\u679c\u306b\u306a\u308a\u307e\u3059\u3002\u3053\u306e\u6226\u7565\u7684\u306a\u8981\u7d20\u306f\u3001\u30d1\u30ba\u30eb\u89e3\u6c7a\u306e\u4f53\u9a13\u306b\u5965\u884c\u304d\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002"}, {"question": "\u30e2\u30d0\u30a4\u30eb\u7248\u3068PC\u7248\u306eFramed\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30e2\u30d0\u30a4\u30eb\u7248\u3068PC\u7248\u306eFramed\u306e\u4e3b\u306a\u9055\u3044\u306b\u306f\u3001\u64cd\u4f5c\u65b9\u6cd5\u3068\u753b\u9762\u30b5\u30a4\u30ba\u304c\u3042\u308a\u307e\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u7248\u3067\u306f\u3001\u30bf\u30c3\u30c1\u64cd\u4f5c\u306b\u3088\u308a\u76f4\u611f\u7684\u306a\u30d1\u30cd\u30eb\u64cd\u4f5c\u304c\u53ef\u80fd\u3067\u3059\u3002\u4e00\u65b9\u3001PC\u7248\u3067\u306f\u3001\u30de\u30a6\u30b9\u64cd\u4f5c\u306b\u3088\u308a\u7cbe\u5ea6\u9ad8\u304f\u64cd\u4f5c\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u3001PC\u7248\u306e\u5927\u753b\u9762\u306f\u3001\u3088\u308a\u6ca1\u5165\u578b\u306e\u8996\u899a\u4f53\u9a13\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u3057\u304b\u3057\u306a\u304c\u3089\u3001\u4e21\u65b9\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u306f\u3001\u540c\u3058\u57fa\u672c\u7684\u306a\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u3068\u7269\u8a9e\u3092\u7dad\u6301\u3057\u3066\u304a\u308a\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u554f\u308f\u305a\u4e00\u8cab\u3057\u305f\u4f53\u9a13\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002"}, {"question": "Framed\u306e\u8907\u96d1\u306a\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u305f\u3081\u306b\u5f79\u7acb\u3064\u9ad8\u5ea6\u306a\u6226\u7565\u306f\uff1f", "answer": "Framed\u306e\u8907\u96d1\u306a\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u305f\u3081\u306e\u9ad8\u5ea6\u306a\u6226\u7565\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u3082\u306e\u304c\u3042\u308a\u307e\u3059\u3002\u624b\u98061\uff1a\u79fb\u52d5\u3059\u308b\u524d\u306b\u3001\u51fa\u6765\u4e8b\u5168\u4f53\u306e\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u5206\u6790\u3057\u307e\u3059\u3002\u624b\u98062\uff1a\u5404\u30d1\u30cd\u30eb\u306e\u914d\u7f6e\u306b\u5bfe\u3057\u3066\u3001\u8907\u6570\u306e\u6f5c\u5728\u7684\u306a\u7d50\u679c\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002\u624b\u98063\uff1a\u8a66\u884c\u932f\u8aa4\u3092\u4f7f\u7528\u3057\u3066\u3001\u3055\u307e\u3056\u307e\u306a\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u30c6\u30b9\u30c8\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u8907\u6570\u306e\u7f60\u304c\u3042\u308b\u30ec\u30d9\u30eb\u3067\u306f\u3001\u5b89\u5168\u306a\u901a\u8def\u3092\u4f5c\u6210\u3059\u308b\u305f\u3081\u306b\u30d1\u30cd\u30eb\u3092\u914d\u7f6e\u3059\u308b\u969b\u306b\u306f\u3001\u614e\u91cd\u306a\u8a08\u753b\u3068\u5b9f\u884c\u304c\u5fc5\u8981\u3067\u3059\u3002\u3053\u306e\u65b9\u6cd5\u8ad6\u7684\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u554f\u984c\u89e3\u6c7a\u30b9\u30ad\u30eb\u3092\u9ad8\u3081\u3001\u6210\u529f\u306e\u53ef\u80fd\u6027\u3092\u9ad8\u3081\u307e\u3059\u3002"}, {"question": "\u7269\u8a9e\u306fFramed\u306e\u30d1\u30ba\u30eb\u30c7\u30b6\u30a4\u30f3\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "Framed\u306e\u7269\u8a9e\u306f\u3001\u30d1\u30ba\u30eb\u30c7\u30b6\u30a4\u30f3\u3068\u5bc6\u63a5\u306b\u7d71\u5408\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u5404\u30ec\u30d9\u30eb\u306f\u3001\u30b9\u30c8\u30fc\u30ea\u30fc\u306e\u4e00\u90e8\u3092\u53cd\u6620\u3057\u3066\u3044\u307e\u3059\u3002\u624b\u98061\uff1a\u5404\u30b7\u30fc\u30f3\u306b\u63d0\u4f9b\u3055\u308c\u3066\u3044\u308b\u8996\u899a\u7684\u306a\u624b\u304c\u304b\u308a\u3068\u30b3\u30f3\u30c6\u30ad\u30b9\u30c8\u306b\u6ce8\u610f\u3092\u6255\u3044\u307e\u3059\u3002\u624b\u98062\uff1a\u7269\u8a9e\u3092\u4f7f\u7528\u3057\u3066\u3001\u6f5c\u5728\u7684\u306a\u7d50\u679c\u3068\u969c\u5bb3\u3092\u4e88\u6e2c\u3057\u307e\u3059\u3002\u624b\u98063\uff1a\u30d1\u30ba\u30eb\u89e3\u6c7a\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u3092\u30b9\u30c8\u30fc\u30ea\u30fc\u306e\u9032\u884c\u306b\u5408\u308f\u305b\u3066\u8abf\u6574\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u8131\u51fa\u3057\u3088\u3046\u3068\u3057\u3066\u3044\u308b\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30d1\u30ba\u30eb\u306f\u7269\u8a9e\u306e\u7dca\u8feb\u611f\u3068\u7dca\u5f35\u611f\u3092\u6a21\u5023\u3059\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u307e\u3068\u307e\u308a\u306e\u3042\u308b\u9b45\u529b\u7684\u306a\u4f53\u9a13\u304c\u751f\u307e\u308c\u307e\u3059\u3002"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306fFramed\u3067\u3069\u306e\u3088\u3046\u306a\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30d1\u30ba\u30eb\u306e\u4ee3\u66ff\u30bd\u30ea\u30e5\u30fc\u30b7\u30e7\u30f3\u3092\u63a2\u6c42\u3059\u308b\u3053\u3068\u3067\u3001Framed\u3067\u96a0\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u3002\u624b\u98061\uff1a\u7570\u306a\u308b\u7d50\u679c\u306b\u3064\u306a\u304c\u308b\u3001\u3042\u307e\u308a\u660e\u3089\u304b\u3067\u306f\u306a\u3044\u30d1\u30cd\u30eb\u914d\u7f6e\u3092\u63a2\u3057\u307e\u3059\u3002\u624b\u98062\uff1a\u975e\u5f93\u6765\u306e\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u8a66\u3057\u3066\u3001\u79d8\u5bc6\u306e\u30b7\u30fc\u30f3\u3084\u30a8\u30f3\u30c7\u30a3\u30f3\u30b0\u3092\u767a\u898b\u3057\u307e\u3059\u3002\u624b\u98063\uff1a\u6700\u521d\u306b\u767a\u898b\u3055\u308c\u306a\u304b\u3063\u305f\u96a0\u308c\u305f\u8a73\u7d30\u3092\u898b\u3064\u3051\u308b\u305f\u3081\u306b\u3001\u30ec\u30d9\u30eb\u3092\u3084\u308a\u76f4\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5f8c\u7d9a\u306e\u30ec\u30d9\u30eb\u3067\u30d1\u30cd\u30eb\u3092\u7279\u5b9a\u306e\u9806\u5e8f\u3067\u914d\u7f6e\u3059\u308b\u3068\u3001\u96a0\u3055\u308c\u305f\u30b5\u30d6\u30d7\u30ed\u30c3\u30c8\u304c\u73fe\u308c\u3001\u30b9\u30c8\u30fc\u30ea\u30fc\u306b\u5965\u884c\u304d\u304c\u52a0\u308f\u308a\u3001\u597d\u5947\u5fc3\u65fa\u76db\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u8912\u3081\u3066\u304f\u308c\u307e\u3059\u3002"}, {"question": "\u30b2\u30fc\u30e0\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001Framed\u3067\u5275\u9020\u7684\u306a\u554f\u984c\u89e3\u6c7a\u3092\u3069\u306e\u3088\u3046\u306b\u4fc3\u3057\u307e\u3059\u304b\uff1f", "answer": "Framed\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u5404\u30d1\u30ba\u30eb\u306b\u8907\u6570\u306e\u89e3\u304c\u5b58\u5728\u3059\u308b\u305f\u3081\u3001\u5275\u9020\u7684\u306a\u554f\u984c\u89e3\u6c7a\u3092\u4fc3\u9032\u3057\u307e\u3059\u3002\u624b\u98061\uff1a\u30d1\u30cd\u30eb\u306e\u914d\u7f6e\u3092\u3044\u308d\u3044\u308d\u8a66\u3057\u3066\u3001\u305d\u306e\u7d50\u679c\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3059\u308b\u304b\u3092\u898b\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u624b\u98062\uff1a\u975e\u5f93\u6765\u306e\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u691c\u8a0e\u3059\u308b\u3053\u3068\u3067\u3001\u67a0\u306b\u3068\u3089\u308f\u308c\u305a\u8003\u3048\u307e\u3057\u3087\u3046\u3002\u624b\u98063\uff1a\u300c\u5143\u306b\u623b\u3059\u300d\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u3001\u30da\u30ca\u30eb\u30c6\u30a3\u306a\u3057\u3067\u5b9f\u9a13\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u8ff7\u8def\u3092\u30ca\u30d3\u30b2\u30fc\u30c8\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u540c\u3058\u76ee\u6a19\u306b\u305f\u3069\u308a\u7740\u304f\u72ec\u81ea\u306e\u7d4c\u8def\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u3001\u5275\u9020\u6027\u3068\u6226\u7565\u7684\u306a\u601d\u8003\u3092\u4fc3\u9032\u3057\u307e\u3059\u3002"}, {"question": "\u30df\u30cb\u30de\u30ea\u30b9\u30c8\u306e\u7f8e\u8853\u30b9\u30bf\u30a4\u30eb\u306fFramed\u3067\u52b9\u679c\u7684\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "Framed\u306e\u30df\u30cb\u30de\u30ea\u30b9\u30c8\u306e\u7f8e\u8853\u30b9\u30bf\u30a4\u30eb\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u6ce8\u610f\u3092\u57fa\u672c\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3068\u7269\u8a9e\u306b\u96c6\u4e2d\u3055\u305b\u308b\u305f\u3081\u52b9\u679c\u7684\u3067\u3059\u3002\u624b\u98061\uff1a\u8996\u899a\u7684\u306a\u30b7\u30f3\u30d7\u30eb\u3055\u304c\u3001\u660e\u78ba\u3055\u3092\u9ad8\u3081\u3001\u6c17\u3092\u6563\u3089\u3059\u8981\u7d20\u3092\u6e1b\u3089\u3059\u69d8\u5b50\u306b\u6c17\u3065\u304d\u307e\u3057\u3087\u3046\u3002\u624b\u98062\uff1a\u3053\u306e\u7f8e\u8853\u30b9\u30bf\u30a4\u30eb\u304c\u30b2\u30fc\u30e0\u306e\u30ce\u30ef\u30fc\u30eb\u30c6\u30fc\u30de\u3092\u88dc\u5b8c\u3057\u3001\u96f0\u56f2\u6c17\u3092\u9ad8\u3081\u308b\u69d8\u5b50\u3092\u8a55\u4fa1\u3057\u307e\u3057\u3087\u3046\u3002\u624b\u98063\uff1a\u30df\u30cb\u30de\u30ea\u30b9\u30c8\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u306b\u3088\u308a\u3001\u30d1\u30cd\u30eb\u3068\u306e\u3088\u308a\u76f4\u611f\u7684\u306a\u3084\u308a\u53d6\u308a\u304c\u53ef\u80fd\u306b\u306a\u308b\u3053\u3068\u306b\u6c17\u3065\u304d\u307e\u3057\u3087\u3046\u3002\u3053\u306e\u30c7\u30b6\u30a4\u30f3\u306e\u9078\u629e\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30d1\u30ba\u30eb\u89e3\u6c7a\u3068\u7269\u8a9e\u8981\u7d20\u306b\u7d99\u7d9a\u7684\u306b\u6ca1\u982d\u3067\u304d\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001Framed\u3067\u9054\u6210\u56f0\u96e3\u3092\u9054\u6210\u3059\u308b\u305f\u3081\u306b\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Framed\u3067\u9054\u6210\u56f0\u96e3\u3092\u9054\u6210\u3059\u308b\u305f\u3081\u306b\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u6b21\u306e\u624b\u9806\u306b\u5f93\u3046\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u624b\u98061\uff1a\u53ef\u80fd\u306a\u9650\u308a\u5c11\u306a\u3044\u52d5\u304d\u3067\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u307e\u3059\u3002\u624b\u98062\uff1a\u3059\u3079\u3066\u306e\u53ef\u80fd\u306a\u30d1\u30cd\u30eb\u914d\u7f6e\u3092\u63a2\u6c42\u3057\u3066\u3001\u96a0\u3055\u308c\u305f\u9054\u6210\u3092\u89e3\u9664\u3057\u307e\u3059\u3002\u624b\u98063\uff1a\u3059\u3079\u3066\u306e\u7269\u8a9e\u306e\u679d\u3092\u63a2\u7d22\u3057\u3001\u30ec\u30d9\u30eb\u3092\u3084\u308a\u76f4\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u8907\u6570\u306e\u30a8\u30f3\u30c7\u30a3\u30f3\u30b0\u306e\u3042\u308b\u30ec\u30d9\u30eb\u3067\u306f\u3001\u305d\u308c\u305e\u308c\u3092\u9054\u6210\u3059\u308b\u306b\u306f\u3001\u7570\u306a\u308b\u6226\u7565\u3068\u7d30\u90e8\u306b\u6ce8\u610f\u3092\u6255\u3046\u5fc5\u8981\u304c\u3042\u308b\u305f\u3081\u3001\u5168\u4f53\u7684\u306a\u7d4c\u9a13\u3092\u5411\u4e0a\u3055\u305b\u3001\u9054\u6210\u3092\u9054\u6210\u3059\u308b\u53ef\u80fd\u6027\u3092\u9ad8\u3081\u307e\u3059\u3002"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u4e3b\u4f53\u6027\u306f\u3001Framed\u306e\u7269\u8a9e\u306b\u3069\u306e\u3088\u3046\u306a\u5f79\u5272\u3092\u679c\u305f\u3057\u307e\u3059\u304b\uff1f", "answer": "Framed\u306b\u304a\u3051\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u4e3b\u4f53\u6027\u306f\u3001\u7269\u8a9e\u306e\u4e2d\u5fc3\u7684\u306a\u8981\u7d20\u3067\u3059\u3002\u305d\u308c\u305e\u308c\u306e\u9078\u629e\u304c\u7269\u8a9e\u306e\u5c55\u958b\u306b\u76f4\u63a5\u5f71\u97ff\u3059\u308b\u304b\u3089\u3067\u3059\u3002\u624b\u98061\uff1a\u5404\u30d1\u30cd\u30eb\u306e\u914d\u7f6e\u304c\u30b9\u30c8\u30fc\u30ea\u30fc\u306e\u9032\u884c\u3092\u5909\u5316\u3055\u305b\u308b\u3053\u3068\u3092\u7406\u89e3\u3057\u307e\u3059\u3002\u624b\u98062\uff1a\u7570\u306a\u308b\u30b7\u30fc\u30b1\u30f3\u30b9\u304c\u3055\u307e\u3056\u307e\u306a\u7d50\u679c\u306b\u3064\u306a\u304c\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u6c7a\u5b9a\u3092\u53cd\u6620\u3059\u308b\u3053\u3068\u3092\u8a8d\u8b58\u3057\u307e\u3057\u3087\u3046\u3002\u624b\u98063\uff1a\u30d1\u30fc\u30bd\u30ca\u30e9\u30a4\u30ba\u3055\u308c\u305f\u7269\u8a9e\u306e\u53ef\u80fd\u6027\u306e\u3042\u308b\u5206\u5c90\u30d1\u30b9\u3092\u8a55\u4fa1\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c2\u3064\u306e\u9053\u306e\u3069\u3061\u3089\u304b\u3092\u9078\u629e\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u9078\u629e\u304c\u5f8c\u306e\u51fa\u6765\u4e8b\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u305f\u3081\u3001\u5404\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u7269\u8a9e\u4f53\u9a13\u306f\u72ec\u7279\u306b\u306a\u308a\u307e\u3059\u3002"}]
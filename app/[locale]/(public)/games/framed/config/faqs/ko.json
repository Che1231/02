[{"question": "\uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 Framed\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \uc774\ud574\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Framed\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \uc774\ud574\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc2ed\uc2dc\uc624. 1\ub2e8\uacc4: \ud328\ub110 \uc774\ub3d9\uc744 \uc704\ud55c \ud130\uce58 \ub610\ub294 \ub9c8\uc6b0\uc2a4 \ucee8\ud2b8\ub864\uc5d0 \uc775\uc219\ud574\uc9c0\uc2ed\uc2dc\uc624. 2\ub2e8\uacc4: \ud328\ub110\uc744 \uc7ac\ubc30\uc5f4\ud558\uc5ec \uc7a5\uba74 \uacb0\uacfc\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc744 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. 3\ub2e8\uacc4: \uc2e4\uc218\ub97c \uc218\uc815\ud558\uae30 \uc704\ud574 '\ub418\ub3cc\ub9ac\uae30' \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c \ud328\ub110\uc744 \uc67c\ucabd\uc73c\ub85c \uc774\ub3d9\ud558\uba74 \uce90\ub9ad\ud130\uac00 \ud568\uc815\uc744 \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc2e4\uc2b5 \ubc29\uc2dd\uc740 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc5d0 \ub300\ud55c \uc790\uc2e0\uac10\uacfc \uc774\ud574\ub97c \uc313\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "Framed\uc5d0\uc11c \ud328\ub110 \uc7ac\ubc30\uc5f4\uc758 \ud0c0\uc774\ubc0d\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Framed\uc5d0\uc11c \ud0c0\uc774\ubc0d\uc740 \uc0ac\uac74\uc758 \uc21c\uc11c\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\ubbc0\ub85c \uc911\uc694\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \uce90\ub9ad\ud130\uc758 \uc774\ub3d9\uacfc \ud658\uacbd\uc744 \uad00\ucc30\ud558\uc2ed\uc2dc\uc624. 2\ub2e8\uacc4: \uacb0\uacfc\ub97c \ubcc0\uacbd\ud558\uae30 \uc704\ud574 \ud328\ub110\uc744 \uc7ac\ubc30\uc5f4\ud560 \ucd5c\uc801\uc758 \uc21c\uac04\uc744 \ud30c\uc545\ud558\uc2ed\uc2dc\uc624. 3\ub2e8\uacc4: \ub2e4\uc591\ud55c \ud0c0\uc774\ubc0d\uc744 \uc2dc\ud5d8\ud558\uc5ec \uadf8 \ud6a8\uacfc\ub97c \uc0b4\ud3b4\ubcf4\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uce90\ub9ad\ud130\uac00 \ucd94\uaca9\ubc1b\ub294 \ub808\ubca8\uc5d0\uc11c \ud328\ub110\uc744 \ub108\ubb34 \uc77c\ucc0d \ub610\ub294 \ub108\ubb34 \ub2a6\uac8c \uc7ac\ubc30\uc5f4\ud558\uba74 \ud3ec\ucc29 \ub610\ub294 \ud0c8\ucd9c\uc774\ub77c\ub294 \uacb0\uacfc\ub97c \ucd08\ub798\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc804\ub7b5\uc801\uc778 \uc694\uc18c\ub294 \ud37c\uc990 \ud480\uc774 \uacbd\ud5d8\uc5d0 \uae4a\uc774\ub97c \ub354\ud569\ub2c8\ub2e4."}, {"question": "\ubaa8\ubc14\uc77c \ubc0f PC \ubc84\uc804\uc758 Framed \uac04\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubaa8\ubc14\uc77c \ubc0f PC \ubc84\uc804\uc758 Framed \uac04\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ucee8\ud2b8\ub864 \ubc29\uc2dd\uacfc \ud654\uba74 \ud06c\uae30\uc785\ub2c8\ub2e4. \ubaa8\ubc14\uc77c\uc5d0\uc11c\ub294 \ud130\uce58 \ucee8\ud2b8\ub864\uc744 \ud1b5\ud574 \uc9c1\uad00\uc801\uc778 \ud328\ub110 \uc870\uc791\uc774 \uac00\ub2a5\ud558\uace0, PC\uc5d0\uc11c\ub294 \ub9c8\uc6b0\uc2a4 \ucee8\ud2b8\ub864\uc774 \uc815\ubc00\ub3c4\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub610\ud55c PC\uc758 \ub354 \ud070 \ud654\uba74\uc740 \ubcf4\ub2e4 \ubab0\uc785\uc801\uc778 \uc2dc\uac01\uc801 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \ub450 \ubc84\uc804 \ubaa8\ub450 \ub3d9\uc77c\ud55c \ud575\uc2ec \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uacfc \uc2a4\ud1a0\ub9ac\ud154\ub9c1\uc744 \uc720\uc9c0\ud558\uc5ec \ud50c\ub7ab\ud3fc \uac04 \uc77c\uad00\ub41c \uacbd\ud5d8\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "Framed\uc5d0\uc11c \ubcf5\uc7a1\ud55c \ud37c\uc990\uc744 \ud574\uacb0\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ub294 \uace0\uae09 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Framed\uc5d0\uc11c \ubcf5\uc7a1\ud55c \ud37c\uc990\uc744 \ud574\uacb0\ud558\uae30 \uc704\ud55c \uace0\uae09 \uc804\ub7b5\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. 1\ub2e8\uacc4: \uc5b4\ub5a4 \uc870\uce58\ub97c \ucde8\ud558\uae30 \uc804\uc5d0 \uc804\uccb4 \uc0ac\uac74 \uc21c\uc11c\ub97c \ubd84\uc11d\ud558\uc2ed\uc2dc\uc624. 2\ub2e8\uacc4: \uac01 \ud328\ub110 \uc7ac\ubc30\uc5f4\uc5d0 \ub300\ud55c \uc5ec\ub7ec \uac00\uc9c0 \uc7a0\uc7ac\uc801\uc778 \uacb0\uacfc\ub97c \ud30c\uc545\ud558\uc2ed\uc2dc\uc624. 3\ub2e8\uacc4: \uc2dc\ud589\ucc29\uc624\ub97c \ud1b5\ud574 \ub2e4\uc591\ud55c \uc21c\uc11c\ub97c \ud14c\uc2a4\ud2b8\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc5ec\ub7ec \ud568\uc815\uc774 \uc788\ub294 \ub808\ubca8\uc5d0\uc11c \uc548\uc804\ud55c \uacbd\ub85c\ub97c \ub9cc\ub4e4\uae30 \uc704\ud574 \ud328\ub110\uc744 \uc7ac\ubc30\uc5f4\ud558\ub294 \ub370\ub294 \uc2e0\uc911\ud55c \uacc4\ud68d\uacfc \uc2e4\ud589\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uccb4\uacc4\uc801\uc778 \uc811\uadfc \ubc29\uc2dd\uc740 \ubb38\uc81c \ud574\uacb0 \ub2a5\ub825\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uace0 \uc131\uacf5 \uac00\ub2a5\uc131\uc744 \ub192\uc785\ub2c8\ub2e4."}, {"question": "Framed\uc758 \uc2a4\ud1a0\ub9ac\uac00 \ud37c\uc990 \ub514\uc790\uc778\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Framed\uc758 \uc2a4\ud1a0\ub9ac\ub294 \ud37c\uc990 \ub514\uc790\uc778\uacfc \uae34\ubc00\ud558\uac8c \ud1b5\ud569\ub418\uc5b4 \uc788\uc73c\uba70, \uac01 \ub808\ubca8\uc740 \uc2a4\ud1a0\ub9ac\uc758 \uc77c\ubd80\ub97c \ubc18\uc601\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \uac01 \uc7a5\uba74\uc5d0 \uc81c\uacf5\ub41c \uc2dc\uac01\uc801 \ub2e8\uc11c\uc640 \ub9e5\ub77d\uc5d0 \uc8fc\uc758\ud558\uc2ed\uc2dc\uc624. 2\ub2e8\uacc4: \uc2a4\ud1a0\ub9ac\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc7a0\uc7ac\uc801\uc778 \uacb0\uacfc\uc640 \uc7a5\uc560\ubb3c\uc744 \uc608\uc0c1\ud558\uc2ed\uc2dc\uc624. 3\ub2e8\uacc4: \uc2a4\ud1a0\ub9ac\uc758 \uc9c4\ud589\uacfc \uc77c\uce58\ud558\ub294 \ud37c\uc990 \ud480\uc774 \uc811\uadfc \ubc29\uc2dd\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uce90\ub9ad\ud130\uac00 \ud0c8\ucd9c\ud558\ub824\uace0 \ud558\ub294 \ub808\ubca8\uc5d0\uc11c\ub294 \ud37c\uc990\uc774 \uc2a4\ud1a0\ub9ac\uc758 \uae34\ubc15\ud568\uacfc \uae34\uc7a5\uac10\uc744 \ubaa8\ubc29\ud558\uc5ec \uc720\uae30\uc801\uc774\uace0 \ub9e4\ub825\uc801\uc778 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 Framed\uc5d0\uc11c \uc5b4\ub5a4 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud50c\ub808\uc774\uc5b4\ub294 Framed\uc5d0\uc11c \ud37c\uc990\uc758 \ub300\uc548\uc801\uc778 \ud574\uacb0\ucc45\uc744 \ud0d0\uc0c9\ud558\uc5ec \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 1\ub2e8\uacc4: \ub2e4\ub978 \uacb0\uacfc\ub85c \uc774\uc5b4\uc9c0\ub294 \ub35c \uba85\ud655\ud55c \ud328\ub110 \ubc30\uc5f4\uc744 \ucc3e\uc73c\uc2ed\uc2dc\uc624. 2\ub2e8\uacc4: \ube44\ud45c\uc900\uc801\uc778 \uc21c\uc11c\ub97c \uc2e4\ud5d8\ud558\uc5ec \ube44\ubc00 \uc7a5\uba74\uc774\ub098 \uc5d4\ub529\uc744 \ucc3e\uc73c\uc2ed\uc2dc\uc624. 3\ub2e8\uacc4: \ucc98\uc74c\uc5d0 \ub193\uce5c \uc228\uaca8\uc9c4 \uc138\ubd80 \uc0ac\ud56d\uc744 \ucc3e\uae30 \uc704\ud574 \ub808\ubca8\uc744 \ub2e4\uc2dc \ud50c\ub808\uc774\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ub098\uc911 \ub808\ubca8\uc758 \ud2b9\uc815 \uc21c\uc11c\ub85c \ud328\ub110\uc744 \uc7ac\ubc30\uc5f4\ud558\uba74 \uc228\uaca8\uc9c4 \ubd80\ubd84 \uc774\uc57c\uae30\ub97c \ub4dc\ub7ec\ub0bc \uc218 \uc788\uc73c\uba70, \uc774\ub294 \ub354 \uae4a\uc740 \uc2a4\ud1a0\ub9ac\uc640 \ud638\uae30\uc2ec \ub9ce\uc740 \ud50c\ub808\uc774\uc5b4\ub97c \ubcf4\uc0c1\ud569\ub2c8\ub2e4."}, {"question": "\uac8c\uc784\uc758 \uba54\ucee4\ub2c8\uc998\uc740 Framed\uc5d0\uc11c \ucc3d\uc758\uc801\uc778 \ubb38\uc81c \ud574\uacb0\uc744 \uc5b4\ub5bb\uac8c \uc7a5\ub824\ud569\ub2c8\uae4c?", "answer": "Framed\uc758 \uba54\ucee4\ub2c8\uc998\uc740 \uac01 \ud37c\uc990\uc5d0 \uc5ec\ub7ec \uac00\uc9c0 \ud574\uacb0\ucc45\uc744 \ud5c8\uc6a9\ud558\uc5ec \ucc3d\uc758\uc801\uc778 \ubb38\uc81c \ud574\uacb0\uc744 \uc7a5\ub824\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \ub2e4\uc591\ud55c \ud328\ub110 \ubc30\uc5f4\uc744 \ud0d0\uc0c9\ud558\uc5ec \uacb0\uacfc\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc744 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. 2\ub2e8\uacc4: \ube44\ud45c\uc900\uc801\uc778 \uc21c\uc11c\ub97c \uace0\ub824\ud558\uc5ec \ud2c0\uc744 \ubc97\uc5b4\ub09c \uc0ac\uace0\ub97c \ud558\uc2ed\uc2dc\uc624. 3\ub2e8\uacc4: \ud398\ub110\ud2f0 \uc5c6\uc774 \uc2e4\ud5d8\ud558\uae30 \uc704\ud574 '\ub418\ub3cc\ub9ac\uae30' \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uce90\ub9ad\ud130\uac00 \ubbf8\ub85c\ub97c \ud0d0\uc0c9\ud574\uc57c \ud558\ub294 \ub808\ubca8\uc5d0\uc11c\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \ub3d9\uc77c\ud55c \ubaa9\uc801\uc9c0\ub85c \uc774\uc5b4\uc9c0\ub294 \ub3c5\ud2b9\ud55c \uacbd\ub85c\ub97c \ucc3e\uc744 \uc218 \uc788\uc73c\uba70, \uc774\ub294 \ucc3d\uc758\uc131\uacfc \uc804\ub7b5\uc801 \uc0ac\uace0\ub97c \ucd09\uc9c4\ud569\ub2c8\ub2e4."}, {"question": "\ubbf8\ub2c8\uba40\ub9ac\uc998 \uc608\uc220 \uc2a4\ud0c0\uc77c\uc774 Framed\uc5d0\uc11c \ud6a8\uacfc\uc801\uc778 \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Framed\uc758 \ubbf8\ub2c8\uba40\ub9ac\uc998 \uc608\uc220 \uc2a4\ud0c0\uc77c\uc740 \ud50c\ub808\uc774\uc5b4\uc758 \uad00\uc2ec\uc744 \ud575\uc2ec \uba54\ucee4\ub2c8\uc998\uacfc \uc2a4\ud1a0\ub9ac\ud154\ub9c1\uc5d0 \uc9d1\uc911\uc2dc\ud0a4\uae30 \ub54c\ubb38\uc5d0 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. 1\ub2e8\uacc4: \uc2dc\uac01\uc758 \ub2e8\uc21c\ud568\uc774 \uba85\ud655\uc131\uc744 \ub192\uc774\uace0 \uc0b0\ub9cc\ud568\uc744 \uc904\uc774\ub294 \ubc29\uc2dd\uc5d0 \uc720\uc758\ud558\uc2ed\uc2dc\uc624. 2\ub2e8\uacc4: \uc608\uc220 \uc2a4\ud0c0\uc77c\uc774 \uac8c\uc784\uc758 \ubc94\uc8c4 \uc601\ud654 \ud14c\ub9c8\uc640 \ubcf4\uc870\ud558\uc5ec \ubd84\uc704\uae30\ub97c \ub354\ud558\ub294 \ubc29\uc2dd\uc744 \ub192\uc774 \ud3c9\uac00\ud558\uc2ed\uc2dc\uc624. 3\ub2e8\uacc4: \ubbf8\ub2c8\uba40\ub9ac\uc998 \uc811\uadfc \ubc29\uc2dd\uc774 \ud328\ub110\uacfc \ub354\uc6b1 \uc9c1\uad00\uc801\uc778 \uc0c1\ud638 \uc791\uc6a9\uc744 \uac00\ub2a5\ud558\uac8c \ud55c\ub2e4\ub294 \uac83\uc744 \uc778\uc2dd\ud558\uc2ed\uc2dc\uc624. \uc774\ub7ec\ud55c \ub514\uc790\uc778 \uc120\ud0dd\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \ud37c\uc990 \ud480\uc774\uc640 \uc2a4\ud1a0\ub9ac\ud154\ub9c1 \uc694\uc18c\uc5d0 \uacc4\uc18d \ucc38\uc5ec\ud558\ub3c4\ub85d \ud569\ub2c8\ub2e4."}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 \uc131\uacfc \ud68d\ub4dd\uc744 \uc704\ud574 Framed\uc5d0\uc11c \uc131\ub2a5\uc744 \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Framed\uc5d0\uc11c \uc131\uacfc \ud68d\ub4dd\uc744 \uc704\ud574 \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \ud50c\ub808\uc774\uc5b4\ub294 \ub2e4\uc74c\uc744 \uc218\ud589\ud574\uc57c \ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \uac00\ub2a5\ud55c \ud55c \uc801\uc740 \uc6c0\uc9c1\uc784\uc73c\ub85c \ub808\ubca8\uc744 \uc644\ub8cc\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. 2\ub2e8\uacc4: \ubaa8\ub4e0 \uac00\ub2a5\ud55c \ud328\ub110 \ubc30\uc5f4\uc744 \ud0d0\uc0c9\ud558\uc5ec \uc228\uaca8\uc9c4 \uc131\uacfc\ub97c \ud574\uc81c\ud558\uc2ed\uc2dc\uc624. 3\ub2e8\uacc4: \ubaa8\ub4e0 \uc2a4\ud1a0\ub9ac \ubd84\uae30\ub97c \ubc1c\uacac\ud588\ub294\uc9c0 \ud655\uc778\ud558\uae30 \uc704\ud574 \ub808\ubca8\uc744 \ub2e4\uc2dc \ud50c\ub808\uc774\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc5ec\ub7ec \uc5d4\ub529\uc774 \uc788\ub294 \ub808\ubca8\uc5d0\uc11c \uac01 \uc5d4\ub529\uc744 \ub2ec\uc131\ud558\ub824\uba74 \ub2e4\ub978 \uc804\ub7b5\uacfc \uc138\ubd80 \uc0ac\ud56d\uc5d0 \ub300\ud55c \uc8fc\uc758\uac00 \ud544\uc694\ud558\uba70, \uc774\ub294 \uc804\uccb4\uc801\uc778 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uace0 \uc131\uacfc\ub97c \uc5bb\uc744 \uac00\ub2a5\uc131\uc744 \ub192\uc785\ub2c8\ub2e4."}, {"question": "\ud50c\ub808\uc774\uc5b4 \uc5d0\uc774\uc804\uc2dc\uac00 Framed\uc758 \uc2a4\ud1a0\ub9ac\ud154\ub9c1\uc5d0\uc11c \uc5b4\ub5a4 \uc5ed\ud560\uc744 \ud569\ub2c8\uae4c?", "answer": "Framed\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4 \uc5d0\uc774\uc804\uc2dc\ub294 \uc2a4\ud1a0\ub9ac\ud154\ub9c1\uc5d0 \uc911\uc2ec\uc801\uc778 \uc5ed\ud560\uc744 \ud558\uba70, \uc120\ud0dd\ud55c \uacb0\uc815\uc740 \uc2a4\ud1a0\ub9ac\uc758 \uc9c4\ud589\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. 1\ub2e8\uacc4: \uac01 \ud328\ub110 \uc7ac\ubc30\uc5f4\uc774 \uc2a4\ud1a0\ub9ac \uc9c4\ud589\uc744 \ubcc0\uacbd\ud55c\ub2e4\ub294 \uac83\uc744 \uc774\ud574\ud558\uc2ed\uc2dc\uc624. 2\ub2e8\uacc4: \ub2e4\ub978 \uc21c\uc11c\uac00 \ub2e4\uc591\ud55c \uacb0\uacfc\ub97c \ucd08\ub798\ud558\uace0 \ud50c\ub808\uc774\uc5b4\uc758 \uacb0\uc815\uc744 \ubc18\uc601\ud558\ub294 \ubc29\uc2dd\uc744 \uc778\uc2dd\ud558\uc2ed\uc2dc\uc624. 3\ub2e8\uacc4: \uac1c\uc778\ud654\ub41c \uc2a4\ud1a0\ub9ac\ud154\ub9c1\uc744 \ud5c8\uc6a9\ud558\ub294 \uac00\uc9c0 \uae38\uc744 \ub192\uc774 \ud3c9\uac00\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uce90\ub9ad\ud130\uac00 \ub450 \uac00\uc9c0 \uacbd\ub85c \uc911 \ud558\ub098\ub97c \uc120\ud0dd\ud574\uc57c \ud558\ub294 \ub808\ubca8\uc5d0\uc11c\ub294 \ud50c\ub808\uc774\uc5b4\uc758 \uc120\ud0dd\uc774 \ud6c4\uc18d \uc774\ubca4\ud2b8\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uccd0 \uac01 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uace0\uc720\ud55c \uc2a4\ud1a0\ub9ac \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}]
[{"question": "Curve Ball 3D \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ucd08\ubcf4\uc790\uac00 \uc5b4\ub5bb\uac8c \uc219\ub2ec\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Curve Ball 3D \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc219\ub2ec\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. 1\ub2e8\uacc4: \ud328\ub4e4\uc744 \uc81c\uc5b4\ud558\ub294 \uc2a4\uc640\uc774\ud504 \uc81c\uc2a4\ucc98\uc5d0 \uc775\uc219\ud574\uc9c0\uc138\uc694. 2\ub2e8\uacc4: \uacf5\uc744 \uc815\ud655\ud558\uac8c \uce58\uae30 \uc704\ud574 \uc2a4\uc640\uc774\ud504 \ud0c0\uc774\ubc0d \uc5f0\uc2b5\uc744 \ud558\uc138\uc694. 3\ub2e8\uacc4: \ubcbd\uc744 \ud65c\uc6a9\ud558\uc5ec \uc0f7\uc758 \uac01\ub3c4\ub97c \uc870\uc808\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4 \ub808\ubca8 3\uc5d0\uc11c \uc67c\ucabd \ubcbd\uc744 \uc774\uc6a9\ud558\uc5ec \uacf5\uc744 \uc0c1\ub300\ud3b8 \uace8\ub300\uc5d0 \ubc18\uc0ac\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud328\ub4e4\uc744 \ud14c\ub2c8\uc2a4 \ub77c\ucf13, \uacf5\uc744 \ud14c\ub2c8\uc2a4 \uacf5\uc73c\ub85c \uc0dd\uac01\ud558\uba74, \uc644\ubcbd\ud55c \uc2a4\uc719 \ud0c0\uc774\ubc0d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.]"}, {"question": "Curve Ball 3D\uc5d0\uc11c \ubb3c\ub9ac \uc6d0\ub9ac\ub97c \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Curve Ball 3D\uc5d0\uc11c \ubb3c\ub9ac \uc6d0\ub9ac\ub97c \uc774\ud574\ud558\ub294 \uac83\uc740 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \ubb3c\ub9ac \uc6d0\ub9ac\ub97c \uc774\ud574\ud558\uba74 \uacf5\uc758 \uada4\uc801\uc744 \uc608\uce21\ud560 \uc218 \uc788\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc774 \uac8c\uc784\uc740 \ud604\uc2e4\uc801\uc778 \ubb3c\ub9ac \uc5d4\uc9c4\uc744 \uc0ac\uc6a9\ud558\uc5ec \uacf5\uc758 \uc6c0\uc9c1\uc784\uc744 \uc2dc\ubbac\ub808\uc774\uc158\ud569\ub2c8\ub2e4. \ub530\ub77c\uc11c \uac01\ub3c4\uc640 \uc18d\ub3c4\uac00 \uacf5\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc744 \uc774\ud574\ud558\uba74 \uac8c\uc784\uc5d0\uc11c \uc720\ub9ac\ud55c \uc704\uce58\ub97c \ucc28\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 \ub808\ubca8 7\uc5d0\uc11c \ub0a0\uce74\ub85c\uc6b4 \uac01\ub3c4\ub97c \uc774\uc6a9\ud558\uc5ec \uacf5\uc744 \uc0c1\ub2e8 \ubcbd\uc5d0 \ubc18\uc0ac\uc2dc\ucf1c \ub4dd\uc810\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \ucda9\ub3cc \uac01\ub3c4\uc640 \uadf8\uc5d0 \ub530\ub978 \uacf5\uc758 \uada4\uc801\uc744 \ube44\uad50\ud558\uc5ec \ubb3c\ub9ac\ud559 \uc6d0\ub9ac\ub97c \ub354 \uc798 \uc774\ud574\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "Curve Ball 3D\uc758 \uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \ub2e4\uc74c \uc804\ub7b5\uc5d0 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \uc6d0\ud615 \uc2a4\uc640\uc774\ud504\ub97c \ud1b5\ud574 \ud68c\uc804 \uc81c\uc5b4 \uae30\uc220\uc744 \uc219\ub2ec\ud558\uc138\uc694. 2\ub2e8\uacc4: \uc0c1\ub300\ubc29\uc758 \ud328\ub4e4\uc744 \uc774\uc6a9\ud558\uc5ec \ubc18\uaca9\uc744 \ub178\ub9ac\uc138\uc694. 3\ub2e8\uacc4: \uc0c1\ub300\ubc29\uc758 \ud328\ub4e4 \uc6c0\uc9c1\uc784\uc744 \uad00\ucc30\ud558\uc5ec \uc0c1\ub300\ubc29\uc758 \uc6c0\uc9c1\uc784\uc744 \uc608\uce21\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4 \ub808\ubca8 15\uc5d0\uc11c \ud68c\uc804 \uc0f7\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc0c1\ub300\ubc29\uc744 \ub2f9\ud669\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\ubc95 \ube44\uad50: \ub2e4\uc591\ud55c \uc0c1\ud669\uc5d0\uc11c \uc9c1\uc120 \uc0f7\uacfc \ud68c\uc804 \uc0f7\uc744 \ube44\uad50\ud558\uc5ec \uc5b4\ub5a4 \uc0f7\uc774 \ub354 \ud6a8\uacfc\uc801\uc778\uc9c0 \ud655\uc778\ud558\uc138\uc694.]"}, {"question": "Curve Ball 3D\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ub294 \uae30\uc220\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Curve Ball 3D\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc73c\ub824\uba74 \ub2e4\uc74c \uae30\uc220\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. 1\ub2e8\uacc4: \uc5f0\uc18d \ub4dd\uc810\uc73c\ub85c \uba40\ud2f0\ud50c\ub77c\uc774\uc5b4\ub97c \ub192\uc774\uc138\uc694. 2\ub2e8\uacc4: \uc18d\ub3c4 \ubd80\uc2a4\ud130\uc640 \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \ud65c\uc6a9\ud558\uc5ec \ub4dd\uc810 \uc7a0\uc7ac\ub825\uc744 \ub192\uc774\uc138\uc694. 3\ub2e8\uacc4: \ud0c0\uc774\ubc0d\uc744 \uc644\ubcbd\ud558\uac8c \ub9de\ucdb0 \uc0f7 \uc815\ud655\ub3c4\ub97c \uadf9\ub300\ud654\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4 \ub808\ubca8 20\uc5d0\uc11c \uc18d\ub3c4 \ubd80\uc2a4\ud130\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc5f0\uc18d \ub4dd\uc810\uc744 \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc774\ub7ec\ud55c \uae30\uc220\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc810\uc218\ub97c \uadf9\ub300\ud654\ud558\ub294 \ub2e8\uacc4\ub97c \ubcf4\uc5ec\uc8fc\ub294 \ud750\ub984\ub3c4\ub97c \ub9cc\ub4dc\uc138\uc694.]"}, {"question": "Curve Ball 3D\uc758 \ub4dd\uc810 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "Curve Ball 3D\uc758 \ub4dd\uc810 \uc2dc\uc2a4\ud15c\uc740 \ub4dd\uc810 \ud69f\uc218\uc640 \uc0f7 \ub09c\uc774\ub3c4\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uac01 \ub4dd\uc810\uc740 \uc810\uc218\ub97c \uc5bb\uace0, \uc5f0\uc18d \ub4dd\uc810\uc740 \uba40\ud2f0\ud50c\ub77c\uc774\uc5b4\ub97c \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 \ub808\ubca8 10\uc5d0\uc11c \uc5f0\uc18d 3\uace8\uc744 \ub123\uc73c\uba74 \uc810\uc218\uac00 3\ubc30\ub85c \ub298\uc5b4\ub0a9\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ub18d\uad6c \uac8c\uc784\ucc98\ub7fc \uac01 \ub4dd\uc810\uc740 \uc810\uc218\uc774\uba70, 3\uc810\uc29b\uc740 \ub354 \ub9ce\uc740 \uc810\uc218\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4.]"}, {"question": "Curve Ball 3D\uc758 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Curve Ball 3D\uc758 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \ub09c\uc774\ub3c4\uac00 \uc810\ucc28 \uc99d\uac00\ud558\ub294 AI \uc0c1\ub300\uc640 \uacbd\uc7c1\ud558\uba70, \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uc2e4\uc81c \ud50c\ub808\uc774\uc5b4\uc640 \uacbd\uc7c1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ub808\ubca8 5\uc5d0\uc11c \uce5c\uad6c\uc640 \uacbd\uc7c1\ud574 \uc790\uc2e0\uc758 \uc2e4\ub825\uc744 \uc2dc\ud5d8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4\uc758 AI \ud589\ub3d9\uacfc \uba40\ud2f0\ud50c\ub808\uc774\uc5b4\uc758 \uc2e4\uc81c \ud50c\ub808\uc774\uc5b4 \ud589\ub3d9\uc744 \ube44\uad50\ud558\uc138\uc694.]"}, {"question": "Curve Ball 3D\uc5d0\uc11c \uac8c\uc784 \ub370\uc774\ud130\ub97c \ub2e4\ub978 \uae30\uae30\ub85c \uc5b4\ub5bb\uac8c \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Curve Ball 3D\uc5d0\uc11c \uac8c\uc784 \ub370\uc774\ud130\ub97c \ub2e4\ub978 \uae30\uae30\ub85c \uc774\uc804\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. 1\ub2e8\uacc4: \ub450 \uae30\uae30 \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. 2\ub2e8\uacc4: \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5c5\ub85c\ub4dc\ud558\uc138\uc694. 3\ub2e8\uacc4: \uc0c8 \uae30\uae30\uc5d0 \uc800\uc7a5\ub41c \ub370\uc774\ud130\ub97c \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4 iPhone\uc5d0\uc11c Android\ub85c \uc804\ud658\ud558\ub294 \uacbd\uc6b0 Google Play \uac8c\uc784\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub370\uc774\ud130\ub97c \ub3d9\uae30\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\ubc95 \ube44\uad50: iOS\uc640 Android\uc640 \uac19\uc740 \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc0ac\uc6a9 \uac00\ub2a5\ud55c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uc635\uc158\uc744 \ube44\uad50\ud558\uc138\uc694.]"}, {"question": "Curve Ball 3D\uc5d0\uc11c \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Curve Ball 3D\uc5d0\ub294 \uc228\uaca8\uc9c4 \ub808\ubca8\uacfc \uc228\uaca8\uc9c4 \ud30c\uc6cc\uc5c5\uacfc \uac19\uc740 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 \ub808\ubca8 25\uc5d0\uc11c \ud2b9\uc815 \uac01\ub3c4\ub85c \uace8\uc744 \ub123\uc73c\uba74 \uc228\uaca8\uc9c4 \ub808\ubca8\uc744 \uc5f4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc228\uaca8\uc9c4 \uae30\ub2a5 \ud0d0\uc0c9: \uac8c\uc784\uc744 \ucca0\uc800\ud788 \ud0d0\uc0c9\ud558\uc5ec \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uc694\uc18c\ub97c \ucc3e\uc544 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uc138\uc694.]"}, {"question": "Curve Ball 3D\uc5d0\uc11c \ucd5c\uace0\uc758 \uc131\ub2a5\uc744 \uc704\ud574 \uae30\uae30 \uc124\uc815\uc744 \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Curve Ball 3D\uc5d0\uc11c \ucd5c\uace0\uc758 \uc131\ub2a5\uc744 \uc704\ud574 \uae30\uae30 \uc124\uc815\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: 1\ub2e8\uacc4: \uadf8\ub798\ud53d \uc124\uc815\uc744 \uae30\uae30 \uc131\ub2a5\uc5d0 \ub9de\uac8c \uc870\uc815\ud558\uc138\uc694. 2\ub2e8\uacc4: \uae30\uae30 \ucd5c\uc2e0 \uc18c\ud504\ud2b8\uc6e8\uc5b4 \uc5c5\ub370\uc774\ud2b8\ub97c \ud655\uc778\ud558\uc138\uc694. 3\ub2e8\uacc4: \ubc31\uadf8\ub77c\uc6b4\ub4dc \uc571\uc744 \ub2eb\uace0 \uc790\uc6d0\uc744 \ud655\ubcf4\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4 \uace0\uae09 \uae30\uae30\uc5d0\uc11c\ub294 \uc2dc\uac01\uc801 \uacbd\ud5d8 \ud5a5\uc0c1\uc744 \uc704\ud574 \uace0\ud488\uc9c8 \uadf8\ub798\ud53d\uc744 \ud65c\uc131\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \ub2e4\uc591\ud55c \uadf8\ub798\ud53d \uc124\uc815\uc5d0\uc11c \uc131\ub2a5\uc744 \ube44\uad50\ud558\uc5ec \ucd5c\uc801\uc758 \uade0\ud615\uc744 \ucc3e\uc73c\uc138\uc694.]"}, {"question": "Curve Ball 3D\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \ud754\ud788 \uc800\uc9c0\ub974\ub294 \uc2e4\uc218\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub294 \uc885\uc885 \ub2e4\uc74c\uacfc \uac19\uc740 \uc77c\ubc18\uc801\uc778 \uc2e4\uc218\ub97c \uc800\uc9c0\ub985\ub2c8\ub2e4. 1\ub2e8\uacc4: \uc2a4\uc640\uc774\ud504\ub97c \uacfc\ub3c4\ud558\uac8c \ubcf5\uc7a1\ud558\uac8c \ub9cc\ub4e4\uc5b4 \uc815\ud655\ud558\uc9c0 \uc54a\uc740 \uc0f7\uc744 \ubc1c\uc0dd\uc2dc\ud0b5\ub2c8\ub2e4. 2\ub2e8\uacc4: \ubcbd\uc744 \uc774\uc6a9\ud55c \uc0f7 \uac01\ub3c4 \uc870\uc808\uc744 \ubb34\uc2dc\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc744 \ucda9\ubd84\ud788 \uc5f0\uc2b5\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 \ub808\ubca8 1\uc5d0\uc11c \ub9ce\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \ub108\ubb34 \uc138\uac8c \uc2a4\uc640\uc774\ud504\ud558\uc5ec \uacf5\uc774 \ud328\ub4e4\uc744 \ub193\uce58\ub294 \uacbd\uc6b0\uac00 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud328\ub4e4\uc744 \uc2a4\ud2f0\uc5b4\ub9c1 \ud720\ub85c \uc0dd\uac01\ud574\ubcf4\uc138\uc694. \ubd80\ub4dc\ub7fd\uace0 \uc81c\uc5b4\ub41c \uc6c0\uc9c1\uc784\uc774 \uc131\uacf5\uc758 \uc5f4\uc1e0\uc785\ub2c8\ub2e4.]"}]
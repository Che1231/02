[{"question": "\u30ab\u30fc\u30d6\u30dc\u30fc\u30eb3D\u306e\u521d\u5fc3\u8005\u5411\u3051\u57fa\u672c\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30ab\u30fc\u30d6\u30dc\u30fc\u30eb3D\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\u3002 \u30b9\u30c6\u30c3\u30d71\uff1a\u30d1\u30c9\u30eb\u3092\u64cd\u4f5c\u3059\u308b\u305f\u3081\u306e\u30b9\u30ef\u30a4\u30d7\u30b8\u30a7\u30b9\u30c1\u30e3\u30fc\u306b\u6163\u308c\u308b\u3002 \u30b9\u30c6\u30c3\u30d72\uff1a\u30dc\u30fc\u30eb\u3092\u6b63\u78ba\u306b\u6253\u3064\u305f\u3081\u306b\u30b9\u30ef\u30a4\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u7df4\u7fd2\u3059\u308b\u3002 \u30b9\u30c6\u30c3\u30d73\uff1a\u58c1\u3092\u4f7f\u3063\u3066\u30b7\u30e7\u30c3\u30c8\u306e\u89d2\u5ea6\u3092\u3064\u3051\u308b\u3002 \u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb3\u3067\u306f\u3001\u5de6\u5074\u306e\u58c1\u3092\u4f7f\u3063\u3066\u30dc\u30fc\u30eb\u3092\u76f8\u624b\u306e\u30b4\u30fc\u30eb\u306b\u8df3\u306d\u8fd4\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002 [\u4f8b\u3048\uff1a\u30d1\u30c9\u30eb\u3092\u30c6\u30cb\u30b9\u30e9\u30b1\u30c3\u30c8\u3001\u30dc\u30fc\u30eb\u3092\u30c6\u30cb\u30b9\u30dc\u30fc\u30eb\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u5b8c\u74a7\u306a\u30b9\u30a4\u30f3\u30b0\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u5fc5\u8981\u3067\u3059\u3002]"}, {"question": "\u30ab\u30fc\u30d6\u30dc\u30fc\u30eb3D\u3067\u7269\u7406\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u306a\u305c\u91cd\u8981\u3067\u3059\u304b\uff1f", "answer": "\u30ab\u30fc\u30d6\u30dc\u30fc\u30eb3D\u3067\u7269\u7406\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u30dc\u30fc\u30eb\u306e\u8ecc\u9053\u3092\u4e88\u6e2c\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u305f\u3081\u91cd\u8981\u3067\u3059\u3002\u3053\u306e\u30b2\u30fc\u30e0\u306f\u73fe\u5b9f\u7684\u306a\u7269\u7406\u5b66\u3092\u4f7f\u7528\u3057\u3066\u30dc\u30fc\u30eb\u306e\u52d5\u304d\u3092\u30b7\u30df\u30e5\u30ec\u30fc\u30c8\u3059\u308b\u305f\u3081\u3001\u89d2\u5ea6\u3068\u901f\u5ea6\u304c\u30dc\u30fc\u30eb\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3059\u308b\u304b\u3092\u77e5\u308b\u3053\u3068\u3067\u3001\u6709\u5229\u306b\u50cd\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb7\u3067\u306f\u3001\u92ed\u3044\u89d2\u5ea6\u3092\u4f7f\u3063\u3066\u30dc\u30fc\u30eb\u3092\u30c8\u30c3\u30d7\u30a6\u30a9\u30fc\u30eb\u306b\u8df3\u306d\u8fd4\u3057\u3066\u5f97\u70b9\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002 [\u6bd4\u8f03\u8868\uff1a\u885d\u7a81\u89d2\u5ea6\u3068\u7d50\u679c\u306e\u30dc\u30fc\u30eb\u306e\u8ecc\u9053\u3092\u6bd4\u8f03\u3057\u3066\u3001\u7269\u7406\u3092\u3088\u308a\u6df1\u304f\u7406\u89e3\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30ab\u30fc\u30d6\u30dc\u30fc\u30eb3D\u306e\u30d9\u30c6\u30e9\u30f3\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u6700\u9069\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u4ee5\u4e0b\u306e\u6226\u7565\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3079\u304d\u3067\u3059\u3002 \u30b9\u30c6\u30c3\u30d71\uff1a\u5186\u3092\u63cf\u304f\u3088\u3046\u306b\u30b9\u30ef\u30a4\u30d7\u3059\u308b\u3053\u3068\u3067\u30b9\u30d4\u30f3\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u306e\u6280\u8853\u3092\u7fd2\u5f97\u3059\u308b\u3002 \u30b9\u30c6\u30c3\u30d72\uff1a\u30ea\u30d0\u30a6\u30f3\u30c9\u3092\u72d9\u3046\u3053\u3068\u306b\u3088\u3063\u3066\u76f8\u624b\u306e\u8155\u3092\u6709\u5229\u306b\u5229\u7528\u3057\u307e\u3059\u3002 \u30b9\u30c6\u30c3\u30d73\uff1a\u76f8\u624b\u306e\u8155\u306e\u52d5\u304d\u3092\u89b3\u5bdf\u3059\u308b\u3053\u3068\u3067\u76f8\u624b\u306e\u52d5\u304d\u3092\u4e88\u6e2c\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb15\u3067\u306f\u3001\u30b9\u30d4\u30f3\u30b7\u30e7\u30c3\u30c8\u3092\u4f7f\u3063\u3066\u76f8\u624b\u3092\u6df7\u4e71\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002 [\u6bd4\u8f03\uff1a\u30b9\u30c8\u30ec\u30fc\u30c8\u30b7\u30e7\u30c3\u30c8\u3068\u30b9\u30d4\u30f3\u30b7\u30e7\u30c3\u30c8\u3092\u6bd4\u8f03\u3057\u3066\u3001\u3055\u307e\u3056\u307e\u306a\u30b7\u30ca\u30ea\u30aa\u3067\u3069\u3061\u3089\u304c\u3088\u308a\u6709\u52b9\u3067\u3042\u308b\u304b\u898b\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30ab\u30fc\u30d6\u30dc\u30fc\u30eb3D\u3067\u9ad8\u5f97\u70b9\u3092\u53d6\u308b\u305f\u3081\u306b\u5f79\u7acb\u3064\u30c6\u30af\u30cb\u30c3\u30af\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ab\u30fc\u30d6\u30dc\u30fc\u30eb3D\u3067\u9ad8\u5f97\u70b9\u3092\u53d6\u308b\u305f\u3081\u306b\u3001\u3053\u308c\u3089\u306e\u30c6\u30af\u30cb\u30c3\u30af\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002 \u30b9\u30c6\u30c3\u30d71\uff1a\u30de\u30eb\u30c1\u30d7\u30e9\u30a4\u30e4\u30fc\u3092\u69cb\u7bc9\u3059\u308b\u305f\u3081\u306b\u9023\u7d9a\u3057\u3066\u30b4\u30fc\u30eb\u3092\u72d9\u3046\u3002 \u30b9\u30c6\u30c3\u30d72\uff1a\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u306a\u3069\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u5229\u7528\u3057\u3066\u5f97\u70b9\u306e\u6f5c\u5728\u529b\u3092\u9ad8\u3081\u308b\u3002 \u30b9\u30c6\u30c3\u30d73\uff1a\u30b7\u30e7\u30c3\u30c8\u306e\u6b63\u78ba\u6027\u3092\u6700\u5927\u5316\u3059\u308b\u305f\u3081\u306b\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5b8c\u74a7\u306b\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb20\u3067\u306f\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u3092\u4f7f\u3063\u3066\u3001\u7d20\u65e9\u304f\u8907\u6570\u306e\u30b4\u30fc\u30eb\u3092\u7372\u5f97\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002 [\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u3053\u308c\u3089\u306e\u30c6\u30af\u30cb\u30c3\u30af\u3092\u4f7f\u7528\u3057\u3066\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3059\u308b\u624b\u9806\u3092\u793a\u3059\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u4f5c\u6210\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30ab\u30fc\u30d6\u30dc\u30fc\u30eb3D\u306e\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30ab\u30fc\u30d6\u30dc\u30fc\u30eb3D\u306e\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u5f97\u70b9\u306e\u6570\u3068\u30b7\u30e7\u30c3\u30c8\u306e\u96e3\u6613\u5ea6\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u5404\u30b4\u30fc\u30eb\u306f\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u3001\u9023\u7d9a\u30b4\u30fc\u30eb\u306f\u30de\u30eb\u30c1\u30d7\u30e9\u30a4\u30e4\u30fc\u3092\u9ad8\u3081\u307e\u3059\u3002 \u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb10\u30673\u30b4\u30fc\u30eb\u9023\u7d9a\u3067\u5f97\u70b9\u3059\u308b\u3068\u3001\u30dd\u30a4\u30f3\u30c8\u306f3\u500d\u306b\u306a\u308a\u307e\u3059\u3002 [\u4f8b\u3048\uff1a\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u3092\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u306e\u3088\u3046\u306b\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u305d\u308c\u305e\u308c\u306e\u5f97\u70b9\u3067\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u30013\u30dd\u30a4\u30f3\u30c8\u30b7\u30e5\u30fc\u30c8\u306f\u3055\u3089\u306b\u591a\u304f\u306e\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u307e\u3059\u3002]"}, {"question": "\u30ab\u30fc\u30d6\u30dc\u30fc\u30eb3D\u306e\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306e\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ab\u30fc\u30d6\u30dc\u30fc\u30eb3D\u306e\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306e\u9055\u3044\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\u3002\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u306f\u3001\u96e3\u6613\u5ea6\u304c\u5897\u52a0\u3059\u308bAI\u76f8\u624b\u3068\u5bfe\u6226\u3057\u307e\u3059\u304c\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u306f\u5b9f\u969b\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u5bfe\u6226\u3067\u304d\u307e\u3059\u3002 \u4f8b\u3048\u3070\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30ec\u30d9\u30eb5\u3067\u306f\u3001\u53cb\u9054\u3068\u6311\u6226\u3057\u3001\u81ea\u5206\u306e\u30b9\u30ad\u30eb\u3092\u8a66\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002 [\u6bd4\u8f03\u8868\uff1a\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u306eAI\u306e\u884c\u52d5\u3092\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u5b9f\u969b\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u884c\u52d5\u3068\u6bd4\u8f03\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30ab\u30fc\u30d6\u30dc\u30fc\u30eb3D\u3067\u30b2\u30fc\u30e0\u30c7\u30fc\u30bf\u3092\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u79fb\u884c\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30ab\u30fc\u30d6\u30dc\u30fc\u30eb3D\u3067\u30b2\u30fc\u30e0\u30c7\u30fc\u30bf\u3092\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u79fb\u884c\u3059\u308b\u306b\u306f\u3001\u6b21\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\u3002 \u30b9\u30c6\u30c3\u30d71\uff1a\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3059\u308b\u3002 \u30b9\u30c6\u30c3\u30d72\uff1a\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u9032\u884c\u72b6\u6cc1\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3059\u308b\u3002 \u30b9\u30c6\u30c3\u30d73\uff1a\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u4fdd\u5b58\u30c7\u30fc\u30bf\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3059\u308b\u3002 \u4f8b\u3048\u3070\u3001iPhone\u304b\u3089Android\u306b\u5207\u308a\u66ff\u3048\u308b\u5834\u5408\u306f\u3001Google Play\u30b2\u30fc\u30e0\u3092\u4f7f\u7528\u3057\u3066\u30c7\u30fc\u30bf\u3092\u540c\u671f\u3067\u304d\u307e\u3059\u3002 [\u6bd4\u8f03\u8868\uff1aiOS\u3068Android\u306e\u3088\u3046\u306a\u3055\u307e\u3056\u307e\u306a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u5229\u7528\u53ef\u80fd\u306a\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u6bd4\u8f03\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30ab\u30fc\u30d6\u30dc\u30fc\u30eb3D\u306b\u306f\u3001\u3069\u306e\u3088\u3046\u306a\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30ab\u30fc\u30d6\u30dc\u30fc\u30eb3D\u306b\u306f\u3001\u96a0\u3057\u30ec\u30d9\u30eb\u3084\u96a0\u3057\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306a\u3069\u306e\u3044\u304f\u3064\u304b\u306e\u96a0\u3057\u6a5f\u80fd\u304c\u3042\u308a\u307e\u3059\u3002 \u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb25\u3067\u306f\u3001\u7279\u5b9a\u306e\u89d2\u5ea6\u3067\u30b4\u30fc\u30eb\u3092\u6c7a\u3081\u308b\u3068\u3001\u96a0\u3057\u30ec\u30d9\u30eb\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u3002 [\u63a2\u6c42\uff1a\u3053\u308c\u3089\u306e\u96a0\u3057\u8981\u7d20\u3092\u63a2\u3057\u51fa\u3057\u3001\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u306b\u3001\u30b2\u30fc\u30e0\u3092\u5fb9\u5e95\u7684\u306b\u8abf\u3079\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30ab\u30fc\u30d6\u30dc\u30fc\u30eb3D\u3067\u6700\u9069\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5f97\u308b\u305f\u3081\u306b\u30c7\u30d0\u30a4\u30b9\u8a2d\u5b9a\u3092\u3069\u306e\u3088\u3046\u306b\u6700\u9069\u5316\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30ab\u30fc\u30d6\u30dc\u30fc\u30eb3D\u3067\u6700\u9069\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5f97\u308b\u305f\u3081\u306b\u30c7\u30d0\u30a4\u30b9\u8a2d\u5b9a\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u6b21\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\u3002 \u30b9\u30c6\u30c3\u30d71\uff1a\u30c7\u30d0\u30a4\u30b9\u306e\u6a5f\u80fd\u306b\u5408\u308f\u305b\u308b\u3088\u3046\u306b\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3092\u8abf\u6574\u3059\u308b\u3002 \u30b9\u30c6\u30c3\u30d72\uff1a\u30c7\u30d0\u30a4\u30b9\u304c\u6700\u65b0\u306e\u30bd\u30d5\u30c8\u30a6\u30a7\u30a2\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3092\u6301\u3063\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3059\u308b\u3002 \u30b9\u30c6\u30c3\u30d73\uff1a\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u30a2\u30d7\u30ea\u3092\u9589\u3058\u3066\u30ea\u30bd\u30fc\u30b9\u3092\u89e3\u653e\u3059\u308b\u3002 \u4f8b\u3048\u3070\u3001\u9ad8\u6027\u80fd\u306a\u30c7\u30d0\u30a4\u30b9\u3067\u306f\u3001\u3088\u308a\u826f\u3044\u8996\u899a\u7684\u306a\u4f53\u9a13\u306e\u305f\u3081\u306b\u9ad8\u54c1\u8cea\u306a\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u3092\u6709\u52b9\u306b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002 [\u6bd4\u8f03\u8868\uff1a\u6700\u9069\u306a\u30d0\u30e9\u30f3\u30b9\u3092\u898b\u3064\u3051\u308b\u305f\u3081\u306b\u3001\u3055\u307e\u3056\u307e\u306a\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3067\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6bd4\u8f03\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30ab\u30fc\u30d6\u30dc\u30fc\u30eb3D\u3067\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u3088\u304f\u72af\u3059\u6700\u3082\u4e00\u822c\u7684\u306a\u9593\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u3057\u3070\u3057\u3070\u3053\u308c\u3089\u306e\u4e00\u822c\u7684\u306a\u9593\u9055\u3044\u3092\u72af\u3057\u307e\u3059\u3002 \u30b9\u30c6\u30c3\u30d71\uff1a\u30b9\u30ef\u30a4\u30d7\u3092\u8907\u96d1\u5316\u3057\u3001\u30b7\u30e7\u30c3\u30c8\u304c\u4e0d\u6b63\u78ba\u306b\u306a\u308b\u3002 \u30b9\u30c6\u30c3\u30d72\uff1a\u30b7\u30e7\u30c3\u30c8\u306e\u89d2\u5ea6\u3092\u3064\u3051\u308b\u305f\u3081\u306b\u58c1\u306e\u4f7f\u7528\u3092\u7121\u8996\u3059\u308b\u3002 \u30b9\u30c6\u30c3\u30d73\uff1a\u30b2\u30fc\u30e0\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u305f\u3081\u306b\u5341\u5206\u306b\u7df4\u7fd2\u3057\u3066\u3044\u306a\u3044\u3002 \u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb1\u3067\u306f\u3001\u591a\u304f\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u5f37\u304f\u30b9\u30ef\u30a4\u30d7\u3057\u3059\u304e\u308b\u305f\u3081\u3001\u30dc\u30fc\u30eb\u304c\u30d1\u30c9\u30eb\u3092\u5916\u308c\u3066\u3057\u307e\u3044\u307e\u3059\u3002 [\u4f8b\u3048\uff1a\u30d1\u30c9\u30eb\u3092\u30b9\u30c6\u30a2\u30ea\u30f3\u30b0\u30db\u30a4\u30fc\u30eb\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30e0\u30fc\u30ba\u3067\u5236\u5fa1\u3055\u308c\u305f\u52d5\u304d\u304c\u6210\u529f\u306e\u30ab\u30ae\u3067\u3059\u3002]"}]
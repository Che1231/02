[{"question": "\u041a\u0430\u043a \u043d\u043e\u0432\u044b\u0435 \u0438\u0433\u0440\u043e\u043a\u0438 \u0431\u044b\u0441\u0442\u0440\u043e \u043d\u0430\u0447\u0438\u043d\u0430\u044e\u0442 \u0438\u0433\u0440\u0430\u0442\u044c \u0432 Craftnite.io \u0438 \u043a\u0430\u043a\u043e\u0432\u044b \u043f\u0435\u0440\u0432\u044b\u0435 \u0448\u0430\u0433\u0438?", "answer": "\u0427\u0442\u043e\u0431\u044b \u043d\u0430\u0447\u0430\u0442\u044c \u0438\u0433\u0440\u0430\u0442\u044c \u0432 Craftnite.io, \u043d\u043e\u0432\u044b\u0435 \u0438\u0433\u0440\u043e\u043a\u0438 \u0434\u043e\u043b\u0436\u043d\u044b \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u043f\u0440\u043e\u0439\u0442\u0438 \u043e\u0431\u0443\u0447\u0430\u044e\u0449\u0438\u0439 \u043a\u0443\u0440\u0441, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0437\u043d\u0430\u043a\u043e\u043c\u0438\u0442 \u0441 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u043c\u0438 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u043c\u0438 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0438 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430\u043c\u0438. \u041f\u043e\u0441\u043b\u0435 \u0442\u0443\u0442\u043e\u0440\u0438\u0430\u043b\u0430, \u0428\u0410\u0413 1: \u0421\u043e\u0431\u0435\u0440\u0438\u0442\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u044b, \u0442\u0430\u043a\u0438\u0435 \u043a\u0430\u043a \u0434\u0440\u0435\u0432\u0435\u0441\u0438\u043d\u0430 \u0438 \u043a\u0430\u043c\u0435\u043d\u044c, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u0442\u043e\u043f\u043e\u0440 \u0438 \u043a\u0438\u0440\u043a\u0443. \u0428\u0410\u0413 2: \u0418\u0437\u0433\u043e\u0442\u043e\u0432\u044c\u0442\u0435 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u044b\u0435 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b \u0438 \u043e\u0440\u0443\u0436\u0438\u0435 \u043d\u0430 \u0432\u0435\u0440\u0441\u0442\u0430\u043a\u0435. \u0428\u0410\u0413 3: \u041f\u043e\u0441\u0442\u0440\u043e\u0439\u0442\u0435 \u043f\u0440\u043e\u0441\u0442\u043e\u0439 \u0443\u043a\u0440\u044b\u0442\u0438\u0435, \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044c\u0441\u044f \u043e\u0442 \u0432\u0440\u0430\u0433\u043e\u0432. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0438\u0437\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0434\u0435\u0440\u0435\u0432\u044f\u043d\u043d\u043e\u0433\u043e \u043c\u0435\u0447\u0430 \u0438 \u0449\u0438\u0442\u0430 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0443\u0432\u0435\u043b\u0438\u0447\u0438\u0442 \u0432\u0430\u0448\u0438 \u0448\u0430\u043d\u0441\u044b \u043d\u0430 \u0432\u044b\u0436\u0438\u0432\u0430\u043d\u0438\u0435 \u0432 \u043d\u0430\u0447\u0430\u043b\u0435 \u0438\u0433\u0440\u044b. [\u041f\u0440\u0438\u043c\u0435\u0440: \u041f\u043e\u0434\u0443\u043c\u0430\u0439\u0442\u0435 \u043e \u0432\u0430\u0448\u0435\u043c \u043f\u0435\u0440\u0432\u043e\u043c \u0443\u0431\u0435\u0436\u0438\u0449\u0435 \u043a\u0430\u043a \u043e \u00ab\u0441\u0442\u0430\u0440\u0442\u043e\u0432\u043e\u043c \u0434\u043e\u043c\u0435\u00bb \u2014 \u043e\u043d \u043d\u0435 \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u0442\u044c \u0440\u043e\u0441\u043a\u043e\u0448\u043d\u044b\u043c, \u0430 \u0442\u043e\u043b\u044c\u043a\u043e \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u043c.]"}, {"question": "\u041a\u0430\u043a\u0438\u0435 \u043b\u0443\u0447\u0448\u0438\u0435 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0438 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0440\u0435\u0441\u0443\u0440\u0441\u0430\u043c\u0438 \u0432 Craftnite.io \u0434\u043b\u044f \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0441 \u0431\u043e\u043b\u0435\u0435 \u0447\u0435\u043c 100 \u0447\u0430\u0441\u0430\u043c\u0438 \u0438\u0433\u0440\u043e\u0432\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438?", "answer": "\u041e\u043f\u044b\u0442\u043d\u044b\u0435 \u0438\u0433\u0440\u043e\u043a\u0438 \u0434\u043e\u043b\u0436\u043d\u044b \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0438\u0442\u044c\u0441\u044f \u043d\u0430 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u043c \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u0430\u043c\u0438. \u0428\u0410\u0413 1: \u041f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442 \u043e\u0442\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0441\u0431\u043e\u0440\u0443 \u0440\u0435\u0434\u043a\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u043e\u0432, \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a \u043e\u0431\u0441\u0438\u0434\u0438\u0430\u043d \u0438 \u0430\u043b\u043c\u0430\u0437\u044b, \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u044d\u043a\u0441\u043f\u0435\u0434\u0438\u0446\u0438\u0439 \u043f\u043e \u0434\u043e\u0431\u044b\u0447\u0435 \u0440\u0443\u0434\u044b. \u0428\u0410\u0413 2: \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u043f\u0435\u0440\u0435\u0434\u043e\u0432\u044b\u0435 \u0440\u0435\u0446\u0435\u043f\u0442\u044b \u0434\u043b\u044f \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u043e\u0432 \u0432\u044b\u0441\u043e\u043a\u043e\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f, \u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a \u0437\u0430\u0447\u0430\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u043e\u0440\u0443\u0436\u0438\u0435 \u0438 \u0431\u0440\u043e\u043d\u044f. \u0428\u0410\u0413 3: \u0425\u0440\u0430\u043d\u0438\u0442\u0435 \u0438\u0437\u043b\u0438\u0448\u043a\u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u043e\u0432 \u0432 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u0441\u0443\u043d\u0434\u0443\u043a\u0430\u0445, \u0447\u0442\u043e\u0431\u044b \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u043c\u0435\u0441\u0442\u043e \u0432 \u0438\u043d\u0432\u0435\u043d\u0442\u0430\u0440\u0435. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0441\u0443\u043d\u0434\u0443\u043a\u0430 \u0434\u043b\u044f \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u043e\u0432 \u0441\u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0442 \u0432\u0440\u0435\u043c\u044f \u043f\u0440\u0438 \u043a\u0440\u0443\u043f\u043d\u044b\u0445 \u0441\u0442\u0440\u043e\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u0445. [\u0422\u0430\u0431\u043b\u0438\u0446\u0430 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044f: \u041e\u0431\u0449\u0438\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u044b \u043f\u0440\u043e\u0442\u0438\u0432 \u0440\u0435\u0434\u043a\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u043e\u0432: \u0414\u0435\u0440\u0435\u0432\u043e (\u043e\u0431\u0449\u0435\u0435) \u043f\u0440\u043e\u0442\u0438\u0432 \u0410\u043b\u043c\u0430\u0437\u0430 (\u0440\u0435\u0434\u043a\u043e\u0435).]"}, {"question": "\u041f\u043e\u0447\u0435\u043c\u0443 \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u0438\u0435 \u0446\u0438\u043a\u043b\u0430 \u0434\u0435\u043d\u044c-\u043d\u043e\u0447\u044c \u0438\u043c\u0435\u0435\u0442 \u0440\u0435\u0448\u0430\u044e\u0449\u0435\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u0432 Craftnite.io \u0438 \u043a\u0430\u043a \u044d\u0442\u043e \u0432\u043b\u0438\u044f\u0435\u0442 \u043d\u0430 \u0438\u0433\u0440\u043e\u0432\u043e\u0439 \u043f\u0440\u043e\u0446\u0435\u0441\u0441?", "answer": "\u0426\u0438\u043a\u043b \u0434\u0435\u043d\u044c-\u043d\u043e\u0447\u044c \u0432 Craftnite.io \u0438\u043c\u0435\u0435\u0442 \u0440\u0435\u0448\u0430\u044e\u0449\u0435\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043e\u043d \u0434\u0438\u043a\u0442\u0443\u0435\u0442 \u0447\u0430\u0441\u0442\u043e\u0442\u0443 \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u0432\u0440\u0430\u0433\u043e\u0432 \u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0441\u0442\u044c \u0440\u0435\u0441\u0443\u0440\u0441\u043e\u0432. \u0414\u043d\u0451\u043c \u0438\u0433\u0440\u043e\u043a\u0438 \u043c\u043e\u0433\u0443\u0442 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e \u0441\u043e\u0431\u0438\u0440\u0430\u0442\u044c \u0440\u0435\u0441\u0443\u0440\u0441\u044b \u0438 \u0441\u0442\u0440\u043e\u0438\u0442\u044c \u043e\u0431\u044a\u0435\u043a\u0442\u044b. \u041d\u043e\u0447\u044c\u044e \u043f\u043e\u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0432\u0440\u0430\u0436\u0434\u0435\u0431\u043d\u044b\u0435 \u043c\u043e\u0431\u044b, \u0442\u0430\u043a\u0438\u0435 \u043a\u0430\u043a \u0437\u043e\u043c\u0431\u0438 \u0438 \u0441\u043a\u0435\u043b\u0435\u0442\u044b, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0432\u0430\u0436\u043d\u043e \u0438\u043c\u0435\u0442\u044c \u0430\u0434\u0435\u043a\u0432\u0430\u0442\u043d\u0443\u044e \u0437\u0430\u0449\u0438\u0442\u0443. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u0444\u0430\u043a\u0435\u043b\u043e\u0432 \u0432\u043e\u043a\u0440\u0443\u0433 \u0432\u0430\u0448\u0435\u0439 \u0431\u0430\u0437\u044b \u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0442\u0438\u0442\u044c \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0435 \u043c\u043e\u0431\u043e\u0432 \u0438 \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0442\u044c \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u044c. [\u041f\u0440\u0438\u043c\u0435\u0440: \u0446\u0438\u043a\u043b \u0434\u0435\u043d\u044c-\u043d\u043e\u0447\u044c \u043f\u043e\u0434\u043e\u0431\u0435\u043d \u00ab\u0442\u0430\u0439\u043c\u0435\u0440\u0443\u00bb \u2014 \u0440\u0430\u0437\u0443\u043c\u043d\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0441\u0432\u0435\u0442\u043b\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u0441\u0443\u0442\u043e\u043a, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u0442\u044c\u0441\u044f \u043a \u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u044f\u043c \u043d\u043e\u0447\u0438.]"}, {"question": "\u0412 \u0447\u0435\u043c \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0440\u0430\u0437\u043b\u0438\u0447\u0438\u044f \u043c\u0435\u0436\u0434\u0443 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u043c\u0438 \u043a\u0440\u0430\u0444\u0442\u0430 \u0432 Craftnite.io \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0438\u0433\u0440\u0430\u0445 \u0432\u044b\u0436\u0438\u0432\u0430\u043d\u0438\u044f?", "answer": "\u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u043a\u0440\u0430\u0444\u0442\u0430 Craftnite.io \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u0430 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0441\u0432\u043e\u0435\u043c\u0443 \u0443\u043f\u0440\u043e\u0449\u0435\u043d\u043d\u043e\u043c\u0443 \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0443 \u0438 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0435 \u043a\u0440\u0430\u0444\u0442\u0430 \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438. \u0412 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u0434\u0440\u0443\u0433\u0438\u0445 \u0438\u0433\u0440, Craftnite.io \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0438\u0433\u0440\u043e\u043a\u0430\u043c \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u0442\u044c \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b \u043d\u0430 \u0445\u043e\u0434\u0443, \u0431\u0435\u0437 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u0435\u0440\u0441\u0442\u0430\u043a\u0430. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0431\u0430\u0437\u043e\u0432\u043e\u0433\u043e \u0444\u0430\u043a\u0435\u043b\u0430 \u043c\u043e\u0436\u0435\u0442 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0442\u044c\u0441\u044f \u043d\u0435\u043f\u043e\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u0438\u0437 \u0438\u043d\u0432\u0435\u043d\u0442\u0430\u0440\u044f, \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u0431\u044b\u0441\u0442\u0440\u0435\u0435 \u0438 \u0443\u0434\u043e\u0431\u043d\u0435\u0435. [\u0421\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \u0440\u0430\u0437\u043d\u044b\u0445 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432: \u041a\u0440\u0430\u0444\u0442 \u0432 Craftnite.io \u043f\u0440\u043e\u0442\u0438\u0432 \u0434\u0440\u0443\u0433\u0438\u0445 \u0438\u0433\u0440: \u0420\u0435\u0430\u043b\u044c\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f (Craftnite.io) \u043f\u0440\u043e\u0442\u0438\u0432 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u043d\u0430 \u0441\u0442\u0430\u043d\u0446\u0438\u044f\u0445 (\u0414\u0440\u0443\u0433\u0438\u0435).]"}, {"question": "\u041a\u0430\u043a \u0438\u0433\u0440\u043e\u043a\u0438 \u043c\u043e\u0433\u0443\u0442 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0444\u0443\u043d\u043a\u0446\u0438\u044e \u043a\u0430\u0440\u0442\u044b \u0432 Craftnite.io \u0434\u043b\u044f \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u044f \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f?", "answer": "\u0424\u0443\u043d\u043a\u0446\u0438\u044f \u043a\u0430\u0440\u0442\u044b \u0432 Craftnite.io \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u0430 \u0434\u043b\u044f \u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0438 \u0438 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f. \u0428\u0410\u0413 1: \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u043a\u0430\u0440\u0442\u0443 \u0434\u043b\u044f \u043f\u043e\u043c\u0435\u0442\u043a\u0438 \u0431\u043e\u0433\u0430\u0442\u044b\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0430\u043c\u0438 \u043e\u0431\u043b\u0430\u0441\u0442\u0435\u0439 \u0438 \u0432\u0440\u0430\u0436\u0435\u0441\u043a\u0438\u0445 \u043b\u0430\u0433\u0435\u0440\u0435\u0439. \u0428\u0410\u0413 2: \u041f\u043b\u0430\u043d\u0438\u0440\u0443\u0439\u0442\u0435 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u044b \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f, \u0447\u0442\u043e\u0431\u044b \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044c \u043e\u043f\u0430\u0441\u043d\u044b\u0445 \u0437\u043e\u043d. \u0428\u0410\u0413 3: \u041e\u0431\u043c\u0435\u043d\u0438\u0432\u0430\u0439\u0442\u0435\u0441\u044c \u043c\u0435\u0442\u043a\u0430\u043c\u0438 \u043d\u0430 \u043a\u0430\u0440\u0442\u0435 \u0441 \u0447\u043b\u0435\u043d\u0430\u043c\u0438 \u043a\u043e\u043c\u0430\u043d\u0434\u044b \u0432 \u043c\u043d\u043e\u0433\u043e\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0435 \u0434\u043b\u044f \u0441\u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043c\u0430\u0440\u043a\u0438\u0440\u043e\u0432\u043a\u0430 \u043f\u0435\u0449\u0435\u0440\u044b \u0441 \u0446\u0435\u043d\u043d\u044b\u043c\u0438 \u0440\u0443\u0434\u0430\u043c\u0438 \u043f\u043e\u043c\u043e\u0436\u0435\u0442 \u0432\u0430\u043c \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f \u043a \u043d\u0435\u0439 \u043f\u043e\u0437\u0436\u0435. [\u0421\u0445\u0435\u043c\u0430 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u043a\u0430\u0440\u0442\u044b: \u041e\u0442\u043a\u0440\u044b\u0442\u044c \u043a\u0430\u0440\u0442\u0443 \u2192 \u041e\u0442\u043c\u0435\u0442\u0438\u0442\u044c \u043c\u0435\u0441\u0442\u0430 \u2192 \u0421\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u043c\u0430\u0440\u0448\u0440\u0443\u0442.]"}, {"question": "\u041a\u0430\u043a\u0438\u0435 \u0441\u0430\u043c\u044b\u0435 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u044b\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u044b \u0437\u0430\u0449\u0438\u0442\u044b \u043e\u0442 \u043d\u0430\u0431\u0435\u0433\u043e\u0432 \u0432 Craftnite.io \u0438 \u043a \u0447\u0435\u043c\u0443 \u0434\u043e\u043b\u0436\u043d\u044b \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u0442\u044c\u0441\u044f \u0438\u0433\u0440\u043e\u043a\u0438?", "answer": "\u0417\u0430\u0449\u0438\u0442\u0430 \u043e\u0442 \u043d\u0430\u0431\u0435\u0433\u043e\u0432 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0438 \u0438 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0438. \u0428\u0410\u0413 1: \u041f\u043e\u0441\u0442\u0440\u043e\u0439\u0442\u0435 \u0443\u043a\u0440\u0435\u043f\u043b\u0435\u043d\u043d\u044b\u0435 \u0441\u0442\u0435\u043d\u044b \u0438 \u043b\u043e\u0432\u0443\u0448\u043a\u0438 \u0432\u043e\u043a\u0440\u0443\u0433 \u0432\u0430\u0448\u0435\u0439 \u0431\u0430\u0437\u044b. \u0428\u0410\u0413 2: \u0417\u0430\u043f\u0430\u0441\u0430\u0439\u0442\u0435\u0441\u044c \u043e\u0440\u0443\u0436\u0438\u0435\u043c \u0438 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430\u043c\u0438 \u043b\u0435\u0447\u0435\u043d\u0438\u044f \u0434\u043b\u044f \u0431\u044b\u0441\u0442\u0440\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0443\u043f\u0430 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0430\u0442\u0430\u043a. \u0428\u0410\u0413 3: \u041a\u043e\u043e\u0440\u0434\u0438\u043d\u0438\u0440\u0443\u0439\u0442\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0441 \u0447\u043b\u0435\u043d\u0430\u043c\u0438 \u043a\u043e\u043c\u0430\u043d\u0434\u044b, \u0447\u0442\u043e\u0431\u044b \u043e\u0445\u0432\u0430\u0442\u0438\u0442\u044c \u0432\u0441\u0435 \u0442\u043e\u0447\u043a\u0438 \u0432\u0445\u043e\u0434\u0430. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u0448\u0438\u043f\u043e\u0432\u044b\u0445 \u043b\u043e\u0432\u0443\u0448\u0435\u043a \u0443 \u0432\u0445\u043e\u0434\u0430 \u0432 \u0431\u0430\u0437\u0443 \u043c\u043e\u0436\u0435\u0442 \u043e\u0442\u043f\u0443\u0433\u043d\u0443\u0442\u044c \u043d\u0430\u043f\u0430\u0434\u0430\u044e\u0449\u0438\u0445. [\u0421\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432: \u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0438 \u0437\u0430\u0449\u0438\u0442\u044b: \u041b\u043e\u0432\u0443\u0448\u043a\u0438 \u043f\u0440\u043e\u0442\u0438\u0432 \u0443\u043a\u0440\u0435\u043f\u043b\u0435\u043d\u043d\u044b\u0445 \u0441\u0442\u0435\u043d \u2014 \u043e\u0431\u0430 \u0432\u0430\u0436\u043d\u044b \u0434\u043b\u044f \u0441\u0431\u0430\u043b\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u0437\u0430\u0449\u0438\u0442\u044b.]"}, {"question": "\u041a\u0430\u043a \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0430 \u0433\u043e\u043b\u043e\u0434\u0430 \u0432 Craftnite.io \u0438 \u043a\u0430\u043a\u043e\u0432\u044b \u043b\u0443\u0447\u0448\u0438\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u044b \u0441 \u043d\u0435\u0439 \u0441\u043f\u0440\u0430\u0432\u0438\u0442\u044c\u0441\u044f?", "answer": "\u041c\u0435\u0445\u0430\u043d\u0438\u043a\u0430 \u0433\u043e\u043b\u043e\u0434\u0430 \u0432 Craftnite.io \u0432\u043b\u0438\u044f\u0435\u0442 \u043d\u0430 \u0432\u0430\u0448\u0435 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u0435 \u0438 \u0432\u044b\u043d\u043e\u0441\u043b\u0438\u0432\u043e\u0441\u0442\u044c. \u0415\u0434\u0430 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u043e\u0431\u0430, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0432\u0430\u0436\u043d\u043e \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044c \u0441\u0442\u0430\u0431\u0438\u043b\u044c\u043d\u044b\u0439 \u0437\u0430\u043f\u0430\u0441. \u0428\u0410\u0413 1: \u041e\u0445\u043e\u0442\u044c\u0442\u0435\u0441\u044c \u043d\u0430 \u0436\u0438\u0432\u043e\u0442\u043d\u044b\u0445 \u0438\u043b\u0438 \u0432\u044b\u0440\u0430\u0449\u0438\u0432\u0430\u0439\u0442\u0435 \u0443\u0440\u043e\u0436\u0430\u0439 \u0434\u043b\u044f \u0435\u0434\u044b. \u0428\u0410\u0413 2: \u0413\u043e\u0442\u043e\u0432\u044c\u0442\u0435 \u0441\u044b\u0440\u0443\u044e \u0435\u0434\u0443 \u043d\u0430 \u043a\u043e\u0441\u0442\u0440\u0435, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0432\u044b\u0441\u0438\u0442\u044c \u0435\u0451 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c. \u0428\u0410\u0413 3: \u0425\u0440\u0430\u043d\u0438\u0442\u0435 \u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u043d\u0443\u044e \u043f\u0438\u0449\u0443 \u0432 \u0441\u0443\u043d\u0434\u0443\u043a\u0430\u0445 \u043d\u0430 \u0441\u043b\u0443\u0447\u0430\u0439 \u043d\u0435\u043f\u0440\u0435\u0434\u0432\u0438\u0434\u0435\u043d\u043d\u044b\u0445 \u043e\u0431\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u0441\u0442\u0432. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u043d\u043e\u0435 \u043c\u044f\u0441\u043e \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u0431\u043e\u043b\u044c\u0448\u0435 \u0433\u043e\u043b\u043e\u0434\u0430, \u0447\u0435\u043c \u0441\u044b\u0440\u043e\u0435 \u043c\u044f\u0441\u043e. [\u0422\u0430\u0431\u043b\u0438\u0446\u0430 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044f: \u0422\u0438\u043f\u044b \u0435\u0434\u044b: \u0421\u044b\u0440\u043e\u0435 \u043c\u044f\u0441\u043e (\u043d\u0438\u0437\u043a\u043e\u0435) \u043f\u0440\u043e\u0442\u0438\u0432 \u041f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u043c\u044f\u0441\u0430 (\u0432\u044b\u0441\u043e\u043a\u043e\u0435).]"}, {"question": "\u041a\u0430\u043a\u0438\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u044b\u0435 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u0438\u0433\u0440\u044b \u0432 Craftnite.io \u043d\u0430 \u0440\u0430\u0437\u043d\u044b\u0445 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430\u0445 \u0438 \u043a\u0430\u043a \u043e\u043d\u0438 \u0441\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u044e\u0442\u0441\u044f?", "answer": "\u0421\u0438\u0441\u0442\u0435\u043c\u043d\u044b\u0435 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f Craftnite.io \u0440\u0430\u0437\u043b\u0438\u0447\u0430\u044e\u0442\u0441\u044f \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0442 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u044b. \u041d\u0430 \u041f\u041a \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0441\u0440\u0435\u0434\u043d\u0438\u0439 \u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0440, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, GTX 1050, \u0438 8 \u0413\u0411 \u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0439 \u043f\u0430\u043c\u044f\u0442\u0438. \u041d\u0430 \u043c\u043e\u0431\u0438\u043b\u044c\u043d\u044b\u0445 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430\u0445 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0442 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430 \u0441 \u043a\u0430\u043a \u043c\u0438\u043d\u0438\u043c\u0443\u043c 3 \u0413\u0411 \u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0439 \u043f\u0430\u043c\u044f\u0442\u0438 \u0438 Android 8.0 \u0438\u043b\u0438 iOS 11. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0438\u0433\u0440\u0430 \u043d\u0430 \u043c\u043e\u0449\u043d\u043e\u043c \u041f\u041a \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0431\u043e\u043b\u0435\u0435 \u0432\u044b\u0441\u043e\u043a\u0443\u044e \u0433\u0440\u0430\u0444\u0438\u043a\u0443 \u0438 \u0431\u043e\u043b\u0435\u0435 \u043f\u043b\u0430\u0432\u043d\u0443\u044e \u0438\u0433\u0440\u0443 \u043f\u043e \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044e \u0441 \u043c\u043e\u0431\u0438\u043b\u044c\u043d\u044b\u043c\u0438 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430\u043c\u0438. [\u0422\u0430\u0431\u043b\u0438\u0446\u0430 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044f: \u0422\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f \u043a \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0435: \u041f\u041a (GTX 1050, 8 \u0413\u0411 \u041e\u0417\u0423) \u043f\u0440\u043e\u0442\u0438\u0432 \u041c\u043e\u0431\u0438\u043b\u044c\u043d\u043e\u0433\u043e (3 \u0413\u0411 \u041e\u0417\u0423, Android 8.0/iOS 11).]"}, {"question": "\u041a\u0430\u043a \u0438\u0433\u0440\u043e\u043a\u0438 \u043c\u043e\u0433\u0443\u0442 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0442\u0438 \u0441\u0432\u043e\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441 \u0432 Craftnite.io \u0441 \u043e\u0434\u043d\u043e\u0439 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u044b \u043d\u0430 \u0434\u0440\u0443\u0433\u0443\u044e \u0431\u0435\u0437 \u043f\u043e\u0442\u0435\u0440\u0438 \u0434\u0430\u043d\u043d\u044b\u0445?", "answer": "\u0427\u0442\u043e\u0431\u044b \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0442\u0438 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441 \u0432 Craftnite.io, \u0438\u0433\u0440\u043e\u043a\u0438 \u0434\u043e\u043b\u0436\u043d\u044b \u0441\u0432\u044f\u0437\u0430\u0442\u044c \u0441\u0432\u043e\u044e \u0443\u0447\u0451\u0442\u043d\u0443\u044e \u0437\u0430\u043f\u0438\u0441\u044c \u0441 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u044b\u043c \u043f\u0440\u043e\u0444\u0438\u043b\u0435\u043c. \u0428\u0410\u0413 1: \u0421\u043e\u0437\u0434\u0430\u0439\u0442\u0435 \u0443\u0447\u0451\u0442\u043d\u0443\u044e \u0437\u0430\u043f\u0438\u0441\u044c \u043d\u0430 \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u043c \u0441\u0430\u0439\u0442\u0435 Craftnite.io. \u0428\u0410\u0413 2: \u0421\u0432\u044f\u0436\u0438\u0442\u0435 \u0441\u0432\u043e\u044e \u0442\u0435\u043a\u0443\u0449\u0443\u044e \u0443\u0447\u0451\u0442\u043d\u0443\u044e \u0437\u0430\u043f\u0438\u0441\u044c \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u044b \u0441 \u044d\u0442\u0438\u043c \u043f\u0440\u043e\u0444\u0438\u043b\u0435\u043c. \u0428\u0410\u0413 3: \u0412\u043e\u0439\u0434\u0438\u0442\u0435 \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0441 \u0442\u0435\u043c \u0436\u0435 \u043f\u0440\u043e\u0444\u0438\u043b\u0435\u043c \u043d\u0430 \u043d\u043e\u0432\u043e\u0439 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0435. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043f\u0440\u0438\u0432\u044f\u0437\u043a\u0430 \u0443\u0447\u0451\u0442\u043d\u043e\u0439 \u0437\u0430\u043f\u0438\u0441\u0438 \u041f\u041a \u043a \u043c\u043e\u0431\u0438\u043b\u044c\u043d\u043e\u043c\u0443 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0443 \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0431\u0435\u0441\u043f\u0440\u043e\u0431\u043b\u0435\u043c\u043d\u0443\u044e \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0443 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0430. [\u0421\u0445\u0435\u043c\u0430 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430 \u043c\u0438\u0433\u0440\u0430\u0446\u0438\u0438: \u0421\u043e\u0437\u0434\u0430\u0442\u044c \u0443\u0447\u0451\u0442\u043d\u0443\u044e \u0437\u0430\u043f\u0438\u0441\u044c \u2192 \u041f\u0440\u0438\u0432\u044f\u0437\u0430\u0442\u044c \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0443 \u2192 \u0412\u043e\u0439\u0442\u0438 \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u043d\u0430 \u043d\u043e\u0432\u043e\u043c \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0435.]"}, {"question": "\u041a\u0430\u043a\u0438\u0435 \u0441\u043a\u0440\u044b\u0442\u044b\u0435 \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u044b\u0435 \u044f\u0439\u0446\u0430 \u043c\u043e\u0433\u0443\u0442 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0438\u0442\u044c \u0438\u0433\u0440\u043e\u043a\u0438 \u0432 Craftnite.io \u0438 \u0433\u0434\u0435 \u043e\u043d\u0438 \u043e\u0431\u044b\u0447\u043d\u043e \u043d\u0430\u0445\u043e\u0434\u044f\u0442\u0441\u044f?", "answer": "\u0412 Craftnite.io \u043f\u043e\u043b\u043d\u043e \u0441\u043a\u0440\u044b\u0442\u044b\u0445 \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u044b\u0445 \u044f\u0438\u0446, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u043e\u0437\u043d\u0430\u0433\u0440\u0430\u0436\u0434\u0430\u044e\u0442 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435. \u041e\u0434\u043d\u043e \u0438\u0437 \u0437\u0430\u043c\u0435\u0442\u043d\u044b\u0445 \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u044b\u0445 \u044f\u0438\u0446 \u2014 \u00ab\u0417\u043e\u043b\u043e\u0442\u043e\u0435 \u0446\u044b\u043f\u043b\u0451\u043d\u043e\u043a\u00bb, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043c\u043e\u0436\u043d\u043e \u043d\u0430\u0439\u0442\u0438 \u0432 \u0443\u0434\u0430\u043b\u0451\u043d\u043d\u044b\u0445 \u043b\u0435\u0441\u043d\u044b\u0445 \u0431\u0438\u043e\u043c\u0430\u0445. \u041a\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u0435 \u0435\u0433\u043e \u0437\u043e\u043b\u043e\u0442\u044b\u043c\u0438 \u0441\u0435\u043c\u0435\u043d\u0430\u043c\u0438 \u0434\u0430\u0451\u0442 \u0440\u0435\u0434\u043a\u0438\u0435 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0417\u043e\u043b\u043e\u0442\u043e\u0433\u043e \u0446\u044b\u043f\u043b\u0451\u043d\u043a\u0430 \u043c\u043e\u0436\u0435\u0442 \u043f\u043e\u0434\u0430\u0440\u0438\u0442\u044c \u0432\u0430\u043c \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u0437\u043e\u043b\u043e\u0442\u043e\u0439 \u0442\u043e\u043f\u043e\u0440. [\u041f\u0440\u0438\u043c\u0435\u0440: \u041f\u043e\u0438\u0441\u043a \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u044b\u0445 \u044f\u0438\u0446 \u043f\u043e\u0434\u043e\u0431\u0435\u043d \u00ab\u043f\u043e\u0438\u0441\u043a\u0443 \u0441\u043e\u043a\u0440\u043e\u0432\u0438\u0449\u00bb \u2014 \u043a\u0430\u0436\u0434\u043e\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u043f\u0440\u0438\u043d\u043e\u0441\u0438\u0442 \u043d\u0435\u043e\u0436\u0438\u0434\u0430\u043d\u043d\u044b\u0435 \u043d\u0430\u0433\u0440\u0430\u0434\u044b.]"}]
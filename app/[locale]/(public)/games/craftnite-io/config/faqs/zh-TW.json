[{"question": "\u5982\u4f55\u5728 Craftnite.io \u5feb\u901f\u4e0a\u624b\uff0c\u4ee5\u53ca\u7b2c\u4e00\u6b65\u8a72\u600e\u9ebc\u505a\uff1f", "answer": "\u5728 Craftnite.io \u65b0\u624b\u958b\u59cb\uff0c\u9996\u5148\u61c9\u5b8c\u6210\u6559\u5b78\uff0c\u6559\u5b78\u6703\u4ecb\u7d39\u57fa\u672c\u63a7\u5236\u548c\u904a\u6232\u6a5f\u5236\u3002\u6559\u5b78\u4e4b\u5f8c\uff0c\u6b65\u9a5f\u4e00\uff1a\u4f7f\u7528\u65a7\u982d\u548c\u93df\u5b50\u6536\u96c6\u6728\u6750\u548c\u77f3\u982d\u7b49\u8cc7\u6e90\u3002\u6b65\u9a5f\u4e8c\uff1a\u5728\u5de5\u4f5c\u53f0\u88fd\u4f5c\u5fc5\u8981\u7684\u5de5\u5177\u548c\u6b66\u5668\u3002\u6b65\u9a5f\u4e09\uff1a\u5efa\u9020\u7c21\u55ae\u7684\u5e87\u8b77\u6240\u4ee5\u62b5\u79a6\u6575\u4eba\u3002\u4f8b\u5982\uff0c\u88fd\u4f5c\u6728\u528d\u548c\u76fe\u724c\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u4f60\u65e9\u671f\u904a\u6232\u7684\u751f\u5b58\u6a5f\u6703\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u4f60\u7684\u7b2c\u4e00\u500b\u5e87\u8b77\u6240\u60f3\u50cf\u6210\u300e\u5165\u9580\u5c0f\u5c4b\u300f\u2014\u5b83\u4e0d\u9700\u8981\u8c6a\u83ef\uff0c\u53ea\u9700\u8981\u5be6\u7528\u3002]"}, {"question": "\u5c0d\u65bc\u904a\u6232\u6642\u9593\u8d85\u904e 100 \u5c0f\u6642\u7684\u73a9\u5bb6\u4f86\u8aaa\uff0cCraftnite.io \u7684\u8cc7\u6e90\u7ba1\u7406\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u61c9\u5c08\u6ce8\u65bc\u6709\u6548\u7387\u7684\u8cc7\u6e90\u7ba1\u7406\u3002\u6b65\u9a5f\u4e00\uff1a\u5728\u63a1\u7926\u63a2\u96aa\u4e2d\u512a\u5148\u6536\u96c6\u7a00\u6709\u8cc7\u6e90\uff0c\u4f8b\u5982\u9ed1\u66dc\u77f3\u548c\u947d\u77f3\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u5148\u9032\u7684\u5de5\u85dd\u914d\u65b9\u4f86\u88fd\u4f5c\u9ad8\u968e\u7269\u54c1\uff0c\u4f8b\u5982\u9644\u9b54\u6b66\u5668\u548c\u76d4\u7532\u3002\u6b65\u9a5f\u4e09\uff1a\u5c07\u591a\u9918\u7684\u8cc7\u6e90\u5b58\u653e\u5728\u6709\u7d44\u7e54\u7684\u7bb1\u5b50\u88e1\uff0c\u4ee5\u4fdd\u6301\u5eab\u5b58\u7a7a\u9593\u3002\u4f8b\u5982\uff0c\u4fdd\u7559\u4e00\u500b\u5c08\u9580\u5b58\u653e\u5efa\u7bc9\u6750\u6599\u7684\u7bb1\u5b50\uff0c\u53ef\u4ee5\u5728\u5927\u578b\u5efa\u7bc9\u9805\u76ee\u4e2d\u7bc0\u7701\u6642\u9593\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u5e38\u7528\u8cc7\u6e90\u8207\u7a00\u6709\u8cc7\u6e90\uff1a\u6728\u6750 (\u5e38\u898b) \u5c0d\u6bd4 \u947d\u77f3 (\u7a00\u6709)\u3002]"}, {"question": "\u5728 Craftnite.io \u4e2d\uff0c\u70ba\u4ec0\u9ebc\u4e86\u89e3\u665d\u591c\u5faa\u74b0\u81f3\u95dc\u91cd\u8981\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u97ff\u904a\u6232\uff1f", "answer": "Craftnite.io \u4e2d\u7684\u665d\u591c\u5faa\u74b0\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6c7a\u5b9a\u4e86\u6575\u4eba\u7684\u751f\u6210\u7387\u548c\u8cc7\u6e90\u7684\u53ef\u7528\u6027\u3002\u767d\u5929\uff0c\u73a9\u5bb6\u53ef\u4ee5\u5b89\u5168\u5730\u6536\u96c6\u8cc7\u6e90\u548c\u5efa\u9020\u5efa\u7bc9\u7269\u3002\u665a\u4e0a\uff0c\u6575\u5c0d\u7684\u602a\u7269\uff0c\u4f8b\u5982\u6bad\u5c4d\u548c\u9ab7\u9acf\uff0c\u6703\u51fa\u73fe\uff0c\u56e0\u6b64\u64c1\u5099\u8db3\u5920\u7684\u9632\u79a6\u63aa\u65bd\u81f3\u95dc\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5728\u57fa\u5730\u5468\u570d\u5efa\u9020\u706b\u628a\u53ef\u4ee5\u9632\u6b62\u602a\u7269\u751f\u6210\uff0c\u78ba\u4fdd\u5b89\u5168\u3002[\u6bd4\u55bb\u8aaa\u660e: \u665d\u591c\u5faa\u74b0\u5c31\u50cf\u4e00\u500b\u300e\u8a08\u6642\u5668\u300f\u2014\u660e\u667a\u5730\u5229\u7528\u767d\u5929\u6642\u9593\u4f86\u6e96\u5099\u591c\u665a\u7684\u5371\u96aa\u3002]"}, {"question": "Craftnite.io \u7684\u88fd\u4f5c\u7cfb\u7d71\u8207\u5176\u4ed6\u751f\u5b58\u904a\u6232\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "Craftnite.io \u7684\u88fd\u4f5c\u7cfb\u7d71\u56e0\u5176\u7c21\u5316\u7684\u4ecb\u9762\u548c\u5373\u6642\u88fd\u4f5c\u6a5f\u5236\u800c\u7368\u7279\u3002\u8207\u5176\u4ed6\u904a\u6232\u4e0d\u540c\uff0cCraftnite.io \u5141\u8a31\u73a9\u5bb6\u5728\u884c\u52d5\u4e2d\u88fd\u4f5c\u7269\u54c1\uff0c\u800c\u7121\u9700\u5c08\u9580\u7684\u88fd\u4f5c\u7ad9\u3002\u4f8b\u5982\uff0c\u88fd\u4f5c\u4e00\u6839\u57fa\u672c\u7684\u706b\u628a\u53ef\u4ee5\u76f4\u63a5\u5f9e\u80cc\u5305\u4e2d\u5b8c\u6210\uff0c\u4f7f\u5176\u66f4\u5feb\u3001\u66f4\u65b9\u4fbf\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: Craftnite.io \u7684\u88fd\u4f5c\u8207\u5176\u4ed6\u904a\u6232\u7684\u88fd\u4f5c\uff1a\u5373\u6642 (Craftnite.io) \u5c0d\u6bd4 \u57fa\u65bc\u5de5\u4f5c\u53f0 (\u5176\u4ed6)\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728 Craftnite.io \u4e2d\u6709\u6548\u5730\u4f7f\u7528\u5730\u5716\u529f\u80fd\u4f86\u589e\u5f37\u63a2\u7d22\uff1f", "answer": "Craftnite.io \u4e2d\u7684\u5730\u5716\u529f\u80fd\u5c0d\u65bc\u5c0e\u822a\u548c\u6230\u7565\u898f\u5283\u81f3\u95dc\u91cd\u8981\u3002\u6b65\u9a5f\u4e00\uff1a\u4f7f\u7528\u5730\u5716\u6a19\u8a18\u8cc7\u6e90\u8c50\u5bcc\u7684\u5730\u5340\u548c\u6575\u65b9\u71df\u5730\u3002\u6b65\u9a5f\u4e8c\uff1a\u898f\u5283\u63a2\u7d22\u8def\u7dda\uff0c\u907f\u514d\u5371\u96aa\u5340\u57df\u3002\u6b65\u9a5f\u4e09\uff1a\u5728\u591a\u4eba\u904a\u6232\u6a21\u5f0f\u4e0b\u8207\u968a\u53cb\u5206\u4eab\u5730\u5716\u6a19\u8a18\uff0c\u4ee5\u4fbf\u5354\u540c\u5408\u4f5c\u3002\u4f8b\u5982\uff0c\u6a19\u8a18\u4e00\u500b\u542b\u6709\u8cb4\u91cd\u7926\u7269\u7684\u6d1e\u7a74\u53ef\u4ee5\u5e6b\u52a9\u4f60\u7a0d\u5f8c\u8fd4\u56de\u3002[\u6d41\u7a0b\u5716\u89e3: \u5730\u5716\u4f7f\u7528\u6d41\u7a0b\uff1a\u6253\u958b\u5730\u5716 \u2192 \u6a19\u8a18\u4f4d\u7f6e \u2192 \u898f\u5283\u8def\u7dda\u3002]"}, {"question": "\u5728 Craftnite.io \u4e2d\uff0c\u5982\u4f55\u6709\u6548\u9632\u79a6\u8972\u64ca\uff0c\u73a9\u5bb6\u61c9\u8a72\u6e96\u5099\u4ec0\u9ebc\uff1f", "answer": "\u9632\u79a6\u8972\u64ca\u9700\u8981\u6e96\u5099\u548c\u7b56\u7565\u3002\u6b65\u9a5f\u4e00\uff1a\u5728\u57fa\u5730\u5468\u570d\u5efa\u9020\u52a0\u56fa\u7684\u7246\u58c1\u548c\u9677\u9631\u3002\u6b65\u9a5f\u4e8c\uff1a\u5728\u8972\u64ca\u671f\u9593\u5feb\u901f\u53d6\u5f97\u6b66\u5668\u548c\u6cbb\u7642\u7269\u54c1\u3002\u6b65\u9a5f\u4e09\uff1a\u8207\u968a\u53cb\u5354\u8abf\uff0c\u8986\u84cb\u6240\u6709\u5165\u53e3\u3002\u4f8b\u5982\uff0c\u5728\u57fa\u5730\u5165\u53e3\u8655\u653e\u7f6e\u91d8\u523a\u9677\u9631\u53ef\u4ee5\u963b\u6b62\u8972\u64ca\u8005\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u9632\u79a6\u7b56\u7565\uff1a\u9677\u9631\u8207\u52a0\u56fa\u7684\u7246\u58c1\u2014\u9019\u5169\u7a2e\u90fd\u662f\u5e73\u8861\u9632\u79a6\u4e0d\u53ef\u6216\u7f3a\u7684\u5143\u7d20\u3002]"}, {"question": "Craftnite.io \u7684\u98e2\u9913\u6a5f\u5236\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u4ee5\u53ca\u6700\u4f73\u7684\u7ba1\u7406\u65b9\u5f0f\u662f\u4ec0\u9ebc\uff1f", "answer": "Craftnite.io \u4e2d\u7684\u98e2\u9913\u6a5f\u5236\u6703\u5f71\u97ff\u4f60\u7684\u5065\u5eb7\u548c\u9ad4\u529b\u3002\u98f2\u98df\u53ef\u4ee5\u88dc\u5145\u5169\u8005\uff0c\u56e0\u6b64\u7dad\u6301\u7a69\u5b9a\u7684\u98df\u7269\u4f9b\u61c9\u81f3\u95dc\u91cd\u8981\u3002\u6b65\u9a5f\u4e00\uff1a\u72e9\u7375\u52d5\u7269\u6216\u7a2e\u690d\u4f5c\u7269\u7372\u5f97\u98df\u7269\u3002\u6b65\u9a5f\u4e8c\uff1a\u5728\u71df\u706b\u4e2d\u70f9\u98ea\u751f\u98df\u4ee5\u63d0\u9ad8\u5176\u6548\u679c\u3002\u6b65\u9a5f\u4e09\uff1a\u5c07\u719f\u98df\u5132\u5b58\u5728\u7bb1\u5b50\u88e1\u4ee5\u5099\u7dca\u6025\u60c5\u6cc1\u3002\u4f8b\u5982\uff0c\u719f\u8089\u6bd4\u751f\u8089\u63d0\u4f9b\u66f4\u591a\u7684\u98e2\u9913\u6062\u5fa9\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u98df\u7269\u985e\u578b\uff1a\u751f\u8089 (\u4f4e) \u5c0d\u6bd4 \u719f\u8089 (\u9ad8)\u3002]"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u904a\u73a9 Craftnite.io \u7684\u7cfb\u7d71\u9700\u6c42\u70ba\u4f55\uff0c\u4ee5\u53ca\u5b83\u5011\u4e4b\u9593\u7684\u6bd4\u8f03\uff1f", "answer": "Craftnite.io \u7684\u7cfb\u7d71\u9700\u6c42\u56e0\u5e73\u53f0\u800c\u7570\u3002\u5728\u96fb\u8166\u4e0a\uff0c\u5efa\u8b70\u4f7f\u7528 GTX 1050 \u7b49\u4e2d\u7aef\u986f\u793a\u5361\u548c 8GB \u8a18\u61b6\u9ad4\u3002\u5728\u624b\u6a5f\u4e0a\uff0c\u5efa\u8b70\u4f7f\u7528\u81f3\u5c11 3GB \u8a18\u61b6\u9ad4\u7684\u88dd\u7f6e\u4ee5\u53ca Android 8.0 \u6216 iOS 11\u3002\u4f8b\u5982\uff0c\u5728\u9ad8\u968e\u96fb\u8166\u4e0a\u904a\u6232\u53ef\u4ee5\u63d0\u4f9b\u66f4\u597d\u7684\u5716\u5f62\u548c\u66f4\u6d41\u66a2\u7684\u904a\u6232\u9ad4\u9a57\uff0c\u8207\u624b\u6a5f\u76f8\u6bd4\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u5e73\u53f0\u9700\u6c42\uff1a\u96fb\u8166 (GTX 1050\uff0c8GB RAM) \u5c0d\u6bd4 \u624b\u6a5f (3GB RAM\uff0cAndroid 8.0/iOS 11)\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5c07 Craftnite.io \u7684\u9032\u5ea6\u5f9e\u4e00\u500b\u5e73\u53f0\u9077\u79fb\u5230\u53e6\u4e00\u500b\u5e73\u53f0\uff0c\u800c\u4e0d\u6703\u907a\u5931\u6578\u64da\uff1f", "answer": "\u8981\u9077\u79fb Craftnite.io \u7684\u9032\u5ea6\uff0c\u73a9\u5bb6\u5fc5\u9808\u5c07\u5e33\u6236\u9023\u7d50\u81f3\u901a\u7528\u500b\u4eba\u6a94\u6848\u3002\u6b65\u9a5f\u4e00\uff1a\u5728\u5b98\u65b9 Craftnite.io \u7db2\u7ad9\u4e0a\u5efa\u7acb\u5e33\u6236\u3002\u6b65\u9a5f\u4e8c\uff1a\u5c07\u4f60\u76ee\u524d\u5e73\u53f0\u7684\u5e33\u6236\u9023\u7d50\u5230\u6b64\u500b\u4eba\u6a94\u6848\u3002\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u76f8\u540c\u7684\u500b\u4eba\u6a94\u6848\u767b\u5165\u65b0\u5e73\u53f0\u3002\u4f8b\u5982\uff0c\u5c07\u4f60\u7684\u96fb\u8166\u5e33\u6236\u9023\u7d50\u5230\u4f60\u7684\u624b\u6a5f\u88dd\u7f6e\uff0c\u78ba\u4fdd\u7121\u7e2b\u7684\u9032\u5ea6\u8f49\u79fb\u3002[\u6d41\u7a0b\u5716\u89e3: \u9077\u79fb\u6d41\u7a0b\uff1a\u5efa\u7acb\u5e33\u6236 \u2192 \u9023\u7d50\u5e73\u53f0 \u2192 \u5728\u65b0\u88dd\u7f6e\u767b\u5165\u3002]"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728 Craftnite.io \u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\uff0c\u4ee5\u53ca\u5b83\u5011\u901a\u5e38\u5728\u54ea\u88e1\u767c\u73fe\uff1f", "answer": "Craftnite.io \u5145\u6eff\u4e86\u96b1\u85cf\u7684\u5f69\u86cb\uff0c\u734e\u52f5\u63a2\u7d22\u3002\u4e00\u500b\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\u300e\u91d1\u96de\u300f\uff0c\u5b83\u53ef\u4ee5\u88ab\u767c\u73fe\u65bc\u504f\u9060\u7684\u68ee\u6797\u751f\u7269\u7fa4\u7cfb\u3002\u9935\u98df\u91d1\u96de\u91d1\u7a2e\u5b50\u53ef\u7372\u5f97\u7a00\u6709\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u767c\u73fe\u91d1\u96de\u53ef\u4ee5\u734e\u52f5\u4f60\u4e00\u628a\u7368\u7279\u7684\u91d1\u65a7\u982d\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c0b\u627e\u5f69\u86cb\u5c31\u50cf\u300e\u5c0b\u5bf6\u300f\u2014\u6bcf\u6b21\u767c\u73fe\u90fd\u80fd\u5e36\u4f86\u610f\u60f3\u4e0d\u5230\u7684\u734e\u52f5\u3002]"}]
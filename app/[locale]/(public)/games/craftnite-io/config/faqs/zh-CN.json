[{"question": "Craftnite.io\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u5feb\u901f\u4e0a\u624b\uff0c\u4ee5\u53ca\u7b2c\u4e00\u6b65\u5e94\u8be5\u600e\u4e48\u505a\uff1f", "answer": "\u5728Craftnite.io\u4e2d\uff0c\u65b0\u73a9\u5bb6\u5e94\u9996\u5148\u5b8c\u6210\u6559\u7a0b\uff0c\u6559\u7a0b\u4ecb\u7ecd\u4e86\u57fa\u672c\u63a7\u4ef6\u548c\u673a\u5236\u3002\u6559\u7a0b\u5b8c\u6210\u540e\uff0c\u6b65\u9aa4\u4e00\uff1a\u4f7f\u7528\u65a7\u5934\u548c\u9550\u5934\u6536\u96c6\u6728\u6750\u548c\u77f3\u5934\u7b49\u8d44\u6e90\u3002\u6b65\u9aa4\u4e8c\uff1a\u5728\u5de5\u4f5c\u53f0\u4e0a\u5236\u4f5c\u5fc5\u8981\u7684\u5de5\u5177\u548c\u6b66\u5668\u3002\u6b65\u9aa4\u4e09\uff1a\u5efa\u9020\u4e00\u4e2a\u7b80\u5355\u7684\u5e87\u62a4\u6240\u6765\u62b5\u5fa1\u654c\u4eba\u3002\u4f8b\u5982\uff0c\u5236\u4f5c\u6728\u5251\u548c\u76fe\u724c\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u5728\u6e38\u620f\u521d\u671f\u751f\u5b58\u7684\u673a\u4f1a\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u4f60\u7684\u7b2c\u4e00\u4e2a\u5e87\u62a4\u6240\u60f3\u8c61\u6210\u4e00\u4e2a'\u5165\u95e8\u7ea7\u623f\u5c4b'\u2014\u2014\u5b83\u4e0d\u9700\u8981\u534e\u4e3d\uff0c\u53ea\u9700\u8981\u5b9e\u7528\u3002]"}, {"question": "\u5bf9\u4e8e\u5df2\u7ecf\u73a9\u8fc7Craftnite.io\u8d85\u8fc7100\u5c0f\u65f6\u7684\u73a9\u5bb6\u6765\u8bf4\uff0c\u5728\u6e38\u620f\u4e2d\u8fdb\u884c\u8d44\u6e90\u7ba1\u7406\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u5e94\u4e13\u6ce8\u4e8e\u9ad8\u6548\u7684\u8d44\u6e90\u7ba1\u7406\u3002\u6b65\u9aa4\u4e00\uff1a\u5728\u91c7\u77ff\u63a2\u9669\u4e2d\u4f18\u5148\u6536\u96c6\u7f55\u89c1\u7684\u8d44\u6e90\uff0c\u4f8b\u5982\u9ed1\u66dc\u77f3\u548c\u94bb\u77f3\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u9ad8\u7ea7\u914d\u65b9\u5236\u4f5c\u9ad8\u7ea7\u7269\u54c1\uff0c\u4f8b\u5982\u9644\u9b54\u6b66\u5668\u548c\u76d4\u7532\u3002\u6b65\u9aa4\u4e09\uff1a\u5c06\u591a\u4f59\u7684\u8d44\u6e90\u5b58\u653e\u5728\u6709\u7ec4\u7ec7\u7684\u7bb1\u5b50\u91cc\uff0c\u4ee5\u4fdd\u6301\u5e93\u5b58\u7a7a\u95f4\u3002\u4f8b\u5982\uff0c\u4e3a\u5efa\u7b51\u6750\u6599\u4fdd\u7559\u4e00\u4e2a\u4e13\u95e8\u7684\u7bb1\u5b50\uff0c\u53ef\u4ee5\u5728\u5927\u578b\u5efa\u9020\u9879\u76ee\u4e2d\u8282\u7701\u65f6\u95f4\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u666e\u901a\u8d44\u6e90\u4e0e\u7a00\u6709\u8d44\u6e90\uff1a\u6728\u6750\uff08\u666e\u901a\uff09\u4e0e\u94bb\u77f3\uff08\u7a00\u6709\uff09\u3002]"}, {"question": "\u5728Craftnite.io\u4e2d\uff0c\u4e3a\u4ec0\u4e48\u7406\u89e3\u663c\u591c\u5faa\u73af\u81f3\u5173\u91cd\u8981\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\uff1f", "answer": "Craftnite.io\u4e2d\u7684\u663c\u591c\u5faa\u73af\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u51b3\u5b9a\u4e86\u602a\u7269\u7684\u751f\u6210\u7387\u548c\u8d44\u6e90\u7684\u53ef\u7528\u6027\u3002\u767d\u5929\uff0c\u73a9\u5bb6\u53ef\u4ee5\u5b89\u5168\u5730\u6536\u96c6\u8d44\u6e90\u548c\u5efa\u9020\u5efa\u7b51\u3002\u665a\u4e0a\uff0c\u654c\u5bf9\u7684\u602a\u7269\uff0c\u4f8b\u5982\u50f5\u5c38\u548c\u9ab7\u9ac5\u4f1a\u51fa\u73b0\uff0c\u56e0\u6b64\u62e5\u6709\u8db3\u591f\u7684\u9632\u5fa1\u63aa\u65bd\u81f3\u5173\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5728\u57fa\u5730\u5468\u56f4\u5efa\u9020\u706b\u628a\u53ef\u4ee5\u9632\u6b62\u602a\u7269\u751f\u6210\u5e76\u786e\u4fdd\u5b89\u5168\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u663c\u591c\u5faa\u73af\u5c31\u50cf\u4e00\u4e2a\u2018\u8ba1\u65f6\u5668\u2019\u2014\u2014\u660e\u667a\u5730\u5229\u7528\u767d\u5929\u6765\u51c6\u5907\u591c\u665a\u7684\u5371\u9669\u3002]"}, {"question": "Craftnite.io\u7684\u5236\u4f5c\u7cfb\u7edf\u4e0e\u5176\u4ed6\u751f\u5b58\u6e38\u620f\u7684\u4e3b\u8981\u533a\u522b\u662f\u4ec0\u4e48\uff1f", "answer": "Craftnite.io\u7684\u5236\u4f5c\u7cfb\u7edf\u7531\u4e8e\u5176\u7b80\u5316\u7684\u754c\u9762\u548c\u5b9e\u65f6\u5236\u4f5c\u673a\u5236\u800c\u72ec\u5177\u7279\u8272\u3002\u4e0e\u5176\u4ed6\u6e38\u620f\u4e0d\u540c\uff0cCraftnite.io\u5141\u8bb8\u73a9\u5bb6\u5728\u65e0\u9700\u4e13\u7528\u5236\u4f5c\u53f0\u7684\u60c5\u51b5\u4e0b\u968f\u65f6\u5236\u4f5c\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5236\u4f5c\u4e00\u4e2a\u57fa\u672c\u7684\u706b\u628a\u53ef\u4ee5\u76f4\u63a5\u4ece\u5e93\u5b58\u4e2d\u5b8c\u6210\uff0c\u4f7f\u5176\u66f4\u5feb\u3001\u66f4\u65b9\u4fbf\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1aCraftnite.io\u4e2d\u7684\u5236\u4f5c\u4e0e\u5176\u4ed6\u6e38\u620f\uff1a\u5b9e\u65f6\u5236\u4f5c\uff08Craftnite.io\uff09\u4e0e\u57fa\u4e8e\u5de5\u4f5c\u53f0\u7684\u5236\u4f5c\uff08\u5176\u4ed6\u6e38\u620f\uff09\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728Craftnite.io\u4e2d\u6709\u6548\u5730\u4f7f\u7528\u5730\u56fe\u529f\u80fd\u6765\u589e\u5f3a\u63a2\u7d22\uff1f", "answer": "Craftnite.io\u4e2d\u7684\u5730\u56fe\u529f\u80fd\u5bf9\u4e8e\u5bfc\u822a\u548c\u6218\u7565\u89c4\u5212\u81f3\u5173\u91cd\u8981\u3002\u6b65\u9aa4\u4e00\uff1a\u4f7f\u7528\u5730\u56fe\u6807\u8bb0\u5bcc\u542b\u8d44\u6e90\u7684\u533a\u57df\u548c\u654c\u4eba\u7684\u8425\u5730\u3002\u6b65\u9aa4\u4e8c\uff1a\u89c4\u5212\u63a2\u7d22\u8def\u7ebf\uff0c\u907f\u514d\u5371\u9669\u533a\u57df\u3002\u6b65\u9aa4\u4e09\uff1a\u5728\u591a\u4eba\u6a21\u5f0f\u4e0b\u4e0e\u961f\u53cb\u5206\u4eab\u5730\u56fe\u6807\u8bb0\uff0c\u4ee5\u4fbf\u534f\u8c03\u884c\u52a8\u3002\u4f8b\u5982\uff0c\u6807\u8bb0\u4e00\u4e2a\u5305\u542b\u6709\u4ef7\u503c\u77ff\u8109\u7684\u6d1e\u7a74\uff0c\u53ef\u4ee5\u5e2e\u52a9\u4f60\u4ee5\u540e\u518d\u6b21\u56de\u5230\u90a3\u91cc\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u5730\u56fe\u4f7f\u7528\u6d41\u7a0b\uff1a\u6253\u5f00\u5730\u56fe \u2192 \u6807\u8bb0\u4f4d\u7f6e \u2192 \u89c4\u5212\u8def\u7ebf\u3002]"}, {"question": "\u5728Craftnite.io\u4e2d\uff0c\u6700\u6709\u6548\u7684\u9632\u5fa1\u7a81\u88ad\u65b9\u6cd5\u662f\u4ec0\u4e48\uff0c\u73a9\u5bb6\u5e94\u8be5\u51c6\u5907\u54ea\u4e9b\u4e1c\u897f\uff1f", "answer": "\u9632\u5fa1\u7a81\u88ad\u9700\u8981\u51c6\u5907\u548c\u7b56\u7565\u3002\u6b65\u9aa4\u4e00\uff1a\u5728\u57fa\u5730\u5468\u56f4\u5efa\u9020\u52a0\u56fa\u7684\u5899\u58c1\u548c\u9677\u9631\u3002\u6b65\u9aa4\u4e8c\uff1a\u56e4\u79ef\u6b66\u5668\u548c\u6cbb\u7597\u7269\u54c1\uff0c\u4ee5\u4fbf\u5728\u653b\u51fb\u53d1\u751f\u65f6\u5feb\u901f\u4f7f\u7528\u3002\u6b65\u9aa4\u4e09\uff1a\u4e0e\u961f\u53cb\u534f\u8c03\uff0c\u8986\u76d6\u6240\u6709\u5165\u53e3\u3002\u4f8b\u5982\uff0c\u5728\u57fa\u5730\u5165\u53e3\u5904\u653e\u7f6e\u5c16\u523a\u9677\u9631\u53ef\u4ee5\u963b\u6b62\u88ad\u51fb\u8005\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u9632\u5fa1\u7b56\u7565\uff1a\u9677\u9631\u4e0e\u52a0\u56fa\u7684\u5899\u58c1\u2014\u2014\u4e24\u8005\u5bf9\u4e8e\u5e73\u8861\u7684\u9632\u5fa1\u90fd\u662f\u5fc5\u4e0d\u53ef\u5c11\u7684\u3002]"}, {"question": "Craftnite.io\u4e2d\u7684\u9965\u997f\u673a\u5236\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u6700\u597d\u7684\u7ba1\u7406\u65b9\u6cd5\u662f\u4ec0\u4e48\uff1f", "answer": "Craftnite.io\u4e2d\u7684\u9965\u997f\u673a\u5236\u4f1a\u5f71\u54cd\u4f60\u7684\u5065\u5eb7\u548c\u4f53\u529b\u3002\u8fdb\u98df\u53ef\u4ee5\u8865\u5145\u4e24\u8005\uff0c\u6240\u4ee5\u4fdd\u6301\u7a33\u5b9a\u7684\u98df\u7269\u4f9b\u5e94\u81f3\u5173\u91cd\u8981\u3002\u6b65\u9aa4\u4e00\uff1a\u72e9\u730e\u52a8\u7269\u6216\u79cd\u690d\u4f5c\u7269\u83b7\u5f97\u98df\u7269\u3002\u6b65\u9aa4\u4e8c\uff1a\u5728\u8425\u706b\u4e0a\u70f9\u5236\u751f\u98df\u4ee5\u63d0\u9ad8\u5176\u6548\u679c\u3002\u6b65\u9aa4\u4e09\uff1a\u5c06\u719f\u98df\u5b58\u653e\u5728\u7bb1\u5b50\u91cc\u4ee5\u5907\u4e0d\u65f6\u4e4b\u9700\u3002\u4f8b\u5982\uff0c\u719f\u8089\u6bd4\u751f\u8089\u63d0\u4f9b\u7684\u9965\u997f\u6062\u590d\u66f4\u591a\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u98df\u7269\u7c7b\u578b\uff1a\u751f\u8089\uff08\u4f4e\uff09\u4e0e\u719f\u8089\uff08\u9ad8\uff09\u3002]"}, {"question": "\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e0a\u73a9Craftnite.io\u7684\u7cfb\u7edf\u8981\u6c42\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5b83\u4eec\u4e4b\u95f4\u6709\u4ec0\u4e48\u6bd4\u8f83\uff1f", "answer": "Craftnite.io\u7684\u7cfb\u7edf\u8981\u6c42\u56e0\u5e73\u53f0\u800c\u5f02\u3002\u5728PC\u4e0a\uff0c\u5efa\u8bae\u4f7f\u7528GTX 1050\u7b49\u4e2d\u6863\u663e\u5361\u548c8GB\u5185\u5b58\u3002\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\uff0c\u81f3\u5c113GB\u5185\u5b58\u548cAndroid 8.0\u6216iOS 11\u7684\u8bbe\u5907\u9002\u5408\u3002\u4f8b\u5982\uff0c\u5728\u9ad8\u6027\u80fdPC\u4e0a\u73a9\u6e38\u620f\u53ef\u4ee5\u83b7\u5f97\u66f4\u597d\u7684\u56fe\u5f62\u548c\u66f4\u6d41\u7545\u7684\u6e38\u620f\u4f53\u9a8c\uff0c\u4e0e\u624b\u673a\u6e38\u620f\u76f8\u6bd4\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u5e73\u53f0\u8981\u6c42\uff1aPC\uff08GTX 1050\uff0c8GB RAM\uff09\u4e0e\u79fb\u52a8\u8bbe\u5907\uff083GB RAM\uff0cAndroid 8.0/iOS 11\uff09\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5c06Craftnite.io\u7684\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u5e73\u53f0\u8fc1\u79fb\u5230\u53e6\u4e00\u4e2a\u5e73\u53f0\uff0c\u800c\u4e0d\u4f1a\u4e22\u5931\u6570\u636e\uff1f", "answer": "\u4e3a\u4e86\u8fc1\u79fbCraftnite.io\u7684\u8fdb\u5ea6\uff0c\u73a9\u5bb6\u5fc5\u987b\u5c06\u4ed6\u4eec\u7684\u5e10\u6237\u94fe\u63a5\u5230\u4e00\u4e2a\u901a\u7528\u7684\u4e2a\u4eba\u8d44\u6599\u3002\u6b65\u9aa4\u4e00\uff1a\u5728\u5b98\u65b9Craftnite.io\u7f51\u7ad9\u4e0a\u521b\u5efa\u4e00\u4e2a\u8d26\u6237\u3002\u6b65\u9aa4\u4e8c\uff1a\u5c06\u4f60\u5f53\u524d\u5e73\u53f0\u7684\u5e10\u6237\u94fe\u63a5\u5230\u8be5\u4e2a\u4eba\u8d44\u6599\u3002\u6b65\u9aa4\u4e09\uff1a\u5728\u65b0\u5e73\u53f0\u4e0a\u4f7f\u7528\u76f8\u540c\u7684\u4e2a\u4eba\u8d44\u6599\u767b\u5f55\u3002\u4f8b\u5982\uff0c\u5c06\u4f60\u7684PC\u5e10\u6237\u94fe\u63a5\u5230\u4f60\u7684\u79fb\u52a8\u8bbe\u5907\uff0c\u53ef\u4ee5\u786e\u4fdd\u65e0\u7f1d\u7684\u8fdb\u5ea6\u8fc1\u79fb\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u8fc1\u79fb\u6d41\u7a0b\uff1a\u521b\u5efa\u5e10\u6237 \u2192 \u94fe\u63a5\u5e73\u53f0 \u2192 \u5728\u65b0\u8bbe\u5907\u4e0a\u767b\u5f55\u3002]"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728Craftnite.io\u4e2d\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u7684\u5f69\u86cb\uff0c\u4ee5\u53ca\u5b83\u4eec\u901a\u5e38\u5728\u54ea\u91cc\u627e\u5230\uff1f", "answer": "Craftnite.io\u4e2d\u5145\u6ee1\u4e86\u9690\u85cf\u7684\u5f69\u86cb\uff0c\u63a2\u7d22\u8fd9\u4e9b\u5f69\u86cb\u53ef\u4ee5\u83b7\u5f97\u5956\u52b1\u3002\u4e00\u4e2a\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f'\u91d1\u9e21'\uff0c\u5b83\u53ef\u4ee5\u5728\u504f\u8fdc\u7684\u68ee\u6797\u751f\u7269\u7fa4\u843d\u4e2d\u627e\u5230\u3002\u7528\u91d1\u79cd\u5b50\u5582\u517b\u5b83\u53ef\u4ee5\u83b7\u5f97\u7a00\u6709\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u53d1\u73b0\u91d1\u9e21\u53ef\u4ee5\u4e3a\u4f60\u5956\u52b1\u4e00\u628a\u72ec\u7279\u7684\u91d1\u65a7\u5934\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5bfb\u627e\u5f69\u86cb\u5c31\u50cf'\u5bfb\u5b9d'\u2014\u2014\u6bcf\u4e00\u6b21\u53d1\u73b0\u90fd\u5e26\u6765\u610f\u60f3\u4e0d\u5230\u7684\u5956\u52b1\u3002]"}]
[{"question": "Craftnite.io \uac8c\uc784\uc5d0\uc11c \uc2e0\uaddc \ud50c\ub808\uc774\uc5b4\uac00 \ube60\ub974\uac8c \uc2dc\uc791\ud558\uace0 \uccab \ubc88\uc9f8 \ub2e8\uacc4\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Craftnite.io\uc5d0\uc11c \uc2dc\uc791\ud558\ub824\uba74 \uc2e0\uaddc \ud50c\ub808\uc774\uc5b4\ub294 \uba3c\uc800 \uae30\ubcf8 \ucee8\ud2b8\ub864 \ubc0f \uba54\ucee4\ub2c8\uc998\uc744 \uc18c\uac1c\ud558\ub294 \ud29c\ud1a0\ub9ac\uc5bc\uc744 \uc644\ub8cc\ud574\uc57c \ud569\ub2c8\ub2e4. \ud29c\ud1a0\ub9ac\uc5bc \ud6c4, STEP1: \ub3c4\ub07c\uc640 \uace1\uad2d\uc774\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub098\ubb34\uc640 \ub3cc\uacfc \uac19\uc740 \uc790\uc6d0\uc744 \uc218\uc9d1\ud569\ub2c8\ub2e4. STEP2: \uc81c\uc791\ub300\uc5d0\uc11c \ud544\uc218\uc801\uc778 \ub3c4\uad6c\uc640 \ubb34\uae30\ub97c \uc81c\uc791\ud569\ub2c8\ub2e4. STEP3: \uc801\uc5d0\uac8c\uc11c \ubcf4\ud638\ud558\uae30 \uc704\ud55c \ub2e8\uc21c\ud55c \ud53c\ub09c\ucc98\ub97c \uac74\uc124\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub098\ubb34 \uac80\uacfc \ubc29\ud328\ub97c \uc81c\uc791\ud558\uba74 \ucd08\uae30 \uac8c\uc784 \uc0dd\uc874 \uac00\ub2a5\uc131\uc744 \ud06c\uac8c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uccab \ubc88\uc9f8 \ud53c\ub09c\ucc98\ub97c '\ucd08\ubcf4 \uc8fc\ud0dd'\uc73c\ub85c \uc0dd\uac01\ud558\uc138\uc694. \ud654\ub824\ud560 \ud544\uc694\ub294 \uc5c6\uc9c0\ub9cc \uae30\ub2a5\uc801\uc774\uba74 \ub429\ub2c8\ub2e4.]"}, {"question": "100\uc2dc\uac04 \uc774\uc0c1 \uac8c\uc784\uc744 \uc990\uae34 Craftnite.io \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \uc790\uc6d0 \uad00\ub9ac \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uacbd\ud5d8\uc774 \ud48d\ubd80\ud55c \ud50c\ub808\uc774\uc5b4\ub294 \ud6a8\uc728\uc801\uc778 \uc790\uc6d0 \uad00\ub9ac\uc5d0 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. STEP1: \uad11\uc0b0 \ud0d0\ud5d8 \uc911 \ud751\uc694\uc11d\uacfc \ub2e4\uc774\uc544\ubaac\ub4dc\uc640 \uac19\uc740 \ud76c\uadc0 \uc790\uc6d0\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uc218\uc9d1\ud569\ub2c8\ub2e4. STEP2: \uace0\uae09 \uc81c\uc791 \ub808\uc2dc\ud53c\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub9c8\ubc95\uc774 \uac78\ub9b0 \ubb34\uae30\uc640 \uac11\uc637\uacfc \uac19\uc740 \uace0\uae09 \uc544\uc774\ud15c\uc744 \uc81c\uc791\ud569\ub2c8\ub2e4. STEP3: \uc815\ub9ac\ub41c \uc0c1\uc790\uc5d0 \uc5ec\ubd84\uc758 \uc790\uc6d0\uc744 \ubcf4\uad00\ud558\uc5ec \uc778\ubca4\ud1a0\ub9ac \uacf5\uac04\uc744 \uc720\uc9c0\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac74\ucd95 \uc790\uc7ac\ub97c \uc704\ud55c \uc804\uc6a9 \uc0c1\uc790\ub97c \ubcf4\uad00\ud558\uba74 \ub300\uaddc\ubaa8 \uac74\uc124 \ud504\ub85c\uc81d\ud2b8 \uc911 \uc2dc\uac04\uc744 \uc808\uc57d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \uc77c\ubc18 \uc790\uc6d0 \ub300 \ud76c\uadc0 \uc790\uc6d0: \ub098\ubb34(\uc77c\ubc18) \ub300 \ub2e4\uc774\uc544\ubaac\ub4dc(\ud76c\uadc0).]"}, {"question": "Craftnite.io\uc5d0\uc11c \uc8fc\uc57c\uc8fc\uae30 (day-night cycle)\ub97c \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "Craftnite.io\uc758 \uc8fc\uc57c\uc8fc\uae30\ub294 \uc801\uc758 \ucd9c\ud604\uc728\uacfc \uc790\uc6d0\uc758 \uacf5\uae09\ub7c9\uc744 \uc88c\uc6b0\ud558\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \ub0ae\uc5d0\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uc548\uc804\ud558\uac8c \uc790\uc6d0\uc744 \uc218\uc9d1\ud558\uace0 \uac74\ubb3c\uc744 \uc9c0\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubc24\uc5d0\ub294 \uc880\ube44\uc640 \uace8\ub818\uacfc \uac19\uc740 \uc801\ub300\uc801\uc778 \ubaac\uc2a4\ud130\uac00 \ub098\ud0c0\ub098 \uc801\uc808\ud55c \ubc29\uc5b4 \uc2dc\uc124\uc774 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uae30\uc9c0 \uc8fc\ubcc0\uc5d0 \ud683\ubd88\uc744 \uc124\uce58\ud558\uba74 \ubaac\uc2a4\ud130\uc758 \ucd9c\ud604\uc744 \ubc29\uc9c0\ud558\uace0 \uc548\uc804\uc744 \ud655\ubcf4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc8fc\uc57c\uc8fc\uae30\ub294 '\ud0c0\uc774\uba38'\uc640 \uac19\uc2b5\ub2c8\ub2e4. \ub0ae\uc758 \uc2dc\uac04\uc744 \ud604\uba85\ud558\uac8c \ud65c\uc6a9\ud558\uc5ec \ubc24\uc758 \uc704\ud5d8\uc5d0 \ub300\ube44\ud558\uc138\uc694.]"}, {"question": "Craftnite.io\uc758 \uc81c\uc791 \uc2dc\uc2a4\ud15c\uacfc \ub2e4\ub978 \uc11c\ubc14\uc774\ubc8c \uac8c\uc784\uc758 \uc81c\uc791 \uc2dc\uc2a4\ud15c\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Craftnite.io\uc758 \uc81c\uc791 \uc2dc\uc2a4\ud15c\uc740 \ub2e8\uc21c\ud654\ub41c \uc778\ud130\ud398\uc774\uc2a4\uc640 \uc2e4\uc2dc\uac04 \uc81c\uc791 \uba54\ucee4\ub2c8\uc998\uc73c\ub85c \uc778\ud574 \ub3c5\ud2b9\ud569\ub2c8\ub2e4. \ub2e4\ub978 \uac8c\uc784\uacfc \ub2ec\ub9ac Craftnite.io\ub294 \uc804\uc6a9 \uc81c\uc791 \uacf5\uac04 \uc5c6\uc774\ub3c4 \uc774\ub3d9 \uc911\uc5d0 \uc544\uc774\ud15c\uc744 \uc81c\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uae30\ubcf8 \ud683\ubd88\uc744 \uc81c\uc791\ud558\ub294 \uac83\uc740 \uc778\ubca4\ud1a0\ub9ac\uc5d0\uc11c \uc9c1\uc811 \uac00\ub2a5\ud558\uc5ec \ub354 \ube60\ub974\uace0 \ud3b8\ub9ac\ud569\ub2c8\ub2e4. [\ub2e4\uc911 \ube44\uad50: Craftnite.io\uc758 \uc81c\uc791 \ub300 \ub2e4\ub978 \uac8c\uc784\uc758 \uc81c\uc791: \uc2e4\uc2dc\uac04(Craftnite.io) \ub300 \uacf5\uac04 \uae30\ubc18(\ub2e4\ub978 \uac8c\uc784).]"}, {"question": "Craftnite.io\uc758 \uc9c0\ub3c4 \uae30\ub2a5\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc5ec \ud0d0\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Craftnite.io\uc758 \uc9c0\ub3c4 \uae30\ub2a5\uc740 \ud0d0\uc0c9 \ubc0f \uc804\ub7b5\uc801 \uacc4\ud68d\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. STEP1: \uc9c0\ub3c4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc790\uc6d0\uc774 \ud48d\ubd80\ud55c \uc9c0\uc5ed\uacfc \uc801 \uc9c4\uc601\uc744 \ud45c\uc2dc\ud569\ub2c8\ub2e4. STEP2: \uc704\ud5d8\ud55c \uc9c0\uc5ed\uc744 \ud53c\ud560 \uc218 \uc788\ub3c4\ub85d \ud0d0\ud5d8 \uacbd\ub85c\ub97c \uacc4\ud68d\ud569\ub2c8\ub2e4. STEP3: \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c \ud300\uc6d0\ub4e4\uacfc \uc9c0\ub3c4 \ud45c\uc2dc\ubb3c\uc744 \uacf5\uc720\ud558\uc5ec \ud611\ub825\uc801\uc778 \ub178\ub825\uc744 \uae30\uc6b8\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uadc0\uc911\ud55c \uad11\uc11d\uc774 \uc788\ub294 \ub3d9\uad74\uc744 \ud45c\uc2dc\ud558\uba74 \ub098\uc911\uc5d0 \uadf8\uacf3\uc73c\ub85c \ub3cc\uc544\uac08 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc9c0\ub3c4 \uc0ac\uc6a9 \ud750\ub984: \uc9c0\ub3c4 \uc5f4\uae30 \u2192 \uc704\uce58 \ud45c\uc2dc \u2192 \uacbd\ub85c \uacc4\ud68d.]"}, {"question": "Craftnite.io\uc5d0\uc11c \uc2b5\uaca9\uc5d0 \ud6a8\uacfc\uc801\uc73c\ub85c \ub300\uc751\ud558\uace0 \ud50c\ub808\uc774\uc5b4\ub294 \ubb34\uc5c7\uc744 \uc900\ube44\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\uc2b5\uaca9\uc5d0 \ub300\uc751\ud558\ub824\uba74 \uc900\ube44\uc640 \uc804\ub7b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \uae30\uc9c0 \uc8fc\ubcc0\uc5d0 \uac15\ud654\ub41c \ubcbd\uacfc \ud568\uc815\uc744 \uc124\uce58\ud569\ub2c8\ub2e4. STEP2: \uacf5\uaca9 \uc911 \ube60\ub978 \uc811\uadfc\uc744 \uc704\ud574 \ubb34\uae30\uc640 \uce58\uc720 \uc544\uc774\ud15c\uc744 \ube44\ucd95\ud569\ub2c8\ub2e4. STEP3: \ubaa8\ub4e0 \ucd9c\uc785\uad6c\ub97c \ucee4\ubc84\ud560 \uc218 \uc788\ub3c4\ub85d \ud300\uc6d0\ub4e4\uacfc \ud611\ub825\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uae30\uc9c0 \uc785\uad6c\uc5d0 \uac00\uc2dc \ud568\uc815\uc744 \uc124\uce58\ud558\uba74 \uc2b5\uaca9\uc790\ub4e4\uc744 \ub9c9\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc911 \ube44\uad50: \ubc29\uc5b4 \uc804\ub7b5: \ud568\uc815 \ub300 \uac15\ud654\ub41c \ubcbd - \ub458 \ub2e4 \uade0\ud615 \uc7a1\ud78c \ubc29\uc5b4\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4.]"}, {"question": "Craftnite.io\uc758 \ubc30\uace0\ud514 \uba54\ucee4\ub2c8\uc998\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \uc5b4\ub5bb\uac8c \uad00\ub9ac\ud558\ub294 \uac83\uc774 \uac00\uc7a5 \uc88b\uc2b5\ub2c8\uae4c?", "answer": "Craftnite.io\uc758 \ubc30\uace0\ud514 \uba54\ucee4\ub2c8\uc998\uc740 \uac74\uac15\uacfc \uccb4\ub825\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc74c\uc2dd\uc744 \uba39\uc73c\uba74 \ub458 \ub2e4 \ud68c\ubcf5\ub418\ubbc0\ub85c \uafb8\uc900\ud55c \uc74c\uc2dd \uacf5\uae09\uc744 \uc720\uc9c0\ud574\uc57c \ud569\ub2c8\ub2e4. STEP1: \ub3d9\ubb3c\uc744 \uc0ac\ub0e5\ud558\uac70\ub098 \ub18d\uc791\ubb3c\uc744 \uc7ac\ubc30\ud558\uc5ec \uc74c\uc2dd\uc744 \uc5bb\uc2b5\ub2c8\ub2e4. STEP2: \ucea0\ud504\ud30c\uc774\uc5b4\uc5d0\uc11c \ub0a0\uac83\uc758 \uc74c\uc2dd\uc744 \uc694\ub9ac\ud558\uc5ec \ud6a8\uacfc\ub97c \ub192\uc785\ub2c8\ub2e4. STEP3: \ube44\uc0c1\uc2dc\ub97c \ub300\ube44\ud558\uc5ec \uc694\ub9ac\ud55c \uc74c\uc2dd\uc744 \uc0c1\uc790\uc5d0 \ubcf4\uad00\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc694\ub9ac\ud55c \uace0\uae30\ub294 \ub0a0\uace0\uae30\ubcf4\ub2e4 \ubc30\uace0\ud514 \ud68c\ubcf5 \ud6a8\uacfc\uac00 \ub354 \ub192\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \uc2dd\ud488 \uc720\ud615: \ub0a0\uace0\uae30(\ub0ae\uc74c) \ub300 \uc694\ub9ac\ud55c \uace0\uae30(\ub192\uc74c).]"}, {"question": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c Craftnite.io\ub97c \ud50c\ub808\uc774\ud558\uae30 \uc704\ud55c \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \ube44\uad50\ub429\ub2c8\uae4c?", "answer": "Craftnite.io\uc758 \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc740 \ud50c\ub7ab\ud3fc\ubcc4\ub85c \ub2e4\ub985\ub2c8\ub2e4. PC\uc5d0\uc11c\ub294 GTX 1050\uacfc \uac19\uc740 \uc911\uae09 \uadf8\ub798\ud53d \uce74\ub4dc\uc640 8GB RAM\uc774 \uad8c\uc7a5\ub429\ub2c8\ub2e4. \ubaa8\ubc14\uc77c\uc5d0\uc11c\ub294 3GB RAM \uc774\uc0c1\uacfc \uc548\ub4dc\ub85c\uc774\ub4dc 8.0 \uc774\uc0c1 \ub610\ub294 iOS 11 \uc774\uc0c1\uc758 \uae30\uae30\uac00 \uc801\ud569\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uace0\uc131\ub2a5 PC\uc5d0\uc11c \ud50c\ub808\uc774\ud558\uba74 \ubaa8\ubc14\uc77c\ubcf4\ub2e4 \uadf8\ub798\ud53d\uc774 \ub354 \uc88b\uace0 \uac8c\uc784 \ud50c\ub808\uc774\uac00 \ub354 \uc6d0\ud65c\ud569\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \ud50c\ub7ab\ud3fc \uc694\uad6c \uc0ac\ud56d: PC(GTX 1050, 8GB RAM) \ub300 \ubaa8\ubc14\uc77c(3GB RAM, \uc548\ub4dc\ub85c\uc774\ub4dc 8.0/iOS 11).]"}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 \ub370\uc774\ud130 \uc190\uc2e4 \uc5c6\uc774 Craftnite.io\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uc5b4\ub5bb\uac8c \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Craftnite.io\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\ub824\uba74 \ud50c\ub808\uc774\uc5b4\ub294 \uacc4\uc815\uc744 \ubcf4\ud3b8\uc801\uc778 \ud504\ub85c\ud544\uc5d0 \uc5f0\uacb0\ud574\uc57c \ud569\ub2c8\ub2e4. STEP1: \uacf5\uc2dd Craftnite.io \uc6f9\uc0ac\uc774\ud2b8\uc5d0\uc11c \uacc4\uc815\uc744 \ub9cc\ub4ed\ub2c8\ub2e4. STEP2: \ud604\uc7ac \ud50c\ub7ab\ud3fc \uacc4\uc815\uc744 \uc774 \ud504\ub85c\ud544\uc5d0 \uc5f0\uacb0\ud569\ub2c8\ub2e4. STEP3: \uc0c8\ub85c\uc6b4 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub3d9\uc77c\ud55c \ud504\ub85c\ud544\ub85c \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC \uacc4\uc815\uc744 \ubaa8\ubc14\uc77c \uae30\uae30\uc5d0 \uc5f0\uacb0\ud558\uba74 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc6d0\ud65c\ud558\uac8c \uc804\ud658\ub429\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc774\uc804 \ud504\ub85c\uc138\uc2a4: \uacc4\uc815 \uc0dd\uc131 \u2192 \ud50c\ub7ab\ud3fc \uc5f0\uacb0 \u2192 \uc0c8\ub85c\uc6b4 \uc7a5\uce58\uc5d0\uc11c \ub85c\uadf8\uc778.]"}, {"question": "Craftnite.io\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130\uc5d0\uadf8\ub294 \ubb34\uc5c7\uc774\uba70 \uc77c\ubc18\uc801\uc73c\ub85c \uc5b4\ub514\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Craftnite.io\ub294 \ud0d0\ud5d8\uc744 \ubcf4\uc0c1\ud558\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130\uc5d0\uadf8\ub85c \uac00\ub4dd \ucc28 \uc788\uc2b5\ub2c8\ub2e4. \ub208\uc5d0 \ub744\ub294 \uc774\uc2a4\ud130\uc5d0\uadf8 \uc911 \ud558\ub098\ub294 \uc6d0\uaca9 \uc232 \uc0dd\ud0dc\uacc4\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\ub294 '\ud669\uae08 \ub2ed'\uc785\ub2c8\ub2e4. \ud669\uae08 \uc528\uc557\uc73c\ub85c \uba39\uc774\ub97c \uc8fc\uba74 \ud76c\uadc0 \uc544\uc774\ud15c\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud669\uae08 \ub2ed\uc744 \ubc1c\uacac\ud558\uba74 \ub3c5\ud2b9\ud55c \ud669\uae08 \ub3c4\ub07c\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc774\uc2a4\ud130\uc5d0\uadf8 \ucc3e\uae30\ub294 '\ubcf4\ubb3c \uc0ac\ub0e5'\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uac01 \ubc1c\uacac\uc740 \uc608\uae30\uce58 \ubabb\ud55c \ubcf4\uc0c1\uc744 \uac00\uc838\uc635\ub2c8\ub2e4.]"}]
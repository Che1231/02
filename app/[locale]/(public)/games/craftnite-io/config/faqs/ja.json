[{"question": "\u30af\u30e9\u30d5\u30c8\u30ca\u30a4\u30c8.io\u3067\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u8fc5\u901f\u306b\u59cb\u3081\u308b\u65b9\u6cd5\u3068\u3001\u6700\u521d\u306e\u30b9\u30c6\u30c3\u30d7\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30af\u30e9\u30d5\u30c8\u30ca\u30a4\u30c8.io\u3067\u59cb\u3081\u308b\u306b\u306f\u3001\u307e\u305a\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3092\u5b8c\u4e86\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3067\u306f\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3068\u30e1\u30ab\u30cb\u30ba\u30e0\u304c\u7d39\u4ecb\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u5f8c\u3001STEP1\uff1a\u65a7\u3068\u30d4\u30c3\u30b1\u30eb\u3092\u4f7f\u3063\u3066\u6728\u6750\u3084\u77f3\u306a\u3069\u306e\u8cc7\u6e90\u3092\u53ce\u96c6\u3059\u308b\u3002STEP2\uff1a\u30af\u30e9\u30d5\u30c8\u30c6\u30fc\u30d6\u30eb\u3067\u5fc5\u9808\u30c4\u30fc\u30eb\u3084\u6b66\u5668\u3092\u30af\u30e9\u30d5\u30c8\u3059\u308b\u3002STEP3\uff1a\u6575\u304b\u3089\u8eab\u3092\u5b88\u308b\u305f\u3081\u306e\u7c21\u5358\u306a\u30b7\u30a7\u30eb\u30bf\u30fc\u3092\u5efa\u9020\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u6728\u88fd\u306e\u5263\u3068\u76fe\u3092\u30af\u30e9\u30d5\u30c8\u3059\u308b\u3068\u3001\u521d\u671f\u30b2\u30fc\u30e0\u306e\u751f\u5b58\u7387\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002[\u4f8b\uff1a\u6700\u521d\u306e\u30b7\u30a7\u30eb\u30bf\u30fc\u3092\u300c\u30b9\u30bf\u30fc\u30c8\u30db\u30fc\u30e0\u300d\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u8c6a\u83ef\u306a\u3082\u306e\u3067\u306a\u304f\u3066\u3082\u6a5f\u80fd\u7684\u3067\u3042\u308c\u3070\u5341\u5206\u3067\u3059\u3002]"}, {"question": "100\u6642\u9593\u4ee5\u4e0a\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u7d4c\u9a13\u3092\u6301\u3064\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u3001\u30af\u30e9\u30d5\u30c8\u30ca\u30a4\u30c8.io\u306b\u304a\u3051\u308b\u8cc7\u6e90\u7ba1\u7406\u306e\u6700\u5584\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u7d4c\u9a13\u8c4a\u5bcc\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u52b9\u7387\u7684\u306a\u8cc7\u6e90\u7ba1\u7406\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002STEP1\uff1a\u63a1\u6398\u63a2\u691c\u4e2d\u306b\u30aa\u30d9\u30ed\u30f3\u3084\u30c0\u30a4\u30e4\u30e2\u30f3\u30c9\u306a\u3069\u306e\u5e0c\u5c11\u8cc7\u6e90\u3092\u512a\u5148\u7684\u306b\u53ce\u96c6\u3059\u308b\u3002STEP2\uff1a\u9ad8\u5ea6\u306a\u30af\u30e9\u30d5\u30c8\u30ec\u30b7\u30d4\u3092\u4f7f\u7528\u3057\u3066\u3001\u30a8\u30f3\u30c1\u30e3\u30f3\u30c8\u3055\u308c\u305f\u6b66\u5668\u3084\u30a2\u30fc\u30de\u30fc\u306a\u3069\u306e\u9ad8\u30e9\u30f3\u30af\u30a2\u30a4\u30c6\u30e0\u3092\u4f5c\u6210\u3059\u308b\u3002STEP3\uff1a\u4f59\u5270\u8cc7\u6e90\u3092\u6574\u7406\u3055\u308c\u305f\u30c1\u30a7\u30b9\u30c8\u306b\u4fdd\u7ba1\u3057\u3001\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u306e\u30b9\u30da\u30fc\u30b9\u3092\u7dad\u6301\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u5efa\u7bc9\u8cc7\u6750\u5c02\u7528\u306e\u30c1\u30a7\u30b9\u30c8\u3092\u8a2d\u3051\u308b\u3053\u3068\u3067\u3001\u5927\u898f\u6a21\u306a\u5efa\u8a2d\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u306e\u6642\u9593\u3092\u7bc0\u7d04\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03\u8868\uff1a\u4e00\u822c\u7684\u306a\u8cc7\u6e90\u3068\u5e0c\u5c11\u306a\u8cc7\u6e90\uff1a\u6728\u6750\uff08\u4e00\u822c\u7684\u306a\u8cc7\u6e90\uff09\u5bfe\u30c0\u30a4\u30e4\u30e2\u30f3\u30c9\uff08\u5e0c\u5c11\u306a\u8cc7\u6e90\uff09]"}, {"question": "\u30af\u30e9\u30d5\u30c8\u30ca\u30a4\u30c8.io\u3067\u663c\u591c\u306e\u30b5\u30a4\u30af\u30eb\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30af\u30e9\u30d5\u30c8\u30ca\u30a4\u30c8.io\u306e\u663c\u591c\u306e\u30b5\u30a4\u30af\u30eb\u306f\u3001\u6575\u306e\u51fa\u73fe\u7387\u3068\u8cc7\u6e90\u306e\u5165\u624b\u53ef\u80fd\u6027\u3092\u6c7a\u5b9a\u3059\u308b\u305f\u3081\u3001\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u663c\u9593\u306f\u3001\u5b89\u5168\u306b\u8cc7\u6e90\u3092\u53ce\u96c6\u3057\u3001\u69cb\u9020\u7269\u3092\u5efa\u8a2d\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u591c\u306b\u306a\u308b\u3068\u3001\u30be\u30f3\u30d3\u3084\u30b9\u30b1\u30eb\u30c8\u30f3\u306a\u3069\u306e\u6575\u5bfe\u7684\u306a\u30e2\u30d6\u304c\u51fa\u73fe\u3059\u308b\u305f\u3081\u3001\u5341\u5206\u306a\u9632\u5fa1\u304c\u5fc5\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u57fa\u5730\u306e\u5468\u308a\u306b\u305f\u3044\u307e\u3064\u3092\u5efa\u3066\u308b\u3053\u3068\u3067\u3001\u30e2\u30d6\u306e\u51fa\u73fe\u3092\u9632\u304e\u3001\u5b89\u5168\u3092\u78ba\u4fdd\u3067\u304d\u307e\u3059\u3002[\u4f8b\uff1a\u663c\u591c\u306e\u30b5\u30a4\u30af\u30eb\u306f\u300c\u30bf\u30a4\u30de\u30fc\u300d\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u663c\u9593\u3092\u8ce2\u304f\u5229\u7528\u3057\u3066\u3001\u591c\u9593\u306e\u5371\u967a\u306b\u5099\u3048\u307e\u3057\u3087\u3046\u3002]"}, {"question": "\u30af\u30e9\u30d5\u30c8\u30ca\u30a4\u30c8.io\u306e\u30af\u30e9\u30d5\u30c8\u30b7\u30b9\u30c6\u30e0\u3068\u4ed6\u306e\u30b5\u30d0\u30a4\u30d0\u30eb\u30b2\u30fc\u30e0\u306e\u30af\u30e9\u30d5\u30c8\u30b7\u30b9\u30c6\u30e0\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30af\u30e9\u30d5\u30c8\u30ca\u30a4\u30c8.io\u306e\u30af\u30e9\u30d5\u30c8\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u7c21\u7d20\u5316\u3055\u308c\u305f\u30a4\u30f3\u30bf\u30fc\u30d5\u30a7\u30fc\u30b9\u3068\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u306e\u30af\u30e9\u30d5\u30c8\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u3088\u308a\u72ec\u81ea\u3067\u3059\u3002\u4ed6\u306e\u30b2\u30fc\u30e0\u3068\u306f\u7570\u306a\u308a\u3001\u30af\u30e9\u30d5\u30c8\u30ca\u30a4\u30c8.io\u3067\u306f\u3001\u5c02\u7528\u306e\u30af\u30e9\u30d5\u30c8\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u3092\u5fc5\u8981\u3068\u305b\u305a\u306b\u3001\u30a2\u30a4\u30c6\u30e0\u3092\u305d\u306e\u5834\u3067\u30af\u30e9\u30d5\u30c8\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u57fa\u672c\u7684\u306a\u305f\u3044\u307e\u3064\u3092\u30af\u30e9\u30d5\u30c8\u3059\u308b\u306b\u306f\u3001\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u304b\u3089\u76f4\u63a5\u884c\u3046\u3053\u3068\u304c\u3067\u304d\u3001\u3088\u308a\u9ad8\u901f\u3067\u4fbf\u5229\u3067\u3059\u3002[\u6bd4\u8f03\u8868\uff1a\u30af\u30e9\u30d5\u30c8\u30ca\u30a4\u30c8.io\u3067\u306e\u30af\u30e9\u30d5\u30c8\u5bfe\u4ed6\u306e\u30b2\u30fc\u30e0\uff1a\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\uff08\u30af\u30e9\u30d5\u30c8\u30ca\u30a4\u30c8.io\uff09\u5bfe\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u30d9\u30fc\u30b9\uff08\u4ed6\u306e\u30b2\u30fc\u30e0\uff09]"}, {"question": "\u30af\u30e9\u30d5\u30c8\u30ca\u30a4\u30c8.io\u306e\u30de\u30c3\u30d7\u6a5f\u80fd\u3092\u52b9\u679c\u7684\u306b\u4f7f\u7528\u3057\u3066\u3001\u63a2\u7d22\u3092\u5f37\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30af\u30e9\u30d5\u30c8\u30ca\u30a4\u30c8.io\u306e\u30de\u30c3\u30d7\u6a5f\u80fd\u306f\u3001\u30ca\u30d3\u30b2\u30fc\u30b7\u30e7\u30f3\u3068\u6226\u7565\u7684\u8a08\u753b\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002STEP1\uff1a\u30de\u30c3\u30d7\u3092\u4f7f\u7528\u3057\u3066\u3001\u8cc7\u6e90\u8c4a\u5bcc\u306a\u5730\u57df\u3084\u6575\u306e\u30ad\u30e3\u30f3\u30d7\u5730\u3092\u30de\u30fc\u30af\u3059\u308b\u3002STEP2\uff1a\u5371\u967a\u306a\u30be\u30fc\u30f3\u3092\u907f\u3051\u308b\u305f\u3081\u306e\u63a2\u7d22\u30eb\u30fc\u30c8\u3092\u8a08\u753b\u3059\u308b\u3002STEP3\uff1a\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3067\u30c1\u30fc\u30e0\u30e1\u30a4\u30c8\u3068\u30de\u30c3\u30d7\u30de\u30fc\u30ab\u30fc\u3092\u5171\u6709\u3057\u3066\u3001\u9023\u643a\u3057\u305f\u6d3b\u52d5\u3092\u884c\u3046\u3002\u4f8b\u3048\u3070\u3001\u8cb4\u91cd\u306a\u9271\u77f3\u304c\u3042\u308b\u6d1e\u7a9f\u3092\u30de\u30fc\u30af\u3057\u3066\u304a\u3051\u3070\u3001\u5f8c\u3067\u623b\u3063\u3066\u63a2\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30de\u30c3\u30d7\u306e\u4f7f\u7528\u65b9\u6cd5\uff1a\u30de\u30c3\u30d7\u3092\u958b\u304f\u2192\u5834\u6240\u3092\u30de\u30fc\u30af\u3059\u308b\u2192\u30eb\u30fc\u30c8\u3092\u8a08\u753b\u3059\u308b\u3002]"}, {"question": "\u30af\u30e9\u30d5\u30c8\u30ca\u30a4\u30c8.io\u3067\u8972\u6483\u3092\u9632\u3050\u305f\u3081\u306b\u6700\u3082\u52b9\u679c\u7684\u306a\u65b9\u6cd5\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u4f55\u3092\u6e96\u5099\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u8972\u6483\u3092\u9632\u3050\u305f\u3081\u306b\u306f\u3001\u6e96\u5099\u3068\u6226\u7565\u304c\u5fc5\u8981\u3067\u3059\u3002STEP1\uff1a\u57fa\u5730\u306e\u5468\u56f2\u306b\u5f37\u5316\u3055\u308c\u305f\u58c1\u3068\u30c8\u30e9\u30c3\u30d7\u3092\u5efa\u9020\u3059\u308b\u3002STEP2\uff1a\u653b\u6483\u4e2d\u306b\u8fc5\u901f\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u3088\u3046\u306b\u3001\u6b66\u5668\u3068\u56de\u5fa9\u30a2\u30a4\u30c6\u30e0\u3092\u5099\u84c4\u3059\u308b\u3002STEP3\uff1a\u30c1\u30fc\u30e0\u30e1\u30a4\u30c8\u3068\u9023\u643a\u3057\u3066\u3001\u3059\u3079\u3066\u306e\u4fb5\u5165\u30dd\u30a4\u30f3\u30c8\u3092\u5b88\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u57fa\u5730\u5165\u308a\u53e3\u306b\u30b9\u30d1\u30a4\u30af\u30c8\u30e9\u30c3\u30d7\u3092\u8a2d\u7f6e\u3059\u308b\u3053\u3068\u3067\u3001\u8972\u6483\u8005\u3092\u6483\u9000\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03\u8868\uff1a\u9632\u5fa1\u6226\u7565\uff1a\u30c8\u30e9\u30c3\u30d7\u5bfe\u5f37\u5316\u3055\u308c\u305f\u58c1\uff0d\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u9632\u5fa1\u306b\u306f\u3001\u3069\u3061\u3089\u3082\u5fc5\u9808\u3067\u3059\u3002]"}, {"question": "\u30af\u30e9\u30d5\u30c8\u30ca\u30a4\u30c8.io\u306e\u98e2\u9913\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u7ba1\u7406\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30af\u30e9\u30d5\u30c8\u30ca\u30a4\u30c8.io\u306e\u98e2\u9913\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u3042\u306a\u305f\u306e\u4f53\u529b\u3068\u30b9\u30bf\u30df\u30ca\u306b\u5f71\u97ff\u3057\u307e\u3059\u3002\u98df\u3079\u7269\u3092\u98df\u3079\u3066\u3001\u4e21\u65b9\u3068\u3082\u88dc\u5145\u3055\u308c\u307e\u3059\u3002\u305d\u306e\u305f\u3081\u3001\u4e00\u5b9a\u306e\u4f9b\u7d66\u3092\u7dad\u6301\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002STEP1\uff1a\u52d5\u7269\u3092\u72e9\u731f\u3059\u308b\u304b\u3001\u4f5c\u7269\u3092\u683d\u57f9\u3057\u3066\u98df\u3079\u7269\u3092\u5f97\u308b\u3002STEP2\uff1a\u711a\u304d\u706b\u3067\u751f\u98df\u3092\u8abf\u7406\u3057\u3066\u3001\u305d\u306e\u52b9\u679c\u3092\u9ad8\u3081\u308b\u3002STEP3\uff1a\u7dca\u6025\u7528\u3068\u3057\u3066\u3001\u8abf\u7406\u6e08\u307f\u306e\u98df\u3079\u7269\u3092\u30c1\u30a7\u30b9\u30c8\u306b\u4fdd\u7ba1\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u8abf\u7406\u6e08\u307f\u8089\u306f\u751f\u8089\u3088\u308a\u3082\u98e2\u9913\u56de\u5fa9\u52b9\u679c\u304c\u9ad8\u3044\u3067\u3059\u3002[\u6bd4\u8f03\u8868\uff1a\u98df\u54c1\u306e\u7a2e\u985e\uff1a\u751f\u8089\uff08\u4f4e\u3044\uff09\u5bfe\u8abf\u7406\u6e08\u307f\u8089\uff08\u9ad8\u3044\uff09]"}, {"question": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u30af\u30e9\u30d5\u30c8\u30ca\u30a4\u30c8.io\u3092\u30d7\u30ec\u30a4\u3059\u308b\u305f\u3081\u306e\u30b7\u30b9\u30c6\u30e0\u8981\u4ef6\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u306f\u3069\u306e\u3088\u3046\u306b\u6bd4\u8f03\u3055\u308c\u307e\u3059\u304b\uff1f", "answer": "\u30af\u30e9\u30d5\u30c8\u30ca\u30a4\u30c8.io\u306e\u30b7\u30b9\u30c6\u30e0\u8981\u4ef6\u306f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u3002PC\u3067\u306f\u3001GTX 1050\u306e\u3088\u3046\u306a\u30df\u30c3\u30c9\u30ec\u30f3\u30b8GPU\u30688GB\u306eRAM\u304c\u63a8\u5968\u3055\u308c\u307e\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u3067\u306f\u3001\u5c11\u306a\u304f\u3068\u30823GB\u306eRAM\u3068Android 8.0\u3001\u307e\u305f\u306fiOS 11\u4ee5\u4e0a\u306e\u30c7\u30d0\u30a4\u30b9\u304c\u9069\u3057\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u9ad8\u6027\u80fdPC\u3067\u30d7\u30ec\u30a4\u3059\u308b\u3068\u3001\u30e2\u30d0\u30a4\u30eb\u3068\u6bd4\u8f03\u3057\u3066\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u304c\u5411\u4e0a\u3057\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u304c\u30b9\u30e0\u30fc\u30ba\u306b\u306a\u308a\u307e\u3059\u3002[\u6bd4\u8f03\u8868\uff1a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u8981\u4ef6\uff1aPC\uff08GTX 1050\u30018GB RAM\uff09\u5bfe\u30e2\u30d0\u30a4\u30eb\uff083GB RAM\u3001Android 8.0/iOS 11\uff09]"}, {"question": "\u8907\u6570\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u30af\u30e9\u30d5\u30c8\u30ca\u30a4\u30c8.io\u306e\u9032\u884c\u72b6\u6cc1\u3092\u30c7\u30fc\u30bf\u640d\u5931\u306a\u304f\u79fb\u884c\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30af\u30e9\u30d5\u30c8\u30ca\u30a4\u30c8.io\u306e\u9032\u884c\u72b6\u6cc1\u3092\u79fb\u884c\u3059\u308b\u306b\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30e6\u30cb\u30d0\u30fc\u30b5\u30eb\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u306b\u30ea\u30f3\u30af\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002STEP1\uff1a\u516c\u5f0f\u30af\u30e9\u30d5\u30c8\u30ca\u30a4\u30c8.io\u30a6\u30a7\u30d6\u30b5\u30a4\u30c8\u3067\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u4f5c\u6210\u3059\u308b\u3002STEP2\uff1a\u73fe\u5728\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u3053\u306e\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u306b\u30ea\u30f3\u30af\u3059\u308b\u3002STEP3\uff1a\u65b0\u3057\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u540c\u3058\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u3092\u4f7f\u7528\u3057\u3066\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001PC\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u306b\u30ea\u30f3\u30af\u3059\u308b\u3053\u3068\u3067\u3001\u30b9\u30e0\u30fc\u30ba\u306a\u9032\u884c\u72b6\u6cc1\u306e\u79fb\u884c\u304c\u53ef\u80fd\u3067\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u79fb\u884c\u30d7\u30ed\u30bb\u30b9\uff1a\u30a2\u30ab\u30a6\u30f3\u30c8\u4f5c\u6210\u2192\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30ea\u30f3\u30af\u2192\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u306e\u30ed\u30b0\u30a4\u30f3\u3002]"}, {"question": "\u30af\u30e9\u30d5\u30c8\u30ca\u30a4\u30c8.io\u3067\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u901a\u5e38\u3001\u3069\u3053\u3067\u898b\u3064\u304b\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30af\u30e9\u30d5\u30c8\u30ca\u30a4\u30c8.io\u306b\u306f\u3001\u63a2\u7d22\u3092\u5831\u3044\u308b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u305f\u304f\u3055\u3093\u3042\u308a\u307e\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306e1\u3064\u306f\u300c\u30b4\u30fc\u30eb\u30c7\u30f3\u30c1\u30ad\u30f3\u300d\u3067\u3001\u9060\u9694\u306e\u68ee\u6797\u30d0\u30a4\u30aa\u30fc\u30e0\u3067\u898b\u3064\u304b\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u30b4\u30fc\u30eb\u30c7\u30f3\u30b7\u30fc\u30c9\u3092\u4e0e\u3048\u308b\u3068\u3001\u5e0c\u5c11\u30a2\u30a4\u30c6\u30e0\u304c\u5f97\u3089\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b4\u30fc\u30eb\u30c7\u30f3\u30c1\u30ad\u30f3\u3092\u767a\u898b\u3059\u308b\u3068\u3001\u30e6\u30cb\u30fc\u30af\u306a\u30b4\u30fc\u30eb\u30c7\u30f3\u30a2\u30c3\u30af\u30b9\u3092\u5165\u624b\u3067\u304d\u307e\u3059\u3002[\u4f8b\uff1a\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u306f\u300c\u5b9d\u63a2\u3057\u300d\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u767a\u898b\u3059\u308b\u305f\u3073\u306b\u4e88\u60f3\u5916\u306e\u5831\u916c\u304c\u3042\u308a\u307e\u3059\u3002]"}]
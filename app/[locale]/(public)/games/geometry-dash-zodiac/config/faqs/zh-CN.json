[{"question": "\u65b0\u624b\u5982\u4f55\u6709\u6548\u5730\u5b66\u4e60\u51e0\u4f55\u51b2\u523a\u5341\u4e8c\u661f\u5ea7\u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u638c\u63e1\u51e0\u4f55\u51b2\u523a\u5341\u4e8c\u661f\u5ea7\u7684\u57fa\u672c\u63a7\u5236\uff0c\u9996\u5148\u8981\u719f\u6089\u8df3\u8dc3\u673a\u5236\u3002\u6309\u7a7a\u683c\u952e\u6216\u70b9\u51fb\u9f20\u6807\u4f7f\u4f60\u7684\u89d2\u8272\u8df3\u8dc3\u3002\u7ec3\u4e60\u8df3\u8dc3\u65f6\u673a\uff0c\u907f\u514d\u969c\u788d\u7269\uff0c\u4f8b\u5982\u5c16\u523a\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u5173\u4e2d\uff0c\u4f60\u5c06\u4f1a\u9047\u5230\u9700\u8981\u7cbe\u786e\u8df3\u8dc3\u7684\u4e00\u7cfb\u5217\u5c16\u523a\u3002\u4f7f\u7528\u7ec3\u4e60\u6a21\u5f0f\u91cd\u590d\u7ec3\u4e60\u90e8\u5206\uff0c\u76f4\u5230\u4f60\u611f\u89c9\u81ea\u4fe1\u3002\u6b65\u9aa4\u4e00\uff1a\u4ece\u7b80\u5355\u7684\u8df3\u8dc3\u5f00\u59cb\u3002\u6b65\u9aa4\u4e8c\uff1a\u9010\u6e10\u589e\u52a0\u96be\u5ea6\uff0c\u589e\u52a0\u66f4\u591a\u969c\u788d\u7269\u3002\u6b65\u9aa4\u4e09\uff1a\u4f7f\u7528\u7ec3\u4e60\u6a21\u5f0f\u6765\u8c03\u6574\u4f60\u7684\u65f6\u673a\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u628a\u5b83\u60f3\u8c61\u6210\u5b66\u4e60\u9a91\u81ea\u884c\u8f66\u2014\u2014\u4ece\u6162\u5f00\u59cb\uff0c\u5efa\u7acb\u4f60\u7684\u4fe1\u5fc3\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u65f6\u673a\u5728\u51e0\u4f55\u51b2\u523a\u5341\u4e8c\u661f\u5ea7\u4e2d\u5982\u6b64\u91cd\u8981\uff0c\u6211\u8be5\u5982\u4f55\u63d0\u9ad8\u5b83\uff1f", "answer": "\u5728\u51e0\u4f55\u51b2\u523a\u5341\u4e8c\u661f\u5ea7\u4e2d\uff0c\u65f6\u673a\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u6e38\u620f\u662f\u57fa\u4e8e\u8282\u594f\u7684\u3002\u6bcf\u7ea7\u5173\u5361\u90fd\u8bbe\u8ba1\u6210\u4e0e\u97f3\u4e50\u540c\u6b65\uff0c\u56e0\u6b64\u7cbe\u786e\u7684\u8df3\u8dc3\u81f3\u5173\u91cd\u8981\u3002\u4e3a\u4e86\u63d0\u9ad8\u4f60\u7684\u65f6\u673a\uff0c\u4ed4\u7ec6\u8046\u542c\u97f3\u4e50\u7684\u8282\u62cd\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5341\u4e8c\u661f\u5ea7\u6311\u6218\u201d\u5173\u5361\u4e2d\uff0c\u8df3\u8dc3\u7684\u65f6\u673a\u4e0e\u9f13\u70b9\u76f8\u5bf9\u5e94\u3002\u6b65\u9aa4\u4e00\uff1a\u6234\u4e0a\u8033\u673a\u73a9\u5173\u5361\uff0c\u4ee5\u4fbf\u6e05\u6670\u5730\u542c\u5230\u97f3\u4e50\u3002\u6b65\u9aa4\u4e8c\uff1a\u6570\u6570\u62cd\u5b50\uff0c\u9884\u6d4b\u4f55\u65f6\u8df3\u8dc3\u3002\u6b65\u9aa4\u4e09\uff1a\u91cd\u590d\u7ec3\u4e60\u90e8\u5206\uff0c\u4ee5\u5185\u5316\u8282\u594f\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u5c06\u4f60\u7684\u8df3\u8dc3\u65f6\u673a\u4e0e\u62cd\u5b50\u8fdb\u884c\u6bd4\u8f83\u2014\u2014\u5b8c\u7f8e\u540c\u6b65\u4ee5\u83b7\u5f97\u6700\u4f73\u7ed3\u679c\u3002]"}, {"question": "\u5b8c\u6210\u51e0\u4f55\u51b2\u523a\u5341\u4e8c\u661f\u5ea7\u66f4\u5177\u6311\u6218\u6027\u7684\u5173\u5361\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u4e3a\u4e86\u5e94\u5bf9\u51e0\u4f55\u51b2\u523a\u5341\u4e8c\u661f\u5ea7\u4e2d\u7684\u5177\u6709\u6311\u6218\u6027\u7684\u5173\u5361\uff0c\u5c06\u5176\u5206\u89e3\u6210\u8f83\u5c0f\u7684\u90e8\u5206\u3002\u4f7f\u7528\u7ec3\u4e60\u6a21\u5f0f\u4e13\u6ce8\u4e8e\u56f0\u96be\u7684\u90e8\u5206\u3002\u4f8b\u5982\uff0c\u5728\u201c\u661f\u9645\u98ce\u66b4\u201d\u5173\u5361\u4e2d\uff0c\u4e2d\u95f4\u90e8\u5206\u6709\u4e00\u7cfb\u5217\u5feb\u901f\u8df3\u8dc3\u3002\u6b65\u9aa4\u4e00\uff1a\u627e\u51fa\u5173\u5361\u4e2d\u6700\u56f0\u96be\u7684\u90e8\u5206\u3002\u6b65\u9aa4\u4e8c\uff1a\u91cd\u590d\u7ec3\u4e60\u8be5\u90e8\u5206\uff0c\u76f4\u5230\u4f60\u80fd\u6301\u7eed\u8fdb\u884c\u3002\u6b65\u9aa4\u4e09\uff1a\u9010\u6e10\u5c06\u6574\u4e2a\u5173\u5361\u7ec4\u5408\u5728\u4e00\u8d77\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u5c1d\u8bd5\u4e0d\u540c\u7684\u65b9\u6cd5\u5904\u7406\u6bcf\u4e2a\u90e8\u5206\u2014\u2014\u6709\u65f6\uff0c\u66f4\u6162\u3001\u66f4\u8c28\u614e\u7684\u7b56\u7565\u6bd4\u51b2\u523a\u66f4\u597d\u3002]"}, {"question": "\u51e0\u4f55\u51b2\u523a\u5341\u4e8c\u661f\u5ea7\u7684\u96be\u5ea6\u5982\u4f55\u9012\u589e\uff0c\u73a9\u5bb6\u5e94\u8be5\u671f\u5f85\u4ec0\u4e48\uff1f", "answer": "\u51e0\u4f55\u51b2\u523a\u5341\u4e8c\u661f\u5ea7\u7684\u96be\u5ea6\u8bbe\u8ba1\u662f\u9010\u6e10\u589e\u52a0\u7684\uff0c\u968f\u7740\u4f60\u7684\u8fdb\u5c55\u3002\u65e9\u671f\u5173\u5361\u4ecb\u7ecd\u57fa\u672c\u673a\u5236\uff0c\u800c\u540e\u671f\u5173\u5361\u589e\u52a0\u590d\u6742\u7684\u969c\u788d\u7269\u548c\u66f4\u5feb\u7684\u8282\u594f\u3002\u4f8b\u5982\uff0c\u201c\u592a\u9633\u8000\u6591\u201d\u5173\u5361\u5f15\u5165\u4e86\u9700\u8981\u7cbe\u786e\u65f6\u673a\u7684\u79fb\u52a8\u5e73\u53f0\u3002\u968f\u7740\u4f60\u7684\u63a8\u8fdb\uff0c\u4f60\u5c06\u9762\u4e34\u66f4\u591a\u5c16\u523a\u3001\u66f4\u5feb\u7684\u8282\u594f\u548c\u66f4\u590d\u6742\u7684\u6a21\u5f0f\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u53ef\u89c6\u5316\u96be\u5ea6\u66f2\u7ebf\u2014\u2014\u4e00\u5f00\u59cb\u6162\uff0c\u4e2d\u95f4\u8fbe\u5230\u9876\u5cf0\uff0c\u6700\u540e\u7565\u5fae\u4e0b\u964d\u3002]"}, {"question": "\u6e38\u620f\u4e2d\u54ea\u4e9b\u8d44\u6e90\u6700\u6709\u52a9\u4e8e\u638c\u63e1\u51e0\u4f55\u51b2\u523a\u5341\u4e8c\u661f\u5ea7\uff1f", "answer": "\u51e0\u4f55\u51b2\u523a\u5341\u4e8c\u661f\u5ea7\u4e2d\u6700\u6709\u7528\u7684\u8d44\u6e90\u662f\u7ec3\u4e60\u6a21\u5f0f\u548c\u5173\u5361\u7f16\u8f91\u5668\u3002\u7ec3\u4e60\u6a21\u5f0f\u5141\u8bb8\u4f60\u91cd\u590d\u7ec3\u4e60\u90e8\u5206\uff0c\u76f4\u5230\u4f60\u638c\u63e1\u5b83\u4eec\uff0c\u800c\u5173\u5361\u7f16\u8f91\u5668\u5219\u5141\u8bb8\u4f60\u521b\u5efa\u548c\u6d4b\u8bd5\u4f60\u81ea\u5df1\u7684\u5173\u5361\u3002\u4f8b\u5982\uff0c\u4f60\u53ef\u4ee5\u4f7f\u7528\u5173\u5361\u7f16\u8f91\u5668\u590d\u5236\u5b98\u65b9\u5173\u5361\u4e2d\u7684\u56f0\u96be\u90e8\u5206\u5e76\u8fdb\u884c\u7ec3\u4e60\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u628a\u5173\u5361\u7f16\u8f91\u5668\u60f3\u8c61\u6210\u4e00\u4e2a\u6c99\u76d2\uff0c\u4f60\u53ef\u4ee5\u5728\u5176\u4e2d\u8fdb\u884c\u5b9e\u9a8c\u800c\u65e0\u9700\u62c5\u5fc3\u540e\u679c\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u4f18\u5316\u4ed6\u4eec\u7684\u8bbe\u7f6e\u4ee5\u83b7\u5f97\u66f4\u597d\u7684\u51e0\u4f55\u51b2\u523a\u5341\u4e8c\u661f\u5ea7\u6e38\u620f\u6027\u80fd\uff1f", "answer": "\u4e3a\u4e86\u4f18\u5316\u51e0\u4f55\u51b2\u523a\u5341\u4e8c\u661f\u5ea7\u7684\u6e38\u620f\u6027\u80fd\uff0c\u8c03\u6574\u56fe\u5f62\u8bbe\u7f6e\u4ee5\u51cf\u5c11\u5ef6\u8fdf\u3002\u964d\u4f4e\u5206\u8fa8\u7387\u5e76\u7981\u7528\u4e0d\u5fc5\u8981\u7684\u7279\u6548\uff0c\u4f8b\u5982\u7c92\u5b50\u52a8\u753b\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5728\u201c\u6708\u8680\u201d\u5173\u5361\u4e2d\u9047\u5230\u5e27\u7387\u4e0b\u964d\uff0c\u964d\u4f4e\u8bbe\u7f6e\u53ef\u4ee5\u6709\u6240\u5e2e\u52a9\u3002\u6b65\u9aa4\u4e00\uff1a\u6253\u5f00\u8bbe\u7f6e\u83dc\u5355\u3002\u6b65\u9aa4\u4e8c\uff1a\u964d\u4f4e\u5206\u8fa8\u7387\u5e76\u7981\u7528\u7279\u6548\u3002\u6b65\u9aa4\u4e09\uff1a\u6d4b\u8bd5\u6e38\u620f\u4ee5\u786e\u4fdd\u6e38\u620f\u8fd0\u884c\u66f4\u6d41\u7545\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6bd4\u8f83\u9ad8\u8bbe\u7f6e\u4e0e\u4f4e\u8bbe\u7f6e\u4ee5\u4e86\u89e3\u5176\u5bf9\u6027\u80fd\u7684\u5f71\u54cd\u3002]"}, {"question": "\u51e0\u4f55\u51b2\u523a\u5341\u4e8c\u661f\u5ea7\u548c\u5176\u4ed6\u7cfb\u5217\u6e38\u620f\u4e4b\u95f4\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u51e0\u4f55\u51b2\u523a\u5341\u4e8c\u661f\u5ea7\u4ee5\u5176\u72ec\u7279\u7684\u5173\u5361\u8bbe\u8ba1\u548c\u97f3\u4e50\u540c\u6b65\u800c\u8131\u9896\u800c\u51fa\u3002\u4e0e\u4e4b\u524d\u7684\u6e38\u620f\u4e0d\u540c\uff0c\u5341\u4e8c\u661f\u5ea7\u5173\u5361\u5177\u6709\u66f4\u590d\u6742\u7684\u6a21\u5f0f\u548c\u66f4\u9ad8\u7684\u96be\u5ea6\u66f2\u7ebf\u3002\u4f8b\u5982\uff0c\u201c\u94f6\u6cb3\u8109\u51b2\u201d\u5173\u5361\u5f15\u5165\u4e86\u9700\u8981\u7cbe\u786e\u65f6\u673a\u7684\u591a\u5c42\u969c\u788d\u7269\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u5c06\u5341\u4e8c\u661f\u5ea7\u7684\u5173\u5361\u8bbe\u8ba1\u4e0e\u4e4b\u524d\u6e38\u620f\u8fdb\u884c\u6bd4\u8f83\u2014\u2014\u6ce8\u610f\u5230\u590d\u6742\u6027\u548c\u8282\u594f\u6574\u5408\u7684\u589e\u52a0\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u51e0\u4f55\u51b2\u523a\u5341\u4e8c\u661f\u5ea7\u4e2d\u5c06\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u5e73\u53f0\u8fc1\u79fb\u5230\u53e6\u4e00\u4e2a\u5e73\u53f0\uff1f", "answer": "\u8981\u5728\u51e0\u4f55\u51b2\u523a\u5341\u4e8c\u661f\u5ea7\u4e2d\u8fc1\u79fb\u8fdb\u5ea6\uff0c\u8bf7\u4f7f\u7528\u4e91\u4fdd\u5b58\u529f\u80fd\u3002\u786e\u4fdd\u4f60\u5728\u4e24\u4e2a\u5e73\u53f0\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u5e10\u6237\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4ece\u7535\u8111\u5207\u6362\u5230\u624b\u673a\uff0c\u8bf7\u4f7f\u7528\u4f60\u7684\u5e10\u6237\u8be6\u7ec6\u4fe1\u606f\u767b\u5f55\u4ee5\u540c\u6b65\u4f60\u7684\u8fdb\u5ea6\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u4e91\u4fdd\u5b58\u60f3\u8c61\u6210\u8fde\u63a5\u4f60\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u8fdb\u5ea6\u7684\u6865\u6881\u3002]"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728\u51e0\u4f55\u51b2\u523a\u5341\u4e8c\u661f\u5ea7\u4e2d\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u7684\u79d8\u5bc6\u6216\u5f69\u86cb\uff1f", "answer": "\u51e0\u4f55\u51b2\u523a\u5341\u4e8c\u661f\u5ea7\u5145\u6ee1\u4e86\u9690\u85cf\u7684\u79d8\u5bc6\u548c\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u5728\u201c\u661f\u9645\u4e4b\u65c5\u201d\u5173\u5361\u4e2d\uff0c\u6709\u4e00\u6761\u9690\u85cf\u8def\u5f84\u901a\u5411\u4e00\u4e2a\u5e26\u6709\u72ec\u7279\u56fe\u6807\u7684\u79d8\u5bc6\u533a\u57df\u3002\u5f7b\u5e95\u63a2\u7d22\u5173\u5361\uff0c\u5bfb\u627e\u8bbe\u8ba1\u4e2d\u7684\u7ec6\u5fae\u7ebf\u7d22\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u7ed8\u5236\u5730\u56fe\u4ee5\u5b9a\u4f4d\u9690\u85cf\u533a\u57df\u2014\u2014\u6709\u65f6\u5b83\u4eec\u5728\u4e3b\u8981\u8def\u5f84\u4e4b\u5916\u3002]"}]
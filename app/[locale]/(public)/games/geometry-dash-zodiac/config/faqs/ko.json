[{"question": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc zodiac\uc5d0\uc11c \ucd08\ubcf4\uc790\uac00 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \ubc30\uc6b0\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc zo\ub514\uc545\uc5d0\uc11c \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ub9c8\uc2a4\ud130\ud558\ub824\uba74 \uc810\ud504 \uba54\ucee4\ub2c8\uc998\uc5d0 \uc775\uc219\ud574\uc9c0\ub294 \uac83\uc73c\ub85c \uc2dc\uc791\ud558\uc2ed\uc2dc\uc624. \uc2a4\ud398\uc774\uc2a4\ubc14\ub098 \ud074\ub9ad\ud558\uc5ec \uce90\ub9ad\ud130\ub97c \uc810\ud504\uc2dc\ud0a4\uc2ed\uc2dc\uc624. \uc2a4\ud30c\uc774\ud06c\uc640 \uac19\uc740 \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uc5f0\uc2b5\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c\ub294 \uc815\ud655\ud55c \uc810\ud504\uac00 \ud544\uc694\ud55c \uc77c\ub828\uc758 \uc2a4\ud30c\uc774\ud06c\ub97c \ub9cc\ub098\uac8c \ub420 \uac83\uc785\ub2c8\ub2e4. \uc790\uc2e0\uac10\uc744 \ub290\ub084 \ub54c\uae4c\uc9c0 \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc139\uc158\uc744 \ubc18\ubcf5\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 1: \uac04\ub2e8\ud55c \uc810\ud504\ubd80\ud130 \uc2dc\uc791\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \ub354 \ub9ce\uc740 \uc7a5\uc560\ubb3c\uc744 \ucd94\uac00\ud558\uc5ec \uc810\ucc28\uc801\uc73c\ub85c \uc5b4\ub824\uc6c0\uc744 \ub192\uc774\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud0c0\uc774\ubc0d\uc744 \uac1c\uc120\ud558\uc2ed\uc2dc\uc624. [\ube44\uc720 \uc124\uba85: \uc790\uc804\uac70 \ud0c0\ub294 \ubc95\uc744 \ubc30\uc6b0\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ucc9c\ucc9c\ud788 \uc2dc\uc791\ud558\uc5ec \uc790\uc2e0\uac10\uc744 \ud0a4\uc6b0\uc2ed\uc2dc\uc624.]"}, {"question": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc zo\ub514\uc545\uc5d0\uc11c \ud0c0\uc774\ubc0d\uc774 \uadf8\ub807\uac8c \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \uac1c\uc120\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc zo\ub514\uc545\uc5d0\uc11c \ud0c0\uc774\ubc0d\uc740 \uac8c\uc784\uc774 \ub9ac\ub4ec \uae30\ubc18\uc774\uae30 \ub54c\ubb38\uc5d0 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uac01 \ub808\ubca8\uc740 \uc74c\uc545\uacfc \ub3d9\uae30\ud654\ub418\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc73c\ubbc0\ub85c \uc815\ud655\ud55c \uc810\ud504\uac00 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \ud0c0\uc774\ubc0d\uc744 \uac1c\uc120\ud558\ub824\uba74 \uc74c\uc545\uc758 \ubc15\uc790\ub97c \uc8fc\uc758 \uae4a\uac8c \ub4e4\uc5b4\ubcf4\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, 'zodiac \ucc4c\ub9b0\uc9c0' \ub808\ubca8\uc5d0\uc11c \uc810\ud504\ub294 \ub4dc\ub7fc \ube44\ud2b8\uc5d0 \ub9de\ucdb0\uc9c4 \ud0c0\uc774\ubc0d\uc785\ub2c8\ub2e4. \ub2e8\uacc4 1: \ud5e4\ub4dc\ud3f0\uc73c\ub85c \ub808\ubca8\uc744 \ud50c\ub808\uc774\ud558\uc5ec \uc74c\uc545\uc744 \uba85\ud655\ud558\uac8c \ub4e4\uc5b4\ubcf4\uc138\uc694. \ub2e8\uacc4 2: \uc810\ud504\ud560 \ud0c0\uc774\ubc0d\uc744 \uc608\uce21\ud558\uae30 \uc704\ud574 \ubc15\uc790\ub97c \uc138\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \ub9ac\ub4ec\uc744 \uc219\ub2ec\ud558\uae30 \uc704\ud574 \uc139\uc158\uc744 \ubc18\ubcf5\uc801\uc73c\ub85c \uc5f0\uc2b5\ud558\uc2ed\uc2dc\uc624. [\uad6c\uc131 \ub300\uc870\ud45c: \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \ubc15\uc790\uc640 \ube44\uad50\ud558\uc5ec \uc644\ubcbd\ud558\uac8c \ub3d9\uae30\ud654\ud558\uc5ec \ucd5c\uc0c1\uc758 \uacb0\uacfc\ub97c \uc5bb\uc73c\uc2ed\uc2dc\uc624.]"}, {"question": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc zo\ub514\uc545\uc758 \ub354 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc zo\ub514\uc545\uc758 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc5d0 \ub300\ucc98\ud558\ub824\uba74 \ub354 \uc791\uc740 \uc139\uc158\uc73c\ub85c \ub098\ub204\uc2ed\uc2dc\uc624. \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc5b4\ub824\uc6b4 \ubd80\ubd84\uc5d0 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, 'celestial \ud3ed\ud48d' \ub808\ubca8\uc758 \uc911\uac04 \uc139\uc158\uc5d0\ub294 \ube60\ub978 \uc810\ud504 \uc2dc\ud000\uc2a4\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \ub808\ubca8\uc5d0\uc11c \uac00\uc7a5 \uc5b4\ub824\uc6b4 \ubd80\ubd84\uc744 \ud30c\uc545\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \uc77c\uad00\uc131 \uc788\uac8c \uc218\ud589\ud560 \uc218 \uc788\uc744 \ub54c\uae4c\uc9c0 \ud574\ub2f9 \uc139\uc158\uc744 \ubc18\ubcf5\uc801\uc73c\ub85c \uc5f0\uc2b5\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \uc810\ucc28\uc801\uc73c\ub85c \uc804\uccb4 \ub808\ubca8\uc744 \uc870\ub9bd\ud558\uc2ed\uc2dc\uc624. [\ub2e4\uc591\ud55c \ubc29\uc548 \ube44\uad50: \uac01 \uc139\uc158\uc5d0 \ub300\ud55c \ub2e4\ub978 \uc811\uadfc \ubc29\uc2dd\uc744 \uc2dc\ub3c4\ud558\uc2ed\uc2dc\uc624. \ub54c\ub85c\ub294 \ub354 \ub290\ub9ac\uace0 \uc2e0\uc911\ud55c \uc804\ub7b5\uc774 \uc11c\ub450\ub974\ub294 \uac83\ubcf4\ub2e4 \ub354 \ub098\uc740 \uacb0\uacfc\ub97c \ub0c5\ub2c8\ub2e4.]"}, {"question": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc zo\ub514\uc545\uc5d0\uc11c \uc5b4\ub824\uc6c0 \ucc99\ub3c4\ub294 \uc5b4\ub5bb\uac8c \uc791\uc6a9\ud558\uba70, \ud50c\ub808\uc774\uc5b4\ub294 \ubb34\uc5c7\uc744 \uc608\uc0c1\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc zo\ub514\uc545\uc758 \uc5b4\ub824\uc6c0 \ucc99\ub3c4\ub294 \uc9c4\ud589\uc5d0 \ub530\ub77c \uc810\ucc28 \uc99d\uac00\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ucd08\uae30 \ub808\ubca8\uc740 \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc744 \uc18c\uac1c\ud558\ub294 \ubc18\uba74, \ud6c4\ubc18 \ub808\ubca8\uc740 \ubcf5\uc7a1\ud55c \uc7a5\uc560\ubb3c\uacfc \ube60\ub978 \ub9ac\ub4ec\uc744 \ucd94\uac00\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'solar flare' \ub808\ubca8\uc740 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uc774 \ud544\uc694\ud55c \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uc744 \uc18c\uac1c\ud569\ub2c8\ub2e4. \uc9c4\ud589\ud568\uc5d0 \ub530\ub77c \ub354 \ub9ce\uc740 \uc2a4\ud30c\uc774\ud06c, \ub354 \ube60\ub978 \ud15c\ud3ec \ubc0f \ubcf5\uc7a1\ud55c \ud328\ud134\uc5d0 \uc9c1\uba74\ud558\uac8c \ub420 \uac83\uc785\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc5b4\ub824\uc6c0 \uace1\uc120\uc744 \uc2dc\uac01\ud654\ud558\uc2ed\uc2dc\uc624. \ucc9c\ucc9c\ud788 \uc2dc\uc791\ud558\uc5ec \uc911\uac04\uc5d0 \ucd5c\uace0\uc870\uc5d0 \ub2ec\ud558\uace0 \ub05d\uc5d0\ub294 \uc57d\uac04 \uc644\ub9cc\ud574\uc9d1\ub2c8\ub2e4.]"}, {"question": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc zo\ub514\uc545\uc744 \ub9c8\uc2a4\ud130\ud558\ub294 \ub370 \uac00\uc7a5 \uc720\uc6a9\ud55c \uac8c\uc784 \ub0b4 \ub9ac\uc18c\uc2a4\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc zo\ub514\uc545\uc5d0\uc11c \uac00\uc7a5 \uc720\uc6a9\ud55c \ub9ac\uc18c\uc2a4\ub294 \uc5f0\uc2b5 \ubaa8\ub4dc\uc640 \ub808\ubca8 \ud3b8\uc9d1\uae30\uc785\ub2c8\ub2e4. \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uba74 \uc219\ub2ec\ud560 \ub54c\uae4c\uc9c0 \uc139\uc158\uc744 \ubc18\ubcf5\ud560 \uc218 \uc788\uc73c\uba70, \ub808\ubca8 \ud3b8\uc9d1\uae30\ub294 \uc0ac\uc6a9\uc790 \uc815\uc758 \ub808\ubca8\uc744 \ub9cc\ub4e4\uace0 \ud14c\uc2a4\ud2b8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 \ud3b8\uc9d1\uae30\ub97c \uc0ac\uc6a9\ud558\uc5ec \uacf5\uc2dd \ub808\ubca8\uc758 \uc5b4\ub824\uc6b4 \uc139\uc158\uc744 \ubcf5\uc81c\ud558\uace0 \uc5f0\uc2b5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ub808\ubca8 \ud3b8\uc9d1\uae30\ub97c \uacb0\uacfc\uac00 \uc5c6\ub294 \uc2e4\ud5d8\uc744 \ud560 \uc218 \uc788\ub294 \ubaa8\ub798\ubc2d\uc73c\ub85c \uc0dd\uac01\ud574\ubcf4\uc138\uc694.]"}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 \uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc zo\ub514\uc545\uc5d0\uc11c \ub354 \ub098\uc740 \uc131\ub2a5\uc744 \uc704\ud574 \uc124\uc815\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc zo\ub514\uc545\uc5d0\uc11c \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uadf8\ub798\ud53d \uc124\uc815\uc744 \uc870\uc815\ud558\uc5ec \uc9c0\uc5f0\uc744 \uc904\uc774\uc2ed\uc2dc\uc624. \ud574\uc0c1\ub3c4\ub97c \ub0ae\ucd94\uace0 \uc785\uc790 \uc560\ub2c8\uba54\uc774\uc158\uacfc \uac19\uc740 \ubd88\ud544\uc694\ud55c \ud6a8\uacfc\ub97c \ube44\ud65c\uc131\ud654\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, 'lunar \uc774\ud074\ub9bd\uc2a4'\uc5d0\uc11c \ud504\ub808\uc784 \ub4dc\ub86d\uc774 \ubc1c\uc0dd\ud558\uba74 \uc124\uc815\uc744 \ub0ae\ucd94\uba74 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc124\uc815 \uba54\ub274\ub97c \uc5fd\ub2c8\ub2e4. \ub2e8\uacc4 2: \ud574\uc0c1\ub3c4\ub97c \ub0ae\ucd94\uace0 \ud6a8\uacfc\ub97c \ube44\ud65c\uc131\ud654\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \uac8c\uc784\uc744 \ud14c\uc2a4\ud2b8\ud558\uc5ec \ub354 \uc6d0\ud65c\ud55c \uc131\ub2a5\uc744 \ubcf4\uc7a5\ud558\uc2ed\uc2dc\uc624. [\uad6c\uc131 \ub300\uc870\ud45c: \ub192\uc740 \uc124\uc815\uacfc \ub0ae\uc740 \uc124\uc815\uc744 \ube44\uad50\ud558\uc5ec \uc131\ub2a5\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc744 \ud655\uc778\ud558\uc2ed\uc2dc\uc624.]"}, {"question": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc zo\ub514\uc545\uacfc \uc2dc\ub9ac\uc988\uc758 \ub2e4\ub978 \uac8c\uc784 \uc0ac\uc774\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc zo\ub514\uc545\uc740 \ub3c5\ud2b9\ud55c \ub808\ubca8 \ub514\uc790\uc778\uacfc \uc74c\uc545 \ub3d9\uae30\ud654\ub85c \ub450\ub4dc\ub7ec\uc9d1\ub2c8\ub2e4. \uc774\uc804 \uac8c\uc784\uacfc \ub2ec\ub9ac zo\ub514\uc545\uc740 \ub354 \ubcf5\uc7a1\ud55c \ud328\ud134\uacfc \ub354 \ub192\uc740 \uc5b4\ub824\uc6c0 \uace1\uc120\uc744 \ud2b9\uc9d5\uc73c\ub85c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'galactic pulse' \ub808\ubca8\uc740 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uc774 \ud544\uc694\ud55c \ub2e4\uce35 \uc7a5\uc560\ubb3c\uc744 \uc18c\uac1c\ud569\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\uc548 \ube44\uad50: zo\ub514\uc545\uc758 \ub808\ubca8 \ub514\uc790\uc778\uc744 \uc774\uc804 \uac8c\uc784\uacfc \ube44\uad50\ud558\uc5ec \ubcf5\uc7a1\uc131\uacfc \ub9ac\ub4ec \ud1b5\ud569\uc758 \uc99d\uac00\ub97c \uc54c\uc544\ubcf4\uc2ed\uc2dc\uc624.]"}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 \uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc zo\ub514\uc545\uc5d0\uc11c \ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc zo\ub514\uc545\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud558\ub824\uba74 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \ub450 \ud50c\ub7ab\ud3fc \ubaa8\ub450\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ubaa8\ubc14\uc77c\ub85c \uc804\ud658\ud558\ub294 \uacbd\uc6b0 \uacc4\uc815 \uc815\ubcf4\ub85c \ub85c\uadf8\uc778\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud558\uc2ed\uc2dc\uc624. [\ube44\uc720 \uc124\uba85: \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc740 \uc11c\ub85c \ub2e4\ub978 \uae30\uae30\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5f0\uacb0\ud558\ub294 \ub2e4\ub9ac\uc640 \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc zo\ub514\uc545\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ube44\ubc00\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc zo\ub514\uc545\uc740 \uc228\uaca8\uc9c4 \ube44\ubc00\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\ub85c \uac00\ub4dd\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'astral \uc5ec\uc815' \ub808\ubca8\uc5d0\uc11c \ub3c5\ud2b9\ud55c \uc544\uc774\ucf58\uc774 \uc788\ub294 \ube44\ubc00 \uc601\uc5ed\uc73c\ub85c \uc774\uc5b4\uc9c0\ub294 \uc228\uaca8\uc9c4 \uacbd\ub85c\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ub808\ubca8\uc744 \ucca0\uc800\ud788 \ud0d0\uc0c9\ud558\uace0 \ub514\uc790\uc778\uc5d0\uc11c \ubbf8\ubb18\ud55c \ud78c\ud2b8\ub97c \ucc3e\uc73c\uc2ed\uc2dc\uc624. [\ud750\ub984\ub3c4: \ub808\ubca8\uc744 \ub9e4\ud551\ud558\uc5ec \uc228\uaca8\uc9c4 \uc601\uc5ed\uc744 \ucc3e\uc73c\uc2ed\uc2dc\uc624. \ub54c\ub85c\ub294 \uc8fc\uc694 \uacbd\ub85c\uc5d0\uc11c \ubc97\uc5b4\ub0a9\ub2c8\ub2e4.]"}]
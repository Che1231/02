[{"question": "\u5982\u4f55\u5728\u5e15\u5e15\u7684\u610f\u5927\u5229\u9762\u9986\u5b8c\u6210\u6211\u7684\u7b2c\u4e00\u4e2a\u8ba2\u5355\uff0c\u4ee5\u53ca\u57fa\u672c\u7684\u6b65\u9aa4\u662f\u4ec0\u4e48\uff1f", "answer": "\u8981\u5f00\u59cb\u60a8\u5728\u5e15\u5e15\u7684\u610f\u5927\u5229\u9762\u9986\u7684\u7b2c\u4e00\u4e2a\u8ba2\u5355\uff0c\u8bf7\u6309\u7167\u8fd9\u4e9b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u6b22\u8fce\u987e\u5ba2\u5e76\u63a5\u53d7\u4ed6\u4eec\u7684\u8ba2\u5355\uff0c\u8bb0\u5f55\u4e0b\u4ed6\u4eec\u7684\u9762\u98df\u7c7b\u578b\u3001\u9171\u6c41\u548c\u914d\u6599\u3002\u6b65\u9aa42 - \u524d\u5f80\u70f9\u996a\u533a\u716e\u9762\uff0c\u786e\u4fdd\u716e\u81f3\u5408\u9002\u7684\u8d28\u5730\u3002\u6b65\u9aa43 - \u901a\u8fc7\u6dfb\u52a0\u9009\u62e9\u7684\u9171\u6c41\u548c\u914d\u6599\u6765\u7ec4\u5408\u83dc\u80b4\uff0c\u7136\u540e\u5c06\u5176\u5448\u73b0\u5728\u987e\u5ba2\u9762\u524d\u3002\u4f8b\u5982\uff0c\u5982\u679c\u987e\u5ba2\u70b9\u7684\u662f\u914d\u739b\u7433\u5a1c\u9171\u548c\u5e15\u5c14\u739b\u5e72\u916a\u7684\u610f\u5927\u5229\u9762\uff0c\u60a8\u9700\u8981\u716e\u610f\u5927\u5229\u9762\uff0c\u6dfb\u52a0\u739b\u7433\u5a1c\u9171\uff0c\u5e76\u5728\u4e0a\u9762\u6492\u4e0a\u5e15\u5c14\u739b\u5e72\u916a\u3002\u8bf7\u4f7f\u7528[\u914d\u7f6e\u5bf9\u7167\u8868]\u5c06\u9762\u98df\u7c7b\u578b\u4e0e\u7406\u60f3\u7684\u70f9\u996a\u65f6\u95f4\u76f8\u5339\u914d\u3002"}, {"question": "\u65f6\u95f4\u5728\u5e15\u5e15\u7684\u610f\u5927\u5229\u9762\u9986\u4e3a\u4ec0\u4e48\u81f3\u5173\u91cd\u8981\uff0c\u6211\u8be5\u5982\u4f55\u63d0\u9ad8\u6548\u7387\uff1f", "answer": "\u65f6\u95f4\u5728\u5e15\u5e15\u7684\u610f\u5927\u5229\u9762\u9986\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u76f4\u63a5\u5f71\u54cd\u987e\u5ba2\u6ee1\u610f\u5ea6\u548c\u60a8\u7684\u5c0f\u8d39\u3002\u4e3a\u4e86\u63d0\u9ad8\u6548\u7387\uff1a\u6b65\u9aa41 - \u4f18\u5148\u8003\u8651\u591a\u4efb\u52a1\u5904\u7406\uff1b\u4f8b\u5982\uff0c\u5728\u63a5\u53d7\u4e0b\u4e00\u4e2a\u8ba2\u5355\u7684\u540c\u65f6\u5f00\u59cb\u716e\u9762\u3002\u6b65\u9aa42 - \u4f7f\u7528[\u6d41\u7a0b\u56fe\u89e3]\u53ef\u89c6\u5316\u4ece\u70b9\u9910\u5230\u4e0a\u83dc\u7684\u5de5\u4f5c\u6d41\u7a0b\u3002\u6b65\u9aa43 - \u53cd\u590d\u7ec3\u4e60\u4ee5\u51cf\u5c11\u5ef6\u8fdf\uff0c\u4f8b\u5982\u9884\u5148\u51c6\u5907\u5e38\u89c1\u98df\u6750\u3002\u4f8b\u5982\uff0c\u4fdd\u6301\u4e00\u9505\u6cb8\u6c34\u53ef\u4ee5\u8282\u7701\u65b0\u8ba2\u5355\u5230\u6765\u65f6\u7684\u7b49\u5f85\u65f6\u95f4\u3002"}, {"question": "\u5728\u5e15\u5e15\u7684\u610f\u5927\u5229\u9762\u9986\u7ba1\u7406\u591a\u4e2a\u8ba2\u5355\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u5e15\u5e15\u7684\u610f\u5927\u5229\u9762\u9986\u7ba1\u7406\u591a\u4e2a\u8ba2\u5355\u9700\u8981\u6218\u7565\u89c4\u5212\uff1a\u6b65\u9aa41 - \u4f7f\u7528\u8ba2\u5355\u7968\u636e\u7cfb\u7edf\u6839\u636e\u987e\u5ba2\u7b49\u5f85\u65f6\u95f4\u4f18\u5148\u5b89\u6392\u4efb\u52a1\u3002\u6b65\u9aa42 - \u5c06\u7c7b\u4f3c\u8ba2\u5355\u5206\u7ec4\uff1b\u4f8b\u5982\uff0c\u540c\u65f6\u70f9\u996a\u6240\u6709\u610f\u5927\u5229\u9762\u8ba2\u5355\u3002\u6b65\u9aa43 - \u5728\u5404\u4e2a\u5de5\u4f5c\u7ad9\u4e4b\u95f4\u6709\u6548\u5730\u5206\u914d\u4efb\u52a1\u3002\u8bf7\u53c2\u8003[\u591a\u65b9\u6848\u5bf9\u6bd4]\u8868\u683c\uff0c\u6839\u636e\u8ba2\u5355\u91cf\u51b3\u5b9a\u662f\u5206\u6279\u70f9\u996a\u8fd8\u662f\u5355\u72ec\u70f9\u996a\u3002\u4f8b\u5982\uff0c\u5728\u9ad8\u5cf0\u65f6\u6bb5\uff0c\u5206\u6279\u70f9\u996a\u53ef\u4ee5\u663e\u8457\u7f29\u77ed\u7b49\u5f85\u65f6\u95f4\u3002"}, {"question": "\u5728\u5e15\u5e15\u7684\u610f\u5927\u5229\u9762\u9986\u4e2d\uff0c\u6211\u5e94\u8be5\u4f18\u5148\u8003\u8651\u54ea\u4e9b\u5347\u7ea7\u4ee5\u6700\u5927\u5316\u5229\u6da6\uff1f", "answer": "\u4e3a\u4e86\u5728\u5e15\u5e15\u7684\u610f\u5927\u5229\u9762\u9986\u6700\u5927\u5316\u5229\u6da6\uff0c\u8bf7\u4f18\u5148\u8003\u8651\u4ee5\u4e0b\u5347\u7ea7\uff1a\u6b65\u9aa41 - \u9996\u5148\u6295\u8d44\u4e8e\u53a8\u623f\u8bbe\u5907\u5347\u7ea7\uff0c\u4f8b\u5982\u66f4\u5feb\u7684\u716e\u9762\u673a\uff0c\u4ee5\u7f29\u77ed\u70f9\u996a\u65f6\u95f4\u3002\u6b65\u9aa42 - \u5347\u7ea7\u7528\u9910\u533a\u4ee5\u589e\u52a0\u987e\u5ba2\u5468\u8f6c\u7387\u548c\u5c0f\u8d39\u3002\u6b65\u9aa43 - \u63d0\u5347\u98df\u6750\u8d28\u91cf\u4ee5\u5438\u5f15\u66f4\u591a\u987e\u5ba2\u5e76\u5141\u8bb8\u66f4\u9ad8\u5b9a\u4ef7\u3002\u8bf7\u53c2\u8003[\u6bd4\u55bb\u8bf4\u660e]\uff0c\u5c06\u5347\u7ea7\u6bd4\u4f5c\u673a\u5668\u4e2d\u7684\u9f7f\u8f6e\uff1b\u6bcf\u4e2a\u9f7f\u8f6e\u90fd\u4f7f\u6574\u4e2a\u7cfb\u7edf\u8fd0\u884c\u66f4\u987a\u7545\u3002\u4f8b\u5982\uff0c\u66f4\u5feb\u7684\u716e\u9762\u673a\u53ef\u4ee5\u5728\u7e41\u5fd9\u65f6\u6bb5\u5904\u7406\u66f4\u591a\u8ba2\u5355\u3002"}, {"question": "\u5e15\u5e15\u7684\u610f\u5927\u5229\u9762\u9986\u4e2d\u7684\u987e\u5ba2\u6ee1\u610f\u5ea6\u8ba1\u91cf\u5668\u662f\u5982\u4f55\u5de5\u4f5c\u7684\uff0c\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u5b83\uff1f", "answer": "\u5e15\u5e15\u7684\u610f\u5927\u5229\u9762\u9986\u4e2d\u7684\u987e\u5ba2\u6ee1\u610f\u5ea6\u8ba1\u91cf\u5668\u8861\u91cf\u987e\u5ba2\u5bf9\u7528\u9910\u4f53\u9a8c\u7684\u6ee1\u610f\u7a0b\u5ea6\u3002\u5b83\u53d7\u4ee5\u4e0b\u56e0\u7d20\u5f71\u54cd\uff1a\u6b65\u9aa41 - \u8ba2\u5355\u51c6\u786e\u6027\uff1b\u786e\u4fdd\u83dc\u80b4\u7b26\u5408\u987e\u5ba2\u7684\u8981\u6c42\u3002\u6b65\u9aa42 - \u53ca\u65f6\u6027\uff1b\u5728\u8010\u5fc3\u5ea6\u8ba1\u91cf\u5668\u8017\u5c3d\u4e4b\u524d\u63d0\u4f9b\u83dc\u80b4\u3002\u6b65\u9aa43 - \u98df\u6750\u6446\u76d8\uff1b\u6574\u6d01\u5730\u6392\u5217\u914d\u6599\u4ee5\u5438\u5f15\u89c6\u89c9\u6ce8\u610f\u3002\u4f8b\u5982\uff0c\u5b8c\u7f8e\u70f9\u8c03\u7684\u914d\u5e15\u5c14\u739b\u5e72\u916a\u7684\u4f5b\u5854\u9762\u6bd4\u51cc\u4e71\u7684\u6446\u76d8\u5f97\u5206\u66f4\u9ad8\u3002\u8bf7\u53c2\u8003[\u914d\u7f6e\u5bf9\u7167\u8868]\u83b7\u53d6\u7406\u60f3\u7684\u6446\u76d8\u6807\u51c6\u3002"}, {"question": "\u5e15\u5e15\u7684\u610f\u5927\u5229\u9762\u9986\u4e2d\uff0c\u98df\u6750\u65b0\u9c9c\u5ea6\u80cc\u540e\u7684\u9690\u85cf\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "\u5e15\u5e15\u7684\u610f\u5927\u5229\u9762\u9986\u4e2d\uff0c\u98df\u6750\u7684\u65b0\u9c9c\u5ea6\u662f\u4e00\u79cd\u5f71\u54cd\u83dc\u80b4\u8d28\u91cf\u7684\u9690\u85cf\u673a\u5236\u3002\u65b0\u9c9c\u7684\u98df\u6750\u63d0\u5347\u98ce\u5473\u548c\u987e\u5ba2\u6ee1\u610f\u5ea6\u3002\u6b65\u9aa41 - \u76d1\u63a7\u6bcf\u79cd\u98df\u6750\u7684\u65b0\u9c9c\u5ea6\u8ba1\u65f6\u5668\uff1b\u4f8b\u5982\uff0c\u7f57\u52d2\u6bd4\u5927\u849c\u66f4\u5bb9\u6613\u5931\u53bb\u65b0\u9c9c\u5ea6\u3002\u6b65\u9aa42 - \u4f7f\u7528[\u6d41\u7a0b\u56fe\u89e3]\u6765\u8ddf\u8e2a\u98df\u6750\u7684\u4fdd\u8d28\u671f\u5e76\u76f8\u5e94\u5730\u89c4\u5212\u5176\u4f7f\u7528\u3002\u6b65\u9aa43 - \u901a\u8fc7\u4f18\u5148\u4f7f\u7528\u8f83\u65e9\u98df\u6750\u6765\u8f6e\u6362\u5e93\u5b58\uff0c\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u6d6a\u8d39\u3002\u4f8b\u5982\uff0c\u5728\u9171\u6c41\u4e2d\u4f18\u5148\u4f7f\u7528\u8f83\u9648\u65e7\u7684\u897f\u7ea2\u67ff\uff0c\u4ee5\u514d\u8150\u70c2\u3002"}, {"question": "\u6211\u5982\u4f55\u5c06\u6211\u7684\u5e15\u5e15\u7684\u610f\u5927\u5229\u9762\u9986\u8fdb\u5ea6\u8f6c\u79fb\u5230\u65b0\u8bbe\u5907\uff1f", "answer": "\u8981\u5c06\u60a8\u7684\u5e15\u5e15\u7684\u610f\u5927\u5229\u9762\u9986\u8fdb\u5ea6\u8f6c\u79fb\u5230\u65b0\u8bbe\u5907\uff1a\u6b65\u9aa41 - \u786e\u4fdd\u4e24\u53f0\u8bbe\u5907\u90fd\u8fde\u63a5\u5230\u76f8\u540c\u7684\u4e91\u670d\u52a1\uff08\u4f8b\u5982 Google Play \u6216 Apple Game Center\uff09\u3002\u6b65\u9aa42 - \u5728\u65e7\u8bbe\u5907\u4e0a\u6253\u5f00\u6e38\u620f\uff0c\u5e76\u901a\u8fc7\u8bbe\u7f6e\u83dc\u5355\u4e2d\u7684\u4e91\u5b58\u6863\u9009\u9879\u540c\u6b65\u60a8\u7684\u8fdb\u5ea6\u3002\u6b65\u9aa43 - \u5728\u65b0\u8bbe\u5907\u4e0a\u5b89\u88c5\u6e38\u620f\u5e76\u767b\u5f55\u540c\u4e00\u4e91\u5e10\u6237\u4ee5\u68c0\u7d22\u60a8\u7684\u6570\u636e\u3002\u8bf7\u53c2\u8003[\u591a\u65b9\u6848\u5bf9\u6bd4]\u8868\u683c\uff0c\u6839\u636e\u60a8\u7684\u8bbe\u5907\u517c\u5bb9\u6027\u9009\u62e9\u6700\u4f73\u4e91\u670d\u52a1\u3002\u4f8b\u5982\uff0cGoogle Play \u975e\u5e38\u9002\u5408 Android \u7528\u6237\u3002"}, {"question": "\u5e15\u5e15\u7684\u610f\u5927\u5229\u9762\u9986\u4e2d\u7684\u9690\u85cf\u6210\u5c31\u6709\u54ea\u4e9b\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9501\u5b83\u4eec\uff1f", "answer": "\u5e15\u5e15\u7684\u610f\u5927\u5229\u9762\u9986\u4e2d\u7684\u9690\u85cf\u6210\u5c31\u901a\u5e38\u9700\u8981\u7279\u5b9a\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u5728\u6ca1\u6709\u9519\u8bef\u7684\u60c5\u51b5\u4e0b\u5b8c\u6210\u4e00\u5b9a\u6570\u91cf\u7684\u5b8c\u7f8e\u8ba2\u5355\uff1b\u4f8b\u5982\uff0c\u201c\u5b8c\u7f8e\u53a8\u5e08\u201d\u9700\u8981\u5b8c\u6210 50 \u4e2a\u5b8c\u7f8e\u8ba2\u5355\u3002\u6b65\u9aa42 - \u5c1d\u8bd5\u72ec\u7279\u7684\u914d\u6599\u7ec4\u5408\u4ee5\u89e3\u9501\u201c\u521b\u65b0\u53a8\u5e08\u201d\u3002\u6b65\u9aa43 - \u5728\u4e00\u5468\u5185\u5b8c\u6210\u6240\u6709\u6bcf\u65e5\u6311\u6218\u4ee5\u83b7\u5f97\u201c\u5468\u672b\u6218\u58eb\u201d\u3002\u8bf7\u53c2\u8003[\u6bd4\u55bb\u8bf4\u660e]\uff0c\u5c06\u8fd9\u4e9b\u6210\u5c31\u89c6\u4e3a\u9690\u85cf\u7684\u5b9d\u85cf\uff1b\u60a8\u9700\u8981\u63a2\u7d22\u548c\u5c1d\u8bd5\u65b0\u4e8b\u7269\u624d\u80fd\u627e\u5230\u5b83\u4eec\u3002"}, {"question": "\u5e15\u5e15\u7684\u610f\u5927\u5229\u9762\u9986\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8ba1\u7b97\u5c0f\u8d39\u548c\u603b\u4f53\u8bc4\u5206\u7684\uff1f", "answer": "\u5e15\u5e15\u7684\u610f\u5927\u5229\u9762\u9986\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u4e09\u4e2a\u56e0\u7d20\u8ba1\u7b97\u5c0f\u8d39\u548c\u603b\u4f53\u8bc4\u5206\uff1a\u6b65\u9aa41 - \u8ba2\u5355\u51c6\u786e\u6027\uff1b\u7f3a\u5c11\u6216\u9519\u8bef\u7684\u914d\u6599\u4f1a\u88ab\u6263\u5206\u3002\u6b65\u9aa42 - \u53ca\u65f6\u6027\uff1b\u66f4\u5feb\u7684\u670d\u52a1\u4f1a\u83b7\u5f97\u66f4\u9ad8\u7684\u5c0f\u8d39\u3002\u6b65\u9aa43 - \u98df\u6750\u6446\u76d8\uff1b\u6574\u6d01\u4e14\u5177\u6709\u89c6\u89c9\u5438\u5f15\u529b\u7684\u83dc\u80b4\u5f97\u5206\u66f4\u9ad8\u3002\u4f8b\u5982\uff0c\u4ee5\u5feb\u901f\u901f\u5ea6\u4e0a\u83dc\uff0c\u6240\u6709\u914d\u6599\u90fd\u6446\u653e\u6b63\u786e\u7684\u610f\u5927\u5229\u9762\u78b3\u70e4\u6bd4\u5ef6\u8fdf\u6216\u51cc\u4e71\u7684\u83dc\u80b4\u83b7\u5f97\u66f4\u9ad8\u7684\u5c0f\u8d39\u3002\u8bf7\u53c2\u8003[\u914d\u7f6e\u5bf9\u7167\u8868]\u83b7\u53d6\u8be6\u7ec6\u7684\u8bc4\u5206\u7ec6\u5206\u3002"}, {"question": "\u5728\u5e15\u5e15\u7684\u610f\u5927\u5229\u9762\u9986\u5904\u7406\u9ad8\u5cf0\u65f6\u6bb5\u7684\u6700\u4f73\u505a\u6cd5\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u5e15\u5e15\u7684\u610f\u5927\u5229\u9762\u9986\u5904\u7406\u9ad8\u5cf0\u65f6\u6bb5\u9700\u8981\u4e8b\u5148\u51c6\u5907\u548c\u5236\u5b9a\u7b56\u7565\uff1a\u6b65\u9aa41 - \u9884\u5148\u70f9\u996a\u53d7\u6b22\u8fce\u7684\u9762\u98df\u7c7b\u578b\u4ee5\u7f29\u77ed\u7b49\u5f85\u65f6\u95f4\u3002\u6b65\u9aa42 - \u4f7f\u7528[\u6d41\u7a0b\u56fe\u89e3]\u4ee5\u7b80\u5316\u5de5\u4f5c\u6d41\u7a0b\u5e76\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u5de5\u4f5c\u7ad9\u4e4b\u95f4\u7684\u79fb\u52a8\u3002\u6b65\u9aa43 - \u4e3a\u6bcf\u4e2a\u5de5\u4f5c\u7ad9\u5206\u914d\u7279\u5b9a\u4efb\u52a1\uff08\u4f8b\u5982\uff0c\u4e00\u4e2a\u4eba\u8d1f\u8d23\u70f9\u996a\uff0c\u53e6\u4e00\u4e2a\u4eba\u8d1f\u8d23\u7ec4\u5408\u83dc\u80b4\uff09\u3002\u4f8b\u5982\uff0c\u5728\u5348\u9910\u9ad8\u5cf0\u671f\uff0c\u51c6\u5907\u597d\u9884\u5148\u70f9\u8c03\u7684\u4f5b\u5854\u9762\u53ef\u4ee5\u5e2e\u52a9\u60a8\u5feb\u901f\u670d\u52a1\u66f4\u591a\u987e\u5ba2\u3002"}]
[{"question": "\u30d1\u30d1\u306e\u81ea\u5bb6\u88fd\u30d1\u30b9\u30bf\u5e97(Papa's Pastaria)\u3067\u6700\u521d\u306e\u6ce8\u6587\u3092\u59cb\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f\u57fa\u672c\u7684\u306a\u624b\u9806\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u306e\u30d1\u30b9\u30bf\u5e97\u3067\u6700\u521d\u306e\u6ce8\u6587\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71 - \u304a\u5ba2\u69d8\u3092\u304a\u8fce\u3048\u3057\u3001\u30d1\u30b9\u30bf\u306e\u7a2e\u985e\u3001\u30bd\u30fc\u30b9\u3001\u30c8\u30c3\u30d4\u30f3\u30b0\u3092\u30e1\u30e2\u3057\u306a\u304c\u3089\u6ce8\u6587\u3092\u53d6\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - \u30d1\u30b9\u30bf\u3092\u9069\u5207\u306a\u98df\u611f\u306b\u306a\u308b\u307e\u3067\u8339\u3067\u308b\u305f\u3081\u306b\u8abf\u7406\u5834\u306b\u79fb\u52d5\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u9078\u3070\u308c\u305f\u30bd\u30fc\u30b9\u3084\u30c8\u30c3\u30d4\u30f3\u30b0\u3092\u52a0\u3048\u3066\u6599\u7406\u3092\u7d44\u307f\u7acb\u3066\u3001\u304a\u5ba2\u69d8\u306b\u304a\u904b\u3073\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u304a\u5ba2\u69d8\u304c\u30ca\u30dd\u30ea\u30bf\u30f3\u3068\u30c8\u30de\u30c8\u30bd\u30fc\u30b9\u3068\u30d1\u30eb\u30df\u30b8\u30e3\u30fc\u30ce\u30c1\u30fc\u30ba\u3092\u6ce8\u6587\u3057\u305f\u5834\u5408\u3001\u30b9\u30d1\u30b2\u30c6\u30a3\u3092\u8339\u3067\u3001\u30c8\u30de\u30c8\u30bd\u30fc\u30b9\u3092\u52a0\u3048\u3001\u30d1\u30eb\u30df\u30b8\u30e3\u30fc\u30ce\u30c1\u30fc\u30ba\u3092\u30c8\u30c3\u30d4\u30f3\u30b0\u3057\u307e\u3059\u3002[\u30ec\u30b7\u30d4\u53c2\u7167\u8868]\u3092\u4f7f\u7528\u3057\u3066\u3001\u30d1\u30b9\u30bf\u306e\u7a2e\u985e\u3068\u7406\u60f3\u7684\u306a\u8abf\u7406\u6642\u9593\u3092\u7167\u5408\u3057\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u306e\u30d1\u30b9\u30bf\u5e97(Papa's Pastaria)\u306b\u304a\u3044\u3066\u3001\u6642\u9593\u7ba1\u7406\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u52b9\u7387\u3092\u9ad8\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u306e\u30d1\u30b9\u30bf\u5e97\u3067\u306f\u3001\u6642\u9593\u7ba1\u7406\u304c\u91cd\u8981\u3067\u3059\u3002\u305d\u308c\u306f\u3001\u9867\u5ba2\u6e80\u8db3\u5ea6\u3068\u30c1\u30c3\u30d7\u306b\u76f4\u63a5\u5f71\u97ff\u3059\u308b\u304b\u3089\u3067\u3059\u3002\u52b9\u7387\u3092\u9ad8\u3081\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71 - \u30de\u30eb\u30c1\u30bf\u30b9\u30af\u5316\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6b21\u306e\u6ce8\u6587\u3092\u53d7\u3051\u4ed8\u3051\u308b\u9593\u306b\u30d1\u30b9\u30bf\u3092\u8339\u3067\u59cb\u3081\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - [\u696d\u52d9\u30d5\u30ed\u30fc\u56f3]\u3092\u4f7f\u7528\u3057\u3066\u3001\u6ce8\u6587\u53d7\u4ed8\u304b\u3089\u63d0\u4f9b\u307e\u3067\u306e\u30ef\u30fc\u30af\u30d5\u30ed\u30fc\u3092\u8996\u899a\u5316\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u7e70\u308a\u8fd4\u3057\u7df4\u7fd2\u3057\u3066\u3001\u9045\u5ef6\u3092\u6e1b\u3089\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u4e00\u822c\u7684\u306a\u6750\u6599\u3092\u4e8b\u524d\u306b\u6e96\u5099\u3057\u3066\u304a\u304f\u3068\u6642\u9593\u304c\u7bc0\u7d04\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u304a\u6e6f\u3092\u5e38\u306b\u6cb8\u9a30\u3055\u305b\u3066\u304a\u304f\u3068\u3001\u65b0\u3057\u3044\u6ce8\u6587\u304c\u5165\u3063\u3066\u304d\u305f\u3068\u304d\u306b\u6642\u9593\u3092\u7bc0\u7d04\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u306e\u30d1\u30b9\u30bf\u5e97(Papa's Pastaria)\u3067\u8907\u6570\u306e\u6ce8\u6587\u3092\u7ba1\u7406\u3059\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u306e\u30d1\u30b9\u30bf\u5e97(Papa's Pastaria)\u3067\u8907\u6570\u306e\u6ce8\u6587\u3092\u7ba1\u7406\u3059\u308b\u306b\u306f\u3001\u6226\u7565\u7684\u306a\u8a08\u753b\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71 - \u6ce8\u6587\u30c1\u30b1\u30c3\u30c8\u30b7\u30b9\u30c6\u30e0\u3092\u4f7f\u7528\u3057\u3066\u3001\u9867\u5ba2\u306e\u5f85\u3061\u6642\u9593\u306b\u57fa\u3065\u3044\u3066\u30bf\u30b9\u30af\u3092\u512a\u5148\u9806\u4f4d\u4ed8\u3051\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - \u985e\u4f3c\u306e\u6ce8\u6587\u3092\u307e\u3068\u3081\u3066\u51e6\u7406\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u3059\u3079\u3066\u306e\u30b9\u30d1\u30b2\u30c6\u30a3\u6ce8\u6587\u3092\u540c\u6642\u306b\u8abf\u7406\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u5404\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u9593\u3067\u30bf\u30b9\u30af\u3092\u52b9\u7387\u7684\u306b\u5272\u308a\u5f53\u3066\u307e\u3059\u3002[\u8907\u6570\u306e\u65b9\u7b56\u6bd4\u8f03\u8868]\u3092\u53c2\u7167\u3057\u3066\u3001\u6ce8\u6587\u91cf\u306b\u57fa\u3065\u304d\u4e00\u62ec\u307e\u305f\u306f\u500b\u5225\u3067\u8abf\u7406\u3059\u308b\u304b\u3069\u3046\u304b\u3092\u6c7a\u5b9a\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d4\u30fc\u30af\u6642\u306b\u306f\u3001\u4e00\u62ec\u8abf\u7406\u3067\u5f85\u3061\u6642\u9593\u3092\u5927\u5e45\u306b\u77ed\u7e2e\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u306e\u30d1\u30b9\u30bf\u5e97(Papa's Pastaria)\u3067\u5229\u76ca\u3092\u6700\u5927\u5316\u3059\u308b\u305f\u3081\u306b\u512a\u5148\u3059\u3079\u304d\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u306e\u30d1\u30b9\u30bf\u5e97\u3067\u5229\u76ca\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u6b21\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71 - \u307e\u305a\u3001\u53a8\u623f\u6a5f\u5668\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u6295\u8cc7\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30d1\u30b9\u30bf\u306e\u8abf\u7406\u6642\u9593\u3092\u77ed\u7e2e\u3059\u308b\u305f\u3081\u306e\u9ad8\u901f\u306a\u30d1\u30b9\u30bf\u8339\u3067\u5668\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - \u9867\u5ba2\u306e\u56de\u8ee2\u7387\u3092\u9ad8\u3081\u3066\u30c1\u30c3\u30d7\u3092\u5897\u3084\u3059\u305f\u3081\u306b\u3001\u30c0\u30a4\u30cb\u30f3\u30b0\u30a8\u30ea\u30a2\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u3088\u308a\u591a\u304f\u306e\u9867\u5ba2\u3092\u5f15\u304d\u4ed8\u3051\u3001\u3088\u308a\u9ad8\u3044\u4fa1\u683c\u8a2d\u5b9a\u3092\u53ef\u80fd\u306b\u3059\u308b\u305f\u3081\u306b\u3001\u6750\u6599\u306e\u8cea\u3092\u9ad8\u3081\u307e\u3059\u3002[\u4f8b\u793a\u56f3]\u3092\u4f7f\u7528\u3057\u3066\u3001\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u6a5f\u68b0\u306e\u6b6f\u8eca\u306b\u4f8b\u3048\u307e\u3057\u3087\u3046\u3002\u5404\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u3088\u308a\u3001\u30b7\u30b9\u30c6\u30e0\u5168\u4f53\u304c\u30b9\u30e0\u30fc\u30ba\u306b\u52d5\u4f5c\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u9ad8\u901f\u30d1\u30b9\u30bf\u8339\u3067\u5668\u306f\u3001\u7e41\u5fd9\u6642\u9593\u5e2f\u306b\u591a\u304f\u306e\u6ce8\u6587\u3092\u51e6\u7406\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u306e\u30d1\u30b9\u30bf\u5e97(Papa's Pastaria)\u306e\u9867\u5ba2\u6e80\u8db3\u5ea6\u30e1\u30fc\u30bf\u30fc\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u4f55\u3092\u8003\u616e\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u306e\u30d1\u30b9\u30bf\u5e97\u306e\u9867\u5ba2\u6e80\u8db3\u5ea6\u30e1\u30fc\u30bf\u30fc\u306f\u3001\u9867\u5ba2\u304c\u98df\u4e8b\u4f53\u9a13\u306b\u3069\u308c\u307b\u3069\u6e80\u8db3\u3057\u3066\u3044\u308b\u304b\u3092\u6e2c\u5b9a\u3057\u307e\u3059\u3002\u5f71\u97ff\u3092\u53d7\u3051\u308b\u8981\u56e0\u306f\u4ee5\u4e0b\u306e\u901a\u308a\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71 - \u6ce8\u6587\u306e\u6b63\u78ba\u3055\u3002\u6599\u7406\u304c\u9867\u5ba2\u306e\u8981\u6c42\u3068\u4e00\u81f4\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - \u8fc5\u901f\u3055\u3002\u5fcd\u8010\u306e\u30e1\u30fc\u30bf\u30fc\u304c\u5207\u308c\u308b\u524d\u306b\u6599\u7406\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u30d7\u30ec\u30bc\u30f3\u30c6\u30fc\u30b7\u30e7\u30f3\u3002\u8996\u899a\u7684\u306a\u9b45\u529b\u306e\u305f\u3081\u306b\u30c8\u30c3\u30d4\u30f3\u30b0\u3092\u7dba\u9e97\u306b\u914d\u7f6e\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5747\u7b49\u306b\u30d1\u30eb\u30df\u30b8\u30e3\u30fc\u30ce\u30c1\u30fc\u30ba\u304c\u304b\u3051\u305f\u5b8c\u74a7\u306b\u8abf\u7406\u3055\u308c\u305f\u30d5\u30a7\u30c3\u30c8\u30c1\u30fc\u30cd\u30fb\u30a2\u30eb\u30d5\u30ec\u30fc\u30c9\u306f\u3001\u6563\u3089\u304b\u3063\u305f\u30d7\u30ec\u30bc\u30f3\u30c6\u30fc\u30b7\u30e7\u30f3\u3088\u308a\u3082\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u5f97\u307e\u3059\u3002[\u30ec\u30b7\u30d4\u53c2\u7167\u8868]\u306b\u8a18\u8f09\u3055\u308c\u3066\u3044\u308b\u7406\u60f3\u7684\u306a\u30d7\u30ec\u30bc\u30f3\u30c6\u30fc\u30b7\u30e7\u30f3\u57fa\u6e96\u3092\u53c2\u7167\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30d1\u30d1\u306e\u30d1\u30b9\u30bf\u5e97\u3067\u98df\u6750\u306e\u9bae\u5ea6\u306b\u95a2\u3059\u308b\u96a0\u3055\u308c\u305f\u4ed5\u7d44\u307f\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u306e\u30d1\u30b9\u30bf\u5e97\u3067\u98df\u6750\u306e\u9bae\u5ea6\u306f\u3001\u6599\u7406\u306e\u54c1\u8cea\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u96a0\u308c\u305f\u4ed5\u7d44\u307f\u3067\u3059\u3002\u65b0\u9bae\u306a\u98df\u6750\u306f\u3001\u98a8\u5473\u3068\u9867\u5ba2\u6e80\u8db3\u5ea6\u3092\u9ad8\u3081\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71 - \u5404\u98df\u6750\u306e\u65b0\u9bae\u3055\u30bf\u30a4\u30de\u30fc\u3092\u76e3\u8996\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d0\u30b8\u30eb\u306f\u30cb\u30f3\u30cb\u30af\u3088\u308a\u3082\u65e9\u304f\u9bae\u5ea6\u3092\u5931\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - [\u696d\u52d9\u30d5\u30ed\u30fc\u56f3]\u3092\u4f7f\u7528\u3057\u3066\u3001\u98df\u6750\u306e\u8cde\u5473\u671f\u9650\u3092\u8ffd\u8de1\u3057\u3001\u305d\u308c\u306b\u5fdc\u3058\u3066\u4f7f\u7528\u8a08\u753b\u3092\u7acb\u3066\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u5ec3\u68c4\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u308b\u305f\u3081\u306b\u3001\u53e4\u3044\u98df\u6750\u3092\u6700\u521d\u306b\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u5728\u5eab\u3092\u56de\u8ee2\u3055\u305b\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30bd\u30fc\u30b9\u306e\u30c8\u30de\u30c8\u304c\u8150\u308b\u524d\u306b\u3001\u53e4\u3044\u30c8\u30de\u30c8\u3092\u512a\u5148\u7684\u306b\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30d1\u30d1\u306e\u30d1\u30b9\u30bf\u5e97\u306e\u9032\u6357\u72b6\u6cc1\u3092\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u306e\u30d1\u30b9\u30bf\u5e97\u306e\u9032\u6357\u72b6\u6cc1\u3092\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001\u6b21\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71 - \u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u304c\u540c\u3058\u30af\u30e9\u30a6\u30c9\u30b5\u30fc\u30d3\u30b9\uff08Google Play\u307e\u305f\u306fApple Game Center\u306a\u3069\uff09\u306b\u63a5\u7d9a\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72 - \u53e4\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u30b2\u30fc\u30e0\u3092\u958b\u304d\u3001\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u306e\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u4f7f\u7528\u3057\u3066\u9032\u6357\u72b6\u6cc1\u3092\u540c\u671f\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u30b2\u30fc\u30e0\u3092\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u3001\u540c\u3058\u30af\u30e9\u30a6\u30c9\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u30c7\u30fc\u30bf\u3092\u53d6\u5f97\u3057\u307e\u3059\u3002[\u8907\u6570\u306e\u65b9\u7b56\u6bd4\u8f03\u8868]\u3092\u4f7f\u7528\u3057\u3066\u3001\u30c7\u30d0\u30a4\u30b9\u306e\u4e92\u63db\u6027\u306b\u57fa\u3065\u3044\u3066\u6700\u9069\u306a\u30af\u30e9\u30a6\u30c9\u30b5\u30fc\u30d3\u30b9\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u3001Google Play\u306fAndroid\u30e6\u30fc\u30b6\u30fc\u306b\u3068\u3063\u3066\u6700\u9069\u3067\u3059\u3002"}, {"question": "\u30d1\u30d1\u306e\u30d1\u30b9\u30bf\u5e97(Papa's Pastaria)\u306e\u79d8\u5bc6\u306e\u9054\u6210\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u308c\u3089\u3092\u3069\u306e\u3088\u3046\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u306e\u30d1\u30b9\u30bf\u5e97\u306e\u79d8\u5bc6\u306e\u9054\u6210\u306f\u3001\u591a\u304f\u306e\u5834\u5408\u3001\u7279\u5b9a\u306e\u30a2\u30af\u30b7\u30e7\u30f3\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71 - \u9593\u9055\u3044\u306a\u304f\u3001\u4e00\u5b9a\u6570\u306e\u5b8c\u74a7\u306a\u6ce8\u6587\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u5b8c\u74a7\u306a\u6599\u7406\u9577\u300d\u306b\u306f50\u56de\u306e\u5b8c\u74a7\u306a\u6ce8\u6587\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - \u72ec\u81ea\u306e\u6750\u6599\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u8a66\u3057\u3066\u3001\u300c\u9769\u65b0\u7684\u306a\u6599\u7406\u9577\u300d\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - 1\u9031\u9593\u3059\u3079\u3066\u306e\u30c7\u30a4\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u5b8c\u4e86\u3057\u3066\u300c\u9031\u672b\u306e\u6226\u58eb\u300d\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u307e\u3059\u3002[\u4f8b\u793a\u56f3]\u3092\u4f7f\u7528\u3057\u3066\u3001\u3053\u308c\u3089\u306e\u6210\u679c\u3092\u96a0\u3055\u308c\u305f\u5b9d\u7269\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u3089\u3092\u767a\u898b\u3059\u308b\u306b\u306f\u3001\u65b0\u3057\u3044\u3053\u3068\u3092\u63a2\u6c42\u3057\u3066\u8a66\u3057\u3066\u307f\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30d1\u30d1\u306e\u30d1\u30b9\u30bf\u5e97(Papa's Pastaria)\u306e\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30c1\u30c3\u30d7\u3084\u7dcf\u5408\u8a55\u4fa1\u3092\u3069\u306e\u3088\u3046\u306b\u8a08\u7b97\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u306e\u30d1\u30b9\u30bf\u5e97\u306e\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306f\u30013\u3064\u306e\u8981\u56e0\u306b\u57fa\u3065\u3044\u3066\u30c1\u30c3\u30d7\u3068\u7dcf\u5408\u8a55\u4fa1\u3092\u8a08\u7b97\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71 - \u6ce8\u6587\u306e\u6b63\u78ba\u3055\u3002\u6b20\u843d\u307e\u305f\u306f\u9593\u9055\u3063\u305f\u6750\u6599\u306b\u5bfe\u3057\u3066\u30dd\u30a4\u30f3\u30c8\u306f\u5dee\u3057\u5f15\u304b\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - \u8fc5\u901f\u3055\u3002\u3088\u308a\u8fc5\u901f\u306a\u30b5\u30fc\u30d3\u30b9\u307b\u3069\u9ad8\u3044\u30c1\u30c3\u30d7\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u30d7\u30ec\u30bc\u30f3\u30c6\u30fc\u30b7\u30e7\u30f3\u3002\u6574\u7136\u3068\u3057\u3066\u8996\u899a\u7684\u306b\u9b45\u529b\u7684\u306a\u6599\u7406\u306f\u3088\u308a\u826f\u3044\u8a55\u4fa1\u3092\u5f97\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u3059\u3079\u3066\u306e\u6750\u6599\u304c\u6b63\u3057\u304f\u914d\u7f6e\u3055\u308c\u3001\u8fc5\u901f\u306b\u63d0\u4f9b\u3055\u308c\u305f\u30b9\u30d1\u30b2\u30c3\u30c6\u30a3\u30fb\u30ab\u30eb\u30dc\u30ca\u30fc\u30e9\u306f\u3001\u9045\u308c\u305f\u308a\u3001\u6563\u3089\u304b\u3063\u305f\u308a\u3059\u308b\u6599\u7406\u3088\u308a\u3082\u9ad8\u3044\u30c1\u30c3\u30d7\u3092\u5f97\u307e\u3059\u3002\u8a73\u7d30\u306a\u30b9\u30b3\u30a2\u5206\u3051\u306b\u3064\u3044\u3066\u306f[\u30ec\u30b7\u30d4\u53c2\u7167\u8868]\u3092\u53c2\u7167\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30d1\u30d1\u306e\u30d1\u30b9\u30bf\u5e97(Papa's Pastaria)\u3067\u30d4\u30fc\u30af\u6642\u9593\u5e2f\u3092\u51e6\u7406\u3059\u308b\u305f\u3081\u306e\u30d9\u30b9\u30c8\u30d7\u30e9\u30af\u30c6\u30a3\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d1\u306e\u30d1\u30b9\u30bf\u5e97\u3067\u30d4\u30fc\u30af\u6642\u9593\u5e2f\u3092\u51e6\u7406\u3059\u308b\u306b\u306f\u3001\u6e96\u5099\u3068\u6226\u7565\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71 - \u4eba\u6c17\u306e\u30d1\u30b9\u30bf\u306e\u7a2e\u985e\u3092\u4e8b\u524d\u306b\u8abf\u7406\u3057\u3066\u3001\u5f85\u3061\u6642\u9593\u3092\u77ed\u7e2e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - [\u696d\u52d9\u30d5\u30ed\u30fc\u56f3]\u3092\u4f7f\u7528\u3057\u3066\u30ef\u30fc\u30af\u30d5\u30ed\u30fc\u3092\u5408\u7406\u5316\u3057\u3001\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u9593\u306e\u79fb\u52d5\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u5404\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u306b\u7279\u5b9a\u306e\u30bf\u30b9\u30af\u3092\u5272\u308a\u5f53\u3066\u307e\u3059(\u305f\u3068\u3048\u3070\u30011\u4eba\u306f\u8abf\u7406\u3092\u62c5\u5f53\u3057\u3001\u3082\u30461\u4eba\u306f\u6599\u7406\u3092\u7d44\u307f\u7acb\u3066\u307e\u3059)\u3002\u305f\u3068\u3048\u3070\u3001\u30e9\u30f3\u30c1\u30bf\u30a4\u30e0\u306e\u30d4\u30fc\u30af\u6642\u306b\u306f\u3001\u4e8b\u524d\u306b\u8abf\u7406\u3057\u3066\u304a\u3044\u305f\u30d5\u30a7\u30c3\u30c8\u30c1\u30fc\u30cd\u304c\u3042\u308b\u3068\u3001\u3088\u308a\u591a\u304f\u306e\u9867\u5ba2\u3092\u8fc5\u901f\u306b\u63d0\u4f9b\u3067\u304d\u307e\u3059\u3002"}]
[{"question": "\ud30c\ud30c\uc2a4 \ud30c\uc2a4\ud0c0\ub9ac\uc544\uc5d0\uc11c \uccab \ubc88\uc9f8 \uc8fc\ubb38\uc744 \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud558\uace0 \uae30\ubcf8 \ub2e8\uacc4\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud30c\uc2a4\ud0c0\ub9ac\uc544\uc5d0\uc11c \uccab \ubc88\uc9f8 \uc8fc\ubb38\uc744 \uc2dc\uc791\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1 - \uace0\uac1d\uc744 \ub9de\uc774\ud558\uace0 \ud30c\uc2a4\ud0c0 \uc885\ub958, \uc18c\uc2a4 \ubc0f \ud1a0\ud551\uc744 \uae30\ub85d\ud558\uba74\uc11c \uc8fc\ubb38\uc744 \ubc1b\uc73c\uc138\uc694. STEP2 - \ud30c\uc2a4\ud0c0\ub97c \uc801\uc808\ud55c \uc2dd\uac10\uc73c\ub85c \uc775\ub3c4\ub85d \uc870\ub9ac\ub300\uc5d0\uc11c \ud30c\uc2a4\ud0c0\ub97c \ub053\uc774\uc138\uc694. STEP3 - \uc120\ud0dd\ud55c \uc18c\uc2a4\uc640 \ud1a0\ud551\uc744 \ucd94\uac00\ud558\uc5ec \uc694\ub9ac\ub97c \uc644\uc131\ud55c \ub2e4\uc74c \uace0\uac1d\uc5d0\uac8c \uc81c\uacf5\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uace0\uac1d\uc774 \ub9c8\ub9ac\ub098\ub77c \uc18c\uc2a4\uc640 \ud30c\ub974\uba54\uc0b0 \uce58\uc988\uac00 \uacc1\ub4e4\uc5ec\uc9c4 \uc2a4\ud30c\uac8c\ud2f0\ub97c \uc8fc\ubb38\ud558\uba74 \uc2a4\ud30c\uac8c\ud2f0\ub97c \ub053\uc774\uace0, \ub9c8\ub9ac\ub098\ub77c\ub97c \ub123\uace0, \ud30c\ub974\uba54\uc0b0 \uce58\uc988\ub97c \ubfcc\ub9ac\uc138\uc694. [\ub808\uc2dc\ud53c \ucc38\uc870\ud45c]\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud30c\uc2a4\ud0c0 \uc885\ub958\uc640 \uc801\uc808\ud55c \uc870\ub9ac \uc2dc\uac04\uc744 \uc77c\uce58\uc2dc\ud0a4\uc138\uc694."}, {"question": "\ud30c\ud30c\uc2a4 \ud30c\uc2a4\ud0c0\ub9ac\uc544\uc5d0\uc11c \uc2dc\uac04 \uad00\ub9ac\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70 \ud6a8\uc728\uc131\uc744 \uc5b4\ub5bb\uac8c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud30c\uc2a4\ud0c0\ub9ac\uc544\uc5d0\uc11c \uc2dc\uac04 \uad00\ub9ac\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \uace0\uac1d \ub9cc\uc871\ub3c4\uc640 \ud301\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \ud6a8\uc728\uc131\uc744 \ub192\uc774\ub824\uba74 \ub2e4\uc74c\uacfc \uac19\uc774 \ud558\uc138\uc694: STEP1 - \uc5ec\ub7ec \uc791\uc5c5\uc744 \ubcd1\ud589\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4 \ub2e4\uc74c \uc8fc\ubb38\uc744 \ubc1b\ub294 \ub3d9\uc548 \ud30c\uc2a4\ud0c0\ub97c \ub053\uc774\uae30 \uc2dc\uc791\ud558\uc138\uc694. STEP2 - [\uc791\uc5c5 \ud750\ub984\ub3c4]\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc8fc\ubb38 \uc811\uc218\ubd80\ud130 \uc81c\uacf5\uae4c\uc9c0\uc758 \uc791\uc5c5 \ud750\ub984\uc744 \uc2dc\uac01\ud654\ud558\uc138\uc694. STEP3 - \ubc18\ubcf5\uc801\uc778 \uc5f0\uc2b5\uc744 \ud1b5\ud574 \uc9c0\uc5f0\uc744 \uc904\uc774\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc77c\ubc18 \uc7ac\ub8cc\ub97c \ubbf8\ub9ac \uc900\ube44\ud558\uba74 \uc2dc\uac04\uc744 \uc808\uc57d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub0c4\ube44\uc5d0 \ubb3c\uc744 \ub053\uc5ec \ub450\uba74 \uc0c8\ub85c\uc6b4 \uc8fc\ubb38\uc774 \ub4e4\uc5b4\uc62c \ub54c \uc2dc\uac04\uc744 \uc808\uc57d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c\uc2a4 \ud30c\uc2a4\ud0c0\ub9ac\uc544\uc5d0\uc11c \uc5ec\ub7ec \uc8fc\ubb38\uc744 \uad00\ub9ac\ud558\ub294 \ucd5c\uc0c1\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud30c\uc2a4\ud0c0\ub9ac\uc544\uc5d0\uc11c \uc5ec\ub7ec \uc8fc\ubb38\uc744 \uad00\ub9ac\ud558\ub824\uba74 \uc804\ub7b5\uc801\uc778 \uacc4\ud68d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4: STEP1 - \uc190\ub2d8 \ub300\uae30 \uc2dc\uac04\uc744 \uae30\uc900\uc73c\ub85c \uc791\uc5c5 \uc6b0\uc120\uc21c\uc704\ub97c \uc815\ud558\ub294 \uc8fc\ubb38 \ud2f0\ucf13 \uc2dc\uc2a4\ud15c\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. STEP2 - \uc720\uc0ac\ud55c \uc8fc\ubb38\uc744 \uadf8\ub8f9\ud654\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ubaa8\ub4e0 \uc2a4\ud30c\uac8c\ud2f0 \uc8fc\ubb38\uc744 \ub3d9\uc2dc\uc5d0 \uc694\ub9ac\ud558\uc138\uc694. STEP3 - \uac01 \uc5c5\ubb34\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \ub098\ub220 \ucc98\ub9ac\ud558\uc138\uc694. [\ub2e4\uc591\ud55c \ud574\uacb0 \ubc29\uc548 \ube44\uad50\ud45c]\ub97c \ucc38\uc870\ud558\uc5ec \uc8fc\ubb38\ub7c9\uc5d0 \ub530\ub77c \uc77c\uad04 \uc694\ub9ac \ub610\ub294 \uac1c\ubcc4 \uc694\ub9ac\ub97c \uacb0\uc815\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud63c\uc7a1\ud55c \uc2dc\uac04\ub300\uc5d0\ub294 \uc77c\uad04 \uc694\ub9ac\ub97c \ud1b5\ud574 \ub300\uae30 \uc2dc\uac04\uc744 \ud06c\uac8c \uc904\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c\uc2a4 \ud30c\uc2a4\ud0c0\ub9ac\uc544\uc5d0\uc11c \uc774\uc724\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \uc5b4\ub5a4 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc6b0\uc120\uc2dc\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud30c\uc2a4\ud0c0\ub9ac\uc544\uc5d0\uc11c \uc774\uc724\uc744 \uadf9\ub300\ud654\ud558\ub824\uba74 \ub2e4\uc74c \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc6b0\uc120\uc2dc\ud558\uc138\uc694: STEP1 - \uba3c\uc800 \uc8fc\ubc29 \uc7a5\ube44 \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0 \ud22c\uc790\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud30c\uc2a4\ud0c0 \ub053\uc774\ub294 \uc2dc\uac04\uc744 \ub2e8\ucd95\ud558\ub294 \ube60\ub978 \ud30c\uc2a4\ud0c0 \uc0b6\ub294 \uc1a5\uc744 \uc124\uce58\ud558\uc138\uc694. STEP2 - \uace0\uac1d\uc758 \ud68c\uc804\uc728\uacfc \ud301\uc744 \ub298\ub9ac\uae30 \uc704\ud574 \uc2dd\uc0ac \uacf5\uac04\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc138\uc694. STEP3 - \ub354 \ub9ce\uc740 \uace0\uac1d\uc744 \uc720\uce58\ud558\uace0 \ub354 \ub192\uc740 \uac00\uaca9 \ucc45\uc815\uc744 \uc704\ud55c \uc7ac\ub8cc\uc758 \ud488\uc9c8\uc744 \ub192\uc774\uc138\uc694. [\ube44\uad50 \uc124\uba85]\uc744 \uc0ac\uc6a9\ud558\uc5ec \uae30\uacc4\uc758 \ubd80\ud488\ub4e4\uc744 \ube44\uad50\ud574 \ubcf4\uc138\uc694. \uac01 \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \uc804\uccb4 \uc2dc\uc2a4\ud15c\uc744 \ub354\uc6b1 \uc6d0\ud65c\ud558\uac8c \uc791\ub3d9\ud558\ub3c4\ub85d \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ube60\ub978 \ud30c\uc2a4\ud0c0 \ub053\uc774\ub294 \uc1a5\uc740 \ubc14\uc05c \uc2dc\uac04\uc5d0 \ub354 \ub9ce\uc740 \uc8fc\ubb38\uc744 \ucc98\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c\uc2a4 \ud30c\uc2a4\ud0c0\ub9ac\uc544\uc758 \uace0\uac1d \ub9cc\uc871\ub3c4 \uacc4\uc0b0\uae30\ub294 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \ubb34\uc5c7\uc774 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud30c\uc2a4\ud0c0\ub9ac\uc544\uc758 \uace0\uac1d \ub9cc\uc871\ub3c4 \uacc4\uc0b0\uae30\ub294 \uace0\uac1d\ub4e4\uc774 \uc2dd\uc0ac \uacbd\ud5d8\uc5d0 \uc5bc\ub9c8\ub098 \ub9cc\uc871\ud558\ub294\uc9c0\ub97c \uce21\uc815\ud569\ub2c8\ub2e4. \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc694\uc778\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: STEP1 - \uc8fc\ubb38 \uc815\ud655\ub3c4; \uc694\ub9ac\uac00 \uace0\uac1d\uc758 \uc694\uccad\uacfc \uc77c\uce58\ud558\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. STEP2 - \uc2dc\uac04 \uc900\uc218; \uc778\ub0b4\uc2ec \uacc4\uc0b0\uae30\uac00 \uac00\ub3d9\ub418\ub294 \uc2dc\uac04 \uc774\uc804\uc5d0 \uc694\ub9ac\ub97c \uc81c\uacf5\ud558\uc138\uc694. STEP3 - \uc81c\uc2dc; \uc2dc\uac01\uc801\uc778 \ub9e4\ub825\uc744 \uc704\ud574 \ud1a0\ud551\uc744 \uae54\ub054\ud558\uac8c \uc815\ub3c8\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uace8\uace0\ub8e8 \ud30c\ub974\uba54\uc0b0 \uce58\uc988\uac00 \ubfcc\ub824\uc9c4 \uc644\ubcbd\ud558\uac8c \uc870\ub9ac\ub41c \ud398\ud22c\uce58\ub124 \uc54c\ud504\ub808\ub3c4\ub294 \uc5b4\uc218\uc120\ud55c \uc81c\uc2dc\ubcf4\ub2e4 \ub354 \ub192\uc740 \uc810\uc218\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. [\ud45c\uc900 \uc138\ubd80\uc0ac\ud56d]\uc744 \ucc38\uc870\ud558\uc138\uc694."}, {"question": "\ud30c\ud30c\uc2a4 \ud30c\uc2a4\ud0c0\ub9ac\uc544\uc5d0\uc11c \uc7ac\ub8cc\uc758 \uc2e0\uc120\ud568 \uc774\uba74\uc758 \uc228\uaca8\uc9c4 \uc6d0\ub9ac\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud30c\uc2a4\ud0c0\ub9ac\uc544\uc5d0\uc11c \uc7ac\ub8cc\uc758 \uc2e0\uc120\ud568\uc740 \uc694\ub9ac \ud488\uc9c8\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc228\uaca8\uc9c4 \uc6d0\ub9ac\uc785\ub2c8\ub2e4. \uc2e0\uc120\ud55c \uc7ac\ub8cc\ub294 \ud48d\ubbf8\uc640 \uace0\uac1d \ub9cc\uc871\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4. STEP1 - \uac01 \uc7ac\ub8cc\uc5d0 \ub300\ud55c \uc2e0\uc120\ub3c4 \ud0c0\uc774\uba38\ub97c \ud655\uc778\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ubc14\uc9c8\uc740 \ub9c8\ub298\ubcf4\ub2e4 \uc2e0\uc120\ub3c4\uac00 \ube68\ub9ac \ub5a8\uc5b4\uc9d1\ub2c8\ub2e4. STEP2 - [\uc791\uc5c5 \ud750\ub984\ub3c4]\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc7ac\ub8cc\uc758 \uc720\ud1b5 \uae30\ud55c\uc744 \ucd94\uc801\ud558\uace0 \uc774\uc5d0 \ub530\ub77c \uc0ac\uc6a9 \uacc4\ud68d\uc744 \uc138\uc6b0\uc138\uc694. STEP3 - \ub354 \uc624\ub798\ub41c \uc7ac\ub8cc\ub97c \uba3c\uc800 \uc0ac\uc6a9\ud558\uc5ec \uc7ac\uace0\ub97c \ud68c\uc804\uc2dc\ucf1c \ub0ad\ube44\ub97c \ucd5c\uc18c\ud654\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc369\uae30 \uc804\uc5d0 \ud1a0\ub9c8\ud1a0\ub97c \uc18c\uc2a4\uc5d0 \uba3c\uc800 \uc0ac\uc6a9\ud558\uc138\uc694."}, {"question": "\uc0c8\ub85c\uc6b4 \uae30\uae30\ub85c \ud30c\ud30c\uc2a4 \ud30c\uc2a4\ud0c0\ub9ac\uc544\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc0c8\ub85c\uc6b4 \uae30\uae30\ub85c \ud30c\ud30c\uc2a4 \ud30c\uc2a4\ud0c0\ub9ac\uc544\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1 - \ub450 \uae30\uae30 \ubaa8\ub450 \ub3d9\uc77c\ud55c \ud074\ub77c\uc6b0\ub4dc \uc11c\ube44\uc2a4(\uc608: Google Play \ub610\ub294 Apple Game Center)\uc5d0 \uc5f0\uacb0\ub418\uc5b4 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. STEP2 - \uae30\uc874 \uae30\uae30\uc5d0\uc11c \uac8c\uc784\uc744 \uc5f4\uace0 \uc124\uc815 \uba54\ub274\uc5d0\uc11c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uc635\uc158\uc744 \ud1b5\ud574 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud558\uc138\uc694. STEP3 - \uc0c8\ub85c\uc6b4 \uae30\uae30\uc5d0\uc11c \uac8c\uc784\uc744 \uc124\uce58\ud558\uace0 \ub3d9\uc77c\ud55c \ud074\ub77c\uc6b0\ub4dc \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uc5ec \ub370\uc774\ud130\ub97c \uac80\uc0c9\ud558\uc138\uc694. [\ub2e4\uc591\ud55c \ud574\uacb0 \ubc29\uc548 \ube44\uad50\ud45c]\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc7a5\uce58 \ud638\ud658\uc131\uc744 \uae30\uc900\uc73c\ub85c \ucd5c\uace0\uc758 \ud074\ub77c\uc6b0\ub4dc \uc11c\ube44\uc2a4\ub97c \uc120\ud0dd\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, Google Play\ub294 Android \uc0ac\uc6a9\uc790\uc5d0\uac8c \uc801\ud569\ud569\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c\uc2a4 \ud30c\uc2a4\ud0c0\ub9ac\uc544\uc758 \ube44\ubc00 \uc131\ucde8\ub294 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud30c\uc2a4\ud0c0\ub9ac\uc544\uc758 \ube44\ubc00 \uc131\ucde8\ub294 \uc885\uc885 \ud2b9\uc815 \ud589\ub3d9\uc744 \ud544\uc694\ub85c \ud569\ub2c8\ub2e4: STEP1 - \uc2e4\uc218 \uc5c6\uc774 \ud2b9\uc815 \uc22b\uc790\uc758 \uc644\ubcbd\ud55c \uc8fc\ubb38\uc744 \uc81c\uacf5\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \"\uc644\ubcbd\ud55c \uc694\ub9ac\uc0ac\"\uc5d0\ub294 50\uac1c\uc758 \uc644\ubcbd\ud55c \uc8fc\ubb38\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP2 - \ub3c5\ud2b9\ud55c \uc7ac\ub8cc \uc870\ud569\uc744 \uc2dc\ub3c4\ud558\uc5ec \"\ud601\uc2e0\uc801\uc778 \uc694\ub9ac\uc0ac\"\ub97c \ud574\uc81c\ud558\uc138\uc694. STEP3 - \uc77c\uc8fc\uc77c \ub3d9\uc548 \ubaa8\ub4e0 \uc77c\uc77c \ucc4c\ub9b0\uc9c0 \uc644\ub8cc\ud558\uc5ec \"\uc8fc\ub9d0 \uc804\uc0ac\"\ub97c \ub2ec\uc131\ud558\uc138\uc694. [\ube44\uad50 \uc124\uba85]\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc774\ub7ec\ud55c \uc131\ucde8\ub294 \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uacfc \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uc138\uc694. \uc0c8\ub85c\uc6b4 \uac83\uc744 \ud0d0\ud5d8\ud558\uace0 \uc2dc\ub3c4\ud574\uc57c \ud569\ub2c8\ub2e4."}, {"question": "\ud30c\ud30c\uc2a4 \ud30c\uc2a4\ud0c0\ub9ac\uc544\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ud301\uacfc \uc804\uccb4 \ub4f1\uae09\uc744 \uc5b4\ub5bb\uac8c \uacc4\uc0b0\ud569\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud30c\uc2a4\ud0c0\ub9ac\uc544\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc138 \uac00\uc9c0 \uc694\uc18c\ub97c \uae30\uc900\uc73c\ub85c \ud301\uacfc \uc804\uccb4 \ub4f1\uae09\uc744 \uacc4\uc0b0\ud569\ub2c8\ub2e4: STEP1 - \uc8fc\ubb38 \uc815\ud655\ub3c4; \ub204\ub77d \ub610\ub294 \uc798\ubabb\ub41c \uc7ac\ub8cc\uc5d0 \ub300\ud574 \uc810\uc218\uac00 \uac10\uc810\ub429\ub2c8\ub2e4. STEP2 - \uc2dc\uac04 \uc900\uc218; \ub354 \ube60\ub978 \uc11c\ube44\uc2a4\ub294 \ub354 \ub192\uc740 \ud301\uc744 \uc5bb\uc2b5\ub2c8\ub2e4. STEP3 - \uc81c\uc2dc; \uae54\ub054\ud558\uace0 \uc2dc\uac01\uc801\uc73c\ub85c \ub9e4\ub825\uc801\uc778 \uc694\ub9ac\ub294 \ub354 \ub192\uc740 \uc810\uc218\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc2e0\uc18d\ud558\uac8c \uc81c\uacf5\ub418\uace0 \ubaa8\ub4e0 \uc7ac\ub8cc\uc758 \uc704\uce58\uac00 \uc815\ud655\ud55c \uc2a4\ud30c\uac8c\ud2f0 \uce74\ub974\ubcf4\ub098\ub77c\ub294 \ub354 \ube60\ub974\uace0 \uae54\ub054\ud55c \uc694\ub9ac\ubcf4\ub2e4 \ub354 \ub192\uc740 \ud301\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. [\ud45c\uc900 \uc138\ubd80\uc0ac\ud56d]\uc744 \ucc38\uc870\ud558\uc138\uc694."}, {"question": "\ud30c\ud30c\uc2a4 \ud30c\uc2a4\ud0c0\ub9ac\uc544\uc5d0\uc11c \ud63c\uc7a1\ud55c \uc2dc\uac04\ub300\ub97c \ucc98\ub9ac\ud558\ub294 \ucd5c\uc0c1\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\ud30c\uc2a4 \ud30c\uc2a4\ud0c0\ub9ac\uc544\uc5d0\uc11c \ud63c\uc7a1\ud55c \uc2dc\uac04\ub300\ub97c \ucc98\ub9ac\ud558\ub824\uba74 \uc900\ube44\uc640 \uc804\ub7b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4: STEP1 - \uc778\uae30 \uc788\ub294 \ud30c\uc2a4\ud0c0 \uc885\ub958\ub97c \ubbf8\ub9ac \uc870\ub9ac\ud558\uc5ec \ub300\uae30 \uc2dc\uac04\uc744 \ub2e8\ucd95\ud558\uc138\uc694. STEP2 - [\uc791\uc5c5 \ud750\ub984\ub3c4]\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc791\uc5c5 \ud750\ub984\uc744 \uac04\uc18c\ud654\ud558\uace0 \uac01 \uc5ed\ud560 \uac04 \uc774\ub3d9\uc744 \ucd5c\uc18c\ud654\ud558\uc138\uc694. STEP3 - \uac01 \uc5ed\ud560\uc5d0 \ud2b9\uc815 \uc791\uc5c5\uc744 \ud560\ub2f9\ud558\uc138\uc694(\uc608: \ud55c \uc0ac\ub78c\uc740 \uc694\ub9ac\ub97c \ub2f4\ub2f9\ud558\uace0 \ub2e4\ub978 \uc0ac\ub78c\uc740 \uc694\ub9ac\ub97c \uc870\ub9bd). \uc608\ub97c \ub4e4\uc5b4, \uc810\uc2ec \uc2dc\uac04 \ubd90 \ub54c \ubbf8\ub9ac \uc870\ub9ac\ub41c \ud398\ud22c\uce58\ub124\ub97c \uc900\ube44\ud558\uba74 \uace0\uac1d\uc744 \ub354 \uc2e0\uc18d\ud558\uac8c \uc11c\ube44\uc2a4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
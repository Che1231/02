[{"question": "\u5982\u4f55\u958b\u59cb\u6211\u5728\u5e15\u5e15\u7fa9\u5927\u5229\u9eb5\u9928\u7684\u7b2c\u4e00\u7b46\u8a02\u55ae\uff0c\u4ee5\u53ca\u57fa\u672c\u6b65\u9a5f\u70ba\u4f55\uff1f", "answer": "\u8981\u958b\u59cb\u60a8\u5728\u5e15\u5e15\u7fa9\u5927\u5229\u9eb5\u9928\u7684\u7b2c\u4e00\u7b46\u8a02\u55ae\uff0c\u8acb\u6309\u7167\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f 1 - \u6b61\u8fce\u9867\u5ba2\u4e26\u63a5\u53d7\u4ed6\u5011\u7684\u8a02\u55ae\uff0c\u8a73\u8a18\u4ed6\u5011\u7684\u9eb5\u98df\u7a2e\u985e\u3001\u91ac\u6c41\u548c\u914d\u6599\u3002\u6b65\u9a5f 2 - \u79fb\u52d5\u5230\u70f9\u98ea\u5340\u716e\u9eb5\uff0c\u78ba\u4fdd\u9eb5\u98df\u716e\u5230\u6b63\u78ba\u7684\u53e3\u611f\u3002\u6b65\u9a5f 3 - \u5c07\u9078\u5b9a\u7684\u91ac\u6c41\u548c\u914d\u6599\u6dfb\u52a0\u5230\u9910\u9ede\u4e2d\uff0c\u7136\u5f8c\u5c07\u5176\u7aef\u7d66\u9867\u5ba2\u3002\u4f8b\u5982\uff0c\u5982\u679c\u9867\u5ba2\u9ede\u7684\u662f\u914d\u746a\u5229\u5a1c\u91ac\u548c\u5e15\u746a\u68ee\u8d77\u53f8\u7684\u7fa9\u5927\u5229\u9eb5\uff0c\u60a8\u5c07\u716e\u719f\u7fa9\u5927\u5229\u9eb5\uff0c\u52a0\u5165\u746a\u5229\u5a1c\u91ac\uff0c\u4e26\u5728\u4e0a\u9762\u7051\u4e0a\u5e15\u746a\u68ee\u8d77\u53f8\u3002\u8acb\u4f7f\u7528 [\u914d\u7f6e\u5c0d\u7167\u8868] \u4f86\u5c0d\u61c9\u9eb5\u98df\u7a2e\u985e\u53ca\u5176\u7406\u60f3\u7684\u70f9\u98ea\u6642\u9593\u3002"}, {"question": "\u6642\u9593\u70ba\u4f55\u5728\u5e15\u5e15\u7fa9\u5927\u5229\u9eb5\u9928\u81f3\u95dc\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u63d0\u5347\u6211\u7684\u6548\u7387\uff1f", "answer": "\u6642\u9593\u5728\u5e15\u5e15\u7fa9\u5927\u5229\u9eb5\u9928\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u76f4\u63a5\u5f71\u97ff\u9867\u5ba2\u6eff\u610f\u5ea6\u548c\u60a8\u7684\u5c0f\u8cbb\u3002\u8981\u63d0\u5347\u6548\u7387\uff1a\u6b65\u9a5f 1 - \u512a\u5148\u8655\u7406\u591a\u5de5\uff1b\u4f8b\u5982\uff0c\u5728\u63a5\u4e0b\u4e00\u500b\u8a02\u55ae\u7684\u540c\u6642\u958b\u59cb\u716e\u9eb5\u3002\u6b65\u9a5f 2 - \u4f7f\u7528 [\u6d41\u7a0b\u5716\u89e3] \u4f86\u8996\u89ba\u5316\u5f9e\u8a02\u55ae\u63a5\u53d6\u5230\u9001\u9910\u7684\u5de5\u4f5c\u6d41\u7a0b\u3002\u6b65\u9a5f 3 - \u53cd\u8986\u7df4\u7fd2\u4ee5\u6e1b\u5c11\u5ef6\u8aa4\uff0c\u4f8b\u5982\u9810\u5148\u6e96\u5099\u5e38\u898b\u7684\u98df\u6750\u3002\u4f8b\u5982\uff0c\u4fdd\u6301\u4e00\u934b\u6c34\u6cb8\u9a30\uff0c\u7576\u65b0\u7684\u8a02\u55ae\u9032\u4f86\u6642\u5c31\u80fd\u7bc0\u7701\u6642\u9593\u3002"}, {"question": "\u5728\u5e15\u5e15\u7fa9\u5927\u5229\u9eb5\u9928\u7ba1\u7406\u591a\u500b\u8a02\u55ae\u7684\u6700\u4f73\u7b56\u7565\u70ba\u4f55\uff1f", "answer": "\u5728\u5e15\u5e15\u7fa9\u5927\u5229\u9eb5\u9928\u7ba1\u7406\u591a\u500b\u8a02\u55ae\u9700\u8981\u7b56\u7565\u6027\u898f\u5283\uff1a\u6b65\u9a5f 1 - \u4f7f\u7528\u8a02\u55ae\u7968\u5238\u7cfb\u7d71\u4f9d\u9867\u5ba2\u7b49\u5019\u6642\u9593\u4f86\u512a\u5148\u8655\u7406\u4efb\u52d9\u3002\u6b65\u9a5f 2 - \u5c07\u76f8\u4f3c\u8a02\u55ae\u5206\u7d44\uff1b\u4f8b\u5982\uff0c\u540c\u6642\u70f9\u98ea\u6240\u6709\u7fa9\u5927\u5229\u9eb5\u8a02\u55ae\u3002\u6b65\u9a5f 3 - \u5728\u5404\u500b\u5de5\u4f5c\u7ad9\u6709\u6548\u5730\u5206\u914d\u4efb\u52d9\u3002\u53c3\u8003 [\u591a\u65b9\u6848\u5c0d\u6bd4] \u8868\u683c\uff0c\u6c7a\u5b9a\u662f\u5206\u6279\u70f9\u98ea\u9084\u662f\u500b\u5225\u70f9\u98ea\uff0c\u53d6\u6c7a\u65bc\u8a02\u55ae\u6578\u91cf\u3002\u4f8b\u5982\uff0c\u5728\u5c16\u5cf0\u6642\u9593\uff0c\u5206\u6279\u70f9\u98ea\u53ef\u4ee5\u986f\u8457\u7e2e\u77ed\u7b49\u5019\u6642\u9593\u3002"}, {"question": "\u5728\u5e15\u5e15\u7fa9\u5927\u5229\u9eb5\u9928\u70ba\u4e86\u6700\u5927\u5316\u5229\u6f64\uff0c\u6211\u61c9\u8a72\u512a\u5148\u5347\u7d1a\u54ea\u4e9b\u9805\u76ee\uff1f", "answer": "\u5728\u5e15\u5e15\u7fa9\u5927\u5229\u9eb5\u9928\u70ba\u4e86\u6700\u5927\u5316\u5229\u6f64\uff0c\u8acb\u512a\u5148\u5347\u7d1a\u4ee5\u4e0b\u9805\u76ee\uff1a\u6b65\u9a5f 1 - \u9996\u5148\u6295\u8cc7\u5eda\u623f\u8a2d\u5099\u5347\u7d1a\uff0c\u4f8b\u5982\u66f4\u5feb\u7684\u716e\u9eb5\u6a5f\uff0c\u4ee5\u7e2e\u77ed\u70f9\u98ea\u6642\u9593\u3002\u6b65\u9a5f 2 - \u5347\u7d1a\u7528\u9910\u5340\uff0c\u4ee5\u63d0\u9ad8\u9867\u5ba2\u56de\u982d\u7387\u548c\u5c0f\u8cbb\u3002\u6b65\u9a5f 3 - \u63d0\u5347\u98df\u6750\u54c1\u8cea\uff0c\u5438\u5f15\u66f4\u591a\u9867\u5ba2\uff0c\u4e26\u5141\u8a31\u66f4\u9ad8\u7684\u5b9a\u50f9\u3002\u53c3\u8003 [\u6bd4\u55bb\u8aaa\u660e]\uff0c\u85c9\u7531\u5c07\u5347\u7d1a\u9805\u76ee\u6bd4\u4f5c\u6a5f\u5668\u4e2d\u7684\u9f52\u8f2a\uff1b\u6bcf\u500b\u5347\u7d1a\u90fd\u8b93\u6574\u500b\u7cfb\u7d71\u904b\u4f5c\u66f4\u9806\u66a2\u3002\u4f8b\u5982\uff0c\u66f4\u5feb\u7684\u716e\u9eb5\u6a5f\u53ef\u4ee5\u5728\u7e41\u5fd9\u6642\u6bb5\u8655\u7406\u66f4\u591a\u8a02\u55ae\u3002"}, {"question": "\u9867\u5ba2\u6eff\u610f\u5ea6\u8a08\u91cf\u5668\u5728\u5e15\u5e15\u7fa9\u5927\u5229\u9eb5\u9928\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u5b83\uff1f", "answer": "\u5e15\u5e15\u7fa9\u5927\u5229\u9eb5\u9928\u7684\u9867\u5ba2\u6eff\u610f\u5ea6\u8a08\u91cf\u5668\u8861\u91cf\u9867\u5ba2\u5c0d\u7528\u9910\u9ad4\u9a57\u7684\u6eff\u610f\u7a0b\u5ea6\u3002\u5b83\u53d7\u5230\u4ee5\u4e0b\u56e0\u7d20\u7684\u5f71\u97ff\uff1a\u6b65\u9a5f 1 - \u8a02\u55ae\u6e96\u78ba\u6027\uff1b\u78ba\u4fdd\u9910\u9ede\u7b26\u5408\u9867\u5ba2\u8981\u6c42\u3002\u6b65\u9a5f 2 - \u53ca\u6642\u6027\uff1b\u5728\u8010\u5fc3\u8a08\u91cf\u5668\u7528\u5b8c\u4e4b\u524d\uff0c\u63d0\u4f9b\u9910\u9ede\u3002\u6b65\u9a5f 3 - \u5916\u89c0\u5448\u73fe\uff1b\u6574\u9f4a\u6392\u5217\u914d\u6599\u4ee5\u53d6\u5f97\u8996\u89ba\u5438\u5f15\u529b\u3002\u4f8b\u5982\uff0c\u4e00\u4efd\u70f9\u98ea\u5b8c\u5584\u7684\u5976\u6cb9\u57f9\u6839\u9eb5\uff0c\u914d\u6599\u5747\u52fb\u5206\u4f48\u7684\u5e15\u746a\u68ee\u8d77\u53f8\uff0c\u5c07\u6bd4\u51cc\u4e82\u7684\u5448\u73fe\u65b9\u5f0f\u7372\u5f97\u66f4\u9ad8\u7684\u5f97\u5206\u3002\u53c3\u8003 [\u914d\u7f6e\u5c0d\u7167\u8868] \u4ee5\u77ad\u89e3\u7406\u60f3\u7684\u5448\u73fe\u6a19\u6e96\u3002"}, {"question": "\u5728\u5e15\u5e15\u7fa9\u5927\u5229\u9eb5\u9928\uff0c\u98df\u6750\u65b0\u9bae\u5ea6\u80cc\u5f8c\u7684\u96b1\u85cf\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5e15\u5e15\u7fa9\u5927\u5229\u9eb5\u9928\u98df\u6750\u7684\u65b0\u9bae\u5ea6\u662f\u500b\u96b1\u85cf\u7684\u6a5f\u5236\uff0c\u5f71\u97ff\u8457\u83dc\u991a\u7684\u54c1\u8cea\u3002\u65b0\u9bae\u7684\u98df\u6750\u63d0\u5347\u98a8\u5473\u548c\u9867\u5ba2\u6eff\u610f\u5ea6\u3002\u6b65\u9a5f 1 - \u76e3\u63a7\u6bcf\u7a2e\u98df\u6750\u7684\u65b0\u9bae\u8a08\u6642\u5668\uff1b\u4f8b\u5982\uff0c\u7f85\u52d2\u6bd4\u5927\u849c\u66f4\u5bb9\u6613\u5931\u53bb\u65b0\u9bae\u5ea6\u3002\u6b65\u9a5f 2 - \u4f7f\u7528 [\u6d41\u7a0b\u5716\u89e3] \u4f86\u8ffd\u8e64\u98df\u6750\u7684\u4fdd\u9bae\u671f\u9650\u4e26\u4f9d\u6b64\u898f\u5283\u4f7f\u7528\u3002\u6b65\u9a5f 3 - \u5148\u4f7f\u7528\u8f03\u820a\u7684\u98df\u6750\uff0c\u4ee5\u6e1b\u5c11\u6d6a\u8cbb\u3002\u4f8b\u5982\uff0c\u5728\u91ac\u6599\u4e2d\u512a\u5148\u4f7f\u7528\u8f03\u820a\u7684\u756a\u8304\uff0c\u4ee5\u514d\u5b83\u5011\u8b8a\u8cea\u3002"}, {"question": "\u5982\u4f55\u5c07\u6211\u7684\u5e15\u5e15\u7fa9\u5927\u5229\u9eb5\u9928\u9032\u5ea6\u8f49\u79fb\u5230\u65b0\u7684\u88dd\u7f6e\uff1f", "answer": "\u8981\u5c07\u60a8\u7684\u5e15\u5e15\u7fa9\u5927\u5229\u9eb5\u9928\u9032\u5ea6\u8f49\u79fb\u5230\u65b0\u7684\u88dd\u7f6e\uff1a\u6b65\u9a5f 1 - \u78ba\u4fdd\u5169\u500b\u88dd\u7f6e\u90fd\u9023\u63a5\u5230\u76f8\u540c\u7684\u96f2\u7aef\u670d\u52d9 (\u4f8b\u5982 Google Play \u6216 Apple Game Center)\u3002\u6b65\u9a5f 2 - \u5728\u820a\u88dd\u7f6e\u4e0a\u958b\u555f\u904a\u6232\uff0c\u4e26\u900f\u904e\u8a2d\u5b9a\u9078\u55ae\u4e2d\u7684\u96f2\u7aef\u5132\u5b58\u9078\u9805\u540c\u6b65\u60a8\u7684\u9032\u5ea6\u3002\u6b65\u9a5f 3 - \u5728\u65b0\u88dd\u7f6e\u4e0a\u5b89\u88dd\u904a\u6232\uff0c\u4e26\u767b\u5165\u76f8\u540c\u7684\u96f2\u7aef\u5e33\u6236\u4ee5\u53d6\u5f97\u60a8\u7684\u8cc7\u6599\u3002\u4f7f\u7528 [\u591a\u65b9\u6848\u5c0d\u6bd4] \u8868\u683c\uff0c\u6839\u64da\u60a8\u7684\u88dd\u7f6e\u76f8\u5bb9\u6027\u4f86\u9078\u64c7\u6700\u4f73\u7684\u96f2\u7aef\u670d\u52d9\u3002\u4f8b\u5982\uff0cGoogle Play \u5c0d Android \u4f7f\u7528\u8005\u4f86\u8aaa\u662f\u7406\u60f3\u7684\u9078\u64c7\u3002"}, {"question": "\u5e15\u5e15\u7fa9\u5927\u5229\u9eb5\u9928\u7684\u79d8\u5bc6\u6210\u5c31\u6709\u54ea\u4e9b\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9396\uff1f", "answer": "\u5e15\u5e15\u7fa9\u5927\u5229\u9eb5\u9928\u7684\u79d8\u5bc6\u6210\u5c31\u901a\u5e38\u9700\u8981\u7279\u5b9a\u52d5\u4f5c\uff1a\u6b65\u9a5f 1 - \u5728\u6c92\u6709\u932f\u8aa4\u7684\u60c5\u6cc1\u4e0b\u63d0\u4f9b\u4e00\u5b9a\u6578\u91cf\u5b8c\u7f8e\u7684\u8a02\u55ae\uff1b\u4f8b\u5982\uff0c\u300c\u5b8c\u7f8e\u5eda\u5e2b\u300d\u9700\u8981 50 \u500b\u5b8c\u7f8e\u7684\u8a02\u55ae\u3002\u6b65\u9a5f 2 - \u5617\u8a66\u7368\u7279\u7684\u98df\u6750\u7d44\u5408\u4ee5\u89e3\u9396\u300c\u5275\u65b0\u5eda\u5e2b\u300d\u3002\u6b65\u9a5f 3 - \u5b8c\u6210\u4e00\u9031\u5167\u7684\u6240\u6709\u6bcf\u65e5\u6311\u6230\u4ee5\u7372\u5f97\u300c\u9031\u672b\u6230\u58eb\u300d\u3002\u4f7f\u7528 [\u6bd4\u55bb\u8aaa\u660e]\uff0c\u5c07\u9019\u4e9b\u6210\u5c31\u8996\u70ba\u96b1\u85cf\u7684\u5bf6\u85cf\uff1b\u60a8\u9700\u8981\u63a2\u7d22\u4e26\u5617\u8a66\u65b0\u4e8b\u7269\u624d\u80fd\u627e\u5230\u5b83\u5011\u3002"}, {"question": "\u5e15\u5e15\u7fa9\u5927\u5229\u9eb5\u9928\u7684\u8a08\u5206\u7cfb\u7d71\u5982\u4f55\u8a08\u7b97\u5c0f\u8cbb\u548c\u6574\u9ad4\u8a55\u7d1a\uff1f", "answer": "\u5e15\u5e15\u7fa9\u5927\u5229\u9eb5\u9928\u7684\u8a08\u5206\u7cfb\u7d71\u6839\u64da\u4e09\u500b\u56e0\u7d20\u8a08\u7b97\u5c0f\u8cbb\u548c\u6574\u9ad4\u8a55\u7d1a\uff1a\u6b65\u9a5f 1 - \u8a02\u55ae\u6e96\u78ba\u6027\uff1b\u907a\u6f0f\u6216\u932f\u8aa4\u7684\u98df\u6750\u6703\u6263\u5206\u3002\u6b65\u9a5f 2 - \u53ca\u6642\u6027\uff1b\u66f4\u5feb\u7684\u670d\u52d9\u6703\u7372\u5f97\u66f4\u9ad8\u7684\u5c0f\u8cbb\u3002\u6b65\u9a5f 3 - \u5916\u89c0\u5448\u73fe\uff1b\u6574\u6f54\u4e14\u8996\u89ba\u5438\u5f15\u529b\u7684\u9910\u9ede\u5f97\u5206\u66f4\u9ad8\u3002\u4f8b\u5982\uff0c\u4e00\u4efd\u5feb\u901f\u63d0\u4f9b\u7684\u7fa9\u5927\u5229\u8089\u91ac\u9eb5\uff0c\u6240\u6709\u98df\u6750\u64fa\u653e\u6b63\u78ba\uff0c\u5c07\u6bd4\u5ef6\u8aa4\u6216\u51cc\u4e82\u7684\u9910\u9ede\u7372\u5f97\u66f4\u9ad8\u7684\u5c0f\u8cbb\u3002\u53c3\u8003 [\u914d\u7f6e\u5c0d\u7167\u8868] \u4ee5\u53d6\u5f97\u8a73\u7d30\u7684\u8a08\u5206\u7d30\u9805\u3002"}, {"question": "\u5728\u5e15\u5e15\u7fa9\u5927\u5229\u9eb5\u9928\u8655\u7406\u5c16\u5cf0\u6642\u6bb5\u7684\u6700\u4f73\u4f5c\u6cd5\u70ba\u4f55\uff1f", "answer": "\u5728\u5e15\u5e15\u7fa9\u5927\u5229\u9eb5\u9928\u8655\u7406\u5c16\u5cf0\u6642\u6bb5\u9700\u8981\u6e96\u5099\u548c\u7b56\u7565\uff1a\u6b65\u9a5f 1 - \u9810\u5148\u70f9\u98ea\u71b1\u9580\u9eb5\u98df\u7a2e\u985e\u4ee5\u7e2e\u77ed\u7b49\u5019\u6642\u9593\u3002\u6b65\u9a5f 2 - \u4f7f\u7528 [\u6d41\u7a0b\u5716\u89e3] \u4f86\u7c21\u5316\u60a8\u7684\u5de5\u4f5c\u6d41\u7a0b\u4e26\u5c07\u5de5\u4f5c\u7ad9\u4e4b\u9593\u7684\u79fb\u52d5\u964d\u5230\u6700\u4f4e\u3002\u6b65\u9a5f 3 - \u5c07\u7279\u5b9a\u4efb\u52d9\u5206\u914d\u7d66\u6bcf\u500b\u5de5\u4f5c\u7ad9 (\u4f8b\u5982\uff0c\u4e00\u500b\u4eba\u8ca0\u8cac\u70f9\u98ea\uff0c\u53e6\u4e00\u500b\u4eba\u8ca0\u8cac\u7d44\u88dd\u9910\u9ede)\u3002\u4f8b\u5982\uff0c\u5728\u5348\u9910\u9ad8\u5cf0\u671f\uff0c\u9810\u5148\u70f9\u716e\u597d\u7684\u57f9\u6839\u5976\u6cb9\u9eb5\u53ef\u4ee5\u5e6b\u52a9\u60a8\u5feb\u901f\u670d\u52d9\u66f4\u591a\u9867\u5ba2\u3002"}]
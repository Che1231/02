[{"question": "\ucd08\ubcf4\uc790\uac00 \ud15c\ud50c \ub7f0 2: \uc815\uae00 \ud3f4\uc5d0\uc11c \uae30\ubcf8 \uc81c\uc5b4\ub97c \uc5b4\ub5bb\uac8c \uc218\ud589\ud569\ub2c8\uae4c?", "answer": "\ud15c\ud50c \ub7f0 2: \uc815\uae00 \ud3f4\uc758 \uae30\ubcf8 \uc81c\uc5b4\ub294 \uac04\ub2e8\ud558\uace0 \uc9c1\uad00\uc801\uc785\ub2c8\ub2e4. \ucc28\uc120\uc744 \ubcc0\uacbd\ud558\ub824\uba74 \uc67c\ucabd \ub610\ub294 \uc624\ub978\ucabd\uc73c\ub85c \uc4f8\uc5b4\ub118\uae30\uace0, \uc7a5\uc560\ubb3c\uc744 \ub6f0\uc5b4\ub118\uc73c\ub824\uba74 \uc704\ub85c \uc4f8\uc5b4\ub118\uae30\uace0, \uc7a5\uc560\ubb3c \uc544\ub798\ub85c \ubbf8\ub044\ub7ec\uc9c0\ub824\uba74 \uc544\ub798\ub85c \uc4f8\uc5b4\ub118\uae41\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub0ae\uac8c \ub9e4\ub2ec\ub9b0 \ub369\uad74\uc744 \uc811\uadfc\ud560 \ub54c\ub294 \uc544\ub798\ub85c \uc4f8\uc5b4\ub118\uaca8 \uadf8 \uc544\ub798\ub85c \ubbf8\ub044\ub7ec\uc9c0\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \ub3d9\uc804\uc744 \ubaa8\uc73c\ub824\uba74 \uae30\uae30\ub97c \uc57d\uac04 \uae30\uc6b8\uc5ec \ucc28\uc120\uc744 \ubc14\uafb8\uc9c0 \uc54a\uace0 \uc88c\uc6b0\ub85c \uc774\ub3d9\uc2dc\ud0a4\uc138\uc694. \uc774\ub7ec\ud55c \uc870\uc791\uc740 \uc815\uae00\uc744 \ud0d0\uc0c9\ud558\uace0 \uc704\ud5d8\uc744 \ud53c\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4."}, {"question": "\ud15c\ud50c \ub7f0 2: \uc815\uae00 \ud3f4\uc5d0\uc11c \ub3d9\uc804\uc744 \ubaa8\uc73c\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70 \uc218\uc775\uc744 \uadf9\ub300\ud654\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\ud15c\ud50c \ub7f0 2: \uc815\uae00 \ud3f4\uc5d0\uc11c \ub3d9\uc804\uc744 \ubaa8\uc73c\ub294 \uac83\uc740 \uac15\ud654 \uc544\uc774\ud15c, \uce90\ub9ad\ud130 \ubc0f \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uad6c\ub9e4\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc218\uc775\uc744 \uadf9\ub300\ud654\ud558\ub824\uba74 \uacbd\ub85c \uc911\uc559\uc5d0\uc11c \ub2ec\ub9ac\ub294 \ub370 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \ub3d9\uc804\uc774 \uc885\uc885 \uc9d1\uc911\ub418\uc5b4 \uc788\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc790\uc11d \uac15\ud654 \uc544\uc774\ud15c\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud2b9\uc815 \ubc18\uacbd \ub0b4\uc758 \ub3d9\uc804\uc744 \uc790\ub3d9\uc73c\ub85c \ub04c\uc5b4\ub4e4\uc785\uc2dc\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub3d9\uc804\uc774 \ub9ce\uc774 \uc788\ub294 \uad6c\uac04\uc5d0\uc11c \uc790\uc11d\uc744 \ud65c\uc131\ud654\ud558\uba74 \ucd1d\uc561\uc774 \ud06c\uac8c \uc99d\uac00\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uc77c\uc77c \ub3c4\uc804 \uacfc\uc81c\uc640 \uc131\ucde8\ub3c4\ub97c \uc644\ub8cc\ud558\uc5ec \ubcf4\ub108\uc2a4 \ub3d9\uc804\uc744 \uc5bb\uc73c\uc138\uc694."}, {"question": "\ud15c\ud50c \ub7f0 2: \uc815\uae00 \ud3f4\uc5d0\uc11c \uac15\ud654 \uc544\uc774\ud15c\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud15c\ud50c \ub7f0 2: \uc815\uae00 \ud3f4\uc5d0\uc11c \uac15\ud654 \uc544\uc774\ud15c\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uba74 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \ud6c4\ubc18\ubd80\uc5d0 \ub9e4\uc6b0 \uc911\uc694\ud55c \ud55c \ubc29\uc744 \ubc29\uc5b4\ud558\ub294 \ubc29\ud328 \uac15\ud654 \uc544\uc774\ud15c\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \ubd80\uc2a4\ud2b8 \uac15\ud654 \uc544\uc774\ud15c\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud2b9\ud788 \uc9c1\uc120 \uad6c\uac04\uc5d0\uc11c \uc18d\ub3c4\ub97c \ud3ed\ubc1c\uc801\uc73c\ub85c \ub192\uc5ec \ub354 \ube60\ub974\uac8c \uac70\ub9ac\ub97c \ucee4\ubc84\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \uc790\uc11d \uac15\ud654 \uc544\uc774\ud15c\uc740 \uad11\uc0b0 \uce74\ud2b8 \uad6c\uac04\uacfc \uac19\uc774 \ub3d9\uc804 \ubc00\ub3c4\uac00 \ub192\uc740 \uc9c0\uc5ed\uc5d0 \uc800\uc7a5\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uad11\uc0b0 \uce74\ud2b8 \uad6c\uac04\uc5d0\uc11c \uc790\uc11d\uc744 \ud65c\uc131\ud654\ud558\uba74 \uba87 \ucd08 \ub9cc\uc5d0 \uc218\ubc31 \uac1c\uc758 \ub3d9\uc804\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud15c\ud50c \ub7f0 2: \uc815\uae00 \ud3f4\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \ucd5c\uc885 \uc810\uc218\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc694\uc18c\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud15c\ud50c \ub7f0 2: \uc815\uae00 \ud3f4\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5ec\ub7ec \uc694\uc18c\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \ub2ec\ub9b0 \uac70\ub9ac\uac00 \uc8fc\uc694 \uad6c\uc131 \uc694\uc18c\ub85c, \ub354 \uae34 \uac70\ub9ac\uc77c\uc218\ub85d \uc810\uc218\uac00 \ub192\uc544\uc9d1\ub2c8\ub2e4. \ub3d9\uc804\uacfc \ubcf4\uc11d\uc744 \ubaa8\uc73c\ub294 \uac83\ub3c4 \uc810\uc218\uc5d0 \ucd94\uac00\ub418\uba70, \uac15\ud654 \uc544\uc774\ud15c\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \uac83\ub3c4 \ub9c8\ucc2c\uac00\uc9c0\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubd80\uc2a4\ud2b8 \uac15\ud654 \uc544\uc774\ud15c\uc744 \uc0ac\uc6a9\ud558\uc5ec \uae34 \uac70\ub9ac\ub97c \ube60\ub974\uac8c \ucee4\ubc84\ud558\uba74 \uc810\uc218\uac00 \ud06c\uac8c \uc99d\uac00\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \ud2b9\uc815 \uac15\ud654 \uc544\uc774\ud15c \ubc0f \uce90\ub9ad\ud130 \ub2a5\ub825\uc5d0\uc11c \uc81c\uacf5\ud558\ub294 \uacf1\uc148 \uc694\uc18c\ub294 \ucd5c\uc885 \uc810\uc218\ub97c \ub354\uc6b1 \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud15c\ud50c \ub7f0 2: \uc815\uae00 \ud3f4\uc5d0\uc11c \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ucd5c\uace0\uc758 \uc774\uc810\uc744 \uc81c\uacf5\ud558\ub294 \uce90\ub9ad\ud130\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud15c\ud50c \ub7f0 2: \uc815\uae00 \ud3f4\uc758 \uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \uace0\uc720\ud55c \ub2a5\ub825\uc744 \uac00\uc9c4 \uce90\ub9ad\ud130\ub97c \uace0\ub824\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc2a4\uce7c\ub81b \ud3ed\uc2a4\ub294 \ub3d9\uc804 \uc790\uc11d \ub2a5\ub825\uc744 \uc81c\uacf5\ud558\uc5ec \ub3d9\uc804 \uc218\uc9d1\uc744 \uadf9\ub300\ud654\ud558\ub294 \ub370 \ud0c1\uc6d4\ud569\ub2c8\ub2e4. \ubc30\ub9ac \ubcf4\ub294 \uac01 \ub7f0 \uc2dc\uc791 \uc2dc \ubc29\ud328\ub97c \uc81c\uacf5\ud558\uc5ec \ucd94\uac00\uc801\uc778 \ubcf4\ud638\uce35\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uce90\ub9ad\ud130\ub294 \ub3d9\uc804\uc774\ub098 \ubcf4\uc11d\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc73c\uba70, \ud2b9\ud788 \uace0\ub4dd\uc810 \ub7f0\uacfc \uc7a5\uac70\ub9ac \uc2dc\ub3c4\uc5d0 \ub9e4\uc6b0 \uc720\uc6a9\ud569\ub2c8\ub2e4."}, {"question": "\ud15c\ud50c \ub7f0 2: \uc815\uae00 \ud3f4\uc5d0\uc11c \uc815\uae00\uacfc \uad11\uc0b0 \uce74\ud2b8 \uad6c\uac04\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud15c\ud50c \ub7f0 2: \uc815\uae00 \ud3f4\uc758 \uc815\uae00\uacfc \uad11\uc0b0 \uce74\ud2b8 \uad6c\uac04\uc740 \uac01\uae30 \ub2e4\ub978 \ub09c\uad00\uacfc \uae30\ud68c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc815\uae00 \uad6c\uac04\uc740 \uc6b8\ucc3d\ud55c \uc218\ud480, \ub369\uad74\uacfc \ubb3c \uc704\ud5d8\uc73c\ub85c \uad6c\uc131\ub418\uc5b4 \uc788\uc5b4 \uc815\ud655\ud55c \uc4f8\uc5b4\ub118\uae40\uc744 \ud1b5\ud574 \uc774\ub3d9\ud574\uc57c \ud569\ub2c8\ub2e4. \ubc18\uba74, \uad11\uc0b0 \uce74\ud2b8 \uad6c\uac04\uc740 \ub354 \ube60\ub978 \uc18d\ub3c4\ub85c \ub808\uc77c\uacfc \uc810\ud504\uac00 \uc694\uad6c\ub418\uc5b4 \uc2e0\uc18d\ud55c \ubc18\uc751\uacfc \uc815\ud655\ud55c \ubc18\uc751\uc131\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uad11\uc0b0 \uce74\ud2b8 \uad6c\uac04\uc5d0\uc11c \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uc644\ubcbd\ud788 \ub9de\ucd94\uba74 \ub9ce\uc740 \uc591\uc758 \ub3d9\uc804\uc744 \ubaa8\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub450 \uad6c\uac04 \ubaa8\ub450 \uac8c\uc784 \ud50c\ub808\uc774 \uae30\uc220\uc758 \ub2e4\uc591\ud55c \uce21\uba74\uc744 \uc2dc\ud5d8\ud569\ub2c8\ub2e4."}, {"question": "\ud15c\ud50c \ub7f0 2: \uc815\uae00 \ud3f4\uc740 \ub09c\uc774\ub3c4 \uc9c4\ud589\uc744 \uc5b4\ub5bb\uac8c \uade0\ud615 \uc788\uac8c \uc870\uc808\ud569\ub2c8\uae4c?", "answer": "\ud15c\ud50c \ub7f0 2: \uc815\uae00 \ud3f4\uc740 \uc18d\ub3c4 \uc99d\uac00, \ub354 \ubcf5\uc7a1\ud55c \uc7a5\uc560\ubb3c \ubc0f \ud658\uacbd \ubcc0\ud654\uc758 \uc870\ud569\uc744 \ud1b5\ud574 \ub09c\uc774\ub3c4 \uc9c4\ud589\uc744 \uade0\ud615 \uc788\uac8c \uc870\uc808\ud569\ub2c8\ub2e4. \ucc98\uc74c\uc5d0\ub294 \uac8c\uc784\uc740 \ub0ae\uac8c \ub9e4\ub2ec\ub9b0 \ub369\uad74\uacfc \ub2e8\uc21c\ud55c \ud68c\uc804\uacfc \uac19\uc740 \uae30\ubcf8 \uc7a5\uc560\ubb3c\uc744 \uc18c\uac1c\ud569\ub2c8\ub2e4. \uc9c4\ud589\ub428\uc5d0 \ub530\ub77c \uc18d\ub3c4\uac00 \uc99d\uac00\ud558\uace0 \uc7a5\uc560\ubb3c\uc774 \ub354 \ubcf5\uc7a1\ud574\uc9c0\uba70, \uc774\ub3d9\ud558\ub294 \ub098\ubb34\ud1a0\ub9c9\uacfc \ubb34\ub108\uc9c0\ub294 \ub2e4\ub9ac\uc640 \uac19\uc740 \uc7a5\uc560\ubb3c\uc774 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud6c4\ubc18\ubd80\uc5d0\ub294 \ube60\ub974\uac8c \uc5f0\uc18d\ub418\ub294 \uc5ec\ub7ec \uac00\uc9c0 \uc704\ud5d8\uc5d0 \uc9c1\uba74\ud558\uc5ec \ub354 \ube60\ub978 \ubc18\uc751\uacfc \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uc744 \uc694\uad6c\ud558\uac8c \ub429\ub2c8\ub2e4."}, {"question": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ud15c\ud50c \ub7f0 2: \uc815\uae00 \ud3f4\uc744 \uc2e4\ud589\ud558\uae30 \uc704\ud55c \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud15c\ud50c \ub7f0 2: \uc815\uae00 \ud3f4\uc758 \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc740 \ud50c\ub7ab\ud3fc\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. iOS\uc5d0\uc11c\ub294 iOS 9.0 \uc774\uc0c1\uc774 \ud544\uc694\ud558\uba70 iPhone, iPad \ubc0f iPod touch\uc640 \ud638\ud658\ub429\ub2c8\ub2e4. \uc548\ub4dc\ub85c\uc774\ub4dc\uc5d0\uc11c\ub294 \uc548\ub4dc\ub85c\uc774\ub4dc 4.1 \uc774\uc0c1\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. Windows\uc5d0\uc11c\ub294 Windows 8.1 \uc774\uc0c1\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, iOS 12\ub97c \uc2e4\ud589\ud558\ub294 iPhone 6s\uc5d0\uc11c\ub294 \uac8c\uc784\uc774 \ucd5c\uc18c\ud55c\uc758 \uc9c0\uc5f0\uc73c\ub85c \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ub429\ub2c8\ub2e4. \ucd5c\uc801\uc758 \uc131\ub2a5\uc744 \uc704\ud574 \uc7a5\uce58\uac00 \uc774\ub7ec\ud55c \uc694\uad6c \uc0ac\ud56d\uc744 \ucda9\uc871\ud558\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ud15c\ud50c \ub7f0 2: \uc815\uae00 \ud3f4\uc5d0\uc11c \ud55c \uae30\uae30\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud15c\ud50c \ub7f0 2: \uc815\uae00 \ud3f4\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub824\uba74 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc6d0\ub798 \uc7a5\uce58\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815(\uc548\ub4dc\ub85c\uc774\ub4dc\uc758 Google Play, iOS\uc758 Game Center)\uc5d0 \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \uac8c\uc784 \uc124\uc815\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc0c8 \uc7a5\uce58\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uace0 \uac8c\uc784\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc548\ub4dc\ub85c\uc774\ub4dc \ud734\ub300\ud3f0\uc5d0\uc11c iPad\ub85c \ubcc0\uacbd\ud558\ub294 \uacbd\uc6b0, \ub3d9\uc77c\ud55c Game Center \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uba74 \uc9c4\ud589 \uc0c1\ud669\uc774 \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4."}, {"question": "\ud15c\ud50c \ub7f0 2: \uc815\uae00 \ud3f4\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ube44\ubc00\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud15c\ud50c \ub7f0 2: \uc815\uae00 \ud3f4\uc5d0\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \ube44\ubc00\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ub208\uc5ec\uaca8\ubcfc \ub9cc\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ud2b9\uc815 \uc815\uae00 \uad6c\uac04\uc5d0 \ub098\ud0c0\ub098\ub294  yeti\ub85c, \uc790\uc138\ud788 \uc0b4\ud3b4\ubcf4\uba74 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \ub7f0\uc5d0\uc11c \ubaa8\ub4e0 \uc228\uaca8\uc9c4 \uc720\ubb3c\uc744 \ubaa8\uc73c\uba74 \ud2b9\ubcc4\ud55c \uc131\ucde8\ub3c4\uc640 \ubcf4\uc0c1\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uad11\uc0b0 \uce74\ud2b8 \uad6c\uac04\uc5d0 \uc228\uaca8\uc9c4 \uae08 \uc22d\ubc30\ubb3c\uc744 \ucc3e\uc73c\uba74 \uc0c1\ub2f9\ud55c \ub3d9\uc804 \ubcf4\ub108\uc2a4\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ube44\ubc00\uc740 \uac8c\uc784\uc5d0 \ucd94\uac00\uc801\uc778 \ubc1c\uacac \uce35\uc744 \ub354\ud569\ub2c8\ub2e4."}]
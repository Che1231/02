[{"question": "\u5982\u4f55\u5728\u300a\u53e2\u6797\u72c2\u5954 2\uff1a\u53e2\u6797\u4e4b\u589c\u300b\u4e2d\u4f5c\u70ba\u65b0\u624b\u57f7\u884c\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u5728\u300a\u53e2\u6797\u72c2\u5954 2\uff1a\u53e2\u6797\u4e4b\u589c\u300b\u4e2d\uff0c\u57fa\u672c\u63a7\u5236\u7c21\u55ae\u76f4\u89c0\u3002\u5411\u5de6\u6216\u5411\u53f3\u6ed1\u52d5\u4ee5\u6539\u8b8a\u8eca\u9053\uff0c\u5411\u4e0a\u6ed1\u52d5\u4ee5\u8df3\u904e\u969c\u7919\uff0c\u5411\u4e0b\u6ed1\u52d5\u4ee5\u6ed1\u904e\u969c\u7919\u3002\u4f8b\u5982\uff0c\u7576\u63a5\u8fd1\u4f4e\u5782\u7684\u85e4\u8513\u6642\uff0c\u5411\u4e0b\u6ed1\u52d5\u4ee5\u6ed1\u904e\u5b83\u3002\u8981\u6536\u96c6\u786c\u5e63\uff0c\u8acb\u7a0d\u5fae\u50be\u659c\u60a8\u7684\u88dd\u7f6e\uff0c\u4ee5\u5de6\u53f3\u79fb\u52d5\uff0c\u800c\u4e0d\u6539\u8b8a\u8eca\u9053\u3002\u9019\u4e9b\u63a7\u5236\u5c0d\u65bc\u5728\u53e2\u6797\u4e2d\u822a\u884c\u548c\u907f\u514d\u5371\u96aa\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u5728\u300a\u53e2\u6797\u72c2\u5954 2\uff1a\u53e2\u6797\u4e4b\u589c\u300b\u4e2d\u6536\u96c6\u786c\u5e63\u6709\u4ec0\u9ebc\u91cd\u8981\u6027\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u5927\u5316\u6211\u7684\u6536\u76ca\uff1f", "answer": "\u5728\u300a\u53e2\u6797\u72c2\u5954 2\uff1a\u53e2\u6797\u4e4b\u589c\u300b\u4e2d\u6536\u96c6\u786c\u5e63\u5c0d\u65bc\u8cfc\u8cb7\u5f37\u5316\u9053\u5177\u3001\u89d2\u8272\u548c\u5347\u7d1a\u81f3\u95dc\u91cd\u8981\u3002\u8981\u6700\u5927\u5316\u6536\u76ca\uff0c\u8acb\u5c08\u6ce8\u65bc\u6cbf\u8457\u9053\u8def\u4e2d\u5fc3\u5954\u8dd1\uff0c\u56e0\u70ba\u786c\u5e63\u901a\u5e38\u96c6\u4e2d\u5728\u90a3\u88e1\u3002\u4f7f\u7528\u78c1\u9435\u5f37\u5316\u9053\u5177\u81ea\u52d5\u5438\u5f15\u4e00\u5b9a\u7bc4\u570d\u5167\u7684\u786c\u5e63\u3002\u4f8b\u5982\uff0c\u5728\u786c\u5e63\u5bc6\u96c6\u5340\u6bb5\u6fc0\u6d3b\u78c1\u9435\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u60a8\u7684\u7e3d\u6536\u5165\u3002\u6b64\u5916\uff0c\u5b8c\u6210\u6bcf\u65e5\u6311\u6230\u548c\u6210\u5c31\u4ee5\u8cfa\u53d6\u984d\u5916\u786c\u5e63\u3002"}, {"question": "\u5728\u300a\u53e2\u6797\u72c2\u5954 2\uff1a\u53e2\u6797\u4e4b\u589c\u300b\u4e2d\u6709\u6548\u4f7f\u7528\u5f37\u5316\u9053\u5177\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u300a\u53e2\u6797\u72c2\u5954 2\uff1a\u53e2\u6797\u4e4b\u589c\u300b\u4e2d\u6709\u6548\u4f7f\u7528\u5f37\u5316\u9053\u5177\u53ef\u4ee5\u6975\u5927\u5730\u63d0\u5347\u60a8\u7684\u904a\u6232\u9ad4\u9a57\u3002\u6b65\u9a5f1\uff1a\u512a\u5148\u8003\u616e\u76fe\u724c\u5f37\u5316\u9053\u5177\u4ee5\u9632\u79a6\u4e00\u64ca\uff0c\u9019\u5728\u5f8c\u7e8c\u968e\u6bb5\u975e\u5e38\u5bf6\u8cb4\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u52a0\u901f\u5f37\u5316\u9053\u5177\u4ee5\u7372\u5f97\u901f\u5ea6\u7206\u767c\uff0c\u5c24\u5176\u662f\u5728\u76f4\u7dda\u8def\u6bb5\uff0c\u4ee5\u66f4\u5feb\u5730\u8986\u84cb\u66f4\u591a\u8ddd\u96e2\u3002\u6b65\u9a5f3\uff1a\u5c07\u78c1\u9435\u5132\u5b58\u65bc\u786c\u5e63\u5bc6\u5ea6\u9ad8\u7684\u5340\u57df\uff0c\u4f8b\u5982\u7926\u8eca\u8def\u6bb5\u3002\u4f8b\u5982\uff0c\u5728\u7926\u8eca\u8def\u6bb5\u6fc0\u6d3b\u78c1\u9435\u53ef\u4ee5\u5728\u5e7e\u79d2\u9418\u5167\u7372\u5f97\u6578\u767e\u679a\u786c\u5e63\u3002"}, {"question": "\u300a\u53e2\u6797\u72c2\u5954 2\uff1a\u53e2\u6797\u4e4b\u589c\u300b\u4e2d\u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u6700\u7d42\u5f97\u5206\uff1f", "answer": "\u300a\u53e2\u6797\u72c2\u5954 2\uff1a\u53e2\u6797\u4e4b\u589c\u300b\u4e2d\u7684\u8a08\u5206\u7cfb\u7d71\u53d7\u591a\u500b\u56e0\u7d20\u5f71\u97ff\u3002\u8dd1\u6b65\u8ddd\u96e2\u662f\u4e3b\u8981\u6210\u5206\uff0c\u8dd1\u6b65\u8ddd\u96e2\u8d8a\u9577\uff0c\u5f97\u5206\u8d8a\u9ad8\u3002\u6536\u96c6\u786c\u5e63\u548c\u5bf6\u77f3\u4e5f\u6703\u589e\u52a0\u60a8\u7684\u5f97\u5206\uff0c\u6709\u6548\u4f7f\u7528\u5f37\u5316\u9053\u5177\u4e5f\u662f\u5982\u6b64\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u52a0\u901f\u5f37\u5316\u9053\u5177\u5feb\u901f\u8986\u84cb\u9577\u8ddd\u96e2\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u60a8\u7684\u5f97\u5206\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u5f37\u5316\u9053\u5177\u548c\u89d2\u8272\u80fd\u529b\u7522\u751f\u7684\u500d\u6578\u53ef\u4ee5\u9032\u4e00\u6b65\u63d0\u9ad8\u60a8\u7684\u6700\u7d42\u5f97\u5206\u3002"}, {"question": "\u5728\u300a\u53e2\u6797\u72c2\u5954 2\uff1a\u53e2\u6797\u4e4b\u589c\u300b\u4e2d\uff0c\u54ea\u4e9b\u89d2\u8272\u5c0d\u9ad8\u7d1a\u73a9\u5bb6\u6700\u6709\u5229\uff1f", "answer": "\u300a\u53e2\u6797\u72c2\u5954 2\uff1a\u53e2\u6797\u4e4b\u589c\u300b\u4e2d\u7684\u9ad8\u7d1a\u73a9\u5bb6\u61c9\u8a72\u8003\u616e\u5177\u6709\u7368\u7279\u80fd\u529b\u7684\u89d2\u8272\uff0c\u9019\u4e9b\u80fd\u529b\u53ef\u4ee5\u63d0\u5347\u904a\u6232\u9ad4\u9a57\u3002\u4f8b\u5982\uff0c\u7d05\u72d0\u63d0\u4f9b\u786c\u5e63\u78c1\u9435\u80fd\u529b\uff0c\u9019\u5c0d\u65bc\u6700\u5927\u5316\u786c\u5e63\u6536\u96c6\u975e\u5e38\u51fa\u8272\u3002\u5df4\u91cc\u00b7\u9aa8\u982d\u5728\u6bcf\u6b21\u904a\u6232\u958b\u59cb\u6642\u63d0\u4f9b\u76fe\u724c\uff0c\u63d0\u4f9b\u984d\u5916\u7684\u4fdd\u8b77\u5c64\u3002\u9019\u4e9b\u89d2\u8272\u53ef\u4ee5\u4f7f\u7528\u786c\u5e63\u6216\u5bf6\u77f3\u89e3\u9396\uff0c\u4e26\u5728\u9ad8\u5206\u904a\u6232\u548c\u9577\u8ddd\u96e2\u5617\u8a66\u4e2d\u5c24\u5176\u6709\u7528\u3002"}, {"question": "\u300a\u53e2\u6797\u72c2\u5954 2\uff1a\u53e2\u6797\u4e4b\u589c\u300b\u4e2d\u7684\u53e2\u6797\u548c\u7926\u8eca\u8def\u6bb5\u4e4b\u9593\u6709\u4ec0\u9ebc\u4e3b\u8981\u5340\u5225\uff1f", "answer": "\u300a\u53e2\u6797\u72c2\u5954 2\uff1a\u53e2\u6797\u4e4b\u589c\u300b\u4e2d\u7684\u53e2\u6797\u548c\u7926\u8eca\u8def\u6bb5\u63d0\u4f9b\u4e0d\u540c\u7684\u6311\u6230\u548c\u6a5f\u9047\u3002\u53e2\u6797\u8def\u6bb5\u6709\u8302\u5bc6\u7684\u690d\u88ab\u3001\u85e4\u8513\u548c\u6c34\u969c\u7919\uff0c\u9700\u8981\u7cbe\u78ba\u7684\u6ed1\u52d5\u4f86\u9032\u884c\u5c0e\u822a\u3002\u76f8\u6bd4\u4e4b\u4e0b\uff0c\u7926\u8eca\u8def\u6bb5\u7bc0\u594f\u66f4\u5feb\uff0c\u6709\u9435\u8ecc\u548c\u8df3\u8e8d\uff0c\u9700\u8981\u5feb\u901f\u7684\u53cd\u61c9\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u5728\u7926\u8eca\u8def\u6bb5\uff0c\u60a8\u53ef\u4ee5\u901a\u904e\u5b8c\u7f8e\u5730\u8abf\u6574\u8df3\u8e8d\u6642\u9593\u4f86\u6536\u96c6\u5927\u91cf\u786c\u5e63\u3002\u5169\u8005\u90fd\u6e2c\u8a66\u4e86\u60a8\u7684\u4e0d\u540c\u904a\u6232\u6280\u80fd\u3002"}, {"question": "\u904a\u6232\u5982\u4f55\u5728\u300a\u53e2\u6797\u72c2\u5954 2\uff1a\u53e2\u6797\u4e4b\u589c\u300b\u4e2d\u5e73\u8861\u96e3\u5ea6\u63d0\u5347\uff1f", "answer": "\u300a\u53e2\u6797\u72c2\u5954 2\uff1a\u53e2\u6797\u4e4b\u589c\u300b\u901a\u904e\u7d50\u5408\u901f\u5ea6\u63d0\u5347\u3001\u66f4\u8907\u96dc\u7684\u969c\u7919\u548c\u74b0\u5883\u8b8a\u5316\u4f86\u5e73\u8861\u96e3\u5ea6\u63d0\u5347\u3002\u904a\u6232\u4e00\u958b\u59cb\u6703\u5f15\u5165\u57fa\u672c\u969c\u7919\uff0c\u4f8b\u5982\u4f4e\u5782\u7684\u85e4\u8513\u548c\u7c21\u55ae\u7684\u8f49\u5f4e\u3002\u96a8\u8457\u60a8\u7684\u9032\u5ea6\uff0c\u901f\u5ea6\u6703\u589e\u52a0\uff0c\u969c\u7919\u7269\u4e5f\u6703\u8b8a\u5f97\u66f4\u8907\u96dc\uff0c\u4f8b\u5982\u79fb\u52d5\u7684\u539f\u6728\u548c\u5012\u584c\u7684\u6a4b\u6a11\u3002\u4f8b\u5982\uff0c\u5728\u5f8c\u7e8c\u968e\u6bb5\uff0c\u60a8\u53ef\u80fd\u6703\u9047\u5230\u5feb\u901f\u9023\u7e8c\u7684\u969c\u7919\uff0c\u9700\u8981\u66f4\u5feb\u7684\u53cd\u61c9\u901f\u5ea6\u548c\u66f4\u7cbe\u78ba\u7684\u6642\u6a5f\u3002"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u904b\u884c\u300a\u53e2\u6797\u72c2\u5954 2\uff1a\u53e2\u6797\u4e4b\u589c\u300b\u7684\u7cfb\u7d71\u9700\u6c42\u662f\u4ec0\u9ebc\uff1f", "answer": "\u300a\u53e2\u6797\u72c2\u5954 2\uff1a\u53e2\u6797\u4e4b\u589c\u300b\u7684\u7cfb\u7d71\u9700\u6c42\u56e0\u5e73\u53f0\u800c\u7570\u3002\u5728 iOS \u4e0a\uff0c\u5b83\u9700\u8981 iOS 9.0 \u6216\u66f4\u9ad8\u7248\u672c\uff0c\u4e26\u8207 iPhone\u3001iPad \u548c iPod touch \u76f8\u5bb9\u3002\u5728 Android \u4e0a\uff0c\u5b83\u9700\u8981 Android 4.1 \u6216\u66f4\u9ad8\u7248\u672c\u3002\u5728 Windows \u4e0a\uff0c\u5b83\u9700\u8981 Windows 8.1 \u6216\u66f4\u9ad8\u7248\u672c\u3002\u4f8b\u5982\uff0c\u5728\u904b\u884c iOS 12 \u7684 iPhone 6s \u4e0a\uff0c\u904a\u6232\u904b\u884c\u9806\u66a2\u4e14\u5ef6\u9072\u6700\u5c0f\u3002\u8acb\u78ba\u4fdd\u60a8\u7684\u8a2d\u5099\u7b26\u5408\u9019\u4e9b\u9700\u6c42\uff0c\u4ee5\u7372\u5f97\u6700\u4f73\u6027\u80fd\u3002"}, {"question": "\u5982\u4f55\u5c07\u6211\u7684\u300a\u53e2\u6797\u72c2\u5954 2\uff1a\u53e2\u6797\u4e4b\u589c\u300b\u9032\u5ea6\u5f9e\u4e00\u53f0\u8a2d\u5099\u8f49\u79fb\u5230\u53e6\u4e00\u53f0\u8a2d\u5099\uff1f", "answer": "\u53ef\u4ee5\u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u4f86\u8f49\u79fb\u300a\u53e2\u6797\u72c2\u5954 2\uff1a\u53e2\u6797\u4e4b\u589c\u300b\u7684\u9032\u5ea6\u3002\u6b65\u9a5f1\uff1a\u5728\u60a8\u7684\u539f\u59cb\u8a2d\u5099\u4e0a\uff0c\u8acb\u78ba\u4fdd\u60a8\u5df2\u767b\u5165\u76f8\u540c\u7684\u5e33\u6236\uff08Android \u7684 Google Play \u5546\u5e97\u3001iOS \u7684 Game Center\uff09\u3002\u6b65\u9a5f2\uff1a\u524d\u5f80\u904a\u6232\u8a2d\u5b9a\u4e26\u555f\u7528\u96f2\u7aef\u5132\u5b58\u3002\u6b65\u9a5f3\uff1a\u5728\u60a8\u7684\u65b0\u8a2d\u5099\u4e0a\uff0c\u767b\u5165\u76f8\u540c\u7684\u5e33\u6236\u4e26\u4e0b\u8f09\u904a\u6232\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9e Android \u624b\u6a5f\u5207\u63db\u5230 iPad\uff0c\u767b\u5165\u76f8\u540c\u7684 Game Center \u5e33\u6236\u5c07\u540c\u6b65\u60a8\u7684\u9032\u5ea6\u3002"}, {"question": "\u5728\u300a\u53e2\u6797\u72c2\u5954 2\uff1a\u53e2\u6797\u4e4b\u589c\u300b\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u7684\u79d8\u5bc6\u6216\u5f69\u86cb\uff1f", "answer": "\u300a\u53e2\u6797\u72c2\u5954 2\uff1a\u53e2\u6797\u4e4b\u589c\u300b\u5305\u542b\u4e00\u4e9b\u96b1\u85cf\u7684\u79d8\u5bc6\u548c\u5f69\u86cb\u3002\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\u5728\u67d0\u4e9b\u53e2\u6797\u5340\u57df\u51fa\u73fe\u96ea\u4eba\uff0c\u5982\u679c\u60a8\u4ed4\u7d30\u89c0\u5bdf\uff0c\u5c31\u53ef\u4ee5\u767c\u73fe\u5b83\u5011\u3002\u6b64\u5916\uff0c\u6536\u96c6\u8dd1\u6b65\u4e2d\u7684\u6240\u6709\u96b1\u85cf\u6587\u7269\u53ef\u4ee5\u89e3\u9396\u7279\u6b8a\u6210\u5c31\u548c\u734e\u52f5\u3002\u4f8b\u5982\uff0c\u5728\u7926\u8eca\u8def\u6bb5\u627e\u5230\u96b1\u85cf\u7684\u91d1\u50cf\u53ef\u4ee5\u7372\u5f97\u986f\u8457\u7684\u786c\u5e63\u734e\u52f5\u3002\u9019\u4e9b\u79d8\u5bc6\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u984d\u5916\u7684\u767c\u73fe\u5c64\u6b21\u3002"}]
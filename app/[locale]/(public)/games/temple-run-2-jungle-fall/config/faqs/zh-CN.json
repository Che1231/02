[{"question": "\u5982\u4f55\u5728\u300a\u4e1b\u6797\u9003\u4ea12\uff1a\u4e1b\u6797\u5760\u843d\u300b\u4e2d\u4f5c\u4e3a\u65b0\u624b\u8fdb\u884c\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u5728\u300a\u4e1b\u6797\u9003\u4ea12\uff1a\u4e1b\u6797\u5760\u843d\u300b\u4e2d\uff0c\u57fa\u672c\u64cd\u4f5c\u7b80\u5355\u76f4\u89c2\u3002\u5411\u5de6\u6216\u5411\u53f3\u6ed1\u52a8\u66f4\u6539\u8dd1\u9053\uff0c\u5411\u4e0a\u6ed1\u52a8\u8df3\u8fc7\u969c\u788d\uff0c\u5411\u4e0b\u6ed1\u52a8\u6ed1\u8fc7\u969c\u788d\u7269\u3002\u4f8b\u5982\uff0c\u5f53\u63a5\u8fd1\u4f4e\u5782\u7684\u85e4\u8513\u65f6\uff0c\u5411\u4e0b\u6ed1\u52a8\u6ed1\u8fc7\u5b83\u3002\u8981\u6536\u96c6\u786c\u5e01\uff0c\u8bf7\u7a0d\u5fae\u503e\u659c\u60a8\u7684\u8bbe\u5907\u4ee5\u4fbf\u5728\u4e0d\u66f4\u6539\u8dd1\u9053\u7684\u60c5\u51b5\u4e0b\u5411\u5de6\u6216\u5411\u53f3\u79fb\u52a8\u3002\u8fd9\u4e9b\u64cd\u4f5c\u5bf9\u4e8e\u5728\u4e1b\u6797\u4e2d\u5bfc\u822a\u548c\u907f\u514d\u5371\u9669\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u5728\u300a\u4e1b\u6797\u9003\u4ea12\uff1a\u4e1b\u6797\u5760\u843d\u300b\u4e2d\u6536\u96c6\u786c\u5e01\u91cd\u8981\u5728\u54ea\u91cc\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u5927\u5316\u6536\u76ca\uff1f", "answer": "\u5728\u300a\u4e1b\u6797\u9003\u4ea12\uff1a\u4e1b\u6797\u5760\u843d\u300b\u4e2d\u6536\u96c6\u786c\u5e01\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u53ef\u4ee5\u7528\u6765\u8d2d\u4e70\u9053\u5177\u3001\u89d2\u8272\u548c\u5347\u7ea7\u3002\u8981\u6700\u5927\u5316\u6536\u76ca\uff0c\u8bf7\u4e13\u6ce8\u4e8e\u5728\u8def\u5f84\u7684\u4e2d\u95f4\u8dd1\uff0c\u56e0\u4e3a\u786c\u5e01\u901a\u5e38\u96c6\u4e2d\u5728\u90a3\u91cc\u3002\u4f7f\u7528\u78c1\u94c1\u9053\u5177\uff0c\u5b83\u53ef\u4ee5\u81ea\u52a8\u5438\u5f15\u4e00\u5b9a\u8303\u56f4\u5185\u7684\u786c\u5e01\u3002\u4f8b\u5982\uff0c\u5728\u786c\u5e01\u5bc6\u96c6\u533a\u4f7f\u7528\u78c1\u94c1\u9053\u5177\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u603b\u6536\u76ca\u3002\u6b64\u5916\uff0c\u5b8c\u6210\u6bcf\u65e5\u6311\u6218\u548c\u6210\u5c31\u4ee5\u83b7\u5f97\u989d\u5916\u5956\u52b1\u3002"}, {"question": "\u5728\u300a\u4e1b\u6797\u9003\u4ea12\uff1a\u4e1b\u6797\u5760\u843d\u300b\u4e2d\u6709\u6548\u4f7f\u7528\u9053\u5177\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300a\u4e1b\u6797\u9003\u4ea12\uff1a\u4e1b\u6797\u5760\u843d\u300b\u4e2d\u6709\u6548\u4f7f\u7528\u9053\u5177\u53ef\u4ee5\u6781\u5927\u5730\u589e\u5f3a\u4f60\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u6b65\u9aa41\uff1a\u4f18\u5148\u4f7f\u7528\u62a4\u76fe\u9053\u5177\u6765\u62b5\u6321\u4e00\u6b21\u653b\u51fb\uff0c\u8fd9\u5728\u540e\u671f\u9636\u6bb5\u975e\u5e38\u5b9d\u8d35\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u52a0\u901f\u9053\u5177\u83b7\u5f97\u901f\u5ea6\u7206\u53d1\uff0c\u5c24\u5176\u662f\u5728\u76f4\u7ebf\u90e8\u5206\uff0c\u4ee5\u4fbf\u5feb\u901f\u8986\u76d6\u66f4\u591a\u8ddd\u79bb\u3002\u6b65\u9aa43\uff1a\u5728\u786c\u5e01\u5bc6\u96c6\u533a\u57df\uff0c\u4f8b\u5982\u77ff\u8f66\u6bb5\uff0c\u4fdd\u5b58\u78c1\u94c1\u9053\u5177\u3002\u4f8b\u5982\uff0c\u5728\u77ff\u8f66\u6bb5\u6fc0\u6d3b\u78c1\u94c1\u53ef\u4ee5\u79d2\u6570\u83b7\u5f97\u6570\u767e\u679a\u786c\u5e01\u3002"}, {"question": "\u5728\u300a\u4e1b\u6797\u9003\u4ea12\uff1a\u4e1b\u6797\u5760\u843d\u300b\u4e2d\u5f97\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u6700\u7ec8\u5f97\u5206\uff1f", "answer": "\u300a\u4e1b\u6797\u9003\u4ea12\uff1a\u4e1b\u6797\u5760\u843d\u300b\u7684\u8bc4\u5206\u7cfb\u7edf\u53d7\u591a\u79cd\u56e0\u7d20\u5f71\u54cd\u3002\u8dd1\u6b65\u8ddd\u79bb\u662f\u4e3b\u8981\u56e0\u7d20\uff0c\u8dd1\u6b65\u8ddd\u79bb\u8d8a\u957f\uff0c\u5f97\u5206\u8d8a\u9ad8\u3002\u6536\u96c6\u786c\u5e01\u548c\u5b9d\u77f3\u4e5f\u4f1a\u589e\u52a0\u4f60\u7684\u5f97\u5206\uff0c\u6709\u6548\u4f7f\u7528\u9053\u5177\u4e5f\u4f1a\u589e\u52a0\u4f60\u7684\u5f97\u5206\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u52a0\u901f\u9053\u5177\u5feb\u901f\u8986\u76d6\u4e00\u6bb5\u957f\u8ddd\u79bb\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u5f97\u5206\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u9053\u5177\u548c\u89d2\u8272\u80fd\u529b\u5e26\u6765\u7684\u500d\u6570\u4e5f\u53ef\u4ee5\u8fdb\u4e00\u6b65\u63d0\u9ad8\u4f60\u7684\u6700\u7ec8\u5f97\u5206\u3002"}, {"question": "\u5728\u300a\u4e1b\u6797\u9003\u4ea12\uff1a\u4e1b\u6797\u5760\u843d\u300b\u4e2d\uff0c\u54ea\u4e9b\u89d2\u8272\u5bf9\u9ad8\u7ea7\u73a9\u5bb6\u6765\u8bf4\u5177\u6709\u6700\u4f73\u4f18\u52bf\uff1f", "answer": "\u5728\u300a\u4e1b\u6797\u9003\u4ea12\uff1a\u4e1b\u6797\u5760\u843d\u300b\u4e2d\uff0c\u9ad8\u7ea7\u73a9\u5bb6\u5e94\u8be5\u8003\u8651\u90a3\u4e9b\u5177\u6709\u72ec\u7279\u80fd\u529b\u3001\u589e\u5f3a\u6e38\u620f\u4f53\u9a8c\u7684\u89d2\u8272\u3002\u4f8b\u5982\uff0c\u5c0f\u72d0\u72f8\u63d0\u4f9b\u4e00\u4e2a\u786c\u5e01\u78c1\u94c1\u80fd\u529b\uff0c\u8fd9\u5bf9\u4e8e\u6700\u5927\u5316\u786c\u5e01\u6536\u96c6\u975e\u5e38\u51fa\u8272\u3002\u5df4\u91cc\u00b7\u9aa8\u9abc\u5728\u6bcf\u6b21\u5954\u8dd1\u5f00\u59cb\u65f6\u63d0\u4f9b\u62a4\u76fe\uff0c\u63d0\u4f9b\u989d\u5916\u7684\u4fdd\u62a4\u5c42\u3002\u8fd9\u4e9b\u89d2\u8272\u53ef\u4ee5\u4f7f\u7528\u786c\u5e01\u6216\u5b9d\u77f3\u89e3\u9501\uff0c\u5bf9\u4e8e\u9ad8\u5206\u8dd1\u548c\u957f\u8dd1\u5c1d\u8bd5\u7279\u522b\u6709\u7528\u3002"}, {"question": "\u300a\u4e1b\u6797\u9003\u4ea12\uff1a\u4e1b\u6797\u5760\u843d\u300b\u4e1b\u6797\u548c\u77ff\u8f66\u90e8\u5206\u4e4b\u95f4\u6709\u4ec0\u4e48\u4e3b\u8981\u533a\u522b\uff1f", "answer": "\u300a\u4e1b\u6797\u9003\u4ea12\uff1a\u4e1b\u6797\u5760\u843d\u300b\u7684\u4e1b\u6797\u548c\u77ff\u8f66\u90e8\u5206\u63d0\u4f9b\u4e0d\u540c\u7684\u6311\u6218\u548c\u673a\u4f1a\u3002\u4e1b\u6797\u90e8\u5206\u5305\u542b\u8302\u5bc6\u7684\u690d\u88ab\u3001\u85e4\u8513\u548c\u6c34\u969c\uff0c\u9700\u8981\u7cbe\u786e\u6ed1\u52a8\u624d\u80fd\u5bfc\u822a\u3002\u76f8\u6bd4\u4e4b\u4e0b\uff0c\u77ff\u8f66\u90e8\u5206\u8282\u594f\u66f4\u5feb\uff0c\u6709\u8f68\u9053\u548c\u8df3\u8dc3\uff0c\u9700\u8981\u5feb\u901f\u53cd\u5e94\u3002\u4f8b\u5982\uff0c\u5728\u77ff\u8f66\u90e8\u5206\uff0c\u901a\u8fc7\u5b8c\u7f8e\u5730\u8c03\u6574\u8df3\u8dc3\u65f6\u95f4\u53ef\u4ee5\u6536\u96c6\u5927\u91cf\u786c\u5e01\u3002\u8fd9\u4e24\u4e2a\u90e8\u5206\u90fd\u6d4b\u8bd5\u4f60\u7684\u4e0d\u540c\u6e38\u620f\u6280\u80fd\u3002"}, {"question": "\u300a\u4e1b\u6797\u9003\u4ea12\uff1a\u4e1b\u6797\u5760\u843d\u300b\u5982\u4f55\u5e73\u8861\u6e38\u620f\u96be\u5ea6\u7684\u63d0\u5347\uff1f", "answer": "\u300a\u4e1b\u6797\u9003\u4ea12\uff1a\u4e1b\u6797\u5760\u843d\u300b\u901a\u8fc7\u7ed3\u5408\u901f\u5ea6\u63d0\u5347\u3001\u66f4\u590d\u6742\u7684\u969c\u788d\u548c\u73af\u5883\u53d8\u5316\u6765\u5e73\u8861\u6e38\u620f\u96be\u5ea6\u7684\u63d0\u5347\u3002\u6700\u521d\uff0c\u6e38\u620f\u5f15\u5165\u4f4e\u5782\u7684\u85e4\u8513\u548c\u7b80\u5355\u7684\u8f6c\u5f2f\u7b49\u57fa\u672c\u969c\u788d\u3002\u968f\u7740\u4f60\u7684\u8fdb\u6b65\uff0c\u901f\u5ea6\u4f1a\u52a0\u5feb\uff0c\u969c\u788d\u4e5f\u4f1a\u53d8\u5f97\u66f4\u590d\u6742\uff0c\u4f8b\u5982\u79fb\u52a8\u7684\u6728\u5934\u548c\u574d\u584c\u7684\u6865\u6881\u3002\u4f8b\u5982\uff0c\u5728\u540e\u671f\u9636\u6bb5\uff0c\u4f60\u53ef\u80fd\u4f1a\u8fde\u7eed\u9047\u5230\u591a\u4e2a\u969c\u788d\uff0c\u9700\u8981\u66f4\u5feb\u5730\u53cd\u5e94\u548c\u66f4\u7cbe\u786e\u7684\u65f6\u95f4\u63a7\u5236\u3002"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u8fd0\u884c\u300a\u4e1b\u6797\u9003\u4ea12\uff1a\u4e1b\u6797\u5760\u843d\u300b\u7684\u7cfb\u7edf\u8981\u6c42\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u4e1b\u6797\u9003\u4ea12\uff1a\u4e1b\u6797\u5760\u843d\u300b\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u7684\u7cfb\u7edf\u8981\u6c42\u5404\u4e0d\u76f8\u540c\u3002\u5728 iOS \u5e73\u53f0\u4e0a\uff0c\u5b83\u9700\u8981 iOS 9.0 \u6216\u66f4\u9ad8\u7248\u672c\uff0c\u5e76\u517c\u5bb9 iPhone\u3001iPad \u548c iPod touch\u3002\u5728 Android \u5e73\u53f0\u4e0a\uff0c\u5b83\u9700\u8981 Android 4.1 \u6216\u66f4\u9ad8\u7248\u672c\u3002\u5728 Windows \u5e73\u53f0\u4e0a\uff0c\u5b83\u9700\u8981 Windows 8.1 \u6216\u66f4\u9ad8\u7248\u672c\u3002\u4f8b\u5982\uff0c\u5728\u8fd0\u884c iOS 12 \u7684 iPhone 6s \u4e0a\uff0c\u6e38\u620f\u8fd0\u884c\u6d41\u7545\uff0c\u51e0\u4e4e\u6ca1\u6709\u5ef6\u8fdf\u3002\u8bf7\u786e\u4fdd\u60a8\u7684\u8bbe\u5907\u6ee1\u8db3\u8fd9\u4e9b\u8981\u6c42\u4ee5\u83b7\u5f97\u6700\u4f73\u6027\u80fd\u3002"}, {"question": "\u5982\u4f55\u5c06\u300a\u4e1b\u6797\u9003\u4ea12\uff1a\u4e1b\u6797\u5760\u843d\u300b\u4e2d\u7684\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u8bbe\u5907\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u8bbe\u5907\uff1f", "answer": "\u53ef\u4ee5\u4f7f\u7528\u4e91\u4fdd\u5b58\u529f\u80fd\u6765\u8f6c\u79fb\u300a\u4e1b\u6797\u9003\u4ea12\uff1a\u4e1b\u6797\u5760\u843d\u300b\u4e2d\u7684\u8fdb\u5ea6\u3002\u6b65\u9aa41\uff1a\u5728\u60a8\u539f\u6765\u7684\u8bbe\u5907\u4e0a\uff0c\u786e\u4fdd\u60a8\u767b\u5f55\u4e86\u76f8\u540c\u7684\u5e10\u6237\uff08Android \u7684 Google Play\uff0ciOS \u7684\u6e38\u620f\u4e2d\u5fc3\uff09\u3002\u6b65\u9aa42\uff1a\u8fdb\u5165\u6e38\u620f\u7684\u8bbe\u7f6e\u5e76\u542f\u7528\u4e91\u4fdd\u5b58\u3002\u6b65\u9aa43\uff1a\u5728\u60a8\u7684\u65b0\u8bbe\u5907\u4e0a\uff0c\u767b\u5f55\u76f8\u540c\u7684\u5e10\u6237\u5e76\u4e0b\u8f7d\u6e38\u620f\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u4ece Android \u624b\u673a\u5207\u6362\u5230 iPad\uff0c\u767b\u5f55\u76f8\u540c\u7684 Game Center \u5e10\u6237\u5c06\u540c\u6b65\u60a8\u7684\u8fdb\u5ea6\u3002"}, {"question": "\u5728\u300a\u4e1b\u6797\u9003\u4ea12\uff1a\u4e1b\u6797\u5760\u843d\u300b\u4e2d\u53ef\u4ee5\u627e\u5230\u54ea\u4e9b\u9690\u85cf\u79d8\u5bc6\u6216\u5f69\u86cb\uff1f", "answer": "\u300a\u4e1b\u6797\u9003\u4ea12\uff1a\u4e1b\u6797\u5760\u843d\u300b\u5305\u542b\u591a\u4e2a\u9690\u85cf\u79d8\u5bc6\u548c\u5f69\u86cb\u3002\u4e00\u4e2a\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\u5728\u67d0\u4e9b\u4e1b\u6797\u533a\u57df\u91cc\u51fa\u73b0\u96ea\u4eba\uff0c\u5982\u679c\u4f60\u4ed4\u7ec6\u89c2\u5bdf\uff0c\u5c31\u53ef\u4ee5\u53d1\u73b0\u3002\u6b64\u5916\uff0c\u6536\u96c6\u8dd1\u9053\u4e2d\u6240\u6709\u7684\u9690\u85cf\u6587\u7269\u53ef\u4ee5\u89e3\u9501\u7279\u6b8a\u6210\u5c31\u548c\u5956\u52b1\u3002\u4f8b\u5982\uff0c\u5728\u77ff\u8f66\u533a\u57df\u53d1\u73b0\u9690\u85cf\u7684\u91d1\u5236\u5076\u50cf\u53ef\u4ee5\u83b7\u5f97\u663e\u8457\u7684\u786c\u5e01\u5956\u52b1\u3002\u8fd9\u4e9b\u79d8\u5bc6\u4e3a\u6e38\u620f\u589e\u6dfb\u4e86\u989d\u5916\u7684\u53d1\u73b0\u4e50\u8da3\u3002"}]
[{"question": "\u65b0\u624b\u5982\u4f55\u5feb\u901f\u638c\u63e1\u7334\u738b\u5f48\u5f13\u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u638c\u63e1\u7334\u738b\u5f48\u5f13\u7684\u57fa\u672c\u63a7\u5236\uff0c\u9996\u5148\u8981\u719f\u6089\u5f48\u5f13\u7684\u904b\u4f5c\u6a5f\u5236\u3002\u6b65\u9a5f\u4e00\uff1a\u8f15\u89f8\u4e26\u6309\u4f4f\u62c9\u4f38\u5f48\u5f13\u3002\u6b65\u9a5f\u4e8c\uff1a\u8abf\u6574\u89d2\u5ea6\u4f86\u7784\u6e96\u3002\u6b65\u9a5f\u4e09\uff1a\u653e\u958b\u4f86\u767c\u5c04\u7334\u5b50\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u95dc\uff0c\u4f7f\u7528\u9019\u7a2e\u65b9\u6cd5\u64ca\u4e2d\u9999\u8549\u76ee\u6a19\u3002\u5728\u6559\u5b78\u6a21\u5f0f\u4e2d\u7df4\u7fd2\uff0c\u624d\u80fd\u719f\u6089\u9019\u4e9b\u63a7\u5236\u3002\u628a\u5b83\u60f3\u6210\u7784\u6e96\u5f48\u5f13\u2014\u2014\u7cbe\u6e96\u81f3\u95dc\u91cd\u8981\uff01"}, {"question": "\u5728\u7334\u738b\u5f48\u5f13\u4e2d\uff0c\u91cb\u653e\u5f48\u5f13\u6642\u70ba\u4f55\u6642\u9593\u5f88\u91cd\u8981\uff1f", "answer": "\u5728\u7334\u738b\u5f48\u5f13\u4e2d\uff0c\u6642\u9593\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6703\u5f71\u97ff\u8ddd\u96e2\u548c\u6e96\u78ba\u6027\u3002\u91cb\u653e\u592a\u65e9\uff0c\u7334\u5b50\u53ef\u80fd\u6703\u4e0d\u5920\u9060\uff1b\u91cb\u653e\u592a\u665a\uff0c\u5247\u53ef\u80fd\u6703\u5c04\u504f\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e94\u95dc\uff0c\u6e96\u78ba\u5730\u63a7\u5236\u91cb\u653e\u6642\u9593\u53ef\u4ee5\u5e6b\u52a9\u4f60\u843d\u5230\u79fb\u52d5\u7684\u5e73\u53f0\u4e0a\u3002\u60f3\u50cf\u4e00\u4e0b\uff0c\u91cb\u653e\u5f13\u5f26\u2014\u2014\u6b63\u78ba\u7684\u6642\u9593\u80fd\u78ba\u4fdd\u7bad\u982d\u64ca\u4e2d\u9776\u5fc3\u3002\u5728\u65e9\u671f\u95dc\u5361\u7df4\u7fd2\uff0c\u53ef\u4ee5\u7cbe\u6e96\u63a7\u5236\u4f60\u7684\u6642\u9593\u3002"}, {"question": "\u5728\u7334\u738b\u5f48\u5f13\u4e2d\uff0c\u70ba\u4e86\u9032\u6b65\uff0c\u6709\u54ea\u4e9b\u91cd\u8981\u7684\u7269\u54c1\u9700\u8981\u6536\u96c6\uff1f", "answer": "\u5728\u7334\u738b\u5f48\u5f13\u4e2d\uff0c\u6536\u96c6\u9999\u8549\u7372\u5f97\u5206\u6578\uff0c\u6536\u96c6\u91d1\u9999\u8549\u5247\u89e3\u9396\u65b0\u95dc\u5361\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e09\u95dc\uff0c\u62ff\u5230\u91d1\u9999\u8549\u53ef\u4ee5\u8b93\u4f60\u9032\u5165\u7b2c\u56db\u95dc\u3002\u628a\u9999\u8549\u60f3\u6210\u71c3\u6599\u2014\u2014\u5b83\u5011\u8b93\u4f60\u80fd\u7e7c\u7e8c\u524d\u9032\u3002\u59cb\u7d42\u512a\u5148\u6536\u96c6\u91d1\u9999\u8549\uff0c\u56e0\u70ba\u5b83\u5011\u662f\u9032\u6b65\u7684\u95dc\u9375\u3002"}, {"question": "\u9ad8\u5206\u73a9\u5bb6\u5982\u4f55\u5728\u7334\u738b\u5f48\u5f13\u4e2d\u6700\u4f73\u5316\u7b56\u7565\uff1f", "answer": "\u9ad8\u968e\u73a9\u5bb6\u53ef\u4ee5\u900f\u904e\u5c08\u6ce8\u65bc\u9023\u64ca\u548c\u7cbe\u6e96\u5ea6\u4f86\u6700\u4f73\u5316\u7b56\u7565\u3002\u6b65\u9a5f\u4e00\uff1a\u4e00\u6b21\u7784\u6e96\u591a\u500b\u76ee\u6a19\u3002\u6b65\u9a5f\u4e8c\uff1a\u5229\u7528\u74b0\u5883\u7269\u4ef6\uff0c\u4f8b\u5982\u5f48\u7c27\uff0c\u4f86\u589e\u52a0\u8ddd\u96e2\u3002\u6b65\u9a5f\u4e09\uff1a\u6536\u96c6\u95dc\u5361\u4e2d\u7684\u6240\u6709\u9999\u8549\u7372\u5f97\u984d\u5916\u5206\u6578\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 10 \u95dc\uff0c\u4e00\u6b21\u767c\u5c04\u64ca\u4e2d\u4e09\u500b\u76ee\u6a19\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u4f60\u7684\u5206\u6578\u3002\u628a\u5b83\u60f3\u6210\u591a\u7c73\u8afe\u9aa8\u724c\u6548\u61c9\u2014\u2014\u6bcf\u500b\u52d5\u4f5c\u90fd\u6703\u5efa\u7acb\u4e0b\u4e00\u500b\u52d5\u4f5c\uff0c\u4ee5\u9054\u6210\u6700\u5927\u5f71\u97ff\u3002"}, {"question": "\u5728\u7334\u738b\u5f48\u5f13\u4e2d\uff0c\u54ea\u4e9b\u74b0\u5883\u5143\u7d20\u53ef\u4ee5\u7528\u4f86\u63d0\u5347\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u5f48\u7c27\u3001\u98a8\u6247\u548c\u79fb\u52d5\u5e73\u53f0\u7b49\u74b0\u5883\u5143\u7d20\u53ef\u4ee5\u63d0\u5347\u904a\u6232\u9ad4\u9a57\u3002\u6b65\u9a5f\u4e00\uff1a\u4f7f\u7528\u5f48\u7c27\u7372\u5f97\u984d\u5916\u7684\u5f48\u8df3\u9ad8\u5ea6\u3002\u6b65\u9a5f\u4e8c\uff1a\u7ad9\u5728\u98a8\u6247\u524d\u9762\u7372\u5f97\u901f\u5ea6\u52a0\u6210\u3002\u6b65\u9a5f\u4e09\uff1a\u914d\u5408\u79fb\u52d5\u5e73\u53f0\u7684\u6642\u9593\uff0c\u8b93\u7334\u5b50\u7cbe\u6e96\u8457\u9678\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e03\u95dc\uff0c\u4f7f\u7528\u5f48\u7c27\u53ef\u4ee5\u5e6b\u52a9\u4f60\u5230\u9054\u9ad8\u8655\u7684\u5e73\u53f0\uff0c\u7372\u5f97\u91d1\u9999\u8549\u3002\u628a\u9019\u4e9b\u5143\u7d20\u60f3\u6210\u5de5\u5177\u7bb1\u88e1\u7684\u5de5\u5177\u2014\u2014\u6bcf\u4e00\u500b\u90fd\u6709\u5176\u7279\u5b9a\u7528\u9014\u3002"}, {"question": "\u5728\u7334\u738b\u5f48\u5f13\u4e2d\uff0c\u70ba\u4ec0\u9ebc\u5728\u767c\u5c04\u524d\u7814\u7a76\u95dc\u5361\u4f48\u5c40\u5f88\u91cd\u8981\uff1f", "answer": "\u7814\u7a76\u95dc\u5361\u4f48\u5c40\u5f88\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u80fd\u5e6b\u52a9\u4f60\u898f\u5283\u52d5\u4f5c\u4e26\u907f\u514d\u969c\u7919\u3002\u6b65\u9a5f\u4e00\uff1a\u89c0\u5bdf\u76ee\u6a19\u548c\u969c\u7919\u7269\u7684\u4f4d\u7f6e\u3002\u6b65\u9a5f\u4e8c\uff1a\u8b58\u5225\u6700\u4f73\u767c\u5c04\u89d2\u5ea6\u3002\u6b65\u9a5f\u4e09\uff1a\u898f\u5283\u8def\u7dda\u6536\u96c6\u6240\u6709\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u516b\u95dc\uff0c\u77e5\u9053\u79fb\u52d5\u5e73\u53f0\u7684\u4f4d\u7f6e\u53ef\u4ee5\u5e6b\u52a9\u4f60\u7cbe\u6e96\u63a7\u5236\u767c\u5c04\u6642\u9593\u3002\u628a\u5b83\u60f3\u6210\u4e00\u5834\u68cb\u985e\u904a\u6232\u2014\u2014\u7b56\u7565\u6027\u7684\u898f\u5283\u5c07\u6703\u5e36\u4f86\u52dd\u5229\u3002"}, {"question": "\u7334\u738b\u5f48\u5f13\u7684\u5206\u6578\u7cfb\u7d71\u6a5f\u5236\u70ba\u4f55\uff1f", "answer": "\u7334\u738b\u5f48\u5f13\u7684\u5206\u6578\u7cfb\u7d71\u57fa\u65bc\u9999\u8549\u3001\u91d1\u9999\u8549\u548c\u9023\u64ca\u3002\u9999\u8549\u6bcf\u4e00\u500b\u7d66\u4e88 10 \u5206\uff0c\u91d1\u9999\u8549\u89e3\u9396\u95dc\u5361\uff0c\u9023\u64ca\u5247\u6703\u4e58\u4ee5\u4f60\u7684\u5206\u6578\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 12 \u95dc\uff0c\u6536\u96c6\u6240\u6709\u9999\u8549\u4e26\u4e00\u6b21\u64ca\u4e2d\u591a\u500b\u76ee\u6a19\u53ef\u4ee5\u7372\u5f97\u9ad8\u5206\u6578\u3002\u628a\u5b83\u60f3\u6210\u6578\u5b78\u65b9\u7a0b\u5f0f\u2014\u2014\u6bcf\u500b\u5143\u7d20\u90fd\u6703\u52a0\u7e3d\u5230\u4f60\u7684\u7e3d\u5206\u3002"}, {"question": "\u7334\u738b\u5f48\u5f13\u5982\u4f55\u5e73\u8861\u96e3\u5ea6\u63d0\u5347\uff1f", "answer": "\u7334\u738b\u5f48\u5f13\u900f\u904e\u9010\u6f38\u5f15\u5165\u65b0\u7684\u6a5f\u5236\u548c\u589e\u52a0\u8907\u96dc\u5ea6\u4f86\u5e73\u8861\u96e3\u5ea6\u63d0\u5347\u3002\u65e9\u671f\u95dc\u5361\u91cd\u9ede\u5728\u57fa\u672c\u5f48\u5f13\u6a5f\u5236\uff0c\u800c\u5f8c\u9762\u7684\u95dc\u5361\u5247\u52a0\u5165\u79fb\u52d5\u7684\u76ee\u6a19\u548c\u969c\u7919\u7269\u3002\u4f8b\u5982\uff0c\u7b2c 15 \u95dc\u5f15\u5165\u4e86\u98a8\u963b\uff0c\u9700\u8981\u66f4\u7cbe\u6e96\u7684\u767c\u5c04\u3002\u628a\u5b83\u60f3\u6210\u968e\u68af\u2014\u2014\u6bcf\u4e00\u6b65\u90fd\u5efa\u7acb\u5728\u524d\u4e00\u968e\u4e0a\u9762\uff0c\u589e\u52a0\u6311\u6230\u3002"}, {"question": "\u7334\u738b\u5f48\u5f13\u7684\u4e0d\u540c\u5e73\u53f0\u4e0a\u7684\u9032\u5ea6\u662f\u5426\u53ef\u4ee5\u4e92\u76f8\u8f49\u79fb\uff1f", "answer": "\u662f\u7684\uff0c\u5982\u679c\u60a8\u4f7f\u7528\u540c\u4e00\u500b\u5e33\u865f\uff0c\u7334\u738b\u5f48\u5f13\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u7684\u9032\u5ea6\u53ef\u4ee5\u4e92\u76f8\u8f49\u79fb\u3002\u6b65\u9a5f\u4e00\uff1a\u5728\u65b0\u88dd\u7f6e\u4e0a\u767b\u5165\u60a8\u7684\u5e33\u865f\u3002\u6b65\u9a5f\u4e8c\uff1a\u900f\u904e\u96f2\u7aef\u540c\u6b65\u60a8\u7684\u9032\u5ea6\u3002\u6b65\u9a5f\u4e09\uff1a\u5f9e\u4e0a\u6b21\u96e2\u958b\u7684\u5730\u65b9\u7e7c\u7e8c\u904a\u6232\u3002\u4f8b\u5982\uff0c\u5f9e iOS \u5207\u63db\u5230 Android\uff0c\u60a8\u7684\u95dc\u5361\u89e3\u9396\u548c\u9ad8\u5206\u6578\u5c07\u6703\u4fdd\u7559\u3002\u628a\u5b83\u60f3\u6210\u4e00\u500b\u80cc\u5305\u2014\u2014\u4f60\u7684\u9032\u5ea6\u59cb\u7d42\u4f34\u96a8\u8457\u4f60\uff0c\u7121\u8ad6\u4f7f\u7528\u54ea\u500b\u88dd\u7f6e\u3002"}, {"question": "\u7334\u738b\u5f48\u5f13\u4e2d\u6709\u4ec0\u9ebc\u96b1\u85cf\u79d8\u5bc6\u6216\u5f69\u86cb\uff1f", "answer": "\u7334\u738b\u5f48\u5f13\u5305\u542b\u96b1\u85cf\u79d8\u5bc6\uff0c\u4f8b\u5982\u984d\u5916\u95dc\u5361\u548c\u7279\u6b8a\u52d5\u756b\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 20 \u95dc\uff0c\u5c07\u7334\u5b50\u767c\u5c04\u5230\u7279\u5b9a\u6a39\u4e0a\u6703\u986f\u793a\u96b1\u85cf\u7684\u984d\u5916\u95dc\u5361\u3002\u628a\u5b83\u60f3\u6210\u5c0b\u5bf6\u904a\u6232\u2014\u2014\u63a2\u7d22\u6bcf\u500b\u89d2\u843d\u548c\u7e2b\u9699\u53ef\u80fd\u5e36\u4f86\u4ee4\u4eba\u9a5a\u559c\u7684\u9a5a\u559c\u3002\u7559\u610f\u95dc\u5361\u4e2d\u4e0d\u5c0b\u5e38\u7684\u7269\u4ef6\u6216\u5716\u6848\u3002"}]
[{"question": "\u30b5\u30eb\u30b9\u30ea\u30f3\u30b0\u3067\u57fa\u672c\u64cd\u4f5c\u3092\u521d\u5fc3\u8005\u306e\u65b9\u304c\u3059\u3050\u306b\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30b5\u30eb\u30b9\u30ea\u30f3\u30b0\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u307e\u305a\u30b9\u30ea\u30f3\u30b0\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u6163\u308c\u308b\u3053\u3068\u304b\u3089\u59cb\u3081\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b9\u30ea\u30f3\u30b0\u3092\u4f38\u3070\u3059\u305f\u3081\u306b\u30bf\u30c3\u30d7\u30a2\u30f3\u30c9\u30db\u30fc\u30eb\u30c9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u89d2\u5ea6\u3092\u8abf\u6574\u3057\u3066\u72d9\u3044\u3092\u5b9a\u3081\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b5\u30eb\u3092\u653e\u3061\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u3053\u306e\u65b9\u6cd5\u3067\u30d0\u30ca\u30ca\u306e\u6a19\u7684\u306b\u5f53\u3066\u307e\u3057\u3087\u3046\u3002\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3067\u7df4\u7fd2\u3057\u3066\u3001\u3053\u308c\u3089\u306e\u64cd\u4f5c\u306b\u6163\u308c\u307e\u3057\u3087\u3046\u3002\u30ab\u30bf\u30d1\u30eb\u30c8\u3092\u5f53\u3066\u308b\u3088\u3046\u306a\u3082\u306e\u3060\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u6b63\u78ba\u6027\u304c\u91cd\u8981\u3067\u3059\uff01"}, {"question": "\u30b5\u30eb\u30b9\u30ea\u30f3\u30b0\u3067\u30b9\u30ea\u30f3\u30b0\u3092\u653e\u3059\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u30b5\u30eb\u30b9\u30ea\u30f3\u30b0\u3067\u306f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u8ddd\u96e2\u3068\u6b63\u78ba\u6027\u306e\u4e21\u65b9\u306b\u5f71\u97ff\u3059\u308b\u305f\u3081\u91cd\u8981\u3067\u3059\u3002\u65e9\u3059\u304e\u308b\u3068\u3001\u30b5\u30eb\u306f\u5c4a\u304d\u307e\u305b\u3093\u3002\u9045\u3059\u304e\u308b\u3068\u3001\u30b5\u30eb\u306f\u30aa\u30fc\u30d0\u30fc\u30b7\u30e5\u30fc\u30c8\u3057\u3066\u3057\u307e\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb5\u3067\u306f\u3001\u653e\u3064\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5b8c\u74a7\u306b\u5408\u308f\u305b\u308b\u3068\u3001\u52d5\u3044\u3066\u3044\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u7740\u9678\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u5f13\u306e\u5f26\u3092\u653e\u3064\u3088\u3046\u306a\u3082\u306e\u3060\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u6b63\u3057\u3044\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u77e2\u304c\u7684\u3092\u5c04\u307e\u3059\u3002\u521d\u671f\u306e\u30ec\u30d9\u30eb\u3067\u7df4\u7fd2\u3057\u3066\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5fae\u8abf\u6574\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u30b5\u30eb\u30b9\u30ea\u30f3\u30b0\u3067\u9032\u884c\u3059\u308b\u305f\u3081\u306b\u53ce\u96c6\u3059\u308b\u5fc5\u9808\u30a2\u30a4\u30c6\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b5\u30eb\u30b9\u30ea\u30f3\u30b0\u3067\u306f\u3001\u30d0\u30ca\u30ca\u3092\u53ce\u96c6\u3057\u3066\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u3001\u30b4\u30fc\u30eb\u30c7\u30f3\u30d0\u30ca\u30ca\u3092\u53ce\u96c6\u3057\u3066\u65b0\u3057\u3044\u30ec\u30d9\u30eb\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb3\u3067\u306f\u3001\u30b4\u30fc\u30eb\u30c7\u30f3\u30d0\u30ca\u30ca\u3092\u624b\u306b\u5165\u308c\u308b\u3053\u3068\u3067\u30ec\u30d9\u30eb4\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059\u3002\u30d0\u30ca\u30ca\u306f\u71c3\u6599\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u524d\u9032\u3057\u7d9a\u3051\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u30b4\u30fc\u30eb\u30c7\u30f3\u30d0\u30ca\u30ca\u3092\u5e38\u306b\u512a\u5148\u3057\u307e\u3057\u3087\u3046\u3002\u3053\u308c\u3089\u306f\u9032\u884c\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002"}, {"question": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30b5\u30eb\u30b9\u30ea\u30f3\u30b0\u3067\u9ad8\u5f97\u70b9\u3092\u5f97\u308b\u305f\u3081\u306b\u6226\u7565\u3092\u3069\u306e\u3088\u3046\u306b\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30b3\u30f3\u30dc\u30c1\u30a7\u30fc\u30f3\u3068\u6b63\u78ba\u6027\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u6226\u7565\u3092\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u4e00\u5ea6\u306e\u30b7\u30e7\u30c3\u30c8\u3067\u8907\u6570\u306e\u30bf\u30fc\u30b2\u30c3\u30c8\u3092\u72d9\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d0\u30cd\u306a\u3069\u306e\u74b0\u5883\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u4f7f\u7528\u3057\u3066\u3001\u3055\u3089\u306b\u9060\u304f\u307e\u3067\u98db\u3070\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30ec\u30d9\u30eb\u5185\u306e\u3059\u3079\u3066\u306e\u30d0\u30ca\u30ca\u3092\u96c6\u3081\u3066\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb10\u3067\u306f\u3001\u4e00\u5ea6\u306e\u5c04\u6483\u30673\u3064\u306e\u30bf\u30fc\u30b2\u30c3\u30c8\u306b\u5f53\u305f\u308b\u3068\u3001\u30b9\u30b3\u30a2\u304c\u5927\u5e45\u306b\u4e0a\u6607\u3057\u307e\u3059\u3002\u30c9\u30df\u30ce\u52b9\u679c\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u305d\u308c\u305e\u308c\u306e\u52d5\u304d\u304c\u6700\u5927\u306e\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u6b21\u306e\u52d5\u304d\u3092\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7\u3057\u307e\u3059\u3002"}, {"question": "\u30b5\u30eb\u30b9\u30ea\u30f3\u30b0\u3067\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5f37\u5316\u3059\u308b\u305f\u3081\u306b\u4f7f\u7528\u3067\u304d\u308b\u74b0\u5883\u8981\u7d20\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d0\u30cd\u3001\u6247\u98a8\u6a5f\u3001\u52d5\u304f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306a\u3069\u306e\u74b0\u5883\u8981\u7d20\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5f37\u5316\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30d0\u30cd\u3092\u4f7f\u7528\u3057\u3066\u3001\u3055\u3089\u306b\u9ad8\u3044\u5834\u6240\u306b\u98db\u3073\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6247\u98a8\u6a5f\u306e\u524d\u9762\u306b\u9663\u53d6\u308b\u3068\u52a0\u901f\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u79fb\u52d5\u3059\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3068\u540c\u6642\u306b\u767a\u5c04\u3057\u3066\u3001\u6b63\u78ba\u306b\u7740\u5730\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb7\u3067\u306f\u3001\u30d0\u30cd\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u30b4\u30fc\u30eb\u30c7\u30f3\u30d0\u30ca\u30ca\u306e\u3042\u308b\u9ad8\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u5230\u9054\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u3053\u308c\u3089\u306f\u30c4\u30fc\u30eb\u30dc\u30c3\u30af\u30b9\u306e\u30c4\u30fc\u30eb\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u305d\u308c\u305e\u308c\u306b\u56fa\u6709\u306e\u76ee\u7684\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30b5\u30eb\u30b9\u30ea\u30f3\u30b0\u3067\u767a\u5c04\u3059\u308b\u524d\u306b\u30ec\u30d9\u30eb\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u7814\u7a76\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u30ec\u30d9\u30eb\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u7814\u7a76\u3059\u308b\u3053\u3068\u306f\u3001\u52d5\u304d\u3092\u8a08\u753b\u3057\u3001\u969c\u5bb3\u7269\u3092\u56de\u907f\u3059\u308b\u306e\u306b\u5f79\u7acb\u3064\u305f\u3081\u91cd\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30bf\u30fc\u30b2\u30c3\u30c8\u3068\u969c\u5bb3\u7269\u306e\u4f4d\u7f6e\u3092\u89b3\u5bdf\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6700\u9069\u306a\u767a\u5c04\u89d2\u5ea6\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u3059\u3079\u3066\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u53ce\u96c6\u3059\u308b\u305f\u3081\u306e\u7d4c\u8def\u3092\u8a08\u753b\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb8\u3067\u306f\u3001\u79fb\u52d5\u3059\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u4f4d\u7f6e\u3092\u77e5\u308b\u3053\u3068\u3067\u3001\u767a\u5c04\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5b8c\u74a7\u306b\u5408\u308f\u305b\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u30c1\u30a7\u30b9\u306e\u30b2\u30fc\u30e0\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u6226\u7565\u7684\u306a\u8a08\u753b\u304c\u52dd\u5229\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002"}, {"question": "\u30b5\u30eb\u30b9\u30ea\u30f3\u30b0\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306e\u57fa\u790e\u3068\u306a\u308b\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b5\u30eb\u30b9\u30ea\u30f3\u30b0\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d0\u30ca\u30ca\u3001\u30b4\u30fc\u30eb\u30c7\u30f3\u30d0\u30ca\u30ca\u3001\u30b3\u30f3\u30dc\u30c1\u30a7\u30fc\u30f3\u304b\u3089\u306e\u30dd\u30a4\u30f3\u30c8\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u30d0\u30ca\u30ca\u306f1\u3064\u3042\u305f\u308a10\u30dd\u30a4\u30f3\u30c8\u3001\u30b4\u30fc\u30eb\u30c7\u30f3\u30d0\u30ca\u30ca\u306f\u30ec\u30d9\u30eb\u3092\u958b\u653e\u3057\u3001\u30b3\u30f3\u30dc\u306f\u30b9\u30b3\u30a2\u3092\u4e57\u7b97\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb12\u3067\u306f\u3001\u3059\u3079\u3066\u306e\u30d0\u30ca\u30ca\u3092\u96c6\u3081\u3001\u4e00\u5ea6\u306e\u30b7\u30e7\u30c3\u30c8\u3067\u8907\u6570\u306e\u30bf\u30fc\u30b2\u30c3\u30c8\u306b\u547d\u4e2d\u3059\u308b\u3068\u3001\u9ad8\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u6570\u5b66\u306e\u5f0f\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u305d\u308c\u305e\u308c\u306e\u8981\u7d20\u304c\u5408\u8a08\u30b9\u30b3\u30a2\u306b\u5408\u8a08\u3055\u308c\u307e\u3059\u3002"}, {"question": "\u30b5\u30eb\u30b9\u30ea\u30f3\u30b0\u3067\u306f\u3001\u96e3\u6613\u5ea6\u306e\u4e0a\u6607\u306f\u3069\u306e\u3088\u3046\u306b\u30d0\u30e9\u30f3\u30b9\u304c\u53d6\u3089\u308c\u3066\u3044\u307e\u3059\u304b\uff1f", "answer": "\u30b5\u30eb\u30b9\u30ea\u30f3\u30b0\u3067\u306f\u3001\u65b0\u3057\u3044\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u5f90\u3005\u306b\u5c0e\u5165\u3057\u3001\u8907\u96d1\u3055\u3092\u5897\u3084\u3059\u3053\u3068\u3067\u3001\u96e3\u6613\u5ea6\u306e\u4e0a\u6607\u304c\u30d0\u30e9\u30f3\u30b9\u304c\u53d6\u3089\u308c\u3066\u3044\u307e\u3059\u3002\u521d\u671f\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u57fa\u672c\u7684\u306a\u30b9\u30ea\u30f3\u30b0\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u304c\u3001\u5f8c\u671f\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u52d5\u304f\u30bf\u30fc\u30b2\u30c3\u30c8\u3068\u969c\u5bb3\u7269\u304c\u8ffd\u52a0\u3055\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb15\u3067\u306f\u3001\u3088\u308a\u6b63\u78ba\u306a\u767a\u5c04\u3092\u5fc5\u8981\u3068\u3059\u308b\u98a8\u62b5\u6297\u304c\u5c0e\u5165\u3055\u308c\u307e\u3059\u3002\u968e\u6bb5\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u5404\u30b9\u30c6\u30c3\u30d7\u306f\u524d\u306e\u30b9\u30c6\u30c3\u30d7\u306e\u4e0a\u306b\u69cb\u7bc9\u3055\u308c\u3001\u6311\u6226\u304c\u5897\u3057\u307e\u3059\u3002"}, {"question": "\u30b5\u30eb\u30b9\u30ea\u30f3\u30b0\u3067\u5f97\u305f\u9032\u6357\u72b6\u6cc1\u306f\u3001\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u5f15\u304d\u7d99\u304c\u308c\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u4f7f\u7528\u3057\u3066\u3044\u308b\u5834\u5408\u3001\u30b5\u30eb\u30b9\u30ea\u30f3\u30b0\u306e\u9032\u6357\u72b6\u6cc1\u306f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u5f15\u304d\u7d99\u304c\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30af\u30e9\u30a6\u30c9\u3092\u901a\u3058\u3066\u9032\u6357\u72b6\u6cc1\u3092\u540c\u671f\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u4e2d\u65ad\u3057\u305f\u3068\u3053\u308d\u304b\u3089\u30b2\u30fc\u30e0\u3092\u7d9a\u3051\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001iOS\u304b\u3089Android\u306b\u5207\u308a\u66ff\u3048\u308b\u3068\u3001\u30ec\u30d9\u30eb\u306e\u30a2\u30f3\u30ed\u30c3\u30af\u3068\u9ad8\u5f97\u70b9\u306f\u7dad\u6301\u3055\u308c\u307e\u3059\u3002\u30ea\u30e5\u30c3\u30af\u30b5\u30c3\u30af\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u9032\u6357\u72b6\u6cc1\u306f\u3001\u30c7\u30d0\u30a4\u30b9\u306b\u95a2\u308f\u3089\u305a\u5e38\u306b\u3042\u306a\u305f\u3068\u5171\u306b\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30b5\u30eb\u30b9\u30ea\u30f3\u30b0\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u79d8\u5bc6\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30b5\u30eb\u30b9\u30ea\u30f3\u30b0\u306b\u306f\u3001\u30dc\u30fc\u30ca\u30b9\u30ec\u30d9\u30eb\u3084\u7279\u6b8a\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3\u306a\u3069\u306e\u96a0\u3055\u308c\u305f\u79d8\u5bc6\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb20\u3067\u306f\u3001\u30b5\u30eb\u3092\u7279\u5b9a\u306e\u6728\u306e\u4e2d\u306b\u653e\u308a\u8fbc\u3080\u3068\u3001\u96a0\u3055\u308c\u305f\u30dc\u30fc\u30ca\u30b9\u30ec\u30d9\u30eb\u304c\u73fe\u308c\u307e\u3059\u3002\u5b9d\u63a2\u3057\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u30ec\u30d9\u30eb\u306e\u9685\u3005\u307e\u3067\u63a2\u6c42\u3059\u308b\u3068\u3001\u697d\u3057\u3044\u9a5a\u304d\u304c\u3042\u308a\u307e\u3059\u3002\u30ec\u30d9\u30eb\u5185\u306e\u73cd\u3057\u3044\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3084\u30d1\u30bf\u30fc\u30f3\u3092\u63a2\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}]
[{"question": "\u65b0\u624b\u5982\u4f55\u5feb\u901f\u638c\u63e1\u733f\u7334\u6295\u63b7\u6e38\u620f\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u638c\u63e1\u733f\u7334\u6295\u63b7\u6e38\u620f\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u9996\u5148\u8981\u719f\u6089\u6295\u63b7\u673a\u5236\u3002\u6b65\u9aa4\u4e00\uff1a\u70b9\u51fb\u5e76\u6309\u4f4f\u62c9\u4f38\u6295\u63b7\u5e26\u3002\u6b65\u9aa4\u4e8c\uff1a\u8c03\u6574\u89d2\u5ea6\u8fdb\u884c\u7784\u51c6\u3002\u6b65\u9aa4\u4e09\uff1a\u91ca\u653e\u733f\u7334\u8fdb\u884c\u6295\u63b7\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u5173\uff0c\u4f7f\u7528\u8fd9\u79cd\u65b9\u6cd5\u51fb\u4e2d\u9999\u8549\u76ee\u6807\u3002\u5728\u6559\u7a0b\u4e2d\u7ec3\u4e60\uff0c\u4ee5\u4fbf\u719f\u6089\u8fd9\u4e9b\u64cd\u4f5c\u3002\u60f3\u8c61\u4e00\u4e0b\u7784\u51c6\u5f39\u5f13\u2014\u2014\u7cbe\u786e\u81f3\u5173\u91cd\u8981\uff01"}, {"question": "\u5728\u733f\u7334\u6295\u63b7\u6e38\u620f\u4e2d\uff0c\u91ca\u653e\u6295\u63b7\u5e26\u7684\u65f6\u95f4\u4e3a\u4ec0\u4e48\u91cd\u8981\uff1f", "answer": "\u5728\u733f\u7334\u6295\u63b7\u6e38\u620f\u4e2d\uff0c\u65f6\u95f4\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u4f1a\u5f71\u54cd\u8ddd\u79bb\u548c\u51c6\u786e\u6027\u3002\u91ca\u653e\u8fc7\u65e9\uff0c\u733f\u7334\u53ef\u80fd\u4f1a\u5c04\u7a0b\u4e0d\u8db3\uff1b\u91ca\u653e\u8fc7\u665a\uff0c\u5219\u53ef\u80fd\u4f1a\u5c04\u504f\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e94\u5173\uff0c\u5b8c\u7f8e\u5730\u63a7\u5236\u91ca\u653e\u65f6\u95f4\u53ef\u4ee5\u5e2e\u52a9\u4f60\u843d\u5728\u79fb\u52a8\u5e73\u53f0\u4e0a\u3002\u60f3\u8c61\u4e00\u4e0b\u62c9\u5f13\u5f26\u2014\u2014\u6b63\u786e\u7684\u65f6\u95f4\u786e\u4fdd\u7bad\u547d\u4e2d\u9776\u5fc3\u3002\u5728\u65e9\u671f\u5173\u5361\u7ec3\u4e60\uff0c\u4ee5\u6539\u8fdb\u4f60\u7684\u65f6\u95f4\u63a7\u5236\u3002"}, {"question": "\u5728\u733f\u7334\u6295\u63b7\u6e38\u620f\u4e2d\uff0c\u4e3a\u4e86\u6e38\u620f\u8fdb\u5ea6\u9700\u8981\u6536\u96c6\u54ea\u4e9b\u91cd\u8981\u7684\u7269\u54c1\uff1f", "answer": "\u5728\u733f\u7334\u6295\u63b7\u6e38\u620f\u4e2d\uff0c\u6536\u96c6\u9999\u8549\u4ee5\u83b7\u5f97\u5206\u6570\uff0c\u6536\u96c6\u91d1\u9999\u8549\u4ee5\u89e3\u9501\u65b0\u5173\u5361\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e09\u5173\uff0c\u6293\u4f4f\u91d1\u9999\u8549\u53ef\u4ee5\u8ba9\u4f60\u8fdb\u5165\u7b2c\u56db\u5173\u3002\u628a\u9999\u8549\u60f3\u8c61\u6210\u71c3\u6599\u2014\u2014\u5b83\u4eec\u63a8\u52a8\u4f60\u524d\u8fdb\u3002\u59cb\u7ec8\u4f18\u5148\u6536\u96c6\u91d1\u9999\u8549\uff0c\u56e0\u4e3a\u5b83\u4eec\u662f\u6e38\u620f\u8fdb\u5ea6\u7684\u5173\u952e\u3002"}, {"question": "\u9ad8\u7ea7\u73a9\u5bb6\u5982\u4f55\u5728\u733f\u7334\u6295\u63b7\u6e38\u620f\u4e2d\u4f18\u5316\u7b56\u7565\u4ee5\u83b7\u5f97\u9ad8\u5206\uff1f", "answer": "\u9ad8\u7ea7\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u4e13\u6ce8\u4e8e\u8fde\u51fb\u548c\u7cbe\u786e\u6027\u6765\u4f18\u5316\u4ed6\u4eec\u7684\u7b56\u7565\u3002\u6b65\u9aa4\u4e00\uff1a\u7784\u51c6\u4e00\u6b21\u51fb\u4e2d\u591a\u4e2a\u76ee\u6807\u3002\u6b65\u9aa4\u4e8c\uff1a\u5229\u7528\u73af\u5883\u4e2d\u7684\u5f39\u7c27\u7b49\u9053\u5177\u589e\u52a0\u6295\u63b7\u8ddd\u79bb\u3002\u6b65\u9aa4\u4e09\uff1a\u6536\u96c6\u5173\u5361\u4e2d\u7684\u6240\u6709\u9999\u8549\u4ee5\u83b7\u5f97\u989d\u5916\u5206\u6570\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u5341\u5173\uff0c\u4e00\u6b21\u6295\u63b7\u51fb\u4e2d\u4e09\u4e2a\u76ee\u6807\u53ef\u4ee5\u663e\u8457\u63d0\u5347\u4f60\u7684\u5206\u6570\u3002\u60f3\u8c61\u4e00\u4e0b\u591a\u7c73\u8bfa\u9aa8\u724c\u6548\u5e94\u2014\u2014\u6bcf\u4e2a\u52a8\u4f5c\u90fd\u4f1a\u4e3a\u4e0b\u4e00\u4e2a\u52a8\u4f5c\u521b\u9020\u6700\u5927\u7684\u5f71\u54cd\u3002"}, {"question": "\u5728\u733f\u7334\u6295\u63b7\u6e38\u620f\u4e2d\uff0c\u54ea\u4e9b\u73af\u5883\u5143\u7d20\u53ef\u4ee5\u589e\u5f3a\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u5f39\u7c27\u3001\u98ce\u6247\u548c\u79fb\u52a8\u5e73\u53f0\u7b49\u73af\u5883\u5143\u7d20\u53ef\u4ee5\u589e\u5f3a\u6e38\u620f\u4f53\u9a8c\u3002\u6b65\u9aa4\u4e00\uff1a\u4f7f\u7528\u5f39\u7c27\u83b7\u5f97\u989d\u5916\u7684\u9ad8\u5ea6\u3002\u6b65\u9aa4\u4e8c\uff1a\u7ad9\u5728\u98ce\u6247\u524d\u9762\u83b7\u5f97\u901f\u5ea6\u52a0\u6210\u3002\u6b65\u9aa4\u4e09\uff1a\u4e0e\u79fb\u52a8\u5e73\u53f0\u914d\u5408\u8fdb\u884c\u7cbe\u51c6\u7740\u9646\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e03\u5173\uff0c\u4f7f\u7528\u5f39\u7c27\u53ef\u4ee5\u5e2e\u52a9\u4f60\u5230\u8fbe\u4e00\u4e2a\u5e26\u6709\u91d1\u9999\u8549\u7684\u9ad8\u5e73\u53f0\u3002\u60f3\u8c61\u4e00\u4e0b\u5de5\u5177\u7bb1\u4e2d\u7684\u5de5\u5177\u2014\u2014\u6bcf\u4e2a\u5de5\u5177\u90fd\u6709\u7279\u5b9a\u7684\u7528\u9014\u3002"}, {"question": "\u5728\u733f\u7334\u6295\u63b7\u6e38\u620f\u4e2d\uff0c\u5728\u6295\u63b7\u524d\u7814\u7a76\u5173\u5361\u5e03\u5c40\u6709\u4ec0\u4e48\u91cd\u8981\u6027\uff1f", "answer": "\u5728\u6295\u63b7\u524d\u7814\u7a76\u5173\u5361\u5e03\u5c40\u5f88\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u53ef\u4ee5\u5e2e\u52a9\u4f60\u8ba1\u5212\u4f60\u7684\u52a8\u4f5c\u5e76\u907f\u5f00\u969c\u788d\u7269\u3002\u6b65\u9aa4\u4e00\uff1a\u89c2\u5bdf\u76ee\u6807\u548c\u969c\u788d\u7269\u7684\u4f4d\u7f6e\u3002\u6b65\u9aa4\u4e8c\uff1a\u786e\u5b9a\u6700\u4f73\u6295\u63b7\u89d2\u5ea6\u3002\u6b65\u9aa4\u4e09\uff1a\u89c4\u5212\u8def\u7ebf\u6536\u96c6\u6240\u6709\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u516b\u5173\uff0c\u77e5\u9053\u79fb\u52a8\u5e73\u53f0\u7684\u4f4d\u7f6e\u53ef\u4ee5\u5e2e\u52a9\u4f60\u5b8c\u7f8e\u5730\u63a7\u5236\u6295\u63b7\u65f6\u95f4\u3002\u628a\u5b83\u60f3\u8c61\u6210\u4e00\u76d8\u8c61\u68cb\u2014\u2014\u6218\u7565\u89c4\u5212\u5c06\u5bfc\u81f4\u80dc\u5229\u3002"}, {"question": "\u733f\u7334\u6295\u63b7\u6e38\u620f\u7684\u8bc4\u5206\u7cfb\u7edf\u80cc\u540e\u7684\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "\u733f\u7334\u6295\u63b7\u6e38\u620f\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u9999\u8549\u3001\u91d1\u9999\u8549\u548c\u8fde\u51fb\u5f97\u5206\u3002\u9999\u8549\u6bcf\u989710\u5206\uff0c\u91d1\u9999\u8549\u89e3\u9501\u5173\u5361\uff0c\u8fde\u51fb\u4f1a\u4e58\u4ee5\u4f60\u7684\u5206\u6570\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u5341\u4e8c\u5173\uff0c\u6536\u96c6\u6240\u6709\u9999\u8549\u548c\u4e00\u6b21\u51fb\u4e2d\u591a\u4e2a\u76ee\u6807\u53ef\u4ee5\u83b7\u5f97\u9ad8\u5206\u3002\u60f3\u8c61\u4e00\u4e0b\u6570\u5b66\u516c\u5f0f\u2014\u2014\u6bcf\u4e2a\u5143\u7d20\u90fd\u4f1a\u7d2f\u79ef\u5230\u4f60\u7684\u603b\u5206\u3002"}, {"question": "\u733f\u7334\u6295\u63b7\u6e38\u620f\u5982\u4f55\u5e73\u8861\u6e38\u620f\u96be\u5ea6\u7684\u63d0\u5347\uff1f", "answer": "\u733f\u7334\u6295\u63b7\u6e38\u620f\u901a\u8fc7\u9010\u6b65\u5f15\u5165\u65b0\u7684\u673a\u5236\u5e76\u589e\u52a0\u590d\u6742\u6027\u6765\u5e73\u8861\u6e38\u620f\u96be\u5ea6\u7684\u63d0\u5347\u3002\u65e9\u671f\u5173\u5361\u4fa7\u91cd\u4e8e\u57fa\u672c\u6295\u63b7\u673a\u5236\uff0c\u800c\u540e\u671f\u5173\u5361\u5219\u589e\u52a0\u4e86\u79fb\u52a8\u76ee\u6807\u548c\u969c\u788d\u7269\u3002\u4f8b\u5982\uff0c\u7b2c\u5341\u4e94\u5173\u5f15\u5165\u4e86\u98ce\u963b\uff0c\u9700\u8981\u66f4\u7cbe\u786e\u7684\u6295\u63b7\u3002\u60f3\u8c61\u4e00\u4e0b\u9636\u68af\u2014\u2014\u6bcf\u4e00\u7ea7\u90fd\u5efa\u7acb\u5728\u524d\u4e00\u7ea7\u4e4b\u4e0a\uff0c\u589e\u52a0\u4e86\u6311\u6218\u3002"}, {"question": "\u733f\u7334\u6295\u63b7\u6e38\u620f\u7684\u8fdb\u5ea6\u53ef\u4ee5\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u5417\uff1f", "answer": "\u662f\u7684\uff0c\u5982\u679c\u60a8\u4f7f\u7528\u76f8\u540c\u7684\u5e10\u6237\uff0c\u733f\u7334\u6295\u63b7\u6e38\u620f\u7684\u8fdb\u5ea6\u53ef\u4ee5\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u3002\u6b65\u9aa4\u4e00\uff1a\u5728\u65b0\u8bbe\u5907\u4e0a\u767b\u5f55\u60a8\u7684\u5e10\u6237\u3002\u6b65\u9aa4\u4e8c\uff1a\u901a\u8fc7\u4e91\u7aef\u540c\u6b65\u60a8\u7684\u8fdb\u5ea6\u3002\u6b65\u9aa4\u4e09\uff1a\u4ece\u60a8\u4e0a\u6b21\u79bb\u5f00\u7684\u5730\u65b9\u7ee7\u7eed\u6e38\u620f\u3002\u4f8b\u5982\uff0c\u4ece iOS \u5207\u6362\u5230 Android \u5c06\u4fdd\u7559\u60a8\u7684\u5173\u5361\u89e3\u9501\u548c\u9ad8\u5206\u3002\u60f3\u8c61\u4e00\u4e0b\u80cc\u5305\u2014\u2014\u65e0\u8bba\u4f7f\u7528\u54ea\u4e2a\u8bbe\u5907\uff0c\u60a8\u7684\u8fdb\u5ea6\u90fd\u59cb\u7ec8\u968f\u8eab\u643a\u5e26\u3002"}, {"question": "\u733f\u7334\u6295\u63b7\u6e38\u620f\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u79d8\u5bc6\u6216\u5f69\u86cb\uff1f", "answer": "\u733f\u7334\u6295\u63b7\u6e38\u620f\u5305\u542b\u9690\u85cf\u79d8\u5bc6\uff0c\u4f8b\u5982\u5956\u52b1\u5173\u5361\u548c\u7279\u6b8a\u52a8\u753b\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 20 \u5173\uff0c\u5c06\u733f\u7334\u6295\u63b7\u5230\u7279\u5b9a\u7684\u6811\u4e0a\u4f1a\u63ed\u793a\u9690\u85cf\u7684\u5956\u52b1\u5173\u5361\u3002\u60f3\u8c61\u4e00\u4e0b\u5bfb\u5b9d\u6e38\u620f\u2014\u2014\u63a2\u7d22\u6bcf\u4e00\u4e2a\u89d2\u843d\u548c\u7f1d\u9699\u53ef\u80fd\u4f1a\u5e26\u6765\u60ca\u559c\u3002\u5bc6\u5207\u5173\u6ce8\u5173\u5361\u4e2d\u7684\u5f02\u5e38\u7269\u4f53\u6216\u56fe\u6848\u3002"}]
[{"question": "\uc6d0\uc22d\uc774 \ub358\uc9c0\uae30\uc5d0\uc11c \ucd08\ubcf4\uc790\uac00 \uae30\ubcf8 \uc81c\uc5b4\ub97c \ube60\ub974\uac8c \ub9c8\uc2a4\ud130\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc6d0\uc22d\uc774 \ub358\uc9c0\uae30\uc5d0\uc11c \uae30\ubcf8 \uc81c\uc5b4\ub97c \ub9c8\uc2a4\ud130\ud558\ub824\uba74, \ucc98\uc74c\ubd80\ud130 \ub358\uc9c0\uae30 \uba54\ucee4\ub2c8\uc998\uc5d0 \uc775\uc219\ud574\uc9c0\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. STEP1: \ub358\uc9c0\uae30\ub97c \ub298\ub9ac\ub824\uba74 \ud0ed\ud558\uace0 \ub204\ub985\ub2c8\ub2e4. STEP2: \uac01\ub3c4\ub97c \uc870\uc815\ud558\uc5ec \uc870\uc900\ud569\ub2c8\ub2e4. STEP3: \uc6d0\uc22d\uc774\ub97c \ubc1c\uc0ac\ud558\ub824\uba74 \ub193\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c\ub294 \ubc14\ub098\ub098 \ud45c\uc801\uc744 \ub9de\ucd94\ub294 \ub370 \uc774 \ubc29\ubc95\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc81c\uc5b4\uc5d0 \uc775\uc219\ud574\uc9c0\ub824\uba74 \ud29c\ud1a0\ub9ac\uc5bc\uc5d0\uc11c \uc5f0\uc2b5\ud558\uc138\uc694. \ud22c\uc11d\uae30\uc758 \uc870\uc900\uacfc \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uc2ed\uc2dc\uc624. \uc815\ud655\uc131\uc774 \uc911\uc694\ud569\ub2c8\ub2e4!"}, {"question": "\uc6d0\uc22d\uc774 \ub358\uc9c0\uae30\uc5d0\uc11c \ub358\uc9c0\uae30 \ud0c0\uc774\ubc0d\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc6d0\uc22d\uc774 \ub358\uc9c0\uae30\uc5d0\uc11c \ud0c0\uc774\ubc0d\uc740 \uac70\ub9ac\uc640 \uc815\ud655\uc131\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \ub108\ubb34 \uc77c\ucc0d \ub193\uc73c\uba74 \uc6d0\uc22d\uc774\ub294 \uc9e7\uc740 \uac70\ub9ac\uc5d0 \ub5a8\uc5b4\uc9c0\uace0, \ub108\ubb34 \ub2a6\uac8c \ub193\uc73c\uba74 \ube57\ub098\uac08 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 5\uc5d0\uc11c \ud0c0\uc774\ubc0d\uc744 \uc644\ubcbd\ud558\uac8c \ub9de\ucd94\uba74 \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uc5d0 \ucc29\ub959\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud65c\uc2dc\uc704\ub97c \ub2f9\uae30\ub294 \uac83\uacfc \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uc2ed\uc2dc\uc624. \uc801\uc808\ud55c \uc21c\uac04\uc5d0 \uc6d0\uc22d\uc774\ub97c \ub358\uc9c0\uba74 \ubaa9\ud45c\ubb3c\uc5d0 \uc815\ud655\ud558\uac8c \ub9de\ucd9c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ucd08\uae30 \ub808\ubca8\uc5d0\uc11c \uc5f0\uc2b5\ud558\uc5ec \ud0c0\uc774\ubc0d\uc744 \uac1c\uc120\ud558\uc138\uc694."}, {"question": "\uc6d0\uc22d\uc774 \ub358\uc9c0\uae30\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc704\ud574 \uc218\uc9d1\ud574\uc57c \ud558\ub294 \ud544\uc218 \ud56d\ubaa9\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc6d0\uc22d\uc774 \ub358\uc9c0\uae30\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc704\ud574 \uc810\uc218\ub97c \uc704\ud55c \ubc14\ub098\ub098\uc640 \uc0c8\ub85c\uc6b4 \ub808\ubca8\uc744 \uc5f4\uae30 \uc704\ud55c \uae08\uc0c9 \ubc14\ub098\ub098\ub97c \uc218\uc9d1\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 3\uc5d0\uc11c \uae08\uc0c9 \ubc14\ub098\ub098\ub97c \ud68d\ub4dd\ud558\uba74 \ub808\ubca8 4\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubc14\ub098\ub098\ub294 \uc5f0\ub8cc\uc640 \uac19\uc2b5\ub2c8\ub2e4. \uacc4\uc18d \ub098\uc544\uac00\ub3c4\ub85d \ub3c4\uc640\uc90d\ub2c8\ub2e4. \uc9c4\ud589 \uc0c1\ud669\uc5d0 \uc911\uc694\ud55c \uae08\uc0c9 \ubc14\ub098\ub098\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \uc218\uc9d1\ud558\uc138\uc694."}, {"question": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \uc6d0\uc22d\uc774 \ub358\uc9c0\uae30\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc704\ud574 \uc804\ub7b5\uc744 \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \uc5f0\uc18d \ucf64\ubcf4\uc640 \uc815\ud655\uc131\uc5d0 \uc9d1\uc911\ud558\uc5ec \uc804\ub7b5\uc744 \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \ud55c \ubc88\uc5d0 \uc5ec\ub7ec \uac1c\uc758 \ud45c\uc801\uc744 \uc870\uc900\ud569\ub2c8\ub2e4. STEP2: \ud658\uacbd \uac1d\uccb4(\uc608: \uc2a4\ud504\ub9c1)\ub97c \uc0ac\uc6a9\ud558\uc5ec \ucd94\uac00 \uac70\ub9ac\ub97c \ud655\ubcf4\ud569\ub2c8\ub2e4. STEP3: \ub808\ubca8\uc5d0\uc11c \ubaa8\ub4e0 \ubc14\ub098\ub098\ub97c \uc218\uc9d1\ud558\uc5ec \ubcf4\ub108\uc2a4 \uc810\uc218\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 10\uc5d0\uc11c \ud55c \ubc88\uc758 \ubc1c\uc0ac\ub85c \uc138 \uac1c\uc758 \ud45c\uc801\uc744 \ub9de\ucd94\uba74 \uc810\uc218\uac00 \ud06c\uac8c \uc99d\uac00\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub3c4\ubbf8\ub178 \ud6a8\uacfc\uc640 \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uc138\uc694. \uac01 \ub3d9\uc791\uc740 \ucd5c\ub300 \ud6a8\uacfc\ub97c \uc704\ud55c \ub2e4\uc74c \ub3d9\uc791\uc744 \uc124\uc815\ud569\ub2c8\ub2e4."}, {"question": "\uc6d0\uc22d\uc774 \ub358\uc9c0\uae30\uc5d0\uc11c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ub370 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \ud658\uacbd \uc694\uc18c\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc6d0\uc22d\uc774 \ub358\uc9c0\uae30\uc5d0\uc11c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ud658\uacbd \uc694\uc18c\ub85c\ub294 \uc2a4\ud504\ub9c1, \ud32c, \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uc774 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \uc2a4\ud504\ub9c1\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub192\uc774\ub97c \ub192\uc785\ub2c8\ub2e4. STEP2: \ud32c \uc55e\uc5d0 \uc704\uce58\ud558\uc5ec \uc18d\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4. STEP3: \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uacfc \ubc1c\uc0ac \ud0c0\uc774\ubc0d\uc744 \ub9de\ucdb0 \uc815\ud655\ud558\uac8c \ucc29\ub959\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 7\uc5d0\uc11c \uc2a4\ud504\ub9c1\uc744 \uc0ac\uc6a9\ud558\uba74 \uae08\uc0c9 \ubc14\ub098\ub098\uac00 \uc788\ub294 \ub192\uc740 \ud50c\ub7ab\ud3fc\uc5d0 \ub3c4\ub2ec\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc694\uc18c\ub97c \ub3c4\uad6c \uc0c1\uc790\uc758 \ub3c4\uad6c\ucc98\ub7fc \uc0dd\uac01\ud558\uc138\uc694. \uac01 \uc694\uc18c\ub294 \ud2b9\uc815 \ubaa9\uc801\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc6d0\uc22d\uc774 \ub358\uc9c0\uae30\uc5d0\uc11c \ubc1c\uc0ac\ud558\uae30 \uc804\uc5d0 \ub808\ubca8 \ub808\uc774\uc544\uc6c3\uc744 \uacf5\ubd80\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub808\ubca8 \ub808\uc774\uc544\uc6c3\uc744 \uacf5\ubd80\ud558\ub294 \uac83\uc740 \uc774\ub3d9 \uacc4\ud68d\uc744 \uc138\uc6b0\uace0 \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. STEP1: \ud45c\uc801\uacfc \uc7a5\uc560\ubb3c\uc758 \uc704\uce58\ub97c \uad00\ucc30\ud569\ub2c8\ub2e4. STEP2: \ucd5c\uc0c1\uc758 \ubc1c\uc0ac \uac01\ub3c4\ub97c \ud655\uc778\ud569\ub2c8\ub2e4. STEP3: \ubaa8\ub4e0 \uc544\uc774\ud15c\uc744 \uc218\uc9d1\ud558\uae30 \uc704\ud55c \uacbd\ub85c\ub97c \uacc4\ud68d\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 8\uc5d0\uc11c \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uc758 \uc704\uce58\ub97c \uc54c\uba74 \ubc1c\uc0ac \ud0c0\uc774\ubc0d\uc744 \uc644\ubcbd\ud558\uac8c \uc870\uc808\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uccb4\uc2a4 \uac8c\uc784\uacfc \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uc2ed\uc2dc\uc624. \uc804\ub7b5\uc801\uc778 \uacc4\ud68d\uc774 \uc2b9\ub9ac\ub85c \uc774\uc5b4\uc9d1\ub2c8\ub2e4."}, {"question": "\uc6d0\uc22d\uc774 \ub358\uc9c0\uae30 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc758 \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc6d0\uc22d\uc774 \ub358\uc9c0\uae30\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ubc14\ub098\ub098, \uae08\uc0c9 \ubc14\ub098\ub098 \ubc0f \ucf64\ubcf4 \uccb4\uc778\uc5d0\uc11c \uc810\uc218\ub97c \uae30\uc900\uc73c\ub85c \ud569\ub2c8\ub2e4. \ubc14\ub098\ub098\ub294 \uac01\uac01 10\uc810\uc774\uace0, \uae08\uc0c9 \ubc14\ub098\ub098\ub294 \ub808\ubca8\uc744 \ud574\uc81c\ud558\uba70, \ucf64\ubcf4\ub294 \uc810\uc218\ub97c \uacf1\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 12\uc5d0\uc11c \ubaa8\ub4e0 \ubc14\ub098\ub098\ub97c \uc218\uc9d1\ud558\uace0 \ud55c \ubc88\uc758 \ubc1c\uc0ac\ub85c \uc5ec\ub7ec \uac1c\uc758 \ud45c\uc801\uc744 \ub9de\ucd94\uba74 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc218\ud559 \ubc29\uc815\uc2dd\uacfc \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uc2ed\uc2dc\uc624. \uac01 \uc694\uc18c\ub294 \ucd1d \uc810\uc218\uc5d0 \ub354\ud574\uc9d1\ub2c8\ub2e4."}, {"question": "\uc6d0\uc22d\uc774 \ub358\uc9c0\uae30\uc5d0\uc11c \uac8c\uc784 \ub09c\uc774\ub3c4 \uc9c4\ud589\uc740 \uc5b4\ub5bb\uac8c \uade0\ud615\uc744 \uc720\uc9c0\ud569\ub2c8\uae4c?", "answer": "\uc6d0\uc22d\uc774 \ub358\uc9c0\uae30\ub294 \uc0c8\ub85c\uc6b4 \uba54\ucee4\ub2c8\uc998\uc744 \uc810\uc9c4\uc801\uc73c\ub85c \ub3c4\uc785\ud558\uace0 \ubcf5\uc7a1\uc131\uc744 \ub192\uc5ec \ub09c\uc774\ub3c4 \uc9c4\ud589\uc744 \uade0\ud615 \uc788\uac8c \uc720\uc9c0\ud569\ub2c8\ub2e4. \ucd08\uae30 \ub808\ubca8\uc740 \uae30\ubcf8 \ub358\uc9c0\uae30 \uba54\ucee4\ub2c8\uc998\uc5d0 \ucd08\uc810\uc744 \ub9de\ucd94\uace0, \ud6c4\ubc18 \ub808\ubca8\uc5d0\uc11c\ub294 \uc6c0\uc9c1\uc774\ub294 \ud45c\uc801\uacfc \uc7a5\uc560\ubb3c\uc744 \ucd94\uac00\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 15\uc5d0\uc11c\ub294 \ub354 \uc815\ud655\ud55c \ubc1c\uc0ac\uac00 \ud544\uc694\ud55c \ubc14\ub78c \uc800\ud56d\uc774 \ub3c4\uc785\ub429\ub2c8\ub2e4. \uacc4\ub2e8\uacfc \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uc2ed\uc2dc\uc624. \uac01 \ub2e8\uacc4\ub294 \uc774\uc804 \ub2e8\uacc4\ub97c \ubc14\ud0d5\uc73c\ub85c \ud558\uc5ec \ub09c\uc774\ub3c4\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4."}, {"question": "\uc6d0\uc22d\uc774 \ub358\uc9c0\uae30\uc758 \uc9c4\ud589 \uc0c1\ud669\uc774 \ub2e4\ub978 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \uc774\uc804\ub420 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub124, \ub3d9\uc77c\ud55c \uacc4\uc815\uc744 \uc0ac\uc6a9\ud558\uba74 \uc6d0\uc22d\uc774 \ub358\uc9c0\uae30\uc758 \uc9c4\ud589 \uc0c1\ud669\uc774 \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uc774\uc804\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \uc0c8 \uae30\uae30\uc5d0\uc11c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. STEP2: \ud074\ub77c\uc6b0\ub4dc\ub97c \ud1b5\ud574 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud569\ub2c8\ub2e4. STEP3: \uc911\ub2e8\ud588\ub358 \uc9c0\uc810\uc5d0\uc11c \uac8c\uc784\uc744 \uacc4\uc18d\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, iOS\uc5d0\uc11c Android\ub85c \uc804\ud658\ud558\uba74 \ub808\ubca8 \ud574\uc81c \ubc0f \ucd5c\uace0 \uc810\uc218\uac00 \uc720\uc9c0\ub429\ub2c8\ub2e4. \ubc30\ub0ad\uacfc \uac19\ub2e4 \uc0dd\uac01\ud558\uc2ed\uc2dc\uc624. \uc9c4\ud589 \uc0c1\ud669\uc740 \uc5b4\ub5a4 \uae30\uae30\uc5d0\uc11c\ub4e0 \ud56d\uc0c1 \ub2f9\uc2e0\uacfc \ud568\uaed8\ud569\ub2c8\ub2e4."}, {"question": "\uc6d0\uc22d\uc774 \ub358\uc9c0\uae30\uc5d0\uc11c \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ube44\ubc00\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc6d0\uc22d\uc774 \ub358\uc9c0\uae30\uc5d0\ub294 \ubcf4\ub108\uc2a4 \ub808\ubca8\uacfc \ud2b9\ubcc4\ud55c \uc560\ub2c8\uba54\uc774\uc158\uacfc \uac19\uc740 \uc228\uaca8\uc9c4 \ube44\ubc00\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 20\uc5d0\uc11c \ud2b9\uc815 \ub098\ubb34\uc5d0 \uc6d0\uc22d\uc774\ub97c \ubc1c\uc0ac\ud558\uba74 \uc228\uaca8\uc9c4 \ubcf4\ub108\uc2a4 \ub808\ubca8\uc774 \ub4dc\ub7ec\ub0a9\ub2c8\ub2e4. \ubcf4\ubb3c\ucc3e\uae30\uc640 \uac19\uc2b5\ub2c8\ub2e4. \ubaa8\ub4e0 \uad6c\uc11d\uad6c\uc11d\uc744 \ud0d0\ud5d8\ud558\uba74 \uae30\uc05c \ub180\ub77c\uc6c0\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ub808\ubca8\uc5d0\uc11c \ud2b9\uc774\ud55c \ubb3c\uccb4\ub098 \ud328\ud134\uc744 \uc8fc\uc758 \uae4a\uac8c \uc0b4\ud3b4\ubcf4\uc138\uc694."}]
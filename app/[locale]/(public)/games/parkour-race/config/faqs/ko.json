[{"question": "\ud30c\ud06cour \ub808\uc774\uc2a4: \ucd08\ubcf4 \ud30c\ud06cour \ub808\uc774\uc2a4 \ud50c\ub808\uc774\uc5b4\ub85c\uc11c \uae30\ubcf8 \uc810\ud504\uc640 \uc2ac\ub77c\uc774\ub4dc\ub97c \uc5b4\ub5bb\uac8c \uc218\ud589\ud558\uba70, \uc2dc\uc791\ud558\ub294 \ucd5c\uc0c1\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\ud06cour \ub808\uc774\uc2a4 \ucd08\ubcf4 \ud50c\ub808\uc774\uc5b4\ub85c\uc11c \uae30\ubcf8 \uc810\ud504\uc640 \uc2ac\ub77c\uc774\ub4dc\ub97c \uc219\ub2ec\ud558\ub294 \uac83\uc740 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. 1. \uc810\ud504: \uc77c\ubc18 \uc810\ud504\ub97c \uc704\ud574 \uc810\ud504 \ubc84\ud2bc\uc744 \ub204\ub974\uc2ed\uc2dc\uc624. 2. \uc2ac\ub77c\uc774\ub4dc: \uc7a5\uc560\ubb3c\uc5d0 \uc18d\ub3c4\ub97c \ub0b4\uc11c \uc811\uadfc\ud55c \ud6c4, \uc2ac\ub77c\uc774\ub4dc \ubc84\ud2bc\uc744 \ub20c\ub7ec \uadf8 \uc544\ub798\ub85c \uc9c0\ub098\uac11\ub2c8\ub2e4. \uc608: \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c \ub0ae\uac8c \ub9e4\ub2ec\ub9b0 \ud30c\uc774\ud504 \uc544\ub798\ub85c \uc2ac\ub77c\uc774\ub4dc \uc5f0\uc2b5\uc744 \uc2dc\uc791\ud558\uc2ed\uc2dc\uc624. \ucc98\uc74c\uc5d0\ub294 \uac04\ub2e8\ud55c \ucf54\uc2a4\ub85c \uc2dc\uc791\ud558\uc5ec \uc810\uc810 \ub354 \ud3b8\uc548\ud574\uc9c0\uba74\uc11c \ub09c\uc774\ub3c4\ub97c \ub192\uc774\uc138\uc694. \uc790\uc804\uac70 \ud0c0\ub294 \ubc95\uc744 \ubc30\uc6b0\ub294 \uac83\ucc98\ub7fc \uc0dd\uac01\ud558\uc138\uc694. \uae30\ubcf8\ubd80\ud130 \uc2dc\uc791\ud558\uba74 \uae30\uc220\uc774 \ub530\ub77c\uc635\ub2c8\ub2e4. \uad6c\uc131 \ube44\uad50\uc5d0\uc11c \uc2ac\ub77c\uc774\ub4dc \uac10\ub3c4 \uc124\uc815\uc744 \ub0ae\ucd94\uba74 \uce90\ub9ad\ud130\uc758 \uc791\uc740 \uc6c0\uc9c1\uc784\uc5d0 \ub300\ud55c \uc81c\uc5b4\uac00 \ud5a5\uc0c1\ub418\uc5b4 \uae30\ubcf8 \uc810\ud504\uac00 \ub354\uc6b1 \uc548\uc815\uc801\uc73c\ub85c \uc774\ub8e8\uc5b4\uc9d1\ub2c8\ub2e4."}, {"question": "\ud30c\ud06cour \ub808\uc774\uc2a4\uc5d0\uc11c \ud0c0\uc774\ubc0d\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \ub9e4\ubc88 \uc644\ubcbd\ud55c \uc810\ud504\ub97c \uc131\uacf5\ud558\uae30 \uc704\ud574 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\ud06cour \ub808\uc774\uc2a4\uc5d0\uc11c \ud0c0\uc774\ubc0d\uc740 \ubaa8\ub4e0 \uac83\uc758 \ud575\uc2ec\uc785\ub2c8\ub2e4. \uc644\ubcbd\ud55c \uc810\ud504\ub97c \uc704\ud574 \uc815\ubc00\uc131\uc774 \uc694\uad6c\ub429\ub2c8\ub2e4. \ub2e8\uacc4 1: \ud50c\ub7ab\ud3fc \uac04 \uac70\ub9ac\ub97c \uad00\ucc30\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ucc29\uc9c0 \uc9c0\uc810\uc744 \uc608\uce21\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ud50c\ub7ab\ud3fc \uac00\uc7a5\uc790\ub9ac\uc5d0\uc11c \uc810\ud504 \ubc84\ud2bc\uc744 \ub204\ub974\uc2ed\uc2dc\uc624. \uadf8 \uc774\uc804\uc5d0\ub294 \ub204\ub974\uc9c0 \ub9c8\uc138\uc694. \uc720\uc6a9\ud55c \ud301\uc740 \uce90\ub9ad\ud130\uc758 \ubc1c\uc774 \ub545\uc5d0 \ub2ff\ub294 \uc18c\ub9ac\uc5d0 \uadc0 \uae30\uc6b8\uc774\ub294 \uac83\uc785\ub2c8\ub2e4. \uc18c\ub9ac\ub97c \ub4e4\uc740 \uc9c1\ud6c4 \ucc30\ub098\uc758 \uc21c\uac04\uc5d0 \uc810\ud504\ud558\uc2ed\uc2dc\uc624. \ub124 \ubc88\uc9f8 \ub808\ubca8\uc774 \uc88b\uc740 \uc608\uc2dc\uc785\ub2c8\ub2e4. \uc6c0\uc9c1\uc774\ub294 \ube14\ub85d\uc5d0\uc11c \uc810\ud504\ub97c \uc5f0\uacb0\ud574\uc57c \ud569\ub2c8\ub2e4. \uc9c0\uc18d\uc801\uc778 \ud0c0\uc774\ubc0d\uc740 \uc5b4\ub824\uc6b4 \uc810\ud504\ub97c \uc77c\uc0c1\uc801\uc778 \ud30c\ud06cour\ub85c \ubc14\uafc9\ub2c8\ub2e4. \uc74c\uc545 \ub9ac\ub4ec\ucc98\ub7fc \uc0dd\uac01\ud558\uc138\uc694. \ub9ac\ub4ec\uc744 \ucc3e\uc73c\uba74 \uc6c0\uc9c1\uc784\uc774 \uc77c\uce58\ud560 \uac83\uc785\ub2c8\ub2e4."}, {"question": "\ud30c\ud06cour \ub808\uc774\uc2a4\uc5d0\uc11c \uac15\ud654 \uc544\uc774\ud15c\uc740 \ubb34\uc5c7\uc774\uba70, \ub808\uc774\uc2a4 \uc911\uc5d0 \uc2dc\uac04\uc744 \ub2e8\ucd95\ud558\uae30 \uc704\ud574 \uc5b4\ub5bb\uac8c \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud30c\ud06cour \ub808\uc774\uc2a4\uc5d0\uc11c \uac15\ud654 \uc544\uc774\ud15c\uc740 \ub808\uc774\uc2a4 \uc2dc\uac04\uc744 \ud06c\uac8c \ub2e8\ucd95\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc18d\ub3c4 \uc99d\uac00\uc81c\ubd80\ud130 \uc7a0\uc2dc \ub3d9\uc548 \ubb34\uc801\uc774 \ub418\ub294 \uc544\uc774\ud15c\uae4c\uc9c0 \ub2e4\uc591\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uae34 \uc810\ud504 \uc9c1\uc804\uc5d0 \uc18d\ub3c4 \uc99d\uac00\uc81c\ub97c \uc0ac\uc6a9\ud558\uba74 \uc810\ud504\ub97c \uc131\uacf5\uc801\uc73c\ub85c \ub118\uc744 \uc218 \uc788\uace0, \ubcbd\uc744 \ubd80\uc218\uae30 \uc704\ud574 \ubb34\uc801 \uc544\uc774\ud15c\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac01 \uac15\ud654 \uc544\uc774\ud15c\uc744 \uc0ac\uc6a9\ud574 \uc5b8\uc81c \uc0ac\uc6a9\ud574\uc57c \ud560\uc9c0 \uc2e4\ud5d8\ud574 \ubcf4\uc138\uc694. \uc720\uc6a9\ud55c \ud301\uc740 \ub2e8\ucd95 \uacbd\ub85c\ub97c \uc704\ud574 \ubb34\uc801 \uc544\uc774\ud15c\uc744 \uc544\uaef4\ub450\ub294 \uac83\uc785\ub2c8\ub2e4. \ub3c4\uad6c \uc138\ud2b8\uc640 \uac19\uc2b5\ub2c8\ub2e4. \uac01 \uc544\uc774\ud15c\uc5d0\ub294 \ud2b9\uc815 \uc2dc\uac04\uacfc \uc7a5\uc18c\uac00 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud30c\ud06cour \ub808\uc774\uc2a4\uc758 \uace0\uae09 \ud2b8\ub9ad: \ubcbd \ub2ec\ub9ac\uae30\uc640 \ubcbd \uc810\ud504\ub294 \ubb34\uc5c7\uc774\uba70, \uc2dc\uac04\uc744 \ub2e8\ucd95\ud558\uae30 \uc704\ud574 \ud6a8\uacfc\uc801\uc73c\ub85c \uc774\ub7ec\ud55c \uc6c0\uc9c1\uc784\uc744 \uc5b4\ub5bb\uac8c \uc2e4\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud30c\ud06cour \ub808\uc774\uc2a4\uc5d0\uc11c \ubcbd \ub2ec\ub9ac\uae30\uc640 \ubcbd \uc810\ud504\ub294 \uace0\uae09 \ud2b8\ub9ad\uc785\ub2c8\ub2e4. \ubcbd \ub2ec\ub9ac\uae30\ub294 \ucda9\ubd84\ud55c \uc18d\ub3c4\ub85c \ubcbd\uc5d0 \uc9c1\uc811 \uc2ac\ub77c\uc774\ub4dc\ud558\uace0 \uc810\ud504 \uc635\uc158\uc744 \uc120\ud0dd\ud558\uba74 \uc2e4\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubcbd \uc810\ud504\ub294 \ubcbd \ucabd\uc73c\ub85c \uc810\ud504\ud558\uace0 \ubcbd\uc5d0 \ub2ff\ub294 \uc989\uc2dc \uc810\ud504 \ubc84\ud2bc\uc744 \ub2e4\uc2dc \ube60\ub974\uac8c \ub20c\ub7ec \ud295\uaca8\uc838 \ub098\uac00\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608: \uc5ec\uc12f \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c \uacbd\ub85c\uc758 \uc77c\ubd80\ub97c \uac74\ub108\ub6f0\uae30 \uc704\ud574 \ubcbd \ub2ec\ub9ac\uae30\ub97c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \uc774 \uae30\uc220\uc740 \uc774\ub3d9\uc131\uc744 \uadf9\uc801\uc73c\ub85c \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4. \uac8c\uc784\uc5d0 \uc0c8\ub85c\uc6b4 \ub808\uc774\uc5b4\ub97c \ucd94\uac00\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ud301\uc73c\ub85c \uac8c\uc784 \uc124\uc815\uc5d0\uc11c \uc810\ud504 \uac10\ub3c4\ub97c \uc870\uc815\ud558\uc5ec \uc810\ud504 \uc2dc\uac04\uc744 \ub354 \uc798 \uc801\uc751\uc2dc\ud0a4\uc2ed\uc2dc\uc624."}, {"question": "\ud30c\ud06cour \ub808\uc774\uc2a4\uc5d0\uc11c \uc0ac\uc6a9 \uac00\ub2a5\ud55c \ub2e4\ub978 \uc0ac\uc6a9\uc790 \uc9c0\uc815 \uc635\uc158\uc740 \ubb34\uc5c7\uc774\uba70, \uac8c\uc784 \ud50c\ub808\uc774 \uc911\uc5d0 \uc131\ub2a5\uc774\ub098 \uc2a4\ud0c0\uc77c\uc744 \uc5b4\ub5bb\uac8c \ubc14\uafc9\ub2c8\uae4c?", "answer": "\ud30c\ud06cour \ub808\uc774\uc2a4\ub294 \ub300\ubd80\ubd84 \uc2dc\uac01\uc801\uc778 \uc0ac\uc6a9\uc790 \uc9c0\uc815 \uc635\uc158\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uce90\ub9ad\ud130 \uc758\uc0c1\uc744 \ub9de\ucda4 \uc124\uc815\ud558\uac70\ub098 \ud754\uc801 \ud6a8\uacfc\ub97c \ubcc0\uacbd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc694\uc18c\ub294 \uc9c1\uc811 \uc131\ub2a5\uc5d0 \uc601\ud5a5\uc744 \uc8fc\uc9c0\ub294 \uc54a\uc9c0\ub9cc, \uba4b\uc9c4 \uc2a4\ud0c0\uc77c\uc740 \uc790\uc2e0\uac10\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4! \uc608\ub97c \ub4e4\uc5b4, \uc0c8\ub85c\uc6b4 \uc758\uc0c1\uc744 \uc0ac\uc6a9\ud558\uba74 \ub354\uc6b1 \uc5f4\uc2ec\ud788 \uac8c\uc784\uc744 \ud558\uace0 \uc2f6\uc740 \ub9c8\uc74c\uc774 \ub4e4 \uac83\uc785\ub2c8\ub2e4. \uc870\uae45\uc744 \ud560 \ub54c \uba4b\uc9c4 \uc758\uc0c1\uc744 \uc785\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc18d\ub3c4\ub97c \ub192\uc5ec\uc8fc\uc9c0\ub294 \uc54a\uc9c0\ub9cc \uae30\ubd84\uc744 \uc88b\uac8c \ud574\uc90d\ub2c8\ub2e4. \ucd5c\uc801\ud654\ub97c \uc704\ud55c \uad6c\uc131 \ucc28\ud2b8\ub294 \ub300\ubd80\ubd84 \uac1c\uc778\uc801\uc77c \uac83\uc774\ubbc0\ub85c \uc9c1\uc811 \ud14c\uc2a4\ud2b8\ud574\uc57c \ud569\ub2c8\ub2e4."}, {"question": "\ud30c\ud06cour \ub808\uc774\uc2a4 \ub7ad\ud0b9: \uc810\uc218\ub294 \uc5b4\ub5bb\uac8c \uacc4\uc0b0\ub418\uba70, \uac8c\uc784 \ub0b4 \ucd5c\uace0\uc758 \ud50c\ub808\uc774\uc5b4\uac00 \ub418\uc5b4 \uc0c1\uc704\uad8c\uc5d0 \uc624\ub974\uae30 \uc704\ud574 \uc5b4\ub5a4 \uc804\ub7b5\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud30c\ud06cour \ub808\uc774\uc2a4 \ub7ad\ud0b9\uc740 \ub808\uc774\uc2a4 \uc2dc\uac04\uc744 \uae30\uc900\uc73c\ub85c \uc810\uc218\ub97c \uacc4\uc0b0\ud569\ub2c8\ub2e4. \ub808\uc774\uc2a4\ub97c \ub354 \ube68\ub9ac \uc644\ub8cc\ud560\uc218\ub85d \uc810\uc218\uac00 \ub192\uc544\uc9d1\ub2c8\ub2e4. \ub2e8\uacc4 1: \ub2e8\ucd95 \uacbd\ub85c\ub97c \ucc3e\uc544 \uacbd\ub85c\ub97c \ucd5c\uc801\ud654\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uace0\uae09 \ud2b8\ub9ad\uacfc \uc810\ud504\ub97c \uc219\ub2ec\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uac15\ud654 \uc544\uc774\ud15c\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc0c1\uc704\uad8c\uc5d0 \uc624\ub974\ub824\uba74 \ud5cc\uc2e0\uacfc \uc815\ud655\uc131\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608: \ub9c8\uc9c0\ub9c9 \ub808\ubca8\uc5d0\uc11c \uc18d\ub3c4 \uc99d\uac00\uc81c\ub97c \uc5b8\uc81c \uc0ac\uc6a9\ud560\uc9c0 \uc544\ub294 \uac83\uc740 \ub2e4\ub978 \uacbd\uc7c1\uc790\ubcf4\ub2e4 \uba87 \ucd08 \uc55e\uc11c\ub098\uac08 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc804\ubb38 \ub808\uc774\uc2f1\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ubaa8\ub4e0 \ucd08\uac00 \uc911\uc694\ud569\ub2c8\ub2e4. \ub610\ud55c \uac8c\uc784 \ub0b4 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc2e4\ud328\ub97c \ucd94\uc801\ud558\uace0 \ud0c0\uc774\ubc0d\uc744 \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud30c\ud06cour \ub808\uc774\uc2a4\uc5d0 \uc788\ub294 \ubcf4\uc0c1 \uc2dc\uc2a4\ud15c\uc740 \ubb34\uc5c7\uc774\uba70, \ucd94\uac00 \ubcf4\uc0c1\uc744 \uc704\ud55c \uc77c\uc77c/\uc8fc\uac04 \ucc4c\ub9b0\uc9c0\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud30c\ud06cour \ub808\uc774\uc2a4\ub294 \uacc4\uce35\ud654\ub41c \ubcf4\uc0c1 \uc2dc\uc2a4\ud15c\uc744 \uac16\ucd94\uace0 \uc788\uc73c\uba70, \ucd94\uac00 \ubcf4\uc0c1\uc774 \uc788\ub294 \uc77c\uc77c \ubc0f \uc8fc\uac04 \ucc4c\ub9b0\uc9c0\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ubcf4\uc0c1\uc5d0\ub294 \uac8c\uc784 \ub0b4 \ud1b5\ud654, \uc0ac\uc6a9\uc790 \uc9c0\uc815 \uc635\uc158 \ubc0f \uac15\ud654 \uc544\uc774\ud15c\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc77c\uc77c \ucc4c\ub9b0\uc9c0\ub294 \uc77c\ubc18\uc801\uc73c\ub85c \ud2b9\uc815 \ud69f\uc218\uc758 \ub808\uc774\uc2a4 \uc644\ub8cc\uc640 \uac19\uc740 \uc791\uc740 \ubaa9\ud45c\uc774\uace0, \uc8fc\uac04 \ucc4c\ub9b0\uc9c0\ub294 \ub354 \ud06c\uace0 \uc2dc\uac04\uc774 \ub354 \ub9ce\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ubaa8\ub4e0 \uc8fc\uac04 \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\uc5ec \ub3c5\ud2b9\ud55c \uc2a4\ud0a8\uc744 \ud68d\ub4dd\ud558\uc2ed\uc2dc\uc624. \uc798 \uad6c\uc870\ud654\ub41c \uc778\uc13c\ud2f0\ube0c \uccb4\uacc4\uc640 \uac19\uc2b5\ub2c8\ub2e4. \ubc18\ubcf5\uc801\uc778 \ud50c\ub808\uc774\uc5d0 \ub300\ud55c \ubcf4\uc0c1\uc744 \ubc1b\uac8c \ub429\ub2c8\ub2e4. \uc0c8\ub85c\uc6b4 \uc2a4\ud0a8\uc744 \uad6c\uc785\ud560 \uc218 \uc788\ub294 \ud1b5\ud654\ub97c \uc5bb\ub294 \ub610 \ub2e4\ub978 \uc720\uc6a9\ud55c \ud301\uc740 \uac8c\uc784 \ub0b4 \ubaa8\ub4e0 \uc5c5\uc801\uc744 \ub2ec\uc131\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uadf8\ub7ec\uba74 \ud1b5\ud654\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud30c\ud06cour \ub808\uc774\uc2a4\uc758 \uae30\ubcf8 \ubb3c\ub9ac \uc5d4\uc9c4\uc5d0 \ub300\ud574 \uc124\uba85\ud558\uace0, \uce90\ub9ad\ud130\uc758 \uc6c0\uc9c1\uc784\uacfc \ud658\uacbd\uacfc\uc758 \uc0c1\ud638 \uc791\uc6a9\uc5d0 \uc5b4\ub5bb\uac8c \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ud30c\ud06cour \ub808\uc774\uc2a4\ub294 \ubb3c\ub9ac \uc5d4\uc9c4\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc6c0\uc9c1\uc784\uacfc \uc0c1\ud638 \uc791\uc6a9\uc744 \uc2dc\ubbac\ub808\uc774\uc158\ud569\ub2c8\ub2e4. \uc774 \uc5d4\uc9c4\uc740 \uce90\ub9ad\ud130\uac00 \uc810\ud504, \uc2ac\ub77c\uc774\ub4dc \ubc0f \ucda9\uaca9\uc5d0 \uc5b4\ub5bb\uac8c \ubc18\uc751\ud558\ub294\uc9c0 \uacb0\uc815\ud569\ub2c8\ub2e4. \ud604\uc2e4\uc801\uc778 \uc911\ub825 \uc124\uc815\uc740 \uc810\ud504 \ub192\uc774, \uc6b4\ub3d9\ub7c9 \ubc0f \ud2b8\ub9ad \uc2e4\ud589\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc911\ub825 \uc124\uc815\uc774 \ub192\uc73c\uba74 \uc810\ud504\uac00 \ub354 \ubb34\uac81\uace0 \uac00\ubccd\uac8c \ub290\uaef4\uc838 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc5d4\uc9c4\uc740 \uac8c\uc784 \ub290\ub08c\uc758 \uae30\ubc18\uc785\ub2c8\ub2e4. \uc774 \ud2b9\uc815 \uac8c\uc784\uc758 \ubb3c\ub9ac \uc5d4\uc9c4\uc5d0 \ub300\ud55c \uac8c\uc784 \ucee8\ud2b8\ub864\ub7ec\ub97c \ucd5c\uc801\ud654\ud558\uba74 \uac8c\uc784 \uacbd\ud5d8\uc774 \ud06c\uac8c \ud5a5\uc0c1\ub429\ub2c8\ub2e4. \uc5ec\uae30 \uc774 \ud2b9\uc815 \uac8c\uc784\uc5d0 \ub300\ud55c \uac8c\uc784 \ucee8\ud2b8\ub864\ub7ec\ub97c \ucd5c\uc801\ud654\ud558\uae30 \uc704\ud55c \uad6c\uc131 \uac12 \ucc28\ud2b8\uac00 \uc788\uc2b5\ub2c8\ub2e4: 1) \uac10\ub3c4(50%); 2) \ub370\ub4dc\uc874(5%)."}, {"question": "\ud30c\ud06cour \ub808\uc774\uc2a4\ub294 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud638\ud658\uc131\uc774 \uc788\uc2b5\ub2c8\uae4c, \uadf8\ub9ac\uace0 \ub2e4\ub978 \uc6b4\uc601 \uccb4\uc81c\ub97c \uc2e4\ud589\ud558\ub294 \uae30\uae30 \uac04\uc5d0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud30c\ud06cour \ub808\uc774\uc2a4\ub294 \ud604\uc7ac \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud638\ud658\uc131 \ub610\ub294 \ub2e4\ub978 \uc6b4\uc601 \uccb4\uc81c \uac04 \uc9c4\ud589 \uc0c1\ud669 \uc804\uc1a1\uc744 \uc9c0\uc6d0\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc548\ub4dc\ub85c\uc774\ub4dc \ud734\ub300\uc804\ud654\uc5d0\uc11c \ud50c\ub808\uc774\ub97c \uc2dc\uc791\ud558\uba74 \uac19\uc740 \uc9c4\ud589 \uc0c1\ud669\uc73c\ub85c \uc544\uc774\ud3f0\uc5d0\uc11c \uacc4\uc18d\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uc774\ub294 \uc54c\ub824\uc9c4 \ud55c\uacc4\uc785\ub2c8\ub2e4. \ub9c8\uce58 \uc560\ud50c \ucda9\uc804\uae30\ub97c \uc548\ub4dc\ub85c\uc774\ub4dc \uae30\uae30\uc5d0\uc11c \uc0ac\uc6a9\ud558\ub824\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ud638\ud658\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc7a5\uce58\uc758 \uacf5\uc2dd \ud638\ud658\uc131\uc744 \ud655\uc778\ud558\uc5ec \uc6d0\ud65c\ud55c \uac8c\uc784 \uacbd\ud5d8\uc744 \ubcf4\uc7a5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud30c\ud06cour \ub808\uc774\uc2a4\uc5d0\uc11c '\uc720\ub839 \ubaa8\ub4dc'\ub294 \ubb34\uc5c7\uc774\uba70, \uc774 \uae30\ub2a5\uc744 \uc7a0\uae08 \ud574\uc81c\ud558\uc5ec \uc774\uc804 \uc2e4\ud589\uacfc \uacbd\uc7c1\ud558\uc5ec \ub808\uc774\uc2f1 \uae30\uc220\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud30c\ud06cour \ub808\uc774\uc2a4\uc758 \uc720\ub839 \ubaa8\ub4dc\ub294 \uc774\uc804 \uc2e4\ud589\uc758 \uc720\ub839 \uae30\ub85d\uacfc \uacbd\uc8fc\ud560 \uc218 \uc788\uac8c \ud574\uc90d\ub2c8\ub2e4. \ud29c\ud1a0\ub9ac\uc5bc \uc2dc\ub9ac\uc988\ub97c \uc644\ub8cc\ud558\uba74 \uc720\ub839 \ubaa8\ub4dc \uae30\ub2a5\uc774 \uc7a0\uae08 \ud574\uc81c\ub429\ub2c8\ub2e4. \ud604\uc7ac \uc2e4\ud589\uc744 \uc720\ub839\uacfc \ube44\uad50\ud558\uc5ec \uc18d\ub3c4\uac00 \ub290\ub838\ub358 \uad6c\uac04\uc744 \ud655\uc778\ud558\uace0 \uac1c\uc120\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc6b4\ub3d9\ub7c9\uc744 \uc783\uc5c8\ub358 \uc810\ud504\uc5d0 \uc720\uc758\ud558\uc2ed\uc2dc\uc624. \uacfc\uac70\uc758 \uc790\uc2e0\uacfc \uacbd\uc7c1\ud558\uba70 \ub04a\uc784\uc5c6\uc774 \ubc1c\uc804\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc720\ub839 \ubaa8\ub4dc\uc5d0 \uc811\uadfc\ud558\ub294 \ud750\ub984\ub3c4\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: 1) \uba54\uc778 \uba54\ub274 -> 2) \ucf54\uc2a4 \uc120\ud0dd -> 3) \uc720\ub839 \ubaa8\ub4dc \uc635\uc158 \ud65c\uc131\ud654."}]
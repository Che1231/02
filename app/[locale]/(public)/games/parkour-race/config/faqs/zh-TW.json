[{"question": "\u8dd1\u9177\u8cfd\uff1a\u521d\u5b78\u8005\u5982\u4f55\u5728\u8dd1\u9177\u8cfd\u4e2d\u9032\u884c\u57fa\u672c\u7684\u8df3\u8e8d\u548c\u6ed1\u52d5\uff0c\u4ee5\u53ca\u5982\u4f55\u958b\u59cb\uff1f", "answer": "\u5c0d\u65bc\u8dd1\u9177\u8cfd\u7684\u521d\u5b78\u8005\u4f86\u8aaa\uff0c\u638c\u63e1\u57fa\u672c\u7684\u8df3\u8e8d\u548c\u6ed1\u52d5\u81f3\u95dc\u91cd\u8981\u30021. \u8df3\u8e8d\uff1a\u9ede\u64ca\u8df3\u8e8d\u6309\u9215\u5373\u53ef\u9032\u884c\u6a19\u6e96\u8df3\u8e8d\u30022. \u6ed1\u52d5\uff1a\u4ee5\u901f\u5ea6\u885d\u5411\u969c\u7919\u7269\uff0c\u7136\u5f8c\u6309\u4e0b\u6ed1\u52d5\u6309\u9215\u5f9e\u4e0b\u65b9\u6ed1\u904e\u3002\u4f8b\u5982\uff1a\u5728\u7b2c\u4e00\u95dc\uff0c\u7df4\u7fd2\u5f9e\u4f4e\u5782\u7684\u7ba1\u9053\u4e0b\u65b9\u6ed1\u904e\u3002\u5f9e\u7c21\u55ae\u7684\u8def\u7dda\u958b\u59cb\uff0c\u4e26\u96a8\u8457\u8d8a\u4f86\u8d8a\u719f\u7df4\u800c\u9010\u6b65\u63d0\u9ad8\u96e3\u5ea6\u3002\u9019\u5c31\u50cf\u5b78\u7fd2\u9a0e\u81ea\u884c\u8eca\u4e00\u6a23\uff0c\u5148\u5f9e\u57fa\u790e\u958b\u59cb\uff0c\u6280\u80fd\u81ea\u7136\u800c\u4f86\u3002\u4f5c\u70ba\u914d\u7f6e\u6bd4\u8f03\uff0c\u6ed1\u52d5\u7684\u4f4e\u9748\u654f\u5ea6\u8a2d\u7f6e\u5c07\u6709\u52a9\u65bc\u60a8\u66f4\u597d\u5730\u63a7\u5236\u89d2\u8272\u7684\u5fae\u5c0f\u52d5\u4f5c\uff0c\u4e26\u4f7f\u57fa\u672c\u8df3\u8e8d\u66f4\u7a69\u5b9a\u3002"}, {"question": "\u5728\u8dd1\u9177\u8cfd\u4e2d\uff0c\u6642\u9593\u70ba\u4f55\u5982\u6b64\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u624d\u80fd\u6bcf\u6b21\u90fd\u5b8c\u6210\u5b8c\u7f8e\u7684\u8df3\u8e8d\uff1f", "answer": "\u5728\u8dd1\u9177\u8cfd\u4e2d\uff0c\u6642\u9593\u81f3\u95dc\u91cd\u8981\u3002\u8981\u5b8c\u7f8e\u5b8c\u6210\u8df3\u8e8d\uff0c\u5c31\u9700\u8981\u6e96\u78ba\u6027\u3002\u6b65\u9a5f 1\uff1a\u89c0\u5bdf\u5e73\u53f0\u4e4b\u9593\u7684\u8ddd\u96e2\u3002\u6b65\u9a5f 2\uff1a\u9810\u6e2c\u8457\u9678\u9ede\u3002\u6b65\u9a5f 3\uff1a\u5728\u5e73\u53f0\u908a\u7de3\u6309\u8df3\u8e8d\u9375\uff0c\u800c\u4e0d\u662f\u5728\u4e4b\u524d\u3002\u4e00\u500b\u6709\u7528\u7684\u6280\u5de7\u662f\u807d\u53d6\u89d2\u8272\u8173\u6b65\u89f8\u5730\u6642\u7684\u97f3\u6548\u63d0\u793a\uff0c\u5728\u807d\u5230\u97f3\u6548\u5f8c\u7acb\u5373\u8df3\u8e8d\u3002\u4e00\u500b\u5f88\u597d\u7684\u5b78\u7fd2\u7bc4\u4f8b\u662f\u7b2c\u56db\u95dc\uff0c\u60a8\u9700\u8981\u5728\u79fb\u52d5\u7684\u65b9\u584a\u4e0a\u9023\u7e8c\u8df3\u8e8d\u3002\u4e00\u81f4\u7684\u6642\u6a5f\u5c07\u68d8\u624b\u7684\u8df3\u8e8d\u8b8a\u6210\u4f8b\u884c\u8dd1\u9177\u3002\u9019\u5c31\u50cf\u97f3\u6a02\u7bc0\u594f\uff0c\u627e\u5230\u7bc0\u62cd\uff0c\u52d5\u4f5c\u5c31\u6703\u5354\u8abf\u3002"}, {"question": "\u8dd1\u9177\u8cfd\u4e2d\u7684\u52a0\u6210\u9053\u5177\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5982\u4f55\u5728\u6bd4\u8cfd\u4e2d\u4f7f\u7528\u5b83\u5011\u4f86\u7e2e\u77ed\u6642\u9593\uff1f", "answer": "\u8dd1\u9177\u8cfd\u4e2d\u7684\u52a0\u6210\u9053\u5177\u53ef\u4ee5\u986f\u8457\u7e2e\u77ed\u60a8\u7684\u6bd4\u8cfd\u6642\u9593\u3002\u5b83\u5011\u53ef\u4ee5\u5f9e\u52a0\u901f\u5230\u77ed\u66ab\u7684\u7121\u6575\u3002\u4f8b\u5982\uff0c\u5728\u9577\u8df3\u4e4b\u524d\u4f7f\u7528\u52a0\u901f\u53ef\u4ee5\u5e6b\u52a9\u60a8\u8df3\u904e\u5b83\uff0c\u6216\u8005\u4f7f\u7528\u7121\u6575\u4f86\u885d\u7834\u7246\u58c1\u3002\u5617\u8a66\u4f7f\u7528\u6bcf\u500b\u52a0\u6210\u9053\u5177\uff0c\u4ee5\u4fbf\u77e5\u9053\u4f55\u6642\u4f7f\u7528\u5b83\u5011\u3002\u4e00\u500b\u6709\u7528\u7684\u6280\u5de7\u662f\u5c07\u7121\u6575\u52a0\u6210\u9053\u5177\u7559\u7d66\u6377\u5f91\u3002\u9019\u5c31\u50cf\u5de5\u5177\u5e36\u4e00\u6a23\uff0c\u6bcf\u500b\u7269\u54c1\u90fd\u6709\u5176\u6642\u9593\u548c\u5730\u9ede\u3002"}, {"question": "\u8dd1\u9177\u8cfd\u4e2d\u7684\u9ad8\u7d1a\u6280\u5de7\uff1a\u4ec0\u9ebc\u662f\u58c1\u8dd1\u548c\u58c1\u8df3\uff0c\u4ee5\u53ca\u5982\u4f55\u6709\u6548\u57f7\u884c\u9019\u4e9b\u52d5\u4f5c\u4ee5\u7bc0\u7701\u6642\u9593\uff1f", "answer": "\u58c1\u8dd1\u548c\u58c1\u8df3\u662f\u8dd1\u9177\u8cfd\u7684\u9ad8\u7d1a\u6280\u5de7\u3002\u7576\u60a8\u4ee5\u8db3\u5920\u7684\u901f\u5ea6\u6ed1\u5411\u7246\u58c1\u6642\uff0c\u5373\u53ef\u57f7\u884c\u58c1\u8dd1\uff0c\u7136\u5f8c\u9078\u64c7\u8df3\u8e8d\u9078\u9805\u3002\u58c1\u8df3\u9700\u8981\u60a8\u5411\u7246\u58c1\u8df3\u8e8d\uff0c\u4e26\u5728\u63a5\u89f8\u5230\u7246\u58c1\u6642\u5feb\u901f\u518d\u6b21\u9ede\u64ca\u8df3\u8e8d\u6309\u9215\u4ee5\u5f48\u8d77\u3002\u4f8b\u5982\uff1a\u5728\u7b2c\u516d\u95dc\u4e0a\u9032\u884c\u58c1\u8dd1\u8df3\u904e\u4e00\u90e8\u5206\u8def\u7dda\u3002\u6b64\u6280\u80fd\u986f\u8457\u589e\u5f37\u4e86\u79fb\u52d5\u6027\u3002\u53ef\u4ee5\u5c07\u5176\u8996\u70ba\u70ba\u60a8\u7684\u904a\u6232\u6dfb\u52a0\u65b0\u5c64\u6b21\u3002\u4f5c\u70ba\u63d0\u793a\uff0c\u5728\u8a2d\u7f6e\u4e2d\u5617\u8a66\u8abf\u6574\u8df3\u8e8d\u9748\u654f\u5ea6\uff0c\u4ee5\u66f4\u597d\u5730\u9069\u61c9\u8df3\u8e8d\u6642\u9593\u3002"}, {"question": "\u8dd1\u9177\u8cfd\u4e2d\u6709\u54ea\u4e9b\u4e0d\u540c\u7684\u81ea\u8a02\u9078\u9805\uff0c\u4ee5\u53ca\u5b83\u5011\u5982\u4f55\u5728\u904a\u6232\u904e\u7a0b\u4e2d\u5f71\u97ff\u6211\u7684\u8868\u73fe\u6216\u98a8\u683c\uff1f", "answer": "\u8dd1\u9177\u8cfd\u63d0\u4f9b\u8a31\u591a\u81ea\u8a02\u9078\u9805\uff0c\u5927\u591a\u6578\u662f\u8996\u89ba\u7684\u3002\u81ea\u8a02\u60a8\u7684\u89d2\u8272\u670d\u88dd\uff0c\u6216\u66f4\u6539\u8ecc\u8de1\u6548\u679c\u3002\u96d6\u7136\u9019\u4e9b\u4e26\u4e0d\u6703\u76f4\u63a5\u5f71\u97ff\u60a8\u7684\u8868\u73fe\uff0c\u4f46\u9177\u70ab\u7684\u98a8\u683c\u53ef\u4ee5\u63d0\u5347\u60a8\u7684\u4fe1\u5fc3\uff01\u4f8b\u5982\uff0c\u4f7f\u7528\u65b0\u7684\u670d\u88dd\u53ef\u4ee5\u8b93\u60a8\u66f4\u6709\u52d5\u529b\u73a9\u904a\u6232\u3002\u9019\u5c31\u50cf\u9078\u64c7\u4e00\u4ef6\u9177\u70ab\u7684\u670d\u88dd\u53bb\u6162\u8dd1\uff0c\u5b83\u4e0d\u6703\u8b93\u60a8\u8dd1\u5f97\u66f4\u5feb\uff0c\u4f46\u6703\u8b93\u60a8\u611f\u89ba\u66f4\u597d\u3002\u91dd\u5c0d\u512a\u5316\u7684\u914d\u7f6e\u5716\u8868\u5c07\u5927\u591a\u6578\u662f\u500b\u4eba\u5316\u7684\uff0c\u56e0\u6b64\u60a8\u9700\u8981\u81ea\u884c\u6e2c\u8a66\u3002"}, {"question": "\u8dd1\u9177\u8cfd\u6392\u884c\u699c\uff1a\u5982\u4f55\u8a08\u7b97\u5206\u6578\uff0c\u4ee5\u53ca\u53ef\u4ee5\u4f7f\u7528\u54ea\u4e9b\u7b56\u7565\u4f86\u63d0\u5347\u6392\u540d\u4e26\u6210\u70ba\u904a\u6232\u4e2d\u7684\u9802\u5c16\u73a9\u5bb6\uff1f", "answer": "\u8dd1\u9177\u8cfd\u6392\u884c\u699c\u57fa\u65bc\u6bd4\u8cfd\u6642\u9593\u8a08\u7b97\u5206\u6578\u3002\u60a8\u5b8c\u6210\u5f97\u8d8a\u5feb\uff0c\u5206\u6578\u8d8a\u9ad8\u3002\u6b65\u9a5f 1\uff1a\u901a\u904e\u8b58\u5225\u6377\u5f91\u4f86\u512a\u5316\u8def\u7dda\u3002\u6b65\u9a5f 2\uff1a\u638c\u63e1\u9ad8\u7d1a\u6280\u5de7\u548c\u8df3\u8e8d\u3002\u6b65\u9a5f 3\uff1a\u7b56\u7565\u6027\u5730\u4f7f\u7528\u52a0\u6210\u9053\u5177\u3002\u8981\u767b\u4e0a\u6392\u884c\u699c\uff0c\u9700\u8981\u6295\u5165\u548c\u7cbe\u78ba\u6027\u3002\u4f8b\u5982\uff1a\u77e5\u9053\u4f55\u6642\u5728\u6700\u5f8c\u4e00\u95dc\u4f7f\u7528\u52a0\u901f\uff0c\u53ef\u4ee5\u8b93\u60a8\u6bd4\u5176\u4ed6\u7af6\u722d\u5c0d\u624b\u9818\u5148\u5e7e\u79d2\u9418\u3002\u53ef\u4ee5\u5c07\u5176\u8996\u70ba\u5c08\u696d\u8cfd\u8eca\uff0c\u6bcf\u4e00\u79d2\u90fd\u81f3\u95dc\u91cd\u8981\u3002\u60a8\u4e5f\u53ef\u4ee5\u4f7f\u7528\u904a\u6232\u4e2d\u7684\u529f\u80fd\u9304\u88fd\u81ea\u5df1\uff0c\u4ee5\u8ddf\u8e64\u5931\u6557\u4e26\u512a\u5316\u6642\u9593\u3002"}, {"question": "\u8dd1\u9177\u8cfd\u4e2d\u6709\u54ea\u4e9b\u734e\u52f5\u7cfb\u7d71\uff0c\u4ee5\u53ca\u662f\u5426\u6709\u6bcf\u65e5/\u6bcf\u5468\u6311\u6230\u4ee5\u7372\u5f97\u984d\u5916\u734e\u52f5\uff1f", "answer": "\u8dd1\u9177\u8cfd\u5177\u6709\u5206\u5c64\u7684\u734e\u52f5\u7cfb\u7d71\uff0c\u5305\u62ec\u5e36\u6709\u984d\u5916\u734e\u52f5\u7684\u6bcf\u65e5\u548c\u6bcf\u5468\u6311\u6230\u3002\u734e\u52f5\u5305\u62ec\u904a\u6232\u5167\u8ca8\u5e63\u3001\u81ea\u8a02\u9078\u9805\u548c\u52a0\u6210\u9053\u5177\u3002\u6bcf\u65e5\u6311\u6230\u901a\u5e38\u662f\u8f03\u5c0f\u7684\u76ee\u6a19\uff0c\u4f8b\u5982\u5b8c\u6210\u4e00\u5b9a\u6578\u91cf\u7684\u6bd4\u8cfd\uff0c\u800c\u6bcf\u5468\u6311\u6230\u5247\u66f4\u5927\uff0c\u9700\u8981\u66f4\u591a\u6642\u9593\u3002\u5b8c\u6210\u6240\u6709\u6bcf\u5468\u6311\u6230\u4ee5\u8d0f\u5f97\u7368\u7279\u7684\u76ae\u819a\u3002\u9019\u5c31\u50cf\u4e00\u500b\u7d50\u69cb\u826f\u597d\u7684\u6fc0\u52f5\u8a08\u5283\uff0c\u60a8\u6703\u56e0\u91cd\u8907\u904a\u6232\u800c\u7372\u5f97\u734e\u52f5\u3002\u53e6\u4e00\u500b\u7372\u5f97\u8cfc\u8cb7\u65b0\u76ae\u819a\u6240\u9700\u8ca8\u5e63\u7684\u6709\u7528\u63d0\u793a\u662f\u8d0f\u5f97\u904a\u6232\u4e2d\u7684\u6240\u6709\u6210\u5c31\uff0c\u56e0\u70ba\u5b83\u5011\u5c07\u6703\u7d66\u4e88\u734e\u52f5\u3002"}, {"question": "\u4f60\u80fd\u89e3\u91cb\u8dd1\u9177\u8cfd\u7684\u5e95\u5c64\u7269\u7406\u5f15\u64ce\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u97ff\u89d2\u8272\u7684\u52d5\u4f5c\u548c\u8207\u74b0\u5883\u7684\u4e92\u52d5\uff1f", "answer": "\u8dd1\u9177\u8cfd\u4f7f\u7528\u7269\u7406\u5f15\u64ce\u4f86\u6a21\u64ec\u52d5\u4f5c\u548c\u4e92\u52d5\u3002\u6b64\u5f15\u64ce\u6c7a\u5b9a\u4e86\u60a8\u7684\u89d2\u8272\u5982\u4f55\u97ff\u61c9\u8df3\u8e8d\u3001\u6ed1\u52d5\u548c\u885d\u64ca\u3002\u73fe\u5be6\u7684\u91cd\u529b\u8a2d\u7f6e\u5f71\u97ff\u4e86\u8df3\u8e8d\u9ad8\u5ea6\u3001\u52d5\u91cf\u548c\u6280\u5de7\u7684\u57f7\u884c\u3002\u4f8b\u5982\uff0c\u8f03\u9ad8\u7684\u91cd\u529b\u8a2d\u7f6e\u53ef\u4ee5\u4f7f\u8df3\u8e8d\u611f\u89ba\u66f4\u91cd\uff0c\u4e14\u6d6e\u52d5\u6027\u66f4\u4f4e\uff0c\u9700\u8981\u7cbe\u78ba\u7684\u6642\u6a5f\u3002\u5f15\u64ce\u662f\u904a\u6232\u611f\u89ba\u7684\u6838\u5fc3\u3002\u512a\u5316\u60a8\u7684\u904a\u6232\u63a7\u5236\u5668\u4ee5\u9069\u5408\u6b64\u7269\u7406\u5f15\u64ce\u5c07\u6703\u986f\u8457\u6539\u5584\u60a8\u7684\u904a\u6232\u9ad4\u9a57\u3002\u4ee5\u4e0b\u662f\u5982\u4f55\u91dd\u5c0d\u6b64\u7279\u5b9a\u904a\u6232\u512a\u5316\u60a8\u7684\u904a\u6232\u63a7\u5236\u5668\u7684\u914d\u7f6e\u503c\uff1a1) \u9748\u654f\u5ea6 (50%)\uff1b2) \u6b7b\u5340 (5%)\u3002"}, {"question": "\u8dd1\u9177\u8cfd\u662f\u5426\u652f\u63f4\u8de8\u5e73\u53f0\u76f8\u5bb9\uff0c\u6211\u53ef\u4ee5\u5c07\u6211\u5728\u4e0d\u540c\u4f5c\u696d\u7cfb\u7d71\u7684\u88dd\u7f6e\u4e0a\u7684\u9032\u5ea6\u8f49\u79fb\u55ce\uff1f", "answer": "\u8dd1\u9177\u8cfd\u76ee\u524d\u4e0d\u652f\u6301\u8de8\u5e73\u53f0\u76f8\u5bb9\u6216\u5728\u4e0d\u540c\u4f5c\u696d\u7cfb\u7d71\u4e4b\u9593\u8f49\u79fb\u9032\u5ea6\u3002\u5982\u679c\u60a8\u958b\u59cb\u5728 Android \u624b\u6a5f\u4e0a\u73a9\u904a\u6232\uff0c\u5247\u7121\u6cd5\u5728 iPhone \u4e0a\u7e7c\u7e8c\u9032\u884c\u76f8\u540c\u7684\u9032\u5ea6\u3002\u9019\u662f\u5df2\u77e5\u9650\u5236\u3002\u9019\u5c31\u50cf\u5617\u8a66\u4f7f\u7528 Apple \u5145\u96fb\u5668\u70ba Android \u88dd\u7f6e\u5145\u96fb\u4e00\u6a23\u2014\u2014\u5b83\u5011\u6839\u672c\u4e0d\u76f8\u5bb9\u3002\u60a8\u53ef\u4ee5\u6aa2\u67e5\u5b98\u65b9\u76f8\u5bb9\u6027\uff0c\u4ee5\u78ba\u4fdd\u826f\u597d\u7684\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u8dd1\u9177\u8cfd\u4e2d\u7684\u300c\u5e7d\u9748\u6a21\u5f0f\u300d\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9396\u6b64\u529f\u80fd\u4ee5\u901a\u904e\u8207\u4e4b\u524d\u6bd4\u8cfd\u7684\u6bd4\u8f03\u4f86\u63d0\u5347\u6211\u7684\u8cfd\u8dd1\u6280\u80fd\uff1f", "answer": "\u8dd1\u9177\u8cfd\u4e2d\u7684\u5e7d\u9748\u6a21\u5f0f\u5141\u8a31\u60a8\u8207\u60a8\u4e4b\u524d\u6bd4\u8cfd\u7684\u5e7d\u9748\u9304\u5f71\u9032\u884c\u8cfd\u8dd1\u3002\u5b8c\u6210\u6559\u5b78\u7cfb\u5217\u5f8c\u5c07\u89e3\u9396\u5e7d\u9748\u6a21\u5f0f\u529f\u80fd\u3002\u901a\u904e\u5c07\u60a8\u76ee\u524d\u7684\u6bd4\u8cfd\u8207\u60a8\u7684\u5e7d\u9748\u9032\u884c\u6bd4\u8f03\uff0c\u627e\u51fa\u60a8\u901f\u5ea6\u8f03\u6162\u7684\u90e8\u5206\u4e26\u52a0\u4ee5\u6539\u5584\u3002\u4f8b\u5982\uff0c\u8981\u6ce8\u610f\u5728\u5931\u53bb\u52d5\u91cf\u7684\u8df3\u8e8d\u3002\u9019\u5c31\u50cf\u8207\u904e\u53bb\u7684\u81ea\u6211\u7af6\u722d\uff0c\u4e0d\u65b7\u9032\u6b65\u3002\u5b58\u53d6\u5e7d\u9748\u6a21\u5f0f\u7684\u6d41\u7a0b\u5716\u5982\u4e0b\uff1a1) \u4e3b\u9078\u55ae -> 2) \u9078\u64c7\u8ab2\u7a0b -> 3) \u555f\u7528\u5e7d\u9748\u6a21\u5f0f\u9078\u9805\u3002"}]
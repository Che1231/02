[{"question": "\u8dd1\u9177\u7ade\u901f\uff1a\u65b0\u624b\u5982\u4f55\u8fdb\u884c\u57fa\u672c\u7684\u8df3\u8dc3\u548c\u6ed1\u884c\uff0c\u4ee5\u53ca\u5f00\u59cb\u7684\u6700\u4f73\u65b9\u6cd5\u662f\u4ec0\u4e48\uff1f", "answer": "\u5bf9\u4e8e\u8dd1\u9177\u7ade\u901f\u7684\u65b0\u624b\u6765\u8bf4\uff0c\u638c\u63e1\u57fa\u672c\u7684\u8df3\u8dc3\u548c\u6ed1\u884c\u81f3\u5173\u91cd\u8981\u30021. \u8df3\u8dc3\uff1a\u70b9\u51fb\u8df3\u8dc3\u6309\u94ae\u5373\u53ef\u8fdb\u884c\u6807\u51c6\u8df3\u8dc3\u30022. \u6ed1\u884c\uff1a\u4ee5\u4e00\u5b9a\u901f\u5ea6\u9760\u8fd1\u969c\u788d\u7269\uff0c\u7136\u540e\u6309\u4e0b\u6ed1\u884c\u6309\u94ae\u4fbf\u53ef\u4ee5\u6ed1\u884c\u7a7f\u8fc7\u969c\u788d\u7269\u3002\u4f8b\u5982\uff1a\u5728\u7b2c\u4e00\u5173\uff0c\u7ec3\u4e60\u6ed1\u884c\u7a7f\u8fc7\u4f4e\u5782\u7684\u7ba1\u9053\u3002\u4ece\u7b80\u5355\u7684\u8d5b\u9053\u5f00\u59cb\uff0c\u968f\u7740\u4f60\u8d8a\u6765\u8d8a\u719f\u7ec3\uff0c\u9010\u6e10\u589e\u52a0\u96be\u5ea6\u3002\u8fd9\u5c31\u50cf\u5b66\u4e60\u9a91\u81ea\u884c\u8f66\u4e00\u6837\uff0c\u5148\u638c\u63e1\u57fa\u672c\u6280\u5de7\uff0c\u7136\u540e\u6280\u80fd\u81ea\u7136\u4f1a\u63d0\u5347\u3002\u4f5c\u4e3a\u914d\u7f6e\u5bf9\u6bd4\uff0c\u5c06\u6ed1\u52a8\u7075\u654f\u5ea6\u8c03\u4f4e\u53ef\u4ee5\u66f4\u597d\u5730\u63a7\u5236\u89d2\u8272\u7684\u5c0f\u5e45\u5ea6\u79fb\u52a8\uff0c\u4f7f\u57fa\u672c\u8df3\u8dc3\u66f4\u52a0\u7a33\u5b9a\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u8dd1\u9177\u7ade\u901f\u4e2d\u65f6\u95f4\u63a7\u5236\u81f3\u5173\u91cd\u8981\uff0c\u4ee5\u53ca\u6211\u5982\u4f55\u624d\u80fd\u6bcf\u6b21\u90fd\u5b8c\u6210\u5b8c\u7f8e\u7684\u8df3\u8dc3\uff1f", "answer": "\u5728\u8dd1\u9177\u7ade\u901f\u4e2d\uff0c\u65f6\u95f4\u63a7\u5236\u81f3\u5173\u91cd\u8981\u3002\u5b8c\u7f8e\u8df3\u8dc3\u7684\u5173\u952e\u5728\u4e8e\u7cbe\u51c6\u3002\u6b65\u9aa4 1\uff1a\u89c2\u5bdf\u5e73\u53f0\u4e4b\u95f4\u7684\u8ddd\u79bb\u3002\u6b65\u9aa4 2\uff1a\u9884\u6d4b\u4f60\u7684\u7740\u9646\u70b9\u3002\u6b65\u9aa4 3\uff1a\u5728\u5e73\u53f0\u8fb9\u7f18\uff0c\u800c\u975e\u63d0\u524d\uff0c\u6309\u4e0b\u8df3\u8dc3\u6309\u94ae\u3002\u4e00\u4e2a\u6709\u7528\u7684\u6280\u5de7\u662f\u503e\u542c\u89d2\u8272\u53cc\u811a\u843d\u5730\u7684\u58f0\u97f3\u63d0\u793a\uff0c\u5728\u4f60\u542c\u5230\u58f0\u97f3\u540e\uff0c\u518d\u5ef6\u8fdf\u4e00\u5c0f\u4f1a\u513f\u8df3\u8dc3\u3002\u4e00\u4e2a\u5f88\u597d\u7684\u5b66\u4e60\u4f8b\u5b50\u662f\u7b2c\u56db\u5173\uff0c\u4f60\u9700\u8981\u5728\u79fb\u52a8\u7684\u65b9\u5757\u4e0a\u8fde\u7eed\u8df3\u8dc3\u3002\u6301\u7eed\u7cbe\u786e\u7684\u65f6\u95f4\u63a7\u5236\uff0c\u53ef\u4ee5\u5c06\u68d8\u624b\u7684\u8df3\u8dc3\u8f6c\u53d8\u4e3a\u5e38\u89c4\u8dd1\u9177\u52a8\u4f5c\u3002\u8fd9\u5c31\u50cf\u97f3\u4e50\u8282\u594f\uff0c\u627e\u5230\u8282\u594f\uff0c\u52a8\u4f5c\u81ea\u7136\u5c31\u4f1a\u534f\u8c03\u4e00\u81f4\u3002"}, {"question": "\u8dd1\u9177\u7ade\u901f\u4e2d\u7684\u589e\u5f3a\u9053\u5177\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5982\u4f55\u5728\u6bd4\u8d5b\u4e2d\u4f7f\u7528\u5b83\u4eec\u6765\u7f29\u77ed\u65f6\u95f4\uff1f", "answer": "\u8dd1\u9177\u7ade\u901f\u4e2d\u7684\u589e\u5f3a\u9053\u5177\u53ef\u4ee5\u663e\u8457\u7f29\u77ed\u4f60\u7684\u6bd4\u8d5b\u65f6\u95f4\u3002\u5b83\u4eec\u53ef\u4ee5\u5305\u62ec\u901f\u5ea6\u63d0\u5347\u6216\u77ed\u6682\u65e0\u654c\u3002\u4f8b\u5982\uff0c\u5728\u957f\u8df3\u4e4b\u524d\u4f7f\u7528\u901f\u5ea6\u63d0\u5347\u53ef\u4ee5\u5e2e\u52a9\u4f60\u8de8\u8d8a\u969c\u788d\uff0c\u6216\u4f7f\u7528\u65e0\u654c\u6765\u7a81\u7834\u5899\u58c1\u3002\u5c1d\u8bd5\u6bcf\u4e2a\u589e\u5f3a\u9053\u5177\uff0c\u4ee5\u4fbf\u77e5\u9053\u4f55\u65f6\u4f7f\u7528\u5b83\u4eec\u3002\u4e00\u4e2a\u6709\u7528\u7684\u6280\u5de7\u662f\u5c06\u65e0\u654c\u589e\u5f3a\u9053\u5177\u7559\u4f5c\u6377\u5f84\u4f7f\u7528\u3002\u8fd9\u5c31\u50cf\u5de5\u5177\u7bb1\uff0c\u6bcf\u4e2a\u5de5\u5177\u90fd\u6709\u5176\u4f7f\u7528\u65f6\u673a\u3002"}, {"question": "\u8dd1\u9177\u7ade\u901f\u4e2d\u7684\u9ad8\u7ea7\u6280\u5de7\uff1a\u4ec0\u4e48\u662f\u5899\u58c1\u8dd1\u52a8\u548c\u5899\u58c1\u8df3\u8dc3\uff0c\u4ee5\u53ca\u6211\u5982\u4f55\u6709\u6548\u5730\u6267\u884c\u8fd9\u4e9b\u52a8\u4f5c\u4ee5\u7f29\u77ed\u65f6\u95f4\uff1f", "answer": "\u5899\u58c1\u8dd1\u52a8\u548c\u5899\u58c1\u8df3\u8dc3\u662f\u8dd1\u9177\u7ade\u901f\u4e2d\u7684\u9ad8\u7ea7\u6280\u5de7\u3002\u5899\u58c1\u8dd1\u52a8\u53ef\u4ee5\u901a\u8fc7\u4ee5\u8db3\u591f\u7684\u901f\u5ea6\u76f4\u63a5\u6ed1\u5411\u5899\u58c1\uff0c\u7136\u540e\u9009\u62e9\u8df3\u8dc3\u9009\u9879\u6765\u6267\u884c\u3002\u5899\u58c1\u8df3\u8dc3\u9700\u8981\u4f60\u8df3\u5411\u5899\u58c1\uff0c\u5e76\u4e0e\u5899\u58c1\u63a5\u89e6\u540e\u8fc5\u901f\u518d\u6b21\u70b9\u51fb\u8df3\u8dc3\u6309\u94ae\u6765\u5f39\u8df3\u3002\u4f8b\u5982\uff1a\u5728\u7b2c\u516d\u5173\u8fdb\u884c\u5899\u58c1\u8dd1\u52a8\u4ee5\u8df3\u8fc7\u8d5b\u9053\u7684\u4e00\u90e8\u5206\u3002\u8fd9\u9879\u6280\u80fd\u6781\u5927\u5730\u589e\u5f3a\u4e86\u673a\u52a8\u6027\u3002\u53ef\u4ee5\u628a\u5b83\u770b\u4f5c\u662f\u4e3a\u4f60\u7684\u6e38\u620f\u589e\u52a0\u4e86\u4e00\u5c42\u3002\u4f5c\u4e3a\u63d0\u793a\uff0c\u5728\u8bbe\u7f6e\u4e2d\u5c1d\u8bd5\u8c03\u6574\u8df3\u8dc3\u7075\u654f\u5ea6\u4ee5\u66f4\u597d\u5730\u9002\u5e94\u8df3\u8dc3\u65f6\u95f4\u3002"}, {"question": "\u8dd1\u9177\u7ade\u901f\u4e2d\u6709\u54ea\u4e9b\u4e0d\u540c\u7684\u5b9a\u5236\u9009\u9879\uff0c\u4ee5\u53ca\u5b83\u4eec\u5982\u4f55\u5728\u6e38\u620f\u73a9\u6cd5\u4e2d\u5f71\u54cd\u4f60\u7684\u8868\u73b0\u6216\u98ce\u683c\uff1f", "answer": "\u8dd1\u9177\u7ade\u901f\u63d0\u4f9b\u8bb8\u591a\u5b9a\u5236\u9009\u9879\uff0c\u4e3b\u8981\u89c6\u89c9\u65b9\u9762\u3002\u5b9a\u5236\u4f60\u7684\u89d2\u8272\u670d\u88c5\uff0c\u6216\u6539\u53d8\u8f68\u8ff9\u6548\u679c\u3002\u867d\u7136\u8fd9\u4e9b\u4e0d\u4f1a\u76f4\u63a5\u5f71\u54cd\u4f60\u7684\u8868\u73b0\uff0c\u4f46\u9177\u70ab\u7684\u98ce\u683c\u53ef\u4ee5\u63d0\u5347\u4f60\u7684\u4fe1\u5fc3\uff01\u4f8b\u5982\uff0c\u7a7f\u4e0a\u65b0\u8863\u670d\u4f1a\u8ba9\u4f60\u66f4\u6709\u52a8\u529b\u53bb\u73a9\u3002\u8fd9\u5c31\u50cf\u9009\u62e9\u4e00\u4ef6\u9177\u70ab\u7684\u8863\u670d\u53bb\u6162\u8dd1\uff0c\u5b83\u4e0d\u4f1a\u8ba9\u4f60\u8dd1\u5f97\u66f4\u5feb\uff0c\u4f46\u4f1a\u8ba9\u4f60\u611f\u89c9\u66f4\u597d\u3002\u5173\u4e8e\u4f18\u5316\u7684\u914d\u7f6e\u56fe\u8868\u5c06\u4e3b\u8981\u4ee5\u4e2a\u4eba\u9700\u6c42\u4e3a\u4e3b\uff0c\u6240\u4ee5\u4f60\u9700\u8981\u81ea\u5df1\u6d4b\u8bd5\u3002"}, {"question": "\u8dd1\u9177\u7ade\u901f\u6392\u884c\u699c\uff1a\u5206\u6570\u662f\u5982\u4f55\u8ba1\u7b97\u7684\uff0c\u4ee5\u53ca\u6211\u53ef\u4ee5\u7528\u4ec0\u4e48\u7b56\u7565\u6765\u767b\u4e0a\u699c\u9996\u5e76\u6210\u4e3a\u6e38\u620f\u4e2d\u6700\u597d\u7684\u73a9\u5bb6\uff1f", "answer": "\u8dd1\u9177\u7ade\u901f\u6392\u884c\u699c\u6839\u636e\u6bd4\u8d5b\u65f6\u95f4\u8ba1\u7b97\u5206\u6570\u3002\u4f60\u5b8c\u6210\u5f97\u8d8a\u5feb\uff0c\u5206\u6570\u5c31\u8d8a\u9ad8\u3002\u6b65\u9aa4 1\uff1a\u901a\u8fc7\u8bc6\u522b\u6377\u5f84\u6765\u4f18\u5316\u4f60\u7684\u8def\u7ebf\u3002\u6b65\u9aa4 2\uff1a\u638c\u63e1\u9ad8\u7ea7\u6280\u5de7\u548c\u8df3\u8dc3\u3002\u6b65\u9aa4 3\uff1a\u7b56\u7565\u6027\u5730\u4f7f\u7528\u589e\u5f3a\u9053\u5177\u3002\u767b\u4e0a\u6392\u884c\u699c\u9700\u8981\u6295\u5165\u548c\u7cbe\u786e\u3002\u4f8b\u5982\uff1a\u77e5\u9053\u4f55\u65f6\u5728\u6700\u540e\u4e00\u5173\u4f7f\u7528\u4f60\u7684\u901f\u5ea6\u63d0\u5347\u53ef\u4ee5\u8ba9\u4f60\u5728\u5176\u4ed6\u7ade\u4e89\u5bf9\u624b\u4e4b\u524d\u9886\u5148\u51e0\u79d2\u3002\u53ef\u4ee5\u628a\u5b83\u770b\u4f5c\u662f\u4e13\u4e1a\u7ade\u901f\uff0c\u6bcf\u4e00\u79d2\u90fd\u81f3\u5173\u91cd\u8981\u3002\u4f60\u4e5f\u53ef\u4ee5\u4f7f\u7528\u6e38\u620f\u4e2d\u7684\u529f\u80fd\u5f55\u5236\u81ea\u5df1\uff0c\u4ee5\u8ddf\u8e2a\u4f60\u7684\u5931\u8d25\u5e76\u4f18\u5316\u4f60\u7684\u65f6\u95f4\u3002"}, {"question": "\u8dd1\u9177\u7ade\u901f\u4e2d\u5b58\u5728\u54ea\u4e9b\u5956\u52b1\u7cfb\u7edf\uff0c\u4ee5\u53ca\u662f\u5426\u5b58\u5728\u6bcf\u65e5/\u6bcf\u5468\u6311\u6218\u4ee5\u83b7\u5f97\u989d\u5916\u5956\u52b1\uff1f", "answer": "\u8dd1\u9177\u7ade\u901f\u62e5\u6709\u5206\u7ea7\u7684\u5956\u52b1\u7cfb\u7edf\uff0c\u5305\u62ec\u6bcf\u65e5\u548c\u6bcf\u5468\u6311\u6218\uff0c\u4ee5\u83b7\u5f97\u989d\u5916\u5956\u52b1\u3002\u5956\u52b1\u5305\u62ec\u6e38\u620f\u5185\u8d27\u5e01\u3001\u5b9a\u5236\u9009\u9879\u548c\u589e\u5f3a\u9053\u5177\u3002\u6bcf\u65e5\u6311\u6218\u901a\u5e38\u662f\u5b8c\u6210\u4e00\u5b9a\u6570\u91cf\u6bd4\u8d5b\u4e4b\u7c7b\u7684\u8f83\u5c0f\u76ee\u6807\uff0c\u800c\u6bcf\u5468\u6311\u6218\u5219\u66f4\u5927\uff0c\u9700\u8981\u66f4\u591a\u65f6\u95f4\u3002\u5b8c\u6210\u6240\u6709\u6bcf\u5468\u6311\u6218\u53ef\u4ee5\u83b7\u5f97\u72ec\u7279\u7684\u5916\u89c2\u76ae\u80a4\u3002\u8fd9\u5c31\u50cf\u4e00\u4e2a\u7ed3\u6784\u826f\u597d\u7684\u6fc0\u52b1\u673a\u5236\uff0c\u4f60\u56e0\u91cd\u590d\u6e38\u620f\u800c\u83b7\u5f97\u5956\u52b1\u3002\u83b7\u5f97\u8d2d\u4e70\u65b0\u76ae\u80a4\u6240\u9700\u8d27\u5e01\u7684\u53e6\u4e00\u4e2a\u6709\u6548\u6280\u5de7\u662f\u83b7\u53d6\u6e38\u620f\u4e2d\u6240\u6709\u7684\u6210\u5c31\uff0c\u56e0\u4e3a\u5b83\u4eec\u4f1a\u4e3a\u6b64\u63d0\u4f9b\u5956\u52b1\u3002"}, {"question": "\u4f60\u80fd\u89e3\u91ca\u8dd1\u9177\u7ade\u901f\u4e2d\u7684\u5e95\u5c42\u7269\u7406\u5f15\u64ce\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u54cd\u89d2\u8272\u7684\u79fb\u52a8\u548c\u4e0e\u73af\u5883\u7684\u4e92\u52a8\uff1f", "answer": "\u8dd1\u9177\u7ade\u901f\u4f7f\u7528\u7269\u7406\u5f15\u64ce\u6765\u6a21\u62df\u79fb\u52a8\u548c\u4e92\u52a8\u3002\u8be5\u5f15\u64ce\u51b3\u5b9a\u4e86\u4f60\u7684\u89d2\u8272\u5982\u4f55\u54cd\u5e94\u8df3\u8dc3\u3001\u6ed1\u884c\u548c\u649e\u51fb\u3002\u771f\u5b9e\u7684\u91cd\u529b\u8bbe\u7f6e\u4f1a\u5f71\u54cd\u8df3\u8dc3\u9ad8\u5ea6\u3001\u52a8\u91cf\u548c\u6280\u5de7\u6267\u884c\u3002\u4f8b\u5982\uff0c\u66f4\u9ad8\u7684\u91cd\u529b\u8bbe\u7f6e\u4f1a\u4f7f\u8df3\u8dc3\u611f\u89c9\u66f4\u91cd\uff0c\u66f4\u4e0d\u98d8\u9038\uff0c\u9700\u8981\u7cbe\u786e\u7684\u65f6\u95f4\u63a7\u5236\u3002\u5f15\u64ce\u662f\u6e38\u620f\u611f\u89c9\u7684\u57fa\u77f3\u3002\u4f18\u5316\u4f60\u7684\u6e38\u620f\u63a7\u5236\u5668\u4ee5\u9002\u5e94\u7269\u7406\u5f15\u64ce\u5c06\u6781\u5927\u5730\u6539\u5584\u4f60\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u4ee5\u4e0b\u662f\u4e00\u4e2a\u4f18\u5316\u4f60\u7684\u6e38\u620f\u63a7\u5236\u5668\u4ee5\u9002\u5e94\u8fd9\u6b3e\u6e38\u620f\u7684\u914d\u7f6e\u503c\u56fe\u8868\uff1a1) \u7075\u654f\u5ea6 (50%)\uff1b2) \u6b7b\u533a (5%)\u3002"}, {"question": "\u8dd1\u9177\u7ade\u901f\u662f\u5426\u652f\u6301\u8de8\u5e73\u53f0\u517c\u5bb9\uff0c\u6211\u662f\u5426\u53ef\u4ee5\u5728\u8fd0\u884c\u4e0d\u540c\u64cd\u4f5c\u7cfb\u7edf\u7684\u8bbe\u5907\u4e4b\u95f4\u8f6c\u79fb\u6211\u7684\u6e38\u620f\u8fdb\u5ea6\uff1f", "answer": "\u8dd1\u9177\u7ade\u901f\u76ee\u524d\u4e0d\u652f\u6301\u8de8\u5e73\u53f0\u517c\u5bb9\u6216\u5728\u4e0d\u540c\u64cd\u4f5c\u7cfb\u7edf\u4e4b\u95f4\u8f6c\u79fb\u6e38\u620f\u8fdb\u5ea6\u3002\u5982\u679c\u4f60\u5f00\u59cb\u5728\u4f60\u7684\u5b89\u5353\u624b\u673a\u4e0a\u73a9\uff0c\u4f60\u4e0d\u80fd\u5728\u4f60\u7684iPhone \u4e0a\u7ee7\u7eed\u8fdb\u884c\u76f8\u540c\u7684\u8fdb\u5ea6\u3002\u8fd9\u662f\u4e00\u4e2a\u5df2\u77e5\u7684\u9650\u5236\u3002\u8fd9\u5c31\u50cf\u8bd5\u56fe\u7528\u82f9\u679c\u5145\u7535\u5668\u7ed9\u5b89\u5353\u8bbe\u5907\u5145\u7535\u4e00\u6837\u2014\u2014\u5b83\u4eec\u6839\u672c\u4e0d\u517c\u5bb9\u3002\u4f60\u53ef\u4ee5\u68c0\u67e5\u8bbe\u5907\u7684\u5b98\u65b9\u517c\u5bb9\u6027\u4ee5\u786e\u4fdd\u826f\u597d\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u8dd1\u9177\u7ade\u901f\u4e2d\u7684\u201c\u9b3c\u5f71\u6a21\u5f0f\u201d\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9501\u6b64\u529f\u80fd\u4ee5\u901a\u8fc7\u4e0e\u4e4b\u524d\u8fd0\u884c\u7684\u7ade\u4e89\u6765\u63d0\u9ad8\u6211\u7684\u7ade\u901f\u6280\u80fd\uff1f", "answer": "\u8dd1\u9177\u7ade\u901f\u4e2d\u7684\u9b3c\u5f71\u6a21\u5f0f\u5141\u8bb8\u4f60\u4e0e\u4f60\u4e4b\u524d\u8fd0\u884c\u7684\u9b3c\u5f71\u5f55\u50cf\u8fdb\u884c\u7ade\u901f\u3002\u5b8c\u6210\u6559\u7a0b\u7cfb\u5217\u5373\u53ef\u89e3\u9501\u9b3c\u5f71\u6a21\u5f0f\u529f\u80fd\u3002\u901a\u8fc7\u5c06\u4f60\u5f53\u524d\u7684\u8fd0\u884c\u4e0e\u4f60\u7684\u9b3c\u5f71\u8fdb\u884c\u6bd4\u8f83\uff0c\u627e\u51fa\u4f60\u901f\u5ea6\u6162\u4e0b\u6765\u7684\u90e8\u5206\u5e76\u52a0\u4ee5\u6539\u8fdb\u3002\u4f8b\u5982\uff0c\u6ce8\u610f\u4f60\u5728\u54ea\u4e9b\u8df3\u8dc3\u4e2d\u5931\u53bb\u52a8\u529b\u3002\u8fd9\u5c31\u50cf\u4e0e\u4ee5\u524d\u7684\u81ea\u5df1\u7ade\u4e89\uff0c\u4e0d\u65ad\u8fdb\u6b65\u3002\u8bbf\u95ee\u9b3c\u5f71\u6a21\u5f0f\u7684\u6d41\u7a0b\u56fe\u5c06\u662f\uff1a1\uff09\u4e3b\u83dc\u5355 -> 2\uff09\u9009\u62e9\u4e00\u4e2a\u8d5b\u9053 -> 3\uff09\u542f\u7528\u9b3c\u5f71\u6a21\u5f0f\u9009\u9879\u3002"}]
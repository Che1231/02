[{"question": "\u30d1\u30fc\u30af\u30fc\u30eb\u30ec\u30fc\u30b9\uff1a\u521d\u5fc3\u8005\u304c\u30d1\u30fc\u30af\u30fc\u30eb\u30ec\u30fc\u30b9\u3067\u57fa\u672c\u7684\u306a\u30b8\u30e3\u30f3\u30d7\u3068\u30b9\u30e9\u30a4\u30c9\u3092\u884c\u3046\u65b9\u6cd5\u3001\u305d\u3057\u3066\u59cb\u3081\u308b\u305f\u3081\u306e\u6700\u5584\u306e\u65b9\u6cd5\u306f\uff1f", "answer": "\u30d1\u30fc\u30af\u30fc\u30eb\u30ec\u30fc\u30b9\u306e\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001\u57fa\u672c\u7684\u306a\u30b8\u30e3\u30f3\u30d7\u3068\u30b9\u30e9\u30a4\u30c9\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u306f\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u30021. \u30b8\u30e3\u30f3\u30d7\uff1a\u6a19\u6e96\u30b8\u30e3\u30f3\u30d7\u3092\u884c\u3046\u306b\u306f\u3001\u30b8\u30e3\u30f3\u30d7\u30dc\u30bf\u30f3\u3092\u30bf\u30c3\u30d7\u3057\u307e\u3059\u30022. \u30b9\u30e9\u30a4\u30c9\uff1a\u969c\u5bb3\u7269\u306b\u30b9\u30d4\u30fc\u30c9\u3067\u8fd1\u3065\u304d\u3001\u305d\u306e\u5f8c\u3001\u30b9\u30e9\u30a4\u30c9\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u3066\u305d\u306e\u4e0b\u3092\u901a\u904e\u3057\u307e\u3059\u3002\u4f8b\uff1a\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u4f4e\u3044\u30d1\u30a4\u30d7\u306e\u4e0b\u3092\u3059\u308a\u629c\u3051\u308b\u7df4\u7fd2\u3092\u3057\u307e\u3057\u3087\u3046\u3002\u6700\u521d\u306f\u7c21\u5358\u306a\u30b3\u30fc\u30b9\u304b\u3089\u59cb\u3081\u3066\u3001\u6163\u308c\u3066\u304d\u305f\u3089\u5f90\u3005\u306b\u96e3\u6613\u5ea6\u3092\u9ad8\u3081\u3066\u3044\u304d\u307e\u3057\u3087\u3046\u3002\u81ea\u8ee2\u8eca\u306b\u4e57\u308b\u3053\u3068\u3092\u5b66\u3076\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u57fa\u672c\u304b\u3089\u59cb\u3081\u3066\u3001\u30b9\u30ad\u30eb\u306f\u305d\u308c\u306b\u7d9a\u304d\u307e\u3059\u3002\u69cb\u6210\u3092\u6bd4\u8f03\u3059\u308b\u3068\u3001\u30b9\u30ef\u30a4\u30d7\u306e\u611f\u5ea6\u3092\u4f4e\u3044\u8a2d\u5b9a\u306b\u3059\u308b\u3068\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u5c0f\u3055\u306a\u52d5\u304d\u3092\u3088\u308a\u5236\u5fa1\u3057\u3001\u57fa\u672c\u7684\u306a\u30b8\u30e3\u30f3\u30d7\u3092\u3088\u308a\u5b89\u5b9a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d1\u30fc\u30af\u30fc\u30eb\u30ec\u30fc\u30b9\u3067\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u975e\u5e38\u306b\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u6bce\u56de\u5b8c\u74a7\u306a\u30b8\u30e3\u30f3\u30d7\u3092\u5b9f\u73fe\u3059\u308b\u305f\u3081\u306b\u4f7f\u7528\u3067\u304d\u308b\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30fc\u30af\u30fc\u30eb\u30ec\u30fc\u30b9\u3067\u306f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u3059\u3079\u3066\u3067\u3059\u3002\u30b8\u30e3\u30f3\u30d7\u3092\u5b8c\u74a7\u306b\u3059\u308b\u306b\u306f\u6b63\u78ba\u6027\u304c\u6c42\u3081\u3089\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u306e\u8ddd\u96e2\u3092\u89b3\u5bdf\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u7740\u5730\u70b9\u3092\u4e88\u6e2c\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u7aef\u3067\u30b8\u30e3\u30f3\u30d7\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u307e\u3059\u3002\u305d\u308c\u3088\u308a\u524d\u306b\u62bc\u3055\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002\u5f79\u306b\u7acb\u3064\u30c8\u30ea\u30c3\u30af\u306e1\u3064\u306f\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u8db3\u304c\u5730\u9762\u306b\u5f53\u305f\u308b\u97f3\u306b\u8033\u3092\u50be\u3051\u308b\u3053\u3068\u3067\u3059\u3002\u305d\u306e\u97f3\u306e\u5f8c\u3001\u307b\u3093\u306e\u4e00\u77ac\u5f8c\u306b\u30b8\u30e3\u30f3\u30d7\u3057\u307e\u3059\u3002\u5b66\u7fd2\u3059\u308b\u305f\u3081\u306e\u826f\u3044\u4f8b\u306f\u30014\u756a\u76ee\u306e\u30ec\u30d9\u30eb\u3067\u3059\u3002\u305d\u3053\u3067\u306f\u3001\u79fb\u52d5\u3059\u308b\u30d6\u30ed\u30c3\u30af\u4e0a\u3067\u30b8\u30e3\u30f3\u30d7\u3092\u9023\u9396\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u7d99\u7d9a\u7684\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u306b\u3088\u3063\u3066\u3001\u96e3\u3057\u3044\u30b8\u30e3\u30f3\u30d7\u304c\u30eb\u30fc\u30c1\u30f3\u7684\u306a\u30d1\u30fc\u30af\u30fc\u30eb\u306b\u306a\u308a\u307e\u3059\u3002\u3053\u308c\u306f\u97f3\u697d\u306e\u30ea\u30ba\u30e0\u3068\u8003\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30ea\u30ba\u30e0\u3092\u898b\u3064\u3051\u3001\u52d5\u304d\u3092\u5408\u308f\u305b\u308b\u306e\u3067\u3059\u3002"}, {"question": "\u30d1\u30fc\u30af\u30fc\u30eb\u30ec\u30fc\u30b9\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3068\u306f\u4f55\u3067\u3059\u304b\uff1f\u30ec\u30fc\u30b9\u4e2d\u306b\u305d\u308c\u3089\u3092\u4f7f\u7528\u3057\u3066\u30bf\u30a4\u30e0\u3092\u6539\u5584\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30fc\u30af\u30fc\u30eb\u30ec\u30fc\u30b9\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u3001\u30ec\u30fc\u30b9\u30bf\u30a4\u30e0\u3092\u5287\u7684\u306b\u6539\u5584\u3067\u304d\u307e\u3059\u3002\u305d\u308c\u3089\u306f\u3001\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u304b\u3089\u4e00\u6642\u7684\u306a\u7121\u6575\u52b9\u679c\u307e\u3067\u3055\u307e\u3056\u307e\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u9577\u3044\u30b8\u30e3\u30f3\u30d7\u306e\u524d\u3067\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u305d\u308c\u3092\u30af\u30ea\u30a2\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u3001\u58c1\u3092\u7a81\u7834\u3059\u308b\u305f\u3081\u306b\u7121\u6575\u52b9\u679c\u3092\u4f7f\u7528\u3067\u304d\u307e\u3059\u3002\u5404\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u8a66\u3057\u3066\u3001\u3069\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u4f7f\u7528\u3059\u308c\u3070\u826f\u3044\u304b\u3092\u77e5\u308b\u3088\u3046\u306b\u3057\u307e\u3057\u3087\u3046\u3002\u5f79\u306b\u7acb\u3064\u30c8\u30ea\u30c3\u30af\u306e1\u3064\u306f\u3001\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u306e\u305f\u3081\u306b\u7121\u6575\u52b9\u679c\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4fdd\u5b58\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u305d\u308c\u306f\u30c4\u30fc\u30eb\u30d9\u30eb\u30c8\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3001\u5404\u30a2\u30a4\u30c6\u30e0\u306b\u306f\u6642\u9593\u3068\u5834\u6240\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30d1\u30fc\u30af\u30fc\u30eb\u30ec\u30fc\u30b9\u306e\u9ad8\u5ea6\u306a\u30c8\u30ea\u30c3\u30af\uff1a\u30a6\u30a9\u30fc\u30eb\u30e9\u30f3\u30cb\u30f3\u30b0\u3068\u30a6\u30a9\u30fc\u30eb\u30b8\u30e3\u30f3\u30d7\u3068\u306f\u4f55\u3067\u3059\u304b\uff1f\u3053\u308c\u3089\u306e\u52d5\u304d\u3092\u52b9\u679c\u7684\u306b\u5b9f\u884c\u3057\u3066\u3001\u30bf\u30a4\u30e0\u3092\u77ed\u7e2e\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30a6\u30a9\u30fc\u30eb\u30e9\u30f3\u30cb\u30f3\u30b0\u3068\u30a6\u30a9\u30fc\u30eb\u30b8\u30e3\u30f3\u30d7\u306f\u3001\u30d1\u30fc\u30af\u30fc\u30eb\u30ec\u30fc\u30b9\u306e\u9ad8\u30ec\u30d9\u30eb\u306e\u30c8\u30ea\u30c3\u30af\u3067\u3059\u3002\u30a6\u30a9\u30fc\u30eb\u30e9\u30f3\u30cb\u30f3\u30b0\u306f\u3001\u5341\u5206\u306a\u901f\u5ea6\u3067\u58c1\u306b\u76f4\u63a5\u30b9\u30e9\u30a4\u30c9\u3057\u3001\u30b8\u30e3\u30f3\u30d7\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u9078\u629e\u3059\u308b\u3068\u5b9f\u884c\u3067\u304d\u307e\u3059\u3002\u30a6\u30a9\u30fc\u30eb\u30b8\u30e3\u30f3\u30d7\u306f\u3001\u58c1\u306b\u5411\u304b\u3063\u3066\u30b8\u30e3\u30f3\u30d7\u3057\u3001\u63a5\u89e6\u3057\u305f\u3068\u304d\u306b\u3059\u3050\u306b\u30b8\u30e3\u30f3\u30d7\u30dc\u30bf\u30f3\u3092\u518d\u3073\u30bf\u30c3\u30d7\u3057\u3066\u98db\u3073\u51fa\u3059\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\uff1a6\u756a\u76ee\u306e\u30ec\u30d9\u30eb\u3067\u30a6\u30a9\u30fc\u30eb\u30e9\u30f3\u30cb\u30f3\u30b0\u3057\u3066\u30b3\u30fc\u30b9\u306e\u4e00\u90e8\u3092\u30b9\u30ad\u30c3\u30d7\u3057\u307e\u3059\u3002\u3053\u306e\u30b9\u30ad\u30eb\u306f\u3001\u79fb\u52d5\u6027\u3092\u5287\u7684\u306b\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306b\u65b0\u3057\u3044\u5c64\u3092\u52a0\u3048\u305f\u3068\u8003\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30d2\u30f3\u30c8\u3068\u3057\u3066\u3001\u8a2d\u5b9a\u3067\u30b8\u30e3\u30f3\u30d7\u306e\u611f\u5ea6\u3092\u8abf\u6574\u3057\u3066\u3001\u3088\u308a\u30b8\u30e3\u30f3\u30d7\u6642\u9593\u3092\u5408\u308f\u305b\u3089\u308c\u308b\u3088\u3046\u306b\u5b9f\u9a13\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u30d1\u30fc\u30af\u30fc\u30eb\u30ec\u30fc\u30b9\u3067\u5229\u7528\u53ef\u80fd\u306a\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u30aa\u30d7\u30b7\u30e7\u30f3\u306f\u3069\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u304b\uff1f\u30d7\u30ec\u30a4\u4e2d\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3084\u30b9\u30bf\u30a4\u30eb\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30fc\u30af\u30fc\u30eb\u30ec\u30fc\u30b9\u306b\u306f\u591a\u304f\u306e\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u30aa\u30d7\u30b7\u30e7\u30f3\u304c\u3042\u308a\u307e\u3059\uff08\u4e3b\u306b\u8996\u899a\u7684\u306a\u3082\u306e\uff09\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u8863\u88c5\u306e\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3084\u3001\u30c8\u30ec\u30a4\u30eb\u30a8\u30d5\u30a7\u30af\u30c8\u306e\u5909\u66f4\u306a\u3069\u3092\u884c\u3048\u307e\u3059\u3002\u3053\u308c\u3089\u306f\u76f4\u63a5\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u5f71\u97ff\u3057\u307e\u305b\u3093\u304c\u3001\u30af\u30fc\u30eb\u306a\u30b9\u30bf\u30a4\u30eb\u306f\u81ea\u4fe1\u3092\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\uff01\u305f\u3068\u3048\u3070\u3001\u65b0\u3057\u3044\u8863\u88c5\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u30d7\u30ec\u30a4\u3059\u308b\u30e2\u30c1\u30d9\u30fc\u30b7\u30e7\u30f3\u304c\u9ad8\u307e\u308b\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u3002\u30b8\u30e7\u30ae\u30f3\u30b0\u306b\u6700\u9069\u306a\u8863\u88c5\u3092\u9078\u3076\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u901f\u304f\u8d70\u308c\u308b\u3088\u3046\u306b\u306a\u308b\u308f\u3051\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u304c\u3001\u6c17\u5206\u304c\u3088\u304f\u306a\u308a\u307e\u3059\u3002\u6700\u9069\u5316\u306e\u305f\u3081\u306e\u69cb\u6210\u8868\u306f\u3001\u307b\u3068\u3093\u3069\u500b\u4eba\u306b\u4f9d\u5b58\u3059\u308b\u305f\u3081\u3001\u81ea\u5206\u3067\u8a66\u3059\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30d1\u30fc\u30af\u30fc\u30eb\u30ec\u30fc\u30b9\u306e\u30ea\u30fc\u30c0\u30fc\u30dc\u30fc\u30c9\uff1a\u30b9\u30b3\u30a2\u306f\u3069\u306e\u3088\u3046\u306b\u8a08\u7b97\u3055\u308c\u307e\u3059\u304b\uff1f\u6700\u9ad8\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u4e00\u4eba\u306b\u306a\u308a\u3001\u30c8\u30c3\u30d7\u306b\u5230\u9054\u3059\u308b\u305f\u3081\u306b\u4f7f\u7528\u3067\u304d\u308b\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30fc\u30af\u30fc\u30eb\u30ec\u30fc\u30b9\u306e\u30ea\u30fc\u30c0\u30fc\u30dc\u30fc\u30c9\u306f\u3001\u30ec\u30fc\u30b9\u30bf\u30a4\u30e0\u306b\u57fa\u3065\u3044\u3066\u30b9\u30b3\u30a2\u3092\u8a08\u7b97\u3057\u307e\u3059\u3002\u30bf\u30a4\u30e0\u304c\u77ed\u3051\u308c\u3070\u77ed\u3044\u307b\u3069\u3001\u30b9\u30b3\u30a2\u304c\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u3092\u898b\u3064\u3051\u3066\u30eb\u30fc\u30c8\u3092\u6700\u9069\u5316\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u9ad8\u5ea6\u306a\u30c8\u30ea\u30c3\u30af\u3068\u30b8\u30e3\u30f3\u30d7\u3092\u30de\u30b9\u30bf\u30fc\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u6226\u7565\u7684\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002\u30c8\u30c3\u30d7\u306b\u5230\u9054\u3059\u308b\u306b\u306f\u3001\u732e\u8eab\u3068\u6b63\u78ba\u3055\u304c\u6c42\u3081\u3089\u308c\u307e\u3059\u3002\u4f8b\uff1a\u6700\u5f8c\u306e\u30ec\u30d9\u30eb\u3067\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u3092\u4f7f\u7528\u3059\u308b\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u77e5\u3063\u3066\u3044\u308c\u3070\u3001\u4ed6\u306e\u7af6\u5408\u8005\u3088\u308a\u3082\u6570\u79d2\u5148\u884c\u3067\u304d\u307e\u3059\u3002\u30d7\u30ed\u306e\u30ec\u30fc\u30b9\u3068\u8003\u3048\u308b\u3068\u30011\u79d2\u304c\u3059\u3079\u3066\u3067\u3059\u3002\u30b2\u30fc\u30e0\u5185\u306e\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u81ea\u5206\u306e\u30d7\u30ec\u30a4\u3092\u8a18\u9332\u3057\u3001\u5931\u6557\u3092\u8ffd\u8de1\u3057\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u6700\u9069\u5316\u3059\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d1\u30fc\u30af\u30fc\u30eb\u30ec\u30fc\u30b9\u3067\u5b58\u5728\u3059\u308b\u5831\u916c\u30b7\u30b9\u30c6\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f\u8ffd\u52a0\u5831\u916c\u3092\u5f97\u308b\u305f\u3081\u306e\u30c7\u30a4\u30ea\u30fc/\u30a6\u30a3\u30fc\u30af\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30fc\u30af\u30fc\u30eb\u30ec\u30fc\u30b9\u306b\u306f\u3001\u8ffd\u52a0\u5831\u916c\u3092\u7372\u5f97\u3059\u308b\u305f\u3081\u306e\u30c7\u30a4\u30ea\u30fc\u3068\u30a6\u30a3\u30fc\u30af\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u542b\u3080\u3001\u6bb5\u968e\u7684\u306a\u5831\u916c\u30b7\u30b9\u30c6\u30e0\u304c\u3042\u308a\u307e\u3059\u3002\u5831\u916c\u306b\u306f\u3001\u30b2\u30fc\u30e0\u5185\u901a\u8ca8\u3001\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u30aa\u30d7\u30b7\u30e7\u30f3\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u304c\u3042\u308a\u307e\u3059\u3002\u30c7\u30a4\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u306f\u901a\u5e38\u3001\u7279\u5b9a\u306e\u6570\u306e\u30ec\u30fc\u30b9\u3092\u5b8c\u4e86\u3059\u308b\u3068\u3044\u3046\u3088\u3046\u306a\u5c0f\u3055\u306a\u76ee\u6a19\u3067\u3059\u304c\u3001\u30a6\u30a3\u30fc\u30af\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u306f\u3088\u308a\u5927\u898f\u6a21\u3067\u3001\u3088\u308a\u591a\u304f\u306e\u6642\u9593\u304c\u5fc5\u8981\u3067\u3059\u3002\u3059\u3079\u3066\u306e\u30a6\u30a3\u30fc\u30af\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u30af\u30ea\u30a2\u3059\u308b\u3068\u3001\u30e6\u30cb\u30fc\u30af\u306a\u30b9\u30ad\u30f3\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u53cd\u5fa9\u30d7\u30ec\u30a4\u306b\u5bfe\u3059\u308b\u5831\u916c\u4f53\u7cfb\u304c\u6574\u5099\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u306b\u4f3c\u3066\u3044\u307e\u3059\u3002\u65b0\u3057\u3044\u30b9\u30ad\u30f3\u3092\u8cfc\u5165\u3059\u308b\u305f\u3081\u306e\u901a\u8ca8\u3092\u5165\u624b\u3059\u308b\u5225\u306e\u6709\u7528\u306a\u30d2\u30f3\u30c8\u306f\u3001\u30b2\u30fc\u30e0\u5185\u306e\u3059\u3079\u3066\u306e\u9054\u6210\u4e8b\u9805\u3092\u5f97\u308b\u3053\u3068\u3067\u3059\u3002\u305d\u3046\u3059\u308b\u3053\u3068\u3067\u3001\u305d\u308c\u3089\u306b\u5bfe\u3057\u3066\u5831\u916c\u3092\u5f97\u3089\u308c\u307e\u3059\u3002"}, {"question": "\u30d1\u30fc\u30af\u30fc\u30eb\u30ec\u30fc\u30b9\u306e\u6839\u5e95\u306b\u3042\u308b\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u306b\u3064\u3044\u3066\u8aac\u660e\u3067\u304d\u307e\u3059\u304b\uff1f\u305d\u308c\u306f\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u52d5\u304d\u3068\u74b0\u5883\u3068\u306e\u76f8\u4e92\u4f5c\u7528\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30fc\u30af\u30fc\u30eb\u30ec\u30fc\u30b9\u306f\u3001\u52d5\u304d\u3068\u76f8\u4e92\u4f5c\u7528\u3092\u30b7\u30df\u30e5\u30ec\u30fc\u30c8\u3059\u308b\u305f\u3081\u306b\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u3053\u306e\u30a8\u30f3\u30b8\u30f3\u306f\u3001\u30b8\u30e3\u30f3\u30d7\u3001\u30b9\u30e9\u30a4\u30c9\u3001\u885d\u6483\u306b\u5bfe\u3059\u308b\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u53cd\u5fdc\u3092\u6c7a\u5b9a\u3057\u307e\u3059\u3002\u73fe\u5b9f\u7684\u306a\u91cd\u529b\u8a2d\u5b9a\u306f\u3001\u30b8\u30e3\u30f3\u30d7\u306e\u9ad8\u3055\u3001\u904b\u52d5\u91cf\u3001\u30c8\u30ea\u30c3\u30af\u306e\u5b9f\u884c\u306b\u5f71\u97ff\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u91cd\u529b\u8a2d\u5b9a\u304c\u9ad8\u304f\u306a\u308b\u3068\u3001\u30b8\u30e3\u30f3\u30d7\u304c\u91cd\u304f\u611f\u3058\u3089\u308c\u3001\u6d6e\u904a\u611f\u304c\u6e1b\u5c11\u3057\u3001\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u6c42\u3081\u3089\u308c\u307e\u3059\u3002\u30a8\u30f3\u30b8\u30f3\u306f\u3001\u30b2\u30fc\u30e0\u30d5\u30a3\u30fc\u30ea\u30f3\u30b0\u306e\u57fa\u76e4\u3067\u3059\u3002\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u306b\u6700\u9069\u5316\u3055\u308c\u305f\u30b2\u30fc\u30e0\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u30b2\u30fc\u30e0\u4f53\u9a13\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002\u3053\u306e\u7279\u5b9a\u306e\u30b2\u30fc\u30e0\u5411\u3051\u306b\u30b2\u30fc\u30e0\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u3092\u6700\u9069\u5316\u3059\u308b\u305f\u3081\u306e\u69cb\u6210\u5024\u8868\u3092\u4ee5\u4e0b\u306b\u793a\u3057\u307e\u3059\uff1a1\uff09\u611f\u5ea6\uff0850\uff05\uff09\u30012\uff09\u30c7\u30c3\u30c9\u30be\u30fc\u30f3\uff085\uff05\uff09\u3002"}, {"question": "\u30d1\u30fc\u30af\u30fc\u30eb\u30ec\u30fc\u30b9\u306f\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u4e92\u63db\u6027\u304c\u3042\u308a\u307e\u3059\u304b\uff1f\u7570\u306a\u308b\u30aa\u30da\u30ec\u30fc\u30c6\u30a3\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u3067\u5b9f\u884c\u3055\u308c\u3066\u3044\u308b\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u9032\u6357\u72b6\u6cc1\u3092\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30fc\u30af\u30fc\u30eb\u30ec\u30fc\u30b9\u306f\u73fe\u5728\u3001\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u4e92\u63db\u6027\u3084\u7570\u306a\u308b\u30aa\u30da\u30ec\u30fc\u30c6\u30a3\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u9593\u3067\u306e\u9032\u6357\u72b6\u6cc1\u306e\u8ee2\u9001\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u307e\u305b\u3093\u3002Android\u30b9\u30de\u30fc\u30c8\u30d5\u30a9\u30f3\u3067\u30d7\u30ec\u30a4\u3092\u59cb\u3081\u308b\u3068\u3001\u540c\u3058\u9032\u6357\u72b6\u6cc1\u3067iPhone\u3067\u7d9a\u884c\u3059\u308b\u3053\u3068\u306f\u3067\u304d\u307e\u305b\u3093\u3002\u3053\u308c\u306f\u3001\u65e2\u77e5\u306e\u5236\u9650\u3067\u3059\u3002\u3053\u308c\u306f\u3001Apple\u5145\u96fb\u5668\u3092Android\u30c7\u30d0\u30a4\u30b9\u3067\u4f7f\u7528\u3057\u3088\u3046\u3068\u3059\u308b\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u4e92\u63db\u6027\u304c\u3042\u308a\u307e\u305b\u3093\u3002\u30c7\u30d0\u30a4\u30b9\u306e\u516c\u5f0f\u4e92\u63db\u6027\u3092\u78ba\u8a8d\u3057\u3066\u3001\u826f\u597d\u306a\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u78ba\u4fdd\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d1\u30fc\u30af\u30fc\u30eb\u30ec\u30fc\u30b9\u306e\u300c\u30b4\u30fc\u30b9\u30c8\u30e2\u30fc\u30c9\u300d\u3068\u306f\u4f55\u3067\u3059\u304b\uff1f\u3053\u306e\u6a5f\u80fd\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u3066\u3001\u4ee5\u524d\u306e\u30e9\u30f3\u3068\u7af6\u3044\u5408\u3044\u3001\u30ec\u30fc\u30b9\u30b9\u30ad\u30eb\u3092\u5411\u4e0a\u3055\u305b\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30fc\u30af\u30fc\u30eb\u30ec\u30fc\u30b9\u306e\u30b4\u30fc\u30b9\u30c8\u30e2\u30fc\u30c9\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u4ee5\u524d\u306e\u30e9\u30f3\u306e\u30b4\u30fc\u30b9\u30c8\u30ec\u30b3\u30fc\u30c7\u30a3\u30f3\u30b0\u3068\u7af6\u3046\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30b7\u30ea\u30fc\u30ba\u3092\u5b8c\u4e86\u3059\u308b\u3068\u3001\u30b4\u30fc\u30b9\u30c8\u30e2\u30fc\u30c9\u6a5f\u80fd\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u73fe\u5728\u306e\u30e9\u30f3\u3092\u30b4\u30fc\u30b9\u30c8\u3068\u6bd4\u8f03\u3059\u308b\u3053\u3068\u306b\u3088\u308a\u3001\u9045\u304f\u306a\u3063\u305f\u90e8\u5206\u3092\u7279\u5b9a\u3057\u3001\u6539\u5584\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u904b\u52d5\u91cf\u3092\u5931\u3063\u3066\u3057\u307e\u3063\u305f\u30b8\u30e3\u30f3\u30d7\u306b\u6ce8\u610f\u3057\u307e\u3057\u3087\u3046\u3002\u305d\u308c\u306f\u3001\u904e\u53bb\u306e\u81ea\u5206\u3068\u7af6\u3044\u3001\u5e38\u306b\u6539\u5584\u3057\u3066\u3044\u304f\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u30b4\u30fc\u30b9\u30c8\u30e2\u30fc\u30c9\u3078\u306e\u30a2\u30af\u30bb\u30b9\u306e\u305f\u3081\u306e\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\uff1a1\uff09\u30e1\u30a4\u30f3\u30e1\u30cb\u30e5\u30fc\u21922\uff09\u30b3\u30fc\u30b9\u3092\u9078\u629e\u21923\uff09\u30b4\u30fc\u30b9\u30c8\u30e2\u30fc\u30c9\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u6709\u52b9\u306b\u3059\u308b\u3002"}]
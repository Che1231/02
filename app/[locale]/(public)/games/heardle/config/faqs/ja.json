0\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u305f\u3081\u306eHeardle\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "Heardle\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u66f2\u306e\u63a8\u6e2c\u3092\u3069\u306e\u304f\u3089\u3044\u65e9\u304f\u6b63\u78ba\u306b\u884c\u3046\u304b\u306b\u3088\u3063\u3066\u5831\u916c\u3092\u4e0e\u3048\u307e\u3059\u3002\u30dd\u30a4\u30f3\u30c8\u304c\u6b63\u89e3\u3057\u305f\u63a8\u6e2c\u306b\u5bfe\u3057\u3066\u4e0e\u3048\u3089\u308c\u3001\u5c11\u306a\u3044\u8a66\u884c\u56de\u6570\u306b\u9ad8\u3044\u30dd\u30a4\u30f3\u30c8\u304c\u4e0e\u3048\u3089\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6700\u521d\u306b\u66f2\u3092\u63a8\u6e2c\u3059\u308b\u3068\u6700\u5927\u30dd\u30a4\u30f3\u30c8\u304c\u4e0e\u3048\u3089\u308c\u30016\u56de\u76ee\u306b\u63a8\u6e2c\u3059\u308b\u3068\u30dd\u30a4\u30f3\u30c8\u304c\u5c11\u306a\u304f\u306a\u308a\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u8074\u304f\u30b9\u30ad\u30eb\u3068\u63a8\u6e2c\u30b9\u30ad\u30eb\u3092\u5411\u4e0a\u3055\u305b\u308b\u3088\u3046\u4fc3\u3057\u307e\u3059\u3002"}, {"question": "Heardle\u306e\u66f2\u9078\u629e\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306e\u80cc\u5f8c\u306b\u3042\u308b\u4e3b\u8981\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Heardle\u306e\u66f2\u9078\u629e\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u4eba\u6c17\u3001\u30b8\u30e3\u30f3\u30eb\u306e\u591a\u69d8\u6027\u3001\u30e6\u30fc\u30b6\u30fc\u306e\u30a8\u30f3\u30b2\u30fc\u30b8\u30e1\u30f3\u30c8\u30c7\u30fc\u30bf\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u4f7f\u7528\u3057\u3066\u66f2\u3092\u6c7a\u5b9a\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5e45\u5e83\u3044\u5e74\u9f62\u5c64\u306e\u8074\u8846\u306b\u8a34\u3048\u308b\u305f\u3081\u306b\u3001\u6700\u65b0\u306e\u30d2\u30c3\u30c8\u66f2\u3068\u30af\u30e9\u30b7\u30c3\u30af\u66f2\u3092\u7d44\u307f\u5408\u308f\u305b\u3066\u9078\u629e\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u5404\u30b2\u30fc\u30e0\u30bb\u30c3\u30b7\u30e7\u30f3\u304c\u4e00\u610f\u3067\u6311\u6226\u7684\u3067\u3042\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u95a2\u5fc3\u3092\u7dad\u6301\u3057\u307e\u3059\u3002"}, {"question": "Heardle\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u97f3\u697d\u30b8\u30e3\u30f3\u30eb\u3067\u516c\u5e73\u306a\u30d7\u30ec\u30a4\u3092\u3069\u306e\u3088\u3046\u306b\u4fdd\u8a3c\u3057\u307e\u3059\u304b\uff1f", "answer": "Heardle\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u30b8\u30e3\u30f3\u30eb\u3084\u6642\u4ee3\u3092\u901a\u3057\u3066\u66f2\u3092\u30d0\u30e9\u30f3\u30b9\u3055\u305b\u308b\u3053\u3068\u3067\u3001\u516c\u5e73\u306a\u30d7\u30ec\u30a4\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002\u3053\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u3001\u7279\u5b9a\u306e\u7a2e\u985e\u306e\u97f3\u697d\u3078\u306e\u30d0\u30a4\u30a2\u30b9\u3092\u9632\u304e\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30b2\u30fc\u30e0\u30bb\u30c3\u30b7\u30e7\u30f3\u306b\u306f\u3001\u30dd\u30c3\u30d7\u30bd\u30f3\u30b0\u3001\u30ed\u30c3\u30af\u306e\u30af\u30e9\u30b7\u30c3\u30af\u3001\u30b8\u30e3\u30ba\u306e\u30b9\u30bf\u30f3\u30c0\u30fc\u30c9\u304c\u542b\u307e\u308c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u3001\u3059\u3079\u3066\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u5bfe\u3057\u3066\u591a\u69d8\u3067\u516c\u5e73\u306a\u4f53\u9a13\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002"}, {"question": "\u8907\u6570\u306e\u30c7\u30d0\u30a4\u30b9\u9593\u3067Heardle\u306e\u9032\u884c\u72b6\u6cc1\u3092\u540c\u671f\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u5404\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3053\u3068\u3067\u3001\u8907\u6570\u306e\u30c7\u30d0\u30a4\u30b9\u9593\u3067Heardle\u306e\u9032\u884c\u72b6\u6cc1\u3092\u540c\u671f\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u6a5f\u80fd\u306b\u3088\u308a\u3001\u30b9\u30de\u30fc\u30c8\u30d5\u30a9\u30f3\u3001\u30bf\u30d6\u30ec\u30c3\u30c8\u3001\u30b3\u30f3\u30d4\u30e5\u30fc\u30bf\u30fc\u306b\u304b\u304b\u308f\u3089\u305a\u3001\u30b2\u30fc\u30e0\u3092\u30b7\u30fc\u30e0\u30ec\u30b9\u306b\u7d9a\u884c\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u643a\u5e2f\u96fb\u8a71\u3067\u30b2\u30fc\u30e0\u3092\u958b\u59cb\u3057\u305f\u5834\u5408\u3001\u30e9\u30c3\u30d7\u30c8\u30c3\u30d7\u3067\u30b2\u30fc\u30e0\u3092\u7d42\u4e86\u3057\u3066\u3082\u9032\u884c\u72b6\u6cc1\u304c\u5931\u308f\u308c\u307e\u305b\u3093\u3002"}, {"question": "Heardle\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "Heardle\u306b\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4f53\u9a13\u3092\u5f37\u5316\u3059\u308b\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6700\u521d\u306b\u66f2\u3092\u63a8\u6e2c\u3059\u308b\u3068\u3001\u7279\u5225\u306a\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3\u3084\u30b5\u30a6\u30f3\u30c9\u30a8\u30d5\u30a7\u30af\u30c8\u304c\u30ed\u30c3\u30af\u89e3\u9664\u3055\u308c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u7279\u5b9a\u306e\u66f2\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u305d\u308c\u3089\u3092\u767a\u898b\u3059\u308b\u3068\u3001\u8ffd\u52a0\u306e\u8208\u596e\u5c64\u3092\u8ffd\u52a0\u3059\u308b\u30e6\u30cb\u30fc\u30af\u306a\u8996\u899a\u7684\u307e\u305f\u306f\u8074\u899a\u7684\u30ad\u30e5\u30fc\u3092\u5f15\u304d\u8d77\u3053\u3059\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002"}]
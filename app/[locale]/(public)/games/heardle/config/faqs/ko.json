[{"question": "\ucd08\ubcf4\uc790\uac00 \ud5c8\ub4e4 \uac8c\uc784\uc744 \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud5c8\ub4e4 \uac8c\uc784\uc744 \uc2dc\uc791\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. \ub2e8\uacc4 1: \ud5c8\ub4e4 \uc571 \ub610\ub294 \uc6f9\uc0ac\uc774\ud2b8\ub97c \uc5fd\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc81c\uacf5\ub41c \uc9e7\uc740 \uc74c\uc545 \ud074\ub9bd\uc744 \ub4e3\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 3: \uac80\uc0c9 \ucc3d\uc5d0 \ub178\ub798 \uc81c\ubaa9\uc774\ub098 \uc544\ud2f0\uc2a4\ud2b8 \uc774\ub984\uc744 \uc785\ub825\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5d0\ub4dc \uc2dc\ub7f0\uc758 '\uc250\uc774\ud504 \uc624\ube0c \uc720'\uc5d0\uc11c \ub098\uc628 \ud074\ub9bd\uc744 \ub4e4\uc5c8\ub2e4\uba74, '\uc250\uc774\ud504 \uc624\ube0c \uc720'\ub098 '\uc5d0\ub4dc \uc2dc\ub7f0'\uc744 \uc785\ub825\ud558\uc138\uc694. \uac8c\uc784\uc740 \ucd94\uce21\uc5d0 \ub300\ud55c \ud53c\ub4dc\ubc31\uc744 \uc81c\uacf5\ud558\uba70, \ud544\uc694\uc2dc \ub2e4\uc2dc \uc2dc\ub3c4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \ud5c8\ub4e4 \uac8c\uc784\uc758 \uae30\ubcf8 \uaddc\uce59\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud5c8\ub4e4 \uac8c\uc784\uc758 \uae30\ubcf8 \uaddc\uce59\uc740 \uac04\ub2e8\ud569\ub2c8\ub2e4. 1) \ub178\ub798\uc758 \uc9e7\uc740 \ud074\ub9bd\uc744 \ub4e3\uc2b5\ub2c8\ub2e4. 2) \ub178\ub798 \uc81c\ubaa9\uc774\ub098 \uc544\ud2f0\uc2a4\ud2b8\ub97c \ucd94\uce21\ud569\ub2c8\ub2e4. 3) \uc77c\ubc18\uc801\uc73c\ub85c 6\ubc88\uc758 \uc2dc\ub3c4 \uae30\ud68c\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud038\uc758 '\ubcf4\ud5e4\ubbf8\uc548 \ub7a9\uc18c\ub514'\uc758 \ud074\ub9bd\uc744 \ub4e4\uc5c8\ub2e4\uba74, '\ubcf4\ud5e4\ubbf8\uc548 \ub7a9\uc18c\ub514'\ub098 '\ud038'\uc744 \ucd94\uce21\ud574\uc57c \ud569\ub2c8\ub2e4. \uac01 \uc815\ub2f5\uc740 \uc804\uccb4 \ub178\ub798\ub97c \ubc1d\ud788\ub294 \ub370 \uac00\uae4c\uc774 \ub2e4\uac00\uac11\ub2c8\ub2e4."}, {"question": "\ud5c8\ub4e4 \uac8c\uc784\uc5d0\uc11c \ucd94\uce21 \uc815\ud655\ub3c4\ub97c \ub192\uc774\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud558\ub098\uc694?", "answer": "\ud5c8\ub4e4 \uac8c\uc784\uc5d0\uc11c \ucd94\uce21 \uc815\ud655\ub3c4\ub97c \ub192\uc774\ub824\uba74 \ub2e4\uc74c \uc804\ub7b5\uc744 \ub530\ub974\uc138\uc694. \ub2e8\uacc4 1: \ub9ac\ub4ec\uacfc \uba5c\ub85c\ub514\ub97c \uc8fc\uc758 \uae4a\uac8c \ub4e3\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 2: \uac00\uc0ac\ub098 \ub3c5\ud2b9\ud55c \uc545\uae30\ub97c \uc9d1\uc911\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc798\ubabb\ub41c \ucd94\uce21\uc5d0\uc11c \uc5bb\uc740 \ud53c\ub4dc\ubc31\uc744 \ud65c\uc6a9\ud558\uc5ec \uac00\ub2a5\uc131\uc744 \uc881\ud799\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uae30\ud0c0 \ub9ac\ud504\uc640 \ub85d \uc7a5\ub974\ub97c \ub4e4\uc5c8\ub2e4\uba74, \uc778\uae30 \uc788\ub294 \ub85d \ub178\ub798\ub4e4\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694. \ub2e4\uc591\ud55c \uc74c\uc545 \uc2a4\ud0c0\uc77c\uc744 \uc778\uc2dd\ud558\ub294 \ub370 \ub2a5\uc219\ud574\uc9c0\ub824\uba74 \uc815\uae30\uc801\uc73c\ub85c \uc5f0\uc2b5\ud558\uc138\uc694."}, {"question": "\ud5c8\ub4e4\uc774 \uc2dc\ub3c4 \ud69f\uc218\ub97c \uc81c\ud55c\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud5c8\ub4e4\uc740 \uac8c\uc784\uc5d0 \ub3c4\uc804\uacfc \uae34\uae09\uc131\uc744 \ub354\ud558\uae30 \uc704\ud574 \uc2dc\ub3c4 \ud69f\uc218\ub97c \uc81c\ud55c\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc81c\ud55c\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \ub79c\ub364\ud55c \uc2dc\ub3c4\ubcf4\ub2e4\ub294 \ube44\ud310\uc801\uc73c\ub85c \uc0dd\uac01\ud558\uace0 \uad50\uc721\uc801\uc778 \ucd94\uce21\uc744 \ud558\ub3c4\ub85d \uc7a5\ub824\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 6\ubc88\uc758 \uc2dc\ub3c4\ub9cc \ud5c8\uc6a9\ub418\ub294 \uacbd\uc6b0, \uc74c\uc545 \ud074\ub9bd\uc5d0\uc11c \uc81c\uacf5\ud558\ub294 \uac01 \ub2e8\uc11c\ub97c \uc2e0\uc911\ud558\uac8c \uace0\ub824\ud558\uc5ec \uc131\uacf5 \uac00\ub2a5\uc131\uc744 \uadf9\ub300\ud654\ud574\uc57c \ud569\ub2c8\ub2e4."}, {"question": "100\uc2dc\uac04 \ud50c\ub808\uc774 \ud6c4 \ud5c8\ub4e4\uc744 \ub9c8\uc2a4\ud130\ud558\uae30 \uc704\ud55c \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "100\uc2dc\uac04 \ud50c\ub808\uc774 \ud6c4 \ud5c8\ub4e4\uc744 \ub9c8\uc2a4\ud130\ud558\uae30 \uc704\ud574\uc11c\ub294 \ub2e4\uc74c\uacfc \uac19\uc774 \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \ub178\ub798 \uc2dc\uc791 \ubd80\ubd84\uacfc \uc544\ud2f0\uc2a4\ud2b8\uc5d0 \ub300\ud55c \uc815\uc2e0\uc801 \ubaa9\ub85d\uc744 \ub9cc\ub4ed\ub2c8\ub2e4. \ub2e8\uacc4 2: \ud15c\ud3ec, \uc7a5\ub974 \ubc0f \uc545\uae30\uc640 \uac19\uc740 \uc8fc\uc694 \uc694\uc18c\ub97c \ud30c\uc545\ud558\ub294 \ubc95\uc744 \ubc30\uc6b0\uc138\uc694. \ub2e8\uacc4 3: \uc774\uc804 \ucd94\uce21\uc744 \uae30\ubc18\uc73c\ub85c \uc81c\uc678 \uacfc\uc815\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc5ec\uc131 \ubcf4\uceec\ub9ac\uc2a4\ud2b8\uac00 \uc788\ub294 \ud31d\uc1a1\uc744 \uc778\uc2dd\ud558\ub294 \uacbd\uc6b0, \uc544\ub9ac\uc544\ub098 \uadf8\ub780\ub370\ub098 \ud14c\uc77c\ub7ec \uc2a4\uc704\ud504\ud2b8 \uac19\uc740 \uc544\ud2f0\uc2a4\ud2b8\ub85c \ubc94\uc704\ub97c \uc881\ud790 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud5c8\ub4e4 \uac8c\uc784\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc5b4\ub5bb\uac8c \uc791\uc6a9\ud558\ub098\uc694?", "answer": "\ud5c8\ub4e4 \uac8c\uc784\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \ub178\ub798\ub97c \uc5bc\ub9c8\ub098 \ube60\ub974\uace0 \uc815\ud655\ud558\uac8c \ucd94\uce21\ud588\ub294\uc9c0\uc5d0 \ub530\ub77c \ubcf4\uc0c1\ud569\ub2c8\ub2e4. \uc815\ub2f5\uc5d0 \ub300\ud55c \uc810\uc218\uac00 \ubd80\uc5ec\ub418\uba70, \uc2dc\ub3c4 \ud69f\uc218\uac00 \uc801\uc744\uc218\ub85d \ub192\uc740 \uc810\uc218\uac00 \ubd80\uc5ec\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \uc2dc\ub3c4\uc5d0\uc11c \ub178\ub798\ub97c \ub9de\ucd94\uba74 \ucd5c\ub300 \uc810\uc218\ub97c \ubc1b\uace0, \uc5ec\uc12f \ubc88\uc9f8 \uc2dc\ub3c4\uc5d0\uc11c \ub9de\ucd94\uba74 \uc810\uc218\uac00 \uc801\uc2b5\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uccad\ucde8 \ubc0f \ucd94\uce21 \ub2a5\ub825\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub3c4\ub85d \uc7a5\ub824\ud569\ub2c8\ub2e4."}, {"question": "\ud5c8\ub4e4 \uac8c\uc784\uc758 \ub178\ub798 \uc120\ud0dd \uc54c\uace0\ub9ac\uc998 \ub4a4\uc5d0 \uc228\uaca8\uc9c4 \uc8fc\uc694 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud5c8\ub4e4 \uac8c\uc784\uc758 \ub178\ub798 \uc120\ud0dd \uc54c\uace0\ub9ac\uc998\uc740 \uc778\uae30, \uc7a5\ub974 \ub2e4\uc591\uc131 \ubc0f \uc0ac\uc6a9\uc790 \ucc38\uc5ec \ub370\uc774\ud130\ub97c \uacb0\ud569\ud558\uc5ec \ub178\ub798\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uad11\ubc94\uc704\ud55c \uccad\uc911\uc5d0\uac8c \uc5b4\ud544\ud558\uae30 \uc704\ud574 \ucd5c\uc2e0 \ud788\ud2b8\uace1\uacfc \ud074\ub798\uc2dd \ub178\ub798\ub4e4\uc744 \ud63c\ud569\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc54c\uace0\ub9ac\uc998\uc740 \uac01 \uac8c\uc784 \uc138\uc158\uc774 \ub3c5\ud2b9\ud558\uace0 \ub3c4\uc804\uc801\uc774\uc5b4\uc11c \ud50c\ub808\uc774\uc5b4\uc758 \ucc38\uc5ec\ub97c \uacc4\uc18d \uc720\uc9c0\ud569\ub2c8\ub2e4."}, {"question": "\ud5c8\ub4e4 \uac8c\uc784\uc740 \ub2e4\uc591\ud55c \uc74c\uc545 \uc7a5\ub974\uc5d0\uc11c \uacf5\uc815\ud55c \uacbd\uc7c1\uc744 \uc5b4\ub5bb\uac8c \ubcf4\uc7a5\ud558\ub098\uc694?", "answer": "\ud5c8\ub4e4\uc740 \ub2e4\uc591\ud55c \uc7a5\ub974\uc640 \uc2dc\ub300\uc758 \ub178\ub798 \uc120\ud0dd\uc744 \uade0\ud615 \uc788\uac8c \ud568\uc73c\ub85c\uc368 \uacf5\uc815\ud55c \uacbd\uc7c1\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc811\uadfc \ubc29\uc2dd\uc740 \ud2b9\uc815 \uc720\ud615\uc758 \uc74c\uc545\uc5d0 \ub300\ud55c \ud3b8\ud5a5\uc744 \ubc29\uc9c0\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac8c\uc784 \uc138\uc158\uc5d0\ub294 \ud31d\uc1a1, \ub85d \ud074\ub798\uc2dd \ubc0f \uc7ac\uc988 \ud45c\uc900\uc774 \ud3ec\ud568\ub418\uc5b4 \ubaa8\ub4e0 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ub2e4\ucc44\ub86d\uace0 \uacf5\uc815\ud55c \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}, {"question": "\uc5ec\ub7ec \uae30\uae30\uc5d0\uc11c \ud5c8\ub4e4 \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub124, \uac01 \uae30\uae30\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uba74 \uc5ec\ub7ec \uae30\uae30\uc5d0\uc11c \ud5c8\ub4e4 \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uae30\ub2a5\uc744 \ud1b5\ud574 \uc2a4\ub9c8\ud2b8\ud3f0, \ud0dc\ube14\ub9bf \ub610\ub294 \ucef4\ud4e8\ud130\uc5d0\uc11c\ub3c4 \uac8c\uc784\uc744 \uc6d0\ud65c\ud558\uac8c \uacc4\uc18d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud734\ub300\ud3f0\uc5d0\uc11c \uac8c\uc784\uc744 \uc2dc\uc791\ud55c \uacbd\uc6b0, \ub7a9\ud0d1\uc5d0\uc11c \uac8c\uc784\uc744 \ub9c8\uce60 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud5c8\ub4e4 \uac8c\uc784\uc5d0 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\ub098\uc694?", "answer": "\ud5c8\ub4e4 \uac8c\uc784\uc5d0\ub294 \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \uc2dc\ub3c4\uc5d0\uc11c \ub178\ub798\ub97c \ub9de\ucd94\uba74 \ud2b9\ubcc4\ud55c \uc560\ub2c8\uba54\uc774\uc158\uc774\ub098 \uc0ac\uc6b4\ub4dc \ud6a8\uacfc\uac00 \ud574\uc81c\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \ud2b9\uc815 \ub178\ub798\ub97c \ub9de\ucd94\uba74 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \ucd94\uac00\uc801\uc778 \ud765\ubd84\uc744 \ub354\ud558\ub294 \uace0\uc720\ud55c \uc2dc\uac01\uc801 \ub610\ub294 \uccad\uac01\uc801 \ub2e8\uc11c\uac00 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
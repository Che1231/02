[{"question": "\u5982\u4f55\u958b\u59cb\u73a9 Heardle \u904a\u6232\u4f5c\u70ba\u65b0\u624b\uff1f", "answer": "\u8981\u958b\u59cb\u73a9 Heardle\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f 1\uff1a\u958b\u555f Heardle \u61c9\u7528\u7a0b\u5f0f\u6216\u7db2\u7ad9\u3002\u6b65\u9a5f 2\uff1a\u8046\u807d\u63d0\u4f9b\u7684\u77ed\u97f3\u6a02\u7247\u6bb5\u3002\u6b65\u9a5f 3\uff1a\u5728\u641c\u5c0b\u5217\u4e2d\u8f38\u5165\u6b4c\u66f2\u6216\u85dd\u4eba\u7684\u540d\u7a31\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u807d\u5230\u4e00\u9996\u7531 Ed Sheeran \u6f14\u5531\u7684\u300eShape of You\u300f\u7684\u7247\u6bb5\uff0c\u8acb\u8f38\u5165\u300eShape of You\u300f\u6216\u300eEd Sheeran\u300f\u3002\u904a\u6232\u5c07\u6703\u63d0\u4f9b\u60a8\u95dc\u65bc\u60a8\u731c\u6e2c\u7684\u56de\u994b\uff0c\u5982\u679c\u60a8\u9700\u8981\uff0c\u60a8\u53ef\u4ee5\u518d\u6b21\u5617\u8a66\u3002"}, {"question": "\u5c0d\u65bc\u65b0\u73a9\u5bb6\u4f86\u8aaa\uff0cHeardle \u7684\u57fa\u672c\u898f\u5247\u662f\u4ec0\u9ebc\uff1f", "answer": "Heardle \u7684\u57fa\u672c\u898f\u5247\u5f88\u7c21\u55ae\uff1a1) \u60a8\u6703\u807d\u5230\u4e00\u6bb5\u77ed\u6b4c\u66f2\u7247\u6bb5\u30022) \u60a8\u6703\u731c\u51fa\u6b4c\u66f2\u540d\u7a31\u6216\u85dd\u4eba\u540d\u7a31\u30023) \u60a8\u6709\u6709\u9650\u6b21\u7684\u5617\u8a66\u6b21\u6578\uff08\u901a\u5e38\u662f 6 \u6b21\uff09\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u807d\u5230\u4e00\u9996\u7531 Queen \u6f14\u5531\u7684\u300eBohemian Rhapsody\u300f\u7684\u7247\u6bb5\uff0c\u60a8\u61c9\u8a72\u731c\u51fa\u300eBohemian Rhapsody\u300f\u6216\u300eQueen\u300f\u3002\u6bcf\u6b21\u6b63\u78ba\u7684\u731c\u6e2c\u90fd\u6703\u8b93\u60a8\u66f4\u63a5\u8fd1\u5b8c\u6574\u6b4c\u66f2\u7684\u63ed\u66c9\u3002"}, {"question": "\u5982\u4f55\u5728 Heardle \u4e2d\u63d0\u9ad8\u6211\u7684\u731c\u6e2c\u6e96\u78ba\u5ea6\uff1f", "answer": "\u8981\u63d0\u9ad8\u60a8\u5728 Heardle \u4e2d\u7684\u731c\u6e2c\u6e96\u78ba\u5ea6\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9a5f 1\uff1a\u4ed4\u7d30\u8046\u807d\u7bc0\u594f\u548c\u65cb\u5f8b\u3002\u6b65\u9a5f 2\uff1a\u5c08\u6ce8\u65bc\u6b4c\u8a5e\u6216\u4efb\u4f55\u7368\u7279\u7684\u6a02\u5668\u3002\u6b65\u9a5f 3\uff1a\u5229\u7528\u4e0d\u6b63\u78ba\u7684\u731c\u6e2c\u56de\u994b\u4f86\u7e2e\u5c0f\u53ef\u80fd\u6027\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u807d\u5230\u4e00\u6bb5\u5409\u4ed6\u7368\u594f\uff0c\u800c\u4e14\u985e\u578b\u662f\u6416\u6efe\u6a02\uff0c\u8acb\u601d\u8003\u4e00\u4e9b\u6d41\u884c\u7684\u6416\u6efe\u6b4c\u66f2\u3002\u5b9a\u671f\u7df4\u7fd2\uff0c\u4ee5\u66f4\u597d\u5730\u8fa8\u8b58\u4e0d\u540c\u7684\u97f3\u6a02\u98a8\u683c\u3002"}, {"question": "\u70ba\u4ec0\u9ebc Heardle \u6703\u9650\u5236\u731c\u6e2c\u6b21\u6578\uff1f", "answer": "Heardle \u9650\u5236\u731c\u6e2c\u6b21\u6578\uff0c\u4ee5\u589e\u52a0\u904a\u6232\u7684\u6311\u6230\u6027\u548c\u7dca\u8feb\u611f\u3002\u9019\u7a2e\u9650\u5236\u9f13\u52f5\u73a9\u5bb6\u9032\u884c\u6279\u5224\u6027\u601d\u8003\u4e26\u505a\u51fa\u5408\u7406\u7684\u731c\u6e2c\uff0c\u800c\u4e0d\u662f\u96a8\u610f\u7684\u5617\u8a66\u3002\u4f8b\u5982\uff0c\u53ea\u6709 6 \u6b21\u731c\u6e2c\uff0c\u60a8\u5fc5\u9808\u4ed4\u7d30\u8003\u616e\u97f3\u6a02\u7247\u6bb5\u63d0\u4f9b\u7684\u6bcf\u4e00\u500b\u7dda\u7d22\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u6210\u529f\u7684\u6a5f\u7387\u3002"}, {"question": "\u5728\u73a9\u4e86 100 \u5c0f\u6642\u5f8c\uff0c\u6211\u53ef\u4ee5\u7528\u54ea\u4e9b\u7b56\u7565\u4f86\u638c\u63e1 Heardle\uff1f", "answer": "\u5728\u73a9\u4e86 100 \u5c0f\u6642\u5f8c\uff0c\u60a8\u53ef\u4ee5\u900f\u904e\u4ee5\u4e0b\u65b9\u5f0f\u638c\u63e1 Heardle\uff1a\u6b65\u9a5f 1\uff1a\u5efa\u7acb\u6b4c\u66f2\u958b\u982d\u548c\u85dd\u4eba\u540d\u7a31\u7684\u8166\u6d77\u5716\u66f8\u9928\u3002\u6b65\u9a5f 2\uff1a\u5b78\u7fd2\u8b58\u5225\u95dc\u9375\u5143\u7d20\uff0c\u4f8b\u5982\u7bc0\u594f\u3001\u985e\u578b\u548c\u6a02\u5668\u3002\u6b65\u9a5f 3\uff1a\u6839\u64da\u4ee5\u524d\u7684\u731c\u6e2c\u4f7f\u7528\u6392\u9664\u6cd5\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u8fa8\u8a8d\u51fa\u4e00\u9996\u5973\u6b4c\u624b\u6f14\u5531\u7684\u6d41\u884c\u6b4c\u66f2\uff0c\u60a8\u53ef\u4ee5\u5c07\u7bc4\u570d\u7e2e\u5c0f\u5230\u50cf\u662f Ariana Grande \u6216 Taylor Swift \u7b49\u85dd\u8853\u5bb6\u3002"}, {"question": "\u5c0d\u65bc\u9ad8\u7d1a\u73a9\u5bb6\u800c\u8a00\uff0cHeardle \u7684\u7a4d\u5206\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff1f", "answer": "Heardle \u7684\u7a4d\u5206\u7cfb\u7d71\u6703\u6839\u64da\u73a9\u5bb6\u731c\u6e2c\u6b4c\u66f2\u7684\u5feb\u901f\u6027\u548c\u6e96\u78ba\u5ea6\u4f86\u734e\u52f5\u73a9\u5bb6\u3002\u6b63\u78ba\u7684\u731c\u6e2c\u6703\u7372\u5f97\u7a4d\u5206\uff0c\u800c\u4f7f\u7528\u8f03\u5c11\u5617\u8a66\u6b21\u6578\u7684\u6b63\u78ba\u731c\u6e2c\u6703\u7372\u5f97\u66f4\u9ad8\u7684\u7a4d\u5206\u3002\u4f8b\u5982\uff0c\u7b2c\u4e00\u6b21\u731c\u5c0d\u6b4c\u66f2\u6703\u7372\u5f97\u6700\u9ad8\u7a4d\u5206\uff0c\u800c\u7b2c\u516d\u6b21\u731c\u5c0d\u6b4c\u66f2\u6703\u7372\u5f97\u8f03\u4f4e\u7a4d\u5206\u3002\u6b64\u7cfb\u7d71\u9f13\u52f5\u73a9\u5bb6\u63d0\u5347\u4ed6\u5011\u7684\u8046\u807d\u548c\u731c\u6e2c\u6280\u80fd\u3002"}, {"question": "Heardle \u7684\u6b4c\u66f2\u9078\u64c7\u6f14\u7b97\u6cd5\u80cc\u5f8c\u7684\u95dc\u9375\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "Heardle \u7684\u6b4c\u66f2\u9078\u64c7\u6f14\u7b97\u6cd5\u7d50\u5408\u4e86\u6d41\u884c\u5ea6\u3001\u985e\u578b\u591a\u6a23\u6027\u548c\u4f7f\u7528\u8005\u53c3\u8207\u6578\u64da\u4f86\u9078\u64c7\u6b4c\u66f2\u3002\u4f8b\u5982\uff0c\u5b83\u53ef\u80fd\u6703\u9078\u64c7\u6d41\u884c\u6b4c\u66f2\u548c\u7d93\u5178\u6b4c\u66f2\u7684\u7d44\u5408\uff0c\u4ee5\u5438\u5f15\u5ee3\u6cdb\u7684\u807d\u773e\u3002\u6b64\u6f14\u7b97\u6cd5\u78ba\u4fdd\u6bcf\u6b21\u904a\u6232\u9ad4\u9a57\u90fd\u662f\u7368\u7279\u4e14\u5177\u6709\u6311\u6230\u6027\u7684\uff0c\u4fdd\u6301\u73a9\u5bb6\u7684\u53c3\u8207\u611f\u3002"}, {"question": "Heardle \u5982\u4f55\u78ba\u4fdd\u5728\u4e0d\u540c\u97f3\u6a02\u985e\u578b\u4e2d\u516c\u5e73\u7684\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "Heardle \u6703\u900f\u904e\u5728\u5404\u7a2e\u6d41\u6d3e\u548c\u5e74\u4ee3\u4e2d\u5e73\u8861\u6b4c\u66f2\u7684\u9078\u64c7\u4f86\u78ba\u4fdd\u516c\u5e73\u7684\u904a\u6232\u9ad4\u9a57\u3002\u9019\u7a2e\u65b9\u5f0f\u53ef\u4ee5\u9632\u6b62\u504f\u5411\u4efb\u4f55\u7279\u5b9a\u7684\u97f3\u6a02\u985e\u578b\u3002\u4f8b\u5982\uff0c\u904a\u6232\u968e\u6bb5\u53ef\u80fd\u6703\u5305\u542b\u4e00\u9996\u6d41\u884c\u6b4c\u66f2\u3001\u4e00\u9996\u6416\u6efe\u7d93\u5178\u6b4c\u66f2\u548c\u4e00\u9996\u7235\u58eb\u6a02\u6a19\u6e96\u6b4c\u66f2\uff0c\u70ba\u6240\u6709\u73a9\u5bb6\u63d0\u4f9b\u591a\u5143\u4e14\u516c\u5e73\u7684\u9ad4\u9a57\u3002"}, {"question": "\u6211\u53ef\u4ee5\u540c\u6b65\u6211\u5728\u4e0d\u540c\u88dd\u7f6e\u4e0a\u7684 Heardle \u9032\u5ea6\u55ce\uff1f", "answer": "\u662f\u7684\uff0c\u60a8\u53ef\u4ee5\u900f\u904e\u5728\u6bcf\u500b\u88dd\u7f6e\u4e0a\u767b\u5165\u76f8\u540c\u7684\u5e33\u6236\u4f86\u540c\u6b65\u60a8\u5728\u4e0d\u540c\u88dd\u7f6e\u4e0a\u7684 Heardle \u9032\u5ea6\u3002\u6b64\u529f\u80fd\u8b93\u60a8\u53ef\u4ee5\u5728\u667a\u6167\u578b\u624b\u6a5f\u3001\u5e73\u677f\u96fb\u8166\u6216\u96fb\u8166\u4e0a\u9806\u5229\u5730\u7e7c\u7e8c\u904a\u6232\uff0c\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u624b\u6a5f\u4e0a\u958b\u59cb\u904a\u6232\uff0c\u60a8\u53ef\u4ee5\u5728\u7b46\u8a18\u578b\u96fb\u8166\u4e0a\u5b8c\u6210\u904a\u6232\uff0c\u800c\u4e0d\u6703\u907a\u5931\u60a8\u7684\u9032\u5ea6\u3002"}, {"question": "Heardle \u4e2d\u662f\u5426\u6709\u4efb\u4f55\u96b1\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "Heardle \u5305\u542b\u96b1\u85cf\u7684\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u4ee5\u589e\u5f37\u904a\u6232\u9ad4\u9a57\u3002\u4f8b\u5982\uff0c\u7b2c\u4e00\u6b21\u731c\u4e2d\u6b4c\u66f2\u53ef\u80fd\u6703\u89e3\u9396\u7279\u6b8a\u52d5\u756b\u6216\u97f3\u6548\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u6b4c\u66f2\u53ef\u80fd\u6703\u89f8\u767c\u7368\u7279\u7684\u8996\u89ba\u6216\u807d\u89ba\u63d0\u793a\uff0c\u70ba\u767c\u73fe\u5b83\u5011\u7684\u73a9\u5bb6\u589e\u52a0\u984d\u5916\u7684\u8208\u596e\u611f\u3002"}]
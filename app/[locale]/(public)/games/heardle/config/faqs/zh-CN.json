[{"question": "\u65b0\u624b\u5982\u4f55\u5f00\u59cb\u73a9Heardle\u6e38\u620f\uff1f", "answer": "\u8981\u5f00\u59cb\u73a9Heardle\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u6253\u5f00Heardle\u5e94\u7528\u6216\u7f51\u7ad9\u3002\u6b65\u9aa42\uff1a\u8046\u542c\u63d0\u4f9b\u7684\u77ed\u97f3\u4e50\u7247\u6bb5\u3002\u6b65\u9aa43\uff1a\u5728\u641c\u7d22\u680f\u4e2d\u8f93\u5165\u6b4c\u66f2\u6216\u827a\u672f\u5bb6\u7684\u540d\u79f0\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u542c\u5230\u7684\u662f\u57c3\u5fb7\u00b7\u5e0c\u5170\uff08Ed Sheeran\uff09\u7684\u300aShape of You\u300b\u7684\u7247\u6bb5\uff0c\u8bf7\u8f93\u5165\u201cShape of You\u201d\u6216\u201cEd Sheeran\u201d\u3002\u6e38\u620f\u5c06\u5bf9\u60a8\u7684\u731c\u6d4b\u8fdb\u884c\u53cd\u9988\uff0c\u5982\u6709\u9700\u8981\uff0c\u60a8\u53ef\u4ee5\u5c1d\u8bd5\u5176\u4ed6\u731c\u6d4b\u3002"}, {"question": "Heardle\u6e38\u620f\u7684\u65b0\u73a9\u5bb6\u9700\u8981\u4e86\u89e3\u54ea\u4e9b\u57fa\u672c\u89c4\u5219\uff1f", "answer": "Heardle\u6e38\u620f\u7684\u57fa\u672c\u89c4\u5219\u5f88\u7b80\u5355\uff1a1) \u8046\u542c\u4e00\u6bb5\u77ed\u6b4c\u66f2\u7247\u6bb5\u30022) \u731c\u6d4b\u6b4c\u66f2\u540d\u79f0\u6216\u827a\u672f\u5bb6\u30023) \u5c1d\u8bd5\u6b21\u6570\u6709\u9650\uff08\u901a\u5e38\u4e3a6\u6b21\uff09\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u542c\u5230\u7684\u662f\u7687\u540e\u4e50\u961f\uff08Queen\uff09\u7684\u300a\u6ce2\u897f\u7c73\u4e9a\u72c2\u60f3\u66f2\u300b\uff08Bohemian Rhapsody\uff09\u7684\u7247\u6bb5\uff0c\u5219\u5e94\u8be5\u731c\u6d4b\u201c\u6ce2\u897f\u7c73\u4e9a\u72c2\u60f3\u66f2\u201d\u6216\u201c\u7687\u540e\u4e50\u961f\u201d\u3002\u6bcf\u6b21\u6b63\u786e\u7684\u731c\u6d4b\u90fd\u5c06\u4f7f\u60a8\u66f4\u63a5\u8fd1\u5b8c\u6574\u6b4c\u66f2\u7684\u63ed\u6653\u3002"}, {"question": "\u5982\u4f55\u63d0\u9ad8\u6211\u5728Heardle\u6e38\u620f\u4e2d\u7684\u731c\u6d4b\u51c6\u786e\u6027\uff1f", "answer": "\u8981\u63d0\u9ad8\u60a8\u5728Heardle\u6e38\u620f\u4e2d\u7684\u731c\u6d4b\u51c6\u786e\u6027\uff0c\u8bf7\u9075\u5faa\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9aa41\uff1a\u4ed4\u7ec6\u8046\u542c\u8282\u594f\u548c\u65cb\u5f8b\u3002\u6b65\u9aa42\uff1a\u5173\u6ce8\u6b4c\u8bcd\u6216\u4efb\u4f55\u72ec\u7279\u7684\u4e50\u5668\u3002\u6b65\u9aa43\uff1a\u5229\u7528\u4e0d\u6b63\u786e\u7684\u731c\u6d4b\u53cd\u9988\u6765\u7f29\u5c0f\u53ef\u80fd\u6027\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u542c\u5230\u4e00\u6bb5\u5409\u4ed6\u72ec\u594f\uff0c\u5e76\u4e14\u6d41\u6d3e\u662f\u6447\u6eda\u4e50\uff0c\u8bf7\u8003\u8651\u6d41\u884c\u7684\u6447\u6eda\u6b4c\u66f2\u3002\u5b9a\u671f\u7ec3\u4e60\uff0c\u4ee5\u4fbf\u66f4\u597d\u5730\u8bc6\u522b\u4e0d\u540c\u7684\u97f3\u4e50\u98ce\u683c\u3002"}, {"question": "\u4e3a\u4ec0\u4e48Heardle\u6e38\u620f\u4f1a\u9650\u5236\u731c\u6d4b\u6b21\u6570\uff1f", "answer": "Heardle\u6e38\u620f\u9650\u5236\u731c\u6d4b\u6b21\u6570\u662f\u4e3a\u4e86\u589e\u52a0\u6e38\u620f\u7684\u6311\u6218\u6027\u548c\u7d27\u8feb\u611f\u3002\u8fd9\u79cd\u9650\u5236\u9f13\u52b1\u73a9\u5bb6\u8fdb\u884c\u6279\u5224\u6027\u601d\u8003\u5e76\u505a\u51fa\u5408\u7406\u7684\u731c\u6d4b\uff0c\u800c\u4e0d\u662f\u968f\u673a\u5c1d\u8bd5\u3002\u4f8b\u5982\uff0c\u53ea\u67096\u6b21\u731c\u6d4b\uff0c\u60a8\u5fc5\u987b\u4ed4\u7ec6\u8003\u8651\u97f3\u4e50\u7247\u6bb5\u63d0\u4f9b\u7684\u6bcf\u4e2a\u7ebf\u7d22\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u6210\u529f\u7684\u673a\u4f1a\u3002"}, {"question": "\u5728\u73a9\u4e86100\u5c0f\u65f6Heardle\u6e38\u620f\u540e\uff0c\u6211\u80fd\u4f7f\u7528\u54ea\u4e9b\u7b56\u7565\u6765\u638c\u63e1\u8be5\u6e38\u620f\uff1f", "answer": "\u73a9\u4e86100\u4e2a\u5c0f\u65f6\u540e\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u4ee5\u4e0b\u65b9\u5f0f\u638c\u63e1Heardle\u6e38\u620f\uff1a\u6b65\u9aa41\uff1a\u5efa\u7acb\u6b4c\u66f2\u5f00\u573a\u548c\u827a\u672f\u5bb6\u7684\u7cbe\u795e\u5e93\u3002\u6b65\u9aa42\uff1a\u5b66\u4e60\u8bc6\u522b\u5173\u952e\u5143\u7d20\uff0c\u4f8b\u5982\u8282\u594f\u3001\u6d41\u6d3e\u548c\u4e50\u5668\u3002\u6b65\u9aa43\uff1a\u6839\u636e\u4e4b\u524d\u7684\u731c\u6d4b\u4f7f\u7528\u6392\u9664\u6cd5\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u8bc6\u522b\u51fa\u4e00\u9996\u5e26\u6709\u5973\u6b4c\u624b\u7684\u6d41\u884c\u6b4c\u66f2\uff0c\u60a8\u53ef\u4ee5\u5c06\u8303\u56f4\u7f29\u5c0f\u5230\u50cf\u4e9a\u8389\u5b89\u5a1c\u00b7\u683c\u5170\u5fb7\uff08Ariana Grande\uff09\u6216\u6cf0\u52d2\u00b7\u65af\u5a01\u592b\u7279\uff08Taylor Swift\uff09\u8fd9\u6837\u7684\u827a\u672f\u5bb6\u3002"}, {"question": "\u5bf9\u4e8e\u9ad8\u7ea7\u73a9\u5bb6\u800c\u8a00\uff0cHeardle\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "Heardle\u7684\u8bc4\u5206\u7cfb\u7edf\u6839\u636e\u73a9\u5bb6\u731c\u6d4b\u6b4c\u66f2\u7684\u901f\u5ea6\u548c\u51c6\u786e\u6027\u6765\u5956\u52b1\u73a9\u5bb6\u3002\u6b63\u786e\u7684\u731c\u6d4b\u5c06\u83b7\u5f97\u79ef\u5206\uff0c\u5c1d\u8bd5\u6b21\u6570\u8d8a\u5c11\uff0c\u79ef\u5206\u8d8a\u9ad8\u3002\u4f8b\u5982\uff0c\u7b2c\u4e00\u6b21\u731c\u6d4b\u6b4c\u66f2\u5c06\u83b7\u5f97\u6700\u9ad8\u5206\uff0c\u800c\u7b2c\u516d\u6b21\u731c\u6d4b\u5c06\u83b7\u5f97\u8f83\u4f4e\u7684\u5206\u6570\u3002\u8be5\u7cfb\u7edf\u9f13\u52b1\u73a9\u5bb6\u63d0\u9ad8\u4ed6\u4eec\u7684\u8046\u542c\u548c\u731c\u6d4b\u6280\u80fd\u3002"}, {"question": "Heardle\u7684\u6b4c\u66f2\u9009\u62e9\u7b97\u6cd5\u80cc\u540e\u7684\u5173\u952e\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "Heardle\u7684\u6b4c\u66f2\u9009\u62e9\u7b97\u6cd5\u7ed3\u5408\u4e86\u6d41\u884c\u5ea6\u3001\u6d41\u6d3e\u591a\u6837\u6027\u548c\u7528\u6237\u53c2\u4e0e\u5ea6\u6570\u636e\u6765\u9009\u62e9\u6b4c\u66f2\u3002\u4f8b\u5982\uff0c\u5b83\u53ef\u80fd\u4f1a\u9009\u62e9\u4e00\u4e9b\u70ed\u95e8\u6b4c\u66f2\u548c\u7ecf\u5178\u6b4c\u66f2\u7684\u6df7\u5408\uff0c\u4ee5\u5438\u5f15\u5e7f\u6cdb\u7684\u53d7\u4f17\u3002\u8be5\u7b97\u6cd5\u786e\u4fdd\u6bcf\u4e2a\u6e38\u620f\u73af\u8282\u90fd\u662f\u72ec\u7279\u7684\u548c\u5177\u6709\u6311\u6218\u6027\u7684\uff0c\u5e76\u8ba9\u73a9\u5bb6\u4fdd\u6301\u53c2\u4e0e\u5ea6\u3002"}, {"question": "Heardle\u5982\u4f55\u786e\u4fdd\u5728\u4e0d\u540c\u97f3\u4e50\u6d41\u6d3e\u4e2d\u516c\u5e73\u5bf9\u51b3\uff1f", "answer": "Heardle\u901a\u8fc7\u5e73\u8861\u5404\u79cd\u6d41\u6d3e\u548c\u65f6\u4ee3\u6b4c\u66f2\u7684\u9009\u62e9\u6765\u786e\u4fdd\u516c\u5e73\u5bf9\u51b3\u3002\u8fd9\u79cd\u65b9\u6cd5\u907f\u514d\u4e86\u5bf9\u4efb\u4f55\u7279\u5b9a\u7c7b\u578b\u97f3\u4e50\u7684\u504f\u89c1\u3002\u4f8b\u5982\uff0c\u4e00\u6b21\u6e38\u620f\u73af\u8282\u53ef\u80fd\u5305\u62ec\u4e00\u9996\u6d41\u884c\u6b4c\u66f2\u3001\u4e00\u9996\u6447\u6eda\u7ecf\u5178\u6b4c\u66f2\u548c\u4e00\u9996\u7235\u58eb\u6807\u51c6\u6b4c\u66f2\uff0c\u4e3a\u6240\u6709\u73a9\u5bb6\u63d0\u4f9b\u591a\u6837\u5316\u548c\u516c\u5e73\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5728\u591a\u53f0\u8bbe\u5907\u4e0a\u540c\u6b65\u6211\u7684Heardle\u6e38\u620f\u8fdb\u5ea6\u5417\uff1f", "answer": "\u662f\u7684\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u5728\u6bcf\u53f0\u8bbe\u5907\u4e0a\u767b\u5f55\u540c\u4e00\u5e10\u6237\u6765\u8de8\u591a\u53f0\u8bbe\u5907\u540c\u6b65\u60a8\u7684Heardle\u6e38\u620f\u8fdb\u5ea6\u3002\u6b64\u529f\u80fd\u5141\u8bb8\u60a8\u65e0\u7f1d\u5730\u7ee7\u7eed\u6e38\u620f\uff0c\u65e0\u8bba\u60a8\u662f\u5728\u667a\u80fd\u624b\u673a\u3001\u5e73\u677f\u7535\u8111\u8fd8\u662f\u7535\u8111\u4e0a\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u624b\u673a\u4e0a\u5f00\u59cb\u6e38\u620f\uff0c\u5219\u53ef\u4ee5\u5728\u7b14\u8bb0\u672c\u7535\u8111\u4e0a\u5b8c\u6210\u6e38\u620f\uff0c\u800c\u4e0d\u4f1a\u4e22\u5931\u8fdb\u5ea6\u3002"}, {"question": "Heardle\u6e38\u620f\u4e2d\u6709\u4efb\u4f55\u9690\u85cf\u7684\u529f\u80fd\u6216\u5f69\u86cb\u5417\uff1f", "answer": "Heardle\u6e38\u620f\u4e2d\u5305\u542b\u9690\u85cf\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u4ee5\u589e\u5f3a\u6e38\u620f\u4f53\u9a8c\u3002\u4f8b\u5982\uff0c\u7b2c\u4e00\u6b21\u731c\u5bf9\u6b4c\u66f2\u53ef\u80fd\u4f1a\u89e3\u9501\u7279\u6b8a\u7684\u52a8\u753b\u6216\u97f3\u6548\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u6b4c\u66f2\u53ef\u80fd\u4f1a\u89e6\u53d1\u72ec\u7279\u7684\u89c6\u89c9\u6216\u542c\u89c9\u63d0\u793a\uff0c\u4e3a\u53d1\u73b0\u5b83\u4eec\u7684\u73a9\u5bb6\u589e\u6dfb\u989d\u5916\u7684\u5174\u594b\u3002"}]
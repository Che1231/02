[{"question": "\u958b\u59cb\u5728Grindcraft\u904a\u6232\u4e2d\u4f5c\u70ba\u65b0\u624b\u9032\u884c\u88fd\u4f5c\u5de5\u4f5c\u7684\u65b9\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "\u8981\u958b\u59cb\u5728Grindcraft\u4e2d\u9032\u884c\u88fd\u4f5c\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u9ede\u64ca\u300c\u88fd\u4f5c\u300d\u6309\u9215\u958b\u555f\u88fd\u4f5c\u9078\u55ae\u3002\u6b65\u9a5f2 - \u5f9e\u6e05\u55ae\u4e2d\u9078\u64c7\u57fa\u672c\u7269\u54c1\uff0c\u4f8b\u5982\u300c\u6728\u68cd\u300d\u3002\u6b65\u9a5f3 - \u9ede\u64ca\u6a39\u6728\u6536\u96c6\u6240\u9700\u6750\u6599\uff0c\u4f8b\u5982\u300c\u6728\u6750\u300d\u3002\u4f8b\u5982\uff0c\u88fd\u4f5c\u300c\u6728\u68cd\u300d\u9700\u89812\u584a\u300c\u6728\u6750\u300d\u3002\u9019\u5c07\u4f7f\u4f60\u719f\u6089\u904a\u6232\u7684\u6838\u5fc3\u6a5f\u5236\u3002"}, {"question": "\u5728Grindcraft\u904a\u6232\u4e2d\u73a9\u4e86100\u5c0f\u6642\u5f8c\uff0c\u5982\u4f55\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u8cc7\u6e90\u6548\u7387\uff1f", "answer": "\u8981\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8Grindcraft\u4e2d\u7684\u8cc7\u6e90\u6548\u7387\uff0c\u8acb\u8003\u616e\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9a5f1 - \u901a\u904e\u88fd\u4f5c\u300c\u81ea\u52d5\u9ede\u64ca\u5668\u300d\u81ea\u52d5\u6536\u96c6\u8cc7\u6e90\u3002\u6b65\u9a5f2 - \u5347\u7d1a\u4f60\u7684\u5de5\u5177\u5230\u9ad8\u7d1a\u5225\uff0c\u4f8b\u5982\u300c\u9435\u93ac\u300d\uff0c\u4ee5\u63d0\u9ad8\u7522\u91cf\u3002\u6b65\u9a5f3 - \u5e73\u8861\u6536\u96c6\u548c\u88fd\u4f5c\u6642\u9593\uff0c\u4ee5\u512a\u5316\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u300c\u9435\u93ac\u300d\u6536\u96c6\u300c\u77f3\u982d\u300d\u7684\u6578\u91cf\u662f\u300c\u6728\u93ac\u300d\u7684\u5169\u500d\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u5728Grindcraft\u904a\u6232\u4e2d\u7406\u89e3\u88fd\u4f5c\u6a39\u5716\u5f88\u91cd\u8981\uff1f", "answer": "\u5728Grindcraft\u4e2d\u7406\u89e3\u88fd\u4f5c\u6a39\u5716\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u5141\u8a31\u4f60\u6709\u6548\u5730\u898f\u5283\u8cc7\u6e90\u5206\u914d\u3002\u88fd\u4f5c\u6a39\u5716\u986f\u793a\u4e86\u7269\u54c1\u4e4b\u9593\u7684\u4f9d\u8cf4\u95dc\u4fc2\uff0c\u5e6b\u52a9\u4f60\u512a\u5148\u6c7a\u5b9a\u8981\u88fd\u4f5c\u54ea\u4e9b\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u88fd\u4f5c\u300c\u7194\u7210\u300d\u9700\u8981\u300c\u77f3\u982d\u300d\u548c\u300c\u7164\u70ad\u300d\uff0c\u800c\u9019\u4e9b\u53c8\u9700\u8981\u5c07\u300c\u9435\u7926\u77f3\u300d\u7194\u7149\u6210\u300c\u9435\u9320\u300d\u3002\u9019\u9805\u77e5\u8b58\u78ba\u4fdd\u4f60\u4e0d\u6703\u6d6a\u8cbb\u8cc7\u6e90\u5728\u4e0d\u592a\u91cd\u8981\u7684\u7269\u54c1\u4e0a\u3002"}, {"question": "Grindcraft\u904a\u6232\u4e2d\u7684\u9032\u5ea6\u7cfb\u7d71\u5982\u4f55\u734e\u52f5\u9577\u671f\u73a9\u5bb6\uff1f", "answer": "Grindcraft\u904a\u6232\u4e2d\u7684\u9032\u5ea6\u7cfb\u7d71\u901a\u904e\u5f15\u5165\u8d8a\u4f86\u8d8a\u8907\u96dc\u548c\u6709\u734e\u52f5\u7684\u88fd\u4f5c\u93c8\u4f86\u734e\u52f5\u9577\u671f\u73a9\u5bb6\u3002\u96a8\u8457\u4f60\u7684\u9032\u6b65\uff0c\u4f60\u5c07\u89e3\u9396\u9ad8\u7d1a\u5225\u7684\u7269\u54c1\u548c\u5de5\u5177\uff0c\u986f\u8457\u63d0\u9ad8\u4f60\u7684\u6548\u7387\u3002\u4f8b\u5982\uff0c\u88fd\u4f5c\u300c\u947d\u77f3\u93ac\u300d\u4e0d\u50c5\u53ef\u4ee5\u63d0\u9ad8\u4f60\u7684\u63a1\u7926\u901f\u5ea6\uff0c\u9084\u53ef\u4ee5\u8b93\u4f60\u6536\u96c6\u7a00\u6709\u8cc7\u6e90\uff0c\u4f8b\u5982\u300c\u947d\u77f3\u300d\u3002\u9019\u500b\u7cfb\u7d71\u78ba\u4fdd\u4e86\u96a8\u8457\u4f60\u7684\u9032\u5ea6\uff0c\u6301\u7e8c\u7684\u53c3\u8207\u5ea6\u548c\u6eff\u610f\u5ea6\u3002"}, {"question": "\u5728Grindcraft\u904a\u6232\u4e2d\uff0c\u70ba\u4e86\u589e\u5f37\u6211\u7684\u904a\u6232\u9ad4\u9a57\uff0c\u6211\u61c9\u8a72\u512a\u5148\u88fd\u4f5c\u54ea\u4e9b\u5de5\u5177\uff1f", "answer": "\u5728Grindcraft\u904a\u6232\u4e2d\uff0c\u61c9\u512a\u5148\u88fd\u4f5c\u63d0\u4f9b\u6700\u5927\u6548\u7387\u63d0\u5347\u7684\u5de5\u5177\u3002\u5f9e\u57fa\u672c\u5de5\u5177\u958b\u59cb\uff0c\u4f8b\u5982\u300c\u6728\u93ac\u300d\u548c\u300c\u6728\u65a7\u300d\uff0c\u7136\u5f8c\u518d\u88fd\u4f5c\u300c\u9435\u93ac\u300d\u548c\u300c\u9435\u65a7\u300d\u3002\u4f8b\u5982\uff0c\u300c\u9435\u93ac\u300d\u6bd4\u300c\u6728\u93ac\u300d\u7684\u63a1\u7926\u901f\u5ea6\u5feb\u5169\u500d\u3002\u9019\u7a2e\u512a\u5148\u9806\u5e8f\u78ba\u4fdd\u4f60\u66f4\u5feb\u5730\u6536\u96c6\u8cc7\u6e90\uff0c\u8b93\u4f60\u66f4\u5feb\u5730\u88fd\u4f5c\u66f4\u9ad8\u7d1a\u7684\u7269\u54c1\u3002"}, {"question": "\u5728Grindcraft\u904a\u6232\u4e2d\uff0c\u624b\u52d5\u88fd\u4f5c\u548c\u81ea\u52d5\u5316\u88fd\u4f5c\u6709\u4ec0\u9ebc\u95dc\u9375\u5340\u5225\uff1f", "answer": "Grindcraft\u904a\u6232\u4e2d\u7684\u624b\u52d5\u88fd\u4f5c\u9700\u8981\u9ede\u64ca\u6536\u96c6\u8cc7\u6e90\u548c\u500b\u5225\u88fd\u4f5c\u7269\u54c1\uff0c\u9019\u5f88\u8017\u6642\u3002\u81ea\u52d5\u88fd\u4f5c\uff0c\u901a\u904e\u50cf\u300c\u81ea\u52d5\u9ede\u64ca\u5668\u300d\u9019\u6a23\u7684\u7269\u54c1\u5be6\u73fe\uff0c\u5141\u8a31\u4f60\u6536\u96c6\u8cc7\u6e90\u548c\u88fd\u4f5c\u7269\u54c1\uff0c\u800c\u7121\u9700\u6301\u7e8c\u8f38\u5165\u3002\u4f8b\u5982\uff0c\u300c\u81ea\u52d5\u9ede\u64ca\u5668\u300d\u53ef\u4ee5\u6301\u7e8c\u6536\u96c6\u300c\u6728\u6750\u300d\uff0c\u800c\u4f60\u53ef\u4ee5\u5c08\u6ce8\u65bc\u88fd\u4f5c\u66f4\u8907\u96dc\u7684\u7269\u54c1\u3002\u81ea\u52d5\u5316\u986f\u8457\u63d0\u9ad8\u4f60\u7684\u6548\u7387\u548c\u9032\u5ea6\u901f\u5ea6\u3002"}, {"question": "\u5982\u4f55\u5728Grindcraft\u904a\u6232\u4e2d\u5c07\u6211\u7684\u904a\u6232\u9032\u5ea6\u5f9e\u4e00\u500b\u8a2d\u5099\u9077\u79fb\u5230\u53e6\u4e00\u500b\u8a2d\u5099\uff1f", "answer": "\u8981\u9077\u79fb\u4f60\u7684Grindcraft\u904a\u6232\u9032\u5ea6\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u5728\u7576\u524d\u8a2d\u5099\u4e0a\uff0c\u524d\u5f80\u8a2d\u5b9a\u9078\u55ae\u4e26\u9078\u64c7\u300c\u532f\u51fa\u5132\u5b58\u6a94\u300d\u3002\u6b65\u9a5f2 - \u8907\u88fd\u751f\u6210\u7684\u5132\u5b58\u6a94\u4ee3\u78bc\u3002\u6b65\u9a5f3 - \u5728\u4f60\u7684\u65b0\u8a2d\u5099\u4e0a\uff0c\u6253\u958bGrindcraft\uff0c\u524d\u5f80\u8a2d\u5b9a\uff0c\u4e26\u9078\u64c7\u300c\u5c0e\u5165\u5132\u5b58\u6a94\u300d\u3002\u8cbc\u4e0a\u5132\u5b58\u6a94\u4ee3\u78bc\u4ee5\u8f49\u79fb\u4f60\u7684\u9032\u5ea6\u3002\u9019\u78ba\u4fdd\u4f60\u53ef\u4ee5\u5728\u4e0d\u540c\u7684\u8a2d\u5099\u4e0a\u9806\u5229\u7e7c\u7e8c\u4f60\u7684\u904a\u6232\u3002"}, {"question": "\u901a\u904e\u63a2\u7d22\uff0c\u53ef\u4ee5\u5728Grindcraft\u904a\u6232\u4e2d\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u5167\u5bb9\uff1f", "answer": "Grindcraft\u904a\u6232\u4e2d\u5305\u542b\u53ef\u901a\u904e\u63a2\u7d22\u548c\u5be6\u9a57\u767c\u73fe\u7684\u96b1\u85cf\u5167\u5bb9\u3002\u4f8b\u5982\uff0c\u88fd\u4f5c\u300c\u795e\u79d8\u6587\u7269\u300d\u9700\u8981\u7a00\u6709\u6750\u6599\uff0c\u4f8b\u5982\u300c\u9ec3\u91d1\u300d\u548c\u300c\u947d\u77f3\u300d\uff0c\u9019\u4e9b\u4e26\u975e\u7acb\u5373\u53ef\u898b\u3002\u767c\u73fe\u9019\u4e9b\u7269\u54c1\u901a\u5e38\u6703\u5e36\u4f86\u7368\u7279\u7684\u734e\u52f5\uff0c\u6216\u89e3\u9396\u65b0\u7684\u88fd\u4f5c\u53ef\u80fd\u6027\uff0c\u70ba\u904a\u6232\u589e\u6dfb\u9a5a\u559c\u548c\u6df1\u5ea6\u3002"}, {"question": "Grindcraft\u904a\u6232\u4e2d\u7684\u8cc7\u6e90\u7a00\u6709\u5ea6\u7cfb\u7d71\u5982\u4f55\u5f71\u97ff\u88fd\u4f5c\u6c7a\u7b56\uff1f", "answer": "Grindcraft\u904a\u6232\u4e2d\u7684\u8cc7\u6e90\u7a00\u6709\u5ea6\u7cfb\u7d71\u6703\u5f71\u97ff\u88fd\u4f5c\u6c7a\u7b56\uff0c\u56e0\u70ba\u67d0\u4e9b\u6750\u6599\u96e3\u4ee5\u7372\u5f97\uff0c\u56e0\u6b64\u66f4\u6709\u50f9\u503c\u3002\u4f8b\u5982\uff0c\u300c\u947d\u77f3\u300d\u6bd4\u300c\u77f3\u982d\u300d\u66f4\u7a00\u6709\uff0c\u4e26\u4e14\u662f\u9ad8\u7d1a\u5de5\u5177\u6240\u9700\u8981\u7684\u6750\u6599\u3002\u9019\u7a2e\u7a00\u6709\u6027\u610f\u5473\u8457\u4f60\u61c9\u8a72\u512a\u5148\u6536\u96c6\u548c\u4fdd\u5b58\u7a00\u6709\u8cc7\u6e90\uff0c\u4ee5\u9032\u884c\u5fc5\u8981\u7684\u88fd\u4f5c\uff0c\u78ba\u4fdd\u4f60\u4e0d\u5c07\u5176\u6d6a\u8cbb\u5728\u5f71\u97ff\u529b\u8f03\u5c0f\u7684\u7269\u54c1\u4e0a\u3002"}, {"question": "\u5728Grindcraft\u904a\u6232\u4e2d\uff0c\u6709\u6548\u7ba1\u7406\u7269\u54c1\u6b04\u7a7a\u9593\u7684\u6700\u4f73\u65b9\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "\u70ba\u4e86\u6709\u6548\u5730\u7ba1\u7406Grindcraft\u904a\u6232\u4e2d\u7684\u7269\u54c1\u6b04\u7a7a\u9593\uff0c\u8acb\u8003\u616e\u4ee5\u4e0b\u6280\u5de7\uff1a\u6b65\u9a5f1 - \u5b9a\u671f\u88fd\u4f5c\u7269\u54c1\u4ee5\u9a30\u51fa\u7a7a\u9593\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u5132\u5b58\u7269\u54c1\uff0c\u4f8b\u5982\u300c\u7bb1\u5b50\u300d\uff0c\u4f86\u5132\u5b58\u591a\u9918\u7684\u8cc7\u6e90\u3002\u6b65\u9a5f3 - \u512a\u5148\u4fdd\u7559\u9ad8\u50f9\u503c\u6216\u7a00\u6709\u6750\u6599\u3002\u4f8b\u5982\uff0c\u5c07\u300c\u9435\u9320\u300d\u5132\u5b58\u5230\u300c\u7bb1\u5b50\u300d\u4e2d\uff0c\u8b93\u4f60\u7684\u4e3b\u8981\u7269\u54c1\u6b04\u4fdd\u6301\u6e05\u6670\uff0c\u7528\u65bc\u7a4d\u6975\u7684\u88fd\u4f5c\uff0c\u78ba\u4fdd\u4f60\u80fd\u6536\u96c6\u548c\u88fd\u4f5c\u7269\u54c1\uff0c\u800c\u7121\u9700\u6301\u7e8c\u7ba1\u7406\u7269\u54c1\u6b04\u3002"}]
[{"question": "\ucd08\uc2ec\uc790\uac00 Grindcraft\uc5d0\uc11c \uc81c\uc791\uc744 \uc2dc\uc791\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Grindcraft\uc5d0\uc11c \uc81c\uc791\uc744 \uc2dc\uc791\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. STEP1 - '\uc81c\uc791' \ubc84\ud2bc\uc744 \ud074\ub9ad\ud558\uc5ec \uc81c\uc791 \uba54\ub274\ub97c \uc5fd\ub2c8\ub2e4. STEP2 - \ubaa9\ub85d\uc5d0\uc11c '\ub098\ubb34 \ub9c9\ub300\uae30'\uc640 \uac19\uc740 \uae30\ubcf8 \uc544\uc774\ud15c\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. STEP3 - \ub098\ubb34\uc5d0 \ud074\ub9ad\ud558\uc5ec '\ub098\ubb34'\uc640 \uac19\uc740 \ud544\uc694\ud55c \uc7ac\ub8cc\ub97c \ubaa8\uc73c\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\ub098\ubb34 \ub9c9\ub300\uae30'\ub97c \uc81c\uc791\ud558\ub824\uba74 '\ub098\ubb34' 2\uac1c\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \uc774\ub294 \uac8c\uc784\uc758 \ud575\uc2ec \uba54\ucee4\ub2c8\uc998\uc744 \uc18c\uac1c\ud574 \uc904 \uac83\uc785\ub2c8\ub2e4."}, {"question": "Grindcraft\uc5d0\uc11c 100\uc2dc\uac04 \ud50c\ub808\uc774 \ud6c4 \uc790\uc6d0 \ud6a8\uc728\uc744 \uadf9\ub300\ud654\ud558\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Grindcraft\uc5d0\uc11c \uc790\uc6d0 \ud6a8\uc728\uc744 \uadf9\ub300\ud654\ud558\ub824\uba74 \ub2e4\uc74c \uc804\ub7b5\uc744 \uace0\ub824\ud558\uc2ed\uc2dc\uc624. STEP1 - '\uc790\ub3d9 \ud074\ub9ad\uae30'\ub97c \uc81c\uc791\ud558\uc5ec \uc790\uc6d0 \uc218\uc9d1\uc744 \uc790\ub3d9\ud654\ud569\ub2c8\ub2e4. STEP2 - '\ucca0 \uace1\uad2d\uc774'\uc640 \uac19\uc774 \ub3c4\uad6c\ub97c \uace0\uae09 \ub2e8\uacc4\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc5ec \uc218\ud655\ub7c9\uc744 \ub192\uc785\ub2c8\ub2e4. STEP3 - \uc9c4\ud589 \uc0c1\ud669\uc744 \ucd5c\uc801\ud654\ud558\uae30 \uc704\ud574 \uc218\uc9d1\uacfc \uc81c\uc791 \uc0ac\uc774\uc758 \uc2dc\uac04\uc744 \uade0\ud615 \uc788\uac8c \ub9de\ucda5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ucca0 \uace1\uad2d\uc774'\ub97c \uc0ac\uc6a9\ud558\uba74 '\ub098\ubb34 \uace1\uad2d\uc774'\uc5d0 \ube44\ud574 '\ub3cc'\uc744 \ub450 \ubc30 \ub354 \ub9ce\uc774 \uc218\uc9d1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Grindcraft\uc5d0\uc11c \uc81c\uc791 \ud2b8\ub9ac\ub97c \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Grindcraft\uc5d0\uc11c \uc81c\uc791 \ud2b8\ub9ac\ub97c \uc774\ud574\ud558\ub294 \uac83\uc740 \uc911\uc694\ud569\ub2c8\ub2e4. \uc81c\uc791 \ud2b8\ub9ac\ub294 \uc544\uc774\ud15c \uac04\uc758 \uc885\uc18d\uc131\uc744 \ubcf4\uc5ec\uc8fc\uace0, \uc5b4\ub5a4 \uc544\uc774\ud15c\uc744 \uba3c\uc800 \uc81c\uc791\ud574\uc57c \ud560\uc9c0 \uc6b0\uc120\uc21c\uc704\ub97c \uc815\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc6a9\uad11\ub85c'\ub97c \uc81c\uc791\ud558\ub824\uba74 '\ub3cc'\uacfc '\uc22f'\uc774 \ud544\uc694\ud558\uace0, \uc774\ub294 '\ucca0\uad11\uc11d'\uc744 '\ucca0\uad34'\ub85c \uc81c\ub828\ud558\ub294 \ub370 \ud544\uc694\ud569\ub2c8\ub2e4. \uc774 \uc9c0\uc2dd\uc744 \ud1b5\ud574 \ub35c \uc911\uc694\ud55c \uc544\uc774\ud15c\uc5d0 \uc790\uc6d0\uc744 \ub0ad\ube44\ud558\uc9c0 \uc54a\ub3c4\ub85d \ud569\ub2c8\ub2e4."}, {"question": "Grindcraft\uc758 \uc9c4\ud589 \uc2dc\uc2a4\ud15c\uc740 \uc7a5\uae30 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc5b4\ub5a4 \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud569\ub2c8\uae4c?", "answer": "Grindcraft\uc758 \uc9c4\ud589 \uc2dc\uc2a4\ud15c\uc740 \uc7a5\uae30 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc810\uc810 \ub354 \ubcf5\uc7a1\ud558\uace0 \ubcf4\ub78c \uc788\ub294 \uc81c\uc791 \uccb4\uc778\uc744 \ub3c4\uc785\ud558\uc5ec \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc9c4\ud589\ud568\uc5d0 \ub530\ub77c \uace0\uae09 \uc544\uc774\ud15c\uacfc \ub3c4\uad6c\ub97c \uc7a0\uae08 \ud574\uc81c\ud558\uc5ec \ud6a8\uc728\uc131\uc744 \ud06c\uac8c \ub192\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub2e4\uc774\uc544\ubaac\ub4dc \uace1\uad2d\uc774'\ub97c \uc81c\uc791\ud558\uba74 \uad11\uc18d\ub3c4\uac00 \ube68\ub77c\uc9c8 \ubfd0\ub9cc \uc544\ub2c8\ub77c '\ub2e4\uc774\uc544\ubaac\ub4dc'\uc640 \uac19\uc740 \ud76c\uadc0 \uc790\uc6d0\uc744 \uc218\uc9d1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \uc9c4\ud589\ud558\uba74\uc11c \uc9c0\uc18d\uc801\uc778 \ucc38\uc5ec\uc640 \ub9cc\uc871\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "Grindcraft\uc5d0\uc11c \ud50c\ub808\uc774\ub97c \uac1c\uc120\ud558\uae30 \uc704\ud574 \uc5b4\ub5a4 \ub3c4\uad6c\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \uc81c\uc791\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "Grindcraft\uc5d0\uc11c \uac00\uc7a5 \ud070 \ud6a8\uc728 \ud5a5\uc0c1\uc744 \uc81c\uacf5\ud558\ub294 \ub3c4\uad6c\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \uc81c\uc791\ud558\uc2ed\uc2dc\uc624. '\ub098\ubb34 \uace1\uad2d\uc774'\uc640 '\ub098\ubb34 \ub3c4\ub07c'\uc640 \uac19\uc740 \uae30\ubcf8 \ub3c4\uad6c\ub85c \uc2dc\uc791\ud55c \ub2e4\uc74c '\ucca0 \uace1\uad2d\uc774'\uc640 '\ucca0 \ub3c4\ub07c'\ub85c \uc774\ub3d9\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\ucca0 \uace1\uad2d\uc774'\ub294 '\ub098\ubb34 \uace1\uad2d\uc774'\ubcf4\ub2e4 '\ub3cc'\uc744 \ub450 \ubc30 \ube60\ub974\uac8c \ucc44\uad74\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc6b0\uc120\uc21c\uc704\ub97c \ud1b5\ud574 \uc790\uc6d0\uc744 \ub354 \ube68\ub9ac \uc218\uc9d1\ud558\uace0, \ub354 \uace0\uae09 \uc544\uc774\ud15c\uc744 \ub354 \ube68\ub9ac \uc81c\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Grindcraft\uc5d0\uc11c \uc218\ub3d9 \uc81c\uc791\uacfc \uc790\ub3d9 \uc81c\uc791\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Grindcraft\uc5d0\uc11c \uc218\ub3d9 \uc81c\uc791\uc740 \uc790\uc6d0\uc744 \uc218\uc9d1\ud558\uace0 \uac1c\ubcc4\uc801\uc73c\ub85c \uc544\uc774\ud15c\uc744 \uc81c\uc791\ud558\ub294 \ub370 \uc2dc\uac04\uc774 \ub9ce\uc774 \uac78\ub9ac\ub294 \uacfc\uc815\uc785\ub2c8\ub2e4. '\uc790\ub3d9 \ud074\ub9ad\uae30'\uc640 \uac19\uc740 \uc544\uc774\ud15c\uc744 \ud1b5\ud574 \ub2ec\uc131\ub418\ub294 \uc790\ub3d9 \uc81c\uc791\uc740 \uc9c0\uc18d\uc801\uc778 \uc870\uc791 \uc5c6\uc774\ub3c4 \uc790\uc6d0\uc744 \uc218\uc9d1\ud558\uace0 \uc544\uc774\ud15c\uc744 \uc81c\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc790\ub3d9 \ud074\ub9ad\uae30'\ub294 '\ub098\ubb34'\ub97c \uc9c0\uc18d\uc801\uc73c\ub85c \uc218\uc9d1\ud558\ub294 \ub3d9\uc548 \ub354 \ubcf5\uc7a1\ud55c \uc544\uc774\ud15c\uc744 \uc81c\uc791\ud558\ub294 \ub370 \uc9d1\uc911\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc790\ub3d9\ud654\ub294 \ud6a8\uc728\uc131\uacfc \uc9c4\ud589 \uc18d\ub3c4\ub97c \ud06c\uac8c \ub192\uc785\ub2c8\ub2e4."}, {"question": "Grindcraft\uc5d0\uc11c \ud55c \uae30\uae30\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Grindcraft\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. STEP1 - \ud604\uc7ac \uae30\uae30\uc5d0\uc11c \uc124\uc815 \uba54\ub274\ub85c \uc774\ub3d9\ud558\uc5ec '\uc800\uc7a5 \ub0b4\ubcf4\ub0b4\uae30'\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. STEP2 - \uc0dd\uc131\ub41c \uc800\uc7a5 \ucf54\ub4dc\ub97c \ubcf5\uc0ac\ud569\ub2c8\ub2e4. STEP3 - \uc0c8 \uae30\uae30\uc5d0\uc11c Grindcraft\ub97c \uc5f4\uace0 \uc124\uc815\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec '\uc800\uc7a5 \uac00\uc838\uc624\uae30'\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc800\uc7a5 \ucf54\ub4dc\ub97c \ubd99\uc5ec\ub123\uc5b4 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud569\ub2c8\ub2e4. \uc774\ub97c \ud1b5\ud574 \uae30\uae30\uac04 \uc6d0\ud65c\ud558\uac8c \uac8c\uc784\uc744 \uc774\uc5b4\uac08 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud0d0\ud5d8\uc744 \ud1b5\ud574 Grindcraft\uc5d0\uc11c \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Grindcraft\uc5d0\ub294 \ud0d0\ud5d8\uacfc \uc2e4\ud5d8\uc744 \ud1b5\ud574 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc2e0\ube44\ud55c \uc720\ubb3c'\uc744 \uc81c\uc791\ud558\ub824\uba74 '\uae08'\uc774\ub098 '\ub2e4\uc774\uc544\ubaac\ub4dc'\uc640 \uac19\uc740 \ud76c\uadc0 \uc790\uc6d0\uc774 \ud544\uc694\ud558\uba70, \uc774\ub7ec\ud55c \uc790\uc6d0\uc774 \uc989\uc2dc \ub208\uc5d0 \ub744\uc9c0\ub294 \uc54a\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc544\uc774\ud15c\uc744 \ubc1c\uacac\ud558\ub294 \uac83\uc740 \uc885\uc885 \uace0\uc720\ud55c \ubcf4\uc0c1\uc774\ub098 \uc0c8\ub85c\uc6b4 \uc81c\uc791 \uac00\ub2a5\uc131\uc744 \uc5f4\uc5b4 \uac8c\uc784\uc5d0 \ub180\ub77c\uc6c0\uacfc \uae4a\uc774\ub97c \ub354\ud569\ub2c8\ub2e4."}, {"question": "Grindcraft\uc758 \uc790\uc6d0 \ud76c\uadc0\ub3c4 \uc2dc\uc2a4\ud15c\uc740 \uc81c\uc791 \uacb0\uc815\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "Grindcraft\uc758 \uc790\uc6d0 \ud76c\uadc0\ub3c4 \uc2dc\uc2a4\ud15c\uc740 \ud2b9\uc815 \uc790\uc6d0\uc744 \uc5bb\uae30 \uc5b4\ub835\uac8c \ub9cc\ub4e4\uc5b4 \uadf8 \uac00\uce58\ub97c \ub192\uc784\uc73c\ub85c\uc368 \uc81c\uc791 \uacb0\uc815\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub2e4\uc774\uc544\ubaac\ub4dc'\ub294 '\ub3cc'\ubcf4\ub2e4 \ud76c\uadc0\ud558\uba70 \uace0\uae09 \ub3c4\uad6c\uc5d0 \ud544\uc694\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud76c\uadc0\uc131\uc73c\ub85c \uc778\ud574 \uc911\uc694\ud55c \uc81c\uc791\uc5d0 \ud544\uc694\ud55c \ud76c\uadc0 \uc790\uc6d0\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uc218\uc9d1\ud558\uace0 \ubcf4\uc874\ud574\uc57c \ud558\uba70, \ub35c \uc911\uc694\ud55c \uc544\uc774\ud15c\uc5d0 \ub0ad\ube44\ud558\uc9c0 \uc54a\ub3c4\ub85d \ud569\ub2c8\ub2e4."}, {"question": "Grindcraft\uc5d0\uc11c \uc778\ubca4\ud1a0\ub9ac \uacf5\uac04\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Grindcraft\uc5d0\uc11c \uc778\ubca4\ud1a0\ub9ac \uacf5\uac04\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub824\uba74 \ub2e4\uc74c \ud301\uc744 \uace0\ub824\ud558\uc2ed\uc2dc\uc624. STEP1 - \uc815\uae30\uc801\uc73c\ub85c \uc544\uc774\ud15c\uc744 \uc81c\uc791\ud558\uc5ec \uacf5\uac04\uc744 \ud655\ubcf4\ud569\ub2c8\ub2e4. STEP2 - '\uc0c1\uc790'\uc640 \uac19\uc740 \uc800\uc7a5 \uc544\uc774\ud15c\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc5ec\ubd84\uc758 \uc790\uc6d0\uc744 \ubcf4\uad00\ud569\ub2c8\ub2e4. STEP3 - \uace0\uac00 \ub610\ub294 \ud76c\uadc0\ud55c \uc790\uc6d0\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \ubcf4\uad00\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ucca0\uad34'\ub97c '\uc0c1\uc790'\uc5d0 \ubcf4\uad00\ud558\uba74 \ud65c\ubc1c\ud55c \uc81c\uc791\uc744 \uc704\ud574 \uc8fc\uc694 \uc778\ubca4\ud1a0\ub9ac\ub97c \uae54\ub054\ud558\uac8c \uc720\uc9c0\ud560 \uc218 \uc788\uace0, \uc9c0\uc18d\uc801\uc778 \uc778\ubca4\ud1a0\ub9ac \uad00\ub9ac \uc5c6\uc774 \uc790\uc6d0\uc744 \uc218\uc9d1\ud558\uace0 \uc81c\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
[{"question": "\u521d\u5fc3\u8005\u304cGrindcraft\u3067\u30af\u30e9\u30d5\u30c8\u3092\u59cb\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Grindcraft\u3067\u30af\u30e9\u30d5\u30c8\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71 - \"\u30af\u30e9\u30d5\u30c8\"\u30dc\u30bf\u30f3\u3092\u30af\u30ea\u30c3\u30af\u3057\u3066\u30af\u30e9\u30d5\u30c8\u30e1\u30cb\u30e5\u30fc\u3092\u958b\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - \u30ea\u30b9\u30c8\u304b\u3089\"\u6728\u306e\u68d2\"\u306e\u3088\u3046\u306a\u57fa\u672c\u7684\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u6728\u3092\u6728\u304b\u3089\u30af\u30ea\u30c3\u30af\u3057\u3066\"\u6728\"\u306a\u3069\u306e\u5fc5\u8981\u306a\u7d20\u6750\u3092\u96c6\u3081\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\"\u6728\u306e\u68d2\"\u3092\u4f5c\u308b\u306b\u306f\u3001\"\u6728\"\u30922\u500b\u5fc5\u8981\u3067\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u30b2\u30fc\u30e0\u306e\u57fa\u672c\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u304c\u7406\u89e3\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d7\u30ec\u30a4\u6642\u9593100\u6642\u9593\u3092\u8d85\u3048\u305fGrindcraft\u3067\u30ea\u30bd\u30fc\u30b9\u52b9\u7387\u3092\u6700\u5927\u5316\u3059\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\uff1f", "answer": "Grindcraft\u3067\u30ea\u30bd\u30fc\u30b9\u52b9\u7387\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u6b21\u306e\u6226\u7565\u3092\u691c\u8a0e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71 - \"\u30aa\u30fc\u30c8\u30af\u30ea\u30c3\u30af\"\u3092\u4f5c\u6210\u3057\u3066\u3001\u30ea\u30bd\u30fc\u30b9\u53ce\u96c6\u3092\u81ea\u52d5\u5316\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - \u30c4\u30fc\u30eb\u3092\u3088\u308a\u9ad8\u30ec\u30d9\u30eb\u306e\u3082\u306e\uff08\u4f8b\u3048\u3070\"\u9244\u306e\u30c4\u30eb\u30cf\u30b7\"\uff09\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u3066\u3001\u53ce\u91cf\u3092\u5897\u3084\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u53ce\u96c6\u3068\u30af\u30e9\u30d5\u30c8\u306e\u6642\u9593\u3092\u30d0\u30e9\u30f3\u30b9\u3055\u305b\u3001\u9032\u6357\u3092\u6700\u9069\u5316\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\"\u9244\u306e\u30c4\u30eb\u30cf\u30b7\"\u3092\u4f7f\u3046\u3053\u3068\u3067\u3001\"\u6728\u306e\u30c4\u30eb\u30cf\u30b7\"\u306b\u6bd4\u3079\u3066\"\u77f3\"\u306e\u53ce\u96c6\u91cf\u304c2\u500d\u306b\u306a\u308a\u307e\u3059\u3002"}, {"question": "Grindcraft\u3067\u30af\u30e9\u30d5\u30c8\u30c4\u30ea\u30fc\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u306a\u305c\u91cd\u8981\u3067\u3059\u304b\uff1f", "answer": "Grindcraft\u3067\u30af\u30e9\u30d5\u30c8\u30c4\u30ea\u30fc\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u306a\u305c\u306a\u3089\u3001\u30ea\u30bd\u30fc\u30b9\u306e\u914d\u5206\u3092\u52b9\u679c\u7684\u306b\u8a08\u753b\u3067\u304d\u308b\u304b\u3089\u3067\u3059\u3002\u30af\u30e9\u30d5\u30c8\u30c4\u30ea\u30fc\u306f\u30a2\u30a4\u30c6\u30e0\u9593\u306e\u4f9d\u5b58\u95a2\u4fc2\u3092\u793a\u3057\u3066\u304a\u308a\u3001\u6700\u521d\u306b\u3069\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u30af\u30e9\u30d5\u30c8\u3059\u308b\u3079\u304d\u304b\u3092\u512a\u5148\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\"\u6eb6\u9271\u7089\"\u3092\u4f5c\u308b\u306b\u306f\u3001\"\u77f3\"\u3068\"\u77f3\u70ad\"\u304c\u5fc5\u8981\u3067\u3001\u3053\u308c\u306f\u5f8c\u7d9a\u306e\"\u9244\u9271\u77f3\"\u3092\"\u9244\u30a4\u30f3\u30b4\u30c3\u30c8\"\u306b\u6eb6\u89e3\u3059\u308b\u305f\u3081\u306b\u5fc5\u8981\u306b\u306a\u308a\u307e\u3059\u3002\u3053\u306e\u77e5\u8b58\u304c\u3042\u308c\u3070\u3001\u3042\u307e\u308a\u91cd\u8981\u306a\u30a2\u30a4\u30c6\u30e0\u306b\u30ea\u30bd\u30fc\u30b9\u3092\u7121\u99c4\u306b\u3059\u308b\u306e\u3092\u907f\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Grindcraft\u306e\u9032\u884c\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u9577\u671f\u9593\u30d7\u30ec\u30a4\u3059\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3069\u306e\u3088\u3046\u306b\u5831\u3044\u308b\u306e\u3067\u3059\u304b\uff1f", "answer": "Grindcraft\u306e\u9032\u884c\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u9577\u671f\u9593\u30d7\u30ec\u30a4\u3059\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3001\u3088\u308a\u8907\u96d1\u3067\u5831\u916c\u306e\u9ad8\u3044\u30af\u30e9\u30d5\u30c8\u30c1\u30a7\u30fc\u30f3\u3092\u63d0\u4f9b\u3059\u308b\u3053\u3068\u3067\u5831\u3044\u307e\u3059\u3002\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u3059\u308b\u306b\u3064\u308c\u3066\u3001\u52b9\u7387\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u9ad8\u30ec\u30d9\u30eb\u306e\u30a2\u30a4\u30c6\u30e0\u3084\u30c4\u30fc\u30eb\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\"\u30c0\u30a4\u30a2\u30e2\u30f3\u30c9\u306e\u30c4\u30eb\u30cf\u30b7\"\u3092\u4f5c\u308b\u3053\u3068\u3067\u3001\u63a1\u6398\u901f\u5ea6\u304c\u5411\u4e0a\u3059\u308b\u3060\u3051\u3067\u306a\u304f\u3001\"\u30c0\u30a4\u30e4\u30e2\u30f3\u30c9\"\u306e\u3088\u3046\u306a\u30ec\u30a2\u306a\u30ea\u30bd\u30fc\u30b9\u3092\u53ce\u96c6\u3059\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u9032\u6b69\u3059\u308b\u306b\u3064\u308c\u3066\u7d99\u7d9a\u7684\u306a\u30a8\u30f3\u30b2\u30fc\u30b8\u30e1\u30f3\u30c8\u3068\u6e80\u8db3\u611f\u3092\u3082\u305f\u3089\u3057\u307e\u3059\u3002"}, {"question": "Grindcraft\u3067\u30d7\u30ec\u30a4\u3092\u5f37\u5316\u3059\u308b\u305f\u3081\u306b\u3001\u3069\u306e\u30c4\u30fc\u30eb\u3092\u512a\u5148\u3057\u3066\u30af\u30e9\u30d5\u30c8\u3059\u308b\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "Grindcraft\u3067\u306f\u3001\u6700\u3082\u5927\u304d\u306a\u52b9\u7387\u5411\u4e0a\u3092\u3082\u305f\u3089\u3059\u30c4\u30fc\u30eb\u3092\u512a\u5148\u3057\u3066\u30af\u30e9\u30d5\u30c8\u3057\u307e\u3057\u3087\u3046\u3002\u307e\u305a\u3001\u57fa\u672c\u7684\u306a\u30c4\u30fc\u30eb\u3067\u3042\u308b\"\u6728\u306e\u30c4\u30eb\u30cf\u30b7\"\u3068\"\u6728\u306e\u65a7\"\u304b\u3089\u59cb\u3081\u3001\u6b21\u306b\"\u9244\u306e\u30c4\u30eb\u30cf\u30b7\"\u3068\"\u9244\u306e\u65a7\"\u306b\u9032\u3093\u3067\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u3001\"\u9244\u306e\u30c4\u30eb\u30cf\u30b7\"\u306f\"\u6728\u306e\u30c4\u30eb\u30cf\u30b7\"\u3088\u308a\u3082\"\u77f3\"\u30922\u500d\u65e9\u304f\u63a1\u6398\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u512a\u5148\u9806\u4f4d\u4ed8\u3051\u306f\u3001\u3088\u308a\u9ad8\u5ea6\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u65e9\u304f\u30af\u30e9\u30d5\u30c8\u3067\u304d\u308b\u3088\u3046\u306b\u3001\u30ea\u30bd\u30fc\u30b9\u3092\u3088\u308a\u8fc5\u901f\u306b\u53ce\u96c6\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "Grindcraft\u306b\u304a\u3051\u308b\u624b\u52d5\u30af\u30e9\u30d5\u30c8\u3068\u81ea\u52d5\u5316\u30af\u30e9\u30d5\u30c8\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Grindcraft\u306e\u624b\u52d5\u30af\u30e9\u30d5\u30c8\u306f\u3001\u8cc7\u6e90\u3092\u53ce\u96c6\u3057\u30a2\u30a4\u30c6\u30e0\u3092\u500b\u5225\u306b\u30af\u30e9\u30d5\u30c8\u3059\u308b\u305f\u3081\u306b\u30af\u30ea\u30c3\u30af\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u305f\u3081\u3001\u6642\u9593\u304c\u304b\u304b\u308a\u307e\u3059\u3002\"\u30aa\u30fc\u30c8\u30af\u30ea\u30c3\u30af\"\u306e\u3088\u3046\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u5229\u7528\u3057\u305f\u81ea\u52d5\u5316\u30af\u30e9\u30d5\u30c8\u306f\u3001\u5e38\u306b\u64cd\u4f5c\u3059\u308b\u3053\u3068\u306a\u304f\u3001\u8cc7\u6e90\u3092\u53ce\u96c6\u3057\u30a2\u30a4\u30c6\u30e0\u3092\u30af\u30e9\u30d5\u30c8\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\"\u30aa\u30fc\u30c8\u30af\u30ea\u30c3\u30af\"\u306f\"\u6728\"\u3092\u7d76\u3048\u305a\u53ce\u96c6\u3057\u3001\u3042\u306a\u305f\u306f\u3088\u308a\u8907\u96d1\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u30af\u30e9\u30d5\u30c8\u3059\u308b\u3053\u3068\u306b\u5c02\u5ff5\u3067\u304d\u307e\u3059\u3002\u81ea\u52d5\u5316\u306f\u3001\u3042\u306a\u305f\u306e\u52b9\u7387\u3068\u9032\u884c\u901f\u5ea6\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002"}, {"question": "Grindcraft\u306e\u9032\u884c\u72b6\u6cc1\u3092\u5225\u306e\u30c7\u30d0\u30a4\u30b9\u306b\u79fb\u884c\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Grindcraft\u306e\u9032\u884c\u72b6\u6cc1\u3092\u79fb\u884c\u3059\u308b\u306b\u306f\u3001\u6b21\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71 - \u73fe\u5728\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u306b\u79fb\u52d5\u3057\u3001\"\u4fdd\u5b58\u3092\u30a8\u30af\u30b9\u30dd\u30fc\u30c8\"\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - \u751f\u6210\u3055\u308c\u305f\u4fdd\u5b58\u30b3\u30fc\u30c9\u3092\u30b3\u30d4\u30fc\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067Grindcraft\u3092\u958b\u304d\u3001\u8a2d\u5b9a\u306b\u79fb\u52d5\u3057\u3066\"\u4fdd\u5b58\u3092\u30a4\u30f3\u30dd\u30fc\u30c8\"\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u4fdd\u5b58\u30b3\u30fc\u30c9\u3092\u8cbc\u308a\u4ed8\u3051\u3066\u3001\u9032\u6357\u72b6\u6cc1\u3092\u79fb\u884c\u3057\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u30b7\u30fc\u30e0\u30ec\u30b9\u306b\u30b2\u30fc\u30e0\u3092\u7d9a\u3051\u3089\u308c\u307e\u3059\u3002"}, {"question": "\u63a2\u691c\u3092\u901a\u3058\u3066Grindcraft\u3067\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Grindcraft\u306b\u306f\u3001\u63a2\u691c\u3068\u5b9f\u9a13\u3092\u901a\u3058\u3066\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\"\u30df\u30b9\u30c6\u30ea\u30a2\u30b9\u306a\u30a2\u30fc\u30c6\u30a3\u30d5\u30a1\u30af\u30c8\"\u3092\u4f5c\u308b\u306b\u306f\u3001\"\u91d1\"\u3084\"\u30c0\u30a4\u30e4\u30e2\u30f3\u30c9\"\u306e\u3088\u3046\u306a\u30ec\u30a2\u306a\u7d20\u6750\u304c\u5fc5\u8981\u3067\u3059\u3002\u3053\u306e\u3088\u3046\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u767a\u898b\u3059\u308b\u3068\u3001\u72ec\u7279\u306e\u5831\u916c\u304c\u5f97\u3089\u308c\u305f\u308a\u3001\u65b0\u3057\u3044\u30af\u30e9\u30d5\u30c8\u306e\u53ef\u80fd\u6027\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u305f\u308a\u3059\u308b\u306a\u3069\u3001\u30b2\u30fc\u30e0\u306b\u9a5a\u304d\u3068\u5965\u884c\u304d\u3092\u4e0e\u3048\u307e\u3059\u3002"}, {"question": "Grindcraft\u306e\u30ea\u30bd\u30fc\u30b9\u30ec\u30a2\u30ea\u30c6\u30a3\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30af\u30e9\u30d5\u30c8\u306e\u6c7a\u5b9a\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "Grindcraft\u306e\u30ea\u30bd\u30fc\u30b9\u30ec\u30a2\u30ea\u30c6\u30a3\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u7279\u5b9a\u306e\u7d20\u6750\u3092\u5165\u624b\u3059\u308b\u306e\u304c\u96e3\u3057\u3044\uff08\u3057\u305f\u304c\u3063\u3066\u4fa1\u5024\u304c\u9ad8\u3044\uff09\u3088\u3046\u306b\u3059\u308b\u3053\u3068\u3067\u3001\u30af\u30e9\u30d5\u30c8\u306e\u6c7a\u5b9a\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\"\u30c0\u30a4\u30e4\u30e2\u30f3\u30c9\"\u306f\"\u77f3\"\u3088\u308a\u3082\u30ec\u30a2\u3067\u3001\u9ad8\u30ec\u30d9\u30eb\u306e\u30c4\u30fc\u30eb\u306b\u5fc5\u8981\u306a\u7d20\u6750\u3067\u3059\u3002\u3053\u306e\u30ec\u30a2\u30ea\u30c6\u30a3\u306f\u3001\u91cd\u8981\u306a\u30af\u30e9\u30d5\u30c8\u306e\u305f\u3081\u306b\u30ec\u30a2\u306a\u8cc7\u6e90\u3092\u512a\u5148\u7684\u306b\u53ce\u96c6\u3057\u3001\u7bc0\u7d04\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u3053\u3068\u3092\u610f\u5473\u3057\u3001\u305d\u308c\u3089\u3092\u305d\u308c\u307b\u3069\u5f71\u97ff\u529b\u306e\u4f4e\u3044\u30a2\u30a4\u30c6\u30e0\u306b\u7121\u99c4\u306b\u3059\u308b\u3079\u304d\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}, {"question": "Grindcraft\u3067\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u30b9\u30da\u30fc\u30b9\u3092\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3059\u308b\u305f\u3081\u306e\u6700\u5584\u306e\u65b9\u6cd5\u306f\uff1f", "answer": "Grindcraft\u3067\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u30b9\u30da\u30fc\u30b9\u3092\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3059\u308b\u306b\u306f\u3001\u6b21\u306e\u30d2\u30f3\u30c8\u3092\u8003\u616e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71 - \u5b9a\u671f\u7684\u306b\u30a2\u30a4\u30c6\u30e0\u3092\u30af\u30e9\u30d5\u30c8\u3057\u3066\u30b9\u30da\u30fc\u30b9\u3092\u7a7a\u3051\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - \"\u30c1\u30a7\u30b9\u30c8\"\u306e\u3088\u3046\u306a\u4fdd\u7ba1\u30a2\u30a4\u30c6\u30e0\u3092\u4f7f\u7528\u3057\u3066\u4f59\u5206\u306a\u8cc7\u6e90\u3092\u4fdd\u7ba1\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u9ad8\u4fa1\u5024\u307e\u305f\u306f\u30ec\u30a2\u306a\u7d20\u6750\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\"\u9244\u30a4\u30f3\u30b4\u30c3\u30c8\"\u3092\"\u30c1\u30a7\u30b9\u30c8\"\u306b\u4fdd\u7ba1\u3059\u308b\u3068\u3001\u30a2\u30af\u30c6\u30a3\u30d6\u306a\u30af\u30e9\u30d5\u30c8\u306e\u305f\u3081\u306b\u30e1\u30a4\u30f3\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u3092\u6574\u7406\u3057\u3001\u5e38\u306b\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u7ba1\u7406\u3092\u884c\u3046\u3053\u3068\u306a\u304f\u3001\u53ce\u96c6\u3068\u30af\u30e9\u30d5\u30c8\u3092\u884c\u3046\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}]
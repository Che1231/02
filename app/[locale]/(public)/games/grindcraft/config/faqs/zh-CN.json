[{"question": "\u65b0\u624b\u5728Grindcraft\u4e2d\u5982\u4f55\u5f00\u59cb\u5236\u4f5c\uff1f", "answer": "\u5728Grindcraft\u4e2d\u5f00\u59cb\u5236\u4f5c\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u70b9\u51fb\u201c\u5236\u4f5c\u201d\u6309\u94ae\u6253\u5f00\u5236\u4f5c\u83dc\u5355\u3002 \u6b65\u9aa42 - \u4ece\u5217\u8868\u4e2d\u9009\u62e9\u4e00\u4e2a\u57fa\u7840\u7269\u54c1\uff0c\u4f8b\u5982\u201c\u6728\u68cd\u201d\u3002 \u6b65\u9aa43 - \u70b9\u51fb\u6811\u6728\u6536\u96c6\u6240\u9700\u6750\u6599\uff0c\u4f8b\u5982\u201c\u6728\u6750\u201d\u3002 \u4f8b\u5982\uff0c\u5236\u4f5c\u201c\u6728\u68cd\u201d\u9700\u89812\u5757\u201c\u6728\u6750\u201d\u3002 \u8fd9\u5c06\u5411\u4f60\u4ecb\u7ecd\u6e38\u620f\u7684\u6838\u5fc3\u673a\u5236\u3002"}, {"question": "\u5728Grindcraft\u6e38\u620f\u4e2d\u73a9\u6ee1100\u5c0f\u65f6\u540e\uff0c\u5982\u4f55\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u8d44\u6e90\u6548\u7387\uff1f", "answer": "\u5728Grindcraft\u4e2d\u6700\u5927\u5316\u8d44\u6e90\u6548\u7387\uff0c\u8bf7\u8003\u8651\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9aa41 - \u901a\u8fc7\u5236\u4f5c\u201c\u81ea\u52a8\u70b9\u51fb\u5668\u201d\u6765\u81ea\u52a8\u6536\u96c6\u8d44\u6e90\u3002 \u6b65\u9aa42 - \u5c06\u4f60\u7684\u5de5\u5177\u5347\u7ea7\u5230\u66f4\u9ad8\u7b49\u7ea7\uff0c\u4f8b\u5982\u201c\u94c1\u9550\u201d\uff0c\u4ee5\u63d0\u9ad8\u4ea7\u91cf\u3002 \u6b65\u9aa43 - \u5728\u6536\u96c6\u548c\u5236\u4f5c\u4e4b\u95f4\u5e73\u8861\u65f6\u95f4\uff0c\u4ee5\u4f18\u5316\u8fdb\u5ea6\u3002 \u4f8b\u5982\uff0c\u4f7f\u7528\u201c\u94c1\u9550\u201d\u6536\u96c6\u201c\u77f3\u5934\u201d\u7684\u6570\u91cf\u662f\u201c\u6728\u9550\u201d\u7684\u4e24\u500d\u3002"}, {"question": "\u5728Grindcraft\u4e2d\uff0c\u4e3a\u4ec0\u4e48\u4e86\u89e3\u5236\u4f5c\u6811\u975e\u5e38\u91cd\u8981\uff1f", "answer": "\u5728Grindcraft\u4e2d\u7406\u89e3\u5236\u4f5c\u6811\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u5141\u8bb8\u4f60\u6709\u6548\u5730\u89c4\u5212\u8d44\u6e90\u5206\u914d\u3002\u5236\u4f5c\u6811\u663e\u793a\u4e86\u7269\u54c1\u4e4b\u95f4\u7684\u4f9d\u8d56\u5173\u7cfb\uff0c\u5e2e\u52a9\u4f60\u4f18\u5148\u8003\u8651\u9996\u5148\u5236\u4f5c\u54ea\u4e9b\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5236\u4f5c\u201c\u7194\u7089\u201d\u9700\u8981\u201c\u77f3\u5934\u201d\u548c\u201c\u7164\u70ad\u201d\uff0c\u800c\u8fd9\u4e9b\u53c8\u9700\u8981\u7528\u4e8e\u5c06\u201c\u94c1\u77ff\u77f3\u201d\u51b6\u70bc\u6210\u201c\u94c1\u952d\u201d\u3002 \u8fd9\u79cd\u77e5\u8bc6\u53ef\u4ee5\u786e\u4fdd\u4f60\u4e0d\u4f1a\u5c06\u8d44\u6e90\u6d6a\u8d39\u5728\u4e0d\u592a\u91cd\u8981\u7684\u7269\u54c1\u4e0a\u3002"}, {"question": "Grindcraft\u7684\u8fdb\u5ea6\u7cfb\u7edf\u5982\u4f55\u5956\u52b1\u957f\u671f\u73a9\u5bb6\uff1f", "answer": "Grindcraft\u7684\u8fdb\u5ea6\u7cfb\u7edf\u901a\u8fc7\u5f15\u5165\u65e5\u76ca\u590d\u6742\u548c\u6709\u5956\u52b1\u7684\u5236\u4f5c\u94fe\u6765\u5956\u52b1\u957f\u671f\u73a9\u5bb6\u3002\u968f\u7740\u4f60\u7684\u8fdb\u6b65\uff0c\u4f60\u53ef\u4ee5\u89e3\u9501\u66f4\u9ad8\u7b49\u7ea7\u7684\u7269\u54c1\u548c\u5de5\u5177\uff0c\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u6548\u7387\u3002\u4f8b\u5982\uff0c\u5236\u4f5c\u201c\u94bb\u77f3\u9550\u201d\u4e0d\u4ec5\u53ef\u4ee5\u63d0\u9ad8\u4f60\u7684\u91c7\u77ff\u901f\u5ea6\uff0c\u8fd8\u53ef\u4ee5\u8ba9\u4f60\u6536\u96c6\u7a00\u6709\u8d44\u6e90\uff0c\u5982\u201c\u94bb\u77f3\u201d\u3002\u8fd9\u4e2a\u7cfb\u7edf\u786e\u4fdd\u4e86\u4f60\u5728\u8fdb\u6b65\u7684\u8fc7\u7a0b\u4e2d\u6301\u7eed\u53c2\u4e0e\u548c\u83b7\u5f97\u6ee1\u8db3\u611f\u3002"}, {"question": "\u5728Grindcraft\u4e2d\uff0c\u4e3a\u4e86\u589e\u5f3a\u6211\u7684\u6e38\u620f\u4f53\u9a8c\uff0c\u6211\u5e94\u8be5\u4f18\u5148\u5236\u4f5c\u54ea\u4e9b\u5de5\u5177\uff1f", "answer": "\u5728Grindcraft\u4e2d\uff0c\u4f18\u5148\u5236\u4f5c\u80fd\u5e26\u6765\u6700\u5927\u6548\u7387\u63d0\u5347\u7684\u5de5\u5177\u3002\u5148\u4ece\u57fa\u672c\u7684\u5de5\u5177\u5f00\u59cb\uff0c\u4f8b\u5982\u201c\u6728\u9550\u201d\u548c\u201c\u6728\u65a7\u201d\uff0c\u7136\u540e\u5347\u7ea7\u5230\u201c\u94c1\u9550\u201d\u548c\u201c\u94c1\u65a7\u201d\u3002\u4f8b\u5982\uff0c\u201c\u94c1\u9550\u201d\u6bd4\u201c\u6728\u9550\u201d\u91c7\u77ff\u201c\u77f3\u5934\u201d\u7684\u901f\u5ea6\u5feb\u4e24\u500d\u3002\u8fd9\u79cd\u4f18\u5148\u7ea7\u786e\u4fdd\u4f60\u80fd\u591f\u66f4\u5feb\u5730\u6536\u96c6\u8d44\u6e90\uff0c\u4ece\u800c\u66f4\u5feb\u5730\u5236\u4f5c\u66f4\u9ad8\u7ea7\u7684\u7269\u54c1\u3002"}, {"question": "\u5728Grindcraft\u4e2d\uff0c\u624b\u52a8\u5236\u4f5c\u548c\u81ea\u52a8\u5236\u4f5c\u6709\u4ec0\u4e48\u4e3b\u8981\u533a\u522b\uff1f", "answer": "Grindcraft\u4e2d\u7684\u624b\u52a8\u5236\u4f5c\u9700\u8981\u70b9\u51fb\u6536\u96c6\u8d44\u6e90\u5e76\u9010\u4e2a\u5236\u4f5c\u7269\u54c1\uff0c\u8fd9\u975e\u5e38\u8017\u65f6\u3002\u81ea\u52a8\u5236\u4f5c\uff0c\u901a\u8fc7\u50cf\u201c\u81ea\u52a8\u70b9\u51fb\u5668\u201d\u8fd9\u6837\u7684\u7269\u54c1\u5b9e\u73b0\uff0c\u4f7f\u4f60\u80fd\u591f\u6536\u96c6\u8d44\u6e90\u548c\u5236\u4f5c\u7269\u54c1\u800c\u65e0\u9700\u6301\u7eed\u64cd\u4f5c\u3002\u4f8b\u5982\uff0c\u201c\u81ea\u52a8\u70b9\u51fb\u5668\u201d\u53ef\u4ee5\u6301\u7eed\u6536\u96c6\u201c\u6728\u6750\u201d\uff0c\u800c\u4f60\u5219\u53ef\u4ee5\u4e13\u6ce8\u4e8e\u5236\u4f5c\u66f4\u590d\u6742\u7684\u7269\u54c1\u3002\u81ea\u52a8\u5316\u663e\u8457\u63d0\u9ad8\u4e86\u4f60\u7684\u6548\u7387\u548c\u8fdb\u5ea6\u901f\u5ea6\u3002"}, {"question": "\u5982\u4f55\u5728\u4e0d\u540c\u8bbe\u5907\u95f4\u8fc1\u79fb\u6211\u7684Grindcraft\u8fdb\u5ea6\uff1f", "answer": "\u8981\u8fc1\u79fb\u4f60\u7684Grindcraft\u8fdb\u5ea6\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u5728\u5f53\u524d\u8bbe\u5907\u4e0a\uff0c\u8fdb\u5165\u8bbe\u7f6e\u83dc\u5355\uff0c\u9009\u62e9\u201c\u5bfc\u51fa\u5b58\u6863\u201d\u3002 \u6b65\u9aa42 - \u590d\u5236\u751f\u6210\u7684\u5b58\u6863\u4ee3\u7801\u3002 \u6b65\u9aa43 - \u5728\u4f60\u7684\u65b0\u8bbe\u5907\u4e0a\uff0c\u6253\u5f00Grindcraft\uff0c\u8fdb\u5165\u8bbe\u7f6e\uff0c\u9009\u62e9\u201c\u5bfc\u5165\u5b58\u6863\u201d\u3002\u7c98\u8d34\u5b58\u6863\u4ee3\u7801\u4ee5\u4f20\u8f93\u4f60\u7684\u8fdb\u5ea6\u3002 \u8fd9\u786e\u4fdd\u4e86\u4f60\u5728\u4e0d\u540c\u8bbe\u5907\u4e0a\u53ef\u4ee5\u65e0\u7f1d\u5730\u7ee7\u7eed\u6e38\u620f\u3002"}, {"question": "\u901a\u8fc7\u63a2\u7d22\uff0c\u5728Grindcraft\u4e2d\u53ef\u4ee5\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u5185\u5bb9\uff1f", "answer": "Grindcraft\u4e2d\u9690\u85cf\u7740\u53ef\u4ee5\u901a\u8fc7\u63a2\u7d22\u548c\u5b9e\u9a8c\u53d1\u73b0\u7684\u5185\u5bb9\u3002\u4f8b\u5982\uff0c\u5236\u4f5c\u201c\u795e\u79d8\u6587\u7269\u201d\u9700\u8981\u7a00\u6709\u6750\u6599\uff0c\u4f8b\u5982\u201c\u9ec4\u91d1\u201d\u548c\u201c\u94bb\u77f3\u201d\uff0c\u8fd9\u4e9b\u5e76\u4e0d\u90fd\u662f\u663e\u800c\u6613\u89c1\u7684\u3002\u53d1\u73b0\u8fd9\u4e9b\u7269\u54c1\u901a\u5e38\u4f1a\u5e26\u6765\u72ec\u7279\u7684\u5956\u52b1\u6216\u89e3\u9501\u65b0\u7684\u5236\u4f5c\u53ef\u80fd\u6027\uff0c\u4e3a\u6e38\u620f\u589e\u6dfb\u60ca\u559c\u548c\u6df1\u5ea6\u3002"}, {"question": "Grindcraft\u4e2d\u7684\u8d44\u6e90\u7a00\u6709\u5ea6\u7cfb\u7edf\u5982\u4f55\u5f71\u54cd\u5236\u4f5c\u51b3\u7b56\uff1f", "answer": "Grindcraft\u4e2d\u7684\u8d44\u6e90\u7a00\u6709\u5ea6\u7cfb\u7edf\u4f1a\u5f71\u54cd\u5236\u4f5c\u51b3\u7b56\uff0c\u56e0\u4e3a\u67d0\u4e9b\u6750\u6599\u96be\u4ee5\u83b7\u5f97\uff0c\u56e0\u6b64\u66f4\u52a0\u73cd\u8d35\u3002\u4f8b\u5982\uff0c\u201c\u94bb\u77f3\u201d\u6bd4\u201c\u77f3\u5934\u201d\u7a00\u6709\uff0c\u5e76\u4e14\u662f\u9ad8\u9636\u5de5\u5177\u6240\u9700\u7684\u6750\u6599\u3002\u8fd9\u79cd\u7a00\u6709\u6027\u610f\u5473\u7740\u4f60\u5e94\u8be5\u4f18\u5148\u6536\u96c6\u548c\u4fdd\u5b58\u7a00\u6709\u8d44\u6e90\u7528\u4e8e\u91cd\u8981\u7684\u5236\u4f5c\uff0c\u4ee5\u786e\u4fdd\u4f60\u4e0d\u4f1a\u5c06\u5b83\u4eec\u6d6a\u8d39\u5728\u4e0d\u592a\u91cd\u8981\u7684\u7269\u54c1\u4e0a\u3002"}, {"question": "\u5728Grindcraft\u4e2d\u6709\u6548\u7ba1\u7406\u5e93\u5b58\u7a7a\u95f4\u7684\u6700\u4f73\u65b9\u6cd5\u662f\u4ec0\u4e48\uff1f", "answer": "\u4e3a\u4e86\u5728Grindcraft\u4e2d\u6709\u6548\u5730\u7ba1\u7406\u5e93\u5b58\u7a7a\u95f4\uff0c\u8bf7\u8003\u8651\u4ee5\u4e0b\u6280\u5de7\uff1a\u6b65\u9aa41 - \u5b9a\u671f\u5236\u4f5c\u7269\u54c1\u4ee5\u91ca\u653e\u7a7a\u95f4\u3002 \u6b65\u9aa42 - \u4f7f\u7528\u5b58\u50a8\u7269\u54c1\uff0c\u4f8b\u5982\u201c\u7bb1\u5b50\u201d\uff0c\u6765\u50a8\u5b58\u591a\u4f59\u7684\u8d44\u6e90\u3002 \u6b65\u9aa43 - \u4f18\u5148\u4fdd\u7559\u9ad8\u4ef7\u503c\u6216\u7a00\u6709\u6750\u6599\u3002 \u4f8b\u5982\uff0c\u5c06\u201c\u94c1\u952d\u201d\u50a8\u5b58\u5728\u201c\u7bb1\u5b50\u201d\u4e2d\uff0c\u53ef\u4ee5\u4fdd\u6301\u4f60\u7684\u4e3b\u8981\u5e93\u5b58\u6e05\u6670\uff0c\u4ee5\u4fbf\u8fdb\u884c\u6d3b\u8dc3\u7684\u5236\u4f5c\uff0c\u786e\u4fdd\u4f60\u53ef\u4ee5\u5728\u4e0d\u6301\u7eed\u7ba1\u7406\u5e93\u5b58\u7684\u60c5\u51b5\u4e0b\u6536\u96c6\u548c\u5236\u4f5c\u3002"}]
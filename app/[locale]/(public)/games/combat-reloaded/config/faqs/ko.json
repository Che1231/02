[{"question": "\ucd08\ubcf4\uc790\uac00 Combat Reloaded\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc5b4\ub5bb\uac8c \uc219\ub2ec\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Combat Reloaded\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc219\ub2ec\ud558\ub824\uba74 \uc6c0\uc9c1\uc784 \ud0a4(WASD)\ub85c \uc2dc\uc791\ud558\uc5ec \ub9c8\uc6b0\uc2a4\ub85c \uc870\uc900 \uc5f0\uc2b5\uc744 \ud569\ub2c8\ub2e4. \uc67c\ucabd \ub9c8\uc6b0\uc2a4 \ubc84\ud2bc\uc73c\ub85c \uc0ac\uaca9\ud558\uace0 \uc624\ub978\ucabd \ubc84\ud2bc\uc73c\ub85c \uc870\uc900\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \uc784\ubb34\uc5d0\uc11c \uc815\uc9c0\ub41c \ud45c\uc801\uc744 \ud5a5\ud574 \uc6c0\uc9c1\uc774\uace0 \uc0ac\uaca9\ud558\uc5ec \uadfc\uc721 \uae30\uc5b5\uc744 \ub9cc\ub4dc\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \ub2e8\uacc4 1: \uc0ac\uaca9\ud558\uba74\uc11c \uc774\ub3d9 \uc5f0\uc2b5\ud558\uae30. \ub2e8\uacc4 2: \ub2e4\ub978 \ubb34\uae30\ub97c \uc0ac\uc6a9\ud558\uc5ec \ubc18\ub3d9\uc744 \uc774\ud574\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc801\uc758 \uacf5\uaca9\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uc9c0\ud615\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\uc138\uc694. [\ube44\uc720: \uc6b4\uc804\uc744 \ubc30\uc6b0\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ucc98\uc74c\uc5d0\ub294 \ucc9c\ucc9c\ud788 \uc2dc\uc791\ud558\uc5ec \uc775\uc219\ud574\uc9c8\uc218\ub85d \uc18d\ub3c4\ub97c \uc810\ucc28 \ub192\uc5ec\ub098\uac00\uc138\uc694.]"}, {"question": "Combat Reloaded\uc5d0\uc11c \uc784\ubb34\ub97c \uc644\ub8cc\ud558\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Combat Reloaded\uc5d0\uc11c \uc784\ubb34\ub97c \uc644\ub8cc\ud558\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \uacc4\ud68d\uacfc \uc720\uc5f0\uc131\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \uc801\uacfc \uad50\uc804\ud558\uae30 \uc804\uc5d0 \ud56d\uc0c1 \uc9c0\uc5ed\uc744 \uc815\ucc30\ud558\uc2ed\uc2dc\uc624. \uc740\uc2e0\ud558\uc5ec \uba3c\uc800 \uace0\ub9bd\ub41c \ud45c\uc801\uc744 \uc81c\uac70\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\ub3c4\uc2ec \uacf5\uaca9' \uc784\ubb34\uc5d0\uc11c \ubb34\uc74c\ud654\ub41c \ubb34\uae30\ub97c \uc0ac\uc6a9\ud558\uc5ec \uacbd\ube44\uc6d0\uc744 \uc870\uc6a9\ud788 \uc81c\uac70\ud558\uc138\uc694. \ub2e8\uacc4 1: \uc801\uc758 \uc704\uce58\uc640 \uc21c\ucc30 \uacbd\ub85c\ub97c \ud30c\uc545\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc784\ubb34\uc5d0 \uc801\ud569\ud55c \ubb34\uae30\ub97c \uc120\ud0dd\ud558\uc138\uc694(\uc608: \uc7a5\uac70\ub9ac\uc5d0\ub294 \uc800\uaca9\uc218 \uc18c\ucd1d, \uadfc\uc811\uc804\uc5d0\ub294 \uc0b0\ud0c4\ucd1d). \ub2e8\uacc4 3: \uc218\ub958\ud0c4\uacfc \ud3ed\ubc1c\ubb3c\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc801\uad70 \uadf8\ub8f9\uc744 \uc81c\uac70\ud558\uc138\uc694. [\ud45c: \uc740\uc2e0 vs. \uadfc\uc811\uc804\uc744 \uc704\ud55c \ubb34\uc74c\ud654 \uad8c\ucd1d \ub300 \uc0b0\ud0c4\ucd1d]"}, {"question": "Combat Reloaded\uc5d0\uc11c \ub2e4\uc591\ud55c \uc2dc\ub098\ub9ac\uc624\uc5d0 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ubb34\uae30\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Combat Reloaded\uc5d0\uc11c \ubb34\uae30 \ud6a8\uc728\uc131\uc740 \uc2dc\ub098\ub9ac\uc624\ubcc4\ub85c \ub2e4\ub985\ub2c8\ub2e4. \uc7a5\uac70\ub9ac \uad50\uc804\uc5d0\uc11c\ub294 M24 \uc800\uaca9 \uc18c\ucd1d\uc774 \uc774\uc0c1\uc801\uc785\ub2c8\ub2e4. \uadfc\uc811\uc804\uc5d0\uc11c\ub294 SPAS-12 \uc0b0\ud0c4\ucd1d\uc774 \ub6f0\uc5b4\ub0a9\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc815\uae00 \uc2b5\uaca9' \uc784\ubb34\uc5d0\uc11c \uc800\uaca9 \uc18c\ucd1d\uc740 \uba3c \uac70\ub9ac\uc5d0\uc11c \uc801\uc744 \uc81c\uac70\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc784\ubb34 \ud658\uacbd\uc744 \ud3c9\uac00\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uad50\uc804 \uac70\ub9ac\uc5d0 \ub530\ub77c \ubb34\uae30\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ube44\uc0c1 \uc2dc\uc5d0\ub294 \uc5b8\uc81c\ub098 \ubcf4\uc870 \ubb34\uae30\ub97c \ud734\ub300\ud558\uc138\uc694. [\ube44\uad50: \uc0ac\uac70\ub9ac vs. \ub2e4\uc7ac\ub2e4\ub2a5\uc131\uc744 \uc704\ud55c \uc800\uaca9 \uc18c\ucd1d \ub300 \ub3cc\uaca9 \uc18c\ucd1d]"}, {"question": "Combat Reloaded\uc5d0\uc11c \uac8c\uc784 AI\uac00 \uc608\uce21 \ubd88\uac00\ub2a5\ud558\uac8c \uc791\ub3d9\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Combat Reloaded\uc758 AI\ub294 \uc2e4\uc81c \uc138\uacc4\uc758 \uc608\uce21 \ubd88\uac00\ub2a5\uc131\uc744 \uc2dc\ubbac\ub808\uc774\uc158\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5b4 \ub354\uc6b1 \uc5b4\ub824\uc6c0\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc801\ub4e4\uc740 \uce21\uba74 \uacf5\uaca9, \uc740\uc2e0, \uc9c0\uc6d0 \uc694\uccad\uc744 \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uacf5\uc7a5 \uc2b5\uaca9' \uc784\ubb34\uc5d0\uc11c \uc801\ub4e4\uc740 \ud658\uacbd\uc744 \ud65c\uc6a9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \ucd08\uae30 \uc870\uc6b0 \uc2dc AI \ud328\ud134\uc744 \uad00\ucc30\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uadf8\ub4e4\uc758 \ud589\ub3d9\uc5d0 \ub530\ub77c \uc804\ub7b5\uc744 \uc801\uc751\uc2dc\ud0b5\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc218\ub958\ud0c4\uacfc \uac19\uc740 \ubc29\ud574\ub97c \uc0ac\uc6a9\ud558\uc5ec \uadf8\ub4e4\uc758 \uc6c0\uc9c1\uc784\uc744 \uc870\uc791\ud569\ub2c8\ub2e4. [\ub3c4\uc2dd: \uce21\uba74 \uacf5\uaca9 \ub300 \uc740\uc2e0 \uc0ac\uc6a9\uc744 \uc704\ud55c AI \uc758\uc0ac \uacb0\uc815 \ud2b8\ub9ac]"}, {"question": "Combat Reloaded\uc758 \uace0\ub09c\ub3c4 \uc784\ubb34\ub97c \uc704\ud574 \uc7a5\ube44\ub97c \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Combat Reloaded\uc5d0\uc11c \uace0\ub09c\ub3c4 \uc784\ubb34\ub97c \uc704\ud55c \uc7a5\ube44 \ucd5c\uc801\ud654\ub294 \ud654\ub825\uacfc \uc720\uc6a9\uc131\uc758 \uade0\ud615\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc784\ubb34\uc758 \uc0ac\uac70\ub9ac\uc5d0 \uc801\ud569\ud55c \uc8fc\ubb34\uae30\ub97c \uc7a5\ucc29\ud558\uace0 \uadfc\uc811\uc804\uc5d0 \uc0ac\uc6a9\ud560 \ubcf4\uc870 \ubb34\uae30\ub97c \uc120\ud0dd\ud558\uba70, \uad70\uc911 \uc81c\uc5b4\ub97c \uc704\ud55c \uc218\ub958\ud0c4\uc744 \uc7a5\ucc29\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc0ac\ub9c9 \ud3ec\uc704' \uc784\ubb34\uc5d0\uc11c \uc800\uaca9 \uc18c\ucd1d\uacfc \uc0b0\ud0c4\ucd1d\uc774 \uc774\uc0c1\uc801\uc785\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc784\ubb34 \ubaa9\ud45c\uc640 \uc801 \uc720\ud615\uc744 \ubd84\uc11d\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc801\uc758 \uac15\uc810\uc744 \uadf9\ubcf5\ud558\ub294 \ubb34\uae30\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ud56d\uc0c1 \uccb4\ub825 \ud68c\ubcf5\uc81c\uc640 \ud0c4\uc57d\uc744 \uac16\ucd94\uc2ed\uc2dc\uc624. [\ube44\uc720: \uc7a5\ube44\ub97c \uc2a4\uc704\uc2a4 \uad70\uc6a9 \uce7c\ucc98\ub7fc \uc0dd\uac01\ud558\uc138\uc694. \uac01 \ub3c4\uad6c\ub294 \ud2b9\uc815 \ubaa9\uc801\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "Combat Reloaded\uc758 \uccb4\ub825 \ubc0f \uc7a5\uac11 \uc2dc\uc2a4\ud15c\uc758 \ud575\uc2ec \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Combat Reloaded\uc758 \uccb4\ub825 \ubc0f \uc7a5\uac11 \uc2dc\uc2a4\ud15c\uc740 \ud604\uc2e4\uac10\uacfc \uc804\ub7b5\uc131\uc744 \ucd94\uac00\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uccb4\ub825\uc740 \uc11c\uc11c\ud788 \ud68c\ubcf5\ub418\uba70, \uc7a5\uac11\uc740 \ud53c\ud574\ub97c \ud761\uc218\ud558\uc9c0\ub9cc \ubcf4\ucda9\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub208\ubcf4\ub77c \uae30\uc9c0' \uc784\ubb34\uc5d0\uc11c \uc7a5\uac11\uc744 \ucc29\uc6a9\ud558\uba74 \uc800\uaca9\uc218\uc758 \ucd1d\uc54c \ud53c\ud574\ub97c \ub9c9\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc784\ubb34 \ucd08\uae30\uc5d0 \uc7a5\uac11\uc744 \ucc3e\ub294 \uac83\uc744 \uc6b0\uc120\uc2dc\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc740\uc2e0\ucc98\ub97c \uc774\uc6a9\ud558\uc5ec \uccb4\ub825\uc774 \ud68c\ubcf5\ub418\ub3c4\ub85d \ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc4f0\ub7ec\uc9c4 \uc801\uc5d0\uac8c\uc11c \uccb4\ub825 \ud68c\ubcf5\uc81c\uc640 \uc7a5\uac11\ud310\uc744 \uc218\uc9d1\ud569\ub2c8\ub2e4. [\ud45c: \uccb4\ub825 \ud68c\ubcf5 \uc18d\ub3c4 \ub300 \uc7a5\uac11 \ub0b4\uad6c\uc131]"}, {"question": "Combat Reloaded\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "Combat Reloaded\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc815\ud655\uc131, \uc18d\ub3c4 \ubc0f \ud6a8\uc728\uc131\uc744 \ubcf4\uc0c1\ud569\ub2c8\ub2e4. \ud5e4\ub4dc\uc0f7, \uc740\uc2e0 \uc0ac\uc0b4 \ubc0f \ubaa9\ud45c \uc2e0\uc18d\ud558\uac8c \uc644\ub8cc\uc5d0 \ub300\ud55c \uc810\uc218\uac00 \ubd80\uc5ec\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc740\ud589 \uac15\ub3c4' \uc784\ubb34\uc5d0\uc11c \uc740\uc2e0 \uc0ac\uc0b4\uc740 \ubcf4\ub108\uc2a4 \uc810\uc218\ub97c \ud68d\ub4dd\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc810\uc218\ub97c \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \uc815\ud655\ud55c \uc0ac\uaca9\uc5d0 \uc9d1\uc911\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ucd94\uac00 \ubcf4\uc0c1\uc744 \uc704\ud574 \ubcf4\uc870 \ubaa9\ud45c\ub97c \uc644\ub8cc\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ubd88\ud544\uc694\ud55c \ud53c\ud574\ub97c \ud53c\ud558\uc5ec \ub192\uc740 \uc810\uc218\ub97c \uc720\uc9c0\ud569\ub2c8\ub2e4. [\ube44\uad50: \uc810\uc218 \ud6a8\uc728\uc131\uc744 \uc704\ud55c \uc740\uc2e0 \uc0ac\uc0b4 \ub300 \uc9c1\uc811 \uc804\ud22c]"}, {"question": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c Combat Reloaded \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc608, \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub2e4\ub978 \ud50c\ub7ab\ud3fc \uac04\uc5d0 Combat Reloaded \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub450 \uae30\uae30\uc5d0 \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ucf58\uc194\ub85c \uc804\ud658\ud558\uba74 \uc784\ubb34 \uc9c4\ud589 \uc0c1\ud669\uacfc \uc7a5\ube44\uac00 \uc720\uc9c0\ub429\ub2c8\ub2e4. \ub2e8\uacc4 1: \uac8c\uc784 \uc124\uc815\uc5d0\uc11c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc0c8 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud558\uc5ec \uc911\ub2e8\ud588\ub358 \uc9c0\uc810\ubd80\ud130 \uacc4\uc18d \uc9c4\ud589\ud569\ub2c8\ub2e4. [\ube44\uc720: \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc740 \uc5b4\ub514\ub4e0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uac00\uc9c0\uace0 \ub2e4\ub2d0 \uc218 \uc788\ub294 \ub514\uc9c0\ud138 \ubc30\ub0ad\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "Combat Reloaded\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\ub098\uc694?", "answer": "Combat Reloaded\uc5d0\ub294 \ud0d0\ud5d8\uc744 \ubcf4\uc0c1\ud558\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud3d0\ud5c8 \ub9c8\uc744' \uc784\ubb34\uc5d0\uc11c \ud76c\uadc0 \ubb34\uae30\uac00 \uc788\ub294 \ube44\ubc00 \ubc29\uc744 \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \uade0\uc5f4\uc774 \uc788\ub294 \ubcbd\uacfc \uac19\uc740 \ud2b9\uc774\ud55c \ud658\uacbd \uc138\ubd80 \uc0ac\ud56d\uc744 \ucc3e\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc758\uc2ec\uc2a4\ub7ec\uc6b4 \ubb3c\uccb4\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\uc5ec \uc228\uaca8\uc9c4 \uacbd\ub85c\ub97c \ubc1d\ud600\ub0c5\ub2c8\ub2e4. \ub2e8\uacc4 3: \ubbf8\ub798 \uc784\ubb34\uc5d0\uc11c \uc6b0\uc704\ub97c \uc810\ud558\uae30 \uc704\ud574 \ubcf4\uc0c1\uc744 \uc218\uc9d1\ud569\ub2c8\ub2e4. [\ub3c4\uc2dd: '\ud3d0\ud5c8 \ub9c8\uc744'\uc5d0\uc11c \uc774\uc2a4\ud130 \uc5d0\uadf8 \ubc1c\uacac \uacbd\ub85c]"}, {"question": "Combat Reloaded\uc5d0\uc11c \ud658\uacbd\uc744 \uc5b4\ub5bb\uac8c \ud65c\uc6a9\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Combat Reloaded\uc5d0\uc11c \ud658\uacbd\uc744 \ud65c\uc6a9\ud558\ub294 \uac83\uc740 \uc740\uc2e0\ucc98, \uace0\ub3c4 \ubc0f \ud30c\uad34 \uac00\ub2a5\ud55c \ubb3c\uccb4\ub97c \ud65c\uc6a9\ud558\ub294 \uac83\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub3c4\uc2dc \ud0c8\ucd9c' \uc784\ubb34\uc5d0\uc11c \uc790\ub3d9\ucc28\ub97c \uc740\uc2e0\ucc98\ub85c \uc0ac\uc6a9\ud558\uace0 \ucc3d\ubb38\uc744 \ud1b5\ud574 \uc801\uc744 \uae30\uc2b5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc9c0\ubd95\uc774\ub098 \ubaa8\uc11c\ub9ac\uc640 \uac19\uc740 \uc804\ub7b5\uc801 \uc704\uce58\ub97c \ud30c\uc545\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ud3ed\ubc1c\uc131 \ud1b5\uc774\ub098 \uac19\uc740 \ud658\uacbd \uc704\ud5d8\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc801\uc744 \uacf5\uaca9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ud56d\uc0c1 \ud0c8\ucd9c \uacbd\ub85c\ub97c \uacc4\ud68d\ud558\uc2ed\uc2dc\uc624. [\ube44\uc720: \ud658\uacbd\uc744 \uccb4\uc2a4\ud310\ucc98\ub7fc \uc0dd\uac01\ud558\uc138\uc694. \ubaa8\ub4e0 \uc6c0\uc9c1\uc784\uc740 \uacc4\uc0b0\ub418\uc5b4\uc57c \ud569\ub2c8\ub2e4.]"}]
[{"question": "\u6226\u95d8\u518d\u30ed\u30fc\u30c9\u3067\u521d\u5fc3\u8005\u3068\u3057\u3066\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u6226\u95d8\u518d\u30ed\u30fc\u30c9\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u307e\u305a\u79fb\u52d5\u30ad\u30fc\uff08WASD\uff09\u304b\u3089\u59cb\u3081\u3066\u3001\u30de\u30a6\u30b9\u3067\u7167\u6e96\u3092\u7df4\u7fd2\u3057\u307e\u3057\u3087\u3046\u3002\u5de6\u30de\u30a6\u30b9\u30dc\u30bf\u30f3\u3067\u6483\u3061\u3001\u53f3\u30dc\u30bf\u30f3\u3067\u7167\u6e96\u3092\u5408\u308f\u305b\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6700\u521d\u306e\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u56fa\u5b9a\u3055\u308c\u305f\u6a19\u7684\u306b\u52d5\u3044\u3066\u6483\u3064\u7df4\u7fd2\u3092\u3059\u308b\u3053\u3068\u3067\u3001\u7b4b\u8089\u306e\u8a18\u61b6\u3092\u69cb\u7bc9\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6483\u3061\u306a\u304c\u3089\u79fb\u52d5\u3059\u308b\u7df4\u7fd2\u3092\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u3055\u307e\u3056\u307e\u306a\u6b66\u5668\u3092\u8a66\u3057\u3066\u3001\u53cd\u52d5\u3092\u7406\u89e3\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6575\u306e\u653b\u6483\u304b\u3089\u9003\u308c\u308b\u305f\u3081\u306b\u3001\u30ab\u30d0\u30fc\u3092\u52b9\u679c\u7684\u306b\u6d3b\u7528\u3059\u308b\u3002[\u4f8b\u3048\uff1a\u904b\u8ee2\u3092\u5b66\u3076\u5834\u5408\u3068\u540c\u69d8\u306b\u3001\u6163\u308c\u3066\u304f\u308b\u3068\u5f90\u3005\u306b\u30b9\u30d4\u30fc\u30c9\u3092\u4e0a\u3052\u3066\u3044\u304d\u307e\u3057\u3087\u3046\u3002]"}, {"question": "\u6226\u95d8\u518d\u30ed\u30fc\u30c9\u3067\u306e\u30df\u30c3\u30b7\u30e7\u30f3\u3092\u5b8c\u4e86\u3059\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u6226\u95d8\u518d\u30ed\u30fc\u30c9\u3067\u306e\u30df\u30c3\u30b7\u30e7\u30f3\u3092\u5b8c\u4e86\u3059\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u3001\u8a08\u753b\u6027\u3068\u9069\u5fdc\u529b\u3067\u3059\u3002\u6575\u306b\u653b\u6483\u3059\u308b\u524d\u306b\u3001\u5e38\u306b\u305d\u306e\u30a8\u30ea\u30a2\u3092\u5075\u5bdf\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30eb\u30b9\u3092\u4f7f\u3063\u3066\u5b64\u7acb\u3057\u305f\u6a19\u7684\u3092\u6700\u521d\u306b\u6392\u9664\u3057\u307e\u3057\u3087\u3046\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u90fd\u5e02\u653b\u6483\u300d\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u30b5\u30a4\u30ec\u30f3\u30b5\u30fc\u4ed8\u304d\u306e\u6b66\u5668\u3092\u4f7f\u3063\u3066\u9759\u304b\u306b\u8b66\u5099\u54e1\u3092\u6392\u9664\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6575\u306e\u4f4d\u7f6e\u3068\u30d1\u30c8\u30ed\u30fc\u30eb\u30eb\u30fc\u30c8\u3092\u7279\u5b9a\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u4ed5\u4e8b\u306b\u9069\u3057\u305f\u6b66\u5668\u3092\u9078\u3076\uff08\u4f8b\uff1a\u9577\u8ddd\u96e2\u7528\u30b9\u30ca\u30a4\u30d1\u30fc\u30e9\u30a4\u30d5\u30eb\u3001\u8fd1\u8ddd\u96e2\u7528\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\uff09\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6575\u306e\u30b0\u30eb\u30fc\u30d7\u3092\u6392\u9664\u3059\u308b\u305f\u3081\u306b\u3001\u624b\u69b4\u5f3e\u3084\u7206\u767a\u7269\u3092\u5229\u7528\u3059\u308b\u3002[\u5bfe\u5fdc\u8868\uff1a\u30b9\u30c6\u30eb\u30b9\u7528\u30b5\u30a4\u30ec\u30f3\u30b5\u30fc\u4ed8\u304d\u62f3\u9283vs.\u8fd1\u63a5\u6226\u95d8\u7528\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\u3002]"}, {"question": "\u6226\u95d8\u518d\u30ed\u30fc\u30c9\u3067\u3001\u3055\u307e\u3056\u307e\u306a\u30b7\u30ca\u30ea\u30aa\u3067\u6700\u3082\u52b9\u679c\u7684\u306a\u6b66\u5668\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u6226\u95d8\u518d\u30ed\u30fc\u30c9\u3067\u306f\u3001\u6b66\u5668\u306e\u6709\u52b9\u6027\u306f\u30b7\u30ca\u30ea\u30aa\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u3002\u9577\u8ddd\u96e2\u306e\u4ea4\u6226\u3067\u306f\u3001M24\u30b9\u30ca\u30a4\u30d1\u30fc\u30e9\u30a4\u30d5\u30eb\u304c\u6700\u9069\u3067\u3059\u3002\u8fd1\u63a5\u6226\u95d8\u3067\u306f\u3001SPAS-12\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\u304c\u512a\u308c\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30b8\u30e3\u30f3\u30b0\u30eb\u8972\u6483\u300d\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u30b9\u30ca\u30a4\u30d1\u30fc\u30e9\u30a4\u30d5\u30eb\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u9060\u304f\u304b\u3089\u6575\u3092\u6392\u9664\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30df\u30c3\u30b7\u30e7\u30f3\u74b0\u5883\u3092\u8a55\u4fa1\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u4ea4\u6226\u8ddd\u96e2\u306b\u57fa\u3065\u3044\u3066\u6b66\u5668\u3092\u9078\u629e\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7dca\u6025\u6642\u306b\u5fc5\u305a\u62f3\u9283\u3092\u643a\u5e2f\u3059\u308b\u3002[\u6bd4\u8f03\u8868\uff1a\u30b9\u30ca\u30a4\u30d1\u30fc\u30e9\u30a4\u30d5\u30ebvs.\u30a2\u30b5\u30eb\u30c8\u30e9\u30a4\u30d5\u30eb\u3001\u5c04\u7a0b\u8ddd\u96e2vs.\u6c4e\u7528\u6027\u3002]"}, {"question": "\u6226\u95d8\u518d\u30ed\u30fc\u30c9\u306eAI\u304c\u4e88\u6e2c\u4e0d\u80fd\u306b\u632f\u308b\u821e\u3046\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u6226\u95d8\u518d\u30ed\u30fc\u30c9\u306eAI\u306f\u3001\u3088\u308a\u6311\u6226\u7684\u306a\u3082\u306e\u306b\u3059\u308b\u305f\u3081\u306b\u3001\u73fe\u5b9f\u4e16\u754c\u306e\u4e88\u6e2c\u4e0d\u80fd\u3055\u3092\u30b7\u30df\u30e5\u30ec\u30fc\u30b7\u30e7\u30f3\u3059\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u6575\u306f\u5074\u9762\u653b\u6483\u3057\u3001\u30ab\u30d0\u30fc\u3092\u53d6\u308a\u3001\u63f4\u8ecd\u3092\u8981\u8acb\u3059\u308b\u3067\u3057\u3087\u3046\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u5de5\u5834\u8972\u6483\u300d\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u6575\u306f\u74b0\u5883\u3092\u81ea\u5206\u306e\u6709\u5229\u306b\u5229\u7528\u3059\u308b\u3067\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6700\u521d\u306e\u906d\u9047\u4e2d\u306bAI\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u89b3\u5bdf\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5f7c\u3089\u306e\u884c\u52d5\u306b\u57fa\u3065\u3044\u3066\u6226\u7565\u3092\u8abf\u6574\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u624b\u69b4\u5f3e\u306a\u3069\u306e\u6c17\u3092\u6563\u3089\u3059\u3082\u306e\u3092\u4f7f\u3063\u3066\u3001\u6575\u306e\u52d5\u304d\u3092\u64cd\u4f5c\u3059\u308b\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u5074\u9762\u653b\u6483\u7528AI\u6c7a\u5b9a\u6728vs\u3002\u30ab\u30d0\u30fc\u4f7f\u7528\u3002]"}, {"question": "\u6226\u95d8\u518d\u30ed\u30fc\u30c9\u306e\u56f0\u96e3\u306a\u30df\u30c3\u30b7\u30e7\u30f3\u306e\u305f\u3081\u306b\u3001\u79c1\u306e\u88c5\u5099\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u6226\u95d8\u518d\u30ed\u30fc\u30c9\u306e\u56f0\u96e3\u306a\u30df\u30c3\u30b7\u30e7\u30f3\u306e\u305f\u3081\u306b\u88c5\u5099\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u706b\u529b\u3068\u30e6\u30fc\u30c6\u30a3\u30ea\u30c6\u30a3\u306e\u30d0\u30e9\u30f3\u30b9\u304c\u5fc5\u8981\u3067\u3059\u3002\u30df\u30c3\u30b7\u30e7\u30f3\u306e\u5c04\u7a0b\u306b\u9069\u3057\u305f\u4e3b\u8981\u6b66\u5668\u3001\u8fd1\u63a5\u6226\u95d8\u7528\u306b\u526f\u6b66\u5668\u3001\u305d\u3057\u3066\u8907\u6570\u6575\u3078\u306e\u5bfe\u5fdc\u7528\u306b\u624b\u69b4\u5f3e\u3092\u88c5\u5099\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u7802\u6f20\u5305\u56f2\u300d\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u30b9\u30ca\u30a4\u30d1\u30fc\u30e9\u30a4\u30d5\u30eb\u3068\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\u304c\u6700\u9069\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30df\u30c3\u30b7\u30e7\u30f3\u76ee\u6a19\u3068\u6575\u306e\u7a2e\u985e\u3092\u5206\u6790\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6575\u306e\u5f37\u3055\u306b\u5bfe\u5fdc\u3059\u308b\u6b66\u5668\u3092\u9078\u3076\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5e38\u306b\u533b\u7642\u30ad\u30c3\u30c8\u3068\u5f3e\u85ac\u3092\u643a\u5e2f\u3059\u308b\u3002[\u4f8b\u3048\uff1a\u3042\u306a\u305f\u306e\u88c5\u5099\u306f\u30de\u30eb\u30c1\u30c4\u30fc\u30eb\u3068\u540c\u69d8\u306b\u8003\u3048\u307e\u3057\u3087\u3046\u3002\u305d\u308c\u305e\u308c\u306e\u9053\u5177\u306b\u306f\u7279\u5b9a\u306e\u76ee\u7684\u304c\u3042\u308a\u307e\u3059\u3002]"}, {"question": "\u6226\u95d8\u518d\u30ed\u30fc\u30c9\u306e\u4f53\u529b\u3068\u30a2\u30fc\u30de\u30fc\u30b7\u30b9\u30c6\u30e0\u306e\u80cc\u5f8c\u306b\u3042\u308b\u4e3b\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u6226\u95d8\u518d\u30ed\u30fc\u30c9\u306e\u4f53\u529b\u3068\u30a2\u30fc\u30de\u30fc\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u73fe\u5b9f\u611f\u3068\u6226\u7565\u6027\u3092\u9ad8\u3081\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u4f53\u529b\u306f\u3086\u3063\u304f\u308a\u3068\u56de\u5fa9\u3057\u307e\u3059\u304c\u3001\u30a2\u30fc\u30de\u30fc\u306f\u30c0\u30e1\u30fc\u30b8\u3092\u5438\u53ce\u3057\u307e\u3059\u304c\u3001\u88dc\u5145\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u96ea\u5c71\u57fa\u5730\u300d\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u30a2\u30fc\u30de\u30fc\u3092\u7740\u3066\u3044\u308c\u3070\u3001\u30b9\u30ca\u30a4\u30d1\u30fc\u306e\u653b\u6483\u304b\u3089\u8eab\u3092\u5b88\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30df\u30c3\u30b7\u30e7\u30f3\u521d\u671f\u6bb5\u968e\u3067\u30a2\u30fc\u30de\u30fc\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u3092\u512a\u5148\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30ab\u30d0\u30fc\u3092\u5229\u7528\u3057\u3066\u4f53\u529b\u3092\u56de\u5fa9\u3055\u305b\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5012\u3057\u305f\u6575\u304b\u3089\u533b\u7642\u30ad\u30c3\u30c8\u3068\u30a2\u30fc\u30de\u30fc\u30d7\u30ec\u30fc\u30c8\u3092\u96c6\u3081\u308b\u3002[\u5bfe\u5fdc\u8868\uff1a\u4f53\u529b\u306e\u518d\u751f\u901f\u5ea6vs.\u30a2\u30fc\u30de\u30fc\u306e\u8010\u4e45\u6027\u3002]"}, {"question": "\u6226\u95d8\u518d\u30ed\u30fc\u30c9\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u6226\u95d8\u518d\u30ed\u30fc\u30c9\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6b63\u78ba\u6027\u3001\u901f\u5ea6\u3001\u52b9\u7387\u6027\u3092\u8a55\u4fa1\u3057\u307e\u3059\u3002\u30d8\u30c3\u30c9\u30b7\u30e7\u30c3\u30c8\u3001\u30b9\u30c6\u30eb\u30b9\u30ad\u30eb\u3001\u76ee\u6a19\u306e\u8fc5\u901f\u306a\u9054\u6210\u306a\u3069\u3067\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u9280\u884c\u5f37\u76d7\u300d\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u30b9\u30c6\u30eb\u30b9\u30ad\u30eb\u3067\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30dd\u30a4\u30f3\u30c8\u3092\u6700\u5927\u5316\u3059\u308b\u305f\u3081\u306b\u6b63\u78ba\u306a\u5c04\u6483\u306b\u96c6\u4e2d\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u8ffd\u52a0\u306e\u5831\u916c\u306e\u305f\u3081\u306b\u3001\u88dc\u52a9\u7684\u306a\u76ee\u6a19\u3092\u5b8c\u4e86\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u4e0d\u8981\u306a\u30c0\u30e1\u30fc\u30b8\u3092\u907f\u3051\u3066\u3001\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u7dad\u6301\u3059\u308b\u3002[\u6bd4\u8f03\u8868\uff1a\u30b9\u30c6\u30eb\u30b9\u30ad\u30ebvs.\u76f4\u63a5\u6226\u95d8\u306e\u70b9\u6570\u306e\u52b9\u7387\u6027\u3002]"}, {"question": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u6226\u95d8\u518d\u30ed\u30fc\u30c9\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u4f7f\u7528\u3057\u3066\u3001\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u6226\u95d8\u518d\u30ed\u30fc\u30c9\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3067\u304d\u307e\u3059\u3002\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u3001PC\u304b\u3089\u30b3\u30f3\u30bd\u30fc\u30eb\u306b\u5207\u308a\u66ff\u3048\u308b\u5834\u5408\u3001\u30df\u30c3\u30b7\u30e7\u30f3\u306e\u9032\u884c\u72b6\u6cc1\u3068\u88c5\u5099\u306f\u4fdd\u6301\u3055\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b2\u30fc\u30e0\u8a2d\u5b9a\u3067\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u6709\u52b9\u306b\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u65b0\u3057\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u4e2d\u65ad\u3057\u305f\u3068\u3053\u308d\u304b\u3089\u7d9a\u3051\u308b\u305f\u3081\u306b\u9032\u884c\u72b6\u6cc1\u3092\u540c\u671f\u3059\u308b\u3002[\u4f8b\u3048\uff1a\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u306f\u3001\u3069\u3053\u3078\u884c\u304f\u306b\u3082\u3042\u306a\u305f\u306e\u9032\u884c\u72b6\u6cc1\u3092\u904b\u3076\u30c7\u30b8\u30bf\u30eb\u30d0\u30c3\u30af\u30d1\u30c3\u30af\u3067\u3059\u3002]"}, {"question": "\u6226\u95d8\u518d\u30ed\u30fc\u30c9\u3067\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u6226\u95d8\u518d\u30ed\u30fc\u30c9\u306b\u306f\u3001\u63a2\u691c\u3092\u5831\u3044\u308b\u3044\u304f\u3064\u304b\u306e\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u5ec3\u6751\u300d\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u30ec\u30a2\u6b66\u5668\u304c\u3042\u308b\u79d8\u5bc6\u306e\u90e8\u5c4b\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5272\u308c\u305f\u58c1\u306a\u3069\u3001\u73cd\u3057\u3044\u74b0\u5883\u306e\u8a73\u7d30\u3092\u63a2\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u602a\u3057\u3044\u7269\u4f53\u306b\u89e6\u308c\u3066\u3001\u96a0\u3055\u308c\u305f\u30d1\u30b9\u3092\u660e\u3089\u304b\u306b\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5c06\u6765\u306e\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u6709\u5229\u3092\u5f97\u308b\u305f\u3081\u306e\u5831\u916c\u3092\u96c6\u3081\u308b\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u300c\u5ec3\u6751\u300d\u306b\u304a\u3051\u308b\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u767a\u898b\u30d1\u30b9\u3002]"}, {"question": "\u6226\u95d8\u518d\u30ed\u30fc\u30c9\u3067\u74b0\u5883\u3092\u81ea\u5206\u306e\u6709\u5229\u306b\u4f7f\u3046\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u6226\u95d8\u518d\u30ed\u30fc\u30c9\u3067\u74b0\u5883\u3092\u81ea\u5206\u306e\u6709\u5229\u306b\u4f7f\u3046\u306b\u306f\u3001\u30ab\u30d0\u30fc\u3001\u9ad8\u4f4e\u5dee\u3001\u7834\u58ca\u53ef\u80fd\u306a\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u6d3b\u7528\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u90fd\u5e02\u8131\u51fa\u300d\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u8eca\u3092\u30ab\u30d0\u30fc\u3068\u3057\u3066\u4f7f\u7528\u3057\u3001\u6575\u3092\u7a93\u304b\u3089\u72d9\u6483\u3057\u3066\u5947\u8972\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5c4b\u4e0a\u3084\u30b3\u30fc\u30ca\u30fc\u306a\u3069\u3001\u6226\u7565\u7684\u306a\u4f4d\u7f6e\u3092\u7279\u5b9a\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u7206\u767a\u6027\u306e\u3042\u308b\u6a3d\u306a\u3069\u306e\u74b0\u5883\u306e\u5371\u967a\u3092\u4f7f\u3063\u3066\u6575\u306b\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5e38\u306b\u8131\u51fa\u30eb\u30fc\u30c8\u3092\u8a08\u753b\u3059\u308b\u3002[\u4f8b\u3048\uff1a\u74b0\u5883\u3092\u30c1\u30a7\u30b9\u76e4\u306e\u3088\u3046\u306b\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u3042\u3089\u3086\u308b\u52d5\u304d\u306f\u8a08\u7b97\u3055\u308c\u306a\u3051\u308c\u3070\u306a\u308a\u307e\u305b\u3093\u3002]"}]
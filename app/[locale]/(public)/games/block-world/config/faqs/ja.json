[{"question": "\u30d6\u30ed\u30c3\u30af\u30ef\u30fc\u30eb\u30c9\uff1a\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u3057\u3066\u3001\u30d6\u30ed\u30c3\u30af\u3092\u6b63\u3057\u304f\u914d\u7f6e\u3059\u308b\u65b9\u6cd5\u3068\u3001\u907f\u3051\u308b\u3079\u304d\u4e00\u822c\u7684\u306a\u9593\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d6\u30ed\u30c3\u30af\u30ef\u30fc\u30eb\u30c9\u3067\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u3057\u3066\u3001\u30d6\u30ed\u30c3\u30af\u3092\u914d\u7f6e\u3059\u308b\u3053\u3068\u306f\u57fa\u672c\u7684\u306a\u3053\u3068\u3067\u3059\u3002\u30d6\u30ed\u30c3\u30af\u3092\u914d\u7f6e\u3059\u308b\u306b\u306f\u3001\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u304b\u3089\u9078\u629e\u3057\u3001\u30b2\u30fc\u30e0\u4e16\u754c\u3067\u76ee\u7684\u306e\u5834\u6240\u306b\u30af\u30ea\u30c3\u30af\u3057\u307e\u3059\u3002\u4e00\u822c\u7684\u306a\u9593\u9055\u3044\u306f\u3001\u3059\u3067\u306b\u5225\u306e\u30d6\u30ed\u30c3\u30af\u304c\u5b58\u5728\u3059\u308b\u5834\u6240\u3001\u307e\u305f\u306f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u624b\u306e\u5c4a\u304b\u306a\u3044\u5834\u6240\u306b\u30d6\u30ed\u30c3\u30af\u3092\u914d\u7f6e\u3057\u3088\u3046\u3068\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u307e\u305f\u3001\u91cd\u529b\u306b\u3082\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\uff01\u30d6\u30ed\u30c3\u30af\u306f\u9069\u5207\u306b\u30b5\u30dd\u30fc\u30c8\u3055\u308c\u3066\u3044\u306a\u3044\u5834\u5408\u3001\u843d\u4e0b\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5854\u3092\u5efa\u3066\u308b\u5834\u5408\u306f\u3001\u5e45\u5e83\u306e\u30d9\u30fc\u30b9\uff08STEP1\uff09\u304b\u3089\u3001\u4e0a\u306b\u7a4d\u307f\u4e0a\u3052\u308b\u306b\u3064\u308c\u3066\u5f90\u3005\u306b\u72ed\u3081\u3066\u3044\u304f\uff08STEP2\uff09\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u8ffd\u52a0\u306e\u5b89\u5b9a\u6027\u3092\u63d0\u4f9b\u3059\u308b\u305f\u3081\u306b\u3001\u5074\u9762\u306b\u652f\u3048\u308b\u30d6\u30ed\u30c3\u30af\u3092\u914d\u7f6e\u3059\u308b\u3053\u3068\u3092\u691c\u8a0e\u3057\u3066\u304f\u3060\u3055\u3044\uff08STEP3\uff09\u3002\u30d6\u30ed\u30c3\u30af\u3092\u30ec\u30b4\u30d6\u30ed\u30c3\u30af\u306e\u3088\u3046\u306b\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u305d\u308c\u305e\u308c\u306b\u5805\u56fa\u306a\u57fa\u76e4\u304c\u5fc5\u8981\u3067\u3059\u3002"}, {"question": "\u306a\u305c\u79c1\u306e\u30d6\u30ed\u30c3\u30af\u30ef\u30fc\u30eb\u30c9\u306e\u30d4\u30c3\u30b1\u30eb\u304c\u305d\u3093\u306a\u306b\u65e9\u304f\u58ca\u308c\u308b\u306e\u3067\u3059\u304b\uff1f\u3055\u307e\u3056\u307e\u306a\u30c4\u30fc\u30eb\u30c6\u30a3\u30a2\u3068\u305d\u306e\u8010\u4e45\u6027\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u3042\u306a\u305f\u306e\u30d4\u30c3\u30b1\u30eb\u304c\u65e9\u304f\u58ca\u308c\u308b\u306e\u306f\u3001\u304a\u305d\u3089\u304f\u3001\u4e0b\u4f4d\u30c6\u30a3\u30a2\u306e\u30c4\u30fc\u30eb\u3060\u304b\u3089\u3067\u3059\u3002\u30d6\u30ed\u30c3\u30af\u30ef\u30fc\u30eb\u30c9\u306b\u306f\u3001\u8010\u4e45\u6027\u3068\u63a1\u6398\u901f\u5ea6\u306b\u5f71\u97ff\u3059\u308b\u3055\u307e\u3056\u307e\u306a\u7d20\u6750\u306e\u30c6\u30a3\u30a2\u30c4\u30fc\u30eb\u304c\u3042\u308a\u307e\u3059\u3002\u6728\u88fd\u306e\u30d4\u30c3\u30b1\u30eb\u304c\u6700\u3082\u5f31\u304f\u3001\u6b21\u306b\u77f3\u3001\u9244\u3001\u91d1\u3001\u30c0\u30a4\u30e4\u30e2\u30f3\u30c9\uff08\u69cb\u6210\u6bd4\u8f03\u8868\uff09\u3067\u3059\u3002\u6728\u88fd\u306e\u30d4\u30c3\u30b1\u30eb\u306f20\u56de\u3057\u304b\u4f7f\u7528\u3067\u304d\u306a\u3044\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u304c\u3001\u30c0\u30a4\u30e4\u30e2\u30f3\u30c9\u306e\u30d4\u30c3\u30b1\u30eb\u306f\u6570\u767e\u56de\u4f7f\u7528\u3067\u304d\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u3088\u308a\u826f\u3044\u8cc7\u6e90\u3092\u5165\u624b\u3057\u305f\u3089\u3001\u3059\u3050\u306b\u30d4\u30c3\u30b1\u30eb\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u3001\u77f3\u3092\u63a1\u6398\u3059\u308b\u306b\u306f\u3001\u5c11\u306a\u304f\u3068\u3082\u6728\u306e\u30d4\u30c3\u30b1\u30eb\u304c\u5fc5\u8981\u3067\u3059\u3002\u9244\u9271\u77f3\u306b\u306f\u3001\u77f3\u306e\u30d4\u30c3\u30b1\u30eb\u3001\u307e\u305f\u306f\u305d\u308c\u4ee5\u4e0a\u306e\u3082\u306e\u304c\u5fc5\u8981\u3067\u3059\u3002\u30af\u30e9\u30d5\u30c8\u30c6\u30fc\u30d6\u30eb\u3067\u68d2\u3068\u77f3\u7573\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3001\u77f3\u306e\u30d4\u30c3\u30b1\u30eb\u3092\u4f5c\u6210\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d6\u30ed\u30c3\u30af\u30ef\u30fc\u30eb\u30c9\u306e\u7089\u306e\u76ee\u7684\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u3088\u308a\u826f\u3044\u30a2\u30a4\u30c6\u30e0\u3084\u8cc7\u6e90\u3092\u4f5c\u6210\u3059\u308b\u305f\u3081\u306b\u3069\u306e\u3088\u3046\u306b\u4f7f\u7528\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d6\u30ed\u30c3\u30af\u30ef\u30fc\u30eb\u30c9\u306e\u7089\u306f\u3001\u91cd\u8981\u306a\u30af\u30e9\u30d5\u30c8\u30c4\u30fc\u30eb\u3068\u3057\u3066\u6a5f\u80fd\u3057\u307e\u3059\u3002\u305d\u308c\u306f\u3001\u539f\u6599\u3092\u3088\u308a\u6709\u7528\u306a\u5f62\u614b\u306b\u5909\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u7089\u3092\u4f7f\u7528\u3059\u308b\u306b\u306f\u3001\u71c3\u6599\uff08\u6728\u6750\u3001\u77f3\u70ad\u306a\u3069\uff09\u3068\u6eb6\u89e3\u3057\u305f\u3044\u6750\u6599\uff08\u9244\u9271\u77f3\u306a\u3069\uff09\u304c\u5fc5\u8981\u3067\u3059\u3002\u71c3\u6599\u3092\u4e0b\u6bb5\u306e\u6e9d\u306b\u3001\u6750\u6599\u3092\u4e0a\u6bb5\u306e\u6e9d\u306b\u914d\u7f6e\u3057\u307e\u3059\u3002\u305d\u306e\u5f8c\u3001\u7089\u306f\u3001\u9244\u9271\u77f3\u304b\u3089\u9244\u30a4\u30f3\u30b4\u30c3\u30c8\u306e\u3088\u3046\u306a\u3001\u539f\u6599\u3092\u7cbe\u932c\u3055\u308c\u305f\u88fd\u54c1\u306b\u5909\u3048\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30a4\u30f3\u30b4\u30c3\u30c8\u306f\u3001\u93a7\u3084\u30c4\u30fc\u30eb\u306a\u3069\u306e\u3088\u308a\u9ad8\u5ea6\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u30af\u30e9\u30d5\u30c8\u3059\u308b\u305f\u3081\u306b\u4f7f\u7528\u3067\u304d\u307e\u3059\u3002\u7089\u3092\u3001\u7c97\u3044\u6750\u6599\u3092\u8cb4\u91cd\u306a\u90e8\u54c1\u306b\u5909\u63db\u3059\u308b\u9b54\u6cd5\u306e\u935b\u51b6\u5834\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30d6\u30ed\u30c3\u30af\u30ef\u30fc\u30eb\u30c9\u4e0a\u7d1a\u6226\u7565\uff1a\u3088\u308a\u9ad8\u3044\u52b9\u7387\u306e\u305f\u3081\u306e\u3055\u307e\u3056\u307e\u306a\u30a8\u30f3\u30c1\u30e3\u30f3\u30c8\u307e\u305f\u306f\u30c6\u30af\u30cb\u30c3\u30af\u3092\u4f7f\u7528\u3057\u3066\u3001\u8cc7\u6e90\u53ce\u96c6\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d6\u30ed\u30c3\u30af\u30ef\u30fc\u30eb\u30c9\u3067\u8cc7\u6e90\u53ce\u96c6\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u30a8\u30f3\u30c1\u30e3\u30f3\u30c8\u3068\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u4f7f\u7528\u3057\u3066\u52b9\u7387\u3092\u9ad8\u3081\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30c4\u30fc\u30eb\u306b\u3068\u3063\u3066\u6700\u3082\u52b9\u679c\u7684\u306a\u30a8\u30f3\u30c1\u30e3\u30f3\u30c8\u306e1\u3064\u306f\u3001\u300c\u5e78\u904b\u300d\u3067\u3042\u308a\u3001\u63a1\u6398\u6642\u306b\u30c9\u30ed\u30c3\u30d7\u3055\u308c\u308b\u30a2\u30a4\u30c6\u30e0\u306e\u6570\u3092\u5897\u3084\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30c0\u30a4\u30e4\u30e2\u30f3\u30c9\u9271\u77f3\u306b\u5e78\u904bIII\u306e\u30d4\u30c3\u30b1\u30eb\u3092\u4f7f\u7528\u3059\u308b\u3068\u30011\u30d6\u30ed\u30c3\u30af\u3042\u305f\u308a\u8907\u6570\u306e\u30c0\u30a4\u30e4\u30e2\u30f3\u30c9\u304c\u5f97\u3089\u308c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u5225\u306e\u30c6\u30af\u30cb\u30c3\u30af\u306f\u3001\u7279\u5b9a\u306e\u30d6\u30ed\u30c3\u30af\u30bf\u30a4\u30d7\u306b\u52b9\u7387\u7684\u306a\u30c4\u30fc\u30eb\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u30c0\u30a4\u30e4\u30e2\u30f3\u30c9\u30c4\u30fc\u30eb\u306f\u8010\u4e45\u6027\u304c\u3042\u308a\u307e\u3059\u304c\u3001\u30b2\u30fc\u30e0\u306e\u958b\u59cb\u6642\u306b\u7279\u5b9a\u306e\u7d20\u6750\u3092\u53ce\u7a6b\u3059\u308b\u306b\u306f\u6700\u9069\u3067\u306f\u306a\u3044\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u4f5c\u6210\u3059\u308b\u3068\u3001\u4e00\u822c\u7684\u306a\u7d20\u6750\u304b\u3089\u30b9\u30bf\u30fc\u30c8\u3057\u3066\u3001\u3088\u308a\u8907\u96d1\u306a\u7d20\u6750\u3092\u901a\u3058\u3066\u30b2\u30fc\u30e0\u3092\u9032\u3081\u3066\u3044\u304f\u305f\u3081\u306b\u3001\u30ea\u30bd\u30fc\u30b9\u3092\u63a1\u6398\u3059\u308b\u6700\u9069\u306a\u624b\u9806\u3092\u6c7a\u5b9a\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30d6\u30ed\u30c3\u30af\u30ef\u30fc\u30eb\u30c9\u3067\u591c\u9593\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\u304b\u3089\u5b88\u308b\u305f\u3081\u306b\u3001\u6700\u3082\u52b9\u679c\u7684\u306a\u9632\u5fa1\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f\u3069\u306e\u30c8\u30e9\u30c3\u30d7\u3092\u512a\u5148\u3059\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u30d6\u30ed\u30c3\u30af\u30ef\u30fc\u30eb\u30c9\u3067\u306e\u52b9\u679c\u7684\u306a\u62e0\u70b9\u9632\u885b\u306f\u3001\u6226\u7565\u7684\u306a\u601d\u8003\u3068\u8a08\u753b\u304c\u5fc5\u8981\u3067\u3059\u3002\u77f3\u30ec\u30f3\u30ac\u307e\u305f\u306f\u5f37\u5316\u30d6\u30ed\u30c3\u30af\u306a\u3069\u306e\u7d20\u6750\u3092\u4f7f\u7528\u3057\u3066\u3001\u62e0\u70b9\u306e\u5468\u56f2\u306b\u5b89\u5168\u306a\u5883\u754c\u7dda\u3092\u69cb\u7bc9\u3059\u308b\u3053\u3068\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u30e2\u30d6\u304c\u30b8\u30e3\u30f3\u30d7\u3057\u3066\u304f\u308b\u306e\u3092\u9632\u3050\u305f\u3081\u306b\u3001\u5c11\u306a\u304f\u3068\u30823\u30d6\u30ed\u30c3\u30af\u306e\u9ad8\u3044\u58c1\u3092\u5efa\u8a2d\u3059\u308b\u3053\u3068\u3092\u691c\u8a0e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30c8\u30e9\u30c3\u30d7\u3082\u91cd\u8981\u306a\u5f79\u5272\u3092\u679c\u305f\u3057\u307e\u3059\u3002\u30b7\u30f3\u30d7\u30eb\u306a\u843d\u3068\u3057\u7a74\u3084\u3001\u5727\u529b\u677f\u5f0f\u306e\u30c0\u30fc\u30c4\u30e9\u30f3\u30c1\u30e3\u30fc\u3067\u3001\u8fc5\u901f\u306b\u8105\u5a01\u3092\u6392\u9664\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u62e0\u70b9\u306e\u5468\u56f2\u306b\u6eb6\u5ca9\u3067\u6e80\u305f\u3055\u308c\u305f\u5800\u306f\u3001\u591a\u304f\u306e\u30af\u30ea\u30fc\u30c1\u30e3\u30fc\u306b\u3068\u3063\u3066\u8d8a\u3048\u3089\u308c\u306a\u3044\u969c\u58c1\u3068\u3057\u3066\u6a5f\u80fd\u3067\u304d\u307e\u3059\u3002\u7167\u660e\u3092\u5fd8\u308c\u306a\u3044\u3067\u304f\u3060\u3055\u3044\uff01\u660e\u308b\u304f\u7167\u3089\u3055\u308c\u305f\u30a8\u30ea\u30a2\u306f\u3001\u307b\u3068\u3093\u3069\u306e\u6575\u30e2\u30d6\u306e\u30b9\u30dd\u30fc\u30f3\u3092\u9632\u304e\u307e\u3059\u3002\u5b8c\u74a7\u306a\u30e2\u30f3\u30b9\u30bf\u30fc\u9632\u885b\u8981\u585e\u3092\u7bc9\u304f\u305f\u3081\u306b\u3001\u3055\u307e\u3056\u307e\u306a\u7d44\u307f\u5408\u308f\u305b\u3092\u8a66\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u62e0\u70b9\u9632\u885b\u306f\u3001\u69cb\u9020\u7684\u306a\u9632\u885b\u3068\u30a2\u30af\u30c6\u30a3\u30d6\u306a\u7f60\u306e\u4e21\u65b9\u3092\u4f7f\u7528\u3059\u308b\u3001\u591a\u5c64\u7684\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u304c\u5fc5\u8981\u3067\u3059\u3002"}, {"question": "BW\u306e\u79d8\u5bc6\uff1a\u5c0f\u9ea6\u3084\u30ab\u30dc\u30c1\u30e3\u306a\u3069\u306e\u30ea\u30bd\u30fc\u30b9\u306e\u81ea\u52d5\u8fb2\u5834\u3092\u30d6\u30ed\u30c3\u30af\u30ef\u30fc\u30eb\u30c9\u3067\u3069\u306e\u3088\u3046\u306b\u4f5c\u6210\u3057\u307e\u3059\u304b\uff1f\u5fc5\u8981\u306a\u4e3b\u306a\u30b3\u30f3\u30dd\u30fc\u30cd\u30f3\u30c8\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d6\u30ed\u30c3\u30af\u30ef\u30fc\u30eb\u30c9\u306e\u81ea\u52d5\u8fb2\u5834\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u7d99\u7d9a\u7684\u306a\u64cd\u4f5c\u306a\u3057\u306b\u8cc7\u6e90\u3092\u53ce\u7a6b\u3059\u308b\u305f\u3081\u306b\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u5229\u7528\u3057\u307e\u3059\u3002\u91cd\u8981\u306a\u30b3\u30f3\u30dd\u30fc\u30cd\u30f3\u30c8\u306b\u306f\u3001\u6c34\u5206\u88dc\u7d66\u306e\u305f\u3081\u306e\u6c34\u6e90\u3001\u30c9\u30ed\u30c3\u30d7\u3055\u308c\u305f\u30a2\u30a4\u30c6\u30e0\u3092\u53ce\u96c6\u3059\u308b\u305f\u3081\u306e\u30db\u30c3\u30d1\u30fc\u3001\u4f5c\u7269\u3092\u81ea\u52d5\u7684\u306b\u53ce\u7a6b\u3059\u308b\u305f\u3081\u306e\u30d4\u30b9\u30c8\u30f3\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u57fa\u672c\u7684\u306a\u5c0f\u9ea6\u8fb2\u5834\u3067\u306f\u3001\u305d\u306e\u9593\u306b\u6c34\u8def\u304c\u3042\u308b\u8fb2\u8015\u5730\u306e\u5217\u3092\u914d\u7f6e\u3057\u307e\u3059\u3002\u8fb2\u8015\u5730\u306e\u3059\u3050\u4e0a\u306b\u306f\u3001\u30bf\u30a4\u30de\u30fc\u56de\u8def\u306b\u63a5\u7d9a\u3055\u308c\u305f\u30d4\u30b9\u30c8\u30f3\u3092\u914d\u7f6e\u3067\u304d\u307e\u3059\uff08STEP1\uff09\u3002\u30bf\u30a4\u30de\u30fc\u304c\u30a2\u30af\u30c6\u30a3\u30d6\u306b\u306a\u308b\u3068\u3001\u30d4\u30b9\u30c8\u30f3\u304c\u5c0f\u9ea6\u3092\u62bc\u3057\u4e0a\u3052\u3001\u305d\u306e\u7d50\u679c\u3001\u5c0f\u9ea6\u304c\u58ca\u308c\u3001\u30c9\u30ed\u30c3\u30d7\u3057\u307e\u3059\uff08STEP2\uff09\u3002\u8fb2\u5730\u306e\u4e0b\u306e\u30db\u30c3\u30d1\u30fc\u304c\u30c9\u30ed\u30c3\u30d7\u3055\u308c\u305f\u5c0f\u9ea6\u3092\u53ce\u96c6\u3057\u3001\u30b9\u30c8\u30ec\u30fc\u30b8\u30c1\u30a7\u30b9\u30c8\u306b\u904b\u3076\u3053\u3068\u304c\u3067\u304d\u307e\u3059\uff08STEP3\uff09\u3002\u30ea\u30bd\u30fc\u30b9\u306e\u81ea\u52d5\u5316\u306b\u3088\u308a\u3001\u30b2\u30fc\u30e0\u306e\u3088\u308a\u91cd\u8981\u306a\u8981\u7d20\u306b\u96c6\u4e2d\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d6\u30ed\u30c3\u30af\u30ef\u30fc\u30eb\u30c9\u306e\u3055\u307e\u3056\u307e\u306a\u30d0\u30a4\u30aa\u30fc\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f\u5404\u30d0\u30a4\u30aa\u30fc\u30e0\u306f\u3001\u3069\u306e\u3088\u3046\u306a\u72ec\u81ea\u306e\u8cc7\u6e90\u3084\u8ab2\u984c\u3092\u63d0\u4f9b\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d6\u30ed\u30c3\u30af\u30ef\u30fc\u30eb\u30c9\u306f\u3001\u305d\u308c\u305e\u308c\u72ec\u81ea\u306e\u8cc7\u6e90\u3001\u8ab2\u984c\u3001\u305d\u3057\u3066\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u6a5f\u4f1a\u3092\u63d0\u4f9b\u3059\u308b\u591a\u69d8\u306a\u30d0\u30a4\u30aa\u30fc\u30e0\u3092\u5099\u3048\u3066\u3044\u307e\u3059\u3002\u68ee\u6797\u30d0\u30a4\u30aa\u30fc\u30e0\u306f\u6728\u6750\u3084\u53d7\u52d5\u7684\u306a\u52d5\u7269\u304c\u8c4a\u5bcc\u3067\u3001\u7406\u60f3\u7684\u306a\u51fa\u767a\u5730\u70b9\u3068\u306a\u308a\u307e\u3059\u3002\u7802\u6f20\u30d0\u30a4\u30aa\u30fc\u30e0\u306f\u7802\u3068\u30b5\u30dc\u30c6\u30f3\u3092\u63d0\u4f9b\u3057\u307e\u3059\u304c\u3001\u6c34\u304c\u4e0d\u8db3\u3057\u3066\u3044\u307e\u3059\u3002\u96ea\u306e\u30d0\u30a4\u30aa\u30fc\u30e0\u306f\u3001\u51cd\u3048\u308b\u3088\u3046\u306a\u6c17\u6e29\u3068\u9650\u3089\u308c\u305f\u8996\u754c\u3068\u3044\u3046\u8ab2\u984c\u3092\u63d0\u793a\u3057\u307e\u3059\u3002\u3088\u308a\u6df1\u3044\u5206\u6790\u306e\u305f\u3081\u306b\u3001\u8cc7\u6e90\uff08\u4e0d\u8db3\u3057\u3066\u3044\u308b/\u8c4a\u5bcc\uff09\u3092\u8868\u3059X\u8ef8\u3068\u8ab2\u984c\uff08\u4f4e\u3044/\u9ad8\u3044\uff09\u3092\u8868\u3059Y\u8ef8\u306e\u8c61\u9650\u30c1\u30e3\u30fc\u30c8\u306e\u3088\u3046\u306a\u30b0\u30ea\u30c3\u30c9\u3092\u4f5c\u6210\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30ad\u30ce\u30b3\u5cf6\u306e\u3088\u3046\u306a\u30d0\u30a4\u30aa\u30fc\u30e0\u306f\u72ec\u81ea\u306e\u8cc7\u6e90\u3068\u53d7\u52d5\u7684\u306a\u30e2\u30d6\u306e\u51fa\u73fe\u7387\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u5404\u30d0\u30a4\u30aa\u30fc\u30e0\u306e\u30cb\u30e5\u30a2\u30f3\u30b9\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u3068\u63a2\u691c\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002"}, {"question": "\u30d6\u30ed\u30c3\u30af\u30ef\u30fc\u30eb\u30c9\u306e\u30e2\u30d6\u51fa\u73fe\u30b7\u30b9\u30c6\u30e0\u3092\u652f\u914d\u3059\u308b\u6839\u672c\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u8aac\u660e\u3067\u304d\u307e\u3059\u304b\uff1f\u5149\u30ec\u30d9\u30eb\u3084\u30d6\u30ed\u30c3\u30af\u306e\u7a2e\u985e\u306a\u3069\u3001\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u8981\u56e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d6\u30ed\u30c3\u30af\u30ef\u30fc\u30eb\u30c9\u306e\u30e2\u30d6\u51fa\u73fe\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u8981\u56e0\u306b\u3088\u3063\u3066\u652f\u914d\u3055\u308c\u3066\u304a\u308a\u3001\u6700\u3082\u91cd\u8981\u306a\u306e\u306f\u5149\u30ec\u30d9\u30eb\u3067\u3059\u3002\u6575\u30e2\u30d6\u306f\u4e00\u822c\u7684\u306b\u5149\u30ec\u30d9\u30eb\u304c7\u4ee5\u4e0b\u3067\u3042\u308b\u9818\u57df\u306b\u51fa\u73fe\u3057\u307e\u3059\u3002\u3064\u307e\u308a\u3001\u6697\u3044\u3001\u7167\u660e\u306e\u306a\u3044\u9818\u57df\u306f\u3001\u4e3b\u8981\u306a\u51fa\u73fe\u5834\u6240\u3067\u3059\u3002\u7570\u306a\u308b\u30d6\u30ed\u30c3\u30af\u306e\u7a2e\u985e\u3082\u51fa\u73fe\u306b\u5f71\u97ff\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u7279\u5b9a\u306e\u30e2\u30d6\u306f\u3001\u7802\u6f20\u30d0\u30a4\u30aa\u30fc\u30e0\u306e\u30b9\u30b1\u30eb\u30c8\u30f3\u306e\u3088\u3046\u306b\u3001\u7279\u5b9a\u306e\u30d6\u30ed\u30c3\u30af\u306b\u51fa\u73fe\u3059\u308b\u53ef\u80fd\u6027\u304c\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002\u307e\u305f\u3001\u65e5\u4e2d\u306e\u6642\u9593\u5e2f\u3082\u51fa\u73fe\u306b\u5f71\u97ff\u3057\u307e\u3059\u3002\u591c\u9593\u306f\u3001\u30e2\u30d6\u306e\u6d3b\u52d5\u304c\u5897\u52a0\u3059\u308b\u305f\u3081\u3001\u4e00\u822c\u7684\u306b\u3088\u308a\u5371\u967a\u3067\u3059\u3002\u3053\u308c\u3089\u306e\u6839\u672c\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u884c\u52d5\u3068\u62e0\u70b9\u306e\u8a2d\u8a08\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u5149\u30ec\u30d9\u30eb\u306f\u3001\u30c8\u30fc\u30c1\u3001\u30e9\u30f3\u30bf\u30f3\u306a\u3069\u306e\u5149\u6e90\u306b\u3088\u3063\u3066\u4eba\u5de5\u7684\u306b\u5236\u5fa1\u3067\u304d\u307e\u3059\u3002"}, {"question": "PC\u7248\u3001\u30b3\u30f3\u30bd\u30fc\u30eb\u7248\u3001\u30e2\u30d0\u30a4\u30eb\u7248\u306e\u9593\u3067\u3001\u30d6\u30ed\u30c3\u30af\u30ef\u30fc\u30eb\u30c9\u306e\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30d7\u30ec\u30a4\u307e\u305f\u306f\u30c7\u30fc\u30bf\u79fb\u884c\u304c\u53ef\u80fd\u3067\u3059\u304b\uff1f", "answer": "\u30d6\u30ed\u30c3\u30af\u30ef\u30fc\u30eb\u30c9\u3067\u306e\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30d7\u30ec\u30a4\u3068\u30c7\u30fc\u30bf\u79fb\u884c\u306e\u53ef\u7528\u6027\u306f\u3001\u7279\u5b9a\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u3068\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u30dd\u30ea\u30b7\u30fc\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u3002\u4e00\u822c\u7684\u306b\u3001PC\u7248\u3068\u4e00\u90e8\u306e\u30b3\u30f3\u30bd\u30fc\u30eb\u7248\u306e\u30d6\u30ed\u30c3\u30af\u30ef\u30fc\u30eb\u30c9\u306f\u3001\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u4e00\u7dd2\u306b\u30d7\u30ec\u30a4\u3067\u304d\u308b\u3088\u3046\u306b\u3001\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3060\u3057\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u56fa\u6709\u306e\u30bb\u30fc\u30d6\u30d5\u30a1\u30a4\u30eb\u5f62\u5f0f\u3068\u30bb\u30ad\u30e5\u30ea\u30c6\u30a3\u5bfe\u7b56\u306e\u305f\u3081\u3001\u30c7\u30fc\u30bf\u79fb\u884c\u306f\u305d\u308c\u307b\u3069\u4e00\u822c\u7684\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30b5\u30dd\u30fc\u30c8\u3068\u30c7\u30fc\u30bf\u8ee2\u9001\u30aa\u30d7\u30b7\u30e7\u30f3\u306b\u95a2\u3059\u308b\u5177\u4f53\u7684\u306a\u60c5\u5831\u306f\u3001\u516c\u5f0f\u306e\u30d6\u30ed\u30c3\u30af\u30ef\u30fc\u30eb\u30c9\u30a6\u30a7\u30d6\u30b5\u30a4\u30c8\u307e\u305f\u306f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u30aa\u30f3\u30e9\u30a4\u30f3\u30b5\u30fc\u30d3\u30b9\u3067\u3054\u78ba\u8a8d\u304f\u3060\u3055\u3044\u3002\u3059\u3079\u3066\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u304c\u540c\u3058\u3088\u3046\u306b\u4f5c\u3089\u308c\u3066\u3044\u308b\u3068\u306f\u9650\u308a\u307e\u305b\u3093\u3002\u6a5f\u80fd\u306b\u9055\u3044\u304c\u3042\u308b\u5834\u5408\u3001\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u8a31\u53ef\u3059\u308b\u3068\u306f\u9650\u308a\u307e\u305b\u3093\u3002"}, {"question": "\u30d6\u30ed\u30c3\u30af\u30ef\u30fc\u30eb\u30c9\u3067\u7d50\u6676\u6d1e\u7a9f\u3092\u898b\u3064\u3051\u308b\u65b9\u6cd5\u3068\u3001\u767a\u898b\u5f8c\u306b\u30e6\u30cb\u30fc\u30af\u306a\u30af\u30e9\u30d5\u30c8\u30ec\u30b7\u30d4\u3084\u30a4\u30d9\u30f3\u30c8\u3092\u30c8\u30ea\u30ac\u30fc\u3059\u308b\u65b9\u6cd5\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u7d50\u6676\u6d1e\u7a9f\u306f\u3001\u30d6\u30ed\u30c3\u30af\u30ef\u30fc\u30eb\u30c9\u306e\u96a0\u308c\u30d0\u30a4\u30aa\u30fc\u30e0\u3067\u3042\u308a\u3001\u3057\u3070\u3057\u3070\u5730\u4e0b\u6df1\u304f\u3084\u5c71\u5cb3\u30d0\u30a4\u30aa\u30fc\u30e0\u5185\u306b\u3042\u308a\u307e\u3059\u3002\u30e6\u30cb\u30fc\u30af\u306a\u7d50\u6676\u5f62\u6210\u3068\u5149\u308b\u74b0\u5883\u304c\u7279\u5fb4\u3067\u3059\u3002\u305d\u308c\u3089\u3092\u898b\u3064\u3051\u308b\u306b\u306f\u3001\u5fb9\u5e95\u7684\u306b\u6d1e\u7a9f\u3092\u63a2\u691c\u3057\u3001\u7570\u5e38\u306a\u5730\u8cea\u5b66\u7684\u7279\u5fb4\u306e\u3042\u308b\u30a8\u30ea\u30a2\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u7d50\u6676\u6d1e\u7a9f\u306b\u306f\u3001\u8cb4\u91cd\u306a\u5b9d\u77f3\u3084\u7d50\u6676\u306a\u3069\u306e\u30e6\u30cb\u30fc\u30af\u306a\u8cc7\u6e90\u304c\u542b\u307e\u308c\u3066\u304a\u308a\u3001\u9ad8\u5ea6\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u30af\u30e9\u30d5\u30c8\u3057\u305f\u308a\u3001\u7279\u5225\u306a\u30a4\u30d9\u30f3\u30c8\u3092\u30c8\u30ea\u30ac\u30fc\u3057\u305f\u308a\u3059\u308b\u305f\u3081\u306b\u4f7f\u7528\u3055\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u3053\u308c\u3089\u306e\u5b9d\u77f3\u3092\u4f7f\u7528\u3057\u3066\u300c\u30af\u30ea\u30b9\u30bf\u30e9\u30e0\u30ec\u30c3\u30c8\u300d\u3092\u30af\u30e9\u30d5\u30c8\u3059\u308b\u3068\u3001\u96a0\u3055\u308c\u305f\u30af\u30a8\u30b9\u30c8\u30e9\u30a4\u30f3\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u308b\u304b\u3001\u65b0\u3057\u3044\u6b21\u5143\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u6d1e\u7a9f\u306e\u958b\u53e3\u90e8\u306b\u304b\u3059\u304b\u306a\u5149\u304c\u3042\u308b\u306a\u3069\u306e\u5fae\u5999\u306a\u8996\u899a\u7684\u306a\u624b\u304c\u304b\u308a\u3092\u63a2\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u306f\u3001\u7d50\u6676\u6d1e\u7a9f\u304c\u8fd1\u63a5\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u793a\u3057\u3066\u3044\u307e\u3059\u3002"}]
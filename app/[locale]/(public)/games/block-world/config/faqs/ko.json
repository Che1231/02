[{"question": "\ube14\ub85d \uc6d4\ub4dc: \uc0c8 \ud50c\ub808\uc774\uc5b4\ub85c\uc11c \ube14\ub85d\uc744 \uc62c\ubc14\ub974\uac8c \ubc30\uce58\ud558\ub294 \ubc29\ubc95\uacfc \ud53c\ud574\uc57c \ud560 \uc77c\ubc18\uc801\uc778 \uc2e4\uc218\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ube14\ub85d \uc6d4\ub4dc\uc758 \uc0c8 \ud50c\ub808\uc774\uc5b4\ub85c\uc11c \ube14\ub85d \ubc30\uce58\ub294 \uae30\ubcf8\uc785\ub2c8\ub2e4. \ube14\ub85d\uc744 \ubc30\uce58\ud558\ub824\uba74 \uc778\ubca4\ud1a0\ub9ac\uc5d0\uc11c \uc120\ud0dd\ud558\uace0 \uac8c\uc784 \uc138\uacc4\uc758 \uc6d0\ud558\ub294 \uc704\uce58\ub97c \ud074\ub9ad\ud558\uc2ed\uc2dc\uc624. \uc77c\ubc18\uc801\uc778 \uc2e4\uc218\ub294 \uc774\ubbf8 \ub2e4\ub978 \ube14\ub85d\uc774 \uc788\ub294 \uacf3\uc774\ub098 \uce90\ub9ad\ud130\uac00 \ub3c4\ub2ec\ud560 \uc218 \uc5c6\ub294 \uacf3\uc5d0 \ube14\ub85d\uc744 \ubc30\uce58\ud558\ub824\ub294 \uac83\uc785\ub2c8\ub2e4. \ub610\ud55c \uc911\ub825\uc5d0 \uc720\uc758\ud558\uc2ed\uc2dc\uc624! \ube14\ub85d\uc740 \uc801\uc808\ud558\uac8c \uc9c0\uc9c0\ub418\uc9c0 \uc54a\uc73c\uba74 \ub5a8\uc5b4\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud0c0\uc6cc\ub97c \uac74\uc124\ud560 \ub54c \ub113\uc740 \ubc11\uba74(STEP1)\uc73c\ub85c \uc2dc\uc791\ud558\uc5ec \uc704\ucabd\uc73c\ub85c \uac08\uc218\ub85d \uc810\ucc28 \uc881\ud600\uc9c0\ub3c4\ub85d \ud569\ub2c8\ub2e4(STEP2). \ucd94\uac00 \uc548\uc815\uc131\uc744 \uc81c\uacf5\ud558\uae30 \uc704\ud574 \uc606\uba74\uc5d0 \uc9c0\uc9c0 \ube14\ub85d\uc744 \ubc30\uce58\ud558\uc2ed\uc2dc\uc624(STEP3). \ube14\ub85d\uc744 \ub808\uace0 \ube14\ub85d\uacfc \uac19\uc774 \uc0dd\uac01\ud558\uc2ed\uc2dc\uc624. \uac01 \ube14\ub85d\uc5d0\ub294 \uacac\uace0\ud55c \uae30\ucd08\uac00 \ud544\uc694\ud569\ub2c8\ub2e4."}, {"question": "\uc81c \ube14\ub85d \uc6d4\ub4dc \uace1\uad2d\uc774\uac00 \ub108\ubb34 \ube68\ub9ac \ubd80\uc11c\uc9c0\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c? \ub3c4\uad6c \uacc4\uce35\uacfc \ub0b4\uad6c\uc131\uc740 \uc5b4\ub5bb\uac8c \ub2e4\ub985\ub2c8\uae4c?", "answer": "\uace1\uad2d\uc774\uac00 \ube68\ub9ac \ubd80\uc11c\uc9c0\ub294 \uac83\uc740 \uc544\ub9c8\ub3c4 \ud558\uc704 \uacc4\uce35 \ub3c4\uad6c\uc774\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \ube14\ub85d \uc6d4\ub4dc\ub294 \ub0b4\uad6c\uc131\uacfc \ucc44\uad11 \uc18d\ub3c4\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc11c\ub85c \ub2e4\ub978 \uc7ac\uc9c8\uc744 \uac00\uc9c4 \uacc4\uce35\ubcc4 \ub3c4\uad6c\ub97c \uac16\ucd94\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ub098\ubb34 \uace1\uad2d\uc774\ub294 \uac00\uc7a5 \uc57d\ud558\uace0, \uadf8 \ub2e4\uc74c\uc73c\ub85c \ub3cc, \ucca0, \uae08, \ub2e4\uc774\uc544\ubaac\ub4dc(\uad6c\uc131 \ube44\uad50\ud45c) \uc21c\uc11c\uc785\ub2c8\ub2e4. \ub098\ubb34 \uace1\uad2d\uc774\ub294 \ub2e8 20\ud68c \uc0ac\uc6a9\ubc16\uc5d0 \uc9c0\uc18d\ub418\uc9c0 \uc54a\uc744 \uc218 \uc788\uc9c0\ub9cc \ub2e4\uc774\uc544\ubaac\ub4dc \uace1\uad2d\uc774\ub294 \uc218\ubc31 \ubc88 \uc9c0\uc18d\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub354 \ub098\uc740 \uc790\uc6d0\uc744 \ud68d\ub4dd\ud558\ub294 \uc989\uc2dc \uace1\uad2d\uc774\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ub3cc \ucc44\uad11\uc5d0\ub294 \uc801\uc5b4\ub3c4 \ub098\ubb34 \uace1\uad2d\uc774\uac00 \ud544\uc694\ud558\uace0, \ucca0\uad11\uc11d\uc5d0\ub294 \ub3cc \uace1\uad2d\uc774 \ub610\ub294 \uadf8 \uc774\uc0c1\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc81c\uc791\ub300\uc5d0\uc11c \ub098\ubb34\ub9c9\ub300\uc640 \uc790\uac08\uc744 \uacb0\ud569\ud558\uc5ec \ub3cc \uace1\uad2d\uc774\ub97c \uc81c\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ube14\ub85d \uc6d4\ub4dc\uc5d0\uc11c \uc6a9\uad11\ub85c\uc758 \ubaa9\uc801\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ub354 \ub098\uc740 \uc544\uc774\ud15c\uacfc \uc790\uc6d0\uc744 \ub9cc\ub4e4\uae30 \uc704\ud574 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ube14\ub85d \uc6d4\ub4dc\uc5d0\uc11c \uc6a9\uad11\ub85c\ub294 \ud544\uc218\uc801\uc778 \uc81c\uc791 \ub3c4\uad6c\uc785\ub2c8\ub2e4. \uc6d0\uc7ac\ub8cc\ub97c \ub354 \uc720\uc6a9\ud55c \ud615\ud0dc\ub85c \uc81c\ub828\ud558\ub294 \ub370 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc6a9\uad11\ub85c\ub97c \uc0ac\uc6a9\ud558\ub824\uba74 \uc5f0\ub8cc(\uc608: \ub098\ubb34, \uc22f)\uc640 \uc81c\ub828\ud558\ub824\ub294 \uc7ac\ub8cc(\uc608: \ucca0\uad11\uc11d)\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \uc5f0\ub8cc\ub294 \uc544\ub798 \uc2ac\ub86f\uc5d0, \uc7ac\ub8cc\ub294 \uc704\ucabd \uc2ac\ub86f\uc5d0 \ub123\uc2b5\ub2c8\ub2e4. \uadf8\ub7ec\uba74 \uc6a9\uad11\ub85c\ub294 \ucca0\uad11\uc11d\uc5d0\uc11c \ucca0\uad34\uc640 \uac19\uc774 \uc6d0\uc7ac\ub8cc\ub97c \uc815\uc81c\ub41c \uc81c\ud488\uc73c\ub85c \ubcc0\ud658\ud569\ub2c8\ub2e4. \uc774 \ucca0\uad34\ub294 \uac11\uc637 \ubc0f \ub3c4\uad6c\uc640 \uac19\uc740 \ub354 \uace0\uae09 \uc544\uc774\ud15c\uc744 \uc81c\uc791\ud558\ub294 \ub370 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc6a9\uad11\ub85c\ub294 \uac70\uce5c \uc7ac\ub8cc\ub97c \uadc0\uc911\ud55c \uad6c\uc131 \uc694\uc18c\ub85c \ubcc0\ud658\ud558\ub294 \ub9c8\ubc95 \uac19\uc740 \uc6a9\uad11\ub85c\ub77c\uace0 \uc0dd\uac01\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ube14\ub85d \uc6d4\ub4dc \uace0\uae09 \uc804\ub7b5: \ub2e4\ub978 \uc778\ucc48\ud2b8\ub098 \uae30\uc220\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc790\uc6d0 \uc218\uc9d1\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c? \ud6a8\uc728\uc131\uc744 \ub192\uc774\uae30 \uc704\ud574?", "answer": "\ube14\ub85d \uc6d4\ub4dc\uc5d0\uc11c \uc790\uc6d0 \uc218\uc9d1 \ucd5c\uc801\ud654\ub294 \ud6a8\uc728\uc131\uc744 \ub192\uc774\uae30 \uc704\ud574 \uc778\ucc48\ud2b8 \ubc0f \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc744 \ud65c\uc6a9\ud558\ub294 \uac83\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \ub3c4\uad6c\uc5d0 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \uc778\ucc48\ud2b8 \uc911 \ud558\ub098\ub294 '\ud589\uc6b4'\uc778\ub370, \uc774\ub294 \ucc44\uad11 \uc2dc \ub4dc\ub86d\ub418\ub294 \uc544\uc774\ud15c \uc218\ub97c \ub298\ub9bd\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud589\uc6b4 III \uace1\uad2d\uc774\ub97c \ub2e4\uc774\uc544\ubaac\ub4dc \uad11\uc11d\uc5d0 \uc0ac\uc6a9\ud558\uba74 \ube14\ub85d\ub2f9 \ub2e4\uc774\uc544\ubaac\ub4dc\uac00 \uc5ec\ub7ec \uac1c \uc5bb\uc5b4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uae30\uc220\uc740 \ud2b9\uc815 \ube14\ub85d \uc720\ud615\uc5d0 \ub354 \ud6a8\uc728\uc801\uc778 \ub3c4\uad6c\ub97c \uc0ac\uc6a9\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \ub2e4\uc774\uc544\ubaac\ub4dc \ub3c4\uad6c\ub294 \ub0b4\uad6c\uc131\uc774 \uc788\uc9c0\ub9cc \uac8c\uc784 \ucd08\ubc18\uc5d0 \ud2b9\uc815 \uc7ac\ub8cc\ub97c \uc218\ud655\ud558\ub294 \ub370 \ucd5c\uc120\uc758 \uc120\ud0dd\uc774 \uc544\ub2d0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud50c\ub85c\uc6b0 \ucc28\ud2b8\ub294 \uc77c\ubc18\uc801\uc778 \uc7ac\ub8cc\ubd80\ud130 \ub354 \ubcf5\uc7a1\ud55c \uc7ac\ub8cc\ub97c \uac70\uccd0 \uac8c\uc784\uc744 \uc9c4\ud589\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ub294 \ucd5c\uc801\uc758 \uc790\uc6d0 \ucc44\uad11 \uc21c\uc11c\ub97c \uacb0\uc815\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ubc24\uc5d0 \ubaac\uc2a4\ud130\ub85c\ubd80\ud130 \uae30\uc9c0\ub97c \ubcf4\ud638\ud558\uae30 \uc704\ud55c \ube14\ub85d \uc6d4\ub4dc\uc5d0\uc11c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \uae30\ubcf8 \ubc29\uc5b4 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5a4 \ud568\uc815\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uace0\ub824\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\ube14\ub85d \uc6d4\ub4dc\uc5d0\uc11c \ud6a8\uacfc\uc801\uc778 \uae30\uc9c0 \ubc29\uc5b4\ub294 \uc804\ub7b5\uc801\uc778 \uc0ac\uace0\uc640 \uacc4\ud68d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub3cc\ubcbd\ub3cc\uc774\ub098 \uac15\ud654\ub41c \ube14\ub85d\uacfc \uac19\uc740 \uc790\uc7ac\ub97c \uc0ac\uc6a9\ud558\uc5ec \uae30\uc9c0 \uc8fc\ubcc0\uc5d0 \uc548\uc804\ud55c \uc8fc\ubcc0 \uc9c0\uc5ed\uc744 \ub9cc\ub4dc\ub294 \uac83\uc744 \uc6b0\uc120\uc2dc\ud558\uc2ed\uc2dc\uc624. \ubab9\uc774 \ub6f0\uc5b4\ub118\uc9c0 \ubabb\ud558\ub3c4\ub85d \ubcbd\uc744 \uc801\uc5b4\ub3c4 \uc138 \ube14\ub85d \ub192\uc774\ub85c \ub9cc\ub4dc\uc2ed\uc2dc\uc624. \ud568\uc815\ub3c4 \uc911\uc694\ud55c \uc5ed\ud560\uc744 \ud569\ub2c8\ub2e4. \uac04\ub2e8\ud55c \uad6c\ub369\uc774 \ud568\uc815\uc774\ub098 \uc555\ub825\ud310 \ud65c\uc131\ud654 \ub358\uc9c0\uae30 \ud568\uc815\uc740 \ube60\ub974\uac8c \uc704\ud611\uc744 \uc81c\uac70\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uae30\uc9c0 \uc8fc\ubcc0\uc5d0 \uc6a9\uc554\uc73c\ub85c \uac00\ub4dd \ucc2c \ud574\uc790\ub294 \ub9ce\uc740 \uc0dd\ubb3c\uccb4\uc5d0 \ub300\ud55c \ud1b5\ud589 \ubd88\uac00 \uc7a5\ubcbd\uc73c\ub85c \uc791\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc870\uba85\uc744 \uae30\uc5b5\ud558\uc138\uc694! \ubc1d\uac8c \ube5b\ub098\ub294 \uc9c0\uc5ed\uc740 \ub300\ubd80\ubd84\uc758 \uc801\ub300\uc801\uc778 \ubab9\uc758 \uc0dd\uc131\uc744 \ubc29\uc9c0\ud569\ub2c8\ub2e4. \uc644\ubcbd\ud55c \ubc18 \ubaac\uc2a4\ud130 \uc694\uc0c8\ub97c \ub9cc\ub4e4\uae30 \uc704\ud574 \uc11c\ub85c \ub2e4\ub978 \uc870\ud569\uc744 \uc2e4\ud5d8\ud574\ubcf4\uc138\uc694. \uae30\uc9c0\ub97c \ubc29\uc5b4\ud558\ub294 \uac83\uc740 \uad6c\uc870\uc801 \ubc29\uc5b4\uc640 \uc801\uadf9\uc801\uc778 \ud568\uc815 \ubaa8\ub450\ub97c \uc774\uc6a9\ud558\ub294 \ub2e4\uce35\uc801 \uc811\uadfc \ubc29\uc2dd\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."}, {"question": "\ube14\ub85d \uc6d4\ub4dc\uc5d0\uc11c \ubc00\uc774\ub098 \ud638\ubc15\uacfc \uac19\uc740 \uc790\uc6d0\uc744 \uc704\ud55c \uc790\ub3d9 \ub18d\uc7a5\uc744 \ub9cc\ub4dc\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5a4 \uc8fc\uc694 \uad6c\uc131 \uc694\uc18c\uac00 \ud544\uc694\ud569\ub2c8\uae4c?", "answer": "\ube14\ub85d \uc6d4\ub4dc\uc5d0\uc11c \uc790\ub3d9 \ub18d\uc7a5\uc740 \uc9c0\uc18d\uc801\uc778 \ud50c\ub808\uc774\uc5b4 \uc0c1\ud638 \uc791\uc6a9 \uc5c6\uc774 \uc790\uc6d0\uc744 \uc218\ud655\ud558\ub3c4\ub85d \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc744 \ud65c\uc6a9\ud569\ub2c8\ub2e4. \uc8fc\uc694 \uad6c\uc131 \uc694\uc18c\uc5d0\ub294 \uc218\ubd84\uc744 \uc704\ud55c \ubb3c\uc6d0, \ub5a8\uc5b4\uc9c0\ub294 \uc544\uc774\ud15c\uc744 \uc218\uc9d1\ud558\ub294 \ud5db\uac04 \ubc0f \uc791\ubb3c\uc744 \uc790\ub3d9\uc73c\ub85c \uc218\ud655\ud558\ub294 \ud53c\uc2a4\ud1a4\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uae30\ubcf8\uc801\uc778 \ubc00 \ub18d\uc7a5\uc5d0\ub294 \uadf8 \uc0ac\uc774\uc5d0 \ubb3c\uae38\uc774 \uc788\ub294 \ubc2d\uc758 \uc904\uc744 \ubc30\uce58\ud558\ub294 \uac83\uc73c\ub85c \uad6c\uc131\ub429\ub2c8\ub2e4. \ubc2d \uc704\uc5d0\ub294 \ud0c0\uc774\uba38 \ud68c\ub85c\uc5d0 \uc5f0\uacb0\ub41c \ud53c\uc2a4\ud1a4\uc744 \ubc30\uce58\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4(STEP1). \ud0c0\uc774\uba38\uac00 \ud65c\uc131\ud654\ub418\uba74 \ud53c\uc2a4\ud1a4\uc774 \ubc00\uc744 \ubc00\uc5b4\ub0b4\uc5b4 \ud30c\uad34\ud558\uace0 \ub5a8\uc5b4\ub728\ub9bd\ub2c8\ub2e4(STEP2). \ubc2d \uc544\ub798\uc758 \ud5db\uac04\uc740 \ub5a8\uc5b4\uc9c0\ub294 \ubc00\uc744 \uc218\uc9d1\ud558\uace0 \uc800\uc7a5 \uc0c1\uc790\ub85c \uc6b4\ubc18\ud569\ub2c8\ub2e4(STEP3). \uc790\uc6d0 \uc790\ub3d9\ud654\ub97c \ud1b5\ud574 \uac8c\uc784\uc758 \ub354 \uc911\uc694\ud55c \uc694\uc18c\uc5d0 \uc9d1\uc911\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ube14\ub85d \uc6d4\ub4dc\uc758 \uc11c\ub85c \ub2e4\ub978 \ubc14\uc774\uc634\uc740 \uac8c\uc784\ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\uba70, \uac01 \ubc14\uc774\uc634\uc740 \uc5b4\ub5a4 \uace0\uc720\ud55c \uc790\uc6d0\uacfc \uc5b4\ub824\uc6c0\uc744 \uc81c\uc2dc\ud569\ub2c8\uae4c?", "answer": "\ube14\ub85d \uc6d4\ub4dc\ub294 \ub3c5\ud2b9\ud55c \uc790\uc6d0, \uc5b4\ub824\uc6c0, \uac8c\uc784 \ud50c\ub808\uc774 \uae30\ud68c\ub97c \uc81c\uc2dc\ud558\ub294 \ub2e4\uc591\ud55c \ubc14\uc774\uc634\uc744 \ud2b9\uc9d5\uc73c\ub85c \ud569\ub2c8\ub2e4. \uc232 \ubc14\uc774\uc634\uc5d0\ub294 \ub098\ubb34\uc640 \uc218\ub3d9 \ub3d9\ubb3c\uc774 \ud48d\ubd80\ud558\uc5ec \uc2dc\uc791 \uc704\uce58\ub85c \uc774\uc0c1\uc801\uc785\ub2c8\ub2e4. \uc0ac\ub9c9 \ubc14\uc774\uc634\uc740 \ubaa8\ub798\uc640 \uc120\uc778\uc7a5\uc744 \uc81c\uacf5\ud558\uc9c0\ub9cc \ubb3c\uc740 \ubd80\uc871\ud569\ub2c8\ub2e4. \ub208 \ubc14\uc774\uc634\uc740 \ucd94\uc6b4 \uae30\uc628\uacfc \uc2dc\uc57c\uac00 \uc81c\ud55c\ub41c\ub2e4\ub294 \uc5b4\ub824\uc6c0\uc744 \uc81c\uc2dc\ud569\ub2c8\ub2e4. \ub354 \uae4a\uc740 \ubd84\uc11d\uc744 \uc704\ud574, X\ucd95\uc740 \uc790\uc6d0(\ubd80\uc871/\ud48d\ubd80)\uc774\uace0 Y\ucd95\uc740 \uc5b4\ub824\uc6c0(\ub0ae\uc74c/\ub192\uc74c)\uc778 \uc0ac\ubd84\uba74 \ucc28\ud2b8\uc640 \uac19\uc774 \uadf8\ub798\ud504\ub97c \ub9cc\ub4dc\uc2ed\uc2dc\uc624. \ubc84\uc12f \uc12c\uacfc \uac19\uc740 \ubc14\uc774\uc634\uc740 \uace0\uc720\ud55c \uc790\uc6d0\uacfc \uc218\ub3d9 \ubab9 \uc0dd\uc131\uc728\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uac01 \ubc14\uc774\uc634\uc758 \ubbf8\ubb18\ud568\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \ud6a8\uacfc\uc801\uc778 \uc790\uc6d0 \uad00\ub9ac \ubc0f \ud0d0\ud5d8\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4."}, {"question": "\ube14\ub85d \uc6d4\ub4dc \ubab9 \uc0dd\uc131 \uc2dc\uc2a4\ud15c\uc744 \ud1b5\uc81c\ud558\ub294 \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc744 \uc124\uba85\ud558\uc2ed\uc2dc\uc624. \uc5ec\uae30\uc5d0\ub294 \uc870\uba85 \uc218\uc900\uacfc \ube14\ub85d \uc720\ud615\uacfc \uac19\uc740 \uc694\uc18c\uac00 \ud3ec\ud568\ub429\ub2c8\ub2e4.", "answer": "\ube14\ub85d \uc6d4\ub4dc\uc758 \ubab9 \uc0dd\uc131 \uc2dc\uc2a4\ud15c\uc740 \uc5ec\ub7ec \uac00\uc9c0 \uc694\uc18c\uc5d0 \uc758\ud574 \ud1b5\uc81c\ub418\uba70, \uac00\uc7a5 \uc911\uc694\ud55c \uc694\uc18c\ub294 \uc870\uba85 \uc218\uc900\uc785\ub2c8\ub2e4. \uc801\ub300\uc801\uc778 \ubab9\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \uc870\uba85 \uc218\uc900\uc774 7 \uc774\ud558\uc778 \uc9c0\uc5ed\uc5d0\uc11c \uc0dd\uc131\ub429\ub2c8\ub2e4. \uc774\ub294 \uc5b4\ub461\uace0 \uc870\uba85\ub418\uc9c0 \uc54a\uc740 \uc9c0\uc5ed\uc774 \ubab9 \uc0dd\uc131\uc758 \uc8fc\uc694 \uc9c0\uc5ed\uc784\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4. \ub2e4\ub978 \ube14\ub85d \uc720\ud615\ub3c4 \uc0dd\uc131\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud2b9\uc815 \ubab9\uc740 \ud2b9\uc815 \ube14\ub85d, \uc608\ub97c \ub4e4\uc5b4 \uc0ac\ub9c9 \ubc14\uc774\uc634\uc758 \uc2a4\ucf08\ub808\ud1a4\uc5d0 \ub354 \ub9ce\uc774 \uc0dd\uc131\ub420 \uac00\ub2a5\uc131\uc774 \ub192\uc2b5\ub2c8\ub2e4. \ud558\ub8e8 \uc2dc\uac04\ub3c4 \uc0dd\uc131\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ubc24\uc740 \ubab9 \ud65c\ub3d9\uc774 \uc99d\uac00\ud558\uae30 \ub54c\ubb38\uc5d0 \uc77c\ubc18\uc801\uc73c\ub85c \ub354 \uc704\ud5d8\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\uba74 \ud50c\ub808\uc774\uc5b4 \ud589\ub3d9\uacfc \uae30\uc9c0 \uc124\uacc4\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc190\uc804\ub4f1, \ub4f1\ubd88 \ub4f1 \ub2e4\ub978 \uad11\uc6d0\uc73c\ub85c \uc870\uba85 \uc218\uc900\uc744 \uc778\uc704\uc801\uc73c\ub85c \uc81c\uc5b4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "PC, \ucf58\uc194 \ubc0f \ubaa8\ubc14\uc77c \ubc84\uc804\uc758 \uac8c\uc784 \uac04\uc5d0 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774 \ub610\ub294 \ub370\uc774\ud130 \ub9c8\uc774\uadf8\ub808\uc774\uc158\uc774 \uac00\ub2a5\ud569\ub2c8\uae4c?", "answer": "\ube14\ub85d \uc6d4\ub4dc\uc5d0\uc11c \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774\uc640 \ub370\uc774\ud130 \ub9c8\uc774\uadf8\ub808\uc774\uc158\uc758 \uc0ac\uc6a9 \uac00\ub2a5 \uc5ec\ubd80\ub294 \ud2b9\uc815 \ubc84\uc804 \ubc0f \ud50c\ub7ab\ud3fc \uc815\ucc45\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc73c\ub85c PC \ubc0f \uc77c\ubd80 \ucf58\uc194 \ubc84\uc804\uc758 \ube14\ub85d \uc6d4\ub4dc\ub294 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774\ub97c \uc9c0\uc6d0\ud560 \uc218 \uc788\uc73c\uba70 \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc758 \ud50c\ub808\uc774\uc5b4\uac00 \ud568\uaed8 \ud50c\ub808\uc774\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \ud50c\ub7ab\ud3fc\ubcc4 \uc800\uc7a5 \ud30c\uc77c \ud615\uc2dd \ubc0f \ubcf4\uc548 \uc870\uce58\ub85c \uc778\ud574 \ub370\uc774\ud130 \ub9c8\uc774\uadf8\ub808\uc774\uc158\uc740 \ub35c \uc77c\ubc18\uc801\uc785\ub2c8\ub2e4. \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \uc9c0\uc6d0 \ubc0f \ub370\uc774\ud130 \uc804\uc1a1 \uc635\uc158\uc5d0 \ub300\ud55c \uad6c\uccb4\uc801\uc778 \uc815\ubcf4\ub294 \uacf5\uc2dd \ube14\ub85d \uc6d4\ub4dc \uc6f9\uc0ac\uc774\ud2b8 \ub610\ub294 \ud574\ub2f9 \ud50c\ub7ab\ud3fc\uc758 \uc628\ub77c\uc778 \uc11c\ube44\uc2a4\ub97c \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \ubaa8\ub4e0 \ud50c\ub7ab\ud3fc\uc774 \ub3d9\uc77c\ud558\uac8c \ub9cc\ub4e4\uc5b4\uc9c4 \uac83\uc740 \uc544\ub2c8\uba70 \ubaa8\ub4e0 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uae30\ub2a5 \ucc28\uc774\uac00 \uc788\uc744 \ub54c \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774\ub97c \ud5c8\uc6a9\ud558\ub294 \uac83\uc740 \uc544\ub2d9\ub2c8\ub2e4."}, {"question": "\ube14\ub85d \uc6d4\ub4dc\uc5d0\uc11c \uc218\uc815 \ub3d9\uad74\uc744 \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\uace0 \ubc1c\uacac \ud6c4 \uace0\uc720\ud55c \uc81c\uc791 \ub808\uc2dc\ud53c \ub610\ub294 \uc774\ubca4\ud2b8\ub97c \uc5b4\ub5bb\uac8c \uc720\ubc1c\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc218\uc815 \ub3d9\uad74\uc740 \ube14\ub85d \uc6d4\ub4dc\uc758 \uc228\uaca8\uc9c4 \ubc14\uc774\uc634\uc73c\ub85c \uc885\uc885 \uc9c0\ud558 \uae4a\uc219\uc774 \ub610\ub294 \uc0b0 \ubc14\uc774\uc634 \ub0b4\ubd80\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub4e4\uc740 \uace0\uc720\ud55c \uc218\uc815 \ud615\uc131\uacfc \ube5b\ub098\ub294 \ud658\uacbd\uc73c\ub85c \ud2b9\uc9d5 \uc9c0\uc5b4\uc9d1\ub2c8\ub2e4. \uc704\uce58\ub97c \ucc3e\uc73c\ub824\uba74 \ub3d9\uad74\uc744 \ucca0\uc800\ud788 \ud0d0\ud5d8\ud558\uace0 \ud2b9\uc774\ud55c \uc9c0\uc9c8\ud559\uc801 \ud2b9\uc9d5\uc774 \uc788\ub294 \uc9c0\uc5ed\uc5d0 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \uc218\uc815 \ub3d9\uad74\uc5d0\ub294 \ud76c\uadc0\ud55c \ubcf4\uc11d\uacfc \uc218\uc815\uacfc \uac19\uc740 \uace0\uc720\ud55c \uc790\uc6d0\uc774 \ud3ec\ud568\ub418\uc5b4 \uc788\uc73c\uba70, \uc774\ub7ec\ud55c \uc790\uc6d0\uc740 \uace0\uae09 \uc544\uc774\ud15c \uc81c\uc791 \ubc0f \ud2b9\uc218 \uc774\ubca4\ud2b8 \uc720\ubc1c\uc5d0 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc774\ub7ec\ud55c \ubcf4\uc11d\uc744 \uc0ac\uc6a9\ud558\uc5ec '\uc218\uc815 \ud314\ucc0c'\ub97c \uc81c\uc791\ud558\uba74 \uc228\uaca8\uc9c4 \ud018\uc2a4\ud2b8 \ub77c\uc778\uc744 \uc5f4\uac70\ub098 \uc0c8\ub85c\uc6b4 \ucc28\uc6d0\uc744 \uc5f4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub3d9\uad74 \uc785\uad6c\uc5d0\uc11c \ubbf8\uc138\ud55c \ube5b\ub098\ub294 \uc2dc\uac01\uc801 \ub2e8\uc11c\ub97c \ucc3e\uc73c\uc2ed\uc2dc\uc624. \uc774\ub294 \uc218\uc815 \ub3d9\uad74\uc758 \uadfc\uc811\uc131\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4."}]
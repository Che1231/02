[{"question": "\u65b9\u584a\u4e16\u754c\uff1a\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u6b63\u78ba\u653e\u7f6e\u65b9\u584a\uff0c\u4ee5\u53ca\u9700\u8981\u6ce8\u610f\u54ea\u4e9b\u5e38\u898b\u932f\u8aa4\uff1f", "answer": "\u5728\u65b9\u584a\u4e16\u754c\u4e2d\uff0c\u653e\u7f6e\u65b9\u584a\u662f\u65b0\u624b\u73a9\u5bb6\u7684\u57fa\u672c\u6280\u80fd\u3002\u8981\u653e\u7f6e\u65b9\u584a\uff0c\u8acb\u5f9e\u4f60\u7684\u7269\u54c1\u6b04\u4e2d\u9078\u64c7\u5b83\uff0c\u7136\u5f8c\u9ede\u64ca\u904a\u6232\u4e16\u754c\u4e2d\u4f60\u60f3\u8981\u653e\u7f6e\u65b9\u584a\u7684\u4f4d\u7f6e\u3002\u5e38\u898b\u932f\u8aa4\u4e4b\u4e00\u662f\u5617\u8a66\u5c07\u65b9\u584a\u653e\u7f6e\u5728\u53e6\u4e00\u500b\u65b9\u584a\u5df2\u7d93\u5b58\u5728\u7684\u5730\u65b9\uff0c\u6216\u8d85\u51fa\u4f60\u7684\u89d2\u8272\u89f8\u53ca\u7bc4\u570d\u7684\u5730\u65b9\u3002\u6b64\u5916\uff0c\u8acb\u6ce8\u610f\u91cd\u529b\uff01\u5982\u679c\u6c92\u6709\u652f\u6490\uff0c\u65b9\u584a\u6703\u6389\u843d\u3002\u4f8b\u5982\uff0c\u5728\u5efa\u9020\u5854\u6642\uff0c\u8acb\u5148\u5efa\u7acb\u4e00\u500b\u5ee3\u95ca\u7684\u5e95\u5ea7\uff08\u6b65\u9a5f1\uff09\uff0c\u7136\u5f8c\u9010\u6b65\u5728\u5411\u4e0a\u5efa\u9020\u6642\u6536\u7a84\uff08\u6b65\u9a5f2\uff09\u3002\u8003\u616e\u5728\u5074\u9762\u653e\u7f6e\u652f\u6490\u65b9\u584a\u4ee5\u63d0\u4f9b\u984d\u5916\u7684\u7a69\u5b9a\u6027\uff08\u6b65\u9a5f3\uff09\u3002\u60f3\u50cf\u4e00\u4e0b\uff0c\u65b9\u584a\u5c31\u50cf\u6a02\u9ad8\u7a4d\u6728\u4e00\u6a23\uff1b\u6bcf\u500b\u65b9\u584a\u90fd\u9700\u8981\u4e00\u500b\u7a69\u56fa\u7684\u57fa\u790e\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u7684\u65b9\u584a\u4e16\u754c\u93ac\u982d\u6703\u5feb\u901f\u640d\u58de\uff1f\u4e0d\u540c\u7684\u5de5\u5177\u5c64\u7d1a\u4ee5\u53ca\u5176\u8010\u7528\u5ea6\u70ba\u4f55\uff1f", "answer": "\u4f60\u7684\u93ac\u982d\u5feb\u901f\u640d\u58de\u53ef\u80fd\u662f\u56e0\u70ba\u5b83\u662f\u4e00\u500b\u8f03\u4f4e\u5c64\u7d1a\u7684\u5de5\u5177\u3002\u65b9\u584a\u4e16\u754c\u63a1\u7528\u5206\u5c64\u5de5\u5177\uff0c\u6bcf\u7a2e\u5de5\u5177\u7684\u6750\u8cea\u4e0d\u540c\uff0c\u6703\u5f71\u97ff\u8010\u7528\u6027\u548c\u63a1\u7926\u901f\u5ea6\u3002\u6728\u93ac\u6700\u5f31\uff0c\u5176\u6b21\u662f\u77f3\u982d\u3001\u9435\u3001\u91d1\u548c\u947d\u77f3\uff08\u914d\u7f6e\u5c0d\u7167\u8868\uff09\u3002\u6728\u93ac\u53ef\u80fd\u50c5\u80fd\u4f7f\u7528 20 \u6b21\uff0c\u800c\u947d\u77f3\u93ac\u5247\u53ef\u4ee5\u4f7f\u7528\u6578\u767e\u6b21\u3002\u4e00\u7372\u53d6\u5230\u66f4\u597d\u7684\u8cc7\u6e90\uff0c\u5c31\u76e1\u5feb\u5347\u7d1a\u4f60\u7684\u93ac\u982d\u3002\u4f8b\u5982\uff0c\u63a1\u7926\u77f3\u982d\u81f3\u5c11\u9700\u8981\u6728\u93ac\uff0c\u800c\u9435\u7926\u9700\u8981\u77f3\u93ac\u6216\u66f4\u597d\u7684\u93ac\u982d\u3002\u4f60\u53ef\u4ee5\u901a\u904e\u5728\u5de5\u5320\u684c\u5c07\u6728\u68cd\u548c\u9d5d\u5375\u77f3\u7d44\u5408\u4f86\u88fd\u4f5c\u77f3\u93ac\u3002"}, {"question": "\u65b9\u584a\u4e16\u754c\u4e2d\u7684\u7194\u7210\u6709\u4ec0\u9ebc\u7528\u9014\uff0c\u5982\u4f55\u4f7f\u7528\u5b83\u4f86\u88fd\u4f5c\u66f4\u597d\u7684\u7269\u54c1\u548c\u8cc7\u6e90\uff1f", "answer": "\u5728\u65b9\u584a\u4e16\u754c\u4e2d\uff0c\u7194\u7210\u662f\u91cd\u8981\u7684\u5de5\u5320\u5de5\u5177\u3002\u5b83\u5141\u8a31\u4f60\u5c07\u539f\u6750\u6599\u7194\u7149\u6210\u66f4\u6709\u7528\u7684\u5f62\u5f0f\u3002\u8981\u4f7f\u7528\u7194\u7210\uff0c\u4f60\u9700\u8981\u71c3\u6599\uff08\u4f8b\u5982\u6728\u6750\u3001\u7164\u70ad\uff09\u548c\u60f3\u8981\u7194\u7149\u7684\u6750\u6599\uff08\u4f8b\u5982\u9435\u7926\uff09\u3002\u5c07\u71c3\u6599\u653e\u5728\u5e95\u90e8\u63d2\u69fd\uff0c\u5c07\u6750\u6599\u653e\u5728\u9802\u90e8\u63d2\u69fd\u3002\u7194\u7210\u6703\u5c07\u539f\u6750\u6599\u8f49\u63db\u6210\u7cbe\u7149\u7522\u54c1\uff0c\u4f8b\u5982\u5f9e\u9435\u7926\u4e2d\u7372\u5f97\u9435\u9320\u3002\u9019\u4e9b\u9320\u53ef\u4ee5\u7528\u65bc\u88fd\u4f5c\u66f4\u5148\u9032\u7684\u7269\u54c1\uff0c\u4f8b\u5982\u76d4\u7532\u548c\u5de5\u5177\u3002\u53ef\u4ee5\u5c07\u7194\u7210\u8996\u70ba\u795e\u5947\u7684\u935b\u9020\u7210\uff0c\u5c07\u7c97\u964b\u7684\u539f\u6599\u8f49\u5316\u70ba\u5bf6\u8cb4\u7684\u7d44\u4ef6\u3002"}, {"question": "\u65b9\u584a\u4e16\u754c\u9ad8\u7d1a\u7b56\u7565\uff1a\u5982\u4f55\u4f7f\u7528\u4e0d\u540c\u7684\u9644\u9b54\u6216\u6280\u5de7\u512a\u5316\u8cc7\u6e90\u6536\u96c6\u4ee5\u63d0\u9ad8\u6548\u7387\uff1f", "answer": "\u5728\u65b9\u584a\u4e16\u754c\u4e2d\u512a\u5316\u8cc7\u6e90\u6536\u96c6\uff0c\u9700\u8981\u904b\u7528\u9644\u9b54\u548c\u904a\u6232\u6a5f\u5236\u4f86\u63d0\u9ad8\u6548\u7387\u3002\u5c0d\u5de5\u5177\u6700\u6709\u6548\u7684\u9644\u9b54\u4e4b\u4e00\u662f\u300c\u5e78\u904b\u300d\uff0c\u5b83\u6703\u589e\u52a0\u63a1\u7926\u6642\u6389\u843d\u7684\u7269\u54c1\u6578\u91cf\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u5e78\u904b\u4e09\u7d1a\u7684\u947d\u77f3\u93ac\u4f86\u63a1\u7926\u947d\u77f3\u7926\u77f3\uff0c\u53ef\u4ee5\u5f9e\u6bcf\u500b\u65b9\u584a\u7372\u5f97\u591a\u500b\u947d\u77f3\u3002\u53e6\u4e00\u7a2e\u6280\u5de7\u662f\u4f7f\u7528\u66f4\u6709\u6548\u7387\u7684\u5de5\u5177\u4f86\u8655\u7406\u7279\u5b9a\u7a2e\u985e\u7684\u65b9\u584a\u3002\u96d6\u7136\u947d\u77f3\u5de5\u5177\u8010\u7528\uff0c\u4f46\u5728\u904a\u6232\u521d\u671f\uff0c\u5b83\u53ef\u80fd\u4e0d\u662f\u6536\u96c6\u67d0\u4e9b\u6750\u6599\u7684\u6700\u4f73\u5de5\u5177\u3002\u6d41\u7a0b\u5716\u53ef\u4ee5\u5e6b\u52a9\u4f60\u6c7a\u5b9a\u63a1\u7926\u8cc7\u6e90\u7684\u6700\u4f73\u9806\u5e8f\uff0c\u5f9e\u5e38\u898b\u6750\u6599\u958b\u59cb\uff0c\u9010\u6b65\u901a\u904e\u66f4\u8907\u96dc\u7684\u6750\u6599\u4f86\u9032\u968e\u904a\u6232\u3002"}, {"question": "\u5728\u65b9\u584a\u4e16\u754c\u4e2d\uff0c\u54ea\u4e9b\u662f\u6700\u6709\u6548\u7684\u57fa\u790e\u9632\u79a6\u7b56\u7565\uff0c\u4ee5\u62b5\u6297\u591c\u9593\u602a\u7269\uff0c\u4ee5\u53ca\u54ea\u4e9b\u9677\u9631\u61c9\u8a72\u512a\u5148\u8003\u616e\uff1f", "answer": "\u5728\u65b9\u584a\u4e16\u754c\u4e2d\uff0c\u6709\u6548\u7684\u57fa\u5730\u9632\u79a6\u9700\u8981\u7b56\u7565\u601d\u8003\u548c\u898f\u5283\u3002\u512a\u5148\u8003\u616e\u4f7f\u7528\u77f3\u78da\u6216\u52a0\u5f37\u65b9\u584a\u7b49\u6750\u6599\u5efa\u7acb\u5b89\u5168\u7684\u908a\u754c\u3002\u8003\u616e\u81f3\u5c11\u5efa\u9020\u4e09\u683c\u9ad8\u7684\u570d\u7246\uff0c\u4ee5\u9632\u6b62\u602a\u7269\u8df3\u904e\u3002\u9677\u9631\u4e5f\u626e\u6f14\u95dc\u9375\u89d2\u8272\u3002\u7c21\u55ae\u7684\u5751\u9677\u9631\u6216\u58d3\u529b\u677f\u555f\u52d5\u7684\u93e2\u69cd\u53ef\u4ee5\u5feb\u901f\u6d88\u6ec5\u5a01\u8105\u3002\u4f8b\u5982\uff0c\u5728\u57fa\u5730\u5468\u570d\u5efa\u9020\u4e00\u500b\u5145\u6eff\u7194\u5ca9\u7684\u8b77\u57ce\u6cb3\u53ef\u4ee5\u4f5c\u70ba\u8a31\u591a\u751f\u7269\u96e3\u4ee5\u7a7f\u8d8a\u7684\u5c4f\u969c\u3002\u5225\u5fd8\u4e86\u7167\u660e\uff01\u660e\u4eae\u7684\u5340\u57df\u53ef\u4ee5\u9632\u6b62\u5927\u591a\u6578\u6575\u5c0d\u602a\u7269\u7684\u751f\u6210\u3002\u5617\u8a66\u7d44\u5408\u4e0d\u540c\u7684\u65b9\u6cd5\uff0c\u4ee5\u5efa\u7acb\u5b8c\u7f8e\u7684\u6297\u602a\u7269\u5821\u58d8\u3002\u9632\u79a6\u57fa\u5730\u9700\u8981\u591a\u5c64\u6b21\u7684\u7b56\u7565\uff0c\u7d50\u5408\u7d50\u69cb\u6027\u9632\u79a6\u548c\u7a4d\u6975\u7684\u9677\u9631\u3002"}, {"question": "BW\u79d8\u8a23\uff1a\u5982\u4f55\u5728\u65b9\u584a\u4e16\u754c\u4e2d\u5275\u9020\u81ea\u52d5\u5316\u7684\u8fb2\u5834\uff0c\u7528\u65bc\u6536\u96c6\u4f8b\u5982\u5c0f\u9ea5\u6216\u5357\u74dc\u7b49\u8cc7\u6e90\uff0c\u4ee5\u53ca\u6240\u9700\u7684\u95dc\u9375\u7d44\u4ef6\u6709\u54ea\u4e9b\uff1f", "answer": "\u5728\u65b9\u584a\u4e16\u754c\u4e2d\uff0c\u81ea\u52d5\u5316\u8fb2\u838a\u5229\u7528\u904a\u6232\u6a5f\u5236\uff0c\u5728\u7121\u9700\u73a9\u5bb6\u6301\u7e8c\u4e92\u52d5\u7684\u60c5\u6cc1\u4e0b\u6536\u7a6b\u8cc7\u6e90\u3002\u95dc\u9375\u7d44\u4ef6\u5305\u62ec\u7528\u65bc\u6c34\u5316\u7684\u6c34\u6e90\uff0c\u7528\u65bc\u6536\u96c6\u6389\u843d\u7269\u54c1\u7684\u6f0f\u6597\uff0c\u4ee5\u53ca\u7528\u65bc\u81ea\u52d5\u6536\u7a6b\u8fb2\u4f5c\u7269\u7684\u6d3b\u585e\u3002\u8209\u4f8b\u4f86\u8aaa\uff0c\u4e00\u500b\u57fa\u672c\u7684\u5c0f\u9ea5\u8fb2\u5834\u5305\u62ec\u5728\u8fb2\u7530\u4e2d\u653e\u7f6e\u5e7e\u884c\u8fb2\u7530\uff0c\u4e2d\u9593\u6709\u6c34\u6e20\u3002\u5728\u8fb2\u7530\u4e0a\u65b9\uff0c\u4f60\u53ef\u4ee5\u653e\u7f6e\u8207\u6642\u9593\u5668\u96fb\u8def\u76f8\u9023\u7684\u6d3b\u585e\uff08\u6b65\u9a5f1\uff09\u3002\u7576\u6642\u9593\u5668\u555f\u52d5\u6642\uff0c\u6d3b\u585e\u6703\u63a8\u51fa\u5c0f\u9ea5\uff0c\u9020\u6210\u5176\u5d29\u89e3\u4e26\u6389\u843d\uff08\u6b65\u9a5f2\uff09\u3002\u8fb2\u7530\u4e0b\u7684\u6f0f\u6597\u6703\u6536\u96c6\u6389\u843d\u7684\u5c0f\u9ea5\uff0c\u4e26\u5c07\u5176\u904b\u8f38\u5230\u5132\u85cf\u7bb1\uff08\u6b65\u9a5f3\uff09\u3002\u81ea\u52d5\u5316\u4f60\u7684\u8cc7\u6e90\u5c07\u4f7f\u4f60\u80fd\u5c08\u6ce8\u65bc\u904a\u6232\u4e2d\u66f4\u91cd\u8981\u7684\u5143\u7d20\u3002"}, {"question": "\u65b9\u584a\u4e16\u754c\u7684\u4e0d\u540c\u751f\u7269\u7fa4\u7cfb\u5982\u4f55\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff0c\u4ee5\u53ca\u6bcf\u500b\u751f\u7269\u7fa4\u7cfb\u63d0\u4f9b\u4e86\u54ea\u4e9b\u7368\u7279\u7684\u8cc7\u6e90\u548c\u6311\u6230\uff1f", "answer": "\u65b9\u584a\u4e16\u754c\u64c1\u6709\u5404\u7a2e\u5404\u6a23\u7684\u751f\u7269\u7fa4\u7cfb\uff0c\u6bcf\u500b\u751f\u7269\u7fa4\u7cfb\u90fd\u63d0\u4f9b\u4e86\u7368\u7279\u7684\u8cc7\u6e90\u3001\u6311\u6230\u548c\u904a\u6232\u73a9\u6cd5\u6a5f\u6703\u3002\u68ee\u6797\u751f\u7269\u7fa4\u7cfb\u64c1\u6709\u8c50\u5bcc\u7684\u6728\u6750\u548c\u88ab\u52d5\u52d5\u7269\uff0c\u4f7f\u5176\u6210\u70ba\u7406\u60f3\u7684\u8d77\u59cb\u5730\u9ede\u3002\u6c99\u6f20\u751f\u7269\u7fa4\u7cfb\u63d0\u4f9b\u6c99\u5b50\u548c\u4ed9\u4eba\u638c\uff0c\u4f46\u6c34\u6e90\u7a00\u5c11\u3002\u96ea\u5730\u751f\u7269\u7fa4\u7cfb\u5247\u5e36\u4f86\u5bd2\u51b7\u6c23\u6eab\u548c\u80fd\u898b\u5ea6\u4f4e\u7684\u6311\u6230\u3002\u70ba\u4e86\u66f4\u6df1\u5165\u7684\u5206\u6790\uff0c\u53ef\u4ee5\u5efa\u7acb\u50cf\u8c61\u9650\u5716\u4e00\u6a23\u7684\u7db2\u683c\uff0c\u5176\u4e2d X \u8ef8\u4ee3\u8868\u8cc7\u6e90\uff08\u7a00\u5c11/\u8c50\u5bcc\uff09\uff0cY \u8ef8\u4ee3\u8868\u6311\u6230\uff08\u4f4e/\u9ad8\uff09\u3002\u8611\u83c7\u5cf6\u7b49\u751f\u7269\u7fa4\u7cfb\u63d0\u4f9b\u4e86\u7368\u7279\u7684\u8cc7\u6e90\u548c\u88ab\u52d5\u751f\u7269\u7fa4\u3002\u4e86\u89e3\u6bcf\u500b\u751f\u7269\u7fa4\u7cfb\u7684\u7d30\u5fae\u5dee\u5225\u5c0d\u65bc\u6709\u6548\u7ba1\u7406\u8cc7\u6e90\u548c\u63a2\u7d22\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u4f60\u80fd\u89e3\u91cb\u652f\u914d\u65b9\u584a\u4e16\u754c\u602a\u7269\u751f\u6210\u7cfb\u7d71\u7684\u5e95\u5c64\u6a5f\u5236\uff0c\u4f8b\u5982\u5149\u7dda\u6c34\u5e73\u548c\u65b9\u584a\u985e\u578b\u7b49\u56e0\u7d20\uff1f", "answer": "\u65b9\u584a\u4e16\u754c\u7684\u602a\u7269\u751f\u6210\u7cfb\u7d71\u53d7\u591a\u500b\u56e0\u7d20\u652f\u914d\uff0c\u5176\u4e2d\u6700\u91cd\u8981\u7684\u56e0\u7d20\u662f\u5149\u7dda\u6c34\u5e73\u3002\u6575\u5c0d\u602a\u7269\u901a\u5e38\u5728\u5149\u7dda\u6c34\u5e73\u70ba 7 \u6216\u66f4\u4f4e\u7684\u5730\u5340\u751f\u6210\u3002\u9019\u610f\u5473\u8457\u9ed1\u6697\u800c\u672a\u7167\u660e\u7684\u5340\u57df\u662f\u4e3b\u8981\u7684\u602a\u7269\u751f\u6210\u9ede\u3002\u4e0d\u540c\u7684\u65b9\u584a\u985e\u578b\u4e5f\u6703\u5f71\u97ff\u751f\u6210\u3002\u4f8b\u5982\uff0c\u67d0\u4e9b\u602a\u7269\u66f4\u6709\u53ef\u80fd\u5728\u7279\u5b9a\u7684\u65b9\u584a\u4e0a\u751f\u6210\uff0c\u4f8b\u5982\u6c99\u6f20\u751f\u7269\u7fa4\u7cfb\u4e2d\u7684\u9ab7\u9acf\u3002\u4e00\u5929\u7684\u6642\u9593\u4e5f\u6703\u5f71\u97ff\u751f\u6210\uff1b\u591c\u665a\u901a\u5e38\u66f4\u5371\u96aa\uff0c\u56e0\u70ba\u602a\u7269\u6d3b\u52d5\u66f4\u591a\u3002\u4e86\u89e3\u9019\u4e9b\u5e95\u5c64\u6a5f\u5236\uff0c\u53ef\u4ee5\u8b93\u73a9\u5bb6\u66f4\u597d\u5730\u4e86\u89e3\u884c\u70ba\u548c\u57fa\u5730\u8a2d\u8a08\u3002\u53ef\u4ee5\u4f7f\u7528\u706b\u628a\u3001\u71c8\u7c60\u548c\u5176\u4ed6\u5149\u6e90\u4eba\u5de5\u63a7\u5236\u5149\u7dda\u6c34\u5e73\u3002"}, {"question": "\u65b9\u584a\u4e16\u754c\u8de8\u5e73\u53f0\uff1aPC\u3001\u4e3b\u6a5f\u548c\u624b\u6a5f\u7248\u672c\u7684\u904a\u6232\u4e4b\u9593\u662f\u5426\u6709\u8de8\u5e73\u53f0\u904a\u6232\u6216\u6578\u64da\u9077\u79fb\u529f\u80fd\uff1f", "answer": "\u65b9\u584a\u4e16\u754c\u5728 PC\u3001\u4e3b\u6a5f\u548c\u624b\u6a5f\u7248\u672c\u4e4b\u9593\u662f\u5426\u652f\u63f4\u8de8\u5e73\u53f0\u904a\u6232\u548c\u6578\u64da\u9077\u79fb\u53d6\u6c7a\u65bc\u7279\u5b9a\u7248\u672c\u548c\u5e73\u53f0\u653f\u7b56\u3002\u4e00\u822c\u4f86\u8aaa\uff0cPC \u548c\u67d0\u4e9b\u4e3b\u6a5f\u7248\u672c\u7684\u65b9\u584a\u4e16\u754c\u53ef\u80fd\u652f\u63f4\u8de8\u5e73\u53f0\u904a\u6232\uff0c\u8b93\u4e0d\u540c\u5e73\u53f0\u4e0a\u7684\u73a9\u5bb6\u80fd\u5920\u4e00\u8d77\u904a\u6232\u3002\u7136\u800c\uff0c\u7531\u65bc\u5e73\u53f0\u7279\u5b9a\u7684\u5132\u5b58\u6a94\u6848\u683c\u5f0f\u548c\u5b89\u5168\u63aa\u65bd\uff0c\u6578\u64da\u9077\u79fb\u8f03\u5c11\u898b\u3002\u8acb\u6aa2\u67e5\u65b9\u584a\u4e16\u754c\u5b98\u65b9\u7db2\u7ad9\u6216\u4f60\u7684\u5e73\u53f0\u7dda\u4e0a\u670d\u52d9\uff0c\u4ee5\u7372\u53d6\u6709\u95dc\u8de8\u5e73\u53f0\u652f\u63f4\u548c\u6578\u64da\u8f49\u79fb\u9078\u9805\u7684\u5177\u9ad4\u8cc7\u8a0a\u3002\u4e26\u975e\u6240\u6709\u5e73\u53f0\u90fd\u662f\u5e73\u7b49\u7684\uff0c\u7576\u5e73\u53f0\u80fd\u529b\u5b58\u5728\u5dee\u7570\u6642\uff0c\u4e26\u4e0d\u4e00\u5b9a\u53ef\u4ee5\u5be6\u73fe\u8de8\u5e73\u53f0\u904a\u6232\u3002"}, {"question": "\u5982\u4f55\u5728\u65b9\u584a\u4e16\u754c\u4e2d\u627e\u5230\u6c34\u6676\u6d1e\u7a74\uff0c\u4ee5\u53ca\u767c\u73fe\u5f8c\u5982\u4f55\u89f8\u767c\u7368\u7279\u7684\u88fd\u4f5c\u914d\u65b9\u6216\u4e8b\u4ef6\uff1f", "answer": "\u6c34\u6676\u6d1e\u7a74\u662f\u65b9\u584a\u4e16\u754c\u4e2d\u7684\u96b1\u85cf\u751f\u7269\u7fa4\u7cfb\uff0c\u901a\u5e38\u4f4d\u65bc\u5730\u4e0b\u6df1\u8655\u6216\u5c71\u8108\u751f\u7269\u7fa4\u7cfb\u4e2d\u3002\u5b83\u5011\u4ee5\u7368\u7279\u7684\u7d50\u6676\u9ad4\u7d50\u69cb\u548c\u767c\u5149\u74b0\u5883\u70ba\u7279\u5fb5\u3002\u8981\u627e\u5230\u5b83\u5011\uff0c\u8acb\u5fb9\u5e95\u63a2\u7d22\u6d1e\u7a74\uff0c\u91cd\u9ede\u95dc\u6ce8\u5177\u6709\u7570\u5e38\u5730\u8cea\u7279\u5fb5\u7684\u5730\u5340\u3002\u6c34\u6676\u6d1e\u7a74\u5305\u542b\u7368\u7279\u7684\u8cc7\u6e90\uff0c\u4f8b\u5982\u7a00\u6709\u5bf6\u77f3\u548c\u6676\u9ad4\uff0c\u9019\u4e9b\u8cc7\u6e90\u7528\u65bc\u88fd\u4f5c\u5148\u9032\u7684\u7269\u54c1\u4e26\u89f8\u767c\u7279\u6b8a\u4e8b\u4ef6\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u9019\u4e9b\u5bf6\u77f3\u88fd\u4f5c\u300c\u6c34\u6676\u8b77\u8eab\u7b26\u300d\u53ef\u80fd\u89e3\u9396\u96b1\u85cf\u7684\u4efb\u52d9\u7dda\u6216\u89e3\u9396\u65b0\u7684\u7dad\u5ea6\u3002\u5c0b\u627e\u7d30\u5fae\u7684\u8996\u89ba\u63d0\u793a\uff0c\u4f8b\u5982\u6d1e\u7a74\u5165\u53e3\u8655\u7684\u5fae\u5f31\u5149\u8292\uff0c\u7528\u65bc\u986f\u793a\u6c34\u6676\u6d1e\u7a74\u7684\u63a5\u8fd1\u3002"}]
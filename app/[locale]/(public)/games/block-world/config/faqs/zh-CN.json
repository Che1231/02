[{"question": "\u65b9\u5757\u4e16\u754c\uff1a\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u6b63\u786e\u653e\u7f6e\u65b9\u5757\uff0c\u4ee5\u53ca\u5e94\u8be5\u907f\u514d\u54ea\u4e9b\u5e38\u89c1\u9519\u8bef\uff1f", "answer": "\u5728\u65b9\u5757\u4e16\u754c\u4e2d\uff0c\u4f5c\u4e3a\u65b0\u73a9\u5bb6\uff0c\u653e\u7f6e\u65b9\u5757\u662f\u57fa\u7840\u64cd\u4f5c\u3002\u8981\u653e\u7f6e\u65b9\u5757\uff0c\u8bf7\u4ece\u4f60\u7684\u7269\u54c1\u680f\u4e2d\u9009\u62e9\u5b83\uff0c\u7136\u540e\u70b9\u51fb\u6e38\u620f\u4e16\u754c\u4e2d\u7684\u76ee\u6807\u4f4d\u7f6e\u3002\u5e38\u89c1\u9519\u8bef\u662f\u8bd5\u56fe\u5c06\u65b9\u5757\u653e\u7f6e\u5728\u5df2\u7ecf\u6709\u5176\u4ed6\u65b9\u5757\u7684\u5730\u65b9\uff0c\u6216\u8005\u8d85\u51fa\u4f60\u89d2\u8272\u89e6\u53ca\u8303\u56f4\u7684\u5730\u65b9\u3002\u8fd8\u8981\u6ce8\u610f\u91cd\u529b\uff01\u5982\u679c\u65b9\u5757\u6ca1\u6709\u652f\u6491\u597d\uff0c\u5c31\u4f1a\u6389\u843d\u3002\u4f8b\u5982\uff0c\u5efa\u9020\u5854\u65f6\uff0c\u5148\u5efa\u7acb\u4e00\u4e2a\u5bbd\u9614\u7684\u57fa\u7840\uff08\u6b65\u9aa41\uff09\uff0c\u9010\u6e10\u5728\u5411\u4e0a\u5efa\u9020\u65f6\u4f7f\u5176\u53d8\u7a84\uff08\u6b65\u9aa42\uff09\u3002\u8003\u8651\u5728\u4fa7\u9762\u653e\u7f6e\u652f\u6491\u65b9\u5757\u4ee5\u589e\u52a0\u7a33\u5b9a\u6027\uff08\u6b65\u9aa43\uff09\u3002\u60f3\u8c61\u4e00\u4e0b\uff0c\u65b9\u5757\u5c31\u50cf\u4e50\u9ad8\u79ef\u6728\u4e00\u6837\uff0c\u6bcf\u4e2a\u90fd\u9700\u8981\u4e00\u4e2a\u575a\u5b9e\u7684\u57fa\u7840\u3002"}, {"question": "\u6211\u7684\u65b9\u5757\u4e16\u754c\u9550\u5b50\u4e3a\u4ec0\u4e48\u7834\u635f\u901f\u5ea6\u8fd9\u4e48\u5feb\uff1f\u4e0d\u540c\u7684\u5de5\u5177\u7b49\u7ea7\u53ca\u5176\u8010\u4e45\u5ea6\u662f\u4ec0\u4e48\uff1f", "answer": "\u4f60\u7684\u9550\u5b50\u7834\u635f\u901f\u5ea6\u5feb\uff0c\u5f88\u53ef\u80fd\u662f\u56e0\u4e3a\u5b83\u662f\u4e00\u4e2a\u4f4e\u7b49\u7ea7\u5de5\u5177\u3002\u65b9\u5757\u4e16\u754c\u6709\u5206\u7ea7\u5de5\u5177\uff0c\u6bcf\u79cd\u5de5\u5177\u90fd\u6709\u4e0d\u540c\u7684\u6750\u6599\uff0c\u5f71\u54cd\u8010\u4e45\u5ea6\u548c\u91c7\u77ff\u901f\u5ea6\u3002\u6728\u9550\u6700\u5f31\uff0c\u5176\u6b21\u662f\u77f3\u5934\u3001\u94c1\u3001\u91d1\u548c\u94bb\u77f3\uff08\u914d\u7f6e\u6bd4\u8f83\u8868\uff09\u3002\u6728\u9550\u53ef\u80fd\u53ea\u80fd\u4f7f\u752820\u6b21\uff0c\u800c\u94bb\u77f3\u9550\u53ef\u80fd\u53ef\u4ee5\u4f7f\u7528\u6570\u767e\u6b21\u3002\u53ea\u8981\u4f60\u80fd\u83b7\u5f97\u66f4\u597d\u7684\u8d44\u6e90\uff0c\u5c31\u5c3d\u5feb\u5347\u7ea7\u4f60\u7684\u9550\u5b50\u3002\u4f8b\u5982\uff0c\u5f00\u91c7\u77f3\u5934\u81f3\u5c11\u9700\u8981\u6728\u9550\uff0c\u800c\u94c1\u77ff\u77f3\u5219\u9700\u8981\u77f3\u9550\u6216\u66f4\u597d\u7684\u9550\u3002\u4f60\u53ef\u4ee5\u901a\u8fc7\u5728\u5236\u4f5c\u53f0\u4e0a\u5c06\u6728\u68cd\u548c\u9e45\u5375\u77f3\u7ec4\u5408\u8d77\u6765\u5236\u4f5c\u77f3\u9550\u3002"}, {"question": "\u65b9\u5757\u4e16\u754c\u7194\u7089\u7684\u4f5c\u7528\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5982\u4f55\u5229\u7528\u5b83\u6765\u521b\u5efa\u66f4\u597d\u7684\u7269\u54c1\u548c\u8d44\u6e90\uff1f", "answer": "\u65b9\u5757\u4e16\u754c\u4e2d\u7684\u7194\u7089\u662f\u4e00\u79cd\u91cd\u8981\u7684\u5236\u4f5c\u5de5\u5177\u3002\u5b83\u5141\u8bb8\u4f60\u5c06\u539f\u6750\u6599\u7194\u70bc\u6210\u66f4\u6709\u7528\u7684\u5f62\u5f0f\u3002\u8981\u4f7f\u7528\u7194\u7089\uff0c\u4f60\u9700\u8981\u71c3\u6599\uff08\u4f8b\u5982\u6728\u5934\u3001\u7164\uff09\u548c\u4f60\u60f3\u7194\u70bc\u7684\u6750\u6599\uff08\u4f8b\u5982\u94c1\u77ff\u77f3\uff09\u3002\u5c06\u71c3\u6599\u653e\u5728\u5e95\u69fd\uff0c\u5c06\u6750\u6599\u653e\u5728\u9876\u69fd\u3002\u7136\u540e\uff0c\u7194\u7089\u4f1a\u5c06\u539f\u6750\u6599\u8f6c\u5316\u4e3a\u7cbe\u70bc\u4ea7\u54c1\uff0c\u4f8b\u5982\u4ece\u94c1\u77ff\u77f3\u4e2d\u83b7\u53d6\u94c1\u952d\u3002\u8fd9\u4e9b\u94c1\u952d\u53ef\u4ee5\u7528\u6765\u5236\u4f5c\u66f4\u9ad8\u7ea7\u7684\u7269\u54c1\uff0c\u4f8b\u5982\u76d4\u7532\u548c\u5de5\u5177\u3002\u628a\u7194\u7089\u60f3\u8c61\u6210\u4e00\u4e2a\u795e\u5947\u7684\u70bc\u91d1\u7089\uff0c\u53ef\u4ee5\u5c06\u7c97\u7cd9\u7684\u539f\u6599\u8f6c\u5316\u6210\u6709\u4ef7\u503c\u7684\u6210\u5206\u3002"}, {"question": "\u65b9\u5757\u4e16\u754c\u9ad8\u7ea7\u7b56\u7565\uff1a\u5982\u4f55\u5229\u7528\u4e0d\u540c\u7684\u9644\u9b54\u6216\u6280\u5de7\u6765\u4f18\u5316\u6211\u7684\u8d44\u6e90\u6536\u96c6\uff0c\u4ee5\u83b7\u5f97\u66f4\u9ad8\u7684\u6548\u7387\uff1f", "answer": "\u5728\u65b9\u5757\u4e16\u754c\u4e2d\u4f18\u5316\u8d44\u6e90\u6536\u96c6\u6d89\u53ca\u5229\u7528\u9644\u9b54\u548c\u6e38\u620f\u673a\u5236\u6765\u63d0\u9ad8\u6548\u7387\u3002\u5bf9\u5de5\u5177\u6700\u6709\u6548\u7684\u9644\u9b54\u4e4b\u4e00\u662f\u201c\u5e78\u8fd0\u201d\uff0c\u5b83\u4f1a\u589e\u52a0\u91c7\u77ff\u65f6\u6389\u843d\u7269\u54c1\u7684\u6570\u91cf\u3002\u4f8b\u5982\uff0c\u5728\u94bb\u77f3\u77ff\u4e0a\u4f7f\u7528\u5e78\u8fd0III\u7ea7\u9550\u53ef\u4ee5\u6bcf\u5757\u77ff\u77f3\u83b7\u5f97\u591a\u9897\u94bb\u77f3\u3002\u53e6\u4e00\u79cd\u6280\u5de7\u662f\u4f7f\u7528\u66f4\u6709\u6548\u7387\u7684\u5de5\u5177\u6765\u5904\u7406\u7279\u5b9a\u7c7b\u578b\u7684\u65b9\u5757\u3002\u867d\u7136\u94bb\u77f3\u5de5\u5177\u7ecf\u4e45\u8010\u7528\uff0c\u4f46\u5728\u6e38\u620f\u521d\u671f\uff0c\u5b83\u53ef\u80fd\u5e76\u4e0d\u662f\u6536\u83b7\u67d0\u4e9b\u6750\u6599\u7684\u6700\u4f73\u9009\u62e9\u3002\u6d41\u7a0b\u56fe\u53ef\u4ee5\u5e2e\u52a9\u4f60\u786e\u5b9a\u91c7\u77ff\u8d44\u6e90\u7684\u6700\u4f73\u987a\u5e8f\uff0c\u4ece\u5e38\u89c1\u7684\u6750\u6599\u5f00\u59cb\uff0c\u7136\u540e\u6269\u5c55\u5230\u66f4\u590d\u6742\u7684\u6210\u5206\uff0c\u4ee5\u5728\u6e38\u620f\u4e2d\u53d6\u5f97\u8fdb\u5c55\u3002"}, {"question": "\u5728\u65b9\u5757\u4e16\u754c\u4e2d\uff0c\u6700\u6709\u6548\u7684\u57fa\u5730\u9632\u5fa1\u7b56\u7565\u662f\u4ec0\u4e48\uff0c\u4ee5\u62b5\u5fa1\u591c\u95f4\u602a\u7269\uff0c\u4ee5\u53ca\u6211\u5e94\u8be5\u4f18\u5148\u8003\u8651\u54ea\u4e9b\u9677\u9631\uff1f", "answer": "\u5728\u65b9\u5757\u4e16\u754c\u4e2d\u6709\u6548\u7684\u57fa\u5730\u9632\u5fa1\u9700\u8981\u6218\u7565\u601d\u7ef4\u548c\u89c4\u5212\u3002\u4f18\u5148\u4f7f\u7528\u77f3\u7816\u6216\u52a0\u56fa\u65b9\u5757\u5728\u4f60\u7684\u57fa\u5730\u5468\u56f4\u521b\u5efa\u5b89\u5168\u533a\u57df\u3002\u8003\u8651\u81f3\u5c11\u5efa\u9020\u4e09\u5757\u9ad8\u7684\u56f4\u5899\uff0c\u4ee5\u9632\u6b62\u602a\u7269\u8df3\u8fc7\u3002\u9677\u9631\u4e5f\u626e\u6f14\u7740\u5173\u952e\u89d2\u8272\u3002\u7b80\u5355\u7684\u9677\u9631\u5751\u6216\u538b\u529b\u677f\u89e6\u53d1\u6807\u67aa\u53d1\u5c04\u5668\u53ef\u4ee5\u8fc5\u901f\u6d88\u706d\u654c\u4eba\u3002\u4f8b\u5982\uff0c\u5728\u4f60\u7684\u57fa\u5730\u5468\u56f4\u6316\u4e00\u6761\u7194\u5ca9\u58d5\u6c9f\u53ef\u4ee5\u6210\u4e3a\u8bb8\u591a\u751f\u7269\u65e0\u6cd5\u903e\u8d8a\u7684\u969c\u788d\u3002\u8bb0\u4f4f\u7167\u660e\uff01\u660e\u4eae\u7684\u533a\u57df\u53ef\u4ee5\u963b\u6b62\u5927\u591a\u6570\u654c\u5bf9\u751f\u7269\u751f\u6210\u3002\u5c1d\u8bd5\u4e0d\u540c\u7684\u7ec4\u5408\uff0c\u6253\u9020\u51fa\u5b8c\u7f8e\u7684\u53cd\u602a\u7269\u5821\u5792\u3002\u9632\u5fa1\u4f60\u7684\u57fa\u5730\u9700\u8981\u591a\u5c42\u6b21\u7684\u65b9\u6cd5\uff0c\u65e2\u4f7f\u7528\u7ed3\u6784\u9632\u5fa1\uff0c\u4e5f\u4f7f\u7528\u4e3b\u52a8\u9677\u9631\u3002"}, {"question": "\u5982\u4f55\u521b\u5efa\u65b9\u5757\u4e16\u754c\u7684\u81ea\u52a8\u5316\u519c\u573a\uff0c\u4f8b\u5982\u5c0f\u9ea6\u6216\u5357\u74dc\uff0c\u4ee5\u53ca\u6240\u9700\u7684\u7ec4\u4ef6\u662f\u4ec0\u4e48\uff1f", "answer": "\u65b9\u5757\u4e16\u754c\u4e2d\u7684\u81ea\u52a8\u5316\u519c\u573a\u5229\u7528\u6e38\u620f\u673a\u5236\uff0c\u5728\u65e0\u9700\u73a9\u5bb6\u6301\u7eed\u64cd\u4f5c\u7684\u60c5\u51b5\u4e0b\u6536\u83b7\u8d44\u6e90\u3002\u5173\u952e\u90e8\u4ef6\u5305\u62ec\u6c34\u6e90\uff08\u4f8b\u5982\u7ed9\u4f5c\u7269\u704c\u6e89\uff09\u3001\u6f0f\u6597\uff08\u6536\u96c6\u6389\u843d\u7269\u54c1\uff09\u548c\u6d3b\u585e\uff08\u81ea\u52a8\u6536\u83b7\u4f5c\u7269\uff09\u3002\u4f8b\u5982\uff0c\u4e00\u4e2a\u57fa\u672c\u7684\u5c0f\u9ea6\u519c\u573a\u6d89\u53ca\u5728\u519c\u7530\u4e4b\u95f4\u653e\u7f6e\u6c34\u6e20\u7684\u884c\u3002\u5728\u519c\u7530\u4e0a\u65b9\uff0c\u4f60\u53ef\u4ee5\u653e\u7f6e\u8fde\u63a5\u5230\u5b9a\u65f6\u5668\u7535\u8def\uff08\u6b65\u9aa41\uff09\u7684\u6d3b\u585e\u3002\u5f53\u5b9a\u65f6\u5668\u6fc0\u6d3b\u65f6\uff0c\u6d3b\u585e\u63a8\u52a8\u5c0f\u9ea6\uff0c\u5bfc\u81f4\u5176\u65ad\u88c2\u5e76\u6389\u843d\uff08\u6b65\u9aa42\uff09\u3002\u519c\u7530\u4e0b\u65b9\u7684\u6f0f\u6597\u4f1a\u6536\u96c6\u6389\u843d\u7684\u5c0f\u9ea6\u5e76\u5c06\u5176\u8fd0\u9001\u5230\u50a8\u7269\u7bb1\uff08\u6b65\u9aa43\uff09\u3002\u81ea\u52a8\u5316\u4f60\u7684\u8d44\u6e90\u5c06\u4f7f\u4f60\u80fd\u96c6\u4e2d\u7cbe\u529b\u5728\u6e38\u620f\u66f4\u91cd\u8981\u7684\u5143\u7d20\u4e0a\u3002"}, {"question": "\u65b9\u5757\u4e16\u754c\u7684\u4e0d\u540c\u751f\u7269\u7fa4\u843d\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\uff0c\u4ee5\u53ca\u6bcf\u4e2a\u751f\u7269\u7fa4\u843d\u90fd\u63d0\u4f9b\u54ea\u4e9b\u72ec\u7279\u7684\u8d44\u6e90\u548c\u6311\u6218\uff1f", "answer": "\u65b9\u5757\u4e16\u754c\u6709\u5404\u79cd\u5404\u6837\u7684\u751f\u7269\u7fa4\u843d\uff0c\u6bcf\u4e2a\u751f\u7269\u7fa4\u843d\u90fd\u5448\u73b0\u72ec\u7279\u7684\u8d44\u6e90\u3001\u6311\u6218\u548c\u6e38\u620f\u673a\u4f1a\u3002\u68ee\u6797\u751f\u7269\u7fa4\u843d\u5bcc\u542b\u6728\u6750\u548c\u88ab\u52a8\u52a8\u7269\uff0c\u4f7f\u5176\u6210\u4e3a\u7406\u60f3\u7684\u8d77\u59cb\u5730\u70b9\u3002\u6c99\u6f20\u751f\u7269\u7fa4\u843d\u63d0\u4f9b\u6c99\u5b50\u548c\u4ed9\u4eba\u638c\uff0c\u4f46\u6c34\u8d44\u6e90\u7a00\u7f3a\u3002\u96ea\u5730\u751f\u7269\u7fa4\u843d\u5219\u5e26\u6765\u5bd2\u51b7\u7684\u6e29\u5ea6\u548c\u6709\u9650\u7684\u80fd\u89c1\u5ea6\u6311\u6218\u3002\u4e3a\u4e86\u66f4\u6df1\u5165\u5730\u5206\u6790\uff0c\u53ef\u4ee5\u521b\u5efa\u4e00\u4e2a\u7c7b\u4f3c\u8c61\u9650\u56fe\u7684\u7f51\u683c\uff0c\u5176\u4e2dX\u8f74\u4ee3\u8868\u8d44\u6e90\uff08\u7a00\u7f3a/\u4e30\u5bcc\uff09\uff0cY\u8f74\u4ee3\u8868\u6311\u6218\uff08\u4f4e/\u9ad8\uff09\u3002\u8611\u83c7\u5c9b\u7b49\u751f\u7269\u7fa4\u843d\u63d0\u4f9b\u72ec\u7279\u7684\u8d44\u6e90\u548c\u4f4e\u88ab\u52a8\u602a\u7269\u751f\u6210\u7387\u3002\u7406\u89e3\u6bcf\u4e2a\u751f\u7269\u7fa4\u843d\u7684\u7ec6\u5fae\u5dee\u522b\u5bf9\u4e8e\u6709\u6548\u5730\u7ba1\u7406\u8d44\u6e90\u548c\u63a2\u7d22\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u4f60\u80fd\u89e3\u91ca\u4e00\u4e0b\u63a7\u5236\u65b9\u5757\u4e16\u754c\u602a\u7269\u751f\u6210\u7cfb\u7edf\u7684\u57fa\u672c\u673a\u5236\uff0c\u5305\u62ec\u5149\u7ebf\u6c34\u5e73\u548c\u65b9\u5757\u7c7b\u578b\u7b49\u56e0\u7d20\uff1f", "answer": "\u65b9\u5757\u4e16\u754c\u7684\u602a\u7269\u751f\u6210\u7cfb\u7edf\u53d7\u591a\u79cd\u56e0\u7d20\u7684\u5f71\u54cd\uff0c\u5176\u4e2d\u6700\u91cd\u8981\u7684\u662f\u5149\u7ebf\u6c34\u5e73\u3002\u654c\u5bf9\u602a\u7269\u901a\u5e38\u4f1a\u51fa\u73b0\u5728\u5149\u7ebf\u6c34\u5e73\u4e3a7\u6216\u66f4\u4f4e\u7684\u4f4d\u7f6e\u3002\u8fd9\u610f\u5473\u7740\u9ed1\u6697\u3001\u672a\u7167\u660e\u7684\u533a\u57df\u662f\u4e3b\u8981\u7684\u602a\u7269\u751f\u6210\u5730\u3002\u4e0d\u540c\u7684\u65b9\u5757\u7c7b\u578b\u4e5f\u4f1a\u5f71\u54cd\u751f\u6210\u3002\u4f8b\u5982\uff0c\u67d0\u4e9b\u602a\u7269\u66f4\u6709\u53ef\u80fd\u5728\u7279\u5b9a\u65b9\u5757\u4e0a\u751f\u6210\uff0c\u4f8b\u5982\u9ab7\u9ac5\u5728\u6c99\u6f20\u751f\u7269\u7fa4\u843d\u4e2d\u751f\u6210\u3002\u4e00\u5929\u7684\u65f6\u95f4\u4e5f\u4f1a\u5f71\u54cd\u751f\u6210\uff1b\u665a\u4e0a\u901a\u5e38\u66f4\u5371\u9669\uff0c\u56e0\u4e3a\u602a\u7269\u6d3b\u52a8\u589e\u52a0\u3002\u7406\u89e3\u8fd9\u4e9b\u57fa\u672c\u673a\u5236\u6709\u52a9\u4e8e\u73a9\u5bb6\u884c\u4e3a\u548c\u57fa\u5730\u8bbe\u8ba1\u3002\u901a\u8fc7\u706b\u70ac\u3001\u706f\u7b3c\u548c\u5176\u4ed6\u5149\u6e90\u53ef\u4ee5\u4eba\u4e3a\u5730\u63a7\u5236\u5149\u7ebf\u6c34\u5e73\u3002"}, {"question": "\u65b9\u5757\u4e16\u754c\u8de8\u5e73\u53f0\u6e38\u620f\uff1aPC\u3001\u4e3b\u673a\u548c\u79fb\u52a8\u7248\u672c\u4e4b\u95f4\u662f\u5426\u53ef\u4ee5\u5b9e\u73b0\u8de8\u5e73\u53f0\u6e38\u620f\u6216\u6570\u636e\u8fc1\u79fb\uff1f", "answer": "\u65b9\u5757\u4e16\u754c\u4e2d\u8de8\u5e73\u53f0\u6e38\u620f\u548c\u6570\u636e\u8fc1\u79fb\u7684\u53ef\u7528\u6027\u53d6\u51b3\u4e8e\u7279\u5b9a\u7248\u672c\u548c\u5e73\u53f0\u653f\u7b56\u3002\u901a\u5e38\u60c5\u51b5\u4e0b\uff0cPC\u7248\u548c\u4e00\u4e9b\u4e3b\u673a\u7248\u65b9\u5757\u4e16\u754c\u53ef\u80fd\u4f1a\u652f\u6301\u8de8\u5e73\u53f0\u6e38\u620f\uff0c\u5141\u8bb8\u4e0d\u540c\u5e73\u53f0\u4e0a\u7684\u73a9\u5bb6\u4e00\u8d77\u6e38\u620f\u3002\u7136\u800c\uff0c\u6570\u636e\u8fc1\u79fb\u4e0d\u592a\u5e38\u89c1\uff0c\u8fd9\u662f\u7531\u4e8e\u5e73\u53f0\u7279\u5b9a\u7684\u5b58\u6863\u6587\u4ef6\u683c\u5f0f\u548c\u5b89\u5168\u63aa\u65bd\u3002\u8bf7\u67e5\u770b\u65b9\u5757\u4e16\u754c\u7684\u5b98\u65b9\u7f51\u7ad9\u6216\u4f60\u6240\u5728\u5e73\u53f0\u7684\u5728\u7ebf\u670d\u52a1\uff0c\u4ee5\u83b7\u53d6\u6709\u5173\u8de8\u5e73\u53f0\u652f\u6301\u548c\u6570\u636e\u4f20\u8f93\u9009\u9879\u7684\u5177\u4f53\u4fe1\u606f\u3002\u5e76\u975e\u6240\u6709\u5e73\u53f0\u90fd\u4e00\u6837\uff0c\u5f53\u5b58\u5728\u80fd\u529b\u5dee\u5f02\u65f6\uff0c\u5e76\u975e\u6240\u6709\u5e73\u53f0\u90fd\u5141\u8bb8\u8de8\u5e73\u53f0\u6e38\u620f\u3002"}, {"question": "\u5982\u4f55\u5728\u65b9\u5757\u4e16\u754c\u4e2d\u627e\u5230\u6c34\u6676\u6d1e\u7a74\uff0c\u4ee5\u53ca\u53d1\u73b0\u540e\u5982\u4f55\u89e6\u53d1\u72ec\u7279\u7684\u5236\u4f5c\u914d\u65b9\u6216\u4e8b\u4ef6\uff1f", "answer": "\u6c34\u6676\u6d1e\u7a74\u662f\u65b9\u5757\u4e16\u754c\u4e2d\u9690\u85cf\u7684\u751f\u7269\u7fa4\u843d\uff0c\u901a\u5e38\u4f4d\u4e8e\u5730\u4e0b\u6df1\u5904\u6216\u5c71\u5730\u751f\u7269\u7fa4\u843d\u4e2d\u3002\u5b83\u4eec\u4ee5\u72ec\u7279\u7684\u6676\u4f53\u7ed3\u6784\u548c\u53d1\u5149\u73af\u5883\u4e3a\u7279\u5f81\u3002\u8981\u627e\u5230\u5b83\u4eec\uff0c\u8bf7\u5f7b\u5e95\u63a2\u7d22\u6d1e\u7a74\uff0c\u91cd\u70b9\u5173\u6ce8\u5177\u6709\u5f02\u5e38\u5730\u8d28\u7279\u5f81\u7684\u533a\u57df\u3002\u6c34\u6676\u6d1e\u7a74\u5305\u542b\u72ec\u7279\u7684\u8d44\u6e90\uff0c\u4f8b\u5982\u7a00\u6709\u5b9d\u77f3\u548c\u6c34\u6676\uff0c\u8fd9\u4e9b\u8d44\u6e90\u662f\u5236\u4f5c\u9ad8\u7ea7\u7269\u54c1\u548c\u89e6\u53d1\u7279\u6b8a\u4e8b\u4ef6\u6240\u5fc5\u9700\u7684\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u8fd9\u4e9b\u5b9d\u77f3\u5236\u4f5c\u201c\u6c34\u6676\u62a4\u8eab\u7b26\u201d\u53ef\u80fd\u4f1a\u5f00\u542f\u9690\u85cf\u7684\u4efb\u52a1\u7ebf\u6216\u89e3\u9501\u65b0\u7684\u7ef4\u5ea6\u3002\u5bfb\u627e\u7ec6\u5fae\u7684\u89c6\u89c9\u7ebf\u7d22\uff0c\u4f8b\u5982\u6d1e\u7a74\u5165\u53e3\u5904\u7684\u5fae\u5f31\u5149\u8292\uff0c\u5b83\u8868\u660e\u4e86\u6c34\u6676\u6d1e\u7a74\u7684\u9644\u8fd1\u3002"}]
[{"question": "\u30db\u30c3\u30d7\u30a6\u30a9\u30fc\u3067\u521d\u5fc3\u8005\u304c\u57fa\u672c\u7684\u306a\u30db\u30c3\u30d7\u3092\u884c\u3046\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30db\u30c3\u30d7\u30a6\u30a9\u30fc\u3067\u57fa\u672c\u7684\u306a\u30db\u30c3\u30d7\u3092\u884c\u3046\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30db\u30c3\u30d7\u3092\u958b\u59cb\u3059\u308b\u306b\u306f\u3001\u300e\u30b9\u30da\u30fc\u30b9\u300f\u30ad\u30fc\u3092\u62bc\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30db\u30c3\u30d7\u306e\u65b9\u5411\u3092\u5236\u5fa1\u3059\u308b\u306b\u306f\u3001\u300eWASD\u300f\u30ad\u30fc\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7740\u5730\u3059\u308b\u306b\u306f\u3001\u300e\u30b9\u30da\u30fc\u30b9\u300f\u30ad\u30fc\u3092\u96e2\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u5c0f\u3055\u306a\u30ae\u30e3\u30c3\u30d7\u3092\u98db\u3073\u8d8a\u3048\u308b\u3053\u3068\u3067\u3001\u9032\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u305d\u308c\u306f\u3001\u6b69\u9053\u3067\u6c34\u305f\u307e\u308a\u3092\u98db\u3073\u8d8a\u3048\u308b\u3053\u3068\u306b\u4f3c\u3066\u3044\u307e\u3059\u3002]"}, {"question": "\u30db\u30c3\u30d7\u30a6\u30a9\u30fc\u3067\u5fc5\u8981\u306a\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30db\u30c3\u30d7\u30a6\u30a9\u30fc\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u306b\u306f\u3001\u30db\u30c3\u30d7\u306b\u300e\u30b9\u30da\u30fc\u30b9\u300f\u30ad\u30fc\u3001\u79fb\u52d5\u306b\u300eWASD\u300f\u30ad\u30fc\u3001\u30c0\u30c3\u30b7\u30e5\u306b\u300e\u30b7\u30d5\u30c8\u300f\u30ad\u30fc\u3001\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3068\u5bfe\u8a71\u3059\u308b\u306b\u306f\u300eE\u300f\u30ad\u30fc\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30ec\u30d9\u30eb\u3067\u30c9\u30a2\u3092\u958b\u3051\u308b\u305f\u3081\u306b\u300eE\u300f\u30ad\u30fc\u3092\u4f7f\u3046\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002[\u8a2d\u5b9a\u5bfe\u7167\u8868\uff1a\u30b9\u30da\u30fc\u30b9=\u30db\u30c3\u30d7\u3001WASD=\u79fb\u52d5\u3001\u30b7\u30d5\u30c8=\u30c0\u30c3\u30b7\u30e5\u3001E=\u5bfe\u8a71]"}, {"question": "\u30db\u30c3\u30d7\u30a6\u30a9\u30fc\u306e\u30db\u30c3\u30d7\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u304a\u3044\u3066\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u30db\u30c3\u30d7\u30a6\u30a9\u30fc\u3067\u306f\u3001\u969c\u5bb3\u7269\u3084\u30ae\u30e3\u30c3\u30d7\u3092\u98db\u3073\u8d8a\u3048\u308b\u6210\u529f\u3092\u6c7a\u5b9a\u3059\u308b\u305f\u3081\u306b\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u72ed\u3044\u901a\u8def\u300f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30db\u30c3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u9593\u9055\u3048\u308b\u3068\u3001\u7a74\u306b\u843d\u3061\u3066\u3057\u307e\u3046\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u305d\u308c\u306f\u7e04\u8df3\u3073\u306e\u3088\u3046\u306b\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u3042\u306a\u305f\u306e\u5931\u8db3\u3092\u9632\u304e\u307e\u3059\u3002]"}, {"question": "\u4e0a\u7d1a\u30ec\u30d9\u30eb\u3067\u30db\u30c3\u30d7\u30a6\u30a9\u30fc\u306e\u30db\u30c3\u30d7\u8ddd\u96e2\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30db\u30c3\u30d7\u8ddd\u96e2\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a'\u30b9\u30da\u30fc\u30b9'\u30ad\u30fc\u3092\u9577\u304f\u62bc\u3057\u7d9a\u3051\u308b\u3053\u3068\u3067\u3001\u30db\u30c3\u30d7\u3092\u30c1\u30e3\u30fc\u30b8\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30c0\u30c3\u30b7\u30e5\u30ad\u30fc\u300e\u30b7\u30d5\u30c8\u300f\u3092\u4f7f\u3063\u3066\u52e2\u3044\u3092\u4ed8\u3051\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b8\u30e3\u30f3\u30d7\u306e\u9802\u70b9\u3067\u300e\u30b9\u30da\u30fc\u30b9\u300f\u30ad\u30fc\u3092\u96e2\u3057\u307e\u3059\u3002\u300e\u7a7a\u3078\u306e\u30b8\u30e3\u30f3\u30d7\u300f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u3053\u306e\u30c6\u30af\u30cb\u30c3\u30af\u304c\u3088\u308a\u5e83\u3044\u30ae\u30e3\u30c3\u30d7\u3092\u6a2a\u65ad\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002[\u8907\u6570\u9078\u629e\u80a2\u306e\u6bd4\u8f03\uff1a\u30b7\u30e7\u30fc\u30c8\u30db\u30c3\u30d7=\u8ddd\u96e2\u304c\u77ed\u3044\u3001\u30c1\u30e3\u30fc\u30b8\u30c9\u30db\u30c3\u30d7=\u6700\u5927\u8ddd\u96e2]"}, {"question": "\u30db\u30c3\u30d7\u30a6\u30a9\u30fc\u3067\u30c0\u30d6\u30eb\u30db\u30c3\u30d7\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u305f\u3081\u306b\u4f7f\u7528\u3067\u304d\u308b\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30c0\u30d6\u30eb\u30db\u30c3\u30d7\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71: \u901a\u5e38\u306e\u30db\u30c3\u30d7\u3092\u884c\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72: \u7a7a\u4e2d\u306b\u3044\u308b\u9593\u306b\u3059\u3050\u306b\u300e\u30b9\u30da\u30fc\u30b9\u300f\u30ad\u30fc\u3092\u3082\u3046\u4e00\u5ea6\u62bc\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u65b9\u5411\u3092\u7cbe\u5ea6\u3092\u4fdd\u3064\u305f\u3081\u306b\u300eWASD\u300f\u30ad\u30fc\u3067\u8abf\u6574\u3057\u307e\u3059\u3002\u300e\u96f2\u306e\u56fd\u300f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u3088\u308a\u9ad8\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u5230\u9054\u3059\u308b\u305f\u3081\u306b\u30c0\u30d6\u30eb\u30db\u30c3\u30d7\u304c\u91cd\u8981\u3067\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u305d\u308c\u306f\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30de\u30fc\u3067\u306e\u30c0\u30d6\u30eb\u30b8\u30e3\u30f3\u30d7\u3068\u4f3c\u3066\u3044\u3066\u3001\u3088\u308a\u9ad8\u3044\u9ad8\u3055\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002]"}, {"question": "\u6226\u7565\u7684\u306a\u512a\u4f4d\u6027\u3092\u78ba\u7acb\u3059\u308b\u305f\u3081\u306b\u3001\u30db\u30c3\u30d7\u30a6\u30a9\u30fc\u3067\u512a\u5148\u7684\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u3079\u304d\u80fd\u529b\u306f\u3069\u308c\u3067\u3059\u304b\uff1f", "answer": "\u6226\u7565\u7684\u306a\u5229\u70b9\u306e\u305f\u3081\u306b\u306f\u3001\u300e\u30a8\u30a2\u30c0\u30c3\u30b7\u30e5\u300f\u3068\u300e\u30b0\u30e9\u30d3\u30c6\u30a3\u30d5\u30ea\u30c3\u30d7\u300f\u306e\u80fd\u529b\u3092\u512a\u5148\u7684\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u300e\u30a8\u30a2\u30c0\u30c3\u30b7\u30e5\u300f\u306f\u7d20\u65e9\u3044\u6c34\u5e73\u79fb\u52d5\u3092\u53ef\u80fd\u306b\u3057\u3001\u300e\u30b0\u30e9\u30d3\u30c6\u30a3\u30d5\u30ea\u30c3\u30d7\u300f\u306f\u30db\u30c3\u30d7\u306e\u65b9\u5411\u3092\u53cd\u8ee2\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u9006\u8ee2\u306e\u4e16\u754c\u300f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u300e\u91cd\u529b\u30d5\u30ea\u30c3\u30d7\u300f\u304c\u4e0d\u53ef\u6b20\u3067\u3059\u3002[\u8a2d\u5b9a\u5bfe\u7167\u8868\uff1a\u30a8\u30a2\u30c0\u30c3\u30b7\u30e5=\u6c34\u5e73\u901f\u5ea6\u3001\u91cd\u529b\u30d5\u30ea\u30c3\u30d7=\u65b9\u5411\u53cd\u8ee2]"}, {"question": "\u30db\u30c3\u30d7\u30a6\u30a9\u30fc\u306e\u91cd\u529b\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30db\u30c3\u30d7\u30a6\u30a9\u30fc\u306e\u91cd\u529b\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u3088\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30db\u30c3\u30d7\u3092\u53cd\u8ee2\u3055\u305b\u3066\u79fb\u52d5\u65b9\u5411\u3092\u5909\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u300e\u91cd\u529b\u8ff7\u5bae\u300f\u306e\u3088\u3046\u306a\u30ec\u30d9\u30eb\u3067\u7279\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u305d\u3053\u3067\u3001\u4e0a\u4e0b\u9006\u3055\u307e\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u79fb\u52d5\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u305d\u308c\u306f\u3001\u30d1\u30f3\u30b1\u30fc\u30ad\u3092\u3072\u3063\u304f\u308a\u8fd4\u3059\u3088\u3046\u306a\u3082\u306e\u3067\u3001\u6280\u8853\u3092\u8abf\u6574\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002]"}, {"question": "\u30db\u30c3\u30d7\u30a6\u30a9\u30fc\u3067\u3001\u901a\u5e38\u306e\u30db\u30c3\u30d7\u3068\u30c1\u30e3\u30fc\u30b8\u30c9\u30db\u30c3\u30d7\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u901a\u5e38\u306e\u30db\u30c3\u30d7\u306f\u8fc5\u901f\u3067\u8ddd\u96e2\u304c\u77ed\u304f\u3001\u30c1\u30e3\u30fc\u30b8\u30c9\u30db\u30c3\u30d7\u306f\u300e\u30b9\u30da\u30fc\u30b9\u300f\u30ad\u30fc\u3092\u9577\u304f\u62bc\u3057\u7d9a\u3051\u3001\u3088\u308a\u9577\u3044\u8ddd\u96e2\u3092\u79fb\u52d5\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u300e\u30ed\u30f3\u30b0\u30b8\u30e3\u30f3\u30d7\u300f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u5e83\u5927\u306a\u5ce1\u8c37\u3092\u6e21\u308b\u305f\u3081\u306b\u30c1\u30e3\u30fc\u30b8\u30c9\u30db\u30c3\u30d7\u304c\u5fc5\u8981\u3067\u3059\u3002[\u8907\u6570\u9078\u629e\u80a2\u306e\u6bd4\u8f03\uff1a\u901a\u5e38\u306e\u30db\u30c3\u30d7=\u8ddd\u96e2\u304c\u77ed\u3044\u3001\u30c1\u30e3\u30fc\u30b8\u30c9\u30db\u30c3\u30d7=\u8ddd\u96e2\u304c\u9577\u3044]"}, {"question": "PC\u7248\u306e\u30db\u30c3\u30d7\u30a6\u30a9\u30fc\u306e\u9032\u884c\u72b6\u6cc1\u3092\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u306b\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30b2\u30fc\u30e0\u306e\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u901a\u3058\u3066\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u9023\u643a\u3055\u305b\u308b\u3053\u3068\u306b\u3088\u308a\u3001\u30db\u30c3\u30d7\u30a6\u30a9\u30fc\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3067\u304d\u307e\u3059\u3002\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u3001\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u3068\u3001\u300e\u7a7a\u3078\u306e\u30b8\u30e3\u30f3\u30d7\u300f\u30ec\u30d9\u30eb\u304b\u3089\u4e2d\u65ad\u3057\u305f\u3068\u3053\u308d\u304b\u3089\u518d\u958b\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1aPC\u2192\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u2192\u30e2\u30d0\u30a4\u30eb]"}, {"question": "\u30db\u30c3\u30d7\u30a6\u30a9\u30fc\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30db\u30c3\u30d7\u30a6\u30a9\u30fc\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3068\u3057\u3066\u3001\u300e\u795e\u79d8\u306e\u5ead\u5712\u300f\u30ec\u30d9\u30eb\u3067\u7279\u5b9a\u306e\u30db\u30c3\u30d7\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u5b9f\u884c\u3059\u308b\u3053\u3068\u3067\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u300e\u79d8\u5bc6\u306e\u30ef\u30fc\u30d7\u30eb\u30fc\u30e0\u300f\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u306e\u90e8\u5c4b\u306b\u306f\u3001\u30e6\u30cb\u30fc\u30af\u306a\u30b3\u30ec\u30af\u30b7\u30e7\u30f3\u3068\u30ed\u30a2\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u305d\u308c\u306f\u3001\u8ff7\u8def\u306e\u4e2d\u306b\u96a0\u3055\u308c\u305f\u5b9d\u7bb1\u3092\u898b\u3064\u3051\u308b\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002]"}]
[{"question": "\u5982\u4f55\u57f7\u884c\u8df3\u8e8d\u5927\u5e2b\u7684\u521d\u5b78\u8005\u57fa\u672c\u8df3\u8e8d\uff1f", "answer": "\u8981\u57f7\u884c\u8df3\u8e8d\u5927\u5e2b\u7684\u57fa\u672c\u8df3\u8e8d\uff0c\u8acb\u6309\u7167\u4e0b\u5217\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u6309\u4e0b\u300c\u7a7a\u683c\u9375\u300d\u555f\u52d5\u8df3\u8e8d\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u300cWASD\u9375\u300d\u63a7\u5236\u8df3\u8e8d\u65b9\u5411\u3002\u6b65\u9a5f3\uff1a\u9b06\u958b\u300c\u7a7a\u683c\u9375\u300d\u843d\u5730\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u95dc\uff0c\u8df3\u904e\u4e00\u5c0f\u6bb5\u7a7a\u9699\u5c07\u6709\u52a9\u65bc\u4f60\u7684\u9032\u5ea6\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4e00\u4e0b\uff0c\u5c31\u50cf\u5728\u4eba\u884c\u9053\u4e0a\u8df3\u904e\u6c34\u7aaa\u4e00\u6a23\u3002]"}, {"question": "\u5728\u8df3\u8e8d\u5927\u5e2b\u4e2d\uff0c\u6211\u9700\u8981\u4e86\u89e3\u54ea\u4e9b\u57fa\u672c\u7684\u63a7\u5236\uff1f", "answer": "\u8df3\u8e8d\u5927\u5e2b\u4e2d\u7684\u57fa\u672c\u63a7\u5236\u5305\u62ec\uff1a\u4f7f\u7528\u300c\u7a7a\u683c\u9375\u300d\u8df3\u8e8d\u3001\u300cWASD\u9375\u300d\u79fb\u52d5\u3001\u300cShift\u9375\u300d\u885d\u523a\u4ee5\u53ca\u300cE\u9375\u300d\u8207\u7269\u4ef6\u4e92\u52d5\u3002\u4f8b\u5982\uff0c\u5728\u6559\u5b78\u95dc\u5361\u4e2d\u4f7f\u7528\u300cE\u9375\u300d\u958b\u555f\u9580\u81f3\u95dc\u91cd\u8981\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u7a7a\u683c\u9375=\u8df3\u8e8d\uff0cWASD\u9375=\u79fb\u52d5\uff0cShift\u9375=\u885d\u523a\uff0cE\u9375=\u4e92\u52d5]"}, {"question": "\u70ba\u4ec0\u9ebc\u8df3\u8e8d\u5927\u5e2b\u7684\u8df3\u8e8d\u6a5f\u5236\u4e2d\u6642\u9593\u5f88\u91cd\u8981\uff1f", "answer": "\u8df3\u8e8d\u5927\u5e2b\u4e2d\u6642\u9593\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6c7a\u5b9a\u4e86\u4f60\u662f\u5426\u80fd\u6210\u529f\u8df3\u904e\u969c\u7919\u7269\u548c\u7a7a\u9699\u3002\u4f8b\u5982\uff0c\u5728\u300c\u72f9\u7a84\u901a\u9053\u300d\u95dc\u5361\uff0c\u8df3\u8e8d\u6642\u9593\u4e0d\u6e96\u78ba\u53ef\u80fd\u6703\u6389\u5165\u9677\u9631\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u9019\u5c31\u50cf\u8df3\u7e69\uff1b\u6642\u9593\u7684\u6e96\u78ba\u6027\u78ba\u4fdd\u4f60\u4e0d\u6703\u7d46\u5012\u3002]"}, {"question": "\u5982\u4f55\u512a\u5316\u6211\u5728\u8df3\u8e8d\u5927\u5e2b\u4e2d\u9032\u968e\u95dc\u5361\u7684\u8df3\u8e8d\u8ddd\u96e2\uff1f", "answer": "\u8981\u512a\u5316\u8df3\u8e8d\u8ddd\u96e2\uff1a\u6b65\u9a5f1\uff1a\u900f\u904e\u9577\u6642\u9593\u6309\u4f4f\u300c\u7a7a\u683c\u9375\u300d\u4f86\u84c4\u52e2\u5f85\u767c\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u885d\u523a\u9375\u300cShift\u9375\u300d\u7372\u5f97\u52d5\u80fd\u3002\u6b65\u9a5f3\uff1a\u5728\u8df3\u8e8d\u9802\u9ede\u91cb\u653e\u300c\u7a7a\u683c\u9375\u300d\u3002\u5728\u300c\u5929\u7a7a\u8df3\u8e8d\u300d\u95dc\u5361\uff0c\u6b64\u6280\u5de7\u6709\u52a9\u65bc\u4f60\u8de8\u8d8a\u66f4\u5bec\u7684\u7a7a\u9699\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u77ed\u8df3\u8e8d=\u8ddd\u96e2\u8f03\u77ed\uff0c\u84c4\u52e2\u8df3\u8e8d=\u6700\u5927\u8ddd\u96e2]"}, {"question": "\u6211\u53ef\u4ee5\u7528\u54ea\u4e9b\u7b56\u7565\u4f86\u638c\u63e1\u8df3\u8e8d\u5927\u5e2b\u4e2d\u7684\u96d9\u91cd\u8df3\u8e8d\uff1f", "answer": "\u638c\u63e1\u96d9\u91cd\u8df3\u8e8d\u5305\u62ec\uff1a\u6b65\u9a5f1\uff1a\u57f7\u884c\u6a19\u6e96\u8df3\u8e8d\u3002\u6b65\u9a5f2\uff1a\u5728\u7a7a\u4e2d\u6642\u7acb\u5373\u518d\u6b21\u6309\u4e0b\u300c\u7a7a\u683c\u9375\u300d\u3002\u6b65\u9a5f3\uff1a\u4f7f\u7528\u300cWASD\u9375\u300d\u8abf\u6574\u65b9\u5411\u4ee5\u9054\u5230\u7cbe\u78ba\u5ea6\u3002\u5728\u300c\u96f2\u570b\u300d\u95dc\u5361\uff0c\u96d9\u91cd\u8df3\u8e8d\u81f3\u95dc\u91cd\u8981\u624d\u80fd\u5230\u9054\u8f03\u9ad8\u7684\u5e73\u53f0\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u9019\u5c31\u50cf\u5e73\u81fa\u904a\u6232\u4e2d\u7684\u96d9\u8df3\uff0c\u7d66\u4f60\u984d\u5916\u7684\u8df3\u8e8d\u9ad8\u5ea6\u3002]"}, {"question": "\u5728\u8df3\u8e8d\u5927\u5e2b\u4e2d\uff0c\u6211\u61c9\u8a72\u512a\u5148\u89e3\u9396\u54ea\u4e9b\u80fd\u529b\u4f86\u7372\u5f97\u6230\u7565\u512a\u52e2\uff1f", "answer": "\u512a\u5148\u89e3\u9396\u300c\u7a7a\u4e2d\u885d\u523a\u300d\u548c\u300c\u91cd\u529b\u7ffb\u8f49\u300d\u80fd\u529b\u3002\u300c\u7a7a\u4e2d\u885d\u523a\u300d\u5141\u8a31\u5feb\u901f\u6c34\u5e73\u79fb\u52d5\uff0c\u800c\u300c\u91cd\u529b\u7ffb\u8f49\u300d\u5247\u8b93\u4f60\u53cd\u8f49\u8df3\u8e8d\u65b9\u5411\u3002\u4f8b\u5982\uff0c\u5728\u300c\u53cd\u8f49\u4e16\u754c\u300d\u95dc\u5361\uff0c\u300c\u91cd\u529b\u7ffb\u8f49\u300d\u662f\u4e0d\u53ef\u6216\u7f3a\u7684\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u7a7a\u4e2d\u885d\u523a=\u6c34\u5e73\u901f\u5ea6\uff0c\u91cd\u529b\u7ffb\u8f49=\u65b9\u5411\u53cd\u8f49]"}, {"question": "\u8df3\u8e8d\u5927\u5e2b\u4e2d\u7684\u91cd\u529b\u6a5f\u5236\u5982\u4f55\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff1f", "answer": "\u8df3\u8e8d\u5927\u5e2b\u4e2d\u7684\u91cd\u529b\u6a5f\u5236\u5141\u8a31\u73a9\u5bb6\u53cd\u8f49\u4ed6\u5011\u7684\u8df3\u8e8d\uff0c\u6539\u8b8a\u79fb\u52d5\u65b9\u5411\u3002\u9019\u5728\u50cf\u300c\u91cd\u529b\u8ff7\u5bae\u300d\u9019\u6a23\u7684\u95dc\u5361\u4e2d\u7279\u5225\u6709\u7528\uff0c\u56e0\u70ba\u5728\u90a3\u88e1\u9700\u8981\u7a7f\u8d8a\u985b\u5012\u7684\u5e73\u53f0\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u9019\u5c31\u50cf\u7ffb\u714e\u9905\u4e00\u6a23\uff1b\u4f60\u9700\u8981\u8abf\u6574\u4f60\u7684\u6280\u5de7\u3002]"}, {"question": "\u8df3\u8e8d\u5927\u5e2b\u4e2d\u666e\u901a\u8df3\u8e8d\u548c\u84c4\u52e2\u8df3\u8e8d\u4e4b\u9593\u7684\u95dc\u9375\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "\u666e\u901a\u8df3\u8e8d\u901f\u5ea6\u5feb\uff0c\u8986\u84cb\u7684\u8ddd\u96e2\u77ed\uff0c\u800c\u84c4\u52e2\u8df3\u8e8d\u5247\u9700\u8981\u66f4\u9577\u6642\u9593\u6309\u4f4f\u300c\u7a7a\u683c\u9375\u300d\uff0c\u8986\u84cb\u7684\u8ddd\u96e2\u66f4\u9577\u3002\u5728\u300c\u9577\u8df3\u8e8d\u300d\u95dc\u5361\uff0c\u9700\u8981\u84c4\u52e2\u8df3\u8e8d\u624d\u80fd\u8de8\u8d8a\u5ee3\u95ca\u7684\u5cfd\u8c37\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u666e\u901a\u8df3\u8e8d=\u8ddd\u96e2\u8f03\u77ed\uff0c\u84c4\u52e2\u8df3\u8e8d=\u8ddd\u96e2\u8f03\u9577]"}, {"question": "\u6211\u53ef\u4ee5\u5728 PC \u548c\u884c\u52d5\u88dd\u7f6e\u4e4b\u9593\u8f49\u79fb\u6211\u7684\u8df3\u8e8d\u5927\u5e2b\u904a\u6232\u9032\u5ea6\u55ce\uff1f", "answer": "\u53ef\u4ee5\uff0c\u60a8\u53ef\u4ee5\u900f\u904e\u904a\u6232\u7684\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u9023\u63a5\u60a8\u7684\u5e33\u6236\u4f86\u8f49\u79fb\u60a8\u7684\u8df3\u8e8d\u5927\u5e2b\u904a\u6232\u9032\u5ea6\u3002\u8acb\u78ba\u4fdd\u60a8\u5728\u5169\u90e8\u88dd\u7f6e\u4e0a\u90fd\u767b\u5165\u76f8\u540c\u7684\u5e33\u6236\u3002\u4f8b\u5982\uff0c\u8f49\u79fb\u9032\u5ea6\u5141\u8a31\u4f60\u5728\u300c\u5929\u7a7a\u8df3\u8e8d\u300d\u95dc\u5361\u7e7c\u7e8c\u5148\u524d\u904a\u6232\u7684\u5730\u65b9\u3002[\u6d41\u7a0b\u5716\u89e3\uff1aPC\u2192\u96f2\u7aef\u5132\u5b58\u2192\u884c\u52d5\u88dd\u7f6e]"}, {"question": "\u5728\u8df3\u8e8d\u5927\u5e2b\u4e2d\uff0c\u6211\u80fd\u627e\u5230\u54ea\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\uff1f", "answer": "\u5728\u8df3\u8e8d\u5927\u5e2b\u4e2d\uff0c\u6709\u4e00\u500b\u96b1\u85cf\u7684\u5f69\u86cb\uff0c\u7a31\u70ba\u300c\u79d8\u5bc6\u50b3\u9001\u5ba4\u300d\uff0c\u5b83\u53ef\u5728\u300c\u795e\u79d8\u82b1\u5712\u300d\u95dc\u5361\u900f\u904e\u7279\u5b9a\u8df3\u8e8d\u5e8f\u5217\u4f86\u958b\u555f\u3002\u6b64\u623f\u9593\u5305\u542b\u7368\u7279\u7684\u6536\u96c6\u54c1\u548c\u6545\u4e8b\u80cc\u666f\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u9019\u5c31\u50cf\u5728\u8ff7\u5bae\u4e2d\u627e\u5230\u96b1\u85cf\u7684\u5bf6\u7bb1\u4e00\u6a23\u3002]"}]
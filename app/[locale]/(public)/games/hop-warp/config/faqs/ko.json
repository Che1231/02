[{"question": "\ucd08\ubcf4\uc790\ub97c \uc704\ud55c \ud649 \uc6cc\ud504\uc758 \uae30\ubcf8 \uc810\ud504\ub294 \uc5b4\ub5bb\uac8c \ud558\ub098\uc694?", "answer": "\ud649 \uc6cc\ud504\uc758 \uae30\ubcf8 \uc810\ud504\ub97c \ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: 1\ub2e8\uacc4: \uc810\ud504\ub97c \uc2dc\uc791\ud558\ub824\uba74 '\uc2a4\ud398\uc774\uc2a4' \ud0a4\ub97c \ub204\ub974\uc138\uc694. 2\ub2e8\uacc4: 'WASD' \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc810\ud504 \ubc29\ud5a5\uc744 \uc870\uc808\ud558\uc138\uc694. 3\ub2e8\uacc4: \uc810\ud504\uac00 \ub05d\ub098\uba74 '\uc2a4\ud398\uc774\uc2a4' \ud0a4\ub97c \ub193\uc73c\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c \uc791\uc740 \uac04\uaca9\uc744 \uc810\ud504\ud558\uba74 \uc9c4\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uae38\uac00\uc758 \ubb3c\uc6c5\ub369\uc774\ub97c \ub6f0\uc5b4\ub118\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ud649 \uc6cc\ud504\uc5d0\uc11c \uc54c\uc544\uc57c \ud560 \ud544\uc218 \uc81c\uc5b4\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud649 \uc6cc\ud504\uc758 \ud544\uc218 \uc81c\uc5b4\uc5d0\ub294 \uc810\ud504\ub97c \uc704\ud55c '\uc2a4\ud398\uc774\uc2a4' \ud0a4, \uc774\ub3d9\uc744 \uc704\ud55c 'WASD' \ud0a4, \uc2a4PRINT\ub97c \uc704\ud55c 'Shift' \ud0a4, \uadf8\ub9ac\uace0 \ubb3c\uccb4\uc640 \uc0c1\ud638 \uc791\uc6a9\uc744 \uc704\ud55c 'E' \ud0a4\uac00 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud29c\ud1a0\ub9ac\uc5bc \ub808\ubca8\uc5d0\uc11c 'E'\ub97c \uc0ac\uc6a9\ud558\uc5ec \ubb38\uc744 \uc5ec\ub294 \uac83\uc740 \uc911\uc694\ud569\ub2c8\ub2e4. [\uc124\uc815 \ub300\uc870\ud45c: \uc2a4\ud398\uc774\uc2a4=\uc810\ud504, WASD=\uc774\ub3d9, Shift=\uc2a4PRINT, E=\uc0c1\ud638 \uc791\uc6a9]"}, {"question": "\ud649 \uc6cc\ud504\uc758 \uc810\ud504 \uba54\ucee4\ub2c8\uc998\uc5d0\uc11c \ud0c0\uc774\ubc0d\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud649 \uc6cc\ud504\uc5d0\uc11c \ud0c0\uc774\ubc0d\uc740 \uc7a5\uc560\ubb3c\uacfc \uac04\uaca9\uc744 \ub6f0\uc5b4\ub118\ub294 \uc810\ud504\uc758 \uc131\uacf5 \uc5ec\ubd80\ub97c \uacb0\uc815\ud558\uae30 \ub54c\ubb38\uc5d0 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc881\uc740 \uae38' \ub808\ubca8\uc5d0\uc11c \uc810\ud504 \ud0c0\uc774\ubc0d\uc774 \uc798\ubabb\ub418\uba74 \uad6c\ub369\uc774\uc5d0 \ube60\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc904\ub118\uae30\uc640 \uac19\uc2b5\ub2c8\ub2e4. \ud0c0\uc774\ubc0d\uc744 \ub9de\ucdb0\uc57c \uc2e4\uc218\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.]"}, {"question": "\uace0\uae09 \ub808\ubca8\uc5d0\uc11c \ud649 \uc6cc\ud504\uc758 \uc810\ud504 \uac70\ub9ac\ub97c \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc810\ud504 \uac70\ub9ac\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: 1\ub2e8\uacc4: '\uc2a4\ud398\uc774\uc2a4' \ud0a4\ub97c \ub354 \uae38\uac8c \ub204\ub974\uba74 \uc810\ud504\uac00 \ucda9\uc804\ub429\ub2c8\ub2e4. 2\ub2e8\uacc4: \uc18d\ub3c4\ub97c \ub192\uc774\ub824\uba74 'Shift' \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc2a4PRINT\ud558\uc138\uc694. 3\ub2e8\uacc4: \uc810\ud504\uac00 \ucd5c\uace0\uc810\uc5d0 \ub3c4\ub2ec\ud588\uc744 \ub54c '\uc2a4\ud398\uc774\uc2a4' \ud0a4\ub97c \ub193\uc73c\uc138\uc694. '\ud558\ub298\ub85c \ud5a5\ud55c \uc810\ud504' \ub808\ubca8\uc5d0\uc11c \uc774 \uae30\uc220\uc744 \uc0ac\uc6a9\ud558\uba74 \ub354 \ub113\uc740 \ud2c8\uc744 \uac74\ub110 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc635\uc158 \ube44\uad50: \uc9e7\uc740 \uc810\ud504=\uac70\ub9ac \uc9e7\uc74c, \ucda9\uc804\ub41c \uc810\ud504=\ucd5c\ub300 \uac70\ub9ac]"}, {"question": "\ud649 \uc6cc\ud504\uc5d0\uc11c \ub354\ube14 \uc810\ud504\ub97c \ub9c8\uc2a4\ud130\ud558\ub294 \ub370 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub354\ube14 \uc810\ud504\ub97c \ub9c8\uc2a4\ud130\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: 1\ub2e8\uacc4: \uc77c\ubc18 \uc810\ud504\ub97c \ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \uacf5\uc911\uc5d0 \uc788\ub294 \ub3d9\uc548 \ubc14\ub85c '\uc2a4\ud398\uc774\uc2a4' \ud0a4\ub97c \ub2e4\uc2dc \ub204\ub985\ub2c8\ub2e4. 3\ub2e8\uacc4: 'WASD' \ud0a4\ub85c \ubc29\ud5a5\uc744 \uc870\uc815\ud558\uc5ec \uc815\ud655\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4. '\uad6c\ub984 \uc655\uad6d' \ub808\ubca8\uc5d0\uc11c\ub294 \ub354\ube14 \uc810\ud504\ub97c \ud1b5\ud574 \ub354 \ub192\uc740 \ud50c\ub7ab\ud3fc\uc5d0 \ub3c4\ub2ec\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud50c\ub7ab\ud3fc \uac8c\uc784\uc758 \ub354\ube14 \uc810\ud504\uc640 \uac19\uc73c\uba70 \ucd94\uac00 \ub192\uc774\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "\uc804\ub7b5\uc801 \uc774\uc810\uc744 \uc704\ud574 \ud649 \uc6cc\ud504\uc5d0\uc11c \uc5b4\ub5a4 \ub2a5\ub825\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \ud574\uc81c\ud574\uc57c \ud558\ub098\uc694?", "answer": "\uc804\ub7b5\uc801 \uc774\uc810\uc744 \uc704\ud574 '\uc5d0\uc5b4 \ub300\uc2dc'\uc640 '\uc911\ub825 \ub4a4\uc9d1\uae30' \ub2a5\ub825\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \ud574\uc81c\ud558\uc138\uc694. '\uc5d0\uc5b4 \ub300\uc2dc'\ub294 \ube60\ub978 \uc218\ud3c9 \uc774\ub3d9\uc744 \uac00\ub2a5\ud558\uac8c \ud558\uace0 '\uc911\ub825 \ub4a4\uc9d1\uae30'\ub294 \uc810\ud504 \ubc29\ud5a5\uc744 \ub4a4\uc9d1\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc5ed \uc138\uacc4' \ub808\ubca8\uc5d0\uc11c\ub294 '\uc911\ub825 \ub4a4\uc9d1\uae30'\uac00 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. [\uc124\uc815 \ub300\uc870\ud45c: \uc5d0\uc5b4 \ub300\uc2dc=\uc218\ud3c9 \uc18d\ub3c4, \uc911\ub825 \ub4a4\uc9d1\uae30=\ubc29\ud5a5 \ub4a4\uc9d1\uae30]"}, {"question": "\ud649 \uc6cc\ud504\uc758 \uc911\ub825 \uba54\ucee4\ub2c8\uc998\uc740 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "\ud649 \uc6cc\ud504\uc758 \uc911\ub825 \uba54\ucee4\ub2c8\uc998\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc810\ud504\ub97c \ub4a4\uc9d1\uc744 \uc218 \uc788\uac8c \ud558\uc5ec \uc774\ub3d9 \ubc29\ud5a5\uc744 \ubc14\uafc0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uae30\ub2a5\uc740 '\uc911\ub825 \ubbf8\ub85c'\uc640 \uac19\uc740 \ub808\ubca8\uc5d0\uc11c \ud2b9\ud788 \uc720\uc6a9\ud569\ub2c8\ub2e4. \uac70\uae30\uc5d0\uc11c\ub294 \ub4a4\uc9d1\ud78c \ud50c\ub7ab\ud3fc\uc744 \uc774\ub3d9\ud574\uc57c \ud558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud32c\ucf00\uc774\ud06c\ub97c \ub4a4\uc9d1\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uae30\uc220\uc744 \uc870\uc815\ud574\uc57c \ud569\ub2c8\ub2e4.]"}, {"question": "\ud649 \uc6cc\ud504\uc5d0\uc11c \uc77c\ubc18 \uc810\ud504\uc640 \ucda9\uc804 \uc810\ud504\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc77c\ubc18 \uc810\ud504\ub294 \ube60\ub974\uace0 \uac70\ub9ac\uac00 \uc9e7\uc740 \ubc18\uba74, \ucda9\uc804 \uc810\ud504\ub294 '\uc2a4\ud398\uc774\uc2a4' \ud0a4\ub97c \ub354 \uae38\uac8c \ub204\ub974\uace0 \ub354 \uae34 \uac70\ub9ac\ub97c \uc774\ub3d9\ud574\uc57c \ud569\ub2c8\ub2e4. '\uae34 \uc810\ud504' \ub808\ubca8\uc5d0\uc11c\ub294 \uad11\ud65c\ud55c \uace8\uc9dc\uae30\ub97c \uac74\ub108\uae30 \uc704\ud574 \ucda9\uc804 \uc810\ud504\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc635\uc158 \ube44\uad50: \uc77c\ubc18 \uc810\ud504=\uac70\ub9ac \uc9e7\uc74c, \ucda9\uc804 \uc810\ud504=\uac70\ub9ac \ud07c]"}, {"question": "PC\uc5d0\uc11c \ubaa8\ubc14\uc77c \uae30\uae30\ub85c \ud649 \uc6cc\ud504 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc608, \uac8c\uc784\uc758 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \ud1b5\ud574 \uacc4\uc815\uc744 \uc5f0\uacb0\ud558\uba74 \ud649 \uc6cc\ud504 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub450 \uae30\uae30 \ubaa8\ub450 \uac19\uc740 \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\uba74 '\ud558\ub298\ub85c \ud5a5\ud55c \uc810\ud504' \ub808\ubca8\uc5d0\uc11c \uc911\ub2e8\ud588\ub358 \ubd80\ubd84\ubd80\ud130 \uacc4\uc18d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: PC\u2192\ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\u2192\ubaa8\ubc14\uc77c]"}, {"question": "\ud649 \uc6cc\ud504\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\ub098\uc694?", "answer": "\ud649 \uc6cc\ud504\uc758 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 '\uc2e0\ube44 \uc815\uc6d0' \ub808\ubca8\uc5d0\uc11c \ud2b9\uc815 \uc810\ud504 \uc21c\uc11c\ub97c \uc218\ud589\ud558\uba74 \uc811\uadfc\ud560 \uc218 \uc788\ub294 '\ube44\ubc00 \uc6cc\ud504 \ubc29'\uc785\ub2c8\ub2e4. \uc774 \ubc29\uc5d0\ub294 \ub3c5\ud2b9\ud55c \uc218\uc9d1\ud488\uacfc \ubc30\uacbd \uc2a4\ud1a0\ub9ac\uac00 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ubbf8\ub85c\uc5d0\uc11c \uc228\uaca8\uc9c4 \ubcf4\ubb3c \uc0c1\uc790\ub97c \ucc3e\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}]
[{"question": "\u5982\u4f55\u8fdb\u884c\u8df3\u8dc3\u5927\u5e08\u7684\u521d\u7ea7\u8df3\u8dc3\uff1f", "answer": "\u8981\u8fdb\u884c\u8df3\u8dc3\u5927\u5e08\u7684\u521d\u7ea7\u8df3\u8dc3\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u6309\u4e0b\u7a7a\u683c\u952e\u5f00\u59cb\u8df3\u8dc3\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528WASD\u952e\u63a7\u5236\u8df3\u8dc3\u65b9\u5411\u3002\u6b65\u9aa43\uff1a\u677e\u5f00\u7a7a\u683c\u952e\u843d\u5730\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u5173\u4e2d\uff0c\u8df3\u8fc7\u4e00\u4e2a\u5c0f\u7a7a\u9699\u6709\u52a9\u4e8e\u4f60\u524d\u8fdb\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u60f3\u8c61\u4e00\u4e0b\u5728\u4eba\u884c\u9053\u4e0a\u8df3\u8fc7\u6c34\u5751\u3002]"}, {"question": "\u8df3\u8dc3\u5927\u5e08\u4e2d\u9700\u8981\u638c\u63e1\u54ea\u4e9b\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8df3\u8dc3\u5927\u5e08\u7684\u57fa\u672c\u63a7\u5236\u5305\u62ec\uff1a\u7a7a\u683c\u952e\u8df3\u8dc3\uff0cWASD\u952e\u79fb\u52a8\uff0cShift\u952e\u51b2\u523a\u4ee5\u53caE\u952e\u4e0e\u7269\u4f53\u4e92\u52a8\u3002\u4f8b\u5982\uff0c\u5728\u6559\u7a0b\u5173\u5361\u4e2d\u4f7f\u7528E\u952e\u6253\u5f00\u95e8\u81f3\u5173\u91cd\u8981\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u7a7a\u683c\u952e=\u8df3\u8dc3\uff0cWASD\u952e=\u79fb\u52a8\uff0cShift\u952e=\u51b2\u523a\uff0cE\u952e=\u4e92\u52a8]"}, {"question": "\u8df3\u8dc3\u5927\u5e08\u7684\u8df3\u8dc3\u673a\u5236\u4e2d\u65f6\u95f4\u63a7\u5236\u4e3a\u4ec0\u4e48\u91cd\u8981\uff1f", "answer": "\u8df3\u8dc3\u5927\u5e08\u7684\u65f6\u95f4\u63a7\u5236\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u51b3\u5b9a\u4e86\u4f60\u8df3\u8dc3\u8de8\u8d8a\u969c\u788d\u548c\u7a7a\u9699\u662f\u5426\u6210\u529f\u3002\u4f8b\u5982\uff0c\u5728\u201c\u72ed\u7a84\u901a\u9053\u201d\u5173\u5361\u4e2d\uff0c\u8df3\u8dc3\u65f6\u673a\u4e0d\u5bf9\u53ef\u80fd\u4f1a\u6389\u5165\u9677\u9631\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u8fd9\u5c31\u50cf\u8df3\u7ef3\uff1b\u65f6\u95f4\u63a7\u5236\u786e\u4fdd\u4f60\u4e0d\u4f1a\u7eca\u5012\u3002]"}, {"question": "\u5982\u4f55\u5728\u8df3\u8dc3\u5927\u5e08\u7684\u9ad8\u7ea7\u5173\u5361\u4e2d\u4f18\u5316\u8df3\u8dc3\u8ddd\u79bb\uff1f", "answer": "\u8981\u4f18\u5316\u8df3\u8dc3\u8ddd\u79bb\uff1a\u6b65\u9aa41\uff1a\u6309\u4f4f\u7a7a\u683c\u952e\u66f4\u957f\u65f6\u95f4\u6765\u84c4\u529b\u8df3\u8dc3\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u51b2\u523a\u952eShift\u6765\u83b7\u5f97\u52a8\u91cf\u3002\u6b65\u9aa43\uff1a\u5728\u8df3\u8dc3\u7684\u6700\u9ad8\u70b9\u91ca\u653e\u7a7a\u683c\u952e\u3002\u5728\u201c\u76f4\u4e0a\u4e91\u9704\u201d\u5173\u5361\u4e2d\uff0c\u6b64\u6280\u5de7\u6709\u52a9\u4e8e\u4f60\u8de8\u8d8a\u66f4\u5bbd\u7684\u7a7a\u9699\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u77ed\u8df3=\u77ed\u8ddd\u79bb\uff0c\u84c4\u529b\u8df3=\u6700\u5927\u8ddd\u79bb]"}, {"question": "\u6211\u80fd\u7528\u54ea\u4e9b\u7b56\u7565\u6765\u638c\u63e1\u8df3\u8dc3\u5927\u5e08\u7684\u53cc\u8df3\uff1f", "answer": "\u638c\u63e1\u53cc\u8df3\u9700\u8981\uff1a\u6b65\u9aa41\uff1a\u6267\u884c\u6807\u51c6\u8df3\u8dc3\u3002\u6b65\u9aa42\uff1a\u5728\u7a7a\u4e2d\u65f6\u7acb\u5373\u518d\u6b21\u6309\u4e0b\u7a7a\u683c\u952e\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528WASD\u952e\u8c03\u6574\u65b9\u5411\u4ee5\u63d0\u9ad8\u51c6\u786e\u6027\u3002\u5728\u201c\u4e91\u4e4b\u56fd\u201d\u5173\u5361\u4e2d\uff0c\u53cc\u8df3\u5bf9\u4e8e\u5230\u8fbe\u66f4\u9ad8\u7684\u5e73\u53f0\u81f3\u5173\u91cd\u8981\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u8fd9\u7c7b\u4f3c\u4e8e\u5e73\u53f0\u6e38\u620f\u4e2d\u7b2c\u4e8c\u6b21\u8df3\u8dc3\uff0c\u53ef\u4ee5\u8ba9\u4f60\u83b7\u5f97\u989d\u5916\u7684\u9ad8\u5ea6\u3002]"}, {"question": "\u4e3a\u4e86\u5728\u8df3\u8dc3\u5927\u5e08\u4e2d\u83b7\u5f97\u6218\u7565\u4f18\u52bf\uff0c\u6211\u5e94\u8be5\u4f18\u5148\u89e3\u9501\u54ea\u4e9b\u80fd\u529b\uff1f", "answer": "\u4f18\u5148\u89e3\u9501\u201c\u7a7a\u4e2d\u51b2\u523a\u201d\u548c\u201c\u91cd\u529b\u7ffb\u8f6c\u201d\u80fd\u529b\u3002\u201c\u7a7a\u4e2d\u51b2\u523a\u201d\u53ef\u4ee5\u5feb\u901f\u8fdb\u884c\u6c34\u5e73\u79fb\u52a8\uff0c\u201c\u91cd\u529b\u7ffb\u8f6c\u201d\u53ef\u4ee5\u8ba9\u4f60\u6539\u53d8\u8df3\u8dc3\u65b9\u5411\u3002\u4f8b\u5982\uff0c\u5728\u201c\u53cd\u91cd\u529b\u4e16\u754c\u201d\u5173\u5361\u4e2d\uff0c\u201c\u91cd\u529b\u7ffb\u8f6c\u201d\u662f\u5fc5\u4e0d\u53ef\u5c11\u7684\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u7a7a\u4e2d\u51b2\u523a=\u6c34\u5e73\u901f\u5ea6\uff0c\u91cd\u529b\u7ffb\u8f6c=\u65b9\u5411\u53cd\u8f6c]"}, {"question": "\u8df3\u8dc3\u5927\u5e08\u4e2d\u7684\u91cd\u529b\u673a\u5236\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u6027\uff1f", "answer": "\u8df3\u8dc3\u5927\u5e08\u4e2d\u7684\u91cd\u529b\u673a\u5236\u5141\u8bb8\u73a9\u5bb6\u7ffb\u8f6c\u8df3\u8dc3\uff0c\u6539\u53d8\u79fb\u52a8\u65b9\u5411\u3002\u8fd9\u5728\u201c\u91cd\u529b\u8ff7\u5bab\u201d\u4e4b\u7c7b\u7684\u5173\u5361\u4e2d\u7279\u522b\u6709\u7528\uff0c\u56e0\u4e3a\u8fd9\u4e9b\u5173\u5361\u9700\u8981\u73a9\u5bb6\u5728\u98a0\u5012\u7684\u5e73\u53f0\u4e0a\u8fdb\u884c\u5bfc\u822a\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u8fd9\u5c31\u50cf\u7ffb\u714e\u997c\uff1b\u4f60\u9700\u8981\u8c03\u6574\u4f60\u7684\u6280\u5de7\u3002]"}, {"question": "\u8df3\u8dc3\u5927\u5e08\u4e2d\u666e\u901a\u8df3\u8dc3\u548c\u84c4\u529b\u8df3\u8dc3\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u666e\u901a\u8df3\u8dc3\u5feb\u901f\uff0c\u8986\u76d6\u7684\u8ddd\u79bb\u77ed\uff0c\u800c\u84c4\u529b\u8df3\u8dc3\u9700\u8981\u66f4\u957f\u65f6\u95f4\u6309\u4f4f\u7a7a\u683c\u952e\uff0c\u8986\u76d6\u7684\u8ddd\u79bb\u66f4\u957f\u3002\u5728\u201c\u957f\u8df3\u201d\u5173\u5361\u4e2d\uff0c\u9700\u8981\u84c4\u529b\u8df3\u8dc3\u624d\u80fd\u8de8\u8d8a\u5de8\u5927\u7684\u6df1\u6e0a\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u666e\u901a\u8df3\u8dc3=\u77ed\u8ddd\u79bb\uff0c\u84c4\u529b\u8df3\u8dc3=\u957f\u8ddd\u79bb]"}, {"question": "\u6211\u53ef\u4ee5\u5728PC\u548c\u79fb\u52a8\u8bbe\u5907\u4e4b\u95f4\u8f6c\u79fb\u8df3\u8dc3\u5927\u5e08\u7684\u8fdb\u5ea6\u5417\uff1f", "answer": "\u662f\u7684\uff0c\u4f60\u53ef\u4ee5\u901a\u8fc7\u8fde\u63a5\u6e38\u620f\u4e91\u5b58\u6863\u529f\u80fd\u6765\u8f6c\u79fb\u4f60\u7684\u8df3\u8dc3\u5927\u5e08\u8fdb\u5ea6\u3002\u786e\u4fdd\u4f60\u5728\u4e24\u4e2a\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u5e10\u6237\u3002\u4f8b\u5982\uff0c\u8f6c\u79fb\u8fdb\u5ea6\u5141\u8bb8\u4f60\u5728\u201c\u76f4\u4e0a\u4e91\u9704\u201d\u5173\u5361\u4e2d\u4ece\u4e2d\u65ad\u7684\u5730\u65b9\u7ee7\u7eed\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1aPC\u2192\u4e91\u5b58\u6863\u2192\u79fb\u52a8\u8bbe\u5907]"}, {"question": "\u8df3\u8dc3\u5927\u5e08\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u5f69\u86cb\uff1f", "answer": "\u8df3\u8dc3\u5927\u5e08\u4e2d\u4e00\u4e2a\u9690\u85cf\u5f69\u86cb\u662f\u201c\u79d8\u5bc6\u4f20\u9001\u5ba4\u201d\uff0c\u53ef\u4ee5\u901a\u8fc7\u5728\u201c\u795e\u79d8\u82b1\u56ed\u201d\u5173\u5361\u4e2d\u6267\u884c\u7279\u5b9a\u987a\u5e8f\u7684\u8df3\u8dc3\u6765\u8bbf\u95ee\u3002\u8fd9\u4e2a\u623f\u95f4\u5305\u542b\u72ec\u7279\u7684\u6536\u96c6\u54c1\u548c\u6545\u4e8b\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u8fd9\u5c31\u50cf\u5728\u4e00\u4e2a\u8ff7\u5bab\u4e2d\u627e\u5230\u4e00\u4e2a\u9690\u85cf\u7684\u5b9d\u7bb1\u3002]"}]
[{"question": "\ucd08\ubcf4\uc790\ub85c\uc11c FNF StarCatcher\uc758 \uc815\ud655\ub3c4\ub97c \ub192\uc774\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "FNF StarCatcher\uc5d0\uc11c \uc815\ud655\ub3c4\ub97c \ub192\uc774\ub824\uba74 \ud0a4 \uc785\ub825 \ud0c0\uc774\ubc0d \uc5f0\uc2b5\ubd80\ud130 \uc2dc\uc791\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \"Stellar Beats\" \ub178\ub798\uc5d0\uc11c \ube44\ud2b8 \ub9c8\ucee4\uc640 \uc77c\uce58\ud558\ub294 \uba54\ud2b8\ub85c\ub188\uc5d0 \ub9de\ucdb0 \ub178\ud2b8\ub97c \uce58\ub294 \uc5f0\uc2b5\uc744 \ud558\uc138\uc694. \ub2e8\uacc41: \uc5f0\uc2b5 \ubaa8\ub4dc\uc5d0\uc11c \ub178\ub798 \uc18d\ub3c4\ub97c \ub2a6\ucd94\uc138\uc694. \ub2e8\uacc42: \uc790\uc2e0\uac10\uc774 \uc0dd\uae30\uba74 \uc810\uc9c4\uc801\uc73c\ub85c \uc18d\ub3c4\ub97c \ub192\uc774\uc138\uc694. \ub2e8\uacc43: \uc2dc\uac01\uc801\uc778 \ub2e8\uc11c\uc5d0 \uc8fc\uc758\ud558\uace0 \ub2e4\uc74c \ub178\ud2b8\ub97c \uc608\uce21\ud558\ub824\uace0 \ub178\ub825\ud558\uc138\uc694. \uc774 \ubc29\ubc95\uc740 \ubc18\ubcf5\uc744 \ud1b5\ud574 \uadfc\uc721 \uae30\uc5b5\ub825\uc744 \ud0a4\uc6b0\ub294 \uc545\uae30\ub97c \ubc30\uc6b0\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4."}, {"question": "FNF StarCatcher\uc5d0\uc11c \uace0\ub09c\ub3c4 \ub178\ub798\ub97c \uc644\ub8cc\ud558\uae30 \uc704\ud55c \ucd5c\uc0c1\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "FNF StarCatcher\uc5d0\uc11c \uace0\ub09c\ub3c4 \ub178\ub798\ub97c \uc644\ub8cc\ud558\ub824\uba74 \uc5f0\uc2b5\uacfc \uc804\ub7b5\uc758 \uc870\ud569\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"Galactic Rush\" \ub178\ub798\uc5d0\uc11c \ub178\ud2b8\uac00 \ube60\ub974\uac8c \uc774\uc5b4\uc9d1\ub2c8\ub2e4. \ub2e8\uacc41: \ub0ae\uc740 \ub09c\uc774\ub3c4\uc5d0\uc11c \ub178\ub798\ub97c \uba3c\uc800 \ub9c8\uc2a4\ud130\ud558\uc138\uc694. \ub2e8\uacc42: \uc790\uc2e0\uc774 \uc5b4\ub824\uc6c0\uc744 \uacaa\ub294 \ubd80\ubd84\uc5d0 \uc9d1\uc911\ud558\uc5ec \uacc4\uc18d \ub178\ud2b8\ub97c \ub9de\ucd9c \ub54c\uae4c\uc9c0 \ubc18\ubcf5\ud558\uc138\uc694. \ub2e8\uacc43: \ub178\ub798\uac00 \ub05d\ub0a0 \ub54c\uae4c\uc9c0 \uae30\ub2e4\ub9ac\uc9c0 \uc54a\uace0 \ub09c\uc774\ub3c4\uac00 \ub192\uc740 \ubd80\ubd84\uc744 \ube60\ub974\uac8c \ub2e4\uc2dc \uc2dc\ub3c4\ud558\ub824\uba74 \"\ub2e4\uc2dc \uc2dc\uc791\" \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. \uc774 \uc811\uadfc \ubc29\uc2dd\uc740 \uac00\uc7a5 \uc5b4\ub824\uc6b4 \uc870\uac01\ubd80\ud130 \ub2e4\ub8e8\ub294 \ud37c\uc990\uacfc \uc720\uc0ac\ud569\ub2c8\ub2e4."}, {"question": "FNF StarCatcher\uc5d0\ub294 \uc65c \uac01 \ub178\ub798\ub9c8\ub2e4 \ub2e4\ub978 \ub178\ud2b8 \ud328\ud134\uc774 \uc788\uc2b5\ub2c8\uae4c?", "answer": "FNF StarCatcher\ub294 \uac8c\uc784 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uace0 \ub178\ub798\uc758 \ub9ac\ub4ec\uacfc \uc2a4\ud0c0\uc77c\uc744 \ubc18\uc601\ud558\uae30 \uc704\ud574 \uac01 \ub178\ub798\ub9c8\ub2e4 \ub2e4\ub978 \ub178\ud2b8 \ud328\ud134\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"Cosmic Waves\" \ub178\ub798\uc5d0\uc11c \ub178\ud2b8 \ud328\ud134\uc740 \ud574\uc591 \ud30c\ub3c4\uc758 \ud750\ub984\uc744 \ubaa8\ubc29\ud558\uc5ec \ub354\uc6b1 \ubab0\uc785\uac10 \uc788\ub294 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc774 \ub514\uc790\uc778 \uc120\ud0dd\uc740 \uac01 \ub178\ub798\uac00 \ub3c5\ud2b9\ud558\uace0 \ub9e4\ub825\uc801\uc73c\ub85c \ub290\uaef4\uc9c0\ub3c4\ub85d \uc74c\uc545\uc5d0 \ub9de\ucdb0 \uc548\ubb34\uac00\uac00 \ucda4 \ub3d9\uc791\uc744 \ub9de\ucd94\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4."}, {"question": "FNF StarCatcher\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "FNF StarCatcher\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ub178\ud2b8\ub97c \uc5bc\ub9c8\ub098 \uc815\ud655\ud558\uac8c \ub9de\ucd94\ub290\ub0d0\uc5d0 \ub530\ub77c \uacb0\uc815\ub429\ub2c8\ub2e4. \uac01 \ub178\ud2b8\uc5d0\ub294 \"\uc644\ubcbd\", \"\uc88b\uc74c\", \"\uc2e4\ud328\" \ub4f1\uae09\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"Starlight Symphony\" \ub178\ub798\uc5d0\uc11c \"\uc644\ubcbd\" \ub178\ud2b8\ub97c \ub9de\ucd94\uba74 100\uc810, \"\uc88b\uc74c\" \ub178\ud2b8\ub97c \ub9de\ucd94\uba74 50\uc810, \"\uc2e4\ud328\" \ub178\ud2b8\ub97c \ub9de\ucd94\uba74 0\uc810\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \ub610\ud55c \uc5f0\uc18d\uc801\uc778 \"\uc644\ubcbd\" \ud788\ud2b8\ub294 \ucf64\ubcf4 \ubc30\uc218\ub97c \uad6c\ucd95\ud558\uc5ec \uc810\uc218\ub97c \uae30\ud558\uae09\uc218\uc801\uc73c\ub85c \ub192\uc785\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \uafb8\uc900\ud55c \uc131\ub2a5\uc774 \ub354 \ub192\uc740 \ubcf4\uc0c1\uc73c\ub85c \uc774\uc5b4\uc9c0\ub294 \uc2a4\ud3ec\uce20\uc5d0\uc11c\uc758 \ubcf4\uc0c1 \uba54\ucee4\ub2c8\uc998\uacfc \uac19\uc2b5\ub2c8\ub2e4."}, {"question": "FNF StarCatcher\uc640 \ub2e4\ub978 \ub9ac\ub4ec \uac8c\uc784\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "FNF StarCatcher\ub294 \uace0\uc720\ud55c \ub178\ud2b8 \ud328\ud134\uacfc \uc8fc\uc81c \ud1b5\ud569\uc73c\ub85c \uc778\ud574 \ub2e4\ub978 \ub9ac\ub4ec \uac8c\uc784\uacfc \ucc28\ubcc4\ud654\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"Astral Ascension\" \ub178\ub798\uc5d0\uc11c \ub178\ud2b8 \ud328\ud134\uc740 \uc6b0\uc8fc\uc120\uc758 \uc0c1\uc2b9\uc744 \ubaa8\ubc29\ud558\uc5ec \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc774\uc57c\uae30 \uce35\uc744 \ucd94\uac00\ud569\ub2c8\ub2e4. \ub610\ud55c FNF StarCatcher\ub294 \ub2e4\uc591\ud55c \ub09c\uc774\ub3c4 \uc218\uc900\uacfc \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc81c\uacf5\ud558\uc5ec \ubaa8\ub4e0 \uae30\uc220 \uc218\uc900\uc758 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc811\uadfc\uc131\uc744 \ub192\uc785\ub2c8\ub2e4. \uc774\ub294 \ud765\ubd84\uacfc \uae4a\uc774\ub97c \ubaa8\ub450 \uc81c\uacf5\ud558\ub294 \ud765\ubbf8\uc9c4\uc9c4\ud55c \uc774\uc57c\uae30\ub97c \uacb0\ud569\ud55c \uc601\ud654\uc640 \uac19\uc2b5\ub2c8\ub2e4."}, {"question": "\uc0c8 \uae30\uae30\ub85c FNF StarCatcher \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc0c8 \uae30\uae30\ub85c FNF StarCatcher \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub824\uba74 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc41: \ud604\uc7ac \uae30\uae30\uac00 \uc778\ud130\ub137\uc5d0 \uc5f0\uacb0\ub418\uc5b4 \uc788\uace0 \uac8c\uc784 \uc124\uc815\uc5d0\uc11c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ud65c\uc131\ud654\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \ub2e8\uacc42: \uc0c8\ub85c\uc6b4 \uae30\uae30\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uace0 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ud65c\uc131\ud654\ud558\uc138\uc694. \ub2e8\uacc43: \ud074\ub77c\uc6b0\ub4dc\uc5d0\uc11c \uc800\uc7a5\ub41c \uc9c4\ud589 \uc0c1\ud669\uc744 \ub85c\ub4dc\ud558\uc2ed\uc2dc\uc624. \uc774 \uacfc\uc815\uc740 \ud074\ub77c\uc6b0\ub4dc \uc2a4\ud1a0\ub9ac\uc9c0 \uc11c\ube44\uc2a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud30c\uc77c\uc744 \ud55c \ucef4\ud4e8\ud130\uc5d0\uc11c \ub2e4\ub978 \ucef4\ud4e8\ud130\ub85c \uc774\ub3d9\ud558\ub294 \uac83\uacfc \uac19\uc73c\uba70 \ub370\uc774\ud130\uac00 \uc190\uc0c1\ub418\uc9c0 \uc54a\ub3c4\ub85d \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "FNF StarCatcher\uc758 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "FNF StarCatcher\uc5d0\ub294 \uac8c\uc784\uc758 \ub9e4\ub825\uc744 \ub354\ud558\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"Celestial Dance\" \ub178\ub798\uc5d0\uc11c \ubaa8\ub4e0 \ub178\ud2b8\ub97c \uc644\ubcbd\ud558\uac8c \ub9de\ucd94\uba74 \ucda4\ucd94\ub294 \ubcc4\uc758 \ud2b9\ubcc4\ud55c \uc560\ub2c8\uba54\uc774\uc158\uc774 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \ub610\ud55c \uac8c\uc784\uc758 \uba54\uc778 \uba54\ub274\uc5d0\uc11c \ube44\ubc00 \ucf54\ub4dc\ub97c \uc785\ub825\ud558\uba74 \uc228\uaca8\uc9c4 \uce90\ub9ad\ud130\ub97c \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ube44\ub514\uc624 \uac8c\uc784\uc5d0\uc11c \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uacfc \uac19\uc73c\uba70, \ud50c\ub808\uc774\uc5b4\uc758 \ud638\uae30\uc2ec\uacfc \uae30\uc220\uc744 \ubcf4\uc0c1\ud569\ub2c8\ub2e4."}, {"question": "FNF StarCatcher\uc758 \ub09c\uc774\ub3c4 \uc870\uc815\uc740 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "FNF StarCatcher\uc758 \ub09c\uc774\ub3c4 \uc870\uc815\uc740 \ub178\ud2b8 \ud328\ud134\uc758 \uc18d\ub3c4\uc640 \ubcf5\uc7a1\uc131\uc744 \uc870\uc815\ud558\uc5ec \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \ud070 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"Nebula Night\" \ub178\ub798\uc5d0\uc11c \"\uc26c\uc6c0\" \ubaa8\ub4dc\ub294 \uc18d\ub3c4\uac00 \ub290\ub9ac\uace0 \ud328\ud134\uc774 \uac04\ub2e8\ud558\uba70, \"\uc5b4\ub824\uc6c0\" \ubaa8\ub4dc\ub294 \uc18d\ub3c4\uac00 \ube60\ub974\uace0 \ud328\ud134\uc774 \ubcf5\uc7a1\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc870\uc815\uc740 \uafb8\uc900\ud788 \uac15\ub3c4\ub97c \ub192\uc774\ub294 \uc6b4\ub3d9 \ud504\ub85c\uadf8\ub7a8\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\uac00 \uc2dc\uac04\uc774 \uc9c0\ub0a8\uc5d0 \ub530\ub77c \uae30\uc220\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub3c4\ub85d \ub3c4\uc640\uc90d\ub2c8\ub2e4."}, {"question": "\ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c FNF StarCatcher\ub97c \uc2e4\ud589\ud558\uae30 \uc704\ud55c \uae30\uc220\uc801 \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "FNF StarCatcher\ub97c \uc2e4\ud589\ud558\uae30 \uc704\ud55c \uae30\uc220\uc801 \uc694\uad6c \uc0ac\ud56d\uc740 \ud50c\ub7ab\ud3fc\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c\ub294 \uac8c\uc784\uc774 \uc801\uc5b4\ub3c4 2GB\uc758 RAM\uacfc DirectX 11 \ud638\ud658 \uadf8\ub798\ud53d \uce74\ub4dc\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ubaa8\ubc14\uc77c \uae30\uae30\uc5d0\uc11c\ub294 iOS 10 \uc774\uc0c1 \ub610\ub294 Android 7.0 \uc774\uc0c1\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc694\uad6c \uc0ac\ud56d\uc740 \ub2e4\uc591\ud55c \uc7a5\uce58\uc5d0\uc11c \uc6d0\ud65c\ud55c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ubcf4\uc7a5\ud558\ub294 \uace0\ud488\uc9c8 \ube44\ub514\uc624\ub97c \uc2e4\ud589\ud558\ub294 \ub370 \ud544\uc694\ud55c \uc0ac\uc591\uacfc \uac19\uc2b5\ub2c8\ub2e4."}, {"question": "FNF StarCatcher\ub97c \uc704\ud55c \uc7a5\uce58 \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "FNF StarCatcher\ub97c \uc704\ud55c \uc7a5\uce58 \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uba87 \uac00\uc9c0 \ub2e8\uacc4\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc41: \ubc31\uadf8\ub77c\uc6b4\ub4dc \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc744 \uc885\ub8cc\ud558\uc5ec \uc2dc\uc2a4\ud15c \ub9ac\uc18c\uc2a4\ub97c \ud655\ubcf4\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc42: \ub799\uc774 \ubc1c\uc0dd\ud558\uba74 \uac8c\uc784\uc758 \uadf8\ub798\ud53d \uc124\uc815\uc744 \ub0ae\ucd94\uc2ed\uc2dc\uc624. \ub2e8\uacc43: \uc7a5\uce58\uc758 \uc6b4\uc601 \uccb4\uc81c \ubc0f \ub4dc\ub77c\uc774\ubc84\uac00 \ucd5c\uc2e0 \ubc84\uc804\uc778\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uc774 \uacfc\uc815\uc740 \ub808\uc774\uc2f1\uc5d0 \ud544\uc694\ud55c \uc790\ub3d9\ucc28\ub97c \uc870\uc815\ud558\ub294 \uac83\uacfc \uac19\uc73c\uba70, \uac01 \uc870\uc815\uc774 \ub354 \ub098\uc740 \uc131\ub2a5\uc5d0 \uae30\uc5ec\ud569\ub2c8\ub2e4."}]
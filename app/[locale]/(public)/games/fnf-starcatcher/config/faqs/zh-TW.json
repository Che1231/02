[{"question": "\u5982\u4f55\u63d0\u5347\u6211\u5728FNF StarCatcher\u65b0\u624b\u6a21\u5f0f\u4e0b\u7684\u6e96\u78ba\u5ea6\uff1f", "answer": "\u8981\u63d0\u5347\u5728FNF StarCatcher\u4e2d\u7684\u6e96\u78ba\u5ea6\uff0c\u9996\u5148\u8981\u7df4\u7fd2\u6309\u9375\u7684\u6642\u6a5f\u3002\u4f8b\u5982\uff0c\u5728\u6b4c\u66f2\u300e\u661f\u5149\u7bc0\u62cd\u300f\u4e2d\uff0c\u5c08\u6ce8\u65bc\u5728\u7bc0\u62cd\u6a19\u8a18\u8207\u97f3\u7b26\u5c0d\u9f4a\u6642\u64ca\u6253\u97f3\u7b26\u3002\u6b65\u9a5f\u4e00\uff1a\u4f7f\u7528\u7df4\u7fd2\u6a21\u5f0f\u964d\u4f4e\u6b4c\u66f2\u901f\u5ea6\u3002\u6b65\u9a5f\u4e8c\uff1a\u5728\u719f\u6089\u5f8c\u9010\u6f38\u63d0\u9ad8\u901f\u5ea6\u3002\u6b65\u9a5f\u4e09\uff1a\u6ce8\u610f\u8996\u89ba\u63d0\u793a\uff0c\u5617\u8a66\u9810\u6e2c\u4e0b\u4e00\u500b\u97f3\u7b26\u3002\u9019\u500b\u65b9\u6cd5\u5c31\u50cf\u5b78\u7fd2\u6f14\u594f\u6a02\u5668\u4e00\u6a23\uff0c\u53cd\u8986\u7df4\u7fd2\u53ef\u4ee5\u5efa\u7acb\u808c\u8089\u8a18\u61b6\u3002"}, {"question": "\u5728FNF StarCatcher\u4e2d\u5b8c\u6210\u9ad8\u96e3\u5ea6\u6b4c\u66f2\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728FNF StarCatcher\u4e2d\u5b8c\u6210\u9ad8\u96e3\u5ea6\u6b4c\u66f2\u9700\u8981\u7d50\u5408\u7df4\u7fd2\u548c\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u5728\u6b4c\u66f2\u300e\u9280\u6cb3\u885d\u523a\u300f\u4e2d\uff0c\u97f3\u7b26\u63a5\u9023\u4e0d\u65b7\u5730\u51fa\u73fe\u3002\u6b65\u9a5f\u4e00\uff1a\u5148\u638c\u63e1\u6b4c\u66f2\u8f03\u4f4e\u7684\u96e3\u5ea6\u3002\u6b65\u9a5f\u4e8c\uff1a\u5c08\u6ce8\u65bc\u4f60\u611f\u5230\u56f0\u96e3\u7684\u90e8\u5206\uff0c\u53cd\u8986\u7df4\u7fd2\u76f4\u5230\u4f60\u80fd\u6301\u7e8c\u64ca\u4e2d\u97f3\u7b26\u3002\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u300e\u91cd\u65b0\u958b\u59cb\u300f\u529f\u80fd\u5feb\u901f\u91cd\u8a66\u56f0\u96e3\u90e8\u5206\uff0c\u800c\u7121\u9700\u7b49\u5f85\u6b4c\u66f2\u7d50\u675f\u3002\u9019\u7a2e\u65b9\u6cd5\u5c31\u50cf\u89e3\u6c7a\u62fc\u5716\u4e00\u6a23\uff0c\u5148\u8655\u7406\u6700\u96e3\u7684\u90e8\u5206\u3002"}, {"question": "\u70ba\u4ec0\u9ebcFNF StarCatcher\u7684\u6bcf\u500b\u6b4c\u66f2\u7684\u97f3\u7b26\u6a21\u5f0f\u90fd\u4e0d\u540c\uff1f", "answer": "FNF StarCatcher\u70ba\u6bcf\u9996\u6b4c\u63d0\u4f9b\u4e0d\u540c\u7684\u97f3\u7b26\u6a21\u5f0f\uff0c\u4ee5\u589e\u5f37\u904a\u6232\u9ad4\u9a57\uff0c\u4e26\u53cd\u6620\u6b4c\u66f2\u7684\u7bc0\u594f\u548c\u98a8\u683c\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5b87\u5b99\u6ce2\u703e\u300f\u4e2d\uff0c\u97f3\u7b26\u6a21\u5f0f\u6a21\u4eff\u4e86\u6d77\u6d6a\u7684\u8d77\u4f0f\uff0c\u71df\u9020\u51fa\u66f4\u8eab\u81e8\u5176\u5883\u7684\u9ad4\u9a57\u3002\u9019\u500b\u8a2d\u8a08\u9078\u64c7\u5c31\u50cf\u7de8\u821e\u5bb6\u6839\u64da\u97f3\u6a02\u91cf\u8eab\u6253\u9020\u821e\u6b65\uff0c\u78ba\u4fdd\u6bcf\u9996\u6b4c\u90fd\u7368\u7279\u4e14\u5f15\u4eba\u5165\u52dd\u3002"}, {"question": "FNF StarCatcher\u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "FNF StarCatcher\u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u4f60\u7684\u97f3\u7b26\u64ca\u6253\u6e96\u78ba\u6027\u3002\u6bcf\u500b\u97f3\u7b26\u90fd\u6709\u300e\u5b8c\u7f8e\u300f\u3001\u300e\u826f\u597d\u300f\u548c\u300e\u672a\u64ca\u4e2d\u300f\u7684\u8a55\u7d1a\u3002\u4f8b\u5982\uff0c\u5728\u300e\u661f\u5149\u4ea4\u97ff\u66f2\u300f\u4e2d\uff0c\u64ca\u4e2d\u300e\u5b8c\u7f8e\u300f\u97f3\u7b26\u53ef\u7372\u5f97100\u5206\uff0c\u64ca\u4e2d\u300e\u826f\u597d\u300f\u97f3\u7b26\u53ef\u7372\u5f9750\u5206\uff0c\u64ca\u4e2d\u300e\u672a\u64ca\u4e2d\u300f\u97f3\u7b26\u5247\u7372\u5f970\u5206\u3002\u6b64\u5916\uff0c\u9023\u7e8c\u64ca\u4e2d\u300e\u5b8c\u7f8e\u300f\u97f3\u7b26\u6703\u7d2f\u7a4d\u9023\u64ca\u500d\u6578\uff0c\u6307\u6578\u7d1a\u63d0\u9ad8\u4f60\u7684\u5f97\u5206\u3002\u9019\u500b\u7cfb\u7d71\u5c31\u50cf\u904b\u52d5\u8cfd\u4e8b\u7684\u734e\u52f5\u6a5f\u5236\uff0c\u7a69\u5b9a\u7684\u8868\u73fe\u6703\u5e36\u4f86\u66f4\u9ad8\u7684\u734e\u52f5\u3002"}, {"question": "FNF StarCatcher\u548c\u5176\u4ed6\u7bc0\u594f\u904a\u6232\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "FNF StarCatcher\u6191\u85c9\u5176\u7368\u7279\u7684\u97f3\u7b26\u6a21\u5f0f\u548c\u4e3b\u984c\u6574\u5408\u812b\u7a4e\u800c\u51fa\u3002\u4f8b\u5982\uff0c\u5728\u300e\u661f\u5875\u6607\u83ef\u300f\u4e2d\uff0c\u97f3\u7b26\u6a21\u5f0f\u8a2d\u8a08\u70ba\u6a21\u4eff\u592a\u7a7a\u8239\u7684\u4e0a\u5347\uff0c\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u6558\u4e8b\u5c64\u9762\u3002\u6b64\u5916\uff0cFNF StarCatcher\u63d0\u4f9b\u4e86\u5404\u7a2e\u96e3\u5ea6\u7d1a\u5225\u548c\u7df4\u7fd2\u6a21\u5f0f\uff0c\u4f7f\u5176\u9069\u5408\u6240\u6709\u6280\u80fd\u6c34\u5e73\u7684\u73a9\u5bb6\u3002\u9019\u5c31\u50cf\u4e00\u90e8\u7d50\u5408\u52d5\u4f5c\u548c\u5f15\u4eba\u5165\u52dd\u6545\u4e8b\u60c5\u7bc0\u7684\u96fb\u5f71\uff0c\u65e2\u523a\u6fc0\u53c8\u6df1\u523b\u3002"}, {"question": "\u5982\u4f55\u5c07\u6211\u7684FNF StarCatcher\u9032\u5ea6\u8f49\u79fb\u5230\u65b0\u7684\u88dd\u7f6e\uff1f", "answer": "\u5c07\u4f60\u7684FNF StarCatcher\u9032\u5ea6\u8f49\u79fb\u5230\u65b0\u7684\u88dd\u7f6e\u9700\u8981\u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u3002\u6b65\u9a5f\u4e00\uff1a\u78ba\u4fdd\u4f60\u7684\u73fe\u6709\u88dd\u7f6e\u9023\u63a5\u5230\u4e92\u806f\u7db2\uff0c\u4e26\u4e14\u904a\u6232\u8a2d\u5b9a\u4e2d\u555f\u7528\u4e86\u96f2\u7aef\u5132\u5b58\u3002\u6b65\u9a5f\u4e8c\uff1a\u5728\u65b0\u88dd\u7f6e\u4e0a\u767b\u5165\u76f8\u540c\u7684\u5e33\u6236\u4e26\u555f\u7528\u96f2\u7aef\u5132\u5b58\u3002\u6b65\u9a5f\u4e09\uff1a\u5f9e\u96f2\u7aef\u8f09\u5165\u4f60\u7684\u5132\u5b58\u9032\u5ea6\u3002\u9019\u500b\u904e\u7a0b\u5c31\u50cf\u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u670d\u52d9\u5c07\u4f60\u7684\u6a94\u6848\u5f9e\u4e00\u53f0\u96fb\u8166\u79fb\u52d5\u5230\u53e6\u4e00\u53f0\u96fb\u8166\uff0c\u78ba\u4fdd\u4f60\u7684\u8cc7\u6599\u4fdd\u6301\u5b8c\u6574\u3002"}, {"question": "FNF StarCatcher\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\uff1f", "answer": "FNF StarCatcher\u5305\u542b\u4e00\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\uff0c\u589e\u52a0\u4e86\u904a\u6232\u7684\u9b45\u529b\u3002\u4f8b\u5982\uff0c\u5728\u6b4c\u66f2\u300e\u661f\u969b\u4e4b\u821e\u300f\u4e2d\uff0c\u5982\u679c\u4f60\u5b8c\u7f8e\u64ca\u4e2d\u6240\u6709\u97f3\u7b26\uff0c\u5c31\u6703\u51fa\u73fe\u4e00\u500b\u8df3\u821e\u661f\u661f\u7684\u7279\u6b8a\u52d5\u756b\u3002\u6b64\u5916\uff0c\u5728\u904a\u6232\u4e3b\u9078\u55ae\u4e2d\uff0c\u4e00\u500b\u79d8\u5bc6\u4ee3\u78bc\u53ef\u4ee5\u89e3\u9396\u96b1\u85cf\u89d2\u8272\u3002\u9019\u4e9b\u5f69\u86cb\u5c31\u50cf\u904a\u6232\u4e2d\u7684\u96b1\u85cf\u5bf6\u85cf\uff0c\u734e\u52f5\u73a9\u5bb6\u7684\u597d\u5947\u5fc3\u548c\u6280\u5de7\u3002"}, {"question": "FNF StarCatcher\u7684\u96e3\u5ea6\u8abf\u6574\u5982\u4f55\u5f71\u97ff\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "FNF StarCatcher\u7684\u96e3\u5ea6\u8abf\u6574\u6703\u986f\u8457\u5f71\u97ff\u904a\u6232\u9ad4\u9a57\uff0c\u8abf\u6574\u97f3\u7b26\u6a21\u5f0f\u7684\u901f\u5ea6\u548c\u8907\u96dc\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u300e\u661f\u96f2\u4e4b\u591c\u300f\u4e2d\uff0c\u300e\u7c21\u55ae\u300f\u6a21\u5f0f\u7684\u97f3\u7b26\u901f\u5ea6\u8f03\u6162\u4e14\u6a21\u5f0f\u8f03\u7c21\u55ae\uff0c\u800c\u300e\u56f0\u96e3\u300f\u6a21\u5f0f\u5247\u5f15\u5165\u4e86\u66f4\u5feb\u7684\u901f\u5ea6\u548c\u66f4\u8907\u96dc\u7684\u6a21\u5f0f\u3002\u9019\u7a2e\u8abf\u6574\u5c31\u50cf\u5faa\u5e8f\u6f38\u9032\u7684\u8a13\u7df4\u8a08\u756b\uff0c\u9010\u6f38\u589e\u52a0\u5f37\u5ea6\uff0c\u6311\u6230\u73a9\u5bb6\u96a8\u8457\u6642\u9593\u63a8\u79fb\u63d0\u5347\u6280\u80fd\u3002"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u904b\u884cFNF StarCatcher\u7684\u6280\u8853\u8981\u6c42\u662f\u4ec0\u9ebc\uff1f", "answer": "\u904b\u884cFNF StarCatcher\u7684\u6280\u8853\u8981\u6c42\u56e0\u5e73\u53f0\u800c\u7570\u3002\u4f8b\u5982\uff0c\u5728PC\u4e0a\uff0c\u904a\u6232\u81f3\u5c11\u9700\u89812GB\u8a18\u61b6\u9ad4\u548c\u652f\u63f4DirectX 11\u7684\u986f\u5361\u3002\u5728\u884c\u52d5\u88dd\u7f6e\u4e0a\uff0c\u5b83\u9700\u8981iOS 10\u6216Android 7.0\u53ca\u4ee5\u4e0a\u7248\u672c\u3002\u9019\u4e9b\u9700\u6c42\u985e\u4f3c\u65bc\u904b\u884c\u9ad8\u54c1\u8cea\u5f71\u7247\u6240\u9700\u7684\u898f\u683c\uff0c\u78ba\u4fdd\u5728\u4e0d\u540c\u88dd\u7f6e\u4e0a\u90fd\u80fd\u9806\u66a2\u5730\u9032\u884c\u904a\u6232\u3002"}, {"question": "\u5982\u4f55\u512a\u5316\u6211\u7684\u88dd\u7f6e\u6027\u80fd\u4ee5\u57f7\u884cFNF StarCatcher\uff1f", "answer": "\u512a\u5316\u4f60\u7684\u88dd\u7f6e\u6027\u80fd\u4ee5\u57f7\u884cFNF StarCatcher\u9700\u8981\u5e7e\u500b\u6b65\u9a5f\u3002\u6b65\u9a5f\u4e00\uff1a\u95dc\u9589\u80cc\u666f\u61c9\u7528\u7a0b\u5f0f\u4ee5\u91cb\u653e\u7cfb\u7d71\u8cc7\u6e90\u3002\u6b65\u9a5f\u4e8c\uff1a\u5982\u679c\u9047\u5230\u5ef6\u9072\uff0c\u8acb\u964d\u4f4e\u904a\u6232\u7684\u5716\u5f62\u8a2d\u5b9a\u3002\u6b65\u9a5f\u4e09\uff1a\u78ba\u4fdd\u4f60\u7684\u88dd\u7f6e\u4f5c\u696d\u7cfb\u7d71\u548c\u9a45\u52d5\u7a0b\u5f0f\u5df2\u66f4\u65b0\u3002\u9019\u500b\u904e\u7a0b\u5c31\u50cf\u70ba\u8cfd\u8eca\u8abf\u6821\u5f15\u64ce\uff0c\u6bcf\u500b\u8abf\u6574\u90fd\u80fd\u63d0\u5347\u6548\u80fd\u3002"}]
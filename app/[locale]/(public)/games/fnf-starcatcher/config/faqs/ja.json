[{"question": "\u521d\u5fc3\u8005\u306e\u79c1\u304cFNF StarCatcher\u3067\u6b63\u78ba\u6027\u3092\u9ad8\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "FNF StarCatcher\u3067\u6b63\u78ba\u6027\u3092\u9ad8\u3081\u308b\u306b\u306f\u3001\u307e\u305a\u30ad\u30fc\u3092\u62bc\u3059\u30bf\u30a4\u30df\u30f3\u30b0\u306e\u7df4\u7fd2\u304b\u3089\u59cb\u3081\u307e\u3057\u3087\u3046\u3002\u300cStellar Beats\u300d\u306a\u3069\u306e\u66f2\u3067\u306f\u3001\u30d3\u30fc\u30c8\u30de\u30fc\u30ab\u30fc\u3068\u4e00\u81f4\u3059\u308b\u3088\u3046\u306b\u30ce\u30fc\u30c8\u3092\u30d2\u30c3\u30c8\u3059\u308b\u4e8b\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u7df4\u7fd2\u30e2\u30fc\u30c9\u3092\u4f7f\u3063\u3066\u3001\u697d\u66f2\u306e\u30c6\u30f3\u30dd\u3092\u9045\u304f\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6163\u308c\u3066\u304d\u305f\u3089\u3001\u30c6\u30f3\u30dd\u3092\u5f90\u3005\u306b\u4e0a\u3052\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u8996\u899a\u7684\u306a\u624b\u304c\u304b\u308a\u306b\u6ce8\u610f\u3057\u3001\u6b21\u306e\u30ce\u30fc\u30c8\u3092\u4e88\u6e2c\u3059\u308b\u7df4\u7fd2\u3092\u3057\u307e\u3059\u3002\u3053\u306e\u65b9\u6cd5\u306f\u3001\u53cd\u5fa9\u7df4\u7fd2\u3092\u901a\u3058\u3066\u7b4b\u8089\u8a18\u61b6\u3092\u69cb\u7bc9\u3059\u308b\u3001\u697d\u5668\u6f14\u594f\u306e\u5b66\u7fd2\u3068\u4f3c\u3066\u3044\u307e\u3059\u3002"}, {"question": "FNF StarCatcher\u3067\u9ad8\u96e3\u6613\u5ea6\u66f2\u3092\u30af\u30ea\u30a2\u3059\u308b\u305f\u3081\u306e\u6700\u9069\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "FNF StarCatcher\u3067\u9ad8\u96e3\u6613\u5ea6\u66f2\u3092\u30af\u30ea\u30a2\u3059\u308b\u306b\u306f\u3001\u7df4\u7fd2\u3068\u6226\u7565\u306e\u4e21\u65b9\u304c\u5fc5\u8981\u3067\u3059\u3002\u300cGalactic Rush\u300d\u306a\u3069\u306e\u66f2\u3067\u306f\u3001\u30ce\u30fc\u30c8\u304c\u6025\u901f\u306b\u9023\u7d9a\u3057\u3066\u51fa\u73fe\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u307e\u305a\u3001\u4f4e\u3044\u96e3\u6613\u5ea6\u3067\u66f2\u3092\u30de\u30b9\u30bf\u30fc\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u82e6\u624b\u306a\u7b87\u6240\u3092\u91cd\u70b9\u7684\u306b\u7e70\u308a\u8fd4\u3057\u7df4\u7fd2\u3057\u3001\u78ba\u5b9f\u306b\u30ce\u30fc\u30c8\u3092\u30d2\u30c3\u30c8\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308b\u307e\u3067\u7df4\u7fd2\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u66f2\u3092\u4e2d\u65ad\u305b\u305a\u306b\u6311\u6226\u7684\u306a\u90e8\u5206\u3092\u7d20\u65e9\u304f\u3084\u308a\u76f4\u3059\u305f\u3081\u306b\u3001\u300c\u30ea\u30b9\u30bf\u30fc\u30c8\u300d\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u306e\u3068\u540c\u69d8\u306b\u3001\u6700\u3082\u96e3\u3057\u3044\u90e8\u5206\u3092\u6700\u521d\u306b\u653b\u7565\u3059\u308b\u3084\u308a\u65b9\u3067\u3059\u3002"}, {"question": "\u306a\u305cFNF StarCatcher\u306f\u3001\u5404\u66f2\u3067\u7570\u306a\u308b\u30ce\u30fc\u30c8\u30d1\u30bf\u30fc\u30f3\u3092\u6301\u3063\u3066\u3044\u308b\u306e\u3067\u3059\u304b\uff1f", "answer": "FNF StarCatcher\u306f\u3001\u5404\u66f2\u3067\u7570\u306a\u308b\u30ce\u30fc\u30c8\u30d1\u30bf\u30fc\u30f3\u3092\u63a1\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4f53\u9a13\u3092\u5411\u4e0a\u3055\u305b\u3001\u697d\u66f2\u306e\u30ea\u30ba\u30e0\u3084\u30b9\u30bf\u30a4\u30eb\u3092\u53cd\u6620\u3057\u3066\u3044\u307e\u3059\u3002\u300cCosmic Waves\u300d\u3067\u306f\u3001\u30ce\u30fc\u30c8\u30d1\u30bf\u30fc\u30f3\u304c\u6ce2\u306e\u5897\u6e1b\u3092\u6a21\u5023\u3057\u3001\u3088\u308a\u6ca1\u5165\u611f\u306e\u3042\u308b\u4f53\u9a13\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u632f\u4ed8\u5e2b\u304c\u97f3\u697d\u306b\u5408\u308f\u305b\u3066\u30c0\u30f3\u30b9\u306e\u52d5\u304d\u3092\u8abf\u6574\u3059\u308b\u306e\u3068\u4f3c\u3066\u304a\u308a\u3001\u5404\u66f2\u304c\u72ec\u7279\u3067\u9b45\u529b\u7684\u306b\u611f\u3058\u3089\u308c\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002"}, {"question": "FNF StarCatcher\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "FNF StarCatcher\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30ce\u30fc\u30c8\u30d2\u30c3\u30c8\u306e\u6b63\u78ba\u3055\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u5404\u30ce\u30fc\u30c8\u306f\u300c\u5b8c\u74a7\u300d\u300c\u826f\u597d\u300d\u300c\u30df\u30b9\u300d\u306e3\u3064\u306e\u8a55\u4fa1\u304c\u3042\u308a\u307e\u3059\u3002\u300cStarlight Symphony\u300d\u306a\u3069\u3067\u306f\u3001\u300c\u5b8c\u74a7\u300d\u306a\u30ce\u30fc\u30c8\u3092\u30d2\u30c3\u30c8\u3059\u308b\u3068100\u70b9\u3001\u300c\u826f\u597d\u300d\u306a\u30ce\u30fc\u30c8\u3092\u30d2\u30c3\u30c8\u3059\u308b\u306850\u70b9\u3001\u300c\u30df\u30b9\u300d\u306a\u30ce\u30fc\u30c8\u306f0\u70b9\u3067\u3059\u3002\u307e\u305f\u3001\u9023\u7d9a\u3059\u308b\u300c\u5b8c\u74a7\u300d\u306a\u30d2\u30c3\u30c8\u306f\u30b3\u30f3\u30dc\u500d\u7387\u3092\u5897\u52a0\u3055\u305b\u3001\u30b9\u30b3\u30a2\u3092\u6307\u6570\u95a2\u6570\u7684\u306b\u4e0a\u6607\u3055\u305b\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u30b9\u30dd\u30fc\u30c4\u306b\u304a\u3051\u308b\u5831\u916c\u30e1\u30ab\u30cb\u30ba\u30e0\u3068\u4f3c\u3066\u304a\u308a\u3001\u7d99\u7d9a\u7684\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u304c\u3088\u308a\u9ad8\u3044\u5831\u916c\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002"}, {"question": "FNF StarCatcher\u3068\u4ed6\u306e\u30ea\u30ba\u30e0\u30b2\u30fc\u30e0\u3068\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "FNF StarCatcher\u306f\u3001\u30e6\u30cb\u30fc\u30af\u306a\u30ce\u30fc\u30c8\u30d1\u30bf\u30fc\u30f3\u3068\u30c6\u30fc\u30de\u306e\u7d71\u5408\u306b\u3088\u308a\u3001\u4ed6\u306e\u30ea\u30ba\u30e0\u30b2\u30fc\u30e0\u3068\u4e00\u7dda\u3092\u
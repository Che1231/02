[{"question": "\u5982\u4f55\u63d0\u9ad8\u6211\u5728FNF StarCatcher\u65b0\u624b\u6a21\u5f0f\u4e0b\u7684\u51c6\u786e\u7387\uff1f", "answer": "\u4e3a\u4e86\u63d0\u9ad8\u5728FNF StarCatcher\u4e2d\u7684\u51c6\u786e\u7387\uff0c\u9996\u5148\u8981\u7ec3\u4e60\u6309\u952e\u65f6\u95f4\u3002\u4f8b\u5982\uff0c\u5728\u6b4c\u66f2\u300a\u661f\u5149\u8282\u62cd\u300b\u4e2d\uff0c\u4e13\u6ce8\u4e8e\u5728\u8282\u62cd\u6807\u8bb0\u4e0e\u97f3\u7b26\u5bf9\u9f50\u65f6\u51fb\u6253\u97f3\u7b26\u3002\u6b65\u9aa4\u4e00\uff1a\u4f7f\u7528\u7ec3\u4e60\u6a21\u5f0f\u964d\u4f4e\u6b4c\u66f2\u901f\u5ea6\u3002\u6b65\u9aa4\u4e8c\uff1a\u5728\u4f60\u9002\u5e94\u540e\u9010\u6e10\u63d0\u9ad8\u901f\u5ea6\u3002\u6b65\u9aa4\u4e09\uff1a\u6ce8\u610f\u89c6\u89c9\u63d0\u793a\uff0c\u5c1d\u8bd5\u9884\u6d4b\u4e0b\u4e00\u4e2a\u97f3\u7b26\u3002\u8fd9\u79cd\u65b9\u6cd5\u5c31\u50cf\u5b66\u4e60\u6f14\u594f\u4e50\u5668\u4e00\u6837\uff0c\u91cd\u590d\u7ec3\u4e60\u53ef\u4ee5\u5efa\u7acb\u808c\u8089\u8bb0\u5fc6\u3002"}, {"question": "\u5728FNF StarCatcher\u4e2d\u5b8c\u6210\u9ad8\u96be\u5ea6\u6b4c\u66f2\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728FNF StarCatcher\u4e2d\u5b8c\u6210\u9ad8\u96be\u5ea6\u6b4c\u66f2\u9700\u8981\u7ec3\u4e60\u548c\u7b56\u7565\u7684\u7ed3\u5408\u3002\u4f8b\u5982\uff0c\u5728\u6b4c\u66f2\u300a\u661f\u9645\u51b2\u523a\u300b\u4e2d\uff0c\u97f3\u7b26\u4f1a\u5feb\u901f\u8fde\u7eed\u51fa\u73b0\u3002\u6b65\u9aa4\u4e00\uff1a\u5148\u638c\u63e1\u6b4c\u66f2\u7684\u8f83\u4f4e\u96be\u5ea6\u3002\u6b65\u9aa4\u4e8c\uff1a\u4e13\u6ce8\u4e8e\u4f60\u96be\u4ee5\u638c\u63e1\u7684\u90e8\u5206\uff0c\u91cd\u590d\u7ec3\u4e60\u76f4\u5230\u4f60\u53ef\u4ee5\u6301\u7eed\u51fb\u4e2d\u97f3\u7b26\u3002\u6b65\u9aa4\u4e09\uff1a\u4f7f\u7528\u201c\u91cd\u65b0\u5f00\u59cb\u201d\u529f\u80fd\u5feb\u901f\u91cd\u8bd5\u6311\u6218\u90e8\u5206\uff0c\u65e0\u9700\u7b49\u5f85\u6b4c\u66f2\u7ed3\u675f\u3002\u8fd9\u79cd\u65b9\u6cd5\u7c7b\u4f3c\u4e8e\u89e3\u8c1c\u6e38\u620f\uff0c\u5148\u653b\u514b\u6700\u96be\u7684\u90e8\u5206\u3002"}, {"question": "\u4e3a\u4ec0\u4e48FNF StarCatcher\u6bcf\u9996\u6b4c\u7684\u97f3\u7b26\u6a21\u5f0f\u90fd\u4e0d\u540c\uff1f", "answer": "FNF StarCatcher\u6bcf\u9996\u6b4c\u7684\u97f3\u7b26\u6a21\u5f0f\u90fd\u4e0d\u540c\uff0c\u662f\u4e3a\u4e86\u63d0\u5347\u6e38\u620f\u4f53\u9a8c\u5e76\u53cd\u6620\u6b4c\u66f2\u7684\u8282\u594f\u548c\u98ce\u683c\u3002\u4f8b\u5982\uff0c\u5728\u6b4c\u66f2\u300a\u5b87\u5b99\u6ce2\u6d6a\u300b\u4e2d\uff0c\u97f3\u7b26\u6a21\u5f0f\u6a21\u4eff\u4e86\u6d77\u6d6a\u7684\u6da8\u843d\uff0c\u521b\u9020\u51fa\u66f4\u8eab\u4e34\u5176\u5883\u7684\u4f53\u9a8c\u3002\u8fd9\u79cd\u8bbe\u8ba1\u9009\u62e9\u7c7b\u4f3c\u4e8e\u821e\u8e48\u7f16\u5bfc\u6839\u636e\u97f3\u4e50\u91cf\u8eab\u5b9a\u5236\u821e\u6b65\uff0c\u786e\u4fdd\u6bcf\u9996\u6b4c\u66f2\u90fd\u611f\u89c9\u72ec\u7279\u4e14\u5f15\u4eba\u5165\u80dc\u3002"}, {"question": "FNF StarCatcher\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "FNF StarCatcher\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u4f60\u7684\u97f3\u7b26\u51fb\u6253\u51c6\u786e\u7387\u3002\u6bcf\u4e2a\u97f3\u7b26\u90fd\u6709\u201c\u5b8c\u7f8e\u201d\u3001\u201c\u826f\u597d\u201d\u548c\u201c\u672a\u51fb\u4e2d\u201d\u7684\u8bc4\u7ea7\u3002\u4f8b\u5982\uff0c\u5728\u6b4c\u66f2\u300a\u661f\u5149\u4ea4\u54cd\u66f2\u300b\u4e2d\uff0c\u201c\u5b8c\u7f8e\u201d\u97f3\u7b26\u5956\u52b1100\u5206\uff0c\u201c\u826f\u597d\u201d\u97f3\u7b26\u5956\u52b150\u5206\uff0c\u201c\u672a\u51fb\u4e2d\u201d\u97f3\u7b26\u5956\u52b10\u5206\u3002\u6b64\u5916\uff0c\u8fde\u7eed\u201c\u5b8c\u7f8e\u201d\u51fb\u6253\u4f1a\u7d2f\u79ef\u8fde\u51fb\u500d\u6570\uff0c\u6307\u6570\u7ea7\u63d0\u9ad8\u4f60\u7684\u5206\u6570\u3002\u8fd9\u4e2a\u7cfb\u7edf\u5c31\u50cf\u8fd0\u52a8\u4e2d\u7684\u5956\u52b1\u673a\u5236\uff0c\u6301\u7eed\u826f\u597d\u7684\u8868\u73b0\u4f1a\u5e26\u6765\u66f4\u9ad8\u7684\u5956\u52b1\u3002"}, {"question": "FNF StarCatcher\u548c\u5176\u4ed6\u8282\u594f\u6e38\u620f\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "FNF StarCatcher\u4e0e\u5176\u4ed6\u8282\u594f\u6e38\u620f\u4e0d\u540c\u4e4b\u5904\u5728\u4e8e\u5176\u72ec\u7279\u7684\u97f3\u7b26\u6a21\u5f0f\u548c\u4e3b\u9898\u6574\u5408\u3002\u4f8b\u5982\uff0c\u5728\u6b4c\u66f2\u300a\u661f\u9645\u5347\u534e\u300b\u4e2d\uff0c\u97f3\u7b26\u6a21\u5f0f\u88ab\u8bbe\u8ba1\u4e3a\u6a21\u4eff\u5b87\u5b99\u98de\u8239\u7684\u5347\u7a7a\uff0c\u4e3a\u6e38\u620f\u6dfb\u52a0\u4e86\u4e00\u5c42\u53d9\u4e8b\u6027\u3002\u6b64\u5916\uff0cFNF StarCatcher\u63d0\u4f9b\u4e86\u5404\u79cd\u96be\u5ea6\u7b49\u7ea7\u548c\u7ec3\u4e60\u6a21\u5f0f\uff0c\u8ba9\u4e0d\u540c\u6c34\u5e73\u7684\u73a9\u5bb6\u90fd\u80fd\u8f7b\u677e\u4e0a\u624b\u3002\u8fd9\u5c31\u50cf\u4e00\u90e8\u5c06\u52a8\u4f5c\u4e0e\u5f15\u4eba\u5165\u80dc\u7684\u6545\u4e8b\u878d\u5408\u5728\u4e00\u8d77\u7684\u7535\u5f71\uff0c\u65e2\u6709\u523a\u6fc0\u6027\u4e5f\u6709\u6df1\u5ea6\u3002"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684FNF StarCatcher\u8fdb\u5ea6\u8f6c\u79fb\u5230\u65b0\u8bbe\u5907\uff1f", "answer": "\u5c06\u4f60\u7684FNF StarCatcher\u8fdb\u5ea6\u8f6c\u79fb\u5230\u65b0\u8bbe\u5907\u9700\u8981\u4f7f\u7528\u4e91\u4fdd\u5b58\u529f\u80fd\u3002\u6b65\u9aa4\u4e00\uff1a\u786e\u4fdd\u4f60\u7684\u5f53\u524d\u8bbe\u5907\u8fde\u63a5\u5230\u4e92\u8054\u7f51\u5e76\u4e14\u5728\u6e38\u620f\u8bbe\u7f6e\u4e2d\u542f\u7528\u4e86\u4e91\u4fdd\u5b58\u3002\u6b65\u9aa4\u4e8c\uff1a\u5728\u65b0\u8bbe\u5907\u4e0a\u4f7f\u7528\u76f8\u540c\u7684\u8d26\u6237\u767b\u5f55\u5e76\u542f\u7528\u4e91\u4fdd\u5b58\u3002\u6b65\u9aa4\u4e09\uff1a\u4ece\u4e91\u7aef\u52a0\u8f7d\u4f60\u7684\u4fdd\u5b58\u8fdb\u5ea6\u3002\u8fd9\u4e2a\u8fc7\u7a0b\u5c31\u50cf\u4f7f\u7528\u4e91\u5b58\u50a8\u670d\u52a1\u5c06\u4f60\u7684\u6587\u4ef6\u4ece\u4e00\u53f0\u7535\u8111\u79fb\u52a8\u5230\u53e6\u4e00\u53f0\u7535\u8111\u4e00\u6837\uff0c\u786e\u4fdd\u4f60\u7684\u6570\u636e\u4fdd\u6301\u5b8c\u6574\u3002"}, {"question": "FNF StarCatcher\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u5f69\u86cb\uff1f", "answer": "FNF StarCatcher\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u5f69\u86cb\uff0c\u589e\u52a0\u4e86\u6e38\u620f\u7684\u9b45\u529b\u3002\u4f8b\u5982\uff0c\u5728\u6b4c\u66f2\u300a\u661f\u9645\u4e4b\u821e\u300b\u4e2d\uff0c\u5982\u679c\u5b8c\u7f8e\u51fb\u6253\u6240\u6709\u97f3\u7b26\uff0c\u5c06\u4f1a\u51fa\u73b0\u4e00\u4e2a\u7279\u6b8a\u7684\u661f\u9645\u8df3\u821e\u52a8\u753b\u3002\u6b64\u5916\uff0c\u5728\u6e38\u620f\u4e3b\u83dc\u5355\u4e2d\uff0c\u4e00\u4e2a\u79d8\u5bc6\u4ee3\u7801\u53ef\u4ee5\u89e3\u9501\u9690\u85cf\u89d2\u8272\u3002\u8fd9\u4e9b\u5f69\u86cb\u5c31\u50cf\u89c6\u9891\u6e38\u620f\u4e2d\u9690\u85cf\u7684\u5b9d\u85cf\uff0c\u5956\u52b1\u73a9\u5bb6\u7684\u597d\u5947\u5fc3\u548c\u6280\u5de7\u3002"}, {"question": "FNF StarCatcher\u7684\u96be\u5ea6\u7f29\u653e\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "FNF StarCatcher\u7684\u96be\u5ea6\u7f29\u653e\u4f1a\u663e\u8457\u5f71\u54cd\u6e38\u620f\u4f53\u9a8c\uff0c\u901a\u8fc7\u8c03\u6574\u97f3\u7b26\u6a21\u5f0f\u7684\u901f\u5ea6\u548c\u590d\u6742\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u6b4c\u66f2\u300a\u661f\u4e91\u4e4b\u591c\u300b\u4e2d\uff0c\u201c\u7b80\u5355\u201d\u6a21\u5f0f\u7684\u97f3\u7b26\u901f\u5ea6\u8f83\u6162\uff0c\u6a21\u5f0f\u4e5f\u6bd4\u8f83\u7b80\u5355\uff1b\u201c\u56f0\u96be\u201d\u6a21\u5f0f\u5219\u5f15\u5165\u4e86\u66f4\u5feb\u901f\u5ea6\u548c\u66f4\u590d\u6742\u7684\u6a21\u5f0f\u3002\u8fd9\u79cd\u7f29\u653e\u7c7b\u4f3c\u4e8e\u9010\u6e10\u589e\u52a0\u5f3a\u5ea6\u7684\u953b\u70bc\u8ba1\u5212\uff0c\u968f\u7740\u65f6\u95f4\u7684\u63a8\u79fb\uff0c\u6311\u6218\u73a9\u5bb6\u63d0\u9ad8\u6280\u80fd\u3002"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u8fd0\u884cFNF StarCatcher\u7684\u6280\u672f\u8981\u6c42\u662f\u4ec0\u4e48\uff1f", "answer": "FNF StarCatcher\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u7684\u6280\u672f\u8981\u6c42\u6709\u6240\u4e0d\u540c\u3002\u4f8b\u5982\uff0c\u5728PC\u4e0a\uff0c\u6e38\u620f\u81f3\u5c11\u9700\u89812GB\u5185\u5b58\u548c\u652f\u6301DirectX 11\u7684\u663e\u5361\u3002\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\uff0c\u5b83\u9700\u8981iOS 10\u6216Android 7.0\u53ca\u4ee5\u4e0a\u7248\u672c\u3002\u8fd9\u4e9b\u8981\u6c42\u7c7b\u4f3c\u4e8e\u8fd0\u884c\u9ad8\u8d28\u91cf\u89c6\u9891\u6240\u9700\u7684\u89c4\u683c\uff0c\u786e\u4fdd\u5728\u4e0d\u540c\u8bbe\u5907\u4e0a\u90fd\u80fd\u6d41\u7545\u8fd0\u884c\u6e38\u620f\u3002"}, {"question": "\u5982\u4f55\u4f18\u5316\u8bbe\u5907\u6027\u80fd\u4ee5\u83b7\u5f97\u66f4\u597d\u7684FNF StarCatcher\u4f53\u9a8c\uff1f", "answer": "\u4f18\u5316\u8bbe\u5907\u6027\u80fd\u4ee5\u83b7\u5f97\u66f4\u597d\u7684FNF StarCatcher\u4f53\u9a8c\u5305\u62ec\u4ee5\u4e0b\u6b65\u9aa4\u3002\u6b65\u9aa4\u4e00\uff1a\u5173\u95ed\u540e\u53f0\u5e94\u7528\u7a0b\u5e8f\u4ee5\u91ca\u653e\u7cfb\u7edf\u8d44\u6e90\u3002\u6b65\u9aa4\u4e8c\uff1a\u5982\u679c\u4f60\u9047\u5230\u5ef6\u8fdf\uff0c\u8bf7\u964d\u4f4e\u6e38\u620f\u7684\u56fe\u5f62\u8bbe\u7f6e\u3002\u6b65\u9aa4\u4e09\uff1a\u786e\u4fdd\u4f60\u7684\u8bbe\u5907\u64cd\u4f5c\u7cfb\u7edf\u548c\u9a71\u52a8\u7a0b\u5e8f\u662f\u6700\u65b0\u7684\u3002\u8fd9\u4e2a\u8fc7\u7a0b\u5c31\u50cf\u4e3a\u8d5b\u8f66\u8c03\u6574\u6c7d\u8f66\uff0c\u6bcf\u4e2a\u8c03\u6574\u90fd\u4f1a\u63d0\u9ad8\u6027\u80fd\u3002"}]
[{"question": "Sky Mad\uff1a\u5982\u4f55\u8fdb\u884c\u57fa\u672c\u8df3\u8dc3\uff0c\u4ee5\u53ca\u5728\u6e38\u620f\u5f00\u59cb\u65f6\u5982\u4f55\u6700\u597d\u5730\u907f\u514d\u4ece\u5e73\u53f0\u4e0a\u6389\u4e0b\u6765\uff1f", "answer": "\u5728Sky Mad\u4e2d\uff0c\u8df3\u8dc3\u81f3\u5173\u91cd\u8981\uff01\u6309\u7a7a\u683c\u952e\uff08\u6216\u6e38\u620f\u624b\u67c4\u7684\u6307\u5b9a\u8df3\u8dc3\u6309\u94ae\uff09\u5373\u53ef\u8df3\u8dc3\u3002\u4e3a\u4e86\u907f\u514d\u6389\u843d\uff0c\u8bf7\u5bc6\u5207\u5173\u6ce8\u5e73\u53f0\u8fb9\u7f18\u3002\u4ece\u77ed\u8ddd\u79bb\u8df3\u8dc3\u5f00\u59cb\uff0c\u9010\u6e10\u589e\u52a0\u8df3\u8dc3\u8ddd\u79bb\u3002\u4e00\u4e2a\u5f88\u597d\u7684\u4f8b\u5b50\u662f\u201c\u6559\u7a0b\u5c9b\u201d\u5173\u5361\u2014\u2014\u5728\u5c1d\u8bd5\u4efb\u4f55\u9ad8\u7ea7\u52a8\u4f5c\u4e4b\u524d\uff0c\u5148\u7ec3\u4e60\u8de8\u8d8a\u95f4\u9694\u3002\u8fd9\u5c31\u597d\u6bd4\u5b66\u4e60\u9a91\u81ea\u884c\u8f66\u4e00\u6837\uff0c\u8981\u4ece\u6162\u901f\u5f00\u59cb\uff0c\u5efa\u7acb\u4fe1\u5fc3\u3002\u8010\u529b\u7ba1\u7406\u4e5f\u5f88\u5173\u952e\uff0c\u56e0\u4e3a\u8fc7\u5ea6\u6d88\u8017\u8010\u529b\u53ef\u80fd\u4f1a\u5bfc\u81f4\u8df3\u8dc3\u52a8\u4f5c\u7b28\u62d9\uff0c\u8bf7\u8c03\u6574\u60a8\u7684\u6e38\u620f\u4ee5\u83b7\u5f97\u6700\u4f73\u6548\u7387\u3002"}, {"question": "\u5728Sky Mad\u6e38\u620f\u521d\u671f\uff0c\u6211\u5e94\u8be5\u6536\u96c6\u54ea\u4e9b\u8d44\u6e90\uff0c\u4ee5\u53ca\u8fd9\u4e9b\u8d44\u6e90\u5bf9\u65b0\u624b\u521d\u59cb\u5347\u7ea7\u4e3a\u4ec0\u4e48\u5982\u6b64\u91cd\u8981\uff1f", "answer": "\u5728Sky Mad\u6e38\u620f\u521d\u671f\uff0c\u5e94\u4e13\u6ce8\u4e8e\u6536\u96c6\u201c\u788e\u7247\u201d\u548c\u201c\u7cbe\u534e\u201d\u3002\u5b8c\u6210\u5173\u5361\u540e\u901a\u5e38\u4f1a\u83b7\u5f97\u788e\u7247\uff0c\u5e76\u5728\u4efb\u52a1\u603b\u7ed3\u4e2d\u663e\u793a\u3002\u7cbe\u534e\u53ef\u80fd\u9700\u8981\u66f4\u591a\u63a2\u7d22\uff0c\u4f60\u7ecf\u5e38\u53ef\u4ee5\u5728\u5177\u6709\u6311\u6218\u6027\u7684\u8df3\u8dc3\u9644\u8fd1\u627e\u5230\u4e00\u5c0f\u7c07\u7cbe\u534e\u3002\u788e\u7247\u662f\u5347\u7ea7\u8df3\u8dc3\u9ad8\u5ea6\u548c\u79fb\u52a8\u901f\u5ea6\u7684\u4e3b\u8981\u8d27\u5e01\uff0c\u800c\u7cbe\u534e\u5219\u5141\u8bb8\u4f60\u89e3\u9501\u65b0\u7684\u7a7f\u68ad\u6280\u80fd\uff0c\u4f8b\u5982\u201c\u7a7a\u4e2d\u51b2\u523a\u201d\u3002\u521d\u59cb\u5347\u7ea7\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u65e9\u671f\u5173\u5361\u6545\u610f\u5e73\u8861\uff0c\u4ee5\u9f13\u52b1\u5347\u7ea7\u8d2d\u4e70\uff01\u8fd9\u662f\u4e00\u4e2a\u5faa\u5e8f\u6e10\u8fdb\u7684\u63d0\u5347\uff0c\u4f46\u81f3\u5173\u91cd\u8981\u3002\u5c3d\u65e9\u5347\u7ea7\u5c06\u5728\u540e\u671f\u5173\u5361\u4e2d\u5e2e\u52a9\u4f60\uff01"}, {"question": "\u5728\u5173\u5361\u9009\u62e9\u5668\u4e2d\u5217\u51fa\u7684\u201c\u8bd5\u70bc\u201d\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5b83\u4eec\u4f1a\u6388\u4e88\u54ea\u4e9b\u5956\u52b1\uff1f", "answer": "Sky Mad\u4e2d\u7684\u8bd5\u70bc\u662f\u5728\u6bcf\u4e2a\u5173\u5361\u4e2d\u8bbe\u8ba1\u7684\u7279\u6b8a\u6311\u6218\uff0c\u65e8\u5728\u6d4b\u8bd5\u4f60\u7684\u6280\u80fd\u3002\u8fd9\u53ef\u80fd\u5305\u62ec\u5728\u89c4\u5b9a\u7684\u65f6\u95f4\u5185\u5b8c\u6210\u5173\u5361\u3001\u6536\u96c6\u6240\u6709\u9690\u85cf\u7684\u6536\u96c6\u54c1\u6216\u5728\u6ca1\u6709\u4efb\u4f55\u6b7b\u4ea1\u7684\u60c5\u51b5\u4e0b\u5b8c\u6210\u5173\u5361\u3002\u5b8c\u6210\u8bd5\u70bc\u5c06\u5956\u52b1\u4f60\u201c\u8bd5\u70bc\u4ee4\u724c\u201d\u3002\u8bd5\u70bc\u4ee4\u724c\u7528\u4e8e\u89e3\u9501\u5316\u5986\u5b9a\u5236\u9009\u9879\uff0c\u4f8b\u5982\u65b0\u7684\u6ed1\u7fd4\u673a\u76ae\u80a4\u548c\u89d2\u8272\u670d\u88c5\u3002\u4f8b\u5982\uff0c\u5b8c\u6210\u201c\u6c34\u6676\u6d1e\u7a74\u201d\u8bd5\u70bc\u5c06\u89e3\u9501\u201c\u9ed1\u66dc\u77f3\u6ed1\u7fd4\u673a\u201d\u76ae\u80a4\u3002\u8fd9\u4e9b\u4e3a\u4f60\u7684\u89d2\u8272\u589e\u6dfb\u4e86\u72ec\u7279\u7684\u98ce\u683c\uff0c\u5e76\u8ba9\u4f60\u5c55\u793a\u4f60\u7684\u6280\u80fd\u3002\u8fd9\u5c31\u662f\u6211\u4eec\u5956\u52b1\u5bf9\u7279\u5b9a\u5173\u5361\u7684\u7cbe\u901a\u5e76\u9f13\u52b1\u5b8c\u7f8e\u4e3b\u4e49\u7684\u65b9\u5f0f\uff01"}, {"question": "\u4f5c\u4e3a\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\uff0c\u5728Sky Mad\u6e38\u620f\u4e2d\u8fdb\u884c\u901f\u5ea6\u901a\u5173\u7684\u6700\u6709\u6548\u7b56\u7565\u662f\u4ec0\u4e48\uff1f\u54ea\u4e9b\u6280\u80fd\u6811\u6700\u4e3a\u5173\u952e\uff0c\u54ea\u4e9b\u533a\u57df\u6709\u6700\u4f73\u7684\u65f6\u95f4\u8282\u7701\u673a\u4f1a\uff1f", "answer": "\u4e3a\u4e86\u5728Sky Mad\u4e2d\u8fdb\u884c\u901f\u5ea6\u901a\u5173\uff0c\u6548\u7387\u81f3\u5173\u91cd\u8981\u3002\u7b2c\u4e00\u6b65\uff1a\u5c3d\u65e9\u6700\u5927\u5316\u201c\u52a8\u91cf\u201d\u6280\u80fd\u6811\uff1b\u5b83\u4f1a\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u7a7a\u4e2d\u901f\u5ea6\uff0c\u5e76\u5141\u8bb8\u66f4\u5feb\u5730\u7a7f\u68ad\u3002\u7b2c\u4e8c\u6b65\uff1a\u8bb0\u4f4f\u5173\u5361\u5e03\u5c40\u3002\u77e5\u9053\u6700\u4f73\u8def\u5f84\u53ef\u4ee5\u8282\u7701\u5b9d\u8d35\u7684\u65f6\u95f4\u3002\u7b2c\u4e09\u6b65\uff1a\u5229\u7528\u201c\u5899\u8e22\u201d\u673a\u5236\u3002\u5899\u8e22\u5728\u7a7a\u4e2d\u6539\u53d8\u65b9\u5411\u7684\u540c\u65f6\u4fdd\u6301\u4f60\u7684\u52a8\u91cf\u3002\u5177\u6709\u9ad8\u65f6\u95f4\u8282\u7701\u6f5c\u529b\u7684\u7279\u5b9a\u533a\u57df\u5305\u62ec\uff1a\u201c\u901f\u5ea6\u810a\u201d\uff0c\u5728\u8be5\u533a\u57df\u638c\u63e1\u201c\u5899\u8e22\u201d\u6280\u672f\u53ef\u4ee5\u8282\u7701\u8fd13\u79d2\u3002\u6bd4\u8f83\u6807\u51c6\u8def\u5f84\u4e0e\u901f\u5ea6\u901a\u5173\u73a9\u5bb6\u7684\u4f18\u5316\u8def\u5f84\uff0c\u8fd9\u5bf9\u4e8e\u524a\u51cf\u6240\u6d89\u53ca\u7684\u6beb\u79d2\u6570\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "Sky Mad\uff1a\u4e3a\u4ec0\u4e48\u5373\u4f7f\u6211\u6709\u8db3\u591f\u7684\u80fd\u91cf\uff0c\u6211\u7684\u6ed1\u7fd4\u673a\u6709\u65f6\u4e5f\u65e0\u6cd5\u90e8\u7f72\uff1f\u6211\u8be5\u5982\u4f55\u786e\u4fdd\u6ed1\u7fd4\u673a\u80fd\u591f\u53ef\u9760\u5730\u90e8\u7f72\uff1f", "answer": "\u5728Sky Mad\u4e2d\uff0c\u6ed1\u7fd4\u673a\u7684\u90e8\u7f72\u4f9d\u8d56\u4e8e\u80fd\u91cf\u548c\u52a8\u91cf\u7684\u7ed3\u5408\u3002\u5982\u679c\u8fd9\u4e24\u79cd\u5c5e\u6027\u4e2d\u7684\u4e00\u79cd\u6216\u4e24\u8005\u90fd\u8fc7\u4f4e\uff0c\u6ed1\u7fd4\u673a\u5c06\u65e0\u6cd5\u90e8\u7f72\u3002\u5982\u679c\u6700\u8fd1\u4f7f\u7528\u8fc7\u7a7a\u4e2d\u51b2\u523a\uff0c\u80fd\u91cf\u53ef\u80fd\u4f1a\u504f\u4f4e\uff0c\u8fd9\u4f1a\u968f\u7740\u65f6\u95f4\u7684\u63a8\u79fb\u800c\u6062\u590d\u3002\u5982\u679c\u5728\u7a7a\u4e2d\u9759\u6b62\u4e0d\u52a8\u6216\u79fb\u52a8\u901f\u5ea6\u975e\u5e38\u6162\uff0c\u52a8\u91cf\u53ef\u80fd\u4f1a\u504f\u4f4e\u3002\u4e3a\u4e86\u786e\u4fdd\u6ed1\u7fd4\u673a\u80fd\u591f\u53ef\u9760\u5730\u90e8\u7f72\uff0c\u8bf7\u4fdd\u6301\u9002\u5f53\u7684\u901f\u5ea6\uff0c\u5e76\u8c28\u614e\u4f7f\u7528\u7a7a\u4e2d\u51b2\u523a\uff0c\u8fd9\u786e\u4fdd\u80fd\u91cf\u6c34\u5e73\u4fdd\u6301\u826f\u597d\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4ece\u9ad8\u5904\u4f7f\u7528\u7a7a\u4e2d\u51b2\u523a\u8df3\u8dc3\uff0c\u4f60\u7684\u52a8\u91cf\u4f1a\u5e26\u52a8\u4f60\uff0c\u8fd9\u5c06\u5141\u8bb8\u4f60\u6210\u529f\u90e8\u7f72\u3002\u4e0b\u9762\u662f\u80fd\u91cf\u548c\u8010\u529b\u7684\u5173\u7cfb\u8868\uff0c\u4ee5\u63d0\u4f9b\u80fd\u91cf\u548c\u8010\u529b\u7684\u5173\u7cfb\u3002 \n GLIDER_DEPLOY\uff1a\u80fd\u91cf(>=25%) && \u52a8\u91cf(>=50%)\u3002\u5982\u679c\u6ee1\u8db3\u8fd9\u4e9b\u6761\u4ef6\uff0c\u5219\u90e8\u7f72\uff1b\u5426\u5219\uff0c\u4f60\u5c06\u4f1a\u6389\u843d\u3002"}, {"question": "\u4e3a\u4ec0\u4e48Sky Mad\u4e2d\u7684\u79ef\u5206\u7cfb\u7edf\u5bf9\u4e8e\u5b8c\u6210\u6311\u6218\u5982\u6b64\u91cd\u8981\uff1f", "answer": "Sky Mad\u4e2d\u7684\u79ef\u5206\u7cfb\u7edf\u4e0d\u4ec5\u4ec5\u662f\u8bc4\u5206\uff1b\u5b83\u76f4\u63a5\u5f71\u54cd\u4f60\u5b8c\u6210\u6311\u6218\u7684\u80fd\u529b\uff0c\u56e0\u4e3a\u66f4\u9ad8\u7684\u5206\u6570\u901a\u5e38\u4e0e\u89e3\u9501\u5173\u952e\u5347\u7ea7\u3001\u80fd\u529b\uff0c\u6709\u65f6\u751a\u81f3\u67d0\u4e9b\u5173\u5361\u4e2d\u7684\u79d8\u5bc6\u533a\u57df\u6709\u5173\u3002\u79ef\u5206\u5956\u52b1\u73a9\u5bb6\u6267\u884c\u7684\u6240\u6709\u52a8\u4f5c\u3002\u4ee5\u4e0b\u662f\u4e00\u4e9b\u5956\u52b1\u5217\u8868\uff1a\n\u666e\u901a\u8df3\u8dc3\u2014\u20145\u70b9\n\u7a7a\u4e2d\u8c03\u6574\u2014\u201410\u70b9\n\u51fb\u6740\u654c\u4eba\u2014\u201420\u70b9+\u96be\u5ea6\u500d\u589e\u5668\n\u5899\u8df3\u2014\u201415\u70b9\n\u7a7a\u4e2d\u8eb2\u907f\u2014\u201420\u70b9\n\u6210\u529f\u6ed1\u7fd4\u673a\u53d1\u5c04\u2014\u201425\u70b9\n\u6536\u96c6\u54c1\u2014\u2014\u6839\u636e\u60c5\u51b5\u800c\u5b9a\n\u5173\u5361\u5b8c\u6210\u2014\u2014100\u70b9 + \u96be\u5ea6\u500d\u589e\u5668 + \u7279\u522b\u76ee\u6807\u5b8c\u6210\u3002\n\u4f8b\u5982\uff0c\u5728\u201c\u9057\u5fd8\u4e4b\u57ce\u201d\u6311\u6218\u4e2d\uff0c\u8fbe\u52305000\u5206\u4ee5\u4e0a\u5c06\u89e3\u9501\u4e00\u6761\u539f\u672c\u65e0\u6cd5\u5230\u8fbe\u7684\u8def\u5f84\uff0c\u5e76\u6388\u4e88\u4f60\u4e00\u4e2a\u4e0e\u8df3\u8dc3\u9ad8\u5ea6\u76f8\u5173\u7684\u5173\u952e\u5347\u7ea7\u3002\u5982\u679c\u6ca1\u6709\u83b7\u5f97\u8db3\u591f\u7684\u79ef\u5206\uff0c\u4f60\u5c06\u4f1a\u5931\u8d25\u3002"}, {"question": "Sky Mad\u6b66\u5668\u4e4b\u95f4\u7684\u6570\u503c\u4f24\u5bb3\u5dee\u5f02\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u54ea\u4e9b\u5c5e\u6027\u52a0\u6210\u4f1a\u5f71\u54cd\u6b66\u5668\u7684\u603b\u4f53\u4f24\u5bb3\uff1f", "answer": "Sky Mad\u4e2d\u7684\u6bcf\u4e00\u628a\u6b66\u5668\u90fd\u5177\u6709\u72ec\u7279\u7684\u4f24\u5bb3\u503c\uff0c\u8fd9\u4e9b\u4f24\u5bb3\u503c\u4f1a\u53d7\u5230\u5c5e\u6027\u52a0\u6210\u7684\u5f71\u54cd\u3002\u201c\u7b49\u79bb\u5b50\u67aa\u201d\u7684\u57fa\u4f24\u5bb3\u4e3a50\uff0c\u800c\u201c\u5f27\u5f62\u70ae\u201d\u7684\u57fa\u4f24\u5bb3\u4e3a80\uff0c\u4f46\u5176\u5c04\u51fb\u901f\u5ea6\u8f83\u6162\uff0c\u4f8b\u5982\u3002\u5c5e\u6027\u52a0\u6210\u4f1a\u663e\u8457\u5f71\u54cd\u6b66\u5668\u3002\u201c\u529b\u91cf\u201d\u4f1a\u4f7f\u57fa\u4f24\u5bb3\u6bcf\u589e\u52a0\u4e00\u70b9\u589e\u52a01%\uff0c\u800c\u201c\u654f\u6377\u201d\u4f1a\u4f7f\u5c04\u51fb\u901f\u5ea6\u6bcf\u589e\u52a0\u4e00\u70b9\u589e\u52a02%\u3002\u4e00\u4e2a\u826f\u597d\u7684\u6784\u5efa\u53ef\u80fd\u662f\u4e13\u6ce8\u4e8e\u4f24\u5bb3\u548c\u529b\u91cf\uff0c\u4ee5\u6784\u5efa\u4e00\u4e2a\u504f\u7231\u7206\u53d1\u4f24\u5bb3\u7684\u6784\u5efa\u3002\u6216\u8005\uff0c\u4f60\u53ef\u4ee5\u4e13\u6ce8\u4e8e\u654f\u6377\u6027\uff0c\u4ee5\u6700\u5927\u5316\u5c04\u51fb\u901f\u5ea6\u548cDPS\u8f93\u51fa\u3002\u8fd9\u53d6\u51b3\u4e8e\u73a9\u5bb6\u7684\u559c\u597d\u3002"}, {"question": "Sky Mad\uff1a\u9664\u4e86\u56fe\u5f62\u4e4b\u5916\uff0c\u5728PC\u548c\u79fb\u52a8\u5e73\u53f0\u4e0a\u73a9\u6e38\u620f\u65f6\uff0c\u6211\u8fd8\u80fd\u671f\u5f85\u54ea\u4e9b\u6838\u5fc3\u6e38\u620f\u73a9\u6cd5\u5dee\u5f02\u548c\u4f18\u52bf\uff0c\u7279\u522b\u662f\u8003\u8651\u5230\u63a7\u5236\u65b9\u9762\uff1f", "answer": "PC\u548c\u79fb\u52a8\u5e73\u53f0\u7684\u6838\u5fc3\u6e38\u620f\u73a9\u6cd5\u57fa\u672c\u76f8\u540c\u3002\u7136\u800c\uff0cPC\u5728\u63a7\u5236\u7cbe\u5ea6\u548c\u56fe\u5f62\u4fdd\u771f\u5ea6\u65b9\u9762\u5177\u6709\u4f18\u52bf\u3002PC\u7248\u672c\u652f\u6301\u952e\u76d8\u548c\u9f20\u6807\u6216\u6e38\u620f\u624b\u67c4\uff0c\u5141\u8bb8\u7cbe\u786e\u7684\u79fb\u52a8\u548c\u7784\u51c6\uff0c\u5c24\u5176\u662f\u5728\u9700\u8981\u5feb\u901f\u8fde\u7eed\u8fdb\u884c\u591a\u6b21\u5899\u58c1\u8df3\u8dc3\u65f6\u3002\u79fb\u52a8\u7248\u672c\u5219\u4f9d\u8d56\u4e8e\u89e6\u6478\u5c4f\u63a7\u5236\uff0c\u5bf9\u4e8e\u590d\u6742\u7684\u6280\u5de7\u53ef\u80fd\u4e0d\u592a\u51c6\u786e\u3002\u5728\u624b\u673a\u4e0a\u4f60\u53ef\u80fd\u9047\u5230\u7684\u4e00\u4e2a\u95ee\u9898\u662f\u5c4f\u5e55\u7a7a\u95f4\u548c\u610f\u5916\u70b9\u51fb\u4e86\u9760\u8fd1\u4f60\u60f3\u4f7f\u7528\u7684\u89e6\u6478\u63a7\u5236\u3002\u4f60\u53ef\u4ee5\u5c06\u5b83\u60f3\u8c61\u6210\u7528\u7ec6\u5c16\u7b14\uff08PC\uff09\u753b\u753b\u4e0e\u7528\u8721\u7b14\uff08\u79fb\u52a8\uff09\u753b\u753b\u3002PC\u66f4\u5927\u7684\u5c4f\u5e55\u548c\u989d\u5916\u7684\u5904\u7406\u80fd\u529b\u4e5f\u5bfc\u81f4\u66f4\u597d\u7684\u56fe\u5f62\u6027\u80fd\uff0c\u8fd9\u610f\u5473\u7740\u66f4\u597d\u7684\u5e27\u901f\u7387\u548c\u89c6\u89c9\u7ec6\u8282\u3002"}, {"question": "Sky Mad\uff1a\u6211\u77e5\u9053\u4e00\u4e9b\u73a9\u5bb6\u7684\u8fdb\u5ea6\u4e22\u5931\u4e86\u3002\u5e73\u53f0\u4e4b\u95f4\u662f\u5426\u6709\u8de8\u5e73\u53f0\u8d26\u6237\u540c\u6b65\uff0c\u6211\u8be5\u5982\u4f55\u786e\u4fdd\u6211\u7684\u8fdb\u5ea6\u53ef\u4ee5\u5728\u4e0d\u540c\u8bbe\u5907\u4e0a\u4fdd\u5b58\uff0c\u907f\u514d\u8fd9\u79cd\u60c5\u51b5\u53d1\u751f\uff1f", "answer": "Sky Mad\u652f\u6301\u8de8\u5e73\u53f0\u8d26\u6237\u540c\u6b65\uff01\u4e3a\u4e86\u786e\u4fdd\u4f60\u7684\u8fdb\u5ea6\u4fdd\u5b58\uff0c\u8bf7\u521b\u5efa\u4e00\u4e2a\u8d26\u6237\u3002\u4f60\u9700\u8981\u63d0\u4f9b\u4f60\u80fd\u591f\u8bbf\u95ee\u7684\u7535\u5b50\u90ae\u4ef6\u5730\u5740\u5e76\u4e14\u8bbe\u7f6e\u4e00\u4e2a\u5b89\u5168\u7684\u5bc6\u7801\u6765\u4fdd\u62a4\u4f60\u7684\u8d26\u6237\u3002\u4e4b\u540e\uff0c\u4f60\u9700\u8981\u901a\u8fc7\u6e38\u620f\u8bbe\u7f6e\u83dc\u5355\u4e3b\u52a8\u542f\u7528\u4e91\u5b58\u6863\u3002\u542f\u7528\u540e\uff0c\u4f60\u7684\u8fdb\u5ea6\u5c06\u81ea\u52a8\u5728\u8bbe\u5907\u4e4b\u95f4\u540c\u6b65\u3002\u4e00\u4e2a\u5f88\u597d\u7684\u5b89\u5168\u63aa\u65bd\u662f\u624b\u52a8\u5907\u4efd\u4f60\u7684\u672c\u5730\u5b58\u6863\u6587\u4ef6\uff0c\u5b83\u901a\u5e38\u4f4d\u4e8e\u4f60\u7684\u6587\u6863\u6587\u4ef6\u5939\u4e0b\u7684\u201cSkyMad\u201d\u76ee\u5f55\u4e2d\uff0c\u4f5c\u4e3a\u5b89\u5168\u63aa\u65bd\u3002\u5982\u679c\u4e91\u5b58\u6863\u51fa\u73b0\u6545\u969c\u6216\u8d26\u6237\u51fa\u73b0\u95ee\u9898\uff0c\u8fd9\u662f\u4e00\u4e2a\u6709\u7528\u7684\u5b89\u5168\u9009\u9879\u3002"}, {"question": "\u5728Sky Mad\u7684\u591a\u4e2a\u5173\u5361\u4e2d\u53d1\u73b0\u7684\u5de8\u578b\u96d5\u50cf\u80cc\u540e\u6709\u4ec0\u4e48\u6545\u4e8b\uff1f\u5b83\u4eec\u662f\u5426\u4f1a\u4e3a\u5b8c\u6210\u5ea6\u73a9\u5bb6\u89e3\u9501\u4efb\u4f55\u9690\u85cf\u533a\u57df\u6216\u5956\u52b1\uff1f", "answer": "Sky Mad\u4e2d\u7684\u5de8\u578b\u96d5\u50cf\u4ee3\u8868\u7740\u201c\u5efa\u7b51\u5e08\u201d\uff0c\u4e00\u4e2a\u5851\u9020\u4e86\u6f02\u6d6e\u5c9b\u5c7f\u7684\u53e4\u4ee3\u6587\u660e\u3002\u4e00\u4ef6\u53ea\u6709\u957f\u671f\u73a9\u5bb6\u624d\u80fd\u770b\u5230\u7684\u4e8b\u60c5\u662f\uff0c\u4f60\u53ef\u4ee5\u901a\u8fc7\u6fc0\u6d3b\u9690\u85cf\u7684\u80fd\u91cf\u6e90\u6765\u6062\u590d\u591a\u4e2a\u5173\u5361\u4e2d\u96d5\u50cf\u7684\u529f\u80fd\u3002\u6fc0\u6d3b\u6240\u6709\u96d5\u50cf\u5c06\u89e3\u9501\u4e00\u4e2a\u9690\u85cf\u5173\u5361\u201c\u5efa\u7b51\u5e08\u7684\u6500\u767b\u201d\u3002\u5b8c\u6210\u8be5\u5173\u5361\u5c06\u5956\u52b1\u4f60\u201c\u5efa\u7b51\u5e08\u4e4b\u5203\u201d\uff0c\u8fd9\u662f\u4e00\u79cd\u5177\u6709\u7279\u6b8a\u5c5e\u6027\u7684\u72ec\u7279\u6b66\u5668\uff0c\u5728\u5176\u4ed6\u4efb\u4f55\u5730\u65b9\u90fd\u65e0\u6cd5\u83b7\u5f97\u3002\u5173\u4e8e\u5b83\u4eec\u521b\u4f5c\u80cc\u540e\u7684\u6545\u4e8b\u53ef\u4ee5\u5728\u6e38\u620f\u5185\u627e\u5230\uff0c\u6536\u96c6\u54c1\uff0c\u653e\u7f6e\u5728\u96d5\u50cf\u9644\u8fd1\u7684\u97f3\u9891\u65e5\u5fd7\u4e2d\u3002\u627e\u5230\u6240\u6709\u8fd9\u4e9b\u788e\u7247\u53ef\u80fd\u4f1a\u82b1\u8d39\u4e00\u4e9b\u65f6\u95f4\uff0c\u56e0\u6b64\u8fd9\u53ef\u80fd\u6bd4\u8f83\u56f0\u96be\u3002\u4f60\u9700\u8981\u82b1\u8d39\u65f6\u95f4\u6765\u5b8c\u5584\u5173\u5361\u4ee5\u786e\u4fdd\u89e3\u9501\u5bf9\u8fd9\u4e2a\u79d8\u5bc6\u7684\u8bbf\u95ee\u3002"}]
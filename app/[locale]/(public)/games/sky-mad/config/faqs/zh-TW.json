[{"question": "Sky Mad\uff1a\u6211\u5982\u4f55\u57f7\u884c\u57fa\u672c\u8df3\u8e8d\uff0c\u4ee5\u53ca\u5728\u904a\u6232\u958b\u59cb\u6642\u5982\u4f55\u6700\u597d\u5730\u907f\u514d\u5f9e\u5e73\u53f0\u4e0a\u6389\u4e0b\u4f86\uff1f", "answer": "\u5728 Sky Mad \u4e2d\uff0c\u8df3\u8e8d\u81f3\u95dc\u91cd\u8981\uff01\u8acb\u6309\u4e0b\u7a7a\u683c\u9375\uff08\u6216\u63a7\u5236\u5668\u6307\u5b9a\u7684\u8df3\u8e8d\u6309\u9215\uff09\u4f86\u8df3\u8e8d\u3002\u70ba\u4e86\u907f\u514d\u6389\u843d\uff0c\u8acb\u5bc6\u5207\u6ce8\u610f\u5e73\u53f0\u908a\u7de3\u3002\u5f9e\u77ed\u8df3\u8e8d\u958b\u59cb\uff0c\u9010\u6f38\u589e\u52a0\u8ddd\u96e2\u3002\u4e00\u500b\u5f88\u597d\u7684\u4f8b\u5b50\u662f\u300e\u6559\u5b78\u5cf6\u300f\u95dc\u5361 - \u5728\u5617\u8a66\u4efb\u4f55\u9032\u968e\u52d5\u4f5c\u4e4b\u524d\uff0c\u5148\u7df4\u7fd2\u8de8\u8d8a\u9593\u9699\u3002\u60f3\u60f3\u770b\uff0c\u9019\u5c31\u50cf\u5b78\u7fd2\u9a0e\u81ea\u884c\u8eca\u4e00\u6a23\uff1b\u5f9e\u6162\u901f\u958b\u59cb\uff0c\u5efa\u7acb\u4fe1\u5fc3\u3002\u9ad4\u529b\u7ba1\u7406\u4e5f\u5f88\u91cd\u8981\uff0c\u56e0\u70ba\u904e\u5ea6\u6d88\u8017\u9ad4\u529b\u6703\u5c0e\u81f4\u7b28\u62d9\u7684\u8df3\u8e8d\u5617\u8a66\uff0c\u8acb\u8abf\u6574\u60a8\u7684\u904a\u6232\u4ee5\u9054\u5230\u6700\u4f73\u6548\u7387\u3002"}, {"question": "\u5728 Sky Mad \u7684\u65e9\u671f\u968e\u6bb5\uff0c\u6211\u61c9\u8a72\u6536\u96c6\u54ea\u4e9b\u8cc7\u6e90\uff0c\u70ba\u4ec0\u9ebc\u9019\u4e9b\u8cc7\u6e90\u5c0d\u6211\u7684\u521d\u59cb\u5347\u7d1a\u5982\u6b64\u91cd\u8981\uff0c\u5982\u679c\u6211\u662f\u65b0\u624b\uff1f", "answer": "\u5728 Sky Mad \u7684\u65e9\u671f\u968e\u6bb5\uff0c\u91cd\u9ede\u653e\u5728\u6536\u96c6\u300e\u788e\u7247\u300f\u548c\u300e\u7cbe\u83ef\u300f\u3002\u5b8c\u6210\u95dc\u5361\u5f8c\uff0c\u901a\u5e38\u6703\u5728\u60a8\u7d50\u675f\u4efb\u52d9\u7684\u7c21\u5831\u4e2d\u627e\u5230\u788e\u7247\u3002\u7cbe\u83ef\u53ef\u80fd\u9700\u8981\u66f4\u591a\u63a2\u7d22\uff0c\u60a8\u901a\u5e38\u53ef\u4ee5\u5728\u9760\u8fd1\u6311\u6230\u6027\u8df3\u8e8d\u7684\u5730\u65b9\u627e\u5230\u4e00\u5c0f\u7c07\u7cbe\u83ef\u3002\u788e\u7247\u662f\u5347\u7d1a\u8df3\u8e8d\u9ad8\u5ea6\u548c\u79fb\u52d5\u901f\u5ea6\u7684\u4e3b\u8981\u8ca8\u5e63\uff0c\u800c\u7cbe\u83ef\u5247\u8b93\u60a8\u89e3\u9396\u65b0\u7684\u79fb\u52d5\u6280\u80fd\uff0c\u4f8b\u5982\u300e\u7a7a\u4e2d\u885d\u523a\u300f\u3002\u521d\u59cb\u5347\u7d1a\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u65e9\u671f\u95dc\u5361\u523b\u610f\u5e73\u8861\u8a2d\u8a08\uff0c\u4ee5\u9f13\u52f5\u73a9\u5bb6\u8cfc\u8cb7\u5347\u7d1a\uff01\u9019\u662f\u4e00\u500b\u6f38\u9032\u7684\u63d0\u5347\uff0c\u4f46\u81f3\u95dc\u91cd\u8981\u3002\u65e9\u671f\u5347\u7d1a\u5c07\u6709\u52a9\u65bc\u60a8\u5b8c\u6210\u5f8c\u7e8c\u95dc\u5361\uff01"}, {"question": "Sky Mad\uff1a\u5728\u95dc\u5361\u9078\u64c7\u5668\u4e0a\u5217\u51fa\u7684\u300e\u8a66\u7149\u300f\u662f\u4ec0\u9ebc\uff0c\u5b83\u5011\u63d0\u4f9b\u54ea\u4e9b\u734e\u52f5\uff1f", "answer": "Sky Mad \u4e2d\u7684\u8a66\u7149\u662f\u6bcf\u500b\u95dc\u5361\u4e2d\u8a2d\u8a08\u7528\u65bc\u6e2c\u8a66\u60a8\u6280\u80fd\u7684\u7279\u6b8a\u6311\u6230\u3002\u9019\u4e9b\u6311\u6230\u53ef\u80fd\u5305\u62ec\u5728\u6642\u9593\u9650\u5236\u5167\u5b8c\u6210\u95dc\u5361\u3001\u6536\u96c6\u6240\u6709\u96b1\u85cf\u7684\u6536\u96c6\u54c1\u6216\u5728\u6c92\u6709\u6b7b\u4ea1\u7684\u60c5\u6cc1\u4e0b\u5b8c\u6210\u95dc\u5361\u3002\u5b8c\u6210\u8a66\u7149\u5c07\u7372\u5f97\u300e\u8a66\u7149\u4ee4\u724c\u300f\u3002\u8a66\u7149\u4ee4\u724c\u7528\u65bc\u89e3\u9396\u5916\u89c0\u5ba2\u88fd\u5316\u9078\u9805\uff0c\u4f8b\u5982\u65b0\u7684\u6ed1\u7fd4\u7ffc\u76ae\u819a\u548c\u89d2\u8272\u670d\u88dd\u3002\u4f8b\u5982\uff0c\u5b8c\u6210\u300e\u6c34\u6676\u6d1e\u7a74\u300f\u8a66\u7149\u6703\u89e3\u9396\u300e\u9ed1\u66dc\u77f3\u6ed1\u7fd4\u7ffc\u300f\u76ae\u819a\u3002\u9019\u4e9b\u70ba\u60a8\u7684\u89d2\u8272\u589e\u6dfb\u7368\u7279\u7684\u98a8\u683c\uff0c\u4e26\u8b93\u60a8\u53ef\u4ee5\u5c55\u793a\u60a8\u7684\u6280\u80fd\u3002\u9019\u5c31\u662f\u6211\u5011\u734e\u52f5\u7279\u5b9a\u95dc\u5361\u7684\u7cbe\u901a\u548c\u9f13\u52f5\u5b8c\u7f8e\u4e3b\u7fa9\u7684\u65b9\u5f0f\uff01"}, {"question": "\u8eab\u70ba\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\uff0c\u5728 Sky Mad \u4e2d\u5feb\u901f\u901a\u95dc\u7684\u6700\u6709\u6548\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f\u54ea\u4e9b\u6280\u80fd\u6a39\u6700\u91cd\u8981\uff0c\u54ea\u4e9b\u5340\u57df\u6700\u9069\u5408\u7bc0\u7701\u6642\u9593\uff1f", "answer": "\u5c0d\u65bc Sky Mad \u7684\u5feb\u901f\u901a\u95dc\uff0c\u6548\u7387\u81f3\u95dc\u91cd\u8981\u3002\u6b65\u9a5f 1\uff1a\u76e1\u65e9\u5c07\u300e\u52d5\u91cf\u300f\u6280\u80fd\u6a39\u63d0\u5347\u5230\u6700\u5927\u503c\uff1b\u5b83\u6703\u986f\u8457\u63d0\u9ad8\u60a8\u7684\u7a7a\u4e2d\u901f\u5ea6\u4e26\u5141\u8a31\u66f4\u5feb\u5730\u79fb\u52d5\u3002\u6b65\u9a5f 2\uff1a\u8a18\u4f4f\u95dc\u5361\u4f48\u5c40\u3002\u4e86\u89e3\u6700\u4f73\u8def\u5f91\u53ef\u4ee5\u7bc0\u7701\u5bf6\u8cb4\u7684\u6642\u9593\u3002\u6b65\u9a5f 3\uff1a\u5229\u7528\u300e\u7246\u58c1\u8e22\u64ca\u300f\u6a5f\u5236\u3002\u7246\u58c1\u8e22\u64ca\u5728\u7a7a\u4e2d\u6539\u8b8a\u65b9\u5411\u7684\u540c\u6642\uff0c\u4fdd\u6301\u60a8\u7684\u52d5\u91cf\u3002\u67d0\u4e9b\u5177\u6709\u9ad8\u6642\u9593\u7bc0\u7701\u6f5b\u529b\u7684\u7279\u5b9a\u5340\u57df\u5305\u62ec\uff1a\u300e\u901f\u5ea6\u810a\u300f\uff0c\u7cbe\u901a\u300e\u7246\u58c1\u8e22\u64ca\u300f\u6280\u5de7\u53ef\u4ee5\u5728\u9019\u88e1\u7bc0\u7701\u8fd1 3 \u79d2\u7684\u6642\u9593\u3002\u8acb\u6bd4\u8f03\u6a19\u6e96\u8def\u7dda\u548c\u5feb\u901f\u901a\u95dc\u73a9\u5bb6\u7684\u512a\u5316\u8def\u7dda\uff0c\u9019\u5c0d\u65bc\u7e2e\u77ed\u8017\u6642\u6beb\u79d2\u6578\u6709\u5f88\u5927\u5e6b\u52a9\u3002"}, {"question": "Sky Mad\uff1a\u70ba\u4ec0\u9ebc\u6211\u7684\u6ed1\u7fd4\u7ffc\u6709\u6642\u6703\u7121\u6cd5\u90e8\u7f72\uff0c\u5373\u4f7f\u6211\u6709\u8db3\u5920\u7684\u80fd\u91cf\uff1f\u6211\u8a72\u600e\u9ebc\u505a\u624d\u80fd\u78ba\u4fdd\u6ed1\u7fd4\u7ffc\u7684\u53ef\u9760\u90e8\u7f72\uff1f", "answer": "Sky Mad \u4e2d\u7684\u6ed1\u7fd4\u7ffc\u90e8\u7f72\u4f9d\u8cf4\u65bc\u80fd\u91cf\u548c\u52d5\u91cf\u7684\u7d50\u5408\u3002\u5982\u679c\u5176\u4e2d\u4e00\u500b\u6216\u5169\u500b\u503c\u904e\u4f4e\uff0c\u6ed1\u7fd4\u7ffc\u5c07\u7121\u6cd5\u90e8\u7f72\u3002\u5982\u679c\u6700\u8fd1\u4f7f\u7528\u904e\u7a7a\u4e2d\u885d\u523a\uff0c\u80fd\u91cf\u53ef\u80fd\u4e0d\u8db3\uff0c\u9019\u6703\u96a8\u8457\u6642\u9593\u91cd\u65b0\u5145\u96fb\u3002\u5982\u679c\u5728\u7a7a\u4e2d\u975c\u6b62\u4e0d\u52d5\u6216\u79fb\u52d5\u975e\u5e38\u7de9\u6162\uff0c\u52d5\u91cf\u4e5f\u53ef\u80fd\u4e0d\u8db3\u3002\u70ba\u4e86\u78ba\u4fdd\u6ed1\u7fd4\u7ffc\u7684\u53ef\u9760\u90e8\u7f72\uff0c\u8acb\u4fdd\u6301\u9069\u7576\u7684\u901f\u5ea6\u4e26\u4e14\u8b39\u614e\u5730\u4f7f\u7528\u7a7a\u4e2d\u885d\u523a\uff0c\u9019\u53ef\u4ee5\u78ba\u4fdd\u60a8\u7684\u80fd\u91cf\u6c34\u5e73\u4fdd\u6301\u826f\u597d\u72c0\u614b\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9e\u9ad8\u9ede\u4f7f\u7528\u7a7a\u4e2d\u885d\u523a\u8df3\u8e8d\uff0c\u60a8\u7684\u52d5\u91cf\u5c07\u6301\u7e8c\u4e0b\u53bb\uff0c\u4e26\u8b93\u60a8\u6210\u529f\u90e8\u7f72\u3002\u4ee5\u4e0b\u662f\u80fd\u91cf\u548c\u9ad4\u529b\u7684\u95dc\u4fc2\u8868\uff0c\u4ee5\u63d0\u4f9b\u5176\u95dc\u4fc2\u3002\n\u6ed1\u7fd4\u7ffc\u90e8\u7f72\uff1a\u80fd\u91cf\uff08\u226525%\uff09\u548c\u52d5\u91cf\uff08\u226550%\uff09\u3002\u5982\u679c\u9019\u4e9b\u689d\u4ef6\u6210\u7acb\uff0c\u5247\u53ef\u4ee5\u90e8\u7f72\uff1b\u5426\u5247\uff0c\u60a8\u5c07\u6703\u6389\u843d\u3002"}, {"question": "\u5728 Sky Mad \u4e2d\u5b8c\u6210\u6311\u6230\u6642\uff0c\u70ba\u4ec0\u9ebc\u7a4d\u5206\u7cfb\u7d71\u5982\u6b64\u91cd\u8981\uff1f", "answer": "Sky Mad \u4e2d\u7684\u7a4d\u5206\u7cfb\u7d71\u4e0d\u50c5\u50c5\u662f\u8a08\u5206\uff1b\u5b83\u76f4\u63a5\u5f71\u97ff\u60a8\u5b8c\u6210\u6311\u6230\u7684\u80fd\u529b\uff0c\u56e0\u70ba\u8f03\u9ad8\u7684\u5f97\u5206\u901a\u5e38\u8207\u89e3\u9396\u95dc\u9375\u5347\u7d1a\u3001\u80fd\u529b\uff0c\u6709\u6642\u751a\u81f3\u67d0\u4e9b\u95dc\u5361\u4e2d\u7684\u79d8\u5bc6\u5340\u57df\u76f8\u95dc\u3002\u7a4d\u5206\u6703\u6839\u64da\u73a9\u5bb6\u884c\u70ba\u4e0d\u540c\uff0c\u4f9d\u7167\u4e0d\u540c\u60c5\u6cc1\u800c\u7372\u5f97\u3002\u4ee5\u4e0b\u662f\u6240\u6709\u7a4d\u5206\u7372\u5f97\u65b9\u5f0f\u7684\u6e05\u55ae\uff1a\n\u666e\u901a\u8df3\u8e8d\u2014\u20145 \u5206\n\u7a7a\u4e2d\u8abf\u6574\u2014\u201410 \u5206\n\u64ca\u6557\u6575\u4eba\u2014\u201420 \u5206 + \u96e3\u6613\u5ea6\u4e58\u6578\n\u7246\u58c1\u8df3\u8e8d\u2014\u201415 \u5206\n\u7a7a\u4e2d\u9583\u907f\u2014\u201420 \u5206\n\u6210\u529f\u7684\u6ed1\u7fd4\u7ffc\u767c\u5c04\u2014\u201425 \u5206\n\u6536\u96c6\u54c1\u2014\u2014\u5dee\u7570\n\u95dc\u5361\u5b8c\u6210\u2014\u2014100 \u5206 + \u96e3\u6613\u5ea6\u4e58\u6578 + \u5b8c\u6210\u7279\u6b8a\u76ee\u6a19\u3002\n\u4f8b\u5982\uff0c\u5728\u300e\u907a\u5fd8\u4e4b\u57ce\u300f\u6311\u6230\u4e2d\uff0c\u9054\u5230 5000 \u5206\u4ee5\u4e0a\u7684\u5f97\u5206\u5c07\u89e3\u9396\u4e00\u689d\u539f\u672c\u7121\u6cd5\u5230\u9054\u7684\u8def\u5f91\uff0c\u4e26\u8b93\u60a8\u7372\u5f97\u4e00\u500b\u8207\u8df3\u8e8d\u9ad8\u5ea6\u76f8\u95dc\u3001\u8207\u540c\u5115\u76f8\u6bd4\u986f\u8457\u63d0\u5347\u7684\u95dc\u9375\u5347\u7d1a\u3002\u5982\u679c\u7a4d\u5206\u4e0d\u8db3\uff0c\u60a8\u5c07\u7121\u6cd5\u5b8c\u6210\u6311\u6230\u3002"}, {"question": "Sky Mad \u4e2d\uff0cSky Mad \u6b66\u5668\u4e4b\u9593\u7684\u6578\u503c\u50b7\u5bb3\u5dee\u7570\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u54ea\u4e9b\u72c0\u614b\u52a0\u6210\u6703\u5f71\u97ff\u6b66\u5668\u7684\u6574\u9ad4\u50b7\u5bb3\uff1f", "answer": "Sky Mad \u4e2d\u7684\u6bcf\u7a2e\u6b66\u5668\u90fd\u5177\u6709\u7368\u7279\u7684\u50b7\u5bb3\u503c\uff0c\u6703\u53d7\u5230\u72c0\u614b\u52a0\u6210\u7684\u5f71\u97ff\u3002\u4f8b\u5982\uff0c\u300e\u7b49\u96e2\u5b50\u69cd\u300f\u7684\u57fa\u790e\u50b7\u5bb3\u70ba 50\uff0c\u800c\u300e\u5f27\u5f62\u70ae\u300f\u7684\u57fa\u790e\u50b7\u5bb3\u70ba 80\uff0c\u4f46\u5c04\u901f\u8f03\u6162\u3002\u72c0\u614b\u52a0\u6210\u6703\u986f\u8457\u5f71\u97ff\u6b66\u5668\u3002\u300e\u529b\u91cf\u300f\u6703\u5c07\u57fa\u790e\u50b7\u5bb3\u589e\u52a0 1%\uff08\u6bcf\u9ede\uff09\uff0c\u800c\u300e\u654f\u6377\u300f\u5247\u6703\u63d0\u9ad8\u5c04\u901f 2%\uff08\u6bcf\u9ede\uff09\u3002\u4e00\u7a2e\u826f\u597d\u7684\u88dd\u5099\u53ef\u80fd\u8457\u91cd\u5728\u50b7\u5bb3\u548c\u529b\u91cf\uff0c\u4ee5\u5be6\u73fe\u504f\u5411\u7206\u767c\u50b7\u5bb3\u7684\u88dd\u5099\u3002\u6216\u8005\uff0c\u60a8\u53ef\u4ee5\u5c08\u6ce8\u65bc\u654f\u6377\uff0c\u4ee5\u6700\u5927\u5316\u5c04\u901f\u548c DPS \u8f38\u51fa\u3002\u9019\u53d6\u6c7a\u65bc\u73a9\u5bb6\u7684\u504f\u597d\u3002"}, {"question": "Sky Mad\uff1a\u9664\u4e86\u5716\u5f62\u4e4b\u5916\uff0c\u5728 PC \u548c\u624b\u6a5f\u4e0a\u73a9\u6642\uff0c\u6709\u54ea\u4e9b\u6838\u5fc3\u904a\u6232\u73a9\u6cd5\u5dee\u7570\u548c\u512a\u52e2\uff0c\u5c24\u5176\u662f\u5728\u8003\u616e\u5230\u63a7\u5236\u65b9\u9762\uff1f", "answer": "PC \u548c\u624b\u6a5f\u4e0a\u7684\u6838\u5fc3\u904a\u6232\u73a9\u6cd5\u5927\u591a\u76f8\u540c\u3002\u4e0d\u904e\uff0cPC \u5728\u63a7\u5236\u7cbe\u78ba\u5ea6\u548c\u5716\u5f62\u4fdd\u771f\u5ea6\u65b9\u9762\u5177\u6709\u512a\u52e2\u3002PC \u7248\u672c\u652f\u63f4\u9375\u76e4\u6ed1\u9f20\u6216\u63a7\u5236\u5668\uff0c\u5141\u8a31\u7cbe\u78ba\u7684\u79fb\u52d5\u548c\u7784\u6e96\uff0c\u5c24\u5176\u662f\u5728\u9700\u8981\u9023\u7e8c\u9032\u884c\u591a\u500b\u7246\u58c1\u8df3\u8e8d\u6642\u3002\u624b\u6a5f\u7248\u672c\u5247\u4f9d\u8cf4\u89f8\u63a7\u87a2\u5e55\u63a7\u5236\uff0c\u5c0d\u65bc\u8907\u96dc\u7684\u52d5\u4f5c\uff0c\u6e96\u78ba\u5ea6\u53ef\u80fd\u8f03\u4f4e\u3002\u624b\u6a5f\u7248\u672c\u53ef\u80fd\u9047\u5230\u7684\u554f\u984c\u662f\u87a2\u5e55\u7a7a\u9593\u4e0d\u8db3\uff0c\u4ee5\u53ca\u4e0d\u5c0f\u5fc3\u89f8\u78b0\u5230\u8207\u60a8\u60f3\u8981\u4f7f\u7528\u7684\u89f8\u63a7\u63a7\u5236\u76f8\u9130\u7684\u89f8\u63a7\u63a7\u5236\u3002\u60f3\u50cf\u4e00\u4e0b\uff0c\u7528\u7cbe\u7d30\u7b46\u5c16\u7684\u7b46\uff08PC\uff09\u7e6a\u5716\uff0c\u8207\u881f\u7b46\uff08\u624b\u6a5f\uff09\u7e6a\u5716\u3002PC \u7684\u66f4\u5927\u87a2\u5e55\u548c\u984d\u5916\u8655\u7406\u80fd\u529b\uff0c\u4e5f\u5c0e\u81f4\u5716\u5f62\u8868\u73fe\u66f4\u4f73\uff0c\u8868\u793a\u63d0\u5347\u7684\u756b\u683c\u7387\u548c\u8996\u89ba\u7d30\u7bc0\u3002"}, {"question": "Sky Mad\uff1a\u6211\u77e5\u9053\u6709\u4e9b\u73a9\u5bb6\u907a\u5931\u4e86\u9032\u5ea6\u3002\u5e73\u53f0\u4e4b\u9593\u662f\u5426\u6709\u8de8\u5e73\u53f0\u5e33\u6236\u540c\u6b65\uff0c\u4ee5\u53ca\u6211\u5982\u4f55\u78ba\u4fdd\u6211\u7684\u9032\u5ea6\u80fd\u5728\u4e0d\u540c\u88dd\u7f6e\u4e4b\u9593\u4fdd\u5b58\uff0c\u4ee5\u514d\u767c\u751f\u9019\u7a2e\u60c5\u6cc1\uff1f", "answer": "Sky Mad \u652f\u63f4\u8de8\u5e73\u53f0\u5e33\u6236\u540c\u6b65\uff01\u70ba\u78ba\u4fdd\u60a8\u7684\u9032\u5ea6\u5df2\u4fdd\u5b58\uff0c\u8acb\u5efa\u7acb\u5e33\u6236\u3002\u60a8\u5fc5\u9808\u63d0\u4f9b\u53ef\u7372\u53d6\u7684\u96fb\u5b50\u90f5\u4ef6\u5730\u5740\u4e26\u63d0\u4f9b\u5b89\u5168\u7684\u5bc6\u78bc\u4f86\u4fdd\u8b77\u60a8\u7684\u5e33\u6236\u3002\u5b8c\u6210\u5f8c\uff0c\u60a8\u9700\u8981\u900f\u904e\u904a\u6232\u8a2d\u5b9a\u9078\u55ae\u7a4d\u6975\u555f\u7528\u96f2\u7aef\u5132\u5b58\u3002\u555f\u7528\u5f8c\uff0c\u60a8\u7684\u9032\u5ea6\u5c07\u6703\u81ea\u52d5\u540c\u6b65\u5230\u4e0d\u540c\u88dd\u7f6e\u3002\u4e00\u500b\u826f\u597d\u7684\u5b89\u5168\u63aa\u65bd\u662f\u624b\u52d5\u5099\u4efd\u60a8\u7684\u672c\u5730\u5132\u5b58\u6a94\u6848\uff0c\u5b83\u901a\u5e38\u4f4d\u65bc\u60a8\u7684\u6587\u4ef6\u8cc7\u6599\u593e\u4e2d\u7684\u300eSkyMad\u300f\u76ee\u9304\u4e0b\uff0c\u4f5c\u70ba\u5b89\u5168\u63aa\u65bd\u3002\u5982\u679c\u96f2\u7aef\u5132\u5b58\u767c\u751f\u6545\u969c\u6216\u5e33\u6236\u51fa\u73fe\u554f\u984c\uff0c\u9019\u662f\u4e00\u500b\u6709\u7528\u7684\u5b89\u5168\u9078\u9805\u3002"}, {"question": "Sky Mad \u4e2d\uff0c\u5728\u591a\u500b\u95dc\u5361\u4e2d\u767c\u73fe\u7684\u5de8\u5927\u96d5\u50cf\u80cc\u5f8c\u7684\u6545\u4e8b\u662f\u4ec0\u9ebc\uff1f\u5b83\u5011\u662f\u5426\u6703\u70ba\u5b8c\u6210\u4efb\u52d9\u7684\u73a9\u5bb6\u89e3\u9396\u4efb\u4f55\u96b1\u85cf\u5340\u57df\u6216\u734e\u52f5\uff1f", "answer": "Sky Mad \u4e2d\u7684\u5de8\u5927\u96d5\u50cf\u4ee3\u8868\u8457\u300e\u5efa\u7bc9\u5e2b\u300f\uff0c\u4e00\u500b\u5851\u9020\u8457\u6f02\u6d6e\u5cf6\u5dbc\u7684\u53e4\u4ee3\u6587\u660e\u3002\u53ea\u6709\u9577\u671f\u73a9\u5bb6\u624d\u80fd\u770b\u5230\u7684\u6771\u897f\u662f\uff1a\u900f\u904e\u555f\u52d5\u591a\u500b\u95dc\u5361\u4e2d\u7684\u96b1\u85cf\u80fd\u91cf\u4f86\u6e90\uff0c\u60a8\u53ef\u4ee5\u6062\u5fa9\u96d5\u50cf\u7684\u96fb\u529b\u3002\u555f\u52d5\u6240\u6709\u96d5\u50cf\u5c07\u89e3\u9396\u4e00\u500b\u540d\u70ba\u300e\u5efa\u7bc9\u5e2b\u4e4b\u8def\u300f\u7684\u96b1\u85cf\u95dc\u5361\u3002\u5b8c\u6210\u6b64\u95dc\u5361\u5c07\u7372\u5f97\u300e\u5efa\u7bc9\u5e2b\u4e4b\u5203\u300f\uff0c\u9019\u662f\u4e00\u628a\u5177\u6709\u7279\u6b8a\u5c6c\u6027\u7684\u7368\u7279\u6b66\u5668\uff0c\u5728\u5176\u4ed6\u4efb\u4f55\u5730\u65b9\u90fd\u7121\u6cd5\u7372\u5f97\u3002\u95dc\u65bc\u5b83\u5011\u7684\u5275\u4f5c\u6545\u4e8b\uff0c\u53ef\u4ee5\u5728\u904a\u6232\u4e2d\u900f\u904e\u653e\u7f6e\u5728\u96d5\u50cf\u9644\u8fd1\u5177\u6709\u97f3\u8a0a\u65e5\u8a8c\u7684\u6536\u96c6\u54c1\u627e\u5230\u3002\u82b1\u8cbb\u4e00\u4e9b\u6642\u9593\u5c0b\u627e\u6240\u6709\u7247\u6bb5\u53ef\u80fd\u5f88\u56f0\u96e3\u3002\u60a8\u9700\u8981\u82b1\u6642\u9593\u5b8c\u6210\u95dc\u5361\uff0c\u624d\u80fd\u89e3\u9396\u5c0d\u6b64\u79d8\u5bc6\u7684\u8a2a\u554f\u3002"}]
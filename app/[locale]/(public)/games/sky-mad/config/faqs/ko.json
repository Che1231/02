[{"question": "Sky Mad: \uc800\ub294 \uae30\ubcf8 \uc810\ud504\ub97c \uc5b4\ub5bb\uac8c \uc218\ud589\ud558\uba70, \uc2dc\uc791 \uc2dc \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub5a8\uc5b4\uc9c0\ub294 \uac83\uc744 \ud53c\ud558\ub294 \ucd5c\uc120\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sky Mad\uc5d0\uc11c \uc810\ud504\ub294 \ud544\uc218\uc801\uc785\ub2c8\ub2e4! \uc2a4\ud398\uc774\uc2a4\ubc14(\ub610\ub294 \ucee8\ud2b8\ub864\ub7ec\uc758 \uc9c0\uc815\ub41c \uc810\ud504 \ubc84\ud2bc)\ub97c \ub20c\ub7ec \uc810\ud504\ud558\uc2ed\uc2dc\uc624. \ub5a8\uc5b4\uc9c0\ub294 \uac83\uc744 \ud53c\ud558\ub824\uba74 \ud50c\ub7ab\ud3fc \uac00\uc7a5\uc790\ub9ac\ub97c \uc8fc\uc758 \uae4a\uac8c \uc0b4\ud3b4\ubcf4\uc138\uc694. \uc9e7\uc740 \uc810\ud504\ub85c \uc2dc\uc791\ud558\uc5ec \uc810\ucc28 \uac70\ub9ac\ub97c \ub298\ub9ac\uc138\uc694. \uc88b\uc740 \uc608\ub294 '\ud29c\ud1a0\ub9ac\uc5bc \uc12c' \ub808\ubca8\uc785\ub2c8\ub2e4. \uace0\uae09 \ub3d9\uc791\uc744 \uc2dc\ub3c4\ud558\uae30 \uc804\uc5d0 \uac04\uadf9\uc744 \uac74\ub108 \uc810\ud504 \uc5f0\uc2b5\uc744 \ud558\uc138\uc694. \uc790\uc804\uac70 \ud0c0\ub294 \ubc95\uc744 \ubc30\uc6b0\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ucc9c\ucc9c\ud788 \uc2dc\uc791\ud558\uc5ec \uc790\uc2e0\uac10\uc744 \uc313\uc73c\uc138\uc694. \uc9c0\ub098\uce5c \ub178\ub825\uc740 \uc11c\ud22c\ub978 \uc810\ud504 \uc2dc\ub3c4\ub85c \uc774\uc5b4\uc9c8 \uc218 \uc788\uc73c\ubbc0\ub85c \ucd5c\ub300 \ud6a8\uc728\uc744 \uc704\ud574 \ud50c\ub808\uc774\ub97c \uc870\uc815\ud558\uc2ed\uc2dc\uc624."}, {"question": "Sky Mad\uc5d0\uc11c \ucd08\ubc18\uc5d0 \uc5b4\ub5a4 \uc790\uc6d0\uc744 \uc218\uc9d1\ud574\uc57c \ud558\uba70, \uc0c8\ub85c \uc2dc\uc791\ud558\ub294 \uacbd\uc6b0 \ucd08\uae30 \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sky Mad \ucd08\ubc18\uc5d0\ub294 '\ud30c\ud3b8'\uacfc '\uc5d0\uc13c\uc2a4'\ub97c \ubaa8\uc73c\ub294 \ub370 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \ud30c\ud3b8\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \ub808\ubca8\uc744 \uc644\ub8cc\ud55c \ud6c4 \uc5bb\uc744 \uc218 \uc788\uc73c\uba70, \ucd5c\uc885 \uc784\ubb34 \ube0c\ub9ac\ud551\uc5d0\uc11c \ud45c\uc2dc\ub429\ub2c8\ub2e4. \uc5d0\uc13c\uc2a4\ub294 \uc870\uae08 \ub354 \ud0d0\ud5d8\uc774 \ud544\uc694\ud558\uba70, \uc885\uc885 \uc5b4\ub824\uc6b4 \uc810\ud504 \uadfc\ucc98\uc5d0 \uc228\uaca8\uc9c4 \uc791\uc740 \uc5d0\uc13c\uc2a4 \ub369\uc5b4\ub9ac\ub97c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud30c\ud3b8\uc740 \uc810\ud504 \ub192\uc774\uc640 \uc774\ub3d9 \uc18d\ub3c4\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \uc8fc\uc694 \ud1b5\ud654\uc774\uace0, \uc5d0\uc13c\uc2a4\ub294 '\uc5d0\uc5b4 \ub300\uc2dc'\uc640 \uac19\uc740 \uc0c8\ub85c\uc6b4 \uc774\ub3d9 \uae30\uc220\uc744 \ud574\uc81c\ud569\ub2c8\ub2e4. \ucd08\uae30 \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \uc911\uc694\ud569\ub2c8\ub2e4. \ucd08\ubc18 \ub808\ubca8\uc740 \uc758\ub3c4\uc801\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc \uad6c\ub9e4\ub97c \uc7a5\ub824\ud558\ub3c4\ub85d \uade0\ud615\uc774 \ub9de\ucdb0\uc838 \uc788\uc2b5\ub2c8\ub2e4. \uc11c\uc11c\ud788 \uc0c1\uc2b9\ud558\uc9c0\ub9cc \uc911\uc694\ud569\ub2c8\ub2e4. \ucd08\uae30 \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \ud6c4\ubc18 \ub808\ubca8\uc5d0\uc11c \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4!"}, {"question": "Sky Mad: \ub808\ubca8 \uc120\ud0dd\uae30\uc5d0 \ub098\uc5f4\ub41c '\uc2dc\ub828'\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5a4 \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud569\ub2c8\uae4c?", "answer": "Sky Mad\uc758 \uc2dc\ub828\uc740 \uac01 \ub808\ubca8 \ub0b4\uc5d0\uc11c \uae30\uc220\uc744 \ud14c\uc2a4\ud2b8\ud558\ub3c4\ub85d \uc124\uacc4\ub41c \ud2b9\ubcc4\ud55c \ub3c4\uc804\uc785\ub2c8\ub2e4. \uc774\ub294 \uc2dc\uac04 \uc81c\ud55c \ub0b4\uc5d0 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uac70\ub098 \ubaa8\ub4e0 \uc228\uaca8\uc9c4 \uc218\uc9d1\ud488\uc744 \uc218\uc9d1\ud558\uac70\ub098 \uc0ac\ub9dd \uc5c6\uc774 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\ub294 \uac83\uc744 \ud3ec\ud568\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2dc\ub828\uc744 \uc644\ub8cc\ud558\uba74 '\uc2dc\ub828 \ud1a0\ud070'\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2dc\ub828 \ud1a0\ud070\uc740 \uc0c8\ub85c\uc6b4 \uae00\ub77c\uc774\ub354 \uc2a4\ud0a8 \ubc0f \uce90\ub9ad\ud130 \uc758\uc0c1\uacfc \uac19\uc740 \ubbf8\uc801 \ub9de\ucda4 \uc635\uc158\uc744 \ud574\uc81c\ud558\ub294 \ub370 \uc0ac\uc6a9\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud06c\ub9ac\uc2a4\ud0c8 \ub3d9\uad74' \uc2dc\ub828\uc744 \uc644\ub8cc\ud558\uba74 '\ud751\uc694\uc11d \uae00\ub77c\uc774\ub354' \uc2a4\ud0a8\uc744 \ud574\uc81c\ud569\ub2c8\ub2e4. \uc774\uac83\uc740 \uce90\ub9ad\ud130\uc5d0 \ub3c5\ud2b9\ud55c \ub9e4\ub825\uc744 \ub354\ud558\uace0 \uadc0\ud558\uc758 \uae30\uc220\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4. \uc774\uac83\uc740 \ud2b9\uc815 \ub808\ubca8\uc5d0 \ub300\ud55c \uc219\ub2ec\uacfc \uc644\ubcbd\uc8fc\uc758\ub97c \ubcf4\uc0c1\ud558\ub294 \ubc29\ubc95\uc785\ub2c8\ub2e4!"}, {"question": "\uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\ub85c\uc11c Sky Mad\ub97c \uc2a4\ud53c\ub4dc\ub7f0\ud558\ub294 \uac00\uc7a5 \ud6a8\uc728\uc801\uc778 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c? \uc5b4\ub5a4 \uc2a4\ud0ac \ud2b8\ub9ac\uac00 \uac00\uc7a5 \uc911\uc694\ud558\uba70, \uc5b4\ub5a4 \uc9c0\uc5ed\uc5d0\uc11c \uc2dc\uac04\uc744 \uac00\uc7a5 \ub9ce\uc774 \uc808\uc57d\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Sky Mad \uc2a4\ud53c\ub4dc\ub7f0\uc744 \uc704\ud574\uc11c\ub294 \ud6a8\uc728\uc131\uc774 \ubaa8\ub4e0 \uac83\uc744 \ub9d0\ud569\ub2c8\ub2e4. STEP 1: '\ubaa8\uba58\ud140' \uc2a4\ud0ac \ud2b8\ub9ac\ub97c \ucd08\uae30\uc5d0 \ucd5c\ub300\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc5ec \uacf5\uc911 \uc18d\ub3c4\ub97c \ud06c\uac8c \ub192\uc774\uace0 \ub354 \ube60\ub974\uac8c \uc774\ub3d9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP 2: \ub808\ubca8 \ub808\uc774\uc544\uc6c3\uc744 \uc219\uc9c0\ud558\uc2ed\uc2dc\uc624. \ucd5c\uc801\uc758 \uacbd\ub85c\ub97c \uc54c\uba74 \uadc0\uc911\ud55c \uc2dc\uac04\uc744 \uc808\uc57d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP 3: '\ubcbd \ud0a5' \uba54\ucee4\ub2c8\uc998\uc744 \ud65c\uc6a9\ud558\uc2ed\uc2dc\uc624. \ubcbd \ud0a5\uc740 \uacf5\uc911\uc5d0\uc11c \ubc29\ud5a5\uc744 \ubc14\uafb8\uba74\uc11c \ubaa8\uba58\ud140\uc744 \uc720\uc9c0\ud569\ub2c8\ub2e4. \uc2dc\uac04 \uc808\uc57d \uc7a0\uc7ac\ub825\uc774 \ub192\uc740 \ud2b9\uc815 \uc9c0\uc5ed\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. '\ubca8\ub85c\uc2dc\ud2f0 \ub9bf\uc9c0'\uc5d0\uc11c '\ubcbd \ud0a5' \uae30\uc220\uc744 \uc219\ub2ec\ud558\uba74 \uac70\uc758 3\ucd08\ub97c \uc808\uc57d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud45c\uc900 \uacbd\ub85c\ub97c \uc2a4\ud53c\ub4dc \ub7f0\ub108\uc758 \ucd5c\uc801\ud654\ub41c \uacbd\ub85c\uc640 \ube44\uad50\ud574 \ubcf4\uc138\uc694. \uc774\uac83\uc740 \uad00\ub828 \ubc00\ub9ac\ucd08\ub97c \uc904\uc774\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Sky Mad\uc5d0\uc11c \uae00\ub77c\uc774\ub354\uac00 \uc5d0\ub108\uc9c0\uac00 \ucda9\ubd84\ud55c\ub370\ub3c4 \ub54c\ub54c\ub85c \ubc30\uce58\ub418\uc9c0 \uc54a\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc548\uc815\uc801\uc778 \uae00\ub77c\uc774\ub354 \ubc30\uce58\ub97c \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 \ubb34\uc5c7\uc744 \ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Sky Mad\uc758 \uae00\ub77c\uc774\ub354 \ubc30\uce58\ub294 \uc5d0\ub108\uc9c0\uc640 \ubaa8\uba58\ud140\uc758 \uc870\ud569\uc5d0 \ub530\ub77c \uacb0\uc815\ub429\ub2c8\ub2e4. \uae00\ub77c\uc774\ub354\uac00 \ubc30\uce58\ub418\uc9c0 \uc54a\ub294 \uac83\uc740 \uc5d0\ub108\uc9c0 \ub610\ub294 \ubaa8\uba58\ud140 \uc911 \ud558\ub098 \ub610\ub294 \ub458 \ub2e4\uac00 \ub108\ubb34 \ub0ae\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc5d0\ub108\uc9c0\uac00 \ub0ae\uc740 \uac83\uc740 \ucd5c\uadfc\uc5d0 \uc5d0\uc5b4 \ub300\uc2dc\ub97c \uc0ac\uc6a9\ud588\uae30 \ub54c\ubb38\uc77c \uc218 \uc788\uc73c\uba70, \uc2dc\uac04\uc774 \uc9c0\ub0a8\uc5d0 \ub530\ub77c \ub2e4\uc2dc \ucda9\uc804\ub429\ub2c8\ub2e4. \ubaa8\uba58\ud140\uc774 \ub0ae\uc740 \uac83\uc740 \uacf5\uc911 \uc815\uc9c0 \uc0c1\ud0dc\uc774\uac70\ub098 \ub9e4\uc6b0 \ub290\ub9ac\uac8c \uc6c0\uc9c1\uc774\uace0 \uc788\uae30 \ub54c\ubb38\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc548\uc815\uc801\uc778 \uae00\ub77c\uc774\ub354 \ubc30\uce58\ub97c \ubcf4\uc7a5\ud558\ub824\uba74 \uc801\uc808\ud55c \uc18d\ub3c4\ub97c \uc720\uc9c0\ud558\uace0 \uc5d0\uc5b4 \ub300\uc2dc\ub97c \uc2e0\uc911\ud558\uac8c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \uc774\ub294 \uc5d0\ub108\uc9c0 \uc218\uc900\uc774 \uac74\uac15\ud558\uac8c \uc720\uc9c0\ub418\ub294 \uac83\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5d0\uc5b4 \ub300\uc2dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub192\uc740 \uc9c0\uc810\uc5d0\uc11c \uc810\ud504\ud558\uba74 \ubaa8\uba58\ud140\uc774 \uc774\uc5b4\uc838 \uc131\uacf5\uc801\uc73c\ub85c \ubc30\uce58\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc5d0\ub108\uc9c0\uc640 \uccb4\ub825\uc758 \uad00\uacc4\ub97c \uc81c\uacf5\ud558\ub294 \uc544\ub798\uc758 \uad00\uacc4\ud45c\ub97c \ucc38\uace0\ud558\uc2ed\uc2dc\uc624. \n \uae00\ub77c\uc774\ub354 \ubc30\uce58: \uc5d0\ub108\uc9c0(\u226525%) && \ubaa8\uba58\ud140(\u226550%). \uc774\uac83\uc774 \uc720\uc9c0\ub418\uba74 \ubc30\uce58\ub429\ub2c8\ub2e4. \uadf8\ub807\uc9c0 \uc54a\uc73c\uba74 \ub5a8\uc5b4\uc9d1\ub2c8\ub2e4."}, {"question": "Sky Mad\uc5d0\uc11c \uc810\uc218 \uc2dc\uc2a4\ud15c\uc774 \ub3c4\uc804 \uacfc\uc81c\ub97c \uc644\ub8cc\ud558\ub294 \ub370 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sky Mad\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ub2e8\uc21c\ud55c \uc810\uc218 \uacc4\uc0b0 \uc774\uc0c1\uc758 \uc758\ubbf8\ub97c \uc9c0\ub2d9\ub2c8\ub2e4. \ub354 \ub192\uc740 \uc810\uc218\ub294 \uc77c\ubc18\uc801\uc73c\ub85c \uc8fc\uc694 \uc5c5\uadf8\ub808\uc774\ub4dc, \ub2a5\ub825, \ub54c\ub85c\ub294 \ud2b9\uc815 \ub808\ubca8 \ub0b4\uc758 \ube44\ubc00 \uc601\uc5ed\uc744 \ud574\uc81c\ud558\ub294 \uac83\uacfc \uc9c1\uc811\uc801\uc73c\ub85c \uc5f0\uad00\ub418\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\uac00 \uc218\ud589\ud558\ub294 \ubaa8\ub4e0 \uc885\ub958\uc758 \ud589\ub3d9\uc5d0 \ub300\ud574 \uc810\uc218\uac00 \ubd80\uc5ec\ub429\ub2c8\ub2e4. \uc544\ub798\ub294 \ubaa8\ub4e0 \ud56d\ubaa9\uc758 \ubaa9\ub85d\uc785\ub2c8\ub2e4:\n\uc77c\ubc18 \uc810\ud504--5\uc810\n\uacf5\uc911 \uc870\uc815--10\uc810\n\uc801 \ucc98\uce58--20\uc810+\ub09c\uc774\ub3c4 \uac00\uc911\uce58\n\ubcbd \uc810\ud504--15\uc810\n\uacf5\uc911 \ud68c\ud53c--20\uc810\n\uc131\uacf5\uc801\uc778 \uae00\ub77c\uc774\ub354 \ubc1c\uc0ac--25\uc810\n\uc218\uc9d1\ud488--\ub2e4\uc591\ud568\n\ub808\ubca8 \uc644\ub8cc--100\uc810 + \ub09c\uc774\ub3c4 \uac00\uc911\uce58+\ud2b9\ubcc4 \ubaa9\ud45c \uc644\ub8cc.\n\uc608\ub97c \ub4e4\uc5b4, '\uc78a\ud600\uc9c4 \ub3c4\uc2dc' \ucc4c\ub9b0\uc9c0\uc5d0\uc11c \uc810\uc218\uac00 5000\uc810 \uc774\uc0c1\uc774\uba74 \uadf8\ub807\uc9c0 \uc54a\uc73c\uba74 \ub3c4\ub2ec\ud560 \uc218 \uc5c6\ub294 \uacbd\ub85c\ub97c \ud574\uc81c\ud558\uace0 \ub3d9\uc2dc\uc5d0 \ub3d9\ub8cc\ubcf4\ub2e4 \ub354 \ub192\uc774 \uc810\ud504\ud560 \uc218 \uc788\ub294 \uc8fc\uc694 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \ubd80\uc5ec\ud569\ub2c8\ub2e4. \ucda9\ubd84\ud55c \uc810\uc218\ub97c \uc5bb\uc9c0 \ubabb\ud558\uba74 \uc2e4\ud328\ud560 \uac83\uc785\ub2c8\ub2e4."}, {"question": "Sky Mad \ubb34\uae30\uc758 \uc218\uce58\uc801 \ub370\ubbf8\uc9c0 \ucc28\uc774\uc640 \ubb34\uae30\uc758 \uc804\uccb4 \ub370\ubbf8\uc9c0\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \ud1b5\uacc4 \ubc84\ud504\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sky Mad\uc758 \uac01 \ubb34\uae30\ub294 \ud1b5\uacc4 \ubc84\ud504\uc5d0 \uc601\ud5a5\uc744 \ubc1b\ub294 \uace0\uc720\ud55c \ub370\ubbf8\uc9c0 \uac12\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. '\ud50c\ub77c\uc988\ub9c8 \ub77c\uc774\ud50c'\uc740 \uae30\ubcf8 \ub370\ubbf8\uc9c0\uac00 50\uc774\uace0, '\uc544\ud06c \uce90\ub17c'\uc740 80\uc774\uc9c0\ub9cc \ubc1c\uc0ac \uc18d\ub3c4\uac00 \ub290\ub9bd\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud1b5\uacc4 \ubc84\ud504\ub294 \ubb34\uae30\uc5d0 \uc0c1\ub2f9\ud55c \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. '\ud798'\uc740 \uac01 \uc810\ub2f9 \uae30\ubcf8 \ub370\ubbf8\uc9c0\ub97c 1% \uc99d\uac00\uc2dc\ud0a4\uace0, '\ubbfc\ucca9\uc131'\uc740 \uac01 \uc810\ub2f9 \ubc1c\uc0ac \uc18d\ub3c4\ub97c 2% \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4. \uc88b\uc740 \ube4c\ub4dc\ub294 \ud3ed\ubc1c\uc801\uc778 \ub370\ubbf8\uc9c0\ub97c \uc120\ud638\ud558\ub294 \ube4c\ub4dc\ub97c \uc704\ud574 \ub370\ubbf8\uc9c0\uc640 \ud798\uc5d0 \uc9d1\uc911\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \ubc29\ubc95\uc740 \ubbfc\ucca9\uc131\uc5d0 \uc9d1\uc911\ud558\uc5ec \ubc1c\uc0ac \uc18d\ub3c4\uc640 DPS \ucd9c\ub825\uc744 \uadf9\ub300\ud654\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc774\ub294 \ud50c\ub808\uc774\uc5b4\uc758 \uae30\ud638\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4."}, {"question": "Sky Mad: \uadf8\ub798\ud53d \uc678\uc5d0 PC\uc640 \ubaa8\ubc14\uc77c\uc5d0\uc11c\uc758 \ud575\uc2ec \uac8c\uc784\ud50c\ub808\uc774 \ucc28\uc774\uc810\uacfc \uc7a5\uc810\uc740 \ubb34\uc5c7\uc774\uba70, \ud2b9\ud788 \ucee8\ud2b8\ub864\uc744 \uace0\ub824\ud560 \ub54c\ub294 \uc5b4\ub5a4 \uc810\uc774 \ub2e4\ub985\ub2c8\uae4c?", "answer": "PC\uc640 \ubaa8\ubc14\uc77c\uc758 \ud575\uc2ec \uac8c\uc784\ud50c\ub808\uc774\ub294 \ub300\ubd80\ubd84 \uac19\uc2b5\ub2c8\ub2e4. \ud558\uc9c0\ub9cc PC\ub294 \ucee8\ud2b8\ub864 \uc815\ud655\ub3c4\uc640 \uadf8\ub798\ud53d \ud574\uc0c1\ub3c4\uc5d0\uc11c \uc7a5\uc810\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. PC \ubc84\uc804\uc5d0\uc11c\ub294 \ud0a4\ubcf4\ub4dc\uc640 \ub9c8\uc6b0\uc2a4 \ub610\ub294 \ucee8\ud2b8\ub864\ub7ec\ub97c \uc9c0\uc6d0\ud558\uc5ec \ud2b9\ud788 \uc5f0\uc18d\uc73c\ub85c \uc5ec\ub7ec \ubcbd \uc810\ud504\ub97c \uc218\ud589\ud574\uc57c \ud558\ub294 \uacbd\uc6b0 \uc815\ud655\ud55c \uc774\ub3d9 \ubc0f \uc870\uc900\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4. \ubaa8\ubc14\uc77c \ubc84\uc804\uc740 \ud130\uce58\uc2a4\ud06c\ub9b0 \ucee8\ud2b8\ub864\uc5d0 \uc758\uc874\ud558\uae30 \ub54c\ubb38\uc5d0 \ubcf5\uc7a1\ud55c \ub3d9\uc791\uc5d0 \ub300\ud55c \uc815\ud655\ub3c4\uac00 \ub5a8\uc5b4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubaa8\ubc14\uc77c\uc5d0\uc11c \uc9c1\uba74\ud560 \uc218 \uc788\ub294 \ubb38\uc81c\ub294 \ud654\uba74 \ubd80\ub3d9\uc0b0\uacfc \uc758\ub3c4\ud588\ub358 \ud130\uce58 \ucee8\ud2b8\ub864 \uc606\uc758 \ud130\uce58 \ucee8\ud2b8\ub864\uc744 \uc2e4\uc218\ub85c \ud0ed\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \ubbf8\uc138\ud55c \ud39c(PC)\uc73c\ub85c \uadf8\ub9bc\uc744 \uadf8\ub9ac\ub294 \uac83\uacfc \ud06c\ub808\uc6a9(\ubaa8\ubc14\uc77c)\uc73c\ub85c \uadf8\ub9bc\uc744 \uadf8\ub9ac\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. PC\uc758 \ub354 \ud070 \ud654\uba74\uacfc \ucd94\uac00\uc801\uc778 \ucc98\ub9ac \uc131\ub2a5\uc73c\ub85c \ud504\ub808\uc784 \uc18d\ub3c4\uc640 \uc2dc\uac01\uc801 \ub514\ud14c\uc77c\uc774 \ud06c\uac8c \ud5a5\uc0c1\ub429\ub2c8\ub2e4."}, {"question": "Sky Mad: \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\uac00 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc783\uc5c8\ub2e4\ub294 \uac83\uc744 \uc54c\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ud50c\ub7ab\ud3fc \uac04 \uacc4\uc815 \ub3d9\uae30\ud654\uac00 \uc788\uc2b5\ub2c8\uae4c? \uc9c4\ud589 \uc0c1\ud669\uc774 \uc5ec\ub7ec \uc7a5\uce58\uc5d0\uc11c \uc800\uc7a5\ub418\ub3c4\ub85d \uc5b4\ub5bb\uac8c \ubcf4\uc7a5\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Sky Mad\ub294 \ud50c\ub7ab\ud3fc \uac04 \uacc4\uc815 \ub3d9\uae30\ud654\ub97c \uc9c0\uc6d0\ud569\ub2c8\ub2e4! \uc9c4\ud589 \uc0c1\ud669\uc774 \uc800\uc7a5\ub418\ub3c4\ub85d \ud558\ub824\uba74 \uacc4\uc815\uc744 \uc0dd\uc131\ud574\uc57c \ud569\ub2c8\ub2e4. \uc561\uc138\uc2a4\ud560 \uc218 \uc788\ub294 \uc774\uba54\uc77c \uc8fc\uc18c\ub97c \uc81c\uacf5\ud558\uace0 \uacc4\uc815\uc744 \uc548\uc804\ud558\uac8c \ubcf4\ud638\ud558\uae30 \uc704\ud574 \uc548\uc804\ud55c \ube44\ubc00\ubc88\ud638\ub97c \uc81c\uacf5\ud574\uc57c \ud569\ub2c8\ub2e4. \uadf8 \ud6c4\uc5d0\ub294 \uac8c\uc784 \uc124\uc815 \uba54\ub274\uc5d0\uc11c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ud65c\uc131\ud654\ud574\uc57c \ud569\ub2c8\ub2e4. \ud65c\uc131\ud654\ud558\uba74 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc790\ub3d9\uc73c\ub85c \uc5ec\ub7ec \uc7a5\uce58\uc5d0 \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. \uc88b\uc740 \uc548\uc804\ub9dd\uc740 \ub85c\uceec \uc800\uc7a5 \ud30c\uc77c\uc744 \uc218\ub3d9\uc73c\ub85c \ubc31\uc5c5\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc774 \ud30c\uc77c\uc740 \uc885\uc885 'SkyMad' \ub514\ub809\ud130\ub9ac \uc544\ub798\uc758 \ubb38\uc11c \ud3f4\ub354\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \uc774\uac83\uc740 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc5d0 \ubb38\uc81c\uac00 \uc788\uac70\ub098 \uacc4\uc815\uc5d0 \ubb38\uc81c\uac00 \ubc1c\uc0dd\ud588\uc744 \uacbd\uc6b0 \uc548\uc804\ud55c \ubc31\uc5c5 \uc635\uc158\uc785\ub2c8\ub2e4."}, {"question": "Sky Mad\uc758 \uc5ec\ub7ec \ub808\ubca8\uc5d0\uc11c \ubc1c\uacac\ub418\ub294 \uac70\ub300 \uc870\uac01\uc0c1 \ub4a4\uc5d0\ub294 \uc5b4\ub5a4 \uc774\uc57c\uae30\uac00 \uc788\uc2b5\ub2c8\uae4c? \uc644\uc131\ub3c4\ub97c \uc704\ud574 \uc228\uaca8\uc9c4 \uc601\uc5ed\uc774\ub098 \ubcf4\uc0c1\uc744 \ud574\uc81c\ud569\ub2c8\uae4c?", "answer": "Sky Mad\uc758 \uac70\ub300 \uc870\uac01\uc0c1\uc740 \ub5a0 \uc788\ub294 \uc12c\uc744 \ud615\uc131\ud55c \uace0\ub300 \ubb38\uba85 '\uac74\ucd95\uac00'\ub97c \ub098\ud0c0\ub0c5\ub2c8\ub2e4. \uc624\ub79c \uc2dc\uac04 \ud50c\ub808\uc774\uc5b4\ub9cc \ubcfc \uc218 \uc788\ub294 \uac83\uc740 \uc5ec\ub7ec \ub808\ubca8\uc758 \uc870\uac01\uc0c1\uc5d0 \uc228\uaca8\uc9c4 \uc5d0\ub108\uc9c0\uc6d0\uc744 \ud65c\uc131\ud654\ud558\uc5ec \uc870\uac01\uc0c1\uc5d0 \uc804\ub825\uc744 \ubcf5\uad6c\ud560 \uc218 \uc788\ub2e4\ub294 \uac83\uc785\ub2c8\ub2e4. \ubaa8\ub4e0 \uc870\uac01\uc0c1\uc5d0 \uc804\ub825\uc744 \ubcf5\uad6c\ud558\uba74 '\uac74\ucd95\uac00\uc758 \uc2b9\ucc9c'\uc774\ub77c\ub294 \uc228\uaca8\uc9c4 \ub808\ubca8\uc774 \ud574\uc81c\ub429\ub2c8\ub2e4. \uc774 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uba74 '\uac74\ucd95\uac00\uc758 \ube14\ub808\uc774\ub4dc'\ub77c\ub294 \uace0\uc720\ud55c \ud2b9\uc218\ud55c \uc18d\uc131\uc744 \uac00\uc9c4 \ubb34\uae30\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub4e4\uc758 \ucc3d\uc870 \ub4a4\uc5d0 \uc228\uaca8\uc9c4 \uc774\uc57c\uae30\ub294 \uc870\uac01\uc0c1 \uadfc\ucc98\uc5d0 \ubc30\uce58\ub41c \uc218\uc9d1\ud488 \uc548\uc5d0 \uc788\ub294 \uc624\ub514\uc624 \ub85c\uadf8\ub97c \ud1b5\ud574 \uac8c\uc784 \ub0b4\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubaa8\ub4e0 \uc870\uac01\uc744 \ucc3e\ub294 \ub370\ub294 \uc2dc\uac04\uc774 \uac78\ub9b4 \uc218 \uc788\uc73c\ubbc0\ub85c \uc5b4\ub824\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \ube44\ubc00\uc744 \ud574\uc81c\ud558\uae30 \uc704\ud574 \ub808\ubca8\uc744 \uc644\ubcbd\ud558\uac8c \ub9c8\uc2a4\ud130\ud558\ub294 \ub370 \uc2dc\uac04\uc744 \ud22c\uc790\ud574\uc57c \ud569\ub2c8\ub2e4."}]
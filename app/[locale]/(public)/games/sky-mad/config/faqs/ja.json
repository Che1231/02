[{"question": "Sky Mad\uff1a\u57fa\u672c\u30b8\u30e3\u30f3\u30d7\u306e\u5b9f\u884c\u65b9\u6cd5\u3068\u3001\u958b\u59cb\u6642\u306b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u304b\u3089\u843d\u3061\u306a\u3044\u3088\u3046\u306b\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Sky Mad\u3067\u306f\u30b8\u30e3\u30f3\u30d7\u304c\u91cd\u8981\u3067\u3059\uff01\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\uff08\u307e\u305f\u306f\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u306e\u30b8\u30e3\u30f3\u30d7\u30dc\u30bf\u30f3\uff09\u3092\u62bc\u3057\u3066\u30b8\u30e3\u30f3\u30d7\u3057\u307e\u3059\u3002\u843d\u3061\u306a\u3044\u3088\u3046\u306b\u3059\u308b\u306b\u306f\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u30a8\u30c3\u30b8\u306b\u6ce8\u610f\u6df1\u304f\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u77ed\u3044\u30b8\u30e3\u30f3\u30d7\u304b\u3089\u59cb\u3081\u3066\u3001\u5f90\u3005\u306b\u8ddd\u96e2\u3092\u9577\u304f\u3057\u307e\u3057\u3087\u3046\u3002\u300c\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u5cf6\u300d\u30ec\u30d9\u30eb\u304c\u305d\u308c\u306b\u5f53\u305f\u308a\u307e\u3059\u3002\u9ad8\u5ea6\u306a\u52d5\u304d\u3092\u8a66\u3059\u524d\u306b\u3001\u9699\u9593\u3092\u30b8\u30e3\u30f3\u30d7\u3057\u3066\u7df4\u7fd2\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u81ea\u8ee2\u8eca\u306b\u4e57\u308b\u7df4\u7fd2\u3068\u540c\u3058\u3067\u3059\u3002\u3086\u3063\u304f\u308a\u59cb\u3081\u3066\u81ea\u4fe1\u3092\u3064\u3051\u307e\u3057\u3087\u3046\u3002\u904e\u5270\u306a\u30a8\u30af\u30b5\u30b5\u30a4\u30ba\u306f\u3001\u304e\u3053\u3061\u306a\u3044\u30b8\u30e3\u30f3\u30d7\u306b\u3064\u306a\u304c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308b\u305f\u3081\u3001\u30b9\u30bf\u30df\u30ca\u7ba1\u7406\u3082\u91cd\u8981\u3067\u3059\u3002\u52b9\u7387\u3092\u6700\u5927\u9650\u306b\u9ad8\u3081\u308b\u305f\u3081\u306b\u3001\u30d7\u30ec\u30a4\u3092\u8abf\u6574\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "Sky Mad\uff1a\u30b2\u30fc\u30e0\u958b\u59cb\u6642\u306b\u96c6\u3081\u308b\u3079\u304d\u30ea\u30bd\u30fc\u30b9\u3068\u3001\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u521d\u671f\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u5fc5\u8981\u306a\u7406\u7531\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Sky Mad\u306e\u521d\u671f\u6bb5\u968e\u3067\u306f\u3001\u300c\u7834\u7247\u300d\u3068\u300c\u30a8\u30c3\u30bb\u30f3\u30b9\u300d\u3092\u96c6\u3081\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u307e\u3057\u3087\u3046\u3002\u7834\u7247\u306f\u3001\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3057\u305f\u5f8c\u3001\u591a\u304f\u306e\u5834\u5408\u3001\u30df\u30c3\u30b7\u30e7\u30f3\u306e\u7d42\u4e86\u6642\u306e\u5831\u544a\u66f8\u3067\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30a8\u30c3\u30bb\u30f3\u30b9\u306f\u3001\u5c11\u3057\u63a2\u67fb\u304c\u5fc5\u8981\u3068\u306a\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u6311\u6226\u7684\u306a\u30b8\u30e3\u30f3\u30d7\u306e\u8fd1\u304f\u306b\u3042\u308b\u5c0f\u3055\u306a\u584a\u3092\u3057\u3070\u3057\u3070\u898b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u7834\u7247\u306f\u3001\u30b8\u30e3\u30f3\u30d7\u306e\u9ad8\u3055\u3084\u79fb\u52d5\u901f\u5ea6\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u305f\u3081\u306e\u4e3b\u8981\u306a\u901a\u8ca8\u3067\u3042\u308a\u3001\u30a8\u30c3\u30bb\u30f3\u30b9\u306f\u300c\u30a8\u30a2\u30c0\u30c3\u30b7\u30e5\u300d\u306a\u3069\u306e\u65b0\u3057\u3044\u79fb\u52d5\u30b9\u30ad\u30eb\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u521d\u671f\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u521d\u671f\u30ec\u30d9\u30eb\u306f\u3001\u610f\u56f3\u7684\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u8cfc\u5165\u3092\u4fc3\u3059\u3088\u3046\u306b\u8abf\u6574\u3055\u308c\u3066\u3044\u308b\u304b\u3089\u3067\u3059\u3002\u5f90\u3005\u306b\u4e0a\u6607\u3057\u307e\u3059\u304c\u3001\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u521d\u671f\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u3001\u5f8c\u306e\u30ec\u30d9\u30eb\u3067\u5f79\u7acb\u3061\u307e\u3059\uff01"}, {"question": "Sky Mad\uff1a\u30ec\u30d9\u30eb\u30bb\u30ec\u30af\u30bf\u30fc\u306b\u8a18\u8f09\u3055\u308c\u3066\u3044\u308b\u300c\u8a66\u7df4\u300d\u3068\u306f\u4f55\u3067\u3042\u308a\u3001\u3069\u306e\u3088\u3046\u306a\u5831\u916c\u304c\u4e0e\u3048\u3089\u308c\u307e\u3059\u304b\uff1f", "answer": "Sky Mad\u306e\u8a66\u7df4\u306f\u3001\u5404\u30ec\u30d9\u30eb\u306e\u30b9\u30ad\u30eb\u3092\u30c6\u30b9\u30c8\u3059\u308b\u305f\u3081\u306b\u8a2d\u8a08\u3055\u308c\u305f\u7279\u5225\u306a\u6311\u6226\u3067\u3059\u3002\u3053\u308c\u306b\u306f\u3001\u6642\u9593\u5236\u9650\u5185\u3067\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u3053\u3068\u3001\u3059\u3079\u3066\u306e\u96a0\u3055\u308c\u305f\u53ce\u96c6\u7269\u3092\u96c6\u3081\u308b\u3053\u3068\u3001\u307e\u305f\u306f\u6b7b\u4ea1\u3059\u308b\u3053\u3068\u306a\u304f\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u3053\u3068\u306a\u3069\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u8a66\u7df4\u3092\u5b8c\u4e86\u3059\u308b\u3068\u3001\u300c\u8a66\u7df4\u30c8\u30fc\u30af\u30f3\u300d\u304c\u4e0e\u3048\u3089\u308c\u307e\u3059\u3002\u8a66\u7df4\u30c8\u30fc\u30af\u30f3\u306f\u3001\u65b0\u3057\u3044\u30b0\u30e9\u30a4\u30c0\u30fc\u30b9\u30ad\u30f3\u3084\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u8863\u88c5\u306a\u3069\u3001\u88c5\u98fe\u7684\u306a\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u305f\u3081\u306b\u4f7f\u7528\u3055\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30af\u30ea\u30b9\u30bf\u30eb\u6d1e\u7a9f\u300d\u8a66\u7df4\u3092\u5b8c\u4e86\u3059\u308b\u3068\u3001\u300c\u30aa\u30d6\u30b7\u30c7\u30a3\u30a2\u30f3\u30b0\u30e9\u30a4\u30c0\u30fc\u300d\u30b9\u30ad\u30f3\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u3053\u308c\u3089\u306f\u3042\u306a\u305f\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306b\u72ec\u7279\u306e\u96f0\u56f2\u6c17\u3092\u52a0\u3048\u3001\u3042\u306a\u305f\u306e\u30b9\u30ad\u30eb\u3092\u30a2\u30d4\u30fc\u30eb\u3059\u308b\u3082\u306e\u3067\u3059\u3002\u3053\u308c\u306f\u3001\u7279\u5b9a\u306e\u30ec\u30d9\u30eb\u306b\u304a\u3051\u308b\u7fd2\u719f\u5ea6\u306b\u5831\u3044\u308b\u65b9\u6cd5\u3067\u3042\u308a\u3001\u5b8c\u74a7\u4e3b\u7fa9\u3092\u5968\u52b1\u3059\u308b\u3082\u306e\u3067\u3059\uff01"}, {"question": "\u30d9\u30c6\u30e9\u30f3\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u3057\u3066\u3001Sky Mad\u306e\u30b9\u30d4\u30fc\u30c9\u30e9\u30f3\u30cb\u30f3\u30b0\u3067\u6700\u3082\u52b9\u7387\u7684\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f\u3069\u306e\u30b9\u30ad\u30eb\u30c4\u30ea\u30fc\u304c\u6700\u3082\u91cd\u8981\u3067\u3042\u308a\u3001\u3069\u306e\u30a8\u30ea\u30a2\u3067\u6642\u9593\u3092\u7bc0\u7d04\u3067\u304d\u308b\u53ef\u80fd\u6027\u304c\u9ad8\u3044\u304b\u3069\u3046\u304b\u6559\u3048\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "Sky Mad\u306e\u30b9\u30d4\u30fc\u30c9\u30e9\u30f3\u30cb\u30f3\u30b0\u3067\u306f\u3001\u52b9\u7387\u304c\u3059\u3079\u3066\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u521d\u671f\u6bb5\u968e\u3067\u300c\u904b\u52d5\u91cf\u300d\u30b9\u30ad\u30eb\u30c4\u30ea\u30fc\u3092\u6700\u5927\u9650\u306b\u5f37\u5316\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30a8\u30a2\u30b9\u30d4\u30fc\u30c9\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u3001\u3088\u308a\u901f\u3044\u79fb\u52d5\u304c\u53ef\u80fd\u306b\u306a\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30ec\u30d9\u30eb\u306e\u914d\u7f6e\u3092\u8a18\u61b6\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6700\u9069\u306a\u30d1\u30b9\u3092\u77e5\u3063\u3066\u3044\u308c\u3070\u3001\u8cb4\u91cd\u306a\u79d2\u6570\u3092\u7bc0\u7d04\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u300c\u58c1\u30ad\u30c3\u30af\u300d\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u6d3b\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u58c1\u30ad\u30c3\u30af\u306f\u3001\u7a7a\u4e2d\u3067\u65b9\u5411\u3092\u5909\u3048\u308b\u969b\u306b\u904b\u52d5\u91cf\u3092\u7dad\u6301\u3057\u307e\u3059\u3002\u6642\u9593\u3092\u7bc0\u7d04\u3067\u304d\u308b\u53ef\u80fd\u6027\u306e\u9ad8\u3044\u7279\u5b9a\u306e\u30a8\u30ea\u30a2\u306b\u306f\u3001\u300c\u901f\u5ea6\u30ea\u30c3\u30b8\u300d\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u3053\u3067\u306f\u3001\u300c\u58c1\u30ad\u30c3\u30af\u300d\u30c6\u30af\u30cb\u30c3\u30af\u3092\u7fd2\u5f97\u3059\u308b\u3053\u3068\u3067\u3001\u7d043\u79d2\u3092\u7bc0\u7d04\u3067\u304d\u307e\u3059\u3002\u6a19\u6e96\u30d1\u30b9\u3068\u30b9\u30d4\u30fc\u30c9\u30e9\u30f3\u30ca\u30fc\u306e\u6700\u9069\u5316\u3055\u308c\u305f\u30d1\u30b9\u3092\u6bd4\u8f03\u3059\u308b\u3068\u3001\u30df\u30ea\u79d2\u5358\u4f4d\u306e\u7bc0\u7d04\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "Sky Mad\uff1a\u30b0\u30e9\u30a4\u30c0\u30fc\u304c\u3001\u5341\u5206\u306a\u30a8\u30cd\u30eb\u30ae\u30fc\u304c\u3042\u308b\u306b\u3082\u304b\u304b\u308f\u3089\u305a\u3001\u6642\u3005\u5c55\u958b\u3057\u306a\u3044\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u4fe1\u983c\u3067\u304d\u308b\u30b0\u30e9\u30a4\u30c0\u30fc\u306e\u5c55\u958b\u3092\u78ba\u5b9f\u306b\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Sky Mad\u3067\u306e\u30b0\u30e9\u30a4\u30c0\u30fc\u306e\u5c55\u958b\u306f\u3001\u30a8\u30cd\u30eb\u30ae\u30fc\u3068\u904b\u52d5\u91cf\u306e\u7d44\u307f\u5408\u308f\u305b\u306b\u4f9d\u5b58\u3057\u3066\u3044\u307e\u3059\u3002\u3044\u305a\u308c\u304b\u306e\u7d71\u8a08\u307e\u305f\u306f\u4e21\u65b9\u306e\u7d71\u8a08\u304c\u4f4e\u3059\u304e\u308b\u5834\u5408\u3001\u30b0\u30e9\u30a4\u30c0\u30fc\u306f\u5c55\u958b\u3057\u307e\u305b\u3093\u3002\u30a8\u30cd\u30eb\u30ae\u30fc\u304c\u4f4e\u3044\u306e\u306f\u3001\u6700\u8fd1\u30a8\u30a2\u30c0\u30c3\u30b7\u30e5\u3092\u4f7f\u7528\u3057\u305f\u305f\u3081\u3067\u3059\u3002\u3053\u308c\u3089\u306f\u6642\u9593\u3068\u3068\u3082\u306b\u518d\u30c1\u30e3\u30fc\u30b8\u3055\u308c\u307e\u3059\u3002\u904b\u52d5\u91cf\u304c\u4f4e\u3044\u306e\u306f\u3001\u7a7a\u4e2d\u3067\u505c\u6b62\u3057\u3066\u3044\u308b\u304b\u3001\u975e\u5e38\u306b\u3086\u3063\u304f\u308a\u3068\u52d5\u3044\u3066\u3044\u308b\u305f\u3081\u3067\u3059\u3002\u4fe1\u983c\u3067\u304d\u308b\u30b0\u30e9\u30a4\u30c0\u30fc\u306e\u5c55\u958b\u3092\u78ba\u5b9f\u306b\u3059\u308b\u306b\u306f\u3001\u9069\u5207\u306a\u901f\u5ea6\u3092\u7dad\u6301\u3057\u3001\u30a8\u30a2\u30c0\u30c3\u30b7\u30e5\u3092\u614e\u91cd\u306b\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u30a8\u30cd\u30eb\u30ae\u30fc\u30ec\u30d9\u30eb\u304c\u826f\u597d\u306b\u7dad\u6301\u3055\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30a8\u30a2\u30c0\u30c3\u30b7\u30e5\u3092\u4f7f\u7528\u3057\u3066\u9ad8\u3044\u4f4d\u7f6e\u304b\u3089\u30b8\u30e3\u30f3\u30d7\u3057\u305f\u5834\u5408\u3001\u904b\u52d5\u91cf\u306f\u305d\u306e\u307e\u307e\u7dad\u6301\u3055\u308c\u3001\u6210\u529f\u88cf\u306b\u5c55\u958b\u3067\u304d\u307e\u3059\u3002\u30a8\u30cd\u30eb\u30ae\u30fc\u3068\u30b9\u30bf\u30df\u30ca\u306e\u95a2\u4fc2\u3092\u8868\u3059\u95a2\u4fc2\u8868\u3092\u4ee5\u4e0b\u306b\u793a\u3057\u307e\u3059\u3002\n\u30b0\u30e9\u30a4\u30c0\u30fc\u5c55\u958b\uff1a\u30a8\u30cd\u30eb\u30ae\u30fc\uff08\u226725\uff05\uff09&&\u904b\u52d5\u91cf\uff08\u226750\uff05\uff09\u3002\u3053\u308c\u3089\u304c\u4fdd\u6301\u3055\u308c\u305f\u5834\u5408\u3001\u30b0\u30e9\u30a4\u30c0\u30fc\u306f\u5c55\u958b\u3055\u308c\u307e\u3059\u3002\u305d\u308c\u4ee5\u5916\u306e\u5834\u5408\u306f\u843d\u4e0b\u3057\u307e\u3059\u3002"}, {"question": "Sky Mad\uff1a\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u5b8c\u4e86\u3059\u308b\u305f\u3081\u306b\u3001\u30dd\u30a4\u30f3\u30c8\u30b7\u30b9\u30c6\u30e0\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "Sky Mad\u306e\u30dd\u30a4\u30f3\u30c8\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u5358\u306a\u308b\u30b9\u30b3\u30a2\u3092\u8d85\u3048\u3066\u3044\u307e\u3059\u3002\u9ad8\u3044\u30b9\u30b3\u30a2\u306f\u901a\u5e38\u3001\u91cd\u8981\u306a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3001\u80fd\u529b\u3001\u5834\u5408\u306b\u3088\u3063\u3066\u306f\u7279\u5b9a\u306e\u30ec\u30d9\u30eb\u5185\u306e\u79d8\u5bc6\u30a8\u30ea\u30a2\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u3053\u3068\u306b\u95a2\u9023\u3057\u3066\u3044\u308b\u305f\u3081\u3001\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u5b8c\u4e86\u3059\u308b\u80fd\u529b\u306b\u76f4\u63a5\u5f71\u97ff\u3057\u307e\u3059\u3002\u30dd\u30a4\u30f3\u30c8\u306f\u3001\u30d7\u30ec\u30fc\u30e4\u30fc\u304c\u884c\u3046\u3042\u3089\u3086\u308b\u7a2e\u985e\u306e\u884c\u52d5\u306b\u5bfe\u3057\u3066\u4e0e\u3048\u3089\u308c\u307e\u3059\u3002\u6b21\u306b\u3001\u305d\u308c\u3089\u3059\u3079\u3066\u3092\u30ea\u30b9\u30c8\u3057\u307e\u3059\u3002\n\u901a\u5e38\u306e\u30b8\u30e3\u30f3\u30d7\u30fc5\u30dd\u30a4\u30f3\u30c8\n\u7a7a\u4e2d\u8abf\u6574\u30fc10\u30dd\u30a4\u30f3\u30c8\n\u6575\u6483\u7834\u30fc20\u30dd\u30a4\u30f3\u30c8+\u96e3\u6613\u5ea6\u4e57\u6570\n\u58c1\u30b8\u30e3\u30f3\u30d7\u30fc15\u30dd\u30a4\u30f3\u30c8\n\u30a8\u30a2\u56de\u907f\u30fc20\u30dd\u30a4\u30f3\u30c8\n\u6210\u529f\u3057\u305f\u30b0\u30e9\u30a4\u30c0\u30fc\u767a\u5c04\u30fc25\u30dd\u30a4\u30f3\u30c8\n\u53ce\u96c6\u54c1\u30fc\u69d8\u3005\n\u30ec\u30d9\u30eb\u30af\u30ea\u30a2\u30fc100\u30dd\u30a4\u30f3\u30c8+\u96e3\u6613\u5ea6\u4e57\u6570+\u30b9\u30da\u30b7\u30e3\u30eb\u76ee\u6a19\u9054\u6210\n\u305f\u3068\u3048\u3070\u3001\u300c\u5fd8\u308c\u3089\u308c\u305f\u90fd\u5e02\u300d\u30c1\u30e3\u30ec\u30f3\u30b8\u3067\u306f\u30015000\u4ee5\u4e0a\u306e\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u3068\u3001\u305d\u308c\u4ee5\u5916\u3067\u306f\u5230\u9054\u3067\u304d\u306a\u3044\u30d1\u30b9\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u3001\u305d\u308c\u3060\u3051\u3067\u306a\u304f\u3001\u540c\u50da\u3088\u308a\u3082\u9ad8\u304f\u30b8\u30e3\u30f3\u30d7\u3067\u304d\u308b\u30ad\u30fc\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u304c\u4e0e\u3048\u3089\u308c\u307e\u3059\u3002\u5341\u5206\u306a\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u306a\u3044\u3068\u3001\u5931\u6557\u3057\u3066\u3057\u307e\u3044\u307e\u3059\u3002"}, {"question": "Sky Mad\uff1aSky Mad\u306e\u6b66\u5668\u9593\u306e\u6570\u5024\u30c0\u30e1\u30fc\u30b8\u5dee\u306f\u4f55\u3067\u3059\u304b\uff1f\u6b66\u5668\u306e\u5168\u4f53\u7684\u306a\u30c0\u30e1\u30fc\u30b8\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u30b9\u30c6\u30fc\u30bf\u30b9\u5f37\u5316\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Sky Mad\u306e\u5404\u6b66\u5668\u306f\u3001\u30b9\u30c6\u30fc\u30bf\u30b9\u5f37\u5316\u306b\u3088\u3063\u3066\u5f71\u97ff\u3092\u53d7\u3051\u308b\u72ec\u81ea\u306e\u30c0\u30e1\u30fc\u30b8\u5024\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30d7\u30e9\u30ba\u30de\u30e9\u30a4\u30d5\u30eb\u300d\u306e\u57fa\u672c\u30c0\u30e1\u30fc\u30b8\u306f50\u3001\u4e00\u65b9\u3001\u300c\u30a2\u30fc\u30af\u30ad\u30e3\u30ce\u30f3\u300d\u306e\u57fa\u672c\u30c0\u30e1\u30fc\u30b8\u306f80\u3067\u3059\u304c\u3001\u5c04\u6483\u901f\u5ea6\u306f\u9045\u304f\u306a\u308a\u307e\u3059\u3002\u30b9\u30c6\u30fc\u30bf\u30b9\u5f37\u5316\u306f\u6b66\u5668\u306b\u5927\u304d\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u300c\u529b\u300d\u306f\u3001\u5404\u30dd\u30a4\u30f3\u30c8\u3054\u3068\u306b\u57fa\u672c\u30c0\u30e1\u30fc\u30b8\u30921\uff05\u5897\u52a0\u3055\u305b\u307e\u3059\u3002\u300c\u4fca\u654f\u6027\u300d\u306f\u3001\u5404\u30dd\u30a4\u30f3\u30c8\u3054\u3068\u306b\u5c04\u6483\u901f\u5ea6\u30922\uff05\u5897\u52a0\u3055\u305b\u307e\u3059\u3002\u9069\u5207\u306a\u69cb\u7bc9\u306f\u3001\u30d0\u30fc\u30b9\u30c8\u30c0\u30e1\u30fc\u30b8\u3092\u91cd\u8996\u3059\u308b\u30d3\u30eb\u30c9\u3067\u306f\u3001\u30c0\u30e1\u30fc\u30b8\u3068\u529b\u3092\u91cd\u8996\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u307e\u305f\u306f\u3001\u30a2\u30ae\u30ea\u30c6\u30a3\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u3001\u5c04\u6483\u901f\u5ea6\u3068DPS\u30a2\u30a6\u30c8\u30d7\u30c3\u30c8\u3092\u6700\u5927\u5316\u3059\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u597d\u307f\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u3002"}, {"question": "Sky Mad\uff1a\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u4ee5\u5916\u306b\u3082\u3001PC\u3068\u30e2\u30d0\u30a4\u30eb\u3067\u30d7\u30ec\u30a4\u3059\u308b\u3068\u304d\u306e\u30b3\u30a2\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u9055\u3044\u3068\u5229\u70b9\u306f\u4f55\u3067\u3059\u304b\uff1f\u7279\u306b\u3001\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3092\u8003\u616e\u3057\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "PC\u3068\u30e2\u30d0\u30a4\u30eb\u306e\u30b3\u30a2\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306f\u3001\u307b\u3068\u3093\u3069\u540c\u3058\u3067\u3059\u3002\u305f\u3060\u3057\u3001PC\u306f\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u306e\u7cbe\u5ea6\u3068\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u306e\u5fe0\u5b9f\u5ea6\u306b\u304a\u3044\u3066\u5229\u70b9\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002PC\u30d0\u30fc\u30b8\u30e7\u30f3\u3067\u306f\u3001\u30ad\u30fc\u30dc\u30fc\u30c9\u3068\u30de\u30a6\u30b9\u307e\u305f\u306f\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u304a\u308a\u3001\u7279\u306b\u8907\u6570\u306e\u58c1\u30b8\u30e3\u30f3\u30d7\u3092\u7d20\u65e9\u304f\u5b9f\u884c\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u5834\u5408\u306b\u3001\u7cbe\u5bc6\u306a\u79fb\u52d5\u3068\u7167\u6e96\u304c\u53ef\u80fd\u306b\u306a\u308a\u307e\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u30d0\u30fc\u30b8\u30e7\u30f3\u306f\u30bf\u30c3\u30c1\u30b9\u30af\u30ea\u30fc\u30f3\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u306b\u4f9d\u5b58\u3057\u3066\u304a\u308a\u3001\u8907\u96d1\u306a\u64cd\u4f5c\u3067\u306f\u7cbe\u5ea6\u304c\u4f4e\u3044\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u7248\u3067\u76f4\u9762\u3059\u308b\u8ab2\u984c\u306e1\u3064\u306f\u3001\u753b\u9762\u306e\u4e0d\u52d5\u7523\u3068\u3001\u610f\u56f3\u3057\u305f\u30bf\u30c3\u30c1\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u306e\u96a3\u306b\u3042\u308b\u30bf\u30c3\u30c1\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3092\u8aa4\u3063\u3066\u30bf\u30c3\u30d7\u3057\u3066\u3057\u307e\u3046\u3053\u3068\u3067\u3059\u3002\u7d30\u304b\u3044\u30da\u30f3\uff08PC\uff09\u3067\u63cf\u304f\u3053\u3068\u3068\u3001\u30af\u30ec\u30e8\u30f3\uff08\u30e2\u30d0\u30a4\u30eb\uff09\u3067\u63cf\u304f\u3053\u3068\u306e\u985e\u4f3c\u70b9\u3068\u3057\u3066\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002PC\u306e\u5927\u304d\u306a\u753b\u9762\u3068\u8ffd\u52a0\u306e\u51e6\u7406\u80fd\u529b\u306b\u3088\u308a\u3001\u30d5\u30ec\u30fc\u30e0\u30ec\u30fc\u30c8\u3068\u8996\u899a\u7684\u306a\u8a73\u7d30\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3059\u308b\u3068\u3044\u3046\u3001\u306f\u308b\u304b\u306b\u512a\u308c\u305f\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3082\u5f97\u3089\u308c\u307e\u3059\u3002"}, {"question": "Sky Mad\uff1a\u4e00\u90e8\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u9032\u884c\u72b6\u6cc1\u3092\u5931\u3063\u305f\u3068\u77e5\u3063\u3066\u3044\u307e\u3059\u3002\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\u540c\u671f\u306f\u3042\u308a\u307e\u3059\u304b\uff1f\u9032\u884c\u72b6\u6cc1\u3092\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u4fdd\u5b58\u3059\u308b\u65b9\u6cd5\u306f\u3001\u3053\u306e\u3088\u3046\u306a\u3053\u3068\u304c\u81ea\u5206\u306e\u8eab\u306b\u8d77\u3053\u3089\u306a\u3044\u3088\u3046\u306b\u3059\u308b\u65b9\u6cd5\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Sky Mad\u306f\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\u540c\u671f\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u307e\u3059\uff01\u9032\u884c\u72b6\u6cc1\u3092\u4fdd\u5b58\u3059\u308b\u306b\u306f\u3001\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u4f5c\u6210\u3057\u307e\u3059\u3002\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u30e1\u30fc\u30eb\u30a2\u30c9\u30ec\u30b9\u3068\u5b89\u5168\u306a\u30d1\u30b9\u30ef\u30fc\u30c9\u3092\u63d0\u4f9b\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u3092\u5b9f\u884c\u3057\u305f\u3089\u3001\u30b2\u30fc\u30e0\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u3067\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u6709\u52b9\u306b\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u6709\u52b9\u306b\u3059\u308b\u3068\u3001\u9032\u884c\u72b6\u6cc1\u306f\u81ea\u52d5\u7684\u306b\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u540c\u671f\u3055\u308c\u307e\u3059\u3002\u5b89\u5168\u306a\u624b\u6bb5\u3068\u3057\u3066\u3001\u30ed\u30fc\u30ab\u30eb\u4fdd\u5b58\u30d5\u30a1\u30a4\u30eb\u3092\u500b\u5225\u306b\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u3059\u308b\u3053\u3068\u3082\u63a8\u5968\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u306b\u969c\u5bb3\u304c\u767a\u751f\u3057\u305f\u308a\u3001\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u554f\u984c\u304c\u767a\u751f\u3057\u305f\u308a\u3057\u305f\u5834\u5408\u306e\u5099\u3048\u3068\u3057\u3066\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "Sky Mad\uff1a\u8907\u6570\u306e\u30ec\u30d9\u30eb\u3067\u898b\u3089\u308c\u308b\u5de8\u5927\u306a\u5f6b\u50cf\u306e\u80cc\u5f8c\u306b\u3042\u308b\u30b9\u30c8\u30fc\u30ea\u30fc\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u308c\u3089\u306f\u3001\u30b3\u30f3\u30d7\u30ea\u30fc\u30c8\u5236\u4f5c\u8005\u306b\u3068\u3063\u3066\u96a0\u3055\u308c\u305f\u30a8\u30ea\u30a2\u3084\u5831\u916c\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u307e\u3059\u304b\uff1f", "answer": "Sky Mad\u306e\u5de8\u5927\u306a\u5f6b\u50cf\u306f\u3001\u300c\u5efa\u7bc9\u5bb6\u300d\u3092\u8868\u3057\u3066\u3044\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u6d6e\u904a\u3059\u308b\u5cf6\u3005\u3092\u5f62\u4f5c\u3063\u305f\u53e4\u4ee3\u6587\u660e\u3067\u3059\u3002\u9577\u5e74\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3060\u3051\u304c\u6c17\u3065\u3044\u305f\u3053\u3068\u306f\u3042\u308a\u307e\u3059\u304c\u3001\u8907\u6570\u306e\u30ec\u30d9\u30eb\u306b\u3042\u308b\u5f6b\u50cf\u306b\u529b\u3092\u56de\u5fa9\u3055\u305b\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u3001\u96a0\u3055\u308c\u305f\u30a8\u30cd\u30eb\u30ae\u30fc\u6e90\u3092\u6d3b\u6027\u5316\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3059\u3079\u3066\u306e\u5f6b\u50cf\u306b\u529b\u3092\u56de\u5fa9\u3055\u305b\u308b\u3068\u3001\u300c\u5efa\u7bc9\u5bb6\u306e\u6607\u5929\u300d\u3068\u3044\u3046\u96a0\u3057\u30ec\u30d9\u30eb\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u3053\u306e\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u3068\u3001\u300c\u5efa\u7bc9\u5bb6\u306e\u30d6\u30ec\u30fc\u30c9\u300d\u3068\u3044\u3046\u3001\u4ed6\u306e\u5834\u6240\u3067\u306f\u5165\u624b\u3067\u304d\u306a\u3044\u7279\u5225\u306a\u7279\u6027\u3092\u6301\u3064\u3001\u72ec\u81ea\u306e\u6b66\u5668\u304c\u624b\u306b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u5f7c\u3089\u306e\u5275\u9020\u306e\u80cc\u5f8c\u306b\u3042\u308b\u30b9\u30c8\u30fc\u30ea\u30fc\u306f\u3001\u5f6b\u50cf\u306e\u8fd1\u304f\u306b\u7f6e\u304b\u308c\u305f\u53ce\u96c6\u54c1\u3068\u30aa\u30fc\u30c7\u30a3\u30aa\u30ed\u30b0\u3067\u30b2\u30fc\u30e0\u5185\u3067\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3059\u3079\u3066\u306e\u30d4\u30fc\u30b9\u3092\u898b\u3064\u3051\u308b\u306b\u306f\u6642\u9593\u3092\u8981\u3059\u308b\u305f\u3081\u3001\u96e3\u3057\u3044\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u305d\u308c\u3089\u3092\u898b\u3064\u3051\u51fa\u3057\u3066\u3001\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3055\u305b\u308b\u305f\u3081\u306b\u6642\u9593\u3092\u8cbb\u3084\u3059\u3053\u3068\u304c\u5fc5\u8981\u3067\u3059\u3002"}]
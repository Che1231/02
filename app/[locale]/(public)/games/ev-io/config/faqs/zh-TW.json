[{"question": "\u5982\u4f55\u8b93\u65b0\u73a9\u5bb6\u5feb\u901f\u4e0a\u624b Ev.io \u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u5feb\u901f\u4e0a\u624b Ev.io \u7684\u57fa\u672c\u63a7\u5236\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u4f7f\u7528 WASD \u9375\u79fb\u52d5\u89d2\u8272\u3002\u6b65\u9a5f2 - \u5de6\u9375\u9ede\u64ca\u5c04\u64ca\uff0c\u53f3\u9375\u9ede\u64ca\u7784\u6e96\u3002\u6b65\u9a5f3 - \u6309\u4e0b\u7a7a\u683c\u9375\u8df3\u8e8d\u3002\u4f8b\u5982\uff0c\u5728\u904a\u6232\u4e2d\u51fa\u73fe\u6642\uff0c\u7df4\u7fd2\u79fb\u52d5\u548c\u5411\u975c\u6b62\u76ee\u6a19\u5c04\u64ca\uff0c\u611f\u53d7\u63a7\u5236\u3002\u9019\u5c07\u6709\u52a9\u65bc\u4f60\u5efa\u7acb\u808c\u8089\u8a18\u61b6\u4e26\u63d0\u5347\u4f60\u7684\u904a\u6232\u8868\u73fe\u3002\u6b64\u5916\uff0c\u4f60\u9084\u53ef\u4ee5\u53c3\u8003\u904a\u6232\u5167\u6559\u5b78\uff0c\u7372\u5f97\u66f4\u8a73\u7d30\u7684\u64cd\u4f5c\u8aaa\u660e\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u4e86\u89e3 Ev.io \u4e2d\u4e0d\u540c\u6b66\u5668\u985e\u578b\u5c0d\u65bc\u904a\u6232\u9ad4\u9a57\u5f88\u91cd\u8981\uff0c\u4ee5\u53ca\u5b83\u5011\u5982\u4f55\u5f71\u97ff\u904a\u6232\uff1f", "answer": "\u4e86\u89e3 Ev.io \u4e2d\u4e0d\u540c\u7684\u6b66\u5668\u985e\u578b\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u6bcf\u7a2e\u6b66\u5668\u90fd\u6709\u7368\u7279\u7684\u7279\u6027\uff0c\u6703\u986f\u8457\u5f71\u97ff\u4f60\u7684\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u6563\u5f48\u69cd\u5728\u8fd1\u8ddd\u96e2\u975e\u5e38\u6709\u6548\uff0c\u4f46\u5c04\u7a0b\u6709\u9650\uff0c\u800c\u72d9\u64ca\u6b65\u69cd\u5728\u9060\u8ddd\u96e2\u512a\u7570\uff0c\u4f46\u9700\u8981\u7cbe\u78ba\u7784\u6e96\u3002\u900f\u904e\u4e86\u89e3\u6bcf\u7a2e\u6b66\u5668\u7684\u512a\u7f3a\u9ede\uff0c\u4f60\u53ef\u4ee5\u6839\u64da\u4e0d\u540c\u60c5\u6cc1\u8abf\u6574\u4f60\u7684\u904a\u6232\u98a8\u683c\u3002\u4f8b\u5982\uff0c\u5728\u8fd1\u8ddd\u96e2\u5730\u5716\u4e2d\uff0c\u9078\u64c7\u6563\u5f48\u69cd\u53ef\u4ee5\u6bd4\u4f7f\u7528\u9060\u7a0b\u6b66\u5668\u7684\u73a9\u5bb6\u7372\u5f97\u512a\u52e2\u3002"}, {"question": "\u5728 Ev.io \u7684\u5feb\u901f\u7bc0\u594f\u6bd4\u8cfd\u4e2d\uff0c\u5ef6\u9577\u751f\u5b58\u6642\u9593\u7684\u95dc\u9375\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u8981\u5728 Ev.io \u7684\u5feb\u901f\u7bc0\u594f\u6bd4\u8cfd\u4e2d\u5ef6\u9577\u751f\u5b58\u6642\u9593\uff0c\u8acb\u8003\u616e\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9a5f1 - \u96a8\u6642\u6ce8\u610f\u5468\u570d\u74b0\u5883\uff0c\u4e26\u5584\u7528\u5730\u5716\u3002\u6b65\u9a5f2 - \u5229\u7528\u63a9\u9ad4\u4f86\u907f\u514d\u6575\u65b9\u706b\u529b\uff0c\u4e26\u4ed4\u7d30\u8a08\u5283\u4f60\u7684\u79fb\u52d5\u3002\u6b65\u9a5f3 - \u6709\u6548\u5730\u7ba1\u7406\u4f60\u7684\u8cc7\u6e90\uff0c\u4f8b\u5982\u5f48\u85e5\u548c\u6cbb\u7642\u5305\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u7684\u751f\u547d\u503c\u4e0d\u8db3\uff0c\u8acb\u64a4\u9000\u5230\u5b89\u5168\u5340\u57df\u6cbb\u7642\uff0c\u7136\u5f8c\u518d\u91cd\u65b0\u52a0\u5165\u6230\u9b25\u3002\u6b64\u5916\uff0c\u8207\u5718\u968a\u5408\u4f5c\u4e26\u6709\u6548\u6e9d\u901a\u53ef\u4ee5\u5927\u5927\u63d0\u9ad8\u4f60\u7684\u751f\u5b58\u6a5f\u6703\u3002"}, {"question": "Ev.io \u7684\u914d\u5c0d\u7cfb\u7d71\u5982\u4f55\u78ba\u4fdd\u5e73\u8861\u4e14\u516c\u5e73\u7684\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "Ev.io \u7684\u914d\u5c0d\u7cfb\u7d71\u900f\u904e\u5c07\u985e\u4f3c\u6280\u80fd\u7b49\u7d1a\u7684\u73a9\u5bb6\u914d\u5c0d\u5728\u4e00\u8d77\uff0c\u78ba\u4fdd\u5e73\u8861\u4e14\u516c\u5e73\u7684\u904a\u6232\u9ad4\u9a57\u3002\u9019\u900f\u904e\u8003\u616e\u5404\u7a2e\u56e0\u7d20\u7684\u6f14\u7b97\u6cd5\u9054\u6210\uff0c\u4f8b\u5982\u52dd\u7387\u3001\u64ca\u6bba\u7387\u548c\u6574\u9ad4\u8868\u73fe\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u662f\u4e00\u4f4d\u65b0\u73a9\u5bb6\uff0c\u4f60\u53ef\u80fd\u6703\u88ab\u914d\u5c0d\u5230\u5176\u4ed6\u65b0\u624b\uff0c\u63d0\u4f9b\u66f4\u6109\u5feb\u4e14\u5177\u6709\u7af6\u722d\u529b\u7684\u904a\u6232\u9ad4\u9a57\u3002\u6b64\u5916\uff0c\u96a8\u8457\u73a9\u5bb6\u6280\u80fd\u7684\u63d0\u5347\u6216\u4e0b\u964d\uff0c\u7cfb\u7d71\u6703\u6301\u7e8c\u66f4\u65b0\u73a9\u5bb6\u6392\u540d\u4ee5\u7dad\u6301\u5e73\u8861\u3002"}, {"question": "\u73a9\u5bb6\u53ef\u5728 Ev.io \u7684\u7af6\u722d\u6a21\u5f0f\u4e2d\u4f7f\u7528\u54ea\u4e9b\u5148\u9032\u7b56\u7565\u4f86\u7a31\u9738\uff1f", "answer": "\u8981\u5728 Ev.io \u7684\u7af6\u722d\u6a21\u5f0f\u4e2d\u7a31\u9738\uff0c\u8acb\u8003\u616e\u4ee5\u4e0b\u5148\u9032\u7b56\u7565\uff1a\u6b65\u9a5f1 - \u638c\u63e1\u6a6b\u79fb\u6280\u5de7\uff0c\u8b93\u81ea\u5df1\u66f4\u96e3\u88ab\u64ca\u4e2d\u3002\u6b65\u9a5f2 - \u5b78\u7fd2\u9810\u6e2c\u6575\u4eba\u7684\u79fb\u52d5\u4e26\u9810\u5148\u7784\u6e96\u5e38\u898b\u8def\u7dda\u3002\u6b65\u9a5f3 - \u5229\u7528\u624b\u69b4\u5f48\u548c\u5176\u4ed6\u5de5\u5177\u4f86\u63a7\u5236\u6230\u5834\u3002\u4f8b\u5982\uff0c\u5c07\u624b\u69b4\u5f48\u6254\u5230\u4eba\u7fa4\u4e2d\u53ef\u4ee5\u5206\u6563\u6575\u4eba\uff0c\u4e26\u70ba\u4f60\u7684\u5718\u968a\u5275\u9020\u63a8\u9032\u7684\u6a5f\u6703\u3002\u6b64\u5916\uff0c\u8207\u5718\u968a\u5354\u8abf\u57f7\u884c\u540c\u6b65\u653b\u64ca\u53ef\u4ee5\u7372\u5f97\u58d3\u5012\u6027\u7684\u52dd\u5229\u3002"}, {"question": "Ev.io \u7684\u751f\u547d\u503c\u548c\u8b77\u7532\u7cfb\u7d71\u7684\u5e95\u5c64\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "Ev.io \u7684\u751f\u547d\u503c\u548c\u8b77\u7532\u7cfb\u7d71\u65e8\u5728\u70ba\u904a\u6232\u589e\u52a0\u6df1\u5ea6\u3002\u751f\u547d\u503c\u4ee3\u8868\u89d2\u8272\u7684\u751f\u547d\u529b\uff0c\u800c\u8b77\u7532\u5247\u63d0\u4f9b\u984d\u5916\u7684\u4fdd\u8b77\u4f86\u62b5\u6297\u50b7\u5bb3\u3002\u7576\u4f60\u53d7\u5230\u50b7\u5bb3\u6642\uff0c\u8b77\u7532\u6703\u5438\u6536\u4e00\u90e8\u5206\u50b7\u5bb3\uff0c\u7136\u5f8c\u624d\u5f71\u97ff\u4f60\u7684\u751f\u547d\u503c\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u6709 100 \u751f\u547d\u503c\u548c 50 \u8b77\u7532\uff0c\u800c\u4f60\u53d7\u5230 60 \u9ede\u50b7\u5bb3\uff0c\u4f60\u7684\u8b77\u7532\u5c07\u5438\u6536 50 \u9ede\u50b7\u5bb3\uff0c\u8b93\u4f60\u5269\u4e0b 90 \u751f\u547d\u503c\u3002\u751f\u547d\u503c\u53ef\u4ee5\u4f7f\u7528\u5730\u5716\u4e0a\u96a8\u8655\u53ef\u898b\u7684\u6cbb\u7642\u5305\u4f86\u6062\u5fa9\uff0c\u800c\u8b77\u7532\u5247\u9700\u8981\u62fe\u53d6\u8b77\u7532\u7269\u54c1\u4f86\u88dc\u5145\u3002"}, {"question": "Ev.io \u5982\u4f55\u8655\u7406\u8de8\u5e73\u53f0\u76f8\u5bb9\u6027\uff0c\u73a9\u5bb6\u61c9\u8a72\u77ad\u89e3\u4ec0\u9ebc\u95dc\u65bc\u8cc7\u6599\u9077\u79fb\uff1f", "answer": "Ev.io \u900f\u904e\u5141\u8a31\u73a9\u5bb6\u5728\u4e0d\u540c\u88dd\u7f6e\u4e0a\u5b58\u53d6\u4ed6\u5011\u7684\u5e33\u6236\u548c\u9032\u5ea6\u4f86\u8655\u7406\u8de8\u5e73\u53f0\u76f8\u5bb9\u6027\u3002\u9019\u8868\u793a\u4f60\u53ef\u4ee5\u5728\u96fb\u8166\u4e0a\u958b\u59cb\u904a\u6232\uff0c\u7136\u5f8c\u5728\u4f60\u7684\u884c\u52d5\u88dd\u7f6e\u4e0a\u7e7c\u7e8c\uff0c\u800c\u4e0d\u6703\u640d\u5931\u4efb\u4f55\u8cc7\u6599\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u96fb\u8166\u4e0a\u89e3\u9396\u4e86\u4e00\u628a\u65b0\u6b66\u5668\uff0c\u5b83\u5c07\u6703\u5728\u767b\u5165\u884c\u52d5\u88dd\u7f6e\u6642\u53ef\u4ee5\u4f7f\u7528\u3002\u70ba\u4e86\u78ba\u4fdd\u9806\u66a2\u7684\u8cc7\u6599\u9077\u79fb\u904e\u7a0b\uff0c\u8acb\u52d9\u5fc5\u5c07\u4f60\u7684\u5e33\u6236\u9023\u7d50\u5230\u901a\u7528\u767b\u5165\u65b9\u5f0f\uff0c\u4f8b\u5982 Google \u6216 Facebook\u3002\u9019\u5c07\u6703\u5728\u6240\u6709\u5e73\u53f0\u4e0a\u7121\u7e2b\u540c\u6b65\u4f60\u7684\u9032\u5ea6\u3002"}, {"question": "Ev.io \u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "Ev.io \u4e2d\u5145\u6eff\u4e86\u96b1\u85cf\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u984d\u5916\u7684\u6a02\u8da3\u3002\u4e00\u500b\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\u4e00\u500b\u79d8\u5bc6\u623f\u9593\uff0c\u53ef\u4ee5\u901a\u904e\u5728\u67d0\u4e9b\u5730\u5716\u4e2d\u627e\u5230\u96b1\u85cf\u7684\u958b\u95dc\u4f86\u9032\u5165\u3002\u4f8b\u5982\uff0c\u5728\u300c\u6c99\u6f20\u524d\u54e8\u7ad9\u300d\u5730\u5716\u4e2d\uff0c\u5ca9\u77f3\u5f8c\u9762\u6709\u4e00\u500b\u958b\u95dc\uff0c\u53ef\u4ee5\u6253\u958b\u4e00\u500b\u5145\u6eff\u7a00\u6709\u7269\u54c1\u7684\u96b1\u85cf\u623f\u9593\u3002\u63a2\u7d22\u5730\u5716\u4e0a\u7684\u6bcf\u500b\u89d2\u843d\u548c\u7e2b\u9699\u53ef\u4ee5\u627e\u5230\u9019\u4e9b\u96b1\u85cf\u5bf6\u85cf\uff0c\u70ba\u73a9\u5bb6\u5e36\u4f86\u7368\u7279\u7684\u9ad4\u9a57\u548c\u6709\u50f9\u503c\u7684\u6230\u5229\u54c1\u3002"}, {"question": "\u5982\u4f55\u512a\u5316 Ev.io \u7684\u904a\u6232\u8a2d\u5b9a\u4ee5\u7372\u5f97\u66f4\u597d\u7684\u904a\u6232\u8868\u73fe\uff1f", "answer": "\u512a\u5316 Ev.io \u7684\u904a\u6232\u8a2d\u5b9a\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u4f60\u7684\u904a\u6232\u8868\u73fe\u3002\u9996\u5148\uff0c\u5c07\u5716\u5f62\u8a2d\u5b9a\u8abf\u6574\u5230\u4f60\u7684\u88dd\u7f6e\u53ef\u4ee5\u9806\u66a2\u904b\u884c\u7684\u7d1a\u5225\u3002\u4f8b\u5982\uff0c\u964d\u4f4e\u89e3\u6790\u5ea6\u4e26\u95dc\u9589\u4e0d\u5fc5\u8981\u7684\u7279\u6548\u53ef\u4ee5\u6e1b\u5c11\u5ef6\u9072\u3002\u63a5\u4e0b\u4f86\uff0c\u6839\u64da\u4f60\u7684\u904a\u6232\u98a8\u683c\u4f86\u81ea\u8a02\u4f60\u7684\u63a7\u5236\u65b9\u6848\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u559c\u6b61\u5feb\u901f\u53cd\u61c9\uff0c\u8acb\u8003\u616e\u5c07\u4f60\u6700\u5e38\u7528\u7684\u64cd\u4f5c\u7d81\u5b9a\u5230\u5bb9\u6613\u89f8\u53ca\u7684\u6309\u9375\u3002\u6b64\u5916\uff0c\u555f\u7528\u6e96\u661f\u81ea\u8a02\u548c\u8072\u97f3\u63d0\u793a\u53ef\u4ee5\u589e\u5f37\u4f60\u5728\u6bd4\u8cfd\u4e2d\u7684\u6e96\u78ba\u6027\u548c\u8b66\u89ba\u6027\u3002"}, {"question": "\u5728 Ev.io \u7684\u5927\u9003\u6bba\u6a21\u5f0f\u4e2d\uff0c\u5982\u4f55\u6700\u4f73\u5316\u8cc7\u6e90\u548c\u7d93\u6fdf\u7684\u7ba1\u7406\uff1f", "answer": "\u5728 Ev.io \u7684\u5927\u9003\u6bba\u6a21\u5f0f\u4e2d\u6709\u6548\u5730\u7ba1\u7406\u8cc7\u6e90\u548c\u7d93\u6fdf\u662f\u6210\u529f\u7684\u95dc\u9375\u3002\u6b65\u9a5f1 - \u5728\u6bd4\u8cfd\u958b\u59cb\u6642\u512a\u5148\u6436\u596a\u9ad8\u50f9\u503c\u5340\u57df\uff0c\u4ee5\u5feb\u901f\u6536\u96c6\u5fc5\u8981\u7269\u54c1\u3002\u6b65\u9a5f2 - \u660e\u667a\u5730\u4f7f\u7528\u4f60\u7684\u8cc7\u6e90\uff0c\u4f8b\u5982\u5728\u95dc\u9375\u6642\u523b\u5132\u5b58\u6cbb\u7642\u5305\uff0c\u4e26\u50c5\u5728\u5fc5\u8981\u6642\u4f7f\u7528\u624b\u69b4\u5f48\u3002\u6b65\u9a5f3 - \u6ce8\u610f\u7e2e\u5c0f\u7684\u904a\u6232\u5340\u57df\uff0c\u4e26\u8a08\u5283\u4f60\u7684\u79fb\u52d5\uff0c\u4ee5\u907f\u514d\u88ab\u56f0\u5728\u904a\u6232\u5340\u57df\u4e4b\u5916\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u767c\u73fe\u81ea\u5df1\u7684\u8cc7\u6e90\u6709\u9650\uff0c\u53ef\u4ee5\u8003\u616e\u4f0f\u64ca\u5176\u4ed6\u73a9\u5bb6\u4f86\u6436\u596a\u4ed6\u5011\u7684\u6230\u5229\u54c1\u3002\u6b64\u7b56\u7565\u53ef\u4ee5\u5e6b\u52a9\u4f60\u5728\u6574\u500b\u6bd4\u8cfd\u4e2d\u4fdd\u6301\u826f\u597d\u7684\u88dd\u5099\u3002"}]
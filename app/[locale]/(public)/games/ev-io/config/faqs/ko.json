[{"question": "Ev.io\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Ev.io\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. STEP1 - WASD \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uce90\ub9ad\ud130\ub97c \ub9f5 \uc704\uc5d0\uc11c \uc774\ub3d9\uc2dc\ud0b5\ub2c8\ub2e4. STEP2 - \uc67c\ucabd \ud074\ub9ad\uc73c\ub85c \ubc1c\uc0ac\ud558\uace0 \uc624\ub978\ucabd \ud074\ub9ad\uc73c\ub85c \uc870\uc900\ud569\ub2c8\ub2e4. STEP3 - \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \ub20c\ub7ec \uc810\ud504\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac8c\uc784\uc5d0 \ub4f1\uc7a5\ud588\uc744 \ub54c \uc815\uc9c0\ub41c \ud45c\uc801\uc5d0 \uc774\ub3d9\ud558\uace0 \uc0ac\uaca9\ud558\ub294 \uc5f0\uc2b5\uc744 \ud1b5\ud574 \ucee8\ud2b8\ub864\uc5d0 \ub300\ud55c \uac10\uac01\uc744 \uc775\ud788\uc138\uc694. \uc774\ub97c \ud1b5\ud574 \uadfc\uc721 \uae30\uc5b5\ub825\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uace0 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uac1c\uc120\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \ub610\ud55c, \uac8c\uc784 \ub0b4 \ud29c\ud1a0\ub9ac\uc5bc\uc744 \ucc38\uc870\ud558\uc5ec \ub354 \uc790\uc138\ud55c \uc548\ub0b4\ub97c \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Ev.io\uc758 \ub2e4\uc591\ud55c \ubb34\uae30 \uc720\ud615\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\uc640 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Ev.io\uc758 \ub2e4\uc591\ud55c \ubb34\uae30 \uc720\ud615\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uac01 \ubb34\uae30\ub294 \uc804\ub7b5\uc5d0 \uc0c1\ub2f9\ud55c \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uace0\uc720\ud55c \ud2b9\uc131\uc744 \uac00\uc9c0\uace0 \uc788\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc0b0\ud0c4\ucd1d\uc740 \uadfc\uc811 \uac70\ub9ac\uc5d0\uc11c \ub9e4\uc6b0 \ud6a8\uacfc\uc801\uc774\uc9c0\ub9cc \uc0ac\uac70\ub9ac\uac00 \uc81c\ud55c\uc801\uc774\uace0, \uc800\uaca9\uc18c\ucd1d\uc740 \uc7a5\uac70\ub9ac\uc5d0\uc11c \ud0c1\uc6d4\ud558\uc9c0\ub9cc \uc815\ud655\ud55c \uc870\uc900\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uac01 \ubb34\uae30\uc758 \uac15\uc810\uacfc \uc57d\uc810\uc744 \uc54c\uba74 \ub2e4\uc591\ud55c \uc0c1\ud669\uc5d0 \ub9de\ub294 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc744 \uc801\uc751\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubc00\uc9d1\ub41c \ub9f5\uc5d0\uc11c \uc0b0\ud0c4\ucd1d\uc744 \uc120\ud0dd\ud558\uba74 \uc7a5\uac70\ub9ac \ubb34\uae30\ub97c \uc0ac\uc6a9\ud558\ub294 \ud50c\ub808\uc774\uc5b4\ubcf4\ub2e4 \uc720\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Ev.io\uc758 \ube60\ub978 \uc18d\ub3c4\uc758 \ub9e4\uce58\uc5d0\uc11c \ub354 \uc624\ub798 \ubc84\ud2f0\ub294 \uc8fc\uc694 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Ev.io\uc758 \ube60\ub978 \uc18d\ub3c4\uc758 \ub9e4\uce58\uc5d0\uc11c \ub354 \uc624\ub798 \ubc84\ud2f0\ub824\uba74 \ub2e4\uc74c \uc804\ub7b5\uc744 \uace0\ub824\ud558\uc2ed\uc2dc\uc624. STEP1 - \ud56d\uc0c1 \uc8fc\ubcc0 \ud658\uacbd\uc744 \uc778\uc9c0\ud558\uace0 \uc9c0\ub3c4\ub97c \ud65c\uc6a9\ud558\uc138\uc694. STEP2 - \uc801\uc758 \uacf5\uaca9\uc744 \ud53c\ud558\uace0 \uc774\ub3d9\uc744 \uc2e0\uc911\ud558\uac8c \uacc4\ud68d\ud558\uae30 \uc704\ud574 \uc9c0\ud615\uc744 \ud65c\uc6a9\ud558\uc138\uc694. STEP3 - \ud0c4\uc57d\uacfc \uccb4\ub825 \ud68c\ubcf5\uc81c\uc640 \uac19\uc740 \uc790\uc6d0\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4 \uccb4\ub825\uc774 \ubd80\uc871\ud558\uba74 \uc704\ud5d8\ud55c \uc0c1\ud669\uc744 \ud53c\ud558\uace0 \ud68c\ubcf5\ud55c \ud6c4 \ub2e4\uc2dc \uc804\ud22c\uc5d0 \ucc38\uc5ec\ud558\uc138\uc694. \ub610\ud55c \ud300\uacfc \ud568\uaed8 \ud50c\ub808\uc774\ud558\uace0 \ud6a8\uacfc\uc801\uc73c\ub85c \uc18c\ud1b5\ud558\uba74 \uc0dd\uc874 \uac00\ub2a5\uc131\uc744 \ud06c\uac8c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Ev.io\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \uade0\ud615 \uc788\uace0 \uacf5\uc815\ud55c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc5b4\ub5bb\uac8c \ubcf4\uc7a5\ud569\ub2c8\uae4c?", "answer": "Ev.io\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \uc720\uc0ac\ud55c \uc2e4\ub825 \ub808\ubca8\uc758 \ud50c\ub808\uc774\uc5b4\ub97c \ud568\uaed8 \ubc30\uce58\ud558\uc5ec \uade0\ud615 \uc788\uace0 \uacf5\uc815\ud55c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ubcf4\uc7a5\ud569\ub2c8\ub2e4. \uc774\ub294 \uc2b9\ub960, \ud0ac\ub383, \uc804\ubc18\uc801\uc778 \uc131\ub2a5\uacfc \uac19\uc740 \ub2e4\uc591\ud55c \uc694\uc18c\ub97c \uace0\ub824\ud558\ub294 \uc54c\uace0\ub9ac\uc998\uc744 \ud1b5\ud574 \ub2ec\uc131\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub294 \ub2e4\ub978 \ucd08\ubcf4 \ud50c\ub808\uc774\uc5b4\uc640 \ub9e4\uce58\ub418\uc5b4 \ub354 \uc990\uac81\uace0 \uacbd\uc7c1\uc801\uc778 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub610\ud55c, \ud50c\ub808\uc774\uc5b4\uc758 \uc2e4\ub825 \ud5a5\uc0c1 \ub610\ub294 \uc800\ud558\uc5d0 \ub530\ub77c \uc2dc\uc2a4\ud15c\uc740 \uade0\ud615\uc744 \uc720\uc9c0\ud558\uae30 \uc704\ud574 \uc9c0\uc18d\uc801\uc73c\ub85c \ud50c\ub808\uc774\uc5b4 \uc21c\uc704\ub97c \uc5c5\ub370\uc774\ud2b8\ud569\ub2c8\ub2e4."}, {"question": "Ev.io\uc758 \uacbd\uc7c1 \ubaa8\ub4dc\uc5d0\uc11c \uc6b0\uc704\ub97c \uc810\ud558\uae30 \uc704\ud55c \uace0\uae09 \uc804\uc220\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Ev.io\uc758 \uacbd\uc7c1 \ubaa8\ub4dc\uc5d0\uc11c \uc6b0\uc704\ub97c \uc810\ud558\uae30 \uc704\ud574\uc11c\ub294 \ub2e4\uc74c\uacfc \uac19\uc740 \uace0\uae09 \uc804\uc220\uc744 \uace0\ub824\ud558\uc138\uc694. STEP1 - \uc790\uc2e0\uc744 \ud0c0\uaca9\ud558\uae30 \uc5b4\ub835\uac8c \ub9cc\ub4dc\ub294 \ud68c\ud53c \uae30\uc220\uc744 \uc775\ud788\uc138\uc694. STEP2 - \uc801\uc758 \uc6c0\uc9c1\uc784\uc744 \uc608\uce21\ud558\uace0 \uc77c\ubc18\uc801\uc778 \uacbd\ub85c\ub97c \ubbf8\ub9ac \uc870\uc900\ud558\ub294 \uc5f0\uc2b5\uc744 \ud558\uc138\uc694. STEP3 - \uc218\ub958\ud0c4\uacfc \uae30\ud0c0 \uc720\ud2f8\ub9ac\ud2f0 \uc544\uc774\ud15c\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc804\uc7a5\uc744 \uc81c\uc5b4\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ubd90\ube44\ub294 \uc9c0\uc5ed\uc5d0 \uc218\ub958\ud0c4\uc744 \ub358\uc9c0\uba74 \uc801\ub4e4\uc774 \uc0b0\ub780\ud558\uace0 \ud300\uc774 \uc804\uc9c4\ud560 \uae30\ud68c\ub97c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \ud300\uacfc\uc758 \ud611\ub825\uc744 \ud1b5\ud574 \ub3d9\uc2dc \uacf5\uaca9\uc744 \uc2e4\ud589\ud558\uba74 \uc555\ub3c4\uc801\uc778 \uc2b9\ub9ac\ub97c \uac70\ub458 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Ev.io\uc758 \uccb4\ub825 \ubc0f \uc7a5\uac11 \uc2dc\uc2a4\ud15c\uc758 \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Ev.io\uc758 \uccb4\ub825 \ubc0f \uc7a5\uac11 \uc2dc\uc2a4\ud15c\uc740 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uae4a\uc774\ub97c \ub354\ud558\uae30 \uc704\ud574 \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uccb4\ub825\uc740 \uce90\ub9ad\ud130\uc758 \ud65c\ub825\uc744 \ub098\ud0c0\ub0b4\uace0, \uc7a5\uac11\uc740 \ub4e4\uc5b4\uc624\ub294 \ud53c\ud574\uc5d0 \ub300\ud55c \ucd94\uac00\uc801\uc778 \ubcf4\ud638\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ud53c\ud574\ub97c \uc785\uc73c\uba74 \uc7a5\uac11\uc774 \uc77c\ubd80 \ud53c\ud574\ub97c \ud761\uc218\ud558\uace0 \uadf8 \ud6c4 \uccb4\ub825\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccb4\ub825\uc774 100\uc774\uace0 \uc7a5\uac11\uc774 50\uc77c \ub54c 60\uc758 \ud53c\ud574\ub97c \uc785\uc73c\uba74 \uc7a5\uac11\uc774 50\uc758 \ud53c\ud574\ub97c \ud761\uc218\ud558\uc5ec \uccb4\ub825\uc740 90\uc73c\ub85c \ub0a8\uc2b5\ub2c8\ub2e4. \uccb4\ub825\uc740 \ub9f5 \uacf3\uacf3\uc5d0 \uc788\ub294 \uccb4\ub825 \ud68c\ubcf5\uc81c\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud68c\ubcf5\ud560 \uc218 \uc788\uc9c0\ub9cc, \uc7a5\uac11\uc740 \uc7a5\uac11 \uc544\uc774\ud15c\uc744 \ud68d\ub4dd\ud558\uc5ec \uc7ac\ucda9\uc804\ud574\uc57c \ud569\ub2c8\ub2e4."}, {"question": "Ev.io\ub294 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud638\ud658\uc131\uc744 \uc5b4\ub5bb\uac8c \ucc98\ub9ac\ud558\uba70, \ub370\uc774\ud130 \ub9c8\uc774\uadf8\ub808\uc774\uc158\uc5d0 \ub300\ud574 \ud50c\ub808\uc774\uc5b4\uac00 \uc54c\uc544\uc57c \ud560 \uac83\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Ev.io\ub294 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud638\ud658\uc131\uc744 \ucc98\ub9ac\ud558\uc5ec \ud50c\ub808\uc774\uc5b4\uac00 \ub2e4\uc591\ud55c \uae30\uae30\uc5d0\uc11c \uacc4\uc815\uacfc \uc9c4\ud589 \uc0c1\ud669\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. \uc989, PC\uc5d0\uc11c \uac8c\uc784\uc744 \uc2dc\uc791\ud558\uc5ec \ubaa8\ubc14\uc77c \uae30\uae30\uc5d0\uc11c \uacc4\uc18d\ud560 \uc218 \uc788\uc73c\uba70 \ub370\uc774\ud130\ub97c \uc783\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ubb34\uae30\ub97c \ud574\uc81c\ud558\uba74 \ubaa8\ubc14\uc77c\uc5d0 \ub85c\uadf8\uc778\ud588\uc744 \ub54c\ub3c4 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc6d0\ud65c\ud55c \ub370\uc774\ud130 \ub9c8\uc774\uadf8\ub808\uc774\uc158\uc744 \uc704\ud574 Google \ub610\ub294 Facebook\uacfc \uac19\uc740 \ubcf4\ud3b8\uc801\uc778 \ub85c\uadf8\uc778 \ubc29\ubc95\uc5d0 \uacc4\uc815\uc744 \uc5f0\uacb0\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \uc774\ub807\uac8c \ud558\uba74 \ubaa8\ub4e0 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc774 \uc6d0\ud65c\ud558\uac8c \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4."}, {"question": "Ev.io\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Ev.io\uc5d0\ub294 \uac8c\uc784\uc5d0 \uc7ac\ubbf8\ub97c \ub354\ud558\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ub9ce\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ub208\uc5d0 \ub744\ub294 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ud2b9\uc815 \ub9f5\uc5d0\uc11c \uc228\uaca8\uc9c4 \uc2a4\uc704\uce58\ub97c \ucc3e\uc73c\uba74 \uc811\uadfc\ud560 \uc218 \uc788\ub294 \ube44\ubc00 \ubc29\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc0ac\ub9c9 \uc804\ucd08 \uae30\uc9c0' \ub9f5\uc5d0\uc11c\ub294 \ubc14\uc704 \ub4a4\uc5d0 \uc228\uaca8\uc9c4 \uc2a4\uc704\uce58\ub97c \ud1b5\ud574 \ud76c\uadc0 \uc544\uc774\ud15c\uc73c\ub85c \uac00\ub4dd \ucc2c \ube44\ubc00 \ubc29\uc744 \uc5f4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub9f5\uc758 \ubaa8\ub4e0 \uad6c\uc11d\uad6c\uc11d\uc744 \ud0d0\ud5d8\ud558\uba74 \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uc744 \ubc1c\uacac\ud558\uc5ec \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ub3c5\ud2b9\ud55c \uacbd\ud5d8\uacfc \uac00\uce58 \uc788\ub294 \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}, {"question": "Ev.io\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\ub294 \uac8c\uc784 \ub0b4 \uc124\uc815\uc744 \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud558\uc5ec \uc131\ub2a5\uc744 \uac1c\uc120\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Ev.io\uc5d0\uc11c \uac8c\uc784 \ub0b4 \uc124\uc815\uc744 \ucd5c\uc801\ud654\ud558\uba74 \uc131\ub2a5\uc744 \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uba3c\uc800, \uae30\uae30\uac00 \uc6d0\ud65c\ud558\uac8c \ucc98\ub9ac\ud560 \uc218 \uc788\ub294 \uc218\uc900\uc73c\ub85c \uadf8\ub798\ud53d \uc124\uc815\uc744 \uc870\uc815\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ud574\uc0c1\ub3c4\ub97c \ub0ae\ucd94\uace0 \ubd88\ud544\uc694\ud55c \ud6a8\uacfc\ub97c \ub044\uba74 \uc9c0\uc5f0 \ud604\uc0c1\uc744 \uc904\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\uc74c\uc73c\ub85c, \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\ub294 \ucee8\ud2b8\ub864 \uc2a4\ud0a4\ub9c8\ub97c \uc0ac\uc6a9\uc790 \uc815\uc758\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ube60\ub978 \ubc18\uc751\uc744 \uc120\ud638\ud558\ub294 \uacbd\uc6b0 \uc790\uc8fc \uc0ac\uc6a9\ud558\ub294 \uc791\uc5c5\uc744 \uc27d\uac8c \uc811\uadfc\ud560 \uc218 \uc788\ub294 \ud0a4\uc5d0 \ubc14\uc778\ub529\ud558\uc2ed\uc2dc\uc624. \ub610\ud55c, \uc870\uc900\uc120 \uc0ac\uc6a9\uc790 \uc815\uc758 \ubc0f \uc0ac\uc6b4\ub4dc \uc2e0\ud638\ub97c \uc0ac\uc6a9\ud558\uba74 \ub9e4\uce58 \uc911 \uc815\ud655\ub3c4 \ubc0f \uc778\uc9c0\ub3c4\ub97c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Ev.io\uc758 \ubc30\ud2c0 \ub85c\uc584 \ubaa8\ub4dc\uc5d0\uc11c \uc790\uc6d0\uacfc \uacbd\uc81c\ub97c \uad00\ub9ac\ud558\ub294 \ucd5c\uc0c1\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Ev.io\uc758 \ubc30\ud2c0 \ub85c\uc584 \ubaa8\ub4dc\uc5d0\uc11c \uc790\uc6d0\uacfc \uacbd\uc81c\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \uac83\uc740 \uc131\uacf5\uc758 \uc5f4\uc1e0\uc785\ub2c8\ub2e4. STEP1 - \ub9e4\uce58 \uc2dc\uc791 \uc2dc \uc911\uc694\ud55c \uc544\uc774\ud15c\uc744 \uc2e0\uc18d\ud558\uac8c \uc218\uc9d1\ud558\uae30 \uc704\ud574 \uace0\uac00\uce58 \uc9c0\uc5ed\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uc57d\ud0c8\ud558\uc138\uc694. STEP2 - \uc790\uc6d0\uc744 \ud604\uba85\ud558\uac8c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc704\uae09\ud55c \uc21c\uac04\uc5d0 \uccb4\ub825 \ud68c\ubcf5\uc81c\ub97c \uc808\uc57d\ud558\uace0 \uc218\ub958\ud0c4\uc740 \ud544\uc694\ud560 \ub54c\ub9cc \uc0ac\uc6a9\ud558\uc138\uc694. STEP3 - \ucd95\uc18c\ud558\ub294 \ud50c\ub808\uc774 \uc601\uc5ed\uc744 \uc8fc\uc2dc\ud558\uace0, \uadf8 \ubc16\uc5d0 \uac07\ud788\uc9c0 \uc54a\ub3c4\ub85d \uc774\ub3d9 \uacc4\ud68d\uc744 \uc138\uc6b0\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc790\uc6d0\uc774 \ubd80\uc871\ud55c \uacbd\uc6b0 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub97c \uc2b5\uaca9\ud558\uc5ec \uc804\ub9ac\ud488\uc744 \ud6d4\uce58\ub294 \uac83\uc744 \uace0\ub824\ud558\uc138\uc694. \uc774 \uc804\ub7b5\uc740 \ub9e4\uce58 \ub0b4\ub0b4 \uc798 \uc900\ube44\ud560 \uc218 \uc788\ub3c4\ub85d \ub3c4\uc640\uc90d\ub2c8\ub2e4."}]
[{"question": "Ev.io\u306e\u57fa\u672c\u64cd\u4f5c\u3067\u3001\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u8fc5\u901f\u306b\u59cb\u3081\u308b\u65b9\u6cd5\u306f\uff1f", "answer": "Ev.io\u306e\u57fa\u672c\u64cd\u4f5c\u3067\u8fc5\u901f\u306b\u59cb\u3081\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002STEP1 - WASD\u30ad\u30fc\u3092\u4f7f\u3063\u3066\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u30de\u30c3\u30d7\u4e0a\u3092\u79fb\u52d5\u3055\u305b\u307e\u3059\u3002STEP2 - \u5de6\u30af\u30ea\u30c3\u30af\u3067\u5c04\u6483\u3057\u3001\u53f3\u30af\u30ea\u30c3\u30af\u3067\u7167\u6e96\u3092\u5408\u308f\u305b\u307e\u3059\u3002STEP3 - \u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u3092\u62bc\u3057\u3066\u30b8\u30e3\u30f3\u30d7\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b2\u30fc\u30e0\u306b\u53c2\u52a0\u3057\u305f\u3068\u304d\u3001\u9759\u6b62\u3057\u305f\u6a19\u7684\u3092\u79fb\u52d5\u3057\u3066\u5c04\u6483\u3059\u308b\u7df4\u7fd2\u3092\u3059\u308b\u3053\u3068\u3067\u3001\u64cd\u4f5c\u611f\u304c\u5f97\u3089\u308c\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u7b4b\u8089\u8a18\u61b6\u3092\u69cb\u7bc9\u3057\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u8a73\u7d30\u306a\u624b\u9806\u306b\u3064\u3044\u3066\u306f\u3001\u30b2\u30fc\u30e0\u5185\u306e\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3092\u53c2\u7167\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "Ev.io\u306e\u3055\u307e\u3056\u307e\u306a\u6b66\u5668\u306e\u7a2e\u985e\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3042\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u306f\u3069\u306e\u3088\u3046\u306b\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "Ev.io\u306e\u3055\u307e\u3056\u307e\u306a\u6b66\u5668\u306e\u7a2e\u985e\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u91cd\u8981\u3067\u3059\u3002\u306a\u305c\u306a\u3089\u3001\u5404\u6b66\u5668\u306b\u306f\u3001\u6226\u7565\u306b\u5927\u304d\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u72ec\u81ea\u306e\u7279\u6027\u304c\u3042\u308b\u304b\u3089\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\u306f\u8fd1\u8ddd\u96e2\u3067\u975e\u5e38\u306b\u52b9\u679c\u7684\u3067\u3059\u304c\u3001\u5c04\u7a0b\u8ddd\u96e2\u306f\u9650\u3089\u308c\u3066\u3044\u307e\u3059\u3002\u4e00\u65b9\u3001\u30b9\u30ca\u30a4\u30d1\u30fc\u30e9\u30a4\u30d5\u30eb\u306f\u9577\u8ddd\u96e2\u3067\u512a\u308c\u3066\u3044\u307e\u3059\u304c\u3001\u6b63\u78ba\u306a\u7167\u6e96\u304c\u5fc5\u8981\u3067\u3059\u3002\u5404\u6b66\u5668\u306e\u9577\u6240\u3068\u77ed\u6240\u3092\u77e5\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u3001\u72b6\u6cc1\u306b\u5408\u308f\u305b\u3066\u81ea\u5206\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u3092\u8abf\u6574\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u8fd1\u63a5\u30de\u30c3\u30d7\u3067\u306f\u3001\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\u3092\u9078\u629e\u3059\u308b\u3053\u3068\u3067\u3001\u9577\u8ddd\u96e2\u6b66\u5668\u3092\u4f7f\u7528\u3059\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u3088\u308a\u3082\u512a\u4f4d\u306b\u7acb\u3066\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "Ev.io\u306e\u30da\u30fc\u30b9\u306e\u901f\u3044\u8a66\u5408\u3067\u9577\u304f\u751f\u304d\u6b8b\u308b\u305f\u3081\u306e\u4e3b\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Ev.io\u306e\u30da\u30fc\u30b9\u306e\u901f\u3044\u8a66\u5408\u3067\u9577\u304f\u751f\u304d\u6b8b\u308b\u306b\u306f\u3001\u6b21\u306e\u6226\u7565\u3092\u8003\u616e\u3057\u3066\u304f\u3060\u3055\u3044\u3002STEP1 - \u5468\u56f2\u3092\u5e38\u306b\u6ce8\u610f\u3057\u3001\u30de\u30c3\u30d7\u3092\u81ea\u5206\u306e\u6709\u5229\u306b\u6d3b\u7528\u3057\u307e\u3059\u3002STEP2 - \u6575\u306e\u653b\u6483\u3092\u56de\u907f\u3057\u3001\u614e\u91cd\u306b\u52d5\u304d\u3092\u8a08\u753b\u3059\u308b\u305f\u3081\u306b\u3001\u96a0\u853d\u3092\u5229\u7528\u3057\u307e\u3059\u3002STEP3 - \u5f3e\u85ac\u3084\u56de\u5fa9\u85ac\u306a\u3069\u306e\u30ea\u30bd\u30fc\u30b9\u3092\u52b9\u7387\u7684\u306b\u7ba1\u7406\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u4f53\u529b\u4e0d\u8db3\u306b\u9665\u3063\u305f\u5834\u5408\u306f\u3001\u5b89\u5168\u306a\u5834\u6240\u306b\u5f8c\u9000\u3057\u3066\u56de\u5fa9\u3057\u3066\u304b\u3089\u3001\u518d\u3073\u6226\u3044\u306b\u53c2\u52a0\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u307e\u305f\u3001\u30c1\u30fc\u30e0\u3068\u9023\u643a\u3057\u3001\u52b9\u679c\u7684\u306b\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u3092\u3068\u308b\u3053\u3068\u3067\u3001\u751f\u5b58\u7387\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Ev.io\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u516c\u5e73\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u3069\u306e\u3088\u3046\u306b\u4fdd\u8a3c\u3057\u307e\u3059\u304b\uff1f", "answer": "Ev.io\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u304c\u985e\u4f3c\u3059\u308b\u3088\u3046\u306b\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u30da\u30a2\u30ea\u30f3\u30b0\u3059\u308b\u3053\u3068\u3067\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u516c\u5e73\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u52dd\u6557\u7387\u3001\u30ad\u30eb\u30c7\u30b9\u6bd4\u3001\u5168\u4f53\u7684\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306a\u3069\u306e\u3055\u307e\u3056\u307e\u306a\u8981\u56e0\u3092\u8003\u616e\u3059\u308b\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306b\u3088\u3063\u3066\u5b9f\u73fe\u3057\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u3042\u308b\u5834\u5408\u3001\u4ed6\u306e\u521d\u5fc3\u8005\u3068\u30de\u30c3\u30c1\u30f3\u30b0\u3055\u308c\u3001\u3088\u308a\u697d\u3057\u304f\u7af6\u4e89\u7684\u306a\u4f53\u9a13\u304c\u63d0\u4f9b\u3055\u308c\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b9\u30ad\u30eb\u304c\u5411\u4e0a\u3057\u305f\u308a\u4f4e\u4e0b\u3057\u305f\u308a\u3059\u308b\u306b\u3064\u308c\u3066\u3001\u30d0\u30e9\u30f3\u30b9\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u30e9\u30f3\u30ad\u30f3\u30b0\u3092\u7d99\u7d9a\u7684\u306b\u66f4\u65b0\u3057\u307e\u3059\u3002"}, {"question": "Ev.io\u306e\u7af6\u6280\u30e2\u30fc\u30c9\u3067\u512a\u4f4d\u306b\u7acb\u3064\u305f\u3081\u306b\u4f7f\u7528\u3067\u304d\u308b\u9ad8\u5ea6\u306a\u6226\u8853\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Ev.io\u306e\u7af6\u6280\u30e2\u30fc\u30c9\u3067\u512a\u4f4d\u306b\u7acb\u3064\u306b\u306f\u3001\u6b21\u306e\u9ad8\u5ea6\u306a\u6226\u8853\u3092\u8003\u616e\u3057\u3066\u304f\u3060\u3055\u3044\u3002STEP1 - \u30b9\u30c6\u30a3\u30f3\u30b0\u3092\u30de\u30b9\u30bf\u30fc\u3057\u3066\u3001\u653b\u6483\u3055\u308c\u306b\u304f\u3044\u30bf\u30fc\u30b2\u30c3\u30c8\u306b\u3057\u307e\u3059\u3002STEP2 - \u6575\u306e\u52d5\u304d\u3092\u4e88\u6e2c\u3057\u3001\u4e00\u822c\u7684\u306a\u901a\u8def\u3092\u4e8b\u524d\u306b\u72d9\u3046\u3053\u3068\u3092\u5b66\u3073\u307e\u3059\u3002STEP3 - \u624b\u69b4\u5f3e\u3084\u305d\u306e\u4ed6\u306e\u30e6\u30fc\u30c6\u30a3\u30ea\u30c6\u30a3\u30a2\u30a4\u30c6\u30e0\u3092\u4f7f\u7528\u3057\u3066\u3001\u6226\u5834\u3092\u652f\u914d\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u624b\u69b4\u5f3e\u3092\u5bc6\u96c6\u3057\u305f\u5834\u6240\u306b\u6295\u3052\u8fbc\u3080\u3068\u3001\u6575\u3092\u5206\u6563\u3055\u305b\u3001\u30c1\u30fc\u30e0\u304c\u524d\u9032\u3059\u308b\u6a5f\u4f1a\u3092\u4f5c\u308a\u51fa\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30c1\u30fc\u30e0\u3068\u9023\u643a\u3057\u3066\u540c\u6642\u653b\u6483\u3092\u5b9f\u884c\u3059\u308b\u3053\u3068\u3067\u3001\u5727\u5012\u7684\u306a\u52dd\u5229\u306b\u3064\u306a\u304c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "Ev.io\u306e\u4f53\u529b\u3068\u30a2\u30fc\u30de\u30fc\u30b7\u30b9\u30c6\u30e0\u306e\u3057\u304f\u307f\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Ev.io\u306e\u4f53\u529b\u3068\u30a2\u30fc\u30de\u30fc\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u6df1\u307f\u3092\u52a0\u3048\u308b\u3088\u3046\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u4f53\u529b\u306f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u751f\u547d\u529b\u3092\u8868\u3057\u3001\u30a2\u30fc\u30de\u30fc\u306f\u53d7\u3051\u305f\u30c0\u30e1\u30fc\u30b8\u306b\u5bfe\u3059\u308b\u8ffd\u52a0\u306e\u9632\u5fa1\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u30c0\u30e1\u30fc\u30b8\u3092\u53d7\u3051\u308b\u3068\u3001\u30a2\u30fc\u30de\u30fc\u306f\u4f53\u529b\u304c\u5f71\u97ff\u3092\u53d7\u3051\u308b\u524d\u306b\u305d\u306e\u4e00\u90e8\u3092\u5438\u53ce\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u4f53\u529b100\u3001\u30a2\u30fc\u30de\u30fc50\u304c\u3042\u308b\u3068\u300160\u306e\u30c0\u30e1\u30fc\u30b8\u3092\u53d7\u3051\u308b\u3068\u3001\u30a2\u30fc\u30de\u30fc\u304c50\u3092\u5438\u53ce\u3057\u3001\u4f53\u529b\u306f90\u306b\u306a\u308a\u307e\u3059\u3002\u4f53\u529b\u3092\u56de\u5fa9\u3059\u308b\u306b\u306f\u3001\u30de\u30c3\u30d7\u4e2d\u306b\u6563\u3089\u3070\u3063\u3066\u3044\u308b\u56de\u5fa9\u85ac\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u4e00\u65b9\u3001\u30a2\u30fc\u30de\u30fc\u306f\u30a2\u30fc\u30de\u30fc\u30a2\u30a4\u30c6\u30e0\u3092\u62fe\u3046\u3053\u3068\u3067\u88dc\u5145\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "Ev.io\u306f\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u4e92\u63db\u6027\u3092\u3069\u306e\u3088\u3046\u306b\u51e6\u7406\u3057\u3001\u30c7\u30fc\u30bf\u79fb\u884c\u306b\u95a2\u3057\u3066\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u4f55\u3092\u77e5\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "Ev.io\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u4e0a\u3067\u81ea\u5206\u306e\u30a2\u30ab\u30a6\u30f3\u30c8\u3068\u9032\u884c\u72b6\u6cc1\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u3088\u3046\u306b\u3059\u308b\u3053\u3068\u3067\u3001\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u4e92\u63db\u6027\u3092\u51e6\u7406\u3057\u307e\u3059\u3002\u3064\u307e\u308a\u3001PC\u3067\u30d7\u30ec\u30a4\u3092\u59cb\u3081\u3001\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u3067\u30d7\u30ec\u30a4\u3092\u7d9a\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u3001\u30c7\u30fc\u30bf\u306f\u5931\u308f\u308c\u307e\u305b\u3093\u3002\u4f8b\u3048\u3070\u3001PC\u3067\u65b0\u3057\u3044\u6b66\u5668\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u3068\u3001\u30e2\u30d0\u30a4\u30eb\u3067\u30ed\u30b0\u30a4\u30f3\u3057\u305f\u3068\u304d\u306b\u5229\u7528\u53ef\u80fd\u3067\u3059\u3002\u30b9\u30e0\u30fc\u30ba\u306a\u30c7\u30fc\u30bf\u79fb\u884c\u30d7\u30ed\u30bb\u30b9\u3092\u78ba\u4fdd\u3059\u308b\u305f\u3081\u306b\u3001Google\u3084Facebook\u306a\u3069\u306e\u30e6\u30cb\u30d0\u30fc\u30b5\u30eb\u30ed\u30b0\u30a4\u30f3\u65b9\u6cd5\u306b\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30ea\u30f3\u30af\u3059\u308b\u3053\u3068\u3092\u304a\u52e7\u3081\u3057\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u3059\u3079\u3066\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u308f\u305f\u3063\u3066\u9032\u884c\u72b6\u6cc1\u304c\u30b7\u30fc\u30e0\u30ec\u30b9\u306b\u540c\u671f\u3055\u308c\u307e\u3059\u3002"}, {"question": "Ev.io\u306b\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u767a\u898b\u3067\u304d\u308b\u96a0\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Ev.io\u306b\u306f\u3001\u30b2\u30fc\u30e0\u306b\u8ffd\u52a0\u306e\u697d\u3057\u307f\u3092\u52a0\u3048\u308b\u96a0\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u6e80\u8f09\u3067\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306e1\u3064\u306f\u3001\u7279\u5b9a\u306e\u30de\u30c3\u30d4\u30f3\u30b0\u3067\u96a0\u3055\u308c\u305f\u30b9\u30a4\u30c3\u30c1\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u3067\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u79d8\u5bc6\u306e\u90e8\u5c4b\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u7802\u6f20\u306e\u62e0\u70b9\u300d\u30de\u30c3\u30d7\u3067\u306f\u3001\u5ca9\u306e\u88cf\u306b\u3042\u308b\u30b9\u30a4\u30c3\u30c1\u3092\u4f7f\u3063\u3066\u3001\u30ec\u30a2\u30a2\u30a4\u30c6\u30e0\u304c\u3044\u3063\u3071\u3044\u5165\u3063\u305f\u96a0\u308c\u305f\u90e8\u5c4b\u3092\u958b\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30de\u30c3\u30d7\u306e\u9685\u3005\u307e\u3067\u63a2\u308b\u3068\u3001\u3053\u308c\u3089\u306e\u96a0\u308c\u305f\u5b9d\u77f3\u3092\u767a\u898b\u3057\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u30e6\u30cb\u30fc\u30af\u306a\u7d4c\u9a13\u3068\u8cb4\u91cd\u306a\u6226\u5229\u54c1\u3092\u4e0e\u3048\u3066\u304f\u308c\u308b\u3067\u3057\u3087\u3046\u3002"}, {"question": "Ev.io\u3067\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u306b\u3001\u30b2\u30fc\u30e0\u5185\u306e\u8a2d\u5b9a\u3092\u3069\u306e\u3088\u3046\u306b\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Ev.io\u3067\u30b2\u30fc\u30e0\u5185\u8a2d\u5b9a\u3092\u6700\u9069\u5316\u3059\u308b\u3053\u3068\u3067\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002\u307e\u305a\u3001\u30c7\u30d0\u30a4\u30b9\u304c\u30b9\u30e0\u30fc\u30ba\u306b\u51e6\u7406\u3067\u304d\u308b\u30ec\u30d9\u30eb\u306b\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3092\u8abf\u6574\u3059\u308b\u3053\u3068\u304b\u3089\u59cb\u3081\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u89e3\u50cf\u5ea6\u3092\u4e0b\u3052\u3066\u3001\u4e0d\u8981\u306a\u52b9\u679c\u3092\u30aa\u30d5\u306b\u3059\u308b\u3053\u3068\u3067\u3001\u30e9\u30b0\u3092\u8efd\u6e1b\u3067\u304d\u307e\u3059\u3002\u6b21\u306b\u3001\u81ea\u5206\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u5408\u3063\u305f\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u30b9\u30ad\u30fc\u30e0\u3092\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u7d20\u65e9\u3044\u53cd\u5fdc\u3092\u597d\u3080\u5834\u5408\u306f\u3001\u3082\u3063\u3068\u3082\u4f7f\u7528\u3059\u308b\u64cd\u4f5c\u3092\u7c21\u5358\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u30ad\u30fc\u306b\u30d0\u30a4\u30f3\u30c9\u3059\u308b\u3053\u3068\u3092\u691c\u8a0e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3055\u3089\u306b\u3001\u30af\u30ed\u30b9\u30d8\u30a2\u306e\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3068\u97f3\u306e\u30d2\u30f3\u30c8\u3092\u6709\u52b9\u306b\u3059\u308b\u3053\u3068\u3067\u3001\u8a66\u5408\u4e2d\u306e\u6b63\u78ba\u6027\u3068\u8a8d\u8b58\u3092\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Ev.io\u306e\u30d0\u30c8\u30eb\u30ed\u30a4\u30e4\u30eb\u30e2\u30fc\u30c9\u3067\u30ea\u30bd\u30fc\u30b9\u3068\u7d4c\u6e08\u3092\u7ba1\u7406\u3059\u308b\u6700\u5584\u306e\u65b9\u6cd5\u306f\uff1f", "answer": "Ev.io\u306e\u30d0\u30c8\u30eb\u30ed\u30a4\u30e4\u30eb\u30e2\u30fc\u30c9\u3067\u30ea\u30bd\u30fc\u30b9\u3068\u7d4c\u6e08\u3092\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3059\u308b\u3053\u3068\u306f\u3001\u6210\u529f\u3078\u306e\u9375\u3067\u3059\u3002STEP1 - \u30de\u30c3\u30c1\u306e\u958b\u59cb\u6642\u306b\u9ad8\u4fa1\u5024\u306e\u30a8\u30ea\u30a2\u3092\u512a\u5148\u3057\u3066\u7565\u596a\u3057\u3001\u3059\u3050\u306b\u5fc5\u8981\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u96c6\u3081\u307e\u3059\u3002STEP2 - \u30ea\u30bd\u30fc\u30b9\u3092\u8ce2\u304f\u4f7f\u7528\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u56de\u5fa9\u85ac\u306f\u7dca\u6025\u4e8b\u614b\u306b\u5099\u3048\u3001\u624b\u69b4\u5f3e\u306f\u5fc5\u8981\u6642\u306b\u306e\u307f\u4f7f\u7528\u3057\u307e\u3059\u3002STEP3 - \u7e2e\u5c0f\u3059\u308b\u30d7\u30ec\u30a4\u30a8\u30ea\u30a2\u3092\u5e38\u306b\u76e3\u8996\u3057\u3001\u305d\u306e\u5916\u306b\u9589\u3058\u8fbc\u3081\u3089\u308c\u306a\u3044\u3088\u3046\u306b\u3001\u52d5\u304d\u3092\u8a08\u753b\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ea\u30bd\u30fc\u30b9\u304c\u9650\u3089\u308c\u3066\u3044\u308b\u5834\u5408\u306f\u3001\u305d\u306e\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u8972\u6483\u3057\u3066\u6226\u5229\u54c1\u3092\u596a\u3046\u3053\u3068\u3092\u691c\u8a0e\u3057\u307e\u3059\u3002\u3053\u306e\u6226\u7565\u306f\u3001\u8a66\u5408\u3092\u901a\u3057\u3066\u5341\u5206\u306a\u88c5\u5099\u3092\u7dad\u6301\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}]
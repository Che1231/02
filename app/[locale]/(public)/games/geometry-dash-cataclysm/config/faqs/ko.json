[{"question": "Geometry Dash Cataclysm\uc5d0\uc11c \uae30\ubcf8 \uc810\ud504\uc640 \uc7a5\uc560\ubb3c \uadf9\ubcf5 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Geometry Dash Cataclysm\uc5d0\uc11c\ub294 \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uc810\ud504 \ud0c0\uc774\ubc0d\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc2a4\ud398\uc774\uc2a4\ubc14 \ub610\ub294 \ub9c8\uc6b0\uc2a4 \ud074\ub9ad\uc73c\ub85c \uce90\ub9ad\ud130\ub97c \uc810\ud504\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c\ub294 \ud1b5\uacfc\ud558\uae30 \uc704\ud574 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uc758 \ub2e8\uc77c \uc810\ud504\uac00 \ud544\uc694\ud55c \uac04\ub2e8\ud55c \uc2a4\ud30c\uc774\ud06c\uac00 \ub098\uc635\ub2c8\ub2e4. \ub354 \uae34 \uc810\ud504\ub97c \uc704\ud574 \uc810\ud504 \ubc84\ud2bc\uc744 \ub204\ub974\uace0 \uc788\uac70\ub098 \uc9e7\uc740 \uc810\ud504\ub97c \uc704\ud574 \ud0ed\ud551\ud558\ub294 \uc5f0\uc2b5\uc744 \ud574\ubcf4\uc138\uc694. \ucd08\ubcf4\uc790\ub294 \uc7a5\uc560\ubb3c \ud328\ud134\uc744 \uc554\uae30\ud558\uace0 \ube60\ub974\uac8c \ubc18\uc751\ud558\ub294 \ub370 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. \ud328\ub110\ud2f0 \uc5c6\uc774 \ud0c0\uc774\ubc0d\uc744 \uc5f0\ub9c8\ud558\uae30 \uc704\ud574 \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc138\uc694."}, {"question": "Geometry Dash Cataclysm\uc774 \uc2e0\uaddc \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc5b4\ub824\uc6b4 \uc774\uc720\uc640 \uac1c\uc120 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Geometry Dash Cataclysm\uc740 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uacfc \ube60\ub978 \uac8c\uc784 \ud50c\ub808\uc774\ub85c \uc778\ud574 \uc2e0\uaddc \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc555\ub3c4\uc801\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac1c\uc120\ud558\uae30 \uc704\ud574 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. \ub2e8\uacc4 1: \uadfc\uc721 \uae30\uc5b5\uc744 \uc313\uae30 \uc704\ud574 \uc26c\uc6b4 \ub808\ubca8\ubd80\ud130 \uc2dc\uc791\ud558\uc138\uc694. \ub2e8\uacc4 2: \uc5b4\ub824\uc6b4 \ubd80\ubd84\uc744 \ubd84\ub9ac\ud558\uc5ec \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \ud65c\uc6a9\ud558\uc138\uc694. \ub2e8\uacc4 3: \uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\uc758 \ub9ac\ud50c\ub808\uc774\ub97c \ucc38\uace0\ud558\uc5ec \uc804\ub7b5\uc744 \ubc30\uc6b0\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, 'Electrodynamix' \ub808\ubca8\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\ub4e4\uc740 \uc885\uc885 \ubc30 \ubd80\ubd84\uc5d0\uc11c \uc5b4\ub824\uc6c0\uc744 \uacaa\ub294\ub370, \uc774 \ubd80\ubd84\uc744 \ubc18\ubcf5\uc801\uc73c\ub85c \uc5f0\uc2b5\ud558\uba74 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \uc778\ub0b4\uc2ec\uacfc \ub048\uae30\ub294 \uac8c\uc784 \ub9c8\uc2a4\ud130\ub9c1\uc758 \uc5f4\uc1e0\uc785\ub2c8\ub2e4."}, {"question": "Geometry Dash Cataclysm\uc758 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Geometry Dash Cataclysm\uc758 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\ub824\uba74 \uace0\uae09 \uc804\ub7b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \ub808\ubca8\uc744 \uc791\uc740 \ubd80\ubd84\uc73c\ub85c \ub098\ub204\uace0 \uac01 \ubd80\ubd84\uc744 \uac1c\ubcc4\uc801\uc73c\ub85c \uc5f0\uc2b5\ud558\uc138\uc694. \ub2e8\uacc4 2: \uc2dc\uac01\uc801 \ub2e8\uc11c\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uc815\ud655\ud558\uac8c \uc870\uc815\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, 'Cataclysm' \ub808\ubca8\uc758 \ud30c\ub3c4 \ubd80\ubd84\uc740 \uc815\ud655\ud55c \uc81c\uc5b4\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \uc6c0\uc9c1\uc784\uc744 \ub9ac\ub4ec\uacfc \uc77c\uce58\uc2dc\ud0a4\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \ub2e8\uacc4 3: \uc2e4\uc218\uc5d0 \uacfc\ub3c4\ud558\uac8c \ubc18\uc751\ud558\uc9c0 \uc54a\uace0 \ucc28\ubd84\ud558\uac8c \uc720\uc9c0\ud558\uc138\uc694. \ub610\ud55c, \ud29c\ud1a0\ub9ac\uc5bc \ub610\ub294 \ub9ac\ud50c\ub808\uc774\ub97c \ucc38\uace0\ud558\uba74 \ucd5c\uc801\uc758 \uacbd\ub85c\uc640 \uae30\ubc95\uc744 \uc774\ud574\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "Geometry Dash Cataclysm\uc758 \ub09c\uc774\ub3c4 \uc870\uc808 \ubc29\uc2dd\uacfc \ub3c5\ud2b9\ud55c \uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Geometry Dash Cataclysm\uc758 \ub09c\uc774\ub3c4 \uc870\uc808\uc740 \uba54\ucee4\ub2c8\uc998\uc758 \ubcf5\uc7a1\uc131\uacfc \uc2dc\uac01\uc801 \uac15\ub3c4\ub97c \ubaa8\ub450 \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. \ucd08\uae30 \ub808\ubca8\uc5d0\uc11c\ub294 \uc810\ud504\uc640 \ube44\ud589\uacfc \uac19\uc740 \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc744 \uc18c\uac1c\ud558\ub294 \ubc18\uba74, \ud6c4\ubc18 \ub808\ubca8\uc5d0\uc11c\ub294 \uc5ec\ub7ec \uba54\ucee4\ub2c8\uc998\uc744 \uacb0\ud569\ud558\uc5ec \ud398\uc774\uc2a4\ub97c \ub354\uc6b1 \ub192\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'Deadlocked' \ub808\ubca8\uc740 \ubc30\uc640 \ud30c\ub3c4 \ud615\ud0dc\ub97c \uc804\ud658\ud574\uc57c \ud558\ub294 \uc774\uc911 \ubaa8\ub4dc \uba54\ucee4\ub2c8\uc998\uc744 \ub3c4\uc785\ud569\ub2c8\ub2e4. \uac8c\uc784\uc758 \ub3c5\ud2b9\ud55c \ub3c4\uc804\uc740 \uc7a5\uc560\ubb3c\uc774 \uc74c\uc545\uacfc \ub3d9\uae30\ud654\ub418\ub294 \ub9ac\ub4dc\ubbf8\uceec\ud55c \ub514\uc790\uc778\uc5d0 \uc788\uc73c\uba70, \uc815\ud655\uc131\uacfc \ud0c0\uc774\ubc0d\uc744 \ubaa8\ub450 \uc694\uad6c\ud569\ub2c8\ub2e4."}, {"question": "Geometry Dash Cataclysm\uc5d0\uc11c \uacbd\ud5d8\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ub294 \ub3c4\uad6c \ub610\ub294 \uc124\uc815\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Geometry Dash Cataclysm\uc5d0\uc11c \uacbd\ud5d8\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc124\uc815\uc744 \uc870\uc815\ud558\uace0 \ub3c4\uad6c\ub97c \uc0ac\uc6a9\ud574\uc57c \ud569\ub2c8\ub2e4. \uccab\uc9f8, \ub9c8\uc6b0\uc2a4 \ub610\ub294 \ud0a4\ubcf4\ub4dc\uc640 \uac19\uc740 \uae30\ud638\ub97c \uc0ac\uc6a9\uc790\uc758 \uc120\ud638\ub3c4\uc5d0 \ub9de\ucdb0 \uc870\uc815\ud558\uc138\uc694. \ub458\uc9f8, \ud398\ub110\ud2f0 \uc5c6\uc774 \uc5b4\ub824\uc6b4 \ubd80\ubd84\uc744 \ud14c\uc2a4\ud2b8\ud558\uae30 \uc704\ud574 \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \ud65c\uc131\ud654\ud558\uc138\uc694. \uc14b\uc9f8, \ub354 \ubd80\ub4dc\ub7ec\uc6b4 \uc131\ub2a5\uc744 \uc704\ud574 \uac8c\uc784\uc758 FPS \uc124\uc815\uc744 \uc870\uc815\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc2dc\uac01 \ud6a8\uacfc\ub97c \uc904\uc774\uba74 \uc7a5\uc560\ubb3c\uc5d0 \ub354 \uc9d1\uc911\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, FPS \ud68c\ud53c \ubaa8\ub4dc \ub4f1\uc758 \uc678\ubd80 \ub3c4\uad6c\ub97c \uc0ac\uc6a9\ud558\uba74 \uac8c\uc784 \ud50c\ub808\uc774 \uc548\uc815\uc131\uc744 \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Geometry Dash Cataclysm\uacfc \ub2e4\ub978 Geometry Dash \ud32c \uba54\uc774\ub4dc \ub808\ubca8\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Geometry Dash Cataclysm\uc740 \ub3c5\ud2b9\ud55c \ub808\ubca8 \ub514\uc790\uc778\uacfc \ub09c\uc774\ub3c4\ub85c \ub450\ub4dc\ub7ec\uc9d1\ub2c8\ub2e4. \ud45c\uc900 \ud32c \uba54\uc774\ub4dc \ub808\ubca8\uacfc \ub2ec\ub9ac Cataclysm\uc740 \ubcf5\uc7a1\ud55c \ud328\ud134, \ube60\ub978 \uac8c\uc784 \ud50c\ub808\uc774, \ub9ac\ub4ec\uc5d0 \ucd08\uc810\uc744 \ub9de\ucda5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'Cataclysm' \ub808\ubca8\uc5d0\ub294 \uc815\ud655\ud55c \uc81c\uc5b4\uac00 \ud544\uc694\ud55c \ubcf5\uc7a1\ud55c \ud30c\ub3c4 \ubd80\ubd84\uc774 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \ub808\ubca8\uc758 \uc74c\uc545\uc740 \uc7a5\uc560\ubb3c\uacfc \uc644\ubcbd\ud558\uac8c \ub3d9\uae30\ud654\ub418\uc5b4 \ud1b5\uc77c\ub41c \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc218\uc900\uc758 \uc815\uad50\ud568\uacfc \ub3c4\uc804\uc740 \ub2e4\ub978 \ud32c \uba54\uc774\ub4dc \ucf58\ud150\uce20\uc640 \ucc28\ubcc4\ud654\ud569\ub2c8\ub2e4."}, {"question": "\uc0c8\ub85c\uc6b4 \uae30\uae30\ub85c Geometry Dash Cataclysm\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Geometry Dash Cataclysm\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. \ub2e8\uacc4 1: \uc77c\ubc18\uc801\uc73c\ub85c \uac8c\uc784 \uc124\uce58 \ud3f4\ub354\uc5d0 \uc788\ub294 \uc800\uc7a5 \ud30c\uc77c\uc744 \ucc3e\uc73c\uc138\uc694. \ub2e8\uacc4 2: \uc774\ub7ec\ud55c \ud30c\uc77c\uc744 \uc0c8 \uae30\uae30\ub85c \ubcf5\uc0ac\ud558\uc5ec \uc62c\ubc14\ub978 \ub514\ub809\ud1a0\ub9ac\uc5d0 \ubc30\uce58\ud558\uc138\uc694. \ub2e8\uacc4 3: \uac8c\uc784\uc744 \uc2dc\uc791\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \ud655\uc778\ud558\uc5ec \uc774\uc804\uc774 \uc644\ub8cc\ub418\uc5c8\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, 'Electrodynamix'\ub97c \uc644\ub8cc\ud588\uc73c\uba74 \uacc4\uc18d \uc7a0\uae08 \ud574\uc81c\ub418\uc5c8\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uc218\uc815\ubcf8 \ub610\ub294 \uc0ac\uc6a9\uc790 \uc815\uc758 \ucf58\ud150\uce20\ub294 \ud638\ud658\uc131\uc744 \uc704\ud574 \ucd94\uac00 \ub2e8\uacc4\uac00 \ud544\uc694\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Geometry Dash Cataclysm\uc5d0 \uc228\uaca8\uc9c4 \ube44\ubc00\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Geometry Dash Cataclysm\uc5d0\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \ube44\ubc00\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'Cataclysm' \ub808\ubca8\uc5d0\uc11c \ud2b9\uc815 \ubd80\ubd84\uc744 \uc8fd\uc9c0 \uc54a\uace0 \uc644\ub8cc\ud558\uba74 \uc228\uaca8\uc9c4 \uba54\uc2dc\uc9c0\uac00 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \ub610\ud55c, \uc77c\ubd80 \ub808\ubca8\uc5d0\ub294 \ub2e4\ub978 \uc778\uae30 \ud32c \uba54\uc774\ub4dc \ub808\ubca8\uc774\ub098 \uc6d0\ubcf8 Geometry Dash \uac8c\uc784\uc5d0 \ub300\ud55c \uc2dc\uac01\uc801 \ucc38\uc870\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ube44\ubc00\uc744 \ud0d0\ud5d8\ud558\uba74 \uc5f4\uc131\uc801\uc778 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ucd94\uac00\uc801\uc778 \uc990\uac70\uc6c0\uc744 \uc120\uc0ac\ud569\ub2c8\ub2e4. \ubc30\uacbd\uc774\ub098 \ub3c5\ud2b9\ud55c \ud328\ud134\uc758 \ubbf8\ubb18\ud55c \uc138\ubd80 \uc0ac\ud56d\uc744 \uc8fc\uc758 \uae4a\uac8c \uc0b4\ud3b4\ubcf4\uc138\uc694."}, {"question": "\uc74c\uc545 \ub3d9\uae30\ud654\ub294 Geometry Dash Cataclysm\uc758 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0a4\ub098\uc694?", "answer": "Geometry Dash Cataclysm\uc758 \uc74c\uc545 \ub3d9\uae30\ud654\ub294 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ud575\uc2ec \uae30\ub2a5\uc785\ub2c8\ub2e4. \uc7a5\uc560\ubb3c\uacfc \uc804\ud658\uc740 \uc74c\uc545\uc758 \ube44\ud2b8\uc5d0 \ub9de\ucdb0 \ud0c0\uc774\ubc0d \ub418\uc5b4 \ub9ac\ub4dc\ubbf8\uceec\ud55c \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'Electrodynamix' \ub808\ubca8\uc5d0\uc11c \ubc30 \ubd80\ubd84\uc758 \uc6c0\uc9c1\uc784\uc740 \uc0ac\uc6b4\ub4dc \ud2b8\ub799\uacfc \uc644\ubcbd\ud558\uac8c \uc77c\uce58\ud558\uc5ec \uc7a5\uc560\ubb3c\uc744 \uc608\uce21\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ub3d9\uae30\ud654\ub294 \ubab0\uc785\ub3c4\ub97c \ub192\uc77c \ubfd0\ub9cc \uc544\ub2c8\ub77c \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uc744 \uc704\ud55c \uccad\uac01\uc801 \ub2e8\uc11c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc774 \uce21\uba74\uc744 \ub9c8\uc2a4\ud130\ud558\ub294 \uac83\uc740 \ub354 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4."}, {"question": "Geometry Dash Cataclysm\uc5d0\uc11c \uc2e0\uaddc \ud50c\ub808\uc774\uc5b4\uac00 \uc790\uc8fc \uc800\uc9c0\ub974\ub294 \uc77c\ubc18\uc801\uc778 \uc2e4\uc218\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud53c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Geometry Dash Cataclysm\uc758 \uc2e0\uaddc \ud50c\ub808\uc774\uc5b4\ub294 \uc885\uc885 \uc7a5\uc560\ubb3c\uc5d0 \uacfc\ub3c4\ud558\uac8c \ubc18\uc751\ud558\uac70\ub098 \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uc798\ubabb \ub9de\ucd94\ub294 \uc2e4\uc218\ub97c \ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc2e4\uc218\ub97c \ud53c\ud558\ub824\uba74 \ucc28\ubd84\ud558\uac8c \uc720\uc9c0\ud558\uace0 \uc815\uae30\uc801\uc73c\ub85c \uc5f0\uc2b5\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, 'Clubstep' \ub808\ubca8\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\ub294 \uc885\uc885 \uc881\uc740 \uacf5\uac04\uc5d0\uc11c \ud63c\ub780\uc5d0 \ube60\uc838 \ubd88\ud544\uc694\ud55c \uc0ac\ub9dd\uc73c\ub85c \uc774\uc5b4\uc9d1\ub2c8\ub2e4. \ub300\uc2e0 \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub808\uc774\uc544\uc6c3\uc744 \uc775\uc219\ud574\uc9c0\uc138\uc694. \ub610\ud55c, \uc810\ud504 \ubc84\ud2bc\uc744 \ub108\ubb34 \uc624\ub7ab\ub3d9\uc548 \ub204\ub974\uc9c0 \uc54a\ub3c4\ub85d \uc8fc\uc758\ud558\uc138\uc694. \uc774\ub807\uac8c \ud558\uba74 \ub118\uc5b4\uac08 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc778\ub0b4\uc2ec\uacfc \ubc18\ubcf5\uc740 \uac1c\uc120\uc758 \uc5f4\uc1e0\uc785\ub2c8\ub2e4."}]
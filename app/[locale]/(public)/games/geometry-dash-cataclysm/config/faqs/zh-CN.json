[{"question": "\u5982\u4f55\u5728\u51e0\u4f55\u51b2\u523a\u707e\u53d8\u7248\u4e2d\u8fdb\u884c\u57fa\u672c\u8df3\u8dc3\u548c\u7ed5\u8fc7\u969c\u788d\uff1f", "answer": "\u5728\u51e0\u4f55\u51b2\u523a\u707e\u53d8\u7248\u4e2d\uff0c\u6838\u5fc3\u673a\u5236\u662f\u6839\u636e\u65f6\u95f4\u8df3\u8dc3\u6765\u907f\u5f00\u969c\u788d\u3002\u6309\u7a7a\u683c\u952e\u6216\u70b9\u51fb\u9f20\u6807\u6765\u8ba9\u4f60\u7684\u89d2\u8272\u8df3\u8dc3\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u5173\u4e2d\uff0c\u4f60\u4f1a\u9047\u5230\u9700\u8981\u4e00\u6b21\u7cbe\u51c6\u8df3\u8dc3\u624d\u80fd\u901a\u8fc7\u7684\u7b80\u5355\u5c16\u523a\u3002\u7ec3\u4e60\u957f\u65f6\u95f4\u6309\u4f4f\u8df3\u8dc3\u952e\u8fdb\u884c\u8f83\u957f\u7684\u8df3\u8dc3\uff0c\u5e76\u5feb\u901f\u70b9\u51fb\u8fdb\u884c\u8f83\u77ed\u7684\u8df3\u8dc3\u3002\u521d\u5b66\u8005\u5e94\u8be5\u4e13\u6ce8\u4e8e\u8bb0\u4f4f\u969c\u788d\u6a21\u5f0f\u5e76\u5feb\u901f\u53cd\u5e94\u3002\u4f7f\u7528\u7ec3\u4e60\u6a21\u5f0f\u6765\u78e8\u7ec3\u4f60\u7684\u65f6\u95f4\uff0c\u800c\u4e0d\u4f1a\u53d7\u5230\u60e9\u7f5a\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u51e0\u4f55\u51b2\u523a\u707e\u53d8\u7248\u5bf9\u65b0\u73a9\u5bb6\u6765\u8bf4\u611f\u89c9\u5982\u6b64\u5177\u6709\u6311\u6218\u6027\uff0c\u4ee5\u53ca\u5982\u4f55\u6539\u8fdb\uff1f", "answer": "\u51e0\u4f55\u51b2\u523a\u707e\u53d8\u7248\u4ee5\u5176\u7cbe\u786e\u7684\u65f6\u95f4\u63a7\u5236\u548c\u5feb\u901f\u7684\u6e38\u620f\u8282\u594f\u800c\u95fb\u540d\uff0c\u8fd9\u53ef\u80fd\u4f1a\u8ba9\u65b0\u73a9\u5bb6\u611f\u5230\u4e0d\u77e5\u6240\u63aa\u3002\u4e3a\u4e86\u6539\u8fdb\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u4ece\u8f83\u7b80\u5355\u7684\u5173\u5361\u5f00\u59cb\uff0c\u5efa\u7acb\u808c\u8089\u8bb0\u5fc6\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u7ec3\u4e60\u6a21\u5f0f\u6765\u9694\u79bb\u56f0\u96be\u7684\u90e8\u5206\u3002\u6b65\u9aa43\uff1a\u89c2\u770b\u9ad8\u6c34\u5e73\u73a9\u5bb6\u7684\u5f55\u50cf\uff0c\u5b66\u4e60\u4ed6\u4eec\u7684\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u5728\"Electrodynamix\"\u5173\u5361\u4e2d\uff0c\u73a9\u5bb6\u7ecf\u5e38\u5728\u8239\u53ea\u90e8\u5206\u9047\u5230\u56f0\u96be\uff1b\u91cd\u590d\u7ec3\u4e60\u8fd9\u4e00\u90e8\u5206\u53ef\u4ee5\u5e2e\u52a9\u4f60\u3002\u8010\u5fc3\u548c\u6bc5\u529b\u662f\u638c\u63e1\u8fd9\u6b3e\u6e38\u620f\u7684\u5173\u952e\u3002"}, {"question": "\u5b8c\u6210\u51e0\u4f55\u51b2\u523a\u707e\u53d8\u7248\u66f4\u96be\u7684\u5173\u5361\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5b8c\u6210\u51e0\u4f55\u51b2\u523a\u707e\u53d8\u7248\u66f4\u96be\u7684\u5173\u5361\u9700\u8981\u9ad8\u7ea7\u7b56\u7565\u3002\u6b65\u9aa41\uff1a\u5c06\u5173\u5361\u5206\u89e3\u6210\u66f4\u5c0f\u7684\u90e8\u5206\uff0c\u5e76\u5206\u522b\u7ec3\u4e60\u6bcf\u4e2a\u90e8\u5206\u3002\u6b65\u9aa42\uff1a\u5229\u7528\u89c6\u89c9\u7ebf\u7d22\u6765\u51c6\u786e\u5730\u63a7\u5236\u4f60\u7684\u8df3\u8dc3\u65f6\u95f4\u3002\u4f8b\u5982\uff0c\u5728\"Cataclysm\"\u5173\u5361\u4e2d\uff0c\u6ce2\u6d6a\u90e8\u5206\u9700\u8981\u7cbe\u786e\u7684\u63a7\u5236\uff1b\u4e13\u6ce8\u4e8e\u4f7f\u4f60\u7684\u52a8\u4f5c\u4e0e\u8282\u594f\u4e00\u81f4\u3002\u6b65\u9aa43\uff1a\u4fdd\u6301\u51b7\u9759\uff0c\u907f\u514d\u5bf9\u9519\u8bef\u8fc7\u5ea6\u53cd\u5e94\u3002\u6b64\u5916\uff0c\u89c2\u770b\u6559\u7a0b\u6216\u56de\u653e\u53ef\u4ee5\u63d0\u4f9b\u5173\u4e8e\u6700\u4f73\u8def\u5f84\u548c\u6280\u672f\u7684\u89c1\u89e3\u3002"}, {"question": "\u51e0\u4f55\u51b2\u523a\u707e\u53d8\u7248\u7684\u96be\u5ea6\u63d0\u5347\u673a\u5236\u662f\u5982\u4f55\u5de5\u4f5c\u7684\uff0c\u4ee5\u53ca\u5b83\u6709\u4ec0\u4e48\u72ec\u7279\u4e4b\u5904\uff1f", "answer": "\u51e0\u4f55\u51b2\u523a\u707e\u53d8\u7248\u7684\u96be\u5ea6\u63d0\u5347\u57fa\u4e8e\u673a\u68b0\u590d\u6742\u6027\u548c\u89c6\u89c9\u5f3a\u5ea6\u3002\u65e9\u671f\u5173\u5361\u4ecb\u7ecd\u4e86\u57fa\u7840\u673a\u5236\uff0c\u5982\u8df3\u8dc3\u548c\u98de\u884c\uff0c\u800c\u540e\u7eed\u5173\u5361\u5219\u7ed3\u5408\u4e86\u591a\u79cd\u673a\u5236\u548c\u66f4\u5feb\u7684\u8282\u594f\u3002\u4f8b\u5982\uff0c\"Deadlocked\"\u5173\u5361\u5f15\u5165\u4e86\u53cc\u6a21\u5f0f\u673a\u5236\uff0c\u8981\u6c42\u73a9\u5bb6\u5728\u8239\u53ea\u548c\u6ce2\u6d6a\u5f62\u6001\u4e4b\u95f4\u8fdb\u884c\u5207\u6362\u3002\u8be5\u6e38\u620f\u7684\u72ec\u7279\u6311\u6218\u5728\u4e8e\u5176\u8282\u594f\u8bbe\u8ba1\uff0c\u5176\u4e2d\u969c\u788d\u7269\u4e0e\u97f3\u4e50\u540c\u6b65\uff0c\u9700\u8981\u7cbe\u786e\u7684\u65f6\u95f4\u63a7\u5236\u548c\u7cbe\u51c6\u5ea6\u3002"}, {"question": "\u54ea\u4e9b\u5de5\u5177\u6216\u8bbe\u7f6e\u53ef\u4ee5\u5e2e\u52a9\u6211\u4f18\u5316\u6211\u5728\u51e0\u4f55\u51b2\u523a\u707e\u53d8\u7248\u4e2d\u7684\u4f53\u9a8c\uff1f", "answer": "\u4f18\u5316\u4f60\u5728\u51e0\u4f55\u51b2\u523a\u707e\u53d8\u7248\u4e2d\u7684\u4f53\u9a8c\u5305\u62ec\u8c03\u6574\u8bbe\u7f6e\u548c\u4f7f\u7528\u5de5\u5177\u3002\u9996\u5148\uff0c\u81ea\u5b9a\u4e49\u4f60\u7684\u63a7\u5236\u65b9\u6848\u4ee5\u9002\u5e94\u4f60\u7684\u504f\u597d\uff0c\u4f8b\u5982\u4f7f\u7528\u9f20\u6807\u6216\u952e\u76d8\u3002\u5176\u6b21\uff0c\u542f\u7528\u201c\u7ec3\u4e60\u6a21\u5f0f\u201d\u6765\u6d4b\u8bd5\u56f0\u96be\u90e8\u5206\uff0c\u800c\u4e0d\u4f1a\u53d7\u5230\u60e9\u7f5a\u3002\u7b2c\u4e09\uff0c\u8c03\u6574\u6e38\u620f\u7684FPS\u8bbe\u7f6e\uff0c\u4ee5\u83b7\u5f97\u66f4\u6d41\u7545\u7684\u6027\u80fd\u3002\u4f8b\u5982\uff0c\u51cf\u5c11\u89c6\u89c9\u6548\u679c\u53ef\u4ee5\u5e2e\u52a9\u4f60\u4e13\u6ce8\u4e8e\u969c\u788d\u7269\u3002\u6b64\u5916\uff0c\u4f7f\u7528\u5916\u90e8\u5de5\u5177\uff0c\u4f8b\u5982FPS\u65c1\u8def\u4fee\u6539\u5668\uff0c\u53ef\u4ee5\u589e\u5f3a\u6e38\u620f\u7a33\u5b9a\u6027\u3002"}, {"question": "\u51e0\u4f55\u51b2\u523a\u707e\u53d8\u7248\u548c\u5176\u4ed6\u51e0\u4f55\u51b2\u523a\u81ea\u5236\u5173\u5361\u4e4b\u95f4\u7684\u4e3b\u8981\u533a\u522b\u662f\u4ec0\u4e48\uff1f", "answer": "\u51e0\u4f55\u51b2\u523a\u707e\u53d8\u7248\u56e0\u5176\u72ec\u7279\u7684\u5173\u5361\u8bbe\u8ba1\u548c\u96be\u5ea6\u800c\u8131\u9896\u800c\u51fa\u3002\u4e0e\u6807\u51c6\u7684\u81ea\u5236\u5173\u5361\u4e0d\u540c\uff0c\u707e\u53d8\u7248\u5177\u6709\u590d\u6742\u7684\u56fe\u6848\u3001\u5feb\u8282\u594f\u7684\u6e38\u620f\u548c\u5bf9\u8282\u594f\u7684\u5173\u6ce8\u3002\u4f8b\u5982\uff0c\"Cataclysm\"\u5173\u5361\u5305\u542b\u9700\u8981\u7cbe\u786e\u63a7\u5236\u7684\u590d\u6742\u6ce2\u6d6a\u90e8\u5206\u3002\u6b64\u5916\uff0c\u8be5\u5173\u5361\u7684\u97f3\u4e50\u4e0e\u969c\u788d\u5b8c\u7f8e\u540c\u6b65\uff0c\u521b\u9020\u51fa\u8fde\u8d2f\u7684\u4f53\u9a8c\u3002\u8fd9\u79cd\u7a0b\u5ea6\u7684\u6253\u78e8\u548c\u6311\u6218\u4f7f\u5176\u533a\u522b\u4e8e\u5176\u4ed6\u81ea\u5236\u5185\u5bb9\u3002"}, {"question": "\u5982\u4f55\u5c06\u6211\u5728\u51e0\u4f55\u51b2\u523a\u707e\u53d8\u7248\u4e2d\u7684\u8fdb\u5ea6\u8f6c\u79fb\u5230\u65b0\u7684\u8bbe\u5907\u4e0a\uff1f", "answer": "\u8981\u5c06\u4f60\u5728\u51e0\u4f55\u51b2\u523a\u707e\u53d8\u7248\u4e2d\u7684\u8fdb\u5ea6\u8f6c\u79fb\u5230\u65b0\u7684\u8bbe\u5907\u4e0a\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u627e\u5230\u4f60\u7684\u5b58\u6863\u6587\u4ef6\uff0c\u901a\u5e38\u4f4d\u4e8e\u6e38\u620f\u5b89\u88c5\u76ee\u5f55\u4e2d\u3002\u6b65\u9aa42\uff1a\u5c06\u8fd9\u4e9b\u6587\u4ef6\u590d\u5236\u5230\u4f60\u7684\u65b0\u8bbe\u5907\u4e0a\uff0c\u786e\u4fdd\u5b83\u4eec\u653e\u7f6e\u5728\u6b63\u786e\u7684\u76ee\u5f55\u4e2d\u3002\u6b65\u9aa43\uff1a\u901a\u8fc7\u542f\u52a8\u6e38\u620f\u5e76\u68c0\u67e5\u4f60\u7684\u8fdb\u5ea6\u6765\u9a8c\u8bc1\u4f20\u8f93\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5df2\u7ecf\u5b8c\u6210\u4e86\"Electrodynamix\"\uff0c\u786e\u4fdd\u5b83\u4fdd\u6301\u89e3\u9501\u72b6\u6001\u3002\u8bf7\u6ce8\u610f\uff0c\u4fee\u6539\u6216\u81ea\u5b9a\u4e49\u5185\u5bb9\u53ef\u80fd\u9700\u8981\u989d\u5916\u7684\u6b65\u9aa4\u624d\u80fd\u786e\u4fdd\u517c\u5bb9\u6027\u3002"}, {"question": "\u51e0\u4f55\u51b2\u523a\u707e\u53d8\u7248\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u79d8\u5bc6\u6216\u5f69\u86cb\uff1f", "answer": "\u51e0\u4f55\u51b2\u523a\u707e\u53d8\u7248\u5305\u542b\u51e0\u4e2a\u9690\u85cf\u7684\u79d8\u5bc6\u548c\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u5728\"Cataclysm\"\u5173\u5361\u4e2d\uff0c\u5f53\u4f60\u5b8c\u6210\u67d0\u4e9b\u90e8\u5206\u5e76\u4e14\u6ca1\u6709\u6b7b\u4ea1\u65f6\uff0c\u4f1a\u51fa\u73b0\u4e00\u6761\u9690\u85cf\u4fe1\u606f\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u5173\u5361\u5305\u542b\u5bf9\u5176\u4ed6\u6d41\u884c\u7684\u81ea\u5236\u5173\u5361\u6216\u539f\u59cb\u51e0\u4f55\u51b2\u523a\u6e38\u620f\u7684\u89c6\u89c9\u81f4\u656c\u3002\u63a2\u7d22\u8fd9\u4e9b\u79d8\u5bc6\u4e3a\u5fe0\u5b9e\u73a9\u5bb6\u589e\u6dfb\u4e86\u989d\u5916\u7684\u4e50\u8da3\u3002\u7559\u610f\u80cc\u666f\u4e2d\u7684\u7ec6\u5fae\u4e4b\u5904\u6216\u4e0d\u5bfb\u5e38\u7684\u56fe\u6848\u3002"}, {"question": "\u97f3\u4e50\u540c\u6b65\u5982\u4f55\u5728\u51e0\u4f55\u51b2\u523a\u707e\u53d8\u7248\u4e2d\u589e\u5f3a\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u51e0\u4f55\u51b2\u523a\u707e\u53d8\u7248\u4e2d\u7684\u97f3\u4e50\u540c\u6b65\u662f\u589e\u5f3a\u6e38\u620f\u4f53\u9a8c\u7684\u6838\u5fc3\u529f\u80fd\u3002\u969c\u788d\u548c\u8fc7\u6e21\u90fd\u6839\u636e\u97f3\u4e50\u8282\u594f\u8fdb\u884c\u8ba1\u65f6\uff0c\u521b\u9020\u51fa\u8282\u594f\u611f\u5341\u8db3\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u4f8b\u5982\uff0c\u5728\"Electrodynamix\"\u5173\u5361\u4e2d\uff0c\u8239\u53ea\u90e8\u5206\u7684\u52a8\u4f5c\u4e0e\u914d\u4e50\u5b8c\u7f8e\u5730\u5bf9\u9f50\uff0c\u4f7f\u73a9\u5bb6\u66f4\u5bb9\u6613\u9884\u6d4b\u969c\u788d\u3002\u8fd9\u79cd\u540c\u6b65\u4e0d\u4ec5\u63d0\u9ad8\u4e86\u6c89\u6d78\u611f\uff0c\u8fd8\u4e3a\u7cbe\u786e\u8ba1\u65f6\u63d0\u4f9b\u4e86\u542c\u89c9\u63d0\u793a\u3002\u638c\u63e1\u8fd9\u4e00\u65b9\u9762\u5bf9\u4e8e\u5b8c\u6210\u66f4\u96be\u7684\u5173\u5361\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u65b0\u73a9\u5bb6\u5728\u51e0\u4f55\u51b2\u523a\u707e\u53d8\u7248\u4e2d\u5e38\u89c1\u7684\u9519\u8bef\u6709\u54ea\u4e9b\uff0c\u4ee5\u53ca\u5982\u4f55\u907f\u514d\uff1f", "answer": "\u51e0\u4f55\u51b2\u523a\u707e\u53d8\u7248\u7684\u65b0\u73a9\u5bb6\u7ecf\u5e38\u72af\u7684\u9519\u8bef\u5305\u62ec\u5bf9\u969c\u788d\u8fc7\u5ea6\u53cd\u5e94\u6216\u8df3\u8dc3\u65f6\u95f4\u9519\u8bef\u3002\u4e3a\u4e86\u907f\u514d\u8fd9\u4e9b\u9519\u8bef\uff0c\u4e13\u6ce8\u4e8e\u4fdd\u6301\u51b7\u9759\u5e76\u5b9a\u671f\u7ec3\u4e60\u3002\u4f8b\u5982\uff0c\u5728\"Clubstep\"\u5173\u5361\u4e2d\uff0c\u73a9\u5bb6\u5728\u72ed\u7a84\u7a7a\u95f4\u65f6\u7ecf\u5e38\u4f1a\u60ca\u614c\u5931\u63aa\uff0c\u5bfc\u81f4\u4e0d\u5fc5\u8981\u7684\u6b7b\u4ea1\u3002\u76f8\u53cd\uff0c\u4f7f\u7528\u7ec3\u4e60\u6a21\u5f0f\u6765\u719f\u6089\u5e03\u5c40\u3002\u6b64\u5916\uff0c\u907f\u514d\u8df3\u8dc3\u952e\u6309\u4f4f\u65f6\u95f4\u8fc7\u957f\uff0c\u56e0\u4e3a\u8fd9\u4f1a\u5bfc\u81f4\u8d85\u51fa\u8303\u56f4\u3002\u8010\u5fc3\u548c\u91cd\u590d\u7ec3\u4e60\u662f\u5173\u952e\u3002"}]
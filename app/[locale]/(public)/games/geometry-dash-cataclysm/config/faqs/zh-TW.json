[{"question": "\u5982\u4f55\u5728\u5e7e\u4f55\u8dd1\u9177\u707d\u8b8a (Geometry Dash Cataclysm) \u4e2d\u57f7\u884c\u57fa\u672c\u8df3\u8e8d\u548c\u8ff4\u907f\u969c\u7919\u7269\uff1f", "answer": "\u5728\u5e7e\u4f55\u8dd1\u9177\u707d\u8b8a\u4e2d\uff0c\u6838\u5fc3\u6a5f\u5236\u662f\u7cbe\u6e96\u638c\u63e1\u8df3\u8e8d\u6642\u6a5f\u4ee5\u907f\u958b\u969c\u7919\u7269\u3002\u6309\u4e0b\u7a7a\u683c\u9375\u6216\u9ede\u64ca\u6ed1\u9f20\u8b93\u89d2\u8272\u8df3\u8e8d\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u95dc\u4e2d\uff0c\u4f60\u6703\u9047\u5230\u9700\u8981\u55ae\u6b21\u7cbe\u6e96\u8df3\u8e8d\u624d\u80fd\u901a\u904e\u7684\u7c21\u55ae\u5c16\u523a\u3002\u7df4\u7fd2\u5ef6\u9577\u6309\u4f4f\u8df3\u8e8d\u9375\u4ee5\u9032\u884c\u8f03\u9577\u7684\u8df3\u8e8d\uff0c\u4e26\u8f15\u9ede\u5b83\u9032\u884c\u8f03\u77ed\u7684\u8df3\u8e8d\u3002\u521d\u5b78\u8005\u61c9\u5c08\u6ce8\u65bc\u8a18\u61b6\u969c\u7919\u7269\u6a21\u5f0f\u4e26\u5feb\u901f\u53cd\u61c9\u3002\u4f7f\u7528\u7df4\u7fd2\u6a21\u5f0f\u53ef\u7cbe\u78ba\u8abf\u6574\u6642\u6a5f\uff0c\u7121\u9700\u64d4\u5fc3\u5931\u6557\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u5e7e\u4f55\u8dd1\u9177\u707d\u8b8a\u5c0d\u65b0\u624b\u4f86\u8aaa\u5982\u6b64\u5177\u6709\u6311\u6230\u6027\uff0c\u4ee5\u53ca\u5982\u4f55\u6539\u9032\uff1f", "answer": "\u5e7e\u4f55\u8dd1\u9177\u707d\u8b8a\u4ee5\u5176\u7cbe\u78ba\u7684\u6642\u6a5f\u548c\u5feb\u901f\u7bc0\u594f\u7684\u904a\u6232\u65b9\u5f0f\u800c\u805e\u540d\uff0c\u9019\u53ef\u80fd\u6703\u8b93\u65b0\u624b\u611f\u5230\u4e0d\u77e5\u6240\u63aa\u3002\u70ba\u4e86\u89e3\u6c7a\u6b64\u554f\u984c\uff0c\u8acb\u6309\u7167\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f\u4e00\uff1a\u5f9e\u8f03\u5bb9\u6613\u7684\u95dc\u5361\u958b\u59cb\uff0c\u5efa\u7acb\u808c\u8089\u8a18\u61b6\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u7df4\u7fd2\u6a21\u5f0f\u5c07\u56f0\u96e3\u7bc0\u9ede\u5206\u958b\u7df4\u7fd2\u3002\u6b65\u9a5f\u4e09\uff1a\u89c0\u770b\u9ad8\u624b\u7684\u904a\u6232\u56de\u653e\uff0c\u5b78\u7fd2\u4ed6\u5011\u7684\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u5728\u300c\u96fb\u78c1\u529b\u5b78\u300d\u95dc\u5361\u4e2d\uff0c\u73a9\u5bb6\u5e38\u5728\u8239\u96bb\u5340\u6bb5\u9047\u5230\u56f0\u96e3\uff1b\u53cd\u8986\u7df4\u7fd2\u6b64\u5340\u6bb5\u53ef\u4ee5\u6709\u6240\u5e6b\u52a9\u3002\u8010\u5fc3\u548c\u6bc5\u529b\u662f\u638c\u63e1\u904a\u6232\u7684\u95dc\u9375\u3002"}, {"question": "\u5b8c\u6210\u5e7e\u4f55\u8dd1\u9177\u707d\u8b8a\u8f03\u96e3\u95dc\u5361\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5b8c\u6210\u5e7e\u4f55\u8dd1\u9177\u707d\u8b8a\u4e2d\u8f03\u96e3\u7684\u95dc\u5361\u9700\u8981\u9032\u968e\u7684\u7b56\u7565\u3002\u6b65\u9a5f\u4e00\uff1a\u5c07\u95dc\u5361\u5206\u89e3\u6210\u8f03\u5c0f\u7684\u5340\u6bb5\uff0c\u4e26\u500b\u5225\u7df4\u7fd2\u6bcf\u500b\u5340\u6bb5\u3002\u6b65\u9a5f\u4e8c\uff1a\u5229\u7528\u8996\u89ba\u63d0\u793a\u7cbe\u78ba\u638c\u63e1\u8df3\u8e8d\u6642\u6a5f\u3002\u4f8b\u5982\uff0c\u5728\u300c\u707d\u8b8a\u300d\u95dc\u5361\u4e2d\uff0c\u6ce2\u6d6a\u5340\u6bb5\u9700\u8981\u7cbe\u78ba\u7684\u63a7\u5236\uff1b\u5c08\u6ce8\u65bc\u4f7f\u52d5\u4f5c\u8207\u7bc0\u594f\u4e00\u81f4\u3002\u6b65\u9a5f\u4e09\uff1a\u4fdd\u6301\u51b7\u975c\uff0c\u907f\u514d\u5c0d\u932f\u8aa4\u53cd\u61c9\u904e\u5ea6\u3002\u6b64\u5916\uff0c\u89c0\u770b\u6559\u5b78\u6216\u56de\u653e\u53ef\u4ee5\u63d0\u4f9b\u6700\u4f73\u8def\u5f91\u548c\u6280\u5de7\u7684\u898b\u89e3\u3002"}, {"question": "\u5e7e\u4f55\u8dd1\u9177\u707d\u8b8a\u7684\u96e3\u5ea6\u63d0\u5347\u6a5f\u5236\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u4ee5\u53ca\u5176\u7368\u7279\u4e4b\u8655\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5e7e\u4f55\u8dd1\u9177\u707d\u8b8a\u7684\u96e3\u5ea6\u63d0\u5347\u6a5f\u5236\u57fa\u65bc\u6a5f\u68b0\u8907\u96dc\u5ea6\u548c\u8996\u89ba\u5f37\u5ea6\u3002\u65e9\u671f\u95dc\u5361\u6703\u4ecb\u7d39\u57fa\u672c\u7684\u8df3\u8e8d\u548c\u98db\u884c\u6a5f\u5236\uff0c\u800c\u5f8c\u7e8c\u95dc\u5361\u5247\u7d50\u5408\u591a\u7a2e\u6a5f\u5236\uff0c\u4e26\u4ee5\u66f4\u5feb\u7684\u7bc0\u594f\u9032\u884c\u3002\u4f8b\u5982\uff0c\u300c\u50f5\u5c40\u300d\u95dc\u5361\u5f15\u5165\u4e86\u96d9\u6a21\u5f0f\u6a5f\u5236\uff0c\u8981\u6c42\u73a9\u5bb6\u5728\u8239\u96bb\u548c\u6ce2\u6d6a\u6a21\u5f0f\u4e4b\u9593\u5207\u63db\u3002\u904a\u6232\u7684\u7368\u7279\u6311\u6230\u5728\u65bc\u5176\u7bc0\u594f\u8a2d\u8a08\uff0c\u969c\u7919\u7269\u8207\u97f3\u6a02\u540c\u6b65\uff0c\u9700\u8981\u65e2\u7cbe\u6e96\u53c8\u53ca\u6642\u7684\u64cd\u63a7\u3002"}, {"question": "\u54ea\u4e9b\u5de5\u5177\u6216\u8a2d\u5b9a\u53ef\u4ee5\u5e6b\u52a9\u512a\u5316\u6211\u5728\u5e7e\u4f55\u8dd1\u9177\u707d\u8b8a\u4e2d\u7684\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u512a\u5316\u4f60\u5728\u5e7e\u4f55\u8dd1\u9177\u707d\u8b8a\u4e2d\u7684\u904a\u6232\u9ad4\u9a57\uff0c\u9700\u8981\u8abf\u6574\u8a2d\u5b9a\u548c\u4f7f\u7528\u5de5\u5177\u3002\u9996\u5148\uff0c\u81ea\u8a02\u4f60\u7684\u63a7\u5236\u65b9\u6848\u4ee5\u7b26\u5408\u4f60\u7684\u504f\u597d\uff0c\u4f8b\u5982\u4f7f\u7528\u6ed1\u9f20\u6216\u9375\u76e4\u3002\u5176\u6b21\uff0c\u555f\u7528\u300c\u7df4\u7fd2\u6a21\u5f0f\u300d\u4ee5\u5728\u4e0d\u8655\u7f70\u7684\u60c5\u6cc1\u4e0b\u6e2c\u8a66\u56f0\u96e3\u5340\u6bb5\u3002\u7b2c\u4e09\uff0c\u8abf\u6574\u904a\u6232\u7684 FPS \u8a2d\u5b9a\u4ee5\u7372\u5f97\u66f4\u6d41\u66a2\u7684\u904a\u6232\u9ad4\u9a57\u3002\u4f8b\u5982\uff0c\u6e1b\u5c11\u8996\u89ba\u6548\u679c\u53ef\u4ee5\u5e6b\u52a9\u4f60\u5c08\u6ce8\u65bc\u969c\u7919\u7269\u3002\u6b64\u5916\uff0c\u4f7f\u7528\u5916\u90e8\u5de5\u5177\uff08\u4f8b\u5982 FPS \u7e5e\u904e\u4fee\u6539\u5668\uff09\u53ef\u4ee5\u589e\u5f37\u904a\u6232\u7a69\u5b9a\u6027\u3002"}, {"question": "\u5e7e\u4f55\u8dd1\u9177\u707d\u8b8a\u548c\u5176\u4ed6\u5e7e\u4f55\u8dd1\u9177\u81ea\u88fd\u95dc\u5361\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5e7e\u4f55\u8dd1\u9177\u707d\u8b8a\u7531\u65bc\u5176\u7368\u7279\u7684\u95dc\u5361\u8a2d\u8a08\u548c\u96e3\u5ea6\u800c\u812b\u7a4e\u800c\u51fa\u3002\u8207\u6a19\u6e96\u7684\u81ea\u88fd\u95dc\u5361\u4e0d\u540c\uff0c\u707d\u8b8a\u7279\u8272\u662f\u7cbe\u7dfb\u7684\u6a21\u5f0f\u3001\u5feb\u901f\u7bc0\u594f\u7684\u904a\u6232\u65b9\u5f0f\uff0c\u4ee5\u53ca\u91cd\u8996\u7bc0\u594f\u3002\u4f8b\u5982\uff0c\u300c\u707d\u8b8a\u300d\u95dc\u5361\u5305\u62ec\u9700\u8981\u7cbe\u78ba\u63a7\u5236\u7684\u8907\u96dc\u6ce2\u6d6a\u5340\u6bb5\u3002\u6b64\u5916\uff0c\u95dc\u5361\u7684\u97f3\u6a02\u8207\u969c\u7919\u7269\u5b8c\u7f8e\u540c\u6b65\uff0c\u5275\u9020\u51fa\u5354\u8abf\u7684\u9ad4\u9a57\u3002\u9019\u7a2e\u7a0b\u5ea6\u7684\u7cbe\u7dfb\u548c\u6311\u6230\u4f7f\u5176\u5f9e\u5176\u4ed6\u81ea\u88fd\u5167\u5bb9\u4e2d\u812b\u7a4e\u800c\u51fa\u3002"}, {"question": "\u5982\u4f55\u5c07\u6211\u5728\u5e7e\u4f55\u8dd1\u9177\u707d\u8b8a\u4e2d\u7684\u9032\u5ea6\u8f49\u79fb\u5230\u65b0\u7684\u88dd\u7f6e\uff1f", "answer": "\u8981\u5c07\u60a8\u5728\u5e7e\u4f55\u8dd1\u9177\u707d\u8b8a\u4e2d\u7684\u9032\u5ea6\u8f49\u79fb\u5230\u65b0\u7684\u88dd\u7f6e\uff0c\u8acb\u6309\u7167\u4e0b\u5217\u6b65\u9a5f\uff1a\u6b65\u9a5f\u4e00\uff1a\u627e\u5230\u60a8\u7684\u5132\u5b58\u6a94\u6848\uff0c\u901a\u5e38\u4f4d\u65bc\u904a\u6232\u5b89\u88dd\u8cc7\u6599\u593e\u4e2d\u3002\u6b65\u9a5f\u4e8c\uff1a\u5c07\u9019\u4e9b\u6a94\u6848\u8907\u88fd\u5230\u60a8\u7684\u65b0\u88dd\u7f6e\uff0c\u4e26\u78ba\u4fdd\u5c07\u5b83\u5011\u653e\u5728\u6b63\u78ba\u7684\u76ee\u9304\u4e2d\u3002\u6b65\u9a5f\u4e09\uff1a\u555f\u52d5\u904a\u6232\u4e26\u6aa2\u67e5\u60a8\u7684\u9032\u5ea6\u4ee5\u9a57\u8b49\u8f49\u79fb\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5df2\u5b8c\u6210\u300c\u96fb\u78c1\u529b\u5b78\u300d\uff0c\u8acb\u78ba\u4fdd\u5b83\u4ecd\u4fdd\u6301\u89e3\u9396\u72c0\u614b\u3002\u8acb\u6ce8\u610f\uff0c\u4fee\u6539\u5668\u6216\u81ea\u8a02\u5167\u5bb9\u53ef\u80fd\u9700\u8981\u984d\u5916\u6b65\u9a5f\u624d\u80fd\u76f8\u5bb9\u3002"}, {"question": "\u5e7e\u4f55\u8dd1\u9177\u707d\u8b8a\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u79d8\u5bc6\u6216\u5f69\u86cb\uff1f", "answer": "\u5e7e\u4f55\u8dd1\u9177\u707d\u8b8a\u5305\u542b\u591a\u500b\u96b1\u85cf\u79d8\u5bc6\u548c\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u5728\u300c\u707d\u8b8a\u300d\u95dc\u5361\u4e2d\uff0c\u7576\u4f60\u5728\u67d0\u4e9b\u5340\u6bb5\u5b8c\u6210\u6311\u6230\u800c\u6c92\u6709\u6b7b\u4ea1\u6642\uff0c\u6703\u51fa\u73fe\u4e00\u500b\u96b1\u85cf\u8a0a\u606f\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u95dc\u5361\u5305\u542b\u5c0d\u5176\u4ed6\u6d41\u884c\u81ea\u88fd\u95dc\u5361\u6216\u539f\u59cb\u5e7e\u4f55\u8dd1\u9177\u904a\u6232\u7684\u8996\u89ba\u81f4\u656c\u3002\u63a2\u7d22\u9019\u4e9b\u79d8\u5bc6\u70ba\u81f4\u529b\u65bc\u6b64\u904a\u6232\u7684\u73a9\u5bb6\u589e\u6dfb\u984d\u5916\u7684\u6a02\u8da3\u3002\u7559\u610f\u80cc\u666f\u4e2d\u7684\u7d30\u5fae\u7d30\u7bc0\u6216\u4e0d\u5c0b\u5e38\u7684\u5716\u6848\u3002"}, {"question": "\u97f3\u6a02\u540c\u6b65\u5982\u4f55\u589e\u5f37\u5e7e\u4f55\u8dd1\u9177\u707d\u8b8a\u4e2d\u7684\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u5e7e\u4f55\u8dd1\u9177\u707d\u8b8a\u4e2d\u7684\u97f3\u6a02\u540c\u6b65\u662f\u589e\u5f37\u904a\u6232\u9ad4\u9a57\u7684\u6838\u5fc3\u529f\u80fd\u3002\u969c\u7919\u7269\u548c\u8f49\u63db\u8207\u97f3\u6a02\u7684\u7bc0\u594f\u540c\u6b65\uff0c\u5275\u9020\u51fa\u7bc0\u594f\u611f\u3002\u4f8b\u5982\uff0c\u300c\u96fb\u78c1\u529b\u5b78\u300d\u95dc\u5361\u4e2d\u7684\u8239\u96bb\u5340\u6bb5\u52d5\u4f5c\u8207\u97f3\u8ecc\u5b8c\u7f8e\u5c0d\u61c9\uff0c\u8b93\u73a9\u5bb6\u66f4\u5bb9\u6613\u9810\u6e2c\u969c\u7919\u7269\u3002\u9019\u7a2e\u540c\u6b65\u4e0d\u50c5\u63d0\u5347\u6c89\u6d78\u611f\uff0c\u9084\u63d0\u4f9b\u4e86\u7cbe\u78ba\u6642\u6a5f\u7684\u807d\u89ba\u63d0\u793a\u3002\u638c\u63e1\u9019\u4e00\u9ede\u5c0d\u65bc\u5b8c\u6210\u8f03\u96e3\u7684\u95dc\u5361\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u65b0\u624b\u73a9\u5bb6\u5728\u5e7e\u4f55\u8dd1\u9177\u707d\u8b8a\u4e2d\u6700\u5e38\u898b\u7684\u932f\u8aa4\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5982\u4f55\u907f\u514d\u9019\u4e9b\u932f\u8aa4\uff1f", "answer": "\u5e7e\u4f55\u8dd1\u9177\u707d\u8b8a\u4e2d\u7684\u65b0\u624b\u73a9\u5bb6\u5e38\u72af\u7684\u932f\u8aa4\u5305\u62ec\u5c0d\u969c\u7919\u7269\u53cd\u61c9\u904e\u5ea6\u6216\u8df3\u8e8d\u6642\u9593\u932f\u8aa4\u3002\u70ba\u4e86\u907f\u514d\u9019\u4e9b\u932f\u8aa4\uff0c\u5c08\u6ce8\u65bc\u4fdd\u6301\u51b7\u975c\u4e26\u5b9a\u671f\u7df4\u7fd2\u3002\u4f8b\u5982\uff0c\u5728\u300c\u4ff1\u6a02\u90e8\u6b65\u9a5f\u300d\u95dc\u5361\u4e2d\uff0c\u73a9\u5bb6\u5728\u72f9\u7a84\u7a7a\u9593\u4e2d\u7d93\u5e38\u611f\u5230\u6050\u614c\uff0c\u5c0e\u81f4\u4e0d\u5fc5\u8981\u7684\u6b7b\u4ea1\u3002\u76f8\u53cd\uff0c\u4f7f\u7528\u7df4\u7fd2\u6a21\u5f0f\u719f\u6089\u4f48\u5c40\u3002\u6b64\u5916\uff0c\u907f\u514d\u904e\u9577\u6642\u9593\u6309\u4f4f\u8df3\u8e8d\u9375\uff0c\u56e0\u70ba\u9019\u53ef\u80fd\u6703\u5c0e\u81f4\u8d85\u51fa\u9810\u671f\u3002\u8010\u5fc3\u548c\u53cd\u8986\u7df4\u7fd2\u662f\u63d0\u5347\u7684\u95dc\u9375\u3002"}]
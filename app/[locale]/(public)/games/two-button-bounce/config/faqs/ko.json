[{"question": "\ucd08\ubcf4\uc790\ub85c\uc11c \ub450 \ubc84\ud2bc \ubd04\uc744 \uae30\ubcf8\uc801\uc73c\ub85c \ub9c8\uc2a4\ud130\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub450 \ubc84\ud2bc \ubd04\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ub9c8\uc2a4\ud130\ud558\ub824\uba74 \ub450 \ubc84\ud2bc \uba54\ucee4\ub2c8\uc998\uc5d0 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \ubc84\ud2bc A\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc810\ud504\ud558\uace0 \ubc84\ud2bc B\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub3cc\uc9c4\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c \ud2c8\uc0c8\ub97c \uc810\ud504\ud558\uace0 \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\uae30 \uc704\ud574 \ub3cc\uc9c4\ud574\uc57c \ud569\ub2c8\ub2e4. \uac8c\uc784\uc758 \ub9ac\ub4ec\uc5d0 \ub9de\ucdb0 \uc810\ud504\uc640 \ub3cc\uc9c4\uc758 \ud0c0\uc774\ubc0d\uc744 \uc5f0\uc2b5\ud558\uc2ed\uc2dc\uc624. \uc720\uc6a9\ud55c \ud301\uc740 \ubc84\ud2bc\uc744 \uce90\ub9ad\ud130\uc758 \ubc1c\ub85c \uc2dc\uac01\ud654\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \ubc84\ud2bc A\ub294 \uc2b9\uac15\uc2dc\ud0a4\uace0, \ubc84\ud2bc B\ub294 \uc804\uc9c4\uc2dc\ud0b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ube44\uc720\ub294 \ucee8\ud2b8\ub864\uc744 \ub354 \uc9c1\uad00\uc801\uc73c\ub85c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uac8c\uc784 \ud50c\ub808\uc774 \uc2dc\uac04 100\uc2dc\uac04 \ud6c4 \ub450 \ubc84\ud2bc \ubd04\uc5d0\uc11c \ub2a5\ub825\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uae30 \uc704\ud55c \uc8fc\uc694 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "100\uc2dc\uac04\uc774 \uc9c0\ub09c \ud6c4 \ub450 \ubc84\ud2bc \ubd04\uc5d0\uc11c \ubc1c\uc804\ud558\ub824\uba74 \uc815\ubc00\uc131\uacfc \uc804\ub7b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \ubcf5\uc7a1\ud55c \uc2dc\ud000\uc2a4\uc5d0\uc11c \uc810\ud504\uc640 \ub3cc\uc9c4\uc758 \ud0c0\uc774\ubc0d\uc744 \ub9c8\uc2a4\ud130\ud569\ub2c8\ub2e4. STEP2: \uac01 \ub808\ubca8\uc758 \ud328\ud134\uc744 \ud559\uc2b5\ud558\uc5ec \uc7a5\uc560\ubb3c\uc744 \uc608\uce21\ud569\ub2c8\ub2e4. STEP3: \ub808\ubca8 10\uc758 \uc18d\ub3c4 \ubd80\uc2a4\ud2b8\uc640 \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\uc5ec \uc774\ub3d9 \ud50c\ub7ab\ud3fc \uc2dc\ub9ac\uc988\ub97c \uc6b0\ud68c\ud569\ub2c8\ub2e4. \ub2e4\ub978 \uc811\uadfc \ubc29\uc2dd\uc744 \ube44\uad50\ud574 \ubcf4\uba74 \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\ub294 \uc18d\ub3c4\uc5d0 \uc9d1\uc911\ud558\ub294 \ubc18\uba74 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub294 \uc815\ud655\uc131\uc744 \uc6b0\uc120\uc2dc\ud569\ub2c8\ub2e4. \ucd5c\uc801\uc758 \uc804\ub7b5\uc744 \ucc3e\uc73c\ub824\uba74 \uc2e4\ud5d8\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ub450 \ubc84\ud2bc \ubd04\uc758 \ub3cc\uc9c4 \uba54\ucee4\ub2c8\uc998\uc774 \ub54c\ub54c\ub85c \uc77c\uad00\ub418\uc9c0 \uc54a\uc740 \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub450 \ubc84\ud2bc \ubd04\uc758 \ub3cc\uc9c4 \uba54\ucee4\ub2c8\uc998\uc774 \uc77c\uad00\ub418\uc9c0 \uc54a\uc744 \uc218 \uc788\ub294 \uc774\uc720\ub294 \uac8c\uc784\uc758 \ubb3c\ub9ac \uc5d4\uc9c4 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc808\ubcbd\uc5d0\uc11c \ub3cc\uc9c4\ud560 \ub54c \uce90\ub9ad\ud130\uc758 \uc6b4\ub3d9\ub7c9\uc740 \ub3cc\uc9c4\uc758 \uac01\ub3c4\uc640 \ud0c0\uc774\ubc0d\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\uac83\uc740 \ud50c\ub85c\uc6b0 \ucc28\ud2b8\ub85c \uc124\uba85\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc785\ub825 \ub3cc\uc9c4 \u2192 \uac01\ub3c4/\ud0c0\uc774\ubc0d \ud655\uc778 \u2192 \uc6b4\ub3d9\ub7c9 \uc801\uc6a9. \uc774\ub97c \uc644\ud654\ud558\ub824\uba74 \uc77c\uad00\ub41c \uacb0\uacfc\ub97c \uc704\ud574 \uc810\ud504 \uc815\uc810\uc5d0\uc11c \ub3cc\uc9c4\ud558\uc2ed\uc2dc\uc624. \uc774 \uba54\ucee4\ub2c8\uc998\uc740 \uae4a\uc774\ub97c \ucd94\uac00\ud558\uc9c0\ub9cc \ub9c8\uc2a4\ud130\ud558\ub824\uba74 \uc5f0\uc2b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."}, {"question": "\ub450 \ubc84\ud2bc \ubd04\uc758 \uc5b4\ub5a4 \uc2dc\uc2a4\ud15c \uba54\ucee4\ub2c8\uc998\uc774 \ub09c\uc774\ub3c4 \uc870\uc815\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ub450 \ubc84\ud2bc \ubd04\uc758 \ub09c\uc774\ub3c4 \uc870\uc815\uc740 \uc5ec\ub7ec \uc2dc\uc2a4\ud15c \uba54\ucee4\ub2c8\uc998\uc5d0 \uc758\ud574 \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \uc8fc\uc694 \uc694\uc778\uc740 \ub808\ubca8 5\uc5d0\uc11c \uc774\ub3d9 \ud50c\ub7ab\ud3fc\uc758 \ub3c4\uc785\uacfc \uac19\uc740 \uc7a5\uc560\ubb3c \ud328\ud134\uc758 \ubcf5\uc7a1\uc131 \uc99d\uac00\uc785\ub2c8\ub2e4. \ub610\ud55c \uac8c\uc784\uc740 \uc810\ud504\uc640 \ub3cc\uc9c4\uc758 \ud0c0\uc774\ubc0d \ucc3d\uc744 \uc870\uc815\ud558\uc5ec \uc9c4\ud589\ud560\uc218\ub85d \ub354 \uc881\uac8c \ub9cc\ub4ed\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 15\uc5d0\uc11c \uc131\uacf5\uc801\uc778 \ub3cc\uc9c4\uc744 \uc704\ud55c \ucc3d\uc740 0.2\ucd08\ub85c \uc904\uc5b4\ub4ed\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\uba74 \uac8c\uc784\uc758 \uc5b4\ub824\uc6c0\uc5d0 \ub300\ube44\ud558\uace0 \uc801\uc751\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub450 \ubc84\ud2bc \ubd04\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub450 \ubc84\ud2bc \ubd04\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub824\uba74 \uac8c\uc784\uc758 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \uba3c\uc800 \ub450 \ud50c\ub7ab\ud3fc \ubaa8\ub450\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ucf58\uc194\ub85c \uc774\ub3d9\ud558\ub294 \uacbd\uc6b0 \ub450 \uae30\uae30 \ubaa8\ub450 \uac8c\uc784 \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uc2ed\uc2dc\uc624. \uadf8\ub7f0 \ub2e4\uc74c \uc124\uc815 \uba54\ub274\uc5d0 \uc811\uc18d\ud558\uc5ec '\ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5'\uc744 \uc120\ud0dd\ud558\uc5ec \ub370\uc774\ud130\ub97c \uc5c5\ub85c\ub4dc\ud558\uc2ed\uc2dc\uc624. \uc0c8 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc800\uc7a5 \ud30c\uc77c\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc5ec \uc911\ub2e8\ud588\ub358 \uacf3\uc5d0\uc11c \uacc4\uc18d \uc9c4\ud589\ud558\uc2ed\uc2dc\uc624. \uc774 \ud504\ub85c\uc138\uc2a4\ub294 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc783\uc9c0 \uc54a\uace0 \uc6d0\ud65c\ud55c \uc804\ud658\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "\uc8fc\uc694 \uacbd\ub85c\uc5d0\uc11c \ubc97\uc5b4\ub098 \ud0d0\uc0c9\ud568\uc73c\ub85c\uc368 \ub450 \ubc84\ud2bc \ubd04\uc5d0\uc11c \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub450 \ubc84\ud2bc \ubd04\uc5d0\uc11c \uc8fc\uc694 \uacbd\ub85c\uc5d0\uc11c \ubc97\uc5b4\ub098 \ud0d0\uc0c9\ud558\uba74 \uc228\uaca8\uc9c4 \ub808\ubca8\uacfc \uc218\uc9d1\ud488\uacfc \uac19\uc740 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 7\uc5d0\ub294 \ubcf4\uc774\ub294 \ubcbd\uc5d0 \ub3cc\uc9c4\ud558\uba74 \uc811\uadfc\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc601\uc5ed\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc601\uc5ed\uc5d0\ub294 \ubcf4\ub108\uc2a4 \ub808\ubca8\uc744 \ud574\uc81c\ud558\ub294 \ud76c\uadc0\ud55c \uc218\uc9d1\ud488\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784\uc740 \ud638\uae30\uc2ec\uacfc \ucca0\uc800\ud55c \ud0d0\uc0c9\uc744 \ubcf4\uc0c1\ud558\ubbc0\ub85c \uc228\uaca8\uc9c4 \uacbd\ub85c\ub97c \ub098\ud0c0\ub0bc \uc218 \uc788\ub294 \ud2b9\uc774\ud55c \ud658\uacbd \ub2e8\uc11c\ub97c \ud56d\uc0c1 \uc8fc\uc758 \uae4a\uac8c \uc0b4\ud3b4\ubcf4\uc2ed\uc2dc\uc624."}, {"question": "\ub450 \ubc84\ud2bc \ubd04\uc5d0\uc11c \ucd5c\ub300 \ud6a8\uc728\uc744 \uc704\ud574 \ubc84\ud2bc \uc785\ub825\uc744 \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub450 \ubc84\ud2bc \ubd04\uc5d0\uc11c \ubc84\ud2bc \uc785\ub825\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \ud6a8\uc728\uc801\uc778 \ud0c0\uc774\ubc0d\uacfc \ub9ac\ub4ec\uc744 \uc5f0\uc2b5\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 12\uc5d0\uc11c \uc5ec\ub7ec \ubc88\uc758 \uc810\ud504\uc640 \ub3cc\uc9c4\uc744 \uc5f0\uacb0\ud558\uc5ec \uc5ec\ub7ec \ud50c\ub7ab\ud3fc\uc744 \ube60\ub974\uac8c \uc774\ub3d9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \ubc84\ud2bc A\ub97c \ub20c\ub7ec \uc810\ud504\ud569\ub2c8\ub2e4. STEP2: \uc810\ud504\uc758 \uc815\uc810\uc5d0\uc11c \ubc84\ud2bc B\ub97c \ub20c\ub7ec \ub3cc\uc9c4\ud569\ub2c8\ub2e4. STEP3: \ub3cc\uc9c4 \uc9c1\ud6c4 \ubc84\ud2bc A\ub97c \ub2e4\uc2dc \ub20c\ub7ec \uc2dc\ud000\uc2a4\ub97c \uacc4\uc18d \uc9c4\ud589\ud569\ub2c8\ub2e4. \uc774 \uc5f0\uacb0 \uae30\ubc95\uc740 \uc785\ub825 \uc9c0\uc5f0\uc744 \uc904\uc774\uace0 \uc774\ub3d9 \ud6a8\uc728\uc744 \uadf9\ub300\ud654\ud569\ub2c8\ub2e4. \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uac1c\uc120\ud558\ub824\uba74 \uc774 \ub9ac\ub4ec\uc744 \uc5f0\uc2b5\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ubaa8\ubc14\uc77c\uacfc PC\uc5d0\uc11c\uc758 \ub450 \ubc84\ud2bc \ubd04 \uac8c\uc784 \uacbd\ud5d8 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub450 \ubc84\ud2bc \ubd04\uc758 \uac8c\uc784 \uacbd\ud5d8\uc740 \ucee8\ud2b8\ub864 \ubc29\uc2dd\uacfc \ud654\uba74 \ud06c\uae30\uc5d0 \ub530\ub77c \ubaa8\ubc14\uc77c\uacfc PC\uc5d0\uc11c \ub2e4\ub985\ub2c8\ub2e4. \ubaa8\ubc14\uc77c\uc5d0\uc11c\ub294 \ud130\uce58 \ucee8\ud2b8\ub864\uc774 PC\uc758 \ubb3c\ub9ac\uc801 \ubc84\ud2bc\uc5d0 \ube44\ud574 \ub2e4\ub978 \ucd09\uac01 \ud53c\ub4dc\ubc31\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubaa8\ubc14\uc77c\uc5d0\uc11c \uc810\ud504\uc640 \ub3cc\uc9c4\uc5d0 \uc2a4\uc640\uc774\ud504 \uc81c\uc2a4\ucc98\ub97c \uc0ac\uc6a9\ud560 \uc218 \uc788\uc9c0\ub9cc, PC\uc5d0\uc11c\ub294 \ud0a4\ubcf4\ub4dc \ud0a4\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ub610\ud55c, PC\uc758 \ub354 \ud070 \ud654\uba74\uc740 \ud658\uacbd\uc744 \ub354 \uc790\uc138\ud558\uac8c \ubcfc \uc218 \uc788\uac8c \ud558\ubbc0\ub85c \ubc18\uc751 \uc2dc\uac04\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce60 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub450 \ubc84\uc804 \ubaa8\ub450 \uace0\uc720\ud55c \uc7a5\uc810\uc774 \uc788\uc73c\ubbc0\ub85c \uc120\ud638\ub3c4\uc5d0 \ub530\ub77c \uc120\ud0dd\ud558\uc2ed\uc2dc\uc624."}, {"question": "\ub450 \ubc84\ud2bc \ubd04\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc11c\ub85c \ub2e4\ub978 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc744 \uc5b4\ub5bb\uac8c \ubcf4\uc0c1\ud569\ub2c8\uae4c?", "answer": "\ub450 \ubc84\ud2bc \ubd04\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc18d\ub3c4, \uc815\ud655\uc131 \ubc0f \uc218\uc9d1\ud488\uc5d0 \ub300\ud55c \uc810\uc218\ub97c \uc81c\uacf5\ud558\uc5ec \uc11c\ub85c \ub2e4\ub978 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ubcf4\uc0c1\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8\uc744 \ube60\ub974\uac8c \uc644\ub8cc\ud558\uba74 \uc18d\ub3c4 \ubcf4\ub108\uc2a4\ub97c \ubc1b\uace0 \ubaa8\ub4e0 \uc544\uc774\ud15c\uc744 \uc218\uc9d1\ud558\uba74 \uc815\ud655\uc131 \ubcf4\ub108\uc2a4\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \ub450 \uac00\uc9c0\ub97c \ube44\uad50\ud574 \ubcf4\uba74 \uc18d\ub3c4 \uc911\uc2ec \ud50c\ub808\uc774\uc5b4\ub294 \ube60\ub978 \uc774\ub3d9\uc744 \uc6b0\uc120\uc2dc\ud558\ub294 \ubc18\uba74, \uc815\ud655\uc131 \uc911\uc2ec \ud50c\ub808\uc774\uc5b4\ub294 \uc644\ubcbd\ud55c \uc2e4\ud589\uc744 \ubaa9\ud45c\ub85c \ud569\ub2c8\ub2e4. \uac8c\uc784\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ub450 \uac00\uc9c0 \uc811\uadfc \ubc29\uc2dd\uc744 \uc7a5\ub824\ud558\uc5ec \ud50c\ub808\uc774\uc5b4\uac00 \uc790\uc2e0\uc758 \uac15\uc810\uc5d0 \ub9de\ub294 \uc804\ub7b5\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uac8c \ud569\ub2c8\ub2e4."}, {"question": "\ub450 \ubc84\ud2bc \ubd04\uc5d0\uc11c \uac00\uc7a5 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uae30 \uc704\ud574 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \uace0\uae09 \uae30\uc220\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub450 \ubc84\ud2bc \ubd04\uc5d0\uc11c \uac00\uc7a5 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\ub824\uba74 \ud30c\ub3c4 \ub3cc\uc9c4\uacfc \uac00\uc7a5\uc790\ub9ac \ucde8\uc18c\uc640 \uac19\uc740 \uace0\uae09 \uae30\uc220\uc774 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 20\uc5d0\uc11c \ud30c\ub3c4 \ub3cc\uc9c4\uc744 \uc0ac\uc6a9\ud558\uba74 \uc881\uc740 \uacf5\uac04\uc744 \uc774\ub3d9\ud558\uba74\uc11c \uc6b4\ub3d9\ub7c9\uc744 \uc720\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \uc810\ud504\ud558\uace0 \uc989\uc2dc \ub3cc\uc9c4\ud569\ub2c8\ub2e4. STEP2: \ucc29\uc9c0\ud558\uba74 \uc18d\ub3c4\ub97c \uc783\uc9c0 \uc54a\uace0 \ub2e4\uc2dc \uc810\ud504\ud569\ub2c8\ub2e4. STEP3: \ub808\ubca8\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \ud1b5\uacfc\ud558\ub824\uba74 \uc2dc\ud000\uc2a4\ub97c \ubc18\ubcf5\ud569\ub2c8\ub2e4. \uac00\uc7a5\uc790\ub9ac \ucde8\uc18c\ub294 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub3cc\uc9c4\ud558\uc5ec \ub3cc\uc9c4 \uc560\ub2c8\uba54\uc774\uc158\uc744 \ucde8\uc18c\ud558\uace0 \ub354 \ube60\ub978 \ud68c\ubcf5\uc744 \ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uae30\uc220\uc744 \ub9c8\uc2a4\ud130\ud558\uba74 \ucc4c\ub9b0\uc9c0 \ub808\ubca8\uc5d0\uc11c \uc131\ub2a5\uc774 \ud06c\uac8c \ud5a5\uc0c1\ub429\ub2c8\ub2e4."}]
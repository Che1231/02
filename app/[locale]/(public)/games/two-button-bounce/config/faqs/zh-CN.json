[{"question": "\u5982\u4f55\u4f5c\u4e3a\u521d\u5b66\u8005\u638c\u63e1\u53cc\u6309\u94ae\u5f39\u8df3\u6e38\u620f\u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u638c\u63e1\u53cc\u6309\u94ae\u5f39\u8df3\u6e38\u620f\u7684\u57fa\u672c\u63a7\u5236\uff0c\u9700\u8981\u4e13\u6ce8\u4e8e\u53cc\u6309\u94ae\u673a\u5236\u3002\u4f7f\u7528\u6309\u94ae A \u8df3\u8dc3\uff0c\u6309\u94ae B \u51b2\u523a\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u5173\uff0c\u4f60\u9700\u8981\u8df3\u8fc7\u4e00\u4e2a\u7a7a\u9699\uff0c\u7136\u540e\u51b2\u523a\u6765\u8eb2\u907f\u969c\u788d\u7269\u3002\u7ec3\u4e60\u8df3\u8dc3\u548c\u51b2\u523a\u4e0e\u6e38\u620f\u8282\u594f\u540c\u6b65\u7684\u65f6\u95f4\u3002\u4e00\u4e2a\u6709\u5e2e\u52a9\u7684\u6280\u5de7\u662f\u5c06\u6309\u94ae\u60f3\u8c61\u6210\u4f60\u7684\u89d2\u8272\u7684\u811a\u2014\u2014\u6309\u94ae A \u8ba9\u4f60\u5411\u4e0a\u8df3\u8d77\uff0c\u6309\u94ae B \u63a8\u52a8\u4f60\u5411\u524d\u3002\u8fd9\u4e2a\u7c7b\u6bd4\u53ef\u4ee5\u4f7f\u63a7\u5236\u66f4\u52a0\u76f4\u89c2\u3002"}, {"question": "\u5728\u73a9\u4e86 100 \u4e2a\u5c0f\u65f6\u540e\uff0c\u53cc\u6309\u94ae\u5f39\u8df3\u6e38\u620f\u4e2d\u6709\u54ea\u4e9b\u5173\u952e\u7b56\u7565\u53ef\u4ee5\u63a8\u8fdb\u6e38\u620f\uff1f", "answer": "\u5728\u73a9\u4e86 100 \u4e2a\u5c0f\u65f6\u540e\uff0c\u53cc\u6309\u94ae\u5f39\u8df3\u6e38\u620f\u4e2d\u63d0\u5347\u9700\u8981\u7cbe\u786e\u7684\u64cd\u4f5c\u548c\u7b56\u7565\u3002\u6b65\u9aa4 1\uff1a\u638c\u63e1\u590d\u6742\u5e8f\u5217\u4e2d\u8df3\u8dc3\u548c\u51b2\u523a\u7684\u65f6\u95f4\u3002\u6b65\u9aa4 2\uff1a\u5b66\u4e60\u6bcf\u5173\u7684\u6a21\u5f0f\uff0c\u4ee5\u9884\u6d4b\u969c\u788d\u7269\u3002\u6b65\u9aa4 3\uff1a\u6709\u6548\u5730\u5229\u7528\u9053\u5177\uff0c\u4f8b\u5982 10 \u7ea7\u5173\u5361\u7684\u52a0\u901f\u9053\u5177\u6765\u7ed5\u8fc7\u4e00\u7cfb\u5217\u79fb\u52a8\u5e73\u53f0\u3002\u6bd4\u8f83\u4e0d\u540c\u7684\u65b9\u6cd5\uff0c\u4e00\u4e9b\u73a9\u5bb6\u66f4\u559c\u6b22\u4e13\u6ce8\u4e8e\u901f\u5ea6\uff0c\u800c\u53e6\u4e00\u4e9b\u73a9\u5bb6\u5219\u66f4\u6ce8\u91cd\u7cbe\u786e\u5ea6\u3002\u5c1d\u8bd5\u627e\u5230\u6700\u9002\u5408\u4f60\u7684\u7b56\u7565\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u53cc\u6309\u94ae\u5f39\u8df3\u6e38\u620f\u4e2d\u7684\u51b2\u523a\u673a\u5236\u6709\u65f6\u4f1a\u611f\u89c9\u4e0d\u7a33\u5b9a\uff1f", "answer": "\u53cc\u6309\u94ae\u5f39\u8df3\u6e38\u620f\u4e2d\u7684\u51b2\u523a\u673a\u5236\u53ef\u80fd\u4f1a\u611f\u89c9\u4e0d\u7a33\u5b9a\uff0c\u8fd9\u662f\u7531\u4e8e\u6e38\u620f\u7269\u7406\u5f15\u64ce\u9020\u6210\u7684\u3002\u4f8b\u5982\uff0c\u5f53\u4ece\u60ac\u5d16\u5ced\u58c1\u51b2\u523a\u65f6\uff0c\u89d2\u8272\u7684\u52a8\u91cf\u53ef\u80fd\u4f1a\u6839\u636e\u51b2\u523a\u7684\u89d2\u5ea6\u548c\u65f6\u95f4\u800c\u53d8\u5316\u3002\u8fd9\u53ef\u4ee5\u7528\u6d41\u7a0b\u56fe\u8bf4\u660e\uff1a\u8f93\u5165\u51b2\u523a \u2192 \u68c0\u67e5\u89d2\u5ea6/\u65f6\u95f4 \u2192 \u5e94\u7528\u52a8\u91cf\u3002\u4e3a\u4e86\u51cf\u8f7b\u8fd9\u79cd\u60c5\u51b5\uff0c\u786e\u4fdd\u5728\u8df3\u8dc3\u9876\u70b9\u51b2\u523a\u4ee5\u83b7\u5f97\u4e00\u81f4\u7684\u7ed3\u679c\u3002\u8fd9\u4e2a\u673a\u5236\u589e\u52a0\u4e86\u6e38\u620f\u7684\u6df1\u5ea6\uff0c\u4f46\u9700\u8981\u7ec3\u4e60\u624d\u80fd\u638c\u63e1\u3002"}, {"question": "\u53cc\u6309\u94ae\u5f39\u8df3\u6e38\u620f\u4e2d\u7684\u54ea\u4e9b\u7cfb\u7edf\u673a\u5236\u4f1a\u5f71\u54cd\u6e38\u620f\u96be\u5ea6\u7684\u63d0\u5347\uff1f", "answer": "\u53cc\u6309\u94ae\u5f39\u8df3\u6e38\u620f\u4e2d\u7684\u96be\u5ea6\u63d0\u5347\u53d7\u5230\u591a\u79cd\u7cfb\u7edf\u673a\u5236\u7684\u5f71\u54cd\u3002\u4e3b\u8981\u56e0\u7d20\u662f\u969c\u788d\u7269\u6a21\u5f0f\u7684\u590d\u6742\u6027\u4e0d\u65ad\u589e\u52a0\uff0c\u4f8b\u5982 5 \u7ea7\u5173\u5361\u5f15\u5165\u4e86\u79fb\u52a8\u5e73\u53f0\u3002\u6b64\u5916\uff0c\u6e38\u620f\u4f1a\u8c03\u6574\u8df3\u8dc3\u548c\u51b2\u523a\u7684\u65f6\u95f4\u7a97\u53e3\uff0c\u968f\u7740\u6e38\u620f\u7684\u8fdb\u884c\uff0c\u8fd9\u4e9b\u7a97\u53e3\u4f1a\u53d8\u5f97\u66f4\u7a84\u3002\u4f8b\u5982\uff0c\u5728 15 \u7ea7\u5173\u5361\u4e2d\uff0c\u6210\u529f\u51b2\u523a\u7684\u7a97\u53e3\u7f29\u77ed\u4e86 0.2 \u79d2\u3002\u7406\u89e3\u8fd9\u4e9b\u673a\u5236\u53ef\u4ee5\u5e2e\u52a9\u4f60\u9884\u6d4b\u5e76\u9002\u5e94\u6e38\u620f\u7684\u6311\u6218\u3002"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684\u53cc\u6309\u94ae\u5f39\u8df3\u6e38\u620f\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u5e73\u53f0\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u5e73\u53f0\uff1f", "answer": "\u5728\u4e0d\u540c\u5e73\u53f0\u95f4\u8f6c\u79fb\u53cc\u6309\u94ae\u5f39\u8df3\u6e38\u620f\u8fdb\u5ea6\u9700\u8981\u4f7f\u7528\u6e38\u620f\u7684\u4e91\u7aef\u4fdd\u5b58\u529f\u80fd\u3002\u9996\u5148\uff0c\u786e\u4fdd\u4f60\u5728\u4e24\u4e2a\u5e73\u53f0\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u5e10\u6237\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4ece PC \u8f6c\u79fb\u5230\u6e38\u620f\u4e3b\u673a\uff0c\u8bf7\u5728\u4e24\u4e2a\u8bbe\u5907\u4e0a\u90fd\u4f7f\u7528\u4f60\u7684\u6e38\u620f\u5e10\u6237\u767b\u5f55\u3002\u7136\u540e\uff0c\u8fdb\u5165\u8bbe\u7f6e\u83dc\u5355\uff0c\u9009\u62e9\u201c\u4e91\u7aef\u4fdd\u5b58\u201d\u4ee5\u4e0a\u4f20\u4f60\u7684\u6570\u636e\u3002\u5728\u65b0\u5e73\u53f0\u4e0a\uff0c\u4e0b\u8f7d\u4fdd\u5b58\u6587\u4ef6\u4ee5\u7ee7\u7eed\u672a\u5b8c\u6210\u7684\u6e38\u620f\u8fdb\u5ea6\u3002\u8fd9\u4e2a\u8fc7\u7a0b\u53ef\u4ee5\u786e\u4fdd\u5e73\u6ed1\u7684\u8f6c\u6362\uff0c\u4e0d\u4f1a\u4e22\u5931\u4efb\u4f55\u8fdb\u5ea6\u3002"}, {"question": "\u901a\u8fc7\u63a2\u7d22\u4e3b\u8def\u5f84\u4ee5\u5916\u7684\u533a\u57df\uff0c\u6211\u5728\u53cc\u6309\u94ae\u5f39\u8df3\u6e38\u620f\u4e2d\u53ef\u4ee5\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u5185\u5bb9\uff1f", "answer": "\u5728\u53cc\u6309\u94ae\u5f39\u8df3\u6e38\u620f\u4e2d\uff0c\u63a2\u7d22\u4e3b\u8def\u5f84\u4ee5\u5916\u7684\u533a\u57df\u53ef\u4ee5\u53d1\u73b0\u9690\u85cf\u5185\u5bb9\uff0c\u4f8b\u5982\u9690\u85cf\u5173\u5361\u548c\u6536\u96c6\u54c1\u3002\u4f8b\u5982\uff0c\u5728 7 \u7ea7\u5173\u5361\u4e2d\uff0c\u53ef\u4ee5\u901a\u8fc7\u51b2\u523a\u770b\u4f3c\u575a\u56fa\u7684\u5899\u58c1\u6765\u8fdb\u5165\u9690\u85cf\u533a\u57df\u3002\u6b64\u533a\u57df\u5305\u542b\u7a00\u6709\u6536\u96c6\u54c1\uff0c\u53ef\u4ee5\u89e3\u9501\u989d\u5916\u5173\u5361\u3002\u6e38\u620f\u5956\u52b1\u597d\u5947\u5fc3\u548c\u5f7b\u5e95\u63a2\u7d22\uff0c\u56e0\u6b64\u8bf7\u65f6\u523b\u7559\u610f\u53ef\u80fd\u6697\u793a\u9690\u85cf\u8def\u5f84\u7684\u5f02\u5e38\u73af\u5883\u7ebf\u7d22\u3002"}, {"question": "\u5982\u4f55\u5728\u53cc\u6309\u94ae\u5f39\u8df3\u6e38\u620f\u4e2d\u4f18\u5316\u6211\u7684\u6309\u94ae\u8f93\u5165\uff0c\u4ee5\u8fbe\u5230\u6700\u5927\u6548\u7387\uff1f", "answer": "\u5728\u53cc\u6309\u94ae\u5f39\u8df3\u6e38\u620f\u4e2d\u4f18\u5316\u6309\u94ae\u8f93\u5165\u9700\u8981\u7ec3\u4e60\u9ad8\u6548\u7684\u65f6\u95f4\u548c\u8282\u594f\u3002\u4f8b\u5982\uff0c\u5728 12 \u7ea7\u5173\u5361\u4e2d\uff0c\u4f60\u53ef\u4ee5\u5c06\u591a\u6b21\u8df3\u8dc3\u548c\u51b2\u523a\u7ec4\u5408\u5728\u4e00\u8d77\uff0c\u4ee5\u5feb\u901f\u7a7f\u8fc7\u4e00\u7cfb\u5217\u5e73\u53f0\u3002\u6b65\u9aa4 1\uff1a\u6309\u4e0b\u6309\u94ae A \u8fdb\u884c\u8df3\u8dc3\u3002\u6b65\u9aa4 2\uff1a\u5728\u8df3\u8dc3\u7684\u9876\u70b9\uff0c\u6309\u4e0b\u6309\u94ae B \u8fdb\u884c\u51b2\u523a\u3002\u6b65\u9aa4 3\uff1a\u51b2\u523a\u540e\u7acb\u5373\u518d\u6b21\u6309\u4e0b\u6309\u94ae A \u7ee7\u7eed\u6b64\u5e8f\u5217\u3002\u8fd9\u79cd\u7ec4\u5408\u6280\u672f\u53ef\u4ee5\u51cf\u5c11\u8f93\u5165\u5ef6\u8fdf\u5e76\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u79fb\u52a8\u6548\u7387\u3002\u7ec3\u4e60\u8fd9\u79cd\u8282\u594f\u4ee5\u63d0\u9ad8\u4f60\u7684\u6e38\u620f\u6c34\u5e73\u3002"}, {"question": "\u5728\u79fb\u52a8\u7aef\u548c PC \u7aef\u53cc\u6309\u94ae\u5f39\u8df3\u6e38\u620f\u4e2d\uff0c\u6e38\u620f\u4f53\u9a8c\u6709\u4ec0\u4e48\u4e0d\u540c\uff1f", "answer": "\u7531\u4e8e\u63a7\u5236\u65b9\u6848\u548c\u5c4f\u5e55\u5c3a\u5bf8\u7684\u4e0d\u540c\uff0c\u53cc\u6309\u94ae\u5f39\u8df3\u6e38\u620f\u5728\u79fb\u52a8\u7aef\u548c PC \u7aef\u7684\u4f53\u9a8c\u6709\u6240\u4e0d\u540c\u3002\u5728\u79fb\u52a8\u7aef\uff0c\u89e6\u6478\u63a7\u5236\u4e0e PC \u7aef\u7684\u7269\u7406\u6309\u94ae\u76f8\u6bd4\u63d0\u4f9b\u4e86\u4e0d\u540c\u7684\u89e6\u89c9\u53cd\u9988\u3002\u4f8b\u5982\uff0c\u5728\u79fb\u52a8\u7aef\uff0c\u4f60\u53ef\u80fd\u4f1a\u4f7f\u7528\u6ed1\u52a8\u6765\u8fdb\u884c\u8df3\u8dc3\u548c\u51b2\u523a\uff0c\u800c\u5728 PC \u7aef\uff0c\u4f60\u4f7f\u7528\u952e\u76d8\u6309\u952e\u3002\u6b64\u5916\uff0cPC \u7aef\u66f4\u5927\u7684\u5c4f\u5e55\u63d0\u4f9b\u4e86\u66f4\u8be6\u7ec6\u7684\u73af\u5883\u89c6\u91ce\uff0c\u8fd9\u53ef\u80fd\u4f1a\u5f71\u54cd\u53cd\u5e94\u65f6\u95f4\u3002\u4e24\u4e2a\u7248\u672c\u90fd\u6709\u5176\u72ec\u7279\u7684\u4f18\u52bf\uff0c\u56e0\u6b64\u9009\u62e9\u53d6\u51b3\u4e8e\u4f60\u7684\u559c\u597d\u3002"}, {"question": "\u53cc\u6309\u94ae\u5f39\u8df3\u6e38\u620f\u7684\u8bc4\u5206\u7cfb\u7edf\u5982\u4f55\u5956\u52b1\u4e0d\u540c\u7684\u6e38\u620f\u98ce\u683c\uff1f", "answer": "\u53cc\u6309\u94ae\u5f39\u8df3\u6e38\u620f\u7684\u8bc4\u5206\u7cfb\u7edf\u901a\u8fc7\u5956\u52b1\u901f\u5ea6\u3001\u7cbe\u786e\u6027\u548c\u6536\u96c6\u54c1\u7684\u70b9\u6570\u91cf\u6765\u5956\u52b1\u4e0d\u540c\u7684\u6e38\u620f\u98ce\u683c\u3002\u4f8b\u5982\uff0c\u5feb\u901f\u5b8c\u6210\u5173\u5361\u53ef\u4ee5\u83b7\u5f97\u901f\u5ea6\u52a0\u6210\uff0c\u6536\u96c6\u6240\u6709\u7269\u54c1\u53ef\u4ee5\u83b7\u5f97\u7cbe\u786e\u5ea6\u52a0\u6210\u3002\u6bd4\u8f83\u4e24\u8005\uff0c\u4fa7\u91cd\u4e8e\u901f\u5ea6\u7684\u73a9\u5bb6\u53ef\u80fd\u4f1a\u4f18\u5148\u8003\u8651\u5feb\u901f\u79fb\u52a8\uff0c\u800c\u4fa7\u91cd\u4e8e\u7cbe\u786e\u5ea6\u7684\u73a9\u5bb6\u5219\u4f1a\u8ffd\u6c42\u5b8c\u7f8e\u5b8c\u6210\u6e38\u620f\u3002\u6e38\u620f\u7684\u8bc4\u5206\u7cfb\u7edf\u9f13\u52b1\u4e24\u79cd\u65b9\u6cd5\uff0c\u5141\u8bb8\u73a9\u5bb6\u6839\u636e\u81ea\u5df1\u7684\u4f18\u52bf\u8c03\u6574\u7b56\u7565\u3002"}, {"question": "\u4e3a\u4e86\u5b8c\u6210\u53cc\u6309\u94ae\u5f39\u8df3\u6e38\u620f\u4e2d\u6700\u96be\u7684\u5173\u5361\uff0c\u6211\u53ef\u4ee5\u4f7f\u7528\u54ea\u4e9b\u9ad8\u7ea7\u6280\u5de7\uff1f", "answer": "\u4e3a\u4e86\u5b8c\u6210\u53cc\u6309\u94ae\u5f39\u8df3\u6e38\u620f\u4e2d\u6700\u96be\u7684\u5173\u5361\uff0c\u638c\u63e1\u9ad8\u7ea7\u6280\u5de7\u5982\u6ce2\u6d6a\u51b2\u523a\u548c\u8fb9\u7f18\u53d6\u6d88\u81f3\u5173\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5728 20 \u7ea7\u5173\u5361\u4e2d\uff0c\u6ce2\u6d6a\u51b2\u523a\u53ef\u4ee5\u8ba9\u4f60\u5728\u72ed\u7a84\u7a7a\u95f4\u4e2d\u4fdd\u6301\u52a8\u91cf\u3002\u6b65\u9aa4 1\uff1a\u8df3\u8dc3\u5e76\u7acb\u5373\u51b2\u523a\u3002\u6b65\u9aa4 2\uff1a\u7740\u9646\u65f6\uff0c\u5728\u4e0d\u51cf\u901f\u7684\u60c5\u51b5\u4e0b\u518d\u6b21\u8df3\u8dc3\u3002\u6b65\u9aa4 3\uff1a\u91cd\u590d\u6b64\u5e8f\u5217\u6765\u6709\u6548\u5730\u7a7f\u8d8a\u5173\u5361\u3002\u8fb9\u7f18\u53d6\u6d88\u5305\u62ec\u51b2\u523a\u79bb\u5f00\u5e73\u53f0\u4ee5\u53d6\u6d88\u51b2\u523a\u52a8\u753b\uff0c\u4ece\u800c\u66f4\u5feb\u5730\u6062\u590d\u3002\u638c\u63e1\u8fd9\u4e9b\u6280\u5de7\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u5728\u6311\u6218\u5173\u5361\u4e2d\u7684\u8868\u73b0\u3002"}]
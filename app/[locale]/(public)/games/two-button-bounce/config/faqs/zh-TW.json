[{"question": "\u5982\u4f55\u4f5c\u70ba\u521d\u5b78\u8005\u638c\u63e1Two Button Bounce\u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u638c\u63e1Two Button Bounce\u7684\u57fa\u672c\u63a7\u5236\uff0c\u91cd\u9ede\u5728\u65bc\u96d9\u6309\u9215\u7684\u6a5f\u5236\u3002\u4f7f\u7528\u6309\u9215A\u8df3\u8e8d\uff0c\u6309\u9215B\u885d\u523a\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u95dc\uff0c\u4f60\u9700\u8981\u8df3\u904e\u4e00\u500b\u9593\u9699\uff0c\u7136\u5f8c\u885d\u523a\u4ee5\u8eb2\u907f\u969c\u7919\u7269\u3002\u7df4\u7fd2\u540c\u6b65\u8df3\u8e8d\u548c\u885d\u523a\u7684\u6642\u9593\u8207\u904a\u6232\u7bc0\u594f\u3002\u4e00\u500b\u6709\u7528\u7684\u6280\u5de7\u662f\u5c07\u6309\u9215\u60f3\u50cf\u70ba\u89d2\u8272\u7684\u96d9\u8173\u2014\u2014\u6309\u9215A\u5c07\u4f60\u5411\u4e0a\u62ac\uff0c\u6309\u9215B\u5c07\u4f60\u5411\u524d\u63a8\u52d5\u3002\u9019\u500b\u985e\u6bd4\u53ef\u4ee5\u8b93\u63a7\u5236\u66f4\u76f4\u89c0\u3002"}, {"question": "\u5728\u73a9\u4e86100\u5c0f\u6642\u7684Two Button Bounce\u4e4b\u5f8c\uff0c\u54ea\u4e9b\u95dc\u9375\u7b56\u7565\u53ef\u4ee5\u5e6b\u52a9\u9032\u968e\uff1f", "answer": "\u5728\u73a9\u4e86100\u5c0f\u6642\u5f8c\uff0cTwo Button Bounce\u7684\u9032\u968e\u9700\u8981\u7cbe\u78ba\u6027\u548c\u7b56\u7565\u6027\u3002\u6b65\u9a5f1\uff1a\u638c\u63e1\u8907\u96dc\u5e8f\u5217\u4e2d\u8df3\u8e8d\u548c\u885d\u523a\u7684\u6642\u9593\u3002\u6b65\u9a5f2\uff1a\u5b78\u7fd2\u6bcf\u4e00\u95dc\u7684\u6a21\u5f0f\uff0c\u9810\u6e2c\u969c\u7919\u7269\u3002\u6b65\u9a5f3\uff1a\u6709\u6548\u5730\u5229\u7528\u9053\u5177\uff0c\u4f8b\u5982\u7b2c10\u95dc\u7684\u901f\u5ea6\u63d0\u5347\uff0c\u4f86\u7e5e\u904e\u4e00\u7cfb\u5217\u79fb\u52d5\u5e73\u53f0\u3002\u6bd4\u8f03\u4e0d\u540c\u7684\u65b9\u6cd5\uff0c\u4e00\u4e9b\u73a9\u5bb6\u559c\u6b61\u5c08\u6ce8\u65bc\u901f\u5ea6\uff0c\u800c\u53e6\u4e00\u4e9b\u73a9\u5bb6\u5247\u512a\u5148\u65bc\u7cbe\u78ba\u6027\u3002\u5be6\u9a57\u4ee5\u627e\u5230\u4f60\u7684\u6700\u4f73\u7b56\u7565\u3002"}, {"question": "\u70ba\u4ec0\u9ebcTwo Button Bounce\u4e2d\u7684\u885d\u523a\u6a5f\u5236\u6709\u6642\u611f\u89ba\u4e0d\u7a69\u5b9a\uff1f", "answer": "Two Button Bounce\u4e2d\u7684\u885d\u523a\u6a5f\u5236\u53ef\u80fd\u611f\u89ba\u4e0d\u7a69\u5b9a\uff0c\u662f\u56e0\u70ba\u904a\u6232\u7684\u7269\u7406\u5f15\u64ce\u3002\u4f8b\u5982\uff0c\u7576\u5f9e\u5e73\u53f0\u908a\u7de3\u885d\u523a\u6642\uff0c\u89d2\u8272\u7684\u52d5\u91cf\u53ef\u80fd\u6703\u6839\u64da\u885d\u523a\u7684\u89d2\u5ea6\u548c\u6642\u9593\u800c\u6709\u6240\u4e0d\u540c\u3002\u9019\u53ef\u4ee5\u7528\u6d41\u7a0b\u5716\u4f86\u8aaa\u660e\uff1a\u8f38\u5165\u885d\u523a \u2192 \u6aa2\u67e5\u89d2\u5ea6/\u6642\u9593 \u2192 \u61c9\u7528\u52d5\u91cf\u3002\u70ba\u4e86\u6e1b\u8f15\u9019\u7a2e\u60c5\u6cc1\uff0c\u8acb\u78ba\u4fdd\u5728\u8df3\u8e8d\u9802\u9ede\u885d\u523a\u4ee5\u7372\u5f97\u4e00\u81f4\u7684\u7d50\u679c\u3002\u9019\u500b\u6a5f\u5236\u589e\u52a0\u4e86\u6df1\u5ea6\uff0c\u4f46\u9700\u8981\u7df4\u7fd2\u624d\u80fd\u638c\u63e1\u3002"}, {"question": "\u54ea\u4e9bTwo Button Bounce\u7684\u7cfb\u7d71\u6a5f\u5236\u6703\u5f71\u97ff\u96e3\u5ea6\u63d0\u5347\uff1f", "answer": "Two Button Bounce\u7684\u96e3\u5ea6\u63d0\u5347\u53d7\u5e7e\u500b\u7cfb\u7d71\u6a5f\u5236\u5f71\u97ff\u3002\u4e3b\u8981\u56e0\u7d20\u662f\u969c\u7919\u7269\u6a21\u5f0f\u7684\u8907\u96dc\u6027\u589e\u52a0\uff0c\u4f8b\u5982\u7b2c5\u95dc\u5f15\u5165\u4e86\u79fb\u52d5\u5e73\u53f0\u3002\u6b64\u5916\uff0c\u904a\u6232\u6703\u8abf\u6574\u8df3\u8e8d\u548c\u885d\u523a\u7684\u6642\u9593\u7a97\uff0c\u96a8\u8457\u4f60\u7684\u9032\u5ea6\u800c\u7e2e\u5c0f\u3002\u4f8b\u5982\uff0c\u5728\u7b2c15\u95dc\uff0c\u6210\u529f\u885d\u523a\u7684\u6642\u9593\u7a97\u6703\u7e2e\u77ed0.2\u79d2\u3002\u4e86\u89e3\u9019\u4e9b\u6a5f\u5236\u53ef\u4ee5\u5e6b\u52a9\u4f60\u9810\u6e2c\u548c\u9069\u61c9\u904a\u6232\u7684\u6311\u6230\u3002"}, {"question": "\u5982\u4f55\u5c07\u6211\u7684Two Button Bounce\u9032\u5ea6\u5f9e\u4e00\u500b\u5e73\u53f0\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u5e73\u53f0\uff1f", "answer": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u9593\u8f49\u79fb\u4f60\u7684Two Button Bounce\u9032\u5ea6\uff0c\u9700\u8981\u4f7f\u7528\u904a\u6232\u7684\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u3002\u9996\u5148\uff0c\u78ba\u4fdd\u4f60\u5728\u5169\u500b\u5e73\u53f0\u4e0a\u90fd\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5f9e\u96fb\u8166\u8f49\u79fb\u5230\u4e3b\u6a5f\uff0c\u8acb\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u90fd\u4f7f\u7528\u4f60\u7684\u904a\u6232\u5e33\u6236\u767b\u5165\u3002\u63a5\u8457\uff0c\u9032\u5165\u8a2d\u5b9a\u9078\u55ae\u4e26\u9078\u64c7\u300c\u96f2\u7aef\u5132\u5b58\u300d\u4e0a\u50b3\u4f60\u7684\u8cc7\u6599\u3002\u5728\u65b0\u5e73\u53f0\u4e0a\uff0c\u4e0b\u8f09\u5132\u5b58\u6a94\u4ee5\u7e7c\u7e8c\u4f60\u4e4b\u524d\u7684\u9032\u5ea6\u3002\u9019\u500b\u7a0b\u5e8f\u53ef\u78ba\u4fdd\u9806\u5229\u8f49\u63db\uff0c\u4e0d\u6703\u907a\u5931\u4efb\u4f55\u9032\u5ea6\u3002"}, {"question": "\u900f\u904e\u63a2\u7d22\u4e3b\u7dda\u8def\u5f91\u4ee5\u5916\u7684\u5340\u57df\uff0c\u6211\u5728Two Button Bounce\u4e2d\u53ef\u4ee5\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u5167\u5bb9\uff1f", "answer": "\u5728Two Button Bounce\u4e2d\uff0c\u63a2\u7d22\u504f\u96e2\u4e3b\u7dda\u8def\u5f91\uff0c\u53ef\u4ee5\u63ed\u793a\u96b1\u85cf\u5167\u5bb9\uff0c\u4f8b\u5982\u79d8\u5bc6\u95dc\u5361\u548c\u6536\u96c6\u54c1\u3002\u4f8b\u5982\uff0c\u5728\u7b2c7\u95dc\uff0c\u6709\u4e00\u500b\u96b1\u85cf\u5340\u57df\uff0c\u53ef\u900f\u904e\u885d\u523a\u9032\u5165\u770b\u4f3c\u5805\u56fa\u7684\u7246\u58c1\u4f86\u9032\u5165\u3002\u6b64\u5340\u57df\u5305\u542b\u7a00\u6709\u6536\u96c6\u54c1\uff0c\u89e3\u9396\u4e00\u500b\u984d\u5916\u95dc\u5361\u3002\u904a\u6232\u734e\u52f5\u597d\u5947\u5fc3\u548c\u5fb9\u5e95\u7684\u63a2\u7d22\uff0c\u6240\u4ee5\u59cb\u7d42\u8981\u6ce8\u610f\u53ef\u80fd\u6697\u793a\u96b1\u85cf\u9014\u5f91\u7684\u7570\u5e38\u74b0\u5883\u7dda\u7d22\u3002"}, {"question": "\u5982\u4f55\u5728Two Button Bounce\u4e2d\u512a\u5316\u6211\u7684\u6309\u9375\u8f38\u5165\uff0c\u4ee5\u9054\u5230\u6700\u9ad8\u7684\u6548\u7387\uff1f", "answer": "\u5728Two Button Bounce\u4e2d\u512a\u5316\u6309\u9375\u8f38\u5165\uff0c\u9700\u8981\u7df4\u7fd2\u9ad8\u6548\u7684\u7bc0\u594f\u548c\u6642\u9593\u3002\u4f8b\u5982\uff0c\u5728\u7b2c12\u95dc\uff0c\u4f60\u53ef\u4ee5\u5c07\u591a\u6b21\u8df3\u8e8d\u548c\u885d\u523a\u9023\u63a5\u5728\u4e00\u8d77\uff0c\u5feb\u901f\u5730\u7a7f\u68ad\u65bc\u4e00\u7cfb\u5217\u5e73\u53f0\u3002\u6b65\u9a5f1\uff1a\u6309\u4e0b\u6309\u9215A\u9032\u884c\u8df3\u8e8d\u3002\u6b65\u9a5f2\uff1a\u5728\u8df3\u8e8d\u9802\u9ede\uff0c\u6309\u4e0b\u6309\u9215B\u9032\u884c\u885d\u523a\u3002\u6b65\u9a5f3\uff1a\u885d\u523a\u5f8c\u7acb\u5373\u518d\u6b21\u6309\u4e0b\u6309\u9215A\uff0c\u4ee5\u7e7c\u7e8c\u8a72\u52d5\u4f5c\u5e8f\u5217\u3002\u9019\u7a2e\u9023\u9396\u6280\u8853\u53ef\u4ee5\u6e1b\u5c11\u8f38\u5165\u5ef6\u9072\uff0c\u4e26\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u79fb\u52d5\u6548\u7387\u3002\u7df4\u7fd2\u9019\u500b\u7bc0\u594f\u53ef\u4ee5\u6539\u5584\u4f60\u7684\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u5728Two Button Bounce\u4e2d\uff0c\u624b\u6a5f\u7248\u548c\u96fb\u8166\u7248\u7684\u904a\u6232\u9ad4\u9a57\u6709\u4ec0\u9ebc\u4e0d\u540c\uff1f", "answer": "Two Button Bounce\u7684\u624b\u6a5f\u7248\u548c\u96fb\u8166\u7248\u904a\u6232\u9ad4\u9a57\u7531\u65bc\u63a7\u5236\u65b9\u6848\u548c\u87a2\u5e55\u5c3a\u5bf8\u4e0d\u540c\u800c\u6709\u6240\u4e0d\u540c\u3002\u5728\u624b\u6a5f\u4e0a\uff0c\u89f8\u63a7\u63a7\u5236\u8207\u96fb\u8166\u4e0a\u7684\u5be6\u9ad4\u6309\u9375\u76f8\u6bd4\uff0c\u89f8\u611f\u53cd\u994b\u4e0d\u540c\u3002\u4f8b\u5982\uff0c\u5728\u624b\u6a5f\u4e0a\uff0c\u4f60\u53ef\u80fd\u9700\u8981\u4f7f\u7528\u6ed1\u52d5\u624b\u52e2\u9032\u884c\u8df3\u8e8d\u548c\u885d\u523a\uff0c\u800c\u5728\u96fb\u8166\u4e0a\uff0c\u5247\u4f7f\u7528\u9375\u76e4\u9375\u3002\u6b64\u5916\uff0c\u96fb\u8166\u66f4\u5927\u7684\u87a2\u5e55\u63d0\u4f9b\u4e86\u66f4\u8a73\u7d30\u7684\u74b0\u5883\u8996\u89d2\uff0c\u53ef\u80fd\u6703\u5f71\u97ff\u53cd\u61c9\u6642\u9593\u3002\u5169\u7a2e\u7248\u672c\u90fd\u6709\u5176\u7368\u7279\u7684\u512a\u52e2\uff0c\u56e0\u6b64\u6839\u64da\u4f60\u7684\u559c\u597d\u9078\u64c7\u3002"}, {"question": "Two Button Bounce\u7684\u8a08\u5206\u7cfb\u7d71\u5982\u4f55\u734e\u52f5\u4e0d\u540c\u7684\u904a\u6232\u98a8\u683c\uff1f", "answer": "Two Button Bounce\u7684\u8a08\u5206\u7cfb\u7d71\u900f\u904e\u70ba\u901f\u5ea6\u3001\u7cbe\u78ba\u6027\u548c\u6536\u96c6\u54c1\u63d0\u4f9b\u5206\u6578\uff0c\u734e\u52f5\u4e0d\u540c\u7684\u904a\u6232\u98a8\u683c\u3002\u4f8b\u5982\uff0c\u5feb\u901f\u5b8c\u6210\u4e00\u95dc\u6703\u7372\u5f97\u901f\u5ea6\u52a0\u5206\uff0c\u800c\u6536\u96c6\u6240\u6709\u7269\u54c1\u5247\u7372\u5f97\u7cbe\u78ba\u6027\u52a0\u5206\u3002\u6bd4\u8f03\u9019\u5169\u8005\uff0c\u5c08\u6ce8\u65bc\u901f\u5ea6\u7684\u73a9\u5bb6\u53ef\u80fd\u6703\u512a\u5148\u8003\u616e\u5feb\u901f\u79fb\u52d5\uff0c\u800c\u5c08\u6ce8\u65bc\u7cbe\u78ba\u6027\u7684\u73a9\u5bb6\u5247\u6703\u8ffd\u6c42\u5b8c\u7f8e\u904b\u884c\u3002\u904a\u6232\u7684\u8a08\u5206\u7cfb\u7d71\u9f13\u52f5\u5169\u7a2e\u65b9\u6cd5\uff0c\u8b93\u73a9\u5bb6\u53ef\u4ee5\u6839\u64da\u4ed6\u5011\u7684\u512a\u52e2\u8abf\u6574\u4ed6\u5011\u7684\u7b56\u7565\u3002"}, {"question": "\u6709\u54ea\u4e9b\u9032\u968e\u6280\u5de7\u53ef\u4ee5\u7528\u65bc\u5b8c\u6210Two Button Bounce\u4e2d\u6700\u96e3\u7684\u95dc\u5361\uff1f", "answer": "\u8981\u5b8c\u6210Two Button Bounce\u4e2d\u6700\u96e3\u7684\u95dc\u5361\uff0c\u9700\u8981\u9032\u968e\u6280\u5de7\uff0c\u4f8b\u5982\u6ce2\u6d6a\u885d\u523a\u548c\u908a\u7de3\u53d6\u6d88\u81f3\u95dc\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5728\u7b2c20\u95dc\uff0c\u6ce2\u6d6a\u885d\u523a\u5141\u8a31\u4f60\u5728\u72f9\u7a84\u7a7a\u9593\u4e2d\u4fdd\u6301\u52d5\u91cf\u3002\u6b65\u9a5f1\uff1a\u8df3\u8e8d\u4e26\u7acb\u5373\u885d\u523a\u3002\u6b65\u9a5f2\uff1a\u843d\u5730\u6642\uff0c\u5728\u4e0d\u55aa\u5931\u901f\u5ea6\u7684\u60c5\u6cc1\u4e0b\u518d\u6b21\u8df3\u8e8d\u3002\u6b65\u9a5f3\uff1a\u91cd\u8907\u6b64\u52d5\u4f5c\u9806\u5e8f\u4ee5\u6709\u6548\u5730\u7a7f\u904e\u95dc\u5361\u3002\u908a\u7de3\u53d6\u6d88\u5305\u62ec\u885d\u523a\u96e2\u958b\u5e73\u53f0\u4ee5\u53d6\u6d88\u885d\u523a\u52d5\u756b\uff0c\u5141\u8a31\u66f4\u5feb\u5730\u6062\u5fa9\u3002\u638c\u63e1\u9019\u4e9b\u6280\u5de7\u53ef\u4ee5\u986f\u8457\u6539\u5584\u4f60\u5728\u56f0\u96e3\u95dc\u5361\u4e2d\u7684\u8868\u73fe\u3002"}]
[{"question": "Two Button Bounce\u306e\u521d\u5fc3\u8005\u5411\u3051\u57fa\u672c\u64cd\u4f5c\u3092\u3069\u306e\u3088\u3046\u306b\u30de\u30b9\u30bf\u30fc\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Two Button Bounce\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u30012\u3064\u306e\u30dc\u30bf\u30f3\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u96c6\u4e2d\u3057\u307e\u3057\u3087\u3046\u3002\u30dc\u30bf\u30f3A\u3067\u30b8\u30e3\u30f3\u30d7\u3057\u3001\u30dc\u30bf\u30f3B\u3067\u30c0\u30c3\u30b7\u30e5\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u9593\u3092\u30b8\u30e3\u30f3\u30d7\u3057\u3066\u969c\u5bb3\u7269\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u30c0\u30c3\u30b7\u30e5\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b8\u30e3\u30f3\u30d7\u3068\u30c0\u30c3\u30b7\u30e5\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u30b2\u30fc\u30e0\u306e\u30ea\u30ba\u30e0\u306b\u5408\u308f\u305b\u3066\u7df4\u7fd2\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u5f79\u306b\u7acb\u3064\u30d2\u30f3\u30c8\u3068\u3057\u3066\u306f\u3001\u30dc\u30bf\u30f3\u3092\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u8db3\u3068\u8003\u3048\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u30dc\u30bf\u30f3A\u306f\u3042\u306a\u305f\u3092\u6301\u3061\u4e0a\u3052\u3001\u30dc\u30bf\u30f3B\u306f\u3042\u306a\u305f\u3092\u9032\u3081\u307e\u3059\u3002\u3053\u306e\u985e\u4f3c\u70b9\u306b\u3088\u308a\u3001\u64cd\u4f5c\u304c\u3088\u308a\u76f4\u611f\u7684\u306b\u306a\u308a\u307e\u3059\u3002"}, {"question": "Two Button Bounce\u3067100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u3069\u306e\u3088\u3046\u306b\u524d\u9032\u3059\u308b\u305f\u3081\u306e\u4e3b\u306a\u6226\u7565\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "100\u6642\u9593\u5f8c\u3001Two Button Bounce\u3067\u524d\u9032\u3059\u308b\u306b\u306f\u3001\u6b63\u78ba\u3055\u3068\u6226\u7565\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u8907\u96d1\u306a\u30b7\u30fc\u30b1\u30f3\u30b9\u3067\u30b8\u30e3\u30f3\u30d7\u3068\u30c0\u30c3\u30b7\u30e5\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5404\u30ec\u30d9\u30eb\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u5b66\u7fd2\u3057\u3066\u969c\u5bb3\u7269\u3092\u4e88\u6e2c\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30ec\u30d9\u30eb10\u306e\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u306a\u3069\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u52b9\u679c\u7684\u306b\u4f7f\u7528\u3057\u3066\u3001\u79fb\u52d5\u3059\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u30b7\u30ea\u30fc\u30ba\u3092\u56de\u907f\u3059\u308b\u3002\u3055\u307e\u3056\u307e\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u3092\u6bd4\u8f03\u3059\u308b\u3068\u3001\u4e00\u90e8\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30b9\u30d4\u30fc\u30c9\u306b\u7126\u70b9\u3092\u5f53\u3066\u3001\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u6b63\u78ba\u3055\u3092\u91cd\u8996\u3057\u307e\u3059\u3002\u6700\u9069\u306a\u6226\u7565\u3092\u898b\u3064\u3051\u308b\u305f\u3081\u306b\u5b9f\u9a13\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "Two Button Bounce\u306e\u30c0\u30c3\u30b7\u30e5\u30e1\u30ab\u30cb\u30ba\u30e0\u304c\u6642\u3005\u4e00\u8cab\u6027\u304c\u306a\u3044\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "Two Button Bounce\u306e\u30c0\u30c3\u30b7\u30e5\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u306e\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u304c\u539f\u56e0\u3067\u3001\u6642\u3005\u4e00\u8cab\u6027\u304c\u306a\u3044\u3088\u3046\u306b\u611f\u3058\u3089\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u9ad8\u3055\u304b\u3089\u30c0\u30c3\u30b7\u30e5\u3059\u308b\u3068\u304d\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u52e2\u3044\u306f\u3001\u30c0\u30c3\u30b7\u30e5\u306e\u89d2\u5ea6\u3068\u30bf\u30a4\u30df\u30f3\u30b0\u306b\u3088\u3063\u3066\u5909\u5316\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3067\u8aac\u660e\u3067\u304d\u307e\u3059\u3002\u30c0\u30c3\u30b7\u30e5\u5165\u529b\u2192\u89d2\u5ea6/\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u78ba\u8a8d\u2192\u52e2\u3044\u3092\u9069\u7528\u3059\u308b\u3002\u3053\u308c\u3092\u8efd\u6e1b\u3059\u308b\u306b\u306f\u3001\u4e00\u8cab\u3057\u305f\u7d50\u679c\u3092\u5f97\u308b\u305f\u3081\u306b\u30b8\u30e3\u30f3\u30d7\u306e\u9802\u70b9\u3067\u30c0\u30c3\u30b7\u30e5\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u5965\u884c\u304d\u3092\u8ffd\u52a0\u3057\u307e\u3059\u304c\u3001\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u7df4\u7fd2\u304c\u5fc5\u8981\u3067\u3059\u3002"}, {"question": "Two Button Bounce\u306e\u3069\u306e\u30b7\u30b9\u30c6\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u304c\u96e3\u6613\u5ea6\u30b9\u30b1\u30fc\u30ea\u30f3\u30b0\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "Two Button Bounce\u306e\u96e3\u6613\u5ea6\u30b9\u30b1\u30fc\u30ea\u30f3\u30b0\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u30b7\u30b9\u30c6\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u3088\u3063\u3066\u5f71\u97ff\u3055\u308c\u307e\u3059\u3002\u4e3b\u306a\u8981\u56e0\u306f\u3001\u30ec\u30d9\u30eb5\u3067\u79fb\u52d5\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u304c\u5c0e\u5165\u3055\u308c\u308b\u306a\u3069\u3001\u969c\u5bb3\u7269\u30d1\u30bf\u30fc\u30f3\u306e\u8907\u96d1\u3055\u306e\u4e0a\u6607\u3067\u3059\u3002\u3055\u3089\u306b\u3001\u30b2\u30fc\u30e0\u306f\u30b8\u30e3\u30f3\u30d7\u3068\u30c0\u30c3\u30b7\u30e5\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u30a6\u30a3\u30f3\u30c9\u30a6\u3092\u8abf\u6574\u3057\u3001\u9032\u3080\u306b\u3064\u308c\u3066\u72ed\u304f\u306a\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb15\u3067\u306f\u3001\u6210\u529f\u3057\u305f\u30c0\u30c3\u30b7\u30e5\u306e\u30a6\u30a3\u30f3\u30c9\u30a6\u306f0.2\u79d2\u77ed\u7e2e\u3055\u308c\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3068\u3001\u30b2\u30fc\u30e0\u306e\u8ab2\u984c\u3092\u4e88\u6e2c\u3057\u3001\u9069\u5fdc\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u8907\u6570\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067Two Button Bounce\u306e\u9032\u6357\u72b6\u6cc1\u3092\u3069\u306e\u3088\u3046\u306b\u79fb\u884c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u8907\u6570\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067Two Button Bounce\u306e\u9032\u6357\u72b6\u6cc1\u3092\u79fb\u884c\u3059\u308b\u306b\u306f\u3001\u30b2\u30fc\u30e0\u306e\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u307e\u305a\u3001\u4e21\u65b9\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001PC\u304b\u3089\u30b3\u30f3\u30bd\u30fc\u30eb\u306b\u79fb\u52d5\u3059\u308b\u5834\u5408\u3001\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u30b2\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6b21\u306b\u3001\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u306b\u30a2\u30af\u30bb\u30b9\u3057\u3066\u300c\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u300d\u3092\u9078\u629e\u3057\u3066\u30c7\u30fc\u30bf\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u65b0\u3057\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u3001\u4fdd\u5b58\u30d5\u30a1\u30a4\u30eb\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3066\u4e2d\u65ad\u3057\u305f\u3068\u3053\u308d\u304b\u3089\u518d\u958b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u306e\u30d7\u30ed\u30bb\u30b9\u306b\u3088\u308a\u3001\u9032\u6357\u72b6\u6cc1\u3092\u5931\u3046\u3053\u3068\u306a\u304f\u30b7\u30fc\u30e0\u30ec\u30b9\u306a\u79fb\u884c\u304c\u4fdd\u8a3c\u3055\u308c\u307e\u3059\u3002"}, {"question": "\u30e1\u30a4\u30f3\u30eb\u30fc\u30c8\u304b\u3089\u5916\u308c\u308b\u3053\u3068\u3067Two Button Bounce\u3067\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Two Button Bounce\u3067\u3001\u30e1\u30a4\u30f3\u30eb\u30fc\u30c8\u304b\u3089\u5916\u308c\u3066\u63a2\u7d22\u3059\u308b\u3068\u3001\u96a0\u3057\u30ec\u30d9\u30eb\u3084\u53ce\u96c6\u54c1\u306a\u3069\u306e\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb7\u3067\u306f\u3001\u4e00\u898b\u56fa\u3044\u58c1\u306b\u30c0\u30c3\u30b7\u30e5\u3059\u308b\u3053\u3068\u3067\u3001\u30a2\u30af\u30bb\u30b9\u53ef\u80fd\u306a\u96a0\u3057\u30a8\u30ea\u30a2\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u306e\u30a8\u30ea\u30a2\u306b\u306f\u3001\u30dc\u30fc\u30ca\u30b9\u30ec\u30d9\u30eb\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u7a00\u306a\u53ce\u96c6\u54c1\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u3053\u306e\u30b2\u30fc\u30e0\u306f\u597d\u5947\u5fc3\u3068\u5fb9\u5e95\u7684\u306a\u63a2\u7d22\u3092\u5831\u3044\u307e\u3059\u3002\u305d\u306e\u305f\u3081\u3001\u96a0\u3055\u308c\u305f\u30d1\u30b9\u3092\u793a\u5506\u3059\u308b\u3088\u3046\u306a\u73cd\u3057\u3044\u74b0\u5883\u306e\u5146\u5019\u3092\u63a2\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "Two Button Bounce\u3067\u6700\u5927\u52b9\u7387\u3092\u5f97\u308b\u305f\u3081\u306b\u3001\u30dc\u30bf\u30f3\u5165\u529b\u306f\u3069\u3046\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Two Button Bounce\u3067\u306e\u30dc\u30bf\u30f3\u5165\u529b\u306e\u6700\u9069\u5316\u306f\u3001\u52b9\u7387\u7684\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u30ea\u30ba\u30e0\u306e\u7df4\u7fd2\u3092\u4f34\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb12\u3067\u306f\u3001\u8907\u6570\u306e\u30b8\u30e3\u30f3\u30d7\u3068\u30c0\u30c3\u30b7\u30e5\u3092\u9023\u9396\u3055\u305b\u3066\u3001\u8907\u6570\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u8fc5\u901f\u306b\u79fb\u52d5\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30dc\u30bf\u30f3A\u3092\u62bc\u3057\u3066\u30b8\u30e3\u30f3\u30d7\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b8\u30e3\u30f3\u30d7\u306e\u9802\u70b9\u3067\u3001\u30dc\u30bf\u30f3B\u3092\u62bc\u3057\u3066\u30c0\u30c3\u30b7\u30e5\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30c0\u30c3\u30b7\u30e5\u76f4\u5f8c\u306b\u3001\u30dc\u30bf\u30f3A\u3092\u3082\u3046\u4e00\u5ea6\u62bc\u3057\u3066\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u7d9a\u3051\u308b\u3002\u3053\u306e\u9023\u9396\u6280\u6cd5\u306b\u3088\u308a\u3001\u5165\u529b\u30e9\u30b0\u304c\u6e1b\u5c11\u3057\u3001\u79fb\u52d5\u52b9\u7387\u304c\u6700\u5927\u5316\u3055\u308c\u307e\u3059\u3002\u3053\u306e\u30ea\u30ba\u30e0\u3092\u7df4\u7fd2\u3057\u3066\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5411\u4e0a\u3055\u305b\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30e2\u30d0\u30a4\u30eb\u7248\u3068PC\u7248\u306eTwo Button Bounce\u306e\u30b2\u30fc\u30e0\u4f53\u9a13\u306e\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Two Button Bounce\u306e\u30b2\u30fc\u30e0\u4f53\u9a13\u306f\u3001\u5236\u5fa1\u65b9\u5f0f\u3068\u753b\u9762\u30b5\u30a4\u30ba\u304c\u539f\u56e0\u3067\u30e2\u30d0\u30a4\u30eb\u3068PC\u306e\u9593\u3067\u7570\u306a\u308a\u307e\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u3067\u306f\u3001\u30bf\u30c3\u30c1\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u306fPC\u306e\u7269\u7406\u30dc\u30bf\u30f3\u3068\u6bd4\u3079\u3066\u7570\u306a\u308b\u89e6\u899a\u30d5\u30a3\u30fc\u30c9\u30d0\u30c3\u30af\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30e2\u30d0\u30a4\u30eb\u3067\u306f\u3001\u30b8\u30e3\u30f3\u30d7\u3084\u30c0\u30c3\u30b7\u30e5\u306b\u30b9\u30ef\u30a4\u30d7\u30b8\u30a7\u30b9\u30c1\u30e3\u30fc\u3092\u4f7f\u7528\u3059\u308b\u306e\u306b\u5bfe\u3057\u3001PC\u3067\u306f\u30ad\u30fc\u30dc\u30fc\u30c9\u30ad\u30fc\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001PC\u306e\u5927\u304d\u306a\u753b\u9762\u306b\u3088\u308a\u3001\u74b0\u5883\u306e\u3088\u308a\u8a73\u7d30\u306a\u30d3\u30e5\u30fc\u304c\u63d0\u4f9b\u3055\u308c\u3001\u53cd\u5fdc\u6642\u9593\u306a\u3069\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u4e21\u65b9\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u306b\u306f\u56fa\u6709\u306e\u5229\u70b9\u304c\u3042\u308b\u306e\u3067\u3001\u81ea\u5206\u306e\u597d\u307f\u306b\u57fa\u3065\u3044\u3066\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "Two Button Bounce\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u3092\u3069\u306e\u3088\u3046\u306b\u5831\u3044\u307e\u3059\u304b\uff1f", "answer": "Two Button Bounce\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b9\u30d4\u30fc\u30c9\u3001\u6b63\u78ba\u6027\u3001\u53ce\u96c6\u54c1\u306b\u5bfe\u3059\u308b\u30dd\u30a4\u30f3\u30c8\u3092\u63d0\u4f9b\u3059\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u3001\u3055\u307e\u3056\u307e\u306a\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u3092\u5831\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb\u3092\u8fc5\u901f\u306b\u30af\u30ea\u30a2\u3059\u308b\u3068\u30b9\u30d4\u30fc\u30c9\u30dc\u30fc\u30ca\u30b9\u304c\u4e0e\u3048\u3089\u308c\u3001\u3059\u3079\u3066\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u96c6\u3081\u308b\u3068\u6b63\u78ba\u6027\u30dc\u30fc\u30ca\u30b9\u304c\u4e0e\u3048\u3089\u308c\u307e\u3059\u3002\u4e21\u65b9\u3092\u6bd4\u8f03\u3059\u308b\u3068\u3001\u30b9\u30d4\u30fc\u30c9\u91cd\u8996\u306e\u30d7\u30ec\u30fc\u30e4\u30fc\u306f\u8fc5\u901f\u306a\u79fb\u52d5\u3092\u512a\u5148\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u3001\u6b63\u78ba\u3055\u91cd\u8996\u306e\u30d7\u30ec\u30fc\u30e4\u30fc\u306f\u5b8c\u74a7\u306a\u30e9\u30f3\u306b\u6311\u6226\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u4e21\u65b9\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u3092\u5968\u52b1\u3057\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u81ea\u5206\u306e\u5f37\u307f\u306b\u5408\u308f\u305b\u3066\u6226\u7565\u3092\u8abf\u6574\u3067\u304d\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002"}, {"question": "Two Button Bounce\u3067\u6700\u3082\u96e3\u3057\u3044\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u305f\u3081\u306b\u4f7f\u7528\u3067\u304d\u308b\u9ad8\u5ea6\u306a\u30c6\u30af\u30cb\u30c3\u30af\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Two Button Bounce\u3067\u6700\u3082\u96e3\u3057\u3044\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u306b\u306f\u3001\u6ce2\u72b6\u30c0\u30c3\u30b7\u30e5\u3084\u30a8\u30c3\u30b8\u30ad\u30e3\u30f3\u30bb\u30eb\u306a\u3069\u306e\u9ad8\u5ea6\u306a\u30c6\u30af\u30cb\u30c3\u30af\u304c\u5fc5\u8981\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb20\u3067\u306f\u3001\u6ce2\u72b6\u30c0\u30c3\u30b7\u30e5\u306b\u3088\u308a\u3001\u72ed\u3044\u5834\u6240\u3067\u52e2\u3044\u3092\u7dad\u6301\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b8\u30e3\u30f3\u30d7\u3057\u3066\u3059\u3050\u306b\u30c0\u30c3\u30b7\u30e5\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u7740\u5730\u3057\u305f\u3068\u304d\u306b\u3001\u52e2\u3044\u3092\u5931\u3046\u3053\u3068\u306a\u304f\u518d\u3073\u30b8\u30e3\u30f3\u30d7\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u3053\u306e\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u7e70\u308a\u8fd4\u3057\u3066\u3001\u30ec\u30d9\u30eb\u3092\u52b9\u7387\u7684\u306b\u79fb\u52d5\u3057\u307e\u3059\u3002\u30a8\u30c3\u30b8\u30ad\u30e3\u30f3\u30bb\u30eb\u306f\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u304b\u3089\u30c0\u30c3\u30b7\u30e5\u3057\u3066\u30c0\u30c3\u30b7\u30e5\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3\u3092\u30ad\u30e3\u30f3\u30bb\u30eb\u3059\u308b\u3053\u3068\u306b\u3088\u308a\u3001\u3088\u308a\u8fc5\u901f\u306a\u56de\u5fa9\u3092\u53ef\u80fd\u306b\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30c6\u30af\u30cb\u30c3\u30af\u3092\u7fd2\u5f97\u3059\u308b\u3053\u3068\u3067\u3001\u96e3\u3057\u3044\u30ec\u30d9\u30eb\u3067\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002"}]
[{"question": "\u5982\u4f55\u8b93\u65b0\u73a9\u5bb6\u5feb\u901f\u638c\u63e1Bad Time Simulator\u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1Bad Time Simulator\u7684\u57fa\u672c\u63a7\u5236\uff0c\u8acb\u6309\u7167\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u719f\u6089\u79fb\u52d5\u9375 (WASD) \u548c\u653b\u64ca\u9375 (\u7a7a\u683c\u9375)\u3002\u6b65\u9a5f2\uff1a\u7df4\u7fd2\u4ee5\u4e4b\u5b57\u5f62\u6a21\u5f0f\u8eb2\u907f\u6575\u4eba\u7684\u653b\u64ca\u3002\u6b65\u9a5f3\uff1a\u4f7f\u7528\u300c\u9748\u9b42\u6a21\u5f0f\u300d\u8207NPC\u4e92\u52d5\u4e26\u63a8\u9032\u5287\u60c5\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u6b21\u9047\u5230Sans\u6642\uff0c\u4f7f\u7528\u300c\u9748\u9b42\u6a21\u5f0f\u300d\u8eb2\u907f\u4ed6\u7684\u653b\u64ca\u4e26\u53cd\u64ca\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u63a7\u5236\u8996\u70ba\u4e00\u5834\u821e\uff0c\u7bc0\u594f\u548c\u6642\u6a5f\u81f3\u95dc\u91cd\u8981\u3002]"}, {"question": "\u5728Bad Time Simulator\u4e2d\u64ca\u6557Sans\u7684\u95dc\u9375\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u64ca\u6557Sans\u9700\u8981\u7cbe\u78ba\u7684\u6642\u6a5f\u548c\u7b56\u7565\u898f\u5283\u3002\u6b65\u9a5f1\uff1a\u8a18\u4f4f\u4ed6\u7684\u653b\u64ca\u6a21\u5f0f\uff1b\u4f8b\u5982\uff0c\u4ed6\u7684\u9aa8\u982d\u653b\u64ca\u9075\u5faa\u7279\u5b9a\u7684\u7bc0\u594f\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u300c\u9748\u9b42\u6a21\u5f0f\u300d\u6709\u6548\u5730\u8eb2\u907f\u4ed6\u7684\u653b\u64ca\u3002\u6b65\u9a5f3\uff1a\u5728\u4ed6\u77ed\u66ab\u7684\u8106\u5f31\u6642\u523b\u53cd\u64ca\u3002\u4f8b\u5982\uff0c\u7576\u4ed6\u5728\u9023\u7e8c\u9aa8\u982d\u653b\u64ca\u5f8c\u66ab\u505c\u6642\uff0c\u4f7f\u7528\u4f60\u7684\u653b\u64ca\u9375\u9020\u6210\u50b7\u5bb3\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u5c07Sans\u7684\u653b\u64ca\u6a21\u5f0f\u8207\u7bc0\u62cd\u5668\u9032\u884c\u6bd4\u8f03\uff0c\u5176\u4e2d\u6bcf\u500b\u62cd\u5b50\u90fd\u4ee3\u8868\u4e00\u500b\u8eb2\u907f\u7684\u6a5f\u6703\u3002]"}, {"question": "\u5728Bad Time Simulator\u4e2d\uff0c\u6211\u61c9\u8a72\u8abf\u6574\u54ea\u4e9b\u8a2d\u5b9a\u4ee5\u512a\u5316\u6548\u80fd\uff1f", "answer": "\u8981\u512a\u5316\u6548\u80fd\uff0c\u8acb\u8abf\u6574\u4ee5\u4e0b\u8a2d\u5b9a\uff1a\u6b65\u9a5f1\uff1a\u5982\u679c\u9047\u5230\u5ef6\u9072\uff0c\u8acb\u964d\u4f4e\u89e3\u6790\u5ea6\u5230720p\u3002\u6b65\u9a5f2\uff1a\u95dc\u9589\u4e0d\u5fc5\u8981\u7684\u80cc\u666f\u61c9\u7528\u7a0b\u5f0f\u4ee5\u91cb\u653e\u7cfb\u7d71\u8cc7\u6e90\u3002\u6b65\u9a5f3\uff1a\u5728\u904a\u6232\u8a2d\u5b9a\u4e2d\u555f\u7528\u300c\u5feb\u901f\u6a21\u5f0f\u300d\u4ee5\u7e2e\u77ed\u8f09\u5165\u6642\u9593\u3002\u4f8b\u5982\uff0c\u4f4e\u968e\u96fb\u8166\u4f7f\u7528\u8005\u767c\u73fe\u964d\u4f4e\u89e3\u6790\u5ea6\u986f\u8457\u6539\u5584\u4e86\u756b\u9762\u5e40\u901f\u7387\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u5275\u5efa\u4e00\u500b\u6d41\u7a0b\u5716\uff0c\u986f\u793a\u5b58\u53d6\u548c\u8abf\u6574\u9019\u4e9b\u8a2d\u5b9a\u7684\u6b65\u9a5f\u3002]"}, {"question": "\u70ba\u4ec0\u9ebcBad Time Simulator\u7684\u6700\u7d42\u6230\u9b25\u96e3\u5ea6\u6703\u986f\u8457\u63d0\u5347\uff1f", "answer": "\u6700\u7d42\u6230\u9b25\u96e3\u5ea6\u986f\u8457\u63d0\u5347\uff0c\u65e8\u5728\u8003\u9a57\u4f60\u6240\u7fd2\u5f97\u7684\u6240\u6709\u6280\u80fd\u3002\u6700\u7d42BOSS Sans\u64c1\u6709\u8907\u96dc\u7684\u653b\u64ca\u6a21\u5f0f\uff0c\u9700\u8981\u7cbe\u78ba\u7684\u6642\u6a5f\u548c\u5feb\u901f\u7684\u53cd\u61c9\u3002\u4f8b\u5982\uff0c\u4ed6\u7684\u300cGaster Blaster\u300d\u653b\u64ca\u6bd4\u4e4b\u524d\u7684\u653b\u64ca\u66f4\u5feb\u3001\u66f4\u96e3\u4ee5\u9810\u6e2c\u3002\u9019\u7a2e\u63d0\u5347\u78ba\u4fdd\u53ea\u6709\u6700\u719f\u7df4\u7684\u73a9\u5bb6\u624d\u80fd\u5b8c\u6210\u904a\u6232\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u5c07\u6700\u7d42\u6230\u9b25\u7684\u96e3\u5ea6\u8207\u4e4b\u524d\u7684\u6230\u9b25\u9032\u884c\u6bd4\u8f03\uff0c\u5f37\u8abf\u8907\u96dc\u6027\u7684\u589e\u52a0\u3002]"}, {"question": "\u5982\u4f55\u5728Bad Time Simulator\u4e2d\u5c07\u6211\u7684\u96fb\u8166\u5132\u5b58\u8cc7\u6599\u8f49\u79fb\u5230\u624b\u6a5f\uff1f", "answer": "\u8f49\u79fb\u5132\u5b58\u8cc7\u6599\u5305\u542b\u5e7e\u500b\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u5728\u60a8\u7684\u96fb\u8166\u4e0a\u627e\u5230\u5132\u5b58\u6a94\u6848\uff0c\u901a\u5e38\u4f4d\u65bc\u904a\u6232\u5b89\u88dd\u76ee\u9304\u4e2d\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u670d\u52d9\uff0c\u4f8b\u5982Google\u96f2\u7aef\u786c\u789f\uff0c\u4e0a\u50b3\u5132\u5b58\u6a94\u6848\u3002\u6b65\u9a5f3\uff1a\u5728\u60a8\u7684\u624b\u6a5f\u4e0a\u4e0b\u8f09\u6a94\u6848\u4e26\u5c07\u5176\u653e\u7f6e\u5728\u76f8\u61c9\u7684\u76ee\u9304\u4e2d\u3002\u4f8b\u5982\uff0c\u73a9\u5bb6\u5df2\u6210\u529f\u4f7f\u7528\u6b64\u65b9\u6cd5\u5728\u884c\u52d5\u88dd\u7f6e\u4e0a\u7e7c\u7e8c\u4ed6\u5011\u7684\u9032\u5ea6\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u63d0\u4f9b\u4e00\u500b\u8868\u683c\uff0c\u986f\u793a\u96fb\u8166\u548c\u624b\u6a5f\u7684\u6a94\u6848\u8def\u5f91\u3002]"}, {"question": "Bad Time Simulator\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u6a5f\u5236\u5927\u90e8\u5206\u73a9\u5bb6\u5ffd\u7565\u4e86\uff1f", "answer": "\u4e00\u500b\u96b1\u85cf\u6a5f\u5236\u662f\u300c\u4ec1\u6148\u300d\u9078\u9805\uff0c\u5141\u8a31\u4f60\u9952\u6055\u6575\u4eba\u800c\u4e0d\u662f\u8207\u4ed6\u5011\u6230\u9b25\u3002\u4f8b\u5982\uff0c\u9952\u6055Toriel\u800c\u4e0d\u662f\u653b\u64ca\u5979\u6703\u6539\u8b8a\u904a\u6232\u7684\u6558\u4e8b\u3002\u53e6\u4e00\u500b\u88ab\u5ffd\u7565\u7684\u6a5f\u5236\u662f\u300c\u884c\u52d5\u300d\u9078\u55ae\uff0c\u53ef\u7528\u65bc\u6536\u96c6\u8cc7\u8a0a\u6216\u5b89\u64ab\u6575\u4eba\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u9019\u4e9b\u6a5f\u5236\u8996\u70ba\u901a\u5f80\u4e0d\u540c\u7d50\u5c40\u7684\u79d8\u5bc6\u9053\u8def\u3002]"}, {"question": "\u300c\u9748\u9b42\u6a21\u5f0f\u300d\u6a5f\u5236\u5728Bad Time Simulator\u4e2d\u5982\u4f55\u904b\u4f5c\uff1f", "answer": "\u300c\u9748\u9b42\u6a21\u5f0f\u300d\u6a5f\u5236\u5141\u8a31\u4f60\u63a7\u5236\u4ee3\u8868\u4f60\u9748\u9b42\u7684\u5c0f\u5fc3\u81df\u3002\u5728\u6b64\u6a21\u5f0f\u4e0b\uff0c\u4f60\u53ef\u4ee5\u8eb2\u907f\u6575\u4eba\u7684\u653b\u64ca\u4e26\u8207NPC\u4e92\u52d5\u3002\u4f8b\u5982\uff0c\u5728\u6230\u9b25\u904e\u7a0b\u4e2d\uff0c\u79fb\u52d5\u5fc3\u81df\u4ee5\u907f\u514d\u653b\u64ca\u5c0d\u65bc\u751f\u5b58\u81f3\u95dc\u91cd\u8981\u3002\u8a72\u6a21\u5f0f\u9084\u5141\u8a31\u4f60\u57f7\u884c\u7279\u6b8a\u52d5\u4f5c\uff0c\u4f8b\u5982\u9952\u6055\u6575\u4eba\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u5275\u5efa\u4e00\u500b\u6d41\u7a0b\u5716\uff0c\u986f\u793a\u6fc0\u6d3b\u548c\u4f7f\u7528\u300c\u9748\u9b42\u6a21\u5f0f\u300d\u7684\u6b65\u9a5f\u3002]"}, {"question": "\u5728Bad Time Simulator\u4e2d\u7ba1\u7406\u8cc7\u6e90\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u6709\u6548\u7684\u8cc7\u6e90\u7ba1\u7406\u5305\u62ec\uff1a\u6b65\u9a5f1\uff1a\u59cb\u7d42\u5c07\u300c\u5976\u6cb9\u5e03\u4e01\u300d\u7b49\u6cbb\u7642\u7269\u54c1\u4fdd\u7559\u5728\u60a8\u7684\u7269\u54c1\u6b04\u4e2d\u3002\u6b65\u9a5f2\uff1a\u50c5\u5728\u5fc5\u8981\u6642\uff0c\u4f8b\u5982\u5728BOSS\u6230\u4e2d\u624d\u7bc0\u7701\u4f7f\u7528\u7269\u54c1\u3002\u6b65\u9a5f3\uff1a\u5fb9\u5e95\u63a2\u7d22\u6bcf\u500b\u5340\u57df\u4ee5\u5c0b\u627e\u96b1\u85cf\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5728\u5ee2\u589f\u4e2d\uff0c\u641c\u5c0b\u6bcf\u500b\u89d2\u843d\u53ef\u4ee5\u7372\u5f97\u5bf6\u8cb4\u7684\u8cc7\u6e90\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u6bd4\u8f03\u4e0d\u540c\u7684\u7269\u54c1\u4f7f\u7528\u7b56\u7565\uff0c\u7a81\u51fa\u6700\u6709\u6548\u7387\u7684\u7b56\u7565\u3002]"}, {"question": "Bad Time Simulator\u4e2d\u54ea\u4e9b\u89d2\u8272\u64c1\u6709\u6700\u8907\u96dc\u7684\u653b\u64ca\u6a21\u5f0f\uff1f", "answer": "Sans\u548cUndyne\u64c1\u6709\u6700\u8907\u96dc\u7684\u653b\u64ca\u6a21\u5f0f\u3002Sans\u7684\u653b\u64ca\u5feb\u901f\u4e14\u96e3\u4ee5\u9810\u6e2c\uff0c\u9700\u8981\u7cbe\u78ba\u7684\u6642\u6a5f\u624d\u80fd\u8eb2\u907f\u3002Undyne\u7684\u77db\u653b\u64ca\u5177\u6709\u5404\u7a2e\u6a21\u5f0f\uff0c\u4f7f\u5176\u96e3\u4ee5\u9810\u6599\u3002\u4f8b\u5982\uff0cSans\u7684\u300cGaster Blaster\u300d\u653b\u64ca\u662f\u4e00\u7cfb\u5217\u5feb\u901f\u5c04\u51fa\u7684\u5149\u675f\uff0c\u5fc5\u9808\u5feb\u901f\u9023\u7e8c\u8eb2\u907f\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u4ed6\u5011\u7684\u653b\u64ca\u6a21\u5f0f\u8996\u70ba\u4e00\u5834\u9700\u8981\u5b8c\u7f8e\u7bc0\u594f\u7684\u8907\u96dc\u821e\u8e48\u3002]"}, {"question": "\u5982\u4f55\u5728Bad Time Simulator\u4e2d\u767c\u73fe\u79d8\u5bc6\u7d50\u5c40\uff1f", "answer": "\u8981\u767c\u73fe\u79d8\u5bc6\u7d50\u5c40\uff0c\u8acb\u6309\u7167\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u9078\u64c7\u300c\u548c\u5e73\u4e3b\u7fa9\u300d\u8def\u7dda\uff0c\u9952\u6055\u6240\u6709\u6575\u4eba\u3002\u6b65\u9a5f2\uff1a\u8207NPC\u591a\u6b21\u4e92\u52d5\u4ee5\u5efa\u7acb\u95dc\u4fc2\u3002\u6b65\u9a5f3\uff1a\u5b8c\u6210\u6240\u6709\u652f\u7dda\u4efb\u52d9\u4e26\u63a2\u7d22\u96b1\u85cf\u5340\u57df\u3002\u4f8b\u5982\uff0c\u9952\u6055Toriel\u4e26\u8207Papyrus\u6210\u70ba\u670b\u53cb\u53ef\u4ee5\u89e3\u9396\u7368\u7279\u7684\u7d50\u5c40\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u5275\u5efa\u4e00\u500b\u6d41\u7a0b\u5716\uff0c\u986f\u793a\u5be6\u73fe\u6bcf\u500b\u79d8\u5bc6\u7d50\u5c40\u7684\u6b65\u9a5f\u3002]"}]
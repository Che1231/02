[{"question": "\u30d0\u30c3\u30c9\u30bf\u30a4\u30e0\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc\u306e\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u8fc5\u901f\u306b\u7fd2\u5f97\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d0\u30c3\u30c9\u30bf\u30a4\u30e0\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u7d20\u65e9\u304f\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u79fb\u52d5\u30ad\u30fc\uff08WASD\uff09\u3068\u653b\u6483\u30ad\u30fc\uff08\u30b9\u30da\u30fc\u30b9\u30d0\u30fc\uff09\u306b\u6163\u308c\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6575\u306e\u653b\u6483\u3092\u304b\u308f\u3059\u7df4\u7fd2\u3092\u3001\u30b8\u30b0\u30b6\u30b0\u306e\u52d5\u304d\u3067\u5b9f\u8df5\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1aNPC\u3068\u5bfe\u8a71\u3057\u3001\u30b9\u30c8\u30fc\u30ea\u30fc\u3092\u9032\u3081\u308b\u305f\u3081\u306b\u300c\u30bd\u30a6\u30eb\u30e2\u30fc\u30c9\u300d\u3092\u4f7f\u3046\u3002\u4f8b\u3048\u3070\u3001\u6700\u521d\u306e\u30b5\u30f3\u30c9\u3068\u306e\u906d\u9047\u3067\u306f\u3001\u300c\u30bd\u30a6\u30eb\u30e2\u30fc\u30c9\u300d\u3092\u4f7f\u3063\u3066\u5f7c\u306e\u653b\u6483\u3092\u304b\u308f\u3057\u3001\u53cd\u6483\u3059\u308b\u3002[\u4f8b\u3048\uff1a\u64cd\u4f5c\u3092\u30ea\u30ba\u30e0\u3068\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u306a\u30c0\u30f3\u30b9\u3068\u8003\u3048\u308b\u3088\u3046\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30d0\u30c3\u30c9\u30bf\u30a4\u30e0\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc\u3067\u30b5\u30f3\u30c9\u306b\u52dd\u5229\u3059\u308b\u305f\u3081\u306e\u4e3b\u8981\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b5\u30f3\u30c9\u306b\u52dd\u5229\u3059\u308b\u306b\u306f\u3001\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u6226\u7565\u7684\u306a\u8a08\u753b\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5f7c\u306e\u653b\u6483\u30d1\u30bf\u30fc\u30f3\u3092\u6697\u8a18\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u5f7c\u306e\u9aa8\u306e\u653b\u6483\u306f\u7279\u5b9a\u306e\u30ea\u30ba\u30e0\u306b\u5f93\u3046\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5f7c\u306e\u653b\u6483\u3092\u52b9\u679c\u7684\u306b\u304b\u308f\u3059\u305f\u3081\u306b\u300c\u30bd\u30a6\u30eb\u30e2\u30fc\u30c9\u300d\u3092\u4f7f\u3046\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u9699\u9593\u306b\u53cd\u6483\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u4e00\u9023\u306e\u9aa8\u653b\u6483\u306e\u5f8c\u3001\u4e00\u6642\u505c\u6b62\u3057\u305f\u3068\u304d\u306b\u3001\u653b\u6483\u30ad\u30fc\u3092\u4f7f\u3063\u3066\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u3002[\u5bfe\u5fdc\u8868\uff1a\u30b5\u30f3\u30c9\u306e\u653b\u6483\u30d1\u30bf\u30fc\u30f3\u3092\u30e1\u30c8\u30ed\u30ce\u30fc\u30e0\u306b\u4f8b\u3048\u3001\u5404\u62cd\u5b50\u304c\u56de\u907f\u306e\u6a5f\u4f1a\u3092\u8868\u3057\u3066\u3044\u308b\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30d0\u30c3\u30c9\u30bf\u30a4\u30e0\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u305f\u3081\u306b\u3001\u3069\u306e\u8a2d\u5b9a\u3092\u8abf\u6574\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u6b21\u306e\u8a2d\u5b9a\u3092\u8abf\u6574\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30e9\u30b0\u304c\u767a\u751f\u3059\u308b\u5834\u5408\u306f\u3001\u89e3\u50cf\u5ea6\u3092720p\u306b\u4e0b\u3052\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u4e0d\u8981\u306a\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u30a2\u30d7\u30ea\u30b1\u30fc\u30b7\u30e7\u30f3\u3092\u7121\u52b9\u306b\u3057\u3066\u3001\u30b7\u30b9\u30c6\u30e0\u30ea\u30bd\u30fc\u30b9\u3092\u89e3\u653e\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b2\u30fc\u30e0\u8a2d\u5b9a\u3067\u300c\u9ad8\u901f\u30e2\u30fc\u30c9\u300d\u3092\u6709\u52b9\u306b\u3057\u3066\u3001\u30ed\u30fc\u30c9\u6642\u9593\u3092\u77ed\u7e2e\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u4f4e\u30b9\u30da\u30c3\u30af\u306ePC\u30e6\u30fc\u30b6\u30fc\u306f\u89e3\u50cf\u5ea6\u306e\u4f4e\u4e0b\u304c\u30d5\u30ec\u30fc\u30e0\u30ec\u30fc\u30c8\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u3092\u767a\u898b\u3057\u307e\u3057\u305f\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u3053\u308c\u3089\u306e\u8a2d\u5b9a\u3078\u306e\u30a2\u30af\u30bb\u30b9\u3068\u8abf\u6574\u624b\u9806\u3092\u793a\u3059\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u4f5c\u6210\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30d0\u30c3\u30c9\u30bf\u30a4\u30e0\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc\u306e\u6700\u7d42\u6c7a\u6226\u3067\u96e3\u6613\u5ea6\u304c\u5927\u304d\u304f\u4e0a\u6607\u3059\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u6700\u7d42\u6c7a\u6226\u3067\u96e3\u6613\u5ea6\u306f\u4e0a\u6607\u3057\u3001\u7372\u5f97\u3057\u305f\u3059\u3079\u3066\u306e\u30b9\u30ad\u30eb\u3092\u8a66\u3059\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u6700\u7d42\u30dc\u30b9\u3001\u30b5\u30f3\u30c9\u306f\u3001\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u7d20\u65e9\u3044\u53cd\u5fdc\u3092\u5fc5\u8981\u3068\u3059\u308b\u8907\u96d1\u306a\u653b\u6483\u30d1\u30bf\u30fc\u30f3\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5f7c\u306e\u300c\u30ac\u30b9\u30bf\u30fc\u30d6\u30e9\u30b9\u30bf\u30fc\u300d\u653b\u6483\u306f\u3001\u4ee5\u524d\u306e\u653b\u6483\u3088\u308a\u3082\u901f\u304f\u3001\u4e88\u6e2c\u4e0d\u80fd\u3067\u3059\u3002\u3053\u306e\u4e0a\u6607\u306f\u3001\u6700\u3082\u719f\u7df4\u3057\u305f\u30d7\u30ec\u30a4\u30e4\u30fc\u3060\u3051\u304c\u30b2\u30fc\u30e0\u3092\u30af\u30ea\u30a2\u3067\u304d\u308b\u3053\u3068\u3092\u4fdd\u8a3c\u3057\u3066\u3044\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u6700\u7d42\u6c7a\u6226\u306e\u96e3\u6613\u5ea6\u3092\u3001\u4ee5\u524d\u306e\u6c7a\u6226\u3068\u6bd4\u8f03\u3057\u3001\u8907\u96d1\u3055\u306e\u5897\u52a0\u3092\u5f37\u8abf\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30d0\u30c3\u30c9\u30bf\u30a4\u30e0\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc\u3067PC\u7248\u306e\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u3092\u30e2\u30d0\u30a4\u30eb\u7248\u306b\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u306e\u8ee2\u9001\u624b\u9806\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1aPC\u4e0a\u306e\u30bb\u30fc\u30d6\u30d5\u30a1\u30a4\u30eb\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002\u901a\u5e38\u306f\u30b2\u30fc\u30e0\u306e\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u306b\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1aGoogle\u30c9\u30e9\u30a4\u30d6\u306a\u3069\u306e\u30af\u30e9\u30a6\u30c9\u30b9\u30c8\u30ec\u30fc\u30b8\u30b5\u30fc\u30d3\u30b9\u3092\u4f7f\u7528\u3057\u3066\u3001\u30bb\u30fc\u30d6\u30d5\u30a1\u30a4\u30eb\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u306b\u30d5\u30a1\u30a4\u30eb\u3092\u63a2\u3057\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3066\u3001\u5bfe\u5fdc\u3059\u308b\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u306b\u914d\u7f6e\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u3053\u306e\u65b9\u6cd5\u3092\u4f7f\u3048\u3070\u3001\u5916\u51fa\u5148\u3067\u3082\u9032\u6357\u72b6\u6cc1\u3092\u7d9a\u3051\u3089\u308c\u307e\u3059\u3002[\u5bfe\u5fdc\u8868\uff1aPC\u7248\u3068\u30e2\u30d0\u30a4\u30eb\u7248\u306e\u30d5\u30a1\u30a4\u30eb\u30d1\u30b9\u3092\u793a\u3059\u8868\u3092\u4f5c\u6210\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30d0\u30c3\u30c9\u30bf\u30a4\u30e0\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc\u3067\u3001\u591a\u304f\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u898b\u843d\u3068\u3059\u96a0\u3055\u308c\u305f\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "1\u3064\u306e\u96a0\u3055\u308c\u305f\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u300c\u6148\u60b2\u300d\u30aa\u30d7\u30b7\u30e7\u30f3\u3067\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u6575\u3068\u6226\u3046\u4ee3\u308f\u308a\u306b\u3001\u6575\u3092\u8a31\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30c8\u30ea\u30a2\u3092\u653b\u6483\u3059\u308b\u306e\u3067\u306f\u306a\u304f\u8a31\u3059\u3068\u3001\u30b2\u30fc\u30e0\u306e\u30b9\u30c8\u30fc\u30ea\u30fc\u304c\u5909\u308f\u308a\u307e\u3059\u3002\u3082\u30461\u3064\u306e\u898b\u904e\u3054\u3055\u308c\u3066\u3044\u308b\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u300c\u884c\u70ba\u300d\u30e1\u30cb\u30e5\u30fc\u3067\u3059\u3002\u3053\u308c\u306f\u3001\u60c5\u5831\u3092\u53ce\u96c6\u3057\u305f\u308a\u3001\u6575\u3092\u306a\u3060\u3081\u305f\u308a\u3059\u308b\u305f\u3081\u306b\u4f7f\u7528\u3067\u304d\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u3053\u308c\u3089\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u3001\u3055\u307e\u3056\u307e\u306a\u30a8\u30f3\u30c7\u30a3\u30f3\u30b0\u306b\u3064\u306a\u304c\u308b\u79d8\u5bc6\u306e\u901a\u8def\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30d0\u30c3\u30c9\u30bf\u30a4\u30e0\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc\u306b\u304a\u3051\u308b\u300c\u30bd\u30a6\u30eb\u30e2\u30fc\u30c9\u300d\u30e1\u30ab\u30cb\u30ba\u30e0\u306e\u4ed5\u7d44\u307f\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u300c\u30bd\u30a6\u30eb\u30e2\u30fc\u30c9\u300d\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u9b42\u3092\u8868\u3059\u5c0f\u3055\u306a\u5fc3\u81d3\u3092\u5236\u5fa1\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u30e2\u30fc\u30c9\u3067\u306f\u3001\u6575\u306e\u653b\u6483\u3092\u304b\u308f\u3057\u305f\u308a\u3001NPC\u3068\u5bfe\u8a71\u3057\u305f\u308a\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6226\u95d8\u4e2d\u3001\u5fc3\u81d3\u3092\u52d5\u304b\u3057\u653b\u6483\u3092\u907f\u3051\u308b\u3053\u3068\u306f\u3001\u751f\u5b58\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u3053\u306e\u30e2\u30fc\u30c9\u3067\u306f\u3001\u6575\u3092\u8a31\u3059\u3088\u3046\u306a\u7279\u6b8a\u884c\u52d5\u3092\u5b9f\u884c\u3059\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a \u300c\u30bd\u30a6\u30eb\u30e2\u30fc\u30c9\u300d\u306e\u8d77\u52d5\u3068\u4f7f\u7528\u65b9\u6cd5\u3092\u793a\u3059\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u4f5c\u6210\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30d0\u30c3\u30c9\u30bf\u30a4\u30e0\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc\u306b\u304a\u3051\u308b\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u306e\u30d9\u30b9\u30c8\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u52b9\u679c\u7684\u306a\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5e38\u306b\u300c\u30d0\u30bf\u30fc\u30b9\u30b3\u30c3\u30c1\u30d1\u30a4\u300d\u306e\u3088\u3046\u306a\u56de\u5fa9\u30a2\u30a4\u30c6\u30e0\u3092\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u306b\u4fdd\u7ba1\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5fc5\u8981\u306b\u5fdc\u3058\u3066\u3001\u30dc\u30b9\u6226\u306a\u3069\u3001\u30a2\u30a4\u30c6\u30e0\u3092\u7bc0\u7d04\u3057\u3066\u4f7f\u7528\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u3059\u3079\u3066\u306e\u30a8\u30ea\u30a2\u3092\u5fb9\u5e95\u7684\u306b\u63a2\u7d22\u3057\u3066\u3001\u96a0\u3057\u30a2\u30a4\u30c6\u30e0\u3092\u63a2\u3059\u3002\u4f8b\u3048\u3070\u3001\u5ec3\u589f\u3067\u306f\u9685\u3005\u307e\u3067\u63a2\u3059\u3068\u8cb4\u91cd\u306a\u8cc7\u6e90\u304c\u898b\u3064\u304b\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u3055\u307e\u3056\u307e\u306a\u30a2\u30a4\u30c6\u30e0\u306e\u4f7f\u7528\u6226\u7565\u3092\u6bd4\u8f03\u3057\u3001\u6700\u3082\u52b9\u7387\u7684\u306a\u3082\u306e\u3092\u5f37\u8abf\u3057\u307e\u3059\u3002]"}, {"question": "\u30d0\u30c3\u30c9\u30bf\u30a4\u30e0\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc\u3067\u3001\u653b\u6483\u30d1\u30bf\u30fc\u30f3\u304c\u6700\u3082\u8907\u96d1\u306a\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306f\u8ab0\u3067\u3059\u304b\uff1f", "answer": "\u30b5\u30f3\u30c9\u3068\u30a2\u30f3\u30c7\u30a3\u30fc\u30f3\u306f\u3001\u653b\u6483\u30d1\u30bf\u30fc\u30f3\u304c\u6700\u3082\u8907\u96d1\u3067\u3059\u3002\u30b5\u30f3\u30c9\u306e\u653b\u6483\u306f\u901f\u304f\u4e88\u6e2c\u4e0d\u80fd\u3067\u3001\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u56de\u907f\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30a2\u30f3\u30c7\u30a3\u30fc\u30f3\u306e\u69cd\u306e\u653b\u6483\u306f\u69d8\u3005\u306a\u30d1\u30bf\u30fc\u30f3\u304c\u3042\u308a\u3001\u4e88\u6e2c\u3059\u308b\u306e\u304c\u56f0\u96e3\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b5\u30f3\u30c9\u306e\u300c\u30ac\u30b9\u30bf\u30fc\u30d6\u30e9\u30b9\u30bf\u30fc\u300d\u653b\u6483\u306f\u3001\u7d20\u65e9\u304f\u9023\u7d9a\u3059\u308b\u30d3\u30fc\u30e0\u306e\u9023\u767a\u3067\u3042\u308a\u3001\u7d20\u65e9\u304f\u56de\u907f\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u5f7c\u3089\u306e\u653b\u6483\u30d1\u30bf\u30fc\u30f3\u3092\u3001\u5b8c\u74a7\u306a\u30ea\u30ba\u30e0\u304c\u5fc5\u8981\u306a\u8907\u96d1\u306a\u30c0\u30f3\u30b9\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30d0\u30c3\u30c9\u30bf\u30a4\u30e0\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc\u3067\u3001\u79d8\u3081\u3089\u308c\u305f\u30a8\u30f3\u30c7\u30a3\u30f3\u30b0\u3092\u767a\u898b\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u79d8\u3081\u3089\u308c\u305f\u30a8\u30f3\u30c7\u30a3\u30f3\u30b0\u3092\u767a\u898b\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u3059\u3079\u3066\u306e\u6575\u3092\u8a31\u3059\u3053\u3068\u3067\u300c\u5e73\u548c\u4e3b\u7fa9\u8005\u300d\u30eb\u30fc\u30c8\u3092\u9078\u629e\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u4f55\u5ea6\u3082NPC\u3068\u5bfe\u8a71\u3057\u3001\u95a2\u4fc2\u3092\u69cb\u7bc9\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u3059\u3079\u3066\u306e\u526f\u6b21\u7684\u306a\u30af\u30a8\u30b9\u30c8\u3092\u5b8c\u4e86\u3057\u3001\u96a0\u3055\u308c\u305f\u30a8\u30ea\u30a2\u3092\u63a2\u691c\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u30c8\u30ea\u30a2\u3092\u8a31\u3057\u3001\u30d1\u30d4\u30eb\u30b9\u3068\u4ef2\u826f\u304f\u306a\u308b\u3068\u3001\u30e6\u30cb\u30fc\u30af\u306a\u30a8\u30f3\u30c7\u30a3\u30f3\u30b0\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u5404\u79d8\u3081\u3089\u308c\u305f\u30a8\u30f3\u30c7\u30a3\u30f3\u30b0\u3092\u9054\u6210\u3059\u308b\u305f\u3081\u306e\u624b\u9806\u3092\u793a\u3059\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u4f5c\u6210\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}]
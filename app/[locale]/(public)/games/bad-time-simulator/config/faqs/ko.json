[{"question": "\uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 Bad Time Simulator\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \ub9c8\uc2a4\ud130\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Bad Time Simulator\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \ub9c8\uc2a4\ud130\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1: \uc774\ub3d9 \ud0a4(WASD)\uc640 \uacf5\uaca9 \ud0a4(\uc2a4\ud398\uc774\uc2a4\ubc14)\uc5d0 \uc775\uc219\ud574\uc9c0\uc138\uc694. STEP2: \uc801\uc758 \uacf5\uaca9\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uc9c0\uadf8\uc7ac\uadf8 \ud328\ud134\uc73c\ub85c \uc6c0\uc9c1\uc5ec \uc5f0\uc2b5\ud558\uc138\uc694. STEP3: NPC\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\uace0 \uc2a4\ud1a0\ub9ac\ub97c \uc9c4\ud589\ud558\uae30 \uc704\ud574 '\uc18c\uc6b8 \ubaa8\ub4dc'\ub97c \uc0ac\uc6a9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, Sans\uacfc\uc758 \uccab \ubc88\uc9f8 \ub9cc\ub0a8\uc5d0\uc11c\ub294 '\uc18c\uc6b8 \ubaa8\ub4dc'\ub97c \uc0ac\uc6a9\ud558\uc5ec \uadf8\uc758 \uacf5\uaca9\uc744 \ud53c\ud558\uace0 \ubc18\uaca9\ud558\uc138\uc694. [\ube44\uc720 \uc124\uba85: \ucee8\ud2b8\ub864\uc744 \ub9ac\ub4ec\uacfc \ud0c0\uc774\ubc0d\uc774 \uc911\uc694\ud55c \ucda4\uacfc \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uc138\uc694.]"}, {"question": "Bad Time Simulator\uc5d0\uc11c Sans\ub97c \ubb3c\ub9ac\uce58\uae30 \uc704\ud55c \uc8fc\uc694 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sans\ub97c \ubb3c\ub9ac\uce58\ub824\uba74 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uacfc \uc804\ub7b5\uc801\uc778 \uacc4\ud68d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \uadf8\uc758 \uacf5\uaca9 \ud328\ud134, \uc608\ub97c \ub4e4\uc5b4 \ubf08 \uacf5\uaca9\uc740 \ud2b9\uc815 \ub9ac\ub4ec\uc744 \ub530\ub985\ub2c8\ub2e4. STEP2: '\uc18c\uc6b8 \ubaa8\ub4dc'\ub97c \uc0ac\uc6a9\ud558\uc5ec \uadf8\uc758 \uacf5\uaca9\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \ud53c\ud558\uc138\uc694. STEP3: \uadf8\uc758 \uc57d\uc810\uc744 \ub178\ub824 \ubc18\uaca9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc77c\ub828\uc758 \ubf08 \uacf5\uaca9 \ud6c4 \uc7a0\uc2dc \uba48\ucd94\ub294 \uc21c\uac04\uc5d0 \uacf5\uaca9 \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub370\ubbf8\uc9c0\ub97c \uc785\ud788\uc138\uc694. [\uad6c\uc131 \ub300\uc870\ud45c: Sans\uc758 \uacf5\uaca9 \ud328\ud134\uc744 \uba54\ud2b8\ub85c\ub188\uc5d0 \ube44\uad50\ud574\ubcf4\uc138\uc694. \uac01 \ubc15\uc790\ub294 \ud68c\ud53c \uae30\ud68c\ub97c \ub098\ud0c0\ub0c5\ub2c8\ub2e4.]"}, {"question": "Bad Time Simulator\uc5d0\uc11c \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\uae30 \uc704\ud574 \uc5b4\ub5a4 \uc124\uc815\uc744 \uc870\uc815\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \ub2e4\uc74c \uc124\uc815\uc744 \uc870\uc815\ud558\uc138\uc694: STEP1: \ub809\uc774 \ubc1c\uc0dd\ud558\uba74 \ud574\uc0c1\ub3c4\ub97c 720p\ub85c \ub0ae\ucd94\uc138\uc694. STEP2: \ubd88\ud544\uc694\ud55c \ubc31\uadf8\ub77c\uc6b4\ub4dc \uc751\uc6a9 \ud504\ub85c\uadf8\ub7a8\uc744 \ube44\ud65c\uc131\ud654\ud558\uc5ec \uc2dc\uc2a4\ud15c \ub9ac\uc18c\uc2a4\ub97c \ud655\ubcf4\ud558\uc138\uc694. STEP3: \uac8c\uc784 \uc124\uc815\uc5d0\uc11c '\ube60\ub978 \ubaa8\ub4dc'\ub97c \ud65c\uc131\ud654\ud558\uc5ec \ub85c\ub529 \uc2dc\uac04\uc744 \uc904\uc774\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc800\uc0ac\uc591 PC \uc0ac\uc6a9\uc790\ub294 \ud574\uc0c1\ub3c4\ub97c \uc904\uc774\ub294 \uac83\uc774 \ud504\ub808\uc784 \uc18d\ub3c4\ub97c \ud06c\uac8c \ub192\uc774\ub294 \uac83\uc744 \ubc1c\uacac\ud588\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc774\ub7ec\ud55c \uc124\uc815\uc5d0 \uc811\uadfc\ud558\uace0 \uc870\uc815\ud558\ub294 \ub2e8\uacc4\ub97c \ubcf4\uc5ec\uc8fc\ub294 \ud750\ub984\ub3c4\ub97c \uc0dd\uc131\ud558\uc138\uc694.]"}, {"question": "Bad Time Simulator\uc758 \ub9c8\uc9c0\ub9c9 \uc804\ud22c\uc5d0\uc11c \ub09c\uc774\ub3c4\uac00 \uae09\uaca9\ud788 \uc0c1\uc2b9\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub9c8\uc9c0\ub9c9 \uc804\ud22c\uc5d0\uc11c \ub09c\uc774\ub3c4\uac00 \uae09\uc0c1\uc2b9\ud558\ub294 \uac83\uc740 \uc2b5\ub4dd\ud55c \ubaa8\ub4e0 \uae30\uc220\uc744 \uc2dc\ud5d8\ud558\uae30 \uc704\ud574 \uc124\uacc4\ub41c \uac83\uc785\ub2c8\ub2e4. \ub9c8\uc9c0\ub9c9 \ubcf4\uc2a4\uc778 Sans\ub294 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uacfc \ube60\ub978 \ubc18\uc0ac \uc2e0\uacbd\uc774 \ud544\uc694\ud55c \ubcf5\uc7a1\ud55c \uacf5\uaca9 \ud328\ud134\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uadf8\uc758 'Gaster Blaster' \uacf5\uaca9\uc740 \uc774\uc804 \uacf5\uaca9\ubcf4\ub2e4 \ube60\ub974\uace0 \uc608\uce21\ud558\uae30 \uc5b4\ub835\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ub09c\uc774\ub3c4 \uc0c1\uc2b9\uc740 \uac00\uc7a5 \uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\ub9cc \uac8c\uc784\uc744 \uc644\ub8cc\ud560 \uc218 \uc788\ub3c4\ub85d \ubcf4\uc7a5\ud569\ub2c8\ub2e4. [\ub2e4\uc911 \uc194\ub8e8\uc158 \ube44\uad50: \ub9c8\uc9c0\ub9c9 \uc804\ud22c\uc758 \ub09c\uc774\ub3c4\ub97c \uc774\uc804 \uc804\ud22c\uc640 \ube44\uad50\ud558\uace0 \ubcf5\uc7a1\uc131 \uc99d\uac00\ub97c \uac15\uc870\ud558\uc138\uc694.]"}, {"question": "Bad Time Simulator\uc5d0\uc11c PC \uc800\uc7a5 \ub370\uc774\ud130\ub97c \ubaa8\ubc14\uc77c\ub85c \uc804\uc1a1\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc800\uc7a5 \ub370\uc774\ud130\ub97c \uc804\uc1a1\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1: \uc77c\ubc18\uc801\uc73c\ub85c \uac8c\uc784 \uc124\uce58 \ub514\ub809\ud130\ub9ac\uc5d0 \uc788\ub294 PC\uc5d0\uc11c \uc800\uc7a5 \ud30c\uc77c\uc744 \ucc3e\uc73c\uc138\uc694. STEP2: Google Drive\uc640 \uac19\uc740 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uc11c\ube44\uc2a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc800\uc7a5 \ud30c\uc77c\uc744 \uc5c5\ub85c\ub4dc\ud558\uc138\uc694. STEP3: \ubaa8\ubc14\uc77c \uae30\uae30\uc5d0\uc11c \ud30c\uc77c\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uace0 \ud574\ub2f9 \ub514\ub809\ud1a0\ub9ac\uc5d0 \ubc30\uce58\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud50c\ub808\uc774\uc5b4\ub294 \uc774 \ubc29\ubc95\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc774\ub3d9 \uc911\uc5d0\ub3c4 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc5b4\uac08 \uc218 \uc788\uc5c8\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ub300\uc870\ud45c: PC\uc640 \ubaa8\ubc14\uc77c\uc758 \ud30c\uc77c \uacbd\ub85c\ub97c \ubcf4\uc5ec\uc8fc\ub294 \ud45c\ub97c \uc81c\uacf5\ud558\uc138\uc694.]"}, {"question": "Bad Time Simulator\uc5d0\ub294 \ub300\ubd80\ubd84\uc758 \ud50c\ub808\uc774\uc5b4\uac00 \uac04\uacfc\ud558\ub294 \uc228\uaca8\uc9c4 \uba54\ucee4\ub2c8\uc998\uc774 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud558\ub098\uc758 \uc228\uaca8\uc9c4 \uba54\ucee4\ub2c8\uc998\uc740 \uc801\uc744 \uacf5\uaca9\ud558\ub294 \ub300\uc2e0 \uc6a9\uc11c\ud560 \uc218 \uc788\ub294 '\uc790\ube44' \uc635\uc158\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, Toriel\uc744 \uacf5\uaca9\ud558\ub294 \ub300\uc2e0 \uc6a9\uc11c\ud558\uba74 \uac8c\uc784\uc758 \uc774\uc57c\uae30\uac00 \ubc14\ub01d\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uac04\uacfc\ub41c \uba54\ucee4\ub2c8\uc998\uc740 \uc815\ubcf4\ub97c \uc218\uc9d1\ud558\uac70\ub098 \uc801\uc744 \uc9c4\uc815\uc2dc\ud0a4\ub294 \ub370 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 '\ud589\ub3d9' \uba54\ub274\uc785\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \ub2e4\ub978 \uacb0\ub9d0\ub85c \uc774\uc5b4\uc9c0\ub294 \ube44\ubc00 \ud1b5\ub85c\ub77c\uace0 \uc0dd\uac01\ud558\uc138\uc694.]"}, {"question": "'\uc18c\uc6b8 \ubaa8\ub4dc' \uba54\ucee4\ub2c8\uc998\uc740 Bad Time Simulator\uc5d0\uc11c \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "'\uc18c\uc6b8 \ubaa8\ub4dc' \uba54\ucee4\ub2c8\uc998\uc740 \uc601\ud63c\uc744 \ub098\ud0c0\ub0b4\ub294 \uc791\uc740 \uc2ec\uc7a5\uc744 \uc81c\uc5b4\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. \uc774 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uc801\uc758 \uacf5\uaca9\uc744 \ud53c\ud558\uace0 NPC\uc640 \uc0c1\ud638 \uc791\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc804\ud22c \uc911\uc5d0\ub294 \uacf5\uaca9\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uc2ec\uc7a5\uc744 \uc6c0\uc9c1\uc774\ub294 \uac83\uc774 \uc0dd\uc874\uc5d0 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \ub610\ud55c \uc774 \ubaa8\ub4dc\ub97c \ud1b5\ud574 \uc801\uc744 \uc6a9\uc11c\ud558\ub294 \uac83\uacfc \uac19\uc740 \ud2b9\uc218\ud55c \ud589\ub3d9\uc744 \uc218\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: '\uc18c\uc6b8 \ubaa8\ub4dc'\ub97c \ud65c\uc131\ud654\ud558\uace0 \uc0ac\uc6a9\ud558\ub294 \ub2e8\uacc4\ub97c \ubcf4\uc5ec\uc8fc\ub294 \ud750\ub984\ub3c4\ub97c \uc0dd\uc131\ud558\uc138\uc694.]"}, {"question": "Bad Time Simulator\uc5d0\uc11c \uc790\uc6d0\uc744 \uad00\ub9ac\ud558\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud6a8\uacfc\uc801\uc778 \uc790\uc6d0 \uad00\ub9ac\uc5d0\ub294 \ub2e4\uc74c\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4: STEP1: \ud56d\uc0c1 '\ubc84\ud130\uc2a4\ucf58 \ud30c\uc774'\uc640 \uac19\uc740 \uce58\uc720 \uc544\uc774\ud15c\uc744 \uc778\ubca4\ud1a0\ub9ac\uc5d0 \ubcf4\uad00\ud558\uc138\uc694. STEP2: \ubcf4\uc2a4\uc804\uacfc \uac19\uc740 \ud544\uc694\ud55c \uacbd\uc6b0\uc5d0\ub9cc \uc544\uc774\ud15c\uc744 \uc808\uc57d\ud558\uc5ec \uc0ac\uc6a9\ud558\uc138\uc694. STEP3: \ubaa8\ub4e0 \uc9c0\uc5ed\uc744 \ucca0\uc800\ud788 \ud0d0\ud5d8\ud558\uc5ec \uc228\uaca8\uc9c4 \uc544\uc774\ud15c\uc744 \ucc3e\uc73c\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc720\uc801\uc5d0\uc11c\ub294 \ubaa8\ub4e0 \uad6c\uc11d\uc744 \ucc3e\ub294 \uac83\uc774 \uadc0\uc911\ud55c \uc790\uc6d0\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc911 \uc194\ub8e8\uc158 \ube44\uad50: \ub2e4\uc591\ud55c \uc544\uc774\ud15c \uc0ac\uc6a9 \uc804\ub7b5\uc744 \ube44\uad50\ud558\uace0 \uac00\uc7a5 \ud6a8\uc728\uc801\uc778 \uc804\ub7b5\uc744 \uac15\uc870\ud558\uc138\uc694.]"}, {"question": "Bad Time Simulator\uc5d0\uc11c \uac00\uc7a5 \ubcf5\uc7a1\ud55c \uacf5\uaca9 \ud328\ud134\uc744 \uac00\uc9c4 \uce90\ub9ad\ud130\ub294 \ub204\uad6c\uc785\ub2c8\uae4c?", "answer": "Sans\uc640 Undyne\uc740 \uac00\uc7a5 \ubcf5\uc7a1\ud55c \uacf5\uaca9 \ud328\ud134\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. Sans\uc758 \uacf5\uaca9\uc740 \ube60\ub974\uace0 \uc608\uce21\ud560 \uc218 \uc5c6\uc73c\ubbc0\ub85c \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uc73c\ub85c \ud53c\ud574\uc57c \ud569\ub2c8\ub2e4. Undyne\uc758 \ucc3d \uacf5\uaca9\uc740 \ub2e4\uc591\ud55c \ud328\ud134\uc73c\ub85c \ub098\ud0c0\ub098 \uc608\uc0c1\ud558\uae30 \uc5b4\ub835\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, Sans\uc758 'Gaster Blaster' \uacf5\uaca9\uc740 \uc5f0\uc18d\uc801\uc73c\ub85c \ud53c\ud574\uc57c \ud558\ub294 \ube60\ub978 \ube54 \uc2dc\ub9ac\uc988\uc785\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uadf8\ub4e4\uc758 \uacf5\uaca9 \ud328\ud134\uc744 \uc644\ubcbd\ud55c \ub9ac\ub4ec\uc774 \ud544\uc694\ud55c \ubcf5\uc7a1\ud55c \ucda4\uacfc \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uc138\uc694.]"}, {"question": "Bad Time Simulator\uc5d0\uc11c \ube44\ubc00 \uacb0\ub9d0\uc744 \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ube44\ubc00 \uacb0\ub9d0\uc744 \ucc3e\uc73c\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1: \ubaa8\ub4e0 \uc801\uc744 \uc6a9\uc11c\ud558\uc5ec '\ud3c9\ud654\uc8fc\uc758\uc790' \uacbd\ub85c\ub97c \uc120\ud0dd\ud558\uc138\uc694. STEP2: NPC\uc640 \uc5ec\ub7ec \ubc88 \uc0c1\ud638 \uc791\uc6a9\ud558\uc5ec \uad00\uacc4\ub97c \uad6c\ucd95\ud558\uc138\uc694. STEP3: \ubaa8\ub4e0 \ud018\uc2a4\ud2b8\ub97c \uc644\ub8cc\ud558\uace0 \uc228\uaca8\uc9c4 \uc9c0\uc5ed\uc744 \ud0d0\ud5d8\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, Toriel\uc744 \uc6a9\uc11c\ud558\uace0 Papyrus\uc640 \uce5c\uad6c\uac00 \ub418\uba74 \ub3c5\ud2b9\ud55c \uacb0\ub9d0\uc774 \uc5f4\ub9bd\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uac01 \ube44\ubc00 \uacb0\ub9d0\uc744 \ub2ec\uc131\ud558\uae30 \uc704\ud55c \ub2e8\uacc4\ub97c \ubcf4\uc5ec\uc8fc\ub294 \ud750\ub984\ub3c4\ub97c \uc0dd\uc131\ud558\uc138\uc694.]"}]
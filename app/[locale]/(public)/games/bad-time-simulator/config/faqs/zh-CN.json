[{"question": "\u5982\u4f55\u5728\u300a\u6076\u4e4b\u65f6\u95f4\u6a21\u62df\u5668\u300b\u4e2d\u5feb\u901f\u638c\u63e1\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1\u300a\u6076\u4e4b\u65f6\u95f4\u6a21\u62df\u5668\u300b\u7684\u57fa\u672c\u63a7\u5236\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u719f\u6089\u79fb\u52a8\u952e\uff08WASD\uff09\u548c\u653b\u51fb\u952e\uff08\u7a7a\u683c\u952e\uff09\u3002\u6b65\u9aa42\uff1a\u901a\u8fc7\u4ee5\u4e4b\u5b57\u5f62\u6a21\u5f0f\u79fb\u52a8\u6765\u7ec3\u4e60\u8eb2\u907f\u654c\u4eba\u653b\u51fb\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u201c\u7075\u9b42\u6a21\u5f0f\u201d\u4e0eNPC\u4e92\u52a8\u5e76\u63a8\u8fdb\u6545\u4e8b\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u6b21\u9047\u5230Sans\u65f6\uff0c\u4f7f\u7528\u201c\u7075\u9b42\u6a21\u5f0f\u201d\u6765\u8eb2\u907f\u4ed6\u7684\u653b\u51fb\u5e76\u53cd\u51fb\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u63a7\u5236\u60f3\u8c61\u6210\u4e00\u573a\u821e\u8e48\uff0c\u8282\u594f\u548c\u65f6\u673a\u81f3\u5173\u91cd\u8981\u3002]"}, {"question": "\u5728\u300a\u6076\u4e4b\u65f6\u95f4\u6a21\u62df\u5668\u300b\u4e2d\u51fb\u8d25Sans\u7684\u5173\u952e\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u51fb\u8d25Sans\u9700\u8981\u7cbe\u786e\u7684\u65f6\u673a\u548c\u6218\u7565\u89c4\u5212\u7684\u7ed3\u5408\u3002\u6b65\u9aa41\uff1a\u8bb0\u4f4f\u4ed6\u7684\u653b\u51fb\u6a21\u5f0f\uff1b\u4f8b\u5982\uff0c\u4ed6\u7684\u9aa8\u5934\u653b\u51fb\u9075\u5faa\u7279\u5b9a\u7684\u8282\u594f\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u201c\u7075\u9b42\u6a21\u5f0f\u201d\u6709\u6548\u5730\u8eb2\u907f\u4ed6\u7684\u653b\u51fb\u3002\u6b65\u9aa43\uff1a\u5728\u4ed6\u77ed\u6682\u7684\u8106\u5f31\u65f6\u523b\u53cd\u51fb\u3002\u4f8b\u5982\uff0c\u5f53\u4ed6\u5728\u4e00\u7cfb\u5217\u9aa8\u5934\u653b\u51fb\u4e4b\u540e\u6682\u505c\u65f6\uff0c\u4f7f\u7528\u4f60\u7684\u653b\u51fb\u952e\u6765\u9020\u6210\u4f24\u5bb3\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u5c06Sans\u7684\u653b\u51fb\u6a21\u5f0f\u4e0e\u8282\u62cd\u5668\u8fdb\u884c\u6bd4\u8f83\uff0c\u5176\u4e2d\u6bcf\u4e2a\u8282\u62cd\u4ee3\u8868\u4e00\u6b21\u8eb2\u907f\u673a\u4f1a\u3002]"}, {"question": "\u6211\u5e94\u8be5\u8c03\u6574\u54ea\u4e9b\u8bbe\u7f6e\u4ee5\u4f18\u5316\u300a\u6076\u4e4b\u65f6\u95f4\u6a21\u62df\u5668\u300b\u7684\u6027\u80fd\uff1f", "answer": "\u8981\u4f18\u5316\u6027\u80fd\uff0c\u8bf7\u8c03\u6574\u4ee5\u4e0b\u8bbe\u7f6e\uff1a\u6b65\u9aa41\uff1a\u5982\u679c\u9047\u5230\u5ef6\u8fdf\uff0c\u8bf7\u5c06\u5206\u8fa8\u7387\u964d\u4f4e\u5230720p\u3002\u6b65\u9aa42\uff1a\u7981\u7528\u4e0d\u5fc5\u8981\u7684\u540e\u53f0\u5e94\u7528\u7a0b\u5e8f\u4ee5\u91ca\u653e\u7cfb\u7edf\u8d44\u6e90\u3002\u6b65\u9aa43\uff1a\u5728\u6e38\u620f\u8bbe\u7f6e\u4e2d\u542f\u7528\u201c\u5feb\u901f\u6a21\u5f0f\u201d\u4ee5\u51cf\u5c11\u52a0\u8f7d\u65f6\u95f4\u3002\u4f8b\u5982\uff0c\u4f4e\u7aefPC\u73a9\u5bb6\u53d1\u73b0\u964d\u4f4e\u5206\u8fa8\u7387\u663e\u7740\u63d0\u9ad8\u4e86\u5e27\u901f\u7387\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u521b\u5efa\u4e00\u4e2a\u6d41\u7a0b\u56fe\uff0c\u663e\u793a\u8bbf\u95ee\u548c\u8c03\u6574\u8fd9\u4e9b\u8bbe\u7f6e\u7684\u6b65\u9aa4\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u300a\u6076\u4e4b\u65f6\u95f4\u6a21\u62df\u5668\u300b\u7684\u6700\u7ec8\u6218\u6597\u96be\u5ea6\u4f1a\u663e\u8457\u63d0\u5347\uff1f", "answer": "\u6700\u7ec8\u6218\u6597\u7684\u96be\u5ea6\u63d0\u5347\u65e8\u5728\u68c0\u9a8c\u4f60\u6240\u638c\u63e1\u7684\u6240\u6709\u6280\u80fd\u3002\u6700\u7ec8Boss Sans\u62e5\u6709\u590d\u6742\u7684\u653b\u51fb\u6a21\u5f0f\uff0c\u9700\u8981\u7cbe\u786e\u7684\u65f6\u673a\u548c\u5feb\u901f\u53cd\u5e94\u3002\u4f8b\u5982\uff0c\u4ed6\u7684\u201cGaster Blaster\u201d\u653b\u51fb\u6bd4\u4e4b\u524d\u7684\u653b\u51fb\u66f4\u5feb\u3001\u66f4\u96be\u4ee5\u9884\u6d4b\u3002\u8fd9\u79cd\u63d0\u5347\u786e\u4fdd\u53ea\u6709\u6700\u719f\u7ec3\u7684\u73a9\u5bb6\u624d\u80fd\u5b8c\u6210\u6e38\u620f\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u5c06\u6700\u7ec8\u6218\u6597\u7684\u96be\u5ea6\u4e0e\u4e4b\u524d\u7684\u6218\u6597\u8fdb\u884c\u6bd4\u8f83\uff0c\u7a81\u51fa\u5176\u590d\u6742\u6027\u7684\u589e\u52a0\u3002]"}, {"question": "\u5982\u4f55\u5728\u300a\u6076\u4e4b\u65f6\u95f4\u6a21\u62df\u5668\u300b\u4e2d\u5c06\u6211\u7684PC\u5b58\u6863\u6570\u636e\u8f6c\u79fb\u5230\u624b\u673a\u4e0a\uff1f", "answer": "\u8f6c\u79fb\u5b58\u6863\u6570\u636e\u9700\u8981\u51e0\u4e2a\u6b65\u9aa4\uff1a\u6b65\u9aa41\uff1a\u627e\u5230\u4f60PC\u4e0a\u7684\u5b58\u6863\u6587\u4ef6\uff0c\u901a\u5e38\u5728\u6e38\u620f\u7684\u5b89\u88c5\u76ee\u5f55\u4e2d\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u4e91\u5b58\u50a8\u670d\u52a1\uff08\u4f8b\u5982Google Drive\uff09\u4e0a\u4f20\u5b58\u6863\u6587\u4ef6\u3002\u6b65\u9aa43\uff1a\u5728\u4f60\u7684\u79fb\u52a8\u8bbe\u5907\u4e0a\u4e0b\u8f7d\u6587\u4ef6\u5e76\u5c06\u5176\u653e\u7f6e\u5728\u76f8\u5e94\u7684\u76ee\u5f55\u4e2d\u3002\u4f8b\u5982\uff0c\u73a9\u5bb6\u5df2\u7ecf\u6210\u529f\u5730\u4f7f\u7528\u8fd9\u79cd\u65b9\u6cd5\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\u7ee7\u7eed\u4ed6\u4eec\u7684\u8fdb\u5ea6\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u63d0\u4f9b\u4e00\u5f20\u8868\u683c\uff0c\u663e\u793aPC\u548c\u79fb\u52a8\u8bbe\u5907\u7684\u6587\u4ef6\u8def\u5f84\u3002]"}, {"question": "\u300a\u6076\u4e4b\u65f6\u95f4\u6a21\u62df\u5668\u300b\u4e2d\u54ea\u4e9b\u9690\u85cf\u673a\u5236\u662f\u5927\u591a\u6570\u73a9\u5bb6\u5ffd\u7565\u7684\uff1f", "answer": "\u4e00\u4e2a\u9690\u85cf\u673a\u5236\u662f\u201c\u4ec1\u6148\u201d\u9009\u9879\uff0c\u5b83\u5141\u8bb8\u4f60\u9976\u6055\u654c\u4eba\u800c\u4e0d\u662f\u653b\u51fb\u4ed6\u4eec\u3002\u4f8b\u5982\uff0c\u9976\u6055Toriel\u800c\u4e0d\u662f\u653b\u51fb\u5979\u4f1a\u6539\u53d8\u6e38\u620f\u7684\u53d9\u4e8b\u3002\u53e6\u4e00\u4e2a\u88ab\u5ffd\u89c6\u7684\u673a\u5236\u662f\u201c\u884c\u52a8\u201d\u83dc\u5355\uff0c\u5b83\u53ef\u4ee5\u7528\u6765\u6536\u96c6\u4fe1\u606f\u6216\u5b89\u629a\u654c\u4eba\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u8fd9\u4e9b\u673a\u5236\u60f3\u8c61\u6210\u901a\u5f80\u4e0d\u540c\u7ed3\u5c40\u7684\u79d8\u5bc6\u901a\u9053\u3002]"}, {"question": "\u201c\u7075\u9b42\u6a21\u5f0f\u201d\u673a\u5236\u5728\u300a\u6076\u4e4b\u65f6\u95f4\u6a21\u62df\u5668\u300b\u4e2d\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u201c\u7075\u9b42\u6a21\u5f0f\u201d\u673a\u5236\u5141\u8bb8\u4f60\u63a7\u5236\u4e00\u4e2a\u4ee3\u8868\u4f60\u7075\u9b42\u7684\u5c0f\u5fc3\u810f\u3002\u5728\u8fd9\u4e2a\u6a21\u5f0f\u4e0b\uff0c\u4f60\u53ef\u4ee5\u8eb2\u907f\u654c\u4eba\u7684\u653b\u51fb\uff0c\u5e76\u4e0eNPC\u4e92\u52a8\u3002\u4f8b\u5982\uff0c\u5728\u6218\u6597\u4e2d\uff0c\u79fb\u52a8\u5fc3\u810f\u6765\u8eb2\u907f\u653b\u51fb\u5bf9\u4e8e\u751f\u5b58\u81f3\u5173\u91cd\u8981\u3002\u8be5\u6a21\u5f0f\u8fd8\u5141\u8bb8\u4f60\u6267\u884c\u7279\u6b8a\u884c\u52a8\uff0c\u4f8b\u5982\u9976\u6055\u654c\u4eba\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u521b\u5efa\u4e00\u4e2a\u6d41\u7a0b\u56fe\uff0c\u663e\u793a\u6fc0\u6d3b\u548c\u4f7f\u7528\u201c\u7075\u9b42\u6a21\u5f0f\u201d\u7684\u6b65\u9aa4\u3002]"}, {"question": "\u5728\u300a\u6076\u4e4b\u65f6\u95f4\u6a21\u62df\u5668\u300b\u4e2d\u7ba1\u7406\u8d44\u6e90\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u6709\u6548\u7684\u8d44\u6e90\u7ba1\u7406\u5305\u62ec\uff1a\u6b65\u9aa41\uff1a\u59cb\u7ec8\u5c06\u50cf\u201c\u7126\u7cd6\u5e03\u4e01\u201d\u8fd9\u6837\u7684\u6cbb\u7597\u7269\u54c1\u4fdd\u7559\u5728\u4f60\u7684\u7269\u54c1\u680f\u4e2d\u3002\u6b65\u9aa42\uff1a\u5728\u5fc5\u8981\u65f6\uff08\u4f8b\u5982\u5728Boss\u6218\u4e2d\uff09\u8c28\u614e\u4f7f\u7528\u7269\u54c1\u3002\u6b65\u9aa43\uff1a\u5f7b\u5e95\u63a2\u7d22\u6bcf\u4e2a\u533a\u57df\u4ee5\u627e\u5230\u9690\u85cf\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5728\u5e9f\u589f\u4e2d\u5bfb\u627e\u6bcf\u4e00\u4e2a\u89d2\u843d\u53ef\u80fd\u4f1a\u6709\u4ef7\u503c\u7684\u8d44\u6e90\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6bd4\u8f83\u4e0d\u540c\u7684\u7269\u54c1\u4f7f\u7528\u7b56\u7565\uff0c\u7a81\u51fa\u6700\u6709\u6548\u7684\u7b56\u7565\u3002]"}, {"question": "\u300a\u6076\u4e4b\u65f6\u95f4\u6a21\u62df\u5668\u300b\u4e2d\u54ea\u4e9b\u89d2\u8272\u5177\u6709\u6700\u590d\u6742\u7684\u653b\u51fb\u6a21\u5f0f\uff1f", "answer": "Sans\u548cUndyne\u62e5\u6709\u6700\u590d\u6742\u7684\u653b\u51fb\u6a21\u5f0f\u3002Sans\u7684\u653b\u51fb\u901f\u5ea6\u5feb\u4e14\u96be\u4ee5\u9884\u6d4b\uff0c\u9700\u8981\u7cbe\u786e\u7684\u65f6\u673a\u624d\u80fd\u8eb2\u907f\u3002Undyne\u7684\u77db\u653b\u51fb\u6a21\u5f0f\u591a\u6837\uff0c\u96be\u4ee5\u9884\u6d4b\u3002\u4f8b\u5982\uff0cSans\u7684\u201cGaster Blaster\u201d\u653b\u51fb\u662f\u4e00\u7cfb\u5217\u5feb\u901f\u5c04\u51fa\u7684\u5149\u675f\uff0c\u5fc5\u987b\u5feb\u901f\u8fde\u7eed\u5730\u8eb2\u907f\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u4ed6\u4eec\u7684\u653b\u51fb\u6a21\u5f0f\u60f3\u8c61\u6210\u9700\u8981\u5b8c\u7f8e\u8282\u594f\u7684\u590d\u6742\u821e\u8e48\u3002]"}, {"question": "\u5982\u4f55\u53d1\u73b0\u300a\u6076\u4e4b\u65f6\u95f4\u6a21\u62df\u5668\u300b\u4e2d\u7684\u9690\u85cf\u7ed3\u5c40\uff1f", "answer": "\u8981\u53d1\u73b0\u9690\u85cf\u7ed3\u5c40\uff0c\u8bf7\u6309\u7167\u8fd9\u4e9b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u901a\u8fc7\u9976\u6055\u6240\u6709\u654c\u4eba\u9009\u62e9\u201c\u548c\u5e73\u4e3b\u4e49\u201d\u8def\u7ebf\u3002\u6b65\u9aa42\uff1a\u4e0eNPC\u591a\u6b21\u4e92\u52a8\u4ee5\u5efa\u7acb\u5173\u7cfb\u3002\u6b65\u9aa43\uff1a\u5b8c\u6210\u6240\u6709\u652f\u7ebf\u4efb\u52a1\u5e76\u63a2\u7d22\u9690\u85cf\u533a\u57df\u3002\u4f8b\u5982\uff0c\u9976\u6055Toriel\u5e76\u4e0ePapyrus\u6210\u4e3a\u670b\u53cb\u4f1a\u89e3\u9501\u4e00\u4e2a\u72ec\u7279\u7684\u7ed3\u5c40\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u521b\u5efa\u4e00\u4e2a\u6d41\u7a0b\u56fe\uff0c\u663e\u793a\u5b9e\u73b0\u6bcf\u4e2a\u9690\u85cf\u7ed3\u5c40\u7684\u6b65\u9aa4\u3002]"}]
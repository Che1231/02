[{"question": "\ucd08\ubcf4\uc790\uac00 Minibattles\uc5d0\uc11c \uae30\ubcf8\uc801\uc778 \uc870\uc791\uc744 \ube60\ub974\uac8c \uc775\ud788\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud558\ub098\uc694?", "answer": "Minibattles\uc758 \uae30\ubcf8\uc801\uc778 \uc870\uc791\uc744 \uc775\ud788\ub824\uba74 \uc774\ub3d9, \uacf5\uaca9, \ud2b9\uc218 \ub2a5\ub825 \uc0ac\uc6a9\ubc95\uc744 \uc18c\uac1c\ud558\ub294 \ud29c\ud1a0\ub9ac\uc5bc\ubd80\ud130 \uc2dc\uc791\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, WASD \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc774\ub3d9\ud558\uace0 \uc67c\ucabd \ub9c8\uc6b0\uc2a4 \ubc84\ud2bc\uc744 \uc0ac\uc6a9\ud558\uc5ec \uacf5\uaca9\ud569\ub2c8\ub2e4. \ud6c8\ub828 \uacbd\uae30\uc7a5\uc5d0\uc11c \uc5f0\uc2b5\ud558\uc5ec \uc774\ub7ec\ud55c \uc870\uc791\uc5d0 \uc775\uc219\ud574\uc9c0\uc138\uc694. \ub610\ud55c, 'Q' \ud0a4\ub97c \ub20c\ub7ec \uccab \ubc88\uc9f8 \ud2b9\uc218 \ub2a5\ub825\uc744 \ud65c\uc131\ud654\ud558\ub294 \ub4f1 \ub2a5\ub825 \ub2e8\ucd95\ud0a4\ub97c \uc219\uc9c0\ud558\uc138\uc694. 1\ub2e8\uacc4: \ud29c\ud1a0\ub9ac\uc5bc\uc744 \uc644\ub8cc\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \ud6c8\ub828 \uacbd\uae30\uc7a5\uc5d0\uc11c \uc5f0\uc2b5\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \ub2a5\ub825 \ub2e8\ucd95\ud0a4\ub97c \uc554\uae30\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc870\uc791\ubc95\uc744 \uc6b4\uc804 \ubc30\uc6b0\ub294 \uac83\uc5d0 \ube44\uc720\ud574 \ubcf4\uc138\uc694. \ucc9c\ucc9c\ud788 \uc2dc\uc791\ud574\uc11c \uc810\ucc28 \uc18d\ub3c4\ub97c \ub192\uc774\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "Minibattles\uc5d0\uc11c 100\uc2dc\uac04 \ud50c\ub808\uc774 \ud6c4 \ub354 \uc624\ub798 \uc0dd\uc874\ud558\uae30 \uc704\ud55c \ud544\uc218 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Minibattles\uc5d0\uc11c 100\uc2dc\uac04 \ud50c\ub808\uc774 \ud6c4\uc5d0\ub294 \ud3ec\uc9c0\uc154\ub2dd, \ub2a5\ub825 \ucf64\ubcf4, \uc790\uc6d0 \uad00\ub9ac\uc640 \uac19\uc740 \uace0\uae09 \uc804\ub7b5\uc5d0 \uc9d1\uc911\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud56d\uc0c1 \uc5c4\ud3d0\ubb3c \ub4a4\uc5d0 \uc704\uce58\ud558\uc5ec \uc801\uc758 \uacf5\uaca9\uc744 \ud53c\ud558\uc138\uc694. '\ud654\uc5fc\uad6c'\uc640 '\uc5bc\uc74c \ud30c\ud3b8'\uacfc \uac19\uc740 \ub2a5\ub825\uc744 \uc870\ud569\ud558\uc5ec \ucd5c\ub300 \ub370\ubbf8\uc9c0\ub97c \uac00\ud558\uc138\uc694. \uccb4\ub825 \ud3ec\uc158\uc740 \uccb4\ub825\uc774 30% \uc774\ud558\uc77c \ub54c\ub9cc \uc0ac\uc6a9\ud558\uc5ec \uad00\ub9ac\ud558\uc138\uc694. 1\ub2e8\uacc4: \ud56d\uc0c1 \uc804\ub7b5\uc801\uc73c\ub85c \uc704\uce58\ub97c \uc7a1\uc2b5\ub2c8\ub2e4. 2\ub2e8\uacc4: \ucd5c\ub300 \ud6a8\uacfc\ub97c \uc704\ud574 \ub2a5\ub825\uc744 \uc870\ud569\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \uc790\uc6d0\uc744 \ud604\uba85\ud558\uac8c \uad00\ub9ac\ud569\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\uc548 \ube44\uad50: \uccb4\ub825 \ud3ec\uc158\uc744 30%\uc5d0\uc11c \uc0ac\uc6a9\ud558\ub294 \uac83\uacfc 50%\uc5d0\uc11c \uc0ac\uc6a9\ud558\ub294 \uac83\uc744 \ube44\uad50\ud558\uc5ec \uc5b4\ub5a4 \uc804\ub7b5\uc774 \uc0dd\uc874\uc744 \ub354 \uc5f0\uc7a5\ud558\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694.]"}, {"question": "Minibattles\uc5d0\uc11c \ub370\ubbf8\uc9c0 \uacc4\uc0b0 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc65c \uc911\uc694\ud55c\uac00\uc694?", "answer": "Minibattles\uc5d0\uc11c \ub370\ubbf8\uc9c0 \uacc4\uc0b0 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \ube4c\ub4dc\uc640 \uc804\ub7b5\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ub370 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \ub370\ubbf8\uc9c0\ub294 \uae30\ubcf8 \uacf5\uaca9\ub825, \uce58\uba85\ud0c0 \ud655\ub960, \ubc29\uc5b4\uad6c \uad00\ud1b5\ub825\uc5d0 \ub530\ub77c \uacc4\uc0b0\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uae30\ubcf8 \uacf5\uaca9\ub825 100, \uce58\uba85\ud0c0 \ud655\ub960 20%, \ubc29\uc5b4\uad6c \uad00\ud1b5\ub825 10\uc744 \uac00\uc9c4 \uce90\ub9ad\ud130\ub294 \uc774\ub7ec\ud55c \uc2a4\ud0ef\uc774 \uc5c6\ub294 \uce90\ub9ad\ud130\ubcf4\ub2e4 \ub354 \ub9ce\uc740 \ub370\ubbf8\uc9c0\ub97c \uc90d\ub2c8\ub2e4. 1\ub2e8\uacc4: \uae30\ubcf8 \uacf5\uaca9\ub825\uc744 \ud30c\uc545\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \uce58\uba85\ud0c0 \ud655\ub960\uc744 \uace0\ub824\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \ubc29\uc5b4\uad6c \uad00\ud1b5\ub825\uc744 \uace0\ub824\ud569\ub2c8\ub2e4. [\uad6c\uc131 \ub300\uc870\ud45c: \uac01 \uc2a4\ud0ef\uc758 \uc601\ud5a5\uc744 \ud655\uc778\ud558\uae30 \uc704\ud574 \ub2e4\uc591\ud55c \uc2a4\ud0ef\uc73c\ub85c \ub370\ubbf8\uc9c0 \ucd9c\ub825\uc744 \ube44\uad50\ud569\ub2c8\ub2e4.]"}, {"question": "\uc5b4\ub5a4 Minibattles \uce90\ub9ad\ud130\uac00 \ud300 \ud50c\ub808\uc774\uc5d0 \uac00\uc7a5 \uc801\ud569\ud558\uba70 \uadf8 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Minibattles\uc5d0\uc11c '\ud790\ub7ec'\uc640 '\ud0f1\ucee4'\uc640 \uac19\uc740 \uce90\ub9ad\ud130\ub294 \uc9c0\uc6d0 \ubc0f \ubc29\uc5b4 \ub2a5\ub825\uc73c\ub85c \uc778\ud574 \ud300 \ud50c\ub808\uc774\uc5d0 \uac00\uc7a5 \uc801\ud569\ud569\ub2c8\ub2e4. \ud790\ub7ec\ub294 \ud300\uc6d0\uc758 \uccb4\ub825\uc744 \ud68c\ubcf5\uc2dc\ud0ac \uc218 \uc788\uace0, \ud0f1\ucee4\ub294 \ub370\ubbf8\uc9c0\ub97c \ud761\uc218\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud300 \uc804\ud22c\uc5d0\uc11c \ud790\ub7ec\ub294 \ud0f1\ucee4\ub97c \ub354 \uc624\ub798 \uc0b4\uc544\ub0a8\uac8c \ud558\uc5ec \ud300\uc774 \ub354 \ub9ce\uc740 \ub370\ubbf8\uc9c0\ub97c \uacac\ub51c \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \uc9c0\uc6d0\uc744 \uc704\ud574 \ud790\ub7ec\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \ubc29\uc5b4\ub97c \uc704\ud574 \ud0f1\ucee4\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \uc804\ud22c \uc911 \ub2a5\ub825\uc744 \uc870\uc728\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud790\ub7ec\uc640 \ud0f1\ucee4\ub97c \ud300\uc758 \ucc99\ucd94\ub85c \uc0dd\uac01\ud558\uace0 \ub098\uba38\uc9c0\ub97c \uc9c0\uc6d0\ud558\uace0 \ubcf4\ud638\ud569\ub2c8\ub2e4.]"}, {"question": "Minibattles\uc758 \ub9e4\uce58\uba54\uc774\ud0b9 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uade0\ud615 \uc7a1\ud78c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ubcf4\uc7a5\ud558\ub098\uc694?", "answer": "Minibattles\uc758 \ub9e4\uce58\uba54\uc774\ud0b9 \uc2dc\uc2a4\ud15c\uc740 \ube44\uc2b7\ud55c \uc2e4\ub825 \uc218\uc900\uc758 \ud50c\ub808\uc774\uc5b4\ub97c \uc9dd\uc9c0\uc5b4\uc8fc\uace0 \uc2b9/\ud328 \ube44\uc728\uc744 \uace0\ub824\ud558\uc5ec \uade0\ud615 \uc7a1\ud78c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ubcf4\uc7a5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc2b9\ub960\uc774 50%\uc778 \ud50c\ub808\uc774\uc5b4\ub294 \ube44\uc2b7\ud55c \uc2b9\ub960\uc744 \uac00\uc9c4 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uc640 \ub9e4\uce6d\ub429\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \ub610\ud55c \uacf5\uc815\uc131\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 \ud50c\ub808\uc774\ud55c \uac8c\uc784 \uc218\ub97c \uace0\ub824\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \uc2e4\ub825 \uc218\uc900\ubcc4\ub85c \ud50c\ub808\uc774\uc5b4\ub97c \ub9e4\uce6d\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \uc2b9/\ud328 \ube44\uc728\uc744 \uace0\ub824\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \ud50c\ub808\uc774\ud55c \uac8c\uc784 \uc218\ub97c \uace0\ub824\ud569\ub2c8\ub2e4. [\ud750\ub984\ub3c4 \ud574\uc124: \ud50c\ub808\uc774\uc5b4\uac00 \uc5b4\ub5bb\uac8c \uc9dd\uc9c0\uc5b4\uc9c0\ub294\uc9c0 \ud655\uc778\ud558\uae30 \uc704\ud574 \ub9e4\uce58\uba54\uc774\ud0b9 \ud504\ub85c\uc138\uc2a4\ub97c \uc2dc\uac01\ud654\ud569\ub2c8\ub2e4.]"}, {"question": "Minibattles\uc5d0 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\ub098\uc694?", "answer": "Minibattles\ub294 \ud0d0\ud5d8\uc5d0 \ub300\ud55c \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud558\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub85c \uac00\ub4dd \ucc28 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc78a\ud600\uc9c4 \uc232' \ub9f5\uc5d0\ub294 \ud76c\uadc0 \uc544\uc774\ud15c\uc774 \ub4e4\uc5b4 \uc788\ub294 \uc228\uaca8\uc9c4 \uc0c1\uc790\uac00 \ud3ed\ud3ec \ub4a4\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \ucc3e\uc73c\ub824\uba74 \ud2b9\uc774\ud55c \uc554\uc11d \uc9c0\ud615\uacfc \uac19\uc740 \ubbf8\ubb18\ud55c \ud658\uacbd \ub2e8\uc11c\ub97c \ucc3e\uc73c\uc138\uc694. 1\ub2e8\uacc4: \ubaa8\ub4e0 \ub9f5 \uc601\uc5ed\uc744 \ucca0\uc800\ud788 \ud0d0\ud5d8\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \ud658\uacbd \ub2e8\uc11c\ub97c \ucc3e\uc2b5\ub2c8\ub2e4. 3\ub2e8\uacc4: \uc758\uc2ec\uc2a4\ub7ec\uc6b4 \ubb3c\uccb4\uc640 \uc0c1\ud638 \uc791\uc6a9\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ubc1c\uacac\ub418\uae30\ub97c \uae30\ub2e4\ub9ac\ub294 \uc228\uaca8\uc9c4 \ubcf4\ubb3c\ub85c \uc0dd\uac01\ud558\uc138\uc694.]"}, {"question": "Minibattles \uc9c4\ud589 \uc0c1\ud669\uc744 PC\uc5d0\uc11c \ubaa8\ubc14\uc77c\ub85c \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Minibattles \uc9c4\ud589 \uc0c1\ud669\uc744 PC\uc5d0\uc11c \ubaa8\ubc14\uc77c\ub85c \uc804\uc1a1\ud558\ub824\uba74 \uac8c\uc784 \uacc4\uc815\uc744 Google Play \ub610\ub294 Apple Game Center\uc640 \uac19\uc740 \ubc94\uc6a9 \uacc4\uc815\uc5d0 \uc5f0\uacb0\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub450 \uc7a5\uce58\uc5d0\uc11c \ub3d9\uc77c\ud55c \uc790\uaca9 \uc99d\uba85\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uba74 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc790\ub3d9\uc73c\ub85c \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. 1\ub2e8\uacc4: \ubc94\uc6a9 \uacc4\uc815\uc744 \ub9cc\ub4ed\ub2c8\ub2e4. 2\ub2e8\uacc4: Minibattles \uacc4\uc815\uc744 \uc5f0\uacb0\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \uc0c8 \uc7a5\uce58\uc5d0\uc11c \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. [\uad6c\uc131 \ub300\uc870\ud45c: \ud638\ud658\uc131\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 \uacc4\uc815 \uc5f0\uacb0 \ubc29\ubc95\uc744 \ube44\uad50\ud569\ub2c8\ub2e4.]"}, {"question": "Minibattles\uc758 \uc194\ub85c \ubaa8\ub4dc\uc640 \ud300 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Minibattles\uc758 \uc194\ub85c \ubaa8\ub4dc\uc640 \ud300 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \uc804\ub7b5\uacfc \ud611\ub3d9\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \uc194\ub85c \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uc790\uc2e0\uc758 \uae30\uc220\uacfc \ub2a5\ub825\uc5d0\ub9cc \uc758\uc874\ud558\ub294 \ubc18\uba74, \ud300 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \ud300\uc6d0\uacfc \ud611\ub825\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud300 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \ud790\ub7ec\uc758 \ub2a5\ub825\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud0f1\ucee4\ub97c \uc9c0\uc6d0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 1\ub2e8\uacc4: \uc194\ub85c \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uac1c\uc778 \uae30\uc220\uc5d0 \uc9d1\uc911\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \ud300 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \ud300\uc6d0\uacfc \ud611\ub825\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \ubaa8\ub4dc\uc5d0 \ub530\ub77c \uc804\ub7b5\uc744 \uc870\uc815\ud569\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\uc548 \ube44\uad50: \uc790\uc2e0\uc758 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\ub294 \uac83\uc744 \ud655\uc778\ud558\uae30 \uc704\ud574 \uc194\ub85c \ubc0f \ud300 \uc804\ub7b5\uc744 \ube44\uad50\ud569\ub2c8\ub2e4.]"}, {"question": "\uc800\uc0ac\uc591 PC\uc5d0\uc11c \ucd5c\uace0\uc758 \uc131\ub2a5\uc744 \uc704\ud574 Minibattles \uc124\uc815\uc744 \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud558\ub098\uc694?", "answer": "\uc800\uc0ac\uc591 PC\uc6a9 Minibattles\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \ud14d\uc2a4\ucc98 \ud488\uc9c8 \ubc0f \uadf8\ub9bc\uc790 \ub514\ud14c\uc77c\uacfc \uac19\uc740 \uadf8\ub798\ud53d \uc124\uc815\uc744 \ub0ae\ucd94\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud14d\uc2a4\ucc98 \ud488\uc9c8\uc744 '\ub0ae\uc74c'\uc73c\ub85c \uc124\uc815\ud558\uace0 \uadf8\ub9bc\uc790\ub97c \ube44\ud65c\uc131\ud654\ud569\ub2c8\ub2e4. \ub610\ud55c, \uc2dc\uc2a4\ud15c \ub9ac\uc18c\uc2a4\ub97c \ud655\ubcf4\ud558\uae30 \uc704\ud574 \ubc31\uadf8\ub77c\uc6b4\ub4dc \uc751\uc6a9 \ud504\ub85c\uadf8\ub7a8\uc744 \ub2eb\uc73c\uc138\uc694. 1\ub2e8\uacc4: \uadf8\ub798\ud53d \uc124\uc815\uc744 \ub0ae\ucda5\ub2c8\ub2e4. 2\ub2e8\uacc4: \ubd88\ud544\uc694\ud55c \ud6a8\uacfc\ub97c \ube44\ud65c\uc131\ud654\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \ubc31\uadf8\ub77c\uc6b4\ub4dc \uc751\uc6a9 \ud504\ub85c\uadf8\ub7a8\uc744 \ub2eb\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ub300\uc870\ud45c: \uac1c\uc120 \uc0ac\ud56d\uc744 \ud655\uc778\ud558\uae30 \uc704\ud574 \ucd5c\uc801\ud654 \uc804\ud6c4\uc758 \uc131\ub2a5\uc744 \ube44\uad50\ud569\ub2c8\ub2e4.]"}, {"question": "\ub370\ubbf8\uc9c0 \ucd9c\ub825\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud55c Minibattles\uc5d0\uc11c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ub2a5\ub825 \ucf64\ubcf4\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub370\ubbf8\uc9c0 \ucd9c\ub825\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud55c Minibattles\uc5d0\uc11c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ub2a5\ub825 \ucf64\ubcf4\ub294 \ub192\uc740 \ub370\ubbf8\uc9c0 \ubc30\uc728\uc744 \uac00\uc9c4 \ub2a5\ub825\uc744 \uc5f0\uacb0\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud654\uc5fc\uad6c'\ub97c \uc0ac\uc6a9\ud55c \ub2e4\uc74c '\uc5bc\uc74c \ud30c\ud3b8'\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc6d0\uc18c \uc57d\uc810\uc744 \uacf5\ub7b5\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \ub192\uc740 \ub370\ubbf8\uc9c0 \ub2a5\ub825\uc744 \uc2dd\ubcc4\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \ubc30\uc728\uc774 \uc788\ub294 \ub2a5\ub825\uc744 \uc5f0\uacb0\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \uc801\uc758 \uc57d\uc810\uc744 \uacf5\ub7b5\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ub2a5\ub825 \ucf64\ubcf4\ub97c \uc6d0\ud22c \ud380\uce58\ub85c \uc0dd\uac01\ud558\uace0 \ub450 \ubc88\uc9f8 \ud0c0\uaca9\uc774 \ub354 \uac15\ub825\ud569\ub2c8\ub2e4.]"}]
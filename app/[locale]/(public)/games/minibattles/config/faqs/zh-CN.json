[{"question": "\u65b0\u624b\u5982\u4f55\u5feb\u901f\u638c\u63e1\u8ff7\u4f60\u6218\u6597\u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u638c\u63e1\u8ff7\u4f60\u6218\u6597\u7684\u57fa\u672c\u63a7\u5236\uff0c\u8bf7\u4ece\u4ecb\u7ecd\u79fb\u52a8\u3001\u653b\u51fb\u548c\u4f7f\u7528\u7279\u6b8a\u80fd\u529b\u7684\u6559\u7a0b\u5f00\u59cb\u3002\u4f8b\u5982\uff0c\u4f7f\u7528 WASD \u952e\u79fb\u52a8\uff0c\u4f7f\u7528\u5de6\u9f20\u6807\u952e\u653b\u51fb\u3002\u5728\u8bad\u7ec3\u573a\u7ec3\u4e60\uff0c\u4f7f\u81ea\u5df1\u719f\u6089\u8fd9\u4e9b\u63a7\u5236\u3002\u6b64\u5916\uff0c\u719f\u6089\u6280\u80fd\u7684\u5feb\u6377\u952e\uff0c\u4f8b\u5982\u6309\u201cQ\u201d\u6fc0\u6d3b\u4f60\u7684\u7b2c\u4e00\u4e2a\u7279\u6b8a\u80fd\u529b\u3002\u6b65\u9aa4 1\uff1a\u5b8c\u6210\u6559\u7a0b\u3002\u6b65\u9aa4 2\uff1a\u5728\u8bad\u7ec3\u573a\u7ec3\u4e60\u3002\u6b65\u9aa4 3\uff1a\u8bb0\u4f4f\u6280\u80fd\u5feb\u6377\u952e\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u63a7\u5236\u60f3\u8c61\u6210\u5b66\u4e60\u5f00\u8f66\uff1b\u4ece\u6162\u5f00\u59cb\uff0c\u9010\u6e10\u52a0\u5feb\u901f\u5ea6\u3002]"}, {"question": "\u5728\u8ff7\u4f60\u6218\u6597\u6e38\u620f\u4e2d\u73a9\u4e86 100 \u4e2a\u5c0f\u65f6\u540e\uff0c\u5982\u4f55\u624d\u80fd\u66f4\u957f\u65f6\u95f4\u751f\u5b58\uff1f", "answer": "\u5728\u8ff7\u4f60\u6218\u6597\u4e2d\u73a9\u4e86 100 \u4e2a\u5c0f\u65f6\u540e\uff0c\u4e13\u6ce8\u4e8e\u9ad8\u7ea7\u7b56\u7565\uff0c\u4f8b\u5982\u4f4d\u7f6e\u3001\u6280\u80fd\u8fde\u62db\u548c\u8d44\u6e90\u7ba1\u7406\u3002\u4f8b\u5982\uff0c\u59cb\u7ec8\u5c06\u81ea\u5df1\u7f6e\u4e8e\u63a9\u4f53\u540e\u9762\u4ee5\u907f\u514d\u654c\u4eba\u653b\u51fb\u3002\u5c06\u201c\u706b\u7403\u201d\u548c\u201c\u51b0\u9525\u201d\u7b49\u6280\u80fd\u7ec4\u5408\u4f7f\u7528\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u4f24\u5bb3\u3002\u53ea\u6709\u5728\u751f\u547d\u503c\u4f4e\u4e8e 30% \u65f6\u624d\u4f7f\u7528\u4f60\u7684\u751f\u547d\u836f\u6c34\u3002\u6b65\u9aa4 1\uff1a\u59cb\u7ec8\u91c7\u53d6\u6218\u7565\u5730\u4f4d\u3002\u6b65\u9aa4 2\uff1a\u7ec4\u5408\u6280\u80fd\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u53d1\u6325\u6548\u679c\u3002\u6b65\u9aa4 3\uff1a\u660e\u667a\u5730\u7ba1\u7406\u8d44\u6e90\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6bd4\u8f83\u5728\u751f\u547d\u503c 30% \u4e0e 50% \u65f6\u4f7f\u7528\u751f\u547d\u836f\u6c34\uff0c\u770b\u770b\u54ea\u79cd\u7b56\u7565\u53ef\u4ee5\u5ef6\u957f\u751f\u547d\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u7406\u89e3\u8ff7\u4f60\u6218\u6597\u7684\u4f24\u5bb3\u8ba1\u7b97\u7cfb\u7edf\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u7406\u89e3\u8ff7\u4f60\u6218\u6597\u7684\u4f24\u5bb3\u8ba1\u7b97\u7cfb\u7edf\u5bf9\u4e8e\u4f18\u5316\u4f60\u7684\u6784\u5efa\u548c\u7b56\u7565\u81f3\u5173\u91cd\u8981\u3002\u4f24\u5bb3\u7684\u8ba1\u7b97\u57fa\u4e8e\u57fa\u7840\u653b\u51fb\u529b\u3001\u66b4\u51fb\u51e0\u7387\u548c\u7a7f\u900f\u88c5\u7532\u3002\u4f8b\u5982\uff0c\u4e00\u4e2a\u62e5\u6709 100 \u70b9\u57fa\u7840\u653b\u51fb\u529b\u300120% \u66b4\u51fb\u51e0\u7387\u548c 10 \u70b9\u7a7f\u900f\u88c5\u7532\u7684\u89d2\u8272\u5c06\u6bd4\u6ca1\u6709\u8fd9\u4e9b\u5c5e\u6027\u7684\u89d2\u8272\u9020\u6210\u66f4\u591a\u7684\u4f24\u5bb3\u3002\u6b65\u9aa4 1\uff1a\u4e86\u89e3\u4f60\u7684\u57fa\u7840\u653b\u51fb\u529b\u3002\u6b65\u9aa4 2\uff1a\u8003\u8651\u66b4\u51fb\u51e0\u7387\u3002\u6b65\u9aa4 3\uff1a\u8003\u8651\u7a7f\u900f\u88c5\u7532\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6bd4\u8f83\u4e0d\u540c\u5c5e\u6027\u7684\u4f24\u5bb3\u8f93\u51fa\uff0c\u770b\u770b\u6bcf\u79cd\u5c5e\u6027\u7684\u5f71\u54cd\u3002]"}, {"question": "\u54ea\u4e9b\u8ff7\u4f60\u6218\u6597\u89d2\u8272\u6700\u9002\u5408\u56e2\u961f\u5408\u4f5c\uff0c\u4e3a\u4ec0\u4e48\uff1f", "answer": "\u5728\u8ff7\u4f60\u6218\u6597\u4e2d\uff0c\u50cf\u201c\u6cbb\u7597\u5e08\u201d\u548c\u201c\u5766\u514b\u201d\u8fd9\u6837\u7684\u89d2\u8272\u6700\u9002\u5408\u56e2\u961f\u5408\u4f5c\uff0c\u56e0\u4e3a\u5b83\u4eec\u5177\u6709\u652f\u6301\u6027\u548c\u9632\u5fa1\u6027\u80fd\u529b\u3002\u201c\u6cbb\u7597\u5e08\u201d\u53ef\u4ee5\u6062\u590d\u961f\u53cb\u7684\u751f\u547d\u503c\uff0c\u201c\u5766\u514b\u201d\u53ef\u4ee5\u5438\u6536\u4f24\u5bb3\u3002\u4f8b\u5982\uff0c\u5728\u56e2\u961f\u6218\u6597\u4e2d\uff0c\u201c\u6cbb\u7597\u5e08\u201d \u53ef\u4ee5\u8ba9\u201c\u5766\u514b\u201d\u6d3b\u5f97\u66f4\u4e45\uff0c\u4ece\u800c\u4f7f\u56e2\u961f\u80fd\u591f\u627f\u53d7\u66f4\u591a\u7684\u4f24\u5bb3\u3002\u6b65\u9aa4 1\uff1a\u9009\u62e9\u4e00\u540d\u6cbb\u7597\u5e08\u8fdb\u884c\u652f\u63f4\u3002\u6b65\u9aa4 2\uff1a\u9009\u62e9\u4e00\u540d\u5766\u514b\u8fdb\u884c\u9632\u5fa1\u3002\u6b65\u9aa4 3\uff1a\u5728\u6218\u6597\u4e2d\u534f\u8c03\u6280\u80fd\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u6cbb\u7597\u5e08\u548c\u5766\u514b\u89c6\u4e3a\u56e2\u961f\u7684\u652f\u67f1\uff0c\u4e3a\u5176\u4f59\u6210\u5458\u63d0\u4f9b\u652f\u6301\u548c\u4fdd\u62a4\u3002]"}, {"question": "\u8ff7\u4f60\u6218\u6597\u7684\u5339\u914d\u7cfb\u7edf\u5982\u4f55\u786e\u4fdd\u5e73\u8861\u7684\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u8ff7\u4f60\u6218\u6597\u7684\u5339\u914d\u7cfb\u7edf\u901a\u8fc7\u5c06\u6280\u80fd\u6c34\u5e73\u76f8\u4f3c\u4e14\u8003\u8651\u80dc\u7387/\u8d25\u7387\u7684\u73a9\u5bb6\u914d\u5bf9\u6765\u786e\u4fdd\u5e73\u8861\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u4f8b\u5982\uff0c\u80dc\u7387\u4e3a 50% \u7684\u73a9\u5bb6\u5c06\u4e0e\u80dc\u7387\u76f8\u4f3c\u7684\u5176\u4ed6\u73a9\u5bb6\u5339\u914d\u3002\u8be5\u7cfb\u7edf\u8fd8\u8003\u8651\u4e86\u5df2\u73a9\u6e38\u620f\u7684\u6570\u91cf\uff0c\u4ee5\u786e\u4fdd\u516c\u5e73\u6027\u3002\u6b65\u9aa4 1\uff1a\u901a\u8fc7\u6280\u80fd\u6c34\u5e73\u5339\u914d\u73a9\u5bb6\u3002\u6b65\u9aa4 2\uff1a\u8003\u8651\u80dc\u7387/\u8d25\u7387\u3002\u6b65\u9aa4 3\uff1a\u8003\u8651\u5df2\u73a9\u6e38\u620f\u7684\u6570\u91cf\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u53ef\u89c6\u5316\u5339\u914d\u8fc7\u7a0b\uff0c\u770b\u770b\u73a9\u5bb6\u662f\u5982\u4f55\u914d\u5bf9\u7684\u3002]"}, {"question": "\u8ff7\u4f60\u6218\u6597\u4e2d\u6709\u9690\u85cf\u7684\u5f69\u86cb\uff0c\u5982\u4f55\u627e\u5230\u5b83\u4eec\uff1f", "answer": "\u8ff7\u4f60\u6218\u6597\u5145\u6ee1\u4e86\u9690\u85cf\u7684\u5f69\u86cb\uff0c\u5956\u52b1\u63a2\u7d22\u3002\u4f8b\u5982\uff0c\u201c\u9057\u5fd8\u68ee\u6797\u201d\u5730\u56fe\u4e2d\uff0c\u7011\u5e03\u540e\u9762\u6709\u4e00\u4e2a\u9690\u85cf\u7684\u5b9d\u7bb1\uff0c\u91cc\u9762\u6709\u7a00\u6709\u7269\u54c1\u3002\u4e3a\u4e86\u627e\u5230\u5b83\uff0c\u8bf7\u7559\u610f\u73af\u5883\u4e2d\u7684\u7ec6\u5fae\u7ebf\u7d22\uff0c\u4f8b\u5982\u5f02\u5e38\u7684\u5ca9\u77f3\u6784\u9020\u3002\u6b65\u9aa4 1\uff1a\u5f7b\u5e95\u63a2\u7d22\u6240\u6709\u5730\u56fe\u533a\u57df\u3002\u6b65\u9aa4 2\uff1a\u7559\u610f\u73af\u5883\u7ebf\u7d22\u3002\u6b65\u9aa4 3\uff1a\u4e0e\u53ef\u7591\u7269\u4f53\u4e92\u52a8\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u5f69\u86cb\u60f3\u8c61\u6210\u7b49\u5f85\u88ab\u53d1\u73b0\u7684\u9690\u85cf\u5b9d\u85cf\u3002]"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684\u8ff7\u4f60\u6218\u6597 PC \u8fdb\u5ea6\u8f6c\u79fb\u5230\u79fb\u52a8\u8bbe\u5907\uff1f", "answer": "\u8981\u5c06\u4f60\u7684\u8ff7\u4f60\u6218\u6597 PC \u8fdb\u5ea6\u8f6c\u79fb\u5230\u79fb\u52a8\u8bbe\u5907\uff0c\u8bf7\u5c06\u4f60\u7684\u6e38\u620f\u8d26\u6237\u94fe\u63a5\u5230\u901a\u7528\u8d26\u6237\uff0c\u4f8b\u5982 Google Play \u6216 Apple \u6e38\u620f\u4e2d\u5fc3\u3002\u4f8b\u5982\uff0c\u5728\u4e24\u53f0\u8bbe\u5907\u4e0a\u4f7f\u7528\u76f8\u540c\u7684\u51ed\u636e\u767b\u5f55\uff0c\u4f60\u7684\u8fdb\u5ea6\u5c06\u81ea\u52a8\u540c\u6b65\u3002\u6b65\u9aa4 1\uff1a\u521b\u5efa\u4e00\u4e2a\u901a\u7528\u8d26\u6237\u3002\u6b65\u9aa4 2\uff1a\u94fe\u63a5\u4f60\u7684\u8ff7\u4f60\u6218\u6597\u8d26\u6237\u3002\u6b65\u9aa4 3\uff1a\u5728\u65b0\u8bbe\u5907\u4e0a\u767b\u5f55\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6bd4\u8f83\u8d26\u6237\u94fe\u63a5\u65b9\u6cd5\uff0c\u4ee5\u786e\u4fdd\u517c\u5bb9\u6027\u3002]"}, {"question": "\u5355\u4eba\u6a21\u5f0f\u548c\u56e2\u961f\u6a21\u5f0f\u5728\u8ff7\u4f60\u6218\u6597\u4e2d\u7684\u4e3b\u8981\u533a\u522b\u662f\u4ec0\u4e48\uff1f", "answer": "\u8ff7\u4f60\u6218\u6597\u4e2d\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u56e2\u961f\u6a21\u5f0f\u7684\u4e3b\u8981\u533a\u522b\u5728\u4e8e\u7b56\u7565\u548c\u534f\u8c03\u3002\u5728\u5355\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f60\u5b8c\u5168\u4f9d\u9760\u81ea\u5df1\u7684\u6280\u80fd\u548c\u80fd\u529b\uff0c\u800c\u5728\u56e2\u961f\u6a21\u5f0f\u4e2d\uff0c\u4f60\u5fc5\u987b\u4e0e\u961f\u53cb\u534f\u8c03\u3002\u4f8b\u5982\uff0c\u5728\u56e2\u961f\u6a21\u5f0f\u4e2d\uff0c\u4f60\u53ef\u4ee5\u4f7f\u7528\u6cbb\u7597\u5e08\u7684\u80fd\u529b\u6765\u652f\u6301\u5766\u514b\u3002\u6b65\u9aa4 1\uff1a\u5728\u5355\u4eba\u6a21\u5f0f\u4e2d\u4e13\u6ce8\u4e8e\u4e2a\u4eba\u6280\u80fd\u3002\u6b65\u9aa4 2\uff1a\u5728\u56e2\u961f\u6a21\u5f0f\u4e2d\u4e0e\u961f\u53cb\u534f\u8c03\u3002\u6b65\u9aa4 3\uff1a\u6839\u636e\u6a21\u5f0f\u8c03\u6574\u7b56\u7565\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6bd4\u8f83\u5355\u4eba\u6a21\u5f0f\u548c\u56e2\u961f\u6a21\u5f0f\u7684\u7b56\u7565\uff0c\u770b\u770b\u54ea\u79cd\u66f4\u9002\u5408\u4f60\u7684\u6e38\u620f\u98ce\u683c\u3002]"}, {"question": "\u5982\u4f55\u4f18\u5316\u6211\u7684\u8ff7\u4f60\u6218\u6597\u8bbe\u7f6e\uff0c\u4ee5\u5728\u4f4e\u7aef PC \u4e0a\u83b7\u5f97\u6700\u4f73\u6027\u80fd\uff1f", "answer": "\u8981\u4f18\u5316\u8ff7\u4f60\u6218\u6597\u4ee5\u9002\u5e94\u4f4e\u7aef PC\uff0c\u8bf7\u964d\u4f4e\u56fe\u5f62\u8bbe\u7f6e\uff0c\u4f8b\u5982\u7eb9\u7406\u8d28\u91cf\u548c\u9634\u5f71\u7ec6\u8282\u3002\u4f8b\u5982\uff0c\u5c06\u7eb9\u7406\u8d28\u91cf\u8bbe\u7f6e\u4e3a\u201c\u4f4e\u201d\uff0c\u5e76\u7981\u7528\u9634\u5f71\u3002\u6b64\u5916\uff0c\u5173\u95ed\u540e\u53f0\u5e94\u7528\u7a0b\u5e8f\uff0c\u4ee5\u91ca\u653e\u7cfb\u7edf\u8d44\u6e90\u3002\u6b65\u9aa4 1\uff1a\u964d\u4f4e\u56fe\u5f62\u8bbe\u7f6e\u3002\u6b65\u9aa4 2\uff1a\u7981\u7528\u4e0d\u5fc5\u8981\u7684\u7279\u6548\u3002\u6b65\u9aa4 3\uff1a\u5173\u95ed\u540e\u53f0\u5e94\u7528\u7a0b\u5e8f\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6bd4\u8f83\u4f18\u5316\u524d\u540e\u6027\u80fd\uff0c\u4ee5\u67e5\u770b\u6539\u8fdb\u60c5\u51b5\u3002]"}, {"question": "\u8ff7\u4f60\u6218\u6597\u4e2d\u6700\u6709\u6548\u7684\u6280\u80fd\u7ec4\u5408\u662f\u4ec0\u4e48\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u4f24\u5bb3\u8f93\u51fa\uff1f", "answer": "\u8ff7\u4f60\u6218\u6597\u4e2d\u6700\u6709\u6548\u7684\u6280\u80fd\u7ec4\u5408\uff0c\u65e8\u5728\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u4f24\u5bb3\u8f93\u51fa\uff0c\u6d89\u53ca\u5c06\u5177\u6709\u9ad8\u4f24\u5bb3\u500d\u6570\u7684\u6280\u80fd\u8fde\u63a5\u8d77\u6765\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u201c\u706b\u7403\u201d\u8ddf\u8fdb\u201c\u51b0\u9525\u201d\uff0c\u5229\u7528\u5143\u7d20\u5f31\u70b9\u3002\u6b65\u9aa4 1\uff1a\u8bc6\u522b\u9ad8\u4f24\u5bb3\u6280\u80fd\u3002\u6b65\u9aa4 2\uff1a\u5c06\u5177\u6709\u500d\u6570\u7684\u6280\u80fd\u8fde\u63a5\u8d77\u6765\u3002\u6b65\u9aa4 3\uff1a\u5229\u7528\u654c\u4eba\u5f31\u70b9\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u6280\u80fd\u7ec4\u5408\u60f3\u8c61\u6210\u4e00\u8bb0\u7ec4\u5408\u62f3\uff0c\u5176\u4e2d\u7b2c\u4e8c\u51fb\u7684\u5a01\u529b\u66f4\u5927\u3002]"}]
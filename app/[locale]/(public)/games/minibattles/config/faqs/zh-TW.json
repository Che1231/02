[{"question": "\u5982\u4f55\u5feb\u901f\u638c\u63e1\u8ff7\u4f60\u6230\u5f79\u5165\u9580\u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u638c\u63e1\u8ff7\u4f60\u6230\u5f79\u7684\u57fa\u672c\u63a7\u5236\uff0c\u8acb\u5f9e\u5f15\u5c0e\u6559\u5b78\u958b\u59cb\uff0c\u5b78\u7fd2\u79fb\u52d5\u3001\u653b\u64ca\u548c\u4f7f\u7528\u7279\u6b8a\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u4f7f\u7528 WASD \u9375\u79fb\u52d5\uff0c\u4f7f\u7528\u5de6\u9375\u653b\u64ca\u3002\u5728\u8a13\u7df4\u5834\u7df4\u7fd2\u9019\u4e9b\u63a7\u5236\uff0c\u76f4\u5230\u719f\u6089\u70ba\u6b62\u3002\u6b64\u5916\uff0c\u8acb\u719f\u6089\u80fd\u529b\u7684\u5feb\u6377\u9375\uff0c\u4f8b\u5982\u6309\u4e0b\u300cQ\u300d\u9375\u6fc0\u6d3b\u7b2c\u4e00\u500b\u7279\u6b8a\u80fd\u529b\u3002\u6b65\u9a5f1\uff1a\u5b8c\u6210\u6559\u5b78\u3002\u6b65\u9a5f2\uff1a\u5728\u8a13\u7df4\u5834\u7df4\u7fd2\u3002\u6b65\u9a5f3\uff1a\u8a18\u4f4f\u80fd\u529b\u7684\u5feb\u6377\u9375\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u63a7\u5236\u60f3\u50cf\u6210\u5b78\u7fd2\u99d5\u99db\uff1b\u5f9e\u6162\u901f\u958b\u59cb\uff0c\u9010\u6f38\u63d0\u9ad8\u901f\u5ea6\u3002]"}, {"question": "\u5728\u8ff7\u4f60\u6230\u5f79\u904a\u6232 100 \u5c0f\u6642\u5f8c\uff0c\u5982\u4f55\u5be6\u65bd\u6709\u6548\u7684\u751f\u5b58\u7b56\u7565\uff1f", "answer": "\u5728\u8ff7\u4f60\u6230\u5f79\u904a\u6232 100 \u5c0f\u6642\u5f8c\uff0c\u8acb\u5c08\u6ce8\u65bc\u5148\u9032\u7b56\u7565\uff0c\u4f8b\u5982\u4f4d\u7f6e\u3001\u6280\u80fd\u9023\u62db\u548c\u8cc7\u6e90\u7ba1\u7406\u3002\u4f8b\u5982\uff0c\u59cb\u7d42\u5c07\u81ea\u5df1\u7f6e\u65bc\u63a9\u853d\u7269\u5f8c\u9762\uff0c\u4ee5\u907f\u514d\u6575\u65b9\u706b\u529b\u3002\u5c07\u300c\u706b\u7403\u300d\u548c\u300c\u51b0\u9310\u300d\u7b49\u6280\u80fd\u7d50\u5408\u4f7f\u7528\uff0c\u4ee5\u6700\u5927\u5316\u50b7\u5bb3\u3002\u53ea\u6709\u5728\u8840\u91cf\u4f4e\u65bc 30% \u6642\u624d\u4f7f\u7528\u6cbb\u7642\u85e5\u6c34\u3002\u6b65\u9a5f1\uff1a\u59cb\u7d42\u63a1\u53d6\u6230\u7565\u4f4d\u7f6e\u3002\u6b65\u9a5f2\uff1a\u7d50\u5408\u6280\u80fd\u4ee5\u9054\u5230\u6700\u5927\u6548\u679c\u3002\u6b65\u9a5f3\uff1a\u660e\u667a\u5730\u7ba1\u7406\u8cc7\u6e90\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u6bd4\u8f03\u5728\u8840\u91cf 30% \u9084\u662f 50% \u6642\u4f7f\u7528\u6cbb\u7642\u85e5\u6c34\uff0c\u4ee5\u67e5\u770b\u54ea\u7a2e\u7b56\u7565\u80fd\u5ef6\u9577\u5b58\u6d3b\u6642\u9593\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u4e86\u89e3\u8ff7\u4f60\u6230\u5f79\u7684\u50b7\u5bb3\u8a08\u7b97\u7cfb\u7d71\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u4e86\u89e3\u8ff7\u4f60\u6230\u5f79\u7684\u50b7\u5bb3\u8a08\u7b97\u7cfb\u7d71\u5c0d\u65bc\u6700\u4f73\u5316\u60a8\u7684\u88dd\u5099\u548c\u7b56\u7565\u81f3\u95dc\u91cd\u8981\u3002\u50b7\u5bb3\u7684\u8a08\u7b97\u57fa\u65bc\u57fa\u672c\u653b\u64ca\u3001\u66b4\u64ca\u6a5f\u7387\u548c\u88dd\u7532\u7a7f\u900f\u7387\u3002\u4f8b\u5982\uff0c\u64c1\u6709 100 \u57fa\u672c\u653b\u64ca\u300120% \u66b4\u64ca\u6a5f\u7387\u548c 10 \u88dd\u7532\u7a7f\u900f\u529b\u7684\u89d2\u8272\uff0c\u5c07\u6bd4\u6c92\u6709\u9019\u4e9b\u5c6c\u6027\u7684\u89d2\u8272\u9020\u6210\u66f4\u591a\u50b7\u5bb3\u3002\u6b65\u9a5f1\uff1a\u4e86\u89e3\u60a8\u7684\u57fa\u672c\u653b\u64ca\u3002\u6b65\u9a5f2\uff1a\u8003\u616e\u66b4\u64ca\u6a5f\u7387\u3002\u6b65\u9a5f3\uff1a\u8003\u616e\u88dd\u7532\u7a7f\u900f\u7387\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6bd4\u8f03\u4e0d\u540c\u5c6c\u6027\u4e0b\u7684\u50b7\u5bb3\u8f38\u51fa\uff0c\u4ee5\u4e86\u89e3\u6bcf\u4e00\u9805\u5c6c\u6027\u7684\u5f71\u97ff\u3002]"}, {"question": "\u54ea\u4e9b\u8ff7\u4f60\u6230\u5f79\u89d2\u8272\u6700\u9069\u5408\u5718\u968a\u5408\u4f5c\uff0c\u4ee5\u53ca\u70ba\u4ec0\u9ebc\uff1f", "answer": "\u5728\u8ff7\u4f60\u6230\u5f79\u4e2d\uff0c\u50cf\u300c\u6cbb\u7642\u5e2b\u300d\u548c\u300c\u5766\u514b\u300d\u9019\u6a23\u7684\u89d2\u8272\u6700\u9069\u5408\u5718\u968a\u5408\u4f5c\uff0c\u56e0\u70ba\u5b83\u5011\u5177\u6709\u652f\u63f4\u548c\u9632\u79a6\u80fd\u529b\u3002\u6cbb\u7642\u5e2b\u53ef\u4ee5\u6062\u5fa9\u968a\u53cb\u7684\u751f\u547d\u503c\uff0c\u800c\u5766\u514b\u53ef\u4ee5\u5438\u6536\u50b7\u5bb3\u3002\u4f8b\u5982\uff0c\u5728\u5718\u968a\u6230\u9b25\u4e2d\uff0c\u6cbb\u7642\u5e2b\u53ef\u4ee5\u8b93\u5766\u514b\u6d3b\u5f97\u66f4\u4e45\uff0c\u8b93\u5718\u968a\u627f\u53d7\u66f4\u591a\u7684\u50b7\u5bb3\u3002\u6b65\u9a5f1\uff1a\u9078\u64c7\u6cbb\u7642\u5e2b\u63d0\u4f9b\u652f\u63f4\u3002\u6b65\u9a5f2\uff1a\u9078\u64c7\u5766\u514b\u4f5c\u70ba\u9632\u79a6\u3002\u6b65\u9a5f3\uff1a\u5728\u6230\u9b25\u4e2d\u5354\u8abf\u6280\u80fd\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u6cbb\u7642\u5e2b\u548c\u5766\u514b\u60f3\u50cf\u6210\u5718\u968a\u7684\u652f\u67f1\uff0c\u652f\u6490\u548c\u4fdd\u8b77\u5176\u4ed6\u6210\u54e1\u3002]"}, {"question": "\u8ff7\u4f60\u6230\u5f79\u7684\u914d\u5c0d\u7cfb\u7d71\u5982\u4f55\u78ba\u4fdd\u5e73\u8861\u7684\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u8ff7\u4f60\u6230\u5f79\u7684\u914d\u5c0d\u7cfb\u7d71\u900f\u904e\u914d\u5c0d\u5177\u6709\u76f8\u4f3c\u6280\u80fd\u7b49\u7d1a\u548c\u52dd\u7387\u7684\u73a9\u5bb6\u4f86\u78ba\u4fdd\u5e73\u8861\u7684\u904a\u6232\u9ad4\u9a57\u3002\u4f8b\u5982\uff0c\u52dd\u7387\u70ba 50% \u7684\u73a9\u5bb6\u5c07\u8207\u5176\u4ed6\u52dd\u7387\u76f8\u8fd1\u7684\u73a9\u5bb6\u914d\u5c0d\u3002\u6b64\u7cfb\u7d71\u4e5f\u6703\u8003\u616e\u5df2\u73a9\u904a\u6232\u6b21\u6578\uff0c\u4ee5\u78ba\u4fdd\u516c\u5e73\u3002\u6b65\u9a5f1\uff1a\u6839\u64da\u6280\u80fd\u7b49\u7d1a\u914d\u5c0d\u73a9\u5bb6\u3002\u6b65\u9a5f2\uff1a\u8003\u616e\u52dd\u7387\u3002\u6b65\u9a5f3\uff1a\u8003\u616e\u5df2\u73a9\u904a\u6232\u6b21\u6578\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u5c07\u914d\u5c0d\u6d41\u7a0b\u53ef\u8996\u5316\uff0c\u4ee5\u4e86\u89e3\u5982\u4f55\u70ba\u73a9\u5bb6\u914d\u5c0d\u3002]"}, {"question": "\u8ff7\u4f60\u6230\u5f79\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u5f69\u86cb\uff0c\u4ee5\u53ca\u5982\u4f55\u627e\u5230\u5b83\u5011\uff1f", "answer": "\u8ff7\u4f60\u6230\u5f79\u5145\u6eff\u4e86\u96b1\u85cf\u5f69\u86cb\uff0c\u734e\u52f5\u73a9\u5bb6\u63a2\u7d22\u3002\u4f8b\u5982\uff0c\u5728\u300c\u907a\u5fd8\u68ee\u6797\u300d\u5730\u5716\u4e2d\uff0c\u7011\u5e03\u5f8c\u9762\u6709\u4e00\u500b\u96b1\u85cf\u7684\u7bb1\u5b50\uff0c\u88e1\u9762\u5305\u542b\u7a00\u6709\u7269\u54c1\u3002\u8981\u627e\u5230\u5b83\uff0c\u8acb\u5c0b\u627e\u5fae\u5999\u7684\u74b0\u5883\u7dda\u7d22\uff0c\u4f8b\u5982\u4e0d\u5c0b\u5e38\u7684\u5730\u5f62\u3002\u6b65\u9a5f1\uff1a\u5fb9\u5e95\u63a2\u7d22\u6240\u6709\u5730\u5716\u5340\u57df\u3002\u6b65\u9a5f2\uff1a\u5c0b\u627e\u74b0\u5883\u7dda\u7d22\u3002\u6b65\u9a5f3\uff1a\u8207\u53ef\u7591\u7269\u9ad4\u4e92\u52d5\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u5f69\u86cb\u60f3\u50cf\u6210\u7b49\u5f85\u88ab\u767c\u73fe\u7684\u96b1\u85cf\u5bf6\u85cf\u3002]"}, {"question": "\u5982\u4f55\u5c07\u6211\u7684\u8ff7\u4f60\u6230\u5f79 PC \u9032\u5ea6\u8f49\u79fb\u5230\u624b\u6a5f\u5e73\u53f0\uff1f", "answer": "\u8981\u5c07\u60a8\u7684\u8ff7\u4f60\u6230\u5f79 PC \u9032\u5ea6\u8f49\u79fb\u5230\u624b\u6a5f\u5e73\u53f0\uff0c\u8acb\u5c07\u60a8\u7684\u904a\u6232\u5e33\u6236\u9023\u7d50\u5230\u901a\u7528\u5e33\u6236\uff0c\u4f8b\u5982 Google Play \u6216 Apple Game Center\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u76f8\u540c\u7684\u6191\u64da\u767b\u5165\u5169\u53f0\u88dd\u7f6e\uff0c\u60a8\u7684\u9032\u5ea6\u5c07\u6703\u81ea\u52d5\u540c\u6b65\u3002\u6b65\u9a5f1\uff1a\u5efa\u7acb\u4e00\u500b\u901a\u7528\u5e33\u6236\u3002\u6b65\u9a5f2\uff1a\u9023\u7d50\u60a8\u7684\u8ff7\u4f60\u6230\u5f79\u5e33\u6236\u3002\u6b65\u9a5f3\uff1a\u5728\u65b0\u88dd\u7f6e\u767b\u5165\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6bd4\u8f03\u5e33\u6236\u9023\u7d50\u65b9\u6cd5\uff0c\u78ba\u4fdd\u76f8\u5bb9\u6027\u3002]"}, {"question": "\u55ae\u4eba\u6a21\u5f0f\u548c\u5718\u968a\u6a21\u5f0f\u5728\u8ff7\u4f60\u6230\u5f79\u4e2d\u7684\u4e3b\u8981\u5dee\u7570\u70ba\u4f55\uff1f", "answer": "\u8ff7\u4f60\u6230\u5f79\u7684\u55ae\u4eba\u6a21\u5f0f\u548c\u5718\u968a\u6a21\u5f0f\u7684\u4e3b\u8981\u5dee\u7570\u5728\u65bc\u7b56\u7565\u548c\u5354\u8abf\u3002\u5728\u55ae\u4eba\u6a21\u5f0f\u4e2d\uff0c\u60a8\u53ea\u80fd\u4f9d\u9760\u81ea\u5df1\u7684\u6280\u80fd\u548c\u80fd\u529b\uff0c\u800c\u5728\u5718\u968a\u6a21\u5f0f\u4e2d\uff0c\u60a8\u5fc5\u9808\u8207\u968a\u53cb\u5354\u8abf\u3002\u4f8b\u5982\uff0c\u5728\u5718\u968a\u6a21\u5f0f\u4e2d\uff0c\u60a8\u53ef\u4ee5\u4f7f\u7528\u6cbb\u7642\u5e2b\u7684\u80fd\u529b\u4f86\u652f\u63f4\u5766\u514b\u3002\u6b65\u9a5f1\uff1a\u5728\u55ae\u4eba\u6a21\u5f0f\u4e2d\u5c08\u6ce8\u65bc\u500b\u4eba\u6280\u80fd\u3002\u6b65\u9a5f2\uff1a\u5728\u5718\u968a\u6a21\u5f0f\u4e2d\u8207\u968a\u53cb\u5354\u8abf\u3002\u6b65\u9a5f3\uff1a\u6839\u64da\u6a21\u5f0f\u8abf\u6574\u7b56\u7565\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u6bd4\u8f03\u55ae\u4eba\u6a21\u5f0f\u548c\u5718\u968a\u6a21\u5f0f\u7b56\u7565\uff0c\u4ee5\u4e86\u89e3\u54ea\u7a2e\u7b56\u7565\u9069\u5408\u60a8\u7684\u904a\u6232\u98a8\u683c\u3002]"}, {"question": "\u5982\u4f55\u6700\u4f73\u5316\u6211\u7684\u8ff7\u4f60\u6230\u5f79\u8a2d\u5b9a\uff0c\u4ee5\u9054\u5230\u4f4e\u7aef\u96fb\u8166\u6700\u4f73\u6548\u80fd\uff1f", "answer": "\u70ba\u4e86\u6700\u4f73\u5316\u8ff7\u4f60\u6230\u5f79\u5728\u4f4e\u7aef\u96fb\u8166\u4e0a\u7684\u6548\u80fd\uff0c\u8acb\u964d\u4f4e\u5716\u5f62\u8a2d\u5b9a\uff0c\u4f8b\u5982\u7d0b\u7406\u54c1\u8cea\u548c\u9670\u5f71\u7d30\u7bc0\u3002\u4f8b\u5982\uff0c\u5c07\u7d0b\u7406\u54c1\u8cea\u8a2d\u5b9a\u70ba\u300c\u4f4e\u300d\u4e26\u95dc\u9589\u9670\u5f71\u3002\u6b64\u5916\uff0c\u95dc\u9589\u80cc\u666f\u61c9\u7528\u7a0b\u5f0f\u4ee5\u91cb\u653e\u7cfb\u7d71\u8cc7\u6e90\u3002\u6b65\u9a5f1\uff1a\u964d\u4f4e\u5716\u5f62\u8a2d\u5b9a\u3002\u6b65\u9a5f2\uff1a\u95dc\u9589\u4e0d\u5fc5\u8981\u7684\u7279\u6548\u3002\u6b65\u9a5f3\uff1a\u95dc\u9589\u80cc\u666f\u61c9\u7528\u7a0b\u5f0f\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6bd4\u8f03\u512a\u5316\u524d\u5f8c\u7684\u6548\u80fd\uff0c\u4ee5\u4e86\u89e3\u6539\u9032\u60c5\u6cc1\u3002]"}, {"question": "\u8ff7\u4f60\u6230\u5f79\u4e2d\u54ea\u4e9b\u6280\u80fd\u9023\u62db\u6700\u6709\u6548\uff0c\u4ee5\u6700\u5927\u5316\u50b7\u5bb3\u8f38\u51fa\uff1f", "answer": "\u5728\u8ff7\u4f60\u6230\u5f79\u4e2d\uff0c\u6700\u6709\u6548\u7684\u6280\u80fd\u9023\u62db\u65e8\u5728\u5c07\u5177\u6709\u9ad8\u500d\u7387\u50b7\u5bb3\u7684\u6280\u80fd\u9023\u63a5\u8d77\u4f86\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u300c\u706b\u7403\u300d\u63a5\u8457\u300c\u51b0\u9310\u300d\uff0c\u4ee5\u5229\u7528\u6575\u4eba\u7684\u5143\u7d20\u5f31\u9ede\u3002\u6b65\u9a5f1\uff1a\u8b58\u5225\u9ad8\u50b7\u5bb3\u6280\u80fd\u3002\u6b65\u9a5f2\uff1a\u9023\u7d50\u5177\u6709\u500d\u6578\u7684\u6280\u80fd\u3002\u6b65\u9a5f3\uff1a\u5229\u7528\u6575\u4eba\u7684\u5f31\u9ede\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u6280\u80fd\u9023\u62db\u60f3\u50cf\u6210\u4e00\u64ca\u5fc5\u6bba\uff0c\u7b2c\u4e8c\u4e0b\u7684\u50b7\u5bb3\u6703\u66f4\u5f37\u3002"}]
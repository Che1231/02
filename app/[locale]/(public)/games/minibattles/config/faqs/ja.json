[{"question": "\u30df\u30cb\u30d0\u30c8\u30eb\u3067\u521d\u5fc3\u8005\u3068\u3057\u3066\u57fa\u672c\u64cd\u4f5c\u3092\u7d20\u65e9\u304f\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30df\u30cb\u30d0\u30c8\u30eb\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u79fb\u52d5\u3001\u653b\u6483\u3001\u7279\u6b8a\u80fd\u529b\u306e\u4f7f\u7528\u3092\u7d39\u4ecb\u3059\u308b\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u304b\u3089\u59cb\u3081\u307e\u3057\u3087\u3046\u3002\u305f\u3068\u3048\u3070\u3001WASD\u30ad\u30fc\u3092\u4f7f\u3063\u3066\u79fb\u52d5\u3057\u3001\u5de6\u306e\u30de\u30a6\u30b9\u30dc\u30bf\u30f3\u3067\u653b\u6483\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u64cd\u4f5c\u306b\u6163\u308c\u308b\u305f\u3081\u306b\u3001\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u30a8\u30ea\u30a2\u3067\u7df4\u7fd2\u3057\u307e\u3057\u3087\u3046\u3002\u3055\u3089\u306b\u3001\u6700\u521d\u306e\u7279\u6b8a\u80fd\u529b\u3092\u8d77\u52d5\u3059\u308b\u306b\u306f\u300cQ\u300d\u30ad\u30fc\u306a\u3069\u3001\u80fd\u529b\u306e\u30db\u30c3\u30c8\u30ad\u30fc\u3092\u899a\u3048\u308b\u3053\u3068\u3082\u91cd\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3092\u5b8c\u4e86\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u30a8\u30ea\u30a2\u3067\u7df4\u7fd2\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u80fd\u529b\u306e\u30db\u30c3\u30c8\u30ad\u30fc\u3092\u899a\u3048\u308b\u3002[\u4f8b\u3048\uff1a\u904b\u8ee2\u3092\u5b66\u3076\u306e\u3068\u540c\u69d8\u306b\u3001\u3086\u3063\u304f\u308a\u3068\u59cb\u3081\u3066\u5f90\u3005\u306b\u30b9\u30d4\u30fc\u30c9\u3092\u4e0a\u3052\u3066\u3044\u304d\u307e\u3057\u3087\u3046\u3002]"}, {"question": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u30df\u30cb\u30d0\u30c8\u30eb\u3067\u9577\u304f\u751f\u304d\u6b8b\u308b\u305f\u3081\u306e\u91cd\u8981\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30df\u30cb\u30d0\u30c8\u30eb\u3067100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u30dd\u30b8\u30b7\u30e7\u30f3\u3001\u80fd\u529b\u306e\u30b3\u30f3\u30dc\u3001\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u3068\u3044\u3063\u305f\u9ad8\u5ea6\u306a\u6226\u7565\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3057\u3087\u3046\u3002\u305f\u3068\u3048\u3070\u3001\u5e38\u306b\u6575\u306e\u653b\u6483\u3092\u9632\u3050\u305f\u3081\u306b\u30ab\u30d0\u30fc\u306e\u5f8c\u308d\u306b\u30dd\u30b8\u30b7\u30e7\u30f3\u3092\u914d\u7f6e\u3057\u307e\u3057\u3087\u3046\u3002\u6700\u5927\u9650\u306e\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u305f\u3081\u306b\u3001\u300e\u30d5\u30a1\u30a4\u30a2\u30dc\u30fc\u30eb\u300f\u3068\u300e\u30a2\u30a4\u30b9\u30b7\u30e3\u30fc\u30c9\u300f\u306a\u3069\u306e\u80fd\u529b\u3092\u7d44\u307f\u5408\u308f\u305b\u307e\u3059\u3002HP\u85ac\u306f\u3001\u4f53\u529b\u5024\u304c30%\u3092\u4e0b\u56de\u3063\u305f\u5834\u5408\u306b\u306e\u307f\u4f7f\u7528\u3057\u3066\u3001\u8ce2\u304f\u7ba1\u7406\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5e38\u306b\u6226\u7565\u7684\u306b\u30dd\u30b8\u30b7\u30e7\u30f3\u3092\u914d\u7f6e\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u80fd\u529b\u3092\u6700\u5927\u9650\u306b\u52b9\u679c\u7684\u306b\u7d44\u307f\u5408\u308f\u305b\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30ea\u30bd\u30fc\u30b9\u3092\u8ce2\u304f\u7ba1\u7406\u3059\u308b\u3002[\u6bd4\u8f03\uff1aHP\u85ac\u309230%\u306e\u4f53\u529b\u5024\u306850%\u306e\u4f53\u529b\u5024\u3092\u4f7f\u3044\u5206\u3051\u308b\u3053\u3068\u3067\u3001\u751f\u5b58\u6642\u9593\u3092\u9577\u304f\u3059\u308b\u65b9\u6cd5\u3092\u6bd4\u8f03\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002]"}, {"question": "\u30df\u30cb\u30d0\u30c8\u30eb\u3067\u30c0\u30e1\u30fc\u30b8\u8a08\u7b97\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u306a\u305c\u91cd\u8981\u3067\u3059\u304b\uff1f", "answer": "\u30df\u30cb\u30d0\u30c8\u30eb\u3067\u30c0\u30e1\u30fc\u30b8\u8a08\u7b97\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u30d3\u30eb\u30c9\u3068\u6226\u7565\u3092\u6700\u9069\u5316\u3059\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u30c0\u30e1\u30fc\u30b8\u306f\u3001\u57fa\u672c\u653b\u6483\u529b\u3001\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u7387\u3001\u30a2\u30fc\u30de\u30fc\u8cab\u901a\u306b\u57fa\u3065\u3044\u3066\u8a08\u7b97\u3055\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u57fa\u672c\u653b\u6483\u529b\u304c100\u3001\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u7387\u304c20%\u3001\u30a2\u30fc\u30de\u30fc\u8cab\u901a\u304c10\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306f\u3001\u3053\u308c\u3089\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u6301\u305f\u306a\u3044\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3088\u308a\u3082\u591a\u304f\u306e\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u57fa\u672c\u653b\u6483\u529b\u3092\u77e5\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u7387\u3092\u8003\u616e\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30a2\u30fc\u30de\u30fc\u8cab\u901a\u3092\u8003\u616e\u3059\u308b\u3002[\u69cb\u6210\u8868\uff1a\u305d\u308c\u305e\u308c\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u306e\u5f71\u97ff\u3092\u898b\u308b\u305f\u3081\u306b\u3001\u3055\u307e\u3056\u307e\u306a\u30b9\u30c6\u30fc\u30bf\u30b9\u306b\u3088\u308b\u30c0\u30e1\u30fc\u30b8\u51fa\u529b\u306e\u6bd4\u8f03\u8868\u3092\u63d0\u793a\u3057\u307e\u3057\u3087\u3046\u3002]"}, {"question": "\u30df\u30cb\u30d0\u30c8\u30eb\u3067\u30c1\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u6700\u9069\u306a\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3068\u3001\u305d\u306e\u7406\u7531\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30df\u30cb\u30d0\u30c8\u30eb\u3067\u306f\u3001\u652f\u63f4\u3068\u9632\u5fa1\u80fd\u529b\u3092\u6301\u3064\u300c\u30d2\u30fc\u30e9\u30fc\u300d\u3084\u300c\u30bf\u30f3\u30af\u300d\u306e\u3088\u3046\u306a\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u30c1\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u6700\u9069\u3067\u3059\u3002\u30d2\u30fc\u30e9\u30fc\u306f\u30c1\u30fc\u30e0\u30e1\u30a4\u30c8\u306e\u4f53\u529b\u5024\u3092\u56de\u5fa9\u3055\u305b\u3001\u30bf\u30f3\u30af\u306f\u30c0\u30e1\u30fc\u30b8\u3092\u5438\u53ce\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30c1\u30fc\u30e0\u6226\u3067\u306f\u3001\u30d2\u30fc\u30e9\u30fc\u306f\u30bf\u30f3\u30af\u3092\u3088\u308a\u9577\u304f\u751f\u5b58\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u3001\u30c1\u30fc\u30e0\u5168\u4f53\u3067\u3088\u308a\u591a\u304f\u306e\u30c0\u30e1\u30fc\u30b8\u3092\u8010\u3048\u629c\u304f\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u652f\u63f4\u306e\u305f\u3081\u306b\u30d2\u30fc\u30e9\u30fc\u3092\u9078\u3076\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u9632\u5fa1\u306e\u305f\u3081\u306b\u30bf\u30f3\u30af\u3092\u9078\u629e\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6226\u95d8\u4e2d\u306b\u80fd\u529b\u3092\u9023\u643a\u3055\u305b\u308b\u3002[\u4f8b\u3048\uff1a\u30d2\u30fc\u30e9\u30fc\u3068\u30bf\u30f3\u30af\u306f\u30c1\u30fc\u30e0\u306e\u4e2d\u6838\u3067\u3042\u308a\u3001\u4ed6\u306e\u30e1\u30f3\u30d0\u30fc\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3001\u4fdd\u8b77\u3059\u308b\u5b58\u5728\u3060\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30df\u30cb\u30d0\u30c8\u30eb\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u3069\u306e\u3088\u3046\u306b\u4fdd\u8a3c\u3057\u3066\u3044\u307e\u3059\u304b\uff1f", "answer": "\u30df\u30cb\u30d0\u30c8\u30eb\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u3068\u52dd\u6557\u7387\u3092\u8003\u616e\u3057\u3066\u3001\u985e\u4f3c\u3059\u308b\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u30da\u30a2\u30ea\u30f3\u30b0\u3059\u308b\u3053\u3068\u3067\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u52dd\u7387\u304c50%\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u307b\u307c\u540c\u3058\u52dd\u7387\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u30de\u30c3\u30c1\u30f3\u30b0\u3055\u308c\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u516c\u5e73\u6027\u3092\u78ba\u4fdd\u3059\u308b\u305f\u3081\u306b\u3001\u30d7\u30ec\u30a4\u3057\u305f\u30b2\u30fc\u30e0\u6570\u3082\u8003\u616e\u306b\u5165\u308c\u3066\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u3067\u30de\u30c3\u30c1\u30f3\u30b0\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u52dd\u6557\u7387\u3092\u8003\u616e\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30d7\u30ec\u30a4\u3057\u305f\u30b2\u30fc\u30e0\u6570\u3092\u8003\u616e\u3059\u308b\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u3069\u306e\u3088\u3046\u306b\u30da\u30a2\u30ea\u30f3\u30b0\u3055\u308c\u308b\u304b\u3092\u793a\u3059\u30de\u30c3\u30c1\u30f3\u30b0\u30d7\u30ed\u30bb\u30b9\u3092\u8996\u899a\u5316\u3057\u307e\u3057\u3087\u3046\u3002]"}, {"question": "\u30df\u30cb\u30d0\u30c8\u30eb\u306e\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3068\u306f\u4f55\u304b\u3001\u3069\u306e\u3088\u3046\u306b\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30df\u30cb\u30d0\u30c8\u30eb\u306b\u306f\u3001\u63a2\u7d22\u3092\u5831\u3044\u308b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u6570\u591a\u304f\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u5fd8\u308c\u3089\u308c\u305f\u68ee\u300d\u306e\u30de\u30c3\u30d7\u306b\u306f\u3001\u6edd\u306e\u5f8c\u308d\u306b\u96a0\u3055\u308c\u305f\u79d8\u5bc6\u306e\u5b9d\u7bb1\u304c\u3042\u308a\u3001\u30ec\u30a2\u30a2\u30a4\u30c6\u30e0\u304c\u5165\u3063\u3066\u3044\u307e\u3059\u3002\u305d\u308c\u3092\u898b\u3064\u3051\u308b\u306b\u306f\u3001\u73cd\u3057\u3044\u5ca9\u306e\u5f62\u6210\u306a\u3069\u3001\u74b0\u5883\u306e\u5fae\u5999\u306a\u624b\u304c\u304b\u308a\u3092\u63a2\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30de\u30c3\u30d7\u306e\u3059\u3079\u3066\u306e\u30a8\u30ea\u30a2\u3092\u5fb9\u5e95\u7684\u306b\u63a2\u7d22\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u74b0\u5883\u306e\u30d2\u30f3\u30c8\u3092\u898b\u3064\u3051\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u602a\u3057\u3044\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3068\u76f8\u4e92\u4f5c\u7528\u3059\u308b\u3002[\u4f8b\u3048\uff1a\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u767a\u898b\u3055\u308c\u308b\u306e\u3092\u5f85\u3063\u3066\u3044\u308b\u96a0\u3055\u308c\u305f\u5b9d\u7269\u3060\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "PC\u7248\u306e\u30df\u30cb\u30d0\u30c8\u30eb\u306e\u9032\u6357\u72b6\u6cc1\u3092\u30e2\u30d0\u30a4\u30eb\u7248\u306b\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "PC\u7248\u306e\u30df\u30cb\u30d0\u30c8\u30eb\u306e\u9032\u6357\u72b6\u6cc1\u3092\u30e2\u30d0\u30a4\u30eb\u7248\u306b\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001Google\u30d7\u30ec\u30a4\u3084Apple\u30b2\u30fc\u30e0\u30bb\u30f3\u30bf\u30fc\u306a\u3069\u306e\u6c4e\u7528\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30b2\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30ea\u30f3\u30af\u3055\u305b\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u8cc7\u683c\u60c5\u5831\u3092\u4f7f\u7528\u3057\u3066\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3068\u3001\u9032\u6357\u72b6\u6cc1\u304c\u81ea\u52d5\u7684\u306b\u540c\u671f\u3055\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6c4e\u7528\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u4f5c\u6210\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30df\u30cb\u30d0\u30c8\u30eb\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30ea\u30f3\u30af\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3002[\u69cb\u6210\u8868\uff1a\u4e92\u63db\u6027\u3092\u78ba\u4fdd\u3059\u308b\u305f\u3081\u306b\u3001\u30a2\u30ab\u30a6\u30f3\u30c8\u30ea\u30f3\u30af\u306e\u65b9\u6cd5\u3092\u6bd4\u8f03\u3057\u307e\u3057\u3087\u3046\u3002]"}, {"question": "\u30df\u30cb\u30d0\u30c8\u30eb\u306e\u30bd\u30ed\u30e2\u30fc\u30c9\u3068\u30c1\u30fc\u30e0\u30e2\u30fc\u30c9\u306e\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30df\u30cb\u30d0\u30c8\u30eb\u306e\u30bd\u30ed\u30e2\u30fc\u30c9\u3068\u30c1\u30fc\u30e0\u30e2\u30fc\u30c9\u306e\u4e3b\u306a\u9055\u3044\u306f\u3001\u6226\u7565\u3068\u9023\u643a\u306b\u3042\u308a\u307e\u3059\u3002\u30bd\u30ed\u30e2\u30fc\u30c9\u3067\u306f\u3001\u81ea\u5206\u306e\u30b9\u30ad\u30eb\u3068\u80fd\u529b\u306b\u306e\u307f\u983c\u308a\u307e\u3059\u304c\u3001\u30c1\u30fc\u30e0\u30e2\u30fc\u30c9\u3067\u306f\u30c1\u30fc\u30e0\u30e1\u30a4\u30c8\u3068\u9023\u643a\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30c1\u30fc\u30e0\u30e2\u30fc\u30c9\u3067\u306f\u3001\u30d2\u30fc\u30e9\u30fc\u306e\u80fd\u529b\u3092\u4f7f\u3063\u3066\u30bf\u30f3\u30af\u3092\u30b5\u30dd\u30fc\u30c8\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30bd\u30ed\u30e2\u30fc\u30c9\u3067\u306f\u500b\u3005\u306e\u30b9\u30ad\u30eb\u306b\u96c6\u4e2d\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30c1\u30fc\u30e0\u30e2\u30fc\u30c9\u3067\u306f\u30c1\u30fc\u30e0\u30e1\u30a4\u30c8\u3068\u9023\u643a\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30e2\u30fc\u30c9\u306b\u5408\u308f\u305b\u3066\u6226\u7565\u3092\u8abf\u6574\u3059\u308b\u3002[\u6bd4\u8f03\uff1a\u30bd\u30ed\u6226\u7565\u3068\u30c1\u30fc\u30e0\u6226\u7565\u3092\u6bd4\u8f03\u3057\u3066\u3001\u81ea\u5206\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u9069\u3057\u305f\u3082\u306e\u3092\u78ba\u8a8d\u3057\u307e\u3057\u3087\u3046\u3002]"}, {"question": "\u4f4e\u30b9\u30da\u30c3\u30afPC\u3067\u30df\u30cb\u30d0\u30c8\u30eb\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u4f4e\u30b9\u30da\u30c3\u30afPC\u3067\u30df\u30cb\u30d0\u30c8\u30eb\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u30c6\u30af\u30b9\u30c1\u30e3\u54c1\u8cea\u3084\u5f71\u306e\u8a73\u7d30\u306a\u3069\u306e\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3092\u4e0b\u3052\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30c6\u30af\u30b9\u30c1\u30e3\u54c1\u8cea\u3092\u300c\u4f4e\u300d\u306b\u8a2d\u5b9a\u3057\u3001\u5f71\u3092\u7121\u52b9\u306b\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u30a2\u30d7\u30ea\u30b1\u30fc\u30b7\u30e7\u30f3\u3092\u9589\u3058\u3001\u30b7\u30b9\u30c6\u30e0\u30ea\u30bd\u30fc\u30b9\u3092\u89e3\u653e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3092\u4e0b\u3052\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u4e0d\u8981\u306a\u52b9\u679c\u3092\u7121\u52b9\u306b\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u30a2\u30d7\u30ea\u30b1\u30fc\u30b7\u30e7\u30f3\u3092\u9589\u3058\u308b\u3002[\u69cb\u6210\u8868\uff1a\u6700\u9069\u5316\u524d\u5f8c\u3067\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6bd4\u8f03\u3057\u3066\u3001\u6539\u5584\u3092\u78ba\u8a8d\u3057\u307e\u3057\u3087\u3046\u3002]"}, {"question": "\u30df\u30cb\u30d0\u30c8\u30eb\u3067\u30c0\u30e1\u30fc\u30b8\u51fa\u529b\u3092\u6700\u5927\u5316\u3059\u308b\u4e0a\u3067\u3001\u6700\u3082\u52b9\u679c\u7684\u306a\u80fd\u529b\u306e\u30b3\u30f3\u30dc\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30df\u30cb\u30d0\u30c8\u30eb\u3067\u30c0\u30e1\u30fc\u30b8\u51fa\u529b\u3092\u6700\u5927\u5316\u3059\u308b\u6700\u3082\u52b9\u679c\u7684\u306a\u80fd\u529b\u30b3\u30f3\u30dc\u306f\u3001\u9ad8\u3044\u30c0\u30e1\u30fc\u30b8\u500d\u7387\u3092\u6301\u3064\u80fd\u529b\u3092\u9023\u9396\u3055\u305b\u308b\u3053\u3068\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u30d5\u30a1\u30a4\u30a2\u30dc\u30fc\u30eb\u300f\u306e\u5f8c\u306b\u300e\u30a2\u30a4\u30b9\u30b7\u30e3\u30fc\u30c9\u300f\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u6575\u306e\u5f31\u70b9\u3092\u5229\u7528\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u9ad8\u30c0\u30e1\u30fc\u30b8\u80fd\u529b\u3092\u7279\u5b9a\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u500d\u7387\u306e\u3042\u308b\u80fd\u529b\u3092\u9023\u9396\u3055\u305b\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6575\u306e\u5f31\u70b9\u3092\u5229\u7528\u3059\u308b\u3002[\u4f8b\u3048\uff1a\u80fd\u529b\u30b3\u30f3\u30dc\u306f\u30012\u56de\u653b\u6483\u3059\u308b\u969b\u306b\u30012\u56de\u76ee\u306e\u653b\u6483\u306e\u65b9\u304c\u3088\u308a\u5f37\u529b\u306a\u653b\u6483\u30b3\u30f3\u30dc\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}]
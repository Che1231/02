[{"question": "Bouncemasters\u65b0\u624b\u6c42\u52a9\uff1a\u5982\u4f55\u624d\u80fd\u66f4\u597d\u5730\u51fb\u6253\u4f01\u9e45\uff0c\u8ba9\u5b83\u98de\u5f97\u66f4\u8fdc\uff1f", "answer": "\u65b0\u624b\u73a9\u5bb6\u60a8\u597d\uff01\u60f3\u8981\u8ba9\u4f01\u9e45\u98de\u5f97\u66f4\u8fdc\uff0c\u5173\u952e\u5728\u4e8e\u638c\u63e1\u51fb\u6253\u65f6\u673a\u548c\u529b\u5ea6\u3002\u6700\u4f73\u51fb\u6253\u65f6\u673a\u901a\u5e38\u662f\u4f01\u9e45\u5373\u5c06\u843d\u5730\uff0c\u8eab\u4f53\u7565\u5fae\u524d\u503e\u7684\u77ac\u95f4\u3002\u6b64\u65f6\u6325\u68d2\u53ef\u4ee5\u83b7\u5f97\u6700\u5927\u7684\u63a8\u8fdb\u529b\u3002\u89c2\u5bdf\u4f01\u9e45\u7684\u98de\u884c\u8f68\u8ff9\uff0c\u9884\u6d4b\u843d\u5730\u4f4d\u7f6e\uff0c\u5e76\u5728\u4f01\u9e45\u63a5\u8fd1\u65f6\u7acb\u5373\u70b9\u51fb\u5c4f\u5e55\u3002\u529b\u5ea6\u65b9\u9762\uff0c\u7559\u610f\u529b\u5ea6\u6761\uff0c\u5c3d\u91cf\u5728\u529b\u5ea6\u6761\u8fbe\u5230\u6700\u5927\u503c\u9644\u8fd1\u65f6\u51fb\u6253\uff0c\u6700\u5927\u5316\u98de\u884c\u8ddd\u79bb\u3002\u3010\u6bd4\u55bb\u8bf4\u660e\uff1a\u60f3\u8c61\u51fb\u6253\u68d2\u7403\uff0c\u9700\u8981\u5728\u6700\u4f73\u65f6\u673a\u6325\u68d2\u624d\u80fd\u51fb\u51fa\u5168\u5792\u6253\u3011\u6e38\u620f\u521d\u671f\uff0c\u4f18\u5148\u5347\u7ea7\u7403\u68d2\u7684\u201c\u529b\u91cf\u201d\u5c5e\u6027\uff0c\u80fd\u663e\u8457\u63d0\u5347\u51fb\u6253\u6548\u679c\u3002\u4f8b\u5982\uff0c\u521d\u59cb\u7403\u68d2\u53ef\u80fd\u53ea\u80fd\u51fb\u51fa50\u7c73\u8ddd\u79bb\uff0c\u4f46\u5347\u7ea7\u51e0\u6b21\u529b\u91cf\u540e\uff0c\u5c31\u80fd\u8f7b\u677e\u7a81\u7834100\u7c73\u3002\u60a8\u4e5f\u53ef\u4ee5\u5c1d\u8bd5\u4f7f\u7528\u6e38\u620f\u5185\u7684\u52a0\u901f\u9053\u5177\u6765\u83b7\u5f97\u989d\u5916\u901f\u5ea6\u3002"}, {"question": "Why does the penguin sometimes bounce off the bat weirdly in Bouncemasters, and how can I prevent it?", "answer": "\u4f01\u9e45\u6709\u65f6\u4f1a\u5947\u602a\u5730\u5f39\u5f00\u7403\u68d2\uff0c\u4e3b\u8981\u539f\u56e0\u662f\u51b2\u51fb\u89d2\u5ea6\u548c\u65f6\u673a\u3002\u5982\u679c\u51fb\u6253\u65f6\u673a\u8fc7\u65e9\u6216\u8fc7\u665a\uff0c\u6216\u8005\u7403\u68d2\u6ca1\u6709\u5b8c\u5168\u5bf9\u51c6\uff0c\u5c31\u4f1a\u5bfc\u81f4\u5f39\u8df3\u65e0\u529b\u6216\u4e0d\u7a33\u5b9a\u3002\u4e3a\u4e86\u907f\u514d\u8fd9\u79cd\u60c5\u51b5\uff0c\u8bf7\u4e13\u6ce8\u4e8e\u51fb\u4e2d\u7403\u68d2\u7684\u6700\u4f73\u4f4d\u7f6e\uff0c\u901a\u5e38\u4f4d\u4e8e\u7403\u68d2\u4e2d\u5fc3\u3002\u6b64\u5916\uff0c\u8003\u8651\u5347\u7ea7\u7403\u68d2\u7684\u201c\u7cbe\u51c6\u5ea6\u201d\u5c5e\u6027\uff0c\u53ef\u4ee5\u964d\u4f4e\u51fb\u6253\u5931\u8bef\u7684\u6982\u7387\u3002\u5c1d\u8bd5\u4f7f\u7528\u52a0\u901f\u9053\u5177\u6765\u83b7\u5f97\u66f4\u597d\u7684\u65f6\u673a\u3002\u4f8b\u5982\uff0c\u5728\u7406\u60f3\u51fb\u6253\u4f01\u9e45\u7684\u77ac\u95f4\u6fc0\u6d3b\u52a0\u901f\u9053\u5177\uff0c\u6709\u52a9\u4e8e\u8bbe\u7f6e\u5b8c\u7f8e\u7684\u6253\u51fb\u65f6\u673a\uff0c\u63d0\u9ad8\u4e00\u81f4\u6027\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u521d\u59cb\u7403\u68d2\uff1a\u7cbe\u51c6\u5ea6\u4f4e\uff0c\u6613\u5931\u8bef\uff1b\u5347\u7ea7\u7403\u68d2\uff1a\u7cbe\u51c6\u5ea6\u9ad8\uff0c\u51fb\u6253\u7a33\u5b9a]"}, {"question": "Bouncemasters\u91d1\u5e01\u83b7\u53d6\u653b\u7565\uff1a\u9664\u4e86\u5e38\u89c4\u73a9\u6cd5\uff0c\u8fd8\u6709\u54ea\u4e9b\u9690\u85cf\u7684\u5feb\u901f\u5237\u91d1\u5e01\u65b9\u6cd5\uff1f", "answer": "\u9664\u4e86\u901a\u8fc7\u6b63\u5e38\u6e38\u620f\u83b7\u5f97\u91d1\u5e01\uff0c\u6e38\u620f\u4e2d\u8fd8\u6709\u4e00\u4e9b\u9690\u85cf\u7684\u5feb\u901f\u5237\u91d1\u5e01\u65b9\u6cd5\u3002\u4e00\u79cd\u65b9\u6cd5\u662f\u5b8c\u6210\u6bcf\u65e5\u4efb\u52a1\u548c\u6210\u5c31\uff0c\u5b83\u4eec\u53ef\u4ee5\u83b7\u5f97\u989d\u5916\u7684\u91d1\u5e01\u5956\u52b1\u3002\u53e6\u4e00\u79cd\u65b9\u6cd5\u662f\u4e0d\u5b9a\u671f\u51fa\u73b0\u7684\u89c2\u770b\u5e7f\u544a\u83b7\u5f97\u91d1\u5e01\u7684\u673a\u4f1a\u3002\u66f4\u6709\u6548\u7684\u65b9\u6cd5\u662f\u524d\u671f\u91cd\u70b9\u5347\u7ea7\u5f39\u5c04\u8ddd\u79bb\u548c\u91d1\u5e01\u6536\u76ca\u52a0\u6210\u3002\u4f18\u5148\u5347\u7ea7\u91d1\u5e01\u6536\u76ca\u52a0\u6210\uff0c\u53ef\u4ee5\u52a0\u901f\u8d22\u5bcc\u79ef\u7d2f\u3002\u6280\u5de7\u5c42\u9762\uff0c\u5c3d\u91cf\u51fb\u6253\u5b8c\u7f8e\uff0c\u53ef\u4ee5\u83b7\u5f97\u989d\u5916\u7684\u91d1\u5e01\u5956\u52b1\uff0c\u5b8c\u7f8e\u51fb\u6253\u4f01\u9e45\u4f1a\u6709\u7279\u6b8a\u97f3\u6548\u548c\u89c6\u89c9\u6548\u679c\u63d0\u793a\u3002\u3010\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u666e\u901a\u51fb\u625310\u91d1\u5e01\uff0c\u5b8c\u7f8e\u51fb\u625320\u91d1\u5e01\uff0c\u89c2\u770b\u5e7f\u544a50\u91d1\u5e01\u3011\u6b64\u5916\uff0c\u5173\u6ce8\u6e38\u620f\u5b98\u65b9\u793e\u533a\u548c\u6d3b\u52a8\uff0c\u6709\u65f6\u4f1a\u6709\u8d60\u9001\u91d1\u5e01\u7684\u6d3b\u52a8\u3002"}, {"question": "Bouncemasters\u7684\u9ad8\u7ea7\u6280\u5de7\uff1a\u5982\u4f55\u5229\u7528\u5730\u5f62\u548c\u52a8\u7269\u6765\u63d0\u9ad8\u98de\u884c\u8ddd\u79bb\uff1f", "answer": "\u8981\u5927\u5e45\u63d0\u5347\u98de\u884c\u8ddd\u79bb\uff0c\u9700\u8981\u5de7\u5999\u5229\u7528\u573a\u666f\u4e2d\u7684\u5730\u5f62\u548c\u52a8\u7269\u3002\u4f8b\u5982\uff0c\u67d0\u4e9b\u5730\u5f62\u5b58\u5728\u4e0a\u5347\u6c14\u6d41\uff0c\u8ba9\u4f01\u9e45\u83b7\u5f97\u989d\u5916\u7684\u5347\u529b\u3002\u800c\u90e8\u5206\u52a8\u7269\uff0c\u4f8b\u5982\u6d77\u9e25\uff0c\u5728\u4f01\u9e45\u649e\u51fb\u65f6\u4f1a\u63d0\u4f9b\u989d\u5916\u7684\u5f39\u5c04\u529b\u3002\u6b65\u9aa4\u4e00\uff1a\u719f\u6089\u5730\u56fe\uff0c\u8bb0\u4f4f\u5173\u952e\u5730\u5f62\u548c\u52a8\u7269\u7684\u4f4d\u7f6e\u3002\u6b65\u9aa4\u4e8c\uff1a\u5728\u98de\u884c\u8fc7\u7a0b\u4e2d\uff0c\u8c03\u6574\u98de\u884c\u65b9\u5411\uff0c\u5c3d\u91cf\u9760\u8fd1\u4e0a\u5347\u6c14\u6d41\u548c\u52a8\u7269\u7fa4\u3002\u6b65\u9aa4\u4e09\uff1a\u5229\u7528\u52a0\u901f\u9053\u5177\u8c03\u6574\u98de\u884c\u8f68\u8ff9\uff0c\u786e\u4fdd\u4f01\u9e45\u80fd\u7cbe\u786e\u649e\u51fb\u76ee\u6807\u3002\u4e00\u4e2a\u5178\u578b\u7684\u4f8b\u5b50\u662f\uff0c\u5728\u51b0\u5c71\u573a\u666f\u4e2d\uff0c\u5229\u7528\u4e0a\u5347\u6c14\u6d41\u53ef\u4ee5\u8f7b\u677e\u98de\u8dc3\u4e00\u6bb5\u5f88\u957f\u7684\u8ddd\u79bb\uff0c\u5982\u679c\u80fd\u987a\u52bf\u649e\u51fb\u6d77\u9e25\u7fa4\uff0c\u5219\u53ef\u4ee5\u83b7\u5f97\u66f4\u8fdc\u7684\u98de\u884c\u8ddd\u79bb\u3002\u3010\u6d41\u7a0b\u56fe\u89e3\uff1a\u98de\u884c\u2192\u9760\u8fd1\u6c14\u6d41/\u52a8\u7269\u2192\u52a0\u901f\u8c03\u6574\u2192\u6210\u529f\u649e\u51fb\u2192\u8ddd\u79bb\u63d0\u5347\u3011"}, {"question": "What's the deal with the different bats in Bouncemasters? Which one offers the best performance and why?", "answer": "Bouncemasters\u4e2d\u4e0d\u540c\u7684\u7403\u68d2\u5177\u6709\u4e0d\u540c\u7684\u529b\u91cf\u3001\u5f39\u8df3\u3001\u7a7a\u6c14\u52a8\u529b\u5b66\u548c\u7cbe\u51c6\u5ea6\u5c5e\u6027\u3002\u6700\u4f73\u7403\u68d2\u53d6\u51b3\u4e8e\u4f60\u7684\u6e38\u620f\u98ce\u683c\u548c\u76ee\u6807\u3002\u521d\u671f\uff0c\u4f18\u5148\u9009\u62e9\u529b\u91cf\u5c5e\u6027\u9ad8\u7684\u7403\u68d2\u4ee5\u6700\u5927\u5316\u8ddd\u79bb\u3002\u540e\u671f\uff0c\u7cbe\u51c6\u5ea6\u53d8\u5f97\u66f4\u91cd\u8981\uff0c\u4ee5\u4fbf\u4e8e\u7a33\u5b9a\u51fb\u6253\u548c\u8fde\u51fb\u3002\u7403\u68d2\u5c5e\u6027\u901a\u8fc7\u4e0e\u5f53\u524d\u88c5\u5907\u7684\u7403\u68d2\u5bf9\u6bd4\u663e\u793a\u3002\u6bd4\u8f83\u53ef\u7528\u7684\u7403\u68d2\uff0c\u7136\u540e\u76f8\u5e94\u9009\u62e9\u6240\u9700\u7684\u7403\u68d2\u3002\u91cd\u8981\u7684\u662f\u4fdd\u6301\u4e0e\u6700\u7ec8\u76ee\u6807\u76f8\u7b26\u7684\u7403\u68d2\u3002\u4f8b\u5982\uff0c\u201c\u96f7\u9706\u68d2\u201d\u7403\u68d2\u5728\u51fb\u4e2d\u4f01\u9e45\u65f6\u9020\u6210\u7684\u4f24\u5bb3\u66f4\u5927\uff0c\u5e76\u63d0\u4f9b\u989d\u5916\u7684\u8ddd\u79bb\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u7403\u68d2\u7c7b\u578b - \u5c5e\u6027\u91cd\u70b9 - \u9002\u7528\u573a\u666f]"}, {"question": "Bouncemasters\u6570\u636e\u7814\u7a76\uff1a\u5f71\u54cd\u4f01\u9e45\u98de\u884c\u8ddd\u79bb\u7684\u5173\u952e\u53c2\u6570\u6709\u54ea\u4e9b\uff1f\u5982\u4f55\u4f18\u5316\u8fd9\u4e9b\u53c2\u6570\uff1f", "answer": "\u5f71\u54cd\u4f01\u9e45\u98de\u884c\u8ddd\u79bb\u7684\u5173\u952e\u53c2\u6570\u4e3b\u8981\u5305\u62ec\uff1a\u7403\u68d2\u7684\u529b\u91cf\u5c5e\u6027\u3001\u51fb\u6253\u529b\u5ea6\u3001\u4f01\u9e45\u7684\u521d\u59cb\u901f\u5ea6\u3001\u98de\u884c\u8fc7\u7a0b\u4e2d\u7684\u7a7a\u6c14\u963b\u529b\uff0c\u4ee5\u53ca\u5730\u5f62\u548c\u52a8\u7269\u7684\u5f71\u54cd\u3002\u63d0\u5347\u7403\u68d2\u7684\u529b\u91cf\u5c5e\u6027\u662f\u57fa\u7840\uff0c\u4f7f\u7528\u5177\u6709\u66f4\u9ad8\u529b\u91cf\u5c5e\u6027\u548c\u66f4\u597d\u7a7a\u6c14\u529b\u5b66\u7684\u7403\u68d2\u53ef\u4ee5\u8f7b\u677e\u63d0\u9ad8\u98de\u884c\u901f\u5ea6\u3002\u51fb\u6253\u529b\u5ea6\u9700\u8981\u7cbe\u786e\u638c\u63e1\uff0c\u5c3d\u91cf\u5728\u8fdb\u5ea6\u6761\u8fbe\u5230\u6700\u5927\u503c\u65f6\u51fa\u624b\u3002\u6b64\u5916\uff0c\u4f01\u9e45\u7684\u521d\u59cb\u901f\u5ea6\u4e5f\u5f88\u91cd\u8981\uff0c\u53ef\u4ee5\u901a\u8fc7\u5347\u7ea7\u4f01\u9e45\u7684\u52a0\u901f\u5c5e\u6027\u6765\u63d0\u5347\u3002\u5728\u98de\u884c\u8fc7\u7a0b\u4e2d\uff0c\u5c3d\u91cf\u5229\u7528\u5730\u5f62\u548c\u52a8\u7269\u6765\u51cf\u5c11\u7a7a\u6c14\u963b\u529b\uff0c\u83b7\u5f97\u989d\u5916\u7684\u63a8\u8fdb\u529b\u3002\u4f18\u5316\u8fd9\u4e9b\u53c2\u6570\u9700\u8981\u7efc\u5408\u8003\u8651\uff0c\u4e0d\u80fd\u53ea\u5173\u6ce8\u67d0\u4e00\u65b9\u9762\uff0c\u9700\u8981\u627e\u5230\u5e73\u8861\u70b9\u3002\u3010\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c31\u50cf\u7ec4\u88c5\u8d5b\u8f66\uff0c\u9700\u8981\u5e73\u8861\u5f15\u64ce\u3001\u5e95\u76d8\u3001\u8f6e\u80ce\u7b49\u5404\u4e2a\u90e8\u4ef6\u7684\u6027\u80fd\u3011"}, {"question": "Bouncemasters\u7684\u6210\u5c31\u7cfb\u7edf\u6df1\u5ea6\u89e3\u6790\uff1a\u54ea\u4e9b\u6210\u5c31\u6700\u96be\u8fbe\u6210\uff1f\u8fbe\u6210\u8fd9\u4e9b\u6210\u5c31\u6709\u4ec0\u4e48\u6280\u5de7\uff1f", "answer": "Bouncemasters\u7684\u6210\u5c31\u7cfb\u7edf\u5305\u542b\u5404\u79cd\u6311\u6218\uff0c\u5176\u4e2d\u4e00\u4e9b\u6210\u5c31\u96be\u5ea6\u8f83\u9ad8\uff0c\u9700\u8981\u4e00\u5b9a\u7684\u6280\u5de7\u548c\u8010\u5fc3\u624d\u80fd\u8fbe\u6210\u3002\u4f8b\u5982\uff0c\u201c\u4e00\u6746\u5230\u5e95\u201d\u6210\u5c31\u8981\u6c42\u73a9\u5bb6\u4e00\u6b21\u98de\u884c\u8fbe\u5230\u975e\u5e38\u8fdc\u7684\u8ddd\u79bb\uff0c\u9700\u8981\u5bf9\u7403\u68d2\u548c\u4f01\u9e45\u7684\u5c5e\u6027\u8fdb\u884c\u6781\u81f4\u4f18\u5316\uff0c\u5e76\u5de7\u5999\u5229\u7528\u5730\u5f62\u548c\u52a8\u7269\u3002\u8fbe\u6210\u6280\u5de7\uff1a\u2460\u9009\u62e9\u5408\u9002\u7684\u7403\u68d2\uff0c\u4f18\u5148\u8003\u8651\u529b\u91cf\u548c\u7cbe\u51c6\u5c5e\u6027\u3002\u2461\u5347\u7ea7\u4f01\u9e45\u7684\u52a0\u901f\u5c5e\u6027\uff0c\u63d0\u5347\u521d\u59cb\u901f\u5ea6\u3002\u2462\u719f\u6089\u5730\u56fe\uff0c\u627e\u5230\u5408\u9002\u7684\u4e0a\u5347\u6c14\u6d41\u548c\u52a8\u7269\u7fa4\u3002\u2463\u4f7f\u7528\u52a0\u901f\u9053\u5177\uff0c\u8c03\u6574\u98de\u884c\u8f68\u8ff9\uff0c\u786e\u4fdd\u4f01\u9e45\u80fd\u7cbe\u786e\u649e\u51fb\u76ee\u6807\u3002\u201c\u65e0\u4f24\u901a\u8fc7\u201d\u6210\u5c31\u8981\u6c42\u73a9\u5bb6\u5728\u4e0d\u649e\u51fb\u4efb\u4f55\u969c\u788d\u7269\u7684\u60c5\u51b5\u4e0b\u5b8c\u6210\u98de\u884c\uff0c\u9700\u8981\u5bf9\u64cd\u4f5c\u6709\u6781\u9ad8\u7684\u8981\u6c42\uff0c\u5efa\u8bae\u5728\u7ec3\u4e60\u6a21\u5f0f\u4e2d\u53cd\u590d\u7ec3\u4e60\uff0c\u719f\u7ec3\u638c\u63e1\u98de\u884c\u8f68\u8ff9\u7684\u63a7\u5236\u3002\u3010\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u666e\u901a\u6a21\u5f0f\u96be\u5ea6\u9ad8\uff0c\u7ec3\u4e60\u6a21\u5f0f\u53ef\u53cd\u590d\u5c1d\u8bd5\uff0c\u9053\u5177\u8f85\u52a9\u964d\u4f4e\u96be\u5ea6\u3011"}, {"question": "What is the underlying mechanic behind the penguin's speed in Bouncemasters? Are there any hidden tricks to manipulate the speed?", "answer": "\u4f01\u9e45\u901f\u5ea6\u7684\u673a\u5236\u6d89\u53ca\u5230\u521d\u59cb\u53d1\u5c04\u901f\u5ea6\uff08\u7531\u7403\u68d2\u529b\u91cf\u548c\u4f01\u9e45\u5c5e\u6027\u51b3\u5b9a\uff09\uff0c\u5916\u90e8\u5f71\u54cd\uff08\u4f8b\u5982\u52a8\u7269\u548c\u98ce\u5411\uff09\u4ee5\u53ca\u7a7a\u6c14\u963b\u529b\u3002\u8981\u64cd\u63a7\u901f\u5ea6\uff0c\u91cd\u70b9\u662f\u5347\u7ea7\u7403\u68d2\u7684\u529b\u91cf\u548c\u4f01\u9e45\u7684\u521d\u59cb\u901f\u5ea6\u3002\u6b64\u5916\uff0c\u5b66\u4e60\u5730\u5f62\u4ee5\u5229\u7528\u4e0a\u5347\u6c14\u6d41\u548c\u53cd\u5f39\u52a8\u7269\u3002\u4e00\u4e9b\u73a9\u5bb6\u53d1\u73b0\uff0c\u5c06\u52a0\u901f\u4e0e\u73af\u5883\u5143\u7d20\u5bf9\u9f50\u4ee5\u83b7\u5f97\u6700\u5927\u901f\u5ea6\uff0c\u53ef\u4ee5\u6709\u6548\u5730\u63d0\u9ad8\u901f\u5ea6\u3002\u5c3d\u7ba1\u6ca1\u6709\u5bb9\u6613\u5229\u7528\u7684\u201c\u9690\u85cf\u6280\u5de7\u201d\u6216\u201c\u6f0f\u6d1e\u201d\uff0c\u4f46\u719f\u7ec3\u7684\u5730\u5f62\u5229\u7528\u548c\u9053\u5177\u6fc0\u6d3b\u4ecd\u7136\u5f88\u91cd\u8981\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u521d\u59cb\u901f\u5ea6 - \u57fa\u7840\u901f\u5ea6\uff1b\u5916\u90e8\u56e0\u7d20 - \u52a0\u901f\u5ea6/\u51cf\u901f\u5ea6\uff1b\u6700\u7ec8\u901f\u5ea6 - \u8ddd\u79bb]"}, {"question": "Bouncemasters\u8de8\u5e73\u53f0\u7591\u95ee\uff1a\u5b89\u5353\u548ciOS\u5e73\u53f0\u7684\u6570\u636e\u53ef\u4ee5\u4e92\u901a\u5417\uff1f\u5982\u679c\u53ef\u4ee5\uff0c\u5982\u4f55\u64cd\u4f5c\uff1f", "answer": "\u5f88\u9057\u61be\uff0c\u76ee\u524dBouncemasters\u5b89\u5353\u548ciOS\u5e73\u53f0\u7684\u6570\u636e\u901a\u5e38\u662f\u4e0d\u4e92\u901a\u7684\u3002\u8fd9\u610f\u5473\u7740\u4f60\u5728\u5b89\u5353\u8bbe\u5907\u4e0a\u7684\u6e38\u620f\u8fdb\u5ea6\u65e0\u6cd5\u76f4\u63a5\u8f6c\u79fb\u5230iOS\u8bbe\u5907\u4e0a\uff0c\u53cd\u4e4b\u4ea6\u7136\u3002\u4e0d\u8fc7\uff0c\u6709\u4e9b\u6e38\u620f\u4f1a\u63d0\u4f9b\u8d26\u53f7\u7ed1\u5b9a\u529f\u80fd\uff0c\u4f8b\u5982\u901a\u8fc7Facebook\u6216Google Play\u8d26\u53f7\u3002\u5982\u679cBouncemasters\u652f\u6301\u6b64\u7c7b\u529f\u80fd\uff0c\u4f60\u53ef\u4ee5\u5c1d\u8bd5\u7ed1\u5b9a\u8d26\u53f7\uff0c\u770b\u770b\u662f\u5426\u80fd\u591f\u540c\u6b65\u6570\u636e\u3002\u5982\u679c\u6e38\u620f\u652f\u6301\u4e91\u5b58\u6863\u529f\u80fd\uff0c\u5207\u6362\u5e73\u53f0\u540e\u91cd\u65b0\u767b\u5f55\u8d26\u53f7\u4f1a\u8be2\u95ee\u662f\u5426\u4ece\u4e91\u7aef\u52a0\u8f7d\u5b58\u6863\u8986\u76d6\u672c\u5730\u5b58\u6863\uff0c\u4ece\u800c\u8fbe\u5230\u5e73\u53f0\u4e92\u901a\u7684\u76ee\u7684\u3002\u8bf7\u52a1\u5fc5\u67e5\u770b\u6e38\u620f\u5b98\u65b9\u5e38\u89c1\u95ee\u9898\u89e3\u7b54\u6216\u8054\u7cfb\u5ba2\u670d\uff0c\u83b7\u53d6\u6700\u51c6\u786e\u7684\u8de8\u5e73\u53f0\u6570\u636e\u540c\u6b65\u4fe1\u606f\u3002\u3010\u53cb\u60c5\u63d0\u793a\uff1a\u5728\u64cd\u4f5c\u524d\u52a1\u5fc5\u5907\u4efd\u672c\u5730\u5b58\u6863\uff0c\u4ee5\u9632\u4e07\u4e00\u3011"}, {"question": "Bouncemasters\u5f69\u86cb\u6316\u6398\uff1a\u6e38\u620f\u4e2d\u662f\u5426\u5b58\u5728\u9690\u85cf\u7684\u4f01\u9e45\u89d2\u8272\u6216\u7279\u6b8a\u5173\u5361\uff1f\u5982\u4f55\u89e6\u53d1\u8fd9\u4e9b\u9690\u85cf\u5185\u5bb9\uff1f", "answer": "Bouncemasters\u786e\u5b9e\u5b58\u5728\u4e00\u4e9b\u9690\u85cf\u7684\u4f01\u9e45\u89d2\u8272\u548c\u7279\u6b8a\u5173\u5361\uff0c\u4f46\u89e6\u53d1\u6761\u4ef6\u5f80\u5f80\u6bd4\u8f83\u9690\u853d\u3002\u4e00\u79cd\u53ef\u80fd\u6027\u662f\u901a\u8fc7\u8fbe\u6210\u7279\u5b9a\u6210\u5c31\u6216\u5b8c\u6210\u67d0\u4e9b\u9690\u85cf\u4efb\u52a1\u6765\u89e3\u9501\u65b0\u7684\u4f01\u9e45\u89d2\u8272\u3002\u53e6\u4e00\u79cd\u53ef\u80fd\u6027\u662f\u5728\u6e38\u620f\u7684\u7279\u5b9a\u573a\u666f\u4e2d\uff0c\u6309\u7167\u7279\u5b9a\u7684\u987a\u5e8f\u6216\u65b9\u5f0f\u64cd\u4f5c\u624d\u80fd\u89e6\u53d1\u9690\u85cf\u5173\u5361\u3002\u4f8b\u5982\uff0c\u53cd\u590d\u70b9\u51fb\u67d0\u4e2a\u7279\u5b9a\u7684NPC\uff0c\u6216\u8005\u5728\u7279\u5b9a\u7684\u65f6\u95f4\u6bb5\u5185\u8fde\u7eed\u5b8c\u6210\u591a\u4e2a\u4efb\u52a1\u3002\u7531\u4e8e\u5b98\u65b9\u901a\u5e38\u4e0d\u4f1a\u516c\u5f00\u8fd9\u4e9b\u9690\u85cf\u5185\u5bb9\u7684\u5177\u4f53\u89e6\u53d1\u65b9\u5f0f\uff0c\u9700\u8981\u73a9\u5bb6\u4eec\u81ea\u884c\u63a2\u7d22\u548c\u5c1d\u8bd5\u3002\u53ef\u4ee5\u5173\u6ce8\u6e38\u620f\u793e\u533a\uff0c\u4e0e\u5176\u4ed6\u73a9\u5bb6\u4ea4\u6d41\u5fc3\u5f97\uff0c\u6216\u8bb8\u80fd\u627e\u5230\u4e00\u4e9b\u7ebf\u7d22\u3002\u6839\u636e\u4ee5\u5f80\u7ecf\u9a8c\uff0c\u8282\u5047\u65e5\u671f\u95f4\uff0c\u5b98\u65b9\u53ef\u80fd\u4f1a\u63a8\u51fa\u9650\u65f6\u6d3b\u52a8\uff0c\u5176\u4e2d\u5305\u542b\u65b0\u7684\u89d2\u8272\u548c\u5173\u5361\u3002\u3010\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c31\u50cf\u5bfb\u5b9d\u6e38\u620f\uff0c\u9700\u8981\u8010\u5fc3\u548c\u7ec6\u81f4\u7684\u89c2\u5bdf\u624d\u80fd\u627e\u5230\u5b9d\u85cf\u3011"}]
[{"question": "\u5982\u4f55\u63a7\u5236\u65b0\u624b\u5728\u53cd\u5f39\u5927\u5e08\u6e38\u620f\u4e2d\u7403\u7684\u8f68\u8ff9\uff1f", "answer": "\u8981\u5728\u53cd\u5f39\u5927\u5e08\u4e2d\u63a7\u5236\u7403\u7684\u8f68\u8ff9\uff0c\u9996\u5148\u8981\u4e86\u89e3\u57fa\u672c\u673a\u5236\u3002\u5f53\u4f60\u70b9\u51fb\u5c4f\u5e55\u65f6\uff0c\u7403\u4f1a\u6cbf\u7740\u4f60\u70b9\u51fb\u7684\u65b9\u5411\u53cd\u5f39\u3002\u4f8b\u5982\uff0c\u5728\u7403\u7684\u53f3\u4fa7\u8f7b\u89e6\u4e00\u4e0b\uff0c\u4f1a\u4f7f\u7403\u4ee5\u5bf9\u89d2\u7ebf\u65b9\u5f0f\u5411\u53f3\u53cd\u5f39\u3002\u5728\u65e9\u671f\u5173\u5361\u7ec3\u4e60\uff0c\u53ef\u4ee5\u66f4\u597d\u5730\u638c\u63e1\u65f6\u673a\u548c\u89d2\u5ea6\u3002\u6b64\u5916\uff0c\u5229\u7528\u73af\u5883\u4f18\u52bf\uff1b\u53cd\u5f39\u5899\u58c1\u53ef\u4ee5\u5e2e\u52a9\u6539\u53d8\u7403\u7684\u65b9\u5411\u3002\u8bb0\u4f4f\uff0c\u5173\u952e\u662f\u8981\u9884\u4f30\u7403\u7684\u843d\u5730\u4f4d\u7f6e\uff0c\u5e76\u76f8\u5e94\u5730\u8ba1\u5212\u4e0b\u4e00\u6b65\u52a8\u4f5c\u3002"}, {"question": "\u5728\u73a9\u53cd\u5f39\u5927\u5e08100\u5c0f\u65f6\u540e\uff0c\u54ea\u4e9b\u7b56\u7565\u6700\u9002\u5408\u83b7\u5f97\u9ad8\u5206\uff1f", "answer": "\u5728\u957f\u65f6\u95f4\u73a9\u53cd\u5f39\u5927\u5e08\u540e\u60f3\u83b7\u5f97\u9ad8\u5206\uff0c\u9700\u8981\u638c\u63e1\u9ad8\u7ea7\u7b56\u7565\u3002\u6b65\u9aa4\u4e00\uff1a\u4e13\u6ce8\u4e8e\u8fde\u9501\u53cd\u5e94\uff0c\u5feb\u901f\u51fb\u4e2d\u591a\u4e2a\u76ee\u6807\u3002\u6b65\u9aa4\u4e8c\uff1a\u5229\u7528\u9053\u5177\uff0c\u4f8b\u5982\u201c\u78c1\u94c1\u201d\u5438\u5f15\u786c\u5e01\uff0c\u201c\u65f6\u95f4\u6682\u505c\u201d\u51cf\u7f13\u969c\u788d\u7269\u901f\u5ea6\u3002\u6b65\u9aa4\u4e09\uff1a\u4e3a\u4e86\u7cbe\u786e\u5ea6\uff0c\u8ba1\u7b97\u7403\u7684\u8f68\u8ff9\uff0c\u51fb\u4e2d\u96be\u4ee5\u89e6\u53ca\u7684\u76ee\u6807\u3002\u4f8b\u5982\uff0c\u572845\u7ea7\uff0c\u8ba9\u7403\u53cd\u5f39\u5230\u79fb\u52a8\u5e73\u53f0\u4e0a\u53ef\u4ee5\u5e2e\u52a9\u4f60\u6536\u96c6\u9690\u85cf\u7684\u786c\u5e01\u7fa4\u3002\u65f6\u523b\u5173\u6ce8\u5206\u6570\u500d\u7387\uff0c\u5e76\u5c3d\u91cf\u4fdd\u6301\u5c3d\u53ef\u80fd\u957f\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u53cd\u5f39\u5927\u5e08\u4e2d\u7684\u7403\u6709\u65f6\u4f1a\u8868\u73b0\u51fa\u4e0d\u53ef\u9884\u6d4b\u7684\u884c\u4e3a\uff1f", "answer": "\u53cd\u5f39\u5927\u5e08\u4e2d\u7403\u7684\u884c\u4e3a\u4f3c\u4e4e\u96be\u4ee5\u9884\u6d4b\uff0c\u539f\u56e0\u662f\u591a\u65b9\u9762\u7684\u3002\u9996\u5148\uff0c\u6e38\u620f\u7ed3\u5408\u4e86\u57fa\u4e8e\u7269\u7406\u5b66\u7684\u673a\u5236\uff0c\u8fd9\u610f\u5473\u7740\u7403\u7684\u8f68\u8ff9\u53d7\u73b0\u5b9e\u4e16\u754c\u7269\u7406\u89c4\u5f8b\uff08\u5982\u91cd\u529b\u548c\u52a8\u91cf\uff09\u7684\u5f71\u54cd\u3002\u5176\u6b21\uff0c\u73af\u5883\u56e0\u7d20\uff0c\u4f8b\u5982\u79fb\u52a8\u5e73\u53f0\u6216\u98ce\uff0c\u53ef\u80fd\u4f1a\u6539\u53d8\u7403\u7684\u8def\u5f84\u3002\u4f8b\u5982\uff0c\u572830\u7ea7\uff0c\u4e00\u9635\u7a81\u88ad\u7684\u98ce\u53ef\u80fd\u4f1a\u5c06\u7403\u63a8\u79bb\u65b9\u5411\u3002\u6700\u540e\uff0c\u50cf\u201c\u5f39\u8df3\u7403\u201d\u8fd9\u6837\u7684\u9053\u5177\u4f1a\u6682\u65f6\u6539\u53d8\u7403\u7684\u5c5e\u6027\uff0c\u4f7f\u5176\u8868\u73b0\u51fa\u4e0d\u540c\u7684\u884c\u4e3a\u3002\u4e86\u89e3\u8fd9\u4e9b\u56e0\u7d20\u53ef\u4ee5\u5e2e\u52a9\u4f60\u66f4\u597d\u5730\u9884\u6d4b\u548c\u63a7\u5236\u7403\u7684\u79fb\u52a8\u3002"}, {"question": "\u5bf9\u4e8e\u9ad8\u7ea7\u73a9\u5bb6\u6765\u8bf4\uff0c\u53cd\u5f39\u5927\u5e08\u4e2d\u6700\u6709\u6548\u7684\u9053\u5177\u6709\u54ea\u4e9b\uff1f", "answer": "\u5bf9\u4e8e\u53cd\u5f39\u5927\u5e08\u7684\u9ad8\u7ea7\u73a9\u5bb6\u800c\u8a00\uff0c\u6700\u6709\u6548\u7684\u9053\u5177\u662f\u90a3\u4e9b\u80fd\u589e\u5f3a\u63a7\u5236\u529b\u548c\u5f97\u5206\u6f5c\u529b\u7684\u9053\u5177\u3002\u201c\u78c1\u94c1\u201d\u5bf9\u4e8e\u6536\u96c6\u786c\u5e01\u975e\u5e38\u6709\u7528\uff0c\u201c\u65f6\u95f4\u6682\u505c\u201d\u53ef\u4ee5\u5e2e\u52a9\u5e94\u5bf9\u68d8\u624b\u7684\u969c\u788d\u3002\u201c\u5f39\u8df3\u7403\u201d\u9053\u5177\u589e\u52a0\u4e86\u7403\u7684\u5f39\u6027\uff0c\u5141\u8bb8\u66f4\u957f\u65f6\u95f4\u548c\u66f4\u7cbe\u786e\u7684\u53cd\u5f39\u3002\u4f8b\u5982\uff0c\u572850\u7ea7\uff0c\u4f7f\u7528\u201c\u5f39\u8df3\u7403\u201d\u53ef\u4ee5\u5e2e\u52a9\u4f60\u5230\u8fbe\u9ad8\u7a7a\u786c\u5e01\u7fa4\u3002\u59cb\u7ec8\u4f18\u5148\u8003\u8651\u4e0e\u5f53\u524d\u76ee\u6807\u76f8\u7b26\u7684\u9053\u5177\uff0c\u65e0\u8bba\u662f\u5f97\u5206\u8fd8\u662f\u5feb\u901f\u5b8c\u6210\u5173\u5361\u3002"}, {"question": "\u53cd\u5f39\u5927\u5e08\u7684\u5206\u6570\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u5982\u4f55\u6700\u5927\u5316\u6211\u7684\u5206\u6570\uff1f", "answer": "\u53cd\u5f39\u5927\u5e08\u7684\u5206\u6570\u7cfb\u7edf\u57fa\u4e8e\u591a\u79cd\u56e0\u7d20\uff0c\u5305\u62ec\u6536\u96c6\u786c\u5e01\u3001\u51fb\u4e2d\u76ee\u6807\u548c\u8fde\u9501\u53cd\u5e94\u3002\u6536\u96c6\u7684\u6bcf\u4e2a\u786c\u5e01\u90fd\u4f1a\u589e\u52a0\u4f60\u7684\u5206\u6570\uff0c\u800c\u5feb\u901f\u51fb\u4e2d\u76ee\u6807\u4f1a\u589e\u52a0\u4f60\u7684\u5206\u6570\u500d\u7387\u3002\u4f8b\u5982\uff0c\u8fde\u7eed\u51fb\u4e2d\u4e09\u4e2a\u76ee\u6807\u53ef\u4ee5\u4f7f\u4f60\u7684\u5206\u6570\u5728\u77ed\u65f6\u95f4\u5185\u7ffb\u500d\u3002\u4e3a\u4e86\u6700\u5927\u5316\u5206\u6570\uff0c\u4e13\u6ce8\u4e8e\u4fdd\u6301\u500d\u7387\uff0c\u4e0d\u65ad\u51fb\u4e2d\u76ee\u6807\u5e76\u6536\u96c6\u786c\u5e01\u3002\u6b64\u5916\uff0c\u5bfb\u627e\u9690\u85cf\u7684\u786c\u5e01\u7fa4\uff0c\u5e76\u4f7f\u7528\u50cf\u201c\u78c1\u94c1\u201d\u4e4b\u7c7b\u7684\u9053\u5177\u6765\u6709\u6548\u5730\u6536\u96c6\u66f4\u591a\u786c\u5e01\u3002"}, {"question": "\u79fb\u52a8\u5e73\u53f0\u548cPC\u5e73\u53f0\u4e0a\u7684\u53cd\u5f39\u5927\u5e08\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u79fb\u52a8\u5e73\u53f0\u548cPC\u5e73\u53f0\u4e0a\u7684\u53cd\u5f39\u5927\u5e08\u7684\u5173\u952e\u533a\u522b\u5728\u4e8e\u63a7\u5236\u65b9\u5f0f\u548c\u663e\u793a\u9009\u9879\u3002\u5728\u79fb\u52a8\u5e73\u53f0\u4e0a\uff0c\u6e38\u620f\u901a\u8fc7\u89e6\u63a7\u63a7\u5236\uff0c\u65b9\u4fbf\u5feb\u901f\u70b9\u51fb\u3002\u5728PC\u4e0a\uff0c\u6e38\u620f\u53ef\u80fd\u4f7f\u7528\u9f20\u6807\u6216\u952e\u76d8\uff0c\u53ef\u4ee5\u63d0\u4f9b\u66f4\u7cbe\u786e\u7684\u63a7\u5236\uff0c\u4f46\u53ef\u80fd\u611f\u89c9\u4e0d\u592a\u81ea\u7136\u3002\u4f8b\u5982\uff0c\u5728\u79fb\u52a8\u5e73\u53f0\u4e0a\uff0c\u6ed1\u52a8\u5c4f\u5e55\u53ef\u4ee5\u8c03\u6574\u6444\u50cf\u673a\u89d2\u5ea6\uff0c\u800c\u5728PC\u4e0a\uff0c\u8fd9\u53ef\u80fd\u4f7f\u7528\u9f20\u6807\u6eda\u8f6e\u3002\u6b64\u5916\uff0cPC\u7248\u672c\u53ef\u80fd\u652f\u6301\u66f4\u9ad8\u7684\u5206\u8fa8\u7387\u548c\u53ef\u5b9a\u5236\u7684\u63a7\u4ef6\uff0c\u4ee5\u589e\u5f3a\u6574\u4f53\u4f53\u9a8c\u3002"}, {"question": "\u5982\u4f55\u5728\u53cd\u5f39\u5927\u5e08\u4e2d\u89e3\u9501\u9690\u85cf\u5173\u5361\uff1f", "answer": "\u5728\u53cd\u5f39\u5927\u5e08\u4e2d\u89e3\u9501\u9690\u85cf\u5173\u5361\u9700\u8981\u6ee1\u8db3\u7279\u5b9a\u7684\u6e38\u620f\u6761\u4ef6\u3002\u4f8b\u5982\uff0c\u5728\u4e00\u4e2a\u7279\u5b9a\u5173\u5361\u4e2d\u6536\u96c6\u6240\u6709\u786c\u5e01\u6216\u83b7\u5f97\u9ad8\u5206\u53ef\u80fd\u4f1a\u89e6\u53d1\u9690\u85cf\u5173\u5361\u7684\u51fa\u73b0\u3002\u4f8b\u5982\uff0c\u572820\u7ea7\uff0c\u6536\u96c6\u6240\u6709\u786c\u5e01\u5e76\u51fb\u4e2d\u6240\u6709\u76ee\u6807\u53ef\u4ee5\u89e3\u9501\u4e00\u4e2a\u79d8\u5bc6\u7684\u989d\u5916\u5173\u5361\u3002\u7559\u610f\u73af\u5883\u4e2d\u7684\u7ec6\u5fae\u6697\u793a\uff0c\u4f8b\u5982\u4e0d\u5bfb\u5e38\u7684\u56fe\u6848\u6216\u9690\u85cf\u8def\u5f84\u3002\u6b64\u5916\uff0c\u5b8c\u6210\u67d0\u4e9b\u6210\u5c31\u4e5f\u80fd\u83b7\u5f97\u8fdb\u5165\u8fd9\u4e9b\u9690\u85cf\u5173\u5361\u7684\u9014\u5f84\uff0c\u63d0\u4f9b\u65b0\u7684\u6311\u6218\u548c\u5956\u52b1\u3002"}, {"question": "\u53cd\u5f39\u5927\u5e08\u4e2d\u500d\u7387\u7684\u610f\u4e49\u662f\u4ec0\u4e48\uff0c\u5982\u4f55\u4fdd\u6301\u5b83\uff1f", "answer": "\u53cd\u5f39\u5927\u5e08\u4e2d\u7684\u500d\u7387\u5bf9\u4e8e\u6700\u5927\u5316\u4f60\u7684\u5206\u6570\u81f3\u5173\u91cd\u8981\u3002\u5b83\u4f1a\u968f\u7740\u8fde\u7eed\u51fb\u4e2d\u76ee\u6807\u6216\u6536\u96c6\u786c\u5e01\u800c\u589e\u52a0\uff0c\u4f46\u5982\u679c\u9519\u8fc7\u76ee\u6807\u6216\u884c\u52a8\u4e4b\u95f4\u7684\u65f6\u95f4\u8fc7\u957f\uff0c\u5b83\u4f1a\u51cf\u5c11\u3002\u4f8b\u5982\uff0c\u8fde\u7eed\u51fb\u4e2d\u4e94\u4e2a\u76ee\u6807\u53ef\u4ee5\u4f7f\u4f60\u7684\u5206\u6570\u5728\u77ed\u65f6\u95f4\u5185\u7ffb\u500d\u3002\u4e3a\u4e86\u4fdd\u6301\u500d\u7387\uff0c\u4e13\u6ce8\u4e8e\u4fdd\u6301\u7a33\u5b9a\u7684\u8282\u594f\u5e76\u8ba1\u5212\u4f60\u7684\u52a8\u4f5c\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u7a7a\u95f2\u65f6\u95f4\u3002\u4f7f\u7528\u201c\u65f6\u95f4\u6682\u505c\u201d\u4e4b\u7c7b\u7684\u9053\u5177\u6765\u5ef6\u957f\u500d\u7387\u6301\u7eed\u65f6\u95f4\uff0c\u5e76\u8ffd\u6c42\u8fde\u9501\u53cd\u5e94\u4ee5\u4f7f\u5176\u6301\u7eed\u66f4\u957f\u65f6\u95f4\u3002"}, {"question": "\u53cd\u5f39\u5927\u5e08\u4e2d\u4e3a\u4ec0\u4e48\u4e00\u4e9b\u5173\u5361\u8bbe\u8ba1\u6709\u79fb\u52a8\u5e73\u53f0\uff0c\u5b83\u4eec\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\uff1f", "answer": "\u53cd\u5f39\u5927\u5e08\u4e2d\u7684\u79fb\u52a8\u5e73\u53f0\u589e\u52a0\u4e86\u6e38\u620f\u73a9\u6cd5\u7684\u6311\u6218\u6027\u548c\u7b56\u7565\u6027\u3002\u5b83\u4eec\u9700\u8981\u7cbe\u786e\u7684\u65f6\u673a\u548c\u9884\u6d4b\u624d\u80fd\u6210\u529f\u5730\u5bfc\u822a\u3002\u4f8b\u5982\uff0c\u572835\u7ea7\uff0c\u4e00\u4e2a\u79fb\u52a8\u5e73\u53f0\u53ef\u4ee5\u5e2e\u52a9\u4f60\u5230\u8fbe\u9ad8\u7a7a\u786c\u5e01\u7fa4\uff0c\u4f46\u662f\u65f6\u673a\u4e0d\u5bf9\uff0c\u7403\u5c31\u4f1a\u504f\u79bb\u65b9\u5411\u3002\u8fd9\u4e9b\u5e73\u53f0\u8feb\u4f7f\u73a9\u5bb6\u8c03\u6574\u7b56\u7565\uff0c\u5e76\u521b\u9020\u6027\u5730\u5229\u7528\u73af\u5883\u3002\u5b83\u4eec\u8fd8\u589e\u52a0\u4e86\u5173\u5361\u7684\u591a\u6837\u6027\uff0c\u9632\u6b62\u6e38\u620f\u73a9\u6cd5\u53d8\u5f97\u5355\u8c03\uff0c\u5e76\u4fdd\u6301\u73a9\u5bb6\u7684\u53c2\u4e0e\u5ea6\u3002"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684\u53cd\u5f39\u5927\u5e08\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u8bbe\u5907\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u8bbe\u5907\uff1f", "answer": "\u53ef\u4ee5\u4f7f\u7528\u4e91\u4fdd\u5b58\u529f\u80fd\u5c06\u4f60\u7684\u53cd\u5f39\u5927\u5e08\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u8bbe\u5907\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u8bbe\u5907\u3002\u9996\u5148\uff0c\u786e\u4fdd\u4f60\u5df2\u7ecf\u5728\u4e24\u4e2a\u8bbe\u5907\u4e0a\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u5e10\u6237\u3002\u7136\u540e\uff0c\u5bfc\u822a\u5230\u8bbe\u7f6e\u83dc\u5355\uff0c\u9009\u62e9\u201c\u4e91\u4fdd\u5b58\u201d\u9009\u9879\u4e0a\u4f20\u4f60\u7684\u8fdb\u5ea6\u3002\u5728\u65b0\u8bbe\u5907\u4e0a\uff0c\u767b\u5f55\u540c\u4e00\u4e2a\u5e10\u6237\u5e76\u4e0b\u8f7d\u4fdd\u5b58\u7684\u6570\u636e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4eceiPhone\u5207\u6362\u5230Android\u8bbe\u5907\uff0c\u767b\u5f55\u4f60\u7684Google Play\u5e10\u6237\u5e94\u8be5\u5141\u8bb8\u4f60\u8bbf\u95ee\u4f60\u7684\u4fdd\u5b58\u8fdb\u5ea6\u3002\u59cb\u7ec8\u5b9a\u671f\u5907\u4efd\u4f60\u7684\u6570\u636e\uff0c\u4ee5\u907f\u514d\u4efb\u4f55\u4e22\u5931\u3002"}]
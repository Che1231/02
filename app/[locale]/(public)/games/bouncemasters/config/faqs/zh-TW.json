[{"question": "Bouncemasters\u65b0\u624b\u6c42\u52a9\uff1a\u5982\u4f55\u624d\u80fd\u66f4\u597d\u5730\u64ca\u6253\u4f01\u9d5d\uff0c\u8b93\u5b83\u98db\u5f97\u66f4\u9060\uff1f", "answer": "\u65b0\u624b\u73a9\u5bb6\u60a8\u597d\uff01\u60f3\u8981\u8b93\u4f01\u9d5d\u98db\u5f97\u66f4\u9060\uff0c\u95dc\u9375\u5728\u65bc\u628a\u63e1\u64ca\u6253\u7684\u6642\u6a5f\u548c\u529b\u5ea6\u3002\u6700\u4f73\u64ca\u6253\u9ede\u901a\u5e38\u5728\u4f01\u9d5d\u5373\u5c07\u843d\u5730\uff0c\u8eab\u9ad4\u7565\u5fae\u524d\u50be\u7684\u77ac\u9593\u3002\u6b64\u6642\u63ee\u68d2\u80fd\u7372\u5f97\u6700\u5927\u7684\u63a8\u9032\u529b\u3002\u89c0\u5bdf\u4f01\u9d5d\u7684\u98db\u884c\u8ecc\u8de1\uff0c\u9810\u6e2c\u843d\u5730\u7684\u4f4d\u7f6e\uff0c\u4e26\u5728\u4f01\u9d5d\u63a5\u8fd1\u6642\u7acb\u5373\u9ede\u64ca\u87a2\u5e55\u3002\u529b\u5ea6\u65b9\u9762\uff0c\u5728\u4f01\u9d5d\u4e0b\u843d\u904e\u7a0b\u4e2d\u89c0\u5bdf\u529b\u5ea6\u689d\uff0c\u76e1\u91cf\u5728\u529b\u5ea6\u689d\u9054\u5230\u6700\u5927\u503c\u9644\u8fd1\u6642\u64ca\u6253\uff0c\u80fd\u6700\u5927\u5316\u98db\u884c\u8ddd\u96e2\u3002\u3010\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u64ca\u6253\u68d2\u7403\uff0c\u9700\u8981\u5728\u6700\u4f73\u6642\u6a5f\u63ee\u68d2\u624d\u80fd\u6253\u51fa\u5168\u58d8\u6253\u3011\u904a\u6232\u521d\u671f\uff0c\u512a\u5148\u5347\u7d1a\u7403\u68d2\u7684\u300c\u529b\u91cf\u300d\u5c6c\u6027\uff0c\u80fd\u986f\u8457\u63d0\u5347\u64ca\u6253\u6548\u679c\u3002\u4f8b\u5982\uff0c\u521d\u59cb\u7403\u68d2\u53ef\u80fd\u53ea\u80fd\u6253\u51fa50\u516c\u5c3a\u7684\u8ddd\u96e2\uff0c\u4f46\u5347\u7d1a\u5e7e\u6b21\u529b\u91cf\u5f8c\uff0c\u5c31\u80fd\u8f15\u9b06\u7a81\u7834100\u516c\u5c3a\u3002\u4e5f\u53ef\u4ee5\u5617\u8a66\u4f7f\u7528\u904a\u6232\u5167\u7684\u52a0\u901f\u9053\u5177\u4f86\u7372\u5f97\u984d\u5916\u901f\u5ea6\u3002"}, {"question": "Why does the penguin sometimes bounce off the bat weirdly in Bouncemasters, and how can I prevent it?", "answer": "\u4f01\u9d5d\u6709\u6642\u6703\u602a\u7570\u5730\u5f48\u958b\u7403\u68d2\uff0c\u662f\u56e0\u7232\u649e\u64ca\u89d2\u5ea6\u548c\u6642\u6a5f\u7684\u95dc\u4fc2\u3002\u5982\u679c\u64ca\u6253\u4f01\u9d5d\u904e\u65e9\u6216\u904e\u665a\uff0c\u6216\u7403\u68d2\u6c92\u6709\u5b8c\u5168\u5c0d\u6e96\uff0c\u53ef\u80fd\u6703\u5c0e\u81f4\u53cd\u5f48\u904e\u5f31\u6216\u4e0d\u7a69\u5b9a\u3002\u7232\u4e86\u907f\u514d\u9019\u7a2e\u60c5\u6cc1\uff0c\u8acb\u6ce8\u91cd\u64ca\u4e2d\u7403\u68d2\u7684\u751c\u871c\u9ede\uff0c\u901a\u5e38\u4f4d\u65bc\u7403\u68d2\u4e2d\u5fc3\u3002\u6b64\u5916\uff0c\u8003\u616e\u5347\u7d1a\u7403\u68d2\u7684\u300c\u7cbe\u6e96\u5ea6\u300d\u5c6c\u6027\uff0c\u53ef\u4ee5\u964d\u4f4e\u5931\u6e96\u7684\u6a5f\u7387\u3002\u5617\u8a66\u4f7f\u7528\u52a0\u901f\u589e\u76ca\u4f86\u7372\u5f97\u66f4\u597d\u7684\u6642\u6a5f\u3002\u4f8b\u5982\uff0c\u5728\u7406\u60f3\u7684\u64ca\u6253\u4f01\u9d5d\u6642\u6a5f\u4e4b\u524d\u555f\u52d5\u52a0\u901f\u589e\u76ca\uff0c\u53ef\u4ee5\u5e6b\u52a9\u8a2d\u5b9a\u5b8c\u7f8e\u7684\u64ca\u6253\u4e26\u63d0\u9ad8\u4e00\u81f4\u6027\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u521d\u59cb\u7403\u68d2\uff1a\u7cbe\u6e96\u5ea6\u4f4e\uff0c\u5bb9\u6613\u5931\u8aa4\uff0c\u5347\u7d1a\u7403\u68d2\uff1a\u7cbe\u6e96\u5ea6\u9ad8\uff0c\u7a69\u5b9a\u64ca\u6253]"}, {"question": "Bouncemasters\u91d1\u5e01\u83b7\u53d6\u653b\u7565\uff1a\u9664\u4e86\u5e38\u89c4\u73a9\u6cd5\uff0c\u8fd8\u6709\u54ea\u4e9b\u9690\u85cf\u7684\u5feb\u901f\u5237\u91d1\u5e01\u65b9\u6cd5\uff1f", "answer": "\u9664\u4e86\u900f\u904e\u6b63\u5e38\u904a\u6232\u904e\u7a0b\u7372\u53d6\u91d1\u5e63\uff0c\u904a\u6232\u4e2d\u9084\u6709\u8457\u4e00\u4e9b\u5feb\u901f\u5237\u91d1\u5e63\u7684\u65b9\u6cd5\u3002\u4e00\u7a2e\u65b9\u6cd5\u662f\u95dc\u6ce8\u6bcf\u65e5\u4efb\u52d9\u548c\u6210\u5c31\uff0c\u5b8c\u6210\u5b83\u5011\u53ef\u4ee5\u7372\u5f97\u984d\u5916\u7684\u91d1\u5e63\u734e\u52f5\u3002\u53e6\u4e00\u7a2e\u65b9\u6cd5\u662f\u89c0\u770b\u5ee3\u544a\uff0c\u904a\u6232\u6703\u4e0d\u5b9a\u6642\u63d0\u4f9b\u89c0\u770b\u5ee3\u544a\u7372\u53d6\u91d1\u5e63\u7684\u6a5f\u6703\u3002\u66f4\u6709\u6548\u7684\u65b9\u6cd5\u662f\uff0c\u524d\u671f\u5c08\u6ce8\u5347\u7d1a\u5f48\u5c04\u8ddd\u96e2\u548c\u91d1\u5e63\u6536\u76ca\u52a0\u6210\u3002\u512a\u5148\u5347\u7d1a\u91d1\u5e63\u6536\u76ca\u52a0\u6210\uff0c\u53ef\u4ee5\u52a0\u901f\u7d2f\u7a4d\u8ca1\u5bcc\u3002\u6280\u5de7\u65b9\u9762\uff0c\u76e1\u91cf\u6253\u51fa\u5b8c\u7f8e\u64ca\u6253\u4ee5\u7372\u5f97\u984d\u5916\u7684\u91d1\u5e63\u734e\u52f5\uff0c\u5b8c\u7f8e\u64ca\u6253\u4f01\u9d5d\u6703\u6709\u7279\u6b8a\u97f3\u6548\u548c\u8996\u89ba\u6548\u679c\u63d0\u793a\u3002\u3010\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u666e\u901a\u64ca\u625310\u91d1\u5e63\uff0c\u5b8c\u7f8e\u64ca\u625320\u91d1\u5e63\uff0c\u89c0\u770b\u5ee3\u544a50\u91d1\u5e63\u3011\u6b64\u5916\uff0c\u95dc\u6ce8\u904a\u6232\u5b98\u65b9\u793e\u7fa4\u548c\u6d3b\u52d5\uff0c\u6709\u6642\u6703\u6709\u8d08\u9001\u91d1\u5e63\u7684\u6d3b\u52d5\u3002"}, {"question": "Bouncemasters\u7684\u9ad8\u7ea7\u6280\u5de7\uff1a\u5982\u4f55\u5229\u7528\u5730\u5f62\u548c\u52a8\u7269\u6765\u63d0\u9ad8\u98de\u884c\u8ddd\u79bb\uff1f", "answer": "\u60f3\u8981\u5927\u5e45\u63d0\u5347\u98db\u884c\u8ddd\u96e2\uff0c\u9700\u8981\u5de7\u5999\u5229\u7528\u5834\u666f\u4e2d\u7684\u5730\u5f62\u548c\u52d5\u7269\u3002\u4f8b\u5982\uff0c\u67d0\u4e9b\u5730\u5f62\u6709\u4e0a\u5347\u6c23\u6d41\uff0c\u8b93\u4f01\u9d5d\u7372\u5f97\u984d\u5916\u7684\u5347\u529b\u3002\u800c\u90e8\u5206\u52d5\u7269\uff0c\u4f8b\u5982\u6d77\u9dd7\uff0c\u5728\u4f01\u9d5d\u649e\u64ca\u6642\u6703\u63d0\u4f9b\u984d\u5916\u7684\u5f48\u5c04\u529b\u3002\u6b65\u9a5f1\uff1a\u719f\u6089\u5730\u5716\uff0c\u8a18\u4f4f\u95dc\u9375\u5730\u5f62\u548c\u52d5\u7269\u7684\u4f4d\u7f6e\u3002\u6b65\u9a5f2\uff1a\u5728\u98db\u884c\u904e\u7a0b\u4e2d\uff0c\u8abf\u6574\u98db\u884c\u65b9\u5411\uff0c\u76e1\u91cf\u9760\u8fd1\u4e0a\u5347\u6c23\u6d41\u548c\u52d5\u7269\u7fa4\u3002\u6b65\u9a5f3\uff1a\u5229\u7528\u52a0\u901f\u9053\u5177\u8abf\u6574\u98db\u884c\u8ecc\u8de1\uff0c\u78ba\u4fdd\u4f01\u9d5d\u80fd\u5920\u7cbe\u78ba\u649e\u64ca\u76ee\u6a19\u3002\u4e00\u500b\u5178\u578b\u7684\u7bc4\u4f8b\u662f\uff0c\u5728\u51b0\u5c71\u5834\u666f\u4e2d\uff0c\u5229\u7528\u4e0a\u5347\u6c23\u6d41\u53ef\u4ee5\u8f15\u9b06\u98db\u8d8a\u4e00\u6bb5\u5f88\u9577\u7684\u8ddd\u96e2\uff0c\u5982\u679c\u80fd\u9806\u52e2\u649e\u64ca\u6d77\u9dd7\u7fa4\uff0c\u5247\u53ef\u4ee5\u7372\u5f97\u66f4\u9060\u7684\u98db\u884c\u8ddd\u96e2\u3002\u3010\u6d41\u7a0b\u5716\u89e3\uff1a\u98db\u884c\u2192\u63a5\u8fd1\u6c23\u6d41/\u52d5\u7269\u2192\u52a0\u901f\u8abf\u6574\u2192\u6210\u529f\u649e\u64ca\u2192\u8ddd\u96e2\u63d0\u5347\u3011"}, {"question": "What's the deal with the different bats in Bouncemasters? Which one offers the best performance and why?", "answer": "Bouncemasters\u4e2d\u7684\u4e0d\u540c\u7403\u68d2\u5728\u529b\u91cf\u3001\u53cd\u5f48\u3001\u7a7a\u6c23\u52d5\u529b\u5b78\u548c\u7cbe\u6e96\u5ea6\u7b49\u65b9\u9762\u5404\u6709\u4e0d\u540c\u3002\u6700\u4f73\u7403\u68d2\u53d6\u6c7a\u65bc\u4f60\u7684\u904a\u6232\u98a8\u683c\u548c\u76ee\u6a19\u3002\u521d\u671f\uff0c\u512a\u5148\u9078\u64c7\u9ad8\u529b\u91cf\u7684\u7403\u68d2\u4ee5\u6700\u5927\u5316\u8ddd\u96e2\u3002\u5f8c\u671f\uff0c\u7cbe\u6e96\u5ea6\u8b8a\u5f97\u66f4\u91cd\u8981\uff0c\u4ee5\u78ba\u4fdd\u9023\u7e8c\u64ca\u6253\u548c\u9023\u64ca\u3002\u7403\u68d2\u5c6c\u6027\u4ee5\u76ee\u524d\u88dd\u5099\u7684\u7403\u68d2\u9032\u884c\u6bd4\u8f03\u3002\u6bd4\u8f03\u53ef\u7528\u7684\u7403\u68d2\uff0c\u7136\u5f8c\u4f9d\u64da\u9700\u6c42\u9078\u64c7\u60f3\u8981\u7684\u7403\u68d2\u3002\u91cd\u8981\u7684\u662f\u8981\u4fdd\u6301\u8207\u6700\u7d42\u76ee\u6a19\u76f8\u7b26\u7684\u7403\u68d2\u3002\u4f8b\u5982\uff0c\u300c\u96f7\u9706\u68d2\u300d\u7403\u68d2\u5728\u64ca\u4e2d\u4f01\u9d5d\u6642\u9020\u6210\u7684\u50b7\u5bb3\u76f8\u7576\u5927\uff0c\u4e26\u63d0\u4f9b\u984d\u5916\u7684\u5c04\u7a0b\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u7403\u68d2\u985e\u578b - \u5c6c\u6027\u91cd\u9ede - \u9069\u7528\u5834\u666f]"}, {"question": "Bouncemasters\u6570\u636e\u7814\u7a76\uff1a\u5f71\u54cd\u4f01\u9e45\u98de\u884c\u8ddd\u79bb\u7684\u5173\u952e\u53c2\u6570\u6709\u54ea\u4e9b\uff1f\u5982\u4f55\u4f18\u5316\u8fd9\u4e9b\u53c2\u6570\uff1f", "answer": "\u5f71\u97ff\u4f01\u9d5d\u98db\u884c\u8ddd\u96e2\u7684\u95dc\u9375\u53c3\u6578\u4e3b\u8981\u6709\u4ee5\u4e0b\u5e7e\u500b\u65b9\u9762\uff1a\u7403\u68d2\u7684\u529b\u91cf\u5c6c\u6027\u3001\u64ca\u6253\u6642\u7684\u529b\u5ea6\u3001\u4f01\u9d5d\u7684\u521d\u59cb\u901f\u5ea6\u3001\u98db\u884c\u904e\u7a0b\u4e2d\u7684\u7a7a\u6c23\u963b\u529b\uff0c\u4ee5\u53ca\u5730\u5f62\u548c\u52d5\u7269\u7684\u5f71\u97ff\u3002\u63d0\u5347\u7403\u68d2\u7684\u529b\u91cf\u5c6c\u6027\u662f\u57fa\u790e\uff0c\u4f7f\u7528\u5177\u6709\u66f4\u9ad8\u529b\u91cf\u5c6c\u6027\u4e14\u7a7a\u6c23\u52d5\u529b\u5b78\u66f4\u597d\u7684\u7403\u68d2\u53ef\u4ee5\u5f88\u5bb9\u6613\u5730\u63d0\u9ad8\u98db\u884c\u901f\u5ea6\u3002\u64ca\u6253\u6642\u7684\u529b\u5ea6\u9700\u8981\u7cbe\u78ba\u628a\u63e1\uff0c\u76e1\u91cf\u5728\u9032\u5ea6\u689d\u9054\u5230\u6700\u5927\u503c\u6642\u51fa\u624b\u3002\u6b64\u5916\uff0c\u4f01\u9d5d\u7684\u521d\u59cb\u901f\u5ea6\u4e5f\u5f88\u91cd\u8981\uff0c\u53ef\u900f\u904e\u5347\u7d1a\u4f01\u9d5d\u7684\u52a0\u901f\u5c6c\u6027\u4f86\u63d0\u5347\u3002\u5728\u98db\u884c\u904e\u7a0b\u4e2d\uff0c\u76e1\u91cf\u5229\u7528\u5730\u5f62\u548c\u52d5\u7269\u4f86\u6e1b\u5c11\u7a7a\u6c23\u963b\u529b\uff0c\u7372\u5f97\u984d\u5916\u7684\u63a8\u9032\u529b\u3002\u512a\u5316\u9019\u4e9b\u53c3\u6578\u9700\u8981\u7d9c\u5408\u8003\u91cf\uff0c\u4e0d\u80fd\u53ea\u95dc\u6ce8\u67d0\u4e00\u500b\u65b9\u9762\uff0c\u9700\u8981\u627e\u5230\u4e00\u500b\u5e73\u8861\u9ede\u3002 \u3010\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c31\u50cf\u7d44\u88dd\u8cfd\u8eca\uff0c\u9700\u8981\u5e73\u8861\u5f15\u64ce\u3001\u5e95\u76e4\u3001\u8f2a\u80ce\u7b49\u5404\u500b\u90e8\u4ef6\u7684\u6027\u80fd\u3011"}, {"question": "Bouncemasters\u7684\u6210\u5c31\u7cfb\u7edf\u6df1\u5ea6\u89e3\u6790\uff1a\u54ea\u4e9b\u6210\u5c31\u6700\u96be\u8fbe\u6210\uff1f\u8fbe\u6210\u8fd9\u4e9b\u6210\u5c31\u6709\u4ec0\u4e48\u6280\u5de7\uff1f", "answer": "Bouncemasters\u7684\u6210\u5c31\u7cfb\u7d71\u5305\u542b\u5404\u7a2e\u6311\u6230\uff0c\u5176\u4e2d\u4e00\u4e9b\u6210\u5c31\u96e3\u5ea6\u8f03\u9ad8\uff0c\u9700\u8981\u4e00\u5b9a\u7684\u6280\u5de7\u548c\u8010\u5fc3\u624d\u80fd\u9054\u6210\u3002\u4f8b\u5982\uff0c\u300c\u4e00\u64ca\u5230\u5e95\u300d\u6210\u5c31\u8981\u6c42\u73a9\u5bb6\u4e00\u6b21\u98db\u884c\u9054\u5230\u975e\u5e38\u9060\u7684\u8ddd\u96e2\uff0c\u9700\u8981\u5c0d\u7403\u68d2\u548c\u4f01\u9d5d\u7684\u5c6c\u6027\u9032\u884c\u6975\u81f4\u512a\u5316\uff0c\u4e26\u5de7\u5999\u5229\u7528\u5730\u5f62\u548c\u52d5\u7269\u3002\u9054\u6210\u6280\u5de7\uff1a\u2460\u9078\u64c7\u5408\u9069\u7684\u7403\u68d2\uff0c\u512a\u5148\u8003\u616e\u529b\u91cf\u548c\u7cbe\u6e96\u5ea6\u5c6c\u6027\u3002\u2461\u5347\u7d1a\u4f01\u9d5d\u7684\u52a0\u901f\u5c6c\u6027\uff0c\u63d0\u5347\u521d\u59cb\u901f\u5ea6\u3002\u2462\u719f\u6089\u5730\u5716\uff0c\u627e\u5230\u5408\u9069\u7684\u4e0a\u5347\u6c23\u6d41\u548c\u52d5\u7269\u7fa4\u3002\u2463\u4f7f\u7528\u52a0\u901f\u9053\u5177\uff0c\u8abf\u6574\u98db\u884c\u8ecc\u8de1\uff0c\u78ba\u4fdd\u4f01\u9d5d\u80fd\u5920\u7cbe\u78ba\u649e\u64ca\u76ee\u6a19\u3002\u300c\u7121\u50b7\u901a\u904e\u300d\u6210\u5c31\u8981\u6c42\u73a9\u5bb6\u5728\u4e0d\u649e\u64ca\u4efb\u4f55\u969c\u7919\u7269\u7684\u60c5\u6cc1\u4e0b\u5b8c\u6210\u98db\u884c\uff0c\u9700\u8981\u5c0d\u64cd\u4f5c\u6709\u6975\u9ad8\u7684\u8981\u6c42\uff0c\u5efa\u8b70\u5728\u7df4\u7fd2\u6a21\u5f0f\u4e2d\u53cd\u8986\u7df4\u7fd2\uff0c\u719f\u7df4\u638c\u63e1\u98db\u884c\u8ecc\u8de1\u7684\u63a7\u5236\u3002\u3010\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u666e\u901a\u6a21\u5f0f\u96e3\u5ea6\u9ad8\uff0c\u7df4\u7fd2\u6a21\u5f0f\u53ef\u53cd\u8986\u5617\u8a66\uff0c\u9053\u5177\u8f14\u52a9\u964d\u4f4e\u96e3\u5ea6\u3011"}, {"question": "What is the underlying mechanic behind the penguin's speed in Bouncemasters? Are there any hidden tricks to manipulate the speed?", "answer": "\u4f01\u9d5d\u901f\u5ea6\u7684\u80cc\u5f8c\u6a5f\u5236\u5305\u542b\u4e86\u521d\u59cb\u767c\u5c04\u901f\u5ea6\uff08\u7531\u7403\u68d2\u529b\u91cf\u548c\u4f01\u9d5d\u5c6c\u6027\u6c7a\u5b9a\uff09\u3001\u5916\u90e8\u5f71\u97ff\uff08\u4f8b\u5982\u52d5\u7269\u548c\u98a8\u5411\uff09\u4ee5\u53ca\u963b\u529b\u3002\u8981\u64cd\u63a7\u901f\u5ea6\uff0c\u8acb\u5c08\u6ce8\u65bc\u5347\u7d1a\u7403\u68d2\u7684\u529b\u91cf\u548c\u4f01\u9d5d\u7684\u521d\u59cb\u901f\u5ea6\u3002\u6b64\u5916\uff0c\u5b78\u7fd2\u5730\u5f62\u4ee5\u5229\u7528\u4e0a\u5347\u6c23\u6d41\u548c\u5f48\u8df3\u52d5\u7269\u3002\u4e00\u4e9b\u73a9\u5bb6\u5728\u6642\u6a5f\u4e0a\u8207\u9019\u4e9b\u74b0\u5883\u5143\u7d20\u540c\u6b65\uff0c\u4ee5\u7372\u5f97\u6700\u5927\u901f\u5ea6\u3002\u96d6\u7136\u6c92\u6709\u5bb9\u6613\u5229\u7528\u7684\u300c\u96b1\u85cf\u6280\u5de7\u300d\u6216\u300c\u6f0f\u6d1e\u300d\uff0c\u4f46\u719f\u7df4\u904b\u7528\u5730\u5f62\u548c\u9053\u5177\u7684\u4f7f\u7528\u4ecd\u7136\u5f88\u91cd\u8981\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u521d\u59cb\u901f\u5ea6 \u2013 \u57fa\u672c\u901f\u5ea6\uff0c\u5916\u90e8\u56e0\u7d20 \u2013 \u52a0\u901f\u5ea6/\u6e1b\u901f\u5ea6\uff0c\u6700\u7d42\u901f\u5ea6 \u2013 \u8ddd\u96e2]"}, {"question": "Bouncemasters\u8de8\u5e73\u53f0\u7591\u95ee\uff1a\u5b89\u5353\u548ciOS\u5e73\u53f0\u7684\u6570\u636e\u53ef\u4ee5\u4e92\u901a\u5417\uff1f\u5982\u679c\u53ef\u4ee5\uff0c\u5982\u4f55\u64cd\u4f5c\uff1f", "answer": "\u5f88\u907a\u61be\uff0c\u76ee\u524dBouncemasters\u7684\u5b89\u5353\u548ciOS\u5e73\u53f0\u4e4b\u9593\u7684\u6578\u64da\u901a\u5e38\u662f\u4e0d\u4e92\u901a\u7684\u3002\u9019\u610f\u5473\u8457\u4f60\u5728\u5b89\u5353\u88dd\u7f6e\u4e0a\u7684\u904a\u6232\u9032\u5ea6\u7121\u6cd5\u76f4\u63a5\u8f49\u79fb\u5230iOS\u88dd\u7f6e\u4e0a\uff0c\u53cd\u4e4b\u4ea6\u7136\u3002\u4e0d\u904e\uff0c\u6709\u4e9b\u904a\u6232\u6703\u63d0\u4f9b\u5e33\u865f\u7d81\u5b9a\u529f\u80fd\uff0c\u4f8b\u5982\u900f\u904eFacebook\u6216Google Play\u5e33\u865f\u3002\u5982\u679cBouncemasters\u652f\u63f4\u6b64\u985e\u529f\u80fd\uff0c\u4f60\u53ef\u4ee5\u5617\u8a66\u7d81\u5b9a\u5e33\u865f\uff0c\u770b\u770b\u662f\u5426\u80fd\u5920\u540c\u6b65\u6578\u64da\u3002\u5982\u679c\u904a\u6232\u652f\u63f4\u96f2\u7aef\u5132\u5b58\u529f\u80fd\uff0c\u5247\u5728\u5207\u63db\u5e73\u53f0\u5f8c\u91cd\u65b0\u767b\u5165\u5e33\u865f\u6703\u8a62\u554f\u662f\u5426\u8981\u5f9e\u96f2\u7aef\u8f09\u5165\u5132\u5b58\u6a94\u8986\u84cb\u672c\u5730\u5132\u5b58\u6a94\uff0c\u5f9e\u800c\u9054\u5230\u5e73\u53f0\u4e92\u901a\u7684\u76ee\u7684\u3002\u8acb\u6ce8\u610f\u67e5\u770b\u904a\u6232\u5b98\u65b9FAQ\u6216\u806f\u7d61\u5ba2\u670d\uff0c\u7372\u53d6\u6700\u6e96\u78ba\u7684\u8de8\u5e73\u53f0\u6578\u64da\u540c\u6b65\u8cc7\u8a0a\u3002\u3010\u53cb\u60c5\u63d0\u793a\uff1a\u52d9\u5fc5\u5728\u64cd\u4f5c\u524d\u5099\u4efd\u672c\u5730\u5132\u5b58\u6a94\uff0c\u4ee5\u9632\u842c\u4e00\u3011"}, {"question": "Bouncemasters\u5f69\u86cb\u6316\u6398\uff1a\u6e38\u620f\u4e2d\u662f\u5426\u5b58\u5728\u9690\u85cf\u7684\u4f01\u9e45\u89d2\u8272\u6216\u7279\u6b8a\u5173\u5361\uff1f\u5982\u4f55\u89e6\u53d1\u8fd9\u4e9b\u9690\u85cf\u5185\u5bb9\uff1f", "answer": "Bouncemasters\u4e2d\u78ba\u5be6\u5b58\u5728\u4e00\u4e9b\u96b1\u85cf\u7684\u4f01\u9d5d\u89d2\u8272\u548c\u7279\u6b8a\u95dc\u5361\uff0c\u4f46\u89f8\u767c\u689d\u4ef6\u5f80\u5f80\u6bd4\u8f03\u96b1\u853d\u3002\u4e00\u7a2e\u53ef\u80fd\u6027\u662f\u900f\u904e\u9054\u6210\u7279\u5b9a\u7684\u6210\u5c31\u6216\u5b8c\u6210\u67d0\u4e9b\u96b1\u85cf\u4efb\u52d9\u4f86\u89e3\u9396\u65b0\u7684\u4f01\u9d5d\u89d2\u8272\u3002\u53e6\u4e00\u7a2e\u53ef\u80fd\u6027\u662f\u5728\u904a\u6232\u7684\u7279\u5b9a\u5834\u666f\u4e2d\uff0c\u6309\u7167\u7279\u5b9a\u7684\u9806\u5e8f\u6216\u65b9\u5f0f\u9032\u884c\u64cd\u4f5c\uff0c\u624d\u80fd\u89f8\u767c\u96b1\u85cf\u95dc\u5361\u3002\u4f8b\u5982\uff0c\u53cd\u8986\u9ede\u64ca\u7279\u5b9a\u7684NPC\uff0c\u6216\u5728\u7279\u5b9a\u6642\u9593\u6bb5\u5167\u9023\u7e8c\u5b8c\u6210\u591a\u500b\u4efb\u52d9\u3002\u7531\u65bc\u5b98\u65b9\u901a\u5e38\u4e0d\u6703\u516c\u958b\u9019\u4e9b\u96b1\u85cf\u5167\u5bb9\u7684\u5177\u9ad4\u89f8\u767c\u65b9\u5f0f\uff0c\u9700\u8981\u73a9\u5bb6\u5011\u81ea\u884c\u63a2\u7d22\u548c\u5617\u8a66\u3002\u53ef\u4ee5\u95dc\u6ce8\u904a\u6232\u793e\u7fa4\uff0c\u8207\u5176\u4ed6\u73a9\u5bb6\u4ea4\u6d41\u5fc3\u5f97\uff0c\u6216\u8a31\u80fd\u627e\u5230\u4e00\u4e9b\u7dda\u7d22\u3002\u6839\u64da\u4ee5\u5f80\u7d93\u9a57\uff0c\u7bc0\u6176\u671f\u9593\uff0c\u5b98\u65b9\u53ef\u80fd\u6703\u63a8\u51fa\u9650\u6642\u6d3b\u52d5\uff0c\u5176\u4e2d\u5305\u542b\u65b0\u7684\u89d2\u8272\u548c\u95dc\u5361\u3002\u3010\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c31\u50cf\u5c0b\u5bf6\u904a\u6232\uff0c\u9700\u8981\u8010\u5fc3\u548c\u7d30\u7dfb\u7684\u89c0\u5bdf\u624d\u80fd\u627e\u5230\u5bf6\u85cf\u3011"}]
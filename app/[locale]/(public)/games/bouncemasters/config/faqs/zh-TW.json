[{"question": "\u5982\u4f55\u63a7\u5236\u65b0\u624b\u5728Bouncemasters\u904a\u6232\u4e2d\u7403\u7684\u8ecc\u8de1\uff1f", "answer": "\u8981\u63a7\u5236Bouncemasters\u904a\u6232\u4e2d\u7684\u7403\u7684\u8ecc\u8de1\uff0c\u9996\u5148\u8981\u4e86\u89e3\u57fa\u672c\u6a5f\u5236\u3002\u9ede\u64ca\u87a2\u5e55\u6642\uff0c\u7403\u6703\u6cbf\u8457\u9ede\u64ca\u65b9\u5411\u5f48\u8df3\u3002\u4f8b\u5982\uff0c\u8f15\u6572\u7403\u7684\u53f3\u5074\uff0c\u6703\u4f7f\u7403\u5c0d\u89d2\u7dda\u5411\u53f3\u5f48\u8df3\u3002\u5728\u65e9\u671f\u95dc\u5361\u7df4\u7fd2\uff0c\u611f\u53d7\u7bc0\u594f\u548c\u89d2\u5ea6\u3002\u6b64\u5916\uff0c\u5584\u7528\u904a\u6232\u74b0\u5883\uff1b\u5f9e\u7246\u58c1\u5f48\u8df3\u53ef\u4ee5\u5e6b\u52a9\u91cd\u65b0\u5c0e\u5411\u7403\u7684\u8ecc\u8de1\u3002\u8a18\u4f4f\uff0c\u95dc\u9375\u662f\u8981\u9810\u6e2c\u7403\u843d\u5730\u7684\u4f4d\u7f6e\uff0c\u4e26\u76f8\u61c9\u5730\u8a08\u5283\u4e0b\u4e00\u6b65\u52d5\u4f5c\u3002"}, {"question": "\u5728\u73a9Bouncemasters 100 \u5c0f\u6642\u5f8c\uff0c\u5982\u4f55\u7372\u5f97\u9ad8\u5206\uff1f", "answer": "\u5728\u9577\u6642\u9593\u73a9Bouncemasters\u5f8c\u60f3\u7372\u5f97\u9ad8\u5206\u9700\u8981\u638c\u63e1\u9032\u968e\u7b56\u7565\u3002\u6b65\u9a5f\u4e00\uff1a\u5c08\u6ce8\u65bc\u9023\u9396\u53cd\u61c9\uff0c\u5feb\u901f\u64ca\u4e2d\u591a\u500b\u76ee\u6a19\u3002\u6b65\u9a5f\u4e8c\uff1a\u904b\u7528\u4f8b\u5982\u300c\u5438\u9435\u300d\u7b49\u9053\u5177\u5438\u5f15\u786c\u5e63\uff0c\u4ee5\u53ca\u300c\u6642\u9593\u51cd\u7d50\u300d\u4f86\u6e1b\u7de9\u969c\u7919\u3002\u6b65\u9a5f\u4e09\uff1a\u901a\u904e\u8a08\u7b97\u7403\u7684\u8ecc\u8de1\u4f86\u6e96\u78ba\u64ca\u4e2d\u96e3\u4ee5\u89f8\u53ca\u7684\u76ee\u6a19\u3002\u4f8b\u5982\uff0c\u5728 45 \u7b49\u7d1a\u6642\uff0c\u5c07\u7403\u5f48\u5230\u79fb\u52d5\u5e73\u53f0\u4e0a\u53ef\u4ee5\u5e6b\u52a9\u4f60\u6536\u96c6\u96b1\u85cf\u7684\u786c\u5e63\u7fa4\u3002\u59cb\u7d42\u95dc\u6ce8\u5206\u6578\u500d\u6578\uff0c\u4e26\u76e1\u53ef\u80fd\u9577\u6642\u9593\u4fdd\u6301\u5b83\u3002"}, {"question": "\u70ba\u4ec0\u9ebcBouncemasters\u904a\u6232\u4e2d\u7403\u6709\u6642\u6703\u8868\u73fe\u51fa\u4e0d\u53ef\u9810\u6e2c\u7684\u884c\u70ba\uff1f", "answer": "Bouncemasters\u904a\u6232\u4e2d\u7403\u7684\u884c\u70ba\u770b\u8d77\u4f86\u4e0d\u53ef\u9810\u6e2c\uff0c\u539f\u56e0\u6709\u5e7e\u500b\u3002\u9996\u5148\uff0c\u904a\u6232\u6574\u5408\u4e86\u57fa\u65bc\u7269\u7406\u7684\u6a5f\u5236\uff0c\u9019\u610f\u5473\u8457\u7403\u7684\u8ecc\u8de1\u6703\u53d7\u5230\u73fe\u5be6\u4e16\u754c\u7269\u7406\u5b78\u7684\u5f71\u97ff\uff0c\u4f8b\u5982\u91cd\u529b\u548c\u52d5\u91cf\u3002\u5176\u6b21\uff0c\u74b0\u5883\u56e0\u7d20\uff0c\u4f8b\u5982\u79fb\u52d5\u5e73\u53f0\u6216\u98a8\uff0c\u6703\u6539\u8b8a\u7403\u7684\u8def\u7dda\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 30 \u95dc\uff0c\u7a81\u5982\u5176\u4f86\u7684\u98a8\u66b4\u6703\u628a\u7403\u63a8\u96e2\u65b9\u5411\u3002\u6700\u5f8c\uff0c\u50cf\u300c\u5f48\u8df3\u7403\u300d\u9019\u6a23\u7684\u9053\u5177\u6703\u66ab\u6642\u6539\u8b8a\u7403\u7684\u7279\u6027\uff0c\u5c0e\u81f4\u5176\u884c\u70ba\u4e0d\u540c\u3002\u4e86\u89e3\u9019\u4e9b\u56e0\u7d20\u53ef\u4ee5\u5e6b\u52a9\u4f60\u66f4\u597d\u5730\u9810\u6e2c\u548c\u63a7\u5236\u7403\u7684\u79fb\u52d5\u3002"}, {"question": "\u5c0d\u65bc\u9032\u968e\u73a9\u5bb6\u4f86\u8aaa\uff0cBouncemasters\u904a\u6232\u4e2d\u54ea\u4e9b\u9053\u5177\u6700\u6709\u6548\uff1f", "answer": "\u5c0d\u65bcBouncemasters\u904a\u6232\u4e2d\u7684\u9032\u968e\u73a9\u5bb6\u4f86\u8aaa\uff0c\u6700\u6709\u6548\u7684\u9053\u5177\u662f\u90a3\u4e9b\u53ef\u4ee5\u589e\u5f37\u63a7\u5236\u529b\u548c\u5f97\u5206\u6f5b\u529b\u7684\u9053\u5177\u3002\u300c\u5438\u9435\u300d\u5c0d\u65bc\u6536\u96c6\u786c\u5e63\u975e\u5e38\u5bf6\u8cb4\uff0c\u300c\u6642\u9593\u51cd\u7d50\u300d\u5247\u6709\u52a9\u65bc\u61c9\u5c0d\u68d8\u624b\u7684\u969c\u7919\u3002\u300c\u5f48\u8df3\u7403\u300d\u9053\u5177\u589e\u52a0\u4e86\u7403\u7684\u5f48\u6027\uff0c\u5141\u8a31\u66f4\u9577\u6642\u9593\u548c\u66f4\u7cbe\u78ba\u7684\u5f48\u8df3\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 50 \u95dc\uff0c\u4f7f\u7528\u300c\u5f48\u8df3\u7403\u300d\u53ef\u4ee5\u5e6b\u52a9\u4f60\u5230\u9054\u9ad8\u7a7a\u786c\u5e63\u7fa4\u3002\u59cb\u7d42\u512a\u5148\u8003\u616e\u7b26\u5408\u7576\u524d\u76ee\u6a19\u7684\u9053\u5177\uff0c\u7121\u8ad6\u662f\u5f97\u5206\u9084\u662f\u5feb\u901f\u5b8c\u6210\u95dc\u5361\u3002"}, {"question": "Bouncemasters\u904a\u6232\u7684\u5206\u6578\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u5927\u5316\u6211\u7684\u5206\u6578\uff1f", "answer": "Bouncemasters\u904a\u6232\u7684\u5206\u6578\u7cfb\u7d71\u57fa\u65bc\u591a\u9805\u56e0\u7d20\uff0c\u5305\u62ec\u6536\u96c6\u786c\u5e63\u3001\u64ca\u4e2d\u76ee\u6a19\u548c\u9023\u9396\u53cd\u61c9\u3002\u6536\u96c6\u6bcf\u500b\u786c\u5e63\u90fd\u6703\u589e\u52a0\u4f60\u7684\u5206\u6578\uff0c\u9023\u7e8c\u5feb\u901f\u64ca\u4e2d\u76ee\u6a19\u6703\u589e\u52a0\u4f60\u7684\u5206\u6578\u500d\u6578\u3002\u4f8b\u5982\uff0c\u9023\u7e8c\u64ca\u4e2d\u4e09\u500b\u76ee\u6a19\u6703\u5728\u77ed\u6642\u9593\u5167\u4f7f\u5206\u6578\u7ffb\u500d\u3002\u70ba\u4e86\u6700\u5927\u5316\u5206\u6578\uff0c\u5c08\u6ce8\u65bc\u4fdd\u6301\u500d\u6578\uff0c\u6301\u7e8c\u64ca\u4e2d\u76ee\u6a19\u4e26\u6536\u96c6\u786c\u5e63\u3002\u6b64\u5916\uff0c\u5c0b\u627e\u96b1\u85cf\u7684\u786c\u5e63\u7fa4\uff0c\u4e26\u4f7f\u7528\u300c\u5438\u9435\u300d\u9053\u5177\u4f86\u66f4\u6709\u6548\u5730\u6536\u96c6\u66f4\u591a\u786c\u5e63\u3002"}, {"question": "\u5728\u884c\u52d5\u5e73\u53f0\u548c\u500b\u4eba\u96fb\u8166\u5e73\u53f0\u4e0a\uff0cBouncemasters\u904a\u6232\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "\u5728\u884c\u52d5\u5e73\u53f0\u548c\u500b\u4eba\u96fb\u8166\u5e73\u53f0\u4e0a\uff0cBouncemasters\u904a\u6232\u7684\u4e3b\u8981\u5dee\u7570\u5728\u65bc\u63a7\u5236\u65b9\u6848\u548c\u87a2\u5e55\u986f\u793a\u9078\u9805\u3002\u5728\u884c\u52d5\u5e73\u53f0\u4e0a\uff0c\u904a\u6232\u901a\u904e\u89f8\u63a7\u63a7\u5236\uff0c\u5141\u8a31\u76f4\u89c0\u4e14\u5feb\u901f\u7684\u9ede\u64ca\u3002\u5728\u500b\u4eba\u96fb\u8166\u4e0a\uff0c\u904a\u6232\u53ef\u80fd\u4f7f\u7528\u6ed1\u9f20\u6216\u9375\u76e4\uff0c\u53ef\u4ee5\u63d0\u4f9b\u66f4\u7cbe\u78ba\u7684\u63a7\u5236\uff0c\u4f46\u53ef\u80fd\u611f\u89ba\u4e0d\u90a3\u9ebc\u81ea\u7136\u3002\u4f8b\u5982\uff0c\u5728\u884c\u52d5\u5e73\u53f0\u4e0a\uff0c\u6ed1\u52d5\u87a2\u5e55\u53ef\u4ee5\u8abf\u6574\u76f8\u6a5f\u89d2\u5ea6\uff0c\u800c\u5728\u500b\u4eba\u96fb\u8166\u4e0a\uff0c\u9019\u53ef\u80fd\u7531\u6ed1\u9f20\u6efe\u8f2a\u5b8c\u6210\u3002\u6b64\u5916\uff0c\u500b\u4eba\u96fb\u8166\u7248\u672c\u53ef\u80fd\u652f\u63f4\u66f4\u9ad8\u89e3\u6790\u5ea6\u548c\u53ef\u81ea\u8a02\u7684\u63a7\u5236\u9805\uff0c\u589e\u5f37\u6574\u9ad4\u9ad4\u9a57\u3002"}, {"question": "\u5982\u4f55\u5728Bouncemasters\u904a\u6232\u4e2d\u89e3\u9396\u96b1\u85cf\u95dc\u5361\uff1f", "answer": "\u5728Bouncemasters\u904a\u6232\u4e2d\u89e3\u9396\u96b1\u85cf\u95dc\u5361\u9700\u8981\u6eff\u8db3\u7279\u5b9a\u7684\u904a\u6232\u689d\u4ef6\u3002\u4f8b\u5982\uff0c\u5728\u7279\u5b9a\u95dc\u5361\u6536\u96c6\u6240\u6709\u786c\u5e63\u6216\u9054\u5230\u9ad8\u5206\u53ef\u80fd\u6703\u89f8\u767c\u96b1\u85cf\u95dc\u5361\u7684\u51fa\u73fe\u3002\u4f8b\u5982\uff0c\u5728 20 \u95dc\uff0c\u6536\u96c6\u6240\u6709\u786c\u5e63\u4e26\u64ca\u4e2d\u6bcf\u4e00\u500b\u76ee\u6a19\u5c07\u89e3\u9396\u4e00\u500b\u79d8\u5bc6\u734e\u52f5\u95dc\u5361\u3002\u7559\u610f\u74b0\u5883\u4e2d\u7684\u5fae\u5999\u63d0\u793a\uff0c\u4f8b\u5982\u4e0d\u5c0b\u5e38\u7684\u5716\u6848\u6216\u96b1\u85cf\u7684\u9053\u8def\u3002\u6b64\u5916\uff0c\u5b8c\u6210\u67d0\u4e9b\u6210\u5c31\u4e5f\u80fd\u7372\u5f97\u9019\u4e9b\u96b1\u85cf\u95dc\u5361\u7684\u901a\u8def\uff0c\u5e36\u4f86\u65b0\u7684\u6311\u6230\u548c\u734e\u52f5\u3002"}, {"question": "Bouncemasters\u904a\u6232\u4e2d\u500d\u6578\u7684\u610f\u7fa9\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5982\u4f55\u7dad\u6301\u5b83\uff1f", "answer": "Bouncemasters\u904a\u6232\u4e2d\u7684\u500d\u6578\u5c0d\u65bc\u6700\u5927\u5316\u5206\u6578\u81f3\u95dc\u91cd\u8981\u3002\u5b83\u6703\u96a8\u8457\u9023\u7e8c\u64ca\u4e2d\u76ee\u6a19\u6216\u6536\u96c6\u786c\u5e63\u800c\u589e\u52a0\uff0c\u4f46\u5982\u679c\u4f60\u932f\u904e\u76ee\u6a19\u6216\u5728\u52d5\u4f5c\u4e4b\u9593\u82b1\u8cbb\u592a\u591a\u6642\u9593\uff0c\u5b83\u6703\u6e1b\u5c11\u3002\u4f8b\u5982\uff0c\u9023\u7e8c\u64ca\u4e2d\u4e94\u500b\u76ee\u6a19\u6703\u5728\u77ed\u6642\u9593\u5167\u5c07\u5206\u6578\u589e\u52a0\u4e09\u500d\u3002\u70ba\u4e86\u7dad\u6301\u500d\u6578\uff0c\u5c08\u6ce8\u65bc\u4fdd\u6301\u7a69\u5b9a\u7684\u7bc0\u594f\uff0c\u4e26\u8a08\u5283\u4f60\u7684\u52d5\u4f5c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u6e1b\u5c11\u505c\u9813\u6642\u9593\u3002\u4f7f\u7528\u300c\u6642\u9593\u51cd\u7d50\u300d\u9053\u5177\u4f86\u5ef6\u9577\u4f60\u7684\u500d\u6578\u6301\u7e8c\u6642\u9593\uff0c\u4e26\u8ffd\u6c42\u9023\u9396\u53cd\u61c9\uff0c\u8b93\u5b83\u6301\u7e8c\u66f4\u9577\u6642\u9593\u3002"}, {"question": "\u70ba\u4f55Bouncemasters\u904a\u6232\u4e2d\u6709\u4e9b\u95dc\u5361\u8a2d\u8a08\u6709\u79fb\u52d5\u5e73\u53f0\uff0c\u4ee5\u53ca\u5b83\u5011\u5982\u4f55\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff1f", "answer": "Bouncemasters\u904a\u6232\u4e2d\u7684\u79fb\u52d5\u5e73\u53f0\u589e\u52a0\u4e86\u904a\u6232\u73a9\u6cd5\u7684\u984d\u5916\u6311\u6230\u548c\u7b56\u7565\u3002\u5b83\u5011\u9700\u8981\u7cbe\u78ba\u7684\u6642\u9593\u63a7\u5236\u548c\u9810\u6e2c\u624d\u80fd\u6210\u529f\u5c0e\u822a\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 35 \u95dc\uff0c\u79fb\u52d5\u5e73\u53f0\u53ef\u4ee5\u5e6b\u52a9\u4f60\u5230\u9054\u9ad8\u7a7a\u786c\u5e63\u7fa4\uff0c\u4f46\u662f\u932f\u904e\u5f48\u8df3\u6642\u9593\u53ef\u80fd\u6703\u4f7f\u7403\u504f\u96e2\u65b9\u5411\u3002\u9019\u4e9b\u5e73\u53f0\u8feb\u4f7f\u73a9\u5bb6\u8abf\u6574\u4ed6\u5011\u7684\u7b56\u7565\uff0c\u4e26\u5275\u9020\u6027\u5730\u904b\u7528\u74b0\u5883\u3002\u5b83\u5011\u4e5f\u70ba\u95dc\u5361\u589e\u6dfb\u4e86\u8b8a\u5316\uff0c\u907f\u514d\u904a\u6232\u8b8a\u5f97\u55ae\u8abf\uff0c\u4e26\u4fdd\u6301\u73a9\u5bb6\u7684\u53c3\u8207\u5ea6\u3002"}, {"question": "\u5982\u4f55\u5c07\u6211\u7684Bouncemasters\u904a\u6232\u9032\u5ea6\u5f9e\u4e00\u500b\u88dd\u7f6e\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u88dd\u7f6e\uff1f", "answer": "\u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u53ef\u4ee5\u5c07Bouncemasters\u904a\u6232\u9032\u5ea6\u5f9e\u4e00\u500b\u88dd\u7f6e\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u88dd\u7f6e\u3002\u9996\u5148\uff0c\u78ba\u4fdd\u4f60\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u767b\u5165\u76f8\u540c\u7684\u5e33\u6236\u3002\u7136\u5f8c\uff0c\u524d\u5f80\u8a2d\u5b9a\u9078\u55ae\u4e26\u9078\u64c7\u300c\u96f2\u7aef\u5132\u5b58\u300d\u9078\u9805\u4ee5\u4e0a\u50b3\u4f60\u7684\u9032\u5ea6\u3002\u5728\u65b0\u88dd\u7f6e\u4e0a\uff0c\u767b\u5165\u76f8\u540c\u7684\u5e33\u6236\u4e26\u4e0b\u8f09\u5132\u5b58\u7684\u8cc7\u6599\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5f9e iPhone \u5207\u63db\u5230 Android \u88dd\u7f6e\uff0c\u767b\u5165\u4f60\u7684 Google Play \u5e33\u6236\u61c9\u8a72\u5141\u8a31\u4f60\u5b58\u53d6\u4f60\u7684\u5132\u5b58\u9032\u5ea6\u3002\u59cb\u7d42\u5b9a\u671f\u5099\u4efd\u4f60\u7684\u8cc7\u6599\uff0c\u4ee5\u907f\u514d\u4efb\u4f55\u640d\u5931\u3002"}]
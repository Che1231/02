[{"question": "Bouncemasters\u521d\u5fc3\u8005\u5411\u3051\u30b5\u30dd\u30fc\u30c8\uff1a\u30da\u30f3\u30ae\u30f3\u3092\u3088\u308a\u9060\u304f\u3078\u98db\u3070\u3059\u306b\u306f\u3001\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u521d\u5fc3\u8005\u306e\u65b9\u3001\u3053\u3093\u306b\u3061\u306f\uff01\u30da\u30f3\u30ae\u30f3\u3092\u9060\u304f\u3078\u98db\u3070\u3059\u305f\u3081\u306b\u306f\u3001\u9069\u5207\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u529b\u52a0\u6e1b\u304c\u91cd\u8981\u3067\u3059\u3002\u6700\u9069\u306a\u6253\u6483\u30dd\u30a4\u30f3\u30c8\u306f\u3001\u30da\u30f3\u30ae\u30f3\u304c\u7740\u5730\u3057\u3088\u3046\u3068\u3057\u3066\u3044\u308b\u6642\u3001\u4f53\u52e2\u304c\u3084\u3084\u524d\u50be\u3057\u3066\u3044\u308b\u77ac\u9593\u3067\u3059\u3002\u3053\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u30d0\u30c3\u30c8\u3092\u632f\u308b\u3068\u3001\u6700\u5927\u306e\u63a8\u9032\u529b\u3092\u5f97\u3089\u308c\u307e\u3059\u3002\u30da\u30f3\u30ae\u30f3\u306e\u98db\u884c\u8ecc\u8de1\u3092\u89b3\u5bdf\u3057\u3001\u7740\u5730\u306e\u4e88\u60f3\u4f4d\u7f6e\u3092\u4e88\u6e2c\u3057\u3066\u304b\u3089\u3001\u30da\u30f3\u30ae\u30f3\u304c\u63a5\u8fd1\u3057\u3066\u304d\u305f\u3089\u3059\u3050\u306b\u753b\u9762\u3092\u30bf\u30c3\u30d7\u3057\u307e\u3057\u3087\u3046\u3002\u529b\u52a0\u6e1b\u306b\u95a2\u3057\u3066\u306f\u3001\u30da\u30f3\u30ae\u30f3\u304c\u843d\u4e0b\u3057\u3066\u3044\u308b\u6700\u4e2d\u306b\u529b\u30b2\u30fc\u30b8\u3092\u89b3\u5bdf\u3057\u3001\u30b2\u30fc\u30b8\u304c\u6700\u5927\u5024\u4ed8\u8fd1\u306b\u9054\u3057\u3066\u3044\u308b\u6642\u306b\u6253\u6483\u3059\u308b\u3068\u3001\u98db\u884c\u8ddd\u96e2\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u3002\u3010\u4f8b\u3048\u8a71\uff1a\u91ce\u7403\u306e\u30d0\u30c3\u30c6\u30a3\u30f3\u30b0\u3092\u60f3\u50cf\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u6700\u9069\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u30d0\u30c3\u30c8\u3092\u632f\u308b\u3053\u3068\u304c\u3001\u30db\u30fc\u30e0\u30e9\u30f3\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3011\u521d\u671f\u6bb5\u968e\u3067\u306f\u3001\u30d0\u30c3\u30c8\u306e\u300c\u30d1\u30ef\u30fc\u300d\u5c5e\u6027\u3092\u512a\u5148\u7684\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3068\u3001\u6253\u6483\u52b9\u679c\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6700\u521d\u306e\u30d0\u30c3\u30c8\u3067\u306f50m\u3057\u304b\u98db\u3070\u306a\u304b\u3063\u305f\u3068\u3057\u3066\u3082\u3001\u30d1\u30ef\u30fc\u3092\u4f55\u5ea6\u304b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3068\u3001100m\u3092\u697d\u3005\u8d85\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u307e\u305f\u3001\u30b2\u30fc\u30e0\u5185\u306b\u3042\u308b\u52a0\u901f\u30a2\u30a4\u30c6\u30e0\u3092\u5229\u7528\u3059\u308b\u3053\u3068\u3082\u8a66\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u306a\u305cBouncemasters\u3067\u30da\u30f3\u30ae\u30f3\u304c\u30d0\u30c3\u30c8\u304b\u3089\u5909\u306a\u5f3e\u304d\u65b9\u3092\u3057\u307e\u3059\u304b\uff1f\u305d\u308c\u3092\u9632\u3050\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30da\u30f3\u30ae\u30f3\u304c\u30d0\u30c3\u30c8\u304b\u3089\u5909\u306a\u5f3e\u304d\u65b9\u3092\u3059\u308b\u306e\u306f\u3001\u30a4\u30f3\u30d1\u30af\u30c8\u306e\u89d2\u5ea6\u3068\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u95a2\u4fc2\u3057\u3066\u3044\u307e\u3059\u3002\u30da\u30f3\u30ae\u30f3\u3092\u65e9\u3059\u304e\u305f\u308a\u3001\u9045\u3059\u304e\u305f\u308a\u3001\u307e\u305f\u306f\u30d0\u30c3\u30c8\u304c\u6b63\u78ba\u306b\u5408\u3063\u3066\u3044\u306a\u3044\u3068\u3001\u5f31\u3044\u3001\u307e\u305f\u306f\u4e0d\u898f\u5247\u306a\u5f3e\u304d\u65b9\u306b\u306a\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3092\u9632\u3050\u306b\u306f\u3001\u30d0\u30c3\u30c8\u306e\u4e2d\u5fc3\u3001\u3064\u307e\u308a\u30b9\u30a4\u30fc\u30c8\u30b9\u30dd\u30c3\u30c8\u3067\u30da\u30f3\u30ae\u30f3\u3092\u6253\u3064\u3053\u3068\u306b\u96c6\u4e2d\u3057\u307e\u3057\u3087\u3046\u3002\u307e\u305f\u3001\u30d0\u30c3\u30c8\u306e\u300c\u6b63\u78ba\u6027\u300d\u5c5e\u6027\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3053\u3068\u3092\u691c\u8a0e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u8aa4\u3063\u305f\u6253\u6483\u306b\u3088\u308b\u78ba\u7387\u304c\u6e1b\u5c11\u3057\u307e\u3059\u3002\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u3092\u4f7f\u3063\u3066\u3001\u3088\u308a\u826f\u3044\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5f97\u308b\u3053\u3068\u3082\u8a66\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u3001\u30da\u30f3\u30ae\u30f3\u3092\u6253\u3061\u3084\u3059\u3044\u7406\u60f3\u7684\u306a\u77ac\u9593\u306e\u76f4\u524d\u306b\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u3092\u30a2\u30af\u30c6\u30a3\u30d6\u5316\u3059\u308b\u3068\u3001\u5b8c\u74a7\u306a\u30b9\u30c8\u30e9\u30a4\u30af\u3092\u8a2d\u5b9a\u3057\u3001\u4e00\u8cab\u6027\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u53c2\u7167\u8868\uff1a\u521d\u671f\u30d0\u30c3\u30c8\uff1a\u7cbe\u5ea6\u304c\u4f4e\u304f\u3001\u30df\u30b9\u304c\u591a\u3044\u3001\u5f37\u5316\u30d0\u30c3\u30c8\uff1a\u7cbe\u5ea6\u304c\u9ad8\u304f\u3001\u5b89\u5b9a\u3057\u305f\u6253\u6483]"}, {"question": "Bouncemasters\u3067\u30b3\u30a4\u30f3\u3092\u52b9\u7387\u7684\u306b\u7372\u5f97\u3059\u308b\u306b\u306f\u3001\u901a\u5e38\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4ee5\u5916\u306b\u3001\u96a0\u3055\u308c\u305f\u65b9\u6cd5\u306f\u3042\u308b\u3067\u3057\u3087\u3046\u304b\uff1f", "answer": "\u901a\u5e38\u30d7\u30ec\u30a4\u3067\u30b3\u30a4\u30f3\u3092\u7372\u5f97\u3059\u308b\u4ed6\u306b\u3001\u30b2\u30fc\u30e0\u306b\u306f\u96a0\u3055\u308c\u305f\u30b3\u30a4\u30f3\u7372\u5f97\u65b9\u6cd5\u304c\u3042\u308a\u307e\u3059\u30021\u3064\u306f\u3001\u30c7\u30a4\u30ea\u30fc\u30df\u30c3\u30b7\u30e7\u30f3\u3084\u5b9f\u7e3e\u306b\u6ce8\u610f\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u3053\u308c\u3089\u306e\u9054\u6210\u3067\u3001\u8ffd\u52a0\u306e\u30b3\u30a4\u30f3\u5831\u916c\u304c\u5f97\u3089\u308c\u307e\u3059\u3002\u3082\u3046\u4e00\u3064\u306f\u3001\u5e83\u544a\u8996\u8074\u3067\u3059\u3002\u30b2\u30fc\u30e0\u306f\u4e0d\u5b9a\u671f\u306b\u5e83\u544a\u8996\u8074\u3067\u30b3\u30a4\u30f3\u3092\u7372\u5f97\u3059\u308b\u6a5f\u4f1a\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u3088\u308a\u52b9\u679c\u7684\u306a\u65b9\u6cd5\u306f\u3001\u521d\u671f\u6bb5\u968e\u3067\u3001\u5f3e\u9053\u306e\u8ddd\u96e2\u3068\u30b3\u30a4\u30f3\u53ce\u5165\u306e\u5897\u52a0\u30dc\u30fc\u30ca\u30b9\u3092\u91cd\u70b9\u7684\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u30b3\u30a4\u30f3\u53ce\u5165\u306e\u5897\u52a0\u30dc\u30fc\u30ca\u30b9\u3092\u512a\u5148\u7684\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3068\u3001\u8ca1\u7523\u3092\u6025\u901f\u306b\u84c4\u7a4d\u3067\u304d\u307e\u3059\u3002\u6280\u8853\u7684\u306a\u9762\u3067\u306f\u3001\u30d1\u30fc\u30d5\u30a7\u30af\u30c8\u30d2\u30c3\u30c8\u3092\u72d9\u3046\u3068\u3001\u8ffd\u52a0\u306e\u30b3\u30a4\u30f3\u5831\u916c\u304c\u5f97\u3089\u308c\u307e\u3059\u3002\u5b8c\u74a7\u306a\u30da\u30f3\u30ae\u30f3\u30d2\u30c3\u30c8\u306b\u306f\u7279\u6b8a\u306a\u97f3\u3068\u8996\u899a\u52b9\u679c\u306e\u30d2\u30f3\u30c8\u304c\u3042\u308a\u307e\u3059\u3002\u3010\u69d8\u3005\u306a\u65b9\u6cd5\u306e\u6bd4\u8f03\uff1a\u666e\u901a\u306e\u6253\u648310\u30b3\u30a4\u30f3\u3001\u5b8c\u74a7\u306a\u6253\u648320\u30b3\u30a4\u30f3\u3001\u5e83\u544a\u8996\u807450\u30b3\u30a4\u30f3\u3011 \u305d\u306e\u4ed6\u3001\u30b2\u30fc\u30e0\u306e\u516c\u5f0f\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u3084\u30a4\u30d9\u30f3\u30c8\u306b\u3082\u6ce8\u76ee\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u5834\u5408\u306b\u3088\u3063\u3066\u306f\u3001\u30b3\u30a4\u30f3\u304c\u8d08\u3089\u308c\u305f\u308a\u3057\u307e\u3059\u3002"}, {"question": "Bouncemasters\u306e\u9ad8\u5ea6\u306a\u30c6\u30af\u30cb\u30c3\u30af\uff1a\u5730\u5f62\u3068\u52d5\u7269\u3092\u4f7f\u3063\u3066\u98db\u884c\u8ddd\u96e2\u3092\u4f38\u3070\u3059\u306b\u306f\uff1f", "answer": "\u98db\u884c\u8ddd\u96e2\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u306b\u306f\u3001\u30b2\u30fc\u30e0\u5185\u306e\u5730\u5f62\u3068\u52d5\u7269\u3092\u5de7\u307f\u306b\u6d3b\u7528\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u7279\u5b9a\u306e\u5730\u5f62\u3067\u306f\u4e0a\u6607\u6c17\u6d41\u304c\u767a\u751f\u3057\u3001\u30da\u30f3\u30ae\u30f3\u306b\u4f59\u5206\u306a\u63da\u529b\u3092\u4e0e\u3048\u307e\u3059\u3002\u4e00\u90e8\u306e\u52d5\u7269\u3001\u4f8b\u3048\u3070\u30ab\u30e2\u30e1\u306f\u3001\u30da\u30f3\u30ae\u30f3\u304c\u885d\u7a81\u3059\u308b\u3068\u3001\u8ffd\u52a0\u306e\u53cd\u767a\u529b\u3092\u3082\u305f\u3089\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30de\u30c3\u30d7\u3092\u628a\u63e1\u3057\u3001\u91cd\u8981\u306a\u5730\u5f62\u3068\u52d5\u7269\u306e\u4f4d\u7f6e\u3092\u899a\u3048\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u98db\u884c\u4e2d\u306b\u98db\u884c\u65b9\u5411\u3092\u8abf\u6574\u3057\u3001\u4e0a\u6607\u6c17\u6d41\u3068\u52d5\u7269\u7fa4\u306b\u53ef\u80fd\u306a\u9650\u308a\u8fd1\u3065\u3051\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u52a0\u901f\u30a2\u30a4\u30c6\u30e0\u3092\u4f7f\u3063\u3066\u98db\u884c\u8ecc\u8de1\u3092\u8abf\u6574\u3057\u3001\u30da\u30f3\u30ae\u30f3\u304c\u76ee\u6a19\u306b\u6b63\u78ba\u306b\u885d\u7a81\u3059\u308b\u3088\u3046\u306b\u3059\u308b\u3002\u5178\u578b\u7684\u4f8b\u3068\u3057\u3066\u306f\u3001\u6c37\u5c71\u5730\u5f62\u3067\u306f\u3001\u4e0a\u6607\u6c17\u6d41\u3092\u5229\u7528\u3057\u3066\u9577\u3044\u8ddd\u96e2\u3092\u697d\u306b\u98db\u3073\u8d8a\u3048\u3001\u3055\u3089\u306b\u30ab\u30e2\u30e1\u7fa4\u306b\u885d\u7a81\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u9060\u304f\u307e\u3067\u98db\u3076\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3010\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u98db\u884c\u2192\u6c17\u6d41/\u52d5\u7269\u306b\u63a5\u8fd1\u2192\u52a0\u901f\u8abf\u6574\u2192\u6b63\u78ba\u306a\u885d\u7a81\u2192\u8ddd\u96e2\u306e\u5897\u52a0\u3011"}, {"question": "Bouncemasters\u3067\u3001\u7570\u306a\u308b\u30d0\u30c3\u30c8\u306f\u3069\u306e\u3088\u3046\u306a\u9055\u3044\u304c\u3042\u308a\u307e\u3059\u304b\uff1f\u3069\u308c\u304c\u6700\u9ad8\u306e\u6027\u80fd\u3067\u3001\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "Bouncemasters\u306e\u30d0\u30c3\u30c8\u306f\u3001\u30d1\u30ef\u30fc\u3001\u53cd\u767a\u529b\u3001\u7a7a\u6c17\u529b\u5b66\u3001\u6b63\u78ba\u6027\u306a\u3069\u306e\u7570\u306a\u308b\u7d71\u8a08\u5024\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002 \u300c\u6700\u9ad8\u306e\u300d\u30d0\u30c3\u30c8\u306f\u3001\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u3068\u76ee\u6a19\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u3002\u521d\u671f\u6bb5\u968e\u3067\u306f\u3001\u6700\u5927\u9650\u306e\u8ddd\u96e2\u3092\u51fa\u3059\u305f\u3081\u306b\u9ad8\u30d1\u30ef\u30fc\u306e\u30d0\u30c3\u30c8\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u305d\u306e\u5f8c\u3001\u4e00\u8cab\u3057\u305f\u30d2\u30c3\u30c8\u3068\u30b3\u30f3\u30dc\u30c1\u30a7\u30fc\u30f3\u3092\u884c\u3046\u305f\u3081\u306b\u3001\u6b63\u78ba\u6027\u304c\u91cd\u8981\u306b\u306a\u308a\u307e\u3059\u3002\u30d0\u30c3\u30c8\u306e\u7d71\u8a08\u60c5\u5831\u306f\u3001\u88c5\u5099\u3057\u3066\u3044\u308b\u73fe\u5728\u306e\u30d0\u30c3\u30c8\u3068\u6bd4\u8f03\u3057\u3066\u8868\u793a\u3055\u308c\u307e\u3059\u3002\u5229\u7528\u53ef\u80fd\u306a\u30d0\u30c3\u30c8\u3092\u6bd4\u8f03\u3057\u3001\u5bfe\u5fdc\u3059\u308b\u30d0\u30c3\u30c8\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6700\u7d42\u76ee\u6a19\u306b\u5408\u81f4\u3059\u308b\u30d0\u30c3\u30c8\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30b5\u30f3\u30c0\u30fc\u30af\u30e9\u30d6\u300d\u30d0\u30c3\u30c8\u306f\u30da\u30f3\u30ae\u30f3\u306b\u30d2\u30c3\u30c8\u3059\u308b\u3068\u5927\u5e45\u306a\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u3001\u8ffd\u52a0\u306e\u7bc4\u56f2\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002 [\u53c2\u7167\u8868\uff1a\u30d0\u30c3\u30c8\u306e\u7a2e\u985e - \u5c5e\u6027\u306e\u91cd\u70b9 - \u9069\u7528\u30b7\u30ca\u30ea\u30aa]"}, {"question": "Bouncemasters\u306e\u30c7\u30fc\u30bf\u5206\u6790\uff1a\u30da\u30f3\u30ae\u30f3\u306e\u98db\u884c\u8ddd\u96e2\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u91cd\u8981\u306a\u30d1\u30e9\u30e1\u30fc\u30bf\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u308c\u3089\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30da\u30f3\u30ae\u30f3\u306e\u98db\u884c\u8ddd\u96e2\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u91cd\u8981\u306a\u30d1\u30e9\u30e1\u30fc\u30bf\u306f\u3001\u4ee5\u4e0b\u306e\u5e7e\u3064\u304b\u306e\u70b9\u3067\u3059\u3002\u30d0\u30c3\u30c8\u306e\u30d1\u30ef\u30fc\u5c5e\u6027\u3001\u6253\u6483\u6642\u306e\u529b\u52a0\u6e1b\u3001\u30da\u30f3\u30ae\u30f3\u306e\u521d\u671f\u901f\u5ea6\u3001\u98db\u884c\u4e2d\u306e\u7a7a\u6c17\u62b5\u6297\u3001\u5730\u5f62\u3084\u52d5\u7269\u306e\u5f71\u97ff\u3002\u30d0\u30c3\u30c8\u306e\u30d1\u30ef\u30fc\u5c5e\u6027\u3092\u4e0a\u3052\u308b\u3053\u3068\u306f\u57fa\u790e\u3067\u3059\u3002\u3088\u308a\u9ad8\u3044\u30d1\u30ef\u30fc\u5c5e\u6027\u3068\u7a7a\u6c17\u529b\u5b66\u6027\u80fd\u3092\u6301\u3064\u30d0\u30c3\u30c8\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u98db\u884c\u901f\u5ea6\u3092\u5bb9\u6613\u306b\u4e0a\u3052\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u6253\u6483\u6642\u306e\u529b\u52a0\u6e1b\u306f\u6b63\u78ba\u306b\u628a\u63e1\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b2\u30fc\u30b8\u304c\u6700\u5927\u5024\u306b\u9054\u3057\u3066\u3044\u308b\u6642\u306b\u6253\u3064\u3088\u3046\u306b\u3057\u307e\u3057\u3087\u3046\u3002\u3055\u3089\u306b\u3001\u30da\u30f3\u30ae\u30f3\u306e\u521d\u671f\u901f\u5ea6\u3082\u91cd\u8981\u3067\u3059\u3002\u30da\u30f3\u30ae\u30f3\u306e\u52a0\u901f\u5c5e\u6027\u3092\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u3057\u3066\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u98db\u884c\u4e2d\u306b\u3001\u5730\u5f62\u3084\u52d5\u7269\u3092\u6d3b\u7528\u3057\u3066\u7a7a\u6c17\u62b5\u6297\u3092\u6e1b\u3089\u3057\u3001\u8ffd\u52a0\u306e\u63a8\u9032\u529b\u3092\u5f97\u308b\u3053\u3068\u3092\u76ee\u6307\u3057\u307e\u3057\u3087\u3046\u3002\u3053\u308c\u3089\u306e\u30d1\u30e9\u30e1\u30fc\u30bf\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u3042\u308b\u5074\u9762\u3060\u3051\u306b\u6ce8\u610f\u3059\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u7dcf\u5408\u7684\u306b\u8003\u616e\u3057\u3001\u30d0\u30e9\u30f3\u30b9\u30dd\u30a4\u30f3\u30c8\u3092\u898b\u3064\u3051\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3010\u4f8b\u3048\u8a71\uff1a\u30ec\u30fc\u30b7\u30f3\u30b0\u30ab\u30fc\u3092\u7d44\u7acb\u3066\u308b\u3088\u3046\u306b\u3001\u30a8\u30f3\u30b8\u30f3\u3001\u30b7\u30e3\u30b7\u30fc\u3001\u30bf\u30a4\u30e4\u306a\u3069\u306e\u5404\u90e8\u54c1\u306e\u6027\u80fd\u3092\u30d0\u30e9\u30f3\u30b9\u3055\u305b\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3011"}, {"question": "Bouncemasters\u306e\u9054\u6210\u30b7\u30b9\u30c6\u30e0\u306e\u6df1\u3044\u5206\u6790\uff1a\u9054\u6210\u3059\u308b\u306e\u304c\u6700\u3082\u96e3\u3057\u3044\u5b9f\u7e3e\u306f\u3069\u308c\u3067\u3059\u304b\uff1f\u305d\u308c\u3089\u3092\u9054\u6210\u3059\u308b\u306b\u306f\u3069\u306e\u3088\u3046\u306a\u30c6\u30af\u30cb\u30c3\u30af\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "Bouncemasters\u306e\u9054\u6210\u30b7\u30b9\u30c6\u30e0\u306b\u306f\u69d8\u3005\u306a\u6311\u6226\u304c\u3042\u308a\u307e\u3059\u3002\u3042\u308b\u5b9f\u7e3e\u306f\u9ad8\u3044\u96e3\u6613\u5ea6\u3067\u3001\u3042\u308b\u7a0b\u5ea6\u306e\u6280\u8853\u3068\u5fcd\u8010\u304c\u5fc5\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u4e00\u767a\u30af\u30ea\u30a2\u300d\u5b9f\u7e3e\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u4e00\u5ea6\u306e\u98db\u884c\u3067\u975e\u5e38\u306b\u9060\u304f\u307e\u3067\u98db\u3076\u5fc5\u8981\u304c\u3042\u308b\u305f\u3081\u3001\u30d0\u30c3\u30c8\u3068\u30da\u30f3\u30ae\u30f3\u306e\u5c5e\u6027\u3092\u6700\u9069\u5316\u3057\u3001\u5730\u5f62\u3068\u52d5\u7269\u3092\u5de7\u307f\u306b\u6d3b\u7528\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u9054\u6210\u30c6\u30af\u30cb\u30c3\u30af\uff1a\u2460\u9069\u5207\u306a\u30d0\u30c3\u30c8\u3092\u9078\u629e\u3057\u3001\u30d1\u30ef\u30fc\u3068\u6b63\u78ba\u6027\u5c5e\u6027\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u2461\u30da\u30f3\u30ae\u30f3\u306e\u52a0\u901f\u5c5e\u6027\u3092\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u3057\u3066\u521d\u671f\u901f\u5ea6\u3092\u4e0a\u3052\u307e\u3059\u3002\u2462\u30de\u30c3\u30d7\u3092\u719f\u77e5\u3057\u3001\u9069\u5207\u306a\u4e0a\u6607\u6c17\u6d41\u3068\u52d5\u7269\u7fa4\u3092\u898b\u3064\u3051\u307e\u3059\u3002\u2463\u52a0\u901f\u30a2\u30a4\u30c6\u30e0\u3092\u4f7f\u7528\u3057\u3066\u3001\u98db\u884c\u8ecc\u8de1\u3092\u8abf\u6574\u3057\u3001\u30da\u30f3\u30ae\u30f3\u304c\u76ee\u6a19\u306b\u6b63\u78ba\u306b\u885d\u7a81\u3059\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002\u300c\u7121\u50b7\u30af\u30ea\u30a2\u300d\u5b9f\u7e3e\u306f\u3001\u3069\u306e\u969c\u5bb3\u7269\u306b\u3082\u89e6\u308c\u305a\u306b\u98db\u884c\u3092\u5b8c\u4e86\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u3001\u64cd\u4f5c\u306b\u9ad8\u3044\u6280\u8853\u529b\u304c\u5fc5\u8981\u3067\u3059\u3002\u7df4\u7fd2\u30e2\u30fc\u30c9\u3067\u7e70\u308a\u8fd4\u3057\u7df4\u7fd2\u3057\u3001\u98db\u884c\u8ecc\u8de1\u306e\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3092\u7fd2\u5f97\u3059\u308b\u3053\u3068\u3092\u304a\u52e7\u3081\u3057\u307e\u3059\u3002\u3010\u69d8\u3005\u306a\u65b9\u6cd5\u306e\u6bd4\u8f03\uff1a\u901a\u5e38\u30e2\u30fc\u30c9\u306f\u96e3\u6613\u5ea6\u304c\u9ad8\u3044\u3001\u7df4\u7fd2\u30e2\u30fc\u30c9\u3067\u306f\u7e70\u308a\u8fd4\u3057\u8a66\u884c\u53ef\u80fd\u3001\u30a2\u30a4\u30c6\u30e0\u3092\u4f7f\u7528\u3059\u308b\u3068\u96e3\u6613\u5ea6\u304c\u4e0b\u304c\u308b\u3011"}, {"question": "Bouncemasters\u3067\u30da\u30f3\u30ae\u30f3\u306e\u901f\u5ea6\u3092\u5de6\u53f3\u3059\u308b\u57fa\u672c\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f\u901f\u5ea6\u3092\u64cd\u4f5c\u3059\u308b\u305f\u3081\u306e\u96a0\u3057\u30c6\u30af\u30cb\u30c3\u30af\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u57fa\u672c\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u521d\u671f\u306e\u6253\u3061\u51fa\u3057\u901f\u5ea6\uff08\u30d0\u30c3\u30c8\u306e\u30d1\u30ef\u30fc\u3068\u30da\u30f3\u30ae\u30f3\u7279\u6027\u306b\u3088\u3063\u3066\u6c7a\u307e\u308b\uff09\u3001\u5916\u90e8\u8981\u56e0\uff08\u52d5\u7269\u3084\u98a8\uff09\u3001\u305d\u3057\u3066\u7a7a\u6c17\u62b5\u6297\u306e\u7d44\u307f\u5408\u308f\u305b\u3067\u3059\u3002\u901f\u5ea6\u3092\u64cd\u4f5c\u3059\u308b\u306b\u306f\u3001\u30d0\u30c3\u30c8\u306e\u30d1\u30ef\u30fc\u3068\u30da\u30f3\u30ae\u30f3\u306e\u521d\u671f\u901f\u5ea6\u306e\u4e21\u65b9\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3057\u3087\u3046\u3002\u3055\u3089\u306b\u3001\u5730\u5f62\u3092\u5b66\u7fd2\u3057\u3001\u4e0a\u6607\u6c17\u6d41\u3084\u52d5\u7269\u3092\u8df3\u306d\u8fd4\u3059\u3053\u3068\u3092\u7fd2\u5f97\u3057\u307e\u3057\u3087\u3046\u3002\u4e00\u90e8\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u3053\u308c\u3089\u306e\u74b0\u5883\u8981\u7d20\u306b\u5408\u308f\u305b\u3066\u30d6\u30fc\u30b9\u30c8\u3092\u30bf\u30a4\u30df\u30f3\u30b0\u3088\u304f\u4f7f\u3046\u3053\u3068\u3067\u6700\u9ad8\u306e\u901f\u5ea6\u3092\u51fa\u3057\u3066\u3044\u308b\u3088\u3046\u3067\u3059\u3002\u7c21\u5358\u306b\u4f7f\u3048\u308b\u300c\u96a0\u3057\u30c6\u30af\u30cb\u30c3\u30af\u300d\u3084\u300c\u30d0\u30b0\u300d\u306f\u5b58\u5728\u3057\u307e\u305b\u3093\u304c\u3001\u5730\u5f62\u3092\u5de7\u307f\u306b\u6d3b\u7528\u3057\u3001\u30d6\u30fc\u30b9\u30c8\u3092\u9069\u5207\u306b\u4f7f\u3046\u3053\u3068\u304c\u4f9d\u7136\u3068\u3057\u3066\u91cd\u8981\u3067\u3059\u3002[\u53c2\u7167\u8868\uff1a\u521d\u671f\u901f\u5ea6 - \u57fa\u672c\u901f\u5ea6\u3001\u5916\u90e8\u8981\u56e0 - \u52a0\u901f\u5ea6/\u6e1b\u901f\u5ea6\u3001\u6700\u7d42\u901f\u5ea6 - \u8ddd\u96e2]"}, {"question": "Bouncemasters\u306e\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u95a2\u3059\u308b\u7591\u554f\uff1aAndroid\u3068iOS\u306e\u30c7\u30fc\u30bf\u306f\u5171\u6709\u3067\u304d\u307e\u3059\u304b\uff1f\u53ef\u80fd\u306a\u3089\u3070\u3001\u3069\u306e\u3088\u3046\u306b\u64cd\u4f5c\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u7533\u3057\u8a33\u3042\u308a\u307e\u305b\u3093\u304c\u3001Bouncemasters\u306eAndroid\u3068iOS\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u30c7\u30fc\u30bf\u306f\u901a\u5e38\u5171\u6709\u3067\u304d\u307e\u305b\u3093\u3002\u3053\u308c\u306f\u3001Android\u30c7\u30d0\u30a4\u30b9\u3067\u306e\u30b2\u30fc\u30e0\u306e\u9032\u6357\u72b6\u6cc1\u3092iOS\u30c7\u30d0\u30a4\u30b9\u306b\u76f4\u63a5\u79fb\u884c\u3067\u304d\u306a\u3044\u3053\u3068\u3092\u610f\u5473\u3057\u307e\u3059\u3002\u305f\u3060\u3057\u3001\u4e00\u90e8\u306e\u30b2\u30fc\u30e0\u3067\u306f\u3001Facebook\u307e\u305f\u306fGoogle Play\u30a2\u30ab\u30a6\u30f3\u30c8\u306a\u3069\u306e\u30a2\u30ab\u30a6\u30f3\u30c8\u30d0\u30a4\u30f3\u30c9\u6a5f\u80fd\u304c\u63d0\u4f9b\u3055\u308c\u3066\u3044\u307e\u3059\u3002Bouncemasters\u304c\u3053\u306e\u6a5f\u80fd\u3092\u63d0\u4f9b\u3057\u3066\u3044\u308b\u5834\u5408\u306f\u3001\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30d0\u30a4\u30f3\u30c9\u3057\u3066\u30c7\u30fc\u30bf\u306e\u540c\u671f\u3092\u8a66\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b2\u30fc\u30e0\u304c\u30af\u30e9\u30a6\u30c9\u30bb\u30fc\u30d6\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u308b\u5834\u5408\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u5207\u308a\u66ff\u3048\u3066\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3068\u3001\u30af\u30e9\u30a6\u30c9\u304b\u3089\u30ed\u30fc\u30c9\u3057\u3066\u30ed\u30fc\u30ab\u30eb\u30bb\u30fc\u30d6\u3092\u4e0a\u66f8\u304d\u3059\u308b\u304b\u3092\u9078\u629e\u3059\u308b\u304b\u3092\u805e\u304b\u308c\u308b\u306e\u3067\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u30c7\u30fc\u30bf\u5171\u6709\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u6b63\u78ba\u306a\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30c7\u30fc\u30bf\u540c\u671f\u60c5\u5831\u306b\u3064\u3044\u3066\u306f\u3001\u30b2\u30fc\u30e0\u306e\u516c\u5f0fFAQ\u307e\u305f\u306f\u30ab\u30b9\u30bf\u30de\u30fc\u30b5\u30fc\u30d3\u30b9\u306b\u304a\u554f\u3044\u5408\u308f\u305b\u304f\u3060\u3055\u3044\u3002\u3010\u7559\u610f\u4e8b\u9805\uff1a\u64cd\u4f5c\u3059\u308b\u524d\u306b\u3001\u4e07\u304c\u4e00\u306e\u5834\u5408\u306b\u5099\u3048\u3066\u3001\u30ed\u30fc\u30ab\u30eb\u30bb\u30fc\u30d6\u3092\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u3057\u3066\u304f\u3060\u3055\u3044\u3011"}, {"question": "Bouncemasters\u306e\u96a0\u3057\u8981\u7d20\u3092\u63a2\u6c42\uff1a\u30b2\u30fc\u30e0\u5185\u306b\u96a0\u3055\u308c\u305f\u30da\u30f3\u30ae\u30f3\u30ad\u30e3\u30e9\u3084\u7279\u6b8a\u306a\u30ec\u30d9\u30eb\u306f\u3042\u308a\u307e\u3059\u304b\uff1f\u305d\u308c\u3089\u306f\u3069\u3046\u3084\u3063\u3066\u767a\u898b\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Bouncemasters\u306b\u306f\u3001\u5b9f\u969b\u306b\u96a0\u3055\u308c\u305f\u30da\u30f3\u30ae\u30f3\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3084\u7279\u5225\u306a\u30ec\u30d9\u30eb\u304c\u3044\u304f\u3064\u304b\u3042\u308a\u307e\u3059\u3002\u3057\u304b\u3057\u3001\u30c8\u30ea\u30ac\u30fc\u6761\u4ef6 \u306f\u96a0\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u53ef\u80fd\u6027\u306e\u4e00\u3064\u306f\u3001\u7279\u5b9a\u306e\u5b9f\u7e3e\u3092\u9054\u6210\u3057\u305f\u308a\u3001\u96a0\u3057\u30df\u30c3\u30b7\u30e7\u30f3\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3067\u3001\u65b0\u3057\u3044\u30da\u30f3\u30ae\u30f3\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002 \u3082\u3046\u4e00\u65b9\u306e\u8003\u3048\u3089\u308c\u308b\u65b9\u6cd5\u306f\u3001\u30b2\u30fc\u30e0\u306e\u7279\u5b9a\u306e\u5834\u6240\u3084\u74b0\u5883\u3067\u3001\u7279\u5b9a\u306e\u9806\u5e8f\u3084\u65b9\u6cd5\u3067\u64cd\u4f5c\u3059\u308b\u3068\u3001\u96a0\u3055\u308c\u305f\u30ec\u30d9\u30eb\u3092\u8d77\u52d5\u3067\u304d\u308b\u3053\u3068\u3067\u3059\u3002\u4f8b\u3068\u3057\u3066\u3001\u7279\u5b9a\u306eNPC\u3092\u7e70\u308a\u8fd4\u3057\u30bf\u30c3\u30d7\u3057\u305f\u308a\u3001\u7279\u5b9a\u306e\u6642\u9593\u5185\u306b\u8907\u6570\u306e\u30bf\u30b9\u30af\u3092\u7d99\u7d9a\u3057\u3066\u5b8c\u4e86\u3057\u305f\u308a\u3059\u308b\u306a\u3069\u3067\u3059\u3002\u4e00\u822c\u7684\u306b\u3001\u516c\u5f0f\u5074\u306f\u3053\u308c\u3089\u306e\u96a0\u3055\u308c\u305f\u5185\u5bb9\u306e\u5177\u4f53\u7684\u306a\u30c8\u30ea\u30ac\u30fc\u65b9\u6cd5\u3092\u516c\u958b\u3059\u308b\u3053\u3068\u306f\u306a\u3044\u306e\u3067\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u81ea\u3089\u63a2\u6c42\u3057\u3001\u8a66\u3057\u3066\u307f\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u306e\u30b2\u30fc\u30e0\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u3067\u3084\u308a\u53d6\u308a\u3057\u3001\u6d1e\u5bdf\u3092\u4ea4\u63db\u3059\u308b\u3053\u3068\u3067\u3001\u30d2\u30f3\u30c8\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u904e\u53bb\u306e\u7d4c\u9a13\u304b\u3089\u3059\u308b\u3068\u3001\u4f11\u65e5\u306b\u306f\u3001\u516c\u5f0f\u5074\u304c\u65b0\u3057\u3044\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3084\u30ec\u30d9\u30eb\u3092\u542b\u3080\u671f\u9593\u9650\u5b9a\u30a4\u30d9\u30f3\u30c8\u3092\u5b9f\u65bd\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3010\u4f8b\u3048\u8a71\uff1a\u5b9d\u63a2\u3057\u30b2\u30fc\u30e0\u306e\u3088\u3046\u306b\u3001\u5b9d\u3092\u898b\u3064\u3051\u308b\u306b\u306f\u3001\u5fcd\u8010\u3068\u6ce8\u610f\u6df1\u3044\u89b3\u5bdf\u304c\u5fc5\u8981\u3067\u3059\u3011"}]
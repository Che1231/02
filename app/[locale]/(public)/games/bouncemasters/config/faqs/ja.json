[{"question": "\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001\u30d0\u30a6\u30f3\u30b9\u30de\u30b9\u30bf\u30fc\u30ba\u3067\u30dc\u30fc\u30eb\u306e\u8ecc\u9053\u3092\u3069\u306e\u3088\u3046\u306b\u5236\u5fa1\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30a6\u30f3\u30b9\u30de\u30b9\u30bf\u30fc\u30ba\u3067\u30dc\u30fc\u30eb\u306e\u8ecc\u9053\u3092\u5236\u5fa1\u3059\u308b\u306b\u306f\u3001\u307e\u305a\u57fa\u672c\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u304b\u3089\u59cb\u3081\u307e\u3059\u3002\u753b\u9762\u3092\u30bf\u30c3\u30d7\u3059\u308b\u3068\u3001\u30dc\u30fc\u30eb\u306f\u30bf\u30c3\u30d7\u306e\u65b9\u5411\u306b\u8df3\u306d\u8fd4\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30dc\u30fc\u30eb\u306e\u5c11\u3057\u53f3\u3092\u30bf\u30c3\u30d7\u3059\u308b\u3068\u3001\u30dc\u30fc\u30eb\u306f\u53f3\u659c\u3081\u306b\u8df3\u306d\u8fd4\u308a\u307e\u3059\u3002\u521d\u671f\u306e\u30ec\u30d9\u30eb\u3067\u7df4\u7fd2\u3057\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u89d2\u5ea6\u306b\u6163\u308c\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002\u3055\u3089\u306b\u3001\u74b0\u5883\u3092\u6709\u5229\u306b\u6d3b\u7528\u3057\u307e\u3057\u3087\u3046\u3002\u58c1\u306b\u8df3\u306d\u8fd4\u308b\u3053\u3068\u3067\u30dc\u30fc\u30eb\u306e\u8ecc\u9053\u3092\u5909\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u91cd\u8981\u306a\u306e\u306f\u3001\u30dc\u30fc\u30eb\u306e\u7740\u5730\u70b9\u3092\u4e88\u6e2c\u3057\u3001\u6b21\u306e\u52d5\u304d\u3092\u8a08\u753b\u3059\u308b\u3053\u3068\u3067\u3059\u3002"}, {"question": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u30d0\u30a6\u30f3\u30b9\u30de\u30b9\u30bf\u30fc\u30ba\u3067\u9ad8\u5f97\u70b9\u3092\u53d6\u308b\u305f\u3081\u306e\u6700\u9069\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d0\u30a6\u30f3\u30b9\u30de\u30b9\u30bf\u30fc\u30ba\u3067\u9577\u6642\u9593\u306e\u30d7\u30ec\u30a4\u5f8c\u306b\u9ad8\u5f97\u70b9\u3092\u53d6\u308b\u305f\u3081\u306b\u306f\u3001\u9ad8\u5ea6\u306a\u6226\u7565\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u8907\u6570\u306e\u30bf\u30fc\u30b2\u30c3\u30c8\u3092\u9023\u7d9a\u3057\u3066\u7d20\u65e9\u304f\u30d2\u30c3\u30c8\u3059\u308b\u3053\u3068\u3067\u3001\u9023\u9396\u53cd\u5fdc\u306b\u96c6\u4e2d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b3\u30a4\u30f3\u3092\u5f15\u304d\u5bc4\u305b\u308b\u300c\u78c1\u77f3\u300d\u3084\u969c\u5bb3\u7269\u3092\u9045\u304f\u3059\u308b\u300c\u6642\u9593\u505c\u6b62\u300d\u306a\u3069\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u5229\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6b63\u78ba\u306b\u30dc\u30fc\u30eb\u306e\u8ecc\u9053\u3092\u8a08\u7b97\u3057\u3066\u3001\u5230\u9054\u3057\u306b\u304f\u3044\u30bf\u30fc\u30b2\u30c3\u30c8\u3092\u30d2\u30c3\u30c8\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb45\u3067\u306f\u3001\u52d5\u304f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u30dc\u30fc\u30eb\u3092\u8df3\u306d\u8fd4\u3089\u305b\u308b\u3053\u3068\u3067\u3001\u96a0\u308c\u305f\u30b3\u30a4\u30f3\u306e\u584a\u3092\u96c6\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u5e38\u306b\u30b9\u30b3\u30a2\u500d\u7387\u3092\u30c1\u30a7\u30c3\u30af\u3057\u3001\u53ef\u80fd\u306a\u9650\u308a\u7dad\u6301\u3059\u308b\u3088\u3046\u306b\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u306a\u305c\u30d0\u30a6\u30f3\u30b9\u30de\u30b9\u30bf\u30fc\u30ba\u3067\u30dc\u30fc\u30eb\u304c\u6642\u3005\u4e88\u6e2c\u4e0d\u80fd\u306b\u632f\u308b\u821e\u3046\u306e\u3067\u3057\u3087\u3046\u304b\uff1f", "answer": "\u30d0\u30a6\u30f3\u30b9\u30de\u30b9\u30bf\u30fc\u30ba\u3067\u30dc\u30fc\u30eb\u306e\u632f\u308b\u821e\u3044\u304c\u4e88\u6e2c\u4e0d\u80fd\u306b\u898b\u3048\u308b\u306e\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u8981\u56e0\u306b\u3088\u308b\u3082\u306e\u3067\u3059\u3002\u7b2c\u4e00\u306b\u3001\u30b2\u30fc\u30e0\u306f\u7269\u7406\u30d9\u30fc\u30b9\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u53d6\u308a\u5165\u308c\u3066\u3044\u308b\u305f\u3081\u3001\u30dc\u30fc\u30eb\u306e\u8ecc\u9053\u306f\u91cd\u529b\u3084\u904b\u52d5\u91cf\u3068\u3044\u3063\u305f\u73fe\u5b9f\u4e16\u754c\u306e\u7269\u7406\u6cd5\u5247\u306e\u5f71\u97ff\u3092\u53d7\u3051\u307e\u3059\u3002\u7b2c\u4e8c\u306b\u3001\u52d5\u304f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3084\u98a8\u306a\u3069\u306e\u74b0\u5883\u8981\u7d20\u304c\u30dc\u30fc\u30eb\u306e\u7d4c\u8def\u3092\u5909\u66f4\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb30\u3067\u306f\u3001\u7a81\u98a8\u306b\u3088\u3063\u3066\u30dc\u30fc\u30eb\u304c\u30b3\u30fc\u30b9\u3092\u5916\u308c\u308b\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u3002\u6700\u5f8c\u306b\u3001\u300c\u30d0\u30a6\u30f3\u30b9\u30dc\u30fc\u30eb\u300d\u306e\u3088\u3046\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u4e00\u6642\u7684\u306b\u30dc\u30fc\u30eb\u306e\u6027\u8cea\u3092\u5909\u3048\u3001\u7570\u306a\u3063\u305f\u632f\u308b\u821e\u3044\u3092\u3055\u305b\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u8981\u56e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u30dc\u30fc\u30eb\u306e\u52d5\u304d\u3092\u3088\u308a\u826f\u304f\u4e88\u6e2c\u3057\u3001\u5236\u5fa1\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u3001\u30d0\u30a6\u30f3\u30b9\u30de\u30b9\u30bf\u30fc\u30ba\u3067\u6700\u3082\u52b9\u679c\u7684\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u3001\u30d0\u30a6\u30f3\u30b9\u30de\u30b9\u30bf\u30fc\u30ba\u3067\u6700\u3082\u52b9\u679c\u7684\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u3001\u5236\u5fa1\u529b\u3068\u5f97\u70b9\u529b\u5411\u4e0a\u306b\u5f79\u7acb\u3064\u3082\u306e\u3067\u3059\u3002\u300c\u78c1\u77f3\u300d\u306f\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u308b\u306e\u306b\u975e\u5e38\u306b\u6709\u52b9\u3067\u3042\u308a\u3001\u300c\u6642\u9593\u505c\u6b62\u300d\u306f\u5384\u4ecb\u306a\u969c\u5bb3\u7269\u3092\u56de\u907f\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u300c\u30d0\u30a6\u30f3\u30b9\u30dc\u30fc\u30eb\u300d\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u30dc\u30fc\u30eb\u306e\u5f3e\u529b\u6027\u3092\u9ad8\u3081\u3001\u3088\u308a\u9577\u304f\u6b63\u78ba\u306a\u30d0\u30a6\u30f3\u30b9\u3092\u53ef\u80fd\u306b\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb50\u3067\u306f\u3001\u300c\u30d0\u30a6\u30f3\u30b9\u30dc\u30fc\u30eb\u300d\u3092\u4f7f\u7528\u3057\u3066\u9ad8\u5730\u306e\u96a0\u308c\u305f\u30b3\u30a4\u30f3\u306e\u584a\u306b\u5230\u9054\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u5e38\u306b\u3001\u5f97\u70b9\u3084\u30ec\u30d9\u30eb\u306e\u8fc5\u901f\u306a\u30af\u30ea\u30a2\u3068\u3044\u3063\u305f\u3001\u73fe\u5728\u306e\u76ee\u6a19\u306b\u4e00\u81f4\u3059\u308b\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30d0\u30a6\u30f3\u30b9\u30de\u30b9\u30bf\u30fc\u30ba\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u3069\u306e\u3088\u3046\u306b\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30a6\u30f3\u30b9\u30de\u30b9\u30bf\u30fc\u30ba\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b3\u30a4\u30f3\u306e\u53ce\u96c6\u3001\u30bf\u30fc\u30b2\u30c3\u30c8\u3078\u306e\u30d2\u30c3\u30c8\u3001\u9023\u9396\u53cd\u5fdc\u3092\u7d44\u307f\u5408\u308f\u305b\u3066\u69cb\u7bc9\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u53ce\u96c6\u3057\u305f\u5404\u30b3\u30a4\u30f3\u306f\u30b9\u30b3\u30a2\u306b\u52a0\u7b97\u3055\u308c\u3001\u7d20\u65e9\u304f\u30bf\u30fc\u30b2\u30c3\u30c8\u3092\u9023\u7d9a\u3057\u3066\u30d2\u30c3\u30c8\u3059\u308b\u3068\u3001\u30b9\u30b3\u30a2\u500d\u7387\u304c\u5897\u52a0\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u9023\u7d9a\u3057\u30663\u3064\u306e\u30bf\u30fc\u30b2\u30c3\u30c8\u3092\u30d2\u30c3\u30c8\u3059\u308b\u3068\u3001\u77ed\u6642\u9593\u3001\u30b9\u30b3\u30a2\u304c\u500d\u306b\u306a\u308a\u307e\u3059\u3002\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u7d99\u7d9a\u7684\u306b\u30bf\u30fc\u30b2\u30c3\u30c8\u3092\u30d2\u30c3\u30c8\u3057\u3001\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u308b\u3053\u3068\u3067\u500d\u7387\u3092\u7dad\u6301\u3059\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u96a0\u308c\u305f\u30b3\u30a4\u30f3\u306e\u584a\u3092\u63a2\u3057\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306e\u300c\u78c1\u77f3\u300d\u3092\u4f7f\u7528\u3057\u3066\u3001\u52b9\u7387\u7684\u306b\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u30e2\u30d0\u30a4\u30eb\u7248\u3068PC\u7248\u306e\u30d0\u30a6\u30f3\u30b9\u30de\u30b9\u30bf\u30fc\u30ba\u306e\u9593\u306b\u306f\u3001\u3069\u306e\u3088\u3046\u306a\u4e3b\u8981\u306a\u9055\u3044\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30e2\u30d0\u30a4\u30eb\u7248\u3068PC\u7248\u306e\u30d0\u30a6\u30f3\u30b9\u30de\u30b9\u30bf\u30fc\u30ba\u306e\u9593\u306e\u4e3b\u306a\u9055\u3044\u306f\u3001\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u30b9\u30ad\u30fc\u30e0\u3068\u8868\u793a\u30aa\u30d7\u30b7\u30e7\u30f3\u306b\u3042\u308a\u307e\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u7248\u3067\u306f\u3001\u76f4\u611f\u7684\u3067\u7d20\u65e9\u3044\u30bf\u30c3\u30d7\u306b\u3088\u308b\u30bf\u30c3\u30c1\u64cd\u4f5c\u304c\u4f7f\u7528\u3055\u308c\u3066\u3044\u307e\u3059\u3002PC\u7248\u3067\u306f\u3001\u30de\u30a6\u30b9\u307e\u305f\u306f\u30ad\u30fc\u30dc\u30fc\u30c9\u3092\u4f7f\u7528\u3067\u304d\u308b\u305f\u3081\u3001\u3088\u308a\u6b63\u78ba\u306a\u5236\u5fa1\u304c\u53ef\u80fd\u3067\u3059\u304c\u3001\u81ea\u7136\u306a\u64cd\u4f5c\u3068\u306f\u611f\u3058\u3089\u308c\u306a\u3044\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u4f8b\u3048\u3070\u3001\u30e2\u30d0\u30a4\u30eb\u7248\u3067\u306f\u3001\u753b\u9762\u3092\u30b9\u30ef\u30a4\u30d7\u3057\u3066\u30ab\u30e1\u30e9\u306e\u5411\u304d\u3092\u5909\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304c\u3001PC\u7248\u3067\u306f\u30de\u30a6\u30b9\u30db\u30a4\u30fc\u30eb\u3067\u884c\u3046\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u3055\u3089\u306b\u3001PC\u7248\u306f\u3001\u3088\u308a\u9ad8\u3044\u89e3\u50cf\u5ea6\u3084\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u53ef\u80fd\u306a\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3001\u5168\u4f53\u7684\u306a\u4f53\u9a13\u3092\u5411\u4e0a\u3055\u305b\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30d0\u30a6\u30f3\u30b9\u30de\u30b9\u30bf\u30fc\u30ba\u3067\u96a0\u3055\u308c\u305f\u30ec\u30d9\u30eb\u3092\u3069\u306e\u3088\u3046\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30a6\u30f3\u30b9\u30de\u30b9\u30bf\u30fc\u30ba\u3067\u96a0\u3055\u308c\u305f\u30ec\u30d9\u30eb\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u306b\u306f\u3001\u30b2\u30fc\u30e0\u5185\u3067\u306e\u7279\u5b9a\u306e\u6761\u4ef6\u3092\u6e80\u305f\u3059\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u7279\u5b9a\u306e\u30ec\u30d9\u30eb\u306e\u3059\u3079\u3066\u306e\u30b3\u30fc\u30b9\u3092\u96c6\u3081\u308b\u3053\u3068\u3001\u307e\u305f\u306f\u9ad8\u5f97\u70b9\u306e\u9054\u6210\u304c\u3001\u96a0\u3055\u308c\u305f\u30ec\u30d9\u30eb\u306e\u51fa\u73fe\u3092\u5f15\u304d\u8d77\u3053\u3059\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u30ec\u30d9\u30eb20\u3067\u306f\u3001\u4f8b\u3048\u3070\u3001\u3059\u3079\u3066\u306e\u30b3\u30fc\u30b9\u3092\u96c6\u3081\u3001\u3059\u3079\u3066\u306e\u30bf\u30fc\u30b2\u30c3\u30c8\u306b\u547d\u4e2d\u3059\u308b\u3068\u3001\u7279\u5225\u306a\u30dc\u30fc\u30ca\u30b9\u30ec\u30d9\u30eb\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u74b0\u5883\u5185\u306e\u5fae\u5999\u306a\u30d2\u30f3\u30c8\uff08\u4f8b\uff1a\u73cd\u3057\u3044\u30d1\u30bf\u30fc\u30f3\u3084\u96a0\u3055\u308c\u305f\u901a\u8def\uff09\u306b\u3082\u6ce8\u610f\u3092\u6255\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u3055\u3089\u306b\u3001\u7279\u5b9a\u306e\u30a2\u30c1\u30fc\u30d6\u30e1\u30f3\u30c8\u3092\u9054\u6210\u3059\u308b\u3053\u3068\u306b\u3088\u308a\u3001\u3053\u308c\u3089\u306e\u96a0\u3055\u308c\u305f\u30ec\u30d9\u30eb\u3078\u306e\u30a2\u30af\u30bb\u30b9\u304c\u5f97\u3089\u308c\u3001\u65b0\u3057\u3044\u6311\u6226\u3068\u5831\u916c\u304c\u63d0\u4f9b\u3055\u308c\u307e\u3059\u3002"}, {"question": "\u30d0\u30a6\u30f3\u30b9\u30de\u30b9\u30bf\u30fc\u30ba\u306b\u304a\u3051\u308b\u500d\u7387\u306e\u91cd\u8981\u6027\u306f\u4f55\u3067\u3042\u308a\u3001\u3069\u306e\u3088\u3046\u306b\u7dad\u6301\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30a6\u30f3\u30b9\u30de\u30b9\u30bf\u30fc\u30ba\u306b\u304a\u3051\u308b\u500d\u7387\u306f\u3001\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3059\u308b\u4e0a\u3067\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u9023\u7d9a\u3059\u308b\u30bf\u30fc\u30b2\u30c3\u30c8\u3078\u306e\u30d2\u30c3\u30c8\u3084\u30b3\u30a4\u30f3\u306e\u53ce\u96c6\u3067\u5897\u52a0\u3057\u307e\u3059\u304c\u3001\u30bf\u30fc\u30b2\u30c3\u30c8\u3092\u30df\u30b9\u3057\u305f\u308a\u3001\u30a2\u30af\u30b7\u30e7\u30f3\u306e\u9593\u9694\u304c\u9577\u3059\u304e\u305f\u308a\u3059\u308b\u3068\u6e1b\u5c11\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u9023\u7d9a\u3057\u30665\u3064\u306e\u30bf\u30fc\u30b2\u30c3\u30c8\u3092\u30d2\u30c3\u30c8\u3059\u308b\u3068\u3001\u77ed\u6642\u9593\u30b9\u30b3\u30a2\u304c3\u500d\u306b\u306a\u308a\u307e\u3059\u3002\u500d\u7387\u3092\u7dad\u6301\u3059\u308b\u306b\u306f\u3001\u5b89\u5b9a\u3057\u305f\u30ea\u30ba\u30e0\u3092\u7dad\u6301\u3057\u3001\u52d5\u304d\u3092\u8a08\u753b\u3057\u3066\u30c0\u30a6\u30f3\u30bf\u30a4\u30e0\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u307e\u3059\u3002\u300c\u6642\u9593\u505c\u6b62\u300d\u306a\u3069\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3057\u3066\u500d\u7387\u306e\u6301\u7d9a\u6642\u9593\u3092\u5ef6\u9577\u3057\u3001\u9023\u9396\u53cd\u5fdc\u3092\u8d77\u3053\u3057\u3066\u500d\u7387\u3092\u3088\u308a\u9577\u304f\u7dad\u6301\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u30d0\u30a6\u30f3\u30b9\u30de\u30b9\u30bf\u30fc\u30ba\u3067\u3044\u304f\u3064\u304b\u306e\u30ec\u30d9\u30eb\u304c\u52d5\u304f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u8a2d\u8a08\u3055\u308c\u3066\u3044\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u306f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30a6\u30f3\u30b9\u30de\u30b9\u30bf\u30fc\u30ba\u306b\u304a\u3051\u308b\u52d5\u304f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u6226\u7565\u6027\u3068\u6311\u6226\u306e\u8981\u7d20\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002\u6210\u529f\u3057\u305f\u30ca\u30d3\u30b2\u30fc\u30b7\u30e7\u30f3\u306b\u306f\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u4e88\u6e2c\u304c\u5fc5\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb35\u3067\u306f\u3001\u52d5\u304f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u5229\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u9ad8\u6240\u306e\u96a0\u308c\u305f\u30b3\u30a4\u30f3\u306e\u584a\u306b\u5230\u9054\u3067\u304d\u307e\u3059\u304c\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u8aa4\u308b\u3068\u3001\u30dc\u30fc\u30eb\u304c\u30b3\u30fc\u30b9\u304b\u3089\u5916\u308c\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u6226\u7565\u3092\u9069\u5fdc\u3055\u305b\u3001\u74b0\u5883\u3092\u5275\u9020\u7684\u306b\u4f7f\u7528\u3059\u308b\u3053\u3068\u3092\u4f59\u5100\u306a\u304f\u3055\u305b\u307e\u3059\u3002\u307e\u305f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5358\u8abf\u306a\u3082\u306e\u306b\u3055\u305b\u306a\u3044\u305f\u3081\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u95a2\u5fc3\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u3001\u30ec\u30d9\u30eb\u306b\u591a\u69d8\u6027\u3092\u3082\u305f\u3089\u3057\u307e\u3059\u3002"}, {"question": "\u5225\u306e\u30c7\u30d0\u30a4\u30b9\u306b\u30d0\u30a6\u30f3\u30b9\u30de\u30b9\u30bf\u30fc\u30ba\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u5225\u306e\u30c7\u30d0\u30a4\u30b9\u306b\u30d0\u30a6\u30f3\u30b9\u30de\u30b9\u30bf\u30fc\u30ba\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u7528\u3067\u304d\u307e\u3059\u3002\u307e\u305a\u3001\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u6b21\u306b\u3001\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u306b\u9032\u307f\u3001\u300c\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u300d\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u9078\u629e\u3057\u3066\u3001\u9032\u884c\u72b6\u6cc1\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u3001\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u4fdd\u5b58\u6e08\u307f\u30c7\u30fc\u30bf\u3092\u53d6\u5f97\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001iPhone\u304b\u3089Android\u30c7\u30d0\u30a4\u30b9\u306b\u5207\u308a\u66ff\u3048\u308b\u5834\u5408\u3001Google Play\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3068\u3001\u4fdd\u5b58\u6e08\u307f\u306e\u9032\u884c\u72b6\u6cc1\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u306f\u305a\u3067\u3059\u3002\u30c7\u30fc\u30bf\u306e\u640d\u5931\u3092\u9632\u3050\u305f\u3081\u306b\u3001\u30c7\u30fc\u30bf\u3092\u5b9a\u671f\u7684\u306b\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u3059\u308b\u3088\u3046\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}]
[{"question": "\ucd08\ubcf4\uc790\ub85c\uc11c Bouncemasters\uc5d0\uc11c \uacf5\uc758 \uada4\uc801\uc744 \uc5b4\ub5bb\uac8c \uc81c\uc5b4\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Bouncemasters\uc5d0\uc11c \uacf5\uc758 \uada4\uc801\uc744 \uc81c\uc5b4\ud558\ub824\uba74 \uae30\ubcf8\uc801\uc778 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\ub294 \uac83\uc73c\ub85c \uc2dc\uc791\ud558\uc138\uc694. \ud654\uba74\uc744 \ud0ed\ud558\uba74 \uacf5\uc774 \ud0ed\ud55c \ubc29\ud5a5\uc73c\ub85c \ud295\uae41\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uacf5\uc758 \uc624\ub978\ucabd \uc57d\uac04 \uc704\ub97c \ud0ed\ud558\uba74 \uacf5\uc774 \uc624\ub978\ucabd \ub300\uac01\uc120\uc73c\ub85c \ud295\uaca8\uc838 \ub098\uac11\ub2c8\ub2e4. \ucd08\uae30 \ub808\ubca8\uc5d0\uc11c \uc5f0\uc2b5\ud558\uc5ec \ud0c0\uc774\ubc0d\uacfc \uac01\ub3c4\ub97c \ud30c\uc545\ud558\uc138\uc694. \ub610\ud55c \ud658\uacbd\uc744 \ud65c\uc6a9\ud558\uc138\uc694. \ubcbd\uc5d0 \ud295\uaca8\uc11c \uacf5\uc758 \ubc29\ud5a5\uc744 \ubc14\uafc0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud575\uc2ec\uc740 \uacf5\uc774 \uc5b4\ub514\uc5d0 \ub5a8\uc5b4\uc9c8\uc9c0 \uc608\uc0c1\ud558\uace0 \ub2e4\uc74c \ub3d9\uc791\uc744 \uacc4\ud68d\ud558\ub294 \uac83\uc785\ub2c8\ub2e4."}, {"question": "100\uc2dc\uac04 \uc774\uc0c1 \ud50c\ub808\uc774\ud55c \ud6c4 Bouncemasters\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc7a5\uc2dc\uac04 \ud50c\ub808\uc774 \ud6c4 Bouncemasters\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc73c\ub824\uba74 \uace0\uae09 \uc804\ub7b5\uc744 \uc219\ub2ec\ud574\uc57c \ud569\ub2c8\ub2e4. STEP1: \uc5f0\uc18d\uc73c\ub85c \uc5ec\ub7ec \uac1c\uc758 \ud0c0\uac9f\uc744 \ube60\ub974\uac8c \uce58\ub294 \uc5f0\uc1c4 \ubc18\uc751\uc5d0 \uc9d1\uc911\ud569\ub2c8\ub2e4. STEP2: \"\uc790\uc11d\"\uacfc \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \ud65c\uc6a9\ud558\uc5ec \ub3d9\uc804\uc744 \ubaa8\uc73c\uace0 \"\uc2dc\uac04 \uc815\uc9c0\"\ub85c \uc7a5\uc560\ubb3c\uc744 \ub290\ub9ac\uac8c \ud558\uc138\uc694. STEP3: \uacf5\uc758 \uada4\uc801\uc744 \uacc4\uc0b0\ud558\uc5ec \ub2ff\uae30 \uc5b4\ub824\uc6b4 \ud0c0\uac9f\uc744 \uc815\ud655\ud558\uac8c \uce58\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, 45 \ub808\ubca8\uc5d0\uc11c \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uc5d0 \uacf5\uc744 \ud295\uaca8\uc11c \uc228\uaca8\uc9c4 \ub3d9\uc804 \ud074\ub7ec\uc2a4\ud130\ub97c \ubaa8\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud56d\uc0c1 \uc810\uc218 \ubc30\uc218\ub97c \ud655\uc778\ud558\uace0 \uac00\ub2a5\ud55c \ud55c \uc624\ub7ab\ub3d9\uc548 \uc720\uc9c0\ud558\ub824\uace0 \ub178\ub825\ud558\uc138\uc694."}, {"question": "\uc65c Bouncemasters\uc5d0\uc11c \uacf5\uc774 \ub54c\ub54c\ub85c \uc608\uce21 \ubd88\uac00\ub2a5\ud558\uac8c \uc6c0\uc9c1\uc774\ub294 \uac78\uae4c\uc694?", "answer": "Bouncemasters\uc5d0\uc11c \uacf5\uc758 \ud589\ub3d9\uc774 \uc608\uce21 \ubd88\uac00\ub2a5\ud55c \uac83\ucc98\ub7fc \ubcf4\uc774\ub294 \uac83\uc740 \uc5ec\ub7ec \uac00\uc9c0 \uc694\uc778 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uccab\uc9f8, \uac8c\uc784\uc740 \ubb3c\ub9ac \uae30\ubc18 \uba54\ucee4\ub2c8\uc998\uc744 \ud3ec\ud568\ud558\uace0 \uc788\uc5b4 \uacf5\uc758 \uada4\uc801\uc774 \uc911\ub825\uacfc \uc6b4\ub3d9\ub7c9\uacfc \uac19\uc740 \uc2e4\uc81c \ubb3c\ub9ac \ubc95\uce59\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \ub458\uc9f8, \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uc774\ub098 \ubc14\ub78c\uacfc \uac19\uc740 \ud658\uacbd \uc694\uc18c\uac00 \uacf5\uc758 \uacbd\ub85c\ub97c \ubc14\uafc0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 30 \ub808\ubca8\uc5d0\uc11c \uac11\uc791\uc2a4\ub7ec\uc6b4 \ubc14\ub78c\uc774 \uacf5\uc758 \ubc29\ud5a5\uc744 \ud2c0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc14b\uc9f8, \"\ud295\uae30\ub294 \uacf5\"\uacfc \uac19\uc740 \ud30c\uc6cc\uc5c5\uc740 \uc77c\uc2dc\uc801\uc73c\ub85c \uacf5\uc758 \ud2b9\uc131\uc744 \ubc14\uafd4 \ub2e4\ub978 \ubc29\uc2dd\uc73c\ub85c \ud589\ub3d9\ud558\uac8c \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc694\uc778\uc744 \uc774\ud574\ud558\uba74 \uacf5\uc758 \uc6c0\uc9c1\uc784\uc744 \ub354 \uc798 \uc608\uce21\ud558\uace0 \uc81c\uc5b4\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4."}, {"question": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c Bouncemasters\uc5d0\uc11c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ud30c\uc6cc\uc5c5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Bouncemasters\uc5d0\uc11c \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ud30c\uc6cc\uc5c5\uc740 \uc81c\uc5b4\ub825\uacfc \uc810\uc218 \ud68d\ub4dd \uc7a0\uc7ac\ub825\uc744 \ub192\uc774\ub294 \ud30c\uc6cc\uc5c5\uc785\ub2c8\ub2e4. \"\uc790\uc11d\"\uc740 \ub3d9\uc804\uc744 \ubaa8\uc73c\ub294 \ub370 \ub9e4\uc6b0 \uadc0\uc911\ud558\uba70, \"\uc2dc\uac04 \uc815\uc9c0\"\ub294 \uae4c\ub2e4\ub85c\uc6b4 \uc7a5\uc560\ubb3c\uc744 \uadf9\ubcf5\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \"\ud295\uae30\ub294 \uacf5\" \ud30c\uc6cc\uc5c5\uc740 \uacf5\uc758 \ud0c4\uc131\uc744 \ub192\uc5ec \ub354 \uae38\uace0 \uc815\ud655\ud55c \ubc18\ub3d9\uc744 \uac00\ub2a5\ud558\uac8c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 50 \ub808\ubca8\uc5d0\uc11c \"\ud295\uae30\ub294 \uacf5\"\uc744 \uc0ac\uc6a9\ud558\uba74 \uace0\uc9c0\ub300\uc758 \ub3d9\uc804 \ud074\ub7ec\uc2a4\ud130\uc5d0 \ub3c4\ub2ec\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud56d\uc0c1 \ud604\uc7ac \ubaa9\ud45c, \uc989 \uc810\uc218 \ud68d\ub4dd \ub610\ub294 \ub808\ubca8 \uc2e0\uc18d\ud558\uac8c \uc644\ub8cc\uc640 \uc77c\uce58\ud558\ub294 \ud30c\uc6cc\uc5c5\uc744 \uc6b0\uc120\uc2dc\ud558\uc138\uc694."}, {"question": "Bouncemasters\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uc5b4\ub5bb\uac8c \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Bouncemasters\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ub3d9\uc804 \uc218\uc9d1, \ud0c0\uac9f \ub9de\ucd94\uae30, \uc5f0\uc1c4 \ubc18\uc751\uc744 \ud3ec\ud568\ud55c \uc5ec\ub7ec \uc694\uc18c\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uac01 \ub3d9\uc804\uc744 \ubaa8\uc744 \ub54c\ub9c8\ub2e4 \uc810\uc218\uac00 \uc99d\uac00\ud558\uace0, \uc5f0\uc18d\uc801\uc73c\ub85c \ud0c0\uac9f\uc744 \ub9de\ucd94\uba74 \uc810\uc218 \ubc30\uc218\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc138 \uac1c\uc758 \ud0c0\uac9f\uc744 \uc5f0\uc18d\uc73c\ub85c \ub9de\ucd94\uba74 \uc7a0\uc2dc \ub3d9\uc548 \uc810\uc218\uac00 \ub450 \ubc30\uac00 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud558\ub824\uba74 \ud0c0\uac9f\uc744 \uacc4\uc18d\ud574\uc11c \ub9de\ucd94\uace0 \ub3d9\uc804\uc744 \ubaa8\uc544 \ubc30\uc218\ub97c \uc720\uc9c0\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \ub610\ud55c \uc228\uaca8\uc9c4 \ub3d9\uc804 \ud074\ub7ec\uc2a4\ud130\ub97c \ucc3e\uace0 \"\uc790\uc11d\"\uacfc \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub354 \ub9ce\uc740 \ub3d9\uc804\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \ubaa8\uc73c\uc138\uc694."}, {"question": "\ubaa8\ubc14\uc77c\uacfc PC \ud50c\ub7ab\ud3fc\uc5d0\uc11c Bouncemasters\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ubaa8\ubc14\uc77c\uacfc PC \ud50c\ub7ab\ud3fc\uc5d0\uc11c Bouncemasters\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \uc81c\uc5b4 \ubc29\uc2dd\uacfc \ub514\uc2a4\ud50c\ub808\uc774 \uc635\uc158\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \ubaa8\ubc14\uc77c\uc5d0\uc11c\ub294 \uc9c1\uad00\uc801\uc774\uace0 \ube60\ub978 \ud0ed\uc744 \ud1b5\ud574 \uac8c\uc784\uc744 \uc81c\uc5b4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. PC\uc5d0\uc11c\ub294 \ub9c8\uc6b0\uc2a4 \ub610\ub294 \ud0a4\ubcf4\ub4dc\ub97c \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294\ub370, \uc774\ub294 \ub354 \uc815\ud655\ud55c \uc81c\uc5b4\ub97c \uc81c\uacf5\ud558\uc9c0\ub9cc \uc790\uc5f0\uc2a4\ub7fd\uc9c0 \uc54a\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubaa8\ubc14\uc77c\uc5d0\uc11c\ub294 \ud654\uba74\uc744 \uc4f8\uc5b4\uc11c \uce74\uba54\ub77c \uac01\ub3c4\ub97c \uc870\uc815\ud560 \uc218 \uc788\uc9c0\ub9cc, PC\uc5d0\uc11c\ub294 \ub9c8\uc6b0\uc2a4 \ud720\ub85c \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c PC \ubc84\uc804\uc740 \ub354 \ub192\uc740 \ud574\uc0c1\ub3c4\uc640 \uc0ac\uc6a9\uc790 \uc9c0\uc815 \uac00\ub2a5\ud55c \uc81c\uc5b4\ub97c \uc9c0\uc6d0\ud558\uc5ec \uc804\uccb4 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Bouncemasters\uc5d0\uc11c \uc228\uaca8\uc9c4 \ub808\ubca8\uc744 \uc5b4\ub5bb\uac8c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Bouncemasters\uc5d0\uc11c \uc228\uaca8\uc9c4 \ub808\ubca8\uc744 \uc7a0\uae08 \ud574\uc81c\ud558\ub824\uba74 \ud2b9\uc815 \uac8c\uc784 \ub0b4 \uae30\uc900\uc744 \ucda9\uc871\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud2b9\uc815 \ub808\ubca8\uc758 \ubaa8\ub4e0 \ub3d9\uc804\uc744 \uc218\uc9d1\ud558\uac70\ub098 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc73c\uba74 \uc228\uaca8\uc9c4 \ub808\ubca8\uc774 \ub098\ud0c0\ub0a0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 20 \ub808\ubca8\uc5d0\uc11c \ubaa8\ub4e0 \ub3d9\uc804\uc744 \ubaa8\uc73c\uace0 \ubaa8\ub4e0 \ud0c0\uac9f\uc744 \ub9de\ucd94\uba74 \ube44\ubc00 \ubcf4\ub108\uc2a4 \ub808\ubca8\uc774 \uc7a0\uae08 \ud574\uc81c\ub429\ub2c8\ub2e4. \ud658\uacbd\uc5d0\uc11c \ubbf8\ubb18\ud55c \ud78c\ud2b8, \uc608\ub97c \ub4e4\uc5b4 \ud2b9\uc774\ud55c \ud328\ud134\uc774\ub098 \uc228\uaca8\uc9c4 \uacbd\ub85c\ub97c \uc0b4\ud3b4\ubcf4\uc138\uc694. \ub610\ud55c \ud2b9\uc815 \uc131\ucde8\ub97c \ub2ec\uc131\ud558\uba74 \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ub808\ubca8\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\uc73c\uba70, \uc0c8\ub85c\uc6b4 \ub3c4\uc804\uacfc \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}, {"question": "Bouncemasters\uc5d0\uc11c \ubc30\uc218\uc758 \uc911\uc694\uc131\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \uc720\uc9c0\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Bouncemasters\uc5d0\uc11c \ubc30\uc218\ub294 \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud558\ub294 \ub370 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc5f0\uc18d\uc801\uc778 \ud0c0\uac9f \ub9de\ucd94\uae30 \ub610\ub294 \ub3d9\uc804 \uc218\uc9d1\uc73c\ub85c \uc99d\uac00\ud558\uc9c0\ub9cc, \ud0c0\uac9f\uc744 \ub193\uce58\uac70\ub098 \ud589\ub3d9 \uc0ac\uc774\uc5d0 \ub108\ubb34 \uc624\ub7ab\ub3d9\uc548 \uae30\ub2e4\ub9ac\uba74 \uac10\uc18c\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub2e4\uc12f \uac1c\uc758 \ud0c0\uac9f\uc744 \uc5f0\uc18d\uc73c\ub85c \ub9de\ucd94\uba74 \uc7a0\uc2dc \ub3d9\uc548 \uc810\uc218\uac00 \uc138 \ubc30\uac00 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubc30\uc218\ub97c \uc720\uc9c0\ud558\ub824\uba74 \uafb8\uc900\ud55c \ub9ac\ub4ec\uc744 \uc720\uc9c0\ud558\uace0 \ub3d9\uc791\uc744 \uacc4\ud68d\ud558\uc5ec \ub300\uae30 \uc2dc\uac04\uc744 \ucd5c\uc18c\ud654\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \"\uc2dc\uac04 \uc815\uc9c0\"\uc640 \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ubc30\uc218 \uae30\uac04\uc744 \uc5f0\uc7a5\ud558\uace0 \uc5f0\uc1c4 \ubc18\uc751\uc744 \ud1b5\ud574 \ubc30\uc218\ub97c \ub354 \uc624\ub7ab\ub3d9\uc548 \uc720\uc9c0\ud558\uc138\uc694."}, {"question": "Bouncemasters\uc5d0\uc11c \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uc774 \uc788\ub294 \ub808\ubca8\uc740 \uc65c \uc124\uacc4\ub418\uc5c8\uc73c\uba70, \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "Bouncemasters\uc5d0\uc11c \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uc740 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \ucd94\uac00\uc801\uc778 \ub3c4\uc804\uacfc \uc804\ub7b5\uc744 \ub354\ud569\ub2c8\ub2e4. \uc131\uacf5\uc801\uc73c\ub85c \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uc744 \ud0d0\uc0c9\ud558\ub824\uba74 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uacfc \uc608\uce21\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 35 \ub808\ubca8\uc5d0\uc11c \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uc744 \ud1b5\ud574 \uace0\uc9c0\ub300\uc758 \ub3d9\uc804 \ud074\ub7ec\uc2a4\ud130\uc5d0 \ub3c4\ub2ec\ud560 \uc218 \uc788\uc9c0\ub9cc, \ubc18\ub3d9 \ud0c0\uc774\ubc0d\uc744 \uc798\ubabb \ub9de\ucd94\uba74 \uacf5\uc758 \ubc29\ud5a5\uc774 \ud2c0\uc5b4\uc9d1\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud50c\ub7ab\ud3fc\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc804\ub7b5\uc744 \uc801\uc751\ud558\uace0 \ud658\uacbd\uc744 \ub3c5\ucc3d\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub3c4\ub85d \uac15\uc694\ud569\ub2c8\ub2e4. \ub610\ud55c \uac8c\uc784 \ud50c\ub808\uc774\uac00 \ub2e8\uc870\ub85c\uc6cc\uc9c0\ub294 \uac83\uc744 \ubc29\uc9c0\ud558\uace0 \ud50c\ub808\uc774\uc5b4\uc758 \ucc38\uc5ec\ub97c \uc720\uc9c0\ud558\uc5ec \ub808\ubca8\uc5d0 \ub2e4\uc591\uc131\uc744 \ub354\ud569\ub2c8\ub2e4."}, {"question": "Bouncemasters\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ud55c \uae30\uae30\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30\ub85c \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Bouncemasters\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ud55c \uae30\uae30\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30\ub85c \uc804\uc1a1\ud558\ub824\uba74 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uba3c\uc800 \ub450 \uae30\uae30 \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uadf8\ub7f0 \ub2e4\uc74c \uc124\uc815 \uba54\ub274\ub85c \uc774\ub3d9\ud558\uc5ec \"\ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\" \uc635\uc158\uc744 \uc120\ud0dd\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5c5\ub85c\ub4dc\ud558\uc138\uc694. \uc0c8\ub85c\uc6b4 \uae30\uae30\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uace0 \uc800\uc7a5\ub41c \ub370\uc774\ud130\ub97c \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, iPhone\uc5d0\uc11c Android \uae30\uae30\ub85c \uc804\ud658\ud558\ub294 \uacbd\uc6b0 Google Play \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uba74 \uc800\uc7a5\ub41c \uc9c4\ud589 \uc0c1\ud669\uc5d0 \uc561\uc138\uc2a4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud56d\uc0c1 \ub370\uc774\ud130\ub97c \uc815\uae30\uc801\uc73c\ub85c \ubc31\uc5c5\ud558\uc5ec \uc190\uc2e4\uc744 \ubc29\uc9c0\ud558\uc138\uc694."}]
[{"question": "Bouncemasters \ucd08\ubcf4\uc790 \ub3c4\uc6c0 \uc694\uccad: \ud3ad\uadc4\uc744 \ub354 \uba40\ub9ac \ub0a0\ub9ac\ub824\uba74 \uc5b4\ub5bb\uac8c \ub354 \uc798 \ub54c\ub824\uc57c \ud558\ub098\uc694?", "answer": "\ucd08\ubcf4 \ud50c\ub808\uc774\uc5b4 \uc5ec\ub7ec\ubd84, \uc548\ub155\ud558\uc138\uc694! \ud3ad\uadc4\uc744 \ub354 \uba40\ub9ac \ub0a0\ub9ac\ub824\uba74 \ud0c0\uaca9 \uc2dc\uc810\uacfc \ud798 \uc870\uc808\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \ud3ad\uadc4\uc774 \ub545\uc5d0 \ub2ff\uae30 \uc9c1\uc804, \ubab8\uc774 \uc57d\uac04 \uc55e\uc73c\ub85c \uae30\uc6b8\uc5b4\uc9c0\ub294 \uc21c\uac04\uc774 \ucd5c\uc801\uc758 \ud0c0\uaca9 \uc9c0\uc810\uc785\ub2c8\ub2e4. \uc774\ub54c \ubc29\ub9dd\uc774\ub97c \ud718\ub450\ub974\uba74 \ucd5c\ub300\uc758 \ucd94\uc9c4\ub825\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud3ad\uadc4\uc758 \ube44\ud589 \uada4\uc801\uc744 \uad00\ucc30\ud558\uc5ec \ucc29\ub959 \uc9c0\uc810\uc744 \uc608\uce21\ud558\uace0, \ud3ad\uadc4\uc774 \ub2e4\uac00\uc624\uba74 \ubc14\ub85c \ud654\uba74\uc744 \ud130\uce58\ud558\uc138\uc694. \ud798 \uc870\uc808\uc740 \ud3ad\uadc4\uc774 \ub5a8\uc5b4\uc9c0\ub294 \ub3d9\uc548 \ud798 \ud45c\uc2dc\uae30\ub97c \uad00\ucc30\ud558\uc5ec, \ud798 \ud45c\uc2dc\uae30\uac00 \ucd5c\ub300\uce58\uc5d0 \uac00\uae4c\uc6b8 \ub54c \ud0c0\uaca9\ud558\uba74 \ube44\ud589 \uac70\ub9ac\ub97c \ucd5c\ub300\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \u3010\ube44\uc720 \uc124\uba85: \uc57c\uad6c \ubc30\ud2b8\ub97c \uce58\ub4ef\uc774, \ucd5c\uc801\uc758 \ud0c0\uc774\ubc0d\uc5d0 \ud718\ub450\ub974\uba74 \ud648\ub7f0\uc744 \uce60 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\u3011 \uac8c\uc784 \ucd08\ubc18\uc5d0\ub294 \ubc29\ub9dd\uc774\uc758 \"\ud798\" \uc18d\uc131\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uba74 \ud0c0\uaca9 \ud6a8\uacfc\ub97c \ud06c\uac8c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucd08\uae30 \ubc29\ub9dd\uc774\ub294 50m \uc815\ub3c4\ubc16\uc5d0 \ub0a0\ub9b4 \uc218 \uc5c6\uc9c0\ub9cc, \ud798 \uc18d\uc131\uc744 \uba87 \ubc88 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uba74 100m\ub97c \uc190\uc27d\uac8c \ub118\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784 \ub0b4 \uc18d\ub3c4 \uc99d\uac00 \uc544\uc774\ud15c\uc744 \uc0ac\uc6a9\ud558\uc5ec \ucd94\uac00 \uc18d\ub3c4\ub97c \uc5bb\uc744 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Bouncemasters\uc5d0\uc11c \ud3ad\uadc4\uc774 \ub54c\ub54c\ub85c \ubc29\ub9dd\uc774\uc5d0\uc11c \uc774\uc0c1\ud558\uac8c \ud295\uae30\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \uc608\ubc29\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud3ad\uadc4\uc774 \ub54c\ub54c\ub85c \ubc29\ub9dd\uc774\uc5d0\uc11c \uc774\uc0c1\ud558\uac8c \ud295\uae30\ub294 \uac83\uc740 \ucda9\uaca9 \uac01\ub3c4\uc640 \ud0c0\uc774\ubc0d \ub54c\ubb38\uc785\ub2c8\ub2e4. \ud3ad\uadc4\uc744 \ub108\ubb34 \uc77c\ucc0d \ub610\ub294 \ub108\ubb34 \ub2a6\uac8c \uce58\uac70\ub098, \ubc29\ub9dd\uc774\uac00 \uc644\ubcbd\ud558\uac8c \uc815\ub82c\ub418\uc9c0 \uc54a\uc73c\uba74 \uc57d\ud558\uac70\ub098 \ubd88\uaddc\uce59\uc801\uc778 \ubc18\ubc1c\uc774 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub97c \uc608\ubc29\ud558\ub824\uba74 \ud3ad\uadc4\uc744 \ubc29\ub9dd\uc774\uc758 \uc911\uc2ec\ubd80\uc778 \ucd5c\uc801\uc758 \uc9c0\uc810\uc5d0 \ub9de\ucd94\ub294 \ub370 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. \ub610\ud55c \ubc29\ub9dd\uc774\uc758 '\uc815\ud655\ub3c4' \uc18d\uc131\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \uac83\uc744 \uace0\ub824\ud574 \ubcf4\uc138\uc694. \uc774 \uc18d\uc131\uc740 \uc815\ub82c \uc624\ub958\uc758 \ubc1c\uc0dd \uac00\ub2a5\uc131\uc744 \uc904\uc5ec\uc90d\ub2c8\ub2e4. \uc18d\ub3c4 \uc99d\ud3ed\uae30\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud0c0\uc774\ubc0d\uc744 \uac1c\uc120\ud574 \ubcf4\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud3ad\uadc4\uc744 \uce58\uae30\uc5d0 \uc774\uc0c1\uc801\uc778 \uc21c\uac04 \uc9c1\uc804\uc5d0 \uc18d\ub3c4 \uc99d\ud3ed\uae30\ub97c \ud65c\uc131\ud654\ud558\uba74 \uc644\ubcbd\ud55c \ud0c0\uaca9\uc744 \uc124\uc815\ud558\uace0 \uc77c\uad00\uc131\uc744 \ub192\uc774\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \ucd08\uae30 \ubc29\ub9dd\uc774: \uc815\ud655\ub3c4 \ub0ae\uc74c, \uc2e4\uc218 \ubc1c\uc0dd\ub960 \ub192\uc74c, \uc5c5\uadf8\ub808\uc774\ub4dc\ub41c \ubc29\ub9dd\uc774: \uc815\ud655\ub3c4 \ub192\uc74c, \uc548\uc815\uc801\uc778 \ud0c0\uaca9]"}, {"question": "Bouncemasters \ucf54\uc778 \ud68d\ub4dd \uc804\ub7b5: \uc77c\ubc18\uc801\uc778 \ud50c\ub808\uc774 \uc678\uc5d0 \uc228\uaca8\uc9c4 \ube60\ub978 \ucf54\uc778 \ud68d\ub4dd \ubc29\ubc95\uc740 \ubb34\uc5c7\uc774 \uc788\ub098\uc694?", "answer": "\uc77c\ubc18\uc801\uc778 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud1b5\ud574 \ucf54\uc778\uc744 \uc5bb\ub294 \uac83 \uc678\uc5d0\ub3c4 \uac8c\uc784\uc5d0\ub294 \ube60\ub974\uac8c \ucf54\uc778\uc744 \ud68d\ub4dd\ud558\ub294 \uc228\uaca8\uc9c4 \ubc29\ubc95\ub4e4\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ud558\ub098\uc758 \ubc29\ubc95\uc740 \ub9e4\uc77c \ubbf8\uc158\uacfc \uc131\ucde8\ub3c4\uc5d0 \uc8fc\ubaa9\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc774\ub4e4\uc744 \uc644\ub8cc\ud558\uba74 \ucd94\uac00 \ucf54\uc778 \ubcf4\uc0c1\uc744 \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \ubc29\ubc95\uc740 \uad11\uace0 \uc2dc\uccad\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uac8c\uc784\uc740 \uc8fc\uae30\uc801\uc73c\ub85c \uad11\uace0\ub97c \uc2dc\uccad\ud558\uba74 \ucf54\uc778\uc744 \uc5bb\uc744 \uc218 \uc788\ub294 \uae30\ud68c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub354 \ud6a8\uacfc\uc801\uc778 \ubc29\ubc95\uc740 \uac8c\uc784 \ucd08\uae30\uc5d0 \ubc1c\uc0ac \uac70\ub9ac\uc640 \ucf54\uc778 \uc218\uc785 \ubcf4\ub108\uc2a4\ub97c \uc911\uc810\uc801\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \ucf54\uc778 \uc218\uc785 \ubcf4\ub108\uc2a4\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uba74 \uc790\uc0b0 \ucd95\uc801 \uc18d\ub3c4\ub97c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \u6280\u5de7 \uce21\uba74\uc5d0\uc11c\ub294, \ud37c\ud399\ud2b8 \ud0c0\uaca9\uc744 \ub178\ub9ac\uba74 \ucd94\uac00 \ucf54\uc778 \ubcf4\uc0c1\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud3ad\uadc4\uc744 \uc644\ubcbd\ud558\uac8c \ud0c0\uaca9\ud558\uba74 \ud2b9\uc218 \uc74c\ud5a5 \ud6a8\uacfc\uc640 \uc2dc\uac01 \ud6a8\uacfc\uac00 \ud45c\uc2dc\ub429\ub2c8\ub2e4. \u3010\ub2e4\uc591\ud55c \ubc29\uc548 \ube44\uad50: \uc77c\ubc18\uc801\uc778 \ud0c0\uaca9 10 \ucf54\uc778, \uc644\ubcbd\ud55c \ud0c0\uaca9 20 \ucf54\uc778, \uad11\uace0 \uc2dc\uccad 50 \ucf54\uc778\u3011 \ub610\ud55c \uac8c\uc784 \uacf5\uc2dd \ucee4\ubba4\ub2c8\ud2f0 \ubc0f \uc774\ubca4\ud2b8\uc5d0 \uc8fc\ubaa9\ud558\uba74 \ucf54\uc778 \uc99d\uc815 \uc774\ubca4\ud2b8\uac00 \ub54c\ub54c\ub85c \uc5f4\ub9bd\ub2c8\ub2e4."}, {"question": "Bouncemasters \uace0\uae09 \ud301: \uc9c0\ud615\uacfc \ub3d9\ubb3c\uc744 \ud65c\uc6a9\ud558\uc5ec \ube44\ud589 \uac70\ub9ac\ub97c \uc5b4\ub5bb\uac8c \ub192\uc77c \uc218 \uc788\ub098\uc694?", "answer": "\ube44\ud589 \uac70\ub9ac\ub97c \ud06c\uac8c \ub192\uc774\ub824\uba74 \uac8c\uc784 \ud658\uacbd\uc758 \uc9c0\ud615\uacfc \ub3d9\ubb3c\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \ud65c\uc6a9\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud2b9\uc815 \uc9c0\ud615\uc5d0\ub294 \ud3ad\uadc4\uc5d0\uac8c \ucd94\uac00\uc801\uc778 \uc0c1\uc2b9\ub825\uc744 \ubd80\uc5ec\ud558\ub294 \uc0c1\uc2b9 \uae30\ub958\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uc77c\ubd80 \ub3d9\ubb3c, \uc608\ub97c \ub4e4\uc5b4 \uac08\ub9e4\uae30\ub294 \ud3ad\uadc4\uc774 \ucda9\ub3cc\ud560 \ub54c \ucd94\uac00\uc801\uc778 \ucd94\uc9c4\ub825\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. STEP1: \uc9c0\ub3c4\ub97c \uc219\uc9c0\ud558\uace0 \ud575\uc2ec \uc9c0\ud615\uacfc \ub3d9\ubb3c\uc758 \uc704\uce58\ub97c \uae30\uc5b5\ud558\uc138\uc694. STEP2: \ube44\ud589 \uc911\uc5d0 \ube44\ud589 \ubc29\ud5a5\uc744 \uc870\uc808\ud558\uace0, \uc0c1\uc2b9 \uae30\ub958\uc640 \ub3d9\ubb3c \ubb34\ub9ac\uc5d0 \uac00\uae4c\uc774 \uac00\uc138\uc694. STEP3: \uc18d\ub3c4 \uc99d\uac00 \uc544\uc774\ud15c\uc744 \ud65c\uc6a9\ud558\uc5ec \ube44\ud589 \uacbd\ub85c\ub97c \uc870\uc815\ud558\uace0, \ud3ad\uadc4\uc774 \uc815\ud655\ud558\uac8c \ubaa9\ud45c\ubb3c\uc5d0 \ucda9\ub3cc\ud560 \uc218 \uc788\ub3c4\ub85d \ud558\uc138\uc694. \ube59\uc0b0 \uc9c0\ud615\uc5d0\uc11c\ub294 \uc0c1\uc2b9 \uae30\ub958\ub97c \ud65c\uc6a9\ud558\uba74 \uae34 \uac70\ub9ac\ub97c \uc27d\uac8c \ube44\ud589\ud560 \uc218 \uc788\uace0, \uc774\ub54c \uac08\ub9e4\uae30 \ubb34\ub9ac\uc640 \ud568\uaed8 \ucda9\ub3cc\ud558\uba74 \ub354\uc6b1 \uba3c \uac70\ub9ac\ub97c \ube44\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \u3010\ud750\ub984\ub3c4 \uc124\uba85: \ube44\ud589 \u2192 \uae30\ub958/\ub3d9\ubb3c \uc811\uadfc \u2192 \uc18d\ub3c4 \uc870\uc808 \u2192 \uc815\ud655\ud55c \ucda9\ub3cc \u2192 \uac70\ub9ac \uc99d\uac00\u3011"}, {"question": "Bouncemasters\uc5d0\uc11c \ub2e4\uc591\ud55c \ubc29\ub9dd\uc774\ub294 \ubb34\uc5c7\uc774 \ub2e4\ub974\ub098\uc694? \uc5b4\ub5a4 \ubc29\ub9dd\uc774\uac00 \uac00\uc7a5 \uc88b\uc740 \uc131\ub2a5\uc744 \ubcf4\uc5ec\uc8fc\uace0 \uc65c \uadf8\ub7f0\uac00\uc694?", "answer": "Bouncemasters\uc758 \ub2e4\uc591\ud55c \ubc29\ub9dd\uc774\ub294 \ud30c\uc6cc, \ubc18\ubc1c, \uacf5\uae30\uc5ed\ud559 \ubc0f \uc815\ud655\ub3c4 \ub4f1\uc758 \uc11c\ub85c \ub2e4\ub978 \uc18d\uc131\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \"\ucd5c\uace0\"\uc758 \ubc29\ub9dd\uc774\ub294 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub530\ub77c \ub2e4\ub974\uba70, \ubaa9\ud45c\uc5d0 \ub2ec\ub824\uc788\uc2b5\ub2c8\ub2e4. \ucd08\uae30\uc5d0\ub294 \uac70\ub9ac\ub97c \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \ub192\uc740 \ud30c\uc6cc\ub97c \uc9c0\ub2cc \ubc29\ub9dd\uc774\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \ub098\uc911\uc5d0\ub294 \uc77c\uad00\ub41c \ud0c0\uaca9\uacfc \uc5f0\uacc4 \uccb4\uc778\uc744 \uc704\ud574 \uc815\ud655\ub3c4\uac00 \ub354 \uc911\uc694\ud574\uc9d1\ub2c8\ub2e4. \ubc29\ub9dd\uc774 \uc18d\uc131\uc740 \uc7a5\ucc29\ub41c \ud604\uc7ac \ubc29\ub9dd\uc774\uc640 \ube44\uad50\ud558\uc5ec \ud45c\uc2dc\ub429\ub2c8\ub2e4. \uc0ac\uc6a9 \uac00\ub2a5\ud55c \ubc29\ub9dd\uc774\ub97c \ube44\uad50\ud55c \ud6c4 \uc6d0\ud558\ub294 \ubc29\ub9dd\uc774\ub97c \uc120\ud0dd\ud558\uc2ed\uc2dc\uc624. \ucd5c\uc885 \ubaa9\ud45c\uc640 \uc77c\uce58\ud558\ub294 \ubc29\ub9dd\uc774\ub97c \uc720\uc9c0\ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc36c\ub354\ud074\ub7fd\" \ubc29\ub9dd\uc774\ub294 \ud3ad\uadc4\uc744 \ub54c\ub9b4 \ub54c \ub354 \ub9ce\uc740 \ud53c\ud574\ub97c \uc785\ud788\uace0 \ucd94\uac00 \ubc94\uc704\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \ubc29\ub9dd\uc774 \uc720\ud615 - \uc18d\uc131 \uc911\uc810 - \uc801\uc6a9 \ud658\uacbd]"}, {"question": "Bouncemasters \ub370\uc774\ud130 \ubd84\uc11d: \ud3ad\uadc4 \ube44\ud589 \uac70\ub9ac\ub97c \uc88c\uc6b0\ud558\ub294 \uc8fc\uc694 \ub9e4\uac1c\ubcc0\uc218\ub294 \ubb34\uc5c7\uc774\uba70, \uc774\ub7ec\ud55c \ub9e4\uac1c\ubcc0\uc218\ub294 \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud3ad\uadc4 \ube44\ud589 \uac70\ub9ac\ub97c \uc88c\uc6b0\ud558\ub294 \uc8fc\uc694 \ub9e4\uac1c\ubcc0\uc218\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ubc29\ub9dd\uc774\uc758 \ud798 \uc18d\uc131, \ud0c0\uaca9 \uc2dc \ud798, \ud3ad\uadc4\uc758 \ucd08\uae30 \uc18d\ub3c4, \ube44\ud589 \uc911 \uacf5\uae30 \uc800\ud56d, \uadf8\ub9ac\uace0 \uc9c0\ud615\uacfc \ub3d9\ubb3c\uc758 \uc601\ud5a5\uc785\ub2c8\ub2e4. \ubc29\ub9dd\uc774\uc758 \ud798 \uc18d\uc131\uc744 \ub192\uc774\ub294 \uac83\uc740 \uae30\ubcf8\uc774\uba70, \ub354 \ub192\uc740 \ud798 \uc18d\uc131\uacfc \ub354 \ub098\uc740 \uacf5\uae30\uc5ed\ud559\uc744 \uc9c0\ub2cc \ubc29\ub9dd\uc774\ub97c \uc0ac\uc6a9\ud558\uba74 \ube44\ud589 \uc18d\ub3c4\ub97c \uc190\uc27d\uac8c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud0c0\uaca9 \uc2dc \ud798\uc740 \uc815\ud655\ud558\uac8c \uc870\uc808\ud574\uc57c \ud569\ub2c8\ub2e4. \uc9c4\ud589\ub960 \ud45c\uc2dc\uae30\uac00 \ucd5c\ub300\uce58\uc5d0 \uac00\uae4c\uc6b8 \ub54c \uacf5\uaca9\ud574\uc57c \ud569\ub2c8\ub2e4. \ub610\ud55c \ud3ad\uadc4\uc758 \ucd08\uae30 \uc18d\ub3c4\ub3c4 \uc911\uc694\ud558\uba70, \ud3ad\uadc4\uc758 \uc18d\ub3c4 \uc18d\uc131\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc5ec \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ube44\ud589 \uc911\uc5d0\ub294 \uc9c0\ud615\uacfc \ub3d9\ubb3c\uc744 \ud65c\uc6a9\ud558\uc5ec \uacf5\uae30 \uc800\ud56d\uc744 \uc904\uc774\uace0 \ucd94\uac00\uc801\uc778 \ucd94\uc9c4\ub825\uc744 \uc5bb\uc73c\ub824\uace0 \ub178\ub825\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ub9e4\uac1c\ubcc0\uc218\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc5b4\ub290 \ud55c \uce21\uba74\uc5d0\ub9cc \uc9d1\uc911\ud558\uc9c0 \ub9d0\uace0 \uade0\ud615\uc744 \ub9de\ucd94\uc5b4\uc57c \ud569\ub2c8\ub2e4. \u3010\ube44\uc720 \uc124\uba85: \uc790\ub3d9\ucc28 \uc870\ub9bd\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc5d4\uc9c4, \ucc28\uccb4, \ud0c0\uc774\uc5b4 \ub4f1 \ubaa8\ub4e0 \ubd80\ud488\uc758 \uc131\ub2a5\uc744 \uade0\ud615 \uc788\uac8c \ub9de\ucd94\uc5b4\uc57c \ud569\ub2c8\ub2e4.\u3011"}, {"question": "Bouncemasters \uc131\ucde8\ub3c4 \uc2dc\uc2a4\ud15c \uc2ec\uce35 \ubd84\uc11d: \uc5b4\ub5a4 \uc131\ucde8\ub3c4 \ub2ec\uc131\uc774 \uac00\uc7a5 \uc5b4\ub824\uc6b4\uac00\uc694? \uc774\ub7ec\ud55c \uc131\ucde8\ub3c4\ub97c \ub2ec\uc131\ud558\uae30 \uc704\ud574 \uc5b4\ub5a4 \ud301\uc774 \uc788\ub098\uc694?", "answer": "Bouncemasters \uc131\ucde8\ub3c4 \uc2dc\uc2a4\ud15c\uc5d0\ub294 \ub2e4\uc591\ud55c \ucc4c\ub9b0\uc9c0\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc73c\uba70, \uc77c\ubd80 \uc131\ucde8\ub3c4\ub294 \ud2b9\uc815 \uae30\uc220\uacfc \uc778\ub0b4\uc2ec\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ud55c \ubc88\uc5d0 \ub05d\ub0b4\uae30\" \uc131\ucde8\ub3c4\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \ud55c \ubc88\uc758 \ube44\ud589\uc73c\ub85c \ub9e4\uc6b0 \uba3c \uac70\ub9ac\ub97c \uc774\ub3d9\ud574\uc57c \ud558\ubbc0\ub85c \ubc29\ub9dd\uc774\uc640 \ud3ad\uadc4\uc758 \uc18d\uc131\uc744 \ucd5c\ub300\ud55c \uac15\ud654\ud558\uace0 \uc9c0\ud615\uacfc \ub3d9\ubb3c\uc758 \uc7a5\uc810\uc744 \uad50\ubb18\ud558\uac8c \ud65c\uc6a9\ud574\uc57c \ud569\ub2c8\ub2e4. \ub2ec\uc131 \ud301: \u2460 \ud798\uacfc \uc815\ud655\ub3c4 \uc18d\uc131\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uace0\ub824\ud55c \ubc29\ub9dd\uc774\ub97c \uc120\ud0dd\ud558\uc2ed\uc2dc\uc624. \u2461 \ud3ad\uadc4\uc758 \uc18d\ub3c4 \uc18d\uc131\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc5ec \ucd08\uae30 \uc18d\ub3c4\ub97c \ub192\uc774\uc2ed\uc2dc\uc624. \u2462 \uc9c0\ub3c4\ub97c \uc219\uc9c0\ud558\uc5ec \uc801\uc808\ud55c \uc0c1\uc2b9 \uae30\ub958\uc640 \ub3d9\ubb3c \ubb34\ub9ac\ub97c \ucc3e\uc73c\uc2ed\uc2dc\uc624. \u2463 \uc18d\ub3c4 \uc99d\uac00 \uc544\uc774\ud15c\uc744 \uc0ac\uc6a9\ud558\uc5ec \ube44\ud589 \uacbd\ub85c\ub97c \uc870\uc815\ud558\uace0 \ud3ad\uadc4\uc774 \uc815\ud655\ud558\uac8c \ubaa9\ud45c\ubb3c\uc5d0 \ucda9\ub3cc\ud560 \uc218 \uc788\ub3c4\ub85d \ud558\uc2ed\uc2dc\uc624. \"\ud53c\ud574 \uc5c6\uc774 \ud1b5\uacfc\ud558\uae30\" \uc131\ucde8\ub3c4\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uc5b4\ub5a0\ud55c \uc7a5\uc560\ubb3c\uc5d0\ub3c4 \ubd80\ub52a\ud788\uc9c0 \uc54a\uace0 \ube44\ud589\uc744 \uc644\ub8cc\ud574\uc57c \ud558\ubbc0\ub85c \uc870\uc791 \uae30\uc220 \uc694\uad6c \uc218\uc900\uc774 \ub9e4\uc6b0 \ub192\uc2b5\ub2c8\ub2e4. \uc5f0\uc2b5 \ubaa8\ub4dc\uc5d0\uc11c \ubc18\ubcf5 \uc5f0\uc2b5\ud558\uc5ec \ube44\ud589 \uada4\uc801\uc744 \uc219\ub2ec\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \u3010\ub2e4\uc591\ud55c \ubc29\uc548 \ube44\uad50: \uc77c\ubc18 \ubaa8\ub4dc\ub294 \uc5b4\ub824\uc6c0\uc774 \ub192\uace0, \uc5f0\uc2b5 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \ubc18\ubcf5 \uc2dc\ub3c4\uac00 \uac00\ub2a5\ud558\uace0, \uc544\uc774\ud15c\uc744 \uc0ac\uc6a9\ud558\uba74 \uc5b4\ub824\uc6c0\uc774 \uc904\uc5b4\ub4ed\ub2c8\ub2e4.\u3011"}, {"question": "Bouncemasters\uc5d0\uc11c \ud3ad\uadc4\uc758 \uc18d\ub3c4\ub97c \uacb0\uc815\ud558\ub294 \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc778\uac00\uc694? \uc18d\ub3c4\ub97c \uc870\uc791\ud558\ub294 \uc228\uaca8\uc9c4 \ud2b8\ub9ad\uc740 \uc788\ub098\uc694?", "answer": "\uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc740 \ucd08\uae30 \ubc1c\uc0ac \uc18d\ub3c4(\ubc29\ub9dd\uc774 \ud798\uacfc \ud3ad\uadc4 \uc18d\uc131\uc5d0 \uc758\ud574 \uacb0\uc815\ub428), \uc678\ubd80 \uc694\uc778(\ub3d9\ubb3c\uacfc \ubc14\ub78c), \uadf8\ub9ac\uace0 \uacf5\uae30 \uc800\ud56d\uc758 \uc870\ud569\uc785\ub2c8\ub2e4. \uc18d\ub3c4\ub97c \uc870\uc791\ud558\ub824\uba74 \ubc29\ub9dd\uc774\uc758 \ud798\uacfc \ud3ad\uadc4\uc758 \ucd08\uae30 \uc18d\ub3c4\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \ub610\ud55c \uc9c0\ud615\uc744 \ud65c\uc6a9\ud558\uc5ec \uc0c1\uc2b9 \uae30\ub958\ub098 \ud295\uae40 \ud6a8\uacfc\ub97c \uc81c\uacf5\ud558\ub294 \ub3d9\ubb3c\uc744 \uc774\uc6a9\ud558\uc2ed\uc2dc\uc624. \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\ub294 \uc774\ub7ec\ud55c \ud658\uacbd \uc694\uc18c\uc640 \ucd5c\ub300 \uc18d\ub3c4\ub97c \ub9de\ucd94\uae30 \uc704\ud574 \ubd80\uc2a4\ud2b8\uc758 \ud0c0\uc774\ubc0d\uc744 \ub9de\ucd94\ub294 \ub370 \uc131\uacf5\ud588\uc9c0\ub9cc, \uc190\uc27d\uac8c \ud65c\uc6a9\ud560 \uc218 \uc788\ub294 \"\uc228\uaca8\uc9c4 \ud2b8\ub9ad\"\uc774\ub098 \"\ubc84\uadf8\"\ub294 \uc5c6\uc2b5\ub2c8\ub2e4. \uc219\ub828\ub41c \uc9c0\ud615 \ud65c\uc6a9\uacfc \ubd80\uc2a4\ud2b8 \ud65c\uc131\ud654\ub294 \uc5ec\uc804\ud788 \uc911\uc694\ud569\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \ucd08\uae30 \uc18d\ub3c4 - \uae30\ubcf8 \uc18d\ub3c4, \uc678\ubd80 \uc694\uc18c - \uac00\uc18d\ub3c4/\uac10\uc18d\ub3c4, \ucd5c\uc885 \uc18d\ub3c4 - \uac70\ub9ac]"}, {"question": "Bouncemasters \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \uc9c8\ubb38: \uc548\ub4dc\ub85c\uc774\ub4dc\uc640 iOS \ud50c\ub7ab\ud3fc\uc758 \ub370\uc774\ud130\ub97c \uc0c1\ud638 \uc5f0\uacb0\ud560 \uc218 \uc788\ub098\uc694? \uac00\ub2a5\ud558\ub2e4\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud558\ub098\uc694?", "answer": "\uc8c4\uc1a1\ud558\uc9c0\ub9cc \ud604\uc7ac Bouncemasters\uc758 \uc548\ub4dc\ub85c\uc774\ub4dc\uc640 iOS \ud50c\ub7ab\ud3fc \uac04\uc758 \ub370\uc774\ud130\ub294 \uc77c\ubc18\uc801\uc73c\ub85c \uc0c1\ud638 \uc5f0\uacb0\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc774\ub294 \uc548\ub4dc\ub85c\uc774\ub4dc \uae30\uae30\uc5d0\uc11c\uc758 \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 iOS \uae30\uae30\ub85c \ubc14\ub85c \uc62e\uae38 \uc218 \uc5c6\uc74c\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \uc77c\ubd80 \uac8c\uc784\uc740 Facebook \ub610\ub294 Google Play \uacc4\uc815\uacfc \uac19\uc740 \uacc4\uc815 \uc5f0\ub3d9 \uae30\ub2a5\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. Bouncemasters\uac00 \uc774\ub7ec\ud55c \uae30\ub2a5\uc744 \uc9c0\uc6d0\ud558\ub294 \uacbd\uc6b0 \uacc4\uc815\uc744 \uc5f0\ub3d9\ud574 \ub370\uc774\ud130 \ub3d9\uae30\ud654\ub97c \uc2dc\ub3c4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784\uc774 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc18c\ub97c \uc9c0\uc6d0\ud558\uba74 \ud50c\ub7ab\ud3fc\uc744 \uc804\ud658\ud558\uc5ec \ub2e4\uc2dc \ub85c\uadf8\uc778\ud560 \ub54c \ud074\ub77c\uc6b0\ub4dc\uc5d0\uc11c \uc800\uc7a5\ub41c \ub370\uc774\ud130\ub97c \ubd88\ub7ec\uc640 \ub85c\uceec \uc800\uc7a5 \ub370\uc774\ud130\ub97c \ub36e\uc5b4\uc4f0\ub294 \ubc29\uc2dd\uc73c\ub85c \ud50c\ub7ab\ud3fc \uac04 \uc0c1\ud638 \uc6b4\uc6a9\uc131\uc774 \uc774\ub8e8\uc5b4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac00\uc7a5 \uc815\ud655\ud55c \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ub370\uc774\ud130 \ub3d9\uae30\ud654 \uc815\ubcf4\ub294 \uac8c\uc784\uc758 \uacf5\uc2dd FAQ \ub610\ub294 \uace0\uac1d \uc9c0\uc6d0 \uc13c\ud130\uc5d0\uc11c \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \u3010\ucc38\uace0: \uc791\uc5c5 \uc804\uc5d0 \ubc31\uc5c5\ud558\uc5ec \uc608\ubc29\ud558\uc138\uc694.\u3011"}, {"question": "Bouncemasters \uc228\uaca8\uc9c4 \uc694\uc18c \ud0d0\uad6c: \uac8c\uc784 \ub0b4\uc5d0 \uc228\uaca8\uc9c4 \ud3ad\uadc4 \uce90\ub9ad\ud130 \ub610\ub294 \ud2b9\ubcc4\ud55c \ub808\ubca8\uc774 \uc788\ub098\uc694? \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ub0b4\uc6a9\uc744 \uc5b4\ub5bb\uac8c \ud65c\uc131\ud654\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Bouncemasters\uc5d0\ub294 \uc2e4\uc81c\ub85c \uc228\uaca8\uc9c4 \ud3ad\uadc4 \uce90\ub9ad\ud130\uc640 \ud2b9\ubcc4\ud55c \ub808\ubca8\uc774 \uc874\uc7ac\ud558\uc9c0\ub9cc, \ud65c\uc131\ud654 \uc870\uac74\uc774 \uc228\uaca8\uc838 \uc788\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc2b5\ub2c8\ub2e4. \ud558\ub098\uc758 \uac00\ub2a5\uc131\uc740 \ud2b9\uc815 \uc131\ucde8\ub3c4\ub97c \ub2ec\uc131\ud558\uac70\ub098 \uc77c\ubd80 \uc228\uaca8\uc9c4 \ubbf8\uc158\uc744 \uc644\ub8cc\ud558\uc5ec \uc0c8\ub85c\uc6b4 \ud3ad\uadc4 \uce90\ub9ad\ud130\ub97c \uc7a0\uae08 \ud574\uc81c\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uac00\ub2a5\uc131\uc740 \uac8c\uc784\uc758 \ud2b9\uc815 \uc7a5\uc18c\uc5d0\uc11c \ud2b9\uc815 \uc21c\uc11c \ub610\ub294 \ubc29\uc2dd\uc73c\ub85c \uc870\uc791\uc744 \uc218\ud589\ud574\uc57c \uc228\uaca8\uc9c4 \ub808\ubca8\uc774 \ud65c\uc131\ud654\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud2b9\uc815 NPC\ub97c \ubc18\ubcf5\uc801\uc73c\ub85c \ud074\ub9ad\ud558\uac70\ub098 \ud2b9\uc815 \uc2dc\uac04\ub300\uc5d0 \uc5ec\ub7ec \ubbf8\uc158\uc744 \uc5f0\uc18d\ud574\uc11c \uc644\ub8cc\ud574\uc57c \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc73c\ub85c \uacf5\uc2dd\uc801\uc73c\ub85c \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ub0b4\uc6a9\uc758 \ud65c\uc131\ud654 \ubc29\ubc95\uc744 \uacf5\uac1c\ud558\uc9c0 \uc54a\uae30 \ub54c\ubb38\uc5d0 \ud50c\ub808\uc774\uc5b4\uac00 \uc9c1\uc811 \ud0d0\uc0c9\ud558\uace0 \uc2dc\ub3c4\ud574\uc57c \ud569\ub2c8\ub2e4. \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub4e4\uacfc \uac8c\uc784 \ucee4\ubba4\ub2c8\ud2f0\uc5d0\uc11c \uc815\ubcf4\ub97c \uad50\ud658\ud558\uba74 \ud78c\ud2b8\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uacfc\uac70 \uacbd\ud5d8\uc5d0 \ub530\ub974\uba74 \uacf5\ud734\uc77c \uae30\uac04\uc5d0\ub294 \uc0c8\ub85c\uc6b4 \uce90\ub9ad\ud130 \ubc0f \ub808\ubca8\uc774 \ud3ec\ud568\ub41c \ud55c\uc815 \uae30\uac04 \uc774\ubca4\ud2b8\uac00 \uc81c\uacf5\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\u3010\ube44\uc720 \uc124\uba85: \ubcf4\ubb3c\ucc3e\uae30 \uac8c\uc784\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc778\ub0b4\uc2ec\uacfc \uc138\uc2ec\ud55c \uad00\ucc30\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.\u3011"}]
[{"question": "Impostor.io\u306e\u57fa\u672c\u7684\u306a\u52d5\u304d\u65b9\u3092\u8aac\u660e\u3057\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "Impostor.io\u306e\u57fa\u672c\u7684\u306a\u52d5\u304d\u306f\u3001\u30b2\u30fc\u30e0\u5185\u3092\u79fb\u52d5\u3057\u3001\u751f\u304d\u6b8b\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u79fb\u52d5\u3059\u308b\u306b\u306f\u3001WASD\u30ad\u30fc\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002W\u30ad\u30fc\u306f\u524d\u9032\u3001A\u30ad\u30fc\u306f\u5de6\u3001S\u30ad\u30fc\u306f\u5f8c\u9000\u3001D\u30ad\u30fc\u306f\u53f3\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30de\u30c3\u30d7\u3092\u7d20\u65e9\u304f\u79fb\u52d5\u3059\u308b\u306b\u306f\u3001W\u30ad\u30fc\u3092\u62bc\u3057\u3066\u524d\u9032\u3057\u3001A\u30ad\u30fc\u307e\u305f\u306fD\u30ad\u30fc\u3092\u4f75\u7528\u3057\u3066\u65b9\u5411\u8ee2\u63db\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u3092\u62bc\u3059\u3068\u30b8\u30e3\u30f3\u30d7\u3067\u304d\u307e\u3059\u3002\u969c\u5bb3\u7269\u3092\u56de\u907f\u3057\u305f\u308a\u3001\u9ad8\u3044\u5834\u6240\u306b\u79fb\u52d5\u3057\u305f\u308a\u3059\u308b\u969b\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u306f\u3001\u30b2\u30fc\u30e0\u3092\u4e0a\u9054\u3059\u308b\u305f\u3081\u306e\u7b2c\u4e00\u6b69\u3067\u3059\u3002"}, {"question": "Impostor.io\u3067\u3001\u6f5c\u5165\u8005\u3092\u7279\u5b9a\u3059\u308b\u305f\u3081\u306e\u4e3b\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Impostor.io\u3067\u6f5c\u5165\u8005\u3092\u7279\u5b9a\u3059\u308b\u306b\u306f\u3001\u92ed\u3044\u89b3\u5bdf\u529b\u3068\u6226\u7565\u7684\u306a\u601d\u8003\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u884c\u52d5\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6f5c\u5165\u8005\u306f\u3001\u3057\u3070\u3057\u3070\u602a\u3057\u3044\u884c\u52d5\u3092\u3068\u3063\u305f\u308a\u3001\u30bf\u30b9\u30af\u304b\u3089\u5916\u308c\u305f\u308a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u7dca\u6025\u4f1a\u8b70\u30dc\u30bf\u30f3\u3092\u4f7f\u7528\u3057\u3066\u3001\u7591\u308f\u3057\u3044\u6f5c\u5165\u8005\u3092\u8a71\u3057\u5408\u3063\u3066\u6295\u7968\u3067\u6392\u9664\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30bf\u30b9\u30af\u30d0\u30fc\u3092\u89b3\u5bdf\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30bf\u30b9\u30af\u5b8c\u4e86\u3092\u4e3b\u5f35\u3057\u3066\u3082\u3001\u30bf\u30b9\u30af\u30d0\u30fc\u304c\u9032\u884c\u3057\u306a\u3044\u5834\u5408\u306f\u3001\u6f5c\u5165\u8005\u304c\u59a8\u5bb3\u3057\u3066\u3044\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u53cd\u5fdc\u7089\u306e\u8fd1\u304f\u306b\u3044\u308b\u306b\u3082\u304b\u304b\u308f\u3089\u305a\u3001\u30bf\u30b9\u30af\u30d0\u30fc\u304c\u5909\u5316\u3057\u306a\u3044\u5834\u5408\u306f\u3001\u6f5c\u5165\u8005\u3067\u3042\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u6226\u7565\u306f\u3001\u8105\u5a01\u3092\u767a\u898b\u3057\u6392\u9664\u3059\u308b\u80fd\u529b\u3092\u9ad8\u3081\u307e\u3059\u3002"}, {"question": "Impostor.io\u3067\u3001\u30af\u30eb\u30fc\u30e1\u30a4\u30c8\u306b\u3068\u3063\u3066\u30bf\u30b9\u30af\u306e\u5b8c\u4e86\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "Impostor.io\u3067\u3001\u30af\u30eb\u30fc\u30e1\u30a4\u30c8\u306b\u3068\u3063\u3066\u30bf\u30b9\u30af\u306e\u5b8c\u4e86\u306f\u3001\u30c1\u30fc\u30e0\u306e\u52dd\u5229\u306b\u76f4\u63a5\u8ca2\u732e\u3059\u308b\u305f\u3081\u91cd\u8981\u3067\u3059\u3002\u5404\u30bf\u30b9\u30af\u304c\u5b8c\u4e86\u3059\u308b\u3068\u3001\u30bf\u30b9\u30af\u30d0\u30fc\u304c\u57cb\u307e\u3063\u3066\u3086\u304d\u3001\u305d\u308c\u304c100%\u306b\u306a\u308b\u3068\u3001\u30af\u30eb\u30fc\u30e1\u30a4\u30c8\u306f\u52dd\u5229\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u96fb\u6c17\u5ba4\u306e\u914d\u7dda\u3092\u4fee\u7406\u3059\u308b\u3053\u3068\u306f\u3001\u5b8c\u4e86\u3059\u308b\u3068\u30bf\u30b9\u30af\u30d0\u30fc\u3092\u76ee\u6a19\u5024\u306b\u8fd1\u3065\u3051\u308b\u4e00\u822c\u7684\u306a\u30bf\u30b9\u30af\u3067\u3059\u3002\u30bf\u30b9\u30af\u3092\u7121\u8996\u3059\u308b\u3068\u3001\u9032\u6357\u304c\u9045\u308c\u308b\u3060\u3051\u3067\u306a\u304f\u3001\u6f5c\u5165\u8005\u306b\u3082\u30af\u30eb\u30fc\u30e1\u30a4\u30c8\u3092\u6392\u9664\u3059\u308b\u6642\u9593\u3092\u4e0e\u3048\u3066\u3057\u307e\u3044\u307e\u3059\u3002\u3057\u305f\u304c\u3063\u3066\u3001\u30bf\u30b9\u30af\u3092\u512a\u5148\u3059\u308b\u3053\u3068\u306f\u3001\u30af\u30eb\u30fc\u306e\u6210\u529f\u3092\u78ba\u4fdd\u3059\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002"}, {"question": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306fImpostor.io\u3067\u30b5\u30dc\u30bf\u30fc\u30b8\u30e5\u6226\u8853\u3092\u3069\u306e\u3088\u3046\u306b\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001Impostor.io\u3067\u30b5\u30dc\u30bf\u30fc\u30b8\u30e5\u6226\u8853\u3092\u3001\u30b5\u30dc\u30bf\u30fc\u30b8\u30e5\u306e\u6642\u6a5f\u3068\u5bfe\u8c61\u3092\u6226\u7565\u7684\u306b\u9078\u3076\u3053\u3068\u3067\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u9ad8\u3044\u30c8\u30e9\u30d5\u30a3\u30c3\u30af\u30a8\u30ea\u30a2\u3067\u6249\u3092\u30ed\u30c3\u30af\u3059\u308b\u306a\u3069\u3001\u6700\u5927\u9650\u306e\u6df7\u4e71\u3092\u5f15\u304d\u8d77\u3053\u3059\u30b5\u30dc\u30bf\u30fc\u30b8\u30e5\u3092\u9078\u3093\u3067\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30af\u30eb\u30fc\u30e1\u30a4\u30c8\u304c\u30bf\u30b9\u30af\u5b8c\u4e86\u5bf8\u524d\u306a\u3069\u306e\u91cd\u8981\u306a\u5c40\u9762\u3067\u30b5\u30dc\u30bf\u30fc\u30b8\u30e5\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\
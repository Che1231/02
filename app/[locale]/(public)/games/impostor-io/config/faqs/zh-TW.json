[{"question": "\u5982\u4f55\u5728 Impostor.io \u4e2d\u57f7\u884c\u57fa\u672c\u52d5\u4f5c\uff1f", "answer": "\u5728 Impostor.io \u4e2d\uff0c\u57fa\u672c\u52d5\u4f5c\u5c0d\u65bc\u5c0e\u822a\u548c\u751f\u5b58\u81f3\u95dc\u91cd\u8981\u3002\u8981\u79fb\u52d5\uff0c\u8acb\u4f7f\u7528 WASD \u9375\uff1aW \u4ee3\u8868\u524d\u9032\uff0cA \u4ee3\u8868\u5411\u5de6\uff0cS \u4ee3\u8868\u5411\u5f8c\uff0cD \u4ee3\u8868\u5411\u53f3\u3002\u4f8b\u5982\uff0c\u8981\u5feb\u901f\u700f\u89bd\u5730\u5716\uff0c\u8acb\u6309\u4e0b W \u524d\u9032\uff0c\u4e26\u7d50\u5408 A \u6216 D \u4f86\u64cd\u7e31\u65b9\u5411\u3002\u6b64\u5916\uff0c\u7a7a\u683c\u9375\u5141\u8a31\u4f60\u8df3\u8e8d\uff0c\u9019\u5c0d\u65bc\u907f\u514d\u969c\u7919\u6216\u5230\u9054\u8f03\u9ad8\u7684\u5e73\u53f0\u5f88\u6709\u7528\u3002\u638c\u63e1\u9019\u4e9b\u63a7\u5236\u529f\u80fd\u662f\u6210\u70ba\u904a\u6232\u9ad8\u624b\u7684\u7b2c\u4e00\u6b65\u3002"}, {"question": "\u5728 Impostor.io \u4e2d\u8b58\u5225\u9a19\u5b50\u7684\u95dc\u9375\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728 Impostor.io \u4e2d\u8b58\u5225\u9a19\u5b50\u9700\u8981\u654f\u92b3\u7684\u89c0\u5bdf\u529b\u548c\u7b56\u7565\u6027\u601d\u7dad\u3002\u6b65\u9a5f\u4e00\uff1a\u7559\u610f\u73a9\u5bb6\u7684\u884c\u70ba\uff1b\u9a19\u5b50\u901a\u5e38\u6703\u8868\u73fe\u51fa\u53ef\u7591\u7684\u884c\u70ba\u6216\u504f\u96e2\u4efb\u52d9\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u7dca\u6025\u6703\u8b70\u6309\u9215\u8a0e\u8ad6\u4e26\u6295\u7968\u9a45\u9010\u61f7\u7591\u7684\u9a19\u5b50\u3002\u6b65\u9a5f\u4e09\uff1a\u5bc6\u5207\u6ce8\u610f\u4efb\u52d9\u6b04\uff1b\u5982\u679c\u4efb\u52d9\u672a\u80fd\u5728\u73a9\u5bb6\u8072\u7a31\u5b8c\u6210\u4efb\u52d9\u5f8c\u53d6\u5f97\u9032\u5c55\uff0c\u5247\u9a19\u5b50\u53ef\u80fd\u6b63\u5728\u7834\u58de\u3002\u4f8b\u5982\uff0c\u5982\u679c\u73a9\u5bb6\u9760\u8fd1\u53cd\u61c9\u5806\uff0c\u4f46\u4efb\u52d9\u6b04\u4ecd\u672a\u6539\u8b8a\uff0c\u5247\u4ed6\u5011\u53ef\u80fd\u662f\u9a19\u5b50\u3002\u9019\u4e9b\u7b56\u7565\u589e\u5f37\u4e86\u4f60\u8b58\u5225\u4e26\u6d88\u9664\u5a01\u8105\u7684\u80fd\u529b\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u4efb\u52d9\u5b8c\u6210\u5c0d Impostor.io \u4e2d\u7684\u8239\u54e1\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u5728 Impostor.io \u4e2d\uff0c\u4efb\u52d9\u5b8c\u6210\u5c0d\u65bc\u8239\u54e1\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u76f4\u63a5\u5f71\u97ff\u5718\u968a\u7684\u52dd\u5229\u3002\u6bcf\u5b8c\u6210\u4e00\u9805\u4efb\u52d9\uff0c\u4efb\u52d9\u6b04\u5c31\u6703\u586b\u6eff\uff0c\u7576\u5b83\u9054\u5230 100% \u6642\uff0c\u8239\u54e1\u5011\u5c31\u6703\u7372\u52dd\u3002\u4f8b\u5982\uff0c\u5728\u96fb\u6c23\u5ba4\u4fee\u7406\u96fb\u7dda\u662f\u4e00\u9805\u5e38\u898b\u7684\u4efb\u52d9\uff0c\u5b8c\u6210\u5f8c\u6703\u4f7f\u4efb\u52d9\u6b04\u66f4\u63a5\u8fd1\u76ee\u6a19\u3002\u5ffd\u8996\u4efb\u52d9\u4e0d\u50c5\u6703\u963b\u7919\u9032\u5ea6\uff0c\u9084\u6703\u7d66\u9a19\u5b50\u66f4\u591a\u6642\u9593\u4f86\u6d88\u6ec5\u8239\u54e1\u3002\u56e0\u6b64\uff0c\u512a\u5148\u8655\u7406\u4efb\u52d9\u5c0d\u65bc\u78ba\u4fdd\u5718\u968a\u7684\u6210\u529f\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u5148\u9032\u73a9\u5bb6\u5982\u4f55\u5728 Impostor.io \u4e2d\u512a\u5316\u4ed6\u5011\u7684\u7834\u58de\u7b56\u7565\uff1f", "answer": "\u5148\u9032\u73a9\u5bb6\u53ef\u4ee5\u5728 Impostor.io \u4e2d\u512a\u5316\u7834\u58de\u7b56\u7565\uff0c\u901a\u904e\u7b56\u7565\u6027\u5730\u5b89\u6392\u548c\u9078\u64c7\u7834\u58de\u3002\u6b65\u9a5f\u4e00\uff1a\u9078\u64c7\u80fd\u5728\u9ad8\u6d41\u91cf\u5340\u57df\u9020\u6210\u6700\u5927\u6df7\u4e82\u7684\u7834\u58de\uff0c\u4f8b\u5982\u9396\u4f4f\u9580\u3002\u6b65\u9a5f\u4e8c\uff1a\u5728\u8239\u54e1\u5373\u5c07\u5b8c\u6210\u4efb\u52d9\u7684\u95dc\u9375\u6642\u523b\u4f7f\u7528\u7834\u58de\u3002\u6b65\u9a5f\u4e09\uff1a\u8207\u5176\u4ed6\u9a19\u5b50\u5354\u8abf\u57f7\u884c\u540c\u6642\u7834\u58de\uff0c\u8b93\u8239\u54e1\u63aa\u624b\u4e0d\u53ca\u3002\u4f8b\u5982\uff0c\u7576\u53e6\u4e00\u4f4d\u9a19\u5b50\u9396\u4e0a\u9580\u6642\uff0c\u7834\u58de\u71c8\u5149\u53ef\u80fd\u6703\u8b93\u8239\u54e1\u611f\u5230\u8ff7\u60d1\uff0c\u66f4\u5bb9\u6613\u5c07\u4ed6\u5011\u6d88\u6ec5\u3002\u9019\u4e9b\u7b56\u7565\u589e\u5f37\u4e86\u4f60\u7684\u7834\u58de\u884c\u52d5\u7684\u6709\u6548\u6027\u3002"}, {"question": "\u7dca\u6025\u6703\u8b70\u6309\u9215\u5728 Impostor.io \u4e2d\u626e\u6f14\u4ec0\u9ebc\u89d2\u8272\uff1f", "answer": "Impostor.io \u4e2d\u7684\u7dca\u6025\u6703\u8b70\u6309\u9215\u662f\u8239\u54e1\u8a0e\u8ad6\u61f7\u7591\u4e26\u6295\u7968\u9a45\u9010\u9a19\u5b50\u7684\u91cd\u8981\u5de5\u5177\u3002\u6309\u4e0b\u6309\u9215\u5f8c\uff0c\u904a\u6232\u6703\u66ab\u505c\uff0c\u958b\u555f\u8a0e\u8ad6\u968e\u6bb5\uff0c\u8b93\u73a9\u5bb6\u53ef\u4ee5\u5206\u4eab\u89c0\u5bdf\u7d50\u679c\u548c\u8b49\u64da\u3002\u4f8b\u5982\uff0c\u5982\u679c\u73a9\u5bb6\u76ee\u7779\u53e6\u4e00\u500b\u4eba\u9032\u884c\u901a\u98a8\u6d29\u6f0f\uff0c\u4ed6\u5011\u53ef\u4ee5\u53ec\u958b\u6703\u8b70\u5831\u544a\u9019\u4e00\u53ef\u7591\u884c\u70ba\u3002\u8a72\u6309\u9215\u5177\u6709\u96d9\u5203\u528d\u7684\u7279\u6027\uff1b\u96d6\u7136\u5b83\u6709\u52a9\u65bc\u8b58\u5225\u9a19\u5b50\uff0c\u4f46\u6feb\u7528\u53ef\u80fd\u6703\u5c0e\u81f4\u7121\u8f9c\u8239\u54e1\u88ab\u932f\u8aa4\u9a45\u9010\u3002\u4e86\u89e3\u5176\u4f5c\u7528\u5c0d\u65bc\u7dad\u8b77\u5718\u968a\u5b8c\u6574\u6027\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u5728 Impostor.io \u4e2d\uff0c\u54ea\u4e9b\u8a2d\u5b9a\u61c9\u8a72\u8abf\u6574\u4ee5\u7372\u5f97\u6700\u4f73\u6548\u80fd\uff1f", "answer": "\u5728 Impostor.io \u4e2d\u8abf\u6574\u8a2d\u5b9a\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u4f60\u7684\u904a\u6232\u9ad4\u9a57\u3002\u9996\u5148\uff0c\u78ba\u4fdd\u4f60\u7684\u5716\u5f62\u8a2d\u5b9a\u7b26\u5408\u4f60\u88dd\u7f6e\u7684\u529f\u80fd\uff1b\u964d\u4f4e\u89e3\u6790\u5ea6\u53ef\u4ee5\u6539\u5584\u820a\u88dd\u7f6e\u7684\u6548\u80fd\u3002\u5176\u6b21\uff0c\u81ea\u8a02\u4f60\u7684\u63a7\u5236\u8a2d\u5b9a\u4ee5\u7372\u5f97\u66f4\u597d\u7684\u53cd\u61c9\uff1b\u5c07\u6309\u9375\u91cd\u65b0\u8a2d\u5b9a\u70ba\u66f4\u8212\u9069\u7684\u4f4d\u7f6e\u53ef\u4ee5\u4f7f\u52d5\u4f5c\u66f4\u9806\u66a2\u3002\u7b2c\u4e09\uff0c\u8abf\u6574\u97f3\u6548\u8a2d\u5b9a\uff0c\u4ee5\u4fbf\u6e05\u6670\u807d\u5230\u904a\u6232\u63d0\u793a\u97f3\uff0c\u4f8b\u5982\u8173\u6b65\u8072\u6216\u7834\u58de\u8b66\u5831\u3002\u4f8b\u5982\uff0c\u589e\u52a0\u8173\u6b65\u8072\u7684\u97f3\u91cf\u53ef\u4ee5\u5e6b\u52a9\u4f60\u5075\u6e2c\u9a19\u5b50\u5077\u5077\u63a5\u8fd1\u4f60\u3002\u9019\u4e9b\u8abf\u6574\u80fd\u78ba\u4fdd\u6700\u4f73\u6548\u80fd\uff0c\u4e26\u63d0\u4f9b\u66f4\u6109\u5feb\u7684\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u4efb\u52d9\u6b04\u6a5f\u5236\u5728 Impostor.io \u4e2d\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "Impostor.io \u4e2d\u7684\u4efb\u52d9\u6b04\u6a5f\u5236\u8ffd\u8e64\u8239\u54e1\u4efb\u52d9\u7684\u9032\u5ea6\u3002\u6bcf\u5b8c\u6210\u4e00\u9805\u4efb\u52d9\uff0c\u4efb\u52d9\u6b04\u5c31\u6703\u586b\u5145\u4e00\u90e8\u5206\uff0c\u7576\u5b83\u9054\u5230 100% \u6642\uff0c\u8239\u54e1\u5011\u5c31\u6703\u7372\u52dd\u3002\u4efb\u52d9\u6b04\u6703\u5373\u6642\u66f4\u65b0\uff0c\u63d0\u4f9b\u5718\u968a\u9032\u5ea6\u7684\u8996\u89ba\u6307\u793a\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4efb\u52d9\u6b04\u70ba 75%\uff0c\u8868\u793a\u8239\u54e1\u5011\u5373\u5c07\u52dd\u5229\u3002\u7136\u800c\uff0c\u9a19\u5b50\u53ef\u80fd\u7834\u58de\u4efb\u52d9\uff0c\u963b\u7919\u9032\u5ea6\uff0c\u4e26\u7d66\u4e88\u4ed6\u5011\u66f4\u591a\u6642\u9593\u4f86\u6d88\u6ec5\u8239\u54e1\u3002\u4e86\u89e3\u6b64\u6a5f\u5236\u6709\u52a9\u65bc\u8239\u54e1\u512a\u5148\u8655\u7406\u4efb\u52d9\uff0c\u4ee5\u53ca\u9a19\u5b50\u5236\u5b9a\u7834\u58de\u7b56\u7565\u3002"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u904b\u884c Impostor.io \u9700\u8981\u54ea\u4e9b\u7cfb\u7d71\u9700\u6c42\uff1f", "answer": "Impostor.io \u7684\u7cfb\u7d71\u9700\u6c42\u6703\u56e0\u5e73\u53f0\u800c\u7570\u3002\u5728\u96fb\u8166\u4e0a\uff0c\u5b83\u81f3\u5c11\u9700\u8981\u96d9\u6838\u5fc3\u8655\u7406\u5668\u30014GB \u8a18\u61b6\u9ad4\u548c DirectX 11 \u76f8\u5bb9\u7684\u986f\u793a\u5361\u3002\u5c0d\u65bc\u884c\u52d5\u88dd\u7f6e\uff0c\u5b83\u9700\u8981 iOS 10 \u6216 Android 7.0\uff0c\u4ee5\u53ca 2GB \u8a18\u61b6\u9ad4\u3002\u5728 PlayStation \u548c Xbox \u7b49\u904a\u6232\u4e3b\u6a5f\u4e0a\uff0c\u5b83\u9700\u8981\u7a69\u5b9a\u7684\u7db2\u8def\u9023\u7dda\u548c\u6700\u65b0\u7684\u7cfb\u7d71\u66f4\u65b0\u3002\u4f8b\u5982\uff0c\u5728\u5177\u6709 8GB \u8a18\u61b6\u9ad4\u548c\u7368\u7acb\u986f\u793a\u5361\u7684\u96fb\u8166\u4e0a\u73a9\u904a\u6232\uff0c\u53ef\u4ee5\u78ba\u4fdd\u904a\u6232\u6bd4\u57fa\u672c\u8a2d\u5b9a\u66f4\u9806\u66a2\u3002\u6eff\u8db3\u9019\u4e9b\u9700\u6c42\u53ef\u4ee5\u78ba\u4fdd\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u7372\u5f97\u9806\u66a2\u7684\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u767c\u73fe Impostor.io \u4e2d\u7684\u96b1\u85cf\u5f69\u86cb\uff1f", "answer": "\u5728 Impostor.io \u4e2d\u767c\u73fe\u96b1\u85cf\u5f69\u86cb\u9700\u8981\u63a2\u7d22\u904a\u6232\u74b0\u5883\u4e26\u7559\u610f\u7d30\u5fae\u7684\u7d30\u7bc0\u3002\u4f8b\u5982\uff0c\u67d0\u4e9b\u623f\u9593\u5728\u7279\u5b9a\u4e92\u52d5\u65b9\u5f0f\u4e0b\u53ef\u80fd\u5305\u542b\u96b1\u85cf\u8a0a\u606f\u6216\u6d41\u884c\u6587\u5316\u53c3\u8003\u3002\u73a9\u5bb6\u4e5f\u61c9\u8a72\u50be\u807d\u4e0d\u5c0b\u5e38\u7684\u8072\u97f3\u6216\u5c0b\u627e\u53ef\u80fd\u6697\u793a\u5f69\u86cb\u7684\u683c\u683c\u4e0d\u5165\u7684\u7269\u4ef6\u3002\u8207\u5176\u4ed6\u73a9\u5bb6\u5408\u4f5c\u5206\u4eab\u767c\u73fe\u4e5f\u6709\u52a9\u65bc\u767c\u73fe\u9019\u4e9b\u96b1\u85cf\u5f69\u86cb\u3002\u9019\u4e9b\u5f69\u86cb\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u984d\u5916\u7684\u6a02\u8da3\u548c\u795e\u79d8\u611f\u3002"}, {"question": "\u5728\u4e0d\u540c\u88dd\u7f6e\u4e4b\u9593\u8f49\u63db Impostor.io \u8cc7\u6599\u7684\u6b65\u9a5f\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u4e0d\u540c\u88dd\u7f6e\u4e4b\u9593\u8f49\u63db Impostor.io \u8cc7\u6599\u9700\u8981\u4e00\u4e9b\u7c21\u55ae\u7684\u6b65\u9a5f\u3002\u6b65\u9a5f\u4e00\uff1a\u78ba\u4fdd\u4f60\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u3002\u6b65\u9a5f\u4e8c\uff1a\u5728\u539f\u59cb\u88dd\u7f6e\u4e0a\uff0c\u524d\u5f80\u8a2d\u5b9a\u9078\u55ae\uff0c\u7136\u5f8c\u9078\u64c7\u300c\u540c\u6b65\u8cc7\u6599\u300d\u5c07\u4f60\u7684\u9032\u5ea6\u4e0a\u50b3\u5230\u96f2\u7aef\u3002\u6b65\u9a5f\u4e09\uff1a\u5728\u65b0\u88dd\u7f6e\u4e0a\uff0c\u767b\u5165\u4e26\u9078\u64c7\u300c\u540c\u6b65\u8cc7\u6599\u300d\u4e0b\u8f09\u4f60\u7684\u5132\u5b58\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5f9e\u96fb\u8166\u5207\u63db\u5230\u884c\u52d5\u88dd\u7f6e\uff0c\u540c\u6b65\u8cc7\u6599\u53ef\u78ba\u4fdd\u4f60\u7684\u904a\u6232\u9032\u5ea6\u3001\u6210\u5c31\u548c\u8a2d\u5b9a\u5f97\u4ee5\u4fdd\u7559\u3002\u6b64\u904e\u7a0b\u5141\u8a31\u4f60\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u9806\u66a2\u5730\u7e7c\u7e8c\u904a\u6232\u3002"}]
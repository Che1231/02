[{"question": "\u5982\u4f55\u5728Impostor.io\u4e2d\u6267\u884c\u57fa\u672c\u79fb\u52a8\uff1f", "answer": "\u5728Impostor.io\u4e2d\uff0c\u57fa\u672c\u79fb\u52a8\u5bf9\u4e8e\u5bfc\u822a\u548c\u751f\u5b58\u81f3\u5173\u91cd\u8981\u3002\u8981\u79fb\u52a8\uff0c\u8bf7\u4f7f\u7528WASD\u952e\uff1aW\u5411\u524d\u79fb\u52a8\uff0cA\u5411\u5de6\u79fb\u52a8\uff0cS\u5411\u540e\u79fb\u52a8\uff0cD\u5411\u53f3\u79fb\u52a8\u3002\u4f8b\u5982\uff0c\u8981\u5feb\u901f\u6d4f\u89c8\u5730\u56fe\uff0c\u8bf7\u6309\u4e0bW\u5411\u524d\u79fb\u52a8\uff0c\u5e76\u7ed3\u5408A\u6216D\u8fdb\u884c\u8f6c\u5411\u3002\u6b64\u5916\uff0c\u7a7a\u683c\u952e\u53ef\u4ee5\u8ba9\u4f60\u8df3\u8dc3\uff0c\u8fd9\u5bf9\u4e8e\u907f\u514d\u969c\u788d\u7269\u6216\u5230\u8fbe\u66f4\u9ad8\u7684\u5e73\u53f0\u975e\u5e38\u6709\u7528\u3002\u638c\u63e1\u8fd9\u4e9b\u63a7\u5236\u662f\u6210\u4e3a\u6e38\u620f\u9ad8\u624b\u7684\u7b2c\u4e00\u6b65\u3002"}, {"question": "\u5728Impostor.io\u4e2d\u8bc6\u522b\u9a97\u5b50\u7684\u5173\u952e\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728Impostor.io\u4e2d\u8bc6\u522b\u9a97\u5b50\u9700\u8981\u654f\u9510\u7684\u89c2\u5bdf\u529b\u548c\u6218\u7565\u601d\u7ef4\u3002\u6b65\u9aa41\uff1a\u6ce8\u610f\u73a9\u5bb6\u7684\u884c\u4e3a\uff1b\u9a97\u5b50\u901a\u5e38\u4f1a\u8868\u73b0\u51fa\u53ef\u7591\u7684\u884c\u4e3a\u6216\u504f\u79bb\u4efb\u52a1\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u7d27\u6025\u4f1a\u8bae\u6309\u94ae\u8ba8\u8bba\u5e76\u6295\u7968\u9a71\u9010\u53ef\u7591\u7684\u9a97\u5b50\u3002\u6b65\u9aa43\uff1a\u5bc6\u5207\u5173\u6ce8\u4efb\u52a1\u680f\uff1b\u5982\u679c\u4efb\u52a1\u8fdb\u5ea6\u672a\u6309\u73a9\u5bb6\u58f0\u79f0\u5b8c\u6210\u7684\u60c5\u51b5\u8fdb\u884c\uff0c\u5219\u53ef\u80fd\u5b58\u5728\u9a97\u5b50\u5728\u7834\u574f\u64cd\u4f5c\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4e00\u540d\u73a9\u5bb6\u9760\u8fd1\u53cd\u5e94\u5806\u4f46\u4efb\u52a1\u680f\u4fdd\u6301\u4e0d\u53d8\uff0c\u4ed6\u4eec\u53ef\u80fd\u5c31\u662f\u9a97\u5b50\u3002\u8fd9\u4e9b\u7b56\u7565\u589e\u5f3a\u4e86\u60a8\u8bc6\u522b\u548c\u6d88\u9664\u5a01\u80c1\u7684\u80fd\u529b\u3002"}, {"question": "\u4e3a\u4ec0\u4e48Impostor.io\u4e2d\u7684\u8239\u5458\u5b8c\u6210\u4efb\u52a1\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u5728Impostor.io\u4e2d\uff0c\u5b8c\u6210\u4efb\u52a1\u5bf9\u4e8e\u8239\u5458\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u76f4\u63a5\u5173\u7cfb\u5230\u56e2\u961f\u7684\u80dc\u5229\u3002\u5b8c\u6210\u6bcf\u4e2a\u4efb\u52a1\u90fd\u4f1a\u586b\u5145\u4efb\u52a1\u680f\uff0c\u5f53\u4efb\u52a1\u680f\u8fbe\u5230100%\u65f6\uff0c\u8239\u5458\u83b7\u80dc\u3002\u4f8b\u5982\uff0c\u5728\u7535\u5de5\u5ba4\u4fee\u7406\u7535\u7ebf\u662f\u4e00\u4e2a\u5e38\u89c1\u7684\u4efb\u52a1\uff0c\u5b8c\u6210\u6b64\u4efb\u52a1\u4f1a\u4f7f\u4efb\u52a1\u680f\u66f4\u63a5\u8fd1\u76ee\u6807\u3002\u5ffd\u7565\u4efb\u52a1\u4e0d\u4ec5\u4f1a\u963b\u788d\u8fdb\u5ea6\uff0c\u8fd8\u4f1a\u8ba9\u9a97\u5b50\u6709\u66f4\u591a\u65f6\u95f4\u6765\u6e05\u9664\u8239\u5458\u3002\u56e0\u6b64\uff0c\u4f18\u5148\u8003\u8651\u4efb\u52a1\u5bf9\u4e8e\u786e\u4fdd\u8239\u5458\u7684\u6210\u529f\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u9ad8\u7ea7\u73a9\u5bb6\u5982\u4f55\u5728Impostor.io\u4e2d\u4f18\u5316\u4ed6\u4eec\u7684\u7834\u574f\u7b56\u7565\uff1f", "answer": "\u9ad8\u7ea7\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u6218\u7565\u6027\u5730\u8c03\u6574\u548c\u9009\u62e9\u7834\u574f\u6765\u4f18\u5316Impostor.io\u4e2d\u7684\u7834\u574f\u7b56\u7565\u3002\u6b65\u9aa41\uff1a\u9009\u62e9\u80fd\u591f\u9020\u6210\u6700\u5927\u6df7\u4e71\u7684\u7834\u574f\uff0c\u4f8b\u5982\u5728\u4eba\u6d41\u91cf\u5927\u7684\u533a\u57df\u9501\u95e8\u3002\u6b65\u9aa42\uff1a\u5728\u8239\u5458\u5373\u5c06\u5b8c\u6210\u4efb\u52a1\u7684\u5173\u952e\u65f6\u523b\u4f7f\u7528\u7834\u574f\u3002\u6b65\u9aa43\uff1a\u4e0e\u5176\u4ed6\u9a97\u5b50\u534f\u8c03\uff0c\u5b9e\u65bd\u540c\u65f6\u7834\u574f\uff0c\u4f7f\u8239\u5458\u63aa\u624b\u4e0d\u53ca\u3002\u4f8b\u5982\uff0c\u5728\u4e00\u4e2a\u9a97\u5b50\u9501\u95e8\u7684\u540c\u65f6\u7834\u574f\u706f\u5149\uff0c\u53ef\u4ee5\u4f7f\u8239\u5458\u8ff7\u5931\u65b9\u5411\uff0c\u66f4\u5bb9\u6613\u88ab\u6e05\u9664\u3002\u8fd9\u4e9b\u7b56\u7565\u589e\u5f3a\u4e86\u7834\u574f\u884c\u52a8\u7684\u6709\u6548\u6027\u3002"}, {"question": "Impostor.io\u4e2d\u7d27\u6025\u4f1a\u8bae\u6309\u94ae\u7684\u4f5c\u7528\u662f\u4ec0\u4e48\uff1f", "answer": "Impostor.io\u4e2d\u7684\u7d27\u6025\u4f1a\u8bae\u6309\u94ae\u662f\u8239\u5458\u8ba8\u8bba\u7591\u70b9\u5e76\u6295\u7968\u9a71\u9010\u9a97\u5b50\u7684\u91cd\u8981\u5de5\u5177\u3002\u6309\u4e0b\u6309\u94ae\u540e\uff0c\u6e38\u620f\u4f1a\u6682\u505c\uff0c\u5e76\u5f00\u542f\u4e00\u4e2a\u8ba8\u8bba\u9636\u6bb5\uff0c\u73a9\u5bb6\u53ef\u4ee5\u5728\u5176\u4e2d\u5206\u4eab\u89c2\u5bdf\u7ed3\u679c\u548c\u8bc1\u636e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4e00\u540d\u73a9\u5bb6\u76ee\u7779\u53e6\u4e00\u4e2a\u4eba\u5728\u901a\u98ce\uff0c\u4ed6\u4eec\u53ef\u4ee5\u53ec\u5f00\u4f1a\u8bae\u62a5\u544a\u8fd9\u4e00\u53ef\u7591\u6d3b\u52a8\u3002\u8be5\u6309\u94ae\u5177\u6709\u53cc\u5203\u5251\u7684\u4f5c\u7528\uff1b\u867d\u7136\u5b83\u6709\u52a9\u4e8e\u8bc6\u522b\u9a97\u5b50\uff0c\u4f46\u6ee5\u7528\u53ef\u80fd\u4f1a\u5bfc\u81f4\u65e0\u8f9c\u8239\u5458\u88ab\u9519\u8bef\u9a71\u9010\u3002\u4e86\u89e3\u5176\u4f5c\u7528\u5bf9\u4e8e\u7ef4\u62a4\u56e2\u961f\u7684\u5b8c\u6574\u6027\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u5728Impostor.io\u4e2d\uff0c\u54ea\u4e9b\u8bbe\u7f6e\u5e94\u8be5\u8fdb\u884c\u8c03\u6574\u4ee5\u83b7\u5f97\u6700\u4f73\u6027\u80fd\uff1f", "answer": "\u8c03\u6574Impostor.io\u4e2d\u7684\u8bbe\u7f6e\u53ef\u4ee5\u663e\u8457\u63d0\u5347\u60a8\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u9996\u5148\uff0c\u786e\u4fdd\u60a8\u7684\u56fe\u5f62\u8bbe\u7f6e\u4e0e\u8bbe\u5907\u7684\u6027\u80fd\u76f8\u5339\u914d\uff1b\u964d\u4f4e\u5206\u8fa8\u7387\u53ef\u4ee5\u63d0\u9ad8\u65e7\u8bbe\u5907\u7684\u6027\u80fd\u3002\u5176\u6b21\uff0c\u81ea\u5b9a\u4e49\u60a8\u7684\u63a7\u5236\u4ee5\u83b7\u5f97\u66f4\u597d\u7684\u54cd\u5e94\u80fd\u529b\uff1b\u91cd\u65b0\u6620\u5c04\u952e\u5230\u66f4\u8212\u9002\u7684\u4f4d\u7f6e\u53ef\u4ee5\u4f7f\u79fb\u52a8\u66f4\u6d41\u7545\u3002\u7b2c\u4e09\uff0c\u8c03\u6574\u97f3\u9891\u8bbe\u7f6e\u4ee5\u6e05\u6670\u5730\u542c\u5230\u6e38\u620f\u63d0\u793a\u97f3\uff0c\u4f8b\u5982\u811a\u6b65\u58f0\u6216\u7834\u574f\u8b66\u62a5\u3002\u4f8b\u5982\uff0c\u589e\u52a0\u811a\u6b65\u58f0\u7684\u97f3\u91cf\u53ef\u4ee5\u5e2e\u52a9\u60a8\u68c0\u6d4b\u6f5c\u4f0f\u7684\u9a97\u5b50\u3002\u8fd9\u4e9b\u8c03\u6574\u786e\u4fdd\u4e86\u6700\u4f73\u6027\u80fd\u548c\u66f4\u6109\u5feb\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "Impostor.io\u4e2d\u7684\u4efb\u52a1\u680f\u673a\u5236\u662f\u5982\u4f55\u5de5\u4f5c\u7684\uff1f", "answer": "Impostor.io\u4e2d\u7684\u4efb\u52a1\u680f\u673a\u5236\u8ddf\u8e2a\u8239\u5458\u4efb\u52a1\u7684\u8fdb\u5ea6\u3002\u5b8c\u6210\u6bcf\u4e2a\u4efb\u52a1\u90fd\u4f1a\u586b\u5145\u90e8\u5206\u4efb\u52a1\u680f\uff0c\u5f53\u4efb\u52a1\u680f\u8fbe\u5230100%\u65f6\uff0c\u8239\u5458\u83b7\u80dc\u3002\u4efb\u52a1\u680f\u4f1a\u5b9e\u65f6\u66f4\u65b0\uff0c\u63d0\u4f9b\u56e2\u961f\u8fdb\u5ea6\u7684\u89c6\u89c9\u6307\u793a\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4efb\u52a1\u680f\u4e3a75%\uff0c\u5219\u610f\u5473\u7740\u8239\u5458\u63a5\u8fd1\u80dc\u5229\u3002\u4f46\u662f\uff0c\u9a97\u5b50\u53ef\u4ee5\u7834\u574f\u4efb\u52a1\uff0c\u963b\u6b62\u8fdb\u5ea6\uff0c\u5e76\u7ed9\u4ed6\u4eec\u66f4\u591a\u65f6\u95f4\u6765\u6e05\u9664\u8239\u5458\u3002\u4e86\u89e3\u6b64\u673a\u5236\u6709\u52a9\u4e8e\u8239\u5458\u4f18\u5148\u8003\u8651\u4efb\u52a1\uff0c\u5e76\u4f7f\u9a97\u5b50\u5236\u5b9a\u7834\u574f\u7b56\u7565\u3002"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u8fd0\u884cImpostor.io\u6240\u9700\u7684\u7cfb\u7edf\u8981\u6c42\u662f\u4ec0\u4e48\uff1f", "answer": "Impostor.io\u7684\u7cfb\u7edf\u8981\u6c42\u56e0\u5e73\u53f0\u800c\u5f02\u3002\u5728PC\u4e0a\uff0c\u5b83\u81f3\u5c11\u9700\u8981\u53cc\u6838\u5904\u7406\u5668\uff0c4GB\u5185\u5b58\u548c\u652f\u6301 DirectX 11 \u7684\u663e\u5361\u3002\u5bf9\u4e8e\u79fb\u52a8\u8bbe\u5907\uff0c\u5b83\u9700\u8981iOS 10\u6216Android 7.0\uff0c\u4ee5\u53ca2GB\u5185\u5b58\u3002\u5728PlayStation\u548cXbox\u7b49\u6e38\u620f\u673a\u4e0a\uff0c\u5b83\u9700\u8981\u7a33\u5b9a\u7684\u4e92\u8054\u7f51\u8fde\u63a5\u548c\u6700\u65b0\u7684\u7cfb\u7edf\u66f4\u65b0\u3002\u4f8b\u5982\uff0c\u4e0e\u57fa\u672c\u914d\u7f6e\u76f8\u6bd4\uff0c\u5728\u914d\u59078GB\u5185\u5b58\u548c\u4e13\u7528\u663e\u5361\u7684PC\u4e0a\u73a9\u6e38\u620f\u4f1a\u786e\u4fdd\u66f4\u6d41\u7545\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u6ee1\u8db3\u8fd9\u4e9b\u8981\u6c42\u5c06\u786e\u4fdd\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u83b7\u5f97\u6d41\u7545\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728Impostor.io\u4e2d\u53d1\u73b0\u9690\u85cf\u7684\u5f69\u86cb\uff1f", "answer": "\u5728Impostor.io\u4e2d\u53d1\u73b0\u9690\u85cf\u7684\u5f69\u86cb\u9700\u8981\u63a2\u7d22\u6e38\u620f\u73af\u5883\uff0c\u5e76\u6ce8\u610f\u7ec6\u5fae\u4e4b\u5904\u3002\u4f8b\u5982\uff0c\u67d0\u4e9b\u623f\u95f4\u53ef\u80fd\u5305\u542b\u9690\u85cf\u7684\u4fe1\u606f\u6216\u5bf9\u6d41\u884c\u6587\u5316\u7684\u53c2\u8003\uff0c\u5728\u7279\u5b9a\u60c5\u51b5\u4e0b\u4e0e\u4e4b\u4e92\u52a8\u65f6\u5c06\u663e\u793a\u51fa\u6765\u3002\u73a9\u5bb6\u8fd8\u5e94\u8be5\u503e\u542c\u4e0d\u5bfb\u5e38\u7684\u58f0\u97f3\u6216\u5bfb\u627e\u53ef\u80fd\u6697\u793a\u5f69\u86cb\u7684\u975e\u540c\u5bfb\u5e38\u7684\u7269\u54c1\u3002\u4e0e\u5176\u4ed6\u73a9\u5bb6\u534f\u4f5c\u5206\u4eab\u53d1\u73b0\u4e5f\u53ef\u4ee5\u53d1\u73b0\u8fd9\u4e9b\u9690\u85cf\u7684\u5f69\u86cb\u3002\u8fd9\u4e9b\u5f69\u86cb\u4e3a\u6e38\u620f\u589e\u6dfb\u4e86\u989d\u5916\u7684\u4e50\u8da3\u548c\u8da3\u5473\u3002"}, {"question": "\u5728Impostor.io\u4e2d\u5c06\u8bbe\u5907\u6570\u636e\u8f6c\u79fb\u5230\u53e6\u4e00\u53f0\u8bbe\u5907\u4e0a\u6709\u54ea\u4e9b\u6b65\u9aa4\uff1f", "answer": "\u5728Impostor.io\u4e2d\u5c06\u8bbe\u5907\u6570\u636e\u8f6c\u79fb\u5230\u53e6\u4e00\u53f0\u8bbe\u5907\u9700\u8981\u51e0\u4e2a\u7b80\u5355\u7684\u6b65\u9aa4\u3002\u6b65\u9aa41\uff1a\u786e\u4fdd\u60a8\u5df2\u5728\u4e24\u53f0\u8bbe\u5907\u4e0a\u767b\u5f55\u76f8\u540c\u7684\u5e10\u6237\u3002\u6b65\u9aa42\uff1a\u5728\u539f\u59cb\u8bbe\u5907\u4e0a\uff0c\u8fdb\u5165\u8bbe\u7f6e\u83dc\u5355\uff0c\u9009\u62e9\u201c\u540c\u6b65\u6570\u636e\u201d\u5c06\u60a8\u7684\u8fdb\u5ea6\u4e0a\u4f20\u5230\u4e91\u7aef\u3002\u6b65\u9aa43\uff1a\u5728\u65b0\u8bbe\u5907\u4e0a\uff0c\u767b\u5f55\u5e76\u9009\u62e9\u201c\u540c\u6b65\u6570\u636e\u201d\u4e0b\u8f7d\u60a8\u7684\u5b58\u6863\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u4ecePC\u5207\u6362\u5230\u79fb\u52a8\u8bbe\u5907\uff0c\u540c\u6b65\u5c06\u786e\u4fdd\u60a8\u7684\u6e38\u620f\u8fdb\u5ea6\u3001\u6210\u5c31\u548c\u8bbe\u7f6e\u5f97\u5230\u4fdd\u7559\u3002\u6b64\u8fc7\u7a0b\u5141\u8bb8\u60a8\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u65e0\u7f1d\u7ee7\u7eed\u6e38\u620f\u3002"}]
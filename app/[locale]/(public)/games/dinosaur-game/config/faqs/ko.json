[{"question": "\uacf5\ub8e1 \uac8c\uc784\uc744 \uc2dc\uc791\ud558\uace0 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uacf5\ub8e1 \uac8c\uc784\uc744 \uc2dc\uc791\ud558\ub824\uba74 \uac8c\uc784\uc774 \ud3ec\ucee4\uc2a4 \uc0c1\ud0dc\uc77c \ub54c \uc2a4\ud398\uc774\uc2a4\ubc14 \ub610\ub294 \uc704 \ud654\uc0b4\ud45c \ud0a4\ub97c \ub204\ub974\uba74 \ub429\ub2c8\ub2e4. \uae30\ubcf8 \ucee8\ud2b8\ub864\uc740 \uacf5\ub8e1\uc774 \uc810\ud504\ud560 \ub54c \uc2a4\ud398\uc774\uc2a4\ubc14 \ub610\ub294 \uc704 \ud654\uc0b4\ud45c \ud0a4\ub97c \ub204\ub974\uace0, \uc544\ub798 \ud654\uc0b4\ud45c \ud0a4\ub97c \ub20c\ub7ec \uc6c5\ud06c\ub9ac\uac8c \ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uce7c\ube75\uc774 \ub098\ud0c0\ub098\uba74 \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \ub20c\ub7ec \uc810\ud504\ud558\uc5ec \uac74\ub108\ub6f0\uc2ed\uc2dc\uc624. \uc774 \uac04\ub2e8\ud55c \uba54\ucee4\ub2c8\uc998\uc774 \uac8c\uc784\uc758 \uae30\ucd08\uc785\ub2c8\ub2e4."}, {"question": "\uc65c \uacf5\ub8e1 \uac8c\uc784 \uc18d\ub3c4\uac00 \ube68\ub77c\uc9c0\ub294\uac00, \uadf8\ub9ac\uace0 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294\uac00?", "answer": "\uacf5\ub8e1 \uac8c\uc784\uc758 \uc18d\ub3c4\ub294 \uc2dc\uac04\uc774 \uc9c0\ub0a8\uc5d0 \ub530\ub77c \uac8c\uc784\uc758 \ub09c\uc774\ub3c4\ub97c \ub192\uc774\uae30 \uc704\ud574 \uc99d\uac00\ud569\ub2c8\ub2e4. \uc774\ub294 \ub354 \ube60\ub978 \ubc18\uc0ac \uc18d\ub3c4\uc640 \ub354\uc6b1 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uc774 \ud544\uc694\ud558\ub3c4\ub85d \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac8c\uc784\uc774 \uc9c4\ud589\ub428\uc5d0 \ub530\ub77c \uc7a5\uc560\ubb3c \uc0ac\uc774\uc758 \uc2dc\uac04 \uac04\uaca9\uc774 \uc904\uc5b4\ub4e4\uc5b4 \ubc18\uc751\ud558\uae30\uac00 \uc5b4\ub824\uc6cc\uc9d1\ub2c8\ub2e4. \uc774 \uba54\ucee4\ub2c8\uc998\uc740 \uac8c\uc784\uc744 \ud765\ubbf8\ub86d\uac8c \uc720\uc9c0\ud558\uace0 \ud50c\ub808\uc774\uc5b4\uc758 \uc778\ub0b4\uc2ec\uacfc \uae30\uc220\uc744 \uc2dc\ud5d8\ud569\ub2c8\ub2e4."}, {"question": "\uacf5\ub8e1 \uac8c\uc784\uc758 \uc7a5\uc560\ubb3c \uc885\ub958\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud53c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uacf5\ub8e1 \uac8c\uc784\uc5d0\ub294 \uc8fc\uc694 \uc7a5\uc560\ubb3c \ub450 \uac00\uc9c0\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uce7c\ube75\uacfc \uc775\ub8e1\uc785\ub2c8\ub2e4. \uce7c\ube75\uc744 \ud53c\ud558\ub824\uba74 \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \ub20c\ub7ec \uc810\ud504\ud558\uc5ec \uac74\ub108\ub6f0\uc138\uc694. \uc775\ub8e1\uc758 \uacbd\uc6b0, \uc544\ub798 \ud654\uc0b4\ud45c \ud0a4\ub97c \ub20c\ub7ec \uc810\ud504\ud558\uac70\ub098 \uc6c5\ud06c\ub824\uc11c \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc775\ub8e1\uc774 \ub0ae\uac8c \ub0a0 \ub54c \uc6c5\ud06c\ub9ac\ub294 \uac83\uc774 \ub354 \uc548\uc804\ud55c \uc120\ud0dd\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc7a5\uc560\ubb3c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \uac8c\uc784\uc5d0\uc11c \uc0dd\uc874\ud558\ub294 \ub370 \uc911\uc694\ud569\ub2c8\ub2e4."}, {"question": "\uacf5\ub8e1 \uac8c\uc784\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694? \uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \ub2e8\uacc4\ubcc4 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "STEP1: \ubaa8\ub4e0 \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uc810\ud504\uc640 \uc6c5\ud06c\ub9ac\ub294 \ud0c0\uc774\ubc0d\uc744 \uc644\ubcbd\ud558\uac8c \ub9c8\uc2a4\ud130\ud569\ub2c8\ub2e4. STEP2: \uc18d\ub3c4 \uc99d\uac00\ub97c \uc608\uce21\ud558\uace0 \uc790\uc2e0\uc758 \ubc18\uc751\uc744 \uadf8\uc5d0 \ub9de\uac8c \uc870\uc815\ud569\ub2c8\ub2e4. STEP3: \uc9d1\uc911\ub825\uc744 \uc720\uc9c0\ud558\uace0 \uc0b0\ub9cc\ud568\uc744 \ud53c\ud558\uc5ec \uc77c\uad00\uc131\uc744 \uc720\uc9c0\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uadfc\uc721 \uae30\uc5b5\ub825\uc744 \uc313\uae30 \uc704\ud574 \uafb8\uc900\ud788 \uc5f0\uc2b5\ud558\uc138\uc694. \uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \uc885\uc885 \uc774\ub7ec\ud55c \uc804\ub7b5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uace0, \ub54c\ub85c\ub294 \uc218\ucc9c \uc810\uc5d0 \ub3c4\ub2ec\ud569\ub2c8\ub2e4."}, {"question": "\uacf5\ub8e1 \uac8c\uc784\uc5d0\uc11c \uae34 \uc2dc\uac04 \ub3d9\uc548 \ub2ec\ub9ac\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ub294 \uae30\uc220\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uacf5\ub8e1 \uac8c\uc784\uc5d0\uc11c \uae34 \uc2dc\uac04 \ub3d9\uc548 \ub2ec\ub9ac\ub3c4\ub85d \ub3c4\uc640\uc8fc\ub294 \uae30\uc220\uc5d0\ub294 \uc77c\uad00\ub41c \ud0c0\uc774\ubc0d \uc5f0\uc2b5, \uc555\ubc15 \uc18d\uc5d0\uc11c \ucc28\ubd84\ud568 \uc720\uc9c0, \uc7a5\uc560\ubb3c\uc744 \ubbf8\ub9ac \uc608\uce21\ud558\uae30 \uc704\ud55c \uc8fc\ubcc0 \uc2dc\uc57c \ud65c\uc6a9\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uacbd\ud5d8 \ub9ce\uc740 \ud50c\ub808\uc774\uc5b4\ub294 \uc885\uc885 \uc55e\ucabd \ud654\uba74\uc744 \uc57d\uac04 \ub354 \ubc14\ub77c\ubcf4\uba70 \ub2e4\uac00\uc624\ub294 \ub3c4\uc804\uc5d0 \ub300\ube44\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uae30\uc220\uc740 \uc9d1\uc911\ub825\uc744 \uc720\uc9c0\ud558\uace0 \ub2ec\ub9ac\ub294 \uc2dc\uac04\uc744 \ub298\ub9ac\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\uacf5\ub8e1 \uac8c\uc784\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \uacc4\uc0b0\ub418\ub098\uc694?", "answer": "\uacf5\ub8e1 \uac8c\uc784\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uacf5\ub8e1\uc774 \uc774\ub3d9\ud55c \uac70\ub9ac\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uac01 \uc810\uc218\ub294 \ud2b9\uc815 \uac70\ub9ac \uc774\ub3d9\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4. \uac8c\uc784\uc740 \uc2dc\uac04\uc774 \uc9c0\ub0a8\uc5d0 \ub530\ub77c \uc18d\ub3c4\ub97c \ub192\uc774\ub294\ub370, \uc774\ub294 \uac04\uc811\uc801\uc73c\ub85c \uc810\uc218 \ud68d\ub4dd \uc18d\ub3c4\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac8c\uc784\uc774 \ube68\ub77c\uc9d0\uc5d0 \ub530\ub77c \uc810\uc218\uac00 \ub354 \ube68\ub9ac \uc313\uc5ec \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uae30\uac00 \ub354 \uc5b4\ub824\uc6cc\uc9d1\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\uba74 \ud50c\ub808\uc774\uc5b4\uac00 \ub354 \ub098\uc740 \uc804\ub7b5\uc744 \uc138\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uacf5\ub8e1 \uac8c\uc784\uc758 \uac8c\uc784 \ub09c\uc774\ub3c4\ub294 \uc5b4\ub5bb\uac8c \uc870\uc808\ub418\uba70, \uc5b4\ub5a4 \uae30\uc900\uc810\uc774 \uc788\ub098\uc694?", "answer": "\uacf5\ub8e1 \uac8c\uc784\uc758 \uac8c\uc784 \ub09c\uc774\ub3c4\ub294 \uc815\uae30\uc801\uc778 \uac04\uaca9\uc73c\ub85c \uc18d\ub3c4\ub97c \ub192\uc5ec\uc11c \uc870\uc808\ub429\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc73c\ub85c \uc18d\ub3c4\ub294 100\uc810\ub9c8\ub2e4 \uc99d\uac00\ud558\uc5ec \uc810\uc810 \ub354 \uc5b4\ub824\uc6cc\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 100\uc810\uc5d0 \ub3c4\ub2ec\ud55c \ud6c4 \uc18d\ub3c4\uac00 \uc57d\uac04 \ube68\ub77c\uc9c0\uace0, \uc774 \ud328\ud134\uc740 \uac8c\uc784\uc774 \uc9c4\ud589\ub420\uc218\ub85d \uacc4\uc18d\ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uae30\uc900\uc810\uc740 \ud50c\ub808\uc774\uc5b4\uc758 \uc801\uc751\ub825\uacfc \uae30\uc220\uc744 \uc2dc\ud5d8\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4."}, {"question": "\uacf5\ub8e1 \uac8c\uc784\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\ub978 \uae30\uae30\uc5d0 \uc800\uc7a5\ud558\uac70\ub098 \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uacf5\ub8e1 \uac8c\uc784\uc740 \ub2e4\ub978 \uae30\uae30\uc5d0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc800\uc7a5\ud558\uac70\ub098 \uc774\uc804\ud558\ub294 \uae30\ub2a5\uc744 \uae30\ubcf8\uc801\uc73c\ub85c \uc9c0\uc6d0\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uac8c\uc784\uc740 \ub2e8\uc21c\ud558\uace0 \uc138\uc158 \uae30\ubc18\uc758 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub2e4\ub978 \ucef4\ud4e8\ud130\uc5d0\uc11c \ud50c\ub808\uc774\ud558\uba74 \ucc98\uc74c\ubd80\ud130 \uc2dc\uc791\ud574\uc57c \ud569\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \uc77c\ubd80 \ube0c\ub77c\uc6b0\uc800 \ud655\uc7a5 \ud504\ub85c\uadf8\ub7a8\uc774\ub098 \ud0c0\uc0ac \ub3c4\uad6c\ub294 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc800\uc7a5\ud558\ub294 \uae30\ub2a5\uc744 \uc81c\ud55c\uc801\uc73c\ub85c \uc81c\uacf5\ud560 \uc218 \uc788\uc9c0\ub9cc \uc774\ub294 \uacf5\uc2dd\uc801\uc73c\ub85c \uc9c0\uc6d0\ub418\ub294 \uae30\ub2a5\uc774 \uc544\ub2d9\ub2c8\ub2e4."}, {"question": "\uacf5\ub8e1 \uac8c\uc784\uc758 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uacf5\ub8e1 \uac8c\uc784\uc758 \uc228\uaca8\uc9c4 \uae30\ub2a5 \uc911 \ud558\ub098\ub294 \"\uc57c\uac04 \ubaa8\ub4dc\"\uc774\uba70, \uac8c\uc784\uc5d0 \ud3ec\ucee4\uc2a4\uac00 \ub9de\ucdb0\uc838 \uc788\uc744 \ub54c \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \ub204\ub974\uba74 \ud65c\uc131\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub294 \ubc30\uacbd\uc744 \uc5b4\ub450\uc6b4 \ud14c\ub9c8\ub85c \ubcc0\uacbd\ud558\uc5ec \ubc24 \ud658\uacbd\uc744 \uc2dc\ubbac\ub808\uc774\uc158\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc57c\uac04 \ubaa8\ub4dc\ub97c \ud65c\uc131\ud654\ud558\uba74 \uac8c\uc784\uc758 \uc2dc\uac01 \ud6a8\uacfc\uac00 \ubc14\ub00c\uc5b4 \ub2e4\ub978 \ubbf8\uc801 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uac8c\uc784\uc5d0 \ucd94\uac00\uc801\uc778 \uc7ac\ubbf8\ub97c \ub354\ud569\ub2c8\ub2e4."}, {"question": "\ub2e4\ub978 \ube0c\ub77c\uc6b0\uc800\uc5d0\uc11c \uacf5\ub8e1 \uac8c\uc784\uc758 \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub2e4\ub978 \ube0c\ub77c\uc6b0\uc800\uc5d0\uc11c \uacf5\ub8e1 \uac8c\uc784\uc758 \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \ube0c\ub77c\uc6b0\uc800\ub97c \ucd5c\uc2e0 \ubc84\uc804\uc73c\ub85c \uc5c5\ub370\uc774\ud2b8\ud574\uc57c \ud569\ub2c8\ub2e4. \ub610\ud55c, \ubd88\ud544\uc694\ud55c \ud0ed\uacfc \ud655\uc7a5 \ud504\ub85c\uadf8\ub7a8\uc744 \ub2eb\uc544 \uc2dc\uc2a4\ud15c \ub9ac\uc18c\uc2a4\ub97c \ud655\ubcf4\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub2e4\ub978 \ud0ed\uc774 \uc5c6\uc774 \ud06c\ub86c\uc5d0\uc11c \ud50c\ub808\uc774\ud558\uba74 \uac8c\uc784 \ud50c\ub808\uc774\uac00 \ub354 \uc6d0\ud65c\ud574\uc9d1\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ucd5c\uc801\ud654\ub294 \ub799\uc744 \uc904\uc774\uace0 \uc804\ubc18\uc801\uc778 \uac8c\uc784 \ud658\uacbd\uc744 \uac1c\uc120\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}]
[{"question": "\u5982\u4f55\u958b\u59cb\u73a9\u6050\u9f8d\u904a\u6232\u4ee5\u53ca\u57fa\u672c\u63a7\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "\u8981\u958b\u59cb\u73a9\u6050\u9f8d\u904a\u6232\uff0c\u53ea\u8981\u904a\u6232\u5728\u7126\u9ede\u6642\u6309\u4e0b\u7a7a\u683c\u9375\u6216\u5411\u4e0a\u7bad\u982d\u9375\u5373\u53ef\u3002\u57fa\u672c\u63a7\u5236\u5305\u62ec\u6309\u4e0b\u7a7a\u683c\u9375\u6216\u5411\u4e0a\u7bad\u982d\u9375\u8b93\u6050\u9f8d\u8df3\u8e8d\uff0c\u4ee5\u53ca\u5411\u4e0b\u7bad\u982d\u9375\u8b93\u6050\u9f8d\u8e72\u4e0b\u3002\u4f8b\u5982\uff0c\u7576\u4ed9\u4eba\u638c\u51fa\u73fe\u6642\uff0c\u6309\u4e0b\u7a7a\u683c\u9375\u8df3\u904e\u5b83\u3002\u9019\u500b\u7c21\u55ae\u7684\u6a5f\u5236\u662f\u904a\u6232\u7684\u57fa\u790e\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u6050\u9f8d\u904a\u6232\u7684\u901f\u5ea6\u6703\u589e\u52a0\uff0c\u4ee5\u53ca\u9019\u5982\u4f55\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff1f", "answer": "\u6050\u9f8d\u904a\u6232\u7684\u901f\u5ea6\u6703\u96a8\u8457\u6642\u9593\u63a8\u79fb\u800c\u589e\u52a0\uff0c\u4ee5\u4f7f\u904a\u6232\u66f4\u5177\u6311\u6230\u6027\u3002\u9019\u6703\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff0c\u9700\u8981\u66f4\u5feb\u7684\u53cd\u61c9\u901f\u5ea6\u548c\u66f4\u7cbe\u78ba\u7684\u6642\u6a5f\u3002\u4f8b\u5982\uff0c\u96a8\u8457\u904a\u6232\u7684\u9032\u884c\uff0c\u969c\u7919\u7269\u9593\u7684\u6642\u9593\u9593\u9694\u6703\u7e2e\u77ed\uff0c\u4f7f\u53cd\u61c9\u8b8a\u5f97\u66f4\u52a0\u56f0\u96e3\u3002\u9019\u500b\u6a5f\u5236\u8b93\u904a\u6232\u4fdd\u6301\u5f15\u4eba\u5165\u52dd\uff0c\u4e26\u6e2c\u8a66\u73a9\u5bb6\u7684\u8010\u529b\u548c\u6280\u5de7\u3002"}, {"question": "\u6050\u9f8d\u904a\u6232\u4e2d\u6709\u54ea\u4e9b\u4e0d\u540c\u7684\u969c\u7919\u7269\uff0c\u4ee5\u53ca\u5982\u4f55\u907f\u514d\u5b83\u5011\uff1f", "answer": "\u6050\u9f8d\u904a\u6232\u6709\u5169\u7a2e\u4e3b\u8981\u7684\u969c\u7919\u7269\uff1a\u4ed9\u4eba\u638c\u548c\u7ffc\u9f8d\u3002\u8981\u907f\u958b\u4ed9\u4eba\u638c\uff0c\u8acb\u6309\u4e0b\u7a7a\u683c\u9375\u8df3\u904e\u5b83\u5011\u3002\u5c0d\u65bc\u7ffc\u9f8d\uff0c\u60a8\u53ef\u4ee5\u9078\u64c7\u8df3\u904e\u5b83\u5011\u6216\u6309\u4e0b\u5411\u4e0b\u7bad\u982d\u9375\u8eb2\u5728\u5176\u4e0b\u65b9\u3002\u4f8b\u5982\uff0c\u5982\u679c\u7ffc\u9f8d\u98db\u884c\u4f4e\u7a7a\uff0c\u8e72\u4e0b\u662f\u4e00\u500b\u66f4\u5b89\u5168\u7684\u9078\u64c7\u3002\u4e86\u89e3\u9019\u4e9b\u969c\u7919\u7269\u5c0d\u65bc\u5728\u904a\u6232\u4e2d\u751f\u5b58\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u5982\u4f55\u5728\u6050\u9f8d\u904a\u6232\u4e2d\u7372\u5f97\u9ad8\u5206\uff1f\u7d66\u9032\u968e\u73a9\u5bb6\u7684\u9010\u6b65\u7b56\u7565\u3002", "answer": "\u6b65\u9a5f1\uff1a\u638c\u63e1\u8df3\u8e8d\u548c\u8e72\u4e0b\u7684\u6642\u6a5f\u4ee5\u907f\u958b\u6240\u6709\u969c\u7919\u7269\u3002\u6b65\u9a5f2\uff1a\u9810\u6e2c\u901f\u5ea6\u589e\u52a0\u4e26\u76f8\u61c9\u5730\u8abf\u6574\u60a8\u7684\u53cd\u61c9\u3002\u6b65\u9a5f3\uff1a\u4fdd\u6301\u5c08\u6ce8\u4e26\u907f\u514d\u5206\u5fc3\u4ee5\u4fdd\u6301\u4e00\u81f4\u6027\u3002\u4f8b\u5982\uff0c\u5b9a\u671f\u7df4\u7fd2\u4ee5\u5efa\u7acb\u808c\u8089\u8a18\u61b6\u3002\u9ad8\u7d1a\u73a9\u5bb6\u901a\u5e38\u6703\u4f7f\u7528\u9019\u4e9b\u7b56\u7565\u4f86\u7372\u5f97\u9ad8\u5206\uff0c\u6709\u6642\u751a\u81f3\u9054\u5230\u6578\u5343\u5206\u3002"}, {"question": "\u54ea\u4e9b\u6280\u5de7\u6709\u52a9\u65bc\u5728\u6050\u9f8d\u904a\u6232\u4e2d\u4fdd\u6301\u9577\u6642\u9593\u7684\u5954\u8dd1\uff1f", "answer": "\u5728\u6050\u9f8d\u904a\u6232\u4e2d\u4fdd\u6301\u9577\u6642\u9593\u5954\u8dd1\u7684\u6280\u5de7\u5305\u62ec\u7df4\u7fd2\u4e00\u81f4\u7684\u6642\u6a5f\u3001\u5728\u58d3\u529b\u4e0b\u4fdd\u6301\u51b7\u975c\u4ee5\u53ca\u4f7f\u7528\u5468\u908a\u8996\u7dda\u9810\u6e2c\u969c\u7919\u7269\u3002\u4f8b\u5982\uff0c\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u901a\u5e38\u6703\u5728\u87a2\u5e55\u4e0a\u7a0d\u5fae\u5411\u524d\u770b\uff0c\u70ba\u5373\u5c07\u51fa\u73fe\u7684\u6311\u6230\u505a\u597d\u6e96\u5099\u3002\u9019\u4e9b\u6280\u5de7\u6709\u52a9\u65bc\u4fdd\u6301\u5c08\u6ce8\u4e26\u5ef6\u9577\u8dd1\u6b65\u6642\u9593\u3002"}, {"question": "\u6050\u9f8d\u904a\u6232\u7684\u5f97\u5206\u7cfb\u7d71\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5b83\u662f\u5982\u4f55\u8a08\u7b97\u7684\uff1f", "answer": "\u6050\u9f8d\u904a\u6232\u7684\u5f97\u5206\u7cfb\u7d71\u57fa\u65bc\u6050\u9f8d\u884c\u9032\u7684\u8ddd\u96e2\u3002\u6bcf\u4e00\u5206\u4ee3\u8868\u4e00\u5b9a\u8ddd\u96e2\u7684\u79fb\u52d5\u3002\u904a\u6232\u4e5f\u6703\u96a8\u8457\u6642\u9593\u589e\u52a0\u901f\u5ea6\uff0c\u9019\u9593\u63a5\u5f71\u97ff\u5f97\u5206\u7387\u3002\u4f8b\u5982\uff0c\u96a8\u8457\u904a\u6232\u901f\u5ea6\u52a0\u5feb\uff0c\u5206\u6578\u7a4d\u7d2f\u5f97\u66f4\u5feb\uff0c\u9019\u4f7f\u5f97\u7372\u5f97\u9ad8\u5206\u66f4\u5177\u6311\u6230\u6027\u3002\u4e86\u89e3\u9019\u500b\u7cfb\u7d71\u53ef\u4ee5\u5e6b\u52a9\u73a9\u5bb6\u66f4\u597d\u5730\u5236\u5b9a\u7b56\u7565\u3002"}, {"question": "\u6050\u9f8d\u904a\u6232\u7684\u904a\u6232\u96e3\u5ea6\u662f\u5982\u4f55\u63d0\u5347\u7684\uff0c\u4ee5\u53ca\u9580\u6abb\u662f\u4ec0\u9ebc\uff1f", "answer": "\u6050\u9f8d\u904a\u6232\u7684\u904a\u6232\u96e3\u5ea6\u662f\u901a\u904e\u5b9a\u671f\u589e\u52a0\u901f\u5ea6\u4f86\u63d0\u5347\u7684\u3002\u901a\u5e38\uff0c\u901f\u5ea6\u6bcf 100 \u5206\u6703\u589e\u52a0\u4e00\u6b21\uff0c\u4f7f\u904a\u6232\u9010\u6f38\u8b8a\u5f97\u66f4\u96e3\u3002\u4f8b\u5982\uff0c\u9054\u5230 100 \u5206\u5f8c\uff0c\u901f\u5ea6\u6703\u7a0d\u5fae\u63d0\u9ad8\uff0c\u9019\u500b\u6a21\u5f0f\u6703\u96a8\u8457\u904a\u6232\u7684\u9032\u5c55\u800c\u6301\u7e8c\u3002\u9019\u4e9b\u9580\u6abb\u65e8\u5728\u6e2c\u8a66\u73a9\u5bb6\u7684\u9069\u61c9\u6027\u548c\u6280\u80fd\u3002"}, {"question": "\u6050\u9f8d\u904a\u6232\u7684\u9032\u5ea6\u53ef\u4ee5\u5132\u5b58\u6216\u5728\u4e0d\u540c\u88dd\u7f6e\u4e4b\u9593\u8f49\u79fb\u55ce\uff1f", "answer": "\u6050\u9f8d\u904a\u6232\u672c\u8eab\u4e0d\u652f\u6301\u5728\u4e0d\u540c\u88dd\u7f6e\u4e4b\u9593\u5132\u5b58\u6216\u8f49\u79fb\u9032\u5ea6\u3002\u8a72\u904a\u6232\u8a2d\u8a08\u6210\u7c21\u55ae\u7684\u57fa\u65bc\u55ae\u6b21\u904a\u6232\u9ad4\u9a57\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u4e0d\u540c\u7684\u96fb\u8166\u4e0a\u73a9\uff0c\u60a8\u5c07\u5f9e\u982d\u958b\u59cb\u3002\u7136\u800c\uff0c\u4e00\u4e9b\u700f\u89bd\u5668\u64f4\u5145\u529f\u80fd\u6216\u7b2c\u4e09\u65b9\u5de5\u5177\u53ef\u80fd\u63d0\u4f9b\u6709\u9650\u7684\u5132\u5b58\u9032\u5ea6\u529f\u80fd\uff0c\u4f46\u9019\u4e26\u975e\u5b98\u65b9\u652f\u63f4\u3002"}, {"question": "\u6050\u9f8d\u904a\u6232\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u7684\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "\u6050\u9f8d\u904a\u6232\u4e2d\u7684\u4e00\u500b\u96b1\u85cf\u529f\u80fd\u662f\u300c\u591c\u9593\u6a21\u5f0f\u300d\uff0c\u53ef\u900f\u904e\u904a\u6232\u5728\u7126\u9ede\u6642\u6309\u4e0b\u7a7a\u683c\u9375\u958b\u555f\u3002\u9019\u6703\u5c07\u80cc\u666f\u66f4\u6539\u70ba\u6df1\u8272\u4e3b\u984c\uff0c\u6a21\u64ec\u591c\u665a\u74b0\u5883\u3002\u4f8b\u5982\uff0c\u555f\u7528\u591c\u9593\u6a21\u5f0f\u5f8c\uff0c\u904a\u6232\u7684\u8996\u89ba\u6548\u679c\u6703\u8f49\u8b8a\uff0c\u63d0\u4f9b\u4e0d\u540c\u7684\u7f8e\u5b78\u9ad4\u9a57\u3002\u9019\u4e9b\u5f69\u86cb\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u984d\u5916\u7684\u8da3\u5473\u6027\u3002"}, {"question": "\u5982\u4f55\u5728\u4e0d\u540c\u700f\u89bd\u5668\u4e0a\u512a\u5316\u6050\u9f8d\u904a\u6232\u7684\u6548\u80fd\uff1f", "answer": "\u8981\u5728\u4e0d\u540c\u700f\u89bd\u5668\u4e0a\u512a\u5316\u6050\u9f8d\u904a\u6232\u7684\u6548\u80fd\uff0c\u8acb\u78ba\u4fdd\u60a8\u7684\u700f\u89bd\u5668\u5df2\u66f4\u65b0\u81f3\u6700\u65b0\u7248\u672c\u3002\u6b64\u5916\uff0c\u95dc\u9589\u4e0d\u5fc5\u8981\u7684\u6a19\u7c64\u9801\u548c\u64f4\u5145\u529f\u80fd\u4ee5\u91cb\u653e\u7cfb\u7d71\u8cc7\u6e90\u3002\u4f8b\u5982\uff0c\u5728\u6c92\u6709\u5176\u4ed6\u6a19\u7c64\u9801\u7684 Chrome \u4e0a\u73a9\u904a\u6232\u6703\u5c0e\u81f4\u904a\u6232\u66f4\u6d41\u66a2\u3002\u9019\u4e9b\u512a\u5316\u6709\u52a9\u65bc\u6e1b\u5c11\u5ef6\u9072\u4e26\u6539\u5584\u6574\u9ad4\u904a\u6232\u9ad4\u9a57\u3002"}]
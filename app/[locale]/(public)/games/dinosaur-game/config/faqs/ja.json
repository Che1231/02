[{"question": "\u6050\u7adc\u30b2\u30fc\u30e0\u3092\u59cb\u3081\u308b\u65b9\u6cd5\u3068\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u306f\uff1f", "answer": "\u6050\u7adc\u30b2\u30fc\u30e0\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u30b2\u30fc\u30e0\u306b\u30d5\u30a9\u30fc\u30ab\u30b9\u3057\u3066\u3044\u308b\u3068\u304d\u306b\u30b9\u30da\u30fc\u30b9\u30d0\u30fc\u307e\u305f\u306f\u4e0a\u77e2\u5370\u30ad\u30fc\u3092\u62bc\u3059\u3060\u3051\u3067\u3059\u3002\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u306b\u306f\u3001\u6050\u7adc\u3092\u30b8\u30e3\u30f3\u30d7\u3055\u305b\u308b\u305f\u3081\u306b\u30b9\u30da\u30fc\u30b9\u30d0\u30fc\u307e\u305f\u306f\u4e0a\u77e2\u5370\u30ad\u30fc\u3092\u62bc\u3059\u3053\u3068\u3001\u304a\u3088\u3073\u4e0b\u77e2\u5370\u30ad\u30fc\u3092\u62bc\u3057\u3066\u3057\u3083\u304c\u307e\u305b\u308b\u64cd\u4f5c\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b5\u30dc\u30c6\u30f3\u304c\u51fa\u73fe\u3057\u305f\u3089\u3001\u30b9\u30da\u30fc\u30b9\u30d0\u30fc\u3092\u62bc\u3057\u3066\u30b8\u30e3\u30f3\u30d7\u3057\u3066\u4e57\u308a\u8d8a\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u306e\u30b7\u30f3\u30d7\u30eb\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u304c\u3001\u30b2\u30fc\u30e0\u306e\u57fa\u790e\u3068\u306a\u3063\u3066\u3044\u307e\u3059\u3002"}, {"question": "\u6050\u7adc\u30b2\u30fc\u30e0\u306e\u901f\u5ea6\u304c\u4e0a\u304c\u308b\u7406\u7531\u3068\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u3046\u5f71\u97ff\u3059\u308b\u306e\u304b\uff1f", "answer": "\u6050\u7adc\u30b2\u30fc\u30e0\u306e\u901f\u5ea6\u306f\u3001\u30b2\u30fc\u30e0\u3092\u3088\u308a\u6311\u6226\u7684\u306b\u3059\u308b\u305f\u3081\u306b\u6642\u9593\u3068\u3068\u3082\u306b\u5897\u52a0\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u3088\u308a\u901f\u3044\u53cd\u5fdc\u901f\u5ea6\u3068\u3088\u308a\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5fc5\u8981\u3068\u3059\u308b\u3053\u3068\u3067\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b2\u30fc\u30e0\u304c\u9032\u3080\u306b\u3064\u308c\u3066\u3001\u969c\u5bb3\u7269\u306e\u9593\u9694\u304c\u72ed\u304f\u306a\u308a\u3001\u53cd\u5fdc\u3059\u308b\u306e\u304c\u96e3\u3057\u304f\u306a\u308a\u307e\u3059\u3002\u3053\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u3092\u9b45\u529b\u7684\u306a\u3082\u306e\u306b\u3057\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u5fcd\u8010\u529b\u3068\u30b9\u30ad\u30eb\u3092\u30c6\u30b9\u30c8\u3057\u307e\u3059\u3002"}, {"question": "\u6050\u7adc\u30b2\u30fc\u30e0\u306e\u69d8\u3005\u306a\u969c\u5bb3\u7269\u3068\u3001\u305d\u308c\u3089\u3092\u907f\u3051\u308b\u65b9\u6cd5\u306f\uff1f", "answer": "\u6050\u7adc\u30b2\u30fc\u30e0\u306b\u306f\u3001\u30b5\u30dc\u30c6\u30f3\u3068\u30d7\u30c6\u30e9\u30ce\u30c9\u30f3\u3068\u3044\u30462\u3064\u306e\u4e3b\u306a\u969c\u5bb3\u7269\u304c\u3042\u308a\u307e\u3059\u3002\u30b5\u30dc\u30c6\u30f3\u3092\u907f\u3051\u308b\u306b\u306f\u3001\u30b9\u30da\u30fc\u30b9\u30d0\u30fc\u3092\u62bc\u3057\u3066\u30b8\u30e3\u30f3\u30d7\u3057\u3066\u4e57\u308a\u8d8a\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u30d7\u30c6\u30e9\u30ce\u30c9\u30f3\u306b\u95a2\u3057\u3066\u306f\u3001\u4e0b\u77e2\u5370\u30ad\u30fc\u3092\u62bc\u3057\u3066\u30b8\u30e3\u30f3\u30d7\u3059\u308b\u304b\u3001\u4e0b\u306b\u6f5c\u3063\u3066\u907f\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30d7\u30c6\u30e9\u30ce\u30c9\u30f3\u306e\u98db\u3093\u3067\u3044\u308b\u9ad8\u3055\u306b\u3088\u3063\u3066\u306f\u3001\u3057\u3083\u304c\u3080\u65b9\u304c\u5b89\u5168\u306a\u5834\u5408\u3082\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u969c\u5bb3\u7269\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u30b2\u30fc\u30e0\u3067\u751f\u304d\u6b8b\u308b\u305f\u3081\u306b\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002"}, {"question": "\u6050\u7adc\u30b2\u30fc\u30e0\u3067\u9ad8\u5f97\u70b9\u3092\u53d6\u308b\u306b\u306f\uff1f\u4e0a\u7d1a\u8005\u5411\u3051\u30b9\u30c6\u30c3\u30d7\u30d0\u30a4\u30b9\u30c6\u30c3\u30d7\u6226\u7565\u3002", "answer": "\u30b9\u30c6\u30c3\u30d71\uff1a\u3059\u3079\u3066\u306e\u969c\u5bb3\u7269\u3092\u56de\u907f\u3059\u308b\u305f\u3081\u306b\u3001\u30b8\u30e3\u30f3\u30d7\u3068\u3057\u3083\u304c\u3080\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u30de\u30b9\u30bf\u30fc\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u901f\u5ea6\u306e\u5897\u52a0\u3092\u4e88\u6e2c\u3057\u3001\u305d\u308c\u306b\u5fdc\u3058\u3066\u53cd\u5fdc\u3092\u8abf\u6574\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u96c6\u4e2d\u529b\u3092\u7dad\u6301\u3057\u3001\u6c17\u3092\u6563\u3089\u3059\u3082\u306e\u304b\u3089\u96e2\u308c\u3066\u4e00\u8cab\u6027\u3092\u4fdd\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u7b4b\u30c8\u30ec\u3092\u5b9a\u671f\u7684\u306b\u884c\u3046\u3053\u3068\u3067\u3001\u7b4b\u8089\u306e\u8a18\u61b6\u3092\u69cb\u7bc9\u3057\u307e\u3059\u3002\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u3053\u308c\u3089\u306e\u6226\u7565\u3092\u4f7f\u7528\u3057\u3066\u3001\u6642\u306b\u306f\u6570\u5343\u70b9\u306b\u9054\u3059\u308b\u9ad8\u5f97\u70b9\u3092\u5b9f\u73fe\u3059\u308b\u3053\u3068\u304c\u3088\u304f\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u6050\u7adc\u30b2\u30fc\u30e0\u3067\u9577\u8ddd\u96e2\u3092\u8d70\u308a\u7d9a\u3051\u308b\u305f\u3081\u306b\u5f79\u7acb\u3064\u30c6\u30af\u30cb\u30c3\u30af\u306f\uff1f", "answer": "\u6050\u7adc\u30b2\u30fc\u30e0\u3067\u9577\u8ddd\u96e2\u3092\u8d70\u308a\u7d9a\u3051\u308b\u30c6\u30af\u30cb\u30c3\u30af\u306b\u306f\u3001\u4e00\u8cab\u3057\u305f\u30bf\u30a4\u30df\u30f3\u30b0\u306e\u7df4\u7fd2\u3001\u30d7\u30ec\u30c3\u30b7\u30e3\u30fc\u306e\u4e2d\u3067\u51b7\u9759\u3055\u3092\u4fdd\u3064\u3053\u3068\u3001\u5468\u8fba\u8996\u91ce\u3092\u4f7f\u3063\u3066\u969c\u5bb3\u7269\u3092\u4e88\u6e2c\u3059\u308b\u3053\u3068\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u7d4c\u9a13\u8c4a\u5bcc\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u753b\u9762\u306e\u5c11\u3057\u5148\u3092\u898b\u3066\u3001\u5dee\u3057\u8feb\u3063\u305f\u8ab2\u984c\u306b\u5099\u3048\u308b\u3053\u3068\u304c\u3088\u304f\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30c6\u30af\u30cb\u30c3\u30af\u306f\u3001\u96c6\u4e2d\u529b\u3092\u7dad\u6301\u3057\u3001\u30e9\u30f3\u30cb\u30f3\u30b0\u6642\u9593\u3092\u9577\u304f\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u6050\u7adc\u30b2\u30fc\u30e0\u306e\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u3068\u305d\u306e\u8a08\u7b97\u65b9\u6cd5\u306f\uff1f", "answer": "\u6050\u7adc\u30b2\u30fc\u30e0\u306e\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6050\u7adc\u304c\u30ab\u30d0\u30fc\u3057\u305f\u8ddd\u96e2\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u5404\u30dd\u30a4\u30f3\u30c8\u306f\u3001\u7279\u5b9a\u306e\u8ddd\u96e2\u3092\u8868\u3057\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306f\u6642\u9593\u3068\u3068\u3082\u306b\u901f\u5ea6\u3082\u4e0a\u3052\u3066\u3044\u304d\u307e\u3059\u3002\u3053\u308c\u306f\u9593\u63a5\u7684\u306b\u5f97\u70b9\u7387\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b2\u30fc\u30e0\u304c\u901f\u304f\u306a\u308b\u3068\u3001\u30dd\u30a4\u30f3\u30c8\u304c\u3088\u308a\u901f\u304f\u84c4\u7a4d\u3055\u308c\u3001\u9ad8\u5f97\u70b9\u3092\u9054\u6210\u3059\u308b\u3053\u3068\u304c\u3088\u308a\u96e3\u3057\u304f\u306a\u308a\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3088\u308a\u826f\u3044\u6226\u7565\u3092\u7acb\u3066\u3089\u308c\u307e\u3059\u3002"}, {"question": "\u6050\u7adc\u30b2\u30fc\u30e0\u306e\u96e3\u6613\u5ea6\u304c\u3069\u306e\u3088\u3046\u306b\u5897\u52a0\u3057\u3001\u305d\u306e\u3057\u304d\u3044\u5024\u306f\uff1f", "answer": "\u6050\u7adc\u30b2\u30fc\u30e0\u306e\u96e3\u6613\u5ea6\u306f\u3001\u4e00\u5b9a\u306e\u9593\u9694\u3067\u901f\u5ea6\u3092\u4e0a\u3052\u308b\u3053\u3068\u3067\u5897\u52a0\u3057\u307e\u3059\u3002\u901a\u5e38\u3001\u901f\u5ea6\u306f100\u70b9\u3054\u3068\u306b\u5897\u52a0\u3057\u3001\u30b2\u30fc\u30e0\u306f\u5f90\u3005\u306b\u96e3\u3057\u304f\u306a\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001100\u70b9\u3092\u9054\u6210\u3057\u305f\u5f8c\u3001\u901f\u5ea6\u304c\u308f\u305a\u304b\u306b\u5897\u52a0\u3057\u3001\u3053\u306e\u30d1\u30bf\u30fc\u30f3\u306f\u30b2\u30fc\u30e0\u304c\u9032\u3080\u306b\u3064\u308c\u3066\u7d9a\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u3057\u304d\u3044\u5024\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u9069\u5fdc\u529b\u3068\u30b9\u30ad\u30eb\u3092\u30c6\u30b9\u30c8\u3059\u308b\u305f\u3081\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002"}, {"question": "\u6050\u7adc\u30b2\u30fc\u30e0\u306e\u9032\u884c\u72b6\u6cc1\u306f\u3001\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u4fdd\u5b58\u307e\u305f\u306f\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u6050\u7adc\u30b2\u30fc\u30e0\u306f\u3001\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u306e\u9032\u884c\u72b6\u6cc1\u306e\u4fdd\u5b58\u3084\u8ee2\u9001\u3092\u30cd\u30a4\u30c6\u30a3\u30d6\u306b\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u307e\u305b\u3093\u3002\u30b2\u30fc\u30e0\u306f\u3001\u30b7\u30f3\u30d7\u30eb\u306a\u30bb\u30c3\u30b7\u30e7\u30f3\u30d9\u30fc\u30b9\u306e\u4f53\u9a13\u3092\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5225\u306e\u30b3\u30f3\u30d4\u30e5\u30fc\u30bf\u30fc\u3067\u30d7\u30ec\u30a4\u3059\u308b\u5834\u5408\u306f\u3001\u6700\u521d\u304b\u3089\u3084\u308a\u76f4\u3059\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002\u305f\u3060\u3057\u3001\u4e00\u90e8\u306e\u30d6\u30e9\u30a6\u30b6\u62e1\u5f35\u6a5f\u80fd\u307e\u305f\u306f\u30b5\u30fc\u30c9\u30d1\u30fc\u30c6\u30a3\u30c4\u30fc\u30eb\u304c\u3001\u9032\u884c\u72b6\u6cc1\u3092\u4fdd\u5b58\u3059\u308b\u305f\u3081\u306e\u9650\u5b9a\u7684\u306a\u6a5f\u80fd\u3092\u63d0\u4f9b\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u304c\u3001\u3053\u308c\u306f\u6b63\u5f0f\u306b\u306f\u30b5\u30dd\u30fc\u30c8\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002"}, {"question": "\u6050\u7adc\u30b2\u30fc\u30e0\u306e\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\uff1f", "answer": "\u6050\u7adc\u30b2\u30fc\u30e0\u306e\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u306e1\u3064\u306f\u3001\"\u30ca\u30a4\u30c8\u30e2\u30fc\u30c9\"\u3067\u3059\u3002\u3053\u308c\u306f\u3001\u30b2\u30fc\u30e0\u306b\u30d5\u30a9\u30fc\u30ab\u30b9\u3057\u3066\u3044\u308b\u3068\u304d\u306b\u30b9\u30da\u30fc\u30b9\u30d0\u30fc\u3092\u62bc\u3059\u3053\u3068\u3067\u30a2\u30af\u30c6\u30a3\u30d6\u306b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u80cc\u666f\u304c\u6697\u3044\u30c6\u30fc\u30de\u306b\u5909\u66f4\u3055\u308c\u3001\u591c\u9593\u306e\u74b0\u5883\u3092\u30b7\u30df\u30e5\u30ec\u30fc\u30c8\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ca\u30a4\u30c8\u30e2\u30fc\u30c9\u3092\u6709\u52b9\u306b\u3059\u308b\u3068\u3001\u30b2\u30fc\u30e0\u306e\u8996\u899a\u52b9\u679c\u304c\u5909\u308f\u3063\u3066\u3001\u7570\u306a\u308b\u7f8e\u7684\u4f53\u9a13\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3001\u30b2\u30fc\u30e0\u306b\u3055\u3089\u306a\u308b\u697d\u3057\u307f\u3092\u52a0\u3048\u307e\u3059\u3002"}, {"question": "\u7570\u306a\u308b\u30d6\u30e9\u30a6\u30b6\u3067\u6050\u7adc\u30b2\u30fc\u30e0\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\uff1f", "answer": "\u7570\u306a\u308b\u30d6\u30e9\u30a6\u30b6\u3067\u6050\u7adc\u30b2\u30fc\u30e0\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u30d6\u30e9\u30a6\u30b6\u3092\u6700\u65b0\u30d0\u30fc\u30b8\u30e7\u30f3\u306b\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3059\u308b\u3088\u3046\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3055\u3089\u306b\u3001\u4e0d\u8981\u306a\u30bf\u30d6\u3084\u62e1\u5f35\u6a5f\u80fd\u3092\u9589\u3058\u3066\u30b7\u30b9\u30c6\u30e0\u30ea\u30bd\u30fc\u30b9\u3092\u958b\u653e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001Chrome\u3067\u4ed6\u306e\u30bf\u30d6\u3092\u958b\u304b\u305a\u306b\u30d7\u30ec\u30a4\u3059\u308b\u3068\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u304c\u6ed1\u3089\u304b\u306b\u306a\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u6700\u9069\u5316\u306b\u3088\u308a\u3001\u30e9\u30b0\u3092\u8efd\u6e1b\u3057\u3001\u5168\u4f53\u7684\u306a\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}]
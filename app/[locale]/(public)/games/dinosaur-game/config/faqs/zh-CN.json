[{"question": "\u5982\u4f55\u5f00\u59cb\u73a9\u6050\u9f99\u6e38\u620f\uff0c\u4ee5\u53ca\u57fa\u672c\u7684\u63a7\u5236\u65b9\u6cd5\u662f\u4ec0\u4e48\uff1f", "answer": "\u8981\u5f00\u59cb\u73a9\u6050\u9f99\u6e38\u620f\uff0c\u53ea\u9700\u5728\u6e38\u620f\u7126\u70b9\u72b6\u6001\u4e0b\u6309\u4e0b\u7a7a\u683c\u952e\u6216\u5411\u4e0a\u7bad\u5934\u952e\u5373\u53ef\u3002\u57fa\u672c\u63a7\u5236\u5305\u62ec\u6309\u4e0b\u7a7a\u683c\u952e\u6216\u5411\u4e0a\u7bad\u5934\u952e\u8ba9\u6050\u9f99\u8df3\u8dc3\uff0c\u4ee5\u53ca\u6309\u4e0b\u5411\u4e0b\u7bad\u5934\u952e\u8ba9\u6050\u9f99\u8eb2\u907f\u3002\u4f8b\u5982\uff0c\u5f53\u51fa\u73b0\u4ed9\u4eba\u638c\u65f6\uff0c\u6309\u4e0b\u7a7a\u683c\u952e\u8df3\u8fc7\u5b83\u3002\u8fd9\u4e2a\u7b80\u5355\u7684\u673a\u5236\u662f\u6e38\u620f\u7684\u6838\u5fc3\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u6050\u9f99\u6e38\u620f\u7684\u901f\u5ea6\u4f1a\u589e\u52a0\uff0c\u4ee5\u53ca\u8fd9\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u6050\u9f99\u6e38\u620f\u4e2d\u7684\u901f\u5ea6\u4f1a\u968f\u7740\u65f6\u95f4\u63a8\u79fb\u800c\u589e\u52a0\uff0c\u4ee5\u6b64\u63d0\u5347\u6e38\u620f\u7684\u6311\u6218\u6027\u3002\u8fd9\u4f1a\u5f71\u54cd\u6e38\u620f\u4f53\u9a8c\uff0c\u9700\u8981\u73a9\u5bb6\u66f4\u5feb\u7684\u53cd\u5e94\u901f\u5ea6\u548c\u66f4\u7cbe\u786e\u7684\u65f6\u673a\u628a\u63e1\u3002\u4f8b\u5982\uff0c\u968f\u7740\u6e38\u620f\u8fdb\u5c55\uff0c\u969c\u788d\u7269\u4e4b\u95f4\u7684\u95f4\u9694\u7f29\u77ed\uff0c\u4f7f\u53cd\u5e94\u53d8\u5f97\u66f4\u56f0\u96be\u3002\u8fd9\u79cd\u673a\u5236\u8ba9\u6e38\u620f\u4fdd\u6301\u8da3\u5473\u6027\uff0c\u5e76\u68c0\u9a8c\u73a9\u5bb6\u7684\u8010\u529b\u548c\u6280\u5de7\u3002"}, {"question": "\u6050\u9f99\u6e38\u620f\u4e2d\u6709\u54ea\u4e9b\u4e0d\u540c\u7684\u969c\u788d\u7269\uff0c\u4ee5\u53ca\u5982\u4f55\u907f\u514d\u5b83\u4eec\uff1f", "answer": "\u6050\u9f99\u6e38\u620f\u4e2d\u6709\u4e24\u79cd\u4e3b\u8981\u7c7b\u578b\u7684\u969c\u788d\u7269\uff1a\u4ed9\u4eba\u638c\u548c\u7ffc\u9f99\u3002\u4e3a\u4e86\u8eb2\u907f\u4ed9\u4eba\u638c\uff0c\u8bf7\u6309\u4e0b\u7a7a\u683c\u952e\u8df3\u8fc7\u5b83\u4eec\u3002\u5bf9\u4e8e\u7ffc\u9f99\uff0c\u4f60\u53ef\u4ee5\u9009\u62e9\u8df3\u8fc7\u53bb\u6216\u6309\u4e0b\u5411\u4e0b\u7bad\u5934\u952e\u8eb2\u5230\u5b83\u4eec\u7684\u4e0b\u65b9\u3002\u4f8b\u5982\uff0c\u5982\u679c\u7ffc\u9f99\u98de\u5f97\u5f88\u4f4e\uff0c\u8eb2\u907f\u662f\u66f4\u5b89\u5168\u7684\u9009\u62e9\u3002\u4e86\u89e3\u8fd9\u4e9b\u969c\u788d\u7269\u5bf9\u4e8e\u5728\u6e38\u620f\u4e2d\u751f\u5b58\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u5982\u4f55\u5728\u6050\u9f99\u6e38\u620f\u4e2d\u83b7\u5f97\u9ad8\u5206\uff1f\u9ad8\u7ea7\u73a9\u5bb6\u7684\u9010\u6b65\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u6b65\u9aa41\uff1a\u638c\u63e1\u8df3\u8dc3\u548c\u8eb2\u907f\u7684\u65f6\u673a\uff0c\u4ee5\u907f\u514d\u6240\u6709\u969c\u788d\u7269\u3002\u6b65\u9aa42\uff1a\u9884\u6d4b\u901f\u5ea6\u7684\u63d0\u5347\uff0c\u5e76\u76f8\u5e94\u5730\u8c03\u6574\u4f60\u7684\u53cd\u5e94\u3002\u6b65\u9aa43\uff1a\u4fdd\u6301\u4e13\u6ce8\uff0c\u907f\u514d\u5206\u5fc3\uff0c\u4ee5\u4fdd\u6301\u4e00\u81f4\u6027\u3002\u4f8b\u5982\uff0c\u5b9a\u671f\u7ec3\u4e60\u5efa\u7acb\u808c\u8089\u8bb0\u5fc6\u3002\u9ad8\u7ea7\u73a9\u5bb6\u901a\u5e38\u4f7f\u7528\u8fd9\u4e9b\u7b56\u7565\u6765\u83b7\u5f97\u9ad8\u5206\uff0c\u6709\u65f6\u751a\u81f3\u8fbe\u5230\u6570\u5343\u5206\u3002"}, {"question": "\u54ea\u4e9b\u6280\u5de7\u6709\u52a9\u4e8e\u5728\u6050\u9f99\u6e38\u620f\u4e2d\u4fdd\u6301\u957f\u65f6\u95f4\u7684\u5954\u8dd1\uff1f", "answer": "\u5728\u6050\u9f99\u6e38\u620f\u4e2d\u4fdd\u6301\u957f\u65f6\u95f4\u5954\u8dd1\u7684\u6280\u672f\u5305\u62ec\u7ec3\u4e60\u6301\u7eed\u7684\u65f6\u673a\u628a\u63e1\uff0c\u5728\u538b\u529b\u4e0b\u4fdd\u6301\u51b7\u9759\uff0c\u4ee5\u53ca\u5229\u7528\u5468\u8fb9\u89c6\u91ce\u9884\u6d4b\u969c\u788d\u7269\u3002\u4f8b\u5982\uff0c\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u901a\u5e38\u4f1a\u7565\u5fae\u5411\u524d\u770b\u5c4f\u5e55\uff0c\u4e3a\u5373\u5c06\u5230\u6765\u7684\u6311\u6218\u505a\u597d\u51c6\u5907\u3002\u8fd9\u4e9b\u6280\u5de7\u6709\u52a9\u4e8e\u4fdd\u6301\u4e13\u6ce8\u5e76\u5ef6\u957f\u5954\u8dd1\u65f6\u95f4\u3002"}, {"question": "\u6050\u9f99\u6e38\u620f\u7684\u5206\u6570\u7cfb\u7edf\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5b83\u662f\u5982\u4f55\u8ba1\u7b97\u7684\uff1f", "answer": "\u6050\u9f99\u6e38\u620f\u7684\u5206\u6570\u7cfb\u7edf\u57fa\u4e8e\u6050\u9f99\u6240\u8dd1\u7684\u8ddd\u79bb\u3002\u6bcf\u4e00\u70b9\u90fd\u4ee3\u8868\u4e00\u5b9a\u8ddd\u79bb\u7684\u79fb\u52a8\u3002\u6e38\u620f\u8fd8\u4f1a\u968f\u7740\u65f6\u95f4\u589e\u52a0\u901f\u5ea6\uff0c\u8fd9\u95f4\u63a5\u5730\u5f71\u54cd\u7740\u5f97\u5206\u7387\u3002\u4f8b\u5982\uff0c\u968f\u7740\u6e38\u620f\u901f\u5ea6\u52a0\u5feb\uff0c\u5206\u6570\u79ef\u7d2f\u5f97\u66f4\u5feb\uff0c\u8fd9\u4f7f\u5f97\u83b7\u5f97\u9ad8\u5206\u66f4\u52a0\u5177\u6709\u6311\u6218\u6027\u3002\u7406\u89e3\u8fd9\u4e2a\u7cfb\u7edf\u53ef\u4ee5\u5e2e\u52a9\u73a9\u5bb6\u66f4\u597d\u5730\u5236\u5b9a\u7b56\u7565\u3002"}, {"question": "\u6050\u9f99\u6e38\u620f\u4e2d\u7684\u6e38\u620f\u96be\u5ea6\u662f\u5982\u4f55\u9012\u589e\u7684\uff0c\u4ee5\u53ca\u95e8\u69db\u503c\u662f\u591a\u5c11\uff1f", "answer": "\u6050\u9f99\u6e38\u620f\u4e2d\u7684\u6e38\u620f\u96be\u5ea6\u662f\u901a\u8fc7\u5b9a\u671f\u63d0\u9ad8\u901f\u5ea6\u6765\u5b9e\u73b0\u9012\u589e\u7684\u3002\u901a\u5e38\u60c5\u51b5\u4e0b\uff0c\u901f\u5ea6\u6bcf\u83b7\u5f97 100 \u5206\u5c31\u4f1a\u589e\u52a0\u4e00\u6b21\uff0c\u4f7f\u6e38\u620f\u96be\u5ea6\u9010\u6e10\u52a0\u5927\u3002\u4f8b\u5982\uff0c\u8fbe\u5230 100 \u5206\u540e\uff0c\u901f\u5ea6\u4f1a\u7565\u5fae\u63d0\u9ad8\uff0c\u8fd9\u79cd\u6a21\u5f0f\u4f1a\u968f\u7740\u6e38\u620f\u8fdb\u5c55\u800c\u6301\u7eed\u3002\u8fd9\u4e9b\u9608\u503c\u65e8\u5728\u6d4b\u8bd5\u73a9\u5bb6\u7684\u9002\u5e94\u6027\u548c\u6280\u80fd\u3002"}, {"question": "\u6050\u9f99\u6e38\u620f\u7684\u6e38\u620f\u8fdb\u5ea6\u53ef\u4ee5\u4fdd\u5b58\u6216\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u8f6c\u79fb\u5417\uff1f", "answer": "\u6050\u9f99\u6e38\u620f\u672c\u8eab\u4e0d\u652f\u6301\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u4fdd\u5b58\u6216\u8f6c\u79fb\u6e38\u620f\u8fdb\u5ea6\u3002\u6e38\u620f\u7684\u8bbe\u8ba1\u76ee\u7684\u662f\u63d0\u4f9b\u4e00\u79cd\u7b80\u5355\u7684\u3001\u57fa\u4e8e\u4f1a\u8bdd\u7684\u4f53\u9a8c\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u4e0d\u540c\u7684\u7535\u8111\u4e0a\u73a9\u6e38\u620f\uff0c\u4f60\u5c06\u4ece\u5934\u5f00\u59cb\u3002\u7136\u800c\uff0c\u4e00\u4e9b\u6d4f\u89c8\u5668\u6269\u5c55\u7a0b\u5e8f\u6216\u7b2c\u4e09\u65b9\u5de5\u5177\u53ef\u80fd\u4f1a\u63d0\u4f9b\u6709\u9650\u7684\u8fdb\u5ea6\u4fdd\u5b58\u529f\u80fd\uff0c\u4f46\u8fd9\u5e76\u975e\u5b98\u65b9\u652f\u6301\u7684\u529f\u80fd\u3002"}, {"question": "\u6050\u9f99\u6e38\u620f\u4e2d\u6709\u9690\u85cf\u7684\u529f\u80fd\u6216\u5f69\u86cb\u5417\uff1f", "answer": "\u6050\u9f99\u6e38\u620f\u4e2d\u9690\u85cf\u7684\u529f\u80fd\u4e4b\u4e00\u662f\u201c\u591c\u95f4\u6a21\u5f0f\u201d\uff0c\u53ef\u4ee5\u901a\u8fc7\u5728\u6e38\u620f\u5904\u4e8e\u7126\u70b9\u72b6\u6001\u65f6\u6309\u4e0b\u7a7a\u683c\u952e\u6765\u6fc0\u6d3b\u3002\u8fd9\u4f1a\u5c06\u80cc\u666f\u66f4\u6539\u4e3a\u6df1\u8272\u4e3b\u9898\uff0c\u6a21\u62df\u591c\u95f4\u73af\u5883\u3002\u4f8b\u5982\uff0c\u6fc0\u6d3b\u591c\u95f4\u6a21\u5f0f\u540e\uff0c\u6e38\u620f\u753b\u9762\u4f1a\u53d1\u751f\u6539\u53d8\uff0c\u63d0\u4f9b\u4e0d\u540c\u7684\u5ba1\u7f8e\u4f53\u9a8c\u3002\u8fd9\u4e9b\u5f69\u86cb\u4e3a\u6e38\u620f\u589e\u6dfb\u4e86\u989d\u5916\u7684\u4e50\u8da3\u3002"}, {"question": "\u5982\u4f55\u5728\u4e0d\u540c\u7684\u6d4f\u89c8\u5668\u4e0a\u4f18\u5316\u6050\u9f99\u6e38\u620f\u7684\u6027\u80fd\uff1f", "answer": "\u8981\u5728\u4e0d\u540c\u7684\u6d4f\u89c8\u5668\u4e0a\u4f18\u5316\u6050\u9f99\u6e38\u620f\u7684\u6027\u80fd\uff0c\u8bf7\u786e\u4fdd\u4f60\u7684\u6d4f\u89c8\u5668\u5df2\u66f4\u65b0\u5230\u6700\u65b0\u7248\u672c\u3002\u6b64\u5916\uff0c\u5173\u95ed\u4e0d\u5fc5\u8981\u7684\u6807\u7b7e\u9875\u548c\u6269\u5c55\u7a0b\u5e8f\u4ee5\u91ca\u653e\u7cfb\u7edf\u8d44\u6e90\u3002\u4f8b\u5982\uff0c\u5728\u6ca1\u6709\u5176\u4ed6\u6807\u7b7e\u9875\u7684\u60c5\u51b5\u4e0b\u5728 Chrome \u6d4f\u89c8\u5668\u4e0a\u73a9\u6e38\u620f\u53ef\u4ee5\u83b7\u5f97\u66f4\u6d41\u7545\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u8fd9\u4e9b\u4f18\u5316\u6709\u52a9\u4e8e\u51cf\u5c11\u5ef6\u8fdf\uff0c\u5e76\u63d0\u5347\u6574\u4f53\u6e38\u620f\u4f53\u9a8c\u3002"}]
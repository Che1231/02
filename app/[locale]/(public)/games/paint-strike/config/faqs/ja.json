[{"question": "\u30da\u30a4\u30f3\u30c8\u30b9\u30c8\u30e9\u30a4\u30af101\uff1a\u30da\u30a4\u30f3\u30c8\u30b9\u30c8\u30e9\u30a4\u30af\u306e\u65b0\u53c2\u8005\u3068\u3057\u3066\u3001\u3069\u306e\u3088\u3046\u306b\u52b9\u679c\u7684\u306b\u72d9\u3044\u6483\u3061\u3057\u3001\u6483\u3061\u307e\u3059\u304b\uff1f", "answer": "\u65b0\u305f\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u3057\u3066\u3001\u52b9\u679c\u7684\u306b\u72d9\u3044\u3092\u5b9a\u3081\u3001\u6483\u3064\u3053\u3068\u306f\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u6700\u521d\u306b\u3001\u30aa\u30d7\u30b7\u30e7\u30f3\u30e1\u30cb\u30e5\u30fc\u3067\u611f\u5ea6\u8a2d\u5b9a\u3092\u8abf\u6574\u3057\u3001\u5feb\u9069\u306a\u30ec\u30d9\u30eb\u3092\u63a2\u3057\u307e\u3059\u3002\u308f\u305a\u304b\u306b\u4f4e\u3044\u611f\u5ea6\u306f\u901a\u5e38\u3001\u3088\u308a\u512a\u308c\u305f\u7cbe\u5ea6\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0\u3059\u308b\u3068\u304d\u306f\u3001\u30bf\u30fc\u30b2\u30c3\u30c8\u306e\u52d5\u304d\u3092\u4e88\u6e2c\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5bfe\u6226\u76f8\u624b\u304c\u5de6\u306b\u52d5\u3044\u3066\u3044\u308b\u5834\u5408\u3001\u79fb\u52d5\u6642\u9593\u306b\u898b\u5408\u3046\u3088\u3046\u306b\u3001\u5c11\u3057\u5de6\u306b\u7167\u6e96\u3092\u5408\u308f\u305b\u307e\u3059\u3002\u6b66\u5668\u306b\u3088\u3063\u3066\u5674\u9727\u30d1\u30bf\u30fc\u30f3\u304c\u7570\u306a\u308b\u3053\u3068\u3092\u899a\u3048\u3066\u304a\u3044\u3066\u304f\u3060\u3055\u3044\uff01\u5404\u6b66\u5668\u306b\u52b9\u679c\u7684\u306a\u5c04\u7a0b\u3092\u628a\u63e1\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30d0\u30fc\u30b9\u30c8\u30d5\u30a1\u30a4\u30a2\u3068\u30d5\u30eb\u30aa\u30fc\u30c8\u3092\u8a66\u3057\u3066\u3001\u6563\u5e03\u3092\u7406\u89e3\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u5b9f\u4e16\u754c\u306e\u5c04\u6483\u30b7\u30ca\u30ea\u30aa\u3067\u5c04\u624b\u304c\u30b9\u30b3\u30fc\u30d7\u3092\u8abf\u6574\u3059\u308b\u65b9\u6cd5\u3068\u4f3c\u3066\u3044\u307e\u3059\u3002\u6700\u5f8c\u306b\u3001\u7df4\u7fd2\u306f\u5b8c\u74a7\u3092\u5c0e\u304d\u307e\u3059\u3002\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u30e2\u30fc\u30c9\u3067\u6642\u9593\u3092\u8cbb\u3084\u3057\u3001\u30b9\u30ad\u30eb\u3092\u78e8\u304d\u307e\u3059\u3002\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3067\u793a\u5506\u3055\u308c\u3066\u3044\u308b\u3088\u3046\u306b\u3001\u3042\u306a\u305f\u3068\u81ea\u52d5\u30bf\u30fc\u30b2\u30c3\u30c8\u9593\u306e\u8ddd\u96e2\u3092\u5909\u5316\u3055\u305b\u30013\u30e1\u30fc\u30c8\u30eb\u304b\u308910\u30e1\u30fc\u30c8\u30eb\u306e\u9593\u306e\u5c04\u7a0b\u3092\u7df4\u7fd2\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30da\u30a4\u30f3\u30c8\u30b9\u30c8\u30e9\u30a4\u30af\u3067\u3069\u306e\u3088\u3046\u306a\u6b66\u5668\u306e\u7a2e\u985e\u304c\u3042\u308a\u3001\u521d\u5fc3\u8005\u3068\u3057\u3066\u57fa\u672c\u3092\u7406\u89e3\u3059\u308b\u305f\u3081\u306b\u3001\u6700\u521d\u306b\u3069\u306e\u6b66\u5668\u3092\u9078\u3076\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u30da\u30a4\u30f3\u30c8\u30b9\u30c8\u30e9\u30a4\u30af\u306f\u3001SMG\u304b\u3089\u30b9\u30ca\u30a4\u30d1\u30fc\u30e9\u30a4\u30d5\u30eb\u307e\u3067\u3001\u591a\u69d8\u306a\u6b66\u5668\u5eab\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u521d\u5fc3\u8005\u306e\u65b9\u306b\u306f\u3001\u30a2\u30b5\u30eb\u30c8\u30e9\u30a4\u30d5\u30eb\uff08AR\uff09\u304b\u3089\u59cb\u3081\u308b\u3053\u3068\u3092\u304a\u52e7\u3081\u3057\u307e\u3059\u3002AR\u306f\u3001\u5c04\u7a0b\u3001\u7cbe\u5ea6\u3001\u30c0\u30e1\u30fc\u30b8\u306e\u30d0\u30e9\u30f3\u30b9\u3092\u53d6\u308a\u3001\u5b66\u7fd2\u66f2\u7dda\u3092\u3088\u308a\u512a\u3057\u304f\u3057\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300cM4\u300d\u30a2\u30b5\u30eb\u30c8\u30e9\u30a4\u30d5\u30eb\u306f\u4f7f\u3044\u3084\u3059\u304f\u3001\u6c4e\u7528\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u7279\u6b8a\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u5727\u5012\u3055\u308c\u308b\u3053\u3068\u306a\u304f\u3001\u30b3\u30a2\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305d\u306e\u5f8c\u3001\u7d4c\u9a13\u3092\u7a4d\u3080\u306b\u3064\u308c\u3066\u3001\u5404\u6b66\u5668\u306e\u30c0\u30e1\u30fc\u30b8\u30b9\u30c6\u30fc\u30bf\u30b9\u306f\u3042\u306a\u305f\u306b\u7570\u306a\u308b\u9b45\u529b\u3092\u793a\u3057\u307e\u3059\u304c\u3001\u6700\u521d\u306e\u6570\u6642\u9593\u306e\u9593\u306f\u3001\u57fa\u672c\u7684\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u30eb\u30fc\u30d7\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u307e\u3067M4\u306b\u56fa\u57f7\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u306f\u3001\u30c1\u30a7\u30b9\u3092\u5b66\u3076\u3053\u3068\u3068\u540c\u69d8\u3067\u3059\u3002\u5f8c\u3067\u8a66\u305b\u308b\u4e8b\u306f\u3067\u304d\u307e\u3059\u304c\u3001\u521d\u5fc3\u8005\u306e\u4eba\u306f\u3001\u3088\u304f\u5b9a\u7fa9\u3055\u308c\u308b\u307e\u3067\u3001\u57fa\u672c\u7684\u306a\u30aa\u30fc\u30d7\u30cb\u30f3\u30b0\u3092\u7e70\u308a\u8fd4\u3057\u30d7\u30ec\u30fc\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30da\u30a4\u30f3\u30c8\u30b9\u30c8\u30e9\u30a4\u30af\u306e\u57fa\u672c\uff1a\u65b0\u305f\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u72af\u3057\u3084\u3059\u3044\u4e00\u822c\u7684\u306a\u30df\u30b9\u306f\u4f55\u304b\u3001\u305d\u3057\u3066\u305d\u308c\u3089\u3092\u907f\u3051\u308b\u3053\u3068\u3067\u3069\u306e\u3088\u3046\u306b\u3088\u308a\u65e9\u304f\u6539\u5584\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30da\u30a4\u30f3\u30c8\u30b9\u30c8\u30e9\u30a4\u30af\u306e\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u901a\u5e38\u3001\u6226\u8853\u7684\u914d\u616e\u306a\u3057\u306b\u6226\u95d8\u306b\u7a81\u5165\u3057\u3001\u30ab\u30d0\u30fc\u3092\u52b9\u679c\u7684\u306b\u5229\u7528\u305b\u305a\u3001\u30df\u30cb\u30de\u30c3\u30d7\u3092\u7121\u8996\u3057\u304c\u3061\u3067\u3059\u3002\u3088\u308a\u65e9\u304f\u6539\u5584\u3059\u308b\u305f\u3081\u306b\u3001\u3053\u308c\u3089\u306e\u843d\u3068\u3057\u7a74\u3092\u907f\u3051\u307e\u3057\u3087\u3046\u3002\u307e\u305a\u3001\u6575\u3068\u4ea4\u6226\u3059\u308b\u524d\u306b\u5e38\u306b\u5468\u56f2\u3092\u8a55\u4fa1\u3057\u307e\u3059\u3002\u9003\u3052\u9053\u3084\u8fd1\u304f\u306e\u30ab\u30d0\u30fc\u304c\u3042\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6b21\u306b\u3001\u30ab\u30d0\u30fc\u306e\u9069\u5207\u306a\u4f7f\u7528\u306f\u751f\u5b58\u7387\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002\u30ab\u30d0\u30fc\u30dd\u30a4\u30f3\u30c8\u9593\u306e\u8fc5\u901f\u306a\u79fb\u52d5\u7df4\u7fd2\u3092\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u6700\u5f8c\u306b\u3001\u30df\u30cb\u30de\u30c3\u30d7\u3092\u78ba\u8a8d\u3059\u308b\u3053\u3068\u3067\u6575\u306e\u4f4d\u7f6e\u3068\u30c1\u30fc\u30e0\u30e1\u30a4\u30c8\u306e\u5834\u6240\u3092\u628a\u63e1\u3057\u3001\u8cb4\u91cd\u306a\u60c5\u5831\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300cDust2\u300d\u306e\u30df\u30cb\u30de\u30c3\u30d7\u3067\u3001\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u5e38\u306bB\u30b5\u30a4\u30c8\u306e\u30c8\u30f3\u30cd\u30eb\u306b\u6ce8\u610f\u3092\u6255\u3046\u3079\u304d\u3067\u3059\u3002\u5e38\u306b\u6575\u306e\u914d\u7f6e\u3092\u7406\u89e3\u3067\u304d\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30d2\u30f3\u30c8\u3092\u7d99\u7d9a\u7684\u306b\u9069\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u3042\u306a\u305f\u306e\u5b66\u7fd2\u66f2\u7dda\u306f\u5287\u7684\u306b\u77ed\u7e2e\u3055\u308c\u307e\u3059\u3002\u8003\u616e\u3059\u3079\u304d\u3082\u3046\u4e00\u3064\u306e\u5074\u9762\u306f\u7167\u6e96\u306e\u914d\u7f6e\u3067\u3059\u3002\u6575\u304c\u8997\u304d\u8fbc\u3080\u53ef\u80fd\u6027\u306e\u3042\u308b\u5834\u6240\u306b\u7167\u6e96\u3092\u5408\u308f\u305b\u307e\u3059\u3002\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u305f\u3081\u306b\u3001\u3053\u306e\u4fbf\u5229\u306a\u7167\u6e96\u8a2d\u5b9a\u3092\u3054\u78ba\u8a8d\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u4e0a\u7d1a\u30da\u30a4\u30f3\u30c8\u30b9\u30c8\u30e9\u30a4\u30af\uff1a\u6226\u95d8\u3067\u6709\u5229\u3092\u5f97\u308b\u305f\u3081\u306b\u3001\u30b9\u30c8\u30ec\u30fc\u30d5\u30a3\u30f3\u30b0\u3084\u30b9\u30e9\u30a4\u30c7\u30a3\u30f3\u30b0\u306a\u3069\u306e\u79fb\u52d5\u30c6\u30af\u30cb\u30c3\u30af\u3092\u3069\u306e\u3088\u3046\u306b\u7fd2\u5f97\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30da\u30a4\u30f3\u30c8\u30b9\u30c8\u30e9\u30a4\u30af\u3067\u30b9\u30c8\u30ec\u30fc\u30d5\u30a3\u30f3\u30b0\u3084\u30b9\u30e9\u30a4\u30c7\u30a3\u30f3\u30b0\u306a\u3069\u306e\u79fb\u52d5\u6280\u8853\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u306f\u3001\u719f\u7df4\u3057\u305f\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u6709\u5229\u3092\u5f97\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u30b9\u30c8\u30ec\u30fc\u30d5\u30a3\u30f3\u30b0\u3068\u306f\u3001\u5c04\u6483\u4e2d\u306b\u5de6\u53f3\u306b\u52d5\u304f\u3053\u3068\u3067\u3001\u3088\u308a\u6b63\u78ba\u306b\u72d9\u308f\u308c\u308b\u53ef\u80fd\u6027\u3092\u4e0b\u3052\u307e\u3059\u3002\u30b9\u30e9\u30a4\u30c7\u30a3\u30f3\u30b0\u3068\u306f\u3001\u8fc5\u901f\u306b\u8ddd\u96e2\u3092\u8a70\u3081\u308b\u304b\u3001\u6575\u306e\u653b\u6483\u3092\u304b\u308f\u3059\u3053\u3068\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d7\u30d0\u30a4\u30b9\u30c6\u30c3\u30d7\u30ac\u30a4\u30c9\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u30b9\u30c8\u30ec\u30fc\u30d5\u30a3\u30f3\u30b0\u306e\u7df4\u7fd2\uff1a\u7167\u6e96\u3092\u56fa\u5b9a\u3057\u305f\u307e\u307e\u3001\u300cA\u300d\uff08\u5de6\u30b9\u30c8\u30ec\u30fc\u30d5\uff09\u3068\u300cD\u300d\uff08\u53f3\u30b9\u30c8\u30ec\u30fc\u30d5\uff09\u30ad\u30fc\u3092\u4ea4\u4e92\u306b\u62bc\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b9\u30e9\u30a4\u30c7\u30a3\u30f3\u30b0\u3092\u53d6\u308a\u5165\u308c\u308b\uff1a\u6575\u3092\u6cb9\u65ad\u3055\u305b\u308b\u305f\u3081\u306b\u3001\u30ab\u30d0\u30fc\u306b\u30b9\u30e9\u30a4\u30c7\u30a3\u30f3\u30b0\u3057\u306a\u304c\u3089\u5c04\u6483\u3057\u307e\u3059\u3002\u4e00\u822c\u7684\u306a\u6226\u7565\u306f\u3001\u30ea\u30ed\u30fc\u30c9\u4e2d\u306b\u30af\u30ec\u30fc\u30c8\u306e\u5f8c\u308d\u306b\u30b9\u30e9\u30a4\u30c7\u30a3\u30f3\u30b0\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b9\u30c8\u30ec\u30fc\u30d5\u30a3\u30f3\u30b0\u3068\u30b9\u30e9\u30a4\u30c7\u30a3\u30f3\u30b0\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\uff1a\u3053\u308c\u3089\u306e\u30c6\u30af\u30cb\u30c3\u30af\u3092\u4e00\u7dd2\u306b\u4f7f\u3063\u3066\u3001\u6ed1\u308b\u3088\u3046\u306a\u30bf\u30fc\u30b2\u30c3\u30c8\u306b\u306a\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300cInferno\u300d\u306e\u300cT\u300d\u30b9\u30d7\u30fc\u30ca\u30fc\u306f\u3001\u56de\u907f\u6027\u3092\u6700\u5927\u9650\u306b\u9ad8\u3081\u306a\u304c\u3089\u3001\u30df\u30c3\u30c9\u30ec\u30fc\u30f3\u306b\u8fc5\u901f\u306b\u5230\u9054\u3059\u308b\u305f\u3081\u306b\u3001\u30b9\u30e9\u30a4\u30c7\u30a3\u30f3\u30b0\u3068\u30b9\u30c8\u30ec\u30fc\u30d5\u30a3\u30f3\u30b0\u3092\u6df7\u305c\u3066\u30a2\u30d7\u30ed\u30fc\u30c1\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306b\u306f\u7df4\u7fd2\u304c\u5fc5\u8981\u3067\u3059\u304c\u3001\u6226\u95d8\u306b\u304a\u3051\u308b\u3042\u306a\u305f\u306e\u52b9\u679c\u6027\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002\u79fb\u52d5\u304c\u53ef\u80fd\u306a\u9650\u308a\u30b9\u30e0\u30fc\u30ba\u306b\u306a\u308b\u3088\u3046\u306b\u3001\u30ad\u30fc\u30d0\u30a4\u30f3\u30c9\u3092\u6700\u9069\u5316\u3059\u308b\u306e\u3092\u5fd8\u308c\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30da\u30a4\u30f3\u30c8\u30b9\u30c8\u30e9\u30a4\u30af\u3067\u4e0a\u7d1a\u30c1\u30fc\u30e0\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\u3001\u305d\u3057\u3066\u30b2\u30fc\u30e0\u5185\u3067\u3069\u306e\u3088\u3046\u306b\u30c1\u30fc\u30e0\u30e1\u30a4\u30c8\u3068\u52b9\u679c\u7684\u306b\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u3092\u3068\u3063\u3066\u305d\u308c\u3089\u3092\u5b9f\u88c5\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30da\u30a4\u30f3\u30c8\u30b9\u30c8\u30e9\u30a4\u30af\u306e\u4e0a\u7d1a\u30c1\u30fc\u30e0\u6226\u7565\u306b\u306f\u3001\u9023\u643a\u3057\u305f\u653b\u6483\u3001\u6226\u7565\u7684\u306a\u30a8\u30ea\u30a2\u306e\u5236\u5fa1\u3001\u52b9\u7387\u7684\u306a\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u6226\u7565\u3092\u5b9f\u884c\u3059\u308b\u305f\u3081\u306b\u3001\u52b9\u679c\u7684\u306a\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u304c\u9375\u3068\u306a\u308a\u307e\u3059\u3002\u65b9\u6cd5\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u660e\u78ba\u306a\u5f79\u5272\u3092\u78ba\u7acb\u3059\u308b\uff1a\u30a8\u30f3\u30c8\u30ea\u30fc\u30d5\u30e9\u30c3\u30b0\u3001\u30b5\u30dd\u30fc\u30c8\u3001\u30b9\u30ca\u30a4\u30d1\u30fc\u306a\u3069\u306e\u5f79\u5272\u3092\u5404\u30c1\u30fc\u30e0\u30e1\u30a4\u30c8\u306b\u5272\u308a\u5f53\u3066\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u7c21\u6f54\u306a\u30b3\u30fc\u30eb\u30a2\u30a6\u30c8\u3092\u4f7f\u7528\u3059\u308b\uff1a\u660e\u78ba\u306a\u5834\u6240\u540d\u3092\u4f7f\u7528\u3057\u3066\u6575\u306e\u4f4d\u7f6e\u3068\u610f\u56f3\u3092\u4f1d\u3048\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u300cDust2\u300d\u306e\u300cA\u30ed\u30f3\u30b0\u300d\u3084\u300cMirage\u300d\u306e\u300cCatwalk\u300d\u306a\u3069\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u9023\u643a\u3057\u305f\u30d7\u30c3\u30b7\u30e5\u3092\u8a08\u753b\u3059\u308b\uff1a\u6575\u3092\u5727\u5012\u3059\u308b\u305f\u3081\u306b\u653b\u6483\u3092\u540c\u671f\u3055\u305b\u307e\u3057\u3087\u3046\u3002\u4e00\u822c\u7684\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u3001\u30a8\u30f3\u30c8\u30ea\u30fc\u30d5\u30e9\u30c3\u30b7\u30e3\u30fc\u304c\u7a81\u6483\u3092\u7387\u3044\u3001\u30c1\u30fc\u30e0\u30e1\u30a4\u30c8\u304c\u652f\u63f4\u5c04\u6483\u3084\u30e6\u30fc\u30c6\u30a3\u30ea\u30c6\u30a3\u30a2\u30a4\u30c6\u30e0\u306e\u5c55\u958b\u3092\u63d0\u4f9b\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u3069\u3093\u306a\u30c1\u30fc\u30e0\u30b9\u30dd\u30fc\u30c4\u3067\u3082\u305d\u3046\u3067\u3059\u304c\u3001\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u306f\u5168\u3066\u3067\u3059\u3002\u660e\u78ba\u3067\u5177\u4f53\u7684\u306a\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u3068\u660e\u78ba\u306a\u6226\u7565\u306b\u3088\u308a\u3001\u30c1\u30fc\u30e0\u306f\u660e\u78ba\u306a\u512a\u4f4d\u6027\u3092\u5f97\u307e\u3059\u3002\u640d\u5931\u306b\u3064\u3044\u3066\u3082\u5fc5\u305a\u53cd\u7701\u3059\u308b\u3088\u3046\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30da\u30a4\u30f3\u30c8\u30b9\u30c8\u30e9\u30a4\u30af\u306e\u30d7\u30ed\u30c6\u30a3\u30c3\u30d7\uff1a\u7af6\u4e89\u3092\u652f\u914d\u3059\u308b\u305f\u3081\u306b\u3001\u6700\u9ad8\u306e\u30ed\u30fc\u30c9\u30a2\u30a6\u30c8\u69cb\u6210\u3068\u7d4c\u6e08\u7ba1\u7406\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u4e0a\u7d1a\u30da\u30a4\u30f3\u30c8\u30b9\u30c8\u30e9\u30a4\u30af\u306b\u304a\u3051\u308b\u7d4c\u6e08\u7ba1\u7406\u306f\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u5178\u578b\u7684\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u3001\u500b\u3005\u306e\u6b66\u5668\u8cfc\u5165\u3068\u30c1\u30fc\u30e0\u306e\u30cb\u30fc\u30ba\u3068\u306e\u30d0\u30e9\u30f3\u30b9\u3092\u3068\u308b\u3053\u3068\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u6700\u521d\u306e\u30e9\u30a6\u30f3\u30c9\u306b\u52dd\u5229\u3057\u305f\u5f8c\u3001\u6b21\u306e\u30e9\u30a6\u30f3\u30c9\u306e\u305f\u3081\u306e\u8cc7\u91d1\u3092\u78ba\u4fdd\u3059\u308b\u305f\u3081\u306b\u3001\u90e8\u5206\u7684\u306a\u8cb7\u3044\u4ed8\u3051\uff08\u4f8b\uff1aSMG\u3068\u9632\u5fa1\u5177\uff09\u3092\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u307e\u305f\u3001\u8cc7\u91d1\u304c\u4e0d\u8db3\u3057\u3066\u3044\u308b\u30c1\u30fc\u30e0\u30e1\u30a4\u30c8\u3068\u6b66\u5668\u3092\u30c8\u30ec\u30fc\u30c9\u3059\u308b\u3053\u3068\u3092\u5b66\u3073\u307e\u3059\u3002\u30ed\u30fc\u30c9\u30a2\u30a6\u30c8\u306b\u95a2\u3057\u3066\u306f\u3001\u6b66\u5668\u306e\u9078\u629e\u3092\u3042\u306a\u305f\u306e\u5f79\u5272\u3068\u30de\u30c3\u30d7\u306b\u5408\u308f\u305b\u308b\u3079\u304d\u3067\u3059\u3002\u30b9\u30ca\u30a4\u30d1\u30fc\u306fAWP\u306e\u3088\u3046\u306a\u9577\u8ddd\u96e2\u30e9\u30a4\u30d5\u30eb\u3092\u3001\u30a8\u30f3\u30c8\u30ea\u30fc\u30d5\u30e9\u30ac\u30fc\u306fM4\u3084AK-47\u306e\u3088\u3046\u306a\u591a\u7528\u9014\u6b66\u5668\u3092\u9078\u629e\u3059\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u3042\u306a\u305f\u306e3\u756a\u76ee\u306e\u6b66\u5668\u3068\u3057\u3066\u3001Glock\u306f\u9ad8\u901f\u30ea\u30ed\u30fc\u30c9\u3068\u30d0\u30fc\u30b9\u30c8\u30d5\u30a1\u30a4\u30a2\u3067\u9ad8\u3044\u30e6\u30fc\u30c6\u30a3\u30ea\u30c6\u30a3\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u7406\u60f3\u7684\u306a\u30ed\u30fc\u30c9\u30a2\u30a6\u30c8\u306f\u3042\u306a\u305f\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u3068\u30c1\u30fc\u30e0\u30c0\u30a4\u30ca\u30df\u30af\u30b9\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u3002\u4e07\u80fd\u89e3\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u3053\u306e\u6bd4\u8f03\u8868\u3092\u4f7f\u7528\u3057\u3066\u3001\u30b2\u30fc\u30e0\u5168\u4f53\u3067\u7d4c\u6e08\u3092\u6700\u9069\u5316\u3059\u308b\u3053\u3068\u3082\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30da\u30a4\u30f3\u30c8\u30b9\u30c8\u30e9\u30a4\u30af\u306e\u6df1\u3044\u63a2\u6c42\uff1a\u30da\u30a4\u30f3\u30c8\u30b9\u30c8\u30e9\u30a4\u30af\u306e\u6b66\u5668\u53cd\u52d5\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u30b2\u30fc\u30e0\u5185\u30e1\u30ab\u30cb\u30ba\u30e0\u3067\u305d\u308c\u3092\u514b\u670d\u3057\u3066\u5b8c\u74a7\u306a\u7cbe\u5ea6\u3092\u5b9f\u73fe\u3059\u308b\u65b9\u6cd5\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30da\u30a4\u30f3\u30c8\u30b9\u30c8\u30e9\u30a4\u30af\u306e\u6b66\u5668\u53cd\u52d5\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b9\u30ad\u30eb\u3092\u8a66\u3059\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u305f\u8907\u96d1\u306a\u30b7\u30b9\u30c6\u30e0\u3067\u3059\u3002\u5404\u6b66\u5668\u306f\u3001\u4e00\u610f\u306e\u53cd\u52d5\u30d1\u30bf\u30fc\u30f3\u3092\u6301\u3061\u307e\u3059\u3002\u305d\u308c\u3089\u3092\u77e5\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4e00\u822c\u7684\u306b\u3001\u6700\u521d\u306e\u53cd\u52d5\u306f\u5782\u76f4\u3067\u3042\u308a\u3001\u305d\u306e\u5f8c\u6c34\u5e73\u306a\u63fa\u308c\u304c\u767a\u751f\u3057\u307e\u3059\u3002\u53cd\u52d5\u3092\u5236\u5fa1\u3059\u308b\u305f\u3081\u306b\u3001\u5782\u76f4\u306e\u79fb\u52d5\u3092\u6253\u3061\u6d88\u3059\u305f\u3081\u306b\u30de\u30a6\u30b9\u3092\u4e0b\u306b\u5f15\u304f\u3053\u3068\u3068\u3001\u6c34\u5e73\u306e\u30c9\u30ea\u30d5\u30c8\u3092\u88dc\u6b63\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3044\u304f\u3064\u304b\u306e\u6b66\u5668\u306f\u4e88\u6e2c\u53ef\u80fd\u306a\u30d1\u30bf\u30fc\u30f3\u3092\u6301\u3061\u307e\u3059\u304c\u3001\u4ed6\u306e\u6b66\u5668\u306f\u3088\u308a\u30e9\u30f3\u30c0\u30e0\u3067\u3059\u3002\u5b8c\u5168\u306a\u53cd\u52d5\u306e\u6392\u9664\u3092\u53ef\u80fd\u306b\u3059\u308b\u30b2\u30fc\u30e0\u5185\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u7126\u70b9\u306f\u3001\u305d\u306e\u88dc\u6b63\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001AK-47\u306f\u72ec\u7279\u306e\u300cT\u300d\u5b57\u578b\u306e\u53cd\u52d5\u30d1\u30bf\u30fc\u30f3\u3092\u6301\u3061\u3001\u305d\u306e\u30ab\u30a6\u30f3\u30bf\u30fc\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u306f\u3001\u4e00\u8cab\u3057\u305f\u30d8\u30c3\u30c9\u30b7\u30e7\u30c3\u30c8\u3059\u308b\u305f\u3081\u306b\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u7df4\u7fd2\u306f\u5b8c\u74a7\u3078\u306e\u9053\u3092\u5207\u308a\u958b\u304d\u307e\u3059\u3002\u3082\u3046\u4e00\u3064\u306e\u30c6\u30af\u30cb\u30c3\u30af\u306f\u3001\u77ed\u3044\u5236\u5fa1\u3055\u308c\u305f\u30d0\u30fc\u30b9\u30c8\u3067\u3059\u3002\u30d0\u30fc\u30b9\u30c8\u30d5\u30a1\u30a4\u30a2\u306f\u53cd\u52d5\u3092\u8efd\u6e1b\u3057\u3001\u7279\u306b\u9577\u8ddd\u96e2\u3067\u7cbe\u5ea6\u3092\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u81ea\u52d5\u8eca\u30a8\u30f3\u30b8\u30f3\u306b\u4f3c\u3066\u3044\u307e\u3059\u3002\u77ed\u3044\u30d0\u30fc\u30b9\u30c8\u306f\u30ac\u30b9\u3092\u7bc0\u7d04\u3057\u3001\u6469\u8017\u3092\u8efd\u6e1b\u3057\u307e\u3059\u3002"}, {"question": "\u30da\u30a4\u30f3\u30c8\u30b9\u30c8\u30e9\u30a4\u30af\u306e\u30de\u30c3\u30c1\u30e1\u30a4\u30ad\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u304c\u6642\u6298\u30a2\u30f3\u30d0\u30e9\u30f3\u30b9\u306b\u898b\u3048\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\u3001\u305d\u3057\u3066\u3053\u308c\u3089\u306e\u898b\u304b\u3051\u306e\u4e0d\u5747\u8cea\u306a\u72b6\u6cc1\u306b\u3069\u306e\u3088\u3046\u306a\u8981\u56e0\u304c\u5f71\u97ff\u3057\u3066\u3044\u307e\u3059\u304b\uff1f", "answer": "\u30da\u30a4\u30f3\u30c8\u30b9\u30c8\u30e9\u30a4\u30af\u306e\u30de\u30c3\u30c1\u30e1\u30a4\u30ad\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u3069\u3093\u306a\u7af6\u4e89\u30b7\u30b9\u30c6\u30e0\u3068\u540c\u69d8\u306b\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b9\u30ad\u30eb\u30ec\u30fc\u30c6\u30a3\u30f3\u30b0\uff08Elo\u307e\u305f\u306fMMR\u306a\u3069\uff09\u3092\u4e3b\u306b\u8003\u616e\u3057\u307e\u3059\u304c\u3001\u4ed6\u306e\u8981\u56e0\u3001\u30ad\u30e5\u30fc\u6642\u9593\u3001\u30d4\u30f3\u306e\u8a2d\u5b9a\u3001\u30d1\u30fc\u30c6\u30a3\u30fc\u30b5\u30a4\u30ba\u3082\u5f79\u5272\u3092\u679c\u305f\u3057\u307e\u3059\u3002\u3088\u308a\u9577\u3044\u30ad\u30e5\u30fc\u6642\u9593\u306f\u3001\u3088\u308a\u591a\u304f\u306e\u30de\u30c3\u30c1\u3092\u898b\u3064\u3051\u308b\u305f\u3081\u306b\u3001\u3088\u308a\u5e83\u7bc4\u56f2\u306e\u30b9\u30ad\u30eb\u30ae\u30e3\u30c3\u30d7\u306e\u30de\u30c3\u30c1\u3092\u5f62\u6210\u3059\u308b\u3053\u3068\u306b\u306a\u308b\u53ef\u80fd\u6027\u304c\u3042\u308b\u304b\u3089\u3067\u3059\u3002\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u4f4ePing\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u4e00\u7dd2\u306b\u30de\u30c3\u30c1\u30f3\u30b0\u3057\u3088\u3046\u3068\u3059\u308b\u3068\u3001\u30a2\u30f3\u30d0\u30e9\u30f3\u30b9\u306a\u30c1\u30fc\u30e0\u306b\u306a\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u30025\u4eba\u5168\u54e1\u304b\u3089\u69cb\u6210\u3055\u308c\u305f\u30d7\u30ec\u30e1\u30a4\u30c9\u30c1\u30fc\u30e0\u3068\u30e9\u30f3\u30c0\u30e0\u30bd\u30ed\u30ad\u30e5\u30fc\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u306f\u3055\u3089\u306b\u56f0\u96e3\u3067\u3059\u3002\u3042\u306a\u305f\u306e\u30b2\u30fc\u30e0\u4f53\u9a13\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u3053\u3068\u304b\u3089\u3001\u30b9\u30ad\u30eb\u30ec\u30fc\u30c6\u30a3\u30f3\u30b0\u306e\u30c0\u30a4\u30ca\u30df\u30c3\u30af\u306a\u6027\u8cea\u3092\u8003\u616e\u3059\u308b\u3053\u3068\u304c\u5f79\u7acb\u3061\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u9ad8\u30b9\u30ad\u30eb\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u4f4e\u30b9\u30ad\u30eb\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u30c1\u30fc\u30e0\u306b\u306a\u3063\u3066\u3044\u308b\u5834\u5408\u3001\u305d\u308c\u306f\u30c1\u30fc\u30e0\u5168\u4f53\u306e\u30c0\u30a4\u30ca\u30df\u30af\u30b9\u306b\u5f71\u97ff\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u8a00\u3044\u63db\u3048\u308c\u3070\u3001\u30b9\u30dd\u30fc\u30c4\u306e\u30b3\u30f3\u30c6\u30b9\u30c8\u304c\u5e38\u306b\u516c\u5e73\u3067\u3042\u308b\u3068\u306f\u9650\u308a\u307e\u305b\u3093\u3002\u5358\u306b\u3088\u308a\u512a\u308c\u305f\u30a2\u30b9\u30ea\u30fc\u30c8\u3092\u6301\u3063\u3066\u3044\u308b\u30c1\u30fc\u30e0\u3068\u5bfe\u6226\u3057\u3066\u3044\u308b\u53ef\u80fd\u6027\u304c\u3042\u308b\u3067\u3057\u3087\u3046\u3002\u3042\u306a\u305f\u306e\u65b9\u6cd5\u3092\u5fae\u8abf\u6574\u3059\u308b\u304b\u3001\u3088\u308a\u5f37\u529b\u306a\u30b0\u30eb\u30fc\u30d7\u3092\u5f62\u6210\u3059\u308b\u306e\u3092\u7d9a\u3051\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30da\u30a4\u30f3\u30c8\u30b9\u30c8\u30e9\u30a4\u30af\u306ePC\u7248\u3068\u30e2\u30d0\u30a4\u30eb\u7248\u306e\u9593\u3067\u3001\u79c1\u306e\u9032\u6357\u72b6\u6cc1\u3092\u79fb\u884c\u3067\u304d\u307e\u3059\u304b\uff1f\u305d\u308c\u3068\u3082\u3001\u5225\u3005\u306e\u30a2\u30ab\u30a6\u30f3\u30c8\u3067\u3059\u304b\uff1f", "answer": "\u73fe\u5728\u3001\u30da\u30a4\u30f3\u30c8\u30b9\u30c8\u30e9\u30a4\u30af\u306f\u3001PC\u7248\u3068\u30e2\u30d0\u30a4\u30eb\u7248\u306e\u9593\u3067\u9032\u884c\u72b6\u6cc1\u3092\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u5171\u6709\u3059\u308b\u3053\u3068\u306f\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u307e\u305b\u3093\u3002\u4f60\u7684\u8fdb\u5c55\u3001\u89e3\u9501\u548c\u8d2d\u4e70\u90fd\u4e0e\u4f60\u5728\u54ea\u4e2a\u5e73\u53f0\u4e0a\u8fdb\u884c\u8d2d\u4e70\u6709\u5173\u3002\u8fd9\u610f\u5473\u7740\uff0c\u5982\u679c\u4f60\u4ecePC\u5f00\u59cb\u73a9\uff0c\u5219\u4f60\u7684\u8fdb\u5c55\u4e0d\u4f1a\u8f6c\u79fb\u5230\u79fb\u52a8\u7248\uff0c\u53cd\u4e4b\u4ea6\u7136\u3002\u8fd9\u79cd\u5206\u79bb\u901a\u5e38\u662f\u7531\u4e8e\u5e73\u53f0\u7279\u5b9a\u7684\u529f\u80fd\u3001\u63a7\u5236\u65b9\u6848\u548c\u5546\u5e97\u653f\u7b56\u6240\u5bfc\u81f4\u7684\u3002\u7136\u800c\uff0c\u6709\u4e9b\u6e38\u620f\u63d0\u4f9b\u8d26\u6237\u94fe\u63a5\uff0c\u7528\u4e8e\u63d0\u4f9b\u5316\u5986\u54c1\u9879\u76ee\u6216\u8de8\u5e73\u53f0\u6e38\u620f\u4f53\u9a8c\uff0c\u8ba9\u73a9\u5bb6\u4e92\u76f8\u4ea4\u6d41\u3002\u7136\u800c\uff0c\u8fd9\u5e76\u4e0d\u4e00\u5b9a\u4e0e\u8fdb\u5ea6\u76f8\u540c\u3002\u8bf7\u5b9a\u671f\u68c0\u67e5\u793e\u533a\u8ba8\u8bba\u7248\uff0c\u4ee5\u9632\u5f00\u53d1\u4eba\u5458\u6dfb\u52a0\u5f71\u54cd\u6b64\u95ee\u9898\u7684\u66f4\u65b0\u3002"}, {"question": "\u30da\u30a4\u30f3\u30c8\u30b9\u30c8\u30e9\u30a4\u30af\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\uff1a\u30da\u30a4\u30f3\u30c8\u30b9\u30c8\u30e9\u30a4\u30af\u3067\u6700\u3082\u30af\u30fc\u30eb\u306a\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3084\u79d8\u5bc6\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u308c\u3089\u3092\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u3057\u3066\u3069\u306e\u3088\u3046\u306b\u5f15\u304d\u8d77\u3053\u305b\u307e\u3059\u304b\uff1f", "answer": "\u30da\u30a4\u30f3\u30c8\u30b9\u30c8\u30e9\u30a4\u30af\u306b\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3068\u79d8\u5bc6\u304c\u3042\u308a\u307e\u3059\u3002\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306e\u4f8b\u306f\u3001\u30de\u30c3\u30d7\u300c\u90fd\u5e02\u653b\u6483\u300d\u3067\u96a0\u3055\u308c\u305f\u30b9\u30d7\u30ec\u30fc\u7f36\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u3067\u3059\u3002\u30de\u30c3\u30d7\u5168\u4f53\u306b\u96a0\u308c\u305f7\u3064\u306e\u30b9\u30d7\u30ec\u30fc\u7f36\u304c\u3042\u308a\u307e\u3059\u304c\u3001\u3059\u3079\u3066\u96c6\u3081\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u5185\u3067\u4f7f\u7528\u53ef\u80fd\u306a\u96a0\u3055\u308c\u305f\u30b0\u30e9\u30d5\u30a3\u30c6\u30a3\u30bf\u30b0\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u3082\u3046\u4e00\u3064\u306e\u91cd\u8981\u306a\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3001\u300c\u653e\u68c4\u3055\u308c\u305f\u5de5\u5834\u300d\u3068\u3044\u3046\u30de\u30c3\u30d7\u3067\u96a0\u308c\u305f\u7121\u7dda\u5468\u6ce2\u6570\u30a2\u30af\u30c6\u30a3\u30d6\u306b\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u3053\u306e\u30b3\u30f3\u30d4\u30e5\u30fc\u30bf\u30fc\u30b7\u30b9\u30c6\u30e0\u3068\u76f8\u4e92\u4f5c\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u96a0\u308c\u305f\u7121\u7dda\u5468\u6ce2\u6570\u3092\u9001\u4fe1\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u30b2\u30fc\u30e0\u306e\u4e16\u754c\u89b3\u306b\u95a2\u3059\u308b\u8208\u5473\u6df1\u3044\u80cc\u666f\u60c5\u5831\u3092\u63d0\u4f9b\u3059\u308b\u96a0\u3057\u30aa\u30fc\u30c7\u30a3\u30aa\u30ed\u30b0\u304c\u767b\u5834\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u8a73\u7d30\u304c\u3001\u30b2\u30fc\u30e0\u306e\u4e16\u754c\u306b\u3055\u3089\u306b\u6ca1\u5165\u611f\u3092\u4e0e\u3048\u308b\u306e\u3092\u52a9\u3051\u307e\u3059\u3002"}]
[{"question": "Paint Strike 101\uff1a\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u5728Paint Strike\u4e2d\u6709\u6548\u7784\u51c6\u548c\u5c04\u51fb\uff1f", "answer": "\u4f5c\u4e3a\u65b0\u73a9\u5bb6\uff0c\u6709\u6548\u7784\u51c6\u548c\u5c04\u51fb\u81f3\u5173\u91cd\u8981\u3002\u9996\u5148\uff0c\u5728\u9009\u9879\u83dc\u5355\u4e2d\u8c03\u6574\u4f60\u7684\u7075\u654f\u5ea6\u8bbe\u7f6e\uff0c\u627e\u5230\u4e00\u4e2a\u8212\u9002\u7684\u6c34\u5e73\u3002\u7565\u4f4e\u7684\u7075\u654f\u5ea6\u901a\u5e38\u6709\u52a9\u4e8e\u63d0\u9ad8\u51c6\u786e\u6027\u3002\u5c04\u51fb\u65f6\uff0c\u9884\u6d4b\u76ee\u6807\u7684\u79fb\u52a8\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u7684\u5bf9\u624b\u5411\u5de6\u79fb\u52a8\uff0c\u4e3a\u4e86\u5f25\u8865\u79fb\u52a8\u65f6\u95f4\uff0c\u8bf7\u7a0d\u5fae\u5411\u5de6\u7784\u51c6\u3002\u8bb0\u4f4f\uff0c\u4e0d\u540c\u7684\u6b66\u5668\u6709\u4e0d\u540c\u7684\u55b7\u5c04\u6a21\u5f0f\uff01\u5c1d\u8bd5\u627e\u51fa\u6bcf\u79cd\u6b66\u5668\u7684\u6709\u6548\u5c04\u7a0b\u3002\u5c1d\u8bd5\u8fde\u53d1\u4e0e\u5168\u81ea\u52a8\u5c04\u51fb\uff0c\u4ee5\u4e86\u89e3\u5f39\u6563\uff0c\u7c7b\u4f3c\u4e8e\u73b0\u5b9e\u4e16\u754c\u4e2d\u7684\u5c04\u624b\u5982\u4f55\u8c03\u6574\u4ed6\u4eec\u7684\u7784\u51c6\u955c\u3002\u6700\u540e\uff0c\u719f\u80fd\u751f\u5de7\uff1b\u82b1\u4e00\u4e9b\u65f6\u95f4\u5728\u8bad\u7ec3\u6a21\u5f0f\u4e2d\u78e8\u7ec3\u4f60\u7684\u6280\u80fd\u3002\u6b63\u5982\u6559\u7a0b\u6240\u5efa\u8bae\u7684\u90a3\u6837\uff0c\u5c1d\u8bd5\u6539\u53d8\u4f60\u548c\u81ea\u52a8\u76ee\u6807\u4e4b\u95f4\u7684\u8ddd\u79bb\uff0c\u7136\u540e\u7ec3\u4e60\u4f603\u523010\u7c73\u4e4b\u95f4\u7684\u5c04\u7a0b\u3002"}, {"question": "Paint Strike\u4e2d\u6709\u54ea\u4e9b\u4e0d\u540c\u7c7b\u578b\u7684\u6b66\u5668\uff1f\u4f5c\u4e3a\u65b0\u624b\uff0c\u6211\u5e94\u8be5\u9009\u62e9\u54ea\u79cd\u6b66\u5668\u624d\u80fd\u638c\u63e1\u57fa\u672c\u6280\u5de7\uff1f", "answer": "Paint Strike\u62e5\u6709\u79cd\u7c7b\u7e41\u591a\u7684\u6b66\u5668\uff0c\u4ece\u51b2\u950b\u67aa\u5230\u72d9\u51fb\u6b65\u67aa\u3002\u4f5c\u4e3a\u521d\u5b66\u8005\uff0c\u6211\u5efa\u8bae\u4ece\u7a81\u51fb\u6b65\u67aa\uff08AR\uff09\u5f00\u59cb\u3002\u7a81\u51fb\u6b65\u67aa\u5728\u5c04\u7a0b\u3001\u7cbe\u5ea6\u548c\u4f24\u5bb3\u65b9\u9762\u53d6\u5f97\u4e86\u5e73\u8861\uff0c\u521b\u9020\u4e86\u4e00\u4e2a\u5bbd\u5bb9\u7684\u5b66\u4e60\u66f2\u7ebf\u3002\u4f8b\u5982\uff0c\u201cM4\u201d\u7a81\u51fb\u6b65\u67aa\u6613\u4e8e\u4e0a\u624b\u4e14\u7528\u9014\u5e7f\u6cdb\u3002\u4f60\u53ef\u4ee5\u901a\u8fc7\u4f7f\u7528\u5b83\u6765\u7406\u89e3\u6838\u5fc3\u673a\u5236\uff0c\u800c\u4e0d\u4f1a\u88ab\u7279\u6b8a\u673a\u5236\u6240\u56f0\u6270\u3002\u4e4b\u540e\uff0c\u968f\u7740\u4f60\u83b7\u5f97\u66f4\u591a\u7ecf\u9a8c\uff0c\u6bcf\u79cd\u6b66\u5668\u7684\u4f24\u5bb3\u6570\u636e\u4f1a\u4ee5\u4e0d\u540c\u7684\u65b9\u5f0f\u5438\u5f15\u4f60\uff0c\u4f46\u662f\uff0c\u5728\u4f60\u7684\u524d\u51e0\u4e2a\u5c0f\u65f6\u5185\uff0c\u575a\u6301\u4f7f\u7528M4\uff0c\u76f4\u5230\u4f60\u638c\u63e1\u4e86\u57fa\u672c\u7684\u6e38\u620f\u5faa\u73af\u3002\u8fd9\u4e0e\u5b66\u4e60\u56fd\u9645\u8c61\u68cb\u7c7b\u4f3c\uff1a\u540e\u6765\u53ef\u4ee5\u5c1d\u8bd5\uff0c\u4f46\u662f\u521d\u5b66\u8005\u5e94\u8be5\u91cd\u590d\u8fdb\u884c\u57fa\u672c\u5f00\u5c40\uff0c\u76f4\u5230\u4ed6\u4eec\u5f88\u597d\u5730\u5b9a\u4e49\u4e86\u8fd9\u4e9b\u5f00\u5c40\u3002"}, {"question": "Paint Strike\u57fa\u7840\u77e5\u8bc6\uff1a\u65b0\u624b\u73a9\u5bb6\u5e38\u72af\u54ea\u4e9b\u9519\u8bef\uff0c\u4ee5\u53ca\u5982\u4f55\u907f\u514d\u8fd9\u4e9b\u9519\u8bef\u4ee5\u66f4\u5feb\u5730\u63d0\u9ad8\uff1f", "answer": "\u65b0\u7684Paint Strike\u73a9\u5bb6\u901a\u5e38\u4f1a\u7f3a\u4e4f\u6218\u672f\u610f\u8bc6\u5730\u51b2\u8fdb\u67aa\u6218\uff0c\u672a\u80fd\u6709\u6548\u5229\u7528\u63a9\u4f53\uff0c\u5e76\u4e14\u5ffd\u7565\u4e86\u8ff7\u4f60\u5730\u56fe\u3002\u4e3a\u4e86\u66f4\u5feb\u5730\u63d0\u9ad8\uff0c\u907f\u514d\u8fd9\u4e9b\u9677\u9631\u3002\u9996\u5148\uff0c\u5728\u4e0e\u654c\u4eba\u4ea4\u706b\u4e4b\u524d\uff0c\u52a1\u5fc5\u5148\u8bc4\u4f30\u4f60\u7684\u5468\u56f4\u73af\u5883\uff1b\u786e\u4fdd\u9644\u8fd1\u6709\u9003\u751f\u8def\u7ebf\u6216\u63a9\u4f53\u3002\u5176\u6b21\uff0c\u6709\u6548\u5730\u4f7f\u7528\u63a9\u4f53\u80fd\u591f\u663e\u8457\u63d0\u9ad8\u751f\u5b58\u80fd\u529b\u3002\u7ec3\u4e60\u5feb\u901f\u5730\u5728\u63a9\u4f53\u70b9\u4e4b\u95f4\u8f6c\u79fb\u3002\u6700\u540e\uff0c\u7559\u610f\u8ff7\u4f60\u5730\u56fe\u53ef\u4ee5\u8ba9\u4f60\u4e86\u89e3\u654c\u4eba\u7684\u4f4d\u7f6e\u548c\u961f\u53cb\u7684\u4f4d\u7f6e\uff0c\u5e76\u63d0\u4f9b\u6709\u4ef7\u503c\u7684\u4fe1\u606f\u3002\u4f8b\u5982\uff0c\u5728\u201cDust2\u201d\u4e2d\uff0c\u65b0\u73a9\u5bb6\u5e94\u8be5\u59cb\u7ec8\u5173\u6ce8B\u70b9\u901a\u9053\uff0c\u4ee5\u786e\u4fdd\u4ed6\u4eec\u59cb\u7ec8\u4e86\u89e3\u654c\u4eba\u7684\u4f4d\u7f6e\u3002\u6301\u7eed\u5e94\u7528\u8fd9\u4e9b\u6280\u5de7\u5c06\u663e\u8457\u7f29\u77ed\u4f60\u7684\u5b66\u4e60\u66f2\u7ebf\u3002\u53e6\u4e00\u4e2a\u9700\u8981\u8003\u8651\u7684\u65b9\u9762\u662f\u51c6\u661f\u4f4d\u7f6e\uff1a\u7784\u51c6\u654c\u4eba\u53ef\u80fd\u6f5c\u4f0f\u7684\u5730\u65b9\u3002\u67e5\u770b\u6b64\u4fbf\u6377\u7684\u51c6\u661f\u8bbe\u7f6e\u914d\u7f6e\u4ee5\u4f18\u5316\u4f60\u7684\u6027\u80fd\uff1a"}, {"question": "\u9ad8\u7ea7Paint Strike\uff1a\u5982\u4f55\u638c\u63e1\u4f8b\u5982\u8d70\u4f4d\u548c\u6ed1\u884c\u7b49\u79fb\u52a8\u6280\u5de7\uff0c\u5728\u67aa\u6218\u4e2d\u83b7\u5f97\u4f18\u52bf\uff1f", "answer": "\u5728Paint Strike\u4e2d\u638c\u63e1\u8d70\u4f4d\u548c\u6ed1\u884c\u7b49\u79fb\u52a8\u6280\u5de7\u5bf9\u4e8e\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u81f3\u5173\u91cd\u8981\uff0c\u4ee5\u5728\u67aa\u6218\u4e2d\u83b7\u5f97\u4f18\u52bf\u3002\u8d70\u4f4d\u662f\u5de6\u53f3\u79fb\u52a8\u7684\u540c\u65f6\u8fdb\u884c\u5c04\u51fb\uff0c\u4f7f\u4f60\u6210\u4e3a\u66f4\u96be\u51fb\u4e2d\u7684\u76ee\u6807\u3002\u6ed1\u884c\u4f7f\u4f60\u80fd\u591f\u5feb\u901f\u7f29\u77ed\u8ddd\u79bb\u6216\u8eb2\u907f\u654c\u4eba\u7684\u706b\u529b\u3002\u4ee5\u4e0b\u662f\u4e00\u4e2a\u5faa\u5e8f\u6e10\u8fdb\u7684\u6307\u5357\uff1a\u6b65\u9aa41\uff1a\u7ec3\u4e60\u8d70\u4f4d\uff1a\u5728\u4fdd\u6301\u7784\u51c6\u7a33\u5b9a\u7684\u540c\u65f6\uff0c\u4ea4\u66ff\u6309\u4e0b\u201cA\u201d\uff08\u5de6\u8d70\u4f4d\uff09\u548c\u201cD\u201d\uff08\u53f3\u8d70\u4f4d\uff09\u952e\u3002\u6b65\u9aa42\uff1a\u878d\u5165\u6ed1\u884c\uff1a\u5728\u5f00\u706b\u7684\u540c\u65f6\u6ed1\u5165\u63a9\u4f53\uff0c\u4ee4\u4f60\u7684\u5bf9\u624b\u63aa\u624b\u4e0d\u53ca\uff1b\u4e00\u79cd\u5e38\u89c1\u7684\u7b56\u7565\u662f\u5728\u8eb2\u85cf\u7bb1\u5b50\u540e\u9762\u6362\u5f39\u5939\u7684\u65f6\u5019\u6ed1\u884c\u3002\u6b65\u9aa43\uff1a\u7ed3\u5408\u8d70\u4f4d\u548c\u6ed1\u884c\uff1a\u5c06\u8fd9\u4e9b\u6280\u5de7\u7ed3\u5408\u8d77\u6765\uff0c\u4f7f\u81ea\u5df1\u6210\u4e3a\u4e00\u4e2a\u96be\u4ee5\u6355\u6349\u7684\u76ee\u6807\u3002\u4f8b\u5982\uff0c\u5728\u201cInferno\u201d\u5730\u56fe\u4e0a\u7684\u201cT\u201d\u51fa\u751f\u70b9\u53ef\u4ee5\u7528\u6ed1\u884c\u548c\u8d70\u4f4d\u7ed3\u5408\u7684\u65b9\u5f0f\u8fc5\u901f\u5230\u8fbe\u4e2d\u8def\uff0c\u540c\u65f6\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u8eb2\u907f\u80fd\u529b\u3002\u8fd9\u9700\u8981\u7ec3\u4e60\uff0c\u4f46\u4f1a\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u6218\u6597\u6548\u7387\u3002\u8bb0\u4f4f\u8981\u4f18\u5316\u6309\u952e\u7ed1\u5b9a\uff0c\u8ba9\u79fb\u52a8\u5c3d\u53ef\u80fd\u6d41\u7545\uff01"}, {"question": "Paint Strike\u4e2d\u7684\u9ad8\u7ea7\u56e2\u961f\u7b56\u7565\u6709\u54ea\u4e9b\uff1f\u5982\u4f55\u5728\u6e38\u620f\u4e2d\u6709\u6548\u5730\u4e0e\u961f\u53cb\u6c9f\u901a\u4ee5\u5b9e\u65bd\u8fd9\u4e9b\u7b56\u7565\uff1f", "answer": "Paint Strike\u4e2d\u7684\u9ad8\u7ea7\u56e2\u961f\u7b56\u7565\u5305\u62ec\u534f\u8c03\u653b\u51fb\u3001\u6218\u7565\u533a\u57df\u63a7\u5236\u548c\u9ad8\u6548\u8d44\u6e90\u7ba1\u7406\u3002\u6709\u6548\u7684\u6c9f\u901a\u662f\u5b9e\u65bd\u8fd9\u4e9b\u7b56\u7565\u7684\u5173\u952e\u3002\u4ee5\u4e0b\u662f\u5982\u4f55\u505a\u5230\uff1a\u6b65\u9aa41\uff1a\u660e\u786e\u89d2\u8272\uff1a\u4e3a\u6bcf\u4e2a\u961f\u53cb\u5206\u914d\u89d2\u8272\uff0c\u4f8b\u5982\u7a81\u8fdb\u72d9\u51fb\u624b\u3001\u652f\u63f4\u548c\u72d9\u51fb\u624b\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u7b80\u6d01\u7684\u901a\u62a5\uff1a\u4f7f\u7528\u5177\u4f53\u7684\u5730\u7406\u4f4d\u7f6e\u540d\u79f0\uff0c\u4f8b\u5982\u201cDust2\u201d\u4e0a\u7684\u201cA\u957f\u201d\u6216\u201cMirage\u201d\u4e0a\u7684\u201c\u732b\u9053\u201d\uff0c\u6765\u6c9f\u901a\u654c\u4eba\u7684\u4f4d\u7f6e\u548c\u610f\u56fe\u3002\u6b65\u9aa43\uff1a\u89c4\u5212\u534f\u8c03\u8fdb\u653b\uff1a\u540c\u6b65\u4f60\u7684\u653b\u51fb\uff0c\u4ee5\u538b\u5012\u654c\u4eba\u3002\u4e00\u79cd\u5178\u578b\u7684\u505a\u6cd5\u662f\u8ba9\u7a81\u8fdb\u72d9\u51fb\u624b\u5e26\u5934\u51b2\u950b\uff0c\u7531\u961f\u53cb\u63d0\u4f9b\u63a9\u62a4\u706b\u529b\u548c\u90e8\u7f72\u5b9e\u7528\u7269\u54c1\u3002\u5c31\u50cf\u4efb\u4f55\u56e2\u961f\u8fd0\u52a8\u4e00\u6837\uff0c\u6c9f\u901a\u975e\u5e38\u91cd\u8981\u3002\u6e05\u6670\u7b80\u6d01\u7684\u6c9f\u901a\uff0c\u52a0\u4e0a\u660e\u786e\u7684\u7b56\u7565\uff0c\u4f1a\u7ed9\u4f60\u7684\u56e2\u961f\u5e26\u6765\u660e\u663e\u7684\u4f18\u52bf\u3002\u4e5f\u8981\u786e\u4fdd\u5bf9\u4f60\u4eec\u5931\u8d25\u7684\u6bd4\u8d5b\u8fdb\u884c\u603b\u7ed3\uff01"}, {"question": "Paint Strike\u4e13\u4e1a\u6280\u5de7\uff1a\u54ea\u4e9b\u6700\u4f73\u88c5\u5907\u914d\u7f6e\u548c\u7ecf\u6d4e\u7ba1\u7406\u7b56\u7565\u53ef\u4ee5\u4e3b\u5bb0\u6bd4\u8d5b\uff1f", "answer": "\u6210\u529f\u8fdb\u884c\u7ecf\u6d4e\u7ba1\u7406\u5bf9\u4e8e\u9ad8\u7ea7Paint Strike\u6e38\u620f\u81f3\u5173\u91cd\u8981\u3002\u4e00\u79cd\u5178\u578b\u7684\u505a\u6cd5\u662f\u5e73\u8861\u4e2a\u4eba\u6b66\u5668\u8d2d\u4e70\u4e0e\u56e2\u961f\u9700\u6c42\u3002\u4f8b\u5982\uff0c\u5728\u8d62\u5f97\u7b2c\u4e00\u8f6e\u540e\uff0c\u8003\u8651\u8fdb\u884c\u90e8\u5206\u8d2d\u4e70\uff08\u4f8b\u5982\u51b2\u950b\u67aa\u548c\u9632\u5f39\u8863\uff09\u4ee5\u8282\u7701\u540e\u7eed\u8f6e\u6b21\u7684\u8d44\u91d1\u3002\u8fd8\u8981\u5b66\u4e60\u4e0e\u8d44\u91d1\u7d27\u5f20\u7684\u961f\u53cb\u4ea4\u6362\u6b66\u5668\u3002\u81f3\u4e8e\u88c5\u5907\u914d\u7f6e\uff0c\u8bf7\u6839\u636e\u4f60\u7684\u89d2\u8272\u548c\u5730\u56fe\u5b9a\u5236\u4f60\u7684\u6b66\u5668\u9009\u62e9\u3002\u72d9\u51fb\u624b\u53d7\u76ca\u4e8e\u8fdc\u8ddd\u79bb\u6b65\u67aa\uff0c\u4f8b\u5982AWP\uff0c\u800c\u7a81\u8fdb\u72d9\u51fb\u624b\u5219\u53ef\u4ee5\u9009\u62e9\u591a\u529f\u80fd\u6b66\u5668\uff0c\u4f8b\u5982M4\u6216AK-47\u3002\u5bf9\u4e8e\u4f60\u7684\u8f85\u52a9\u6b66\u5668\uff0c\u683c\u6d1b\u514b\u5728\u8fde\u5c04\u548c\u5feb\u901f\u6362\u5f39\u65b9\u9762\u5177\u6709\u5f88\u9ad8\u7684\u5b9e\u7528\u6027\u3002\u8bb0\u4f4f\uff0c\u7406\u60f3\u7684\u88c5\u5907\u914d\u7f6e\u53d6\u51b3\u4e8e\u4f60\u7684\u6e38\u620f\u98ce\u683c\u548c\u56e2\u961f\u52a8\u6001\uff1b\u6ca1\u6709\u201c\u4e00\u5200\u5207\u201d\u7684\u89e3\u51b3\u65b9\u6848\u3002\u4f7f\u7528\u6b64\u6bd4\u8f83\u56fe\u8868\u4f18\u5316\u60a8\u5728\u6e38\u620f\u4e2d\u7684\u7ecf\u6d4e\u4e5f\u662f\u6709\u76ca\u7684\uff1a"}, {"question": "Paint Strike\u6df1\u5165\u63a2\u8ba8\uff1aPaint Strike\u4e2d\u7684\u6b66\u5668\u540e\u5750\u529b\u662f\u5982\u4f55\u5de5\u4f5c\u7684\uff0c\u6e38\u620f\u4e2d\u6709\u4efb\u4f55\u673a\u5236\u53ef\u4ee5\u514b\u670d\u5b83\u5e76\u5b9e\u73b0\u5b8c\u7f8e\u7cbe\u5ea6\uff1f", "answer": "Paint Strike\u4e2d\u7684\u6b66\u5668\u540e\u5750\u529b\u662f\u4e00\u4e2a\u590d\u6742\u7cfb\u7edf\uff0c\u65e8\u5728\u68c0\u9a8c\u73a9\u5bb6\u7684\u6280\u672f\u3002\u6bcf\u79cd\u6b66\u5668\u90fd\u6709\u72ec\u7279\u7684\u53cd\u540e\u5750\u529b\u6a21\u5f0f\uff0c\u5fc5\u987b\u5b66\u4e60\u3002\u901a\u5e38\uff0c\u521d\u59cb\u540e\u5750\u529b\u662f\u5782\u76f4\u7684\uff0c\u968f\u540e\u662f\u6c34\u5e73\u6446\u52a8\u3002\u5b66\u4e60\u63a7\u5236\u53cd\u540e\u5750\u529b\u5305\u62ec\u5411\u4e0b\u62c9\u52a8\u9f20\u6807\u4ee5\u62b5\u6d88\u5782\u76f4\u4e0a\u5347\uff0c\u5e76\u8865\u507f\u6c34\u5e73\u6f02\u79fb\u3002\u4e00\u4e9b\u6b66\u5668\u7684\u53cd\u540e\u5750\u529b\u6a21\u5f0f\u662f\u53ef\u9884\u6d4b\u7684\uff0c\u800c\u53e6\u4e00\u4e9b\u6a21\u5f0f\u5219\u66f4\u4e3a\u968f\u673a\u3002\u6e38\u620f\u5185\u6ca1\u6709\u673a\u5236\u53ef\u4ee5\u5b8c\u5168\u6d88\u9664\u53cd\u540e\u5750\u529b\uff1b\u91cd\u70b9\u5728\u4e8e\u638c\u63e1\u5176\u8865\u507f\u65b9\u6cd5\u3002\u4f8b\u5982\uff0cAK-47\u5177\u6709\u72ec\u7279\u7684\u201cT\u201d\u5f62\u53cd\u540e\u5750\u529b\u6a21\u5f0f\uff1b\u638c\u63e1\u5176\u8865\u507f\u65b9\u6cd5\u662f\u5b9e\u73b0\u7a33\u5b9a\u7206\u5934\u7684\u5173\u952e\u3002\u5728\u6b64\u673a\u5236\u5185\uff0c\u7ec3\u4e60\u624d\u80fd\u4f7f\u4eba\u5b8c\u7f8e\u3002\u53e6\u4e00\u79cd\u6280\u672f\u662f\u77ed\u4fc3\u800c\u6709\u63a7\u5236\u7684\u8fde\u5c04\u3002\u8fde\u5c04\u53ef\u4ee5\u51cf\u8f7b\u53cd\u540e\u5750\u529b\u5e76\u63d0\u9ad8\u7cbe\u5ea6\uff0c\u5c24\u5176\u662f\u5728\u8f83\u957f\u7684\u8ddd\u79bb\u4e0a\u3002\u8fd9\u4e0e\u6c7d\u8f66\u53d1\u52a8\u673a\u975e\u5e38\u76f8\u4f3c\uff1b\u66f4\u77ed\u7684\u51b2\u523a\u53ef\u4ee5\u8282\u7701\u71c3\u6cb9\u5e76\u51cf\u5c11\u78e8\u635f\uff01"}, {"question": "\u4e3a\u4ec0\u4e48Paint Strike\u7684\u5339\u914d\u7cfb\u7edf\u6709\u65f6\u4f1a\u51fa\u73b0\u4e0d\u5e73\u8861\u73b0\u8c61\uff0c\u54ea\u4e9b\u56e0\u7d20\u5bfc\u81f4\u4e86\u8fd9\u4e9b\u611f\u77e5\u7684\u5dee\u5f02\uff1f", "answer": "\u4e0e\u4efb\u4f55\u7ade\u6280\u7cfb\u7edf\u4e00\u6837\uff0cPaint Strike\u7684\u5339\u914d\u7cfb\u7edf\u6709\u65f6\u53ef\u80fd\u4f1a\u51fa\u73b0\u4e0d\u5e73\u8861\uff0c\u539f\u56e0\u6709\u5f88\u591a\u3002\u5339\u914d\u7cfb\u7edf\u4e3b\u8981\u8003\u8651\u73a9\u5bb6\u7684\u6280\u80fd\u7b49\u7ea7\uff08\u4f8b\u5982Elo\u6216MMR\uff09\uff0c\u4f46\u5176\u4ed6\u56e0\u7d20\uff0c\u4f8b\u5982\u6392\u961f\u65f6\u95f4\u3001\u5ef6\u8fdf\u548c\u961f\u4f0d\u89c4\u6a21\uff0c\u4e5f\u626e\u6f14\u7740\u89d2\u8272\u3002\u66f4\u957f\u7684\u6392\u961f\u65f6\u95f4\u53ef\u80fd\u4f1a\u5bfc\u81f4\u66f4\u5927\u7684\u6280\u80fd\u5dee\u8ddd\uff0c\u4ee5\u786e\u4fdd\u53ca\u65f6\u627e\u5230\u6bd4\u8d5b\uff0c\u800c\u5c1d\u8bd5\u5c06\u62e5\u6709\u8f83\u4f4e\u5ef6\u8fdf\u7684\u73a9\u5bb6\u7ec4\u5408\u5230\u4e00\u8d77\u53ef\u80fd\u4f1a\u5bfc\u81f4\u961f\u4f0d\u4e0d\u5e73\u8861\u3002\u5c06\u5b8c\u6574\u7684\u9884\u7ec4\u961f\u5339\u914d\u5230\u968f\u673a\u5355\u4eba\u6392\u961f\u73a9\u5bb6\u4e5f\u66f4\u96be\u3002\u8003\u8651\u6280\u80fd\u7b49\u7ea7\u7684\u52a8\u6001\u7279\u6027\u662f\u6709\u7528\u7684\uff0c\u8fd9\u53cd\u8fc7\u6765\u4f1a\u5f71\u54cd\u4f60\u5728\u6e38\u620f\u4e2d\u7684\u4f53\u9a8c\u3002\u4f8b\u5982\uff0c\u4e00\u4e2a\u9ad8\u6280\u80fd\u7b49\u7ea7\u7684\u73a9\u5bb6\u4e0e\u4f4e\u6280\u80fd\u7b49\u7ea7\u7684\u73a9\u5bb6\u7ec4\u5408\u5728\u4e00\u8d77\u53ef\u80fd\u4f1a\u6539\u53d8\u6574\u4e2a\u56e2\u961f\u7684\u52a8\u6001\u3002\u6216\u8005\u6362\u53e5\u8bdd\u8bf4\uff0c\u4f53\u80b2\u6bd4\u8d5b\u5e76\u4e0d\u603b\u662f\u516c\u5e73\u7684\u2014\u2014\u4f60\u53ef\u80fd\u6b63\u5728\u548c\u4e00\u53ea\u62e5\u6709\u66f4\u597d\u8fd0\u52a8\u5458\u7684\u961f\u4f0d\u6bd4\u8d5b\u3002\u53ea\u9700\u7ee7\u7eed\u5b8c\u5584\u4f60\u7684\u65b9\u6cd5\u6216\u7ec4\u5efa\u66f4\u5f3a\u7684\u56e2\u961f\u5373\u53ef\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5c06\u6211\u7684Paint Strike\u8fdb\u5ea6\u5728PC\u548c\u79fb\u52a8\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u5417\uff0c\u6216\u8005\u5b83\u4eec\u662f\u72ec\u7acb\u8d26\u6237\uff1f", "answer": "\u76ee\u524d\uff0cPaint Strike\u4e0d\u652f\u6301\u5728PC\u548c\u79fb\u52a8\u5e73\u53f0\u4e4b\u95f4\u8fdb\u884c\u8de8\u5e73\u53f0\u8fdb\u5ea6\u8f6c\u79fb\u3002\u4f60\u7684\u8fdb\u5ea6\u3001\u89e3\u9501\u548c\u8d2d\u4e70\u90fd\u4e0e\u4f60\u83b7\u5f97\u5b83\u4eec\u6240\u4f7f\u7528\u7684\u5e73\u53f0\u7ed1\u5b9a\u3002\u8fd9\u610f\u5473\u7740\uff0c\u5982\u679c\u4f60\u5f00\u59cb\u5728PC\u4e0a\u73a9\u6e38\u620f\uff0c\u4f60\u7684\u8fdb\u5ea6\u4e0d\u4f1a\u8f6c\u79fb\u5230\u79fb\u52a8\u7248\uff0c\u53cd\u4e4b\u4ea6\u7136\u3002\u8fd9\u79cd\u5206\u79bb\u901a\u5e38\u662f\u7531\u4e8e\u5e73\u53f0\u7279\u5b9a\u7684\u529f\u80fd\u3001\u63a7\u5236\u65b9\u6848\u548c\u5546\u5e97\u653f\u7b56\u3002\u7136\u800c\uff0c\u4e00\u4e9b\u6e38\u620f\u63d0\u4f9b\u5e10\u6237\u94fe\u63a5\u529f\u80fd\uff0c\u5141\u8bb8\u73a9\u5bb6\u4e92\u76f8\u4e92\u52a8\u3002\u4f46\u90a3\u5e76\u4e0d\u4e00\u5b9a\u7b49\u4e8e\u8fdb\u5ea6\u4e00\u81f4\u6027\u3002\u8bf7\u7ecf\u5e38\u67e5\u770b\u793e\u533a\u8ba8\u8bba\u677f\uff0c\u4ee5\u9632\u5f00\u53d1\u4eba\u5458\u5728\u6b64\u95ee\u9898\u4e0a\u6dfb\u52a0\u4efb\u4f55\u66f4\u65b0\u3002"}, {"question": "Paint Strike\u5f69\u86cb\uff1aPaint Strike\u4e2d\u6709\u54ea\u4e9b\u6700\u9177\u7684\u9690\u85cf\u5f69\u86cb\u6216\u79d8\u5bc6\uff0c\u4ee5\u53ca\u4f5c\u4e3a\u73a9\u5bb6\u6211\u8be5\u5982\u4f55\u89e6\u53d1\u5b83\u4eec\uff1f", "answer": "Paint Strike\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u5f69\u86cb\u548c\u79d8\u5bc6\u3002\u4e00\u4e2a\u5f69\u86cb\u6d89\u53ca\u5728\u201c\u57ce\u5e02\u7a81\u51fb\u201d\u5730\u56fe\u4e0a\u627e\u5230\u9690\u85cf\u7684\u55b7\u6f06\u7f50\u3002\u5730\u56fe\u201c\u57ce\u5e02\u7a81\u51fb\u201d\u4e2d\u9690\u85cf\u4e86\u4e03\u4e2a\u55b7\u6f06\u7f50\uff0c\u9690\u85cf\u5728\u5404\u4e2a\u9690\u853d\u7684\u5730\u65b9\u3002\u6536\u96c6\u6240\u6709\u4e03\u4e2a\u55b7\u6f06\u7f50\uff0c\u53ef\u4ee5\u89e3\u9501\u6e38\u620f\u4e2d\u4f7f\u7528\u7684\u9690\u85cf\u6d82\u9e26\u6807\u8bb0\u3002\u53e6\u4e00\u4e2a\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u6d89\u53ca\u5728\u201c\u5e9f\u5f03\u5de5\u5382\u201d\u5730\u56fe\u4e0a\u6fc0\u6d3b\u9690\u85cf\u7684\u65e0\u7ebf\u7535\u9891\u7387\u3002\u901a\u8fc7\u4e0e\u8fd9\u4e2a\u7535\u8111\u7cfb\u7edf\u8fdb\u884c\u4ea4\u4e92\uff0c\u4f60\u53ef\u4ee5\u4f20\u8f93\u9690\u85cf\u7684\u65e0\u7ebf\u7535\u9891\u7387\u3002\u8fd9\u5c06\u89e3\u9501\u9690\u85cf\u7684\u97f3\u9891\u65e5\u5fd7\uff0c\u8be5\u65e5\u5fd7\u4e3a\u6e38\u620f\u4e16\u754c\u63d0\u4f9b\u4e86\u5f15\u4eba\u5165\u80dc\u7684\u80cc\u666f\u6545\u4e8b\u3002\u8fd9\u4e9b\u7ec6\u8282\u8ba9\u60a8\u66f4\u6df1\u5165\u5730\u6c89\u6d78\u5728\u6e38\u620f\u7684\u5927\u73af\u5883\u4e2d\uff0c\u589e\u6dfb\u4e86\u6e38\u620f\u4ef7\u503c\uff01"}]
[{"question": "\ud398\uc778\ud2b8 \uc2a4\ud2b8\ub77c\uc774\ud06c 101: \ucd08\ubcf4 \ud50c\ub808\uc774\uc5b4\ub85c\uc11c \ud6a8\uacfc\uc801\uc778 \uc870\uc900 \ubc0f \uc0ac\uaca9 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub85c\uc11c \ud6a8\uacfc\uc801\uc778 \uc870\uc900 \ubc0f \uc0ac\uaca9\uc740 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uba3c\uc800, \uc635\uc158 \uba54\ub274\uc5d0\uc11c \uc790\uc2e0\uc758 \ubbfc\uac10\ub3c4 \uc124\uc815\uc744 \uc870\uc815\ud558\uc5ec \ud3b8\uc548\ud55c \uc218\uc900\uc744 \ucc3e\uc73c\uc2ed\uc2dc\uc624. \uc77c\ubc18\uc801\uc73c\ub85c \uc57d\uac04 \ub0ae\uc740 \ubbfc\uac10\ub3c4\uac00 \ub354 \ub098\uc740 \uc815\ud655\uc131\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc0ac\uaca9 \uc2dc, \uc0c1\ub300\ubc29\uc758 \uc774\ub3d9\uc744 \uc608\uce21\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc0c1\ub300\ubc29\uc774 \uc67c\ucabd\uc73c\ub85c \uc774\ub3d9\ud558\uace0 \uc788\ub2e4\uba74, \uc774\ub3d9 \uc2dc\uac04\uc744 \uace0\ub824\ud558\uc5ec \uc67c\ucabd \uc57d\uac04 \uc55e\uc5d0 \uc870\uc900\ud558\uc2ed\uc2dc\uc624. \ub2e4\uc591\ud55c \ubb34\uae30\ub294 \uc11c\ub85c \ub2e4\ub978 \ubd84\uc0b0 \ud328\ud134\uc744 \uac00\uc9c0\uace0 \uc788\uc74c\uc744 \uae30\uc5b5\ud558\uc2ed\uc2dc\uc624! \uac01 \ubb34\uae30\uc758 \ud6a8\uacfc\uc801\uc778 \uc0ac\uac70\ub9ac\ub97c \ud30c\uc545\ud574\ubcf4\uc2ed\uc2dc\uc624. \ubc84\uc2a4\ud2b8 \ubc1c\uc0ac\uc640 \uc790\ub3d9 \ubc1c\uc0ac\ub97c \uc2dc\ub3c4\ud558\uc5ec \ubd84\uc0b0\uc744 \uc774\ud574\ud558\uc2ed\uc2dc\uc624. \ub9c8\uc9c0\ub9c9\uc73c\ub85c, \uc5f0\uc2b5\uc774 \uc644\ubcbd\uc744 \ub9cc\ub4ed\ub2c8\ub2e4. \ud6c8\ub828 \ubaa8\ub4dc\uc5d0\uc11c \uc2dc\uac04\uc744 \ud560\uc560\ud558\uc5ec \uae30\uc220\uc744 \uc5f0\ub9c8\ud558\uc2ed\uc2dc\uc624. \ud29c\ud1a0\ub9ac\uc5bc\uc5d0\uc11c \uc81c\uc548\ud558\ub294 \uac83\ucc98\ub7fc, \uc790\uc2e0\uacfc \uc790\ub3d9 \ud0c0\uac9f \uc0ac\uc774\uc758 \uac70\ub9ac\ub97c \ub2e4\uc591\ud654\ud558\uace0, 3\ubbf8\ud130\uc5d0\uc11c 10\ubbf8\ud130 \uc0ac\uc774\uc758 \uac70\ub9ac\ub97c \uc5f0\uc2b5\ud574\ubcf4\uc2ed\uc2dc\uc624."}, {"question": "\ud398\uc778\ud2b8 \uc2a4\ud2b8\ub77c\uc774\ud06c\uc758 \ub2e4\uc591\ud55c \ubb34\uae30 \uc720\ud615\uc740 \ubb34\uc5c7\uc774\uba70, \ucd08\ubcf4 \ud50c\ub808\uc774\uc5b4\ub85c\uc11c \uae30\ubcf8\uc801\uc778 \uc774\ud574\ub97c \ub3d5\uae30 \uc704\ud574 \ucd08\uae30\uc5d0 \uc5b4\ub5a4 \ubb34\uae30\ub97c \uc120\ud0dd\ud574\uc57c \ud560\uae4c\uc694?", "answer": "\ud398\uc778\ud2b8 \uc2a4\ud2b8\ub77c\uc774\ud06c\ub294 SMG\ubd80\ud130 \uc800\uaca9 \uc18c\ucd1d\uae4c\uc9c0 \ub2e4\uc591\ud55c \ubb34\uae30\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ucd08\ubcf4 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c\ub294 \ub3cc\uaca9 \uc18c\ucd1d(AR)\uc744 \ucd94\ucc9c\ud569\ub2c8\ub2e4. AR\uc740 \uc0ac\uac70\ub9ac, \uc815\ud655\ub3c4, \ub370\ubbf8\uc9c0\uc758 \uade0\ud615\uc744 \uc81c\uacf5\ud558\uc5ec \ubc30\uc6b0\uae30 \uc26c\uc6b4 \ud559\uc2b5 \uace1\uc120\uc744 \ub9cc\ub4ed\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'M4' \ub3cc\uaca9 \uc18c\ucd1d\uc740 \uc0ac\uc6a9\ud558\uae30 \uc27d\uace0 \ub2e4\uc7ac\ub2e4\ub2a5\ud569\ub2c8\ub2e4. \uc774\ub97c \uc0ac\uc6a9\ud558\uba74 \uc804\ubb38\uc801\uc778 \uba54\ucee4\ub2c8\uc998\uc5d0 \uc555\ub3c4\ub418\uc9c0 \uc54a\uace0 \ud575\uc2ec \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub098\uc911\uc5d0 \ub354 \ub9ce\uc740 \uacbd\ud5d8\uc744 \uc313\uc73c\uba74 \uac01 \ubb34\uae30\uc758 \ub370\ubbf8\uc9c0 \uc2a4\ud0ef\uc774 \ub2e4\ub974\uac8c \ubcf4\uc774\uaca0\uc9c0\ub9cc, \ucc98\uc74c \uba87 \uc2dc\uac04 \ub3d9\uc548 \uae30\ubcf8\uc801\uc778 \uac8c\uc784 \ud50c\ub808\uc774 \ub8e8\ud504\ub97c \ub9c8\uc2a4\ud130\ud560 \ub54c\uae4c\uc9c0 M4\ub97c \uc0ac\uc6a9\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \uccb4\uc2a4\ub97c \ubc30\uc6b0\ub294 \uac83\uacfc \ube44\uc2b7\ud569\ub2c8\ub2e4. \ub098\uc911\uc5d0 \uc2e4\ud5d8\ud560 \uc218\ub294 \uc788\uc9c0\ub9cc, \ucd08\ubcf4\uc790\ub294 \uc798 \uc815\uc758\ub420 \ub54c\uae4c\uc9c0 \uae30\ubcf8\uc801\uc778 \uc624\ud504\ub2dd\uc744 \ubc18\ubcf5\uc801\uc73c\ub85c \ud50c\ub808\uc774\ud574\uc57c \ud569\ub2c8\ub2e4."}, {"question": "\ud398\uc778\ud2b8 \uc2a4\ud2b8\ub77c\uc774\ud06c \uae30\ubcf8 \uc0ac\ud56d: \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \ud754\ud788 \uc800\uc9c0\ub974\ub294 \uc2e4\uc218\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud53c\ud558\uba74 \ub354 \ube68\ub9ac \uac1c\uc120\ud560 \uc218 \uc788\uc744\uae4c\uc694?", "answer": "\uc0c8\ub85c\uc6b4 \ud398\uc778\ud2b8 \uc2a4\ud2b8\ub77c\uc774\ud06c \ud50c\ub808\uc774\uc5b4\ub294 \uc885\uc885 \uc804\uc220\uc801 \uc778\uc2dd \uc5c6\uc774 \uad50\uc804\uc5d0 \ub6f0\uc5b4\ub4e4\uace0, \uc801\uc808\ud558\uac8c \uc9c0\ud615\uc744 \ud65c\uc6a9\ud558\uc9c0 \uc54a\uace0, \ubbf8\ub2c8\ub9f5\uc744 \ubb34\uc2dc\ud558\ub294 \uacbd\ud5a5\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ub354 \ube68\ub9ac \uac1c\uc120\ud558\ub824\uba74 \uc774\ub7ec\ud55c \ud568\uc815\uc744 \ud53c\ud558\uc2ed\uc2dc\uc624. \uccab\uc9f8, \uc801\uacfc \uad50\uc804\ud558\uae30 \uc804\uc5d0 \ud56d\uc0c1 \uc8fc\ubcc0 \ud658\uacbd\uc744 \ud3c9\uac00\ud558\uc2ed\uc2dc\uc624. \ud0c8\ucd9c \uacbd\ub85c\ub098 \uac00\uae4c\uc6b4 \uc9c0\ud615\uc744 \ud655\ubcf4\ud558\uc2ed\uc2dc\uc624. \ub458\uc9f8, \uc9c0\ud615\uc744 \uc801\uc808\ud788 \ud65c\uc6a9\ud558\uba74 \uc0dd\uc874 \uac00\ub2a5\uc131\uc774 \ud06c\uac8c \ub192\uc544\uc9d1\ub2c8\ub2e4. \uc9c0\ud615 \uc9c0\uc810 \uc0ac\uc774\ub97c \ube60\ub974\uac8c \uc774\ub3d9\ud558\ub294 \uc5f0\uc2b5\uc744 \ud558\uc138\uc694. \ub9c8\uc9c0\ub9c9\uc73c\ub85c, \ubbf8\ub2c8\ub9f5\uc744 \ud1b5\ud574 \uc801\uc758 \uc704\uce58\uc640 \ub3d9\ub8cc\uc758 \uc704\uce58\ub97c \ud30c\uc545\ud558\uace0 \uc720\uc6a9\ud55c \uc815\ubcf4\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'Dust2'\uc758 \ubbf8\ub2c8\ub9f5\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub294 \ud56d\uc0c1 B\uc0ac\uc774\ud2b8 \ud130\ub110\uc5d0 \uc8fc\uc758\ud574\uc57c \ud558\uba70, \uc801\uc758 \ubc30\uce58\ub97c \ud56d\uc0c1 \ud30c\uc545\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud301\uc744 \uc9c0\uc18d\uc801\uc73c\ub85c \uc801\uc6a9\ud558\uba74 \ud559\uc2b5 \uace1\uc120\uc774 \uae09\uaca9\ud558\uac8c \ub2e8\ucd95\ub420 \uac83\uc785\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uace0\ub824 \uc0ac\ud56d\uc740 \uad50\ucc28\uc120 \uc704\uce58\uc785\ub2c8\ub2e4. \uc801\uc774 \uc7a0\uae50 \ub4e4\uc5ec\ub2e4\ubcfc \uc218 \uc788\ub294 \uacf3\uc5d0 \uc870\uc900\ud558\uc2ed\uc2dc\uc624. \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\uae30 \uc704\ud55c \uc720\uc6a9\ud55c \uad50\ucc28\uc120 \uc124\uc815\uc744 \ucc38\uace0\ud558\uc2ed\uc2dc\uc624."}, {"question": "\uace0\uae09 \ud398\uc778\ud2b8 \uc2a4\ud2b8\ub77c\uc774\ud06c: \uad50\uc804\uc5d0\uc11c \uc774\uc810\uc744 \uc5bb\uae30 \uc704\ud574 \uc2a4\ud2b8\ub798\ud551\uacfc \uc2ac\ub77c\uc774\ub529\uacfc \uac19\uc740 \uc774\ub3d9 \uae30\uc220\uc744 \ub9c8\uc2a4\ud130\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud398\uc778\ud2b8 \uc2a4\ud2b8\ub77c\uc774\ud06c\uc5d0\uc11c \uc2a4\ud2b8\ub798\ud551\uacfc \uc2ac\ub77c\uc774\ub529\uacfc \uac19\uc740 \uc774\ub3d9 \uae30\uc220\uc744 \ub9c8\uc2a4\ud130\ud558\ub294 \uac83\uc740 \uacbd\ud5d8 \ub9ce\uc740 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc774\uc810\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc2a4\ud2b8\ub798\ud551\uc740 \uc0ac\uaca9\uc744 \ud558\uba74\uc11c \uc88c\uc6b0\ub85c \uc6c0\uc9c1\uc774\ub294 \uac83\uc744 \ub9d0\ud558\uba70, \uc774\ub294 \uc815\ud655\ud788 \ud0c0\uac9f\ud305\ud558\uae30\uac00 \uc5b4\ub835\uac8c \ub9cc\ub4e4\uc5b4\uc90d\ub2c8\ub2e4. \uc2ac\ub77c\uc774\ub529\uc740 \uac70\ub9ac\ub97c \ube60\ub974\uac8c \uc881\ud788\uac70\ub098 \uc801\uc758 \uacf5\uaca9\uc73c\ub85c\ubd80\ud130 \ud53c\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. \ub2e4\uc74c\uc740 \ub2e8\uacc4\ubcc4 \uac00\uc774\ub4dc\uc785\ub2c8\ub2e4: 1\ub2e8\uacc4: \uc2a4\ud2b8\ub798\ud551 \uc5f0\uc2b5: \uc870\uc900\uc744 \uc720\uc9c0\ud558\uba74\uc11c 'A'(\uc67c\ucabd \uc2a4\ud2b8\ub798\ud551) \ubc0f 'D'(\uc624\ub978\ucabd \uc2a4\ud2b8\ub798\ud551) \ud0a4\ub97c \ubc88\uac08\uc544 \ub204\ub974\uc2ed\uc2dc\uc624. 2\ub2e8\uacc4: \uc2ac\ub77c\uc774\ub529 \ud3ec\ud568: \uc801\uc744 \uae30\uc2b5\ud558\uae30 \uc704\ud574 \uc0ac\uaca9 \uc911\uc5d0 \uc9c0\ud615 \ub4a4\ub85c \uc2ac\ub77c\uc774\ub4dc\ud569\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc778 \uc804\ub7b5\uc740 \uc7ac\uc7a5\uc804\ud558\ub294 \ub3d9\uc548 \uc0c1\uc790 \ub4a4\ub85c \uc2ac\ub77c\uc774\ub529\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. 3\ub2e8\uacc4: \uc2a4\ud2b8\ub798\ud551\uacfc \uc2ac\ub77c\uc774\ub529 \uc870\ud569: \uc774 \ub450 \uae30\uc220\uc744 \ud568\uaed8 \uc0ac\uc6a9\ud558\uc5ec \uc6c0\uc9c1\uc784\uc774 \ube60\ub978 \ud0c0\uac9f\uc774 \ub418\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, 'Inferno'\uc758 'T' \uc2a4\ud3f0\uc740 \ud53c\ud560 \uc218 \uc788\ub294 \ucd5c\ub300 \ubc94\uc704\ub97c \uadf9\ub300\ud654\ud558\uba74\uc11c \uc911\uc559\uc73c\ub85c \ube60\ub974\uac8c \uc774\ub3d9\ud558\uae30 \uc704\ud574 \uc2ac\ub77c\uc774\ub4dc\uc640 \uc2a4\ud2b8\ub798\ud551\uc744 \ud63c\ud569\ud558\uc5ec \uc811\uadfc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\uac83\uc740 \uc5f0\uc2b5\uc774 \ud544\uc694\ud558\uc9c0\ub9cc \uc804\ud22c \ud6a8\uc728\uc131\uc744 \ud06c\uac8c \ub192\uc5ec\uc90d\ub2c8\ub2e4. \ud0a4 \ubc14\uc778\ub529\uc744 \ucd5c\uc801\ud654\ud558\uc5ec \uc6c0\uc9c1\uc784\uc744 \uac00\ub2a5\ud55c \ubd80\ub4dc\ub7fd\uac8c \ud574 \uc8fc\uc2ed\uc2dc\uc624!"}, {"question": "\ud398\uc778\ud2b8 \uc2a4\ud2b8\ub77c\uc774\ud06c\uc758 \uace0\uae09 \ud300 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc774\uba70, \uac8c\uc784 \ub0b4\uc5d0\uc11c \ud300\uc6d0\ub4e4\uacfc \ud6a8\uacfc\uc801\uc73c\ub85c \uc18c\ud1b5\ud558\uc5ec \uc774\ub97c \uad6c\ud604\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud398\uc778\ud2b8 \uc2a4\ud2b8\ub77c\uc774\ud06c\uc758 \uace0\uae09 \ud300 \uc804\ub7b5\uc5d0\ub294 \uc870\uc815\ub41c \uacf5\uaca9, \uc804\ub7b5\uc801\uc778 \uc9c0\uc5ed \uc81c\uc5b4 \ubc0f \ud6a8\uc728\uc801\uc778 \uc790\uc6d0 \uad00\ub9ac\uac00 \ud3ec\ud568\ub429\ub2c8\ub2e4. \ud6a8\uacfc\uc801\uc778 \uc758\uc0ac\uc18c\ud1b5\uc740 \uc774\ub7ec\ud55c \uc804\ub7b5\uc744 \uc2e4\ud589\ud558\ub294 \ub370 \uc911\uc694\ud569\ub2c8\ub2e4. \ubc29\ubc95\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: 1\ub2e8\uacc4: \uba85\ud655\ud55c \uc5ed\ud560 \uc124\uc815: \uac01 \ud300\uc6d0\uc5d0\uac8c \uc5d4\ud2b8\ub9ac \ud504\ub798\uac70, \uc9c0\uc6d0 \ubc0f \uc800\uaca9\uc218\uc640 \uac19\uc740 \uc5ed\ud560\uc744 \ud560\ub2f9\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \uac04\uacb0\ud55c \ud638\ucd9c \uc0ac\uc6a9: 'Dust2'\uc758 'A \uae34' \ub610\ub294 'Mirage'\uc758 '\ucea3\uc6d4\ud06c'\uc640 \uac19\uc774 \ud2b9\uc815 \uc704\uce58 \uc774\ub984\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc801\uc758 \uc704\uce58\uc640 \uc758\ub3c4\ub97c \uc804\ub2ec\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \uc870\uc815\ub41c \uacf5\uaca9 \uacc4\ud68d: \uc801\uc744 \uc555\ub3c4\ud558\uae30 \uc704\ud574 \uacf5\uaca9\uc744 \ub3d9\uae30\ud654\ud569\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc778 \uc811\uadfc \ubc29\uc2dd\uc740 \uc5d4\ud2b8\ub9ac \ud504\ub798\uac70\uac00 \ub3cc\uaca9\uc744 \uc774\ub04c\uace0, \ub3d9\ub8cc\uac00 \uc9c0\uc6d0 \uc0ac\uaca9 \ubc0f \uc720\ud2f8\ub9ac\ud2f0 \uc544\uc774\ud15c\uc744 \ubc30\ud3ec\ud558\uc5ec \uc9c0\uc6d0\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc5b4\ub5a4 \ud300 \uc2a4\ud3ec\uce20\uc5d0\uc11c\ub098 \uc758\uc0ac\uc18c\ud1b5\uc774 \ubaa8\ub4e0 \uac83\uc744 \uacb0\uc815\ud558\ub4ef \ud398\uc778\ud2b8 \uc2a4\ud2b8\ub77c\uc774\ud06c\uc5d0\uc11c\ub3c4 \ub9c8\ucc2c\uac00\uc9c0\uc785\ub2c8\ub2e4. \uba85\ud655\ud558\uace0 \uad6c\uccb4\uc801\uc778 \uc758\uc0ac\uc18c\ud1b5\uacfc \uba85\ud655\ud558\uac8c \uc815\uc758\ub41c \uc804\ub7b5\uc740 \ud300\uc5d0 \uba85\ud655\ud55c \uc774\uc810\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc190\uc2e4\uc5d0 \ub300\ud55c \ube0c\ub9ac\ud551\ub3c4 \uc78a\uc9c0 \ub9c8\uc2ed\uc2dc\uc624!"}, {"question": "\uacbd\uc7c1\uc5d0\uc11c \uc6b0\uc704\ub97c \uc810\ud558\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \ub85c\ub4dc\uc544\uc6c3 \uad6c\uc131 \ubc0f \uacbd\uc81c \uad00\ub9ac \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub192\uc740 \uc218\uc900\uc758 \ud398\uc778\ud2b8 \uc2a4\ud2b8\ub77c\uc774\ud06c \ud50c\ub808\uc774\uc5d0 \uc788\uc5b4 \uc131\uacf5\uc801\uc778 \uacbd\uc81c \uad00\ub9ac\uac00 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc778 \uc811\uadfc \ubc29\uc2dd\uc740 \uac1c\ubcc4 \ubb34\uae30 \uad6c\ub9e4\uc640 \ud300\uc758 \uc694\uad6c\ub97c \uade0\ud615\uc788\uac8c \ub9de\ucd94\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub77c\uc6b4\ub4dc\uc5d0\uc11c \uc2b9\ub9ac\ud55c \ud6c4, \ud6c4\uc18d \ub77c\uc6b4\ub4dc\ub97c \uc704\ud55c \uc790\uae08 \ub9c8\ub828\uc744 \uc704\ud574 \ubd80\ubd84 \uad6c\ub9e4 (\uc608: SMG \ubc0f \uc7a5\uac11)\ub97c \uace0\ub824\ud558\uc2ed\uc2dc\uc624. \ub610\ud55c \uc7ac\uc815\uc774 \ubd80\uc871\ud55c \ub3d9\ub8cc\uc640 \ubb34\uae30\ub97c \uad50\ud658\ud558\ub294 \ubc95\uc744 \ubc30\uc6b0\uc2ed\uc2dc\uc624. \ub85c\ub4dc\uc544\uc6c3\uc758 \uacbd\uc6b0, \ubb34\uae30 \uc120\ud0dd\uc740 \uc5ed\ud560\uacfc \uc9c0\ub3c4\uc5d0 \ub9de\ucdb0\uc57c \ud569\ub2c8\ub2e4. \uc800\uaca9\uc218\ub294 AWP\uc640 \uac19\uc740 \uc7a5\uac70\ub9ac \uc18c\ucd1d\uc744 \uc6d0\ud558\ub294 \ub3d9\uc548 \uc5d4\ud2b8\ub9ac \ud504\ub798\uac70\ub294 M4\ub098 AK-47\uc640 \uac19\uc740 \ub2e4\uc7ac\ub2e4\ub2a5\ud55c \ubb34\uae30\ub97c \uc120\ud0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc0bc\ucc28 \ubb34\uae30\ub294 \uc9e7\uc740 \uc2dc\uac04\uc5d0 \uc7ac\uc7a5\uc804 \uac00\ub2a5\ud55c \ub192\uc740 \uc720\ud2f8\ub9ac\ud2f0\ub97c \uac00\uc9c4 Glock\uc774 \uc801\ud569\ud569\ub2c8\ub2e4. \uc774\uc0c1\uc801\uc778 \ub85c\ub4dc\uc544\uc6c3\uc740 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uacfc \ud300 \uc5ed\ud559\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4. \ubaa8\ub4e0 \uc194\ub8e8\uc158\uc774 \uc801\ud569\ud558\uc9c0\ub294 \uc54a\uc2b5\ub2c8\ub2e4. \uc774 \ube44\uad50 \ucc28\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc5ec \uac8c\uc784 \uc804\uccb4\uc5d0\uc11c \uacbd\uc81c\ub97c \ucd5c\uc801\ud654\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4."}, {"question": "\ud398\uc778\ud2b8 \uc2a4\ud2b8\ub77c\uc774\ud06c\uc5d0\uc11c \ubb34\uae30 \ud6c4\ud1f4\ub294 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uac8c\uc784 \ub0b4 \uba54\ucee4\ub2c8\uc998\uc744 \ud1b5\ud574 \uc774\ub97c \uadf9\ubcf5\ud558\uace0 \uc644\ubcbd\ud55c \uc815\ud655\ub3c4\ub97c \ub2ec\uc131\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud398\uc778\ud2b8 \uc2a4\ud2b8\ub77c\uc774\ud06c\uc5d0\uc11c \ubb34\uae30 \ud6c4\ud1f4\ub294 \ud50c\ub808\uc774\uc5b4\uc758 \uae30\uc220\uc744 \uc2dc\ud5d8\ud558\ub3c4\ub85d \uc124\uacc4\ub41c \ubcf5\uc7a1\ud55c \uc2dc\uc2a4\ud15c\uc785\ub2c8\ub2e4. \uac01 \ubb34\uae30\ub294 \uace0\uc720\ud55c \ud6c4\ud1f4 \ud328\ud134\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc73c\ub85c \ucd08\uae30 \ud6c4\ud1f4\ub294 \uc218\uc9c1\uc774\uba70, \uc774\uc5b4\uc11c \uc218\ud3c9\uc73c\ub85c \ud754\ub4e4\ub9bd\ub2c8\ub2e4. \ud6c4\ud1f4\ub97c \uc81c\uc5b4\ud558\ub294 \ubc95\uc744 \ubc30\uc6b0\ub824\uba74 \uc218\uc9c1 \uc0c1\uc2b9\uc744 \uc0c1\uc1c4\ud558\uae30 \uc704\ud574 \ub9c8\uc6b0\uc2a4\ub97c \uc544\ub798\ub85c \ub2f9\uae30\uace0 \uc218\ud3c9 \ub4dc\ub9ac\ud504\ud2b8\ub97c \ubcf4\uc0c1\ud574\uc57c \ud569\ub2c8\ub2e4. \uc77c\ubd80 \ubb34\uae30\ub294 \uc608\uce21 \uac00\ub2a5\ud55c \ud328\ud134\uc744 \uac00\uc9c0\uace0 \uc788\uc9c0\ub9cc, \ub2e4\ub978 \ubb34\uae30\ub294 \ub354 \ubb34\uc791\uc704\uc801\uc785\ub2c8\ub2e4. \uac8c\uc784 \ub0b4 \uba54\ucee4\ub2c8\uc998\uc744 \ud1b5\ud574 \ud6c4\ud1f4\ub97c \uc644\uc804\ud788 \uc81c\uac70\ud560 \uc218 \uc788\ub294 \ubc29\ubc95\uc740 \uc5c6\uc2b5\ub2c8\ub2e4. \uc9d1\uc911\ud574\uc57c \ud560 \uc810\uc740 \ud6c4\ud1f4 \ubcf4\uc0c1\uc744 \ub9c8\uc2a4\ud130\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, AK-47\ub294 \ub3c5\ud2b9\ud55c 'T'\uc790\ud615 \ud6c4\ud1f4 \ud328\ud134\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc77c\uad00\ub41c \ud5e4\ub4dc\uc0f7\uc744 \uc704\ud574 \uc774\ub97c \ub9c8\uc2a4\ud130\ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc774 \uba54\ucee4\ub2c8\uc998 \ub0b4\uc5d0\uc11c \uc5f0\uc2b5\uc774 \uc644\ubcbd\uc744 \ub9cc\ub4ed\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uae30\uc220\uc740 \uc9e7\uace0 \uc81c\uc5b4\ub41c \ubc84\uc2a4\ud2b8\ub97c \uc0ac\uc6a9\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \ubc84\uc2a4\ud2b8 \ubc1c\uc0ac\ub294 \ud6c4\ud1f4\ub97c \uc644\ud654\ud558\uace0 \uc815\ud655\uc131\uc744 \ub192\uc77c \uc218 \uc788\uc73c\ubbc0\ub85c, \ud2b9\ud788 \uc7a5\uac70\ub9ac\uc5d0\uc11c \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. \uc774\ub294 \uc790\ub3d9\ucc28 \uc5d4\uc9c4\uacfc \ub9e4\uc6b0 \uc720\uc0ac\ud569\ub2c8\ub2e4. \uc9e7\uc740 \ubc84\uc2a4\ud2b8\ub294 \uc5f0\ub8cc\ub97c \uc808\uc57d\ud558\uace0 \ub9c8\ubaa8\ub97c \uc904\uc785\ub2c8\ub2e4."}, {"question": "\ud398\uc778\ud2b8 \uc2a4\ud2b8\ub77c\uc774\ud06c\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc774 \ub54c\ub54c\ub85c \ubd88\uade0\ud615\uc801\uc73c\ub85c \ubcf4\uc774\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc774\ub7ec\ud55c \uc778\uc2dd\ub41c \ubd88\uade0\ud615\uc5d0 \uae30\uc5ec\ud558\ub294 \uc694\uc778\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud398\uc778\ud2b8 \uc2a4\ud2b8\ub77c\uc774\ud06c\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5a4 \uacbd\uc7c1 \uc2dc\uc2a4\ud15c\uacfc \ub9c8\ucc2c\uac00\uc9c0\ub85c \ud50c\ub808\uc774\uc5b4\uc758 \uc219\ub828\ub3c4 \ub4f1\uae09 (\uc608: \uc5d8\ub85c \ub610\ub294 MMR)\uc744 \uc8fc\ub85c \uace0\ub824\ud558\uc9c0\ub9cc \ub300\uae30 \uc2dc\uac04, \ud551 \ubc0f \ud30c\ud2f0 \ud06c\uae30\uc640 \uac19\uc740 \ub2e4\ub978 \uc694\uc778\ub3c4 \uc5ed\ud560\uc744 \ud569\ub2c8\ub2e4. \ub300\uae30 \uc2dc\uac04\uc774 \uae38\uc5b4\uc9c8\uc218\ub85d \ub9e4\uce58\ub97c \uc2e0\uc18d\ud558\uac8c \ucc3e\uae30 \uc704\ud574 \ub354 \ub113\uc740 \uae30\uc220 \uaca9\ucc28\uac00 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc73c\uba70, \ub0ae\uc740 \ud551\uc744 \uac00\uc9c4 \ud50c\ub808\uc774\uc5b4\ub97c \uadf8\ub8f9\ud654\ud558\ub824\ub294 \uc2dc\ub3c4\ub294 \ubd88\uade0\ud615\uc801\uc778 \ud300\uc744 \ucd08\ub798\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 5\uba85\uc758 \uc644\uc804\ud55c \uc0ac\uc804 \uad6c\uc131\ub41c \ud300\uacfc \ub79c\ub364 \uc194\ub85c \ud050 \ud50c\ub808\uc774\uc5b4\ub97c \ub9e4\uce6d\ud558\ub294 \uac83\uc774 \ub354 \uc5b4\ub824\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc219\ub828\ub3c4 \ub4f1\uae09\uc758 \uc5ed\ub3d9\uc801\uc778 \ud2b9\uc131\uc744 \uace0\ub824\ud560 \ud544\uc694\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub294 \uace7 \uac8c\uc784 \uacbd\ud5d8\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub192\uc740 \uc2e4\ub825\uc758 \ud50c\ub808\uc774\uc5b4\uac00 \ub0ae\uc740 \uc2e4\ub825\uc758 \ud50c\ub808\uc774\uc5b4\uc640 \uadf8\ub8f9\ud654\ub420 \uacbd\uc6b0, \uc804\uccb4 \ud300\uc758 \uc5ed\ub3d9\uc131\uc744 \ubcc0\ud654\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ub294 \ub2e4\ub978 \ub9d0\ub85c \ud558\uc790\uba74, \uc2a4\ud3ec\uce20 \uacbd\uc7c1\uc774 \ud56d\uc0c1 \uacf5\uc815\ud558\uc9c0\ub294 \uc54a\uc2b5\ub2c8\ub2e4 \u2013 \ub2e8\uc21c\ud788 \ub354 \ub6f0\uc5b4\ub09c \uc120\uc218\ub97c \uac00\uc9c4 \ud300\uacfc \uacbd\uc7c1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc790\uc2e0\uc758 \uc811\uadfc \ubc29\uc2dd\uc744 \uacc4\uc18d\ud574\uc11c \uac1c\uc120\ud558\uac70\ub098 \ub354 \uac15\ub825\ud55c \uadf8\ub8f9\uc744 \uad6c\uc131\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4."}, {"question": "PC\uc640 \ubaa8\ubc14\uc77c \ud50c\ub7ab\ud3fc \uac04\uc5d0 \ud398\uc778\ud2b8 \uc2a4\ud2b8\ub77c\uc774\ud06c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694, \uc544\ub2c8\uba74 \ubcc4\ub3c4\uc758 \uacc4\uc815\uc778\uac00\uc694?", "answer": "\ud604\uc7ac \ud398\uc778\ud2b8 \uc2a4\ud2b8\ub77c\uc774\ud06c\ub294 PC\uc640 \ubaa8\ubc14\uc77c \ud50c\ub7ab\ud3fc \uac04\uc758 \uc9c4\ud589 \uc0c1\ud669 \uacf5\uc720\ub97c \uc9c0\uc6d0\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc9c4\ud589 \uc0c1\ud669, \uc7a0\uae08 \ud574\uc81c \ubc0f \uad6c\ub9e4\ub294 \ud68d\ub4dd\ud55c \ud50c\ub7ab\ud3fc\uc5d0 \uc5f0\uacb0\ub429\ub2c8\ub2e4. \uc774\ub294 PC\uc5d0\uc11c \ud50c\ub808\uc774\ub97c \uc2dc\uc791\ud558\uba74 \uc9c4\ud589 \uc0c1\ud669\uc774 \ubaa8\ubc14\uc77c \ubc84\uc804\uc73c\ub85c \uc774\uc804\ub418\uc9c0 \uc54a\uc74c\uc744 \uc758\ubbf8\ud558\uba70, \uadf8 \ubc18\ub300\uc758 \uacbd\uc6b0\ub3c4 \ub9c8\ucc2c\uac00\uc9c0\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ubd84\ub9ac\ub294 \ud50c\ub7ab\ud3fc\ubcc4 \uae30\ub2a5, \ucee8\ud2b8\ub864 \ubc29\uc2dd \ubc0f \uc2a4\ud1a0\uc5b4 \uc815\ucc45 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \uc77c\ubd80 \uac8c\uc784\uc740 \uc7a5\uc2dd\ud488\uc774\ub098 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774\ub97c \uc704\ud55c \uacc4\uc815 \uc5f0\uacb0\uc744 \uc81c\uacf5\ud558\uc5ec \ud50c\ub808\uc774\uc5b4\uac00 \uc11c\ub85c \uc0c1\ud638 \uc791\uc6a9\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \uc774\ub294 \uc9c4\ud589 \uc0c1\ud669\uacfc \ub3d9\uc77c\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ubb38\uc81c\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc5c5\ub370\uc774\ud2b8\ub97c \uac1c\ubc1c\uc790\uac00 \ucd94\uac00\ud55c \uacbd\uc6b0\ub97c \ub300\ube44\ud558\uc5ec \ucee4\ubba4\ub2c8\ud2f0 \ud1a0\ub860 \uac8c\uc2dc\ud310\uc744 \uc790\uc8fc \ud655\uc778\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4."}, {"question": "\ud398\uc778\ud2b8 \uc2a4\ud2b8\ub77c\uc774\ud06c \uc774\uc2a4\ud130 \uc5d0\uadf8: \ud398\uc778\ud2b8 \uc2a4\ud2b8\ub77c\uc774\ud06c\uc758 \uba4b\uc9c4 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8 \ub610\ub294 \ube44\ubc00\uc740 \ubb34\uc5c7\uc774\uba70, \ud50c\ub808\uc774\uc5b4\ub85c\uc11c \uc5b4\ub5bb\uac8c \ud574\uc81c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud398\uc778\ud2b8 \uc2a4\ud2b8\ub77c\uc774\ud06c\uc5d0\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uc640 \ube44\ubc00\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\uc2a4\ud130 \uc5d0\uadf8 \uc911 \ud558\ub098\ub294 'Urban Assault' \uc9c0\ub3c4\uc5d0\uc11c \uc228\uaca8\uc9c4 \uc2a4\ud504\ub808\uc774 \uce94\uc744 \ucc3e\ub294 \uac83\uc785\ub2c8\ub2e4. \uc774 \uc9c0\ub3c4\uc5d0\ub294 \ucd1d 7\uac1c\uc758 \uc2a4\ud504\ub808\uc774 \uce94\uc774 \uc9c0\ub3c4 \uacf3\uacf3\uc5d0 \uc228\uaca8\uc838 \uc788\uc2b5\ub2c8\ub2e4. 7\uac1c\uc758 \ubaa8\ub4e0 \uc2a4\ud504\ub808\uc774 \uce94\uc744 \ubaa8\uc73c\uba74 \uac8c\uc784 \ub0b4\uc5d0\uc11c \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uadf8\ub798\ud53c\ud2f0 \ud0dc\uadf8\uac00 \ud574\uc81c\ub429\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uc774\uc2a4\ud130 \uc5d0\uadf8\uc5d0\ub294 '\ud3d0\ud5c8\ub41c \uacf5\uc7a5' \uc9c0\ub3c4\uc5d0\uc11c \uc228\uaca8\uc9c4 \ub77c\ub514\uc624 \uc8fc\ud30c\uc218\ub97c \ud65c\uc131\ud654\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \ucef4\ud4e8\ud130 \uc2dc\uc2a4\ud15c\uacfc \uc0c1\ud638 \uc791\uc6a9\ud558\uba74 \uc228\uaca8\uc9c4 \ub77c\ub514\uc624 \uc8fc\ud30c\uc218\ub97c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub807\uac8c \ud558\uba74 \uac8c\uc784\uc758 \ubc30\uacbd\uc744 \ud765\ubbf8\ub86d\uac8c \ubcf4\uc5ec\uc8fc\ub294 \uc228\uaca8\uc9c4 \uc624\ub514\uc624 \ub85c\uadf8\uac00 \ud574\uc81c\ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc694\uc18c\uac00 \ucd94\uac00\ub418\uc5b4 \uac8c\uc784\uc758 \uc228\uaca8\uc9c4 \uc138\uacc4\ub97c \ub354\uc6b1 \uc990\uac81\uac8c \ud574\uc90d\ub2c8\ub2e4."}]
[{"question": "Paint Strike 101\uff1a\u65b0\u624b\u5728 Paint Strike \u4e2d\u5982\u4f55\u6709\u6548\u7784\u6e96\u548c\u5c04\u64ca\uff1f", "answer": "\u5c0d\u65bc\u65b0\u73a9\u5bb6\u4f86\u8aaa\uff0c\u6709\u6548\u7784\u6e96\u548c\u5c04\u64ca\u81f3\u95dc\u91cd\u8981\u3002\u9996\u5148\uff0c\u8abf\u6574\u9078\u9805\u4e2d\u7684\u611f\u61c9\u5668\u8a2d\u5b9a\uff0c\u627e\u5230\u8212\u9069\u7684\u6c34\u5e73\u3002\u7565\u4f4e\u7684\u611f\u61c9\u5668\u901a\u5e38\u6709\u52a9\u65bc\u63d0\u9ad8\u6e96\u78ba\u6027\u3002\u7576\u5c04\u64ca\u6642\uff0c\u9810\u6e2c\u76ee\u6a19\u7684\u79fb\u52d5\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u7684\u5c0d\u624b\u5411\u5de6\u79fb\u52d5\uff0c\u5247\u5c07\u6e96\u5fc3\u7784\u6e96\u4ed6\u5011\u5de6\u524d\u65b9\uff0c\u4ee5\u5f4c\u88dc\u79fb\u52d5\u6642\u9593\u3002\u8acb\u8a18\u4f4f\uff0c\u4e0d\u540c\u7684\u6b66\u5668\u5177\u6709\u4e0d\u540c\u7684\u5674\u5c04\u6a21\u5f0f\uff01\u5617\u8a66\u627e\u51fa\u6bcf\u7a2e\u6b66\u5668\u7684\u6709\u6548\u5c04\u7a0b\u3002\u5617\u8a66\u4f7f\u7528\u9023\u5c04\u8207\u5168\u81ea\u52d5\u6a21\u5f0f\u4f86\u4e86\u89e3\u6563\u4f48\uff0c\u985e\u4f3c\u65bc\u73fe\u5be6\u4e16\u754c\u4e2d\u72d9\u64ca\u624b\u5982\u4f55\u8abf\u6574\u4ed6\u5011\u7684\u7784\u6e96\u93e1\u3002\u6700\u5f8c\uff0c\u719f\u80fd\u751f\u5de7\uff1b\u82b1\u4e00\u4e9b\u6642\u9593\u5728\u8a13\u7df4\u6a21\u5f0f\u4e2d\u78e8\u7df4\u4f60\u7684\u6280\u80fd\u3002\u5982\u540c\u6559\u5b78\u5efa\u8b70\uff0c\u5617\u8a66\u6539\u8b8a\u4f60\u548c\u81ea\u52d5\u5316\u76ee\u6a19\u4e4b\u9593\u7684\u8ddd\u96e2\uff0c\u7136\u5f8c\u7df4\u7fd2\u4f60 3 \u5230 10 \u516c\u5c3a\u4e4b\u9593\u7684\u5c04\u7a0b\u3002"}, {"question": "Paint Strike \u4e2d\u6709\u54ea\u4e9b\u4e0d\u540c\u985e\u578b\u7684\u6b66\u5668\uff0c\u4ee5\u53ca\u4f5c\u70ba\u65b0\u624b\uff0c\u6211\u61c9\u8a72\u4e00\u958b\u59cb\u9078\u64c7\u54ea\u7a2e\u6b66\u5668\u4f86\u638c\u63e1\u57fa\u672c\u539f\u7406\uff1f", "answer": "Paint Strike \u63d0\u4f9b\u591a\u7a2e\u6b66\u5668\uff0c\u5f9e\u885d\u92d2\u69cd\u5230\u72d9\u64ca\u6b65\u69cd\u3002\u5c0d\u65bc\u521d\u5b78\u8005\uff0c\u6211\u5efa\u8b70\u5f9e\u7a81\u64ca\u6b65\u69cd (AR) \u958b\u59cb\u3002\u7a81\u64ca\u6b65\u69cd\u5728\u5c04\u7a0b\uff0c\u6e96\u78ba\u5ea6\u548c\u50b7\u5bb3\u65b9\u9762\u53d6\u5f97\u5e73\u8861\uff0c\u5275\u9020\u4e86\u6613\u65bc\u5b78\u7fd2\u7684\u66f2\u7dda\u3002\u4f8b\u5982\uff0c\u300cM4\u300d\u7a81\u64ca\u6b65\u69cd\u6613\u65bc\u4f7f\u7528\u4e14\u7528\u9014\u5ee3\u6cdb\u3002\u4f60\u53ef\u4ee5\u5229\u7528\u5b83\u4f86\u7406\u89e3\u6838\u5fc3\u6a5f\u5236\uff0c\u800c\u4e0d\u6703\u88ab\u5c08\u696d\u6a5f\u5236\u6240\u58d3\u5012\u3002\u4e4b\u5f8c\uff0c\u96a8\u8457\u4f60\u7d93\u9a57\u7684\u7d2f\u7a4d\uff0c\u6bcf\u7a2e\u6b66\u5668\u7684\u50b7\u5bb3\u7d71\u8a08\u6578\u64da\u5c07\u4ee5\u4e0d\u540c\u7684\u65b9\u5f0f\u5438\u5f15\u4f60\uff0c\u7136\u800c\uff0c\u5728\u4f60\u7684\u6700\u521d\u5e7e\u500b\u5c0f\u6642\u5167\uff0c\u8acb\u5805\u6301\u4f7f\u7528 M4\uff0c\u76f4\u5230\u4f60\u638c\u63e1\u4e86\u57fa\u790e\u904a\u6232\u8ff4\u5708\u3002\u9019\u985e\u4f3c\u65bc\u5b78\u7fd2\u897f\u6d0b\u68cb\uff1a\u4eba\u5011\u53ef\u4ee5\u5728\u4ee5\u5f8c\u9032\u884c\u5be6\u9a57\uff0c\u4f46\u521d\u5b78\u8005\u61c9\u8a72\u53cd\u8986\u7df4\u7fd2\u57fa\u672c\u7684\u958b\u5c40\uff0c\u76f4\u5230\u4ed6\u5011\u975e\u5e38\u719f\u6089\u3002"}, {"question": "Paint Strike \u57fa\u672c\u529f\uff1a\u65b0\u73a9\u5bb6\u5e38\u72af\u7684\u932f\u8aa4\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5982\u4f55\u907f\u514d\u9019\u4e9b\u932f\u8aa4\u4ee5\u66f4\u5feb\u5730\u9032\u6b65\uff1f", "answer": "\u65b0 Paint Strike \u73a9\u5bb6\u7d93\u5e38\u5728\u6c92\u6709\u6230\u8853\u610f\u8b58\u7684\u60c5\u6cc1\u4e0b\u885d\u5165\u6230\u9b25\uff0c\u672a\u80fd\u6709\u6548\u5229\u7528\u63a9\u9ad4\uff0c\u4e26\u4e14\u5ffd\u7565\u4e86\u8ff7\u4f60\u5730\u5716\u3002\u8981\u66f4\u5feb\u5730\u9032\u6b65\uff0c\u907f\u514d\u9019\u4e9b\u9677\u9631\u3002\u9996\u5148\uff0c\u5728\u8207\u6575\u4eba\u4ea4\u6230\u4e4b\u524d\uff0c\u52d9\u5fc5\u5148\u8a55\u4f30\u4f60\u7684\u5468\u570d\u74b0\u5883\uff1b\u52d9\u5fc5\u78ba\u4fdd\u9644\u8fd1\u6709\u907f\u96e3\u8def\u7dda\u6216\u63a9\u9ad4\u3002\u5176\u6b21\uff0c\u6b63\u78ba\u4f7f\u7528\u63a9\u9ad4\u986f\u8457\u63d0\u9ad8\u4e86\u751f\u5b58\u80fd\u529b\u3002\u7df4\u7fd2\u5feb\u901f\u5728\u63a9\u9ad4\u9ede\u4e4b\u9593\u8f49\u63db\u3002\u6700\u5f8c\uff0c\u95dc\u6ce8\u8ff7\u4f60\u5730\u5716\u53ef\u4ee5\u8b93\u4f60\u77ad\u89e3\u6575\u4eba\u7684\u4f4d\u7f6e\u548c\u968a\u53cb\u7684\u4f4d\u7f6e\uff0c\u4e26\u63d0\u4f9b\u6709\u50f9\u503c\u7684\u8cc7\u8a0a\u3002\u4f8b\u5982\uff0c\u5728\u300cDust2\u300d\u4e2d\u7684\u8ff7\u4f60\u5730\u5716\uff1b\u65b0\u73a9\u5bb6\u61c9\u59cb\u7d42\u6ce8\u610f B \u9ede\u901a\u9053\uff0c\u4ee5\u78ba\u4fdd\u4ed6\u5011\u96a8\u6642\u77ad\u89e3\u6575\u4eba\u7684\u4f4d\u7f6e\u3002\u6301\u7e8c\u61c9\u7528\u9019\u4e9b\u6280\u5de7\u5c07\u986f\u8457\u7e2e\u77ed\u4f60\u7684\u5b78\u7fd2\u66f2\u7dda\u3002\u53e6\u4e00\u500b\u9700\u8981\u6ce8\u610f\u7684\u65b9\u9762\u662f\u6e96\u5fc3\u4f4d\u7f6e\uff1a\u7784\u6e96\u6575\u4eba\u53ef\u80fd\u9732\u51fa\u7684\u4f4d\u7f6e\u3002\u8acb\u53c3\u95b1\u6b64\u5be6\u7528\u7684\u6e96\u5fc3\u8a2d\u5b9a\uff0c\u4ee5\u512a\u5316\u60a8\u7684\u8868\u73fe\u3002"}, {"question": "\u9032\u968e Paint Strike\uff1a\u5982\u4f55\u638c\u63e1\u4f8b\u5982\u8eb2\u9583\u548c\u6ed1\u52d5\u7b49\u79fb\u52d5\u6280\u5de7\uff0c\u4ee5\u5728\u6230\u9b25\u4e2d\u7372\u5f97\u512a\u52e2\uff1f", "answer": "\u5728 Paint Strike \u4e2d\u638c\u63e1\u8eb2\u9583\u548c\u6ed1\u52d5\u7b49\u79fb\u52d5\u6280\u5de7\u5c0d\u65bc\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u4f86\u8aaa\u81f3\u95dc\u91cd\u8981\uff0c\u4ee5\u7372\u5f97\u512a\u52e2\u3002\u8eb2\u9583\u662f\u6307\u5728\u5c04\u64ca\u6642\u5de6\u53f3\u79fb\u52d5\uff0c\u4f7f\u4f60\u6210\u70ba\u66f4\u96e3\u64ca\u4e2d\u7684\u76ee\u6a19\u3002\u6ed1\u52d5\u4f7f\u4f60\u80fd\u5920\u5feb\u901f\u7e2e\u77ed\u8ddd\u96e2\u6216\u8eb2\u907f\u6575\u4eba\u7684\u653b\u64ca\u3002\u4ee5\u4e0b\u662f\u9010\u6b65\u6307\u5357\uff1a\u6b65\u9a5f 1\uff1a\u7df4\u7fd2\u8eb2\u9583\uff1a\u5728\u4fdd\u6301\u7784\u6e96\u7a69\u5b9a\u7684\u60c5\u6cc1\u4e0b\uff0c\u4ea4\u66ff\u4f7f\u7528\u300cA \u9375\u300d(\u5de6\u8eb2\u9583) \u548c\u300cD \u9375\u300d(\u53f3\u8eb2\u9583)\u3002\u6b65\u9a5f 2\uff1a\u878d\u5165\u6ed1\u52d5\uff1a\u5728\u958b\u706b\u6642\u6ed1\u5165\u63a9\u9ad4\uff0c\u8b93\u4f60\u7684\u5c0d\u624b\u63aa\u624b\u4e0d\u53ca\uff1b\u4e00\u7a2e\u5e38\u898b\u7684\u7b56\u7565\u662f\u6ed1\u5165\u7bb1\u5b50\u5f8c\u9762\uff0c\u540c\u6642\u9032\u884c\u91cd\u65b0\u88dd\u586b\u3002\u6b65\u9a5f 3\uff1a\u7d50\u5408\u8eb2\u9583\u548c\u6ed1\u52d5\uff1a\u5c07\u9019\u4e9b\u6280\u5de7\u7d50\u5408\u8d77\u4f86\uff0c\u6210\u70ba\u4e00\u500b\u96e3\u4ee5\u6349\u6478\u7684\u76ee\u6a19\u3002\u4f8b\u5982\uff0c\u5728\u300cInferno\u300d\u5730\u5716\u7684\u300cT\u300d\u9ede\uff0c\u53ef\u4ee5\u4f7f\u7528\u6ed1\u52d5\u548c\u8eb2\u9583\u7684\u6df7\u5408\u65b9\u6cd5\u5feb\u901f\u5230\u9054\u4e2d\u8def\uff0c\u540c\u6642\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u9583\u907f\u80fd\u529b\u3002\u9019\u9700\u8981\u7df4\u7fd2\uff0c\u4f46\u6703\u986f\u8457\u63d0\u9ad8\u4f60\u7684\u6230\u9b25\u6548\u7387\u3002\u8acb\u8a18\u4f4f\u512a\u5316\u9375\u76e4\u7d81\u5b9a\uff0c\u4f7f\u79fb\u52d5\u76e1\u53ef\u80fd\u6d41\u66a2\uff01"}, {"question": "Paint Strike \u4e2d\u6709\u54ea\u4e9b\u5148\u9032\u7684\u5718\u968a\u7b56\u7565\uff0c\u4ee5\u53ca\u5982\u4f55\u8207\u968a\u53cb\u5728\u904a\u6232\u4e2d\u6709\u6548\u6e9d\u901a\u4ee5\u5be6\u65bd\u9019\u4e9b\u7b56\u7565\uff1f", "answer": "Paint Strike \u4e2d\u5148\u9032\u7684\u5718\u968a\u7b56\u7565\u5305\u62ec\u5354\u8abf\u7684\u653b\u64ca\u3001\u6230\u7565\u5340\u57df\u63a7\u5236\u548c\u6709\u6548\u8cc7\u6e90\u7ba1\u7406\u3002\u6709\u6548\u7684\u6e9d\u901a\u662f\u57f7\u884c\u9019\u4e9b\u7b56\u7565\u7684\u95dc\u9375\u3002\u4ee5\u4e0b\u662f\u5982\u4f55\u505a\u5230\uff1a\u6b65\u9a5f 1\uff1a\u5efa\u7acb\u660e\u78ba\u7684\u89d2\u8272\uff1a\u70ba\u6bcf\u500b\u968a\u53cb\u5206\u914d\u89d2\u8272\uff0c\u4f8b\u5982\u7a81\u9032\u72d9\u64ca\u624b\u3001\u652f\u63f4\u548c\u72d9\u64ca\u624b\u3002\u6b65\u9a5f 2\uff1a\u4f7f\u7528\u7c21\u6f54\u7684\u547c\u53eb\uff1a\u4f7f\u7528\u7279\u5b9a\u7684\u5730\u9ede\u540d\u7a31\u4f86\u50b3\u9054\u6575\u4eba\u7684\u4f4d\u7f6e\u548c\u610f\u5716\uff0c\u4f8b\u5982\u300cDust2\u300d\u4e0a\u7684\u300cA \u5340\u57df\u300d\u6216\u300cMirage\u300d\u4e0a\u7684\u300c\u8d70\u9053\u300d\u3002\u6b65\u9a5f 3\uff1a\u898f\u5283\u5354\u540c\u653b\u64ca\uff1a\u540c\u6b65\u4f60\u7684\u653b\u64ca\u4ee5\u58d3\u5012\u6575\u4eba\u3002\u4e00\u7a2e\u5178\u578b\u7684\u505a\u6cd5\u662f\u8b93\u7a81\u9032\u72d9\u64ca\u624b\u5e36\u9818\u653b\u64ca\uff0c\u7531\u968a\u53cb\u63d0\u4f9b\u63a9\u8b77\u706b\u529b\u4e26\u90e8\u7f72\u5de5\u5177\u7269\u54c1\u3002\u5c31\u50cf\u4efb\u4f55\u5718\u968a\u904b\u52d5\u4e00\u6a23\uff0c\u6e9d\u901a\u81f3\u95dc\u91cd\u8981\u3002\u6e05\u6670\u4e14\u5177\u9ad4\u7684\u6e9d\u901a\uff0c\u52a0\u4e0a\u660e\u78ba\u7684\u7b56\u7565\uff0c\u5c07\u4f7f\u4f60\u7684\u5718\u968a\u64c1\u6709\u660e\u986f\u7684\u512a\u52e2\u3002\u52d9\u5fc5\u5c0d\u4f60\u7684\u5931\u6557\u9032\u884c\u7e3d\u7d50\u3002"}, {"question": "Paint Strike \u5c08\u5bb6\u6280\u5de7\uff1a\u54ea\u4e9b\u6700\u4f73\u88dd\u5099\u914d\u7f6e\u548c\u7d93\u6fdf\u7ba1\u7406\u7b56\u7565\u53ef\u4ee5\u4e3b\u5c0e\u6bd4\u8cfd\uff1f", "answer": "\u6210\u529f\u7684\u7d93\u6fdf\u7ba1\u7406\u5c0d\u65bc\u9ad8\u968e Paint Strike \u904a\u6232\u81f3\u95dc\u91cd\u8981\u3002\u4e00\u7a2e\u5178\u578b\u7684\u505a\u6cd5\u662f\u5e73\u8861\u500b\u4eba\u6b66\u5668\u8cfc\u8cb7\u8207\u5718\u968a\u9700\u6c42\u3002\u4f8b\u5982\uff0c\u5728\u8d0f\u5f97\u7b2c\u4e00\u8f2a\u5f8c\uff0c\u8003\u616e\u90e8\u5206\u8cfc\u8cb7\uff08\u4f8b\u5982\u885d\u92d2\u69cd\u548c\u9632\u5f48\u8863\uff09\u4ee5\u7bc0\u7701\u4e0b\u4e00\u8f2a\u7684\u8cc7\u91d1\u3002\u6b64\u5916\uff0c\u5b78\u7fd2\u8207\u8cc7\u91d1\u4e0d\u8db3\u7684\u968a\u53cb\u4ea4\u63db\u6b66\u5668\u3002\u81f3\u65bc\u88dd\u5099\u914d\u7f6e\uff0c\u8acb\u6839\u64da\u4f60\u7684\u89d2\u8272\u548c\u5730\u5716\u8abf\u6574\u4f60\u7684\u6b66\u5668\u9078\u64c7\u3002\u72d9\u64ca\u624b\u53d7\u76ca\u65bc\u9577\u5c04\u7a0b\u6b65\u69cd\uff0c\u4f8b\u5982 AWP\uff0c\u800c\u7a81\u9032\u72d9\u64ca\u624b\u5247\u53ef\u80fd\u9078\u64c7\u591a\u7528\u9014\u6b66\u5668\uff0c\u4f8b\u5982 M4 \u6216 AK-47\u3002\u81f3\u65bc\u4f60\u7684\u7b2c\u4e09\u7a2e\u6b66\u5668\uff0c\u624b\u69cd\u63d0\u4f9b\u9ad8\u5be6\u7528\u6027\uff0c\u5176\u5c04\u901f\u5feb\u4e14\u91cd\u65b0\u88dd\u586b\u901f\u5ea6\u5feb\u3002\u8acb\u8a18\u4f4f\uff0c\u7406\u60f3\u7684\u88dd\u5099\u914d\u7f6e\u53d6\u6c7a\u65bc\u4f60\u7684\u904a\u6232\u98a8\u683c\u548c\u5718\u968a\u52d5\u614b\uff1b\u6c92\u6709\u300c\u842c\u80fd\u89e3\u6c7a\u65b9\u6848\u300d\u3002\u4f7f\u7528\u6b64\u6bd4\u8f03\u5716\u8868\u5728\u6574\u500b\u904a\u6232\u4e2d\u512a\u5316\u4f60\u7684\u7d93\u6fdf\u4e5f\u5f88\u6709\u5e6b\u52a9\u3002"}, {"question": "Paint Strike \u6df1\u5165\u63a2\u8a0e\uff1aPaint Strike \u4e2d\u7684\u6b66\u5668\u5f8c\u5750\u529b\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u904a\u6232\u4e2d\u662f\u5426\u5b58\u5728\u4efb\u4f55\u6a5f\u5236\u53ef\u4ee5\u514b\u670d\u5b83\u4e26\u9054\u5230\u5b8c\u7f8e\u7684\u6e96\u78ba\u5ea6\uff1f", "answer": "Paint Strike \u4e2d\u7684\u6b66\u5668\u5f8c\u5750\u529b\u662f\u4e00\u500b\u8907\u96dc\u7684\u7cfb\u7d71\uff0c\u65e8\u5728\u8003\u9a57\u73a9\u5bb6\u7684\u6280\u80fd\u3002\u6bcf\u7a2e\u6b66\u5668\u90fd\u6709\u4e00\u500b\u7368\u7279\u7684\u5f8c\u5750\u529b\u6a21\u5f0f\uff0c\u5fc5\u9808\u5b78\u7fd2\u3002\u901a\u5e38\uff0c\u521d\u59cb\u5f8c\u5750\u529b\u662f\u5782\u76f4\u7684\uff0c\u7136\u5f8c\u662f\u6c34\u5e73\u64fa\u52d5\u3002\u5b78\u7fd2\u63a7\u5236\u5f8c\u5750\u529b\u5305\u62ec\u5411\u4e0b\u62c9\u52d5\u6ed1\u9f20\u4f86\u62b5\u6d88\u5782\u76f4\u4e0a\u5347\uff0c\u4e26\u88dc\u511f\u6c34\u5e73\u6f02\u79fb\u3002\u4e00\u4e9b\u6b66\u5668\u5177\u6709\u53ef\u9810\u6e2c\u7684\u6a21\u5f0f\uff0c\u800c\u53e6\u4e00\u4e9b\u5247\u66f4\u96a8\u6a5f\u3002\u904a\u6232\u4e2d\u6c92\u6709\u4efb\u4f55\u6a5f\u5236\u53ef\u4ee5\u5b8c\u5168\u6d88\u9664\u5f8c\u5750\u529b\uff1b\u91cd\u9ede\u662f\u638c\u63e1\u5982\u4f55\u88dc\u511f\u5b83\u3002\u4f8b\u5982\uff0cAK-47 \u6709\u4e00\u500b\u7368\u7279\u7684\u300cT\u300d\u5f62\u5f8c\u5750\u529b\u6a21\u5f0f\uff1b\u638c\u63e1\u5b83\u7684\u88dc\u511f\u662f\u9023\u7e8c\u64ca\u4e2d\u982d\u90e8\u7684\u95dc\u9375\u3002\u5728\u9019\u500b\u6a5f\u5236\u4e2d\uff0c\u7df4\u7fd2\u662f\u95dc\u9375\u3002\u53e6\u4e00\u7a2e\u6280\u8853\u662f\u9032\u884c\u77ed\u800c\u7cbe\u78ba\u7684\u9023\u5c04\u3002\u9023\u5c04\u53ef\u4ee5\u6e1b\u8f15\u5f8c\u5750\u529b\u4e26\u63d0\u9ad8\u6e96\u78ba\u6027\uff0c\u5c24\u5176\u662f\u5728\u9577\u8ddd\u96e2\u7684\u60c5\u6cc1\u4e0b\u3002\u9019\u8207\u6c7d\u8eca\u5f15\u64ce\u975e\u5e38\u76f8\u4f3c\uff1b\u8f03\u77ed\u7684\u7206\u767c\u53ef\u4ee5\u7bc0\u7701\u6c7d\u6cb9\u4e26\u6e1b\u5c11\u78e8\u640d\u3002"}, {"question": "\u70ba\u4ec0\u9ebc Paint Strike \u7684\u914d\u5c0d\u7cfb\u7d71\u6709\u6642\u770b\u8d77\u4f86\u4e0d\u5e73\u8861\uff0c\u54ea\u4e9b\u56e0\u7d20\u5c0e\u81f4\u4e86\u9019\u4e9b\u660e\u986f\u7684\u5dee\u7570\uff1f", "answer": "Paint Strike \u7684\u914d\u5c0d\u7cfb\u7d71\uff0c\u5c31\u50cf\u4efb\u4f55\u7af6\u722d\u6027\u7cfb\u7d71\u4e00\u6a23\uff0c\u7531\u65bc\u591a\u7a2e\u56e0\u7d20\uff0c\u6709\u6642\u53ef\u80fd\u6703\u51fa\u73fe\u4e0d\u5e73\u8861\u7684\u60c5\u6cc1\u3002\u914d\u5c0d\u4e3b\u8981\u8003\u616e\u73a9\u5bb6\u7684\u6280\u80fd\u8a55\u7d1a\uff08\u4f8b\u5982 Elo \u6216 MMR\uff09\uff0c\u4f46\u5176\u4ed6\u56e0\u7d20\uff0c\u4f8b\u5982\u6392\u968a\u6642\u9593\u3001\u5ef6\u9072\u548c\u5718\u968a\u898f\u6a21\u4e5f\u8d77\u8457\u4f5c\u7528\u3002\u8f03\u9577\u7684\u6392\u968a\u6642\u9593\u53ef\u80fd\u6703\u5c0e\u81f4\u66f4\u5927\u7684\u6280\u80fd\u5dee\u8ddd\uff0c\u4ee5\u78ba\u4fdd\u5feb\u901f\u627e\u5230\u6bd4\u8cfd\uff0c\u800c\u5617\u8a66\u5c07\u5ef6\u9072\u8f03\u4f4e\u7684\u73a9\u5bb6\u5206\u7d44\u5728\u4e00\u8d77\u53ef\u80fd\u6703\u5c0e\u81f4\u968a\u4f0d\u4e0d\u5e73\u8861\u3002\u8b93 5 \u4eba\u7684\u5b8c\u6574\u9810\u69cb\u6210\u968a\u8207\u96a8\u6a5f\u55ae\u4eba\u6392\u968a\u73a9\u5bb6\u914d\u5c0d\u4e5f\u66f4\u56f0\u96e3\u3002\u8003\u616e\u6280\u80fd\u8a55\u7d1a\u7684\u52d5\u614b\u7279\u6027\u662f\u6709\u7528\u7684\uff0c\u9019\u53cd\u904e\u4f86\u6703\u5f71\u97ff\u4f60\u7684\u904a\u6232\u9ad4\u9a57\u3002\u4f8b\u5982\uff0c\u9ad8\u6280\u80fd\u8a55\u7d1a\u7684\u73a9\u5bb6\u8207\u4f4e\u6280\u80fd\u73a9\u5bb6\u5206\u7d44\u53ef\u80fd\u6703\u6539\u8b8a\u6574\u500b\u5718\u968a\u7684\u52d5\u614b\u3002\u6216\u8005\uff0c\u63db\u53e5\u8a71\u8aaa\uff0c\u9ad4\u80b2\u6bd4\u8cfd\u4e26\u4e0d\u7e3d\u662f\u516c\u5e73\u7684\u2014\u2014\u4f60\u53ef\u80fd\u6b63\u5728\u5c0d\u9663\u4e00\u652f\u64c1\u6709\u66f4\u597d\u904b\u52d5\u54e1\u7684\u7403\u968a\u3002\u53ea\u8981\u7e7c\u7e8c\u5b8c\u5584\u4f60\u81ea\u5df1\u7684\u65b9\u6cd5\u6216\u7d44\u5efa\u66f4\u5f37\u5927\u7684\u5718\u968a\u5373\u53ef\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5c07\u6211\u7684 Paint Strike \u9032\u5ea6\u5728 PC \u548c\u624b\u6a5f\u5e73\u53f0\u4e4b\u9593\u8f49\u79fb\uff0c\u9084\u662f\u5b83\u5011\u662f\u5206\u958b\u7684\u5e33\u6236\uff1f", "answer": "\u76ee\u524d\uff0cPaint Strike \u4e0d\u652f\u63f4\u5728 PC \u548c\u884c\u52d5\u5e73\u53f0\u4e4b\u9593\u8f49\u79fb\u904a\u6232\u9032\u5ea6\u3002\u4f60\u7684\u9032\u5ea6\u3001\u89e3\u9396\u548c\u8cfc\u8cb7\u8207\u4f60\u5728\u5176\u4e0a\u7372\u5f97\u5b83\u5011\u7684\u5e73\u53f0\u76f8\u95dc\u806f\u3002\u9019\u610f\u5473\u8457\uff0c\u5982\u679c\u4f60\u5f9e PC \u958b\u59cb\u904a\u6232\uff0c\u4f60\u7684\u9032\u5ea6\u5c07\u4e0d\u6703\u8f49\u79fb\u5230\u79fb\u52d5\u7248\u672c\uff0c\u53cd\u4e4b\u4ea6\u7136\u3002\u9019\u7a2e\u5206\u96e2\u901a\u5e38\u662f\u7531\u65bc\u5e73\u53f0\u7279\u5b9a\u7684\u529f\u80fd\u3001\u63a7\u5236\u65b9\u6848\u548c\u5546\u5e97\u653f\u7b56\u3002\u7136\u800c\uff0c\u67d0\u4e9b\u904a\u6232\u63d0\u4f9b\u5e33\u6236\u9023\u7d50\u529f\u80fd\uff0c\u7528\u65bc\u865b\u64ec\u7269\u54c1\u6216\u8de8\u5e73\u53f0\u904a\u6232\uff0c\u5141\u8a31\u73a9\u5bb6\u4e92\u76f8\u4e92\u52d5\u3002\u4f46\u9019\u4e0d\u4e00\u5b9a\u7b49\u540c\u65bc\u9032\u5ea6\u5c0d\u7b49\u3002\u8acb\u5b9a\u671f\u67e5\u770b\u793e\u7fa4\u8a0e\u8ad6\u5340\uff0c\u4ee5\u9632\u958b\u767c\u4eba\u54e1\u91dd\u5c0d\u6b64\u554f\u984c\u6dfb\u52a0\u4efb\u4f55\u66f4\u65b0\u3002"}, {"question": "Paint Strike \u7684\u5f69\u86cb\uff1aPaint Strike \u4e2d\u6709\u54ea\u4e9b\u6700\u9177\u7684\u96b1\u85cf\u5f69\u86cb\u6216\u79d8\u5bc6\uff0c\u4ee5\u53ca\u4f5c\u70ba\u73a9\u5bb6\uff0c\u6211\u5982\u4f55\u89f8\u767c\u5b83\u5011\uff1f", "answer": "Paint Strike \u542b\u6709\u5e7e\u500b\u96b1\u85cf\u7684\u5f69\u86cb\u548c\u79d8\u5bc6\u3002\u4e00\u500b\u5f69\u86cb\u6d89\u53ca\u5728\u300c\u57ce\u5e02\u7a81\u64ca\u300d\u5730\u5716\u4e0a\u5c0b\u627e\u96b1\u85cf\u7684\u5674\u6f06\u7f50\u3002\u6574\u500b\u5730\u5716\u4e0a\u90fd\u96b1\u85cf\u8457\u4e03\u500b\u5674\u6f06\u7f50\u3002\u6536\u96c6\u6240\u6709\u4e03\u500b\u5674\u6f06\u7f50\u5c07\u89e3\u9396\u53ef\u4f9b\u904a\u6232\u4f7f\u7528\u7684\u96b1\u85cf\u5857\u9d09\u6a19\u7c64\u3002\u53e6\u4e00\u500b\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\u6fc0\u6d3b\u300c\u5ee2\u68c4\u5de5\u5ee0\u300d\u5730\u5716\u4e0a\u7684\u96b1\u85cf\u7121\u7dda\u96fb\u983b\u7387\u3002\u901a\u904e\u8207\u9019\u53f0\u96fb\u8166\u7cfb\u7d71\u4e92\u52d5\uff0c\u4f60\u53ef\u4ee5\u767c\u9001\u96b1\u85cf\u7684\u7121\u7dda\u96fb\u983b\u7387\u3002\u9019\u5c07\u89e3\u9396\u4e00\u500b\u96b1\u85cf\u7684\u97f3\u8a0a\u8a18\u9304\u6a94\uff0c\u63d0\u4f9b\u4e86\u904a\u6232\u5b87\u5b99\u6709\u8da3\u7684\u80cc\u666f\u8cc7\u8a0a\u3002\u9019\u4e9b\u7d30\u7bc0\u9032\u4e00\u6b65\u5730\u5c07\u4f60\u878d\u5165\u904a\u6232\u7684\u66f4\u5927\u4e16\u754c\uff0c\u589e\u6dfb\u4e86\u50f9\u503c\uff01"}]
[{"question": "Rooftop Run\u65b0\u624b\u6307\u5357\uff1a\u57fa\u672c\u64cd\u63a7\u662f\u4ec0\u9ebc\uff0c\u5982\u4f55\u57f7\u884c\u7c21\u55ae\u8df3\u8e8d\uff1f", "answer": "\u6b61\u8fce\u4f86\u5230Rooftop Run\uff01\u57fa\u672c\u64cd\u4f5c\u975e\u5e38\u7c21\u55ae\uff1a\u4f7f\u7528\u87a2\u5e55\u4e0a\u7684\u865b\u64ec\u65b9\u5411\u9375\u63a7\u5236\u89d2\u8272\u79fb\u52d5\uff0c\u9ede\u64ca\u8df3\u8e8d\u6309\u9215\u9032\u884c\u8df3\u8e8d\u3002\u4f8b\u5982\uff0c\u60f3\u8de8\u904e\u521d\u59cb\u7684\u77ee\u7246\uff0c\u53ea\u9700\u9760\u8fd1\u5f8c\u9ede\u64ca\u8df3\u8e8d\u6309\u9215\u5373\u53ef\u3002\u719f\u6089\u9019\u4e9b\u5f8c\uff0c\u5c31\u80fd\u8f15\u9b06\u8dd1\u8d77\u4f86\uff01\u6bd4\u55bb\u8aaa\u660e\uff1a\u53ef\u4ee5\u628a\u8df3\u8e8d\u60f3\u50cf\u6210\u8e29\u5f48\u7c27\uff0c\u6309\u4e0b\u6309\u9215\uff0c\u89d2\u8272\u5c31\u5f48\u8d77\u4f86\u4e86\u3002"}, {"question": "\u5728Rooftop Run\u88e1\uff0c\u70ba\u4ec0\u9ebc\u6211\u4f5c\u70ba\u65b0\u624b\u6703\u4e0d\u65b7\u5f9e\u908a\u7de3\u6389\u4e0b\u4f86\uff1f\u5982\u4f55\u9810\u9632\uff1f", "answer": "\u5225\u64d4\u5fc3\uff0c\u6389\u4e0b\u53bb\u5f88\u5e38\u898b\uff01\u65b0\u624b\u5bb9\u6613\u6389\u843d\u7684\u4e3b\u8981\u539f\u56e0\u662f\u901f\u5ea6\u63a7\u5236\u4e0d\u7576\u548c\u8df3\u8e8d\u6642\u6a5f\u4e0d\u5c0d\u3002\u89e3\u6c7a\u65b9\u6cd5\uff1a1. \u9069\u5ea6\u964d\u4f4e\u5954\u8dd1\u901f\u5ea6\uff0c\u66f4\u5bb9\u6613\u63a7\u5236\u65b9\u5411\u30022. \u5728\u63a5\u8fd1\u908a\u7de3\u6642\u518d\u8df3\u8e8d\uff0c\u78ba\u4fdd\u8df3\u8e8d\u8ddd\u96e2\u8db3\u5920\u30023. \u89c0\u5bdf\u524d\u65b9\u5730\u5f62\uff0c\u63d0\u524d\u898f\u5283\u8def\u7dda\u3002\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u901f\u5ea6\u4f4e\uff1a\u66f4\u5bb9\u6613\u63a7\u5236\uff1b\u901f\u5ea6\u9ad8\uff1a\u5bb9\u6613\u6389\u843d\u3002"}, {"question": "Rooftop Run\u6709\u54ea\u4e9b\u96b1\u85cf\u7684\u8d77\u59cb\u89d2\u8272\uff1f\u5982\u4f55\u7372\u5f97\uff1f", "answer": "Rooftop Run\u4e2d\u96b1\u85cf\u8457\u5e7e\u500b\u7368\u7279\u7684\u8d77\u59cb\u89d2\u8272\uff0c\u7372\u5f97\u5b83\u5011\u80fd\u8b93\u4f60\u7684\u904a\u6232\u9ad4\u9a57\u66f4\u8c50\u5bcc\uff01\u4f8b\u5982\uff0c\u300c\u5fcd\u8005\u4fe1\u689d\u300d\u9700\u8981\u4f60\u9023\u7e8c\u5b8c\u6210\u4e94\u6b21\u5b8c\u7f8e\u8df3\u8e8d\uff08\u8df3\u8e8d\u5f8c\u525b\u597d\u843d\u5728\u5e73\u53f0\u908a\u7de3\uff09\u3002\u53e6\u4e00\u500b\u89d2\u8272\u300c\u90fd\u5e02\u7375\u4eba\u300d\u5247\u9700\u8981\u6536\u96c6\u904a\u6232\u5167\u7684\u6240\u6709\u7279\u6b8a\u91d1\u5e63\u3002\u4ed4\u7d30\u63a2\u7d22\u6bcf\u500b\u95dc\u5361\uff0c\u5c31\u80fd\u767c\u73fe\u9019\u4e9b\u9a5a\u559c\uff01"}, {"question": "\u5c0d\u65bcRooftop Run\u7684\u8001\u73a9\u5bb6\uff0c\u9023\u9396\u8df3\u8e8d\u4e26\u7dad\u6301\u52d5\u91cf\u7684\u6700\u6709\u6548\u65b9\u6cd5\u662f\u4ec0\u9ebc\uff1f\u5982\u4f55\u7372\u5f97\u9ad8\u5206\uff1f", "answer": "\u60f3\u7372\u5f97\u9ad8\u5206\uff0c\u9023\u8df3\u6280\u5de7\u81f3\u95dc\u91cd\u8981\uff01\u6b65\u9a5f1\uff1a\u9810\u5224\u4e0b\u4e00\u500b\u843d\u8173\u9ede\u7684\u4f4d\u7f6e\uff0c\u63d0\u524d\u8abf\u6574\u65b9\u5411\u3002\u6b65\u9a5f2\uff1a\u5728\u89d2\u8272\u5373\u5c07\u843d\u5730\u6642\u7acb\u523b\u9ede\u64ca\u8df3\u8e8d\u6309\u9215\uff0c\u5be6\u73fe\u7121\u7e2b\u929c\u63a5\u3002\u6b65\u9a5f3\uff1a\u5229\u7528\u5730\u5f62\u7279\u9ede\uff0c\u4f8b\u5982\u659c\u5761\u80fd\u63d0\u4f9b\u984d\u5916\u7684\u901f\u5ea6\u52a0\u6210\u3002\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u666e\u901a\u8df3\u8e8d\uff1a\u901f\u5ea6\u8870\u6e1b\u5feb\uff1b\u5b8c\u7f8e\u9023\u8df3\uff1a\u901f\u5ea6\u6301\u7e8c\u63d0\u5347\uff0c\u5f97\u5206\u66f4\u9ad8\u3002"}, {"question": "Rooftop Run\u9ad8\u624b\u9032\u968e\uff1a\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u5982\u4f55\u5229\u7528\u6ed1\u52d5\u6a5f\u5236\u4f86\u63d0\u5347\u512a\u52e2\uff0c\u662f\u5426\u6709\u4efb\u4f55\u9032\u968e\u6280\u5de7\uff1f", "answer": "\u6ed1\u93df\u662fRooftop Run\u4e2d\u7684\u4e00\u9805\u9ad8\u7d1a\u6280\u5de7\uff0c\u80fd\u5e6b\u52a9\u4f60\u66f4\u5feb\u5730\u901a\u904e\u72f9\u7a84\u5340\u57df\u548c\u8eb2\u907f\u969c\u7919\u3002\u9032\u968e\u7528\u6cd5\uff1a1. \u5728\u9ad8\u901f\u5954\u8dd1\u6642\u4f7f\u7528\u6ed1\u93df\uff0c\u53ef\u4ee5\u5ef6\u9577\u6ed1\u884c\u8ddd\u96e2\u30022. \u7d50\u5408\u8df3\u8e8d\u548c\u6ed1\u93df\uff0c\u53ef\u4ee5\u5be6\u73fe\u7a7a\u4e2d\u8b8a\u5411\u30023. \u5728\u9047\u5230\u77ee\u5c0f\u969c\u7919\u7269\u6642\uff0c\u4f7f\u7528\u6ed1\u93df\u53ef\u4ee5\u76f4\u63a5\u7a7f\u904e\u3002\u6d41\u7a0b\u5716\u89e3\uff1a\u8d77\u8dd1\u2192\u52a0\u901f\u5954\u8dd1\u2192\u6309\u4e0b\u6ed1\u93df\u9375\u2192\u5229\u7528\u6ed1\u884c\u52d5\u4f5c\u8eb2\u907f\u6216\u901a\u904e\u969c\u7919\u3002"}, {"question": "\u5728Rooftop Run\u4e2d\uff0c\u70ba\u4ec0\u9ebc\u6211\u7684\u5f97\u5206\u6bd4\u5176\u4ed6\u73a9\u5bb6\u4f4e\uff0c\u5373\u4f7f\u6211\u5b8c\u6210\u4e86\u8dd1\u9177\uff1f\u5982\u4f55\u512a\u5316\u6211\u7684\u8def\u7dda\u4ee5\u7372\u5f97\u66f4\u597d\u7684\u5f97\u5206\uff1f", "answer": "\u5f97\u5206\u4e0d\u55ae\u55ae\u53d6\u6c7a\u65bc\u662f\u5426\u5b8c\u6210\u8dd1\u9177\uff01\u5f71\u97ff\u56e0\u7d20\u5305\u62ec\uff1a\u6536\u96c6\u7684\u91d1\u5e63\u6578\u91cf\u3001\u5b8c\u6210\u7279\u6b8a\u52d5\u4f5c\u7684\u6b21\u6578\uff08\u4f8b\u5982\u5b8c\u7f8e\u8df3\u8e8d\u548c\u6ed1\u93df\uff09\u3001\u4ee5\u53ca\u901a\u95dc\u6642\u9593\u3002\u512a\u5316\u8def\u7dda\u7684\u95dc\u9375\u5728\u65bc\uff1a1. \u76e1\u53ef\u80fd\u591a\u5730\u6536\u96c6\u91d1\u5e63\u30022. \u5617\u8a66\u6311\u6230\u9ad8\u96e3\u5ea6\u52d5\u4f5c\uff0c\u7372\u5f97\u984d\u5916\u52a0\u5206\u30023. \u719f\u6089\u5730\u5716\uff0c\u9078\u64c7\u6700\u77ed\u7684\u8def\u7dda\u3002\u53ef\u4ee5\u628a\u6bcf\u500b\u95dc\u5361\u5206\u6210\u5e7e\u500b\u968e\u6bb5\uff0c\u5206\u5225\u5206\u6790\u6700\u4f73\u7b56\u7565\u3002"}, {"question": "\u63ed\u79d8Rooftop Run\uff1a\u54ea\u4e9b\u5e95\u5c64\u904a\u6232\u6a5f\u5236\u63a7\u5236\u8457\u89d2\u8272\u901f\u5ea6\u548c\u8df3\u8e8d\u8ddd\u96e2\uff1f", "answer": "Rooftop Run\u7684\u89d2\u8272\u901f\u5ea6\u548c\u8df3\u8e8d\u8ddd\u96e2\u53d7\u5230\u591a\u500b\u56e0\u7d20\u5f71\u97ff\u3002\u57fa\u790e\u901f\u5ea6\u7531\u89d2\u8272\u5c6c\u6027\u6c7a\u5b9a\uff0c\u53ef\u4ee5\u900f\u904e\u5347\u7d1a\u89d2\u8272\u4f86\u63d0\u5347\u3002\u8df3\u8e8d\u8ddd\u96e2\u5247\u53d7\u5230\u901f\u5ea6\u3001\u8d77\u8df3\u89d2\u5ea6\u548c\u5730\u5f62\u5f71\u97ff\u3002\u904a\u6232\u4e2d\u9084\u5b58\u5728\u4e00\u4e9b\u96b1\u85cf\u7684\u6578\u503c\uff0c\u4f8b\u5982\u300c\u52d5\u91cf\u7d2f\u7a4d\u300d\uff0c\u9023\u7e8c\u7684\u5b8c\u7f8e\u52d5\u4f5c\u53ef\u4ee5\u7565\u5fae\u63d0\u5347\u89d2\u8272\u901f\u5ea6\u3002\u9019\u4e9b\u96b1\u85cf\u6578\u503c\u589e\u52a0\u4e86\u904a\u6232\u7684\u6df1\u5ea6\u3002"}, {"question": "Rooftop Run\u7684\u6578\u503c\u5206\u6790\uff1a\u904a\u6232\u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u5c24\u5176\u95dc\u65bc\u500d\u6578\u548c\u984d\u5916\u5206\u6578\uff1f", "answer": "Rooftop Run\u7684\u5f97\u5206\u7cfb\u7d71\u975e\u5e38\u9748\u6d3b\u3002\u57fa\u790e\u5206\u6e90\u65bc\u6536\u96c6\u7684\u91d1\u5e63\u548c\u5b8c\u6210\u7684\u52d5\u4f5c\uff0c\u4f46\u771f\u6b63\u7684\u95dc\u9375\u5728\u65bc\u500d\u7387\u7cfb\u7d71\u3002\u9023\u7e8c\u7684\u5b8c\u7f8e\u8df3\u8e8d\u3001\u6ed1\u93df\u7b49\u52d5\u4f5c\u53ef\u4ee5\u589e\u52a0\u500d\u7387\uff0c\u4e2d\u65b7\u6703\u5c0e\u81f4\u500d\u7387\u6b78\u96f6\u3002\u56e0\u6b64\uff0c\u4fdd\u6301\u9023\u8cab\u7684\u52d5\u4f5c\u662f\u7372\u5f97\u9ad8\u5206\u7684\u95dc\u9375\u3002\u6b64\u5916\uff0c\u904a\u6232\u9084\u8a2d\u5b9a\u4e86\u4e00\u4e9b\u96b1\u85cf\u6210\u5c31\uff0c\u5b8c\u6210\u53ef\u4ee5\u7372\u5f97\u984d\u5916\u7684\u734e\u52f5\u7a4d\u5206\u3002\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u666e\u901a\u52d5\u4f5c\uff1a1\u500d\uff1b\u9023\u7e8c\u5b8c\u7f8e\uff1a\u500d\u7387\u905e\u589e\u3002"}, {"question": "Rooftop Run\u8de8\u5e73\u53f0\u554f\u984c\uff1a\u5982\u679c\u6211\u63db\u5230\u65b0\u7684\u88dd\u7f6e\uff0c\u6211\u7684Rooftop Run\u9032\u5ea6\u548c\u89e3\u9396\u7684\u5167\u5bb9\u6703\u88ab\u8f49\u79fb\u55ce\uff1f\u5982\u4f55\u78ba\u4fdd\u8cc7\u6599\u9077\u79fb\uff1f", "answer": "\u70ba\u4e86\u4fdd\u969c\u4f60\u7684\u904a\u6232\u9032\u5ea6\uff0cRooftop Run\u901a\u5e38\u6703\u63d0\u4f9b\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u3002\u78ba\u4fdd\u5728\u820a\u88dd\u7f6e\u4e0a\u767b\u5165\u5e33\u865f\u4e26\u958b\u555f\u96f2\u540c\u6b65\u3002\u5728\u65b0\u88dd\u7f6e\u4e0a\uff0c\u4f7f\u7528\u540c\u4e00\u5e33\u865f\u767b\u5165\uff0c\u904a\u6232\u6703\u81ea\u52d5\u4e0b\u8f09\u4f60\u7684\u9032\u5ea6\u3002\u5982\u679c\u9047\u5230\u554f\u984c\uff0c\u53ef\u4ee5\u5617\u8a66\u624b\u52d5\u540c\u6b65\u6216\u806f\u7e6b\u5ba2\u670d\u3002\u52d9\u5fc5\u8a18\u4f4f\u4f60\u7684\u5e33\u865f\u8cc7\u8a0a\uff0c\u907f\u514d\u8cc7\u6599\u907a\u5931\u3002"}, {"question": "Rooftop Run\u5f69\u86cb\u6316\u6398\uff1aRooftop Run\u4e2d\u662f\u5426\u6709\u4efb\u4f55\u96b1\u85cf\u5f69\u86cb\u6216\u79d8\u5bc6\u5340\u57df\uff0c\u7279\u5225\u662f\u8207\u95dc\u5361\u8a2d\u8a08\u6216\u4e3b\u984c\u5143\u7d20\u76f8\u95dc\u7684\uff1f", "answer": "Rooftop Run\u4e2d\u96b1\u85cf\u8457\u4e0d\u5c11\u5f69\u86cb\uff01\u4f8b\u5982\uff0c\u5728\u300c\u90fd\u5e02\u5929\u53f0\u300d\u95dc\u5361\u4e2d\uff0c\u9023\u7e8c\u8df3\u8e8d\u4e09\u6b21\u7279\u5b9a\u7684\u5ee3\u544a\u724c\uff0c\u6703\u89f8\u767c\u96b1\u85cf\u7684\u5857\u9d09\u85dd\u8853\u3002\u6b64\u5916\uff0c\u5728\u300c\u5de5\u696d\u5340\u300d\u95dc\u5361\uff0c\u4ed4\u7d30\u89c0\u5bdf\u80cc\u666f\uff0c\u53ef\u80fd\u6703\u767c\u73fe\u81f4\u656c\u7d93\u5178\u8dd1\u9177\u904a\u6232\u7684\u5143\u7d20\u3002\u5c0b\u627e\u9019\u4e9b\u5f69\u86cb\u80fd\u8b93\u4f60\u66f4\u6df1\u5165\u5730\u4e86\u89e3\u904a\u6232\u7684\u4e16\u754c\u89c0\uff0c\u4e5f\u589e\u52a0\u4e86\u63a2\u7d22\u7684\u6a02\u8da3\u3002"}]
[{"question": "Rooftop Run \ucd08\ubcf4 \uac00\uc774\ub4dc: \uae30\ubcf8 \ucee8\ud2b8\ub864\uc740 \ubb34\uc5c7\uc774\uba70, \uac04\ub2e8\ud55c \uc810\ud504\ub294 \uc5b4\ub5bb\uac8c \uc218\ud589\ud569\ub2c8\uae4c?", "answer": "Rooftop Run\uc5d0 \uc624\uc2e0 \uac83\uc744 \ud658\uc601\ud569\ub2c8\ub2e4! \uae30\ubcf8 \uc870\uc791\uc740 \ub9e4\uc6b0 \uac04\ub2e8\ud569\ub2c8\ub2e4. \ud654\uba74\uc758 \uac00\uc0c1 \ubc29\ud5a5\ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uce90\ub9ad\ud130\ub97c \uc774\ub3d9\ud558\uace0, \uc810\ud504 \ubc84\ud2bc\uc744 \ub20c\ub7ec \uc810\ud504\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucc98\uc74c \ub4f1\uc7a5\ud558\ub294 \ub0ae\uc740 \ub2f4\uc744 \ub6f0\uc5b4\ub118\uc73c\ub824\uba74, \ub2f4\uc5d0 \uac00\uae4c\uc774 \ub2e4\uac00\uac00 \uc810\ud504 \ubc84\ud2bc\uc744 \ub204\ub974\uba74 \ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uae30\ubcf8 \uc870\uc791\uc5d0 \uc775\uc219\ud574\uc9c0\uba74 \uc27d\uac8c \ub7f0\ub2dd\uc744 \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4! \ube44\uc720: \uc810\ud504\ub97c \ud0c4\uc131\ud310\uc744 \ubc1f\ub294 \uac83\uc73c\ub85c \uc0dd\uac01\ud558\uc2ed\uc2dc\uc624. \ubc84\ud2bc\uc744 \ub204\ub974\uba74 \uce90\ub9ad\ud130\uac00 \ud295\uaca8 \uc624\ub985\ub2c8\ub2e4."}, {"question": "Rooftop Run\uc5d0\uc11c, \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub85c\uc11c \uc65c \uacc4\uc18d\ud574\uc11c \uac00\uc7a5\uc790\ub9ac\uc5d0\uc11c \ub5a8\uc5b4\uc9c0\uba70, \uc5b4\ub5bb\uac8c \uc774\ub97c \ubc29\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uac71\uc815\ud558\uc9c0 \ub9c8\uc138\uc694, \ub5a8\uc5b4\uc9c0\ub294 \uac83\uc740 \ub9e4\uc6b0 \ud754\ud569\ub2c8\ub2e4! \ucd08\ubcf4 \ud50c\ub808\uc774\uc5b4\uac00 \uac00\uc7a5\uc790\ub9ac\uc5d0\uc11c \ub5a8\uc5b4\uc9c0\ub294 \uc8fc\ub41c \uc774\uc720\ub294 \uc18d\ub3c4 \uc81c\uc5b4 \ubbf8\uc219\uacfc \uc810\ud504 \uc2dc\uae30 \ubd80\uc801\uc808 \ub54c\ubb38\uc785\ub2c8\ub2e4. \ud574\uacb0 \ubc29\ubc95: 1. \ub2ec\ub9ac\ub294 \uc18d\ub3c4\ub97c \uc801\uc808\ud788 \ub0ae\ucd94\uba74 \ubc29\ud5a5\uc744 \ub354\uc6b1 \uc27d\uac8c \uc81c\uc5b4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 2. \uac00\uc7a5\uc790\ub9ac\uc5d0 \uac00\uae4c\uc6cc\uc84c\uc744 \ub54c \uc810\ud504\ub97c \ud558\uc5ec \uc810\ud504 \uac70\ub9ac\uac00 \ucda9\ubd84\ud558\ub3c4\ub85d \ud569\ub2c8\ub2e4. 3. \uc55e\uc758 \uc9c0\ud615\uc744 \uc0b4\ud3b4\ubcf4\uace0 \ubbf8\ub9ac \uacbd\ub85c\ub97c \uacc4\ud68d\ud569\ub2c8\ub2e4. \ube44\uad50\ud45c: \uc18d\ub3c4 \uc800\ud558: \ucee8\ud2b8\ub864 \uc6a9\uc774; \uc18d\ub3c4 \uc99d\uac00: \ub099\ud558 \ube48\ub3c4 \uc99d\uac00."}, {"question": "Rooftop Run\uc5d0\ub294 \uc228\uaca8\uc9c4 \uc2dc\uc791 \uce90\ub9ad\ud130\uac00 \uc788\uc2b5\ub2c8\uae4c? \uadf8\ub9ac\uace0 \uc5b4\ub5bb\uac8c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Rooftop Run\uc5d0\ub294 \uac8c\uc784 \uacbd\ud5d8\uc744 \ub354\uc6b1 \ud48d\ubd80\ud558\uac8c \ud574\uc8fc\ub294 \uba87 \uac00\uc9c0 \ud2b9\ubcc4\ud55c \uc2dc\uc791 \uce90\ub9ad\ud130\uac00 \uc228\uaca8\uc838 \uc788\uc2b5\ub2c8\ub2e4! \uc608\ub97c \ub4e4\uc5b4, '\ub2cc\uc790 \uc2e0\uc870'\ub294 5\ubc88\uc758 \uc644\ubcbd\ud55c \uc810\ud504(\uc810\ud504 \ud6c4 \ud50c\ub7ab\ud3fc \uac00\uc7a5\uc790\ub9ac\uc5d0 \uc815\ud655\ud788 \ucc29\uc9c0)\ub97c \uc5f0\uc18d\uc73c\ub85c \uc218\ud589\ud574\uc57c \ud569\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uce90\ub9ad\ud130 '\ub3c4\uc2dc \ud5cc\ud130'\ub294 \uac8c\uc784 \ub0b4 \ubaa8\ub4e0 \ud2b9\uc218 \ucf54\uc778\uc744 \uc218\uc9d1\ud574\uc57c \ud569\ub2c8\ub2e4. \uac01 \ub808\ubca8\uc744 \uc790\uc138\ud788 \ud0d0\ud5d8\ud558\uba74 \uc774\ub7ec\ud55c \ub180\ub77c\uc6c0\uc744 \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4!"}, {"question": "Rooftop Run\uc758 \uacbd\ud5d8 \ub9ce\uc740 \ud50c\ub808\uc774\uc5b4\ub294 \uccb4\uc778 \uc810\ud504\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uace0 \ub192\uc740 \uc810\uc218\ub97c \uc720\uc9c0\ud558\uae30 \uc704\ud574 \uc5b4\ub5a4 \ubc29\ubc95\uc744 \uc0ac\uc6a9\ud569\ub2c8\uae4c?", "answer": "\ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc73c\ub824\uba74 \uccb4\uc778 \uc810\ud504 \uae30\uc220\uc774 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4! STEP1: \ub2e4\uc74c \ucc29\uc9c0 \uc9c0\uc810\uc744 \uc608\uce21\ud558\uace0 \ubbf8\ub9ac \ubc29\ud5a5\uc744 \uc870\uc815\ud569\ub2c8\ub2e4. STEP2: \uce90\ub9ad\ud130\uac00 \ucc29\uc9c0 \uc9c1\uc804\uc5d0 \uc989\uc2dc \uc810\ud504 \ubc84\ud2bc\uc744 \ub20c\ub7ec \uc644\ubcbd\ud55c \uc5f0\uacb0\uc744 \ub9cc\ub4ed\ub2c8\ub2e4. STEP3: \uacbd\uc0ac\uba74\uacfc \uac19\uc740 \uc9c0\ud615 \ud2b9\uc9d5\uc744 \ud65c\uc6a9\ud558\uc5ec \ucd94\uac00\uc801\uc778 \uc18d\ub3c4 \uac00\uc18d\uc744 \uc5bb\uc2b5\ub2c8\ub2e4. \ube44\uad50\ud45c: \uc77c\ubc18 \uc810\ud504: \uc18d\ub3c4 \uac10\uc18c \uc18d\ub3c4\uac00 \ube60\ub984; \uc644\ubcbd \uccb4\uc778 \uc810\ud504: \uc18d\ub3c4 \uc9c0\uc18d \uc99d\uac00, \uc810\uc218 \uc99d\uac00."}, {"question": "Rooftop Run \uace0\uc218 \ub808\ubca8: \uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\ub294 \uc2ac\ub77c\uc774\ub4dc \uba54\ucee4\ub2c8\uc998\uc744 \uc5b4\ub5bb\uac8c \ud65c\uc6a9\ud558\uba70, \uace0\uae09 \uae30\uc220\uc740 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc2ac\ub77c\uc774\ub529\uc740 Rooftop Run\uc758 \uace0\uae09 \uae30\uc220 \uc911 \ud558\ub098\ub85c, \uc881\uc740 \uacf5\uac04\uc744 \ube60\ub974\uac8c \uc774\ub3d9\ud558\uace0 \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \uace0\uae09 \ud65c\uc6a9\ubc95: 1. \ube60\ub978 \uc18d\ub3c4\ub85c \ub2ec\ub9ac\uace0 \uc788\uc744 \ub54c \uc2ac\ub77c\uc774\ub4dc\ub97c \uc0ac\uc6a9\ud558\uba74 \uc2ac\ub77c\uc774\ub529 \uac70\ub9ac\ub97c \ub298\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 2. \uc810\ud504\uc640 \uc2ac\ub77c\uc774\ub4dc\ub97c \uacb0\ud569\ud558\uba74 \uacf5\uc911 \ubcc0\ud658\uc744 \uc218\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 3. \ub0ae\uc740 \uc7a5\uc560\ubb3c\uc774 \uc788\uc744 \ub54c \uc2ac\ub77c\uc774\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc9c1\uc811 \ud1b5\uacfc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud750\ub984\ub3c4: \ucd9c\ubc1c \u2192 \uac00\uc18d \ub2ec\ub9ac\uae30 \u2192 \uc2ac\ub77c\uc774\ub529 \ubc84\ud2bc \ub204\ub974\uae30 \u2192 \uc2ac\ub77c\uc774\ub529 \ub3d9\uc791\uc744 \uc774\uc6a9\ud558\uc5ec \uc7a5\uc560\ubb3c \ud53c\ud558\uae30 \ub610\ub294 \ud1b5\uacfc\ud558\uae30."}, {"question": "Rooftop Run\uc5d0\uc11c, \ub7f0\uc744 \ub9c8\ucce4\uc74c\uc5d0\ub3c4 \ubd88\uad6c\ud558\uace0 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ubcf4\ub2e4 \uc810\uc218\uac00 \ub0ae\uc740 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \ub354 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uae30 \uc704\ud574 \uacbd\ub85c\ub97c \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc810\uc218\ub294 \ub2e8\uc21c\ud788 \ub7f0\uc744 \uc644\ub8cc\ud558\ub294 \uac83\ub9cc\uc73c\ub85c \uacb0\uc815\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4! \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc694\uc18c\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: \uc218\uc9d1\ud55c \ucf54\uc778 \uc218, \uc644\ub8cc\ud55c \ud2b9\uc218 \ub3d9\uc791(\uc608: \uc644\ubcbd\ud55c \uc810\ud504\uc640 \uc2ac\ub77c\uc774\ub4dc) \uc218, \ud1b5\uacfc \uc2dc\uac04. \uacbd\ub85c \ucd5c\uc801\ud654 \ud575\uc2ec\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: 1. \uac00\ub2a5\ud55c \ud55c \ub9ce\uc740 \ucf54\uc778\uc744 \uc218\uc9d1\ud569\ub2c8\ub2e4. 2. \uace0\ub09c\ub3c4 \ub3d9\uc791\uc5d0 \ub3c4\uc804\ud558\uc5ec \ucd94\uac00 \uc810\uc218\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. 3. \uc9c0\ub3c4\uc5d0 \uc775\uc219\ud574\uc838 \uac00\uc7a5 \uc9e7\uc740 \uacbd\ub85c\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. \uac01 \ub808\ubca8\uc744 \uc5ec\ub7ec \ub2e8\uacc4\ub85c \ub098\ub204\uace0 \uac01 \ub2e8\uacc4\uc5d0 \ub300\ud55c \ucd5c\uc801 \uc804\ub7b5\uc744 \ubd84\uc11d\ud574 \ubcf4\uc138\uc694."}, {"question": "Rooftop Run \ud0d0\uad6c: Rooftop Run\uc5d0\uc11c \uce90\ub9ad\ud130 \uc18d\ub3c4\uc640 \uc810\ud504 \uac70\ub9ac\ub97c \uc9c0\ubc30\ud558\ub294 \uae30\ubcf8 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Rooftop Run\uc758 \uce90\ub9ad\ud130 \uc18d\ub3c4\uc640 \uc810\ud504 \uac70\ub9ac\ub294 \uc5ec\ub7ec \uc694\uc778\uc5d0 \uc758\ud574 \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \uae30\ubcf8 \uc18d\ub3c4\ub294 \uce90\ub9ad\ud130 \uc18d\uc131\uc5d0 \uc758\ud574 \uacb0\uc815\ub418\uace0, \uce90\ub9ad\ud130 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \ud1b5\ud574 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc810\ud504 \uac70\ub9ac\ub294 \uc18d\ub3c4, \uc810\ud504 \uac01\ub3c4 \ubc0f \uc9c0\ud615\uc5d0 \uc758\ud574 \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \uac8c\uc784\uc5d0\ub294 '\uc6b4\ub3d9\ub7c9 \ucd95\uc801'\uacfc \uac19\uc740 \uc228\uaca8\uc9c4 \uac12\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. \uc5f0\uc18d\uc801\uc778 \uc644\ubcbd\ud55c \ub3d9\uc791\uc740 \uce90\ub9ad\ud130 \uc18d\ub3c4\ub97c \uc57d\uac04 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uac12\uc740 \uac8c\uc784\uc758 \uae4a\uc774\ub97c \ub354\ud569\ub2c8\ub2e4."}, {"question": "Rooftop Run \uc810\uc218 \ubd84\uc11d: \ud2b9\ud788 \uc2b9\uc218\uc640 \ubcf4\ub108\uc2a4 \uc810\uc218\uc640 \uad00\ub828\ud558\uc5ec \uac8c\uc784\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "Rooftop Run\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ub9e4\uc6b0 \uc720\uc5f0\ud569\ub2c8\ub2e4. \uae30\ubcf8 \uc810\uc218\ub294 \ucf54\uc778 \uc218\uc9d1\uacfc \ub3d9\uc791 \uc644\ub8cc\uc5d0\uc11c \ub098\uc624\uc9c0\ub9cc, \uc2e4\uc81c \ud575\uc2ec\uc740 \ubc30\uc728 \uc2dc\uc2a4\ud15c\uc785\ub2c8\ub2e4. \uc5f0\uc18d\uc801\uc778 \uc644\ubcbd\ud55c \uc810\ud504, \uc2ac\ub77c\uc774\ub4dc \ub4f1\uc758 \ub3d9\uc791\uc740 \ubc30\uc728\uc744 \uc99d\uac00\uc2dc\ud0a4\uc9c0\ub9cc, \uc911\ub2e8\ub418\uba74 \ubc30\uc728\uc774 \ucd08\uae30\ud654\ub429\ub2c8\ub2e4. \ub530\ub77c\uc11c \uc5f0\uc18d\uc801\uc778 \ub3d9\uc791\uc744 \uc720\uc9c0\ud558\ub294 \uac83\uc774 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\ub294 \ud575\uc2ec\uc785\ub2c8\ub2e4. \ub610\ud55c, \uac8c\uc784\uc5d0\ub294 \uc228\uaca8\uc9c4 \uc5c5\uc801\uc774 \uc788\uc73c\uba70, \uc774\ub97c \ub2ec\uc131\ud558\uba74 \ucd94\uac00 \ubcf4\ub108\uc2a4 \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ube44\uad50\ud45c: \uc77c\ubc18 \ub3d9\uc791: 1\ubc30; \uc5f0\uc18d \uc644\ubcbd: \ubc30\uc728 \uc99d\uac00."}, {"question": "Rooftop Run \ub2e4\uc911 \ud50c\ub7ab\ud3fc \ubb38\uc81c: \uc0c8\ub85c\uc6b4 \uae30\uae30\ub85c \uc804\ud658\ud558\uba74 Rooftop Run\uc758 \uc9c4\ud589 \uc0c1\ud669\uacfc \uc7a0\uae08 \ud574\uc81c\ub41c \ucf58\ud150\uce20\uac00 \uc804\uc1a1\ub418\uba70, \ub370\uc774\ud130 \ub9c8\uc774\uadf8\ub808\uc774\uc158\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud55c \ub2e8\uacc4\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 Rooftop Run\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uae30\uc874 \uae30\uae30\uc5d0\uc11c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uace0 \ud074\ub77c\uc6b0\ub4dc \ub3d9\uae30\ud654\ub97c \ud65c\uc131\ud654\ud558\uc2ed\uc2dc\uc624. \uc0c8 \uae30\uae30\ub97c \uc0ac\uc6a9\ud558\uc5ec \uac19\uc740 \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uba74 \uac8c\uc784\uc774 \uc790\ub3d9\uc73c\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud569\ub2c8\ub2e4. \ubb38\uc81c\uac00 \ubc1c\uc0dd\ud558\uba74 \uc218\ub3d9 \ub3d9\uae30\ud654\ub97c \uc2dc\ub3c4\ud558\uac70\ub098 \uace0\uac1d \uc9c0\uc6d0\ud300\uc5d0 \ubb38\uc758\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uacc4\uc815 \uc815\ubcf4\ub97c \ubc18\ub4dc\uc2dc \uae30\uc5b5\ud558\uc5ec \ub370\uc774\ud130 \uc190\uc2e4\uc744 \ubc29\uc9c0\ud558\uc2ed\uc2dc\uc624."}, {"question": "Rooftop Run \ube44\ubc00 \ucc3e\uae30: Rooftop Run\uc5d0\ub294 \ud2b9\ud788 \ub808\ubca8 \ub514\uc790\uc778 \ub610\ub294 \ud14c\ub9c8 \uc694\uc18c\uc640 \uad00\ub828\ub41c \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub098 \ube44\ubc00 \uc601\uc5ed\uc774 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Rooftop Run\uc5d0\ub294 \ub2e4\uc218\uc758 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4! \uc608\ub97c \ub4e4\uc5b4, '\ub3c4\uc2dc \uc625\uc0c1' \ub808\ubca8\uc5d0\uc11c \ud2b9\uc815 \uad11\uace0\ud310\uc5d0 \uc138 \ubc88 \uc5f0\uc18d \uc810\ud504\ud558\uba74 \uc228\uaca8\uc9c4 \uadf8\ub9bc\uc774 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \ub610\ud55c '\uacf5\uc5c5 \uc9c0\uc5ed' \ub808\ubca8\uc5d0\uc11c \ubc30\uacbd\uc744 \uc790\uc138\ud788 \uc0b4\ud3b4\ubcf4\uba74 \ud074\ub798\uc2dd \ub7f0\ub2dd \uac8c\uc784\uc744 \ud5cc\uc815\ud558\ub294 \uc694\uc18c\ub97c \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ucc3e\uc544\ubcf4\uba74 \uac8c\uc784 \uc138\uacc4\uc5d0 \ub300\ud574 \ub354 \uae4a\uc774 \uc774\ud574\ud558\uace0 \ud0d0\ud5d8\uc758 \uc7ac\ubbf8\ub97c \ub354\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
[{"question": "\u5982\u4f55\u5728\u8db3\u7403\u9583\u96fb\u4e2d\u5feb\u901f\u638c\u63e1\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1\u8db3\u7403\u9583\u96fb\u7684\u57fa\u672c\u63a7\u5236\uff0c\u8acb\u5148\u719f\u6089\u87a2\u5e55\u4e0a\u7684\u6309\u9215\u3002\u5de6\u6416\u687f\u63a7\u5236\u7403\u54e1\u79fb\u52d5\uff0c\u53f3\u908a\u6309\u9215\u5247\u63a7\u5236\u50b3\u7403\u3001\u5c04\u9580\u548c\u6514\u622a\u7b49\u52d5\u4f5c\u3002\u4f8b\u5982\uff0c\u8981\u50b3\u7403\uff0c\u53ea\u8981\u968a\u53cb\u5728\u9644\u8fd1\u6642\u8f15\u89f8\u300c\u50b3\u7403\u300d\u6309\u9215\u5373\u53ef\u3002\u5728\u8a13\u7df4\u6a21\u5f0f\u4e2d\u7df4\u7fd2\u9019\u4e9b\u63a7\u5236\uff0c\u5efa\u7acb\u808c\u8089\u8a18\u61b6\u3002\u6b64\u5916\uff0c\u5728\u8a2d\u5b9a\u4e2d\u8abf\u6574\u63a7\u5236\u654f\u611f\u5ea6\uff0c\u4ee5\u7b26\u5408\u60a8\u7684\u8212\u9069\u5ea6\u3002\u8acb\u8a18\u4f4f\uff0c\u6301\u7e8c\u7df4\u7fd2\u662f\u638c\u63e1\u57fa\u672c\u6280\u5de7\u7684\u95dc\u9375\u3002"}, {"question": "\u9ad8\u7d1a\u73a9\u5bb6\u5728\u8db3\u7403\u9583\u96fb\u4e2d\u5f97\u5206\u6700\u4f73\u7b56\u7565\u70ba\u4f55\uff1f", "answer": "\u5728\u8db3\u7403\u9583\u96fb\u4e2d\u9032\u7403\u9700\u8981\u7b56\u7565\u548c\u6280\u5de7\u7684\u7d50\u5408\u3002\u6b65\u9a5f\u4e00\uff1a\u901a\u904e\u7403\u54e1\u4e4b\u9593\u5feb\u901f\u50b3\u7403\u4f86\u5efa\u7acb\u9032\u653b\uff0c\u5275\u9020\u7a7a\u9593\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u6280\u5de7\u52d5\u4f5c\uff0c\u4f8b\u5982\u300c\u5411\u524d\u4e00\u6b65\u300d\u6216\u300c\u5047\u5c04\u9580\u300d\uff0c\u4f86\u6b3a\u9a19\u9632\u5b88\u8005\u3002\u4f8b\u5982\uff0c\u57f7\u884c\u300c\u5047\u5c04\u9580\u300d\u53ef\u4ee5\u8a98\u4f7f\u9632\u5b88\u8005\u505a\u51fa\u53cd\u61c9\uff0c\u8b93\u60a8\u80fd\u5920\u7a81\u7834\u4ed6\u5011\u3002\u6b65\u9a5f\u4e09\uff1a\u7576\u8655\u65bc\u5c04\u9580\u4f4d\u7f6e\u6642\uff0c\u7784\u6e96\u7403\u9580\u89d2\u843d\u4ee5\u63d0\u9ad8\u5f97\u5206\u6a5f\u6703\u3002\u5728\u300c\u9ad8\u7d1a\u5c04\u9580\u300d\u8a13\u7df4\u6a21\u7d44\u4e2d\u7df4\u7fd2\u9019\u4e9b\u6b65\u9a5f\uff0c\u4ee5\u7cbe\u7149\u60a8\u7684\u6280\u5de7\u3002"}, {"question": "\u70ba\u4f55\u4e86\u89e3\u8db3\u7403\u9583\u96fb\u4e2d\u7684\u9ad4\u529b\u7cfb\u7d71\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u4e86\u89e3\u8db3\u7403\u9583\u96fb\u4e2d\u7684\u9ad4\u529b\u7cfb\u7d71\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6703\u76f4\u63a5\u5f71\u97ff\u7403\u54e1\u7684\u8868\u73fe\u3002\u6bcf\u500b\u7403\u54e1\u90fd\u6709\u9ad4\u529b\u689d\uff0c\u5728\u8dd1\u6b65\u3001\u6514\u622a\u6216\u57f7\u884c\u6280\u5de7\u52d5\u4f5c\u6642\u6703\u6d88\u8017\u3002\u7576\u9ad4\u529b\u4f4e\u6642\uff0c\u7403\u54e1\u79fb\u52d5\u901f\u5ea6\u6703\u8b8a\u6162\uff0c\u800c\u4e14\u5728\u52d5\u4f5c\u4e2d\u6548\u7387\u964d\u4f4e\u3002\u4f8b\u5982\uff0c\u9ad4\u529b\u4f4e\u7684\u9032\u653b\u7403\u54e1\u53ef\u80fd\u6703\u932f\u5931\u95dc\u9375\u7684\u5c04\u9580\u3002\u8981\u7ba1\u7406\u9ad4\u529b\uff0c\u8acb\u7d93\u5e38\u66ff\u63db\u7403\u54e1\uff0c\u4e26\u7b56\u7565\u6027\u5730\u4f7f\u7528\u300c\u66ff\u63db\u300d\u529f\u80fd\u3002\u6b64\u5916\uff0c\u5c08\u6ce8\u65bc\u8a13\u7df4\u9ad4\u529b\u503c\u9ad8\u7684\u7403\u54e1\uff0c\u4ee5\u5728\u6bd4\u8cfd\u4e2d\u4fdd\u6301\u7af6\u722d\u512a\u52e2\u3002"}, {"question": "\u8db3\u7403\u9583\u96fb\u7684\u914d\u5c0d\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u8db3\u7403\u9583\u96fb\u7684\u914d\u5c0d\u7cfb\u7d71\u4f7f\u7528\u6f14\u7b97\u6cd5\u4f86\u5c07\u5177\u6709\u76f8\u4f3c\u6280\u80fd\u6c34\u5e73\u7684\u7403\u54e1\u914d\u5c0d\u3002\u5b83\u6703\u8003\u616e\u7372\u52dd/\u5931\u6557\u7387\u3001\u7403\u54e1\u6578\u64da\u548c\u6700\u8fd1\u7684\u8868\u73fe\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u9023\u7e8c\u8d0f\u5f97\u4e09\u5834\u6bd4\u8cfd\uff0c\u7cfb\u7d71\u53ef\u80fd\u6703\u8b93\u60a8\u5c0d\u6297\u7a0d\u5f37\u7684\u5c0d\u624b\uff0c\u4ee5\u7dad\u6301\u5e73\u8861\u3002\u9019\u78ba\u4fdd\u4e86\u4e00\u500b\u516c\u5e73\u4e14\u6709\u7af6\u722d\u529b\u7684\u74b0\u5883\u3002\u6b64\u5916\uff0c\u8a72\u7cfb\u7d71\u6703\u52d5\u614b\u8abf\u6574\uff0c\u5373\u4f7f\u60a8\u8f38\u6389\u5e7e\u5834\u6bd4\u8cfd\uff0c\u4e5f\u6703\u8207\u66f4\u9069\u5408\u60a8\u7576\u524d\u6280\u80fd\u6c34\u5e73\u7684\u5c0d\u624b\u914d\u5c0d\u3002"}, {"question": "\u8db3\u7403\u9583\u96fb\u5404\u7a2e\u904a\u6232\u6a21\u5f0f\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u70ba\u4f55\uff1f", "answer": "\u8db3\u7403\u9583\u96fb\u63d0\u4f9b\u5e7e\u7a2e\u904a\u6232\u6a21\u5f0f\uff0c\u6bcf\u7a2e\u6a21\u5f0f\u90fd\u6709\u5176\u7368\u7279\u7684\u529f\u80fd\u3002\u300c\u5feb\u901f\u5339\u914d\u300d\u975e\u5e38\u9069\u5408\u4f11\u9592\u904a\u6232\uff0c\u63d0\u4f9b\u6a19\u6e96 5 \u5206\u9418\u7684\u6bd4\u8cfd\u3002\u300c\u8077\u696d\u6a21\u5f0f\u300d\u8b93\u60a8\u53ef\u4ee5\u5728\u591a\u500b\u8cfd\u5b63\u4e2d\u7ba1\u7406\u7403\u968a\uff0c\u5c08\u6ce8\u65bc\u9577\u671f\u7684\u7b56\u7565\u3002\u300c\u9326\u6a19\u8cfd\u6a21\u5f0f\u300d\u8b93\u60a8\u5c0d\u6297\u8d8a\u4f86\u8d8a\u5f37\u7684\u5c0d\u624b\uff0c\u4ee5\u8d0f\u53d6\u7368\u5bb6\u734e\u52f5\u3002\u4f8b\u5982\uff0c\u5728\u300c\u9326\u6a19\u8cfd\u6a21\u5f0f\u300d\u4e2d\uff0c\u60a8\u5728\u6700\u5f8c\u4e00\u5834\u6bd4\u8cfd\u4e2d\u53ef\u80fd\u9047\u5230\u6574\u9ad4\u8a55\u7d1a\u66f4\u9ad8\u7684\u7403\u968a\uff0c\u9700\u8981\u5148\u9032\u7684\u7b56\u7565\u624d\u80fd\u7372\u52dd\u3002\u77ad\u89e3\u9019\u4e9b\u5dee\u7570\u6709\u52a9\u65bc\u60a8\u9078\u64c7\u6700\u9069\u5408\u60a8\u7684\u904a\u6232\u98a8\u683c\u7684\u6a21\u5f0f\u3002"}, {"question": "\u7403\u54e1\u5982\u4f55\u5728\u8db3\u7403\u9583\u96fb\u4e2d\u6709\u6548\u4f7f\u7528\u9663\u578b\u4ee5\u7372\u5f97\u512a\u52e2\uff1f", "answer": "\u5728\u8db3\u7403\u9583\u96fb\u4e2d\u6709\u6548\u4f7f\u7528\u9663\u578b\u53ef\u4ee5\u5e36\u4f86\u986f\u8457\u7684\u512a\u52e2\u3002\u6b65\u9a5f\u4e00\uff1a\u5206\u6790\u5c0d\u624b\u9663\u578b\u4e26\u8abf\u6574\u60a8\u7684\u9663\u578b\u4ee5\u53cd\u5236\u4e4b\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4ed6\u5011\u4f7f\u7528 4-3-3 \u9663\u578b\uff0c4-2-3-1 \u9663\u578b\u53ef\u4ee5\u5e6b\u52a9\u60a8\u63a7\u5236\u4e2d\u5834\u3002\u6b65\u9a5f\u4e8c\uff1a\u8abf\u6574\u7403\u54e1\u4f4d\u7f6e\u4ee5\u5229\u7528\u5f31\u9ede\u3002\u5c07\u60a8\u7684\u901f\u5ea6\u6700\u5feb\u7684\u7403\u54e1\u79fb\u5230\u908a\u8def\u4ee5\u8d85\u8d8a\u5c0d\u624b\u7684\u908a\u5f8c\u885b\u3002\u6b65\u9a5f\u4e09\uff1a\u5728\u53cb\u8abc\u8cfd\u4e2d\u7df4\u7fd2\u4e0d\u540c\u7684\u9663\u578b\u4ee5\u67e5\u770b\u54ea\u7a2e\u9663\u578b\u6700\u9069\u5408\u60a8\u7684\u7403\u968a\u512a\u52e2\u3002\u8acb\u8a18\u4f4f\uff0c\u9663\u578b\u7684\u9748\u6d3b\u6027\u53ef\u80fd\u6539\u8b8a\u6bd4\u8cfd\u7684\u7d50\u679c\u3002"}, {"question": "\u7403\u54e1\u5316\u5b78\u5728\u8db3\u7403\u9583\u96fb\u4e2d\u610f\u7fa9\u70ba\u4f55\uff0c\u4ee5\u53ca\u5982\u4f55\u6539\u9032\uff1f", "answer": "\u8db3\u7403\u9583\u96fb\u4e2d\u7684\u7403\u54e1\u5316\u5b78\u6703\u986f\u8457\u5f71\u97ff\u7403\u968a\u8868\u73fe\u3002\u9ad8\u5316\u5b78\u6709\u52a9\u65bc\u63d0\u5347\u7403\u54e1\u6578\u64da\uff0c\u8b93\u4ed6\u5011\u5728\u6bd4\u8cfd\u4e2d\u66f4\u6709\u6548\u7387\u3002\u5316\u5b78\u53d7\u56e0\u7d20\u5f71\u97ff\uff0c\u4f8b\u5982\u570b\u7c4d\u3001\u806f\u8cfd\u548c\u4ff1\u6a02\u90e8\u96b8\u5c6c\u95dc\u4fc2\u3002\u4f8b\u5982\uff0c\u64c1\u6709\u4f86\u81ea\u540c\u4e00\u4ff1\u6a02\u90e8\u7684\u4e09\u500b\u7403\u54e1\u53ef\u4ee5\u63d0\u9ad8\u4ed6\u5011\u7684\u5316\u5b78\u8a55\u7d1a\u3002\u8981\u6539\u5584\u5316\u5b78\uff0c\u8acb\u5c08\u6ce8\u65bc\u7d44\u6210\u5177\u6709\u76f8\u5bb9\u7403\u54e1\u7684\u7403\u968a\u3002\u4f7f\u7528\u5546\u5e97\u4e2d\u63d0\u4f9b\u7684\u300c\u5316\u5b78\u589e\u5f37\u5291\u300d\u7269\u54c1\u5728\u95dc\u9375\u6bd4\u8cfd\u4e2d\u66ab\u6642\u63d0\u5347\u5316\u5b78\u3002\u64c1\u6709\u9ad8\u5316\u5b78\u5e73\u8861\u7684\u7403\u968a\u66f4\u6709\u53ef\u80fd\u7372\u5f97\u6210\u529f\u3002"}, {"question": "\u7403\u54e1\u5982\u4f55\u5c07\u8db3\u7403\u9583\u96fb\u6578\u64da\u8f49\u79fb\u5230\u4e0d\u540c\u7684\u5e73\u53f0\uff1f", "answer": "\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e4b\u9593\u8f49\u79fb\u8db3\u7403\u9583\u96fb\u6578\u64da\u975e\u5e38\u7c21\u55ae\u3002\u9996\u5148\uff0c\u8acb\u78ba\u4fdd\u60a8\u5df2\u9023\u7d50\u904a\u6232\u4f3a\u670d\u5668\u5e33\u6236\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9e iOS \u8f49\u79fb\u5230 Android\uff0c\u8acb\u5c07\u60a8\u7684\u5e33\u6236\u9023\u7d50\u5230 Facebook \u6216 Google Play\u3002\u6b65\u9a5f\u4e00\uff1a\u5728\u60a8\u7684\u65b0\u88dd\u7f6e\u4e0a\u6253\u958b\u904a\u6232\uff0c\u4e26\u9078\u64c7\u300c\u5e33\u6236\u9023\u7d50\u300d\u9078\u9805\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u5148\u524d\u88dd\u7f6e\u4e0a\u4f7f\u7528\u7684\u76f8\u540c\u6191\u64da\u767b\u5165\u3002\u6b65\u9a5f\u4e09\uff1a\u7cfb\u7d71\u63d0\u793a\u6642\uff0c\u78ba\u8a8d\u8f49\u79fb\u3002\u60a8\u7684\u9032\u5ea6\uff0c\u5305\u62ec\u7403\u54e1\u3001\u786c\u5e63\u548c\u6210\u5c31\uff0c\u90fd\u5c07\u540c\u6b65\u3002\u5728\u958b\u59cb\u8f49\u79fb\u4e4b\u524d\uff0c\u8acb\u52d9\u5fc5\u5099\u4efd\u60a8\u7684\u6578\u64da\u3002"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728\u8db3\u7403\u9583\u96fb\u4e2d\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "\u8db3\u7403\u9583\u96fb\u5145\u6eff\u4e86\u96b1\u85cf\u529f\u80fd\u548c\u5f69\u86cb\u3002\u4e00\u500b\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\u300c\u91d1\u9774\u734e\u300d\u6210\u5c31\uff0c\u900f\u904e\u55ae\u4e00\u4f4d\u7403\u54e1\u9032\u7403 100 \u5206\u4f86\u89e3\u9396\u3002\u53e6\u4e00\u500b\u96b1\u85cf\u529f\u80fd\u662f\u300c\u79d8\u5bc6\u8a13\u7df4\u5834\u300d\uff0c\u900f\u904e\u5b8c\u6210\u4e3b\u9078\u55ae\u4e2d\u7684\u7279\u5b9a\u52d5\u4f5c\u9806\u5e8f\u4f86\u89e3\u9396\u3002\u4f8b\u5982\uff0c\u5feb\u901f\u9023\u7e8c\u9ede\u64ca\u904a\u6232\u6a19\u8a8c\u5341\u6b21\uff0c\u5373\u53ef\u89e3\u9396\u6b64\u5340\u57df\uff0c\u4e26\u63d0\u4f9b\u7368\u5bb6\u7684\u8a13\u7df4\u64cd\u7df4\u3002\u63a2\u7d22\u9019\u4e9b\u96b1\u85cf\u5143\u7d20\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u984d\u5916\u7684\u6a02\u8da3\u548c\u6311\u6230\u3002"}, {"question": "\u904a\u6232\u5167\u7d93\u6fdf\u9ad4\u5236\u5728\u8db3\u7403\u9583\u96fb\u4e2d\u5982\u4f55\u904b\u4f5c\uff0c\u4ee5\u53ca\u8cfa\u53d6\u786c\u5e63\u7684\u6700\u4f73\u65b9\u6cd5\u70ba\u4f55\uff1f", "answer": "\u8db3\u7403\u9583\u96fb\u7684\u904a\u6232\u5167\u7d93\u6fdf\u9ad4\u5236\u570d\u7e5e\u8457\u786c\u5e63\u904b\u4f5c\uff0c\u7528\u65bc\u8cfc\u8cb7\u7403\u54e1\u3001\u5347\u7d1a\u548c\u7269\u54c1\u3002\u53ef\u4ee5\u900f\u904e\u5404\u7a2e\u65b9\u6cd5\u8cfa\u53d6\u786c\u5e63\uff1a\u8d0f\u5f97\u6bd4\u8cfd\u3001\u5b8c\u6210\u6bcf\u65e5\u6311\u6230\u548c\u53c3\u8207\u6d3b\u52d5\u3002\u4f8b\u5982\uff0c\u8d0f\u5f97\u300c\u9326\u6a19\u8cfd\u6a21\u5f0f\u300d\u6bd4\u8cfd\u53ef\u4ee5\u8b93\u4f60\u7372\u5f97 500 \u679a\u786c\u5e63\u3002\u6b64\u5916\uff0c\u5728\u300c\u734e\u52f5\u300d\u90e8\u5206\u89c0\u770b\u5ee3\u544a\u6216\u5b8c\u6210\u512a\u60e0\u6d3b\u52d5\u53ef\u4ee5\u984d\u5916\u7372\u5f97\u786c\u5e63\u3002\u8981\u6700\u5927\u5316\u6536\u76ca\uff0c\u8acb\u5c08\u6ce8\u65bc\u9ad8\u56de\u5831\u7684\u6d3b\u52d5\uff0c\u4e26\u660e\u667a\u5730\u7ba1\u7406\u60a8\u7684\u652f\u51fa\u3002\u5c0d\u904a\u6232\u5167\u7d93\u6fdf\u9ad4\u5236\u63a1\u53d6\u5e73\u8861\u7684\u7b56\u7565\uff0c\u78ba\u4fdd\u7a69\u5b9a\u7684\u9032\u5ea6\u3002"}]
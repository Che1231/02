[{"question": "\u8db3\u7403\u72c2\u6f6e\u65b0\u73a9\u5bb6\u5982\u4f55\u5feb\u901f\u638c\u63e1\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1\u8db3\u7403\u72c2\u6f6e\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u9996\u5148\u8981\u719f\u6089\u5c4f\u5e55\u4e0a\u7684\u6309\u94ae\u3002\u5de6\u6447\u6746\u63a7\u5236\u73a9\u5bb6\u79fb\u52a8\uff0c\u53f3\u8fb9\u7684\u6309\u94ae\u5219\u63a7\u5236\u4f20\u7403\u3001\u5c04\u95e8\u548c\u94f2\u7403\u7b49\u52a8\u4f5c\u3002\u4f8b\u5982\uff0c\u8981\u4f20\u7403\uff0c\u53ea\u9700\u5728\u961f\u53cb\u9644\u8fd1\u65f6\u70b9\u51fb\u201c\u4f20\u7403\u201d\u6309\u94ae\u3002\u5728\u8bad\u7ec3\u6a21\u5f0f\u4e2d\u7ec3\u4e60\u8fd9\u4e9b\u64cd\u4f5c\uff0c\u53ef\u4ee5\u5efa\u7acb\u808c\u8089\u8bb0\u5fc6\u3002\u6b64\u5916\uff0c\u8fd8\u53ef\u4ee5\u8c03\u6574\u8bbe\u7f6e\u4e2d\u7684\u63a7\u5236\u7075\u654f\u5ea6\uff0c\u4f7f\u5176\u66f4\u7b26\u5408\u60a8\u7684\u8212\u9002\u5ea6\u3002\u8bb0\u4f4f\uff0c\u6301\u7eed\u7ec3\u4e60\u662f\u638c\u63e1\u57fa\u7840\u7684\u5173\u952e\u3002"}, {"question": "\u5bf9\u4e8e\u9ad8\u7ea7\u73a9\u5bb6\u6765\u8bf4\uff0c\u5728\u8db3\u7403\u72c2\u6f6e\u4e2d\u53d6\u5f97\u8fdb\u7403\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u8db3\u7403\u72c2\u6f6e\u4e2d\u8fdb\u7403\u9700\u8981\u7b56\u7565\u548c\u6280\u5de7\u76f8\u7ed3\u5408\u3002\u6b65\u9aa4\u4e00\uff1a\u901a\u8fc7\u73a9\u5bb6\u4e4b\u95f4\u7684\u5feb\u901f\u4f20\u7403\u5efa\u7acb\u8fdb\u653b\uff0c\u521b\u9020\u7a7a\u95f4\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u6280\u5de7\u52a8\u4f5c\uff0c\u4f8b\u5982\u201c\u8de8\u8d8a\u201d\u6216\u201c\u5047\u5c04\u201d\u6765\u8ff7\u60d1\u9632\u5b88\u961f\u5458\u3002\u4f8b\u5982\uff0c\u6267\u884c\u201c\u5047\u5c04\u201d\u53ef\u4ee5\u4f7f\u9632\u5b88\u961f\u5458\u505a\u51fa\u53cd\u5e94\uff0c\u8ba9\u4f60\u5f97\u4ee5\u7a81\u7834\u4ed6\u4eec\u3002\u6b65\u9aa4\u4e09\uff1a\u5f53\u5904\u4e8e\u5c04\u95e8\u4f4d\u7f6e\u65f6\uff0c\u7784\u51c6\u7403\u95e8\u7684\u89d2\u90e8\uff0c\u4ee5\u63d0\u9ad8\u8fdb\u7403\u7387\u3002\u5728\u201c\u9ad8\u7ea7\u5c04\u95e8\u201d\u8bad\u7ec3\u6a21\u5757\u4e2d\u7ec3\u4e60\u8fd9\u4e9b\u6b65\u9aa4\uff0c\u53ef\u4ee5\u5b8c\u5584\u60a8\u7684\u6280\u5de7\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u7406\u89e3\u8db3\u7403\u72c2\u6f6e\u4e2d\u7684\u4f53\u529b\u7cfb\u7edf\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u7406\u89e3\u8db3\u7403\u72c2\u6f6e\u4e2d\u7684\u4f53\u529b\u7cfb\u7edf\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u76f4\u63a5\u5f71\u54cd\u73a9\u5bb6\u7684\u8868\u73b0\u3002\u6bcf\u4e2a\u73a9\u5bb6\u90fd\u6709\u4e00\u4e2a\u4f53\u529b\u6761\uff0c\u5f53\u4ed6\u4eec\u5954\u8dd1\u3001\u94f2\u7403\u6216\u6267\u884c\u6280\u5de7\u52a8\u4f5c\u65f6\uff0c\u4f53\u529b\u6761\u4f1a\u6d88\u8017\u3002\u5f53\u4f53\u529b\u964d\u4f4e\u65f6\uff0c\u73a9\u5bb6\u79fb\u52a8\u901f\u5ea6\u4f1a\u53d8\u6162\uff0c\u52a8\u4f5c\u6548\u7387\u4e5f\u4f1a\u964d\u4f4e\u3002\u4f8b\u5982\uff0c\u4f53\u529b\u4f4e\u7684\u950b\u7ebf\u7403\u5458\u53ef\u80fd\u4f1a\u9519\u8fc7\u5173\u952e\u7684\u5c04\u95e8\u673a\u4f1a\u3002\u4e3a\u4e86\u7ba1\u7406\u4f53\u529b\uff0c\u8981\u9891\u7e41\u8f6e\u6362\u7403\u5458\uff0c\u5e76\u6218\u7565\u6027\u5730\u4f7f\u7528\u201c\u66ff\u8865\u201d\u529f\u80fd\u3002\u6b64\u5916\uff0c\u4e13\u6ce8\u4e8e\u8bad\u7ec3\u4f53\u529b\u503c\u9ad8\u7684\u7403\u5458\uff0c\u624d\u80fd\u5728\u6bd4\u8d5b\u5168\u7a0b\u4fdd\u6301\u7ade\u4e89\u4f18\u52bf\u3002"}, {"question": "\u8db3\u7403\u72c2\u6f6e\u7684\u5339\u914d\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u8db3\u7403\u72c2\u6f6e\u7684\u5339\u914d\u7cfb\u7edf\u4f7f\u7528\u7b97\u6cd5\u6765\u5c06\u6280\u80fd\u6c34\u5e73\u76f8\u4f3c\u7684\u73a9\u5bb6\u914d\u5bf9\u3002\u5b83\u4f1a\u8003\u8651\u80dc/\u8d1f\u6bd4\u7387\u3001\u7403\u5458\u5c5e\u6027\u548c\u6700\u8fd1\u7684\u8868\u73b0\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u8fde\u7eed\u8d62\u4e86\u4e09\u573a\u6bd4\u8d5b\uff0c\u7cfb\u7edf\u53ef\u80fd\u4f1a\u5c06\u60a8\u4e0e\u7565\u5fae\u66f4\u5f3a\u7684\u5bf9\u624b\u8fdb\u884c\u5339\u914d\uff0c\u4ee5\u4fdd\u6301\u5e73\u8861\u3002\u8fd9\u786e\u4fdd\u4e86\u516c\u5e73\u7684\u7ade\u4e89\u73af\u5883\u3002\u6b64\u5916\uff0c\u8be5\u7cfb\u7edf\u4f1a\u52a8\u6001\u8c03\u6574\uff0c\u5373\u4f7f\u60a8\u8f93\u4e86\u51e0\u573a\u6bd4\u8d5b\uff0c\u4e5f\u4f1a\u5c06\u60a8\u4e0e\u66f4\u9002\u5408\u60a8\u5f53\u524d\u6280\u80fd\u6c34\u5e73\u7684\u5bf9\u624b\u8fdb\u884c\u5339\u914d\u3002"}, {"question": "\u8db3\u7403\u72c2\u6f6e\u7684\u5404\u79cd\u6e38\u620f\u6a21\u5f0f\u4e4b\u95f4\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u8db3\u7403\u72c2\u6f6e\u63d0\u4f9b\u591a\u79cd\u6e38\u620f\u6a21\u5f0f\uff0c\u6bcf\u79cd\u6a21\u5f0f\u90fd\u6709\u5176\u72ec\u7279\u7684\u7279\u70b9\u3002\u201c\u5feb\u901f\u5339\u914d\u201d\u6700\u9002\u5408\u4f11\u95f2\u6e38\u620f\uff0c\u63d0\u4f9b\u6807\u51c6\u7684 5 \u5206\u949f\u6bd4\u8d5b\u3002\u201c\u804c\u4e1a\u6a21\u5f0f\u201d\u8ba9\u60a8\u53ef\u4ee5\u5728\u591a\u4e2a\u8d5b\u5b63\u4e2d\u7ba1\u7406\u4e00\u652f\u7403\u961f\uff0c\u4fa7\u91cd\u4e8e\u957f\u671f\u7b56\u7565\u3002\u201c\u9526\u6807\u8d5b\u6a21\u5f0f\u201d\u8ba9\u60a8\u4e0e\u8d8a\u6765\u8d8a\u5f3a\u5927\u7684\u5bf9\u624b\u7ade\u4e89\uff0c\u8d62\u5f97\u72ec\u5bb6\u5956\u52b1\u3002\u4f8b\u5982\uff0c\u5728\u201c\u9526\u6807\u8d5b\u6a21\u5f0f\u201d\u4e2d\uff0c\u60a8\u5728\u51b3\u8d5b\u4e2d\u53ef\u80fd\u9762\u4e34\u4e00\u652f\u6574\u4f53\u8bc4\u5206\u66f4\u9ad8\u7684\u961f\u4f0d\uff0c\u9700\u8981\u5148\u8fdb\u7684\u6218\u672f\u624d\u80fd\u83b7\u80dc\u3002\u4e86\u89e3\u8fd9\u4e9b\u533a\u522b\u6709\u52a9\u4e8e\u60a8\u9009\u62e9\u6700\u9002\u5408\u60a8\u6e38\u620f\u98ce\u683c\u7684\u6a21\u5f0f\u3002"}, {"question": "\u7403\u5458\u5982\u4f55\u5728\u8db3\u7403\u72c2\u6f6e\u4e2d\u6709\u6548\u4f7f\u7528\u9635\u578b\u6765\u83b7\u5f97\u4f18\u52bf\uff1f", "answer": "\u5728\u8db3\u7403\u72c2\u6f6e\u4e2d\u6709\u6548\u4f7f\u7528\u9635\u578b\u53ef\u4ee5\u83b7\u5f97\u663e\u8457\u4f18\u52bf\u3002\u6b65\u9aa4\u4e00\uff1a\u5206\u6790\u5bf9\u624b\u7684\u9635\u578b\u5e76\u8c03\u6574\u60a8\u7684\u9635\u578b\u4ee5\u5bf9\u5176\u8fdb\u884c\u53cd\u51fb\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4ed6\u4eec\u4f7f\u7528 4-3-3 \u9635\u578b\uff0c4-2-3-1 \u9635\u578b\u53ef\u4ee5\u5e2e\u52a9\u60a8\u63a7\u5236\u4e2d\u573a\u3002\u6b65\u9aa4\u4e8c\uff1a\u81ea\u5b9a\u4e49\u7403\u5458\u4f4d\u7f6e\u4ee5\u5229\u7528\u5bf9\u624b\u7684\u5f31\u70b9\u3002\u5c06\u60a8\u901f\u5ea6\u6700\u5feb\u7684\u7403\u5458\u653e\u5728\u8fb9\u8def\uff0c\u4ee5\u8d85\u8d8a\u5bf9\u624b\u7684\u8fb9\u540e\u536b\u3002\u6b65\u9aa4\u4e09\uff1a\u5728\u53cb\u8c0a\u8d5b\u4e2d\u7ec3\u4e60\u4e0d\u540c\u7684\u9635\u578b\uff0c\u770b\u770b\u54ea\u79cd\u9635\u578b\u6700\u9002\u5408\u60a8\u7403\u961f\u7684\u4f18\u52bf\u3002\u8bb0\u4f4f\uff0c\u9635\u578b\u7684\u7075\u6d3b\u6027\u53ef\u4ee5\u6539\u53d8\u6bd4\u8d5b\u7ed3\u679c\u3002"}, {"question": "\u7403\u5458\u4e4b\u95f4\u7684\u5316\u5b66\u5c5e\u6027\u5728\u8db3\u7403\u72c2\u6f6e\u4e2d\u6709\u4ec0\u4e48\u610f\u4e49\uff0c\u4ee5\u53ca\u5982\u4f55\u63d0\u9ad8\uff1f", "answer": "\u8db3\u7403\u72c2\u6f6e\u4e2d\u7403\u5458\u7684\u5316\u5b66\u5c5e\u6027\u4f1a\u663e\u8457\u5f71\u54cd\u56e2\u961f\u8868\u73b0\u3002\u9ad8\u5316\u5b66\u503c\u4f1a\u63d0\u5347\u7403\u5458\u5c5e\u6027\uff0c\u4f7f\u4ed6\u4eec\u5728\u6bd4\u8d5b\u4e2d\u66f4\u6709\u6548\u7387\u3002\u5316\u5b66\u503c\u53d7\u56fd\u5bb6\u3001\u8054\u8d5b\u548c\u4ff1\u4e50\u90e8\u96b6\u5c5e\u5173\u7cfb\u7b49\u56e0\u7d20\u7684\u5f71\u54cd\u3002\u4f8b\u5982\uff0c\u62e5\u6709\u6765\u81ea\u540c\u4e00\u4ff1\u4e50\u90e8\u7684\u4e09\u540d\u7403\u5458\u53ef\u4ee5\u63d0\u5347\u4ed6\u4eec\u7684\u5316\u5b66\u503c\u3002\u4e3a\u4e86\u63d0\u9ad8\u5316\u5b66\u503c\uff0c\u4e13\u6ce8\u4e8e\u7ec4\u5efa\u4e00\u652f\u5177\u6709\u517c\u5bb9\u7403\u5458\u7684\u7403\u961f\u3002\u4f7f\u7528\u5546\u5e97\u4e2d\u63d0\u4f9b\u7684\u201c\u5316\u5b66\u63d0\u5347\u5242\u201d\u7269\u54c1\uff0c\u53ef\u4ee5\u5728\u5173\u952e\u6bd4\u8d5b\u4e2d\u6682\u65f6\u63d0\u5347\u5316\u5b66\u503c\u3002\u4e00\u652f\u5316\u5b66\u503c\u9ad8\u7684\u5e73\u8861\u7403\u961f\u66f4\u6709\u53ef\u80fd\u53d6\u5f97\u6210\u529f\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5c06\u4ed6\u4eec\u7684\u8db3\u7403\u72c2\u6f6e\u6570\u636e\u8f6c\u79fb\u5230\u4e0d\u540c\u7684\u5e73\u53f0\uff1f", "answer": "\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u8db3\u7403\u72c2\u6f6e\u6570\u636e\u975e\u5e38\u7b80\u5355\u3002\u9996\u5148\uff0c\u8bf7\u786e\u4fdd\u60a8\u5df2\u5c06\u5e10\u6237\u94fe\u63a5\u5230\u6e38\u620f\u7684\u670d\u52a1\u5668\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u4ece iOS \u8f6c\u5230 Android\uff0c\u8bf7\u5c06\u60a8\u7684\u5e10\u6237\u94fe\u63a5\u5230 Facebook \u6216 Google Play\u3002\u6b65\u9aa4\u4e00\uff1a\u5728\u65b0\u7684\u8bbe\u5907\u4e0a\u6253\u5f00\u6e38\u620f\uff0c\u9009\u62e9\u201c\u5e10\u6237\u94fe\u63a5\u201d\u9009\u9879\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u60a8\u5728\u4ee5\u524d\u8bbe\u5907\u4e0a\u4f7f\u7528\u7684\u76f8\u540c\u51ed\u636e\u767b\u5f55\u3002\u6b65\u9aa4\u4e09\uff1a\u5728\u63d0\u793a\u65f6\u786e\u8ba4\u6570\u636e\u8f6c\u79fb\u3002\u60a8\u7684\u8fdb\u5ea6\uff0c\u5305\u62ec\u7403\u5458\u3001\u91d1\u5e01\u548c\u6210\u5c31\uff0c\u90fd\u5c06\u540c\u6b65\u3002\u5728\u5f00\u59cb\u6570\u636e\u8f6c\u79fb\u4e4b\u524d\uff0c\u8bf7\u52a1\u5fc5\u5907\u4efd\u60a8\u7684\u6570\u636e\u3002"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728\u8db3\u7403\u72c2\u6f6e\u4e2d\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "\u8db3\u7403\u72c2\u6f6e\u5145\u6ee1\u4e86\u9690\u85cf\u529f\u80fd\u548c\u5f69\u86cb\u3002\u503c\u5f97\u6ce8\u610f\u7684\u662f\u201c\u91d1\u9774\u201d\u6210\u5c31\uff0c\u901a\u8fc7\u4e00\u540d\u7403\u5458\u5b8c\u6210 100 \u4e2a\u8fdb\u7403\u5373\u53ef\u89e3\u9501\u3002\u53e6\u4e00\u4e2a\u9690\u85cf\u529f\u80fd\u662f\u201c\u79d8\u5bc6\u8bad\u7ec3\u573a\u201d\uff0c\u901a\u8fc7\u5728\u4e3b\u83dc\u5355\u4e2d\u5b8c\u6210\u7279\u5b9a\u5e8f\u5217\u7684\u52a8\u4f5c\u5373\u53ef\u8bbf\u95ee\u3002\u4f8b\u5982\uff0c\u5feb\u901f\u8fde\u7eed\u70b9\u51fb\u6e38\u620f\u56fe\u6807\u5341\u6b21\u5373\u53ef\u89e3\u9501\u8be5\u533a\u57df\uff0c\u63d0\u4f9b\u72ec\u5bb6\u7684\u8bad\u7ec3\u7ec3\u4e60\u3002\u63a2\u7d22\u8fd9\u4e9b\u9690\u85cf\u5143\u7d20\uff0c\u4e3a\u6e38\u620f\u589e\u6dfb\u4e86\u989d\u5916\u7684\u4e50\u8da3\u548c\u6311\u6218\u3002"}, {"question": "\u6e38\u620f\u5185\u7684\u7ecf\u6d4e\u673a\u5236\u5982\u4f55\u5728\u8db3\u7403\u72c2\u6f6e\u4e2d\u8fd0\u4f5c\uff0c\u4ee5\u53ca\u83b7\u5f97\u91d1\u5e01\u7684\u6700\u4f73\u65b9\u6cd5\u6709\u54ea\u4e9b\uff1f", "answer": "\u8db3\u7403\u72c2\u6f6e\u7684\u6e38\u620f\u7ecf\u6d4e\u673a\u5236\u56f4\u7ed5\u7740\u91d1\u5e01\u8fd0\u4f5c\uff0c\u91d1\u5e01\u7528\u4e8e\u8d2d\u4e70\u7403\u5458\u3001\u5347\u7ea7\u548c\u7269\u54c1\u3002\u53ef\u4ee5\u901a\u8fc7\u591a\u79cd\u65b9\u6cd5\u83b7\u5f97\u91d1\u5e01\uff1a\u8d62\u5f97\u6bd4\u8d5b\u3001\u5b8c\u6210\u6bcf\u65e5\u6311\u6218\u548c\u53c2\u4e0e\u6d3b\u52a8\u3002\u4f8b\u5982\uff0c\u8d62\u5f97\u201c\u9526\u6807\u8d5b\u6a21\u5f0f\u201d\u6bd4\u8d5b\u53ef\u4ee5\u5956\u52b1\u60a8 500 \u4e2a\u91d1\u5e01\u3002\u6b64\u5916\uff0c\u5728\u201c\u5956\u52b1\u201d\u90e8\u5206\u89c2\u770b\u5e7f\u544a\u6216\u5b8c\u6210\u4efb\u52a1\u4ee5\u83b7\u5f97\u989d\u5916\u91d1\u5e01\u3002\u4e3a\u4e86\u6700\u5927\u5316\u6536\u76ca\uff0c\u91cd\u70b9\u5173\u6ce8\u9ad8\u56de\u62a5\u6d3b\u52a8\uff0c\u5e76\u660e\u667a\u5730\u7ba1\u7406\u60a8\u7684\u652f\u51fa\u3002\u5e73\u8861\u5730\u53c2\u4e0e\u6e38\u620f\u7ecf\u6d4e\uff0c\u786e\u4fdd\u7a33\u5b9a\u8fdb\u6b65\u3002"}]
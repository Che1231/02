[{"question": "\ud48b\ubcfc \ube14\ub9ac\uce20\uc5d0\uc11c \uc0c8 \ud50c\ub808\uc774\uc5b4\uac00 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \uc775\ud788\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud48b\ubcfc \ube14\ub9ac\uce20\uc5d0\uc11c \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \uc775\ud788\ub824\uba74, \uba3c\uc800 \ud654\uba74 \ubc84\ud2bc\uc5d0 \uc775\uc219\ud574\uc9c0\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc67c\ucabd \uc870\uc774\uc2a4\ud2f1\uc73c\ub85c \ud50c\ub808\uc774\uc5b4 \uc774\ub3d9\uc744, \uc624\ub978\ucabd \ubc84\ud2bc\uc73c\ub85c \ud328\uc2a4, \uc288\ud305, \ud0dc\ud074\uacfc \uac19\uc740 \ud589\ub3d9\uc744 \uc870\uc791\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub3d9\ub8cc \ud50c\ub808\uc774\uc5b4\uac00 \uadfc\ucc98\uc5d0 \uc788\uc744 \ub54c \uacf5\uc744 \ud328\uc2a4\ud558\ub824\uba74, \"\ud328\uc2a4\" \ubc84\ud2bc\uc744 \ub204\ub974\uc138\uc694. \ud6c8\ub828 \ubaa8\ub4dc\uc5d0\uc11c \uc774\ub7ec\ud55c \ucee8\ud2b8\ub864\uc744 \uc5f0\uc2b5\ud558\uc5ec \uadfc\uc721 \uae30\uc5b5\ub825\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \ub610\ud55c \uc124\uc815\uc5d0\uc11c \ucee8\ud2b8\ub864 \ubbfc\uac10\ub3c4\ub97c \uc790\uc2e0\uc758 \uc218\uc900\uc5d0 \ub9de\ucdb0 \uc870\uc815\ud558\uba74 \ub354\uc6b1 \ud6a8\uc728\uc801\uc785\ub2c8\ub2e4. \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc775\ud788\ub824\uba74 \uafb8\uc900\ud55c \uc5f0\uc2b5\uc774 \uc911\uc694\ud569\ub2c8\ub2e4."}, {"question": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \ud48b\ubcfc \ube14\ub9ac\uce20\uc5d0\uc11c \uace8\uc744 \ub123\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud48b\ubcfc \ube14\ub9ac\uce20\uc5d0\uc11c \uace8\uc744 \ub123\uc73c\ub824\uba74 \uc804\ub7b5\uacfc \uae30\uc220\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \ud50c\ub808\uc774\uc5b4 \uac04 \ube60\ub978 \ud328\uc2a4\ub85c \uacf5\uac04\uc744 \ub9cc\ub4e4\uc5b4 \ud50c\ub808\uc774\ub97c \uc2dc\uc791\ud558\uace0, STEP2: \"\uc2a4\ud15d \uc624\ubc84\"\ub098 \"\uac00\uc9dc \uc288\ud305\"\uacfc \uac19\uc740 \uae30\uc220 \ub3d9\uc791\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc218\ube44\uc218\ub97c \uc18d\uc774\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \"\uac00\uc9dc \uc288\ud305\"\uc744 \uc2dc\ub3c4\ud558\uba74 \uc218\ube44\uc218\uac00 \uc18d\uc544 \ub118\uc5b4\uc9c0\uba74\uc11c \ub4dc\ub9ac\ube14\uc744 \ud560 \uc218 \uc788\ub294 \uae30\ud68c\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP3: \uace8\ub300 \uad6c\uc11d\uc744 \ub178\ub824 \uace8\uc744 \ub123\uc744 \ud655\ub960\uc744 \ub192\uc774\uc138\uc694. \"\uace0\uae09 \uc288\ud305\" \ud6c8\ub828 \ubaa8\ub4c8\uc5d0\uc11c \uc774\ub7ec\ud55c \ub2e8\uacc4\ub4e4\uc744 \uc5f0\uc2b5\ud558\uc5ec \uae30\uc220\uc744 \uc5f0\ub9c8\ud558\uc138\uc694."}, {"question": "\ud48b\ubcfc \ube14\ub9ac\uce20\uc5d0\uc11c \uc2a4\ud0dc\ubbf8\ub098 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud48b\ubcfc \ube14\ub9ac\uce20\uc5d0\uc11c \uc2a4\ud0dc\ubbf8\ub098 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \ud50c\ub808\uc774\uc5b4 \uc131\ub2a5\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \uac01 \ud50c\ub808\uc774\uc5b4\ub294 \ub2ec\ub9ac\uae30, \ud0dc\ud074, \uae30\uc220 \ub3d9\uc791\uc744 \uc218\ud589\ud560 \ub54c \uc2a4\ud0dc\ubbf8\ub098\uac00 \uc18c\ubaa8\ub418\ub294 \uc2a4\ud0dc\ubbf8\ub098 \ubc14\ub97c \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc2a4\ud0dc\ubbf8\ub098\uac00 \ubd80\uc871\ud558\uba74 \ud50c\ub808\uc774\uc5b4\uc758 \uc6c0\uc9c1\uc784\uc774 \ub290\ub824\uc9c0\uace0 \ud589\ub3d9 \ud6a8\uc728\uc774 \ub5a8\uc5b4\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc2a4\ud0dc\ubbf8\ub098\uac00 \ubd80\uc871\ud55c \uacf5\uaca9\uc218\ub294 \uc911\uc694\ud55c \uc288\ud305 \uae30\ud68c\ub97c \ub193\uce60 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2a4\ud0dc\ubbf8\ub098\ub97c \uad00\ub9ac\ud558\ub824\uba74 \ud50c\ub808\uc774\uc5b4\ub97c \uc790\uc8fc \uad50\uccb4\ud558\uace0 \"\uad50\uccb4\" \uae30\ub2a5\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc138\uc694. \ub610\ud55c, \uacbd\uae30 \ub0b4\ub0b4 \uacbd\uc7c1\ub825\uc744 \uc720\uc9c0\ud558\uae30 \uc704\ud574 \ub192\uc740 \uc2a4\ud0dc\ubbf8\ub098 \ub2a5\ub825\uce58\ub97c \uac00\uc9c4 \ud50c\ub808\uc774\uc5b4\ub97c \ud6c8\ub828\uc2dc\ud0a4\uc138\uc694."}, {"question": "\ud48b\ubcfc \ube14\ub9ac\uce20\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "\ud48b\ubcfc \ube14\ub9ac\uce20\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \uc720\uc0ac\ud55c \uc2e4\ub825\uc758 \ud50c\ub808\uc774\uc5b4\ub97c \ub9e4\uce6d\ud558\ub294 \uc54c\uace0\ub9ac\uc998\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc2b9/\ud328 \ube44\uc728, \ud50c\ub808\uc774\uc5b4 \ud1b5\uacc4, \ucd5c\uadfc \uc131\uc801 \ub4f1\uc744 \uace0\ub824\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5f0\uc18d\uc73c\ub85c \uc138 \ubc88 \uc2b9\ub9ac\ud558\uba74 \uc2dc\uc2a4\ud15c\uc5d0\uc11c \ub354 \uac15\ub825\ud55c \uc0c1\ub300\uc640 \ub9e4\uce6d\ud558\uc5ec \uade0\ud615\uc744 \uc720\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub294 \uacf5\uc815\ud558\uace0 \uacbd\uc7c1\uc801\uc778 \ud658\uacbd\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4. \ub610\ud55c \uc2dc\uc2a4\ud15c\uc740 \ub3d9\uc801\uc73c\ub85c \uc870\uc815\ub418\ubbc0\ub85c, \uba87 \ubc88\uc758 \ud328\ubc30 \ud6c4\uc5d0\ub3c4 \ud604\uc7ac \uc2e4\ub825\uc5d0 \ub9de\ub294 \uc0c1\ub300\uc640 \ub9e4\uce6d\ub429\ub2c8\ub2e4."}, {"question": "\ud48b\ubcfc \ube14\ub9ac\uce20\uc758 \ub2e4\uc591\ud55c \uac8c\uc784 \ubaa8\ub4dc \uac04\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud48b\ubcfc \ube14\ub9ac\uce20\uc5d0\ub294 \uac01\uac01 \uace0\uc720\ud55c \uae30\ub2a5\uc744 \uac00\uc9c4 \uc5ec\ub7ec \uac8c\uc784 \ubaa8\ub4dc\uac00 \uc788\uc2b5\ub2c8\ub2e4. \"\ube60\ub978 \ub9e4\uce58\"\ub294 \uce90\uc8fc\uc5bc \ud50c\ub808\uc774\uc5d0 \uc801\ud569\ud558\uba70, \ud45c\uc900 5\ubd84 \uac8c\uc784\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \"\uacbd\ub825 \ubaa8\ub4dc\"\ub294 \uc5ec\ub7ec \uc2dc\uc98c \ub3d9\uc548 \ud300\uc744 \uad00\ub9ac\ud558\uc5ec \uc7a5\uae30\uc801\uc778 \uc804\ub7b5\uc5d0 \ucd08\uc810\uc744 \ub9de\ucd9c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \"\ud1a0\ub108\uba3c\ud2b8 \ubaa8\ub4dc\"\ub294 \ub3c5\uc810\uc801\uc778 \ubcf4\uc0c1\uc744 \uc5bb\uc744 \uae30\ud68c\ub97c \uc704\ud574 \uc810\uc810 \uac15\ub825\ud55c \uc0c1\ub300\uc640 \uacbd\uc7c1\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ud1a0\ub108\uba3c\ud2b8 \ubaa8\ub4dc\"\uc5d0\uc11c \ub9c8\uc9c0\ub9c9 \uacbd\uae30\uc5d0\uc11c \uc0c1\ub300\ud300 \uc804\uccb4 \ud3c9\uc810\uc774 \ub354 \ub192\uc740 \uacbd\uc6b0, \uc6b0\uc2b9\ud558\uae30 \uc704\ud55c \uace0\uae09 \uc804\uc220\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ucc28\uc774\uc810\uc744 \uc774\ud574\ud558\uba74 \uc790\uc2e0\uc758 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \uac00\uc7a5 \uc801\ud569\ud55c \ubaa8\ub4dc\ub97c \uc120\ud0dd\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\ud50c\ub808\uc774\uc5b4\uac00 \ud48b\ubcfc \ube14\ub9ac\uce20\uc5d0\uc11c \uc5b4\ub5bb\uac8c \ud3ec\uba54\uc774\uc158\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc5ec \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud48b\ubcfc \ube14\ub9ac\uce20\uc5d0\uc11c \ud3ec\uba54\uc774\uc158\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uba74 \uc0c1\ub2f9\ud55c \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \uc0c1\ub300\uc758 \ud3ec\uba54\uc774\uc158\uc744 \ubd84\uc11d\ud558\uace0 \uc774\uc5d0 \ub9de\uc11c \uc790\uc2e0\uc758 \ud3ec\uba54\uc774\uc158\uc744 \uc870\uc815\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc0c1\ub300\uac00 4-3-3 \ud3ec\uba54\uc774\uc158\uc744 \uc0ac\uc6a9\ud558\uba74 4-2-3-1 \ud3ec\uba54\uc774\uc158\uc744 \uc0ac\uc6a9\ud558\uc5ec \ubbf8\ub4dc\ud544\ub4dc\ub97c \uc7a5\uc545\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP2: \ud50c\ub808\uc774\uc5b4 \uc704\uce58\ub97c \ub9de\ucda4 \uc124\uc815\ud558\uc5ec \uc57d\uc810\uc744 \uacf5\uaca9\ud558\uc138\uc694. \uc0c1\ub300 \ud480\ubc31\uc744 \uc81c\uce58\uae30 \uc704\ud574 \uac00\uc7a5 \ube60\ub978 \ud50c\ub808\uc774\uc5b4\ub97c \uc719\uc73c\ub85c \uc774\ub3d9\ud558\uc138\uc694. STEP3: \uce5c\uc120 \uacbd\uae30\uc5d0\uc11c \ub2e4\uc591\ud55c \ud3ec\uba54\uc774\uc158\uc744 \uc5f0\uc2b5\ud558\uc5ec \ud300\uc758 \uac15\uc810\uc5d0 \uac00\uc7a5 \uc801\ud569\ud55c \ud3ec\uba54\uc774\uc158\uc744 \ud30c\uc545\ud558\uc138\uc694. \uc720\uc5f0\ud55c \ud3ec\uba54\uc774\uc158 \uc0ac\uc6a9\uc740 \uac8c\uc784\uc758 \ud750\ub984\uc744 \ubc14\uafc0 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud48b\ubcfc \ube14\ub9ac\uce20\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4 \ud654\ud559\ub825\uc758 \uc911\uc694\uc131\uc740 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \uac1c\uc120\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud48b\ubcfc \ube14\ub9ac\uce20\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4 \ud654\ud559\ub825\uc740 \ud300 \uc131\ub2a5\uc5d0 \ud070 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ub192\uc740 \ud654\ud559\ub825\uc740 \ud50c\ub808\uc774\uc5b4 \ub2a5\ub825\uce58\ub97c \ud5a5\uc0c1\uc2dc\ucf1c \uacbd\uae30\uc5d0\uc11c \ub354\uc6b1 \ud6a8\uacfc\uc801\uc73c\ub85c \ud65c\uc57d\ud560 \uc218 \uc788\ub3c4\ub85d \ub3c4\uc640\uc90d\ub2c8\ub2e4. \ud654\ud559\ub825\uc740 \uad6d\uc801, \ub9ac\uadf8, \ud074\ub7fd \uc18c\uc18d\uacfc \uac19\uc740 \uc694\uc18c\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac19\uc740 \ud074\ub7fd \uc18c\uc18d\uc758 \ud50c\ub808\uc774\uc5b4 3\uba85\uc774 \uc788\ub294 \uacbd\uc6b0 \ud654\ud559\ub825 \ub4f1\uae09\uc774 \ub192\uc544\uc9d1\ub2c8\ub2e4. \ud654\ud559\ub825\uc744 \uac1c\uc120\ud558\ub824\uba74 \ud638\ud658\uc131\uc774 \uc88b\uc740 \ud50c\ub808\uc774\uc5b4\ub85c \ud300\uc744 \uad6c\uc131\ud558\uc138\uc694. \ud544\uc218 \uacbd\uae30\uc5d0\uc11c \ud654\ud559\ub825\uc744 \uc77c\uc2dc\uc801\uc73c\ub85c \uac15\ud654\ud558\ub294 \"\ud654\ud559\ub825 \ubd80\uc2a4\ud130\" \uc544\uc774\ud15c\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. \ud654\ud559\ub825\uc774 \ub192\uc740 \uade0\ud615 \uc7a1\ud78c \ud300\uc740 \uc131\uacf5\ud560 \uac00\ub2a5\uc131\uc774 \ub354 \ub192\uc2b5\ub2c8\ub2e4."}, {"question": "\ud50c\ub808\uc774\uc5b4\uac00 \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ud48b\ubcfc \ube14\ub9ac\uce20 \ub370\uc774\ud130\ub97c \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ud48b\ubcfc \ube14\ub9ac\uce20 \ub370\uc774\ud130\ub97c \uc804\uc1a1\ud558\ub294 \uac83\uc740 \uac04\ub2e8\ud569\ub2c8\ub2e4. \uba3c\uc800 \uac8c\uc784 \uc11c\ubc84\uc640 \uacc4\uc815\uc744 \uc5f0\uacb0\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, iOS\uc5d0\uc11c Android\ub85c \uc774\ub3d9\ud560 \ub54c\ub294 Facebook \ub610\ub294 Google Play\uc5d0 \uacc4\uc815\uc744 \uc5f0\uacb0\ud558\uc138\uc694. STEP1: \uc0c8\ub85c\uc6b4 \uae30\uae30\uc5d0\uc11c \uac8c\uc784\uc744 \uc5f4\uace0 \"\uacc4\uc815 \uc5f0\uacb0\" \uc635\uc158\uc744 \uc120\ud0dd\ud558\uc138\uc694. STEP2: \uc774\uc804 \uae30\uae30\uc640 \ub3d9\uc77c\ud55c \uc790\uaca9 \uc99d\uba85\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uc138\uc694. STEP3: \uba54\uc2dc\uc9c0\uac00 \ud45c\uc2dc\ub418\uba74 \uc804\uc1a1\uc744 \ud655\uc778\ud558\uc138\uc694. \ud50c\ub808\uc774\uc5b4, \ucf54\uc778, \uc5c5\uc801 \ub4f1 \ubaa8\ub4e0 \uc9c4\ud589 \uc0c1\ud669\uc774 \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. \uc804\uc1a1\uc744 \uc2dc\uc791\ud558\uae30 \uc804\uc5d0 \ud56d\uc0c1 \ub370\uc774\ud130\ub97c \ubc31\uc5c5\ud558\uc138\uc694."}, {"question": "\ud48b\ubcfc \ube14\ub9ac\uce20\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud48b\ubcfc \ube14\ub9ac\uce20\uc5d0\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ub9ce\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ud55c \uac00\uc9c0 \uc8fc\ubaa9\ud560 \ub9cc\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ub2e8 \ud55c \uba85\uc758 \ud50c\ub808\uc774\uc5b4\ub85c 100\uace8\uc744 \ub123\uc73c\uba74 \ud65c\uc131\ud654\ub418\ub294 \"\uace8\ub4e0 \ubd80\uce20\" \uc5c5\uc801\uc785\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc740 \uba54\uc778 \uba54\ub274\uc5d0\uc11c \ud2b9\uc815 \uc21c\uc11c\uc758 \ud589\ub3d9\uc744 \ub9c8\uce58\uba74 \uc811\uadfc\ud560 \uc218 \uc788\ub294 \"\ube44\ubc00 \ud6c8\ub828\uc7a5\"\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub85c\uace0\ub97c \uc5f0\uc18d\uc73c\ub85c 10\ubc88 \ud0ed\ud558\uba74 \uc774 \uc601\uc5ed\uc774 \uc5f4\ub9ac\uba70, \ub3c5\uc810\uc801\uc778 \ud6c8\ub828 \uc5f0\uc2b5\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uc694\uc18c\ub4e4\uc744 \ud0d0\uc0c9\ud558\uba74 \uac8c\uc784\uc5d0 \uc7ac\ubbf8\uc640 \ub3c4\uc804\uc774 \ub354\ud574\uc9d1\ub2c8\ub2e4."}, {"question": "\ud48b\ubcfc \ube14\ub9ac\uce20\uc758 \uac8c\uc784 \ub0b4 \uacbd\uc81c \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \ucf54\uc778\uc744 \uc5bb\ub294 \uac00\uc7a5 \uc88b\uc740 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud48b\ubcfc \ube14\ub9ac\uce20\uc758 \uac8c\uc784 \ub0b4 \uacbd\uc81c \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4, \uc5c5\uadf8\ub808\uc774\ub4dc, \uc544\uc774\ud15c\uc744 \uad6c\ub9e4\ud558\ub294 \ub370 \uc0ac\uc6a9\ub418\ub294 \ucf54\uc778\uc744 \uc911\uc2ec\uc73c\ub85c \ub3cc\uc544\uac11\ub2c8\ub2e4. \ucf54\uc778\uc740 \ub2e4\uc591\ud55c \ubc29\ubc95\uc73c\ub85c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uacbd\uae30 \uc2b9\ub9ac, \uc77c\uc77c \ucc4c\ub9b0\uc9c0 \uc644\ub8cc, \uc774\ubca4\ud2b8 \ucc38\uc5ec\uac00 \uadf8 \uc608\uc2dc\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ud1a0\ub108\uba3c\ud2b8 \ubaa8\ub4dc\" \uacbd\uae30\uc5d0\uc11c \uc774\uae30\uba74 500\ucf54\uc778\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \"\ubcf4\uc0c1\" \uc139\uc158\uc5d0\uc11c \uad11\uace0 \uc2dc\uccad\uc774\ub098 \uc81c\uc548 \uc644\ub8cc\ub97c \ud1b5\ud574 \ucd94\uac00 \ucf54\uc778\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc218\uc775\uc744 \uadf9\ub300\ud654\ud558\ub824\uba74 \uace0\ubcf4\uc0c1 \ud65c\ub3d9\uc5d0 \uc9d1\uc911\ud558\uace0 \uc9c0\ucd9c\uc744 \ud604\uba85\ud558\uac8c \uad00\ub9ac\ud558\uc138\uc694. \uac8c\uc784 \ub0b4 \uacbd\uc81c \uc2dc\uc2a4\ud15c\uc744 \uade0\ud615 \uc788\uac8c \ud65c\uc6a9\ud558\uba74 \uafb8\uc900\ud788 \ubc1c\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
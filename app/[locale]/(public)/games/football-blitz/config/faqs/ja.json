[{"question": "\u30d5\u30c3\u30c8\u30dc\u30fc\u30eb\u30d6\u30ea\u30c3\u30c4\u306e\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u7d20\u65e9\u304f\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d5\u30c3\u30c8\u30dc\u30fc\u30eb\u30d6\u30ea\u30c3\u30c4\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u7d20\u65e9\u304f\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u307e\u305a\u753b\u9762\u4e0a\u306e\u30dc\u30bf\u30f3\u306b\u6163\u308c\u308b\u3053\u3068\u304b\u3089\u59cb\u3081\u307e\u3059\u3002\u5de6\u306e\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u306f\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u79fb\u52d5\u3092\u3001\u53f3\u306e\u30dc\u30bf\u30f3\u306f\u30d1\u30b9\u3001\u30b7\u30e5\u30fc\u30c8\u3001\u30bf\u30c3\u30af\u30eb\u306a\u3069\u306e\u30a2\u30af\u30b7\u30e7\u30f3\u3092\u5236\u5fa1\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30c1\u30fc\u30e0\u30e1\u30a4\u30c8\u304c\u8fd1\u304f\u306b\u3044\u305f\u3089\u3001\u5358\u306b\u300c\u30d1\u30b9\u300d\u30dc\u30bf\u30f3\u3092\u30bf\u30c3\u30d7\u3059\u308b\u3060\u3051\u3067\u30dc\u30fc\u30eb\u3092\u30d1\u30b9\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u64cd\u4f5c\u3092\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u30e2\u30fc\u30c9\u3067\u7df4\u7fd2\u3057\u3066\u3001\u7b4b\u8089\u8a18\u61b6\u3092\u69cb\u7bc9\u3057\u307e\u3057\u3087\u3046\u3002\u3055\u3089\u306b\u3001\u8a2d\u5b9a\u3067\u64cd\u4f5c\u306e\u611f\u5ea6\u3092\u81ea\u5206\u306e\u5feb\u9069\u306a\u30ec\u30d9\u30eb\u306b\u8abf\u6574\u3057\u307e\u3059\u3002\u57fa\u672c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u7d99\u7d9a\u7684\u306a\u7df4\u7fd2\u304c\u91cd\u8981\u3067\u3059\u3002"}, {"question": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u305f\u3081\u306e\u30d5\u30c3\u30c8\u30dc\u30fc\u30eb\u30d6\u30ea\u30c3\u30c4\u3067\u3001\u30b4\u30fc\u30eb\u3092\u596a\u3046\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d5\u30c3\u30c8\u30dc\u30fc\u30eb\u30d6\u30ea\u30c3\u30c4\u3067\u30b4\u30fc\u30eb\u3092\u596a\u3046\u306b\u306f\u3001\u6226\u7565\u3068\u30b9\u30ad\u30eb\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30d7\u30ec\u30a4\u30e4\u30fc\u9593\u3067\u7d20\u65e9\u304f\u30d1\u30b9\u3092\u7e4b\u304e\u3001\u30b9\u30da\u30fc\u30b9\u3092\u4f5c\u308a\u51fa\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u300c\u30b9\u30c6\u30c3\u30d7\u30aa\u30fc\u30d0\u30fc\u300d\u3084\u300c\u30d5\u30a7\u30a4\u30af\u30b7\u30e5\u30fc\u30c8\u300d\u306a\u3069\u306e\u30b9\u30ad\u30eb\u52d5\u4f5c\u3092\u4f7f\u3063\u3066\u3001\u30c7\u30a3\u30d5\u30a7\u30f3\u30c0\u30fc\u3092\u6b3a\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30d5\u30a7\u30a4\u30af\u30b7\u30e5\u30fc\u30c8\u300d\u3092\u5b9f\u884c\u3059\u308b\u3053\u3068\u3067\u3001\u30c7\u30a3\u30d5\u30a7\u30f3\u30c0\u30fc\u304c\u5bfe\u5fdc\u3059\u308b\u3053\u3068\u3092\u4fc3\u3057\u3001\u30c9\u30ea\u30d6\u30eb\u3067\u5f7c\u3089\u3092\u304b\u308f\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5c04\u7a0b\u570f\u5185\u306b\u306a\u3063\u305f\u3089\u3001\u30b4\u30fc\u30eb\u306e\u30b3\u30fc\u30ca\u30fc\u3092\u72d9\u3046\u3053\u3068\u3067\u3001\u5f97\u70b9\u3059\u308b\u53ef\u80fd\u6027\u3092\u9ad8\u3081\u307e\u3059\u3002\u300c\u4e0a\u7d1a\u30b7\u30e5\u30fc\u30c8\u300d\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u30e2\u30b8\u30e5\u30fc\u30eb\u3067\u3053\u308c\u3089\u306e\u30b9\u30c6\u30c3\u30d7\u3092\u7df4\u7fd2\u3057\u3066\u3001\u6280\u8853\u3092\u6d17\u7df4\u3055\u305b\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30d5\u30c3\u30c8\u30dc\u30fc\u30eb\u30d6\u30ea\u30c3\u30c4\u3067\u30b9\u30bf\u30df\u30ca\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u306a\u305c\u91cd\u8981\u306a\u306e\u3067\u3059\u304b\uff1f", "answer": "\u30d5\u30c3\u30c8\u30dc\u30fc\u30eb\u30d6\u30ea\u30c3\u30c4\u3067\u30b9\u30bf\u30df\u30ca\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u76f4\u63a5\u5f71\u97ff\u3059\u308b\u305f\u3081\u91cd\u8981\u3067\u3059\u3002\u5404\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u306f\u3001\u8d70\u3063\u305f\u308a\u3001\u30bf\u30c3\u30af\u30eb\u3057\u305f\u308a\u3001\u30b9\u30ad\u30eb\u52d5\u4f5c\u3092\u5b9f\u884c\u3057\u305f\u308a\u3059\u308b\u3068\u6e1b\u5c11\u3059\u308b\u30b9\u30bf\u30df\u30ca\u30d0\u30fc\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30bf\u30df\u30ca\u304c\u4f4e\u3044\u3068\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u52d5\u304d\u304c\u9045\u304f\u306a\u308a\u3001\u884c\u52d5\u306e\u52b9\u679c\u304c\u4f4e\u4e0b\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b9\u30bf\u30df\u30ca\u306e\u4f4e\u3044\u30b9\u30c8\u30e9\u30a4\u30ab\u30fc\u306f\u91cd\u8981\u306a\u30b7\u30e5\u30fc\u30c8\u3092\u9003\u3057\u3066\u3057\u307e\u3046\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u30b9\u30bf\u30df\u30ca\u3092\u7ba1\u7406\u3059\u308b\u306b\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u983b\u7e41\u306b\u4ea4\u4ee3\u3055\u305b\u3001\u6226\u7565\u7684\u306b\u300c\u4ea4\u4ee3\u300d\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u8a66\u5408\u5168\u4f53\u3067\u7af6\u4e89\u529b\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u3001\u9ad8\u3044\u30b9\u30bf\u30df\u30ca\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u6301\u3064\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u80b2\u6210\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u30d5\u30c3\u30c8\u30dc\u30fc\u30eb\u30d6\u30ea\u30c3\u30c4\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d5\u30c3\u30c8\u30dc\u30fc\u30eb\u30d6\u30ea\u30c3\u30c4\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u3092\u4f7f\u7528\u3057\u3066\u3001\u985e\u4f3c\u3057\u305f\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u30da\u30a2\u30ea\u30f3\u30b0\u3057\u307e\u3059\u3002\u52dd\u6557\u7387\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u3001\u6700\u8fd1\u306e\u6210\u7e3e\u306a\u3069\u306e\u8981\u56e0\u3092\u8003\u616e\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u30013\u8a66\u5408\u9023\u7d9a\u3067\u52dd\u5229\u3057\u3066\u3044\u308b\u5834\u5408\u3001\u30d0\u30e9\u30f3\u30b9\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u3001\u30b7\u30b9\u30c6\u30e0\u306f\u3042\u306a\u305f\u3092\u308f\u305a\u304b\u306b\u5f37\u3044\u5bfe\u6226\u76f8\u624b\u3068\u30de\u30c3\u30c1\u30f3\u30b0\u3059\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u3053\u308c\u306f\u3001\u516c\u5e73\u3067\u7af6\u4e89\u529b\u306e\u3042\u308b\u74b0\u5883\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30b7\u30b9\u30c6\u30e0\u306f\u30c0\u30a4\u30ca\u30df\u30c3\u30af\u306b\u8abf\u6574\u3055\u308c\u307e\u3059\u306e\u3067\u3001\u6570\u8a66\u5408\u8ca0\u3051\u3066\u3082\u3001\u3042\u306a\u305f\u306e\u73fe\u5728\u306e\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u306b\u5408\u3063\u305f\u5bfe\u6226\u76f8\u624b\u3068\u30da\u30a2\u30ea\u30f3\u30b0\u3055\u308c\u307e\u3059\u3002"}, {"question": "\u30d5\u30c3\u30c8\u30dc\u30fc\u30eb\u30d6\u30ea\u30c3\u30c4\u306e\u3055\u307e\u3056\u307e\u306a\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d5\u30c3\u30c8\u30dc\u30fc\u30eb\u30d6\u30ea\u30c3\u30c4\u306b\u306f\u3001\u305d\u308c\u305e\u308c\u72ec\u81ea\u306e\u6a5f\u80fd\u3092\u6301\u3064\u8907\u6570\u306e\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u304c\u3042\u308a\u307e\u3059\u3002\u300c\u30af\u30a4\u30c3\u30af\u30de\u30c3\u30c1\u300d\u306f\u30ab\u30b8\u30e5\u30a2\u30eb\u306a\u30d7\u30ec\u30a4\u306b\u9069\u3057\u3066\u304a\u308a\u3001\u6a19\u6e96\u7684\u306a5\u5206\u9593\u306e\u30b2\u30fc\u30e0\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u300c\u30ad\u30e3\u30ea\u30a2\u30e2\u30fc\u30c9\u300d\u3067\u306f\u3001\u8907\u6570\u306e\u30b7\u30fc\u30ba\u30f3\u306b\u308f\u305f\u3063\u3066\u30c1\u30fc\u30e0\u3092\u7ba1\u7406\u3057\u3001\u9577\u671f\u7684\u306a\u6226\u7565\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u300c\u30c8\u30fc\u30ca\u30e1\u30f3\u30c8\u30e2\u30fc\u30c9\u300d\u3067\u306f\u3001\u9650\u5b9a\u7684\u306a\u5831\u916c\u3092\u7372\u5f97\u3059\u308b\u305f\u3081\u306b\u3001\u307e\u3059\u307e\u3059\u5f37\u529b\u306a\u5bfe\u6226\u76f8\u624b\u3068\u5bfe\u6226\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30c8\u30fc\u30ca\u30e1\u30f3\u30c8\u30e2\u30fc\u30c9\u300d\u3067\u306f\u3001\u6700\u7d42\u6226\u3067\u3001\u3088\u308a\u9ad8\u3044\u7dcf\u5408\u8a55\u4fa1\u3092\u6301\u3064\u30c1\u30fc\u30e0\u3068\u5bfe\u6226\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u3001\u52dd\u5229\u3059\u308b\u305f\u3081\u306b\u9ad8\u5ea6\u306a\u6226\u8853\u304c\u5fc5\u8981\u306b\u306a\u308b\u3067\u3057\u3087\u3046\u3002\u3053\u308c\u3089\u306e\u9055\u3044\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u81ea\u5206\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u6700\u9069\u306a\u30e2\u30fc\u30c9\u3092\u9078\u629e\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30d5\u30c3\u30c8\u30dc\u30fc\u30eb\u30d6\u30ea\u30c3\u30c4\u3067\u6709\u5229\u3092\u5f97\u308b\u305f\u3081\u306b\u3001\u30d5\u30a9\u30fc\u30e1\u30fc\u30b7\u30e7\u30f3\u3092\u52b9\u679c\u7684\u306b\u3069\u306e\u3088\u3046\u306b\u4f7f\u7528\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d5\u30c3\u30c8\u30dc\u30fc\u30eb\u30d6\u30ea\u30c3\u30c4\u3067\u30d5\u30a9\u30fc\u30e1\u30fc\u30b7\u30e7\u30f3\u3092\u52b9\u679c\u7684\u306b\u4f7f\u7528\u3059\u308b\u3068\u3001\u5927\u304d\u306a\u30a2\u30c9\u30d0\u30f3\u30c6\u30fc\u30b8\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5bfe\u6226\u76f8\u624b\u306e\u30d5\u30a9\u30fc\u30e1\u30fc\u30b7\u30e7\u30f3\u3092\u5206\u6790\u3057\u3001\u305d\u308c\u306b\u5bfe\u5fdc\u3059\u308b\u3088\u3046\u306b\u81ea\u5206\u306e\u30d5\u30a9\u30fc\u30e1\u30fc\u30b7\u30e7\u30f3\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5bfe\u6226\u76f8\u624b\u304c4-3-3\u30d5\u30a9\u30fc\u30e1\u30fc\u30b7\u30e7\u30f3\u3092\u4f7f\u7528\u3057\u3066\u3044\u308b\u5834\u5408\u30014-2-3-1\u306f\u30df\u30c3\u30c9\u30d5\u30a3\u30fc\u30eb\u30c9\u3092\u652f\u914d\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u4f4d\u7f6e\u3092\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3057\u3066\u3001\u5f31\u70b9\u3092\u5229\u7528\u3057\u307e\u3059\u3002\u5bfe\u6226\u76f8\u624b\u306e\u30d5\u30eb\u30d0\u30c3\u30af\u3092\u51fa\u3057\u629c\u304f\u305f\u3081\u306b\u3001\u6700\u901f\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u30a6\u30a3\u30f3\u30b0\u306b\u79fb\u52d5\u3055\u305b\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30d5\u30ec\u30f3\u30c9\u30ea\u30fc\u30de\u30c3\u30c1\u3067\u3055\u307e\u3056\u307e\u306a\u30d5\u30a9\u30fc\u30e1\u30fc\u30b7\u30e7\u30f3\u3092\u7df4\u7fd2\u3057\u3066\u3001\u3069\u306e\u30d5\u30a9\u30fc\u30e1\u30fc\u30b7\u30e7\u30f3\u304c\u30c1\u30fc\u30e0\u306e\u5f37\u3055\u306b\u5408\u3063\u3066\u3044\u308b\u306e\u304b\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30d5\u30a9\u30fc\u30e1\u30fc\u30b7\u30e7\u30f3\u306e\u67d4\u8edf\u6027\u306f\u30b2\u30fc\u30e0\u3092\u5909\u3048\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30d5\u30c3\u30c8\u30dc\u30fc\u30eb\u30d6\u30ea\u30c3\u30c4\u306b\u304a\u3051\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u306e\u91cd\u8981\u6027\u306f\u4f55\u3067\u3042\u308a\u3001\u3069\u306e\u3088\u3046\u306b\u6539\u5584\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d5\u30c3\u30c8\u30dc\u30fc\u30eb\u30d6\u30ea\u30c3\u30c4\u306b\u304a\u3051\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u306f\u3001\u30c1\u30fc\u30e0\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u5927\u304d\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u9ad8\u3044\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u306f\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u5411\u4e0a\u3055\u305b\u3001\u8a66\u5408\u3067\u3088\u308a\u52b9\u679c\u7684\u306b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u306f\u3001\u56fd\u7c4d\u3001\u30ea\u30fc\u30b0\u3001\u30af\u30e9\u30d6\u306e\u6240\u5c5e\u306a\u3069\u3001\u3055\u307e\u3056\u307e\u306a\u8981\u56e0\u306b\u3088\u3063\u3066\u5f71\u97ff\u3092\u53d7\u3051\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u540c\u3058\u30af\u30e9\u30d6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u30923\u4eba\u5165\u308c\u308b\u3068\u3001\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u306e\u8a55\u4fa1\u3092\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u3092\u6539\u5584\u3059\u308b\u306b\u306f\u3001\u4e92\u63db\u6027\u306e\u3042\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u30c1\u30fc\u30e0\u3092\u69cb\u7bc9\u3059\u308b\u306e\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3057\u3087\u3046\u3002\u91cd\u8981\u306a\u8a66\u5408\u3067\u4e00\u6642\u7684\u306b\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u3092\u9ad8\u3081\u308b\u305f\u3081\u306b\u3001\u30b7\u30e7\u30c3\u30d7\u3067\u5165\u624b\u3067\u304d\u308b\u300c\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u30d6\u30fc\u30b9\u30bf\u30fc\u300d\u30a2\u30a4\u30c6\u30e0\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u306e\u9ad8\u3044\u30d0\u30e9\u30f3\u30b9\u306e\u53d6\u308c\u305f\u30c1\u30fc\u30e0\u306f\u6210\u529f\u3059\u308b\u53ef\u80fd\u6027\u304c\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u30d5\u30c3\u30c8\u30dc\u30fc\u30eb\u30d6\u30ea\u30c3\u30c4\u306e\u30c7\u30fc\u30bf\u3092\u3069\u306e\u3088\u3046\u306b\u52b9\u679c\u7684\u306b\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u8907\u6570\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u30d5\u30c3\u30c8\u30dc\u30fc\u30eb\u30d6\u30ea\u30c3\u30c4\u306e\u30c7\u30fc\u30bf\u3092\u8ee2\u9001\u3059\u308b\u306e\u306f\u7c21\u5358\u3067\u3059\u3002\u307e\u305a\u3001\u30b2\u30fc\u30e0\u30b5\u30fc\u30d0\u30fc\u3068\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30ea\u30f3\u30af\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001iOS\u304b\u3089Android\u306b\u79fb\u52d5\u3059\u308b\u5834\u5408\u3001Facebook\u307e\u305f\u306fGoogle Play\u306b\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30ea\u30f3\u30af\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u30b2\u30fc\u30e0\u3092\u958b\u304d\u3001\u300c\u30a2\u30ab\u30a6\u30f3\u30c8\u30ea\u30f3\u30af\u300d\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u4ee5\u524d\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u4f7f\u7528\u3057\u3066\u3044\u305f\u540c\u3058\u8a8d\u8a3c\u60c5\u5831\u3067\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6c42\u3081\u3089\u308c\u305f\u3089\u3001\u8ee2\u9001\u3092\u627f\u8a8d\u3057\u307e\u3059\u3002\u3042\u306a\u305f\u306e\u9032\u6357\u72b6\u6cc1\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u3001\u30b3\u30a4\u30f3\u3001\u304a\u3088\u3073\u5b9f\u7e3e\u304c\u540c\u671f\u3055\u308c\u307e\u3059\u3002\u8ee2\u9001\u3092\u958b\u59cb\u3059\u308b\u524d\u306b\u3001\u5fc5\u305a\u30c7\u30fc\u30bf\u3092\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30d5\u30c3\u30c8\u30dc\u30fc\u30eb\u30d6\u30ea\u30c3\u30c4\u3067\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u3088\u3046\u306a\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d5\u30c3\u30c8\u30dc\u30fc\u30eb\u30d6\u30ea\u30c3\u30c4\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u6e80\u8f09\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306e1\u3064\u306f\u3001\u300c\u30b4\u30fc\u30eb\u30c7\u30f3\u30d6\u30fc\u30c4\u300d\u5b9f\u7e3e\u3067\u3001\u5358\u4e00\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3067100\u30b4\u30fc\u30eb\u3092\u9054\u6210\u3059\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u305d\u306e\u4ed6\u306e\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u306e1\u3064\u306f\u3001\u300c\u79d8\u5bc6\u306e\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u30b0\u30e9\u30a6\u30f3\u30c9\u300d\u3067\u3001\u30e1\u30a4\u30f3\u30e1\u30cb\u30e5\u30fc\u3067\u7279\u5b9a\u306e\u52d5\u4f5c\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3067\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ed\u30b4\u3092\u9023\u6253\u3057\u306610\u56de\u3001\u3059\u3050\u306b\u3053\u306e\u30a8\u30ea\u30a2\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u3001\u9650\u5b9a\u7684\u306a\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u6f14\u7fd2\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u96a0\u3055\u308c\u305f\u8981\u7d20\u3092\u63a2\u7d22\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u306b\u3055\u3089\u306a\u308b\u697d\u3057\u307f\u3068\u8ab2\u984c\u304c\u52a0\u308f\u308a\u307e\u3059\u3002"}, {"question": "\u30b2\u30fc\u30e0\u5185\u7d4c\u6e08\u306f\u30d5\u30c3\u30c8\u30dc\u30fc\u30eb\u30d6\u30ea\u30c3\u30c4\u3067\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u30b3\u30a4\u30f3\u3092\u7372\u5f97\u3059\u308b\u6700\u826f\u306e\u65b9\u6cd5\u306f\u3069\u3093\u306a\u3082\u306e\u3067\u3059\u304b\uff1f", "answer": "\u30d5\u30c3\u30c8\u30dc\u30fc\u30eb\u30d6\u30ea\u30c3\u30c4\u306e\u30b2\u30fc\u30e0\u5185\u7d4c\u6e08\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u3001\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3001\u30a2\u30a4\u30c6\u30e0\u3092\u8cfc\u5165\u3059\u308b\u305f\u3081\u306b\u4f7f\u7528\u3055\u308c\u308b\u30b3\u30a4\u30f3\u3092\u4e2d\u5fc3\u306b\u5c55\u958b\u3057\u3066\u3044\u307e\u3059\u3002\u30b3\u30a4\u30f3\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u65b9\u6cd5\u3067\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u8a66\u5408\u306b\u52dd\u5229\u3059\u308b\u3001\u65e5\u3005\u306e\u8ab2\u984c\u3092\u9054\u6210\u3059\u308b\u3001\u30a4\u30d9\u30f3\u30c8\u306b\u53c2\u52a0\u3059\u308b\u306a\u3069\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30c8\u30fc\u30ca\u30e1\u30f3\u30c8\u30e2\u30fc\u30c9\u300d\u306e\u8a66\u5408\u306b\u52dd\u5229\u3059\u308b\u3068\u3001500\u30b3\u30a4\u30f3\u306e\u5831\u916c\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u300c\u5831\u916c\u300d\u30bb\u30af\u30b7\u30e7\u30f3\u3067\u5e83\u544a\u3092\u898b\u305f\u308a\u3001\u30aa\u30d5\u30a1\u30fc\u3092\u5b8c\u4e86\u3057\u305f\u308a\u3057\u3066\u3001\u8ffd\u52a0\u306e\u30b3\u30a4\u30f3\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u53ce\u76ca\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u9ad8\u5831\u916c\u306e\u6d3b\u52d5\u3092\u91cd\u70b9\u7684\u306b\u884c\u3044\u3001\u652f\u51fa\u3092\u8ce2\u304f\u7ba1\u7406\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u30b2\u30fc\u30e0\u5185\u7d4c\u6e08\u3078\u306e\u30d0\u30e9\u30f3\u30b9\u306e\u53d6\u308c\u305f\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u3001\u5b89\u5b9a\u3057\u305f\u9032\u6b69\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002"}]
[{"question": "Sink It\uff1a\u65b0\u624b\u5982\u4f55\u6b63\u786e\u7784\u51c6\u548c\u53d1\u5c04\u5927\u70ae\uff1f", "answer": "\u5728Sink It\u4e2d\uff0c\u5bf9\u4e8e\u65b0\u624b\u6765\u8bf4\uff0c\u6709\u6548\u7784\u51c6\u548c\u53d1\u5c04\u81f3\u5173\u91cd\u8981\u3002\u9996\u5148\uff0c\u4f7f\u7528\u9f20\u6807\u8c03\u6574\u5927\u70ae\u7684\u89d2\u5ea6\uff1b\u89d2\u5ea6\u8d8a\u9ad8\uff0c\u5c04\u7a0b\u8d8a\u8fdc\u3002\u5176\u6b21\uff0c\u6309\u4f4f\u53d1\u5c04\u6309\u94ae\u589e\u52a0\u70ae\u5f39\u5a01\u529b\uff1b\u6309\u538b\u65f6\u95f4\u8d8a\u957f\uff0c\u5a01\u529b\u8d8a\u5927\u3002\u7b2c\u4e09\uff0c\u677e\u5f00\u6309\u94ae\u53d1\u5c04\u3002\u4f8b\u5982\uff0c\u5982\u679c\u76ee\u6807\u662f\u5c0f\u8239\uff0c\u5e76\u4e14\u8ddd\u79bb\u8f83\u8fd1\uff0c\u5219\u5e94\u4f7f\u7528\u8f83\u4f4e\u89d2\u5ea6\u548c\u8f83\u77ed\u7684\u5a01\u529b\u3002\u8bb0\u4f4f\u8981\u8003\u8651\u98ce\u5411\uff0c\u56e0\u4e3a\u5b83\u4f1a\u5f71\u54cd\u70ae\u5f39\u7684\u8f68\u8ff9\u3002\u5148\u7ec3\u4e60\u9759\u6b62\u76ee\u6807\u80fd\u591f\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u547d\u4e2d\u7387\u3002\u60f3\u8c61\u4e00\u4e0b\u6253\u7bee\u7403\uff1a\u89d2\u5ea6\u548c\u529b\u91cf\u90fd\u5f88\u91cd\u8981\uff01"}, {"question": "\u5728Sink It\u4e2d\uff0c\u5728\u53d7\u635f\u540e\u5feb\u901f\u4fee\u7406\u6211\u7684\u8239\u7684\u6700\u4f73\u65b9\u6cd5\u662f\u4ec0\u4e48\uff0c\u4e3a\u4ec0\u4e48\u8fd9\u662f\u91cd\u8981\u7684\uff1f", "answer": "\u5728Sink It\u4e2d\u6709\u6548\u5730\u4fee\u7406\u4f60\u7684\u8239\u5bf9\u4e8e\u751f\u5b58\u81f3\u5173\u91cd\u8981\u3002\u6700\u5feb\u901f\u7684\u65b9\u6cd5\u662f\u5206\u914d\u8239\u5458\u5230\u4fee\u7406\u7ad9\u3002\u5206\u914d\u7684\u8239\u5458\u8d8a\u591a\uff0c\u4fee\u7406\u901f\u5ea6\u8d8a\u5feb\u3002\u4fee\u7406\u7684\u4f18\u5148\u7ea7\u81f3\u5173\u91cd\u8981\uff1a\u9996\u5148\u4fee\u590d\u8239\u4f53\u7834\u635f\u4ee5\u9632\u6b62\u8fdb\u6c34\uff0c\u7136\u540e\u4fee\u590d\u5e06\u4ee5\u4fdd\u6301\u901f\u5ea6\u3002\u5ffd\u89c6\u4fee\u7406\u4f1a\u5bfc\u81f4\u6c89\u6ca1\uff01\u628a\u4f60\u7684\u8239\u60f3\u8c61\u6210\u6c7d\u8f66\uff1a\u5982\u679c\u4f60\u5ffd\u7565\u4e86\u7206\u80ce\uff0c\u4f60\u4f1a\u88ab\u56f0\u4f4f\u3002"}, {"question": "Sink It\uff1a\u6709\u54ea\u4e9b\u7c7b\u578b\u7684\u5f39\u836f\u53ef\u7528\uff0c\u4ee5\u53ca\u4f55\u65f6\u5e94\u8be5\u4f7f\u7528\u6bcf\u79cd\u5f39\u836f\uff1f", "answer": "Sink It\u63d0\u4f9b\u5404\u79cd\u7c7b\u578b\u7684\u5f39\u836f\uff0c\u6bcf\u79cd\u5f39\u836f\u90fd\u9002\u7528\u4e8e\u4e0d\u540c\u7684\u60c5\u51b5\u3002\u5b9e\u5fc3\u5f39\u662f\u4f60\u7684\u6807\u51c6\u5f39\u836f\uff0c\u9002\u7528\u4e8e\u4e00\u822c\u4f24\u5bb3\u3002\u94fe\u5f39\u975e\u5e38\u9002\u5408\u635f\u574f\u5e06\uff0c\u51cf\u6162\u654c\u8230\u901f\u5ea6\u3002\u8461\u8404\u5f39\u5728\u8fd1\u8ddd\u79bb\u6709\u6548\u5730\u6253\u51fb\u654c\u65b9\u8239\u5458\u3002\u6700\u540e\uff0c\u7206\u70b8\u5f39\u4f1a\u5bf9\u654c\u8230\u9020\u6210\u5de8\u5927\u4f24\u5bb3\uff0c\u4f46\u8865\u7ed9\u6210\u672c\u66f4\u9ad8\u3002\u4f8b\u5982\uff0c\u5982\u679c\u9762\u5bf9\u5feb\u901f\u7075\u6d3b\u7684\u8239\u53ea\uff0c\u5219\u5e94\u5148\u4f7f\u7528\u94fe\u5f39\u762b\u75ea\u5176\u5e06\uff0c\u7136\u540e\u518d\u4f7f\u7528\u5b9e\u5fc3\u5f39\u653b\u51fb\u3002\u628a\u5b83\u60f3\u8c61\u6210\u9ad8\u5c14\u592b\uff1a\u6bcf\u79cd\u7403\u6746\u90fd\u6709\u4e0d\u540c\u7684\u7528\u9014\u3002"}, {"question": "\u4f5c\u4e3a\u4e00\u540d100\u5c0f\u65f6\u4ee5\u4e0a\u7684\u73a9\u5bb6\uff0c\u5728Sink It\u7684\u6d77\u6218\u573a\u666f\u4e2d\u6700\u5927\u5316\u70ae\u51fb\u4f24\u5bb3\u7684\u5148\u8fdb\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u4e3a\u4e86\u5728Sink It\u7684\u6d77\u6218\u4e2d\u6700\u5927\u5316\u70ae\u51fb\u4f24\u5bb3\uff0c\u8bf7\u91c7\u7528\u4ee5\u4e0b\u9ad8\u7ea7\u6280\u5de7\uff1a\u6b65\u9aa41\uff1a\u7784\u51c6\u5f31\u70b9\u3002\u7784\u51c6\u6c34\u7ebf\u9644\u8fd1\u7684\u4e0b\u7532\u677f\uff0c\u9020\u6210\u81f4\u547d\u6253\u51fb\uff0c\u5bfc\u81f4\u8fdb\u6c34\u548c\u7ed3\u6784\u7834\u574f\u3002\u6b65\u9aa42\uff1a\u6839\u636e\u60c5\u51b5\u6709\u9488\u5bf9\u6027\u5730\u4f7f\u7528\u4e0d\u540c\u7c7b\u578b\u7684\u5f39\u836f\u3002\u94fe\u5f39\u7528\u4e8e\u762b\u75ea\u5e06\uff0c\u8461\u8404\u5f39\u7528\u4e8e\u51cf\u5c11\u8239\u5458\uff0c\u5b9e\u5fc3\u5f39/\u7206\u70b8\u5f39\u7528\u4e8e\u6839\u636e\u60c5\u51b5\u96c6\u4e2d\u4e8e\u8239\u4f53\u7834\u574f\u3002\u6b65\u9aa43\uff1a\u5168\u9762\u653b\u51fb\u3002\u5c06\u4f60\u7684\u8239\u53ea\u653e\u7f6e\u5728\u53ef\u4ee5\u6cbf\u7740\u654c\u65b9\u8239\u53ea\u957f\u5ea6\u53d1\u5c04\u70ae\u5f39\u7684\u4f4d\u7f6e\uff0c\u6700\u5927\u5316\u547d\u4e2d\u76ee\u6807\u7684\u70ae\u5f39\u6570\u91cf\u3002\u628a\u5b83\u6bd4\u4f5c\u53f0\u7403\u6bd4\u8d5b\u4e2d\u51c6\u786e\u5b9a\u4f4d \u2013 \u7cbe\u5ea6\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u5728Sink It\u4e2d\uff0c\u4e3a\u4ec0\u4e48\u8239\u5458\u7ba1\u7406\u5982\u6b64\u91cd\u8981\uff0c\u9488\u5bf9\u5404\u79cd\u6218\u6597\u60c5\u51b5\uff0c\u6709\u54ea\u4e9b\u6709\u6548\u7684\u8239\u5458\u5206\u914d\u7b56\u7565\uff1f", "answer": "\u6709\u6548\u7684\u8239\u5458\u7ba1\u7406\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u76f4\u63a5\u5f71\u54cd\u8239\u53ea\u6027\u80fd\u3002\u6839\u636e\u60c5\u51b5\u6709\u7b56\u7565\u5730\u5206\u914d\u8239\u5458\uff1a\u5728\u6fc0\u70c8\u7684\u6218\u6597\u4e2d\uff0c\u4f18\u5148\u8003\u8651\u70ae\u624b\u548c\u4fee\u7406\u8239\u5458\u3002\u5728\u8ffd\u51fb\u6216\u9003\u8dd1\u65f6\uff0c\u91cd\u70b9\u653e\u5728\u64cd\u7eb5\u5e06\u8239\u4e0a\u3002\u5728\u5e73\u9759\u7684\u65f6\u523b\uff0c\u91cd\u65b0\u5206\u914d\u8239\u5458\u8fdb\u884c\u4fee\u7406\u548c\u751f\u4ea7\u5f39\u836f\u3002\u5728\u6218\u6597\u4e2d\uff0c\u4e00\u4e2a\u826f\u597d\u7684\u6bd4\u4f8b\u662f40%\u70ae\u624b\uff0c30%\u4fee\u7406\u8239\u5458\uff0c30%\u64cd\u7eb5\u5e06\uff0c\u6839\u636e\u9700\u8981\u8fdb\u884c\u8c03\u6574\u3002\u628a\u8fd9\u60f3\u6210\u7ba1\u7406\u4e00\u4e2a\u4f53\u80b2\u961f\uff1a\u8ba9\u5408\u9002\u7684\u7403\u5458\u626e\u6f14\u5408\u9002\u7684\u89d2\u8272\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "Sink It\uff1a\u6709\u54ea\u4e9b\u88ab\u5ffd\u89c6\u7684\u6218\u672f\u5e03\u9635\u6280\u5de7\uff0c\u53ef\u4ee5\u8ba9\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u5728PvP\u6218\u6597\u4e2d\u83b7\u5f97\u663e\u8457\u4f18\u52bf\uff1f", "answer": "\u88ab\u5ffd\u89c6\u7684\u6218\u672f\u5e03\u9635\u6781\u5927\u5730\u5f71\u54cdPvP\u7ed3\u679c\u3002\u5229\u7528\u5c9b\u5c7f\u548c\u9698\u53e3\u8fdb\u884c\u4f0f\u51fb\u3002\u8fd0\u7528\u2018\u7275\u5236\u2019\u7b56\u7565\uff0c\u5229\u7528\u8239\u53ea\u7684\u901f\u5ea6\u548c\u673a\u52a8\u6027\u4fdd\u6301\u6700\u4f73\u8ddd\u79bb\uff0c\u540c\u65f6\u7528\u70ae\u706b\u653b\u51fb\u654c\u4eba\u3002\u2018T\u5b57\u6a2a\u622a\u2019\u7b56\u7565\u5141\u8bb8\u4f60\u96c6\u4e2d\u6240\u6709\u70ae\u706b\u653b\u51fb\uff0c\u540c\u65f6\u9650\u5236\u654c\u4eba\u7684\u5c04\u51fb\u89d2\u5ea6\u3002\u59cb\u7ec8\u6ce8\u610f\u98ce\u5411\uff0c\u5e76\u5229\u7528\u5b83\u6765\u8fbe\u5230\u6700\u4f73\u6548\u679c\u3002Sink It\u4e2d\u7684\u6218\u672f\u5e03\u9635\u5c31\u50cf\u4e0b\u68cb\uff1a\u8003\u8651\u591a\u6b65\u8d70\u662f\u5f88\u5173\u952e\u7684\u80dc\u5229\u8981\u7d20\u3002\u901a\u8fc7\u6d41\u7a0b\u56fe\u6e05\u6670\u5730\u5c55\u793a\u6218\u573a\u610f\u8bc6\u548c\u79fb\u52a8\u9009\u9879\u3002"}, {"question": "Sink It\u7684\u8d44\u6e90\u7cfb\u7edf\u80cc\u540e\u662f\u4ec0\u4e48\u6837\u7684\u7ecf\u6d4e\u6a21\u578b\uff0c\u4ee5\u53ca\u5982\u4f55\u7406\u89e3\u5b83\u8fdb\u4e00\u6b65\u4f18\u5316\u6211\u7684\u6e38\u620f\u73a9\u6cd5\uff1f", "answer": "Sink It\u7684\u7ecf\u6d4e\u6a21\u5f0f\u56f4\u7ed5\u8d44\u6e90\u6536\u96c6\u3001\u4ea4\u6613\u548c\u751f\u4ea7\u5c55\u5f00\u3002\u6728\u6750\u3001\u91d1\u5c5e\u548c\u98df\u7269\u7b49\u8d44\u6e90\u53ef\u4ee5\u901a\u8fc7\u63a2\u7d22\u548c\u4e0e\u5b9a\u5c45\u70b9\u8fdb\u884c\u8d38\u6613\u83b7\u5f97\u3002\u4e86\u89e3\u4f9b\u6c42\u5173\u7cfb\u53ef\u4ee5\u8ba9\u4f60\u5229\u7528\u4ef7\u683c\u6ce2\u52a8\u2014\u2014\u5728\u8d44\u6e90\u4e30\u5bcc\u7684\u5730\u533a\u4f4e\u4ef7\u8d2d\u4e70\uff0c\u5728\u8d44\u6e90\u7a00\u7f3a\u7684\u5730\u533a\u9ad8\u4ef7\u51fa\u552e\u3002\u6295\u8d44\u4e8e\u751f\u4ea7\u8bbe\u65bd\uff08\u5982\u952f\u6728\u5382\u6216\u51b6\u70bc\u5382\uff09\u53ef\u4ee5\u7b80\u5316\u8d44\u6e90\u83b7\u53d6\u3002\u638c\u63e1\u8fd9\u79cd\u7ecf\u6d4e\u6a21\u5f0f\u4f1a\u8ba9\u4f60\u4ece\u4e00\u540d\u7b80\u5355\u7684\u6c34\u624b\u8f6c\u53d8\u4e3a\u5f3a\u5927\u7684\u8d38\u6613\u5de8\u5934\u3002\u628a\u5b83\u60f3\u8c61\u6210\u5728\u6d77\u4e0a\u8fdb\u884c\u80a1\u7968\u5e02\u573a\u4ea4\u6613\u3002\u53ef\u4ee5\u901a\u8fc7\u521b\u5efa\u57fa\u4e8e\u7269\u54c1\u7a00\u6709\u503c\u6d41\u7a0b\u56fe\u6765\u5b9e\u73b0\u3002"}, {"question": "\u4f60\u80fd\u5206\u6790\u4e00\u4e0bSink It\u4e2d\u8239\u53ea\u72b6\u6001\u7684\u7f29\u653e\u7cfb\u7edf\u5417\uff1f\u8239\u53ea\u5927\u5c0f\u3001\u7c7b\u578b\u548c\u5347\u7ea7\u5982\u4f55\u5f71\u54cd\u540e\u671f\u6e38\u620f\u7684\u6218\u6597\u6709\u6548\u6027\uff1f", "answer": "Sink It\u4e2d\u8239\u53ea\u72b6\u6001\u5e76\u975e\u7ebf\u6027\u7f29\u653e\uff0c\u8fd9\u610f\u5473\u7740\u9010\u6b65\u5347\u7ea7\u6700\u7ec8\u4f1a\u4ea7\u751f\u9012\u51cf\u6536\u76ca\u3002\u5927\u578b\u8239\u53ea\u62e5\u6709\u66f4\u591a\u7684\u5065\u5eb7\u503c\u548c\u653e\u7f6e\u5927\u70ae\u7684\u7a7a\u95f4\uff0c\u800c\u5c0f\u578b\u8239\u53ea\u5219\u66f4\u5feb\u3001\u66f4\u7075\u6d3b\u3002\u5347\u7ea7\u4f1a\u63d0\u9ad8\u4e2a\u4f53\u72b6\u6001\uff0c\u4f8b\u5982\u8239\u4f53\u5f3a\u5ea6\u3001\u5e06\u6548\u7387\u548c\u70ae\u51fb\u7cbe\u5ea6\u3002\u7136\u800c\uff0c\u5728\u540e\u671f\u6e38\u620f\uff0c\u6218\u7565\u534f\u540c\u548c\u8239\u5458\u7ecf\u9a8c\u53d8\u5f97\u6bd4\u539f\u59cb\u72b6\u6001\u66f4\u91cd\u8981\u3002\u4e00\u652f\u534f\u8c03\u826f\u597d\u7684\u5c0f\u578b\u8239\u53ea\u5206\u961f\uff08\u5347\u7ea7\u540e\uff09\u901a\u5e38\u53ef\u4ee5\u80dc\u8fc7\u4e00\u8258\u5355\u8258\u91cd\u578b\u88c5\u7532\u5de8\u8230\u3002\u5c31\u50cf\u521b\u5efa\u4e0d\u540c\u8239\u8236\u7c7b\u578b\u7684\u72b6\u6001\u5bf9\u6bd4\u8868\u683c\u3002"}, {"question": "Sink It\uff1aSink It\u662f\u5426\u4f1a\u652f\u6301PC\u548c\u79fb\u52a8\u73a9\u5bb6\u4e4b\u95f4\u7684\u8de8\u5e73\u53f0\u6e38\u620f\uff0c\u4ee5\u53ca\u6280\u672f\u6311\u6218\u662f\u4ec0\u4e48\uff1f", "answer": "Sink It\u7684PC\u548c\u79fb\u52a8\u7248\u672c\u4e4b\u95f4\u7684\u8de8\u5e73\u53f0\u6e38\u620f\u662f\u4e00\u4e2a\u590d\u6742\u7684\u5de5\u7a0b\u3002\u6280\u672f\u969c\u788d\u5305\u62ec\u670d\u52a1\u5668\u57fa\u7840\u8bbe\u65bd\u4ee5\u7ba1\u7406\u4e0d\u540c\u7684\u5ba2\u6237\u7aef\u7248\u672c\u3001\u8f93\u5165\u65b9\u5f0f\u5dee\u5f02\uff08\u9f20\u6807/\u952e\u76d8\u4e0e\u89e6\u6478\u5c4f\uff09\u4ee5\u53ca\u79fb\u52a8\u8bbe\u5907\u4e0a\u7684\u6f5c\u5728\u6027\u80fd\u5dee\u5f02\u3002\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u6e38\u620f\u66f4\u65b0\u548c\u5185\u5bb9\u8865\u4e01\u7684\u540c\u6b65\u4e5f\u662f\u4e00\u4e2a\u6311\u6218\u3002\u867d\u7136\u76ee\u524d\u4e0d\u652f\u6301\u8de8\u5e73\u53f0\u6e38\u620f\uff0c\u4f46\u5f00\u53d1\u4eba\u5458\u4f1a\u5b9a\u671f\u8bc4\u4f30\u5176\u53ef\u884c\u6027\u3002\u8fd9\u5c31\u50cf\u4e00\u4e2aPC\u548c\u79fb\u52a8\u6e38\u620f\u67b6\u6784\u7684\u7ef4\u6069\u56fe\u3002"}, {"question": "Sink It\uff1a\u6709\u6ca1\u6709\u4e00\u4e9b\u9690\u85cf\u7684\u4f20\u5947\u8239\u53ea\u6216\u4efb\u52a1\u7ebf\uff0c\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u53ef\u80fd\u5ffd\u7565\u4e86\u5b83\u4eec\uff0c\u4ee5\u53ca\u53d1\u73b0\u5b83\u4eec\u7684\u7ebf\u7d22\u662f\u4ec0\u4e48\uff1f", "answer": "Sink It\u4e2d\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u7684\u4f20\u5947\u8239\u53ea\u548c\u4efb\u52a1\u7ebf\uff0c\u8fd9\u4e9b\u4efb\u52a1\u7ebf\u901a\u5e38\u7531\u7279\u5b9a\u884c\u52a8\u6216\u53d1\u73b0\u89e6\u53d1\u3002\u5728\u9152\u9986\u5bfb\u627e\u9690\u79d8\u4fe1\u606f\uff0c\u5728\u504f\u8fdc\u5c9b\u5c7f\u4e0a\u7684\u53e4\u4ee3\u9057\u8ff9\uff0c\u6216\u5728\u6d77\u4e0a\u89c2\u5bdf\u4e0d\u5bfb\u5e38\u7684\u5929\u6c14\u73b0\u8c61\u3002\u5176\u4e2d\u4e00\u4e2a\u4f8b\u5b50\u662f\u901a\u8fc7\u5728\u767e\u6155\u5927\u4e09\u89d2\u9644\u8fd1\u89e6\u53d1\u4e00\u7cfb\u5217\u7279\u5b9a\u4e8b\u4ef6\u6765\u9082\u9005\u2018\u6d77\u602a\u2019\uff0c\u4f20\u8bf4\u4e2d\u8fd9\u8258\u8239\u62e5\u6709\u65e0\u4e0e\u4f26\u6bd4\u7684\u901f\u5ea6\u548c\u706b\u529b\u3002\u53d1\u73b0\u8fd9\u4e9b\u79d8\u5bc6\u9700\u8981\u8010\u5fc3\u3001\u63a2\u7d22\u548c\u7ec6\u81f4\u3002\u201d\u8fd9\u5c31\u50cf\u4e00\u5f20\u85cf\u5b9d\u56fe\uff0c\u2018X\u2019\u6807\u793a\u7740\u5b9d\u85cf\u5730\u70b9\u3002"}]
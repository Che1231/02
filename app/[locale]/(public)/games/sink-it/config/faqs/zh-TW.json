[{"question": "Sink It\uff1a\u65b0\u624b\u5982\u4f55\u6b63\u78ba\u7784\u6e96\u548c\u767c\u5c04\u5927\u7832\uff1f", "answer": "\u5728Sink It\u4e2d\uff0c\u5c0d\u65bc\u65b0\u624b\u4f86\u8aaa\uff0c\u6709\u6548\u7784\u6e96\u548c\u767c\u5c04\u81f3\u95dc\u91cd\u8981\u3002\u9996\u5148\uff0c\u4f7f\u7528\u6ed1\u9f20\u8abf\u6574\u5927\u7832\u7684\u89d2\u5ea6\uff1b\u89d2\u5ea6\u8d8a\u9ad8\uff0c\u5c04\u7a0b\u8d8a\u9060\u3002\u5176\u6b21\uff0c\u6309\u4f4f\u767c\u5c04\u6309\u9215\u4ee5\u589e\u52a0\u70ae\u5f48\u5a01\u529b\uff1b\u6309\u58d3\u6642\u9593\u8d8a\u9577\uff0c\u5a01\u529b\u8d8a\u5927\u3002\u7b2c\u4e09\uff0c\u9b06\u958b\u6309\u9215\u5373\u53ef\u767c\u5c04\u3002\u4f8b\u5982\uff0c\u5982\u679c\u76ee\u6a19\u662f\u9644\u8fd1\u7684\u5c0f\u8239\uff0c\u8acb\u4f7f\u7528\u4f4e\u89d2\u5ea6\u548c\u77ed\u4fc3\u7684\u706b\u529b\u3002\u8acb\u8a18\u4f4f\u8003\u616e\u98a8\u5411\uff0c\u56e0\u70ba\u5b83\u6703\u5f71\u97ff\u70ae\u5f48\u7684\u98db\u884c\u8ecc\u8de1\u3002\u5148\u5728\u975c\u6b62\u76ee\u6a19\u4e0a\u7df4\u7fd2\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u6e96\u78ba\u6027\u3002\u60f3\u50cf\u4e00\u4e0b\u5c31\u50cf\u662f\u6295\u7c43\uff1a\u89d2\u5ea6\u548c\u529b\u91cf\u90fd\u5f88\u91cd\u8981\uff01"}, {"question": "\u5728Sink It\u4e2d\uff0c\u5728\u53d7\u640d\u5f8c\u5feb\u901f\u4fee\u7406\u6211\u7684\u8239\u96bb\u7684\u6700\u4f73\u65b9\u6cd5\u662f\u4ec0\u9ebc\uff0c\u70ba\u4ec0\u9ebc\u9019\u5f88\u91cd\u8981\uff1f", "answer": "\u5728Sink It\u4e2d\uff0c\u6709\u6548\u7387\u5730\u4fee\u7406\u8239\u96bb\u5c0d\u65bc\u751f\u5b58\u81f3\u95dc\u91cd\u8981\u3002\u6700\u5feb\u7684\u4fee\u7406\u65b9\u6cd5\u662f\u5206\u914d\u8239\u54e1\u5230\u4fee\u7406\u7ad9\u3002\u5206\u914d\u7684\u8239\u54e1\u8d8a\u591a\uff0c\u4fee\u7406\u901f\u5ea6\u8d8a\u5feb\u3002\u4fee\u7406\u7684\u512a\u5148\u9806\u5e8f\u81f3\u95dc\u91cd\u8981\uff1a\u9996\u5148\u96c6\u4e2d\u4fee\u5fa9\u8239\u9ad4\u7834\u640d\uff0c\u4ee5\u9632\u6b62\u9032\u6c34\uff0c\u7136\u5f8c\u518d\u8655\u7406\u5e06\u7684\u640d\u58de\u4ee5\u7dad\u6301\u901f\u5ea6\u3002\u5ffd\u8996\u4fee\u7406\u6703\u5c0e\u81f4\u6c89\u6c92\uff01\u60f3\u50cf\u4f60\u7684\u8239\u5c31\u50cf\u4e00\u8f1b\u6c7d\u8eca\uff1a\u5982\u679c\u4f60\u5ffd\u8996\u4e86\u7206\u80ce\uff0c\u4f60\u5c31\u6703\u88ab\u56f0\u4f4f\u3002"}, {"question": "Sink It\uff1a\u6709\u54ea\u4e9b\u5f48\u85e5\u985e\u578b\u53ef\u7528\uff0c\u4ee5\u53ca\u4f55\u6642\u61c9\u8a72\u4f7f\u7528\u54ea\u4e00\u7a2e\uff1f", "answer": "Sink It \u63d0\u4f9b\u591a\u7a2e\u5f48\u85e5\u985e\u578b\uff0c\u6bcf\u7a2e\u90fd\u9069\u5408\u4e0d\u540c\u7684\u60c5\u6cc1\u3002\u5be6\u5fc3\u5f48\u662f\u60a8\u7684\u6a19\u6e96\u5f48\u85e5\uff0c\u9069\u7528\u65bc\u4e00\u822c\u50b7\u5bb3\u3002\u93c8\u5f48\u9069\u5408\u7528\u65bc\u7834\u58de\u5e06\uff0c\u6e1b\u6162\u6575\u8266\u901f\u5ea6\u3002\u8461\u8404\u5f48\u5728\u8fd1\u8ddd\u96e2\u5167\u6709\u6548\u5c0d\u4ed8\u6575\u65b9\u8239\u54e1\u3002\u6700\u5f8c\uff0c\u7206\u70b8\u5f48\u6703\u5c0d\u6575\u8266\u9020\u6210\u5de8\u5927\u7684\u50b7\u5bb3\uff0c\u4f46\u88dc\u7d66\u8cbb\u7528\u66f4\u9ad8\u3002\u4f8b\u5982\uff0c\u5982\u679c\u9762\u5c0d\u4e00\u8258\u5feb\u901f\u3001\u9748\u6d3b\u7684\u8239\u96bb\uff0c\u8acb\u5148\u4f7f\u7528\u93c8\u5f48\u4f86\u7671\u7613\u5176\u5e06\uff0c\u7136\u5f8c\u518d\u4f7f\u7528\u5be6\u5fc3\u5f48\u9032\u884c\u653b\u64ca\u3002\u9019\u5c31\u50cf\u9ad8\u723e\u592b\u7403\uff1a\u6bcf\u7a2e\u7403\u687f\u90fd\u6709\u4e0d\u540c\u7684\u7528\u9014\u3002"}, {"question": "\u4f5c\u70ba100\u5c0f\u6642\u4ee5\u4e0a\u7684\u73a9\u5bb6\uff0c\u5728Sink It\u7684\u8266\u8239\u6230\u9b25\u60c5\u5883\u4e2d\u5982\u4f55\u6700\u5927\u5316\u5927\u7832\u50b7\u5bb3\uff1f", "answer": "\u8981\u5728Sink It\u7684\u8266\u8239\u6230\u9b25\u4e2d\u6700\u5927\u5316\u5927\u7832\u50b7\u5bb3\uff0c\u8acb\u63a1\u7528\u9019\u4e9b\u5148\u9032\u6280\u5de7\uff1a\u6b65\u9a5f1\uff1a\u7784\u6e96\u8584\u5f31\u9ede\u3002\u91dd\u5c0d\u9760\u8fd1\u6c34\u9762\u7dda\u7684\u4e0b\u5c64\u7532\u677f\u9032\u884c\u95dc\u9375\u547d\u4e2d\uff0c\u9020\u6210\u9032\u6c34\u4e26\u9020\u6210\u7d50\u69cb\u640d\u58de\u3002\u6b65\u9a5f2\uff1a\u6709\u7b56\u7565\u5730\u4f7f\u7528\u4e0d\u540c\u7684\u5f48\u85e5\u985e\u578b\u3002\u4f7f\u7528\u93c8\u5f48\u4f86\u7834\u58de\u5e06\uff0c\u4f7f\u7528\u8461\u8404\u5f48\u4f86\u6e1b\u5c11\u8239\u54e1\u6578\u91cf\uff0c\u4f7f\u7528\u5be6\u5fc3\u5f48/\u7206\u70b8\u5f48\u4f86\u6839\u64da\u60c5\u6cc1\u5c08\u6ce8\u65bc\u8239\u9ad4\u640d\u58de\u3002\u6b65\u9a5f3\uff1a\u6a6b\u6383\u6575\u4eba\u3002\u5c07\u60a8\u7684\u8239\u96bb\u4f4d\u7f6e\u8abf\u6574\u70ba\u6cbf\u8457\u6575\u8266\u767c\u5c04\uff0c\u6700\u5927\u5316\u70ae\u5f48\u547d\u4e2d\u76ee\u6a19\u7684\u6578\u91cf\u3002\u5c07\u5176\u6bd4\u4f5c\u5728\u649e\u7403\u6bd4\u8cfd\u4e2d\u7784\u6e96\u4e00\u500b\u5b8c\u7f8e\u7684\u7403 \u2013 \u7cbe\u78ba\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u5728Sink It\u4e2d\uff0c\u70ba\u4ec0\u9ebc\u8239\u54e1\u7ba1\u7406\u5982\u6b64\u91cd\u8981\uff0c\u4ee5\u53ca\u5728\u5404\u7a2e\u6230\u9b25\u60c5\u6cc1\u4e0b\u5982\u4f55\u6709\u6548\u5206\u914d\u8239\u54e1\uff1f", "answer": "\u6709\u6548\u7684\u8239\u54e1\u7ba1\u7406\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u76f4\u63a5\u5f71\u97ff\u8239\u96bb\u7684\u6027\u80fd\u3002\u6839\u64da\u60c5\u6cc1\u6709\u7b56\u7565\u5730\u5206\u914d\u8239\u54e1\uff1a\u5728\u6fc0\u70c8\u7684\u6230\u9b25\u4e2d\uff0c\u512a\u5148\u8003\u616e\u706b\u70ae\u548c\u4fee\u7406\u8239\u54e1\u3002\u8ffd\u9010\u6216\u64a4\u9000\u6642\uff0c\u91cd\u9ede\u653e\u5728\u64cd\u63a7\u8239\u5e06\u4e0a\u3002\u5728\u5e73\u975c\u7684\u6642\u523b\uff0c\u91cd\u65b0\u5206\u914d\u8239\u54e1\u9032\u884c\u4fee\u7406\u640d\u58de\u548c\u751f\u7522\u5f48\u85e5\u3002\u5728\u6230\u9b25\u4e2d\uff0c\u826f\u597d\u7684\u6bd4\u4f8b\u662f40%\u706b\u70ae\uff0c30%\u4fee\u7406\uff0c30%\u8239\u5e06\u64cd\u63a7\uff0c\u5982\u6709\u9700\u8981\u5247\u9032\u884c\u8abf\u6574\u3002\u9019\u5c31\u50cf\u7ba1\u7406\u4e00\u500b\u904b\u52d5\u968a\uff1a\u628a\u5408\u9069\u7684\u7403\u54e1\u653e\u5728\u5408\u9069\u7684\u4f4d\u7f6e\uff0c\u9019\u5c07\u5e36\u4f86\u5f88\u5927\u7684\u4e0d\u540c\u3002"}, {"question": "Sink It\uff1a\u54ea\u4e9b\u88ab\u5ffd\u8996\u7684\u6230\u8853\u5b9a\u4f4d\u6280\u5de7\u53ef\u4ee5\u5728PvP\u6230\u9b25\u4e2d\u70ba\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u5e36\u4f86\u986f\u8457\u512a\u52e2\uff1f", "answer": "\u88ab\u5ffd\u8996\u7684\u6230\u8853\u5b9a\u4f4d\u6703\u6975\u5927\u5730\u5f71\u97ffPvP\u7684\u7d50\u679c\u3002\u5229\u7528\u5cf6\u5dbc\u548c\u9698\u53e3\u9032\u884c\u4f0f\u64ca\u3002\u63a1\u7528\u300e\u727d\u5236\u300f\u7b56\u7565\uff0c\u5229\u7528\u8239\u96bb\u7684\u901f\u5ea6\u548c\u9748\u6d3b\u6027\u4fdd\u6301\u6700\u4f73\u5c04\u7a0b\uff0c\u540c\u6642\u7528\u70ae\u706b\u653b\u64ca\u6575\u4eba\u3002\u300eT\u5b57\u6a6b\u8d8a\u300f\u4f7f\u60a8\u53ef\u4ee5\u5c07\u6240\u6709\u7832\u706b\u96c6\u4e2d\u5728\u6575\u65b9\uff0c\u540c\u6642\u9650\u5236\u6575\u65b9\u7684\u5c04\u64ca\u89d2\u5ea6\u3002\u59cb\u7d42\u7559\u610f\u98a8\u5411\u4e26\u5229\u7528\u5b83\u4f86\u512a\u52e2\u3002Sink It\u4e2d\u7684\u6230\u8853\u5b9a\u4f4d\u5c31\u50cf\u570b\u969b\u8c61\u68cb\uff1a\u63d0\u524d\u5e7e\u6b65\u601d\u8003\u81f3\u95dc\u91cd\u8981\uff0c\u624d\u80fd\u7372\u52dd\u3002\u7528\u5716\u7247\u4f86\u8aaa\u660e\uff0c\u7e6a\u88fd\u6230\u5834\u610f\u8b58\u548c\u884c\u52d5\u9078\u9805\u7684\u6d41\u7a0b\u5716\u3002"}, {"question": "Sink It\u7684\u8cc7\u6e90\u7cfb\u7d71\u80cc\u5f8c\u662f\u4ec0\u9ebc\u7d93\u6fdf\u6a21\u5f0f\uff0c\u4ee5\u53ca\u5982\u4f55\u7406\u89e3\u5b83\u9032\u4e00\u6b65\u512a\u5316\u6211\u7684\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "Sink It\u7684\u7d93\u6fdf\u6a21\u5f0f\u570d\u7e5e\u8457\u8cc7\u6e90\u6536\u96c6\u3001\u8cbf\u6613\u548c\u751f\u7522\u3002\u901a\u904e\u63a2\u7d22\u548c\u8207\u57ce\u93ae\u9032\u884c\u8cbf\u6613\u4f86\u7372\u5f97\u6728\u6750\u3001\u91d1\u5c6c\u548c\u98df\u7269\u7b49\u8cc7\u6e90\u3002\u4e86\u89e3\u4f9b\u9700\u95dc\u4fc2\u53ef\u4ee5\u8b93\u60a8\u5229\u7528\u50f9\u683c\u6ce2\u52d5 \u2013 \u5728\u8cc7\u6e90\u8c50\u5bcc\u7684\u5730\u5340\u4ee5\u4f4e\u50f9\u8cfc\u8cb7\uff0c\u5728\u8cc7\u6e90\u7a00\u7f3a\u7684\u5730\u5340\u4ee5\u9ad8\u50f9\u51fa\u552e\u3002\u6295\u8cc7\u65bc\u751f\u7522\u8a2d\u65bd\uff0c\u4f8b\u5982\u92f8\u6728\u5ee0\u6216\u9444\u9020\u5ee0\uff0c\u53ef\u4ee5\u7c21\u5316\u8cc7\u6e90\u7684\u7372\u53d6\u3002\u638c\u63e1\u9019\u7a2e\u7d93\u6fdf\u6a21\u5f0f\u53ef\u4ee5\u8b93\u60a8\u5f9e\u4e00\u4f4d\u7c21\u55ae\u7684\u6c34\u624b\u8f49\u8b8a\u70ba\u4e00\u4f4d\u5f37\u5927\u7684\u8cbf\u6613\u5de8\u982d\u3002\u60f3\u50cf\u4e00\u4e0b\uff0c\u5c31\u50cf\u5728\u6d77\u4e0a\u9032\u884c\u80a1\u7968\u5e02\u5834\u4ea4\u6613\uff0c\u5b83\u5c31\u50cf\u6839\u64da\u7269\u54c1\u7a00\u6709\u6027\u503c\u5efa\u7acb\u6d41\u7a0b\u5716\u3002"}, {"question": "\u4f60\u80fd\u5206\u6790Sink It\u4e2d\u8239\u96bb\u72c0\u614b\u7684\u64f4\u5c55\u7cfb\u7d71\u55ce\uff1f\u8239\u96bb\u5927\u5c0f\u3001\u985e\u578b\u548c\u5347\u7d1a\u5982\u4f55\u5f71\u97ff\u5f8c\u671f\u904a\u6232\u7684\u6230\u9b25\u6548\u679c\uff1f", "answer": "Sink It\u4e2d\u7684\u8239\u96bb\u72c0\u614b\u4ee5\u975e\u7dda\u6027\u65b9\u5f0f\u64f4\u5c55\uff0c\u9019\u610f\u5473\u8457\u589e\u91cf\u5347\u7d1a\u6700\u7d42\u6703\u7522\u751f\u905e\u6e1b\u7684\u56de\u5831\u3002\u8f03\u5927\u7684\u8239\u96bb\u64c1\u6709\u66f4\u591a\u751f\u547d\u503c\u548c\u66f4\u5927\u7684\u70ae\u4f4d\u7a7a\u9593\uff0c\u800c\u8f03\u5c0f\u7684\u8239\u96bb\u66f4\u5feb\u3001\u66f4\u9748\u6d3b\u3002\u5347\u7d1a\u53ef\u4ee5\u63d0\u9ad8\u500b\u5225\u5c6c\u6027\uff0c\u4f8b\u5982\u8239\u9ad4\u5f37\u5ea6\u3001\u5e06\u6548\u7387\u548c\u70ae\u64ca\u6e96\u78ba\u6027\u3002\u7136\u800c\uff0c\u5728\u5f8c\u671f\u904a\u6232\u4e2d\uff0c\u6230\u7565\u5354\u540c\u548c\u8239\u54e1\u7d93\u9a57\u6bd4\u539f\u59cb\u72c0\u614b\u66f4\u70ba\u91cd\u8981\u3002\u4e00\u652f\u5354\u8abf\u826f\u597d\u7684\u5c0f\u578b\u5347\u7d1a\u8239\u96bb\u5c0f\u968a\u901a\u5e38\u53ef\u4ee5\u52dd\u904e\u55ae\u7368\u7684\u4e00\u8258\u88dd\u7532\u5805\u56fa\u7684\u5de8\u7378\u3002\u5b83\u5c31\u50cf\u88fd\u4f5c\u4e0d\u540c\u8239\u7d1a\u7684\u72c0\u614b\u6bd4\u8f03\u8868\u3002"}, {"question": "Sink It\u662f\u5426\u6703\u652f\u63f4PC\u548c\u884c\u52d5\u88dd\u7f6e\u73a9\u5bb6\u4e4b\u9593\u7684\u8de8\u5e73\u53f0\u904a\u6232\uff0c\u4ee5\u53ca\u6280\u8853\u6311\u6230\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728Sink It\u7684PC\u548c\u884c\u52d5\u88dd\u7f6e\u7248\u672c\u4e4b\u9593\u9032\u884c\u8de8\u5e73\u53f0\u904a\u6232\u662f\u4e00\u500b\u8907\u96dc\u7684\u4efb\u52d9\u3002\u6280\u8853\u969c\u7919\u5305\u62ec\u7ba1\u7406\u4e0d\u540c\u5ba2\u6236\u7aef\u7248\u672c\u3001\u8f38\u5165\u65b9\u5f0f\u5dee\u7570\uff08\u6ed1\u9f20/\u9375\u76e4\u5c0d\u89f8\u6478\uff09\u4ee5\u53ca\u884c\u52d5\u88dd\u7f6e\u6f5b\u5728\u7684\u6027\u80fd\u5dee\u7570\u7684\u4f3a\u670d\u5668\u57fa\u790e\u67b6\u69cb\u3002\u5728\u5e73\u53f0\u4e4b\u9593\u540c\u6b65\u904a\u6232\u66f4\u65b0\u548c\u5167\u5bb9\u4fee\u88dc\u4e5f\u662f\u53e6\u4e00\u500b\u6311\u6230\u3002\u96d6\u7136\u76ee\u524d\u4e0d\u652f\u63f4\u8de8\u5e73\u53f0\u904a\u6232\uff0c\u4f46\u958b\u767c\u4eba\u54e1\u6703\u5b9a\u671f\u8a55\u4f30\u5176\u53ef\u884c\u6027\u3002\u9019\u5c31\u50cfPC\u548c\u884c\u52d5\u88dd\u7f6e\u904a\u6232\u67b6\u69cb\u7684\u6587\u6c0f\u5716\u3002"}, {"question": "Sink It\u4e2d\u662f\u5426\u6709\u4efb\u4f55\u88ab\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u907a\u6f0f\u7684\u96b1\u85cf\u50b3\u5947\u8239\u96bb\u6216\u4efb\u52d9\u7dda\uff0c\u4ee5\u53ca\u767c\u73fe\u5b83\u5011\u7684\u7dda\u7d22\u662f\u4ec0\u9ebc\uff1f", "answer": "Sink It\u4e2d\u5305\u542b\u4e00\u4e9b\u96b1\u85cf\u7684\u50b3\u5947\u8239\u96bb\u548c\u4efb\u52d9\u7dda\uff0c\u901a\u5e38\u7531\u7279\u5b9a\u52d5\u4f5c\u6216\u767c\u73fe\u89f8\u767c\u3002\u7559\u610f\u9152\u9928\u4e2d\u7684\u795e\u79d8\u8a0a\u606f\u3001\u504f\u9060\u5cf6\u5dbc\u4e0a\u7684\u53e4\u4ee3\u5ee2\u589f\u6216\u6d77\u4e0a\u7684\u7570\u5e38\u5929\u6c23\u3002\u5176\u4e2d\u4e00\u500b\u4f8b\u5b50\u662f\u89f8\u767c\u5728\u767e\u6155\u9054\u4e09\u89d2\u9644\u8fd1\u7684\u4e00\u7cfb\u5217\u7279\u5b9a\u4e8b\u4ef6\u4ee5\u9047\u5230\u300c\u6d77\u86c7\u300d\u2014\u2014\u50b3\u8aaa\u4e2d\u7684\u8239\u96bb\uff0c\u64da\u50b3\u64c1\u6709\u7121\u8207\u502b\u6bd4\u7684\u901f\u5ea6\u548c\u706b\u529b\u3002\u767c\u73fe\u9019\u4e9b\u79d8\u5bc6\u9700\u8981\u8010\u5fc3\u3001\u63a2\u7d22\u548c\u4ed4\u7d30\u89c0\u5bdf\u3002\u9019\u5c31\u50cf\u4e00\u5f35\u85cf\u5bf6\u5716\uff0c\u5176\u4e2d\u300eX\u300f\u6a19\u8a18\u8457\u5730\u9ede\u3002"}]
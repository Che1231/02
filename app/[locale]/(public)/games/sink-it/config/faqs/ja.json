[{"question": "\u6c88\u6ca1\u3055\u305b\u308b\uff1a\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001\u3069\u306e\u3088\u3046\u306b\u7832\u5f3e\u3092\u9069\u5207\u306b\u7167\u6e96\u3092\u5408\u308f\u305b\u3001\u767a\u5c04\u3057\u307e\u3059\u304b\uff1f", "answer": "\u6c88\u6ca1\u3055\u305b\u308b\u306e\u521d\u5fc3\u8005\u306e\u65b9\u306b\u3068\u3063\u3066\u3001\u52b9\u7387\u7684\u306a\u7167\u6e96\u3068\u767a\u5c04\u306f\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u307e\u305a\u3001\u30de\u30a6\u30b9\u3092\u4f7f\u3063\u3066\u5927\u7832\u306e\u89d2\u5ea6\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u89d2\u5ea6\u304c\u9ad8\u3044\u307b\u3069\u3001\u5c04\u7a0b\u8ddd\u96e2\u306f\u9577\u304f\u306a\u308a\u307e\u3059\u3002\u6b21\u306b\u3001\u767a\u5c04\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u7d9a\u3051\u308b\u3053\u3068\u3067\u3001\u7832\u5f3e\u306e\u5a01\u529b\u304c\u5897\u3057\u307e\u3059\u3002\u62bc\u3057\u7d9a\u3051\u308b\u6642\u9593\u304c\u9577\u3044\u307b\u3069\u3001\u7832\u5f3e\u306e\u5a01\u529b\u306f\u5f37\u304f\u306a\u308a\u307e\u3059\u3002\u6700\u5f8c\u306b\u3001\u30dc\u30bf\u30f3\u3092\u96e2\u3057\u3066\u767a\u5c04\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u8fd1\u304f\u306e\u5c0f\u578b\u8239\u3092\u6a19\u7684\u3068\u3059\u308b\u5834\u5408\u306f\u3001\u4f4e\u3044\u89d2\u5ea6\u3068\u77ed\u6642\u9593\u306e\u5a01\u529b\u3067\u767a\u5c04\u3057\u307e\u3059\u3002\u7832\u5f3e\u306e\u8ecc\u9053\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u98a8\u5411\u304d\u3092\u8003\u616e\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002\u307e\u305a\u306f\u9759\u6b62\u3057\u305f\u30bf\u30fc\u30b2\u30c3\u30c8\u3092\u7df4\u7fd2\u3059\u308b\u3053\u3068\u3067\u3001\u5c04\u6483\u7cbe\u5ea6\u304c\u98db\u8e8d\u7684\u306b\u5411\u4e0a\u3059\u308b\u3067\u3057\u3087\u3046\u3002\u30d0\u30b9\u30b1\u30c3\u30c8\u30dc\u30fc\u30eb\u306e\u30b7\u30e5\u30fc\u30c8\u306e\u3088\u3046\u306b\u3001\u89d2\u5ea6\u3068\u529b\u304c\u91cd\u8981\u3067\u3059\uff01"}, {"question": "\u6c88\u6ca1\u3055\u305b\u308b\uff1a\u30c0\u30e1\u30fc\u30b8\u3092\u53d7\u3051\u305f\u5f8c\u3001\u8239\u3092\u8fc5\u901f\u306b\u4fee\u7406\u3059\u308b\u6700\u826f\u306e\u65b9\u6cd5\u306f\u4f55\u3067\u3059\u304b\uff1f\u306a\u305c\u91cd\u8981\u3067\u3059\u304b\uff1f", "answer": "\u6c88\u6ca1\u3055\u305b\u308b\u3067\u3001\u8239\u3092\u52b9\u7387\u7684\u306b\u4fee\u7406\u3059\u308b\u3053\u3068\u306f\u751f\u5b58\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u6700\u3082\u8fc5\u901f\u306a\u65b9\u6cd5\u306f\u3001\u4e57\u7d44\u54e1\u306b\u4fee\u7406\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u3092\u5272\u308a\u5f53\u3066\u308b\u3053\u3068\u3067\u3059\u3002\u5272\u308a\u5f53\u3066\u3089\u308c\u305f\u4e57\u7d44\u54e1\u306e\u6570\u304c\u591a\u3044\u307b\u3069\u3001\u4fee\u7406\u306f\u901f\u304f\u306a\u308a\u307e\u3059\u3002\u4fee\u7406\u306e\u512a\u5148\u9806\u4f4d\u304c\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u307e\u305a\u3001\u6d78\u6c34\u3092\u9632\u3050\u305f\u3081\u306b\u8239\u4f53\u306e\u7834\u640d\u7b87\u6240\u3092\u4fee\u7406\u3057\u3001\u6b21\u306b\u901f\u5ea6\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u5e06\u306e\u640d\u50b7\u306b\u5bfe\u51e6\u3057\u307e\u3059\u3002\u4fee\u7406\u3092\u7121\u8996\u3059\u308b\u3068\u3001\u6c88\u6ca1\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\uff01\u8239\u3092\u8eca\u306b\u4f8b\u3048\u308b\u3068\u3001\u30d1\u30f3\u30af\u3057\u305f\u30bf\u30a4\u30e4\u3092\u7121\u8996\u3059\u308b\u3068\u3001\u7acb\u3061\u5f80\u751f\u3057\u3066\u3057\u307e\u3046\u3067\u3057\u3087\u3046\u3002"}, {"question": "\u6c88\u6ca1\u3055\u305b\u308b\uff1a\u4f7f\u7528\u53ef\u80fd\u306a\u5f3e\u85ac\u306e\u7a2e\u985e\u3068\u305d\u306e\u4f7f\u7528\u30bf\u30a4\u30df\u30f3\u30b0\u306f\uff1f", "answer": "\u6c88\u6ca1\u3055\u305b\u308b\u3067\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u7a2e\u985e\u306e\u5f3e\u85ac\u304c\u63d0\u4f9b\u3055\u308c\u3066\u304a\u308a\u3001\u305d\u308c\u305e\u308c\u7570\u306a\u308b\u72b6\u6cc1\u306b\u9069\u3057\u3066\u3044\u307e\u3059\u3002\u4e38\u5f3e\u306f\u4e00\u822c\u7684\u306a\u5f3e\u85ac\u3067\u3001\u4e00\u822c\u7684\u306b\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u307e\u3059\u3002\u30c1\u30a7\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\u306f\u5e06\u3092\u7121\u529b\u5316\u3057\u3001\u6575\u8239\u3092\u9045\u304f\u3059\u308b\u306e\u306b\u6700\u9069\u3067\u3059\u3002\u30d6\u30ec\u30fc\u30d7\u30b7\u30e7\u30c3\u30c8\u306f\u3001\u8fd1\u8ddd\u96e2\u3067\u6575\u306e\u4e57\u7d44\u54e1\u306b\u5bfe\u3057\u3066\u52b9\u679c\u7684\u3067\u3059\u3002\u6700\u5f8c\u306b\u3001\u7206\u767a\u5f3e\u306f\u6575\u8239\u306b\u5927\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u307e\u3059\u304c\u3001\u88dc\u7d66\u30b3\u30b9\u30c8\u306f\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6a5f\u654f\u306a\u6575\u8239\u306b\u76f4\u9762\u3057\u3066\u3044\u308b\u5834\u5408\u3001\u4e38\u5f3e\u3092\u4f7f\u3046\u524d\u306b\u30c1\u30a7\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\u3067\u5e06\u3092\u7834\u58ca\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u30b4\u30eb\u30d5\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u305d\u308c\u305e\u308c\u306e\u30af\u30e9\u30d6\u306b\u306f\u7570\u306a\u308b\u76ee\u7684\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "100\u6642\u9593\u4ee5\u4e0a\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u3057\u3066\u3001\u6c88\u6ca1\u3055\u305b\u308b\u306e\u6d77\u8ecd\u6226\u95d8\u30b7\u30ca\u30ea\u30aa\u3067\u7832\u6483\u30c0\u30e1\u30fc\u30b8\u3092\u6700\u5927\u5316\u3059\u308b\u4e0a\u7d1a\u6226\u7565\u306f\uff1f", "answer": "\u6c88\u6ca1\u3055\u305b\u308b\u306e\u6d77\u8ecd\u6226\u95d8\u3067\u7832\u6483\u30c0\u30e1\u30fc\u30b8\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u3053\u308c\u3089\u306e\u4e0a\u7d1a\u30c6\u30af\u30cb\u30c3\u30af\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5f31\u70b9\u306b\u72d9\u3044\u3092\u5b9a\u3081\u308b\u3002\u6c34\u7dda\u4ed8\u8fd1\u306e\u4f4e\u3044\u7532\u677f\u3092\u6a19\u7684\u306b\u3057\u3001\u6d78\u6c34\u3068\u69cb\u9020\u4e0a\u306e\u640d\u50b7\u3092\u5f15\u304d\u8d77\u3053\u3059\u91cd\u8981\u306a\u30d2\u30c3\u30c8\u3092\u5f53\u3066\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5f3e\u85ac\u306e\u7a2e\u985e\u3092\u6226\u7565\u7684\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002\u5e06\u3092\u7121\u529b\u5316\u3059\u308b\u305f\u3081\u306b\u30c1\u30a7\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\u3001\u4e57\u7d44\u54e1\u3092\u6e1b\u3089\u3059\u305f\u3081\u306b\u30d6\u30ec\u30fc\u30d7\u30b7\u30e7\u30c3\u30c8\u3001\u72b6\u6cc1\u306b\u5fdc\u3058\u3066\u8239\u4f53\u306e\u640d\u50b7\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u305f\u3081\u306b\u4e38\u5f3e\u307e\u305f\u306f\u7206\u767a\u5f3e\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6575\u3092\u5fb9\u5e95\u7684\u306b\u653b\u6483\u3057\u307e\u3059\u3002\u6575\u8266\u5168\u4f53\u306b\u7832\u5f3e\u3092\u96c6\u4e2d\u3055\u305b\u308b\u3088\u3046\u306b\u8239\u306e\u4f4d\u7f6e\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u30d3\u30ea\u30e4\u30fc\u30c9\u3067\u5b8c\u74a7\u306a\u30b7\u30e5\u30fc\u30c8\u3092\u6253\u3064\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u306d\u3002\u6b63\u78ba\u6027\u304c\u30ab\u30ae\u3067\u3059\u3002"}, {"question": "\u6c88\u6ca1\u3055\u305b\u308b\u3067\u3001\u4e57\u7d44\u54e1\u306e\u7ba1\u7406\u306f\u306a\u305c\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u304b\uff1f\u3055\u307e\u3056\u307e\u306a\u6226\u95d8\u72b6\u6cc1\u306b\u5bfe\u5fdc\u3057\u305f\u52b9\u7387\u7684\u306a\u4e57\u7d44\u54e1\u914d\u7f6e\u6226\u7565\u306f\uff1f", "answer": "\u52b9\u7387\u7684\u306a\u4e57\u7d44\u54e1\u306e\u7ba1\u7406\u306f\u6975\u3081\u3066\u91cd\u8981\u3067\u3059\u3002\u3053\u308c\u306f\u3001\u8239\u306e\u6027\u80fd\u306b\u76f4\u63a5\u5f71\u97ff\u3059\u308b\u304b\u3089\u3067\u3059\u3002\u72b6\u6cc1\u306b\u5fdc\u3058\u3066\u6226\u7565\u7684\u306b\u4e57\u7d44\u54e1\u3092\u914d\u7f6e\u3057\u307e\u3059\u3002\u6fc0\u3057\u3044\u6226\u95d8\u4e2d\u306f\u3001\u7832\u8853\u3068\u4fee\u7406\u306e\u4e57\u7d44\u54e1\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u8ffd\u3044\u304b\u3051\u308b\u6642\u3084\u64a4\u9000\u3059\u308b\u6642\u306f\u3001\u5e06\u306e\u64cd\u4f5c\u306b\u91cd\u70b9\u3092\u7f6e\u304d\u307e\u3059\u3002\u7a4f\u3084\u304b\u306a\u72b6\u6cc1\u3067\u306f\u3001\u4fee\u7406\u306b\u5272\u3044\u3066\u30c0\u30e1\u30fc\u30b8\u3092\u4fee\u5fa9\u3057\u3001\u5f3e\u85ac\u3092\u751f\u7523\u3057\u307e\u3059\u3002\u6226\u95d8\u3067\u306f\u3001\u4e57\u7d44\u54e1\u306e40\uff05\u3092\u7832\u8853\u300130\uff05\u3092\u4fee\u7406\u300130\uff05\u3092\u5e06\u306e\u64cd\u4f5c\u306b\u5272\u308a\u5f53\u3066\u3001\u5fc5\u8981\u306b\u5fdc\u3058\u3066\u8abf\u6574\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u30b9\u30dd\u30fc\u30c4\u30c1\u30fc\u30e0\u306e\u30de\u30cd\u30b8\u30e1\u30f3\u30c8\u3068\u4f3c\u3066\u3044\u307e\u3059\u3002\u9069\u5207\u306a\u9078\u624b\u3092\u9069\u5207\u306a\u30dd\u30b8\u30b7\u30e7\u30f3\u306b\u914d\u7f6e\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002"}, {"question": "\u6c88\u6ca1\u3055\u305b\u308b\uff1aPvP\u6226\u95d8\u3067\u719f\u7df4\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u5927\u304d\u306a\u512a\u4f4d\u6027\u3092\u3082\u305f\u3089\u3059\u3001\u898b\u904e\u3054\u3055\u308c\u304c\u3061\u306a\u6226\u8853\u7684\u306a\u914d\u7f6e\u6280\u8853\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u898b\u904e\u3054\u3055\u308c\u304c\u3061\u306a\u6226\u8853\u7684\u306a\u914d\u7f6e\u306f\u3001PvP\u306e\u7d50\u679c\u306b\u5287\u7684\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u5cf6\u3084\u9698\u8def\u3092\u4f7f\u3063\u3066\u5f85\u3061\u4f0f\u305b\u3057\u307e\u3059\u3002\u300c\u30ad\u30c3\u30c6\u30a3\u30f3\u30b0\u300d\u6226\u7565\u3092\u5c0e\u5165\u3057\u307e\u3059\u3002\u8239\u306e\u901f\u5ea6\u3068\u6a5f\u52d5\u529b\u3092\u4f7f\u3063\u3066\u6700\u9069\u306a\u8ddd\u96e2\u3092\u4fdd\u3061\u306a\u304c\u3089\u6575\u306b\u7832\u6483\u3092\u6d74\u3073\u305b\u307e\u3059\u3002\u6575\u306e\u7832\u6483\u89d2\u5ea6\u3092\u5236\u9650\u3057\u306a\u304c\u3089\u3001\u3059\u3079\u3066\u306e\u7832\u6483\u3092\u6575\u306b\u5411\u3051\u3066\u4f7f\u7528\u3067\u304d\u307e\u3059\u3002\u5e38\u306b\u98a8\u5411\u304d\u306b\u6ce8\u610f\u3057\u3001\u6709\u5229\u306a\u72b6\u6cc1\u306e\u305f\u3081\u306b\u4f7f\u7528\u3057\u307e\u3057\u3087\u3046\u3002\u6c88\u6ca1\u3055\u305b\u308b\u306e\u6226\u8853\u7684\u306a\u914d\u7f6e\u306f\u30c1\u30a7\u30b9\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u6570\u624b\u5148\u3092\u8aad\u3080\u3053\u3068\u304c\u52dd\u5229\u306e\u30ab\u30ae\u3067\u3059\u3002\u3055\u3089\u306b\u8996\u899a\u5316\u3059\u308b\u305f\u3081\u306b\u3001\u6226\u95d8\u5834\u306e\u8a8d\u8b58\u3068\u79fb\u52d5\u30aa\u30d7\u30b7\u30e7\u30f3\u306e\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u63cf\u3044\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u6c88\u6ca1\u3055\u305b\u308b\uff1a\u6c88\u6ca1\u3055\u305b\u308b\u306e\u30ea\u30bd\u30fc\u30b9\u30b7\u30b9\u30c6\u30e0\u3092\u52d5\u304b\u3059\u6839\u672c\u7684\u306a\u7d4c\u6e08\u30e2\u30c7\u30eb\u306f\u4f55\u304b\u3001\u305d\u308c\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u30b2\u30fc\u30d7\u30ec\u30a4\u3092\u3055\u3089\u306b\u6700\u9069\u5316\u3059\u308b\u306b\u306f\uff1f", "answer": "\u6c88\u6ca1\u3055\u305b\u308b\u306e\u7d4c\u6e08\u306f\u3001\u8cc7\u6e90\u306e\u53ce\u96c6\u3001\u53d6\u5f15\u3001\u751f\u7523\u3092\u57fa\u306b\u3057\u3066\u3044\u307e\u3059\u3002\u6728\u6750\u3001\u91d1\u5c5e\u3001\u98df\u6599\u306a\u3069\u306e\u8cc7\u6e90\u306f\u3001\u63a2\u691c\u3068\u96c6\u843d\u3068\u306e\u53d6\u5f15\u3092\u901a\u3058\u3066\u5f97\u3089\u308c\u307e\u3059\u3002\u9700\u8981\u3068\u4f9b\u7d66\u3092\u7406\u89e3\u3059\u308b\u3068\u3001\u4fa1\u683c\u5909\u52d5\u3092\u5229\u7528\u3067\u304d\u307e\u3059\u3002\u8cc7\u6e90\u304c\u8c4a\u5bcc\u306a\u5730\u57df\u3067\u306f\u5b89\u4fa1\u306b\u8cb7\u3044\u3001\u8cc7\u6e90\u304c\u4e4f\u3057\u3044\u5730\u57df\u3067\u306f\u9ad8\u5024\u3067\u58f2\u308b\u306e\u3067\u3059\u3002\u88fd\u6750\u6240\u3084\u88fd\u9244\u6240\u306a\u3069\u306e\u751f\u7523\u65bd\u8a2d\u306b\u6295\u8cc7\u3059\u308b\u3053\u3068\u3067\u3001\u8cc7\u6e90\u306e\u7372\u5f97\u3092\u52b9\u7387\u5316\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u7d4c\u6e08\u30e2\u30c7\u30eb\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3068\u3001\u5358\u306a\u308b\u8239\u4e57\u308a\u304b\u3089\u5f37\u529b\u306a\u8cbf\u6613\u738b\u306b\u5909\u308f\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u9ad8\u6d77\u4e0a\u3067\u682a\u5f0f\u5e02\u5834\u3092\u884c\u3046\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u30a2\u30a4\u30c6\u30e0\u306e\u5e0c\u5c11\u6027\u306b\u57fa\u3065\u3044\u305f\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u4f5c\u6210\u3059\u308b\u306e\u3068\u540c\u3058\u3067\u3059\u3002"}, {"question": "\u6c88\u6ca1\u3055\u305b\u308b\uff1a\u6c88\u6ca1\u3055\u305b\u308b\u306e\u8239\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u30b9\u30b1\u30fc\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u3092\u5206\u6790\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u8239\u306e\u30b5\u30a4\u30ba\u3001\u7a2e\u985e\u3001\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u3001\u5f8c\u671f\u30b2\u30fc\u30e0\u3067\u6226\u95d8\u52b9\u679c\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u6c88\u6ca1\u3055\u305b\u308b\u306e\u8239\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u306f\u3001\u975e\u7dda\u5f62\u306b\u5897\u52a0\u3057\u307e\u3059\u3002\u3064\u307e\u308a\u3001\u6bb5\u968e\u7684\u306a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u6700\u7d42\u7684\u306b\u306f\u53ce\u76ca\u6027\u304c\u6e1b\u5c11\u3057\u307e\u3059\u3002\u5927\u578b\u8239\u306f\u3088\u308a\u591a\u304f\u306e\u4f53\u529b\u3068\u5927\u7832\u306e\u30b9\u30da\u30fc\u30b9\u3092\u5099\u3048\u3066\u3044\u307e\u3059\u3002\u4e00\u65b9\u3001\u5c0f\u578b\u8239\u306f\u901f\u304f\u3001\u6a5f\u654f\u3067\u3059\u3002\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u3001\u8239\u4f53\u306e\u5f37\u5ea6\u3001\u5e06\u306e\u52b9\u7387\u3001\u5927\u7832\u306e\u7cbe\u5ea6\u306a\u3069\u306e\u500b\u3005\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002\u305f\u3060\u3057\u3001\u5f8c\u671f\u30b2\u30fc\u30e0\u3067\u306f\u3001\u6226\u7565\u7684\u306a\u76f8\u4e57\u52b9\u679c\u3068\u30af\u30eb\u30fc\u306e\u7d4c\u9a13\u304c\u3001\u539f\u6750\u6599\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u3088\u308a\u3082\u91cd\u8981\u306b\u306a\u308a\u307e\u3059\u3002\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3055\u308c\u305f\u5c0f\u578b\u8239\u306e\u9023\u643a\u3057\u305f\u5c0f\u8266\u968a\u306f\u3001\u91cd\u88c5\u7532\u306e\u5927\u578b\u8239\u3092\u5727\u5012\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306f\u3055\u307e\u3056\u307e\u306a\u8239\u30af\u30e9\u30b9\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u6bd4\u8f03\u8868\u3092\u4f5c\u6210\u3059\u308b\u3053\u3068\u3068\u540c\u3058\u3067\u3059\u3002"}, {"question": "\u6c88\u6ca1\u3055\u305b\u308b\uff1aPC\u3068\u30e2\u30d0\u30a4\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u9593\u306e\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u6c88\u6ca1\u3055\u305b\u308b\u306f\u30b5\u30dd\u30fc\u30c8\u3059\u308b\u306e\u3067\u3057\u3087\u3046\u304b\uff1f\u6280\u8853\u7684\u306a\u8ab2\u984c\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "PC\u7248\u3068\u30e2\u30d0\u30a4\u30eb\u7248\u306e\u6c88\u6ca1\u3055\u305b\u308b\u9593\u306e\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30d7\u30ec\u30a4\u306f\u3001\u8907\u96d1\u306a\u53d6\u308a\u7d44\u307f\u3067\u3059\u3002\u6280\u8853\u7684\u306a\u8ab2\u984c\u306b\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u30af\u30e9\u30a4\u30a2\u30f3\u30c8\u30d0\u30fc\u30b8\u30e7\u30f3\u3092\u7ba1\u7406\u3059\u308b\u305f\u3081\u306e\u30b5\u30fc\u30d0\u30fc\u30a4\u30f3\u30d5\u30e9\u30b9\u30c8\u30e9\u30af\u30c1\u30e3\u3001\u5165\u529b\u65b9\u6cd5\u306e\u9055\u3044\uff08\u30de\u30a6\u30b9/\u30ad\u30fc\u30dc\u30fc\u30c9\u5bfe\u30bf\u30c3\u30c1\uff09\u3001\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u4e0a\u306e\u6f5c\u5728\u7684\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306e\u3070\u3089\u3064\u304d\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u5168\u4f53\u3067\u30b2\u30fc\u30e0\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3068\u30b3\u30f3\u30c6\u30f3\u30c4\u30d1\u30c3\u30c1\u3092\u540c\u671f\u5316\u3059\u308b\u3053\u3068\u3082\u8ab2\u984c\u3067\u3059\u3002\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30d7\u30ec\u30a4\u306f\u73fe\u5728\u30b5\u30dd\u30fc\u30c8\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u304c\u3001\u958b\u767a\u8005\u306f\u305d\u306e\u5b9f\u73fe\u53ef\u80fd\u6027\u3092\u5b9a\u671f\u7684\u306b\u8a55\u4fa1\u3057\u3066\u3044\u307e\u3059\u3002\u3053\u308c\u306f\u3001PC\u3068\u30e2\u30d0\u30a4\u30eb\u30b2\u30fc\u30e0\u30a2\u30fc\u30ad\u30c6\u30af\u30c1\u30e3\u306e\u30d9\u30f3\u56f3\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002"}, {"question": "\u6c88\u6ca1\u3055\u305b\u308b\uff1a\u719f\u7df4\u3057\u305f\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u898b\u904e\u3054\u3057\u3066\u3044\u308b\u53ef\u80fd\u6027\u306e\u3042\u308b\u3001\u96a0\u308c\u305f\u4f1d\u8aac\u306e\u8239\u3084\u30af\u30a8\u30b9\u30c8\u30e9\u30a4\u30f3\u306f\u3042\u308a\u307e\u3059\u304b\uff1f\u305d\u308c\u3089\u3092\u767a\u898b\u3059\u308b\u305f\u3081\u306e\u624b\u304c\u304b\u308a\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u6c88\u6ca1\u3055\u305b\u308b\u306b\u306f\u3001\u7279\u5b9a\u306e\u884c\u52d5\u3084\u767a\u898b\u306b\u3088\u3063\u3066\u30c8\u30ea\u30ac\u30fc\u3055\u308c\u308b\u3001\u96a0\u308c\u305f\u4f1d\u8aac\u306e\u8239\u3084\u30af\u30a8\u30b9\u30c8\u30e9\u30a4\u30f3\u304c\u3044\u304f\u3064\u304b\u3042\u308a\u307e\u3059\u3002\u5c45\u9152\u5c4b\u306e\u96a0\u3055\u308c\u305f\u30e1\u30c3\u30bb\u30fc\u30b8\u3001\u9060\u9694\u5cf6\u306b\u3042\u308b\u53e4\u4ee3\u907a\u8de1\u3001\u6d77\u4e0a\u3067\u306e\u7570\u5e38\u6c17\u8c61\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305d\u306e\u4e00\u4f8b\u3068\u3057\u3066\u3001\u30d0\u30df\u30e5\u30fc\u30c0\u4e09\u89d2\u5730\u5e2f\u4ed8\u8fd1\u3067\u7279\u5b9a\u306e\u51fa\u6765\u4e8b\u3092\u5f15\u304d\u8d77\u3053\u3059\u3053\u3068\u3067\u3001\u4f1d\u8aac\u7684\u3068\u3044\u3046\u5642\u306e\u300e\u30b7\u30fc\u30b5\u30fc\u30af\u30eb\u300f\u306b\u95a2\u308f\u308b\u5192\u967a\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u306e\u4f1d\u8aac\u306e\u8239\u306f\u6bd4\u985e\u306e\u306a\u3044\u30b9\u30d4\u30fc\u30c9\u3068\u706b\u529b\u3092\u6301\u3064\u3068\u805e\u3044\u3066\u3044\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u79d8\u5bc6\u3092\u767a\u898b\u3059\u308b\u306b\u306f\u3001\u5fcd\u8010\u529b\u3001\u63a2\u6c42\u5fc3\u3001\u8a73\u7d30\u3078\u306e\u6ce8\u610f\u304c\u5fc5\u8981\u3067\u3059\u3002\u3053\u308c\u306f\u5b9d\u5730\u56f3\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3001\u300eX\u300f\u5370\u304c\u5834\u6240\u3092\u8868\u3057\u307e\u3059\u3002"}]
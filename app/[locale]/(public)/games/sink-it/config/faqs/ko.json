[{"question": "Sink It: \uc8fc\uc694 \uc0ac\uc6a9\uc790\ub97c \uc704\ud55c \ub300\ud3ec \uc870\uc900 \ubc0f \ubc1c\uc0ac \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sink It\uc5d0\uc11c \ucd08\ubcf4\uc790\ub294 \ud6a8\uacfc\uc801\uc778 \uc870\uc900 \ubc0f \ubc1c\uc0ac\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uba3c\uc800 \ub9c8\uc6b0\uc2a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub300\ud3ec\uc758 \uac01\ub3c4\ub97c \uc870\uc815\ud569\ub2c8\ub2e4. \uac01\ub3c4\uac00 \ub192\uc744\uc218\ub85d \ud3ec\ud0c4\uc758 \uac70\ub9ac\uac00 \uba40\uc5b4\uc9d1\ub2c8\ub2e4. \ub458\uc9f8, \ubc1c\uc0ac \ubc84\ud2bc\uc744 \ub204\ub974\uace0 \uc788\uc73c\uba74 \ud3ec\ud0c4\uc758 \ud798\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4. \ub20c\ub7ec\uc788\ub294 \uc2dc\uac04\uc774 \uae38\uc218\ub85d \ud3ec\ud0c4\uc758 \ud798\uc774 \uac15\ud574\uc9d1\ub2c8\ub2e4. \uc14b\uc9f8, \ubc84\ud2bc\uc744 \ub193\uc73c\uba74 \ubc1c\uc0ac\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac00\uae4c\uc774 \uc788\ub294 \uc791\uc740 \ubc30\ub97c \ud0c0\uac9f\uc73c\ub85c \uc0bc\ub294 \uacbd\uc6b0, \ub0ae\uc740 \uac01\ub3c4\uc640 \uc9e7\uc740 \ud3ed\ubc1c\ub825\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \ubc14\ub78c\uc758 \uc601\ud5a5\uc744 \uace0\ub824\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774\ub294 \ud3ec\ud0c4\uc758 \uada4\uc801\uc5d0 \uc601\ud5a5\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uba3c\uc800 \uc815\uc9c0\ub41c \ub300\uc0c1\uc5d0 \uc5f0\uc2b5\ud558\uba74 \uc815\ud655\ub3c4\uac00 \ud06c\uac8c \ud5a5\uc0c1\ub429\ub2c8\ub2e4. \ub9c8\uce58 \ub18d\uad6c\ub97c \uc3d8\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uac01\ub3c4\uc640 \ud798\uc774 \uc911\uc694\ud569\ub2c8\ub2e4!"}, {"question": "Sink It\uc5d0\uc11c \ud53c\ud574\ub97c \uc785\uc740 \ud6c4 \ubc30\ub97c \uc2e0\uc18d\ud558\uac8c \uc218\ub9ac\ud558\ub294 \uac00\uc7a5 \uc88b\uc740 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc774\uba70, \uc65c \uc911\uc694\ud569\ub2c8\uae4c?", "answer": "Sink It\uc5d0\uc11c \ubc30\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uc218\ub9ac\ud558\ub294 \uac83\uc740 \uc0dd\uc874\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uac00\uc7a5 \ube60\ub978 \ubc29\ubc95\uc740 \uc120\uc6d0\uc744 \uc218\ub9ac \uc2a4\ud14c\uc774\uc158\uc5d0 \ubc30\uce58\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \ubc30\uce58\ub41c \uc120\uc6d0\uc774 \ub9ce\uc744\uc218\ub85d \uc218\ub9ac\uac00 \ube68\ub77c\uc9d1\ub2c8\ub2e4. \uc218\ub9ac \uc6b0\uc120 \uc21c\uc704\uac00 \uc911\uc694\ud569\ub2c8\ub2e4. \uce68\uc218\ub97c \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \uba3c\uc800 \ubc30\uc758 \ud2c8\uc0c8\ub97c \uc218\ub9ac\ud55c \ub2e4\uc74c \uc18d\ub3c4\ub97c \uc720\uc9c0\ud558\uae30 \uc704\ud574 \ub3db\uc758 \uc190\uc0c1\uc744 \ud574\uacb0\ud574\uc57c \ud569\ub2c8\ub2e4. \uc218\ub9ac\ub97c \ubb34\uc2dc\ud558\uba74 \uce68\ubab0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4! \ubc30\ub97c \uc790\ub3d9\ucc28\ub85c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694. \ud391\ud06c \ub09c \ud0c0\uc774\uc5b4\ub97c \ubb34\uc2dc\ud558\uba74 \uae38\uc744 \uc783\uc744 \uac83\uc785\ub2c8\ub2e4."}, {"question": "Sink It: \uc0ac\uc6a9 \uac00\ub2a5\ud55c \ud0c4\uc57d \uc720\ud615\uc740 \ubb34\uc5c7\uc774\uba70, \uac01\uac01 \uc5b8\uc81c \uc0ac\uc6a9\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "Sink It\uc5d0\ub294 \ub2e4\uc591\ud55c \ud0c4\uc57d \uc720\ud615\uc774 \uc788\uc73c\uba70 \uac01\uac01 \ub2e4\ub978 \uc0c1\ud669\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4. \uc6d0\ud615 \ud0c4\uc740 \uc77c\ubc18\uc801\uc778 \ud53c\ud574\ub97c \uc8fc\ub294 \ud45c\uc900 \ud0c4\uc57d\uc785\ub2c8\ub2e4. \uc0ac\uc2ac \ud0c4\uc740 \ub3db\uc744 \ubb34\ub825\ud654\ud558\uace0 \uc801 \ud568\uc120\uc744 \ub290\ub9ac\uac8c \ud558\ub294 \ub370 \uc774\uc0c1\uc801\uc785\ub2c8\ub2e4. \ud3ec\ub3c4\ud0c4\uc740 \uadfc\uc811 \uac70\ub9ac\uc5d0\uc11c \uc801 \uc120\uc6d0\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uacf5\uaca9\ud569\ub2c8\ub2e4. \ub9c8\uc9c0\ub9c9\uc73c\ub85c \ud3ed\ubc1c\ud0c4\uc740 \uc801 \ud568\uc120\uc5d0 \ud070 \ud53c\ud574\ub97c \uc785\ud788\uc9c0\ub9cc \uc7ac\ubcf4\uae09\uc774 \ub354 \ube44\uc309\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ube60\ub974\uace0 \uae30\ub3d9\uc131\uc774 \ub6f0\uc5b4\ub09c \ud568\uc120\uacfc \ub9c8\uc8fc\uce58\ub294 \uacbd\uc6b0, \uc6d0\ud615 \ud0c4\uc73c\ub85c \uc811\uadfc\ud558\uae30 \uc804\uc5d0 \uc0ac\uc2ac \ud0c4\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub3db\uc744 \ubb34\ub825\ud654\ud558\uc2ed\uc2dc\uc624. \ub9c8\uce58 \uace8\ud504\uc640 \uac19\uc2b5\ub2c8\ub2e4. \uac01 \ud074\ub7fd\uc740 \ub2e4\ub978 \uc6a9\ub3c4\ub97c \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "100\uc2dc\uac04 \uc774\uc0c1 \ud50c\ub808\uc774\ud55c \uc720\uc800\ub85c\uc11c, Sink It\uc758 \ud574\uc0c1 \uc804\ud22c \uc2dc\ub098\ub9ac\uc624\uc5d0\uc11c \ub300\ud3ec \ud53c\ud574\ub97c \uadf9\ub300\ud654\ud558\uae30 \uc704\ud55c \uace0\uae09 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sink It\uc758 \ud574\uc0c1 \uc804\ud22c\uc5d0\uc11c \ub300\ud3ec \ud53c\ud574\ub97c \uadf9\ub300\ud654\ud558\ub824\uba74 \ub2e4\uc74c \uace0\uae09 \uae30\ubc95\uc744 \uc0ac\uc6a9\ud558\uc138\uc694: \ub2e8\uacc4 1: \uc57d\uc810\uc744 \ub178\ub9bd\ub2c8\ub2e4. \ubb3c\uac00 \uadfc\ucc98 \ud558\uce35 \uac11\ud310\uc744 \ud0c0\uac9f\uc73c\ub85c \ud558\uc5ec \uce68\uc218\uc640 \uad6c\uc870\uc801 \uc190\uc0c1\uc744 \uc77c\uc73c\ud0a4\ub294 \uce58\uba85\ud0c0\ub97c \uc785\ud788\uc138\uc694. \ub2e8\uacc4 2: \ub2e4\uc591\ud55c \ud0c4\uc57d \uc720\ud615\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\uc138\uc694. \uc0ac\uc2ac \ud0c4\uc740 \ub3db\uc744 \ub9c8\ube44\uc2dc\ud0a4\uace0, \ud3ec\ub3c4\ud0c4\uc740 \uc2b9\ubb34\uc6d0\uc744 \uc904\uc774\uace0, \uc6d0\ud615\ud0c4/\ud3ed\ubc1c\ud0c4\uc740 \uc0c1\ud669\uc5d0 \ub530\ub77c \ubc30\uc758 \uac11\ud310 \uc190\uc0c1\uc5d0 \uc9d1\uc911\ud558\uc138\uc694. \ub2e8\uacc4 3: \uc801\uc744 \u2018\uae01\uc73c\uc138\uc694\u2019. \ubc30\ub97c \uc704\uce58\uc2dc\ucf1c \uc801 \ud568\uc120 \uc804\uccb4\uc5d0 \ub300\ud3ec\uc54c\uc744 \ucd5c\ub300\ud55c \ub9ce\uc774 \ub9de\ucd94\uc138\uc694. \uc774\ub294 \ub2f9\uad6c\uc5d0\uc11c \uc644\ubcbd\ud55c \uc0f7\uc744 \ub9de\ucd94\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc815\ud655\uc131\uc774 \ud575\uc2ec\uc785\ub2c8\ub2e4."}, {"question": "Sink It\uc5d0\uc11c \uc2b9\ubb34\uc6d0 \uad00\ub9ac\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \ub2e4\uc591\ud55c \uc804\ud22c \uc0c1\ud669\uc5d0 \ud6a8\uc728\uc801\uc778 \uc2b9\ubb34\uc6d0 \ubc30\uce58 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud6a8\uc728\uc801\uc778 \uc2b9\ubb34\uc6d0 \uad00\ub9ac\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubc30\uc758 \uc131\ub2a5\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc0c1\ud669\uc5d0 \ub530\ub77c \uc804\ub7b5\uc801\uc73c\ub85c \uc2b9\ubb34\uc6d0\uc744 \ubc30\uce58\ud558\uc138\uc694: \uaca9\ub82c\ud55c \uc804\ud22c \uc911\uc5d0\ub294 \ud3ec\uc218\uc640 \uc218\ub9ac \uc2b9\ubb34\uc6d0\uc744 \uc6b0\uc120\uc2dc\ud558\uc138\uc694. \ucd94\uaca9\ud558\uac70\ub098 \ub3c4\ub9dd\uce60 \ub54c\ub294 \ub3db \uc870\uc885\uc5d0 \uc9d1\uc911\ud558\uc138\uc694. \uc870\uc6a9\ud560 \ub54c\ub294 \uc218\ub9ac\uc640 \ud0c4\uc57d \uc0dd\uc0b0\uc5d0 \uc2b9\ubb34\uc6d0\uc744 \uc7ac\ubc30\uce58\ud558\uc138\uc694. \uc804\ud22c\uc5d0\uc11c \uc88b\uc740 \ube44\uc728\uc740 40% \ud3ec\uc218, 30% \uc218\ub9ac, 30% \ub3db \uc870\uc885\uc774\uba70 \ud544\uc694\uc5d0 \ub530\ub77c \uc870\uc815\ud558\uc138\uc694. \uc774\ub294 \uc2a4\ud3ec\uce20 \ud300\uc744 \uad00\ub9ac\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc801\uc808\ud55c \uc120\uc218\ub97c \uc801\uc808\ud55c \uc704\uce58\uc5d0 \ubc30\uce58\ud558\uba74 \ubaa8\ub4e0 \ucc28\uc774\uac00 \uc0dd\uae41\ub2c8\ub2e4."}, {"question": "Sink It: PvP \uc804\ud22c\uc5d0\uc11c \uacbd\ud5d8 \ub9ce\uc740 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc0c1\ub2f9\ud55c \uc774\uc810\uc744 \uc904 \uc218 \uc788\ub294 \uac04\uacfc\ud558\uae30 \uc26c\uc6b4 \uc804\uc220\uc801 \ubc30\uce58 \uae30\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uac04\uacfc\ub418\uae30 \uc26c\uc6b4 \uc804\uc220\uc801 \ubc30\uce58\ub294 PvP \uacb0\uacfc\uc5d0 \uadf9\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc12c\uacfc \uc881\uc740 \uc9c0\uc810\uc744 \uc774\uc6a9\ud558\uc5ec \ub9e4\ubcf5\ud558\uc138\uc694. \ubc30\uc758 \uc18d\ub3c4\uc640 \uae30\ub3d9\uc131\uc744 \uc774\uc6a9\ud558\uc5ec \uc801\uc808\ud55c \uac70\ub9ac\ub97c \uc720\uc9c0\ud558\uba74\uc11c \ub300\ud3ec\ub97c \uacc4\uc18d\ud574\uc11c \ubc1c\uc0ac\ud558\ub294 \u2018\ud0a4\ud305\u2019 \uc804\ub7b5\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. \u2018T\uc790\ud615 \uad50\ucc28\u2019\ub294 \uc801\uc758 \uc0ac\uaca9\uac01\uc744 \uc81c\ud55c\ud558\uba74\uc11c \ubaa8\ub4e0 \ub300\ud3ec\ub97c \ub3d9\uc2dc\uc5d0 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. \ud56d\uc0c1 \ubc14\ub78c\uc758 \ubc29\ud5a5\uc744 \uc778\uc9c0\ud558\uace0 \uc774\ub97c \uc774\uc6a9\ud558\uc138\uc694. Sink It\uc758 \uc804\uc220\uc801 \ud3ec\uc9c0\uc154\ub2dd\uc740 \uccb4\uc2a4\uc640 \uac19\uc2b5\ub2c8\ub2e4. \uba87 \uc218 \uc55e\uc744 \ub0b4\ub2e4\ubcf4\ub294 \uac83\uc774 \uc2b9\ub9ac\uc758 \uc5f4\uc1e0\uc785\ub2c8\ub2e4. \uc2dc\uac01\uc801\uc73c\ub85c \ubcf4\uc5ec\uc8fc\uae30 \uc704\ud574 \uc804\uc7a5 \uc778\uc2dd \ubc0f \uc774\ub3d9 \uc635\uc158\uc758 \ud750\ub984\ub3c4\ub97c \uadf8\ub824\ubcf4\uc138\uc694."}, {"question": "Sink It\uc758 \uc790\uc6d0 \uc2dc\uc2a4\ud15c\uc744 \uc6c0\uc9c1\uc774\ub294 \uadfc\ubcf8\uc801\uc778 \uacbd\uc81c \ubaa8\ub378\uc740 \ubb34\uc5c7\uc774\uba70, \uc774\ub97c \uc774\ud574\ud568\uc73c\ub85c\uc368 \uac8c\uc784\uc744 \ub354\uc6b1 \ucd5c\uc801\ud654\ud560 \uc218 \uc788\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sink It\uc758 \uacbd\uc81c\ub294 \uc790\uc6d0 \ucc44\ucde8, \uac70\ub798 \ubc0f \uc0dd\uc0b0\uc744 \uc911\uc2ec\uc73c\ub85c \ub3cc\uc544\uac11\ub2c8\ub2e4. \ub098\ubb34, \uae08\uc18d \ubc0f \uc2dd\ub7c9\uacfc \uac19\uc740 \uc790\uc6d0\uc740 \ud0d0\ud5d8\uacfc \uc815\ucc29\uc9c0\uc640\uc758 \uac70\ub798\ub97c \ud1b5\ud574 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uacf5\uae09\uacfc \uc218\uc694\ub97c \uc774\ud574\ud558\uba74 \uac00\uaca9 \ubcc0\ub3d9\uc744 \ud65c\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc790\uc6d0\uc774 \ud48d\ubd80\ud55c \uc9c0\uc5ed\uc5d0\uc11c\ub294 \ub0ae\uc740 \uac00\uaca9\uc73c\ub85c \uad6c\ub9e4\ud558\uace0, \uc790\uc6d0\uc774 \ubd80\uc871\ud55c \uc9c0\uc5ed\uc5d0\uc11c\ub294 \ub192\uc740 \uac00\uaca9\uc73c\ub85c \ud310\ub9e4\ud569\ub2c8\ub2e4. \uc81c\uc7ac\uc18c\ub098 \uc81c\ub828\uc18c\uc640 \uac19\uc740 \uc0dd\uc0b0 \uc2dc\uc124\uc5d0 \ud22c\uc790\ud558\uba74 \uc790\uc6d0 \ud655\ubcf4 \uacfc\uc815\uc744 \uac04\uc18c\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uacbd\uc81c \ubaa8\ub378\uc744 \uc219\ub2ec\ud558\uba74 \ub2e8\uc21c\ud55c \uc120\uc6d0\uc5d0\uc11c \uac15\ub825\ud55c \ubb34\uc5ed \uac70\ubb3c\ub85c \ubcc0\ubaa8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubc14\ub2e4\uc5d0\uc11c \uc8fc\uc2dd \uc2dc\uc7a5\uc744 \ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ud488\ubaa9 \ud76c\uadc0\uc131 \uac12\uc744 \uae30\ubc18\uc73c\ub85c \ud558\ub294 \ud750\ub984\ub3c4\ub97c \uc791\uc131\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4."}, {"question": "Sink It\uc5d0\uc11c \ubc30\uc758 \ud1b5\uacc4 \uc2a4\ucf00\uc77c\ub9c1 \uc2dc\uc2a4\ud15c\uc744 \ubd84\uc11d\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c? \ubc30\uc758 \ud06c\uae30, \uc720\ud615 \ubc0f \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \ud6c4\ubc18 \uac8c\uc784\uc5d0\uc11c \uc804\ud22c \ud6a8\uacfc\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "Sink It\uc758 \ubc30 \ud1b5\uacc4\ub294 \ube44\uc120\ud615\uc801\uc73c\ub85c \uc870\uc815\ub429\ub2c8\ub2e4. \uc989, \uc99d\ubd84 \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \uacb0\uad6d \uc218\uc775 \uac10\uc18c\ub97c \ucd08\ub798\ud569\ub2c8\ub2e4. \ud070 \ubc30\ub294 \ub354 \ub9ce\uc740 \uac74\uac15\uacfc \ub300\ud3ec\ub97c \uc704\ud55c \uacf5\uac04\uc744 \uac00\uc9c0\uace0 \uc788\uc9c0\ub9cc, \uc791\uc740 \ubc30\ub294 \ub354 \ube60\ub974\uace0 \ub354 \ubbfc\ucca9\ud569\ub2c8\ub2e4. \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \ud568\uc120 \uac15\ub3c4, \ub3db \ud6a8\uc728 \ubc0f \ub300\ud3ec \uc815\ud655\ub3c4\uc640 \uac19\uc740 \uac1c\ubcc4 \ud1b5\uacc4\ub97c \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \ud6c4\ubc18 \uac8c\uc784\uc5d0\uc11c \uc804\ub7b5\uc801 \uc2dc\ub108\uc9c0\uc640 \uc2b9\ubb34\uc6d0 \uacbd\ud5d8\uc740 \uc6d0\ud65c\ud55c \ud1b5\uacc4\ubcf4\ub2e4 \ub354 \uc911\uc694\ud574\uc9d1\ub2c8\ub2e4. \uc791\uace0 \uc5c5\uadf8\ub808\uc774\ub4dc\ub41c \ubc30\uc758 \uc798 \uc870\uc815\ub41c \ubd84\ub300\ub294 \uc885\uc885 \ub9e4\uc6b0 \ubc29\uc5b4\ub825\uc774 \uac15\ud55c \uac70\ub300\ud55c \ud568\uc120\ubcf4\ub2e4 \ub0ab\uc2b5\ub2c8\ub2e4. \ub2e4\uc591\ud55c \ud568\uc120 \ud074\ub798\uc2a4\uc758 \ud1b5\uacc4 \ube44\uad50\ud45c\ub97c \uc791\uc131\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4."}, {"question": "Sink It\uc5d0\uc11c PC\uc640 \ubaa8\ubc14\uc77c \ud50c\ub808\uc774\uc5b4 \uac04\uc758 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774\ub97c \uc9c0\uc6d0\ud560 \uc608\uc815\uc785\ub2c8\uae4c? \uae30\uc220\uc801 \uc5b4\ub824\uc6c0\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "PC \ubc0f \ubaa8\ubc14\uc77c \ubc84\uc804\uc758 Sink It\uc5d0\uc11c \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774\ub294 \ubcf5\uc7a1\ud55c \uc791\uc5c5\uc785\ub2c8\ub2e4. \uae30\uc220\uc801 \uc7a5\uc560\ubb3c\uc5d0\ub294 \ub2e4\uc591\ud55c \ud074\ub77c\uc774\uc5b8\ud2b8 \ubc84\uc804\uc744 \uad00\ub9ac\ud558\uae30 \uc704\ud55c \uc11c\ubc84 \uc778\ud504\ub77c, \uc785\ub825 \ubc29\ubc95\uc758 \ucc28\uc774(\ub9c8\uc6b0\uc2a4/\ud0a4\ubcf4\ub4dc \ub300 \ud130\uce58), \ubaa8\ubc14\uc77c \uc7a5\uce58\uc758 \uc131\ub2a5 \ucc28\uc774\uac00 \ud3ec\ud568\ub429\ub2c8\ub2e4. \ud50c\ub7ab\ud3fc \uac04 \uac8c\uc784 \uc5c5\ub370\uc774\ud2b8 \ubc0f \ucf58\ud150\uce20 \ud328\uce58\uc758 \ub3d9\uae30\ud654\ub3c4 \ub610 \ub2e4\ub978 \uc5b4\ub824\uc6c0\uc785\ub2c8\ub2e4. \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774\ub294 \ud604\uc7ac \uc9c0\uc6d0\ub418\uc9c0 \uc54a\uc9c0\ub9cc, \uac1c\ubc1c\uc790\ub294 \uadf8 \uac00\ub2a5\uc131\uc744 \uc9c0\uc18d\uc801\uc73c\ub85c \ud3c9\uac00\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub294 PC\uc640 \ubaa8\ubc14\uc77c \uac8c\uc784 \uc544\ud0a4\ud14d\ucc98\uc758 \ubca4\ub2e4\uc774\uc5b4\uadf8\ub7a8\uacfc \uac19\uc2b5\ub2c8\ub2e4."}, {"question": "Sink It\uc5d0 \uacbd\ud5d8 \ub9ce\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uac04\uacfc\ud588\uc744 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc804\uc124\uc801\uc778 \ud568\uc120\uc774\ub098 \ud018\uc2a4\ud2b8\uac00 \uc788\uc2b5\ub2c8\uae4c? \uc774\ub4e4\uc744 \ubc1c\uacac\ud558\ub294 \ub2e8\uc11c\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Sink It\uc5d0\ub294 \uc885\uc885 \ud2b9\uc815 \ud589\ub3d9\uc774\ub098 \ubc1c\uacac\uc73c\ub85c \ud65c\uc131\ud654\ub418\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uc804\uc124\uc801\uc778 \ud568\uc120\uacfc \ud018\uc2a4\ud2b8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc220\uc9d1\uc758 \uc554\ud638 \uba54\uc2dc\uc9c0, \uc678\ub534 \uc12c\uc758 \uace0\ub300 \uc720\uc801 \ub610\ub294 \ubc14\ub2e4\uc758 \uc774\uc0c1 \uae30\ud6c4\ub97c \uc8fc\uc758 \uae4a\uac8c \uc0b4\ud3b4\ubcf4\uc138\uc694. \uc774\ub7ec\ud55c \ube44\ubc00\uc744 \ubc1c\uacac\ud558\ub824\uba74 \uc778\ub0b4\uc2ec, \ud0d0\ud5d8\uc2ec \ubc0f \uc138\ubd80 \uc0ac\ud56d\uc5d0 \ub300\ud55c \uad00\uc2ec\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub9c8\uce58 \ubcf4\ubb3c \uc9c0\ub3c4\uc640 \uac19\uc2b5\ub2c8\ub2e4. 'X'\ub294 \ubc1c\uacac \uc9c0\uc810\uc785\ub2c8\ub2e4."}]
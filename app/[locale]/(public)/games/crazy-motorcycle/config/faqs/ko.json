[{"question": "\ucd08\ubcf4\uc790\uac00 \ud06c\ub808\uc774\uc9c0 \ubaa8\ud130\uc0ac\uc774\ud074\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc5b4\ub5bb\uac8c \uc219\ub2ec\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud06c\ub808\uc774\uc9c0 \ubaa8\ud130\uc0ac\uc774\ud074\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc219\ub2ec\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: \ub2e8\uacc41 - \ud654\uba74 \uc624\ub978\ucabd\uc5d0 \uc788\ub294 \uac00\uc18d \ud398\ub2ec(throttle)\uacfc \ube0c\ub808\uc774\ud06c \ubc84\ud2bc\uc744 \uc775\uc219\ud574\uc9c0\uc138\uc694. \ub2e8\uacc42 - \uae30\uae30\ub97c \uae30\uc6b8\uc774\uac70\ub098 \ud654\uba74 \ubc84\ud2bc\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc88c\uc6b0\ub85c \uae30\uc6b8\uae30\ub97c \uc5f0\uc2b5\ud558\uc138\uc694. \ub2e8\uacc43 - \uc9c1\uc120 \ub3c4\ub85c\uc5d0\uc11c\ub294 \ubd80\uc2a4\ud2b8 \ubc84\ud2bc\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc5ec \uc18d\ub3c4\ub97c \ub192\uc774\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\ub3c4\uc2ec \uac70\ub9ac' \ud2b8\ub799\uc5d0\uc11c \ub450 \ubc88\uc9f8 \ucf54\ub108 \uc774\ud6c4 \ubd80\uc2a4\ud2b8\ub97c \uc0ac\uc6a9\ud558\uba74 \uc0c1\ub300\ubc29\uc744 \ucd94\uc6d4\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2e4\uc81c \uc624\ud1a0\ubc14\uc774\ub97c \ud0c0\ub294 \uac83\uacfc \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uc138\uc694. \ucc98\uc74c\uc5d0\ub294 \ucc9c\ucc9c\ud788 \uc2dc\uc791\ud55c \ub2e4\uc74c \uc790\uc2e0\uac10\uc744 \uc5bb\uc73c\uba74\uc11c \uc810\ucc28 \uc18d\ub3c4\ub97c \ub192\uc774\uc138\uc694."}, {"question": "100\uc2dc\uac04 \uc774\uc0c1 \uac8c\uc784\uc744 \uc990\uae34 \ud6c4 \ud06c\ub808\uc774\uc9c0 \ubaa8\ud130\uc0ac\uc774\ud074\uc5d0\uc11c \ub808\uc774\uc2a4\ub97c \uc774\uae30\uae30 \uc704\ud55c \ud575\uc2ec \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "100\uc2dc\uac04 \uc774\uc0c1 \ud50c\ub808\uc774 \ud6c4\uc5d0\ub294 \uace0\uae09 \uc804\ub7b5\uc5d0 \uc9d1\uc911\ud558\uc138\uc694: \ub2e8\uacc41 - \uc815\ud655\ud55c \uae30\uc6b8\uae30\ub97c \uc870\uc808\ud558\uc5ec \ucf54\ub108\ub9c1\uc744 \uc644\ubcbd\ud558\uac8c \ud558\uc5ec \uc18d\ub3c4\ub97c \uc720\uc9c0\ud558\uc138\uc694. \ub2e8\uacc42 - \ubd80\uc2a4\ud2b8 \uac8c\uc774\uc9c0\ub97c \uc2e0\uc911\ud558\uac8c \uad00\ub9ac\ud558\uc5ec \ucd94\uc6d4\uc774\ub098 \uc790\ub9ac \ubc29\uc5b4\uc640 \uac19\uc740 \uc911\uc694\ud55c \uc21c\uac04\uc5d0 \uc0ac\uc6a9\ud558\uc138\uc694. \ub2e8\uacc43 - \uac01 \ud2b8\ub799\uc758 \ub808\uc774\uc544\uc6c3\uc744 \ubd84\uc11d\ud558\uc5ec \uc9c0\ub984\uae38\uc774\ub098 \ucd5c\uc801\uc758 \ubd80\uc2a4\ud2b8 \uad6c\uc5ed\uc744 \ud30c\uc545\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uc0b0\uc545 \ud1b5\uacfc' \ud2b8\ub799\uc5d0\ub294 \uc138 \ubc88\uc9f8 \uccb4\ud06c\ud3ec\uc778\ud2b8 \ub4a4\uc5d0 \uc228\uaca8\uc9c4 \uc9c0\ub984\uae38\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uad6c\uc131\ud45c\ub97c \uc0ac\uc6a9\ud558\uc5ec \uac01 \ud2b8\ub799\ubcc4 \ucd5c\uace0 \uae30\ub85d\uacfc \ubd80\uc2a4\ud2b8 \uc0ac\uc6a9\ub7c9\uc744 \ucd94\uc801\ud558\uc138\uc694. \uc774\ub7ec\ud55c \uc811\uadfc \ubc29\uc2dd\uc740 \uc804\ub7b5\uc744 \uac1c\uc120\ud558\uace0 \ub808\uc774\uc2a4\uc5d0\uc11c \uc6b0\uc704\ub97c \uc810\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4."}, {"question": "\uc65c \ud06c\ub808\uc774\uc9c0 \ubaa8\ud130\uc0ac\uc774\ud074\uc758 \ubb3c\ub9ac \uc5d4\uc9c4\uc774 \ud604\uc2e4\uac10 \uc788\uac8c \ub290\uaef4\uc9c0\uba70, \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "\ud06c\ub808\uc774\uc9c0 \ubaa8\ud130\uc0ac\uc774\ud074\uc758 \ubb3c\ub9ac \uc5d4\uc9c4\uc740 \uc911\ub825, \ub9c8\ucc30 \ubc0f \uc6b4\ub3d9\ub7c9\uc744 \ud3ec\ud568\ud55c \uc2e4\uc81c \uc624\ud1a0\ubc14\uc774 \ub3d9\uc5ed\ud559\uc744 \uc2dc\ubbac\ub808\uc774\uc158\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud604\uc2e4\uac10\uc740 \ucf54\ub108\ub9c1 \uc2dc \ubb34\uac8c \ubd84\ud3ec\uc640 \uc18d\ub3c4\uc640 \uac19\uc740 \uc694\uc778\uc744 \uace0\ub824\ud574\uc57c \ud560 \ud544\uc694\uc131\uc744 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \ubc18\uc601\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc801\uc808\ud55c \uae30\uc6b8\uae30\ub97c \uc720\uc9c0\ud558\uc9c0 \uc54a\uace0 \uace0\uc18d\uc73c\ub85c \uae09\uaca9\ud55c \ucf54\ub108\ub97c \ub3cc\uba74 \uc624\ud1a0\ubc14\uc774\uac00 \ubbf8\ub044\ub7ec\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc5d4\uc9c4\uc740 \ub610\ud55c \ucda9\ub3cc \ucda9\uaca9\uc744 \ud604\uc2e4\uc801\uc73c\ub85c \uacc4\uc0b0\ud558\uc5ec \uace0\uc18d\uc73c\ub85c \uc7a5\uc560\ubb3c\uc5d0 \ubd80\ub52a\ud788\uba74 \uc18d\ub3c4\uac00 \ud06c\uac8c \uc904\uc5b4\ub4e4\uac70\ub098 \uc624\ud1a0\ubc14\uc774\uc5d0\uc11c \ub5a8\uc5b4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\uac83\uc740 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uae4a\uc774\ub97c \ub354\ud558\uc5ec \ub3c4\uc804\uc801\uc774\uace0 \ubcf4\ub78c \uc788\uac8c \ub9cc\ub4e4\uc5b4\uc90d\ub2c8\ub2e4."}, {"question": "\uc800\uc0ac\uc591 \uae30\uae30\uc5d0\uc11c \ud06c\ub808\uc774\uc9c0 \ubaa8\ud130\uc0ac\uc774\ud074\uc758 \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\uae30 \uc704\ud574 \uc5b4\ub5a4 \uc124\uc815\uc744 \uc870\uc815\ud574\uc57c \ud558\ub098\uc694?", "answer": "\uc800\uc0ac\uc591 \uae30\uae30\uc5d0\uc11c \ud06c\ub808\uc774\uc9c0 \ubaa8\ud130\uc0ac\uc774\ud074\uc758 \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \ub2e4\uc74c \uc124\uc815\uc744 \uc870\uc815\ud558\uc138\uc694: \ub2e8\uacc41 - \uadf8\ub798\ud53d \ud488\uc9c8\uc744 '\uc911' \ub610\ub294 '\ub0ae\uc74c'\uc73c\ub85c \ub0ae\ucdb0 \ub80c\ub354\ub9c1 \ubd80\ud558\ub97c \uc904\uc774\uc138\uc694. \ub2e8\uacc42 - \uc124\uc815 \uba54\ub274\uc5d0\uc11c \uadf8\ub9bc\uc790 \ubc0f \ubc18\uc0ac\uc640 \uac19\uc740 \ubc31\uadf8\ub77c\uc6b4\ub4dc \ud504\ub85c\uc138\uc2a4\ub97c \ube44\ud65c\uc131\ud654\ud558\uc138\uc694. \ub2e8\uacc43 - \uc2dc\uac01\uc801 \uc815\ud655\uc131\ubcf4\ub2e4 \ud504\ub808\uc784 \uc18d\ub3c4\ub97c \uc6b0\uc120\uc2dc\ud558\ub294 '\uc131\ub2a5 \ubaa8\ub4dc'\ub97c \ud65c\uc131\ud654\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, 2GB RAM\uc744 \uac00\uc9c4 \uae30\uae30\uc5d0\uc11c \uc774\ub7ec\ud55c \ubcc0\uacbd \uc0ac\ud56d\uc740 \ud504\ub808\uc784 \uc18d\ub3c4\ub97c \ucd5c\ub300 30%\uae4c\uc9c0 \uac1c\uc120\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2dc\uac01 \ud6a8\uacfc\uc640 \uac8c\uc784 \ud50c\ub808\uc774\uc758 \uc6d0\ud65c\ud568 \uc0ac\uc774\uc758 \ucd5c\uc0c1\uc758 \uade0\ud615\uc744 \uc704\ud574 \ubcc0\uacbd \uc804\ud6c4 \uc131\ub2a5\uc744 \ube44\uad50\ud558\uc5ec \uad6c\uc131\ud45c\ub97c \uc0ac\uc6a9\ud558\uc138\uc694."}, {"question": "\ud06c\ub808\uc774\uc9c0 \ubaa8\ud130\uc0ac\uc774\ud074\uc5d0\uc11c \uc228\uaca8\uc9c4 '\uc720\ub839 \ub77c\uc774\ub354' \uc624\ud1a0\ubc14\uc774\ub97c \uc5b4\ub5bb\uac8c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "'\uc720\ub839 \ub77c\uc774\ub354' \uc624\ud1a0\ubc14\uc774\ub97c \uc7a0\uae08 \ud574\uc81c\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: \ub2e8\uacc41 - '\uc9c0\uc625' \ub09c\uc774\ub3c4 \ubaa8\ub4dc\uc758 \ubaa8\ub4e0 50\uac1c \ub808\uc774\uc2a4\ub97c \uc644\ub8cc\ud558\uc138\uc694. \ub2e8\uacc42 - \ub2e4\uc591\ud55c \ud2b8\ub799\uc5d0 \ud769\uc5b4\uc838 \uc788\ub294 100\uac1c\uc758 \uc228\uaca8\uc9c4 \ud1a0\ud070\uc744 \uc218\uc9d1\ud558\uc138\uc694. \ub2e8\uacc43 - '\uc720\ub839\uc758 \uace0\uc18d\ub3c4\ub85c' \ud2b8\ub799\uc744 2\ubd84 \ubbf8\ub9cc\uc73c\ub85c \uc644\ub8cc\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uc0ac\ub9c9 \uc9c8\uc8fc' \ud2b8\ub799\uc758 \uad11\uace0\ud310 \ub4a4\uc5d0 \ud55c \uac1c\uc758 \ud1a0\ud070\uc774 \uc228\uaca8\uc838 \uc788\uc2b5\ub2c8\ub2e4. '\uc720\ub839 \ub77c\uc774\ub354'\ub294 \ub3c5\ud2b9\ud55c \ubd88\uaf43 \uc790\uad6d \ud6a8\uacfc\uc640 \ub192\uc740 \ucd5c\uace0 \uc18d\ub3c4\ub97c \uc790\ub791\ud558\uba70, \uc5c5\uc801 \ud0d0\uc0c9\uac00\ub4e4 \uc0ac\uc774\uc5d0\uc11c \uc778\uae30\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ubcf4\ubb3c\ucc3e\uae30\uc640 \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uc138\uc694. \uc778\ub0b4\uc640 \ub048\uae30\uac00 \uc911\uc694\ud569\ub2c8\ub2e4."}, {"question": "\ud06c\ub808\uc774\uc9c0 \ubaa8\ud130\uc0ac\uc774\ud074\uc5d0\uc11c \ube60\ub974\uac8c \uac8c\uc784 \ub0b4 \ud1b5\ud654\ub97c \uc5bb\ub294 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uac8c\uc784 \ub0b4 \ud1b5\ud654\ub97c \ube60\ub974\uac8c \ubc8c\uae30 \uc704\ud574\uc11c\ub294 \ub2e4\uc74c\uacfc \uac19\uc740 \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: \ub2e8\uacc41 - \ud2b9\uc815 \uc791\uc5c5\uc744 \uc644\ub8cc\ud558\uba74 \ubcf4\ub108\uc2a4 \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud558\ub294 \uc77c\uc77c \ucc4c\ub9b0\uc9c0\uc5d0 \ucc38\uc5ec\ud558\uc138\uc694. \ub2e8\uacc42 - '\ub3c4\uc2ec \uac70\ub9ac'\uc640 \uac19\uc740 \uc9e7\uc740 \ud2b8\ub799\uc744 \ubc18\ubcf5\ud558\uc5ec \uc2dc\uac04\ub2f9 \ub808\uc774\uc2a4 \uc644\ub8cc \ud69f\uc218\ub97c \uadf9\ub300\ud654\ud558\uc138\uc694. \ub2e8\uacc43 - \ub9e4 \ub808\uc774\uc2a4 \ud6c4 '\ud589\uc6b4\uc758 \ub8f0\ub81b' \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ucd94\uac00 \ud1b5\ud654\ub97c \ubc1b\uc744 \uae30\ud68c\ub97c \uc5bb\uc73c\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\ub3c4\uc2ec \uac70\ub9ac' \ud2b8\ub799\uc744 1\ubd84 \ubbf8\ub9cc\uc73c\ub85c \uc644\ub8cc\ud558\uba74 500\ucf54\uc778\uc774 \uc9c0\uae09\ub429\ub2c8\ub2e4. \ud6a8\uc728\uc131\uc744 \uadf9\ub300\ud654\ud558\uace0 \uc911\ub2e8 \uc2dc\uac04\uc744 \ucd5c\uc18c\ud654\ud558\ub294 \ub18d\uc0ac \uc791\ubb3c \uacbd\ub85c\ub97c \uacc4\ud68d\ud558\uae30 \uc704\ud574 \ud50c\ub85c\uc6b0\ucc28\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc138\uc694."}, {"question": "\ud06c\ub808\uc774\uc9c0 \ubaa8\ud130\uc0ac\uc774\ud074\uc758 \uc21c\uc704 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \ub9ac\ub354\ubcf4\ub4dc\ub97c \uc5b4\ub5bb\uac8c \uc62c\ub77c\uac08 \uc218 \uc788\ub098\uc694?", "answer": "\ud06c\ub808\uc774\uc9c0 \ubaa8\ud130\uc0ac\uc774\ud074\uc758 \uc21c\uc704 \uc2dc\uc2a4\ud15c\uc740 \ub808\uc774\uc2a4 \uc131\uacfc, \uc77c\uad00\uc131 \ubc0f \uc804\uccb4 \uc9c4\ud589 \uc0c1\ud669\uc758 \uc870\ud569\uc744 \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. \ub9ac\ub354\ubcf4\ub4dc\ub97c \uc62c\ub9ac\uae30 \uc704\ud574\uc11c\ub294: \ub2e8\uacc41 - \ucd5c\ub300\ud55c\uc758 \uc810\uc218\ub97c \uc5bb\uc73c\ub824\uba74 \ub808\uc774\uc2a4 \uc0c1\uc704 3\uc704 \uc548\uc5d0 \ub4e4\ub3c4\ub85d \uc9d1\uc911\ud558\uc138\uc694. \ub2e8\uacc42 - \uac01 \ub808\uc774\uc2a4\uc5d0\uc11c \uc2a4\ud134\ud2b8 \uc218\ud589\uc774\ub098 \ucda9\ub3cc \ubc29\uc9c0\uc640 \uac19\uc740 \ubaa8\ub4e0 \ubcf4\ub108\uc2a4 \ubaa9\ud45c\ub97c \uc644\ub8cc\ud558\uc138\uc694. \ub2e8\uacc43 - \ucd94\uac00 \uc21c\uc704 \uc810\uc218\ub97c \uc81c\uacf5\ud558\ub294 \uacc4\uc808 \uc774\ubca4\ud2b8\uc5d0 \ucc38\uc5ec\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uc5ec\ub984 \ud3ed\ud48d' \uc774\ubca4\ud2b8\uc5d0\uc11c \uc6b0\uc2b9\ud558\uba74 \uc21c\uc704\uac00 \ud06c\uac8c \uc0c1\uc2b9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc0c1\uc704 \ud50c\ub808\uc774\uc5b4\uc640\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ucd94\uc801\ud558\uace0 \uac1c\uc120\ud574\uc57c \ud560 \ubd80\ubd84\uc744 \ud30c\uc545\ud558\uae30 \uc704\ud574 \ube44\uad50\ud45c\ub97c \uc0ac\uc6a9\ud558\uc138\uc694."}, {"question": "PC\uc5d0\uc11c \ud06c\ub808\uc774\uc9c0 \ubaa8\ud130\uc0ac\uc774\ud074\uc744 \uc2e4\ud589\ud558\uae30 \uc704\ud55c \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc774\uba70, \ubaa8\ubc14\uc77c\uacfc \ube44\uad50\ub418\ub294 \uc131\ub2a5\uc740 \uc5b4\ub5bb\uac8c \ub418\ub098\uc694?", "answer": "PC \ubc84\uc804\uc758 \ud06c\ub808\uc774\uc9c0 \ubaa8\ud130\uc0ac\uc774\ud074\uc5d0\ub294 \ucd5c\uc18c \uc778\ud154 i5 \ud504\ub85c\uc138\uc11c, 8GB RAM \ubc0f 2GB VRAM\uc774 \uc7a5\ucc29\ub41c \uc804\uc6a9 GPU\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ubaa8\ubc14\uc77c\uacfc \ube44\uad50\ud558\uc5ec PC \ubc84\uc804\uc740 \ub192\uc740 \ud574\uc0c1\ub3c4 \ud14d\uc2a4\ucc98, \ub354 \uc6d0\ud65c\ud55c \ud504\ub808\uc784 \uc18d\ub3c4 \ubc0f \ud0a4\ubcf4\ub4dc \ub610\ub294 \ucee8\ud2b8\ub864\ub7ec \uc785\ub825 \uc9c0\uc6d0\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc911\uae09 PC\uc5d0\uc11c \uac8c\uc784\uc740 '\uc6b8\ud2b8\ub77c' \uc124\uc815\uc5d0\uc11c 60fps\ub85c \uc2e4\ud589\ub420 \uc218 \uc788\ub294 \ubc18\uba74, \uace0\uc131\ub2a5 \ubaa8\ubc14\uc77c \uae30\uae30\ub294 '\ub192\uc74c' \uc124\uc815\uc5d0\uc11c \ucd5c\ub300 30fps\ub85c \uc2e4\ud589\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\uc591\ud55c \uae30\uae30 \uac04\uc758 \uc131\ub2a5\uc744 \ube44\uad50\ud558\uace0 \ud558\ub4dc\uc6e8\uc5b4\uc5d0 \uac00\uc7a5 \uc801\ud569\ud55c \uc124\uc815\uc744 \uacb0\uc815\ud558\uae30 \uc704\ud574 \uad6c\uc131\ud45c\ub97c \uc0ac\uc6a9\ud558\uc138\uc694."}, {"question": "\ubaa8\ubc14\uc77c\uc5d0\uc11c PC\ub85c \ud06c\ub808\uc774\uc9c0 \ubaa8\ud130\uc0ac\uc774\ud074\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub824\uba74 \ub2e4\uc74c\uacfc \uac19\uc740 \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: \ub2e8\uacc41 - \ub450 \uae30\uae30 \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \ub2e8\uacc42 - \uc124\uc815 \uba54\ub274\uc5d0\uc11c '\ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5' \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ubaa8\ubc14\uc77c \uae30\uae30\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5c5\ub85c\ub4dc\ud558\uc138\uc694. \ub2e8\uacc43 - PC \ubc84\uc804\uc758 \uac8c\uc784\uc73c\ub85c \uc800\uc7a5 \ud30c\uc77c\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ubaa8\ubc14\uc77c\uc5d0\uc11c '\ub124\uc628 \ub77c\uc774\ub354' \uc624\ud1a0\ubc14\uc774\ub97c \uc7a0\uae08 \ud574\uc81c\ud588\ub2e4\uba74 \uc804\uc1a1 \ud6c4 PC\uc758 \ucc28\uace0\uc5d0 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \uc0c8\ub85c\uc6b4 \uc9d1\uc73c\ub85c \ubb3c\uac74\uc744 \uc62e\uae30\ub294 \uac83\uacfc \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uc138\uc694. \ub2e8\uacc4\ub97c \uc62c\ubc14\ub974\uac8c \ub530\ub974\uba74 \ubaa8\ub4e0 \uac83\uc774 \uc628\uc804\ud558\uac8c \uc720\uc9c0\ub429\ub2c8\ub2e4."}, {"question": "\ud06c\ub808\uc774\uc9c0 \ubaa8\ud130\uc0ac\uc774\ud074\uc5d0\uc11c \uc2a4\ud134\ud2b8\ub97c \uc218\ud589\ud558\ub294 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc774\uba70, \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "\ud06c\ub808\uc774\uc9c0 \ubaa8\ud130\uc0ac\uc774\ud074\uc5d0\uc11c \uc2a4\ud134\ud2b8\ub97c \uc218\ud589\ud558\ub824\uba74 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uacfc \uc81c\uc5b4\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc41 - \ucd5c\ub300 \uacf5\uc911 \uc2dc\uac04\uc744 \ud655\ubcf4\ud558\uae30 \uc704\ud574 \uace0\uc18d\uc73c\ub85c \uacbd\uc0ac\uba74\uc5d0 \uc811\uadfc\ud558\uc138\uc694. \ub2e8\uacc42 - \uae30\uc6b8\uc774\uae30 \ucee8\ud2b8\ub864 \ub610\ub294 \ud654\uba74 \ubc84\ud2bc\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud134\uc774\ub098 \uc2a4\ud540\uc744 \uc218\ud589\ud558\uc138\uc694. \ub2e8\uacc43 - \uc18d\ub3c4\ub97c \uc783\uac70\ub098 \ucd94\ub77d\ud558\ub294 \uac83\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \ubd80\ub4dc\ub7fd\uac8c \ucc29\ub959\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\ud611\uace1 \uc810\ud504' \ud2b8\ub799\uc5d0\uc11c \uba54\uc778 \uacbd\uc0ac\uba74 \uc704\ub85c \ubc31\ud50c\ub9bd\uc744 \uc218\ud589\ud558\uba74 \ucd94\uac00 \uc810\uc218\uac00 \uc9c0\uae09\ub429\ub2c8\ub2e4. \uc2a4\ud134\ud2b8\ub294 \uc2a4\ud0c0\uc77c \uc810\uc218\ub97c \ub354\ud560 \ubfd0\ub9cc \uc544\ub2c8\ub77c \ubd80\uc2a4\ud2b8 \uac8c\uc774\uc9c0\ub97c \ub354 \ube68\ub9ac \ucc44\uc6cc \ub808\uc774\uc2a4\uc5d0\uc11c \uc804\ub7b5\uc801 \uc774\uc810\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc2a4\ud134\ud2b8 \uacc4\ud68d\uc744 \uc704\ud55c \ud50c\ub85c\uc6b0\ucc28\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc644\ubcbd\ud558\uac8c \uc2e4\ud589\ud560 \uc218 \uc788\ub3c4\ub85d \ud558\uc138\uc694."}]
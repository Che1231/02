[{"question": "\u65b0\u624b\u5982\u4f55\u638c\u63e1\u75af\u72c2\u6469\u6258\u8f66\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u638c\u63e1\u75af\u72c2\u6469\u6258\u8f66\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa4 1 \u2013 \u719f\u6089\u5c4f\u5e55\u53f3\u4fa7\u7684\u6cb9\u95e8\u548c\u5239\u8f66\u6309\u94ae\u3002\u6b65\u9aa4 2 \u2013 \u901a\u8fc7\u503e\u659c\u8bbe\u5907\u6216\u4f7f\u7528\u5c4f\u5e55\u4e0a\u7684\u6309\u94ae\u7ec3\u4e60\u5de6\u53f3\u503e\u659c\u3002\u6b65\u9aa4 3 \u2013 \u5728\u76f4\u9053\u4e0a\u7b56\u7565\u6027\u5730\u4f7f\u7528\u52a0\u901f\u6309\u94ae\u6765\u83b7\u5f97\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u201c\u57ce\u5e02\u8857\u9053\u201d\u8d5b\u9053\u4e0a\uff0c\u5728\u7b2c\u4e8c\u4e2a\u5f2f\u9053\u540e\u52a0\u901f\u53ef\u4ee5\u5e2e\u52a9\u4f60\u8d85\u8d8a\u5bf9\u624b\u3002\u8fd9\u5c31\u50cf\u5b66\u4e60\u9a7e\u9a76\u771f\u6b63\u7684\u6469\u6258\u8f66\u4e00\u6837\u2014\u2014\u5148\u6162\u4e00\u4e9b\uff0c\u7136\u540e\u968f\u7740\u4f60\u83b7\u5f97\u81ea\u4fe1\uff0c\u9010\u6e10\u589e\u52a0\u4f60\u7684\u901f\u5ea6\u3002"}, {"question": "\u5728\u6e38\u620f\u73a9\u4e86 100 \u591a\u5c0f\u65f6\u540e\uff0c\u8d62\u5f97\u75af\u72c2\u6469\u6258\u8f66\u6bd4\u8d5b\u7684\u5173\u952e\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "100 \u591a\u5c0f\u65f6\u540e\uff0c\u4e13\u6ce8\u4e8e\u9ad8\u7ea7\u7b56\u7565\uff1a\u6b65\u9aa4 1 \u2013 \u901a\u8fc7\u7cbe\u786e\u8ba1\u65f6\u4f60\u7684\u503e\u659c\u6765\u5b8c\u7f8e\u63a7\u5236\u4f60\u7684\u5f2f\u9053\uff0c\u4ee5\u4fdd\u6301\u901f\u5ea6\u3002\u6b65\u9aa4 2 \u2013 \u5c0f\u5fc3\u5730\u7ba1\u7406\u4f60\u7684\u52a0\u901f\u8ba1\uff0c\u5c06\u5176\u4fdd\u5b58\u5230\u5173\u952e\u65f6\u523b\uff0c\u4f8b\u5982\u8d85\u8d8a\u6216\u9632\u5b88\u4f60\u7684\u4f4d\u7f6e\u3002\u6b65\u9aa4 3 \u2013 \u7814\u7a76\u6bcf\u4e2a\u8d5b\u9053\u7684\u5e03\u5c40\uff0c\u4ee5\u8bc6\u522b\u6377\u5f84\u6216\u6700\u4f73\u52a0\u901f\u533a\u57df\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5c71\u8def\u201d\u8d5b\u9053\u4e0a\uff0c\u7b2c\u4e09\u4e2a\u68c0\u67e5\u70b9\u540e\u6709\u4e00\u4e2a\u9690\u85cf\u7684\u6377\u5f84\u3002\u4f7f\u7528\u914d\u7f6e\u8868\u8ddf\u8e2a\u4f60\u7684\u6700\u4f73\u65f6\u95f4\u548c\u6bcf\u4e2a\u8d5b\u9053\u7684\u52a0\u901f\u4f7f\u7528\u60c5\u51b5\u3002\u8fd9\u79cd\u65b9\u6cd5\u5c06\u5e2e\u52a9\u4f60\u5b8c\u5584\u7b56\u7565\u5e76\u4e3b\u5bfc\u6bd4\u8d5b\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u75af\u72c2\u6469\u6258\u8f66\u7684\u7269\u7406\u5f15\u64ce\u611f\u89c9\u5982\u6b64\u903c\u771f\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u75af\u72c2\u6469\u6258\u8f66\u7684\u7269\u7406\u5f15\u64ce\u65e8\u5728\u6a21\u62df\u73b0\u5b9e\u4e16\u754c\u7684\u6469\u6258\u8f66\u52a8\u529b\u5b66\uff0c\u5305\u62ec\u91cd\u529b\u3001\u6469\u64e6\u529b\u548c\u52a8\u91cf\u3002\u8fd9\u79cd\u771f\u5b9e\u6027\u4f1a\u5f71\u54cd\u6e38\u620f\u4f53\u9a8c\uff0c\u8981\u6c42\u73a9\u5bb6\u5728\u8fc7\u5f2f\u65f6\u8003\u8651\u91cd\u91cf\u5206\u5e03\u548c\u901f\u5ea6\u7b49\u56e0\u7d20\u3002\u4f8b\u5982\uff0c\u4ee5\u9ad8\u901f\u8fc7\u6025\u5f2f\u800c\u4e0d\u6b63\u786e\u5730\u503e\u659c\u53ef\u80fd\u4f1a\u5bfc\u81f4\u4f60\u7684\u6469\u6258\u8f66\u6253\u6ed1\u3002\u8be5\u5f15\u64ce\u8fd8\u4f1a\u771f\u5b9e\u5730\u8ba1\u7b97\u78b0\u649e\u7684\u5f71\u54cd\uff0c\u8fd9\u610f\u5473\u7740\u4ee5\u9ad8\u901f\u649e\u51fb\u969c\u788d\u7269\u4f1a\u6781\u5927\u5730\u964d\u4f4e\u4f60\u7684\u901f\u5ea6\uff0c\u751a\u81f3\u628a\u4f60\u4ece\u6469\u6258\u8f66\u4e0a\u649e\u4e0b\u6765\u3002\u8fd9\u589e\u52a0\u4e86\u6e38\u620f\u7684\u6df1\u5ea6\uff0c\u4f7f\u5176\u65e2\u5177\u6709\u6311\u6218\u6027\u53c8\u5177\u6709\u56de\u62a5\u3002"}, {"question": "\u4e3a\u4e86\u5728\u6027\u80fd\u8f83\u4f4e\u7684\u8bbe\u5907\u4e0a\u4f18\u5316\u75af\u72c2\u6469\u6258\u8f66\uff0c\u6211\u5e94\u8be5\u8c03\u6574\u54ea\u4e9b\u8bbe\u7f6e\uff1f", "answer": "\u8981\u5728\u6027\u80fd\u8f83\u4f4e\u7684\u8bbe\u5907\u4e0a\u4f18\u5316\u75af\u72c2\u6469\u6258\u8f66\uff0c\u8bf7\u8c03\u6574\u4ee5\u4e0b\u8bbe\u7f6e\uff1a\u6b65\u9aa4 1 \u2013 \u5c06\u56fe\u5f62\u8d28\u91cf\u964d\u4f4e\u81f3\u201c\u4e2d\u7b49\u201d\u6216\u201c\u4f4e\u201d\u4ee5\u51cf\u5c11\u6e32\u67d3\u8d1f\u8f7d\u3002\u6b65\u9aa4 2 \u2013 \u5728\u8bbe\u7f6e\u83dc\u5355\u4e2d\u7981\u7528\u9634\u5f71\u548c\u53cd\u5c04\u7b49\u540e\u53f0\u8fdb\u7a0b\u3002\u6b65\u9aa4 3 \u2013 \u5982\u679c\u53ef\u7528\uff0c\u542f\u7528\u201c\u6027\u80fd\u6a21\u5f0f\u201d\uff0c\u8be5\u6a21\u5f0f\u4f18\u5148\u8003\u8651\u5e27\u901f\u7387\u800c\u4e0d\u662f\u89c6\u89c9\u4fdd\u771f\u5ea6\u3002\u4f8b\u5982\uff0c\u5728 2GB \u5185\u5b58\u7684\u8bbe\u5907\u4e0a\uff0c\u8fd9\u4e9b\u66f4\u6539\u53ef\u4ee5\u5c06\u5e27\u7387\u63d0\u9ad8\u591a\u8fbe 30%\u3002\u4f7f\u7528\u914d\u7f6e\u8868\u6bd4\u8f83\u8c03\u6574\u524d\u540e\u6027\u80fd\uff0c\u4ee5\u786e\u4fdd\u89c6\u89c9\u6548\u679c\u548c\u6e38\u620f\u6d41\u7545\u6027\u8fbe\u5230\u6700\u4f73\u5e73\u8861\u3002"}, {"question": "\u5982\u4f55\u5728\u75af\u72c2\u6469\u6258\u8f66\u4e2d\u89e3\u9501\u9690\u85cf\u7684\u201c\u5e7d\u7075\u9a91\u58eb\u201d\u6469\u6258\u8f66\uff1f", "answer": "\u8981\u89e3\u9501\u201c\u5e7d\u7075\u9a91\u58eb\u201d\u6469\u6258\u8f66\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa4 1 \u2013 \u5b8c\u6210\u201c\u5669\u68a6\u201d\u96be\u5ea6\u6a21\u5f0f\u4e2d\u7684\u6240\u6709 50 \u573a\u6bd4\u8d5b\u3002\u6b65\u9aa4 2 \u2013 \u6536\u96c6\u6563\u5e03\u5728\u5404\u79cd\u8d5b\u9053\u4e0a\u7684 100 \u4e2a\u9690\u85cf\u4ee4\u724c\u3002\u6b65\u9aa4 3 \u2013 \u5728 2 \u5206\u949f\u5185\u5b8c\u6210\u201c\u95f9\u9b3c\u9ad8\u901f\u516c\u8def\u201d\u8d5b\u9053\u3002\u4f8b\u5982\uff0c\u4e00\u4e2a\u4ee4\u724c\u9690\u85cf\u5728\u201c\u6c99\u6f20\u8d5b\u9053\u201d\u8d5b\u9053\u7684\u4e00\u4e2a\u5e7f\u544a\u724c\u540e\u9762\u3002\u201c\u5e7d\u7075\u9a91\u58eb\u201d\u5177\u6709\u72ec\u7279\u7684\u706b\u7130\u75d5\u8ff9\u6548\u679c\u548c\u66f4\u9ad8\u7684\u6700\u9ad8\u901f\u5ea6\uff0c\u8fd9\u4f7f\u5176\u6210\u4e3a\u6210\u5c31\u730e\u4eba\u7684\u6700\u7231\u3002\u5c06\u5176\u89c6\u4e3a\u4e00\u9879\u5bfb\u5b9d\u6e38\u620f\u2014\u2014\u8010\u5fc3\u548c\u6bc5\u529b\u662f\u5173\u952e\u3002"}, {"question": "\u5728\u75af\u72c2\u6469\u6258\u8f66\u4e2d\u5feb\u901f\u83b7\u5f97\u6e38\u620f\u5185\u8d27\u5e01\u7684\u6700\u4f73\u65b9\u6cd5\u662f\u4ec0\u4e48\uff1f", "answer": "\u5feb\u901f\u83b7\u5f97\u6e38\u620f\u5185\u8d27\u5e01\u7684\u65b9\u6cd5\uff1a\u6b65\u9aa4 1 \u2013 \u53c2\u52a0\u6bcf\u65e5\u6311\u6218\uff0c\u8fd9\u4e9b\u6311\u6218\u4f1a\u4e3a\u5b8c\u6210\u7279\u5b9a\u4efb\u52a1\u63d0\u4f9b\u5956\u52b1\u3002\u6b65\u9aa4 2 \u2013 \u78e8\u7ec3\u8f83\u77ed\u7684\u8d5b\u9053\uff0c\u4f8b\u5982\u201c\u57ce\u5e02\u8857\u9053\u201d\uff0c\u4ee5\u6700\u5927\u5316\u6bcf\u5c0f\u65f6\u7684\u6bd4\u8d5b\u5b8c\u6210\u6b21\u6570\u3002\u6b65\u9aa4 3 \u2013 \u6bcf\u6b21\u6bd4\u8d5b\u540e\u4f7f\u7528\u201c\u5e78\u8fd0\u8f6c\u76d8\u201d\u529f\u80fd\uff0c\u6709\u673a\u4f1a\u8d62\u5f97\u989d\u5916\u8d27\u5e01\u3002\u4f8b\u5982\uff0c\u5728 1 \u5206\u949f\u5185\u5b8c\u6210\u201c\u57ce\u5e02\u8857\u9053\u201d\u8d5b\u9053\u5c06\u5956\u52b1 500 \u679a\u786c\u5e01\u3002\u4f7f\u7528\u6d41\u7a0b\u56fe\u89c4\u5212\u4f60\u7684\u91c7\u96c6\u8def\u7ebf\uff0c\u786e\u4fdd\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u6548\u7387\u5e76\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u505c\u673a\u65f6\u95f4\u3002"}, {"question": "\u75af\u72c2\u6469\u6258\u8f66\u7684\u6392\u884c\u699c\u7cfb\u7edf\u5982\u4f55\u8fd0\u4f5c\uff0c\u4ee5\u53ca\u5982\u4f55\u63d0\u5347\u6392\u884c\u699c\u6392\u540d\uff1f", "answer": "\u75af\u72c2\u6469\u6258\u8f66\u7684\u6392\u884c\u699c\u7cfb\u7edf\u57fa\u4e8e\u8d5b\u7a0b\u8868\u73b0\u3001\u7a33\u5b9a\u6027\u548c\u6574\u4f53\u8fdb\u5c55\u7684\u7ec4\u5408\u3002\u8981\u63d0\u5347\u6392\u884c\u699c\u6392\u540d\uff1a\u6b65\u9aa4 1 \u2013 \u4e13\u6ce8\u4e8e\u5728\u6392\u540d\u524d\u4e09\u5b8c\u6210\u6bd4\u8d5b\u4ee5\u83b7\u5f97\u6700\u5927\u79ef\u5206\u3002\u6b65\u9aa4 2 \u2013 \u5b8c\u6210\u6bcf\u573a\u6bd4\u8d5b\u4e2d\u7684\u6240\u6709\u989d\u5916\u4efb\u52a1\uff0c\u4f8b\u5982\u8868\u6f14\u7279\u6280\u6216\u907f\u514d\u78b0\u649e\u3002\u6b65\u9aa4 3 \u2013 \u53c2\u52a0\u5b63\u8282\u6027\u6d3b\u52a8\uff0c\u8fd9\u4e9b\u6d3b\u52a8\u4f1a\u63d0\u4f9b\u989d\u5916\u7684\u6392\u540d\u79ef\u5206\u3002\u4f8b\u5982\uff0c\u8d62\u5f97\u201c\u590f\u5b63\u95ea\u7535\u6218\u201d\u6d3b\u52a8\u53ef\u4ee5\u663e\u8457\u63d0\u5347\u4f60\u7684\u6392\u540d\u3002\u4f7f\u7528\u6bd4\u8f83\u8868\u8ddf\u8e2a\u4f60\u7684\u8fdb\u6b65\u72b6\u51b5\uff0c\u4e0e\u9876\u7ea7\u73a9\u5bb6\u8fdb\u884c\u6bd4\u8f83\u5e76\u53d1\u73b0\u9700\u8981\u6539\u8fdb\u7684\u9886\u57df\u3002"}, {"question": "\u5728 PC \u4e0a\u8fd0\u884c\u75af\u72c2\u6469\u6258\u8f66\u6240\u9700\u7684\u7cfb\u7edf\u8981\u6c42\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5b83\u4e0e\u79fb\u52a8\u7248\u672c\u76f8\u6bd4\u5982\u4f55\uff1f", "answer": "PC \u7248\u75af\u72c2\u6469\u6258\u8f66\u81f3\u5c11\u9700\u8981\u82f1\u7279\u5c14 i5 \u5904\u7406\u5668\u30018GB \u5185\u5b58\u548c\u914d\u5907 2GB \u663e\u5b58\u7684\u72ec\u7acb\u663e\u5361\u3002\u4e0e\u79fb\u52a8\u7248\u76f8\u6bd4\uff0cPC \u7248\u63d0\u4f9b\u4e86\u66f4\u9ad8\u5206\u8fa8\u7387\u7684\u7eb9\u7406\u3001\u66f4\u6d41\u7545\u7684\u5e27\u901f\u7387\u4ee5\u53ca\u952e\u76d8\u6216\u624b\u67c4\u8f93\u5165\u7684\u652f\u6301\u3002\u4f8b\u5982\uff0c\u5728\u4e2d\u7aef PC \u4e0a\uff0c\u8be5\u6e38\u620f\u53ef\u4ee5\u5728\u201c\u8d85\u9ad8\u201d\u8bbe\u7f6e\u4e0b\u4ee5 60 \u5e27/\u79d2\u7684\u901f\u5ea6\u8fd0\u884c\uff0c\u800c\u9ad8\u7aef\u79fb\u52a8\u8bbe\u5907\u5728\u201c\u9ad8\u201d\u8bbe\u7f6e\u4e0b\u53ef\u80fd\u6700\u9ad8\u53ea\u80fd\u8fbe\u5230 30 \u5e27/\u79d2\u3002\u4f7f\u7528\u914d\u7f6e\u8868\u6bd4\u8f83\u4e0d\u540c\u8bbe\u5907\u7684\u6027\u80fd\uff0c\u5e76\u786e\u5b9a\u6700\u9002\u5408\u4f60\u786c\u4ef6\u7684\u8bbe\u7f6e\u3002"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684\u75af\u72c2\u6469\u6258\u8f66\u6e38\u620f\u8fdb\u5ea6\u4ece\u79fb\u52a8\u8bbe\u5907\u8f6c\u79fb\u5230 PC\uff1f", "answer": "\u8981\u8f6c\u79fb\u8fdb\u5ea6\uff1a\u6b65\u9aa4 1 \u2013 \u786e\u4fdd\u4f60\u5728\u4e24\u4e2a\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u5e10\u6237\u3002\u6b65\u9aa4 2 \u2013 \u4f7f\u7528\u8bbe\u7f6e\u83dc\u5355\u4e2d\u7684\u201c\u4e91\u4fdd\u5b58\u201d\u529f\u80fd\u5c06\u4f60\u7684\u6e38\u620f\u8fdb\u5ea6\u4ece\u79fb\u52a8\u8bbe\u5907\u4e0a\u4f20\u3002\u6b65\u9aa4 3 \u2013 \u4e0b\u8f7d\u4f60\u7684 PC \u7248\u6e38\u620f\u4e0a\u7684\u5b58\u6863\u6587\u4ef6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\u89e3\u9501\u4e86\u201c\u9713\u8679\u9a91\u58eb\u201d\u6469\u6258\u8f66\uff0c\u90a3\u4e48\u5728\u4f20\u8f93\u540e\uff0c\u5b83\u5c06\u5728\u4f60\u7684 PC \u7248\u6e38\u620f\u8f66\u5e93\u4e2d\u51fa\u73b0\u3002\u5c06\u5176\u89c6\u4e3a\u5c06\u4f60\u7684\u7269\u54c1\u642c\u5230\u65b0\u623f\u5b50\u2014\u2014\u53ea\u8981\u4f60\u6b63\u786e\u5730\u6309\u7167\u6b65\u9aa4\u64cd\u4f5c\uff0c\u4e00\u5207\u90fd\u4f1a\u4fdd\u6301\u5b8c\u6574\u3002"}, {"question": "\u5728\u75af\u72c2\u6469\u6258\u8f66\u6e38\u620f\u4e2d\u6267\u884c\u7279\u6280\u7684\u6700\u6709\u6548\u65b9\u6cd5\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5b83\u4eec\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u5728\u75af\u72c2\u6469\u6258\u8f66\u4e2d\u6267\u884c\u7279\u6280\u9700\u8981\u7cbe\u786e\u7684\u65f6\u673a\u548c\u63a7\u5236\u3002\u6b65\u9aa4 1 \u2013 \u4ee5\u9ad8\u901f\u63a5\u8fd1\u8df3\u677f\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u7a7a\u4e2d\u505c\u7559\u65f6\u95f4\u3002\u6b65\u9aa4 2 \u2013 \u4f7f\u7528\u503e\u659c\u63a7\u5236\u6216\u5c4f\u5e55\u4e0a\u7684\u6309\u94ae\u6765\u6267\u884c\u7ffb\u8f6c\u6216\u65cb\u8f6c\u3002\u6b65\u9aa4 3 \u2013 \u5e73\u7a33\u7740\u9646\u4ee5\u907f\u514d\u5931\u53bb\u901f\u5ea6\u6216\u5760\u6bc1\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5ce1\u8c37\u8df3\u8dc3\u201d\u8d5b\u9053\u4e0a\uff0c\u5728\u4e3b\u8df3\u677f\u4e0a\u5b8c\u6210\u540e\u7a7a\u7ffb\u5c06\u5956\u52b1\u989d\u5916\u79ef\u5206\u3002\u7279\u6280\u4e0d\u4ec5\u589e\u52a0\u4e86\u98ce\u683c\u5206\u503c\uff0c\u800c\u4e14\u8fd8\u53ef\u4ee5\u66f4\u5feb\u5730\u586b\u5145\u4f60\u7684\u52a0\u901f\u8ba1\uff0c\u8ba9\u4f60\u5728\u6bd4\u8d5b\u4e2d\u83b7\u5f97\u6218\u7565\u4f18\u52bf\u3002\u4f7f\u7528\u6d41\u7a0b\u56fe\u8ba1\u5212\u4f60\u7684\u7279\u6280\uff0c\u5e76\u786e\u4fdd\u4f60\u5b8c\u7f8e\u5730\u6267\u884c\u5b83\u4eec\u3002"}]
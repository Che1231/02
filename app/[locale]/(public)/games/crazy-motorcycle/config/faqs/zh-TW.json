[{"question": "\u5982\u4f55\u8b93\u521d\u5b78\u8005\u638c\u63e1\u760b\u72c2\u6a5f\u8eca\u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u7cbe\u901a\u760b\u72c2\u6a5f\u8eca\u7684\u57fa\u672c\u63a7\u5236\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f 1 - \u719f\u6089\u4f4d\u65bc\u87a2\u5e55\u53f3\u5074\u7684\u6cb9\u9580\u548c\u715e\u8eca\u6309\u9215\u3002\u6b65\u9a5f 2 - \u900f\u904e\u50be\u659c\u88dd\u7f6e\u6216\u4f7f\u7528\u87a2\u5e55\u4e0a\u7684\u6309\u9215\u7df4\u7fd2\u5de6\u53f3\u50be\u659c\u3002\u6b65\u9a5f 3 - \u5728\u76f4\u8def\u6642\u7b56\u7565\u6027\u5730\u4f7f\u7528\u52a0\u901f\u6309\u9215\u4f86\u52a0\u901f\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5e02\u5340\u8857\u9053\u300f\u8cfd\u9053\u4e0a\uff0c\u5728\u7b2c\u4e8c\u500b\u5f4e\u9053\u5f8c\u52a0\u901f\u53ef\u4ee5\u5e6b\u52a9\u4f60\u8d85\u8d8a\u5c0d\u624b\u3002\u60f3\u60f3\u770b\uff0c\u9019\u5c31\u50cf\u5b78\u7fd2\u9a0e\u771f\u5be6\u7684\u6a5f\u8eca\u4e00\u6a23\u2014\u2014\u5148\u6162\u4e0b\u4f86\uff0c\u7136\u5f8c\u96a8\u8457\u4fe1\u5fc3\u589e\u52a0\u9010\u6f38\u63d0\u9ad8\u901f\u5ea6\u3002"}, {"question": "\u5728\u904a\u6232\u8d85\u904e 100 \u5c0f\u6642\u5f8c\uff0c\u8d0f\u5f97\u760b\u72c2\u6a5f\u8eca\u6bd4\u8cfd\u7684\u95dc\u9375\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u8d85\u904e 100 \u5c0f\u6642\u5f8c\uff0c\u8acb\u5c08\u6ce8\u65bc\u9032\u968e\u7b56\u7565\uff1a\u6b65\u9a5f 1 - \u7cbe\u78ba\u638c\u63e1\u50be\u659c\u6642\u9593\u4ee5\u4fdd\u6301\u901f\u5ea6\uff0c\u5b8c\u7f8e\u99d5\u99ad\u5f4e\u9053\u3002\u6b65\u9a5f 2 - \u5c0f\u5fc3\u7ba1\u7406\u52a0\u901f\u8a08\u91cf\uff0c\u5c07\u5176\u5132\u5b58\u65bc\u95dc\u9375\u6642\u523b\uff0c\u4f8b\u5982\u8d85\u8d8a\u6216\u9632\u5b88\u4f60\u7684\u4f4d\u7f6e\u3002\u6b65\u9a5f 3 - \u5b78\u7fd2\u6bcf\u689d\u8cfd\u9053\u7684\u4f48\u5c40\uff0c\u4ee5\u627e\u51fa\u6377\u5f91\u6216\u6700\u4f73\u52a0\u901f\u5340\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5c71\u8def\u300f\u8cfd\u9053\u4e0a\uff0c\u7b2c\u4e09\u500b\u6aa2\u67e5\u9ede\u5f8c\u6709\u4e00\u500b\u96b1\u85cf\u7684\u6377\u5f91\u3002\u4f7f\u7528\u914d\u7f6e\u8868\u4f86\u8ffd\u8e64\u6bcf\u500b\u8cfd\u9053\u7684\u6700\u4f73\u6642\u9593\u548c\u52a0\u901f\u4f7f\u7528\u60c5\u6cc1\u3002\u9019\u7a2e\u65b9\u6cd5\u5c07\u6709\u52a9\u65bc\u4f60\u5b8c\u5584\u7b56\u7565\u4e26\u5728\u6bd4\u8cfd\u4e2d\u4f54\u64da\u4e3b\u5c0e\u5730\u4f4d\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u760b\u72c2\u6a5f\u8eca\u7684\u7269\u7406\u5f15\u64ce\u611f\u89ba\u5982\u6b64\u771f\u5be6\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff1f", "answer": "\u760b\u72c2\u6a5f\u8eca\u7684\u7269\u7406\u5f15\u64ce\u8a2d\u8a08\u7528\u65bc\u6a21\u64ec\u771f\u5be6\u4e16\u754c\u7684\u6a5f\u8eca\u52d5\u529b\u5b78\uff0c\u5305\u62ec\u91cd\u529b\u3001\u6469\u64e6\u529b\u548c\u52d5\u91cf\u3002\u9019\u7a2e\u771f\u5be6\u611f\u6703\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff0c\u8981\u6c42\u73a9\u5bb6\u5728\u5f4e\u9053\u6642\u8003\u616e\u91cd\u91cf\u5206\u4f48\u548c\u901f\u5ea6\u7b49\u56e0\u7d20\u3002\u4f8b\u5982\uff0c\u4ee5\u9ad8\u901f\u6025\u8f49\u5f4e\u4f46\u6c92\u6709\u6b63\u78ba\u50be\u659c\uff0c\u6703\u5c0e\u81f4\u4f60\u7684\u6a5f\u8eca\u6253\u6ed1\u3002\u8a72\u5f15\u64ce\u4e5f\u6703\u771f\u5be6\u8a08\u7b97\u78b0\u649e\u885d\u64ca\uff0c\u9019\u8868\u793a\u4ee5\u9ad8\u901f\u649e\u64ca\u969c\u7919\u7269\u6703\u5927\u5e45\u964d\u4f4e\u4f60\u7684\u901f\u5ea6\uff0c\u751a\u81f3\u6703\u8b93\u4f60\u5f9e\u6a5f\u8eca\u4e0a\u6454\u4e0b\u4f86\u3002\u9019\u589e\u52a0\u4e86\u904a\u6232\u7684\u6df1\u5ea6\uff0c\u4f7f\u5176\u65e2\u5177\u6311\u6230\u6027\u53c8\u4ee4\u4eba\u6eff\u610f\u3002"}, {"question": "\u6211\u61c9\u8a72\u8abf\u6574\u760b\u72c2\u6a5f\u8eca\u7684\u54ea\u4e9b\u8a2d\u5b9a\u624d\u80fd\u5728\u4f4e\u7aef\u88dd\u7f6e\u4e0a\u512a\u5316\u6548\u80fd\uff1f", "answer": "\u8981\u5728\u4f4e\u7aef\u88dd\u7f6e\u4e0a\u512a\u5316\u760b\u72c2\u6a5f\u8eca\uff0c\u8acb\u8abf\u6574\u4e0b\u5217\u8a2d\u5b9a\uff1a\u6b65\u9a5f 1 - \u5c07\u5716\u5f62\u54c1\u8cea\u964d\u4f4e\u81f3\u300c\u4e2d\u300d\u6216\u300c\u4f4e\u300d\uff0c\u4ee5\u6e1b\u5c11\u6e32\u67d3\u8ca0\u8f09\u3002\u6b65\u9a5f 2 - \u5728\u8a2d\u5b9a\u9078\u55ae\u4e2d\u505c\u7528\u9670\u5f71\u548c\u53cd\u5c04\u7b49\u80cc\u666f\u8655\u7406\u3002\u6b65\u9a5f 3 - \u5982\u679c\u53ef\u7528\uff0c\u8acb\u555f\u7528\u300c\u6548\u80fd\u6a21\u5f0f\u300d\uff0c\u5b83\u512a\u5148\u65bc\u756b\u9762\u6e05\u6670\u5ea6\uff0c\u512a\u5148\u8003\u616e\u5e40\u7387\u3002\u4f8b\u5982\uff0c\u5728\u87a2\u5e55\u8a18\u61b6\u9ad4\u50c5 2GB \u7684\u88dd\u7f6e\u4e0a\uff0c\u9019\u4e9b\u8b8a\u66f4\u53ef\u5c07\u5e40\u7387\u63d0\u9ad8\u9ad8\u9054 30%\u3002\u4f7f\u7528\u914d\u7f6e\u8868\u6bd4\u8f03\u8abf\u6574\u524d\u5f8c\u7684\u6548\u80fd\uff0c\u78ba\u4fdd\u5716\u50cf\u548c\u904a\u6232\u6d41\u66a2\u5ea6\u4e4b\u9593\u9054\u5230\u6700\u4f73\u5e73\u8861\u3002"}, {"question": "\u5982\u4f55\u5728\u760b\u72c2\u6a5f\u8eca\u4e2d\u89e3\u9396\u96b1\u85cf\u7684\u300e\u5e7d\u9748\u9a0e\u58eb\u300f\u6a5f\u8eca\uff1f", "answer": "\u8981\u89e3\u9396\u300e\u5e7d\u9748\u9a0e\u58eb\u300f\u6a5f\u8eca\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f 1 - \u5b8c\u6210\u300e\u5669\u5922\u300f\u96e3\u5ea6\u6a21\u5f0f\u4e2d\u7684\u6240\u6709 50 \u5834\u8cfd\u4e8b\u3002\u6b65\u9a5f 2 - \u6536\u96c6\u6563\u4f48\u5728\u5404\u500b\u8cfd\u9053\u4e0a\u7684 100 \u500b\u96b1\u85cf\u6a19\u8a8c\u3002\u6b65\u9a5f 3 - \u5728 2 \u5206\u9418\u5167\u5b8c\u6210\u300e\u9b3c\u9b45\u9ad8\u901f\u516c\u8def\u300f\u8cfd\u9053\u3002\u4f8b\u5982\uff0c\u6709\u4e00\u500b\u6a19\u8a8c\u96b1\u85cf\u5728\u300e\u6c99\u6f20\u5954\u99b3\u300f\u8cfd\u9053\u7684\u4e00\u500b\u5ee3\u544a\u724c\u5f8c\u9762\u3002\u300e\u5e7d\u9748\u9a0e\u58eb\u300f\u5177\u6709\u7368\u7279\u7684\u706b\u7130\u5c3e\u8de1\u6548\u679c\u548c\u66f4\u9ad8\u7684\u6700\u9ad8\u901f\u5ea6\uff0c\u9019\u4f7f\u5f97\u5b83\u6210\u70ba\u6210\u5c31\u7375\u4eba\u7684\u6700\u611b\u3002\u60f3\u60f3\u770b\uff0c\u9019\u5c31\u50cf\u4e00\u6b21\u5c0b\u5bf6\u904a\u6232\u2014\u2014\u8010\u5fc3\u548c\u6bc5\u529b\u662f\u95dc\u9375\u3002"}, {"question": "\u5728\u760b\u72c2\u6a5f\u8eca\u4e2d\u5feb\u901f\u8cfa\u53d6\u904a\u6232\u8ca8\u5e63\u7684\u6700\u4f73\u65b9\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5feb\u901f\u8cfa\u53d6\u904a\u6232\u8ca8\u5e63\u7684\u65b9\u6cd5\uff1a\u6b65\u9a5f 1 - \u53c3\u8207\u6bcf\u65e5\u6311\u6230\uff0c\u5b8c\u6210\u7279\u5b9a\u4efb\u52d9\u5c07\u7372\u5f97\u984d\u5916\u734e\u52f5\u3002\u6b65\u9a5f 2 - \u99d5\u99db\u77ed\u8cfd\u9053\uff0c\u4f8b\u5982\u300e\u5e02\u5340\u8857\u9053\u300f\uff0c\u4ee5\u6700\u5927\u5316\u6bcf\u5c0f\u6642\u7684\u8cfd\u4e8b\u5b8c\u6210\u6b21\u6578\u3002\u6b65\u9a5f 3 - \u5728\u6bcf\u6b21\u6bd4\u8cfd\u5f8c\u4f7f\u7528\u300e\u5e78\u904b\u8f49\u76e4\u300f\u529f\u80fd\uff0c\u8d0f\u53d6\u984d\u5916\u8ca8\u5e63\u7684\u6a5f\u6703\u3002\u4f8b\u5982\uff0c\u5728 1 \u5206\u9418\u5167\u5b8c\u6210\u300e\u5e02\u5340\u8857\u9053\u300f\u8cfd\u9053\u5c07\u7372\u5f97 500 \u500b\u9285\u677f\u3002\u4f7f\u7528\u6d41\u7a0b\u5716\u898f\u5283\u60a8\u7684\u8cfa\u53d6\u8def\u7dda\uff0c\u78ba\u4fdd\u6700\u5927\u5316\u6548\u7387\u4e26\u5c07\u505c\u6a5f\u6642\u9593\u964d\u81f3\u6700\u4f4e\u3002"}, {"question": "\u760b\u72c2\u6a5f\u8eca\u7684\u6392\u884c\u699c\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u6211\u5982\u4f55\u63d0\u5347\u6392\u884c\u699c\u4e0a\u7684\u6392\u540d\uff1f", "answer": "\u760b\u72c2\u6a5f\u8eca\u7684\u6392\u884c\u699c\u7cfb\u7d71\u57fa\u65bc\u6bd4\u8cfd\u8868\u73fe\u3001\u7a69\u5b9a\u6027\u4ee5\u53ca\u6574\u9ad4\u9032\u5ea6\u3002\u8981\u63d0\u5347\u6392\u884c\u699c\u4e0a\u7684\u6392\u540d\uff1a\u6b65\u9a5f 1 - \u5c08\u6ce8\u65bc\u5b8c\u6210\u524d\u4e09\u540d\u6bd4\u8cfd\u4ee5\u7372\u5f97\u6700\u5927\u7a4d\u5206\u3002\u6b65\u9a5f 2 - \u5b8c\u6210\u6bd4\u8cfd\u4e2d\u7684\u6240\u6709\u984d\u5916\u76ee\u6a19\uff0c\u4f8b\u5982\u8868\u6f14\u7279\u6280\u6216\u907f\u514d\u78b0\u649e\u3002\u6b65\u9a5f 3 - \u53c3\u8207\u5b63\u7bc0\u6027\u6d3b\u52d5\uff0c\u9019\u4e9b\u6d3b\u52d5\u5c07\u63d0\u4f9b\u984d\u5916\u7684\u6392\u884c\u699c\u7a4d\u5206\u3002\u4f8b\u5982\uff0c\u8d0f\u5f97\u300e\u590f\u5b63\u9583\u96fb\u6230\u300f\u6d3b\u52d5\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u60a8\u7684\u6392\u540d\u3002\u4f7f\u7528\u6bd4\u8f03\u8868\u683c\u8ffd\u8e64\u60a8\u8207\u9802\u7d1a\u73a9\u5bb6\u7684\u9032\u5ea6\uff0c\u4e26\u627e\u51fa\u6539\u9032\u9818\u57df\u3002"}, {"question": "\u5728 PC \u4e0a\u904b\u4f5c\u760b\u72c2\u6a5f\u8eca\u7684\u7cfb\u7d71\u9700\u6c42\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5b83\u8207\u884c\u52d5\u88dd\u7f6e\u76f8\u6bd4\u6709\u4f55\u4e0d\u540c\uff1f", "answer": "\u5728 PC \u4e0a\u904b\u4f5c\u760b\u72c2\u6a5f\u8eca\u81f3\u5c11\u9700\u8981\u82f1\u7279\u723e i5 \u8655\u7406\u5668\u30018GB \u8a18\u61b6\u9ad4\u4ee5\u53ca\u5177\u5099 2GB \u986f\u793a\u8a18\u61b6\u9ad4\u7684\u7368\u7acb\u986f\u793a\u5361\u3002\u8207\u884c\u52d5\u88dd\u7f6e\u76f8\u6bd4\uff0cPC \u7248\u672c\u63d0\u4f9b\u66f4\u9ad8\u89e3\u6790\u5ea6\u7684\u7d0b\u7406\u3001\u66f4\u6d41\u66a2\u7684\u5e40\u7387\u4ee5\u53ca\u5c0d\u9375\u76e4\u6216\u63a7\u5236\u5668\u8f38\u5165\u7684\u652f\u6301\u3002\u4f8b\u5982\uff0c\u5728\u4e2d\u6a94 PC \u4e0a\uff0c\u904a\u6232\u53ef\u4ee5\u5728\u300e\u6975\u9ad8\u300f\u8a2d\u5b9a\u4e0b\u4ee5 60 \u5e40\u6bcf\u79d2\u904b\u884c\uff0c\u800c\u9ad8\u968e\u884c\u52d5\u88dd\u7f6e\u5728\u300e\u9ad8\u300f\u8a2d\u5b9a\u4e0b\u6700\u9ad8\u53ef\u80fd\u9054\u5230 30 \u5e40\u6bcf\u79d2\u3002 \u4f7f\u7528\u914d\u7f6e\u8868\u6bd4\u8f03\u4e0d\u540c\u88dd\u7f6e\u7684\u6548\u80fd\uff0c\u4e26\u78ba\u5b9a\u6700\u9069\u5408\u60a8\u786c\u9ad4\u7684\u8a2d\u5b9a\u3002"}, {"question": "\u5982\u4f55\u5c07\u6211\u7684\u760b\u72c2\u6a5f\u8eca\u904a\u6232\u9032\u5ea6\u5f9e\u884c\u52d5\u88dd\u7f6e\u8f49\u79fb\u5230 PC\uff1f", "answer": "\u8981\u8f49\u79fb\u9032\u5ea6\uff1a\u6b65\u9a5f 1 - \u78ba\u4fdd\u60a8\u5728\u5169\u53f0\u88dd\u7f6e\u4e0a\u90fd\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u3002\u6b65\u9a5f 2 - \u4f7f\u7528\u8a2d\u5b9a\u9078\u55ae\u4e2d\u7684\u300e\u96f2\u7aef\u5132\u5b58\u300f\u529f\u80fd\u5c07\u60a8\u7684\u904a\u6232\u9032\u5ea6\u5f9e\u884c\u52d5\u88dd\u7f6e\u4e0a\u50b3\u3002\u6b65\u9a5f 3 - \u5728\u60a8 PC \u7248\u904a\u6232\u4e2d\u4e0b\u8f09\u5132\u5b58\u6a94\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5df2\u5728\u884c\u52d5\u88dd\u7f6e\u4e0a\u89e3\u9396\u300e\u9713\u8679\u9a0e\u58eb\u300f\u6a5f\u8eca\uff0c\u5247\u8f49\u79fb\u5f8c\u5b83\u6703\u51fa\u73fe\u5728\u60a8\u7684\u8eca\u5eab\u4e2d\u3002\u60f3\u60f3\u770b\uff0c\u9019\u5c31\u50cf\u662f\u5c07\u60a8\u7684\u7269\u54c1\u642c\u5230\u65b0\u5bb6\u4e00\u6a23\u2014\u2014\u53ea\u8981\u6b63\u78ba\u9075\u5faa\u6b65\u9a5f\uff0c\u6240\u6709\u6771\u897f\u90fd\u6703\u4fdd\u6301\u539f\u72c0\u3002"}, {"question": "\u5728\u760b\u72c2\u6a5f\u8eca\u4e2d\u57f7\u884c\u7279\u6280\u7684\u6709\u6548\u65b9\u6cd5\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5b83\u5011\u5982\u4f55\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff1f", "answer": "\u5728\u760b\u72c2\u6a5f\u8eca\u4e2d\u57f7\u884c\u7279\u6280\u9700\u8981\u7cbe\u78ba\u7684\u6642\u6a5f\u548c\u63a7\u5236\u3002\u6b65\u9a5f 1 - \u4ee5\u9ad8\u901f\u63a5\u8fd1\u659c\u5761\uff0c\u4ee5\u6700\u5927\u5316\u7a7a\u4e2d\u505c\u7559\u6642\u9593\u3002\u6b65\u9a5f 2 - \u4f7f\u7528\u50be\u659c\u63a7\u5236\u6216\u87a2\u5e55\u4e0a\u7684\u6309\u9215\u4f86\u57f7\u884c\u7ffb\u8f49\u6216\u65cb\u8f49\u3002\u6b65\u9a5f 3 - \u5e73\u7a69\u8457\u9678\uff0c\u4ee5\u907f\u514d\u5931\u53bb\u901f\u5ea6\u6216\u767c\u751f\u78b0\u649e\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5cfd\u8c37\u8df3\u8e8d\u300f\u8cfd\u9053\u4e0a\uff0c\u5728\u4e3b\u8981\u659c\u5761\u4e0a\u5b8c\u6210\u5f8c\u7a7a\u7ffb\u5c07\u6703\u7372\u5f97\u984d\u5916\u7a4d\u5206\u3002\u7279\u6280\u4e0d\u50c5\u589e\u52a0\u98a8\u683c\u5206\u6578\uff0c\u9084\u80fd\u66f4\u5feb\u5730\u586b\u6eff\u52a0\u901f\u8a08\u91cf\uff0c\u5728\u6bd4\u8cfd\u4e2d\u7d66\u4f60\u7b56\u7565\u4e0a\u7684\u512a\u52e2\u3002 \u4f7f\u7528\u6d41\u7a0b\u5716\u898f\u5283\u60a8\u7684\u7279\u6280\u4e26\u78ba\u4fdd\u5b8c\u7f8e\u57f7\u884c\u3002"}]
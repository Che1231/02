[{"question": "\u521d\u5fc3\u8005\u304c\u30af\u30ec\u30a4\u30b8\u30fc\u30e2\u30fc\u30bf\u30fc\u30b5\u30a4\u30af\u30eb\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30af\u30ec\u30a4\u30b8\u30fc\u30e2\u30fc\u30bf\u30fc\u30b5\u30a4\u30af\u30eb\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u753b\u9762\u53f3\u5074\u306b\u4f4d\u7f6e\u3059\u308b\u30b9\u30ed\u30c3\u30c8\u30eb\u3068\u30d6\u30ec\u30fc\u30ad\u30dc\u30bf\u30f3\u306b\u6163\u308c\u89aa\u3057\u3093\u3067\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30c7\u30d0\u30a4\u30b9\u3092\u50be\u3051\u308b\u304b\u3001\u753b\u9762\u4e0a\u306e\u30dc\u30bf\u30f3\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u5de6\u53f3\u306b\u50be\u3051\u308b\u7df4\u7fd2\u3092\u884c\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u76f4\u7dda\u533a\u9593\u3067\u306f\u30d6\u30fc\u30b9\u30c8\u30dc\u30bf\u30f3\u3092\u6226\u7565\u7684\u306b\u4f7f\u7528\u3057\u3066\u901f\u5ea6\u3092\u4e0a\u3052\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u300c\u30b7\u30c6\u30a3\u30b9\u30c8\u30ea\u30fc\u30c8\u300d\u30b3\u30fc\u30b9\u3067\u306f\u30012\u756a\u76ee\u306e\u30bf\u30fc\u30f3\u5f8c\u306b\u30d6\u30fc\u30b9\u30c8\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u30e9\u30a4\u30d0\u30eb\u306b\u8ffd\u3044\u629c\u304f\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u672c\u7269\u306e\u30d0\u30a4\u30af\u306b\u4e57\u308b\u3053\u3068\u3092\u5b66\u3076\u306e\u3068\u540c\u3058\u3067\u3059\u3002\u6700\u521d\u306f\u3086\u3063\u304f\u308a\u3068\u59cb\u3081\u3001\u81ea\u4fe1\u304c\u3064\u304f\u306b\u3064\u308c\u3066\u5f90\u3005\u306b\u901f\u5ea6\u3092\u4e0a\u3052\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "100\u6642\u9593\u4ee5\u4e0a\u306e\u30d7\u30ec\u30a4\u6642\u9593\u5f8c\u3001\u30af\u30ec\u30a4\u30b8\u30fc\u30e2\u30fc\u30bf\u30fc\u30b5\u30a4\u30af\u30eb\u3067\u30ec\u30fc\u30b9\u306b\u52dd\u3064\u305f\u3081\u306e\u4e3b\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "100\u6642\u9593\u4ee5\u4e0a\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u306f\u3001\u9ad8\u5ea6\u306a\u6226\u7565\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b3\u30fc\u30ca\u30fc\u30ea\u30f3\u30b0\u3092\u5b8c\u74a7\u306b\u30de\u30b9\u30bf\u30fc\u3057\u307e\u3059\u3002\u6b63\u78ba\u306a\u50be\u304d\u3092\u30bf\u30a4\u30df\u30f3\u30b0\u3088\u304f\u5236\u5fa1\u3059\u308b\u3053\u3068\u3067\u3001\u901f\u5ea6\u3092\u7dad\u6301\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d6\u30fc\u30b9\u30c8\u30b2\u30fc\u30b8\u3092\u614e\u91cd\u306b\u7ba1\u7406\u3057\u3001\u8ffd\u3044\u629c\u304d\u3084\u30dd\u30b8\u30b7\u30e7\u30f3\u7dad\u6301\u306a\u3069\u3001\u91cd\u8981\u306a\u77ac\u9593\u306b\u8caf\u3081\u3066\u304a\u3044\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5404\u30b3\u30fc\u30b9\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u7814\u7a76\u3057\u3001\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u3084\u6700\u9069\u306a\u30d6\u30fc\u30b9\u30c8\u30be\u30fc\u30f3\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30de\u30a6\u30f3\u30c6\u30f3\u30d1\u30b9\u300d\u30b3\u30fc\u30b9\u3067\u306f\u30013\u756a\u76ee\u306e\u30c1\u30a7\u30c3\u30af\u30dd\u30a4\u30f3\u30c8\u306e\u5f8c\u306b\u96a0\u308c\u305f\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u304c\u3042\u308a\u307e\u3059\u3002\u69cb\u6210\u8868\u3092\u4f7f\u7528\u3057\u3066\u3001\u30b3\u30fc\u30b9\u5225\u306e\u30d9\u30b9\u30c8\u30bf\u30a4\u30e0\u3068\u30d6\u30fc\u30b9\u30c8\u4f7f\u7528\u91cf\u3092\u8ffd\u8de1\u3057\u307e\u3059\u3002\u3053\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u6226\u7565\u3092\u6d17\u7df4\u3057\u3001\u30ec\u30fc\u30b9\u3092\u652f\u914d\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u306a\u305c\u30af\u30ec\u30a4\u30b8\u30fc\u30e2\u30fc\u30bf\u30fc\u30b5\u30a4\u30af\u30eb\u306e\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u306f\u975e\u5e38\u306b\u30ea\u30a2\u30eb\u306b\u611f\u3058\u3089\u308c\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u304b\uff1f", "answer": "\u30af\u30ec\u30a4\u30b8\u30fc\u30e2\u30fc\u30bf\u30fc\u30b5\u30a4\u30af\u30eb\u306e\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u306f\u3001\u91cd\u529b\u3001\u6469\u64e6\u3001\u904b\u52d5\u91cf\u306a\u3069\u3001\u73fe\u5b9f\u4e16\u754c\u306e\u30d0\u30a4\u30af\u306e\u30c0\u30a4\u30ca\u30df\u30af\u30b9\u3092\u30b7\u30df\u30e5\u30ec\u30fc\u30c8\u3059\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u3053\u306e\u30ea\u30a2\u30ea\u30ba\u30e0\u306f\u3001\u30b3\u30fc\u30ca\u30fc\u30ea\u30f3\u30b0\u6642\u306b\u91cd\u91cf\u914d\u5206\u3084\u901f\u5ea6\u3068\u3044\u3063\u305f\u8981\u7d20\u3092\u8003\u616e\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u3053\u3068\u3067\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u5f71\u97ff\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u9069\u5207\u306a\u50be\u304d\u3092\u305b\u305a\u306b\u9ad8\u901f\u3067\u6025\u30ab\u30fc\u30d6\u306b\u5165\u308b\u3068\u3001\u30d0\u30a4\u30af\u304c\u30b9\u30ea\u30c3\u30d7\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u30a8\u30f3\u30b8\u30f3\u306f\u307e\u305f\u3001\u885d\u7a81\u885d\u6483\u3092\u73fe\u5b9f\u7684\u306b\u8a08\u7b97\u3059\u308b\u305f\u3081\u3001\u9ad8\u901f\u3067\u969c\u5bb3\u7269\u306b\u3076\u3064\u304b\u308b\u3053\u3068\u3067\u30d0\u30a4\u30af\u306e\u901f\u5ea6\u304c\u5927\u5e45\u306b\u4f4e\u4e0b\u3057\u305f\u308a\u3001\u30d0\u30a4\u30af\u304b\u3089\u8ee2\u843d\u3057\u305f\u308a\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u306f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u5965\u884c\u304d\u3092\u52a0\u3048\u3001\u6311\u6226\u7684\u3067\u304b\u3064\u3084\u308a\u304c\u3044\u306e\u3042\u308b\u3082\u306e\u306b\u3057\u307e\u3059\u3002"}, {"question": "\u4f4e\u30a8\u30f3\u30c9\u30c7\u30d0\u30a4\u30b9\u3067\u30af\u30ec\u30a4\u30b8\u30fc\u30e2\u30fc\u30bf\u30fc\u30b5\u30a4\u30af\u30eb\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u305f\u3081\u306b\u3001\u3069\u306e\u8a2d\u5b9a\u3092\u8abf\u6574\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u4f4e\u30a8\u30f3\u30c9\u30c7\u30d0\u30a4\u30b9\u3067\u30af\u30ec\u30a4\u30b8\u30fc\u30e2\u30fc\u30bf\u30fc\u30b5\u30a4\u30af\u30eb\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u6b21\u306e\u8a2d\u5b9a\u3092\u8abf\u6574\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u54c1\u8cea\u3092\u300c\u4e2d\u300d\u307e\u305f\u306f\u300c\u4f4e\u300d\u306b\u4e0b\u3052\u3066\u3001\u30ec\u30f3\u30c0\u30ea\u30f3\u30b0\u8ca0\u8377\u3092\u8efd\u6e1b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u3067\u5f71\u3084\u53cd\u5c04\u306a\u3069\u306e\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u30d7\u30ed\u30bb\u30b9\u3092\u7121\u52b9\u306b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u8996\u899a\u7684\u306a\u5fe0\u5b9f\u5ea6\u3088\u308a\u3082\u30d5\u30ec\u30fc\u30e0\u30ec\u30fc\u30c8\u3092\u512a\u5148\u3059\u308b\u300c\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u30e2\u30fc\u30c9\u300d\u3092\u6709\u52b9\u306b\u3057\u307e\u3059\uff08\u5229\u7528\u53ef\u80fd\u306a\u5834\u5408\uff09\u3002\u4f8b\u3048\u3070\u30012GB RAM\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u3053\u308c\u3089\u306e\u5909\u66f4\u3092\u884c\u3046\u3068\u3001\u30d5\u30ec\u30fc\u30e0\u30ec\u30fc\u30c8\u306f\u6700\u592730%\u5411\u4e0a\u3057\u307e\u3059\u3002\u8a2d\u5b9a\u8868\u3092\u4f7f\u7528\u3057\u3066\u3001\u8abf\u6574\u524d\u5f8c\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6bd4\u8f03\u3057\u3001\u8996\u899a\u3068\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u6ed1\u3089\u304b\u3055\u306e\u30d0\u30e9\u30f3\u30b9\u3092\u6700\u9069\u5316\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30af\u30ec\u30a4\u30b8\u30fc\u30e2\u30fc\u30bf\u30fc\u30b5\u30a4\u30af\u30eb\u3067\u96a0\u3055\u308c\u305f\u300c\u30b4\u30fc\u30b9\u30c8\u30e9\u30a4\u30c0\u30fc\u300d\u30d0\u30a4\u30af\u3092\u3069\u306e\u3088\u3046\u306b\u30ed\u30c3\u30af\u89e3\u9664\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u300c\u30b4\u30fc\u30b9\u30c8\u30e9\u30a4\u30c0\u30fc\u300d\u30d0\u30a4\u30af\u3092\u30ed\u30c3\u30af\u89e3\u9664\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u3059\u3079\u3066\u306e\u30ec\u30fc\u30b9\u3092\u300c\u30ca\u30a4\u30c8\u30e1\u30a2\u300d\u96e3\u6613\u5ea6\u3067\u5b8c\u4e86\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u3055\u307e\u3056\u307e\u306a\u30b3\u30fc\u30b9\u306b\u6563\u3089\u3070\u3063\u3066\u3044\u308b100\u500b\u306e\u96a0\u3055\u308c\u305f\u30c8\u30fc\u30af\u30f3\u3092\u96c6\u3081\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u300c\u30cf\u30f3\u30c8\u30fc\u30c9\u30cf\u30a4\u30a6\u30a7\u30a4\u300d\u30b3\u30fc\u30b9\u30922\u5206\u4ee5\u5185\u306b\u5b8c\u4e86\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u30011\u3064\u306e\u30c8\u30fc\u30af\u30f3\u306f\u300c\u30c7\u30b6\u30fc\u30c8\u30e9\u30f3\u300d\u30b3\u30fc\u30b9\u306e\u5e83\u544a\u306e\u5f8c\u308d\u306b\u96a0\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u300c\u30b4\u30fc\u30b9\u30c8\u30e9\u30a4\u30c0\u30fc\u300d\u306f\u72ec\u7279\u306e\u708e\u306e\u8ecc\u8de1\u52b9\u679c\u3068\u9ad8\u3044\u6700\u9ad8\u901f\u5ea6\u3092\u7279\u5fb4\u3068\u3057\u3001\u9054\u6210\u611f\u3092\u6c42\u3081\u308b\u4eba\u3005\u306b\u4eba\u6c17\u304c\u3042\u308a\u307e\u3059\u3002\u307e\u308b\u3067\u5b9d\u63a2\u3057\u306e\u3088\u3046\u306b\u3001\u5fcd\u8010\u3068\u7c98\u308a\u5f37\u3055\u304c\u30ab\u30ae\u3068\u306a\u308a\u307e\u3059\u3002"}, {"question": "\u30af\u30ec\u30a4\u30b8\u30fc\u30e2\u30fc\u30bf\u30fc\u30b5\u30a4\u30af\u30eb\u3067\u3001\u30b2\u30fc\u30e0\u5185\u901a\u8ca8\u3092\u8fc5\u901f\u306b\u7372\u5f97\u3059\u308b\u6700\u826f\u306e\u65b9\u6cd5\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b2\u30fc\u30e0\u5185\u901a\u8ca8\u3092\u8fc5\u901f\u306b\u7372\u5f97\u3059\u308b\u306b\u306f\u3001\u6b21\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u7279\u5b9a\u306e\u30bf\u30b9\u30af\u3092\u5b8c\u4e86\u3059\u308b\u305f\u3081\u306e\u30dc\u30fc\u30ca\u30b9\u306e\u5831\u916c\u3092\u63d0\u4f9b\u3059\u308b\u3001\u30c7\u30a4\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u306b\u53c2\u52a0\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u3088\u308a\u77ed\u3044\u30b3\u30fc\u30b9\uff08\u4f8b\uff1a\u300c\u30b7\u30c6\u30a3\u30b9\u30c8\u30ea\u30fc\u30c8\u300d\uff09\u3092\u7e70\u308a\u8fd4\u3057\u30d7\u30ec\u30a4\u3057\u3066\u30011\u6642\u9593\u3042\u305f\u308a\u306e\u30ec\u30fc\u30b9\u5b8c\u4e86\u56de\u6570\u3092\u6700\u5927\u5316\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6bce\u30ec\u30fc\u30b9\u5f8c\u3001\u300c\u30e9\u30c3\u30ad\u30fc\u30db\u30a4\u30fc\u30eb\u300d\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u3001\u8ffd\u52a0\u306e\u901a\u8ca8\u3092\u7372\u5f97\u3059\u308b\u30c1\u30e3\u30f3\u30b9\u3092\u5f97\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30b7\u30c6\u30a3\u30b9\u30c8\u30ea\u30fc\u30c8\u300d\u30b3\u30fc\u30b9\u30921\u5206\u4ee5\u5185\u306b\u5b8c\u4e86\u3059\u308b\u3068\u3001500\u30b3\u30a4\u30f3\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u4f7f\u7528\u3057\u3066\u3001\u52b9\u7387\u3092\u6700\u5927\u9650\u306b\u9ad8\u3081\u3001\u30c0\u30a6\u30f3\u30bf\u30a4\u30e0\u3092\u6700\u5c0f\u9650\u306b\u3059\u308b\u305f\u3081\u306e\u8fb2\u4f5c\u696d\u30eb\u30fc\u30c8\u3092\u8a08\u753b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30af\u30ec\u30a4\u30b8\u30fc\u30e2\u30fc\u30bf\u30fc\u30b5\u30a4\u30af\u30eb\u306e\u30e9\u30f3\u30ad\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u30e9\u30f3\u30ad\u30f3\u30b0\u3092\u4e0a\u3052\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30af\u30ec\u30a4\u30b8\u30fc\u30e2\u30fc\u30bf\u30fc\u30b5\u30a4\u30af\u30eb\u306e\u30e9\u30f3\u30ad\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30ec\u30fc\u30b9\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3001\u4e00\u8cab\u6027\u3001\u5168\u4f53\u7684\u306a\u9032\u6357\u72b6\u6cc1\u306e\u7d44\u307f\u5408\u308f\u305b\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u30e9\u30f3\u30ad\u30f3\u30b0\u3092\u4e0a\u3052\u308b\u306b\u306f\u3001\u6b21\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30ec\u30fc\u30b9\u3067\u4e0a\u4f4d3\u4f4d\u4ee5\u5185\u306b\u5165\u8cde\u3059\u308b\u3053\u3068\u3067\u3001\u6700\u5927\u9650\u306e\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5404\u30ec\u30fc\u30b9\u3067\u30b9\u30bf\u30f3\u30c8\u306e\u5b9f\u884c\u3084\u885d\u7a81\u56de\u907f\u306a\u3069\u3001\u3059\u3079\u3066\u306e\u30dc\u30fc\u30ca\u30b9\u76ee\u6a19\u3092\u5b8c\u4e86\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u8ffd\u52a0\u306e\u30e9\u30f3\u30ad\u30f3\u30b0\u30dd\u30a4\u30f3\u30c8\u3092\u63d0\u4f9b\u3059\u308b\u3001\u5b63\u7bc0\u30a4\u30d9\u30f3\u30c8\u306b\u53c2\u52a0\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30b5\u30de\u30fc\u30d6\u30ea\u30fc\u30ba\u300d\u30a4\u30d9\u30f3\u30c8\u3067\u512a\u52dd\u3059\u308b\u3068\u3001\u30e9\u30f3\u30ad\u30f3\u30b0\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002\u6bd4\u8f03\u8868\u3092\u4f7f\u7528\u3057\u3066\u3001\u30c8\u30c3\u30d7\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u306e\u9032\u6357\u72b6\u6cc1\u3092\u8ffd\u8de1\u3057\u3001\u6539\u5584\u3059\u3079\u304d\u70b9\u3092\u7279\u5b9a\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "PC\u3067\u30af\u30ec\u30a4\u30b8\u30fc\u30e2\u30fc\u30bf\u30fc\u30b5\u30a4\u30af\u30eb\u3092\u5b9f\u884c\u3059\u308b\u305f\u3081\u306e\u30b7\u30b9\u30c6\u30e0\u8981\u4ef6\u306f\u4f55\u3067\u3059\u304b\u3002\u30e2\u30d0\u30a4\u30eb\u7248\u3068\u6bd4\u8f03\u3057\u3066\u3069\u3046\u3067\u3059\u304b\uff1f", "answer": "PC\u7248\u306e\u30af\u30ec\u30a4\u30b8\u30fc\u30e2\u30fc\u30bf\u30fc\u30b5\u30a4\u30af\u30eb\u306f\u3001\u5c11\u306a\u304f\u3068\u3082Intel i5\u30d7\u30ed\u30bb\u30c3\u30b5\u30018GB RAM\u30012GB VRAM\u306e\u5c02\u7528GPU\u304c\u5fc5\u8981\u3067\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u7248\u3068\u6bd4\u8f03\u3057\u3066\u3001PC\u7248\u306f\u9ad8\u89e3\u50cf\u5ea6\u306e\u30c6\u30af\u30b9\u30c1\u30e3\u3001\u3088\u308a\u30b9\u30e0\u30fc\u30ba\u306a\u30d5\u30ec\u30fc\u30e0\u30ec\u30fc\u30c8\u3001\u30ad\u30fc\u30dc\u30fc\u30c9\u307e\u305f\u306f\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u5165\u529b\u306e\u30b5\u30dd\u30fc\u30c8\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30df\u30c9\u30eb\u30ec\u30f3\u30b8PC\u3067\u306f\u3001\u30b2\u30fc\u30e0\u306f\u300c\u30a6\u30eb\u30c8\u30e9\u300d\u8a2d\u5b9a\u306760FPS\u3067\u52d5\u4f5c\u3057\u307e\u3059\u304c\u3001\u30cf\u30a4\u30a8\u30f3\u30c9\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u3067\u306f\u300c\u30cf\u30a4\u300d\u8a2d\u5b9a\u3067\u6700\u592730FPS\u3068\u306a\u308a\u307e\u3059\u3002\u8a2d\u5b9a\u8868\u3092\u4f7f\u7528\u3057\u3066\u3001\u3055\u307e\u3056\u307e\u306a\u30c7\u30d0\u30a4\u30b9\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6bd4\u8f03\u3057\u3001\u30cf\u30fc\u30c9\u30a6\u30a7\u30a2\u306b\u6700\u9069\u306a\u8a2d\u5b9a\u3092\u6c7a\u5b9a\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30e2\u30d0\u30a4\u30eb\u7248\u306e\u30af\u30ec\u30a4\u30b8\u30fc\u30e2\u30fc\u30bf\u30fc\u30b5\u30a4\u30af\u30eb\u306e\u9032\u6357\u72b6\u6cc1\u3092PC\u7248\u306b\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u9032\u6357\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u306b\u3042\u308b\u300c\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u300d\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u3001\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u304b\u3089\u9032\u6357\u72b6\u6cc1\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1aPC\u7248\u30b2\u30fc\u30e0\u3067\u4fdd\u5b58\u30d5\u30a1\u30a4\u30eb\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30e2\u30d0\u30a4\u30eb\u7248\u3067\u300c\u30cd\u30aa\u30f3\u30e9\u30a4\u30c0\u30fc\u300d\u30d0\u30a4\u30af\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u3066\u3044\u305f\u5834\u5408\u3001\u8ee2\u9001\u5f8c\u3001PC\u7248\u306e\u30ac\u30ec\u30fc\u30b8\u306b\u8868\u793a\u3055\u308c\u307e\u3059\u3002\u65b0\u3057\u3044\u5bb6\u306b\u8377\u7269\u3092\u79fb\u52d5\u3059\u308b\u306e\u3068\u540c\u3058\u3088\u3046\u306b\u3001\u624b\u9806\u306b\u5f93\u3048\u3070\u3001\u3059\u3079\u3066\u6b63\u78ba\u306b\u4fdd\u6301\u3055\u308c\u307e\u3059\u3002"}, {"question": "\u30af\u30ec\u30a4\u30b8\u30fc\u30e2\u30fc\u30bf\u30fc\u30b5\u30a4\u30af\u30eb\u3067\u30b9\u30bf\u30f3\u30c8\u3092\u5b9f\u884c\u3059\u308b\u6700\u3082\u52b9\u679c\u7684\u306a\u65b9\u6cd5\u306f\u4f55\u304b\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30af\u30ec\u30a4\u30b8\u30fc\u30e2\u30fc\u30bf\u30fc\u30b5\u30a4\u30af\u30eb\u3067\u30b9\u30bf\u30f3\u30c8\u3092\u5b9f\u884c\u3059\u308b\u306b\u306f\u3001\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u5236\u5fa1\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6700\u5927\u9650\u306e\u7a7a\u4e2d\u6642\u9593\u3092\u78ba\u4fdd\u3059\u308b\u305f\u3081\u306b\u3001\u9ad8\u901f\u3067\u30e9\u30f3\u30d7\u306b\u4e57\u308a\u8fbc\u307f\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u50be\u304d\u5236\u5fa1\u307e\u305f\u306f\u753b\u9762\u4e0a\u306e\u30dc\u30bf\u30f3\u3092\u4f7f\u7528\u3057\u3066\u3001\u30d5\u30ea\u30c3\u30d7\u3084\u30b9\u30d4\u30f3\u3092\u5b9f\u884c\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u901f\u5ea6\u3092\u5931\u3063\u305f\u308a\u3001\u30af\u30e9\u30c3\u30b7\u30e5\u3057\u305f\u308a\u3057\u306a\u3044\u3088\u3046\u306b\u3001\u30b9\u30e0\u30fc\u30ba\u306b\u7740\u5730\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30ad\u30e3\u30cb\u30aa\u30f3\u30b8\u30e3\u30f3\u30d7\u300d\u30b3\u30fc\u30b9\u3067\u306f\u3001\u30e1\u30a4\u30f3\u30e9\u30f3\u30d7\u306e\u4e0a\u3067\u30d0\u30c3\u30af\u30d5\u30ea\u30c3\u30d7\u3092\u5b9f\u884c\u3059\u308b\u3068\u3001\u8ffd\u52a0\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u30b9\u30bf\u30f3\u30c8\u306f\u3001\u30b9\u30bf\u30a4\u30eb\u30dd\u30a4\u30f3\u30c8\u3060\u3051\u3067\u306a\u304f\u3001\u30d6\u30fc\u30b9\u30c8\u30b2\u30fc\u30b8\u3092\u3088\u308a\u901f\u304f\u6e80\u305f\u3059\u52b9\u679c\u304c\u3042\u308a\u3001\u30ec\u30fc\u30b9\u3067\u6226\u7565\u7684\u306a\u512a\u4f4d\u6027\u3092\u4e0e\u3048\u3066\u304f\u308c\u307e\u3059\u3002\u3042\u306a\u305f\u306e\u30b9\u30bf\u30f3\u30c8\u3092\u8a08\u753b\u3059\u308b\u305f\u3081\u306e\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u4f7f\u7528\u3057\u3001\u5b8c\u74a7\u306b\u5b9f\u884c\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}]
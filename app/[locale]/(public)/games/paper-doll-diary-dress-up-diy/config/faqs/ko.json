[{"question": "\ud398\uc774\ud37c \u30c9\u30fc\u30eb \uc77c\uae30: \ub4dc\ub808\uc2a4 \uc5c5 DIY\uc758 \uae30\ubcf8 \ub9de\ucda4 \uc635\uc158\uc744 \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud398\uc774\ud37c \u30c9\u30fc\u30eb \uc77c\uae30: \ub4dc\ub808\uc2a4 \uc5c5 DIY\uc5d0\uc11c \uc778\ud615\uc744 \ub9de\ucda4 \uc124\uc815\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. \ub2e8\uacc4 1: \uc778\ud615 \uc544\uc774\ucf58\uc744 \ud0ed\ud558\uc5ec \ub9de\ucda4 \uc124\uc815 \uba54\ub274\ub97c \uc5fd\ub2c8\ub2e4. \ub2e8\uacc4 2: \ud5e4\uc5b4 \uc2a4\ud0c0\uc77c \ub610\ub294 \uc758\uc0c1\uacfc \uac19\uc774 \ub9de\ucda4 \uc124\uc815\ud560 \ubc94\uc8fc\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc0ac\uc6a9 \uac00\ub2a5\ud55c \uc635\uc158\uc5d0\uc11c \uc120\ud0dd\ud558\uc5ec \uc778\ud615\uc5d0 \uc801\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc758\uc0c1 \ubc94\uc8fc\uc5d0\uc11c '\uaf43\ubb34\ub2ac \ub4dc\ub808\uc2a4'\ub97c \uc120\ud0dd\ud558\uace0 '\ud3ec\ub2c8\ud14c\uc77c' \ud5e4\uc5b4 \uc2a4\ud0c0\uc77c\uacfc \ud398\uc5b4\ub9c1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc870\ud569\uc740 \uc778\ud615\uc5d0\uac8c \uc2e0\uc120\ud558\uace0 \ubd04 \ubd84\uc704\uae30\ub97c \uc5f0\ucd9c\ud560 \uac83\uc785\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc2e4\uc81c \uc637\uc73c\ub85c \uc885\uc774 \uc778\ud615\uc744 \uafb8\ubbf8\ub294 \uac83\uacfc \uac19\uc9c0\ub9cc, \ubb34\ud55c\ud55c \ub514\uc9c0\ud138 \uac00\ub2a5\uc131\uc744 \uc9c0\ub2cc \uac83\uc785\ub2c8\ub2e4.]"}, {"question": "\ud398\uc774\ud37c \u30c9\u30fc\u30eb \uc77c\uae30: \ub4dc\ub808\uc2a4 \uc5c5 DIY\uc5d0\uc11c \uc790\uc6d0\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud398\uc774\ud37c \u30c9\u30fc\u30eb \uc77c\uae30: \ub4dc\ub808\uc2a4 \uc5c5 DIY\uc5d0\uc11c \uc790\uc6d0\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \uac83\uc740 \uac8c\uc784 \ub0b4 \ud1b5\ud654\uac00 \ubd80\uc871\ud574\uc9c0\uc9c0 \uc54a\uace0 \ub354 \ub9ce\uc740 \ub9de\ucda4 \uc635\uc158\uc744 \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uae30 \ub54c\ubb38\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \ud6a8\uacfc\uc801\uc73c\ub85c \uc790\uc6d0\uc744 \uad00\ub9ac\ud558\ub824\uba74 \ub2e4\uc74c\uacfc \uac19\uc774 \ud558\uc138\uc694. \ub2e8\uacc4 1: \ub3d9\uc804\uacfc \ubcf4\uc11d\uc73c\ub85c \ubcf4\uc0c1\uc744 \ubc1b\ub294 \uc77c\uc77c \uc791\uc5c5\uacfc \ucc4c\ub9b0\uc9c0\ub97c \uc6b0\uc120 \uc21c\uc704\ub85c \ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ub2f9\uc7a5 \ud544\uc694\ud558\uc9c0 \uc54a\uc740 \ubb3c\ud488\uc5d0 \uc9c0\ucd9c\ud558\uc9c0 \ub9d0\uace0, \ud55c\uc815 \uae30\uac04 \uc0c1\ud488\uc744 \uc704\ud574 \uc800\ucd95\ud558\uc138\uc694. \ub2e8\uacc4 3: \ubcf4\ub108\uc2a4 \uc790\uc6d0\uc744 \uc81c\uacf5\ud558\ub294 \uc774\ubca4\ud2b8\uc5d0 \ucc38\uc5ec\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uc5ec\ub984 \ucd95\uc81c' \uc774\ubca4\ud2b8 \uae30\uac04 \ub3d9\uc548 \ud2b9\uc815 \uc791\uc5c5\uc744 \uc644\ub8cc\ud558\uba74 \ub3c5\uc810 \uc758\uc0c1\uc744 \uad6c\ub9e4\ud558\ub294 \ub370 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \ucd94\uac00 \ubcf4\uc11d\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131\ud45c: \uc77c\ubc18 \uc758\uc0c1: 100 \ub3d9\uc804 \ub300 \uc774\ubca4\ud2b8 \uc758\uc0c1: 50 \ubcf4\uc11d - \uc774\ubca4\ud2b8\ub97c \uc704\ud574 \uc800\ucd95\ud558\ub294 \uac00\uce58\ub97c \uac15\uc870\ud569\ub2c8\ub2e4.]"}, {"question": "\ud398\uc774\ud37c \u30c9\u30fc\u30eb \uc77c\uae30: \ub4dc\ub808\uc2a4 \uc5c5 DIY\uc758 \ubb34\ub8cc \ubc0f \ud504\ub9ac\ubbf8\uc5c4 \ub9de\ucda4 \uc635\uc158\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud398\uc774\ud37c \u30c9\u30fc\u30eb \uc77c\uae30: \ub4dc\ub808\uc2a4 \uc5c5 DIY\uc5d0\uc11c \ubb34\ub8cc \ub9de\ucda4 \uc635\uc158\uc740 \ubaa8\ub4e0 \ud50c\ub808\uc774\uc5b4\uac00 \uc811\uadfc\ud560 \uc218 \uc788\uc73c\uba70, \ub2e8\uc21c\ud55c \ub4dc\ub808\uc2a4\uc640 \ud5e4\uc5b4\uc2a4\ud0c0\uc77c\uacfc \uac19\uc740 \uae30\ubcf8 \uc544\uc774\ud15c\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \ubc18\uba74 \ud504\ub9ac\ubbf8\uc5c4 \uc635\uc158\uc740 \uc138\ubd80\uc801\uc778 \uc800\ub141 \ub4dc\ub808\uc2a4\ub098 \ub3c5\ud2b9\ud55c \ud5e4\uc5b4 \uc561\uc138\uc11c\ub9ac\uc640 \uac19\uc774 \ub354 \uc138\ub828\ub418\uace0 \ub3c5\uc810\uc801\uc778 \ub514\uc790\uc778\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc6b0\uc544\ud55c \uc800\ub141 \ub4dc\ub808\uc2a4'\ub294 \ubb34\ub8cc \ubc94\uc8fc\uc5d0\uc11c\ub294 \uc0ac\uc6a9\ud560 \uc218 \uc5c6\ub294, \uc815\uad50\ud55c \ube44\uc988 \uc7a5\uc2dd\uacfc \ud750\ub974\ub294 \uc2e4\ub8e8\uc5e3\uc744 \ud2b9\uc9d5\uc9d3\ub294 \ud504\ub9ac\ubbf8\uc5c4 \uc544\uc774\ud15c\uc785\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc635\uc158 \ube44\uad50: \ubb34\ub8cc \uc635\uc158: '\uce90\uc8fc\uc5bc \ub4dc\ub808\uc2a4' \ub300 \ud504\ub9ac\ubbf8\uc5c4 \uc635\uc158: '\uc6b0\uc544\ud55c \uc800\ub141 \ub4dc\ub808\uc2a4' - \ud504\ub9ac\ubbf8\uc5c4 \uc544\uc774\ud15c\uc758 \ucd94\uac00 \uc138\ubd80 \uc0ac\ud56d\uacfc \ub3c5\uc810\uc131\uc744 \uac15\uc870\ud569\ub2c8\ub2e4.]"}, {"question": "\ud398\uc774\ud37c \u30c9\u30fc\u30eb \uc77c\uae30: \ub4dc\ub808\uc2a4 \uc5c5 DIY\uc5d0\uc11c \ud2b9\uc815 \ud14c\ub9c8\ub098 \uc774\ubca4\ud2b8\uc5d0 \ub9de\ucdb0 \uc778\ud615\uc758 \ubaa8\uc2b5\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud398\uc774\ud37c \u30c9\u30fc\u30eb \uc77c\uae30: \ub4dc\ub808\uc2a4 \uc5c5 DIY\uc5d0\uc11c \ud2b9\uc815 \ud14c\ub9c8\ub098 \uc774\ubca4\ud2b8\uc5d0 \ub9de\ucdb0 \uc778\ud615\uc758 \ubaa8\uc2b5\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc804\ub7b5\uc801\uc778 \uacc4\ud68d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc774\ubca4\ud2b8\uc758 \ud14c\ub9c8\ub098 \uc694\uad6c \uc0ac\ud56d\uc744 \ubbf8\ub9ac \uc870\uc0ac\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ud734\uc77c \uc774\ubca4\ud2b8\uc640 \uac19\uc774 \ud14c\ub9c8\uc640 \uad00\ub828\ub41c \uc544\uc774\ud15c\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc804\uccb4\uc801\uc778 \uc678\ubaa8\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\uae30 \uc704\ud574 \uc801\uc808\ud558\uac8c \uc561\uc138\uc11c\ub9ac\ub97c \ucd94\uac00\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uaca8\uc6b8 \ub3d9\ud654' \uc774\ubca4\ud2b8 \uae30\uac04 \ub3d9\uc548 '\ub208\uc1a1\uc774 \ub4dc\ub808\uc2a4'\ub97c \uc120\ud0dd\ud558\uace0 '\uc5bc\uc74c \uc7a5\ud654'\uc640 '\uc740\uc0c9 \ud2f0\uc544\ub77c'\ub97c \ud398\uc5b4\ub9c1\ud558\uba74 \ud1b5\uc77c\uc801\uc774\uace0 \ud14c\ub9c8\uc5d0 \ub9de\ub294 \ubaa8\uc2b5\uc744 \uc5f0\ucd9c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \ud14c\ub9c8 \uc870\uc0ac \u2192 \uc544\uc774\ud15c \uc120\ud0dd \u2192 \uc561\uc138\uc11c\ub9ac \ucd94\uac00 \u2192 \ucd5c\uc885 \ubaa8\uc2b5, \ub2e8\uacc4\ubcc4 \uacfc\uc815\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4.]"}, {"question": "\ud398\uc774\ud37c \u30c9\u30fc\u30eb \uc77c\uae30: \ub4dc\ub808\uc2a4 \uc5c5 DIY\uc5d0\uc11c \ud76c\uadc0 \uc544\uc774\ud15c\uc744 \ud68d\ub4dd\ud558\uae30 \uc704\ud574 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \uace0\uae09 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud398\uc774\ud37c \u30c9\u30fc\u30eb \uc77c\uae30: \ub4dc\ub808\uc2a4 \uc5c5 DIY\uc5d0\uc11c \ud76c\uadc0 \uc544\uc774\ud15c\uc744 \ud68d\ub4dd\ud558\ub824\uba74 \uc9c0\uc18d\uc131\uacfc \uc804\ub7b5\uc758 \uc870\ud569\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \uac8c\uc784 \ub0b4 \uc0c1\uc810\uc5d0\uc11c \ud55c\uc815 \uae30\uac04 \uc0c1\ud488 \ubc0f \ud2b9\ubcc4 \ud560\uc778\uc744 \uc815\uae30\uc801\uc73c\ub85c \ud655\uc778\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ud76c\uadc0 \uc544\uc774\ud15c\uc5d0 \ub300\ud55c \ubcf4\uc0c1\uc744 \uc8fc\ub294 \uace0\uae09 \ucc4c\ub9b0\uc9c0\uc640 \uc131\ucde8\ub3c4\ub97c \uc644\ub8cc\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ucee4\ubba4\ub2c8\ud2f0 \uc774\ubca4\ud2b8 \ubc0f \ud611\uc5c5\uc5d0 \ucc38\uc5ec\ud558\uba74 \uc885\uc885 \ub3c5\uc810 \uc544\uc774\ud15c\uc774 \ub4f1\uc7a5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uae08\uc0c9 \uae43\ud138 \ud5e4\ub4dc\ub4dc\ub808\uc2a4'\ub294 \ud2b9\ubcc4\ud55c \ucee4\ubba4\ub2c8\ud2f0 \uc774\ubca4\ud2b8 \uae30\uac04 \ub3d9\uc548\ub9cc \uc774\uc6a9 \uac00\ub2a5\ud588\ub358 \ud76c\uadc0 \uc544\uc774\ud15c\uc774\uc5c8\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ubcf4\ubb3c\uc744 \ucc3e\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc778\ub0b4\uc640 \ub178\ub825\uc774 \ud76c\uadc0\ud55c \ubcf4\uc11d\uc744 \ubc1c\uacac\ud558\ub294 \ub370 \uc774\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ud398\uc774\ud37c \u30c9\u30fc\u30eb \uc77c\uae30: \ub4dc\ub808\uc2a4 \uc5c5 DIY\uc758 \uac8c\uc784 \ub0b4 \uacbd\uc81c\ub294 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \ub3d9\uc804\uacfc \ubcf4\uc11d\uc744 \uc5bb\ub294 \ucd5c\uc0c1\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud398\uc774\ud37c \u30c9\u30fc\u30eb \uc77c\uae30: \ub4dc\ub808\uc2a4 \uc5c5 DIY\uc758 \uac8c\uc784 \ub0b4 \uacbd\uc81c\ub294 \uc8fc\uc694 \ud1b5\ud654\uc778 \ub3d9\uc804\uacfc \ubcf4\uc11d\uc744 \uc911\uc2ec\uc73c\ub85c \ub3cc\uc544\uac11\ub2c8\ub2e4. \ub3d9\uc804\uc740 \uc77c\uc77c \uc791\uc5c5, \ucc4c\ub9b0\uc9c0 \uc644\ub8cc \ubc0f \uc6d0\ud558\uc9c0 \uc54a\ub294 \uc544\uc774\ud15c \ud310\ub9e4\ub97c \ud1b5\ud574 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubcf4\uc11d\uc740 \ud76c\uadc0\ud558\uace0 \ud2b9\ubcc4\ud55c \uc774\ubca4\ud2b8, \uc131\ucde8\ub3c4 \ubc0f \uac00\ub054 \uac8c\uc784 \ub0b4 \uad6c\ub9e4\ub97c \ud1b5\ud574 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc77c\uc77c \ub4dc\ub808\uc2a4 \uc5c5 \ucc4c\ub9b0\uc9c0'\ub97c \uc644\ub8cc\ud558\uba74 50\uac1c\uc758 \ub3d9\uc804\uc744 \ubc1b\uc744 \uc218 \uc788\uc73c\uba70, '\uc6d4\uac04 \ud328\uc158\uc1fc'\uc5d0 \ucc38\uc5ec\ud558\uba74 10\uac1c\uc758 \ubcf4\uc11d\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131\ud45c: \ub3d9\uc804 \ucd9c\ucc98: \uc77c\uc77c \uc791\uc5c5(50 \ub3d9\uc804), \ucc4c\ub9b0\uc9c0(100 \ub3d9\uc804), \ubcf4\uc11d \ucd9c\ucc98: \uc774\ubca4\ud2b8(10\uac1c \ubcf4\uc11d), \uc131\ucde8\ub3c4(5\uac1c \ubcf4\uc11d) - \uc11c\ub85c \ub2e4\ub978 \ud68d\ub4dd \uc7a0\uc7ac\ub825\uc744 \uac15\uc870\ud569\ub2c8\ub2e4.]"}, {"question": "\ud398\uc774\ud37c \u30c9\u30fc\u30eb \uc77c\uae30: \ub4dc\ub808\uc2a4 \uc5c5 DIY\uc758 '\uc2a4\ud0c0\uc77c \uc810\uc218' \uc2dc\uc2a4\ud15c\uc758 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc774\uba70, \uc810\uc218\ub97c \uadf9\ub300\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud398\uc774\ud37c \u30c9\u30fc\u30eb \uc77c\uae30: \ub4dc\ub808\uc2a4 \uc5c5 DIY\uc758 '\uc2a4\ud0c0\uc77c \uc810\uc218' \uc2dc\uc2a4\ud15c\uc740 \uc778\ud615\uc758 \ubaa8\uc2b5\uc744 \uc77c\uad00\uc131, \ucc3d\uc758\uc131 \ubc0f \ud14c\ub9c8 \uc900\uc218\ub97c \uae30\uc900\uc73c\ub85c \ud3c9\uac00\ud569\ub2c8\ub2e4. \uc810\uc218\ub97c \uadf9\ub300\ud654\ud558\ub824\uba74 \ub2e4\uc74c\uacfc \uac19\uc774 \ud558\uc138\uc694. \ub2e8\uacc4 1: \uc120\ud0dd\ud55c \ubaa8\ub4e0 \uc544\uc774\ud15c\uc774 \uc0c9\uc0c1\uacfc \uc2a4\ud0c0\uc77c\uc5d0\uc11c \uc11c\ub85c \ubcf4\uc644\ub418\ub3c4\ub85d \ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ub208\uc5d0 \ub744\ub294 \ub3c5\ud2b9\ud55c \uc561\uc138\uc11c\ub9ac \ub610\ub294 \uc138\ubd80 \uc815\ubcf4\ub97c \ucd94\uac00\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ubcf4\ub108\uc2a4 \uc810\uc218\ub97c \uc5bb\uae30 \uc704\ud574 \ud14c\ub9c8\ub97c \uc5c4\uaca9\ud558\uac8c \uc900\uc218\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub808\ud2b8\ub85c \uba4b\uc7c1\uc774' \ud14c\ub9c8\uc5d0\uc11c '\ud3f4\uce74 \ub3c4\ud2b8 \ub4dc\ub808\uc2a4'\ub97c '\ucea3\uc544\uc774 \uc120\uae00\ub77c\uc2a4'\uc640 '\ube48\ud2f0\uc9c0 \ud578\ub4dc\ubc31'\uacfc \ud568\uaed8 \uc0ac\uc6a9\ud558\uba74 \uc2a4\ud0c0\uc77c \uc810\uc218\uac00 \ud06c\uac8c \ub192\uc544\uc9d1\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc635\uc158 \ube44\uad50: \uae30\ubcf8 \uc758\uc0c1: 50 \uc2a4\ud0c0\uc77c \uc810\uc218 vs. \ud14c\ub9c8 \uc758\uc0c1: 100 \uc2a4\ud0c0\uc77c \uc810\uc218 - \ud14c\ub9c8 \uc900\uc218\uc758 \uc601\ud5a5\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4.]"}, {"question": "\ub2e4\ub978 \uae30\uae30\uc5d0 \ud398\uc774\ud37c \u30c9\u30fc\u30eb \uc77c\uae30: \ub4dc\ub808\uc2a4 \uc5c5 DIY \ub370\uc774\ud130\ub97c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc783\uc9c0 \uc54a\uace0 \uc804\uc1a1\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub2e4\ub978 \uae30\uae30\uc5d0 \ud398\uc774\ud37c \u30c9\u30fc\u30eb \uc77c\uae30: \ub4dc\ub808\uc2a4 \uc5c5 DIY \ub370\uc774\ud130\ub97c \uc804\uc1a1\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \uc783\uc9c0 \uc54a\uc73c\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. \ub2e8\uacc4 1: \ub450 \uae30\uae30 \ubaa8\ub450(\uc608: Google Play \ub610\ub294 Apple ID)\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uac8c\uc784 \ub0b4 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud604\uc7ac \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5c5\ub85c\ub4dc\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc0c8 \uae30\uae30\uc5d0\uc11c \ub85c\uadf8\uc778\ud558\uace0 \uc800\uc7a5\ub41c \ub370\uc774\ud130\ub97c \ub2e4\uc6b4\ub85c\ub4dc\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, Android \ud734\ub300\ud3f0\uc5d0\uc11c iPad\ub85c \uc774\ub3d9\ud558\ub294 \uacbd\uc6b0 Google \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uace0 \ub370\uc774\ud130\ub97c \ub3d9\uae30\ud654\ud558\uba74 \ubaa8\ub4e0 \ub9de\ucda4 \uc124\uc815 \ubc0f \uc9c4\ud589 \uc0c1\ud669\uc774 \ubcf4\uc874\ub429\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \ub85c\uadf8\uc778 \u2192 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \u2192 \ub2e4\uc6b4\ub85c\ub4dc \u2192 \uc9c4\ud589 \uc0c1\ud669 \ub3d9\uae30\ud654, \uc6d0\ud65c\ud55c \uc804\uc1a1 \uacfc\uc815\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4.]"}, {"question": "\ud398\uc774\ud37c \u30c9\u30fc\u30eb \uc77c\uae30: \ub4dc\ub808\uc2a4 \uc5c5 DIY\uc5d0\uc11c \uc5b4\ub5a4 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \uc8fc\uc758\ud574\uc57c \ud558\ub098\uc694?", "answer": "\ud398\uc774\ud37c \u30c9\u30fc\u30eb \uc77c\uae30: \ub4dc\ub808\uc2a4 \uc5c5 DIY\uc5d0\ub294 \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uac00\ub4dd\ud569\ub2c8\ub2e4. \ub208\uc5ec\uaca8\ubcfc \ub9cc\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 '\ube44\ubc00 \uc815\uc6d0' \ud14c\ub9c8\uc785\ub2c8\ub2e4. '\uaf43\ubb34\ub2ac \uc655\uad00'\uacfc '\ud30c\uc2a4\ud154 \ub4dc\ub808\uc2a4'\ub85c \uc778\ud615\uc744 \ub9de\ucda4 \uc124\uc815\ud558\ub294 \ub4f1 \ud2b9\uc815 \uc791\uc5c5\uc744 \uc644\ub8cc\ud558\uba74 \ud574\uae08\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud574\uae08\ub418\uba74 \ub3c5\uc810\uc801\uc778 \uc815\uc6d0 \ud14c\ub9c8 \uc544\uc774\ud15c\uacfc \ubc30\uacbd\uc744 \uc774\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uae30\ub2a5\uc744 \ucc3e\ub294 \uac83\uc740 \uc800\ud0dd\uc5d0\uc11c \ube44\ubc00 \ubc29\uc744 \ubc1c\uacac\ud558\ub294 \uac83\uacfc \uac19\uc73c\uba70, \uac8c\uc784\uc5d0 \ucd94\uac00\uc801\uc778 \ud765\ubd84\uc744 \ub354\ud569\ub2c8\ub2e4.]"}, {"question": "\ud398\uc774\ud37c \u30c9\u30fc\u30eb \uc77c\uae30: \ub4dc\ub808\uc2a4 \uc5c5 DIY\uc5d0\uc11c \ucee4\ubba4\ub2c8\ud2f0\uc5d0 \ud638\uc18c\ud558\ub294 \ub208\uc5d0 \ub744\ub294 \uc778\ud615 \ub514\uc790\uc778\uc744 \ub9cc\ub4dc\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud398\uc774\ud37c \u30c9\u30fc\u30eb \uc77c\uae30: \ub4dc\ub808\uc2a4 \uc5c5 DIY\uc5d0\uc11c \ub208\uc5d0 \ub744\ub294 \uc778\ud615 \ub514\uc790\uc778\uc744 \ub9cc\ub4dc\ub294 \ub370\ub294 \ucc3d\uc758\uc131\uacfc \ucee4\ubba4\ub2c8\ud2f0 \uc778\uc2dd\uc758 \uc870\ud569\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \ucee4\ubba4\ub2c8\ud2f0 \ub0b4 \uc720\ud589\ud558\ub294 \ud14c\ub9c8\uc640 \uc778\uae30 \uc2a4\ud0c0\uc77c\uc744 \ucd5c\uc2e0 \uc815\ubcf4\ub85c \uc720\uc9c0\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ub110\ub9ac \uc0ac\uc6a9\ub418\uc9c0 \uc54a\uc740 \ub3c5\ud2b9\ud55c \uc870\ud569\uc744 \uc2dc\ub3c4\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ub514\uc790\uc778\uc744 \uc18c\uc15c \ubbf8\ub514\uc5b4 \ub610\ub294 \uac8c\uc784 \ub0b4 \ud3ec\ub7fc\uc5d0 \uacf5\uc720\ud558\uc5ec \ud53c\ub4dc\ubc31\uacfc \uc601\uac10\uc744 \uc5bb\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub124\uc628 \uc7ac\ud0b7'\uc744 '\ud640\ub85c\uadf8\ub7a8 \uc2a4\ucee4\ud2b8'\uc640 'LED \uc6b4\ub3d9\ud654'\uc640 \uacb0\ud569\ud558\uba74 \ucee4\ubba4\ub2c8\ud2f0\uc758 \ub208\uae38\uc744 \uc0ac\ub85c\uc7a1\ub294 \ubbf8\ub798\uc801\uc778 \ubaa8\uc2b5\uc744 \uc5f0\ucd9c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc635\uc158 \ube44\uad50: \uc77c\ubc18 \uc758\uc0c1: '\ud074\ub798\uc2dd \ub4dc\ub808\uc2a4' \ub300 \ub3c5\ud2b9\ud55c \uc758\uc0c1: '\ub124\uc628 \uc7ac\ud0b7 & \ud640\ub85c\uadf8\ub7a8 \uc2a4\ucee4\ud2b8' - \ub3c5\ucc3d\uc131\uc758 \uc601\ud5a5\uc744 \uac15\uc870\ud569\ub2c8\ub2e4.]"}]
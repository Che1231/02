[{"question": "\u5982\u4f55\u5728\u7d19\u5a03\u5a03\u65e5\u8a18\uff1a\u63db\u88ddDIY\u4e2d\u958b\u59cb\u4f7f\u7528\u57fa\u672c\u5ba2\u88fd\u5316\u9078\u9805\uff1f", "answer": "\u8981\u5728\u7d19\u5a03\u5a03\u65e5\u8a18\uff1a\u63db\u88ddDIY\u4e2d\u958b\u59cb\u5ba2\u88fd\u5316\u60a8\u7684\u7d19\u5a03\u5a03\uff0c\u8acb\u9075\u5faa\u9019\u4e9b\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u9ede\u64ca\u7d19\u5a03\u5a03\u5716\u793a\u6253\u958b\u5ba2\u88fd\u5316\u9078\u55ae\u3002\u6b65\u9a5f2\uff1a\u9078\u64c7\u8981\u5ba2\u88fd\u5316\u7684\u985e\u5225\uff0c\u4f8b\u5982\u9aee\u578b\u6216\u670d\u88dd\u3002\u6b65\u9a5f3\uff1a\u5f9e\u53ef\u7528\u7684\u9078\u9805\u4e2d\u9078\u64c7\u4e26\u61c9\u7528\u65bc\u60a8\u7684\u7d19\u5a03\u5a03\u3002\u4f8b\u5982\uff0c\u60a8\u53ef\u4ee5\u5f9e\u670d\u88dd\u985e\u5225\u4e2d\u9078\u64c7\u300c\u82b1\u5349\u9023\u8863\u88d9\u300d\uff0c\u4e26\u642d\u914d\u300c\u96d9\u99ac\u5c3e\u300d\u9aee\u578b\u3002\u9019\u6a23\u7684\u7d44\u5408\u6703\u8b93\u60a8\u7684\u7d19\u5a03\u5a03\u5c55\u73fe\u51fa\u6e05\u65b0\u6625\u65e5\u98a8\u91c7\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4e00\u4e0b\uff0c\u5c31\u50cf\u7528\u771f\u8863\u670d\u6253\u626e\u7d19\u5a03\u5a03\uff0c\u4f46\u64c1\u6709\u7121\u76e1\u7684\u6578\u4f4d\u53ef\u80fd\u6027\u3002]"}, {"question": "\u5728\u7d19\u5a03\u5a03\u65e5\u8a18\uff1a\u63db\u88ddDIY\u4e2d\uff0c\u70ba\u4ec0\u9ebc\u6709\u6548\u7ba1\u7406\u8cc7\u6e90\u5f88\u91cd\u8981\uff1f\u6211\u8a72\u5982\u4f55\u505a\uff1f", "answer": "\u5728\u7d19\u5a03\u5a03\u65e5\u8a18\uff1a\u63db\u88ddDIY\u4e2d\u6709\u6548\u7ba1\u7406\u8cc7\u6e90\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u80fd\u8b93\u60a8\u89e3\u9396\u66f4\u591a\u5ba2\u88fd\u5316\u9078\u9805\uff0c\u800c\u4e0d\u6703\u8017\u76e1\u904a\u6232\u5167\u8ca8\u5e63\u3002\u8981\u6709\u6548\u7ba1\u7406\u8cc7\u6e90\uff1a\u6b65\u9a5f1\uff1a\u512a\u5148\u8655\u7406\u80fd\u7372\u5f97\u91d1\u5e63\u548c\u5bf6\u77f3\u7684\u6bcf\u65e5\u4efb\u52d9\u548c\u6311\u6230\u3002\u6b65\u9a5f2\uff1a\u907f\u514d\u82b1\u8cbb\u60a8\u76ee\u524d\u4e0d\u9700\u8981\u7684\u7269\u54c1\uff1b\u76f8\u53cd\u5730\uff0c\u8acb\u70ba\u9650\u6642\u512a\u60e0\u5132\u5099\u8cc7\u6e90\u3002\u6b65\u9a5f3\uff1a\u53c3\u8207\u63d0\u4f9b\u984d\u5916\u8cc7\u6e90\u7684\u6d3b\u52d5\u3002\u4f8b\u5982\uff0c\u5728\u300c\u590f\u5b63\u7bc0\u6176\u300d\u6d3b\u52d5\u671f\u9593\uff0c\u5b8c\u6210\u7279\u5b9a\u4efb\u52d9\u53ef\u4ee5\u7372\u5f97\u984d\u5916\u5bf6\u77f3\uff0c\u7528\u65bc\u8cfc\u8cb7\u7368\u5bb6\u670d\u88dd\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u666e\u901a\u670d\u88dd\uff1a100 \u91d1\u5e63\uff0c\u8207\u6d3b\u52d5\u670d\u88dd\uff1a50 \u5bf6\u77f3\uff0c\u7a81\u986f\u5132\u84c4\u4ee5\u53c3\u8207\u6d3b\u52d5\u6240\u7372\u5f97\u7684\u50f9\u503c\u3002]"}, {"question": "\u5728\u7d19\u5a03\u5a03\u65e5\u8a18\uff1a\u63db\u88ddDIY\u4e2d\uff0c\u514d\u8cbb\u548c\u9ad8\u7d1a\u5ba2\u88fd\u5316\u9078\u9805\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "\u5728\u7d19\u5a03\u5a03\u65e5\u8a18\uff1a\u63db\u88ddDIY\u4e2d\uff0c\u6240\u6709\u73a9\u5bb6\u90fd\u80fd\u4f7f\u7528\u514d\u8cbb\u5ba2\u88fd\u5316\u9078\u9805\uff0c\u5305\u62ec\u7c21\u55ae\u7684\u9023\u8863\u88d9\u548c\u9aee\u578b\u7b49\u57fa\u672c\u7269\u54c1\u3002\u7136\u800c\uff0c\u9ad8\u7d1a\u9078\u9805\u5247\u63d0\u4f9b\u66f4\u7cbe\u7dfb\u4e14\u7368\u5bb6\u8a2d\u8a08\uff0c\u4f8b\u5982\u8a73\u7d30\u7684\u665a\u79ae\u670d\u6216\u7368\u7279\u7684\u9aee\u98fe\u3002\u4f8b\u5982\uff0c\u300c\u512a\u96c5\u665a\u79ae\u670d\u300d\u662f\u9ad8\u7d1a\u7269\u54c1\uff0c\u5177\u6709\u7cbe\u7dfb\u7684\u73e0\u5bf6\u88dd\u98fe\u548c\u6d41\u52d5\u7684\u8f2a\u5ed3\uff0c\u5728\u514d\u8cbb\u985e\u5225\u4e2d\u4e0d\u53ef\u7528\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u514d\u8cbb\u9078\u9805\uff1a\u300c\u4f11\u9592\u9023\u8863\u88d9\u300d\uff0c\u9ad8\u7d1a\u9078\u9805\uff1a\u300c\u512a\u96c5\u665a\u79ae\u670d\u300d\uff0c\u5f37\u8abf\u9ad8\u7d1a\u7269\u54c1\u7684\u984d\u5916\u7d30\u7bc0\u548c\u7368\u7279\u6027\u3002]"}, {"question": "\u5982\u4f55\u5728\u7d19\u5a03\u5a03\u65e5\u8a18\uff1a\u63db\u88ddDIY\u4e2d\u70ba\u7279\u5b9a\u4e3b\u984c\u6216\u6d3b\u52d5\u512a\u5316\u7d19\u5a03\u5a03\u7684\u5916\u89c0\uff1f", "answer": "\u5728\u7d19\u5a03\u5a03\u65e5\u8a18\uff1a\u63db\u88ddDIY\u4e2d\u70ba\u7279\u5b9a\u4e3b\u984c\u6216\u6d3b\u52d5\u512a\u5316\u7d19\u5a03\u5a03\u7684\u5916\u89c0\u9700\u8981\u7b56\u7565\u898f\u5283\uff1a\u6b65\u9a5f1\uff1a\u4e8b\u5148\u7814\u7a76\u6d3b\u52d5\u4e3b\u984c\u6216\u8981\u6c42\u3002\u6b65\u9a5f2\uff1a\u9078\u64c7\u8207\u4e3b\u984c\u76f8\u7b26\u7684\u7269\u54c1\uff0c\u4f8b\u5982\u7bc0\u65e5\u6d3b\u52d5\u7684\u7bc0\u6176\u670d\u88dd\u3002\u6b65\u9a5f3\uff1a\u6070\u7576\u5730\u914d\u98fe\u4ee5\u63d0\u5347\u6574\u9ad4\u5916\u89c0\u3002\u4f8b\u5982\uff0c\u300c\u51ac\u65e5\u5947\u5883\u300d\u6d3b\u52d5\u671f\u9593\uff0c\u9078\u64c7\u300c\u96ea\u82b1\u9023\u8863\u88d9\u300d\uff0c\u4e26\u642d\u914d\u300c\u971c\u51cd\u9774\u5b50\u300d\u548c\u300c\u9280\u8272\u738b\u51a0\u300d\u53ef\u4ee5\u71df\u9020\u4e00\u81f4\u4e14\u4e3b\u984c\u9bae\u660e\u7684\u9020\u578b\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u4e3b\u984c\u7814\u7a76 \u2192 \u7269\u54c1\u9078\u64c7 \u2192 \u914d\u98fe \u2192 \u6700\u7d42\u9020\u578b\uff0c\u95e1\u660e\u9010\u6b65\u7684\u904e\u7a0b\u3002]"}, {"question": "\u5728\u7d19\u5a03\u5a03\u65e5\u8a18\uff1a\u63db\u88ddDIY\u4e2d\uff0c\u6211\u53ef\u4ee5\u4f7f\u7528\u54ea\u4e9b\u5148\u9032\u7b56\u7565\u4f86\u89e3\u9396\u7a00\u6709\u7269\u54c1\uff1f", "answer": "\u5728\u7d19\u5a03\u5a03\u65e5\u8a18\uff1a\u63db\u88ddDIY\u4e2d\u89e3\u9396\u7a00\u6709\u7269\u54c1\u9700\u8981\u6bc5\u529b\u548c\u7b56\u7565\u7684\u7d50\u5408\uff1a\u6b65\u9a5f1\uff1a\u5b9a\u671f\u67e5\u770b\u904a\u6232\u5546\u5e97\u7684\u9650\u6642\u512a\u60e0\u548c\u4fc3\u92b7\u3002\u6b65\u9a5f2\uff1a\u5b8c\u6210\u9ad8\u968e\u6311\u6230\u548c\u6210\u5c31\u4ee5\u7372\u5f97\u7a00\u6709\u7269\u54c1\u3002\u6b65\u9a5f3\uff1a\u53c3\u8207\u793e\u7fa4\u6d3b\u52d5\u548c\u5408\u4f5c\uff0c\u9019\u4e9b\u6d3b\u52d5\u901a\u5e38\u6703\u63d0\u4f9b\u7368\u5bb6\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u300c\u91d1\u7fbd\u982d\u98fe\u300d\u662f\u53ea\u6709\u5728\u7279\u6b8a\u793e\u7fa4\u6d3b\u52d5\u671f\u9593\u624d\u53ef\u7372\u5f97\u7684\u7a00\u6709\u7269\u54c1\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4e00\u4e0b\uff0c\u5c31\u50cf\u5c0b\u627e\u5bf6\u85cf\uff1b\u8010\u5fc3\u548c\u52aa\u529b\u53ef\u4ee5\u767c\u73fe\u7a00\u6709\u7684\u5bf6\u77f3\u3002]"}, {"question": "\u7d19\u5a03\u5a03\u65e5\u8a18\uff1a\u63db\u88ddDIY\u7684\u904a\u6232\u7d93\u6fdf\u6a5f\u5236\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f\u7372\u5f97\u91d1\u5e63\u548c\u5bf6\u77f3\u7684\u6700\u4f73\u65b9\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "\u7d19\u5a03\u5a03\u65e5\u8a18\uff1a\u63db\u88ddDIY \u7684\u904a\u6232\u7d93\u6fdf\u6a5f\u5236\u570d\u7e5e\u8457\u5169\u7a2e\u4e3b\u8981\u8ca8\u5e63\uff1a\u91d1\u5e63\u548c\u5bf6\u77f3\u3002\u91d1\u5e63\u53ef\u900f\u904e\u6bcf\u65e5\u4efb\u52d9\u3001\u5b8c\u6210\u6311\u6230\u548c\u51fa\u552e\u4e0d\u9700\u8981\u7684\u7269\u54c1\u7372\u5f97\u3002\u5bf6\u77f3\u8f03\u70ba\u7a00\u6709\uff0c\u53ef\u900f\u904e\u7279\u6b8a\u6d3b\u52d5\u3001\u6210\u5c31\u548c\u5076\u723e\u7684\u61c9\u7528\u5167\u8cfc\u8cb7\u7372\u5f97\u3002\u4f8b\u5982\uff0c\u5b8c\u6210\u300c\u6bcf\u65e5\u63db\u88dd\u6311\u6230\u300d\u53ef\u4ee5\u7372\u5f97 50 \u91d1\u5e63\uff0c\u53c3\u8207\u300c\u6bcf\u6708\u6642\u5c1a\u79c0\u300d\u53ef\u4ee5\u7372\u5f97 10 \u9846\u5bf6\u77f3\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u91d1\u5e63\u4f86\u6e90\uff1a\u6bcf\u65e5\u4efb\u52d9\uff0850 \u91d1\u5e63\uff09\uff0c\u6311\u6230\uff08100 \u91d1\u5e63\uff09\u8207\u5bf6\u77f3\u4f86\u6e90\uff1a\u6d3b\u52d5\uff0810 \u5bf6\u77f3\uff09\uff0c\u6210\u5c31\uff085 \u5bf6\u77f3\uff09\uff0c\u7a81\u986f\u4e0d\u540c\u7684\u8cfa\u53d6\u6f5b\u529b\u3002]"}, {"question": "\u7d19\u5a03\u5a03\u65e5\u8a18\uff1a\u63db\u88ddDIY\u4e2d\u7684\u300c\u98a8\u683c\u9ede\u6578\u300d\u7cfb\u7d71\u80cc\u5f8c\u7684\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f\u6211\u5982\u4f55\u6700\u5927\u5316\u6211\u7684\u5f97\u5206\uff1f", "answer": "\u7d19\u5a03\u5a03\u65e5\u8a18\uff1a\u63db\u88ddDIY\u4e2d\u7684\u300c\u98a8\u683c\u9ede\u6578\u300d\u7cfb\u7d71\u6839\u64da\u9020\u578b\u7684\u5354\u8abf\u6027\u3001\u5275\u610f\u6027\u548c\u5c0d\u4e3b\u984c\u7684\u9075\u5faa\u5ea6\u8a55\u4f30\u60a8\u7684\u7d19\u5a03\u5a03\u5916\u89c0\u3002\u8981\u6700\u5927\u5316\u60a8\u7684\u5f97\u5206\uff1a\u6b65\u9a5f1\uff1a\u78ba\u4fdd\u6240\u6709\u9078\u5b9a\u7684\u7269\u54c1\u5728\u984f\u8272\u548c\u98a8\u683c\u4e0a\u76f8\u4e92\u88dc\u5145\u3002\u6b65\u9a5f2\uff1a\u6dfb\u52a0\u7368\u7279\u7684\u914d\u98fe\u6216\u7d30\u7bc0\u4f86\u7a81\u51fa\u9020\u578b\u3002\u6b65\u9a5f3\uff1a\u4ed4\u7d30\u9075\u5faa\u4e3b\u984c\u4ee5\u7372\u5f97\u984d\u5916\u5206\u6578\u3002\u4f8b\u5982\uff0c\u5728\u300c\u5fa9\u53e4\u512a\u96c5\u300d\u4e3b\u984c\u4e2d\uff0c\u5c07\u300c\u5713\u9ede\u9023\u8863\u88d9\u300d\u8207\u300c\u8c93\u773c\u58a8\u93e1\u300d\u548c\u300c\u5fa9\u53e4\u624b\u888b\u300d\u642d\u914d\u53ef\u986f\u8457\u63d0\u5347\u60a8\u7684\u98a8\u683c\u9ede\u6578\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u57fa\u672c\u9020\u578b\uff1a50 \u98a8\u683c\u9ede\u6578\u8207\u4e3b\u984c\u9020\u578b\uff1a100 \u98a8\u683c\u9ede\u6578\uff0c\u5c55\u73fe\u4e3b\u984c\u9075\u5faa\u5ea6\u7684\u5f71\u97ff\u3002]"}, {"question": "\u5982\u4f55\u5728\u4e0d\u4e1f\u5931\u9032\u5ea6\u7684\u60c5\u6cc1\u4e0b\u5728\u4e0d\u540c\u7684\u88dd\u7f6e\u4e4b\u9593\u8f49\u79fb\u7d19\u5a03\u5a03\u65e5\u8a18\uff1a\u63db\u88ddDIY \u7684\u8cc7\u6599\uff1f", "answer": "\u8981\u5c07\u7d19\u5a03\u5a03\u65e5\u8a18\uff1a\u63db\u88ddDIY \u7684\u8cc7\u6599\u5728\u4e0d\u540c\u88dd\u7f6e\u4e4b\u9593\u8f49\u79fb\uff0c\u8acb\u9075\u5faa\u9019\u4e9b\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u78ba\u4fdd\u60a8\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\uff08\u4f8b\u5982\uff0cGoogle Play \u6216 Apple ID\uff09\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u904a\u6232\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u4e0a\u50b3\u60a8\u7684\u7576\u524d\u9032\u5ea6\u3002\u6b65\u9a5f3\uff1a\u5728\u65b0\u88dd\u7f6e\u4e0a\u767b\u5165\u4e26\u4e0b\u8f09\u5132\u5b58\u7684\u8cc7\u6599\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9e Android \u624b\u6a5f\u8f49\u79fb\u5230 iPad\uff0c\u767b\u5165\u60a8\u7684 Google \u5e33\u6236\u4e26\u540c\u6b65\u60a8\u7684\u8cc7\u6599\u5c07\u78ba\u4fdd\u6240\u6709\u5ba2\u88fd\u5316\u548c\u9032\u5ea6\u90fd\u5f97\u5230\u4fdd\u7559\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u767b\u5165 \u2192 \u96f2\u7aef\u5132\u5b58 \u2192 \u4e0b\u8f09 \u2192 \u9032\u5ea6\u540c\u6b65\uff0c\u95e1\u660e\u7121\u7e2b\u8f49\u79fb\u904e\u7a0b\u3002]"}, {"question": "\u5728\u7d19\u5a03\u5a03\u65e5\u8a18\uff1a\u63db\u88ddDIY\u4e2d\uff0c\u6211\u61c9\u8a72\u6ce8\u610f\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "\u7d19\u5a03\u5a03\u65e5\u8a18\uff1a\u63db\u88ddDIY\u5145\u6eff\u4e86\u96b1\u85cf\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u53ef\u4ee5\u63d0\u5347\u904a\u6232\u9ad4\u9a57\u3002\u4e00\u500b\u986f\u8457\u7684\u5f69\u86cb\u662f\u300c\u79d8\u5bc6\u82b1\u5712\u300d\u4e3b\u984c\uff0c\u5b83\u53ef\u4ee5\u900f\u904e\u5b8c\u6210\u4e00\u7cfb\u5217\u7279\u5b9a\u4efb\u52d9\u4f86\u89e3\u9396\uff0c\u4f8b\u5982\u4f7f\u7528\u300c\u82b1\u51a0\u300d\u548c\u300c\u7c89\u5f69\u9023\u8863\u88d9\u300d\u5ba2\u88fd\u5316\u60a8\u7684\u7d19\u5a03\u5a03\u3002\u89e3\u9396\u5f8c\uff0c\u60a8\u5c07\u7372\u5f97\u7368\u5bb6\u7684\u82b1\u5712\u4e3b\u984c\u7269\u54c1\u548c\u80cc\u666f\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u767c\u73fe\u9019\u4e9b\u96b1\u85cf\u529f\u80fd\u5c31\u50cf\u5728\u5225\u5885\u88e1\u627e\u5230\u79d8\u5bc6\u623f\u9593\uff0c\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u984d\u5916\u7684\u523a\u6fc0\u3002]"}, {"question": "\u5982\u4f55\u5728\u7d19\u5a03\u5a03\u65e5\u8a18\uff1a\u63db\u88ddDIY\u4e2d\u5275\u9020\u51fa\u5f15\u4eba\u6ce8\u76ee\u7684\u7d19\u5a03\u5a03\u8a2d\u8a08\uff0c\u4e26\u7372\u5f97\u793e\u7fa4\u95dc\u6ce8\uff1f", "answer": "\u5728\u7d19\u5a03\u5a03\u65e5\u8a18\uff1a\u63db\u88ddDIY\u4e2d\u5275\u9020\u51fa\u5f15\u4eba\u6ce8\u76ee\u7684\u7d19\u5a03\u5a03\u8a2d\u8a08\u9700\u8981\u7d50\u5408\u5275\u610f\u548c\u793e\u7fa4\u610f\u8b58\uff1a\u6b65\u9a5f1\uff1a\u95dc\u6ce8\u793e\u7fa4\u5167\u6d41\u884c\u7684\u4e3b\u984c\u548c\u6642\u5c1a\u98a8\u683c\u3002\u6b65\u9a5f2\uff1a\u5617\u8a66\u4f7f\u7528\u5c1a\u672a\u5ee3\u6cdb\u4f7f\u7528\u7684\u7368\u7279\u7d44\u5408\u3002\u6b65\u9a5f3\uff1a\u5728\u793e\u7fa4\u5a92\u9ad4\u6216\u904a\u6232\u8ad6\u58c7\u5206\u4eab\u60a8\u7684\u8a2d\u8a08\uff0c\u4ee5\u6536\u96c6\u53cd\u994b\u548c\u9748\u611f\u3002\u4f8b\u5982\uff0c\u5c07\u300c\u9713\u8679\u5916\u5957\u300d\u8207\u300c\u5168\u606f\u88d9\u300d\u548c\u300cLED \u904b\u52d5\u978b\u300d\u642d\u914d\uff0c\u53ef\u4ee5\u5275\u9020\u51fa\u6293\u4eba\u773c\u7403\u4e14\u5145\u6eff\u672a\u4f86\u611f\u7684\u9020\u578b\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u5e38\u898b\u9020\u578b\uff1a\u300c\u7d93\u5178\u9023\u8863\u88d9\u300d\uff0c\u7368\u7279\u9020\u578b\uff1a\u300c\u9713\u8679\u5916\u5957 & \u5168\u606f\u88d9\u300d\uff0c\u5f37\u8abf\u539f\u5275\u6027\u7684\u5f71\u97ff\u3002]"}]
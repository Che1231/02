[{"question": "\u5982\u4f55\u5728\u7eb8\u5a03\u5a03\u65e5\u8bb0\uff1a\u670d\u88c5DIY\u4e2d\u5f00\u59cb\u4f7f\u7528\u57fa\u672c\u5b9a\u5236\u9009\u9879\uff1f", "answer": "\u8981\u5728\u7eb8\u5a03\u5a03\u65e5\u8bb0\uff1a\u670d\u88c5DIY\u4e2d\u5f00\u59cb\u5b9a\u5236\u4f60\u7684\u7eb8\u5a03\u5a03\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u70b9\u51fb\u7eb8\u5a03\u5a03\u56fe\u6807\u6253\u5f00\u5b9a\u5236\u83dc\u5355\u3002\u6b65\u9aa42\uff1a\u9009\u62e9\u8981\u5b9a\u5236\u7684\u7c7b\u522b\uff0c\u4f8b\u5982\u53d1\u578b\u6216\u670d\u88c5\u3002\u6b65\u9aa43\uff1a\u4ece\u53ef\u7528\u9009\u9879\u4e2d\u9009\u62e9\u5e76\u5e94\u7528\u5230\u4f60\u7684\u7eb8\u5a03\u5a03\u3002\u4f8b\u5982\uff0c\u4f60\u53ef\u4ee5\u4ece\u670d\u88c5\u7c7b\u522b\u4e2d\u9009\u62e9\u4e00\u4ef6\u201c\u82b1\u6735\u8fde\u8863\u88d9\u201d\uff0c\u5e76\u642d\u914d\u201c\u9a6c\u5c3e\u8fab\u201d\u53d1\u578b\u3002\u8fd9\u79cd\u7ec4\u5408\u4f1a\u8ba9\u4f60\u7684\u7eb8\u5a03\u5a03\u62e5\u6709\u6e05\u723d\u7684\u6625\u5929\u6c14\u606f\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u53ef\u4ee5\u60f3\u8c61\u4e00\u4e0b\uff0c\u8fd9\u5c31\u50cf\u7528\u771f\u8863\u670d\u7ed9\u7eb8\u5a03\u5a03\u6253\u626e\uff0c\u4f46\u5374\u62e5\u6709\u65e0\u9650\u7684\u6570\u5b57\u53ef\u80fd\u6027\u3002]"}, {"question": "\u5728\u7eb8\u5a03\u5a03\u65e5\u8bb0\uff1a\u670d\u88c5DIY\u4e2d\uff0c\u4e3a\u4ec0\u4e48\u6709\u6548\u7ba1\u7406\u8d44\u6e90\u5f88\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u505a\u5230\u8fd9\u4e00\u70b9\uff1f", "answer": "\u5728\u7eb8\u5a03\u5a03\u65e5\u8bb0\uff1a\u670d\u88c5DIY\u4e2d\u6709\u6548\u7ba1\u7406\u8d44\u6e90\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u53ef\u4ee5\u8ba9\u4f60\u89e3\u9501\u66f4\u591a\u5b9a\u5236\u9009\u9879\uff0c\u800c\u4e0d\u4f1a\u8017\u5c3d\u6e38\u620f\u5185\u7684\u8d27\u5e01\u3002\u4e3a\u4e86\u6709\u6548\u5730\u7ba1\u7406\u8d44\u6e90\uff1a\u6b65\u9aa41\uff1a\u4f18\u5148\u5904\u7406\u5956\u52b1\u4f60\u91d1\u5e01\u548c\u5b9d\u77f3\u7684\u65e5\u5e38\u4efb\u52a1\u548c\u6311\u6218\u3002\u6b65\u9aa42\uff1a\u907f\u514d\u7acb\u5373\u4e0d\u9700\u8981\u7684\u7269\u54c1\uff1b\u76f8\u53cd\uff0c\u5219\u5e94\u4e3a\u9650\u65f6\u4f18\u60e0\u8282\u7701\u3002\u6b65\u9aa43\uff1a\u53c2\u4e0e\u63d0\u4f9b\u989d\u5916\u8d44\u6e90\u7684\u6d3b\u52a8\u3002\u4f8b\u5982\uff0c\u5728\u201c\u590f\u5b63\u5609\u5e74\u534e\u201d\u6d3b\u52a8\u671f\u95f4\uff0c\u5b8c\u6210\u7279\u5b9a\u4efb\u52a1\u53ef\u4ee5\u8ba9\u4f60\u83b7\u5f97\u989d\u5916\u7684\u5b9d\u77f3\uff0c\u8fd9\u4e9b\u5b9d\u77f3\u53ef\u7528\u4e8e\u8d2d\u4e70\u4e13\u5c5e\u65f6\u88c5\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u666e\u901a\u670d\u88c5\uff1a100\u91d1\u5e01 vs. \u6d3b\u52a8\u670d\u88c5\uff1a50\u5b9d\u77f3\uff0c\u7a81\u51fa\u8282\u7701\u4ee5\u53c2\u52a0\u6d3b\u52a8\u7684\u4ef7\u503c\u3002]"}, {"question": "\u5728\u7eb8\u5a03\u5a03\u65e5\u8bb0\uff1a\u670d\u88c5DIY\u4e2d\uff0c\u514d\u8d39\u548c\u9ad8\u7ea7\u5b9a\u5236\u9009\u9879\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u5728\u7eb8\u5a03\u5a03\u65e5\u8bb0\uff1a\u670d\u88c5DIY\u4e2d\uff0c\u514d\u8d39\u5b9a\u5236\u9009\u9879\u53ef\u4f9b\u6240\u6709\u73a9\u5bb6\u4f7f\u7528\uff0c\u5305\u62ec\u57fa\u672c\u7684\u670d\u88c5\u548c\u53d1\u578b\u7b49\u7269\u54c1\u3002\u4f46\u662f\uff0c\u9ad8\u7ea7\u9009\u9879\u5219\u63d0\u4f9b\u66f4\u7cbe\u7ec6\u548c\u66f4\u4e13\u5c5e\u7684\u8bbe\u8ba1\uff0c\u4f8b\u5982\u8be6\u7ec6\u7684\u665a\u793c\u670d\u6216\u72ec\u7279\u7684\u5934\u9970\u3002\u4f8b\u5982\uff0c\u201c\u4f18\u96c5\u665a\u793c\u670d\u201d\u662f\u4e00\u6b3e\u9ad8\u7ea7\u7269\u54c1\uff0c\u5176\u8bbe\u8ba1\u7cbe\u7ec6\uff0c\u8f6e\u5ed3\u6d41\u7545\uff0c\u800c\u514d\u8d39\u7c7b\u522b\u4e2d\u5219\u65e0\u6cd5\u83b7\u5f97\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u514d\u8d39\u9009\u9879\uff1a\u201c\u4f11\u95f2\u8fde\u8863\u88d9\u201d vs. \u9ad8\u7ea7\u9009\u9879\uff1a\u201c\u4f18\u96c5\u665a\u793c\u670d\u201d\uff0c\u5f3a\u8c03\u9ad8\u7ea7\u7269\u54c1\u7684\u989d\u5916\u7ec6\u8282\u548c\u72ec\u7279\u6027\u3002]"}, {"question": "\u5982\u4f55\u5728\u7eb8\u5a03\u5a03\u65e5\u8bb0\uff1a\u670d\u88c5DIY\u4e2d\u4f18\u5316\u7eb8\u5a03\u5a03\u7684\u5916\u89c2\u4ee5\u9002\u5e94\u7279\u5b9a\u4e3b\u9898\u6216\u6d3b\u52a8\uff1f", "answer": "\u5728\u7eb8\u5a03\u5a03\u65e5\u8bb0\uff1a\u670d\u88c5DIY\u4e2d\uff0c\u4f18\u5316\u7eb8\u5a03\u5a03\u7684\u5916\u89c2\u4ee5\u9002\u5e94\u7279\u5b9a\u4e3b\u9898\u6216\u6d3b\u52a8\u9700\u8981\u7b56\u7565\u6027\u89c4\u5212\uff1a\u6b65\u9aa41\uff1a\u63d0\u524d\u7814\u7a76\u6d3b\u52a8\u4e3b\u9898\u6216\u8981\u6c42\u3002\u6b65\u9aa42\uff1a\u9009\u62e9\u4e0e\u4e3b\u9898\u76f8\u7b26\u7684\u7269\u54c1\uff0c\u4f8b\u5982\u8282\u65e5\u6d3b\u52a8\u4e2d\u7684\u8282\u65e5\u670d\u88c5\u3002\u6b65\u9aa43\uff1a\u9002\u5f53\u914d\u9970\u4ee5\u589e\u5f3a\u6574\u4f53\u5916\u89c2\u3002\u4f8b\u5982\uff0c\u5728\u201c\u51ac\u5b63\u4ed9\u5883\u201d\u6d3b\u52a8\u671f\u95f4\uff0c\u9009\u62e9\u4e00\u4ef6\u201c\u96ea\u82b1\u8fde\u8863\u88d9\u201d\uff0c\u5e76\u642d\u914d\u201c\u971c\u51bb\u9774\u201d\u548c\u201c\u94f6\u8272\u738b\u51a0\u201d\uff0c\u53ef\u4ee5\u521b\u9020\u51fa\u534f\u8c03\u4e00\u81f4\u4e14\u4e3b\u9898\u7edf\u4e00\u7684\u5916\u89c2\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u4e3b\u9898\u7814\u7a76\u2192\u7269\u54c1\u9009\u62e9\u2192\u914d\u9970\u2192\u6700\u7ec8\u5916\u89c2\uff0c\u8bf4\u660e\u5206\u6b65\u6d41\u7a0b\u3002]"}, {"question": "\u5728\u7eb8\u5a03\u5a03\u65e5\u8bb0\uff1a\u670d\u88c5DIY\u4e2d\uff0c\u6211\u80fd\u4f7f\u7528\u54ea\u4e9b\u9ad8\u7ea7\u7b56\u7565\u6765\u89e3\u9501\u7a00\u6709\u7269\u54c1\uff1f", "answer": "\u5728\u7eb8\u5a03\u5a03\u65e5\u8bb0\uff1a\u670d\u88c5DIY\u4e2d\uff0c\u89e3\u9501\u7a00\u6709\u7269\u54c1\u9700\u8981\u7ed3\u5408\u6bc5\u529b\u548c\u7b56\u7565\uff1a\u6b65\u9aa41\uff1a\u5b9a\u671f\u67e5\u770b\u6e38\u620f\u5546\u5e97\u5185\u7684\u9650\u65f6\u4f18\u60e0\u548c\u7279\u4ef7\u3002\u6b65\u9aa42\uff1a\u5b8c\u6210\u9ad8\u7b49\u7ea7\u6311\u6218\u548c\u6210\u5c31\u4ee5\u83b7\u5f97\u7a00\u6709\u7269\u54c1\u5956\u52b1\u3002\u6b65\u9aa43\uff1a\u53c2\u4e0e\u793e\u533a\u6d3b\u52a8\u548c\u5408\u4f5c\uff0c\u8fd9\u4e9b\u6d3b\u52a8\u901a\u5e38\u4f1a\u63d0\u4f9b\u72ec\u5bb6\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u201c\u91d1\u8272\u7fbd\u6bdb\u5934\u9970\u201d\u662f\u4ec5\u5728\u7279\u6b8a\u793e\u533a\u6d3b\u52a8\u671f\u95f4\u624d\u53ef\u83b7\u5f97\u7684\u7a00\u6709\u7269\u54c1\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u5b83\u89c6\u4e3a\u5bfb\u627e\u5b9d\u85cf\uff1b\u8010\u5fc3\u548c\u52aa\u529b\u53ef\u4ee5\u53d1\u73b0\u7a00\u6709\u5b9d\u77f3\u3002]"}, {"question": "\u7eb8\u5a03\u5a03\u65e5\u8bb0\uff1a\u670d\u88c5DIY\u4e2d\u7684\u6e38\u620f\u7ecf\u6d4e\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u83b7\u5f97\u91d1\u5e01\u548c\u5b9d\u77f3\u7684\u6700\u4f73\u65b9\u6cd5\u662f\u4ec0\u4e48\uff1f", "answer": "\u7eb8\u5a03\u5a03\u65e5\u8bb0\uff1a\u670d\u88c5DIY\u4e2d\u7684\u6e38\u620f\u7ecf\u6d4e\u56f4\u7ed5\u4e24\u79cd\u4e3b\u8981\u8d27\u5e01\u8fd0\u4f5c\uff1a\u91d1\u5e01\u548c\u5b9d\u77f3\u3002\u91d1\u5e01\u53ef\u4ee5\u901a\u8fc7\u5b8c\u6210\u65e5\u5e38\u4efb\u52a1\u3001\u6311\u6218\u4ee5\u53ca\u51fa\u552e\u4e0d\u9700\u8981\u7684\u7269\u54c1\u83b7\u5f97\u3002\u5b9d\u77f3\u5219\u66f4\u4e3a\u7a00\u6709\uff0c\u53ef\u4ee5\u901a\u8fc7\u7279\u6b8a\u6d3b\u52a8\u3001\u6210\u5c31\u4ee5\u53ca\u5076\u5c14\u7684\u5e94\u7528\u5185\u8d2d\u4e70\u83b7\u5f97\u3002\u4f8b\u5982\uff0c\u5b8c\u6210\u201c\u6bcf\u65e5\u6362\u88c5\u6311\u6218\u201d\u53ef\u4ee5\u5956\u52b1\u4f6050\u91d1\u5e01\uff0c\u800c\u53c2\u4e0e\u201c\u6bcf\u6708\u65f6\u88c5\u79c0\u201d\u53ef\u4ee5\u83b7\u5f9710\u5b9d\u77f3\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u91d1\u5e01\u6765\u6e90\uff1a\u65e5\u5e38\u4efb\u52a1\uff0850\u91d1\u5e01\uff09\uff0c\u6311\u6218\uff08100\u91d1\u5e01\uff09 vs. \u5b9d\u77f3\u6765\u6e90\uff1a\u6d3b\u52a8\uff0810\u5b9d\u77f3\uff09\uff0c\u6210\u5c31\uff085\u5b9d\u77f3\uff09\uff0c\u7a81\u51fa\u4e0d\u540c\u7684\u76c8\u5229\u6f5c\u529b\u3002]"}, {"question": "\u7eb8\u5a03\u5a03\u65e5\u8bb0\uff1a\u670d\u88c5DIY\u4e2d\u7684\u201c\u98ce\u683c\u5f97\u5206\u201d\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u5927\u5316\u5f97\u5206\uff1f", "answer": "\u7eb8\u5a03\u5a03\u65e5\u8bb0\uff1a\u670d\u88c5DIY\u4e2d\u7684\u201c\u98ce\u683c\u5f97\u5206\u201d\u7cfb\u7edf\u6839\u636e\u4f60\u7684\u7eb8\u5a03\u5a03\u5916\u89c2\u7684\u534f\u8c03\u6027\u3001\u521b\u9020\u529b\u548c\u4e3b\u9898\u7684\u8d34\u5408\u5ea6\u8fdb\u884c\u8bc4\u4f30\u3002\u4e3a\u4e86\u6700\u5927\u5316\u4f60\u7684\u5f97\u5206\uff1a\u6b65\u9aa41\uff1a\u786e\u4fdd\u6240\u6709\u9009\u62e9\u7684\u7269\u54c1\u5728\u989c\u8272\u548c\u98ce\u683c\u4e0a\u76f8\u4e92\u8865\u5145\u3002\u6b65\u9aa42\uff1a\u6dfb\u52a0\u7a81\u51fa\u7684\u72ec\u7279\u914d\u9970\u6216\u7ec6\u8282\u3002\u6b65\u9aa43\uff1a\u4e25\u683c\u9075\u5faa\u4e3b\u9898\u4ee5\u83b7\u5f97\u989d\u5916\u5206\u6570\u3002\u4f8b\u5982\uff0c\u5728\u201c\u590d\u53e4\u65f6\u5c1a\u201d\u4e3b\u9898\u4e2d\uff0c\u5c06\u201c\u6ce2\u5c14\u5361\u5706\u70b9\u8fde\u8863\u88d9\u201d\u4e0e\u201c\u732b\u773c\u58a8\u955c\u201d\u548c\u201c\u590d\u53e4\u624b\u63d0\u5305\u201d\u642d\u914d\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u98ce\u683c\u5f97\u5206\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u57fa\u7840\u670d\u88c5\uff1a50\u98ce\u683c\u5f97\u5206 vs. \u4e3b\u9898\u670d\u88c5\uff1a100\u98ce\u683c\u5f97\u5206\uff0c\u5c55\u793a\u4e3b\u9898\u8d34\u5408\u5ea6\u7684\u5f71\u54cd\u3002]"}, {"question": "\u5982\u4f55\u5728\u4e0d\u4e22\u5931\u8fdb\u5ea6\u7684\u60c5\u51b5\u4e0b\u5728\u4e0d\u540c\u7684\u8bbe\u5907\u95f4\u4f20\u8f93\u7eb8\u5a03\u5a03\u65e5\u8bb0\uff1a\u670d\u88c5DIY\u7684\u6570\u636e\uff1f", "answer": "\u8981\u5728\u4e0d\u540c\u7684\u8bbe\u5907\u4e4b\u95f4\u4f20\u8f93\u7eb8\u5a03\u5a03\u65e5\u8bb0\uff1a\u670d\u88c5DIY\u7684\u6570\u636e\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u786e\u4fdd\u4f60\u6b63\u5728\u4f7f\u7528\u540c\u4e00\u4e2a\u5e10\u6237\u767b\u5f55\u8fd9\u4e24\u53f0\u8bbe\u5907\uff08\u4f8b\u5982\uff0cGoogle Play\u6216Apple ID\uff09\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u6e38\u620f\u5185\u7684\u4e91\u4fdd\u5b58\u529f\u80fd\u4e0a\u4f20\u4f60\u7684\u5f53\u524d\u8fdb\u5ea6\u3002\u6b65\u9aa43\uff1a\u5728\u65b0\u8bbe\u5907\u4e0a\u767b\u5f55\u5e76\u4e0b\u8f7d\u4fdd\u5b58\u7684\u6570\u636e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u8981\u5c06\u6570\u636e\u4eceAndroid\u624b\u673a\u79fb\u52a8\u5230iPad\uff0c\u767b\u5f55\u4f60\u7684Google\u5e10\u6237\u5e76\u540c\u6b65\u4f60\u7684\u6570\u636e\uff0c\u5c06\u786e\u4fdd\u6240\u6709\u4f60\u7684\u5b9a\u5236\u5185\u5bb9\u548c\u8fdb\u5ea6\u90fd\u5f97\u5230\u4fdd\u5b58\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u767b\u5f55\u2192\u4e91\u4fdd\u5b58\u2192\u4e0b\u8f7d\u2192\u8fdb\u5ea6\u540c\u6b65\uff0c\u8bf4\u660e\u65e0\u7f1d\u4f20\u8f93\u8fc7\u7a0b\u3002]"}, {"question": "\u5728\u7eb8\u5a03\u5a03\u65e5\u8bb0\uff1a\u670d\u88c5DIY\u4e2d\uff0c\u6211\u5e94\u8be5\u6ce8\u610f\u54ea\u4e9b\u9690\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "\u7eb8\u5a03\u5a03\u65e5\u8bb0\uff1a\u670d\u88c5DIY\u4e2d\u5145\u6ee1\u4e86\u9690\u85cf\u7684\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u8fd9\u4e9b\u529f\u80fd\u548c\u5f69\u86cb\u53ef\u4ee5\u63d0\u5347\u6e38\u620f\u4f53\u9a8c\u3002\u4e00\u4e2a\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\u201c\u79d8\u5bc6\u82b1\u56ed\u201d\u4e3b\u9898\uff0c\u53ef\u4ee5\u901a\u8fc7\u5b8c\u6210\u4e00\u7cfb\u5217\u7279\u5b9a\u4efb\u52a1\u6765\u89e3\u9501\uff0c\u4f8b\u5982\u7528\u201c\u82b1\u51a0\u201d\u548c\u201c\u67d4\u548c\u8fde\u8863\u88d9\u201d\u4e3a\u4f60\u7684\u7eb8\u5a03\u5a03\u8fdb\u884c\u5b9a\u5236\u3002\u4e00\u65e6\u89e3\u9501\uff0c\u4f60\u5c06\u83b7\u5f97\u72ec\u5bb6\u7684\u82b1\u56ed\u4e3b\u9898\u7269\u54c1\u548c\u80cc\u666f\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u53d1\u73b0\u8fd9\u4e9b\u9690\u85cf\u529f\u80fd\u5c31\u50cf\u5728\u8c6a\u5b85\u4e2d\u53d1\u73b0\u4e00\u4e2a\u79d8\u5bc6\u623f\u95f4\uff0c\u7ed9\u6e38\u620f\u589e\u6dfb\u4e86\u989d\u5916\u7684\u523a\u6fc0\u3002]"}, {"question": "\u5982\u4f55\u5728\u7eb8\u5a03\u5a03\u65e5\u8bb0\uff1a\u670d\u88c5DIY\u4e2d\u521b\u4f5c\u5f15\u4eba\u6ce8\u76ee\u7684\u7eb8\u5a03\u5a03\u8bbe\u8ba1\u4ee5\u5438\u5f15\u793e\u533a\u5173\u6ce8\uff1f", "answer": "\u5728\u7eb8\u5a03\u5a03\u65e5\u8bb0\uff1a\u670d\u88c5DIY\u4e2d\uff0c\u521b\u4f5c\u5f15\u4eba\u6ce8\u76ee\u7684\u7eb8\u5a03\u5a03\u8bbe\u8ba1\u9700\u8981\u7ed3\u5408\u521b\u9020\u529b\u548c\u5bf9\u793e\u533a\u7684\u5173\u6ce8\uff1a\u6b65\u9aa41\uff1a\u5173\u6ce8\u793e\u533a\u4e2d\u7684\u6d41\u884c\u4e3b\u9898\u548c\u6d41\u884c\u6b3e\u5f0f\u3002\u6b65\u9aa42\uff1a\u5c1d\u8bd5\u5c1a\u672a\u5e7f\u6cdb\u4f7f\u7528\u7684\u72ec\u7279\u7ec4\u5408\u3002\u6b65\u9aa43\uff1a\u5728\u793e\u4ea4\u5a92\u4f53\u6216\u6e38\u620f\u8bba\u575b\u4e0a\u5206\u4eab\u4f60\u7684\u8bbe\u8ba1\uff0c\u4ee5\u6536\u96c6\u53cd\u9988\u548c\u7075\u611f\u3002\u4f8b\u5982\uff0c\u5c06\u201c\u9713\u8679\u5916\u5957\u201d\u4e0e\u201c\u5f69\u8679\u88d9\u201d\u548c\u201cLED\u8fd0\u52a8\u978b\u201d\u642d\u914d\uff0c\u53ef\u4ee5\u521b\u9020\u51fa\u5438\u5f15\u793e\u533a\u5173\u6ce8\u7684\u672a\u6765\u4e3b\u4e49\u98ce\u683c\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u666e\u901a\u670d\u88c5\uff1a\u201c\u7ecf\u5178\u8fde\u8863\u88d9\u201d vs. \u7279\u8272\u670d\u88c5\uff1a\u201c\u9713\u8679\u5916\u5957\u548c\u5f69\u8679\u88d9\u201d\uff0c\u5f3a\u8c03\u539f\u521b\u6027\u4ea7\u751f\u7684\u5f71\u54cd\u3002]"}]
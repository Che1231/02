[{"question": "\u8c37\u6b4c\u7eb8\u724c\u6e38\u620f\u4f7f\u7528\u65b9\u6cd5\uff1a\u5982\u4f55\u8bbe\u7f6e\u548c\u73a9\u6807\u51c6\u7684\u8c37\u6b4c\u7eb8\u724c\u6e38\u620f\uff1f", "answer": "\u8c37\u6b4c\u7eb8\u724c\u6e38\u620f\uff0c\u4e5f\u79f0\u4e3a\u514b\u9686\u8fea\u514b\u7eb8\u724c\u6e38\u620f\uff0c\u6d89\u53ca\u4ee5\u7279\u5b9a\u987a\u5e8f\u6392\u5217\u724c\u3002\u6b65\u9aa4 1\uff1a\u53d1\u4e03\u5217\u724c\uff0c\u7b2c\u4e00\u5217\u4e00\u5f20\u724c\uff0c\u7b2c\u4e8c\u5217\u4e24\u5f20\u724c\uff0c\u4ee5\u6b64\u7c7b\u63a8\u3002\u6b65\u9aa4 2\uff1a\u6bcf\u5217\u7684\u7b2c\u4e00\u5f20\u724c\u6b63\u9762\u671d\u4e0a\uff0c\u5176\u4f59\u724c\u80cc\u9762\u671d\u4e0b\u3002\u6b65\u9aa4 3\uff1a\u5269\u4f59\u672a\u53d1\u7684\u724c\u5f62\u6210\u724c\u5e93\u6216\u62bd\u724c\u5806\u3002\u4e3b\u8981\u76ee\u6807\u662f\u5c06\u6240\u6709\u724c\u79fb\u52a8\u5230\u57fa\u7840\u724c\u5806\uff0c\u57fa\u7840\u724c\u5806\u6309\u82b1\u8272\u4ece A \u5230 K \u5efa\u7acb\u3002\u60a8\u53ef\u4ee5\u5728\u5217\u4e4b\u95f4\u79fb\u52a8\u724c\uff0c\u4ea4\u66ff\u989c\u8272\uff08\u4f8b\u5982\uff0c\u7ea2\u540e\u653e\u5728\u9ed1\u738b\u4e0a\uff09\u3002\u7a7a\u5217\u53ef\u4ee5\u7528\u738b\u724c\u6216\u4ece\u738b\u724c\u5f00\u59cb\u7684\u5e8f\u5217\u586b\u5145\u3002\u4e00\u4e2a\u7b80\u5355\u7684\u4f8b\u5b50\u662f\u5c06\u7ea2 6 \u79fb\u52a8\u5230\u9ed1 7 \u7684\u724c\u5806\u4e2d\u3002\u8fd9\u662f\u4e00\u4e2a\u63ed\u793a\u4e0b\u65b9\u9690\u85cf\u724c\u7684\u57fa\u672c\u52a8\u4f5c\u3002\u6839\u636e\u6240\u73a9\u53d8\u4f53\uff0c\u53ef\u4ee5\u4e00\u6b21\u7ffb\u5f00\u724c\u5e93\u7684\u4e00\u5f20\u6216\u4e09\u5f20\u724c\u3002"}, {"question": "\u7eb8\u724c\u6e38\u620f\u7b56\u7565\uff1a\u4e3a\u4ec0\u4e48 A \u548c K \u5728\u8c37\u6b4c\u7eb8\u724c\u6e38\u620f\u4e2d\u5982\u6b64\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u5728\u6e38\u620f\u4e2d\u4f18\u5148\u63ed\u793a\u5b83\u4eec\uff1f", "answer": "A \u548c K \u81f3\u5173\u91cd\u8981\u3002A \u7528\u4e8e\u5f00\u59cb\u57fa\u7840\u724c\u5806\uff0cK \u7528\u4e8e\u586b\u5145\u7a7a\u724c\u5806\u5217\uff0c\u521b\u9020\u6218\u7565\u79fb\u52a8\u673a\u4f1a\u3002\u4f18\u5148\u5728\u6e38\u620f\u4e2d\u65e9\u671f\u63ed\u793a\u5b83\u4eec\uff0c\u4ee5\u89e3\u9501\u53ef\u5efa\u9020\u7684\u57fa\u7840\u724c\u4f4d\u5e76\u4e3a\u724c\u5806\u817e\u51fa\u7a7a\u95f4\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u63ed\u793a\u4e86 K\uff0c\u8bf7\u7acb\u5373\u5c1d\u8bd5\u5c06\u5176\u79fb\u52a8\u5230\u7a7a\u5217\u3002\u901a\u8fc7 A \u6253\u5f00\u57fa\u7840\u724c\u5806\uff0c\u60a8\u53ef\u4ee5\u5f00\u59cb\u5efa\u9020\u540c\u82b1\u8272\u724c\u5806\u3002\u60a8\u53ef\u4ee5\u5c06\u5b83\u4eec\u89c6\u4e3a\u57fa\u77f3\uff1a\u6ca1\u6709\u5b83\u4eec\uff0c\u5efa\u9020\u5c31\u65e0\u6cd5\u5f00\u59cb\u3002\u4ee5\u4e0b\u6bd4\u8f83\u8868\u8fdb\u4e00\u6b65\u89e3\u91ca\u4e86\u5b83\u4eec\u7684\u610f\u4e49\uff1aA \u2013 \u57fa\u7840\u724c\u5806\u8d77\u70b9\uff1bK \u2013 \u724c\u5806\u91cd\u7f6e\uff0c\u4f7f\u724c\u79fb\u52a8\u6210\u4e3a\u53ef\u80fd\u3002"}, {"question": "\u8c37\u6b4c\u7eb8\u724c\u6e38\u620f\u8ba1\u5206\uff1a\u8c37\u6b4c\u7eb8\u724c\u6e38\u620f\u7684\u8ba1\u5206\u7cfb\u7edf\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u6bcf\u6b21\u6e38\u620f\u7684\u5f97\u5206\uff1f", "answer": "\u8c37\u6b4c\u7eb8\u724c\u6e38\u620f\u7684\u8ba1\u5206\u7cfb\u7edf\u901a\u5e38\u4f1a\u4e3a\u79fb\u52a8\u724c\u5230\u57fa\u7840\u3001\u5728\u724c\u5806\u4e2d\u63ed\u793a\u80cc\u9762\u671d\u4e0b\u7684\u724c\u4ee5\u53ca\u5b8c\u6210\u6e38\u620f\u7b49\u52a8\u4f5c\u6388\u4e88\u5206\u6570\u3002\u4ee5\u4e0b\u662f\u4e00\u4e2a\u793a\u4f8b\u5206\u89e3\uff1a\u5c06\u4e00\u5f20\u724c\u79fb\u52a8\u5230\u57fa\u7840\u53ef\u80fd\u4f1a\u83b7\u5f97 10 \u5206\uff0c\u800c\u7ffb\u8f6c\u4e00\u5f20\u80cc\u9762\u671d\u4e0b\u7684\u724c\u53ef\u80fd\u4f1a\u83b7\u5f97 5 \u5206\u3002\u5c06\u4e00\u5f20\u724c\u4ece\u57fa\u7840\u8fd4\u56de\u5230\u724c\u5806\u4f1a\u5bfc\u81f4\u60e9\u7f5a\u51cf\u8f7b\u3002\u6700\u5927\u5316\u5f97\u5206\u9700\u8981\u6218\u7565\u6027\u5730\u8fdb\u884c\u6e38\u620f\uff0c\u4ee5\u6709\u6548\u5730\u6e05\u9664\u724c\u5806\u5e76\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u64a4\u9500\u6309\u94ae\u7684\u4f7f\u7528\u3002\u76ee\u6807\u662f\u5feb\u901f\u83b7\u80dc\u5e76\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u6d89\u53ca\u592a\u591a\u6b21\u5faa\u73af\u5e9f\u724c\u5806\u7684\u79fb\u52a8\u3002\u5feb\u901f\u5b8c\u6210\u6e38\u620f\u4f1a\u5956\u52b1\u989d\u5916\u5206\u6570\u3002\u79fb\u52a8\u6b21\u6570\u8d8a\u5c11\uff0c\u5956\u52b1\u8d8a\u5927\uff01"}, {"question": "\u9ad8\u7ea7\u6280\u5de7\uff1a\u54ea\u4e9b\u9ad8\u7ea7\u7b56\u7565\uff0c\u4f8b\u5982\u201c\u724c\u5e93\u7ba1\u7406\u201d\u548c\u201c\u724c\u5806\u64cd\u4f5c\u201d\uff0c\u7ecf\u9a8c\u4e30\u5bcc\u7684\u8c37\u6b4c\u7eb8\u724c\u6e38\u620f\u73a9\u5bb6\u5e94\u8be5\u638c\u63e1\u4ee5\u63d0\u9ad8\u4ed6\u4eec\u7684\u6e38\u620f\uff1f", "answer": "\u638c\u63e1\u724c\u5e93\u7ba1\u7406\u548c\u724c\u5806\u64cd\u4f5c\u3002\u724c\u5e93\u7ba1\u7406\u5305\u62ec\u4e86\u89e3\u724c\u5e93\u4e2d\u724c\u7684\u987a\u5e8f\u4ee5\u53ca\u6218\u7565\u6027\u5730\u89c4\u5212\u4f55\u65f6\u62bd\u724c\u3002\u724c\u5806\u64cd\u4f5c\u4fa7\u91cd\u4e8e\u79fb\u52a8\u724c\u5217\u4ee5\u63ed\u793a\u9690\u85cf\u724c\u5e76\u521b\u5efa\u6709\u5229\u7684\u5e8f\u5217\u3002\u4f8b\u5982\uff0c\u4f18\u5148\u7b56\u7565\u6027\u5730\u63ed\u793a\u5217\u4e2d\u7684\u724c\uff0c\u56e0\u4e3a\u968f\u7740\u6e38\u620f\u8fdb\u5c55\uff0c\u5b83\u4eec\u4f1a\u6253\u5f00\u66f4\u591a\u673a\u4f1a\u3002\u6b65\u9aa4 1\uff1a\u5206\u6790\u724c\u5806\u4e2d\u88ab\u963b\u6321\u7684\u724c\u3002\u6b65\u9aa4 2\uff1a\u89c4\u5212\u79fb\u52a8\u4ee5\u91ca\u653e\u4e3a\u57fa\u7840\u6784\u5efa\u6240\u9700\u7684\u7279\u5b9a\u724c\u3002\u6b65\u9aa4 3\uff1a\u9002\u65f6\u62bd\u53d6\u724c\u5e93\u724c\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63ed\u793a\u8865\u5145\u724c\u5806\u6392\u5217\u7684\u724c\u3002\u8fd9\u4e9b\u9ad8\u7ea7\u6280\u80fd\u53ef\u4ee5\u663e\u7740\u63d0\u9ad8\u80dc\u7387\u3002"}, {"question": "\u6548\u7387\uff1a\u5982\u4f55\u5728\u8c37\u6b4c\u7eb8\u724c\u6e38\u620f\u4e2d\u6709\u6548\u5730\u4f7f\u7528\u201c\u64a4\u9500\u201d\u529f\u80fd\uff0c\u4ee5\u63a2\u7d22\u4e0d\u540c\u7684\u79fb\u52a8\u9009\u9879\uff0c\u800c\u4e0d\u4f1a\u5bf9\u5206\u6570\u4ea7\u751f\u91cd\u5927\u5f71\u54cd\uff1f", "answer": "\u201c\u64a4\u9500\u201d\u529f\u80fd\u5141\u8bb8\u60a8\u8fdb\u884c\u8bd5\u9a8c\u800c\u4e0d\u4ea7\u751f\u627f\u8bfa\uff0c\u4f46\u907f\u514d\u8fc7\u5ea6\u4f7f\u7528\u3002\u201c\u64a4\u9500\u201d\u53ef\u4ee5\u5e2e\u52a9\u5206\u6790\u53ef\u80fd\u7684\u724c\u5e8f\uff0c\u901a\u8fc7\u5c1d\u8bd5\u591a\u4e2a\u79fb\u52a8\u6765\u5206\u6790\u53ef\u80fd\u6027\u7684\u724c\u5e8f\u3002\u53ea\u6709\u5728\u5fc5\u8981\u65f6\u624d\u4f7f\u7528\u5b83\uff0c\u56e0\u4e3a\u8fc7\u5ea6\u4f7f\u7528\u4f1a\u5bfc\u81f4\u4f4e\u6548\u7684\u6e38\u620f\u3002\u4e00\u79cd\u6709\u6548\u7684\u6280\u5de7\u662f\uff0c\u5728\u6709\u591a\u4e2a\u53ef\u80fd\u6027\u65f6\uff0c\u4f7f\u7528\u201c\u64a4\u9500\u201d\u63a2\u7d22\u4e0d\u540c\u7684\u79fb\u52a8\u9009\u9879\u3002\u4f5c\u4e3a\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\uff0c\u60a8\u9700\u8981\u719f\u6089\u8ba1\u7b97\u6700\u4f73\u89e3\u51b3\u65b9\u6848\u5e76\u5c3d\u53ef\u80fd\u51cf\u5c11\u56de\u6eaf\u3002"}, {"question": "\u6e38\u620f\u53d8\u4f53\uff1a\u54ea\u4e9b\u5e38\u89c1\u7684\u8c37\u6b4c\u7eb8\u724c\u6e38\u620f\u53d8\u4f53\uff0c\u4f8b\u5982\u514b\u9686\u8fea\u514b\uff08\u4e00\u6b21\u62bd\u53d6\u4e00\u5f20\u724c\u4e0e\u4e00\u6b21\u62bd\u53d6\u4e09\u5f20\u724c\uff09\uff0c\u5f7c\u6b64\u4e4b\u95f4\u6709\u4f55\u533a\u522b\uff1f", "answer": "\u5173\u952e\u533a\u522b\u5728\u4e8e\u724c\u5e93\u62bd\u724c\u65b9\u5f0f\uff1a\u514b\u9686\u8fea\u514b\u4e00\u6b21\u62bd\u53d6\u4e00\u5f20\u724c\uff08\u66f4\u5bb9\u6613\uff09\u4e0e\u4e00\u6b21\u62bd\u53d6\u4e09\u5f20\u724c\uff08\u66f4\u96be\uff09\u3002\u4e00\u6b21\u62bd\u53d6\u4e00\u5f20\u724c\u662f\u4ece\u724c\u5e93\u62bd\u51fa\u5230\u5e9f\u724c\u5806\u7684\u4e00\u5f20\u724c\uff1b\u4e00\u6b21\u62bd\u53d6\u4e09\u5f20\u724c\u62bd\u51fa\u4e09\u5f20\uff0c\u53ea\u6709\u6700\u9876\u4e0a\u7684\u724c\u53ef\u4ee5\u73a9\u3002\u724c\u5806\u663e\u793a\u5df2\u63ed\u793a\u7684\u724c\u5806\u3002\u793a\u4f8b\uff1a\u5728\u4e00\u6b21\u62bd\u53d6\u4e09\u5f20\u724c\u4e2d\uff0c\u5047\u8bbe\u4ece\u724c\u5e93\u9876\u90e8\u63ed\u793a\u4e00\u5f20\u65b9\u5757 7\uff0c\u7136\u540e\u662f\u6885\u82b1 5\uff0c\u6700\u540e\u662f\u6885\u82b1 9\u3002\u5728\u8fd9\u79cd\u60c5\u51b5\u4e0b\uff0c\u60a8\u53ea\u80fd\u5728\u724c\u5806\u5e8f\u5217\u4e2d\u4f7f\u7528\u6885\u82b1 9\u3002\u9009\u62e9\u5408\u9002\u7684\u53d8\u4f53\u53d6\u51b3\u4e8e\u60a8\u7684\u6280\u80fd\u6c34\u5e73\u548c\u671f\u671b\u7684\u6311\u6218\u3002\u4e00\u6b21\u62bd\u53d6\u4e00\u5f20\u724c\u7684\u7b56\u7565\u6d89\u53ca\u66f4\u53ef\u9884\u6d4b\u7684\u79fb\u52a8\uff0c\u800c\u4e00\u6b21\u62bd\u53d6\u4e09\u5f20\u724c\u5219\u9700\u8981\u4ed4\u7ec6\u7ba1\u7406\u724c\u5e93\u3002"}, {"question": "\u8c37\u6b4c\u7eb8\u724c\u6e38\u620f\u5206\u6790\uff1a\u54ea\u4e9b\u5e95\u5c42\u7b97\u6cd5\u63a7\u5236\u7740\u8c37\u6b4c\u7eb8\u724c\u6e38\u620f\u7684\u6d17\u724c\u548c\u53d1\u724c\uff0c\u4ee5\u53ca\u5b83\u4eec\u5982\u4f55\u786e\u4fdd\u516c\u5e73\u6027\uff1f", "answer": "\u8c37\u6b4c\u7eb8\u724c\u6e38\u620f\uff0c\u4e0e\u8bb8\u591a\u6570\u5b57\u7eb8\u724c\u6e38\u620f\u4e00\u6837\uff0c\u4f7f\u7528\u4f2a\u968f\u673a\u6570\u751f\u6210\u5668 (PRNG) \u8fdb\u884c\u6d17\u724c\u3002\u8fd9\u4e9b\u7b97\u6cd5\u65e8\u5728\u6a21\u62df\u968f\u673a\u6027\uff0c\u4f46\u5374\u662f\u786e\u5b9a\u6027\u7684\uff0c\u8fd9\u610f\u5473\u7740\uff0c\u5982\u679c\u7ed9\u5b9a\u76f8\u540c\u7684\u79cd\u5b50\u503c\uff0c\u5b83\u4eec\u4f1a\u751f\u6210\u76f8\u540c\u7684\u5e8f\u5217\u3002\u516c\u5e73\u6027\u901a\u8fc7\u51e0\u4e2a\u8bbe\u8ba1\u8003\u8651\u56e0\u7d20\u5f97\u5230\u4fdd\u8bc1\uff1a\u8db3\u591f\u957f\u7684\u79cd\u5b50\u5bc6\u94a5\u4ee5\u9632\u6b62\u9884\u6d4b\u3001\u5f3a\u5065\u7684\u6d17\u724c\u7b97\u6cd5\uff08\u4f8b\u5982\u8d39\u820d\u5c14-\u53f6\u8328\uff09\u4ee5\u53ca\u6e38\u620f\u8fed\u4ee3\u7684\u6052\u5b9a\u79cd\u5b50\u3002\u867d\u7136\u786e\u5207\u7684\u7b97\u6cd5\u662f\u4e13\u6709\u7684\uff0c\u4f46\u4e00\u822c\u539f\u5219\u662f\u5747\u5300\u4e14\u4e0d\u53ef\u9884\u6d4b\u5730\u5206\u914d\u724c\u3002\u91cd\u8981\u7684\u662f\u8981\u6ce8\u610f\uff0c\u5728\u6570\u5b57\u9886\u57df\uff0c\u771f\u6b63\u7684\u968f\u673a\u6027\u5728\u5b9e\u8df5\u4e2d\u662f\u4e0d\u53ef\u80fd\u7684\u3002"}, {"question": "\u7eb8\u724c\u6e38\u620f\u8bbe\u8ba1\uff1a\u5206\u6790\u8c37\u6b4c\u7eb8\u724c\u6e38\u620f\u7684\u590d\u6742\u6027\u5982\u4f55\u4e3a\u672a\u6765\u7eb8\u724c\u6e38\u620f\u6216\u5176\u6570\u5b57\u7248\u672c\u7684\u8bbe\u8ba1\u8003\u8651\u56e0\u7d20\u63d0\u4f9b\u4fe1\u606f\uff1f", "answer": "\u8c37\u6b4c\u7eb8\u724c\u6e38\u620f\u7684\u6210\u529f\u6e90\u4e8e\u53ef\u8c03\u6574\u7684\u590d\u6742\u6027\u3002\u7eb8\u724c\u6e38\u620f\u8bbe\u8ba1\u5e08\u4f1a\u8003\u8651\u6e38\u620f\u6613\u4e8e\u73a9\u800d\u548c\u6218\u7565\u6df1\u5ea6\u4e4b\u95f4\u7684\u6743\u8861\u3002\u5bf9\u68ad\u54c8\u7684\u5206\u6790\u53ef\u4ee5\u544a\u77e5\u8fd9\u4e9b\u56e0\u7d20\uff1b\u6982\u7387\u3001\u7ec4\u5408\u641c\u7d22\u548c\u8ba4\u77e5\u8d1f\u8377\u3002\u793a\u4f8b\uff1a\u6210\u529f\u7684\u68ad\u54c8\u6e38\u620f\u878d\u5165\u4e86\u7b80\u5355\u6027\u4e0e\u4ee4\u4eba\u6ee1\u610f\u7684\u6311\u6218\u6027\u3002\u6613\u4e8e\u5b66\u4e60\uff0c\u96be\u4ee5\u638c\u63e1\u3002\u672a\u6765\u7684\u7c7b\u4f3c\u7eb8\u724c\u6e38\u620f\u53ef\u80fd\u4f1a\u53d7\u76ca\u4e8e\u91c7\u7528\u7c7b\u4f3c\u7684\u8bbe\u8ba1\uff0c\u8ba9\u73a9\u5bb6\u968f\u7740\u65f6\u95f4\u7684\u63a8\u79fb\u63d0\u9ad8\u4ed6\u4eec\u7684\u6280\u80fd\u3002"}, {"question": "\u8de8\u5e73\u53f0\u6e38\u620f\uff1a\u4f18\u5316\u8c37\u6b4c\u7eb8\u724c\u6e38\u620f\u4ee5\u5728\u684c\u9762\u6d4f\u89c8\u5668\u548c\u79fb\u52a8\u8bbe\u5907\u4e0a\u8fdb\u884c\u8de8\u5e73\u53f0\u6e38\u620f\u65f6\uff0c\u5e94\u8003\u8651\u54ea\u4e9b\u56e0\u7d20\uff1f", "answer": "\u4e3a\u4e86\u4f18\u5316\u7eb8\u724c\u6e38\u620f\u5728\u8de8\u5e73\u53f0\u4e0a\u7684\u6027\u80fd\uff0c\u9700\u8981\u4ed4\u7ec6\u8003\u8651\u5c4f\u5e55\u5c3a\u5bf8\u3001\u8f93\u5165\u65b9\u5f0f\u548c\u6027\u80fd\u7b49\u51e0\u4e2a\u56e0\u7d20\u3002\u9700\u8981\u54cd\u5e94\u5f0f\u8bbe\u8ba1\u3002\u79fb\u52a8\u8bbe\u5907\u4e0a\u7684\u89e6\u63a7\u63a7\u4ef6\u9700\u8981\u4e0e\u9f20\u6807\u6307\u9488\u533a\u5206\u5f00\u6765\uff0c\u800c\u5c4f\u5e55\u5dee\u5f02\u8fd8\u4f1a\u5f71\u54cd\u4e24\u7248\u4e2d\u7684\u724c\u5e03\u5c40\u3002\u793a\u4f8b\uff1a\u8003\u8651\u8c37\u6b4c\u7eb8\u724c\u6e38\u620f\u7684\u684c\u9762\u7248\u672c\u5141\u8bb8\u62d6\u653e\u64cd\u4f5c\uff0c\u800c\u79fb\u52a8\u5e94\u7528\u5219\u9700\u8981\u201c\u6309\u4f4f\u5e76\u70b9\u51fb\u201d\u624b\u52bf\u3002\u6b64\u5916\uff0c\u60a8\u5fc5\u987b\u5141\u8bb8\u6570\u636e\u540c\u6b65\uff0c\u56e0\u4e3a\u7528\u6237\u53ef\u4ee5\u5728\u540c\u4e00\u6e38\u620f\u4e2d\u73a9\u8fd9\u4e24\u4e2a\u7248\u672c\u3002"}, {"question": "\u8c37\u6b4c\u7eb8\u724c\u6e38\u620f\u5f69\u86cb\uff1a\u6211\u80fd\u5426\u89e3\u5f00\u8c37\u6b4c\u7eb8\u724c\u6e38\u620f\u4e2d\u7684\u4efb\u4f55\u9690\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff0c\u4ee5\u53ca\u5982\u4f55\uff1f", "answer": "\u8c37\u6b4c\u7ecf\u5e38\u5728\u5176\u4ea7\u54c1\u4e2d\u5305\u542b\u5f69\u86cb\u3002\u5728\u8c37\u6b4c\u641c\u7d22\u680f\u4e2d\u8f93\u5165\u201c\u7eb8\u724c\u201d\u3002\u5728\u8bb8\u591a\u60c5\u51b5\u4e0b\uff0c\u4f1a\u51fa\u73b0\u4e00\u4e2a\u53ef\u73a9\u7684\u7eb8\u724c\u6e38\u620f\uff0c\u8be5\u6e38\u620f\u4e0e\u5e94\u7528\u4e0d\u540c\u3002\u8fd9\u4e9b\u72ec\u7acb\u7248\u672c\u901a\u5e38\u5305\u542b\u9690\u85cf\u7684\u56fe\u5f62\u8bbe\u8ba1\u6216\u6e38\u620f\u73a9\u6cd5\u7f8e\u5b66\u7684\u7ec6\u5fae\u53d8\u5316\u3002\u4e00\u79cd\u5e38\u89c1\u7684\u6280\u5de7\u662f\u5728\u6e38\u620f\u4e2d\u5feb\u901f\u8f93\u5165 Konami \u4ee3\u7801\u4ee5\u542f\u7528\u901a\u8fc7\u8bbf\u95ee\u8c03\u8bd5\u6a21\u5f0f\u800c\u4ea7\u751f\u7684\u6548\u679c\uff0c\u5728\u8bbe\u7f6e\u4e2d\u4e5f\u53ef\u80fd\u9690\u85cf\u7740\u4e3b\u9898\u7684\u724c\u7ec4\u3002"}]
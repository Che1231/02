[{"question": "Google Solitaire \u306e\u64cd\u4f5c\u65b9\u6cd5\uff1aGoogle Solitaire \u306e\u6a19\u6e96\u7684\u306a\u30b2\u30fc\u30e0\u306e\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7\u3068\u30d7\u30ec\u30a4\u306e\u57fa\u672c\u7684\u306a\u30eb\u30fc\u30eb\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Google Solitaire\uff08\u30af\u30ed\u30f3\u30c0\u30a4\u30af\u30fb\u30bd\u30ea\u30c6\u30a3\u30a2\u3068\u3082\u547c\u3070\u308c\u307e\u3059\uff09\u306f\u3001\u7279\u5b9a\u306e\u9806\u5e8f\u3067\u30ab\u30fc\u30c9\u3092\u4e26\u3079\u308b\u30b2\u30fc\u30e0\u3067\u3059\u3002\u624b\u9806 1\uff1a\u30ab\u30fc\u30c9\u3092 7 \u5217\u306b\u914d\u308a\u3001\u6700\u521d\u306e\u5217\u306f 1 \u679a\u30012 \u756a\u76ee\u306e\u5217\u306f 2 \u679a\u3001\u4ee5\u4e0b\u540c\u69d8\u306b\u7e70\u308a\u8fd4\u3057\u307e\u3059\u3002\u624b\u9806 2\uff1a\u5404\u5217\u306e\u4e00\u756a\u4e0a\u306e\u30ab\u30fc\u30c9\u306f\u8868\u5411\u304d\u3067\u3001\u305d\u306e\u4ed6\u306e\u30ab\u30fc\u30c9\u306f\u88cf\u5411\u304d\u3067\u3059\u3002\u624b\u9806 3\uff1a\u6b8b\u308a\u306e\u672a\u914d\u30ab\u30fc\u30c9\u306f\u30b9\u30c8\u30c3\u30af\u307e\u305f\u306f\u5f15\u304f\u5c71\u306b\u306a\u308a\u307e\u3059\u3002\u4e3b\u306a\u76ee\u6a19\u306f\u3001\u3059\u3079\u3066\u306e\u30ab\u30fc\u30c9\u3092\u57fa\u790e\u306e\u5c71\u306b\u79fb\u52d5\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u57fa\u790e\u306e\u5c71\u306f\u3001\u30a8\u30fc\u30b9\u304b\u3089\u30ad\u30f3\u30b0\u307e\u3067\u3001\u540c\u3058\u30b9\u30fc\u30c4\u3067\u7a4d\u307f\u4e0a\u3052\u307e\u3059\u3002\u30ab\u30fc\u30c9\u306f\u5217\u9593\u3067\u79fb\u52d5\u3067\u304d\u307e\u3059\u304c\u3001\u4ea4\u4e92\u306e\u8272\u3067\u4e0b\u304b\u3089\u7a4d\u307f\u91cd\u306d\u307e\u3059\uff08\u4f8b\uff1a\u8d64\u3044\u30af\u30a4\u30fc\u30f3\u3092\u9ed2\u3044\u30ad\u30f3\u30b0\u306e\u4e0a\u306b\u91cd\u306d\u307e\u3059\uff09\u3002\u7a7a\u306e\u5217\u306f\u3001\u30ad\u30f3\u30b0\u307e\u305f\u306f\u30ad\u30f3\u30b0\u304b\u3089\u59cb\u307e\u308b\u30b7\u30fc\u30b1\u30f3\u30b9\u3067\u57cb\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u5358\u7d14\u306a\u4f8b\u3068\u3057\u3066\u3001\u8d64\u3044 6 \u3092\u9ed2\u306e 7 \u306b\u8868\u5f62\u5f0f\u3067\u79fb\u52d5\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u96a0\u3055\u308c\u305f\u4e0b\u306b\u3042\u308b\u30ab\u30fc\u30c9\u3092\u660e\u304b\u3059\u305f\u3081\u306e\u57fa\u672c\u7684\u306a\u624b\u3067\u3059\u3002\u30b9\u30c8\u30c3\u30af\u306e\u5c71\u306f\u3001\u30d7\u30ec\u30a4\u3055\u308c\u3066\u3044\u308b\u30d0\u30ea\u30a2\u30f3\u30c8\u306b\u5fdc\u3058\u3066\u30011 \u679a\u307e\u305f\u306f 3 \u679a\u305a\u3064\u3072\u3063\u304f\u308a\u8fd4\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30bd\u30ea\u30c6\u30a3\u30a2\u306e\u6226\u7565\uff1a\u306a\u305cGoogle Solitaire\u3067\u306f\u30a8\u30fc\u30b9\u3068\u30ad\u30f3\u30b0\u306f\u975e\u5e38\u306b\u91cd\u8981\u306a\u306e\u3067\u3057\u3087\u3046\u304b\u3002\u305d\u3057\u3066\u3001\u30b2\u30fc\u30e0\u306e\u521d\u671f\u306b\u305d\u308c\u3089\u3092\u65e9\u671f\u306b\u898b\u305b\u308b\u3053\u3068\u306f\u3069\u306e\u3088\u3046\u306b\u512a\u5148\u3059\u3079\u304d\u3067\u3057\u3087\u3046\u304b\uff1f", "answer": "\u30a8\u30fc\u30b9\u3068\u30ad\u30f3\u30b0\u306f\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u30a8\u30fc\u30b9\u306f\u57fa\u790e\u306e\u5c71\u3092\u958b\u59cb\u3057\u3001\u30ad\u30f3\u30b0\u306f\u7a7a\u306e\u8868\u5f62\u5f0f\u306e\u5217\u3092\u57cb\u3081\u3066\u3001\u6226\u7565\u7684\u306a\u52d5\u304d\u306e\u305f\u3081\u306e\u6a5f\u4f1a\u3092\u4f5c\u308a\u307e\u3059\u3002\u57fa\u790e\u3067\u69cb\u7bc9\u3067\u304d\u308b\u30b9\u30ed\u30c3\u30c8\u3092\u958b\u653e\u3057\u3001\u8868\u5f62\u5f0f\u306e\u5217\u306b\u30b9\u30da\u30fc\u30b9\u3092\u4f5c\u308b\u305f\u3081\u306b\u3001\u305d\u308c\u3089\u3092\u65e9\u671f\u306b\u898b\u305b\u308b\u3053\u3068\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ad\u30f3\u30b0\u3092\u898b\u3064\u3051\u305f\u5834\u5408\u306f\u3001\u3059\u3050\u306b\u7a7a\u306e\u5217\u306b\u79fb\u52d5\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u30a8\u30fc\u30b9\u3067\u57fa\u790e\u306e\u5c71\u3092\u958b\u304f\u3068\u3001\u30b9\u30fc\u30c4\u306e\u30b9\u30bf\u30c3\u30af\u3092\u69cb\u7bc9\u3057\u59cb\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305d\u308c\u3089\u306f\u3001\u305d\u306e\u4e0a\u306b\u69cb\u7bc9\u3067\u304d\u306a\u3044\u3068\u3001\u4f55\u3082\u59cb\u307e\u3089\u306a\u3044\u89d2\u67f1\u3001\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u4ee5\u4e0b\u306e\u6bd4\u8f03\u8868\u306f\u3001\u305d\u306e\u91cd\u8981\u6027\u3092\u3055\u3089\u306b\u8aac\u660e\u3057\u3066\u3044\u307e\u3059\uff1a\u30a8\u30fc\u30b9 - \u57fa\u790e\u306e\u958b\u59cb\u70b9; \u30ad\u30f3\u30b0 - \u8868\u5f62\u5f0f\u306e\u518d\u8a2d\u5b9a\u3001\u30ab\u30fc\u30c9\u79fb\u52d5\u3092\u53ef\u80fd\u306b\u3057\u307e\u3059\u3002"}, {"question": "Google Solitaire \u306e\u5f97\u70b9\uff1aGoogle Solitaire \u306e\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306f\u4f55\u3067\u3042\u308a\u3001\u30d7\u30ec\u30a4\u3059\u308b\u5404\u30b2\u30fc\u30e0\u3067\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Google Solitaire \u306e\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306f\u4e00\u822c\u7684\u306b\u3001\u30ab\u30fc\u30c9\u3092\u57fa\u790e\u306e\u5c71\u306b\u79fb\u52d5\u3059\u308b\u3001\u8868\u5f62\u5f0f\u306e\u30ab\u30fc\u30c9\u3092\u88cf\u5411\u304d\u304b\u3089\u8868\u5411\u304d\u306b\u3059\u308b\u3001\u305d\u3057\u3066\u30b2\u30fc\u30e0\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u306b\u5bfe\u3059\u308b\u30dd\u30a4\u30f3\u30c8\u304c\u4ed8\u4e0e\u3055\u308c\u307e\u3059\u3002\u3053\u3053\u3067\u306f\u4f8b\u3068\u3057\u3066\u3001\u57fa\u790e\u306e\u5c71\u306b\u30ab\u30fc\u30c9\u3092\u79fb\u52d5\u3059\u308b\u3068 10 \u70b9\u3001\u8868\u5f62\u5f0f\u306e\u30ab\u30fc\u30c9\u3092\u88cf\u5411\u304d\u304b\u3089\u8868\u5411\u304d\u306b\u3059\u308b\u3068 5 \u70b9\u304c\u4e0e\u3048\u3089\u308c\u307e\u3059\u3002\u57fa\u790e\u306e\u5c71\u304b\u3089\u8868\u5f62\u5f0f\u306e\u5217\u306b\u623b\u3059\u3068\u3001\u30da\u30ca\u30eb\u30c6\u30a3\u304c\u6e1b\u5c11\u3057\u307e\u3059\u3002\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u8868\u5f62\u5f0f\u3092\u52b9\u7387\u7684\u306b\u30af\u30ea\u30a2\u3057\u3001\u30a2\u30f3\u30c9\u30a5\u30dc\u30bf\u30f3\u306e\u4f7f\u7528\u3092\u6700\u5c0f\u9650\u306b\u3059\u308b\u6226\u7565\u7684\u306a\u30d7\u30ec\u30a4\u304c\u5fc5\u8981\u3067\u3059\u3002\u8fc5\u901f\u306a\u52dd\u5229\u3092\u76ee\u6307\u3057\u3001\u5ec3\u68c4\u306e\u5c71\u3092\u4f55\u5ea6\u3082\u5faa\u74b0\u3055\u305b\u308b\u3088\u3046\u306a\u52d5\u304d\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u307e\u3057\u3087\u3046\u3002\u30b2\u30fc\u30e0\u3092\u65e9\u304f\u5b8c\u4e86\u3059\u308b\u3068\u3001\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u304c\u4ed8\u4e0e\u3055\u308c\u307e\u3059\u3002\u5c11\u306a\u3044\u624b\u6570\u307b\u3069\u3001\u5927\u304d\u306a\u30dc\u30fc\u30ca\u30b9\u306b\u306a\u308a\u307e\u3059\uff01"}, {"question": "\u9ad8\u5ea6\u306a\u30c6\u30af\u30cb\u30c3\u30af\uff1a\u300c\u30b9\u30c8\u30c3\u30af\u7ba1\u7406\u300d\u3084\u300c\u8868\u5f62\u5f0f\u306e\u64cd\u4f5c\u300d\u306a\u3069\u306e\u9ad8\u5ea6\u306a\u6226\u7565\u306f\u3001\u4e0a\u7d1a\u306eGoogle Solitaire\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30b2\u30fc\u30e0\u3092\u6539\u5584\u3059\u308b\u305f\u3081\u306b\u30de\u30b9\u30bf\u30fc\u3059\u3079\u304d\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30c8\u30c3\u30af\u7ba1\u7406\u3068\u8868\u5f62\u5f0f\u306e\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c8\u30c3\u30af\u7ba1\u7406\u306f\u3001\u30b9\u30c8\u30c3\u30af\u5185\u306e\u30ab\u30fc\u30c9\u306e\u9806\u5e8f\u3092\u7406\u89e3\u3057\u3001\u5f15\u304d\u51fa\u3059\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u6226\u7565\u7684\u306b\u8a08\u753b\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u8868\u5f62\u5f0f\u306e\u64cd\u4f5c\u306f\u3001\u96a0\u3055\u308c\u305f\u30ab\u30fc\u30c9\u3092\u660e\u3089\u304b\u306b\u3057\u3001\u6709\u5229\u306a\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u4f5c\u6210\u3059\u308b\u305f\u3081\u306b\u3001\u30ab\u30fc\u30c9\u306e\u5217\u3092\u79fb\u52d5\u3059\u308b\u3053\u3068\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u305d\u306e\u5217\u306e\u30ab\u30fc\u30c9\u3092\u6226\u7565\u7684\u306b\u660e\u3089\u304b\u306b\u3059\u308b\u3053\u3068\u3092\u512a\u5148\u3055\u305b\u307e\u3057\u3087\u3046\u3001\u306a\u305c\u306a\u3089\u305d\u308c\u3089\u306f\u30b2\u30fc\u30e0\u304c\u9032\u3080\u306b\u3064\u308c\u3066\u3001\u3088\u308a\u591a\u304f\u306e\u6a5f\u4f1a\u3092\u958b\u653e\u3059\u308b\u304b\u3089\u3067\u3059\u3002\u624b\u9806 1\uff1a\u8868\u5f62\u5f0f\u306e\u30d6\u30ed\u30c3\u30af\u3055\u308c\u305f\u30ab\u30fc\u30c9\u3092\u5206\u6790\u3057\u307e\u3059\u3002\u624b\u9806 2\uff1a\u57fa\u790e\u306e\u69cb\u7bc9\u306b\u5fc5\u8981\u306a\u7279\u5b9a\u306e\u30ab\u30fc\u30c9\u3092\u958b\u653e\u3059\u308b\u305f\u3081\u306e\u52d5\u304d\u3092\u8a08\u753b\u3057\u307e\u3059\u3002\u624b\u9806 3\uff1a\u8868\u5f62\u5f0f\u306e\u914d\u7f6e\u3068\u88dc\u5b8c\u7684\u306a\u30ab\u30fc\u30c9\u3092\u8868\u3059\u3088\u3046\u306b\u3001\u30b9\u30c8\u30c3\u30af\u306e\u5f15\u304d\u51fa\u3057\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u9ad8\u5ea6\u306a\u30b9\u30ad\u30eb\u306f\u3001\u52dd\u5229\u7387\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u52b9\u7387\u6027\uff1aGoogle Solitaire\u3067\u300e\u30a2\u30f3\u30c9\u30a5\u300f\u6a5f\u80fd\u3092\u52b9\u679c\u7684\u306b\u4f7f\u7528\u3057\u3066\u3001\u3055\u307e\u3056\u307e\u306a\u52d5\u304d\u3092\u691c\u8a0e\u3057\u3001\u30b9\u30b3\u30a2\u306b\u5927\u304d\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u3053\u3068\u306a\u304f\u3001\u3069\u306e\u3088\u3046\u306b\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u300c\u30a2\u30f3\u30c9\u30a5\u300d\u6a5f\u80fd\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u30b3\u30df\u30c3\u30c8\u30e1\u30f3\u30c8\u306a\u3057\u3067\u5b9f\u9a13\u3067\u304d\u307e\u3059\u304c\u3001\u904e\u5ea6\u306a\u4f7f\u7528\u306f\u907f\u3051\u3066\u304f\u3060\u3055\u3044\u3002 \u300c\u30a2\u30f3\u30c9\u30a5\u300d\u6a5f\u80fd\u306f\u3001\u8907\u6570\u306e\u52d5\u304d\u3092\u8a66\u3059\u3053\u3068\u306b\u3088\u3063\u3066\u3001\u8003\u3048\u3046\u308b\u30ab\u30fc\u30c9\u306e\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u5206\u6790\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u304c\u3001\u5fc5\u8981\u4ee5\u4e0a\u306b\u4f7f\u3046\u3068\u52b9\u7387\u7684\u306a\u30d7\u30ec\u30a4\u306b\u306a\u308a\u307e\u305b\u3093\u3002\u78ba\u304b\u306a\u30c6\u30af\u30cb\u30c3\u30af\u306f\u3001\u8907\u6570\u306e\u53ef\u80fd\u6027\u304c\u3042\u308b\u5834\u5408\u306b\u3001\u8907\u6570\u306e\u5834\u6240\u3078\u306e\u79fb\u52d5\u3092\u30c6\u30b9\u30c8\u3059\u308b\u305f\u3081\u306b\u3001\u300c\u30a2\u30f3\u30c9\u30a5\u300d\u6a5f\u80fd\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u7d4c\u9a13\u8c4a\u5bcc\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u3057\u3066\u3001\u30d0\u30c3\u30af\u30c8\u30e9\u30c3\u30ad\u30f3\u30b0\u306e\u6570\u3092\u6e1b\u3089\u3057\u306a\u304c\u3089\u3001\u6700\u9069\u306a\u89e3\u6c7a\u7b56\u3092\u8a08\u7b97\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\uff1a\u8868\u5f62\u5f0f\u306e\u5217\u306e\u30ab\u30fc\u30c9\u30922\u3064\u4ee5\u4e0a\u7570\u306a\u308b\u5834\u6240\u306b\u79fb\u52d5\u3067\u304d\u308b\u5834\u5408\u3001\u300c\u30a2\u30f3\u30c9\u30a5\u300d\u3092\u4f7f\u7528\u3057\u3066\u5404\u5834\u6240\u3092\u30c6\u30b9\u30c8\u3057\u3001\u6700\u3082\u5229\u76ca\u306e\u3042\u308b\u5834\u6240\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30b2\u30fc\u30e0\u306e\u30d0\u30ea\u30a8\u30fc\u30b7\u30e7\u30f3\uff1a\u5171\u901a\u306eGoogle Solitaire\u30d0\u30ea\u30a8\u30fc\u30b7\u30e7\u30f3\uff08\u4f8b\u3048\u3070\u3001\u30af\u30ed\u30f3\u30c0\u30a4\u30af\uff081\u679a\u5f15\u304d vs 3\u679a\u5f15\u304d\uff09\uff09\u306f\u3001\u4e92\u3044\u306b\u3069\u306e\u3088\u3046\u306b\u7570\u306a\u308a\u307e\u3059\u304b\uff1f", "answer": "\u4e3b\u306a\u9055\u3044\u306f\u30b9\u30c8\u30c3\u30af\u306e\u5c71\u304b\u3089\u306e\u5f15\u304f\u679a\u6570\u3067\u3059\u3002\u30af\u30ed\u30f3\u30c0\u30a4\u30af\u306f\u4e00\u5ea6\u306b1\u679a\u306e\u30ab\u30fc\u30c9\u3092\u5f15\u304f\u3053\u3068\u304c\u3067\u304d\u307e\u3059\uff08\u7c21\u5358\uff09\u306e\u306b\u5bfe\u3057\u30013\u679a\u5f15\u304d\u3067\u306f3\u679a\u5f15\u304d\u3001\u305d\u306e\u3046\u30611\u679a\u3060\u3051\u304c\u30d7\u30ec\u30a4\u3067\u304d\u307e\u3059\u3002\u8868\u5f62\u5f0f\u306f\u3001\u516c\u958b\u3055\u308c\u305f\u30ab\u30fc\u30c9\u306e\u7a4d\u307f\u91cd\u306d\u3092\u793a\u3057\u307e\u3059\u3002\u4f8b\uff1a3\u679a\u5f15\u304d\u3067\u3001\u30b9\u30c8\u30c3\u30af\u5c71\u306e\u6700\u4e0a\u90e8\u304b\u3089\u30b9\u30da\u30fc\u30c9\u306e7\u3001\u30cf\u30fc\u30c8\u306e5\u3001\u30af\u30e9\u30d6\u306e9\u3092\u516c\u958b\u3059\u308b\u3068\u3057\u307e\u3059\u3002\u3053\u306e\u5834\u5408\u3001\u8868\u5f62\u5f0f\u306e\u30b7\u30fc\u30b1\u30f3\u30b9\u3067\u30d7\u30ec\u30a4\u3067\u304d\u308b\u306e\u306f\u30af\u30e9\u30d6\u306e9\u3060\u3051\u3067\u3059\u3002\u3069\u306e\u30d0\u30ea\u30a8\u30fc\u30b7\u30e7\u30f3\u3092\u9078\u3076\u304b\u306f\u3001\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u3068\u5e0c\u671b\u3059\u308b\u96e3\u6613\u5ea6\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u30021\u679a\u5f15\u304d\u306e\u6226\u7565\u306f\u3001\u3088\u308a\u4e88\u6e2c\u53ef\u80fd\u306a\u52d5\u304d\u3092\u4f34\u3046\u306e\u306b\u5bfe\u3057\u30013\u679a\u5f15\u304d\u306f\u614e\u91cd\u306a\u30b9\u30c8\u30c3\u30af\u306e\u5c71\u7ba1\u7406\u3092\u5fc5\u8981\u3068\u3057\u307e\u3059\u3002"}, {"question": "Google Solitaire \u306e\u5206\u6790\uff1aGoogle Solitaire \u306e\u30ab\u30fc\u30c9\u306e\u30b7\u30e3\u30c3\u30d5\u30eb\u3068\u914d\u5217\u3092\u5236\u5fa1\u3059\u308b\u57fa\u790e\u3068\u306a\u308b\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u4f55\u3067\u3042\u308a\u3001\u516c\u5e73\u6027\u3092\u3069\u306e\u3088\u3046\u306b\u4fdd\u8a3c\u3057\u307e\u3059\u304b\uff1f", "answer": "Google Solitaire\u306f\u3001\u591a\u304f\u306e\u30c7\u30b8\u30bf\u30eb\u30ab\u30fc\u30c9\u30b2\u30fc\u30e0\u3068\u540c\u69d8\u306b\u3001\u7591\u4f3c\u4e71\u6570\u751f\u6210\u5668\uff08PRNG\uff09\u3092\u4f7f\u7528\u3057\u3066\u30b7\u30e3\u30c3\u30d5\u30eb\u3092\u884c\u3044\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u30e9\u30f3\u30c0\u30e0\u3055\u3092\u6a21\u5023\u3059\u308b\u610f\u56f3\u304c\u3042\u308a\u307e\u3059\u304c\u3001\u6c7a\u5b9a\u8ad6\u7684\u3067\u3059\u3002\u3064\u307e\u308a\u3001\u540c\u3058\u30b7\u30fc\u30c9\u5024\u3092\u4e0e\u3048\u308c\u3070\u3001\u540c\u3058\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u751f\u6210\u3057\u307e\u3059\u3002\u516c\u5e73\u6027\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u8a2d\u8a08\u4e0a\u306e\u8003\u616e\u4e8b\u9805\u306b\u3088\u3063\u3066\u4fdd\u8a3c\u3055\u308c\u307e\u3059\uff1a\u4e88\u6e2c\u3092\u9632\u3050\u306e\u306b\u5341\u5206\u306a\u9577\u3055\u306e\u30b7\u30fc\u30c9\u30ad\u30fc\u3001\u5805\u7262\u306a\u30b7\u30e3\u30c3\u30d5\u30eb\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\uff08\u4f8b\uff1a\u30d5\u30a3\u30c3\u30b7\u30e3\u30fc\u30fb\u30a4\u30a7\u30a4\u30c4\uff09\u3001\u30b2\u30fc\u30e0\u53cd\u5fa9\u7528\u306e\u5b9a\u6570\u30b7\u30fc\u30c9\u3002\u6b63\u78ba\u306a\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u72ec\u81ea\u306e\u6280\u8853\u60c5\u5831\u3067\u3059\u304c\u3001\u4e00\u822c\u7684\u306a\u539f\u5247\u306f\u3001\u30ab\u30fc\u30c9\u3092\u5747\u4e00\u304b\u3064\u4e88\u6e2c\u4e0d\u53ef\u80fd\u306b\u914d\u5e03\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u30c7\u30b8\u30bf\u30eb\u30c9\u30e1\u30a4\u30f3\u3067\u771f\u306e\u30e9\u30f3\u30c0\u30e0\u6027\u3092\u9054\u6210\u3059\u308b\u3053\u3068\u306f\u5b9f\u969b\u4e0a\u4e0d\u53ef\u80fd\u3067\u3059\u3002"}, {"question": "\u30bd\u30ea\u30c6\u30a3\u30a2\u8a2d\u8a08\uff1aGoogle Solitaire\u306e\u8907\u96d1\u3055\u306e\u5206\u6790\u306f\u3001\u4eca\u5f8c\u306e\u30ab\u30fc\u30c9\u30b2\u30fc\u30e0\u307e\u305f\u306f\u305d\u306e\u30c7\u30b8\u30bf\u30eb\u9069\u5fdc\u306e\u305f\u3081\u306e\u30b2\u30fc\u30e0\u30c7\u30b6\u30a4\u30f3\u306e\u8003\u616e\u4e8b\u9805\u3092\u3069\u306e\u3088\u3046\u306b\u60c5\u5831\u63d0\u4f9b\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Google Solitaire\u306e\u6210\u529f\u306f\u3001\u8abf\u6574\u53ef\u80fd\u306a\u8907\u96d1\u3055\u304b\u3089\u751f\u307e\u308c\u307e\u3059\u3002\u30ab\u30fc\u30c9\u30b2\u30fc\u30e0\u306e\u30c7\u30b6\u30a4\u30ca\u30fc\u306f\u3001\u30d7\u30ec\u30a4\u306e\u5bb9\u6613\u3055\u3068\u6226\u7565\u7684\u306a\u6df1\u3055\u306e\u30c8\u30ec\u30fc\u30c9\u30aa\u30d5\u3092\u8003\u616e\u3057\u307e\u3059\u3002\u30bd\u30ea\u30c6\u30a3\u30a2\u306e\u5206\u6790\u306f\u3001\u3053\u308c\u3089\u306e\u8981\u7d20\u3092\u60c5\u5831\u63d0\u4f9b\u3067\u304d\u307e\u3059\u3002\u78ba\u7387\u3001\u7d44\u5408\u305b\u63a2\u7d22\u3001\u8a8d\u77e5\u8ca0\u8377\u3002\u4f8b\uff1a\u6210\u529f\u3057\u305f\u30bd\u30ea\u30c6\u30a3\u30a2\u306f\u3001\u30b7\u30f3\u30d7\u30eb\u3055\u3068\u6e80\u8db3\u3067\u304d\u308b\u30ec\u30d9\u30eb\u306e\u6311\u6226\u3092\u878d\u5408\u3055\u305b\u3066\u3044\u307e\u3059\u3002\u5b66\u3076\u306e\u306f\u7c21\u5358\u3067\u3059\u304c\u3001\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306e\u306f\u96e3\u3057\u3044\u3082\u306e\u3067\u3059\u3002\u5c06\u6765\u306e\u540c\u69d8\u306e\u30ab\u30fc\u30c9\u30b2\u30fc\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u6642\u9593\u306e\u7d4c\u904e\u3068\u3068\u3082\u306b\u30b9\u30ad\u30eb\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u3001\u540c\u69d8\u306e\u8a2d\u8a08\u3092\u63a1\u7528\u3059\u308b\u3053\u3068\u304b\u3089\u6069\u6075\u3092\u53d7\u3051\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u306e\u30d7\u30ec\u30a4\uff1a\u30c7\u30b9\u30af\u30c8\u30c3\u30d7\u30d6\u30e9\u30a6\u30b6\u3068\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u306eGoogle Solitaire\u306e\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u6700\u9069\u5316\u3059\u308b\u3068\u304d\u306b\u3001\u3069\u306e\u3088\u3046\u306a\u8981\u7d20\u3092\u8003\u616e\u3059\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u306e\u30d7\u30ec\u30a4\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u753b\u9762\u30b5\u30a4\u30ba\u3001\u5165\u529b\u65b9\u6cd5\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3068\u3044\u3046\u3044\u304f\u3064\u304b\u306e\u8981\u7d20\u3092\u6ce8\u610f\u6df1\u304f\u691c\u8a0e\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30ec\u30b9\u30dd\u30f3\u30b7\u30d6\u306a\u30c7\u30b6\u30a4\u30f3\u304c\u5fc5\u8981\u3067\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u4e0a\u306e\u30bf\u30c3\u30c1\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u306f\u3001\u30ab\u30fc\u30bd\u30eb\u3068\u306f\u7570\u306a\u308b\u64cd\u4f5c\u3092\u5fc5\u8981\u3068\u3057\u3001\u753b\u9762\u306e\u9055\u3044\u306f\u3001\u4e21\u65b9\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u3067\u306e\u30ab\u30fc\u30c9\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u4f8b\uff1aGoogle Solitaire\u306e\u30c7\u30b9\u30af\u30c8\u30c3\u30d7\u30d0\u30fc\u30b8\u30e7\u30f3\u3067\u306f\u3001\u30c9\u30e9\u30c3\u30b0\u30a2\u30f3\u30c9\u30c9\u30ed\u30c3\u30d7\u306e\u30a2\u30af\u30b7\u30e7\u30f3\u304c\u53ef\u80fd\u3067\u3059\u304c\u3001\u30e2\u30d0\u30a4\u30eb\u30a2\u30d7\u30ea\u3067\u306f\u300c\u30bf\u30c3\u30d7\u30a2\u30f3\u30c9\u30db\u30fc\u30eb\u30c9\u300d\u30b8\u30a7\u30b9\u30c1\u30e3\u30fc\u304c\u5fc5\u8981\u3067\u3059\u3002\u3055\u3089\u306b\u3001\u30e6\u30fc\u30b6\u30fc\u304c\u540c\u3058\u30b2\u30fc\u30e0\u4e2d\u306b\u4e21\u65b9\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u3092\u30d7\u30ec\u30a4\u3067\u304d\u308b\u305f\u3081\u3001\u30c7\u30fc\u30bf\u540c\u671f\u304c\u53ef\u80fd\u3067\u3042\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "Google Solitaire \u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\uff1aGoogle Solitaire \u306b\u306f\u3001\u30ed\u30c3\u30af\u89e3\u9664\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\u3002\u305d\u308c\u3089\u306f\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u30ed\u30c3\u30af\u89e3\u9664\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Google\u306f\u3001\u88fd\u54c1\u306b\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u542b\u3081\u308b\u3053\u3068\u304c\u3088\u304f\u3042\u308a\u307e\u3059\u3002\u300c\u30bd\u30ea\u30c6\u30a3\u30a2\u300d\u3092Google\u691c\u7d22\u30d0\u30fc\u306b\u5165\u529b\u3057\u307e\u3059\u3002\u591a\u304f\u306e\u5834\u5408\u3001\u30a2\u30d7\u30ea\u3068\u306f\u7570\u306a\u308b\u30d7\u30ec\u30a4\u53ef\u80fd\u306a\u30bd\u30ea\u30c6\u30a3\u30a2\u30b2\u30fc\u30e0\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30b9\u30bf\u30f3\u30c9\u30a2\u30ed\u30f3\u30d0\u30fc\u30b8\u30e7\u30f3\u306b\u306f\u3001\u591a\u304f\u306e\u5834\u5408\u3001\u96a0\u3055\u308c\u305f\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8981\u7d20\u3084\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u30b9\u30c1\u30eb\u306e\u3042\u308b\u5909\u5316\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u5171\u901a\u3059\u308b\u30c8\u30ea\u30c3\u30af\u306f\u3001\u30b3\u30f3\u30d1\u30c1\u30b3\u30fc\u30c9\u3092\u30b2\u30fc\u30e0\u4e2d\u306b\u8fc5\u901f\u306b\u5165\u529b\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u30c7\u30d0\u30c3\u30b0\u30e2\u30fc\u30c9\u306b\u30a2\u30af\u30bb\u30b9\u3057\u3066\u52b9\u679c\u306e\u6709\u52b9\u5316\u3092\u4fc3\u3057\u307e\u3059\u3002\u8a2d\u5b9a\u306b\u30c6\u30fc\u30de\u5225\u306e\u30ab\u30fc\u30c9\u30c7\u30c3\u30ad\u304c\u96a0\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u3082\u3042\u308a\u307e\u3059\u3002"}]
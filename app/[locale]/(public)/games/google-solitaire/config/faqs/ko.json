[{"question": "Google Solitaire \uc0ac\uc6a9\ubc95: Google Solitaire \ud45c\uc900 \uac8c\uc784 \uc124\uc815 \ubc0f \ud50c\ub808\uc774\uc758 \uae30\ubcf8 \uaddc\uce59\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Klondike Solitaire\ub77c\uace0\ub3c4 \ud558\ub294 Google Solitaire\ub294 \ud2b9\uc815 \uc21c\uc11c\ub85c \uce74\ub4dc\ub97c \ubc30\uc5f4\ud558\ub294 \uac8c\uc784\uc785\ub2c8\ub2e4. 1\ub2e8\uacc4: \uccab \ubc88\uc9f8 \uc5f4\uc5d0 \uce74\ub4dc 1\uc7a5, \ub450 \ubc88\uc9f8 \uc5f4\uc5d0 2\uc7a5 \ub4f1 \ucd1d 7\uac1c\uc758 \uc5f4\uc5d0 \uce74\ub4dc\ub97c \ub193\uc2b5\ub2c8\ub2e4. 2\ub2e8\uacc4: \uac01 \uc5f4\uc758 \ub9e8 \uc704 \uce74\ub4dc\ub294 \uc55e\uba74\uc774 \ubcf4\uc774\ub3c4\ub85d \ub193\uace0 \ub098\uba38\uc9c0\ub294 \ub4b7\uba74\uc774 \ubcf4\uc774\ub3c4\ub85d \ub193\uc2b5\ub2c8\ub2e4. 3\ub2e8\uacc4: \ub0a8\uc740 \uce74\ub4dc\ub294 \uc2a4\ud1a1 \ub610\ub294 \ub4dc\ub85c\uc6b0 \ub354\ubbf8\ub97c \ud615\uc131\ud569\ub2c8\ub2e4. \uc8fc\uc694 \ubaa9\ud45c\ub294 \ubaa8\ub4e0 \uce74\ub4dc\ub97c \uc5d0\uc774\uc2a4\uc5d0\uc11c \ud0b9\uae4c\uc9c0 \uac19\uc740 \ubb34\ub2ac\ub85c \uc313\uc544 \uc62c\ub9ac\ub294 \uae30\ucd08 \ub354\ubbf8\ub85c \uc62e\uae30\ub294 \uac83\uc785\ub2c8\ub2e4. \uc5f4 \uc0ac\uc774\uc5d0\uc11c \uce74\ub4dc\ub97c \uc774\ub3d9\ud558\uc5ec \ubc88\uac08\uc544 \uac00\uba70 \uc0c9\uae54\uc744 \ub9de\ucdb0 \uc313\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4(\uc608: \uac80\uc740\uc0c9 \ud0b9 \uc704\uc5d0 \ube68\uac04\uc0c9 \ud038). \ube48 \uc5f4\uc740 \ud0b9 \ub610\ub294 \ud0b9\uc73c\ub85c \uc2dc\uc791\ud558\ub294 \uc2dc\ud000\uc2a4\ub85c \ucc44\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac04\ub2e8\ud55c \uc608\ub85c, \ud0dc\ube14\ub85c\uc5d0\uc11c \ube68\uac04\uc0c9 6\uc744 \uac80\uc740\uc0c9 7\ub85c \uc774\ub3d9\ud558\ub294 \uac83\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub294 \uc544\ub798 \uc228\uaca8\uc9c4 \uce74\ub4dc\ub97c \ub4dc\ub7ec\ub0b4\ub294 \uae30\ubcf8\uc801\uc778 \uc6c0\uc9c1\uc784\uc785\ub2c8\ub2e4. \uc2a4\ud1a1 \ub354\ubbf8\ub294 \ud50c\ub808\uc774\ud558\ub294 \ubcc0\ud615\uc5d0 \ub530\ub77c \ud55c \ubc88\uc5d0 \ud55c \uc7a5 \ub610\ub294 \uc138 \uc7a5\uc529 \ub4a4\uc9d1\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Solitaire \uc804\ub7b5: Google Solitaire\uc5d0\uc11c \uc5d0\uc774\uc2a4\uc640 \ud0b9\uc774 \uc65c \uadf8\ub807\uac8c \uc911\uc694\ud558\uba70, \uac8c\uc784 \ucd08\ubc18\uc5d0 \uc5d0\uc774\uc2a4\uc640 \ud0b9\uc744 \ub4dc\ub7ec\ub0b4\ub294 \uac83\uc744 \uc5b4\ub5bb\uac8c \uc6b0\uc120\uc2dc\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\uc5d0\uc774\uc2a4\uc640 \ud0b9\uc740 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc5d0\uc774\uc2a4\ub294 \uae30\ucd08 \ub354\ubbf8\ub97c \uc2dc\uc791\ud558\uace0, \ud0b9\uc740 \ube48 \ud0dc\ube14\ub85c \uc5f4\uc744 \ucc44\uc6cc \uc804\ub7b5\uc801 \uc6c0\uc9c1\uc784\uc744 \uc704\ud55c \uae30\ud68c\ub97c \ub9cc\ub4ed\ub2c8\ub2e4. \ube4c\ub4dc \uac00\ub2a5\ud55c \uae30\ucd08 \uc2ac\ub86f\uc744 \uc5f4\uace0 \ud0dc\ube14\ub85c\uc5d0 \uacf5\uac04\uc744 \ub9cc\ub4e4\uae30 \uc704\ud574 \ucd08\ubc18\uc5d0 \uc5d0\uc774\uc2a4\uc640 \ud0b9\uc744 \ub4dc\ub7ec\ub0b4\ub294 \uac83\uc744 \uc6b0\uc120\uc2dc\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ud0b9\uc744 \ubc1c\uacac\ud558\uba74 \uc989\uc2dc \ube48 \uc5f4\ub85c \uc774\ub3d9\ud558\uc2ed\uc2dc\uc624. \uc5d0\uc774\uc2a4\ub85c \uae30\ucd08 \ub354\ubbf8\ub97c \uc5f4\uba74 \ud574\ub2f9 \ubb34\ub2ac \uc2a4\ud0dd\uc744 \uc313\uae30 \uc2dc\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc5d0\uc774\uc2a4\uc640 \ud0b9\uc740 \uc8fc\ucda7\ub3cc\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc5d0\uc774\uc2a4\uc640 \ud0b9 \uc5c6\uc774\ub294 \uac74\uc124\uc744 \uc2dc\uc791\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ub2e4\uc74c \ube44\uad50 \ud45c\ub294 \uc5d0\uc774\uc2a4\uc640 \ud0b9\uc758 \uc911\uc694\uc131\uc744 \ub354 \uc790\uc138\ud788 \uc124\uba85\ud569\ub2c8\ub2e4. \uc5d0\uc774\uc2a4 - \uae30\ucd08 \uc2dc\uc791\uc810; \ud0b9 - \ud0dc\ube14\ub85c \uc7ac\uc124\uc815, \uce74\ub4dc \uc774\ub3d9 \uac00\ub2a5."}, {"question": "Google Solitaire \uc810\uc218: Google Solitaire\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ubb34\uc5c7\uc774\uba70, \uac01 \uac8c\uc784\uc5d0\uc11c \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "Google Solitaire\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \uce74\ub4dc\ub97c \uae30\ucd08\ub85c \uc774\ub3d9\ud558\uac70\ub098, \ud0dc\ube14\ub85c\uc5d0\uc11c \ub4b7\uba74\uc774 \ubcf4\uc774\uc9c0 \uc54a\ub294 \uce74\ub4dc\ub97c \ub4dc\ub7ec\ub0b4\uac70\ub098, \uac8c\uc784\uc744 \uc644\ub8cc\ud558\ub294 \ub4f1\uc758 \uc6c0\uc9c1\uc784\uc5d0 \ub300\ud574 \uc810\uc218\ub97c \ubd80\uc5ec\ud569\ub2c8\ub2e4. \ub2e4\uc74c\uc740 \uc608\uc2dc\uc785\ub2c8\ub2e4. \uce74\ub4dc\ub97c \uae30\ucd08\ub85c \uc774\ub3d9\ud558\uba74 10\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uace0, \ub4b7\uba74\uc774 \ubcf4\uc774\uc9c0 \uc54a\ub294 \uce74\ub4dc\ub97c \ub4a4\uc9d1\uc73c\uba74 5\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uae30\ucd08\uc5d0\uc11c \ud0dc\ube14\ub85c\ub85c \uce74\ub4dc\ub97c \ub418\ub3cc\ub9ac\uba74 \ud398\ub110\ud2f0\uac00 \uc904\uc5b4\ub4ed\ub2c8\ub2e4. \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud558\ub824\uba74 \ud0dc\ube14\ub85c\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uc815\ub9ac\ud558\uace0 \uc2e4\ud589 \ucde8\uc18c \ubc84\ud2bc\uc744 \ucd5c\uc18c\ud654\ud558\ub294 \uc804\ub7b5\uc801 \ud50c\ub808\uc774\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ube60\ub978 \uc2b9\ub9ac\ub97c \ubaa9\ud45c\ub85c \ud558\uace0 \ud3d0\uae30 \ub354\ubbf8\ub97c \ub108\ubb34 \ub9ce\uc774 \uc21c\ud658\uc2dc\ud0a4\ub294 \uc6c0\uc9c1\uc784\uc744 \ucd5c\uc18c\ud654\ud558\uc2ed\uc2dc\uc624. \uac8c\uc784\uc744 \ube60\ub974\uac8c \uc644\ub8cc\ud558\uba74 \ubcf4\ub108\uc2a4 \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc6c0\uc9c1\uc784\uc774 \uc801\uc744\uc218\ub85d \ubcf4\ub108\uc2a4\uac00 \ucee4\uc9d1\ub2c8\ub2e4!"}, {"question": "\uace0\uae09 \uae30\uc220: \uc219\ub828\ub41c Google Solitaire \ud50c\ub808\uc774\uc5b4\uac00 \uac8c\uc784 \uc2e4\ub825\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uae30 \uc704\ud574 '\uc2a4\ud1a1 \ub354\ubbf8 \uad00\ub9ac' \ubc0f '\ud0dc\ube14\ub85c \uc870\uc791'\uacfc \uac19\uc740 \uace0\uae09 \uc804\ub7b5\uc744 \uc219\ub2ec\ud574\uc57c \ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc2a4\ud1a1 \ub354\ubbf8 \uad00\ub9ac \ubc0f \ud0dc\ube14\ub85c \uc870\uc791\uc744 \uc219\ub2ec\ud558\uc2ed\uc2dc\uc624. \uc2a4\ud1a1 \ub354\ubbf8 \uad00\ub9ac\ub294 \uc2a4\ud1a1\uc5d0 \uc788\ub294 \uce74\ub4dc \uc21c\uc11c\ub97c \uc774\ud574\ud558\uace0 \ub4dc\ub85c\uc6b0 \uc2dc\uae30\ub97c \uc804\ub7b5\uc801\uc73c\ub85c \uacc4\ud68d\ud558\ub294 \uac83\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \ud0dc\ube14\ub85c \uc870\uc791\uc740 \uc228\uaca8\uc9c4 \uce74\ub4dc\ub97c \ub4dc\ub7ec\ub0b4\uace0 \uc720\ub9ac\ud55c \uc2dc\ud000\uc2a4\ub97c \ub9cc\ub4e4\uae30 \uc704\ud574 \uce74\ub4dc \uc5f4\uc744 \uc774\ub3d9\ud558\ub294 \ub370 \uc911\uc810\uc744 \ub461\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac8c\uc784 \uc9c4\ud589\uc5d0 \ub530\ub77c \ub354 \ub9ce\uc740 \uae30\ud68c\ub97c \uc5f4\uc5b4\uc8fc\ubbc0\ub85c \uc804\ub7b5\uc801\uc73c\ub85c \uc5f4\uc5d0\uc11c \uce74\ub4dc\ub97c \ub4dc\ub7ec\ub0b4\ub294 \uac83\uc744 \uc6b0\uc120\uc2dc\ud558\uc2ed\uc2dc\uc624. 1\ub2e8\uacc4: \ucc28\ub2e8\ub41c \uce74\ub4dc\uc5d0 \ub300\ud574 \ud0dc\ube14\ub85c\ub97c \ubd84\uc11d\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \uae30\ucd08 \uad6c\ucd95\uc5d0 \ud544\uc694\ud55c \ud2b9\uc815 \uce74\ub4dc\ub97c \ud574\uc81c\ud558\uae30 \uc704\ud55c \uc6c0\uc9c1\uc784\uc744 \uacc4\ud68d\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \ud0dc\ube14\ub85c \ubc30\uc5f4\uc744 \ubcf4\uc644\ud558\ub294 \ub4dc\ub7ec\ub09c \uce74\ub4dc\ub97c \ucd5c\ub300\ud654\ud558\uae30 \uc704\ud574 \uc2a4\ud1a1 \ub354\ubbf8 \ub4dc\ub85c\uc6b0 \uc2dc\uac04\uc744 \uc870\uc815\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uace0\uae09 \uae30\uc220\uc740 \uc2b9\ub960\uc744 \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud6a8\uc728\uc131: Google Solitaire\uc5d0\uc11c '\uc2e4\ud589 \ucde8\uc18c' \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc810\uc218\uc5d0 \ud070 \uc601\ud5a5\uc744 \uc8fc\uc9c0 \uc54a\uace0 \ub2e4\uc591\ud55c \uc774\ub3d9 \uc635\uc158\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \ud0d0\uc0c9\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "'\uc2e4\ud589 \ucde8\uc18c' \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uba74 \ubd80\ub2f4 \uc5c6\uc774 \uc2e4\ud5d8\ud560 \uc218 \uc788\uc9c0\ub9cc \uacfc\uc6a9\uc740 \ud53c\ud558\uc2ed\uc2dc\uc624. '\uc2e4\ud589 \ucde8\uc18c'\ub97c \uc0ac\uc6a9\ud558\uba74 \uc5ec\ub7ec \uc6c0\uc9c1\uc784\uc744 \uc2dc\ub3c4\ud558\uc5ec \uac00\ub2a5\ud55c \uce74\ub4dc \uc2dc\ud000\uc2a4\ub97c \ubd84\uc11d\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uacfc\ub3c4\ud55c \uc0ac\uc6a9\uc740 \ube44\ud6a8\uc728\uc801\uc778 \ud50c\ub808\uc774\ub85c \uc774\uc5b4\uc9c8 \uc218 \uc788\uc73c\ubbc0\ub85c \ud544\uc694\ud55c \uacbd\uc6b0\uc5d0\ub9cc \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \uacac\uace0\ud55c \uae30\uc220\uc740 \uc5ec\ub7ec \uac00\ub2a5\uc131\uc774 \uc788\ub294 \uacbd\uc6b0 '\uc2e4\ud589 \ucde8\uc18c'\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub2e4\uc591\ud55c \uc774\ub3d9 \uc635\uc158\uc744 \ud0d0\uc0c9\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\ub85c\uc11c \ucd5c\uc18c\ud55c\uc758 \ubc31\ud2b8\ub798\ud0b9\uc73c\ub85c \ucd5c\uc0c1\uc758 \uc194\ub8e8\uc158\uc744 \uacc4\uc0b0\ud558\ub294 \ub370 \uc775\uc219\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608: \ud0dc\ube14\ub85c \ub354\ubbf8\uc5d0\uc11c \uce74\ub4dc\ub97c \ub450 \uac1c \uc774\uc0c1\uc758 \ub2e4\ub978 \uc704\uce58\ub85c \uc774\ub3d9\ud560 \uae30\ud68c\uac00 \uc788\ub294 \uacbd\uc6b0 '\uc2e4\ud589 \ucde8\uc18c'\ub97c \uc0ac\uc6a9\ud558\uc5ec \uac01 \uc704\uce58\ub97c \ud14c\uc2a4\ud2b8\ud55c \ub2e4\uc74c \uac00\uc7a5 \ud070 \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\ub294 \uc704\uce58\ub97c \uc120\ud0dd\ud558\uc2ed\uc2dc\uc624."}, {"question": "\uac8c\uc784 \ubcc0\ud615: Klondike(1\uc7a5 \ub4dc\ub85c\uc6b0 \ub300 3\uc7a5 \ub4dc\ub85c\uc6b0)\uc640 \uac19\uc740 \uc77c\ubc18\uc801\uc778 Google Solitaire \ubcc0\ud615\uc740 \uc11c\ub85c \uc5b4\ub5bb\uac8c \ub2e4\ub985\ub2c8\uae4c?", "answer": "\uc8fc\uc694 \ucc28\uc774\uc810\uc740 \uc2a4\ud1a1 \ub354\ubbf8 \ub4dc\ub85c\uc6b0\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. Klondike\ub294 \ud55c \ubc88\uc5d0 \ud55c \uc7a5\uc758 \uce74\ub4dc\ub97c \ub4dc\ub85c\uc6b0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4(\ub354 \uc26c\uc6c0). \ubc18\uba74 \uc138 \uc7a5\uc758 \uce74\ub4dc\ub97c \ub4dc\ub85c\uc6b0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4(\ub354 \uc5b4\ub824\uc6c0). 1\uc7a5 \ub4dc\ub85c\uc6b0\ub294 \uc2a4\ud1a1\uc5d0\uc11c \ud3d0\uae30 \ub354\ubbf8\ub85c \uce74\ub4dc \ud55c \uc7a5\uc744 \ucc98\ub9ac\ud569\ub2c8\ub2e4. 3\uc7a5 \ub4dc\ub85c\uc6b0\ub294 \uc138 \uc7a5\uc744 \ucc98\ub9ac\ud558\uba70 \ub9e8 \uc704 \uce74\ub4dc\ub9cc \ud50c\ub808\uc774\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud0dc\ube14\ub85c\ub294 \ub4dc\ub7ec\ub09c \uce74\ub4dc \uc2a4\ud0dd\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4. \uc608: 3\uc7a5 \ub4dc\ub85c\uc6b0\uc5d0\uc11c \uc2a4\ud1a1 \ub354\ubbf8 \ub9e8 \uc704\uc5d0\uc11c \uc2a4\ud398\uc774\ub4dc 7, \ud558\ud2b8 5, \ud074\ub7fd 9\ub97c \ub4dc\ub7ec\ub0b8\ub2e4\uace0 \uac00\uc815\ud569\ub2c8\ub2e4. \uc774 \uacbd\uc6b0 \ud0dc\ube14\ub85c \uc2dc\ud000\uc2a4\uc5d0\uc11c \ud074\ub7fd 9\ub9cc \ud50c\ub808\uc774\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc62c\ubc14\ub978 \ubcc0\ud615\uc744 \uc120\ud0dd\ud558\ub294 \uac83\uc740 \uae30\uc220 \uc218\uc900\uacfc \uc6d0\ud558\ub294 \ub09c\uc774\ub3c4\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. 1\uc7a5 \ub4dc\ub85c\uc6b0 \uc804\ub7b5\uc740 \ub354 \uc608\uce21 \uac00\ub2a5\ud55c \uc6c0\uc9c1\uc784\uc744 \ud3ec\ud568\ud558\ub294 \ubc18\uba74 3\uc7a5 \ub4dc\ub85c\uc6b0\ub294 \uc2e0\uc911\ud55c \uc2a4\ud1a1 \ub354\ubbf8 \uad00\ub9ac\uac00 \ud544\uc694\ud569\ub2c8\ub2e4."}, {"question": "Google Solitaire \ubd84\uc11d: Google Solitaire\uc5d0\uc11c \uce74\ub4dc \uc11e\uae30 \ubc0f \ucc98\ub9ac \ubc29\uc2dd\uc744 \uc81c\uc5b4\ud558\ub294 \uae30\ubcf8 \uc54c\uace0\ub9ac\uc998\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \uacf5\uc815\uc131\uc744 \ubcf4\uc7a5\ud569\ub2c8\uae4c?", "answer": "\ub9ce\uc740 \ub514\uc9c0\ud138 \uce74\ub4dc \uac8c\uc784\uacfc \ub9c8\ucc2c\uac00\uc9c0\ub85c Google Solitaire\ub294 \uc11e\uae30\ub97c \uc704\ud574 \uc758\uc0ac \ub09c\uc218 \uc0dd\uc131\uae30(PRNG)\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc54c\uace0\ub9ac\uc998\uc740 \ubb34\uc791\uc704\uc131\uc744 \uc2dc\ubbac\ub808\uc774\uc158\ud558\ub294 \uac83\uc744 \ubaa9\ud45c\ub85c \ud558\uc9c0\ub9cc \uacb0\uc815\uc801\uc785\ub2c8\ub2e4. \uc989, \ub3d9\uc77c\ud55c \uc2dc\ub4dc \uac12\uc774 \uc8fc\uc5b4\uc9c0\uba74 \ub3d9\uc77c\ud55c \uc2dc\ud000\uc2a4\ub97c \uc0dd\uc131\ud569\ub2c8\ub2e4. \uacf5\uc815\uc131\uc740 \uc608\uce21\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud55c \ucda9\ubd84\ud788 \uae34 \uc2dc\ub4dc \ud0a4, \uac15\ub825\ud55c \uc11e\uae30 \uc54c\uace0\ub9ac\uc998(\uc608: Fisher-Yates) \ubc0f \uac8c\uc784 \ubc18\ubcf5\uc744 \uc704\ud55c \uc77c\uc815\ud55c \uc2dc\ub529\uacfc \uac19\uc740 \uc5ec\ub7ec \uc124\uacc4 \uace0\ub824 \uc0ac\ud56d\uc744 \ud1b5\ud574 \ubcf4\uc7a5\ub429\ub2c8\ub2e4. \uc815\ud655\ud55c \uc54c\uace0\ub9ac\uc998\uc740 \ub3c5\uc810\uc801\uc774\uc9c0\ub9cc \uc77c\ubc18\uc801\uc778 \uc6d0\uce59\uc740 \uce74\ub4dc\ub97c \uade0\ub4f1\ud558\uace0 \uc608\uce21\ud560 \uc218 \uc5c6\uac8c \ubc30\ud3ec\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \ub514\uc9c0\ud138 \uc601\uc5ed\uc5d0\uc11c \uc9c4\uc815\ud55c \ubb34\uc791\uc704\uc131\uc740 \uc0ac\uc2e4\uc0c1 \ubd88\uac00\ub2a5\ud558\ub2e4\ub294 \uc810\uc5d0 \uc720\uc758\ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4."}, {"question": "Solitaire \ub514\uc790\uc778: Google Solitaire \ubcf5\uc7a1\uc131 \ubd84\uc11d\uc774 \ud5a5\ud6c4 \uce74\ub4dc \uac8c\uc784 \ub610\ub294 \ub514\uc9c0\ud138 \uc801\uc751\uc5d0 \ub300\ud55c \uac8c\uc784 \ub514\uc790\uc778 \uace0\ub824 \uc0ac\ud56d\uc744 \uc5b4\ub5bb\uac8c \uc54c\ub824\uc904 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Google Solitaire\uc758 \uc131\uacf5\uc740 \uc870\uc815 \uac00\ub2a5\ud55c \ubcf5\uc7a1\uc131\uc5d0\uc11c \ube44\ub86f\ub429\ub2c8\ub2e4. \uce74\ub4dc \uac8c\uc784 \ub514\uc790\uc774\ub108\ub294 \ud50c\ub808\uc774 \uc6a9\uc774\uc131\uacfc \uc804\ub7b5\uc801 \uae4a\uc774 \uc0ac\uc774\uc758 \uade0\ud615\uc744 \uace0\ub824\ud569\ub2c8\ub2e4. Solitaire \ubd84\uc11d\uc740 \ud655\ub960, \uc870\ud569 \uac80\uc0c9 \ubc0f \uc778\uc9c0 \ubd80\ud558\uc640 \uac19\uc740 \uc774\ub7ec\ud55c \uc694\uc18c\ub97c \uc54c\ub824\uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608: \uc131\uacf5\uc801\uc778 Solitaire\ub294 \ub2e8\uc21c\uc131\uacfc \ub9cc\uc871\uc2a4\ub7ec\uc6b4 \uc218\uc900\uc758 \ub3c4\uc804\uc744 \uacb0\ud569\ud569\ub2c8\ub2e4. \ubc30\uc6b0\uae30\ub294 \uc27d\uc9c0\ub9cc \ub9c8\uc2a4\ud130\ud558\uae30\ub294 \uc5b4\ub835\uc2b5\ub2c8\ub2e4. \ud5a5\ud6c4 \uc720\uc0ac\ud55c \uce74\ub4dc \uac8c\uc784\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc2dc\uac04\uc774 \uc9c0\ub0a8\uc5d0 \ub530\ub77c \uae30\uc220\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \uc720\uc0ac\ud55c \ub514\uc790\uc778\uc744 \ucc44\ud0dd\ud568\uc73c\ub85c\uc368 \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774: \ub370\uc2a4\ud06c\ud1b1 \ube0c\ub77c\uc6b0\uc800\uc640 \ubaa8\ubc14\uc77c \uc7a5\uce58\uc5d0\uc11c \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774\ub97c \uc704\ud574 Google Solitaire\ub97c \ucd5c\uc801\ud654\ud560 \ub54c \uace0\ub824\ud574\uc57c \ud560 \uc694\uc18c\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774\ub97c \uc704\ud574 Solitaire\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc8fc\ub85c \ud654\uba74 \ud06c\uae30, \uc785\ub825 \ubc29\ubc95 \ubc0f \uc131\ub2a5\uacfc \uac19\uc740 \uc5ec\ub7ec \uc694\uc18c\ub97c \uc2e0\uc911\ud558\uac8c \uace0\ub824\ud574\uc57c \ud569\ub2c8\ub2e4. \ubc18\uc751\ud615 \ub514\uc790\uc778\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ubaa8\ubc14\uc77c\uc758 \ud130\uce58 \ucee8\ud2b8\ub864\uc740 \ucee4\uc11c\uc640 \ub2e4\ub978 \uc0c1\ud638 \uc791\uc6a9\uc774 \ud544\uc694\ud558\uba70 \ud654\uba74 \ubd88\uc77c\uce58\ub294 \ub450 \ubc84\uc804 \ubaa8\ub450\uc5d0\uc11c \uce74\ub4dc \ub808\uc774\uc544\uc6c3\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608: Google Solitaire\uc758 \ub370\uc2a4\ud06c\ud1b1 \ubc84\uc804\uc5d0\uc11c\ub294 \ub4dc\ub798\uadf8 \uc564 \ub4dc\ub86d \uc791\uc5c5\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc9c0\ub9cc \ubaa8\ubc14\uc77c \uc571\uc5d0\uc11c\ub294 '\ud0ed \uc564 \ud640\ub4dc' \uc81c\uc2a4\ucc98\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ub610\ud55c \uc0ac\uc6a9\uc790\uac00 \ub3d9\uc77c\ud55c \uac8c\uc784 \uc911\uc5d0 \ub450 \ubc84\uc804\uc744 \ubaa8\ub450 \ud50c\ub808\uc774\ud560 \uc218 \uc788\uc73c\ubbc0\ub85c \ub370\uc774\ud130 \ub3d9\uae30\ud654\ub97c \ud5c8\uc6a9\ud574\uc57c \ud569\ub2c8\ub2e4."}, {"question": "Google Solitaire \uc774\uc2a4\ud130 \uc5d0\uadf8: Google Solitaire \ub0b4\uc5d0\uc11c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\uae4c? \uc788\ub2e4\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "Google\uc740 \uc885\uc885 \uc81c\ud488\uc5d0 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ud3ec\ud568\ud569\ub2c8\ub2e4. Google \uac80\uc0c9 \ucc3d\uc5d0 'Solitaire'\ub97c \uc785\ub825\ud558\uc2ed\uc2dc\uc624. \ub9ce\uc740 \uacbd\uc6b0 \uc571\uacfc \ub2e4\ub978 \ud50c\ub808\uc774 \uac00\ub2a5\ud55c Solitaire \uac8c\uc784\uc774 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ub3c5\ub9bd \uc2e4\ud589\ud615 \ubc84\uc804\uc5d0\ub294 \uc228\uaca8\uc9c4 \uadf8\ub798\ud53d \ud130\uce58 \ub610\ub294 \uac8c\uc784 \ud50c\ub808\uc774 \ubbf8\ud559\uc758 \uc791\uc740 \ubcc0\uacbd \uc0ac\ud56d\uc774 \ud3ec\ud568\ub418\uc5b4 \uc788\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc2b5\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc778 \ud2b8\ub9ad \uc911 \ud558\ub098\ub294 \ub514\ubc84\uae45 \ubaa8\ub4dc\uc5d0 \uc561\uc138\uc2a4\ud558\uc5ec \ud6a8\uacfc\ub97c \ud65c\uc131\ud654\ud558\uae30 \uc704\ud574 \ud50c\ub808\uc774\ud558\ub294 \ub3d9\uc548 \ucf54\ub098\ubbf8 \ucf54\ub4dc\ub97c \ube60\ub974\uac8c \uc785\ub825\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc124\uc815\uc5d0 \uc228\uaca8\uc9c4 \ud14c\ub9c8 \uce74\ub4dc \ub371\uc774 \uc788\uc744 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4."}]
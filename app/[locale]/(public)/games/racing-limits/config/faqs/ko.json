[{"question": "\ub808\uc774\uc2f1 \ud55c\uacc4\uc5d0\uc11c \ub4dc\ub9ac\ud504\ud2b8\ub97c \uc5b4\ub5bb\uac8c \uc218\ud589\ud558\uba70, \ucd08\ubcf4\uc790\uc5d0\uac8c \uc65c \uc911\uc694\ud55c\uac00\uc694?", "answer": "\ub808\uc774\uc2f1 \ud55c\uacc4\uc5d0\uc11c \ub4dc\ub9ac\ud504\ud2b8\ub294 \ucf54\ub108\ub97c \ub3cc\uba74\uc11c \uc18d\ub3c4\ub97c \uc720\uc9c0\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \ub4dc\ub9ac\ud504\ud2b8\ud558\ub824\uba74 \ud68c\uc804\ud558\ub294 \ub3d9\uc548 \ub4dc\ub9ac\ud504\ud2b8 \ubc84\ud2bc\uc744 \ub204\ub974\uace0 \uacc4\uc18d \ub204\ub974\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\uc2dc\ud2f0 \uc11c\ud0b7' \ud2b8\ub799\uc5d0\uc11c \ub0a0\uce74\ub85c\uc6b4 U\ud134\uc744 \ub4dc\ub9ac\ud504\ud2b8\ud558\uba74 \uadc0\uc911\ud55c \uc2dc\uac04\uc744 \uc808\uc57d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uae30\uc220\uc740 \ucd08\ubcf4\uc790\uc5d0\uac8c \uc18d\ub3c4 \uc190\uc2e4\uc744 \uc904\uc774\uace0 \ucf54\ub108\ub9c1 \ud6a8\uc728\uc744 \ub192\uc5ec\uc90d\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ub4dc\ub9ac\ud504\ud2b8\ub294 \ud53c\uaca8 \uc2a4\ucf00\uc774\ud130\uac00 \ud68c\uc804\ud558\uba74\uc11c  momentum\uc744 \uc720\uc9c0\ud558\ub4ef\uc774, \uc870\uc808\ub41c \ubbf8\ub044\ub7ec\uc9d0\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ub808\uc774\uc2f1 \ud55c\uacc4\uc5d0\uc11c '\uc2a4\ud3ec\uce20'\uc640 '\ub7a0\ub9ac' \uc790\ub3d9\ucc28 \ud074\ub798\uc2a4\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub808\uc774\uc2f1 \ud55c\uacc4\uc5d0\uc11c '\uc2a4\ud3ec\uce20' \ud074\ub798\uc2a4\ub294 \ub9e4\ub044\ub7ec\uc6b4 \ud45c\uba74\uc744 \uac00\uc9c4 \uace0\uc18d \ud2b8\ub799\uc5d0 \uc801\ud569\ud558\uac8c \uc124\uacc4\ub418\uc5b4 \uac00\uc18d\ub3c4\uc640 \ucd5c\uace0 \uc18d\ub3c4\uac00 \ud5a5\uc0c1\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ubc18\uba74\uc5d0 '\ub7a0\ub9ac' \ud074\ub798\uc2a4\ub294 \ud5d8\ub85c\uc5d0\uc11c \ud578\ub4e4\ub9c1 \ubc0f \ud2b8\ub799\uc158\uc774 \ud5a5\uc0c1\ub418\uc5b4 \ub6f0\uc5b4\ub0a9\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc0b0\uc545 \uace0\uac1c' \ud2b8\ub799\uc5d0\uc11c \ub7a0\ub9ac \uc790\ub3d9\ucc28\ub97c \uc0ac\uc6a9\ud558\uba74 \uc790\uac08 \uad6c\uac04\uc5d0\uc11c \uc81c\uc5b4\uac00 \ub354\uc6b1 \uc6a9\uc774\ud569\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \uc2a4\ud3ec\uce20 \ud074\ub798\uc2a4 - \uac00\uc18d\ub3c4: \ub192\uc74c, \ucd5c\uace0 \uc18d\ub3c4: \ub9e4\uc6b0 \ub192\uc74c, \ud578\ub4e4\ub9c1: \ubcf4\ud1b5; \ub7a0\ub9ac \ud074\ub798\uc2a4 - \uac00\uc18d\ub3c4: \ubcf4\ud1b5, \ucd5c\uace0 \uc18d\ub3c4: \ub192\uc74c, \ud578\ub4e4\ub9c1: \ub9e4\uc6b0 \ub192\uc74c]"}, {"question": "\ub808\uc774\uc2f1 \ud55c\uacc4\uc5d0\uc11c \ud0c0\uc774\uc5b4 \uc120\ud0dd\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc131\ub2a5\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ub808\uc774\uc2f1 \ud55c\uacc4\uc5d0\uc11c \ud0c0\uc774\uc5b4 \uc120\ud0dd\uc740 \uadf8\ub9bd\uacfc \ud578\ub4e4\ub9c1\uc5d0 \ud070 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc0ac\ub9c9 \uc9c8\uc8fc' \ud2b8\ub799\uc5d0\uc11c '\uc18c\ud504\ud2b8' \ud0c0\uc774\uc5b4\ub97c \uc0ac\uc6a9\ud558\uba74 \ubaa8\ub798 \ud45c\uba74\uc5d0\uc11c \uadf8\ub9bd\uc774 \ud5a5\uc0c1\ub418\uc5b4 \ucf54\ub108\ub9c1 \ub2a5\ub825\uc774 \ud5a5\uc0c1\ub429\ub2c8\ub2e4. \ubc18\ub300\ub85c '\ud558\ub4dc' \ud0c0\uc774\uc5b4\ub294 \ub0b4\uad6c\uc131\uc774 \ub192\uc9c0\ub9cc \uadf8\ub9bd\uc774 \ub0ae\uc2b5\ub2c8\ub2e4. [\uc5ec\ub7ec \uc635\uc158 \ube44\uad50: \uc18c\ud504\ud2b8 \ud0c0\uc774\uc5b4 - \uadf8\ub9bd: \ub192\uc74c, \ub0b4\uad6c\uc131: \ub0ae\uc74c; \ud558\ub4dc \ud0c0\uc774\uc5b4 - \uadf8\ub9bd: \ub0ae\uc74c, \ub0b4\uad6c\uc131: \ub192\uc74c]"}, {"question": "\ub808\uc774\uc2f1 \ud55c\uacc4\uc5d0\uc11c \ucd5c\ub300 \uc18d\ub3c4\ub97c \uc704\ud574 \uae30\uc5b4 \ubcc0\uc18d\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub808\uc774\uc2f1 \ud55c\uacc4\uc5d0\uc11c \uae30\uc5b4 \ubcc0\uc18d\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 RPM \ubc94\uc704\ub97c \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \ucd5c\uc801\uc758 \uc18d\ub3c4\ub97c \uc720\uc9c0\ud558\uae30 \uc704\ud574 \uc801\uc0c9\uc120 \ubc14\ub85c \uc9c1\uc804\uc5d0 \uae30\uc5b4\ub97c \ubcc0\uc18d\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\uc2a4\ud53c\ub4dc\uc6e8\uc774' \ud2b8\ub799\uc5d0\uc11c RPM\uc774 7,000\uc5d0 \ub3c4\ub2ec\ud558\uba74 \ucd9c\ub825 \ubc94\uc704\uc5d0 \uba38\ubb34\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: RPM \uac8c\uc774\uc9c0 \u2192 \uc801\uc0c9\uc120 \uadfc\ucc98 \u2192 \uae30\uc5b4 \ubcc0\uc18d \u2192 \uc18d\ub3c4 \uc720\uc9c0]"}, {"question": "\ub808\uc774\uc2f1 \ud55c\uacc4\uc5d0\uc11c \ucd94\uc6d4 \uc5c6\uc774 \uc0c1\ub300\ub97c \ucd94\uc6d4\ud558\ub294 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub808\uc774\uc2f1 \ud55c\uacc4\uc5d0\uc11c \uc548\uc804\ud558\uac8c \uc0c1\ub300\ub97c \ucd94\uc6d4\ud558\ub824\uba74  slipstream \ud6a8\uacfc\ub97c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \uc0c1\ub300 \ub4a4\ucabd\uc5d0 \ucc28\ub7c9\uc744 \uc815\ud655\ud788 \ubc30\uce58\ud558\uc5ec \uc18d\ub3c4\ub97c \ub192\uc778 \ud6c4 \ucd94\uc6d4\ud560 \uc900\ube44\ub97c \ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uace0\uc18d\ub3c4\ub85c \uc9c8\uc8fc' \ud2b8\ub799\uc5d0\uc11c \uc774 \uae30\uc220\uc740 \uc9c1\uc120 \uad6c\uac04\uc5d0\uc11c \uc5ec\ub7ec \ub300\uc758 \ucc28\ub7c9\uc744 \ucd94\uc6d4\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc790\uc804\uac70 \ud0c0\ub294 \uc0ac\ub78c\uc774 \ub2e4\ub978 \uc790\uc804\uac70 \ub4a4\uc5d0 \uc228\uc5b4 \uacf5\uae30 \uc800\ud56d\uc744 \uc904\uc774\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ub808\uc774\uc2f1 \ud55c\uacc4\uc5d0\uc11c \uc7a5\uac70\ub9ac \uacbd\uc8fc \uc911 \uc5f0\ub8cc \uc18c\ube44\ub97c \uc5b4\ub5bb\uac8c \uad00\ub9ac\ud569\ub2c8\uae4c?", "answer": "\ub808\uc774\uc2f1 \ud55c\uacc4\uc5d0\uc11c \uc5f0\ub8cc\ub97c \uad00\ub9ac\ud558\ub824\uba74 \uac00\uc18d \ud398\ub2ec\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \uac83\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc9c1\uc120 \uad6c\uac04\uc5d0\uc11c \ud480 \uac00\uc18d\uc744 \ud53c\ud558\uc5ec \uc5f0\ub8cc\ub97c \uc808\uc57d\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\uc9c0\uad6c\ub825 \uacbd\uc8fc'\uc5d0\uc11c \uac00\uc18d \ud398\ub2ec\uc744 80%\ub85c \uc720\uc9c0\ud558\uba74 \uc5f0\ub8cc \ubc94\uc704\ub97c \ud06c\uac8c \ub298\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc5ec\ub7ec \uc635\uc158 \ube44\uad50: \ud480 \uac00\uc18d - \uc5f0\ub8cc \uc18c\ube44: \ub192\uc74c, \uc18d\ub3c4: \ucd5c\ub300; 80% \uac00\uc18d - \uc5f0\ub8cc \uc18c\ube44: \ubcf4\ud1b5, \uc18d\ub3c4: \ub192\uc74c]"}, {"question": "\ub808\uc774\uc2f1 \ud55c\uacc4\uc5d0\uc11c \uc228\uaca8\uc9c4 \uc9c0\ub984\uae38\uc740 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub808\uc774\uc2f1 \ud55c\uacc4\uc5d0\ub294 \uacbd\uc7c1\ub825\uc744 \ub192\uc77c \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc9c0\ub984\uae38\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc232\uae38' \ud2b8\ub799\uc5d0\uc11c \ub098\ubb34 \uc0ac\uc774\uc5d0 \ucf54\ub108\ub97c \uc904\uc77c \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uae38\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uae38\uc744 \ucc3e\uc73c\ub824\uba74 \ud0c0\uc774\uc5b4 \uc790\uad6d\uc774\ub098 \ud30c\uc190\ub41c \uc7a5\uc560\ubb3c\uacfc \uac19\uc740 \ubbf8\ubb18\ud55c \ud658\uacbd \ub2e8\uc11c\ub97c \uc0b4\ud3b4\ubcf4\uc138\uc694. [\ube44\uc720 \uc124\uba85: \uc9c0\ub984\uae38 \ucc3e\uae30\ub294 \ubbf8\ub85c\uc5d0\uc11c \ube44\ubc00 \ud1b5\ub85c\ub97c \ubc1c\uacac\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ub808\uc774\uc2f1 \ud55c\uacc4\uc758 \ub0a0\uc528 \uc2dc\uc2a4\ud15c\uc774 \uacbd\uc8fc \uc870\uac74\uacfc \uc790\ub3d9\ucc28 \ud578\ub4e4\ub9c1\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ub808\uc774\uc2f1 \ud55c\uacc4\uc758 \ub0a0\uc528 \uc2dc\uc2a4\ud15c\uc740 \uacbd\uc8fc \uc870\uac74\uc744 \ub3d9\uc801\uc73c\ub85c \ubcc0\uacbd\ud569\ub2c8\ub2e4. \ube44\ub294 \uadf8\ub9bd\uacfc \uc2dc\uc57c\ub97c \uac10\uc18c\uc2dc\ucf1c \uc870\uc2ec\uc2a4\ub7ec\uc6b4 \uc6b4\uc804\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud574\uc548 \uc11c\ud0b7'\uc5d0\uc11c \ube44\uac00 \uc624\uba74 \ucc28\uac00 \uc816\uc740 \ud45c\uba74\uc5d0\uc11c \ub354 \ub9ce\uc774 \ubbf8\ub044\ub7ec\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \ub9d1\uc74c - \uadf8\ub9bd: \ub192\uc74c, \uc2dc\uc57c: \ub9d1\uc74c; \ube44 - \uadf8\ub9bd: \ub0ae\uc74c, \uc2dc\uc57c: \uc88b\uc9c0 \uc54a\uc74c]"}, {"question": "PC\uc5d0\uc11c \ucf58\uc194\ub85c \ub808\uc774\uc2f1 \ud55c\uacc4\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c? \uadf8\ub9ac\uace0 \uadf8 \ub2e8\uacc4\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub124, PC\uc5d0\uc11c \ucf58\uc194\ub85c \ub808\uc774\uc2f1 \ud55c\uacc4\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uba3c\uc800 \uac8c\uc784\uc744 \ub450 \ud50c\ub7ab\ud3fc \ubaa8\ub450\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \uc5f0\uacb0\ud558\uc2ed\uc2dc\uc624. \uadf8\ub7f0 \ub2e4\uc74c '\ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5' \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub370\uc774\ud130\ub97c \ub3d9\uae30\ud654\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, Steam\uc5d0\uc11c PlayStation\uc73c\ub85c \uc774\uc804\ud558\ub824\uba74 \ub450 \ud50c\ub7ab\ud3fc \ubaa8\ub450\uc5d0\uc11c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uace0 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ud65c\uc131\ud654\ud574\uc57c \ud569\ub2c8\ub2e4. [\uc5ec\ub7ec \uc635\uc158 \ube44\uad50: PC\uc5d0\uc11c \ucf58\uc194\ub85c - \ub2e8\uacc4: 3, \uc2dc\uac04: 5\ubd84; \ucf58\uc194\uc5d0\uc11c PC\ub85c - \ub2e8\uacc4: 3, \uc2dc\uac04: 5\ubd84]"}, {"question": "\uc800\uc0ac\uc591 PC\uc5d0\uc11c \uc6d0\ud65c\ud55c \ub808\uc774\uc2f1 \ud55c\uacc4 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc704\ud574 \ucd5c\uc801\uc758 \uc124\uc815\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc800\uc0ac\uc591 PC\uc5d0\uc11c \uc6d0\ud65c\ud55c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc704\ud574 \ub808\uc774\uc2f1 \ud55c\uacc4 \uc124\uc815\uc744 \ub2e4\uc74c\uacfc \uac19\uc774 \uc870\uc815\ud558\uc2ed\uc2dc\uc624. \ud574\uc0c1\ub3c4\ub97c 720p\ub85c \ub0ae\ucd94\uace0, \ud14d\uc2a4\ucc98 \ud488\uc9c8\uc744 '\uc911\uac04'\uc73c\ub85c \uc904\uc774\uba70, \uc548\ud2f0\uc568\ub9ac\uc5b4\uc2f1\uc744 \ube44\ud65c\uc131\ud654\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc774\ub7ec\ud55c \uc124\uc815\uc740 \ud1b5\ud569 \uadf8\ub798\ud53d \uce74\ub4dc\uac00 \uc7a5\ucc29\ub41c PC\uc5d0\uc11c \uc131\ub2a5\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \ud574\uc0c1\ub3c4: 720p, \ud14d\uc2a4\ucc98 \ud488\uc9c8: \uc911\uac04, \uc548\ud2f0\uc568\ub9ac\uc5b4\uc2f1: \ud574\uc81c]"}]
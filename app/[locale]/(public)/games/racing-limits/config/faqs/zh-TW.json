[{"question": "\u5982\u4f55\u57f7\u884c\u8cfd\u8eca\u6975\u9650\u7684\u6f02\u79fb\uff0c\u4ee5\u53ca\u70ba\u4ec0\u9ebc\u5c0d\u65bc\u521d\u5b78\u8005\u4f86\u8aaa\u5f88\u91cd\u8981\uff1f", "answer": "\u5728\u8cfd\u8eca\u6975\u9650\u4e2d\uff0c\u6f02\u79fb\u5c0d\u65bc\u5728\u5f4e\u9053\u7dad\u6301\u901f\u5ea6\u81f3\u95dc\u91cd\u8981\u3002\u8981\u6f02\u79fb\uff0c\u8acb\u6309\u4f4f\u6f02\u79fb\u6309\u9215\u4e26\u8f49\u5f4e\u3002\u4f8b\u5982\uff0c\u5728\u300e\u57ce\u5e02\u8cfd\u9053\u300f\u4e2d\uff0c\u5728\u6025\u8f49\u5f4e\u8655\u6f02\u79fb\u53ef\u4ee5\u7bc0\u7701\u5bf6\u8cb4\u7684\u6642\u9593\u3002\u6b64\u6280\u5de7\u6709\u52a9\u65bc\u521d\u5b78\u8005\u6e1b\u5c11\u901f\u5ea6\u640d\u5931\u4e26\u63d0\u9ad8\u5f4e\u9053\u6548\u7387\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u6f02\u79fb\u5982\u540c\u53d7\u63a7\u7684\u6ed1\u884c\uff0c\u5c31\u50cf\u82b1\u6a23\u6ed1\u51b0\u9078\u624b\u5728\u8f49\u5f4e\u6642\u4fdd\u6301\u52d5\u91cf\u3002]"}, {"question": "\u300e\u904b\u52d5\u300f\u548c\u300e\u62c9\u529b\u300f\u8eca\u578b\u5728\u8cfd\u8eca\u6975\u9650\u4e2d\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "\u8cfd\u8eca\u6975\u9650\u4e2d\u7684\u300e\u904b\u52d5\u300f\u8eca\u578b\u8a2d\u8a08\u7528\u65bc\u64c1\u6709\u5e73\u6ed1\u8def\u9762\u7684\u9ad8\u901f\u8cfd\u9053\uff0c\u63d0\u4f9b\u66f4\u597d\u7684\u52a0\u901f\u548c\u6700\u9ad8\u901f\u5ea6\u3002\u7136\u800c\uff0c\u300e\u62c9\u529b\u300f\u8eca\u578b\u5247\u5728\u5d0e\u5d87\u5730\u5f62\u4e0a\u8868\u73fe\u51fa\u8272\uff0c\u5177\u6709\u66f4\u597d\u7684\u64cd\u63a7\u6027\u548c\u727d\u5f15\u529b\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5c71\u8def\u300f\u8cfd\u9053\u4e0a\u4f7f\u7528\u62c9\u529b\u8eca\u53ef\u4ee5\u5728\u788e\u77f3\u8def\u6bb5\u7372\u5f97\u66f4\u597d\u7684\u63a7\u5236\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u904b\u52d5\u8eca\u578b - \u52a0\u901f\uff1a\u9ad8\uff0c\u6700\u9ad8\u901f\u5ea6\uff1a\u6975\u9ad8\uff0c\u64cd\u63a7\uff1a\u4e2d\u7b49\uff1b\u62c9\u529b\u8eca\u578b - \u52a0\u901f\uff1a\u4e2d\u7b49\uff0c\u6700\u9ad8\u901f\u5ea6\uff1a\u9ad8\uff0c\u64cd\u63a7\uff1a\u6975\u9ad8]"}, {"question": "\u70ba\u4ec0\u9ebc\u8f2a\u80ce\u9078\u64c7\u5728\u8cfd\u8eca\u6975\u9650\u4e2d\u81f3\u95dc\u91cd\u8981\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u97ff\u6027\u80fd\uff1f", "answer": "\u5728\u8cfd\u8eca\u6975\u9650\u4e2d\uff0c\u8f2a\u80ce\u9078\u64c7\u986f\u8457\u5f71\u97ff\u6293\u5730\u529b\u548c\u64cd\u63a7\u6027\u3002\u4f8b\u5982\uff0c\u5728\u300e\u6c99\u6f20\u885d\u523a\u300f\u8cfd\u9053\u4e0a\u4f7f\u7528\u300e\u8edf\u300f\u80ce\uff0c\u53ef\u4ee5\u5728\u6c99\u5730\u4e0a\u63d0\u4f9b\u66f4\u597d\u7684\u6293\u5730\u529b\uff0c\u589e\u5f37\u60a8\u7684\u5f4e\u9053\u80fd\u529b\u3002\u53cd\u4e4b\uff0c\u300e\u786c\u300f\u80ce\u66f4\u8010\u7528\uff0c\u4f46\u6293\u5730\u529b\u8f03\u5dee\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u8edf\u80ce - \u6293\u5730\u529b\uff1a\u9ad8\uff0c\u8010\u7528\u6027\uff1a\u4f4e\uff1b\u786c\u80ce - \u6293\u5730\u529b\uff1a\u4f4e\uff0c\u8010\u7528\u6027\uff1a\u9ad8]"}, {"question": "\u5982\u4f55\u5728\u8cfd\u8eca\u6975\u9650\u4e2d\u512a\u5316\u6211\u7684\u63db\u6a94\u4ee5\u9054\u5230\u6700\u9ad8\u901f\u5ea6\uff1f", "answer": "\u5728\u8cfd\u8eca\u6975\u9650\u4e2d\u512a\u5316\u63db\u6a94\u9700\u8981\u4e86\u89e3\u8f49\u901f\u7bc4\u570d\u3002\u5728\u7d05\u7dda\u4e4b\u524d\u63db\u6a94\uff0c\u4ee5\u7dad\u6301\u6700\u4f73\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u300e\u8cfd\u8eca\u5834\u300f\u8cfd\u9053\u4e2d\uff0c\u5728 7000 \u8f49\u901f\u6642\u63db\u6a94\uff0c\u78ba\u4fdd\u60a8\u4fdd\u6301\u5728\u52d5\u529b\u7bc4\u570d\u5167\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u8f49\u901f\u8868\u2192\u63a5\u8fd1\u7d05\u7dda\u2192\u63db\u6a94\u2192\u7dad\u6301\u901f\u5ea6]"}, {"question": "\u5728\u8cfd\u8eca\u6975\u9650\u4e2d\uff0c\u6211\u61c9\u8a72\u4f7f\u7528\u54ea\u4e9b\u7b56\u7565\u624d\u80fd\u5728\u4e0d\u78b0\u649e\u7684\u60c5\u6cc1\u4e0b\u8d85\u8d8a\u5c0d\u624b\uff1f", "answer": "\u8981\u5728\u8cfd\u8eca\u6975\u9650\u4e2d\u5b89\u5168\u8d85\u8d8a\u5c0d\u624b\uff0c\u8acb\u4f7f\u7528\u6c23\u6d41\u6548\u61c9\u3002\u5c07\u60a8\u7684\u8eca\u8f1b\u7f6e\u65bc\u5c0d\u624b\u8eab\u5f8c\uff0c\u4ee5\u7372\u5f97\u901f\u5ea6\uff0c\u7136\u5f8c\u99db\u51fa\u8d85\u8eca\u3002\u4f8b\u5982\uff0c\u5728\u300e\u9ad8\u901f\u516c\u8def\u300f\u8cfd\u9053\u4e0a\uff0c\u6b64\u6280\u5de7\u53ef\u4ee5\u5e6b\u52a9\u60a8\u5728\u76f4\u7dda\u9053\u8def\u4e0a\u8d85\u8d8a\u591a\u8f1b\u8eca\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u6c23\u6d41\u6548\u61c9\u5c31\u50cf\u81ea\u884c\u8eca\u624b\u8ddf\u5728\u53e6\u4e00\u4eba\u8eab\u5f8c\u4ee5\u6e1b\u5c11\u7a7a\u6c23\u963b\u529b\u3002]"}, {"question": "\u5982\u4f55\u5728\u8cfd\u8eca\u6975\u9650\u4e2d\u7684\u9577\u9014\u6bd4\u8cfd\u4e2d\u7ba1\u7406\u71c3\u6cb9\u6d88\u8017\uff1f", "answer": "\u5728\u8cfd\u8eca\u6975\u9650\u4e2d\u7ba1\u7406\u71c3\u6cb9\u9700\u8981\u7b56\u7565\u6027\u5730\u4f7f\u7528\u6cb9\u9580\u3002\u907f\u514d\u5728\u76f4\u7dda\u8def\u4e0a\u5168\u6cb9\u9580\u4ee5\u7bc0\u7701\u71c3\u6cb9\u3002\u4f8b\u5982\uff0c\u5728\u300e\u8010\u529b\u8cfd\u300f\u4e2d\uff0c\u4fdd\u6301 80% \u6cb9\u9580\u53ef\u4ee5\u986f\u8457\u5ef6\u9577\u60a8\u7684\u71c3\u6cb9\u7bc4\u570d\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u5168\u6cb9\u9580 - \u71c3\u6cb9\u6d88\u8017\uff1a\u9ad8\uff0c\u901f\u5ea6\uff1a\u6700\u5927\uff1b80% \u6cb9\u9580 - \u71c3\u6cb9\u6d88\u8017\uff1a\u4e2d\u7b49\uff0c\u901f\u5ea6\uff1a\u9ad8]"}, {"question": "\u8cfd\u8eca\u6975\u9650\u4e2d\u7684\u96b1\u85cf\u6377\u5f91\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5982\u4f55\u627e\u5230\u5b83\u5011\uff1f", "answer": "\u8cfd\u8eca\u6975\u9650\u8a2d\u6709\u96b1\u85cf\u6377\u5f91\uff0c\u53ef\u4ee5\u8b93\u60a8\u5728\u7af6\u722d\u4e2d\u4f54\u64da\u512a\u52e2\u3002\u4f8b\u5982\uff0c\u5728\u300e\u68ee\u6797\u5c0f\u5f91\u300f\u8cfd\u9053\u4e0a\uff0c\u6a39\u6797\u4e2d\u6709\u4e00\u689d\u96b1\u85cf\u5c0f\u8def\u53ef\u4ee5\u7e2e\u77ed\u5f4e\u9053\u3002\u8981\u627e\u5230\u9019\u4e9b\u6377\u5f91\uff0c\u8acb\u5c0b\u627e\u74b0\u5883\u4e2d\u7684\u7d30\u5fae\u7dda\u7d22\uff0c\u4f8b\u5982\u8f2a\u80ce\u75d5\u8de1\u6216\u5df2\u640d\u58de\u7684\u969c\u7919\u7269\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c0b\u627e\u6377\u5f91\u5c31\u50cf\u5728\u8ff7\u5bae\u4e2d\u767c\u73fe\u79d8\u5bc6\u901a\u9053\u3002]"}, {"question": "\u8cfd\u8eca\u6975\u9650\u4e2d\u7684\u5929\u6c23\u7cfb\u7d71\u5982\u4f55\u5f71\u97ff\u6bd4\u8cfd\u72c0\u6cc1\u548c\u8eca\u8f1b\u64cd\u63a7\uff1f", "answer": "\u8cfd\u8eca\u6975\u9650\u4e2d\u7684\u5929\u6c23\u7cfb\u7d71\u6703\u52d5\u614b\u5730\u6539\u8b8a\u6bd4\u8cfd\u72c0\u6cc1\u3002\u96e8\u5929\u6703\u964d\u4f4e\u6293\u5730\u529b\u548c\u80fd\u898b\u5ea6\uff0c\u9700\u8981\u8b39\u614e\u99d5\u99db\u3002\u4f8b\u5982\uff0c\u5728\u300e\u6cbf\u6d77\u8cfd\u9053\u300f\u4e0b\u96e8\u6642\uff0c\u60a8\u7684\u8eca\u8f1b\u5728\u6f6e\u6fd5\u8def\u9762\u4e0a\u53ef\u80fd\u6703\u66f4\u5bb9\u6613\u6253\u6ed1\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6674\u5929 - \u6293\u5730\u529b\uff1a\u9ad8\uff0c\u80fd\u898b\u5ea6\uff1a\u826f\u597d\uff1b\u96e8\u5929 - \u6293\u5730\u529b\uff1a\u4f4e\uff0c\u80fd\u898b\u5ea6\uff1a\u5dee]"}, {"question": "\u6211\u53ef\u4ee5\u5728 PC \u7248\u8cfd\u8eca\u6975\u9650\u7684\u9032\u5ea6\u8f49\u79fb\u5230\u4e3b\u6a5f\u7248\u55ce\uff1f\u5177\u9ad4\u6b65\u9a5f\u70ba\u4f55\uff1f", "answer": "\u662f\u7684\uff0c\u60a8\u53ef\u4ee5\u5c07 PC \u7248\u8cfd\u8eca\u6975\u9650\u7684\u9032\u5ea6\u8f49\u79fb\u5230\u4e3b\u6a5f\u7248\u3002\u9996\u5148\uff0c\u78ba\u4fdd\u60a8\u7684\u904a\u6232\u5728\u5169\u500b\u5e73\u53f0\u4e0a\u90fd\u9023\u7d50\u5230\u540c\u4e00\u500b\u5e33\u6236\u3002\u7136\u5f8c\uff0c\u4f7f\u7528\u300e\u96f2\u7aef\u5132\u5b58\u300f\u529f\u80fd\u540c\u6b65\u60a8\u7684\u8cc7\u6599\u3002\u4f8b\u5982\uff0c\u5f9e Steam \u8f49\u79fb\u5230 PlayStation \u9700\u8981\u5728\u5169\u500b\u5e73\u53f0\u4e0a\u767b\u5165\u60a8\u7684\u5e33\u6236\u4e26\u555f\u7528\u96f2\u7aef\u5132\u5b58\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1aPC \u8f49\u4e3b\u6a5f--\u6b65\u9a5f\uff1a3\uff0c\u6642\u9593\uff1a5 \u5206\u9418\uff1b\u4e3b\u6a5f\u8f49 PC--\u6b65\u9a5f\uff1a3\uff0c\u6642\u9593\uff1a5 \u5206\u9418]"}, {"question": "\u8cfd\u8eca\u6975\u9650\u7684\u6700\u4f73\u8a2d\u5b9a\u70ba\u4f55\uff0c\u624d\u80fd\u78ba\u4fdd\u4f4e\u968e\u96fb\u8166\u7684\u9806\u66a2\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u5c0d\u65bc\u4f4e\u968e\u96fb\u8166\u7684\u9806\u66a2\u904a\u6232\u9ad4\u9a57\uff0c\u8acb\u8abf\u6574\u8cfd\u8eca\u6975\u9650\u7684\u8a2d\u5b9a\u5982\u4e0b\uff1a\u5c07\u89e3\u6790\u5ea6\u964d\u4f4e\u5230 720p\uff0c\u5c07\u7d0b\u7406\u8cea\u91cf\u964d\u4f4e\u81f3\u300e\u4e2d\u300f\uff0c\u4e26\u95dc\u9589\u6297\u92f8\u9f52\u3002\u4f8b\u5982\uff0c\u9019\u4e9b\u8a2d\u5b9a\u53ef\u4ee5\u5728\u914d\u5099\u6574\u5408\u986f\u5361\u7684\u96fb\u8166\u4e0a\u63d0\u5347\u6548\u80fd\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u89e3\u6790\u5ea6\uff1a720p\uff0c\u7d0b\u7406\u8cea\u91cf\uff1a\u4e2d\uff0c\u6297\u92f8\u9f52\uff1a\u95dc\u9589]"}]
[{"question": "\u5982\u4f55\u5728\u7ade\u901f\u6781\u9650\u4e2d\u8fdb\u884c\u6f02\u79fb\uff0c\u4ee5\u53ca\u4e3a\u4ec0\u4e48\u6f02\u79fb\u5bf9\u65b0\u624b\u5f88\u91cd\u8981\uff1f", "answer": "\u5728\u7ade\u901f\u6781\u9650\u4e2d\uff0c\u6f02\u79fb\u5bf9\u4e8e\u5728\u5f2f\u9053\u4fdd\u6301\u901f\u5ea6\u81f3\u5173\u91cd\u8981\u3002\u8981\u8fdb\u884c\u6f02\u79fb\uff0c\u8bf7\u6309\u4f4f\u6f02\u79fb\u6309\u952e\u5e76\u8f6c\u5f2f\u3002\u4f8b\u5982\uff0c\u5728\u201c\u57ce\u5e02\u8d5b\u9053\u201d\u4e0a\uff0c\u5728\u6025\u8f6c\u5f2f\u5904\u6f02\u79fb\u53ef\u4ee5\u8282\u7701\u5b9d\u8d35\u7684\u65f6\u95f4\u3002\u8fd9\u9879\u6280\u5de7\u5e2e\u52a9\u65b0\u624b\u51cf\u5c11\u901f\u5ea6\u635f\u5931\uff0c\u63d0\u9ad8\u5f2f\u9053\u6548\u7387\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u6f02\u79fb\u60f3\u8c61\u6210\u53d7\u63a7\u7684\u6ed1\u884c\uff0c\u5c31\u50cf\u82b1\u6837\u6ed1\u51b0\u8fd0\u52a8\u5458\u5728\u8f6c\u5f2f\u65f6\u4fdd\u6301\u60ef\u6027\u4e00\u6837\u3002]"}, {"question": "\u7ade\u901f\u6781\u9650\u4e2d\u7684\u201c\u8fd0\u52a8\u201d\u548c\u201c\u62c9\u529b\u201d\u8f66\u578b\u7c7b\u522b\u6709\u4ec0\u4e48\u4e3b\u8981\u533a\u522b\uff1f", "answer": "\u7ade\u901f\u6781\u9650\u4e2d\u7684\u201c\u8fd0\u52a8\u201d\u8f66\u578b\u7c7b\u522b\u662f\u4e3a\u62e5\u6709\u5e73\u6ed1\u8868\u9762\u7684\u9ad8\u901f\u8d5b\u9053\u800c\u8bbe\u8ba1\u7684\uff0c\u63d0\u4f9b\u66f4\u597d\u7684\u52a0\u901f\u548c\u6700\u9ad8\u901f\u5ea6\u3002\u7136\u800c\uff0c\u201c\u62c9\u529b\u201d\u8f66\u578b\u7c7b\u522b\u5219\u5728\u5d0e\u5c96\u5730\u5f62\u4e0a\u8868\u73b0\u51fa\u8272\uff0c\u5177\u6709\u66f4\u597d\u7684\u64cd\u63a7\u6027\u548c\u7275\u5f15\u529b\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5c71\u8def\u901a\u884c\u201d\u8d5b\u9053\u4e0a\u4f7f\u7528\u62c9\u529b\u8f66\u53ef\u4ee5\u66f4\u597d\u5730\u63a7\u5236\u788e\u77f3\u8def\u6bb5\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u8fd0\u52a8\u8f66\u578b - \u52a0\u901f\uff1a\u9ad8\uff0c\u6700\u9ad8\u901f\u5ea6\uff1a\u975e\u5e38\u9ad8\uff0c\u64cd\u63a7\uff1a\u4e2d\u7b49\uff1b \u62c9\u529b\u8f66\u578b - \u52a0\u901f\uff1a\u4e2d\u7b49\uff0c\u6700\u9ad8\u901f\u5ea6\uff1a\u9ad8\uff0c\u64cd\u63a7\uff1a\u975e\u5e38\u9ad8]"}, {"question": "\u4e3a\u4ec0\u4e48\u8f6e\u80ce\u9009\u62e9\u5728\u7ade\u901f\u6781\u9650\u4e2d\u81f3\u5173\u91cd\u8981\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u54cd\u6027\u80fd\uff1f", "answer": "\u5728\u7ade\u901f\u6781\u9650\u4e2d\uff0c\u8f6e\u80ce\u9009\u62e9\u4f1a\u663e\u8457\u5f71\u54cd\u6293\u5730\u529b\u548c\u64cd\u63a7\u6027\u3002\u4f8b\u5982\uff0c\u5728\u201c\u6c99\u6f20\u51b2\u523a\u201d\u8d5b\u9053\u4e0a\u4f7f\u7528\u201c\u8f6f\u201d\u8f6e\u80ce\u53ef\u4ee5\u5728\u6c99\u8d28\u8def\u9762\u4e0a\u63d0\u4f9b\u66f4\u597d\u7684\u6293\u5730\u529b\uff0c\u589e\u5f3a\u4f60\u7684\u5f2f\u9053\u80fd\u529b\u3002\u76f8\u53cd\uff0c\u201c\u786c\u201d\u8f6e\u80ce\u66f4\u8010\u7528\uff0c\u4f46\u6293\u5730\u529b\u8f83\u5dee\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u8f6f\u8f6e\u80ce - \u6293\u5730\u529b\uff1a\u9ad8\uff0c\u8010\u4e45\u6027\uff1a\u4f4e\uff1b \u786c\u8f6e\u80ce - \u6293\u5730\u529b\uff1a\u4f4e\uff0c\u8010\u4e45\u6027\uff1a\u9ad8]"}, {"question": "\u5982\u4f55\u5728\u7ade\u901f\u6781\u9650\u4e2d\u4f18\u5316\u6211\u7684\u6362\u6321\u64cd\u4f5c\uff0c\u4ee5\u8fbe\u5230\u6700\u5927\u901f\u5ea6\uff1f", "answer": "\u5728\u7ade\u901f\u6781\u9650\u4e2d\u4f18\u5316\u6362\u6321\u64cd\u4f5c\u9700\u8981\u7406\u89e3\u8f6c\u901f\u8303\u56f4\u3002\u5728\u7ea2\u7ebf\u4e4b\u524d\u6362\u6321\uff0c\u4ee5\u4fdd\u6301\u6700\u4f73\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u201c\u8d5b\u9053\u201d\u8d5b\u9053\u4e0a\uff0c\u5728\u6bcf\u5206\u949f\u8f6c\u901f 7000 \u65f6\u6362\u6321\u53ef\u4ee5\u4fdd\u8bc1\u4f60\u4fdd\u6301\u5728\u52a8\u529b\u533a\u95f4\u3002[\u6d41\u7a0b\u56fe\u89e3: \u8f6c\u901f\u8868 \u2192 \u63a5\u8fd1\u7ea2\u7ebf \u2192 \u6362\u6321 \u2192 \u4fdd\u6301\u901f\u5ea6]"}, {"question": "\u5728\u7ade\u901f\u6781\u9650\u4e2d\uff0c\u6211\u5e94\u8be5\u4f7f\u7528\u54ea\u4e9b\u7b56\u7565\u5728\u4e0d\u53d1\u751f\u78b0\u649e\u7684\u60c5\u51b5\u4e0b\u8d85\u8d8a\u5bf9\u624b\uff1f", "answer": "\u8981\u5728\u7ade\u901f\u6781\u9650\u4e2d\u5b89\u5168\u5730\u8d85\u8d8a\u5bf9\u624b\uff0c\u8bf7\u4f7f\u7528\u987a\u98ce\u6548\u5e94\u3002\u5c06\u4f60\u7684\u8f66\u8f86\u7f6e\u4e8e\u5bf9\u624b\u8eab\u540e\uff0c\u4ee5\u83b7\u5f97\u901f\u5ea6\uff0c\u7136\u540e\u8d85\u8d8a\u3002\u4f8b\u5982\uff0c\u5728\u201c\u9ad8\u901f\u516c\u8def\u8d5b\u9053\u201d\u4e0a\uff0c\u8fd9\u9879\u6280\u672f\u53ef\u4ee5\u5e2e\u52a9\u4f60\u5728\u76f4\u9053\u4e0a\u8d85\u8d8a\u591a\u8f86\u6c7d\u8f66\u3002[\u6bd4\u55bb\u8bf4\u660e: \u60f3\u8c61\u4e00\u4e0b\uff0c\u987a\u98ce\u6548\u5e94\u5c31\u50cf\u81ea\u884c\u8f66\u624b\u7d27\u968f\u5728\u53e6\u4e00\u4e2a\u4eba\u8eab\u540e\u4ee5\u51cf\u5c11\u7a7a\u6c14\u963b\u529b\u4e00\u6837\u3002]"}, {"question": "\u5728\u7ade\u901f\u6781\u9650\u7684\u957f\u8ddd\u79bb\u6bd4\u8d5b\u4e2d\u5982\u4f55\u7ba1\u7406\u71c3\u6cb9\u6d88\u8017\uff1f", "answer": "\u5728\u7ade\u901f\u6781\u9650\u4e2d\u7ba1\u7406\u71c3\u6cb9\u9700\u8981\u6218\u7565\u6027\u5730\u4f7f\u7528\u6cb9\u95e8\u3002\u907f\u514d\u5728\u76f4\u9053\u4e0a\u5168\u6cb9\u95e8\u4ee5\u8282\u7701\u71c3\u6cb9\u3002\u4f8b\u5982\uff0c\u5728\u201c\u8010\u529b\u8d5b\u201d\u4e2d\uff0c\u4fdd\u6301 80% \u6cb9\u95e8\u53ef\u4ee5\u663e\u8457\u5ef6\u957f\u4f60\u7684\u71c3\u6cb9\u7eed\u822a\u91cc\u7a0b\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u5168\u6cb9\u95e8 - \u71c3\u6cb9\u6d88\u8017\uff1a\u9ad8\uff0c\u901f\u5ea6\uff1a\u6700\u5927\uff1b 80% \u6cb9\u95e8 - \u71c3\u6cb9\u6d88\u8017\uff1a\u4e2d\u7b49\uff0c\u901f\u5ea6\uff1a\u9ad8]"}, {"question": "\u7ade\u901f\u6781\u9650\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u7684\u6377\u5f84\uff0c\u4ee5\u53ca\u5982\u4f55\u627e\u5230\u5b83\u4eec\uff1f", "answer": "\u7ade\u901f\u6781\u9650\u5305\u542b\u9690\u85cf\u7684\u6377\u5f84\uff0c\u53ef\u4ee5\u5e2e\u52a9\u4f60\u83b7\u5f97\u7ade\u4e89\u4f18\u52bf\u3002\u4f8b\u5982\uff0c\u5728\u201c\u68ee\u6797\u5c0f\u5f84\u201d\u8d5b\u9053\u4e0a\uff0c\u6811\u6797\u4e2d\u6709\u4e00\u6761\u9690\u85cf\u7684\u8def\u5f84\u53ef\u4ee5\u7f29\u77ed\u5f2f\u9053\u3002\u8981\u627e\u5230\u8fd9\u4e9b\u6377\u5f84\uff0c\u8bf7\u7559\u610f\u7ec6\u5fae\u7684\u73af\u5883\u7ebf\u7d22\uff0c\u4f8b\u5982\u8f6e\u80ce\u75d5\u8ff9\u6216\u635f\u574f\u7684\u969c\u788d\u7269\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5bfb\u627e\u6377\u5f84\u5c31\u50cf\u5728\u8ff7\u5bab\u4e2d\u53d1\u73b0\u79d8\u5bc6\u901a\u9053\u4e00\u6837\u3002]"}, {"question": "\u7ade\u901f\u6781\u9650\u4e2d\u7684\u5929\u6c14\u7cfb\u7edf\u5982\u4f55\u5f71\u54cd\u6bd4\u8d5b\u6761\u4ef6\u548c\u8f66\u8f86\u64cd\u63a7\uff1f", "answer": "\u7ade\u901f\u6781\u9650\u4e2d\u7684\u5929\u6c14\u7cfb\u7edf\u4f1a\u52a8\u6001\u5730\u6539\u53d8\u6bd4\u8d5b\u6761\u4ef6\u3002\u4e0b\u96e8\u4f1a\u964d\u4f4e\u6293\u5730\u529b\u548c\u80fd\u89c1\u5ea6\uff0c\u9700\u8981\u8c28\u614e\u9a7e\u9a76\u3002\u4f8b\u5982\uff0c\u5728\u201c\u6cbf\u6d77\u8d5b\u9053\u201d\u4e0b\u96e8\u65f6\uff0c\u4f60\u7684\u6c7d\u8f66\u5728\u6f6e\u6e7f\u8def\u9762\u4e0a\u53ef\u80fd\u4f1a\u53d1\u751f\u66f4\u591a\u7684\u6253\u6ed1\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u6674\u5929 - \u6293\u5730\u529b\uff1a\u9ad8\uff0c\u80fd\u89c1\u5ea6\uff1a\u6e05\u6670\uff1b \u96e8\u5929 - \u6293\u5730\u529b\uff1a\u4f4e\uff0c\u80fd\u89c1\u5ea6\uff1a\u5dee]"}, {"question": "\u6211\u662f\u5426\u53ef\u4ee5\u5c06\u6211\u7684\u7ade\u901f\u6781\u9650\u8fdb\u5ea6\u4ece PC \u4f20\u8f93\u5230\u4e3b\u673a\uff0c\u4ee5\u53ca\u6b65\u9aa4\u662f\u4ec0\u4e48\uff1f", "answer": "\u662f\u7684\uff0c\u4f60\u53ef\u4ee5\u5c06\u4f60\u7684\u7ade\u901f\u6781\u9650\u8fdb\u5ea6\u4ece PC \u4f20\u8f93\u5230\u4e3b\u673a\u3002\u9996\u5148\uff0c\u786e\u4fdd\u4f60\u7684\u6e38\u620f\u5728\u4e24\u6b3e\u5e73\u53f0\u4e0a\u90fd\u94fe\u63a5\u5230\u540c\u4e00\u4e2a\u8d26\u6237\u3002\u7136\u540e\uff0c\u4f7f\u7528\u201c\u4e91\u4fdd\u5b58\u201d\u529f\u80fd\u540c\u6b65\u4f60\u7684\u6570\u636e\u3002\u4f8b\u5982\uff0c\u4ece Steam \u4f20\u8f93\u5230 PlayStation \u9700\u8981\u767b\u5f55\u8fd9\u4e24\u4e2a\u5e73\u53f0\u4e0a\u7684\u8d26\u6237\u5e76\u542f\u7528\u4e91\u4fdd\u5b58\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: PC \u5230\u4e3b\u673a - \u6b65\u9aa4\uff1a3\uff0c\u65f6\u95f4\uff1a5 \u5206\u949f\uff1b \u4e3b\u673a\u5230 PC - \u6b65\u9aa4\uff1a3\uff0c\u65f6\u95f4\uff1a5 \u5206\u949f]"}, {"question": "\u4e3a\u4e86\u5728\u4f4e\u7aef\u7535\u8111\u4e0a\u786e\u4fdd\u6d41\u7545\u7684\u6e38\u620f\u4f53\u9a8c\uff0c\u7ade\u901f\u6781\u9650\u7684\u6700\u4f73\u8bbe\u7f6e\u662f\u4ec0\u4e48\uff1f", "answer": "\u4e3a\u4e86\u5728\u4f4e\u7aef\u7535\u8111\u4e0a\u83b7\u5f97\u6d41\u7545\u7684\u6e38\u620f\u4f53\u9a8c\uff0c\u8bf7\u8c03\u6574\u7ade\u901f\u6781\u9650\u8bbe\u7f6e\u5982\u4e0b\uff1a\u5c06\u5206\u8fa8\u7387\u964d\u4f4e\u5230 720p\uff0c\u5c06\u7eb9\u7406\u8d28\u91cf\u964d\u4f4e\u5230\u201c\u4e2d\u7b49\u201d\uff0c\u5e76\u7981\u7528\u6297\u952f\u9f7f\u3002\u4f8b\u5982\uff0c\u8fd9\u4e9b\u8bbe\u7f6e\u53ef\u4ee5\u63d0\u9ad8\u5728\u96c6\u6210\u663e\u5361\u7684 PC \u4e0a\u7684\u6027\u80fd\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u5206\u8fa8\u7387\uff1a720p\uff0c\u7eb9\u7406\u8d28\u91cf\uff1a\u4e2d\u7b49\uff0c\u6297\u952f\u9f7f\uff1a\u5173\u95ed]"}]
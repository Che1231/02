[{"question": "\u30ec\u30fc\u30b7\u30f3\u30b0\u30fb\u30ea\u30df\u30c3\u30c4\u3067\u30c9\u30ea\u30d5\u30c8\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f\u521d\u5fc3\u8005\u306b\u30c9\u30ea\u30d5\u30c8\u306f\u306a\u305c\u91cd\u8981\u3067\u3059\u304b\uff1f", "answer": "\u30ec\u30fc\u30b7\u30f3\u30b0\u30fb\u30ea\u30df\u30c3\u30c4\u3067\u306f\u3001\u30b3\u30fc\u30ca\u30fc\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u30c9\u30ea\u30d5\u30c8\u304c\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u30c9\u30ea\u30d5\u30c8\u3059\u308b\u306b\u306f\u3001\u30c9\u30ea\u30d5\u30c8\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u7d9a\u3051\u306a\u304c\u3089\u3001\u30cf\u30f3\u30c9\u30eb\u3092\u5207\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30b7\u30c6\u30a3\u30b5\u30fc\u30ad\u30c3\u30c8\u300d\u30b3\u30fc\u30b9\u3067\u306f\u3001\u92ed\u3044U\u30bf\u30fc\u30f3\u3092\u30c9\u30ea\u30d5\u30c8\u3059\u308b\u3053\u3068\u3067\u8cb4\u91cd\u306a\u6642\u9593\u3092\u7bc0\u7d04\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u6280\u6cd5\u306f\u3001\u901f\u5ea6\u306e\u4f4e\u4e0b\u3092\u8efd\u6e1b\u3057\u3001\u30b3\u30fc\u30ca\u30fc\u30ea\u30f3\u30b0\u306e\u52b9\u7387\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u3067\u3001\u521d\u5fc3\u8005\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u30c9\u30ea\u30d5\u30c8\u306f\u3001\u30b9\u30b1\u30fc\u30c8\u9078\u624b\u304c\u56de\u8ee2\u3057\u306a\u304c\u3089\u52e2\u3044\u3092\u7dad\u6301\u3059\u308b\u3088\u3046\u306a\u3001\u5236\u5fa1\u3055\u308c\u305f\u6ed1\u308a\u3092\u30a4\u30e1\u30fc\u30b8\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30ec\u30fc\u30b7\u30f3\u30b0\u30fb\u30ea\u30df\u30c3\u30c4\u306e\u300c\u30b9\u30dd\u30fc\u30c4\u300d\u30af\u30e9\u30b9\u3068\u300c\u30e9\u30ea\u30fc\u300d\u30af\u30e9\u30b9\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ec\u30fc\u30b7\u30f3\u30b0\u30fb\u30ea\u30df\u30c3\u30c4\u306e\u300c\u30b9\u30dd\u30fc\u30c4\u300d\u30af\u30e9\u30b9\u306f\u3001\u6ed1\u3089\u304b\u306a\u8def\u9762\u3092\u6301\u3064\u9ad8\u901f\u30b3\u30fc\u30b9\u5411\u3051\u306b\u8a2d\u8a08\u3055\u308c\u3066\u304a\u308a\u3001\u3088\u308a\u512a\u308c\u305f\u52a0\u901f\u529b\u3068\u6700\u9ad8\u901f\u5ea6\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u4e00\u65b9\u3001\u300c\u30e9\u30ea\u30fc\u300d\u30af\u30e9\u30b9\u306f\u3001\u8352\u308c\u305f\u5730\u5f62\u3067\u306e\u30cf\u30f3\u30c9\u30ea\u30f3\u30b0\u3068\u30c8\u30e9\u30af\u30b7\u30e7\u30f3\u3092\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u3001\u8352\u308c\u305f\u5730\u5f62\u306b\u9069\u3057\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30de\u30a6\u30f3\u30c6\u30f3\u30d1\u30b9\u300d\u30b3\u30fc\u30b9\u3067\u306f\u3001\u30e9\u30ea\u30fc\u30ab\u30fc\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u30b0\u30e9\u30d9\u30eb\u30bb\u30af\u30b7\u30e7\u30f3\u3067\u306e\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u6027\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002[\u4ed5\u69d8\u8868: \u30b9\u30dd\u30fc\u30c4\u30af\u30e9\u30b9 - \u52a0\u901f\u529b: \u9ad8\u901f\u3001\u6700\u9ad8\u901f\u5ea6: \u975e\u5e38\u306b\u9ad8\u901f\u3001\u30cf\u30f3\u30c9\u30ea\u30f3\u30b0: \u4e2d\u7a0b\u5ea6; \u30e9\u30ea\u30fc\u30af\u30e9\u30b9 - \u52a0\u901f\u529b: \u4e2d\u7a0b\u5ea6\u3001\u6700\u9ad8\u901f\u5ea6: \u9ad8\u901f\u3001\u30cf\u30f3\u30c9\u30ea\u30f3\u30b0: \u975e\u5e38\u306b\u9ad8\u901f]"}, {"question": "\u30ec\u30fc\u30b7\u30f3\u30b0\u30fb\u30ea\u30df\u30c3\u30c4\u3067\u30bf\u30a4\u30e4\u9078\u629e\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30ec\u30fc\u30b7\u30f3\u30b0\u30fb\u30ea\u30df\u30c3\u30c4\u3067\u30bf\u30a4\u30e4\u9078\u629e\u306f\u3001\u30b0\u30ea\u30c3\u30d7\u529b\u3068\u30cf\u30f3\u30c9\u30ea\u30f3\u30b0\u306b\u5927\u304d\u304f\u5f71\u97ff\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30c7\u30b6\u30fc\u30c8\u30c0\u30c3\u30b7\u30e5\u300d\u30b3\u30fc\u30b9\u3067\u306f\u3001\u300c\u30bd\u30d5\u30c8\u300d\u30bf\u30a4\u30e4\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u7802\u5730\u306e\u8def\u9762\u3067\u306e\u30b0\u30ea\u30c3\u30d7\u529b\u3092\u5411\u4e0a\u3055\u305b\u3001\u30b3\u30fc\u30ca\u30fc\u30ea\u30f3\u30b0\u80fd\u529b\u3092\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u9006\u306b\u3001\u300c\u30cf\u30fc\u30c9\u300d\u30bf\u30a4\u30e4\u306f\u8010\u4e45\u6027\u304c\u9ad8\u3044\u3067\u3059\u304c\u3001\u30b0\u30ea\u30c3\u30d7\u529b\u306f\u52a3\u308a\u307e\u3059\u3002[\u6bd4\u8f03\u8868: \u30bd\u30d5\u30c8\u30bf\u30a4\u30e4 - \u30b0\u30ea\u30c3\u30d7\u529b: \u9ad8\u3044\u3001\u8010\u4e45\u6027: \u4f4e\u3044; \u30cf\u30fc\u30c9\u30bf\u30a4\u30e4 - \u30b0\u30ea\u30c3\u30d7\u529b: \u4f4e\u3044\u3001\u8010\u4e45\u6027: \u9ad8\u3044]"}, {"question": "\u30ec\u30fc\u30b7\u30f3\u30b0\u30fb\u30ea\u30df\u30c3\u30c4\u3067\u6700\u9ad8\u901f\u5ea6\u3092\u5f97\u308b\u305f\u3081\u306b\u30ae\u30a2\u30c1\u30a7\u30f3\u30b8\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30ec\u30fc\u30b7\u30f3\u30b0\u30fb\u30ea\u30df\u30c3\u30c4\u3067\u30ae\u30a2\u30c1\u30a7\u30f3\u30b8\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u56de\u8ee2\u6570\u7bc4\u56f2\u3092\u7406\u89e3\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u6700\u9069\u306a\u901f\u5ea6\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u3001\u30ec\u30c3\u30c9\u30e9\u30a4\u30f3\u76f4\u524d\u3067\u30ae\u30a2\u30c1\u30a7\u30f3\u30b8\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30b9\u30d4\u30fc\u30c9\u30a6\u30a7\u30a4\u300d\u30b3\u30fc\u30b9\u3067\u306f\u30017000\u56de\u8ee2\u3067\u30ae\u30a2\u30c1\u30a7\u30f3\u30b8\u3059\u308b\u3053\u3068\u3067\u3001\u30d1\u30ef\u30fc\u30d0\u30f3\u30c9\u3092\u7dad\u6301\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8: \u56de\u8ee2\u6570\u30b2\u30fc\u30b8 \u2192 \u30ec\u30c3\u30c9\u30e9\u30a4\u30f3\u4ed8\u8fd1 \u2192 \u30ae\u30a2\u30c1\u30a7\u30f3\u30b8 \u2192 \u901f\u5ea6\u7dad\u6301]"}, {"question": "\u30ec\u30fc\u30b7\u30f3\u30b0\u30fb\u30ea\u30df\u30c3\u30c4\u3067\u5bfe\u6226\u76f8\u624b\u3092\u30af\u30e9\u30c3\u30b7\u30e5\u3059\u308b\u3053\u3068\u306a\u304f\u8ffd\u3044\u629c\u304f\u306b\u306f\u3001\u3069\u306e\u3088\u3046\u306a\u6226\u7565\u3092\u4f7f\u7528\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30ec\u30fc\u30b7\u30f3\u30b0\u30fb\u30ea\u30df\u30c3\u30c4\u3067\u5b89\u5168\u306b\u5bfe\u6226\u76f8\u624b\u3092\u8ffd\u3044\u629c\u304f\u306b\u306f\u3001\u30b9\u30ea\u30c3\u30d7\u30b9\u30c8\u30ea\u30fc\u30e0\u52b9\u679c\u3092\u5229\u7528\u3057\u307e\u3059\u3002\u5bfe\u6226\u76f8\u624b\u306e\u3059\u3050\u5f8c\u308d\u306b\u8eca\u3092\u4f4d\u7f6e\u3055\u305b\u3001\u30b9\u30d4\u30fc\u30c9\u3092\u7372\u5f97\u3057\u3066\u304b\u3089\u3001\u8ffd\u3044\u629c\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30cf\u30a4\u30a6\u30a7\u30a4\u30e9\u30f3\u300d\u30b3\u30fc\u30b9\u3067\u306f\u3001\u3053\u306e\u30c6\u30af\u30cb\u30c3\u30af\u306b\u3088\u308a\u3001\u76f4\u7dda\u3067\u8907\u6570\u306e\u8eca\u3092\u8ffd\u3044\u629c\u304f\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u81ea\u8ee2\u8eca\u304c\u7a7a\u6c17\u62b5\u6297\u3092\u6e1b\u3089\u3059\u305f\u3081\u306b\u4ed6\u306e\u81ea\u8ee2\u8eca\u306e\u5f8c\u308d\u306b\u4f4d\u7f6e\u3059\u308b\u30b9\u30ea\u30c3\u30d7\u30b9\u30c8\u30ea\u30fc\u30e0\u3092\u60f3\u50cf\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30ec\u30fc\u30b7\u30f3\u30b0\u30fb\u30ea\u30df\u30c3\u30c4\u3067\u9577\u3044\u30ec\u30fc\u30b9\u4e2d\u306b\u71c3\u6599\u6d88\u8cbb\u91cf\u3092\u3069\u306e\u3088\u3046\u306b\u7ba1\u7406\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30ec\u30fc\u30b7\u30f3\u30b0\u30fb\u30ea\u30df\u30c3\u30c4\u3067\u71c3\u6599\u3092\u7ba1\u7406\u3059\u308b\u306b\u306f\u3001\u30a2\u30af\u30bb\u30eb\u30da\u30c0\u30eb\u3092\u6226\u7565\u7684\u306b\u4f7f\u3046\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c8\u30ec\u30fc\u30c8\u3067\u306f\u3001\u71c3\u6599\u3092\u7bc0\u7d04\u3059\u308b\u305f\u3081\u306b\u3001\u30a2\u30af\u30bb\u30eb\u3092\u30d5\u30eb\u306b\u8e0f\u307f\u8fbc\u3080\u306e\u3092\u907f\u3051\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u300c\u8010\u4e45\u30ec\u30fc\u30b9\u300d\u3067\u306f\u3001\u30a2\u30af\u30bb\u30eb\u309280\uff05\u306b\u4fdd\u3064\u3053\u3068\u3067\u3001\u71c3\u6599\u306e\u7bc4\u56f2\u3092\u5927\u5e45\u306b\u5ef6\u3070\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03\u8868: \u30d5\u30eb\u30a2\u30af\u30bb\u30eb - \u71c3\u6599\u6d88\u8cbb\u91cf: \u9ad8\u3044\u3001\u901f\u5ea6: \u6700\u5927; 80\uff05\u30a2\u30af\u30bb\u30eb - \u71c3\u6599\u6d88\u8cbb\u91cf: \u4e2d\u7a0b\u5ea6\u3001\u901f\u5ea6: \u9ad8\u901f]"}, {"question": "\u30ec\u30fc\u30b7\u30f3\u30b0\u30fb\u30ea\u30df\u30c3\u30c4\u306e\u96a0\u308c\u305f\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u306f\u3042\u308a\u307e\u3059\u304b\uff1f\u3069\u306e\u3088\u3046\u306b\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30ec\u30fc\u30b7\u30f3\u30b0\u30fb\u30ea\u30df\u30c3\u30c4\u306b\u306f\u3001\u7af6\u4e89\u529b\u3092\u9ad8\u3081\u308b\u96a0\u308c\u305f\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30d5\u30a9\u30ec\u30b9\u30c8\u30c8\u30ec\u30a4\u30eb\u300d\u30b3\u30fc\u30b9\u3067\u306f\u3001\u6728\u3005\u306e\u9593\u3092\u629c\u3051\u308b\u96a0\u308c\u305f\u9053\u304c\u3042\u308a\u3001\u30b3\u30fc\u30ca\u30fc\u3092\u77ed\u7e2e\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u3092\u898b\u3064\u3051\u308b\u306b\u306f\u3001\u30bf\u30a4\u30e4\u306e\u8de1\u3084\u7834\u640d\u3057\u305f\u969c\u5bb3\u7269\u306a\u3069\u306e\u5fae\u5999\u306a\u74b0\u5883\u306e\u5146\u5019\u3092\u63a2\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u4f8b\u3048\uff1a\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u306f\u3001\u8ff7\u8def\u306e\u79d8\u5bc6\u901a\u8def\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u3068\u540c\u3058\u3067\u3059\u3002]"}, {"question": "\u30ec\u30fc\u30b7\u30f3\u30b0\u30fb\u30ea\u30df\u30c3\u30c4\u306e\u5929\u6c17\u30b7\u30b9\u30c6\u30e0\u306f\u30ec\u30fc\u30b9\u72b6\u6cc1\u3068\u8eca\u306e\u30cf\u30f3\u30c9\u30ea\u30f3\u30b0\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30ec\u30fc\u30b7\u30f3\u30b0\u30fb\u30ea\u30df\u30c3\u30c4\u306e\u5929\u6c17\u30b7\u30b9\u30c6\u30e0\u306f\u30ec\u30fc\u30b9\u72b6\u6cc1\u3092\u52d5\u7684\u306b\u5909\u5316\u3055\u305b\u307e\u3059\u3002\u96e8\u306f\u30b0\u30ea\u30c3\u30d7\u529b\u3068\u8996\u754c\u3092\u4f4e\u4e0b\u3055\u305b\u308b\u305f\u3081\u3001\u614e\u91cd\u306a\u904b\u8ee2\u304c\u5fc5\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u6d77\u5cb8\u30b5\u30fc\u30ad\u30c3\u30c8\u300d\u3067\u96e8\u304c\u964d\u3063\u3066\u3044\u308b\u9593\u306f\u3001\u8eca\u306f\u6fe1\u308c\u305f\u8def\u9762\u3067\u3088\u308a\u6ed1\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002[\u4ed5\u69d8\u8868: \u6674\u5929 - \u30b0\u30ea\u30c3\u30d7\u529b: \u9ad8\u3044\u3001\u8996\u754c: \u660e\u78ba; \u96e8\u5929 - \u30b0\u30ea\u30c3\u30d7\u529b: \u4f4e\u3044\u3001\u8996\u754c: \u60aa\u3044]"}, {"question": "PC\u7248\u306e\u30ec\u30fc\u30b7\u30f3\u30b0\u30fb\u30ea\u30df\u30c3\u30c4\u306e\u9032\u6357\u72b6\u6cc1\u3092\u30b3\u30f3\u30bd\u30fc\u30eb\u7248\u306b\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f\u624b\u9806\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001PC\u7248\u306e\u30ec\u30fc\u30b7\u30f3\u30b0\u30fb\u30ea\u30df\u30c3\u30c4\u306e\u9032\u6357\u72b6\u6cc1\u3092\u30b3\u30f3\u30bd\u30fc\u30eb\u7248\u306b\u8ee2\u9001\u3067\u304d\u307e\u3059\u3002\u307e\u305a\u3001\u4e21\u65b9\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u30b2\u30fc\u30e0\u304c\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ea\u30f3\u30af\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u305d\u306e\u5f8c\u3001\u300c\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u300d\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u30c7\u30fc\u30bf\u3092\u540c\u671f\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001Steam\u304b\u3089PlayStation\u3078\u306e\u8ee2\u9001\u306f\u3001\u4e21\u65b9\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3001\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u6709\u52b9\u306b\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002[\u6bd4\u8f03\u8868: PC\u304b\u3089\u30b3\u30f3\u30bd\u30fc\u30eb - \u624b\u9806: 3\u3001\u6642\u9593: 5\u5206; \u30b3\u30f3\u30bd\u30fc\u30eb\u304b\u3089PC - \u624b\u9806: 3\u3001\u6642\u9593: 5\u5206]"}, {"question": "\u30ed\u30fc\u30a8\u30f3\u30c9PC\u3067\u30b9\u30e0\u30fc\u30ba\u306a\u30ec\u30fc\u30b7\u30f3\u30b0\u30fb\u30ea\u30df\u30c3\u30c4\u306e\u30d7\u30ec\u30a4\u3092\u4fdd\u8a3c\u3059\u308b\u305f\u3081\u306e\u6700\u9069\u306a\u8a2d\u5b9a\u306f\uff1f", "answer": "\u30ed\u30fc\u30a8\u30f3\u30c9PC\u3067\u30b9\u30e0\u30fc\u30ba\u306b\u30d7\u30ec\u30a4\u3059\u308b\u306b\u306f\u3001\u30ec\u30fc\u30b7\u30f3\u30b0\u30fb\u30ea\u30df\u30c3\u30c4\u306e\u8a2d\u5b9a\u3092\u4ee5\u4e0b\u306e\u3088\u3046\u306b\u8abf\u6574\u3057\u307e\u3059\u3002\u89e3\u50cf\u5ea6\u3092720p\u306b\u4e0b\u3052\u3001\u30c6\u30af\u30b9\u30c1\u30e3\u306e\u8cea\u3092\u300c\u4e2d\u300d\u306b\u3001\u30a2\u30f3\u30c1\u30a8\u30a4\u30ea\u30a2\u30b9\u3092\u30aa\u30d5\u306b\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u3053\u308c\u3089\u306e\u8a2d\u5b9a\u306f\u7d71\u5408\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u30b9\u3092\u642d\u8f09\u3057\u305fPC\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u5411\u4e0a\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002[\u4ed5\u69d8\u8868: \u89e3\u50cf\u5ea6: 720p\u3001\u30c6\u30af\u30b9\u30c1\u30e3\u306e\u8cea: \u4e2d\u3001\u30a2\u30f3\u30c1\u30a8\u30a4\u30ea\u30a2\u30b9: \u30aa\u30d5]"}]
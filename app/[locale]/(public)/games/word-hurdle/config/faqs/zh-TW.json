[{"question": "Word Hurdle \u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u5c0d\u65b0\u73a9\u5bb6\u4f86\u8aaa\uff1f", "answer": "Word Hurdle \u7684\u8a08\u5206\u7cfb\u7d71\u65e8\u5728\u734e\u52f5\u6e96\u78ba\u6027\u548c\u6548\u7387\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u4e09\u6b21\u5617\u8a66\u4e2d\u731c\u5230\u6b63\u78ba\u7684\u55ae\u5b57\uff0c\u6bd4\u82b1\u8cbb\u516d\u6b21\u5617\u8a66\u5f97\u5206\u66f4\u9ad8\u3002\u904a\u6232\u4e5f\u6703\u70ba\u9023\u7e8c\u6b63\u78ba\u731c\u6e2c\u7684\u55ae\u5b57\u984d\u5916\u52a0\u5206\uff0c\u9f13\u52f5\u6301\u7e8c\u7684\u8868\u73fe\u3002\u8981\u6700\u5927\u5316\u4f60\u7684\u5f97\u5206\uff0c\u8acb\u5c08\u6ce8\u65bc\u5feb\u901f\u7e2e\u5c0f\u53ef\u80fd\u7684\u55ae\u5b57\u7bc4\u570d\uff0c\u4e26\u904b\u7528\u6392\u9664\u7b56\u7565\u3002"}, {"question": "Word Hurdle \u7684\u6700\u4f73\u8d77\u59cb\u55ae\u5b57\u662f\u4ec0\u9ebc\uff0c\u4ee5\u6700\u4f73\u5316\u731c\u6e2c\uff1f", "answer": "\u9078\u64c7\u6b63\u78ba\u7684\u8d77\u59cb\u55ae\u5b57\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u4f60\u5728 Word Hurdle \u7684\u8868\u73fe\u3002\u50cf\u662f \"CRANE\" \u6216 \"SLATE\" \u7b49\u55ae\u5b57\u7d93\u5e38\u88ab\u63a8\u85a6\uff0c\u56e0\u70ba\u5b83\u5011\u5305\u542b\u5e38\u898b\u7684\u6bcd\u97f3\u548c\u5b50\u97f3\uff0c\u80fd\u5e6b\u52a9\u4f60\u5feb\u901f\u8b58\u5225\u76ee\u6a19\u55ae\u5b57\u4e2d\u6709\u54ea\u4e9b\u5b57\u6bcd\u3002\u4f8b\u5982\uff0c\u5f9e \"CRANE\" \u958b\u59cb\u53ef\u80fd\u6703\u63ed\u9732 \"A\" \u548c \"E\" \u7684\u5b58\u5728\uff0c\u5141\u8a31\u4f60\u5c08\u6ce8\u65bc\u5728\u5f8c\u7e8c\u731c\u6e2c\u4e2d\u5305\u542b\u9019\u4e9b\u5b57\u6bcd\u7684\u55ae\u5b57\u3002"}, {"question": "\u70ba\u4ec0\u9ebc Word Hurdle \u6703\u9650\u5236\u6bcf\u56de\u5408\u7684\u731c\u6e2c\u6b21\u6578\uff1f", "answer": "Word Hurdle \u9650\u5236\u731c\u6e2c\u6b21\u6578\uff0c\u4ee5\u5275\u9020\u4e00\u500b\u5177\u6311\u6230\u6027\u548c\u5f15\u4eba\u5165\u52dd\u7684\u904a\u6232\u9ad4\u9a57\u3002\u9019\u500b\u9650\u5236\u8feb\u4f7f\u73a9\u5bb6\u4ee5\u7b56\u7565\u6027\u601d\u7dad\uff0c\u5145\u5206\u5229\u7528\u6bcf\u4e00\u6b21\u5617\u8a66\u3002\u4f8b\u5982\uff0c\u53ea\u6709\u516d\u6b21\u731c\u6e2c\uff0c\u4f60\u5fc5\u9808\u512a\u5148\u8003\u616e\u90a3\u4e9b\u80fd\u63d0\u4f9b\u6700\u591a\u95dc\u65bc\u5b57\u6bcd\u4f4d\u7f6e\u548c\u983b\u7387\u8cc7\u8a0a\u7684\u55ae\u5b57\u3002\u9019\u500b\u9650\u5236\u589e\u52a0\u4e86\u904a\u6232\u7684\u6df1\u5ea6\uff0c\u8b93\u6bcf\u4e00\u6b21\u731c\u6e2c\u90fd\u6210\u70ba\u4e00\u500b\u95dc\u9375\u7684\u6c7a\u5b9a\u3002"}, {"question": "\u5728\u73a9\u4e86 100 \u500b\u5c0f\u6642\u5f8c\uff0c\u6211\u5982\u4f55\u6539\u9032\u6211\u7684 Word Hurdle \u7b56\u7565\uff1f", "answer": "\u5728\u73a9\u4e86 100 \u500b\u5c0f\u6642\u5f8c\uff0c\u7cbe\u7149\u4f60\u7684\u7b56\u7565\u9700\u8981\u66f4\u9032\u968e\u7684\u6280\u5de7\u3002\u6b65\u9a5f 1\uff1a\u5206\u6790\u55ae\u5b57\u983b\u7387\u7684\u6a21\u5f0f\u3002\u6b65\u9a5f 2\uff1a\u66f4\u6709\u6548\u5730\u904b\u7528\u6392\u9664\u6cd5\uff0c\u8ffd\u8e64\u5df2\u4f7f\u7528\u904e\u7684\u5b57\u6bcd\u3002\u6b65\u9a5f 3\uff1a\u904b\u7528\u6a5f\u7387\u601d\u8003\uff0c\u731c\u6e2c\u5728\u7d71\u8a08\u4e0a\u8f03\u6709\u53ef\u80fd\u7684\u55ae\u5b57\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u77e5\u9053 \"E\" \u662f\u4e00\u500b\u5e38\u898b\u5b57\u6bcd\uff0c\u8acb\u512a\u5148\u8003\u616e\u5728\u7b2c\u4e8c\u500b\u4f4d\u7f6e\u5305\u542b \"E\" \u7684\u55ae\u5b57\u3002\u9019\u500b\u591a\u6b65\u9a5f\u65b9\u6cd5\u80fd\u63d0\u5347\u4f60\u7684\u6548\u7387\u548c\u6e96\u78ba\u6027\u3002"}, {"question": "Word Hurdle \u548c\u50b3\u7d71\u55ae\u5b57\u904a\u6232\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "Word Hurdle \u8207\u50b3\u7d71\u55ae\u5b57\u904a\u6232\u7684\u4e0d\u540c\u4e4b\u8655\u5728\u65bc\u5b83\u91cd\u8996\u6548\u7387\u548c\u7b56\u7565\u3002\u8207\u91cd\u8996\u55ae\u5b57\u8907\u96dc\u6027\u7684 Scrabble \u4e0d\u540c\uff0cWord Hurdle \u5f37\u8abf\u5feb\u901f\u3001\u6e96\u78ba\u7684\u731c\u6e2c\u3002\u6b64\u5916\uff0cWord Hurdle \u9650\u5236\u7684\u5617\u8a66\u6b21\u6578\uff0c\u589e\u52a0\u4e86\u7dca\u5f35\u611f\u548c\u8feb\u5207\u611f\u3002\u4f8b\u5982\uff0c\u5728\u4e09\u6b21\u5617\u8a66\u4e2d\u6b63\u78ba\u731c\u6e2c\u51fa \"PLANT\" \u6bd4\u82b1\u8cbb\u516d\u6b21\u5617\u8a66\u66f4\u503c\u5f97\u734e\u52f5\uff0c\u7a81\u986f\u4e86\u904a\u6232\u7368\u7279\u7684\u8a08\u5206\u6a5f\u5236\u3002"}, {"question": "\u54ea\u4e9b\u5e73\u53f0\u652f\u63f4 Word Hurdle\uff0c\u4ee5\u53ca\u5b83\u5011\u4e4b\u9593\u7684\u6bd4\u8f03\uff1f", "answer": "Word Hurdle \u53ef\u5728\u591a\u500b\u5e73\u53f0\u4f7f\u7528\uff0c\u5305\u62ec\u7db2\u9801\u700f\u89bd\u5668\u548c\u884c\u52d5\u61c9\u7528\u7a0b\u5f0f\u3002\u7db2\u9801\u7248\u672c\u63d0\u4f9b\u66f4\u5927\u7684\u87a2\u5e55\uff0c\u65b9\u4fbf\u8ffd\u8e64\u5b57\u6bcd\uff0c\u800c\u884c\u52d5\u61c9\u7528\u7a0b\u5f0f\u5247\u63d0\u4f9b\u4fbf\u5229\u6027\u548c\u651c\u5e36\u6027\u3002\u4f8b\u5982\uff0c\u5728\u5e73\u677f\u96fb\u8166\u4e0a\u904a\u6232\u53ef\u80fd\u5728\u87a2\u5e55\u5927\u5c0f\u548c\u884c\u52d5\u6027\u4e4b\u9593\u53d6\u5f97\u5e73\u8861\u3002\u6bcf\u500b\u5e73\u53f0\u90fd\u6709\u5176\u512a\u52e2\uff0c\u56e0\u6b64\u8acb\u6839\u64da\u4f60\u7684\u504f\u597d\u904a\u6232\u74b0\u5883\u9032\u884c\u9078\u64c7\u3002"}, {"question": "Word Hurdle \u7684\u6f14\u7b97\u6cd5\u662f\u5982\u4f55\u6c7a\u5b9a\u6bcf\u65e5\u7684\u55ae\u5b57\uff1f", "answer": "Word Hurdle \u7684\u6f14\u7b97\u6cd5\u6703\u5f9e\u7cbe\u5fc3\u6311\u9078\u7684\u5e38\u898b\u4e94\u500b\u5b57\u6bcd\u55ae\u5b57\u6e05\u55ae\u4e2d\u9078\u51fa\u6bcf\u65e5\u55ae\u5b57\u3002\u9019\u500b\u55ae\u5b57\u88ab\u9078\u51fa\uff0c\u4ee5\u78ba\u4fdd\u5728\u96e3\u5ea6\u548c\u53ef\u73a9\u6027\u4e4b\u9593\u53d6\u5f97\u5e73\u8861\u3002\u4f8b\u5982\uff0c\u55ae\u5b57 \"CRANE\" \u53ef\u80fd\u6703\u88ab\u9078\u51fa\uff0c\u56e0\u70ba\u5b83\u5305\u542b\u5e38\u898b\u5b57\u6bcd\uff0c\u4f7f\u5176\u65e2\u6613\u65bc\u4e0a\u624b\u53c8\u5177\u6311\u6230\u6027\u3002\u6f14\u7b97\u6cd5\u4e5f\u6703\u78ba\u4fdd\u6bcf\u65e5\u55ae\u5b57\u6539\u8b8a\uff0c\u7dad\u6301\u591a\u6a23\u6027\u548c\u53ef\u91cd\u8907\u6027\u3002"}, {"question": "\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\u53ef\u4ee5\u63d0\u5347\u6211\u7684 Word Hurdle \u904a\u6232\u9ad4\u9a57\uff1f", "answer": "Word Hurdle \u5305\u542b\u5e7e\u500b\u96b1\u85cf\u529f\u80fd\uff0c\u53ef\u4ee5\u63d0\u5347\u904a\u6232\u9ad4\u9a57\u3002\u4f8b\u5982\uff0c\u904a\u6232\u6703\u8ffd\u8e64\u4f60\u7684\u731c\u6e2c\u6b77\u53f2\uff0c\u8b93\u4f60\u6aa2\u95b1\u904e\u53bb\u7684\u8868\u73fe\uff0c\u4e26\u627e\u51fa\u6a21\u5f0f\u3002\u6b64\u5916\uff0c\u9084\u6709\u79d8\u5bc6\u6210\u5c31\uff0c\u4ee5\u8868\u5f70\u7368\u7279\u7684\u6210\u5c31\uff0c\u4f8b\u5982\u5728\u7b2c\u4e00\u6b21\u5617\u8a66\u4e2d\u731c\u5c0d\u6b63\u78ba\u7684\u55ae\u5b57\u3002\u63a2\u7d22\u9019\u4e9b\u529f\u80fd\u53ef\u4ee5\u589e\u52a0 Word Hurdle \u7684\u6df1\u5ea6\u548c\u6a02\u8da3\u3002"}, {"question": "\u5982\u4f55\u5c07\u6211\u7684 Word Hurdle \u9032\u5ea6\u9077\u79fb\u5230\u4e0d\u540c\u7684\u88dd\u7f6e\uff1f", "answer": "\u5982\u679c\u60a8\u5728\u4e0d\u540c\u88dd\u7f6e\u4e0a\u4f7f\u7528\u76f8\u540c\u7684\u5e33\u6236\uff0c\u90a3\u9ebc\u9077\u79fb\u60a8\u7684 Word Hurdle \u9032\u5ea6\u975e\u5e38\u7c21\u55ae\u3002\u53ea\u9700\u5728\u65b0\u88dd\u7f6e\u4e0a\u4f7f\u7528\u60a8\u7684\u6191\u8b49\u767b\u5165\uff0c\u60a8\u7684\u9032\u5ea6\u5c31\u6703\u81ea\u52d5\u540c\u6b65\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9e\u7db2\u9801\u700f\u89bd\u5668\u5207\u63db\u5230\u884c\u52d5\u61c9\u7528\u7a0b\u5f0f\uff0c\u60a8\u7684\u731c\u6e2c\u6b77\u53f2\u548c\u6210\u5c31\u5c07\u6703\u4fdd\u5b58\u4e0b\u4f86\u3002\u9019\u7a2e\u7121\u7e2b\u6574\u5408\u80fd\u78ba\u4fdd\u7121\u8ad6\u4f7f\u7528\u54ea\u500b\u5e73\u53f0\uff0c\u90fd\u80fd\u7dad\u6301\u4e00\u81f4\u7684\u9ad4\u9a57\u3002"}, {"question": "\u65b0 Word Hurdle \u73a9\u5bb6\u6700\u5e38\u898b\u7684\u9677\u9631\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5982\u4f55\u907f\u514d\u5b83\u5011\uff1f", "answer": "\u65b0\u73a9\u5bb6\u7d93\u5e38\u6703\u9677\u5165\u4e00\u4e9b\u5e38\u898b\u7684\u9677\u9631\uff0c\u4f8b\u5982\u731c\u6e2c\u96a8\u6a5f\u55ae\u5b57\u6216\u5ffd\u7565\u5b57\u6bcd\u983b\u7387\u3002\u70ba\u4e86\u907f\u514d\u9019\u4e9b\u9677\u9631\uff0c\u8acb\u5f9e\u5305\u542b\u5e38\u898b\u6bcd\u97f3\u548c\u5b50\u97f3\u7684\u55ae\u5b57\u958b\u59cb\uff0c\u4f8b\u5982 \"AUDIO\"\u3002\u6b64\u5916\uff0c\u8ffd\u8e64\u5df2\u4f7f\u7528\u904e\u7684\u5b57\u6bcd\uff0c\u4ee5\u6709\u6548\u5730\u6392\u9664\u53ef\u80fd\u6027\u3002\u4f8b\u5982\uff0c\u5982\u679c\u78ba\u8a8d\u4e86 \"A\" \u548c \"E\"\uff0c\u8acb\u5c08\u6ce8\u65bc\u5305\u542b\u9019\u4e9b\u5b57\u6bcd\u7684\u55ae\u5b57\u3002\u9019\u7a2e\u7b56\u7565\u65b9\u6cd5\u80fd\u5c07\u6d6a\u8cbb\u7684\u731c\u6e2c\u964d\u5230\u6700\u4f4e\uff0c\u4e26\u63d0\u9ad8\u4f60\u7684\u6210\u529f\u7387\u3002"}]
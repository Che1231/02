[{"question": "\uc6cc\ub4dc \ud5c8\ub4e4 \uac8c\uc784\uc758 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "\uc6cc\ub4dc \ud5c8\ub4e4\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc815\ud655\uc131\uacfc \ud6a8\uc728\uc131\uc744 \ubcf4\uc0c1\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 3\ubc88\uc758 \uc2dc\ub3c4\ub85c \uc62c\ubc14\ub978 \ub2e8\uc5b4\ub97c \ub9de\ucd94\uba74 6\ubc88\uc758 \uc2dc\ub3c4\ub85c \ub9de\ucd94\ub294 \uac83\ubcf4\ub2e4 \ub192\uc740 \uc810\uc218\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \uac8c\uc784\uc740 \ub610\ud55c \uc5f0\uc18d\uc801\uc778 \uc815\ub2f5\uc5d0 \ub300\ud55c \ubcf4\ub108\uc2a4 \uc810\uc218\ub97c \uc81c\uacf5\ud558\uc5ec \uc9c0\uc18d\uc801\uc778 \uc131\ub2a5\uc744 \uc7a5\ub824\ud569\ub2c8\ub2e4. \uc810\uc218\ub97c \uadf9\ub300\ud654\ud558\ub824\uba74 \uac00\ub2a5\ud55c \ub2e8\uc5b4\ub97c \uc2e0\uc18d\ud558\uac8c \uc881\ud788\uace0 \uc81c\uac70 \uc804\ub7b5\uc744 \uc0ac\uc6a9\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624."}, {"question": "\uc6cc\ub4dc \ud5c8\ub4e4 \uac8c\uc784\uc5d0\uc11c \ucd94\uce21\uc744 \ucd5c\uc801\ud654\ud558\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc2dc\uc791 \ub2e8\uc5b4\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc62c\ubc14\ub978 \uc2dc\uc791 \ub2e8\uc5b4\ub97c \uc120\ud0dd\ud558\uba74 \uc6cc\ub4dc \ud5c8\ub4e4 \uac8c\uc784\uc5d0\uc11c \uc131\ub2a5\uc744 \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. '\ud06c\ub808\uc778'\uc774\ub098 '\uc2ac\ub808\uc774\ud2b8'\uc640 \uac19\uc740 \ub2e8\uc5b4\ub294 \uc77c\ubc18\uc801\uc778 \ubaa8\uc74c\uacfc \uc790\uc74c\uc744 \ud3ec\ud568\ud558\uace0 \uc788\uae30 \ub54c\ubb38\uc5d0 \uc885\uc885 \ucd94\ucc9c\ub429\ub2c8\ub2e4. \uc774\ub294 \ub300\uc0c1 \ub2e8\uc5b4\uc5d0 \uc5b4\ub5a4 \ubb38\uc790\uac00 \uc788\ub294\uc9c0 \ube60\ub974\uac8c \uc2dd\ubcc4\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud06c\ub808\uc778'\uc73c\ub85c \uc2dc\uc791\ud558\uba74 'A'\uc640 'E'\uac00 \uc874\uc7ac\ud55c\ub2e4\ub294 \uac83\uc744 \uc54c \uc218 \uc788\uc73c\ubbc0\ub85c \ub2e4\uc74c \ucd94\uce21\uc5d0\uc11c \uc774\ub7ec\ud55c \ubb38\uc790\ub97c \ud3ec\ud568\ud558\ub294 \ub2e8\uc5b4\uc5d0 \uc9d1\uc911\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc6cc\ub4dc \ud5c8\ub4e4\uc740 \uc65c \ub77c\uc6b4\ub4dc\ub2f9 \uc2dc\ub3c4 \ud69f\uc218\ub97c \uc81c\ud55c\ud569\ub2c8\uae4c?", "answer": "\uc6cc\ub4dc \ud5c8\ub4e4 \uac8c\uc784\uc740 \ucc4c\ub9b0\uc9c0\ud558\uace0 \ucc38\uc5ec\ub3c4 \ub192\uc740 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud558\uae30 \uc704\ud574 \uc2dc\ub3c4 \ud69f\uc218\ub97c \uc81c\ud55c\ud569\ub2c8\ub2e4. \uc774 \uc81c\uc57d\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc804\ub7b5\uc801\uc73c\ub85c \uc0dd\uac01\ud558\uace0 \uac01 \uc2dc\ub3c4\ub97c \ucd5c\ub300\ud55c \ud65c\uc6a9\ud558\ub3c4\ub85d \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 6\ubc88\uc758 \uc2dc\ub3c4\ub9cc \ud5c8\uc6a9\ud558\ub294 \uacbd\uc6b0 \ubb38\uc790 \ubc30\uce58 \ubc0f \ube48\ub3c4\uc5d0 \ub300\ud55c \uc815\ubcf4\ub97c \uac00\uc7a5 \ub9ce\uc774 \uc81c\uacf5\ud558\ub294 \ub2e8\uc5b4\uc5d0 \uc6b0\uc120\uc21c\uc704\ub97c \uc9c0\uc815\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc81c\ud55c\uc740 \uac8c\uc784\uc5d0 \uae4a\uc774\ub97c \ub354\ud558\uba70, \uac01 \ucd94\uce21\uc744 \uc911\uc694\ud55c \uacb0\uc815\uc73c\ub85c \ub9cc\ub4ed\ub2c8\ub2e4."}, {"question": "100\uc2dc\uac04 \ud50c\ub808\uc774 \ud6c4 \uc6cc\ub4dc \ud5c8\ub4e4 \uc804\ub7b5\uc744 \uc5b4\ub5bb\uac8c \uac1c\uc120\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "100\uc2dc\uac04 \ud50c\ub808\uc774 \ud6c4 \uc804\ub7b5 \uac1c\uc120\uc740 \uace0\uae09 \uae30\uc220\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \ub2e8\uc5b4 \ube48\ub3c4 \ud328\ud134 \ubd84\uc11d. 2\ub2e8\uacc4: \uc0ac\uc6a9\ub41c \ubb38\uc790 \ucd94\uc801\uc744 \ud1b5\ud574 \ub354 \ud6a8\uacfc\uc801\uc778 \uc81c\uac70 \uacfc\uc815 \uc0ac\uc6a9. 3\ub2e8\uacc4: \ud655\ub960\uc801 \uc0ac\uace0\ub97c \ud1b5\ud569\ud558\uc5ec \ud1b5\uacc4\uc801\uc73c\ub85c \ub354 \uac00\ub2a5\uc131\uc774 \ub192\uc740 \ub2e8\uc5b4\ub97c \ucd94\uce21\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'E'\uac00 \uc77c\ubc18\uc801\uc774\ub77c\uba74 \ub450 \ubc88\uc9f8 \uc704\uce58\uc5d0 'E'\uac00 \uc788\ub294 \ub2e8\uc5b4\ub97c \uc6b0\uc120\uc21c\uc704\uc5d0 \ub450\uc2ed\uc2dc\uc624. \uc774 \ub2e4\ub2e8\uacc4 \uc811\uadfc \ubc29\uc2dd\uc740 \ud6a8\uc728\uc131\uacfc \uc815\ud655\uc131\uc744 \ub192\uc785\ub2c8\ub2e4."}, {"question": "\uc6cc\ub4dc \ud5c8\ub4e4\uacfc \uc804\ud1b5\uc801\uc778 \ub2e8\uc5b4 \uac8c\uc784\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc6cc\ub4dc \ud5c8\ub4e4\uc740 \ud6a8\uc728\uc131\uacfc \uc804\ub7b5\uc5d0 \uc911\uc810\uc744 \ub450\ub294 \uc810\uc5d0\uc11c \uc804\ud1b5\uc801\uc778 \ub2e8\uc5b4 \uac8c\uc784\uacfc \ub2e4\ub985\ub2c8\ub2e4. \uc2a4\ud06c\ub798\ube14 \uac8c\uc784\uacfc \ub2ec\ub9ac, \uc6cc\ub4dc \ud5c8\ub4e4\uc740 \ub2e8\uc5b4\uc758 \ubcf5\uc7a1\uc131\uc744 \ubcf4\uc0c1\ud558\ub294 \ub300\uc2e0 \ube60\ub974\uace0 \uc815\ud655\ud55c \ucd94\uce21\uc5d0 \uc911\uc810\uc744 \ub461\ub2c8\ub2e4. \ub610\ud55c \uc6cc\ub4dc \ud5c8\ub4e4\uc758 \uc2dc\ub3c4 \ud69f\uc218 \uc81c\ud55c\uc740 \uae34\uc7a5\uac10\uacfc \uae34\uae09\uc131\uc744 \ub354\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 3\ubc88\uc758 \uc2dc\ub3c4 \ub9cc\uc5d0 '\uc2dd\ubb3c'\uc744 \ub9de\ucd94\ub294 \uac83\uc740 6\ubc88\uc758 \uc2dc\ub3c4\uac00 \uc18c\uc694\ub418\ub294 \uac83\ubcf4\ub2e4 \ub354 \ubcf4\uc0c1\uc774 \ud07d\ub2c8\ub2e4. \uc6cc\ub4dc \ud5c8\ub4e4 \uac8c\uc784\uc758 \ub3c5\ud2b9\ud55c \uc810\uc218 \uba54\ucee4\ub2c8\uc998\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4."}, {"question": "\uc6cc\ub4dc \ud5c8\ub4e4 \uac8c\uc784\uc744 \uc9c0\uc6d0\ud558\ub294 \ud50c\ub7ab\ud3fc\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ube44\uad50\ub429\ub2c8\uae4c?", "answer": "\uc6cc\ub4dc \ud5c8\ub4e4\uc740 \uc6f9 \ube0c\ub77c\uc6b0\uc800\uc640 \ubaa8\ubc14\uc77c \uc571\uc744 \ud3ec\ud568\ud55c \uc5ec\ub7ec \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc774\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc6f9 \ubc84\uc804\uc740 \ubb38\uc790 \ucd94\uc801\uc774 \ub354 \uc26c\uc6b4 \ub354 \ud070 \ud654\uba74\uc744 \uc81c\uacf5\ud558\uba70, \ubaa8\ubc14\uc77c \uc571\uc740 \ud3b8\uc758\uc131\uacfc \ud734\ub300\uc131\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud0dc\ube14\ub9bf\uc5d0\uc11c \ud50c\ub808\uc774\ud558\uba74 \ud654\uba74 \ud06c\uae30\uc640 \ud734\ub300\uc131 \uc0ac\uc774\uc758 \uade0\ud615\uc744 \uc720\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac01 \ud50c\ub7ab\ud3fc\uc5d0\ub294 \uc7a5\uc810\uc774 \uc788\uc73c\ubbc0\ub85c \uc790\uc2e0\uc758 \uc120\ud638\ud558\ub294 \ud50c\ub808\uc774 \ud658\uacbd\uc5d0 \ub530\ub77c \uc120\ud0dd\ud558\uc2ed\uc2dc\uc624."}, {"question": "\uc6cc\ub4dc \ud5c8\ub4e4\uc758 \uc54c\uace0\ub9ac\uc998\uc740 \ub9e4\uc77c\uc758 \ub2e8\uc5b4\ub97c \uc5b4\ub5bb\uac8c \uacb0\uc815\ud569\ub2c8\uae4c?", "answer": "\uc6cc\ub4dc \ud5c8\ub4e4\uc758 \uc54c\uace0\ub9ac\uc998\uc740 \uc77c\ubc18\uc801\uc778 5\uae00\uc790 \ub2e8\uc5b4\uc758 \uc5c4\uc120\ub41c \ubaa9\ub85d\uc5d0\uc11c \ub9e4\uc77c\uc758 \ub2e8\uc5b4\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. \ub2e8\uc5b4\ub294 \uc5b4\ub824\uc6c0\uacfc \ud50c\ub808\uc774 \uac00\ub2a5\uc131 \uc0ac\uc774\uc758 \uade0\ud615\uc744 \uc720\uc9c0\ud558\ub3c4\ub85d \uc120\ud0dd\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud06c\ub808\uc778'\uc774\ub77c\ub294 \ub2e8\uc5b4\ub294 \uc77c\ubc18\uc801\uc778 \ubb38\uc790\ub97c \ud3ec\ud568\ud558\uace0 \uc788\uae30 \ub54c\ubb38\uc5d0 \uc811\uadfc\uc131\uc774 \uc788\uc9c0\ub9cc \uc5b4\ub824\uc6c0\uc744 \uac16\ub294 \ub2e8\uc5b4\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc54c\uace0\ub9ac\uc998\uc740 \ub610\ud55c \ub9e4\uc77c \ub2e8\uc5b4\ub97c \ubcc0\uacbd\ud558\uc5ec \ub2e4\uc591\uc131\uacfc \uc7ac\uc0dd \uac00\ub2a5\uc131\uc744 \uc720\uc9c0\ud569\ub2c8\ub2e4."}, {"question": "\uc6cc\ub4dc \ud5c8\ub4e4 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc6cc\ub4dc \ud5c8\ub4e4 \uac8c\uc784\uc5d0\ub294 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac8c\uc784\uc740 \ucd94\uce21 \uae30\ub85d\uc744 \ucd94\uc801\ud558\uc5ec \uacfc\uac70 \uc131\ub2a5\uc744 \uac80\ud1a0\ud558\uace0 \ud328\ud134\uc744 \uc2dd\ubcc4\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. \ub610\ud55c, \uccab \ubc88\uc9f8 \uc2dc\ub3c4\ub85c \uc62c\ubc14\ub978 \ub2e8\uc5b4\ub97c \ub9de\ucd94\ub294 \uac83\uacfc \uac19\uc740 \ub3c5\ud2b9\ud55c \uc5c5\uc801\uc5d0 \ub300\ud55c \ube44\ubc00 \ub2ec\uc131\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uae30\ub2a5\uc744 \ud0d0\uad6c\ud558\uba74 \uc6cc\ub4dc \ud5c8\ub4e4 \uac8c\uc784 \uacbd\ud5d8\uc5d0 \uae4a\uc774\uc640 \uc990\uac70\uc6c0\uc744 \ub354\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub2e4\ub978 \uae30\uae30\uc5d0\uc11c \uc6cc\ub4dc \ud5c8\ub4e4 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub2e4\ub978 \uae30\uae30\uc5d0\uc11c \uc6cc\ub4dc \ud5c8\ub4e4 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\ub294 \uac83\uc740 \uc5ec\ub7ec \uae30\uae30\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc744 \uc0ac\uc6a9\ud558\ub294 \uacbd\uc6b0 \uac04\ub2e8\ud569\ub2c8\ub2e4. \uc0c8 \uae30\uae30\uc5d0\uc11c \uc790\uaca9 \uc99d\uba85\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uae30\ub9cc \ud558\uba74 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc790\ub3d9\uc73c\ub85c \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc6f9 \ube0c\ub77c\uc6b0\uc800\uc5d0\uc11c \ubaa8\ubc14\uc77c \uc571\uc73c\ub85c \uc804\ud658\ud558\uba74 \ucd94\uce21 \uae30\ub85d\uacfc \uc131\ucde8\ub3c4\uac00 \ubcf4\uc874\ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc6d0\ud65c\ud55c \ud1b5\ud569\uc744 \ud1b5\ud574 \ud50c\ub7ab\ud3fc\uacfc \uad00\uacc4\uc5c6\uc774 \uc77c\uad00\ub41c \uacbd\ud5d8\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "\uc0c8\ub85c\uc6b4 \uc6cc\ub4dc \ud5c8\ub4e4 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc77c\ubc18\uc801\uc778 \ud568\uc815\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub294 \uc885\uc885 \ubb34\uc791\uc704 \ub2e8\uc5b4\ub97c \ucd94\uce21\ud558\uac70\ub098 \ubb38\uc790 \ube48\ub3c4\ub97c \ubb34\uc2dc\ud558\ub294 \uac83\uacfc \uac19\uc740 \uc77c\ubc18\uc801\uc778 \ud568\uc815\uc5d0 \ube60\uc9d1\ub2c8\ub2e4. \uc774\ub97c \ud53c\ud558\ub824\uba74 '\uc624\ub514\uc624'\uc640 \uac19\uc774 \uc77c\ubc18\uc801\uc778 \ubaa8\uc74c\uacfc \uc790\uc74c\uc744 \ud3ec\ud568\ud558\ub294 \ub2e8\uc5b4\ub85c \uc2dc\uc791\ud558\uc2ed\uc2dc\uc624. \ub610\ud55c, \uac00\ub2a5\uc131\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uc81c\uac70\ud558\uae30 \uc704\ud574 \uc0ac\uc6a9\ub41c \ubb38\uc790\ub97c \ucd94\uc801\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, 'A'\uc640 'E'\uac00 \ud655\uc778\ub418\uba74 \uc774 \ubb38\uc790\ub97c \ud3ec\ud568\ud558\ub294 \ub2e8\uc5b4\uc5d0 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \uc774\ub7ec\ud55c \uc804\ub7b5\uc801 \uc811\uadfc \ubc29\uc2dd\uc740 \ub0ad\ube44\ub418\ub294 \ucd94\uce21\uc744 \ucd5c\uc18c\ud654\ud558\uace0 \uc131\uacf5\ub960\uc744 \ub192\uc785\ub2c8\ub2e4."}]
[{"question": "Word Hurdle\u7684\u65b0\u73a9\u5bb6\u5f97\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "Word Hurdle\u7684\u5f97\u5206\u7cfb\u7edf\u65e8\u5728\u5956\u52b1\u51c6\u786e\u6027\u548c\u6548\u7387\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u4e09\u6b21\u5c1d\u8bd5\u4e2d\u731c\u51fa\u6b63\u786e\u7684\u5355\u8bcd\uff0c\u4f60\u7684\u5f97\u5206\u4f1a\u9ad8\u4e8e\u5982\u679c\u82b1\u516d\u6b21\u5c1d\u8bd5\u3002\u6e38\u620f\u8fd8\u4f1a\u5956\u52b1\u8fde\u7eed\u6b63\u786e\u731c\u8bcd\u7684\u989d\u5916\u79ef\u5206\uff0c\u9f13\u52b1\u6301\u7eed\u7684\u826f\u597d\u8868\u73b0\u3002\u4e3a\u4e86\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u4f60\u7684\u5206\u6570\uff0c\u4e13\u6ce8\u4e8e\u5feb\u901f\u7f29\u5c0f\u53ef\u80fd\u7684\u5355\u8bcd\u8303\u56f4\uff0c\u5e76\u4f7f\u7528\u6392\u9664\u7b56\u7565\u3002"}, {"question": "\u4e3a\u4e86\u4f18\u5316\u731c\u6d4b\uff0cWord Hurdle\u7684\u6700\u4f73\u8d77\u59cb\u8bcd\u662f\u4ec0\u4e48\uff1f", "answer": "\u9009\u62e9\u6b63\u786e\u7684\u8d77\u59cb\u8bcd\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u5728Word Hurdle\u4e2d\u7684\u8868\u73b0\u3002\u50cf\u201cCRANE\u201d\u6216\u201cSLATE\u201d\u8fd9\u6837\u7684\u8bcd\u901a\u5e38\u88ab\u63a8\u8350\uff0c\u56e0\u4e3a\u5b83\u4eec\u5305\u542b\u5e38\u89c1\u7684\u5143\u97f3\u548c\u8f85\u97f3\uff0c\u6709\u52a9\u4e8e\u4f60\u5feb\u901f\u8bc6\u522b\u76ee\u6807\u8bcd\u4e2d\u5305\u542b\u54ea\u4e9b\u5b57\u6bcd\u3002\u4f8b\u5982\uff0c\u4ece\u201cCRANE\u201d\u5f00\u59cb\u53ef\u80fd\u4f1a\u900f\u9732\u201cA\u201d\u548c\u201cE\u201d\u5b58\u5728\uff0c\u5141\u8bb8\u4f60\u5728\u540e\u7eed\u731c\u6d4b\u4e2d\u4e13\u6ce8\u4e8e\u5305\u542b\u8fd9\u4e9b\u5b57\u6bcd\u7684\u5355\u8bcd\u3002"}, {"question": "\u4e3a\u4ec0\u4e48Word Hurdle\u4f1a\u9650\u5236\u6bcf\u8f6e\u7684\u731c\u6d4b\u6b21\u6570\uff1f", "answer": "Word Hurdle\u9650\u5236\u731c\u6d4b\u6b21\u6570\u662f\u4e3a\u4e86\u521b\u9020\u4e00\u79cd\u5177\u6709\u6311\u6218\u6027\u548c\u5438\u5f15\u529b\u7684\u4f53\u9a8c\u3002\u8fd9\u79cd\u9650\u5236\u8feb\u4f7f\u73a9\u5bb6\u8fdb\u884c\u6218\u7565\u601d\u8003\uff0c\u5e76\u5145\u5206\u5229\u7528\u6bcf\u6b21\u5c1d\u8bd5\u3002\u4f8b\u5982\uff0c\u53ea\u6709\u516d\u6b21\u731c\u6d4b\uff0c\u4f60\u5fc5\u987b\u4f18\u5148\u8003\u8651\u90a3\u4e9b\u5173\u4e8e\u5b57\u6bcd\u4f4d\u7f6e\u548c\u9891\u7387\u63d0\u4f9b\u6700\u591a\u4fe1\u606f\u7684\u5355\u8bcd\u3002\u8fd9\u79cd\u9650\u5236\u589e\u52a0\u4e86\u6e38\u620f\u7684\u6df1\u5ea6\uff0c\u8ba9\u6bcf\u4e00\u6b21\u731c\u6d4b\u90fd\u6210\u4e3a\u4e00\u4e2a\u81f3\u5173\u91cd\u8981\u7684\u51b3\u5b9a\u3002"}, {"question": "\u5728\u73a9\u4e86100\u4e2a\u5c0f\u65f6\u540e\uff0c\u5982\u4f55\u6539\u8fdb\u6211\u7684Word Hurdle\u7b56\u7565\uff1f", "answer": "\u5728\u73a9\u4e86100\u4e2a\u5c0f\u65f6\u540e\uff0c\u6539\u8fdb\u7b56\u7565\u9700\u8981\u4e00\u4e9b\u9ad8\u7ea7\u6280\u5de7\u3002\u6b65\u9aa41\uff1a\u5206\u6790\u5355\u8bcd\u9891\u7387\u7684\u6a21\u5f0f\u3002\u6b65\u9aa42\uff1a\u66f4\u6709\u6548\u5730\u4f7f\u7528\u6392\u9664\u6cd5\uff0c\u901a\u8fc7\u8ddf\u8e2a\u5df2\u4f7f\u7528\u5b57\u6bcd\u3002\u6b65\u9aa43\uff1a\u8fd0\u7528\u6982\u7387\u601d\u7ef4\uff0c\u731c\u6d4b\u7edf\u8ba1\u4e0a\u66f4\u6709\u53ef\u80fd\u51fa\u73b0\u7684\u5355\u8bcd\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u77e5\u9053\u201cE\u201d\u5f88\u5e38\u89c1\uff0c\u4f18\u5148\u9009\u62e9\u5728\u7b2c\u4e8c\u4e2a\u4f4d\u7f6e\u5305\u542b\u201cE\u201d\u7684\u5355\u8bcd\u3002\u8fd9\u79cd\u591a\u6b65\u9aa4\u65b9\u6cd5\u63d0\u9ad8\u4e86\u4f60\u7684\u6548\u7387\u548c\u51c6\u786e\u6027\u3002"}, {"question": "Word Hurdle\u4e0e\u4f20\u7edf\u6587\u5b57\u6e38\u620f\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "Word Hurdle\u4e0e\u4f20\u7edf\u6587\u5b57\u6e38\u620f\u4e0d\u540c\u4e4b\u5904\u5728\u4e8e\u5b83\u5173\u6ce8\u6548\u7387\u548c\u7b56\u7565\u3002\u4e0e\u5956\u52b1\u5355\u8bcd\u590d\u6742\u6027\u7684Scrabble\u4e0d\u540c\uff0cWord Hurdle\u5f3a\u8c03\u5feb\u901f\u3001\u51c6\u786e\u7684\u731c\u6d4b\u3002\u6b64\u5916\uff0cWord Hurdle\u6709\u9650\u7684\u5c1d\u8bd5\u6b21\u6570\u589e\u52a0\u4e86\u7d27\u5f20\u611f\u548c\u7d27\u8feb\u611f\u3002\u4f8b\u5982\uff0c\u5728\u4e09\u6b21\u5c1d\u8bd5\u4e2d\u6b63\u786e\u731c\u6d4b\u201cPLANT\u201d\u6bd4\u82b1\u516d\u6b21\u5c1d\u8bd5\u66f4\u6709\u4ef7\u503c\uff0c\u7a81\u51fa\u4e86\u6e38\u620f\u72ec\u7279\u7684\u8ba1\u5206\u673a\u5236\u3002"}, {"question": "\u54ea\u4e9b\u5e73\u53f0\u652f\u6301Word Hurdle\uff0c\u5b83\u4eec\u4e4b\u95f4\u6709\u4ec0\u4e48\u6bd4\u8f83\uff1f", "answer": "Word Hurdle\u53ef\u5728\u591a\u4e2a\u5e73\u53f0\u4e0a\u4f7f\u7528\uff0c\u5305\u62ec\u7f51\u9875\u6d4f\u89c8\u5668\u548c\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u3002\u7f51\u9875\u7248\u63d0\u4f9b\u66f4\u5927\u7684\u5c4f\u5e55\uff0c\u4ee5\u4fbf\u4e8e\u5b57\u6bcd\u8ffd\u8e2a\uff0c\u800c\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\u5219\u63d0\u4f9b\u4e86\u4fbf\u5229\u6027\u548c\u4fbf\u643a\u6027\u3002\u4f8b\u5982\uff0c\u5728\u5e73\u677f\u7535\u8111\u4e0a\u73a9\u6e38\u620f\u53ef\u80fd\u4f1a\u5728\u5c4f\u5e55\u5927\u5c0f\u548c\u79fb\u52a8\u6027\u4e4b\u95f4\u53d6\u5f97\u5e73\u8861\u3002\u6bcf\u4e2a\u5e73\u53f0\u90fd\u6709\u5176\u4f18\u52bf\uff0c\u56e0\u6b64\u8bf7\u9009\u62e9\u9002\u5408\u4f60\u504f\u597d\u7684\u6e38\u620f\u73af\u5883\u3002"}, {"question": "Word Hurdle\u7684\u7b97\u6cd5\u5982\u4f55\u786e\u5b9a\u6bcf\u65e5\u7684\u5355\u8bcd\uff1f", "answer": "Word Hurdle\u7684\u7b97\u6cd5\u4ece\u7cbe\u9009\u7684\u5e38\u89c1\u4e94\u4e2a\u5b57\u6bcd\u5355\u8bcd\u5217\u8868\u4e2d\u9009\u62e9\u6bcf\u65e5\u5355\u8bcd\u3002\u6240\u9009\u7684\u5355\u8bcd\u65e8\u5728\u786e\u4fdd\u96be\u5ea6\u548c\u53ef\u73a9\u6027\u4e4b\u95f4\u7684\u5e73\u8861\u3002\u4f8b\u5982\uff0c\u53ef\u80fd\u9009\u62e9\u201cCRANE\u201d\u8fd9\u4e2a\u8bcd\uff0c\u56e0\u4e3a\u5b83\u5305\u542b\u5e38\u89c1\u7684\u5b57\u6bcd\uff0c\u4f7f\u5176\u65e2\u6613\u4e8e\u8bbf\u95ee\u53c8\u5177\u6709\u6311\u6218\u6027\u3002\u8be5\u7b97\u6cd5\u8fd8\u4f1a\u786e\u4fdd\u5355\u8bcd\u6bcf\u5929\u53d8\u5316\uff0c\u4fdd\u6301\u591a\u6837\u6027\u548c\u53ef\u91cd\u590d\u6027\u3002"}, {"question": "\u54ea\u4e9b\u9690\u85cf\u529f\u80fd\u53ef\u4ee5\u589e\u5f3a\u6211\u7684Word Hurdle\u4f53\u9a8c\uff1f", "answer": "Word Hurdle\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u529f\u80fd\u53ef\u4ee5\u589e\u5f3a\u6e38\u620f\u4f53\u9a8c\u3002\u4f8b\u5982\uff0c\u6e38\u620f\u4f1a\u8ddf\u8e2a\u4f60\u7684\u731c\u6d4b\u5386\u53f2\uff0c\u5141\u8bb8\u4f60\u56de\u987e\u8fc7\u53bb\u7684\u6210\u7ee9\u5e76\u8bc6\u522b\u6a21\u5f0f\u3002\u6b64\u5916\uff0c\u8fd8\u6709\u9488\u5bf9\u72ec\u7279\u6210\u5c31\u7684\u79d8\u5bc6\u6210\u5c31\uff0c\u4f8b\u5982\u7b2c\u4e00\u6b21\u5c1d\u8bd5\u5c31\u731c\u5bf9\u6b63\u786e\u7684\u5355\u8bcd\u3002\u63a2\u7d22\u8fd9\u4e9b\u529f\u80fd\u53ef\u4ee5\u589e\u52a0Word Hurdle\u6e38\u620f\u7684\u6df1\u5ea6\u548c\u4e50\u8da3\u3002"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684Word Hurdle\u8fdb\u5ea6\u8fc1\u79fb\u5230\u4e0d\u540c\u7684\u8bbe\u5907\uff1f", "answer": "\u5982\u679c\u5728\u4e0d\u540c\u8bbe\u5907\u4e0a\u4f7f\u7528\u540c\u4e00\u4e2a\u5e10\u6237\uff0c\u8fc1\u79fb\u4f60\u7684Word Hurdle\u8fdb\u5ea6\u975e\u5e38\u7b80\u5355\u3002\u53ea\u9700\u5728\u65b0\u8bbe\u5907\u4e0a\u767b\u5f55\u4f60\u7684\u51ed\u636e\uff0c\u4f60\u7684\u8fdb\u5ea6\u5c31\u4f1a\u81ea\u52a8\u540c\u6b65\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4ece\u7f51\u9875\u6d4f\u89c8\u5668\u5207\u6362\u5230\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\uff0c\u4f60\u7684\u731c\u6d4b\u5386\u53f2\u548c\u6210\u5c31\u5c06\u5f97\u5230\u4fdd\u7559\u3002\u8fd9\u79cd\u65e0\u7f1d\u96c6\u6210\u786e\u4fdd\u4e86\u65e0\u8bba\u4f7f\u7528\u54ea\u4e2a\u5e73\u53f0\uff0c\u90fd\u80fd\u83b7\u5f97\u4e00\u81f4\u7684\u4f53\u9a8c\u3002"}, {"question": "\u65b0Word Hurdle\u73a9\u5bb6\u6700\u5e38\u89c1\u7684\u9677\u9631\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5982\u4f55\u907f\u514d\u5b83\u4eec\uff1f", "answer": "\u65b0\u73a9\u5bb6\u7ecf\u5e38\u4f1a\u9677\u5165\u4e00\u4e9b\u5e38\u89c1\u7684\u9677\u9631\uff0c\u4f8b\u5982\u731c\u6d4b\u968f\u673a\u7684\u5355\u8bcd\u6216\u5ffd\u7565\u5b57\u6bcd\u9891\u7387\u3002\u4e3a\u4e86\u907f\u514d\u8fd9\u4e9b\u9677\u9631\uff0c\u4ece\u5305\u542b\u5e38\u89c1\u5143\u97f3\u548c\u8f85\u97f3\u7684\u5355\u8bcd\u5f00\u59cb\uff0c\u4f8b\u5982\u201cAUDIO\u201d\u3002\u6b64\u5916\uff0c\u8ffd\u8e2a\u54ea\u4e9b\u5b57\u6bcd\u5df2\u88ab\u4f7f\u7528\u4ee5\u6709\u6548\u5730\u6392\u9664\u53ef\u80fd\u6027\u3002\u4f8b\u5982\uff0c\u5982\u679c\u201cA\u201d\u548c\u201cE\u201d\u5f97\u5230\u786e\u8ba4\uff0c\u4e13\u6ce8\u4e8e\u5305\u542b\u8fd9\u4e9b\u5b57\u6bcd\u7684\u5355\u8bcd\u3002\u8fd9\u79cd\u7b56\u7565\u65b9\u6cd5\u5c06\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u6d6a\u8d39\u7684\u731c\u6d4b\u5e76\u63d0\u9ad8\u4f60\u7684\u6210\u529f\u7387\u3002"}]
[{"question": "\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3001\u30ef\u30fc\u30c9\u30fb\u30cf\u30c9\u30eb\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30c9\u30fb\u30cf\u30c9\u30eb\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6b63\u78ba\u3055\u3068\u52b9\u7387\u6027\u3092\u5831\u916c\u3068\u3059\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6b63\u3057\u3044\u5358\u8a9e\u30923\u56de\u306e\u8a66\u884c\u3067\u5f53\u3066\u305f\u3089\u30016\u56de\u306e\u8a66\u884c\u3067\u5f53\u3066\u305f\u5834\u5408\u3088\u308a\u3082\u9ad8\u3044\u30b9\u30b3\u30a2\u306b\u306a\u308a\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306f\u3001\u4e00\u8cab\u3057\u305f\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u4fc3\u9032\u3059\u308b\u305f\u3081\u306b\u3001\u9023\u7d9a\u3057\u3066\u6b63\u3057\u3044\u5358\u8a9e\u3092\u5f53\u3066\u305f\u5834\u5408\u306b\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u3082\u4ed8\u4e0e\u3057\u307e\u3059\u3002\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u53ef\u80fd\u306a\u5358\u8a9e\u3092\u7d20\u65e9\u304f\u7d5e\u308a\u8fbc\u307f\u3001\u6392\u9664\u6226\u7565\u3092\u6d3b\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30ef\u30fc\u30c9\u30fb\u30cf\u30c9\u30eb\u3067\u63a8\u6e2c\u3092\u6700\u9069\u5316\u3059\u308b\u305f\u3081\u306b\u3001\u6700\u9069\u306a\u6700\u521d\u306e\u5358\u8a9e\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u9069\u5207\u306a\u6700\u521d\u306e\u5358\u8a9e\u3092\u9078\u629e\u3059\u308b\u3053\u3068\u3067\u3001\u30ef\u30fc\u30c9\u30fb\u30cf\u30c9\u30eb\u3067\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\"CRANE\"\u3084\"SLATE\"\u306e\u3088\u3046\u306a\u5358\u8a9e\u306f\u3001\u4e00\u822c\u7684\u306b\u63a8\u5968\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u306a\u305c\u306a\u3089\u3001\u3053\u308c\u3089\u306f\u5171\u901a\u306e\u6bcd\u97f3\u3068\u5b50\u97f3\u3092\u542b\u3093\u3067\u3044\u308b\u305f\u3081\u3001\u30bf\u30fc\u30b2\u30c3\u30c8\u306e\u5358\u8a9e\u306b\u3042\u308b\u6587\u5b57\u3092\u7d20\u65e9\u304f\u7279\u5b9a\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\"CRANE\"\u304b\u3089\u59cb\u3081\u308b\u3068\u3001\u300cA\u300d\u3068\u300cE\u300d\u304c\u5b58\u5728\u3059\u308b\u3053\u3068\u304c\u5224\u660e\u3057\u3001\u6b21\u306e\u63a8\u6e2c\u3067\u306f\u3053\u308c\u3089\u306e\u6587\u5b57\u3092\u542b\u3080\u5358\u8a9e\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30ef\u30fc\u30c9\u30fb\u30cf\u30c9\u30eb\u306f\u3001\u30e9\u30a6\u30f3\u30c9\u3054\u3068\u306e\u8a66\u884c\u56de\u6570\u3092\u5236\u9650\u3059\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30c9\u30fb\u30cf\u30c9\u30eb\u306f\u3001\u6311\u6226\u7684\u3067\u9b45\u529b\u7684\u306a\u4f53\u9a13\u3092\u4f5c\u308b\u305f\u3081\u306b\u8a66\u884c\u56de\u6570\u3092\u5236\u9650\u3057\u3066\u3044\u307e\u3059\u3002\u3053\u306e\u5236\u7d04\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u6226\u7565\u7684\u306b\u8003\u3048\u3001\u5404\u8a66\u884c\u3092\u6700\u5927\u9650\u306b\u6d3b\u7528\u3059\u308b\u3053\u3068\u3092\u5f37\u3044\u3089\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u30016\u56de\u306e\u8a66\u884c\u3057\u304b\u306a\u3044\u5834\u5408\u3001\u6587\u5b57\u306e\u4f4d\u7f6e\u3068\u983b\u5ea6\u306b\u95a2\u3059\u308b\u6700\u3082\u591a\u304f\u306e\u60c5\u5831\u3092\u63d0\u4f9b\u3059\u308b\u5358\u8a9e\u3092\u512a\u5148\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u306e\u5236\u9650\u306f\u30b2\u30fc\u30e0\u306b\u6df1\u307f\u3092\u52a0\u3048\u3001\u5404\u63a8\u6e2c\u3092\u91cd\u8981\u306a\u6c7a\u5b9a\u306b\u3057\u307e\u3059\u3002"}, {"question": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u30ef\u30fc\u30c9\u30fb\u30cf\u30c9\u30eb\u306e\u6226\u7565\u3092\u3069\u306e\u3088\u3046\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u6226\u7565\u306e\u6539\u826f\u306b\u306f\u9ad8\u5ea6\u306a\u30c6\u30af\u30cb\u30c3\u30af\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5358\u8a9e\u306e\u983b\u5ea6\u306e\u50be\u5411\u3092\u5206\u6790\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u4f7f\u7528\u6e08\u307f\u306e\u6587\u5b57\u3092\u8ffd\u8de1\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u52b9\u679c\u7684\u306b\u6392\u9664\u6cd5\u3092\u4f7f\u3046\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u78ba\u7387\u7684\u601d\u8003\u3092\u53d6\u308a\u5165\u308c\u3066\u3001\u7d71\u8a08\u7684\u306b\u3088\u308a\u53ef\u80fd\u6027\u306e\u9ad8\u3044\u5358\u8a9e\u3092\u63a8\u6e2c\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u300cE\u300d\u304c\u5171\u901a\u3067\u3042\u308b\u3053\u3068\u304c\u5206\u304b\u3063\u3066\u3044\u308c\u3070\u3001\u300cE\u300d\u30922\u756a\u76ee\u306e\u4f4d\u7f6e\u306b\u542b\u3080\u5358\u8a9e\u3092\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u306e\u6bb5\u968e\u7684\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u3001\u52b9\u7387\u6027\u3068\u6b63\u78ba\u6027\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002"}, {"question": "\u30ef\u30fc\u30c9\u30fb\u30cf\u30c9\u30eb\u3068\u5f93\u6765\u306e\u5358\u8a9e\u30b2\u30fc\u30e0\u3068\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30c9\u30fb\u30cf\u30c9\u30eb\u306f\u3001\u5f93\u6765\u306e\u5358\u8a9e\u30b2\u30fc\u30e0\u3068\u306f\u7570\u306a\u308a\u3001\u52b9\u7387\u6027\u3068\u6226\u7565\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u3044\u307e\u3059\u3002\u30b9\u30af\u30e9\u30d6\u30eb\u3068\u306f\u7570\u306a\u308a\u3001\u5358\u8a9e\u306e\u8907\u96d1\u3055\u3092\u5831\u916c\u3068\u3059\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u30ef\u30fc\u30c9\u30fb\u30cf\u30c9\u30eb\u306f\u8fc5\u901f\u3067\u6b63\u78ba\u306a\u63a8\u6e2c\u3092\u91cd\u8996\u3057\u3066\u3044\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30ef\u30fc\u30c9\u30fb\u30cf\u30c9\u30eb\u306e\u8a66\u884c\u56de\u6570\u306e\u5236\u9650\u306b\u3088\u308a\u3001\u7dca\u8feb\u611f\u3068\u7dca\u6025\u611f\u304c\u52a0\u308f\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u30013\u56de\u306e\u8a66\u884c\u3067\u300cPLANT\u300d\u3092\u6b63\u3057\u304f\u5f53\u3066\u305f\u65b9\u304c\u30016\u56de\u306e\u8a66\u884c\u3067\u5f53\u3066\u305f\u3088\u308a\u3082\u4fa1\u5024\u304c\u9ad8\u3044\u3067\u3059\u3002\u3053\u308c\u306f\u3001\u30b2\u30fc\u30e0\u72ec\u81ea\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u793a\u3057\u3066\u3044\u307e\u3059\u3002"}, {"question": "\u30ef\u30fc\u30c9\u30fb\u30cf\u30c9\u30eb\u306f\u3069\u306e\u3088\u3046\u306a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u30b5\u30dd\u30fc\u30c8\u3055\u308c\u3066\u304a\u308a\u3001\u305d\u308c\u3089\u306f\u3069\u306e\u3088\u3046\u306b\u6bd4\u8f03\u3055\u308c\u307e\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30c9\u30fb\u30cf\u30c9\u30eb\u306f\u3001\u30a6\u30a7\u30d6\u30d6\u30e9\u30a6\u30b6\u3084\u30e2\u30d0\u30a4\u30eb\u30a2\u30d7\u30ea\u3092\u542b\u3080\u8907\u6570\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u5229\u7528\u3067\u304d\u307e\u3059\u3002\u30a6\u30a7\u30d6\u7248\u306f\u3001\u6587\u5b57\u3092\u8ffd\u8de1\u3057\u3084\u3059\u304f\u3059\u308b\u305f\u3081\u306b\u3001\u3088\u308a\u5927\u304d\u306a\u753b\u9762\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u4e00\u65b9\u3001\u30e2\u30d0\u30a4\u30eb\u30a2\u30d7\u30ea\u306f\u5229\u4fbf\u6027\u3068\u6301\u3061\u904b\u3073\u3084\u3059\u3055\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30bf\u30d6\u30ec\u30c3\u30c8\u3067\u30d7\u30ec\u30a4\u3059\u308b\u5834\u5408\u306f\u3001\u753b\u9762\u30b5\u30a4\u30ba\u3068\u643a\u5e2f\u6027\u306e\u30d0\u30e9\u30f3\u30b9\u3092\u3068\u308b\u3053\u3068\u304c\u3067\u304d\u305d\u3046\u3067\u3059\u3002\u5404\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u306f\u9577\u6240\u304c\u3042\u308a\u307e\u3059\u306e\u3067\u3001\u81ea\u5206\u306e\u597d\u307f\u306b\u57fa\u3065\u3044\u3066\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30ef\u30fc\u30c9\u30fb\u30cf\u30c9\u30eb\u306e\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u6bce\u65e5\u306e\u5358\u8a9e\u3092\u3069\u306e\u3088\u3046\u306b\u6c7a\u5b9a\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30c9\u30fb\u30cf\u30c9\u30eb\u306e\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u4e00\u822c\u7684\u306a5\u6587\u5b57\u306e\u5358\u8a9e\u306e\u53b3\u9078\u3055\u308c\u305f\u30ea\u30b9\u30c8\u304b\u3089\u6bce\u65e5\u306e\u5358\u8a9e\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u305d\u306e\u5358\u8a9e\u306f\u3001\u96e3\u6613\u5ea6\u3068\u904a\u3073\u3084\u3059\u3055\u306e\u30d0\u30e9\u30f3\u30b9\u3092\u3068\u308b\u3088\u3046\u306b\u9078\u3070\u308c\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300cCRANE\u300d\u3068\u3044\u3046\u5358\u8a9e\u306f\u3001\u4e00\u822c\u7684\u306a\u6587\u5b57\u3092\u542b\u3093\u3067\u3044\u308b\u305f\u3081\u3001\u30a2\u30af\u30bb\u30b9\u3057\u3084\u3059\u304f\u3001\u305d\u308c\u3067\u3082\u6311\u6226\u7684\u3067\u3059\u3002\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u307e\u305f\u3001\u65e5\u3005\u306e\u5358\u8a9e\u3092\u5909\u66f4\u3059\u308b\u3053\u3068\u3067\u3001\u591a\u69d8\u6027\u3068\u518d\u30d7\u30ec\u30a4\u6027\u3092\u7dad\u6301\u3057\u307e\u3059\u3002"}, {"question": "\u30ef\u30fc\u30c9\u30fb\u30cf\u30c9\u30eb\u3092\u3055\u3089\u306b\u5411\u4e0a\u3055\u305b\u308b\u96a0\u308c\u305f\u6a5f\u80fd\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30ef\u30fc\u30c9\u30fb\u30cf\u30c9\u30eb\u306b\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5411\u4e0a\u3055\u305b\u308b\u3044\u304f\u3064\u304b\u306e\u96a0\u308c\u305f\u6a5f\u80fd\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b2\u30fc\u30e0\u306f\u3042\u306a\u305f\u306e\u63a8\u6e2c\u5c65\u6b74\u3092\u8ffd\u8de1\u3057\u3066\u304a\u308a\u3001\u904e\u53bb\u306e\u6210\u7e3e\u3092\u898b\u76f4\u3057\u3001\u30d1\u30bf\u30fc\u30f3\u3092\u7279\u5b9a\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u307e\u305f\u3001\u6700\u521d\u306e\u8a66\u884c\u3067\u6b63\u3057\u3044\u5358\u8a9e\u3092\u5f53\u3066\u305f\u306a\u3069\u3001\u72ec\u7279\u306e\u9054\u6210\u5ea6\u306b\u5bfe\u3059\u308b\u79d8\u5bc6\u306e\u9054\u6210\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u6a5f\u80fd\u3092\u63a2\u6c42\u3059\u308b\u3053\u3068\u3067\u3001\u3042\u306a\u305f\u306e\u30ef\u30fc\u30c9\u30fb\u30cf\u30c9\u30eb\u4f53\u9a13\u306b\u6df1\u307f\u3068\u697d\u3057\u3055\u3092\u52a0\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30ef\u30fc\u30c9\u30fb\u30cf\u30c9\u30eb\u306e\u9032\u884c\u72b6\u6cc1\u3092\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u30de\u30a4\u30b0\u30ec\u30fc\u30b7\u30e7\u30f3\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u4f7f\u7528\u3057\u3066\u3044\u308b\u5834\u5408\u306f\u3001\u30ef\u30fc\u30c9\u30fb\u30cf\u30c9\u30eb\u306e\u9032\u884c\u72b6\u6cc1\u3092\u7c21\u5358\u306b\u79fb\u884c\u3067\u304d\u307e\u3059\u3002\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u3042\u306a\u305f\u306e\u8cc7\u683c\u60c5\u5831\u3092\u4f7f\u3063\u3066\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3060\u3051\u3067\u3001\u3042\u306a\u305f\u306e\u9032\u884c\u72b6\u6cc1\u306f\u81ea\u52d5\u7684\u306b\u540c\u671f\u3055\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30a6\u30a7\u30d6\u30d6\u30e9\u30a6\u30b6\u304b\u3089\u30e2\u30d0\u30a4\u30eb\u30a2\u30d7\u30ea\u306b\u5207\u308a\u66ff\u3048\u305f\u5834\u5408\u3067\u3082\u3001\u3042\u306a\u305f\u306e\u63a8\u6e2c\u5c65\u6b74\u3068\u9054\u6210\u306f\u4fdd\u5b58\u3055\u308c\u307e\u3059\u3002\u3053\u306e\u30b7\u30fc\u30e0\u30ec\u30b9\u306a\u7d71\u5408\u306f\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u95a2\u4fc2\u306a\u304f\u3001\u4e00\u8cab\u3057\u305f\u4f53\u9a13\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002"}, {"question": "\u65b0\u3057\u3044\u30ef\u30fc\u30c9\u30fb\u30cf\u30c9\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u3001\u6700\u3082\u4e00\u822c\u7684\u306a\u843d\u3068\u3057\u7a74\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u3092\u907f\u3051\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30e9\u30f3\u30c0\u30e0\u306a\u5358\u8a9e\u3092\u63a8\u6e2c\u3059\u308b\u3053\u3068\u3084\u3001\u6587\u5b57\u306e\u983b\u5ea6\u3092\u7121\u8996\u3059\u308b\u3053\u3068\u306a\u3069\u3001\u4e00\u822c\u7684\u306a\u843d\u3068\u3057\u7a74\u306b\u9665\u308b\u3053\u3068\u304c\u3088\u304f\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u306f\u3001\u300cAUDIO\u300d\u306e\u3088\u3046\u306a\u3001\u5171\u901a\u306e\u6bcd\u97f3\u3068\u5b50\u97f3\u3092\u542b\u3080\u5358\u8a9e\u304b\u3089\u59cb\u3081\u308b\u3079\u304d\u3067\u3059\u3002\u3055\u3089\u306b\u3001\u53ef\u80fd\u306a\u9078\u629e\u80a2\u3092\u52b9\u7387\u7684\u306b\u6392\u9664\u3059\u308b\u305f\u3081\u306b\u3001\u3069\u306e\u6587\u5b57\u304c\u4f7f\u7528\u3055\u308c\u305f\u304b\u3092\u8ffd\u8de1\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u300cA\u300d\u3068\u300cE\u300d\u304c\u78ba\u8a8d\u3055\u308c\u305f\u3089\u3001\u3053\u308c\u3089\u306e\u6587\u5b57\u3092\u542b\u3080\u5358\u8a9e\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u306e\u6226\u7565\u7684\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u3001\u7121\u99c4\u306a\u63a8\u6e2c\u3092\u6e1b\u3089\u3057\u3001\u6210\u529f\u7387\u3092\u9ad8\u3081\u307e\u3059\u3002"}]
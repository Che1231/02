[{"question": "\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0431\u0430\u043b\u0456\u0432 Word Hurdle \u0434\u043b\u044f \u043d\u043e\u0432\u0438\u0445 \u0433\u0440\u0430\u0432\u0446\u0456\u0432?", "answer": "\u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u0431\u0430\u043b\u0456\u0432 Word Hurdle \u0440\u043e\u0437\u0440\u043e\u0431\u043b\u0435\u043d\u0430 \u0434\u043b\u044f \u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0436\u0435\u043d\u043d\u044f \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0456 \u0442\u0430 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0456. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u044f\u043a\u0449\u043e \u0432\u0438 \u0432\u0433\u0430\u0434\u0430\u0454\u0442\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0435 \u0441\u043b\u043e\u0432\u043e \u0437\u0430 \u0442\u0440\u0438 \u0441\u043f\u0440\u043e\u0431\u0438, \u0432\u0438 \u043e\u0442\u0440\u0438\u043c\u0430\u0454\u0442\u0435 \u0431\u0456\u043b\u044c\u0448\u0435 \u0431\u0430\u043b\u0456\u0432, \u043d\u0456\u0436 \u044f\u043a\u0449\u043e \u0432\u0438\u0442\u0440\u0430\u0442\u0438\u0442\u0435 \u0448\u0456\u0441\u0442\u044c \u0441\u043f\u0440\u043e\u0431. \u0413\u0440\u0430 \u0442\u0430\u043a\u043e\u0436 \u043d\u0430\u0440\u0430\u0445\u043e\u0432\u0443\u0454 \u0431\u043e\u043d\u0443\u0441\u043d\u0456 \u0431\u0430\u043b\u0438 \u0437\u0430 \u043f\u043e\u0441\u043b\u0456\u0434\u043e\u0432\u043d\u0456 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0456 \u0432\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u043d\u044f, \u0449\u043e \u0441\u0442\u0438\u043c\u0443\u043b\u044e\u0454 \u0441\u0442\u0430\u0431\u0456\u043b\u044c\u043d\u0443 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c. \u0429\u043e\u0431 \u043c\u0430\u043a\u0441\u0438\u043c\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0441\u0432\u043e\u0457 \u0431\u0430\u043b\u0438, \u0437\u043e\u0441\u0435\u0440\u0435\u0434\u044c\u0442\u0435\u0441\u044f \u043d\u0430 \u0448\u0432\u0438\u0434\u043a\u043e\u043c\u0443 \u0437\u0432\u0443\u0436\u0435\u043d\u043d\u0456 \u043c\u043e\u0436\u043b\u0438\u0432\u0438\u0445 \u0441\u043b\u0456\u0432 \u0456 \u0437\u0430\u0441\u0442\u043e\u0441\u043e\u0432\u0443\u0439\u0442\u0435 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0457 \u0443\u0441\u0443\u043d\u0435\u043d\u043d\u044f."}, {"question": "\u042f\u043a\u0456 \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0456 \u043f\u043e\u0447\u0430\u0442\u043a\u043e\u0432\u0456 \u0441\u043b\u043e\u0432\u0430 \u0434\u043b\u044f Word Hurdle, \u0449\u043e\u0431 \u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0432\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u043d\u044f?", "answer": "\u0412\u0438\u0431\u0456\u0440 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u043e\u0447\u0430\u0442\u043a\u043e\u0432\u043e\u0433\u043e \u0441\u043b\u043e\u0432\u0430 \u043c\u043e\u0436\u0435 \u0437\u043d\u0430\u0447\u043d\u043e \u043f\u043e\u043a\u0440\u0430\u0449\u0438\u0442\u0438 \u0432\u0430\u0448\u0443 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c \u0443 Word Hurdle. \u0427\u0430\u0441\u0442\u043e \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u044e\u0442\u044c\u0441\u044f \u0441\u043b\u043e\u0432\u0430, \u044f\u043a \"\u041a\u0420\u0410\u041d\" \u0430\u0431\u043e \"\u041f\u041b\u0410\u0421\u0422\u0418\u041d\u0410\" , \u043e\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u0432\u043e\u043d\u0438 \u043c\u0456\u0441\u0442\u044f\u0442\u044c \u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0456 \u0433\u043e\u043b\u043e\u0441\u043d\u0456 \u0442\u0430 \u043f\u0440\u0438\u0433\u043e\u043b\u043e\u0441\u043d\u0456, \u0449\u043e \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u0454 \u0448\u0432\u0438\u0434\u043a\u043e \u0432\u0438\u0437\u043d\u0430\u0447\u0438\u0442\u0438, \u044f\u043a\u0456 \u043b\u0456\u0442\u0435\u0440\u0438 \u0454 \u0432 \u0446\u0456\u043b\u044c\u043e\u0432\u043e\u043c\u0443 \u0441\u043b\u043e\u0432\u0456. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043f\u043e\u0447\u0430\u0432\u0448\u0438 \u0437\u0456 \u0441\u043b\u043e\u0432\u0430 \"\u041a\u0420\u0410\u041d\", \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u2019\u044f\u0441\u0443\u0432\u0430\u0442\u0438, \u0449\u043e \u043b\u0456\u0442\u0435\u0440\u0438 \"\u0410\" \u0456 \"\u041d\" \u043f\u0440\u0438\u0441\u0443\u0442\u043d\u0456, \u0449\u043e \u0434\u043e\u0437\u0432\u043e\u043b\u0438\u0442\u044c \u0437\u043e\u0441\u0435\u0440\u0435\u0434\u0438\u0442\u0438\u0441\u044f \u043d\u0430 \u0441\u043b\u043e\u0432\u0430\u0445, \u0449\u043e \u043c\u0456\u0441\u0442\u044f\u0442\u044c \u0446\u0456 \u043b\u0456\u0442\u0435\u0440\u0438 \u0432 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u0445 \u0441\u043f\u0440\u043e\u0431\u0430\u0445."}, {"question": "\u0427\u043e\u043c\u0443 Word Hurdle \u043e\u0431\u043c\u0435\u0436\u0443\u0454 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u0441\u043f\u0440\u043e\u0431 \u0437\u0430 \u0440\u0430\u0443\u043d\u0434?", "answer": "Word Hurdle \u043e\u0431\u043c\u0435\u0436\u0443\u0454 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u0441\u043f\u0440\u043e\u0431, \u0449\u043e\u0431 \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0441\u043a\u043b\u0430\u0434\u043d\u0438\u0439 \u0442\u0430 \u0437\u0430\u0445\u043e\u043f\u043b\u044e\u044e\u0447\u0438\u0439 \u0434\u043e\u0441\u0432\u0456\u0434. \u0426\u0435 \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u043d\u044f \u0437\u043c\u0443\u0448\u0443\u0454 \u0433\u0440\u0430\u0432\u0446\u0456\u0432 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0447\u043d\u043e \u043c\u0438\u0441\u043b\u0438\u0442\u0438 \u0442\u0430 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u043a\u043e\u0436\u043d\u0443 \u0441\u043f\u0440\u043e\u0431\u0443 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043c\u0430\u044e\u0447\u0438 \u043b\u0438\u0448\u0435 \u0448\u0456\u0441\u0442\u044c \u0441\u043f\u0440\u043e\u0431, \u0432\u0438 \u043f\u043e\u0432\u0438\u043d\u043d\u0456 \u043d\u0430\u0441\u0430\u043c\u043f\u0435\u0440\u0435\u0434 \u0432\u0438\u0431\u0438\u0440\u0430\u0442\u0438 \u0441\u043b\u043e\u0432\u0430, \u044f\u043a\u0456 \u043d\u0430\u0434\u0430\u044e\u0442\u044c \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448\u0435 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u0457 \u043f\u0440\u043e \u0440\u043e\u0437\u0442\u0430\u0448\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u0430 \u0447\u0430\u0441\u0442\u043e\u0442\u0443 \u043b\u0456\u0442\u0435\u0440. \u0426\u0435 \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u043d\u044f \u0434\u043e\u0434\u0430\u0454 \u0433\u043b\u0438\u0431\u0438\u043d\u0438 \u0433\u0440\u0456, \u0440\u043e\u0431\u043b\u044f\u0447\u0438 \u043a\u043e\u0436\u043d\u0443 \u0441\u043f\u0440\u043e\u0431\u0443 \u043a\u0440\u0438\u0442\u0438\u0447\u043d\u0438\u043c \u0440\u0456\u0448\u0435\u043d\u043d\u044f\u043c."}, {"question": "\u042f\u043a \u044f \u043c\u043e\u0436\u0443 \u043f\u043e\u043a\u0440\u0430\u0449\u0438\u0442\u0438 \u0441\u0432\u043e\u044e \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u044e Word Hurdle \u043f\u0456\u0441\u043b\u044f 100 \u0433\u043e\u0434\u0438\u043d \u0433\u0440\u0438?", "answer": "\u041f\u0456\u0441\u043b\u044f 100 \u0433\u043e\u0434\u0438\u043d \u0433\u0440\u0438, \u0432\u0434\u043e\u0441\u043a\u043e\u043d\u0430\u043b\u0435\u043d\u043d\u044f \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0457 \u043f\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0430\u0454 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0440\u043e\u0437\u0448\u0438\u0440\u0435\u043d\u0438\u0445 \u0442\u0435\u0445\u043d\u0456\u043a. \u041a\u0440\u043e\u043a 1: \u0410\u043d\u0430\u043b\u0456\u0437\u0443\u0439\u0442\u0435 \u0437\u0430\u043a\u043e\u043d\u043e\u043c\u0456\u0440\u043d\u043e\u0441\u0442\u0456 \u0447\u0430\u0441\u0442\u043e\u0442\u0438 \u0441\u043b\u0456\u0432. \u041a\u0440\u043e\u043a 2: \u0415\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0456\u0448\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u043c\u0435\u0442\u043e\u0434 \u0432\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f, \u0432\u0456\u0434\u0441\u0442\u0435\u0436\u0443\u044e\u0447\u0438 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u0456 \u043b\u0456\u0442\u0435\u0440\u0438. \u041a\u0440\u043e\u043a 3: \u0412\u043f\u0440\u043e\u0432\u0430\u0434\u0436\u0443\u0439\u0442\u0435 \u0439\u043c\u043e\u0432\u0456\u0440\u043d\u0456\u0441\u043d\u0435 \u043c\u0438\u0441\u043b\u0435\u043d\u043d\u044f, \u0449\u043e\u0431 \u0432\u0433\u0430\u0434\u0443\u0432\u0430\u0442\u0438 \u0441\u043b\u043e\u0432\u0430, \u044f\u043a\u0456 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u043d\u043e \u0431\u0456\u043b\u044c\u0448 \u0439\u043c\u043e\u0432\u0456\u0440\u043d\u0456. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u044f\u043a\u0449\u043e \u0432\u0438 \u0437\u043d\u0430\u0454\u0442\u0435, \u0449\u043e \u043b\u0456\u0442\u0435\u0440\u0430 \"\u0415\" \u0447\u0430\u0441\u0442\u043e \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u0454\u0442\u044c\u0441\u044f, \u043d\u0430\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u043f\u0435\u0440\u0435\u0432\u0430\u0433\u0443 \u0441\u043b\u043e\u0432\u0430\u043c \u0437 \"\u0415\" \u043d\u0430 \u0434\u0440\u0443\u0433\u043e\u043c\u0443 \u043c\u0456\u0441\u0446\u0456. \u0426\u0435\u0439 \u0431\u0430\u0433\u0430\u0442\u043e\u0441\u0442\u0443\u043f\u0435\u043d\u0435\u0432\u0438\u0439 \u043f\u0456\u0434\u0445\u0456\u0434 \u043f\u043e\u043a\u0440\u0430\u0449\u0443\u0454 \u0432\u0430\u0448\u0443 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c \u0456 \u0442\u043e\u0447\u043d\u0456\u0441\u0442\u044c."}, {"question": "\u0423 \u0447\u043e\u043c\u0443 \u043a\u043b\u044e\u0447\u043e\u0432\u0456 \u0432\u0456\u0434\u043c\u0456\u043d\u043d\u043e\u0441\u0442\u0456 \u043c\u0456\u0436 Word Hurdle \u0442\u0430 \u0442\u0440\u0430\u0434\u0438\u0446\u0456\u0439\u043d\u0438\u043c\u0438 \u0441\u043b\u043e\u0432\u0430\u043c\u0438 \u0456\u0433\u0440\u0430\u043c\u0438?", "answer": "Word Hurdle \u0432\u0456\u0434\u0440\u0456\u0437\u043d\u044f\u0454\u0442\u044c\u0441\u044f \u0432\u0456\u0434 \u0442\u0440\u0430\u0434\u0438\u0446\u0456\u0439\u043d\u0438\u0445 \u0456\u0433\u043e\u0440 \u0437\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0438 \u0441\u0432\u043e\u0454\u044e \u0441\u043f\u0440\u044f\u043c\u043e\u0432\u0430\u043d\u0456\u0441\u0442\u044e \u043d\u0430 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c \u0442\u0430 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u044e. \u041d\u0430 \u0432\u0456\u0434\u043c\u0456\u043d\u0443 \u0432\u0456\u0434 \u0421\u043a\u0440\u0435\u0431\u043b, \u044f\u043a\u0438\u0439 \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0436\u0443\u0454 \u0441\u043a\u043b\u0430\u0434\u043d\u0456\u0441\u0442\u044c \u0441\u043b\u0456\u0432, Word Hurdle \u043d\u0430\u0433\u043e\u043b\u043e\u0448\u0443\u0454 \u043d\u0430 \u0448\u0432\u0438\u0434\u043a\u0438\u0445 \u0442\u0430 \u0442\u043e\u0447\u043d\u0438\u0445 \u0432\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u043d\u044f\u0445. \u041a\u0440\u0456\u043c \u0442\u043e\u0433\u043e, \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u0430 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u0441\u043f\u0440\u043e\u0431 \u0443 Word Hurdle \u0434\u043e\u0434\u0430\u0454 \u0448\u0430\u0440 \u043d\u0430\u043f\u0440\u0443\u0433\u0438 \u0442\u0430 \u0442\u0435\u0440\u043c\u0456\u043d\u043e\u0432\u043e\u0441\u0442\u0456. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0432\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u043d\u044f \u0441\u043b\u043e\u0432\u0430 \"\u0420\u041e\u0421\u041b\u0418\u041d\u0410\" \u0437\u0430 \u0442\u0440\u0438 \u0441\u043f\u0440\u043e\u0431\u0438 \u0431\u0456\u043b\u044c\u0448 \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0436\u0443\u0454\u0442\u044c\u0441\u044f, \u043d\u0456\u0436 \u0437\u0430 \u0448\u0456\u0441\u0442\u044c \u0441\u043f\u0440\u043e\u0431, \u0449\u043e \u043f\u0456\u0434\u043a\u0440\u0435\u0441\u043b\u044e\u0454 \u0443\u043d\u0456\u043a\u0430\u043b\u044c\u043d\u0443 \u043c\u0435\u0445\u0430\u043d\u0456\u043a\u0443 \u043d\u0430\u0440\u0430\u0445\u0443\u0432\u0430\u043d\u043d\u044f \u0431\u0430\u043b\u0456\u0432 \u0443 \u0433\u0440\u0456."}, {"question": "\u041d\u0430 \u044f\u043a\u0438\u0445 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430\u0445 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 Word Hurdle \u0442\u0430 \u044f\u043a \u0432\u043e\u043d\u0438 \u043f\u043e\u0440\u0456\u0432\u043d\u044e\u044e\u0442\u044c\u0441\u044f?", "answer": "Word Hurdle \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u043d\u0430 \u0431\u0430\u0433\u0430\u0442\u044c\u043e\u0445 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430\u0445, \u0437\u043e\u043a\u0440\u0435\u043c\u0430 \u0432 \u0432\u0435\u0431-\u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0430\u0445 \u0442\u0430 \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0438\u0445 \u0434\u043e\u0434\u0430\u0442\u043a\u0430\u0445. \u0412\u0435\u0431-\u0432\u0435\u0440\u0441\u0456\u044f \u043f\u0440\u043e\u043f\u043e\u043d\u0443\u0454 \u0431\u0456\u043b\u044c\u0448\u0438\u0439 \u0435\u043a\u0440\u0430\u043d \u0434\u043b\u044f \u0437\u0440\u0443\u0447\u043d\u0456\u0448\u043e\u0433\u043e \u0432\u0456\u0434\u0441\u0442\u0435\u0436\u0435\u043d\u043d\u044f \u043b\u0456\u0442\u0435\u0440, \u0442\u043e\u0434\u0456 \u044f\u043a \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0438\u0439 \u0434\u043e\u0434\u0430\u0442\u043e\u043a \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0443\u0454 \u0437\u0440\u0443\u0447\u043d\u0456\u0441\u0442\u044c \u0442\u0430 \u043f\u043e\u0440\u0442\u0430\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0433\u0440\u0430 \u043d\u0430 \u043f\u043b\u0430\u043d\u0448\u0435\u0442\u0456 \u043c\u043e\u0436\u0435 \u0437\u0430\u043f\u0440\u043e\u043f\u043e\u043d\u0443\u0432\u0430\u0442\u0438 \u0431\u0430\u043b\u0430\u043d\u0441 \u043c\u0456\u0436 \u0440\u043e\u0437\u043c\u0456\u0440\u043e\u043c \u0435\u043a\u0440\u0430\u043d\u0430 \u0442\u0430 \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0456\u0441\u0442\u044e. \u041a\u043e\u0436\u043d\u0430 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430 \u043c\u0430\u0454 \u0441\u0432\u043e\u0457 \u043f\u0435\u0440\u0435\u0432\u0430\u0433\u0438, \u0442\u043e\u043c\u0443 \u0432\u0438\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u043e \u0434\u043e \u0432\u0430\u0448\u043e\u0433\u043e \u0443\u043b\u044e\u0431\u043b\u0435\u043d\u043e\u0433\u043e \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0430 \u0433\u0440\u0438."}, {"question": "\u042f\u043a \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c Word Hurdle \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u0454 \u0449\u043e\u0434\u0435\u043d\u043d\u0435 \u0441\u043b\u043e\u0432\u043e?", "answer": "\u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c Word Hurdle \u043e\u0431\u0438\u0440\u0430\u0454 \u0449\u043e\u0434\u0435\u043d\u043d\u0435 \u0441\u043b\u043e\u0432\u043e \u0437 \u043f\u0435\u0440\u0435\u043b\u0456\u043a\u0443 \u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0438\u0445 \u043f'\u044f\u0442\u0438\u0431\u0443\u043a\u0432\u0435\u043d\u0438\u0445 \u0441\u043b\u0456\u0432. \u0421\u043b\u043e\u0432\u043e \u0432\u0438\u0431\u0438\u0440\u0430\u0454\u0442\u044c\u0441\u044f \u0434\u043b\u044f \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f \u0431\u0430\u043b\u0430\u043d\u0441\u0443 \u043c\u0456\u0436 \u0441\u043a\u043b\u0430\u0434\u043d\u0456\u0441\u0442\u044e \u0442\u0430 \u0433\u0440\u0430\u0432\u0456\u044e\u0432\u0430\u043d\u043d\u044f\u043c. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0441\u043b\u043e\u0432\u043e \"\u041a\u0420\u0410\u041d\" \u043c\u043e\u0436\u043d\u0430 \u0432\u0438\u0431\u0440\u0430\u0442\u0438, \u0442\u043e\u043c\u0443 \u0449\u043e \u0432\u043e\u043d\u043e \u043c\u0456\u0441\u0442\u0438\u0442\u044c \u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0456 \u043b\u0456\u0442\u0435\u0440\u0438, \u0449\u043e \u0440\u043e\u0431\u0438\u0442\u044c \u0439\u043e\u0433\u043e \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u043c \u0442\u0430 \u0441\u043a\u043b\u0430\u0434\u043d\u0438\u043c \u043e\u0434\u043d\u043e\u0447\u0430\u0441\u043d\u043e. \u0410\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u0442\u0430\u043a\u043e\u0436 \u0433\u0430\u0440\u0430\u043d\u0442\u0443\u0454 \u0437\u043c\u0456\u043d\u0443 \u0441\u043b\u043e\u0432\u0430 \u0449\u043e\u0434\u043d\u044f, \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u044e\u0447\u0438 \u0440\u0456\u0437\u043d\u043e\u043c\u0430\u043d\u0456\u0442\u043d\u0456\u0441\u0442\u044c \u0442\u0430 \u043f\u043e\u0432\u0442\u043e\u0440\u044e\u0432\u0430\u043d\u0456\u0441\u0442\u044c."}, {"question": "\u042f\u043a\u0456 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 \u0444\u0443\u043d\u043a\u0446\u0456\u0457 \u043c\u043e\u0436\u0443\u0442\u044c \u043f\u043e\u043a\u0440\u0430\u0449\u0438\u0442\u0438 \u043c\u0456\u0439 \u0434\u043e\u0441\u0432\u0456\u0434 Word Hurdle?", "answer": "Word Hurdle \u0432\u043a\u043b\u044e\u0447\u0430\u0454 \u043a\u0456\u043b\u044c\u043a\u0430 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0438\u0445 \u0444\u0443\u043d\u043a\u0446\u0456\u0439, \u044f\u043a\u0456 \u043c\u043e\u0436\u0443\u0442\u044c \u043f\u043e\u043a\u0440\u0430\u0449\u0438\u0442\u0438 \u0433\u0440\u0443. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0433\u0440\u0430 \u0432\u0456\u0434\u0441\u0442\u0435\u0436\u0443\u0454 \u0432\u0430\u0448\u0443 \u0456\u0441\u0442\u043e\u0440\u0456\u044e \u0432\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u044c, \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0447\u0438 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u044e \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c \u0442\u0430 \u0432\u0438\u044f\u0432\u0438\u0442\u0438 \u0437\u0430\u043a\u043e\u043d\u043e\u043c\u0456\u0440\u043d\u043e\u0441\u0442\u0456. \u041a\u0440\u0456\u043c \u0442\u043e\u0433\u043e, \u0456\u0441\u043d\u0443\u044e\u0442\u044c \u0441\u0435\u043a\u0440\u0435\u0442\u043d\u0456 \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u0437\u0430 \u0443\u043d\u0456\u043a\u0430\u043b\u044c\u043d\u0456 \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f, \u0442\u0430\u043a\u0456 \u044f\u043a \u0432\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u0433\u043e \u0441\u043b\u043e\u0432\u0430 \u0437 \u043f\u0435\u0440\u0448\u043e\u0457 \u0441\u043f\u0440\u043e\u0431\u0438. \u0414\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u044f \u0446\u0438\u0445 \u0444\u0443\u043d\u043a\u0446\u0456\u0439 \u043c\u043e\u0436\u0435 \u0434\u043e\u0434\u0430\u0442\u0438 \u0433\u043b\u0438\u0431\u0438\u043d\u0438 \u0442\u0430 \u0437\u0430\u0434\u043e\u0432\u043e\u043b\u0435\u043d\u043d\u044f \u0432\u0430\u0448\u043e\u043c\u0443 \u0434\u043e\u0441\u0432\u0456\u0434\u0443 Word Hurdle."}, {"question": "\u042f\u043a \u044f \u043c\u043e\u0436\u0443 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0442\u0438 \u0441\u0432\u0456\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441 Word Hurdle \u043d\u0430 \u0440\u0456\u0437\u043d\u0456 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u0457?", "answer": "\u041f\u0435\u0440\u0435\u043d\u0435\u0441\u0435\u043d\u043d\u044f \u0432\u0430\u0448\u043e\u0433\u043e \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0443 Word Hurdle \u2013 \u0446\u0435 \u043f\u0440\u043e\u0441\u0442\u043e, \u044f\u043a\u0449\u043e \u0432\u0438 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454\u0442\u0435 \u0442\u043e\u0439 \u0441\u0430\u043c\u0438\u0439 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441 \u043d\u0430 \u0440\u0456\u0437\u043d\u0438\u0445 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044f\u0445. \u041f\u0440\u043e\u0441\u0442\u043e \u0443\u0432\u0456\u0439\u0434\u0456\u0442\u044c \u0437 \u0432\u0430\u0448\u0438\u043c\u0438 \u0440\u0435\u043a\u0432\u0456\u0437\u0438\u0442\u0430\u043c\u0438 \u043d\u0430 \u043d\u043e\u0432\u043e\u043c\u0443 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u0457, \u0456 \u0432\u0430\u0448 \u043f\u0440\u043e\u0433\u0440\u0435\u0441 \u0431\u0443\u0434\u0435 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0456\u0437\u043e\u0432\u0430\u043d\u043e. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u044f\u043a\u0449\u043e \u0432\u0438 \u043f\u0435\u0440\u0435\u0439\u0434\u0435\u0442\u0435 \u0437 \u0432\u0435\u0431-\u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0430 \u043d\u0430 \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0438\u0439 \u0434\u043e\u0434\u0430\u0442\u043e\u043a, \u0432\u0430\u0448\u0430 \u0456\u0441\u0442\u043e\u0440\u0456\u044f \u0432\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u044c \u0442\u0430 \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0442\u0438\u043c\u0443\u0442\u044c\u0441\u044f. \u0426\u044f \u0431\u0435\u0437\u0448\u043e\u0432\u043d\u0430 \u0456\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0456\u044f \u0433\u0430\u0440\u0430\u043d\u0442\u0443\u0454 \u0441\u0442\u0430\u0431\u0456\u043b\u044c\u043d\u0438\u0439 \u0434\u043e\u0441\u0432\u0456\u0434 \u043d\u0435\u0437\u0430\u043b\u0435\u0436\u043d\u043e \u0432\u0456\u0434 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0438."}, {"question": "\u042f\u043a\u0456 \u043d\u0430\u0439\u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0456\u0448\u0456 \u043f\u043e\u043c\u0438\u043b\u043a\u0438 \u0434\u043b\u044f \u043d\u043e\u0432\u0438\u0445 \u0433\u0440\u0430\u0432\u0446\u0456\u0432 Word Hurdle \u0442\u0430 \u044f\u043a \u0457\u0445 \u0443\u043d\u0438\u043a\u043d\u0443\u0442\u0438?", "answer": "\u041d\u043e\u0432\u0456 \u0433\u0440\u0430\u0432\u0446\u0456 \u0447\u0430\u0441\u0442\u043e \u043f\u043e\u0442\u0440\u0430\u043f\u043b\u044f\u044e\u0442\u044c \u0443 \u043f\u0430\u0441\u0442\u043a\u0438, \u0442\u0430\u043a\u0456 \u044f\u043a \u0432\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u043d\u044f \u0432\u0438\u043f\u0430\u0434\u043a\u043e\u0432\u0438\u0445 \u0441\u043b\u0456\u0432 \u0430\u0431\u043e \u0456\u0433\u043d\u043e\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0447\u0430\u0441\u0442\u043e\u0442\u0438 \u043b\u0456\u0442\u0435\u0440. \u0429\u043e\u0431 \u0443\u043d\u0438\u043a\u043d\u0443\u0442\u0438 \u0446\u044c\u043e\u0433\u043e, \u043f\u043e\u0447\u0438\u043d\u0430\u0439\u0442\u0435 \u0437\u0456 \u0441\u043b\u0456\u0432, \u044f\u043a\u0456 \u043c\u0456\u0441\u0442\u044f\u0442\u044c \u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0456 \u0433\u043e\u043b\u043e\u0441\u043d\u0456 \u0442\u0430 \u043f\u0440\u0438\u0433\u043e\u043b\u043e\u0441\u043d\u0456, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \"\u0421\u041b\u041e\u0412\u041e\". \u041a\u0440\u0456\u043c \u0442\u043e\u0433\u043e, \u0432\u0456\u0434\u0441\u0442\u0435\u0436\u0443\u0439\u0442\u0435, \u044f\u043a\u0456 \u043b\u0456\u0442\u0435\u0440\u0438 \u0431\u0443\u043b\u0438 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u0456, \u0449\u043e\u0431 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u0432\u0438\u043a\u043b\u044e\u0447\u0438\u0442\u0438 \u043c\u043e\u0436\u043b\u0438\u0432\u043e\u0441\u0442\u0456. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u044f\u043a\u0449\u043e \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043d\u043e \"\u0410\" \u0442\u0430 \"\u0415\", \u0437\u043e\u0441\u0435\u0440\u0435\u0434\u044c\u0442\u0435\u0441\u044f \u043d\u0430 \u0441\u043b\u043e\u0432\u0430\u0445, \u044f\u043a\u0456 \u043c\u0456\u0441\u0442\u044f\u0442\u044c \u0446\u0456 \u043b\u0456\u0442\u0435\u0440\u0438. \u0422\u0430\u043a\u0438\u0439 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0447\u043d\u0438\u0439 \u043f\u0456\u0434\u0445\u0456\u0434 \u043c\u0456\u043d\u0456\u043c\u0456\u0437\u0443\u0454 \u043c\u0430\u0440\u043d\u043e \u0432\u0438\u0442\u0440\u0430\u0447\u0435\u043d\u0456 \u0441\u043f\u0440\u043e\u0431\u0438 \u0442\u0430 \u043f\u043e\u043a\u0440\u0430\u0449\u0443\u0454 \u0439\u043c\u043e\u0432\u0456\u0440\u043d\u0456\u0441\u0442\u044c \u0443\u0441\u043f\u0456\u0445\u0443."}]
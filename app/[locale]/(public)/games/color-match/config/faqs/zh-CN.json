[{"question": "\u521d\u5b66\u8005\u5982\u4f55\u5728\u989c\u8272\u5339\u914d\u6e38\u620f\u4e2d\u8fdb\u884c\u57fa\u7840\u989c\u8272\u5339\u914d\uff1f", "answer": "\u5728\u989c\u8272\u5339\u914d\u6e38\u620f\u4e2d\u8fdb\u884c\u57fa\u7840\u989c\u8272\u5339\u914d\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u8bc6\u522b\u5c4f\u5e55\u4e0a\u663e\u793a\u7684\u76ee\u6807\u989c\u8272\u3002\u6b65\u9aa42\uff1a\u4ece\u63d0\u4f9b\u7684\u9009\u9879\u4e2d\u70b9\u51fb\u76f8\u5e94\u7684\u989c\u8272\u65b9\u5757\u3002\u6b65\u9aa43\uff1a\u901a\u8fc7\u53cc\u51fb\u786e\u8ba4\u60a8\u7684\u9009\u62e9\u5e76\u5c06\u5176\u9501\u5b9a\u3002\u4f8b\u5982\uff0c\u5982\u679c\u76ee\u6807\u989c\u8272\u662f\u84dd\u8272\uff0c\u8bf7\u70b9\u51fb\u84dd\u8272\u7684\u65b9\u5757\u3002\u8fd9\u4e2a\u7b80\u5355\u7684\u8fc7\u7a0b\u6709\u52a9\u4e8e\u60a8\u719f\u6089\u6e38\u620f\u673a\u5236\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u53ef\u4ee5\u5c06\u5b83\u60f3\u8c61\u6210\u6309\u989c\u8272\u5339\u914d\u889c\u5b50\u2014\u2014\u7b80\u5355\u76f4\u89c2\u3002]"}, {"question": "\u5728\u989c\u8272\u5339\u914d\u6e38\u620f\u4e2d\uff0c\u65f6\u95f4\u4e3a\u4f55\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u63d0\u9ad8\u6211\u7684\u53cd\u5e94\u65f6\u95f4\uff1f", "answer": "\u5728\u989c\u8272\u5339\u914d\u6e38\u620f\u4e2d\uff0c\u65f6\u95f4\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u4f1a\u5f71\u54cd\u60a8\u7684\u5206\u6570\u548c\u8fde\u51fb\u500d\u6570\u3002\u8981\u63d0\u9ad8\u60a8\u7684\u53cd\u5e94\u65f6\u95f4\uff1a\u6b65\u9aa41\uff1a\u7ec3\u4e60\u5feb\u901f\u8bc6\u522b\u989c\u8272\u3002\u6b65\u9aa42\uff1a\u901a\u8fc7\u6301\u7eed\u70b9\u51fb\u5efa\u7acb\u8282\u594f\u611f\u3002\u6b65\u9aa43\uff1a\u5229\u7528\u6e38\u620f\u7684\u58f0\u97f3\u63d0\u793a\u6765\u9884\u6d4b\u4e0b\u4e00\u6b65\u64cd\u4f5c\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u542c\u5230\u4e00\u58f0\u8702\u9e23\u58f0\uff0c\u8bf7\u51c6\u5907\u597d\u70b9\u51fb\u4e0b\u4e00\u4e2a\u989c\u8272\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6162\u901f\u70b9\u51fb\u8005\u5f9750\u5206\uff0c\u5feb\u901f\u70b9\u51fb\u8005\u5f97100\u5206\u3002]"}, {"question": "\u989c\u8272\u5339\u914d\u6e38\u620f\u4e2d\u7684\u7b80\u5355\u6a21\u5f0f\u548c\u56f0\u96be\u6a21\u5f0f\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u989c\u8272\u5339\u914d\u6e38\u620f\u4e2d\u7684\u7b80\u5355\u6a21\u5f0f\u548c\u56f0\u96be\u6a21\u5f0f\u7684\u5173\u952e\u533a\u522b\u5728\u4e8e\u901f\u5ea6\u548c\u590d\u6742\u6027\u3002\u5728\u7b80\u5355\u6a21\u5f0f\u4e2d\uff0c\u989c\u8272\u53d8\u5316\u7f13\u6162\uff0c\u9009\u9879\u8f83\u5c11\u3002\u5728\u56f0\u96be\u6a21\u5f0f\u4e2d\uff0c\u989c\u8272\u53d8\u5316\u8fc5\u901f\uff0c\u53ef\u4f9b\u9009\u62e9\u7684\u9009\u9879\u66f4\u591a\u3002\u4f8b\u5982\uff0c\u7b80\u5355\u6a21\u5f0f\u53ef\u80fd\u663e\u793a3\u79cd\u989c\u8272\uff0c\u800c\u56f0\u96be\u6a21\u5f0f\u5219\u663e\u793a6\u79cd\u989c\u8272\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u7b80\u5355\u6a21\u5f0f\u5c31\u50cf\u6563\u6b65\uff1b\u56f0\u96be\u6a21\u5f0f\u5c31\u50cf\u51b2\u523a\u3002]"}, {"question": "\u5982\u4f55\u5236\u5b9a\u7b56\u7565\u5728\u989c\u8272\u5339\u914d\u6e38\u620f\u4e2d\u6301\u7eed\u83b7\u5f97\u9ad8\u5206\uff1f", "answer": "\u8981\u5728\u989c\u8272\u5339\u914d\u6e38\u620f\u4e2d\u6301\u7eed\u83b7\u5f97\u9ad8\u5206\uff0c\u8bf7\u9075\u5faa\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9aa41\uff1a\u638c\u63e1\u5feb\u901f\u8bc6\u522b\u989c\u8272\u7684\u6280\u5de7\u3002\u6b65\u9aa42\uff1a\u901a\u8fc7\u4e0d\u6f0f\u6389\u4efb\u4f55\u5339\u914d\u6765\u5efa\u7acb\u548c\u4fdd\u6301\u8fde\u51fb\u3002\u6b65\u9aa43\uff1a\u6218\u7565\u6027\u5730\u4f7f\u7528\u9053\u5177\u6765\u63d0\u5347\u60a8\u7684\u5206\u6570\u3002\u4f8b\u5982\uff0c\u5728\u9ad8\u8fde\u51fb\u671f\u95f4\u4f7f\u7528\u201c\u53cc\u500d\u79ef\u5206\u201d\u9053\u5177\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u8bc6\u522b -> \u5339\u914d -> \u8fde\u51fb -> \u9053\u5177 -> \u9ad8\u5206\u3002]"}, {"question": "\u5728\u989c\u8272\u5339\u914d\u6e38\u620f\u4e2d\uff0c\u54ea\u4e9b\u9053\u5177\u6700\u6709\u6548\uff0c\u4ee5\u53ca\u4f55\u65f6\u5e94\u8be5\u4f7f\u7528\u5b83\u4eec\uff1f", "answer": "\u989c\u8272\u5339\u914d\u6e38\u620f\u4e2d\u6700\u6709\u6548\u7684\u9053\u5177\u662f\u201c\u53cc\u500d\u79ef\u5206\u201d\u548c\u201c\u65f6\u95f4\u6682\u505c\u201d\u3002\u5728\u9ad8\u8fde\u51fb\u671f\u95f4\u4f7f\u7528\u201c\u53cc\u500d\u79ef\u5206\u201d\u6765\u6700\u5927\u5316\u60a8\u7684\u5206\u6570\u3002\u5f53\u989c\u8272\u7684\u53d8\u5316\u901f\u5ea6\u8fc7\u5feb\u800c\u65e0\u6cd5\u8ddf\u4e0a\u65f6\uff0c\u4f7f\u7528\u201c\u65f6\u95f4\u6682\u505c\u201d\u9053\u5177\u3002\u4f8b\u5982\uff0c\u5f53\u60a8\u670910\u500d\u8fde\u51fb\u500d\u6570\u65f6\uff0c\u6fc0\u6d3b\u201c\u65f6\u95f4\u6682\u505c\u201d\u9053\u5177\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u201d\u53cc\u500d\u79ef\u5206\u201d\u7528\u4e8e\u5f97\u5206\uff0c\u201c\u65f6\u95f4\u6682\u505c\u201d\u7528\u4e8e\u751f\u5b58\u3002]"}, {"question": "\u989c\u8272\u5339\u914d\u6e38\u620f\u7684\u8ba1\u5206\u673a\u5236\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\uff1f", "answer": "\u989c\u8272\u5339\u914d\u6e38\u620f\u7684\u8ba1\u5206\u673a\u5236\u57fa\u4e8e\u51c6\u786e\u6027\u3001\u901f\u5ea6\u548c\u8fde\u51fb\u500d\u6570\u3002\u6bcf\u4e2a\u6b63\u786e\u7684\u5339\u914d\u90fd\u4f1a\u5956\u52b1\u5206\u6570\uff0c\u901f\u5ea6\u8d8a\u5feb\u7684\u5339\u914d\u83b7\u5f97\u7684\u5206\u6570\u8d8a\u9ad8\u3002\u8fde\u51fb\u500d\u6570\u4f1a\u968f\u7740\u8fde\u7eed\u6b63\u786e\u7684\u5339\u914d\u800c\u589e\u52a0\u3002\u4f8b\u5982\uff0c\u5177\u67095\u500d\u8fde\u51fb\u500d\u6570\u7684\u5339\u914d\u5c06\u5956\u52b1500\u5206\uff0c\u800c\u4e0d\u662f100\u5206\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6162\u901f\u5339\u914d = 50 \u5206\uff0c\u5feb\u901f\u5339\u914d = 100 \u5206\uff0c5 \u500d\u8fde\u51fb = 500 \u5206\u3002]"}, {"question": "\u989c\u8272\u5339\u914d\u6e38\u620f\u4e2d\u7684\u989c\u8272\u7b97\u6cd5\u662f\u5982\u4f55\u5de5\u4f5c\u7684\uff0c\u53ef\u4ee5\u9884\u6d4b\u5417\uff1f", "answer": "\u989c\u8272\u5339\u914d\u6e38\u620f\u4e2d\u7684\u989c\u8272\u7b97\u6cd5\u4f7f\u7528\u4f2a\u968f\u673a\u751f\u6210\u5668\u6765\u786e\u5b9a\u989c\u8272\u7684\u5e8f\u5217\u3002\u867d\u7136\u5b83\u8bbe\u8ba1\u5f97\u96be\u4ee5\u9884\u6d4b\uff0c\u4f46\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u6709\u65f6\u53ef\u4ee5\u6839\u636e\u4e4b\u524d\u7684\u5e8f\u5217\u9884\u6d4b\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u5982\u679c\u7ea2\u8272\u8fde\u7eed\u51fa\u73b0\u4e09\u6b21\uff0c\u90a3\u4e48\u84dd\u8272\u53ef\u80fd\u5c31\u662f\u4e0b\u4e00\u4e2a\u989c\u8272\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u8fd9\u5c31\u50cf\u9884\u6d4b\u4e00\u526f\u6d17\u597d\u7684\u724c\u4e2d\u7684\u4e0b\u4e00\u5f20\u724c\u2014\u2014\u5b83\u5927\u591a\u662f\u968f\u673a\u7684\uff0c\u4f46\u5076\u5c14\u53ef\u4ee5\u9884\u6d4b\u3002]"}, {"question": "\u6211\u53ef\u4ee5\u5728\u4e0d\u540c\u7684\u8bbe\u5907\u4e4b\u95f4\u8f6c\u79fb\u6211\u7684\u989c\u8272\u5339\u914d\u6e38\u620f\u8fdb\u5ea6\u5417\uff1f", "answer": "\u662f\u7684\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u5c06\u6e38\u620f\u94fe\u63a5\u5230\u4e91\u7aef\u8d26\u6237\u6765\u8f6c\u79fb\u60a8\u7684\u989c\u8272\u5339\u914d\u6e38\u620f\u8fdb\u5ea6\u3002\u6b65\u9aa41\uff1a\u8fdb\u5165\u8bbe\u7f6e\u83dc\u5355\uff0c\u7136\u540e\u9009\u62e9\u201c\u4e91\u4fdd\u5b58\u201d\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u60a8\u9009\u62e9\u7684\u4e91\u670d\u52a1\u767b\u5f55\uff08\u4f8b\u5982\uff0cGoogle Play\u3001Apple \u6e38\u620f\u4e2d\u5fc3\uff09\u3002\u6b65\u9aa43\uff1a\u6309\u7167\u63d0\u793a\u540c\u6b65\u60a8\u7684\u6570\u636e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u4ece iPhone \u5207\u6362\u5230 Android\uff0c\u60a8\u7684\u8fdb\u5ea6\u5c06\u4fdd\u7559\u4e0b\u6765\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u4e91\u4fdd\u5b58 = \u662f\uff0c\u672c\u5730\u4fdd\u5b58 = \u5426\u3002]"}, {"question": "\u989c\u8272\u5339\u914d\u6e38\u620f\u4e2d\u662f\u5426\u5b58\u5728\u9690\u85cf\u6210\u5c31\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9501\u5b83\u4eec\uff1f", "answer": "\u662f\u7684\uff0c\u989c\u8272\u5339\u914d\u6e38\u620f\u4e2d\u6709\u9690\u85cf\u7684\u6210\u5c31\uff0c\u9700\u8981\u6267\u884c\u7279\u5b9a\u7684\u64cd\u4f5c\u624d\u80fd\u89e3\u9501\u3002\u4f8b\u5982\uff0c\u201c\u989c\u8272\u5927\u5e08\u201d\u6210\u5c31\u9700\u8981\u5728\u5355\u6b21\u6e38\u620f\u4e2d\u5339\u914d 1000 \u79cd\u989c\u8272\u624d\u80fd\u89e3\u9501\u3002\u8981\u627e\u5230\u8fd9\u4e9b\u6210\u5c31\uff0c\u8bf7\u67e5\u770b\u6e38\u620f\u83dc\u5355\u4e2d\u7684\u201c\u6210\u5c31\u201d\u90e8\u5206\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u8fd9\u5c31\u50cf\u5bfb\u627e\u590d\u6d3b\u8282\u5f69\u86cb\u2014\u2014\u4f60\u5fc5\u987b\u4ed4\u7ec6\u89c2\u5bdf\u5e76\u5c1d\u8bd5\u4e0d\u540c\u7684\u65b9\u6cd5\u3002]"}, {"question": "\u989c\u8272\u5339\u914d\u6e38\u620f\u4e2d\u7684\u81ea\u9002\u5e94\u96be\u5ea6\u662f\u5982\u4f55\u6839\u636e\u6211\u7684\u6280\u80fd\u6c34\u5e73\u8fdb\u884c\u8c03\u6574\u7684\uff1f", "answer": "\u989c\u8272\u5339\u914d\u6e38\u620f\u4e2d\u7684\u81ea\u9002\u5e94\u96be\u5ea6\u4f1a\u6839\u636e\u60a8\u7684\u8868\u73b0\u8fdb\u884c\u8c03\u6574\u3002\u5982\u679c\u60a8\u6301\u7eed\u83b7\u5f97\u9ad8\u5206\uff0c\u6e38\u620f\u4f1a\u63d0\u9ad8\u989c\u8272\u53d8\u5316\u7684\u901f\u5ea6\u548c\u590d\u6742\u6027\u3002\u76f8\u53cd\uff0c\u5982\u679c\u60a8\u9047\u5230\u56f0\u96be\uff0c\u6e38\u620f\u4f1a\u964d\u4f4e\u96be\u5ea6\u3002\u4f8b\u5982\uff0c\u7ecf\u8fc7\u51e0\u6b21\u9ad8\u5206\u56de\u5408\u540e\uff0c\u60a8\u53ef\u80fd\u4f1a\u6ce8\u610f\u5230\u989c\u8272\u8f6c\u6362\u901f\u5ea6\u66f4\u5feb\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u9ad8\u5206 -> \u96be\u5ea6\u589e\u52a0\uff0c\u4f4e\u5206 -> \u96be\u5ea6\u964d\u4f4e\u3002]"}]
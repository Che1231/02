[{"question": "\u5982\u4f55\u4f5c\u70ba\u65b0\u624b\u5728\u300e\u8272\u5f69\u914d\u5c0d\u300f\u904a\u6232\u4e2d\u9032\u884c\u57fa\u672c\u7684\u8272\u5f69\u5339\u914d\uff1f", "answer": "\u5728\u300e\u8272\u5f69\u914d\u5c0d\u300f\u904a\u6232\u4e2d\u9032\u884c\u57fa\u672c\u7684\u8272\u5f69\u5339\u914d\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u8b58\u5225\u87a2\u5e55\u4e0a\u986f\u793a\u7684\u76ee\u6a19\u984f\u8272\u3002\u6b65\u9a5f2\uff1a\u9ede\u64ca\u63d0\u4f9b\u7684\u9078\u9805\u4e2d\u5c0d\u61c9\u7684\u984f\u8272\u65b9\u584a\u3002\u6b65\u9a5f3\uff1a\u96d9\u64ca\u78ba\u8a8d\u60a8\u7684\u9078\u64c7\uff0c\u5c07\u5176\u9396\u5b9a\u3002\u4f8b\u5982\uff0c\u5982\u679c\u76ee\u6a19\u984f\u8272\u662f\u85cd\u8272\uff0c\u8acb\u9ede\u64ca\u85cd\u8272\u65b9\u584a\u3002\u6b64\u7c21\u55ae\u904e\u7a0b\u6709\u52a9\u65bc\u60a8\u719f\u6089\u904a\u6232\u6a5f\u5236\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4e00\u4e0b\uff0c\u9019\u5c31\u50cf\u6839\u64da\u984f\u8272\u5339\u914d\u896a\u5b50\u4e00\u6a23\u2014\u2014\u7c21\u55ae\u76f4\u89c0\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u6642\u9593\u5728\u300e\u8272\u5f69\u914d\u5c0d\u300f\u904a\u6232\u4e2d\u5f88\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u6539\u5584\u6211\u7684\u53cd\u61c9\u6642\u9593\uff1f", "answer": "\u5728\u300e\u8272\u5f69\u914d\u5c0d\u300f\u904a\u6232\u4e2d\uff0c\u6642\u9593\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6703\u5f71\u97ff\u60a8\u7684\u5206\u6578\u548c\u9023\u64ca\u500d\u6578\u3002\u8981\u6539\u5584\u60a8\u7684\u53cd\u61c9\u6642\u9593\uff1a\u6b65\u9a5f1\uff1a\u7df4\u7fd2\u5feb\u901f\u8b58\u5225\u984f\u8272\u3002\u6b65\u9a5f2\uff1a\u900f\u904e\u6301\u7e8c\u9ede\u64ca\u5efa\u7acb\u7bc0\u594f\u3002\u6b65\u9a5f3\uff1a\u5229\u7528\u904a\u6232\u7684\u97f3\u6548\u63d0\u793a\u4f86\u9810\u6e2c\u4e0b\u4e00\u6b65\u52d5\u4f5c\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u807d\u5230\u55f6\u8072\uff0c\u8acb\u6e96\u5099\u9ede\u64ca\u4e0b\u4e00\u500b\u984f\u8272\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6162\u901f\u9ede\u64ca\u8005\u7372\u5f97 50 \u5206\uff0c\u5feb\u901f\u9ede\u64ca\u8005\u7372\u5f97 100 \u5206\u3002]"}, {"question": "\u300e\u8272\u5f69\u914d\u5c0d\u300f\u904a\u6232\u7684\u7c21\u55ae\u6a21\u5f0f\u548c\u56f0\u96e3\u6a21\u5f0f\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "\u300e\u8272\u5f69\u914d\u5c0d\u300f\u904a\u6232\u7684\u7c21\u55ae\u6a21\u5f0f\u548c\u56f0\u96e3\u6a21\u5f0f\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u5305\u62ec\u901f\u5ea6\u548c\u8907\u96dc\u6027\u3002\u5728\u7c21\u55ae\u6a21\u5f0f\u4e2d\uff0c\u984f\u8272\u8b8a\u63db\u901f\u5ea6\u8f03\u6162\uff0c\u9078\u9805\u8f03\u5c11\u3002\u5728\u56f0\u96e3\u6a21\u5f0f\u4e2d\uff0c\u984f\u8272\u8b8a\u63db\u901f\u5ea6\u8f03\u5feb\uff0c\u60a8\u6709\u66f4\u591a\u9078\u9805\u53ef\u4f9b\u9078\u64c7\u3002\u4f8b\u5982\uff0c\u7c21\u55ae\u6a21\u5f0f\u53ef\u80fd\u986f\u793a 3 \u7a2e\u984f\u8272\uff0c\u800c\u56f0\u96e3\u6a21\u5f0f\u986f\u793a 6 \u7a2e\u984f\u8272\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u7c21\u55ae\u6a21\u5f0f\u5c31\u50cf\u6b65\u884c\uff1b\u56f0\u96e3\u6a21\u5f0f\u5c31\u50cf\u885d\u523a\u3002]"}, {"question": "\u5982\u4f55\u5236\u5b9a\u7b56\u7565\u624d\u80fd\u5728\u300e\u8272\u5f69\u914d\u5c0d\u300f\u904a\u6232\u4e2d\u6301\u7e8c\u7372\u5f97\u9ad8\u5206\uff1f", "answer": "\u8981\u5728\u300e\u8272\u5f69\u914d\u5c0d\u300f\u904a\u6232\u4e2d\u6301\u7e8c\u7372\u5f97\u9ad8\u5206\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9a5f1\uff1a\u638c\u63e1\u5feb\u901f\u8b58\u5225\u984f\u8272\u7684\u6280\u5de7\u3002\u6b65\u9a5f2\uff1a\u5efa\u7acb\u4e26\u7dad\u6301\u9023\u64ca\uff0c\u4e0d\u8981\u932f\u904e\u4efb\u4f55\u5339\u914d\u3002\u6b65\u9a5f3\uff1a\u7b56\u7565\u6027\u5730\u4f7f\u7528\u589e\u5f37\u9053\u5177\u4f86\u63d0\u5347\u60a8\u7684\u5206\u6578\u3002\u4f8b\u5982\uff0c\u5728\u9023\u64ca\u7387\u9ad8\u7684\u6642\u5019\u4f7f\u7528\u300c\u96d9\u500d\u5f97\u5206\u300d\u589e\u5f37\u9053\u5177\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u8b58\u5225 -> \u914d\u5c0d -> \u9023\u64ca -> \u589e\u5f37\u9053\u5177 -> \u9ad8\u5206\u3002]"}, {"question": "\u300e\u8272\u5f69\u914d\u5c0d\u300f\u904a\u6232\u4e2d\u54ea\u4e9b\u589e\u5f37\u9053\u5177\u6700\u6709\u6548\uff0c\u4ee5\u53ca\u4f55\u6642\u61c9\u8a72\u4f7f\u7528\u5b83\u5011\uff1f", "answer": "\u300e\u8272\u5f69\u914d\u5c0d\u300f\u904a\u6232\u4e2d\u6700\u6709\u6548\u7684\u589e\u5f37\u9053\u5177\u662f\u300c\u96d9\u500d\u5f97\u5206\u300d\u548c\u300c\u6642\u9593\u51cd\u7d50\u300d\u3002\u5728\u9023\u64ca\u7387\u9ad8\u7684\u6642\u5019\u4f7f\u7528\u300c\u96d9\u500d\u5f97\u5206\u300d\u4f86\u6700\u5927\u5316\u60a8\u7684\u5f97\u5206\u3002\u7576\u984f\u8272\u8b8a\u63db\u901f\u5ea6\u904e\u5feb\u800c\u7121\u6cd5\u8ddf\u4e0a\u6642\uff0c\u8acb\u4f7f\u7528\u300c\u6642\u9593\u51cd\u7d50\u300d\u3002\u4f8b\u5982\uff0c\u7576\u60a8\u6709 10 \u500d\u9023\u64ca\u734e\u52f5\u6642\u555f\u52d5\u300c\u6642\u9593\u51cd\u7d50\u300d\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u300c\u96d9\u500d\u5f97\u5206\u300d\u7528\u65bc\u5f97\u5206\uff0c\u300c\u6642\u9593\u51cd\u7d50\u300d\u7528\u65bc\u751f\u5b58\u3002]"}, {"question": "\u300e\u8272\u5f69\u914d\u5c0d\u300f\u904a\u6232\u7684\u8a08\u5206\u6a5f\u5236\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff1f", "answer": "\u300e\u8272\u5f69\u914d\u5c0d\u300f\u904a\u6232\u7684\u8a08\u5206\u6a5f\u5236\u57fa\u65bc\u6e96\u78ba\u5ea6\u3001\u901f\u5ea6\u548c\u9023\u64ca\u500d\u6578\u3002\u6bcf\u500b\u6b63\u78ba\u7684\u914d\u5c0d\u90fd\u6703\u7372\u5f97\u5206\u6578\uff0c\u5339\u914d\u901f\u5ea6\u8d8a\u5feb\u7372\u5f97\u7684\u5206\u6578\u8d8a\u591a\u3002\u9023\u64ca\u500d\u6578\u6703\u96a8\u8457\u9023\u7e8c\u6b63\u78ba\u5339\u914d\u800c\u589e\u52a0\u3002\u4f8b\u5982\uff0c5 \u500d\u9023\u64ca\u500d\u6578\u7684\u5339\u914d\u6703\u734e\u52f5 500 \u5206\uff0c\u800c\u4e0d\u662f 100 \u5206\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6162\u901f\u5339\u914d = 50 \u5206\uff0c\u5feb\u901f\u5339\u914d = 100 \u5206\uff0c5 \u500d\u9023\u64ca = 500 \u5206\u3002]"}, {"question": "\u300e\u8272\u5f69\u914d\u5c0d\u300f\u904a\u6232\u7684\u984f\u8272\u6f14\u7b97\u6cd5\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u4ee5\u53ca\u53ef\u4ee5\u9810\u6e2c\u55ce\uff1f", "answer": "\u300e\u8272\u5f69\u914d\u5c0d\u300f\u904a\u6232\u7684\u984f\u8272\u6f14\u7b97\u6cd5\u4f7f\u7528\u507d\u96a8\u6a5f\u751f\u6210\u5668\u4f86\u6c7a\u5b9a\u984f\u8272\u7684\u9806\u5e8f\u3002\u96d6\u7136\u5b83\u65e8\u5728\u4e0d\u53ef\u9810\u6e2c\uff0c\u4f46\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u6709\u6642\u53ef\u4ee5\u6839\u64da\u5148\u524d\u7684\u5e8f\u5217\u9810\u6e2c\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u5982\u679c\u7d05\u8272\u9023\u7e8c\u51fa\u73fe\u4e09\u6b21\uff0c\u4e0b\u4e00\u500b\u984f\u8272\u53ef\u80fd\u662f\u85cd\u8272\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u9019\u5c31\u50cf\u9810\u6e2c\u6d17\u724c\u5f8c\u64b2\u514b\u724c\u7684\u4e0b\u4e00\u5f35\u724c\u4e00\u6a23\u2014\u2014\u5b83\u5927\u591a\u662f\u96a8\u6a5f\u7684\uff0c\u4f46\u5076\u723e\u53ef\u4ee5\u9810\u6e2c\u3002]"}, {"question": "\u6211\u53ef\u4ee5\u5c07\u6211\u7684\u300e\u8272\u5f69\u914d\u5c0d\u300f\u904a\u6232\u9032\u5ea6\u5f9e\u4e00\u500b\u88dd\u7f6e\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u88dd\u7f6e\u55ce\uff1f", "answer": "\u662f\u7684\uff0c\u60a8\u53ef\u4ee5\u900f\u904e\u5c07\u904a\u6232\u9023\u7d50\u5230\u96f2\u7aef\u5e33\u6236\u5c07\u300e\u8272\u5f69\u914d\u5c0d\u300f\u904a\u6232\u9032\u5ea6\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u88dd\u7f6e\u3002\u6b65\u9a5f1\uff1a\u524d\u5f80\u8a2d\u5b9a\u9078\u55ae\uff0c\u9078\u64c7\u300c\u96f2\u7aef\u5132\u5b58\u300d\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u60a8\u504f\u597d\u7684\u96f2\u7aef\u670d\u52d9\u767b\u5165\uff08\u4f8b\u5982\uff0cGoogle Play\u3001Apple Game Center\uff09\u3002\u6b65\u9a5f3\uff1a\u6309\u7167\u63d0\u793a\u540c\u6b65\u60a8\u7684\u8cc7\u6599\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9e iPhone \u5207\u63db\u5230 Android\uff0c\u60a8\u7684\u9032\u5ea6\u5c07\u6703\u651c\u5e36\u904e\u4f86\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u96f2\u7aef\u5132\u5b58 = \u662f\uff0c\u672c\u5730\u5132\u5b58 = \u5426\u3002]"}, {"question": "\u300e\u8272\u5f69\u914d\u5c0d\u300f\u904a\u6232\u4e2d\u662f\u5426\u6709\u4efb\u4f55\u96b1\u85cf\u6210\u5c31\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9396\u5b83\u5011\uff1f", "answer": "\u662f\u7684\uff0c\u300e\u8272\u5f69\u914d\u5c0d\u300f\u904a\u6232\u4e2d\u6709\u96b1\u85cf\u6210\u5c31\uff0c\u9700\u8981\u7279\u5b9a\u52d5\u4f5c\u624d\u80fd\u89e3\u9396\u3002\u4f8b\u5982\uff0c\u300c\u8272\u5f69\u5927\u5e2b\u300d\u6210\u5c31\u9700\u5728\u55ae\u4e00\u904a\u6232\u904e\u7a0b\u4e2d\u5339\u914d 1000 \u7a2e\u984f\u8272\u624d\u80fd\u89e3\u9396\u3002\u8981\u627e\u5230\u9019\u4e9b\u6210\u5c31\uff0c\u8acb\u67e5\u770b\u904a\u6232\u9078\u55ae\u4e2d\u7684\u300c\u6210\u5c31\u300d\u90e8\u5206\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u9019\u5c31\u50cf\u5c0b\u627e\u5f69\u86cb\u4e00\u6a23\u2014\u2014\u60a8\u5fc5\u9808\u4ed4\u7d30\u89c0\u5bdf\uff0c\u5617\u8a66\u4e0d\u540c\u7684\u65b9\u6cd5\u3002]"}, {"question": "\u300e\u8272\u5f69\u914d\u5c0d\u300f\u904a\u6232\u7684\u9069\u61c9\u6027\u96e3\u5ea6\u662f\u5982\u4f55\u6839\u64da\u6211\u7684\u6280\u80fd\u6c34\u5e73\u8abf\u6574\u7684\uff1f", "answer": "\u300e\u8272\u5f69\u914d\u5c0d\u300f\u904a\u6232\u7684\u9069\u61c9\u6027\u96e3\u5ea6\u6839\u64da\u60a8\u7684\u8868\u73fe\u9032\u884c\u8abf\u6574\u3002\u5982\u679c\u60a8\u6301\u7e8c\u7372\u5f97\u9ad8\u5206\uff0c\u904a\u6232\u6703\u63d0\u9ad8\u984f\u8272\u8b8a\u63db\u7684\u901f\u5ea6\u548c\u8907\u96dc\u6027\u3002\u53cd\u4e4b\uff0c\u5982\u679c\u60a8\u8868\u73fe\u4e0d\u4f73\uff0c\u5b83\u6703\u964d\u4f4e\u96e3\u5ea6\u3002\u4f8b\u5982\uff0c\u7d93\u904e\u5e7e\u8f2a\u9ad8\u5206\u5f8c\uff0c\u60a8\u53ef\u80fd\u6703\u6ce8\u610f\u5230\u984f\u8272\u8f49\u63db\u901f\u5ea6\u66f4\u5feb\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u9ad8\u5206 -> \u96e3\u5ea6\u589e\u52a0\uff0c\u4f4e\u5206 -> \u96e3\u5ea6\u964d\u4f4e\u3002]"}]
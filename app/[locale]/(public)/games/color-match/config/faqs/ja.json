[{"question": "\u8272\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b2\u30fc\u30e0\u3067\u3001\u521d\u5fc3\u8005\u3068\u3057\u3066\u57fa\u672c\u7684\u306a\u8272\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u306f\u3069\u306e\u3088\u3046\u306b\u884c\u3044\u307e\u3059\u304b\uff1f", "answer": "\u8272\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b2\u30fc\u30e0\u3067\u3001\u57fa\u672c\u7684\u306a\u8272\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u3092\u884c\u3046\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\uff1aSTEP1\uff1a\u753b\u9762\u306b\u8868\u793a\u3055\u308c\u3066\u3044\u308b\u5bfe\u8c61\u306e\u8272\u3092\u8b58\u5225\u3057\u307e\u3059\u3002STEP2\uff1a\u63d0\u4f9b\u3055\u308c\u3066\u3044\u308b\u30aa\u30d7\u30b7\u30e7\u30f3\u306e\u8272\u30d6\u30ed\u30c3\u30af\u3092\u30bf\u30c3\u30d7\u3057\u307e\u3059\u3002STEP3\uff1a\u9078\u629e\u3092\u78ba\u5b9a\u3059\u308b\u306b\u306f\u3001\u30c0\u30d6\u30eb\u30bf\u30c3\u30d7\u3057\u3066\u30ed\u30c3\u30af\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5bfe\u8c61\u306e\u8272\u304c\u9752\u3067\u3042\u308c\u3070\u3001\u9752\u8272\u306e\u30d6\u30ed\u30c3\u30af\u3092\u30bf\u30c3\u30d7\u3057\u307e\u3059\u3002\u3053\u306e\u7c21\u5358\u306a\u624b\u9806\u3067\u3001\u30b2\u30fc\u30e0\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u6163\u308c\u3066\u3044\u305f\u3060\u3051\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u8272\u306e\u30bd\u30c3\u30af\u30b9\u3092\u8272\u3067\u5408\u308f\u305b\u308b\u3088\u3046\u306b\u3001\u7c21\u5358\u3067\u76f4\u611f\u7684\u3067\u3059\u3002]"}, {"question": "\u8272\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b2\u30fc\u30e0\u3067\u3001\u306a\u305c\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u306a\u306e\u3067\u3059\u304b\uff1f\u307e\u305f\u3001\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u6539\u5584\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u8272\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b2\u30fc\u30e0\u3067\u306f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u30b9\u30b3\u30a2\u3068\u30b3\u30f3\u30dc\u500d\u7387\u306b\u5f71\u97ff\u3059\u308b\u305f\u3081\u91cd\u8981\u3067\u3059\u3002\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u6539\u5584\u3059\u308b\u306b\u306f\uff1aSTEP1\uff1a\u8272\u306e\u7d20\u65e9\u3044\u8a8d\u8b58\u3092\u7df4\u7fd2\u3057\u307e\u3059\u3002STEP2\uff1a\u4e00\u8cab\u3057\u3066\u30bf\u30c3\u30d7\u3059\u308b\u3053\u3068\u3067\u30ea\u30ba\u30e0\u3092\u69cb\u7bc9\u3057\u307e\u3059\u3002STEP3\uff1a\u30b2\u30fc\u30e0\u306e\u97f3\u58f0\u306e\u30d2\u30f3\u30c8\u3092\u4f7f\u3063\u3066\u3001\u6b21\u306e\u52d5\u304d\u3092\u4e88\u6e2c\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30d6\u30b6\u30fc\u97f3\u304c\u805e\u3053\u3048\u305f\u3089\u3001\u6b21\u306e\u8272\u3092\u30bf\u30c3\u30d7\u3059\u308b\u6e96\u5099\u3092\u3057\u307e\u3059\u3002[\u53c2\u7167\u8868\uff1a\u9045\u3044\u30bf\u30c3\u30d7\u306f50\u70b9\u3001\u901f\u3044\u30bf\u30c3\u30d7\u306f100\u70b9\u3067\u3059\u3002]"}, {"question": "\u8272\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b2\u30fc\u30e0\u306e\u7c21\u5358\u30e2\u30fc\u30c9\u3068\u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\u306e\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u8272\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b2\u30fc\u30e0\u306e\u7c21\u5358\u30e2\u30fc\u30c9\u3068\u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\u306e\u9055\u3044\u306f\u3001\u901f\u5ea6\u3068\u8907\u96d1\u3055\u3067\u3059\u3002\u7c21\u5358\u30e2\u30fc\u30c9\u3067\u306f\u3001\u8272\u306e\u5909\u5316\u304c\u9045\u304f\u3001\u9078\u629e\u80a2\u304c\u5c11\u306a\u3044\u3067\u3059\u3002\u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\u3067\u306f\u3001\u8272\u306e\u5909\u5316\u304c\u901f\u304f\u3001\u9078\u629e\u80a2\u304c\u591a\u304f\u306a\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u7c21\u5358\u30e2\u30fc\u30c9\u3067\u306f3\u8272\u8868\u793a\u3055\u308c\u308b\u306e\u306b\u5bfe\u3057\u3001\u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\u3067\u306f6\u8272\u8868\u793a\u3055\u308c\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u7c21\u5358\u30e2\u30fc\u30c9\u306f\u30a6\u30a9\u30fc\u30ad\u30f3\u30b0\u306e\u3088\u3046\u306a\u3082\u306e\u3001\u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\u306f\u30b9\u30d7\u30ea\u30f3\u30c8\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002]"}, {"question": "\u8272\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b2\u30fc\u30e0\u3067\u3001\u5e38\u306b\u9ad8\u5f97\u70b9\u3092\u7372\u5f97\u3059\u308b\u305f\u3081\u306e\u6226\u7565\u3092\u3069\u306e\u3088\u3046\u306b\u958b\u767a\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u8272\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b2\u30fc\u30e0\u3067\u5e38\u306b\u9ad8\u5f97\u70b9\u3092\u7372\u5f97\u3059\u308b\u306b\u306f\u3001\u3053\u306e\u6226\u7565\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\uff1aSTEP1\uff1a\u7d20\u65e9\u3044\u8272\u306e\u8a8d\u8b58\u3092\u30de\u30b9\u30bf\u30fc\u3057\u307e\u3059\u3002STEP2\uff1a\u3059\u3079\u3066\u306e\u30de\u30c3\u30c1\u30df\u30b9\u306a\u304f\u30b3\u30f3\u30dc\u3092\u69cb\u7bc9\u3057\u7dad\u6301\u3057\u307e\u3059\u3002STEP3\uff1a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u6226\u7565\u7684\u306b\u4f7f\u7528\u3057\u3066\u3001\u30b9\u30b3\u30a2\u3092\u4e0a\u3052\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u9ad8\u3044\u30b3\u30f3\u30dc\u6570\u4e2d\u306b\u300e\u500d\u70b9\u300f\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u8a8d\u8b58->\u30de\u30c3\u30c1\u30f3\u30b0->\u30b3\u30f3\u30dc->\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7->\u9ad8\u5f97\u70b9\u3002]"}, {"question": "\u8272\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b2\u30fc\u30e0\u3067\u3001\u6700\u3082\u52b9\u679c\u7684\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u3069\u308c\u3067\u3059\u304b\uff1f\u307e\u305f\u3001\u3044\u3064\u4f7f\u7528\u3059\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u8272\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b2\u30fc\u30e0\u3067\u6700\u3082\u52b9\u679c\u7684\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u300e\u500d\u70b9\u300f\u3068\u300e\u6642\u9593\u505c\u6b62\u300f\u3067\u3059\u3002\u300e\u500d\u70b9\u300f\u306f\u9ad8\u3044\u30b3\u30f3\u30dc\u6570\u4e2d\u306b\u4f7f\u7528\u3057\u3066\u3001\u30b9\u30b3\u30a2\u3092\u6700\u5927\u9650\u306b\u9ad8\u3081\u307e\u3059\u3002\u300e\u6642\u9593\u505c\u6b62\u300f\u306f\u8272\u306e\u5909\u5316\u304c\u901f\u3059\u304e\u3066\u5bfe\u5fdc\u3067\u304d\u306a\u3044\u5834\u5408\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u300110\u500d\u306e\u30b3\u30f3\u30dc\u500d\u7387\u306e\u6642\u306b\u300e\u6642\u9593\u505c\u6b62\u300f\u3092\u6709\u52b9\u306b\u3057\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u300e\u500d\u70b9\u300f\u306f\u30b9\u30b3\u30a2\u30a2\u30c3\u30d7\u3001\u300e\u6642\u9593\u505c\u6b62\u300f\u306f\u751f\u5b58\u306e\u305f\u3081\u306b\u3002]"}, {"question": "\u8272\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b2\u30fc\u30e0\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u306f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u8272\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b2\u30fc\u30e0\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u6b63\u78ba\u6027\u3001\u901f\u5ea6\u3001\u30b3\u30f3\u30dc\u500d\u7387\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u305d\u308c\u305e\u308c\u306e\u6b63\u3057\u3044\u30de\u30c3\u30c1\u30f3\u30b0\u3067\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u3001\u3088\u308a\u901f\u3044\u30de\u30c3\u30c1\u30f3\u30b0\u306f\u3088\u308a\u591a\u304f\u306e\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u30b3\u30f3\u30dc\u500d\u7387\u306f\u9023\u7d9a\u3057\u305f\u6b63\u3057\u3044\u30de\u30c3\u30c1\u30f3\u30b0\u3067\u5897\u52a0\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u30015\u500d\u306e\u30b3\u30f3\u30dc\u500d\u7387\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u306f\u3001100\u70b9\u3067\u306f\u306a\u304f500\u70b9\u3092\u7372\u5f97\u3057\u307e\u3059\u3002[\u53c2\u7167\u8868\uff1a\u9045\u3044\u30de\u30c3\u30c1\u30f3\u30b0=50\u70b9\u3001\u901f\u3044\u30de\u30c3\u30c1\u30f3\u30b0=100\u70b9\u30015\u500d\u30b3\u30f3\u30dc=500\u70b9\u3002]"}, {"question": "\u8272\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b2\u30fc\u30e0\u306e\u8272\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f\u307e\u305f\u3001\u4e88\u6e2c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u8272\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b2\u30fc\u30e0\u306e\u8272\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u64ec\u4f3c\u4e71\u6570\u30b8\u30a7\u30cd\u30ec\u30fc\u30bf\u3092\u4f7f\u7528\u3057\u3066\u8272\u306e\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u6c7a\u5b9a\u3057\u307e\u3059\u3002\u4e88\u6e2c\u4e0d\u53ef\u80fd\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u304c\u3001\u7d4c\u9a13\u8c4a\u5bcc\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u904e\u53bb\u306e\u30b7\u30fc\u30b1\u30f3\u30b9\u306b\u57fa\u3065\u3044\u3066\u30d1\u30bf\u30fc\u30f3\u3092\u4e88\u6e2c\u3059\u308b\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u8d64\u304c3\u56de\u9023\u7d9a\u3067\u51fa\u73fe\u3059\u308b\u3068\u3001\u6b21\u306b\u9752\u304c\u6765\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002[\u4f8b\u3048\uff1a\u30b7\u30e3\u30c3\u30d5\u30eb\u3055\u308c\u305f\u30c7\u30c3\u30ad\u306e\u6b21\u306e\u30ab\u30fc\u30c9\u3092\u4e88\u6e2c\u3059\u308b\u3053\u3068\u3068\u4f3c\u3066\u3044\u307e\u3059\u3002\u4e3b\u306b\u30e9\u30f3\u30c0\u30e0\u3067\u3059\u304c\u3001\u6642\u3005\u4e88\u6e2c\u3067\u304d\u307e\u3059\u3002]"}, {"question": "\u8907\u6570\u306e\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u8272\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b2\u30fc\u30e0\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30af\u30e9\u30a6\u30c9\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30b2\u30fc\u30e0\u3092\u30ea\u30f3\u30af\u3059\u308b\u3053\u3068\u3067\u3001\u8272\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b2\u30fc\u30e0\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3067\u304d\u307e\u3059\u3002STEP1\uff1a\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u306b\u79fb\u52d5\u3057\u3001\u300e\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u300f\u3092\u9078\u629e\u3057\u307e\u3059\u3002STEP2\uff1a\u304a\u597d\u307f\u306e\u30af\u30e9\u30a6\u30c9\u30b5\u30fc\u30d3\u30b9\uff08\u4f8b\uff1aGoogle Play\u3001Apple Game Center\uff09\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002STEP3\uff1a\u6307\u793a\u306b\u5f93\u3063\u3066\u30c7\u30fc\u30bf\u3092\u540c\u671f\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001iPhone\u304b\u3089Android\u306b\u5207\u308a\u66ff\u3048\u305f\u5834\u5408\u3082\u3001\u9032\u884c\u72b6\u6cc1\u306f\u5f15\u304d\u7d99\u304c\u308c\u307e\u3059\u3002[\u53c2\u7167\u8868\uff1a\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58=\u53ef\u80fd\u3001\u30ed\u30fc\u30ab\u30eb\u4fdd\u5b58=\u4e0d\u53ef\u80fd\u3002]"}, {"question": "\u8272\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b2\u30fc\u30e0\u306b\u306f\u96a0\u3057\u5b9f\u7e3e\u306f\u3042\u308a\u307e\u3059\u304b\uff1f\u305d\u308c\u3089\u306f\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u8272\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b2\u30fc\u30e0\u306b\u306f\u3001\u7279\u5b9a\u306e\u884c\u52d5\u304c\u5fc5\u8981\u306a\u96a0\u3057\u5b9f\u7e3e\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30ab\u30e9\u30fc\u30de\u30b9\u30bf\u30fc\u300f\u306f\u3001\u4e00\u5ea6\u306e\u30bb\u30c3\u30b7\u30e7\u30f3\u30671000\u500b\u306e\u8272\u3092\u30de\u30c3\u30c1\u30f3\u30b0\u3059\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u5b9f\u7e3e\u3092\u898b\u3064\u3051\u308b\u306b\u306f\u3001\u30b2\u30fc\u30e0\u30e1\u30cb\u30e5\u30fc\u306e\u300e\u5b9f\u7e3e\u300f\u30bb\u30af\u30b7\u30e7\u30f3\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u4f8b\u3048\uff1a\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u898b\u3064\u3051\u308b\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u6ce8\u610f\u6df1\u304f\u3001\u69d8\u3005\u306a\u8a66\u884c\u304c\u5fc5\u8981\u3067\u3059\u3002]"}, {"question": "\u8272\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b2\u30fc\u30e0\u306e\u9069\u5fdc\u96e3\u6613\u5ea6\u6a5f\u80fd\u306f\u3001\u79c1\u306e\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u306b\u3069\u306e\u3088\u3046\u306b\u5bfe\u5fdc\u3057\u307e\u3059\u304b\uff1f", "answer": "\u8272\u306e\u30de\u30c3\u30c1\u30f3\u30b0\u30b2\u30fc\u30e0\u306e\u9069\u5fdc\u96e3\u6613\u5ea6\u6a5f\u80fd\u306f\u3001\u3042\u306a\u305f\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u57fa\u3065\u3044\u3066\u8abf\u6574\u3055\u308c\u307e\u3059\u3002\u3042\u306a\u305f\u304c\u5e38\u306b\u9ad8\u5f97\u70b9\u3092\u7372\u5f97\u3059\u308b\u5834\u5408\u3001\u30b2\u30fc\u30e0\u306f\u8272\u306e\u5909\u5316\u306e\u901f\u5ea6\u3068\u8907\u96d1\u3055\u3092\u4e0a\u3052\u307e\u3059\u3002\u9006\u306b\u3001\u56f0\u96e3\u3092\u611f\u3058\u3066\u3044\u308b\u5834\u5408\u3001\u96e3\u6613\u5ea6\u3092\u4e0b\u3052\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6570\u56de\u306e\u9ad8\u5f97\u70b9\u3092\u7372\u5f97\u3057\u305f\u5f8c\u3001\u3088\u308a\u901f\u3044\u8272\u306e\u9077\u79fb\u306b\u6c17\u304c\u3064\u304f\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u9ad8\u5f97\u70b9->\u96e3\u6613\u5ea6\u5897\u52a0\u3001\u4f4e\u5f97\u70b9->\u96e3\u6613\u5ea6\u6e1b\u5c11\u3002]"}]
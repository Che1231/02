[{"question": "\ucd08\ubcf4\uc790\uac00 \uceec\ub7ec \ub9e4\uce58 \uac8c\uc784\uc5d0\uc11c \uae30\ubcf8\uc801\uc778 \uc0c9\uc0c1 \uc77c\uce58\ub97c \uc5b4\ub5bb\uac8c \uc218\ud589\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uceec\ub7ec \ub9e4\uce58 \uac8c\uc784\uc5d0\uc11c \uae30\ubcf8\uc801\uc778 \uc0c9\uc0c1 \uc77c\uce58\ub97c \ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. \ub2e8\uacc4 1: \ud654\uba74\uc5d0 \ud45c\uc2dc\ub41c \ub300\uc0c1 \uc0c9\uc0c1\uc744 \ud655\uc778\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc81c\uacf5\ub41c \uc635\uc158 \uc911 \ud574\ub2f9 \uc0c9\uc0c1 \ube14\ub85d\uc744 \ud0ed\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc120\ud0dd\uc744 \ud655\uc778\ud558\ub824\uba74 \ub450 \ubc88 \ud0ed\ud558\uc5ec \uace0\uc815\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub300\uc0c1 \uc0c9\uc0c1\uc774 \ud30c\ub780\uc0c9\uc778 \uacbd\uc6b0 \ud30c\ub780\uc0c9 \ube14\ub85d\uc744 \ud0ed\ud569\ub2c8\ub2e4. \uc774 \uac04\ub2e8\ud55c \uacfc\uc815\uc744 \ud1b5\ud574 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc5d0 \uc775\uc219\ud574\uc9d1\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc0c9\uae54\ubcc4\ub85c \uc591\ub9d0\uc744 \ub9de\ucd94\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc9c1\uad00\uc801\uc774\uace0 \uac04\ub2e8\ud569\ub2c8\ub2e4.]"}, {"question": "\uceec\ub7ec \ub9e4\uce58 \uac8c\uc784\uc5d0\uc11c \ud0c0\uc774\ubc0d\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\ub098\uc694?", "answer": "\uceec\ub7ec \ub9e4\uce58 \uac8c\uc784\uc5d0\uc11c \ud0c0\uc774\ubc0d\uc740 \uc810\uc218\uc640 \ucf64\ubcf4 \uacf1\uc148\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \ud0c0\uc774\ubc0d\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ubc29\ubc95\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc0c9\uc0c1\uc744 \ube60\ub974\uac8c \uc778\uc2dd\ud558\ub294 \uc5f0\uc2b5\uc744 \ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uafb8\uc900\ud788 \ud0ed\ud558\uc5ec \ub9ac\ub4ec\uac10\uc744 \uae30\ub985\ub2c8\ub2e4. \ub2e8\uacc4 3: \ub2e4\uc74c \ub3d9\uc791\uc744 \uc608\uce21\ud558\uae30 \uc704\ud574 \uac8c\uc784\uc758 \uc0ac\uc6b4\ub4dc \ud050\ub97c \ud65c\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ube44\ud504\uc74c\uc774 \ub4e4\ub9ac\uba74 \ub2e4\uc74c \uc0c9\uc0c1\uc744 \ud0ed\ud560 \uc900\ube44\ub97c \ud569\ub2c8\ub2e4. [\uad6c\uc131 \ub300\uc870\ud45c: \ub290\ub9b0 \ud0ed\uc740 50\uc810, \ube60\ub978 \ud0ed\uc740 100\uc810\uc785\ub2c8\ub2e4.]"}, {"question": "\uceec\ub7ec \ub9e4\uce58 \uac8c\uc784\uc5d0\uc11c \uc26c\uc6c0 \ubaa8\ub4dc\uc640 \uc5b4\ub824\uc6c0 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uceec\ub7ec \ub9e4\uce58 \uac8c\uc784\uc5d0\uc11c \uc26c\uc6c0 \ubaa8\ub4dc\uc640 \uc5b4\ub824\uc6c0 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \uc18d\ub3c4\uc640 \ubcf5\uc7a1\uc131\uc785\ub2c8\ub2e4. \uc26c\uc6c0 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uc0c9\uc0c1\uc774 \ub290\ub9ac\uac8c \ubcc0\ud558\uace0 \uc120\ud0dd\uc9c0\uac00 \uc801\uc2b5\ub2c8\ub2e4. \uc5b4\ub824\uc6c0 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uc0c9\uc0c1\uc774 \ube60\ub974\uac8c \ubcc0\ud558\uace0 \uc120\ud0dd\uc9c0\uac00 \ub9ce\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc26c\uc6c0 \ubaa8\ub4dc\uc5d0\uc11c\ub294 3\uac00\uc9c0 \uc0c9\uc0c1\uc774 \ud45c\uc2dc\ub418\uace0, \uc5b4\ub824\uc6c0 \ubaa8\ub4dc\uc5d0\uc11c\ub294 6\uac00\uc9c0 \uc0c9\uc0c1\uc774 \ud45c\uc2dc\ub429\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\uc548 \ube44\uad50: \uc26c\uc6c0 \ubaa8\ub4dc\ub294 \uac77\ub294 \uac83\uacfc \uac19\uace0, \uc5b4\ub824\uc6c0 \ubaa8\ub4dc\ub294 \ub2ec\ub9ac\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\uceec\ub7ec \ub9e4\uce58\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc9c0\uc18d\uc801\uc73c\ub85c \uc5bb\uc744 \uc218 \uc788\ub294 \uc804\ub7b5\uc744 \uc5b4\ub5bb\uac8c \uac1c\ubc1c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uceec\ub7ec \ub9e4\uce58 \uac8c\uc784\uc5d0\uc11c \uc9c0\uc18d\uc801\uc73c\ub85c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc73c\ub824\uba74 \ub2e4\uc74c \uc804\ub7b5\uc744 \ub530\ub974\uc138\uc694. \ub2e8\uacc4 1: \ube60\ub978 \uc0c9\uc0c1 \uc778\uc2dd \ub2a5\ub825\uc744 \uc219\ub2ec\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ub9e4\uce6d\uc744 \ub193\uce58\uc9c0 \uc54a\uace0 \ucf64\ubcf4\ub97c \uc720\uc9c0\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ud30c\uc6cc\uc5c5\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc5ec \uc810\uc218\ub97c \ub192\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub192\uc740 \ucf64\ubcf4 \uc5f0\uc18d \uc2dc \"\uc774\uc911 \uc810\uc218\" \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \ub3c4\ud45c: \uc778\uc2dd -> \ub9e4\uce6d -> \ucf64\ubcf4 -> \ud30c\uc6cc\uc5c5 -> \ub192\uc740 \uc810\uc218.]"}, {"question": "\uceec\ub7ec \ub9e4\uce58\uc5d0\uc11c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ud30c\uc6cc\uc5c5\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b8\uc81c \uc0ac\uc6a9\ud574\uc57c \ud558\ub098\uc694?", "answer": "\uceec\ub7ec \ub9e4\uce58\uc5d0\uc11c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ud30c\uc6cc\uc5c5\uc740 \"\uc774\uc911 \uc810\uc218\"\uc640 \"\uc2dc\uac04 \uc815\uc9c0\"\uc785\ub2c8\ub2e4. \ub192\uc740 \ucf64\ubcf4 \uc5f0\uc18d \uc2dc \"\uc774\uc911 \uc810\uc218\"\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc810\uc218\ub97c \uadf9\ub300\ud654\ud569\ub2c8\ub2e4. \uc0c9\uc0c1 \ubcc0\ud654 \uc18d\ub3c4\uac00 \ub108\ubb34 \ube68\ub77c \ub530\ub77c\uac00\uae30 \uc5b4\ub824\uc6b8 \ub54c\ub294 \"\uc2dc\uac04 \uc815\uc9c0\"\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 10\ubc30 \ucf64\ubcf4 \uc99d\ud3ed \uc2dc \"\uc2dc\uac04 \uc815\uc9c0\"\ub97c \ud65c\uc131\ud654\ud569\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\uc548 \ube44\uad50: \uc810\uc218\ub294 \"\uc774\uc911 \uc810\uc218\", \uc0dd\uc874\uc740 \"\uc2dc\uac04 \uc815\uc9c0\".]"}, {"question": "\uceec\ub7ec \ub9e4\uce58\uc758 \uc810\uc218 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc774\uba70, \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "\uceec\ub7ec \ub9e4\uce58\uc758 \uc810\uc218 \uba54\ucee4\ub2c8\uc998\uc740 \uc815\ud655\uc131, \uc18d\ub3c4 \ubc0f \ucf64\ubcf4 \uacf1\uc148\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uac01 \uc815\ud655\ud55c \ub9e4\uce58\ub294 \uc810\uc218\ub97c \uc81c\uacf5\ud558\uba70, \ub9e4\uce58\uac00 \ube60\ub97c\uc218\ub85d \ub354 \ub9ce\uc740 \uc810\uc218\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. \ucf64\ubcf4 \uacf1\uc148\uae30\ub294 \uc5f0\uc18d\uc801\uc778 \uc815\ud655\ud55c \ub9e4\uce58\ub85c \uc99d\uac00\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 5\ubc30 \ucf64\ubcf4 \uacf1\uc148\uae30\uac00 \uc788\ub294 \ub9e4\uce58\ub294 100\uc810 \ub300\uc2e0 500\uc810\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. [\uad6c\uc131 \ub300\uc870\ud45c: \ub290\ub9b0 \ub9e4\uce58 = 50\uc810, \ube60\ub978 \ub9e4\uce58 = 100\uc810, 5\ubc30 \ucf64\ubcf4 = 500\uc810.]"}, {"question": "\uceec\ub7ec \ub9e4\uce58\uc5d0\uc11c \uc0c9\uc0c1 \uc54c\uace0\ub9ac\uc998\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uc608\uce21\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uceec\ub7ec \ub9e4\uce58\uc5d0\uc11c \uc0c9\uc0c1 \uc54c\uace0\ub9ac\uc998\uc740 \uc758\uc0ac\ub09c\uc218 \uc0dd\uc131\uae30\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc0c9\uc0c1 \uc21c\uc11c\ub97c \uacb0\uc815\ud569\ub2c8\ub2e4. \uc608\uce21 \ubd88\uac00\ub2a5\ud558\uac8c \uc124\uacc4\ub418\uc5c8\uc9c0\ub9cc, \uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\ub294 \uc774\uc804 \uc21c\uc11c\ub97c \uae30\ubc18\uc73c\ub85c \ub54c\ub54c\ub85c \ud328\ud134\uc744 \uc608\uce21\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5f0\uc18d\uc801\uc73c\ub85c \ube68\uac04\uc0c9\uc774 \uc138 \ubc88 \ub098\ud0c0\ub098\uba74 \ub2e4\uc74c\uc740 \ud30c\ub780\uc0c9\uc77c \uac00\ub2a5\uc131\uc774 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc11e\uc778 \uce74\ub4dc \ub371\uc5d0\uc11c \ub2e4\uc74c \uce74\ub4dc\ub97c \uc608\uce21\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ub300\ubd80\ubd84\uc740 \ub79c\ub364\ud558\uc9c0\ub9cc \uac00\ub054 \uc608\uce21\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ub2e4\ub978 \uae30\uae30\ub85c \uceec\ub7ec \ub9e4\uce58 \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub124, \ud074\ub77c\uc6b0\ub4dc \uacc4\uc815\uc5d0 \uac8c\uc784\uc744 \uc5f0\uacb0\ud558\uba74 \uceec\ub7ec \ub9e4\uce58 \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc124\uc815 \uba54\ub274\ub85c \uc774\ub3d9\ud558\uc5ec \"\ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\"\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc6d0\ud558\ub294 \ud074\ub77c\uc6b0\ub4dc \uc11c\ube44\uc2a4(\uc608: \uad6c\uae00 \ud50c\ub808\uc774, \uc560\ud50c \uac8c\uc784 \uc13c\ud130)\ub85c \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uba54\uc2dc\uc9c0\uc5d0 \ub530\ub77c \ub370\uc774\ud130\ub97c \ub3d9\uae30\ud654\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc544\uc774\ud3f0\uc5d0\uc11c \uc548\ub4dc\ub85c\uc774\ub4dc\ub85c \uc804\ud658\ud558\uba74 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc774\uc804\ub429\ub2c8\ub2e4. [\uad6c\uc131 \ub300\uc870\ud45c: \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 = \uac00\ub2a5, \ub85c\uceec \uc800\uc7a5 = \ubd88\uac00\ub2a5.]"}, {"question": "\uceec\ub7ec \ub9e4\uce58\uc5d0 \uc228\uaca8\uc9c4 \uc5c5\uc801\uc774 \uc788\ub098\uc694? \uc5b4\ub5bb\uac8c \ud574\uc81c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub124, \uceec\ub7ec \ub9e4\uce58\uc5d0\ub294 \ud2b9\uc815 \ud589\ub3d9\uc744 \ud1b5\ud574 \ud574\uc81c\ub418\ub294 \uc228\uaca8\uc9c4 \uc5c5\uc801\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uceec\ub7ec \ub9c8\uc2a4\ud130\" \uc5c5\uc801\uc740 \ud55c \uc138\uc158\uc5d0\uc11c 1000\uac1c\uc758 \uc0c9\uc0c1\uc744 \ub9e4\uce6d\ud558\uc5ec \ud574\uc81c\ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc5c5\uc801\uc744 \ucc3e\uc73c\ub824\uba74 \uac8c\uc784 \uba54\ub274\uc758 \"\uc5c5\uc801\" \uc139\uc158\uc744 \ud655\uc778\ud558\uc138\uc694. [\ube44\uc720 \uc124\uba85: \uacc4\ub780 \uc18d\uc5d0 \uc788\ub294 \uc228\uaca8\uc9c4 \ub2ec\uac40\uc744 \ucc3e\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc8fc\uc758\ud574\uc11c \uc0b4\ud3b4\ubcf4\uace0 \uc5ec\ub7ec \uac00\uc9c0 \uc2dc\ub3c4\ub97c \ud574\uc57c \ud569\ub2c8\ub2e4.]"}, {"question": "\uceec\ub7ec \ub9e4\uce58\uc758 \uc801\uc751\ud615 \ub09c\uc774\ub3c4\ub294 \uc81c \uc2e4\ub825\uc5d0 \ub9de\ucdb0 \uc5b4\ub5bb\uac8c \uc870\uc815\ub418\ub098\uc694?", "answer": "\uceec\ub7ec \ub9e4\uce58\uc758 \uc801\uc751\ud615 \ub09c\uc774\ub3c4\ub294 \uc131\ub2a5\uc744 \uae30\ubc18\uc73c\ub85c \uc870\uc815\ub429\ub2c8\ub2e4. \uc9c0\uc18d\uc801\uc73c\ub85c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc73c\uba74 \uac8c\uc784\uc740 \uc0c9\uc0c1 \ubcc0\ud654\uc758 \uc18d\ub3c4\uc640 \ubcf5\uc7a1\uc131\uc744 \ub192\uc785\ub2c8\ub2e4. \ubc18\ub300\ub85c \uc5b4\ub824\uc6c0\uc744 \uacaa\uc73c\uba74 \ub09c\uc774\ub3c4\ub97c \ub0ae\ucda5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uba87 \ucc28\ub840 \ub192\uc740 \uc810\uc218\ub97c \ud68d\ub4dd\ud55c \ud6c4 \uc0c9\uc0c1 \uc804\ud658 \uc18d\ub3c4\uac00 \ube68\ub77c\uc9c0\ub294 \uac83\uc744 \uc54c \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \ub3c4\ud45c: \ub192\uc740 \uc810\uc218 -> \ub09c\uc774\ub3c4 \uc99d\uac00, \ub0ae\uc740 \uc810\uc218 -> \ub09c\uc774\ub3c4 \uac10\uc18c.]"}]
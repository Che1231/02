[{"question": "\uc720\ub178 \uc628\ub77c\uc778: \ucc98\uc74c \ud50c\ub808\uc774\ud558\ub294 \uc720\uc800\uac00 \uc720\ud6a8\ud55c \uce74\ub4dc\ub97c \ub0bc \uc218 \uc5c6\ub294 \uc0c1\ud669\uc77c \ub54c \uc5b4\ub5bb\uac8c \uce74\ub4dc\ub97c \ub0b4\uc57c \ud558\ub098\uc694?", "answer": "\uc720\ub178 \uc628\ub77c\uc778\uc5d0\uc11c \ubc84\ub824\uc9c4 \uce74\ub4dc \ub371\uc758 \ub9e8 \uc704 \uce74\ub4dc \uc0c9\uae54\uc774\ub098 \uc22b\uc790\uc640 \uc77c\uce58\ud558\ub294 \uce74\ub4dc\ub098 \uc640\uc77c\ub4dc \uce74\ub4dc\uac00 \uc5c6\ub2e4\uba74, \ub4dc\ub85c\uc6b0 \ub371\uc5d0\uc11c \uce74\ub4dc\ub97c \ud55c \uc7a5 \ubf51\uc544\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubc84\ub824\uc9c4 \uce74\ub4dc \ub371\uc758 \ub9e8 \uc704 \uce74\ub4dc\uac00 \ube68\uac04\uc0c9 '7'\uc774\ub77c\uba74, \ube68\uac04\uc0c9 \uce74\ub4dc \ub610\ub294 '7' \uce74\ub4dc, \ub610\ub294 \uc640\uc77c\ub4dc \uce74\ub4dc \uc911 \ud558\ub098\ub97c \ub0b4\uc57c \ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uce74\ub4dc\uac00 \uc5c6\ub2e4\uba74 \ub4dc\ub85c\uc6b0 \ub371\uc744 \ud074\ub9ad\ud558\uc138\uc694. \uadf8\ub7ec\uba74 \ubf51\uc740 \uce74\ub4dc\ub85c \uad50\uccb4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uce74\ub4dc\uac00 \ud55c \uc7a5 \ub0a8\uc558\uc744 \ub54c\ub294 '\uc720\ub178'\ub77c\uace0 \ub9d0\ud558\ub294 \uac83\uc744 \uc78a\uc9c0 \ub9c8\uc138\uc694!"}, {"question": "\uc720\ub178 \uc628\ub77c\uc778\uc5d0\uc11c \ub2e4\uc591\ud55c \uc0c9\uc0c1\uc758 \uce74\ub4dc \ub4b7\uba74\uc774 \uac00\uc9c0\ub294 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc774\uba70, \ucd08\uc2ec\uc790\ub85c\uc11c \uc5b4\ub5bb\uac8c \uce74\ub4dc \ub4b7\uba74\uc744 \ucee4\uc2a4\ud130\ub9c8\uc774\uc9d5 \ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc720\ub178 \uc628\ub77c\uc778\uc758 \uce74\ub4dc \ub4b7\uba74\uc740 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc601\ud5a5\uc744 \uc8fc\uc9c0 \uc54a\ub294 \uc21c\uc804\ud788 \ubbf8\uc801\uc778 \uc694\uc18c\uc785\ub2c8\ub2e4. \uac8c\uc784\uc5d0 \uac1c\uc131\uc744 \ub354\ud574\uc90d\ub2c8\ub2e4! \ucee4\uc2a4\ud130\ub9c8\uc774\uc9d5\ud558\ub824\uba74 \uc720\ub178 \uc628\ub77c\uc778 \uc571\uc774\ub098 \uc6f9\uc0ac\uc774\ud2b8 \ub0b4 \ud504\ub85c\ud544 \uc124\uc815\uc73c\ub85c \uc774\ub3d9\ud558\uc138\uc694. \uc77c\ubc18\uc801\uc73c\ub85c '\ucee4\uc2a4\ud130\ub9c8\uc774\uc9d5' \ub610\ub294 '\uc678\ud615' \uc139\uc158\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc131\ucde8\ub3c4\ub97c \ud1b5\ud574 \uce74\ub4dc \ub4b7\uba74\uc744 \uc7a0\uae08 \ud574\uc81c\ud558\uac70\ub098 \uac8c\uc784 \ub0b4 \ud1b5\ud654 \ub610\ub294 \uc2e4\uc81c \ub3c8\uc73c\ub85c \uc0c1\uc810\uc5d0\uc11c \uad6c\ub9e4\ud560 \uc218 \uc788\ub294 \uc635\uc158\uc774 \uc788\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc790\uc2e0\uc758 \uc2a4\ud0c0\uc77c\uc744 \uc790\ub791\ud558\uace0 \uac8c\uc784\uc5d0 \uba4b\uc744 \ub354\ud558\ub294 \uc7ac\ubbf8\uc788\ub294 \ubc29\ubc95\uc785\ub2c8\ub2e4. [\ud504\ub85c\ud544] -> [\uc678\ud615]\uc5d0\uc11c \uc635\uc158\uc744 \ubcc0\uacbd\ud558\uc5ec \uac8c\uc784\uc744 \uc2a4\ud0c0\uc77c\ub9ac\uc2dc\ud558\uac8c \uafb8\ubc00 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc720\ub178 \uc628\ub77c\uc778\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uc758 \ucc28\ub840\uac00 \ub118\uc5b4\uac00\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc774\ub7ec\ud55c \ubd88\ud3b8\ud568\uc744 \uc5b4\ub5bb\uac8c \ubc29\uc9c0\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc720\ub178 \uc628\ub77c\uc778\uc5d0\uc11c \ub54c\ub54c\ub85c \ud50c\ub808\uc774\uc5b4\uc758 \ucc28\ub840\uac00 \ub118\uc5b4\uac00\ub294 \uac83\ucc98\ub7fc \ubcf4\uc774\ub294 \uac83\uc740 \uc5f0\uacb0 \ubb38\uc81c\ub85c \uc778\ud55c \uc9c0\uc5f0 \ub54c\ubb38\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \uc2dc\uc2a4\ud15c\uc774 \ud560\ub2f9\ub41c \uc2dc\uac04 \ub0b4\uc5d0 \ud50c\ub808\uc774\ud558\uc9c0 \uc54a\uc558\ub2e4\uace0 \uc798\ubabb \ud310\ub2e8\ud558\uac70\ub098 \uc2a4\ud0b5 \uce74\ub4dc\ub97c \uc798\ubabb \uc801\uc6a9\ud558\ub294 \uacbd\uc6b0\uc5d0\ub3c4 \ubc1c\uc0dd\ud569\ub2c8\ub2e4. \uc2a4\ud0b5 \uce74\ub4dc \uc801\uc6a9\uc5d0 \ub300\ud55c \uc2dc\uc2a4\ud15c\uc758 \uc624\ub958\uac00 \uc6d0\uc778\uc77c \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\uc74c\uacfc \uac19\uc774 \ud574\uacb0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4:\n1\ub2e8\uacc4: \uc778\ud130\ub137 \uc5f0\uacb0\uc774 \uc548\uc815\uc801\uc778\uc9c0 \ud655\uc778\ud558\uc138\uc694.\n2\ub2e8\uacc4: \uac8c\uc784\uc744 \uc0c8\ub85c \uace0\uce58\uac70\ub098 \uc571\uc744 \ub2e4\uc2dc \uc2dc\uc791\ud574 \ubcf4\uc138\uc694.\n3\ub2e8\uacc4: \ubb38\uc81c\uac00 \uc9c0\uc18d\ub418\uba74 \uc9c0\uc6d0\ud300\uc5d0 \ubb38\uc758\ud558\uc138\uc694. \uac00\ub2a5\ud55c \uacbd\uc6b0 \uc2a4\ud06c\ub9b0\uc0f7\uc774\ub098 \ube44\ub514\uc624\ub97c \uc81c\uacf5\ud558\uc138\uc694."}, {"question": "\uc720\ub178 \uc628\ub77c\uc778\uc5d0\uc11c \uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\uac00 \uc640\uc77c\ub4dc \uce74\ub4dc\ub97c \uad00\ub9ac\ud558\uace0 \uc0c1\ub300\ubc29\uc5d0\uac8c \ucd5c\ub300\ud55c \ud070 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \uc704\ud55c \uace0\uae09 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uacbd\ud5d8\uc774 \ud48d\ubd80\ud55c \uc720\ub178 \uc628\ub77c\uc778 \ud50c\ub808\uc774\uc5b4\ub294 \ud2b9\ud788 \uc640\uc77c\ub4dc \ub4dc\ub85c\uc6b0 \ud3ec \uce74\ub4dc\ub97c \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc5ec \uc0c1\ub300\ubc29\uc744 \ubc29\ud574\ud558\uace0 \uac8c\uc784 \ud15c\ud3ec\ub97c \uc870\uc808\ud569\ub2c8\ub2e4. \ub2e4\uc74c\uc740 \uace0\uae09 \uc804\ub7b5\uc785\ub2c8\ub2e4:\n1\ub2e8\uacc4: \uc0c1\ub300\ubc29\uc758 \uce74\ub4dc \uac1c\uc218\ub97c \uad00\ucc30\ud569\ub2c8\ub2e4. \uce74\ub4dc\uac00 \uc801\uc740 \uc0c1\ub300\ubc29\uc5d0\uac8c\ub294 \uadf8\ub4e4\uc774 \ubd84\uba85\ud788 \uac00\uc9c0\uace0 \uc788\ub294 \uc0c9\uae54\ub85c \uc27d\uac8c \uc774\uae38 \uc218 \uc788\ub3c4\ub85d \uae30\ud68c\ub97c \uc8fc\uc9c0 \ub9c8\uc138\uc694.\n2\ub2e8\uacc4: \uc0c1\ub300\ubc29\uc774 \ub0a8\uc740 \uce74\ub4dc\uac00 \ub9e4\uc6b0 \uc801\uc744 \ub54c, \ud2b9\ud788 '\uc720\ub178'\ub77c\uace0 \uc678\uce5c \uc801\uc774 \uc5c6\ub294 \uc0c1\ub300\ubc29\uc744 \uac15\uc81c\ub85c \uce74\ub4dc\ub97c \ubf51\ub3c4\ub85d \uc720\ub3c4\ud569\ub2c8\ub2e4. \uc774 \uc804\ub7b5\uc740 '\uce74\ub4dc \uc218 \ubd80\uc871 \uc555\ubc15'\uc73c\ub85c \uc124\uba85\ub429\ub2c8\ub2e4.\n3\ub2e8\uacc4: \uc640\uc77c\ub4dc \ub4dc\ub85c\uc6b0 \ud3ec \uce74\ub4dc\ub97c \uc313\uc73c\uc138\uc694. \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uac00 \uc774\uc804 \uc640\uc77c\ub4dc \ub4dc\ub85c\uc6b0 \ud3ec \uce74\ub4dc\ub85c \uc778\ud574 \uc774\ubbf8 \uce74\ub4dc\ub97c \ubf51\ub3c4\ub85d \uac15\uc694\ubc1b\uc558\uc744 \ub54c \uc640\uc77c\ub4dc \ub4dc\ub85c\uc6b0 \ud3ec \uce74\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud398\ub110\ud2f0\ub97c \uadf9\ub300\ud654\ud569\ub2c8\ub2e4. \uc774\uc804 \ud50c\ub808\uc774\uc5b4\uac00 \uc2b9\ub9ac \uc9c1\uc804\uc778 \uacbd\uc6b0 \uc720\uc6a9\ud569\ub2c8\ub2e4."}, {"question": "\uc720\ub178 \uc628\ub77c\uc778\uc5d0\uc11c \ud2b9\uc815 \uc22b\uc790 \uce74\ub4dc\ub97c \ubf51\uc744 \ud655\ub960\uc744 \uc774\ud574\ud558\uba74 \uacb0\uc815\uc801\uc778 \ub9c8\uc9c0\ub9c9 \uc21c\uac04\uc5d0 \uac8c\uc784 \ud50c\ub808\uc774 \uacb0\uc815\uc744 \uc5b4\ub5bb\uac8c \uac1c\uc120\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc720\ub178 \uc628\ub77c\uc778\uc5d0\uc11c \uce74\ub4dc \ubd84\ud3ec\ub97c \uc774\ud574\ud558\uba74 \uac8c\uc784\uc774 \ub9c8\uc9c0\ub9c9 \ub2e8\uacc4\uc5d0 \uc811\uc5b4\ub4e4\uc5c8\uc744 \ub54c \ud2b9\ud788 \ub354 \ub098\uc740 \uc804\ub7b5\uc801 \uacb0\uc815\uc744 \ub0b4\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131\ud45c:] \uce74\ub4dc\ub294 \ucd1d 108\uc7a5\uc73c\ub85c, \ub2e4\uc591\ud55c \uc0c9\uc0c1\uc758 \uc22b\uc790 \uce74\ub4dc(0~9)\uac00 \uc5ec\ub7ec \uc7a5\uc529 \uc788\uc73c\uba70, \uc2a4\ud0b5, \ub9ac\ubc84\uc2a4, \ub4dc\ub85c\uc6b0 \ud22c\uc640 \uac19\uc740 \uc561\uc158 \uce74\ub4dc\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\uc815 \uc22b\uc790 \uce74\ub4dc \ub610\ub294 \uc0c9\uc0c1\uc774 \ub9e4\uc6b0 \ubd80\uc871\ud558\ub2e4\ub294 \uac83\uc744 \uc54c\uba74 \uc640\uc77c\ub4dc \uce74\ub4dc\ub97c \ud574\ub2f9 \uc0c9\uc0c1\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \uac83\uc774 \ub354 \uc548\uc804\ud55c \ub3c4\ubc15\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\uc720\ub178 \uc628\ub77c\uc778\uc5d0\uc11c \uc0c1\ub300\ubc29\uc774 \uacf5\uaca9\uc801\uc73c\ub85c \uc800\ub97c \uaca8\ub0e5\ud560 \ub54c \uc790\uc2e0\uc744 \ubcf4\ud638\ud558\uae30 \uc704\ud574 \ub4dc\ub85c\uc6b0 \ud22c \uce74\ub4dc\ub97c \ubc29\uc5b4\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc720\ub178 \uc628\ub77c\uc778\uc5d0\uc11c \ub4dc\ub85c\uc6b0 \ud22c \uce74\ub4dc\ub97c \ubc29\uc5b4\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \uac83\uc740 \uc0c1\ub300\ubc29\uc758 \ud589\ub3d9\uc744 \uc608\uce21\ud558\uace0 \uadf8 \uacc4\ud68d\uc744 \ubc29\ud574\ud558\ub294 \uac83\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \ub4dc\ub85c\uc6b0 \ud22c \uce74\ub4dc\ub97c \uc774\uc6a9\ud560 \uc801\uc808\ud55c \uc2dc\uae30\ub294 \uc0c1\ub300\ubc29\uc774 \uacf5\uaca9\uc801\uc778 \ud0dc\ub3c4\ub97c \ubcf4\uc774\ub294 \ub54c\ub97c \uc544\ub294 \ub370 \ub2ec\ub824 \uc788\uc2b5\ub2c8\ub2e4. \uc0c1\ub300\ubc29\uc774 \ub9ce\uc740 \uce74\ub4dc\ub97c \uc228\uae30\uac70\ub098 \uc2b9\ub9ac\uc5d0 \uc704\ud611\uc801\uc73c\ub85c \uadfc\uc811\ud574 \uc788\ub294 \uac83\uc744 \ubc1c\uacac\ud558\uba74, \ub4dc\ub85c\uc6b0 \ud22c \uce74\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \uce74\ub4dc\ub97c \ucd94\uac00\ub85c \ubf51\ub3c4\ub85d \uac15\uc694\ud558\uc5ec \uc0c1\ub300\ubc29\uc758 \uc18d\ub3c4\ub97c \ub2a6\ucd9c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubaa9\ud45c\ub294 \uc0c1\ub300\ubc29\uc744 \ucc98\ubc8c\ud558\ub294 \uac83\uc774\uc5b4\uc57c \ud558\uba70, \uac00\ub2a5\ud558\uba74 \uc801\uc740 \uc591\uc758 \uce74\ub4dc\ub85c \ucc98\ubc8c\ud574\uc57c \ud569\ub2c8\ub2e4."}, {"question": "\uc720\ub178 \uc628\ub77c\uc778\uc5d0\uc11c \uce74\ub4dc \ub371\uc744 \uc154\ud50c\ud558\uace0 \uce74\ub4dc\ub97c \ub098\ub220\uc8fc\ub294 \ub370 \uc0ac\uc6a9\ud558\ub294 \uc790\uc138\ud55c \uc54c\uace0\ub9ac\uc998\uc740 \ubb34\uc5c7\uc774\uba70, \uac8c\uc784\uc758 \uacf5\uc815\uc131\uacfc \ubb34\uc791\uc704\uc131\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "\uc720\ub178 \uc628\ub77c\uc778\uc758 \uc154\ud50c \uc54c\uace0\ub9ac\uc998\uc740 \uc2e4\uc81c \uce74\ub4dc \uc154\ud50c\uc744 \uc2dc\ubbac\ub808\uc774\uc158\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc815\ud655\ud55c \uc54c\uace0\ub9ac\uc998\uc740 \uacf5\uac1c\ub418\uc9c0 \uc54a\uc558\uc9c0\ub9cc, \uc77c\ubc18\uc801\uc73c\ub85c \uc2dc\uac04 \uae30\ubc18 \ub610\ub294 \uc2dc\uc2a4\ud15c \uc0dd\uc131 \uac12\uc73c\ub85c \uc2dc\ub4dc\ub41c \uc758\uc0ac \ub09c\uc218 \uc0dd\uc131\uae30(PRNG)\ub97c \uc0ac\uc6a9\ud558\uc5ec \uac8c\uc784 \uac04\uc5d0 \ub2e4\uc591\uc131\uc744 \ud655\ubcf4\ud569\ub2c8\ub2e4. \uacf5\uc815\uc131\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc740 \uac01 \ud50c\ub808\uc774\uc5b4\uac00 \ubaa8\ub4e0 \uce74\ub4dc\ub97c \ubc1b\uc744 \ub3d9\uc77c\ud55c \uae30\ud68c\uac00 \ubcf4\uc7a5\ub418\ub294 \uac83\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \uc2dc\uc2a4\ud15c\uc740 \ud328\ud134\uc774\ub098 \uc608\uce21 \uac00\ub2a5\ud55c \uc21c\uc11c\ub97c \ud53c\ud558\uace0 \uacbd\uc7c1\uc131\uc744 \uc720\uc9c0\ud558\ub824\uace0 \ub178\ub825\ud569\ub2c8\ub2e4. \uc54c\uace0\ub9ac\uc998\uc740 \uc5ec\ub7ec \uac8c\uc784\uc5d0\uc11c \uc911\ubcf5\ub418\ub294 \ud578\ub4dc\ub97c \ubc29\uc9c0\ud558\ub294 \uac83\uc744 \uc911\uc2dc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub294 \uc77c\uad00\uc131 \uc788\ub294 \uacbd\ud5d8\uc744 \uc720\uc9c0\ud558\ub294 \ub370 \uc911\uc694\ud569\ub2c8\ub2e4."}, {"question": "\uc720\ub178 \uc628\ub77c\uc778\uc758 \ub7ad\ud06c \ubaa8\ub4dc\uc5d0\uc11c \uc228\uaca8\uc9c4 MMR(\ub9e4\uce6d \ub808\uc774\ud305)\uacfc ELO \uc2dc\uc2a4\ud15c\uc740 \uacf5\uc815\ud558\uace0 \uacbd\uc7c1\uc801\uc778 \ub9e4\uce58\ub97c \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "\ub9ce\uc740 \ub7ad\ud06c \uac8c\uc784\uacfc \ub9c8\ucc2c\uac00\uc9c0\ub85c \uc720\ub178 \uc628\ub77c\uc778\uc740 \uc228\uaca8\uc9c4 MMR(\ub9e4\uce6d \ub808\uc774\ud305) \ub610\ub294 ELO \uc720\uc0ac \uc2dc\uc2a4\ud15c\uc744 \uc0ac\uc6a9\ud558\uc5ec \ube44\uc2b7\ud55c \uc2e4\ub825\uc758 \ud50c\ub808\uc774\uc5b4\ub97c \ud398\uc5b4\ub9c1\ud569\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \uc2b9\ud328 \ubc0f \uc9c1\uba74\ud558\ub294 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uc758 \uc0c1\ub300\uc801\uc778 \uc21c\uc704\uc5d0 \ub530\ub77c \ud50c\ub808\uc774\uc5b4\uc758 \ub808\uc774\ud305\uc744 \ub3d9\uc801\uc73c\ub85c \uc870\uc815\ud569\ub2c8\ub2e4. \ub354 \ub192\uc740 \uc21c\uc704\uc758 \uc0c1\ub300\ubc29\uc744 \uc774\uae30\uba74 MMR \uc99d\uac00\ud3ed\uc774 \ucee4\uc9d1\ub2c8\ub2e4. \ub354 \ub0ae\uc740 \uc21c\uc704\uc758 \uc0c1\ub300\ubc29\uc5d0\uac8c \ud328\ud558\uba74 MMR \uac10\uc18c\ud3ed\uc774 \ucee4\uc9d1\ub2c8\ub2e4. \uc774\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uc801\uc808\ud55c \ub3c4\uc804\uc5d0 \ub9de\uc11c \uacbd\uc7c1\uc801\uc778 \uac8c\uc784\uc744 \ud560 \uc218 \uc788\ub3c4\ub85d \uc9c0\uc18d\uc801\uc73c\ub85c \uc0c1\ub300\ub97c \ub9e4\uce6d\uc2dc\ucf1c \uacf5\uc815\ud558\uace0 \uacbd\uc7c1\uc801\uc778 \uac8c\uc784\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "PC\uc5d0\uc11c \ubaa8\ubc14\uc77c \ub610\ub294 \ud0dc\ube14\ub9bf\uc73c\ub85c \uc720\ub178 \uc628\ub77c\uc778 \ud50c\ub7ab\ud3fc\uc744 \uc804\ud658\ud560 \uacbd\uc6b0, \uacc4\uc815\uc758 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud638\ud658\uc131\uacfc \ub370\uc774\ud130 \ub3d9\uae30\ud654\ub294 \uc5bc\ub9c8\ub098 \uc6d0\ud65c\ud55c\uac00\uc694?", "answer": "\uc720\ub178 \uc628\ub77c\uc778\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \ub3d9\uc77c\ud55c \uacc4\uc815(\uc608: Facebook, Google \ub610\ub294 \uc804\uc6a9 \uc720\ub178 \uc628\ub77c\uc778 \uacc4\uc815\uc744 \ud1b5\ud574 \ub85c\uadf8\uc778\ud55c \uacbd\uc6b0)\uc5d0 \ub85c\uadf8\uc778\ud558\ub294 \ud55c \uc6d0\ud65c\ud55c \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud638\ud658\uc131\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669, \uc7a0\uae08 \ud574\uc81c\ub41c \ucee4\uc2a4\ud130\ub9c8\uc774\uc9d5 \uc635\uc158 \ubc0f \ud50c\ub808\uc774\uc5b4 \ub808\ubca8\uc744 \ud3ec\ud568\ud55c \ubaa8\ub4e0 \ub514\ubc14\uc774\uc2a4\uc5d0\uc11c \ub370\uc774\ud130\uac00 \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \uac01 \ub514\ubc14\uc774\uc2a4\uc5d0\uc11c \uc62c\ubc14\ub978 \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud56d\uc0c1 \ud655\uc778\ud558\ub294 \uac83\uc774 \uc9c0\ub2a5\uc801\uc785\ub2c8\ub2e4. \ud50c\ub7ab\ud3fc \uc804\ud658\uc2dc \ucc28\uc774\ub97c \ubc29\uc9c0\ud558\uae30 \uc704\ud574\uc11c\uc785\ub2c8\ub2e4. \uac00\uc785\ud558\ub294 \uacbd\uc6b0 \ub2e4\uc591\ud55c \uc7a5\uce58\uc5d0\uc11c \ub85c\uadf8\uc778\ud558\ub294 \uac83\uacfc \ub3d9\uc77c\ud55c \ubc29\ubc95\uc744 \uace0\uc218\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \ubb38\uc81c\uac00 \ubc1c\uc0dd\ud558\uba74 \uc5b8\uc81c\ub4e0\uc9c0 \uc9c0\uc6d0\ud300\uc5d0 \ubb38\uc758\ud558\uc2ed\uc2dc\uc624."}, {"question": "\uc720\ub178 \uc628\ub77c\uc778\uc5d0 \uac8c\uc784 \ud50c\ub808\uc774 \uc21c\uc11c\ub098 \ud2b9\uc815 \uac8c\uc784 \uc131\ucde8\ub3c4\ub85c \uc778\ud574 \ud2b8\ub9ac\uac70\ub418\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8 \ub610\ub294 \uc7a0\uae08 \ud574\uc81c \uac00\ub2a5\ud55c \ucf58\ud150\uce20\uac00 \uc788\ub098\uc694?", "answer": "\uc720\ub178 \uc628\ub77c\uc778\uc758 \ud2b9\uc815 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uad11\ubc94\uc704\ud558\uac8c \uae30\ub85d\ub418\uc5b4 \uc788\uc9c0 \uc54a\uc9c0\ub9cc, \ub9ce\uc740 \ubaa8\ubc14\uc77c \uac8c\uc784\uc5d0\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\uc815 \uce74\ub4dc \uc870\ud569\uc744 \ud2b9\uc815 \uc21c\uc11c\ub85c \ud50c\ub808\uc774\ud558\ub294 \uac83\uacfc \uac19\uc774 \uac8c\uc784 \uc911\uc5d0 \ud2b9\uc815 \uc791\uc5c5\uc744 \uc218\ud589\ud558\uc5ec \ubc1c\uacac\ub418\ub294 \uc608\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ucd5c\uc2e0 \ubc1c\uacac \uc0ac\ud56d\uc740 \uc628\ub77c\uc778 \ud3ec\ub7fc \ubc0f \ucee4\ubba4\ub2c8\ud2f0\uc5d0\uc11c \ud655\uc778\ud558\uc2ed\uc2dc\uc624. [\ud750\ub984\ub3c4 \uc608\uc2dc]: X \uc791\uc5c5 \uc218\ud589 -> \ube44\ubc00 \uc784\ubb34 \uc644\ub8cc -> \uc774\uc2a4\ud130 \uc5d0\uadf8 \ucf58\ud150\uce20 \ud574\uc81c -> \ub9de\ucda4\ud615 \uc2a4\ud0a8 \ud68d\ub4dd. \ub9ce\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uac8c\uc784 \uc131\ucde8\ub3c4\ub97c \ud1b5\ud574 \uace0\uc720\ud55c \uc544\ubc14\ud0c0\ub098 \uce74\ub4dc \ub4b7\uba74 \ub514\uc790\uc778\uc744 \uc7a0\uae08 \ud574\uc81c\ud569\ub2c8\ub2e4."}]
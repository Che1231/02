[{"question": "\u8f15\u9b06\u4e0a\u624b\u7684\u7dda\u4e0aUno\uff1a\u7576\u65b0\u624b\u73a9\u5bb6\u4f3c\u4e4e\u6c92\u6709\u53ef\u7528\u7684\u724c\u6642\uff0c\u8a72\u5982\u4f55\u51fa\u724c\uff1f", "answer": "\u5728\u7dda\u4e0aUno\u904a\u6232\u4e2d\uff0c\u5982\u679c\u6c92\u6709\u8207\u68c4\u724c\u5806\u9802\u724c\u984f\u8272\u6216\u6578\u5b57\u76f8\u7b26\u7684\u724c\uff0c\u4e5f\u6c92\u6709\u842c\u7528\u724c\uff0c\u5247\u5fc5\u9808\u5f9e\u724c\u5806\u4e2d\u62bd\u53d6\u4e00\u5f35\u724c\u3002\u4f8b\u5982\uff1a\u5982\u679c\u68c4\u724c\u5806\u9802\u90e8\u662f\u7d05\u8272\u300c7\u300d\uff0c\u5247\u60a8\u9700\u8981\u7d05\u8272\u724c\u6216\u300c7\u300d\u724c\uff0c\u6216\u4efb\u4f55\u842c\u7528\u724c\u3002\u5982\u679c\u60a8\u6c92\u6709\u9019\u4e9b\u724c\uff0c\u8acb\u9ede\u64ca\u724c\u5806\u3002\u7136\u5f8c\uff0c\u60a8\u53ef\u4ee5\u5c07\u62bd\u53d6\u7684\u724c\u51fa\u724c\u5982\u679c\u8207\u724c\u5806\u9802\u724c\u76f8\u7b26\u3002\u5225\u5fd8\u4e86\uff0c\u7576\u60a8\u53ea\u5269\u4e0b\u4e00\u5f35\u724c\u6642\uff0c\u8acb\u558a\u300cUno\uff01\u300d"}, {"question": "\u7dda\u4e0aUno\u4e2d\uff0c\u4e0d\u540c\u984f\u8272\u7684\u724c\u80cc\u6709\u4ec0\u9ebc\u610f\u7fa9\uff1f\u4ee5\u53ca\u8eab\u70ba\u65b0\u624b\u73a9\u5bb6\uff0c\u5982\u4f55\u81ea\u5b9a\u7fa9\u9019\u4e9b\u4e0d\u540c\u7684\u724c\u80cc\uff1f", "answer": "\u7dda\u4e0aUno\u904a\u6232\u4e2d\u7684\u724c\u80cc\u7d14\u7cb9\u662f\u8996\u89ba\u6548\u679c\uff0c\u4e0d\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\u3002\u5b83\u5011\u80fd\u500b\u4eba\u5316\u60a8\u7684\u904a\u6232\uff01\u8981\u81ea\u5b9a\u7fa9\uff0c\u8acb\u524d\u5f80\u7dda\u4e0aUno\u61c9\u7528\u7a0b\u5f0f\u6216\u7db2\u7ad9\u7684\u500b\u4eba\u8cc7\u6599\u8a2d\u5b9a\u3002\u60a8\u901a\u5e38\u6703\u627e\u5230\u4e00\u500b\u300c\u81ea\u5b9a\u7fa9\u300d\u6216\u300c\u5916\u89c0\u300d\u9078\u9805\u3002\u60a8\u53ef\u80fd\u53ef\u4ee5\u900f\u904e\u6210\u5c31\u89e3\u9396\u724c\u80cc\uff0c\u6216\u4f7f\u7528\u904a\u6232\u5167\u8ca8\u5e63\u6216\u771f\u5be6\u8ca8\u5e63\u5728\u5546\u5e97\u8cfc\u8cb7\u3002\u9019\u662f\u4e00\u500b\u5c55\u73fe\u500b\u4eba\u98a8\u683c\u7684\u6709\u8da3\u65b9\u5f0f\uff01\u6b64\u529f\u80fd\u7d14\u7cb9\u662f\u8996\u89ba\u4e0a\u7684\uff0c\u900f\u904e\u66f4\u6539[\u500b\u4eba\u8cc7\u6599] - > [\u5916\u89c0]\u9078\u9805\uff0c\u5373\u53ef\u7f8e\u5316\u60a8\u7684\u904a\u6232\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u7dda\u4e0aUno\u904a\u6232\u6709\u6642\u6703\u8df3\u904e\u6211\u7684\u56de\u5408\uff0c\u5373\u4f7f\u6211\u6709\u53ef\u51fa\u7684\u724c\uff1f\u6211\u8a72\u5982\u4f55\u907f\u514d\u9019\u7a2e\u7169\u60f1\uff1f", "answer": "\u7dda\u4e0aUno\u904a\u6232\u6709\u6642\u53ef\u80fd\u6703\u8df3\u904e\u60a8\u7684\u56de\u5408\uff0c\u539f\u56e0\u53ef\u80fd\u662f\u7db2\u8def\u9023\u7dda\u554f\u984c\u5c0e\u81f4\u5ef6\u9072\u3002\u9019\u4e5f\u53ef\u80fd\u767c\u751f\u5728\u7cfb\u7d71\u932f\u8aa4\u5730\u8a8d\u70ba\u60a8\u5728\u898f\u5b9a\u6642\u9593\u5167\u6c92\u6709\u51fa\u724c\uff0c\u6216\u8005\u932f\u8aa4\u5730\u61c9\u7528\u8df3\u904e\u724c\u3002\u53ef\u80fd\u7684\u539f\u56e0\u5305\u62ec\u7cfb\u7d71\u5c0d\u8df3\u904e\u724c\u7684\u61c9\u7528\u932f\u8aa4\u3002\u4ee5\u4e0b\u662f\u4e00\u4e9b\u60a8\u53ef\u4ee5\u5617\u8a66\u7684\u65b9\u6cd5\uff1a\n\u6b65\u9a5f 1\uff1a\u6aa2\u67e5\u60a8\u7684\u7db2\u8def\u9023\u7dda\u4e26\u78ba\u4fdd\u5176\u7a69\u5b9a\u3002\n\u6b65\u9a5f 2\uff1a\u5617\u8a66\u91cd\u65b0\u6574\u7406\u904a\u6232\u6216\u91cd\u65b0\u555f\u52d5\u61c9\u7528\u7a0b\u5f0f\u3002\n\u6b65\u9a5f 3\uff1a\u5982\u679c\u554f\u984c\u6301\u7e8c\u5b58\u5728\uff0c\u8acb\u806f\u7d61\u5ba2\u670d\u3002\u5982\u679c\u53ef\u80fd\uff0c\u8acb\u63d0\u4f9b\u622a\u5716\u6216\u5f71\u7247\u3002"}, {"question": "\u5728\u7dda\u4e0aUno\u7684\u9ad8\u968e\u7b56\u7565\u4e2d\uff0c\u8001\u624b\u73a9\u5bb6\u53ef\u4ee5\u5982\u4f55\u904b\u7528\u842c\u7528\u724c\uff0c\u6700\u5927\u5316\u5c0d\u5c0d\u624b\u7684\u5f71\u97ff\uff1f", "answer": "\u7d93\u9a57\u8c50\u5bcc\u7684\u7dda\u4e0aUno\u73a9\u5bb6\u6703\u7b56\u7565\u6027\u5730\u4f7f\u7528\u842c\u7528\u724c\uff0c\u5c24\u5176\u662f\u842c\u7528\u63db\u56db\u724c\uff0c\u4f86\u64fe\u4e82\u5c0d\u624b\u4e26\u63a7\u5236\u904a\u6232\u7bc0\u594f\u3002\u4ee5\u4e0b\u662f\u4e00\u500b\u9ad8\u7d1a\u7b56\u7565\uff1a\n\u6b65\u9a5f 1\uff1a\u89c0\u5bdf\u5c0d\u624b\u7684\u724c\u6578\u3002\u5982\u679c\u6709\u4eba\u724c\u6578\u5c11\uff0c\u907f\u514d\u8f15\u6613\u7d66\u4e88\u4ed6\u5011\u53ef\u4ee5\u8f15\u9b06\u51fa\u7684\u984f\u8272\uff0c\u5c24\u5176\u662f\u4ed6\u5011\u660e\u986f\u6301\u6709\u8a72\u984f\u8272\u724c\u3002\n\u6b65\u9a5f 2\uff1a\u5617\u8a66\u8feb\u4f7f\u5c0d\u624b\u5728\u5269\u9918\u724c\u6578\u975e\u5e38\u5c11\u6642\u62bd\u724c\uff0c\u5c24\u5176\u662f\u90a3\u4e9b\u9084\u6c92\u558a\u300cUno\u300d\u7684\u4eba\u3002\u9019\u500b\u7b56\u7565\u7a31\u70ba\u300c\u5c11\u724c\u58d3\u529b\u300d\u3002\n\u6b65\u9a5f 3\uff1a\u758a\u52a0\u842c\u7528\u63db\u56db\u724c\u3002\u7576\u53e6\u4e00\u4f4d\u73a9\u5bb6\u5df2\u56e0\u4e4b\u524d\u7684\u842c\u7528\u63db\u56db\u724c\u800c\u88ab\u8feb\u62bd\u724c\u6642\uff0c\u51fa\u842c\u7528\u63db\u56db\u724c\uff0c\u6700\u5927\u5316\u61f2\u7f70\u3002\u9019\u5728\u60a8\u65c1\u908a\u7684\u4eba\u5373\u5c07\u7372\u52dd\u6642\u5f88\u6709\u7528\u3002"}, {"question": "\u5728\u7dda\u4e0aUno\u4e2d\uff0c\u77ad\u89e3\u62bd\u53d6\u7279\u5b9a\u6578\u5b57\u724c\u7684\u6a5f\u7387\uff0c\u5982\u4f55\u5728\u6211\u904a\u6232\u95dc\u9375\u6642\u523b\uff0c\u6307\u5c0e\u6211\u7684\u904a\u6232\u6c7a\u7b56\uff1f", "answer": "\u77ad\u89e3\u7dda\u4e0aUno\u4e2d\u7684\u724c\u7684\u5206\u914d\uff0c\u53ef\u4ee5\u8b93\u4f60\u5728\u904a\u6232\u95dc\u9375\u6642\u523b\u505a\u51fa\u66f4\u597d\u7684\u7b56\u7565\u6c7a\u5b9a\u3002[\u914d\u7f6e\u8868\uff1a]\u6709108\u5f35\u724c\uff0c\u6709\u591a\u4efd\u6578\u5b57\u724c (0-9\uff0c\u5404\u7a2e\u984f\u8272)\uff0c\u4ee5\u53ca\u52d5\u4f5c\u724c (\u4f8b\u5982\u8df3\u904e\u3001\u53cd\u8f49\u3001\u62bd\u5169\u5f35)\u3002\u77e5\u9053\u67d0\u4e9b\u6578\u5b57\u724c\u6216\u984f\u8272\u724c\u88ab\u5927\u91cf\u4f7f\u7528\uff0c\u53ef\u4ee5\u6307\u5c0e\u4f60\u7684\u6c7a\u7b56\u3002\u5982\u679c\u4f60\u77e5\u9053\u67d0\u7a2e\u6578\u5b57\u724c\u6216\u984f\u8272\u724c\u5728\u904a\u6232\u4e2d\u975e\u5e38\u5c11\uff0c\u5247\u5c07\u842c\u7528\u724c\u8a2d\u5b9a\u70ba\u8a72\u984f\u8272\u5c07\u6210\u70ba\u66f4\u5b89\u5168\u7684\u8ced\u6ce8\u3002"}, {"question": "\u5728\u7dda\u4e0aUno\u4e2d\uff0c\u5982\u4f55\u6709\u6548\u5730\u4f7f\u7528\u62bd\u5169\u5f35\u724c\u4f86\u9632\u5b88\uff0c\u4ee5\u4fdd\u8b77\u81ea\u5df1\u514d\u53d7\u5c0d\u624b\u7a4d\u6975\u91dd\u5c0d\uff1f", "answer": "\u5728\u7dda\u4e0aUno\u4e2d\uff0c\u4ee5\u9632\u5b88\u65b9\u5f0f\u4f7f\u7528\u62bd\u5169\u5f35\u724c\uff0c\u9700\u8981\u9810\u6e2c\u5c0d\u624b\u7684\u884c\u70ba\u4e26\u6253\u4e82\u4ed6\u5011\u7684\u8a08\u5283\u3002\u73a9\u62bd\u5169\u5f35\u724c\u7684\u6700\u4f73\u6642\u6a5f\u53d6\u6c7a\u65bc\u77e5\u9053\u4f55\u6642\u5c0d\u5c0d\u624b\u63a1\u53d6\u653b\u52e2\u3002\u5982\u679c\u60a8\u6ce8\u610f\u5230\u5c0d\u624b\u56e4\u7a4d\u8a31\u591a\u724c\uff0c\u6216\u5373\u5c07\u7372\u52dd\uff0c\u4f7f\u7528\u62bd\u5169\u5f35\u724c\u53ef\u4ee5\u8feb\u4f7f\u4ed6\u5011\u62bd\u53d6\u984d\u5916\u7684\u724c\uff0c\u4f7f\u5176\u6e1b\u7de9\u901f\u5ea6\u3002\u76ee\u6a19\u61c9\u8a72\u662f\u61f2\u7f70\u4f60\u7684\u5c0d\u624b\uff0c\u6700\u597d\u662f\u724c\u6578\u8f03\u5c11\u7684\u5c0d\u624b\u3002"}, {"question": "\u7dda\u4e0aUno\u662f\u4f7f\u7528\u4ec0\u9ebc\u8a73\u7d30\u6f14\u7b97\u6cd5\u4f86\u6d17\u724c\u548c\u767c\u724c\uff1f\u9019\u5982\u4f55\u5f71\u97ff\u904a\u6232\u7684\u516c\u5e73\u6027\u548c\u96a8\u6a5f\u6027\uff1f", "answer": "\u7dda\u4e0aUno\u7684\u6d17\u724c\u6f14\u7b97\u6cd5\u8a2d\u8a08\u70ba\u6a21\u64ec\u771f\u5be6\u7684\u6d17\u724c\u904e\u7a0b\u3002\u96d6\u7136\u7cbe\u78ba\u7684\u6f14\u7b97\u6cd5\u672a\u516c\u958b\uff0c\u4f46\u5b83\u901a\u5e38\u4f7f\u7528\u57fa\u65bc\u6642\u9593\u6216\u7cfb\u7d71\u751f\u6210\u7684\u503c\u7684\u507d\u96a8\u6a5f\u6578\u7522\u751f\u5668 (PRNG) \u4f86\u78ba\u4fdd\u904a\u6232\u4e4b\u9593\u7684\u8b8a\u5316\u6027\u3002\u516c\u5e73\u6027\u7684\u5f71\u97ff\u5305\u62ec\u78ba\u4fdd\u6bcf\u4f4d\u73a9\u5bb6\u90fd\u6709\u540c\u7b49\u6a5f\u6703\u7372\u5f97\u4efb\u4f55\u4e00\u5f35\u724c\u3002\u7cfb\u7d71\u8a66\u5716\u907f\u514d\u6a21\u5f0f\u6216\u53ef\u9810\u6e2c\u7684\u5e8f\u5217\uff0c\u4e26\u7dad\u6301\u7af6\u722d\u6027\u3002\u6f14\u7b97\u6cd5\u53ef\u80fd\u6703\u512a\u5148\u8003\u616e\u907f\u514d\u5728\u591a\u500b\u904a\u6232\u4e2d\u91cd\u8907\u767c\u724c\u3002"}, {"question": "\u5728\u7dda\u4e0aUno\u7684\u6392\u4f4d\u6a21\u5f0f\u4e2d\uff0c\u96b1\u85cf\u7684MMR (\u5339\u914d\u8a55\u7d1a) \u548cELO\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\uff0c\u4ee5\u78ba\u4fdd\u516c\u5e73\u4e14\u7af6\u722d\u6027\u7684\u6bd4\u8cfd\uff1f", "answer": "\u7dda\u4e0aUno\uff0c\u8207\u8a31\u591a\u6392\u4f4d\u904a\u6232\u4e00\u6a23\uff0c\u4f7f\u7528\u96b1\u85cf\u7684 MMR (\u5339\u914d\u8a55\u7d1a) \u6216\u985e\u4f3cELO \u7684\u7cfb\u7d71\u4f86\u914d\u5c0d\u5177\u6709\u985e\u4f3c\u6280\u80fd\u6c34\u5e73\u7684\u73a9\u5bb6\u3002\u6b64\u7cfb\u7d71\u6703\u6839\u64da\u60a8\u7684\u7372\u52dd\u3001\u5931\u6557\u4ee5\u53ca\u60a8\u9762\u5c0d\u7684\u5176\u4ed6\u73a9\u5bb6\u7684\u76f8\u5c0d\u6392\u540d\uff0c\u52d5\u614b\u8abf\u6574\u60a8\u7684\u8a55\u7d1a\u3002\u64ca\u6557\u66f4\u9ad8\u6392\u540d\u7684\u5c0d\u624b\u6703\u7372\u5f97\u66f4\u5927\u7684 MMR \u589e\u9577\u3002\u8f38\u7d66\u8f03\u4f4e\u6392\u540d\u7684\u73a9\u5bb6\u6703\u5c0e\u81f4\u66f4\u5927\u7684 MMR \u6e1b\u5c11\u3002\u9019\u78ba\u4fdd\u60a8\u6301\u7e8c\u8207\u63d0\u4f9b\u9069\u7576\u6311\u6230\u7684\u73a9\u5bb6\u914d\u5c0d\uff0c\u5f9e\u800c\u7522\u751f\u66f4\u5e73\u8861\u4e14\u7af6\u722d\u6027\u7684\u904a\u6232\u3002"}, {"question": "\u5982\u679c\u6211\u5f9e\u96fb\u8166\u5207\u63db\u5230\u624b\u6a5f\u6216\u5e73\u677f\u96fb\u8166\u4f86\u73a9\u7dda\u4e0aUno\uff0c\u5e73\u53f0\u9593\u7684\u76f8\u5bb9\u6027\u4ee5\u53ca\u5e33\u6236\u6578\u64da\u540c\u6b65\u7684\u9806\u66a2\u5ea6\u5982\u4f55\uff1f", "answer": "\u7dda\u4e0aUno\u901a\u5e38\u6703\u63d0\u4f9b\u9806\u66a2\u7684\u8de8\u5e73\u53f0\u76f8\u5bb9\u6027\uff0c\u53ea\u8981\u60a8\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\uff08\u4f8b\u5982\uff0c\u900f\u904eFacebook\u3001Google\u6216\u5c08\u5c6c\u7684\u7dda\u4e0aUno\u5e33\u6236\uff09\u3002\u60a8\u7684\u904a\u6232\u9032\u5ea6\uff0c\u5305\u62ec\u89e3\u9396\u7684\u81ea\u8a02\u9078\u9805\u548c\u73a9\u5bb6\u7b49\u7d1a\uff0c\u901a\u5e38\u6703\u540c\u6b65\u5230\u6240\u6709\u88dd\u7f6e\u3002\u4e0d\u904e\uff0c\u7e3d\u662f\u6700\u597d\u518d\u6b21\u78ba\u8a8d\u60a8\u5df2\u5728\u6bcf\u500b\u88dd\u7f6e\u4e0a\u767b\u5165\u6b63\u78ba\u7684\u5e33\u6236\uff0c\u4ee5\u907f\u514d\u5e73\u53f0\u5207\u63db\u6642\u767c\u751f\u4efb\u4f55\u5dee\u7570\u3002\u5982\u679c\u60a8\u6b63\u5728\u8a3b\u518a\uff0c\u6700\u597d\u5805\u6301\u4f7f\u7528\u76f8\u540c\u7684\u767b\u5165\u65b9\u5f0f\u5728\u4e0d\u540c\u7684\u88dd\u7f6e\u4e0a\u767b\u5165\u3002\u5982\u679c\u6709\u554f\u984c\u767c\u751f\uff0c\u8acb\u96a8\u6642\u806f\u7d61\u5ba2\u670d\u4ee5\u7372\u5f97\u5354\u52a9\u3002"}, {"question": "\u7dda\u4e0aUno \u662f\u5426\u5305\u542b\u4efb\u4f55\u96b1\u85cf\u7684\u5f69\u86cb\u6216\u900f\u904e\u4e0d\u660e\u986f\u7684\u904a\u6232\u5e8f\u5217\u6216\u7279\u5b9a\u904a\u6232\u6210\u5c31\u89e3\u9396\u7684\u5167\u5bb9\uff1f", "answer": "\u96d6\u7136\u7dda\u4e0aUno\u7684\u7279\u5b9a\u5f69\u86cb\u4e26\u672a\u5ee3\u70ba\u4eba\u77e5\uff0c\u4f46\u8a31\u591a\u624b\u6a5f\u904a\u6232\u90fd\u6709\u96b1\u85cf\u529f\u80fd\u3002\u4e00\u500b\u4f8b\u5b50\u662f\u901a\u5e38\u900f\u904e\u904a\u6232\u904e\u7a0b\u4e2d\u57f7\u884c\u7279\u5b9a\u52d5\u4f5c\u5e8f\u5217\u4f86\u767c\u73fe\uff0c\u4f8b\u5982\u4ee5\u7279\u5b9a\u9806\u5e8f\u51fa\u67d0\u4e9b\u724c\u7684\u7d44\u5408\u3002\u8acb\u67e5\u770b\u7dda\u4e0a\u8ad6\u58c7\u548c\u793e\u7fa4\u7db2\u7ad9\uff0c\u4ee5\u7372\u53d6\u6700\u65b0\u7684\u767c\u73fe\u3002[\u6d41\u7a0b\u5716\u7bc4\u4f8b]\uff1a\u57f7\u884cX\u52d5\u4f5c->\u5b8c\u6210\u79d8\u5bc6\u4efb\u52d9->\u89e3\u9396\u5f69\u86cb\u5167\u5bb9->\u7372\u5f97\u81ea\u8a02\u5916\u89c0\u3002"}]
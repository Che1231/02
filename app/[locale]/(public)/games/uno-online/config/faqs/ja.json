[{"question": "\u30a6\u30ce\u30aa\u30f3\u30e9\u30a4\u30f3\uff1a\u65b0\u7c73\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u3057\u3066\u3001\u6709\u52b9\u306a\u624b\u304c\u5168\u304f\u306a\u3044\u3088\u3046\u306b\u898b\u3048\u308b\u5834\u5408\u3001\u3069\u3046\u3059\u308c\u3070\u30ab\u30fc\u30c9\u3092\u30d7\u30ec\u30a4\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30a6\u30ce\u30aa\u30f3\u30e9\u30a4\u30f3\u3067\u306f\u3001\u6368\u3066\u672d\u306e\u5c71\u306e\u4e00\u756a\u4e0a\u306e\u30ab\u30fc\u30c9\u306e\u8272\u3084\u6570\u5b57\u3068\u4e00\u81f4\u3059\u308b\u30ab\u30fc\u30c9\u3001\u307e\u305f\u306f\u30ef\u30a4\u30eb\u30c9\u30ab\u30fc\u30c9\u304c\u306a\u3044\u5834\u5408\u3001\u5c71\u672d\u304b\u3089\u30ab\u30fc\u30c9\u3092\u5f15\u304b\u306a\u3051\u308c\u3070\u306a\u308a\u307e\u305b\u3093\u3002\u4f8b\uff1a\u6368\u3066\u672d\u306e\u5c71\u304c\u8d64\u3044\u300c7\u300d\u306e\u5834\u5408\u3001\u8d64\u3044\u30ab\u30fc\u30c9\u307e\u305f\u306f\u300c7\u300d\u306e\u30ab\u30fc\u30c9\u3001\u307e\u305f\u306f\u4efb\u610f\u306e\u30ef\u30a4\u30eb\u30c9\u30ab\u30fc\u30c9\u304c\u5fc5\u8981\u3067\u3059\u3002\u305d\u308c\u3089\u304c\u306a\u3044\u5834\u5408\u306f\u3001\u5c71\u672d\u3092\u30af\u30ea\u30c3\u30af\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u5f15\u3044\u305f\u30ab\u30fc\u30c9\u304c\u4e00\u81f4\u3059\u308b\u5834\u5408\u306f\u3001\u305d\u306e\u30ab\u30fc\u30c9\u3092\u30d7\u30ec\u30a4\u3067\u304d\u307e\u3059\u3002\u6b8b\u308a1\u679a\u306b\u306a\u3063\u305f\u3089\u300c\u30a6\u30ce\u300d\u3068\u8a00\u3046\u306e\u3092\u5fd8\u308c\u306a\u3044\u3067\u304f\u3060\u3055\u3044\uff01"}, {"question": "\u30a6\u30ce\u30aa\u30f3\u30e9\u30a4\u30f3\u306e\u7570\u306a\u308b\u8272\u306e\u30ab\u30fc\u30c9\u88cf\u9762\u306b\u306f\u3069\u306e\u3088\u3046\u306a\u610f\u5473\u304c\u3042\u308a\u3001\u30a6\u30ce\u30aa\u30f3\u30e9\u30a4\u30f3\u306e\u521d\u5fc3\u8005\u3068\u3057\u3066\u3069\u306e\u3088\u3046\u306b\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30a6\u30ce\u30aa\u30f3\u30e9\u30a4\u30f3\u306e\u30ab\u30fc\u30c9\u88cf\u9762\u306f\u7d14\u7c8b\u306b\u898b\u305f\u76ee\u3060\u3051\u3067\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u306f\u5f71\u97ff\u3057\u307e\u305b\u3093\u3002\u30b2\u30fc\u30e0\u3092\u30d1\u30fc\u30bd\u30ca\u30e9\u30a4\u30ba\u3057\u307e\u3059\uff01\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3059\u308b\u306b\u306f\u3001\u30a6\u30ce\u30aa\u30f3\u30e9\u30a4\u30f3\u306e\u30a2\u30d7\u30ea\u307e\u305f\u306f\u30a6\u30a7\u30d6\u30b5\u30a4\u30c8\u5185\u306e\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\u8a2d\u5b9a\u306b\u79fb\u52d5\u3057\u307e\u3059\u3002\u300c\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u300d\u307e\u305f\u306f\u300c\u5916\u89b3\u300d\u30bb\u30af\u30b7\u30e7\u30f3\u304c\u3042\u308b\u306f\u305a\u3067\u3059\u3002\u5b9f\u7e3e\u3092\u4ecb\u3057\u3066\u30ab\u30fc\u30c9\u88cf\u9762\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u305f\u308a\u3001\u30b2\u30fc\u30e0\u5185\u901a\u8ca8\u307e\u305f\u306f\u30ea\u30a2\u30eb\u30de\u30cd\u30fc\u3067\u30b9\u30c8\u30a2\u3067\u8cfc\u5165\u3057\u305f\u308a\u3059\u308b\u30aa\u30d7\u30b7\u30e7\u30f3\u304c\u3042\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u81ea\u5206\u306e\u30b9\u30bf\u30a4\u30eb\u3092\u30a2\u30d4\u30fc\u30eb\u3059\u308b\u697d\u3057\u3044\u65b9\u6cd5\u3067\u3059\uff01\u3053\u306e\u6a5f\u80fd\u306f\u7d14\u7c8b\u306b\u898b\u305f\u76ee\u306b\u95a2\u3059\u308b\u3082\u306e\u3067\u3001[\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb] \u2013> [\u5916\u89b3]\u3067\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u5909\u66f4\u3057\u3066\u30b2\u30fc\u30e0\u3092\u30b9\u30bf\u30a4\u30ea\u30f3\u30b0\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30a6\u30ce\u30aa\u30f3\u30e9\u30a4\u30f3\u3067\u3001\u30d7\u30ec\u30a4\u53ef\u80fd\u306a\u30ab\u30fc\u30c9\u3092\u6301\u3063\u3066\u3044\u308b\u306b\u3082\u304b\u304b\u308f\u3089\u305a\u3001\u306a\u305c\u30bf\u30fc\u30f3\u304c\u30b9\u30ad\u30c3\u30d7\u3055\u308c\u308b\u3053\u3068\u304c\u3042\u308b\u306e\u3067\u3059\u304b\uff1f\u307e\u305f\u3001\u3053\u306e\u30d5\u30e9\u30b9\u30c8\u30ec\u30fc\u30b7\u30e7\u30f3\u3092\u9632\u3050\u305f\u3081\u306b\u3069\u306e\u3088\u3046\u306a\u5bfe\u7b56\u3092\u8b1b\u3058\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30a6\u30ce\u30aa\u30f3\u30e9\u30a4\u30f3\u3067\u306f\u3001\u63a5\u7d9a\u306e\u554f\u984c\u306b\u3088\u308a\u9045\u5ef6\u304c\u767a\u751f\u3057\u3001\u30bf\u30fc\u30f3\u304c\u30b9\u30ad\u30c3\u30d7\u3055\u308c\u308b\u3088\u3046\u306b\u898b\u3048\u308b\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u30b7\u30b9\u30c6\u30e0\u304c\u5272\u308a\u5f53\u3066\u3089\u308c\u305f\u6642\u9593\u5185\u306b\u30d7\u30ec\u30a4\u3057\u3066\u3044\u306a\u3044\u3068\u8aa4\u3063\u3066\u5224\u65ad\u3057\u305f\u5834\u5408\u3001\u307e\u305f\u306f\u30b9\u30ad\u30c3\u30d7\u30ab\u30fc\u30c9\u3092\u8aa4\u3063\u3066\u9069\u7528\u3057\u305f\u5834\u5408\u306b\u3082\u767a\u751f\u3057\u307e\u3059\u3002\u8003\u3048\u3089\u308c\u308b\u539f\u56e0\u306f\u3001\u30b7\u30b9\u30c6\u30e0\u304c\u30b9\u30ad\u30c3\u30d7\u30ab\u30fc\u30c9\u306b\u8aa4\u3063\u305f\u30a2\u30d7\u30ea\u30b1\u30fc\u30b7\u30e7\u30f3\u3092\u6301\u3063\u3066\u3044\u308b\u3053\u3068\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u3067\u304d\u308b\u3053\u3068\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\u3002\n\u30b9\u30c6\u30c3\u30d71\uff1a\u30a4\u30f3\u30bf\u30fc\u30cd\u30c3\u30c8\u63a5\u7d9a\u3092\u78ba\u8a8d\u3057\u3001\u5b89\u5b9a\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\n\u30b9\u30c6\u30c3\u30d72\uff1a\u30b2\u30fc\u30e0\u3092\u66f4\u65b0\u3059\u308b\u304b\u3001\u30a2\u30d7\u30ea\u3092\u518d\u8d77\u52d5\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\n\u30b9\u30c6\u30c3\u30d73\uff1a\u554f\u984c\u304c\u89e3\u6c7a\u3057\u306a\u3044\u5834\u5408\u306f\u3001\u30b5\u30dd\u30fc\u30c8\u306b\u9023\u7d61\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u53ef\u80fd\u3067\u3042\u308c\u3070\u3001\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\u307e\u305f\u306f\u30d3\u30c7\u30aa\u3092\u63d0\u4f9b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30a6\u30ce\u30aa\u30f3\u30e9\u30a4\u30f3\u3067\u3001\u719f\u7df4\u3057\u305f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30ef\u30a4\u30eb\u30c9\u30ab\u30fc\u30c9\u3092\u3069\u306e\u3088\u3046\u306b\u4f7f\u3044\u3053\u306a\u3057\u3001\u5bfe\u6226\u76f8\u624b\u3078\u306e\u5f71\u97ff\u3092\u6700\u5927\u5316\u3059\u308b\u305f\u3081\u306b\u3069\u306e\u3088\u3046\u306a\u9ad8\u5ea6\u306a\u6226\u7565\u3092\u5c55\u958b\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u7d4c\u9a13\u8c4a\u5bcc\u306a\u30a6\u30ce\u30aa\u30f3\u30e9\u30a4\u30f3\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30ef\u30a4\u30eb\u30c9\u30ab\u30fc\u30c9\u3001\u7279\u306b\u30ef\u30a4\u30eb\u30c9\u30fb\u30c9\u30ed\u30fc4\u30ab\u30fc\u30c9\u3092\u6226\u7565\u7684\u306b\u4f7f\u7528\u3057\u3066\u3001\u5bfe\u6226\u76f8\u624b\u3092\u6df7\u4e71\u3055\u305b\u3001\u30b2\u30fc\u30e0\u306e\u30c6\u30f3\u30dd\u3092\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3057\u307e\u3059\u3002\u9ad8\u5ea6\u306a\u6226\u8853\u30921\u3064\u7d39\u4ecb\u3057\u307e\u3059\u3002\n\u30b9\u30c6\u30c3\u30d71\uff1a\u5bfe\u6226\u76f8\u624b\u306e\u30ab\u30fc\u30c9\u306e\u679a\u6570\u3092\u89b3\u5bdf\u3057\u307e\u3059\u3002\u8ab0\u304b\u306e\u30ab\u30fc\u30c9\u304c\u5c11\u306a\u3044\u5834\u5408\u3001\u660e\u3089\u304b\u306b\u6301\u3063\u3066\u3044\u308b\u8272\u3067\u7c21\u5358\u306b\u9003\u3052\u9053\u3092\u4e0e\u3048\u306a\u3044\u3088\u3046\u306b\u3057\u307e\u3059\u3002\n\u30b9\u30c6\u30c3\u30d72\uff1a\u7279\u306b\u300c\u30a6\u30ce\u300d\u3092\u5ba3\u8a00\u3057\u3066\u3044\u306a\u3044\u4eba\u306b\u3001\u6b8b\u308a\u679a\u6570\u304c\u975e\u5e38\u306b\u5c11\u306a\u3044\u5834\u5408\u306b\u30ab\u30fc\u30c9\u3092\u5f15\u304b\u305b\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002\u3053\u306e\u6226\u8853\u306f\u300c\u30ed\u30fc\u30ab\u30fc\u30c9\u30d7\u30ec\u30c3\u30b7\u30e3\u30fc\u300d\u3068\u547c\u3070\u308c\u307e\u3059\u3002\n\u30b9\u30c6\u30c3\u30d73\uff1a\u30ef\u30a4\u30eb\u30c9\u30fb\u30c9\u30ed\u30fc4\u30ab\u30fc\u30c9\u3092\u91cd\u306d\u307e\u3059\u3002\u5225\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u3059\u3067\u306b\u4ee5\u524d\u306e\u30ef\u30a4\u30eb\u30c9\u30fb\u30c9\u30ed\u30fc4\u30ab\u30fc\u30c9\u304b\u3089\u30ab\u30fc\u30c9\u3092\u5f15\u304f\u3053\u3068\u3092\u5f37\u5236\u3055\u308c\u3066\u3044\u308b\u5834\u5408\u306b\u30ef\u30a4\u30eb\u30c9\u30fb\u30c9\u30ed\u30fc4\u3092\u30d7\u30ec\u30a4\u3057\u3001\u30da\u30ca\u30eb\u30c6\u30a3\u3092\u6700\u5927\u5316\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u52dd\u3068\u3046\u3068\u3057\u3066\u3044\u308b\u4eba\u306e\u96a3\u306b\u3044\u308b\u5834\u5408\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30a6\u30ce\u30aa\u30f3\u30e9\u30a4\u30f3\u3067\u3001\u7279\u5b9a\u306e\u6570\u5b57\u30ab\u30fc\u30c9\u3092\u5f15\u304f\u78ba\u7387\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u6700\u5f8c\u306e\u91cd\u8981\u306a\u77ac\u9593\u306b\u81ea\u5206\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u610f\u601d\u6c7a\u5b9a\u306b\u3069\u306e\u3088\u3046\u306b\u5f79\u7acb\u3061\u307e\u3059\u304b\uff1f", "answer": "\u30a6\u30ce\u30aa\u30f3\u30e9\u30a4\u30f3\u306e\u30ab\u30fc\u30c9\u306e\u5206\u5e03\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u7279\u306b\u30b2\u30fc\u30e0\u306e\u7d42\u76e4\u306b\u8fd1\u3065\u304f\u306b\u3064\u308c\u3066\u3001\u3088\u308a\u6226\u7565\u7684\u306a\u610f\u601d\u6c7a\u5b9a\u304c\u53ef\u80fd\u306b\u306a\u308a\u307e\u3059\u3002[\u69cb\u6210\u8868\uff1a] 108\u679a\u306e\u30ab\u30fc\u30c9\u304c\u3042\u308a\u3001\u6570\u5b57\u30ab\u30fc\u30c9\uff08\u3055\u307e\u3056\u307e\u306a\u8272\u306e0\u301c9\uff09\u3001\u30b9\u30ad\u30c3\u30d7\u3001\u30ea\u30d0\u30fc\u30b9\u3001\u30c9\u30ed\u30fc2\u306a\u3069\u306e\u30a2\u30af\u30b7\u30e7\u30f3\u30ab\u30fc\u30c9\u304c\u8907\u6570\u679a\u3042\u308a\u307e\u3059\u3002\u7279\u5b9a\u306e\u6570\u5b57\u304c\u5927\u5e45\u306b\u67af\u6e07\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u77e5\u3063\u3066\u3044\u308b\u3068\u3001\u610f\u601d\u6c7a\u5b9a\u306e\u6307\u91dd\u306b\u306a\u308a\u307e\u3059\u3002\u7279\u5b9a\u306e\u6570\u5b57\u30ab\u30fc\u30c9\u307e\u305f\u306f\u8272\u306e\u30ab\u30fc\u30c9\u304c\u307b\u3068\u3093\u3069\u306a\u3044\u3053\u3068\u304c\u308f\u304b\u3063\u3066\u3044\u308b\u5834\u5408\u3001\u305d\u306e\u8272\u306b\u30ef\u30a4\u30eb\u30c9\u30ab\u30fc\u30c9\u3092\u30d7\u30ec\u30a4\u3059\u308b\u3053\u3068\u306f\u3088\u308a\u5b89\u5168\u306a\u8ced\u3051\u306b\u306a\u308a\u307e\u3059\u3002"}, {"question": "\u30a6\u30ce\u30aa\u30f3\u30e9\u30a4\u30f3\uff1a\u5bfe\u6226\u76f8\u624b\u304c\u79c1\u3092\u7a4d\u6975\u7684\u306b\u30bf\u30fc\u30b2\u30c3\u30c8\u306b\u3057\u3066\u3044\u308b\u5834\u5408\u3001\u30c9\u30ed\u30fc2\u30ab\u30fc\u30c9\u3092\u9632\u5fa1\u7684\u306b\u4f7f\u7528\u3057\u3066\u81ea\u5206\u81ea\u8eab\u3092\u4fdd\u8b77\u3059\u308b\u6700\u3082\u52b9\u679c\u7684\u306a\u65b9\u6cd5\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30a6\u30ce\u30aa\u30f3\u30e9\u30a4\u30f3\u3067\u30c9\u30ed\u30fc2\u30ab\u30fc\u30c9\u3092\u9632\u5fa1\u7684\u306b\u4f7f\u7528\u3059\u308b\u306b\u306f\u3001\u5bfe\u6226\u76f8\u624b\u306e\u884c\u52d5\u3092\u4e88\u6e2c\u3057\u3001\u5f7c\u3089\u306e\u8a08\u753b\u3092\u59a8\u5bb3\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002\u30c9\u30ed\u30fc2\u30ab\u30fc\u30c9\u3092\u30d7\u30ec\u30a4\u3059\u308b\u306e\u306b\u6700\u9069\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u306f\u3001\u3044\u3064\u5bfe\u6226\u76f8\u624b\u306b\u653b\u6483\u7684\u306b\u306a\u308b\u304b\u3092\u77e5\u3063\u3066\u3044\u308b\u304b\u3069\u3046\u304b\u306b\u304b\u304b\u3063\u3066\u3044\u307e\u3059\u3002\u5bfe\u6226\u76f8\u624b\u304c\u591a\u304f\u306e\u30ab\u30fc\u30c9\u3092\u6e9c\u3081\u8fbc\u3093\u3067\u3044\u308b\u304b\u3001\u52dd\u5229\u306b\u975e\u5e38\u306b\u8fd1\u3065\u3044\u3066\u3044\u308b\u3053\u3068\u306b\u6c17\u4ed8\u3044\u305f\u5834\u5408\u3001\u30c9\u30ed\u30fc2\u30ab\u30fc\u30c9\u3092\u30d7\u30ec\u30a4\u3059\u308b\u3068\u3001\u8ffd\u52a0\u306e\u30ab\u30fc\u30c9\u3092\u5f15\u304f\u3053\u3068\u3092\u5f37\u5236\u3057\u3001\u5f7c\u3089\u306e\u52d5\u304d\u3092\u9045\u3089\u305b\u307e\u3059\u3002\u76ee\u7684\u306f\u3001\u5bfe\u6226\u76f8\u624b\u306b\u7f70\u3092\u4e0e\u3048\u308b\u3053\u3068\u3067\u3042\u308a\u3001\u3067\u304d\u308c\u3070\u30ab\u30fc\u30c9\u306e\u679a\u6570\u304c\u5c11\u306a\u3044\u65b9\u304c\u826f\u3044\u3067\u3057\u3087\u3046\u3002"}, {"question": "\u30a6\u30ce\u30aa\u30f3\u30e9\u30a4\u30f3\u304c\u30c7\u30c3\u30ad\u3092\u30b7\u30e3\u30c3\u30d5\u30eb\u3057\u3066\u30ab\u30fc\u30c9\u3092\u914d\u308b\u305f\u3081\u306b\u4f7f\u7528\u3059\u308b\u8a73\u7d30\u306a\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f\u307e\u305f\u3001\u305d\u308c\u306f\u30b2\u30fc\u30e0\u306e\u516c\u5e73\u6027\u3068\u30e9\u30f3\u30c0\u30e0\u6027\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30a6\u30ce\u30aa\u30f3\u30e9\u30a4\u30f3\u306e\u30b7\u30e3\u30c3\u30d5\u30eb\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u73fe\u5b9f\u4e16\u754c\u306e\u30ab\u30fc\u30c9\u30b7\u30e3\u30c3\u30d5\u30eb\u3092\u30b7\u30df\u30e5\u30ec\u30fc\u30c8\u3059\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u6b63\u78ba\u306a\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u516c\u958b\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u304c\u3001\u901a\u5e38\u3001\u6642\u9593\u30d9\u30fc\u30b9\u307e\u305f\u306f\u30b7\u30b9\u30c6\u30e0\u751f\u6210\u306e\u5024\u3067\u30b7\u30fc\u30c9\u3055\u308c\u305f\u64ec\u4f3c\u4e71\u6570\u30b8\u30a7\u30cd\u30ec\u30fc\u30bf\u30fc\uff08PRNG\uff09\u3092\u4f7f\u7528\u3057\u3066\u3001\u30b2\u30fc\u30e0\u9593\u306e\u5909\u52d5\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002\u516c\u5e73\u6027\u3078\u306e\u5f71\u97ff\u306b\u306f\u3001\u5404\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u4efb\u610f\u306e\u30ab\u30fc\u30c9\u3092\u53d7\u3051\u53d6\u308b\u5e73\u7b49\u306a\u6a5f\u4f1a\u3092\u6301\u3064\u3053\u3068\u3092\u4fdd\u8a3c\u3059\u308b\u3053\u3068\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u30b7\u30b9\u30c6\u30e0\u306f\u30d1\u30bf\u30fc\u30f3\u3084\u4e88\u6e2c\u53ef\u80fd\u306a\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u56de\u907f\u3057\u3088\u3046\u3068\u3057\u3001\u305d\u308c\u304c\u7af6\u4e89\u529b\u3092\u7dad\u6301\u3057\u307e\u3059\u3002\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u8907\u6570\u306e\u30b2\u30fc\u30e0\u3067\u91cd\u8907\u3059\u308b\u30cf\u30f3\u30c9\u3092\u9632\u3050\u3053\u3068\u3092\u512a\u5148\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u4e00\u8cab\u3057\u305f\u30a8\u30af\u30b9\u30da\u30ea\u30a8\u30f3\u30b9\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306e\u9375\u3067\u3059\u3002"}, {"question": "\u30a6\u30ce\u30aa\u30f3\u30e9\u30a4\u30f3\u306e\u30e9\u30f3\u30af\u30e2\u30fc\u30c9\u3067\u3001\u96a0\u3055\u308c\u305fMMR\uff08\u30de\u30c3\u30c1\u30e1\u30a4\u30ad\u30f3\u30b0\u30ec\u30fc\u30c6\u30a3\u30f3\u30b0\uff09\u304a\u3088\u3073ELO\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u516c\u5e73\u3067\u7af6\u4e89\u529b\u306e\u3042\u308b\u30de\u30c3\u30c1\u3092\u4fdd\u8a3c\u3059\u308b\u305f\u3081\u306b\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u591a\u304f\u306e\u30e9\u30f3\u30af\u30b2\u30fc\u30e0\u3068\u540c\u69d8\u306b\u3001\u30a6\u30ce\u30aa\u30f3\u30e9\u30a4\u30f3\u306f\u3001\u540c\u69d8\u306e\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u30da\u30a2\u306b\u3059\u308b\u305f\u3081\u306b\u3001\u96a0\u3055\u308c\u305fMMR\uff08\u30de\u30c3\u30c1\u30e1\u30a4\u30ad\u30f3\u30b0\u30ec\u30fc\u30c6\u30a3\u30f3\u30b0\uff09\u307e\u305f\u306fELO\u306e\u3088\u3046\u306a\u30b7\u30b9\u30c6\u30e0\u3092\u4f7f\u7528\u3057\u3066\u3044\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u52dd\u5229\u3001\u6557\u5317\u3001\u304a\u3088\u3073\u5bfe\u6226\u3059\u308b\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u76f8\u5bfe\u7684\u306a\u30e9\u30f3\u30ad\u30f3\u30b0\u306b\u57fa\u3065\u3044\u3066\u3001\u30ec\u30fc\u30c6\u30a3\u30f3\u30b0\u3092\u52d5\u7684\u306b\u8abf\u6574\u3057\u307e\u3059\u3002\u30e9\u30f3\u30ad\u30f3\u30b0\u306e\u9ad8\u3044\u5bfe\u6226\u76f8\u624b\u306b\u52dd\u3064\u3068\u3001MMR\u304c\u5927\u5e45\u306b\u5897\u52a0\u3057\u307e\u3059\u3002\u30e9\u30f3\u30ad\u30f3\u30b0\u306e\u4f4e\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u8ca0\u3051\u308b\u3068\u3001MMR\u304c\u5927\u5e45\u306b\u6e1b\u5c11\u3057\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u9069\u5207\u306a\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u63d0\u4f9b\u3059\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u4e00\u8cab\u3057\u3066\u30de\u30c3\u30c1\u30f3\u30b0\u3055\u308c\u3001\u3088\u308a\u30d0\u30e9\u30f3\u30b9\u306e\u53d6\u308c\u305f\u7af6\u4e89\u529b\u306e\u3042\u308b\u30b2\u30fc\u30e0\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002"}, {"question": "\u30a6\u30ce\u30aa\u30f3\u30e9\u30a4\u30f3\uff1aPC\u3067\u306e\u30d7\u30ec\u30a4\u304b\u3089\u30e2\u30d0\u30a4\u30eb\u307e\u305f\u306f\u30bf\u30d6\u30ec\u30c3\u30c8\u306b\u5207\u308a\u66ff\u3048\u305f\u5834\u5408\u3001\u30a2\u30ab\u30a6\u30f3\u30c8\u306e\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u4e92\u63db\u6027\u3068\u30c7\u30fc\u30bf\u540c\u671f\u306f\u3069\u306e\u7a0b\u5ea6\u30b7\u30fc\u30e0\u30ec\u30b9\u3067\u3059\u304b\uff1f", "answer": "\u30a6\u30ce\u30aa\u30f3\u30e9\u30a4\u30f3\u306f\u901a\u5e38\u3001\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\uff08Facebook\u3001Google\u3001\u307e\u305f\u306f\u5c02\u7528\u306e\u30a6\u30ce\u30aa\u30f3\u30e9\u30a4\u30f3\u30a2\u30ab\u30a6\u30f3\u30c8\u306a\u3069\uff09\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u9650\u308a\u3001\u30b7\u30fc\u30e0\u30ec\u30b9\u306a\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u4e92\u63db\u6027\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u30ed\u30c3\u30af\u89e3\u9664\u3055\u308c\u305f\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u30aa\u30d7\u30b7\u30e7\u30f3\u3084\u30d7\u30ec\u30a4\u30e4\u30fc\u30ec\u30d9\u30eb\u306a\u3069\u3001\u30b2\u30fc\u30e0\u306e\u9032\u884c\u72b6\u6cc1\u306f\u901a\u5e38\u3001\u3059\u3079\u3066\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u671f\u3055\u308c\u307e\u3059\u3002\u305f\u3060\u3057\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u5207\u308a\u66ff\u3048\u308b\u969b\u306b\u4e0d\u4e00\u81f4\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u3001\u5404\u30c7\u30d0\u30a4\u30b9\u3067\u6b63\u3057\u3044\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u5e38\u306b\u518d\u78ba\u8a8d\u3059\u308b\u3053\u3068\u3092\u304a\u52e7\u3081\u3057\u307e\u3059\u3002\u30b5\u30a4\u30f3\u30a2\u30c3\u30d7\u3059\u308b\u5834\u5408\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30ed\u30b0\u30a4\u30f3\u65b9\u6cd5\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u3092\u304a\u52e7\u3081\u3057\u307e\u3059\u3002\u554f\u984c\u304c\u767a\u751f\u3057\u305f\u5834\u5408\u306f\u3001\u5e38\u306b\u30b5\u30dd\u30fc\u30c8\u306b\u9023\u7d61\u3057\u3066\u652f\u63f4\u3092\u6c42\u3081\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30a6\u30ce\u30aa\u30f3\u30e9\u30a4\u30f3\u306b\u306f\u3001\u3042\u3044\u307e\u3044\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u30b7\u30fc\u30b1\u30f3\u30b9\u307e\u305f\u306f\u7279\u5b9a\u306e\u30b2\u30fc\u30e0\u5185\u5b9f\u7e3e\u306b\u3088\u3063\u3066\u30c8\u30ea\u30ac\u30fc\u3055\u308c\u308b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u307e\u305f\u306f\u30ed\u30c3\u30af\u89e3\u9664\u53ef\u80fd\u306a\u30b3\u30f3\u30c6\u30f3\u30c4\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30a6\u30ce\u30aa\u30f3\u30e9\u30a4\u30f3\u306e\u7279\u5b9a\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u5e83\u304f\u6587\u66f8\u5316\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u304c\u3001\u591a\u304f\u306e\u30e2\u30d0\u30a4\u30eb\u30b2\u30fc\u30e0\u306b\u306f\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3068\u3057\u3066\u3001\u7279\u5b9a\u306e\u30ab\u30fc\u30c9\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u7279\u5b9a\u306e\u9806\u5e8f\u3067\u30d7\u30ec\u30a4\u3059\u308b\u306a\u3069\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4e2d\u306b\u7279\u5b9a\u306e\u30a2\u30af\u30b7\u30e7\u30f3\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u5b9f\u884c\u3059\u308b\u3053\u3068\u3067\u898b\u3064\u304b\u308b\u3053\u3068\u304c\u3088\u304f\u3042\u308a\u307e\u3059\u3002\u6700\u65b0\u306e\u767a\u898b\u306b\u3064\u3044\u3066\u306f\u3001\u30aa\u30f3\u30e9\u30a4\u30f3\u30d5\u30a9\u30fc\u30e9\u30e0\u3084\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u306e\u4f8b\uff1a] X\u30a2\u30af\u30b7\u30e7\u30f3\u3092\u5b9f\u884c -> \u79d8\u5bc6\u306e\u30df\u30c3\u30b7\u30e7\u30f3\u3092\u5b8c\u4e86 -> \u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u30a2\u30f3\u30ed\u30c3\u30af -> \u30ab\u30b9\u30bf\u30e0\u30b9\u30ad\u30f3\u3092\u7372\u5f97\u3002\u591a\u304f\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30b2\u30fc\u30e0\u5185\u5b9f\u7e3e\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u3053\u3068\u3067\u3001\u30e6\u30cb\u30fc\u30af\u306a\u30a2\u30d0\u30bf\u30fc\u307e\u305f\u306f\u30ab\u30fc\u30c9\u88cf\u9762\u306e\u30c7\u30b6\u30a4\u30f3\u3092\u767a\u898b\u3057\u307e\u3059\u3002"}]
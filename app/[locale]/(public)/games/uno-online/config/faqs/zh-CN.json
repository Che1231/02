[{"question": "Uno \u5728\u7ebf\u6e38\u620f\uff1a\u4f5c\u4e3a\u4e00\u540d\u65b0\u73a9\u5bb6\uff0c\u5f53\u6211\u4f3c\u4e4e\u6ca1\u6709\u6709\u6548\u64cd\u4f5c\u65f6\uff0c\u5982\u4f55\u6253\u51fa\u4e00\u5f20\u724c\uff1f", "answer": "\u5728 Uno \u5728\u7ebf\u6e38\u620f\u4e2d\uff0c\u5982\u679c\u60a8\u6ca1\u6709\u4e00\u5f20\u724c\u4e0e\u5f03\u724c\u5806\u9876\u90e8\u7684\u724c\u989c\u8272\u6216\u6570\u5b57\u5339\u914d\uff0c\u6216\u8005\u6ca1\u6709\u4e00\u5f20\u4e07\u80fd\u724c\uff0c\u5219\u5fc5\u987b\u4ece\u724c\u5806\u4e2d\u62bd\u53d6\u4e00\u5f20\u724c\u3002 \u4f8b\u5982\uff1a\u5982\u679c\u5f03\u724c\u5806\u4e0a\u662f\u4e00\u5f20\u7ea2\u8272\u7684\u201c7\u201d\uff0c\u60a8\u9700\u8981\u4e00\u5f20\u7ea2\u8272\u7684\u724c\u6216\u4e00\u5f20\u201c7\u201d\u724c\uff0c\u6216\u8005\u4efb\u4f55\u4e07\u80fd\u724c\u3002 \u5982\u679c\u60a8\u6ca1\u6709\u8fd9\u4e9b\uff0c\u8bf7\u70b9\u51fb\u724c\u5806\u3002\u7136\u540e\uff0c\u60a8\u53ef\u4ee5\u6253\u51fa\u62bd\u5230\u7684\u724c\uff0c\u5982\u679c\u5b83\u5339\u914d\u7684\u8bdd\u3002 \u4e0d\u8981\u5fd8\u8bb0\uff0c\u5f53\u60a8\u53ea\u5269\u4e0b\u4e00\u5f20\u724c\u65f6\u8981\u8bf4\u201cUno\uff01\u201d"}, {"question": "\u5728 Uno \u5728\u7ebf\u6e38\u620f\u4e2d\uff0c\u4e0d\u540c\u989c\u8272\u7684\u724c\u80cc\u6709\u4ec0\u4e48\u610f\u4e49\uff1f \u4f5c\u4e3a\u4e00\u540d\u65b0\u73a9\u5bb6\uff0c\u5982\u4f55\u81ea\u5b9a\u4e49\u8fd9\u4e9b\u724c\u80cc\uff1f", "answer": "Uno \u5728\u7ebf\u6e38\u620f\u4e2d\u7684\u724c\u80cc\u7eaf\u7cb9\u662f\u4e3a\u4e86\u7f8e\u89c2\uff0c\u4e0d\u4f1a\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\u3002\u5b83\u4eec\u53ef\u4ee5\u4e2a\u6027\u5316\u60a8\u7684\u6e38\u620f\uff01\u8981\u81ea\u5b9a\u4e49\uff0c\u8bf7\u524d\u5f80 Uno \u5728\u7ebf\u5e94\u7528\u6216\u7f51\u7ad9\u4e2d\u7684\u4e2a\u4eba\u8d44\u6599\u8bbe\u7f6e\u3002\u901a\u5e38\u4f1a\u627e\u5230\u201c\u81ea\u5b9a\u4e49\u201d\u6216\u201c\u5916\u89c2\u201d\u90e8\u5206\u3002\u53ef\u80fd\u53ef\u4ee5\u901a\u8fc7\u6210\u5c31\u89e3\u9501\u724c\u80cc\uff0c\u6216\u8005\u4f7f\u7528\u6e38\u620f\u5185\u8d27\u5e01\u6216\u771f\u94b1\u5728\u5546\u5e97\u8d2d\u4e70\u3002\u8fd9\u662f\u5c55\u793a\u4e2a\u4eba\u98ce\u683c\u7684\u6709\u8da3\u65b9\u5f0f\uff01\u6b64\u529f\u80fd\u7eaf\u7cb9\u662f\u4e3a\u4e86\u7f8e\u89c2\uff0c\u901a\u8fc7\u66f4\u6539 [\u4e2a\u4eba\u8d44\u6599] -> [\u5916\u89c2] \u4e2d\u7684\u9009\u9879\u6765\u5e2e\u52a9\u60a8\u7f8e\u5316\u6e38\u620f\u3002"}, {"question": "\u4e3a\u4ec0\u4e48 Uno \u5728\u7ebf\u6e38\u620f\u6709\u65f6\u4f1a\u8df3\u8fc7\u6211\u7684\u56de\u5408\uff0c\u5373\u4f7f\u6211\u6709\u53ef\u7528\u7684\u724c\uff1f\u6211\u8be5\u5982\u4f55\u907f\u514d\u8fd9\u79cd\u4ee4\u4eba\u6cae\u4e27\u7684\u60c5\u51b5\uff1f", "answer": "\u6709\u65f6\uff0cUno \u5728\u7ebf\u6e38\u620f\u53ef\u80fd\u4f1a\u7531\u4e8e\u8fde\u63a5\u95ee\u9898\u9020\u6210\u5ef6\u8fdf\u800c\u8df3\u8fc7\u60a8\u7684\u56de\u5408\u3002\u5982\u679c\u7cfb\u7edf\u9519\u8bef\u5730\u8ba4\u4e3a\u60a8\u672a\u5728\u89c4\u5b9a\u65f6\u95f4\u5185\u51fa\u724c\u6216\u9519\u8bef\u5730\u5e94\u7528\u4e86\u8df3\u8fc7\u724c\uff0c\u4e5f\u4f1a\u53d1\u751f\u8fd9\u79cd\u60c5\u51b5\u3002\u53ef\u80fd\u7684\u539f\u56e0\u5305\u62ec\u7cfb\u7edf\u5bf9\u8df3\u8fc7\u724c\u7684\u5e94\u7528\u5b58\u5728\u9519\u8bef\u3002\u60a8\u53ef\u4ee5\u5c1d\u8bd5\u4ee5\u4e0b\u64cd\u4f5c\uff1a\n\u6b65\u9aa4 1\uff1a\u68c0\u67e5\u60a8\u7684\u4e92\u8054\u7f51\u8fde\u63a5\u662f\u5426\u7a33\u5b9a\u3002\n\u6b65\u9aa4 2\uff1a\u5c1d\u8bd5\u5237\u65b0\u6e38\u620f\u6216\u91cd\u65b0\u542f\u52a8\u5e94\u7528\u7a0b\u5e8f\u3002\n\u6b65\u9aa4 3\uff1a\u5982\u679c\u95ee\u9898\u6301\u7eed\u5b58\u5728\uff0c\u8bf7\u8054\u7cfb\u652f\u6301\u3002\u5982\u679c\u53ef\u80fd\uff0c\u8bf7\u63d0\u4f9b\u5c4f\u5e55\u622a\u56fe\u6216\u89c6\u9891\u3002"}, {"question": "\u5728 Uno \u5728\u7ebf\u6e38\u620f\u4e2d\uff0c\u4e00\u4f4d\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u53ef\u4ee5\u4f7f\u7528\u54ea\u4e9b\u9ad8\u7ea7\u7b56\u7565\u6765\u7ba1\u7406\u4e07\u80fd\u724c\u5e76\u6700\u5927\u9650\u5ea6\u5730\u53d1\u6325\u5176\u5bf9\u5bf9\u624b\u7684\u5f71\u54cd\uff1f", "answer": "\u7ecf\u9a8c\u4e30\u5bcc\u7684 Uno \u5728\u7ebf\u73a9\u5bb6\u4f1a\u6218\u7565\u6027\u5730\u4f7f\u7528\u4e07\u80fd\u724c\uff0c\u7279\u522b\u662f\u4e07\u80fd\u62bd\u56db\u724c\uff0c\u4ee5\u6270\u4e71\u5bf9\u624b\u5e76\u63a7\u5236\u6e38\u620f\u8282\u594f\u3002\u4ee5\u4e0b\u662f\u4e00\u4e2a\u9ad8\u7ea7\u7b56\u7565\uff1a\n\u6b65\u9aa4 1\uff1a\u89c2\u5bdf\u5bf9\u624b\u7684\u724c\u6570\u3002\u5982\u679c\u6709\u4eba\u724c\u6570\u5f88\u5c11\uff0c\u907f\u514d\u7ed9\u4ed6\u4eec\u4e00\u5f20\u4ed6\u4eec\u660e\u663e\u6301\u6709\u989c\u8272\u7684\u7b80\u5355\u51fa\u724c\u673a\u4f1a\u3002\n\u6b65\u9aa4 2\uff1a\u5c1d\u8bd5\u8feb\u4f7f\u5bf9\u624b\u5728\u4ed6\u4eec\u5269\u4f59\u7684\u724c\u6570\u975e\u5e38\u5c11\u65f6\u62bd\u724c\uff0c\u7279\u522b\u662f\u90a3\u4e9b\u8fd8\u6ca1\u6709\u558a\u201cUno\u201d\u7684\u4eba\u3002\u6b64\u7b56\u7565\u88ab\u79f0\u4e3a\u201c\u5c11\u724c\u538b\u529b\u201d\u3002\n\u6b65\u9aa4 3\uff1a\u53e0\u52a0\u4e07\u80fd\u62bd\u56db\u724c\u3002\u5f53\u53e6\u4e00\u4f4d\u73a9\u5bb6\u5df2\u7ecf\u56e0\u4e3a\u5148\u524d\u7684\u4e07\u80fd\u62bd\u56db\u724c\u800c\u88ab\u8feb\u62bd\u724c\u65f6\uff0c\u51fa\u4e07\u80fd\u62bd\u56db\u724c\uff0c\u6700\u5927\u9650\u5ea6\u5730\u60e9\u7f5a\u4ed6\u4eec\u3002\u8fd9\u5728\u60a8\u65c1\u8fb9\u7684\u4eba\u5373\u5c06\u83b7\u80dc\u65f6\u975e\u5e38\u6709\u7528\u3002"}, {"question": "\u5728 Uno \u5728\u7ebf\u6e38\u620f\u4e2d\uff0c\u4e86\u89e3\u5728\u5173\u952e\u7684\u6700\u540e\u65f6\u523b\u62bd\u53d6\u7279\u5b9a\u6570\u5b57\u724c\u7684\u6982\u7387\u5982\u4f55\u6307\u5bfc\u6211\u7684\u6e38\u620f\u51b3\u7b56\uff1f", "answer": "\u4e86\u89e3 Uno \u5728\u7ebf\u6e38\u620f\u4e2d\u7684\u724c\u5206\u5e03\u53ef\u4ee5\u4f7f\u60a8\u5728\u63a5\u8fd1\u6e38\u620f\u7ed3\u675f\u65f6\u505a\u51fa\u66f4\u597d\u7684\u6218\u7565\u51b3\u7b56\u3002 [\u914d\u7f6e\u8868\uff1a] \u6709 108 \u5f20\u724c\uff0c\u5305\u542b\u591a\u79cd\u4e0d\u540c\u989c\u8272\u7684\u6570\u5b57\u724c\uff080-9\uff09\uff0c\u4ee5\u53ca\u8df3\u8fc7\u3001\u53cd\u5411\u548c\u62bd\u4e24\u5f20\u7b49\u884c\u52a8\u724c\u3002\u77e5\u9053\u67d0\u79cd\u6570\u5b57\u724c\u4e25\u91cd\u532e\u4e4f\u53ef\u4ee5\u6307\u5bfc\u60a8\u7684\u51b3\u7b56\u3002\u5982\u679c\u60a8\u77e5\u9053\u6e38\u620f\u4e2d\u7279\u5b9a\u6570\u5b57\u6216\u989c\u8272\u7684\u724c\u6570\u91cf\u975e\u5e38\u5c11\uff0c\u90a3\u4e48\u6253\u51fa\u4e00\u5f20\u4e07\u80fd\u724c\u5230\u8be5\u989c\u8272\u5c31\u6210\u4e3a\u4e00\u4e2a\u66f4\u5b89\u5168\u7684\u8d4c\u6ce8\u3002"}, {"question": "\u5728 Uno \u5728\u7ebf\u6e38\u620f\u4e2d\uff0c\u5982\u4f55\u6709\u6548\u5730\u9632\u5fa1\u6027\u5730\u4f7f\u7528\u62bd\u4e24\u5f20\u724c\u6765\u4fdd\u62a4\u81ea\u5df1\u514d\u53d7\u5bf9\u624b\u7684\u79ef\u6781\u653b\u51fb\uff1f", "answer": "\u5728 Uno \u5728\u7ebf\u6e38\u620f\u4e2d\uff0c\u9632\u5fa1\u6027\u5730\u4f7f\u7528\u62bd\u4e24\u5f20\u724c\u9700\u8981\u9884\u6d4b\u5bf9\u624b\u7684\u884c\u4e3a\u5e76\u6270\u4e71\u4ed6\u4eec\u7684\u8ba1\u5212\u3002\u4f7f\u7528\u62bd\u4e24\u5f20\u724c\u7684\u6700\u4f73\u65f6\u673a\u5728\u4e8e\u77e5\u9053\u4f55\u65f6\u5bf9\u5bf9\u624b\u91c7\u53d6\u4fb5\u7565\u6027\u7684\u7b56\u7565\u3002\u5982\u679c\u60a8\u6ce8\u610f\u5230\u5bf9\u624b\u56e4\u79ef\u4e86\u8bb8\u591a\u724c\u6216\u8ddd\u79bb\u83b7\u80dc dangerously close \uff0c\u90a3\u4e48\u4f7f\u7528\u4e00\u5f20\u62bd\u4e24\u5f20\u724c\u8feb\u4f7f\u4ed6\u4eec\u62bd\u53d6\u989d\u5916\u7684\u724c\uff0c\u4ece\u800c\u51cf\u7f13\u4ed6\u4eec\u7684\u901f\u5ea6\u3002\u76ee\u6807\u5e94\u8be5\u662f\u60e9\u7f5a\u5bf9\u624b\uff0c\u6700\u597d\u662f\u724c\u6570\u8f83\u5c11\u7684\u5bf9\u624b\u3002"}, {"question": "Uno \u5728\u7ebf\u6e38\u620f\u4f7f\u7528\u4ec0\u4e48\u8be6\u7ec6\u7684\u7b97\u6cd5\u6d17\u724c\u548c\u53d1\u724c\uff1f\u5b83\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u7684\u516c\u5e73\u6027\u548c\u968f\u673a\u6027\uff1f", "answer": "Uno \u5728\u7ebf\u6e38\u620f\u7684\u6d17\u724c\u7b97\u6cd5\u65e8\u5728\u6a21\u62df\u771f\u5b9e\u7684\u6d17\u724c\u8fc7\u7a0b\u3002\u867d\u7136\u786e\u5207\u7684\u7b97\u6cd5\u5e76\u672a\u516c\u5f00\uff0c\u4f46\u5b83\u901a\u5e38\u4f7f\u7528\u57fa\u4e8e\u65f6\u95f4\u7684\u6216\u7cfb\u7edf\u751f\u6210\u7684\u6570\u503c\u64ad\u79cd\u7684\u4f2a\u968f\u673a\u6570\u751f\u6210\u5668 (PRNG)\uff0c\u4ee5\u786e\u4fdd\u6bcf\u6b21\u6e38\u620f\u4e4b\u95f4\u5b58\u5728\u5dee\u5f02\u3002\u516c\u5e73\u6027\u7684\u5f71\u54cd\u5728\u4e8e\u786e\u4fdd\u6bcf\u4e2a\u73a9\u5bb6\u90fd\u6709\u540c\u7b49\u7684\u673a\u4f1a\u62ff\u5230\u4efb\u4f55\u4e00\u5f20\u724c\u3002\u8be5\u7cfb\u7edf\u65e8\u5728\u907f\u514d\u6a21\u5f0f\u6216\u53ef\u9884\u6d4b\u7684\u5e8f\u5217\uff0c\u5e76\u4fdd\u6301\u7ade\u4e89\u6027\u3002\u8be5\u7b97\u6cd5\u53ef\u80fd\u4f18\u5148\u8003\u8651\u9632\u6b62\u5728\u591a\u6b21\u6e38\u620f\u4e2d\u51fa\u73b0\u91cd\u590d\u7684\u624b\u724c\u3002\u8fd9\u5bf9\u4e8e\u7ef4\u6301\u4e00\u81f4\u7684\u6e38\u620f\u4f53\u9a8c\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "Uno \u5728\u7ebf\u6e38\u620f\u7684\u6392\u4f4d\u6a21\u5f0f\u4e2d\uff0c\u9690\u85cf\u7684 MMR\uff08\u5339\u914d\u8bc4\u7ea7\uff09\u548c ELO \u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u786e\u4fdd\u516c\u5e73\u4e14\u5177\u6709\u7ade\u4e89\u6027\u7684\u6bd4\u8d5b\uff1f", "answer": "Uno \u5728\u7ebf\u6e38\u620f\uff0c\u4e0e\u8bb8\u591a\u6392\u4f4d\u6e38\u620f\u4e00\u6837\uff0c\u4f7f\u7528\u9690\u85cf\u7684 MMR\uff08\u5339\u914d\u8bc4\u7ea7\uff09\u6216\u7c7b\u4f3c ELO \u7684\u7cfb\u7edf\u6765\u5c06\u6280\u80fd\u6c34\u5e73\u76f8\u4f3c\u7684\u73a9\u5bb6\u914d\u5bf9\u3002\u8be5\u7cfb\u7edf\u4f1a\u6839\u636e\u60a8\u7684\u83b7\u80dc\u3001\u5931\u8d25\u4ee5\u53ca\u9762\u5bf9\u7684\u5176\u4ed6\u73a9\u5bb6\u7684\u76f8\u5bf9\u6392\u540d\u52a8\u6001\u8c03\u6574\u60a8\u7684\u8bc4\u7ea7\u3002\u51fb\u8d25\u66f4\u9ad8\u7b49\u7ea7\u7684\u5bf9\u624b\u4f1a\u4f7f\u60a8\u7684 MMR \u589e\u52a0\u66f4\u591a\u3002\u8f93\u7ed9\u4f4e\u7b49\u7ea7\u7684\u73a9\u5bb6\u4f1a\u5bfc\u81f4\u60a8\u7684 MMR \u51cf\u5c11\u66f4\u591a\u3002\u8fd9\u786e\u4fdd\u4e86\u60a8\u59cb\u7ec8\u4e0e\u5bf9\u624b\u5339\u914d\uff0c\u5bf9\u624b\u7684\u7b49\u7ea7\u80fd\u591f\u63d0\u4f9b\u5408\u9002\u7684\u6311\u6218\uff0c\u4ece\u800c\u4f7f\u6e38\u620f\u66f4\u52a0\u5e73\u8861\u548c\u5177\u6709\u7ade\u4e89\u529b\u3002"}, {"question": "\u5982\u679c\u6211\u4ece\u7535\u8111\u5207\u6362\u5230\u624b\u673a\u6216\u5e73\u677f\u7535\u8111\u6765\u73a9 Uno \u5728\u7ebf\u6e38\u620f\uff0c\u5176\u8de8\u5e73\u53f0\u517c\u5bb9\u6027\u548c\u8d26\u6237\u6570\u636e\u540c\u6b65\u7684\u6d41\u7545\u5ea6\u5982\u4f55\uff1f", "answer": "Uno \u5728\u7ebf\u6e38\u620f\u901a\u5e38\u63d0\u4f9b\u6d41\u7545\u7684\u8de8\u5e73\u53f0\u517c\u5bb9\u6027\uff0c\u53ea\u8981\u60a8\u767b\u5f55\u540c\u4e00\u4e2a\u5e10\u6237\uff08\u4f8b\u5982\uff0c\u901a\u8fc7 Facebook\u3001Google \u6216\u4e13\u7528\u7684 Uno \u5728\u7ebf\u5e10\u6237\uff09\u3002\u60a8\u7684\u6e38\u620f\u8fdb\u5ea6\uff0c\u5305\u62ec\u5df2\u89e3\u9501\u7684\u81ea\u5b9a\u4e49\u9009\u9879\u548c\u73a9\u5bb6\u7b49\u7ea7\uff0c\u901a\u5e38\u4f1a\u540c\u6b65\u5230\u6240\u6709\u8bbe\u5907\u4e0a\u3002\u4f46\u662f\uff0c\u4e3a\u4e86\u907f\u514d\u4efb\u4f55\u5dee\u5f02\uff0c\u52a1\u5fc5\u5728\u6bcf\u4e2a\u8bbe\u5907\u4e0a\u767b\u5f55\u6b63\u786e\u7684\u5e10\u6237\uff0c\u4ee5\u9632\u51fa\u73b0\u4efb\u4f55\u5dee\u5f02\u3002\u5982\u679c\u60a8\u8981\u6ce8\u518c\uff0c\u6700\u597d\u575a\u6301\u5728\u5404\u79cd\u8bbe\u5907\u4e0a\u4f7f\u7528\u76f8\u540c\u7684\u767b\u5f55\u65b9\u5f0f\u3002\u5982\u679c\u51fa\u73b0\u95ee\u9898\uff0c\u8bf7\u968f\u65f6\u8054\u7cfb\u652f\u6301\u4ee5\u83b7\u53d6\u5e2e\u52a9\u3002"}, {"question": "Uno \u5728\u7ebf\u6e38\u620f\u662f\u5426\u5305\u542b\u4efb\u4f55\u9690\u85cf\u7684\u5f69\u86cb\u6216\u53ef\u89e3\u9501\u7684\u5185\u5bb9\uff0c\u8fd9\u4e9b\u5185\u5bb9\u662f\u901a\u8fc7\u4e0d\u5bfb\u5e38\u7684\u6e38\u620f\u5e8f\u5217\u6216\u7279\u5b9a\u6e38\u620f\u6210\u5c31\u89e6\u53d1\u7684\uff1f", "answer": "\u867d\u7136 Uno \u5728\u7ebf\u6e38\u620f\u4e2d\u7684\u7279\u5b9a\u5f69\u86cb\u5e76\u672a\u5e7f\u6cdb\u8bb0\u5f55\uff0c\u4f46\u8bb8\u591a\u79fb\u52a8\u6e38\u620f\u90fd\u6709\u9690\u85cf\u7684\u529f\u80fd\u3002 \u4f8b\u5982\uff0c\u6709\u65f6\u53ef\u4ee5\u901a\u8fc7\u5728\u6e38\u620f\u4e2d\u6267\u884c\u7279\u5b9a\u52a8\u4f5c\u5e8f\u5217\uff08\u4f8b\u5982\uff0c\u6309\u7279\u5b9a\u987a\u5e8f\u51fa\u67d0\u4e9b\u7ec4\u5408\u724c\uff09\u6765\u53d1\u73b0\u5b83\u4eec\u3002\u8bf7\u5728\u5728\u7ebf\u8bba\u575b\u548c\u793e\u533a\u4e2d\u67e5\u770b\u6700\u65b0\u7684\u53d1\u73b0\u3002[\u6d41\u7a0b\u56fe\u793a\u4f8b]: \u6267\u884c X \u64cd\u4f5c -> \u5b8c\u6210\u79d8\u5bc6\u4efb\u52a1 -> \u89e3\u9501\u5f69\u86cb\u5185\u5bb9 -> \u83b7\u5f97\u5b9a\u5236\u76ae\u80a4\u3002\u8bb8\u591a\u73a9\u5bb6\u901a\u8fc7\u89e3\u9501\u6e38\u620f\u6210\u5c31\u6765\u53d1\u73b0\u72ec\u7279\u7684\u5934\u50cf\u6216\u724c\u80cc\u8bbe\u8ba1\u3002"}]
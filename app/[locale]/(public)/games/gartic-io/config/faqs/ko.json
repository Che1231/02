[{"question": "\ucd08\ubcf4\uc790\uac00 Gartic.io\ub97c \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Gartic.io\ub97c \uc2dc\uc791\ud558\ub824\uba74 \uacf5\uc2dd \uc6f9\uc0ac\uc774\ud2b8\ub97c \ubc29\ubb38\ud558\uac70\ub098 \uc571\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc138\uc694. \uacc4\uc815\uc744 \ub9cc\ub4e4\uac70\ub098 \uac8c\uc2a4\ud2b8\ub85c \ucc38\uc5ec\ud558\uc138\uc694. '\ud074\ub798\uc2dd' \ub610\ub294 '\ud300 \ubaa8\ub4dc'\uc640 \uac19\uc740 \uac8c\uc784 \ubaa8\ub4dc\ub97c \uc120\ud0dd\ud558\uc138\uc694. \ub2e8\uc5b4\ub97c \uadf8\ub9ac\uac70\ub098 \ub2e4\ub978 \uc0ac\ub78c\ub4e4\uc774 \uadf8\ub9b0 \uac83\uc744 \ub9de\ucd94\ub77c\ub294 \uba54\uc2dc\uc9c0\uac00 \ud45c\uc2dc\ub420 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc0ac\uacfc\"\ub77c\ub294 \ub2e8\uc5b4\ub97c \ubc1b\uc73c\uba74 \uac04\ub2e8\ud55c \uc0ac\uacfc \ubaa8\uc591\uc744 \uc2a4\ucf00\uce58\ub85c \uc2dc\uc791\ud558\uc138\uc694. \uc0c9\uc0c1 \ud314\ub808\ud2b8\uc640 \ubd93 \ud06c\uae30\ub97c \uc0ac\uc6a9\ud558\uc5ec \uadf8\ub9bc\uc744 \uac1c\uc120\ud558\uc138\uc694. \uc644\ubcbd\ud558\uc9c0 \uc54a\ub354\ub77c\ub3c4 \uba85\ud655\uc131\uc774 \uc911\uc694\ud569\ub2c8\ub2e4."}, {"question": "Gartic.io\uc758 \uae30\ubcf8 \uadf8\ub9bc \ub3c4\uad6c\ub294 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Gartic.io\ub294 \ubd93, \uc9c0\uc6b0\uac1c, \uc0c9\uc0c1 \ud314\ub808\ud2b8 \ubc0f \ubd93 \ud06c\uae30 \uc120\ud0dd\uae30 \ub4f1 \uc5ec\ub7ec \uadf8\ub9bc \ub3c4\uad6c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub824\uba74 \uba3c\uc800 \ubd93 \ub3c4\uad6c\ub97c \uc120\ud0dd\ud558\uc138\uc694. \ud314\ub808\ud2b8\uc5d0\uc11c \uc8fc\uc81c\uc5d0 \ub9de\ub294 \uc0c9\uc0c1\uc744 \uc120\ud0dd\ud558\uc138\uc694. \uc138\ubd80 \uc0ac\ud56d\uc774\ub098 \uad11\ubc94\uc704\ud55c \uc2a4\ud2b8\ub85c\ud06c\ub97c \uc704\ud574 \ubd93 \ud06c\uae30\ub97c \uc870\uc815\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub098\ubb34 \uac00\uc9c0\uc640 \uac19\uc740 \uc138\ubc00\ud55c \uc120\uc5d0\ub294 \uc791\uc740 \ubd93\uc744, \ub098\ubb34 \uc904\uae30\uc5d0\ub294 \ud070 \ubd93\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. \uc9c0\uc6b0\uac1c\ub294 \uc2e4\uc218\ub97c \uc218\uc815\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. '\uc5f0\uc2b5' \ubaa8\ub4dc\uc5d0\uc11c \uc774\ub7ec\ud55c \ub3c4\uad6c\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc775\uc219\ud574\uc9c0\uc138\uc694."}, {"question": "Gartic.io \ud504\ub85c\ud544\uc744 \uc0ac\uc6a9\uc790 \uc815\uc758\ud574\uc57c \ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub098\uc694?", "answer": "Gartic.io \ud504\ub85c\ud544\uc744 \uc0ac\uc6a9\uc790 \uc815\uc758\ud558\uba74 \ucee4\ubba4\ub2c8\ud2f0\uc5d0\uc11c \uc790\uc2e0\uc744 \uace0\uc720\ud558\uace0 \uc778\uc2dd\ud558\uae30 \uc27d\uac8c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc544\ubc14\ud0c0, \ub2c9\ub124\uc784\uc744 \ubcc0\uacbd\ud558\uace0 \uc2ec\uc9c0\uc5b4 \uc790\uae30\uc18c\uac1c\ub97c \ucd94\uac00\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ube60\ub978 \uc2dd\ubcc4\uc774 \uc911\uc694\ud55c \ud300 \ubaa8\ub4dc\uc5d0\uc11c \uc774\ub7ec\ud55c \uac1c\uc778\ud654\ub294 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub3c5\ud2b9\ud55c \uc544\ubc14\ud0c0\ub294 \ub3d9\ub8cc\uac00 \uadf8\ub9bc\uc744 \ub354 \ube68\ub9ac \uc2dd\ubcc4\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\uc5b4 \ud611\ub825\uacfc \uac8c\uc784 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "100\uc2dc\uac04 \uc774\uc0c1 \ud50c\ub808\uc774\ud55c \ud6c4 Gartic.io\uc5d0\uc11c \ucd94\uce21 \ub2a5\ub825\uc744 \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\ub098\uc694?", "answer": "Gartic.io\uc5d0\uc11c \ucd94\uce21 \ub2a5\ub825\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub824\uba74 \ud328\ud134 \uc778\uc2dd\uacfc \uc2e0\uc18d\ud55c \uc0ac\uace0\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \ucd08\uae30 \uc2a4\ud2b8\ub85c\ud06c\ub97c \uad00\ucc30\ud569\ub2c8\ub2e4. \uc774\ub294 \uc885\uc885 \ubc94\uc8fc (\uc608: \ub3d9\ubb3c\uc5d0 \ub300\ud55c \uaf2c\ubd88\uaf2c\ubd88\ud55c \uc120)\ub97c \uc554\uc2dc\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ubaa8\uc591\uacfc \uc0c9\uc0c1\uacfc \uac19\uc740 \uc8fc\uc694 \ud2b9\uc9d5\uc5d0 \uc9d1\uc911\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub179\uc0c9 \uc717\ubd80\ubd84\uc774 \uc788\ub294 \ube68\uac04 \uc6d0\uc740 \uc0ac\uacfc\ub97c \uc758\ubbf8\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ucc44\ud305\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud78c\ud2b8\ub97c \uc694\uccad\ud558\uac70\ub098 \ucd94\uce21\uc744 \ud655\uc778\ud569\ub2c8\ub2e4. \uc815\uae30\uc801\uc778 \uc5f0\uc2b5\uacfc \ub2e4\uc591\ud55c \uadf8\ub8f9\uacfc\uc758 \ud50c\ub808\uc774\ub294 \ucd94\uce21 \uc815\ud655\uc131\uc744 \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Gartic.io\uc758 \ud300 \ubaa8\ub4dc\uc5d0\uc11c \uc2b9\ub9ac\ud558\uae30 \uc704\ud55c \uace0\uae09 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Gartic.io \ud300 \ubaa8\ub4dc\uc5d0\uc11c \uc2b9\ub9ac\ud558\ub824\uba74 \uc804\ub7b5\uacfc \ud300\uc6cc\ud06c\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc5ed\ud560\uc744 \uc9c0\uc815\ud569\ub2c8\ub2e4. \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\ub294 \uadf8\ub9bc\uc5d0 \uc9d1\uc911\ud558\uace0 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub294 \ucd94\uce21\uc5d0 \uc804\ubb38\ud654\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc2e0\uc18d\ud55c \uc758\uc0ac \uc18c\ud1b5\uc744 \uc704\ud55c \ucc44\ud305\uc5d0\uc11c \uc57d\uc5b4 \ub610\ub294 \ucf54\ub4dc\ub97c \uac1c\ubc1c\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'C'\ub294 \uc0c9\uc0c1, 'S'\ub294 \ubaa8\uc591\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc778\uc2dd \ubc0f \uadf8\ub9bc\uc744 \ube60\ub974\uac8c \ud558\uae30 \uc704\ud574 \uc77c\ubc18\uc801\uc778 \ub2e8\uc5b4\uc640 \uae30\ud638\ub97c \uc5f0\uc2b5\ud569\ub2c8\ub2e4. \uc9c0\uc18d\uc801\uc778 \uc5f0\uc2b5\uacfc \uba85\ud655\ud55c \uc758\uc0ac\uc18c\ud1b5\uc740 \ud300 \ubaa8\ub4dc\uc5d0\uc11c \uc6b0\uc704\ub97c \uc810\ud558\uae30 \uc704\ud55c \uc5f4\uc1e0\uc785\ub2c8\ub2e4."}, {"question": "Gartic.io\uc5d0\uc11c \ube60\ub974\uac8c \uadf8\ub9bc\uc744 \uadf8\ub9ac\ub294 \uae30\uc220\uc744 \ub9c8\uc2a4\ud130\ud558\uc5ec \uc6b0\uc704\ub97c \uc810\ud560 \uc218 \uc788\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Gartic.io\uc5d0\uc11c \ube60\ub978 \uadf8\ub9bc \uadf8\ub9ac\uae30 \uae30\uc220\uc744 \ub9c8\uc2a4\ud130\ud558\ub824\uba74 \ubcf5\uc7a1\ud55c \uc544\uc774\ub514\uc5b4\ub97c \uae30\ubcf8\uc801\uc778 \ubaa8\uc591\uc73c\ub85c \ub2e8\uc21c\ud654\ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \ubb3c\uccb4\ub97c \uac04\ub2e8\ud55c \uae30\ud558\ud559\uc801 \ud615\ud0dc\ub85c \ubd84\ud574\ud569\ub2c8\ub2e4 (\uc608: \uc9d1\uc744 \uc0ac\uac01\ud615\uacfc \uc0bc\uac01\ud615 \uc9c0\ubd95\uc73c\ub85c). \ub2e8\uacc4 2: \uc2dc\uac04\uc744 \uc808\uc57d\ud558\uae30 \uc704\ud574 \uc81c\ud55c\ub41c \uc0c9\uc0c1 \ud314\ub808\ud2b8\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc2dc\uac04 \uc81c\ud55c \ud558\uc5d0 \uc77c\ubc18\uc801\uc778 \ubb3c\uccb4\ub97c \uadf8\ub9ac\ub294 \uc5f0\uc2b5\uc744 \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uace0\uc591\uc774\ub294 \uc138 \uac1c\uc758 \uc2a4\ud2b8\ub85c\ud06c(\ub450 \uadc0\uc640 \uc5bc\uad74)\ub9cc \uc0ac\uc6a9\ud558\uc5ec \uadf8\ub9bd\ub2c8\ub2e4. \uc18d\ub3c4\uc640 \ub2e8\uc21c\uc131\uc740 \uacbd\uc7c1\ub825 \uc788\ub294 \uc7a5\uc810\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}, {"question": "Gartic.io\uc758 \uc810\uc218 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc774\uba70 \uac8c\uc784\ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "Gartic.io\uc758 \uc810\uc218 \uba54\ucee4\ub2c8\uc998\uc740 \uadf8\ub9bc\uacfc \ucd94\uce21 \ubaa8\ub450\ub97c \ubcf4\uc0c1\ud569\ub2c8\ub2e4. \uc815\ud655\ud55c \ucd94\uce21\uc740 \uc18d\ub3c4\uc640 \uc815\ud655\uc131\uc5d0 \ub530\ub77c \uc810\uc218\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. \ub4dc\ub85c\uc5b4\ub294 \uadf8\ub9bc\uc774 \uc815\ud655\ud558\uac8c \ucd94\uce21\ub420 \ub54c \uc810\uc218\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uac1c\"\ub97c \uadf8\ub824\uc11c \ube60\ub974\uac8c \ub9de\ud788\uba74 \ubaa8\ub450 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc774\uc911 \uc2dc\uc2a4\ud15c\uc740 \uba85\ud655\ud55c \uadf8\ub9bc\uacfc \ub0a0\uce74\ub85c\uc6b4 \ucd94\uce21 \ub2a5\ub825\uc744 \uc7a5\ub824\ud558\uc5ec \uac8c\uc784\ud50c\ub808\uc774\ub97c \uc5ed\ub3d9\uc801\uc774\uace0 \ub9e4\ub825\uc801\uc73c\ub85c \ub9cc\ub4ed\ub2c8\ub2e4."}, {"question": "Gartic.io\uc758 \uc54c\uace0\ub9ac\uc998\uc740 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ub2e8\uc5b4\ub97c \uc5b4\ub5bb\uac8c \ud560\ub2f9\ud558\uba70 \uc601\ud5a5\uc744 \uc904 \uc218 \uc788\ub098\uc694?", "answer": "Gartic.io\uc758 \uc54c\uace0\ub9ac\uc998\uc740 \uc0ac\uc804 \uc815\uc758\ub41c \ubaa9\ub85d\uc5d0\uc11c \ub2e8\uc5b4\ub97c \ubb34\uc791\uc704\ub85c \ud560\ub2f9\ud558\uc5ec \uacf5\uc815\uc131\uacfc \ub2e4\uc591\uc131\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4. \ub2e8\uc5b4 \uc120\ud0dd\uc740 \uac8c\uc784 \ubaa8\ub4dc\uc640 \ud638\uc2a4\ud2b8\uac00 \uc124\uc815\ud55c \ub09c\uc774\ub3c4 \uc218\uc900\uc5d0 \ub530\ub77c \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud074\ub798\uc2dd' \ubaa8\ub4dc\uc5d0\uc11c\ub294 \ub2e8\uc21c\ud55c \ubb3c\uccb4\ubd80\ud130 \ubcf5\uc7a1\ud55c \uac1c\ub150\uae4c\uc9c0 \ub2e4\uc591\ud55c \ub2e8\uc5b4\uac00 \uc0ac\uc6a9\ub429\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\ub294 \ub2e8\uc5b4 \ud560\ub2f9\uc5d0 \uc9c1\uc811 \uc601\ud5a5\uc744 \uc904 \uc218\ub294 \uc5c6\uc9c0\ub9cc \ub2e4\ub978 \uac8c\uc784 \ubaa8\ub4dc\ub97c \uc120\ud0dd\ud558\uba74 \ub2e8\uc5b4 \ud480\uacfc \ub09c\uc774\ub3c4\uac00 \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c Gartic.io\uc758 \uc9c4\ud589 \uc0c1\ud669\uacfc \uc131\uacfc\ub97c \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub124, Gartic.io\ub294 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uc5ec \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uacfc \uc131\uacfc\ub97c \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ube0c\ub77c\uc6b0\uc800\uc5d0\uc11c \uac8c\uc784\uc744 \uc2dc\uc791\ud558\uc5ec \ubaa8\ubc14\uc77c \uc571\uc73c\ub85c \uc804\ud658\ud558\uba74 \ud504\ub85c\ud544, \uc131\uacfc \ubc0f \uac8c\uc784 \uae30\ub85d\uc774 \uc790\ub3d9\uc73c\ub85c \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. \uc6d0\ud65c\ud55c \uc9c4\ud589 \uc0c1\ud669 \ucd94\uc801\uc744 \uc704\ud574 \ubaa8\ub4e0 \uae30\uae30\uc5d0\uc11c \ub3d9\uc77c\ud55c \ub85c\uadf8\uc778 \uc790\uaca9 \uc99d\uba85\uc744 \uc0ac\uc6a9\ud558\uc138\uc694."}, {"question": "Gartic.io\uc5d0\ub294 \ub300\ubd80\ubd84\uc758 \ud50c\ub808\uc774\uc5b4\uac00 \ub193\uce58\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\ub098\uc694?", "answer": "Gartic.io\uc5d0\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc5ec\ub7ec \uac1c \uc788\uc2b5\ub2c8\ub2e4. \uc8fc\ubaa9\ud560 \ub9cc\ud55c \uae30\ub2a5 \uc911 \ud558\ub098\ub294 '\ube44\ubc00 \ubaa8\ub4dc'\ub85c, \ud50c\ub808\uc774\uc5b4\ub294 \uc0ac\uc6a9\uc790 \uc9c0\uc815 \ub2e8\uc5b4 \ubaa9\ub85d\uc774 \uc788\ub294 \uac1c\uc778 \ubc29\uc744 \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \ud734\uc77c \ub3d9\uc548 \uac8c\uc784\uc5d0\ub294 \ud14c\ub9c8\ubcc4 \ub2e8\uc5b4\uc640 \uc7a5\uc2dd\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud560\ub85c\uc708\uc5d0\ub294 '\ud638\ubc15'\uc774\ub098 '\uc720\ub839'\uacfc \uac19\uc740 \ubb34\uc11c\uc6b4 \ub2e8\uc5b4\uac00 \ub354 \uc790\uc8fc \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \uc228\uaca8\uc9c4 \ubcf4\uc11d\uc744 \ud0d0\ud5d8\ud558\uba74 \uac8c\uc784\ud50c\ub808\uc774\uc5d0 \ucd94\uac00\uc801\uc778 \uc7ac\ubbf8\ub97c \ub354\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
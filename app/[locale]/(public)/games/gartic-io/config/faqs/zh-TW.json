[{"question": "\u5982\u4f55\u8b93\u521d\u5b78\u8005\u958b\u59cb\u73a9 Gartic.io\uff1f", "answer": "\u8981\u958b\u59cb\u73a9 Gartic.io\uff0c\u9996\u5148\u8acb\u524d\u5f80\u5b98\u65b9\u7db2\u7ad9\u6216\u4e0b\u8f09\u61c9\u7528\u7a0b\u5f0f\u3002\u5efa\u7acb\u5e33\u6236\u6216\u4ee5\u8a2a\u5ba2\u8eab\u5206\u52a0\u5165\u904a\u6232\u3002\u9078\u64c7\u904a\u6232\u6a21\u5f0f\uff0c\u4f8b\u5982\u300c\u7d93\u5178\u6a21\u5f0f\u300d\u6216\u300c\u5718\u968a\u6a21\u5f0f\u300d\u3002\u7cfb\u7d71\u5c07\u63d0\u793a\u60a8\u7e6a\u88fd\u55ae\u5b57\u6216\u731c\u6e2c\u5176\u4ed6\u4eba\u7e6a\u88fd\u7684\u55ae\u5b57\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u62bd\u5230\u300c\u860b\u679c\u300d\u9019\u500b\u55ae\u5b57\uff0c\u8acb\u5148\u7e6a\u88fd\u4e00\u500b\u7c21\u55ae\u7684\u860b\u679c\u5f62\u72c0\u3002\u4f7f\u7528\u984f\u8272\u8abf\u8272\u76e4\u548c\u7b46\u5237\u5927\u5c0f\u4f86\u8c50\u5bcc\u60a8\u7684\u7e6a\u5716\u3002\u8a18\u4f4f\uff0c\u6e05\u6670\u5ea6\u81f3\u95dc\u91cd\u8981\uff0c\u5373\u4f7f\u5b83\u4e0d\u76e1\u5b8c\u7f8e\u3002"}, {"question": "Gartic.io \u7684\u57fa\u672c\u7e6a\u5716\u5de5\u5177\u6709\u54ea\u4e9b\uff0c\u4ee5\u53ca\u5982\u4f55\u6709\u6548\u5730\u4f7f\u7528\u5b83\u5011\uff1f", "answer": "Gartic.io \u63d0\u4f9b\u591a\u7a2e\u7e6a\u5716\u5de5\u5177\uff1a\u7b46\u5237\u3001\u6a61\u76ae\u64e6\u3001\u984f\u8272\u8abf\u8272\u76e4\u548c\u7b46\u5237\u5927\u5c0f\u9078\u64c7\u5668\u3002\u8981\u6709\u6548\u5730\u4f7f\u7528\u5b83\u5011\uff0c\u8acb\u5148\u9078\u64c7\u7b46\u5237\u5de5\u5177\u3002\u5f9e\u8abf\u8272\u76e4\u4e2d\u9078\u53d6\u8207\u60a8\u7684\u4e3b\u984c\u76f8\u7b26\u7684\u984f\u8272\u3002\u8abf\u6574\u7b46\u5237\u5927\u5c0f\uff0c\u7528\u65bc\u7d30\u7bc0\u6216\u5927\u7b46\u89f8\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u5c0f\u7b46\u5237\u7e6a\u88fd\u6a39\u679d\u7d30\u7dda\uff0c\u4f7f\u7528\u8f03\u5927\u7b46\u5237\u7e6a\u88fd\u6a39\u5e79\u3002\u6a61\u76ae\u64e6\u53ef\u5e6b\u52a9\u4fee\u6b63\u932f\u8aa4\u3002\u5728\u300c\u7df4\u7fd2\u300d\u6a21\u5f0f\u4e2d\u7df4\u7fd2\u4f7f\u7528\u9019\u4e9b\u5de5\u5177\uff0c\u4ee5\u4fbf\u719f\u6089\u5b83\u5011\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u61c9\u8a72\u5ba2\u88fd\u5316\u6211\u7684 Gartic.io \u500b\u4eba\u6a94\u6848\uff0c\u4ee5\u53ca\u5982\u4f55\u63d0\u5347\u6211\u7684\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u5ba2\u88fd\u5316\u60a8\u7684 Gartic.io \u500b\u4eba\u6a94\u6848\uff0c\u8b93\u60a8\u7684\u5b58\u5728\u7368\u7279\u4e14\u5728\u793e\u7fa4\u4e2d\u5bb9\u6613\u8fa8\u8b58\u3002\u60a8\u53ef\u4ee5\u66f4\u6539\u60a8\u7684\u500b\u4eba\u5f62\u8c61\u3001\u66b1\u7a31\uff0c\u751a\u81f3\u6dfb\u52a0\u7c21\u6b77\u3002\u6b64\u500b\u4eba\u5316\u8a2d\u5b9a\u5728\u5718\u968a\u6a21\u5f0f\u4e2d\u975e\u5e38\u91cd\u8981\uff0c\u56e0\u70ba\u5feb\u901f\u8fa8\u8b58\u81f3\u95dc\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u4e00\u500b\u7368\u7279\u7684\u500b\u4eba\u5f62\u8c61\u53ef\u4ee5\u5e6b\u52a9\u968a\u53cb\u66f4\u5feb\u5730\u8fa8\u8b58\u60a8\u7684\u7e6a\u5716\uff0c\u63d0\u5347\u5354\u8abf\u6027\u548c\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u5728\u73a9\u8d85\u904e 100 \u5c0f\u6642\u5f8c\uff0c\u5982\u4f55\u63d0\u5347\u6211\u5728 Gartic.io \u7684\u731c\u5b57\u6280\u5de7\uff1f", "answer": "\u5728 Gartic.io \u4e2d\u63d0\u5347\u731c\u5b57\u6280\u5de7\u9700\u8981\u6a21\u5f0f\u8b58\u5225\u548c\u5feb\u901f\u601d\u8003\u3002\u6b65\u9a5f\u4e00\uff1a\u89c0\u5bdf\u521d\u59cb\u7b46\u5283\uff1b\u5b83\u5011\u901a\u5e38\u6697\u793a\u4e86\u985e\u5225\uff08\u4f8b\u5982\uff0c\u66f2\u7dda\u6697\u793a\u52d5\u7269\uff09\u3002\u6b65\u9a5f\u4e8c\uff1a\u5c08\u6ce8\u65bc\u95dc\u9375\u7279\u5fb5\uff0c\u4f8b\u5982\u5f62\u72c0\u548c\u984f\u8272\u3002\u4f8b\u5982\uff0c\u4e00\u500b\u5e36\u6709\u7da0\u8272\u9802\u90e8\u7684\u7d05\u8272\u5713\u5708\u5f88\u53ef\u80fd\u4ee3\u8868\u860b\u679c\u3002\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u804a\u5929\u5ba4\u8acb\u6c42\u63d0\u793a\u6216\u78ba\u8a8d\u731c\u6e2c\u3002\u5b9a\u671f\u7df4\u7fd2\uff0c\u4e26\u8207\u4e0d\u540c\u7684\u5c0f\u7d44\u4e00\u8d77\u904a\u6232\uff0c\u80fd\u986f\u8457\u63d0\u9ad8\u60a8\u7684\u731c\u5b57\u6e96\u78ba\u5ea6\u3002"}, {"question": "\u5728 Gartic.io \u7684\u5718\u968a\u6a21\u5f0f\u4e2d\uff0c\u6211\u53ef\u4ee5\u4f7f\u7528\u54ea\u4e9b\u9032\u968e\u7b56\u7565\u4f86\u7372\u52dd\uff1f", "answer": "\u5728 Gartic.io \u7684\u5718\u968a\u6a21\u5f0f\u4e2d\u7372\u52dd\u9700\u8981\u7b56\u7565\u548c\u5718\u968a\u5408\u4f5c\u3002\u6b65\u9a5f\u4e00\uff1a\u5206\u914d\u89d2\u8272\uff1b\u8b93\u4e00\u4e9b\u73a9\u5bb6\u5c08\u6ce8\u65bc\u7e6a\u5716\uff0c\u800c\u53e6\u4e00\u4e9b\u73a9\u5bb6\u5c08\u6ce8\u65bc\u731c\u5b57\u3002\u6b65\u9a5f\u4e8c\uff1a\u5728\u804a\u5929\u5ba4\u4e2d\u5236\u5b9a\u7c21\u5beb\u6216\u4ee3\u78bc\uff0c\u4ee5\u4fbf\u5feb\u901f\u6e9d\u901a\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u300cC\u300d\u8868\u793a\u984f\u8272\uff0c\u6216\u300cS\u300d\u8868\u793a\u5f62\u72c0\u3002\u6b65\u9a5f\u4e09\uff1a\u7df4\u7fd2\u5e38\u898b\u7684\u55ae\u5b57\u548c\u7b26\u865f\uff0c\u4ee5\u52a0\u5feb\u8b58\u5225\u548c\u7e6a\u5716\u901f\u5ea6\u3002\u6301\u7e8c\u7df4\u7fd2\u548c\u6e05\u6670\u7684\u6e9d\u901a\u662f\u638c\u63a7\u5718\u968a\u6a21\u5f0f\u7684\u95dc\u9375\u3002"}, {"question": "\u5982\u4f55\u5feb\u901f\u638c\u63e1 Gartic.io \u7684\u7e6a\u5716\u6280\u5de7\u4ee5\u7372\u5f97\u512a\u52e2\uff1f", "answer": "\u5728 Gartic.io \u4e2d\u5feb\u901f\u638c\u63e1\u7e6a\u5716\u6280\u5de7\uff0c\u9700\u8981\u5c07\u8907\u96dc\u7684\u60f3\u6cd5\u7c21\u5316\u6210\u57fa\u672c\u5f62\u72c0\u3002\u6b65\u9a5f\u4e00\uff1a\u5c07\u7269\u4ef6\u5206\u89e3\u6210\u7c21\u55ae\u7684\u5e7e\u4f55\u5f62\u72c0\uff08\u4f8b\u5982\uff0c\u5c07\u623f\u5c4b\u8996\u70ba\u5e36\u4e09\u89d2\u5f62\u5c4b\u9802\u7684\u6b63\u65b9\u5f62\uff09\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u6709\u9650\u7684\u984f\u8272\u8abf\u8272\u76e4\u7bc0\u7701\u6642\u9593\u3002\u6b65\u9a5f\u4e09\uff1a\u7df4\u7fd2\u5728\u6642\u9593\u9650\u5236\u4e0b\u7e6a\u88fd\u5e38\u898b\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u4e09\u7b46\u89f8\u7e6a\u88fd\u4e00\u96bb\u8c93\uff1a\u5169\u96bb\u8033\u6735\u548c\u4e00\u5f35\u81c9\u3002\u901f\u5ea6\u548c\u7c21\u55ae\u6027\u5c07\u8b93\u60a8\u5728\u7af6\u722d\u4e2d\u4f54\u64da\u512a\u52e2\u3002"}, {"question": "Gartic.io \u7684\u8a08\u5206\u6a5f\u5236\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5b83\u5011\u5982\u4f55\u5f71\u97ff\u904a\u6232\uff1f", "answer": "Gartic.io \u7684\u8a08\u5206\u6a5f\u5236\u734e\u52f5\u7e6a\u5716\u548c\u731c\u5b57\u5169\u8005\u3002\u6b63\u78ba\u7684\u731c\u6e2c\u6703\u6839\u64da\u901f\u5ea6\u548c\u6e96\u78ba\u6027\u7372\u5f97\u5206\u6578\u3002\u7e6a\u5716\u8005\u5728\u4ed6\u5011\u7684\u7e6a\u5716\u88ab\u6b63\u78ba\u731c\u4e2d\u6642\u4e5f\u6703\u7372\u5f97\u5206\u6578\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u7e6a\u88fd\u4e00\u96bb\u300c\u72d7\u300d\uff0c\u4e26\u4e14\u5b83\u88ab\u5feb\u901f\u731c\u4e2d\uff0c\u4f60\u5011\u90fd\u6703\u7372\u5f97\u9ad8\u5206\u3002\u9019\u7a2e\u96d9\u91cd\u7cfb\u7d71\u9f13\u52f5\u6e05\u6670\u7684\u7e6a\u5716\u548c\u654f\u92b3\u7684\u731c\u5b57\u6280\u5de7\uff0c\u4f7f\u904a\u6232\u5145\u6eff\u6d3b\u529b\u548c\u5438\u5f15\u529b\u3002"}, {"question": "Gartic.io \u7684\u6f14\u7b97\u6cd5\u5982\u4f55\u5c07\u55ae\u5b57\u5206\u914d\u7d66\u73a9\u5bb6\uff0c\u4ee5\u53ca\u662f\u5426\u53ef\u4ee5\u5f71\u97ff\u5b83\uff1f", "answer": "Gartic.io \u7684\u6f14\u7b97\u6cd5\u6703\u5f9e\u9810\u5148\u5b9a\u7fa9\u7684\u6e05\u55ae\u4e2d\u96a8\u6a5f\u5206\u914d\u55ae\u5b57\uff0c\u4ee5\u78ba\u4fdd\u516c\u5e73\u6027\u548c\u591a\u6a23\u6027\u3002\u55ae\u5b57\u7684\u9078\u64c7\u6703\u53d7\u5230\u904a\u6232\u6a21\u5f0f\u548c\u4e3b\u6301\u4eba\u8a2d\u5b9a\u7684\u96e3\u5ea6\u7b49\u7d1a\u7684\u5f71\u97ff\u3002\u4f8b\u5982\uff0c\u5728\u300c\u7d93\u5178\u6a21\u5f0f\u300d\u4e2d\uff0c\u55ae\u5b57\u7bc4\u570d\u5f9e\u7c21\u55ae\u7684\u7269\u4ef6\u5230\u8907\u96dc\u7684\u6982\u5ff5\u3002\u96d6\u7136\u73a9\u5bb6\u7121\u6cd5\u76f4\u63a5\u5f71\u97ff\u55ae\u5b57\u5206\u914d\uff0c\u4f46\u9078\u64c7\u4e0d\u540c\u7684\u904a\u6232\u6a21\u5f0f\u53ef\u4ee5\u6539\u8b8a\u55ae\u5b57\u6c60\u548c\u6311\u6230\u7d1a\u5225\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e4b\u9593\u8f49\u79fb\u6211\u7684 Gartic.io \u9032\u5ea6\u548c\u6210\u5c31\u55ce\uff1f", "answer": "\u662f\u7684\uff0cGartic.io\u5141\u8a31\u60a8\u900f\u904e\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u9593\u8f49\u79fb\u9032\u5ea6\u548c\u6210\u5c31\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u700f\u89bd\u5668\u4e0a\u958b\u59cb\u904a\u6232\uff0c\u7136\u5f8c\u5207\u63db\u5230\u884c\u52d5\u61c9\u7528\u7a0b\u5f0f\uff0c\u60a8\u7684\u500b\u4eba\u6a94\u6848\u3001\u6210\u5c31\u548c\u904a\u6232\u6b77\u53f2\u8a18\u9304\u5c07\u6703\u81ea\u52d5\u540c\u6b65\u3002\u8acb\u78ba\u4fdd\u60a8\u5728\u6240\u6709\u88dd\u7f6e\u4e0a\u4f7f\u7528\u76f8\u540c\u7684\u767b\u5165\u6191\u8b49\uff0c\u4ee5\u4fdd\u6301\u9032\u5ea6\u8ffd\u8e64\u7684\u9806\u66a2\u3002"}, {"question": "Gartic.io \u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff0c\u5927\u591a\u6578\u73a9\u5bb6\u90fd\u5ffd\u7565\u4e86\uff1f", "answer": "Gartic.io \u6709\u5e7e\u500b\u96b1\u85cf\u529f\u80fd\u548c\u5f69\u86cb\u3002\u4e00\u500b\u986f\u8457\u7684\u529f\u80fd\u662f\u300c\u79d8\u5bc6\u6a21\u5f0f\u300d\uff0c\u73a9\u5bb6\u53ef\u4ee5\u7528\u81ea\u5b9a\u7fa9\u55ae\u5b57\u6e05\u55ae\u5efa\u7acb\u79c1\u4eba\u623f\u9593\u3002\u6b64\u5916\uff0c\u5728\u7bc0\u5047\u65e5\uff0c\u904a\u6232\u4e2d\u901a\u5e38\u6703\u5305\u542b\u4e3b\u984c\u55ae\u5b57\u548c\u88dd\u98fe\u3002\u4f8b\u5982\uff0c\u5728\u842c\u8056\u7bc0\u671f\u9593\uff0c\u60a8\u53ef\u80fd\u6703\u66f4\u5e38\u9047\u5230\u50cf\u300c\u5357\u74dc\u300d\u6216\u300c\u9b3c\u300d\u9019\u6a23\u7684\u55ae\u5b57\u3002\u63a2\u7d22\u9019\u4e9b\u96b1\u85cf\u5bf6\u85cf\u53ef\u4ee5\u70ba\u60a8\u7684\u904a\u6232\u589e\u6dfb\u66f4\u591a\u6a02\u8da3\u3002"}]
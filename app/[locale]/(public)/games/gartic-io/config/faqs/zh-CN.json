[{"question": "\u5982\u4f55\u4f5c\u4e3a\u65b0\u624b\u5f00\u59cb\u73a9 Gartic.io \u6e38\u620f\uff1f", "answer": "\u8981\u5f00\u59cb\u73a9 Gartic.io\uff0c\u9996\u5148\u8bbf\u95ee\u5b98\u65b9\u7f51\u7ad9\u6216\u4e0b\u8f7d\u5e94\u7528\u3002\u521b\u5efa\u5e10\u6237\u6216\u4ee5\u8bbf\u5ba2\u8eab\u4efd\u52a0\u5165\u3002\u9009\u62e9\u6e38\u620f\u6a21\u5f0f\uff0c\u4f8b\u5982\u201c\u7ecf\u5178\u6a21\u5f0f\u201d\u6216\u201c\u56e2\u961f\u6a21\u5f0f\u201d\u3002\u7cfb\u7edf\u4f1a\u63d0\u793a\u4f60\u753b\u4e00\u4e2a\u8bcd\u6216\u731c\u6d4b\u5176\u4ed6\u4eba\u753b\u7684\u662f\u4ec0\u4e48\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5f97\u5230\u201c\u82f9\u679c\u201d\u8fd9\u4e2a\u8bcd\uff0c\u5148\u7b80\u7565\u5730\u753b\u4e00\u4e2a\u82f9\u679c\u5f62\u72b6\u3002\u4f7f\u7528\u8c03\u8272\u677f\u548c\u753b\u7b14\u5927\u5c0f\u6765\u589e\u5f3a\u4f60\u7684\u7ed8\u753b\u3002\u8bb0\u4f4f\uff0c\u6e05\u6670\u5ea6\u5f88\u91cd\u8981\uff0c\u5373\u4f7f\u753b\u5f97\u4e0d\u592a\u5b8c\u7f8e\u3002"}, {"question": "Gartic.io \u4e2d\u7684\u57fa\u672c\u7ed8\u56fe\u5de5\u5177\u6709\u54ea\u4e9b\u4ee5\u53ca\u5982\u4f55\u6709\u6548\u5730\u4f7f\u7528\u5b83\u4eec\uff1f", "answer": "Gartic.io \u63d0\u4f9b\u4e86\u591a\u79cd\u7ed8\u56fe\u5de5\u5177\uff1a\u753b\u7b14\u3001\u6a61\u76ae\u64e6\u3001\u8c03\u8272\u677f\u548c\u753b\u7b14\u5927\u5c0f\u9009\u62e9\u5668\u3002\u8981\u6709\u6548\u5730\u4f7f\u7528\u5b83\u4eec\uff0c\u9996\u5148\u9009\u62e9\u753b\u7b14\u5de5\u5177\u3002\u4ece\u8c03\u8272\u677f\u4e2d\u9009\u62e9\u4e0e\u4f60\u7684\u4e3b\u9898\u76f8\u5339\u914d\u7684\u989c\u8272\u3002\u8c03\u6574\u753b\u7b14\u5927\u5c0f\uff0c\u4ee5\u7ed8\u5236\u7ec6\u8282\u6216\u5927\u7b14\u89e6\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u5c0f\u753b\u7b14\u7ed8\u5236\u7ec6\u7ebf\uff0c\u5982\u6811\u679d\uff0c\u4f7f\u7528\u5927\u753b\u7b14\u7ed8\u5236\u6811\u5e72\u3002\u6a61\u76ae\u64e6\u53ef\u4ee5\u5e2e\u52a9\u4f60\u7ea0\u6b63\u9519\u8bef\u3002\u5728\u201c\u7ec3\u4e60\u201d\u6a21\u5f0f\u4e2d\u7ec3\u4e60\u4f7f\u7528\u8fd9\u4e9b\u5de5\u5177\uff0c\u4f7f\u5176\u53d8\u5f97\u5f97\u5fc3\u5e94\u624b\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u5e94\u8be5\u81ea\u5b9a\u4e49\u6211\u7684 Gartic.io \u4e2a\u4eba\u8d44\u6599\u4ee5\u53ca\u5b83\u5982\u4f55\u63d0\u5347\u6211\u7684\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u81ea\u5b9a\u4e49\u4f60\u7684 Gartic.io \u4e2a\u4eba\u8d44\u6599\u53ef\u4ee5\u8ba9\u4f60\u7684\u5b58\u5728\u5728\u793e\u533a\u4e2d\u72ec\u4e00\u65e0\u4e8c\u4e14\u6613\u4e8e\u8fa8\u8ba4\u3002\u4f60\u53ef\u4ee5\u66f4\u6539\u4f60\u7684\u5934\u50cf\u3001\u6635\u79f0\uff0c\u751a\u81f3\u6dfb\u52a0\u4e2a\u4eba\u7b80\u4ecb\u3002\u8fd9\u79cd\u4e2a\u6027\u5316\u5728\u56e2\u961f\u6a21\u5f0f\u4e0b\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5feb\u901f\u8bc6\u522b\u81f3\u5173\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u4e00\u4e2a\u72ec\u7279\u7684\u5934\u50cf\u53ef\u4ee5\u5e2e\u52a9\u961f\u53cb\u66f4\u5feb\u5730\u8bc6\u522b\u4f60\u7684\u7ed8\u5236\u5185\u5bb9\uff0c\u4ece\u800c\u63d0\u5347\u534f\u8c03\u6027\u548c\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u5728\u73a9\u8d85\u8fc7 100 \u5c0f\u65f6\u540e\uff0c\u5982\u4f55\u5728 Gartic.io \u4e2d\u63d0\u9ad8\u6211\u7684\u731c\u6d4b\u6280\u5de7\uff1f", "answer": "\u63d0\u9ad8 Gartic.io \u4e2d\u7684\u731c\u6d4b\u6280\u5de7\u9700\u8981\u6a21\u5f0f\u8bc6\u522b\u548c\u5feb\u901f\u601d\u8003\u3002\u6b65\u9aa4\u4e00\uff1a\u89c2\u5bdf\u521d\u59cb\u7b14\u89e6\uff1b\u5b83\u4eec\u901a\u5e38\u6697\u793a\u4e86\u7c7b\u522b\uff08\u4f8b\u5982\uff0c\u6ce2\u6d6a\u7ebf\u6697\u793a\u52a8\u7269\uff09\u3002\u6b65\u9aa4\u4e8c\uff1a\u5173\u6ce8\u5173\u952e\u7279\u5f81\uff0c\u5982\u5f62\u72b6\u548c\u989c\u8272\u3002\u4f8b\u5982\uff0c\u4e00\u4e2a\u7ea2\u8272\u7684\u5706\u5708\u9876\u90e8\u662f\u7eff\u8272\u7684\uff0c\u5f88\u53ef\u80fd\u4ee3\u8868\u4e00\u4e2a\u82f9\u679c\u3002\u6b65\u9aa4\u4e09\uff1a\u4f7f\u7528\u804a\u5929\u529f\u80fd\u8bf7\u6c42\u63d0\u793a\u6216\u786e\u8ba4\u731c\u6d4b\u3002\u7ecf\u5e38\u7ec3\u4e60\u5e76\u4e0e\u4e0d\u540c\u7fa4\u4f53\u4e00\u8d77\u73a9\u6e38\u620f\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u731c\u6d4b\u51c6\u786e\u7387\u3002"}, {"question": "\u5728 Gartic.io \u7684\u56e2\u961f\u6a21\u5f0f\u4e2d\uff0c\u6211\u53ef\u4ee5\u4f7f\u7528\u54ea\u4e9b\u9ad8\u7ea7\u7b56\u7565\u6765\u83b7\u80dc\uff1f", "answer": "\u5728 Gartic.io \u7684\u56e2\u961f\u6a21\u5f0f\u4e2d\u83b7\u80dc\uff0c\u9700\u8981\u7b56\u7565\u548c\u56e2\u961f\u5408\u4f5c\u3002\u6b65\u9aa4\u4e00\uff1a\u5206\u914d\u89d2\u8272\uff1b\u8ba9\u4e00\u4e9b\u73a9\u5bb6\u4e13\u6ce8\u4e8e\u7ed8\u753b\uff0c\u800c\u53e6\u4e00\u4e9b\u73a9\u5bb6\u5219\u4e13\u6ce8\u4e8e\u731c\u6d4b\u3002\u6b65\u9aa4\u4e8c\uff1a\u5728\u804a\u5929\u4e2d\u5f00\u53d1\u4e00\u79cd\u901f\u8bb0\u6216\u4ee3\u7801\uff0c\u4ee5\u8fdb\u884c\u5feb\u901f\u6c9f\u901a\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u201cC\u201d\u8868\u793a\u989c\u8272\uff0c\u6216\u201cS\u201d\u8868\u793a\u5f62\u72b6\u3002\u6b65\u9aa4\u4e09\uff1a\u7ec3\u4e60\u5e38\u89c1\u7684\u5355\u8bcd\u548c\u7b26\u53f7\uff0c\u4ee5\u52a0\u5feb\u8bc6\u522b\u548c\u7ed8\u5236\u901f\u5ea6\u3002\u6301\u7eed\u7ec3\u4e60\u548c\u6e05\u6670\u7684\u6c9f\u901a\u662f\u638c\u63a7\u56e2\u961f\u6a21\u5f0f\u7684\u5173\u952e\u3002"}, {"question": "\u4e3a\u4e86\u5728 Gartic.io \u4e2d\u83b7\u5f97\u4f18\u52bf\uff0c\u6211\u8be5\u5982\u4f55\u5feb\u901f\u638c\u63e1\u7ed8\u753b\u6280\u5de7\uff1f", "answer": "\u5feb\u901f\u638c\u63e1 Gartic.io \u4e2d\u7684\u7ed8\u753b\u6280\u5de7\uff0c\u5305\u62ec\u5c06\u590d\u6742\u7684\u60f3\u6cd5\u7b80\u5316\u4e3a\u57fa\u672c\u5f62\u72b6\u3002\u6b65\u9aa4\u4e00\uff1a\u5c06\u5bf9\u8c61\u5206\u89e3\u6210\u7b80\u5355\u7684\u51e0\u4f55\u5f62\u72b6\uff08\u4f8b\u5982\uff0c\u5c06\u623f\u5b50\u770b\u4f5c\u4e00\u4e2a\u5e26\u6709\u4e09\u89d2\u5f62\u5c4b\u9876\u7684\u6b63\u65b9\u5f62\uff09\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u6709\u9650\u7684\u8c03\u8272\u677f\u6765\u8282\u7701\u65f6\u95f4\u3002\u6b65\u9aa4\u4e09\uff1a\u5728\u65f6\u95f4\u9650\u5236\u4e0b\u7ec3\u4e60\u7ed8\u5236\u5e38\u89c1\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u4e09\u7b14\u753b\u4e00\u53ea\u732b\uff1a\u4e24\u53ea\u8033\u6735\u548c\u4e00\u5f20\u8138\u3002\u901f\u5ea6\u548c\u7b80\u5355\u6027\u5c06\u7ed9\u4f60\u5e26\u6765\u7ade\u4e89\u4f18\u52bf\u3002"}, {"question": "Gartic.io \u4e2d\u7684\u5206\u6570\u673a\u5236\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5b83\u4eec\u5982\u4f55\u5f71\u54cd\u6e38\u620f\uff1f", "answer": "Gartic.io \u7684\u8bc4\u5206\u673a\u5236\u5956\u52b1\u7ed8\u753b\u548c\u731c\u6d4b\u3002\u6b63\u786e\u7684\u731c\u6d4b\u4f1a\u6839\u636e\u901f\u5ea6\u548c\u51c6\u786e\u6027\u83b7\u5f97\u5206\u6570\u3002\u5f53\u7ed8\u753b\u88ab\u6b63\u786e\u731c\u51fa\u65f6\uff0c\u7ed8\u56fe\u8005\u4f1a\u83b7\u5f97\u5206\u6570\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u753b\u4e86\u4e00\u6761\u201c\u72d7\u201d\u5e76\u4e14\u5b83\u88ab\u5feb\u901f\u731c\u51fa\uff0c\u4f60\u4eec\u90fd\u80fd\u591f\u83b7\u5f97\u9ad8\u5206\u3002\u8fd9\u79cd\u53cc\u91cd\u7cfb\u7edf\u9f13\u52b1\u6e05\u6670\u7684\u7ed8\u753b\u548c\u654f\u9510\u7684\u731c\u6d4b\u80fd\u529b\uff0c\u4f7f\u6e38\u620f\u5145\u6ee1\u6d3b\u529b\u548c\u5438\u5f15\u529b\u3002"}, {"question": "Gartic.io \u7684\u7b97\u6cd5\u662f\u5982\u4f55\u4e3a\u73a9\u5bb6\u5206\u914d\u5355\u8bcd\u7684\uff0c\u5e76\u4e14\u53ef\u4ee5\u5f71\u54cd\u5b83\u5417\uff1f", "answer": "Gartic.io \u7684\u7b97\u6cd5\u4ece\u9884\u5b9a\u4e49\u5217\u8868\u4e2d\u968f\u673a\u5206\u914d\u5355\u8bcd\uff0c\u4ee5\u786e\u4fdd\u516c\u5e73\u6027\u548c\u591a\u6837\u6027\u3002\u5355\u8bcd\u7684\u9009\u62e9\u53d7\u6e38\u620f\u6a21\u5f0f\u548c\u4e3b\u6301\u4eba\u8bbe\u5b9a\u7684\u96be\u5ea6\u7b49\u7ea7\u7684\u5f71\u54cd\u3002\u4f8b\u5982\uff0c\u5728\u201c\u7ecf\u5178\u6a21\u5f0f\u201d\u4e2d\uff0c\u5355\u8bcd\u7684\u8303\u56f4\u4ece\u7b80\u5355\u7684\u7269\u4f53\u5230\u590d\u6742\u7684\u6982\u5ff5\u3002\u867d\u7136\u73a9\u5bb6\u65e0\u6cd5\u76f4\u63a5\u5f71\u54cd\u5355\u8bcd\u5206\u914d\uff0c\u4f46\u9009\u62e9\u4e0d\u540c\u7684\u6e38\u620f\u6a21\u5f0f\u53ef\u4ee5\u6539\u53d8\u5355\u8bcd\u6c60\u548c\u6311\u6218\u7ea7\u522b\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e0a\u8f6c\u79fb\u6211\u7684 Gartic.io \u8fdb\u5ea6\u548c\u6210\u5c31\u5417\uff1f", "answer": "\u662f\u7684\uff0cGartic.io \u5141\u8bb8\u4f60\u901a\u8fc7\u767b\u5f55\u540c\u4e00\u4e2a\u5e10\u6237\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u8f6c\u79fb\u8fdb\u5ea6\u548c\u6210\u5c31\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u6d4f\u89c8\u5668\u4e0a\u5f00\u59cb\u6e38\u620f\u5e76\u5207\u6362\u5230\u79fb\u52a8\u5e94\u7528\u7a0b\u5e8f\uff0c\u4f60\u7684\u4e2a\u4eba\u8d44\u6599\u3001\u6210\u5c31\u548c\u6e38\u620f\u5386\u53f2\u8bb0\u5f55\u5c06\u81ea\u52a8\u540c\u6b65\u3002\u786e\u4fdd\u4f60\u5728\u6240\u6709\u8bbe\u5907\u4e0a\u4f7f\u7528\u76f8\u540c\u7684\u767b\u5f55\u51ed\u636e\uff0c\u4ee5\u4fdd\u6301\u65e0\u7f1d\u7684\u8fdb\u5ea6\u8ddf\u8e2a\u3002"}, {"question": "Gartic.io \u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u7684\u529f\u80fd\u6216\u5f69\u86cb\uff0c\u5927\u591a\u6570\u73a9\u5bb6\u9519\u8fc7\u4e86\uff1f", "answer": "Gartic.io \u4e2d\u6709\u51e0\u4e2a\u9690\u85cf\u7684\u529f\u80fd\u548c\u5f69\u86cb\u3002\u4e00\u4e2a\u663e\u8457\u7684\u529f\u80fd\u662f\u201c\u79d8\u5bc6\u6a21\u5f0f\u201d\uff0c\u73a9\u5bb6\u53ef\u4ee5\u5728\u5176\u4e2d\u521b\u5efa\u5177\u6709\u81ea\u5b9a\u4e49\u5355\u8bcd\u5217\u8868\u7684\u79c1\u4eba\u623f\u95f4\u3002\u6b64\u5916\uff0c\u5728\u8282\u5047\u65e5\uff0c\u6e38\u620f\u901a\u5e38\u4f1a\u5305\u542b\u4e3b\u9898\u76f8\u5173\u7684\u8bcd\u6c47\u548c\u88c5\u9970\u3002\u4f8b\u5982\uff0c\u5728\u4e07\u5723\u8282\u671f\u95f4\uff0c\u4f60\u53ef\u80fd\u4f1a\u66f4\u9891\u7e41\u5730\u770b\u5230\u8bf8\u5982\u201c\u5357\u74dc\u201d\u6216\u201c\u5e7d\u7075\u201d\u4e4b\u7c7b\u7684\u6050\u6016\u8bcd\u6c47\u3002\u63a2\u7d22\u8fd9\u4e9b\u9690\u85cf\u7684\u60ca\u559c\u53ef\u4ee5\u4e3a\u4f60\u7684\u6e38\u620f\u4f53\u9a8c\u589e\u6dfb\u66f4\u591a\u4e50\u8da3\u3002"}]
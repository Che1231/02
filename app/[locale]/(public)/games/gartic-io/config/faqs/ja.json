[{"question": "\u521d\u3081\u3066\u306e\u65b9\u3067Gartic.io\u3092\u59cb\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Gartic.io\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u307e\u305a\u516c\u5f0f\u30b5\u30a4\u30c8\u306b\u30a2\u30af\u30bb\u30b9\u3059\u308b\u304b\u3001\u30a2\u30d7\u30ea\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u4f5c\u6210\u3059\u308b\u304b\u3001\u30b2\u30b9\u30c8\u3068\u3057\u3066\u53c2\u52a0\u3057\u307e\u3059\u3002\u300e\u30af\u30e9\u30b7\u30c3\u30af\u300f\u30e2\u30fc\u30c9\u3084\u300e\u30c1\u30fc\u30e0\u30e2\u30fc\u30c9\u300f\u306a\u3069\u306e\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u3092\u9078\u3073\u307e\u3059\u3002\u5358\u8a9e\u3092\u63cf\u3044\u305f\u308a\u3001\u4ed6\u306e\u4eba\u306e\u63cf\u3044\u305f\u3082\u306e\u3092\u5f53\u3066\u305f\u308a\u3059\u308b\u3088\u3046\u6c42\u3081\u3089\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u308a\u3093\u3054\u300f\u3068\u3044\u3046\u5358\u8a9e\u304c\u51fa\u305f\u5834\u5408\u306f\u3001\u307e\u305a\u7c21\u5358\u306a\u308a\u3093\u3054\u306e\u5f62\u3092\u30b9\u30b1\u30c3\u30c1\u3057\u307e\u3059\u3002\u8272\u30d1\u30ec\u30c3\u30c8\u3068\u7b46\u306e\u30b5\u30a4\u30ba\u3092\u4f7f\u3063\u3066\u3001\u7d75\u3092\u63cf\u304d\u307e\u3059\u3002\u5b8c\u74a7\u3067\u306a\u304f\u3066\u3082\u3001\u660e\u77ad\u3055\u306f\u5927\u5207\u3067\u3059\u3002"}, {"question": "Gartic.io\u306e\u57fa\u672c\u7684\u306a\u63cf\u753b\u30c4\u30fc\u30eb\u3068\u305d\u306e\u52b9\u679c\u7684\u306a\u4f7f\u3044\u65b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Gartic.io\u306b\u306f\u3001\u7b46\u3001\u6d88\u3057\u30b4\u30e0\u3001\u8272\u30d1\u30ec\u30c3\u30c8\u3001\u7b46\u306e\u30b5\u30a4\u30ba\u9078\u629e\u30c4\u30fc\u30eb\u306a\u3069\u306e\u63cf\u753b\u30c4\u30fc\u30eb\u304c\u3042\u308a\u307e\u3059\u3002\u52b9\u679c\u7684\u306b\u4f7f\u3046\u306b\u306f\u3001\u307e\u305a\u7b46\u30c4\u30fc\u30eb\u3092\u9078\u629e\u3057\u307e\
[{"question": "\u8679\u306e\u8ff7\u8def\uff08Rainbow Obby\uff09\u3067\u521d\u5fc3\u8005\u3068\u3057\u3066\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u8679\u306e\u8ff7\u8def\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u307e\u305a\u79fb\u52d5\u30ad\u30fc\u306b\u6163\u308c\u308b\u3053\u3068\u304b\u3089\u59cb\u3081\u307e\u3057\u3087\u3046\u3002\u524d\u9032\u306f'W'\u3001\u5de6\u79fb\u52d5\u306f'A'\u3001\u53f3\u79fb\u52d5\u306f'D'\u3001\u5f8c\u9000\u306f'S'\u3067\u3059\u3002\u30b8\u30e3\u30f3\u30d7\u306b\u306f\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30ec\u30d9\u30eb1\u306a\u3069\u306e\u7c21\u5358\u306a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u79fb\u52d5\u3059\u308b\u3060\u3051\u3067\u3088\u3044\u521d\u671f\u306e\u30ec\u30d9\u30eb\u3067\u3001\u3053\u308c\u3089\u306e\u64cd\u4f5c\u3092\u7df4\u7fd2\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb1\u3067\u306f\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u3092\u4f7f\u3063\u3066\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u304b\u3089\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3078\u30b8\u30e3\u30f3\u30d7\u306e\u7df4\u7fd2\u304c\u3067\u304d\u307e\u3059\u3002\u843d\u4e0b\u3057\u306a\u3044\u3088\u3046\u306b\u3001\u30b8\u30e3\u30f3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u3057\u3063\u304b\u308a\u5408\u308f\u305b\u307e\u3057\u3087\u3046\u3002\u307e\u305f\u3001\u30de\u30a6\u30b9\u3092\u4f7f\u3063\u3066\u5468\u56f2\u3092\u898b\u56de\u3057\u3001\u30ab\u30e1\u30e9\u306e\u89d2\u5ea6\u3092\u8abf\u6574\u3057\u3066\u3001\u3088\u308a\u826f\u3044\u8996\u754c\u3092\u5f97\u308b\u3053\u3068\u3082\u91cd\u8981\u3067\u3059\u3002[\u4f8b\u3048\uff1a\u64cd\u4f5c\u3092\u8eca\u904b\u8ee2\u306b\u4f8b\u3048\u308b\u3068\u3001\u30b9\u30d4\u30fc\u30c9\u3092\u51fa\u3059\u524d\u306b\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u306b\u6163\u308c\u3066\u304a\u304f\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002]"}, {"question": "\u8679\u306e\u8ff7\u8def\u306e\u9ad8\u5ea6\u306a\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u305f\u3081\u306e\u91cd\u8981\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u8679\u306e\u8ff7\u8def\u306e\u9ad8\u96e3\u6613\u5ea6\u306a\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u306b\u306f\u3001\u6b63\u78ba\u3055\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3001\u6226\u7565\u7684\u306a\u8a08\u753b\u306e\u7d44\u307f\u5408\u308f\u305b\u304c\u5fc5\u8981\u3067\u3059\u3002\u6bb5\u968e\u7684\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u3092\u4ee5\u4e0b\u306b\u793a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71: \u79fb\u52d5\u3059\u308b\u524d\u306b\u30ec\u30d9\u30eb\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u5206\u6790\u3057\u307e\u3059\u3002\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u914d\u7f6e\u306e\u30d1\u30bf\u30fc\u30f3\u3084\u9806\u5e8f\u3092\u63a2\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72: \u7cbe\u5ea6\u306e\u3042\u308b\u30b8\u30e3\u30f3\u30d7\u3092\u7df4\u7fd2\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb15\u3067\u306f\u3001\u72ed\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u9593\u3092\u79fb\u52d5\u3059\u308b\u305f\u3081\u306b\u3001\u4e00\u9023\u306e\u5c0f\u3055\u306a\u6b63\u78ba\u306a\u30b8\u30e3\u30f3\u30d7\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d73: \u74b0\u5883\u3092\u3042\u306a\u305f\u306e\u5229\u70b9\u3068\u3057\u3066\u6d3b\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3044\u304f\u3064\u304b\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3084\u969c\u5bb3\u7269\u304c\u52d5\u3044\u3066\u304a\u308a\u3001\u30b8\u30e3\u30f3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5b8c\u74a7\u306b\u5408\u308f\u305b\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb20\u3067\u306f\u3001\u52d5\u304f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u4e0a\u306b\u30b8\u30e3\u30f3\u30d7\u3057\u3001\u305d\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u304c\u79fb\u52d5\u3059\u308b\u524d\u306b\u3059\u3050\u96a3\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u30b8\u30e3\u30f3\u30d7\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u5206\u6790\u3001\u7df4\u7fd2\u3001\u305d\u3057\u3066\u4e00\u9023\u306e\u52d5\u4f5c\u3092\u5b9f\u884c\u3059\u308b\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u60f3\u50cf\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u8679\u306e\u8ff7\u8def\u3067\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u306b\u3001\u3069\u306e\u30ad\u30fc\u30d0\u30a4\u30f3\u30c7\u30a3\u30f3\u30b0\u3092\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3059\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u30ad\u30fc\u30d0\u30a4\u30f3\u30c7\u30a3\u30f3\u30b0\u3092\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3059\u308b\u3053\u3068\u3067\u3001\u8679\u306e\u8ff7\u8def\u3067\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30c7\u30d5\u30a9\u30eb\u30c8\u306e\u8a2d\u5b9a\u3067\u30b8\u30e3\u30f3\u30d7\u30ad\u30fc\uff08\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\uff09\u304c\u4f7f\u3044\u306b\u304f\u3044\u5834\u5408\u306f\u3001\u3088\u308a\u30a2\u30af\u30bb\u30b9\u3057\u3084\u3059\u3044\u30ad\u30fc\uff08\u4f8b\u3048\u3070\u300cShift\u300d\u3084\u300cCtrl\u300d\uff09\u306b\u5909\u66f4\u3059\u308b\u3053\u3068\u3092\u691c\u8a0e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u79fb\u52d5\u30ad\u30fc\u3092\u77e2\u5370\u30ad\u30fc\u306b\u518d\u30d0\u30a4\u30f3\u30c9\u3057\u3066\u3001\u53f3\u624b\u3092\u79fb\u52d5\u64cd\u4f5c\u306b\u4f7f\u3048\u308b\u3088\u3046\u306b\u3059\u308b\u306e\u3082\u826f\u3044\u3067\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u4e00\u90e8\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30b8\u30e3\u30f3\u30d7\u306b\u300cE\u300d\u3001\u3057\u3083\u304c\u307f\u3053\u3080\u306b\u300cR\u300d\u3092\u4f7f\u3046\u3053\u3068\u3092\u597d\u3093\u3067\u3044\u307e\u3059\u3002\u30ad\u30fc\u30d0\u30a4\u30f3\u30c7\u30a3\u30f3\u30b0\u3092\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3059\u308b\u306b\u306f\u3001\u30b2\u30fc\u30e0\u8a2d\u5b9a\u306b\u79fb\u52d5\u3057\u3066[\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc]\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u3042\u306a\u305f\u306b\u6700\u9069\u306a\u8a2d\u5b9a\u3092\u898b\u3064\u3051\u308b\u305f\u3081\u306b\u3001\u3055\u307e\u3056\u307e\u306a\u69cb\u6210\u3092\u8a66\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u6bd4\u8f03\u8868\uff1a\u30c7\u30d5\u30a9\u30eb\u30c8\u3068\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3055\u308c\u305f\u30ad\u30fc\u30d0\u30a4\u30f3\u30c7\u30a3\u30f3\u30b0\u3092\u6bd4\u8f03\u3059\u308b\u8868\u3092\u4f5c\u6210\u3057\u3066\u3001\u3069\u3061\u3089\u306e\u8a2d\u5b9a\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u304c\u5411\u4e0a\u3059\u308b\u304b\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u8679\u306e\u8ff7\u8def\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u3069\u306e\u3088\u3046\u306b\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u8679\u306e\u8ff7\u8def\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6210\u529f\u3057\u305f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u5230\u9054\u6570\u3001\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u6642\u9593\u3001\u53ce\u96c6\u3057\u305f\u30b3\u30ec\u30af\u30bf\u30d6\u30eb\u306e\u6570\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u843d\u4e0b\u3059\u308b\u3053\u3068\u306a\u304f\u3059\u3079\u3066\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u7740\u5730\u3057\u3001\u3067\u304d\u308b\u3060\u3051\u65e9\u304f\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3057\u3001\u3059\u3079\u3066\u306e\u96a0\u3055\u308c\u305f\u661f\u3092\u96c6\u3081\u308b\u3053\u3068\u3092\u76ee\u6a19\u306b\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb10\u306b\u306f\u3001\u53ce\u96c6\u3059\u308b\u3068\u30b9\u30b3\u30a2\u3092\u5927\u5e45\u306b\u30a2\u30c3\u30d7\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u308b3\u3064\u306e\u96a0\u3055\u308c\u305f\u661f\u304c\u3042\u308a\u307e\u3059\u3002\u307e\u305f\u3001\u843d\u4e0b\u3059\u308b\u3053\u3068\u306a\u304f\u9023\u7d9a\u30b8\u30e3\u30f3\u30d7\u3092\u7d9a\u3051\u308b\u3053\u3068\u3067\u3001\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002[\u8907\u6570\u9078\u629e\u80a2\u6bd4\u8f03\uff1a\u30b9\u30d4\u30fc\u30c9\u30e9\u30f3\u30cb\u30f3\u30b0\u3068\u3059\u3079\u3066\u306e\u661f\u3092\u96c6\u3081\u308b\u3001\u3068\u3044\u3046\u3088\u3046\u306a\u7570\u306a\u308b\u6226\u7565\u3092\u6bd4\u8f03\u3057\u3066\u3001\u3069\u3061\u3089\u304c\u6700\u9ad8\u306e\u30b9\u30b3\u30a2\u306b\u3064\u306a\u304c\u308b\u306e\u304b\u3092\u78ba\u8a8d\u3057\u307e\u3057\u3087\u3046\u3002]"}, {"question": "\u8679\u306e\u8ff7\u8def\u3067\u4e00\u90e8\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u304c\u8272\u5206\u3051\u3055\u308c\u3066\u3044\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u8679\u306e\u8ff7\u8def\u3067\u8272\u5206\u3051\u3055\u308c\u305f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306f\u3001\u305d\u306e\u632f\u308b\u821e\u3044\u3084\u7279\u6027\u3092\u793a\u3059\u8996\u899a\u7684\u306a\u624b\u304c\u304b\u308a\u3068\u3057\u3066\u6a5f\u80fd\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u8d64\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306f\u3057\u3070\u3057\u3070\u4e0d\u5b89\u5b9a\u3067\u3001\u6570\u79d2\u5f8c\u306b\u5d29\u58ca\u3057\u307e\u3059\u3002\u9752\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306f\u901a\u5e38\u5b89\u5b9a\u3057\u3066\u304a\u308a\u3001\u5b89\u5168\u306b\u7740\u5730\u3067\u304d\u307e\u3059\u3002\u7dd1\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306f\u52d5\u304f\u3053\u3068\u304c\u3042\u308a\u3001\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u30b8\u30e3\u30f3\u30d7\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u8272\u30b3\u30fc\u30c9\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u79fb\u52d5\u6226\u7565\u3092\u7acb\u3066\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb12\u3067\u306f\u3001\u8d64\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u304c\u5d29\u58ca\u3059\u308b\u524d\u306b\u3001\u3059\u3050\u306b\u8d64\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u304b\u3089\u9752\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u30b8\u30e3\u30f3\u30d7\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u8272\u5206\u3051\u3055\u308c\u305f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u4fe1\u53f7\u6a5f\u306b\u4f8b\u3048\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u8d64\u306f\u5371\u967a\u3001\u7dd1\u306f\u901a\u884c\u53ef\u3001\u9752\u306f\u5b89\u5168\u306a\u5834\u6240\u3067\u3059\u3002]"}, {"question": "\u8679\u306e\u8ff7\u8def\u3067\u52d5\u304f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u4e57\u308a\u8d8a\u3048\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u30c6\u30af\u30cb\u30c3\u30af\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u8679\u306e\u8ff7\u8def\u3067\u52d5\u304f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u4e57\u308a\u8d8a\u3048\u308b\u306b\u306f\u3001\u614e\u91cd\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u4e88\u6e2c\u304c\u5fc5\u8981\u3067\u3059\u3002\u6bb5\u968e\u7684\u306a\u30ac\u30a4\u30c9\u3092\u4ee5\u4e0b\u306b\u793a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u79fb\u52d5\u30d1\u30bf\u30fc\u30f3\u3092\u89b3\u5bdf\u3057\u307e\u3059\u3002\u307b\u3068\u3093\u3069\u306e\u52d5\u304f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306f\u3001\u524d\u5f8c\u307e\u305f\u306f\u5186\u3092\u63cf\u304f\u3088\u3046\u306b\u4e88\u6e2c\u53ef\u80fd\u306a\u7d4c\u8def\u306b\u5f93\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u7d4c\u8def\u306e\u8fd1\u304f\u3001\u3057\u304b\u3057\u62bc\u3057\u51fa\u3055\u308c\u306a\u3044\u7a0b\u5ea6\u306e\u8ddd\u96e2\u306b\u81ea\u5206\u306e\u4f4d\u7f6e\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u304c\u3042\u306a\u305f\u306b\u6700\u3082\u8fd1\u3065\u304f\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u30b8\u30e3\u30f3\u30d7\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb18\u3067\u306f\u3001\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u5b89\u5168\u306b\u7740\u5730\u3059\u308b\u305f\u3081\u306b\u3001\u5186\u904b\u52d5\u3059\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u30b8\u30e3\u30f3\u30d7\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u89b3\u5bdf\u3001\u4f4d\u7f6e\u5408\u308f\u305b\u3001\u30b8\u30e3\u30f3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u3044\u3046\u30b9\u30c6\u30c3\u30d7\u3092\u307e\u3068\u3081\u305f\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u4f5c\u6210\u3057\u307e\u3057\u3087\u3046\u3002]"}, {"question": "\u8679\u306e\u8ff7\u8def\u3067\u3001\u8907\u6570\u306e\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u9032\u6357\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u8907\u6570\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u4f7f\u7528\u3057\u3066\u3044\u308b\u5834\u5408\u3001\u8679\u306e\u8ff7\u8def\u3067\u9032\u6357\u72b6\u6cc1\u3092\u5225\u306e\u30c7\u30d0\u30a4\u30b9\u306b\u8ee2\u9001\u3059\u308b\u306e\u306f\u7c21\u5358\u3067\u3059\u3002\u307e\u305a\u3001\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u8679\u306e\u8ff7\u8def\u306f\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u4f7f\u7528\u3057\u3066\u3001\u9032\u6357\u72b6\u6cc1\u3092\u540c\u671f\u3055\u305b\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001PC\u3067\u30ec\u30d9\u30eb10\u3092\u30af\u30ea\u30a2\u3057\u305f\u5834\u5408\u306f\u3001\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3053\u3068\u3067\u3001\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u3067\u3082\u30ec\u30d9\u30eb10\u304b\u3089\u518d\u958b\u3067\u304d\u307e\u3059\u3002\u554f\u984c\u304c\u767a\u751f\u3057\u305f\u5834\u5408\u3001\u30a4\u30f3\u30bf\u30fc\u30cd\u30c3\u30c8\u63a5\u7d9a\u3092\u78ba\u8a8d\u3057\u3001\u30b2\u30fc\u30e0\u8a2d\u5b9a\u3067\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u304c\u6709\u52b9\u306b\u306a\u3063\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u6bd4\u8f03\u8868\uff1a\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u3067\u306e\u9032\u6357\u72b6\u6cc1\u306e\u540c\u671f\u624b\u9806\u3092\u6bd4\u8f03\u3057\u3066\u3001\u30b9\u30e0\u30fc\u30ba\u306a\u8ee2\u9001\u3092\u78ba\u4fdd\u3057\u307e\u3057\u3087\u3046\u3002]"}, {"question": "\u8679\u306e\u8ff7\u8def\u306b\u306f\u3069\u3093\u306a\u96a0\u308c\u305f\u30b3\u30ec\u30af\u30bf\u30d6\u30eb\u304c\u3042\u308a\u3001\u3069\u3053\u3067\u5165\u624b\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u8679\u306e\u8ff7\u8def\u306b\u306f\u3001\u69d8\u3005\u306a\u30ec\u30d9\u30eb\u306b\u6563\u3089\u3070\u3063\u3066\u3044\u308b\u661f\u3084\u30b3\u30a4\u30f3\u306a\u3069\u306e\u96a0\u308c\u305f\u30b3\u30ec\u30af\u30bf\u30d6\u30eb\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30b3\u30ec\u30af\u30bf\u30d6\u30eb\u306f\u3001\u624b\u306e\u5c4a\u304b\u306a\u3044\u5834\u6240\u306b\u3042\u308b\u304b\u3001\u5c0f\u3055\u306a\u30d1\u30ba\u30eb\u3092\u89e3\u3044\u3066\u30a2\u30af\u30bb\u30b9\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb7\u306b\u306f\u3001\u4e00\u9023\u306e\u52d5\u304f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u5f8c\u308d\u306b\u96a0\u308c\u305f\u661f\u304c\u3042\u308a\u307e\u3059\u3002\u305d\u308c\u3092\u63a2\u3059\u306b\u306f\u3001\u30b8\u30e3\u30f3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5b8c\u74a7\u306b\u5408\u308f\u305b\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u79fb\u52d5\u3057\u3066\u661f\u306b\u5230\u9054\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u96a0\u308c\u305f\u30a2\u30a4\u30c6\u30e0\u3092\u96c6\u3081\u308b\u3053\u3068\u3067\u3001\u30b9\u30b3\u30a2\u3060\u3051\u3067\u306a\u304f\u3001\u7279\u5225\u306a\u5831\u916c\u3084\u5b9f\u7e3e\u3082\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u3002[\u8907\u6570\u9078\u629e\u80a2\u6bd4\u8f03\uff1a\u5404\u30b3\u30fc\u30ca\u30fc\u3092\u63a2\u691c\u3059\u308b\u3053\u3068\u3068\u3001\u7279\u5b9a\u306e\u30d1\u30b9\u306b\u5f93\u3046\u3053\u3068\u306a\u3069\u3067\u3001\u96a0\u3055\u308c\u305f\u30b3\u30ec\u30af\u30bf\u30d6\u30eb\u3092\u898b\u3064\u3051\u308b\u305f\u3081\u306e\u7570\u306a\u308b\u65b9\u6cd5\u3092\u6bd4\u8f03\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002]"}, {"question": "\u8679\u306e\u8ff7\u8def\u306e\u96e3\u6613\u5ea6\u66f2\u7dda\u306f\u3069\u306e\u3088\u3046\u306b\u9032\u5316\u3057\u3001\u5f8c\u65b9\u306e\u30ec\u30d9\u30eb\u3067\u306f\u4f55\u3092\u671f\u5f85\u3059\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u8679\u306e\u8ff7\u8def\u306e\u96e3\u6613\u5ea6\u66f2\u7dda\u306f\u3001\u30ec\u30d9\u30eb\u3092\u9032\u3081\u308b\u306b\u3064\u308c\u3066\u5f90\u3005\u306b\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002\u521d\u671f\u306e\u30ec\u30d9\u30eb\u306f\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3068\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u6163\u308c\u308b\u306e\u3092\u52a9\u3051\u308b\u305f\u3081\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u9032\u3080\u306b\u3064\u308c\u3066\u3001\u30ec\u30d9\u30eb\u306f\u52d5\u304f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3001\u5d29\u58ca\u3059\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3001\u72ed\u3044\u901a\u8def\u3068\u3044\u3063\u305f\u3088\u308a\u8907\u96d1\u306a\u8981\u7d20\u3092\u542b\u3081\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb25\u306b\u306f\u3001\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u7d20\u65e9\u3044\u53cd\u5fdc\u3092\u5fc5\u8981\u3068\u3059\u308b\u3001\u52d5\u304f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3068\u5d29\u58ca\u3059\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u7d44\u307f\u5408\u308f\u305b\u304c\u3042\u308a\u307e\u3059\u3002\u5f8c\u65b9\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30b9\u30d1\u30a4\u30af\u3084\u6eb6\u5ca9\u306e\u3088\u3046\u306a\u74b0\u5883\u7684\u30cf\u30b6\u30fc\u30c9\u3082\u767b\u5834\u3057\u3001\u3055\u3089\u306b\u6311\u6226\u3092\u9ad8\u3081\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u96e3\u6613\u5ea6\u66f2\u7dda\u3092\u5c71\u767b\u308a\u306b\u4f8b\u3048\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u9ad8\u5ea6\u304c\u4e0a\u304c\u3063\u3066\u3044\u304f\u306b\u3064\u308c\u3066\u3001\u767b\u5c71\u306f\u3088\u308a\u6025\u3067\u56f0\u96e3\u306b\u306a\u308a\u307e\u3059\u3002]"}, {"question": "\u8679\u306e\u8ff7\u8def\u3067\u3001\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u3088\u304f\u72af\u3059\u4e00\u822c\u7684\u306a\u30df\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u3092\u3069\u306e\u3088\u3046\u306b\u907f\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u8679\u306e\u8ff7\u8def\u3067\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u3088\u304f\u72af\u3059\u30df\u30b9\u306b\u306f\u3001\u8a08\u753b\u306a\u3057\u306b\u30ec\u30d9\u30eb\u3092\u9032\u307f\u3059\u304e\u3001\u30b8\u30e3\u30f3\u30d7\u8ddd\u96e2\u3092\u8aa4\u3063\u3066\u5224\u65ad\u3057\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u8272\u306b\u6ce8\u610f\u3092\u6255\u308f\u306a\u3044\u3053\u3068\u306a\u3069\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30df\u30b9\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u306f\u3001\u79fb\u52d5\u3059\u308b\u524d\u306b\u30ec\u30d9\u30eb\u306e\u914d\u7f6e\u3092\u5206\u6790\u3059\u308b\u6642\u9593\u3092\u8cbb\u3084\u3057\u307e\u3057\u3087\u3046\u3002\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u6b63\u78ba\u306b\u7740\u5730\u3059\u308b\u3088\u3046\u306b\u3001\u7cbe\u5bc6\u306a\u30b8\u30e3\u30f3\u30d7\u3092\u7df4\u7fd2\u3057\u307e\u3057\u3087\u3046\u3002\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u8272\u306b\u6ce8\u610f\u3057\u3066\u3001\u305d\u306e\u632f\u308b\u821e\u3044\u3092\u7406\u89e3\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb5\u3067\u306f\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u8272\u306b\u6ce8\u610f\u305b\u305a\u306b\u6025\u3044\u3067\u9032\u3080\u3068\u3001\u4e0d\u5b89\u5b9a\u306a\u8d64\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u304b\u3089\u843d\u3061\u3066\u3057\u307e\u3046\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30df\u30b9\u3092\u907f\u3051\u308b\u305f\u3081\u306e\u5206\u6790\u3001\u7df4\u7fd2\u3001\u52d5\u4f5c\u5b9f\u884c\u306e\u30b9\u30c6\u30c3\u30d7\u3092\u307e\u3068\u3081\u305f\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u4f5c\u6210\u3057\u307e\u3057\u3087\u3046\u3002]"}]
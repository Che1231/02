[{"question": "\ucd08\ubcf4\uc790\ub85c\uc11c \ub79c\ub364 \uc635\ube44\uc5d0\uc11c \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc5b4\ub5bb\uac8c \ub9c8\uc2a4\ud130\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub79c\ub364 \uc635\ube44\uc5d0\uc11c \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ub9c8\uc2a4\ud130\ud558\ub824\uba74 \uc6b0\uc120 \uc774\ub3d9 \ud0a4\uc5d0 \uc775\uc219\ud574\uc9c0\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc55e\uc73c\ub85c \uc774\ub3d9\ud558\ub824\uba74 'W', \uc67c\ucabd\uc73c\ub85c \uc774\ub3d9\ud558\ub824\uba74 'A', \uc624\ub978\ucabd\uc73c\ub85c \uc774\ub3d9\ud558\ub824\uba74 'D', \ub4a4\ub85c \uc774\ub3d9\ud558\ub824\uba74 'S' \ud0a4\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc810\ud504\ud558\ub824\uba74 \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ub808\ubca8 1\uacfc \uac19\uc740 \ucd08\uae30 \ub2e8\uacc4\uc5d0\uc11c \uc774\ub7ec\ud55c \ucee8\ud2b8\ub864\uc744 \uc5f0\uc2b5\ud558\uc138\uc694. \ub808\ubca8 1\uc5d0\uc11c\ub294 \ub2e8\uc21c\ud55c \ud50c\ub7ab\ud3fc\uc744 \uc6c0\uc9c1\uc774\ub294 \uc5f0\uc2b5\uc744 \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 1\uc5d0\uc11c \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uc810\ud504\ud558\ub294 \uc5f0\uc2b5\uc744 \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub099\ud558\uc9c0 \uc54a\ub3c4\ub85d \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uc2e0\uc911\ud558\uac8c \uc870\uc808\ud574\uc57c \ud569\ub2c8\ub2e4. \ub610\ud55c \ub9c8\uc6b0\uc2a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc8fc\ubcc0\uc744 \uc0b4\ud3b4\ubcf4\uace0 \uce74\uba54\ub77c \uac01\ub3c4\ub97c \uc870\uc808\ud558\uc5ec \uc2dc\uc57c\ub97c \ud655\ubcf4\ud558\uc138\uc694. [\ube44\uc720 \uc124\uba85: \ucee8\ud2b8\ub864\uc744 \uc790\ub3d9\ucc28 \uc6b4\uc804\uacfc \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uc138\uc694. \uc18d\ub3c4\ub97c \ub192\uc774\uae30 \uc804\uc5d0 \uae30\ubcf8\uc5d0 \uc775\uc219\ud574\uc838\uc57c \ud569\ub2c8\ub2e4.]"}, {"question": "\ub79c\ub364 \uc635\ube44\uc758 \uace0\uae09 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uae30 \uc704\ud55c \ud544\uc218 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub79c\ub364 \uc635\ube44\uc758 \uace0\uae09 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\ub824\uba74 \uc815\ud655\uc131, \ud0c0\uc774\ubc0d, \uc804\ub7b5\uc801 \uacc4\ud68d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4\ubcc4 \uc811\uadfc \ubc29\uc2dd\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. STEP1: \uc774\ub3d9\ud558\uae30 \uc804\uc5d0 \ub808\ubca8 \ub808\uc774\uc544\uc6c3\uc744 \ubd84\uc11d\ud569\ub2c8\ub2e4. \ud50c\ub7ab\ud3fc \ubc30\uce58 \ud328\ud134\uc774\ub098 \uc21c\uc11c\ub97c \ucc3e\uc2b5\ub2c8\ub2e4. STEP2: \uc815\ud655\ud55c \uc810\ud504 \uc5f0\uc2b5\uc744 \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 15\uc5d0\uc11c\ub294 \uc881\uc740 \ud50c\ub7ab\ud3fc\uc744 \ud1b5\uacfc\ud558\uae30 \uc704\ud574 \uc77c\ub828\uc758 \uc815\ubc00\ud55c \uc791\uc740 \uc810\ud504\ub97c \ud574\uc57c \ud569\ub2c8\ub2e4. STEP3: \ud658\uacbd\uc744 \ud65c\uc6a9\ud569\ub2c8\ub2e4. \uc77c\ubd80 \ub808\ubca8\uc5d0\ub294 \uc774\ub3d9\ud558\ub294 \ud50c\ub7ab\ud3fc\uc774\ub098 \uc7a5\uc560\ubb3c\uc774 \uc788\uc5b4 \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uc644\ubcbd\ud558\uac8c \ub9de\ucdb0\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 20\uc5d0\uc11c\ub294 \uc774\ub3d9\ud558\ub294 \ud50c\ub7ab\ud3fc \uc704\ub85c \uc810\ud504\ud55c \ud6c4 \uc6c0\uc9c1\uc784\uc774 \uba48\ucd94\uae30 \uc804\uc5d0 \ub2e4\uc74c \ud50c\ub7ab\ud3fc\uc73c\ub85c \ube60\ub974\uac8c \uc810\ud504\ud574\uc57c \ud569\ub2c8\ub2e4. [\ud750\ub984\ub3c4 \uc124\uba85: \ubd84\uc11d, \uc5f0\uc2b5, \uc2e4\ud589\uc744 \uc21c\ucc28\uc801\uc73c\ub85c \uc218\ud589\ud558\ub294 \ud750\ub984\ub3c4\ub97c \uc0c1\uc0c1\ud574 \ubcf4\uc138\uc694.]"}, {"question": "\ub79c\ub364 \uc635\ube44\uc758 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uac1c\uc120\ud558\uae30 \uc704\ud574 \uc5b4\ub5a4 \ud0a4 \ubc14\uc778\ub529\uc744 \uc0ac\uc6a9\uc790 \uc9c0\uc815\ud574\uc57c \ud558\ub098\uc694?", "answer": "\ud0a4 \ubc14\uc778\ub529\uc744 \uc0ac\uc6a9\uc790 \uc9c0\uc815\ud558\uba74 \ub79c\ub364 \uc635\ube44\uc758 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uae30\ubcf8 \uc124\uc815\uc778 \uc2a4\ud398\uc774\uc2a4\ubc14 \uc810\ud504 \ud0a4\ub97c 'Shift'\ub098 'Ctrl'\uacfc \uac19\uc740 \ub354 \uc27d\uac8c \uc811\uadfc\ud560 \uc218 \uc788\ub294 \ud0a4\ub85c \ubcc0\uacbd\ud558\ub294 \uac83\uc744 \uace0\ub824\ud574 \ubcf4\uc138\uc694. \ub9c8\uc6b0\uc2a4 \uc624\ub978\uc190\uc73c\ub85c \uc774\ub3d9\uc744 \uc704\ud574 \uc774\ub3d9 \ud0a4\ub97c \ud654\uc0b4\ud45c \ud0a4\ub85c \ubc14\uafc0 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\ub294 'E'\ub97c \uc810\ud504 \ud0a4\ub85c, 'R'\uc744 \uc6c5\ud06c\ub9ac\ub294 \ud0a4\ub85c \uc0ac\uc6a9\ud558\ub294 \uac83\uc744 \ub354 \ud3b8\ub9ac\ud558\uac8c \ub290\ub08d\ub2c8\ub2e4. \ud0a4 \ubc14\uc778\ub529\uc744 \uc0ac\uc6a9\uc790 \uc9c0\uc815\ud558\ub824\uba74 \uac8c\uc784 \uc124\uc815\uc5d0\uc11c '\ucee8\ud2b8\ub864'\uc744 \uc120\ud0dd\ud558\uc138\uc694. \uc790\uc2e0\uc5d0\uac8c \uac00\uc7a5 \uc801\ud569\ud55c \uad6c\uc131\uc744 \ucc3e\uc744 \ub54c\uae4c\uc9c0 \uc5ec\ub7ec \uac00\uc9c0 \uad6c\uc131\uc744 \uc2dc\ub3c4\ud574 \ubcf4\uc138\uc694. [\uc124\uc815 \ube44\uad50\ud45c: \uae30\ubcf8 \ud0a4 \ubc14\uc778\ub529\uacfc \uc0ac\uc6a9\uc790 \uc9c0\uc815 \ud0a4 \ubc14\uc778\ub529\uc744 \ube44\uad50\ud558\uc5ec \uc131\ub2a5\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \uc124\uc815\uc744 \ud655\uc778\ud558\uc138\uc694.]"}, {"question": "\ub79c\ub364 \uc635\ube44\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud558\ub098\uc694?", "answer": "\ub79c\ub364 \uc635\ube44\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5ec\ub7ec \uc694\uc18c\ub97c \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. \uc131\uacf5\uc801\uc73c\ub85c \ucc29\uc9c0\ud55c \ud50c\ub7ab\ud3fc \uc218, \ub808\ubca8 \uc644\ub8cc \uc2dc\uac04, \uc218\uc9d1\ud55c \uceec\ub809\uc158\uc758 \uac1c\uc218\uc785\ub2c8\ub2e4. \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud558\ub824\uba74 \ub099\ud558\uc9c0 \uc54a\uace0 \ubaa8\ub4e0 \ud50c\ub7ab\ud3fc\uc5d0 \ucc29\uc9c0\ud558\uace0, \uac00\ub2a5\ud55c \ud55c \ube60\ub974\uac8c \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uace0, \ubaa8\ub4e0 \uc228\uaca8\uc9c4 \ubcc4\uc744 \uc218\uc9d1\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 10\uc5d0\uc11c\ub294 \uc218\uc9d1\ud558\uba74 \uc810\uc218\ub97c \ud06c\uac8c \ub192\uc77c \uc218 \uc788\ub294 \uc138 \uac1c\uc758 \uc228\uaca8\uc9c4 \ubcc4\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \ub099\ud558\uc9c0 \uc54a\uace0 \uc5f0\uc18d \uc810\ud504\ub97c \uc720\uc9c0\ud558\uba74 \ubcf4\ub108\uc2a4 \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: \uc18d\ub3c4\uc804\uacfc \ubaa8\ub4e0 \ubcc4 \uc218\uc9d1\uacfc \uac19\uc740 \uc11c\ub85c \ub2e4\ub978 \uc804\ub7b5\uc744 \ube44\uad50\ud558\uc5ec \uc5b4\ub5a4 \uc804\ub7b5\uc774 \uac00\uc7a5 \ub192\uc740 \uc810\uc218\ub97c \uac00\uc838\uc624\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694.]"}, {"question": "\ub79c\ub364 \uc635\ube44\uc5d0\uc11c \uc77c\ubd80 \ud50c\ub7ab\ud3fc\uc774 \uc0c9\uc0c1\uc73c\ub85c \uad6c\ubd84\ub418\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "\ub79c\ub364 \uc635\ube44\uc758 \uc0c9\uc0c1\uc73c\ub85c \uad6c\ubd84\ub41c \ud50c\ub7ab\ud3fc\uc740 \uc2dc\uac01\uc801 \ub2e8\uc11c\ub85c\uc11c, \uadf8 \ud50c\ub7ab\ud3fc\uc758 \ub3d9\uc791\uc774\ub098 \uc131\uc9c8\uc744 \ub098\ud0c0\ub0c5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ube68\uac04\uc0c9 \ud50c\ub7ab\ud3fc\uc740 \uc885\uc885 \ubd88\uc548\uc815\ud558\uc5ec \uba87 \ucd08 \ud6c4\uc5d0 \ubb34\ub108\uc9c0\uace0, \ud30c\ub780\uc0c9 \ud50c\ub7ab\ud3fc\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \uc548\uc815\uc801\uc774\uace0 \ucc29\uc9c0\ud558\uae30\uc5d0 \uc548\uc804\ud569\ub2c8\ub2e4. \ub179\uc0c9 \ud50c\ub7ab\ud3fc\uc740 \uc774\ub3d9\ud560 \uc218\ub3c4 \uc788\uc73c\uba70, \uc704\uc5d0 \uc810\ud504\ud558\ub824\uba74 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc0c9\uc0c1 \ucf54\ub4dc\ub97c \uc774\ud574\ud558\uba74 \uc804\ub7b5\uc801\uc778 \uc6c0\uc9c1\uc784\uc744 \uc138\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 12\uc5d0\uc11c\ub294 \ube68\uac04\uc0c9 \ud50c\ub7ab\ud3fc\uc774 \ubb34\ub108\uc9c0\uae30 \uc804\uc5d0 \ube60\ub974\uac8c \ube68\uac04\uc0c9 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ud30c\ub780\uc0c9 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uc810\ud504\ud574\uc57c \ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc0c9\uc0c1\uc73c\ub85c \uad6c\ubd84\ub41c \ud50c\ub7ab\ud3fc\uc744 \uc2e0\ud638\ub4f1\uacfc \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uc138\uc694. \ube68\uac04\uc0c9\uc740 \uc704\ud5d8, \ub179\uc0c9\uc740 \uc9c4\ud589, \ud30c\ub780\uc0c9\uc740 \uc548\uc804 \uad6c\uc5ed\uc785\ub2c8\ub2e4.]"}, {"question": "\ub79c\ub364 \uc635\ube44\uc5d0\uc11c \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uc744 \ud1b5\uacfc\ud558\ub294 \ucd5c\uace0\uc758 \uae30\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub79c\ub364 \uc635\ube44\uc5d0\uc11c \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uc744 \ud1b5\uacfc\ud558\ub294 \uac83\uc740 \uc2e0\uc911\ud55c \ud0c0\uc774\ubc0d\uacfc \uc608\uce21\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4\ubcc4 \uc548\ub0b4\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. STEP1: \ud50c\ub7ab\ud3fc\uc758 \uc6c0\uc9c1\uc784 \ud328\ud134\uc744 \uad00\ucc30\ud569\ub2c8\ub2e4. \ub300\ubd80\ubd84\uc758 \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uc740 \uc654\ub2e4 \uac14\ub2e4 \ud558\uac70\ub098 \uc6d0\ud615\uc73c\ub85c \uc6c0\uc9c1\uc774\ub294 \uac83\uacfc \uac19\uc774 \uc608\uce21 \uac00\ub2a5\ud55c \uacbd\ub85c\ub97c \ub530\ub985\ub2c8\ub2e4. STEP2: \ub108\ubb34 \uac00\uae4c\uc774 \uac00\uc9c0 \uc54a\uace0 \ud50c\ub7ab\ud3fc\uc758 \uacbd\ub85c \uadfc\ucc98\uc5d0 \uc704\uce58\ud569\ub2c8\ub2e4. \ubc00\ub824\ub098\uc9c0 \uc54a\ub3c4\ub85d \ud558\uc138\uc694. STEP3: \ud50c\ub7ab\ud3fc\uc774 \uc790\uc2e0\uc5d0\uac8c \uac00\uc7a5 \uac00\uae4c\uc6b8 \ub54c \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \ub9de\ucda5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 18\uc5d0\uc11c\ub294 \uc6d0\ud615\uc73c\ub85c \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc \uc704\ub85c \uc810\ud504\ud574\uc57c \ud558\ubbc0\ub85c \uc548\uc804\ud558\uac8c \ucc29\uc9c0\ud558\uae30 \uc704\ud574 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. [\ud750\ub984\ub3c4 \uc124\uba85: \ud50c\ub7ab\ud3fc \uad00\ucc30, \uc704\uce58 \uc124\uc815, \uc810\ud504 \ud0c0\uc774\ubc0d \ub2e8\uacc4\ub97c \ub098\ud0c0\ub0b4\ub294 \ud750\ub984\ub3c4\ub97c \uc0dd\uc131\ud558\uc138\uc694.]"}, {"question": "\ud55c \uae30\uae30\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30\ub85c \ub79c\ub364 \uc635\ube44 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ubaa8\ub4e0 \uae30\uae30\uc5d0\uc11c \uac19\uc740 \uacc4\uc815\uc744 \uc0ac\uc6a9\ud55c\ub2e4\uba74 \ub79c\ub364 \uc635\ube44 \uc9c4\ud589 \uc0c1\ud669\uc744 \ud55c \uae30\uae30\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30\ub85c \uc804\uc1a1\ud558\ub294 \uac83\uc740 \uac04\ub2e8\ud569\ub2c8\ub2e4. \uba3c\uc800 \ub450 \uae30\uae30 \ubaa8\ub450 \uac19\uc740 \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \ub79c\ub364 \uc635\ube44\ub294 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ub808\ubca8 10\uc744 \uc644\ub8cc\ud588\ub2e4\uba74 \uac19\uc740 \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uc5ec \ubaa8\ubc14\uc77c \uae30\uae30\uc5d0\uc11c \ub808\ubca8 10\ubd80\ud130 \uacc4\uc18d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubb38\uc81c\uac00 \ubc1c\uc0dd\ud558\uba74 \uc778\ud130\ub137 \uc5f0\uacb0\uc744 \ud655\uc778\ud558\uace0 \uac8c\uc784 \uc124\uc815\uc5d0\uc11c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc774 \ud65c\uc131\ud654\ub418\uc5c8\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. [\uc124\uc815 \ube44\uad50\ud45c: \ub2e4\ub978 \uae30\uae30\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669 \ub3d9\uae30\ud654 \ub2e8\uacc4\ub97c \ube44\uad50\ud558\uc5ec \uc6d0\ud65c\ud55c \uc804\uc1a1\uc744 \ubcf4\uc7a5\ud558\uc138\uc694.]"}, {"question": "\ub79c\ub364 \uc635\ube44\uc5d0\uc11c \uc228\uaca8\uc9c4 \uceec\ub809\uc158\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub514\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\ub098\uc694?", "answer": "\ub79c\ub364 \uc635\ube44\uc5d0\ub294 \ub2e4\uc591\ud55c \ub808\ubca8\uc5d0 \ud769\uc5b4\uc838 \uc788\ub294 \ubcc4\uacfc \ub3d9\uc804\uacfc \uac19\uc740 \uc228\uaca8\uc9c4 \uceec\ub809\uc158\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uceec\ub809\uc158\uc740 \ub3c4\ub2ec\ud558\uae30 \uc5b4\ub824\uc6b4 \uc601\uc5ed\uc5d0 \uc790\uc8fc \uc704\uce58\ud558\uac70\ub098, \uc791\uc740 \ud37c\uc990\uc744 \ud480\uc5b4\uc57c \uc811\uadfc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 7\uc5d0\ub294 \uc774\ub3d9\ud558\ub294 \ud50c\ub7ab\ud3fc \uc2dc\ub9ac\uc988 \ub4a4\uc5d0 \uc788\ub294 \uc228\uaca8\uc9c4 \ubcc4\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \ubcc4\uc744 \ucc3e\uc73c\ub824\uba74 \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uc644\ubcbd\ud558\uac8c \ub9de\ucdb0 \ud50c\ub7ab\ud3fc\uc744 \ud1b5\uacfc\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uc544\uc774\ud15c\uc744 \uc218\uc9d1\ud558\uba74 \uc810\uc218\uac00 \uc0c1\uc2b9\ud560 \ubfd0\ub9cc \uc544\ub2c8\ub77c \ud2b9\ubcc4\ud55c \ubcf4\uc0c1\uacfc \uc131\ucde8\ub3c4\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: \ubaa8\ub4e0 \uad6c\uc11d\uc744 \ud0d0\ud5d8\ud558\ub294 \uac83\uacfc \ud2b9\uc815 \uacbd\ub85c\ub97c \ub530\ub974\ub294 \uac83\uacfc \uac19\uc740 \uc228\uaca8\uc9c4 \uceec\ub809\uc158\uc744 \ucc3e\ub294 \ub2e4\ub978 \ubc29\ubc95\uc744 \ube44\uad50\ud558\uc138\uc694.]"}, {"question": "\ub79c\ub364 \uc635\ube44\uc758 \ub09c\uc774\ub3c4 \uace1\uc120\uc740 \uc5b4\ub5bb\uac8c \uc9c4\ud654\ud558\uba70, \ud6c4\ubc18 \ub808\ubca8\uc5d0\uc11c\ub294 \ubb34\uc5c7\uc744 \uae30\ub300\ud574\uc57c \ud558\ub098\uc694?", "answer": "\ub79c\ub364 \uc635\ube44\uc758 \ub09c\uc774\ub3c4 \uace1\uc120\uc740 \ub808\ubca8\uc744 \uc9c4\ud589\ud568\uc5d0 \ub530\ub77c \uc810\ucc28 \uc99d\uac00\ud569\ub2c8\ub2e4. \ucd08\uae30 \ub808\ubca8\uc740 \uae30\ubcf8 \ucee8\ud2b8\ub864\uacfc \uba54\ucee4\ub2c8\uc998\uc5d0 \uc775\uc219\ud574\uc9c0\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc9c4\ud589\ud568\uc5d0 \ub530\ub77c \ub808\ubca8\uc740 \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc, \ubb34\ub108\uc9c0\ub294 \ud50c\ub7ab\ud3fc, \uc881\uc740 \uae38 \ub4f1 \ub354 \ubcf5\uc7a1\ud55c \uc694\uc18c\ub97c \uc18c\uac1c\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 25\ub294 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uacfc \ube60\ub978 \ubc18\uc751\uc744 \ud544\uc694\ub85c \ud558\ub294 \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uacfc \ubb34\ub108\uc9c0\ub294 \ud50c\ub7ab\ud3fc\uc758 \uc870\ud569\uc73c\ub85c \uad6c\uc131\ub429\ub2c8\ub2e4. \ud6c4\ubc18 \ub808\ubca8\uc5d0\uc11c\ub294 \uac00\uc2dc\uc640 \uc6a9\uc554\uacfc \uac19\uc740 \ud658\uacbd \uc704\ud5d8 \uc694\uc18c\ub3c4 \ucd94\uac00\ud558\uc5ec \ub3c4\uc804 \uc218\uc900\uc744 \ub192\uc785\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ub09c\uc774\ub3c4 \uace1\uc120\uc744 \uc0b0\uc744 \uc624\ub974\ub294 \uac83\uacfc \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uc138\uc694. \ub192\uc774 \uc62c\ub77c\uac08\uc218\ub85d \ub4f1\ubc18\uc774 \ub354 \uac00\ud30c\ub974\uace0 \uc5b4\ub824\uc6cc\uc9d1\ub2c8\ub2e4.]"}, {"question": "\uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \ub79c\ub364 \uc635\ube44\uc5d0\uc11c \ud754\ud788 \uc800\uc9c0\ub974\ub294 \uc2e4\uc218\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \uc774\ub7ec\ud55c \uc2e4\uc218\ub97c \ud53c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub79c\ub364 \uc635\ube44\uc758 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub294 \uc885\uc885 \ub808\ubca8\uc744 \uacc4\ud68d \uc5c6\uc774 \uc11c\ub450\ub974\uac70\ub098, \uc810\ud504 \uac70\ub9ac\ub97c \uc798\ubabb \ud310\ub2e8\ud558\uac70\ub098, \ud50c\ub7ab\ud3fc \uc0c9\uc0c1\uc5d0 \uc8fc\uc758\ud558\uc9c0 \uc54a\ub294 \uc2e4\uc218\ub97c \ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc2e4\uc218\ub97c \ud53c\ud558\ub824\uba74 \uc774\ub3d9\ud558\uae30 \uc804\uc5d0 \ub808\ubca8 \ub808\uc774\uc544\uc6c3\uc744 \ubd84\uc11d\ud558\ub294 \ub370 \uc2dc\uac04\uc744 \ud560\uc560\ud558\uc138\uc694. \ud50c\ub7ab\ud3fc\uc5d0 \uc815\ud655\ud558\uac8c \ucc29\uc9c0\ud560 \uc218 \uc788\ub3c4\ub85d \uc815\ud655\ud55c \uc810\ud504 \uc5f0\uc2b5\uc744 \ud558\uc138\uc694. \ud50c\ub7ab\ud3fc\uc758 \ub3d9\uc791\uc744 \uc774\ud574\ud558\uae30 \uc704\ud574 \uc0c9\uc0c1\uc73c\ub85c \uad6c\ubd84\ub41c \ud50c\ub7ab\ud3fc\uc5d0 \uc8fc\uc758\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4 \ub808\ubca8 5\uc5d0\uc11c \ud50c\ub7ab\ud3fc \uc0c9\uc0c1\uc744 \ud655\uc778\ud558\uc9c0 \uc54a\uace0 \uc11c\ub450\ub974\uba74 \ubd88\uc548\uc815\ud55c \ube68\uac04\uc0c9 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub5a8\uc5b4\uc9c0\ub294 \uc2e4\uc218\ub97c \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4 \uc124\uba85: \uc77c\ubc18\uc801\uc778 \uc2e4\uc218\ub97c \ud53c\ud558\uae30 \uc704\ud55c \ubd84\uc11d, \uc5f0\uc2b5, \uc6c0\uc9c1\uc784 \uc2e4\ud589 \ub2e8\uacc4\ub97c \ub098\ud0c0\ub0b4\ub294 \ud750\ub984\ub3c4\ub97c \uc0dd\uc131\ud558\uc138\uc694.]"}]
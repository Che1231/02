[{"question": "\u5982\u4f55\u624d\u80fd\u638c\u63e1\u5f69\u8679\u8ff7\u5bae\u65b0\u624b\u5165\u9580\u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u638c\u63e1\u5f69\u8679\u8ff7\u5bae\u7684\u57fa\u672c\u63a7\u5236\uff0c\u9996\u5148\u8981\u719f\u6089\u79fb\u52d5\u9375\uff1a\u300eW\u300f\u5411\u524d\u79fb\u52d5\uff0c\u300eA\u300f\u5411\u5de6\u79fb\u52d5\uff0c\u300eD\u300f\u5411\u53f3\u79fb\u52d5\uff0c\u300eS\u300f\u5411\u5f8c\u79fb\u52d5\u3002\u4f7f\u7528\u7a7a\u683c\u9375\u8df3\u8e8d\u3002\u5728\u6700\u521d\u7684\u5e7e\u500b\u95dc\u5361\uff0c\u4f8b\u5982\u95dc\u5361 1\uff0c\u7df4\u7fd2\u9019\u4e9b\u63a7\u5236\uff0c\u56e0\u70ba\u9019\u4e9b\u95dc\u5361\u53ea\u9700\u8981\u7c21\u55ae\u7684\u5e73\u53f0\u79fb\u52d5\u3002\u4f8b\u5982\uff0c\u5728\u95dc\u5361 1 \u4e2d\uff0c\u53ef\u4ee5\u4f7f\u7528\u7a7a\u683c\u9375\u7df4\u7fd2\u5f9e\u4e00\u500b\u5e73\u53f0\u8df3\u5230\u53e6\u4e00\u500b\u5e73\u53f0\u3002\u8a18\u4f4f\u8981\u4ed4\u7d30\u63a7\u5236\u8df3\u8e8d\u6642\u9593\uff0c\u4ee5\u514d\u6389\u843d\u3002\u6b64\u5916\uff0c\u4f7f\u7528\u6ed1\u9f20\u53ef\u4ee5\u74b0\u9867\u56db\u5468\u4e26\u8abf\u6574\u76f8\u6a5f\u89d2\u5ea6\uff0c\u4ee5\u7372\u5f97\u66f4\u597d\u7684\u8996\u91ce\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u628a\u63a7\u5236\u60f3\u8c61\u6210\u958b\u8eca\uff1b\u4f60\u9700\u8981\u5148\u719f\u6089\u57fa\u790e\u624d\u80fd\u52a0\u901f\u3002]"}, {"question": "\u5b8c\u6210\u5f69\u8679\u8ff7\u5bae\u9ad8\u7d1a\u95dc\u5361\u7684\u5fc5\u8981\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5b8c\u6210\u5f69\u8679\u8ff7\u5bae\u7684\u9ad8\u7d1a\u95dc\u5361\u9700\u8981\u7cbe\u6e96\u5ea6\u3001\u6642\u9593\u63a7\u5236\u548c\u7b56\u7565\u898f\u5283\u7684\u7d50\u5408\u3002\u4ee5\u4e0b\u662f\u9010\u6b65\u7684\u65b9\u6cd5\uff1a\u6b65\u9a5f 1\uff1a\u5728\u9032\u884c\u4efb\u4f55\u52d5\u4f5c\u4e4b\u524d\u5206\u6790\u95dc\u5361\u4f48\u5c40\u3002\u5c0b\u627e\u5e73\u53f0\u653e\u7f6e\u7684\u6a21\u5f0f\u6216\u9806\u5e8f\u3002\u6b65\u9a5f 2\uff1a\u7df4\u7fd2\u7cbe\u6e96\u8df3\u8e8d\u3002\u4f8b\u5982\uff0c\u5728\u95dc\u5361 15 \u4e2d\uff0c\u4f60\u9700\u8981\u9032\u884c\u4e00\u7cfb\u5217\u5c0f\u800c\u7cbe\u78ba\u7684\u8df3\u8e8d\uff0c\u4ee5\u901a\u904e\u72f9\u7a84\u7684\u5e73\u53f0\u3002\u6b65\u9a5f 3\uff1a\u5584\u7528\u74b0\u5883\u3002\u6709\u4e9b\u95dc\u5361\u6709\u79fb\u52d5\u5e73\u53f0\u6216\u969c\u7919\u7269\uff0c\u9700\u8981\u4f60\u5b8c\u7f8e\u5730\u63a7\u5236\u8df3\u8e8d\u6642\u9593\u3002\u4f8b\u5982\uff0c\u5728\u95dc\u5361 20 \u4e2d\uff0c\u4f60\u9700\u8981\u8df3\u5230\u4e00\u500b\u79fb\u52d5\u7684\u5e73\u53f0\u4e0a\uff0c\u7136\u5f8c\u8fc5\u901f\u8df3\u5230\u4e0b\u4e00\u500b\u5e73\u53f0\uff0c\u4ee5\u514d\u88ab\u932f\u904e\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u60f3\u50cf\u4e00\u500b\u6d41\u7a0b\u5716\uff0c\u5176\u4e2d\u4f60\u6309\u7167\u5206\u6790\u3001\u7df4\u7fd2\u548c\u57f7\u884c\u52d5\u4f5c\u7684\u9806\u5e8f\u4f86\u64cd\u4f5c\u3002]"}, {"question": "\u6211\u61c9\u8a72\u8abf\u6574\u54ea\u4e9b\u9375\u4f4d\u624d\u80fd\u5728\u5f69\u8679\u8ff7\u5bae\u4e2d\u63d0\u5347\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u8abf\u6574\u9375\u4f4d\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u4f60\u5728\u5f69\u8679\u8ff7\u5bae\u4e2d\u7684\u904a\u6232\u9ad4\u9a57\u3002\u5982\u679c\u4f60\u89ba\u5f97\u9810\u8a2d\u7684\u7a7a\u683c\u9375\u8df3\u8e8d\u8a2d\u5b9a\u4e0d\u8212\u670d\uff0c\u53ef\u4ee5\u8003\u616e\u5c07\u8df3\u8e8d\u9375\u66f4\u6539\u70ba\u66f4\u65b9\u4fbf\u7684\u9375\u76e4\uff0c\u4f8b\u5982\u300eShift\u300f\u6216\u300eCtrl\u300f\u3002\u4f60\u4e5f\u53ef\u4ee5\u5c07\u79fb\u52d5\u9375\u91cd\u65b0\u7d81\u5b9a\u5230\u65b9\u5411\u9375\uff0c\u5982\u679c\u4f60\u66f4\u559c\u6b61\u7528\u53f3\u624b\u9032\u884c\u79fb\u52d5\u3002\u4f8b\u5982\uff0c\u6709\u4e9b\u73a9\u5bb6\u89ba\u5f97\u4f7f\u7528\u300eE\u300f\u9375\u8df3\u8e8d\u548c\u300eR\u300f\u9375\u8e72\u4e0b\u66f4\u65b9\u4fbf\u3002\u8981\u8abf\u6574\u9375\u4f4d\uff0c\u8acb\u524d\u5f80\u904a\u6232\u8a2d\u5b9a\u4e26\u9078\u64c7\u300e\u63a7\u5236\u300f\u3002\u5617\u8a66\u4e0d\u540c\u7684\u914d\u7f6e\uff0c\u627e\u5230\u6700\u9069\u5408\u4f60\u7684\u8a2d\u5b9a\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u5efa\u7acb\u4e00\u500b\u8868\u683c\uff0c\u6bd4\u8f03\u9810\u8a2d\u9375\u4f4d\u548c\u81ea\u5b9a\u7fa9\u9375\u4f4d\uff0c\u770b\u770b\u54ea\u7a2e\u8a2d\u5b9a\u80fd\u63d0\u9ad8\u4f60\u7684\u8868\u73fe\u3002]"}, {"question": "\u5f69\u8679\u8ff7\u5bae\u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f\u6211\u5982\u4f55\u6700\u5927\u5316\u6211\u7684\u5f97\u5206\uff1f", "answer": "\u5f69\u8679\u8ff7\u5bae\u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u591a\u500b\u56e0\u7d20\uff1a\u4f60\u6210\u529f\u8457\u9678\u7684\u5e73\u53f0\u6578\u91cf\u3001\u5b8c\u6210\u95dc\u5361\u6240\u9700\u7684\u6642\u9593\u4ee5\u53ca\u4f60\u6536\u96c6\u7684\u6536\u85cf\u54c1\u6578\u91cf\u3002\u8981\u6700\u5927\u5316\u4f60\u7684\u5f97\u5206\uff0c\u76ee\u6a19\u662f\u5728\u4e0d\u6389\u843d\u7684\u689d\u4ef6\u4e0b\uff0c\u767b\u4e0a\u6bcf\u500b\u5e73\u53f0\u5118\u53ef\u80fd\u5feb\u901f\u5b8c\u6210\u95dc\u5361\uff0c\u4e26\u6536\u96c6\u6240\u6709\u96b1\u85cf\u7684\u661f\u661f\u3002\u4f8b\u5982\uff0c\u5728\u95dc\u5361 10 \u4e2d\uff0c\u6709\u4e09\u500b\u96b1\u85cf\u7684\u661f\u661f\uff0c\u5982\u679c\u6536\u96c6\u4e86\u9019\u4e9b\u661f\u661f\uff0c\u5b83\u5011\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u4f60\u7684\u5f97\u5206\u3002\u6b64\u5916\uff0c\u5617\u8a66\u4fdd\u6301\u9023\u7e8c\u6210\u529f\u7684\u8df3\u8e8d\uff0c\u56e0\u70ba\u9023\u7e8c\u8df3\u8e8d\u800c\u4e0d\u6389\u843d\u53ef\u4ee5\u7372\u5f97\u984d\u5916\u734e\u52f5\u5206\u6578\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u6bd4\u8f03\u4e0d\u540c\u7684\u7b56\u7565\uff0c\u4f8b\u5982\u901f\u901a\u8207\u6536\u96c6\u6240\u6709\u661f\u661f\uff0c\u770b\u770b\u54ea\u7a2e\u7b56\u7565\u80fd\u7372\u5f97\u6700\u9ad8\u7684\u5f97\u5206\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u5f69\u8679\u8ff7\u5bae\u4e2d\u6709\u4e9b\u5e73\u53f0\u6703\u7528\u984f\u8272\u7de8\u78bc\uff1f\u5b83\u5011\u5982\u4f55\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff1f", "answer": "\u5f69\u8679\u8ff7\u5bae\u4e2d\u984f\u8272\u7de8\u78bc\u7684\u5e73\u53f0\u662f\u7528\u65bc\u8996\u89ba\u63d0\u793a\uff0c\u6307\u793a\u5b83\u5011\u7684\u884c\u4e3a\u6216\u5c6c\u6027\u3002\u4f8b\u5982\uff0c\u7d05\u8272\u5e73\u53f0\u901a\u5e38\u4e0d\u7a69\u5b9a\uff0c\u5e7e\u79d2\u9418\u5f8c\u5c31\u6703\u584c\u9677\uff0c\u800c\u85cd\u8272\u5e73\u53f0\u901a\u5e38\u662f\u7a69\u5b9a\u7684\uff0c\u53ef\u4ee5\u5b89\u5168\u8457\u9678\u3002\u7da0\u8272\u5e73\u53f0\u53ef\u80fd\u5728\u79fb\u52d5\uff0c\u9700\u8981\u7cbe\u6e96\u7684\u6642\u9593\u63a7\u5236\u624d\u80fd\u8df3\u5230\u5b83\u5011\u4e0a\u9762\u3002\u4e86\u89e3\u9019\u4e9b\u984f\u8272\u7de8\u78bc\u53ef\u4ee5\u5e6b\u52a9\u4f60\u5236\u5b9a\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u5728\u95dc\u5361 12 \u4e2d\uff0c\u4f60\u9700\u8981\u8fc5\u901f\u5f9e\u7d05\u8272\u5e73\u53f0\u8df3\u5230\u85cd\u8272\u5e73\u53f0\uff0c\u4ee5\u514d\u7d05\u8272\u5e73\u53f0\u584c\u9677\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u628a\u984f\u8272\u7de8\u78bc\u7684\u5e73\u53f0\u60f3\u8c61\u6210\u4ea4\u901a\u71c8\uff1b\u7d05\u8272\u4ee3\u8868\u5371\u96aa\uff0c\u7da0\u8272\u4ee3\u8868\u901a\u884c\uff0c\u85cd\u8272\u4ee3\u8868\u5b89\u5168\u5340\u57df\u3002]"}, {"question": "\u5728\u5f69\u8679\u8ff7\u5bae\u4e2d\u5982\u4f55\u99d5\u99ad\u79fb\u52d5\u5e73\u53f0\uff1f", "answer": "\u5728\u5f69\u8679\u8ff7\u5bae\u4e2d\u99d5\u99ad\u79fb\u52d5\u5e73\u53f0\u9700\u8981\u4ed4\u7d30\u7684\u6642\u9593\u63a7\u5236\u548c\u9810\u6e2c\u3002\u4ee5\u4e0b\u662f\u9010\u6b65\u6307\u5357\uff1a\u6b65\u9a5f 1\uff1a\u89c0\u5bdf\u5e73\u53f0\u7684\u79fb\u52d5\u6a21\u5f0f\u3002\u5927\u591a\u6578\u79fb\u52d5\u5e73\u53f0\u9075\u5faa\u53ef\u9810\u6e2c\u7684\u8def\u5f91\uff0c\u4f8b\u5982\u4f86\u56de\u79fb\u52d5\u6216\u5713\u5468\u904b\u52d5\u3002\u6b65\u9a5f 2\uff1a\u5c07\u81ea\u5df1\u5b9a\u4f4d\u5728\u5e73\u53f0\u8def\u5f91\u9644\u8fd1\uff0c\u4f46\u4e0d\u8981\u592a\u9760\u8fd1\uff0c\u907f\u514d\u88ab\u63a8\u4e0b\u4f86\u3002\u6b65\u9a5f 3\uff1a\u628a\u63e1\u8df3\u8e8d\u6642\u9593\uff0c\u5728\u5e73\u53f0\u6700\u63a5\u8fd1\u4f60\u7684\u6642\u5019\u8df3\u8e8d\u3002\u4f8b\u5982\uff0c\u5728\u95dc\u5361 18 \u4e2d\uff0c\u4f60\u9700\u8981\u8df3\u5230\u4e00\u500b\u4ee5\u5713\u5468\u904b\u52d5\u79fb\u52d5\u7684\u5e73\u53f0\u4e0a\uff0c\u9700\u8981\u7cbe\u6e96\u7684\u6642\u9593\u63a7\u5236\u624d\u80fd\u5b89\u5168\u8457\u9678\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u5275\u5efa\u4e00\u500b\u6d41\u7a0b\u5716\uff0c\u6982\u8ff0\u89c0\u5bdf\u3001\u5b9a\u4f4d\u548c\u8df3\u8e8d\u6642\u9593\u7684\u6b65\u9a5f\u3002]"}, {"question": "\u5982\u4f55\u5c07\u5f69\u8679\u8ff7\u5bae\u7684\u9032\u5ea6\u5f9e\u4e00\u500b\u88dd\u7f6e\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u88dd\u7f6e\uff1f", "answer": "\u5982\u679c\u5728\u4e0d\u540c\u7684\u88dd\u7f6e\u4e0a\u4f7f\u7528\u540c\u4e00\u500b\u5e33\u865f\uff0c\u5c07\u5f69\u8679\u8ff7\u5bae\u7684\u9032\u5ea6\u5f9e\u4e00\u500b\u88dd\u7f6e\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u88dd\u7f6e\u975e\u5e38\u7c21\u55ae\u3002\u9996\u5148\uff0c\u78ba\u4fdd\u4f60\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u90fd\u767b\u9304\u4e86\u76f8\u540c\u7684\u5e33\u865f\u3002\u5f69\u8679\u8ff7\u5bae\u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u4f86\u540c\u6b65\u4f60\u7684\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5df2\u5728\u96fb\u8166\u4e0a\u5b8c\u6210\u95dc\u5361 10\uff0c\u5247\u900f\u904e\u767b\u9304\u76f8\u540c\u7684\u5e33\u865f\uff0c\u4f60\u53ef\u4ee5\u5728\u624b\u6a5f\u4e0a\u5f9e\u95dc\u5361 10 \u7e7c\u7e8c\u904a\u6232\u3002\u5982\u679c\u9047\u5230\u4efb\u4f55\u554f\u984c\uff0c\u8acb\u6aa2\u67e5\u4f60\u7684\u7db2\u8def\u9023\u7dda\uff0c\u4e26\u78ba\u4fdd\u904a\u6232\u8a2d\u5b9a\u4e2d\u5df2\u555f\u7528\u96f2\u7aef\u5132\u5b58\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6bd4\u8f03\u5728\u4e0d\u540c\u88dd\u7f6e\u4e0a\u540c\u6b65\u9032\u5ea6\u7684\u6b65\u9a5f\uff0c\u4ee5\u78ba\u4fdd\u9806\u5229\u8f49\u79fb\u3002]"}, {"question": "\u5f69\u8679\u8ff7\u5bae\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u7684\u6536\u85cf\u54c1\uff0c\u4ee5\u53ca\u5b83\u5011\u7684\u4f4d\u7f6e\u5728\u54ea\u88e1\uff1f", "answer": "\u5f69\u8679\u8ff7\u5bae\u4e2d\u6709\u96b1\u85cf\u7684\u6536\u85cf\u54c1\uff0c\u4f8b\u5982\u661f\u661f\u548c\u786c\u5e63\uff0c\u6563\u4f48\u5728\u5404\u7a2e\u95dc\u5361\u4e2d\u3002\u9019\u4e9b\u6536\u85cf\u54c1\u901a\u5e38\u4f4d\u65bc\u96e3\u4ee5\u5230\u9054\u7684\u5730\u65b9\uff0c\u6216\u9700\u8981\u89e3\u6c7a\u4e00\u4e9b\u5c0f\u8b0e\u984c\u624d\u80fd\u7372\u53d6\u3002\u4f8b\u5982\uff0c\u5728\u95dc\u5361 7 \u4e2d\uff0c\u6709\u4e00\u500b\u96b1\u85cf\u7684\u661f\u661f\u4f4d\u65bc\u4e00\u7cfb\u5217\u79fb\u52d5\u5e73\u53f0\u7684\u5f8c\u9762\u3002\u8981\u627e\u5230\u5b83\uff0c\u4f60\u9700\u8981\u5b8c\u7f8e\u5730\u63a7\u5236\u8df3\u8e8d\u6642\u9593\uff0c\u4e26\u901a\u904e\u5e73\u53f0\u4f86\u5230\u9054\u661f\u661f\u3002\u6536\u96c6\u9019\u4e9b\u96b1\u85cf\u7269\u54c1\u4e0d\u50c5\u53ef\u4ee5\u63d0\u5347\u4f60\u7684\u5f97\u5206\uff0c\u9084\u53ef\u4ee5\u89e3\u9396\u7279\u6b8a\u734e\u52f5\u548c\u6210\u5c31\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u6bd4\u8f03\u4e0d\u540c\u7684\u96b1\u85cf\u6536\u85cf\u54c1\u5c0b\u627e\u65b9\u6cd5\uff0c\u4f8b\u5982\u63a2\u7d22\u6bcf\u500b\u89d2\u843d\u8207\u9075\u5faa\u7279\u5b9a\u8def\u5f91\u3002]"}, {"question": "\u5f69\u8679\u8ff7\u5bae\u7684\u96e3\u5ea6\u66f2\u7dda\u662f\u5982\u4f55\u6f14\u8b8a\u7684\uff1f\u5728\u5f8c\u7e8c\u95dc\u5361\u61c9\u8a72\u6ce8\u610f\u54ea\u4e9b\u4e8b\u9805\uff1f", "answer": "\u96a8\u8457\u4f60\u901a\u904e\u95dc\u5361\u7684\u9032\u5ea6\uff0c\u5f69\u8679\u8ff7\u5bae\u7684\u96e3\u5ea6\u66f2\u7dda\u6703\u9010\u6f38\u589e\u52a0\u3002\u65e9\u671f\u7684\u95dc\u5361\u65e8\u5728\u5e6b\u52a9\u4f60\u9069\u61c9\u57fa\u672c\u63a7\u5236\u548c\u6a5f\u5236\u3002\u96a8\u8457\u4f60\u7684\u9032\u968e\uff0c\u95dc\u5361\u6703\u5f15\u9032\u66f4\u591a\u8907\u96dc\u7684\u5143\u7d20\uff0c\u4f8b\u5982\u79fb\u52d5\u5e73\u53f0\u3001\u584c\u9677\u5e73\u53f0\u548c\u72f9\u7a84\u7684\u901a\u9053\u3002\u4f8b\u5982\uff0c\u95dc\u5361 25 \u4e2d\u7d50\u5408\u4e86\u79fb\u52d5\u548c\u584c\u9677\u5e73\u53f0\uff0c\u9700\u8981\u7cbe\u6e96\u7684\u6642\u9593\u63a7\u5236\u548c\u5feb\u901f\u53cd\u61c9\u3002\u5f8c\u7e8c\u7684\u95dc\u5361\u4e5f\u6703\u5f15\u9032\u74b0\u5883\u4e2d\u7684\u5371\u96aa\uff0c\u4f8b\u5982\u5c16\u523a\u548c\u7194\u5ca9\uff0c\u589e\u52a0\u4e86\u984d\u5916\u7684\u6311\u6230\u6027\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u628a\u96e3\u5ea6\u66f2\u7dda\u60f3\u8c61\u6210\u722c\u5c71\uff1b\u4f60\u722c\u5f97\u8d8a\u9ad8\uff0c\u6500\u722c\u5c31\u8d8a\u9661\u5ced\u3001\u8d8a\u5177\u6311\u6230\u6027\u3002]"}, {"question": "\u65b0\u624b\u73a9\u5bb6\u5728\u5f69\u8679\u8ff7\u5bae\u4e2d\u5e38\u898b\u7684\u932f\u8aa4\u662f\u4ec0\u9ebc\uff1f\u6211\u5982\u4f55\u907f\u514d\u9019\u4e9b\u932f\u8aa4\uff1f", "answer": "\u5f69\u8679\u8ff7\u5bae\u4e2d\u7684\u65b0\u624b\u73a9\u5bb6\u7d93\u5e38\u72af\u7684\u932f\u8aa4\u5305\u62ec\uff1a\u5728\u6c92\u6709\u8a08\u5283\u7684\u60c5\u6cc1\u4e0b\u5306\u5fd9\u901a\u904e\u95dc\u5361\u3001\u8aa4\u5224\u8df3\u8e8d\u8ddd\u96e2\u4ee5\u53ca\u6c92\u6709\u6ce8\u610f\u5e73\u53f0\u984f\u8272\u3002\u70ba\u4e86\u907f\u514d\u9019\u4e9b\u932f\u8aa4\uff0c\u8acb\u82b1\u6642\u9593\u5728\u57f7\u884c\u4efb\u4f55\u52d5\u4f5c\u4e4b\u524d\u5206\u6790\u95dc\u5361\u4f48\u5c40\u3002\u7df4\u7fd2\u7cbe\u6e96\u8df3\u8e8d\uff0c\u4ee5\u78ba\u4fdd\u4f60\u6e96\u78ba\u5730\u767b\u4e0a\u5e73\u53f0\u3002\u6ce8\u610f\u984f\u8272\u7de8\u78bc\u7684\u5e73\u53f0\uff0c\u4e86\u89e3\u5b83\u5011\u7684\u884c\u70ba\u3002\u4f8b\u5982\uff0c\u5728\u95dc\u5361 5 \u4e2d\uff0c\u5982\u679c\u6c92\u6709\u89c0\u5bdf\u5e73\u53f0\u984f\u8272\u800c\u5306\u5fd9\u901a\u904e\uff0c\u53ef\u80fd\u6703\u6389\u843d\u4e0d\u7a69\u5b9a\u7684\u7d05\u8272\u5e73\u53f0\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u5275\u5efa\u4e00\u500b\u6d41\u7a0b\u5716\uff0c\u6982\u8ff0\u5206\u6790\u3001\u7df4\u7fd2\u548c\u57f7\u884c\u52d5\u4f5c\u4ee5\u907f\u514d\u5e38\u898b\u932f\u8aa4\u7684\u6b65\u9a5f\u3002]"}]
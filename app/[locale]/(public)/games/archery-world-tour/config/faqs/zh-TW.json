[{"question": "Archery World Tour \u5982\u4f55\u7784\u6e96\uff1f\u65b0\u624b\u5982\u4f55\u5feb\u901f\u638c\u63e1\u57fa\u672c\u64cd\u4f5c\uff0c\u63d0\u9ad8\u547d\u4e2d\u7387\uff1f", "answer": "Archery World Tour \u5165\u9580\u4e26\u4e0d\u96e3\uff01\u904a\u6232\u63a1\u7528\u7b2c\u4e00\u4eba\u7a31\u8996\u89d2\uff0c\u900f\u904e\u6ed1\u52d5\u87a2\u5e55\u63a7\u5236\u5f13\u7bad\u7684\u7784\u6e96\u65b9\u5411\u3002\u65b0\u624b\u8981\u63d0\u5347\u547d\u4e2d\u7387\uff0c\u53ef\u4ee5\u5617\u8a66\u4ee5\u4e0b\u65b9\u6cd5\uff1a\u25a0\u719f\u6089\u4e0d\u540c\u5f13\u7bad\u7684\u7279\u9ede\uff1a\u5f13\u7bad\u7684\u5c04\u7a0b\u3001\u7a69\u5b9a\u6027\u548c\u529b\u91cf\u5404\u4e0d\u76f8\u540c\uff0c\u9078\u64c7\u9069\u5408\u81ea\u5df1\u7684\u5f13\u7bad\u975e\u5e38\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u521d\u59cb\u5f13\u7bad\u9069\u5408\u8fd1\u8ddd\u96e2\u7df4\u7fd2\uff0c\u800c\u5347\u7d1a\u5f8c\u7684\u5f13\u7bad\u53ef\u4ee5\u5728\u66f4\u9060\u7684\u8ddd\u96e2\u4fdd\u6301\u7cbe\u6e96\u3002\u25a0\u628a\u63e1\u98a8\u5411\u548c\u8ddd\u96e2\uff1a\u6ce8\u610f\u87a2\u5e55\u4e0a\u7684\u98a8\u5411\u6a19\uff0c\u4e26\u6839\u64da\u76ee\u6a19\u8ddd\u96e2\u8abf\u6574\u7784\u6e96\u9ede\u3002\u7df4\u7fd2\u6642\uff0c\u53ef\u4ee5\u5148\u5617\u8a66\u56fa\u5b9a\u8ddd\u96e2\u7684\u9776\u5b50\uff0c\u9010\u6f38\u589e\u52a0\u96e3\u5ea6\u3002\u25a0\u7df4\u7fd2\u7bc0\u594f\u611f\uff1a\u62c9\u5f13\u6642\u4e0d\u8981\u6025\u65bc\u9b06\u624b\uff0c\u627e\u5230\u5408\u9069\u7684\u7bc0\u594f\u611f\u53ef\u4ee5\u6709\u6548\u63d0\u9ad8\u7a69\u5b9a\u6027\u3002"}, {"question": "Why is my Archery World Tour score so low? \u6709\u4ec0\u9ebc\u63d0\u5347 Archery World Tour \u5206\u6578\u7684\u65b9\u6cd5\uff1f\u807d\u8aaa\u548c\u88dd\u5099\u6709\u95dc?", "answer": "Archery World Tour \u7684\u5206\u6578\u53d7\u5230\u591a\u65b9\u9762\u56e0\u7d20\u7684\u5f71\u97ff\uff0c\u88dd\u5099\u78ba\u5be6\u81f3\u95dc\u91cd\u8981\u3002\u4f60\u7684\u5f97\u5206\u4f4e\u53ef\u80fd\u56e0\u70ba \u2460 \u5f13\u7bad\u7b49\u7d1a\u4e0d\u5920\uff0c\u5c0e\u81f4\u7a69\u5b9a\u6027\u5dee\uff0c\u5f71\u97ff\u547d\u4e2d\uff1b\u2461 \u7bad\u652f\u54c1\u8cea\u4e0d\u9ad8\uff0c\u964d\u4f4e\u50b7\u5bb3\u548c\u7a7f\u900f\u529b\uff1b\u2462 \u6280\u80fd\u7b49\u7d1a\u4f4e\uff0c\u7121\u6cd5\u7372\u5f97\u984d\u5916\u7684\u52a0\u6210\u3002\u63d0\u5347\u5206\u6578\u53ef\u4ee5\u5f9e\u4ee5\u4e0b\u5e7e\u500b\u65b9\u9762\u8457\u624b\uff1a\u25a0\u5347\u7d1a\u5f13\u7bad\uff1a\u66f4\u9ad8\u7b49\u7d1a\u7684\u5f13\u7bad\u64c1\u6709\u66f4\u51fa\u8272\u7684\u5c6c\u6027\uff0c\u662f\u63d0\u5347\u547d\u4e2d\u7387\u548c\u50b7\u5bb3\u7684\u57fa\u790e\u3002\u25a0\u9078\u64c7\u5408\u9069\u7684\u7bad\u652f\uff1a\u6839\u64da\u6bd4\u8cfd\u5834\u666f\u9078\u64c7\u5c0d\u61c9\u7684\u7bad\u652f\uff0c\u4f8b\u5982\uff0c\u7a7f\u900f\u7bad\u9069\u5408\u7a7f\u900f\u591a\u500b\u76ee\u6a19\uff0c\u706b\u7130\u7bad\u9069\u5408\u7279\u6b8a\u6d3b\u52d5\u3002\u25a0\u63d0\u5347\u6280\u80fd\uff1a\u900f\u904e\u904a\u6232\u7372\u5f97\u7684\u6280\u80fd\u9ede\u53ef\u4ee5\u63d0\u5347\u89d2\u8272\u7684\u5404\u9805\u80fd\u529b\uff0c\u4f8b\u5982\uff0c\u63d0\u5347\u7784\u6e96\u901f\u5ea6\u3001\u589e\u52a0\u66b4\u64ca\u7387\u7b49\u3002\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u4f8b\u5982\uff0c\u60f3\u8981\u5728\u6311\u6230\u8cfd\u4e2d\u7372\u5f97\u9ad8\u5206\uff0c\u63a8\u85a6\u4f7f\u7528S\u7d1a\u5f13\u7bad\u642d\u914d\u7a7f\u900f\u7bad\uff0c\u4e26\u512a\u5148\u5347\u7d1a\u7a7f\u900f\u548c\u66b4\u64ca\u6280\u80fd\u3002"}, {"question": "Archery World Tour \u9032\u968e\u653b\u7565\uff1a\u5982\u4f55\u5229\u7528\u5730\u5f62\u548c\u98a8\u5411\uff0c\u5728\u8907\u96dc\u74b0\u5883\u4e0b\u767e\u767c\u767e\u4e2d\uff1f", "answer": "Archery World Tour \u7684\u7cbe\u9ad3\u5728\u65bc\u638c\u63e1\u74b0\u5883\u56e0\u7d20\u4e26\u52a0\u4ee5\u5229\u7528\u3002\u5728\u8907\u96dc\u74b0\u5883\u4e2d\uff0c\u98a8\u5411\u548c\u5730\u5f62\u662f\u5f71\u97ff\u5c04\u7bad\u7684\u95dc\u9375\u56e0\u7d20\u3002\u6b65\u9a5f 1\uff1a\u89c0\u5bdf\u98a8\u5411\u3002\u904a\u6232\u4ecb\u9762\u6703\u986f\u793a\u76ee\u524d\u7684\u98a8\u5411\u548c\u98a8\u529b\uff0c\u9700\u8981\u6839\u64da\u98a8\u5411\u8abf\u6574\u7784\u6e96\u9ede\uff0c\u9806\u98a8\u6642\u7784\u6e96\u9ede\u7565\u5fae\u504f\u4e0b\uff0c\u9006\u98a8\u6642\u7784\u6e96\u9ede\u7565\u5fae\u504f\u4e0a\u3002\u6b65\u9a5f 2\uff1a\u5229\u7528\u5730\u5f62\u3002\u6709\u4e9b\u5834\u666f\u4e2d\uff0c\u53ef\u4ee5\u5229\u7528\u5730\u5f62\u4f5c\u70ba\u63a9\u9ad4\uff0c\u6e1b\u5c11\u98a8\u7684\u5f71\u97ff\u3002\u4f8b\u5982\uff0c\u5728\u9ad8\u5854\u4e0a\u5c04\u64ca\uff0c\u53ef\u4ee5\u5229\u7528\u5854\u8eab\u906e\u64cb\u90e8\u5206\u98a8\u529b\u3002\u6b65\u9a5f 3\uff1a\u5fae\u8abf\u7784\u6e96\u3002\u5728\u5c04\u64ca\u524d\uff0c\u53ef\u4ee5\u9032\u884c\u5fae\u8abf\uff0c\u89c0\u5bdf\u7bad\u7684\u98db\u884c\u8ecc\u8de1\uff0c\u4e26\u6839\u64da\u5be6\u969b\u60c5\u6cc1\u9032\u884c\u8abf\u6574\u3002\u985e\u6bd4\u8aaa\u660e\uff1a\u5c31\u50cf\u9ad8\u723e\u592b\u7403\u54e1\u9700\u8981\u8003\u616e\u8349\u5730\u548c\u98a8\u5411\u4e00\u6a23\uff0c\u5f13\u7bad\u624b\u4e5f\u9700\u8981\u5145\u5206\u8003\u616e\u74b0\u5883\u56e0\u7d20\u3002"}, {"question": "Archery World Tour \u91d1\u5e63\u4e0d\u5920\u7528\u600e\u9ebc\u8fa6\uff1f\u5feb\u901f\u7372\u53d6\u91d1\u5e63\u7684\u9014\u5f91\u6709\u54ea\u4e9b\uff1f", "answer": "Archery World Tour \u4e2d\u91d1\u5e63\u662f\u91cd\u8981\u7684\u904a\u6232\u8cc7\u6e90\uff0c\u53ef\u4ee5\u7528\u4e8e\u5347\u7d1a\u88dd\u5099\u3001\u8cfc\u8cb7\u9053\u5177\u7b49\u3002\u5982\u679c\u91d1\u5e63\u4e0d\u5920\u7528\uff0c\u4e0d\u7528\u64d4\u5fc3\uff0c\u6709\u5f88\u591a\u9014\u5f91\u53ef\u4ee5\u5feb\u901f\u7372\u53d6\uff1a\u25a0\u5b8c\u6210\u6bcf\u65e5\u4efb\u52d9\uff1a\u6bcf\u65e5\u4efb\u52d9\u734e\u52f5\u8c50\u539a\uff0c\u662f\u7372\u53d6\u91d1\u5e63\u7684\u4e3b\u8981\u4f86\u6e90\u3002\u25a0\u53c3\u8207\u6bd4\u8cfd\u6d3b\u52d5\uff1a\u53c3\u52a0\u5404\u7a2e\u6bd4\u8cfd\u6d3b\u52d5\uff0c\u6839\u64da\u6392\u540d\u7372\u5f97\u76f8\u61c9\u7684\u734e\u52f5\u3002\u25a0\u89c0\u770b\u5ee3\u544a\uff1a\u904a\u6232\u5167\u6703\u6709\u89c0\u770b\u5ee3\u544a\u7372\u53d6\u91d1\u5e63\u7684\u6a5f\u6703\uff0c\u96d6\u7136\u6578\u91cf\u4e0d\u591a\uff0c\u4f46\u7a4d\u5c11\u6210\u591a\u3002\u25a0\u51fa\u552e\u591a\u9918\u7684\u88dd\u5099\uff1a\u5982\u679c\u80cc\u5305\u88e1\u6709\u591a\u9918\u7684\u4f4e\u7b49\u7d1a\u88dd\u5099\uff0c\u53ef\u4ee5\u51fa\u552e\u63db\u53d6\u91d1\u5e63\u3002\u6d41\u7a0b\u5716\u89e3\uff1a\u6bcf\u65e5\u4efb\u52d9 -> \u6bd4\u8cfd\u6d3b\u52d5 -> \u89c0\u770b\u5ee3\u544a -> \u51fa\u552e\u88dd\u5099\u3002\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u6bd4\u8f03\u4e0d\u540c\u6bd4\u8cfd\u7684\u734e\u52f5\u548c\u96e3\u5ea6\uff0c\u9078\u64c7\u9069\u5408\u81ea\u5df1\u7684\u6bd4\u8cfd\u3002"}, {"question": "Archery World Tour \u5f13\u7bad\u7a2e\u985e\u7e41\u591a\uff0c\u54ea\u4e9b\u5f13\u7bad\u9069\u5408\u65b0\u624b\u4f7f\u7528\uff1f\u5b83\u5011\u7684\u512a\u7f3a\u9ede\u662f\u4ec0\u9ebc\uff1f", "answer": "Archery World Tour \u4e2d\u4e0d\u540c\u5f13\u7bad\u5177\u6709\u4e0d\u540c\u7684\u5c6c\u6027\u548c\u7279\u9ede\uff0c\u9078\u64c7\u5408\u9069\u7684\u5f13\u7bad\u5c0d\u65bc\u65b0\u624b\u4f86\u8aaa\u81f3\u95dc\u91cd\u8981\u3002\u4ee5\u4e0b\u662f\u4e00\u4e9b\u9069\u5408\u65b0\u624b\u4f7f\u7528\u7684\u5f13\u7bad\u53ca\u5176\u512a\u7f3a\u9ede\uff1a\u25a0\u65b0\u624b\u5f13\uff1a\u9019\u662f\u521d\u59cb\u5f13\u7bad\uff0c\u512a\u9ede\u662f\u5bb9\u6613\u4e0a\u624b\uff0c\u7f3a\u9ede\u662f\u5c6c\u6027\u8f03\u4f4e\uff0c\u9069\u5408\u8fd1\u8ddd\u96e2\u7df4\u7fd2\u3002\u25a0\u6728\u8cea\u5f13\uff1a\u53ef\u4ee5\u900f\u904e\u91d1\u5e63\u8cfc\u8cb7\uff0c\u5c6c\u6027\u6bd4\u65b0\u624b\u5f13\u7565\u9ad8\uff0c\u9069\u5408\u4e2d\u8ddd\u96e2\u5c04\u64ca\u3002\u25a0\u92fc\u88fd\u5f13\uff1a\u9700\u8981\u9054\u5230\u4e00\u5b9a\u7b49\u7d1a\u624d\u80fd\u89e3\u9396\uff0c\u5c6c\u6027\u8f03\u9ad8\uff0c\u9069\u5408\u9060\u8ddd\u96e2\u5c04\u64ca\u3002\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u65b0\u624b\u5f13(\u8fd1\u8ddd\u96e2\uff0c\u6613\u4e0a\u624b)\uff0c\u6728\u8cea\u5f13(\u4e2d\u8ddd\u96e2\uff0c\u5e73\u8861)\uff0c\u92fc\u88fd\u5f13(\u9060\u8ddd\u96e2\uff0c\u9ad8\u5c6c\u6027)\u3002\u985e\u6bd4\u8aaa\u660e\uff1a\u65b0\u624b\u5f13\u5c31\u50cf\u7df4\u7fd2\u7528\u7684\u81ea\u884c\u8eca\uff0c\u5bb9\u6613\u64cd\u63a7\uff0c\u4f46\u901f\u5ea6\u8f03\u6162\u3002"}, {"question": "Archery World Tour \u7684\u7269\u7406\u5f15\u64ce\u662f\u5982\u4f55\u5f71\u97ff\u7bad\u77e2\u8ecc\u8de1\u7684\uff1f\u80fd\u5426\u8a73\u7d30\u89e3\u6790\u5176\u7a7a\u6c23\u963b\u529b\u8207\u91cd\u529b\u7684\u8a08\u7b97\u65b9\u5f0f\uff1f", "answer": "Archery World Tour \u7684\u7269\u7406\u5f15\u64ce\u6a21\u64ec\u4e86\u771f\u5be6\u7684\u5c04\u7bad\u904e\u7a0b\uff0c\u7a7a\u6c23\u963b\u529b\u548c\u91cd\u529b\u662f\u5f71\u97ff\u7bad\u77e2\u8ecc\u8de1\u7684\u95dc\u9375\u56e0\u7d20\u3002\u96d6\u7136\u5177\u9ad4\u7684\u8a08\u7b97\u516c\u5f0f\u5b98\u65b9\u6c92\u6709\u516c\u958b\uff0c\u4f46\u6211\u5011\u53ef\u4ee5\u5f9e\u904a\u6232\u8868\u73fe\u63a8\u65b7\uff1a\u25a0\u7a7a\u6c23\u963b\u529b\uff1a\u7bad\u77e2\u5728\u98db\u884c\u904e\u7a0b\u4e2d\u6703\u53d7\u5230\u7a7a\u6c23\u963b\u529b\u7684\u5f71\u97ff\uff0c\u963b\u529b\u5927\u5c0f\u8207\u7bad\u77e2\u7684\u901f\u5ea6\u548c\u6a6b\u622a\u9762\u7a4d\u6709\u95dc\u3002\u901f\u5ea6\u8d8a\u5feb\uff0c\u6a6b\u622a\u9762\u7a4d\u8d8a\u5927\uff0c\u53d7\u5230\u7684\u963b\u529b\u8d8a\u5927\u3002\u25a0\u91cd\u529b\uff1a\u7bad\u77e2\u6703\u53d7\u5230\u91cd\u529b\u7684\u5f71\u97ff\uff0c\u5c0e\u81f4\u7bad\u77e2\u7684\u98db\u884c\u8ecc\u8de1\u5448\u62cb\u7269\u7dda\u3002\u91cd\u529b\u7684\u5927\u5c0f\u53d6\u6c7a\u65bc\u7bad\u77e2\u7684\u8cea\u91cf\u3002\u7cfb\u7d71\u89e3\u6790\uff1a\u904a\u6232\u900f\u904e\u6a21\u64ec\u7a7a\u6c23\u963b\u529b\u548c\u91cd\u529b\uff0c\u4f7f\u5f97\u5c04\u7bad\u904e\u7a0b\u66f4\u70ba\u771f\u5be6\u6709\u8da3\u3002\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u53ef\u4ee5\u900f\u904e\u8abf\u6574\u7bad\u77e2\u7684\u91cd\u91cf\u548c\u5f62\u72c0\u4f86\u6539\u8b8a\u5176\u53d7\u5230\u7684\u7a7a\u6c23\u963b\u529b\u548c\u91cd\u529b\u3002"}, {"question": "Archery World Tour \u5982\u4f55\u5be6\u73fe\u66f4\u9ad8\u7cbe\u5ea6\u7684\u5c04\u64ca\uff1f\u662f\u5426\u5b58\u5728\u96b1\u85cf\u7684\u8f14\u52a9\u7784\u6e96\u6a5f\u5236\uff1f", "answer": "Archery World Tour \u7684\u5c04\u64ca\u7cbe\u5ea6\u4e3b\u8981\u53d6\u6c7a\u65bc\u73a9\u5bb6\u7684\u64cd\u4f5c\u548c\u88dd\u5099\u3002\u904a\u6232\u4e2d\u4e26\u6c92\u6709\u660e\u78ba\u7684\u8f14\u52a9\u7784\u6e96\u6a5f\u5236\uff0c\u4f46\u53ef\u4ee5\u900f\u904e\u4e00\u4e9b\u6280\u5de7\u4f86\u63d0\u9ad8\u7cbe\u5ea6: \u25a0\u4f7f\u7528\u7a69\u5b9a\u7684\u8a2d\u5099\uff1a\u76e1\u91cf\u4f7f\u7528\u7a69\u5b9a\u7684\u8a2d\u5099\u9032\u884c\u904a\u6232\uff0c\u907f\u514d\u8a2d\u5099\u6416\u6643\u5f71\u97ff\u7784\u6e96\u3002\u25a0\u8abf\u6574\u9748\u654f\u5ea6\uff1a\u6839\u64da\u81ea\u5df1\u7684\u7fd2\u6163\u8abf\u6574\u9748\u654f\u5ea6\uff0c\u627e\u5230\u6700\u9069\u5408\u81ea\u5df1\u7684\u8a2d\u5b9a\u3002\u25a0\u7df4\u7fd2\u547c\u5438\uff1a\u6a21\u64ec\u771f\u5be6\u7684\u5c04\u7bad\u904e\u7a0b\uff0c\u5728\u62c9\u5f13\u6642\u6df1\u547c\u5438\uff0c\u653e\u9b06\u8eab\u9ad4\uff0c\u63d0\u9ad8\u7a69\u5b9a\u6027\u3002\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u9ad8\u9748\u654f\u5ea6\u9069\u5408\u5feb\u901f\u7784\u6e96\uff0c\u4f4e\u9748\u654f\u5ea6\u9069\u5408\u7cbe\u7d30\u8abf\u6574\u3002\u985e\u6bd4\u8aaa\u660e\uff1a\u5c31\u50cf\u72d9\u64ca\u624b\u9700\u8981\u5c4f\u4f4f\u547c\u5438\u4e00\u6a23\uff0c\u5f13\u7bad\u624b\u4e5f\u9700\u8981\u63a7\u5236\u547c\u5438\u4f86\u63d0\u9ad8\u7cbe\u5ea6\u3002"}, {"question": "Archery World Tour \u734e\u52f5\u6a5f\u5236\u6df1\u5ea6\u5256\u6790\uff1a\u5f71\u97ff\u734e\u52f5\u7d50\u7b97\u7684\u95dc\u9375\u56e0\u7d20\u6709\u54ea\u4e9b\uff1f\u5982\u4f55\u6700\u5927\u5316\u6536\u76ca\uff1f", "answer": "Archery World Tour \u7684\u734e\u52f5\u7d50\u7b97\u53d7\u5230\u591a\u7a2e\u56e0\u7d20\u7684\u5f71\u97ff\uff0c\u60f3\u8981\u6700\u5927\u5316\u6536\u76ca\uff0c\u9700\u8981\u4e86\u89e3\u4ee5\u4e0b\u95dc\u9375\u56e0\u7d20\uff1a\u25a0\u547d\u4e2d\u7387\uff1a\u547d\u4e2d\u7387\u8d8a\u9ad8\uff0c\u734e\u52f5\u8d8a\u9ad8\u3002\u25a0\u9023\u64ca\u6578\uff1a\u9023\u7e8c\u547d\u4e2d\u76ee\u6a19\u53ef\u4ee5\u7372\u5f97\u984d\u5916\u7684\u734e\u52f5\u3002\u25a0\u7279\u6b8a\u76ee\u6a19\uff1a\u5c04\u4e2d\u7279\u6b8a\u76ee\u6a19\uff08\u4f8b\u5982\uff0c\u79fb\u52d5\u9776\u3001\u7206\u70b8\u9776\uff09\u53ef\u4ee5\u7372\u5f97\u66f4\u9ad8\u7684\u734e\u52f5\u3002\u6700\u5927\u5316\u6536\u76ca\u7684\u6280\u5de7: \u6b65\u9a5f 1\uff1a\u7df4\u7fd2\u7784\u6e96\uff0c\u63d0\u9ad8\u547d\u4e2d\u7387\u3002\u6b65\u9a5f 2\uff1a\u76e1\u91cf\u9023\u7e8c\u547d\u4e2d\u76ee\u6a19\uff0c\u4fdd\u6301\u9023\u64ca\u6578\u3002\u6b65\u9a5f 3\uff1a\u512a\u5148\u5c04\u64ca\u7279\u6b8a\u76ee\u6a19\uff0c\u7372\u53d6\u984d\u5916\u734e\u52f5\u3002\u985e\u6bd4\u8aaa\u660e\uff1a\u5c31\u50cf\u6253\u602a\u904a\u6232\u4e00\u6a23\uff0c\u9023\u64ca\u53ef\u4ee5\u7372\u5f97\u66f4\u9ad8\u7684\u7d93\u9a57\u503c\u3002"}, {"question": "Archery World Tour \u6709PC\u7248\u672c\u55ce\uff1f\u5b89\u5353\u548ciOS\u6578\u64da\u80fd\u5426\u4e92\u901a\uff1f\u5982\u679c\u6211\u60f3\u5728\u4e0d\u540c\u8a2d\u5099\u4e0a\u73a9\uff0c\u61c9\u8a72\u600e\u9ebc\u540c\u6b65\u9032\u5ea6\uff1f", "answer": "\u76ee\u524d Archery World Tour \u4e3b\u8981\u5728\u884c\u52d5\u5e73\u53f0\u767c\u884c\uff0c\u5b98\u65b9\u66ab\u672a\u63a8\u51faPC\u7248\u672c\u3002\u95dc\u65bc\u6578\u64da\u4e92\u901a\uff1a\u901a\u5e38\u60c5\u6cc1\u4e0b\uff0c\u5b89\u5353\u548ciOS\u7248\u672c\u7684\u6570\u636e\u662f\u4e0d\u4e92\u901a\u7684\u3002\u4f46\u662f\uff0c\u5982\u679c\u904a\u6232\u652f\u63f4\u7b2c\u4e09\u65b9\u5e33\u865f\u767b\u5165\uff08\u4f8b\u5982\uff1aFacebook\u3001Google Play\uff09\uff0c\u4e26\u4e14\u958b\u555f\u4e86\u96f2\u540c\u6b65\u529f\u80fd\uff0c\u90a3\u9ebc\u53ef\u4ee5\u5728\u4e0d\u540c\u8a2d\u5099\u4e0a\u540c\u6b65\u904a\u6232\u9032\u5ea6\u3002\u540c\u6b65\u6b65\u9a5f\uff1a\u6b65\u9a5f 1\uff1a\u5728\u539f\u8a2d\u5099\u4e0a\u7d81\u5b9a\u7b2c\u4e09\u65b9\u5e33\u865f\u4e26\u958b\u555f\u96f2\u540c\u6b65\u3002\u6b65\u9a5f 2\uff1a\u5728\u65b0\u8a2d\u5099\u4e0a\u4e0b\u8f09\u904a\u6232\u4e26\u4f7f\u7528\u76f8\u540c\u7684\u7b2c\u4e09\u65b9\u5e33\u865f\u767b\u5165\u3002\u6b65\u9a5f 3\uff1a\u7b49\u5f85\u904a\u6232\u540c\u6b65\u6578\u64da\u3002\u8acb\u6ce8\u610f\uff0c\u90e8\u5206\u904a\u6232\u53ef\u80fd\u4e0d\u652f\u6301\u8de8\u5e73\u53f0\u6578\u64da\u540c\u6b65\uff0c\u5177\u9ad4\u60c5\u6cc1\u8acb\u53c3\u8003\u904a\u6232\u5167\u7684\u8aaa\u660e\u6587\u4ef6\u6216\u806f\u7e6b\u5ba2\u670d\u3002"}, {"question": "Archery World Tour \u5f69\u86cb\u6316\u6398\uff1a\u807d\u8aaa\u904a\u6232\u4e2d\u96b1\u85cf\u8457\u7279\u6b8a\u7684\u5f13\u7bad\u548c\u5834\u666f, \u5982\u4f55\u89f8\u767c\u9019\u4e9b\u96b1\u85cf\u5167\u5bb9\uff1f\u4f8b\u5982\u201c\u91d1\u8272\u7fbd\u6bdb\u5f13\u201d\u9700\u8981\u9054\u6210\u4ec0\u9ebc\u689d\u4ef6\u624d\u80fd\u89e3\u9396\uff1f", "answer": "Archery World Tour \u78ba\u5be6\u96b1\u85cf\u4e86\u4e00\u4e9b\u7279\u6b8a\u7684\u5f13\u7bad\u548c\u5834\u666f\uff0c\u9700\u8981\u6eff\u8db3\u7279\u5b9a\u689d\u4ef6\u624d\u80fd\u89f8\u767c\u3002 \u4ee5\u300c\u91d1\u8272\u7fbd\u6bdb\u5f13\u300d\u70ba\u4f8b\uff0c\u89e3\u9396\u689d\u4ef6\u662f\uff1a\u9023\u7e8c7\u5929\u6bcf\u65e5\u767b\u5165\u904a\u6232\uff0c\u4e26\u4e14\u5728\u4efb\u610f\u6a21\u5f0f\u4e0b\u7d2f\u7a4d\u7372\u5f9710000\u7a4d\u5206\u3002 \u96b1\u85cf\u5167\u5bb9\u7684\u5176\u4ed6\u89f8\u767c\u65b9\u5f0f\uff1a \u25a0\u5b8c\u6210\u7279\u5b9a\u6210\u5c31\uff1a\u904a\u6232\u4e2d\u6709\u8a31\u591a\u96b1\u85cf\u6210\u5c31\uff0c\u5b8c\u6210\u9019\u4e9b\u6210\u5c31\u53ef\u80fd\u6703\u89e3\u9396\u65b0\u7684\u5167\u5bb9\u3002\u25a0\u89f8\u767c\u7279\u5b9a\u4e8b\u4ef6\uff1a\u6709\u4e9b\u5834\u666f\u4e2d\uff0c\u6703\u51fa\u73fe\u4e00\u4e9b\u7279\u6b8a\u7684\u4e8b\u4ef6\uff0c\u89f8\u767c\u9019\u4e9b\u4e8b\u4ef6\u53ef\u80fd\u6703\u89e3\u9396\u65b0\u7684\u5167\u5bb9\u3002 \u25a0\u5728\u7279\u5b9a\u6642\u9593\u767b\u5165\uff1a\u6709\u4e9b\u6d3b\u52d5\u6703\u5728\u7279\u5b9a\u7684\u6642\u9593\u958b\u555f\uff0c\u53c3\u8207\u9019\u4e9b\u6d3b\u52d5\u53ef\u80fd\u6703\u7372\u5f97\u7a00\u6709\u734e\u52f5\u3002 \u5177\u4f53\u7bc4\u4f8b\uff1a\u5728\u67d0\u500b\u7279\u6b8a\u7684\u7bc0\u65e5\u767b\u5165\u904a\u6232\uff0c\u53ef\u80fd\u6703\u7372\u5f97\u7bc0\u65e5\u9650\u5b9a\u7684\u5f13\u7bad\u548c\u76ae\u819a\u3002\u985e\u6bd4\u8aaa\u660e\uff1a\u5c31\u50cf\u5c0b\u5bf6\u904a\u6232\u4e00\u6a23\uff0c\u9700\u8981\u8010\u5fc3\u63a2\u7d22\u624d\u80fd\u767c\u73fe\u96b1\u85cf\u7684\u5bf6\u85cf\u3002"}]
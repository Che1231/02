[{"question": "\ud65c\uc3d8\uae30 \uc6d4\ub4dc \ud22c\uc5b4\ub294 \uc5b4\ub5bb\uac8c \uc870\uc900\ud574\uc57c \ud558\ub098\uc694? \ucd08\uc2ec\uc790\ub294 \uc5b4\ub5bb\uac8c \uae30\ubcf8 \uc870\uc791\uc744 \ube60\ub974\uac8c \uc775\ud788\uace0 \uba85\uc911\ub960\uc744 \ub192\uc77c \uc218 \uc788\ub098\uc694?", "answer": "\ud65c\uc3d8\uae30 \uc6d4\ub4dc \ud22c\uc5b4 \uc785\ubb38\uc740 \uc5b4\ub835\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4! \uac8c\uc784\uc740 1\uc778\uce6d \uc2dc\uc810\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud654\uba74\uc744 \uc4f8\uc5b4\uc11c \ud65c\uc758 \uc870\uc900 \ubc29\ud5a5\uc744 \uc81c\uc5b4\ud569\ub2c8\ub2e4. \ucd08\uc2ec\uc790\uac00 \uba85\uc911\ub960\uc744 \ub192\uc774\ub824\uba74 \ub2e4\uc74c\uacfc \uac19\uc740 \ubc29\ubc95\uc744 \uc2dc\ub3c4\ud574 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4: \u25a0\ub2e4\uc591\ud55c \ud65c\uacfc \ud654\uc0b4\uc758 \ud2b9\uc131\uc744 \uc219\uc9c0\ud558\uc138\uc694: \ud65c\uacfc \ud654\uc0b4\uc758 \uc0ac\uc815\uac70\ub9ac, \uc548\uc815\uc131 \ubc0f \ud798\uc740 \uac01\uae30 \ub2e4\ub985\ub2c8\ub2e4. \uc790\uc2e0\uc5d0\uac8c \uc801\ud569\ud55c \ud65c\uacfc \ud654\uc0b4\uc744 \uc120\ud0dd\ud558\ub294 \uac83\uc774 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 \ucd08\uc2ec\uc790 \ud65c\uc740 \uadfc\uac70\ub9ac \uc5f0\uc2b5\uc5d0 \uc801\ud569\ud558\uba70, \uc5c5\uadf8\ub808\uc774\ub4dc\ub41c \ud65c\uc740 \ub354 \uba3c \uac70\ub9ac\uc5d0\uc11c \uc815\ud655\ub3c4\ub97c \uc720\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \u25a0\ubc14\ub78c \ubc29\ud5a5\uacfc \uac70\ub9ac\ub97c \ud30c\uc545\ud558\uc138\uc694: \ud654\uba74\uc758 \ubc14\ub78c \ud45c\uc2dc\uae30\ub97c \uc8fc\uc758 \uae4a\uac8c \uc0b4\ud3b4\ubcf4\uace0, \ubaa9\ud45c \uac70\ub9ac\uc5d0 \ub530\ub77c \uc870\uc900\uc810\uc744 \uc870\uc808\ud558\uc138\uc694. \uc5f0\uc2b5\ud560 \ub54c\ub294 \uba3c\uc800 \uace0\uc815 \uac70\ub9ac\uc758 \ud45c\uc801\uc744 \uc2dc\ub3c4\ud558\uace0 \uc810\ucc28 \ub09c\uc774\ub3c4\ub97c \ub192\uc5ec\ubcf4\uc138\uc694. \u25a0\ub9ac\ub4ec\uac10\uc744 \uc5f0\uc2b5\ud558\uc138\uc694: \ud65c\uc744 \ub2f9\uae38 \ub54c \uc11c\ub458\ub7ec \ub193\uc9c0 \ub9d0\uace0 \uc801\uc808\ud55c \ub9ac\ub4ec\uac10\uc744 \ucc3e\uc73c\uba74 \uc548\uc815\uc131\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc65c \uc81c \ud65c\uc3d8\uae30 \uc6d4\ub4dc \ud22c\uc5b4 \uc810\uc218\uac00 \ub108\ubb34 \ub0ae\uc740\uac00\uc694? \ud65c\uc3d8\uae30 \uc6d4\ub4dc \ud22c\uc5b4 \uc810\uc218\ub97c \ub192\uc774\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694? \uc7a5\ube44\uc640 \uad00\ub828\uc774 \uc788\ub2e4\ub294 \uc598\uae30\ub97c \ub4e4\uc5c8\uc2b5\ub2c8\ub2e4.", "answer": "\ud65c\uc3d8\uae30 \uc6d4\ub4dc \ud22c\uc5b4 \uc810\uc218\ub294 \uc5ec\ub7ec \uc694\uc778\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc73c\uba70, \uc7a5\ube44\ub294 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc810\uc218\uac00 \ub0ae\uc740 \uc774\uc720\ub294 \ub2e4\uc74c\uacfc \uac19\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \u2460 \ud65c\uc758 \ub4f1\uae09\uc774 \ubd80\uc871\ud558\uc5ec \uc548\uc815\uc131\uc774 \ub5a8\uc5b4\uc838 \uba85\uc911\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \u2461 \ud654\uc0b4\uc758 \ud488\uc9c8\uc774 \ub0ae\uc544\uc11c \ud53c\ud574\ub7c9\uacfc \uad00\ud1b5\ub825\uc774 \ub5a8\uc5b4\uc9d1\ub2c8\ub2e4. \u2462 \uae30\uc220 \ub808\ubca8\uc774 \ub0ae\uc544\uc11c \ucd94\uac00\uc801\uc778 \ubcf4\ub108\uc2a4\ub97c \uc5bb\uc9c0 \ubabb\ud569\ub2c8\ub2e4. \uc810\uc218\ub97c \ub192\uc774\ub824\uba74 \ub2e4\uc74c\uacfc \uac19\uc740 \uba87 \uac00\uc9c0 \uce21\uba74\uc5d0\uc11c \ub178\ub825\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4: \u25a0\ud65c \uc5c5\uadf8\ub808\uc774\ub4dc: \ub808\ubca8\uc774 \ub192\uc740 \ud65c\uc740 \ub354 \ub6f0\uc5b4\ub09c \uc18d\uc131\uc744 \uac16\ucd94\uace0 \uc788\uc73c\ubbc0\ub85c \uba85\uc911\ub960\uacfc \ud53c\ud574\ub7c9\uc744 \ub192\uc774\ub294 \uae30\ubcf8\uc785\ub2c8\ub2e4. \u25a0\uc801\uc808\ud55c \ud654\uc0b4 \uc120\ud0dd: \uacbd\uae30 \uc0c1\ud669\uc5d0 \ub530\ub77c \ud574\ub2f9 \ud654\uc0b4\uc744 \uc120\ud0dd\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uad00\ud1b5 \ud654\uc0b4\uc740 \uc5ec\ub7ec \uac1c\uc758 \ud45c\uc801\uc744 \uad00\ud1b5\ud558\ub294 \ub370 \uc801\ud569\ud558\uace0, \ubd88 \ud654\uc0b4\uc740 \ud2b9\uc218 \ud65c\ub3d9\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4. \u25a0\uae30\uc220 \uac15\ud654: \uac8c\uc784\uc5d0\uc11c \uc5bb\uc740 \uae30\uc220 \ud3ec\uc778\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc5ec \uce90\ub9ad\ud130\uc758 \uac01 \ub2a5\ub825\uc744 \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc870\uc900 \uc18d\ub3c4\ub97c \ub192\uc774\uac70\ub098 \uce58\uba85\ud0c0 \ud655\ub960\uc744 \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc7a5\ube44 \ub300\uc870\ud45c: \uc608\ub97c \ub4e4\uc5b4, \ub300\uacb0 \ub300\ud68c\uc5d0\uc11c \uace0\ub4dd\uc810\uc744 \uc5bb\uc73c\ub824\uba74 S\uae09 \ud65c\uacfc \uad00\ud1b5 \ud654\uc0b4\uc744 \uc0ac\uc6a9\ud558\uace0, \uad00\ud1b5 \ubc0f \uce58\uba85\ud0c0 \uae30\uc220\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \ub808\ubca8\uc5c5\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4."}, {"question": "\ud65c\uc3d8\uae30 \uc6d4\ub4dc \ud22c\uc5b4 \ub2a5\uc219\ud55c \uc804\ub7b5: \ubcf5\uc7a1\ud55c \ud658\uacbd\uc5d0\uc11c \uc9c0\ud615\uacfc \ubc14\ub78c\uc744 \uc5b4\ub5bb\uac8c \ud65c\uc6a9\ud558\uc5ec \uba85\uc911\ub960\uc744 \ub192\uc77c \uc218 \uc788\ub098\uc694?", "answer": "\ud65c\uc3d8\uae30 \uc6d4\ub4dc \ud22c\uc5b4\uc758 \ud575\uc2ec\uc740 \ud658\uacbd \uc694\uc778\uc744 \ud30c\uc545\ud558\uace0 \ud65c\uc6a9\ud558\ub294 \ub370 \uc788\uc2b5\ub2c8\ub2e4. \ubcf5\uc7a1\ud55c \ud658\uacbd\uc5d0\uc11c \ubc14\ub78c\uacfc \uc9c0\ud615\uc740 \uc0ac\uaca9\uc5d0 \uc911\uc694\ud55c \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. STEP 1: \ubc14\ub78c \ubc29\ud5a5 \uad00\ucc30. \uac8c\uc784 \uc778\ud130\ud398\uc774\uc2a4\uc5d0\ub294 \ud604\uc7ac \ubc14\ub78c \ubc29\ud5a5\uacfc \uc138\uae30\uac00 \ud45c\uc2dc\ub429\ub2c8\ub2e4. \ubc14\ub78c \ubc29\ud5a5\uc5d0 \ub530\ub77c \uc870\uc900\uc810\uc744 \uc870\uc815\ud574\uc57c \ud569\ub2c8\ub2e4. \ubc14\ub78c\uc774 \ubd88 \ub54c\ub294 \uc870\uc900\uc810\uc744 \uc57d\uac04 \uc544\ub798\ub85c, \uc5ed\ud48d\uc77c \ub54c\ub294 \uc57d\uac04 \uc704\ub85c \uc870\uc815\ud574\uc57c \ud569\ub2c8\ub2e4. STEP 2: \uc9c0\ud615 \ud65c\uc6a9. \uc77c\ubd80 \uc7a5\uba74\uc5d0\uc11c\ub294 \uc9c0\ud615\uc744 \uc774\uc6a9\ud558\uc5ec \ubc14\ub78c\uc758 \uc601\ud5a5\uc744 \uc904\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud0d1 \uc704\uc5d0\uc11c \uc0ac\uaca9\ud560 \ub54c\ub294 \ud0d1\uc744 \uc774\uc6a9\ud558\uc5ec \ubc14\ub78c\uc758 \uc77c\ubd80 \uc601\ud5a5\uc744 \ucc28\ub2e8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP 3: \uc870\uc900 \ubbf8\uc138 \uc870\uc815. \uc0ac\uaca9 \uc804\uc5d0 \ubbf8\uc138 \uc870\uc815\uc744 \uc218\ud589\ud558\uace0 \ud654\uc0b4\uc758 \ube44\ud589 \uacbd\ub85c\ub97c \uad00\ucc30\ud558\uc5ec \uc2e4\uc81c \uc0c1\ud669\uc5d0 \ub530\ub77c \uc870\uc815\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ube44\uc720 \uc124\uba85: \uace8\ud504 \uc120\uc218\uac00 \uc794\ub514\uc640 \ubc14\ub78c\uc744 \uace0\ub824\ud574\uc57c \ud558\ub294 \uac83\ucc98\ub7fc, \ud65c\uc3d8\ub294 \uc0ac\ub78c\ub3c4 \ud658\uacbd \uc694\uc778\uc744 \ucda9\ubd84\ud788 \uace0\ub824\ud574\uc57c \ud569\ub2c8\ub2e4."}, {"question": "\ud65c\uc3d8\uae30 \uc6d4\ub4dc \ud22c\uc5b4 \uace8\ub4dc\uac00 \ubd80\uc871\ud558\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud560\uae4c\uc694? \uace8\ub4dc\ub97c \ube60\ub974\uac8c \uc5bb\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud65c\uc3d8\uae30 \uc6d4\ub4dc \ud22c\uc5b4\uc5d0\uc11c \uace8\ub4dc\ub294 \uc7a5\ube44 \uc5c5\uadf8\ub808\uc774\ub4dc, \uc544\uc774\ud15c \uad6c\ub9e4 \ub4f1 \uc911\uc694\ud55c \uac8c\uc784 \uc790\uc6d0\uc785\ub2c8\ub2e4. \uace8\ub4dc\uac00 \ubd80\uc871\ud558\uba74 \uac71\uc815\ud558\uc9c0 \ub9c8\uc138\uc694. \uace8\ub4dc\ub97c \ube60\ub974\uac8c \uc5bb\ub294 \ubc29\ubc95\uc740 \ub9ce\uc2b5\ub2c8\ub2e4. \u25a0\ub9e4\uc77c \ubbf8\uc158 \uc644\ub8cc: \ub9e4\uc77c \ubbf8\uc158\uc740 \ubcf4\uc0c1\uc774 \ud48d\uc871\ud558\uc5ec \uace8\ub4dc\ub97c \uc5bb\ub294 \uc8fc\uc694 \ucd9c\ucc98\uc785\ub2c8\ub2e4. \u25a0\uacbd\uae30 \ucc38\uc5ec: \ub2e4\uc591\ud55c \uacbd\uae30 \ud65c\ub3d9\uc5d0 \ucc38\uc5ec\ud558\uc5ec \uc21c\uc704\uc5d0 \ub530\ub77c \ubcf4\uc0c1\uc744 \ubc1b\uc73c\uc138\uc694. \u25a0\uad11\uace0 \uc2dc\uccad: \uac8c\uc784 \ub0b4\uc5d0\uc11c \uad11\uace0\ub97c \uc2dc\uccad\ud558\uc5ec \uace8\ub4dc\ub97c \uc5bb\uc744 \uc218 \uc788\ub294 \uae30\ud68c\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uae08\uc561\uc740 \ub9ce\uc9c0 \uc54a\uc9c0\ub9cc, \uc870\uae08\uc529 \ubaa8\uc73c\uba74 \ub9ce\uc544\uc9d1\ub2c8\ub2e4. \u25a0\uc5ec\ubd84 \uc7a5\ube44 \ud310\ub9e4: \ubc30\ub0ad\uc5d0 \uc5ec\ubd84\uc758 \uc800\ub808\ubca8 \uc7a5\ube44\uac00 \uc788\ub2e4\uba74 \ud310\ub9e4\ud558\uc5ec \uace8\ub4dc\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud750\ub984\ub3c4: \ub9e4\uc77c \ubbf8\uc158 -> \uacbd\uae30 \ud65c\ub3d9 -> \uad11\uace0 \uc2dc\uccad -> \uc7a5\ube44 \ud310\ub9e4. \uc5ec\ub7ec \ubc29\uc548 \ube44\uad50: \uc11c\ub85c \ub2e4\ub978 \uacbd\uae30\uc758 \ubcf4\uc0c1\uacfc \ub09c\uc774\ub3c4\ub97c \ube44\uad50\ud558\uc5ec \uc790\uc2e0\uc5d0\uac8c \ub9de\ub294 \uacbd\uae30\ub97c \uc120\ud0dd\ud558\uc138\uc694."}, {"question": "\ud65c\uc3d8\uae30 \uc6d4\ub4dc \ud22c\uc5b4\uc5d0\ub294 \ud65c \uc885\ub958\uac00 \ub9ce\uc2b5\ub2c8\ub2e4. \ucd08\uc2ec\uc790\uc5d0\uac8c \uc801\ud569\ud55c \ud65c\uc740 \ubb34\uc5c7\uc774\uba70, \uc7a5\ub2e8\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud65c\uc3d8\uae30 \uc6d4\ub4dc \ud22c\uc5b4\uc5d0\ub294 \uc11c\ub85c \ub2e4\ub978 \uc18d\uc131\uacfc \ud2b9\uc9d5\uc744 \uac00\uc9c4 \ub2e4\uc591\ud55c \ud65c\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ucd08\uc2ec\uc790\uc5d0\uac8c \uc801\ud569\ud55c \ud65c\uc744 \uc120\ud0dd\ud558\ub294 \uac83\uc740 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \ucd08\uc2ec\uc790\uc5d0\uac8c \uc801\ud569\ud55c \ud65c\uacfc \uc7a5\ub2e8\uc810\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. \u25a0\ucd08\uc2ec\uc790 \ud65c: \ucd08\uae30 \ud65c\ub85c, \uc0ac\uc6a9\ud558\uae30 \uc27d\uc9c0\ub9cc \uc18d\uc131\uc774 \ub0ae\uc544 \uadfc\uac70\ub9ac \uc5f0\uc2b5\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4. \u25a0\ub098\ubb34 \ud65c: \uace8\ub4dc\ub97c \ud1b5\ud574 \uad6c\ub9e4\ud560 \uc218 \uc788\uc73c\uba70, \ucd08\uc2ec\uc790 \ud65c\ubcf4\ub2e4 \uc18d\uc131\uc774 \uc57d\uac04 \ub192\uace0 \uc911\uac70\ub9ac \uc0ac\uaca9\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4. \u25a0\uac15\ucca0 \ud65c: \ud2b9\uc815 \ub808\ubca8\uc5d0 \ub3c4\ub2ec\ud574\uc57c \uc7a0\uae08 \ud574\uc81c\ub418\ub294 \uace0\uae09 \ud65c\ub85c, \uc18d\uc131\uc774 \ub192\uace0 \uc7a5\uac70\ub9ac \uc0ac\uaca9\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4. \uad6c\uc131 \ub300\uc870\ud45c: \ucd08\uc2ec\uc790 \ud65c(\uadfc\uac70\ub9ac, \uc0ac\uc6a9\ud558\uae30 \uc27d\ub2e4), \ub098\ubb34 \ud65c(\uc911\uac70\ub9ac, \uade0\ud615), \uac15\ucca0 \ud65c(\uc7a5\uac70\ub9ac, \ub192\uc740 \uc18d\uc131). \ube44\uc720 \uc124\uba85: \ucd08\uc2ec\uc790 \ud65c\uc740 \uc5f0\uc2b5\uc6a9 \uc790\uc804\uac70\uc640 \uac19\uc544 \uc870\uc791\ud558\uae30 \uc27d\uc9c0\ub9cc \uc18d\ub3c4\ub294 \ub290\ub9bd\ub2c8\ub2e4."}, {"question": "\ud65c\uc3d8\uae30 \uc6d4\ub4dc \ud22c\uc5b4\uc758 \ubb3c\ub9ac \uc5d4\uc9c4\uc740 \ud654\uc0b4\uc758 \uada4\uc801\uc5d0 \uc5b4\ub5bb\uac8c \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c? \uacf5\uae30 \uc800\ud56d\uacfc \uc911\ub825\uc758 \uacc4\uc0b0 \ubc29\uc2dd\uc744 \uc790\uc138\ud788 \ubd84\uc11d\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud65c\uc3d8\uae30 \uc6d4\ub4dc \ud22c\uc5b4\uc758 \ubb3c\ub9ac \uc5d4\uc9c4\uc740 \uc2e4\uc81c \ud65c\uc3d8\uae30 \uacfc\uc815\uc744 \ubaa8\ubc29\ud569\ub2c8\ub2e4. \uacf5\uae30 \uc800\ud56d\uacfc \uc911\ub825\uc740 \ud654\uc0b4\uc758 \uada4\uc801\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc8fc\uc694 \uc694\uc778\uc785\ub2c8\ub2e4. \uad6c\uccb4\uc801\uc778 \uacc4\uc0b0\uc2dd\uc740 \uacf5\uc2dd\uc801\uc73c\ub85c \uacf5\uac1c\ub418\uc9c0 \uc54a\uc558\uc9c0\ub9cc, \uac8c\uc784\uc758 \ud45c\ud604\uc744 \ud1b5\ud574 \ucd94\ub860\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \u25a0\uacf5\uae30 \uc800\ud56d: \ud654\uc0b4\uc740 \ube44\ud589 \uc911\uc5d0 \uacf5\uae30 \uc800\ud56d\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \uc800\ud56d \ud06c\uae30\ub294 \ud654\uc0b4\uc758 \uc18d\ub3c4\uc640 \ub2e8\uba74\uc801\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4. \uc18d\ub3c4\uac00 \ube60\ub974\uace0 \ub2e8\uba74\uc801\uc774 \ud074\uc218\ub85d \uc800\ud56d\uc774 \ucee4\uc9d1\ub2c8\ub2e4. \u25a0\uc911\ub825: \ud654\uc0b4\uc740 \uc911\ub825\uc758 \uc601\ud5a5\uc744 \ubc1b\uc544 \ud654\uc0b4\uc758 \ube44\ud589 \uada4\uc801\uc774 \ud3ec\ubb3c\uc120\uc774 \ub429\ub2c8\ub2e4. \uc911\ub825\uc758 \ud06c\uae30\ub294 \ud654\uc0b4\uc758 \uc9c8\ub7c9\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4. \uc2dc\uc2a4\ud15c \ubd84\uc11d: \uac8c\uc784\uc740 \uacf5\uae30 \uc800\ud56d\uacfc \uc911\ub825\uc744 \uc2dc\ubbac\ub808\uc774\uc158\ud558\uc5ec \uc0ac\uaca9 \uacfc\uc815\uc744 \ub354\uc6b1 \ud604\uc2e4\uc801\uc774\uace0 \ud765\ubbf8\ub86d\uac8c \ub9cc\ub4ed\ub2c8\ub2e4. \uad6c\uc131 \ub300\uc870\ud45c: \ud654\uc0b4\uc758 \ubb34\uac8c\uc640 \ubaa8\uc591\uc744 \uc870\uc815\ud558\uc5ec \uacf5\uae30 \uc800\ud56d\uacfc \uc911\ub825\uc758 \uc601\ud5a5\uc744 \ubcc0\uacbd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud65c\uc3d8\uae30 \uc6d4\ub4dc \ud22c\uc5b4\ub294 \uc5b4\ub5bb\uac8c \ub354 \uc815\ud655\ud55c \uc0ac\uaca9\uc744 \ud560 \uc218 \uc788\ub098\uc694? \uc228\uaca8\uc9c4 \ubcf4\uc870 \uc870\uc900 \uba54\ucee4\ub2c8\uc998\uc774 \uc874\uc7ac\ud558\ub098\uc694?", "answer": "\ud65c\uc3d8\uae30 \uc6d4\ub4dc \ud22c\uc5b4\uc758 \uc0ac\uaca9 \uc815\ud655\ub3c4\ub294 \uc8fc\ub85c \ud50c\ub808\uc774\uc5b4\uc758 \uc870\uc791\uacfc \uc7a5\ube44\uc5d0 \ub2ec\ub824 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784\uc5d0\ub294 \uba85\ud655\ud55c \ubcf4\uc870 \uc870\uc900 \uba54\ucee4\ub2c8\uc998\uc774 \uc5c6\uc9c0\ub9cc, \uc815\ud655\ub3c4\ub97c \ub192\uc774\uae30 \uc704\ud55c \uba87 \uac00\uc9c0 \ud301\uc774 \uc788\uc2b5\ub2c8\ub2e4. \u25a0\uc548\uc815\uc801\uc778 \uae30\uae30\ub97c \uc0ac\uc6a9\ud558\uc138\uc694: \uac00\ub2a5\ud55c \ud55c \uc548\uc815\uc801\uc778 \uae30\uae30\ub97c \uc0ac\uc6a9\ud558\uc5ec \uac8c\uc784\uc744 \ud558\uace0, \uae30\uae30\uc758 \ud754\ub4e4\ub9bc\uc774 \uc870\uc900\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\uc9c0 \uc54a\ub3c4\ub85d \ud558\uc138\uc694. \u25a0\ubbfc\uac10\ub3c4 \uc870\uc815: \uc790\uc2e0\uc758 \uc2b5\uad00\uc5d0 \ub9de\ucdb0 \ubbfc\uac10\ub3c4\ub97c \uc870\uc808\ud558\uc5ec \uc790\uc2e0\uc5d0\uac8c \uac00\uc7a5 \uc801\ud569\ud55c \uc124\uc815\uc744 \ucc3e\uc73c\uc138\uc694. \u25a0\ud638\ud761 \uc5f0\uc2b5: \uc2e4\uc81c \ud65c\uc3d8\uae30 \uacfc\uc815\uc744 \ubaa8\ubc29\ud558\uc5ec \ud65c\uc744 \ub2f9\uae30\uba74\uc11c \uc228\uc744 \ud06c\uac8c \uc26c\uace0, \ubab8\uc744 \uc774\uc644\ud558\uc5ec \uc548\uc815\uc131\uc744 \ub192\uc774\uc138\uc694. \uc5ec\ub7ec \ubc29\uc548 \ube44\uad50: \ub192\uc740 \ubbfc\uac10\ub3c4\ub294 \ube60\ub978 \uc870\uc900\uc5d0 \uc801\ud569\ud558\uace0, \ub0ae\uc740 \ubbfc\uac10\ub3c4\ub294 \uc138\ubc00\ud55c \uc870\uc815\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4. \ube44\uc720 \uc124\uba85: \uc800\uaca9\uc218\uac00 \uc228\uc744 \ucc38\uc544\uc57c \ud558\ub294 \uac83\ucc98\ub7fc, \ud65c\uc3d8\ub294 \uc0ac\ub78c\ub3c4 \uc548\uc815\ub41c \ud638\ud761\uc744 \uc720\uc9c0\ud558\uc5ec \uc815\ud655\ub3c4\ub97c \ub192\uc5ec\uc57c \ud569\ub2c8\ub2e4."}, {"question": "\ud65c\uc3d8\uae30 \uc6d4\ub4dc \ud22c\uc5b4 \ubcf4\uc0c1 \uc2dc\uc2a4\ud15c \uc2ec\uce35 \ubd84\uc11d: \ubcf4\uc0c1 \uc9c0\uae09\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc8fc\uc694 \uc694\uc778\uc740 \ubb34\uc5c7\uc774\uba70, \uc218\uc775\uc744 \uadf9\ub300\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud65c\uc3d8\uae30 \uc6d4\ub4dc \ud22c\uc5b4\uc758 \ubcf4\uc0c1 \uc9c0\uae09\uc740 \uc5ec\ub7ec \uc694\uc778\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \uc218\uc775\uc744 \uadf9\ub300\ud654\ud558\ub824\uba74 \ub2e4\uc74c\uacfc \uac19\uc740 \uc8fc\uc694 \uc694\uc778\uc744 \uc774\ud574\ud574\uc57c \ud569\ub2c8\ub2e4. \u25a0\uba85\uc911\ub960: \uba85\uc911\ub960\uc774 \ub192\uc744\uc218\ub85d \ubcf4\uc0c1\uc774 \ub192\uc2b5\ub2c8\ub2e4. \u25a0\uc5f0\uc18d \ub4dd\uc810: \ud45c\uc801\uc744 \uc5f0\uc18d\ud574\uc11c \uba85\uc911\ud558\uba74 \ucd94\uac00 \ubcf4\uc0c1\uc744 \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \u25a0\ud2b9\uc218 \ud45c\uc801: \uc774\ub3d9 \ud45c\uc801, \ud3ed\ubc1c \ud45c\uc801 \ub4f1 \ud2b9\uc218 \ud45c\uc801\uc744 \uba85\uc911\ud558\uba74 \ub354 \ub192\uc740 \ubcf4\uc0c1\uc744 \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc218\uc775\uc744 \uadf9\ub300\ud654\ud558\ub294 \ud301: STEP 1: \uc870\uc900 \uc5f0\uc2b5\uc744 \ud1b5\ud574 \uba85\uc911\ub960\uc744 \ub192\uc774\uc138\uc694. STEP 2: \uac00\ub2a5\ud55c \ud55c \uc5f0\uc18d\ud574\uc11c \ud45c\uc801\uc744 \uba85\uc911\ud558\uc5ec \uc5f0\uc18d \ub4dd\uc810\uc744 \uc720\uc9c0\ud558\uc138\uc694. STEP 3: \ud2b9\uc218 \ud45c\uc801\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uc0ac\uaca9\ud558\uc5ec \ucd94\uac00 \ubcf4\uc0c1\uc744 \ubc1b\uc73c\uc138\uc694. \ube44\uc720 \uc124\uba85: \ubaac\uc2a4\ud130 \uc0ac\ub0e5 \uac8c\uc784\uacfc \uac19\uc544\uc11c \uc5f0\uc18d \uc7a1\uc73c\uba74 \ub354 \ub9ce\uc740 \uacbd\ud5d8\uce58\ub97c \uc5bb\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4."}, {"question": "\ud65c\uc3d8\uae30 \uc6d4\ub4dc \ud22c\uc5b4\uc5d0 PC \ubc84\uc804\uc774 \uc788\ub098\uc694? \uc548\ub4dc\ub85c\uc774\ub4dc\uc640 iOS \ub370\uc774\ud130\ub97c \uc0c1\ud638 \uc5f0\uacb0\ud560 \uc218 \uc788\ub098\uc694? \ub2e4\ub978 \uae30\uae30\uc5d0\uc11c \uac8c\uc784\uc744 \ud558\uace0 \uc2f6\ub2e4\uba74 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \ub3d9\uae30\ud654\ud574\uc57c \ud558\ub098\uc694?", "answer": "\ud604\uc7ac \ud65c\uc3d8\uae30 \uc6d4\ub4dc \ud22c\uc5b4\ub294 \uc8fc\ub85c \ubaa8\ubc14\uc77c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ucd9c\uc2dc\ub418\uc5c8\uc73c\uba70, \uacf5\uc2dd\uc801\uc73c\ub85c PC \ubc84\uc804\uc740 \uc5c6\uc2b5\ub2c8\ub2e4. \ub370\uc774\ud130 \uc0c1\ud638 \uc5f0\uacb0: \uc77c\ubc18\uc801\uc73c\ub85c \uc548\ub4dc\ub85c\uc774\ub4dc\uc640 iOS \ubc84\uc804\uc758 \ub370\uc774\ud130\ub294 \uc0c1\ud638 \uc5f0\uacb0\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ud558\uc9c0\ub9cc, \uac8c\uc784\uc774 \uc678\ubd80 \uacc4\uc815(\uc608: Facebook, \uad6c\uae00 \ud50c\ub808\uc774) \ub85c\uadf8\uc778\uc744 \uc9c0\uc6d0\ud558\uace0 \ud074\ub77c\uc6b0\ub4dc \ub3d9\uae30\ud654 \uae30\ub2a5\uc744 \ud65c\uc131\ud654\ud55c \uacbd\uc6b0, \ub2e4\ub978 \uae30\uae30\uc5d0\uc11c \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub3d9\uae30\ud654 \ub2e8\uacc4: STEP 1: \uae30\uc874 \uae30\uae30\uc5d0\uc11c \uc678\ubd80 \uacc4\uc815\uc744 \uc5f0\uacb0\ud558\uace0 \ud074\ub77c\uc6b0\ub4dc \ub3d9\uae30\ud654\ub97c \ud65c\uc131\ud654\ud558\uc138\uc694. STEP 2: \uc0c8\ub85c\uc6b4 \uae30\uae30\uc5d0\uc11c \uac8c\uc784\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uace0 \ub3d9\uc77c\ud55c \uc678\ubd80 \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uc138\uc694. STEP 3: \uac8c\uc784\uc774 \ub370\uc774\ud130\ub97c \ub3d9\uae30\ud654\ud560 \ub54c\uae4c\uc9c0 \uae30\ub2e4\ub9ac\uc138\uc694. \uc77c\ubd80 \uac8c\uc784\uc740 \ud50c\ub7ab\ud3fc \uac04 \ub370\uc774\ud130 \ub3d9\uae30\ud654\ub97c \uc9c0\uc6d0\ud558\uc9c0 \uc54a\uc744 \uc218 \uc788\uc73c\ubbc0\ub85c, \uc790\uc138\ud55c \ub0b4\uc6a9\uc740 \uac8c\uc784 \ub0b4 \ub3c4\uc6c0\ub9d0 \ubb38\uc11c\ub098 \uace0\uac1d \uc13c\ud130\uc5d0 \ubb38\uc758\ud558\uc138\uc694."}, {"question": "\ud65c\uc3d8\uae30 \uc6d4\ub4dc \ud22c\uc5b4\uc758 \ube44\ubc00 \uc694\uc18c \ud0d0\uc0ac: \uac8c\uc784 \ub0b4\uc5d0 \ud2b9\ubcc4\ud55c \ud65c\uacfc \uc7a5\uba74\uc774 \uc228\uaca8\uc838 \uc788\ub2e4\uace0 \ub4e4\uc5c8\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ub0b4\uc6a9\uc744 \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\ub098\uc694? \uc608\ub97c \ub4e4\uc5b4, \"\uae08\uc0c9 \uae43\ud138 \ud65c\"\uc744 \ud574\uc81c\ud558\ub824\uba74 \uc5b4\ub5a4 \uc870\uac74\uc744 \ub9cc\uc871\ud574\uc57c \ud558\ub098\uc694?", "answer": "\ud65c\uc3d8\uae30 \uc6d4\ub4dc \ud22c\uc5b4\uc5d0\ub294 \ud2b9\ubcc4\ud55c \ud65c\uacfc \uc7a5\uba74\uc774 \uc228\uaca8\uc838 \uc788\uc73c\uba70, \ud2b9\uc815 \uc870\uac74\uc744 \ucda9\uc871\ud574\uc57c\ub9cc \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \"\uae08\uc0c9 \uae43\ud138 \ud65c\" \ud574\uc81c \uc870\uac74\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc5f0\uc18d 7\uc77c \ub9e4\uc77c \uac8c\uc784\uc5d0 \uc811\uc18d\ud558\uace0, \uc5b4\ub5a4 \ubaa8\ub4dc\uc5d0\uc11c\ub4e0 \ucd1d 10,000\uc810\uc744 \ud68d\ub4dd\ud574\uc57c \ud569\ub2c8\ub2e4. \uc228\uaca8\uc9c4 \ub0b4\uc6a9 \ubc1c\uacac \ubc29\ubc95: \u25a0\ud2b9\uc815 \uc5c5\uc801 \ub2ec\uc131: \uac8c\uc784\uc5d0\ub294 \ub9ce\uc740 \uc228\uaca8\uc9c4 \uc5c5\uc801\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc5c5\uc801\uc744 \ub2ec\uc131\ud558\uba74 \uc0c8\ub85c\uc6b4 \ucf58\ud150\uce20\ub97c \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \u25a0\ud2b9\uc815 \uc774\ubca4\ud2b8 \ubc1c\uc0dd: \uc77c\ubd80 \uc7a5\uba74\uc5d0\uc11c \ud2b9\uc218 \uc774\ubca4\ud2b8\uac00 \ubc1c\uc0dd\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc774\ubca4\ud2b8\ub97c \ubc1c\uc0dd\uc2dc\ud0a4\uba74 \uc0c8\ub85c\uc6b4 \ucf58\ud150\uce20\ub97c \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \u25a0\ud2b9\uc815 \uc2dc\uac04\ub300 \uc811\uc18d: \ud2b9\uc815 \uc2dc\uac04\uc5d0 \uac8c\uc784\uc5d0 \uc811\uc18d\ud558\uba74 \ud2b9\uc815 \uae30\uac04 \ud55c\uc815 \ud65c\uacfc \uc2a4\ud0a8 \ub4f1 \ud76c\uadc0 \ubcf4\uc0c1\uc744 \ud68d\ub4dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uad6c\uccb4\uc801\uc778 \uc608: \ud2b9\uc815 \uba85\uc808\uc5d0 \uac8c\uc784\uc5d0 \uc811\uc18d\ud558\uba74 \uba85\uc808 \ud55c\uc815 \ud65c\uacfc \uc2a4\ud0a8\uc744 \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ube44\uc720 \uc124\uba85: \ubcf4\ubb3c \ucc3e\uae30 \uac8c\uc784\uacfc \uac19\uc544\uc11c \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uc744 \ucc3e\uae30 \uc704\ud574 \ub178\ub825\ud574\uc57c \ud569\ub2c8\ub2e4."}]
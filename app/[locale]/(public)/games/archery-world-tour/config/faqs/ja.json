[{"question": "\u30a2\u30fc\u30c1\u30a7\u30ea\u30fc\u30ef\u30fc\u30eb\u30c9\u30c4\u30a2\u30fc\u3067\u7684\u3092\u3069\u3046\u72d9\u3046\uff1f \u65b0\u624b\u306f\u57fa\u672c\u64cd\u4f5c\u3092\u7d20\u65e9\u304f\u7fd2\u5f97\u3057\u3001\u547d\u4e2d\u7387\u3092\u4e0a\u3052\u308b\u306b\u306f\uff1f", "answer": "\u30a2\u30fc\u30c1\u30a7\u30ea\u30fc\u30ef\u30fc\u30eb\u30c9\u30c4\u30a2\u30fc\u306f\u521d\u5fc3\u8005\u3067\u3082\u96e3\u3057\u304f\u3042\u308a\u307e\u305b\u3093\uff01\u30b2\u30fc\u30e0\u306f\u4e00\u4eba\u79f0\u8996\u70b9\u3092\u63a1\u7528\u3057\u3066\u304a\u308a\u3001\u753b\u9762\u3092\u30b9\u30e9\u30a4\u30c9\u3057\u3066\u5f13\u77e2\u306e\u7167\u6e96\u65b9\u5411\u3092\u5236\u5fa1\u3057\u307e\u3059\u3002\u547d\u4e2d\u7387\u3092\u4e0a\u3052\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u65b9\u6cd5\u3092\u8a66\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u25a0\u3055\u307e\u3056\u307e\u306a\u5f13\u77e2\u306e\u7279\u5fb4\u3092\u7406\u89e3\u3059\u308b\uff1a\u5f13\u77e2\u306e\u5c04\u7a0b\u3001\u5b89\u5b9a\u6027\u3001\u305d\u3057\u3066\u529b\u306a\u3069\u306f\u305d\u308c\u305e\u308c\u7570\u306a\u308a\u307e\u3059\u3002\u81ea\u5206\u306b\u5408\u3063\u305f\u5f13\u77e2\u3092\u9078\u3076\u3053\u3068\u304c\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u521d\u671f\u306e\u5f13\u77e2\u306f\u8fd1\u8ddd\u96e2\u306e\u7df4\u7fd2\u306b\u9069\u3057\u3066\u304a\u308a\u3001\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3055\u308c\u305f\u5f13\u77e2\u306f\u3088\u308a\u9060\u3044\u8ddd\u96e2\u3067\u6b63\u78ba\u3055\u3092\u4fdd\u3066\u307e\u3059\u3002\u25a0\u98a8\u5411\u3068\u8ddd\u96e2\u3092\u628a\u63e1\u3059\u308b\uff1a\u753b\u9762\u4e0a\u306e\u98a8\u5411\u8a08\u306b\u6ce8\u610f\u3057\u3001\u76ee\u6a19\u306e\u8ddd\u96e2\u306b\u5fdc\u3058\u3066\u7167\u6e96\u70b9\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u7df4\u7fd2\u3059\u308b\u3068\u304d\u306f\u3001\u307e\u305a\u56fa\u5b9a\u8ddd\u96e2\u306e\u7684\u304b\u3089\u59cb\u3081\u3066\u3001\u5f90\u3005\u306b\u96e3\u6613\u5ea6\u3092\u9ad8\u3081\u3066\u304f\u3060\u3055\u3044\u3002\u25a0\u30ea\u30ba\u30e0\u611f\u3092\u990a\u3046\uff1a\u5f13\u3092\u5f15\u304f\u3068\u304d\u306f\u3001\u3059\u3050\u306b\u96e2\u3055\u306a\u3044\u3088\u3046\u306b\u3057\u3001\u9069\u5207\u306a\u30ea\u30ba\u30e0\u611f\u3092\u63b4\u3080\u3053\u3068\u3067\u5b89\u5b9a\u6027\u3092\u52b9\u679c\u7684\u306b\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30a2\u30fc\u30c1\u30a7\u30ea\u30fc\u30ef\u30fc\u30eb\u30c9\u30c4\u30a2\u30fc\u306e\u30b9\u30b3\u30a2\u304c\u4f4e\u3044\u306e\u306f\u306a\u305c\uff1f\u30a2\u30fc\u30c1\u30a7\u30ea\u30fc\u30ef\u30fc\u30eb\u30c9\u30c4\u30a2\u30fc\u306e\u30b9\u30b3\u30a2\u3092\u4e0a\u3052\u308b\u65b9\u6cd5\u306f\u3042\u308a\u307e\u3059\u304b\uff1f\u88c5\u5099\u304c\u95a2\u4fc2\u3057\u3066\u3044\u308b\u3068\u3044\u3046\u5642\u3092\u805e\u304d\u307e\u3057\u305f\u3002", "answer": "\u30a2\u30fc\u30c1\u30a7\u30ea\u30fc\u30ef\u30fc\u30eb\u30c9\u30c4\u30a2\u30fc\u306e\u30b9\u30b3\u30a2\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u8981\u7d20\u306b\u3088\u3063\u3066\u5f71\u97ff\u3092\u53d7\u3051\u307e\u3059\u3002\u88c5\u5099\u306f\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u30b9\u30b3\u30a2\u306e\u4f4e\u3055\u306f\u3001\u2460\u5f13\u77e2\u306e\u30ec\u30d9\u30eb\u304c\u4e0d\u8db3\u3057\u3066\u304a\u308a\u3001\u5b89\u5b9a\u6027\u304c\u60aa\u3044\u305f\u3081\u547d\u4e2d\u7387\u304c\u5f71\u97ff\u3092\u53d7\u3051\u3066\u3044\u308b\u2461\u77e2\u306e\u54c1\u8cea\u304c\u4f4e\u304f\u3001\u30c0\u30e1\u30fc\u30b8\u3084\u8cab\u901a\u529b\u304c\u4f4e\u4e0b\u3057\u3066\u3044\u308b\u2462\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u304c\u4f4e\u304f\u3001\u8ffd\u52a0\u306e\u30dc\u30fc\u30ca\u30b9\u3092\u7372\u5f97\u3067\u304d\u306a\u3044\u306a\u3069\u306e\u7406\u7531\u304c\u8003\u3048\u3089\u308c\u307e\u3059\u3002\u30b9\u30b3\u30a2\u3092\u4e0a\u3052\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u70b9\u306b\u6ce8\u610f\u3057\u307e\u3057\u3087\u3046\u3002\u25a0\u5f13\u77e2\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\uff1a\u3088\u308a\u9ad8\u3044\u30ec\u30d9\u30eb\u306e\u5f13\u77e2\u306f\u3001\u512a\u308c\u305f\u7279\u6027\u3092\u6301\u3061\u3001\u547d\u4e2d\u7387\u3068\u30c0\u30e1\u30fc\u30b8\u3092\u9ad8\u3081\u308b\u305f\u3081\u306b\u57fa\u672c\u3067\u3059\u3002\u25a0\u9069\u5207\u306a\u77e2\u3092\u9078\u3076\uff1a\u4f8b\u3048\u3070\u3001\u8cab\u901a\u77e2\u306f\u8907\u6570\u306e\u7684\u3092\u8cab\u901a\u3059\u308b\u306e\u306b\u9069\u3057\u3066\u304a\u308a\u3001\u708e\u77e2\u306f\u7279\u5225\u306a\u30a4\u30d9\u30f3\u30c8\u306b\u9069\u3057\u3066\u3044\u307e\u3059\u3002\u72b6\u6cc1\u306b\u5fdc\u3058\u3066\u9069\u5207\u306a\u77e2\u3092\u9078\u3073\u307e\u3057\u3087\u3046\u3002\u25a0\u30b9\u30ad\u30eb\u3092\u4e0a\u3052\u308b\uff1a\u30b2\u30fc\u30e0\u3067\u7372\u5f97\u3057\u305f\u30b9\u30ad\u30eb\u30dd\u30a4\u30f3\u30c8\u3092\u4f7f\u3063\u3066\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u80fd\u529b\u3092\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u7167\u6e96\u901f\u5ea6\u306e\u5411\u4e0a\u3001\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u7387\u306e\u5897\u52a0\u306a\u3069\u3067\u3059\u3002\u88c5\u5099\u306e\u7d44\u307f\u5408\u308f\u305b\u8868\uff1a\u4f8b\u3048\u3070\u3001\u30c1\u30e3\u30ec\u30f3\u30b8\u30e2\u30fc\u30c9\u3067\u9ad8\u5f97\u70b9\u3092\u72d9\u3046\u306a\u3089\u3001S\u30e9\u30f3\u30af\u306e\u5f13\u77e2\u306b\u8cab\u901a\u77e2\u3092\u7d44\u307f\u5408\u308f\u305b\u3001\u8cab\u901a\u3068\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u306e\u30b9\u30ad\u30eb\u3092\u512a\u5148\u7684\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3053\u3068\u3092\u304a\u52e7\u3081\u3057\u307e\u3059\u3002"}, {"question": "\u30a2\u30fc\u30c1\u30a7\u30ea\u30fc\u30ef\u30fc\u30eb\u30c9\u30c4\u30a2\u30fc\u306e\u653b\u7565\uff1a\u8907\u96d1\u306a\u74b0\u5883\u3067\u767e\u767a\u767e\u4e2d\u3067\u7684\u3092\u5c04\u629c\u304f\u306b\u306f\u3001\u5730\u5f62\u3068\u98a8\u5411\u3092\u3069\u306e\u3088\u3046\u306b\u6d3b\u7528\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30a2\u30fc\u30c1\u30a7\u30ea\u30fc\u30ef\u30fc\u30eb\u30c9\u30c4\u30a2\u30fc\u306e\u8155\u524d\u306f\u3001\u74b0\u5883\u8981\u56e0\u3092\u7406\u89e3\u3057\u3001\u5229\u7528\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u8907\u96d1\u306a\u74b0\u5883\u3067\u306f\u3001\u98a8\u5411\u3068\u5730\u5f62\u306f\u5c04\u6483\u306b\u5927\u304d\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002STEP 1\uff1a\u98a8\u5411\u3092\u89b3\u5bdf\u3059\u308b\u3002\u30b2\u30fc\u30e0\u753b\u9762\u306b\u306f\u73fe\u5728\u306e\u98a8\u5411\u3068\u98a8\u901f\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002\u98a8\u5411\u306b\u5408\u308f\u305b\u3066\u7167\u6e96\u70b9\u3092\u8abf\u6574\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u9806\u98a8\u306e\u5834\u5408\u306f\u7167\u6e96\u70b9\u3092\u5c11\u3057\u4e0b\u3052\u3001\u9006\u98a8\u306e\u5834\u5408\u306f\u5c11\u3057\u4e0a\u306b\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002STEP 2\uff1a\u5730\u5f62\u3092\u6d3b\u7528\u3059\u308b\u3002\u4e00\u90e8\u306e\u30b9\u30c6\u30fc\u30b8\u3067\u306f\u3001\u5730\u5f62\u3092\u63a9\u4f53\u3068\u3057\u3066\u5229\u7528\u3057\u3001\u98a8\u306e\u5f71\u97ff\u3092\u8efd\u6e1b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u9ad8\u5854\u3067\u5c04\u6483\u3059\u308b\u3068\u304d\u306f\u3001\u5854\u3067\u98a8\u529b\u3092\u4e00\u90e8\u906e\u65ad\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002STEP 3\uff1a\u7167\u6e96\u3092\u5fae\u8abf\u6574\u3059\u308b\u3002\u5c04\u6483\u3059\u308b\u524d\u306b\u5fae\u8abf\u6574\u3092\u884c\u3044\u3001\u77e2\u306e\u98db\u884c\u8ecc\u8de1\u3092\u89b3\u5bdf\u3057\u3001\u5b9f\u969b\u306e\u72b6\u6cc1\u306b\u5fdc\u3058\u3066\u8abf\u6574\u3057\u307e\u3059\u3002\u6bd4\u55a9\uff1a\u30b4\u30eb\u30d5\u9078\u624b\u304c\u829d\u751f\u3084\u98a8\u5411\u3092\u8003\u616e\u3059\u308b\u306e\u3068\u540c\u69d8\u306b\u3001\u5f13\u77e2\u4f7f\u3044\u3082\u74b0\u5883\u8981\u56e0\u3092\u5341\u5206\u306b\u8003\u616e\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30a2\u30fc\u30c1\u30a7\u30ea\u30fc\u30ef\u30fc\u30eb\u30c9\u30c4\u30a2\u30fc\u3067\u30b3\u30a4\u30f3\u304c\u8db3\u308a\u306a\u3044\u5834\u5408\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f\u30b3\u30a4\u30f3\u3092\u8fc5\u901f\u306b\u5165\u624b\u3059\u308b\u65b9\u6cd5\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30a2\u30fc\u30c1\u30a7\u30ea\u30fc\u30ef\u30fc\u30eb\u30c9\u30c4\u30a2\u30fc\u3067\u306f\u3001\u30b3\u30a4\u30f3\u306f\u8cb4\u91cd\u306a\u30b2\u30fc\u30e0\u8cc7\u6e90\u3067\u3042\u308a\u3001\u88c5\u5099\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3084\u30a2\u30a4\u30c6\u30e0\u306e\u8cfc\u5165\u306b\u4f7f\u7528\u3067\u304d\u307e\u3059\u3002\u30b3\u30a4\u30f3\u304c\u4e0d\u8db3\u3057\u3066\u3044\u308b\u5834\u5408\u3001\u5fc3\u914d\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002\u30b3\u30a4\u30f3\u3092\u8fc5\u901f\u306b\u5165\u624b\u3067\u304d\u308b\u65b9\u6cd5\u306f\u305f\u304f\u3055\u3093\u3042\u308a\u307e\u3059\u3002\u25a0\u30c7\u30a4\u30ea\u30fc\u30df\u30c3\u30b7\u30e7\u30f3\u3092\u5b8c\u4e86\u3059\u308b\uff1a\u30c7\u30a4\u30ea\u30fc\u30df\u30c3\u30b7\u30e7\u30f3\u306f\u5831\u916c\u304c\u8c4a\u5bcc\u3067\u3001\u30b3\u30a4\u30f3\u3092\u7372\u5f97\u3059\u308b\u4e3b\u306a\u65b9\u6cd5\u3067\u3059\u3002\u25a0\u30b3\u30f3\u30c6\u30b9\u30c8\u6d3b\u52d5\u306b\u53c2\u52a0\u3059\u308b\uff1a\u3055\u307e\u3056\u307e\u306a\u30b3\u30f3\u30c6\u30b9\u30c8\u6d3b\u52d5\u306b\u53c2\u52a0\u3057\u3001\u9806\u4f4d\u306b\u5fdc\u3058\u3066\u5831\u916c\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u25a0\u5e83\u544a\u3092\u898b\u308b\uff1a\u30b2\u30fc\u30e0\u5185\u3067\u306f\u3001\u5e83\u544a\u3092\u898b\u308c\u3070\u30b3\u30a4\u30f3\u3092\u7372\u5f97\u3067\u304d\u308b\u6a5f\u4f1a\u304c\u3042\u308a\u307e\u3059\u3002\u6570\u306f\u591a\u304f\u3042\u308a\u307e\u305b\u3093\u304c\u3001\u7a4d\u3082\u308a\u7a4d\u3082\u308c\u3070\u5927\u304d\u304f\u306a\u308a\u307e\u3059\u3002\u25a0\u4f59\u5270\u88c5\u5099\u3092\u58f2\u5374\u3059\u308b\uff1a\u30d0\u30c3\u30b0\u306b\u4f59\u5270\u306e\u4f4e\u30ec\u30d9\u30eb\u88c5\u5099\u304c\u3042\u308b\u5834\u5408\u306f\u3001\u58f2\u5374\u3057\u3066\u30b3\u30a4\u30f3\u306b\u5909\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u624b\u9806\u56f3\u89e3\uff1a\u30c7\u30a4\u30ea\u30fc\u30df\u30c3\u30b7\u30e7\u30f3\u2192\u30b3\u30f3\u30c6\u30b9\u30c8\u6d3b\u52d5\u2192\u5e83\u544a\u3092\u898b\u308b\u2192\u88c5\u5099\u3092\u58f2\u5374\u3059\u308b\u3002\u69d8\u3005\u306a\u9078\u629e\u80a2\u306e\u6bd4\u8f03\uff1a\u305d\u308c\u305e\u308c\u306e\u30b3\u30f3\u30c6\u30b9\u30c8\u306e\u5831\u916c\u3068\u96e3\u6613\u5ea6\u3092\u6bd4\u8f03\u3057\u3001\u81ea\u5206\u306b\u5408\u3063\u305f\u30b3\u30f3\u30c6\u30b9\u30c8\u3092\u9078\u3073\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u30a2\u30fc\u30c1\u30a7\u30ea\u30fc\u30ef\u30fc\u30eb\u30c9\u30c4\u30a2\u30fc\u306b\u306f\u591a\u304f\u306e\u5f13\u77e2\u306e\u7a2e\u985e\u304c\u3042\u308a\u307e\u3059\u304c\u3001\u521d\u5fc3\u8005\u306b\u304a\u3059\u3059\u3081\u306e\u5f13\u77e2\u3068\u305d\u306e\u9577\u6240\u3068\u77ed\u6240\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30a2\u30fc\u30c1\u30a7\u30ea\u30fc\u30ef\u30fc\u30eb\u30c9\u30c4\u30a2\u30fc\u3067\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u5f13\u77e2\u306f\u305d\u308c\u305e\u308c\u7570\u306a\u308b\u7279\u6027\u3068\u7279\u5fb4\u3092\u6301\u3061\u307e\u3059\u3002\u521d\u5fc3\u8005\u304c\u9069\u5207\u306a\u5f13\u77e2\u3092\u9078\u3076\u3053\u3068\u306f\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u3053\u3053\u3067\u306f\u3001\u521d\u5fc3\u8005\u306b\u304a\u3059\u3059\u3081\u306e\u5f13\u77e2\u3068\u305d\u306e\u9577\u6240\u3068\u77ed\u6240\u3092\u3044\u304f\u3064\u304b\u7d39\u4ecb\u3057\u307e\u3059\u3002\u25a0\u65b0\u624b\u5f13\uff1a\u3053\u308c\u306f\u521d\u671f\u306e\u5f13\u77e2\u3067\u3059\u3002\u4f7f\u3044\u3084\u3059\u304f\u3001\u9577\u6240\u306f\u521d\u5fc3\u8005\u3067\u3082\u6271\u3044\u3084\u3059\u3044\u3068\u3044\u3046\u70b9\u3067\u3059\u3002\u77ed\u6240\u306f\u5c5e\u6027\u304c\u4f4e\u3044\u306e\u3067\u3001\u8fd1\u8ddd\u96e2\u306e\u7df4\u7fd2\u306b\u9069\u3057\u3066\u3044\u307e\u3059\u3002\u25a0\u6728\u5f13\uff1a\u30b3\u30a4\u30f3\u3067\u624b\u306b\u5165\u308c\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u65b0\u624b\u5f13\u3088\u308a\u5c5e\u6027\u304c\u9ad8\u304f\u3001\u4e2d\u8ddd\u96e2\u5c04\u6483\u306b\u9069\u3057\u3066\u3044\u307e\u3059\u3002\u25a0\u92fc\u5f13\uff1a\u7279\u5b9a\u306e\u30ec\u30d9\u30eb\u306b\u9054\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u5c5e\u6027\u304c\u9ad8\u304f\u3001\u9060\u8ddd\u96e2\u5c04\u6483\u306b\u9069\u3057\u3066\u3044\u307e\u3059\u3002\u88c5\u5099\u7d44\u307f\u5408\u308f\u305b\u8868\uff1a\u65b0\u624b\u5f13\uff08\u8fd1\u8ddd\u96e2\u3001\u6271\u3044\u3084\u3059\u3044\uff09\u3001\u6728\u5f13\uff08\u4e2d\u8ddd\u96e2\u3001\u30d0\u30e9\u30f3\u30b9\uff09\u3001\u92fc\u5f13\uff08\u9060\u8ddd\u96e2\u3001\u9ad8\u5c5e\u6027\uff09\u3002\u6bd4\u55a9\uff1a\u65b0\u624b\u5f13\u306f\u7df4\u7fd2\u7528\u306e\u81ea\u8ee2\u8eca\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u64cd\u4f5c\u3057\u3084\u3059\u3044\u3067\u3059\u304c\u3001\u901f\u5ea6\u306f\u9045\u3044\u3067\u3059\u3002"}, {"question": "\u30a2\u30fc\u30c1\u30a7\u30ea\u30fc\u30ef\u30fc\u30eb\u30c9\u30c4\u30a2\u30fc\u306e\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u306f\u3001\u77e2\u306e\u8ecc\u8de1\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u3066\u3044\u307e\u3059\u304b\uff1f\u7a7a\u6c17\u62b5\u6297\u3068\u91cd\u529b\u306e\u8a08\u7b97\u65b9\u6cd5\u3092\u8a73\u7d30\u306b\u89e3\u6790\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30a2\u30fc\u30c1\u30a7\u30ea\u30fc\u30ef\u30fc\u30eb\u30c9\u30c4\u30a2\u30fc\u306e\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u306f\u3001\u5b9f\u969b\u306e\u5c04\u6483\u904e\u7a0b\u3092\u30b7\u30df\u30e5\u30ec\u30fc\u30c8\u3057\u3066\u3044\u307e\u3059\u3002\u7a7a\u6c17\u62b5\u6297\u3068\u91cd\u529b\u306f\u3001\u77e2\u306e\u8ecc\u8de1\u306b\u91cd\u8981\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u5177\u4f53\u7684\u306a\u8a08\u7b97\u5f0f\u306f\u516c\u5f0f\u306b\u306f\u516c\u958b\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u304c\u3001\u30b2\u30fc\u30e0\u306e\u52d5\u4f5c\u304b\u3089\u63a8\u6e2c\u3067\u304d\u307e\u3059\u3002\u25a0\u7a7a\u6c17\u62b5\u6297\uff1a\u77e2\u304c\u98db\u884c\u3059\u308b\u969b\u306b\u7a7a\u6c17\u62b5\u6297\u3092\u53d7\u3051\u307e\u3059\u3002\u62b5\u6297\u306e\u5927\u304d\u3055\u306f\u77e2\u306e\u901f\u5ea6\u3068\u65ad\u9762\u7a4d\u306b\u95a2\u9023\u3057\u307e\u3059\u3002\u901f\u5ea6\u304c\u901f\u304f\u3001\u65ad\u9762\u7a4d\u304c\u5927\u304d\u3044\u307b\u3069\u3001\u62b5\u6297\u306f\u5927\u304d\u304f\u306a\u308a\u307e\u3059\u3002\u25a0\u91cd\u529b\uff1a\u77e2\u306f\u91cd\u529b\u306e\u5f71\u97ff\u3092\u53d7\u3051\u3001\u77e2\u306e\u98db\u884c\u8ecc\u8de1\u306f\u653e\u7269\u7dda\u306b\u306a\u308a\u307e\u3059\u3002\u91cd\u529b\u306e\u5927\u304d\u3055\u306f\u77e2\u306e\u8cea\u91cf\u306b\u3088\u3063\u3066\u6c7a\u307e\u308a\u307e\u3059\u3002\u30b7\u30b9\u30c6\u30e0\u306e\u89e3\u6790\uff1a\u30b2\u30fc\u30e0\u3067\u306f\u7a7a\u6c17\u62b5\u6297\u3068\u91cd\u529b\u3092\u30b7\u30df\u30e5\u30ec\u30fc\u30c8\u3059\u308b\u3053\u3068\u3067\u3001\u5c04\u6483\u30d7\u30ed\u30bb\u30b9\u3092\u3088\u308a\u30ea\u30a2\u30eb\u3067\u8208\u5473\u6df1\u3044\u3082\u306e\u306b\u3057\u307e\u3059\u3002\u88c5\u5099\u306e\u7d44\u307f\u5408\u308f\u305b\u8868\uff1a\u77e2\u306e\u91cd\u3055\u3084\u5f62\u72b6\u3092\u8abf\u6574\u3059\u308b\u3053\u3068\u3067\u3001\u53d7\u3051\u308b\u7a7a\u6c17\u62b5\u6297\u3068\u91cd\u529b\u3092\u5909\u5316\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30a2\u30fc\u30c1\u30a7\u30ea\u30fc\u30ef\u30fc\u30eb\u30c9\u30c4\u30a2\u30fc\u3067\u3088\u308a\u6b63\u78ba\u306a\u5c04\u6483\u3092\u5b9f\u73fe\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f\u96a0\u3055\u308c\u305f\u88dc\u52a9\u7684\u306a\u7167\u6e96\u6a5f\u69cb\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30a2\u30fc\u30c1\u30a7\u30ea\u30fc\u30ef\u30fc\u30eb\u30c9\u30c4\u30a2\u30fc\u306e\u5c04\u6483\u7cbe\u5ea6\u3092\u4e0a\u3052\u308b\u3053\u3068\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u64cd\u4f5c\u3068\u88c5\u5099\u6b21\u7b2c\u3067\u3059\u3002\u30b2\u30fc\u30e0\u306b\u306f\u660e\u78ba\u306a\u88dc\u52a9\u7684\u306a\u7167\u6e96\u6a5f\u69cb\u306f\u3042\u308a\u307e\u305b\u3093\u304c\u3001\u7cbe\u5ea6\u3092\u4e0a\u3052\u308b\u305f\u3081\u306e\u3044\u304f\u3064\u304b\u306e\u30b3\u30c4\u304c\u3042\u308a\u307e\u3059\u3002\u25a0\u5b89\u5b9a\u3057\u305f\u30c7\u30d0\u30a4\u30b9\u3092\u4f7f\u7528\u3059\u308b\uff1a\u30b2\u30fc\u30e0\u3092\u884c\u3046\u969b\u306b\u3001\u30c7\u30d0\u30a4\u30b9\u304c\u63fa\u308c\u306a\u3044\u3088\u3046\u306b\u5b89\u5b9a\u3057\u305f\u74b0\u5883\u3067\u884c\u3046\u3088\u3046\u306b\u3057\u307e\u3057\u3087\u3046\u3002\u25a0\u611f\u5ea6\u3092\u8abf\u6574\u3059\u308b\uff1a\u81ea\u5206\u306e\u597d\u307f\u306b\u5408\u308f\u305b\u3066\u611f\u5ea6\u3092\u8abf\u6574\u3057\u3001\u6700\u9069\u306a\u8a2d\u5b9a\u3092\u898b\u3064\u3051\u3066\u304f\u3060\u3055\u3044\u3002\u25a0\u547c\u5438\u306e\u7df4\u7fd2\u3092\u3059\u308b\uff1a\u5b9f\u969b\u306e\u5c04\u6483\u3092\u6a21\u5023\u3057\u3066\u3001\u5f13\u3092\u5f15\u304f\u969b\u306b\u6df1\u547c\u5438\u3057\u3001\u4f53\u3092\u30ea\u30e9\u30c3\u30af\u30b9\u3059\u308b\u3053\u3068\u3067\u5b89\u5b9a\u6027\u3092\u9ad8\u3081\u307e\u3059\u3002\u69d8\u3005\u306a\u9078\u629e\u80a2\u306e\u6bd4\u8f03\uff1a\u9ad8\u611f\u5ea6\u306f\u7d20\u65e9\u3044\u7167\u6e96\u306b\u3001\u4f4e\u611f\u5ea6\u306f\u7d30\u304b\u3044\u8abf\u6574\u306b\u9069\u3057\u3066\u3044\u307e\u3059\u3002\u6bd4\u55a9\uff1a\u72d9\u6483\u5175\u304c\u606f\u3092\u6b62\u3081\u308b\u5fc5\u8981\u304c\u3042\u308b\u306e\u3068\u540c\u69d8\u306b\u3001\u5f13\u77e2\u4f7f\u3044\u3082\u7cbe\u5ea6\u3092\u9ad8\u3081\u308b\u305f\u3081\u306b\u547c\u5438\u306e\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u304c\u5fc5\u8981\u3067\u3059\u3002"}, {"question": "\u30a2\u30fc\u30c1\u30a7\u30ea\u30fc\u30ef\u30fc\u30eb\u30c9\u30c4\u30a2\u30fc\u306e\u5831\u916c\u30b7\u30b9\u30c6\u30e0\u3092\u6df1\u304f\u5206\u6790\uff1a\u5831\u916c\u306e\u8a08\u7b97\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u91cd\u8981\u306a\u8981\u7d20\u306f\u4f55\u3067\u3059\u304b\uff1f\u53ce\u76ca\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30a2\u30fc\u30c1\u30a7\u30ea\u30fc\u30ef\u30fc\u30eb\u30c9\u30c4\u30a2\u30fc\u306e\u5831\u916c\u8a08\u7b97\u306f\u3001\u8907\u6570\u306e\u8981\u7d20\u306b\u3088\u3063\u3066\u5f71\u97ff\u3092\u53d7\u3051\u307e\u3059\u3002\u53ce\u76ca\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u91cd\u8981\u306a\u8981\u7d20\u3092\u7406\u89e3\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u25a0\u547d\u4e2d\u7387\uff1a\u547d\u4e2d\u7387\u304c\u9ad8\u3044\u307b\u3069\u3001\u5831\u916c\u306f\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002\u25a0\u9023\u6483\u6570\uff1a\u76ee\u6a19\u3092\u9023\u7d9a\u3057\u3066\u547d\u4e2d\u3055\u305b\u308b\u3053\u3068\u3067\u3001\u8ffd\u52a0\u306e\u5831\u916c\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u25a0\u7279\u6b8a\u306a\u76ee\u6a19\uff1a\u79fb\u52d5\u5f0f\u6a19\u7684\u3084\u7206\u767a\u6a19\u7684\u306a\u3069\u3001\u7279\u6b8a\u306a\u76ee\u6a19\u3092\u5c04\u629c\u304f\u3053\u3068\u3067\u3001\u3088\u308a\u9ad8\u3044\u5831\u916c\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u53ce\u76ca\u3092\u6700\u5927\u5316\u3059\u308b\u30c6\u30af\u30cb\u30c3\u30af\uff1aSTEP 1\uff1a\u7167\u6e96\u306e\u7df4\u7fd2\u3092\u884c\u3044\u3001\u547d\u4e2d\u7387\u3092\u4e0a\u3052\u307e\u3059\u3002STEP 2\uff1a\u53ef\u80fd\u306a\u9650\u308a\u76ee\u6a19\u3092\u9023\u7d9a\u3057\u3066\u547d\u4e2d\u3055\u305b\u3066\u3001\u9023\u6483\u6570\u3092\u6301\u7d9a\u3055\u305b\u308b\u3002STEP 3\uff1a\u307e\u305a\u7279\u6b8a\u306a\u76ee\u6a19\u3092\u5c04\u6483\u3057\u3001\u8ffd\u52a0\u306e\u5831\u916c\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u6bd4\u55a9\uff1a\u72e9\u731f\u30b2\u30fc\u30e0\u306e\u3088\u3046\u306b\u3001\u9023\u6483\u3059\u308b\u3053\u3068\u3067\u3088\u308a\u9ad8\u3044\u7d4c\u9a13\u5024\u3092\u5f97\u3089\u308c\u307e\u3059\u3002"}, {"question": "\u30a2\u30fc\u30c1\u30a7\u30ea\u30fc\u30ef\u30fc\u30eb\u30c9\u30c4\u30a2\u30fc\u306fPC\u7248\u304c\u3042\u308a\u307e\u3059\u304b\uff1fAndroid\u3068iOS\u306e\u30c7\u30fc\u30bf\u306f\u4e92\u63db\u6027\u304c\u3042\u308a\u307e\u3059\u304b\uff1f\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u3067\u30d7\u30ec\u30a4\u3057\u305f\u3044\u5834\u5408\u306f\u3001\u3069\u306e\u3088\u3046\u306b\u9032\u6357\u72b6\u6cc1\u3092\u540c\u671f\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30a2\u30fc\u30c1\u30a7\u30ea\u30fc\u30ef\u30fc\u30eb\u30c9\u30c4\u30a2\u30fc\u306f\u3001\u4e3b\u306b\u30e2\u30d0\u30a4\u30eb\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u516c\u958b\u3055\u308c\u3066\u304a\u308a\u3001\u516c\u5f0f\u306b\u306fPC\u7248\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u30c7\u30fc\u30bf\u4e92\u63db\u6027\u306b\u3064\u3044\u3066\uff1a\u901a\u5e38\u3001Android\u3068iOS\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u306f\u30c7\u30fc\u30bf\u4e92\u63db\u6027\u304c\u3042\u308a\u307e\u305b\u3093\u3002\u3057\u304b\u3057\u3001\u30b2\u30fc\u30e0\u304cFacebook\u3084Google Play\u306a\u3069\u306e\u30b5\u30fc\u30c9\u30d1\u30fc\u30c6\u30a3\u30a2\u30ab\u30a6\u30f3\u30c8\u306e\u30ed\u30b0\u30a4\u30f3\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u304a\u308a\u3001\u30af\u30e9\u30a6\u30c9\u540c\u671f\u6a5f\u80fd\u304c\u6709\u52b9\u306b\u306a\u3063\u3066\u3044\u308b\u5834\u5408\u306f\u3001\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u3067\u30b2\u30fc\u30e0\u306e\u9032\u6357\u72b6\u6cc1\u3092\u540c\u671f\u3067\u304d\u307e\u3059\u3002\u540c\u671f\u624b\u9806\uff1aSTEP 1\uff1a\u5143\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u30b5\u30fc\u30c9\u30d1\u30fc\u30c6\u30a3\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3001\u30af\u30e9\u30a6\u30c9\u540c\u671f\u3092\u6709\u52b9\u306b\u3057\u307e\u3059\u3002STEP 2\uff1a\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u30b2\u30fc\u30e0\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3001\u540c\u3058\u30b5\u30fc\u30c9\u30d1\u30fc\u30c6\u30a3\u30a2\u30ab\u30a6\u30f3\u30c8\u3067\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002STEP 3\uff1a\u30b2\u30fc\u30e0\u30c7\u30fc\u30bf\u306e\u540c\u671f\u3092\u5f85\u3061\u307e\u3059\u3002\u4e00\u90e8\u306e\u30b2\u30fc\u30e0\u306f\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u306e\u30c7\u30fc\u30bf\u540c\u671f\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u306a\u3044\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u5177\u4f53\u7684\u306a\u72b6\u6cc1\u306b\u3064\u3044\u3066\u306f\u3001\u30b2\u30fc\u30e0\u5185\u306e\u30d8\u30eb\u30d7\u30c9\u30ad\u30e5\u30e1\u30f3\u30c8\u307e\u305f\u306f\u30ab\u30b9\u30bf\u30de\u30fc\u30b5\u30fc\u30d3\u30b9\u3092\u53c2\u7167\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30a2\u30fc\u30c1\u30a7\u30ea\u30fc\u30ef\u30fc\u30eb\u30c9\u30c4\u30a2\u30fc\u306e\u96a0\u3057\u8981\u7d20\u3092\u63a2\u6c42\uff1a\u30b2\u30fc\u30e0\u5185\u306b\u7279\u5225\u306a\u5f13\u77e2\u3084\u30b9\u30c6\u30fc\u30b8\u304c\u96a0\u3055\u308c\u3066\u3044\u308b\u3068\u805e\u3044\u305f\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u96a0\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u3069\u306e\u3088\u3046\u306b\u30c8\u30ea\u30ac\u30fc\u3067\u304d\u307e\u3059\u304b\uff1f\u4f8b\u3048\u3070\u3001\u300c\u91d1\u8272\u306e\u7fbd\u6839\u306e\u5f13\u300d\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u306b\u306f\u3001\u3069\u306e\u3088\u3046\u306a\u6761\u4ef6\u3092\u6e80\u305f\u3059\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30a2\u30fc\u30c1\u30a7\u30ea\u30fc\u30ef\u30fc\u30eb\u30c9\u30c4\u30a2\u30fc\u306b\u306f\u3001\u7279\u5225\u306a\u5f13\u77e2\u3084\u30b9\u30c6\u30fc\u30b8\u304c\u96a0\u308c\u3066\u304a\u308a\u3001\u7279\u5b9a\u306e\u6761\u4ef6\u3092\u6e80\u305f\u3059\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u91d1\u8272\u306e\u7fbd\u6839\u306e\u5f13\u300d\u306f\u4ee5\u4e0b\u306e\u6761\u4ef6\u3092\u6e80\u305f\u3059\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u25a0\u6bce\u65e57\u65e5\u9593\u9023\u7d9a\u3067\u30b2\u30fc\u30e0\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3001\u305d\u3057\u3066\u3001\u3044\u305a\u308c\u304b\u306e\u30e2\u30fc\u30c9\u306710,000\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u30c8\u30ea\u30ac\u30fc\u3059\u308b\u4ed6\u306e\u65b9\u6cd5\uff1a\u25a0\u7279\u5b9a\u306e\u6210\u5c31\u3092\u9054\u6210\u3059\u308b\uff1a\u30b2\u30fc\u30e0\u306b\u306f\u591a\u304f\u306e\u96a0\u3057\u6210\u5c31\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u6210\u5c31\u3092\u9054\u6210\u3059\u308b\u3053\u3068\u3067\u3001\u65b0\u3057\u3044\u30b3\u30f3\u30c6\u30f3\u30c4\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u25a0\u7279\u5b9a\u306e\u30a4\u30d9\u30f3\u30c8\u3092\u30c8\u30ea\u30ac\u30fc\u3059\u308b\uff1a\u7279\u5b9a\u306e\u30b9\u30c6\u30fc\u30b8\u3067\u898b\u3089\u308c\u308b\u7279\u5225\u306a\u30a4\u30d9\u30f3\u30c8\u304c\u3042\u308a\u307e\u3059\u3002\u30a4\u30d9\u30f3\u30c8\u3092\u767a\u751f\u3055\u305b\u308b\u3068\u3001\u65b0\u3057\u3044\u30b3\u30f3\u30c6\u30f3\u30c4\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u25a0\u7279\u5b9a\u306e\u6642\u9593\u5e2f\u306b\u30ed\u30b0\u30a4\u30f3\u3059\u308b\uff1a\u7279\u5225\u306a\u30a4\u30d9\u30f3\u30c8\u306f\u3001\u7279\u5b9a\u306e\u6642\u9593\u5e2f\u306b\u958b\u59cb\u3055\u308c\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306b\u53c2\u52a0\u3059\u308b\u3068\u3001\u5e0c\u5c11\u306a\u5831\u916c\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u5177\u4f53\u7684\u306a\u4f8b\uff1a\u7279\u5b9a\u306e\u795d\u65e5\u306b\u30b2\u30fc\u30e0\u306b\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3068\u3001\u795d\u796d\u9650\u5b9a\u306e\u5f13\u77e2\u3068\u30b9\u30ad\u30f3\u3092\u7372\u5f97\u3067\u304d\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u6bd4\u55a9\uff1a\u5b9d\u63a2\u3057\u30b2\u30fc\u30e0\u306e\u3088\u3046\u306b\u3001\u96a0\u3055\u308c\u305f\u5b9d\u3092\u898b\u3064\u3051\u308b\u305f\u3081\u306b\u306f\u3001\u6839\u6c17\u5f37\u304f\u63a2\u7d22\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}]
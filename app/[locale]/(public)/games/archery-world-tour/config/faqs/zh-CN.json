[{"question": "\u300a\u4e16\u754c\u7bad\u672f\u4e4b\u65c5\u300b\u5982\u4f55\u7784\u51c6\uff1f\u65b0\u624b\u5982\u4f55\u5feb\u901f\u638c\u63e1\u57fa\u672c\u64cd\u4f5c\uff0c\u63d0\u9ad8\u547d\u4e2d\u7387\uff1f", "answer": "\u300a\u4e16\u754c\u7bad\u672f\u4e4b\u65c5\u300b\u5165\u95e8\u5e76\u4e0d\u96be\uff01\u6e38\u620f\u91c7\u7528\u7b2c\u4e00\u4eba\u79f0\u89c6\u89d2\uff0c\u901a\u8fc7\u6ed1\u52a8\u5c4f\u5e55\u63a7\u5236\u5f13\u7bad\u7684\u7784\u51c6\u65b9\u5411\u3002\u65b0\u624b\u8981\u63d0\u5347\u547d\u4e2d\u7387\uff0c\u53ef\u4ee5\u5c1d\u8bd5\u4ee5\u4e0b\u65b9\u6cd5\uff1a\u25a0\u719f\u6089\u4e0d\u540c\u5f13\u7bad\u7684\u7279\u6027\uff1a\u5f13\u7bad\u7684\u5c04\u7a0b\u3001\u7a33\u5b9a\u6027\u548c\u529b\u91cf\u5404\u4e0d\u76f8\u540c\uff0c\u9009\u62e9\u9002\u5408\u81ea\u5df1\u7684\u5f13\u7bad\u975e\u5e38\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u521d\u59cb\u5f13\u7bad\u9002\u5408\u8fd1\u8ddd\u79bb\u7ec3\u4e60\uff0c\u800c\u5347\u7ea7\u540e\u7684\u5f13\u7bad\u53ef\u4ee5\u5728\u66f4\u8fdc\u7684\u8ddd\u79bb\u4fdd\u6301\u7cbe\u51c6\u3002\u25a0\u628a\u63e1\u98ce\u5411\u548c\u8ddd\u79bb\uff1a\u6ce8\u610f\u5c4f\u5e55\u4e0a\u7684\u98ce\u5411\u6807\uff0c\u5e76\u6839\u636e\u76ee\u6807\u8ddd\u79bb\u8c03\u6574\u7784\u51c6\u70b9\u3002\u7ec3\u4e60\u65f6\uff0c\u53ef\u4ee5\u5148\u5c1d\u8bd5\u56fa\u5b9a\u8ddd\u79bb\u7684\u9776\u5b50\uff0c\u9010\u6e10\u589e\u52a0\u96be\u5ea6\u3002\u25a0\u7ec3\u4e60\u8282\u594f\u611f\uff1a\u62c9\u5f13\u65f6\u4e0d\u8981\u6025\u4e8e\u677e\u624b\uff0c\u627e\u5230\u5408\u9002\u7684\u8282\u594f\u611f\u53ef\u4ee5\u6709\u6548\u63d0\u9ad8\u7a33\u5b9a\u6027\u3002"}, {"question": "\u6211\u7684\u300a\u4e16\u754c\u7bad\u672f\u4e4b\u65c5\u300b\u5f97\u5206\u4e3a\u4ec0\u4e48\u8fd9\u4e48\u4f4e\uff1f\u6709\u4ec0\u4e48\u63d0\u5347\u5206\u6570\u7684\u65b9\u6cd5\uff1f\u542c\u8bf4\u548c\u88c5\u5907\u6709\u5173\uff1f", "answer": "\u300a\u4e16\u754c\u7bad\u672f\u4e4b\u65c5\u300b\u7684\u5206\u6570\u53d7\u5230\u591a\u65b9\u9762\u56e0\u7d20\u7684\u5f71\u54cd\uff0c\u88c5\u5907\u786e\u5b9e\u81f3\u5173\u91cd\u8981\u3002\u4f60\u7684\u5f97\u5206\u4f4e\u53ef\u80fd\u56e0\u4e3a \u2460 \u5f13\u7bad\u7b49\u7ea7\u4e0d\u591f\uff0c\u5bfc\u81f4\u7a33\u5b9a\u6027\u5dee\uff0c\u5f71\u54cd\u547d\u4e2d\uff1b\u2461 \u7bad\u652f\u54c1\u8d28\u4e0d\u9ad8\uff0c\u964d\u4f4e\u4f24\u5bb3\u548c\u7a7f\u900f\u529b\uff1b\u2462 \u6280\u80fd\u7b49\u7ea7\u4f4e\uff0c\u65e0\u6cd5\u83b7\u5f97\u989d\u5916\u7684\u52a0\u6210\u3002\u63d0\u5347\u5206\u6570\u53ef\u4ee5\u4ece\u4ee5\u4e0b\u51e0\u4e2a\u65b9\u9762\u5165\u624b\uff1a\u25a0\u5347\u7ea7\u5f13\u7bad\uff1a\u66f4\u9ad8\u7b49\u7ea7\u7684\u5f13\u7bad\u62e5\u6709\u66f4\u51fa\u8272\u7684\u5c5e\u6027\uff0c\u662f\u63d0\u5347\u547d\u4e2d\u7387\u548c\u4f24\u5bb3\u7684\u57fa\u7840\u3002\u25a0\u9009\u62e9\u5408\u9002\u7684\u7bad\u652f\uff1a\u6839\u636e\u6bd4\u8d5b\u573a\u666f\u9009\u62e9\u5bf9\u5e94\u7684\u7bad\u652f\uff0c\u4f8b\u5982\uff0c\u7a7f\u900f\u7bad\u9002\u5408\u7a7f\u900f\u591a\u4e2a\u76ee\u6807\uff0c\u706b\u7130\u7bad\u9002\u5408\u7279\u6b8a\u6d3b\u52a8\u3002\u25a0\u63d0\u5347\u6280\u80fd\uff1a\u901a\u8fc7\u6e38\u620f\u83b7\u5f97\u7684\u6280\u80fd\u70b9\u53ef\u4ee5\u63d0\u5347\u89d2\u8272\u7684\u5404\u9879\u80fd\u529b\uff0c\u4f8b\u5982\uff0c\u63d0\u5347\u7784\u51c6\u901f\u5ea6\u3001\u589e\u52a0\u66b4\u51fb\u7387\u7b49\u3002\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u4f8b\u5982\uff0c\u60f3\u8981\u5728\u6311\u6218\u8d5b\u4e2d\u83b7\u5f97\u9ad8\u5206\uff0c\u63a8\u8350\u4f7f\u7528S\u7ea7\u5f13\u7bad\u642d\u914d\u7a7f\u900f\u7bad\uff0c\u5e76\u4f18\u5148\u5347\u7ea7\u7a7f\u900f\u548c\u66b4\u51fb\u6280\u80fd\u3002"}, {"question": "\u300a\u4e16\u754c\u7bad\u672f\u4e4b\u65c5\u300b\u8fdb\u9636\u653b\u7565\uff1a\u5982\u4f55\u5229\u7528\u5730\u5f62\u548c\u98ce\u5411\uff0c\u5728\u590d\u6742\u73af\u5883\u4e0b\u767e\u53d1\u767e\u4e2d\uff1f", "answer": "\u300a\u4e16\u754c\u7bad\u672f\u4e4b\u65c5\u300b\u7684\u7cbe\u9ad3\u5728\u4e8e\u638c\u63e1\u73af\u5883\u56e0\u7d20\u5e76\u52a0\u4ee5\u5229\u7528\u3002\u5728\u590d\u6742\u73af\u5883\u4e2d\uff0c\u98ce\u5411\u548c\u5730\u5f62\u662f\u5f71\u54cd\u5c04\u7bad\u7684\u5173\u952e\u56e0\u7d20\u3002\u6b65\u9aa4 1\uff1a\u89c2\u5bdf\u98ce\u5411\u3002\u6e38\u620f\u754c\u9762\u4f1a\u663e\u793a\u5f53\u524d\u7684\u98ce\u5411\u548c\u98ce\u529b\uff0c\u9700\u8981\u6839\u636e\u98ce\u5411\u8c03\u6574\u7784\u51c6\u70b9\uff0c\u987a\u98ce\u65f6\u7784\u51c6\u70b9\u7565\u5fae\u504f\u4f4e\uff0c\u9006\u98ce\u65f6\u7784\u51c6\u70b9\u7565\u5fae\u504f\u9ad8\u3002\u6b65\u9aa4 2\uff1a\u5229\u7528\u5730\u5f62\u3002\u6709\u4e9b\u573a\u666f\u4e2d\uff0c\u53ef\u4ee5\u5229\u7528\u5730\u5f62\u4f5c\u4e3a\u63a9\u4f53\uff0c\u51cf\u5c11\u98ce\u7684\u5f71\u54cd\u3002\u4f8b\u5982\uff0c\u5728\u9ad8\u5854\u4e0a\u5c04\u51fb\uff0c\u53ef\u4ee5\u5229\u7528\u5854\u8eab\u906e\u6321\u90e8\u5206\u98ce\u529b\u3002\u6b65\u9aa4 3\uff1a\u5fae\u8c03\u7784\u51c6\u3002\u5728\u5c04\u51fb\u524d\uff0c\u53ef\u4ee5\u8fdb\u884c\u5fae\u8c03\uff0c\u89c2\u5bdf\u7bad\u7684\u98de\u884c\u8f68\u8ff9\uff0c\u5e76\u6839\u636e\u5b9e\u9645\u60c5\u51b5\u8fdb\u884c\u8c03\u6574\u3002\u7c7b\u6bd4\u8bf4\u660e\uff1a\u5c31\u50cf\u9ad8\u5c14\u592b\u7403\u624b\u9700\u8981\u8003\u8651\u8349\u5730\u548c\u98ce\u5411\u4e00\u6837\uff0c\u5f13\u7bad\u624b\u4e5f\u9700\u8981\u5145\u5206\u8003\u8651\u73af\u5883\u56e0\u7d20\u3002"}, {"question": "\u300a\u4e16\u754c\u7bad\u672f\u4e4b\u65c5\u300b\u91d1\u5e01\u4e0d\u591f\u7528\u600e\u4e48\u529e\uff1f\u5feb\u901f\u83b7\u53d6\u91d1\u5e01\u7684\u9014\u5f84\u6709\u54ea\u4e9b\uff1f", "answer": "\u300a\u4e16\u754c\u7bad\u672f\u4e4b\u65c5\u300b\u4e2d\u91d1\u5e01\u662f\u91cd\u8981\u7684\u6e38\u620f\u8d44\u6e90\uff0c\u53ef\u4ee5\u7528\u4e8e\u5347\u7ea7\u88c5\u5907\u3001\u8d2d\u4e70\u9053\u5177\u7b49\u3002\u5982\u679c\u91d1\u5e01\u4e0d\u591f\u7528\uff0c\u4e0d\u7528\u62c5\u5fc3\uff0c\u6709\u5f88\u591a\u9014\u5f84\u53ef\u4ee5\u5feb\u901f\u83b7\u53d6\uff1a\u25a0\u5b8c\u6210\u6bcf\u65e5\u4efb\u52a1\uff1a\u6bcf\u65e5\u4efb\u52a1\u5956\u52b1\u4e30\u539a\uff0c\u662f\u83b7\u53d6\u91d1\u5e01\u7684\u4e3b\u8981\u6765\u6e90\u3002\u25a0\u53c2\u4e0e\u6bd4\u8d5b\u6d3b\u52a8\uff1a\u53c2\u52a0\u5404\u79cd\u6bd4\u8d5b\u6d3b\u52a8\uff0c\u6839\u636e\u6392\u540d\u83b7\u5f97\u76f8\u5e94\u7684\u5956\u52b1\u3002\u25a0\u89c2\u770b\u5e7f\u544a\uff1a\u6e38\u620f\u5185\u4f1a\u6709\u89c2\u770b\u5e7f\u544a\u83b7\u5f97\u91d1\u5e01\u7684\u673a\u4f1a\uff0c\u867d\u7136\u6570\u91cf\u4e0d\u591a\uff0c\u4f46\u79ef\u5c11\u6210\u591a\u3002\u25a0\u51fa\u552e\u591a\u4f59\u7684\u88c5\u5907\uff1a\u5982\u679c\u80cc\u5305\u91cc\u6709\u591a\u4f59\u7684\u4f4e\u7b49\u7ea7\u88c5\u5907\uff0c\u53ef\u4ee5\u51fa\u552e\u6362\u53d6\u91d1\u5e01\u3002\u6d41\u7a0b\u56fe\u89e3\uff1a\u6bcf\u65e5\u4efb\u52a1 -> \u6bd4\u8d5b\u6d3b\u52a8 -> \u89c2\u770b\u5e7f\u544a -> \u51fa\u552e\u88c5\u5907\u3002\u591a\u79cd\u65b9\u6848\u5bf9\u6bd4\uff1a\u5bf9\u6bd4\u4e0d\u540c\u6bd4\u8d5b\u7684\u5956\u52b1\u548c\u96be\u5ea6\uff0c\u9009\u62e9\u9002\u5408\u81ea\u5df1\u7684\u6bd4\u8d5b\u3002"}, {"question": "\u300a\u4e16\u754c\u7bad\u672f\u4e4b\u65c5\u300b\u5f13\u7bad\u79cd\u7c7b\u7e41\u591a\uff0c\u54ea\u4e9b\u5f13\u7bad\u9002\u5408\u65b0\u624b\u4f7f\u7528\uff1f\u5b83\u4eec\u7684\u4f18\u7f3a\u70b9\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u4e16\u754c\u7bad\u672f\u4e4b\u65c5\u300b\u4e2d\u4e0d\u540c\u5f13\u7bad\u5177\u6709\u4e0d\u540c\u7684\u5c5e\u6027\u548c\u7279\u70b9\uff0c\u9009\u62e9\u5408\u9002\u7684\u5f13\u7bad\u5bf9\u4e8e\u65b0\u624b\u6765\u8bf4\u81f3\u5173\u91cd\u8981\u3002\u4ee5\u4e0b\u662f\u4e00\u4e9b\u9002\u5408\u65b0\u624b\u4f7f\u7528\u7684\u5f13\u7bad\u53ca\u5176\u4f18\u7f3a\u70b9\uff1a\u25a0\u65b0\u624b\u5f13\uff1a\u8fd9\u662f\u521d\u59cb\u5f13\u7bad\uff0c\u4f18\u70b9\u662f\u5bb9\u6613\u4e0a\u624b\uff0c\u7f3a\u70b9\u662f\u5c5e\u6027\u8f83\u4f4e\uff0c\u9002\u5408\u8fd1\u8ddd\u79bb\u7ec3\u4e60\u3002\u25a0\u6728\u5f13\uff1a\u53ef\u4ee5\u901a\u8fc7\u91d1\u5e01\u8d2d\u4e70\uff0c\u5c5e\u6027\u6bd4\u65b0\u624b\u5f13\u7565\u9ad8\uff0c\u9002\u5408\u4e2d\u8ddd\u79bb\u5c04\u51fb\u3002\u25a0\u94a2\u5f13\uff1a\u9700\u8981\u8fbe\u5230\u4e00\u5b9a\u7b49\u7ea7\u624d\u80fd\u89e3\u9501\uff0c\u5c5e\u6027\u8f83\u9ad8\uff0c\u9002\u5408\u8fdc\u8ddd\u79bb\u5c04\u51fb\u3002\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u65b0\u624b\u5f13\uff08\u8fd1\u8ddd\u79bb\uff0c\u6613\u4e0a\u624b\uff09\uff0c\u6728\u5f13\uff08\u4e2d\u8ddd\u79bb\uff0c\u5e73\u8861\uff09\uff0c\u94a2\u5f13\uff08\u8fdc\u8ddd\u79bb\uff0c\u9ad8\u5c5e\u6027\uff09\u3002\u7c7b\u6bd4\u8bf4\u660e\uff1a\u65b0\u624b\u5f13\u5c31\u50cf\u7ec3\u4e60\u7528\u7684\u81ea\u884c\u8f66\uff0c\u5bb9\u6613\u64cd\u63a7\uff0c\u4f46\u901f\u5ea6\u8f83\u6162\u3002"}, {"question": "\u300a\u4e16\u754c\u7bad\u672f\u4e4b\u65c5\u300b\u7684\u7269\u7406\u5f15\u64ce\u662f\u5982\u4f55\u5f71\u54cd\u7bad\u77e2\u8f68\u8ff9\u7684\uff1f\u80fd\u5426\u8be6\u7ec6\u89e3\u6790\u5176\u7a7a\u6c14\u963b\u529b\u4e0e\u91cd\u529b\u7684\u8ba1\u7b97\u65b9\u5f0f\uff1f", "answer": "\u300a\u4e16\u754c\u7bad\u672f\u4e4b\u65c5\u300b\u7684\u7269\u7406\u5f15\u64ce\u6a21\u62df\u4e86\u771f\u5b9e\u7684\u5c04\u7bad\u8fc7\u7a0b\uff0c\u7a7a\u6c14\u963b\u529b\u548c\u91cd\u529b\u662f\u5f71\u54cd\u7bad\u77e2\u8f68\u8ff9\u7684\u5173\u952e\u56e0\u7d20\u3002\u867d\u7136\u5177\u4f53\u7684\u8ba1\u7b97\u516c\u5f0f\u5b98\u65b9\u6ca1\u6709\u516c\u5f00\uff0c\u4f46\u6211\u4eec\u53ef\u4ee5\u4ece\u6e38\u620f\u8868\u73b0\u63a8\u65ad\uff1a\u25a0\u7a7a\u6c14\u963b\u529b\uff1a\u7bad\u77e2\u5728\u98de\u884c\u8fc7\u7a0b\u4e2d\u4f1a\u53d7\u5230\u7a7a\u6c14\u963b\u529b\u7684\u5f71\u54cd\uff0c\u963b\u529b\u5927\u5c0f\u4e0e\u7bad\u77e2\u7684\u901f\u5ea6\u548c\u6a2a\u622a\u9762\u79ef\u6709\u5173\u3002\u901f\u5ea6\u8d8a\u5feb\uff0c\u6a2a\u622a\u9762\u79ef\u8d8a\u5927\uff0c\u53d7\u5230\u7684\u963b\u529b\u8d8a\u5927\u3002\u25a0\u91cd\u529b\uff1a\u7bad\u77e2\u4f1a\u53d7\u5230\u91cd\u529b\u7684\u5f71\u54cd\uff0c\u5bfc\u81f4\u7bad\u77e2\u7684\u98de\u884c\u8f68\u8ff9\u5448\u629b\u7269\u7ebf\u3002\u91cd\u529b\u7684\u5927\u5c0f\u53d6\u51b3\u4e8e\u7bad\u77e2\u7684\u8d28\u91cf\u3002\u7cfb\u7edf\u5206\u6790\uff1a\u6e38\u620f\u901a\u8fc7\u6a21\u62df\u7a7a\u6c14\u963b\u529b\u548c\u91cd\u529b\uff0c\u4f7f\u5f97\u5c04\u7bad\u8fc7\u7a0b\u66f4\u52a0\u771f\u5b9e\u6709\u8da3\u3002\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u53ef\u4ee5\u901a\u8fc7\u8c03\u6574\u7bad\u77e2\u7684\u91cd\u91cf\u548c\u5f62\u72b6\u6765\u6539\u53d8\u5176\u53d7\u5230\u7684\u7a7a\u6c14\u963b\u529b\u548c\u91cd\u529b\u3002"}, {"question": "\u300a\u4e16\u754c\u7bad\u672f\u4e4b\u65c5\u300b\u5982\u4f55\u5b9e\u73b0\u66f4\u9ad8\u7cbe\u5ea6\u7684\u5c04\u51fb\uff1f\u662f\u5426\u5b58\u5728\u9690\u85cf\u7684\u8f85\u52a9\u7784\u51c6\u673a\u5236\uff1f", "answer": "\u300a\u4e16\u754c\u7bad\u672f\u4e4b\u65c5\u300b\u7684\u5c04\u51fb\u7cbe\u5ea6\u4e3b\u8981\u53d6\u51b3\u4e8e\u73a9\u5bb6\u7684\u64cd\u4f5c\u548c\u88c5\u5907\u3002\u6e38\u620f\u4e2d\u5e76\u6ca1\u6709\u660e\u786e\u7684\u8f85\u52a9\u7784\u51c6\u673a\u5236\uff0c\u4f46\u53ef\u4ee5\u901a\u8fc7\u4e00\u4e9b\u6280\u5de7\u6765\u63d0\u9ad8\u7cbe\u5ea6: \u25a0\u4f7f\u7528\u7a33\u5b9a\u7684\u8bbe\u5907\uff1a\u5c3d\u91cf\u4f7f\u7528\u7a33\u5b9a\u7684\u8bbe\u5907\u8fdb\u884c\u6e38\u620f\uff0c\u907f\u514d\u8bbe\u5907\u6643\u52a8\u5f71\u54cd\u7784\u51c6\u3002\u25a0\u8c03\u6574\u7075\u654f\u5ea6\uff1a\u6839\u636e\u81ea\u5df1\u7684\u4e60\u60ef\u8c03\u6574\u7075\u654f\u5ea6\uff0c\u627e\u5230\u6700\u9002\u5408\u81ea\u5df1\u7684\u8bbe\u7f6e\u3002\u25a0\u7ec3\u4e60\u547c\u5438\uff1a\u6a21\u62df\u771f\u5b9e\u7684\u5c04\u7bad\u8fc7\u7a0b\uff0c\u5728\u62c9\u5f13\u65f6\u6df1\u547c\u5438\uff0c\u653e\u677e\u8eab\u4f53\uff0c\u63d0\u9ad8\u7a33\u5b9a\u6027\u3002\u591a\u79cd\u65b9\u6848\u5bf9\u6bd4\uff1a\u9ad8\u7075\u654f\u5ea6\u9002\u5408\u5feb\u901f\u7784\u51c6\uff0c\u4f4e\u7075\u654f\u5ea6\u9002\u5408\u7cbe\u7ec6\u8c03\u6574\u3002\u7c7b\u6bd4\u8bf4\u660e\uff1a\u5c31\u50cf\u72d9\u51fb\u624b\u9700\u8981\u5c4f\u4f4f\u547c\u5438\u4e00\u6837\uff0c\u5f13\u7bad\u624b\u4e5f\u9700\u8981\u63a7\u5236\u547c\u5438\u6765\u63d0\u9ad8\u7cbe\u5ea6\u3002"}, {"question": "\u300a\u4e16\u754c\u7bad\u672f\u4e4b\u65c5\u300b\u5956\u52b1\u673a\u5236\u6df1\u5ea6\u5256\u6790\uff1a\u5f71\u54cd\u5956\u52b1\u7ed3\u7b97\u7684\u5173\u952e\u56e0\u7d20\u6709\u54ea\u4e9b\uff1f\u5982\u4f55\u6700\u5927\u5316\u6536\u76ca\uff1f", "answer": "\u300a\u4e16\u754c\u7bad\u672f\u4e4b\u65c5\u300b\u7684\u5956\u52b1\u7ed3\u7b97\u53d7\u5230\u591a\u79cd\u56e0\u7d20\u7684\u5f71\u54cd\uff0c\u60f3\u8981\u6700\u5927\u5316\u6536\u76ca\uff0c\u9700\u8981\u4e86\u89e3\u4ee5\u4e0b\u5173\u952e\u56e0\u7d20\uff1a\u25a0\u547d\u4e2d\u7387\uff1a\u547d\u4e2d\u7387\u8d8a\u9ad8\uff0c\u5956\u52b1\u8d8a\u9ad8\u3002\u25a0\u8fde\u51fb\u6570\uff1a\u8fde\u7eed\u547d\u4e2d\u76ee\u6807\u53ef\u4ee5\u83b7\u5f97\u989d\u5916\u7684\u5956\u52b1\u3002\u25a0\u7279\u6b8a\u76ee\u6807\uff1a\u5c04\u4e2d\u7279\u6b8a\u76ee\u6807\uff08\u4f8b\u5982\uff0c\u79fb\u52a8\u9776\u3001\u7206\u70b8\u9776\uff09\u53ef\u4ee5\u83b7\u5f97\u66f4\u9ad8\u7684\u5956\u52b1\u3002\u6700\u5927\u5316\u6536\u76ca\u7684\u6280\u5de7: \u6b65\u9aa4 1\uff1a\u7ec3\u4e60\u7784\u51c6\uff0c\u63d0\u9ad8\u547d\u4e2d\u7387\u3002\u6b65\u9aa4 2\uff1a\u5c3d\u91cf\u8fde\u7eed\u547d\u4e2d\u76ee\u6807\uff0c\u4fdd\u6301\u8fde\u51fb\u6570\u3002\u6b65\u9aa4 3\uff1a\u4f18\u5148\u5c04\u51fb\u7279\u6b8a\u76ee\u6807\uff0c\u83b7\u53d6\u989d\u5916\u5956\u52b1\u3002\u7c7b\u6bd4\u8bf4\u660e\uff1a\u5c31\u50cf\u6253\u602a\u6e38\u620f\u4e00\u6837\uff0c\u8fde\u51fb\u53ef\u4ee5\u83b7\u5f97\u66f4\u9ad8\u7684\u7ecf\u9a8c\u503c\u3002"}, {"question": "\u300a\u4e16\u754c\u7bad\u672f\u4e4b\u65c5\u300b\u6709PC\u7248\u672c\u5417\uff1f\u5b89\u5353\u548ciOS\u6570\u636e\u80fd\u5426\u4e92\u901a\uff1f\u5982\u679c\u6211\u60f3\u5728\u4e0d\u540c\u8bbe\u5907\u4e0a\u73a9\uff0c\u5e94\u8be5\u600e\u4e48\u540c\u6b65\u8fdb\u5ea6\uff1f", "answer": "\u76ee\u524d\u300a\u4e16\u754c\u7bad\u672f\u4e4b\u65c5\u300b\u4e3b\u8981\u5728\u79fb\u52a8\u5e73\u53f0\u53d1\u5e03\uff0c\u5b98\u65b9\u6682\u672a\u63a8\u51faPC\u7248\u672c\u3002\u6570\u636e\u4e92\u901a\u65b9\u9762\uff1a\u901a\u5e38\u60c5\u51b5\u4e0b\uff0c\u5b89\u5353\u548ciOS\u7248\u672c\u7684\u6570\u636e\u662f\u4e0d\u4e92\u901a\u7684\u3002\u4f46\u662f\uff0c\u5982\u679c\u6e38\u620f\u652f\u6301\u7b2c\u4e09\u65b9\u8d26\u53f7\u767b\u5f55\uff08\u4f8b\u5982\uff1aFacebook\u3001Google Play\uff09\uff0c\u5e76\u4e14\u5f00\u542f\u4e86\u4e91\u540c\u6b65\u529f\u80fd\uff0c\u90a3\u4e48\u53ef\u4ee5\u5728\u4e0d\u540c\u8bbe\u5907\u4e0a\u540c\u6b65\u6e38\u620f\u8fdb\u5ea6\u3002\u540c\u6b65\u6b65\u9aa4\uff1a\u6b65\u9aa4 1\uff1a\u5728\u539f\u8bbe\u5907\u4e0a\u7ed1\u5b9a\u7b2c\u4e09\u65b9\u8d26\u53f7\u5e76\u5f00\u542f\u4e91\u540c\u6b65\u3002\u6b65\u9aa4 2\uff1a\u5728\u65b0\u8bbe\u5907\u4e0a\u4e0b\u8f7d\u6e38\u620f\u5e76\u4f7f\u7528\u76f8\u540c\u7684\u7b2c\u4e09\u65b9\u8d26\u53f7\u767b\u5f55\u3002\u6b65\u9aa4 3\uff1a\u7b49\u5f85\u6e38\u620f\u540c\u6b65\u6570\u636e\u3002\u8bf7\u6ce8\u610f\uff0c\u90e8\u5206\u6e38\u620f\u53ef\u80fd\u4e0d\u652f\u6301\u8de8\u5e73\u53f0\u6570\u636e\u540c\u6b65\uff0c\u5177\u4f53\u60c5\u51b5\u8bf7\u53c2\u8003\u6e38\u620f\u5185\u7684\u5e2e\u52a9\u6587\u6863\u6216\u8054\u7cfb\u5ba2\u670d\u3002"}, {"question": "\u300a\u4e16\u754c\u7bad\u672f\u4e4b\u65c5\u300b\u5f69\u86cb\u6316\u6398\uff1a\u542c\u8bf4\u6e38\u620f\u4e2d\u9690\u85cf\u7740\u7279\u6b8a\u7684\u5f13\u7bad\u548c\u573a\u666f\uff0c\u5982\u4f55\u89e6\u53d1\u8fd9\u4e9b\u9690\u85cf\u5185\u5bb9\uff1f\u4f8b\u5982\u201c\u91d1\u8272\u7fbd\u6bdb\u5f13\u201d\u9700\u8981\u8fbe\u6210\u4ec0\u4e48\u6761\u4ef6\u624d\u80fd\u89e3\u9501\uff1f", "answer": "\u300a\u4e16\u754c\u7bad\u672f\u4e4b\u65c5\u300b\u786e\u5b9e\u9690\u85cf\u7740\u4e00\u4e9b\u7279\u6b8a\u7684\u5f13\u7bad\u548c\u573a\u666f\uff0c\u9700\u8981\u6ee1\u8db3\u7279\u5b9a\u6761\u4ef6\u624d\u80fd\u89e6\u53d1\u3002\u4ee5\u201c\u91d1\u8272\u7fbd\u6bdb\u5f13\u201d\u4e3a\u4f8b\uff0c\u89e3\u9501\u6761\u4ef6\u662f\uff1a\u8fde\u7eed 7 \u5929\u6bcf\u65e5\u767b\u5f55\u6e38\u620f\uff0c\u5e76\u4e14\u5728\u4efb\u610f\u6a21\u5f0f\u4e0b\u7d2f\u8ba1\u83b7\u5f97 10000 \u5206\u3002\u9690\u85cf\u5185\u5bb9\u7684\u5176\u4ed6\u89e6\u53d1\u65b9\u5f0f\uff1a\u25a0\u5b8c\u6210\u7279\u5b9a\u6210\u5c31\uff1a\u6e38\u620f\u4e2d\u6709\u5f88\u591a\u9690\u85cf\u7684\u6210\u5c31\uff0c\u5b8c\u6210\u8fd9\u4e9b\u6210\u5c31\u53ef\u80fd\u4f1a\u89e3\u9501\u65b0\u7684\u5185\u5bb9\u3002\u25a0\u89e6\u53d1\u7279\u5b9a\u4e8b\u4ef6\uff1a\u6709\u4e9b\u573a\u666f\u4e2d\uff0c\u4f1a\u51fa\u73b0\u4e00\u4e9b\u7279\u6b8a\u7684\u4e8b\u4ef6\uff0c\u89e6\u53d1\u8fd9\u4e9b\u4e8b\u4ef6\u53ef\u80fd\u4f1a\u89e3\u9501\u65b0\u7684\u5185\u5bb9\u3002\u25a0\u5728\u7279\u5b9a\u65f6\u95f4\u767b\u5f55\uff1a\u6709\u4e9b\u6d3b\u52a8\u4f1a\u5728\u7279\u5b9a\u7684\u65f6\u95f4\u5f00\u542f\uff0c\u53c2\u4e0e\u8fd9\u4e9b\u6d3b\u52a8\u53ef\u80fd\u4f1a\u83b7\u5f97\u7a00\u6709\u5956\u52b1\u3002\u5177\u4f53\u793a\u4f8b\uff1a\u5728\u67d0\u4e2a\u7279\u6b8a\u7684\u8282\u65e5\u767b\u5f55\u6e38\u620f\uff0c\u53ef\u80fd\u4f1a\u83b7\u5f97\u8282\u65e5\u9650\u5b9a\u7684\u5f13\u7bad\u548c\u76ae\u80a4\u3002\u7c7b\u6bd4\u8bf4\u660e\uff1a\u5c31\u50cf\u5bfb\u5b9d\u6e38\u620f\u4e00\u6837\uff0c\u9700\u8981\u8010\u5fc3\u63a2\u7d22\u624d\u80fd\u53d1\u73b0\u9690\u85cf\u7684\u5b9d\u85cf\u3002"}]
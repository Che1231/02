[{"question": "FNF Indie Cross\uc5d0\uc11c \ucd08\ubcf4\uc790\ub4e4\uc774 \uc815\ud655\ub3c4\ub97c \ub192\uc774\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "FNF Indie Cross\uc5d0\uc11c \uc815\ud655\ub3c4\ub97c \ub192\uc774\ub824\uba74 \uac8c\uc784\uc758 \ub9ac\ub4ec \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\ub294 \uac83\ubd80\ud130 \uc2dc\uc791\ud574\uc57c \ud569\ub2c8\ub2e4. \ucd08\ubcf4\uc790\ub4e4\uc740 \ube44\ud2b8 \ud45c\uc2dc\uc640 \ub3d9\uae30\ud654\ud558\uc5ec \ud0ed\ud551\uc5d0 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ubca4\ub514' \uc2a4\ud14c\uc774\uc9c0\uc5d0\uc11c \uc74c\uc545\uacfc \uc77c\uce58\ud558\ub294 \uc2dc\uac01\uc801 \ub2e8\uc11c\uc5d0 \uc8fc\uc758\ud558\uc2ed\uc2dc\uc624. STEP1: \ud0c0\uc774\ubc0d\uc5d0 \uc775\uc219\ud574\uc9c8 \uc218 \uc788\ub3c4\ub85d \ub290\ub9b0 \ub178\ub798\ubd80\ud130 \uc2dc\uc791\ud569\ub2c8\ub2e4. STEP2: \ud0c0\uc774\ubc0d\uc774 \ud5a5\uc0c1\ub418\uba74\uc11c \uc810\ucc28\uc801\uc73c\ub85c \ub09c\uc774\ub3c4\ub97c \ub192\uc5ec\ub098\uac11\ub2c8\ub2e4. STEP3: \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc5b4\ub824\uc6b4 \uad6c\uac04\uc744 \ubc18\ubcf5\ud569\ub2c8\ub2e4. \uc774 \uac8c\uc784\uc744 \ucda4\uacfc \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uba74 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4. \uc190\uac00\ub77d\uc774 \ub9ac\ub4ec\uc5d0 \ub9de\ucdb0 '\ucda4\ucd94\uc5b4\uc57c' \ud569\ub2c8\ub2e4."}, {"question": "FNF Indie Cross\uc640 \uc6d0\uc791 Friday Night Funkin'\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "FNF Indie Cross\ub294 \uc6d0\uc791 Friday Night Funkin'\uacfc\ub294 \ub2ec\ub9ac \ub3c5\ub9bd \uac8c\uc784\uc758 \uace0\uc720\ud55c \uba54\ucee4\ub2c8\uc998\uacfc \uce90\ub9ad\ud130\ub97c \uc18c\uac1c\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ucef5\ud5e4\ub4dc' \uc2a4\ud14c\uc774\uc9c0\uc5d0\ub294 \ub178\ud2b8\ub97c \ub193\uce58\uba74 \uccb4\ub825\uc774 \uac10\uc18c\ud558\ub294 \uccb4\ub825 \uac8c\uc774\uc9c0 \uc2dc\uc2a4\ud15c\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uac8c\uc784\uc5d0\ub294 \ubca4\ub514\uc640 \uc0cc\uc2a4\uc640 \uac19\uc740 \uce90\ub9ad\ud130\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc73c\uba70 \uac01\uac01 \ub3c5\uc790\uc801\uc778 \ud14c\ub9c8\uc758 \ub178\ub798\uc640 \uc2dc\uac01\uc801 \uc2a4\ud0c0\uc77c\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ub450 \uac8c\uc784\uc744 \ube44\uad50\ud558\ub294 \uad6c\uc131\ud45c\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: [\uc6d0\uc791 FNF: \uae30\ubcf8 \ub9ac\ub4ec \uba54\ucee4\ub2c8\uc998, FNF Indie Cross: \ub3c5\ub9bd \uac8c\uc784 \ud06c\ub85c\uc2a4\uc624\ubc84, \uace0\uc720 \uba54\ucee4\ub2c8\uc998]. \uc774\ub7ec\ud55c \ub2e4\uc591\uc131\uc740 \uc0c8\ub85c\uc6b4 \ub3c4\uc804\uacfc \ub9e4\ub825\uc744 \ub354\ud569\ub2c8\ub2e4."}, {"question": "FNF Indie Cross\uac00 \ub2e4\ub978 \ub3c5\ub9bd \uac8c\uc784\uc758 \uce90\ub9ad\ud130\ub97c \ud3ec\ud568\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "FNF Indie Cross\ub294 \uc5ec\ub7ec \ud504\ub79c\ucc28\uc774\uc988 \ud32c\uc5d0\uac8c \uc5b4\ud544\ud558\ub294 \ud06c\ub85c\uc2a4\uc624\ubc84 \uacbd\ud5d8\uc744 \ub9cc\ub4e4\uae30 \uc704\ud574 \ub2e4\ub978 \ub3c5\ub9bd \uac8c\uc784\uc758 \uce90\ub9ad\ud130\ub97c \ud1b5\ud569\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud3ec\ud568\uc740 \uac8c\uc784\uc758 \ubc18\ubcf5 \uac00\ub2a5\uc131\uacfc \ubb38\ud654\uc801 \uad00\ub828\uc131\uc744 \ub192\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5b8\ub354\ud14c\uc77c\uc758 '\uc0cc\uc2a4' \uc2a4\ud14c\uc774\uc9c0\ub294 \uc6d0\uc791 \uac8c\uc784 \ud32c\uc5d0\uac8c \ud5a5\uc218\ub97c \ubd88\ub7ec\uc77c\uc73c\ud0b5\ub2c8\ub2e4. \uce90\ub9ad\ud130 \ud1b5\ud569\uc758 \ud750\ub984\ub3c4\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: [\ub3c5\ub9bd \uac8c\uc784 \uc120\ud0dd \u2192 \uce90\ub9ad\ud130 \ub514\uc790\uc778 \u2192 \uc2a4\ud14c\uc774\uc9c0 \uc0dd\uc131 \u2192 \ub178\ub798 \ud1b5\ud569]. \uc774\ub7ec\ud55c \uc811\uadfc \ubc29\uc2dd\uc740 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ub2e4\uc591\ud654\ud560 \ubfd0\ub9cc \uc544\ub2c8\ub77c \ub3c5\ub9bd \uac8c\uc784 \ucee4\ubba4\ub2c8\ud2f0\ub97c \uae30\ub150\ud569\ub2c8\ub2e4."}, {"question": "FNF Indie Cross\uc5d0\uc11c \ucd5c\uc801\uc758 \uc131\ub2a5\uc744 \uc704\ud574 \uc5b4\ub5a4 \uc124\uc815\uc744 \uc870\uc815\ud574\uc57c \ud558\ub098\uc694?", "answer": "FNF Indie Cross\uc5d0\uc11c \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc5ec\ub7ec \uc124\uc815\uc744 \uc870\uc815\ud574\uc57c \ud569\ub2c8\ub2e4. STEP1: '\ucef5\ud5e4\ub4dc' \ub808\ubca8\uacfc \uac19\uc774 \uc2dc\uac01\uc801\uc73c\ub85c \uac15\ub82c\ud55c \uc2a4\ud14c\uc774\uc9c0\uc5d0\uc11c \uc9c0\uc5f0 \ud604\uc0c1\uc774 \ubc1c\uc0dd\ud558\uba74 \uadf8\ub798\ud53d \uc124\uc815\uc744 \ub0ae\ucd94\uc2ed\uc2dc\uc624. STEP2: \uc7a5\uce58\uc758 \ubc18\uc751 \uc2dc\uac04\uc5d0 \ub9de\ucdb0 \uc624\ub514\uc624 \uc9c0\uc5f0 \uc2dc\uac04\uc744 \uc62c\ubc14\ub974\uac8c \uc124\uc815\ud558\uc2ed\uc2dc\uc624. STEP3: \uc2dc\uc2a4\ud15c \ub9ac\uc18c\uc2a4\ub97c \ud655\ubcf4\ud558\uae30 \uc704\ud574 \ubd88\ud544\uc694\ud55c \ubc31\uadf8\ub77c\uc6b4\ub4dc \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc744 \ube44\ud65c\uc131\ud654\ud558\uc2ed\uc2dc\uc624. \ucd5c\uc801\ud654 \uc804\ud6c4 \uc124\uc815 \ube44\uad50 \ud45c\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: [\uc804: \uace0\uadf8\ub798\ud53d, \ud6c4: \uc911\uadf8\ub798\ud53d; \uc804: \uae30\ubcf8 \uc624\ub514\uc624 \uc9c0\uc5f0, \ud6c4: \uc870\uc815\ub41c \uc624\ub514\uc624 \uc9c0\uc5f0]. \uc774\ub7ec\ud55c \ubcc0\uacbd \uc0ac\ud56d\uc740 \uac8c\uc784 \ud50c\ub808\uc774\uc758 \uc6d0\ud65c\uc131\uc744 \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "FNF Indie Cross\uc5d0\uc11c \uc228\uaca8\uc9c4 \ub178\ub798\ub97c \uc5b4\ub5bb\uac8c \ud574\uc81c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "FNF Indie Cross\uc5d0\uc11c \uc228\uaca8\uc9c4 \ub178\ub798\ub97c \ud574\uc81c\ud558\ub824\uba74 \ud2b9\uc815 \ucc4c\ub9b0\uc9c0 \ub610\ub294 \ub192\uc740 \uc810\uc218\ub97c \ub2ec\uc131\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ubca4\ub514\uc758 \uc545\ubabd' \ub178\ub798\ub294 '\ubca4\ub514' \uc2a4\ud14c\uc774\uc9c0\uc5d0\uc11c 'S' \ub4f1\uae09\uc744 \ub2ec\uc131\ud558\uba74 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \uae30\ubcf8 \ub178\ub798\ub97c \ub9c8\uc2a4\ud130\ud558\uc5ec \uc804\ubc18\uc801\uc778 \uae30\uc220\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uc2ed\uc2dc\uc624. STEP2: \ub192\uc740 \ub4f1\uae09\uc744 \uc5bb\uae30 \uc704\ud574 \uc815\ud655\uc131\uacfc \ud0c0\uc774\ubc0d\uc5d0 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. STEP3: \ud2b9\uc815 \ud574\uc81c \uc694\uad6c \uc0ac\ud56d\uc5d0 \ub300\ud55c \ud301\uc744 \ucc3e\uc544 \uac8c\uc784 \ucee4\ubba4\ub2c8\ud2f0 \ud3ec\ub7fc\uc744 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \ud574\uc81c \ud504\ub85c\uc138\uc2a4\uc758 \ud750\ub984\ub3c4\ub294 \ub2e4\uc74c\uacfc \uac19\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4: [\uae30\ubcf8 \ub178\ub798 \uc644\ub8cc \u2192 \ub192\uc740 \ub4f1\uae09 \ub2ec\uc131 \u2192 \uc228\uaca8\uc9c4 \ub178\ub798 \ud574\uc81c]. \uc774 \ubc29\ubc95\uc740 \uc5f4\uc815\uc801\uc778 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud574 \ubcf4\uc0c1\uc774 \ub418\ub294 \uc9c4\ud589 \ubc29\uc2dd\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "FNF Indie Cross\uc5d0\uc11c '\uc0cc\uc2a4' \uc2a4\ud14c\uc774\uc9c0\ub97c \uc774\uae30\ub294 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "FNF Indie Cross\uc5d0\uc11c '\uc0cc\uc2a4' \uc2a4\ud14c\uc774\uc9c0\ub97c \uc774\uae30\ub824\uba74 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uacfc \uc804\ub7b5\uc801\uc778 \ub178\ud2b8 \uad00\ub9ac\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \uace0\uc720\ud55c \ub9ac\ub4ec \ud328\ud134\uc5d0 \uc775\uc219\ud574\uc9c8 \uc218 \uc788\ub3c4\ub85d \ub178\ub798\ub97c \uc5ec\ub7ec \ubc88 \uc5f0\uc2b5\ud558\uc2ed\uc2dc\uc624. STEP2: \uc2a4\ud14c\uc774\uc9c0\uac00 \ube60\ub978 \ub178\ud2b8 \uc2dc\ud000\uc2a4\ub97c \uc18c\uac1c\ud558\ubbc0\ub85c \uafb8\uc900\ud55c \ub9ac\ub4ec\uc744 \uc720\uc9c0\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. STEP3: \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc5b4\ub824\uc6b4 \uad6c\uac04\uc744 \ubd84\ub9ac\ud558\uace0 \ubc18\ubcf5\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\uba54\uac00\ub85c\ubca0\ub2c8\uc544' \ubd80\ubd84\uc740 \ud2b9\ud788 \uc5b4\ub835\uc9c0\ub9cc \ubc18\ubcf5\ud558\uc5ec \uadf9\ubcf5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \uc811\uadfc \ubc29\uc2dd\uc5d0\ub294 \uc804\uccb4 \uc18d\ub3c4\ub85c \uc2dc\ub3c4\ud558\uae30 \uc804\uc5d0 \ub178\ub798\uc758 \ub290\ub9b0 \ubc84\uc804\uc744 \uc5f0\uc2b5\ud558\ub294 \uac83\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4."}, {"question": "FNF Indie Cross\uc5d0\uc11c \uccb4\ub825 \uac8c\uc774\uc9c0 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "FNF Indie Cross\uc758 \uccb4\ub825 \uac8c\uc774\uc9c0 \uc2dc\uc2a4\ud15c\uc740 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc804\ub7b5\uc801\uc778 \uc694\uc18c\ub97c \ucd94\uac00\ud569\ub2c8\ub2e4. \ub178\ud2b8\ub97c \ub193\uce58\uba74 \uccb4\ub825\uc774 \uac10\uc18c\ud558\uace0, \ub178\ud2b8\ub97c \ub9de\ud788\uba74 \ud68c\ubcf5\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ucef5\ud5e4\ub4dc' \uc2a4\ud14c\uc774\uc9c0\uc5d0\uc11c\ub294 \uac01 \ub193\uce5c \ub178\ud2b8\uac00 \uccb4\ub825 \uac8c\uc774\uc9c0\ub97c \uc77c\ubd80 \uc18c\ubaa8\ud558\uace0, \uccb4\ub825\uc744 \uc720\uc9c0\ud558\uc9c0 \ubabb\ud558\uba74 \ub77c\uc6b4\ub4dc\ub97c \uc783\uac8c \ub429\ub2c8\ub2e4. \uba54\ucee4\ub2c8\uc998\uc744 \uc124\uba85\ud558\ub294 \uad6c\uc131\ud45c\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: [\ub9de\ud78c \ub178\ud2b8: +\uccb4\ub825, \ub193\uce5c \ub178\ud2b8: -\uccb4\ub825, \uccb4\ub825 \uc18c\ubaa8: \ub77c\uc6b4\ub4dc \uc190\uc2e4]. \uc774 \uba54\ucee4\ub2c8\uc998\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc5b4\ub824\uc6b4 \uc2a4\ud14c\uc774\uc9c0\ub97c \uc0b4\uc544\ub0a8\uae30 \uc704\ud574 \uc815\ud655\uc131\uacfc \ud0c0\uc774\ubc0d\uc5d0 \uc9d1\uc911\ud558\ub3c4\ub85d \uc7a5\ub824\ud569\ub2c8\ub2e4."}, {"question": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c FNF Indie Cross\ub97c \uc2e4\ud589\ud558\uae30 \uc704\ud55c \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "FNF Indie Cross\uc758 \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc740 \ud50c\ub7ab\ud3fc\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. PC\uc758 \uacbd\uc6b0 \ucd5c\uc18c 2GB RAM\uacfc \ub4c0\uc5bc \ucf54\uc5b4 \ud504\ub85c\uc138\uc11c\uac00 \uad8c\uc7a5\ub429\ub2c8\ub2e4. \ubaa8\ubc14\uc77c \uc7a5\uce58\uc758 \uacbd\uc6b0 iOS 10 \ub610\ub294 Android 7.0\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ucc28\uc774\uc810\uc744 \uac15\uc870\ud558\ub294 \ube44\uad50\ud45c\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: [PC: 2GB RAM, \ub4c0\uc5bc \ucf54\uc5b4 \ud504\ub85c\uc138\uc11c; \ubaa8\ubc14\uc77c: iOS 10, Android 7.0]. \uc7a5\uce58\uac00 \uc774\ub7ec\ud55c \uc694\uad6c \uc0ac\ud56d\uc744 \ucda9\uc871\ud558\uba74 \uc131\ub2a5 \ubb38\uc81c\ub97c \ubc29\uc9c0\ud558\uace0 \ub354 \uc6d0\ud65c\ud55c \uac8c\uc784 \ud658\uacbd\uc744 \uc81c\uacf5\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4."}, {"question": "FNF Indie Cross\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \ub2e4\ub978 \uc7a5\uce58 \uac04\uc5d0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694?", "answer": "FNF Indie Cross\uc5d0\uc11c \ub2e4\ub978 \uc7a5\uce58 \uac04\uc5d0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub824\uba74 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \ub610\ub294 \uc218\ub3d9 \ud30c\uc77c \uc804\uc1a1\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: Google Play \ub610\ub294 iCloud\uc640 \uac19\uc740 \ud074\ub77c\uc6b0\ub4dc \uc11c\ube44\uc2a4\uc5d0 \uac8c\uc784\uc744 \uc5f0\uacb0\ud558\uc2ed\uc2dc\uc624. STEP2: \uc7a5\uce58\ub97c \uc804\ud658\ud558\uae30 \uc804\uc5d0 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud558\uc2ed\uc2dc\uc624. STEP3: \uc0c8 \uc7a5\uce58\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uc5ec \uc800\uc7a5\ub41c \ub370\uc774\ud130\uc5d0 \uc561\uc138\uc2a4\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ud734\ub300\ud3f0\uc5d0\uc11c '\ubca4\ub514' \uc2a4\ud14c\uc774\uc9c0\ub97c \uc644\ub8cc\ud588\uc73c\uba74 \ub3d9\uae30\ud654\ub97c \ud1b5\ud574 PC\uc5d0\uc11c \ud574\ub2f9 \uc9c0\uc810\ubd80\ud130 \uacc4\uc18d \uc9c4\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud504\ub85c\uc138\uc2a4\uc758 \ud750\ub984\ub3c4\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: [\uacc4\uc815 \uc5f0\uacb0 \u2192 \uc9c4\ud589 \uc0c1\ud669 \ub3d9\uae30\ud654 \u2192 \uc0c8 \uc7a5\uce58\uc5d0\uc11c \uc561\uc138\uc2a4]."}, {"question": "FNF Indie Cross\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5a4 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ucc3e\uc744 \uc218 \uc788\ub098\uc694?", "answer": "FNF Indie Cross\uc5d0\ub294 \uac8c\uc784\uc5d0 \ub4f1\uc7a5\ud558\ub294 \ub3c5\ub9bd \uac8c\uc784\uc744 \ucc38\uc870\ud558\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ub9ce\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ucef5\ud5e4\ub4dc' \uc2a4\ud14c\uc774\uc9c0\uc5d0\uc11c\ub294 \uc6d0\ub798 \uac8c\uc784\uc758 \uc608\uc220\uc801 \uc2a4\ud0c0\uc77c\uacfc \uce90\ub9ad\ud130 \uc560\ub2c8\uba54\uc774\uc158\uc5d0 \ub300\ud55c \ubbf8\ubb18\ud55c \ud78c\ud2b8\ub97c \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\ub978 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 '\uc0cc\uc2a4' \uc2a4\ud14c\uc774\uc9c0\uc640 \uad00\ub828\ub418\uc5b4 \uc788\ub294\ub370, \ud2b9\uc815 \ubc30\uacbd \uc694\uc18c\uac00 \uc5b8\ub354\ud14c\uc77c \uc7a5\uba74\uc744 \ubaa8\ubc29\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ubcf4\uc11d\uc744 \ucc3e\ub294 \ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \uc811\uadfc \ubc29\uc2dd\uc5d0\ub294 \ubaa8\ub4e0 \uc2a4\ud14c\uc774\uc9c0\ub97c \ucca0\uc800\ud788 \ud0d0\uc0c9\ud558\uace0 \uc2dc\uac01 \ubc0f \uccad\uac01 \ub2e8\uc11c\uc5d0 \uc8fc\uc758\ud558\ub294 \uac83\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uc740 \uc5f4\uc815\uc801\uc778 \ud32c\ub4e4\uc744 \uc704\ud55c \uae4a\uc774\uc640 \ud765\ubd84\uc744 \ub354\ud569\ub2c8\ub2e4."}]
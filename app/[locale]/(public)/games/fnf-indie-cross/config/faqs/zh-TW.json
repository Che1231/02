[{"question": "\u65b0\u624b\u5982\u4f55\u63d0\u9ad8\u5728FNF Indie Cross\u4e2d\u7684\u6e96\u78ba\u5ea6\uff1f", "answer": "\u63d0\u9ad8FNF Indie Cross\u4e2d\u7684\u6e96\u78ba\u5ea6\uff0c\u9996\u5148\u8981\u7406\u89e3\u904a\u6232\u7bc0\u594f\u6a5f\u5236\u3002\u65b0\u624b\u61c9\u5c08\u6ce8\u65bc\u8207\u7bc0\u62cd\u6307\u793a\u5668\u540c\u6b65\u9ede\u64ca\u3002\u4f8b\u5982\uff0c\u5728\"Bendy\"\u968e\u6bb5\uff0c\u8acb\u6ce8\u610f\u8207\u97f3\u6a02\u76f8\u7b26\u7684\u8996\u89ba\u63d0\u793a\u3002\u6b65\u9a5f1\uff1a\u5f9e\u8f03\u6162\u7684\u6b4c\u66f2\u958b\u59cb\uff0c\u4ee5\u7fd2\u6163\u7bc0\u594f\u3002\u6b65\u9a5f2\uff1a\u96a8\u8457\u60a8\u7684\u7bc0\u594f\u6539\u5584\uff0c\u9010\u6f38\u63d0\u5347\u96e3\u5ea6\u3002\u6b65\u9a5f3\uff1a\u4f7f\u7528\u7df4\u7fd2\u6a21\u5f0f\u91cd\u8907\u6311\u6230\u90e8\u5206\u3002\u4e00\u500b\u6709\u7528\u7684\u985e\u6bd4\u662f\u5c07\u904a\u6232\u8996\u70ba\u4e00\u5834\u821e\u8e48\u2014\u2014\u60a8\u7684\u624b\u6307\u9700\u8981\u96a8\u8457\u7bc0\u594f\u300c\u8df3\u821e\u300d"}, {"question": "FNF Indie Cross\u8207\u539f\u59cb\u7684Friday Night Funkin'\u4e4b\u9593\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "FNF Indie Cross\u5f15\u5165\u4e86\u4f86\u81ea\u7368\u7acb\u904a\u6232\u7684\u7368\u7279\u6a5f\u5236\u548c\u89d2\u8272\uff0c\u4f7f\u5176\u8207\u539f\u59cb\u7684Friday Night Funkin'\u6709\u6240\u5340\u5225\u3002\u4f8b\u5982\uff0c\"Cuphead\"\u968e\u6bb5\u5177\u6709\u751f\u547d\u503c\u689d\u6a5f\u5236\uff0c\u5176\u4e2d\u932f\u904e\u97f3\u7b26\u6703\u964d\u4f4e\u60a8\u7684\u751f\u547d\u503c\u3002\u6b64\u5916\uff0c\u904a\u6232\u9084\u5305\u542bBendy\u548cSans\u7b49\u89d2\u8272\uff0c\u6bcf\u500b\u89d2\u8272\u90fd\u6709\u5176\u4e3b\u984c\u6b4c\u66f2\u548c\u8996\u89ba\u98a8\u683c\u3002\u4e00\u500b\u914d\u7f6e\u8868\u53ef\u4ee5\u5e6b\u52a9\u6bd4\u8f03\u5169\u8005\uff1a [\u539f\u59cbFNF\uff1a\u57fa\u672c\u7bc0\u594f\u6a5f\u5236\uff0cFNF Indie Cross\uff1a\u7368\u7acb\u904a\u6232\u4ea4\u53c9\uff0c\u7368\u7279\u6a5f\u5236]\u3002\u9019\u7a2e\u591a\u6a23\u6027\u589e\u6dfb\u4e86\u65b0\u9bae\u7684\u6311\u6230\u5c64\u6b21\u548c\u5438\u5f15\u529b\u3002"}, {"question": "\u70ba\u4ec0\u9ebcFNF Indie Cross\u6703\u5305\u542b\u5176\u4ed6\u7368\u7acb\u904a\u6232\u7684\u89d2\u8272\uff1f", "answer": "FNF Indie Cross\u6574\u5408\u4f86\u81ea\u5176\u4ed6\u7368\u7acb\u904a\u6232\u7684\u89d2\u8272\uff0c\u6253\u9020\u8de8\u754c\u9ad4\u9a57\uff0c\u5438\u5f15\u591a\u500b\u7cfb\u5217\u904a\u6232\u7684\u7c89\u7d72\u3002\u9019\u7a2e\u5305\u542b\u589e\u52a0\u4e86\u904a\u6232\u7684\u53ef\u91cd\u8907\u6027\u4ee5\u53ca\u6587\u5316\u76f8\u95dc\u6027\u3002\u4f8b\u5982\uff0c\u4f86\u81eaUndertale\u7684\"Sans\"\u968e\u6bb5\u70ba\u539f\u59cb\u904a\u6232\u7c89\u7d72\u5e36\u4f86\u4e86\u61f7\u820a\u5143\u7d20\u3002\u89d2\u8272\u6574\u5408\u6d41\u7a0b\u5716\u986f\u793a\uff1a[\u7368\u7acb\u904a\u6232\u9078\u64c7 \u2192 \u89d2\u8272\u8a2d\u8a08 \u2192 \u968e\u6bb5\u5275\u4f5c \u2192 \u6b4c\u66f2\u6574\u5408]\u3002\u6b64\u65b9\u6cd5\u4e0d\u50c5\u4f7f\u904a\u6232\u73a9\u6cd5\u591a\u6a23\u5316\uff0c\u4e5f\u70ba\u7368\u7acb\u904a\u6232\u793e\u7fa4\u81f4\u656c\u3002"}, {"question": "\u5728FNF Indie Cross\u4e2d\uff0c\u61c9\u8a72\u8abf\u6574\u54ea\u4e9b\u8a2d\u5b9a\u624d\u80fd\u9054\u5230\u6700\u4f73\u6548\u80fd\uff1f", "answer": "\u512a\u5316FNF Indie Cross\u7684\u6548\u80fd\u6d89\u53ca\u8abf\u6574\u591a\u500b\u8a2d\u5b9a\u3002\u6b65\u9a5f1\uff1a\u5982\u679c\u5728\u8996\u89ba\u5f37\u70c8\u7684\u968e\u6bb5\uff08\u4f8b\u5982\"Cuphead\"\u7b49\u7d1a\uff09\u9047\u5230\u5ef6\u9072\uff0c\u8acb\u964d\u4f4e\u5716\u5f62\u8a2d\u5b9a\u3002\u6b65\u9a5f2\uff1a\u78ba\u4fdd\u5c07\u97f3\u983b\u5ef6\u9072\u8a2d\u5b9a\u6b63\u78ba\uff0c\u4ee5\u5339\u914d\u60a8\u88dd\u7f6e\u7684\u97ff\u61c9\u6642\u9593\u3002\u6b65\u9a5f3\uff1a\u95dc\u9589\u4e0d\u5fc5\u8981\u7684\u80cc\u666f\u61c9\u7528\u7a0b\u5f0f\uff0c\u4ee5\u91cb\u653e\u7cfb\u7d71\u8cc7\u6e90\u3002\u512a\u5316\u524d\u5f8c\u8a2d\u5b9a\u7684\u5c0d\u7167\u8868\u53ef\u4ee5\u63d0\u4f9b\u5e6b\u52a9\uff1a[\u512a\u5316\u524d\uff1a\u9ad8\u5716\u5f62\uff0c\u512a\u5316\u5f8c\uff1a\u4e2d\u5716\u5f62\uff1b\u512a\u5316\u524d\uff1a\u9810\u8a2d\u97f3\u983b\u5ef6\u9072\uff0c\u512a\u5316\u5f8c\uff1a\u8abf\u6574\u5f8c\u7684\u97f3\u983b\u5ef6\u9072]\u3002\u9019\u4e9b\u8b8a\u66f4\u53ef\u4ee5\u986f\u8457\u6539\u5584\u904a\u6232\u6d41\u66a2\u5ea6\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728FNF Indie Cross\u4e2d\u89e3\u9396\u96b1\u85cf\u6b4c\u66f2\uff1f", "answer": "\u5728FNF Indie Cross\u4e2d\u89e3\u9396\u96b1\u85cf\u6b4c\u66f2\u901a\u5e38\u9700\u8981\u5b8c\u6210\u7279\u5b9a\u6311\u6230\u6216\u7372\u5f97\u9ad8\u5206\u3002\u4f8b\u5982\uff0c\"Bendy's Nightmare\"\u6b4c\u66f2\u53ef\u4ee5\u900f\u904e\u5728\"Bendy\"\u968e\u6bb5\u7372\u5f97\"S\" \u7b49\u7d1a\u4f86\u89e3\u9396\u3002\u6b65\u9a5f1\uff1a\u638c\u63e1\u57fa\u790e\u6b4c\u66f2\u4ee5\u63d0\u9ad8\u6574\u9ad4\u6280\u80fd\u3002\u6b65\u9a5f2\uff1a\u5c08\u6ce8\u65bc\u7cbe\u6e96\u5ea6\u548c\u7bc0\u594f\u611f\u4ee5\u7372\u5f97\u66f4\u9ad8\u7b49\u7d1a\u3002\u6b65\u9a5f3\uff1a\u67e5\u770b\u904a\u6232\u793e\u7fa4\u8ad6\u58c7\u4ee5\u4e86\u89e3\u7279\u5b9a\u89e3\u9396\u9700\u6c42\u3002\u89e3\u9396\u6d41\u7a0b\u7684\u6d41\u7a0b\u5716\u53ef\u80fd\u5982\u4e0b\u6240\u793a\uff1a[\u5b8c\u6210\u57fa\u790e\u6b4c\u66f2 \u2192 \u7372\u5f97\u9ad8\u5206 \u2192 \u89e3\u9396\u96b1\u85cf\u6b4c\u66f2]\u3002\u6b64\u65b9\u6cd5\u78ba\u4fdd\u4e86\u5c08\u6ce8\u73a9\u5bb6\u6709\u8c50\u539a\u7684\u9032\u7a0b\u3002"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u53ef\u4ee5\u5e6b\u52a9\u73a9\u5bb6\u64ca\u6557FNF Indie Cross\u4e2d\u7684\"Sans\"\u968e\u6bb5\uff1f", "answer": "\u64ca\u6557FNF Indie Cross\u4e2d\u7684\"Sans\"\u968e\u6bb5\u9700\u8981\u7cbe\u78ba\u7684\u6642\u6a5f\u548c\u7b56\u7565\u6027\u7684\u97f3\u7b26\u7ba1\u7406\u3002\u6b65\u9a5f1\uff1a\u53cd\u8986\u7df4\u7fd2\u6b4c\u66f2\uff0c\u4f7f\u81ea\u5df1\u719f\u6089\u5176\u7368\u7279\u7684\u7bc0\u594f\u6a21\u5f0f\u3002\u6b65\u9a5f2\uff1a\u5c08\u6ce8\u65bc\u7dad\u6301\u7a69\u5b9a\u7bc0\u594f\uff0c\u56e0\u70ba\u6b64\u968e\u6bb5\u5f15\u5165\u4e86\u5feb\u901f\u7684\u97f3\u7b26\u5e8f\u5217\u3002\u6b65\u9a5f3\uff1a\u4f7f\u7528\u7df4\u7fd2\u6a21\u5f0f\u9694\u96e2\u548c\u91cd\u8907\u56f0\u96e3\u7684\u90e8\u5206\u3002\u4f8b\u5982\uff0c\"Megalovania\" \u90e8\u5206\u7279\u5225\u5177\u6709\u6311\u6230\u6027\uff0c\u4f46\u53ef\u4ee5\u900f\u904e\u91cd\u8907\u4f86\u638c\u63e1\u3002\u591a\u89e3\u6c7a\u65b9\u6848\u65b9\u6cd5\u5305\u62ec\u5728\u5617\u8a66\u5b8c\u6574\u901f\u5ea6\u4e4b\u524d\u7df4\u7fd2\u6b4c\u66f2\u7684\u8f03\u6162\u7248\u672c\u3002"}, {"question": "FNF Indie Cross\u4e2d\u7684\u751f\u547d\u503c\u689d\u6a5f\u5236\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "FNF Indie Cross\u4e2d\u7684\u751f\u547d\u503c\u689d\u6a5f\u5236\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u4e00\u5c64\u7b56\u7565\u6027\u3002\u932f\u904e\u97f3\u7b26\u6703\u964d\u4f4e\u60a8\u7684\u751f\u547d\u503c\uff0c\u800c\u64ca\u4e2d\u97f3\u7b26\u5247\u6703\u6062\u5fa9\u751f\u547d\u503c\u3002\u4f8b\u5982\uff0c\u5728\"Cuphead\"\u968e\u6bb5\uff0c\u6bcf\u6b21\u932f\u904e\u97f3\u7b26\u90fd\u6703\u8017\u76e1\u90e8\u5206\u751f\u547d\u503c\uff0c\u4e26\u4e14\u7121\u6cd5\u7dad\u6301\u751f\u547d\u503c\u5c07\u5c0e\u81f4\u8f38\u6389\u56de\u5408\u3002\u4e00\u500b\u914d\u7f6e\u8868\u8aaa\u660e\u4e86\u6a5f\u5236\uff1a[\u64ca\u4e2d\u97f3\u7b26\uff1a+\u751f\u547d\u503c\uff0c\u932f\u904e\u97f3\u7b26\uff1a-\u751f\u547d\u503c\uff0c\u751f\u547d\u503c\u8017\u76e1\uff1a\u56de\u5408\u7d50\u675f]\u3002\u6b64\u6a5f\u5236\u9f13\u52f5\u73a9\u5bb6\u5c08\u6ce8\u65bc\u7cbe\u6e96\u5ea6\u548c\u7bc0\u594f\u611f\u4ee5\u751f\u5b58\u65bc\u5177\u6709\u6311\u6230\u6027\u7684\u968e\u6bb5\u3002"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u904b\u884cFNF Indie Cross\u7684\u7cfb\u7d71\u9700\u6c42\u662f\u4ec0\u9ebc\uff1f", "answer": "FNF Indie Cross\u7684\u7cfb\u7d71\u9700\u6c42\u56e0\u5e73\u53f0\u800c\u7570\u3002\u5c0d\u65bc\u96fb\u8166\uff0c\u5efa\u8b70\u81f3\u5c11\u9700\u89812GB RAM\u548c\u96d9\u6838\u5fc3\u8655\u7406\u5668\u3002\u5728\u884c\u52d5\u88dd\u7f6e\u4e0a\uff0c\u9700\u8981iOS 10\u6216Android 7.0\u3002\u5c0d\u7167\u8868\u7a81\u986f\u4e86\u5dee\u7570\uff1a[\u96fb\u8166\uff1a2GB RAM\uff0c\u96d9\u6838\u5fc3\u8655\u7406\u5668\uff1b\u884c\u52d5\u88dd\u7f6e\uff1aiOS 10\uff0cAndroid 7.0]\u3002\u78ba\u4fdd\u60a8\u7684\u88dd\u7f6e\u7b26\u5408\u9019\u4e9b\u9700\u6c42\uff0c\u5c07\u6709\u52a9\u65bc\u907f\u514d\u6548\u80fd\u554f\u984c\u4e26\u63d0\u4f9b\u66f4\u9806\u66a2\u7684\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u5982\u4f55\u5728FNF Indie Cross\u4e2d\u5c07\u9032\u5ea6\u5f9e\u4e00\u500b\u88dd\u7f6e\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u88dd\u7f6e\uff1f", "answer": "\u5728FNF Indie Cross\u4e2d\u5c07\u9032\u5ea6\u5f9e\u4e00\u500b\u88dd\u7f6e\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u88dd\u7f6e\uff0c\u53ef\u4ee5\u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u6216\u624b\u52d5\u6a94\u6848\u8f49\u79fb\u3002\u6b65\u9a5f1\uff1a\u78ba\u4fdd\u60a8\u7684\u904a\u6232\u5df2\u9023\u7d50\u5230\u96f2\u7aef\u670d\u52d9\uff08\u4f8b\u5982Google Play\u6216iCloud\uff09\u3002\u6b65\u9a5f2\uff1a\u5728\u5207\u63db\u88dd\u7f6e\u524d\u540c\u6b65\u60a8\u7684\u9032\u5ea6\u3002\u6b65\u9a5f3\uff1a\u5728\u65b0\u88dd\u7f6e\u4e0a\u767b\u5165\u540c\u4e00\u5e33\u6236\u4ee5\u5b58\u53d6\u60a8\u7684\u5132\u5b58\u8cc7\u6599\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5df2\u5728\u624b\u6a5f\u4e0a\u5b8c\u6210\"Bendy\"\u968e\u6bb5\uff0c\u540c\u6b65\u5c07\u5141\u8a31\u60a8\u5728\u96fb\u8166\u4e0a\u5f9e\u8a72\u9ede\u7e7c\u7e8c\u3002\u6d41\u7a0b\u5716\u53ef\u80fd\u5982\u4e0b\u6240\u793a\uff1a[\u9023\u7d50\u5e33\u6236 \u2192 \u540c\u6b65\u9032\u5ea6 \u2192 \u5728\u65b0\u88dd\u7f6e\u4e0a\u5b58\u53d6]\u3002"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728FNF Indie Cross\u4e2d\u627e\u5230\u54ea\u4e9b\u96b1\u85cf\u5f69\u86cb\uff1f", "answer": "FNF Indie Cross\u4e2d\u5145\u6eff\u4e86\u53c3\u8003\u5176\u4e2d\u7368\u7acb\u904a\u6232\u7684\u96b1\u85cf\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u5728\"Cuphead\"\u968e\u6bb5\uff0c\u73a9\u5bb6\u53ef\u80fd\u6703\u6ce8\u610f\u5230\u5c0d\u539f\u59cb\u904a\u6232\u85dd\u8853\u98a8\u683c\u548c\u89d2\u8272\u52d5\u756b\u7684\u7d30\u5fae\u81f4\u656c\u3002\u53e6\u4e00\u500b\u5f69\u86cb\u6d89\u53ca\"Sans\"\u968e\u6bb5\uff0c\u5176\u4e2d\u67d0\u4e9b\u80cc\u666f\u5143\u7d20\u6a21\u4effUndertale\u4e2d\u7684\u5834\u666f\u3002\u627e\u5230\u9019\u4e9b\u5f69\u86cb\u7684\u591a\u89e3\u6c7a\u65b9\u6848\u65b9\u6cd5\u5305\u62ec\u5fb9\u5e95\u63a2\u7d22\u6bcf\u500b\u968e\u6bb5\uff0c\u4e26\u6ce8\u610f\u8996\u89ba\u548c\u807d\u89ba\u63d0\u793a\u3002\u9019\u4e9b\u96b1\u85cf\u5bf6\u85cf\u70ba\u5c08\u6ce8\u7684\u7c89\u7d72\u589e\u6dfb\u4e86\u6df1\u5ea6\u548c\u8208\u596e\u611f\u3002"}]
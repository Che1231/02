[{"question": "FNF Indie Cross\u3067\u521d\u5fc3\u8005\u304c\u6b63\u78ba\u6027\u3092\u5411\u4e0a\u3055\u305b\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "FNF Indie Cross\u3067\u6b63\u78ba\u6027\u3092\u5411\u4e0a\u3055\u305b\u308b\u306b\u306f\u3001\u307e\u305a\u30b2\u30fc\u30e0\u306e\u30ea\u30ba\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u304b\u3089\u59cb\u307e\u308a\u307e\u3059\u3002\u521d\u5fc3\u8005\u306f\u3001\u30d3\u30fc\u30c8\u30a4\u30f3\u30b8\u30b1\u30fc\u30bf\u30fc\u3068\u540c\u671f\u3057\u3066\u30bf\u30c3\u30d7\u3059\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300eBendy\u300f\u30b9\u30c6\u30fc\u30b8\u3067\u306f\u3001\u97f3\u697d\u3068\u4e00\u81f4\u3059\u308b\u8996\u899a\u7684\u30b7\u30b0\u30ca\u30eb\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30bf\u30a4\u30df\u30f3\u30b0\u306b\u6163\u308c\u308b\u305f\u3081\u306b\u3001\u9045\u3044\u66f2\u304b\u3089\u59cb\u3081\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u5411\u4e0a\u3059\u308b\u306b\u3064\u308c\u3066\u3001\u5f90\u3005\u306b\u96e3\u6613\u5ea6\u3092\u4e0a\u3052\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7df4\u7fd2\u30e2\u30fc\u30c9\u3092\u4f7f\u7528\u3057\u3066\u3001\u96e3\u3057\u3044\u90e8\u5206\u3092\u7e70\u308a\u8fd4\u3057\u307e\u3059\u3002\u3053\u306e\u30b2\u30fc\u30e0\u3092\u30c0\u30f3\u30b9\u3068\u8003\u3048\u3066\u307f\u308b\u3068\u826f\u3044\u3067\u3057\u3087\u3046\u3002\u6307\u306f\u30ea\u30ba\u30e0\u306b\u5408\u308f\u305b\u3066\u300e\u30c0\u30f3\u30b9\u300f\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "FNF Indie Cross\u3068\u30aa\u30ea\u30b8\u30ca\u30eb\u306eFriday Night Funkin'\u3068\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "FNF Indie Cross\u306f\u3001\u30a4\u30f3\u30c7\u30a3\u30fc\u30b2\u30fc\u30e0\u306e\u72ec\u7279\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3068\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u5c0e\u5165\u3057\u3001\u30aa\u30ea\u30b8\u30ca\u30eb\u306eFriday Night Funkin'\u3068\u306f\u4e00\u7dda\u3092\u753b\u3057\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300eCuphead\u300f\u30b9\u30c6\u30fc\u30b8\u3067\u306f\u3001\u30ce\u30fc\u30c8\u3092\u30df\u30b9\u3059\u308b\u3068\u4f53\u529b\u30b2\u30fc\u30b8\u304c\u6e1b\u308b\u3068\u3044\u3046\u30e1\u30ab\u30cb\u30ba\u30e0\u304c\u5c0e\u5165\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u3053\u306e\u30b2\u30fc\u30e0\u306b\u306f\u3001\u305d\u308c\u305e\u308c\u30c6\u30fc\u30de\u5225\u306e\u66f2\u3068\u30d3\u30b8\u30e5\u30a2\u30eb\u30b9\u30bf\u30a4\u30eb\u3092\u6301\u3064\u3001Bendy\u3084Sans\u306a\u3069\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u30022\u3064\u306e\u30b2\u30fc\u30e0\u3092\u6bd4\u8f03\u3059\u308b\u69cb\u6210\u8868\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\u3002[\u30aa\u30ea\u30b8\u30ca\u30eb\u306eFNF\uff1a\u57fa\u672c\u7684\u306a\u30ea\u30ba\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u3001FNF Indie Cross\uff1a\u30a4\u30f3\u30c7\u30a3\u30fc\u30b2\u30fc\u30e0\u306e\u30af\u30ed\u30b9\u30aa\u30fc\u30d0\u30fc\u3001\u72ec\u81ea\u306e\u30e1\u30ab\u30cb\u30ba\u30e0]\u3002\u3053\u306e\u591a\u69d8\u6027\u306f\u3001\u65b0\u9bae\u306a\u6311\u6226\u3068\u9b45\u529b\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002"}, {"question": "FNF Indie Cross\u306b\u4ed6\u306e\u30a4\u30f3\u30c7\u30a3\u30fc\u30b2\u30fc\u30e0\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u542b\u307e\u308c\u3066\u3044\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "FNF Indie Cross\u306f\u8907\u6570\u306e\u30d5\u30e9\u30f3\u30c1\u30e3\u30a4\u30ba\u306e\u30d5\u30a1\u30f3\u306b\u30a2\u30d4\u30fc\u30eb\u3059\u308b\u30af\u30ed\u30b9\u30aa\u30fc\u30d0\u30fc\u4f53\u9a13\u3092\u4f5c\u6210\u3059\u308b\u305f\u3081\u306b\u3001\u4ed6\u306e\u30a4\u30f3\u30c7\u30a3\u30fc\u30b2\u30fc\u30e0\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u53d6\u308a\u5165\u308c\u3066\u3044\u307e\u3059\u3002\u3053\u306e\u5305\u542b\u306f\u3001\u30b2\u30fc\u30e0\u306e\u518d\u30d7\u30ec\u30a4\u6027\u3068\u6587\u5316\u7684\u95a2\u9023\u6027\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300eUndertale\u300f\u306e\u300eSans\u300f\u30b9\u30c6\u30fc\u30b8\u306f\u3001\u30aa\u30ea\u30b8\u30ca\u30eb\u30b2\u30fc\u30e0\u306e\u30d5\u30a1\u30f3\u306b\u3068\u3063\u3066\u61d0\u304b\u3057\u3055\u3092\u547c\u3073\u8d77\u3053\u3057\u307e\u3059\u3002\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u7d71\u5408\u306e\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\u3002[\u30a4\u30f3\u30c7\u30a3\u30fc\u30b2\u30fc\u30e0\u306e\u9078\u629e\u2192\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30c7\u30b6\u30a4\u30f3\u2192\u30b9\u30c6\u30fc\u30b8\u4f5c\u6210\u2192\u697d\u66f2\u7d71\u5408]\u3002\u3053\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u591a\u69d8\u5316\u3059\u308b\u3060\u3051\u3067\u306a\u304f\u3001\u30a4\u30f3\u30c7\u30a3\u30fc\u30b2\u30fc\u30e0\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u3092\u795d\u3046\u3082\u306e\u3067\u3059\u3002"}, {"question": "FNF Indie Cross\u3067\u6700\u9069\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5f97\u308b\u305f\u3081\u306b\u3001\u3069\u306e\u8a2d\u5b9a\u3092\u8abf\u6574\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "FNF Indie Cross\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u8a2d\u5b9a\u3092\u8abf\u6574\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u300eCuphead\u300f\u30ec\u30d9\u30eb\u306a\u3069\u306e\u8996\u899a\u7684\u306b\u6fc0\u3057\u3044\u30b9\u30c6\u30fc\u30b8\u3067\u30e9\u30b0\u304c\u767a\u751f\u3059\u308b\u5834\u5408\u306f\u3001\u30b0\
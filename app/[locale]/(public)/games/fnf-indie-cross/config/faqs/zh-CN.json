[{"question": "\u65b0\u624b\u5982\u4f55\u63d0\u9ad8\u4ed6\u4eec\u5728FNF Indie Cross\u4e2d\u7684\u51c6\u786e\u7387\uff1f", "answer": "\u63d0\u9ad8FNF Indie Cross\u4e2d\u7684\u51c6\u786e\u7387\uff0c\u9996\u5148\u8981\u7406\u89e3\u6e38\u620f\u7684\u8282\u594f\u673a\u5236\u3002 \u521d\u5b66\u8005\u5e94\u8be5\u4e13\u6ce8\u4e8e\u4e0e\u8282\u62cd\u6307\u793a\u5668\u540c\u6b65\u70b9\u51fb\u3002\u4f8b\u5982\uff0c\u5728\u201cBendy\u201d\u9636\u6bb5\uff0c\u8bf7\u6ce8\u610f\u4e0e\u97f3\u4e50\u76f8\u7b26\u7684\u89c6\u89c9\u63d0\u793a\u3002\u6b65\u9aa4\u4e00\uff1a\u4ece\u8f83\u6162\u7684\u6b4c\u66f2\u5f00\u59cb\uff0c\u719f\u6089\u8282\u594f\u3002\u6b65\u9aa4\u4e8c\uff1a\u968f\u7740\u4f60\u7684\u8282\u594f\u611f\u63d0\u9ad8\uff0c\u9010\u6e10\u589e\u52a0\u96be\u5ea6\u3002\u6b65\u9aa4\u4e09\uff1a\u4f7f\u7528\u7ec3\u4e60\u6a21\u5f0f\u91cd\u590d\u6311\u6218\u90e8\u5206\u3002\u4e00\u4e2a\u6709\u5e2e\u52a9\u7684\u7c7b\u6bd4\u662f\u5c06\u6e38\u620f\u89c6\u4e3a\u821e\u8e48\u2014\u2014\u4f60\u7684\u624b\u6307\u9700\u8981\u968f\u7740\u8282\u594f\u201c\u821e\u8e48\u201d \u3002"}, {"question": "FNF Indie Cross\u548c\u539f\u7248Friday Night Funkin\u2019\u7684\u5173\u952e\u533a\u522b\u662f\u4ec0\u4e48\uff1f", "answer": "FNF Indie Cross\u5f15\u5165\u4e86\u6765\u81ea\u72ec\u7acb\u6e38\u620f\u7684\u72ec\u7279\u673a\u5236\u548c\u89d2\u8272\uff0c\u4f7f\u5176\u533a\u522b\u4e8e\u539f\u7248Friday Night Funkin\u2019\u3002\u4f8b\u5982\uff0c\u201c\u676f\u5934\u201d\u9636\u6bb5\u6709\u4e00\u4e2a\u751f\u547d\u503c\u6761\u673a\u5236\uff0c\u9519\u8fc7\u97f3\u7b26\u4f1a\u51cf\u5c11\u4f60\u7684\u751f\u547d\u503c\u3002\u6b64\u5916\uff0c\u6e38\u620f\u8fd8\u5305\u62ecBendy\u548cSans\u7b49\u89d2\u8272\uff0c\u6bcf\u4e2a\u89d2\u8272\u90fd\u6709\u81ea\u5df1\u4e3b\u9898\u7684\u6b4c\u66f2\u548c\u89c6\u89c9\u98ce\u683c\u3002\u4e00\u4e2a\u914d\u7f6e\u8868\u53ef\u4ee5\u5e2e\u52a9\u6bd4\u8f83\u4e24\u8005\uff1a[\u539f\u7248FNF\uff1a\u57fa\u672c\u8282\u594f\u673a\u5236\uff0cFNF Indie Cross\uff1a\u72ec\u7acb\u6e38\u620f\u8de8\u754c\uff0c\u72ec\u7279\u673a\u5236]\u3002\u8fd9\u79cd\u591a\u6837\u6027\u589e\u6dfb\u4e86\u65b0\u7684\u6311\u6218\u6027\u548c\u5438\u5f15\u529b\u3002"}, {"question": "\u4e3a\u4ec0\u4e48FNF Indie Cross\u8981\u5305\u542b\u5176\u4ed6\u72ec\u7acb\u6e38\u620f\u7684\u89d2\u8272\uff1f", "answer": "FNF Indie Cross\u5305\u542b\u6765\u81ea\u5176\u4ed6\u72ec\u7acb\u6e38\u620f\u89d2\u8272\uff0c\u4ee5\u521b\u9020\u4e00\u79cd\u5438\u5f15\u591a\u4e2a\u6e38\u620f\u7cfb\u5217\u7c89\u4e1d\u7684\u4ea4\u53c9\u4f53\u9a8c\u3002\u8fd9\u79cd\u5305\u542b\u589e\u5f3a\u4e86\u6e38\u620f\u7684\u53ef\u91cd\u590d\u6027\u548c\u6587\u5316\u76f8\u5173\u6027\u3002\u4f8b\u5982\uff0c\u201c\u5730\u5e95\u4ebaSans\u201d\u9636\u6bb5\u4e3aUndertale\u6e38\u620f\u7684\u7c89\u4e1d\u5e26\u6765\u4e86\u6000\u65e7\u5143\u7d20\u3002\u89d2\u8272\u96c6\u6210\u6d41\u7a0b\u56fe\u663e\u793a\uff1a[\u72ec\u7acb\u6e38\u620f\u9009\u62e9\u2192\u89d2\u8272\u8bbe\u8ba1\u2192\u5173\u5361\u521b\u5efa\u2192\u6b4c\u66f2\u96c6\u6210]\u3002\u8fd9\u79cd\u65b9\u6cd5\u4e0d\u4ec5\u4f7f\u6e38\u620f\u73a9\u6cd5\u591a\u6837\u5316\uff0c\u8fd8\u5728\u5e86\u795d\u72ec\u7acb\u6e38\u620f\u793e\u533a\u3002"}, {"question": "\u5728FNF Indie Cross\u4e2d\uff0c\u5e94\u8be5\u8c03\u6574\u54ea\u4e9b\u8bbe\u7f6e\u4ee5\u83b7\u5f97\u6700\u4f73\u6027\u80fd\uff1f", "answer": "\u4f18\u5316FNF Indie Cross\u7684\u6027\u80fd\u6d89\u53ca\u8c03\u6574\u591a\u79cd\u8bbe\u7f6e\u3002\u6b65\u9aa4\u4e00\uff1a\u5982\u679c\u5728\u89c6\u89c9\u5f3a\u70c8\u7684\u5173\u5361\uff08\u4f8b\u5982\u201c\u676f\u5934\u201d\u5173\u5361\uff09\u671f\u95f4\u51fa\u73b0\u5ef6\u8fdf\uff0c\u8bf7\u964d\u4f4e\u56fe\u5f62\u8bbe\u7f6e\u3002\u6b65\u9aa4\u4e8c\uff1a\u786e\u4fdd\u97f3\u9891\u5ef6\u8fdf\u8bbe\u7f6e\u6b63\u786e\uff0c\u4ee5\u5339\u914d\u8bbe\u5907\u7684\u54cd\u5e94\u65f6\u95f4\u3002\u6b65\u9aa4\u4e09\uff1a\u7981\u7528\u4e0d\u5fc5\u8981\u7684\u540e\u53f0\u5e94\u7528\u7a0b\u5e8f\uff0c\u4ee5\u91ca\u653e\u7cfb\u7edf\u8d44\u6e90\u3002\u4f18\u5316\u524d\u540e\u8bbe\u7f6e\u7684\u5bf9\u6bd4\u8868\u5982\u4e0b\uff1a[\u4f18\u5316\u524d\uff1a\u9ad8\u56fe\u5f62\uff0c\u4f18\u5316\u540e\uff1a\u4e2d\u56fe\u5f62\uff1b\u4f18\u5316\u524d\uff1a\u9ed8\u8ba4\u97f3\u9891\u5ef6\u8fdf\uff0c\u4f18\u5316\u540e\uff1a\u8c03\u6574\u7684\u97f3\u9891\u5ef6\u8fdf]\u3002\u8fd9\u4e9b\u6539\u53d8\u53ef\u4ee5\u663e\u8457\u6539\u5584\u6e38\u620f\u6d41\u7545\u5ea6\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728FNF Indie Cross\u4e2d\u89e3\u9501\u9690\u85cf\u6b4c\u66f2\uff1f", "answer": "\u5728FNF Indie Cross\u4e2d\u89e3\u9501\u9690\u85cf\u6b4c\u66f2\u901a\u5e38\u9700\u8981\u5b8c\u6210\u7279\u5b9a\u6311\u6218\u6216\u83b7\u5f97\u9ad8\u5206\u3002\u4f8b\u5982\uff0c\u201cBendy\u7684\u5669\u68a6\u201d\u6b4c\u66f2\u53ef\u4ee5\u901a\u8fc7\u5728\u201cBendy\u201d\u5173\u5361\u4e2d\u83b7\u5f97\u201cS\u201d\u7b49\u7ea7\u6765\u89e3\u9501\u3002\u6b65\u9aa4\u4e00\uff1a\u638c\u63e1\u57fa\u7840\u6b4c\u66f2\u4ee5\u63d0\u9ad8\u4f60\u7684\u6574\u4f53\u6280\u80fd\u3002\u6b65\u9aa4\u4e8c\uff1a\u4e13\u6ce8\u4e8e\u51c6\u786e\u6027\u548c\u65f6\u673a\u4ee5\u83b7\u5f97\u66f4\u9ad8\u7b49\u7ea7\u3002\u6b65\u9aa4\u4e09\uff1a\u67e5\u770b\u6e38\u620f\u793e\u533a\u8bba\u575b\u4ee5\u83b7\u53d6\u7279\u5b9a\u89e3\u9501\u8981\u6c42\u7684\u63d0\u793a\u3002\u89e3\u9501\u8fc7\u7a0b\u7684\u6d41\u7a0b\u56fe\u53ef\u80fd\u5982\u4e0b\u6240\u793a\uff1a[\u5b8c\u6210\u57fa\u7840\u6b4c\u66f2\u2192\u83b7\u5f97\u9ad8\u5206\u2192\u89e3\u9501\u9690\u85cf\u6b4c\u66f2]\u3002\u6b64\u65b9\u6cd5\u53ef\u786e\u4fdd\u4e3a\u79ef\u6781\u7684\u73a9\u5bb6\u5e26\u6765\u4e30\u539a\u7684\u5956\u52b1\u3002"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u53ef\u4ee5\u5e2e\u52a9\u73a9\u5bb6\u5728FNF Indie Cross\u4e2d\u51fb\u8d25\u201cSans\u201d\u5173\u5361\uff1f", "answer": "\u5728FNF Indie Cross\u4e2d\u51fb\u8d25\u201cSans\u201d\u5173\u5361\u9700\u8981\u7cbe\u786e\u7684\u65f6\u673a\u548c\u6218\u7565\u97f3\u7b26\u7ba1\u7406\u3002\u6b65\u9aa4\u4e00\uff1a\u591a\u6b21\u7ec3\u4e60\u6b4c\u66f2\uff0c\u719f\u6089\u5176\u72ec\u7279\u7684\u8282\u594f\u6a21\u5f0f\u3002\u6b65\u9aa4\u4e8c\uff1a\u4e13\u6ce8\u4e8e\u4fdd\u6301\u7a33\u5b9a\u7684\u8282\u594f\uff0c\u56e0\u4e3a\u8be5\u5173\u5361\u5f15\u5165\u4e86\u5feb\u901f\u97f3\u7b26\u5e8f\u5217\u3002\u6b65\u9aa4\u4e09\uff1a\u4f7f\u7528\u7ec3\u4e60\u6a21\u5f0f\u9694\u79bb\u548c\u91cd\u590d\u56f0\u96be\u90e8\u5206\u3002\u4f8b\u5982\uff0c\u201cMegalovania\u201d\u90e8\u5206\u5c24\u5176\u5177\u6709\u6311\u6218\u6027\uff0c\u4f46\u53ef\u4ee5\u901a\u8fc7\u91cd\u590d\u6765\u638c\u63e1\u3002\u591a\u65b9\u6848\u65b9\u6cd5\u5305\u62ec\u5728\u5c1d\u8bd5\u5b8c\u6574\u901f\u5ea6\u4e4b\u524d\u7ec3\u4e60\u6b4c\u66f2\u7684\u8f83\u6162\u7248\u672c\u3002"}, {"question": "FNF Indie Cross\u4e2d\u7684\u751f\u547d\u503c\u6761\u673a\u5236\u662f\u5982\u4f55\u5de5\u4f5c\u7684\uff1f", "answer": "FNF Indie Cross\u4e2d\u7684\u751f\u547d\u503c\u6761\u673a\u5236\u4e3a\u6e38\u620f\u73a9\u6cd5\u589e\u6dfb\u4e86\u4e00\u5c42\u7b56\u7565\u3002\u9519\u8fc7\u97f3\u7b26\u4f1a\u964d\u4f4e\u4f60\u7684\u751f\u547d\u503c\uff0c\u800c\u51fb\u4e2d\u97f3\u7b26\u5219\u4f1a\u56de\u590d\u751f\u547d\u503c\u3002\u4f8b\u5982\uff0c\u5728\u201c\u676f\u5934\u201d\u9636\u6bb5\uff0c\u6bcf\u4e2a\u9519\u8fc7\u7684\u97f3\u7b26\u90fd\u4f1a\u6d88\u8017\u4e00\u90e8\u5206\u751f\u547d\u503c\u6761\uff0c\u800c\u65e0\u6cd5\u7ef4\u6301\u751f\u547d\u503c\u6761\u4f1a\u5bfc\u81f4\u4f60\u8f93\u6389\u8be5\u56de\u5408\u3002\u914d\u7f6e\u8868\u89e3\u91ca\u4e86\u673a\u5236\uff1a[\u51fb\u4e2d\u97f3\u7b26\uff1a+\u751f\u547d\u503c\uff0c\u9519\u8fc7\u97f3\u7b26\uff1a-\u751f\u547d\u503c\uff0c\u751f\u547d\u503c\u8017\u5c3d\uff1a\u56de\u5408\u5931\u8d25]\u3002\u8be5\u673a\u5236\u9f13\u52b1\u73a9\u5bb6\u4e13\u6ce8\u4e8e\u51c6\u786e\u6027\u548c\u65f6\u673a\uff0c\u4ee5\u5e94\u5bf9\u5177\u6709\u6311\u6218\u6027\u7684\u5173\u5361\u3002"}, {"question": "\u4e0d\u540c\u5e73\u53f0\u8fd0\u884cFNF Indie Cross\u7684\u7cfb\u7edf\u9700\u6c42\u662f\u4ec0\u4e48\uff1f", "answer": "FNF Indie Cross\u7684\u7cfb\u7edf\u9700\u6c42\u56e0\u5e73\u53f0\u800c\u5f02\u3002\u5bf9\u4e8ePC\uff0c\u5efa\u8bae\u81f3\u5c112GB\u5185\u5b58\u548c\u53cc\u6838\u5904\u7406\u5668\u3002\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\uff0c\u9700\u8981iOS 10\u6216Android 7.0\u3002\u5bf9\u6bd4\u8868\u7a81\u51fa\u663e\u793a\u4e86\u5dee\u5f02\uff1a[PC\uff1a2GB\u5185\u5b58\uff0c\u53cc\u6838\u5904\u7406\u5668\uff1b\u79fb\u52a8\u8bbe\u5907\uff1aiOS 10\uff0cAndroid 7.0]\u3002\u786e\u4fdd\u60a8\u7684\u8bbe\u5907\u7b26\u5408\u8fd9\u4e9b\u8981\u6c42\uff0c\u5c06\u6709\u52a9\u4e8e\u907f\u514d\u6027\u80fd\u95ee\u9898\uff0c\u5e76\u63d0\u4f9b\u66f4\u6d41\u7545\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728FNF Indie Cross\u7684\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u8f6c\u79fb\u4ed6\u4eec\u7684\u8fdb\u5ea6\uff1f", "answer": "\u5728FNF Indie Cross\u7684\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u8f6c\u79fb\u8fdb\u5ea6\u53ef\u4ee5\u901a\u8fc7\u4e91\u5b58\u50a8\u6216\u624b\u52a8\u6587\u4ef6\u4f20\u8f93\u5b9e\u73b0\u3002\u6b65\u9aa4\u4e00\uff1a\u786e\u4fdd\u4f60\u7684\u6e38\u620f\u94fe\u63a5\u5230\u4e91\u670d\u52a1\uff0c\u4f8b\u5982Google Play\u6216iCloud\u3002\u6b65\u9aa4\u4e8c\uff1a\u5728\u5207\u6362\u8bbe\u5907\u524d\u540c\u6b65\u4f60\u7684\u8fdb\u5ea6\u3002\u6b65\u9aa4\u4e09\uff1a\u5728\u65b0\u8bbe\u5907\u4e0a\u767b\u5f55\u540c\u4e00\u5e10\u6237\u4ee5\u8bbf\u95ee\u4f60\u7684\u4fdd\u5b58\u6570\u636e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5df2\u7ecf\u5728\u624b\u673a\u4e0a\u5b8c\u6210\u4e86\u201cBendy\u201d\u5173\u5361\uff0c\u540c\u6b65\u5c06\u5141\u8bb8\u4f60\u5728\u7535\u8111\u4e0a\u4ece\u8be5\u70b9\u7ee7\u7eed\u3002\u8fc7\u7a0b\u6d41\u7a0b\u56fe\u5982\u4e0b\uff1a[\u94fe\u63a5\u5e10\u6237\u2192\u540c\u6b65\u8fdb\u5ea6\u2192\u5728\u65b0\u8bbe\u5907\u4e0a\u8bbf\u95ee]\u3002"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728FNF Indie Cross\u4e2d\u627e\u5230\u54ea\u4e9b\u9690\u85cf\u5f69\u86cb\uff1f", "answer": "FNF Indie Cross\u5145\u6ee1\u4e86\u9690\u85cf\u5f69\u86cb\uff0c\u8fd9\u4e9b\u5f69\u86cb\u53c2\u8003\u4e86\u5b83\u6240\u5305\u542b\u7684\u72ec\u7acb\u6e38\u620f\u3002\u4f8b\u5982\uff0c\u5728\u201c\u676f\u5934\u201d\u9636\u6bb5\uff0c\u73a9\u5bb6\u53ef\u80fd\u4f1a\u6ce8\u610f\u5230\u5bf9\u539f\u59cb\u6e38\u620f\u7f8e\u672f\u98ce\u683c\u548c\u89d2\u8272\u52a8\u753b\u7684\u7ec6\u5fae\u6697\u793a\u3002\u53e6\u4e00\u4e2a\u5f69\u86cb\u6d89\u53ca\u201cSans\u201d\u9636\u6bb5\uff0c\u5176\u4e2d\u67d0\u4e9b\u80cc\u666f\u5143\u7d20\u6a21\u4effUndertale\u4e2d\u7684\u573a\u666f\u3002\u627e\u5230\u8fd9\u4e9b\u9690\u85cf\u5f69\u86cb\u7684\u591a\u65b9\u6848\u65b9\u6cd5\u5305\u62ec\u5f7b\u5e95\u63a2\u7d22\u6bcf\u4e2a\u5173\u5361\uff0c\u5e76\u6ce8\u610f\u89c6\u89c9\u548c\u542c\u89c9\u63d0\u793a\u3002\u8fd9\u4e9b\u9690\u85cf\u7684\u73cd\u5b9d\u4e3a\u79ef\u6781\u7684\u7c89\u4e1d\u589e\u6dfb\u4e86\u6df1\u5ea6\u548c\u5174\u594b\u3002"}]
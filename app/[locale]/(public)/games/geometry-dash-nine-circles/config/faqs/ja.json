[{"question": "\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u306e\u521d\u5fc3\u8005\u5411\u3051\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u307e\u305a\u30b8\u30e3\u30f3\u30d7\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u628a\u63e1\u3059\u308b\u3053\u3068\u304b\u3089\u59cb\u3081\u307e\u3057\u3087\u3046\u3002\u3053\u306e\u30b2\u30fc\u30e0\u306f\u3001\u4e3b\u306b\u969c\u5bb3\u7269\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u30b8\u30e3\u30f3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5408\u308f\u305b\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6700\u521d\u306e\u30bb\u30af\u30b7\u30e7\u30f3\u3067\u306f\u3001\u753b\u9762\u3092\u30bf\u30c3\u30d7\u3059\u308b\u304b\u30b9\u30da\u30fc\u30b9\u30d0\u30fc\u3092\u62bc\u3059\u3053\u3068\u3067\u3001\u9069\u5207\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u30b9\u30d1\u30a4\u30af\u3092\u98db\u3073\u8d8a\u3048\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u63b4\u3080\u305f\u3081\u306b\u3001\u30b2\u30fc\u30e0\u306e\u5b9f\u7fd2\u30e2\u30fc\u30c9\u3067\u7df4\u7fd2\u3057\u307e\u3057\u3087\u3046\u3002\u307e\u305f\u3001\u4e0a\u5411\u304d\u306b\u62bc\u3057\u3066\u3044\u308b\u9593\u306f\u4e0a\u6607\u3057\u3001\u96e2\u3059\u3068\u4e0b\u964d\u3059\u308b\u30b7\u30c3\u30d7\u30e2\u30fc\u30c9\u3092\u4f7f\u7528\u3057\u3066\u3001\u72ed\u3044\u5834\u6240\u3092\u79fb\u52d5\u3057\u307e\u3057\u3087\u3046\u3002\u91cd\u8981\u306a\u306e\u306f\u3001\u7d99\u7d9a\u7684\u306a\u7df4\u7fd2\u3067\u3059\u3002\u5931\u6557\u3059\u308b\u3053\u3068\u306a\u304f\u6700\u521d\u306e\u6570\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308b\u307e\u3067\u3001\u7df4\u7fd2\u3092\u7d9a\u3051\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002"}, {"question": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u3067\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u306e\u6700\u9069\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u3067\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5411\u4e0a\u3055\u305b\u308b\u306b\u306f\u3001\u6226\u7565\u3092\u898b\u76f4\u3059\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002STEP1\uff1a\u30e9\u30f3\u3092\u8a18\u9332\u3057\u3066\u30ec\u30d3\u30e5\u30fc\u3059\u308b\u3053\u3068\u3067\u3001\u5931\u6557\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u7279\u5b9a\u3057\u3001\u81ea\u5206\u306e\u30d7\u30ec\u30a4\u3092\u5206\u6790\u3057\u307e\u3059\u3002STEP2\uff1a\u72ed\u3044\u901a\u8def\u3092\u79fb\u52d5\u3059\u308b\u305f\u3081\u306b\u6b63\u78ba\u306a\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u304c\u5fc5\u8981\u306a\u300c\u6ce2\u300d\u30e2\u30fc\u30c9\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u4e2d\u9593\u30bb\u30af\u30b7\u30e7\u30f3\u3067\u6ce2\u30e2\u30fc\u30c9\u304c\u91cd\u8981\u3067\u3059\u3002STEP3\uff1a\u30b8\u30e3\u30f3\u30d7\u306e\u611f\u5ea6\u306a\u3069\u3092\u8abf\u6574\u3059\u308b\u306a\u3069\u3001\u3055\u307e\u3056\u307e\u306a\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u8a2d\u5b9a\u3092\u8a66\u3057\u3066\u3001\u81ea\u5206\u306b\u3068\u3063\u3066\u6700\u9069\u306a\u8a2d\u5b9a\u3092\u898b\u3064\u3051\u307e\u3057\u3087\u3046\u3002\u3053\u308c\u3089\u306e\u6226\u7565\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u3001\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u306a\u305c\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u3067\u6ce2\u30e2\u30fc\u30c9\u304c\u6700\u3082\u96e3\u3057\u3044\u3068\u3055\u308c\u3066\u3044\u308b\u306e\u3067\u3059\u304b\uff1f", "answer": "\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u3067\u6ce2\u30e2\u30fc\u30c9\u304c\u6700\u3082\u96e3\u3057\u3044\u3068\u3055\u308c\u3066\u3044\u308b\u306e\u306f\u3001\u305d\u306e\u72ec\u7279\u306e\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u30e1\u30ab\u30cb\u30ba\u30e0\u3068\u5fc5\u8981\u306a\u6b63\u78ba\u3055\u306e\u305f\u3081\u3067\u3059\u3002\u4ed6\u306e\u30e2\u30fc\u30c9\u3067\u306f\u5358\u306b\u30b8\u30e3\u30f3\u30d7\u3059\u308b\u3060\u3051\u3067\u3059\u304c\u3001\u6ce2\u30e2\u30fc\u30c9\u3067\u306f\u3001\u4e0a\u5411\u304d\u306b\u62bc\u3059\u3068\u4e0a\u6607\u3057\u3001\u96e2\u3059\u3068\u4e0b\u964d\u3059\u308b\u305f\u3081\u3001\u72ed\u3044\u5834\u6240\u3092\u79fb\u52d5\u3059\u308b\u306e\u304c\u56f0\u96e3\u306b\u306a\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u4e2d\u9593\u30bb\u30af\u30b7\u30e7\u30f3\u3067\u3001\u308f\u305a\u304b\u306a\u8aa4\u5dee\u306e\u8a31\u3055\u308c\u306a\u3044\u4e00\u9023\u306e\u72ed\u3044\u901a\u8def\u3092\u79fb\u52d5\u3059\u308b\u305f\u3081\u306b\u3001\u6ce2\u30e2\u30fc\u30c9\u3092\u983b\u7e41\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002\u9ad8\u901f\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3068\u6b63\u78ba\u306a\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u306e\u5fc5\u8981\u6027\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3001\u6ce2\u30e2\u30fc\u30c9\u306f\u7279\u306b\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u6311\u6226\u7684\u306b\u306a\u308a\u307e\u3059\u3002"}, {"question": "\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u306b\u304a\u3051\u308b\u96e3\u6613\u5ea6\u8abf\u6574\u306e\u4ed5\u7d44\u307f\u306f\u3069\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u304b\uff1f", "answer": "\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u306b\u304a\u3051\u308b\u96e3\u6613\u5ea6\u8abf\u6574\u306f\u3001\u30ec\u30d9\u30eb\u3092\u9032\u3081\u308b\u306b\u3064\u308c\u3066\u5f90\u3005\u306b\u96e3\u6613\u5ea6\u304c\u5897\u52a0\u3059\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u306b\u6163\u308c\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u3001\u3088\u308a\u5358\u7d14\u306a\u969c\u5bb3\u7269\u3068\u30da\u30fc\u30b9\u306e\u9045\u3044\u30bb\u30af\u30b7\u30e7\u30f3\u3067\u59cb\u307e\u308a\u307e\u3059\u3002\u9032\u3081\u3066\u3044\u304f\u3068\u3001\u3088\u308a\u8907\u96d1\u306a\u30d1\u30bf\u30fc\u30f3\u3001\u9ad8\u901f\u3001\u305d\u3057\u3066\u72ed\u3044\u7a7a\u9593\u304c\u5c0e\u5165\u3055\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u300d\u30ec\u30d9\u30eb\u306f\u3001\u57fa\u672c\u7684\u306a\u30b8\u30e3\u30f3\u30d7\u3067\u59cb\u307e\u308a\u3001\u3059\u3050\u306b\u6ce2\u30e2\u30fc\u30c9\u30bb\u30af\u30b7\u30e7\u30f3\u3068\u8907\u96d1\u306a\u30b9\u30d1\u30a4\u30af\u30d1\u30bf\u30fc\u30f3\u3092\u542b\u3080\u3082\u306e\u3078\u3068\u79fb\u884c\u3057\u307e\u3059\u3002\u3053\u306e\u8abf\u6574\u306b\u3088\u3063\u3066\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u7d76\u3048\u305a\u6311\u6226\u3055\u308c\u306a\u304c\u3089\u3082\u3001\u9032\u6b69\u3068\u9054\u6210\u611f\u3092\u611f\u3058\u3089\u308c\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002"}, {"question": "\u30e2\u30d0\u30a4\u30eb\u7248\u3068PC\u7248\u306e\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u306f\u3001\u3069\u306e\u3088\u3046\u306a\u91cd\u8981\u306a\u9055\u3044\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30e2\u30d0\u30a4\u30eb\u7248\u3068PC\u7248\u306e\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u9593\u306e\u91cd\u8981\u306a\u9055\u3044\u306f\u3001\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u30b9\u30ad\u30fc\u30e0\u3068\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u3042\u308a\u307e\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u7248\u3067\u306f\u3001\u30b2\u30fc\u30e0\u306f\u30bf\u30c3\u30c1\u5165\u529b\u306b\u3088\u3063\u3066\u5236\u5fa1\u3055\u308c\u3001\u7279\u306b\u6ce2\u306e\u3088\u3046\u306a\u30e2\u30fc\u30c9\u3067\u306f\u6b63\u78ba\u306a\u52d5\u304d\u304c\u3088\u308a\u56f0\u96e3\u306b\u306a\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002PC\u7248\u3067\u306f\u3001\u30b2\u30fc\u30e0\u306f\u30ad\u30fc\u30dc\u30fc\u30c9\u3092\u4f7f\u7528\u3057\u3066\u5236\u5fa1\u3055\u308c\u308b\u305f\u3081\u3001\u3088\u308a\u6b63\u78ba\u3067\u53cd\u5fdc\u6027\u304c\u9ad8\u3044\u3067\u3059\u3002\u3055\u3089\u306b\u3001PC\u7248\u3067\u306f\u3001\u30d5\u30ec\u30fc\u30e0\u30ec\u30fc\u30c8\u304c\u9ad8\u304f\u306a\u308a\u3001\u5165\u529b\u9045\u5ef6\u304c\u6e1b\u5c11\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3060\u3057\u3001\u3069\u3061\u3089\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u3082\u3001\u540c\u3058\u30b3\u30f3\u30c6\u30f3\u30c4\u3068\u30ec\u30d9\u30eb\u3092\u63d0\u4f9b\u3057\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u5168\u4f53\u3067\u4e00\u8cab\u3057\u305f\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u4fdd\u8a3c\u3057\u3066\u3044\u307e\u3059\u3002"}, {"question": "\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u3067\u30b7\u30c3\u30d7\u30e2\u30fc\u30c9\u3092\u52b9\u679c\u7684\u306b\u7df4\u7fd2\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u3067\u30b7\u30c3\u30d7\u30e2\u30fc\u30c9\u3092\u52b9\u679c\u7684\u306b\u7df4\u7fd2\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002STEP1\uff1a\u30b7\u30c3\u30d7\u306e\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3092\u63b4\u3080\u305f\u3081\u306b\u3001\u521d\u671f\u30ec\u30d9\u30eb\u3092\u30d7\u30ec\u30a4\u3059\u308b\u3053\u3068\u304b\u3089\u59cb\u3081\u307e\u3057\u3087\u3046\u3002STEP2\uff1a\u9069\u5207\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u5236\u5fa1\u5165\u529b\u3092\u62bc\u3057\u3066\u96e2\u3059\u3053\u3068\u3067\u3001\u5b89\u5b9a\u3057\u305f\u4e0a\u6607\u3068\u4e0b\u964d\u3092\u7dad\u6301\u3059\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u307e\u3057\u3087\u3046\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u6700\u5f8c\u306e\u65b9\u306b\u4e00\u9023\u306e\u79fb\u52d5\u3059\u308b\u969c\u5bb3\u7269\u3092\u79fb\u52d5\u3059\u308b\u305f\u3081\u306b\u3001\u30b7\u30c3\u30d7\u30e2\u30fc\u30c9\u304c\u4f7f\u7528\u3055\u308c\u307e\u3059\u3002STEP3\uff1a\u7df4\u7fd2\u30e2\u30fc\u30c9\u3092\u4f7f\u7528\u3057\u3066\u3001\u30c1\u30e3\u30ec\u30f3\u30b8\u30f3\u30b0\u306a\u30bb\u30af\u30b7\u30e7\u30f3\u3092\u7e70\u308a\u8fd4\u3059\u3053\u3068\u3067\u3001\u4e00\u8cab\u3057\u3066\u30af\u30ea\u30a2\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308b\u307e\u3067\u7df4\u7fd2\u3057\u307e\u3057\u3087\u3046\u3002\u30b7\u30c3\u30d7\u30e2\u30fc\u30c9\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u306b\u6642\u9593\u3092\u5272\u304f\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u5168\u4f53\u306e\u80fd\u529b\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u79d8\u5bc6\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u306b\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u5965\u884c\u304d\u3092\u52a0\u3048\u308b\u3001\u3044\u304f\u3064\u304b\u306e\u96a0\u3055\u308c\u305f\u79d8\u5bc6\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306e1\u3064\u306f\u3001\u30ec\u30d9\u30eb\u306e\u540d\u524d\u3092\u6307\u3057\u793a\u3059\u3001\u30ec\u30d9\u30eb\u4e2d\u306b\u77ed\u6642\u9593\u8868\u793a\u3055\u308c\u308b\u96a0\u3055\u308c\u305f\u300c\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u300d\u306e\u30c6\u30ad\u30b9\u30c8\u3067\u3059\u3002\u3055\u3089\u306b\u3001\u7279\u5225\u306a\u30a2\u30a4\u30b3\u30f3\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u305f\u3081\u306b\u53ce\u96c6\u3067\u304d\u308b\u3001\u30ec\u30d9\u30eb\u5168\u4f53\u306b\u6563\u3089\u3070\u3063\u3066\u3044\u308b\u96a0\u3055\u308c\u305f\u30b3\u30a4\u30f3\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30b3\u30a4\u30f3\u306e1\u3064\u306f\u3001\u30a2\u30af\u30bb\u30b9\u3059\u308b\u305f\u3081\u306b\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u5fc5\u8981\u306a\u96a0\u308c\u305f\u901a\u8def\u306b\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u79d8\u5bc6\u3092\u63a2\u6c42\u3059\u308b\u3053\u3068\u3067\u3001\u732e\u8eab\u7684\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u3001\u66f4\u306a\u308b\u6311\u6226\u3068\u5831\u916c\u304c\u4e0e\u3048\u3089\u308c\u307e\u3059\u3002"}, {"question": "\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u306b\u304a\u3051\u308b\u30c1\u30a7\u30c3\u30af\u30dd\u30a4\u30f3\u30c8\u30b7\u30b9\u30c6\u30e0\u306e\u4ed5\u7d44\u307f\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u306b\u304a\u3051\u308b\u30c1\u30a7\u30c3\u30af\u30dd\u30a4\u30f3\u30c8\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30ec\u30d9\u30eb\u306e\u7279\u5b9a\u306e\u30dd\u30a4\u30f3\u30c8\u3067\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u9032\u884c\u72b6\u6cc1\u3092\u4fdd\u5b58\u3067\u304d\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002\u30c1\u30a7\u30c3\u30af\u30dd\u30a4\u30f3\u30c8\u306b\u5230\u9054\u3059\u308b\u3068\u3001\u30b2\u30fc\u30e0\u306f\u3042\u306a\u305f\u306e\u4f4d\u7f6e\u3092\u4fdd\u5b58\u3057\u3001\u5931\u6557\u3057\u305f\u5834\u5408\u3001\u6700\u521d\u304b\u3089\u3084\u308a\u76f4\u3059\u4ee3\u308f\u308a\u306b\u3001\u305d\u306e\u5730\u70b9\u304b\u3089\u518d\u958b\u3067\u304d\u307e\u3059\u3002\u300c\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u300d\u306e\u3088\u3046\u306a\u9577\u6642\u9593\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u9032\u884c\u306b\u3042\u308f\u305b\u3066\u96e3\u6613\u5ea6\u304c\u5897\u52a0\u3059\u308b\u305f\u3081\u3001\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u7279\u306b\u4fbf\u5229\u3067\u3059\u3002\u30c1\u30a7\u30c3\u30af\u30dd\u30a4\u30f3\u30c8\u3092\u4f7f\u7528\u3059\u308b\u306b\u306f\u3001\u30c1\u30a7\u30c3\u30af\u30dd\u30a4\u30f3\u30c8\u30aa\u30fc\u30d6\u3092\u901a\u308a\u904e\u304e\u308b\u3060\u3051\u3067\u3001\u9032\u884c\u72b6\u6cc1\u304c\u4fdd\u5b58\u3055\u308c\u307e\u3059\u3002\u3053\u306e\u6a5f\u80fd\u306f\u3001\u30d5\u30e9\u30b9\u30c8\u30ec\u30fc\u30b7\u30e7\u30f3\u3092\u8efd\u6e1b\u3057\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u96e3\u3057\u3044\u30bb\u30af\u30b7\u30e7\u30f3\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3067\u304d\u308b\u3088\u3046\u306b\u3057\u3001\u30ec\u30d9\u30eb\u5168\u4f53\u3092\u3084\u308a\u76f4\u3059\u5fc5\u8981\u6027\u3092\u306a\u304f\u3057\u307e\u3059\u3002"}, {"question": "\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u3067\u6700\u9069\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u305f\u3081\u306b\u63a8\u5968\u3055\u308c\u308b\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u8a2d\u5b9a\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u3067\u6700\u9069\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u305f\u3081\u306b\u3001\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u8a2d\u5b9a\u3092\u81ea\u5206\u306e\u597d\u307f\u306b\u5408\u308f\u305b\u3066\u8abf\u6574\u3059\u308b\u3053\u3068\u3092\u304a\u52e7\u3081\u3057\u307e\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u7248\u3067\u306f\u3001\u8aa4\u3063\u305f\u5165\u529b\u306e\u6570\u3092\u6e1b\u3089\u3059\u305f\u3081\u306b\u300c\u56fa\u5b9a\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u300d\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u6709\u52b9\u306b\u3059\u308b\u3053\u3068\u3092\u691c\u8a0e\u3057\u3066\u304f\u3060\u3055\u3044\u3002PC\u7248\u3067\u306f\u3001\u30b8\u30e3\u30f3\u30d7\u306b\u30ad\u30fc\u30dc\u30fc\u30c9\u306e\u30b9\u30da\u30fc\u30b9\u30d0\u30fc\u3092\u4f7f\u7528\u3059\u308b\u306e\u304c\u3001\u4e00\u822c\u7684\u306b\u53cd\u5fdc\u6027\u304c\u9ad8\u3044\u3067\u3059\u3002\u3055\u3089\u306b\u3001\u300c\u611f\u5ea6\u300d\u8a2d\u5b9a\u3092\u8abf\u6574\u3057\u3066\u3001\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u5165\u529b\u3092\u5fae\u8abf\u6574\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u611f\u5ea6\u3092\u4e0b\u3052\u308b\u3053\u3068\u3067\u3001\u6ce2\u30e2\u30fc\u30c9\u3067\u6b63\u78ba\u306a\u52d5\u304d\u304c\u52a9\u3051\u306b\u306a\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u8a2d\u5b9a\u3092\u8a66\u3057\u3066\u3001\u81ea\u5206\u306e\u30d7\u30ec\u30a4\u3092\u6700\u9069\u5316\u3059\u308b\u8a2d\u5b9a\u3092\u898b\u3064\u3051\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u3067\u30e2\u30d0\u30a4\u30eb\u304b\u3089PC\u3078\u306e\u9032\u884c\u72b6\u6cc1\u306e\u79fb\u884c\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30ca\u30a4\u30f3\u30b5\u30fc\u30af\u30eb\u3067\u30e2\u30d0\u30a4\u30eb\u304b\u3089PC\u3078\u306e\u9032\u884c\u72b6\u6cc1\u306e\u79fb\u884c\u306f\u3001\u30b2\u30fc\u30e0\u306e\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u5b9f\u73fe\u3067\u304d\u307e\u3059\u3002\u307e\u305a\u3001\u30e2\u30d0\u30a4\u30eb\u7248\u304c\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u63a5\u7d9a\u3055\u308c\u3001\u9032\u884c\u72b6\u6cc1\u304c\u30af\u30e9\u30a6\u30c9\u306b\u4fdd\u5b58\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u6b21\u306b\u3001PC\u7248\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3068\u3001\u3042\u306a\u305f\u306e\u9032\u884c\u72b6\u6cc1\u304c\u81ea\u52d5\u7684\u306b\u540c\u671f\u3055\u308c\u308b\u306f\u305a\u3067\u3059\u3002\u554f\u984c\u304c\u767a\u751f\u3057\u305f\u5834\u5408\u3001\u30c7\u30d0\u30a4\u30b9\u4e21\u65b9\u306e\u30b2\u30fc\u30e0\u306e\u30d5\u30a1\u30a4\u30eb\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u306b\u30a2\u30af\u30bb\u30b9\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u305f\u3081\u3001\u624b\u52d5\u3067\u4fdd\u5b58\u30d5\u30a1\u30a4\u30eb\u3092\u8ee2\u9001\u3059\u308b\u3082\u30461\u3064\u306e\u65b9\u6cd5\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u624b\u9806\u306b\u5f93\u3046\u3053\u3068\u3067\u3001\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u30b7\u30fc\u30e0\u30ec\u30b9\u306b\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u7d9a\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}]
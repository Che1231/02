[{"question": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ub098\uc778 \uc11c\ud074 \ucd08\ubcf4\uc790\ub97c \uc704\ud55c \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ub9c8\uc2a4\ud130\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ub098\uc778 \uc11c\ud074\uc5d0\uc11c \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ub9c8\uc2a4\ud130\ud558\ub824\uba74, \uba3c\uc800 \uc810\ud504 \uba54\ucee4\ub2c8\uc998\uc5d0 \uc775\uc219\ud574\uc9c0\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uac8c\uc784\uc740 \uc8fc\ub85c \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uc810\ud504 \ud0c0\uc774\ubc0d\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub2e8\uacc4\uc5d0\uc11c\ub294 \ud654\uba74\uc744 \ud0ed\ud558\uac70\ub098 \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \uc801\uc808\ud55c \uc2dc\uc810\uc5d0 \ub204\ub974\uba74 \uc7a5\uc560\ubb3c\uc744 \ub6f0\uc5b4\ub118\uc5b4\uc57c \ud569\ub2c8\ub2e4. \uac8c\uc784\uc758 \uc5f0\uc2b5 \ubaa8\ub4dc\uc5d0\uc11c \uc5f0\uc2b5\ud558\uc5ec \ud0c0\uc774\ubc0d\uc5d0 \ub300\ud55c \uac10\uac01\uc744 \uc775\ud788\uc138\uc694. \ub610\ud55c, \uc120\ubc15 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc0c1\uc2b9\ud558\ub824\uba74 \ub204\ub974\uace0 \uc788\uace0 \ud558\uac15\ud558\ub824\uba74 \ub193\uc544\uc11c \uc881\uc740 \uacf5\uac04\uc744 \uc774\ub3d9\ud558\ub294 \ubc29\ubc95\uc744 \uc775\ud788\uc138\uc694. \uc911\uc694\ud55c \uac83\uc740 \uafb8\uc900\ud568\uc774\ubbc0\ub85c \uc2e4\ud328\ud558\uc9c0 \uc54a\uace0 \uccab \ubc88\uc9f8 \uba87 \ub2e8\uacc4\ub97c \ud074\ub9ac\uc5b4\ud560 \ub54c\uae4c\uc9c0 \uc5f0\uc2b5\ud558\uc138\uc694."}, {"question": "\uac8c\uc784 \ud50c\ub808\uc774 100\uc2dc\uac04 \ud6c4 \uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ub098\uc778 \uc11c\ud074\uc758 \uc131\ub2a5\uc744 \uac1c\uc120\ud558\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uac8c\uc784 \ud50c\ub808\uc774 100\uc2dc\uac04 \ud6c4, \uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ub098\uc778 \uc11c\ud074\uc758 \uc131\ub2a5\uc744 \uac1c\uc120\ud558\ub824\uba74 \uc804\ub7b5\uc744 \uac1c\uc120\ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \ud50c\ub808\uc774 \uae30\ub85d\uc744 \ub179\ud654\ud558\uace0 \uac80\ud1a0\ud558\uc5ec \uc2e4\ud328 \ud328\ud134\uc744 \ud30c\uc545\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc881\uc740 \ud1b5\ub85c\ub97c \uc774\ub3d9\ud558\uae30 \uc704\ud574 \uc815\ubc00\ud55c \uc81c\uc5b4\uac00 \ud544\uc694\ud55c \"\ud30c\ub3d9\" \ubaa8\ub4dc\ub97c \ub9c8\uc2a4\ud130\ud558\ub294 \ub370 \uc9d1\uc911\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ub098\uc778 \uc11c\ud074\" \ub808\ubca8\uc5d0\uc11c \ud30c\ub3d9 \ubaa8\ub4dc\ub294 \uc911\uac04 \ubd80\ubd84\uc5d0\uc11c \uc911\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc810\ud504 \ubbfc\uac10\ub3c4\uc640 \uac19\uc740 \ub2e4\uc591\ud55c \ucee8\ud2b8\ub864 \uc124\uc815\uc744 \uc870\uc815\ud558\uc5ec \uc790\uc2e0\uc5d0\uac8c \uac00\uc7a5 \uc798 \ub9de\ub294 \uac83\uc744 \uc2e4\ud5d8\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc804\ub7b5\uc744 \uacb0\ud569\ud558\uc5ec \ud50c\ub808\uc774\ub97c \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0a4\uace0 \ub354 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc65c \uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ub098\uc778 \uc11c\ud074\uc5d0\uc11c \ud30c\ub3d9 \ubaa8\ub4dc\uac00 \uac00\uc7a5 \uc5b4\ub824\uc6b4 \uac83\uc73c\ub85c \uac04\uc8fc\ub429\ub2c8\uae4c?", "answer": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ub098\uc778 \uc11c\ud074\uc5d0\uc11c \ud30c\ub3d9 \ubaa8\ub4dc\ub294 \uace0\uc720\ud55c \ucee8\ud2b8\ub864 \uba54\ucee4\ub2c8\uc998\uacfc \ud544\uc694\ud55c \uc815\ubc00\ub3c4\ub85c \uc778\ud574 \uac00\uc7a5 \uc5b4\ub824\uc6b4 \uac83\uc73c\ub85c \uac04\uc8fc\ub429\ub2c8\ub2e4. \ub2e8\uc21c\ud788 \uc810\ud504\ud558\ub294 \ub2e4\ub978 \ubaa8\ub4dc\uc640 \ub2ec\ub9ac, \ud30c\ub3d9 \ubaa8\ub4dc\ub294 \uc0c1\uc2b9\ud558\ub824\uba74 \ub204\ub974\uace0 \uc788\uace0 \ud558\uac15\ud558\ub824\uba74 \ub193\uc544\uc57c \ud558\ubbc0\ub85c \uc881\uc740 \uacf5\uac04\uc744 \uc774\ub3d9\ud558\uae30\uac00 \uc5b4\ub835\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ub098\uc778 \uc11c\ud074\" \ub808\ubca8\uc5d0\uc11c \ud30c\ub3d9 \ubaa8\ub4dc\ub294 \uc911\uac04 \ubd80\ubd84\uc5d0\uc11c \uad11\ubc94\uc704\ud558\uac8c \uc0ac\uc6a9\ub418\uba70, \uac70\uc758 \uc624\ub958\uc758 \uc5ec\uc9c0 \uc5c6\uc774 \uc881\uc740 \ud1b5\ub85c\ub97c \uc774\ub3d9\ud574\uc57c \ud569\ub2c8\ub2e4. \ube60\ub978 \uac8c\uc784 \ud50c\ub808\uc774\uc640 \uc815\ubc00\ud55c \uc81c\uc5b4\uac00 \ud544\uc694\ud55c \uc870\ud569\uc73c\ub85c \ud30c\ub3d9 \ubaa8\ub4dc\ub294 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ud2b9\ud788 \uc5b4\ub835\uc2b5\ub2c8\ub2e4."}, {"question": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ub098\uc778 \uc11c\ud074\uc5d0\uc11c \ub09c\uc774\ub3c4 \uc870\uc815\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ub098\uc778 \uc11c\ud074\uc5d0\uc11c \ub09c\uc774\ub3c4 \uc870\uc815\uc740 \ub808\ubca8\uc744 \uc9c4\ud589\ud560\uc218\ub85d \uc810\uc9c4\uc801\uc73c\ub85c \uc99d\uac00\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uac8c\uc784\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \ucee8\ud2b8\ub864\uc5d0 \uc775\uc219\ud574\uc9c8 \uc218 \uc788\ub3c4\ub85d \ub354 \uac04\ub2e8\ud55c \uc7a5\uc560\ubb3c\uacfc \ub290\ub9b0 \uc18d\ub3c4\uc758 \ub2e8\uacc4\ub85c \uc2dc\uc791\ud569\ub2c8\ub2e4. \uc9c4\ud589\ud568\uc5d0 \ub530\ub77c \ub808\ubca8\uc740 \ub354 \ubcf5\uc7a1\ud55c \ud328\ud134, \ub354 \ube60\ub978 \uc18d\ub3c4 \ubc0f \ub354 \uc881\uc740 \uacf5\uac04\uc744 \ub3c4\uc785\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ub098\uc778 \uc11c\ud074\" \ub808\ubca8\uc740 \uae30\ubcf8 \uc810\ud504\ub85c \uc2dc\uc791\ud558\uc9c0\ub9cc \uae08\uc0c8 \ud30c\ub3d9 \ubaa8\ub4dc \uc139\uc158\uacfc \ubcf5\uc7a1\ud55c \uc2a4\ud30c\uc774\ud06c \ud328\ud134\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc870\uc815\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \ub04a\uc784\uc5c6\uc774 \ub3c4\uc804\ubc1b\uc73c\uba74\uc11c \ub3d9\uc2dc\uc5d0 \uc9c4\ud589 \ubc0f \uc131\ucde8\uac10\uc744 \ub290\ub084 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4."}, {"question": "\ubaa8\ubc14\uc77c \ubc0f PC \ubc84\uc804\uc758 \uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ub098\uc778 \uc11c\ud074\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubaa8\ubc14\uc77c \ubc0f PC \ubc84\uc804\uc758 \uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ub098\uc778 \uc11c\ud074\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ucee8\ud2b8\ub864 \ubc29\uc2dd\uacfc \uc131\ub2a5\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \ubaa8\ubc14\uc77c\uc5d0\uc11c \uac8c\uc784\uc740 \ud130\uce58 \uc785\ub825\uc73c\ub85c \uc81c\uc5b4\ub418\ub294\ub370, \ud2b9\ud788 \ud30c\ub3d9 \ubaa8\ub4dc\ucc98\ub7fc \uc815\ubc00\ud55c \uc6c0\uc9c1\uc784\uc744 \uc218\ud589\ud558\uae30 \uc5b4\ub824\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. PC\uc5d0\uc11c\ub294 \ud0a4\ubcf4\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \uac8c\uc784\uc744 \uc81c\uc5b4\ud560 \uc218 \uc788\uc73c\uba70, \uc774\ub294 \ub354 \ub192\uc740 \uc815\ubc00\ub3c4\uc640 \ubc18\uc751\uc131\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub610\ud55c PC \ubc84\uc804\uc740 \ud504\ub808\uc784 \uc18d\ub3c4\uac00 \ub354 \ub192\uc544 \uc785\ub825 \uc9c0\uc5f0\uc774 \uc904\uc5b4\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \ub450 \ubc84\uc804 \ubaa8\ub450 \ub3d9\uc77c\ud55c \ucf58\ud150\uce20\uc640 \ub808\ubca8\uc744 \uc81c\uacf5\ud558\uc5ec \ud50c\ub7ab\ud3fc \uac04\uc5d0 \uc77c\uad00\ub41c \uac8c\uc784 \ud658\uacbd\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ub098\uc778 \uc11c\ud074\uc5d0\uc11c \uc120\ubc15 \ubaa8\ub4dc\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc5f0\uc2b5\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ub098\uc778 \uc11c\ud074\uc5d0\uc11c \uc120\ubc15 \ubaa8\ub4dc\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc5f0\uc2b5\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. \ub2e8\uacc4 1: \uc120\ubc15 \ucee8\ud2b8\ub864\uc5d0 \ub300\ud55c \uac10\uac01\uc744 \uc5bb\uae30 \uc704\ud574 \ucd08\uae30 \ub808\ubca8\uc744 \ud1b5\ud574 \ud50c\ub808\uc774\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc801\uc808\ud55c \uc2dc\uc810\uc5d0 \ucee8\ud2b8\ub864 \uc785\ub825\uc744 \ub204\ub974\uace0 \ub193\uc544\uc11c \uc9c0\uc18d\uc801\uc778 \uc0c1\uc2b9\uacfc \ud558\uac15\uc744 \uc720\uc9c0\ud558\ub294 \ub370 \uc9d1\uc911\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ub098\uc778 \uc11c\ud074\" \ub808\ubca8\uc5d0\uc11c \uc120\ubc15 \ubaa8\ub4dc\ub294 \uc5ec\ub7ec \uc6c0\uc9c1\uc774\ub294 \uc7a5\uc560\ubb3c\uc744 \uc774\ub3d9\ud574\uc57c \ud558\ub294 \ub9c8\uc9c0\ub9c9 \ub2e8\uacc4\uc5d0\uc11c \uc0ac\uc6a9\ub429\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc5b4\ub824\uc6b4 \uc139\uc158\uc744 \ubc18\ubcf5\ud558\uc5ec \uc9c0\uc18d\uc801\uc73c\ub85c \ud074\ub9ac\uc5b4\ud560 \ub54c\uae4c\uc9c0 \uc5f0\uc2b5\ud569\ub2c8\ub2e4. \uc120\ubc15 \ubaa8\ub4dc\ub97c \ub9c8\uc2a4\ud130\ud558\ub294 \ub370 \uc2dc\uac04\uc744 \ud560\uc560\ud558\uc5ec \uac8c\uc784\uc5d0\uc11c \uc804\uccb4\uc801\uc778 \uc131\ub2a5\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ub098\uc778 \uc11c\ud074\uc758 \uc228\uaca8\uc9c4 \ube44\ubc00\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ub098\uc778 \uc11c\ud074\uc5d0\ub294 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uae4a\uc774\ub97c \ub354\ud558\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \ube44\ubc00\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc8fc\ubaa9\ud560\ub9cc\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ub808\ubca8 \uc774\ub984\uc744 \uae30\ub9ac\uae30 \uc704\ud574 \ub808\ubca8 \uc911 \uc7a0\uc2dc \ub098\ud0c0\ub098\ub294 \uc228\uaca8\uc9c4 \"\ub098\uc778 \uc11c\ud074\" \ud14d\uc2a4\ud2b8\uc785\ub2c8\ub2e4. \ub610\ud55c, \ud2b9\ubcc4\ud55c \uc544\uc774\ucf58\uc744 \ud574\uc81c\ud558\uae30 \uc704\ud574 \ub808\ubca8 \uc804\ubc18\uc5d0 \ud769\uc5b4\uc838 \uc788\ub294 \uc228\uaca8\uc9c4 \ub3d9\uc804\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ub098\uc778 \uc11c\ud074\" \ub808\ubca8\uc5d0\uc11c \ub3d9\uc804 \uc911 \ud558\ub098\ub294 \uc811\uadfc\ud558\uae30 \uc704\ud574 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uc774 \ud544\uc694\ud55c \uc228\uaca8\uc9c4 \ud1b5\ub85c\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ube44\ubc00\uc744 \ud0d0\ud5d8\ud558\uba74 \ud5cc\uc2e0\uc801\uc778 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ucd94\uac00\uc801\uc778 \ub3c4\uc804\uacfc \ubcf4\uc0c1\uc774 \uc81c\uacf5\ub429\ub2c8\ub2e4."}, {"question": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ub098\uc778 \uc11c\ud074\uc758 \uccb4\ud06c\ud3ec\uc778\ud2b8 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ub098\uc778 \uc11c\ud074\uc758 \uccb4\ud06c\ud3ec\uc778\ud2b8 \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \ub808\ubca8 \ud2b9\uc815 \uc9c0\uc810\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc800\uc7a5\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. \uccb4\ud06c\ud3ec\uc778\ud2b8\uc5d0 \ub3c4\ub2ec\ud558\uba74 \uac8c\uc784\uc740 \uc704\uce58\ub97c \uc800\uc7a5\ud558\uace0 \uc2e4\ud328\ud558\uba74 \ucc98\uc74c\ubd80\ud130\uac00 \uc544\ub2c8\ub77c \ud574\ub2f9 \uc9c0\uc810\uc5d0\uc11c \uc7ac \uc2dc\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \"\ub098\uc778 \uc11c\ud074\"\uacfc \uac19\uc774 \ub09c\uc774\ub3c4\uac00 \uc9c4\ud589\ub420\uc218\ub85d \uc99d\uac00\ud558\ub294 \ub354 \uae34 \ub808\ubca8\uc5d0\uc11c \ud2b9\ud788 \uc720\uc6a9\ud569\ub2c8\ub2e4. \uccb4\ud06c\ud3ec\uc778\ud2b8\ub97c \uc0ac\uc6a9\ud558\ub824\uba74 \uccb4\ud06c\ud3ec\uc778\ud2b8 \uc624\ube0c\ub97c \ud1b5\uacfc\ud558\uae30\ub9cc \ud558\uba74 \ub429\ub2c8\ub2e4. \uc774 \uae30\ub2a5\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc5b4\ub824\uc6b4 \uc139\uc158\uc744 \ub9c8\uc2a4\ud130\ud558\ub294 \ub370 \uc9d1\uc911\ud560 \uc218 \uc788\ub3c4\ub85d \uc2e4\ub9dd\uc744 \uc904\uc774\uace0 \uc804\uccb4 \ub808\ubca8\uc744 \ub2e4\uc2dc \ud50c\ub808\uc774\ud560 \ud544\uc694\uac00 \uc5c6\uc2b5\ub2c8\ub2e4."}, {"question": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ub098\uc778 \uc11c\ud074\uc5d0\uc11c \ucd5c\uc801\uc758 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc704\ud55c \uad8c\uc7a5 \ucee8\ud2b8\ub864 \uc124\uc815\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ub098\uc778 \uc11c\ud074\uc5d0\uc11c \ucd5c\uc801\uc758 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc704\ud574 \uc0ac\uc6a9\uc790\uc758 \uc120\ud638\ub3c4\uc5d0 \ub9de\uac8c \ucee8\ud2b8\ub864 \uc124\uc815\uc744 \uc870\uc815\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \ubaa8\ubc14\uc77c\uc5d0\uc11c \"\uace0\uc815 \ucee8\ud2b8\ub864\" \uc635\uc158\uc744 \uc0ac\uc6a9\ud558\uba74 \uc2e4\uc218\ub85c \uc785\ub825\ud558\ub294 \uac83\uc744 \uc904\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. PC\uc5d0\uc11c \ud0a4\ubcf4\ub4dc\uc758 \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \uc810\ud504\uc5d0 \uc0ac\uc6a9\ud558\ub294 \uac83\uc774 \uc77c\ubc18\uc801\uc73c\ub85c \ubc18\uc751\uc131\uc774 \ub6f0\uc5b4\ub098\uae30 \ub54c\ubb38\uc5d0 \uc120\ud638\ub429\ub2c8\ub2e4. \ub610\ud55c \"\ubbfc\uac10\ub3c4\" \uc124\uc815\uc744 \uc870\uc815\ud558\uc5ec \ucee8\ud2b8\ub864 \uc785\ub825\uc744 \ubbf8\uc138 \uc870\uc815\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubbfc\uac10\ub3c4\ub97c \ub0ae\ucd94\uba74 \ud30c\ub3d9 \ubaa8\ub4dc\uc5d0\uc11c \uc815\ubc00\ud55c \uc6c0\uc9c1\uc784\uc5d0 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc0ac\uc6a9\uc790\uc5d0\uac8c \uac00\uc7a5 \uc801\ud569\ud558\uace0 \uac8c\uc784 \ud658\uacbd\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \uad6c\uc131\uc744 \ucc3e\uc73c\ub824\uace0 \uc774\ub7ec\ud55c \uc124\uc815\uc744 \uc2e4\ud5d8\ud574\ubcf4\uc138\uc694."}, {"question": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ub098\uc778 \uc11c\ud074\uc5d0\uc11c \ubaa8\ubc14\uc77c\uc5d0\uc11c PC\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\ud658\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ub098\uc778 \uc11c\ud074\uc5d0\uc11c \ubaa8\ubc14\uc77c\uc5d0\uc11c PC\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\ud658\ud558\ub824\uba74 \uac8c\uc784\uc758 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uba3c\uc800 \ubaa8\ubc14\uc77c \ubc84\uc804\uc774 \uacc4\uc815\uc5d0 \uc5f0\uacb0\ub418\uc5b4 \uc788\uace0 \uc9c4\ud589 \uc0c1\ud669\uc774 \ud074\ub77c\uc6b0\ub4dc\uc5d0 \uc800\uc7a5\ub418\uc5b4 \uc788\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. \uadf8\ub7f0 \ub2e4\uc74c PC \ubc84\uc804\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uba74 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc790\ub3d9\uc73c\ub85c \ub3d9\uae30\ud654\ub418\uc5b4\uc57c \ud569\ub2c8\ub2e4. \ubb38\uc81c\uac00 \ubc1c\uc0dd\ud558\uba74 \ub450 \uc7a5\uce58 \ubaa8\ub450\uc5d0\uc11c \uac8c\uc784 \ud30c\uc77c \ub514\ub809\ud130\ub9ac\ub97c \uc561\uc138\uc2a4\ud558\ub294 \uac83\uc774 \ud544\uc694\ud558\uae34 \ud558\uc9c0\ub9cc \uc800\uc7a5 \ud30c\uc77c\uc744 \uc218\ub3d9\uc73c\ub85c \uc804\uc1a1\ud558\ub294 \uac83\uc774 \ub610 \ub2e4\ub978 \ubc29\ubc95\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ub2e8\uacc4\ub97c \ub530\ub974\uba74 \ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc6d0\ud65c\ud558\uac8c \uac8c\uc784\uc744 \uacc4\uc18d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
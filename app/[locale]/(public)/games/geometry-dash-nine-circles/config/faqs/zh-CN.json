[{"question": "\u5982\u4f55\u638c\u63e1\u51e0\u4f55\u51b2\u523a\u4e5d\u73af\u521d\u5b66\u8005\u57fa\u7840\u63a7\u5236\uff1f", "answer": "\u8981\u638c\u63e1\u51e0\u4f55\u51b2\u523a\u4e5d\u73af\u7684\u57fa\u7840\u63a7\u5236\uff0c\u9996\u5148\u8981\u719f\u6089\u8df3\u8dc3\u673a\u5236\u3002\u8be5\u6e38\u620f\u4e3b\u8981\u8981\u6c42\u73a9\u5bb6\u51c6\u786e\u8ba1\u65f6\u8df3\u8dc3\u4ee5\u907f\u5f00\u969c\u788d\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u90e8\u5206\uff0c\u60a8\u9700\u8981\u5728\u6b63\u786e\u7684\u65f6\u95f4\u70b9\u70b9\u51fb\u5c4f\u5e55\u6216\u6309\u4e0b\u7a7a\u683c\u952e\u624d\u80fd\u8df3\u8fc7\u5c16\u523a\u3002\u5728\u6e38\u620f\u7684\u7ec3\u4e60\u6a21\u5f0f\u4e2d\u7ec3\u4e60\uff0c\u624d\u80fd\u638c\u63e1\u8df3\u8dc3\u7684\u65f6\u673a\u3002\u6b64\u5916\uff0c\u4f7f\u7528\u8239\u5f62\u6a21\u5f0f\uff0c\u6309\u4f4f\u4e0a\u5347\uff0c\u677e\u5f00\u4e0b\u964d\uff0c\u53ef\u4ee5\u7a7f\u68ad\u5728\u72ed\u7a84\u7684\u7a7a\u95f4\u4e2d\u3002\u8bb0\u4f4f\uff0c\u6301\u7eed\u7ec3\u4e60\u662f\u5173\u952e\uff0c\u6240\u4ee5\u8bf7\u4e0d\u65ad\u7ec3\u4e60\uff0c\u76f4\u5230\u60a8\u80fd\u591f\u6e05\u9664\u524d\u51e0\u4e2a\u5173\u5361\u800c\u4e0d\u5931\u8d25\u3002"}, {"question": "\u5728\u6e38\u620f\u73a9\u4e86100\u5c0f\u65f6\u540e\uff0c\u63d0\u9ad8\u51e0\u4f55\u51b2\u523a\u4e5d\u73af\u6027\u80fd\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u73a9\u4e86100\u4e2a\u5c0f\u65f6\u540e\uff0c\u63d0\u9ad8\u51e0\u4f55\u51b2\u523a\u4e5d\u73af\u7684\u6027\u80fd\u9700\u8981\u6539\u8fdb\u4f60\u7684\u7b56\u7565\u3002\u6b65\u9aa41\uff1a\u901a\u8fc7\u5f55\u5236\u548c\u56de\u987e\u4f60\u7684\u6e38\u620f\u8fc7\u7a0b\u6765\u5206\u6790\u4f60\u7684\u6e38\u620f\uff0c\u627e\u51fa\u5931\u8d25\u7684\u6a21\u5f0f\u3002\u6b65\u9aa42\uff1a\u4e13\u6ce8\u4e8e\u638c\u63e1\u201c\u6ce2\u6d6a\u201d\u6a21\u5f0f\uff0c\u8be5\u6a21\u5f0f\u9700\u8981\u7cbe\u786e\u63a7\u5236\u624d\u80fd\u901a\u8fc7\u72ed\u7a84\u7684\u7a7a\u95f4\u3002\u4f8b\u5982\uff0c\u5728\u201c\u4e5d\u73af\u201d\u5173\u5361\u4e2d\uff0c\u6ce2\u6d6a\u6a21\u5f0f\u5bf9\u4e8e\u4e2d\u95f4\u90e8\u5206\u81f3\u5173\u91cd\u8981\u3002\u6b65\u9aa43\uff1a\u5c1d\u8bd5\u4e0d\u540c\u7684\u63a7\u5236\u8bbe\u7f6e\uff0c\u4f8b\u5982\u8c03\u6574\u8df3\u8dc3\u7075\u654f\u5ea6\uff0c\u627e\u5230\u6700\u9002\u5408\u4f60\u7684\u8bbe\u7f6e\u3002\u901a\u8fc7\u7ed3\u5408\u8fd9\u4e9b\u7b56\u7565\uff0c\u4f60\u53ef\u4ee5\u663e\u8457\u63d0\u5347\u4f60\u7684\u6e38\u620f\u8868\u73b0\uff0c\u5e76\u83b7\u5f97\u66f4\u9ad8\u7684\u5206\u6570\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u6ce2\u6d6a\u6a21\u5f0f\u88ab\u8ba4\u4e3a\u662f\u51e0\u4f55\u51b2\u523a\u4e5d\u73af\u4e2d\u6700\u5177\u6311\u6218\u6027\u7684\u6a21\u5f0f\uff1f", "answer": "\u51e0\u4f55\u51b2\u523a\u4e5d\u73af\u4e2d\u7684\u6ce2\u6d6a\u6a21\u5f0f\u4e4b\u6240\u4ee5\u88ab\u8ba4\u4e3a\u662f\u6700\u5177\u6311\u6218\u6027\u7684\u6a21\u5f0f\uff0c\u662f\u56e0\u4e3a\u5176\u72ec\u7279\u7684\u63a7\u5236\u673a\u5236\u548c\u7cbe\u786e\u5ea6\u8981\u6c42\u3002\u4e0e\u5176\u4ed6\u4ec5\u9700\u8df3\u8dc3\u7684\u6a21\u5f0f\u4e0d\u540c\uff0c\u6ce2\u6d6a\u6a21\u5f0f\u9700\u8981\u6309\u4f4f\u4e0a\u5347\uff0c\u677e\u5f00\u4e0b\u964d\uff0c\u8fd9\u4f7f\u5f97\u5728\u72ed\u7a84\u7684\u7a7a\u95f4\u4e2d\u8fdb\u884c\u5bfc\u822a\u53d8\u5f97\u56f0\u96be\u3002\u4f8b\u5982\uff0c\u5728\u201c\u4e5d\u73af\u201d\u5173\u5361\u4e2d\uff0c\u6ce2\u6d6a\u6a21\u5f0f\u5728\u4e2d\u95f4\u90e8\u5206\u88ab\u5e7f\u6cdb\u4f7f\u7528\uff0c\u4f60\u5fc5\u987b\u5728\u6781\u5c0f\u7684\u9519\u8bef\u5bb9\u5fcd\u8303\u56f4\u5185\u7a7f\u8fc7\u4e00\u7cfb\u5217\u72ed\u7a84\u7684\u901a\u9053\u3002\u5feb\u901f\u7684\u6e38\u620f\u8282\u594f\u548c\u7cbe\u786e\u63a7\u5236\u7684\u9700\u6c42\u5171\u540c\u6784\u6210\u4e86\u6ce2\u6d6a\u6a21\u5f0f\u5bf9\u73a9\u5bb6\u6781\u5927\u7684\u6311\u6218\u3002"}, {"question": "\u51e0\u4f55\u51b2\u523a\u4e5d\u73af\u7684\u96be\u5ea6\u63d0\u5347\u673a\u5236\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u51e0\u4f55\u51b2\u523a\u4e5d\u73af\u7684\u96be\u5ea6\u63d0\u5347\u673a\u5236\u65e8\u5728\u968f\u7740\u4f60\u901a\u8fc7\u5173\u5361\u800c\u9010\u6e10\u589e\u52a0\u3002\u6e38\u620f\u4e00\u5f00\u59cb\u4f1a\u63d0\u4f9b\u7b80\u5355\u7684\u969c\u788d\u7269\u548c\u6162\u8282\u594f\u7684\u90e8\u5206\uff0c\u8ba9\u73a9\u5bb6\u9002\u5e94\u63a7\u5236\u3002\u968f\u7740\u4f60\u524d\u8fdb\uff0c\u5173\u5361\u4f1a\u5f15\u5165\u66f4\u590d\u6742\u7684\u6a21\u5f0f\u3001\u66f4\u5feb\u7684\u901f\u5ea6\u548c\u66f4\u72ed\u7a84\u7684\u7a7a\u95f4\u3002\u4f8b\u5982\uff0c\u201c\u4e5d\u73af\u201d\u5173\u5361\u4e00\u5f00\u59cb\u662f\u57fa\u7840\u8df3\u8dc3\uff0c\u4f46\u5f88\u5feb\u5c31\u4f1a\u5f15\u5165\u6ce2\u6d6a\u6a21\u5f0f\u90e8\u5206\u548c\u590d\u6742\u7684\u5c16\u523a\u6a21\u5f0f\u3002\u8fd9\u79cd\u63d0\u5347\u673a\u5236\u786e\u4fdd\u4e86\u73a9\u5bb6\u4e0d\u65ad\u53d7\u5230\u6311\u6218\uff0c\u540c\u65f6\u4e5f\u63d0\u4f9b\u4e86\u8fdb\u6b65\u548c\u6210\u5c31\u611f\u3002"}, {"question": "\u79fb\u52a8\u7248\u548cPC\u7248\u7684\u51e0\u4f55\u51b2\u523a\u4e5d\u73af\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u79fb\u52a8\u7248\u548cPC\u7248\u51e0\u4f55\u51b2\u523a\u4e5d\u73af\u7684\u5173\u952e\u533a\u522b\u5728\u4e8e\u63a7\u5236\u65b9\u6848\u548c\u6027\u80fd\u3002\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\uff0c\u6e38\u620f\u901a\u8fc7\u89e6\u63a7\u8f93\u5165\u8fdb\u884c\u63a7\u5236\uff0c\u8fd9\u5bf9\u4e8e\u7cbe\u786e\u79fb\u52a8\uff0c\u5c24\u5176\u662f\u5728\u6ce2\u6d6a\u6a21\u5f0f\u4e0b\uff0c\u53ef\u80fd\u4f1a\u66f4\u52a0\u5177\u6709\u6311\u6218\u6027\u3002\u5728PC\u4e0a\uff0c\u6e38\u620f\u4f7f\u7528\u952e\u76d8\u63a7\u5236\uff0c\u8fd9\u63d0\u4f9b\u4e86\u66f4\u9ad8\u7684\u7cbe\u786e\u6027\u548c\u54cd\u5e94\u901f\u5ea6\u3002\u6b64\u5916\uff0cPC\u7248\u672c\u53ef\u80fd\u5177\u6709\u66f4\u9ad8\u7684\u5e27\u7387\u548c\u66f4\u597d\u7684\u6027\u80fd\uff0c\u4ece\u800c\u51cf\u5c11\u8f93\u5165\u5ef6\u8fdf\u3002\u7136\u800c\uff0c\u4e24\u4e2a\u7248\u672c\u90fd\u63d0\u4f9b\u76f8\u540c\u7684\u5173\u5361\u548c\u5185\u5bb9\uff0c\u786e\u4fdd\u4e86\u8de8\u5e73\u53f0\u7684\u4e00\u81f4\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u51e0\u4f55\u51b2\u523a\u4e5d\u73af\u4e2d\u6709\u6548\u7ec3\u4e60\u8239\u5f62\u6a21\u5f0f\uff1f", "answer": "\u8981\u6709\u6548\u5730\u7ec3\u4e60\u51e0\u4f55\u51b2\u523a\u4e5d\u73af\u4e2d\u7684\u8239\u5f62\u6a21\u5f0f\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u9996\u5148\u901a\u8fc7\u65e9\u671f\u5173\u5361\u6765\u611f\u53d7\u8239\u7684\u63a7\u5236\u3002\u6b65\u9aa42\uff1a\u4e13\u6ce8\u4e8e\u901a\u8fc7\u5728\u6b63\u786e\u65f6\u95f4\u6309\u4f4f\u548c\u91ca\u653e\u63a7\u5236\u8f93\u5165\u6765\u4fdd\u6301\u7a33\u5b9a\u7684\u4e0a\u5347\u548c\u4e0b\u964d\u3002\u4f8b\u5982\uff0c\u5728\u201c\u4e5d\u73af\u201d\u5173\u5361\u4e2d\uff0c\u8239\u5f62\u6a21\u5f0f\u7528\u4e8e\u6700\u7ec8\u90e8\u5206\uff0c\u4f60\u5fc5\u987b\u5728\u79fb\u52a8\u7684\u969c\u788d\u7269\u4e2d\u5bfc\u822a\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u7ec3\u4e60\u6a21\u5f0f\u91cd\u590d\u6709\u6311\u6218\u6027\u7684\u90e8\u5206\uff0c\u76f4\u5230\u4f60\u53ef\u4ee5\u6301\u7eed\u6e05\u9664\u5b83\u4eec\u3002\u901a\u8fc7\u6295\u5165\u65f6\u95f4\u6765\u638c\u63e1\u8239\u5f62\u6a21\u5f0f\uff0c\u4f60\u53ef\u4ee5\u63d0\u9ad8\u4f60\u5728\u6e38\u620f\u4e2d\u7684\u6574\u4f53\u8868\u73b0\u3002"}, {"question": "\u51e0\u4f55\u51b2\u523a\u4e5d\u73af\u4e2d\u9690\u85cf\u7684\u79d8\u5bc6\u6216\u5f69\u86cb\u662f\u4ec0\u4e48\uff1f", "answer": "\u51e0\u4f55\u51b2\u523a\u4e5d\u73af\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u7684\u79d8\u5bc6\u548c\u5f69\u86cb\uff0c\u589e\u52a0\u4e86\u6e38\u620f\u7684\u6df1\u5ea6\u3002\u4e00\u4e2a\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\u5728\u5173\u5361\u8fc7\u7a0b\u4e2d\u77ed\u6682\u51fa\u73b0\u7684\u9690\u85cf\u7684\u201c\u4e5d\u73af\u201d\u6587\u5b57\uff0c\u662f\u5bf9\u5173\u5361\u540d\u79f0\u7684\u81f4\u656c\u3002\u6b64\u5916\uff0c\u5173\u5361\u4e2d\u6563\u843d\u7740\u9690\u85cf\u7684\u786c\u5e01\uff0c\u53ef\u4ee5\u6536\u96c6\u8fd9\u4e9b\u786c\u5e01\u6765\u89e3\u9501\u7279\u6b8a\u56fe\u6807\u3002\u4f8b\u5982\uff0c\u5728\u201c\u4e5d\u73af\u201d\u5173\u5361\u4e2d\uff0c\u5176\u4e2d\u4e00\u4e2a\u786c\u5e01\u4f4d\u4e8e\u9700\u8981\u7cbe\u786e\u8ba1\u65f6\u624d\u80fd\u8fdb\u5165\u7684\u9690\u85cf\u901a\u9053\u4e2d\u3002\u63a2\u7d22\u8fd9\u4e9b\u79d8\u5bc6\u53ef\u4ee5\u4e3a\u79ef\u6781\u53c2\u4e0e\u6e38\u620f\u7684\u73a9\u5bb6\u63d0\u4f9b\u989d\u5916\u7684\u6311\u6218\u548c\u5956\u52b1\u3002"}, {"question": "\u51e0\u4f55\u51b2\u523a\u4e5d\u73af\u4e2d\u7684\u68c0\u67e5\u70b9\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u51e0\u4f55\u51b2\u523a\u4e5d\u73af\u4e2d\u7684\u68c0\u67e5\u70b9\u7cfb\u7edf\u5141\u8bb8\u73a9\u5bb6\u5728\u5173\u5361\u4e2d\u7684\u7279\u5b9a\u70b9\u4fdd\u5b58\u8fdb\u5ea6\u3002\u5f53\u4f60\u5230\u8fbe\u68c0\u67e5\u70b9\u65f6\uff0c\u6e38\u620f\u4f1a\u4fdd\u5b58\u4f60\u7684\u4f4d\u7f6e\uff0c\u5982\u679c\u4f60\u5931\u8d25\u4e86\uff0c\u4f60\u53ef\u4ee5\u4ece\u8be5\u70b9\u800c\u4e0d\u662f\u4ece\u5934\u5f00\u59cb\u91cd\u65b0\u5f00\u59cb\u3002\u8fd9\u4e2a\u7cfb\u7edf\u5728\u50cf\u201c\u4e5d\u73af\u201d\u8fd9\u6837\u8f83\u957f\u7684\u5173\u5361\u4e2d\u5c24\u5176\u6709\u7528\uff0c\u56e0\u4e3a\u96be\u5ea6\u4f1a\u968f\u7740\u8fdb\u5ea6\u800c\u589e\u52a0\u3002\u8981\u4f7f\u7528\u68c0\u67e5\u70b9\uff0c\u53ea\u9700\u901a\u8fc7\u68c0\u67e5\u70b9\u62a4\u76fe\uff0c\u4f60\u7684\u8fdb\u5ea6\u5c06\u4f1a\u88ab\u4fdd\u5b58\u3002\u6b64\u529f\u80fd\u6709\u52a9\u4e8e\u51cf\u5c11\u6cae\u4e27\u611f\uff0c\u5e76\u5141\u8bb8\u73a9\u5bb6\u4e13\u6ce8\u4e8e\u638c\u63e1\u5177\u6709\u6311\u6218\u6027\u7684\u90e8\u5206\uff0c\u800c\u65e0\u9700\u91cd\u65b0\u73a9\u6574\u4e2a\u5173\u5361\u3002"}, {"question": "\u5728\u51e0\u4f55\u51b2\u523a\u4e5d\u73af\u4e2d\uff0c\u54ea\u4e9b\u63a7\u5236\u8bbe\u7f6e\u5efa\u8bae\u7528\u4e8e\u6700\u4f73\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u4e3a\u4e86\u5728\u51e0\u4f55\u51b2\u523a\u4e5d\u73af\u4e2d\u83b7\u5f97\u6700\u4f73\u6e38\u620f\u4f53\u9a8c\uff0c\u5efa\u8bae\u8c03\u6574\u63a7\u5236\u8bbe\u7f6e\u4ee5\u9002\u5e94\u4f60\u7684\u559c\u597d\u3002\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\uff0c\u8003\u8651\u542f\u7528\u201c\u56fa\u5b9a\u63a7\u4ef6\u201d\u9009\u9879\u4ee5\u51cf\u5c11\u610f\u5916\u8f93\u5165\u3002\u5728PC\u4e0a\uff0c\u901a\u5e38\u5efa\u8bae\u4f7f\u7528\u952e\u76d8\u7684\u7a7a\u683c\u952e\u8fdb\u884c\u8df3\u8dc3\uff0c\u56e0\u4e3a\u5176\u54cd\u5e94\u901f\u5ea6\u66f4\u5feb\u3002\u6b64\u5916\uff0c\u4f60\u53ef\u4ee5\u8c03\u6574\u201c\u7075\u654f\u5ea6\u201d\u8bbe\u7f6e\uff0c\u4ee5\u5fae\u8c03\u4f60\u7684\u63a7\u5236\u8f93\u5165\u3002\u4f8b\u5982\uff0c\u964d\u4f4e\u7075\u654f\u5ea6\u6709\u52a9\u4e8e\u5728\u6ce2\u6d6a\u6a21\u5f0f\u4e2d\u8fdb\u884c\u7cbe\u786e\u79fb\u52a8\u3002\u5c1d\u8bd5\u8fd9\u4e9b\u8bbe\u7f6e\uff0c\u627e\u5230\u6700\u9002\u5408\u4f60\u5e76\u589e\u5f3a\u4f60\u7684\u6e38\u620f\u4f53\u9a8c\u7684\u914d\u7f6e\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5c06\u79fb\u52a8\u7248\u8fdb\u5ea6\u8f6c\u6362\u5230PC\u7248\u51e0\u4f55\u51b2\u523a\u4e5d\u73af\uff1f", "answer": "\u5728\u51e0\u4f55\u51b2\u523a\u4e5d\u73af\u4e2d\u5c06\u79fb\u52a8\u7248\u8fdb\u5ea6\u8f6c\u6362\u5230PC\u7248\u53ef\u4ee5\u901a\u8fc7\u4f7f\u7528\u6e38\u620f\u7684\u4e91\u7aef\u4fdd\u5b58\u529f\u80fd\u5b9e\u73b0\u3002\u9996\u5148\uff0c\u786e\u4fdd\u4f60\u7684\u79fb\u52a8\u7248\u8fde\u63a5\u5230\u4f60\u7684\u5e10\u6237\uff0c\u5e76\u4e14\u4f60\u7684\u8fdb\u5ea6\u5df2\u4fdd\u5b58\u5728\u4e91\u7aef\u3002\u7136\u540e\uff0c\u767b\u5f55\u5230PC\u7248\u4e0a\u7684\u540c\u4e00\u5e10\u6237\uff0c\u4f60\u7684\u8fdb\u5ea6\u5e94\u8be5\u4f1a\u81ea\u52a8\u540c\u6b65\u3002\u5982\u679c\u4f60\u9047\u5230\u95ee\u9898\uff0c\u624b\u52a8\u4f20\u8f93\u4fdd\u5b58\u6587\u4ef6\u4e5f\u662f\u4e00\u79cd\u9009\u62e9\uff0c\u5c3d\u7ba1\u5b83\u9700\u8981\u8bbf\u95ee\u4e24\u53f0\u8bbe\u5907\u4e0a\u7684\u6e38\u620f\u6587\u4ef6\u76ee\u5f55\u3002\u6309\u7167\u8fd9\u4e9b\u6b65\u9aa4\uff0c\u4f60\u5c31\u53ef\u4ee5\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e0a\u987a\u7545\u5730\u7ee7\u7eed\u4f60\u7684\u6e38\u620f\u3002"}]
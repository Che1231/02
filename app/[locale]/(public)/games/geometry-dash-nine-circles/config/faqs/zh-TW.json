[{"question": "\u5982\u4f55\u8b93\u521d\u5b78\u8005\u7cbe\u901a\u5e7e\u4f55\u9054\u4eba\u4e5d\u500b\u5713\u5708\u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u7cbe\u901a\u5e7e\u4f55\u9054\u4eba\u4e5d\u500b\u5713\u5708\u7684\u57fa\u672c\u63a7\u5236\uff0c\u9996\u5148\u8981\u719f\u6089\u8df3\u8e8d\u6a5f\u5236\u3002\u904a\u6232\u4e3b\u8981\u8981\u6c42\u73a9\u5bb6\u6e96\u78ba\u638c\u63e1\u8df3\u8e8d\u6642\u6a5f\u4ee5\u907f\u958b\u969c\u7919\u3002\u4f8b\u5982\uff0c\u7b2c\u4e00\u500b\u90e8\u5206\uff0c\u4f60\u9700\u8981\u5728\u6b63\u78ba\u7684\u6642\u523b\u9ede\u64ca\u87a2\u5e55\u6216\u6309\u4e0b\u7a7a\u683c\u9375\u624d\u80fd\u8df3\u904e\u5c16\u523a\u3002\u5728\u904a\u6232\u7684\u7df4\u7fd2\u6a21\u5f0f\u4e2d\u7df4\u7fd2\uff0c\u5c31\u80fd\u638c\u63e1\u8df3\u8e8d\u7684\u6642\u6a5f\u3002\u6b64\u5916\uff0c\u4f7f\u7528\u8266\u8247\u6a21\u5f0f\uff0c\u6309\u4f4f\u87a2\u5e55\u53ef\u4e0a\u5347\uff0c\u9b06\u958b\u53ef\u4e0b\u964d\uff0c\u4ee5\u7a7f\u904e\u72f9\u7a84\u7684\u7a7a\u9593\u3002\u8a18\u4f4f\uff0c\u6301\u7e8c\u7df4\u7fd2\u81f3\u95dc\u91cd\u8981\uff0c\u4fdd\u6301\u7df4\u7fd2\u76f4\u5230\u4f60\u80fd\u9806\u5229\u901a\u904e\u524d\u5e7e\u500b\u95dc\u5361\u800c\u4e0d\u5931\u6557\u3002"}, {"question": "\u5728\u73a9\u4e86100\u5c0f\u6642\u7684\u5e7e\u4f55\u9054\u4eba\u4e5d\u500b\u5713\u5708\u5f8c\uff0c\u5982\u4f55\u6539\u5584\u904a\u6232\u8868\u73fe\uff1f", "answer": "\u5728\u73a9\u4e86100\u5c0f\u6642\u5f8c\uff0c\u8981\u6539\u5584\u5e7e\u4f55\u9054\u4eba\u4e5d\u500b\u5713\u5708\u7684\u904a\u6232\u8868\u73fe\uff0c\u9700\u8981\u7cbe\u9032\u7b56\u7565\u3002\u6b65\u9a5f\u4e00\uff1a\u5206\u6790\u4f60\u7684\u904a\u6232\u5f71\u7247\u4e26\u6aa2\u8996\u4f60\u7684\u904a\u6232\u904e\u7a0b\uff0c\u4ee5\u627e\u51fa\u5931\u6557\u6a21\u5f0f\u3002\u6b65\u9a5f\u4e8c\uff1a\u5c08\u6ce8\u65bc\u638c\u63e1\u300c\u6ce2\u6d6a\u300d\u6a21\u5f0f\uff0c\u9019\u9700\u8981\u7cbe\u78ba\u7684\u63a7\u5236\u624d\u80fd\u7a7f\u904e\u72f9\u7a84\u7684\u901a\u9053\u3002\u4f8b\u5982\uff0c\u5728\u300c\u4e5d\u500b\u5713\u5708\u300d\u95dc\u5361\u4e2d\uff0c\u6ce2\u6d6a\u6a21\u5f0f\u5c0d\u65bc\u4e2d\u9593\u90e8\u5206\u81f3\u95dc\u91cd\u8981\u3002\u6b65\u9a5f\u4e09\uff1a\u5617\u8a66\u4e0d\u540c\u7684\u63a7\u5236\u8a2d\u5b9a\uff0c\u4f8b\u5982\u8abf\u6574\u8df3\u8e8d\u9748\u654f\u5ea6\uff0c\u627e\u51fa\u6700\u9069\u5408\u4f60\u7684\u8a2d\u5b9a\u3002\u900f\u904e\u7d50\u5408\u9019\u4e9b\u7b56\u7565\uff0c\u4f60\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u4f60\u7684\u904a\u6232\u8868\u73fe\u4e26\u7372\u5f97\u66f4\u9ad8\u7684\u5206\u6578\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u5e7e\u4f55\u9054\u4eba\u4e5d\u500b\u5713\u5708\u7684\u6ce2\u6d6a\u6a21\u5f0f\u88ab\u8a8d\u70ba\u662f\u6700\u5177\u6311\u6230\u6027\u7684\uff1f", "answer": "\u5e7e\u4f55\u9054\u4eba\u4e5d\u500b\u5713\u5708\u7684\u6ce2\u6d6a\u6a21\u5f0f\u88ab\u8a8d\u70ba\u662f\u6700\u5177\u6311\u6230\u6027\u7684\uff0c\u9019\u662f\u7531\u65bc\u5176\u7368\u7279\u7684\u63a7\u5236\u6a5f\u5236\u548c\u6240\u9700\u7684\u6e96\u78ba\u6027\u3002\u8207\u5176\u4ed6\u55ae\u7d14\u8df3\u8e8d\u7684\u6a21\u5f0f\u4e0d\u540c\uff0c\u6ce2\u6d6a\u6a21\u5f0f\u9700\u8981\u6309\u4f4f\u87a2\u5e55\u4e0a\u5347\u4e26\u9b06\u958b\u4e0b\u964d\uff0c\u9019\u4f7f\u5f97\u5728\u72f9\u7a84\u7a7a\u9593\u4e2d\u96e3\u4ee5\u99d5\u99ad\u3002\u4f8b\u5982\uff0c\u5728\u300c\u4e5d\u500b\u5713\u5708\u300d\u95dc\u5361\u4e2d\uff0c\u6ce2\u6d6a\u6a21\u5f0f\u5728\u4e2d\u9593\u90e8\u5206\u88ab\u5ee3\u6cdb\u61c9\u7528\uff0c\u4f60\u9700\u8981\u5728\u6975\u5c0f\u7684\u7a7a\u9593\u8aa4\u5dee\u7bc4\u570d\u5167\u7a7f\u904e\u4e00\u7cfb\u5217\u72f9\u7a84\u7684\u901a\u9053\u3002\u5feb\u7bc0\u594f\u7684\u904a\u6232\u8207\u7cbe\u78ba\u63a7\u5236\u7684\u9700\u6c42\u76f8\u7d50\u5408\uff0c\u4f7f\u5f97\u6ce2\u6d6a\u6a21\u5f0f\u5c0d\u73a9\u5bb6\u4f86\u8aaa\u7279\u5225\u5177\u6709\u6311\u6230\u6027\u3002"}, {"question": "\u5e7e\u4f55\u9054\u4eba\u4e5d\u500b\u5713\u5708\u7684\u96e3\u5ea6\u905e\u589e\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u5e7e\u4f55\u9054\u4eba\u4e5d\u500b\u5713\u5708\u7684\u96e3\u5ea6\u905e\u589e\u8a2d\u8a08\uff0c\u65e8\u5728\u96a8\u8457\u4f60\u901a\u95dc\u4e0d\u540c\u95dc\u5361\u800c\u9010\u6b65\u589e\u52a0\u3002\u904a\u6232\u4e00\u958b\u59cb\u6703\u51fa\u73fe\u7c21\u55ae\u7684\u969c\u7919\u7269\u548c\u7de9\u6162\u7684\u7bc0\u594f\uff0c\u8b93\u73a9\u5bb6\u719f\u6089\u63a7\u5236\u3002\u96a8\u8457\u4f60\u524d\u9032\uff0c\u95dc\u5361\u6703\u52a0\u5165\u66f4\u8907\u96dc\u7684\u5716\u6848\u3001\u66f4\u5feb\u7684\u901f\u5ea6\u548c\u66f4\u72f9\u7a84\u7684\u7a7a\u9593\u3002\u4f8b\u5982\uff0c\u300c\u4e5d\u500b\u5713\u5708\u300d\u95dc\u5361\u4e00\u958b\u59cb\u662f\u57fa\u672c\u8df3\u8e8d\uff0c\u4f46\u5f88\u5feb\u4fbf\u6703\u52a0\u5165\u6ce2\u6d6a\u6a21\u5f0f\u90e8\u5206\u548c\u8907\u96dc\u7684\u5c16\u523a\u5716\u6848\u3002\u9019\u7a2e\u905e\u589e\u8a2d\u8a08\u78ba\u4fdd\u73a9\u5bb6\u4e0d\u65b7\u53d7\u5230\u6311\u6230\uff0c\u540c\u6642\u4e5f\u63d0\u4f9b\u4e86\u9032\u6b65\u548c\u6210\u5c31\u611f\u3002"}, {"question": "\u624b\u6a5f\u7248\u548c\u96fb\u8166\u7248\u5e7e\u4f55\u9054\u4eba\u4e5d\u500b\u5713\u5708\u4e4b\u9593\u6709\u4ec0\u9ebc\u95dc\u9375\u5dee\u7570\uff1f", "answer": "\u624b\u6a5f\u7248\u548c\u96fb\u8166\u7248\u5e7e\u4f55\u9054\u4eba\u4e5d\u500b\u5713\u5708\u4e4b\u9593\u7684\u95dc\u9375\u5dee\u7570\u5728\u65bc\u63a7\u5236\u65b9\u6848\u548c\u6548\u80fd\u3002\u5728\u624b\u6a5f\u4e0a\uff0c\u904a\u6232\u4f7f\u7528\u89f8\u63a7\u8f38\u5165\uff0c\u9019\u5728\u7cbe\u78ba\u79fb\u52d5\u65b9\u9762\u53ef\u80fd\u66f4\u5177\u6311\u6230\u6027\uff0c\u5c24\u5176\u662f\u5728\u6ce2\u6d6a\u6a21\u5f0f\u4e2d\u3002\u5728\u96fb\u8166\u4e0a\uff0c\u904a\u6232\u4f7f\u7528\u9375\u76e4\u63a7\u5236\uff0c\u9019\u63d0\u4f9b\u4e86\u66f4\u9ad8\u7684\u6e96\u78ba\u6027\u548c\u97ff\u61c9\u901f\u5ea6\u3002\u6b64\u5916\uff0c\u96fb\u8166\u7248\u53ef\u80fd\u64c1\u6709\u66f4\u9ad8\u7684\u5e40\u7387\u548c\u66f4\u597d\u7684\u6548\u80fd\uff0c\u6e1b\u5c11\u8f38\u5165\u5ef6\u9072\u3002\u7136\u800c\uff0c\u5169\u500b\u7248\u672c\u90fd\u63d0\u4f9b\u76f8\u540c\u7684\u5167\u5bb9\u548c\u95dc\u5361\uff0c\u78ba\u4fdd\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u64c1\u6709\u4e00\u81f4\u7684\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u5e7e\u4f55\u9054\u4eba\u4e5d\u500b\u5713\u5708\u4e2d\u6709\u6548\u7df4\u7fd2\u8266\u8247\u6a21\u5f0f\uff1f", "answer": "\u8981\u6709\u6548\u7df4\u7fd2\u5e7e\u4f55\u9054\u4eba\u4e5d\u500b\u5713\u5708\u7684\u8266\u8247\u6a21\u5f0f\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f\u4e00\uff1a\u5f9e\u4e00\u958b\u59cb\u7684\u95dc\u5361\u958b\u59cb\uff0c\u719f\u6089\u8266\u8247\u7684\u63a7\u5236\u3002\u6b65\u9a5f\u4e8c\uff1a\u5c08\u6ce8\u65bc\u4fdd\u6301\u7a69\u5b9a\u7684\u4e0a\u5347\u548c\u4e0b\u964d\uff0c\u5728\u6b63\u78ba\u7684\u6642\u9593\u6309\u4f4f\u548c\u91cb\u653e\u63a7\u5236\u8f38\u5165\u3002\u4f8b\u5982\uff0c\u300c\u4e5d\u500b\u5713\u5708\u300d\u95dc\u5361\u7684\u6700\u5f8c\u4e00\u500b\u90e8\u5206\u4f7f\u7528\u4e86\u8266\u8247\u6a21\u5f0f\uff0c\u4f60\u9700\u8981\u7a7f\u904e\u4e00\u7cfb\u5217\u79fb\u52d5\u7684\u969c\u7919\u7269\u3002\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u7df4\u7fd2\u6a21\u5f0f\u91cd\u8907\u6311\u6230\u6027\u7684\u90e8\u5206\uff0c\u76f4\u5230\u4f60\u80fd\u5920\u9023\u7e8c\u5b8c\u6210\u5b83\u5011\u3002\u900f\u904e\u5c08\u6ce8\u6642\u9593\u638c\u63e1\u8266\u8247\u6a21\u5f0f\uff0c\u4f60\u53ef\u4ee5\u63d0\u5347\u4f60\u5728\u904a\u6232\u4e2d\u7684\u6574\u9ad4\u8868\u73fe\u3002"}, {"question": "\u5e7e\u4f55\u9054\u4eba\u4e5d\u500b\u5713\u5708\u4e2d\u6709\u4ec0\u9ebc\u96b1\u85cf\u7684\u79d8\u5bc6\u6216\u5f69\u86cb\uff1f", "answer": "\u5e7e\u4f55\u9054\u4eba\u4e5d\u500b\u5713\u5708\u5305\u542b\u4e00\u4e9b\u96b1\u85cf\u7684\u79d8\u5bc6\u548c\u5f69\u86cb\uff0c\u70ba\u904a\u6232\u589e\u52a0\u6df1\u5ea6\u3002\u503c\u5f97\u6ce8\u610f\u7684\u662f\uff0c\u5728\u95dc\u5361\u4e2d\uff0c\u6703\u77ed\u66ab\u51fa\u73fe\u96b1\u85cf\u7684\u300c\u4e5d\u500b\u5713\u5708\u300d\u6587\u5b57\uff0c\u9019\u662f\u5c0d\u9019\u95dc\u5361\u540d\u7a31\u7684\u81f4\u656c\u3002\u6b64\u5916\uff0c\u95dc\u5361\u4e2d\u6563\u5e03\u8457\u96b1\u85cf\u7684\u786c\u5e63\uff0c\u53ef\u4ee5\u6536\u96c6\u4ee5\u89e3\u9396\u7279\u6b8a\u5716\u793a\u3002\u4f8b\u5982\uff0c\u5728\u300c\u4e5d\u500b\u5713\u5708\u300d\u95dc\u5361\u4e2d\uff0c\u5176\u4e2d\u4e00\u679a\u786c\u5e63\u4f4d\u65bc\u9700\u8981\u7cbe\u78ba\u6642\u6a5f\u624d\u80fd\u9032\u5165\u7684\u96b1\u85cf\u901a\u9053\u4e2d\u3002\u63a2\u7d22\u9019\u4e9b\u79d8\u5bc6\uff0c\u80fd\u70ba\u71b1\u8877\u7684\u73a9\u5bb6\u5e36\u4f86\u984d\u5916\u7684\u6311\u6230\u548c\u734e\u52f5\u3002"}, {"question": "\u5e7e\u4f55\u9054\u4eba\u4e5d\u500b\u5713\u5708\u7684\u6aa2\u67e5\u9ede\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u5e7e\u4f55\u9054\u4eba\u4e5d\u500b\u5713\u5708\u7684\u6aa2\u67e5\u9ede\u7cfb\u7d71\u5141\u8a31\u73a9\u5bb6\u5728\u95dc\u5361\u4e2d\u7684\u7279\u5b9a\u9ede\u4fdd\u5b58\u904a\u6232\u9032\u5ea6\u3002\u7576\u4f60\u5230\u9054\u6aa2\u67e5\u9ede\u6642\uff0c\u904a\u6232\u6703\u4fdd\u5b58\u4f60\u7684\u4f4d\u7f6e\uff0c\u5982\u679c\u4f60\u5931\u6557\u4e86\uff0c\u4f60\u53ef\u4ee5\u5f9e\u8a72\u9ede\u91cd\u65b0\u958b\u59cb\uff0c\u800c\u4e0d\u662f\u5f9e\u982d\u958b\u59cb\u3002\u5728\u50cf\u300c\u4e5d\u500b\u5713\u5708\u300d\u9019\u6a23\u7684\u9577\u95dc\u5361\u4e2d\uff0c\u9019\u7a2e\u7cfb\u7d71\u7279\u5225\u6709\u7528\uff0c\u56e0\u70ba\u96e3\u5ea6\u6703\u96a8\u8457\u4f60\u7684\u9032\u5ea6\u800c\u589e\u52a0\u3002\u8981\u4f7f\u7528\u6aa2\u67e5\u9ede\uff0c\u53ea\u9700\u901a\u904e\u6aa2\u67e5\u9ede\u5713\uff0c\u4f60\u7684\u9032\u5ea6\u5c31\u6703\u88ab\u5132\u5b58\u3002\u6b64\u529f\u80fd\u6709\u52a9\u65bc\u6e1b\u5c11\u632b\u6298\u611f\uff0c\u4e26\u8b93\u73a9\u5bb6\u5c08\u6ce8\u65bc\u7cbe\u901a\u5177\u6709\u6311\u6230\u6027\u7684\u90e8\u5206\uff0c\u800c\u7121\u9700\u91cd\u65b0\u73a9\u6574\u500b\u95dc\u5361\u3002"}, {"question": "\u5e7e\u4f55\u9054\u4eba\u4e5d\u500b\u5713\u5708\u4e2d\u54ea\u4e9b\u63a7\u5236\u8a2d\u5b9a\u88ab\u63a8\u85a6\u7528\u65bc\u6700\u4f73\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u5728\u5e7e\u4f55\u9054\u4eba\u4e5d\u500b\u5713\u5708\u4e2d\uff0c\u70ba\u4e86\u7372\u5f97\u6700\u4f73\u904a\u6232\u9ad4\u9a57\uff0c\u5efa\u8b70\u8abf\u6574\u63a7\u5236\u8a2d\u5b9a\u4ee5\u6eff\u8db3\u4f60\u7684\u559c\u597d\u3002\u5728\u624b\u6a5f\u4e0a\uff0c\u8003\u616e\u555f\u7528\u300c\u56fa\u5b9a\u63a7\u5236\u300d\u9078\u9805\uff0c\u4ee5\u6e1b\u5c11\u610f\u5916\u8f38\u5165\u3002\u5728\u96fb\u8166\u4e0a\uff0c\u901a\u5e38\u4f7f\u7528\u9375\u76e4\u7684\u7a7a\u683c\u9375\u8df3\u8e8d\uff0c\u56e0\u70ba\u5b83\u53cd\u61c9\u8f03\u5feb\u3002\u6b64\u5916\uff0c\u4f60\u53ef\u4ee5\u8abf\u6574\u300c\u9748\u654f\u5ea6\u300d\u8a2d\u5b9a\uff0c\u4ee5\u5fae\u8abf\u4f60\u7684\u63a7\u5236\u8f38\u5165\u3002\u4f8b\u5982\uff0c\u964d\u4f4e\u9748\u654f\u5ea6\u53ef\u4ee5\u5e6b\u52a9\u4f60\u5728\u6ce2\u6d6a\u6a21\u5f0f\u4e2d\u9032\u884c\u7cbe\u78ba\u7684\u79fb\u52d5\u3002\u5617\u8a66\u4e0d\u540c\u7684\u8a2d\u5b9a\uff0c\u627e\u5230\u6700\u9069\u5408\u4f60\u4e26\u589e\u5f37\u4f60\u7684\u904a\u6232\u9ad4\u9a57\u7684\u914d\u7f6e\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u5e7e\u4f55\u9054\u4eba\u4e5d\u500b\u5713\u5708\u4e2d\u5c07\u624b\u6a5f\u7248\u7684\u9032\u5ea6\u8f49\u79fb\u5230\u96fb\u8166\u7248\uff1f", "answer": "\u5728\u5e7e\u4f55\u9054\u4eba\u4e5d\u500b\u5713\u5708\u4e2d\uff0c\u5c07\u624b\u6a5f\u7248\u7684\u9032\u5ea6\u8f49\u79fb\u5230\u96fb\u8166\u7248\uff0c\u53ef\u4ee5\u4f7f\u7528\u904a\u6232\u7684\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u3002\u9996\u5148\uff0c\u78ba\u4fdd\u4f60\u7684\u624b\u6a5f\u7248\u672c\u5df2\u9023\u63a5\u5230\u4f60\u7684\u5e33\u6236\uff0c\u4e26\u4e14\u4f60\u7684\u9032\u5ea6\u5df2\u5132\u5b58\u5230\u96f2\u7aef\u3002\u7136\u5f8c\uff0c\u767b\u5165\u96fb\u8166\u7248\u672c\u4e0a\u7684\u76f8\u540c\u5e33\u6236\uff0c\u4f60\u7684\u9032\u5ea6\u61c9\u8a72\u6703\u81ea\u52d5\u540c\u6b65\u3002\u5982\u679c\u4f60\u9047\u5230\u554f\u984c\uff0c\u4e5f\u53ef\u4ee5\u624b\u52d5\u50b3\u8f38\u5132\u5b58\u6a94\u6848\uff0c\u4f46\u9019\u9700\u8981\u5b58\u53d6\u5169\u500b\u88dd\u7f6e\u4e0a\u7684\u904a\u6232\u6a94\u6848\u76ee\u9304\u3002\u900f\u904e\u9075\u5faa\u9019\u4e9b\u6b65\u9a5f\uff0c\u4f60\u53ef\u4ee5\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u9806\u5229\u7e7c\u7e8c\u4f60\u7684\u904a\u6232\u3002"}]
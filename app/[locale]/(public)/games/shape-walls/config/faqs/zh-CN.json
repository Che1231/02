[{"question": "\u5982\u4f55\u5728\u5f62\u72b6\u5899\u58c1\u6e38\u620f\u4e2d\u8fdb\u884c\u57fa\u672c\u79fb\u52a8\uff0c\u4ee5\u53ca\u521d\u5b66\u8005\u5e94\u8be5\u638c\u63e1\u54ea\u4e9b\u5173\u952e\u63a7\u5236\uff1f", "answer": "\u5728\u5f62\u72b6\u5899\u58c1\u6e38\u620f\u4e2d\uff0c\u57fa\u672c\u79fb\u52a8\u5bf9\u4e8e\u6e38\u620f\u5bfc\u822a\u81f3\u5173\u91cd\u8981\u3002\u4ee5\u4e0b\u662f\u5173\u952e\u63a7\u5236\u7684\u8bf4\u660e\uff1a\u4f7f\u7528\u65b9\u5411\u952e\u6216 WASD \u952e\u79fb\u52a8\u89d2\u8272\u3002\u7a7a\u683c\u952e\u7528\u4e8e\u8df3\u8dc3\uff0c\u8fd9\u5bf9\u4e8e\u907f\u514d\u969c\u788d\u7269\u81f3\u5173\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u5173\u4e2d\uff0c\u60a8\u9700\u8981\u8df3\u8fc7\u4e00\u7cfb\u5217\u4f4e\u5899\u624d\u80fd\u7ee7\u7eed\u524d\u8fdb\u3002\u6b64\u5916\uff0cShift \u952e\u53ef\u4ee5\u8ba9\u4f60\u5feb\u901f\u5954\u8dd1\uff0c\u8fd9\u5bf9\u4e8e\u5feb\u901f\u8de8\u8d8a\u957f\u8ddd\u79bb\u975e\u5e38\u6709\u7528\u3002\u8bb0\u4f4f\uff0c\u638c\u63e1\u8fd9\u4e9b\u63a7\u5236\u662f\u6210\u4e3a\u5f62\u72b6\u5899\u58c1\u6e38\u620f\u9ad8\u624b\u7684\u7b2c\u4e00\u6b65\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u8fd9\u4e9b\u63a7\u5236\u60f3\u8c61\u6210\u623f\u5c4b\u7684\u5730\u57fa\u2014\u2014\u5982\u679c\u6ca1\u6709\u575a\u5b9e\u7684\u5730\u57fa\uff0c\u7ed3\u6784\u5c31\u4f1a\u574d\u584c\u3002]"}, {"question": "\u9ad8\u7ea7\u73a9\u5bb6\u5982\u4f55\u5236\u5b9a\u6700\u4f73\u7b56\u7565\uff0c\u5728\u5f62\u72b6\u5899\u58c1\u6e38\u620f\u4e2d\u83b7\u5f97\u9ad8\u5206\uff1f", "answer": "\u5728\u5f62\u72b6\u5899\u58c1\u6e38\u620f\u4e2d\u83b7\u5f97\u9ad8\u5206\u9700\u8981\u7cbe\u786e\u7684\u64cd\u4f5c\u548c\u7b56\u7565\u7684\u7ed3\u5408\u3002\u4ee5\u4e0b\u662f\u4e00\u4e9b\u9010\u6b65\u6307\u5357\uff1a\u6b65\u9aa41\uff1a\u7cbe\u901a\u8df3\u8dc3\u548c\u51b2\u523a\u7684\u65f6\u95f4\u63a7\u5236\uff0c\u4ee5\u6709\u6548\u5730\u907f\u5f00\u969c\u788d\u7269\u3002\u6b65\u9aa42\uff1a\u6218\u7565\u6027\u5730\u4f7f\u7528\u9053\u5177\uff1b\u4f8b\u5982\uff0c\u201c\u52a0\u901f\u9053\u5177\u201d\u53ef\u4ee5\u5e2e\u52a9\u4f60\u5feb\u901f\u8de8\u8d8a\u66f4\u591a\u8ddd\u79bb\u3002\u6b65\u9aa43\uff1a\u63d0\u524d\u89c4\u5212\u8def\u7ebf\uff0c\u6700\u5927\u5316\u5f97\u5206\u500d\u6570\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 5 \u5173\u4e2d\uff0c\u9009\u62e9\u7279\u5b9a\u8def\u5f84\u53ef\u4ee5\u5c06\u4f60\u7684\u500d\u6570\u4ece 2 \u500d\u63d0\u9ad8\u5230 3 \u500d\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u867d\u7136\u4e00\u4e9b\u73a9\u5bb6\u66f4\u559c\u6b22\u8c28\u614e\u7684\u65b9\u5f0f\uff0c\u4f46\u53e6\u4e00\u4e9b\u73a9\u5bb6\u5219\u66f4\u503e\u5411\u4e8e\u5192\u9669\uff1b\u9009\u62e9\u6700\u9002\u5408\u4f60\u6e38\u620f\u98ce\u683c\u7684\u7b56\u7565\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u5f62\u72b6\u5899\u58c1\u6e38\u620f\u4f7f\u7528\u52a8\u6001\u96be\u5ea6\u7cfb\u7edf\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u5f62\u72b6\u5899\u58c1\u6e38\u620f\u91c7\u7528\u52a8\u6001\u96be\u5ea6\u7cfb\u7edf\u6765\u9002\u5e94\u73a9\u5bb6\u7684\u6280\u672f\u6c34\u5e73\uff0c\u786e\u4fdd\u6e38\u620f\u4f53\u9a8c\u65e2\u5e73\u8861\u53c8\u5f15\u4eba\u5165\u80dc\u3002\u8be5\u7cfb\u7edf\u4f1a\u6839\u636e\u4f60\u7684\u8868\u73b0\u8c03\u6574\u969c\u788d\u7269\u7684\u901f\u5ea6\u548c\u590d\u6742\u7a0b\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u6301\u7eed\u8868\u73b0\u51fa\u8272\uff0c\u6e38\u620f\u5c06\u5f15\u5165\u66f4\u5feb\u7684\u79fb\u52a8\u5899\u58c1\u548c\u66f4\u590d\u6742\u7684\u56fe\u6848\u3002\u8fd9\u5c06\u4f7f\u6e38\u620f\u65e2\u5177\u6709\u6311\u6218\u6027\uff0c\u53c8\u80fd\u4fdd\u6301\u516c\u5e73\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u7b80\u5355\u6a21\u5f0f\uff1a\u5899\u58c1\u79fb\u52a8\u901f\u5ea6\u8f83\u6162\uff0c\u56fe\u6848\u7b80\u5355\uff1b\u56f0\u96be\u6a21\u5f0f\uff1a\u5899\u58c1\u79fb\u52a8\u901f\u5ea6\u8f83\u5feb\uff0c\u56fe\u6848\u590d\u6742\u3002]"}, {"question": "\u54ea\u4e9b\u5e73\u53f0\u652f\u6301\u5f62\u72b6\u5899\u58c1\u6e38\u620f\uff0c\u5e76\u4e14\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u662f\u5426\u517c\u5bb9\uff1f", "answer": "\u5f62\u72b6\u5899\u58c1\u6e38\u620f\u53ef\u5728 PC\u3001Mac \u548c PlayStation\u3001Xbox \u7b49\u6e38\u620f\u673a\u5e73\u53f0\u4e0a\u8fd0\u884c\u3002\u8be5\u6e38\u620f\u652f\u6301\u8de8\u5e73\u53f0\u517c\u5bb9\u6027\uff0c\u5141\u8bb8\u60a8\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u8f6c\u79fb\u6e38\u620f\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728 PC \u4e0a\u5f00\u59cb\u6e38\u620f\uff0c\u60a8\u53ef\u4ee5\u5728 PlayStation \u4e0a\u7ee7\u7eed\u6e38\u620f\uff0c\u800c\u4e0d\u4f1a\u4e22\u5931\u4efb\u4f55\u6570\u636e\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1aPC \u2192 \u4e91\u7aef\u4fdd\u5b58 \u2192 \u6e38\u620f\u673a\u786e\u4fdd\u65e0\u7f1d\u8fc7\u6e21\u3002]"}, {"question": "\u5982\u4f55\u5728\u5f62\u72b6\u5899\u58c1\u6e38\u620f\u4e2d\u53d1\u73b0\u9690\u85cf\u5185\u5bb9\uff0c\u4ee5\u53ca\u4e00\u4e9b\u4f8b\u5b50\uff1f", "answer": "\u5728\u5f62\u72b6\u5899\u58c1\u6e38\u620f\u4e2d\u53d1\u73b0\u9690\u85cf\u5185\u5bb9\u9700\u8981\u4ed4\u7ec6\u89c2\u5bdf\u548c\u63a2\u7d22\u3002\u5bfb\u627e\u7ec6\u5fae\u7684\u73af\u5883\u7ebf\u7d22\uff0c\u4f8b\u5982\u7565\u5fae\u4e0d\u540c\u7684\u5899\u58c1\u7eb9\u7406\u6216\u4e0d\u5bfb\u5e38\u7684\u56fe\u6848\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 7 \u5173\u4e2d\uff0c\u53ef\u4ee5\u901a\u8fc7\u8df3\u8fc7\u6bd4\u5176\u4ed6\u5899\u58c1\u7565\u9ad8\u7684\u7279\u5b9a\u5899\u58c1\u6765\u53d1\u73b0\u9690\u85cf\u8def\u5f84\u3002\u8fd9\u6761\u8def\u5f84\u901a\u5f80\u4e00\u4e2a\u5305\u542b\u989d\u5916\u5206\u6570\u548c\u72ec\u7279\u9053\u5177\u7684\u79d8\u5bc6\u533a\u57df\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u9690\u85cf\u5185\u5bb9\u60f3\u8c61\u6210\u57cb\u85cf\u7684\u5b9d\u85cf\u2014\u2014\u53ea\u6709\u90a3\u4e9b\u4ed4\u7ec6\u5bfb\u627e\u7684\u4eba\u624d\u80fd\u627e\u5230\u3002]"}, {"question": "\u5f62\u72b6\u5899\u58c1\u6e38\u620f\u7684\u6838\u5fc3\u673a\u5236\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5b83\u4eec\u5982\u4f55\u63d0\u5347\u6574\u4f53\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u5f62\u72b6\u5899\u58c1\u6e38\u620f\u7684\u6838\u5fc3\u673a\u5236\u5305\u62ec\u79fb\u52a8\u3001\u8df3\u8dc3\u548c\u51b2\u523a\uff0c\u8fd9\u4e9b\u673a\u5236\u5bf9\u4e8e\u5728\u6e38\u620f\u4e2d\u5e94\u5bf9\u969c\u788d\u7269\u81f3\u5173\u91cd\u8981\u3002\u6b64\u5916\uff0c\u6e38\u620f\u8fd8\u8bbe\u6709\u5f97\u5206\u500d\u6570\u7cfb\u7edf\uff0c\u5956\u52b1\u7cbe\u786e\u7684\u64cd\u4f5c\u548c\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u6210\u529f\u5730\u8fde\u7eed\u901a\u8fc7\u4e00\u8fde\u4e32\u5899\u58c1\uff0c\u4e14\u6ca1\u6709\u72af\u9519\uff0c\u4f1a\u63d0\u5347\u4f60\u7684\u500d\u6570\uff0c\u6700\u7ec8\u5f97\u5230\u66f4\u9ad8\u7684\u5206\u6570\u3002\u8fd9\u4e9b\u673a\u5236\u5171\u540c\u521b\u9020\u51fa\u4e00\u79cd\u8282\u594f\u5feb\u4e14\u6781\u5177\u5956\u52b1\u7684\u6e38\u620f\u4f53\u9a8c\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u867d\u7136\u6709\u4e9b\u6e38\u620f\u4f9d\u8d56\u6218\u6597\uff0c\u4f46\u5f62\u72b6\u5899\u58c1\u6e38\u620f\u5219\u4e13\u6ce8\u4e8e\u654f\u6377\u6027\u548c\u65f6\u673a\u3002]"}, {"question": "\u5f62\u72b6\u5899\u58c1\u6e38\u620f\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u6700\u7ec8\u5f97\u5206\uff1f", "answer": "\u5f62\u72b6\u5899\u58c1\u6e38\u620f\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u51e0\u4e2a\u56e0\u7d20\uff1a\u8986\u76d6\u7684\u8ddd\u79bb\u3001\u907f\u514d\u7684\u969c\u788d\u7269\u6570\u91cf\u4ee5\u53ca\u8fbe\u5230\u7684\u500d\u6570\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u4e0d\u72af\u4efb\u4f55\u9519\u8bef\u7684\u60c5\u51b5\u4e0b\u5b8c\u6210\u7b2c 3 \u5173\uff0c\u60a8\u7684\u500d\u6570\u5c06\u4ece 1 \u500d\u63d0\u9ad8\u5230 2 \u500d\uff0c\u4f7f\u60a8\u7684\u5206\u6570\u7ffb\u500d\u3002\u6b64\u5916\uff0c\u6536\u96c6\u9053\u5177\u548c\u53d1\u73b0\u9690\u85cf\u8def\u5f84\u53ef\u4ee5\u8fdb\u4e00\u6b65\u63d0\u5347\u60a8\u7684\u5f97\u5206\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u8ddd\u79bb\uff1a\u6bcf\u7c73 100 \u5206\uff1b\u500d\u6570\uff1a1 \u500d\u5230 3 \u500d\uff1b\u9053\u5177\uff1a\u6bcf\u4e2a\u9053\u5177 500 \u5206\u3002]"}, {"question": "\u5f62\u72b6\u5899\u58c1\u6e38\u620f\u4e2d\u521d\u5b66\u8005\u6700\u5e38\u89c1\u7684\u9519\u8bef\u6709\u54ea\u4e9b\uff0c\u4ee5\u53ca\u5982\u4f55\u907f\u514d\u8fd9\u4e9b\u9519\u8bef\uff1f", "answer": "\u5f62\u72b6\u5899\u58c1\u6e38\u620f\u4e2d\u7684\u65b0\u624b\u7ecf\u5e38\u72af\u7684\u9519\u8bef\u5305\u62ec\uff1a\u8bef\u5224\u8df3\u8dc3\u8ddd\u79bb\u6216\u672a\u80fd\u6709\u6548\u5229\u7528\u51b2\u523a\u3002\u4e3a\u4e86\u907f\u514d\u8fd9\u4e9b\u9519\u8bef\uff0c\u8bf7\u5728\u65e9\u671f\u5173\u5361\u7ec3\u4e60\u8df3\u8dc3\u548c\u51b2\u523a\u7684\u65f6\u95f4\u63a7\u5236\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 2 \u5173\u4e2d\uff0c\u8bb8\u591a\u73a9\u5bb6\u672a\u80fd\u901a\u8fc7\u4e00\u7cfb\u5217\u9ad8\u5899\u662f\u56e0\u4e3a\u4ed6\u4eec\u6ca1\u6709\u4f7f\u7528\u51b2\u523a\u529f\u80fd\u3002\u8bb0\u4f4f\uff0c\u8010\u5fc3\u548c\u7ec3\u4e60\u662f\u514b\u670d\u8fd9\u4e9b\u5e38\u89c1\u95ee\u9898\u7684\u5173\u952e\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u8fd9\u4e9b\u9519\u8bef\u60f3\u8c61\u6210\u57ab\u811a\u77f3\u2014\u2014\u6bcf\u4e00\u6b65\u90fd\u8ba9\u60a8\u66f4\u63a5\u8fd1\u638c\u63e1\u3002]"}, {"question": "\u5982\u4f55\u4f18\u5316\u6211\u5728\u5f62\u72b6\u5899\u58c1\u6e38\u620f\u4e2d\u7684\u8868\u73b0\uff0c\u4ee5\u8fdb\u884c\u7ade\u6280\u6e38\u620f\uff1f", "answer": "\u5728\u5f62\u72b6\u5899\u58c1\u6e38\u620f\u4e2d\u4f18\u5316\u7ade\u6280\u8868\u73b0\u9700\u8981\u4e00\u4e9b\u7b56\u7565\uff1a\u6b65\u9aa41\uff1a\u719f\u6089\u6bcf\u4e2a\u5173\u5361\u7684\u5e03\u5c40\uff0c\u4ee5\u4fbf\u9884\u6d4b\u969c\u788d\u7269\u3002\u6b65\u9aa42\uff1a\u6218\u7565\u6027\u5730\u4f7f\u7528\u9053\u5177\uff0c\u4ee5\u83b7\u5f97\u7ade\u4e89\u4f18\u52bf\u3002\u6b65\u9aa43\uff1a\u901a\u8fc7\u907f\u514d\u9519\u8bef\u5e76\u5feb\u901f\u5b8c\u6210\u5173\u5361\u6765\u4fdd\u6301\u9ad8\u500d\u6570\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 10 \u5173\u4e2d\uff0c\u4f7f\u7528\u201c\u62a4\u76fe\u201d\u9053\u5177\u53ef\u4ee5\u4fdd\u62a4\u4f60\u514d\u53d7\u969c\u788d\u7269\u7684\u5f71\u54cd\uff0c\u8ba9\u4f60\u4fdd\u6301\u500d\u6570\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u867d\u7136\u4e00\u4e9b\u73a9\u5bb6\u4e13\u6ce8\u4e8e\u901f\u5ea6\uff0c\u4f46\u53e6\u4e00\u4e9b\u73a9\u5bb6\u5219\u66f4\u6ce8\u91cd\u7cbe\u786e\u5ea6\uff1b\u9009\u62e9\u6700\u80fd\u6700\u5927\u5316\u4f60\u4f18\u52bf\u7684\u7b56\u7565\u3002]"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u8fd0\u884c\u5f62\u72b6\u5899\u58c1\u6e38\u620f\u6240\u9700\u7684\u786c\u4ef6\u914d\u7f6e\u662f\u4ec0\u4e48\uff0c\u5b83\u4eec\u4e4b\u95f4\u6709\u4f55\u6bd4\u8f83\uff1f", "answer": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u8fd0\u884c\u5f62\u72b6\u5899\u58c1\u6e38\u620f\u6240\u9700\u7684\u786c\u4ef6\u914d\u7f6e\u5404\u4e0d\u76f8\u540c\u3002\u5728 PC \u4e0a\uff0c\u60a8\u81f3\u5c11\u9700\u8981\u82f1\u7279\u5c14 i5 \u5904\u7406\u5668\u548c 8GB \u5185\u5b58\u3002\u5728\u6e38\u620f\u673a\u4e0a\uff0c\u8be5\u6e38\u620f\u5728 PlayStation 4 \u548c Xbox One \u4e0a\u90fd\u80fd\u6d41\u7545\u8fd0\u884c\u3002\u4f8b\u5982\uff0c\u5728\u4e2d\u7b49\u914d\u7f6e\u7684 PC \u4e0a\uff0c\u5f62\u72b6\u5899\u58c1\u6e38\u620f\u5728\u4e2d\u7b49\u753b\u8d28\u4e0b\u4ee5 60 \u5e27\u8fd0\u884c\uff0c\u800c\u5728 PlayStation 4 Pro \u4e0a\uff0c\u5b83\u53ef\u4ee5\u5728\u9ad8\u753b\u8d28\u4e0b\u8fbe\u5230 60 \u5e27\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1aPC\uff1a\u82f1\u7279\u5c14 i5 \u5904\u7406\u5668\uff0c8GB \u5185\u5b58\uff1bPlayStation 4\uff1a\u9ad8\u753b\u8d28 60 \u5e27\u3002]"}]
[{"question": "Shape Walls\uc5d0\uc11c \uae30\ubcf8\uc801\uc778 \uc6c0\uc9c1\uc784\uc744 \uc5b4\ub5bb\uac8c \uc218\ud589\ud558\uba70, \ucd08\ubcf4\uc790\ub97c \uc704\ud55c \uc8fc\uc694 \ucee8\ud2b8\ub864\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Shape Walls\uc5d0\uc11c \uae30\ubcf8\uc801\uc778 \uc6c0\uc9c1\uc784\uc740 \uac8c\uc784 \ub0b4\ube44\uac8c\uc774\uc158\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc8fc\uc694 \ucee8\ud2b8\ub864\uc5d0 \ub300\ud55c \ubd84\uc11d\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ud654\uc0b4\ud45c \ud0a4 \ub610\ub294 WASD\ub97c \uc0ac\uc6a9\ud558\uc5ec \uce90\ub9ad\ud130\ub97c \uc774\ub3d9\ud569\ub2c8\ub2e4. \uacf5\uaca9\uc801\uc778 \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\ub294 \ub370 \uc911\uc694\ud55c \uc810\ud504\uc5d0\ub294 \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c\ub294 \uc9c4\ud589\ud558\uae30 \uc704\ud574 \uc77c\ub828\uc758 \ub0ae\uc740 \ubcbd\uc744 \ub6f0\uc5b4\ub118\uc5b4\uc57c \ud569\ub2c8\ub2e4. \ub610\ud55c, \"Shift\" \ud0a4\ub97c \uc0ac\uc6a9\ud558\uba74 \uc7a5\uac70\ub9ac\ub97c \uc2e0\uc18d\ud558\uac8c \uc774\ub3d9\ud558\ub294 \ub370 \uc720\uc6a9\ud55c \uc2a4\u30d7\u30ea\u30f3\u30c8\ub97c \uc2e4\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ucee8\ud2b8\ub864\uc744 \uc219\ub2ec\ud558\ub294 \uac83\uc740 Shape Walls\uc5d0\uc11c \uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\uac00 \ub418\uae30 \uc704\ud55c \uccab \ubc88\uc9f8 \ub2e8\uacc4\uc784\uc744 \uae30\uc5b5\ud558\uc2ed\uc2dc\uc624. [\ube44\uc720 \uc124\uba85: \ucee8\ud2b8\ub864\uc744 \uc9d1\uc758 \uae30\ucd08\ub85c \uc0dd\uac01\ud574 \ubcf4\uc2ed\uc2dc\uc624. \uacac\uace0\ud55c \uae30\ucd08\uac00 \uc5c6\uc73c\uba74 \uad6c\uc870\ubb3c\uc774 \ubb34\ub108\uc9d1\ub2c8\ub2e4.]"}, {"question": "Shape Walls\uc5d0\uc11c \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uac00 \ub192\uc740 \uc810\uc218\ub97c \ub2ec\uc131\ud558\uae30 \uc704\ud55c \ucd5c\uc0c1\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Shape Walls\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \ub2ec\uc131\ud558\ub824\uba74 \uc815\ubc00\uc131\uacfc \uc804\ub7b5\uc758 \uc870\ud569\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4\ubcc4 \uac00\uc774\ub4dc\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. STEP1: \uc7a5\uc560\ubb3c\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \ud53c\ud558\uae30 \uc704\ud574 \uc810\ud504\uc640 \uc2a4\u30d7\u30ea\u30f3\u30c8\uc758 \ud0c0\uc774\ubc0d\uc744 \uc644\ubcbd\ud558\uac8c \uc219\ub2ec\ud569\ub2c8\ub2e4. STEP2: \uc608\ub97c \ub4e4\uc5b4, \"\uc18d\ub3c4 \ubd80\uc2a4\ud2b8\" \ud30c\uc6cc\uc5c5\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\uba74 \ub354 \ube68\ub9ac \uc774\ub3d9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP3: \uc810\uc218 \ubc30\uc728\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \ubbf8\ub9ac \uacbd\ub85c\ub97c \uacc4\ud68d\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 5\uc5d0\uc11c \ud2b9\uc815 \uacbd\ub85c\ub97c \ub530\ub974\uba74 \ubc30\uc728\uc744 2\ubc30\uc5d0\uc11c 3\ubc30\ub85c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\uc548 \ube44\uad50: \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\ub294 \uc2e0\uc911\ud55c \uc811\uadfc \ubc29\uc2dd\uc744 \uc120\ud638\ud558\uc9c0\ub9cc, \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub294 \uc704\ud5d8\uc744 \uac10\uc218\ud558\ub294 \uac83\uc744 \uc120\ud638\ud569\ub2c8\ub2e4. \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc744 \ucd5c\ub300\ud55c \ubc18\uc601\ud558\ub294 \uc804\ub7b5\uc744 \uc120\ud0dd\ud558\uc2ed\uc2dc\uc624.]"}, {"question": "Shape Walls\uac00 \ub3d9\uc801 \ub09c\uc774\ub3c4 \uc2dc\uc2a4\ud15c\uc744 \uc0ac\uc6a9\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "Shape Walls\ub294 \ud50c\ub808\uc774\uc5b4\uc758 \uae30\uc220 \uc218\uc900\uc5d0 \uc801\uc751\ud558\uc5ec \uade0\ud615 \uc788\uace0 \ub9e4\ub825\uc801\uc778 \uacbd\ud5d8\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 \ub3d9\uc801 \ub09c\uc774\ub3c4 \uc2dc\uc2a4\ud15c\uc744 \ud65c\uc6a9\ud569\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uc758 \uc131\ub2a5\uc5d0 \ub530\ub77c \uc7a5\uc560\ubb3c\uc758 \uc18d\ub3c4\uc640 \ubcf5\uc7a1\uc131\uc744 \uc870\uc815\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud50c\ub808\uc774\uc5b4\uac00 \uafb8\uc900\ud788 \uc88b\uc740 \uc131\ub2a5\uc744 \ubcf4\uc774\uba74 \uac8c\uc784\uc740 \ub354 \ube60\ub974\uac8c \uc6c0\uc9c1\uc774\ub294 \ubcbd\uacfc \ub354 \ubcf5\uc7a1\ud55c \ud328\ud134\uc744 \ub3c4\uc785\ud569\ub2c8\ub2e4. \uc774\ub294 \uac8c\uc784\uc744 \uc5b4\ub835\uc9c0\ub9cc \uacf5\uc815\ud558\uac8c \uc720\uc9c0\ud569\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \uc26c\uc6c0 \ubaa8\ub4dc: \ubcbd\uc774 \ub290\ub9ac\uace0 \ud328\ud134\uc774 \uac04\ub2e8\ud569\ub2c8\ub2e4. \uc5b4\ub824\uc6c0 \ubaa8\ub4dc: \ubcbd\uc774 \ube60\ub974\uace0 \ud328\ud134\uc774 \ubcf5\uc7a1\ud569\ub2c8\ub2e4.]"}, {"question": "Shape Walls\ub97c \uc9c0\uc6d0\ud558\ub294 \ud50c\ub7ab\ud3fc\uc740 \ubb34\uc5c7\uc774\uba70, \ud50c\ub7ab\ud3fc \uac04 \ud638\ud658\uc131\uc774 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Shape Walls\ub294 PC, Mac \ubc0f PlayStation\uacfc Xbox\uc640 \uac19\uc740 \ucf58\uc194\uc5d0\uc11c \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uac8c\uc784\uc740 \ud50c\ub7ab\ud3fc \uac04 \ud638\ud658\uc131\uc744 \uc9c0\uc6d0\ud558\uc5ec \uc7a5\uce58 \uac04\uc5d0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \uac8c\uc784\uc744 \uc2dc\uc791\ud558\uba74 PlayStation\uc5d0\uc11c \uac8c\uc784\uc744 \uacc4\uc18d\ud560 \uc218 \uc788\uc73c\uba70 \ub370\uc774\ud130\ub97c \uc190\uc2e4\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \ub3c4\ud45c: PC \u2192 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \u2192 \ucf58\uc194\uc740 \uc6d0\ud65c\ud55c \uc804\ud658\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4.]"}, {"question": "Shape Walls\uc5d0\uc11c \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \uc5b4\ub5bb\uac8c \ubc1c\uacac\ud560 \uc218 \uc788\uc73c\uba70, \uba87 \uac00\uc9c0 \uc608\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Shape Walls\uc5d0\uc11c \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \ubc1c\uacac\ud558\ub824\uba74 \uaf3c\uaf3c\ud55c \uad00\ucc30\uacfc \ud0d0\uc0c9\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ubbf8\ubb18\ud55c \ud658\uacbd \ub2e8\uc11c, \uc608\ub97c \ub4e4\uc5b4 \uc57d\uac04 \ub2e4\ub978 \ubcbd \uc9c8\uac10\uc774\ub098 \ud2b9\uc774\ud55c \ud328\ud134\uc5d0 \uc8fc\uc758\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 7\uc5d0\uc11c \uc228\uaca8\uc9c4 \uacbd\ub85c\ub294 \ub098\uba38\uc9c0 \ubcbd\ubcf4\ub2e4 \uc57d\uac04 \ub192\uc544 \ubcf4\uc774\ub294 \ud2b9\uc815 \ubcbd \uc704\ub85c \uc810\ud504\ud558\uc5ec \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uacbd\ub85c\ub294 \ubcf4\ub108\uc2a4 \uc810\uc218\uc640 \uace0\uc720\ud55c \ud30c\uc6cc\uc5c5\uc774 \uc788\ub294 \ube44\ubc00 \uc601\uc5ed\uc73c\ub85c \uc5f0\uacb0\ub429\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \ubb3b\ud78c \ubcf4\ubb3c\ub85c \uc0dd\uac01\ud574 \ubcf4\uc2ed\uc2dc\uc624. \uaf3c\uaf3c\ud788 \ubcf4\ub294 \uc0ac\ub78c\ub9cc\uc774 \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "Shape Walls\uc758 \ud575\uc2ec \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc774\uba70, \uc774\ub294 \uc804\uccb4 \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc5d0 \uc5b4\ub5bb\uac8c \uae30\uc5ec\ud569\ub2c8\uae4c?", "answer": "Shape Walls\uc758 \ud575\uc2ec \uba54\ucee4\ub2c8\uc998\uc5d0\ub294 \uac8c\uc784\uc758 \uc7a5\uc560\ubb3c\uc744 \uadf9\ubcf5\ud558\ub294 \ub370 \ud544\uc218\uc801\uc778 \uc774\ub3d9, \uc810\ud504 \ubc0f \uc2a4\u30d7\u30ea\u30f3\u30c8\uac00 \ud3ec\ud568\ub429\ub2c8\ub2e4. \ub610\ud55c, \uac8c\uc784\uc5d0\ub294 \uc815\ud655\uc131\uacfc \uc18d\ub3c4\ub97c \ubcf4\uc0c1\ud558\ub294 \uc810\uc218 \ubc30\uc728 \uc2dc\uc2a4\ud15c\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc2e4\uc218 \uc5c6\uc774 \uc77c\ub828\uc758 \ubcbd\uc744 \uc131\uacf5\uc801\uc73c\ub85c \ud1b5\uacfc\ud558\uba74 \ubc30\uc728\uc774 \ub192\uc544\uc838 \uc810\uc218\uac00 \ub192\uc544\uc9d1\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc740 \ube60\ub974\uace0 \ubcf4\ub78c \uc788\ub294 \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \ub9cc\ub4e4\uae30 \uc704\ud574 \ud568\uaed8 \uc791\ub3d9\ud569\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\uc548 \ube44\uad50: \uc77c\ubd80 \uac8c\uc784\uc740 \uc804\ud22c\uc5d0 \uc758\uc874\ud558\uc9c0\ub9cc, Shape Walls\ub294 \ubbfc\ucca9\uc131\uacfc \ud0c0\uc774\ubc0d\uc5d0 \uc911\uc810\uc744 \ub461\ub2c8\ub2e4.]"}, {"question": "Shape Walls\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \ucd5c\uc885 \uc810\uc218\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc694\uc18c\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Shape Walls\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uba87 \uac00\uc9c0 \uc694\uc18c\ub97c \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. \uc774\ub3d9 \uac70\ub9ac, \uc7a5\uc560\ubb3c \ud68c\ud53c \ud69f\uc218 \ubc0f \ub2ec\uc131\ud55c \ubc30\uc728\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 \ub808\ubca8 3\uc744 \uc2e4\uc218 \uc5c6\uc774 \uc644\ub8cc\ud558\uba74 \ubc30\uc728\uc774 1\ubc30\uc5d0\uc11c 2\ubc30\ub85c \uc99d\uac00\ud558\uc5ec \uc810\uc218\uac00 \ub450 \ubc30\uac00 \ub429\ub2c8\ub2e4. \ub610\ud55c, \ud30c\uc6cc\uc5c5\uc744 \uc218\uc9d1\ud558\uace0 \uc228\uaca8\uc9c4 \uacbd\ub85c\ub97c \ubc1c\uacac\ud558\uba74 \uc810\uc218\uac00 \ub354\uc6b1 \ub192\uc544\uc9d1\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \uac70\ub9ac: 100\uc810/\ubbf8\ud130; \ubc30\uc728: 1\ubc30\uc5d0\uc11c 3\ubc30; \ud30c\uc6cc\uc5c5: \uac01\uac01 500\uc810.]"}, {"question": "Shape Walls\uc5d0\uc11c \ucd08\ubcf4\uc790\uac00 \uac00\uc7a5 \ud754\ud558\uac8c \uc800\uc9c0\ub974\ub294 \uc2e4\uc218\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Shape Walls\uc5d0\uc11c \ucd08\ubcf4\uc790\ub294 \uc885\uc885 \uc810\ud504 \uac70\ub9ac\ub97c \uc798\ubabb \ud310\ub2e8\ud558\uac70\ub098 \uc2a4\u30d7\u30ea\u30f3\u30c8\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\uc9c0 \ubabb\ud558\ub294 \uc2e4\uc218\ub97c \uc800\uc9c0\ub985\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc2e4\uc218\ub97c \ud53c\ud558\ub824\uba74 \ucd08\uae30 \ub808\ubca8\uc5d0\uc11c \uc810\ud504 \ubc0f \uc2a4\u30d7\u30ea\u30f3\u30c8 \ud0c0\uc774\ubc0d \uc5f0\uc2b5\uc744 \ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 2\uc5d0\uc11c \ub9ce\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc77c\ub828\uc758 \ub192\uc740 \ubcbd\uc744 \ud1b5\uacfc\ud558\uc9c0 \ubabb\ud558\ub294 \uac83\uc740 \uc2a4\u30d7\u30ea\u30f3\u30c8 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc9c0 \uc54a\uc558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc778\ub0b4\uc640 \uc5f0\uc2b5\uc740 \uc774\ub7ec\ud55c \uc77c\ubc18\uc801\uc778 \ud568\uc815\uc744 \uadf9\ubcf5\ud558\ub294 \ub370 \uc911\uc694\ud55c \uc694\uc18c\uc784\uc744 \uae30\uc5b5\ud558\uc2ed\uc2dc\uc624. [\ube44\uc720 \uc124\uba85: \uc774\ub7ec\ud55c \uc2e4\uc218\ub97c \ubc1c\ud310\uc73c\ub85c \uc0dd\uac01\ud574 \ubcf4\uc2ed\uc2dc\uc624. \uac01 \uc2e4\uc218\ub294 \ub9c8\uc2a4\ud130\ud558\uae30 \uc704\ud55c \ubc1c\ud310\uc785\ub2c8\ub2e4.]"}, {"question": "\uacbd\uc7c1 \ud50c\ub808\uc774\ub97c \uc704\ud574 Shape Walls\uc5d0\uc11c \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uacbd\uc7c1 \ud50c\ub808\uc774\ub97c \uc704\ud574 Shape Walls\uc5d0\uc11c \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uba87 \uac00\uc9c0 \uc804\ub7b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \uac01 \ub808\ubca8\uc758 \ub808\uc774\uc544\uc6c3\uc744 \uc219\uc9c0\ud558\uc5ec \uc7a5\uc560\ubb3c\uc744 \uc608\uce21\ud569\ub2c8\ub2e4. STEP2: \uacbd\uc7c1\uc790\ub97c \uc55e\uc9c0\ub974\uae30 \uc704\ud574 \ud30c\uc6cc\uc5c5\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. STEP3: \uc2e4\uc218\ub97c \ud53c\ud558\uace0 \ub808\ubca8\uc744 \uc2e0\uc18d\ud558\uac8c \uc644\ub8cc\ud558\uc5ec \ub192\uc740 \ubc30\uc728\uc744 \uc720\uc9c0\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 10\uc5d0\uc11c \"\ubc29\ud328\" \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud558\uba74 \uc7a5\uc560\ubb3c\ub85c\ubd80\ud130 \ubcf4\ud638\ub418\uc5b4 \ubc30\uc728\uc744 \uc720\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\uc548 \ube44\uad50: \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\ub294 \uc18d\ub3c4\uc5d0 \uc9d1\uc911\ud558\uc9c0\ub9cc, \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub294 \uc815\ud655\ub3c4\ub97c \uc6b0\uc120\uc2dc\ud569\ub2c8\ub2e4. \uc790\uc2e0\uc758 \uac15\uc810\uc744 \uadf9\ub300\ud654\ud558\ub294 \uc804\ub7b5\uc744 \uc120\ud0dd\ud558\uc2ed\uc2dc\uc624.]"}, {"question": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c Shape Walls\ub97c \uc2e4\ud589\ud558\uae30 \uc704\ud55c \uae30\uc220\uc801 \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc774\uba70, \uc774\ub294 \uc5b4\ub5bb\uac8c \ube44\uad50\ub420 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Shape Walls\ub97c \uc2e4\ud589\ud558\uae30 \uc704\ud55c \uae30\uc220\uc801 \uc694\uad6c \uc0ac\ud56d\uc740 \ud50c\ub7ab\ud3fc\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. PC\uc5d0\uc11c\ub294 \ucd5c\uc18c \uc778\ud154 i5 \ud504\ub85c\uc138\uc11c\uc640 8GB RAM\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ucf58\uc194\uc5d0\uc11c\ub294 PlayStation 4\uc640 Xbox One \ubaa8\ub450\uc5d0\uc11c \uac8c\uc784\uc774 \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc911\uae09 PC\uc5d0\uc11c Shape Walls\ub294 \uc911\uac04 \uc124\uc815\uc5d0\uc11c 60 FPS\ub85c \uc2e4\ud589\ub418\ub294 \ubc18\uba74, PlayStation 4 Pro\uc5d0\uc11c\ub294 \uace0\uae09 \uc124\uc815\uc5d0\uc11c 60 FPS\ub97c \ub2ec\uc131\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: PC: \uc778\ud154 i5, 8GB RAM; PlayStation 4: \uace0\uae09 \uc124\uc815\uc5d0\uc11c 60 FPS.]"}]
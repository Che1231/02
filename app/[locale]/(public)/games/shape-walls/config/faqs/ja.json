[{"question": "Shape Walls\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u65b9\u6cd5\u3068\u3001\u521d\u5fc3\u8005\u304c\u62bc\u3055\u3048\u308b\u3079\u304d\u4e3b\u8981\u306a\u64cd\u4f5c\u30ad\u30fc\u3092\u6559\u3048\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "Shape Walls\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u306f\u3001\u30b2\u30fc\u30e0\u3092\u30ca\u30d3\u30b2\u30fc\u30c8\u3059\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u4e3b\u306a\u64cd\u4f5c\u306f\u4ee5\u4e0b\u306e\u901a\u308a\u3067\u3059\u3002\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u79fb\u52d5\u306b\u306f\u3001\u77e2\u5370\u30ad\u30fc\u307e\u305f\u306fWASD\u30ad\u30fc\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u969c\u5bb3\u7269\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u91cd\u8981\u306a\u30b8\u30e3\u30f3\u30d7\u306b\u306f\u3001\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u4e00\u9023\u306e\u4f4e\u3044\u58c1\u3092\u30b8\u30e3\u30f3\u30d7\u3057\u3066\u9032\u3080\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u300eShift\u300f\u30ad\u30fc\u3092\u62bc\u3059\u3068\u30b9\u30d7\u30ea\u30f3\u30c8\u304c\u53ef\u80fd\u306b\u306a\u308a\u3001\u9577\u3044\u8ddd\u96e2\u3092\u7d20\u65e9\u304f\u79fb\u52d5\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u306f\u3001Shape Walls\u3092\u7fd2\u5f97\u3059\u308b\u305f\u3081\u306e\u7b2c\u4e00\u6b69\u3067\u3059\u3002[\u6bd4\u55a9\u8aac\u660e: \u64cd\u4f5c\u30ad\u30fc\u306f\u5bb6\u306e\u57fa\u790e\u3068\u8003\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3057\u3063\u304b\u308a\u3068\u3057\u305f\u57fa\u790e\u304c\u306a\u3051\u308c\u3070\u3001\u69cb\u9020\u306f\u5d29\u58ca\u3057\u3066\u3057\u307e\u3044\u307e\u3059\u3002]"}, {"question": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u304cShape Walls\u3067\u9ad8\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u305f\u3081\u306b\u6700\u9069\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Shape Walls\u3067\u9ad8\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u306b\u306f\u3001\u6b63\u78ba\u3055\u3068\u6226\u7565\u306e\u4e21\u65b9\u304c\u5fc5\u8981\u3067\u3059\u3002\u6bb5\u968e\u7684\u306a\u30ac\u30a4\u30c9\u306f\u4ee5\u4e0b\u306e\u901a\u308a\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u969c\u5bb3\u7269\u3092\u52b9\u7387\u7684\u306b\u56de\u907f\u3059\u308b\u305f\u3081\u306b\u3001\u30b8\u30e3\u30f3\u30d7\u3068\u30b9\u30d7\u30ea\u30f3\u30c8\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u30de\u30b9\u30bf\u30fc\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u3092\u6226\u7565\u7684\u306b\u6d3b\u7528\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u300f\u306f\u3088\u308a\u8fc5\u901f\u306b\u79fb\u52d5\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u4e8b\u524d\u306b\u30eb\u30fc\u30c8\u3092\u8a08\u753b\u3057\u3066\u3001\u30b9\u30b3\u30a2\u500d\u7387\u3092\u6700\u5927\u9650\u306b\u9ad8\u3081\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb5\u3067\u306f\u3001\u7279\u5b9a\u306e\u30eb\u30fc\u30c8\u3092\u53d6\u308b\u3053\u3068\u3067\u500d\u7387\u30922\u500d\u304b\u30893\u500d\u306b\u5897\u3084\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u591a\u65b9\u6848\u6bd4\u8f03: \u3042\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u614e\u91cd\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u3092\u597d\u3080\u4e00\u65b9\u3067\u3001\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30ea\u30b9\u30af\u30c6\u30a4\u30af\u3092\u597d\u3080\u5834\u5408\u3082\u3042\u308a\u307e\u3059\u3002\u81ea\u5206\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u5408\u3063\u305f\u6226\u7565\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "Shape Walls\u304c\u52d5\u7684\u306a\u96e3\u6613\u5ea6\u30b7\u30b9\u30c6\u30e0\u3092\u63a1\u7528\u3057\u3066\u3044\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u304b\uff1f", "answer": "Shape Walls\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u306b\u5408\u308f\u305b\u3066\u96e3\u6613\u5ea6\u3092\u8abf\u6574\u3059\u308b\u52d5\u7684\u306a\u96e3\u6613\u5ea6\u30b7\u30b9\u30c6\u30e0\u3092\u63a1\u7528\u3057\u3066\u3044\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u9b45\u529b\u7684\u306a\u4f53\u9a13\u304c\u4fdd\u8a3c\u3055\u308c\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u3042\u306a\u305f\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u57fa\u3065\u3044\u3066\u3001\u969c\u5bb3\u7269\u306e\u901f\u5ea6\u3068\u8907\u96d1\u3055\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u3042\u306a\u305f\u304c\u5e38\u306b\u3046\u307e\u304f\u3084\u3063\u3066\u3044\u308b\u5834\u5408\u3001\u30b2\u30fc\u30e0\u306f\u3088\u308a\u901f\u304f\u52d5\u304f\u58c1\u3068\u3088\u308a\u8907\u96d1\u306a\u30d1\u30bf\u30fc\u30f3\u3092\u5c0e\u5165\u3057\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u30b2\u30fc\u30e0\u306f\u6311\u6226\u7684\u3067\u3042\u308a\u306a\u304c\u3089\u516c\u5e73\u306b\u306a\u308a\u307e\u3059\u3002[\u8a2d\u5b9a\u5bfe\u7167\u8868: \u7c21\u5358\u30e2\u30fc\u30c9\uff1a\u9045\u3044\u58c1\u3001\u30b7\u30f3\u30d7\u30eb\u306a\u30d1\u30bf\u30fc\u30f3; \u96e3\u3057\u3044\u30e2\u30fc\u30c9\uff1a\u901f\u3044\u58c1\u3001\u8907\u96d1\u306a\u30d1\u30bf\u30fc\u30f3\u3002]"}, {"question": "Shape Walls\u306b\u5bfe\u5fdc\u3059\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306f\u3069\u308c\u3067\u3059\u304b\uff1f\u307e\u305f\u3001\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u4e92\u63db\u6027\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "Shape Walls\u306fPC\u3001Mac\u3001PlayStation\u3084Xbox\u306a\u3069\u306e\u30b3\u30f3\u30bd\u30fc\u30eb\u3067\u5229\u7528\u53ef\u80fd\u3067\u3059\u3002\u3053\u306e\u30b2\u30fc\u30e0\u306f\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u4e92\u63db\u6027\u304c\u3042\u308a\u3001\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u3042\u306a\u305f\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001PC\u3067\u30d7\u30ec\u30a4\u3092\u59cb\u3081\u308b\u3068\u3001\u30c7\u30fc\u30bf\u306e\u640d\u5931\u306a\u304fPlayStation\u3067\u30b2\u30fc\u30e0\u3092\u7d9a\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8: PC \u2192 \u30af\u30e9\u30a6\u30c9\u4fdd\u5b58 \u2192 \u30b3\u30f3\u30bd\u30fc\u30eb\u306f\u3001\u30b7\u30fc\u30e0\u30ec\u30b9\u306a\u79fb\u884c\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002]"}, {"question": "Shape Walls\u3067\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u767a\u898b\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f\u5177\u4f53\u4f8b\u3092\u6559\u3048\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "Shape Walls\u3067\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u767a\u898b\u3059\u308b\u306b\u306f\u3001\u92ed\u3044\u89b3\u5bdf\u529b\u3068\u63a2\u6c42\u5fc3\u304c\u5fc5\u8981\u3067\u3059\u3002\u5fae\u5999\u306a\u74b0\u5883\u306e\u30d2\u30f3\u30c8\u3001\u4f8b\u3048\u3070\u3001\u58c1\u306e\u30c6\u30af\u30b9\u30c1\u30e3\u306e\u308f\u305a\u304b\u306a\u9055\u3044\u3084\u3001\u7570\u5e38\u306a\u30d1\u30bf\u30fc\u30f3\u3092\u63a2\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb7\u3067\u306f\u3001\u4ed6\u306e\u58c1\u3088\u308a\u308f\u305a\u304b\u306b\u9ad8\u3044\u58c1\u3092\u30b8\u30e3\u30f3\u30d7\u3059\u308b\u3053\u3068\u3067\u3001\u96a0\u308c\u305f\u901a\u8def\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u901a\u8def\u306f\u3001\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u3068\u30e6\u30cb\u30fc\u30af\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u304c\u3042\u308b\u79d8\u5bc6\u30a8\u30ea\u30a2\u306b\u901a\u3058\u3066\u3044\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e: \u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u306f\u57cb\u3082\u308c\u305f\u5b9d\u306b\u4f8b\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3058\u3063\u304f\u308a\u3068\u63a2\u3059\u4eba\u3060\u3051\u304c\u767a\u898b\u3057\u307e\u3059\u3002]"}, {"question": "Shape Walls\u306e\u4e3b\u8981\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u306f\u5168\u4f53\u7684\u306a\u30b2\u30fc\u30e0\u4f53\u9a13\u306b\u3069\u306e\u3088\u3046\u306b\u8ca2\u732e\u3057\u3066\u3044\u307e\u3059\u304b\uff1f", "answer": "Shape Walls\u306e\u4e3b\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u306f\u3001\u79fb\u52d5\u3001\u30b8\u30e3\u30f3\u30d7\u3001\u30b9\u30d7\u30ea\u30f3\u30c8\u304c\u542b\u307e\u308c\u3001\u30b2\u30fc\u30e0\u306e\u969c\u5bb3\u7269\u3092\u30ca\u30d3\u30b2\u30fc\u30c8\u3059\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u3055\u3089\u306b\u3001\u30b2\u30fc\u30e0\u306f\u6b63\u78ba\u3055\u3068\u901f\u5ea6\u3092\u5831\u3044\u308b\u30b9\u30b3\u30a2\u500d\u7387\u30b7\u30b9\u30c6\u30e0\u3092\u5099\u3048\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u4e00\u9023\u306e\u58c1\u3092\u30df\u30b9\u306a\u304f\u79fb\u52d5\u3059\u308b\u3068\u3001\u500d\u7387\u304c\u4e0a\u6607\u3057\u3001\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u9ad8\u901f\u3067\u3084\u308a\u304c\u3044\u306e\u3042\u308b\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u751f\u307f\u51fa\u3059\u305f\u3081\u306b\u5354\u8abf\u3057\u3066\u6a5f\u80fd\u3057\u307e\u3059\u3002[\u591a\u65b9\u6848\u6bd4\u8f03: \u4e00\u90e8\u306e\u30b2\u30fc\u30e0\u304c\u6226\u95d8\u306b\u4f9d\u5b58\u3059\u308b
[{"question": "X\u6226\u8eca\u306e\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001X\u30c8\u30ec\u30f3\u30c1\u30e9\u30f3\u3067\u6a5f\u4f53\u306e\u6a5f\u52d5\u529b\u306f\u3069\u3046\u3059\u308c\u3070\u6539\u5584\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "X\u30c8\u30ec\u30f3\u30c1\u30e9\u30f3\u3067\u6a5f\u4f53\u306e\u6a5f\u52d5\u529b\u5411\u4e0a\u306e\u305f\u3081\u306b\u306f\u3001\u8266\u8239\u306e\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u30e1\u30cb\u30e5\u30fc\u3067\u300e\u6a5f\u654f\u6027\u300f\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30b9\u30a6\u30a3\u30d5\u30c8\u30a6\u30a3\u30f3\u30b0\u300f\u8266\u8239\u30e2\u30c7\u30eb\u306f\u6a5f\u654f\u602715\uff05\u4e0a\u6607\u3057\u3001\u72ed\u3044\u5834\u6240\u3067\u306e\u822a\u884c\u3092\u5bb9\u6613\u306b\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u300e\u30af\u30a4\u30c3\u30af\u30bf\u30fc\u30f3\u300f\u80fd\u529b\u3092\u4f7f\u7528\u3057\u3066\u3001\u6025\u6fc0\u306a\u65b9\u5411\u8ee2\u63db\u3092\u884c\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u30e1\u30cb\u30e5\u30fc\u306b\u30a2\u30af\u30bb\u30b9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u300e\u6a5f\u654f\u6027\u300f\u306b\u30dd\u30a4\u30f3\u30c8\u3092\u5272\u308a\u5f53\u3066\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u300e\u30b9\u30a6\u30a3\u30d5\u30c8\u30a6\u30a3\u30f3\u30b0\u300f\u30e2\u30c7\u30eb\u3092\u88c5\u5099\u3057\u307e\u3059\u3002\u3053\u306e\u8a2d\u5b9a\u306f\u3001\u969c\u5bb3\u7269\u3084\u6575\u306e\u653b\u6483\u3092\u304b\u308f\u3059\u306e\u306b\u6700\u9069\u3067\u3059\u3002"}, {"question": "X\u30c8\u30ec\u30f3\u30c1\u30e9\u30f3\u3067\u6700\u7d42\u30dc\u30b9\u3092\u5012\u3059\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "X\u30c8\u30ec\u30f3\u30c1\u30e9\u30f3\u3067\u6700\u7d42\u30dc\u30b9\u3092\u5012\u3059\u306b\u306f\u3001\u9ad8\u3044\u706b\u529b\u3068\u6226\u7565\u7684\u306a\u914d\u7f6e\u304c\u5fc5\u8981\u3068\u306a\u308a\u307e\u3059\u3002\u300e\u30d5\u30a9\u30c8\u30f3\u30ad\u30e3\u30ce\u30f3\u300f\u306f\u9ad8\u3044\u30c0\u30e1\u30fc\u30b8\u51fa\u529b\u306e\u305f\u3081\u4f7f\u7528\u3057\u3001\u30dc\u30b9\u3068\u306e\u8ddd\u96e2\u3092\u4e2d\u8ddd\u96e2\u306b\u3057\u3066\u3001\u30dc\u30b9\u306e\u8fd1\u63a5\u653b\u6483\u3092\u907f\u3051\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u300e\u30d5\u30a9\u30c8\u30f3\u30ad\u30e3\u30ce\u30f3\u300f\u3092\u88c5\u5099\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u4e2d\u8ddd\u96e2\u3092\u7dad\u6301\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5149\u308b\u30b3\u30a2\u306a\u3069\u306e\u30dc\u30b9\u306e\u5f31\u70b9\u306b\u96c6\u4e2d\u3057\u307e\u3059\u3002\u307e\u305f\u3001\u300e\u30b7\u30fc\u30eb\u30c9\u30d6\u30fc\u30b9\u30c8\u300f\u80fd\u529b\u3092\u4f7f\u7528\u3057\u3066\u3001\u6575\u306e\u653b\u6483\u30c0\u30e1\u30fc\u30b8\u3092\u5438\u53ce\u3057\u307e\u3059\u3002\u3053\u306e\u65b9\u6cd5\u306f\u3001100\u6642\u9593\u4ee5\u4e0a\u306e\u30d7\u30ec\u30a4\u6642\u9593\u3067\u591a\u304f\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3088\u3063\u3066\u6709\u52b9\u3067\u3042\u308b\u3053\u3068\u304c\u8a3c\u660e\u3055\u308c\u3066\u3044\u307e\u3059\u3002"}, {"question": "X\u30c8\u30ec\u30f3\u30c1\u30e9\u30f3\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u3069\u306e\u3088\u3046\u306b\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "X\u30c8\u30ec\u30f3\u30c1\u30e9\u30f3\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6575\u306e\u6483\u7834\u3001\u969c\u5bb3\u7269\u306e\u56de\u907f\u3001\u6642\u9593\u30dc\u30fc\u30ca\u30b9\u3068\u3044\u30463\u3064\u306e\u4e3b\u8981\u306a\u8981\u7d20\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30ce\u30f4\u30a1\u30d5\u30a1\u30a4\u30bf\u30fc\u300f\u3092\u7834\u58ca\u3059\u308b\u3068500\u30dd\u30a4\u30f3\u30c8\u3001\u300e\u30ec\u30fc\u30b6\u30fc\u30b2\u30fc\u30c8\u300f\u3092\u56de\u907f\u3059\u308b\u3068200\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u8fc5\u901f\u3067\u6b63\u78ba\u306a\u6483\u7834\u306b\u96c6\u4e2d\u3057\u3001\u300e\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u300f\u80fd\u529b\u3092\u4f7f\u7528\u3057\u3066\u30ec\u30d9\u30eb\u3092\u3088\u308a\u65e9\u304f\u5b8c\u4e86\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u9ad8\u4fa1\u5024\u306e\u30bf\u30fc\u30b2\u30c3\u30c8\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u300e\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u300f\u3092\u4f7f\u7528\u3057\u3066\u3001\u5b8c\u4e86\u6642\u9593\u3092\u77ed\u7e2e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3059\u308b\u305f\u3081\u306b\u3001\u969c\u5bb3\u7269\u3092\u5b8c\u74a7\u306b\u56de\u907f\u3057\u307e\u3059\u3002\u3053\u306e\u6226\u7565\u306f\u3001\u30ea\u30fc\u30c0\u30fc\u30dc\u30fc\u30c9\u3092\u4e0a\u6607\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "X\u30c8\u30ec\u30f3\u30c1\u30e9\u30f3\u3067\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u6700\u3082\u6709\u76ca\u306a\u8266\u8239\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u3069\u308c\u3067\u3059\u304b\uff1f", "answer": "X\u30c8\u30ec\u30f3\u30c1\u30e9\u30f3\u306e\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u653b\u6483\u529b\u3068\u9632\u5fa1\u529b\u3092\u5f37\u5316\u3059\u308b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u512a\u5148\u3059\u308b\u3079\u304d\u3067\u3059\u3002\u300e\u30d7\u30e9\u30ba\u30de\u30d6\u30e9\u30b9\u30bf\u30fc\u300f\u306f\u3001\u7bc4\u56f2\u653b\u6483\u30c0\u30e1\u30fc\u30b8\u306b\u512a\u308c\u3066\u3044\u308b\u305f\u3081\u5f37\u304f\u63a8\u5968\u3055\u308c\u307e\u3059\u3002\u300e\u5f37\u5316\u88c5\u7532\u300f\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u3001\u8266\u8239\u306e\u8010\u4e45\u6027\u309225\uff05\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u300e\u30d7\u30e9\u30ba\u30de\u30d6\u30e9\u30b9\u30bf\u30fc\u300f\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u300e\u5f37\u5316\u88c5\u7532\u300f\u3092\u88c5\u5099\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u3053\u308c\u3089\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u300e\u30a8\u30cd\u30eb\u30ae\u30fc\u30b7\u30fc\u30eb\u30c9\u300f\u30a2\u30d3\u30ea\u30c6\u30a3\u3068\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3001\u6700\u5927\u9650\u306e\u751f\u5b58\u529b\u3092\u5f97\u3089\u308c\u307e\u3059\u3002\u3053\u306e\u8a2d\u5b9a\u306f\u3001\u7279\u306b\u9ad8\u96e3\u5ea6\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u52b9\u679c\u7684\u3067\u3059\u3002"}, {"question": "X\u30c8\u30ec\u30f3\u30c1\u30e9\u30f3\u3067PC\u7248\u306e\u9032\u6357\u72b6\u6cc1\u3092\u30e2\u30d0\u30a4\u30eb\u7248\u306b\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "X\u30c8\u30ec\u30f3\u30c1\u30e9\u30f3\u3067PC\u7248\u306e\u9032\u6357\u72b6\u6cc1\u3092\u30e2\u30d0\u30a4\u30eb\u7248\u306b\u8ee2\u9001\u3059\u308b\u306e\u306f\u7c21\u5358\u3067\u3059\u3002\u307e\u305a\u3001\u4e21\u65b9\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u304f\u3060\u3055\u3044\u3002PC\u306e\u30bb\u30c3\u30c6\u30a3\u30f3\u30b0\u30e1\u30cb\u30e5\u30fc\u3067\u300e\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u300f\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u958b\u304d\u3001\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u6b21\u306b\u3001\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30e1\u30cb\u30e5\u30fc\u306b\u30a2\u30af\u30bb\u30b9\u3057\u3001\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1aPC\u304b\u3089\u30bb\u30fc\u30d6\u30d5\u30a1\u30a4\u30eb\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u3067\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u3053\u306e\u30d7\u30ed\u30bb\u30b9\u306b\u3088\u308a\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u9032\u6357\u72b6\u6cc1\u304c\u540c\u671f\u3055\u308c\u307e\u3059\u3002"}, {"question": "X\u30c8\u30ec\u30f3\u30c1\u30e9\u30f3\u306e\u96a0\u3057\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u4f55\u3067\u3059\u304b\u3001\u305d\u3057\u3066\u305d\u308c\u3089\u3092\u898b\u3064\u3051\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "X\u30c8\u30ec\u30f3\u30c1\u30e9\u30f3\u306b\u306f\u3001\u300e\u4e0d\u53ef\u8996\u306e\u30ed\u30fc\u30d6\u300f\u3084\u300e\u30c8\u30ea\u30d7\u30eb\u30b7\u30e7\u30c3\u30c8\u300f\u306a\u3069\u3001\u3044\u304f\u3064\u304b\u306e\u96a0\u3057\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u3001\u79d8\u5bc6\u306e\u30a8\u30ea\u30a2\u3084\u7834\u58ca\u53ef\u80fd\u306a\u58c1\u306e\u5f8c\u308d\u306b\u96a0\u308c\u3066\u3044\u308b\u3053\u3068\u304c\u3088\u304f\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u4e0d\u53ef\u8996\u306e\u30ed\u30fc\u30d6\u300f\u306f\u30ec\u30d9\u30eb5\u3067\u3001\u5de6\u4e0a\u306e\u7279\u5b9a\u306e\u58c1\u3092\u7834\u58ca\u3059\u308b\u3053\u3068\u3067\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u3088\u304f\u6b69\u304b\u306a\u3044\u30a8\u30ea\u30a2\u3092\u63a2\u691c\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u7834\u58ca\u53ef\u80fd\u306a\u58c1\u3092\u63a2\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u300e\u30b9\u30ad\u30e3\u30ca\u30fc\u300f\u80fd\u529b\u3092\u4f7f\u7528\u3057\u3066\u3001\u96a0\u3055\u308c\u305f\u30a2\u30a4\u30c6\u30e0\u3092\u660e\u3089\u304b\u306b\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4f53\u9a13\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "X\u30c8\u30ec\u30f3\u30c1\u30e9\u30f3\u306e\u30b9\u30d4\u30fc\u30c9\u30e9\u30f3\u306e\u305f\u3081\u306b\u3001\u8266\u8239\u306e\u88c5\u5099\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "X\u30c8\u30ec\u30f3\u30c1\u30e9\u30f3\u306e\u30b9\u30d4\u30fc\u30c9\u30e9\u30f3\u306e\u305f\u3081\u306b\u8266\u8239\u306e\u88c5\u5099\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u901f\u5ea6\u3068\u6700\u5c0f\u9650\u306e\u30c0\u30a6\u30f3\u30bf\u30a4\u30e0\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u300e\u30bf\u30fc\u30dc\u30a8\u30f3\u30b8\u30f3\u300f\u3092\u88c5\u5099\u3057\u3066\u300120\uff05\u306e\u901f\u5ea6\u30d6\u30fc\u30b9\u30c8\u3092\u5f97\u3066\u3001\u6575\u3092\u7d20\u65e9\u304f\u6392\u9664\u3059\u308b\u305f\u3081\u306b\u300e\u901f\u5c04\u300f\u6b66\u5668\u3092\u88c5\u5099\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u300e\u30bf\u30fc\u30dc\u30a8\u30f3\u30b8\u30f3\u300f\u3092\u88c5\u5099\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u300e\u901f\u5c04\u300f\u6b66\u5668\u3092\u88c5\u5099\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u300e\u30d6\u30fc\u30b9\u30c8\u30c1\u30e3\u30fc\u30b8\u300f\u30a2\u30d3\u30ea\u30c6\u30a3\u3092\u4f7f\u7528\u3057\u3066\u3001\u9ad8\u3044\u901f\u5ea6\u3092\u7dad\u6301\u3057\u307e\u3059\u3002\u3053\u306e\u8a2d\u5b9a\u306b\u3088\u308a\u3001\u30ec\u30d9\u30eb\u3092\u8a18\u9332\u7684\u306a\u6642\u9593\u3067\u5b8c\u4e86\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u30b9\u30d4\u30fc\u30c9\u30e9\u30f3\u306b\u6700\u9069\u3067\u3059\u3002"}, {"question": "X\u30c8\u30ec\u30f3\u30c1\u30e9\u30f3\u306e\u8266\u8239\u30af\u30e9\u30b9\u9593\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "X\u30c8\u30ec\u30f3\u30c1\u30e9\u30f3\u306e\u8266\u8239\u30af\u30e9\u30b9\u306f\u3001\u30b9\u30c6\u30fc\u30bf\u30b9\u3068\u30a2\u30d3\u30ea\u30c6\u30a3\u304c\u4e3b\u306b\u7570\u306a\u308a\u307e\u3059\u3002\u300e\u30d5\u30a1\u30a4\u30bf\u30fc\u300f\u30af\u30e9\u30b9\u306f\u6a5f\u654f\u6027\u3068\u901f\u5ea6\u306b\u512a\u308c\u3066\u304a\u308a\u3001\u300e\u30bf\u30f3\u30af\u300f\u30af\u30e9\u30b9\u306f\u512a\u308c\u305f\u8010\u4e45\u6027\u3092\u5099\u3048\u3001\u300e\u30dc\u30de\u30fc\u300f\u30af\u30e9\u30b9\u306f\u7bc4\u56f2\u653b\u6483\u306b\u7279\u5316\u3057\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30d5\u30a1\u30a4\u30bf\u30fc\u300f\u30af\u30e9\u30b9\u306e\u300e\u30af\u30a4\u30c3\u30af\u30bf\u30fc\u30f3\u300f\u30a2\u30d3\u30ea\u30c6\u30a3\u306f\u3001\u7d20\u65e9\u3044\u65b9\u5411\u8ee2\u63db\u3092\u53ef\u80fd\u306b\u3057\u3001\u300e\u30bf\u30f3\u30af\u300f\u30af\u30e9\u30b9\u306e\u300e\u88c5\u7532\u5f37\u5316\u300f\u30a2\u30d3\u30ea\u30c6\u30a3\u306f\u3001\u53d7\u3051\u53d6\u308b\u30c0\u30e1\u30fc\u30b8\u309230\uff05\u8efd\u6e1b\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u9055\u3044\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u81ea\u5206\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u9069\u3057\u305f\u30af\u30e9\u30b9\u3092\u9078\u629e\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "X\u30c8\u30ec\u30f3\u30c1\u30e9\u30f3\u306e\u96a0\u3057\u30a8\u30f3\u30c7\u30a3\u30f3\u30b0\u306f\u3069\u306e\u3088\u3046\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "X\u30c8\u30ec\u30f3\u30c1\u30e9\u30f3\u306e\u96a0\u3057\u30a8\u30f3\u30c7\u30a3\u30f3\u30b0\u3092\u958b\u653e\u3059\u308b\u306b\u306f\u3001\u3059\u3079\u3066\u306e\u30ec\u30d9\u30eb\u3092\u300eS\u300f\u30e9\u30f3\u30af\u3067\u30af\u30ea\u30a2\u3057\u3001\u3059\u3079\u3066\u306e\u96a0\u3057\u53ce\u96c6\u30a2\u30a4\u30c6\u30e0\u3092\u898b\u3064\u3051\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb10\u3067\u306f\u3001\u30c0\u30e1\u30fc\u30b8\u3092\u53d7\u3051\u305a\u306b\u30dc\u30b9\u3092\u5012\u3057\u3066\u300eS\u300f\u30e9\u30f3\u30af\u3092\u7372\u5f97\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u3059\u3079\u3066\u306e\u30ec\u30d9\u30eb\u3092\u300eS\u300f\u30e9\u30f3\u30af\u3067\u30af\u30ea\u30a2\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u3059\u3079\u3066\u306e\u96a0\u3057\u30a2\u30a4\u30c6\u30e0\u3092\u53ce\u96c6\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6700\u7d42\u30dc\u30b9\u6226\u5f8c\u306e\u7279\u5225\u306a\u30ab\u30c3\u30c8\u30b7\u30fc\u30f3\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u3053\u306e\u30a8\u30f3\u30c7\u30a3\u30f3\u30b0\u306f\u3001\u8ffd\u52a0\u306e\u80cc\u666f\u3068\u9054\u6210\u611f\u3092\u4e0e\u3048\u3066\u304f\u308c\u307e\u3059\u3002"}, {"question": "X\u30c8\u30ec\u30f3\u30c1\u30e9\u30f3\u3067\u4f4e\u30a8\u30f3\u30c9\u30c7\u30d0\u30a4\u30b9\u3067\u30b9\u30e0\u30fc\u30ba\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4f53\u9a13\u3092\u5f97\u308b\u305f\u3081\u306e\u6700\u9069\u306a\u8a2d\u5b9a\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "X\u30c8\u30ec\u30f3\u30c1\u30e9\u30f3\u3067\u4f4e\u30a8\u30f3\u30c9\u30c7\u30d0\u30a4\u30b9\u3067\u30b9\u30e0\u30fc\u30ba\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4f53\u9a13\u3092\u5f97\u308b\u305f\u3081\u306b\u306f\u3001\u30b0\u30e9\u30d5\u30a3\u30ab\u30eb\u306a\u8ca0\u8377\u3092\u6e1b\u3089\u3059\u3088\u3046\u306b\u8a2d\u5b9a\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u300e\u30c6\u30af\u30b9\u30c1\u30e3\u54c1\u8cea\u300f\u3092\u300e\u4f4e\u300f\u306b\u4e0b\u3052\u3001\u300e\u5f71\u300f\u3068\u300e\u30dd\u30b9\u30c8\u30d7\u30ed\u30bb\u30b9\u300f\u3092\u30aa\u30d5\u306b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u3092\u958b\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u300e\u30c6\u30af\u30b9\u30c1\u30e3\u54c1\u8cea\u300f\u3092\u300e\u4f4e\u300f\u306b\u8a2d\u5b9a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u300e\u5f71\u300f\u3068\u300e\u30dd\u30b9\u30c8\u30d7\u30ed\u30bb\u30b9\u300f\u3092\u30aa\u30d5\u306b\u3057\u307e\u3059\u3002 \u3053\u308c\u3089\u306e\u5909\u66f4\u306f\u3001\u8996\u899a\u7684\u306a\u7d4c\u9a13\u306b\u5927\u304d\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u3053\u3068\u306a\u304f\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6539\u5584\u3057\u3001\u3088\u308a\u30d1\u30ef\u30fc\u306e\u4f4e\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u30b9\u30e0\u30fc\u30ba\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5b9f\u73fe\u3057\u307e\u3059\u3002"}]
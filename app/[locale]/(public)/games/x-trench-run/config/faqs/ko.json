[{"question": "\ucd08\ubcf4\uc790\ub85c\uc11c X \uae09\ub958\uc5d0\uc11c \ud568\uc120\uc758 \uae30\ub3d9\uc131\uc744 \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "X \uae09\ub958\uc5d0\uc11c \ud568\uc120\uc758 \uae30\ub3d9\uc131\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub824\uba74 \ud568\uc120 \ub9de\ucda4 \uc124\uc815 \uba54\ub274\uc5d0\uc11c '\ubbfc\ucca9\uc131' \ub2a5\ub825\uce58\ub97c \uac15\ud654\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\ube60\ub978 \ub0a0\uac1c' \ud568\uc120 \ubaa8\ub378\uc740 \uae30\ub3d9\uc131\uc744 15% \ud5a5\uc0c1\uc2dc\ucf1c \uc881\uc740 \uacf5\uac04\uc5d0\uc11c \uc6c0\uc9c1\uc774\uae30 \ub354\uc6b1 \uc27d\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \ubc29\ud5a5\uc744 \ube60\ub974\uac8c \ubc14\uafc0 \uc218 \uc788\ub294 '\ube60\ub978 \ud68c\uc804' \ub2a5\ub825\uc744 \uc5f0\uc2b5\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 1: \ub9de\ucda4 \uc124\uc815 \uba54\ub274\uc5d0 \uc811\uc18d\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: '\ubbfc\ucca9\uc131'\uc5d0 \uc810\uc218\ub97c \ud560\ub2f9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: '\ube60\ub978 \ub0a0\uac1c' \ubaa8\ub378\uc744 \uc7a5\ucc29\ud569\ub2c8\ub2e4. \uc774 \uc124\uc815\uc740 \uc7a5\uc560\ubb3c\uacfc \uc801\uc758 \uacf5\uaca9\uc744 \ud53c\ud558\ub294 \ub370 \uc774\uc0c1\uc801\uc785\ub2c8\ub2e4."}, {"question": "X \uae09\ub958\uc5d0\uc11c \ucd5c\uc885 \ubcf4\uc2a4\ub97c \ubb3c\ub9ac\uce58\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "X \uae09\ub958\uc5d0\uc11c \ucd5c\uc885 \ubcf4\uc2a4\ub97c \ubb3c\ub9ac\uce58\ub824\uba74 \ub192\uc740 \ud654\ub825\uacfc \uc804\ub7b5\uc801\uc778 \uc704\uce58 \uc120\uc815\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub192\uc740 \ud53c\ud574\ub7c9\uc744 \uc790\ub791\ud558\ub294 '\uad11\uc790\ud3ec'\ub97c \uc0ac\uc6a9\ud558\uace0 \ubcf4\uc2a4\uc758 \uadfc\uc811 \uacf5\uaca9\uc744 \ud53c\ud558\uae30 \uc704\ud574 \ud568\uc120\uc744 \uc911\uac04 \uac70\ub9ac\uc5d0 \uc720\uc9c0\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 1: '\uad11\uc790\ud3ec'\ub97c \uc7a5\ucc29\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc911\uac04 \uac70\ub9ac\ub97c \uc720\uc9c0\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ube5b\ub098\ub294 \uc911\uc2ec\ubd80\uc640 \uac19\uc774 \ubcf4\uc2a4\uc758 \uc57d\uc810\uc5d0 \uc9d1\uc911\ud569\ub2c8\ub2e4. \ub610\ud55c, \ub4e4\uc5b4\uc624\ub294 \ud53c\ud574\ub97c \ud761\uc218\ud558\ub294 '\ubc29\ud328 \uac15\ud654' \ub2a5\ub825\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \uc774 \ubc29\ubc95\uc740 100\uc2dc\uac04 \uc774\uc0c1\uc758 \uac8c\uc784 \ud50c\ub808\uc774\ub85c \ub9ce\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \ud6a8\uacfc\uc801\uc774\ub77c\uace0 \uc785\uc99d\ud588\uc2b5\ub2c8\ub2e4."}, {"question": "X \uae09\ub958\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "X \uae09\ub958\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc8fc\uc694 \uc694\uc18c \uc138 \uac00\uc9c0 \uc989, \uc801 \ucc98\uce58, \uc7a5\uc560\ubb3c \ud68c\ud53c \ubc0f \uc2dc\uac04 \ubcf4\ub108\uc2a4\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub178\ubc14 \uc804\ud22c\uae30'\ub97c \ud30c\uad34\ud558\uba74 500\uc810\uc774 \ubd80\uc5ec\ub418\uace0 '\ub808\uc774\uc800 \ud1b5\ub85c'\ub97c \ud68c\ud53c\ud558\uba74 200\uc810\uc774 \ucd94\uac00\ub429\ub2c8\ub2e4. \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud558\ub824\uba74 \ube60\ub974\uace0 \uc815\ud655\ud558\uac8c \uc801\uc744 \ucc98\uce58\ud558\uace0 \ub808\ubca8\uc744 \ub354 \ube60\ub974\uac8c \ub9c8\ubb34\ub9ac\ud558\uae30 \uc704\ud574 '\uc18d\ub3c4 \uac15\ud654' \ub2a5\ub825\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 1: \uace0\uac00\uce58 \ud45c\uc801\uc744 \uc6b0\uc120\uc2dc\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: '\uc18d\ub3c4 \uac15\ud654'\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc644\ub8cc \uc2dc\uac04\uc744 \uc904\uc785\ub2c8\ub2e4. \ub2e8\uacc4 3: \ubcf4\ub108\uc2a4 \uc810\uc218\ub97c \uc704\ud574 \uc7a5\uc560\ubb3c\uc744 \uc644\ubcbd\ud558\uac8c \ud68c\ud53c\ud569\ub2c8\ub2e4. \uc774 \uc804\ub7b5\uc740 \ub9ac\ub354\ubcf4\ub4dc \uc21c\uc704\ub97c \ub192\uc774\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4."}, {"question": "X \uae09\ub958\uc5d0\uc11c \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uac00\uc7a5 \uc720\uc6a9\ud55c \ud568\uc120 \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "X \uae09\ub958\uc5d0\uc11c \uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \uacf5\uaca9\ub825\uacfc \ubc29\uc5b4\ub825 \ubaa8\ub450\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc6b0\uc120\uc2dc\ud574\uc57c \ud569\ub2c8\ub2e4. '\ud50c\ub77c\uc988\ub9c8 \ube14\ub798\uc2a4\ud130'\ub294 \uc601\uc5ed \ud53c\ud574\ub97c \uc720\ubc1c\ud558\uae30 \ub54c\ubb38\uc5d0 \uac15\ub825\ud788 \ucd94\ucc9c\ub418\uba70, '\uac15\ud654\ub41c \uac11\uc637' \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \ud568\uc120\uc758 \ub0b4\uad6c\uc131\uc744 25% \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4. \ub2e8\uacc4 1: '\ud50c\ub77c\uc988\ub9c8 \ube14\ub798\uc2a4\ud130'\ub97c \ud574\uc81c\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: '\uac15\ud654\ub41c \uac11\uc637'\uc744 \uc124\uce58\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ucd5c\ub300 \uc0dd\uc874\ub825\uc744 \uc704\ud574 '\uc5d0\ub108\uc9c0 \ubc29\ud328' \ub2a5\ub825\uacfc \uacb0\ud569\ud569\ub2c8\ub2e4. \uc774 \uc124\uc815\uc740 \ud2b9\ud788 \uace0\ub09c\uc774\ub3c4 \uc784\ubb34\uc5d0\uc11c \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4."}, {"question": "X \uae09\ub958\uc5d0\uc11c PC \uc9c4\ud589 \uc0c1\ud669\uc744 \ubaa8\ubc14\uc77c\ub85c \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "X \uae09\ub958\uc5d0\uc11c PC \uc9c4\ud589 \uc0c1\ud669\uc744 \ubaa8\ubc14\uc77c\ub85c \uc804\uc1a1\ud558\ub294 \uac83\uc740 \uac04\ub2e8\ud569\ub2c8\ub2e4. \uba3c\uc800 \ub450 \ud50c\ub7ab\ud3fc \ubaa8\ub450\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. PC\uc758 \uc124\uc815 \uba54\ub274\uc5d0\uc11c '\ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5' \uc635\uc158\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec \uc800\uc7a5 \ud30c\uc77c\uc744 \uc5c5\ub85c\ub4dc\ud569\ub2c8\ub2e4. \uadf8\ub7f0 \ub2e4\uc74c \ubaa8\ubc14\uc77c \uc7a5\uce58\uc5d0\uc11c \ub3d9\uc77c\ud55c \uba54\ub274\uc5d0 \uc811\uc18d\ud558\uc5ec \uc800\uc7a5 \ud30c\uc77c\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 1: \ub450 \uc7a5\uce58 \ubaa8\ub450\uc5d0\uc11c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: PC\uc5d0\uc11c \uc800\uc7a5 \ud30c\uc77c\uc744 \uc5c5\ub85c\ub4dc\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ubaa8\ubc14\uc77c \uc7a5\uce58\uc5d0\uc11c \ub2e4\uc6b4\ub85c\ub4dc\ud569\ub2c8\ub2e4. \uc774 \uacfc\uc815\uc744 \ud1b5\ud574 \uc9c4\ud589 \uc0c1\ud669\uc774 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4."}, {"question": "X \uae09\ub958\uc758 \uc228\uaca8\uc9c4 \ud30c\uc6cc\uc5c5\uc740 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "X \uae09\ub958\uc5d0\ub294 '\ud22c\uba85 \ub9dd\ud1a0' \ubc0f '3\uc5f0\ubc1c \uc0ac\uaca9'\uacfc \uac19\uc740 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \ud30c\uc6cc\uc5c5\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud30c\uc6cc\uc5c5\uc740 \uc885\uc885 \ube44\ubc00 \uc7a5\uc18c\ub098 \ud30c\uad34 \uac00\ub2a5\ud55c \ubcbd \ub4a4\uc5d0 \uc704\uce58\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud22c\uba85 \ub9dd\ud1a0'\ub294 \uc0c1\ub2e8 \uc67c\ucabd \ubaa8\uc11c\ub9ac\uc5d0 \uc788\ub294 \ud2b9\uc815 \ubcbd\uc744 \ud30c\uad34\ud558\uc5ec 5\ub808\ubca8\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \ub35c \uc54c\ub824\uc9c4 \uc601\uc5ed\uc744 \ud0d0\ud5d8\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ud30c\uad34 \uac00\ub2a5\ud55c \ubcbd\uc744 \ucc3e\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 3: '\uc2a4\uce90\ub108' \ub2a5\ub825\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc228\uaca8\uc9c4 \uc544\uc774\ud15c\uc744 \ub4dc\ub7ec\ub0c5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud30c\uc6cc\uc5c5\uc740 \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "X \uae09\ub958\uc5d0\uc11c \uc2a4\ud53c\ub4dc\ub7f0\uc744 \uc704\ud574 \ud568\uc120 \uc7a5\ube44\ub97c \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "X \uae09\ub958\uc5d0\uc11c \uc2a4\ud53c\ub4dc\ub7f0\uc744 \uc704\ud574 \ud568\uc120 \uc7a5\ube44\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc18d\ub3c4\uc640 \ucd5c\uc18c\ud55c\uc758 \uc9c0\uc5f0 \uc2dc\uac04\uc5d0 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. '\ud130\ubcf4 \uc5d4\uc9c4'\uc744 \uc7a5\ucc29\ud558\uc5ec \uc18d\ub3c4\ub97c 20% \ud5a5\uc0c1\uc2dc\ud0a4\uace0 '\uc18d\uc0ac' \ubb34\uae30\ub97c \uc7a5\ucc29\ud558\uc5ec \uc801\uc744 \uc2e0\uc18d\ud558\uac8c \uc81c\uac70\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 1: '\ud130\ubcf4 \uc5d4\uc9c4'\uc744 \uc124\uce58\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: '\uc18d\uc0ac' \ubb34\uae30\ub97c \uc7a5\ucc29\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ub192\uc740 \uc18d\ub3c4\ub97c \uc720\uc9c0\ud558\uae30 \uc704\ud574 '\ubd80\uc2a4\ud2b8 \ucda9\uc804' \ub2a5\ub825\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc774 \uc124\uc815\uc744 \ud1b5\ud574 \ub808\ubca8\uc744 \uae30\ub85d\uc801\uc778 \uc2dc\uac04 \ub0b4\uc5d0 \uc644\ub8cc\ud560 \uc218 \uc788\uc73c\ubbc0\ub85c \uc2a4\ud53c\ub4dc\ub7f0\uc5d0 \uc774\uc0c1\uc801\uc785\ub2c8\ub2e4."}, {"question": "X \uae09\ub958\uc758 \ud568\uc120 \ud074\ub798\uc2a4 \uac04 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "X \uae09\ub958\uc758 \ud568\uc120 \ud074\ub798\uc2a4\ub294 \uc8fc\ub85c \ub2a5\ub825\uce58\uc640 \ub2a5\ub825\uc774 \ub2e4\ub985\ub2c8\ub2e4. '\uc804\ud22c\uae30' \ud074\ub798\uc2a4\ub294 \ubbfc\ucca9\uc131\uacfc \uc18d\ub3c4\uc5d0\uc11c \ub6f0\uc5b4\ub098\uba70, '\ud0f1\ud06c' \ud074\ub798\uc2a4\ub294 \ub6f0\uc5b4\ub09c \ub0b4\uad6c\uc131\uc744 \uc81c\uacf5\ud558\uace0, '\ud3ed\uaca9\uae30' \ud074\ub798\uc2a4\ub294 \uc601\uc5ed \ud53c\ud574\uc5d0 \ud2b9\ud654\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc804\ud22c\uae30' \ud074\ub798\uc2a4\uc758 '\ube60\ub978 \ud68c\uc804' \ub2a5\ub825\uc740 \ube60\ub974\uac8c \ubc29\ud5a5\uc744 \ubc14\uafc0 \uc218 \uc788\uc73c\uba70, '\ud0f1\ud06c' \ud074\ub798\uc2a4\uc758 '\uc7a5\uac11 \uac15\ud654'\ub294 \ub4e4\uc5b4\uc624\ub294 \ud53c\ud574\ub97c 30% \uac10\uc18c\uc2dc\ud0b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ucc28\uc774\uc810\uc744 \uc774\ud574\ud558\uba74 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\ub294 \uc62c\ubc14\ub978 \ud074\ub798\uc2a4\ub97c \uc120\ud0dd\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "X \uae09\ub958\uc5d0\uc11c \ube44\ubc00 \uc5d4\ub529\uc744 \uc5b4\ub5bb\uac8c \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "X \uae09\ub958\uc5d0\uc11c \ube44\ubc00 \uc5d4\ub529\uc744 \ud574\uc81c\ud558\ub824\uba74 \ubaa8\ub4e0 \ub808\ubca8\uc744 'S' \ub4f1\uae09\uc73c\ub85c \uc644\ub8cc\ud558\uace0 \ubaa8\ub4e0 \uc228\uaca8\uc9c4 \uc218\uc9d1\ud488\uc744 \ucc3e\uc544\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 10\ub808\ubca8\uc5d0\uc11c \ubcf4\uc2a4\ub97c \ud53c\ud574 \uc5c6\uc774 \ubb3c\ub9ac\uce58\uba74 'S' \ub4f1\uae09\uc744 \ub2ec\uc131\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \ubaa8\ub4e0 \ub808\ubca8\uc5d0\uc11c 'S' \ub4f1\uae09\uc744 \ub2ec\uc131\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ubaa8\ub4e0 \uc228\uaca8\uc9c4 \uc544\uc774\ud15c\uc744 \uc218\uc9d1\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ucd5c\uc885 \ubcf4\uc2a4 \ud6c4 \ud2b9\ubcc4\ud55c \uc601\uc0c1\uc774 \ub098\uc624\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. \uc774 \uc5d4\ub529\uc740 \ucd94\uac00\uc801\uc778 \ubc30\uacbd \uc2a4\ud1a0\ub9ac\uc640 \uc131\ucde8\uac10\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}, {"question": "\uc800\uc0ac\uc591 \uae30\uae30\uc5d0\uc11c X \uae09\ub958\uc758 \uc6d0\ud65c\ud55c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc704\ud55c \ucd5c\uc801\uc758 \uc124\uc815\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc800\uc0ac\uc591 \uae30\uae30\uc5d0\uc11c X \uae09\ub958\uc758 \uc6d0\ud65c\ud55c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc704\ud574 \uc124\uc815\uc744 \uc870\uc815\ud558\uc5ec \uadf8\ub798\ud53d \ubd80\ud558\ub97c \uc904\uc774\uc2ed\uc2dc\uc624. '\ud14d\uc2a4\ucc98 \ud488\uc9c8'\uc744 '\ub0ae\uc74c'\uc73c\ub85c \uc124\uc815\ud558\uace0 '\uadf8\ub9bc\uc790' \ubc0f '\ud6c4\ucc98\ub9ac'\ub97c \ube44\ud65c\uc131\ud654\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 1: \uc124\uc815 \uba54\ub274\ub97c \uc5fd\ub2c8\ub2e4. \ub2e8\uacc4 2: '\ud14d\uc2a4\ucc98 \ud488\uc9c8'\uc744 '\ub0ae\uc74c'\uc73c\ub85c \uc124\uc815\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: '\uadf8\ub9bc\uc790' \ubc0f '\ud6c4\ucc98\ub9ac'\ub97c \ube44\ud65c\uc131\ud654\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ubcc0\uacbd \uc0ac\ud56d\uc740 \uc2dc\uac01\uc801 \uacbd\ud5d8\uc5d0 \ud070 \uc601\ud5a5\uc744 \uc8fc\uc9c0 \uc54a\uace0 \uc131\ub2a5\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ubbc0\ub85c, \uc131\ub2a5\uc774 \ub5a8\uc5b4\uc9c0\ub294 \uae30\uae30\uc5d0\uc11c\ub3c4 \uc6d0\ud65c\ud55c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}]
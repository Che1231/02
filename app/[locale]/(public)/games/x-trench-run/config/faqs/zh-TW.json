[{"question": "\u5982\u4f55\u63d0\u5347\u6211\u5728 X \u5879\u9053\u7af6\u901f\u8cfd\u7684\u521d\u5b78\u8005\u7d1a\u5225\u7684\u8266\u96bb\u64cd\u63a7\u80fd\u529b\uff1f", "answer": "\u8981\u63d0\u5347\u4f60\u5728 X \u5879\u9053\u7af6\u901f\u8cfd\u7684\u8266\u96bb\u64cd\u63a7\u80fd\u529b\uff0c\u8acb\u96c6\u4e2d\u63d0\u5347\u8266\u96bb\u5ba2\u88fd\u5316\u9078\u55ae\u4e2d\u7684\u300e\u9748\u6d3b\u5ea6\u300f\u5c6c\u6027\u3002\u4f8b\u5982\uff0c\u300e\u8fc5\u6377\u7ffc\u300f\u8266\u6a21\u578b\u53ef\u4ee5\u63d0\u5347 15% \u7684\u9748\u6d3b\u5ea6\uff0c\u8b93\u4f60\u5728\u72f9\u7a84\u7a7a\u9593\u66f4\u5bb9\u6613\u64cd\u63a7\u3002\u6b64\u5916\uff0c\u8acb\u7df4\u7fd2\u4f7f\u7528\u300e\u5feb\u901f\u8f49\u5411\u300f\u80fd\u529b\uff0c\u53ef\u4ee5\u9032\u884c\u5feb\u901f\u7684\u65b9\u5411\u6539\u8b8a\u3002\u6b65\u9a5f\u4e00\uff1a\u9032\u5165\u5ba2\u88fd\u5316\u9078\u55ae\u3002\u6b65\u9a5f\u4e8c\uff1a\u5206\u914d\u9ede\u6578\u5230\u300e\u9748\u6d3b\u5ea6\u300f\u3002\u6b65\u9a5f\u4e09\uff1a\u88dd\u5099\u300e\u8fc5\u6377\u7ffc\u300f\u6a21\u578b\u3002\u6b64\u8a2d\u5b9a\u975e\u5e38\u9069\u5408\u9583\u8eb2\u969c\u7919\u7269\u548c\u6575\u65b9\u653b\u64ca\u3002"}, {"question": "\u5728 X \u5879\u9053\u7af6\u901f\u8cfd\u4e2d\uff0c\u64ca\u6557\u6700\u7d42\u9996\u9818\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728 X \u5879\u9053\u7af6\u901f\u8cfd\u4e2d\u64ca\u6557\u6700\u7d42\u9996\u9818\u9700\u8981\u9ad8\u706b\u529b\u548c\u6230\u7565\u90e8\u7f72\u7684\u7d50\u5408\u3002\u4f7f\u7528\u300e\u5149\u5b50\u7832\u300f\uff0c\u5176\u8f38\u51fa\u9ad8\u50b7\u5bb3\uff0c\u4e26\u4fdd\u6301\u8266\u96bb\u4e2d\u8ddd\u96e2\u4ee5\u907f\u514d\u9996\u9818\u7684\u8fd1\u6230\u653b\u64ca\u3002\u6b65\u9a5f\u4e00\uff1a\u88dd\u5099\u300e\u5149\u5b50\u7832\u300f\u3002\u6b65\u9a5f\u4e8c\uff1a\u4fdd\u6301\u4e2d\u8ddd\u96e2\u3002\u6b65\u9a5f\u4e09\uff1a\u96c6\u4e2d\u653b\u64ca\u9996\u9818\u7684\u5f31\u9ede\uff0c\u4f8b\u5982\u767c\u5149\u7684\u6838\u5fc3\u3002\u6b64\u5916\uff0c\u4f7f\u7528\u300e\u9632\u79a6\u52a0\u5f37\u300f\u80fd\u529b\u5438\u6536\u6575\u65b9\u653b\u64ca\u3002\u6b64\u65b9\u6cd5\u5df2\u88ab\u8a31\u591a\u904a\u6232\u6642\u9593\u8d85\u904e 100 \u5c0f\u6642\u7684\u73a9\u5bb6\u8b49\u660e\u6709\u6548\u3002"}, {"question": "X \u5879\u9053\u7af6\u901f\u8cfd\u7684\u8a08\u5206\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u5927\u5316\u6211\u7684\u5206\u6578\uff1f", "answer": "X \u5879\u9053\u7af6\u901f\u8cfd\u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u4e09\u500b\u4e3b\u8981\u56e0\u7d20\uff1a\u6575\u4eba\u64ca\u6bba\u6578\u3001\u969c\u7919\u7269\u9583\u907f\u4ee5\u53ca\u6642\u9593\u734e\u52f5\u3002\u4f8b\u5982\uff0c\u6467\u6bc0\u300e\u65b0\u661f\u6230\u9b25\u6a5f\u300f\u53ef\u7372\u5f97 500 \u5206\uff0c\u800c\u9583\u907f\u300e\u96f7\u5c04\u9598\u9053\u300f\u53ef\u7372\u5f97 200 \u5206\u3002\u8981\u6700\u5927\u5316\u4f60\u7684\u5206\u6578\uff0c\u8acb\u96c6\u4e2d\u7cbe\u529b\u5feb\u901f\u7cbe\u78ba\u5730\u64ca\u6bba\u6575\u4eba\uff0c\u4e26\u4f7f\u7528\u300e\u52a0\u901f\u300f\u80fd\u529b\u4ee5\u66f4\u5feb\u5730\u5b8c\u6210\u95dc\u5361\u3002\u6b65\u9a5f\u4e00\uff1a\u512a\u5148\u653b\u64ca\u9ad8\u50f9\u503c\u76ee\u6a19\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u300e\u52a0\u901f\u300f\u4ee5\u6e1b\u5c11\u5b8c\u6210\u6642\u9593\u3002\u6b65\u9a5f\u4e09\uff1a\u5b8c\u7f8e\u9583\u907f\u969c\u7919\u7269\u4ee5\u7372\u5f97\u984d\u5916\u5206\u6578\u3002\u6b64\u7b56\u7565\u5c07\u5e6b\u52a9\u4f60\u63d0\u5347\u6392\u884c\u699c\u3002"}, {"question": "\u5728 X \u5879\u9053\u7af6\u901f\u8cfd\u4e2d\uff0c\u54ea\u4e9b\u8266\u96bb\u5347\u7d1a\u5c0d\u9032\u968e\u73a9\u5bb6\u6700\u6709\u5229\uff1f", "answer": "\u5728 X \u5879\u9053\u7af6\u901f\u8cfd\u4e2d\uff0c\u9032\u968e\u73a9\u5bb6\u61c9\u512a\u5148\u5347\u7d1a\u90a3\u4e9b\u80fd\u540c\u6642\u63d0\u5347\u653b\u64ca\u548c\u9632\u79a6\u7684\u5347\u7d1a\u9805\u76ee\u3002\u300e\u7b49\u96e2\u5b50\u96fb\u6f3f\u70ae\u300f\u975e\u5e38\u63a8\u85a6\uff0c\u56e0\u70ba\u5b83\u5177\u6709\u7bc4\u570d\u50b7\u5bb3\uff0c\u800c\u300e\u52a0\u5f37\u8239\u9ad4\u300f\u5347\u7d1a\u5247\u80fd\u63d0\u5347\u8266\u96bb\u8010\u4e45\u5ea6\u905425%\u3002\u6b65\u9a5f\u4e00\uff1a\u89e3\u9396\u300e\u7b49\u96e2\u5b50\u96fb\u6f3f\u70ae\u300f\u3002\u6b65\u9a5f\u4e8c\uff1a\u5b89\u88dd\u300e\u52a0\u5f37\u8239\u9ad4\u300f\u3002\u6b65\u9a5f\u4e09\uff1a\u5c07\u5176\u8207\u300e\u80fd\u91cf\u76fe\u300f\u80fd\u529b\u7d50\u5408\uff0c\u4ee5\u9054\u5230\u6700\u5927\u7684\u751f\u5b58\u80fd\u529b\u3002\u6b64\u8a2d\u5b9a\u5728\u9ad8\u96e3\u5ea6\u4efb\u52d9\u4e2d\u7279\u5225\u6709\u6548\u3002"}, {"question": "\u5982\u4f55\u5728 X \u5879\u9053\u7af6\u901f\u8cfd\u4e2d\u5c07\u6211\u7684\u96fb\u8166\u7aef\u9032\u5ea6\u8f49\u79fb\u5230\u884c\u52d5\u88dd\u7f6e\u4e0a\uff1f", "answer": "\u5728 X \u5879\u9053\u7af6\u901f\u8cfd\u4e2d\uff0c\u5c07\u96fb\u8166\u7aef\u9032\u5ea6\u8f49\u79fb\u5230\u884c\u52d5\u88dd\u7f6e\u4e0a\u975e\u5e38\u7c21\u55ae\u3002\u9996\u5148\uff0c\u78ba\u4fdd\u60a8\u5728\u5169\u500b\u5e73\u53f0\u4e0a\u90fd\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u3002\u700f\u89bd\u60a8\u96fb\u8166\u7aef\u8a2d\u5b9a\u9078\u55ae\u4e2d\u7684\u300e\u96f2\u7aef\u5132\u5b58\u300f\u9078\u9805\uff0c\u4e26\u4e0a\u50b3\u60a8\u7684\u5132\u5b58\u6a94\u3002\u7136\u5f8c\uff0c\u5728\u60a8\u7684\u884c\u52d5\u88dd\u7f6e\u4e0a\uff0c\u5b58\u53d6\u76f8\u540c\u7684\u9078\u55ae\u4e26\u4e0b\u8f09\u5132\u5b58\u6a94\u3002\u6b65\u9a5f\u4e00\uff1a\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u767b\u5165\u60a8\u7684\u5e33\u6236\u3002\u6b65\u9a5f\u4e8c\uff1a\u5f9e\u96fb\u8166\u4e0a\u8f09\u5132\u5b58\u6a94\u3002\u6b65\u9a5f\u4e09\uff1a\u5728\u60a8\u7684\u884c\u52d5\u88dd\u7f6e\u4e0a\u4e0b\u8f09\u5b83\u3002\u6b64\u904e\u7a0b\u78ba\u4fdd\u60a8\u7684\u9032\u5ea6\u5728\u5169\u500b\u5e73\u53f0\u4e0a\u540c\u6b65\u3002"}, {"question": "X \u5879\u9053\u7af6\u901f\u8cfd\u4e2d\u7684\u96b1\u85cf\u589e\u76ca\u9805\u76ee\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5982\u4f55\u627e\u5230\u5b83\u5011\uff1f", "answer": "X \u5879\u9053\u7af6\u901f\u8cfd\u4e2d\u5305\u542b\u8a31\u591a\u96b1\u85cf\u589e\u76ca\u9805\u76ee\uff0c\u4f8b\u5982\u300e\u96b1\u5f62\u6597\u7bf7\u300f\u548c\u300e\u4e09\u9023\u767c\u300f\u3002\u9019\u4e9b\u589e\u76ca\u9805\u76ee\u901a\u5e38\u4f4d\u65bc\u79d8\u5bc6\u5340\u57df\u6216\u88ab\u7834\u58de\u6027\u7246\u58c1\u5f8c\u9762\u3002\u4f8b\u5982\uff0c\u300e\u96b1\u5f62\u6597\u7bf7\u300f\u53ef\u4ee5\u5728\u7b2c 5 \u95dc\u627e\u5230\uff0c\u65b9\u6cd5\u662f\u7834\u58de\u5de6\u4e0a\u89d2\u7684\u7279\u5b9a\u7246\u58c1\u3002\u6b65\u9a5f\u4e00\uff1a\u63a2\u7d22\u504f\u50fb\u5340\u57df\u3002\u6b65\u9a5f\u4e8c\uff1a\u5c0b\u627e\u53ef\u7834\u58de\u7684\u7246\u58c1\u3002\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u300e\u6383\u63cf\u300f\u80fd\u529b\u986f\u793a\u96b1\u85cf\u9805\u76ee\u3002\u9019\u4e9b\u589e\u76ca\u9805\u76ee\u80fd\u986f\u8457\u63d0\u5347\u4f60\u7684\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u5982\u4f55\u5728 X \u5879\u9053\u7af6\u901f\u8cfd\u4e2d\u6700\u4f73\u5316\u8266\u96bb\u88dd\u5099\uff0c\u4ee5\u9032\u884c\u5feb\u901f\u904b\u884c\uff1f", "answer": "\u5728 X \u5879\u9053\u7af6\u901f\u8cfd\u4e2d\u6700\u4f73\u5316\u8266\u96bb\u88dd\u5099\uff0c\u4ee5\u9032\u884c\u5feb\u901f\u904b\u884c\uff0c\u9700\u8981\u5c08\u6ce8\u65bc\u901f\u5ea6\u548c\u6700\u5c0f\u505c\u9813\u6642\u9593\u3002\u88dd\u5099\u300e\u6e26\u8f2a\u5f15\u64ce\u300f\u53ef\u63d0\u5347 20% \u7684\u901f\u5ea6\uff0c\u4ee5\u53ca\u300e\u5feb\u901f\u5c04\u64ca\u300f\u6b66\u5668\u5feb\u901f\u6e05\u9664\u6575\u4eba\u3002\u6b65\u9a5f\u4e00\uff1a\u5b89\u88dd\u300e\u6e26\u8f2a\u5f15\u64ce\u300f\u3002\u6b65\u9a5f\u4e8c\uff1a\u88dd\u5099\u300e\u5feb\u901f\u5c04\u64ca\u300f\u6b66\u5668\u3002\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u300e\u52a0\u901f\u5145\u96fb\u300f\u80fd\u529b\u4f86\u4fdd\u6301\u9ad8\u901f\u3002\u6b64\u8a2d\u5b9a\u80fd\u8b93\u4f60\u4ee5\u8a18\u9304\u6642\u9593\u5b8c\u6210\u95dc\u5361\uff0c\u975e\u5e38\u9069\u5408\u5feb\u901f\u904b\u884c\u3002"}, {"question": "X \u5879\u9053\u7af6\u901f\u8cfd\u4e2d\u7684\u8266\u96bb\u985e\u578b\u6709\u4ec0\u9ebc\u95dc\u9375\u5dee\u7570\uff1f", "answer": "X \u5879\u9053\u7af6\u901f\u8cfd\u4e2d\u7684\u8266\u96bb\u985e\u578b\u4e3b\u8981\u5dee\u7570\u5728\u65bc\u5c6c\u6027\u548c\u80fd\u529b\u3002\u300e\u6230\u9b25\u6a5f\u300f\u985e\u64c5\u9577\u65bc\u9748\u6d3b\u6027\u8207\u901f\u5ea6\uff0c\u300e\u5766\u514b\u300f\u985e\u5247\u63d0\u4f9b\u5353\u8d8a\u7684\u8010\u4e45\u6027\uff0c\u800c\u300e\u8f5f\u70b8\u6a5f\u300f\u985e\u5c08\u6ce8\u65bc\u7bc4\u570d\u50b7\u5bb3\u3002\u4f8b\u5982\uff0c\u300e\u6230\u9b25\u6a5f\u300f\u985e\u7684\u300e\u5feb\u901f\u8f49\u5411\u300f\u80fd\u529b\u5141\u8a31\u5feb\u901f\u6539\u8b8a\u65b9\u5411\uff0c\u800c\u300e\u5766\u514b\u300f\u985e\u7684\u300e\u88dd\u7532\u677f\u300f\u5247\u80fd\u964d\u4f4e 30% \u7684\u50b7\u5bb3\u3002\u4e86\u89e3\u9019\u4e9b\u5dee\u7570\uff0c\u6709\u52a9\u65bc\u9078\u64c7\u9069\u5408\u4f60\u904a\u6232\u98a8\u683c\u7684\u8266\u96bb\u985e\u578b\u3002"}, {"question": "\u5982\u4f55\u89e3\u9396 X \u5879\u9053\u7af6\u901f\u8cfd\u7684\u79d8\u5bc6\u7d50\u5c40\uff1f", "answer": "\u89e3\u9396 X \u5879\u9053\u7af6\u901f\u8cfd\u7684\u79d8\u5bc6\u7d50\u5c40\u9700\u8981\u4ee5\u300eS\u300f\u7b49\u7d1a\u5b8c\u6210\u6240\u6709\u95dc\u5361\uff0c\u4e26\u627e\u5230\u6240\u6709\u96b1\u85cf\u6536\u96c6\u54c1\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 10 \u95dc\uff0c\u4f60\u5fc5\u9808\u5728\u4e0d\u53d7\u5230\u4efb\u4f55\u50b7\u5bb3\u7684\u60c5\u6cc1\u4e0b\u64ca\u6557\u9996\u9818\u624d\u80fd\u9054\u5230\u300eS\u300f\u7b49\u7d1a\u3002\u6b65\u9a5f\u4e00\uff1a\u5728\u6240\u6709\u95dc\u5361\u4e2d\u9054\u6210\u300eS\u300f\u7b49\u7d1a\u3002\u6b65\u9a5f\u4e8c\uff1a\u6536\u96c6\u6240\u6709\u96b1\u85cf\u7269\u54c1\u3002\u6b65\u9a5f\u4e09\uff1a\u5728\u64ca\u6557\u6700\u5f8c\u9996\u9818\u5f8c\uff0c\u6ce8\u610f\u7279\u5225\u7684\u52d5\u756b\u3002\u6b64\u7d50\u5c40\u63d0\u4f9b\u4e86\u984d\u5916\u7684\u80cc\u666f\u6545\u4e8b\u548c\u6210\u5c31\u611f\u3002"}, {"question": "\u5728 X \u5879\u9053\u7af6\u901f\u8cfd\u4e2d\uff0c\u5728\u4f4e\u7aef\u88dd\u7f6e\u4e0a\u7372\u5f97\u9806\u66a2\u904a\u6232\u9ad4\u9a57\u7684\u6700\u4f73\u8a2d\u5b9a\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728 X \u5879\u9053\u7af6\u901f\u8cfd\u4e2d\uff0c\u5728\u4f4e\u7aef\u88dd\u7f6e\u4e0a\u7372\u5f97\u9806\u66a2\u904a\u6232\u9ad4\u9a57\uff0c\u8acb\u8abf\u6574\u8a2d\u5b9a\uff0c\u4ee5\u6e1b\u5c11\u5716\u5f62\u8ca0\u8f09\u3002\u5c07\u300e\u6750\u8cea\u54c1\u8cea\u300f\u964d\u4f4e\u5230\u300e\u4f4e\u300f\uff0c\u4e26\u505c\u7528\u300e\u9670\u5f71\u300f\u548c\u300e\u5f8c\u8655\u7406\u300f\u6548\u679c\u3002\u6b65\u9a5f\u4e00\uff1a\u6253\u958b\u8a2d\u5b9a\u9078\u55ae\u3002\u6b65\u9a5f\u4e8c\uff1a\u5c07\u300e\u6750\u8cea\u54c1\u8cea\u300f\u8a2d\u5b9a\u70ba\u300e\u4f4e\u300f\u3002\u6b65\u9a5f\u4e09\uff1a\u505c\u7528\u300e\u9670\u5f71\u300f\u548c\u300e\u5f8c\u8655\u7406\u300f\u6548\u679c\u3002\u9019\u4e9b\u8b8a\u66f4\u5c07\u6539\u5584\u6548\u80fd\uff0c\u800c\u4e0d\u6703\u986f\u8457\u5f71\u97ff\u8996\u89ba\u9ad4\u9a57\uff0c\u78ba\u4fdd\u5728\u8f03\u5f31\u7684\u88dd\u7f6e\u4e0a\u4e5f\u80fd\u9806\u66a2\u904a\u6232\u3002"}]
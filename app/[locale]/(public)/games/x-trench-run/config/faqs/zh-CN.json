[{"question": "\u5982\u4f55\u4f5c\u4e3a\u65b0\u624b\u5728X\u6df1\u6e0a\u7a81\u88ad\u4e2d\u63d0\u5347\u8230\u8239\u673a\u52a8\u6027\uff1f", "answer": "\u4e3a\u4e86\u63d0\u5347\u4f60\u5728X\u6df1\u6e0a\u7a81\u88ad\u4e2d\u7684\u8230\u8239\u673a\u52a8\u6027\uff0c\u8bf7\u4e13\u6ce8\u4e8e\u5728\u8230\u8239\u5b9a\u5236\u83dc\u5355\u4e2d\u63d0\u5347\"\u673a\u52a8\u6027\"\u5c5e\u6027\u3002\u4f8b\u5982\uff0c\"\u8fc5\u6377\u7ffc\"\u8230\u578b\u53ef\u4ee5\u63d0\u9ad815%\u7684\u673a\u52a8\u6027\uff0c\u4f7f\u4f60\u5728\u72ed\u7a84\u7a7a\u95f4\u4e2d\u66f4\u5bb9\u6613\u64cd\u63a7\u3002\u6b64\u5916\uff0c\u7ec3\u4e60\u4f7f\u7528\"\u5feb\u901f\u8f6c\u5411\"\u6280\u80fd\uff0c\u5b83\u53ef\u4ee5\u5b9e\u73b0\u5feb\u901f\u65b9\u5411\u6539\u53d8\u3002\u6b65\u9aa41\uff1a\u8bbf\u95ee\u5b9a\u5236\u83dc\u5355\uff1b\u6b65\u9aa42\uff1a\u5206\u914d\u70b9\u6570\u5230\"\u673a\u52a8\u6027\"\uff1b\u6b65\u9aa43\uff1a\u88c5\u5907\"\u8fc5\u6377\u7ffc\"\u8230\u578b\u3002\u8fd9\u79cd\u914d\u7f6e\u975e\u5e38\u9002\u5408\u8eb2\u907f\u969c\u788d\u7269\u548c\u654c\u65b9\u706b\u529b\u3002"}, {"question": "\u5728X\u6df1\u6e0a\u7a81\u88ad\u4e2d\u51fb\u8d25\u6700\u7ec8BOSS\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728X\u6df1\u6e0a\u7a81\u88ad\u4e2d\u51fb\u8d25\u6700\u7ec8BOSS\u9700\u8981\u5f3a\u5927\u7684\u706b\u529b\u548c\u6218\u7565\u90e8\u7f72\u76f8\u7ed3\u5408\u3002\u4f7f\u7528\"\u5149\u5b50\u70ae\"\u8fdb\u884c\u9ad8\u4f24\u5bb3\u8f93\u51fa\uff0c\u5e76\u4fdd\u6301\u4e2d\u8ddd\u79bb\uff0c\u4ee5\u907f\u514dBOSS\u7684\u8fd1\u8ddd\u79bb\u653b\u51fb\u3002\u6b65\u9aa41\uff1a\u88c5\u5907\"\u5149\u5b50\u70ae\"\uff1b\u6b65\u9aa42\uff1a\u4fdd\u6301\u4e2d\u8ddd\u79bb\uff1b\u6b65\u9aa43\uff1a\u96c6\u4e2d\u653b\u51fbBOSS\u7684\u5f31\u70b9\uff0c\u4f8b\u5982\u53d1\u5149\u7684\u6838\u5fc3\u3002\u6b64\u5916\uff0c\u4f7f\u7528\"\u62a4\u76fe\u589e\u5f3a\"\u6280\u80fd\u6765\u5438\u6536\u654c\u4eba\u653b\u51fb\u4f24\u5bb3\u3002\u8bb8\u591a\u6e38\u620f\u65f6\u957f\u8d85\u8fc7100\u5c0f\u65f6\u7684\u73a9\u5bb6\u90fd\u8bc1\u660e\u4e86\u8fd9\u79cd\u65b9\u6cd5\u7684\u6709\u6548\u6027\u3002"}, {"question": "X\u6df1\u6e0a\u7a81\u88ad\u4e2d\u7684\u5f97\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u5927\u5316\u5f97\u5206\uff1f", "answer": "X\u6df1\u6e0a\u7a81\u88ad\u7684\u5f97\u5206\u7cfb\u7edf\u57fa\u4e8e\u4e09\u4e2a\u4e3b\u8981\u56e0\u7d20\uff1a\u51fb\u6740\u654c\u65b9\u5355\u4f4d\uff0c\u89c4\u907f\u969c\u788d\uff0c\u4ee5\u53ca\u65f6\u95f4\u5956\u52b1\u3002\u4f8b\u5982\uff0c\u6467\u6bc1\"\u8bfa\u74e6\u6218\u6597\u673a\"\u5c06\u83b7\u5f97500\u5206\uff0c\u800c\u89c4\u907f\"\u6fc0\u5149\u95e8\"\u5219\u5c06\u83b7\u5f97200\u5206\u3002\u4e3a\u4e86\u6700\u5927\u5316\u5f97\u5206\uff0c\u8bf7\u4e13\u6ce8\u4e8e\u5feb\u901f\u7cbe\u786e\u7684\u51fb\u6740\u76ee\u6807\uff0c\u5e76\u4f7f\u7528\"\u52a0\u901f\"\u6280\u80fd\u4ee5\u66f4\u5feb\u5730\u5b8c\u6210\u5173\u5361\u3002\u6b65\u9aa41\uff1a\u4f18\u5148\u653b\u51fb\u9ad8\u4ef7\u503c\u76ee\u6807\uff1b\u6b65\u9aa42\uff1a\u4f7f\u7528\"\u52a0\u901f\"\u6280\u80fd\u7f29\u77ed\u5b8c\u6210\u65f6\u95f4\uff1b\u6b65\u9aa43\uff1a\u5b8c\u7f8e\u89c4\u907f\u969c\u788d\u7269\u4ee5\u83b7\u5f97\u989d\u5916\u5206\u6570\u3002\u8fd9\u79cd\u7b56\u7565\u5c06\u5e2e\u52a9\u4f60\u767b\u4e0a\u6392\u884c\u699c\u3002"}, {"question": "\u5bf9\u4e8eX\u6df1\u6e0a\u7a81\u88ad\u4e2d\u7684\u9ad8\u7ea7\u73a9\u5bb6\u6765\u8bf4\uff0c\u54ea\u4e9b\u8230\u8239\u5347\u7ea7\u6700\u6709\u76ca\uff1f", "answer": "X\u6df1\u6e0a\u7a81\u88ad\u4e2d\u7684\u9ad8\u7ea7\u73a9\u5bb6\u5e94\u8be5\u4f18\u5148\u8003\u8651\u90a3\u4e9b\u63d0\u5347\u653b\u51fb\u548c\u9632\u5fa1\u80fd\u529b\u7684\u5347\u7ea7\u3002\"\u7b49\u79bb\u5b50\u70ae\"\u56e0\u5176\u8303\u56f4\u4f24\u5bb3\u800c\u5f3a\u70c8\u63a8\u8350\uff0c\u800c\"\u5f3a\u5316\u8239\u4f53\"\u5347\u7ea7\u5219\u5c06\u4f60\u7684\u8230\u8239\u8010\u4e45\u5ea6\u63d0\u9ad825%\u3002\u6b65\u9aa41\uff1a\u89e3\u9501\"\u7b49\u79bb\u5b50\u70ae\"\uff1b\u6b65\u9aa42\uff1a\u5b89\u88c5\"\u5f3a\u5316\u8239\u4f53\"\uff1b\u6b65\u9aa43\uff1a\u5c06\u5176\u4e0e\"\u80fd\u91cf\u62a4\u76fe\"\u6280\u80fd\u7ed3\u5408\u4f7f\u7528\uff0c\u4ee5\u8fbe\u5230\u6700\u5927\u7684\u751f\u5b58\u80fd\u529b\u3002\u8fd9\u79cd\u914d\u7f6e\u5728\u9ad8\u96be\u5ea6\u4efb\u52a1\u4e2d\u5c24\u5176\u6709\u6548\u3002"}, {"question": "\u5982\u4f55\u5728X\u6df1\u6e0a\u7a81\u88ad\u4e2d\u5c06PC\u7aef\u7684\u8fdb\u5ea6\u8f6c\u79fb\u5230\u79fb\u52a8\u7aef\uff1f", "answer": "\u5728X\u6df1\u6e0a\u7a81\u88ad\u4e2d\u5c06PC\u7aef\u8fdb\u5ea6\u8f6c\u79fb\u5230\u79fb\u52a8\u7aef\u975e\u5e38\u7b80\u5355\u3002\u9996\u5148\uff0c\u786e\u4fdd\u4f60\u5728\u4e24\u4e2a\u5e73\u53f0\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u8d26\u6237\u3002\u5728PC\u7aef\u7684\u8bbe\u7f6e\u83dc\u5355\u4e2d\u5bfc\u822a\u5230\"\u4e91\u4fdd\u5b58\"\u9009\u9879\uff0c\u5e76\u5c06\u4f60\u7684\u5b58\u6863\u6587\u4ef6\u4e0a\u4f20\u3002\u7136\u540e\uff0c\u5728\u4f60\u7684\u79fb\u52a8\u8bbe\u5907\u4e0a\u8bbf\u95ee\u76f8\u540c\u7684\u83dc\u5355\u5e76\u4e0b\u8f7d\u5b58\u6863\u6587\u4ef6\u3002\u6b65\u9aa41\uff1a\u5728\u4e24\u4e2a\u8bbe\u5907\u4e0a\u767b\u5f55\u4f60\u7684\u5e10\u6237\uff1b\u6b65\u9aa42\uff1a\u4ecePC\u7aef\u4e0a\u4f20\u5b58\u6863\u6587\u4ef6\uff1b\u6b65\u9aa43\uff1a\u5728\u4f60\u7684\u79fb\u52a8\u8bbe\u5907\u4e0a\u4e0b\u8f7d\u5b83\u3002\u8fd9\u4e2a\u8fc7\u7a0b\u786e\u4fdd\u4f60\u7684\u8fdb\u5ea6\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u540c\u6b65\u3002"}, {"question": "X\u6df1\u6e0a\u7a81\u88ad\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u9053\u5177\uff0c\u4ee5\u53ca\u5982\u4f55\u627e\u5230\u5b83\u4eec\uff1f", "answer": "X\u6df1\u6e0a\u7a81\u88ad\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u9053\u5177\uff0c\u4f8b\u5982\"\u9690\u5f62\u6597\u7bf7\"\u548c\"\u4e09\u8fde\u53d1\"\u3002\u8fd9\u4e9b\u9053\u5177\u901a\u5e38\u4f4d\u4e8e\u79d8\u5bc6\u533a\u57df\u6216\u53ef\u7834\u574f\u5899\u58c1\u540e\u9762\u3002\u4f8b\u5982\uff0c\"\u9690\u5f62\u6597\u7bf7\"\u53ef\u4ee5\u5728\u7b2c5\u5173\u901a\u8fc7\u6467\u6bc1\u5de6\u4e0a\u89d2\u7684\u4e00\u4e2a\u7279\u5b9a\u5899\u58c1\u627e\u5230\u3002\u6b65\u9aa41\uff1a\u63a2\u7d22\u504f\u50fb\u533a\u57df\uff1b\u6b65\u9aa42\uff1a\u5bfb\u627e\u53ef\u7834\u574f\u7684\u5899\u58c1\uff1b\u6b65\u9aa43\uff1a\u4f7f\u7528\"\u626b\u63cf\u5668\"\u6280\u80fd\u6765\u53d1\u73b0\u9690\u85cf\u7269\u54c1\u3002\u8fd9\u4e9b\u9053\u5177\u53ef\u4ee5\u663e\u8457\u63d0\u5347\u4f60\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u5982\u4f55\u5728X\u6df1\u6e0a\u7a81\u88ad\u4e2d\u4f18\u5316\u8230\u8239\u914d\u7f6e\u4ee5\u8fdb\u884c\u901f\u5ea6\u8dd1\uff1f", "answer": "\u5728X\u6df1\u6e0a\u7a81\u88ad\u4e2d\u4f18\u5316\u8230\u8239\u914d\u7f6e\u4ee5\u8fdb\u884c\u901f\u5ea6\u8dd1\uff0c\u9700\u8981\u4e13\u6ce8\u4e8e\u901f\u5ea6\u548c\u6700\u5c0f\u5316\u505c\u987f\u65f6\u95f4\u3002\u88c5\u5907\"\u6da1\u8f6e\u5f15\u64ce\"\u4ee5\u83b7\u5f9720%\u7684\u901f\u5ea6\u63d0\u5347\uff0c\u4ee5\u53ca\"\u5feb\u901f\u5c04\u51fb\"\u6b66\u5668\u4ee5\u5feb\u901f\u6d88\u706d\u654c\u4eba\u3002\u6b65\u9aa41\uff1a\u5b89\u88c5\"\u6da1\u8f6e\u5f15\u64ce\"\uff1b\u6b65\u9aa42\uff1a\u88c5\u5907\"\u5feb\u901f\u5c04\u51fb\"\u6b66\u5668\uff1b\u6b65\u9aa43\uff1a\u4f7f\u7528\"\u52a0\u901f\u5145\u7535\"\u6280\u80fd\u6765\u4fdd\u6301\u9ad8\u901f\u3002\u8fd9\u79cd\u914d\u7f6e\u4f7f\u4f60\u80fd\u5728\u6700\u77ed\u65f6\u95f4\u5185\u5b8c\u6210\u5173\u5361\uff0c\u975e\u5e38\u9002\u5408\u901f\u5ea6\u8dd1\u3002"}, {"question": "X\u6df1\u6e0a\u7a81\u88ad\u4e2d\u4e0d\u540c\u8230\u8239\u7c7b\u578b\u7684\u5173\u952e\u533a\u522b\u662f\u4ec0\u4e48\uff1f", "answer": "X\u6df1\u6e0a\u7a81\u88ad\u4e2d\u4e0d\u540c\u8230\u8239\u7c7b\u578b\u7684\u5173\u952e\u533a\u522b\u4e3b\u8981\u5728\u4e8e\u5c5e\u6027\u548c\u6280\u80fd\u3002\"\u6218\u6597\u673a\"\u7c7b\u578b\u64c5\u957f\u673a\u52a8\u6027\u548c\u901f\u5ea6\uff0c\"\u5766\u514b\"\u7c7b\u578b\u62e5\u6709\u66f4\u9ad8\u7684\u8010\u4e45\u5ea6\uff0c\"\u8f70\u70b8\u673a\"\u7c7b\u578b\u5219\u64c5\u957f\u8303\u56f4\u4f24\u5bb3\u3002\u4f8b\u5982\uff0c\"\u6218\u6597\u673a\"\u7c7b\u578b\u7684\"\u5feb\u901f\u8f6c\u5411\"\u6280\u80fd\u80fd\u591f\u5feb\u901f\u6539\u53d8\u65b9\u5411\uff0c\u800c\"\u5766\u514b\"\u7c7b\u578b\u7684\"\u88c5\u7532\u677f\"\u5219\u53ef\u4ee5\u964d\u4f4e30%\u7684\u4f24\u5bb3\u3002\u4e86\u89e3\u8fd9\u4e9b\u5dee\u5f02\u6709\u52a9\u4e8e\u6839\u636e\u4f60\u7684\u6e38\u620f\u98ce\u683c\u9009\u62e9\u5408\u9002\u7684\u8230\u8239\u7c7b\u578b\u3002"}, {"question": "\u5982\u4f55\u5728X\u6df1\u6e0a\u7a81\u88ad\u4e2d\u89e3\u9501\u79d8\u5bc6\u7ed3\u5c40\uff1f", "answer": "\u5728X\u6df1\u6e0a\u7a81\u88ad\u4e2d\u89e3\u9501\u79d8\u5bc6\u7ed3\u5c40\u9700\u8981\u5728\u6240\u6709\u5173\u5361\u4e2d\u83b7\u5f97\"S\"\u7ea7\u8bc4\u4ef7\uff0c\u5e76\u627e\u5230\u6240\u6709\u9690\u85cf\u7684\u6536\u85cf\u54c1\u3002\u4f8b\u5982\uff0c\u5728\u7b2c10\u5173\uff0c\u4f60\u5fc5\u987b\u5728\u4e0d\u53d7\u5230\u4efb\u4f55\u4f24\u5bb3\u7684\u60c5\u51b5\u4e0b\u51fb\u8d25BOSS\u624d\u80fd\u83b7\u5f97\"S\"\u7ea7\u8bc4\u4ef7\u3002\u6b65\u9aa41\uff1a\u5728\u6240\u6709\u5173\u5361\u4e2d\u83b7\u5f97\"S\"\u7ea7\u8bc4\u4ef7\uff1b\u6b65\u9aa42\uff1a\u6536\u96c6\u6240\u6709\u9690\u85cf\u7269\u54c1\uff1b\u6b65\u9aa43\uff1a\u5728\u51fb\u8d25\u6700\u7ec8BOSS\u540e\uff0c\u7559\u610f\u7279\u522b\u7684\u8fc7\u573a\u52a8\u753b\u3002\u8fd9\u4e2a\u7ed3\u5c40\u63d0\u4f9b\u4e86\u989d\u5916\u7684\u80cc\u666f\u6545\u4e8b\u548c\u6210\u5c31\u611f\u3002"}, {"question": "\u5728X\u6df1\u6e0a\u7a81\u88ad\u4e2d\uff0c\u5728\u4f4e\u7aef\u8bbe\u5907\u4e0a\u5982\u4f55\u4f18\u5316\u8bbe\u7f6e\u4ee5\u83b7\u5f97\u6d41\u7545\u7684\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u5728X\u6df1\u6e0a\u7a81\u88ad\u4e2d\uff0c\u5728\u4f4e\u7aef\u8bbe\u5907\u4e0a\u83b7\u5f97\u6d41\u7545\u7684\u6e38\u620f\u4f53\u9a8c\uff0c\u9700\u8981\u8c03\u6574\u8bbe\u7f6e\u4ee5\u51cf\u8f7b\u56fe\u5f62\u8d1f\u62c5\u3002\u5c06\"\u7eb9\u7406\u8d28\u91cf\"\u8c03\u81f3\"\u4f4e\"\uff0c\u5e76\u7981\u7528\"\u9634\u5f71\"\u548c\"\u540e\u671f\u5904\u7406\"\u3002\u6b65\u9aa41\uff1a\u6253\u5f00\u8bbe\u7f6e\u83dc\u5355\uff1b\u6b65\u9aa42\uff1a\u5c06\"\u7eb9\u7406\u8d28\u91cf\"\u8bbe\u4e3a\"\u4f4e\"\uff1b\u6b65\u9aa43\uff1a\u7981\u7528\"\u9634\u5f71\"\u548c\"\u540e\u671f\u5904\u7406\"\u3002\u8fd9\u4e9b\u66f4\u6539\u5c06\u63d0\u9ad8\u6027\u80fd\uff0c\u800c\u4e0d\u4f1a\u5bf9\u89c6\u89c9\u4f53\u9a8c\u4ea7\u751f\u660e\u663e\u5f71\u54cd\uff0c\u786e\u4fdd\u5728\u6027\u80fd\u8f83\u4f4e\u7684\u8bbe\u5907\u4e0a\u83b7\u5f97\u6d41\u7545\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}]
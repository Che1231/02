[{"question": "\ubd88\uac00\ub2a5\ud55c \ud034\uc988\uc5d0\uc11c \ubc18\uc751 \uc2dc\uac04\uc744 \uc5b4\ub5bb\uac8c \uac1c\uc120\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ubd88\uac00\ub2a5\ud55c \ud034\uc988\uc5d0\uc11c \ubc18\uc751 \uc2dc\uac04\uc744 \uac1c\uc120\ud558\ub824\uba74 \uc5f0\uc2b5\uacfc \uc9c8\ubb38 \ud328\ud134\uc5d0 \ub300\ud55c \uc219\ub2ec\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uba3c\uc800 \uac8c\uc784\uc744 \uc815\uae30\uc801\uc73c\ub85c \ud50c\ub808\uc774\ud558\uc5ec \uc9c8\ubb38 \uc720\ud615\uc5d0 \uc775\uc219\ud574\uc9c0\uc2ed\uc2dc\uc624. \uc18d\uc784\uc218 \uc9c8\ubb38\uc774\ub098 \uc2dc\uac01\uc801 \ub2e8\uc11c\uc640 \uac19\uc774 \ud328\ud134\uc744 \ube60\ub974\uac8c \uc778\uc2dd\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ud2b9\uc815 \ub2e8\uc5b4\ub97c \ud074\ub9ad\ud574\uc57c \ud558\ub294 \uc9c8\ubb38\uc5d0\uc11c \ud14d\uc2a4\ud2b8\ub97c \ube60\ub974\uac8c \uc2a4\uce94\ud558\ub294 \uc5f0\uc2b5\uc744 \ud558\uc2ed\uc2dc\uc624. \ub610\ud55c \uc0b0\ub9cc\ud568\uc744 \ucd5c\uc18c\ud654\ud558\uace0 \uc7a5\uce58\uac00 \ubc18\uc751\uc801\uc774\ub3c4\ub85d \ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 1: \uadfc\uc721 \uae30\uc5b5\ub825\uc744 \uad6c\ucd95\ud558\uae30 \uc704\ud574 \ub9e4\uc77c \ud50c\ub808\uc774\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \uacfc\uac70 \uc9c8\ubb38\uc744 \ubd84\uc11d\ud558\uc5ec \uc18d\uc784\uc218\ub97c \uc608\uce21\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \ube60\ub978 \uc751\ub2f5\uc744 \uc704\ud574 \ud658\uacbd\uc744 \ucd5c\uc801\ud654\ud558\uc2ed\uc2dc\uc624. \uc774\ub7ec\ud55c \uc811\uadfc \ubc29\uc2dd\uc740 \ub354 \ube60\ub974\uace0 \uc815\ud655\ud558\uac8c \ubc18\uc751\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4."}, {"question": "\ubd88\uac00\ub2a5\ud55c \ud034\uc988\uc5d0\uc11c \uc18d\uc784\uc218 \uc9c8\ubb38\uc744 \ud574\uacb0\ud558\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubd88\uac00\ub2a5\ud55c \ud034\uc988\uc758 \uc18d\uc784\uc218 \uc9c8\ubb38\uc740 \uc885\uc885 \uc0c1\uc790 \ubc16\uc5d0\uc11c \uc0dd\uac01\ud558\ub294 \uac83\uc744 \uc694\uad6c\ud569\ub2c8\ub2e4. \ub2e8\uacc4\ubcc4 \uc804\ub7b5\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc9c8\ubb38\uc744 \uc8fc\uc758 \uae4a\uac8c \uc77d\uace0 \ub2e8\uc5b4\uc640 \uc2dc\uac01\uc801 \uc138\ubd80 \uc0ac\ud56d\uc5d0 \uc720\uc758\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \ub18d\ub2f4\uc774\ub098 \uc774\uc911 \uc758\ubbf8\uc640 \uac19\uc774 \ubbf8\ubb18\ud55c \ud78c\ud2b8\ub098 \uc5b8\uc5b4 \uc720\ud76c\ub97c \ucc3e\uc73c\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \"\ud504\ub791\uc2a4\uc758 \uc218\ub3c4\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?\"\ub77c\ub294 \uc9c8\ubb38\uc774 \uc788\uc9c0\ub9cc \ub2f5\uc740 \"\ud30c\ub9ac\"\uac00 \uc544\ub2cc \uc5b8\uc5b4 \uc720\ud76c\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 3: \ub9c9\ud790 \uacbd\uc6b0 \uc9c8\ubb38 \ud14d\uc2a4\ud2b8\ub098 \ubc30\uacbd\uacfc \uac19\uc740 \uc608\uc0c1\uce58 \ubabb\ud55c \uc694\uc18c\ub97c \ud074\ub9ad\ud574 \ubcf4\uc2ed\uc2dc\uc624. \uc804\ud1b5\uc801\uc778 \ub2f5\ubcc0\uc774 \uc801\uc6a9\ub418\uc9c0 \uc54a\uc744 \uc218 \uc788\uc74c\uc744 \ud56d\uc0c1 \uae30\uc5b5\ud558\uc2ed\uc2dc\uc624. \uc774 \ubc29\ubc95\uc744 \ud1b5\ud574 \uac8c\uc784\uc758 \ub3c5\ud2b9\ud55c \uacfc\uc81c\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uadf9\ubcf5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ubd88\uac00\ub2a5\ud55c \ud034\uc988\ub97c \uc9c0\uc6d0\ud558\ub294 \ud50c\ub7ab\ud3fc\uc740 \ubb34\uc5c7\uc774\uba70, \ud50c\ub7ab\ud3fc \uac04 \ud638\ud658\uc131\uc774 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ubd88\uac00\ub2a5\ud55c \ud034\uc988\ub294 \uc8fc\ub85c \uc6f9 \ube0c\ub77c\uc6b0\uc800\uc640 \ubaa8\ubc14\uc77c \uc7a5\uce58\uc5d0\uc11c \uc774\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784\uc740 \ub450 \ud50c\ub7ab\ud3fc \ubaa8\ub450\uc5d0\uc11c \uc774\uc6a9 \uac00\ub2a5\ud558\uc9c0\ub9cc \ud50c\ub7ab\ud3fc \uac04 \ud638\ud658\uc131\uc774\ub098 \ub370\uc774\ud130 \ub9c8\uc774\uadf8\ub808\uc774\uc158 \uae30\ub2a5\uc740 \uc5c6\uc2b5\ub2c8\ub2e4. \uc989, \ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc9c4\ud589\ud55c \uc9c4\ucc99 \uc0c1\ud669\uc744 \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uc62e\uae38 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ube0c\ub77c\uc6b0\uc800\uc5d0\uc11c \uac8c\uc784\uc744 \ud50c\ub808\uc774\ud558\uace0 \ubaa8\ubc14\uc77c \uc571\uc73c\ub85c \uc804\ud658\ud558\uba74 \uac8c\uc784\uc744 \ucc98\uc74c\ubd80\ud130 \ub2e4\uc2dc \uc2dc\uc791\ud574\uc57c \ud569\ub2c8\ub2e4. \uc9c4\ucc99 \uc0c1\ud669\uc744 \uc783\ub294 \uac83\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uac8c\uc784 \ud658\uacbd\uc5d0 \uc801\ud569\ud55c \ud50c\ub7ab\ud3fc\uc744 \uc120\ud0dd\ud558\uc2ed\uc2dc\uc624. \uc774\ub7ec\ud55c \uc81c\ud55c \uc0ac\ud56d\uc740 \uc7a5\uce58\ub97c \uc790\uc8fc \ubc14\uafb8\ub294 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uace0\ub824\ud574\uc57c \ud560 \uc0ac\ud56d\uc785\ub2c8\ub2e4."}, {"question": "\ubd88\uac00\ub2a5\ud55c \ud034\uc988\uc758 \uc77c\ubd80 \uc9c8\ubb38\uc774 \ub2f5\ud558\uae30 \uc5b4\ub824\uc6b4 \uac83\ucc98\ub7fc \ubcf4\uc774\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubd88\uac00\ub2a5\ud55c \ud034\uc988\uc758 \uc77c\ubd80 \uc9c8\ubb38\uc740 \uc758\ub3c4\uc801\uc73c\ub85c \uc624\ub3c4\ud558\uac70\ub098 \ube44\uc804\ud1b5\uc801\uc778 \ubc29\uc2dd\uc73c\ub85c \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc9c8\ubb38\uc740 \uc885\uc885 \uc5b8\uc5b4 \uc720\ud76c, \uc2dc\uac01\uc801 \uc18d\uc784\uc218 \ub610\ub294 \uc608\uae30\uce58 \uc54a\uc740 \ub17c\ub9ac\uc5d0 \uc758\uc874\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ub179\uc0c9 \ubc84\ud2bc\uc744 \ud074\ub9ad\ud558\uc2ed\uc2dc\uc624\"\ub77c\ub294 \uc9c8\ubb38\uc774 \uc788\uc9c0\ub9cc \uc2e4\uc81c \ubc84\ud2bc\uc740 \ube68\uac04\uc0c9\uc774\uc5b4\uc11c \ub2e4\ub978 \ubc29\uc2dd\uc73c\ub85c \uc0dd\uac01\ud574\uc57c \ud569\ub2c8\ub2e4. \uac8c\uc784 \uc81c\uc791\uc790\ub294 \ud50c\ub808\uc774\uc5b4\uc758 \uac00\uc815\uc744 \uc2dc\ud5d8\ud558\uace0 \ucc3d\uc758\uc801\uc778 \ubb38\uc81c \ud574\uacb0\uc744 \uc7a5\ub824\ud558\uae30 \uc704\ud574 \uc774\ub7ec\ud55c \uc9c8\ubb38\uc744 \ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ub514\uc790\uc778 \ucca0\ud559\uc744 \uc774\ud574\ud558\uba74 \uc774\ub7ec\ud55c \uc9c8\ubb38\uc5d0 \uc5f4\ub9b0 \ub9c8\uc74c\uacfc \uc801\uc751\uc131\uc744 \uac00\uc9c0\uace0 \uc811\uadfc\ud558\uc5ec \uc88c\uc808\uac10\uc744 \uc904\uc774\uace0 \uac8c\uc784\uc744 \ub354 \uc990\uac81\uac8c \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ubd88\uac00\ub2a5\ud55c \ud034\uc988\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uc810\uc218\ub97c \uadf9\ub300\ud654\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\ubd88\uac00\ub2a5\ud55c \ud034\uc988\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc815\ub2f5\uacfc \uac74\ub108\ub6f0\uae30\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uac01 \uc815\ub2f5\uc740 \uc810\uc218\ub97c \ubd80\uc5ec\ud558\uba70, \uac74\ub108\ub6f0\uae30\ub294 \uc810\uc218\ub97c \uae4e\uc2b5\ub2c8\ub2e4. \uc810\uc218\ub97c \uadf9\ub300\ud654\ud558\ub824\uba74 \uc18d\ub3c4\ubcf4\ub2e4\ub294 \uc815\ud655\uc131\uc5d0 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc9c8\ubb38\uc5d0 \ub300\ud574 \ud655\uc2e0\uc774 \uc5c6\ub2e4\uba74 \uc810\uc218\ub97c \uc783\uc9c0 \uc54a\uae30 \uc704\ud574 \uac74\ub108\ub6f0\uae30\ub97c \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \ub610\ud55c, \uc9c8\ubb38 \ud328\ud134\uc744 \uc778\uc2dd\ud558\uc5ec \uc2e4\uc218\ub97c \uc904\uc774\uc2ed\uc2dc\uc624. \ub2e8\uacc4 1: \uc18d\ub3c4\ubcf4\ub2e4 \uc815\ud655\uc131\uc744 \uc6b0\uc120\uc2dc\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \uac74\ub108\ub6f0\uae30\ub97c \ud604\uba85\ud558\uac8c \uc0ac\uc6a9\ud558\uc5ec \uc810\uc218 \uac10\uc18c\ub97c \ud53c\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \uacfc\uac70 \uc9c8\ubb38\uc744 \ubd84\uc11d\ud558\uc5ec \ubbf8\ub798 \uc131\ub2a5\uc744 \uac1c\uc120\ud558\uc2ed\uc2dc\uc624. \uc774\ub7ec\ud55c \uc811\uadfc \ubc29\uc2dd\uc740 \uc9c0\uc18d\uc801\uc73c\ub85c \ub354 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\ubd88\uac00\ub2a5\ud55c \ud034\uc988\uc5d0 \ub300\ubd80\ubd84\uc758 \ud50c\ub808\uc774\uc5b4\uac00 \uac04\uacfc\ud558\ub294 \uc228\uaca8\uc9c4 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubd88\uac00\ub2a5\ud55c \ud034\uc988\uc5d0\ub294 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc601\ud5a5\uc744 \uc904 \uc218 \uc788\ub294 \uba87 \uac00\uc9c0 \uc228\uaca8\uc9c4 \uba54\ucee4\ub2c8\uc998\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc0ac\uc6b4\ub4dc \ud050\uc758 \uc0ac\uc6a9\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ud2b9\uc815 \uc9c8\ubb38\uc5d0\ub294 \uc62c\ubc14\ub978 \ub2f5\uc744 \uc548\ub0b4\ud558\ub294 \uc624\ub514\uc624 \ud78c\ud2b8\uac00 \uc788\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uba54\ucee4\ub2c8\uc998\uc740 \ud074\ub9ad \ud0c0\uc774\ubc0d\uc785\ub2c8\ub2e4. \uc77c\ubd80 \uc9c8\ubb38\uc740 \ud2b9\uc815 \uc18c\ub9ac\uac00 \ub4e4\ub9b4 \ub54c \ud074\ub9ad\ud558\ub294 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc9c8\ubb38\uc5d0\uc11c \ud2b9\uc815 \uc18c\ub9ac\uac00 \ub4e4\ub9b4 \ub54c \ud074\ub9ad\ud558\ub77c\uace0 \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ubbf8\ubb18\ud55c \uc138\ubd80 \uc0ac\ud56d\uc5d0 \uc720\uc758\ud558\uba74 \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc624\ub514\uc624 \ud050\ub97c \uc8fc\uc758 \uae4a\uac8c \ub4e4\uc5b4\ubcf4\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \ud074\ub9ad \ud0c0\uc774\ubc0d\uc744 \uc815\ud655\ud558\uac8c \uc5f0\uc2b5\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \uc2dc\uac01 \ubc0f \uccad\uac01 \ud328\ud134\uc744 \uc790\uc138\ud788 \uad00\ucc30\ud558\uc2ed\uc2dc\uc624. \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \uc219\ub2ec\ud558\uba74 \uc804\uccb4 \uc131\ub2a5\uc774 \ud5a5\uc0c1\ub429\ub2c8\ub2e4."}, {"question": "\ubd88\uac00\ub2a5\ud55c \ud034\uc988\uc758 \uc554\ud638\ud654\ub41c \uba54\uc2dc\uc9c0\ub97c \uc5b4\ub5bb\uac8c \ud574\ub3c5\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ubd88\uac00\ub2a5\ud55c \ud034\uc988\uc758 \uc554\ud638\ud654\ub41c \uba54\uc2dc\uc9c0\ub294 \uc885\uc885 \ud574\ub3c5 \ub610\ub294 \ud328\ud134 \uc778\uc2dd\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uba3c\uc800 \ud14d\uc2a4\ud2b8\ub97c \ubd84\uc11d\ud558\uc5ec \uc228\uaca8\uc9c4 \uc758\ubbf8\ub098 \uc5b8\uc5b4 \uc720\ud76c\ub97c \ucc3e\uc73c\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc9c8\ubb38\uc5d0\uc11c \ubb38\uc790 \uc21c\uc5f4 \ub610\ub294 \ub18d\ub2f4\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc815\ub2f5\uc744 \uac00\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \uba54\uc2dc\uc9c0\ub97c \uc791\uc740 \ubd80\ubd84\uc73c\ub85c \ub098\ub204\uc5b4 \ud328\ud134\uc744 \uc2dd\ubcc4\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \ub2e8\uc5b4\ub098 \uc11c\uc2dd\uc5d0\uc11c \ud78c\ud2b8\ub97c \ucc3e\uc73c\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \uad00\ub828 \uc694\uc18c\ub97c \ud074\ub9ad\ud558\uc5ec \uc7a0\uc7ac\uc801 \uc194\ub8e8\uc158\uc744 \ud14c\uc2a4\ud2b8\ud558\uc2ed\uc2dc\uc624. \uc774\ub7ec\ud55c \uccb4\uacc4\uc801\uc778 \uc811\uadfc \ubc29\uc2dd\uc740 \uac8c\uc784\uc758 \uc218\uc218\uaed8\ub07c\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \ud480 \uc218 \uc788\ub3c4\ub85d \ub3c4\uc640\uc90d\ub2c8\ub2e4."}, {"question": "\ubd88\uac00\ub2a5\ud55c \ud034\uc988\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \uc790\uc8fc \uc800\uc9c0\ub974\ub294 \uac00\uc7a5 \ud754\ud55c \uc2e4\uc218\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub294 \uc885\uc885 \uc9c8\ubb38\uc744 \uc11c\ub450\ub974\uac70\ub098 \uc9c0\ub098\uce58\uac8c \uc0dd\uac01\ud558\uc5ec \uc2e4\uc218\ub97c \uc800\uc9c0\ub985\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud754\ud55c \uc2e4\uc218\ub294 \uba85\ubc31\ud55c \ub2f5\ucc98\ub7fc \ubcf4\uc774\ub294 \uac83\uc744 \ub108\ubb34 \ube68\ub9ac \ud074\ub9ad\ud558\ub294 \uac83\uc778\ub370, \uc18d\uc784\uc218 \uc9c8\ubb38\uc784\uc744 \uae68\ub2eb\uac8c \ub429\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uc2e4\uc218\ub294 \ub2e8\uc5b4\ub098 \uc2dc\uac01\uc801 \ud78c\ud2b8\ub97c \ubb34\uc2dc\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud568\uc815\uc744 \ud53c\ud558\ub824\uba74 \uac01 \uc9c8\ubb38\uc744 \uc8fc\uc758 \uae4a\uac8c \uc77d\uace0 \ubaa8\ub4e0 \uac00\ub2a5\ud55c \ud574\uc11d\uc744 \uace0\ub824\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 1: \uc18d\ub3c4\ub97c \ub2a6\ucd94\uace0 \ucca0\uc800\ud788 \uc77d\uc73c\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \uc228\uaca8\uc9c4 \ub2e8\uc11c\ub098 \uc5b8\uc5b4 \uc720\ud76c\ub97c \ucc3e\uc73c\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \ud074\ub9ad\ud558\uae30 \uc804\uc5d0 \uc774\ud574\ub97c \ud14c\uc2a4\ud2b8\ud558\uc2ed\uc2dc\uc624. \uc774\ub7ec\ud55c \uc811\uadfc \ubc29\uc2dd\uc740 \uc2e4\uc218\ub97c \uc904\uc774\uace0 \uc815\ud655\uc131\uc744 \ub192\uc785\ub2c8\ub2e4."}, {"question": "\ubd88\uac00\ub2a5\ud55c \ud034\uc988\uc758 \ub09c\uc774\ub3c4 \uace1\uc120\uc774 \ud50c\ub808\uc774\uc5b4\uc758 \uc9c4\ucc99\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ubd88\uac00\ub2a5\ud55c \ud034\uc988\uc758 \ub09c\uc774\ub3c4 \uace1\uc120\uc740 \uc810\ucc28 \uc99d\uac00\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5b4 \ud50c\ub808\uc774\uc5b4\uac00 \uc9c4\ucc99\ub428\uc5d0 \ub530\ub77c \ub3c4\uc804 \uacfc\uc81c\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4. \ucd08\uae30 \uc9c8\ubb38\uc740 \ub354 \uac04\ub2e8\ud558\uc5ec \ud50c\ub808\uc774\uc5b4\uac00 \uac8c\uc784\uc758 \uba54\ucee4\ub2c8\uc998\uc744 \ubc30\uc6b0\ub3c4\ub85d \ub3d5\ub294 \ubc18\uba74, \ud6c4\ubc18 \uc9c8\ubb38\uc740 \ub354 \ubcf5\uc7a1\ud55c \uc18d\uc784\uc218\uc640 \ud37c\uc990\uc744 \uc18c\uac1c\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucd08\ubcf4\uc790\ub294 \uac04\ub2e8\ud55c \uac1d\uad00\uc2dd \uc9c8\ubb38\uc5d0 \uc9c1\uba74\ud560 \uc218 \uc788\ub294 \ubc18\uba74, \uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\ub294 \uc218\uc218\uaed8\ub07c\ub098 \uc2dc\uac04 \uc81c\ud55c \ucc4c\ub9b0\uc9c0\uc5d0 \uc9c1\uba74\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc9c4\ud589\uc740 \uac8c\uc784\uc744 \uacc4\uc18d \ub9e4\ub825\uc801\uc73c\ub85c \ub9cc\ub4e4\uc9c0\ub9cc, \uc900\ube44\ub418\uc9c0 \uc54a\uc740 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c\ub294 \uc88c\uc808\uac10\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \ucd08\uae30 \ub808\ubca8\uc5d0\uc11c \uae30\ubcf8 \uc0ac\ud56d\uc744 \ub9c8\uc2a4\ud130\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \uc99d\uac00\ud558\ub294 \ubcf5\uc7a1\uc131\uc744 \uc608\uce21\ud558\uace0 \uc801\uc751\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \uc778\ub0b4\uc2ec\uc744 \uac00\uc9c0\uace0 \ub048\uae30 \uc788\uac8c \ub178\ub825\ud558\uc2ed\uc2dc\uc624. \uc774 \uace1\uc120\uc744 \uc774\ud574\ud558\uba74 \uae30\ub300\uce58\ub97c \uad00\ub9ac\ud558\uace0 \uafb8\uc900\ud788 \uac1c\uc120\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\ubd88\uac00\ub2a5\ud55c \ud034\uc988\uc758 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uc758 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubd88\uac00\ub2a5\ud55c \ud034\uc988\uc758 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc7ac\ubbf8\uc640 \ub3c4\uc804 \uacfc\uc81c\ub97c \ub354\ud558\ub294 \ucd94\uac00\uc801\uc778 \uc694\uc18c\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uc885\uc885 \ucc3d\uc758\uc801\uc778 \uc0ac\uace0 \ub610\ub294 \ud0d0\uad6c\uc5d0 \ub300\ud55c \ubcf4\uc0c1\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud654\uba74\uc758 \uad00\ub828\uc131\uc774 \uc5c6\uc5b4 \ubcf4\uc774\ub294 \ubd80\ubd84\uc744 \ud074\ub9ad\ud558\uba74 \ube44\ubc00 \uba54\uc2dc\uc9c0\ub098 \ubcf4\ub108\uc2a4 \uc810\uc218\uac00 \ub098\ud0c0\ub0a0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc694\uc18c\ub97c \ubc1c\uacac\ud558\ub824\uba74 \ud638\uae30\uc2ec\uacfc \uc138\uc2ec\ud568\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \ud2b9\uc774\ud55c \uc601\uc5ed\uc744 \ud074\ub9ad\ud558\uc5ec \uc2e4\ud5d8\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \uc2dc\uac01\uc801 \ub610\ub294 \ud14d\uc2a4\ud2b8\uc801 \uc774\uc0c1 \ud604\uc0c1\uc744 \ucc3e\uc73c\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \ucee4\ubba4\ub2c8\ud2f0\uc640 \ubc1c\uacac \uc0ac\ud56d\uc744 \uacf5\uc720\ud558\uc2ed\uc2dc\uc624. \uc774\ub7ec\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uac8c\uc784\uc758 \uc7ac\ubbf8 \uc9c0\uc18d \uc2dc\uac04\uc744 \ub192\uc774\uace0 \uc131\ucde8\uac10\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}]
[{"question": "\u5982\u4f55\u5728\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57\u300b\u4e2d\u63d0\u5347\u6211\u7684\u53cd\u61c9\u6642\u9593\uff1f", "answer": "\u63d0\u5347\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57\u300b\u4e2d\u7684\u53cd\u61c9\u6642\u9593\u9700\u8981\u7df4\u7fd2\u4e26\u719f\u6089\u984c\u76ee\u6a21\u5f0f\u3002\u9996\u5148\uff0c\u5b9a\u671f\u73a9\u904a\u6232\uff0c\u7fd2\u6163\u5404\u7a2e\u984c\u578b\u3002\u5c08\u6ce8\u65bc\u5feb\u901f\u8fa8\u8a8d\u6a21\u5f0f\uff0c\u4f8b\u5982\u8fa8\u8b58\u9677\u9631\u984c\u6216\u8996\u89ba\u63d0\u793a\u3002\u4f8b\u5982\uff0c\u5728\u9700\u8981\u9ede\u64ca\u7279\u5b9a\u55ae\u8a5e\u7684\u554f\u984c\u4e2d\uff0c\u7df4\u7fd2\u5feb\u901f\u6383\u63cf\u6587\u5b57\u3002\u6b64\u5916\uff0c\u5118\u53ef\u80fd\u6e1b\u5c11\u5e72\u64fe\uff0c\u4e26\u78ba\u4fdd\u60a8\u7684\u8a2d\u5099\u53cd\u61c9\u9748\u654f\u3002\u6b65\u9a5f 1\uff1a\u6bcf\u65e5\u904a\u6232\uff0c\u5efa\u7acb\u808c\u8089\u8a18\u61b6\u3002\u6b65\u9a5f 2\uff1a\u5206\u6790\u904e\u53bb\u7684\u984c\u76ee\uff0c\u9810\u6e2c\u9677\u9631\u3002\u6b65\u9a5f 3\uff1a\u512a\u5316\u60a8\u7684\u74b0\u5883\uff0c\u4ee5\u4fbf\u5feb\u901f\u505a\u51fa\u53cd\u61c9\u3002\u9019\u7a2e\u65b9\u6cd5\u5c07\u6709\u52a9\u65bc\u60a8\u66f4\u5feb\u3001\u66f4\u6e96\u78ba\u5730\u53cd\u61c9\u3002"}, {"question": "\u5728\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57\u300b\u4e2d\u89e3\u6c7a\u9677\u9631\u984c\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57\u300b\u4e2d\u7684\u9677\u9631\u984c\u901a\u5e38\u9700\u8981\u8df3\u51fa\u6846\u6846\u601d\u8003\u3002\u4ee5\u4e0b\u662f\u5faa\u5e8f\u6f38\u9032\u7684\u7b56\u7565\uff1a\u6b65\u9a5f 1\uff1a\u4ed4\u7d30\u95b1\u8b80\u554f\u984c\uff0c\u6ce8\u610f\u63aa\u8fad\u548c\u8996\u89ba\u7d30\u7bc0\u3002\u6b65\u9a5f 2\uff1a\u5c0b\u627e\u7d30\u5fae\u7684\u63d0\u793a\u6216\u6587\u5b57\u904a\u6232\uff0c\u4f8b\u5982\u96d9\u95dc\u8a9e\u6216\u96d9\u91cd\u542b\u7fa9\u3002\u4f8b\u5982\uff0c\u4e00\u500b\u554f\u984c\u53ef\u80fd\u554f\u300c\u6cd5\u570b\u7684\u9996\u90fd\u662f\u4ec0\u9ebc\uff1f\u300d\u4f46\u7b54\u6848\u53ef\u80fd\u662f\u6587\u5b57\u904a\u6232\uff0c\u800c\u4e0d\u662f\u300c\u5df4\u9ece\u300d\u3002\u6b65\u9a5f 3\uff1a\u5982\u679c\u5361\u95dc\uff0c\u5617\u8a66\u9ede\u64ca\u4e00\u4e9b\u610f\u60f3\u4e0d\u5230\u7684\u5143\u7d20\uff0c\u4f8b\u5982\u554f\u984c\u6587\u5b57\u6216\u80cc\u666f\u3002\u6c38\u9060\u8a18\u4f4f\uff0c\u50b3\u7d71\u7684\u7b54\u6848\u53ef\u80fd\u4e0d\u9069\u7528\u3002\u6b64\u65b9\u6cd5\u6709\u52a9\u65bc\u60a8\u6709\u6548\u61c9\u5c0d\u904a\u6232\u7684\u7368\u7279\u6311\u6230\u3002"}, {"question": "\u54ea\u4e9b\u5e73\u53f0\u652f\u63f4\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57\u300b\uff0c\u662f\u5426\u652f\u63f4\u8de8\u5e73\u53f0\u76f8\u5bb9\u6027\uff1f", "answer": "\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57\u300b\u4e3b\u8981\u53ef\u5728\u7db2\u9801\u700f\u89bd\u5668\u548c\u884c\u52d5\u88dd\u7f6e\u4e0a\u4f7f\u7528\u3002\u96d6\u7136\u904a\u6232\u5728\u5169\u500b\u5e73\u53f0\u4e0a\u90fd\u53ef\u4f7f\u7528\uff0c\u4f46\u6c92\u6709\u8de8\u5e73\u53f0\u76f8\u5bb9\u6027\u6216\u8cc7\u6599\u9077\u79fb\u529f\u80fd\u3002\u9019\u8868\u793a\u5728\u4e00\u500b\u5e73\u53f0\u4e0a\u53d6\u5f97\u7684\u9032\u5ea6\u7121\u6cd5\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u5e73\u53f0\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u700f\u89bd\u5668\u4e0a\u73a9\u904a\u6232\uff0c\u7136\u5f8c\u5207\u63db\u5230\u884c\u52d5\u61c9\u7528\u7a0b\u5f0f\uff0c\u60a8\u9700\u8981\u91cd\u65b0\u958b\u59cb\u3002\u70ba\u907f\u514d\u5931\u53bb\u9032\u5ea6\uff0c\u8acb\u78ba\u4fdd\u9078\u64c7\u9069\u5408\u60a8\u904a\u6232\u7fd2\u6163\u7684\u5e73\u53f0\u3002\u5c0d\u65bc\u983b\u7e41\u66f4\u63db\u88dd\u7f6e\u7684\u73a9\u5bb6\u4f86\u8aaa\uff0c\u9019\u4e00\u9ede\u9700\u8981\u6ce8\u610f\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57\u300b\u4e2d\u6709\u4e9b\u554f\u984c\u770b\u4f3c\u4e0d\u53ef\u80fd\u89e3\u7b54\uff1f", "answer": "\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57\u300b\u4e2d\u6709\u4e9b\u554f\u984c\u8a2d\u8a08\u6210\u6545\u610f\u8aa4\u5c0e\u6216\u975e\u5e38\u898f\u554f\u984c\u3002\u9019\u4e9b\u554f\u984c\u901a\u5e38\u4f9d\u8cf4\u6587\u5b57\u904a\u6232\u3001\u8996\u89ba\u6280\u5de7\u6216\u610f\u60f3\u4e0d\u5230\u7684\u908f\u8f2f\u3002\u4f8b\u5982\uff0c\u4e00\u500b\u554f\u984c\u53ef\u80fd\u6703\u8981\u6c42\u60a8\u300c\u9ede\u64ca\u7da0\u8272\u6309\u9215\u300d\uff0c\u4f46\u6309\u9215\u5be6\u969b\u4e0a\u662f\u7d05\u8272\u7684\uff0c\u8feb\u4f7f\u60a8\u4ee5\u4e0d\u540c\u7684\u65b9\u5f0f\u601d\u8003\u3002\u904a\u6232\u7684\u8a2d\u8a08\u8005\u65e8\u5728\u6311\u6230\u73a9\u5bb6\u7684\u5047\u8a2d\uff0c\u4e26\u9f13\u52f5\u5275\u9020\u6027\u7684\u554f\u984c\u89e3\u6c7a\u80fd\u529b\u3002\u4e86\u89e3\u9019\u7a2e\u8a2d\u8a08\u7406\u5ff5\u6709\u52a9\u65bc\u60a8\u4ee5\u958b\u653e\u7684\u601d\u7dad\u548c\u9069\u61c9\u6027\u4f86\u8655\u7406\u6b64\u985e\u554f\u984c\uff0c\u4f7f\u5176\u4e0d\u90a3\u9ebc\u4ee4\u4eba\u6cae\u55aa\uff0c\u800c\u66f4\u4ee4\u4eba\u4eab\u53d7\u3002"}, {"question": "\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57\u300b\u7684\u8a08\u5206\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff0c\u5982\u4f55\u6700\u5927\u5316\u6211\u7684\u5206\u6578\uff1f", "answer": "\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57\u300b\u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u6b63\u78ba\u7b54\u6848\u548c\u8df3\u904e\u3002\u6bcf\u500b\u6b63\u78ba\u7b54\u6848\u90fd\u6703\u7372\u5f97\u5206\u6578\uff0c\u800c\u8df3\u904e\u5247\u6703\u6263\u5206\u3002\u70ba\u6700\u5927\u5316\u60a8\u7684\u5206\u6578\uff0c\u61c9\u6ce8\u91cd\u6e96\u78ba\u6027\u800c\u975e\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u4e0d\u78ba\u5b9a\u554f\u984c\u7684\u7b54\u6848\uff0c\u8acb\u7b56\u7565\u6027\u5730\u8df3\u904e\u554f\u984c\uff0c\u907f\u514d\u6263\u5206\u3002\u6b64\u5916\uff0c\u7df4\u7fd2\u8fa8\u8a8d\u554f\u984c\u6a21\u5f0f\uff0c\u4ee5\u6e1b\u5c11\u932f\u8aa4\u3002\u6b65\u9a5f 1\uff1a\u512a\u5148\u8003\u616e\u6e96\u78ba\u6027\u800c\u4e0d\u662f\u901f\u5ea6\u3002\u6b65\u9a5f 2\uff1a\u660e\u667a\u5730\u4f7f\u7528\u8df3\u904e\u529f\u80fd\uff0c\u907f\u514d\u6263\u5206\u3002\u6b65\u9a5f 3\uff1a\u5206\u6790\u904e\u53bb\u7684\u554f\u984c\uff0c\u4ee5\u6539\u5584\u672a\u4f86\u7684\u8868\u73fe\u3002\u6b64\u65b9\u6cd5\u6709\u52a9\u65bc\u60a8\u6301\u7e8c\u7372\u5f97\u66f4\u9ad8\u7684\u5206\u6578\u3002"}, {"question": "\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57\u300b\u4e2d\u54ea\u4e9b\u96b1\u85cf\u6a5f\u5236\u662f\u5927\u591a\u6578\u73a9\u5bb6\u5ffd\u7565\u7684\uff1f", "answer": "\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57\u300b\u5305\u542b\u4e00\u4e9b\u96b1\u85cf\u6a5f\u5236\uff0c\u53ef\u80fd\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\u3002\u4e00\u500b\u4f8b\u5b50\u662f\u4f7f\u7528\u8072\u97f3\u63d0\u793a\uff1b\u67d0\u4e9b\u554f\u984c\u53ef\u80fd\u6709\u8072\u97ff\u63d0\u793a\uff0c\u5f15\u5c0e\u6b63\u78ba\u7b54\u6848\u3002\u53e6\u4e00\u7a2e\u6a5f\u5236\u662f\u9ede\u64ca\u6642\u9593\uff1b\u67d0\u4e9b\u554f\u984c\u9700\u8981\u7cbe\u78ba\u7684\u6642\u9593\u624d\u80fd\u6210\u529f\u3002\u4f8b\u5982\uff0c\u4e00\u500b\u554f\u984c\u53ef\u80fd\u6703\u8981\u6c42\u60a8\u5728\u7279\u5b9a\u8072\u97f3\u64ad\u653e\u6642\u9ede\u64ca\u3002\u6ce8\u610f\u9019\u4e9b\u7d30\u5fae\u7684\u7d30\u7bc0\u53ef\u4ee5\u8b93\u60a8\u4f54\u5f97\u5148\u6a5f\u3002\u6b65\u9a5f 1\uff1a\u4ed4\u7d30\u8046\u807d\u8072\u97f3\u63d0\u793a\u3002\u6b65\u9a5f 2\uff1a\u7df4\u7fd2\u7cbe\u78ba\u9ede\u64ca\u6642\u9593\u3002\u6b65\u9a5f 3\uff1a\u4ed4\u7d30\u89c0\u5bdf\u8996\u89ba\u548c\u807d\u89ba\u6a21\u5f0f\u3002\u638c\u63e1\u9019\u4e9b\u6a5f\u5236\u53ef\u4ee5\u589e\u5f37\u60a8\u7684\u6574\u9ad4\u8868\u73fe\u3002"}, {"question": "\u5982\u4f55\u89e3\u8b6f\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57\u300b\u4e2d\u7684\u795e\u79d8\u8a0a\u606f\uff1f", "answer": "\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57\u300b\u4e2d\u7684\u795e\u79d8\u8a0a\u606f\u901a\u5e38\u9700\u8981\u89e3\u78bc\u6216\u6a21\u5f0f\u8b58\u5225\u3002\u9996\u5148\uff0c\u5206\u6790\u6587\u5b57\u7684\u96b1\u85cf\u542b\u7fa9\u6216\u6587\u5b57\u904a\u6232\u3002\u4f8b\u5982\uff0c\u4e00\u500b\u554f\u984c\u53ef\u80fd\u6703\u4f7f\u7528\u56de\u6587\u6216\u96d9\u95dc\u8a9e\u4f86\u507d\u88dd\u6b63\u78ba\u7b54\u6848\u3002\u6b65\u9a5f 1\uff1a\u5c07\u8a0a\u606f\u5206\u89e3\u6210\u8f03\u5c0f\u7684\u90e8\u5206\uff0c\u4ee5\u8b58\u5225\u6a21\u5f0f\u3002\u6b65\u9a5f 2\uff1a\u5c0b\u627e\u63aa\u8fad\u6216\u683c\u5f0f\u4e2d\u7684\u7dda\u7d22\u3002\u6b65\u9a5f 3\uff1a\u900f\u904e\u9ede\u64ca\u76f8\u95dc\u5143\u7d20\u4f86\u6e2c\u8a66\u6f5b\u5728\u7684\u89e3\u6c7a\u65b9\u6848\u3002\u9019\u7a2e\u6709\u689d\u7406\u7684\u65b9\u6cd5\u6709\u52a9\u65bc\u60a8\u6709\u6548\u89e3\u958b\u904a\u6232\u7684\u795e\u79d8\u3002"}, {"question": "\u65b0\u624b\u5728\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57\u300b\u4e2d\u5e38\u898b\u7684\u932f\u8aa4\u6709\u54ea\u4e9b\uff1f", "answer": "\u65b0\u624b\u73a9\u5bb6\u5e38\u72af\u7684\u932f\u8aa4\u662f\u5306\u5306\u700f\u89bd\u554f\u984c\u6216\u904e\u5ea6\u601d\u8003\u3002\u4f8b\u5982\uff0c\u4e00\u500b\u5e38\u898b\u932f\u8aa4\u662f\u904e\u5feb\u9ede\u64ca\u770b\u4f3c\u660e\u986f\u7684\u7b54\u6848\uff0c\u7136\u5f8c\u624d\u610f\u8b58\u5230\u5b83\u662f\u4e00\u500b\u9677\u9631\u554f\u984c\u3002\u53e6\u4e00\u500b\u932f\u8aa4\u662f\u5ffd\u7565\u63aa\u8fad\u6216\u8996\u89ba\u4e2d\u7684\u7d30\u5fae\u63d0\u793a\u3002\u70ba\u907f\u514d\u9019\u4e9b\u9677\u9631\uff0c\u82b1\u6642\u9593\u4ed4\u7d30\u95b1\u8b80\u6bcf\u500b\u554f\u984c\uff0c\u4e26\u8003\u616e\u6240\u6709\u53ef\u80fd\u7684\u8a6e\u91cb\u3002\u6b65\u9a5f 1\uff1a\u653e\u6162\u901f\u5ea6\uff0c\u4ed4\u7d30\u95b1\u8b80\u3002\u6b65\u9a5f 2\uff1a\u5c0b\u627e\u96b1\u85cf\u7684\u7dda\u7d22\u6216\u6587\u5b57\u904a\u6232\u3002\u6b65\u9a5f 3\uff1a\u5728\u9ede\u64ca\u524d\u6e2c\u8a66\u60a8\u7684\u7406\u89e3\u3002\u6b64\u65b9\u6cd5\u6e1b\u5c11\u932f\u8aa4\u4e26\u63d0\u9ad8\u6e96\u78ba\u6027\u3002"}, {"question": "\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57\u300b\u7684\u96e3\u5ea6\u66f2\u7dda\u5982\u4f55\u5f71\u97ff\u73a9\u5bb6\u7684\u9032\u5ea6\uff1f", "answer": "\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57\u300b\u7684\u96e3\u5ea6\u66f2\u7dda\u65e8\u5728\u9010\u6f38\u589e\u52a0\uff0c\u96a8\u8457\u73a9\u5bb6\u7684\u9032\u5c55\u800c\u8b8a\u5f97\u66f4\u5177\u6311\u6230\u6027\u3002\u65e9\u671f\u554f\u984c\u6bd4\u8f03\u7c21\u55ae\uff0c\u6709\u52a9\u65bc\u73a9\u5bb6\u5b78\u7fd2\u904a\u6232\u6a5f\u5236\uff0c\u800c\u5f8c\u671f\u7684\u554f\u984c\u5247\u5f15\u5165\u4e86\u66f4\u8907\u96dc\u7684\u6280\u5de7\u548c\u8b0e\u984c\u3002\u4f8b\u5982\uff0c\u65b0\u624b\u53ef\u80fd\u9762\u5c0d\u7c21\u55ae\u7684\u8907\u9078\u984c\uff0c\u800c\u9ad8\u7d1a\u73a9\u5bb6\u5247\u6703\u9047\u5230\u8b0e\u984c\u6216\u9650\u6642\u6311\u6230\u3002\u9019\u7a2e\u9032\u5ea6\u4f7f\u904a\u6232\u5177\u6709\u5438\u5f15\u529b\uff0c\u4f46\u4e5f\u53ef\u80fd\u8b93\u672a\u6e96\u5099\u597d\u7684\u73a9\u5bb6\u611f\u5230\u6cae\u55aa\u3002\u6b65\u9a5f 1\uff1a\u5728\u65e9\u671f\u95dc\u5361\u638c\u63e1\u57fa\u790e\u3002\u6b65\u9a5f 2\uff1a\u9810\u671f\u4e26\u9069\u61c9\u65e5\u76ca\u589e\u9577\u7684\u8907\u96dc\u6027\u3002\u6b65\u9a5f 3\uff1a\u4fdd\u6301\u8010\u5fc3\u548c\u6bc5\u529b\u3002\u4e86\u89e3\u6b64\u66f2\u7dda\u6709\u52a9\u65bc\u60a8\u63a7\u5236\u671f\u671b\uff0c\u4e26\u7a69\u6b65\u63d0\u5347\u3002"}, {"question": "\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57\u300b\u4e2d\u96b1\u85cf\u5f69\u86cb\u7684\u610f\u7fa9\u662f\u4ec0\u9ebc\uff1f", "answer": "\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57\u300b\u4e2d\u7684\u96b1\u85cf\u5f69\u86cb\u70ba\u73a9\u5bb6\u589e\u6dfb\u4e86\u984d\u5916\u7684\u6a02\u8da3\u548c\u6311\u6230\u3002\u9019\u4e9b\u5f69\u86cb\u901a\u5e38\u6703\u734e\u52f5\u5275\u9020\u6027\u7684\u601d\u8003\u6216\u63a2\u7d22\u3002\u4f8b\u5982\uff0c\u9ede\u64ca\u87a2\u5e55\u4e0a\u770b\u4f3c\u4e0d\u76f8\u5e72\u7684\u90e8\u5206\u53ef\u80fd\u6703\u986f\u793a\u79d8\u5bc6\u8a0a\u606f\u6216\u984d\u5916\u5206\u6578\u3002\u767c\u73fe\u9019\u4e9b\u5143\u7d20\u9700\u8981\u597d\u5947\u5fc3\u548c\u6ce8\u610f\u7d30\u7bc0\u3002\u6b65\u9a5f 1\uff1a\u5617\u8a66\u9ede\u64ca\u4e0d\u5c0b\u5e38\u7684\u5340\u57df\u3002\u6b65\u9a5f 2\uff1a\u5c0b\u627e\u8996\u89ba\u6216\u6587\u5b57\u7570\u5e38\u3002\u6b65\u9a5f 3\uff1a\u8207\u793e\u7fa4\u5206\u4eab\u60a8\u7684\u767c\u73fe\u3002\u9019\u4e9b\u5f69\u86cb\u589e\u5f37\u4e86\u904a\u6232\u7684\u91cd\u73a9\u50f9\u503c\uff0c\u4e26\u63d0\u4f9b\u6210\u5c31\u611f\u3002"}]
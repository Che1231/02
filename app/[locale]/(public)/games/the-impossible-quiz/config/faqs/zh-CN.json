[{"question": "\u5982\u4f55\u5728\u300a\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c\u300b\u4e2d\u63d0\u9ad8\u6211\u7684\u53cd\u5e94\u901f\u5ea6\uff1f", "answer": "\u5728\u300a\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c\u300b\u4e2d\u63d0\u9ad8\u53cd\u5e94\u901f\u5ea6\u9700\u8981\u7ec3\u4e60\u548c\u719f\u6089\u95ee\u9898\u6a21\u5f0f\u3002\u901a\u8fc7\u5b9a\u671f\u73a9\u6e38\u620f\uff0c\u9010\u6e10\u9002\u5e94\u5404\u79cd\u95ee\u9898\u7c7b\u578b\u3002\u4e13\u6ce8\u4e8e\u5feb\u901f\u8bc6\u522b\u6a21\u5f0f\uff0c\u4f8b\u5982\u8bc6\u522b\u9677\u9631\u95ee\u9898\u6216\u89c6\u89c9\u7ebf\u7d22\u3002\u4f8b\u5982\uff0c\u5728\u9700\u8981\u70b9\u51fb\u7279\u5b9a\u5355\u8bcd\u7684\u95ee\u9898\u4e2d\uff0c\u7ec3\u4e60\u5feb\u901f\u626b\u63cf\u6587\u672c\u3002\u6b64\u5916\uff0c\u5c3d\u91cf\u51cf\u5c11\u5e72\u6270\uff0c\u786e\u4fdd\u4f60\u7684\u8bbe\u5907\u54cd\u5e94\u7075\u654f\u3002\u6b65\u9aa41\uff1a\u6bcf\u65e5\u6e38\u620f\uff0c\u5efa\u7acb\u808c\u8089\u8bb0\u5fc6\u3002\u6b65\u9aa42\uff1a\u5206\u6790\u8fc7\u53bb\u7684\u95ee\u9898\uff0c\u9884\u6d4b\u9677\u9631\u3002\u6b65\u9aa43\uff1a\u4f18\u5316\u4f60\u7684\u73af\u5883\uff0c\u4ee5\u4fbf\u5feb\u901f\u53cd\u5e94\u3002\u8fd9\u79cd\u65b9\u6cd5\u5c06\u5e2e\u52a9\u4f60\u66f4\u5feb\u3001\u66f4\u51c6\u786e\u5730\u505a\u51fa\u53cd\u5e94\u3002"}, {"question": "\u89e3\u51b3\u300a\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c\u300b\u4e2d\u7684\u9677\u9631\u95ee\u9898\u6700\u597d\u7684\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c\u300b\u4e2d\u7684\u9677\u9631\u95ee\u9898\u901a\u5e38\u9700\u8981\u8df3\u51fa\u601d\u7ef4\u5b9a\u52bf\u3002\u4ee5\u4e0b\u662f\u5206\u6b65\u9aa4\u7684\u7b56\u7565\uff1a\u6b65\u9aa41\uff1a\u4ed4\u7ec6\u9605\u8bfb\u95ee\u9898\uff0c\u6ce8\u610f\u63aa\u8f9e\u548c\u89c6\u89c9\u7ec6\u8282\u3002\u6b65\u9aa42\uff1a\u5bfb\u627e\u7ec6\u5fae\u7684\u6697\u793a\u6216\u6587\u5b57\u6e38\u620f\uff0c\u4f8b\u5982\u53cc\u5173\u8bed\u6216\u53cc\u91cd\u542b\u4e49\u3002\u4f8b\u5982\uff0c\u4e00\u4e2a\u95ee\u9898\u53ef\u80fd\u4f1a\u95ee\u201c\u6cd5\u56fd\u7684\u9996\u90fd\u662f\u4ec0\u4e48\uff1f\u201d\uff0c\u4f46\u7b54\u6848\u53ef\u80fd\u662f\u6587\u5b57\u6e38\u620f\uff0c\u800c\u4e0d\u662f\u201c\u5df4\u9ece\u201d\u3002\u6b65\u9aa43\uff1a\u5982\u679c\u5361\u4f4f\u4e86\uff0c\u5c1d\u8bd5\u70b9\u51fb\u610f\u5916\u7684\u5143\u7d20\uff0c\u4f8b\u5982\u95ee\u9898\u6587\u672c\u6216\u80cc\u666f\u3002\u59cb\u7ec8\u8bb0\u4f4f\uff0c\u4f20\u7edf\u7684\u7b54\u6848\u53ef\u80fd\u4e0d\u9002\u7528\u3002\u8fd9\u79cd\u65b9\u6cd5\u6709\u6548\u5730\u5e2e\u52a9\u4f60\u5e94\u5bf9\u6e38\u620f\u7684\u72ec\u7279\u6311\u6218\u3002"}, {"question": "\u54ea\u4e9b\u5e73\u53f0\u652f\u6301\u300a\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c\u300b\uff0c\u5e76\u4e14\u5e73\u53f0\u4e4b\u95f4\u662f\u5426\u517c\u5bb9\uff1f", "answer": "\u300a\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c\u300b\u4e3b\u8981\u53ef\u5728\u7f51\u9875\u6d4f\u89c8\u5668\u548c\u79fb\u52a8\u8bbe\u5907\u4e0a\u4f7f\u7528\u3002\u867d\u7136\u8be5\u6e38\u620f\u5728\u4e24\u4e2a\u5e73\u53f0\u4e0a\u90fd\u53ef\u8bbf\u95ee\uff0c\u4f46\u5e73\u53f0\u4e4b\u95f4\u6ca1\u6709\u517c\u5bb9\u6027\u6216\u6570\u636e\u8fc1\u79fb\u529f\u80fd\u3002\u8fd9\u610f\u5473\u7740\u5728\u4e00\u4e2a\u5e73\u53f0\u4e0a\u53d6\u5f97\u7684\u8fdb\u5ea6\u65e0\u6cd5\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u5e73\u53f0\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u6d4f\u89c8\u5668\u4e0a\u73a9\u6e38\u620f\uff0c\u7136\u540e\u5207\u6362\u5230\u79fb\u52a8\u5e94\u7528\uff0c\u4f60\u9700\u8981\u91cd\u65b0\u5f00\u59cb\u3002\u786e\u4fdd\u4f60\u9009\u62e9\u9002\u5408\u4f60\u6e38\u620f\u4e60\u60ef\u7684\u5e73\u53f0\uff0c\u4ee5\u907f\u514d\u4e22\u5931\u8fdb\u5ea6\u3002\u5bf9\u4e8e\u7ecf\u5e38\u5207\u6362\u8bbe\u5907\u7684\u73a9\u5bb6\u6765\u8bf4\uff0c\u8fd9\u4e00\u70b9\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u300a\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c\u300b\u4e2d\u7684\u4e00\u4e9b\u95ee\u9898\u770b\u8d77\u6765\u4f3c\u4e4e\u65e0\u89e3\uff1f", "answer": "\u300a\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c\u300b\u4e2d\u7684\u4e00\u4e9b\u95ee\u9898\u65e8\u5728\u6545\u610f\u8bef\u5bfc\u6216\u975e\u5e38\u89c4\u3002\u8fd9\u4e9b\u95ee\u9898\u901a\u5e38\u4f9d\u8d56\u4e8e\u6587\u5b57\u6e38\u620f\u3001\u89c6\u89c9\u6280\u5de7\u6216\u610f\u5916\u7684\u903b\u8f91\u3002\u4f8b\u5982\uff0c\u4e00\u4e2a\u95ee\u9898\u53ef\u80fd\u4f1a\u8ba9\u4f60\u201c\u70b9\u51fb\u7eff\u8272\u6309\u94ae\u201d\uff0c\u4f46\u6309\u94ae\u5b9e\u9645\u4e0a\u662f\u7ea2\u8272\u7684\uff0c\u8feb\u4f7f\u4f60\u4ee5\u4e0d\u540c\u7684\u65b9\u5f0f\u601d\u8003\u3002\u6e38\u620f\u7684\u8bbe\u8ba1\u8005\u65e8\u5728\u6311\u6218\u73a9\u5bb6\u7684\u5047\u8bbe\uff0c\u5e76\u9f13\u52b1\u521b\u9020\u6027\u7684\u95ee\u9898\u89e3\u51b3\u80fd\u529b\u3002\u7406\u89e3\u8fd9\u79cd\u8bbe\u8ba1\u7406\u5ff5\u5c06\u5e2e\u52a9\u4f60\u4ee5\u5f00\u653e\u7684\u5fc3\u6001\u548c\u9002\u5e94\u6027\u6765\u5e94\u5bf9\u6b64\u7c7b\u95ee\u9898\uff0c\u4f7f\u5176\u4e0d\u90a3\u4e48\u4ee4\u4eba\u6cae\u4e27\uff0c\u66f4\u4ee4\u4eba\u6109\u5feb\u3002"}, {"question": "\u300a\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c\u300b\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u5982\u4f55\u6700\u5927\u5316\u6211\u7684\u5f97\u5206\uff1f", "answer": "\u300a\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c\u300b\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u6b63\u786e\u7b54\u6848\u548c\u8df3\u8fc7\u95ee\u9898\u3002\u6bcf\u4e2a\u6b63\u786e\u7b54\u6848\u90fd\u4f1a\u5956\u52b1\u5206\u6570\uff0c\u800c\u8df3\u8fc7\u5219\u4f1a\u6263\u5206\u3002\u4e3a\u4e86\u6700\u5927\u5316\u4f60\u7684\u5206\u6570\uff0c\u5e94\u5173\u6ce8\u51c6\u786e\u6027\u800c\u4e0d\u662f\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4e0d\u786e\u5b9a\u4e00\u4e2a\u95ee\u9898\uff0c\u8bf7\u7b56\u7565\u6027\u5730\u4f7f\u7528\u8df3\u8fc7\u529f\u80fd\uff0c\u4ee5\u907f\u514d\u635f\u5931\u5206\u6570\u3002\u6b64\u5916\uff0c\u7ec3\u4e60\u8bc6\u522b\u95ee\u9898\u6a21\u5f0f\u4ee5\u51cf\u5c11\u9519\u8bef\u3002\u6b65\u9aa41\uff1a\u4f18\u5148\u8003\u8651\u51c6\u786e\u6027\u800c\u4e0d\u662f\u901f\u5ea6\u3002\u6b65\u9aa42\uff1a\u660e\u667a\u5730\u4f7f\u7528\u8df3\u8fc7\u529f\u80fd\u4ee5\u907f\u514d\u6263\u5206\u3002\u6b65\u9aa43\uff1a\u5206\u6790\u8fc7\u53bb\u7684\u95ee\u9898\u4ee5\u6539\u8fdb\u4eca\u540e\u7684\u8868\u73b0\u3002\u8fd9\u79cd\u65b9\u6cd5\u80fd\u5e2e\u52a9\u4f60\u6301\u7eed\u83b7\u5f97\u66f4\u9ad8\u7684\u5206\u6570\u3002"}, {"question": "\u300a\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c\u300b\u4e2d\u54ea\u4e9b\u9690\u85cf\u673a\u5236\u662f\u5927\u591a\u6570\u73a9\u5bb6\u5ffd\u7565\u7684\uff1f", "answer": "\u300a\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c\u300b\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u7684\u673a\u5236\uff0c\u53ef\u80fd\u4f1a\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\u3002\u4e00\u4e2a\u4f8b\u5b50\u662f\u4f7f\u7528\u58f0\u97f3\u63d0\u793a\uff1b\u67d0\u4e9b\u95ee\u9898\u53ef\u80fd\u5305\u542b\u97f3\u9891\u63d0\u793a\uff0c\u6307\u5bfc\u6b63\u786e\u7684\u7b54\u6848\u3002\u53e6\u4e00\u79cd\u673a\u5236\u662f\u70b9\u51fb\u65f6\u95f4\uff1b\u67d0\u4e9b\u95ee\u9898\u9700\u8981\u7cbe\u786e\u7684\u65f6\u95f4\u63a7\u5236\u624d\u80fd\u6210\u529f\u3002\u4f8b\u5982\uff0c\u4e00\u4e2a\u95ee\u9898\u53ef\u80fd\u4f1a\u8981\u6c42\u4f60\u5728\u7279\u5b9a\u58f0\u97f3\u64ad\u653e\u65f6\u70b9\u51fb\u3002\u6ce8\u610f\u8fd9\u4e9b\u7ec6\u5fae\u7684\u7ec6\u8282\u53ef\u4ee5\u8ba9\u4f60\u9886\u5148\u3002\u6b65\u9aa41\uff1a\u4ed4\u7ec6\u8046\u542c\u97f3\u9891\u63d0\u793a\u3002\u6b65\u9aa42\uff1a\u7ec3\u4e60\u51c6\u786e\u70b9\u51fb\u65f6\u95f4\u3002\u6b65\u9aa43\uff1a\u4ed4\u7ec6\u89c2\u5bdf\u89c6\u89c9\u548c\u542c\u89c9\u6a21\u5f0f\u3002\u638c\u63e1\u8fd9\u4e9b\u673a\u5236\u5c06\u589e\u5f3a\u4f60\u7684\u6574\u4f53\u8868\u73b0\u3002"}, {"question": "\u5982\u4f55\u89e3\u7801\u300a\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c\u300b\u4e2d\u7684\u795e\u79d8\u4fe1\u606f\uff1f", "answer": "\u300a\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c\u300b\u4e2d\u7684\u795e\u79d8\u4fe1\u606f\u901a\u5e38\u9700\u8981\u89e3\u7801\u6216\u6a21\u5f0f\u8bc6\u522b\u3002\u9996\u5148\uff0c\u5206\u6790\u6587\u672c\u4ee5\u8bc6\u522b\u9690\u85cf\u7684\u542b\u4e49\u6216\u6587\u5b57\u6e38\u620f\u3002\u4f8b\u5982\uff0c\u4e00\u4e2a\u95ee\u9898\u53ef\u80fd\u4f1a\u4f7f\u7528\u5b57\u6bcd\u91cd\u6392\u6216\u53cc\u5173\u8bed\u6765\u63a9\u76d6\u6b63\u786e\u7684\u7b54\u6848\u3002\u6b65\u9aa41\uff1a\u5c06\u4fe1\u606f\u5206\u89e3\u6210\u8f83\u5c0f\u7684\u90e8\u5206\u4ee5\u8bc6\u522b\u6a21\u5f0f\u3002\u6b65\u9aa42\uff1a\u67e5\u627e\u63aa\u8f9e\u6216\u683c\u5f0f\u4e2d\u7684\u7ebf\u7d22\u3002\u6b65\u9aa43\uff1a\u901a\u8fc7\u70b9\u51fb\u76f8\u5173\u5143\u7d20\u6765\u6d4b\u8bd5\u6f5c\u5728\u89e3\u51b3\u65b9\u6848\u3002\u8fd9\u79cd\u6709\u6761\u7406\u7684\u65b9\u6cd5\u5c06\u5e2e\u52a9\u4f60\u6709\u6548\u5730\u89e3\u5f00\u6e38\u620f\u7684\u8c1c\u9898\u3002"}, {"question": "\u65b0\u73a9\u5bb6\u5728\u300a\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c\u300b\u4e2d\u6700\u5e38\u89c1\u7684\u9519\u8bef\u662f\u4ec0\u4e48\uff1f", "answer": "\u65b0\u73a9\u5bb6\u7ecf\u5e38\u72af\u7684\u9519\u8bef\u662f\u5306\u5306\u5fd9\u5fd9\u5730\u56de\u7b54\u95ee\u9898\u6216\u8fc7\u5ea6\u601d\u8003\u3002\u4f8b\u5982\uff0c\u4e00\u4e2a\u5e38\u89c1\u7684\u9519\u8bef\u662f\u8fc7\u5feb\u5730\u70b9\u51fb\u770b\u8d77\u6765\u660e\u663e\u7684\u7b54\u6848\uff0c\u5374\u610f\u8bc6\u5230\u8fd9\u662f\u4e00\u4e2a\u9677\u9631\u95ee\u9898\u3002\u53e6\u4e00\u4e2a\u9519\u8bef\u662f\u4e0d\u6ce8\u610f\u63aa\u8f9e\u6216\u89c6\u89c9\u4e2d\u7684\u7ec6\u5fae\u6697\u793a\u3002\u4e3a\u4e86\u907f\u514d\u8fd9\u4e9b\u9677\u9631\uff0c\u8bf7\u82b1\u65f6\u95f4\u4ed4\u7ec6\u9605\u8bfb\u6bcf\u4e2a\u95ee\u9898\uff0c\u5e76\u8003\u8651\u6240\u6709\u53ef\u80fd\u7684\u89e3\u91ca\u3002\u6b65\u9aa41\uff1a\u653e\u6162\u901f\u5ea6\u5e76\u4ed4\u7ec6\u9605\u8bfb\u3002\u6b65\u9aa42\uff1a\u5bfb\u627e\u9690\u85cf\u7684\u7ebf\u7d22\u6216\u6587\u5b57\u6e38\u620f\u3002\u6b65\u9aa43\uff1a\u5728\u70b9\u51fb\u4e4b\u524d\u6d4b\u8bd5\u4f60\u7684\u7406\u89e3\u3002\u8fd9\u79cd\u65b9\u6cd5\u53ef\u4ee5\u51cf\u5c11\u9519\u8bef\u5e76\u63d0\u9ad8\u51c6\u786e\u6027\u3002"}, {"question": "\u300a\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c\u300b\u7684\u96be\u5ea6\u66f2\u7ebf\u5982\u4f55\u5f71\u54cd\u73a9\u5bb6\u7684\u8fdb\u6b65\uff1f", "answer": "\u300a\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c\u300b\u7684\u96be\u5ea6\u66f2\u7ebf\u65e8\u5728\u9010\u6e10\u589e\u52a0\uff0c\u8ba9\u73a9\u5bb6\u5728\u8fdb\u6b65\u7684\u8fc7\u7a0b\u4e2d\u9762\u4e34\u6311\u6218\u3002\u65e9\u671f\u95ee\u9898\u6bd4\u8f83\u7b80\u5355\uff0c\u5e2e\u52a9\u73a9\u5bb6\u5b66\u4e60\u6e38\u620f\u7684\u673a\u5236\uff0c\u800c\u540e\u671f\u95ee\u9898\u5219\u5f15\u5165\u4e86\u66f4\u590d\u6742\u7684\u6280\u5de7\u548c\u8c1c\u9898\u3002\u4f8b\u5982\uff0c\u65b0\u624b\u53ef\u80fd\u4f1a\u9762\u4e34\u7b80\u5355\u7684\u591a\u9879\u9009\u62e9\u9898\uff0c\u800c\u9ad8\u7ea7\u73a9\u5bb6\u5219\u4f1a\u9047\u5230\u8c1c\u8bed\u6216\u8ba1\u65f6\u6311\u6218\u3002\u8fd9\u79cd\u8fdb\u6b65\u8ba9\u6e38\u620f\u4fdd\u6301\u5438\u5f15\u529b\uff0c\u4f46\u5bf9\u4e8e\u51c6\u5907\u4e0d\u8db3\u7684\u73a9\u5bb6\u6765\u8bf4\u53ef\u80fd\u4f1a\u4ee4\u4eba\u6cae\u4e27\u3002\u6b65\u9aa41\uff1a\u5728\u65e9\u671f\u5173\u5361\u638c\u63e1\u57fa\u7840\u77e5\u8bc6\u3002\u6b65\u9aa42\uff1a\u9884\u6d4b\u548c\u9002\u5e94\u65e5\u76ca\u589e\u52a0\u7684\u590d\u6742\u6027\u3002\u6b65\u9aa43\uff1a\u4fdd\u6301\u8010\u5fc3\u548c\u6bc5\u529b\u3002\u7406\u89e3\u8fd9\u79cd\u66f2\u7ebf\u5c06\u5e2e\u52a9\u4f60\u63a7\u5236\u9884\u671f\u5e76\u7a33\u6b65\u63d0\u9ad8\u3002"}, {"question": "\u300a\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c\u300b\u4e2d\u9690\u85cf\u5f69\u86cb\u7684\u610f\u4e49\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c\u300b\u4e2d\u7684\u9690\u85cf\u5f69\u86cb\u4e3a\u73a9\u5bb6\u589e\u6dfb\u4e86\u989d\u5916\u7684\u4e50\u8da3\u548c\u6311\u6218\u3002\u8fd9\u4e9b\u5f69\u86cb\u901a\u5e38\u4f1a\u5956\u52b1\u521b\u9020\u6027\u601d\u7ef4\u6216\u63a2\u7d22\u3002\u4f8b\u5982\uff0c\u70b9\u51fb\u5c4f\u5e55\u4e0a\u770b\u4f3c\u65e0\u5173\u7684\u533a\u57df\u53ef\u80fd\u4f1a\u63ed\u793a\u79d8\u5bc6\u4fe1\u606f\u6216\u989d\u5916\u5956\u52b1\u3002\u53d1\u73b0\u8fd9\u4e9b\u5143\u7d20\u9700\u8981\u597d\u5947\u5fc3\u548c\u7ec6\u81f4\u7684\u89c2\u5bdf\u529b\u3002\u6b65\u9aa41\uff1a\u5c1d\u8bd5\u70b9\u51fb\u4e0d\u5bfb\u5e38\u7684\u533a\u57df\u3002\u6b65\u9aa42\uff1a\u5bfb\u627e\u89c6\u89c9\u6216\u6587\u5b57\u5f02\u5e38\u3002\u6b65\u9aa43\uff1a\u4e0e\u793e\u533a\u5206\u4eab\u4f60\u7684\u53d1\u73b0\u3002\u8fd9\u4e9b\u5f69\u86cb\u589e\u5f3a\u4e86\u6e38\u620f\u7684\u91cd\u73a9\u4ef7\u503c\uff0c\u5e76\u5e26\u6765\u6210\u5c31\u611f\u3002"}]
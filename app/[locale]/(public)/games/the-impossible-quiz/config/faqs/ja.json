[{"question": "\u4e0d\u53ef\u80fd\u30af\u30a4\u30ba\u3067\u53cd\u5fdc\u6642\u9593\u3092\u3069\u306e\u3088\u3046\u306b\u6539\u5584\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u4e0d\u53ef\u80fd\u30af\u30a4\u30ba\u3067\u53cd\u5fdc\u6642\u9593\u3092\u6539\u5584\u3059\u308b\u306b\u306f\u3001\u7df4\u7fd2\u3068\u554f\u984c\u30d1\u30bf\u30fc\u30f3\u306e\u7406\u89e3\u304c\u5fc5\u8981\u3067\u3059\u3002\u307e\u305a\u3001\u30b2\u30fc\u30e0\u3092\u5b9a\u671f\u7684\u306b\u30d7\u30ec\u30a4\u3057\u3066\u3001\u51fa\u984c\u3055\u308c\u308b\u554f\u984c\u306e\u7a2e\u985e\u306b\u6163\u308c\u308b\u3053\u3068\u304b\u3089\u59cb\u3081\u307e\u3057\u3087\u3046\u3002\u30c8\u30ea\u30c3\u30af\u554f\u984c\u3084\u8996\u899a\u7684\u306a\u624b\u304c\u304b\u308a\u3092\u8fc5\u901f\u306b\u8a8d\u8b58\u3059\u308b\u3053\u3068\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u7279\u5b9a\u306e\u5358\u8a9e\u3092\u30af\u30ea\u30c3\u30af\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u554f\u984c\u3067\u306f\u3001\u30c6\u30ad\u30b9\u30c8\u3092\u7d20\u65e9\u304f\u30b9\u30ad\u30e3\u30f3\u3059\u308b\u7df4\u7fd2\u3092\u3057\u307e\u3057\u3087\u3046\u3002\u3055\u3089\u306b\u3001\u90aa\u9b54\u306b\u306a\u308b\u3082\u306e\u3092\u6700\u5c0f\u9650\u306b\u3057\u3001\u30c7\u30d0\u30a4\u30b9\u304c\u30b9\u30e0\u30fc\u30ba\u306b\u52d5\u4f5c\u3059\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6bce\u65e5\u30d7\u30ec\u30a4\u3057\u3066\u7b4b\u8089\u8a18\u61b6\u3092\u69cb\u7bc9\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u904e\u53bb\u306e\u8cea\u554f\u3092\u5206\u6790\u3057\u3066\u30c8\u30ea\u30c3\u30af\u3092\u4e88\u6e2c\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u8fc5\u901f\u306a\u53cd\u5fdc\u306e\u305f\u3081\u306b\u74b0\u5883\u3092\u6700\u9069\u5316\u3059\u308b\u3002\u3053\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u306b\u3088\u308a\u3001\u3088\u308a\u901f\u304f\u3001\u3088\u308a\u6b63\u78ba\u306b\u53cd\u5fdc\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002"}, {"question": "\u4e0d\u53ef\u80fd\u30af\u30a4\u30ba\u306e\u30c8\u30ea\u30c3\u30af\u554f\u984c\u3092\u89e3\u6c7a\u3059\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u4e0d\u53ef\u80fd\u30af\u30a4\u30ba\u306e\u30c8\u30ea\u30c3\u30af\u554f\u984c\u306f\u3001\u3057\u3070\u3057\u3070\u767a\u60f3\u529b\u3092\u5fc5\u8981\u3068\u3057\u307e\u3059\u3002\u4ee5\u4e0b\u304c\u624b\u9806\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u554f\u984c\u6587\u3092\u6ce8\u610f\u6df1\u304f\u8aad\u307f\u3001\u8a00\u8449\u9063\u3044\u3084\u8996\u899a\u7684\u306a\u8a73\u7d30\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u76ae\u8089\u3084\u4e8c\u91cd\u306e\u610f\u5473\u306a\u3069\u3001\u5fae\u5999\u306a\u30d2\u30f3\u30c8\u3084\u8a00\u8449\u904a\u3073\u3092\u63a2\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u300c\u30d5\u30e9\u30f3\u30b9\u306e\u9996\u90fd\u306f\u4f55\u3067\u3059\u304b\uff1f\u300d\u3068\u3044\u3046\u8cea\u554f\u3067\u3059\u304c\u3001\u305d\u306e\u7b54\u3048\u306f\u300c\u30d1\u30ea\u300d\u3067\u306f\u306a\u304f\u3001\u8a00\u8449\u904a\u3073\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u884c\u304d\u8a70\u307e\u3063\u305f\u5834\u5408\u306f\u3001\u554f\u984c\u6587\u3084\u80cc\u666f\u306a\u3069\u3001\u4e88\u60f3\u5916\u306e\u8981\u7d20\u3092\u30af\u30ea\u30c3\u30af\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u5f93\u6765\u306e\u7b54\u3048\u304c\u9069\u7528\u3055\u308c\u306a\u3044\u3053\u3068\u3092\u5e38\u306b\u899a\u3048\u3066\u304a\u3044\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u306e\u65b9\u6cd5\u3067\u3001\u30b2\u30fc\u30e0\u56fa\u6709\u306e\u8ab2\u984c\u3092\u52b9\u679c\u7684\u306b\u514b\u670d\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u4e0d\u53ef\u80fd\u30af\u30a4\u30ba\u306b\u5bfe\u5fdc\u3057\u3066\u3044\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306f\u4f55\u304b\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u4e92\u63db\u6027\u306f\u3042\u308b\u304b\uff1f", "answer": "\u4e0d\u53ef\u80fd\u30af\u30a4\u30ba\u306f\u4e3b\u306b\u30a6\u30a7\u30d6\u30d6\u30e9\u30a6\u30b6\u3068\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u3067\u5229\u7528\u53ef\u80fd\u3067\u3059\u3002\u4e21\u65b9\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059\u304c\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u4e92\u63db\u6027\u3084\u30c7\u30fc\u30bf\u79fb\u884c\u6a5f\u80fd\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u3064\u307e\u308a\u3001\u3042\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u9032\u3081\u305f\u3082\u306e\u306f\u3001\u5225\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u79fb\u884c\u3067\u304d\u307e\u305b\u3093\u3002\u4f8b\u3048\u3070\u3001\u30d6\u30e9\u30a6\u30b6\u3067\u30d7\u30ec\u30a4\u3057\u3066\u3001\u30e2\u30d0\u30a4\u30eb\u30a2\u30d7\u30ea\u306b\u5207\u308a\u66ff\u3048\u308b\u3068\u3001\u6700\u521d\u304b\u3089\u3084\u308a\u76f4\u3059\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u9032\u6357\u72b6\u6cc1\u3092\u5931\u308f\u306a\u3044\u3088\u3046\u306b\u3001\u30b2\u30fc\u30e0\u306e\u7fd2\u6163\u306b\u5408\u3063\u305f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u306f\u3001\u983b\u7e41\u306b\u30c7\u30d0\u30a4\u30b9\u3092\u5207\u308a\u66ff\u3048\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u91cd\u8981\u306a\u8003\u616e\u4e8b\u9805\u3067\u3059\u3002"}, {"question": "\u4e0d\u53ef\u80fd\u30af\u30a4\u30ba\u306e\u3044\u304f\u3064\u304b\u306e\u554f\u984c\u306f\u3001\u306a\u305c\u7b54\u3048\u3089\u308c\u306a\u3044\u3088\u3046\u306b\u898b\u3048\u308b\u306e\u3067\u3059\u304b\uff1f", "answer": "\u4e0d\u53ef\u80fd\u30af\u30a4\u30ba\u306e\u3044\u304f\u3064\u304b\u306e\u554f\u984c\u306f\u3001\u610f\u56f3\u7684\u306b\u8aa4\u89e3\u3092\u62db\u3044\u305f\u308a\u3001\u975e\u5f93\u6765\u7684\u306a\u65b9\u6cd5\u3092\u63a1\u7528\u3057\u305f\u308a\u3059\u308b\u305f\u3081\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u8cea\u554f\u306f\u3001\u8a00\u8449\u904a\u3073\u3001\u8996\u899a\u7684\u306a\u30c8\u30ea\u30c3\u30af\u3001\u307e\u305f\u306f\u4e88\u671f\u3057\u306a\u3044\u8ad6\u7406\u306b\u4f9d\u5b58\u3057\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u7dd1\u8272\u306e\u30dc\u30bf\u30f3\u3092\u30af\u30ea\u30c3\u30af\u3057\u3066\u304f\u3060\u3055\u3044\u300d\u3068\u3044\u3046\u8cea\u554f\u3067\u3059\u304c\u3001\u30dc\u30bf\u30f3\u306f\u5b9f\u969b\u306b\u306f\u8d64\u8272\u3067\u3042\u308a\u3001\u7570\u306a\u308b\u8003\u3048\u65b9\u3092\u3059\u308b\u3053\u3068\u3092\u5f37\u5236\u3057\u307e\u3059\u3002\u3053\u306e\u30b2\u30fc\u30e0\u306e\u30af\u30ea\u30a8\u30a4\u30bf\u30fc\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u4eee\u5b9a\u306b\u6311\u6226\u3057\u3001\u5275\u9020\u7684\u306a\u554f\u984c\u89e3\u6c7a\u3092\u5968\u52b1\u3059\u308b\u3053\u3068\u3092\u76ee\u6307\u3057\u3066\u3044\u307e\u3059\u3002\u3053\u306e\u30c7\u30b6\u30a4\u30f3\u54f2\u5b66\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u305d\u306e\u3088\u3046\u306a\u8cea\u554f\u306b\u30aa\u30fc\u30d7\u30f3\u30de\u30a4\u30f3\u30c9\u3067\u9069\u5fdc\u7684\u306b\u5bfe\u51e6\u3057\u3001\u4e0d\u6e80\u3067\u306f\u306a\u304f\u3001\u3088\u308a\u697d\u3057\u3081\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002"}, {"question": "\u4e0d\u53ef\u80fd\u30af\u30a4\u30ba\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u3069\u306e\u3088\u3046\u306b\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u4e0d\u53ef\u80fd\u30af\u30a4\u30ba\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6b63\u89e3\u3068\u30b9\u30ad\u30c3\u30d7\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u5404\u6b63\u89e3\u306f\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u3001\u30b9\u30ad\u30c3\u30d7\u306f\u30dd\u30a4\u30f3\u30c8\u3092\u6e1b\u3089\u3057\u307e\u3059\u3002\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u30b9\u30d4\u30fc\u30c9\u3088\u308a\u3082\u6b63\u78ba\u6027\u3092\u91cd\u8996\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u554f\u984c\u306b\u81ea\u4fe1\u304c\u306a\u3044\u5834\u5408\u306f\u3001\u30b9\u30ad\u30c3\u30d7\u3092\u6226\u7565\u7684\u306b\u4f7f\u7528\u3057\u3066\u30dd\u30a4\u30f3\u30c8\u3092\u5931\u3046\u306e\u3092\u9632\u304e\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u554f\u984c\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u8a8d\u8b58\u3059\u308b\u7df4\u7fd2\u3092\u3057\u3066\u3001\u9593\u9055\u3044\u3092\u6e1b\u3089\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6b63\u78ba\u6027\u3092\u30b9\u30d4\u30fc\u30c9\u3088\u308a\u3082\u512a\u5148\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b9\u30ad\u30c3\u30d7\u3092\u8ce2\u304f\u4f7f\u3063\u3066\u30dd\u30a4\u30f3\u30c8\u6e1b\u5c11\u3092\u907f\u3051\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u904e\u53bb\u306e\u8cea\u554f\u3092\u5206\u6790\u3057\u3066\u5c06\u6765\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5411\u4e0a\u3055\u305b\u308b\u3002\u3053\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u306b\u3088\u308a\u3001\u5e38\u306b\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u9054\u6210\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u4e0d\u53ef\u80fd\u30af\u30a4\u30ba\u306b\u306f\u3001\u307b\u3068\u3093\u3069\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u898b\u843d\u3068\u3057\u3066\u3044\u308b\u96a0\u3055\u308c\u305f\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u4e0d\u53ef\u80fd\u30af\u30a4\u30ba\u306b\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u3044\u304f\u3064\u304b\u306e\u96a0\u3055\u308c\u305f\u30e1\u30ab\u30cb\u30ba\u30e0\u304c\u3042\u308a\u307e\u3059\u3002\u305d\u306e\u4e00\u3064\u306f\u97f3\u306e\u30d2\u30f3\u30c8\u3067\u3059\u3002\u7279\u5b9a\u306e\u554f\u984c\u306b\u306f\u3001\u6b63\u3057\u3044\u7b54\u3048\u3092\u5c0e\u304f\u30aa\u30fc\u30c7\u30a3\u30aa\u30d2\u30f3\u30c8\u304c\u3042\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u3082\u3046\u4e00\u3064\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u30af\u30ea\u30c3\u30af\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u3059\u3002\u3044\u304f\u3064\u304b\u306e\u554f\u984c\u306f\u3001\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u30af\u30ea\u30c3\u30af\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u7279\u5b9a\u306e\u97f3\u304c\u51fa\u305f\u3068\u304d\u306b\u30af\u30ea\u30c3\u30af\u3059\u308b\u3088\u3046\u306b\u6307\u793a\u3055\u308c\u308b\u554f\u984c\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u5fae\u5999\u306a\u8a73\u7d30\u306b\u6ce8\u610f\u3059\u308b\u3053\u3068\u3067\u3001\u512a\u4f4d\u6027\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30aa\u30fc\u30c7\u30a3\u30aa\u30d2\u30f3\u30c8\u306b\u6ce8\u610f\u6df1\u304f\u8033\u3092\u50be\u3051\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6b63\u78ba\u306b\u30af\u30ea\u30c3\u30af\u3059\u308b\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u7df4\u7fd2\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u8996\u899a\u7684\u304a\u3088\u3073\u8074\u899a\u7684\u30d1\u30bf\u30fc\u30f3\u3092\u6ce8\u610f\u6df1\u304f\u89b3\u5bdf\u3059\u308b\u3002\u3053\u308c\u3089\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u3067\u3001\u5168\u4f53\u7684\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002"}, {"question": "\u4e0d\u53ef\u80fd\u30af\u30a4\u30ba\u306e\u6697\u53f7\u30e1\u30c3\u30bb\u30fc\u30b8\u3092\u3069\u306e\u3088\u3046\u306b\u89e3\u8aad\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u4e0d\u53ef\u80fd\u30af\u30a4\u30ba\u306e\u6697\u53f7\u30e1\u30c3\u30bb\u30fc\u30b8\u306f\u3001\u3057\u3070\u3057\u3070\u89e3\u8aad\u307e\u305f\u306f\u30d1\u30bf\u30fc\u30f3\u8a8d\u8b58\u3092\u5fc5\u8981\u3068\u3057\u307e\u3059\u3002\u96a0\u3055\u308c\u305f\u610f\u5473\u3084\u8a00\u8449\u904a\u3073\u3092\u63a2\u3057\u3066\u30c6\u30ad\u30b9\u30c8\u3092\u5206\u6790\u3059\u308b\u3053\u3068\u304b\u3089\u59cb\u3081\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u8cea\u554f\u306f\u3001\u30a2\u30ca\u30b0\u30e9\u30e0\u3084\u30b7\u30e3\u30ec\u3092\u4f7f\u3063\u3066\u3001\u6b63\u89e3\u3092\u96a0\u3057\u3066\u3044\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30e1\u30c3\u30bb\u30fc\u30b8\u3092\u5c0f\u3055\u306a\u90e8\u5206\u306b\u5206\u89e3\u3057\u3066\u30d1\u30bf\u30fc\u30f3\u3092\u898b\u3064\u3051\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u8a00\u8449\u9063\u3044\u3084\u66f8\u5f0f\u3067\u30d2\u30f3\u30c8\u3092\u63a2\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u95a2\u9023\u3059\u308b\u8981\u7d20\u3092\u30af\u30ea\u30c3\u30af\u3059\u308b\u3053\u3068\u3067\u3001\u6f5c\u5728\u7684\u306a\u89e3\u6c7a\u7b56\u3092\u30c6\u30b9\u30c8\u3059\u308b\u3002\u3053\u306e\u65b9\u6cd5\u7684\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u306b\u3088\u308a\u3001\u30b2\u30fc\u30e0\u306e\u8b0e\u3092\u52b9\u679c\u7684\u306b\u89e3\u304d\u660e\u304b\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u4e0d\u53ef\u80fd\u30af\u30a4\u30ba\u3067\u3001\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u6700\u3082\u4e00\u822c\u7684\u306a\u9593\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u554f\u984c\u3092\u6025\u3044\u3060\u308a\u3001\u8003\u3048\u3059\u304e\u305f\u308a\u3059\u308b\u3053\u3068\u3067\u3001\u9593\u9055\u3044\u3092\u72af\u3057\u304c\u3061\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u3088\u304f\u3042\u308b\u9593\u9055\u3044\u306f\u3001\u660e\u3089\u304b\u306a\u7b54\u3048\u306e\u3088\u3046\u306b\u601d\u3048\u308b\u3082\u306e\u3092\u3059\u3050\u306b\u30af\u30ea\u30c3\u30af\u3057\u3001\u305d\u308c\u304c\u30c8\u30ea\u30c3\u30af\u554f\u984c\u3067\u3042\u308b\u3053\u3068\u306b\u6c17\u3065\u304d\u307e\u3057\u305f\u3002\u307e\u305f\u3001\u8a00\u8449\u9063\u3044\u3084\u8996\u899a\u7684\u306a\u5fae\u5999\u306a\u30d2\u30f3\u30c8\u3092\u7121\u8996\u3059\u308b\u3053\u3068\u3082\u9593\u9055\u3044\u3067\u3059\u3002\u3053\u308c\u3089\u306e\u843d\u3068\u3057\u7a74\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u3001\u5404\u8cea\u554f\u3092\u6ce8\u610f\u6df1\u304f\u8aad\u307f\u3001\u3059\u3079\u3066\u306e\u53ef\u80fd\u6027\u306e\u3042\u308b\u89e3\u91c8\u3092\u691c\u8a0e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b9\u30d4\u30fc\u30c9\u3092\u843d\u3068\u3059\u3001\u5341\u5206\u306b\u8aad\u307f\u8fbc\u3080\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u96a0\u3055\u308c\u305f\u30d2\u30f3\u30c8\u307e\u305f\u306f\u8a00\u8449\u904a\u3073\u3092\u63a2\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30af\u30ea\u30c3\u30af\u3059\u308b\u524d\u306b\u7406\u89e3\u3092\u30c6\u30b9\u30c8\u3059\u308b\u3002\u3053\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u306b\u3088\u308a\u3001\u30a8\u30e9\u30fc\u3092\u6e1b\u3089\u3057\u3001\u6b63\u78ba\u6027\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002"}, {"question": "\u4e0d\u53ef\u80fd\u30af\u30a4\u30ba\u306e\u96e3\u6613\u5ea6\u66f2\u7dda\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u9032\u884c\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u4e0d\u53ef\u80fd\u30af\u30a4\u30ba\u306e\u96e3\u6613\u5ea6\u66f2\u7dda\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u9032\u884c\u3059\u308b\u306b\u3064\u308c\u3066\u5f90\u3005\u306b\u5897\u52a0\u3059\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u521d\u671f\u306e\u554f\u984c\u306f\u7c21\u5358\u3067\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30b2\u30fc\u30e0\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u5b66\u3076\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u4e00\u65b9\u3001\u5f8c\u306e\u554f\u984c\u3067\u306f\u3001\u3088\u308a\u8907\u96d1\u306a\u30c8\u30ea\u30c3\u30af\u3084\u30d1\u30ba\u30eb\u304c\u767b\u5834\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u521d\u5fc3\u8005\u306a\u3089\u3001\u7c21\u5358\u306a\u8907\u6570\u9078\u629e\u5f0f\u306e\u554f\u984c\u306b\u76f4\u9762\u3057\u307e\u3059\u304c\u3001\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u8b0e\u3084\u6642\u9593\u5236\u9650\u306e\u3042\u308b\u8ab2\u984c\u306b\u76f4\u9762\u3057\u307e\u3059\u3002\u3053\u306e\u9032\u884c\u306b\u3088\u308a\u3001\u30b2\u30fc\u30e0\u306f\u9b45\u529b\u7684\u3067\u3059\u304c\u3001\u6e96\u5099\u4e0d\u8db3\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u4e0d\u6e80\u3067\u3042\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u521d\u671f\u30ec\u30d9\u30eb\u3067\u57fa\u672c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5897\u52a0\u3059\u308b\u8907\u96d1\u3055\u306b\u5bfe\u5fdc\u3057\u3066\u3001\u4e88\u6e2c\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u8f9b\u62b1\u5f37\u304f\u3001\u7c98\u308a\u5f37\u304f\u7d9a\u3051\u308b\u3002\u3053\u306e\u66f2\u7dda\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u671f\u5f85\u5024\u3092\u7ba1\u7406\u3057\u3001\u7740\u5b9f\u306b\u6539\u5584\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u4e0d\u53ef\u80fd\u30af\u30a4\u30ba\u306e\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3001\u3069\u306e\u3088\u3046\u306a\u610f\u5473\u3092\u6301\u3061\u307e\u3059\u304b\uff1f", "answer": "\u4e0d\u53ef\u80fd\u30af\u30a4\u30ba\u306e\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u305f\u3081\u306b\u3055\u3089\u306b\u697d\u3057\u304f\u6311\u6226\u7684\u306a\u8981\u7d20\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3001\u5275\u9020\u7684\u306a\u601d\u8003\u3084\u63a2\u6c42\u3092\u5831\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u753b\u9762\u4e0a\u306e\u95a2\u9023\u6027\u304c\u306a\u3044\u3088\u3046\u306b\u898b\u3048\u308b\u90e8\u5206\u3092\u30af\u30ea\u30c3\u30af\u3059\u308b\u3068\u3001\u79d8\u5bc6\u306e\u30e1\u30c3\u30bb\u30fc\u30b8\u3084\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u304c\u73fe\u308c\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u8981\u7d20\u3092\u767a\u898b\u3059\u308b\u305f\u3081\u306b\u306f\u3001\u597d\u5947\u5fc3\u3068\u7d30\u90e8\u306b\u6ce8\u610f\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u901a\u5e38\u306e\u9818\u57df\u4ee5\u5916\u3092\u30af\u30ea\u30c3\u30af\u3057\u3066\u307f\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u8996\u899a\u7684\u307e\u305f\u306f\u30c6\u30ad\u30b9\u30c8\u4e0a\u306e\u7570\u5e38\u3092\u63a2\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u3068\u3042\u306a\u305f\u306e\u767a\u898b\u3092\u5171\u6709\u3059\u308b\u3002\u3053\u308c\u3089\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306b\u3088\u308a\u3001\u30b2\u30fc\u30e0\u306e\u518d\u30d7\u30ec\u30a4\u4fa1\u5024\u304c\u9ad8\u307e\u308a\u3001\u9054\u6210\u611f\u304c\u3042\u308a\u307e\u3059\u3002"}]
[{"question": "Google\u91ce\u7403\u306e\u57fa\u672c\uff1a\u521d\u5fc3\u8005\u3068\u3057\u3066\u3069\u306e\u3088\u3046\u306b\u30dc\u30fc\u30eb\u3092\u3046\u307e\u304f\u6253\u3066\u308b\u3088\u3046\u306b\u306a\u308a\u3001\u4e00\u8cab\u3057\u3066\u30b3\u30f3\u30bf\u30af\u30c8\u3092\u6210\u529f\u3055\u305b\u308b\u6700\u3082\u7c21\u5358\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Google\u91ce\u7403\u306e\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001\u4e00\u8cab\u3057\u3066\u30dc\u30fc\u30eb\u3092\u6253\u3064\u3053\u3068\u306f\u91cd\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30bf\u30a4\u30df\u30f3\u30b0\u306b\u96c6\u4e2d\u3057\u3001\u30dc\u30fc\u30eb\u304c\u30d7\u30ec\u30fc\u30c8\u306b\u8fd1\u3044\u3068\u3053\u308d\u3067\u5f85\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u69cb\u3048\u3067\u3001\u91cd\u5fc3\u304c\u5747\u7b49\u306b\u306a\u308b\u3088\u3046\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b9\u30e0\u30fc\u30ba\u3067\u5236\u5fa1\u3055\u308c\u305f\u52d5\u304d\u3067\u632f\u308b\u3044\u3001\u30dc\u30fc\u30eb\u3092\u6b63\u3057\u304f\u30d2\u30c3\u30c8\u3059\u308b\u3088\u3046\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u30e2\u30fc\u30c9\u3067\u6163\u308c\u3066\u304d\u305f\u3089\u3001\u7df4\u7fd2\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30d0\u30c3\u30c6\u30a3\u30f3\u30b0\u30a2\u30d9\u30ec\u30fc\u30b8\u3092\u4e0a\u3052\u308b\u305f\u3081\u306b\u3001\u30e9\u30a4\u30ca\u30fc\u30d2\u30c3\u30c8\u306b\u96c6\u4e2d\u3059\u308b\u3053\u3068\u304c\u3001\u826f\u3044\u30b9\u30bf\u30fc\u30c8\u6226\u7565\u3067\u3059\u3002\u81ea\u8ee2\u8eca\u306b\u4e57\u308b\u3053\u3068\u3092\u5b66\u3076\u306e\u3068\u540c\u3058\u3067\u3059\u3002\u7df4\u7fd2\u304c\u5fc5\u8981\u3067\u3059\u3001\u3057\u304b\u3057\u3001\u6163\u308c\u3066\u304d\u307e\u3059\uff01"}, {"question": "Google\u91ce\u7403\uff1a\u3069\u306e\u3088\u3046\u306a\u7a2e\u985e\u306e\u30d4\u30c3\u30c1\u3092\u6295\u3052\u308b\u4e8b\u304c\u3067\u304d\u307e\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u521d\u671f\u306e\u4e09\u632f\u306b\u6700\u3082\u52b9\u679c\u7684\u306a\u3082\u306e\u306f\u3069\u308c\u3067\u3059\u304b\uff1f", "answer": "Google\u91ce\u7403\u3067\u306f\u3001\u901f\u7403\u3001\u30ab\u30fc\u30d6\u3001\u5909\u5316\u7403\u306a\u3069\u3001\u3044\u304f\u3064\u304b\u306e\u30d4\u30c3\u30c1\u306e\u7a2e\u985e\u304c\u3042\u308a\u307e\u3059\u3002\u521d\u671f\u306e\u4e09\u632f\u306b\u306f\u3001\u901f\u7403\u304c\u305d\u306e\u901f\u3055\u306b\u3088\u3063\u3066\u4fe1\u983c\u3067\u304d\u308b\u9078\u629e\u80a2\u3067\u3059\u3002\u305d\u306e\u5f8c\u3001\u5b8c\u5168\u306b\u6295\u3052\u3089\u308c\u305f\u30ab\u30fc\u30d6\u306f\u3001\u30d0\u30c3\u30bf\u30fc\u3092\u30d0\u30e9\u30f3\u30b9\u3092\u5d29\u3055\u305b\u308b\u306e\u306b\u975e\u5e38\u306b\u52b9\u679c\u7684\u3067\u3059\u3002\u6700\u9ad8\u306e\u6226\u7565\u306f\u3001\u30d4\u30c3\u30c1\u30e3\u30fc\u306e\u30b9\u30ad\u30eb\u3068\u5bfe\u6226\u76f8\u624b\u306e\u5f31\u307f\u306b\u4f9d\u5b58\u3059\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u3055\u307e\u3056\u307e\u306a\u30d4\u30c3\u30c1\u3092\u8a66\u3057\u3066\u3001\u81ea\u5206\u306b\u6700\u9069\u306a\u3082\u306e\u3092\u63a2\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u8a2d\u5b9a\u8868\uff1a\u901f\u7403 - \u9ad8\u901f\uff0f\u4f4e\u5909\u5316\u3001\u30ab\u30fc\u30d6 - \u4e2d\u901f\uff0f\u9ad8\u5909\u5316\u3001\u5909\u5316\u7403 - \u4f4e\u901f\uff0f\u4e2d\u5909\u5316"}, {"question": "\u30d3\u30ae\u30ca\u30fc\u5411\u3051Google\u91ce\u7403\uff1a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306e\u554f\u984c\u304c\u767a\u751f\u3057\u305f\u3068\u304d\u306b\u8abf\u6574\u3059\u308b\u6700\u3082\u91cd\u8981\u306a\u8a2d\u5b9a\u306f\u3069\u308c\u3067\u3059\u304b\uff1f\u305d\u308c\u3089\u306f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "Google\u91ce\u7403\u3067\u3088\u308a\u30b9\u30e0\u30fc\u30ba\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u305f\u3081\u306b\u3001\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u89e3\u50cf\u5ea6\u3068\u8a73\u7d30\u5ea6\u3092\u4e0b\u3052\u308b\u3053\u3068\u3067\u3001\u30c7\u30d0\u30a4\u30b9\u3078\u306e\u8ca0\u62c5\u3092\u5927\u5e45\u306b\u8efd\u6e1b\u3057\u307e\u3059\u3002\u30e9\u30b0\u304c\u767a\u751f\u3057\u3066\u3044\u308b\u5834\u5408\u306f\u3001\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u30a2\u30d7\u30ea\u30b1\u30fc\u30b7\u30e7\u30f3\u3092\u9589\u3058\u307e\u3059\u3002\u5f71\u3084\u30d1\u30fc\u30c6\u30a3\u30af\u30eb\u52b9\u679c\u3092\u30aa\u30d5\u306b\u3059\u308b\u3053\u3068\u3092\u8a66\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u306f\u3001\u7279\u306b\u53e4\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5411\u4e0a\u3055\u305b\u308b\u306f\u305a\u3067\u3059\u3002\u5f71\u306e\u30ec\u30f3\u30c0\u30ea\u30f3\u30b0\u3092\u5c11\u306a\u304f\u3057\u3001\u30a2\u30f3\u30c1\u30a8\u30a4\u30ea\u30a2\u30b7\u30f3\u30b0\u3092\u7121\u52b9\u306b\u3059\u308b\u3053\u3068\u3067\u3001\u30d5\u30ec\u30fc\u30e0\u30ec\u30fc\u30c8\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u3088\u308a\u9ad8\u901f\u5316\u3059\u308b\u305f\u3081\u306b\u8eca\u3092\u52b9\u7387\u5316\u3059\u308b\u3053\u3068\u3068\u540c\u3058\u3067\u3059\u3002\u4e0d\u8981\u306a\u91cd\u91cf\u3092\u6e1b\u3089\u3057\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002"}, {"question": "\u4e0a\u7d1aGoogle\u91ce\u7403\uff1a\u3069\u306e\u30d2\u30c3\u30c8\u30be\u30fc\u30f3\u304c\u6700\u9ad8\u306e\u5a01\u529b\u3068\u30b3\u30f3\u30bf\u30af\u30c8\u7387\u3092\u63d0\u4f9b\u3057\u307e\u3059\u304b\uff1f\u306a\u305c\u9ad8\u30ea\u30d5\u30ec\u30c3\u30b7\u30e5\u30ec\u30fc\u30c8\u306e\u30e2\u30cb\u30bf\u30fc\u3092\u4f7f\u3046\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "Google\u91ce\u7403\u3067\u306f\u3001\u6700\u9069\u306a\u30d2\u30c3\u30c8\u30be\u30fc\u30f3\u306f\u901a\u5e38\u3001\u30d0\u30c3\u30c8\u306e\u30b9\u30a4\u30fc\u30c8\u30b9\u30dd\u30c3\u30c8\u3067\u3059\u3002\u30be\u30fc\u30f3\u306e\u4e2d\u5fc3\u306b\u72d9\u3046\u3053\u3068\u3067\u3001\u5a01\u529b\u3068\u30b3\u30f3\u30bf\u30af\u30c8\u306e\u30d0\u30e9\u30f3\u30b9\u304c\u53d6\u308c\u307e\u3059\u3002\u9ad8\u89e3\u50cf\u5ea6/\u9ad8\u30ea\u30d5\u30ec\u30c3\u30b7\u30e5\u30ec\u30fc\u30c8\u306e\u30e2\u30cb\u30bf\u30fc\u306f\u3001\u8996\u899a\u7684\u306a\u9bae\u660e\u3055/\u5fdc\u7b54\u6642\u9593\u306e\u901f\u3055\u3092\u52a9\u3051\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u52d5\u304d\u306e\u901f\u3044\u901f\u7403\u3092\u6253\u3064\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u3053\u306e\u300c\u30b9\u30a4\u30fc\u30c8\u30b9\u30dd\u30c3\u30c8\u300d\u306b\u96c6\u4e2d\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u591a\u304f\u306e\u30d2\u30c3\u30c8\u3068\u30db\u30fc\u30e0\u30e9\u30f3\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002\u3053\u306e\u4f4d\u7f6e\u306f\u3001\u6700\u5927\u9650\u306e\u5a01\u529b\u3092\u767a\u63ee\u3057\u3001\u4e00\u8cab\u6027\u3092\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Google\u91ce\u7403\u306e\u6226\u7565\uff1a\u76d7\u5841\u3092\u8a66\u307f\u308b\u306e\u306b\u6700\u9069\u306a\u6642\u671f\u306f\u3044\u3064\u3067\u3059\u304b\uff1f\u30d4\u30c3\u30c1\u30e3\u30fc/\u30ad\u30e3\u30c3\u30c1\u30e3\u30fc\u306e\u7d71\u8a08\u306f\u3001\u76d7\u5841\u306e\u6210\u529f\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f\u30aa\u30f3\u30e9\u30a4\u30f3\u30d7\u30ec\u30a4\u3067\u5229\u7528\u53ef\u80fd\u306a\u305d\u306e\u4ed6\u306e\u5b88\u5099\u6226\u8853\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Google\u91ce\u7403\u3067\u76d7\u5841\u3092\u8a66\u307f\u308b\u6700\u9069\u306a\u6642\u671f\u306f\u3001\u30d4\u30c3\u30c1\u30e3\u30fc\u306e\u9001\u7403\u6642\u9593\u304c\u9045\u304f\u3001\u30ad\u30e3\u30c3\u30c1\u30e3\u30fc\u306e\u8155\u304c\u5f31\u3044\u3068\u304d\u3067\u3059\u3002\u8a66\u3059\u524d\u306b\u3001\u5f7c\u3089\u306e\u7d71\u8a08\u3092\u5206\u6790\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30d4\u30c3\u30c1\u30e3\u30fc\u306e\u50be\u5411\u3092\u89b3\u5bdf\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30ad\u30e3\u30c3\u30c1\u30e3\u30fc\u306e\u9001\u7403\u8155\u306e\u5f37\u3055\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b2\u30fc\u30e0\u72b6\u6cc1\uff08\u70b9\u6570\u3001\u30a2\u30a6\u30c8\u6570\u306a\u3069\uff09\u3092\u8003\u616e\u3057\u307e\u3059\u3002\u5b88\u5099\u6226\u8853\u306b\u306f\u3001\u5185\u91ce\u306e\u30b7\u30d5\u30c8\u3084\u3001\u30d0\u30c3\u30bf\u30fc\u306b\u5fdc\u3058\u3066\u5916\u91ce\u306e\u6df1\u3055\u3092\u8abf\u6574\u3059\u308b\u3053\u3068\u3082\u542b\u307e\u308c\u307e\u3059\u3002\u76d7\u5841\u306f\u3001\u6f5c\u5728\u7684\u306a\u30ea\u30ef\u30fc\u30c9\u3068\u6355\u307e\u308b\u30ea\u30b9\u30af\u3068\u3092\u5929\u79e4\u306b\u304b\u3051\u305f\u8a08\u7b97\u3055\u308c\u305f\u30ea\u30b9\u30af\u3067\u3042\u308b\u3068\u8003\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30ad\u30e3\u30c3\u30c1\u30e3\u30fc\u306e\u9001\u7403\u7cbe\u5ea6\u306f\u4f4e\u304f\u3001\u76d7\u5841\u306e\u6210\u529f\u78ba\u7387\u306f\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002"}, {"question": "Google\u91ce\u7403\uff1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u7d71\u8a08\u306f\u30b7\u30df\u30e5\u30ec\u30fc\u30b7\u30e7\u30f3\u306e\u7d50\u679c\u3084\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u9032\u884c\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u30b1\u30df\u30b9\u30c8\u30ea\u30fc\u306e\u91cd\u8981\u6027\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Google\u91ce\u7403\u306e\u30b7\u30df\u30e5\u30ec\u30fc\u30b7\u30e7\u30f3\u306e\u7d50\u679c\u306b\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u7d71\u8a08\u306f\u5927\u304d\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u7d71\u8a08\u304c\u9ad8\u3044\u307b\u3069\u3001\u5168\u4f53\u7684\u306b\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u304c\u826f\u3044\u50be\u5411\u304c\u3042\u308a\u307e\u3059\u3002\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u9032\u884c\u306f\u3001\u4e00\u8cab\u3057\u305f\u30d7\u30ec\u30a4\u3068\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u306b\u95a2\u9023\u4ed8\u3051\u3089\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5f31\u70b9\u3092\u91cd\u70b9\u7684\u306b\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u597d\u307f\u306e\u30dd\u30b8\u30b7\u30e7\u30f3\u3067\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u75b2\u52b4\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u3001\u30a8\u30cd\u30eb\u30ae\u30fc\u30ec\u30d9\u30eb\u3092\u76e3\u8996\u3057\u307e\u3059\u3002\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b1\u30df\u30b9\u30c8\u30ea\u30fc\u5f37\u5316\u306f\u3001\u30c1\u30fc\u30e0\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u5411\u4e0a\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u30c1\u30fc\u30e0\u30e1\u30f3\u30d0\u30fc\u306e\u30b1\u30df\u30b9\u30c8\u30ea\u30fc\u304c\u9ad8\u3051\u308c\u3070\u3001\u30c1\u30fc\u30e0\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u9855\u8457\u306a\u5909\u5316\u304c\u73fe\u308c\u308b\u3067\u3057\u3087\u3046\u3002"}, {"question": "Google\u91ce\u7403\u306e\u7d4c\u6e08\uff1a\u9577\u671f\u7684\u306a\u30c1\u30fc\u30e0\u958b\u767a\u306b\u6700\u3082\u6709\u76ca\u306a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u3069\u308c\u3067\u3059\u304b\uff1f\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u30c1\u30fc\u30e0\u306e\u4e88\u7b97\u3092\u52b9\u7387\u7684\u306b\u7ba1\u7406\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Google\u91ce\u7403\u3067\u3001\u30d2\u30c3\u30c8\u3001\u30d4\u30c3\u30c1\u30f3\u30b0\u3001\u5b88\u5099\u306a\u3069\u306e\u4e3b\u8981\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u7d71\u8a08\u3092\u5411\u4e0a\u3055\u305b\u308b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u4e88\u7b97\u3092\u52b9\u7387\u7684\u306b\u7ba1\u7406\u3059\u308b\u306b\u306f\u3001\u82e5\u3044\u624d\u80fd\u3092\u30b9\u30ab\u30a6\u30c8\u3057\u3001\u30d5\u30ea\u30fc\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u306e\u904e\u6255\u3044\uff08\u9ad8\u984d\u306a\u5951\u7d04\uff09\u3092\u907f\u3051\u308b\u3053\u3068\u3001\u305d\u3057\u3066\u30de\u30a4\u30ca\u30fc\u30ea\u30fc\u30b0\u30b7\u30b9\u30c6\u30e0\u3078\u306e\u6295\u8cc7\u304c\u5fc5\u8981\u3067\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u6301\u7d9a\u53ef\u80fd\u3067\u7af6\u4e89\u529b\u306e\u3042\u308b\u30c1\u30fc\u30e0\u3092\u9577\u671f\u9593\u306b\u308f\u305f\u308a\u69cb\u7bc9\u3067\u304d\u307e\u3059\u3002\u8cbb\u7528\u4fbf\u76ca\u5206\u6790\u306f\u3001\u6f5c\u5728\u7684\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u305d\u306e\u9ad8\u3044\u30b3\u30b9\u30c8\u306b\u898b\u5408\u3046\u304b\u3069\u3046\u304b\u3092\u5224\u65ad\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "Google\u91ce\u7403\u3068\u73fe\u5b9f\uff1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u8a55\u4fa1\u306f\u73fe\u5b9f\u306e\u91ce\u7403\u30b9\u30ad\u30eb\u3092\u3069\u306e\u7a0b\u5ea6\u6b63\u78ba\u306b\u53cd\u6620\u3057\u3066\u3044\u307e\u3059\u304b\uff1f\u30d4\u30c3\u30c1\u30f3\u30b0\u3068\u30d0\u30c3\u30c6\u30a3\u30f3\u30b0\u306e\u6210\u679c\u306e\u6839\u5e95\u306b\u3042\u308b\u8a08\u7b97\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Google\u91ce\u7403\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u8a55\u4fa1\u306f\u3001\u73fe\u5b9f\u4e16\u754c\u306e\u30b9\u30ad\u30eb\u3092\u8fd1\u4f3c\u3059\u308b\u610f\u56f3\u3067\u306f\u3042\u308a\u307e\u3059\u304c\u3001\u30b2\u30fc\u30e0\u30d0\u30e9\u30f3\u30b9\u3092\u8003\u616e\u3059\u308b\u70b9\u3067\u901a\u5e38\u7570\u306a\u308a\u307e\u3059\u3002\u30d4\u30c3\u30c1\u306e\u7d50\u679c\u306f\u3001\u30d4\u30c3\u30c1\u30e3\u30fc\u306e\u6b63\u78ba\u3055\u3068\u30d4\u30c3\u30c1\u306e\u7a2e\u985e\u306b\u5bfe\u3059\u308b\u30d0\u30c3\u30bf\u30fc\u306e\u30b9\u30ad\u30eb\u3092\u8003\u616e\u3057\u305f\u8907\u96d1\u306a\u8a08\u7b97\u3067\u3059\u3002\u30d0\u30c3\u30bf\u30fc\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u30b9\u30a6\u30a3\u30f3\u30b0\u306e\u5a01\u529b\u3082\u3001\u3053\u306e\u30d7\u30ed\u30bb\u30b9\u3067\u91cd\u8981\u306a\u5f79\u5272\u3092\u679c\u305f\u3057\u307e\u3059\u3002\u5185\u90e8\u7684\u306b\u306f\u30d6\u30e9\u30c3\u30af\u30dc\u30c3\u30af\u30b9\u3067\u3059\u304c\u3001\u305d\u306e\u5f0f\u306f\u78ba\u7387\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u30b2\u30fc\u30e0\u306b\u30ea\u30a2\u30ea\u30ba\u30e0\u3068\u4e88\u6e2c\u4e0d\u53ef\u80fd\u6027\u304c\u52a0\u308f\u308a\u307e\u3059\u3002"}, {"question": "Google\u91ce\u7403\u306e\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\uff1a\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\uff08Android/iOS\uff09\u9593\u3067\u30c1\u30fc\u30e0\u3068\u9032\u6357\u72b6\u6cc1\u306f\u5f15\u304d\u7d99\u304c\u308c\u307e\u3059\u304b\uff1f\u30b7\u30fc\u30e0\u30ec\u30b9\u306a\u30c7\u30fc\u30bf\u79fb\u884c\u3092\u4fdd\u8a3c\u3059\u308b\u305f\u3081\u306b\u5fc5\u8981\u306a\u624b\u9806\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Google\u91ce\u7403\u3067\u306f\u3001\u901a\u5e38\u3001Android\u3068iOS\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u30c7\u30fc\u30bf\u304c\u5f15\u304d\u7d99\u304c\u308c\u307e\u3059\u3002\u30b2\u30fc\u30e0\u3092Google\u30a2\u30ab\u30a6\u30f3\u30c8\u307e\u305f\u306f\u4ed6\u306e\u30b5\u30dd\u30fc\u30c8\u3055\u308c\u3066\u3044\u308b\u30a2\u30ab\u30a6\u30f3\u30c8\uff08\u4f8b\uff1aFacebook\uff09\u306b\u30ea\u30f3\u30af\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6b21\u306b\u3001\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3060\u3051\u3067\u3001\u9032\u6357\u72b6\u6cc1\u304c\u540c\u671f\u3055\u308c\u307e\u3059\u3002\u5177\u4f53\u7684\u306a\u65b9\u6cd5\u306f\u3001\u30d0\u30fc\u30b8\u30e7\u30f3\u306b\u3088\u3063\u3066\u591a\u5c11\u7570\u306a\u308a\u307e\u3059\u3002\u30c7\u30fc\u30bf\u8ee2\u9001\u304c\u6a5f\u80fd\u3057\u306a\u3044\u5834\u5408\u306f\u3001\u30b2\u30fc\u30e0\u306e\u9867\u5ba2\u30b5\u30dd\u30fc\u30c8\u30c1\u30fc\u30e0\u306b\u9023\u7d61\u3057\u3066\u3001\u305d\u3053\u3067\u652f\u63f4\u3092\u53d7\u3051\u3066\u304f\u3060\u3055\u3044\u3002\u30b7\u30fc\u30e0\u30ec\u30b9\u306a\u30c7\u30fc\u30bf\u79fb\u884c\u3092\u4fdd\u8a3c\u3059\u308b\u305f\u3081\u306b\u3001\u5b89\u5b9a\u3057\u305f\u30cd\u30c3\u30c8\u30ef\u30fc\u30af\u63a5\u7d9a\u3092\u6301\u3064\u3053\u3068\u3001\u304a\u3088\u3073\u5b9a\u671f\u7684\u306b\u9032\u6357\u72b6\u6cc1\u3092\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002"}, {"question": "Google\u91ce\u7403\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\uff1a\u96a0\u3055\u308c\u305f\u7403\u5834\u3084\u30a2\u30f3\u30ed\u30c3\u30af\u53ef\u80fd\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3044\u307e\u3059\u304b\uff1f\u9054\u6210\u3092\u6c42\u3081\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u305d\u308c\u3089\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u306e\u3067\u3059\u304b\uff1f", "answer": "Google\u91ce\u7403\u306b\u306f\u3001\u71b1\u5fc3\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u5831\u3044\u308b\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u4e00\u90e8\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3001\u7279\u5b9a\u306e\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3067\u767a\u751f\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30af\u30e9\u30b7\u30c3\u30af\u30b9\u30bf\u30b8\u30a2\u30e0\u30b9\u30ad\u30f3\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u306b\u306f\u3001\u6700\u9ad8\u96e3\u6613\u5ea6\u3067\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u30b7\u30c3\u30d7\u3092\u7372\u5f97\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u3053\u308c\u3089\u306e\u30dc\u30fc\u30ca\u30b9\u3092\u5f97\u308b\u306b\u306f\u3001\u30b2\u30fc\u30e0\u306b\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u3001\u304b\u306a\u308a\u7d99\u7d9a\u6027\u304c\u5fc5\u8981\u3067\u3042\u308a\u3001\u3053\u308c\u306f\u30e9\u30f3\u30c0\u30e0\u306a\u30c7\u30a4\u30ea\u30fc\u30ea\u30ef\u30fc\u30c9\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u307e\u3059\u3002\u30b2\u30fc\u30e0\u3092\u63a2\u6c42\u3057\u7d9a\u3051\u308b\u3068\u3001\u3053\u308c\u3089\u306e\u30dc\u30fc\u30ca\u30b9\u306b\u3064\u3044\u3066\u3088\u308a\u591a\u304f\u77e5\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u6df1\u304f\u63a2\u6c42\u3059\u308c\u3070\u3001\u7d20\u6674\u3089\u3057\u3044\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3092\u767a\u898b\u3067\u304d\u308b\u3067\u3057\u3087\u3046\u3002"}]
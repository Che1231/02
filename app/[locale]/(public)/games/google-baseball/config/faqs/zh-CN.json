[{"question": "\u8c37\u6b4c\u68d2\u7403\u57fa\u7840\uff1a\u65b0\u624b\u5982\u4f55\u6210\u529f\u51fb\u7403\uff0c\u4ee5\u53ca\u4ec0\u4e48\u6700\u7b80\u5355\u7684\u7b56\u7565\u80fd\u6301\u7eed\u51fb\u4e2d\u7403\uff1f", "answer": "\u5728\u8c37\u6b4c\u68d2\u7403\u65b0\u624b\u9636\u6bb5\uff0c\u6301\u7eed\u51fb\u4e2d\u7403\u81f3\u5173\u91cd\u8981\u3002\u6b65\u9aa4 1\uff1a\u4e13\u6ce8\u4e8e\u65f6\u673a\uff1b\u7b49\u5f85\u7403\u63a5\u8fd1\u7403\u677f\u3002\u6b65\u9aa4 2\uff1a\u4fdd\u6301\u5e73\u8861\u7684\u59ff\u52bf\uff0c\u786e\u4fdd\u4f53\u91cd\u5206\u5e03\u5747\u5300\u3002\u6b65\u9aa4 3\uff1a\u4ee5\u6d41\u7545\u3001\u63a7\u5236\u7684\u52a8\u4f5c\u6325\u68d2\uff0c\u76ee\u6807\u662f\u6b63\u9762\u5bf9\u51c6\u7403\u3002\u4f8b\u5982\uff0c\u5728\u8bad\u7ec3\u6a21\u5f0f\u4e2d\u7ec3\u4e60\u51fb\u7403\uff0c\u76f4\u5230\u4f60\u611f\u5230\u8212\u9002\u3002\u4e00\u4e2a\u597d\u7684\u5165\u95e8\u7b56\u7565\u662f\u4e13\u6ce8\u4e8e\u51fb\u51fa\u76f4\u7ebf\u7403\uff0c\u4ee5\u63d0\u9ad8\u4f60\u7684\u51fb\u7403\u7387\u3002\u8fd9\u5c31\u50cf\u5b66\u4e60\u9a91\u81ea\u884c\u8f66\u4e00\u6837\u2014\u2014\u9700\u8981\u7ec3\u4e60\uff0c\u4f46\u4f60\u4f1a\u638c\u63e1\u7684\uff01"}, {"question": "\u8c37\u6b4c\u68d2\u7403\uff1a\u6211\u80fd\u6295\u63b7\u54ea\u4e9b\u4e0d\u540c\u7c7b\u578b\u7684\u7403\uff0c\u4ee5\u53ca\u54ea\u4e9b\u7c7b\u578b\u5728\u65e9\u671f\u51fb\u51fa\u5bf9\u624b\u51fa\u5c40\u6700\u4e3a\u6709\u6548\uff1f", "answer": "\u5728\u8c37\u6b4c\u68d2\u7403\u4e2d\uff0c\u6709\u591a\u79cd\u7403\u79cd\u53ef\u4f9b\u9009\u62e9\uff0c\u5305\u62ec\u5feb\u901f\u7403\u3001\u66f2\u7ebf\u7403\u548c\u53d8\u5316\u7403\u3002\u4e3a\u4e86\u65e9\u671f\u51fb\u51fa\u5bf9\u624b\u51fa\u5c40\uff0c\u5feb\u901f\u7403\u7531\u4e8e\u5176\u901f\u5ea6\u662f\u4e00\u4e2a\u53ef\u9760\u7684\u9009\u62e9\u3002\u63a5\u4e0b\u6765\u662f\u4e00\u4e2a\u5b8c\u7f8e\u6295\u51fa\u7684\u66f2\u7ebf\u7403\uff0c\u4ee5\u51fa\u5176\u4e0d\u610f\u5730\u6293\u4f4f\u51fb\u7403\u624b\uff1b\u8fd9\u975e\u5e38\u6709\u6548\u3002\u6700\u4f73\u7b56\u7565\u53ef\u80fd\u53d6\u51b3\u4e8e\u4f60\u7684\u6295\u624b\u6280\u80fd\u548c\u4f60\u5bf9\u624b\u7684\u5f31\u70b9\u3002\u5c1d\u8bd5\u4e0d\u540c\u7684\u7403\u79cd\uff0c\u770b\u770b\u54ea\u79cd\u6700\u9002\u5408\u4f60\u3002\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u5feb\u901f\u7403 - \u9ad8\u901f/\u4f4e\u65cb\u8f6c\uff0c\u66f2\u7ebf\u7403 - \u4e2d\u7b49\u901f\u5ea6/\u9ad8\u65cb\u8f6c\uff0c\u53d8\u5316\u7403 - \u4f4e\u901f/\u4e2d\u7b49\u65cb\u8f6c"}, {"question": "\u8c37\u6b4c\u68d2\u7403\u65b0\u624b\u6307\u5357\uff1a\u5728\u9047\u5230\u6027\u80fd\u95ee\u9898\u65f6\uff0c\u54ea\u4e9b\u8bbe\u7f6e\u6700\u91cd\u8981\uff0c\u5b83\u4eec\u5982\u4f55\u5f71\u54cd\u6e38\u620f\uff1f", "answer": "\u4e3a\u4e86\u5728\u8c37\u6b4c\u68d2\u7403\u4e2d\u83b7\u5f97\u66f4\u6d41\u7545\u7684\u6e38\u620f\u4f53\u9a8c\uff0c\u8bf7\u8c03\u6574\u56fe\u5f62\u8bbe\u7f6e\u3002\u964d\u4f4e\u5206\u8fa8\u7387\u548c\u7ec6\u8282\u5c06\u663e\u8457\u51cf\u5c11\u8bbe\u5907\u7684\u8d1f\u62c5\u3002\u5982\u679c\u9047\u5230\u5ef6\u8fdf\uff0c\u8bf7\u5173\u95ed\u540e\u53f0\u5e94\u7528\u7a0b\u5e8f\u3002\u5c1d\u8bd5\u5173\u95ed\u9634\u5f71\u548c\u7c92\u5b50\u6548\u679c\u3002\u8fd9\u5e94\u8be5\u53ef\u4ee5\u63d0\u9ad8\u6027\u80fd\uff0c\u5c24\u5176\u662f\u5728\u65e7\u8bbe\u5907\u4e0a\u3002\u51cf\u5c11\u9634\u5f71\u6e32\u67d3\u548c\u7981\u7528\u6297\u952f\u9f7f\u53ef\u4ee5\u63d0\u9ad8\u5e27\u7387\u3002\u8fd9\u5c31\u50cf\u4e3a\u6c7d\u8f66\u7cbe\u7b80\u91cd\u91cf\uff0c\u4ee5\u83b7\u5f97\u66f4\u597d\u7684\u901f\u5ea6\u2014\u2014\u51cf\u5c11\u4e0d\u5fc5\u8981\u7684\u91cd\u91cf\uff0c\u63d0\u5347\u6027\u80fd\u3002"}, {"question": "\u9ad8\u7ea7\u8c37\u6b4c\u68d2\u7403\uff1a\u54ea\u4e9b\u51fb\u7403\u533a\u57df\u63d0\u4f9b\u6700\u4f73\u7684\u51fb\u7403\u529b\u91cf\u548c\u51fb\u7403\u7387\uff0c\u4ee5\u53ca\u4e3a\u4ec0\u4e48\u6211\u5e94\u8be5\u4f7f\u7528\u5237\u65b0\u7387\u9ad8\u7684\u663e\u793a\u5668\uff1f", "answer": "\u5728\u8c37\u6b4c\u68d2\u7403\u4e2d\uff0c\u6700\u4f73\u51fb\u7403\u533a\u57df\u901a\u5e38\u662f\u7403\u68d2\u7684\u751c\u871c\u70b9\u3002\u7784\u51c6\u533a\u57df\u7684\u4e2d\u95f4\u53ef\u4ee5\u5e2e\u52a9\u5e73\u8861\u529b\u91cf\u548c\u51fb\u7403\u7387\u3002\u9ad8\u5206\u8fa8\u7387/\u9ad8\u5237\u65b0\u7387\u7684\u663e\u793a\u5668\u6709\u52a9\u4e8e\u63d0\u9ad8\u89c6\u89c9\u6e05\u6670\u5ea6/\u54cd\u5e94\u901f\u5ea6\uff0c\u8fd9\u5bf9\u51fb\u6253\u5feb\u901f\u7403\u81f3\u5173\u91cd\u8981\u3002\u4e13\u6ce8\u4e8e\u8fd9\u4e2a\u201c\u751c\u871c\u70b9\u201d\u4f1a\u5e26\u6765\u66f4\u591a\u51fb\u7403\u548c\u5168\u5792\u6253\u3002\u8fd9\u4e2a\u4f4d\u7f6e\u8ba9\u60a8\u4ea7\u751f\u6700\u5927\u7684\u529b\u91cf\uff0c\u5e76\u80fd\u63d0\u9ad8\u4e00\u81f4\u6027\u3002"}, {"question": "\u8c37\u6b4c\u68d2\u7403\u7b56\u7565\uff1a\u4ec0\u4e48\u65f6\u5019\u662f\u5c1d\u8bd5\u5077\u5792\u7684\u6700\u4f73\u65f6\u673a\uff0c\u6295\u624b/\u6355\u624b\u7684\u6570\u636e\u5982\u4f55\u5f71\u54cd\u5077\u5792\u6210\u529f\u7387\uff0c\u4ee5\u53ca\u5728\u7ebf\u6e38\u620f\u4e2d\u6709\u54ea\u4e9b\u5176\u4ed6\u9632\u5b88\u6218\u672f\uff1f", "answer": "\u5728\u8c37\u6b4c\u68d2\u7403\u4e2d\uff0c\u5077\u5792\u7684\u6700\u4f73\u65f6\u673a\u662f\u5f53\u6295\u624b\u6295\u7403\u901f\u5ea6\u8f83\u6162\u4e14\u6355\u624b\u81c2\u529b\u8f83\u5f31\u7684\u65f6\u5019\u3002\u5728\u5c1d\u8bd5\u4e4b\u524d\u5206\u6790\u4ed6\u4eec\u7684\u6570\u636e\u3002\u6b65\u9aa4 1\uff1a\u89c2\u5bdf\u6295\u624b\u7684\u4e60\u60ef\u3002\u6b65\u9aa4 2\uff1a\u68c0\u67e5\u6355\u624b\u7684\u6295\u7403\u81c2\u529b\u3002\u6b65\u9aa4 3\uff1a\u8003\u8651\u6bd4\u8d5b\u60c5\u51b5\uff08\u6bd4\u5206\u3001\u5c40\u6570\u7b49\uff09\u3002\u9632\u5b88\u7b56\u7565\u8fd8\u5305\u62ec\u8c03\u6574\u5185\u91ce\u548c\u8c03\u6574\u5916\u91ce\u6df1\u5ea6\uff0c\u6839\u636e\u51fb\u7403\u624b\u7684\u60c5\u51b5\u3002\u628a\u5077\u5792\u770b\u4f5c\u662f\u6709\u8ba1\u7b97\u98ce\u9669\u7684\u884c\u4e3a\uff0c\u6743\u8861\u6f5c\u5728\u7684\u56de\u62a5\u4e0e\u88ab\u6293\u7684\u98ce\u9669\u3002\u6355\u624b\u6295\u7403\u51c6\u786e\u5ea6\u4f4e\u4f1a\u5927\u5927\u589e\u52a0\u5077\u5792\u7684\u6210\u529f\u7387\u3002"}, {"question": "\u8c37\u6b4c\u68d2\u7403\uff1a\u7403\u5458\u6570\u636e\u5982\u4f55\u5f71\u54cd\u6a21\u62df\u7ed3\u679c\u548c\u7403\u5458\u53d1\u5c55\uff0c\u4ee5\u53ca\u5316\u5b66\u7684\u91cd\u8981\u6027\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u8c37\u6b4c\u68d2\u7403\u4e2d\uff0c\u7403\u5458\u6570\u636e\u4f1a\u663e\u8457\u5f71\u54cd\u6a21\u62df\u7ed3\u679c\u3002\u66f4\u9ad8\u7684\u6570\u636e\u901a\u5e38\u610f\u5473\u7740\u66f4\u597d\u7684\u8868\u73b0\u3002\u7403\u5458\u7684\u53d1\u5c55\u4e0e\u6301\u7eed\u7684\u6bd4\u8d5b\u548c\u8bad\u7ec3\u6709\u5173\u3002\u6b65\u9aa4 1\uff1a\u4e13\u6ce8\u4e8e\u8bad\u7ec3\u8584\u5f31\u73af\u8282\u3002\u6b65\u9aa4 2\uff1a\u8ba9\u7403\u5458\u5728\u5176\u64c5\u957f\u7684\u4f4d\u7f6e\u6bd4\u8d5b\u3002\u6b65\u9aa4 3\uff1a\u76d1\u63a7\u7cbe\u529b\u6c34\u5e73\uff0c\u4ee5\u907f\u514d\u75b2\u52b3\u3002\u7403\u5458\u5316\u5b66\u503c\u63d0\u5347\u6709\u52a9\u4e8e\u56e2\u961f\u66f4\u597d\u5730\u53d1\u6325\u4f5c\u7528\u3002\u5982\u679c\u4f60\u7684\u56e2\u961f\u6210\u5458\u62e5\u6709\u9ad8\u5316\u5b66\u503c\uff0c\u4f60\u4f1a\u770b\u5230\u56e2\u961f\u8868\u73b0\u53d1\u751f\u663e\u8457\u53d8\u5316\u3002"}, {"question": "\u8c37\u6b4c\u68d2\u7403\u7ecf\u6d4e\uff1a\u54ea\u4e9b\u5347\u7ea7\u5bf9\u957f\u8fdc\u7403\u961f\u53d1\u5c55\u6700\u6709\u5229\uff0c\u5982\u4f55\u6709\u6548\u5730\u7ba1\u7406\u7403\u961f\u9884\u7b97\uff1f", "answer": "\u4f18\u5148\u5347\u7ea7\u90a3\u4e9b\u63d0\u9ad8\u5173\u952e\u7403\u5458\u6570\u636e\uff08\u5982\u51fb\u7403\u3001\u6295\u7403\u548c\u9632\u5b88\uff09\u7684\u5347\u7ea7\uff0c\u5728\u8c37\u6b4c\u68d2\u7403\u4e2d\u3002\u6709\u6548\u7684\u9884\u7b97\u7ba1\u7406\u5305\u62ec\u53d1\u6398\u5e74\u8f7b\u4eba\u624d\uff0c\u907f\u514d\u9ad8\u4ef7\u7b7e\u4e0b\u81ea\u7531\u7403\u5458\uff0c\u5e76\u5728\u4f60\u7684\u5c0f\u8054\u76df\uff08\u7403\u961f\uff09\u7cfb\u7edf\u4e0a\u8fdb\u884c\u6295\u8d44\u3002\u8fd9\u786e\u4fdd\u4e86\u4f60\u5efa\u7acb\u4e86\u4e00\u4e2a\u957f\u671f\u53ef\u6301\u7eed\u4e14\u5177\u6709\u7ade\u4e89\u529b\u7684\u7403\u961f\u3002\u6210\u672c\u6548\u76ca\u5206\u6790\u6709\u52a9\u4e8e\u4f60\u5224\u65ad\u6f5c\u5728\u7403\u5458\u662f\u5426\u503c\u5f97\u9ad8\u6602\u7684\u4ee3\u4ef7\u3002"}, {"question": "\u8c37\u6b4c\u68d2\u7403\u4e0e\u73b0\u5b9e\uff1a\u7403\u5458\u8bc4\u5206\u591a\u5927\u7a0b\u5ea6\u4e0a\u53cd\u6620\u4e86\u73b0\u5b9e\u4e2d\u7684\u68d2\u7403\u6280\u80fd\uff0c\u4ee5\u53ca\u6295\u7403\u5bf9\u51fb\u7403\u7ed3\u679c\u7684\u6f5c\u5728\u7b97\u6cd5\u662f\u4ec0\u4e48\uff1f", "answer": "\u8c37\u6b4c\u68d2\u7403\u4e2d\u7684\u7403\u5458\u8bc4\u5206\u65e8\u5728\u8fd1\u4f3c\u73b0\u5b9e\u4e16\u754c\u4e2d\u7684\u6280\u80fd\uff0c\u4f46\u6e38\u620f\u5e73\u8861\u56e0\u7d20\u901a\u5e38\u6709\u6240\u4e0d\u540c\u3002\u6295\u7403\u7ed3\u679c\u662f\u4e00\u4e2a\u590d\u6742\u7684\u8ba1\u7b97\uff0c\u8003\u8651\u5230\u4e86\u6295\u624b\u7684\u51c6\u786e\u6027\u548c\u51fb\u7403\u624b\u5bf9\u4e0d\u540c\u7403\u79cd\u7684\u5904\u7406\u80fd\u529b\u3002\u51fb\u7403\u624b\u7684\u65f6\u95f4\u548c\u6325\u68d2\u529b\u91cf\u5728\u8fd9\u4e00\u8fc7\u7a0b\u4e2d\u4e5f\u8d77\u7740\u91cd\u8981\u4f5c\u7528\u3002\u5728\u5185\u90e8\uff0c\u5b83\u6709\u70b9\u50cf\u4e00\u4e2a\u9ed1\u76d2\uff0c\u4f46\u516c\u5f0f\u57fa\u4e8e\u6982\u7387\u3002\u8fd9\u4e3a\u6e38\u620f\u589e\u6dfb\u4e86\u73b0\u5b9e\u611f\u548c\u4e0d\u53ef\u9884\u6d4b\u6027\u3002"}, {"question": "\u8c37\u6b4c\u68d2\u7403\u8de8\u5e73\u53f0\uff1a\u6211\u7684\u7403\u961f\u548c\u8fdb\u5ea6\u4f1a\u5728\u4e0d\u540c\u7684\u8bbe\u5907\uff08\u5b89\u5353/\u82f9\u679c\uff09\u4e4b\u95f4\u8f6c\u79fb\u5417\uff0c\u4ee5\u53ca\u786e\u4fdd\u65e0\u7f1d\u6570\u636e\u8fc1\u79fb\u7684\u5fc5\u8981\u6b65\u9aa4\u662f\u4ec0\u4e48\uff1f", "answer": "\u8c37\u6b4c\u68d2\u7403\u901a\u5e38\u5141\u8bb8\u5728\u5b89\u5353\u548c\u82f9\u679c\u8bbe\u5907\u4e4b\u95f4\u8fdb\u884c\u8de8\u5e73\u53f0\u6570\u636e\u4f20\u8f93\u3002\u786e\u4fdd\u4f60\u7684\u6e38\u620f\u94fe\u63a5\u5230\u8c37\u6b4c\u5e10\u6237\u6216\u5176\u4ed6\u53d7\u652f\u6301\u7684\u5e10\u6237\uff08\u4f8b\u5982\uff0c\u8138\u4e66\uff09\u3002\u7136\u540e\uff0c\u53ea\u9700\u5728\u65b0\u8bbe\u5907\u4e0a\u767b\u5f55\u8be5\u5e10\u6237\u5373\u53ef\u540c\u6b65\u4f60\u7684\u8fdb\u5ea6\u3002\u5177\u4f53\u65b9\u6cd5\u53ef\u80fd\u7565\u6709\u4e0d\u540c\uff0c\u5177\u4f53\u53d6\u51b3\u4e8e\u7248\u672c\u3002\u5982\u679c\u6570\u636e\u4f20\u8f93\u65e0\u6cd5\u5b8c\u6210\uff0c\u8bf7\u8054\u7cfb\u6e38\u620f\u7684\u5ba2\u6237\u652f\u6301\u56e2\u961f\u6765\u83b7\u5f97\u5e2e\u52a9\u3002\u4e3a\u4e86\u786e\u4fdd\u6d41\u7545\u7684\u6570\u636e\u8fc1\u79fb\uff0c\u8bf7\u786e\u4fdd\u4f60\u62e5\u6709\u7a33\u5b9a\u7684\u7f51\u7edc\u8fde\u63a5\uff0c\u5e76\u5b9a\u671f\u5907\u4efd\u4f60\u7684\u8fdb\u5ea6\u3002"}, {"question": "\u8c37\u6b4c\u68d2\u7403\u5f69\u86cb\uff1a\u662f\u5426\u5b58\u5728\u4efb\u4f55\u9690\u85cf\u7684\u7403\u573a\u6216\u53ef\u89e3\u9501\u7684\u7403\u5458\uff0c\u4ee5\u53ca\u6210\u5c31\u730e\u624b\u5982\u4f55\u89e3\u9501\u5b83\u4eec\uff1f", "answer": "\u8c37\u6b4c\u68d2\u7403\u786e\u5b9e\u5305\u542b\u9690\u85cf\u5185\u5bb9\uff0c\u5956\u52b1\u6295\u5165\u7684\u73a9\u5bb6\u3002\u4e00\u4e9b\u5f69\u86cb\u53ef\u80fd\u6d89\u53ca\u5b8c\u6210\u7279\u5b9a\u6311\u6218\u3002\u4f8b\u5982\uff0c\u89e3\u9501\u7ecf\u5178\u7403\u573a\u76ae\u80a4\u53ef\u80fd\u9700\u8981\u5728\u6700\u9ad8\u96be\u5ea6\u4e0b\u8d62\u5f97\u51a0\u519b\u3002\u4e3a\u4e86\u83b7\u5f97\u8fd9\u4e9b\u5956\u52b1\uff0c\u4f60\u5fc5\u987b\u975e\u5e38\u7a33\u5b9a\u5730\u767b\u5f55\u6e38\u620f\uff0c\u8fd9\u5c06\u5728\u6bcf\u65e5\u89e3\u9501\u968f\u673a\u5956\u52b1\u3002\u7ee7\u7eed\u63a2\u7d22\u6e38\u620f\uff0c\u4f60\u5c06\u8d8a\u6765\u8d8a\u4e86\u89e3\u8fd9\u4e9b\u5956\u52b1\u3002\u8fdb\u4e00\u6b65\u6316\u6398\uff0c\u4f60\u5c06\u4f1a\u53d1\u73b0\u4e00\u4e9b\u9177\u70ab\u7684\u9690\u85cf\u529f\u80fd\u3002"}]
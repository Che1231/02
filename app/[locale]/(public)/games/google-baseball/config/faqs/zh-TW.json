[{"question": "Google\u68d2\u7403\u5165\u9580\uff1a\u65b0\u624b\u5982\u4f55\u6210\u529f\u64ca\u7403\uff0c\u4e26\u627e\u5230\u6700\u5bb9\u6613\u6301\u7e8c\u64ca\u4e2d\u7684\u7b56\u7565\uff1f", "answer": "\u5728Google\u68d2\u7403\u4e2d\uff0c\u65b0\u624b\u60f3\u8981\u6301\u7e8c\u64ca\u4e2d\u7403\uff0c\u95dc\u9375\u5728\u65bc\u4e00\u81f4\u6027\u3002\u6b65\u9a5f\u4e00\uff1a\u5c08\u6ce8\u65bc\u6642\u6a5f\uff1b\u7b49\u5f85\u7403\u63a5\u8fd1\u672c\u58d8\u677f\u3002\u6b65\u9a5f\u4e8c\uff1a\u4fdd\u6301\u5e73\u8861\u7684\u59ff\u52e2\uff0c\u78ba\u4fdd\u91cd\u91cf\u5206\u914d\u5747\u52fb\u3002\u6b65\u9a5f\u4e09\uff1a\u4ee5\u5e73\u9806\u4e14\u63a7\u5236\u597d\u7684\u52d5\u4f5c\u63ee\u68d2\uff0c\u76ee\u6a19\u662f\u6b63\u4e2d\u7403\u3002\u4f8b\u5982\uff0c\u5728\u8a13\u7df4\u6a21\u5f0f\u4e2d\u7df4\u7fd2\u64ca\u7403\uff0c\u76f4\u5230\u60a8\u611f\u5230\u8212\u9069\u70ba\u6b62\u3002\u4e00\u500b\u826f\u597d\u7684\u5165\u9580\u7b56\u7565\u662f\u96c6\u4e2d\u7cbe\u529b\u64ca\u51fa\u76f4\u7dda\u7403\uff0c\u4ee5\u63d0\u9ad8\u64ca\u7403\u7387\u3002\u9019\u5c31\u50cf\u5b78\u7fd2\u9a0e\u81ea\u884c\u8eca\u4e00\u6a23 \u2013 \u9700\u8981\u7df4\u7fd2\uff0c\u4f46\u60a8\u6703\u638c\u63e1\u7684\uff01"}, {"question": "Google\u68d2\u7403\uff1a\u6211\u53ef\u4ee5\u6295\u64f2\u54ea\u4e9b\u4e0d\u540c\u985e\u578b\u7684\u7403\u7a2e\uff0c\u54ea\u4e9b\u7403\u7a2e\u6700\u6709\u6548\u5730\u5728\u65e9\u671f\u8b93\u5c0d\u624b\u51fa\u5c40\uff1f", "answer": "\u5728Google\u68d2\u7403\u4e2d\uff0c\u60a8\u53ef\u4ee5\u9078\u64c7\u5e7e\u7a2e\u6295\u7403\u985e\u578b\uff0c\u5305\u62ec\u5feb\u901f\u7403\u3001\u66f2\u7403\u548c\u8b8a\u901f\u7403\u3002\u70ba\u4e86\u5728\u65e9\u671f\u9020\u6210\u4e09\u632f\uff0c\u5feb\u901f\u7403\u56e0\u5176\u901f\u5ea6\u800c\u53ef\u9760\u3002\u63a5\u4e0b\u4f86\u5b8c\u7f8e\u5730\u6295\u51fa\u66f2\u7403\uff0c\u8b93\u6253\u8005\u63aa\u624b\u4e0d\u53ca\uff1b\u9019\u975e\u5e38\u6709\u6548\u3002\u6700\u4f73\u7b56\u7565\u53ef\u80fd\u53d6\u6c7a\u65bc\u6295\u624b\u6280\u5de7\u548c\u5c0d\u624b\u7684\u5f31\u9ede\u3002\u5617\u8a66\u4e0d\u540c\u7684\u7403\u7a2e\uff0c\u770b\u770b\u54ea\u7a2e\u6700\u9069\u5408\u60a8\u3002\u5c0d\u7167\u8868\uff1a\u5feb\u901f\u7403 - \u9ad8\u901f\u5ea6/\u4f4e\u8b8a\u5316\uff0c\u66f2\u7403 - \u4e2d\u7b49\u901f\u5ea6/\u9ad8\u8b8a\u5316\uff0c\u8b8a\u901f\u7403 - \u4f4e\u901f\u5ea6/\u4e2d\u7b49\u8b8a\u5316"}, {"question": "Google\u68d2\u7403\u65b0\u624b\u6559\u5b78\uff1a\u5728\u9047\u5230\u6548\u80fd\u554f\u984c\u6642\uff0c\u54ea\u4e9b\u8a2d\u5b9a\u6700\u9700\u8981\u8abf\u6574\uff0c\u4ee5\u53ca\u5b83\u5011\u5982\u4f55\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff1f", "answer": "\u70ba\u4e86\u5728Google\u68d2\u7403\u4e2d\u7372\u5f97\u66f4\u9806\u66a2\u7684\u904a\u6232\u9ad4\u9a57\uff0c\u8acb\u8abf\u6574\u5716\u5f62\u8a2d\u5b9a\u3002\u964d\u4f4e\u89e3\u6790\u5ea6\u548c\u7d30\u7bc0\u5c07\u6703\u986f\u8457\u964d\u4f4e\u88dd\u7f6e\u7684\u8ca0\u64d4\u3002\u5982\u679c\u9047\u5230\u5ef6\u9072\uff0c\u8acb\u95dc\u9589\u80cc\u666f\u61c9\u7528\u7a0b\u5f0f\u3002\u5617\u8a66\u95dc\u9589\u9670\u5f71\u548c\u7c92\u5b50\u6548\u679c\u3002\u9019\u61c9\u8a72\u80fd\u6539\u5584\u6548\u80fd\uff0c\u5c24\u5176\u662f\u5728\u8f03\u820a\u7684\u88dd\u7f6e\u4e0a\u3002\u6e1b\u5c11\u9670\u5f71\u5448\u73fe\u548c\u95dc\u9589\u6297\u92f8\u9f52\u53ef\u4ee5\u63d0\u9ad8\u5e40\u7387\u3002\u9019\u5c31\u50cf\u70ba\u6c7d\u8eca\u7c21\u5316\u7d50\u69cb\u4ee5\u7372\u5f97\u66f4\u597d\u7684\u901f\u5ea6\u4e00\u6a23 \u2013 \u6e1b\u5c11\u4e0d\u5fc5\u8981\u7684\u91cd\u91cf\uff0c\u63d0\u5347\u6548\u80fd\u3002"}, {"question": "\u9032\u968eGoogle\u68d2\u7403\uff1a\u54ea\u4e9b\u64ca\u7403\u5340\u57df\u80fd\u63d0\u4f9b\u6700\u4f73\u7684\u64ca\u7403\u529b\u91cf\u548c\u64ca\u7403\u7387\uff0c\u70ba\u4ec0\u9ebc\u6211\u61c9\u8a72\u4f7f\u7528\u9ad8\u66f4\u65b0\u7387\u7684\u87a2\u5e55\uff1f", "answer": "\u5728Google\u68d2\u7403\u4e2d\uff0c\u6700\u4f73\u64ca\u7403\u5340\u57df\u901a\u5e38\u662f\u5728\u7403\u68d2\u7684\u751c\u871c\u9ede\u3002\u7784\u6e96\u5340\u57df\u4e2d\u5fc3\u6709\u52a9\u65bc\u5e73\u8861\u529b\u91cf\u548c\u64ca\u7403\u7387\u3002\u9ad8\u89e3\u6790\u5ea6/\u9ad8\u66f4\u65b0\u7387\u87a2\u5e55\u6709\u52a9\u65bc\u8996\u89ba\u6e05\u6670\u5ea6/\u53cd\u61c9\u6642\u9593\u66f4\u5feb\uff0c\u5c0d\u65bc\u64ca\u6253\u5feb\u901f\u7403\u81f3\u95dc\u91cd\u8981\u3002\u5c08\u6ce8\u65bc\u9019\u500b\u300c\u751c\u871c\u9ede\u300d\u80fd\u5e36\u4f86\u66f4\u591a\u64ca\u6578\u548c\u5168\u58d8\u6253\u3002\u8a72\u4f4d\u7f6e\u8b93\u60a8\u7522\u751f\u6700\u5927\u7684\u529b\u91cf\u4e26\u63d0\u9ad8\u4e00\u81f4\u6027\u3002"}, {"question": "Google\u68d2\u7403\u7b56\u7565\uff1a\u4f55\u6642\u662f\u5617\u8a66\u76dc\u58d8\u7684\u6700\u4f73\u6642\u6a5f\uff0c\u6295\u624b/\u6355\u624b\u6578\u64da\u5982\u4f55\u5f71\u97ff\u76dc\u58d8\u6210\u529f\u7387\uff0c\u4ee5\u53ca\u7dda\u4e0a\u904a\u6232\u4e2d\u6709\u54ea\u4e9b\u5176\u4ed6\u9632\u79a6\u7b56\u7565\uff1f", "answer": "\u5728Google\u68d2\u7403\u4e2d\uff0c\u76dc\u58d8\u7684\u6700\u4f73\u6642\u6a5f\u662f\u7576\u6295\u624b\u6295\u7403\u901f\u5ea6\u6162\u4e14\u6355\u624b\u81c2\u529b\u8f03\u5f31\u6642\u3002\u5728\u5617\u8a66\u4e4b\u524d\uff0c\u5148\u5206\u6790\u4ed6\u5011\u7684\u6578\u64da\u3002\u6b65\u9a5f\u4e00\uff1a\u89c0\u5bdf\u6295\u624b\u7684\u7fd2\u6163\u3002\u6b65\u9a5f\u4e8c\uff1a\u6aa2\u67e5\u6355\u624b\u7684\u6295\u7403\u81c2\u529b\u3002\u6b65\u9a5f\u4e09\uff1a\u8003\u616e\u6bd4\u8cfd\u60c5\u6cc1\uff08\u6bd4\u5206\u3001\u51fa\u5c40\u6578\u7b49\uff09\u3002\u9632\u79a6\u7b56\u7565\u9084\u5305\u62ec\u8abf\u6574\u5167\u91ce\u4f4d\u7f6e\u548c\u6839\u64da\u6253\u8005\u8abf\u6574\u5916\u91ce\u6df1\u5ea6\u3002\u5c07\u76dc\u58d8\u8996\u70ba\u4e00\u9805\u6709\u8a08\u7b97\u98a8\u96aa\u7684\u884c\u70ba\uff0c\u6b0a\u8861\u6f5b\u5728\u56de\u5831\u8207\u88ab\u6293\u5230\u7684\u98a8\u96aa\u3002\u6355\u624b\u7684\u6295\u7403\u6e96\u78ba\u5ea6\u4f4e\uff0c\u6703\u8b93\u60a8\u6709\u8f03\u9ad8\u6a5f\u7387\u76dc\u58d8\u3002"}, {"question": "Google\u68d2\u7403\uff1a\u7403\u54e1\u6578\u64da\u5982\u4f55\u5f71\u97ff\u6a21\u64ec\u7d50\u679c\u548c\u7403\u54e1\u9032\u6b65\uff0c\u5316\u5b78\u6548\u61c9\u7684\u91cd\u8981\u6027\u70ba\u4f55\uff1f", "answer": "\u7403\u54e1\u6578\u64da\u986f\u8457\u5f71\u97ffGoogle\u68d2\u7403\u4e2d\u7684\u6a21\u64ec\u7d50\u679c\u3002\u8f03\u9ad8\u7684\u6578\u64da\u901a\u5e38\u8868\u793a\u66f4\u597d\u7684\u8868\u73fe\u3002\u7403\u54e1\u9032\u6b65\u8207\u6301\u7e8c\u7684\u6bd4\u8cfd\u548c\u8a13\u7df4\u606f\u606f\u76f8\u95dc\u3002\u6b65\u9a5f\u4e00\uff1a\u5c08\u6ce8\u65bc\u8a13\u7df4\u5f31\u9805\u3002\u6b65\u9a5f\u4e8c\uff1a\u8b93\u7403\u54e1\u5728\u64c5\u9577\u7684\u4f4d\u7f6e\u4e0a\u6bd4\u8cfd\u3002\u6b65\u9a5f\u4e09\uff1a\u76e3\u63a7\u9ad4\u529b\u6c34\u5e73\u4ee5\u907f\u514d\u75b2\u52de\u3002\u7403\u54e1\u5316\u5b78\u6548\u61c9\u6709\u52a9\u65bc\u5718\u968a\u8868\u73fe\u66f4\u597d\u3002\u5982\u679c\u5718\u968a\u6210\u54e1\u7684\u5316\u5b78\u6548\u61c9\u9ad8\uff0c\u60a8\u5c07\u6703\u770b\u5230\u5718\u968a\u8868\u73fe\u767c\u751f\u986f\u8457\u8b8a\u5316\u3002"}, {"question": "Google\u68d2\u7403\u7d93\u6fdf\uff1a\u54ea\u4e9b\u5347\u7d1a\u5c0d\u9577\u671f\u5718\u968a\u767c\u5c55\u6700\u6709\u5229\uff0c\u5982\u4f55\u6709\u6548\u7ba1\u7406\u5718\u968a\u9810\u7b97\uff1f", "answer": "\u512a\u5148\u5347\u7d1a\u80fd\u63d0\u5347\u95dc\u9375\u7403\u54e1\u6578\u64da\uff08\u5982\u64ca\u7403\u3001\u6295\u7403\u548c\u5b88\u5099\uff09\u7684\u9805\u76ee\uff0c\u5728Google\u68d2\u7403\u4e2d\u3002\u6709\u6548\u9810\u7b97\u7ba1\u7406\u5305\u62ec\u641c\u5c0b\u5e74\u8f15\u6709\u6f5b\u529b\u7684\u7403\u54e1\uff0c\u907f\u514d\u904e\u5ea6\u652f\u4ed8\u81ea\u7531\u7403\u54e1\uff0c\u4ee5\u53ca\u6295\u8cc7\u65bc\u5c0f\u806f\u76df\u7cfb\u7d71\u3002\u9019\u78ba\u4fdd\u4e86\u60a8\u80fd\u9577\u671f\u5efa\u7acb\u4e00\u500b\u6301\u7e8c\u4e14\u5177\u7af6\u722d\u529b\u7684\u7403\u968a\u3002\u6210\u672c\u6548\u76ca\u5206\u6790\u6709\u52a9\u65bc\u60a8\u5224\u65b7\u6f5b\u5728\u7403\u54e1\u662f\u5426\u503c\u5f97\u9ad8\u6602\u7684\u4ee3\u50f9\u3002"}, {"question": "Google\u68d2\u7403\u8207\u73fe\u5be6\uff1a\u7403\u54e1\u8a55\u7d1a\u5728\u591a\u5927\u7a0b\u5ea6\u4e0a\u53cd\u6620\u73fe\u5be6\u4e16\u754c\u7684\u68d2\u7403\u6280\u80fd\uff0c\u4ee5\u53ca\u6295\u624b\u5c0d\u6253\u8005\u7684\u7d50\u679c\u8a08\u7b97\u6a5f\u5236\u70ba\u4f55\uff1f", "answer": "Google\u68d2\u7403\u4e2d\u7684\u7403\u54e1\u8a55\u7d1a\u65e8\u5728\u8fd1\u4f3c\u73fe\u5be6\u4e16\u754c\u4e2d\u7684\u6280\u80fd\uff0c\u4f46\u904a\u6232\u5e73\u8861\u8003\u91cf\u901a\u5e38\u4e0d\u540c\u3002\u6295\u624b\u5c0d\u6253\u8005\u7684\u7d50\u679c\u662f\u4e00\u500b\u8907\u96dc\u7684\u8a08\u7b97\uff0c\u5b83\u8003\u616e\u5230\u6295\u624b\u7684\u6e96\u78ba\u6027\u548c\u6253\u8005\u5c0d\u8a72\u7403\u7a2e\u7684\u638c\u63e1\u5ea6\u3002\u6253\u8005\u7684\u6642\u6a5f\u548c\u63ee\u68d2\u529b\u91cf\u5728\u9019\u904e\u7a0b\u4e2d\u4e5f\u626e\u6f14\u8457\u91cd\u8981\u7684\u89d2\u8272\u3002\u5167\u90e8\u8a08\u7b97\u6a5f\u5236\u6709\u9ede\u50cf\u9ed1\u76d2\u5b50\uff0c\u4f46\u516c\u5f0f\u662f\u57fa\u65bc\u6a5f\u7387\u3002\u9019\u8b93\u904a\u6232\u5177\u6709\u5beb\u5be6\u611f\u548c\u4e0d\u53ef\u9810\u6e2c\u6027\u3002"}, {"question": "Google\u68d2\u7403\u8de8\u5e73\u53f0\uff1a\u6211\u7684\u5718\u968a\u548c\u9032\u5ea6\u6703\u5728\u4e0d\u540c\u88dd\u7f6e\uff08Android/iOS\uff09\u4e4b\u9593\u8f49\u79fb\u55ce\uff1f\u54ea\u4e9b\u6b65\u9a5f\u53ef\u4ee5\u78ba\u4fdd\u7121\u7e2b\u8cc7\u6599\u9077\u79fb\uff1f", "answer": "Google\u68d2\u7403\u901a\u5e38\u5141\u8a31Android\u548ciOS\u88dd\u7f6e\u4e4b\u9593\u7684\u8de8\u5e73\u53f0\u8cc7\u6599\u8f49\u79fb\u3002\u8acb\u78ba\u4fdd\u60a8\u7684\u904a\u6232\u5df2\u9023\u7d50\u81f3Google\u5e33\u6236\u6216\u5176\u4ed6\u652f\u63f4\u7684\u5e33\u6236\uff08\u4f8b\u5982Facebook\uff09\u3002\u7136\u5f8c\uff0c\u53ea\u9700\u5728\u65b0\u7684\u88dd\u7f6e\u4e0a\u767b\u5165\u540c\u4e00\u5e33\u6236\u5373\u53ef\u540c\u6b65\u60a8\u7684\u9032\u5ea6\u3002\u78ba\u5207\u65b9\u6cd5\u53ef\u80fd\u7565\u6709\u4e0d\u540c\uff0c\u8996\u7248\u672c\u800c\u5b9a\u3002\u5982\u679c\u8cc7\u6599\u8f49\u79fb\u7121\u6cd5\u6b63\u5e38\u904b\u4f5c\uff0c\u8acb\u806f\u7e6b\u904a\u6232\u5ba2\u670d\u5718\u968a\u4ee5\u53d6\u5f97\u5354\u52a9\u3002\u70ba\u4e86\u78ba\u4fdd\u5e73\u9806\u7684\u8cc7\u6599\u9077\u79fb\uff0c\u52d9\u5fc5\u78ba\u4fdd\u60a8\u6709\u7a69\u5b9a\u7684\u7db2\u8def\u9023\u7dda\uff0c\u4e26\u5b9a\u671f\u5099\u4efd\u60a8\u7684\u9032\u5ea6\u3002"}, {"question": "Google\u68d2\u7403\u5f69\u86cb\uff1a\u662f\u5426\u6709\u4efb\u4f55\u96b1\u85cf\u7403\u5834\u6216\u53ef\u89e3\u9396\u7684\u7403\u54e1\uff0c\u4ee5\u53ca\u9054\u6210\u76ee\u6a19\u7684\u7375\u4eba\u5982\u4f55\u89e3\u9396\u5b83\u5011\uff1f", "answer": "Google\u68d2\u7403\u78ba\u5be6\u5305\u542b\u734e\u52f5\u6295\u5165\u73a9\u5bb6\u7684\u96b1\u85cf\u5167\u5bb9\u3002\u4e00\u4e9b\u5f69\u86cb\u53ef\u80fd\u6d89\u53ca\u5b8c\u6210\u7279\u5b9a\u6311\u6230\u3002\u4f8b\u5982\uff0c\u89e3\u9396\u7d93\u5178\u7403\u5834\u76ae\u819a\u53ef\u80fd\u9700\u8981\u5728\u6700\u9ad8\u96e3\u5ea6\u4e0a\u8d0f\u5f97\u51a0\u8ecd\u3002\u70ba\u4e86\u7372\u5f97\u9019\u4e9b\u734e\u52f5\uff0c\u60a8\u5fc5\u9808\u4fdd\u6301\u904a\u6232\u767b\u5165\u7684\u4e00\u81f4\u6027\uff0c\u9019\u5c07\u89e3\u9396\u96a8\u6a5f\u6bcf\u65e5\u734e\u52f5\u3002\u7e7c\u7e8c\u63a2\u7d22\u904a\u6232\uff0c\u60a8\u6703\u8d8a\u4f86\u8d8a\u4e86\u89e3\u9019\u4e9b\u734e\u52f5\u3002\u6df1\u5165\u6316\u6398\uff0c\u60a8\u6703\u767c\u73fe\u4e00\u4e9b\u5f88\u68d2\u7684\u96b1\u85cf\u529f\u80fd\u3002"}]
[{"question": "\uad6c\uae00 \uc57c\uad6c \uae30\ubcf8: \ucd08\ubcf4\uc790\uac00 \uacf5\uc744 \uc131\uacf5\uc801\uc73c\ub85c \uce58\ub294 \ubc29\ubc95\uacfc \uc77c\uad00\uc131 \uc788\uac8c \uacf5\uacfc\uc758 \uc811\ucd09\uc744 \ub9cc\ub4dc\ub294 \uac00\uc7a5 \uc26c\uc6b4 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uad6c\uae00 \uc57c\uad6c \ucd08\ubcf4\uc790\ub85c\uc11c \uacf5\uc744 \uc77c\uad00\ub418\uac8c \uce58\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \ud0c0\uc774\ubc0d\uc5d0 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \ud22c\uad6c\uac00 \uace7 \uc55e\ucabd\uc5d0 \uc788\ub294 \uc21c\uac04\uc744 \uae30\ub2e4\ub9ac\uc2ed\uc2dc\uc624. 2\ub2e8\uacc4: \uade0\ub4f1\ud55c \ubb34\uac8c \ubd84\ud3ec\ub97c \ubcf4\uc7a5\ud558\ub294 \uade0\ud615 \uc7a1\ud78c \uc790\uc138\ub97c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. 3\ub2e8\uacc4: \uc6d0\ud65c\ud558\uace0 \ud1b5\uc81c\ub41c \ub3d9\uc791\uc73c\ub85c \uc2a4\uc719\ud558\uc5ec \uacf5\uc744 \uc815\ud655\ud558\uac8c \ub9de\ucd94\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc790\uc2e0\uac10\uc744 \uc5bb\uc744 \ub54c\uae4c\uc9c0 \ud6c8\ub828 \ubaa8\ub4dc\uc5d0\uc11c \uc5f0\uc2b5\ud558\uc2ed\uc2dc\uc624. \uc88b\uc740 \uc2dc\uc791 \uc804\ub7b5\uc740 \ud0c0\uc728\uc744 \ub192\uc774\uae30 \uc704\ud574 \ub77c\uc778 \ub4dc\ub77c\uc774\ube0c\ub97c \uce58\ub294 \ub370 \uc911\uc810\uc744 \ub450\ub294 \uac83\uc785\ub2c8\ub2e4. \uc790\uc804\uac70\ub97c \ud0c0\ub294 \uac83\uc744 \ubc30\uc6b0\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc5f0\uc2b5\ud558\uba74 \uc775\uc219\ud574\uc9c8 \uac83\uc785\ub2c8\ub2e4!"}, {"question": "\uad6c\uae00 \uc57c\uad6c: \uc0c1\ub300\ub97c \uc77c\ucc0d \uc0bc\uc9c4\uc73c\ub85c \ucc98\ub9ac\ud558\uae30 \uc704\ud574 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \ub2e4\ub978 \uc885\ub958\uc758 \uad6c\uc885\uc740 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5a4 \uc885\ub958\uac00 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc785\ub2c8\uae4c?", "answer": "\uad6c\uae00 \uc57c\uad6c\uc5d0\ub294 \uc5ec\ub7ec \uac00\uc9c0 \uad6c\uc885\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ube60\ub978 \uacf5, \ucee4\ube0c\ubcfc, \ubcc0\ud654\uad6c \ub4f1\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ucd08\uae30 \uc0bc\uc9c4\uc744 \uc704\ud574 \uc18d\ub3c4 \ub54c\ubb38\uc5d0 \ube60\ub978 \uacf5\uc774 \uc2e0\ub8b0\ud560 \uc218 \uc788\ub294 \uc635\uc158\uc785\ub2c8\ub2e4. \uc774\uc5b4\uc11c \ud0c0\uc790\ub97c \uade0\ud615\uc744 \uc783\uac8c \ud558\ub294 \uc644\ubcbd\ud55c \ucee4\ube0c\ubcfc\uc774 \ub9e4\uc6b0 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. \uac00\uc7a5 \uc88b\uc740 \uc804\ub7b5\uc740 \ud22c\uc218\uc758 \uae30\uc220\uacfc \uc0c1\ub300\ubc29\uc758 \uc57d\uc810\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc5b4\ub5a4 \uad6c\uc885\uc774 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778\uc9c0 \uc54c\uc544\ubcf4\uae30 \uc704\ud574 \ub2e4\uc591\ud55c \uad6c\uc885\uc744 \uc2dc\ub3c4\ud558\uc2ed\uc2dc\uc624. \uad6c\uc131\ud45c: \ube60\ub978 \uacf5 - \ub192\uc740 \uc18d\ub3c4/\ub0ae\uc740 \uaebe\uc784, \ucee4\ube0c\ubcfc - \uc911\uac04 \uc18d\ub3c4/\ub192\uc740 \uaebe\uc784, \ubcc0\ud654\uad6c - \ub0ae\uc740 \uc18d\ub3c4/\uc911\uac04 \uaebe\uc784"}, {"question": "\ucd08\ubcf4\uc790\ub97c \uc704\ud55c \uad6c\uae00 \uc57c\uad6c: \uc131\ub2a5 \ubb38\uc81c\uac00 \ubc1c\uc0dd\ud560 \ub54c \uc870\uc815\ud574\uc57c \ud560 \uac00\uc7a5 \uc911\uc694\ud55c \uc124\uc815\uc740 \ubb34\uc5c7\uc774\uba70, \uc774 \uc124\uc815\uc740 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\uad6c\uae00 \uc57c\uad6c\uc5d0\uc11c \ub354 \ubd80\ub4dc\ub7ec\uc6b4 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc704\ud574 \uadf8\ub798\ud53d \uc124\uc815\uc744 \uc870\uc815\ud558\uc2ed\uc2dc\uc624. \ud574\uc0c1\ub3c4\uc640 \ub514\ud14c\uc77c\uc744 \ub0ae\ucd94\uba74 \uc7a5\uce58\uc5d0 \ub300\ud55c \uc694\uad6c \uc0ac\ud56d\uc744 \ud06c\uac8c \uc904\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc9c0\uc5f0\uc774 \ubc1c\uc0dd\ud558\uba74 \ubc31\uadf8\ub77c\uc6b4\ub4dc \uc751\uc6a9 \ud504\ub85c\uadf8\ub7a8\uc744 \ub2eb\uc73c\uc2ed\uc2dc\uc624. \uadf8\ub9bc\uc790 \ubc0f \uc785\uc790 \ud6a8\uacfc\ub97c \ub044\ub294 \uac83\uc744 \uc2dc\ub3c4\ud558\uc2ed\uc2dc\uc624. \ud2b9\ud788 \uc624\ub798\ub41c \uae30\uae30\uc5d0\uc11c \uc131\ub2a5\uc744 \ud5a5\uc0c1\uc2dc\ucf1c\uc57c \ud569\ub2c8\ub2e4. \uadf8\ub9bc\uc790 \ub80c\ub354\ub9c1\uc744 \uc904\uc774\uace0 \uc548\ud2f0\uc568\ub9ac\uc5b4\uc2f1\uc744 \ube44\ud65c\uc131\ud654\ud558\uba74 \ud504\ub808\uc784 \uc18d\ub3c4\ub97c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud544\uc694\uc5c6\ub294 \ubb34\uac8c\ub97c \uc904\uc774\uace0 \uc131\ub2a5\uc744 \ub192\uc774\uae30 \uc704\ud574 \uc790\ub3d9\ucc28\ub97c \uac1c\uc120\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4."}, {"question": "\uace0\uae09 \uad6c\uae00 \uc57c\uad6c: \uc5b4\ub5a4 \ud0c0\uaca9 \uad6c\uc5ed\uc774 \ucd5c\uc0c1\uc758 \ud30c\uc6cc\uc640 \uc811\ucd09\uc728\uc744 \uc81c\uacf5\ud558\uba70, \uc65c \ub192\uc740 \uc8fc\uc0ac\uc728\uc758 \ubaa8\ub2c8\ud130\ub97c \uc0ac\uc6a9\ud574\uc57c \ud558\ub294\uac00?", "answer": "\uad6c\uae00 \uc57c\uad6c\uc5d0\uc11c \ucd5c\uc801\uc758 \ud0c0\uaca9 \uad6c\uc5ed\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \ubc30\ud2b8\uc758 \uafc0 \uad6c\uc5ed\uc785\ub2c8\ub2e4. \uad6c\uc5ed \uc911\uc559\uc744 \ud0c0\uaca9\ud558\ub294 \uac83\uc740 \ud30c\uc6cc\uc640 \uc811\ucd09\uc744 \uade0\ud615 \uc788\uac8c \ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \uace0\ud574\uc0c1\ub3c4/\uace0\uc8fc\uc0ac\uc728 \ubaa8\ub2c8\ud130\ub294 \uc6c0\uc9c1\uc774\ub294 \ube60\ub978 \uacf5\uc744 \uce58\ub294 \ub370 \ud544\uc218\uc801\uc778 \uc2dc\uac01\uc801 \uba85\ub8cc\ub3c4/\ubc18\uc751 \uc18d\ub3c4\ub97c \ub192\uc774\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \uc774 \"\uafc0 \uad6c\uc5ed\"\uc5d0 \uc9d1\uc911\ud558\uba74 \ub354 \ub9ce\uc740 \uc548\ud0c0\uc640 \ud648\ub7f0\uc744 \uce60 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc704\uce58\ub294 \ucd5c\ub300 \ud30c\uc6cc\ub97c \uc0dd\uc131\ud558\uace0 \uc77c\uad00\uc131\uc744 \ub192\uc774\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\uad6c\uae00 \uc57c\uad6c \uc804\ub7b5: \uc5b8\uc81c \ub3c4\ub8e8 \uc2dc\ub3c4\ub97c \ud558\ub294 \uac83\uc774 \uac00\uc7a5 \uc88b\uc73c\uba70, \ud22c\uc218/\ud3ec\uc218 \ud1b5\uacc4\uac00 \ub3c4\ub8e8 \uc131\uacf5\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\uba70 \uc628\ub77c\uc778 \ud50c\ub808\uc774\uc5d0\uc11c \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \ub2e4\ub978 \uc218\ube44 \uc804\uc220\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uad6c\uae00 \uc57c\uad6c\uc5d0\uc11c \ub3c4\ub8e8\ub97c \uc2dc\ub3c4\ud558\ub294 \uac00\uc7a5 \uc88b\uc740 \uc2dc\uae30\ub294 \ud22c\uc218\uc758 \uacf5 \ub358\uc9c0\uae30 \uc18d\ub3c4\uac00 \ub290\ub9ac\uace0 \ud3ec\uc218\uc758 \ud314\uc774 \uc57d\ud560 \ub54c\uc785\ub2c8\ub2e4. \uc2dc\ub3c4\ud558\uae30 \uc804\uc5d0 \ud1b5\uacc4\ub97c \ubd84\uc11d\ud558\uc2ed\uc2dc\uc624. 1\ub2e8\uacc4: \ud22c\uc218\uc758 \uacbd\ud5a5\uc744 \uad00\ucc30\ud558\uc2ed\uc2dc\uc624. 2\ub2e8\uacc4: \ud3ec\uc218\uc758 \ub358\uc9c0\uae30 \ud314 \ud798\uc744 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. 3\ub2e8\uacc4: \uac8c\uc784 \uc0c1\ud669(\ub4dd\uc810, \uc544\uc6c3 \uc218 \ub4f1)\uc744 \uace0\ub824\ud558\uc2ed\uc2dc\uc624. \uc218\ube44 \uc804\uc220\uc5d0\ub294 \ub0b4\uc57c \uc26c\ud504\ud2b8\ub97c \uc801\uc6a9\ud558\uace0 \ud0c0\uc790\uc5d0 \ub530\ub77c \uc678\uc57c \uae4a\uc774\ub97c \uc870\uc815\ud558\ub294 \uac83\ub3c4 \ud3ec\ud568\ub429\ub2c8\ub2e4. \ub3c4\ub8e8\ub294 \uacc4\uc0b0\ub41c \uc704\ud5d8\uc73c\ub85c \uac04\uc8fc\ud558\uba70, \uc7a0\uc7ac\uc801\uc778 \ubcf4\uc0c1\uc744 \uc7a1\ud788\ub294 \uc704\ud5d8\uacfc \ube44\uad50\ud574\uc57c \ud569\ub2c8\ub2e4. \ud3ec\uc218\uc758 \ub0ae\uc740 \ub358\uc9c0\uae30 \uc815\ud655\ub3c4\ub294 \ub3c4\ub8e8 \uc131\uacf5\ub960\uc744 \ub192\uc5ec\uc90d\ub2c8\ub2e4."}, {"question": "\uad6c\uae00 \uc57c\uad6c: \uc120\uc218 \ud1b5\uacc4\uac00 \uc2dc\ubbac\ub808\uc774\uc158 \uacb0\uacfc\uc640 \uc120\uc218 \uc131\uc7a5\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\uba70, \ud654\ud559\uc758 \uc911\uc694\uc131\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uad6c\uae00 \uc57c\uad6c\uc5d0\uc11c \uc120\uc218 \ud1b5\uacc4\ub294 \uc2dc\ubbac\ub808\uc774\uc158 \uacb0\uacfc\uc5d0 \uc0c1\ub2f9\ud55c \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc73c\ub85c \ub192\uc740 \ud1b5\uacc4\ub294 \ub354 \ub098\uc740 \uc131\ub2a5\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4. \uc120\uc218 \uc131\uc7a5\uc740 \uafb8\uc900\ud55c \ud50c\ub808\uc774\uc640 \ud6c8\ub828\uc5d0 \uc5f0\uacb0\ub429\ub2c8\ub2e4. 1\ub2e8\uacc4: \uc57d\uc810 \uc601\uc5ed\uc5d0 \uc9d1\uc911\ud558\uc5ec \ud6c8\ub828\ud558\uc2ed\uc2dc\uc624. 2\ub2e8\uacc4: \uc120\uc218\ub97c \uc120\ud638\ud558\ub294 \ud3ec\uc9c0\uc158\uc5d0 \ubc30\uce58\ud558\uc2ed\uc2dc\uc624. 3\ub2e8\uacc4: \ud53c\ub85c\ub97c \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \uc5d0\ub108\uc9c0 \uc218\uc900\uc744 \ubaa8\ub2c8\ud130\ub9c1\ud558\uc2ed\uc2dc\uc624. \uc120\uc218 \ud654\ud559\ub825 \ubcf4\ub108\uc2a4\ub294 \ud300\uc73c\ub85c\uc11c \ub354 \ub098\uc740 \uc131\ub2a5\uc744 \ubc1c\ud718\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \ud300 \uad6c\uc131\uc6d0\uc758 \ud654\ud559\ub825\uc774 \ub192\uc73c\uba74 \ud300 \uc131\ub2a5\uc5d0 \uc0c1\ub2f9\ud55c \ubcc0\ud654\uac00 \uc788\uc74c\uc744 \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uad6c\uae00 \uc57c\uad6c \uacbd\uc81c: \uc7a5\uae30\uc801\uc778 \ud300 \uac1c\ubc1c\uc5d0 \uac00\uc7a5 \ub3c4\uc6c0\uc774 \ub418\ub294 \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \ubb34\uc5c7\uc774\uba70, \ud300 \uc608\uc0b0\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uad6c\uae00 \uc57c\uad6c\uc5d0\uc11c \ud0c0\uaca9, \ud22c\uad6c \ubc0f \uc218\ube44\uc640 \uac19\uc740 \uc8fc\uc694 \uc120\uc218 \ud1b5\uacc4\ub97c \uac1c\uc120\ud558\ub294 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \uace0\ub824\ud558\uc2ed\uc2dc\uc624. \ud6a8\uc728\uc801\uc778 \uc608\uc0b0 \uad00\ub9ac\uc5d0\ub294 \uc80a\uc740 \uc7ac\ub2a5\uc744 \uc2a4\uce74\uc6b0\ud2b8\ud558\uace0 \uc790\uc720 \uacc4\uc57d \uc120\uc218\uc5d0\uac8c \uacfc\ub3c4\ud55c \uae08\uc561\uc744 \uc9c0\ubd88\ud558\uc9c0 \uc54a\uc73c\uba70 \ub9c8\uc774\ub108\ub9ac\uadf8 \uc2dc\uc2a4\ud15c\uc5d0 \ud22c\uc790\ud558\ub294 \uac83\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc774\ub97c \ud1b5\ud574 \uc2dc\uac04\uc774 \uc9c0\ub0a8\uc5d0 \ub530\ub77c \uc9c0\uc18d \uac00\ub2a5\ud558\uace0 \uacbd\uc7c1\ub825 \uc788\ub294 \ud300\uc744 \uad6c\ucd95\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ube44\uc6a9 \ub300\ube44 \ud6a8\uacfc \ubd84\uc11d\uc740 \uc7a0\uc7ac\uc801\uc778 \uc120\uc218\uac00 \uace0\uac00\uc5d0 \ud574\ub2f9\ud558\ub294\uc9c0 \uc5ec\ubd80\ub97c \ud655\uc778\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\uad6c\uae00 \uc57c\uad6c\uc640 \ud604\uc2e4: \uc120\uc218 \ud3c9\uc810\uc774 \uc2e4\uc81c \uc57c\uad6c \ub2a5\ub825\uc744 \uc5bc\ub9c8\ub098 \uc815\ud655\ud558\uac8c \ubc18\uc601\ud558\uba70, \ud22c\uad6c-\ud0c0\uaca9 \uacb0\uacfc\uc5d0 \ub300\ud55c \uae30\ubcf8 \uacc4\uc0b0\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uad6c\uae00 \uc57c\uad6c\uc758 \uc120\uc218 \ud3c9\uc810\uc740 \uc2e4\uc81c \ub2a5\ub825\uc744 \uadfc\uc0ac\ud558\ub824\ub294 \uac83\uc774\uc9c0\ub9cc, \uac8c\uc784 \uade0\ud615 \uace0\ub824 \uc0ac\ud56d\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \ub2e4\ub985\ub2c8\ub2e4. \ud22c\uad6c \uacb0\uacfc\ub294 \ud22c\uc218\uc758 \uc815\ud655\uc131\uacfc \ud0c0\uc790\uc758 \uad6c\uc885\uc5d0 \ub300\ud55c \uae30\uc220\uc744 \uace0\ub824\ud558\ub294 \ubcf5\uc7a1\ud55c \uacc4\uc0b0\uc785\ub2c8\ub2e4. \ud0c0\uc790\uc758 \ud0c0\uc774\ubc0d\uacfc \uc2a4\uc719 \ub2a5\ub825\uc774 \uc774 \ud504\ub85c\uc138\uc2a4\uc5d0 \uc0c1\ub2f9\ud55c \uc5ed\ud560\uc744 \ud569\ub2c8\ub2e4. \ub0b4\ubd80\uc801\uc73c\ub85c\ub294 \uc57d\uac04\uc758 \ube14\ub799\ubc15\uc2a4\uc774\uc9c0\ub9cc, \uacf5\uc2dd\uc740 \ud655\ub960\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uc774\ub294 \uac8c\uc784\uc5d0 \ud604\uc2e4\uc801\uc774\uace0 \uc608\uce21\ud560 \uc218 \uc5c6\ub294 \uc694\uc18c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4."}, {"question": "\ud50c\ub7ab\ud3fc \uac04 \uad6c\uae00 \uc57c\uad6c: \ud300\uacfc \uc9c4\ud589 \uc0c1\ud669\uc774 \ub2e4\ub978 \uc7a5\uce58(Android/iOS) \uc0ac\uc774\uc5d0\uc11c \uc804\uc1a1\ub429\ub2c8\uae4c? \uc6d0\ud65c\ud55c \ub370\uc774\ud130 \ub9c8\uc774\uadf8\ub808\uc774\uc158\uc744 \ubcf4\uc7a5\ud558\uae30 \uc704\ud574 \ud544\uc694\ud55c \ub2e8\uacc4\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uad6c\uae00 \uc57c\uad6c\ub294 \uc77c\ubc18\uc801\uc73c\ub85c Android \ubc0f iOS \uc7a5\uce58 \uac04\uc5d0 \ud50c\ub7ab\ud3fc \uac04 \ub370\uc774\ud130 \uc804\uc1a1\uc744 \ud5c8\uc6a9\ud569\ub2c8\ub2e4. \uac8c\uc784\uc744 Google \uacc4\uc815 \ub610\ub294 \ub2e4\ub978 \uc9c0\uc6d0 \uacc4\uc815(\uc608: Facebook)\uc5d0 \uc5f0\uacb0\ud558\uc2ed\uc2dc\uc624. \uadf8\ub7f0 \ub2e4\uc74c \uc0c8 \uc7a5\uce58\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud558\uc2ed\uc2dc\uc624. \uc815\ud655\ud55c \ubc29\ubc95\uc740 \ubc84\uc804\uc5d0 \ub530\ub77c \uc57d\uac04 \ub2e4\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub370\uc774\ud130 \uc804\uc1a1\uc774 \uc791\ub3d9\ud558\uc9c0 \uc54a\uc73c\uba74 \uac8c\uc784 \uace0\uac1d \uc9c0\uc6d0\ud300\uc5d0 \ubb38\uc758\ud558\uc5ec \ub3c4\uc6c0\uc744 \ubc1b\uc73c\uc2ed\uc2dc\uc624. \uc6d0\ud65c\ud55c \ub370\uc774\ud130 \ub9c8\uc774\uadf8\ub808\uc774\uc158\uc744 \ubcf4\uc7a5\ud558\ub824\uba74 \uc548\uc815\uc801\uc778 \ub124\ud2b8\uc6cc\ud06c \uc5f0\uacb0\uc744 \uc720\uc9c0\ud558\uace0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc815\uae30\uc801\uc73c\ub85c \ubc31\uc5c5\ud558\uc2ed\uc2dc\uc624."}, {"question": "\uad6c\uae00 \uc57c\uad6c \uc774\uc2a4\ud130 \uc5d0\uadf8: \uc228\uaca8\uc9c4 \uad6c\uc7a5\uc774\ub098 \uc7a0\uae08 \ud574\uc81c \uac00\ub2a5\ud55c \uc120\uc218\uac00 \uc788\uc2b5\ub2c8\uae4c? \uc131\ucde8 \ud5cc\ud130\ub97c \uc704\ud574 \uc5b4\ub5bb\uac8c \uc7a0\uae08\uc744 \ud574\uc81c\ud569\ub2c8\uae4c?", "answer": "\uad6c\uae00 \uc57c\uad6c\uc5d0\ub294 \ud5cc\uc2e0\uc801\uc778 \ud50c\ub808\uc774\uc5b4\ub97c \ubcf4\uc0c1\ud558\ub294 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc77c\ubd80 \uc774\uc2a4\ud130 \uc5d0\uadf8\uc5d0\ub294 \ud2b9\uc815 \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\ub294 \uac83\uc774 \ud3ec\ud568\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud074\ub798\uc2dd \uad6c\uc7a5 \uc2a4\ud0a8\uc744 \ud574\uc81c\ud558\ub824\uba74 \ucd5c\uace0 \ub09c\uc774\ub3c4\uc5d0\uc11c \ucc54\ud53c\uc5b8\uc2ed\uc744 \uc6b0\uc2b9\ud574\uc57c \ud560 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ubcf4\ub108\uc2a4\ub97c \uc5bb\uc73c\ub824\uba74 \uac8c\uc784\uc5d0 \uc815\uae30\uc801\uc73c\ub85c \ub85c\uadf8\uc778\ud574\uc57c \ud569\ub2c8\ub2e4. \uac8c\uc784\uc744 \uacc4\uc18d \ud0d0\uc0c9\ud558\uba74 \uc774\ub7ec\ud55c \ubcf4\ub108\uc2a4\uc5d0 \ub300\ud574 \uc810\uc810 \ub354 \ub9ce\uc774 \uc54c\uac8c \ub420 \uac83\uc785\ub2c8\ub2e4. \uae4a\uc774 \ud30c\ud5e4\uccd0\ubcf4\uc138\uc694. \ud765\ubbf8\ub85c\uc6b4 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc744 \ubc1c\uacac\ud560 \uac83\uc785\ub2c8\ub2e4."}]
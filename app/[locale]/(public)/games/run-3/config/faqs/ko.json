[{"question": "\ub7f0 3 \uae30\ubcf8: \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub85c\uc11c \uacf5\uc911\uc81c\ube44\ub97c \ub6f0\uace0 \uade0\uc5f4\uc5d0 \ube60\uc9c0\uc9c0 \uc54a\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub7f0 3\uc758 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub85c\uc11c, \uc810\ud504\ub294 \uc0dd\uc874\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4! \uac04\ub2e8\ud788 \uc2a4\ud398\uc774\uc2a4\ubc14 \ub610\ub294 \ub9c8\uc6b0\uc2a4 \uc67c\ucabd \ubc84\ud2bc\uc744 \ub20c\ub7ec \uc810\ud504\ud558\uc138\uc694. \uade0\uc5f4\uc5d0 \ube60\uc9c0\uc9c0 \uc54a\uc73c\ub824\uba74 \uc55e\uc73c\ub85c\uc758 \uacbd\ub85c\ub97c \uad00\ucc30\ud558\uc5ec \uc55e\uc73c\ub85c \ub2e4\uac00\uc62c \ud2c8\uc0c8\ub97c \uc608\uce21\ud558\uc138\uc694. \ucc98\uc74c\uc5d0\ub294 \uc9e7\uace0 \uc81c\uc5b4\ub41c \uc810\ud504\uac00 \ub354 \uc548\uc804\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c\ub294 \ub354 \uae34 \uc810\ud504\ub97c \uc2dc\ub3c4\ud558\uae30 \uc804\uc5d0 \ucc98\uc74c \ub098\ud0c0\ub098\ub294 \uc791\uc740 \ud2c8\uc0c8\ub97c \ub6f0\uc5b4\ub118\ub294 \uc5f0\uc2b5\uc744 \ud558\uc138\uc694. \ud6cc\ub77c\ud6c4\ud504\ucc98\ub7fc \u2013 \uc791\uace0 \uc2e0\uc911\ud55c \uc6c0\uc9c1\uc784\uc744 \uc0dd\uac01\ud558\uc138\uc694."}, {"question": "\ub7f0 3\uc5d0\uc11c \uc65c \uc81c \ub7f0\ub108\uac00 \ub54c\ub54c\ub85c \ubb34\uc791\uc704\ub85c \ubc29\ud5a5\uc744 \ubc14\uafb8\uace0 \uc774\ub97c \uc5b4\ub5bb\uac8c \ubc29\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub7f0\ub108\uac00 \ub808\ubca8\uc758 \uae30\ud558\ud559\uacfc \uc911\ub825 \ub54c\ubb38\uc5d0 \ubc29\ud5a5\uc744 \ubc14\uafc9\ub2c8\ub2e4. \ubcbd\uc744 \ub530\ub77c '\uc704\ub85c' \ub2ec\ub9b4 \uc218 \uc788\uc73c\uba70 \ub05d\uc5d0 \ub3c4\ub2ec\ud558\uba74 \uc911\ub825\uc774 \uc791\uc6a9\ud558\uc5ec \ub2e4\uc74c \ubcbd\uc744 \ub530\ub77c '\uc544\ub798\ub85c' \ub2ec\ub9ac\uac8c \ud558\uc5ec \ubc29\ud5a5\uc744 \ubc14\uafc9\ub2c8\ub2e4. \uc6d0\ud558\uc9c0 \uc54a\ub294 \ubcc0\ud654\ub97c \ubc29\uc9c0\ud558\ub824\uba74 \ubcbd\uc5d0 \uc9c1\uc811 \ub2ec\ub9ac\uae30 \ub300\uc2e0 \ubcbd\uc744 \ub6f0\uc5b4\ub118\uac70\ub098 \ud2c8\uc0c8\ub97c \ud1b5\ud574 \uc8fc \uacbd\ub85c\uc5d0 \uba38\ubb34\ub974\uc138\uc694. \ucc28\ub97c \uc6b4\uc804\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ubcbd\uc5d0 \ubd80\ub52a\ud788\uba74 \uc6d0\ud558\ub294 \uacf3\uc73c\ub85c \uac00\uc9c0 \uc54a\uc744 \uac83\uc785\ub2c8\ub2e4. \uc911\uc559\uc5d0 \uba38\ubb34\ub974\ub824\uace0 \ub178\ub825\ud558\uc138\uc694."}, {"question": "\ub7f0 3\uc5d0\ub294 \uc5b4\ub5a4 \uc720\ud615\uc758 \ub7f0\ub108\uac00 \uc788\uc73c\uba70 \uac01 \ub7f0\ub108 \uc720\ud615\uc740 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ub7f0 3\uc5d0\ub294 \uac01\uac01 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc5ec\ub7ec \uac00\uc9c0 \uace0\uc720\ud55c \ub7f0\ub108 \uc720\ud615\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ub7f0\ub108(\uae30\ubcf8, \uade0\ud615), \uc2a4\ucf00\uc774\ud130(\ube60\ub984, \uc810\ud504 \ub0ae\uc74c), \uac70\ub300\ud55c \ub7f0\ub108(\ub290\ub9bc, \uc548\uc815\uc801), \ubc0f \uae30\ud0c0 \ud574\uae08 \uce90\ub9ad\ud130\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc2a4\ucf00\uc774\ud130\ub294 \uc18d\ub3c4\uac00 \ube68\ub77c\uc11c \uc2a4\ud53c\ub4dc\ub7f0\uc5d0 \uc801\ud569\ud558\uba70 \ub808\uc77c\uc744 \ubc00\uace0 \ud2b9\uc815 \uc601\uc5ed\uc744 \uc6b0\ud68c\ud560 \uc218 \uc788\uc9c0\ub9cc \uc810\ud504\ub97c \uc704\ud574 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uac01 \uce90\ub9ad\ud130\ub85c \uc2e4\ud5d8\ud558\uc5ec \uc790\uc2e0\uc5d0\uac8c \ub9de\ub294 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub300\ud574 \uc54c\uc544\ubcf4\uc138\uc694. \uc544\ub798 \ud45c\ub294 \uc8fc\uc694 \ucc28\uc774\uc810\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4. \n[\ub7f0\ub108 \uc720\ud615 | \uc18d\ub3c4 | \uc810\ud504 \ub192\uc774 | \uc548\uc815\uc131]\n[\ub7f0\ub108 | \uc911\uac04 | \uc911\uac04 | \uc911\uac04]\n[\uc2a4\ucf00\uc774\ud130 | \ub192\uc74c | \ub0ae\uc74c | \ub0ae\uc74c]\n[\uac70\ub300\ud55c \ub7f0\ub108 | \ub0ae\uc74c | \ub192\uc74c | \ub192\uc74c]"}, {"question": "\ub7f0 3 \uace0\uae09 \uae30\uc220: \ubb34\ud55c \ubaa8\ub4dc\uc5d0\uc11c \uac70\ub9ac\ub97c \uadf9\ub300\ud654\ud558\uae30 \uc704\ud55c \uace0\uae09 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubb34\ud55c \ubaa8\ub4dc\uc5d0\uc11c \uac70\ub9ac\ub97c \uadf9\ub300\ud654\ud558\ub824\uba74 \ub2e4\uc74c \uace0\uae09 \uc804\ub7b5\uc744 \ub9c8\uc2a4\ud130\ud558\uc138\uc694. STEP 1: \ud0c0\uc774\ubc0d\uc744 \uc644\ubcbd\ud558\uac8c \ud558\uc138\uc694. \ud2c8\uc0c8\ub97c \uc77c\uad00\ub418\uac8c \ub6f0\uc5b4\ub118\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. STEP 2: \ubcbd\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\uc138\uc694. \ubcbd\uc744 \uc7a0\uc2dc \ub2ec\ub9ac\uba74 \uada4\uc801\uc73c\ub85c \uc870\uc815\ud558\uc5ec \uc7a5\uc560\ubb3c\uc744 \uc6b0\ud68c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP 3: \ub808\ubca8 \ub808\uc774\uc544\uc6c3\uc744 \ubc30\uc6b0\uc138\uc694. \ub354 \ube60\ub974\uac8c \ubc18\uc751\ud560 \uc218 \uc788\ub3c4\ub85d \ud328\ud134\uc744 \uae30\uc5b5\ud558\uc138\uc694. \ubb34\ud55c \ubaa8\ub4dc\ub97c \ub9c8\ub77c\ud1a4\ucc98\ub7fc \uc0c1\uc0c1\ud574 \ubcf4\uc138\uc694. \uc18d\ub3c4\ub97c \uc720\uc9c0\ud558\uace0 \uacbd\uacc4\ub97c \ub2a6\ucd94\uc9c0 \uc54a\uace0 \uacbd\ub85c\ub97c \ud559\uc2b5\ud558\uc138\uc694."}, {"question": "\ub7f0 3 \ube44\ubc00: \ub7f0 3\uc5d0\ub294 \uc8fc \uba54\ub274\uc5d0 \ud45c\uc2dc\ub418\uc9c0 \uc54a\ub294 \ub808\ubca8\uc774 \uc788\uc2b5\ub2c8\uae4c, \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub124, \ub7f0 3\uc5d0\ub294 \ud2b9\uc815 \uc791\uc5c5\uc744 \ud1b5\ud574 \uc228\uaca8\uc9c4 \ube44\ubc00 \ub808\ubca8 \ub610\ub294 '\uc624\ub958' \ub808\ubca8\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud2b9\uc815 \uce90\ub9ad\ud130 \uc120\ud0dd \uc870\ud569\uacfc \ub808\ubca8 \uc9c4\uc785 \uc21c\uc11c\uac00 \ub808\ubca8 \ub85c\ub4dc \uc624\ub958\ub97c \uc720\ubc1c\ud558\uc5ec \uc758\ub3c4\ud558\uc9c0 \uc54a\uc740 \ub3c5\ud2b9\ud558\uace0 \uc5b4\ub824\uc6b4 \uc9c0\ub3c4\ub85c \uc774\uc5b4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubcf4\uc7a5\ub41c \ud2b8\ub9ac\uac70\ub294 \uc5c6\uc2b5\ub2c8\ub2e4. \ub2e4\ub978 \uc870\ud569\uc744 \uc2dc\ud5d8\ud558\uc5ec \ucc3e\uc544\ubcf4\uc138\uc694. \uace0\uc804 \uac8c\uc784\uc758 \uc228\uaca8\uc9c4 \ud301\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc2e4\ud5d8\uc744 \ud1b5\ud574 \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub7f0 3 \ucc4c\ub9b0\uc9c0: \uac00\uc7a5 \uc5b4\ub824\uc6b4 '\ubb34\ud55c \ubaa8\ub4dc' \ucc4c\ub9b0\uc9c0\uc640 \ub9ac\ub354\ubcf4\ub4dc \uc21c\uc704\ub97c \uadf9\ubcf5\ud558\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc5b4\ub824\uc6b4 '\ubb34\ud55c \ubaa8\ub4dc' \ucc4c\ub9b0\uc9c0\ub97c \uc815\ubcf5\ud558\ub824\uba74 \uae30\uc220\uacfc \uc804\ub7b5\uc801 \uc120\ud0dd\uc758 \uc870\ud569\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc7a5\uc560\ubb3c \uc608\uce21, \ub808\ubca8 \uae30\uc5b5, \uce90\ub9ad\ud130 \uc801\ud569\uc131\uc744 \uc6b0\uc120\uc21c\uc704\ub85c \ub450\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uc2a4\ucf00\uc774\ud130'\ub294 \uc18d\ub3c4 \ub54c\ubb38\uc5d0 \ub9ac\ub354\ubcf4\ub4dc \uacbd\uc7c1\uc790\ub4e4 \uc0ac\uc774\uc5d0\uc11c \uc778\uae30\uac00 \ub9ce\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \ud2b9\uc815 \uc5b4\ub824\uc6b4 \uad6c\uac04\uc744 \ubc18\ubcf5\uc801\uc73c\ub85c \uc5f0\uc2b5\ud558\uc5ec \uadfc\uc721 \uae30\uc5b5\ub825\uc744 \ud5a5\uc0c1\uc2dc\ucf1c \ubcf4\uc138\uc694. \ucd5c\uc801\uc758 \uacbd\ub85c\uc640 \uae30\uc220\uc5d0 \ub300\ud55c \ud1b5\ucc30\ub825\uc744 \uc5bb\uae30 \uc704\ud574 \uc0c1\uc704 \ud50c\ub808\uc774\uc5b4\uc758 \uc2e4\ud589\uc744 \uac80\ud1a0\ud558\uc138\uc694. \ub808\uc774\uc2a4 \uc900\ube44\uc640 \uac19\uc2b5\ub2c8\ub2e4. \uc5f4\uc2ec\ud788 \ud6c8\ub828\ud558\uace0 \ucf54\uc2a4\ub97c \uc54c\uace0 \uc804\ubb38\uac00\ub97c \uc9c0\ucf1c\ubcf4\uc138\uc694."}, {"question": "\ub7f0 3 \uc2ec\uce35 \ubd84\uc11d: \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \ubb3c\ub9ac\ud559 \ubc0f \ucda9\ub3cc \uac10\uc9c0 \uc2dc\uc2a4\ud15c\uc744 \uc124\uba85\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub7f0 3\ub294 \uc6b4\ub3d9\ub7c9\uacfc \uc911\ub825\uc774 \uc8fc\uc694 \uc694\uc18c\uc778 \ub2e8\uc21c\ud654\ub41c \ubb3c\ub9ac \uc2dc\uc2a4\ud15c\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ucda9\ub3cc \uac10\uc9c0\ub294 \uc77c\uc815 \uc815\ub3c4\uc758 \uc5ec\uc720\ub97c \uac16\ub294 \uacbd\uacc4 \uc0c1\uc790\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc989, \ube14\ub85d\uc758 \uac00\uc7a5\uc790\ub9ac\uc640 \uc644\ubcbd\ud558\uac8c \ud53d\uc140 \ub2e8\uc704\ub85c \ucda9\ub3cc\ud558\uc9c0 \uc54a\uc73c\ubbc0\ub85c \uac00\uae4c\uc2a4\ub85c \ucda9\ub3cc\ud55c \ud6c4 \ud68c\ubcf5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc81c\ud55c\uc744 \uc54c\uba74 \uc6c0\uc9c1\uc784\uc744 \ub354 \uc798 \uc608\uce21\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc22b\uc790 \uac12\uc5d0 \uad00\ud574\uc11c\ub294 \uac00\uc18d\ub3c4\uac00 \ud504\ub808\uc784\ub2f9 X \ub2e8\uc704\ub85c \uc124\uc815\ub429\ub2c8\ub2e4."}, {"question": "\ub7f0 3 \ubb34\ud55c \ubaa8\ub4dc\uc758 \ub09c\uc774\ub3c4 \uc870\uc815 \ubc29\uc2dd\uc740 \ubb34\uc5c7\uc774\uba70, \uc774\ub97c \uc870\uc791\ud560 \uc218 \uc788\ub294 \ud301\uc774 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub7f0 3\uc758 \ubb34\ud55c \ubaa8\ub4dc\uc5d0\uc11c \ub09c\uc774\ub3c4\ub294 \uc774\ub3d9\ud55c \uac70\ub9ac\uc5d0 \ub530\ub77c \ub3d9\uc801\uc73c\ub85c \uc870\uc815\ub429\ub2c8\ub2e4. \uc2dc\uc2a4\ud15c\uc758 \ud575\uc2ec \uc6d0\uce59\uc740 \uc801\uc218 \ube48\ub3c4, \uacbd\ub85c \ubcf5\uc7a1\uc131 \ubc0f \uc18d\ub3c4\uc785\ub2c8\ub2e4. \ud55c \uac00\uc9c0 \ud301\uc740 \ud2b9\uc815 \uc9c0\uc810\uc5d0\uc11c \uc758\ub3c4\uc801\uc73c\ub85c \uc774\uc804 \ub808\ubca8\ub4e4\uc744 \ubc18\ubcf5\ud574\uc11c \uc2e4\ud328\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uac8c\uc784\uc740 \uc77c\ub828\uc758 \ub808\ubca8 \uc2e4\ud328 \ud6c4 \uc774\ub97c \uc885\uc885 \uc870\uc815\ud569\ub2c8\ub2e4. \ud2b9\uc815 \uc9c0\uc810\uc5d0\uc11c \uc2e4\ud328\ud558\uace0 \uc788\ub2e4\uba74 \uadf8 \uc9c0\uc810 \uc774\uc804\uc5d0\uc11c \uc2e4\ud328\ud574 \ubcf4\uc138\uc694. \uc774\ub7f0 \ud589\ub3d9\uc774 \ub9e4\uac1c\ubcc0\uc218\uc5d0 \uc601\ud5a5\uc744 \uc8fc\ub294\uc9c0 \ud655\uc778\ud574\ubcf4\uc138\uc694. \uc870\uc815\uc740 \uc99d\ubd84\uc801\uc774\ubbc0\ub85c \uc774\uc804 \ub9e4\uac1c\ubcc0\uc218\uc5d0 \ub530\ub77c \uc5ec\ub7ec \ubc88\uc758 \uc2e4\ud328\uac00 \ud544\uc694\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub7f0 3: \uc6f9 \ubc84\uc804\uacfc \uc571 \ubc84\uc804 \uac04\uc5d0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c? \uac00\ub2a5\ud558\ub2e4\uba74 \uc5b4\ub5bb\uac8c \ud569\ub2c8\uae4c?", "answer": "\uc77c\ubc18\uc801\uc73c\ub85c \ub7f0 3\uc758 \uc6f9 \ubc84\uc804\uacfc \ubaa8\ubc14\uc77c \uc571 \ubc84\uc804 \uac04\uc5d0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc9c1\uc811 \uc804\uc1a1\ud558\ub294 \uac83\uc740 \uc9c0\uc6d0\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uac01 \ubc84\uc804\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \ubcc4\ub3c4\uc758 \uc800\uc7a5 \ub370\uc774\ud130\ub85c \ub3c5\ub9bd\uc801\uc73c\ub85c \uc791\ub3d9\ud569\ub2c8\ub2e4. \uac8c\uc784 \ub0b4\uc5d0\uc11c \uc774\ub4e4\uc744 \ub3d9\uae30\ud654\ud558\ub294 \uae30\ub2a5\uc740 \uc5c6\uc2b5\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \uc77c\ubd80 \ube0c\ub77c\uc6b0\uc800 \ubc84\uc804\uc5d0\uc11c\ub294 \ucfe0\ud0a4\ub97c \ub0b4\ubcf4\ub0b4 \uac00\ub2a5\ud55c \ub85c\uceec \ubc31\uc5c5\uc744 \ud5c8\uc6a9\ud569\ub2c8\ub2e4(\uae30\ub2a5\uc740 \uacf5\uc2dd\uc801\uc73c\ub85c \ud14c\uc2a4\ud2b8\ub418\uc9c0 \uc54a\uc74c)."}, {"question": "\ub7f0 3 \uc774\uc2a4\ud130 \uc5d0\uadf8: \ub7f0 3\uc758 \uac00\uc7a5 \uba4b\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uc640 \uc228\uaca8\uc9c4 \ucc38\uace0 \uc790\ub8cc\ub294 \ubb34\uc5c7\uc774\uba70, \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub7f0 3\uc5d0\ub294 \uc5ec\ub7ec \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc885\uc885 \ub2e4\ub978 \ud50c\ub798\uc2dc \uac8c\uc784\uacfc \uc778\ud130\ub137 \ubb38\ud654\ub97c \ucc38\uc870\ud569\ub2c8\ub2e4. \uac00\uc7a5 \uc561\uc138\uc2a4\ud558\uae30 \uc26c\uc6b4 \uc774\uc2a4\ud130 \uc5d0\uadf8 \uc911 \ud558\ub098\ub294 \ud2b9\uc815 \ubb34\ud55c \ub808\ubca8\uc5d0\uc11c \ubcf4\ub77c\uc0c9 \ub7f0\ub108\uc640 \uad00\ub828\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \ud2b9\uc815 \ub808\ubca8\uc744 \uc704\ud574 \ubc18\ub4dc\uc2dc \ubcf4\ub77c\uc0c9 \ub7f0\ub108\uc5ec\uc57c \ud569\ub2c8\ub2e4. \ud2b9\uc815 \uacbd\ub85c\ub97c \ub9e4\uc6b0 \uc624\ub7ab\ub3d9\uc548 \uc9c0\uc18d\uc801\uc73c\ub85c \ub2ec\ub9ac\uba74 '8\ube44\ud2b8' \uc2a4\ud0c0\uc77c\uc758 \ubc30\uacbd\uc774 \ub098\ud0c0\ub098\ub294 \uc2dc\uac01\uc801 \uc774\uc0c1 \ud604\uc0c1\uc774 \ubc1c\uc0dd\ud569\ub2c8\ub2e4. \ub354 \ub9ce\uc740 \uac83\uc744 \ubc1c\uacac\ud558\uae30 \uc704\ud574 \uae34 \uc2e4\ud589\uc744 \uc2dc\ub3c4\ud558\uc138\uc694. \uac8c\uc784\uc5d0\uc11c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ucc3e\ub294 \uac83\uc740 \ubbf8\ub2c8 \uac8c\uc784\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
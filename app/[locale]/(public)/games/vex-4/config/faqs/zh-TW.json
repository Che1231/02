[{"question": "\u5982\u4f55\u5728 Vex 4 \u4e2d\u57f7\u884c\u57fa\u672c\u52d5\u4f5c\uff0c\u4f8b\u5982\u8df3\u8e8d\u548c\u6ed1\u52d5\uff1f", "answer": "\u5728 Vex 4 \u4e2d\uff0c\u57fa\u672c\u52d5\u4f5c\u5c0d\u65bc\u904a\u73a9\u95dc\u5361\u81f3\u95dc\u91cd\u8981\u3002\u8981\u8df3\u8e8d\uff0c\u8acb\u6309 \"\u7a7a\u767d\u9375\" \u6216\u87a2\u5e55\u4e0a\u7684\u8df3\u8e8d\u6309\u9215\u3002\u8981\u6ed1\u52d5\uff0c\u8acb\u6309 \"\u5411\u4e0b\u7bad\u982d\u9375\" \u6216\u6ed1\u52d5\u6309\u9215\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u95dc\uff0c\u60a8\u9700\u8981\u8df3\u904e\u4e00\u500b\u9677\u9631\u4e26\u6ed1\u904e\u4f4e\u77ee\u7684\u969c\u7919\u3002\u53ca\u65e9\u638c\u63e1\u9019\u4e9b\u52d5\u4f5c\u5c07\u6709\u52a9\u65bc\u60a8\u9806\u5229\u9032\u968e\u3002"}, {"question": "\u5b8c\u6210 Vex 4 \u4e2d\u56f0\u96e3\u95dc\u5361\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5b8c\u6210 Vex 4 \u4e2d\u56f0\u96e3\u95dc\u5361\u9700\u8981\u7cbe\u6e96\u5ea6\u548c\u6642\u9593\u7684\u914d\u5408\u3002\u6b65\u9a5f\u4e00\uff1a\u5206\u6790\u95dc\u5361\u4f48\u5c40\uff0c\u8b58\u5225\u5371\u96aa\u548c\u5b89\u5168\u8def\u7dda\u3002\u6b65\u9a5f\u4e8c\uff1a\u53cd\u8986\u7df4\u7fd2\u6bcf\u4e00\u90e8\u5206\uff0c\u4f7f\u60a8\u7684\u52d5\u4f5c\u9054\u5230\u5b8c\u7f8e\u3002\u6b65\u9a5f\u4e09\uff1a\u5584\u7528\u6aa2\u67e5\u9ede\uff0c\u907f\u514d\u5f9e\u982d\u958b\u59cb\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 10 \u95dc\uff0c\u6e96\u78ba\u638c\u63e1\u8df3\u8e8d\u6642\u9593\u4ee5\u907f\u958b\u79fb\u52d5\u7684\u5e73\u53f0\u81f3\u95dc\u91cd\u8981\u3002[\u6d41\u7a0b\u5716\uff1a\u5206\u6790 -> \u7df4\u7fd2 -> \u57f7\u884c]"}, {"question": "\u70ba\u4ec0\u9ebc Vex 4 \u4e2d\u7684\u4e00\u4e9b\u95dc\u5361\u6703\u6709\u96b1\u85cf\u7684\u6536\u96c6\u54c1\uff0c\u4ee5\u53ca\u5982\u4f55\u627e\u5230\u5b83\u5011\uff1f", "answer": "Vex 4 \u4e2d\u7684\u96b1\u85cf\u6536\u96c6\u54c1\u589e\u52a0\u4e86\u984d\u5916\u7684\u6311\u6230\u548c\u734e\u52f5\u3002\u9019\u4e9b\u7269\u54c1\u901a\u5e38\u4f4d\u65bc\u96e3\u4ee5\u5230\u9054\u7684\u5730\u65b9\uff0c\u6216\u9700\u8981\u7279\u6b8a\u7684\u52d5\u4f5c\u624d\u80fd\u986f\u793a\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e94\u95dc\uff0c\u60a8\u9700\u8981\u8df3\u5230\u96b1\u85cf\u7684\u5e73\u53f0\u4e0a\u624d\u80fd\u627e\u5230\u6536\u96c6\u54c1\u3002\u5fb9\u5e95\u63a2\u7d22\u6bcf\u500b\u89d2\u843d\uff0c\u4e26\u5617\u8a66\u4e0d\u540c\u7684\u52d5\u4f5c\uff0c\u53ef\u4ee5\u5e6b\u52a9\u60a8\u767c\u73fe\u9019\u4e9b\u79d8\u5bc6\u3002[\u591a\u65b9\u6848\uff1a\u63a2\u7d22 -> \u5be6\u9a57 -> \u6536\u96c6]"}, {"question": "Vex 4 \u4e2d\u54ea\u4e9b\u63a7\u5236\u9805\u53ef\u4ee5\u81ea\u8a02\uff0c\u4ee5\u53ca\u9019\u5982\u4f55\u5f71\u97ff\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "Vex 4 \u5141\u8a31\u73a9\u5bb6\u81ea\u8a02\u63a7\u5236\u9805\u4ee5\u6eff\u8db3\u4ed6\u5011\u7684\u559c\u597d\u3002\u60a8\u53ef\u4ee5\u5728\u8a2d\u5b9a\u9078\u55ae\u4e2d\u91cd\u65b0\u8a2d\u5b9a\u8df3\u8e8d\u3001\u6ed1\u52d5\u548c\u5176\u4ed6\u52d5\u4f5c\u7684\u6309\u9375\u3002\u4f8b\u5982\uff0c\u5c07\u8df3\u8e8d\u6309\u9375\u66f4\u6539\u70ba \"W\"\uff0c\u5c0d\u67d0\u4e9b\u73a9\u5bb6\u4f86\u8aaa\u53ef\u80fd\u66f4\u76f4\u89c0\u3002\u81ea\u8a02\u63a7\u5236\u9805\u53ef\u4ee5\u63d0\u5347\u60a8\u7684\u53cd\u61c9\u6642\u9593\u548c\u6574\u9ad4\u904a\u6232\u9ad4\u9a57\u3002[\u8a2d\u5b9a\u8868\uff1a\u9810\u8a2d vs. \u81ea\u8a02\u63a7\u5236\u9805]"}, {"question": "Vex 4 \u4e2d\u7684\u6aa2\u67e5\u9ede\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u4ee5\u53ca\u5b83\u7684\u5c40\u9650\u6027\u662f\u4ec0\u9ebc\uff1f", "answer": "Vex 4 \u4e2d\u7684\u6aa2\u67e5\u9ede\u7cfb\u7d71\u5141\u8a31\u73a9\u5bb6\u5728\u5931\u6557\u6642\u5f9e\u7279\u5b9a\u9ede\u91cd\u65b0\u958b\u59cb\u3002\u7576\u60a8\u901a\u904e\u6aa2\u67e5\u9ede\u6642\uff0c\u6aa2\u67e5\u9ede\u6703\u81ea\u52d5\u555f\u52d5\u3002\u4f46\u662f\uff0c\u6aa2\u67e5\u9ede\u7684\u6578\u91cf\u548c\u4f4d\u7f6e\u6709\u9650\uff0c\u56e0\u6b64\u7b56\u7565\u6027\u7684\u4f7f\u7528\u81f3\u95dc\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 15 \u95dc\uff0c\u5728\u4e00\u500b\u5177\u6709\u6311\u6230\u6027\u7684\u969c\u7919\u7269\u4e4b\u524d\u6709\u4e00\u500b\u6aa2\u67e5\u9ede\uff0c\u8b93\u60a8\u53ef\u4ee5\u5728\u4e0d\u91cd\u65b0\u958b\u59cb\u7684\u60c5\u6cc1\u4e0b\u91cd\u65b0\u5617\u8a66\u3002[\u6d41\u7a0b\u5716\uff1a\u901a\u904e\u6aa2\u67e5\u9ede -> \u5931\u6557 -> \u91cd\u65b0\u5617\u8a66]"}, {"question": "\u5c31\u904a\u6232\u6a5f\u5236\u800c\u8a00\uff0cVex 4 \u8207\u5176\u524d\u4f5c\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "\u8207\u524d\u4f5c\u76f8\u6bd4\uff0cVex 4 \u5f15\u5165\u4e86\u4e00\u4e9b\u65b0\u7684\u6a5f\u5236\u3002\u904a\u6232\u7279\u9ede\u662f\u66f4\u8907\u96dc\u7684\u95dc\u5361\u8a2d\u8a08\u3001\u984d\u5916\u7684\u52d5\u4f5c\uff08\u4f8b\u5982\uff1a\u7246\u58c1\u8df3\u8e8d\uff09\u548c\u65b0\u7684\u969c\u7919\u7269\u3002\u4f8b\u5982\uff0c\u5728 Vex 4 \u4e2d\uff0c\u60a8\u73fe\u5728\u53ef\u4ee5\u57f7\u884c\u96d9\u91cd\u8df3\u8e8d\uff0c\u9019\u5728\u65e9\u671f\u7248\u672c\u4e2d\u4e0d\u53ef\u7528\u3002\u9019\u4e9b\u8b8a\u5316\u589e\u52a0\u4e86\u904a\u6232\u7684\u6df1\u5ea6\u548c\u591a\u6a23\u6027\u3002[\u6bd4\u8f03\u8868\uff1aVex 3 vs. Vex 4 \u6a5f\u5236]"}, {"question": "\u6211\u5982\u4f55\u5c07 Vex 4 \u5728\u4e00\u500b\u88dd\u7f6e\u4e0a\u7684\u9032\u5ea6\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u88dd\u7f6e\uff1f", "answer": "\u5982\u679c\u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u529f\u80fd\uff0c\u5728 Vex 4 \u4e2d\u8de8\u88dd\u7f6e\u8f49\u79fb\u9032\u5ea6\u975e\u5e38\u7c21\u55ae\u3002\u8acb\u78ba\u4fdd\u60a8\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u90fd\u767b\u5165\u76f8\u540c\u7684\u5e33\u6236\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9e\u96fb\u8166\u8f49\u79fb\u5230\u884c\u52d5\u88dd\u7f6e\uff0c\u8acb\u4f7f\u7528\u60a8\u7684 Google Play \u6216 Apple ID \u767b\u5165\u4ee5\u540c\u6b65\u60a8\u7684\u9032\u5ea6\u3002\u9019\u78ba\u4fdd\u60a8\u53ef\u4ee5\u5f9e\u60a8\u4e0a\u6b21\u96e2\u958b\u7684\u5730\u65b9\u7e7c\u7e8c\u3002[\u591a\u65b9\u6848\uff1a\u767b\u5165 -> \u540c\u6b65 -> \u8f49\u79fb]"}, {"question": "Vex 4 \u4e2d\u6700\u5177\u6311\u6230\u6027\u7684\u969c\u7919\u7269\u6709\u54ea\u4e9b\uff0c\u4ee5\u53ca\u5982\u4f55\u514b\u670d\u5b83\u5011\uff1f", "answer": "Vex 4 \u5177\u6709\u5404\u7a2e\u5177\u6709\u6311\u6230\u6027\u7684\u969c\u7919\u7269\uff0c\u4f8b\u5982\u79fb\u52d5\u5e73\u53f0\u3001\u5c16\u523a\u548c\u96f7\u5c04\u3002\u8981\u514b\u670d\u9019\u4e9b\u969c\u7919\uff0c\u6642\u9593\u548c\u6e96\u78ba\u5ea6\u81f3\u95dc\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 20 \u95dc\uff0c\u60a8\u9700\u8981\u7cbe\u78ba\u628a\u63e1\u8df3\u8e8d\u6642\u9593\u4ee5\u907f\u514d\u5c16\u523a\uff0c\u4e26\u843d\u5728\u79fb\u52d5\u5e73\u53f0\u4e0a\u3002\u53cd\u8986\u7df4\u7fd2\u6bcf\u4e00\u90e8\u5206\u4ee5\u638c\u63e1\u6b63\u78ba\u7684\u6642\u9593\u3002[\u6d41\u7a0b\u5716\uff1a\u89c0\u5bdf -> \u638c\u63e1\u6642\u9593 -> \u57f7\u884c]"}, {"question": "Vex 4 \u4e2d\u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u5b83\uff1f", "answer": "Vex 4 \u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u591a\u500b\u56e0\u7d20\uff0c\u5305\u62ec\u6240\u82b1\u6642\u9593\u3001\u6536\u96c6\u7684\u6536\u96c6\u54c1\u548c\u6b7b\u4ea1\u6b21\u6578\u3002\u5b8c\u6210\u6642\u9593\u8d8a\u5feb\uff0c\u6536\u96c6\u7684\u6536\u96c6\u54c1\u8d8a\u591a\uff0c\u5206\u6578\u8d8a\u9ad8\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 7 \u95dc\uff0c\u5feb\u901f\u5b8c\u6210\u4e26\u6536\u96c6\u6240\u6709\u7269\u54c1\u5c07\u6703\u6700\u5927\u5316\u60a8\u7684\u5206\u6578\u3002\u4e86\u89e3\u9019\u4e9b\u56e0\u7d20\u53ef\u4ee5\u5e6b\u52a9\u60a8\u8ffd\u6c42\u66f4\u9ad8\u7684\u6392\u540d\u3002[\u6bd4\u8f03\u8868\uff1a\u5206\u6578\u56e0\u7d20]"}, {"question": "Vex 4 \u4e2d\u662f\u5426\u6709\u4efb\u4f55\u96b1\u85cf\u7684\u95dc\u5361\u6216\u79d8\u5bc6\u5340\u57df\uff0c\u4ee5\u53ca\u5982\u4f55\u9032\u5165\uff1f", "answer": "\u662f\u7684\uff0cVex 4 \u5305\u542b\u96b1\u85cf\u7684\u95dc\u5361\u548c\u79d8\u5bc6\u5340\u57df\uff0c\u9700\u8981\u7279\u5b9a\u52d5\u4f5c\u624d\u80fd\u89e3\u9396\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 12 \u95dc\uff0c\u6709\u4e00\u500b\u96b1\u85cf\u7684\u8def\u5f91\u901a\u5f80\u734e\u52f5\u95dc\u5361\u3002\u8981\u9032\u5165\uff0c\u60a8\u9700\u8981\u57f7\u884c\u4e00\u7cfb\u5217\u7cbe\u78ba\u7684\u8df3\u8e8d\u548c\u6ed1\u52d5\u52d5\u4f5c\u3002\u5fb9\u5e95\u63a2\u7d22\u548c\u5617\u8a66\u4e0d\u540c\u7684\u52d5\u4f5c\u53ef\u4ee5\u63ed\u793a\u9019\u4e9b\u79d8\u5bc6\u3002[\u591a\u65b9\u6848\uff1a\u63a2\u7d22 -> \u5be6\u9a57 -> \u767c\u73fe]"}]
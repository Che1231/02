[{"question": "Vex 4\uc5d0\uc11c \uc810\ud504\uc640 \uc2ac\ub77c\uc774\ub4dc \uac19\uc740 \uae30\ubcf8\uc801\uc778 \ub3d9\uc791\uc744 \uc5b4\ub5bb\uac8c \uc218\ud589\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Vex 4\uc5d0\uc11c \uae30\ubcf8\uc801\uc778 \ub3d9\uc791\uc740 \ub808\ubca8\uc744 \ud0d0\uc0c9\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc810\ud504\ud558\ub824\uba74 '\uc2a4\ud398\uc774\uc2a4\ubc14' \ub610\ub294 \ud654\uba74\uc758 \uc810\ud504 \ubc84\ud2bc\uc744 \ub204\ub974\uc138\uc694. \uc2ac\ub77c\uc774\ub4dc\ud558\ub824\uba74 '\uc544\ub798\ucabd \ud654\uc0b4\ud45c \ud0a4' \ub610\ub294 \uc2ac\ub77c\uc774\ub4dc \ubc84\ud2bc\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c\ub294 \uad6c\ub369\uc774\ub97c \ub6f0\uc5b4\ub118\uace0 \ub0ae\uc740 \uc7a5\uc560\ubb3c \uc544\ub798\ub85c \ubbf8\ub044\ub7ec\uc838\uc57c \ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ub3d9\uc791\uc744 \uc77c\ucc0d \ub9c8\uc2a4\ud130\ud558\uba74 \uac8c\uc784 \uc9c4\ud589\uc774 \uc6d0\ud65c\ud574\uc9d1\ub2c8\ub2e4."}, {"question": "Vex 4\uc758 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Vex 4\uc758 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\ub824\uba74 \uc815\ud655\uc131\uacfc \ud0c0\uc774\ubc0d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \ub808\ubca8 \ub808\uc774\uc544\uc6c3\uc744 \ubd84\uc11d\ud558\uc5ec \uc704\ud5d8 \uc694\uc18c\uc640 \uc548\uc804\ud55c \uacbd\ub85c\ub97c \ud30c\uc545\ud558\uc138\uc694. STEP2: \uac01 \uc139\uc158\uc744 \ubc18\ubcf5\uc801\uc73c\ub85c \uc5f0\uc2b5\ud558\uc5ec \ub3d9\uc791\uc744 \uc644\ubcbd\ud558\uac8c \ud558\uc138\uc694. STEP3: \uccb4\ud06c\ud3ec\uc778\ud2b8\ub97c \ud604\uba85\ud558\uac8c \ud65c\uc6a9\ud558\uc5ec \ucc98\uc74c\ubd80\ud130 \ub2e4\uc2dc \uc2dc\uc791\ud558\ub294 \uac83\uc744 \ud53c\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, 10\ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c\ub294 \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \ub9de\ucd94\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \ubd84\uc11d -> \uc5f0\uc2b5 -> \uc2e4\ud589]"}, {"question": "Vex 4\uc758 \uc77c\ubd80 \ub808\ubca8\uc5d0 \uc228\uaca8\uc9c4 \uc218\uc9d1\ud488\uc774 \uc788\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\ub098\uc694?", "answer": "Vex 4\uc758 \uc228\uaca8\uc9c4 \uc218\uc9d1\ud488\uc740 \ucd94\uac00\uc801\uc778 \ub3c4\uc804\uacfc \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc544\uc774\ud15c\uc740 \uc885\uc885 \ub3c4\ub2ec\ud558\uae30 \uc5b4\ub824\uc6b4 \uc7a5\uc18c\uc5d0 \ubc30\uce58\ub418\uac70\ub098 \ud2b9\uc815 \ub3d9\uc791\uc744 \ud1b5\ud574 \ub4dc\ub7ec\ub0a9\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 5\ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c\ub294 \uc228\uaca8\uc9c4 \ud50c\ub7ab\ud3fc\uc5d0 \uc810\ud504\ud558\uc5ec \uc218\uc9d1\ud488\uc744 \ucc3e\uc544\uc57c \ud569\ub2c8\ub2e4. \ubaa8\ub4e0 \uad6c\uc11d\uad6c\uc11d\uc744 \ud0d0\ud5d8\ud558\uace0 \ub2e4\uc591\ud55c \ub3d9\uc791\uc744 \uc2dc\ub3c4\ud558\uba74 \uc774\ub7ec\ud55c \ube44\ubc00\uc744 \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc774\uc5b4\uadf8\ub7a8: \ud0d0\ud5d8 -> \uc2e4\ud5d8 -> \uc218\uc9d1]"}, {"question": "Vex 4\uc5d0\uc11c \uc5b4\ub5a4 \uc81c\uc5b4\ub97c \uc0ac\uc6a9\uc790 \uc9c0\uc815\ud560 \uc218 \uc788\uc73c\uba70, \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "Vex 4\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uc790\uc2e0\uc758 \uc120\ud638\ub3c4\uc5d0 \ub9de\uac8c \uc81c\uc5b4\ub97c \uc0ac\uc6a9\uc790 \uc9c0\uc815\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc124\uc815 \uba54\ub274\uc5d0\uc11c \uc810\ud504, \uc2ac\ub77c\uc774\ub4dc \ubc0f \uae30\ud0c0 \ub3d9\uc791\uc5d0 \ub300\ud55c \ud0a4\ub97c \ub2e4\uc2dc \ub9e4\ud551\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c\ub294 \uc810\ud504 \ud0a4\ub97c 'W'\ub85c \ubcc0\uacbd\ud558\ub294 \uac83\uc774 \ub354 \uc9c1\uad00\uc801\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc81c\uc5b4\ub97c \uc0ac\uc6a9\uc790 \uc9c0\uc815\ud558\uba74 \ubc18\uc751 \uc2dc\uac04\uacfc \uc804\ubc18\uc801\uc778 \uac8c\uc784 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815\ud45c: \uae30\ubcf8 \uc81c\uc5b4 vs \uc0ac\uc6a9\uc790 \uc9c0\uc815 \uc81c\uc5b4]"}, {"question": "Vex 4\uc758 \uccb4\ud06c\ud3ec\uc778\ud2b8 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uc5b4\ub5a4 \ud55c\uacc4\uac00 \uc788\ub098\uc694?", "answer": "Vex 4\uc758 \uccb4\ud06c\ud3ec\uc778\ud2b8 \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc2e4\ud328\ud588\uc744 \uacbd\uc6b0 \ud2b9\uc815 \uc9c0\uc810\uc5d0\uc11c \ub2e4\uc2dc \uc2dc\uc791\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. \uccb4\ud06c\ud3ec\uc778\ud2b8\ub294 \ud1b5\uacfc\ud558\uba74 \uc790\ub3d9\uc73c\ub85c \ud65c\uc131\ud654\ub429\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \uccb4\ud06c\ud3ec\uc778\ud2b8 \uc218\uc640 \ubc30\uce58\ub294 \uc81c\ud55c\uc801\uc774\ubbc0\ub85c \uc804\ub7b5\uc801\uc778 \ud65c\uc6a9\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 15\ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c\ub294 \ub09c\uad00 \uc9c1\uc804\uc5d0 \uccb4\ud06c\ud3ec\uc778\ud2b8\uac00 \uc788\uc5b4 \uc7ac\uc2dc\uc791 \uc5c6\uc774 \ub2e4\uc2dc \uc2dc\ub3c4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uccb4\ud06c\ud3ec\uc778\ud2b8 \ud1b5\uacfc -> \uc2e4\ud328 -> \uc7ac\uc2dc\ub3c4]"}, {"question": "\uac8c\uc784 \uba54\ucee4\ub2c8\uc998 \uce21\uba74\uc5d0\uc11c Vex 4\uc640 \uadf8 \uc804\uc791\ub4e4 \uc0ac\uc774\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Vex 4\ub294 \uc804\uc791\ub4e4\uacfc \ube44\uad50\ud558\uc5ec \uc5ec\ub7ec \uac00\uc9c0 \uc0c8\ub85c\uc6b4 \uba54\ucee4\ub2c8\uc998\uc744 \ub3c4\uc785\ud569\ub2c8\ub2e4. \uc774 \uac8c\uc784\uc740 \ub354 \ubcf5\uc7a1\ud55c \ub808\ubca8 \ub514\uc790\uc778, \ubcbd \uc810\ud504\uc640 \uac19\uc740 \ucd94\uac00 \ub3d9\uc791 \ubc0f \uc0c8\ub85c\uc6b4 \uc7a5\uc560\ubb3c\uc744 \ud2b9\uc9d5\uc73c\ub85c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, Vex 4\uc5d0\uc11c\ub294 \uc774\uc804 \ubc84\uc804\uc5d0\ub294 \uc5c6\uc5c8\ub358 \ub354\ube14 \uc810\ud504\ub97c \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ubcc0\uacbd \uc0ac\ud56d\uc740 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uae4a\uc774\uc640 \ub2e4\uc591\uc131\uc744 \ub354\ud569\ub2c8\ub2e4. [\ube44\uad50\ud45c: Vex 3 \uba54\ucee4\ub2c8\uc998 vs Vex 4 \uba54\ucee4\ub2c8\uc998]"}, {"question": "Vex 4\uc5d0\uc11c \ud55c \uae30\uae30\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Vex 4\uc5d0\uc11c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uba74 \uc5ec\ub7ec \uae30\uae30\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc27d\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub450 \uae30\uae30 \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ubaa8\ubc14\uc77c \uae30\uae30\ub85c \uc774\ub3d9\ud558\ub294 \uacbd\uc6b0 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud558\uae30 \uc704\ud574 Google Play \ub610\ub294 Apple ID\ub85c \ub85c\uadf8\uc778\ud558\uc138\uc694. \uc774\ub807\uac8c \ud558\uba74 \ub9c8\uc9c0\ub9c9\uc73c\ub85c \uc911\ub2e8\ud588\ub358 \uc9c0\uc810\uc5d0\uc11c \uacc4\uc18d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc774\uc5b4\uadf8\ub7a8: \ub85c\uadf8\uc778 -> \ub3d9\uae30\ud654 -> \uc804\uc1a1]"}, {"question": "Vex 4\uc5d0\uc11c \uac00\uc7a5 \uc5b4\ub824\uc6b4 \uc7a5\uc560\ubb3c\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \uadf9\ubcf5\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Vex 4\uc5d0\ub294 \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc, \uac00\uc2dc, \ub808\uc774\uc800\uc640 \uac19\uc740 \ub2e4\uc591\ud55c \uc5b4\ub824\uc6b4 \uc7a5\uc560\ubb3c\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc7a5\uc560\ubb3c\uc744 \uadf9\ubcf5\ud558\ub824\uba74 \ud0c0\uc774\ubc0d\uacfc \uc815\ud655\uc131\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 20\ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c\ub294 \uac00\uc2dc\ub97c \ud53c\ud558\uace0 \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uc5d0 \ucc29\uc9c0\ud558\uae30 \uc704\ud574 \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uc815\ud655\ud558\uac8c \ub9de\ucdb0\uc57c \ud569\ub2c8\ub2e4. \uac01 \uc139\uc158\uc744 \ubc18\ubcf5\uc801\uc73c\ub85c \uc5f0\uc2b5\ud558\uc5ec \ud0c0\uc774\ubc0d\uc744 \ub9de\ucd94\uc138\uc694. [\ud750\ub984\ub3c4: \uad00\ucc30 -> \ud0c0\uc774\ubc0d -> \uc2e4\ud589]"}, {"question": "Vex 4\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uc5b4\ub5a4 \uc694\uc778\uc774 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "Vex 4\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc18c\uc694 \uc2dc\uac04, \uc218\uc9d1\ud55c \uc218\uc9d1\ud488 \ubc0f \uc0ac\ub9dd \ud69f\uc218\ub97c \ud3ec\ud568\ud55c \uc5ec\ub7ec \uc694\uc778\uc744 \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. \ub354 \ube60\ub978 \uc644\ub8cc \uc2dc\uac04\uacfc \ub354 \ub9ce\uc740 \uc218\uc9d1\ud488\uc744 \uc5bb\uc73c\uba74 \ub354 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 7\ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c \ube60\ub974\uac8c \uc644\ub8cc\ud558\uace0 \ubaa8\ub4e0 \uc544\uc774\ud15c\uc744 \uc218\uc9d1\ud558\uba74 \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc694\uc778\uc744 \uc774\ud574\ud558\uba74 \ub354 \ub192\uc740 \uc21c\uc704\ub97c \ubaa9\ud45c\ub85c \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uad50\ud45c: \uc810\uc218 \uc694\uc778]"}, {"question": "Vex 4\uc5d0\ub294 \uc228\uaca8\uc9c4 \ub808\ubca8\uc774\ub098 \ube44\ubc00 \uc601\uc5ed\uc774 \uc788\ub098\uc694? \uc5b4\ub5bb\uac8c \uc561\uc138\uc2a4\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub124, Vex 4\uc5d0\ub294 \ud2b9\uc815 \ub3d9\uc791\uc744 \ud1b5\ud574 \uc7a0\uae08 \ud574\uc81c\ud574\uc57c \ud558\ub294 \uc228\uaca8\uc9c4 \ub808\ubca8\uacfc \ube44\ubc00 \uc601\uc5ed\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 12\ubc88\uc9f8 \ub808\ubca8\uc5d0\ub294 \ubcf4\ub108\uc2a4 \ub808\ubca8\ub85c \uc774\uc5b4\uc9c0\ub294 \uc228\uaca8\uc9c4 \uacbd\ub85c\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uacbd\ub85c\uc5d0 \uc811\uadfc\ud558\ub824\uba74 \uc77c\ub828\uc758 \uc815\ud655\ud55c \uc810\ud504\uc640 \uc2ac\ub77c\uc774\ub4dc\ub97c \uc218\ud589\ud574\uc57c \ud569\ub2c8\ub2e4. \ucca0\uc800\ud788 \ud0d0\ud5d8\ud558\uace0 \ub2e4\uc591\ud55c \ub3d9\uc791\uc744 \uc2dc\ub3c4\ud558\uba74 \uc774\ub7ec\ud55c \ube44\ubc00\uc744 \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc774\uc5b4\uadf8\ub7a8: \ud0d0\ud5d8 -> \uc2e4\ud5d8 -> \ubc1c\uacac]"}]
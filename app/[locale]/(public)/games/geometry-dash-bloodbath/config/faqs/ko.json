[{"question": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ube14\ub7ec\ub4dc\ubc30\uc2a4\uc758 \ucd08\uae30 \ub808\ubca8\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \ud0d0\uc0c9\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub294 \uba3c\uc800 \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc744 \uc219\ub2ec\ud558\ub294 \ub370 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc74c\uc545\uc758 \ub9ac\ub4ec\uc744 \uad00\ucc30\ud558\uc5ec \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c \uc810\ud504 \ud0c0\uc774\ubc0d \uc5f0\uc2b5\uc744 \ud569\ub2c8\ub2e4. STEP1: \ucee8\ud2b8\ub864 \uac10\uc744 \uc5bb\uae30 \uc704\ud574 \uac00\ubccd\uac8c \ud0ed\ud558\uc5ec \uc2dc\uc791\ud569\ub2c8\ub2e4. STEP2: \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \ub808\ubca8 \ub808\uc774\uc544\uc6c3\uc5d0 \uc775\uc219\ud574\uc9d1\ub2c8\ub2e4. STEP3: \ub354\uc6b1 \ud3b8\uc548\ud574\uc9d0\uc5d0 \ub530\ub77c \uc810\ucc28 \uc18d\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc790\uc804\uac70 \ud0c0\ub294 \ubc95\uc744 \ubc30\uc6b0\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ucc9c\ucc9c\ud788 \uc2dc\uc791\ud558\uc5ec \uc790\uc2e0\uac10\uc744 \uc313\uc73c\uc138\uc694.]"}, {"question": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ube14\ub7ec\ub4dc\ubc30\uc2a4\uc5d0\uc11c \ub9ac\ub4ec \uc774\ud574\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uac8c\uc784\uc774 \ubc30\uacbd \uc74c\uc545\uacfc \ub3d9\uae30\ud654\ub418\uc5b4 \uc788\uae30 \ub54c\ubb38\uc5d0 \ub9ac\ub4ec \uc774\ud574\uac00 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ube14\ub7ec\ub4dc\ubc30\uc2a4' \ub808\ubca8\uc5d0\uc11c \uc810\ud504\uc640 \uc7a5\uc560\ubb3c\uc774 \ube44\ud2b8\uc640 \uc77c\uce58\ud569\ub2c8\ub2e4. STEP1: \ub2e4\uac00\uc62c \uc561\uc158\uc744 \uc608\uce21\ud558\uae30 \uc704\ud574 \uc74c\uc545\uc744 \uc8fc\uc758 \uae4a\uac8c \ub4e4\uc5b4\ubcf4\uc138\uc694. STEP2: \ube44\ud2b8\uc640 \ud0ed\uc744 \ub3d9\uae30\ud654\ud558\ub294 \uc5f0\uc2b5\uc744 \ud569\ub2c8\ub2e4. STEP3: \ub354 \ub098\uc740 \uc624\ub514\uc624 \uba85\ub8cc\ub3c4\ub97c \uc704\ud574 \ud5e4\ub4dc\ud3f0\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \ud5e4\ub4dc\ud3f0 \ub300 \uc2a4\ud53c\ucee4 \uc0ac\uc6a9\uc740 \uc131\ub2a5\uc744 \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ube14\ub7ec\ub4dc\ubc30\uc2a4\uc640 \ub2e4\ub978 \uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ub808\ubca8\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ube14\ub7ec\ub4dc\ubc30\uc2a4\ub294 \uadf9\uc2ec\ud55c \uc5b4\ub824\uc6c0\uacfc \ubcf5\uc7a1\ud55c \ub808\ubca8 \ub514\uc790\uc778\uc73c\ub85c \uc720\uba85\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc774 \ub808\ubca8\uc740 \ud45c\uc900 \ub808\ubca8\uc5d0 \ube44\ud574 \ub354 \ubcf5\uc7a1\ud55c \ud328\ud134\uacfc \ube60\ub978 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud2b9\uc9d5\uc73c\ub85c \ud569\ub2c8\ub2e4. STEP1: \ube14\ub7ec\ub4dc\ubc30\uc2a4\uc758 \ub3c5\ud2b9\ud55c \ud328\ud134\uc744 \uc5f0\uad6c\ud569\ub2c8\ub2e4. STEP2: \ud2b9\uc815 \uc139\uc158\uc744 \ubc18\ubcf5 \uc5f0\uc2b5\ud569\ub2c8\ub2e4. STEP3: \uc804\ubb38 \ud50c\ub808\uc774\uc5b4\uc758 \uc7ac\uc0dd \uc601\uc0c1\uc744 \ubcf4\uace0 \uace0\uae09 \uae30\uc220\uc744 \ubc30\uc6c1\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\uc548 \ube44\uad50: \ube14\ub7ec\ub4dc\ubc30\uc2a4\ub97c '\uc2a4\ud14c\ub808\uc624 \ub9e4\ub4dc\ub2c8\uc2a4'\uc640 \uac19\uc740 \uc26c\uc6b4 \ub808\ubca8\uacfc \ube44\uad50\ud558\uba74 \uadf8 \ub3c5\ud2b9\ud55c \uc5b4\ub824\uc6c0\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4.]"}, {"question": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ube14\ub7ec\ub4dc\ubc30\uc2a4\uc5d0\uc11c \ubc18\uc751 \uc2dc\uac04\uc744 \uac1c\uc120\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ubc18\uc751 \uc2dc\uac04 \uac1c\uc120\uc740 \uafb8\uc900\ud55c \uc5f0\uc2b5\uacfc \uc9d1\uc911\ub825\uc744 \uc694\uad6c\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ube14\ub7ec\ub4dc\ubc30\uc2a4' \ub808\ubca8\uc5d0\uc11c\ub294 \uc881\uc740 \uacf5\uac04\uc744 \uc6c0\uc9c1\uc774\uae30 \uc704\ud574 \ube60\ub978 \ubc18\uc0ac \uc2e0\uacbd\uc774 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. STEP1: \uadfc\uc721 \uae30\uc5b5\ub825\uc744 \ud0a4\uc6b0\uae30 \uc704\ud574 \uc815\uae30\uc801\uc73c\ub85c \uac8c\uc784\uc744 \ud50c\ub808\uc774\ud569\ub2c8\ub2e4. STEP2: \uac8c\uc784 \uc678 \ubc18\uc751 \uc2dc\uac04 \ud6c8\ub828 \uc571\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. STEP3: \uac8c\uc784 \ud50c\ub808\uc774 \uc911 \ucc28\ubd84\ud558\uace0 \uc9d1\uc911\ud569\ub2c8\ub2e4. [\ud750\ub984\ub3c4 \ud574\uc124: \ud750\ub984\ub3c4\ub294 \ubc18\uc751 \uc2dc\uac04 \ud5a5\uc0c1 \uacfc\uc815\uc744 \uc2dc\uac01\uc801\uc73c\ub85c \ubcf4\uc5ec\uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ube14\ub7ec\ub4dc\ubc30\uc2a4\uc5d0\uc11c \uac00\uc7a5 \uc5b4\ub824\uc6b4 \uc139\uc158\uc744 \uc644\ub8cc\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ub294 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc5b4\ub824\uc6b4 \uc139\uc158 \uc644\ub8cc\uc5d0\ub294 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uacfc \ud328\ud134 \uc778\uc2dd\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ube14\ub7ec\ub4dc\ubc30\uc2a4' \ub808\ubca8\uc5d0\uc11c \ud2b9\uc815 \uc139\uc158\uc5d0\ub294 \uc5f0\uc18d\ub41c \uc810\ud504\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \uc139\uc158\uc744 \uc791\uc740 \ubd80\ubd84\uc73c\ub85c \ub098\ub215\ub2c8\ub2e4. STEP2: \uac01 \ubd80\ubd84\uc744 \uac1c\ubcc4\uc801\uc73c\ub85c \uc5f0\uc2b5\ud569\ub2c8\ub2e4. STEP3: \ubd80\ubd84\ub4e4\uc744 \uacb0\ud569\ud558\uace0 \uc804\uccb4 \uc139\uc158\uc744 \uc5f0\uc2b5\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud37c\uc990\uc744 \ud478\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc870\uac01\uc73c\ub85c \ub098\ub204\uace0 \uc870\ub9bd\ud558\uc138\uc694.]"}, {"question": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ube14\ub7ec\ub4dc\ubc30\uc2a4\uc5d0\uc11c \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\uae30 \uc704\ud574 \uc870\uc815\ud574\uc57c \ud558\ub294 \uc124\uc815\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc124\uc815 \ucd5c\uc801\ud654\ub294 \uac8c\uc784 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac8c\uc784\uc758 FPS \ubc0f \ubbfc\uac10\ub3c4\ub97c \uc870\uc815\ud558\uba74 \uc81c\uc5b4\ub825\uc744 \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \uc6d0\ud65c\ud55c \uc2dc\uac01 \ud6a8\uacfc\ub97c \uc704\ud574 FPS\ub97c \ub192\uc785\ub2c8\ub2e4. STEP2: \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\ucdb0 \ubbfc\uac10\ub3c4\ub97c \uc870\uc815\ud569\ub2c8\ub2e4. STEP3: \ucd5c\uc0c1\uc758 \uad6c\uc131\uc744 \ucc3e\uae30 \uc704\ud574 \ub2e4\ub978 \uc124\uc815\uc744 \uc2e4\ud5d8\ud569\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \uae30\ubcf8 \uc124\uc815 \ub300 \ucd5c\uc801\ud654 \uc124\uc815\uc744 \ube44\uad50\ud558\ub294 \ud45c\ub294 \ud50c\ub808\uc774\uc5b4\ub97c \uc548\ub0b4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ube14\ub7ec\ub4dc\ubc30\uc2a4\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "\uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ub808\ubca8 \uc644\ub8cc \ubc0f \uc624\ube0c\uc81d\ud2b8 \uc218\uc9d1\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ube14\ub7ec\ub4dc\ubc30\uc2a4'\uc5d0\uc11c \uac01 \uc624\ube0c\uc81d\ud2b8\ub97c \uc218\uc9d1\ud558\uba74 \uc810\uc218\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4. STEP1: \uba3c\uc800 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\ub294 \ub370 \uc9d1\uc911\ud569\ub2c8\ub2e4. STEP2: \ub354 \ub192\uc740 \uc810\uc218\ub97c \uc704\ud574 \uc624\ube0c\uc81d\ud2b8\ub97c \uc218\uc9d1\ud569\ub2c8\ub2e4. STEP3: \ubaa8\ub4e0 \uc624\ube0c\uc81d\ud2b8 \uc704\uce58\ub97c \ucc3e\uae30 \uc704\ud574 \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\uc548 \ube44\uad50: \uc624\ube0c\uc81d\ud2b8\ub97c \uc218\uc9d1\ud588\uc744 \ub54c\uc640 \uadf8\ub807\uc9c0 \uc54a\uc558\uc744 \ub54c \uc810\uc218\ub97c \ube44\uad50\ud558\uba74 \uadf8 \uc601\ud5a5\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4.]"}, {"question": "\ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ube14\ub7ec\ub4dc\ubc30\uc2a4\ub97c \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ud558\uae30 \uc704\ud55c \uae30\uc220\uc801 \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ube14\ub7ec\ub4dc\ubc30\uc2a4\ub97c \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ud558\ub824\uba74 \ud2b9\uc815 \ud558\ub4dc\uc6e8\uc5b4 \ubc0f \uc18c\ud504\ud2b8\uc6e8\uc5b4\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ucd5c\uc18c 2GB RAM\uacfc \uc801\uc808\ud55c GPU\uac00 \uad8c\uc7a5\ub429\ub2c8\ub2e4. STEP1: \uc7a5\uce58 \uc0ac\uc591\uc744 \ud655\uc778\ud569\ub2c8\ub2e4. STEP2: \ub4dc\ub77c\uc774\ubc84 \ubc0f \uc18c\ud504\ud2b8\uc6e8\uc5b4\ub97c \uc5c5\ub370\uc774\ud2b8\ud569\ub2c8\ub2e4. STEP3: \ud544\uc694\ud55c \uacbd\uc6b0 \uac8c\uc784 \ub0b4 \uc124\uc815\uc744 \ub0ae\ucda5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: PC, \ubaa8\ubc14\uc77c \ubc0f \ucf58\uc194\uc758 \uc694\uad6c \uc0ac\ud56d\uc744 \ube44\uad50\ud558\ub294 \ud45c\ub294 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "\uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ube14\ub7ec\ub4dc\ubc30\uc2a4\uc5d0\ub294 \uc228\uaca8\uc9c4 \ube44\ubc00\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\ub098\uc694?", "answer": "\ub124, \uc9c0\uc624\uba54\ud2b8\ub9ac \ub300\uc2dc \ube14\ub7ec\ub4dc\ubc30\uc2a4\uc5d0\ub294 \uc228\uaca8\uc9c4 \ube44\ubc00\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8\uc758 \ud2b9\uc815 \ud328\ud134\uc744 \ud574\ub3c5\ud558\uba74 \uc228\uaca8\uc9c4 \uba54\uc2dc\uc9c0\uac00 \ub4dc\ub7ec\ub0a9\ub2c8\ub2e4. STEP1: \ud2b9\uc774\ud55c \ud328\ud134\uc774\ub098 \uae30\ud638\ub97c \ucc3e\uc2b5\ub2c8\ub2e4. STEP2: \uc628\ub77c\uc778 \ucee4\ubba4\ub2c8\ud2f0\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc228\uaca8\uc9c4 \uba54\uc2dc\uc9c0\ub97c \ud574\ub3c5\ud569\ub2c8\ub2e4. STEP3: \uc790\uc2e0\uc758 \ubc1c\uacac\uc744 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uc640 \uacf5\uc720\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ubcf4\ubb3c\ucc3e\uae30\uc640 \uac19\uc2b5\ub2c8\ub2e4. \ub2e8\uc11c\ub97c \ucc3e\uace0 \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uc744 \ubc1c\uacac\ud558\uc138\uc694.]"}]
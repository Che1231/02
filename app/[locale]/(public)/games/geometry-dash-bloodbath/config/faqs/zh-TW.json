[{"question": "\u5982\u4f55\u8b93\u65b0\u73a9\u5bb6\u6709\u6548\u5730\u638c\u63a7\u5e7e\u4f55\u8dd1\u9177\u8840\u6230\u7684\u521d\u671f\u95dc\u5361\uff1f", "answer": "\u65b0\u73a9\u5bb6\u61c9\u5148\u5c08\u6ce8\u65bc\u638c\u63e1\u57fa\u672c\u6a5f\u5236\u3002\u4f8b\u5982\uff0c\u900f\u904e\u89c0\u5bdf\u97f3\u6a02\u7bc0\u594f\u4f86\u7df4\u7fd2\u7b2c\u4e00\u95dc\u7684\u8df3\u8e8d\u6642\u6a5f\u3002\u6b65\u9a5f\u4e00\uff1a\u5f9e\u8f15\u89f8\u87a2\u5e55\u958b\u59cb\uff0c\u611f\u53d7\u63a7\u5236\u65b9\u5f0f\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u7df4\u7fd2\u6a21\u5f0f\u719f\u6089\u95dc\u5361\u4f48\u5c40\u3002\u6b65\u9a5f\u4e09\uff1a\u5728\u8d8a\u4f86\u8d8a\u719f\u6089\u5f8c\uff0c\u9010\u6b65\u63d0\u9ad8\u901f\u5ea6\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u9019\u5c31\u50cf\u5b78\u7fd2\u9a0e\u81ea\u884c\u8eca\u4e00\u6a23\uff0c\u5148\u6162\u5f8c\u5feb\uff0c\u5efa\u7acb\u4fe1\u5fc3\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u5728\u5e7e\u4f55\u8dd1\u9177\u8840\u6230\u4e2d\u7406\u89e3\u7bc0\u594f\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u7406\u89e3\u7bc0\u594f\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u904a\u6232\u8207\u80cc\u666f\u97f3\u6a02\u540c\u6b65\u3002\u4f8b\u5982\uff0c\u5728\u300c\u8840\u6230\u300d\u95dc\u5361\u4e2d\uff0c\u8df3\u8e8d\u548c\u969c\u7919\u7269\u90fd\u8207\u7bc0\u62cd\u5c0d\u9f4a\u3002\u6b65\u9a5f\u4e00\uff1a\u4ed4\u7d30\u8046\u807d\u97f3\u6a02\uff0c\u9810\u6e2c\u5373\u5c07\u51fa\u73fe\u7684\u52d5\u4f5c\u3002\u6b65\u9a5f\u4e8c\uff1a\u7df4\u7fd2\u5c07\u9ede\u64ca\u8207\u7bc0\u62cd\u540c\u6b65\u3002\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u8033\u6a5f\uff0c\u4ee5\u7372\u5f97\u66f4\u597d\u7684\u97f3\u8a0a\u6e05\u6670\u5ea6\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u4f7f\u7528\u8033\u6a5f\u76f8\u8f03\u65bc\u5587\u53ed\uff0c\u80fd\u986f\u8457\u63d0\u5347\u4f60\u7684\u8868\u73fe\u3002]"}, {"question": "\u5e7e\u4f55\u8dd1\u9177\u8840\u6230\u8207\u5176\u4ed6\u5e7e\u4f55\u8dd1\u9177\u95dc\u5361\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5e7e\u4f55\u8dd1\u9177\u8840\u6230\u4ee5\u5176\u6975\u9ad8\u7684\u96e3\u5ea6\u548c\u8907\u96dc\u7684\u95dc\u5361\u8a2d\u8a08\u800c\u805e\u540d\u3002\u4f8b\u5982\uff0c\u8a72\u95dc\u5361\u6bd4\u6a19\u6e96\u95dc\u5361\u64c1\u6709\u66f4\u591a\u8907\u96dc\u7684\u5716\u6848\u548c\u66f4\u5feb\u7684\u904a\u6232\u7bc0\u594f\u3002\u6b65\u9a5f\u4e00\uff1a\u7814\u7a76\u8840\u6230\u4e2d\u7684\u7368\u7279\u5716\u6848\u3002\u6b65\u9a5f\u4e8c\uff1a\u53cd\u8986\u7df4\u7fd2\u7279\u5b9a\u5340\u57df\u3002\u6b65\u9a5f\u4e09\uff1a\u89c0\u770b\u5c08\u5bb6\u73a9\u5bb6\u7684\u91cd\u64ad\uff0c\u5b78\u7fd2\u5148\u9032\u6280\u5de7\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u5c07\u8840\u6230\u8207\u66f4\u7c21\u55ae\u7684\u95dc\u5361\uff08\u4f8b\u5982\u300c\u7acb\u9ad4\u760b\u72c2\u300d\uff09\u9032\u884c\u6bd4\u8f03\uff0c\u53ef\u4ee5\u7a81\u986f\u5176\u7368\u7279\u7684\u6311\u6230\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u5e7e\u4f55\u8dd1\u9177\u8840\u6230\u4e2d\u63d0\u5347\u53cd\u61c9\u6642\u9593\uff1f", "answer": "\u63d0\u5347\u53cd\u61c9\u6642\u9593\u9700\u8981\u6301\u7e8c\u7684\u7df4\u7fd2\u548c\u5c08\u6ce8\u3002\u4f8b\u5982\uff0c\u5728\u300c\u8840\u6230\u300d\u95dc\u5361\u4e2d\uff0c\u5feb\u901f\u53cd\u61c9\u5c0d\u65bc\u5728\u72f9\u7a84\u7a7a\u9593\u4e2d\u79fb\u52d5\u81f3\u95dc\u91cd\u8981\u3002\u6b65\u9a5f\u4e00\uff1a\u5b9a\u671f\u904a\u6232\uff0c\u5efa\u7acb\u808c\u8089\u8a18\u61b6\u3002\u6b65\u9a5f\u4e8c\uff1a\u5728\u904a\u6232\u5916\u4f7f\u7528\u53cd\u61c9\u6642\u9593\u8a13\u7df4\u61c9\u7528\u7a0b\u5f0f\u3002\u6b65\u9a5f\u4e09\uff1a\u5728\u904a\u6232\u904e\u7a0b\u4e2d\u4fdd\u6301\u51b7\u975c\u548c\u5c08\u6ce8\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u6d41\u7a0b\u5716\u53ef\u4ee5\u5e6b\u52a9\u76f4\u89c0\u5730\u5c55\u793a\u63d0\u5347\u53cd\u61c9\u6642\u9593\u7684\u904e\u7a0b\u3002]"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u80fd\u5e6b\u52a9\u73a9\u5bb6\u5b8c\u6210\u5e7e\u4f55\u8dd1\u9177\u8840\u6230\u4e2d\u6700\u5177\u6311\u6230\u6027\u7684\u90e8\u5206\uff1f", "answer": "\u5b8c\u6210\u5177\u6709\u6311\u6230\u6027\u7684\u90e8\u5206\u9700\u8981\u7cbe\u78ba\u7684\u6642\u6a5f\u548c\u5716\u6848\u8b58\u5225\u3002\u4f8b\u5982\uff0c\u5728\u300c\u8840\u6230\u300d\u95dc\u5361\u4e2d\uff0c\u67d0\u4e9b\u90e8\u5206\u9700\u8981\u9023\u7e8c\u8df3\u8e8d\u3002\u6b65\u9a5f\u4e00\uff1a\u5c07\u8a72\u90e8\u5206\u5206\u89e3\u6210\u66f4\u5c0f\u7684\u90e8\u5206\u3002\u6b65\u9a5f\u4e8c\uff1a\u500b\u5225\u7df4\u7fd2\u6bcf\u500b\u90e8\u5206\u3002\u6b65\u9a5f\u4e09\uff1a\u5c07\u5404\u90e8\u5206\u7d44\u5408\u8d77\u4f86\uff0c\u7df4\u7fd2\u6574\u500b\u90e8\u5206\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u9019\u5c31\u50cf\u89e3\u8b0e\u4e00\u6a23\uff0c\u5c07\u5176\u5206\u89e3\u6210\u788e\u7247\u4e26\u7d44\u5408\u8d77\u4f86\u3002]"}, {"question": "\u73a9\u5bb6\u61c9\u8a72\u8abf\u6574\u54ea\u4e9b\u8a2d\u5b9a\u4ee5\u512a\u5316\u5728\u5e7e\u4f55\u8dd1\u9177\u8840\u6230\u4e2d\u7684\u8868\u73fe\uff1f", "answer": "\u512a\u5316\u8a2d\u5b9a\u53ef\u4ee5\u589e\u5f37\u904a\u6232\u9ad4\u9a57\u3002\u4f8b\u5982\uff0c\u8abf\u6574\u904a\u6232\u7684 FPS \u548c\u654f\u611f\u5ea6\u53ef\u4ee5\u6539\u5584\u63a7\u5236\u529b\u3002\u6b65\u9a5f\u4e00\uff1a\u63d0\u9ad8 FPS \u4ee5\u7372\u5f97\u66f4\u9806\u66a2\u7684\u756b\u9762\u3002\u6b65\u9a5f\u4e8c\uff1a\u8abf\u6574\u654f\u611f\u5ea6\u4ee5\u5339\u914d\u4f60\u7684\u904a\u6232\u98a8\u683c\u3002\u6b65\u9a5f\u4e09\uff1a\u5617\u8a66\u4e0d\u540c\u7684\u8a2d\u5b9a\uff0c\u627e\u5230\u6700\u4f73\u914d\u7f6e\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u4e00\u5f35\u6bd4\u8f03\u9810\u8a2d\u8a2d\u5b9a\u8207\u512a\u5316\u8a2d\u5b9a\u7684\u8868\u683c\uff0c\u53ef\u4ee5\u5f15\u5c0e\u73a9\u5bb6\u3002]"}, {"question": "\u5e7e\u4f55\u8dd1\u9177\u8840\u6230\u4e2d\u7684\u5f97\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u5f97\u5206\u7cfb\u7d71\u57fa\u65bc\u5b8c\u6210\u95dc\u5361\u548c\u6536\u96c6\u98db\u789f\u3002\u4f8b\u5982\uff0c\u5728\u300c\u8840\u6230\u300d\u4e2d\uff0c\u6536\u96c6\u7684\u6bcf\u500b\u98db\u789f\u90fd\u6703\u589e\u52a0\u4f60\u7684\u5f97\u5206\u3002\u6b65\u9a5f\u4e00\uff1a\u5148\u5c08\u6ce8\u65bc\u5b8c\u6210\u95dc\u5361\u3002\u6b65\u9a5f\u4e8c\uff1a\u8fd4\u56de\u6536\u96c6\u98db\u789f\uff0c\u4ee5\u7372\u5f97\u66f4\u9ad8\u7684\u5206\u6578\u3002\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u7df4\u7fd2\u6a21\u5f0f\u627e\u5230\u6240\u6709\u98db\u789f\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u6bd4\u8f03\u6709\u548c\u6c92\u6709\u6536\u96c6\u98db\u789f\u7684\u5206\u6578\uff0c\u53ef\u4ee5\u5c55\u793a\u6536\u96c6\u98db\u789f\u7684\u5f71\u97ff\u3002]"}, {"question": "\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e0a\uff0c\u5e7e\u4f55\u8dd1\u9177\u8840\u6230\u9806\u5229\u904b\u4f5c\u7684\u6280\u8853\u9700\u6c42\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5e7e\u4f55\u8dd1\u9177\u8840\u6230\u9806\u5229\u904b\u4f5c\u9700\u8981\u7279\u5b9a\u7684\u786c\u9ad4\u548c\u8edf\u9ad4\u3002\u4f8b\u5982\uff0c\u5728\u96fb\u8166\u4e0a\uff0c\u5efa\u8b70\u81f3\u5c11\u9700\u8981 2GB \u8a18\u61b6\u9ad4\u548c\u826f\u597d\u7684\u986f\u5361\u3002\u6b65\u9a5f\u4e00\uff1a\u6aa2\u67e5\u4f60\u7684\u88dd\u7f6e\u898f\u683c\u3002\u6b65\u9a5f\u4e8c\uff1a\u66f4\u65b0\u4f60\u7684\u9a45\u52d5\u7a0b\u5f0f\u548c\u8edf\u9ad4\u3002\u6b65\u9a5f\u4e09\uff1a\u5982\u6709\u5fc5\u8981\uff0c\u964d\u4f4e\u904a\u6232\u8a2d\u5b9a\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u4e00\u5f35\u6bd4\u8f03\u96fb\u8166\u3001\u624b\u6a5f\u548c\u4e3b\u6a5f\u9700\u6c42\u7684\u8868\u683c\uff0c\u53ef\u4ee5\u5e6b\u52a9\u73a9\u5bb6\u3002]"}, {"question": "\u5e7e\u4f55\u8dd1\u9177\u8840\u6230\u4e2d\u662f\u5426\u6709\u4efb\u4f55\u96b1\u85cf\u7684\u79d8\u5bc6\u6216\u5f69\u86cb\uff1f", "answer": "\u662f\u7684\uff0c\u5e7e\u4f55\u8dd1\u9177\u8840\u6230\u5305\u542b\u96b1\u85cf\u7684\u79d8\u5bc6\u548c\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u95dc\u5361\u4e2d\u67d0\u4e9b\u5716\u6848\u89e3\u78bc\u5f8c\u6703\u986f\u793a\u96b1\u85cf\u8a0a\u606f\u3002\u6b65\u9a5f\u4e00\uff1a\u5c0b\u627e\u7570\u5e38\u7684\u5716\u6848\u6216\u7b26\u865f\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u7dda\u4e0a\u793e\u7fa4\u89e3\u78bc\u96b1\u85cf\u8a0a\u606f\u3002\u6b65\u9a5f\u4e09\uff1a\u8207\u5176\u4ed6\u73a9\u5bb6\u5206\u4eab\u4f60\u7684\u767c\u73fe\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u9019\u5c31\u50cf\u5c0b\u5bf6\u904a\u6232\uff0c\u5c0b\u627e\u7dda\u7d22\u4e26\u767c\u73fe\u96b1\u85cf\u7684\u5bf6\u85cf\u3002]"}]
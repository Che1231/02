[{"question": "\u51e0\u4f55\u51b2\u523a\u8840\u6218\u521d\u59cb\u5173\u5361\u7684\u65b0\u73a9\u5bb6\u5982\u4f55\u6709\u6548\u5730\u8fdb\u884c\u6e38\u620f\uff1f", "answer": "\u65b0\u73a9\u5bb6\u5e94\u9996\u5148\u4e13\u6ce8\u4e8e\u638c\u63e1\u57fa\u672c\u673a\u5236\u3002\u4f8b\u5982\uff0c\u901a\u8fc7\u89c2\u5bdf\u97f3\u4e50\u8282\u594f\u6765\u7ec3\u4e60\u7b2c\u4e00\u4e2a\u5173\u5361\u7684\u8df3\u8dc3\u65f6\u673a\u3002\u6b65\u9aa41\uff1a\u5148\u8f7b\u70b9\u9f20\u6807\u6765\u611f\u53d7\u63a7\u5236\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u7ec3\u4e60\u6a21\u5f0f\u719f\u6089\u5173\u5361\u5e03\u5c40\u3002\u6b65\u9aa43\uff1a\u968f\u7740\u719f\u7ec3\u5ea6\u7684\u63d0\u9ad8\uff0c\u9010\u6e10\u63d0\u9ad8\u901f\u5ea6\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u8fd9\u5c31\u50cf\u5b66\u4e60\u9a91\u81ea\u884c\u8f66\u2014\u2014\u4ece\u6162\u5230\u5feb\uff0c\u5efa\u7acb\u4fe1\u5fc3\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u5728\u51e0\u4f55\u51b2\u523a\u8840\u6218\u4e2d\u7406\u89e3\u8282\u594f\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u7406\u89e3\u8282\u594f\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u6e38\u620f\u4e0e\u80cc\u666f\u97f3\u4e50\u540c\u6b65\u3002\u4f8b\u5982\uff0c\u5728\u201c\u8840\u6218\u201d\u5173\u5361\u4e2d\uff0c\u8df3\u8dc3\u548c\u969c\u788d\u7269\u4e0e\u8282\u62cd\u5bf9\u9f50\u3002\u6b65\u9aa41\uff1a\u4ed4\u7ec6\u8046\u542c\u97f3\u4e50\uff0c\u9884\u6d4b\u5373\u5c06\u53d1\u751f\u7684\u884c\u52a8\u3002\u6b65\u9aa42\uff1a\u7ec3\u4e60\u5c06\u70b9\u51fb\u4e0e\u8282\u62cd\u540c\u6b65\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u8033\u673a\u83b7\u5f97\u66f4\u597d\u7684\u97f3\u9891\u6e05\u6670\u5ea6\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u4f7f\u7528\u8033\u673a\u4e0e\u626c\u58f0\u5668\u76f8\u6bd4\uff0c\u53ef\u4ee5\u663e\u7740\u63d0\u9ad8\u4f60\u7684\u6e38\u620f\u8868\u73b0\u3002]"}, {"question": "\u51e0\u4f55\u51b2\u523a\u8840\u6218\u548c\u5176\u4ed6\u51e0\u4f55\u51b2\u523a\u5173\u5361\u4e4b\u95f4\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u51e0\u4f55\u51b2\u523a\u8840\u6218\u4ee5\u5176\u6781\u9ad8\u7684\u96be\u5ea6\u548c\u590d\u6742\u7684\u5173\u5361\u8bbe\u8ba1\u800c\u95fb\u540d\u3002\u4f8b\u5982\uff0c\u4e0e\u6807\u51c6\u5173\u5361\u76f8\u6bd4\uff0c\u8be5\u5173\u5361\u5177\u6709\u66f4\u590d\u6742\u7684\u56fe\u6848\u548c\u66f4\u5feb\u7684\u6e38\u620f\u8282\u594f\u3002\u6b65\u9aa41\uff1a\u7814\u7a76\u8840\u6218\u4e2d\u7684\u72ec\u7279\u56fe\u6848\u3002\u6b65\u9aa42\uff1a\u91cd\u590d\u7ec3\u4e60\u7279\u5b9a\u90e8\u5206\u3002\u6b65\u9aa43\uff1a\u89c2\u770b\u4e13\u5bb6\u73a9\u5bb6\u7684\u56de\u653e\u5b66\u4e60\u9ad8\u7ea7\u6280\u5de7\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u5c06\u8840\u6218\u4e0e\u50cf\u201c\u7acb\u4f53\u72c2\u60f3\u66f2\u201d\u8fd9\u6837\u7684\u7b80\u5355\u5173\u5361\u8fdb\u884c\u6bd4\u8f83\uff0c\u7a81\u51fa\u4e86\u5176\u72ec\u7279\u7684\u6311\u6218\u6027\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u51e0\u4f55\u51b2\u523a\u8840\u6218\u4e2d\u63d0\u9ad8\u53cd\u5e94\u65f6\u95f4\uff1f", "answer": "\u63d0\u9ad8\u53cd\u5e94\u65f6\u95f4\u9700\u8981\u6301\u7eed\u7ec3\u4e60\u548c\u4e13\u6ce8\u3002\u4f8b\u5982\uff0c\u5728\u201c\u8840\u6218\u201d\u5173\u5361\u4e2d\uff0c\u5feb\u901f\u53cd\u5e94\u5bf9\u4e8e\u5728\u72ed\u7a84\u7684\u7a7a\u95f4\u4e2d\u5bfc\u822a\u81f3\u5173\u91cd\u8981\u3002\u6b65\u9aa41\uff1a\u5b9a\u671f\u6e38\u620f\uff0c\u57f9\u517b\u808c\u8089\u8bb0\u5fc6\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u6e38\u620f\u5916\u53cd\u5e94\u65f6\u95f4\u8bad\u7ec3\u5e94\u7528\u7a0b\u5e8f\u3002\u6b65\u9aa43\uff1a\u5728\u6e38\u620f\u4e2d\u4fdd\u6301\u51b7\u9759\u548c\u4e13\u6ce8\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u6d41\u7a0b\u56fe\u53ef\u4ee5\u5e2e\u52a9\u53ef\u89c6\u5316\u63d0\u9ad8\u53cd\u5e94\u65f6\u95f4\u7684\u8fc7\u7a0b\u3002]"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u53ef\u4ee5\u5e2e\u52a9\u73a9\u5bb6\u5b8c\u6210\u51e0\u4f55\u51b2\u523a\u8840\u6218\u4e2d\u6700\u5177\u6311\u6218\u6027\u7684\u90e8\u5206\uff1f", "answer": "\u5b8c\u6210\u5177\u6709\u6311\u6218\u6027\u7684\u90e8\u5206\u9700\u8981\u7cbe\u786e\u7684\u65f6\u673a\u548c\u6a21\u5f0f\u8bc6\u522b\u3002\u4f8b\u5982\uff0c\u5728\u201c\u8840\u6218\u201d\u5173\u5361\u4e2d\uff0c\u67d0\u4e9b\u90e8\u5206\u9700\u8981\u8fde\u7eed\u8df3\u8dc3\u3002\u6b65\u9aa41\uff1a\u5c06\u8be5\u90e8\u5206\u5206\u89e3\u6210\u66f4\u5c0f\u7684\u90e8\u5206\u3002\u6b65\u9aa42\uff1a\u5206\u522b\u7ec3\u4e60\u6bcf\u4e2a\u90e8\u5206\u3002\u6b65\u9aa43\uff1a\u7ec4\u5408\u8fd9\u4e9b\u90e8\u5206\u5e76\u7ec3\u4e60\u6574\u4e2a\u90e8\u5206\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u8fd9\u5c31\u50cf\u89e3\u8c1c\u2014\u2014\u5c06\u5176\u5206\u89e3\u6210\u788e\u7247\u5e76\u5c06\u5176\u7ec4\u5408\u8d77\u6765\u3002]"}, {"question": "\u73a9\u5bb6\u5e94\u8be5\u8c03\u6574\u54ea\u4e9b\u8bbe\u7f6e\u4ee5\u4f18\u5316\u4ed6\u4eec\u5728\u51e0\u4f55\u51b2\u523a\u8840\u6218\u4e2d\u7684\u8868\u73b0\uff1f", "answer": "\u4f18\u5316\u8bbe\u7f6e\u53ef\u4ee5\u589e\u5f3a\u6e38\u620f\u4f53\u9a8c\u3002\u4f8b\u5982\uff0c\u8c03\u6574\u6e38\u620f\u7684\u5e27\u7387\u548c\u7075\u654f\u5ea6\u53ef\u4ee5\u63d0\u9ad8\u63a7\u5236\u529b\u3002\u6b65\u9aa41\uff1a\u63d0\u9ad8\u5e27\u7387\uff0c\u4f7f\u753b\u9762\u66f4\u6d41\u7545\u3002\u6b65\u9aa42\uff1a\u6839\u636e\u4f60\u7684\u6e38\u620f\u98ce\u683c\u8c03\u6574\u7075\u654f\u5ea6\u3002\u6b65\u9aa43\uff1a\u5c1d\u8bd5\u4e0d\u540c\u7684\u8bbe\u7f6e\uff0c\u627e\u5230\u6700\u4f73\u914d\u7f6e\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u4e00\u5f20\u6bd4\u8f83\u9ed8\u8ba4\u8bbe\u7f6e\u4e0e\u4f18\u5316\u8bbe\u7f6e\u7684\u8868\u683c\u53ef\u4ee5\u6307\u5bfc\u73a9\u5bb6\u3002]"}, {"question": "\u51e0\u4f55\u51b2\u523a\u8840\u6218\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u5b8c\u6210\u5173\u5361\u548c\u6536\u96c6\u80fd\u91cf\u7403\u3002\u4f8b\u5982\uff0c\u5728\u201c\u8840\u6218\u201d\u4e2d\uff0c\u6536\u96c6\u7684\u6bcf\u4e2a\u80fd\u91cf\u7403\u90fd\u4f1a\u589e\u52a0\u4f60\u7684\u5206\u6570\u3002\u6b65\u9aa41\uff1a\u9996\u5148\u4e13\u6ce8\u4e8e\u5b8c\u6210\u5173\u5361\u3002\u6b65\u9aa42\uff1a\u8fd4\u56de\u6536\u96c6\u80fd\u91cf\u7403\u4ee5\u83b7\u5f97\u66f4\u9ad8\u5206\u6570\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u7ec3\u4e60\u6a21\u5f0f\u6765\u5b9a\u4f4d\u6240\u6709\u80fd\u91cf\u7403\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6bd4\u8f83\u6709\u548c\u6ca1\u6709\u80fd\u91cf\u7403\u7684\u5206\u6570\uff0c\u53ef\u4ee5\u770b\u51fa\u6536\u96c6\u5b83\u4eec\u7684\u5f71\u54cd\u3002]"}, {"question": "\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e0a\u6d41\u7545\u8fd0\u884c\u51e0\u4f55\u51b2\u523a\u8840\u6218\u9700\u8981\u54ea\u4e9b\u6280\u672f\u8981\u6c42\uff1f", "answer": "\u6d41\u7545\u8fd0\u884c\u51e0\u4f55\u51b2\u523a\u8840\u6218\u9700\u8981\u7279\u5b9a\u7684\u786c\u4ef6\u548c\u8f6f\u4ef6\u3002\u4f8b\u5982\uff0c\u5728PC\u4e0a\uff0c\u5efa\u8bae\u81f3\u5c112GB\u5185\u5b58\u548c\u4e00\u53f0\u4e0d\u9519\u7684\u663e\u5361\u3002\u6b65\u9aa41\uff1a\u68c0\u67e5\u4f60\u7684\u8bbe\u5907\u89c4\u683c\u3002\u6b65\u9aa42\uff1a\u66f4\u65b0\u4f60\u7684\u9a71\u52a8\u7a0b\u5e8f\u548c\u8f6f\u4ef6\u3002\u6b65\u9aa43\uff1a\u5982\u6709\u5fc5\u8981\uff0c\u964d\u4f4e\u6e38\u620f\u8bbe\u7f6e\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u4e00\u5f20\u6bd4\u8f83PC\u3001\u79fb\u52a8\u8bbe\u5907\u548c\u6e38\u620f\u673a\u7684\u8981\u6c42\u7684\u8868\u683c\u53ef\u4ee5\u63d0\u4f9b\u5e2e\u52a9\u3002]"}, {"question": "\u51e0\u4f55\u51b2\u523a\u8840\u6218\u4e2d\u662f\u5426\u5b58\u5728\u4efb\u4f55\u9690\u85cf\u7684\u79d8\u5bc6\u6216\u5f69\u86cb\uff1f", "answer": "\u662f\u7684\uff0c\u51e0\u4f55\u51b2\u523a\u8840\u6218\u5305\u542b\u9690\u85cf\u7684\u79d8\u5bc6\u548c\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u5173\u5361\u4e2d\u7684\u67d0\u4e9b\u56fe\u6848\u5728\u89e3\u7801\u65f6\u4f1a\u663e\u793a\u9690\u85cf\u7684\u6d88\u606f\u3002\u6b65\u9aa41\uff1a\u5bfb\u627e\u4e0d\u5bfb\u5e38\u7684\u56fe\u6848\u6216\u7b26\u53f7\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u5728\u7ebf\u793e\u533a\u6765\u89e3\u7801\u9690\u85cf\u6d88\u606f\u3002\u6b65\u9aa43\uff1a\u4e0e\u5176\u4ed6\u73a9\u5bb6\u5206\u4eab\u4f60\u7684\u53d1\u73b0\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u8fd9\u5c31\u50cf\u5bfb\u5b9d\u2014\u2014\u5bfb\u627e\u7ebf\u7d22\u5e76\u53d1\u73b0\u9690\u85cf\u7684\u5b9d\u85cf\u3002]"}]
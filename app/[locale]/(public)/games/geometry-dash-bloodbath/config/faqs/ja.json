[{"question": "\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30fb\u30d6\u30e9\u30c3\u30c9\u30d0\u30b9\u306e\u521d\u671f\u30ec\u30d9\u30eb\u3092\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u52b9\u679c\u7684\u306b\u653b\u7565\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u307e\u305a\u57fa\u672c\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u97f3\u697d\u306e\u30ea\u30ba\u30e0\u3092\u89b3\u5bdf\u3057\u3066\u30b8\u30e3\u30f3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u7df4\u7fd2\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6700\u521d\u306b\u8efd\u304f\u30bf\u30c3\u30d7\u3057\u3066\u64cd\u4f5c\u611f\u3092\u63b4\u307f\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u7df4\u7fd2\u30e2\u30fc\u30c9\u3092\u4f7f\u7528\u3057\u3066\u30ec\u30d9\u30eb\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u628a\u63e1\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6163\u308c\u3066\u304d\u305f\u3089\u5f90\u3005\u306b\u30b9\u30d4\u30fc\u30c9\u3092\u4e0a\u3052\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u81ea\u8ee2\u8eca\u306b\u4e57\u308b\u3053\u3068\u3092\u5b66\u3076\u306e\u3068\u540c\u69d8\u306b\u3001\u3086\u3063\u304f\u308a\u3068\u59cb\u3081\u3066\u81ea\u4fe1\u3092\u9ad8\u3081\u307e\u3059\u3002]"}, {"question": "\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30fb\u30d6\u30e9\u30c3\u30c9\u30d0\u30b9\u3067\u30ea\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u30ea\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u3001\u30b2\u30fc\u30e0\u304c\u80cc\u666f\u97f3\u697d\u3068\u540c\u671f\u3057\u3066\u3044\u308b\u304b\u3089\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30d6\u30e9\u30c3\u30c9\u30d0\u30b9\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30b8\u30e3\u30f3\u30d7\u3068\u969c\u5bb3\u7269\u306f\u30d3\u30fc\u30c8\u3068\u4e00\u81f4\u3057\u3066\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u4eca\u5f8c\u306e\u30a2\u30af\u30b7\u30e7\u30f3\u3092\u4e88\u6e2c\u3059\u308b\u305f\u3081\u306b\u97f3\u697d\u3092\u6ce8\u610f\u6df1\u304f\u8074\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d3\u30fc\u30c8\u306b\u5408\u308f\u305b\u3066\u30bf\u30c3\u30d7\u3092\u540c\u671f\u3055\u305b\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u3088\u308a\u30af\u30ea\u30a2\u306a\u30aa\u30fc\u30c7\u30a3\u30aa\u306e\u305f\u3081\u306b\u30d8\u30c3\u30c9\u30db\u30f3\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002[\u6bd4\u8f03\u8868\uff1a\u30d8\u30c3\u30c9\u30db\u30f3\u3068\u30b9\u30d4\u30fc\u30ab\u30fc\u306e\u4f7f\u7528\u306f\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002]"}, {"question": "\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30fb\u30d6\u30e9\u30c3\u30c9\u30d0\u30b9\u3068\u4ed6\u306e\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30ec\u30d9\u30eb\u3068\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30fb\u30d6\u30e9\u30c3\u30c9\u30d0\u30b9\u306f\u3001\u6975\u7aef\u306a\u96e3\u6613\u5ea6\u3068\u8907\u96d1\u306a\u30ec\u30d9\u30eb\u30c7\u30b6\u30a4\u30f3\u3067\u77e5\u3089\u308c\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u3053\u306e\u30ec\u30d9\u30eb\u306f\u3001\u6a19\u6e96\u30ec\u30d9\u30eb\u3068\u6bd4\u8f03\u3057\u3066\u3001\u3088\u308a\u8907\u96d1\u306a\u30d1\u30bf\u30fc\u30f3\u3068\u30da\u30fc\u30b9\u306e\u901f\u3044\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u7279\u5fb4\u3068\u3057\u3066\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30d6\u30e9\u30c3\u30c9\u30d0\u30b9\u306e\u72ec\u7279\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u7814\u7a76\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u7279\u5b9a\u306e\u30bb\u30af\u30b7\u30e7\u30f3\u3092\u7e70\u308a\u8fd4\u3057\u7df4\u7fd2\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30ea\u30d7\u30ec\u30a4\u3092\u898b\u3066\u3001\u9ad8\u5ea6\u306a\u30c6\u30af\u30cb\u30c3\u30af\u3092\u5b66\u3073\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u30d6\u30e9\u30c3\u30c9\u30d0\u30b9\u3092\u300c\u30b9\u30c6\u30ec\u30aa\u30fb\u30de\u30c3\u30c9\u30cd\u30b9\u300d\u306e\u3088\u3046\u306a\u7c21\u5358\u306a\u30ec\u30d9\u30eb\u3068\u6bd4\u8f03\u3059\u308b\u3068\u3001\u305d\u306e\u72ec\u7279\u306e\u8ab2\u984c\u304c\u969b\u7acb\u3061\u307e\u3059\u3002]"}, {"question": "\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30fb\u30d6\u30e9\u30c3\u30c9\u30d0\u30b9\u3067\u53cd\u5fdc\u6642\u9593\u3092\u6539\u5584\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u53cd\u5fdc\u6642\u9593\u3092\u6539\u5584\u3059\u308b\u306b\u306f\u3001\u7d99\u7d9a\u7684\u306a\u7df4\u7fd2\u3068\u96c6\u4e2d\u304c\u5fc5\u8981\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30d6\u30e9\u30c3\u30c9\u30d0\u30b9\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u72ed\u3044\u30b9\u30da\u30fc\u30b9\u3092\u79fb\u52d5\u3059\u308b\u306b\u306f\u7d20\u65e9\u3044\u53cd\u5fdc\u304c\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u7b4b\u8089\u306e\u8a18\u61b6\u529b\u3092\u69cb\u7bc9\u3059\u308b\u305f\u3081\u306b\u5b9a\u671f\u7684\u306b\u30d7\u30ec\u30a4\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b2\u30fc\u30e0\u5916\u306e\u53cd\u5fdc\u6642\u9593\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u30a2\u30d7\u30ea\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4e2d\u306b\u843d\u3061\u7740\u3044\u3066\u96c6\u4e2d\u3057\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u306f\u3001\u53cd\u5fdc\u6642\u9593\u3092\u6539\u5584\u3059\u308b\u30d7\u30ed\u30bb\u30b9\u3092\u8996\u899a\u5316\u3067\u304d\u307e\u3059\u3002]"}, {"question": "\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30fb\u30d6\u30e9\u30c3\u30c9\u30d0\u30b9\u3067\u6700\u3082\u96e3\u3057\u3044\u30bb\u30af\u30b7\u30e7\u30f3\u3092\u30af\u30ea\u30a2\u3059\u308b\u305f\u3081\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u96e3\u3057\u3044\u30bb\u30af\u30b7\u30e7\u30f3\u3092\u30af\u30ea\u30a2\u3059\u308b\u306b\u306f\u3001\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u30d1\u30bf\u30fc\u30f3\u306e\u8a8d\u8b58\u304c\u5fc5\u8981\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30d6\u30e9\u30c3\u30c9\u30d0\u30b9\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u7279\u5b9a\u306e\u30bb\u30af\u30b7\u30e7\u30f3\u3067\u306f\u9023\u7d9a\u30b8\u30e3\u30f3\u30d7\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30bb\u30af\u30b7\u30e7\u30f3\u3092\u5c0f\u3055\u306a\u90e8\u5206\u306b\u5206\u5272\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5404\u90e8\u5206\u3092\u500b\u5225\u306b\u7df4\u7fd2\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u90e8\u54c1\u3092\u7d44\u307f\u5408\u308f\u305b\u3001\u30bb\u30af\u30b7\u30e7\u30f3\u5168\u4f53\u3092\u7df4\u7fd2\u3057\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u30d1\u30ba\u30eb\u306e\u89e3\u304d\u65b9\u3068\u4f3c\u3066\u3044\u307e\u3059\u3002\u90e8\u54c1\u306b\u5206\u89e3\u3057\u3066\u7d44\u307f\u4e0a\u3052\u307e\u3059\u3002]"}, {"question": "\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30fb\u30d6\u30e9\u30c3\u30c9\u30d0\u30b9\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u305f\u3081\u306b\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u8a2d\u5b9a\u3092\u8abf\u6574\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u8a2d\u5b9a\u3092\u6700\u9069\u5316\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30b2\u30fc\u30e0\u306eFPS\u3068\u611f\u5ea6\u3092\u8abf\u6574\u3059\u308b\u3068\u3001\u64cd\u4f5c\u6027\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6ed1\u3089\u304b\u306a\u8996\u899a\u306e\u305f\u3081\u306bFPS\u3092\u4e0a\u3052\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u5408\u308f\u305b\u305f\u611f\u5ea6\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6700\u9069\u306a\u8a2d\u5b9a\u3092\u898b\u3064\u3051\u308b\u305f\u3081\u306b\u3001\u3055\u307e\u3056\u307e\u306a\u8a2d\u5b9a\u3092\u8a66\u3057\u307e\u3059\u3002[\u8a2d\u5b9a\u6bd4\u8f03\u8868\uff1a\u30c7\u30d5\u30a9\u30eb\u30c8\u8a2d\u5b9a\u3068\u6700\u9069\u5316\u8a2d\u5b9a\u3092\u6bd4\u8f03\u3059\u308b\u8868\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u6848\u5185\u3057\u307e\u3059\u3002]"}, {"question": "\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30fb\u30d6\u30e9\u30c3\u30c9\u30d0\u30b9\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3057\u3001\u30aa\u30fc\u30d6\u3092\u96c6\u3081\u308b\u3053\u3068\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30d6\u30e9\u30c3\u30c9\u30d0\u30b9\u300d\u3067\u306f\u3001\u53ce\u96c6\u3057\u305f\u5404\u30aa\u30fc\u30d6\u306f\u30b9\u30b3\u30a2\u306b\u52a0\u7b97\u3055\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u307e\u305a\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u5f97\u308b\u305f\u3081\u306b\u3001\u30aa\u30fc\u30d6\u3092\u96c6\u3081\u306b\u623b\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7df4\u7fd2\u30e2\u30fc\u30c9\u3092\u4f7f\u7528\u3057\u3066\u3059\u3079\u3066\u306e\u30aa\u30fc\u30d6\u3092\u898b\u3064\u3051\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u30aa\u30fc\u30d6\u3092\u96c6\u3081\u308b\u6709\u7121\u306b\u3088\u308b\u30b9\u30b3\u30a2\u6bd4\u8f03\u306b\u3088\u308a\u3001\u305d\u306e\u5f71\u97ff\u304c\u308f\u304b\u308a\u307e\u3059\u3002]"}, {"question": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30fb\u30d6\u30e9\u30c3\u30c9\u30d0\u30b9\u3092\u30b9\u30e0\u30fc\u30ba\u306b\u5b9f\u884c\u3059\u308b\u305f\u3081\u306e\u6280\u8853\u7684\u306a\u8981\u4ef6\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30fb\u30d6\u30e9\u30c3\u30c9\u30d0\u30b9\u3092\u30b9\u30e0\u30fc\u30ba\u306b\u5b9f\u884c\u3059\u308b\u306b\u306f\u3001\u7279\u5b9a\u306e\u30cf\u30fc\u30c9\u30a6\u30a7\u30a2\u3068\u30bd\u30d5\u30c8\u30a6\u30a7\u30a2\u304c\u5fc5\u8981\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001PC\u3067\u306f\u3001\u6700\u4f4e2GB\u306eRAM\u3068\u9069\u5207\u306aGPU\u304c\u63a8\u5968\u3055\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30c7\u30d0\u30a4\u30b9\u306e\u4ed5\u69d8\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30c9\u30e9\u30a4\u30d0\u30fc\u3068\u30bd\u30d5\u30c8\u30a6\u30a7\u30a2\u3092\u66f4\u65b0\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5fc5\u8981\u306b\u5fdc\u3058\u3066\u30b2\u30fc\u30e0\u5185\u306e\u8a2d\u5b9a\u3092\u4e0b\u3052\u307e\u3059\u3002[\u6bd4\u8f03\u8868\uff1aPC\u3001\u30e2\u30d0\u30a4\u30eb\u3001\u30b3\u30f3\u30bd\u30fc\u30eb\u306e\u8981\u4ef6\u3092\u6bd4\u8f03\u3057\u305f\u8868\u306f\u5f79\u7acb\u3061\u307e\u3059\u3002]"}, {"question": "\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30fb\u30d6\u30e9\u30c3\u30c9\u30d0\u30b9\u306b\u96a0\u3055\u308c\u305f\u79d8\u5bc6\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30b8\u30aa\u30e1\u30c8\u30ea\u30c0\u30c3\u30b7\u30e5\u30fb\u30d6\u30e9\u30c3\u30c9\u30d0\u30b9\u306b\u306f\u96a0\u3055\u308c\u305f\u79d8\u5bc6\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb\u5185\u306e\u7279\u5b9a\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u89e3\u8aad\u3059\u308b\u3068\u3001\u96a0\u3055\u308c\u305f\u30e1\u30c3\u30bb\u30fc\u30b8\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u7570\u5e38\u306a\u30d1\u30bf\u30fc\u30f3\u3084\u8a18\u53f7\u3092\u63a2\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30aa\u30f3\u30e9\u30a4\u30f3\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u3092\u4f7f\u7528\u3057\u3066\u96a0\u3055\u308c\u305f\u30e1\u30c3\u30bb\u30fc\u30b8\u3092\u89e3\u8aad\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u3042\u306a\u305f\u306e\u767a\u898b\u3092\u5171\u6709\u3057\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u5b9d\u63a2\u3057\u306e\u3088\u3046\u306b\u3001\u624b\u304c\u304b\u308a\u3092\u63a2\u3057\u3066\u96a0\u3055\u308c\u305f\u5b9d\u7269\u3092\u898b\u3064\u3051\u307e\u3059\u3002]"}]
[{"question": "\ucd08\ubcf4\uc790\uac00 AstroDud.io\uc5d0\uc11c \uae30\ubcf8\uc801\uc778 \uc870\uc791\uc744 \ube60\ub974\uac8c \uc775\ud788\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud558\ub098\uc694?", "answer": "AstroDud.io\uc5d0\uc11c \uae30\ubcf8\uc801\uc778 \uc870\uc791\uc744 \uc775\ud788\ub824\uba74 \uc774\ub3d9 \ubc0f \uc0c1\ud638 \uc791\uc6a9 \ud0a4\uc5d0 \uc775\uc219\ud574\uc9c0\ub294 \uac83\ubd80\ud130 \uc2dc\uc791\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc774\ub3d9\uc5d0\ub294 WASD \ud0a4\ub97c \uc0ac\uc6a9\ud558\uace0 \uc810\ud504\uc5d0\ub294 \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \uc0ac\uc6a9\ud558\uc138\uc694. \ud29c\ud1a0\ub9ac\uc5bc \ub808\ubca8\uc5d0\uc11c \uc774\ub7ec\ud55c \uc870\uc791\uc744 \uc5f0\uc2b5\ud558\uc5ec \uac04\ub2e8\ud55c \uc7a5\uc560\ubb3c\uc744 \ud0d0\uc0c9\ud558\uace0 \uae30\ubcf8\uc801\uc778 \uc544\uc774\ud15c\uc744 \uc218\uc9d1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uac8c\uc784 \ub0b4 \uc124\uc815\uc744 \ud65c\uc6a9\ud558\uc5ec \ud3b8\uc548\ud558\uac8c \ud0a4 \uc124\uc815\uc744 \uc0ac\uc6a9\uc790 \uc815\uc758\ud558\uc138\uc694. \ud544\uc694\ud55c \uacbd\uc6b0 '\uc0c1\ud638 \uc791\uc6a9' \ud0a4\ub97c \ub354 \uc27d\uac8c \uc811\uadfc\ud560 \uc218 \uc788\ub294 \ubc84\ud2bc\uc73c\ub85c \uc7ac\ub9e4\ud551\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc870\uc791\uc744 \uafb8\uc900\ud788 \uc5f0\uc2b5\ud558\uba74 \uadfc\uc721 \uae30\uc5b5\uc774 \ud615\uc131\ub418\uace0 \uac8c\uc784 \ud50c\ub808\uc774 \ud6a8\uc728\uc131\uc774 \ud5a5\uc0c1\ub429\ub2c8\ub2e4."}, {"question": "AstroDud.io\ub97c 100\uc2dc\uac04 \ud50c\ub808\uc774\ud55c \ud6c4 \ub354 \uc624\ub798 \uc0dd\uc874\ud558\uae30 \uc704\ud55c \ud544\uc218 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "AstroDud.io\ub97c 100\uc2dc\uac04 \ud50c\ub808\uc774\ud55c \ud6c4 \ub354 \uc624\ub798 \uc0dd\uc874\ud558\ub824\uba74 \uace0\uae09 \uc804\ub7b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \uc790\uc6d0 \uad00\ub9ac\uc5d0 \uc9d1\uc911\ud558\uc138\uc694. \ud56d\uc0c1 \uccb4\ub825 \ud329\uacfc \ud0c4\uc57d \uc218\uc9d1\uc744 \uc6b0\uc120\uc2dc\ud558\uc138\uc694. 2\ub2e8\uacc4: \uc801 \ud328\ud134\uc744 \ub9c8\uc2a4\ud130\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uc870\ub974\uace4' \uc801\uc758 \uacf5\uaca9 \uac04\uaca9\uc744 \uc5f0\uad6c\ud558\uc5ec \ud6a8\uacfc\uc801\uc73c\ub85c \ud68c\ud53c\ud558\uc138\uc694. 3\ub2e8\uacc4: \ub192\uc740 \uc9c0\ub300\ub97c \ud65c\uc6a9\ud558\uc5ec \ub354 \ub098\uc740 \uc2dc\uc57c\uc640 \uc5c4\ud3d0\ubb3c\uc744 \ud655\ubcf4\ud558\ub294 \ub4f1 \ud658\uacbd\uc744 \uc720\ub9ac\ud558\uac8c \ud65c\uc6a9\ud558\uc138\uc694. \ub610\ud55c, \uc7a5\uae30\uc804\uc744 \uc704\ud574 \uc2a4\ud14c\ubbf8\ub098\ub97c \ub298\ub9ac\ub294 \ub4f1 \uce90\ub9ad\ud130\uc758 \ub2a5\ub825\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \ub370 \ud22c\uc790\ud558\uc138\uc694. \uc774\ub7ec\ud55c \uc804\ub7b5\uc744 \uacb0\ud569\ud558\uba74 \uc0dd\uc874\uc728\uc744 \ud06c\uac8c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "AstroDud.io\uc758 \uc81c\uc791 \uc2dc\uc2a4\ud15c\uc740 \uc65c \ud2b9\uc815 \uc544\uc774\ud15c \uc870\ud569\uc744 \uc694\uad6c\ud558\uba70, \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\ub098\uc694?", "answer": "AstroDud.io\uc758 \uc81c\uc791 \uc2dc\uc2a4\ud15c\uc740 \uc804\ub7b5\uc801 \uc0ac\uace0\uc640 \uc790\uc6d0 \ucd5c\uc801\ud654\ub97c \uc7a5\ub824\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ud2b9\uc815 \uc544\uc774\ud15c \uc870\ud569\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \ub2e4\uc591\ud55c \uc7ac\ub8cc\ub97c \uacc4\ud68d\ud558\uace0 \uc218\uc9d1\ud574\uc57c \ud568\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4. \uc81c\uc791\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uba3c\uc800 \uac00\ub2a5\ud55c \ubaa8\ub4e0 \uc870\ud569\uc744 \ub098\uc5f4\ud558\ub294 \uac8c\uc784 \ub0b4 \uc81c\uc791 \uac00\uc774\ub4dc\ub97c \ucc38\uc870\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\ucca0\uad11\uc11d'\uacfc '\ud50c\ub77c\uc988\ub9c8 \ud06c\ub9ac\uc2a4\ud0c8'\uc744 \uacb0\ud569\ud558\uba74 \uac15\ub825\ud55c \ubb34\uae30\uc778 '\ud50c\ub77c\uc988\ub9c8 \ube14\ub808\uc774\ub4dc'\uac00 \uc0dd\uc131\ub429\ub2c8\ub2e4. \ub458\uc9f8, \ud0d0\ud5d8 \uc911\uc5d0 \ud76c\uadc0 \uc7ac\ub8cc\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \uc218\uc9d1\ud558\uc138\uc694. \ud76c\uadc0 \uc7ac\ub8cc\ub294 \uace0\uae09 \ub808\uc2dc\ud53c\uc758 \ud575\uc2ec \uad6c\uc131 \uc694\uc18c\uc778 \uacbd\uc6b0\uac00 \ub9ce\uc2b5\ub2c8\ub2e4. \ub9c8\uc9c0\ub9c9\uc73c\ub85c, \uc81c\uc791\ub300\uc758 '\ube60\ub978 \uc81c\uc791' \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud504\ub85c\uc138\uc2a4\ub97c \uac04\uc18c\ud654\ud558\uc5ec \uc911\uc694\ud55c \uc21c\uac04\uc5d0 \uc2dc\uac04\uc744 \uc808\uc57d\ud558\uc138\uc694."}, {"question": "AstroDud.io\uc5d0\uc11c \ub370\ubbf8\uc9c0 \uacc4\uc0b0\uc740 \uc5b4\ub5bb\uac8c \uc774\ub8e8\uc5b4\uc9c0\uba70, \uc5b4\ub5a4 \uc694\uc18c\uac00 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "AstroDud.io\uc5d0\uc11c \ub370\ubbf8\uc9c0 \uacc4\uc0b0\uc740 \ubb34\uae30 \uc720\ud615, \uc801 \ubc29\uc5b4\uad6c, \ud50c\ub808\uc774\uc5b4 \ub2a5\ub825\uce58 \ub4f1 \uc5ec\ub7ec \uc694\uc18c\uc758 \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud50c\ub77c\uc988\ub9c8 \ub77c\uc774\ud50c'\uc740 \uae30\ubcf8 \ub370\ubbf8\uc9c0 50\uc744 \uac00\ud558\uc9c0\ub9cc, \uc801\uc758 '\uc5d0\ub108\uc9c0 \uc274\ub4dc'\uc5d0 \uc758\ud574 20% \uac10\uc18c\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \ud50c\ub808\uc774\uc5b4\uc758 '\ud798' \ub2a5\ub825\uce58\ub294 \ud3ec\uc778\ud2b8\ub2f9 \ub370\ubbf8\uc9c0 \ucd9c\ub825\uc744 2% \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4. \ub370\ubbf8\uc9c0\ub97c \ucd5c\ub300\ud654\ud558\ub824\uba74 \ud654\uc5fc \uae30\ubc18 \uc801\uc5d0\uac8c '\ub0c9\ub3d9 \uc218\ub958\ud0c4'\uc744 \uc0ac\uc6a9\ud558\ub294 \ub4f1 \uc801\uc758 \uc57d\uc810\uc744 \uc774\uc6a9\ud558\ub294 \ubb34\uae30\ub97c \uc7a5\ucc29\ud558\uc138\uc694. \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\uba74 \ubcf4\ub2e4 \ud6a8\uacfc\uc801\uc778 \uc804\ud22c \uc804\ub7b5\uacfc \ub354 \ub098\uc740 \uc790\uc6d0 \ud560\ub2f9\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4."}, {"question": "AstroDud.io\uc758 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4\uc640 \uba40\ud2f0 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "AstroDud.io\uc758 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4\uc640 \uba40\ud2f0 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \ub69c\ub837\ud55c \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4\uc5d0\uc11c\ub294 \uc2a4\ud1a0\ub9ac \uc9c4\ud589\uacfc \ud37c\uc990 \ud574\uacb0, \ubcf4\uc2a4 \uc804\ud22c\uc640 \uac19\uc740 \ub9de\ucda4\ud615 \ub3c4\uc804 \uacfc\uc81c\ub97c \ud1b5\ud574 \uac1c\uc778 \uae30\uc220 \uac1c\ubc1c\uc5d0 \uc911\uc810\uc744 \ub461\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \uba40\ud2f0 \ud50c\ub808\uc774\uc5b4\ub294 \ud300\uc6cc\ud06c\uc640 \ud611\ub3d9\uc744 \uac15\uc870\ud558\uba70, \ud55c \ud50c\ub808\uc774\uc5b4\uac00 \uc5c4\ud3d0\ub97c \uc81c\uacf5\ud558\ub294 \ub3d9\uc548 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uac00 \ud568\uc815\uc744 \ud574\uc81c\ud558\ub294 \ub4f1 \ud50c\ub808\uc774\uc5b4\uac00 \ub2a5\ub825\uc744 \uacb0\ud569\ud574\uc57c \ud558\ub294 \ubbf8\uc158\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub610\ud55c, \uba40\ud2f0 \ud50c\ub808\uc774\uc5b4\ub294 \ud611\ub3d9 \ubbf8\uc158 \uc644\ub8cc\ub97c \uc704\ud55c \ub3c5\uc810 \uc2a4\ud0a8\uacfc \uac19\uc740 \uace0\uc720\ud55c \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ubaa8\ub4dc \uc120\ud0dd\uc740 \uc194\ub85c \ud0d0\ud5d8\uc744 \uc120\ud638\ud558\ub294\uc9c0 \uc544\ub2c8\uba74 \ud611\uc5c5 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc120\ud638\ud558\ub294\uc9c0\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4."}, {"question": "\ub370\uc774\ud130 \uc190\uc2e4 \uc5c6\uc774 AstroDud.io \uc9c4\ud589 \uc0c1\ud669\uc744 PC\uc5d0\uc11c \ubaa8\ubc14\uc77c\ub85c \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694?", "answer": "AstroDud.io \uc9c4\ud589 \uc0c1\ud669\uc744 PC\uc5d0\uc11c \ubaa8\ubc14\uc77c\ub85c \uc804\uc1a1\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. 1\ub2e8\uacc4: \uac8c\uc784\uc758 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \ud1b5\ud574 \ub450 \uc7a5\uce58\uac00 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \uc5f0\uacb0\ub418\uc5b4 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. 2\ub2e8\uacc4: PC\uc5d0\uc11c \uc124\uc815 \uba54\ub274\ub85c \uc774\ub3d9\ud558\uc5ec '\uc800\uc7a5 \ub370\uc774\ud130 \uc5c5\ub85c\ub4dc'\ub97c \uc120\ud0dd\ud558\uc138\uc694. 3\ub2e8\uacc4: \ubaa8\ubc14\uc77c \uc7a5\uce58\uc5d0\uc11c \uac8c\uc784\uc744 \uc5f4\uace0 \uc124\uc815\uc5d0\uc11c '\uc800\uc7a5 \ub370\uc774\ud130 \ub2e4\uc6b4\ub85c\ub4dc'\ub97c \uc120\ud0dd\ud558\uc138\uc694. \uc774 \ud504\ub85c\uc138\uc2a4\ub97c \ud1b5\ud574 \uc778\ubca4\ud1a0\ub9ac \ubc0f \uc5c5\uc801\uc744 \ud3ec\ud568\ud55c \ubaa8\ub4e0 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc6d0\ud65c\ud558\uac8c \uc804\uc1a1\ub429\ub2c8\ub2e4. \uc7a0\uc7ac\uc801\uc778 \uc190\uc2e4\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \uc804\uc1a1\uc744 \uc2dc\uc791\ud558\uae30 \uc804\uc5d0 \ud56d\uc0c1 \ub370\uc774\ud130\ub97c \ubc31\uc5c5\ud558\uc138\uc694."}, {"question": "AstroDud.io\uc5d0\uc11c \uc5b4\ub5a4 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ucc3e\uc744 \uc218 \uc788\uc73c\uba70, \uc5b4\ub514\uc5d0 \uc788\ub098\uc694?", "answer": "AstroDud.io\ub294 \ud0d0\ud5d8\uc5d0 \ub300\ud55c \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud558\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub85c \uac00\ub4dd\ud569\ub2c8\ub2e4. \uc8fc\ubaa9\ud560 \ub9cc\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8 \uc911 \ud558\ub098\ub294 '\ub0c9\ub3d9\ub41c \ud33d\ucc3d' \ub808\ubca8\uc5d0\uc11c \ubc1c\uacac\ub418\ub294 '\uc740\ud558 \ud3ad\uadc4'\uc785\ub2c8\ub2e4. \ucc3e\uc73c\ub824\uba74 \uc5bc\uc74c \ud3ed\ud3ec \ub4a4\uc5d0 \uc228\uaca8\uc9c4 \ub3d9\uad74\ub85c \uc774\ub3d9\ud558\uc5ec \ud3ad\uadc4 \ub3d9\uc0c1\uacfc \uc0c1\ud638 \uc791\uc6a9\ud558\uc138\uc694. \ub610 \ub2e4\ub978 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uba54\uc778 \uba54\ub274\uc5d0\uc11c \ud2b9\uc815 \ubc84\ud2bc \uc2dc\ud000\uc2a4\ub97c \uc785\ub825\ud558\uc5ec \uc561\uc138\uc2a4\ud560 \uc218 \uc788\ub294 '\uac1c\ubc1c\uc790\uc758 \ubc29'\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uc885\uc885 \uac8c\uc784\uc758 \uae4a\uc774\uc640 \uc7ac\uc0dd \uac00\ub2a5\uc131\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \uace0\uc720\ud55c \uc544\uc774\ud15c\uc774\ub098 \ub85c\uc5b4\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub354 \ub9ce\uc740 \ube44\ubc00\uc744 \ubc1d\ud788\ub824\uba74 \ubbf8\ubb18\ud55c \ud658\uacbd \ub2e8\uc11c\uc5d0 \uc8fc\uc758\ud558\uc138\uc694."}, {"question": "AstroDud.io\uc5d0\uc11c \uc5b4\ub5a4 \uce90\ub9ad\ud130 \ud074\ub798\uc2a4\uac00 \uacf5\uaca9\uacfc \ubc29\uc5b4 \uc0ac\uc774\uc758 \ucd5c\uc0c1\uc758 \uade0\ud615\uc744 \uc81c\uacf5\ud558\ub098\uc694?", "answer": "AstroDud.io\uc758 '\uc13c\ud2f0\ub12c' \ud074\ub798\uc2a4\ub294 \uacf5\uaca9\uacfc \ubc29\uc5b4 \uc0ac\uc774\uc758 \ucd5c\uc0c1\uc758 \uade0\ud615\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc801\ub2f9\ud55c \uccb4\ub825\uacfc \ubc29\uc5b4\uad6c \ub2a5\ub825\uce58\ub97c \uac00\uc9c4 \uc13c\ud2f0\ub12c\uc740 \uc77c\uad00\ub41c DPS\ub97c \ucc98\ub9ac\ud558\uba74\uc11c \uc0c1\ub2f9\ud55c \ub370\ubbf8\uc9c0\ub97c \uacac\ub51c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud50c\ub77c\uc988\ub9c8 \uc274\ub4dc' \ub2a5\ub825\uc740 30% \ub370\ubbf8\uc9c0 \uac10\uc18c\ub97c \uc81c\uacf5\ud558\uc5ec \uc13c\ud2f0\ub12c\uc774 \uc804\ud22c\uc5d0\uc11c \ub354 \uc624\ub798 \uc0dd\uc874\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. \ub610\ud55c, '\uc774\uc628 \ube14\ub798\uc2a4\ud130' \ubb34\uae30\ub294 \ub2e8\uc77c \ub300\uc0c1\uc5d0\uac8c \ub192\uc740 \ub370\ubbf8\uc9c0\ub97c \uac00\ud558\uc5ec \ubcf4\uc2a4\uc5d0\uac8c \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uade0\ud615\uc740 \ub2e4\uc591\ud55c \uc804\ud22c \uc2dc\ub098\ub9ac\uc624\uc5d0 \uc801\uc751\ud560 \uc218 \uc788\ub294 \ub2e4\uc7ac\ub2e4\ub2a5\ud55c \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc744 \uc120\ud638\ud558\ub294 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc13c\ud2f0\ub12c\uc744 \uc774\uc0c1\uc801\uc73c\ub85c \ub9cc\ub4ed\ub2c8\ub2e4."}, {"question": "\uc2dc\uac04 \ub0ad\ube44 \uc5c6\uc774 AstroDud.io\uc5d0\uc11c \ud6a8\uc728\uc801\uc73c\ub85c \uc790\uc6d0\uc744 \ud30c\ubc0d\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud558\ub098\uc694?", "answer": "AstroDud.io\uc5d0\uc11c \ud6a8\uc728\uc801\uc778 \uc790\uc6d0 \ud30c\ubc0d\uc740 \uc804\ub7b5\uc801 \uacc4\ud68d\uacfc \uacbd\ub85c \ucd5c\uc801\ud654\ub97c \ud3ec\ud568\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: '\ud50c\ub77c\uc988\ub9c8 \ud06c\ub9ac\uc2a4\ud0c8'\uacfc \uac19\uc740 \ud76c\uadc0 \uc7ac\ub8cc\ub97c \uc0dd\uc131\ud558\ub294 '\ud06c\ub9ac\uc2a4\ud0c8 \ub3d9\uad74'\uacfc \uac19\uc740 \uace0\uc218\uc775 \uc790\uc6d0 \ub178\ub4dc\ub97c \uc2dd\ubcc4\ud558\uc138\uc694. 2\ub2e8\uacc4: \uc218\uc9d1 \uc2dc\uac04\uc744 50% \ub2e8\ucd95\ud558\ub294 '\ub9c8\uc774\ub2dd \ub808\uc774\uc800'\uc640 \uac19\uc774 \uc218\uc9d1 \uc18d\ub3c4\ub97c \ub192\uc774\ub294 \ub3c4\uad6c\ub97c \uc7a5\ucc29\ud558\uc138\uc694. 3\ub2e8\uacc4: \ube60\ub978 \uc774\ub3d9 \uc9c0\uc810\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc790\uc6d0\uc774 \ud48d\ubd80\ud55c \uc9c0\uc5ed \uac04\uc744 \ube60\ub974\uac8c \uc774\ub3d9\ud558\uc5ec \uac00\ub3d9 \uc911\uc9c0 \uc2dc\uac04\uc744 \ucd5c\uc18c\ud654\ud558\uc138\uc694. \ub610\ud55c, \ud2b9\uc815 \ubaa9\ud45c\ub97c \uc644\ub8cc\ud558\uba74 \ubcf4\ub108\uc2a4 \uc790\uc6d0\uc744 \uc81c\uacf5\ud558\ub294 \uc2dc\uac04 \uc81c\ud55c \uc774\ubca4\ud2b8\uc5d0 \ucc38\uc5ec\ud558\uc138\uc694. \uc774\ub7ec\ud55c \ub2e8\uacc4\ub97c \ub530\ub974\uba74 \ub178\ub825\uc744 \ucd5c\uc18c\ud654\ud558\uba74\uc11c \uc790\uc6d0 \uc12d\ucde8\ub97c \ucd5c\ub300\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "AstroDud.io\uc758 \ub808\uc774\ub4dc \ucc4c\ub9b0\uc9c0\ub97c \uc704\ud55c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ud300 \uad6c\uc131\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "AstroDud.io\uc758 \ub808\uc774\ub4dc \ucc4c\ub9b0\uc9c0\ub97c \uc704\ud55c \ud6a8\uacfc\uc801\uc778 \ud300 \uad6c\uc131\uc5d0\ub294 \uc5ed\ud560\uc758 \ud63c\ud569\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uade0\ud615 \uc7a1\ud78c \ud300\uc5d0\ub294 '\ud0f1\ucee4'(\uc608: \uac00\ub514\uc5b8), '\ud790\ub7ec'(\uc608: \uba54\ub515), 'DPS' 2\uba85(\uc608: \uc5b4\uc314\uc2e0 \ubc0f \uc5d4\uc9c0\ub2c8\uc5b4)\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uac00\ub514\uc5b8\uc740 \ub370\ubbf8\uc9c0\ub97c \ud761\uc218\ud558\uace0, \uba54\ub515\uc740 \uce58\uc720\ub97c \uc81c\uacf5\ud558\uace0, DPS \ud074\ub798\uc2a4\ub294 \ub192\uc740 \ub370\ubbf8\uc9c0\ub97c \uac00\ud558\ub294 \ub370 \uc9d1\uc911\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud0c0\uc774\ud0c4\uc758 \uc18c\uad74' \ub808\uc774\ub4dc\uc5d0\uc11c \uc5d4\uc9c0\ub2c8\uc5b4\uc758 '\ud130\ub81b' \ub2a5\ub825\uc740 \uc5b4\uc314\uc2e0\uc774 \ubcf4\uc2a4\uc5d0 \uc9d1\uc911\ud558\ub294 \ub3d9\uc548 \ucd94\uac00 \ub300\uc0c1\uc744 \uc81c\uc5b4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uad6c\uc131\uc740 \uc0dd\uc874 \uac00\ub2a5\uc131\uacfc \ud6a8\uc728\uc801\uc778 \ub370\ubbf8\uc9c0 \ucd9c\ub825\uc744 \ubcf4\uc7a5\ud558\uba70, \uc5b4\ub824\uc6b4 \ub808\uc774\ub4dc\ub97c \uc644\ub8cc\ud558\ub294 \ub370 \uc911\uc694\ud569\ub2c8\ub2e4."}]
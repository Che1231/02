[{"question": "\u5982\u4f55\u5feb\u901f\u638c\u63e1AstroDud.io\u7684\u57fa\u790e\u63a7\u5236\uff0c\u4f5c\u70ba\u65b0\u624b\uff1f", "answer": "\u8981\u638c\u63e1AstroDud.io\u7684\u57fa\u790e\u63a7\u5236\uff0c\u9996\u5148\u8981\u719f\u6089\u79fb\u52d5\u548c\u4e92\u52d5\u9375\u3002\u4f8b\u5982\uff0c\u4f7f\u7528WASD\u9375\u9032\u884c\u79fb\u52d5\uff0c\u7a7a\u683c\u9375\u8df3\u8e8d\u3002\u5728\u5165\u9580\u6559\u7a0b\u4e2d\u7df4\u7fd2\u9019\u4e9b\u63a7\u5236\uff0c\u4f60\u53ef\u4ee5\u7a7f\u68ad\u7c21\u6f54\u7684\u969c\u7919\u7269\u4e26\u6536\u96c6\u57fa\u672c\u7269\u54c1\u3002\u6b64\u5916\uff0c\u5229\u7528\u904a\u6232\u8a2d\u5b9a\u81ea\u8a02\u4f60\u7684\u5feb\u6377\u9375\u4ee5\u7372\u5f97\u8212\u9069\u6027\u3002\u4e00\u500b\u6709\u5e6b\u52a9\u7684\u6280\u5de7\u662f\uff0c\u5982\u679c\u9700\u8981\uff0c\u5c07\u300e\u4e92\u52d5\u300f\u9375\u91cd\u65b0\u6620\u5c04\u5230\u66f4\u5bb9\u6613\u89f8\u53ca\u7684\u6309\u9215\u3002\u900f\u904e\u6301\u7e8c\u7df4\u7fd2\u9019\u4e9b\u63a7\u5236\uff0c\u4f60\u5c07\u5efa\u7acb\u808c\u8089\u8a18\u61b6\u4e26\u63d0\u5347\u4f60\u7684\u904a\u6232\u6548\u7387\u3002"}, {"question": "\u5728AstroDud.io\u904a\u6232\u4e2d\u73a9\u6eff100\u5c0f\u6642\u5f8c\uff0c\u5ef6\u9577\u751f\u5b58\u6642\u9593\u7684\u5fc5\u8981\u7b56\u7565\u6709\u54ea\u4e9b\uff1f", "answer": "\u5728AstroDud.io\u904a\u6232\u4e2d\u73a9\u6eff100\u5c0f\u6642\u5f8c\uff0c\u5ef6\u9577\u751f\u5b58\u6642\u9593\u9700\u8981\u5148\u9032\u7b56\u7565\u3002\u6b65\u9a5f1\uff1a\u5c08\u6ce8\u65bc\u8cc7\u6e90\u7ba1\u7406\u2014\u2014\u59cb\u7d42\u512a\u5148\u6536\u96c6\u751f\u547d\u85e5\u6c34\u548c\u5f48\u85e5\u3002\u6b65\u9a5f2\uff1a\u638c\u63e1\u6575\u4eba\u6a21\u5f0f\uff1b\u4f8b\u5982\uff0c\u5b78\u7fd2\u300eZorgon\u300f\u6575\u4eba\u7684\u653b\u64ca\u9593\u9694\u4ee5\u6709\u6548\u9583\u907f\u3002\u6b65\u9a5f3\uff1a\u5229\u7528\u74b0\u5883\u512a\u52e2\uff0c\u4f8b\u5982\u5229\u7528\u9ad8\u5730\u7372\u5f97\u66f4\u597d\u7684\u8996\u91ce\u548c\u63a9\u8b77\u3002\u6b64\u5916\uff0c\u6295\u8cc7\u5347\u7d1a\u4f60\u7684\u89d2\u8272\u80fd\u529b\uff0c\u4f8b\u5982\u589e\u52a0\u6301\u4e45\u529b\u4ee5\u9032\u884c\u9577\u6642\u9593\u6230\u9b25\u3002\u900f\u904e\u7d50\u5408\u9019\u4e9b\u7b56\u7565\uff0c\u4f60\u5c07\u986f\u8457\u63d0\u5347\u4f60\u7684\u751f\u5b58\u7387\u3002"}, {"question": "\u70ba\u4f55AstroDud.io\u7684\u5de5\u85dd\u7cfb\u7d71\u9700\u8981\u7279\u5b9a\u7684\u7269\u54c1\u7d44\u5408\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u4f73\u5316\u5b83\uff1f", "answer": "AstroDud.io\u7684\u5de5\u85dd\u7cfb\u7d71\u8a2d\u8a08\u9f13\u52f5\u7b56\u7565\u6027\u601d\u7dad\u548c\u8cc7\u6e90\u6700\u4f73\u5316\u3002\u7279\u5b9a\u7684\u7269\u54c1\u7d44\u5408\u78ba\u4fdd\u73a9\u5bb6\u5fc5\u9808\u898f\u5283\u4e26\u6536\u96c6\u5404\u7a2e\u6750\u6599\u3002\u8981\u6700\u4f73\u5316\u5de5\u85dd\uff0c\u9996\u5148\uff0c\u53c3\u8003\u904a\u6232\u5167\u7684\u5de5\u85dd\u6307\u5357\uff0c\u5217\u51fa\u6240\u6709\u53ef\u80fd\u7684\u7d44\u5408\u3002\u4f8b\u5982\uff0c\u5c07\u300e\u9435\u7926\u77f3\u300f\u548c\u300e\u7b49\u96e2\u5b50\u6676\u9ad4\u300f\u7d50\u5408\uff0c\u88fd\u4f5c\u51fa\u300e\u7b49\u96e2\u5b50\u5200\u300f\uff0c\u9019\u662f\u4e00\u4ef6\u5f37\u5927\u7684\u6b66\u5668\u3002\u5176\u6b21\uff0c\u5728\u63a2\u7d22\u904e\u7a0b\u4e2d\u512a\u5148\u6536\u96c6\u7a00\u6709\u6750\u6599\uff0c\u56e0\u70ba\u5b83\u5011\u901a\u5e38\u662f\u9ad8\u7d1a\u914d\u65b9\u4e2d\u7684\u95dc\u9375\u7d44\u6210\u90e8\u5206\u3002\u6700\u5f8c\uff0c\u4f7f\u7528\u5de5\u85dd\u53f0\u7684\u300e\u5feb\u901f\u5de5\u85dd\u300f\u529f\u80fd\u4f86\u7c21\u5316\u6d41\u7a0b\uff0c\u5728\u95dc\u9375\u6642\u523b\u7bc0\u7701\u6642\u9593\u3002"}, {"question": "AstroDud.io\u7684\u50b7\u5bb3\u8a08\u7b97\u6a5f\u5236\u70ba\u4f55\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u5b83\uff1f", "answer": "\u5728AstroDud.io\u4e2d\uff0c\u50b7\u5bb3\u8a08\u7b97\u53d7\u5230\u591a\u500b\u56e0\u7d20\u5f71\u97ff\uff1a\u6b66\u5668\u985e\u578b\u3001\u6575\u4eba\u88dd\u7532\u548c\u73a9\u5bb6\u5c6c\u6027\u3002\u4f8b\u5982\uff0c\u300e\u7b49\u96e2\u5b50\u6b65\u69cd\u300f\u7684\u57fa\u790e\u50b7\u5bb3\u662f50\uff0c\u4f46\u9019\u53ef\u80fd\u6703\u88ab\u6575\u4eba\u7684\u300e\u80fd\u91cf\u76fe\u300f\u6e1b\u4f4e20%\u3002\u6b64\u5916\uff0c\u73a9\u5bb6\u7684\u300e\u529b\u91cf\u300f\u5c6c\u6027\u6703\u589e\u52a0\u50b7\u5bb3\u8f38\u51fa2%\u6bcf\u9ede\u3002\u70ba\u4e86\u6700\u5927\u5316\u50b7\u5bb3\uff0c\u88dd\u5099\u80fd\u5229\u7528\u6575\u4eba\u5f31\u9ede\u7684\u6b66\u5668\uff0c\u4f8b\u5982\uff0c\u4f7f\u7528\u300e\u51b7\u51cd\u69b4\u5f48\u300f\u5c0d\u4ed8\u4ee5\u706b\u70ba\u57fa\u790e\u7684\u6575\u4eba\u3002\u7406\u89e3\u9019\u4e9b\u6a5f\u5236\u6709\u52a9\u65bc\u66f4\u6709\u6548\u7684\u6230\u9b25\u7b56\u7565\u548c\u66f4\u597d\u7684\u8cc7\u6e90\u5206\u914d\u3002"}, {"question": "AstroDud.io\u7684\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "AstroDud.io\u7684\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u63d0\u4f9b\u4e0d\u540c\u7684\u9ad4\u9a57\u3002\u5728\u55ae\u4eba\u6a21\u5f0f\u4e2d\uff0c\u91cd\u9ede\u5728\u65bc\u5287\u60c5\u9032\u5ea6\u548c\u500b\u4eba\u6280\u80fd\u767c\u5c55\uff0c\u6709\u91dd\u5c0d\u6027\u7684\u6311\u6230\u5305\u62ec\u89e3\u8b0e\u548c\u30dc\u30b9\u6230\u3002\u7136\u800c\uff0c\u591a\u4eba\u6a21\u5f0f\u5247\u5f37\u8abf\u5718\u968a\u5408\u4f5c\u548c\u5354\u8abf\uff0c\u5305\u542b\u9700\u8981\u73a9\u5bb6\u7d50\u5408\u80fd\u529b\u7684\u4efb\u52d9\uff0c\u4f8b\u5982\u4e00\u4f4d\u73a9\u5bb6\u63d0\u4f9b\u63a9\u8b77\uff0c\u800c\u53e6\u4e00\u4eba\u89e3\u9664\u9677\u9631\u3002\u6b64\u5916\uff0c\u591a\u4eba\u6a21\u5f0f\u5f15\u9032\u7368\u7279\u7684\u734e\u52f5\uff0c\u4f8b\u5982\u5b8c\u6210\u5408\u4f5c\u4efb\u52d9\u7684\u7368\u5bb6\u5916\u89c0\u3002\u9078\u64c7\u6a21\u5f0f\u53d6\u6c7a\u65bc\u4f60\u662f\u5426\u559c\u6b61\u55ae\u7368\u63a2\u7d22\u6216\u5718\u968a\u5408\u4f5c\u904a\u6232\u3002"}, {"question": "\u5982\u4f55\u5c07\u6211\u7684AstroDud.io\u96fb\u8166\u7248\u9032\u5ea6\u8f49\u79fb\u5230\u624b\u6a5f\u5e73\u53f0\uff0c\u800c\u4e0d\u6703\u907a\u5931\u8cc7\u6599\uff1f", "answer": "\u8981\u5c07\u4f60\u7684AstroDud.io\u96fb\u8166\u7248\u9032\u5ea6\u8f49\u79fb\u5230\u624b\u6a5f\u5e73\u53f0\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u78ba\u4fdd\u5169\u500b\u88dd\u7f6e\u900f\u904e\u904a\u6232\u7684\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u9023\u63a5\u5230\u540c\u4e00\u500b\u5e33\u6236\u3002\u6b65\u9a5f2\uff1a\u5728\u4f60\u7684\u96fb\u8166\u4e0a\uff0c\u5c0e\u822a\u81f3\u8a2d\u5b9a\u9078\u55ae\uff0c\u9078\u64c7\u300e\u4e0a\u50b3\u5132\u5b58\u8cc7\u6599\u300f\u3002\u6b65\u9a5f3\uff1a\u5728\u4f60\u7684\u624b\u6a5f\u88dd\u7f6e\u4e0a\uff0c\u958b\u555f\u904a\u6232\u4e26\u5f9e\u8a2d\u5b9a\u4e2d\u9078\u64c7\u300e\u4e0b\u8f09\u5132\u5b58\u8cc7\u6599\u300f\u3002\u9019\u500b\u904e\u7a0b\u78ba\u4fdd\u6240\u6709\u4f60\u7684\u9032\u5ea6\uff0c\u5305\u62ec\u5eab\u5b58\u548c\u6210\u5c31\uff0c\u90fd\u80fd\u9806\u5229\u8f49\u79fb\u3002\u5728\u958b\u59cb\u8f49\u79fb\u4e4b\u524d\uff0c\u52d9\u5fc5\u5099\u4efd\u4f60\u7684\u8cc7\u6599\uff0c\u4ee5\u907f\u514d\u4efb\u4f55\u6f5b\u5728\u7684\u640d\u5931\u3002"}, {"question": "\u5728AstroDud.io\u4e2d\uff0c\u6211\u80fd\u627e\u5230\u54ea\u4e9b\u96b1\u85cf\u5f69\u86cb\uff0c\u4ee5\u53ca\u5b83\u5011\u7684\u4f4d\u7f6e\u5728\u54ea\u88e1\uff1f", "answer": "AstroDud.io\u5145\u6eff\u4e86\u96b1\u85cf\u5f69\u86cb\uff0c\u734e\u52f5\u63a2\u7d22\u3002\u4e00\u500b\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\u300e\u9280\u6cb3\u4f01\u9d5d\u300f\uff0c\u4f4d\u65bc\u300e\u51b0\u96ea\u5ee3\u88a4\u300f\u95dc\u5361\u3002\u8981\u627e\u5230\u5b83\uff0c\u8acb\u524d\u5f80\u51b0\u7011\u5f8c\u7684\u96b1\u85cf\u6d1e\u7a74\uff0c\u8207\u4f01\u9d5d\u96d5\u50cf\u4e92\u52d5\u3002\u53e6\u4e00\u500b\u5f69\u86cb\u662f\u300e\u958b\u767c\u8005\u623f\u9593\u300f\uff0c\u900f\u904e\u5728\u4e3b\u9078\u55ae\u8f38\u5165\u7279\u5b9a\u6309\u9215\u9806\u5e8f\u5373\u53ef\u5b58\u53d6\u3002\u9019\u4e9b\u5f69\u86cb\u901a\u5e38\u63d0\u4f9b\u7368\u7279\u7684\u7269\u54c1\u6216\u80cc\u666f\u6545\u4e8b\uff0c\u63d0\u5347\u904a\u6232\u7684\u6df1\u5ea6\u548c\u53ef\u91cd\u8907\u6027\u3002\u7559\u610f\u5468\u906d\u74b0\u5883\u7684\u5fae\u5999\u7dda\u7d22\uff0c\u4ee5\u63ed\u958b\u66f4\u591a\u79d8\u5bc6\u3002"}, {"question": "AstroDud.io\u4e2d\u54ea\u500b\u89d2\u8272\u985e\u578b\u5728\u9032\u653b\u8207\u9632\u5b88\u4e4b\u9593\u63d0\u4f9b\u6700\u4f73\u5e73\u8861\uff1f", "answer": "AstroDud.io\u4e2d\u7684\u300e\u54e8\u5175\u300f\u89d2\u8272\u5728\u9032\u653b\u8207\u9632\u5b88\u4e4b\u9593\u63d0\u4f9b\u6700\u4f73\u5e73\u8861\u3002\u54e8\u5175\u64c1\u6709\u9069\u4e2d\u7684\u751f\u547d\u503c\u548c\u88dd\u7532\u503c\uff0c\u53ef\u4ee5\u5728\u627f\u53d7\u76f8\u7576\u7684\u50b7\u5bb3\u7684\u540c\u6642\uff0c\u6301\u7e8c\u9020\u6210\u50b7\u5bb3\u3002\u4f8b\u5982\uff0c\u300e\u7b49\u96e2\u5b50\u76fe\u300f\u80fd\u529b\u63d0\u4f9b\u4e8630%\u7684\u50b7\u5bb3\u6e1b\u514d\uff0c\u8b93\u54e8\u5175\u5728\u6230\u9b25\u4e2d\u6301\u7e8c\u66f4\u9577\u6642\u9593\u3002\u6b64\u5916\uff0c\u300e\u7b49\u96e2\u5b50\u5c04\u7dda\u69cd\u300f\u6b66\u5668\u5c0d\u55ae\u4e00\u76ee\u6a19\u9020\u6210\u9ad8\u50b7\u5bb3\uff0c\u4f7f\u5176\u5c0d\u6297\u30dc\u30b9\u975e\u5e38\u6709\u6548\u3002\u9019\u7a2e\u5e73\u8861\u8b93\u54e8\u5175\u975e\u5e38\u9069\u5408\u90a3\u4e9b\u504f\u611b\u591a\u529f\u80fd\u904a\u6232\u98a8\u683c\u7684\u73a9\u5bb6\uff0c\u80fd\u5920\u9069\u61c9\u5404\u7a2e\u6230\u9b25\u60c5\u5883\u3002"}, {"question": "\u5982\u4f55\u5728AstroDud.io\u4e2d\u6709\u6548\u5730\u6536\u96c6\u8cc7\u6e90\uff0c\u800c\u4e0d\u6703\u6d6a\u8cbb\u6642\u9593\uff1f", "answer": "\u5728AstroDud.io\u4e2d\u6709\u6548\u5730\u6536\u96c6\u8cc7\u6e90\uff0c\u9700\u8981\u7b56\u7565\u6027\u898f\u5283\u548c\u8def\u7dda\u6700\u4f73\u5316\u3002\u6b65\u9a5f1\uff1a\u8b58\u5225\u9ad8\u7522\u91cf\u8cc7\u6e90\u7bc0\u9ede\uff0c\u4f8b\u5982\u300e\u6676\u9ad4\u6d1e\u7a74\u300f\uff0c\u9019\u4e9b\u6d1e\u7a74\u6703\u7522\u751f\u7a00\u6709\u6750\u6599\uff0c\u5982\u300e\u7b49\u96e2\u5b50\u6676\u9ad4\u300f\u3002\u6b65\u9a5f2\uff1a\u88dd\u5099\u80fd\u63d0\u9ad8\u6536\u96c6\u901f\u5ea6\u7684\u5de5\u5177\uff0c\u4f8b\u5982\u300e\u63a1\u7926\u96f7\u5c04\u69cd\u300f\uff0c\u53ef\u5c07\u6536\u96c6\u6642\u9593\u7e2e\u77ed50%\u3002\u6b65\u9a5f3\uff1a\u4f7f\u7528\u5feb\u901f\u65c5\u884c\u9ede\u5728\u8cc7\u6e90\u8c50\u5bcc\u7684\u5730\u5340\u4e4b\u9593\u5feb\u901f\u79fb\u52d5\uff0c\u6700\u5927\u9650\u5ea6\u5730\u6e1b\u5c11\u9592\u7f6e\u6642\u9593\u3002\u6b64\u5916\uff0c\u53c3\u8207\u9650\u6642\u6d3b\u52d5\uff0c\u9019\u4e9b\u6d3b\u52d5\u6703\u70ba\u5b8c\u6210\u7279\u5b9a\u76ee\u6a19\u63d0\u4f9b\u984d\u5916\u8cc7\u6e90\u3002\u900f\u904e\u9075\u5faa\u9019\u4e9b\u6b65\u9a5f\uff0c\u4f60\u5c07\u6700\u5927\u5316\u4f60\u7684\u8cc7\u6e90\u651d\u5165\u91cf\uff0c\u4e26\u5c07\u52aa\u529b\u964d\u5230\u6700\u4f4e\u3002"}, {"question": "AstroDud.io\u7684\u8972\u64ca\u6311\u6230\u4e2d\uff0c\u54ea\u4e9b\u5718\u968a\u7d44\u6210\u6700\u6709\u6548\uff1f", "answer": "AstroDud.io\u7684\u8972\u64ca\u6311\u6230\u4e2d\uff0c\u6709\u6548\u7684\u5718\u968a\u7d44\u6210\u9700\u8981\u89d2\u8272\u7684\u6df7\u5408\u642d\u914d\u3002\u4e00\u500b\u5e73\u8861\u7684\u5718\u968a\u5305\u62ec\u4e00\u500b\u300e\u5766\u514b\u300f\uff08\u4f8b\u5982\uff0c\u5b88\u8b77\u8005\uff09\uff0c\u4e00\u500b\u300e\u6cbb\u7642\u5e2b\u300f\uff08\u4f8b\u5982\uff0c\u91ab\u7642\u4eba\u54e1\uff09\uff0c\u4ee5\u53ca\u5169\u500b\u300e\u8f38\u51fa\u300f\uff08\u4f8b\u5982\uff0c\u523a\u5ba2\u548c\u5de5\u7a0b\u5e2b\uff09\u3002\u5b88\u8b77\u8005\u5438\u6536\u50b7\u5bb3\uff0c\u91ab\u7642\u4eba\u54e1\u63d0\u4f9b\u6cbb\u7642\uff0c\u800c\u8f38\u51fa\u6280\u80fd\u7684\u91cd\u9ede\u662f\u9020\u6210\u9ad8\u50b7\u5bb3\u3002\u4f8b\u5982\uff0c\u5728\u300e\u6cf0\u5766\u5de2\u7a74\u300f\u8972\u64ca\u4e2d\uff0c\u5de5\u7a0b\u5e2b\u7684\u300e\u7832\u5854\u300f\u80fd\u529b\u53ef\u4ee5\u63a7\u5236\u5c0f\u602a\uff0c\u800c\u523a\u5ba2\u5247\u5c08\u6ce8\u65bc\u30dc\u30b9\u3002\u9019\u7a2e\u7d44\u6210\u78ba\u4fdd\u4e86\u751f\u5b58\u80fd\u529b\u548c\u6709\u6548\u8f38\u51fa\uff0c\u9019\u5c0d\u65bc\u5b8c\u6210\u5177\u6709\u6311\u6230\u6027\u7684\u8972\u64ca\u81f3\u95dc\u91cd\u8981\u3002"}]
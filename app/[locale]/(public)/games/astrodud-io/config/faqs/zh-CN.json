[{"question": "\u65b0\u624b\u5982\u4f55\u5feb\u901f\u638c\u63e1AstroDud.io\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u638c\u63e1AstroDud.io\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u9996\u5148\u8981\u719f\u6089\u79fb\u52a8\u548c\u4ea4\u4e92\u6309\u952e\u3002\u4f8b\u5982\uff0c\u4f7f\u7528WASD\u952e\u8fdb\u884c\u79fb\u52a8\uff0c\u7a7a\u683c\u952e\u8fdb\u884c\u8df3\u8dc3\u3002\u5728\u6559\u7a0b\u5173\u5361\u7ec3\u4e60\u8fd9\u4e9b\u64cd\u4f5c\uff0c\u4f60\u53ef\u4ee5\u901a\u8fc7\u7b80\u5355\u7684\u969c\u788d\u7269\u5e76\u6536\u96c6\u57fa\u672c\u9053\u5177\u3002\u6b64\u5916\uff0c\u5229\u7528\u6e38\u620f\u8bbe\u7f6e\u81ea\u5b9a\u4e49\u4f60\u7684\u6309\u952e\u7ed1\u5b9a\uff0c\u4ee5\u83b7\u5f97\u8212\u9002\u611f\u3002\u4e00\u4e2a\u6709\u7528\u7684\u6280\u5de7\u662f\uff0c\u5982\u679c\u9700\u8981\uff0c\u91cd\u65b0\u6620\u5c04\u201c\u4ea4\u4e92\u201d\u952e\u5230\u66f4\u6613\u8bbf\u95ee\u7684\u6309\u94ae\u3002\u901a\u8fc7\u6301\u7eed\u7ec3\u4e60\u8fd9\u4e9b\u64cd\u4f5c\uff0c\u4f60\u5c06\u5efa\u7acb\u808c\u8089\u8bb0\u5fc6\u5e76\u63d0\u9ad8\u4f60\u7684\u6e38\u620f\u6548\u7387\u3002"}, {"question": "\u5728AstroDud.io\u6e38\u620f\u4e2d\u73a9\u6ee1100\u5c0f\u65f6\u540e\uff0c\u5982\u4f55\u6709\u6548\u5ef6\u957f\u6e38\u620f\u751f\u5b58\u65f6\u95f4\uff1f", "answer": "\u5728AstroDud.io\u6e38\u620f\u4e2d\u73a9\u6ee1100\u5c0f\u65f6\u540e\uff0c\u5ef6\u957f\u751f\u5b58\u65f6\u95f4\u9700\u8981\u66f4\u9ad8\u7ea7\u7684\u7b56\u7565\u3002\u6b65\u9aa4\u4e00\uff1a\u4e13\u6ce8\u4e8e\u8d44\u6e90\u7ba1\u7406\u2014\u2014\u59cb\u7ec8\u4f18\u5148\u6536\u96c6\u751f\u547d\u836f\u6c34\u548c\u5f39\u836f\u3002\u6b65\u9aa4\u4e8c\uff1a\u638c\u63e1\u654c\u4eba\u7684\u653b\u51fb\u6a21\u5f0f\uff1b\u4f8b\u5982\uff0c\u7814\u7a76\u201cZorgon\u201d\u654c\u4eba\u7684\u653b\u51fb\u95f4\u9694\uff0c\u4ee5\u4fbf\u6709\u6548\u5730\u8eb2\u907f\u653b\u51fb\u3002\u6b65\u9aa4\u4e09\uff1a\u5229\u7528\u73af\u5883\u4f18\u52bf\uff0c\u4f8b\u5982\u5229\u7528\u9ad8\u5730\u83b7\u5f97\u66f4\u597d\u7684\u89c6\u91ce\u548c\u63a9\u62a4\u3002\u6b64\u5916\uff0c\u6295\u8d44\u5347\u7ea7\u4f60\u7684\u89d2\u8272\u6280\u80fd\uff0c\u4f8b\u5982\u589e\u52a0\u957f\u65f6\u95f4\u6218\u6597\u7684\u4f53\u529b\u3002\u901a\u8fc7\u7ed3\u5408\u8fd9\u4e9b\u7b56\u7565\uff0c\u4f60\u5c06\u663e\u7740\u63d0\u9ad8\u4f60\u7684\u751f\u5b58\u7387\u3002"}, {"question": "\u4e3a\u4ec0\u4e48AstroDud.io\u7684\u5236\u4f5c\u7cfb\u7edf\u9700\u8981\u7279\u5b9a\u7684\u7269\u54c1\u7ec4\u5408\uff0c\u4ee5\u53ca\u5982\u4f55\u4f18\u5316\u5b83\uff1f", "answer": "AstroDud.io\u7684\u5236\u4f5c\u7cfb\u7edf\u65e8\u5728\u9f13\u52b1\u73a9\u5bb6\u7684\u6218\u7565\u601d\u7ef4\u548c\u8d44\u6e90\u4f18\u5316\u3002\u7279\u5b9a\u7684\u7269\u54c1\u7ec4\u5408\u786e\u4fdd\u73a9\u5bb6\u5fc5\u987b\u8ba1\u5212\u548c\u6536\u96c6\u5404\u79cd\u6750\u6599\u3002\u4e3a\u4e86\u4f18\u5316\u5236\u4f5c\uff0c\u9996\u5148\uff0c\u53c2\u8003\u6e38\u620f\u4e2d\u7684\u5236\u4f5c\u6307\u5357\uff0c\u5176\u4e2d\u5217\u51fa\u4e86\u6240\u6709\u53ef\u80fd\u7684\u7ec4\u5408\u3002\u4f8b\u5982\uff0c\u5c06\u201c\u94c1\u77ff\u77f3\u201d\u548c\u201c\u7b49\u79bb\u5b50\u6676\u4f53\u201d\u7ec4\u5408\u53ef\u4ee5\u5236\u4f5c\u201c\u7b49\u79bb\u5b50\u5251\u201d\uff0c\u8fd9\u662f\u4e00\u79cd\u5f3a\u5927\u7684\u6b66\u5668\u3002\u5176\u6b21\uff0c\u5728\u63a2\u7d22\u8fc7\u7a0b\u4e2d\u4f18\u5148\u6536\u96c6\u7a00\u6709\u6750\u6599\uff0c\u56e0\u4e3a\u5b83\u4eec\u901a\u5e38\u662f\u9ad8\u7ea7\u914d\u65b9\u4e2d\u7684\u5173\u952e\u7ec4\u6210\u90e8\u5206\u3002\u6700\u540e\uff0c\u4f7f\u7528\u5236\u4f5c\u53f0\u7684\u201c\u5feb\u901f\u5236\u4f5c\u201d\u529f\u80fd\u6765\u7b80\u5316\u6d41\u7a0b\uff0c\u5728\u5173\u952e\u65f6\u523b\u8282\u7701\u65f6\u95f4\u3002"}, {"question": "AstroDud.io\u4e2d\u7684\u4f24\u5bb3\u8ba1\u7b97\u662f\u5982\u4f55\u5de5\u4f5c\u7684\uff0c\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u5b83\uff1f", "answer": "\u5728AstroDud.io\u4e2d\uff0c\u4f24\u5bb3\u8ba1\u7b97\u53d7\u591a\u79cd\u56e0\u7d20\u5f71\u54cd\uff1a\u6b66\u5668\u7c7b\u578b\u3001\u654c\u4eba\u62a4\u7532\u548c\u73a9\u5bb6\u5c5e\u6027\u3002\u4f8b\u5982\uff0c\u201c\u7b49\u79bb\u5b50\u6b65\u67aa\u201d\u7684\u57fa\u4f24\u5bb3\u4e3a50\uff0c\u4f46\u654c\u4eba\u7684\u201c\u80fd\u91cf\u62a4\u76fe\u201d\u53ef\u4ee5\u964d\u4f4e20%\u3002\u6b64\u5916\uff0c\u73a9\u5bb6\u7684\u201c\u529b\u91cf\u201d\u5c5e\u6027\u4f1a\u589e\u52a0\u6bcf\u70b92%\u7684\u4f24\u5bb3\u8f93\u51fa\u3002\u4e3a\u4e86\u6700\u5927\u5316\u4f24\u5bb3\uff0c\u88c5\u5907\u80fd\u591f\u5229\u7528\u654c\u4eba\u5f31\u70b9\uff08\u4f8b\u5982\uff0c\u4f7f\u7528\u201c\u51b7\u51bb\u70b8\u5f39\u201d\u653b\u51fb\u706b\u7cfb\u654c\u4eba\uff09\u7684\u6b66\u5668\u3002\u4e86\u89e3\u8fd9\u4e9b\u673a\u5236\u53ef\u4ee5\u5f62\u6210\u66f4\u6709\u6548\u7684\u6218\u6597\u7b56\u7565\uff0c\u5e76\u66f4\u597d\u5730\u5206\u914d\u8d44\u6e90\u3002"}, {"question": "AstroDud.io\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "AstroDud.io\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u63d0\u4f9b\u4e86\u4e0d\u540c\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u5728\u5355\u4eba\u6a21\u5f0f\u4e2d\uff0c\u91cd\u70b9\u5728\u4e8e\u6545\u4e8b\u53d1\u5c55\u548c\u4e2a\u4eba\u6280\u80fd\u63d0\u5347\uff0c\u5305\u62ec\u5b9a\u5236\u7684\u6311\u6218\uff0c\u4f8b\u5982\u89e3\u8c1c\u548c\u6218\u6597boss\u3002\u800c\u591a\u4eba\u6a21\u5f0f\u5219\u5f3a\u8c03\u56e2\u961f\u5408\u4f5c\u548c\u534f\u8c03\uff0c\u6e38\u620f\u4efb\u52a1\u9700\u8981\u73a9\u5bb6\u7ed3\u5408\u80fd\u529b\uff0c\u4f8b\u5982\u4e00\u540d\u73a9\u5bb6\u63d0\u4f9b\u63a9\u62a4\uff0c\u800c\u53e6\u4e00\u540d\u73a9\u5bb6\u5219\u62c6\u9664\u9677\u9631\u3002\u6b64\u5916\uff0c\u591a\u4eba\u6a21\u5f0f\u8fd8\u5f15\u5165\u4e86\u72ec\u7279\u7684\u5956\u52b1\uff0c\u4f8b\u5982\u5b8c\u6210\u5408\u4f5c\u4efb\u52a1\u53ef\u4ee5\u83b7\u5f97\u72ec\u5bb6\u76ae\u80a4\u3002\u9009\u62e9\u54ea\u79cd\u6a21\u5f0f\u53d6\u51b3\u4e8e\u4f60\u662f\u5426\u66f4\u559c\u6b22\u5355\u4eba\u63a2\u7d22\u6216\u56e2\u961f\u5408\u4f5c\u3002"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684AstroDud.io PC\u8fdb\u5ea6\u8f6c\u79fb\u5230\u79fb\u52a8\u8bbe\u5907\uff0c\u800c\u4e0d\u4f1a\u4e22\u5931\u6570\u636e\uff1f", "answer": "\u8981\u5c06\u4f60\u7684AstroDud.io PC\u8fdb\u5ea6\u8f6c\u79fb\u5230\u79fb\u52a8\u8bbe\u5907\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa4\u4e00\uff1a\u786e\u4fdd\u4e24\u4e2a\u8bbe\u5907\u90fd\u901a\u8fc7\u6e38\u620f\u4e91\u4fdd\u5b58\u529f\u80fd\u8fde\u63a5\u5230\u540c\u4e00\u4e2a\u5e10\u6237\u3002\u6b65\u9aa4\u4e8c\uff1a\u5728\u4f60\u7684PC\u4e0a\uff0c\u5bfc\u822a\u5230\u8bbe\u7f6e\u83dc\u5355\u5e76\u9009\u62e9\u201c\u4e0a\u4f20\u5b58\u6863\u6570\u636e\u201d\u3002\u6b65\u9aa4\u4e09\uff1a\u5728\u4f60\u7684\u79fb\u52a8\u8bbe\u5907\u4e0a\uff0c\u6253\u5f00\u6e38\u620f\u5e76\u4ece\u8bbe\u7f6e\u4e2d\u9009\u62e9\u201c\u4e0b\u8f7d\u5b58\u6863\u6570\u636e\u201d\u3002\u6b64\u8fc7\u7a0b\u53ef\u786e\u4fdd\u5e73\u7a33\u5730\u8f6c\u79fb\u6240\u6709\u4f60\u7684\u8fdb\u5ea6\uff0c\u5305\u62ec\u5e93\u5b58\u548c\u6210\u5c31\u3002\u5728\u5f00\u59cb\u8f6c\u79fb\u4e4b\u524d\uff0c\u8bf7\u52a1\u5fc5\u5907\u4efd\u4f60\u7684\u6570\u636e\uff0c\u4ee5\u907f\u514d\u4efb\u4f55\u6f5c\u5728\u7684\u6570\u636e\u4e22\u5931\u3002"}, {"question": "\u5728AstroDud.io\u4e2d\uff0c\u6211\u53ef\u4ee5\u627e\u5230\u54ea\u4e9b\u9690\u85cf\u7684\u5f69\u86cb\uff0c\u5b83\u4eec\u5728\u54ea\u91cc\uff1f", "answer": "AstroDud.io\u4e2d\u5145\u6ee1\u4e86\u9690\u85cf\u7684\u5f69\u86cb\uff0c\u5956\u52b1\u63a2\u7d22\u3002\u4e00\u4e2a\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\u201c\u661f\u9645\u4f01\u9e45\u201d\uff0c\u4f4d\u4e8e\u201c\u51b0\u51bb\u5730\u57df\u201d\u5173\u5361\u4e2d\u3002\u8981\u627e\u5230\u5b83\uff0c\u8bf7\u524d\u5f80\u51b0\u7011\u5e03\u540e\u9762\u9690\u85cf\u7684\u5c71\u6d1e\uff0c\u5e76\u4e0e\u4f01\u9e45\u96d5\u50cf\u4e92\u52a8\u3002\u53e6\u4e00\u4e2a\u5f69\u86cb\u662f\u201c\u5f00\u53d1\u8005\u623f\u95f4\u201d\uff0c\u53ef\u4ee5\u901a\u8fc7\u5728\u4e3b\u83dc\u5355\u4e2d\u8f93\u5165\u7279\u5b9a\u6309\u94ae\u5e8f\u5217\u6765\u8bbf\u95ee\u3002\u8fd9\u4e9b\u5f69\u86cb\u901a\u5e38\u4f1a\u63d0\u4f9b\u72ec\u7279\u7684\u9053\u5177\u6216\u6545\u4e8b\u80cc\u666f\uff0c\u589e\u5f3a\u6e38\u620f\u7684\u6df1\u5ea6\u548c\u53ef\u73a9\u6027\u3002\u8bf7\u6ce8\u610f\u73af\u5883\u4e2d\u7684\u7ec6\u5fae\u7ebf\u7d22\uff0c\u4ee5\u53d1\u73b0\u66f4\u591a\u79d8\u5bc6\u3002"}, {"question": "\u54ea\u4e2a\u89d2\u8272\u5728AstroDud.io\u4e2d\u5728\u653b\u51fb\u548c\u9632\u5fa1\u4e4b\u95f4\u63d0\u4f9b\u6700\u4f73\u5e73\u8861\uff1f", "answer": "\u5728AstroDud.io\u4e2d\uff0c\u201c\u54e8\u5175\u201d\u89d2\u8272\u5728\u653b\u51fb\u548c\u9632\u5fa1\u4e4b\u95f4\u63d0\u4f9b\u4e86\u6700\u4f73\u5e73\u8861\u3002\u54e8\u5175\u89d2\u8272\u62e5\u6709\u4e2d\u7b49\u751f\u547d\u503c\u548c\u62a4\u7532\u5c5e\u6027\uff0c\u80fd\u591f\u627f\u53d7\u76f8\u5f53\u5927\u7684\u4f24\u5bb3\uff0c\u540c\u65f6\u9020\u6210\u6301\u7eed\u7684\u4f24\u5bb3\u3002\u4f8b\u5982\uff0c\u201c\u7b49\u79bb\u5b50\u62a4\u76fe\u201d\u6280\u80fd\u63d0\u4f9b30%\u7684\u4f24\u5bb3\u51cf\u514d\uff0c\u8ba9\u54e8\u5175\u53ef\u4ee5\u5728\u6218\u6597\u4e2d\u5b58\u6d3b\u66f4\u957f\u65f6\u95f4\u3002\u6b64\u5916\uff0c\u201c\u7b49\u79bb\u5b50\u67aa\u201d\u6b66\u5668\u5bf9\u5355\u4f53\u76ee\u6807\u9020\u6210\u9ad8\u4f24\u5bb3\uff0c\u4f7f\u5176\u5728\u5bf9\u6297boss\u65f6\u975e\u5e38\u6709\u6548\u3002\u8fd9\u79cd\u5e73\u8861\u4f7f\u5f97\u54e8\u5175\u89d2\u8272\u975e\u5e38\u9002\u5408\u90a3\u4e9b\u559c\u6b22\u591a\u53d8\u6e38\u620f\u98ce\u683c\u7684\u73a9\u5bb6\uff0c\u80fd\u591f\u9002\u5e94\u5404\u79cd\u6218\u6597\u60c5\u51b5\u3002"}, {"question": "\u5982\u4f55\u5728AstroDud.io\u4e2d\u6709\u6548\u5730\u91c7\u96c6\u8d44\u6e90\uff0c\u800c\u4e0d\u4f1a\u6d6a\u8d39\u65f6\u95f4\uff1f", "answer": "\u5728AstroDud.io\u4e2d\u6709\u6548\u91c7\u96c6\u8d44\u6e90\u9700\u8981\u6218\u7565\u89c4\u5212\u548c\u8def\u7ebf\u4f18\u5316\u3002\u6b65\u9aa4\u4e00\uff1a\u786e\u5b9a\u9ad8\u4ea7\u8d44\u6e90\u8282\u70b9\uff0c\u4f8b\u5982\u201c\u6676\u4f53\u6d1e\u7a74\u201d\uff0c\u53ef\u4ee5\u4ea7\u751f\u7a00\u6709\u6750\u6599\uff0c\u4f8b\u5982\u201c\u7b49\u79bb\u5b50\u6676\u4f53\u201d\u3002\u6b65\u9aa4\u4e8c\uff1a\u88c5\u5907\u53ef\u63d0\u9ad8\u91c7\u96c6\u901f\u5ea6\u7684\u5de5\u5177\uff0c\u4f8b\u5982\u201c\u91c7\u77ff\u6fc0\u5149\u5668\u201d\uff0c\u53ef\u5c06\u91c7\u96c6\u65f6\u95f4\u7f29\u77ed50%\u3002\u6b65\u9aa4\u4e09\uff1a\u4f7f\u7528\u5feb\u901f\u65c5\u884c\u70b9\u5728\u5bcc\u542b\u8d44\u6e90\u7684\u533a\u57df\u5feb\u901f\u79fb\u52a8\uff0c\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u505c\u987f\u65f6\u95f4\u3002\u6b64\u5916\uff0c\u53c2\u4e0e\u9650\u65f6\u6d3b\u52a8\uff0c\u8fd9\u4e9b\u6d3b\u52a8\u4f1a\u4e3a\u5b8c\u6210\u7279\u5b9a\u76ee\u6807\u63d0\u4f9b\u989d\u5916\u8d44\u6e90\u3002\u901a\u8fc7\u9075\u5faa\u8fd9\u4e9b\u6b65\u9aa4\uff0c\u4f60\u53ef\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u8d44\u6e90\u83b7\u53d6\u91cf\uff0c\u540c\u65f6\u5c06\u52aa\u529b\u964d\u5230\u6700\u4f4e\u3002"}, {"question": "\u5728AstroDud.io\u7684\u7a81\u88ad\u6311\u6218\u4e2d\uff0c\u54ea\u4e9b\u56e2\u961f\u6784\u6210\u6700\u6709\u6548\uff1f", "answer": "\u5728AstroDud.io\u7684\u7a81\u88ad\u6311\u6218\u4e2d\uff0c\u6709\u6548\u7684\u56e2\u961f\u6784\u6210\u9700\u8981\u591a\u79cd\u89d2\u8272\u7684\u7ec4\u5408\u3002\u4e00\u4e2a\u5e73\u8861\u7684\u56e2\u961f\u5305\u62ec\u4e00\u4e2a\u201c\u5766\u514b\u201d\uff08\u4f8b\u5982\uff0c\u5b88\u62a4\u8005\uff09\uff0c\u4e00\u4e2a\u201c\u6cbb\u7597\u8005\u201d\uff08\u4f8b\u5982\uff0c\u533b\u5e08\uff09\uff0c\u4ee5\u53ca\u4e24\u4e2a\u201cDPS\u201d\uff08\u4f8b\u5982\uff0c\u523a\u5ba2\u548c\u5de5\u7a0b\u5e08\uff09\u3002\u5b88\u62a4\u8005\u5438\u6536\u4f24\u5bb3\uff0c\u533b\u5e08\u63d0\u4f9b\u6cbb\u7597\uff0c\u800cDPS\u89d2\u8272\u5219\u4e13\u6ce8\u4e8e\u9020\u6210\u9ad8\u4f24\u5bb3\u3002\u4f8b\u5982\uff0c\u5728\u201c\u6cf0\u5766\u5de2\u7a74\u201d\u7a81\u88ad\u4e2d\uff0c\u5de5\u7a0b\u5e08\u7684\u201c\u70ae\u5854\u201d\u6280\u80fd\u53ef\u4ee5\u63a7\u5236\u5c0f\u602a\uff0c\u800c\u523a\u5ba2\u5219\u4e13\u6ce8\u4e8e\u653b\u51fbboss\u3002\u8fd9\u79cd\u7ec4\u5408\u786e\u4fdd\u4e86\u751f\u5b58\u80fd\u529b\u548c\u6709\u6548\u7684\u4f24\u5bb3\u8f93\u51fa\uff0c\u8fd9\u5bf9\u4e8e\u5b8c\u6210\u5177\u6709\u6311\u6218\u6027\u7684\u7a81\u88ad\u81f3\u5173\u91cd\u8981\u3002"}]
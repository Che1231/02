[{"question": "AstroDud.io\u306e\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001\u57fa\u672c\u64cd\u4f5c\u3092\u7d20\u65e9\u304f\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "AstroDud.io\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u307e\u305a\u79fb\u52d5\u30ad\u30fc\u3068\u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3\u30ad\u30fc\u3092\u899a\u3048\u307e\u3057\u3087\u3046\u3002\u305f\u3068\u3048\u3070\u3001WASD\u30ad\u30fc\u3092\u79fb\u52d5\u3001\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u3092\u30b8\u30e3\u30f3\u30d7\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30ec\u30d9\u30eb\u3067\u3053\u308c\u3089\u306e\u64cd\u4f5c\u3092\u7df4\u7fd2\u3057\u3001\u7c21\u5358\u306a\u969c\u5bb3\u7269\u3092\u907f\u3051\u3001\u57fa\u672c\u7684\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u96c6\u3081\u307e\u3057\u3087\u3046\u3002\u3055\u3089\u306b\u3001\u30b2\u30fc\u30e0\u5185\u8a2d\u5b9a\u3092\u4f7f\u7528\u3057\u3066\u3001\u30ad\u30fc\u30d0\u30a4\u30f3\u30c9\u3092\u5feb\u9069\u306b\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3059\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u3002\u5fc5\u8981\u306b\u5fdc\u3058\u3066\u3001\u300e\u30a4\u30f3\u30bf\u30e9\u30af\u30c8\u300f\u30ad\u30fc\u3092\u3088\u308a\u4f7f\u3044\u3084\u3059\u3044\u30dc\u30bf\u30f3\u306b\u518d\u5272\u308a\u5f53\u3066\u3059\u308b\u306e\u3082\u6709\u52b9\u306a\u30d2\u30f3\u30c8\u3067\u3059\u3002\u3053\u308c\u3089\u306e\u64cd\u4f5c\u3092\u7d99\u7d9a\u7684\u306b\u7df4\u7fd2\u3059\u308b\u3053\u3068\u3067\u3001\u7b4b\u8089\u8a18\u61b6\u3092\u5f37\u5316\u3057\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u52b9\u7387\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001AstroDud.io\u3067\u9577\u304f\u751f\u304d\u6b8b\u308b\u305f\u3081\u306e\u91cd\u8981\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "AstroDud.io\u3067100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u3088\u308a\u9577\u304f\u751f\u304d\u6b8b\u308b\u305f\u3081\u306b\u306f\u9ad8\u5ea6\u306a\u6226\u7565\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff11\uff1a\u8cc7\u6e90\u7ba1\u7406\u306b\u7126\u70b9\u3092\u5f53\u3066\u3001\u5e38\u306b\u56de\u5fa9\u85ac\u3068\u5f3e\u85ac\u306e\u53ce\u96c6\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff12\uff1a\u6575\u306e\u884c\u52d5\u30d1\u30bf\u30fc\u30f3\u3092\u30de\u30b9\u30bf\u30fc\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300eZorgon\u300f\u6575\u306e\u653b\u6483\u9593\u9694\u3092\u7814\u7a76\u3057\u3066\u3001\u52b9\u679c\u7684\u306b\u56de\u907f\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff13\uff1a\u9ad8\u5730\u3092\u5229\u7528\u3057\u3066\u3001\u3088\u308a\u826f\u3044\u8996\u754c\u3068\u30ab\u30d0\u30fc\u3092\u5f97\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u306e\u80fd\u529b\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u3001\u9577\u6642\u9593\u6226\u95d8\u306e\u305f\u3081\u306e\u30b9\u30bf\u30df\u30ca\u3092\u5897\u3084\u3059\u6295\u8cc7\u3082\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u6226\u7565\u3092\u7d44\u307f\u5408\u308f\u305b\u3066\u3001\u751f\u5b58\u7387\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u307e\u3057\u3087\u3046\u3002"}, {"question": "AstroDud.io\u306e\u30af\u30e9\u30d5\u30c8\u30b7\u30b9\u30c6\u30e0\u304c\u7279\u5b9a\u306e\u30a2\u30a4\u30c6\u30e0\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u5fc5\u8981\u3068\u3059\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u3069\u306e\u3088\u3046\u306b\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "AstroDud.io\u306e\u30af\u30e9\u30d5\u30c8\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6226\u7565\u7684\u306a\u601d\u8003\u3068\u8cc7\u6e90\u306e\u6700\u9069\u5316\u3092\u4fc3\u9032\u3059\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u7279\u5b9a\u306e\u30a2\u30a4\u30c6\u30e0\u306e\u7d44\u307f\u5408\u308f\u305b\u306b\u3088\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u8a08\u753b\u7684\u306b\u69d8\u3005\u306a\u6750\u6599\u3092\u96c6\u3081\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30af\u30e9\u30d5\u30c8\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u307e\u305a\u30b2\u30fc\u30e0\u5185\u306e\u30af\u30e9\u30d5\u30c8\u30ac\u30a4\u30c9\u3092\u53c2\u7167\u3057\u3001\u3059\u3079\u3066\u306e\u53ef\u80fd\u306a\u7d44\u307f\u5408\u308f\u305b\u3092\u30ea\u30b9\u30c8\u30a2\u30c3\u30d7\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u9244\u9271\u77f3\u300d\u3068\u300c\u30d7\u30e9\u30ba\u30de\u7d50\u6676\u300d\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3068\u3001\u300c\u30d7\u30e9\u30ba\u30de\u30d6\u30ec\u30fc\u30c9\u300d\u3068\u3044\u3046\u5f37\u529b\u306a\u6b66\u5668\u304c\u4f5c\u6210\u3055\u308c\u307e\u3059\u3002\u6b21\u306b\u3001\u63a2\u7d22\u4e2d\u306b\u30ec\u30a2\u306a\u7d20\u6750\u3092\u96c6\u3081\u308b\u3053\u3068\u3092\u512a\u5148\u3057\u307e\u3057\u3087\u3046\u3002\u30ec\u30a2\u306a\u7d20\u6750\u306f\u3001\u9ad8\u5ea6\u306a\u30ec\u30b7\u30d4\u306e\u91cd\u8981\u306a\u69cb\u6210\u8981\u7d20\u3067\u3042\u308b\u3053\u3068\u304c\u591a\u3044\u304b\u3089\u3067\u3059\u3002\u6700\u5f8c\u306b\u3001\u88fd\u4f5c\u53f0\u306e\u300c\u30af\u30a4\u30c3\u30af\u30af\u30e9\u30d5\u30c8\u300d\u6a5f\u80fd\u3092\u4f7f\u3063\u3066\u3001\u91cd\u8981\u306a\u5834\u9762\u3067\u6642\u9593\u3092\u7bc0\u7d04\u3057\u306a\u304c\u3089\u4f5c\u696d\u3092\u30b9\u30e0\u30fc\u30ba\u306b\u51e6\u7406\u3057\u307e\u3059\u3002"}, {"question": "AstroDud.io\u306e\u30c0\u30e1\u30fc\u30b8\u8a08\u7b97\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u3069\u306e\u3088\u3046\u306a\u8981\u56e0\u304c\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "AstroDud.io\u306e\u30c0\u30e1\u30fc\u30b8\u8a08\u7b97\u306f\u3001\u6b66\u5668\u306e\u7a2e\u985e\u3001\u6575\u306e\u30a2\u30fc\u30de\u30fc\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u306a\u3069\u3001\u3044\u304f\u3064\u304b\u306e\u8981\u7d20\u306b\u3088\u3063\u3066\u5f71\u97ff\u3092\u53d7\u3051\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30d7\u30e9\u30ba\u30de\u30e9\u30a4\u30d5\u30eb\u300d\u306f\u57fa\u672c\u30c0\u30e1\u30fc\u30b8\u304c50\u3067\u3059\u304c\u3001\u6575\u306e\u300c\u30a8\u30cd\u30eb\u30ae\u30fc\u30b7\u30fc\u30eb\u30c9\u300d\u306b\u3088\u3063\u306620%\u6e1b\u5c11\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u300c\u529b\u300d\u30b9\u30c6\u30fc\u30bf\u30b9\u306f\u3001\u5404\u30dd\u30a4\u30f3\u30c8\u3042\u305f\u308a2%\u30c0\u30e1\u30fc\u30b8\u5897\u52a0\u3057\u307e\u3059\u3002\u30c0\u30e1\u30fc\u30b8\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u6575\u306e\u5f31\u70b9\u3092\u5229\u7528\u3059\u308b\u6b66\u5668\u3092\u88c5\u5099\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u300e\u51b7\u6c17\u30b0\u30ec\u30cd\u30fc\u30c9\u300f\u3092\u706b\u5c5e\u6027\u306e\u6575\u306b\u5bfe\u3057\u3066\u4f7f\u7528\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u52b9\u679c\u7684\u306a\u6226\u95d8\u6226\u7565\u3068\u3088\u308a\u826f\u3044\u8cc7\u6e90\u914d\u5206\u304c\u53ef\u80fd\u306b\u306a\u308a\u307e\u3059\u3002"}, {"question": "AstroDud.io\u306e\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "AstroDud.io\u306e\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u3001\u7570\u306a\u308b\u4f53\u9a13\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u3067\u306f\u3001\u30d1\u30ba\u30eb\u89e3\u8aad\u3084\u30dc\u30b9\u6226\u306a\u3069\u306e\u500b\u5225\u8ab2\u984c\u3092\u901a\u3057\u3066\u3001\u30b9\u30c8\u30fc\u30ea\u30fc\u306e\u9032\u884c\u3068\u500b\u3005\u306e\u30b9\u30ad\u30eb\u958b\u767a\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u4e00\u65b9\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u3068\u9023\u643a\u3092\u91cd\u8996\u3057\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u80fd\u529b\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u5fc5\u8981\u304c\u3042\u308b\u30df\u30c3\u30b7\u30e7\u30f3\uff08\u4f8b\u3048\u3070\u3001\u7247\u65b9\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30ab\u30d0\u30fc\u3092\u884c\u3044\u3001\u3082\u3046\u7247\u65b9\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30c8\u30e9\u30c3\u30d7\u3092\u89e3\u9664\u3059\u308b\uff09\u3092\u7279\u5fb4\u3068\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u5354\u529b\u30df\u30c3\u30b7\u30e7\u30f3\u306e\u5b8c\u4e86\u306b\u5bfe\u3059\u308b\u9650\u5b9a\u7684\u306a\u30b9\u30ad\u30f3\u306a\u3069\u306e\u72ec\u81ea\u306e\u5831\u916c\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u3069\u3061\u3089\u306e\u30e2\u30fc\u30c9\u3092\u9078\u3076\u304b\u306f\u3001\u30bd\u30ed\u3067\u306e\u63a2\u691c\u304b\u3001\u5354\u529b\u578b\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u304b\u3092\u91cd\u8996\u3059\u308b\u304b\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u3002"}, {"question": "PC\u304b\u3089\u30e2\u30d0\u30a4\u30eb\u306bAstroDud.io\u306e\u9032\u884c\u72b6\u6cc1\u3092\u30c7\u30fc\u30bf\u640d\u5931\u306a\u304f\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "PC\u304b\u3089\u30e2\u30d0\u30a4\u30eb\u306bAstroDud.io\u306e\u9032\u884c\u72b6\u6cc1\u3092\u30c7\u30fc\u30bf\u640d\u5931\u306a\u304f\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d7\uff11\uff1a\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u304c\u3001\u30b2\u30fc\u30e0\u306e\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u901a\u3057\u3066\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u63a5\u7d9a\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff12\uff1aPC\u3067\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u3092\u958b\u304d\u3001\u300c\u4fdd\u5b58\u30c7\u30fc\u30bf\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u300d\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff13\uff1a\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u3067\u30b2\u30fc\u30e0\u3092\u958b\u304d\u3001\u8a2d\u5b9a\u304b\u3089\u300c\u4fdd\u5b58\u30c7\u30fc\u30bf\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u300d\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u3053\u306e\u30d7\u30ed\u30bb\u30b9\u306b\u3088\u308a\u3001\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u3084\u5b9f\u7e3e\u306a\u3069\u3001\u3059\u3079\u3066\u306e\u9032\u884c\u72b6\u6cc1\u304c\u30b7\u30fc\u30e0\u30ec\u30b9\u306b\u8ee2\u9001\u3055\u308c\u307e\u3059\u3002\u8ee2\u9001\u3092\u958b\u59cb\u3059\u308b\u524d\u306b\u5e38\u306b\u30c7\u30fc\u30bf\u3092\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u3057\u3066\u3001\u6f5c\u5728\u7684\u306a\u640d\u5931\u3092\u56de\u907f\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "AstroDud.io\u3067\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3068\u3001\u305d\u306e\u5834\u6240\u3092\u6559\u3048\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "AstroDud.io\u306b\u306f\u3001\u63a2\u6c42\u3092\u5831\u3044\u308b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u305f\u304f\u3055\u3093\u3042\u308a\u307e\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306e1\u3064\u306f\u3001\u300c\u51cd\u571f\u5730\u57df\u300d\u30ec\u30d9\u30eb\u306b\u3042\u308b\u300c\u9280\u6cb3\u30da\u30f3\u30ae\u30f3\u300d\u3067\u3059\u3002\u6c37\u306e\u6edd\u306e\u5f8c\u308d\u306e\u96a0\u3055\u308c\u305f\u6d1e\u7a9f\u306b\u5165\u308a\u3001\u30da\u30f3\u30ae\u30f3\u306e\u50cf\u3068\u30a4\u30f3\u30bf\u30e9\u30af\u30c8\u3059\u308b\u3068\u898b\u3064\u304b\u308a\u307e\u3059\u3002\u3082\u30461\u3064\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3001\u300c\u958b\u767a\u8005\u30eb\u30fc\u30e0\u300d\u3067\u3001\u30e1\u30a4\u30f3\u30e1\u30cb\u30e5\u30fc\u3067\u7279\u5b9a\u306e\u30dc\u30bf\u30f3\u306e\u30b7\u30fc\u30b1\u30f3\u30b9\u3092\u5165\u529b\u3059\u308b\u3068\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3001\u591a\u304f\u306e\u5834\u5408\u3001\u30b2\u30fc\u30e0\u306e\u6df1\u3055\u3068\u518d\u30d7\u30ec\u30a4\u6027\u3092\u9ad8\u3081\u308b\u3001\u30e6\u30cb\u30fc\u30af\u306a\u30a2\u30a4\u30c6\u30e0\u3084\u30ed\u30a2\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u3088\u308a\u591a\u304f\u306e\u79d8\u5bc6\u3092\u767a\u898b\u3059\u308b\u305f\u3081\u306b\u3001\u74b0\u5883\u306e\u5fae\u5999\u306a\u624b\u304c\u304b\u308a\u306b\u6ce8\u76ee\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "AstroDud.io\u306e\u3069\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30af\u30e9\u30b9\u304c\u653b\u6483\u3068\u9632\u5fa1\u306e\u30d0\u30e9\u30f3\u30b9\u304c\u6700\u3082\u512a\u308c\u3066\u3044\u307e\u3059\u304b\uff1f", "answer": "AstroDud.io\u3067\u653b\u6483\u3068\u9632\u5fa1\u306e\u30d0\u30e9\u30f3\u30b9\u304c\u6700\u9069\u306a\u30af\u30e9\u30b9\u306f\u300c\u30bb\u30f3\u30c6\u30a3\u30cd\u30eb\u300d\u3067\u3059\u3002\u4e2d\u7a0b\u5ea6\u306e\u4f53\u529b\u3068\u30a2\u30fc\u30de\u30fc\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u5099\u3048\u305f\u30bb\u30f3\u30c6\u30a3\u30cd\u30eb\u306f\u3001\u5927\u304d\u306a\u30c0\u30e1\u30fc\u30b8\u3092\u8010\u3048\u306a\u304c\u3089\u3001\u7d99\u7d9a\u7684\u306aDPS\u3092\u4e0e\u3048\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30d7\u30e9\u30ba\u30de\u30b7\u30fc\u30eb\u30c9\u300d\u80fd\u529b\u306f30%\u306e\u30c0\u30e1\u30fc\u30b8\u8efd\u6e1b\u3092\u63d0\u4f9b\u3057\u3001\u6226\u95d8\u3067\u30bb\u30f3\u30c6\u30a3\u30cd\u30eb\u304c\u9577\u304f\u751f\u304d\u6b8b\u308b\u306e\u3092\u53ef\u80fd\u306b\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u300c\u30a4\u30aa\u30f3\u30d6\u30e9\u30b9\u30bf\u30fc\u300d\u6b66\u5668\u306f\u5358\u4f53\u30bf\u30fc\u30b2\u30c3\u30c8\u306b\u9ad8\u3044\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u3001\u30dc\u30b9\u306b\u5bfe\u3057\u3066\u6709\u52b9\u3067\u3059\u3002\u3053\u306e\u30d0\u30e9\u30f3\u30b9\u306b\u3088\u308a\u3001\u30bb\u30f3\u30c6\u30a3\u30cd\u30eb\u306f\u591a\u69d8\u306a\u6226\u95d8\u30b7\u30ca\u30ea\u30aa\u306b\u5bfe\u5fdc\u3067\u304d\u308b\u3001\u591a\u69d8\u306a\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u3092\u597d\u3080\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u6700\u9069\u3067\u3059\u3002"}, {"question": "AstroDud.io\u3067\u6642\u9593\u3092\u7121\u99c4\u306b\u305b\u305a\u306b\u52b9\u7387\u7684\u306b\u8cc7\u6e90\u3092\u53ce\u96c6\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "AstroDud.io\u3067\u52b9\u7387\u7684\u306b\u8cc7\u6e90\u3092\u53ce\u96c6\u3059\u308b\u306b\u306f\u3001\u6226\u7565\u7684\u306a\u8a08\u753b\u3068\u30eb\u30fc\u30c8\u6700\u9069\u5316\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff11\uff1a\u9ad8\u53ce\u76ca\u306e\u8cc7\u6e90\u30ce\u30fc\u30c9\uff08\u300c\u30af\u30ea\u30b9\u30bf\u30eb\u6d1e\u7a9f\u300d\u306a\u3069\u3001\u30ec\u30a2\u306a\u7d20\u6750\u300c\u30d7\u30e9\u30ba\u30de\u7d50\u6676\u300d\u304c\u767a\u751f\u3057\u3084\u3059\u3044\u5834\u6240\uff09\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff12\uff1a\u63a1\u6398\u901f\u5ea6\u3092\u9ad8\u3081\u308b\u30c4\u30fc\u30eb\uff08\u300c\u30de\u30a4\u30cb\u30f3\u30b0\u30ec\u30fc\u30b6\u30fc\u300d\u306a\u3069\u3001\u53ce\u96c6\u6642\u9593\u309250%\u524a\u6e1b\u3059\u308b\u30c4\u30fc\u30eb\uff09\u3092\u88c5\u5099\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d7\uff13\uff1a\u9ad8\u901f\u79fb\u52d5\u30dd\u30a4\u30f3\u30c8\u3092\u4f7f\u7528\u3057\u3066\u3001\u8cc7\u6e90\u8c4a\u5bcc\u306a\u30a8\u30ea\u30a2\u3092\u3059\u3070\u3084\u304f\u79fb\u52d5\u3057\u3001\u30c0\u30a6\u30f3\u30bf\u30a4\u30e0\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u7279\u5b9a\u306e\u76ee\u6a19\u9054\u6210\u3067\u30dc\u30fc\u30ca\u30b9\u8cc7\u6e90\u3092\u63d0\u4f9b\u3059\u308b\u30bf\u30a4\u30de\u30fc\u30a4\u30d9\u30f3\u30c8\u306b\u53c2\u52a0\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u624b\u9806\u306b\u5f93\u3046\u3053\u3068\u3067\u3001\u52aa\u529b\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u306a\u304c\u3089\u8cc7\u6e90\u306e\u6442\u53d6\u91cf\u3092\u6700\u5927\u9650\u306b\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "AstroDud.io\u306e\u8972\u6483\u30c1\u30e3\u30ec\u30f3\u30b8\u3067\u6700\u3082\u52b9\u679c\u7684\u306a\u30c1\u30fc\u30e0\u69cb\u6210\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "AstroDud.io\u306e\u8972\u6483\u30c1\u30e3\u30ec\u30f3\u30b8\u3067\u52b9\u679c\u7684\u306a\u30c1\u30fc\u30e0\u69cb\u6210\u306f\u3001\u5f79\u5272\u306e\u7d44\u307f\u5408\u308f\u305b\u304c\u5fc5\u8981\u3067\u3059\u3002\u30d0\u30e9\u30f3\u30b9\u306e\u53d6\u308c\u305f\u30c1\u30fc\u30e0\u306b\u306f\u300c\u30bf\u30f3\u30af\u300d\uff08\u305f\u3068\u3048\u3070\u3001\u30ac\u30fc\u30c7\u30a3\u30a2\u30f3\uff09\u3001\u300c\u30d2\u30fc\u30e9\u30fc\u300d\uff08\u305f\u3068\u3048\u3070\u3001\u30e1\u30c7\u30a3\u30c3\u30af\uff09\u3001\u300cDPS\u300d2\u4eba\uff08\u305f\u3068\u3048\u3070\u3001\u30a2\u30b5\u30b7\u30f3\u3068\u30a8\u30f3\u30b8\u30cb\u30a2\uff09\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u30ac\u30fc\u30c7\u30a3\u30a2\u30f3\u306f\u30c0\u30e1\u30fc\u30b8\u3092\u5438\u53ce\u3057\u3001\u30e1\u30c7\u30a3\u30c3\u30af\u306f\u6cbb\u7642\u3092\u63d0\u4f9b\u3057\u3001DPS\u30af\u30e9\u30b9\u306f\u9ad8\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u3053\u3068\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30bf\u30a4\u30bf\u30f3\u306e\u5de3\u7a9f\u300d\u306e\u8972\u6483\u3067\u306f\u3001\u30a8\u30f3\u30b8\u30cb\u30a2\u306e\u300c\u30bf\u30fc\u30ec\u30c3\u30c8\u300d\u80fd\u529b\u306f\u8ffd\u52a0\u306e\u6575\u3092\u5236\u5fa1\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u3001\u30a2\u30b5\u30b7\u30f3\u306f\u30dc\u30b9\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u3053\u306e\u69cb\u6210\u306f\u3001\u751f\u304d\u6b8b\u308a\u3068\u52b9\u7387\u7684\u306a\u30c0\u30e1\u30fc\u30b8\u51fa\u529b\u306e\u4e21\u65b9\u3092\u78ba\u4fdd\u3057\u3001\u6311\u6226\u7684\u306a\u8972\u6483\u3092\u5b8c\u4e86\u3059\u308b\u305f\u3081\u306b\u91cd\u8981\u3067\u3059\u3002"}]
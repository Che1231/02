[{"question": "\uace8\ud504 \uc624\ube44\ud2b8 \ucd08\ubcf4\uc790\uac00 \uae30\ubcf8 \uc2a4\uc719 \uba54\ucee4\ub2c8\uc998\uc744 \uc219\ub2ec\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uace8\ud504 \uc624\ube44\ud2b8\uc5d0\uc11c \uae30\ubcf8 \uc2a4\uc719 \uba54\ucee4\ub2c8\uc998\uc744 \uc219\ub2ec\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. \ub2e8\uacc4 1 - \uc6d0\ud558\ub294 \ubc29\ud5a5\uc73c\ub85c \uada4\uc801\uc120\uc744 \ub4dc\ub798\uadf8\ud558\uc5ec \uc0f7\uc744 \uc815\ub82c\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2 - \ud654\uba74\uc744 \ud0ed\ud558\uace0 \ub20c\ub7ec \ud30c\uc6cc \ubbf8\ud130\ub97c \uc870\uc808\ud55c \ub2e4\uc74c \uc2a4\uc719\uc744 \uc704\ud574 \ud574\uc81c\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3 - \ud654\uba74\uc5d0 \ud45c\uc2dc\ub418\ub294 \ud654\uc0b4\ud45c\uc640 \uc22b\uc790\uc5d0 \ud45c\uc2dc\ub41c \ubc14\ub78c \ubc29\ud5a5\uacfc \uc18d\ub3c4\ub97c \uace0\ub824\ud558\uc5ec \uc0f7\uc744 \ubbf8\uc138 \uc870\uc815\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubc14\ub78c\uc774 \uc624\ub978\ucabd\uc73c\ub85c \uc2dc\uc18d 5\ub9c8\uc77c\ub85c \ubd80\ub294 \uacbd\uc6b0 \ubcf4\uc815\uc744 \uc704\ud574 \uc57d\uac04 \uc67c\ucabd\uc73c\ub85c \uc870\uc900\ud558\uc138\uc694. [\ube44\uc720 \uc124\uba85: \ud30c\uc6cc \ubbf8\ud130\ub97c \ud65c\uacfc \ud654\uc0b4\ucc98\ub7fc \uc0dd\uac01\ud558\uc2ed\uc2dc\uc624. \ub20c\ub7ec\uc11c \uc7a1\ub294 \uc2dc\uac04\uc774 \uae38\uc218\ub85d \uc0f7 \uac70\ub9ac\uac00 \uba40\uc5b4\uc9d1\ub2c8\ub2e4.]"}, {"question": "\uace8\ud504 \uc624\ube44\ud2b8\uc5d0\uc11c \ubc14\ub78c \uc694\uc18c\ub97c \uc774\ud574\ud558\ub294 \uac83\uc774 \uac8c\uc784\uc744 \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uace8\ud504 \uc624\ube44\ud2b8\uc5d0\uc11c \ubc14\ub78c \uc694\uc18c\ub97c \uc774\ud574\ud558\ub294 \uac83\uc740 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \ubc14\ub78c\uc740 \uacf5\uc758 \uada4\uc801\uacfc \ucc29\uc9c0 \uc704\uce58\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \ubc14\ub78c\uc758 \ubc29\ud5a5\uacfc \uc18d\ub3c4\ub294 \ud654\uba74\uc5d0 \ud654\uc0b4\ud45c\uc640 \uc22b\uc790\ub85c \ud45c\uc2dc\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubc14\ub78c\uc774 \uc67c\ucabd\uc73c\ub85c \uc2dc\uc18d 10\ub9c8\uc77c\ub85c \ubd80\ub294 \uacbd\uc6b0, \ubc14\ub78c\uc758 \uc601\ud5a5\uc744 \uc0c1\uc1c4\ud558\uae30 \uc704\ud574 \uc57d\uac04 \uc624\ub978\ucabd\uc73c\ub85c \uc870\uc900\ud574\uc57c \ud569\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: \ubaa9\ud45c\ubb3c\uc744 \uc9c1\uc811 \uc870\uc900\ud558\ub294 \uac83\uacfc \ubc14\ub78c\uc744 \uace0\ub824\ud558\uc5ec \uc870\uc900\ud558\ub294 \uac83\uc744 \ube44\uad50\ud574 \ubcf4\uc138\uc694. \ud6c4\uc790\ub294 \ud56d\uc0c1 \ub354 \ub098\uc740 \uacb0\uacfc\ub97c \uac00\uc838\uc635\ub2c8\ub2e4.]"}, {"question": "\uace8\ud504 \uc624\ube44\ud2b8\uc758 \ud544\uc218 \uac15\ud654 \uc544\uc774\ud15c\uc740 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \uae30\ub2a5\ud569\ub2c8\uae4c?", "answer": "\uace8\ud504 \uc624\ube44\ud2b8\uc758 \ud544\uc218 \uac15\ud654 \uc544\uc774\ud15c\uc5d0\ub294 \"\ud130\ubcf4 \ubd80\uc2a4\ud2b8\"\uc640 \"\uc815\ubc00 \uc870\uc900\"\uc774 \uc788\uc2b5\ub2c8\ub2e4. \"\ud130\ubcf4 \ubd80\uc2a4\ud2b8\"\ub294 \uacf5\uc758 \uc18d\ub3c4\ub97c \ub192\uc5ec \ub354 \uba40\ub9ac \ub0a0\uc544\uac00\ub3c4\ub85d \ud558\uba70, \"\uc815\ubc00 \uc870\uc900\"\uc740 \uada4\uc801\uc120\uc744 \uc881\ud600 \ub354 \uc815\ud655\ud55c \uc0f7\uc744 \uac00\ub2a5\ud558\uac8c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uae34 \ud30c 5 \ud640\uc5d0\uc11c \"\ud130\ubcf4 \ubd80\uc2a4\ud2b8\"\ub97c \uc0ac\uc6a9\ud558\uba74 \ub35c \ud798\ub4e0 \uc0f7\uc73c\ub85c \uadf8\ub9b0\uc5d0 \ub3c4\ub2ec\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \ud130\ubcf4 \ubd80\uc2a4\ud2b8 - \uc18d\ub3c4 \uc99d\uac00; \uc815\ubc00 \uc870\uc900 - \uc815\ud655\ub3c4 \ud5a5\uc0c1.]"}, {"question": "\uace8\ud504 \uc624\ube44\ud2b8\uc5d0\uc11c 100\uc2dc\uac04 \uc774\uc0c1 \ud50c\ub808\uc774\ud55c \uc120\uc218\ub4e4\uc774 \uc810\uc218\ub97c \ub0ae\ucd94\uae30 \uc704\ud574 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \uace0\uae09 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uace8\ud504 \uc624\ube44\ud2b8\uc5d0\uc11c 100\uc2dc\uac04 \uc774\uc0c1 \ud50c\ub808\uc774\ud55c \uc120\uc218\ub4e4\uc740 \"\ucf54\uc2a4 \uad00\ub9ac\"\uc640 \"\uc704\ud5d8 \ud3c9\uac00\"\uc640 \uac19\uc740 \uace0\uae09 \uc804\ub7b5\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1 - \ucf54\uc2a4 \ub808\uc774\uc544\uc6c3\uc744 \uac80\ud1a0\ud558\uc5ec \uc704\ud5d8 \uc694\uc18c\uc640 \uc548\uc804 \uad6c\uc5ed\uc744 \ud30c\uc545\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2 - \ubc14\ub78c\uacfc \uc9c0\ud615\uc744 \uace0\ub824\ud558\uc5ec \uac01 \uc0f7\uc744 \uacc4\ud68d\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3 - \ubb3c \uc704\ub85c \uae34 \uc0f7\uc744 \uc2dc\ub3c4\ud558\ub294 \uac83\ucc98\ub7fc \uc704\ud5d8\uc744 \uac10\uc218\ud560 \ub54c\uc640 \uc548\uc804\ud558\uac8c \ud50c\ub808\uc774\ud560 \ub54c\ub97c \uacb0\uc815\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc881\uc740 \ud398\uc5b4\uc6e8\uc774\uac00 \uc788\ub294 \ud30c 4 \ud640\uc5d0\uc11c\ub294 \uae34 \ub4dc\ub77c\uc774\ube0c\ub97c \uc704\ud5d8\ud55c \ub7ec\ud504\ub85c \ub0a0\ub9b4 \uc704\ud5d8\ubcf4\ub2e4\ub294 \ub808\uc774\uc5c5\uc744 \ud558\ub294 \uac83\uc774 \ub354 \ud604\uba85\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \ucf54\uc2a4 \ub808\uc774\uc544\uc6c3 -> \uc704\ud5d8 \uc694\uc18c \ud30c\uc545 -> \uc0f7 \uacc4\ud68d -> \uc2e4\ud589.]"}, {"question": "\uace8\ud504 \uc624\ube44\ud2b8\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \uc5b4\ub5a4 \uc694\uc18c\uac00 \uc810\uc218\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\uace8\ud504 \uc624\ube44\ud2b8\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ud640\uc744 \uc644\ub8cc\ud558\ub294 \ub370 \uc18c\uc694\ub41c \ud0c0\uc218\ub97c \uae30\ubc18\uc73c\ub85c \ud558\uba70, \ud30c\uac00 \ud45c\uc900\uc785\ub2c8\ub2e4. \uc810\uc218\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc694\uc18c\ub294 \ud640\uc758 \uae38\uc774, \uc704\ud5d8 \uc694\uc18c \ubc0f \ubc14\ub78c \uc870\uac74\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac15\ud55c \ubc14\ub78c\uc774 \ubd80\ub294 \ud30c 3 \ud640\uc5d0\uc11c\ub294 \ud3c9\uc18c\ubcf4\ub2e4 \ub354 \ub9ce\uc740 \ud0c0\uc218\uac00 \ud544\uc694\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud30c\ub97c \uae30\uc900\uc810\uc73c\ub85c \uc0dd\uac01\ud558\uc2ed\uc2dc\uc624. \ud0c0\uc218\uac00 \uc801\uc744\uc218\ub85d \uc810\uc218\uac00 \uc88b\uc2b5\ub2c8\ub2e4.]"}, {"question": "\uace8\ud504 \uc624\ube44\ud2b8\uc5d0\uc11c \"\ud640\uc778\uc6d0\" \ub2ec\uc131\uc758 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \uc9c0\uc18d\uc801\uc73c\ub85c \ub2ec\uc131\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uace8\ud504 \uc624\ube44\ud2b8\uc5d0\uc11c \"\ud640\uc778\uc6d0\" \ub2ec\uc131\uc740 \ud2f0\uc0f7\uc5d0\uc11c \ud640\uc5d0 \ubc14\ub85c \uacf5\uc774 \ub5a8\uc5b4\uc9c0\ub294 \uc644\ubcbd\ud55c \uc0f7\uc744 \ub098\ud0c0\ub0b4\ubbc0\ub85c \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc774\ub97c \uc9c0\uc18d\uc801\uc73c\ub85c \ub2ec\uc131\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. 1\ub2e8\uacc4 - \"\uc815\ubc00 \uc870\uc900\"\uc744 \uc0ac\uc6a9\ud558\uc5ec \uada4\uc801\uc120\uc744 \uc881\ud799\ub2c8\ub2e4. 2\ub2e8\uacc4 - \ubc14\ub78c\uacfc \uc9c0\ud615\uc744 \uace0\ub824\ud558\uc5ec \uc870\uc815\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4 - \ud0c0\uc774\ubc0d\uacfc \ud30c\uc6cc \uc81c\uc5b4\ub97c \uc644\ubcbd\ud558\uac8c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubc14\ub78c\uc774 \uac70\uc758 \uc5c6\ub294 \uc9e7\uc740 \ud30c 3 \ud640\uc5d0\uc11c \"\uc815\ubc00 \uc870\uc900\"\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud0c0\uc774\ubc0d\uc774 \uc644\ubcbd\ud55c \uc0f7\uc744 \ub0a0\ub9ac\uba74 \"\ud640\uc778\uc6d0\"\uc744 \ub2ec\uc131\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: \"\uc815\ubc00 \uc870\uc900\"\uc744 \uc0ac\uc6a9\ud558\ub294 \uac83\uacfc \uc77c\ubc18\uc801\uc778 \uc870\uc900\uc744 \ube44\uad50\ud574 \ubcf4\uc2ed\uc2dc\uc624. \uc804\uc790\ub294 \"\ud640\uc778\uc6d0\" \ub2ec\uc131 \uac00\ub2a5\uc131\uc744 \ub192\uc785\ub2c8\ub2e4.]"}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 \uac8c\uc784 \ub0b4 \ud1b5\uacc4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uace8\ud504 \uc624\ube44\ud2b8\uc758 \uc131\ub2a5\uc744 \uc5b4\ub5bb\uac8c \ubd84\uc11d\ud558\uace0 \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud50c\ub808\uc774\uc5b4\ub294 \uace8\ud504 \uc624\ube44\ud2b8\uc758 \uc131\ub2a5\uc744 \ubd84\uc11d\ud558\uace0 \ucd5c\uc801\ud654\ud558\uae30 \uc704\ud574 \uac8c\uc784 \ub0b4 \ud1b5\uacc4, \uc608\ub97c \ub4e4\uc5b4 \"\ud3c9\uade0 \ud640\ub2f9 \ud0c0\uc218\"\uc640 \"\ud640\uc778\uc6d0 \uc131\uacf5\ub960\"\uc744 \uac80\ud1a0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1 - \uba54\uc778 \ud654\uba74\uc5d0\uc11c \ud1b5\uacc4 \uba54\ub274\uc5d0 \uc811\uadfc\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2 - \ud30c 5 \ud640\uc5d0\uc11c \uc9c0\uc18d\uc801\uc73c\ub85c \ub192\uc740 \uc810\uc218\uc640 \uac19\uc740 \ud328\ud134\uc744 \ud30c\uc545\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3 - \uae34 \ub4dc\ub77c\uc774\ube0c\ub098 \ud37c\ud305 \uc5f0\uc2b5\uacfc \uac19\uc740 \uc57d\ud55c \ubd84\uc57c\ub97c \uac1c\uc120\ud558\ub294 \ub370 \uc9d1\uc911\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ud3c9\uade0 \ud640\ub2f9 \ud0c0\uc218\"\uac00 \ud30c 5\uc5d0\uc11c \ub192\uc740 \uacbd\uc6b0 \uae34 \uac70\ub9ac \uc0f7 \uc5f0\uc2b5\uc5d0 \ub354 \ub9ce\uc740 \uc2dc\uac04\uc744 \ud560\uc560\ud558\uc2ed\uc2dc\uc624. [\uad6c\uc131 \ube44\uad50\ud45c: \ud3c9\uade0 \ud640\ub2f9 \ud0c0\uc218 - \uc57d\uc810 \uc601\uc5ed \uc2dd\ubcc4; \ud640\uc778\uc6d0 \uc131\uacf5\ub960 - \uc815\ud655\ub3c4 \uce21\uc815.]"}, {"question": "\ubaa8\ubc14\uc77c \ubc0f PC \ubc84\uc804\uc758 \uace8\ud504 \uc624\ube44\ud2b8 \uac04 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc774\uba70 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ubaa8\ubc14\uc77c \ubc0f PC \ubc84\uc804\uc758 \uace8\ud504 \uc624\ube44\ud2b8 \uac04 \uc8fc\uc694 \ucc28\uc774\uc810\uc5d0\ub294 \uc81c\uc5b4 \uba54\ucee4\ub2c8\uc998\uacfc \ud654\uba74 \ud06c\uae30\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ubaa8\ubc14\uc77c\uc5d0\uc11c\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \ud130\uce58 \uc81c\uc5b4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc0f7\uc744 \uc870\uc815\ud558\uace0, PC\uc5d0\uc11c\ub294 \ub9c8\uc6b0\uc2a4\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. PC\uc758 \ub354 \ud070 \ud654\uba74\uc740 \ucf54\uc2a4\uc758 \uc138\ubd80\uc801\uc778 \ub0b4\uc6a9\uc744 \ub354 \uc790\uc138\ud558\uac8c \ubcf4\uc5ec\uc8fc\ubbc0\ub85c \uc815\ubc00\ub3c4\ub97c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uada4\uc801\uc120\uc758 \uc2dc\uac01\uc801 \uac1c\uc120\uc73c\ub85c \uc778\ud574 PC\uc5d0\uc11c \uc0f7\uc744 \uc815\ub82c\ud558\ub294 \uac83\uc774 \ub354 \uc26c\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: \ubaa8\ubc14\uc77c\uc758 \ud130\uce58 \uc81c\uc5b4 \ub300 PC\uc758 \ub9c8\uc6b0\uc2a4 \uc81c\uc5b4; \ud6c4\uc790\ub294 \ub354 \ud070 \uc815\ubc00\ub3c4\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4.]"}, {"question": "\uace8\ud504 \uc624\ube44\ud2b8\uc5d0\uc11c \uc228\uaca8\uc9c4 \ucf54\uc2a4\ub97c \uc5b4\ub5bb\uac8c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc73c\uba70, \uc804\uc81c \uc870\uac74\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud50c\ub808\uc774\uc5b4\ub294 \ud2b9\uc815 \uc5c5\uc801\uc744 \ub2ec\uc131\ud558\uac70\ub098 \ud2b9\uc815 \ub9c8\uc77c\uc2a4\ud1a4\uc5d0 \ub3c4\ub2ec\ud568\uc73c\ub85c\uc368 \uace8\ud504 \uc624\ube44\ud2b8\uc5d0\uc11c \uc228\uaca8\uc9c4 \ucf54\uc2a4\ub97c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ube44\ubc00 \uadf8\ub9b0\" \ucf54\uc2a4\ub294 10\ubc88\uc758 \"\ud640\uc778\uc6d0\"\uc744 \ub2ec\uc131\ud55c \ud6c4 \uc7a0\uae08\uc774 \ud574\uc81c\ub429\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc5c5\uc801 \ub2ec\uc131 -> \ub9c8\uc77c\uc2a4\ud1a4 \ub3c4\ub2ec -> \uc228\uaca8\uc9c4 \ucf54\uc2a4 \uc7a0\uae08 \ud574\uc81c.]"}, {"question": "\uc7a5\uce58\ub97c \ubcc0\uacbd\ud560 \ub54c \uace8\ud504 \uc624\ube44\ud2b8\uc5d0\uc11c \ub370\uc774\ud130\ub97c \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud558\ub294 \ucd5c\uc0c1\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\"\uace8\ud504 \uc624\ube44\ud2b8\"\uc5d0\uc11c \ub370\uc774\ud130\ub97c \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud558\ub294 \ucd5c\uc0c1\uc758 \ubc29\ubc95\uc740 Google Play \ub610\ub294 Apple Game Center\uc640 \uac19\uc740 \ud074\ub77c\uc6b0\ub4dc \uc11c\ube44\uc2a4\uc5d0 \uac8c\uc784 \uacc4\uc815\uc744 \uc5f0\uacb0\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \ub2e8\uacc4 1 - \ud604\uc7ac \uc7a5\uce58\uac00 \ud074\ub77c\uc6b0\ub4dc \uc11c\ube44\uc2a4\uc5d0 \uc5f0\uacb0\ub418\uc5b4 \uc788\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2 - \uac8c\uc784 \ub370\uc774\ud130\ub97c \ud074\ub77c\uc6b0\ub4dc\uc5d0 \ub3d9\uae30\ud654\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3 - \uc0c8 \uc7a5\uce58\uc5d0\uc11c \ub3d9\uc77c\ud55c \ud074\ub77c\uc6b0\ub4dc \uc11c\ube44\uc2a4\uc5d0 \ub85c\uadf8\uc778\ud558\uc5ec \ub370\uc774\ud130\ub97c \uac80\uc0c9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc548\ub4dc\ub85c\uc774\ub4dc \ud734\ub300\ud3f0\uc5d0\uc11c \uc544\uc774\ud3f0\uc73c\ub85c \ubcc0\uacbd\ud558\ub294 \uacbd\uc6b0 \ubcc0\uacbd \uc804\uc5d0 \uacc4\uc815\uc744 Google Play\uc5d0 \uc5f0\uacb0\ud558\uc2ed\uc2dc\uc624. [\uad6c\uc131 \ube44\uad50\ud45c: \uc548\ub4dc\ub85c\uc774\ub4dc - Google Play; \uc544\uc774\ud3f0 - Apple Game Center.]"}]
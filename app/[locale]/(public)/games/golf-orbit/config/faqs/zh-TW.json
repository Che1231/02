[{"question": "\u9ad8\u723e\u592b\u8ecc\u8de1\u521d\u5b78\u8005\u5982\u4f55\u638c\u63e1\u57fa\u672c\u63ee\u687f\u6280\u5de7\uff1f", "answer": "\u8981\u638c\u63e1\u9ad8\u723e\u592b\u8ecc\u8de1\u7684\u57fa\u672c\u63ee\u687f\u6280\u5de7\uff0c\u8acb\u6309\u7167\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u5c07\u60a8\u7684\u64ca\u7403\u8def\u7dda\u62d6\u66f3\u5230\u60f3\u8981\u7684\u98db\u884c\u65b9\u5411\u3002\u6b65\u9a5f2 - \u9ede\u64ca\u4e26\u6309\u4f4f\u87a2\u5e55\u8abf\u6574\u529b\u91cf\u8a08\uff0c\u7136\u5f8c\u91cb\u653e\u4ee5\u63ee\u687f\u3002\u6b65\u9a5f3 - \u8003\u616e\u98a8\u5411\u548c\u98a8\u901f\uff08\u87a2\u5e55\u4e0a\u7684\u7bad\u982d\u548c\u6578\u5b57\u986f\u793a\uff09\uff0c\u5fae\u8abf\u60a8\u7684\u64ca\u7403\u3002\u4f8b\u5982\uff0c\u5982\u679c\u98a8\u5411\u70ba\u53f3\u908a 5 \u82f1\u91cc/\u5c0f\u6642\uff0c\u5247\u61c9\u7a0d\u5fae\u5411\u5de6\u7784\u6e96\u4ee5\u88dc\u511f\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u529b\u91cf\u8a08\u60f3\u50cf\u6210\u5f13\u7bad\uff1b\u6309\u58d3\u6642\u9593\u8d8a\u9577\uff0c\u64ca\u7403\u8ddd\u96e2\u8d8a\u9060\u3002]"}, {"question": "\u5728\u9ad8\u723e\u592b\u8ecc\u8de1\u904a\u6232\u4e2d\uff0c\u4e86\u89e3\u98a8\u5411\u56e0\u7d20\u70ba\u4f55\u80fd\u986f\u8457\u63d0\u5347\u60a8\u7684\u904a\u6232\u8868\u73fe\uff1f", "answer": "\u5728\u9ad8\u723e\u592b\u8ecc\u8de1\u4e2d\u4e86\u89e3\u98a8\u5411\u56e0\u7d20\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6703\u76f4\u63a5\u5f71\u97ff\u7403\u7684\u98db\u884c\u8ecc\u8de1\u548c\u843d\u9ede\u3002\u98a8\u5411\u548c\u98a8\u901f\u6703\u4ee5\u87a2\u5e55\u4e0a\u7684\u7bad\u982d\u548c\u6578\u5b57\u986f\u793a\u3002\u4f8b\u5982\uff0c\u5982\u679c\u98a8\u5411\u70ba\u5de6\u908a 10 \u82f1\u91cc/\u5c0f\u6642\uff0c\u5247\u60a8\u61c9\u8a72\u7a0d\u5fae\u5411\u53f3\u7784\u6e96\u4ee5\u62b5\u6d88\u98a8\u7684\u5f71\u97ff\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u6bd4\u8f03\u76f4\u63a5\u7784\u6e96\u76ee\u6a19\u8207\u8abf\u6574\u98a8\u5411\uff1b\u5f8c\u8005\u59cb\u7d42\u6703\u7522\u751f\u66f4\u597d\u7684\u7d50\u679c\u3002]"}, {"question": "\u9ad8\u723e\u592b\u8ecc\u8de1\u4e2d\u7684\u5fc5\u8981\u52a0\u5f37\u529f\u80fd\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5b83\u5011\u7684\u529f\u80fd\u5982\u4f55\uff1f", "answer": "\u9ad8\u723e\u592b\u8ecc\u8de1\u4e2d\u7684\u5fc5\u8981\u52a0\u5f37\u529f\u80fd\u5305\u62ec\u300c\u6e26\u8f2a\u589e\u58d3\u300d\u548c\u300c\u7cbe\u6e96\u7784\u6e96\u300d\u3002\u300c\u6e26\u8f2a\u589e\u58d3\u300d\u6703\u589e\u52a0\u7403\u901f\uff0c\u4f7f\u7403\u98db\u5f97\u66f4\u9060\uff0c\u800c\u300c\u7cbe\u6e96\u7784\u6e96\u300d\u5247\u6703\u7e2e\u5c0f\u98db\u884c\u8ecc\u8de1\uff0c\u8b93\u60a8\u7684\u64ca\u7403\u66f4\u6e96\u78ba\u3002\u4f8b\u5982\uff0c\u5728\u9577 5 \u687f\u6d1e\u4e2d\u4f7f\u7528\u300c\u6e26\u8f2a\u589e\u58d3\u300d\u53ef\u4ee5\u5e6b\u52a9\u60a8\u5728\u8f03\u5c11\u6746\u6578\u7684\u60c5\u6cc1\u4e0b\u5230\u9054\u679c\u5dba\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6e26\u8f2a\u589e\u58d3 - \u589e\u52a0\u901f\u5ea6\uff1b\u7cbe\u6e96\u7784\u6e96 - \u63d0\u5347\u6e96\u78ba\u5ea6\u3002]"}, {"question": "\u5728\u9ad8\u723e\u592b\u8ecc\u8de1\u4e2d\u904a\u6232\u6642\u9593\u8d85\u904e 100 \u5c0f\u6642\u7684\u73a9\u5bb6\uff0c\u53ef\u4ee5\u4f7f\u7528\u54ea\u4e9b\u5148\u9032\u7b56\u7565\u4f86\u964d\u4f4e\u5206\u6578\uff1f", "answer": "\u5728\u9ad8\u723e\u592b\u8ecc\u8de1\u4e2d\u904a\u6232\u6642\u9593\u8d85\u904e 100 \u5c0f\u6642\u7684\u73a9\u5bb6\u53ef\u4ee5\u4f7f\u7528\u5148\u9032\u7b56\u7565\uff0c\u4f8b\u5982\u300c\u7403\u5834\u7ba1\u7406\u300d\u548c\u300c\u98a8\u96aa\u8a55\u4f30\u300d\u3002\u6b65\u9a5f1 - \u5b78\u7fd2\u7403\u5834\u4f48\u5c40\uff0c\u8b58\u5225\u969c\u7919\u7269\u548c\u5b89\u5168\u5340\u57df\u3002\u6b65\u9a5f2 - \u8003\u616e\u98a8\u5411\u548c\u5730\u5f62\uff0c\u898f\u5283\u6bcf\u6b21\u64ca\u7403\u3002\u6b65\u9a5f3 - \u6c7a\u5b9a\u4f55\u6642\u5192\u96aa\uff0c\u4f8b\u5982\u5617\u8a66\u8d8a\u904e\u6c34\u969c\u7684\u9577\u64ca\u7403\uff0c\u9084\u662f\u8b39\u614e\u884c\u4e8b\u3002\u4f8b\u5982\uff0c\u5728 4 \u687f\u6d1e\u72f9\u7a84\u7684\u7403\u9053\u4e0a\uff0c\u4e0d\u5982\u5192\u96aa\u9577\u9a45\u76f4\u5165\u7c97\u8349\u5340\uff0c\u4e0d\u5982\u5148\u5b89\u5168\u5730\u5c07\u7403\u6253\u5230\u5b89\u5168\u5340\u57df\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u7403\u5834\u4f48\u5c40 -> \u8b58\u5225\u969c\u7919\u7269 -> \u898f\u5283\u64ca\u7403 -> \u57f7\u884c\u3002]"}, {"question": "\u9ad8\u723e\u592b\u8ecc\u8de1\u7684\u8a08\u5206\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff0c\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u8a08\u5206\uff1f", "answer": "\u9ad8\u723e\u592b\u8ecc\u8de1\u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u5b8c\u6210\u4e00\u500b\u6d1e\u6240\u9700\u7684\u6746\u6578\uff0c\u6a19\u6e96\u687f\u8868\u793a\u57fa\u6e96\u3002\u5f71\u97ff\u6210\u7e3e\u7684\u56e0\u7d20\u5305\u62ec\u6d1e\u7684\u9577\u5ea6\u3001\u969c\u7919\u7269\u548c\u98a8\u6cc1\u3002\u4f8b\u5982\uff0c\u6709\u5f37\u98a8\u7684 3 \u687f\u6d1e\u53ef\u80fd\u9700\u8981\u6bd4\u5e73\u5e38\u66f4\u591a\u7684\u6746\u6578\u4f86\u5b8c\u6210\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u6a19\u6e96\u687f\u60f3\u50cf\u6210\u57fa\u6e96\uff1b\u60a8\u4f7f\u7528\u7684\u6746\u6578\u8d8a\u5c11\uff0c\u60a8\u7684\u5f97\u5206\u8d8a\u597d\u3002]"}, {"question": "\u5728\u9ad8\u723e\u592b\u8ecc\u8de1\u4e2d\uff0c\u300e\u4e00\u687f\u9032\u6d1e\u300f\u6210\u5c31\u7684\u610f\u7fa9\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5982\u4f55\u6301\u7e8c\u9054\u6210\uff1f", "answer": "\u5728\u9ad8\u723e\u592b\u8ecc\u8de1\u904a\u6232\u4e2d\uff0c\u300e\u4e00\u687f\u9032\u6d1e\u300f\u6210\u5c31\u7684\u610f\u7fa9\u5728\u65bc\u5b83\u4ee3\u8868\u8457\u5b8c\u7f8e\u7684\u64ca\u7403\uff0c\u4e5f\u5c31\u662f\u5f9e\u767c\u7403\u53f0\u76f4\u63a5\u5c07\u7403\u64ca\u5165\u6d1e\u4e2d\u3002\u8981\u6301\u7e8c\u9054\u6210\u6b64\u6210\u5c31\uff0c\u8acb\u6309\u7167\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u4f7f\u7528\u300c\u7cbe\u6e96\u7784\u6e96\u300d\u4f86\u7e2e\u5c0f\u60a8\u7684\u98db\u884c\u8ecc\u8de1\u3002\u6b65\u9a5f2 - \u8abf\u6574\u98a8\u5411\u548c\u5730\u5f62\u3002\u6b65\u9a5f3 - \u5b8c\u7f8e\u63a7\u5236\u60a8\u7684\u6642\u6a5f\u548c\u529b\u91cf\u3002\u4f8b\u5982\uff0c\u5728\u98a8\u5c0f\u3001\u77ed\u7684 3 \u687f\u6d1e\u4e2d\uff0c\u4f7f\u7528\u300c\u7cbe\u6e96\u7784\u6e96\u300d\u7684\u7cbe\u6e96\u64ca\u7403\uff0c\u4fbf\u80fd\u9054\u6210\u300c\u4e00\u687f\u9032\u6d1e\u300d\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u6bd4\u8f03\u4f7f\u7528\u300c\u7cbe\u6e96\u7784\u6e96\u300d\u8207\u6a19\u6e96\u7784\u6e96\uff1b\u524d\u8005\u589e\u52a0\u300c\u4e00\u687f\u9032\u6d1e\u300d\u7684\u6a5f\u7387\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5229\u7528\u9ad8\u723e\u592b\u8ecc\u8de1\u7684\u904a\u6232\u7d71\u8a08\u6578\u64da\u5206\u6790\u548c\u512a\u5316\u4ed6\u5011\u7684\u8868\u73fe\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u900f\u904e\u6aa2\u8996\u904a\u6232\u7d71\u8a08\u6578\u64da\uff08\u4f8b\u5982\u300c\u6bcf\u6d1e\u5e73\u5747\u687f\u6578\u300d\u548c\u300c\u4e00\u687f\u9032\u6d1e\u767e\u5206\u6bd4\u300d\uff09\u4f86\u5206\u6790\u548c\u512a\u5316\u4ed6\u5011\u7684\u8868\u73fe\u3002\u6b65\u9a5f1 - \u5f9e\u4e3b\u87a2\u5e55\u5b58\u53d6\u7d71\u8a08\u6578\u64da\u83dc\u55ae\u3002\u6b65\u9a5f2 - \u8fa8\u8b58\u6a21\u5f0f\uff0c\u4f8b\u5982\u5728 5 \u687f\u6d1e\u4e2d\u6301\u7e8c\u9ad8\u687f\u6578\u3002\u6b65\u9a5f3 - \u5c08\u6ce8\u65bc\u6539\u5584\u5f31\u9805\uff0c\u4f8b\u5982\u7df4\u7fd2\u9577\u64ca\u6216\u63a8\u687f\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u7684\u300c\u6bcf\u6d1e\u5e73\u5747\u687f\u6578\u300d\u5728 5 \u687f\u6d1e\u8f03\u9ad8\uff0c\u5247\u82b1\u66f4\u591a\u6642\u9593\u7df4\u7fd2\u9577\u8ddd\u96e2\u64ca\u7403\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6bcf\u6d1e\u5e73\u5747\u687f\u6578 - \u8b58\u5225\u5f31\u9805\uff1b\u4e00\u687f\u9032\u6d1e\u767e\u5206\u6bd4 - \u8861\u91cf\u6e96\u78ba\u5ea6\u3002]"}, {"question": "\u624b\u6a5f\u7248\u548c\u96fb\u8166\u7248\u9ad8\u723e\u592b\u8ecc\u8de1\u7684\u95dc\u9375\u5dee\u7570\u70ba\u4f55\uff0c\u4ee5\u53ca\u9019\u5982\u4f55\u5f71\u97ff\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u624b\u6a5f\u7248\u548c\u96fb\u8166\u7248\u9ad8\u723e\u592b\u8ecc\u8de1\u7684\u4e3b\u8981\u5dee\u7570\u5728\u65bc\u63a7\u5236\u6a5f\u5236\u548c\u87a2\u5e55\u5927\u5c0f\u3002\u5728\u624b\u6a5f\u4e0a\uff0c\u73a9\u5bb6\u4f7f\u7528\u89f8\u63a7\u4f86\u8abf\u6574\u64ca\u7403\uff0c\u800c\u5728\u96fb\u8166\u4e0a\uff0c\u4ed6\u5011\u4f7f\u7528\u6ed1\u9f20\u3002\u96fb\u8166\u7684\u8f03\u5927\u87a2\u5e55\u63d0\u4f9b\u66f4\u8a73\u7d30\u7684\u7403\u5834\u8996\u5716\uff0c\u6709\u52a9\u65bc\u7cbe\u6e96\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u96fb\u8166\u4e0a\u5c0d\u6e96\u64ca\u7403\u53ef\u80fd\u6703\u66f4\u5bb9\u6613\uff0c\u56e0\u70ba\u98db\u884c\u8ecc\u8de1\u7684\u53ef\u898b\u6027\u5f97\u4ee5\u589e\u5f37\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u6bd4\u8f03\u624b\u6a5f\u7684\u89f8\u63a7\u63a7\u5236\u8207\u96fb\u8166\u7684\u6ed1\u9f20\u63a7\u5236\uff1b\u5f8c\u8005\u63d0\u4f9b\u4e86\u66f4\u9ad8\u7684\u7cbe\u78ba\u5ea6\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u89e3\u9396\u9ad8\u723e\u592b\u8ecc\u8de1\u4e2d\u7684\u96b1\u85cf\u7403\u5834\uff0c\u4ee5\u53ca\u5148\u6c7a\u689d\u4ef6\u70ba\u4f55\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u900f\u904e\u5b8c\u6210\u7279\u5b9a\u6210\u5c31\u6216\u9054\u5230\u67d0\u4e9b\u91cc\u7a0b\u7891\u4f86\u89e3\u9396\u9ad8\u723e\u592b\u8ecc\u8de1\u4e2d\u7684\u96b1\u85cf\u7403\u5834\u3002\u4f8b\u5982\uff0c\u5728\u9054\u6210 10 \u6b21\u300c\u4e00\u687f\u9032\u6d1e\u300d\u5f8c\uff0c\u6703\u89e3\u9396\u300c\u79d8\u5bc6\u679c\u5dba\u300d\u7403\u5834\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u5b8c\u6210\u6210\u5c31 -> \u9054\u5230\u91cc\u7a0b\u7891 -> \u89e3\u9396\u96b1\u85cf\u7403\u5834\u3002]"}, {"question": "\u5728\u9ad8\u723e\u592b\u8ecc\u8de1\u4e2d\u66f4\u63db\u88dd\u7f6e\u6642\uff0c\u8cc7\u6599\u9077\u79fb\u7684\u6700\u4f73\u4f5c\u6cd5\u70ba\u4f55\uff1f", "answer": "\u5728\u9ad8\u723e\u592b\u8ecc\u8de1\u4e2d\u9032\u884c\u8cc7\u6599\u9077\u79fb\u7684\u6700\u4f73\u4f5c\u6cd5\u5305\u62ec\u5c07\u60a8\u7684\u904a\u6232\u5e33\u6236\u9023\u7d50\u5230\u96f2\u7aef\u670d\u52d9\uff0c\u4f8b\u5982 Google Play \u6216 Apple Game Center\u3002\u6b65\u9a5f1 - \u78ba\u8a8d\u60a8\u76ee\u524d\u7684\u88dd\u7f6e\u5df2\u9023\u63a5\u5230\u96f2\u7aef\u670d\u52d9\u3002\u6b65\u9a5f2 - \u5c07\u60a8\u7684\u904a\u6232\u8cc7\u6599\u540c\u6b65\u5230\u96f2\u7aef\u3002\u6b65\u9a5f3 - \u5728\u65b0\u7684\u88dd\u7f6e\u4e0a\uff0c\u767b\u5165\u76f8\u540c\u7684\u96f2\u7aef\u670d\u52d9\u4ee5\u64f7\u53d6\u60a8\u7684\u8cc7\u6599\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9e Android \u624b\u6a5f\u8f49\u63db\u5230 iPhone\uff0c\u8acb\u5728\u8f49\u63db\u524d\u5c07\u60a8\u7684\u5e33\u6236\u9023\u7d50\u5230 Google Play\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1aAndroid - Google Play\uff1biPhone - Apple Game Center\u3002]"}]
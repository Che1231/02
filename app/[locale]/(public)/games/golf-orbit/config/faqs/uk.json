[{"question": "\u042f\u043a \u043d\u043e\u0432\u0430\u0447\u043e\u043a \u0443 Golf Orbit \u043c\u043e\u0436\u0435 \u043e\u043f\u0430\u043d\u0443\u0432\u0430\u0442\u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0456 \u043c\u0435\u0445\u0430\u043d\u0456\u043a\u0438 \u0440\u043e\u0437\u043c\u0430\u0445\u0443?", "answer": "\u0429\u043e\u0431 \u043e\u0432\u043e\u043b\u043e\u0434\u0456\u0442\u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c\u0438 \u043c\u0435\u0445\u0430\u043d\u0456\u043a\u0430\u043c\u0438 \u0440\u043e\u0437\u043c\u0430\u0445\u0443 \u0432 Golf Orbit, \u0432\u0438\u043a\u043e\u043d\u0430\u0439\u0442\u0435 \u0442\u0430\u043a\u0456 \u0434\u0456\u0457: \u041a\u0420\u041e\u041a 1 \u2013 \u0412\u0438\u0440\u0456\u0432\u043d\u044f\u0439\u0442\u0435 \u0441\u0432\u0456\u0439 \u0443\u0434\u0430\u0440, \u043f\u0435\u0440\u0435\u0442\u044f\u0433\u043d\u0443\u0432\u0448\u0438 \u043b\u0456\u043d\u0456\u044e \u0442\u0440\u0430\u0454\u043a\u0442\u043e\u0440\u0456\u0457 \u0432 \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e\u043c\u0443 \u043d\u0430\u043f\u0440\u044f\u043c\u043a\u0443. \u041a\u0420\u041e\u041a 2 \u2013 \u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0439\u0442\u0435 \u0432\u0438\u043c\u0456\u0440\u044e\u0432\u0430\u0447 \u043f\u043e\u0442\u0443\u0436\u043d\u043e\u0441\u0442\u0456, \u0442\u043e\u0440\u043a\u043d\u0443\u0432\u0448\u0438\u0441\u044c \u0442\u0430 \u0443\u0442\u0440\u0438\u043c\u0443\u044e\u0447\u0438 \u0435\u043a\u0440\u0430\u043d, \u0430 \u043f\u043e\u0442\u0456\u043c \u0432\u0456\u0434\u043f\u0443\u0441\u0442\u0456\u0442\u044c, \u0449\u043e\u0431 \u0440\u043e\u0437\u043c\u0430\u0445\u043d\u0443\u0442\u0438\u0441\u044f. \u041a\u0420\u041e\u041a 3 \u2013 \u0422\u043e\u0447\u043d\u043e \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0439\u0442\u0435 \u0441\u0432\u0456\u0439 \u0443\u0434\u0430\u0440, \u0432\u0440\u0430\u0445\u043e\u0432\u0443\u044e\u0447\u0438 \u043d\u0430\u043f\u0440\u044f\u043c\u043e\u043a \u0442\u0430 \u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c \u0432\u0456\u0442\u0440\u0443, \u0449\u043e \u0432\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0430\u044e\u0442\u044c\u0441\u044f \u0441\u0442\u0440\u0456\u043b\u043a\u043e\u044e \u0442\u0430 \u0447\u0438\u0441\u043b\u043e\u043c \u043d\u0430 \u0435\u043a\u0440\u0430\u043d\u0456. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u044f\u043a\u0449\u043e \u0432\u0456\u0442\u0435\u0440 \u0434\u043c\u0435 \u0437\u0456 \u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044e 5 \u043c\u0438\u043b\u044c \u043d\u0430 \u0433\u043e\u0434\u0438\u043d\u0443 \u043f\u0440\u0430\u0432\u043e\u0440\u0443\u0447, \u0441\u043f\u0440\u044f\u043c\u0443\u0439\u0442\u0435 \u043c'\u044f\u0447 \u0442\u0440\u043e\u0445\u0438 \u043b\u0456\u0432\u043e\u0440\u0443\u0447, \u0449\u043e\u0431 \u043a\u043e\u043c\u043f\u0435\u043d\u0441\u0443\u0432\u0430\u0442\u0438. [\u0406\u043b\u044e\u0441\u0442\u0440\u0430\u0446\u0456\u044f: \u0423\u044f\u0432\u0456\u0442\u044c \u0432\u0438\u043c\u0456\u0440\u044e\u0432\u0430\u0447 \u043f\u043e\u0442\u0443\u0436\u043d\u043e\u0441\u0442\u0456 \u044f\u043a \u043b\u0443\u043a \u0456 \u0441\u0442\u0440\u0456\u043b\u0443; \u0447\u0438\u043c \u0434\u043e\u0432\u0448\u0435 \u0432\u0438 \u0442\u0440\u0438\u043c\u0430\u0454\u0442\u0435, \u0442\u0438\u043c \u0434\u0430\u043b\u0456 \u043c'\u044f\u0447.]"}, {"question": "\u0427\u043e\u043c\u0443 \u0440\u043e\u0437\u0443\u043c\u0456\u043d\u043d\u044f \u0444\u0430\u043a\u0442\u043e\u0440\u0443 \u0432\u0456\u0442\u0440\u0443 \u0432 Golf Orbit \u0437\u043d\u0430\u0447\u043d\u043e \u043f\u043e\u043a\u0440\u0430\u0449\u0443\u0454 \u0433\u0440\u0443?", "answer": "\u0420\u043e\u0437\u0443\u043c\u0456\u043d\u043d\u044f \u0444\u0430\u043a\u0442\u043e\u0440\u0443 \u0432\u0456\u0442\u0440\u0443 \u0432 Golf Orbit \u0454 \u0432\u0430\u0436\u043b\u0438\u0432\u0438\u043c, \u043e\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u0432\u0456\u043d \u0431\u0435\u0437\u043f\u043e\u0441\u0435\u0440\u0435\u0434\u043d\u044c\u043e \u0432\u043f\u043b\u0438\u0432\u0430\u0454 \u043d\u0430 \u0442\u0440\u0430\u0454\u043a\u0442\u043e\u0440\u0456\u044e \u0442\u0430 \u043c\u0456\u0441\u0446\u0435 \u043f\u0440\u0438\u0437\u0435\u043c\u043b\u0435\u043d\u043d\u044f \u043c'\u044f\u0447\u0430. \u041d\u0430\u043f\u0440\u044f\u043c\u043e\u043a \u0442\u0430 \u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c \u0432\u0456\u0442\u0440\u0443 \u0432\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0430\u044e\u0442\u044c\u0441\u044f \u044f\u043a \u0441\u0442\u0440\u0456\u043b\u043a\u0430 \u0442\u0430 \u0447\u0438\u0441\u043b\u043e \u043d\u0430 \u0435\u043a\u0440\u0430\u043d\u0456. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u044f\u043a\u0449\u043e \u0432\u0456\u0442\u0435\u0440 \u0434\u043c\u0435 \u0437\u0456 \u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044e 10 \u043c\u0438\u043b\u044c \u043d\u0430 \u0433\u043e\u0434\u0438\u043d\u0443 \u043b\u0456\u0432\u043e\u0440\u0443\u0447, \u0432\u0438 \u043f\u043e\u0432\u0438\u043d\u043d\u0456 \u0441\u043f\u0440\u044f\u043c\u0443\u0432\u0430\u0442\u0438 \u043c'\u044f\u0447 \u0442\u0440\u043e\u0445\u0438 \u043f\u0440\u0430\u0432\u043e\u0440\u0443\u0447, \u0449\u043e\u0431 \u043f\u0440\u043e\u0442\u0438\u0441\u0442\u043e\u044f\u0442\u0438 \u0432\u043f\u043b\u0438\u0432\u0443 \u0432\u0456\u0442\u0440\u0443. [\u041f\u043e\u0440\u0456\u0432\u043d\u044f\u043d\u043d\u044f \u0440\u0456\u0437\u043d\u0438\u0445 \u0432\u0430\u0440\u0456\u0430\u043d\u0442\u0456\u0432: \u041f\u043e\u0440\u0456\u0432\u043d\u044f\u0439\u0442\u0435 \u043f\u0440\u0438\u0446\u0456\u043b\u044e\u0432\u0430\u043d\u043d\u044f \u0431\u0435\u0437\u043f\u043e\u0441\u0435\u0440\u0435\u0434\u043d\u044c\u043e \u0432 \u0446\u0456\u043b\u044c \u043f\u0440\u043e\u0442\u0438 \u043a\u043e\u0440\u0438\u0433\u0443\u0432\u0430\u043d\u043d\u044f \u0434\u043b\u044f \u0443\u0440\u0430\u0445\u0443\u0432\u0430\u043d\u043d\u044f \u0432\u0456\u0442\u0440\u0443; \u043e\u0441\u0442\u0430\u043d\u043d\u0454 \u043f\u043e\u0441\u0442\u0456\u0439\u043d\u043e \u0434\u0430\u0454 \u043a\u0440\u0430\u0449\u0456 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0438.]"}, {"question": "\u042f\u043a\u0456 \u043e\u0441\u043d\u043e\u0432\u043d\u0456 \u0431\u043e\u043d\u0443\u0441\u0438 \u0432 Golf Orbit \u0456 \u044f\u043a \u0432\u043e\u043d\u0438 \u0444\u0443\u043d\u043a\u0446\u0456\u043e\u043d\u0443\u044e\u0442\u044c?", "answer": "\u041e\u0441\u043d\u043e\u0432\u043d\u0456 \u0431\u043e\u043d\u0443\u0441\u0438 \u0432 Golf Orbit \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442\u044c \u00ab\u0422\u0443\u0440\u0431\u043e\u043f\u0440\u0438\u0441\u043a\u043e\u0440\u0435\u043d\u043d\u044f\u00bb \u0442\u0430 \u00ab\u0422\u043e\u0447\u043d\u0435 \u043f\u0440\u0438\u0446\u0456\u043b\u044e\u0432\u0430\u043d\u043d\u044f\u00bb. \u00ab\u0422\u0443\u0440\u0431\u043e\u043f\u0440\u0438\u0441\u043a\u043e\u0440\u0435\u043d\u043d\u044f\u00bb \u0437\u0431\u0456\u043b\u044c\u0448\u0443\u0454 \u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c \u043c'\u044f\u0447\u0430, \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0447\u0438 \u0439\u043e\u043c\u0443 \u043f\u0440\u043e\u043b\u0435\u0442\u0456\u0442\u0438 \u0434\u0430\u043b\u0456, \u0442\u043e\u0434\u0456 \u044f\u043a \u00ab\u0422\u043e\u0447\u043d\u0435 \u043f\u0440\u0438\u0446\u0456\u043b\u044e\u0432\u0430\u043d\u043d\u044f\u00bb \u0437\u0432\u0443\u0436\u0443\u0454 \u043b\u0456\u043d\u0456\u044e \u0442\u0440\u0430\u0454\u043a\u0442\u043e\u0440\u0456\u0457 \u0434\u043b\u044f \u0431\u0456\u043b\u044c\u0448 \u0442\u043e\u0447\u043d\u0438\u0445 \u0443\u0434\u0430\u0440\u0456\u0432. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u00ab\u0422\u0443\u0440\u0431\u043e\u043f\u0440\u0438\u0441\u043a\u043e\u0440\u0435\u043d\u043d\u044f\u00bb \u043d\u0430 \u0434\u043e\u0432\u0433\u0456\u0439 \u0434\u0456\u043b\u044f\u043d\u0446\u0456 \u043f\u0430\u0440-5 \u043c\u043e\u0436\u0435 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0442\u0438 \u0432\u0430\u043c \u043f\u043e\u0442\u0440\u0430\u043f\u0438\u0442\u0438 \u043d\u0430 \u0433\u0440\u0456\u043d \u0437\u0430 \u043c\u0435\u043d\u0448\u0443 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u0443\u0434\u0430\u0440\u0456\u0432. [\u0422\u0430\u0431\u043b\u0438\u0446\u044f \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c: \u0422\u0443\u0440\u0431\u043e\u043f\u0440\u0438\u0441\u043a\u043e\u0440\u0435\u043d\u043d\u044f \u2013 \u0437\u0431\u0456\u043b\u044c\u0448\u0443\u0454 \u0448\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c; \u0422\u043e\u0447\u043d\u0435 \u043f\u0440\u0438\u0446\u0456\u043b\u044e\u0432\u0430\u043d\u043d\u044f \u2013 \u043f\u043e\u043a\u0440\u0430\u0449\u0443\u0454 \u0442\u043e\u0447\u043d\u0456\u0441\u0442\u044c.]"}, {"question": "\u042f\u043a\u0456 \u0440\u043e\u0437\u0448\u0438\u0440\u0435\u043d\u0456 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0457 \u043c\u043e\u0436\u0443\u0442\u044c \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0433\u0440\u0430\u0432\u0446\u0456 \u0437 \u043f\u043e\u043d\u0430\u0434 100 \u0433\u043e\u0434\u0438\u043d \u0433\u0440\u0438 \u0432 Golf Orbit, \u0449\u043e\u0431 \u0437\u043d\u0438\u0437\u0438\u0442\u0438 \u0441\u0432\u043e\u0457 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0438?", "answer": "\u0413\u0440\u0430\u0432\u0446\u0456 \u0437 \u043f\u043e\u043d\u0430\u0434 100 \u0433\u043e\u0434\u0438\u043d\u0430\u043c\u0438 \u0433\u0440\u0438 \u0432 Golf Orbit \u043c\u043e\u0436\u0443\u0442\u044c \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0440\u043e\u0437\u0448\u0438\u0440\u0435\u043d\u0456 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0457, \u0442\u0430\u043a\u0456 \u044f\u043a \u00ab\u0423\u043f\u0440\u0430\u0432\u043b\u0456\u043d\u043d\u044f \u043f\u043e\u043b\u0435\u043c\u00bb \u0442\u0430 \u00ab\u041e\u0446\u0456\u043d\u043a\u0430 \u0440\u0438\u0437\u0438\u043a\u0456\u0432\u00bb. \u041a\u0420\u041e\u041a 1 \u2013 \u0412\u0438\u0432\u0447\u0456\u0442\u044c \u043c\u0430\u043a\u0435\u0442 \u043f\u043e\u043b\u044f, \u0449\u043e\u0431 \u0432\u0438\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u043d\u0435\u0431\u0435\u0437\u043f\u0435\u043a\u0438 \u0442\u0430 \u0431\u0435\u0437\u043f\u0435\u0447\u043d\u0456 \u0437\u043e\u043d\u0438. \u041a\u0420\u041e\u041a 2 \u2013 \u041f\u043b\u0430\u043d\u0443\u0439\u0442\u0435 \u043a\u043e\u0436\u0435\u043d \u0443\u0434\u0430\u0440, \u0432\u0440\u0430\u0445\u043e\u0432\u0443\u044e\u0447\u0438 \u0432\u0456\u0442\u0435\u0440 \u0442\u0430 \u0440\u0435\u043b\u044c\u0454\u0444 \u043c\u0456\u0441\u0446\u0435\u0432\u043e\u0441\u0442\u0456. \u041a\u0420\u041e\u041a 3 \u2013 \u0412\u0438\u0440\u0456\u0448\u0456\u0442\u044c, \u043a\u043e\u043b\u0438 \u043f\u0440\u0438\u0439\u043c\u0430\u0442\u0438 \u0440\u0438\u0437\u0438\u043a\u0438, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043d\u0430\u043c\u0430\u0433\u0430\u0442\u0438\u0441\u044f \u0437\u0440\u043e\u0431\u0438\u0442\u0438 \u0434\u043e\u0432\u0433\u0438\u0439 \u0443\u0434\u0430\u0440 \u0447\u0435\u0440\u0435\u0437 \u0432\u043e\u0434\u0443, \u043f\u043e\u0440\u0456\u0432\u043d\u044f\u043d\u043e \u0437 \u0431\u0456\u043b\u044c\u0448 \u043e\u0431\u0435\u0440\u0435\u0436\u043d\u0438\u043c\u0438 \u0440\u0456\u0448\u0435\u043d\u043d\u044f\u043c\u0438. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043d\u0430 \u043f\u0430\u0440-4 \u0437 \u0432\u0443\u0437\u044c\u043a\u043e\u044e \u043c\u0430\u0439\u0434\u0430\u043d\u0447\u0438\u043a\u043e\u043c, \u043c\u043e\u0436\u043b\u0438\u0432\u043e, \u0431\u0443\u0434\u0435 \u0440\u043e\u0437\u0443\u043c\u043d\u0456\u0448\u0435 \u043f\u0456\u0434\u0456\u0439\u0442\u0438 \u0431\u043b\u0438\u0436\u0447\u0435, \u043d\u0456\u0436 \u0440\u0438\u0437\u0438\u043a\u0443\u0432\u0430\u0442\u0438 \u0434\u043e\u0432\u0433\u0438\u043c \u0443\u0434\u0430\u0440\u043e\u043c, \u044f\u043a\u0438\u0439 \u043c\u043e\u0436\u0435 \u0437\u0430\u043b\u0435\u0442\u0456\u0442\u0438 \u0432 \u043d\u0435\u043f\u0440\u043e\u0445\u0456\u0434\u043d\u0443 \u043c\u0456\u0441\u0446\u0435\u0432\u0456\u0441\u0442\u044c. [\u0421\u0445\u0435\u043c\u0430 \u043f\u0440\u043e\u0446\u0435\u0441\u0443: \u041c\u0430\u043a\u0435\u0442 \u043f\u043e\u043b\u044f -> \u0412\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u043d\u0435\u0431\u0435\u0437\u043f\u0435\u043a -> \u041f\u043b\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u0443\u0434\u0430\u0440\u0456\u0432 -> \u0412\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f.]"}, {"question": "\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u043f\u0456\u0434\u0440\u0430\u0445\u0443\u043d\u043a\u0443 \u043e\u0447\u043e\u043a \u0443 Golf Orbit, \u0456 \u044f\u043a\u0456 \u0444\u0430\u043a\u0442\u043e\u0440\u0438 \u043d\u0430 \u043d\u0435\u0457 \u0432\u043f\u043b\u0438\u0432\u0430\u044e\u0442\u044c?", "answer": "\u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u043f\u0456\u0434\u0440\u0430\u0445\u0443\u043d\u043a\u0443 \u043e\u0447\u043e\u043a \u0443 Golf Orbit \u0431\u0430\u0437\u0443\u0454\u0442\u044c\u0441\u044f \u043d\u0430 \u043a\u0456\u043b\u044c\u043a\u043e\u0441\u0442\u0456 \u0443\u0434\u0430\u0440\u0456\u0432, \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u0438\u0445 \u0434\u043b\u044f \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u044f \u043b\u0443\u043d\u043a\u0438, \u043f\u0430\u0440 \u2013 \u0446\u0435 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442. \u0424\u0430\u043a\u0442\u043e\u0440\u0438, \u0449\u043e \u0432\u043f\u043b\u0438\u0432\u0430\u044e\u0442\u044c \u043d\u0430 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442, \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442\u044c \u0434\u043e\u0432\u0436\u0438\u043d\u0443 \u043b\u0443\u043d\u043a\u0438, \u043f\u0435\u0440\u0435\u0448\u043a\u043e\u0434\u0438 \u0442\u0430 \u0443\u043c\u043e\u0432\u0438 \u0432\u0456\u0442\u0440\u0443. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043b\u0443\u043d\u043a\u0430 \u043f\u0430\u0440-3 \u0437 \u0441\u0438\u043b\u044c\u043d\u0438\u043c \u0432\u0456\u0442\u0440\u043e\u043c \u043c\u043e\u0436\u0435 \u0432\u0438\u043c\u0430\u0433\u0430\u0442\u0438 \u0431\u0456\u043b\u044c\u0448\u0435 \u0443\u0434\u0430\u0440\u0456\u0432, \u043d\u0456\u0436 \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439. [\u0406\u043b\u044e\u0441\u0442\u0440\u0430\u0446\u0456\u044f: \u0423\u044f\u0432\u0456\u0442\u044c \u043f\u0430\u0440 \u044f\u043a \u0435\u0442\u0430\u043b\u043e\u043d; \u0447\u0438\u043c \u043c\u0435\u043d\u0448\u0435 \u0443\u0434\u0430\u0440\u0456\u0432 \u0432\u0438 \u0440\u043e\u0431\u0438\u0442\u0435, \u0442\u0438\u043c \u043a\u0440\u0430\u0449\u0435 \u0432\u0430\u0448 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442.]"}, {"question": "\u042f\u043a\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u00ab\u0415\u043b\u044c\u0444\u0456\u0439\u0441\u044c\u043a\u043e\u0433\u043e \u0443\u0434\u0430\u0440\u0443\u00bb \u0432 Golf Orbit, \u0456 \u044f\u043a \u0439\u043e\u0433\u043e \u043c\u043e\u0436\u043d\u0430 \u043f\u043e\u0441\u043b\u0456\u0434\u043e\u0432\u043d\u043e \u0434\u043e\u0441\u044f\u0433\u0430\u0442\u0438?", "answer": "\u0414\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u00ab\u0415\u043b\u044c\u0444\u0456\u0439\u0441\u044c\u043a\u043e\u0433\u043e \u0443\u0434\u0430\u0440\u0443\u00bb \u0432 Golf Orbit \u0454 \u0437\u043d\u0430\u0447\u043d\u0438\u043c, \u043e\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u0432\u043e\u043d\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0454 \u0456\u0434\u0435\u0430\u043b\u044c\u043d\u0438\u0439 \u0443\u0434\u0430\u0440, \u044f\u043a\u0438\u0439 \u0431\u0435\u0437\u043f\u043e\u0441\u0435\u0440\u0435\u0434\u043d\u044c\u043e \u043f\u043e\u0442\u0440\u0430\u043f\u043b\u044f\u0454 \u0432 \u043b\u0443\u043d\u043a\u0443 \u0437 \u0442\u0438, \u043d\u0430\u043f\u0440\u044f\u043c\u043a\u0443. \u0429\u043e\u0431 \u043f\u043e\u0441\u043b\u0456\u0434\u043e\u0432\u043d\u043e \u0434\u043e\u0441\u044f\u0433\u0430\u0442\u0438 \u0446\u044c\u043e\u0433\u043e, \u041a\u0420\u041e\u041a 1 \u2013 \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u00ab\u0442\u043e\u0447\u043d\u0435 \u043f\u0440\u0438\u0446\u0456\u043b\u044e\u0432\u0430\u043d\u043d\u044f\u00bb, \u0449\u043e\u0431 \u0437\u0432\u0443\u0437\u0438\u0442\u0438 \u0442\u0440\u0430\u0454\u043a\u0442\u043e\u0440\u0456\u044e. \u041a\u0420\u041e\u041a 2 \u2013 \u0417\u0440\u043e\u0431\u0456\u0442\u044c \u043f\u043e\u043f\u0440\u0430\u0432\u043a\u0438 \u043d\u0430 \u0432\u0456\u0442\u0435\u0440 \u0456 \u043c\u0456\u0441\u0446\u0435\u0432\u0456\u0441\u0442\u044c. \u041a\u0420\u041e\u041a 3 \u2013 \u0414\u043e\u0441\u043a\u043e\u043d\u0430\u043b\u0456\u0442\u044c \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0447\u0430\u0441\u0443 \u0442\u0430 \u043f\u043e\u0442\u0443\u0436\u043d\u043e\u0441\u0442\u0456. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043a\u043e\u0440\u043e\u0442\u043a\u0456\u0439 \u043b\u0443\u043d\u0446\u0456 \u043f\u0430\u0440-3 \u0437 \u043c\u0456\u043d\u0456\u043c\u0430\u043b\u044c\u043d\u0438\u043c \u0432\u0456\u0442\u0440\u043e\u043c, \u0434\u043e\u0431\u0440\u0435 \u0440\u043e\u0437\u0440\u0430\u0445\u043e\u0432\u0430\u043d\u0438\u0439 \u0443\u0434\u0430\u0440 \u0437 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f\u043c \u00ab\u0442\u043e\u0447\u043d\u0438\u0445 \u043f\u0440\u0438\u0446\u0456\u043b\u044e\u0432\u0430\u043d\u043d\u044f\u00bb \u043c\u043e\u0436\u0435 \u043f\u0440\u0438\u0437\u0432\u0435\u0441\u0442\u0438 \u0434\u043e \u00ab\u0415\u043b\u044c\u0444\u0456\u0439\u0441\u044c\u043a\u043e\u0433\u043e \u0443\u0434\u0430\u0440\u0443\u00bb. [\u041f\u043e\u0440\u0456\u0432\u043d\u044f\u043d\u043d\u044f \u0440\u0456\u0437\u043d\u0438\u0445 \u0432\u0430\u0440\u0456\u0430\u043d\u0442\u0456\u0432: \u041f\u043e\u0440\u0456\u0432\u043d\u044f\u0439\u0442\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u00ab\u0442\u043e\u0447\u043d\u0438\u0445 \u043f\u0440\u0438\u0446\u0456\u043b\u044e\u0432\u0430\u043d\u043d\u044f\u00bb \u043f\u0440\u043e\u0442\u0438 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u0446\u0456\u043b\u044e\u0432\u0430\u043d\u043d\u044f; \u043f\u0435\u0440\u0448\u0438\u0439 \u0437\u0431\u0456\u043b\u044c\u0448\u0443\u0454 \u0439\u043c\u043e\u0432\u0456\u0440\u043d\u0456\u0441\u0442\u044c \u00ab\u0415\u043b\u044c\u0444\u0456\u0439\u0441\u044c\u043a\u043e\u0433\u043e \u0443\u0434\u0430\u0440\u0443\u00bb.]"}, {"question": "\u042f\u043a \u0433\u0440\u0430\u0432\u0446\u0456 \u043c\u043e\u0436\u0443\u0442\u044c \u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0442\u0430 \u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0441\u0432\u043e\u044e \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c, \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u044e\u0447\u0438 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443 \u0433\u0440\u0438 \u0432 Golf Orbit?", "answer": "\u0413\u0440\u0430\u0432\u0446\u0456 \u043c\u043e\u0436\u0443\u0442\u044c \u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0442\u0430 \u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0441\u0432\u043e\u044e \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c \u0443 Golf Orbit, \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434\u0430\u044e\u0447\u0438 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443 \u0433\u0440\u0438, \u0442\u0430\u043a\u0443 \u044f\u043a \u00ab\u0421\u0435\u0440\u0435\u0434\u043d\u0456 \u0443\u0434\u0430\u0440\u0438 \u043d\u0430 \u043b\u0443\u043d\u043a\u0443\u00bb \u0442\u0430 \u00ab\u0412\u0456\u0434\u0441\u043e\u0442\u043e\u043a \u00ab\u0415\u043b\u044c\u0444\u0456\u0439\u0441\u044c\u043a\u0438\u0445 \u0443\u0434\u0430\u0440\u0456\u0432\u00bb. \u041a\u0420\u041e\u041a 1 \u2013 \u0412\u0456\u0434\u043a\u0440\u0438\u0439\u0442\u0435 \u043c\u0435\u043d\u044e \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0438 \u0437 \u0433\u043e\u043b\u043e\u0432\u043d\u043e\u0433\u043e \u0435\u043a\u0440\u0430\u043d\u0443. \u041a\u0420\u041e\u041a 2 \u2013 \u0412\u0438\u0437\u043d\u0430\u0447\u0442\u0435 \u0437\u0430\u043a\u043e\u043d\u043e\u043c\u0456\u0440\u043d\u043e\u0441\u0442\u0456, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043f\u043e\u0441\u0442\u0456\u0439\u043d\u043e \u0432\u0438\u0441\u043e\u043a\u0456 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0438 \u043d\u0430 \u043b\u0443\u043d\u043a\u0430\u0445 \u043f\u0430\u0440-5. \u041a\u0420\u041e\u041a 3 \u2013 \u0417\u043e\u0441\u0435\u0440\u0435\u0434\u044c\u0442\u0435\u0441\u044f \u043d\u0430 \u043f\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u043d\u0456 \u0441\u043b\u0430\u0431\u043a\u0438\u0445 \u043c\u0456\u0441\u0446\u044c, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0443\u0439\u0442\u0435 \u0434\u0430\u043b\u044c\u043d\u0456 \u0443\u0434\u0430\u0440\u0438 \u0430\u0431\u043e \u00ab\u043f\u0456\u0434\u043a\u0440\u0430\u0449\u0443\u0432\u0430\u043d\u043d\u044f\u00bb. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u044f\u043a\u0449\u043e \u0432\u0430\u0448 \u00ab\u0421\u0435\u0440\u0435\u0434\u043d\u0438\u0439 \u043f\u043e\u043a\u0430\u0437\u043d\u0438\u043a \u0443\u0434\u0430\u0440\u0456\u0432 \u043d\u0430 \u043b\u0443\u043d\u043a\u0443\u00bb \u0432\u0438\u0441\u043e\u043a\u0438\u0439 \u043d\u0430 \u043f\u0430\u0440-5, \u0432\u0438\u0442\u0440\u0430\u0442\u044c\u0442\u0435 \u0431\u0456\u043b\u044c\u0448\u0435 \u0447\u0430\u0441\u0443 \u043d\u0430 \u0442\u0440\u0435\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u0434\u0430\u043b\u044c\u043d\u0456\u0445 \u0443\u0434\u0430\u0440\u0456\u0432. [\u0422\u0430\u0431\u043b\u0438\u0446\u044f \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c: \u0421\u0435\u0440\u0435\u0434\u043d\u0456 \u0443\u0434\u0430\u0440\u0438 \u043d\u0430 \u043b\u0443\u043d\u043a\u0443 \u2013 \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u0454 \u0441\u043b\u0430\u0431\u043a\u0456 \u043c\u0456\u0441\u0446\u044f; \u0412\u0456\u0434\u0441\u043e\u0442\u043e\u043a \u0415\u043b\u044c\u0444\u0456\u0439\u0441\u044c\u043a\u0438\u0445 \u0443\u0434\u0430\u0440\u0456\u0432 \u2013 \u0432\u0438\u043c\u0456\u0440\u044e\u0454 \u0442\u043e\u0447\u043d\u0456\u0441\u0442\u044c.]"}, {"question": "\u0423 \u0447\u043e\u043c\u0443 \u043a\u043b\u044e\u0447\u043e\u0432\u0456 \u0432\u0456\u0434\u043c\u0456\u043d\u043d\u043e\u0441\u0442\u0456 \u043c\u0456\u0436 \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0438\u043c\u0438 \u0442\u0430 \u041f\u041a-\u0432\u0435\u0440\u0441\u0456\u044f\u043c\u0438 Golf Orbit, \u0456 \u044f\u043a \u0446\u0435 \u0432\u043f\u043b\u0438\u0432\u0430\u0454 \u043d\u0430 \u0433\u0435\u0439\u043c\u043f\u043b\u0435\u0439?", "answer": "\u041a\u043b\u044e\u0447\u043e\u0432\u0456 \u0432\u0456\u0434\u043c\u0456\u043d\u043d\u043e\u0441\u0442\u0456 \u043c\u0456\u0436 \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u0438\u043c\u0438 \u0442\u0430 \u041f\u041a-\u0432\u0435\u0440\u0441\u0456\u044f\u043c\u0438 Golf Orbit \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442\u044c \u043c\u0435\u0445\u0430\u043d\u0456\u0437\u043c\u0438 \u0443\u043f\u0440\u0430\u0432\u043b\u0456\u043d\u043d\u044f \u0442\u0430 \u0440\u043e\u0437\u043c\u0456\u0440 \u0435\u043a\u0440\u0430\u043d\u0443. \u041d\u0430 \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u043e\u043c\u0443 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0456 \u0433\u0440\u0430\u0432\u0446\u0456 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u044e\u0442\u044c \u0441\u0435\u043d\u0441\u043e\u0440\u043d\u0456 \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0438 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0434\u043b\u044f \u0440\u0435\u0433\u0443\u043b\u044e\u0432\u0430\u043d\u043d\u044f \u0443\u0434\u0430\u0440\u0456\u0432, \u0442\u043e\u0434\u0456 \u044f\u043a \u043d\u0430 \u041f\u041a \u0432\u043e\u043d\u0438 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u044e\u0442\u044c \u043c\u0438\u0448\u043a\u0443. \u0411\u0456\u043b\u044c\u0448\u0438\u0439 \u0435\u043a\u0440\u0430\u043d \u043d\u0430 \u041f\u041a \u0434\u0430\u0454 \u0431\u0456\u043b\u044c\u0448 \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u0438\u0439 \u043e\u0433\u043b\u044f\u0434 \u043f\u043e\u043b\u044f, \u0449\u043e \u0441\u043f\u0440\u0438\u044f\u0454 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0456. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0432\u0438\u0440\u0456\u0432\u043d\u044e\u0432\u0430\u043d\u043d\u044f \u0443\u0434\u0430\u0440\u0443 \u043d\u0430 \u041f\u041a \u043c\u043e\u0436\u0435 \u0431\u0443\u0442\u0438 \u043f\u0440\u043e\u0441\u0442\u0456\u0448\u0438\u043c \u0437\u0430\u0432\u0434\u044f\u043a\u0438 \u043f\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0456\u0439 \u0432\u0438\u0434\u0438\u043c\u043e\u0441\u0442\u0456 \u043b\u0456\u043d\u0456\u0457 \u0442\u0440\u0430\u0454\u043a\u0442\u043e\u0440\u0456\u0457. [\u041f\u043e\u0440\u0456\u0432\u043d\u044f\u043d\u043d\u044f \u0440\u0456\u0437\u043d\u0438\u0445 \u0432\u0430\u0440\u0456\u0430\u043d\u0442\u0456\u0432: \u041f\u043e\u0440\u0456\u0432\u043d\u044f\u0439\u0442\u0435 \u0441\u0435\u043d\u0441\u043e\u0440\u043d\u0456 \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0438 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u043c\u043e\u0431\u0456\u043b\u044c\u043d\u043e\u043c\u0443 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0456 \u0456 \u043c\u0438\u0448\u0443 \u043d\u0430 \u041f\u041a; \u043e\u0441\u0442\u0430\u043d\u043d\u044f \u043f\u0440\u043e\u043f\u043e\u043d\u0443\u0454 \u0431\u0456\u043b\u044c\u0448\u0443 \u0442\u043e\u0447\u043d\u0456\u0441\u0442\u044c.]"}, {"question": "\u042f\u043a \u0433\u0440\u0430\u0432\u0446\u0456 \u043c\u043e\u0436\u0443\u0442\u044c \u0440\u043e\u0437\u0431\u043b\u043e\u043a\u0443\u0432\u0430\u0442\u0438 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 \u043f\u043e\u043b\u044f \u0432 Golf Orbit, \u0456 \u044f\u043a\u0456 \u043f\u0435\u0440\u0435\u0434\u0443\u043c\u043e\u0432\u0438 \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u0456?", "answer": "\u0413\u0440\u0430\u0432\u0446\u0456 \u043c\u043e\u0436\u0443\u0442\u044c \u0440\u043e\u0437\u0431\u043b\u043e\u043a\u0443\u0432\u0430\u0442\u0438 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 \u043f\u043e\u043b\u044f \u0432 Golf Orbit, \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0432\u0448\u0438 \u043f\u0435\u0432\u043d\u0456 \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u0430\u0431\u043e \u0434\u043e\u0441\u044f\u0433\u043d\u0443\u0432\u0448\u0438 \u043f\u0435\u0432\u043d\u0438\u0445 \u0435\u0442\u0430\u043f\u0456\u0432. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043f\u043e\u043b\u0435 \u00ab\u0421\u0435\u043a\u0440\u0435\u0442\u043d\u0456 \u0433\u0440\u0456\u043d\u00bb \u0440\u043e\u0437\u0431\u043b\u043e\u043a\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f \u043f\u0456\u0441\u043b\u044f \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f 10 \u00ab\u0415\u043b\u044c\u0444\u0456\u0439\u0441\u044c\u043a\u0438\u0445 \u0443\u0434\u0430\u0440\u0456\u0432\u00bb. [\u0421\u0445\u0435\u043c\u0430 \u043f\u0440\u043e\u0446\u0435\u0441\u0443: \u0417\u0430\u0432\u0434\u0430\u043d\u043d\u044f -> \u0414\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u0435\u0442\u0430\u043f\u0456\u0432 -> \u0420\u043e\u0437\u0431\u043b\u043e\u043a\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0438\u0445 \u043f\u043e\u043b\u0456\u0432.]"}, {"question": "\u042f\u043a\u0456 \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0456 \u043c\u0435\u0442\u043e\u0434\u0438 \u043c\u0456\u0433\u0440\u0430\u0446\u0456\u0457 \u0434\u0430\u043d\u0438\u0445 \u043f\u0440\u0438 \u0437\u043c\u0456\u043d\u0456 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u0457\u0432 \u0432 Golf Orbit?", "answer": "\u041d\u0430\u0439\u043a\u0440\u0430\u0449\u0456 \u043c\u0435\u0442\u043e\u0434\u0438 \u043c\u0456\u0433\u0440\u0430\u0446\u0456\u0457 \u0434\u0430\u043d\u0438\u0445 \u0432 Golf Orbit \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442\u044c \u0437\u0432'\u044f\u0437\u0443\u0432\u0430\u043d\u043d\u044f \u0432\u0430\u0448\u043e\u0433\u043e \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u043e\u0433\u043e \u0437\u0430\u043f\u0438\u0441\u0443 \u0433\u0440\u0438 \u0437 \u0445\u043c\u0430\u0440\u043d\u0438\u043c \u0441\u0435\u0440\u0432\u0456\u0441\u043e\u043c, \u0442\u0430\u043a\u0438\u043c \u044f\u043a Google Play \u0430\u0431\u043e Apple Game Center. \u041a\u0420\u041e\u041a 1 \u2013 \u041f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e \u0432\u0430\u0448 \u043f\u043e\u0442\u043e\u0447\u043d\u0438\u0439 \u043f\u0440\u0438\u0441\u0442\u0440\u0456\u0439 \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0439 \u0434\u043e \u0445\u043c\u0430\u0440\u043d\u043e\u0433\u043e \u0441\u0435\u0440\u0432\u0456\u0441\u0443. \u041a\u0420\u041e\u041a 2 \u2013 \u0421\u0438\u043d\u0445\u0440\u043e\u043d\u0456\u0437\u0443\u0439\u0442\u0435 \u0434\u0430\u043d\u0456 \u0433\u0440\u0438 \u0432 \u0445\u043c\u0430\u0440\u0456. \u041a\u0420\u041e\u041a 3 \u2013 \u041d\u0430 \u043d\u043e\u0432\u043e\u043c\u0443 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u0457 \u0443\u0432\u0456\u0439\u0434\u0456\u0442\u044c \u0432 \u0442\u043e\u0439 \u0436\u0435 \u0445\u043c\u0430\u0440\u043d\u0438\u0439 \u0441\u0435\u0440\u0432\u0456\u0441, \u0449\u043e\u0431 \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u0441\u0432\u043e\u0457 \u0434\u0430\u043d\u0456. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u044f\u043a\u0449\u043e \u0432\u0438 \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0438\u0442\u0435 \u0437 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443 \u0437 Android \u043d\u0430 iPhone, \u043f\u0440\u0438\u0454\u0434\u043d\u0430\u0439\u0442\u0435 \u0441\u0432\u043e\u044e \u0443\u0447\u0435\u0442\u043d\u0443 \u0437\u0430\u043f\u0438\u0441 \u0434\u043e Google Play \u043f\u0435\u0440\u0435\u0434 \u0437\u043c\u0456\u043d\u043e\u044e. [\u0422\u0430\u0431\u043b\u0438\u0446\u044f \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c: Android \u2013 Google Play, iPhone \u2013 Apple Game Center.]"}]
[{"question": "\u30b4\u30eb\u30d5\u30aa\u30fc\u30d3\u30c3\u30c8\u306e\u521d\u5fc3\u8005\u30b4\u30eb\u30d5\u30a1\u30fc\u306f\u3001\u57fa\u672c\u7684\u306a\u30b9\u30a4\u30f3\u30b0\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u3069\u306e\u3088\u3046\u306b\u30de\u30b9\u30bf\u30fc\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30b4\u30eb\u30d5\u30aa\u30fc\u30d3\u30c3\u30c8\u3067\u57fa\u672c\u7684\u306a\u30b9\u30a4\u30f3\u30b0\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u8ecc\u8de1\u7dda\u3092\u30c9\u30e9\u30c3\u30b0\u3057\u3066\u76ee\u6a19\u65b9\u5411\u306b\u5408\u308f\u305b\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u753b\u9762\u3092\u30bf\u30c3\u30d7\uff06\u30db\u30fc\u30eb\u30c9\u3057\u3066\u30d1\u30ef\u30fc\u30e1\u30fc\u30bf\u30fc\u3092\u8abf\u6574\u3057\u3001\u653e\u3059\u3053\u3068\u3067\u30b9\u30a4\u30f3\u30b0\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u77e2\u5370\u3068\u753b\u9762\u4e0a\u306e\u6570\u5b57\u3067\u793a\u3055\u308c\u308b\u98a8\u5411\u304d\u3068\u98a8\u901f\u3092\u8003\u616e\u3057\u3066\u3001\u30b7\u30e7\u30c3\u30c8\u3092\u5fae\u8abf\u6574\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u98a8\u304c\u53f3\u306b\u6642\u901f5\u30de\u30a4\u30eb\u5439\u3044\u3066\u3044\u308b\u5834\u5408\u3001\u98a8\u3092\u6253\u3061\u6d88\u3059\u305f\u3081\u306b\u5c11\u3057\u5de6\u306b\u76ee\u6a19\u3092\u5b9a\u3081\u3066\u304f\u3060\u3055\u3044\u3002[\u4f8b\u3048\u8a71\uff1a\u30d1\u30ef\u30fc\u30e1\u30fc\u30bf\u30fc\u3092\u5f13\u3068\u77e2\u306b\u4f8b\u3048\u308b\u3068\u3001\u30db\u30fc\u30eb\u30c9\u3059\u308b\u6642\u9593\u304c\u9577\u3051\u308c\u3070\u9577\u3044\u307b\u3069\u3001\u30b7\u30e7\u30c3\u30c8\u306f\u9060\u304f\u307e\u3067\u98db\u3076\u3067\u3057\u3087\u3046\u3002]"}, {"question": "\u30b4\u30eb\u30d5\u30aa\u30fc\u30d3\u30c3\u30c8\u3067\u98a8\u306e\u5f71\u97ff\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u306a\u305c\u30b2\u30fc\u30e0\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u306e\u3067\u3057\u3087\u3046\u304b\uff1f", "answer": "\u30b4\u30eb\u30d5\u30aa\u30fc\u30d3\u30c3\u30c8\u3067\u98a8\u306e\u5f71\u97ff\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u305d\u308c\u306f\u30dc\u30fc\u30eb\u306e\u8ecc\u9053\u3068\u7740\u5730\u70b9\u306b\u76f4\u63a5\u5f71\u97ff\u3059\u308b\u304b\u3089\u3067\u3059\u3002\u98a8\u306e\u65b9\u5411\u3068\u901f\u5ea6\u306f\u3001\u753b\u9762\u4e0a\u306e\u77e2\u5370\u3068\u6570\u5b57\u3067\u8868\u793a\u3055\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u98a8\u304c\u5de6\u306b\u6642\u901f10\u30de\u30a4\u30eb\u5439\u3044\u3066\u3044\u308b\u5834\u5408\u3001\u98a8\u306e\u5f71\u97ff\u3092\u6253\u3061\u6d88\u3059\u305f\u3081\u306b\u5c11\u3057\u53f3\u306b\u76ee\u6a19\u3092\u5b9a\u3081\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u76f4\u63a5\u30bf\u30fc\u30b2\u30c3\u30c8\u3092\u72d9\u3046\u3053\u3068\u3068\u3001\u98a8\u306b\u5408\u308f\u305b\u3066\u76ee\u6a19\u3092\u8abf\u6574\u3059\u308b\u3053\u3068\u306e\u6bd4\u8f03\u3002\u5f8c\u8005\u306e\u5834\u5408\u3001\u5e38\u306b\u3088\u308a\u826f\u3044\u7d50\u679c\u304c\u5f97\u3089\u308c\u307e\u3059\u3002]"}, {"question": "\u30b4\u30eb\u30d5\u30aa\u30fc\u30d3\u30c3\u30c8\u306b\u304a\u3051\u308b\u91cd\u8981\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u3068\u305d\u306e\u6a5f\u80fd\u3068\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b4\u30eb\u30d5\u30aa\u30fc\u30d3\u30c3\u30c8\u306b\u304a\u3051\u308b\u91cd\u8981\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u306b\u306f\u3001\u300c\u30bf\u30fc\u30dc\u30d6\u30fc\u30b9\u30c8\u300d\u3068\u300c\u7cbe\u5bc6\u7167\u6e96\u300d\u304c\u3042\u308a\u307e\u3059\u3002\u300c\u30bf\u30fc\u30dc\u30d6\u30fc\u30b9\u30c8\u300d\u306f\u30dc\u30fc\u30eb\u306e\u901f\u5ea6\u3092\u9ad8\u3081\u3001\u3088\u308a\u9060\u304f\u307e\u3067\u98db\u3070\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u300c\u7cbe\u5bc6\u7167\u6e96\u300d\u306f\u8ecc\u8de1\u7dda\u3092\u72ed\u3081\u3001\u3088\u308a\u6b63\u78ba\u306a\u30b7\u30e7\u30c3\u30c8\u3092\u53ef\u80fd\u306b\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u9577\u3044\u30d1\u30fc5\u306e\u30db\u30fc\u30eb\u3067\u300c\u30bf\u30fc\u30dc\u30d6\u30fc\u30b9\u30c8\u300d\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u3088\u308a\u5c11\u306a\u3044\u30b9\u30c8\u30ed\u30fc\u30af\u3067\u30b0\u30ea\u30fc\u30f3\u306b\u5230\u9054\u3067\u304d\u307e\u3059\u3002[\u8868\uff1a\u30bf\u30fc\u30dc\u30d6\u30fc\u30b9\u30c8\uff1a\u901f\u5ea6\u5411\u4e0a\uff1b\u7cbe\u5bc6\u7167\u6e96\uff1a\u7cbe\u5ea6\u5411\u4e0a\u3002]"}, {"question": "\u30b4\u30eb\u30d5\u30aa\u30fc\u30d3\u30c3\u30c8\u3067100\u6642\u9593\u4ee5\u4e0a\u30d7\u30ec\u30a4\u3057\u3066\u3044\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30b9\u30b3\u30a2\u3092\u4e0b\u3052\u308b\u305f\u3081\u306b\u3069\u306e\u3088\u3046\u306a\u9ad8\u5ea6\u306a\u6226\u7565\u3092\u4f7f\u7528\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30b4\u30eb\u30d5\u30aa\u30fc\u30d3\u30c3\u30c8\u3067100\u6642\u9593\u4ee5\u4e0a\u30d7\u30ec\u30a4\u3057\u3066\u3044\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u9ad8\u5ea6\u306a\u6226\u7565\u300c\u30b3\u30fc\u30b9\u7ba1\u7406\u300d\u3068\u300c\u30ea\u30b9\u30af\u8a55\u4fa1\u300d\u3092\u4f7f\u7528\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b3\u30fc\u30b9\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u8abf\u3079\u3001\u30cf\u30b6\u30fc\u30c9\u3068\u5b89\u5168\u306a\u30a8\u30ea\u30a2\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u98a8\u3068\u5730\u5f62\u3092\u8003\u616e\u3057\u3066\u3001\u305d\u308c\u305e\u308c\u306e\u30b7\u30e7\u30c3\u30c8\u3092\u8a08\u753b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u305f\u3068\u3048\u3070\u3001\u6c34\u306e\u4e0a\u3092\u30ed\u30f3\u30b0\u30b7\u30e7\u30c3\u30c8\u3092\u8a66\u307f\u308b\u5834\u5408\u306a\u3069\u3001\u30ea\u30b9\u30af\u3092\u53d6\u308b\u3079\u304d\u72b6\u6cc1\u3068\u3001\u5b89\u5168\u306b\u30d7\u30ec\u30fc\u3059\u308b\u3079\u304d\u72b6\u6cc1\u3092\u5224\u65ad\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d5\u30a7\u30a2\u30a6\u30a7\u30a4\u304c\u72ed\u3044\u30d1\u30fc4\u306e\u30db\u30fc\u30eb\u3067\u306f\u3001\u30e9\u30d5\u306b\u30ed\u30f3\u30b0\u30c9\u30e9\u30a4\u30d6\u3059\u308b\u30ea\u30b9\u30af\u3092\u907f\u3051\u3066\u3001\u30ec\u30a4\u30a2\u30c3\u30d7\u3059\u308b\u306e\u304c\u8ce2\u660e\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30b3\u30fc\u30b9\u30ec\u30a4\u30a2\u30a6\u30c8\u2192\u30cf\u30b6\u30fc\u30c9\u7279\u5b9a\u2192\u30b7\u30e7\u30c3\u30c8\u8a08\u753b\u2192\u5b9f\u884c\u3002]"}, {"question": "\u30b4\u30eb\u30d5\u30aa\u30fc\u30d3\u30c3\u30c8\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u3069\u306e\u3088\u3046\u306a\u8981\u56e0\u304c\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u304b\uff1f", "answer": "\u30b4\u30eb\u30d5\u30aa\u30fc\u30d3\u30c3\u30c8\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30db\u30fc\u30eb\u3092\u5b8c\u4e86\u3059\u308b\u306e\u306b\u5fc5\u8981\u306a\u30b9\u30c8\u30ed\u30fc\u30af\u6570\u306b\u57fa\u3065\u3044\u3066\u304a\u308a\u3001\u30d1\u30fc\u304c\u57fa\u6e96\u3068\u306a\u308a\u307e\u3059\u3002\u30b9\u30b3\u30a2\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u8981\u56e0\u306b\u306f\u3001\u30db\u30fc\u30eb\u306e\u9577\u3055\u3001\u30cf\u30b6\u30fc\u30c9\u3001\u98a8\u6cc1\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5f37\u3044\u98a8\u304c\u5439\u304f\u30d1\u30fc3\u306e\u30db\u30fc\u30eb\u3067\u306f\u3001\u901a\u5e38\u3088\u308a\u591a\u304f\u306e\u30b9\u30c8\u30ed\u30fc\u30af\u304c\u5fc5\u8981\u306b\u306a\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002[\u4f8b\u3048\u8a71\uff1a\u30d1\u30fc\u3092\u57fa\u6e96\u5024\u3068\u8003\u3048\u308b\u3068\u3001\u30b9\u30c8\u30ed\u30fc\u30af\u6570\u304c\u5c11\u306a\u3044\u307b\u3069\u30b9\u30b3\u30a2\u304c\u826f\u3044\u3067\u3057\u3087\u3046\u3002]"}, {"question": "\u30b4\u30eb\u30d5\u30aa\u30fc\u30d3\u30c3\u30c8\u306b\u304a\u3051\u308b\u300e\u30db\u30fc\u30eb\u30a4\u30f3\u30ef\u30f3\u300f\u306e\u9054\u6210\u610f\u7fa9\u3068\u306f\u4f55\u3067\u3042\u308a\u3001\u3069\u306e\u3088\u3046\u306b\u7d99\u7d9a\u7684\u306b\u9054\u6210\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30b4\u30eb\u30d5\u30aa\u30fc\u30d3\u30c3\u30c8\u306b\u304a\u3051\u308b\u300e\u30db\u30fc\u30eb\u30a4\u30f3\u30ef\u30f3\u300f\u306e\u9054\u6210\u306f\u3001\u30c6\u30a3\u30fc\u30b7\u30e7\u30c3\u30c8\u3067\u30dc\u30fc\u30eb\u3092\u76f4\u63a5\u30db\u30fc\u30eb\u306b\u843d\u3068\u3059\u5b8c\u74a7\u306a\u30b7\u30e7\u30c3\u30c8\u3092\u8868\u3057\u3066\u304a\u308a\u3001\u975e\u5e38\u306b\u610f\u7fa9\u6df1\u3044\u3082\u306e\u3067\u3059\u3002\u3053\u308c\u3092\u7d99\u7d9a\u7684\u306b\u9054\u6210\u3059\u308b\u306b\u306f\u3001\u307e\u305a\u30b9\u30c6\u30c3\u30d71\uff1a\u7cbe\u5bc6\u7167\u6e96\u3092\u4f7f\u7528\u3057\u3066\u8ecc\u8de1\u7dda\u3092\u72ed\u3081\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u98a8\u3068\u5730\u5f62\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u30d1\u30ef\u30fc\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3092\u5b8c\u74a7\u306b\u30de\u30b9\u30bf\u30fc\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u98a8\u304c\u307b\u3068\u3093\u3069\u306a\u304f\u77ed\u3044\u30d1\u30fc3\u306e\u30db\u30fc\u30eb\u3067\u306f\u3001\u7cbe\u5bc6\u7167\u6e96\u3092\u4f7f\u7528\u3057\u305f\u30bf\u30a4\u30df\u30f3\u30b0\u306e\u826f\u3044\u30b7\u30e7\u30c3\u30c8\u304c\u300e\u30db\u30fc\u30eb\u30a4\u30f3\u30ef\u30f3\u300f\u306b\u3064\u306a\u304c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u7cbe\u5bc6\u7167\u6e96\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u3068\u3001\u6a19\u6e96\u7684\u306a\u7167\u6e96\u3092\u6bd4\u8f03\u3059\u308b\u3002\u524d\u8005\u306e\u65b9\u304c\u300e\u30db\u30fc\u30eb\u30a4\u30f3\u30ef\u30f3\u300f\u306e\u53ef\u80fd\u6027\u3092\u9ad8\u3081\u307e\u3059\u3002]"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30b4\u30eb\u30d5\u30aa\u30fc\u30d3\u30c3\u30c8\u306e\u30b2\u30fc\u30e0\u5185\u7d71\u8a08\u3092\u4f7f\u7528\u3057\u3066\u3001\u3069\u306e\u3088\u3046\u306b\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5206\u6790\u3057\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30b4\u30eb\u30d5\u30aa\u30fc\u30d3\u30c3\u30c8\u306e\u30b2\u30fc\u30e0\u5185\u7d71\u8a08\uff08\u300c\u5e73\u5747\u30db\u30fc\u30eb\u30b9\u30c8\u30ed\u30fc\u30af\u6570\u300d\u3084\u300c\u30db\u30fc\u30eb\u30a4\u30f3\u30ef\u30f3\u7387\u300d\u306a\u3069\uff09\u3092\u78ba\u8a8d\u3057\u3066\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5206\u6790\u3057\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30e1\u30a4\u30f3\u753b\u9762\u304b\u3089\u7d71\u8a08\u30e1\u30cb\u30e5\u30fc\u306b\u30a2\u30af\u30bb\u30b9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u4f8b\u3048\u3070\u3001\u30d1\u30fc5\u306e\u30db\u30fc\u30eb\u3067\u4e00\u8cab\u3057\u3066\u9ad8\u3044\u30b9\u30b3\u30a2\u304c\u51fa\u3066\u3044\u308b\u3088\u3046\u306a\u30d1\u30bf\u30fc\u30f3\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u9577\u8ddd\u96e2\u30c9\u30e9\u30a4\u30d6\u3084\u30d1\u30c3\u30c6\u30a3\u30f3\u30b0\u306a\u3069\u3001\u5f31\u70b9\u306e\u6539\u5584\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u5e73\u5747\u30db\u30fc\u30eb\u30b9\u30c8\u30ed\u30fc\u30af\u6570\u300d\u304c\u30d1\u30fc5\u3067\u9ad8\u3044\u5834\u5408\u306f\u3001\u3088\u308a\u591a\u304f\u306e\u6642\u9593\u3092\u8cbb\u3084\u3057\u3066\u9577\u8ddd\u96e2\u30b7\u30e7\u30c3\u30c8\u306e\u7df4\u7fd2\u306b\u53d6\u308a\u7d44\u307f\u307e\u3059\u3002[\u8868\uff1a\u5e73\u5747\u30db\u30fc\u30eb\u30b9\u30c8\u30ed\u30fc\u30af\u6570\uff1a\u5f31\u70b9\u7279\u5b9a\uff1b\u30db\u30fc\u30eb\u30a4\u30f3\u30ef\u30f3\u7387\uff1a\u6b63\u78ba\u6027\u6e2c\u5b9a\u3002]"}, {"question": "\u30e2\u30d0\u30a4\u30eb\u7248\u3068PC\u7248\u306e\u30b4\u30eb\u30d5\u30aa\u30fc\u30d3\u30c3\u30c8\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3042\u308a\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30e2\u30d0\u30a4\u30eb\u7248\u3068PC\u7248\u306e\u30b4\u30eb\u30d5\u30aa\u30fc\u30d3\u30c3\u30c8\u306e\u4e3b\u306a\u9055\u3044\u306f\u3001\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u65b9\u6cd5\u3068\u753b\u9762\u30b5\u30a4\u30ba\u3067\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u7248\u3067\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30bf\u30c3\u30c1\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3092\u4f7f\u7528\u3057\u3066\u30b7\u30e7\u30c3\u30c8\u3092\u8abf\u6574\u3057\u3001PC\u7248\u3067\u306f\u30de\u30a6\u30b9\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002PC\u7248\u306e\u5927\u304d\u306a\u753b\u9762\u306f\u3001\u30b3\u30fc\u30b9\u306e\u3088\u308a\u8a73\u7d30\u306a\u8868\u793a\u3092\u63d0\u4f9b\u3057\u3001\u7cbe\u5ea6\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001PC\u7248\u3067\u306f\u3001\u8ecc\u8de1\u7dda\u306e\u8868\u793a\u304c\u5411\u4e0a\u3059\u308b\u305f\u3081\u3001\u30b7\u30e7\u30c3\u30c8\u306e\u8abf\u6574\u304c\u3088\u308a\u5bb9\u6613\u3067\u3059\u3002[\u6bd4\u8f03\uff1a\u30e2\u30d0\u30a4\u30eb\u306e\u30bf\u30c3\u30c1\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3068PC\u306e\u30de\u30a6\u30b9\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3092\u6bd4\u8f03\u3002\u5f8c\u8005\u306e\u65b9\u304c\u3088\u308a\u7cbe\u5ea6\u304c\u9ad8\u3044\u3002]"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30b4\u30eb\u30d5\u30aa\u30fc\u30d3\u30c3\u30c8\u3067\u96a0\u3055\u308c\u305f\u30b3\u30fc\u30b9\u3092\u3069\u306e\u3088\u3046\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u304b\uff1f\u307e\u305f\u3001\u524d\u63d0\u6761\u4ef6\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u7279\u5b9a\u306e\u9054\u6210\u6761\u4ef6\u3092\u9054\u6210\u3059\u308b\u304b\u3001\u7279\u5b9a\u306e\u76ee\u6a19\u3092\u9054\u6210\u3059\u308b\u3053\u3068\u3067\u3001\u30b4\u30eb\u30d5\u30aa\u30fc\u30d3\u30c3\u30c8\u3067\u96a0\u3055\u308c\u305f\u30b3\u30fc\u30b9\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u79d8\u5bc6\u306e\u30b0\u30ea\u30fc\u30f3\u300d\u30b3\u30fc\u30b9\u306f\u300110\u56de\u306e\u300c\u30db\u30fc\u30eb\u30a4\u30f3\u30ef\u30f3\u300d\u3092\u9054\u6210\u3059\u308b\u3068\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u9054\u6210\u6761\u4ef6\u9054\u6210\u2192\u76ee\u6a19\u9054\u6210\u2192\u96a0\u3055\u308c\u305f\u30b3\u30fc\u30b9\u30a2\u30f3\u30ed\u30c3\u30af\u3002]"}, {"question": "\u30c7\u30d0\u30a4\u30b9\u3092\u5207\u308a\u66ff\u3048\u308b\u969b\u306e\u3001\u30b4\u30eb\u30d5\u30aa\u30fc\u30d3\u30c3\u30c8\u3067\u306e\u30c7\u30fc\u30bf\u79fb\u884c\u306e\u30d9\u30b9\u30c8\u30d7\u30e9\u30af\u30c6\u30a3\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b4\u30eb\u30d5\u30aa\u30fc\u30d3\u30c3\u30c8\u3067\u306e\u30c7\u30fc\u30bf\u79fb\u884c\u306e\u30d9\u30b9\u30c8\u30d7\u30e9\u30af\u30c6\u30a3\u30b9\u306b\u306f\u3001Google Play\u3084Apple Game Center\u306a\u3069\u306e\u30af\u30e9\u30a6\u30c9\u30b5\u30fc\u30d3\u30b9\u306b\u30b2\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30ea\u30f3\u30af\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u73fe\u5728\u306e\u30c7\u30d0\u30a4\u30b9\u304c\u30af\u30e9\u30a6\u30c9\u30b5\u30fc\u30d3\u30b9\u306b\u63a5\u7d9a\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b2\u30fc\u30e0\u30c7\u30fc\u30bf\u3092\u30af\u30e9\u30a6\u30c9\u306b\u540c\u671f\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30af\u30e9\u30a6\u30c9\u30b5\u30fc\u30d3\u30b9\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3001\u30c7\u30fc\u30bf\u3092\u5fa9\u5143\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001Android\u30b9\u30de\u30fc\u30c8\u30d5\u30a9\u30f3\u304b\u3089iPhone\u306b\u5207\u308a\u66ff\u3048\u308b\u5834\u5408\u306f\u3001\u5207\u308a\u66ff\u3048\u524d\u306b\u30a2\u30ab\u30a6\u30f3\u30c8\u3092Google Play\u306b\u30ea\u30f3\u30af\u3057\u307e\u3059\u3002[\u8868\uff1aAndroid - Google Play; iPhone - Apple Game Center\u3002]"}]
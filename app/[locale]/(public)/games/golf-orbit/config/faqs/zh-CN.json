[{"question": "\u9ad8\u5c14\u592b\u8f68\u8ff9\u521d\u5b66\u8005\u5982\u4f55\u638c\u63e1\u57fa\u672c\u6325\u6746\u6280\u5de7\uff1f", "answer": "\u8981\u638c\u63e1\u9ad8\u5c14\u592b\u8f68\u8ff9\u7684\u57fa\u672c\u6325\u6746\u6280\u5de7\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u901a\u8fc7\u62d6\u52a8\u8f68\u8ff9\u7ebf\u6765\u8c03\u6574\u51fb\u7403\u65b9\u5411\u3002\u6b65\u9aa42 - \u901a\u8fc7\u70b9\u51fb\u5e76\u6309\u4f4f\u5c4f\u5e55\u6765\u8c03\u6574\u529b\u91cf\u8ba1\uff0c\u7136\u540e\u677e\u5f00\u8fdb\u884c\u6325\u6746\u3002\u6b65\u9aa43 - \u8003\u8651\u98ce\u5411\u548c\u98ce\u901f\uff08\u5c4f\u5e55\u4e0a\u7684\u7bad\u5934\u548c\u6570\u5b57\u6307\u793a\uff09\uff0c\u5fae\u8c03\u4f60\u7684\u51fb\u7403\u3002\u4f8b\u5982\uff0c\u5982\u679c\u98ce\u5411\u662f\u671d\u53f3\u54395\u82f1\u91cc/\u5c0f\u65f6\uff0c\u5219\u5e94\u7565\u5fae\u7784\u51c6\u5de6\u4fa7\u4ee5\u5f25\u8865\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u529b\u91cf\u8ba1\u60f3\u8c61\u6210\u5f13\u7bad\uff1b\u6309\u538b\u65f6\u95f4\u8d8a\u957f\uff0c\u5c04\u7a0b\u8d8a\u8fdc\u3002]"}, {"question": "\u5728\u9ad8\u5c14\u592b\u8f68\u8ff9\u4e2d\uff0c\u4e3a\u4ec0\u4e48\u7406\u89e3\u98ce\u5411\u5bf9\u63d0\u9ad8\u6e38\u620f\u6c34\u5e73\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u5728\u9ad8\u5c14\u592b\u8f68\u8ff9\u4e2d\uff0c\u7406\u89e3\u98ce\u5411\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u4f1a\u76f4\u63a5\u5f71\u54cd\u7403\u7684\u8f68\u8ff9\u548c\u843d\u70b9\u3002\u5c4f\u5e55\u4e0a\u7684\u7bad\u5934\u548c\u6570\u5b57\u663e\u793a\u4e86\u98ce\u5411\u548c\u98ce\u901f\u3002\u4f8b\u5982\uff0c\u5982\u679c\u98ce\u5411\u662f\u671d\u5de6\u543910\u82f1\u91cc/\u5c0f\u65f6\uff0c\u5219\u5e94\u7565\u5fae\u7784\u51c6\u53f3\u4fa7\u4ee5\u62b5\u6d88\u98ce\u7684\u6548\u5e94\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6bd4\u8f83\u76f4\u63a5\u7784\u51c6\u76ee\u6807\u4e0e\u6839\u636e\u98ce\u5411\u8c03\u6574\u7784\u51c6\uff1b\u540e\u8005\u59cb\u7ec8\u80fd\u53d6\u5f97\u66f4\u597d\u7684\u7ed3\u679c\u3002]"}, {"question": "\u9ad8\u5c14\u592b\u8f68\u8ff9\u4e2d\u6709\u54ea\u4e9b\u91cd\u8981\u7684\u589e\u5f3a\u9053\u5177\uff0c\u5b83\u4eec\u7684\u529f\u80fd\u662f\u4ec0\u4e48\uff1f", "answer": "\u9ad8\u5c14\u592b\u8f68\u8ff9\u4e2d\u7684\u91cd\u8981\u589e\u5f3a\u9053\u5177\u5305\u62ec\"\u52a0\u901f\u52a9\u529b\"\u548c\"\u7cbe\u51c6\u7784\u51c6\"\u3002\"\u52a0\u901f\u52a9\u529b\"\u53ef\u4ee5\u589e\u52a0\u7403\u7684\u901f\u5ea6\uff0c\u4f7f\u5176\u884c\u7a0b\u66f4\u8fdc\uff1b\"\u7cbe\u51c6\u7784\u51c6\"\u53ef\u4ee5\u7f29\u5c0f\u8f68\u8ff9\u7ebf\uff0c\u8ba9\u51fb\u7403\u66f4\u7cbe\u51c6\u3002\u4f8b\u5982\uff0c\u5728\u957f\u4e94\u6746\u6d1e\u4e2d\u4f7f\u7528\"\u52a0\u901f\u52a9\u529b\"\u53ef\u4ee5\u5e2e\u52a9\u4f60\u66f4\u5feb\u5730\u62b5\u8fbe\u679c\u5cad\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u52a0\u901f\u52a9\u529b - \u589e\u52a0\u901f\u5ea6\uff1b\u7cbe\u51c6\u7784\u51c6 - \u63d0\u9ad8\u51c6\u786e\u7387\u3002]"}, {"question": "\u5728\u9ad8\u5c14\u592b\u8f68\u8ff9\u4e2d\uff0c\u73a9\u6e38\u620f\u8d85\u8fc7100\u5c0f\u65f6\u7684\u73a9\u5bb6\u53ef\u4ee5\u4f7f\u7528\u54ea\u4e9b\u9ad8\u7ea7\u7b56\u7565\u6765\u964d\u4f4e\u5206\u6570\uff1f", "answer": "\u5728\u9ad8\u5c14\u592b\u8f68\u8ff9\u4e2d\uff0c\u73a9\u6e38\u620f\u8d85\u8fc7100\u5c0f\u65f6\u7684\u73a9\u5bb6\u53ef\u4ee5\u4f7f\u7528\u8bf8\u5982\"\u7403\u573a\u7ba1\u7406\"\u548c\"\u98ce\u9669\u8bc4\u4f30\"\u7b49\u9ad8\u7ea7\u7b56\u7565\u3002\u6b65\u9aa41 - \u7814\u7a76\u7403\u573a\u5e03\u5c40\uff0c\u8bc6\u522b\u969c\u788d\u548c\u5b89\u5168\u533a\u57df\u3002\u6b65\u9aa42 - \u8003\u8651\u98ce\u5411\u548c\u5730\u5f62\u6765\u89c4\u5212\u6bcf\u4e2a\u51fb\u7403\u3002\u6b65\u9aa43 - \u51b3\u5b9a\u4f55\u65f6\u5192\u9669\uff0c\u4f8b\u5982\u5c1d\u8bd5\u4ece\u6c34\u9762\u4e0a\u65b9\u51fb\u6253\u957f\u7403\uff0c\u8fd8\u662f\u5b89\u5168\u5730\u51fb\u6253\u3002\u4f8b\u5982\uff0c\u5728\u56db\u6746\u6d1e\u72ed\u7a84\u7403\u9053\u4e0a\uff0c\u4e0e\u5176\u5192\u9669\u5c06\u957f\u7403\u6253\u5165\u7c97\u7cd9\u533a\uff0c\u4e0d\u5982\u9009\u62e9\u7a33\u59a5\u7684\u7403\u9053\u7403\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u7403\u573a\u5e03\u5c40 -> \u8bc6\u522b\u969c\u788d -> \u89c4\u5212\u51fb\u7403 -> \u6267\u884c\u3002]"}, {"question": "\u9ad8\u5c14\u592b\u8f68\u8ff9\u4e2d\u7684\u8ba1\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u5b83\uff1f", "answer": "\u9ad8\u5c14\u592b\u8f68\u8ff9\u7684\u8ba1\u5206\u7cfb\u7edf\u57fa\u4e8e\u5b8c\u6210\u4e00\u4e2a\u6d1e\u6240\u9700\u7684\u51fb\u7403\u6b21\u6570\uff0c\u6807\u51c6\u6746\u4e3a\u6807\u51c6\u3002\u5f71\u54cd\u5206\u6570\u7684\u56e0\u7d20\u5305\u62ec\u6d1e\u7684\u957f\u5ea6\u3001\u969c\u788d\u7269\u548c\u98ce\u51b5\u3002\u4f8b\u5982\uff0c\u5728\u5f3a\u98ce\u4e2d\u7684\u4e09\u6746\u6d1e\u53ef\u80fd\u6bd4\u5e73\u65f6\u9700\u8981\u66f4\u591a\u7684\u51fb\u7403\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u6807\u51c6\u6746\u60f3\u8c61\u6210\u57fa\u51c6\uff1b\u4f60\u51fb\u7403\u6b21\u6570\u8d8a\u5c11\uff0c\u5206\u6570\u5c31\u8d8a\u9ad8\u3002]"}, {"question": "\u9ad8\u5c14\u592b\u8f68\u8ff9\u4e2d\u7684\"\u4e00\u6746\u8fdb\u6d1e\"\u6210\u5c31\u6709\u4ec0\u4e48\u610f\u4e49\uff0c\u5982\u4f55\u624d\u80fd\u6301\u7eed\u83b7\u5f97\uff1f", "answer": "\u9ad8\u5c14\u592b\u8f68\u8ff9\u4e2d\u7684\"\u4e00\u6746\u8fdb\u6d1e\"\u6210\u5c31\u610f\u4e49\u91cd\u5927\uff0c\u56e0\u4e3a\u5b83\u4ee3\u8868\u7740\u5b8c\u7f8e\u7684\u51fb\u7403\uff0c\u76f4\u63a5\u5c06\u7403\u4ece\u53d1\u7403\u533a\u51fb\u5165\u6d1e\u4e2d\u3002\u4e3a\u4e86\u6301\u7eed\u83b7\u5f97\u6b64\u6210\u5c31\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u4f7f\u7528\"\u7cbe\u51c6\u7784\u51c6\"\u6765\u7f29\u5c0f\u4f60\u7684\u8f68\u8ff9\u3002\u6b65\u9aa42 - \u8c03\u6574\u98ce\u5411\u548c\u5730\u5f62\u3002\u6b65\u9aa43 - \u5b8c\u5584\u4f60\u7684\u51fb\u7403\u65f6\u673a\u548c\u529b\u91cf\u63a7\u5236\u3002\u4f8b\u5982\uff0c\u5728\u6ca1\u6709\u98ce\u7684\u5c0f\u4e09\u6746\u6d1e\u4e2d\uff0c\u4f7f\u7528\"\u7cbe\u51c6\u7784\u51c6\"\u7684\u6070\u5f53\u51fb\u7403\u53ef\u4ee5\u5b8c\u6210\"\u4e00\u6746\u8fdb\u6d1e\"\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6bd4\u8f83\u4f7f\u7528\"\u7cbe\u51c6\u7784\u51c6\"\u4e0e\u6807\u51c6\u7784\u51c6\uff1b\u524d\u8005\u589e\u52a0\"\u4e00\u6746\u8fdb\u6d1e\"\u7684\u53ef\u80fd\u6027\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u4f7f\u7528\u9ad8\u5c14\u592b\u8f68\u8ff9\u4e2d\u7684\u6e38\u620f\u5185\u7edf\u8ba1\u6570\u636e\u6765\u5206\u6790\u548c\u4f18\u5316\u4ed6\u4eec\u7684\u8868\u73b0\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u67e5\u770b\u6e38\u620f\u7edf\u8ba1\u6570\u636e\uff0c\u4f8b\u5982\"\u5e73\u5747\u6bcf\u6d1e\u51fb\u7403\u6b21\u6570\"\u548c\"\u4e00\u6746\u8fdb\u6d1e\u767e\u5206\u6bd4\"\uff0c\u6765\u5206\u6790\u548c\u4f18\u5316\u4ed6\u4eec\u5728\u9ad8\u5c14\u592b\u8f68\u8ff9\u4e2d\u7684\u8868\u73b0\u3002\u6b65\u9aa41 - \u4ece\u4e3b\u5c4f\u5e55\u8bbf\u95ee\u7edf\u8ba1\u83dc\u5355\u3002\u6b65\u9aa42 - \u8bc6\u522b\u6a21\u5f0f\uff0c\u4f8b\u5982\u5728\u4e94\u6746\u6d1e\u4e2d\u6301\u7eed\u9ad8\u5206\u3002\u6b65\u9aa43 - \u4e13\u6ce8\u4e8e\u6539\u8fdb\u5f31\u9879\uff0c\u4f8b\u5982\u7ec3\u4e60\u957f\u8ddd\u79bb\u51fb\u7403\u6216\u63a8\u6746\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u7684\"\u5e73\u5747\u6bcf\u6d1e\u51fb\u7403\u6b21\u6570\"\u5728\u4e94\u6746\u6d1e\u4e2d\u5f88\u9ad8\uff0c\u8bf7\u82b1\u66f4\u591a\u65f6\u95f4\u7ec3\u4e60\u957f\u8ddd\u79bb\u51fb\u7403\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u5e73\u5747\u6bcf\u6d1e\u51fb\u7403\u6b21\u6570 - \u8bc6\u522b\u5f31\u70b9\uff1b\u4e00\u6746\u8fdb\u6d1e\u767e\u5206\u6bd4 - \u8861\u91cf\u51c6\u786e\u7387\u3002]"}, {"question": "\u79fb\u52a8\u7aef\u548cPC\u7aef\u9ad8\u5c14\u592b\u8f68\u8ff9\u7248\u672c\u4e4b\u95f4\u6709\u54ea\u4e9b\u5173\u952e\u533a\u522b\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u79fb\u52a8\u7aef\u548cPC\u7aef\u9ad8\u5c14\u592b\u8f68\u8ff9\u7248\u672c\u4e4b\u95f4\u7684\u5173\u952e\u533a\u522b\u5305\u62ec\u63a7\u5236\u673a\u5236\u548c\u5c4f\u5e55\u5c3a\u5bf8\u3002\u5728\u79fb\u52a8\u7aef\uff0c\u73a9\u5bb6\u4f7f\u7528\u89e6\u6478\u63a7\u5236\u6765\u8c03\u6574\u51fb\u7403\uff1b\u5728PC\u7aef\uff0c\u4ed6\u4eec\u4f7f\u7528\u9f20\u6807\u3002PC\u7aef\u66f4\u5927\u7684\u5c4f\u5e55\u63d0\u4f9b\u4e86\u66f4\u8be6\u7ec6\u7684\u7403\u573a\u89c6\u56fe\uff0c\u6709\u52a9\u4e8e\u63d0\u9ad8\u51c6\u786e\u6027\u3002\u4f8b\u5982\uff0c\u5728PC\u4e0a\u8c03\u6574\u51fb\u7403\u53ef\u80fd\u66f4\u5bb9\u6613\uff0c\u56e0\u4e3a\u8f68\u8ff9\u7ebf\u7684\u53ef\u89c1\u5ea6\u66f4\u6e05\u6670\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6bd4\u8f83\u79fb\u52a8\u7aef\u7684\u89e6\u6478\u63a7\u5236\u4e0ePC\u7aef\u7684\u9f20\u6807\u63a7\u5236\uff1b\u540e\u8005\u63d0\u4f9b\u4e86\u66f4\u9ad8\u7684\u7cbe\u5ea6\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u9ad8\u5c14\u592b\u8f68\u8ff9\u4e2d\u89e3\u9501\u9690\u85cf\u7684\u7403\u573a\uff0c\u4ee5\u53ca\u5148\u51b3\u6761\u4ef6\u662f\u4ec0\u4e48\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u5b8c\u6210\u7279\u5b9a\u6210\u5c31\u6216\u8fbe\u5230\u7279\u5b9a\u91cc\u7a0b\u7891\u6765\u89e3\u9501\u9ad8\u5c14\u592b\u8f68\u8ff9\u4e2d\u7684\u9690\u85cf\u7403\u573a\u3002\u4f8b\u5982\uff0c\"\u79d8\u5bc6\u679c\u5cad\"\u7403\u573a\u5728\u5b8c\u621010\u6b21\"\u4e00\u6746\u8fdb\u6d1e\"\u540e\u89e3\u9501\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u5b8c\u6210\u6210\u5c31 -> \u8fbe\u5230\u91cc\u7a0b\u7891 -> \u89e3\u9501\u9690\u85cf\u7403\u573a\u3002]"}, {"question": "\u5728\u9ad8\u5c14\u592b\u8f68\u8ff9\u4e2d\u66f4\u6362\u8bbe\u5907\u65f6\uff0c\u6570\u636e\u8fc1\u79fb\u7684\u6700\u4f73\u5b9e\u8df5\u662f\u4ec0\u4e48\uff1f", "answer": "\u9ad8\u5c14\u592b\u8f68\u8ff9\u4e2d\u6570\u636e\u8fc1\u79fb\u7684\u6700\u4f73\u5b9e\u8df5\u5305\u62ec\u5c06\u4f60\u7684\u6e38\u620f\u8d26\u6237\u94fe\u63a5\u5230\u4e91\u670d\u52a1\uff0c\u4f8b\u5982Google Play\u6216Apple Game Center\u3002\u6b65\u9aa41 - \u786e\u4fdd\u4f60\u5f53\u524d\u7684\u8bbe\u5907\u5df2\u8fde\u63a5\u5230\u4e91\u670d\u52a1\u3002\u6b65\u9aa42 - \u5c06\u4f60\u7684\u6e38\u620f\u6570\u636e\u540c\u6b65\u5230\u4e91\u7aef\u3002\u6b65\u9aa43 - \u5728\u65b0\u8bbe\u5907\u4e0a\u767b\u5f55\u540c\u4e00\u4e91\u670d\u52a1\u4ee5\u68c0\u7d22\u4f60\u7684\u6570\u636e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4eceAndroid\u624b\u673a\u5207\u6362\u5230iPhone\uff0c\u8bf7\u5728\u5207\u6362\u4e4b\u524d\u5c06\u4f60\u7684\u5e10\u6237\u94fe\u63a5\u5230Google Play\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1aAndroid - Google Play\uff1biPhone - Apple Game Center\u3002]"}]
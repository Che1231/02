[{"question": "\u5982\u4f55\u5728\u300a\u9a91\u9a6c\u6a21\u62df\u56683D\u300b\u4e2d\u4f5c\u4e3a\u65b0\u624b\u63a7\u5236\u6211\u7684\u9a6c\uff1f", "answer": "\u5728\u300a\u9a91\u9a6c\u6a21\u62df\u56683D\u300b\u4e2d\u63a7\u5236\u4f60\u7684\u9a6c\u975e\u5e38\u7b80\u5355\u3002\u4f7f\u7528\u5c4f\u5e55\u5de6\u4fa7\u7684\u64cd\u7eb5\u6746\u5c06\u4f60\u7684\u9a6c\u79fb\u52a8\u5230\u4efb\u4f55\u65b9\u5411\u3002\u53f3\u4fa7\u7684\u6309\u94ae\u5141\u8bb8\u4f60\u6267\u884c\u4f8b\u5982\u8df3\u8dc3\u3001\u75be\u9a70\u548c\u4e0e\u7269\u4f53\u4e92\u52a8\u7684\u52a8\u4f5c\u3002\u4f8b\u5982\uff0c\u8981\u8df3\u8fc7\u6805\u680f\uff0c\u53ea\u9700\u5728\u63a5\u8fd1\u969c\u788d\u7269\u65f6\u70b9\u51fb\u8df3\u8dc3\u6309\u94ae\u5373\u53ef\u3002\u5728\u7a7a\u65f7\u7684\u573a\u5730\u7ec3\u4e60\uff0c\u4f7f\u81ea\u5df1\u719f\u6089\u8fd9\u4e9b\u63a7\u5236\u65b9\u6cd5\u3002"}, {"question": "\u5728\u300a\u9a91\u9a6c\u6a21\u62df\u56683D\u300b\u4e2d\u83b7\u5f97\u786c\u5e01\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300a\u9a91\u9a6c\u6a21\u62df\u56683D\u300b\u4e2d\u6709\u6548\u5730\u83b7\u5f97\u786c\u5e01\u9700\u8981\u4e00\u4e9b\u5173\u952e\u7b56\u7565\u3002\u6b65\u9aa4\u4e00\uff1a\u5b8c\u6210\u6bcf\u65e5\u4efb\u52a1\uff0c\u8fd9\u4e9b\u4efb\u52a1\u901a\u5e38\u4f1a\u5956\u52b1\u5927\u91cf\u786c\u5e01\u3002\u6b65\u9aa4\u4e8c\uff1a\u53c2\u4e0e\u6bd4\u8d5b\u548c\u8ff7\u4f60\u6e38\u620f\uff0c\u56e0\u4e3a\u5b83\u4eec\u80fd\u5feb\u901f\u63d0\u5347\u786c\u5e01\u6570\u91cf\u3002\u6b65\u9aa4\u4e09\uff1a\u5f7b\u5e95\u63a2\u7d22\u5730\u56fe\uff0c\u627e\u5230\u9690\u85cf\u7684\u5b9d\u7bb1\uff0c\u91cc\u9762\u5305\u542b\u786c\u5e01\u3002\u4f8b\u5982\uff0c\u68ee\u6797\u533a\u57df\u7011\u5e03\u9644\u8fd1\u7684\u5b9d\u7bb1\u59cb\u7ec8\u5305\u542b 50 \u679a\u786c\u5e01\u3002\u7ed3\u5408\u8fd9\u4e9b\u65b9\u6cd5\u5c06\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u4f60\u7684\u786c\u5e01\u6536\u76ca\u3002"}, {"question": "\u5728\u300a\u9a91\u9a6c\u6a21\u62df\u56683D\u300b\u4e2d\uff0c\u6211\u5e94\u8be5\u8c03\u6574\u54ea\u4e9b\u8bbe\u7f6e\u4ee5\u83b7\u5f97\u6700\u4f73\u6027\u80fd\uff1f", "answer": "\u4e3a\u4e86\u786e\u4fdd\u300a\u9a91\u9a6c\u6a21\u62df\u56683D\u300b\u7684\u6700\u4f73\u6027\u80fd\uff0c\u8bf7\u8c03\u6574\u4ee5\u4e0b\u8bbe\u7f6e\uff1a\u5982\u679c\u4f60\u7684\u8bbe\u5907\u51fa\u73b0\u5ef6\u8fdf\uff0c\u8bf7\u964d\u4f4e\u56fe\u5f62\u8d28\u91cf\u3002\u5728\u8bbe\u7f6e\u83dc\u5355\u4e2d\u542f\u7528\u201c\u6027\u80fd\u6a21\u5f0f\u201d\u4ee5\u4f18\u5148\u4fdd\u8bc1\u6d41\u7545\u7684\u6e38\u620f\u4f53\u9a8c\uff0c\u800c\u4e0d\u662f\u89c6\u89c9\u6548\u679c\u3002\u6b64\u5916\uff0c\u5982\u679c\u5728\u5927\u578b\u5f00\u653e\u533a\u57df\u6ce8\u610f\u5230\u5e27\u6570\u4e0b\u964d\uff0c\u8bf7\u51cf\u5c11\u7ed8\u5236\u8ddd\u79bb\u3002\u4f8b\u5982\uff0c\u5728\u4e2d\u6863\u8bbe\u5907\u4e0a\uff0c\u5c06\u56fe\u5f62\u8bbe\u7f6e\u4e3a\u201c\u4e2d\u7b49\u201d\uff0c\u5c06\u7ed8\u5236\u8ddd\u79bb\u8bbe\u7f6e\u4e3a\u201c\u6b63\u5e38\u201d\u53ef\u4ee5\u63d0\u4f9b\u5e73\u8861\u7684\u4f53\u9a8c\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u5728\u300a\u9a91\u9a6c\u6a21\u62df\u56683D\u300b\u4e2d\u4e86\u89e3\u8010\u529b\u7cfb\u7edf\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u5728\u300a\u9a91\u9a6c\u6a21\u62df\u56683D\u300b\u4e2d\u4e86\u89e3\u8010\u529b\u7cfb\u7edf\u5bf9\u4e8e\u957f\u65f6\u95f4\u6d3b\u52a8\u81f3\u5173\u91cd\u8981\u3002\u75be\u9a70\u6216\u8fdb\u884c\u5267\u70c8\u6d3b\u52a8\u4f1a\u6d88\u8017\u8010\u529b\u3002\u4e00\u65e6\u8017\u5c3d\uff0c\u4f60\u7684\u9a6c\u7684\u79fb\u52a8\u901f\u5ea6\u5c06\u4f1a\u663e\u8457\u964d\u4f4e\u3002\u4e3a\u4e86\u6709\u6548\u5730\u7ba1\u7406\u8010\u529b\uff0c\u5728\u75be\u9a70\u548c\u6b65\u884c\u4e4b\u95f4\u4ea4\u66ff\u8fdb\u884c\u3002\u4f8b\u5982\uff0c\u5728\u8d5b\u8dd1\u671f\u95f4\uff0c\u4ee5\u77ed\u65f6\u95f4\u7684\u75be\u9a70\u548c\u6b65\u884c\u6765\u6062\u590d\u8010\u529b\u3002\u6b64\u7b56\u7565\u786e\u4fdd\u4f60\u7684\u9a6c\u4fdd\u6301\u7a33\u5b9a\u7684\u901f\u5ea6\uff0c\u4e0d\u4f1a\u7b4b\u75b2\u529b\u5c3d\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u9a91\u9a6c\u6a21\u62df\u56683D\u300b\u4e2d\u89e3\u9501\u6240\u6709\u9a6c\u5339\u54c1\u79cd\uff1f", "answer": "\u5728\u300a\u9a91\u9a6c\u6a21\u62df\u56683D\u300b\u4e2d\u89e3\u9501\u6240\u6709\u9a6c\u5339\u54c1\u79cd\u9700\u8981\u7ed3\u5408\u6e38\u620f\u6210\u5c31\u548c\u82b1\u8d39\u786c\u5e01\u3002\u6b65\u9aa4\u4e00\uff1a\u5b8c\u6210\u7279\u5b9a\u7684\u6210\u5c31\uff0c\u4f8b\u5982\u201c\u8d62\u5f97 10 \u573a\u6bd4\u8d5b\u201d\u4ee5\u89e3\u9501\u963f\u62c9\u4f2f\u9a6c\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u4ece\u4efb\u52a1\u548c\u6bd4\u8d5b\u4e2d\u83b7\u5f97\u7684\u786c\u5e01\uff0c\u5728\u6e38\u620f\u5546\u5e97\u8d2d\u4e70\u54c1\u79cd\u3002\u6b65\u9aa4\u4e09\uff1a\u53c2\u4e0e\u5b63\u8282\u6027\u6d3b\u52a8\uff0c\u8fd9\u4e9b\u6d3b\u52a8\u4f1a\u63d0\u4f9b\u4e13\u5c5e\u54c1\u79cd\u4f5c\u4e3a\u5956\u52b1\u3002\u4f8b\u5982\uff0c\u201c\u51ac\u5b63\u8282\u65e5\u201d\u6d3b\u52a8\u901a\u5e38\u4f1a\u5728\u6d3b\u52a8\u671f\u95f4\u63d0\u4f9b\u4e00\u79cd\u72ec\u7279\u7684\u54c1\u79cd\u3002"}, {"question": "\u300a\u9a91\u9a6c\u6a21\u62df\u56683D\u300b\u4e2d\u5404\u79cd\u5730\u5f62\u4e4b\u95f4\u7684\u4e3b\u8981\u533a\u522b\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u9a91\u9a6c\u6a21\u62df\u56683D\u300b\u4e2d\u7684\u4e0d\u540c\u5730\u5f62\u4f1a\u5f71\u54cd\u4f60\u7684\u9a6c\u7684\u79fb\u52a8\u548c\u8010\u529b\u3002\u8349\u539f\u5bf9\u4e8e\u65b0\u624b\u6765\u8bf4\u662f\u7406\u60f3\u7684\u9009\u62e9\uff0c\u56e0\u4e3a\u5176\u5730\u5f62\u5e73\u5766\u4e14\u6ca1\u6709\u969c\u788d\u3002\u68ee\u6797\u63d0\u4f9b\u4e86\u66f4\u5177\u6311\u6218\u6027\u7684\u8def\u5f84\uff0c\u9690\u85cf\u7740\u5956\u52b1\uff0c\u4f46\u4e5f\u53ef\u80fd\u51cf\u6162\u4f60\u7684\u9a6c\u901f\u3002\u5c71\u5730\u9700\u8981\u4ed4\u7ec6\u7684\u5bfc\u822a\u548c\u8010\u529b\u7ba1\u7406\uff0c\u56e0\u4e3a\u5761\u5ea6\u9661\u5ced\u3002\u4f8b\u5982\uff0c\u7a7f\u8d8a\u68ee\u6797\u5730\u5f62\u53ef\u80fd\u4f1a\u53d1\u73b0\u9690\u85cf\u7684\u5b9d\u7bb1\uff0c\u4f46\u662f\u4e0e\u8349\u539f\u76f8\u6bd4\uff0c\u4f60\u7684\u9a6c\u7684\u8010\u529b\u4f1a\u6d88\u8017\u5f97\u66f4\u5feb\u3002"}, {"question": "\u5929\u6c14\u7cfb\u7edf\u5982\u4f55\u5728\u300a\u9a91\u9a6c\u6a21\u62df\u56683D\u300b\u4e2d\u5f71\u54cd\u6e38\u620f\uff1f", "answer": "\u300a\u9a91\u9a6c\u6a21\u62df\u56683D\u300b\u4e2d\u7684\u5929\u6c14\u7cfb\u7edf\u4e3a\u6e38\u620f\u589e\u52a0\u4e86\u52a8\u6001\u5c42\u3002\u4e0b\u96e8\u4f1a\u964d\u4f4e\u80fd\u89c1\u5ea6\uff0c\u5e76\u4f7f\u9053\u8def\u53d8\u5f97\u6e7f\u6ed1\uff0c\u9700\u8981\u8c28\u614e\u79fb\u52a8\u3002\u4e0b\u96ea\u4f1a\u51cf\u6162\u4f60\u7684\u9a6c\u901f\u5e76\u589e\u52a0\u8010\u529b\u6d88\u8017\u3002\u6674\u5929\u662f\u63a2\u7d22\u548c\u6bd4\u8d5b\u7684\u7406\u60f3\u9009\u62e9\uff0c\u56e0\u4e3a\u80fd\u89c1\u5ea6\u6e05\u6670\uff0c\u5730\u5f62\u7a33\u5b9a\u3002\u4f8b\u5982\uff0c\u5728\u96e8\u5929\u8d5b\u8dd1\u65f6\uff0c\u4f60\u53ef\u80fd\u9700\u8981\u5728\u8f6c\u5f2f\u65f6\u653e\u6162\u901f\u5ea6\u4ee5\u907f\u514d\u6ed1\u5012\uff0c\u800c\u6674\u5929\u5219\u5141\u8bb8\u5168\u901f\u8d5b\u8dd1\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5728\u300a\u9a91\u9a6c\u6a21\u62df\u56683D\u300b\u4e2d\u5c06\u6211\u7684\u79fb\u52a8\u7248\u8fdb\u5ea6\u8f6c\u79fb\u5230\u7535\u8111\u7248\u5417\uff1f", "answer": "\u662f\u7684\uff0c\u4f60\u53ef\u4ee5\u5728\u300a\u9a91\u9a6c\u6a21\u62df\u56683D\u300b\u4e2d\u5c06\u79fb\u52a8\u7248\u8fdb\u5ea6\u8f6c\u79fb\u5230\u7535\u8111\u7248\u3002\u6b65\u9aa4\u4e00\uff1a\u786e\u4fdd\u4f60\u5728\u4e24\u4e2a\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u8d26\u6237\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u6e38\u620f\u8bbe\u7f6e\u4e2d\u7684\u201c\u4e91\u4fdd\u5b58\u201d\u529f\u80fd\u5c06\u4f60\u79fb\u52a8\u8bbe\u5907\u4e0a\u7684\u8fdb\u5ea6\u4e0a\u4f20\u3002\u6b65\u9aa4\u4e09\uff1a\u5728\u7535\u8111\u7248\u672c\u4e0a\uff0c\u9009\u62e9\u201c\u4e91\u52a0\u8f7d\u201d\u4ee5\u4e0b\u8f7d\u4f60\u7684\u5b58\u6863\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\u89e3\u5f00\u4e86\u963f\u62c9\u4f2f\u9a6c\uff0c\u5219\u8f6c\u79fb\u540e\u5b83\u5c06\u5728\u7535\u8111\u4e0a\u53ef\u7528\u3002"}, {"question": "\u5728\u300a\u9a91\u9a6c\u6a21\u62df\u56683D\u300b\u4e2d\u5feb\u901f\u5347\u7ea7\u7684\u6700\u6709\u6548\u65b9\u6cd5\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300a\u9a91\u9a6c\u6a21\u62df\u56683D\u300b\u4e2d\u5feb\u901f\u5347\u7ea7\u6d89\u53ca\u4e13\u6ce8\u4e8e\u9ad8\u7ecf\u9a8c\u503c\u7684\u6d3b\u52a8\u3002\u6b65\u9aa4\u4e00\uff1a\u5b8c\u6210\u4e3b\u8981\u6545\u4e8b\u4efb\u52a1\uff0c\u56e0\u4e3a\u5b83\u4eec\u4f1a\u63d0\u4f9b\u5927\u91cf\u7684\u7ecf\u9a8c\u503c\u5956\u52b1\u3002\u6b65\u9aa4\u4e8c\uff1a\u53c2\u4e0e\u7ade\u4e89\u6027\u6bd4\u8d5b\uff0c\u8d62\u5f97\u6bd4\u8d5b\u53ef\u4ee5\u83b7\u5f97\u989d\u5916\u7684\u7ecf\u9a8c\u503c\u5956\u52b1\u3002\u6b65\u9aa4\u4e09\uff1a\u53c2\u4e0e\u6bcf\u65e5\u6311\u6218\uff0c\u8fd9\u4e9b\u6311\u6218\u6bcf 24 \u5c0f\u65f6\u91cd\u7f6e\u4e00\u6b21\uff0c\u5e76\u63d0\u4f9b\u7ecf\u9a8c\u503c\u63d0\u5347\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5927\u5956\u8d5b\u201d\u6d3b\u52a8\u4e2d\u8d62\u5f97\u4e00\u573a\u6bd4\u8d5b\u53ef\u4ee5\u7ed9\u4f60\u63d0\u4f9b 500 \u70b9\u7ecf\u9a8c\u503c\uff0c\u663e\u8457\u63d0\u5347\u4f60\u7684\u7b49\u7ea7\u3002"}, {"question": "\u5728\u300a\u9a91\u9a6c\u6a21\u62df\u56683D\u300b\u4e2d\u662f\u5426\u5b58\u5728\u4efb\u4f55\u9690\u85cf\u7684\u5f69\u86cb\uff1f", "answer": "\u662f\u7684\uff0c\u300a\u9a91\u9a6c\u6a21\u62df\u56683D\u300b\u4e2d\u6709\u4e00\u4e9b\u9690\u85cf\u7684\u5f69\u86cb\u3002\u4e00\u4e2a\u663e\u8457\u7684\u4f8b\u5b50\u662f\u9690\u85cf\u5728\u6d1e\u7a74\u533a\u57df\u7684\u201c\u91d1\u8272\u9a6c\u8e44\u94c1\u201d\u3002\u8981\u627e\u5230\u5b83\uff0c\u8bf7\u5bfc\u822a\u5230\u6d1e\u7a74\u7684\u540e\u9762\u5e76\u4e0e\u53d1\u5149\u7684\u5ca9\u77f3\u4e92\u52a8\u3002\u53e6\u4e00\u4e2a\u5f69\u86cb\u662f\u68ee\u6797\u4e2d\u7684\u201c\u795e\u79d8\u55b7\u6cc9\u201d\uff0c\u5f53\u6fc0\u6d3b\u5b83\u65f6\uff0c\u5b83\u4f1a\u5468\u56f4\u4ea7\u751f\u7a00\u6709\u7269\u54c1\u3002\u8fd9\u4e9b\u9690\u85cf\u7684\u529f\u80fd\u4e3a\u52e4\u594b\u7684\u73a9\u5bb6\u589e\u52a0\u4e86\u989d\u5916\u7684\u63a2\u7d22\u548c\u5956\u52b1\u3002"}]
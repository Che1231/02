[{"question": "\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001\u30db\u30fc\u30b9\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc3D\u3067\u81ea\u5206\u306e\u99ac\u3092\u3069\u306e\u3088\u3046\u306b\u5236\u5fa1\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30db\u30fc\u30b9\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc3D\u3067\u99ac\u3092\u5236\u5fa1\u3059\u308b\u306e\u306f\u7c21\u5358\u3067\u3059\u3002\u753b\u9762\u5de6\u5074\u306e\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u3092\u4f7f\u7528\u3057\u3066\u3001\u99ac\u3092\u3042\u3089\u3086\u308b\u65b9\u5411\u306b\u52d5\u304b\u3057\u307e\u3059\u3002\u53f3\u5074\u306e\u30dc\u30bf\u30f3\u3067\u30b8\u30e3\u30f3\u30d7\u3001\u75be\u8d70\u3001\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3068\u306e\u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3\u306a\u3069\u306e\u64cd\u4f5c\u3092\u5b9f\u884c\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d5\u30a7\u30f3\u30b9\u3092\u30b8\u30e3\u30f3\u30d7\u3059\u308b\u306b\u306f\u3001\u969c\u5bb3\u7269\u306b\u8fd1\u3065\u304f\u969b\u306b\u30b8\u30e3\u30f3\u30d7\u30dc\u30bf\u30f3\u3092\u30bf\u30c3\u30d7\u3059\u308b\u3060\u3051\u3067\u3059\u3002\u958b\u3051\u305f\u5834\u6240\u3067\u7df4\u7fd2\u3057\u3066\u3001\u64cd\u4f5c\u306b\u6163\u308c\u308b\u3053\u3068\u3092\u304a\u52e7\u3081\u3057\u307e\u3059\u3002"}, {"question": "\u30db\u30fc\u30b9\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc3D\u3067\u30b3\u30a4\u30f3\u3092\u52b9\u7387\u7684\u306b\u7372\u5f97\u3059\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30db\u30fc\u30b9\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc3D\u3067\u30b3\u30a4\u30f3\u3092\u52b9\u7387\u7684\u306b\u7372\u5f97\u3059\u308b\u306b\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u91cd\u8981\u306a\u6226\u7565\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6bce\u65e5\u767a\u751f\u3059\u308b\u30af\u30a8\u30b9\u30c8\u3092\u5b8c\u4e86\u3057\u3001\u591a\u304f\u306e\u30b3\u30a4\u30f3\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30ec\u30fc\u30b9\u3084\u30df\u30cb\u30b2\u30fc\u30e0\u306b\u53c2\u52a0\u3057\u3001\u8fc5\u901f\u306a\u30b3\u30a4\u30f3\u7372\u5f97\u3092\u76ee\u6307\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30de\u30c3\u30d7\u3092\u5fb9\u5e95\u7684\u306b\u63a2\u7d22\u3057\u3066\u3001\u30b3\u30a4\u30f3\u304c\u5165\u3063\u3066\u3044\u308b\u96a0\u3055\u308c\u305f\u5b9d\u7bb1\u3092\u898b\u3064\u3051\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u68ee\u30a8\u30ea\u30a2\u306e\u6edd\u8fd1\u304f\u306e\u5b9d\u7bb1\u306b\u306f\u5e38\u306b50\u500b\u306e\u30b3\u30a4\u30f3\u304c\u5165\u3063\u3066\u3044\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u65b9\u6cd5\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3001\u30b3\u30a4\u30f3\u7372\u5f97\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30db\u30fc\u30b9\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc3D\u3067\u6700\u9069\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5f97\u308b\u305f\u3081\u306b\u3001\u3069\u306e\u8a2d\u5b9a\u3092\u8abf\u6574\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30db\u30fc\u30b9\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc3D\u3067\u6700\u9069\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5f97\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u8a2d\u5b9a\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u30c7\u30d0\u30a4\u30b9\u3067\u30e9\u30b0\u304c\u767a\u751f\u3059\u308b\u5834\u5408\u306f\u3001\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u54c1\u8cea\u3092\u4e0b\u3052\u307e\u3059\u3002\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u3067\u300c\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u30e2\u30fc\u30c9\u300d\u3092\u6709\u52b9\u306b\u3057\u3066\u3001\u30b9\u30e0\u30fc\u30ba\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u8996\u899a\u7684\u306a\u5fe0\u5b9f\u5ea6\u306b\u512a\u5148\u3055\u305b\u307e\u3059\u3002\u307e\u305f\u3001\u5e83\u5927\u306a\u30aa\u30fc\u30d7\u30f3\u30a8\u30ea\u30a2\u3067\u30d5\u30ec\u30fc\u30e0\u30c9\u30ed\u30c3\u30d7\u304c\u767a\u751f\u3059\u308b\u5834\u5408\u306f\u3001\u63cf\u753b\u8ddd\u96e2\u3092\u7e2e\u5c0f\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u4e2d\u7a0b\u5ea6\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u306f\u3001\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u3092\u300c\u4e2d\u300d\u306b\u3001\u63cf\u753b\u8ddd\u96e2\u3092\u300c\u666e\u901a\u300d\u306b\u8a2d\u5b9a\u3059\u308b\u3068\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u4f53\u9a13\u304c\u5f97\u3089\u308c\u307e\u3059\u3002"}, {"question": "\u30db\u30fc\u30b9\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc3D\u3067\u30b9\u30bf\u30df\u30ca\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u306a\u305c\u91cd\u8981\u3067\u3059\u304b\uff1f", "answer": "\u30db\u30fc\u30b9\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc3D\u3067\u30b9\u30bf\u30df\u30ca\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u9577\u6642\u9593\u306e\u6d3b\u52d5\u306b\u3068\u3063\u3066\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u75be\u8d70\u3084\u6fc0\u3057\u3044\u30a2\u30af\u30b7\u30e7\u30f3\u3092\u884c\u3046\u3068\u3001\u30b9\u30bf\u30df\u30ca\u304c\u6d88\u8cbb\u3055\u308c\u307e\u3059\u3002\u6d88\u8cbb\u3055\u308c\u308b\u3068\u3001\u99ac\u306e\u52d5\u304d\u306f\u5927\u5e45\u306b\u9045\u304f\u306a\u308a\u307e\u3059\u3002\u30b9\u30bf\u30df\u30ca\u3092\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3059\u308b\u306b\u306f\u3001\u75be\u8d70\u3068\u6b69\u884c\u3092\u4ea4\u4e92\u306b\u884c\u3044\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30fc\u30b9\u4e2d\u306b\u3001\u77ed\u3044\u75be\u8d70\u3068\u30b9\u30bf\u30df\u30ca\u56de\u5fa9\u306e\u305f\u3081\u306e\u6b69\u884c\u3092\u7e70\u308a\u8fd4\u3057\u307e\u3057\u3087\u3046\u3002\u3053\u306e\u6226\u7565\u306b\u3088\u308a\u3001\u99ac\u306f\u75b2\u52b4\u3059\u308b\u3053\u3068\u306a\u304f\u3001\u5b89\u5b9a\u3057\u305f\u30da\u30fc\u30b9\u3092\u7dad\u6301\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30db\u30fc\u30b9\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc3D\u3067\u3059\u3079\u3066\u306e\u99ac\u306e\u54c1\u7a2e\u3092\u3069\u306e\u3088\u3046\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30db\u30fc\u30b9\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc3D\u3067\u3059\u3079\u3066\u306e\u99ac\u306e\u54c1\u7a2e\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u306b\u306f\u3001\u30b2\u30fc\u30e0\u5185\u30a2\u30c1\u30fc\u30d6\u30e1\u30f3\u30c8\u3068\u30b3\u30a4\u30f3\u306e\u4f7f\u7528\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u7279\u5b9a\u306e\u30a2\u30c1\u30fc\u30d6\u30e1\u30f3\u30c8\u3092\u5b8c\u4e86\u3057\u307e\u3059\u3002\u300c10\u30ec\u30fc\u30b9\u52dd\u5229\u300d\u306a\u3069\u3001\u30a2\u30ef\u30d6\u306e\u99ac\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30af\u30a8\u30b9\u30c8\u3084\u30ec\u30fc\u30b9\u3067\u7372\u5f97\u3057\u305f\u30b3\u30a4\u30f3\u3092\u4f7f\u7528\u3057\u3066\u3001\u30b2\u30fc\u30e0\u5185\u30b9\u30c8\u30a2\u304b\u3089\u54c1\u7a2e\u3092\u8cfc\u5165\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u671f\u9593\u9650\u5b9a\u30a4\u30d9\u30f3\u30c8\u306b\u53c2\u52a0\u3057\u3001\u9650\u5b9a\u54c1\u7a2e\u3092\u5831\u916c\u3068\u3057\u3066\u7372\u5f97\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u300c\u30a6\u30a3\u30f3\u30bf\u30fc\u30d5\u30a7\u30b9\u30c6\u30a3\u30d0\u30eb\u300d\u30a4\u30d9\u30f3\u30c8\u3067\u306f\u3001\u30a4\u30d9\u30f3\u30c8\u671f\u9593\u4e2d\u306e\u307f\u5165\u624b\u53ef\u80fd\u306a\u30e6\u30cb\u30fc\u30af\u306a\u54c1\u7a2e\u304c\u63d0\u4f9b\u3055\u308c\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30db\u30fc\u30b9\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc3D\u306e\u3055\u307e\u3056\u307e\u306a\u5730\u5f62\u9593\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30db\u30fc\u30b9\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc3D\u306e\u3055\u307e\u3056\u307e\u306a\u5730\u5f62\u306f\u3001\u99ac\u306e\u79fb\u52d5\u3068\u30b9\u30bf\u30df\u30ca\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u8349\u539f\u306f\u5e73\u5766\u3067\u969c\u5bb3\u7269\u304c\u5c11\u306a\u3044\u305f\u3081\u3001\u521d\u5fc3\u8005\u306b\u3068\u3063\u3066\u7406\u60f3\u7684\u3067\u3059\u3002\u68ee\u306f\u3088\u308a\u6311\u6226\u7684\u306a\u9053\u3068\u96a0\u3055\u308c\u305f\u5831\u916c\u3092\u63d0\u4f9b\u3057\u307e\u3059\u304c\u3001\u99ac\u3092\u9045\u304f\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u5c71\u306f\u6025\u306a\u659c\u9762\u304c\u3042\u308b\u305f\u3081\u3001\u614e\u91cd\u306a\u30ca\u30d3\u30b2\u30fc\u30b7\u30e7\u30f3\u3068\u30b9\u30bf\u30df\u30ca\u7ba1\u7406\u304c\u5fc5\u8981\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u68ee\u6797\u5730\u5e2f\u3092\u6a2a\u65ad\u3059\u308b\u3068\u3001\u96a0\u3055\u308c\u305f\u5b9d\u7bb1\u304c\u898b\u3064\u304b\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u304c\u3001\u8349\u539f\u3068\u6bd4\u8f03\u3057\u3066\u99ac\u306e\u30b9\u30bf\u30df\u30ca\u306f\u3088\u308a\u65e9\u304f\u6d88\u8cbb\u3055\u308c\u307e\u3059\u3002"}, {"question": "\u6c17\u8c61\u30b7\u30b9\u30c6\u30e0\u306f\u30db\u30fc\u30b9\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc3D\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30db\u30fc\u30b9\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc3D\u306e\u6c17\u8c61\u30b7\u30b9\u30c6\u30e0\u306f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u30c0\u30a4\u30ca\u30df\u30c3\u30af\u306a\u5c64\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002\u96e8\u306f\u8996\u754c\u3092\u60aa\u5316\u3055\u305b\u3001\u8def\u9762\u3092\u6ed1\u308a\u3084\u3059\u304f\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u305d\u306e\u305f\u3081\u3001\u614e\u91cd\u306a\u79fb\u52d5\u304c\u5fc5\u8981\u3067\u3059\u3002\u96ea\u306f\u99ac\u306e\u901f\u5ea6\u3092\u4f4e\u4e0b\u3055\u305b\u3001\u30b9\u30bf\u30df\u30ca\u6d88\u8cbb\u3092\u5897\u5927\u3055\u305b\u307e\u3059\u3002\u6674\u5929\u306f\u8996\u754c\u304c\u30af\u30ea\u30a2\u3067\u5730\u5f62\u304c\u5b89\u5b9a\u3057\u3066\u3044\u308b\u305f\u3081\u3001\u63a2\u7d22\u3084\u30ec\u30fc\u30b9\u306b\u6700\u9069\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u96e8\u306e\u65e5\u306b\u30ec\u30fc\u30b9\u3092\u3057\u3066\u3044\u308b\u3068\u3001\u6ed1\u308a\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u30b3\u30fc\u30ca\u30fc\u3067\u901f\u5ea6\u3092\u843d\u3068\u3059\u5fc5\u8981\u304c\u3042\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u4e00\u65b9\u3001\u6674\u5929\u3067\u306f\u30d5\u30eb\u30b9\u30d4\u30fc\u30c9\u3067\u30ec\u30fc\u30b9\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30e2\u30d0\u30a4\u30eb\u7248\u304b\u3089PC\u7248\u306b\u30db\u30fc\u30b9\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc3D\u306e\u9032\u884c\u72b6\u6cc1\u3092\u79fb\u884c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30db\u30fc\u30b9\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc3D\u3067\u306f\u30e2\u30d0\u30a4\u30eb\u7248\u304b\u3089PC\u7248\u306b\u9032\u884c\u72b6\u6cc1\u3092\u79fb\u884c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b2\u30fc\u30e0\u306e\u8a2d\u5b9a\u3067\u300c\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u300d\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u3001\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u304b\u3089\u9032\u884c\u72b6\u6cc1\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1aPC\u7248\u3067\u300c\u30af\u30e9\u30a6\u30c9\u8aad\u307f\u8fbc\u307f\u300d\u3092\u9078\u629e\u3057\u3066\u3001\u4fdd\u5b58\u3055\u308c\u305f\u9032\u884c\u72b6\u6cc1\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30e2\u30d0\u30a4\u30eb\u7248\u3067\u30a2\u30e9\u30d6\u99ac\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u3066\u3044\u308b\u5834\u5408\u3001\u8ee2\u9001\u5f8c\u3001PC\u7248\u3067\u3082\u5229\u7528\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30db\u30fc\u30b9\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc3D\u3067\u7d20\u65e9\u304f\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u3059\u308b\u305f\u3081\u306e\u6700\u3082\u52b9\u679c\u7684\u306a\u65b9\u6cd5\u306f\uff1f", "answer": "\u30db\u30fc\u30b9\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc3D\u3067\u7d20\u65e9\u304f\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u3059\u308b\u306b\u306f\u3001\u9ad8XP\u306e\u6d3b\u52d5\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30e1\u30a4\u30f3\u30b9\u30c8\u30fc\u30ea\u30fc\u30af\u30a8\u30b9\u30c8\u3092\u5b8c\u4e86\u3057\u3001\u91cd\u8981\u306aXP\u5831\u916c\u3092\u7372\u5f97\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u7af6\u4e89\u30ec\u30fc\u30b9\u306b\u53c2\u52a0\u3057\u3001\u52dd\u5229\u3067\u30dc\u30fc\u30ca\u30b9XP\u3092\u7372\u5f97\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d73\uff1a24\u6642\u9593\u3054\u3068\u306b\u30ea\u30bb\u30c3\u30c8\u3055\u308c\u308b\u30c7\u30a4\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u306b\u53c2\u52a0\u3057\u3001XP\u30d6\u30fc\u30b9\u30c8\u3092\u7372\u5f97\u3057\u307e\u3057\u3087\u3046\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30b0\u30e9\u30f3\u30c9\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u30b7\u30c3\u30d7\u300d\u30a4\u30d9\u30f3\u30c8\u3067\u30ec\u30fc\u30b9\u306b\u52dd\u5229\u3059\u308b\u3068\u3001\u30ec\u30d9\u30eb\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b500XP\u3092\u7372\u5f97\u3067\u304d\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30db\u30fc\u30b9\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc3D\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30db\u30fc\u30b9\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc3D\u306b\u306f\u3044\u304f\u3064\u304b\u306e\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u3042\u308a\u307e\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u4f8b\u3068\u3057\u3066\u306f\u3001\u6d1e\u7a9f\u30a8\u30ea\u30a2\u306b\u3042\u308b\u300c\u30b4\u30fc\u30eb\u30c7\u30f3\u30db\u30fc\u30b9\u30b7\u30e5\u30fc\u300d\u304c\u3042\u308a\u307e\u3059\u3002\u6d1e\u7a9f\u306e\u5965\u306b\u79fb\u52d5\u3057\u3001\u5149\u308b\u5ca9\u3068\u5bfe\u8a71\u3059\u308b\u3053\u3068\u3067\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3082\u30461\u3064\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3001\u68ee\u306b\u3042\u308b\u300c\u30df\u30b9\u30c6\u30ea\u30fc\u30d5\u30a1\u30a6\u30f3\u30c6\u30f3\u300d\u3067\u3059\u3002\u3053\u308c\u3092\u8d77\u52d5\u3059\u308b\u3068\u3001\u305d\u306e\u5468\u308a\u306b\u51fa\u73fe\u3059\u308b\u30ec\u30a2\u30a2\u30a4\u30c6\u30e0\u3082\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u96a0\u3055\u308c\u305f\u8981\u7d20\u306f\u3001\u71b1\u5fc3\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u305f\u3081\u306b\u3001\u3055\u3089\u306a\u308b\u63a2\u7d22\u3068\u5831\u916c\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002"}]
[{"question": "\ucd08\ubcf4\uc790\ub85c\uc11c \ub9d0 \uc2dc\ubbac\ub808\uc774\ud130 3D\uc5d0\uc11c \ub9d0\uc744 \uc5b4\ub5bb\uac8c \uc81c\uc5b4\ud569\ub2c8\uae4c?", "answer": "\ub9d0 \uc2dc\ubbac\ub808\uc774\ud130 3D\uc5d0\uc11c \ub9d0\uc744 \uc81c\uc5b4\ud558\ub294 \uac83\uc740 \uac04\ub2e8\ud569\ub2c8\ub2e4. \ud654\uba74 \uc67c\ucabd\uc758 \uc870\uc774\uc2a4\ud2f1\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub9d0\uc744 \uc6d0\ud558\ub294 \ubc29\ud5a5\uc73c\ub85c \uc774\ub3d9\uc2dc\ud0a4\uc2ed\uc2dc\uc624. \uc624\ub978\ucabd \ubc84\ud2bc\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc810\ud504, \uc9c8\uc8fc \ubc0f \ubb3c\uccb4\uc640\uc758 \uc0c1\ud638 \uc791\uc6a9\uacfc \uac19\uc740 \uc791\uc5c5\uc744 \uc218\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc6b8\ud0c0\ub9ac \uc704\ub85c \uc810\ud504\ud558\ub824\uba74 \uc7a5\uc560\ubb3c\uc5d0 \uc811\uadfc\ud558\ub294 \ub3d9\uc548 \uc810\ud504 \ubc84\ud2bc\uc744 \ub204\ub974\uc2ed\uc2dc\uc624. \ub113\uc740 \ub4e4\ud310\uc5d0\uc11c \uc5f0\uc2b5\ud558\uc5ec \ucee8\ud2b8\ub864\uc5d0 \uc775\uc219\ud574\uc9c0\uc138\uc694."}, {"question": "\ub9d0 \uc2dc\ubbac\ub808\uc774\ud130 3D\uc5d0\uc11c \ub3d9\uc804\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \ud68d\ub4dd\ud558\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub9d0 \uc2dc\ubbac\ub808\uc774\ud130 3D\uc5d0\uc11c \ub3d9\uc804\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \ud68d\ub4dd\ud558\ub294 \ub370\ub294 \uba87 \uac00\uc9c0 \uc8fc\uc694 \uc804\ub7b5\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \ub9e4\uc77c \ud018\uc2a4\ud2b8\ub97c \uc644\ub8cc\ud558\uba74 \uc885\uc885 \uc0c1\ub2f9\ub7c9\uc758 \ub3d9\uc804\uc73c\ub85c \ubcf4\uc0c1\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 2: \uacbd\uc8fc \ubc0f \ubbf8\ub2c8 \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud558\uba74 \ube60\ub974\uac8c \ub3d9\uc804\uc744 \ud68d\ub4dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc9c0\ub3c4\ub97c \ucca0\uc800\ud788 \ud0d0\ud5d8\ud558\uc5ec \ub3d9\uc804\uc774 \ub4e4\uc5b4 \uc788\ub294 \uc228\uaca8\uc9c4 \uc0c1\uc790\ub97c \ucc3e\uc73c\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc232 \uc9c0\uc5ed\uc758 \ud3ed\ud3ec \uadfc\ucc98 \uc0c1\uc790\uc5d0\ub294 \ud56d\uc0c1 50\uac1c\uc758 \ub3d9\uc804\uc774 \ub4e4\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ubc29\ubc95\uc744 \uacb0\ud569\ud558\uba74 \ub3d9\uc804 \uc218\uc785\uc744 \uadf9\ub300\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub9d0 \uc2dc\ubbac\ub808\uc774\ud130 3D\uc5d0\uc11c \ucd5c\uc801\uc758 \uc131\ub2a5\uc744 \uc704\ud574 \uc5b4\ub5a4 \uc124\uc815\uc744 \uc870\uc815\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\ub9d0 \uc2dc\ubbac\ub808\uc774\ud130 3D\uc5d0\uc11c \ucd5c\uc801\uc758 \uc131\ub2a5\uc744 \uc704\ud574 \ub2e4\uc74c \uc124\uc815\uc744 \uc870\uc815\ud558\uc2ed\uc2dc\uc624. \uc7a5\uce58\uc5d0\uc11c \uc9c0\uc5f0\uc774 \ubc1c\uc0dd\ud558\uba74 \uadf8\ub798\ud53d \ud488\uc9c8\uc744 \ub0ae\ucd94\uc2ed\uc2dc\uc624. \uc2dc\uac01\uc801 \uc815\ud655\uc131\ubcf4\ub2e4 \uc6d0\ud65c\ud55c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc6b0\uc120\uc2dc\ud558\ub824\uba74 \uc124\uc815 \uba54\ub274\uc5d0\uc11c '\uc131\ub2a5 \ubaa8\ub4dc'\ub97c \ud65c\uc131\ud654\ud558\uc2ed\uc2dc\uc624. \ub610\ud55c, \ud070 \uac1c\ubc29 \uacf5\uac04\uc5d0\uc11c \ud504\ub808\uc784 \ub4dc\ub86d\uc774 \ubc1c\uc0dd\ud558\uba74 \uadf8\ub9bc\uc790 \uac70\ub9ac\ub97c \uc904\uc774\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc911\uac04 \ubc94\uc704\uc758 \uae30\uae30\uc5d0\uc11c\ub294 \uadf8\ub798\ud53d\uc744 '\uc911\uac04'\uc73c\ub85c, \uadf8\ub9bc\uc790 \uac70\ub9ac\ub97c '\ubcf4\ud1b5'\uc73c\ub85c \uc124\uc815\ud558\uba74 \uade0\ud615 \uc7a1\ud78c \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}, {"question": "\ub9d0 \uc2dc\ubbac\ub808\uc774\ud130 3D\uc5d0\uc11c \uc9c0\uad6c\ub825 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub9d0 \uc2dc\ubbac\ub808\uc774\ud130 3D\uc5d0\uc11c \uc9c0\uad6c\ub825 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \uc7a5\uc2dc\uac04 \ud65c\ub3d9\uc744 \uc704\ud574 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc9c8\uc8fc \ub610\ub294 \uaca9\ub82c\ud55c \ud589\ub3d9\uc744 \uc218\ud589\ud558\uba74 \uc9c0\uad6c\ub825\uc774 \uc18c\ubaa8\ub429\ub2c8\ub2e4. \uc18c\ubaa8\ub418\uba74 \ub9d0\uc758 \uc18d\ub3c4\uac00 \ud06c\uac8c \ub5a8\uc5b4\uc9d1\ub2c8\ub2e4. \uc9c0\uad6c\ub825\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub824\uba74 \uc9c8\uc8fc\uc640 \uac77\uae30\ub97c \ubc88\uac08\uc544 \uac00\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uacbd\uc8fc \uc911\uc5d0\ub294 \uc9e7\uc740 \uc21c\uac04 \uc9c8\uc8fc\ud558\uace0 \uc9c0\uad6c\ub825\uc744 \ud68c\ubcf5\ud558\uae30 \uc704\ud574 \uac77\uc73c\uc138\uc694. \uc774 \uc804\ub7b5\uc744 \ud1b5\ud574 \ub9d0\uc774 \uc9c0\uccd0 \uc4f0\ub7ec\uc9c0\uc9c0 \uc54a\uace0 \uafb8\uc900\ud55c \uc18d\ub3c4\ub97c \uc720\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub9d0 \uc2dc\ubbac\ub808\uc774\ud130 3D\uc5d0\uc11c \ubaa8\ub4e0 \ub9d0 \uc885\uc744 \uc5b4\ub5bb\uac8c \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub9d0 \uc2dc\ubbac\ub808\uc774\ud130 3D\uc5d0\uc11c \ubaa8\ub4e0 \ub9d0 \uc885\uc744 \ud574\uc81c\ud558\ub824\uba74 \uac8c\uc784 \ub0b4 \uc131\ucde8\ub3c4\uc640 \ub3d9\uc804 \uc0ac\uc6a9\uc744 \uacb0\ud569\ud574\uc57c \ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: '10\ud68c \uacbd\uc8fc \uc6b0\uc2b9'\uacfc \uac19\uc740 \ud2b9\uc815 \uc131\ucde8\ub3c4\ub97c \uc644\ub8cc\ud558\uc5ec \uc544\ub77c\ube44\uc548 \ub9d0\uc744 \ud574\uc81c\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ud018\uc2a4\ud2b8\uc640 \uacbd\uc8fc\uc5d0\uc11c \ud68d\ub4dd\ud55c \ub3d9\uc804\uc744 \uc0ac\uc6a9\ud558\uc5ec \uac8c\uc784 \ub0b4 \uc0c1\uc810\uc5d0\uc11c \ub9d0 \uc885\uc744 \uad6c\ub9e4\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc774\ubca4\ud2b8 \uae30\uac04 \ub3d9\uc548 \ub3c5\uc810\uc801\uc778 \ub9d0 \uc885\uc744 \ubcf4\uc0c1\uc73c\ub85c \uc81c\uacf5\ud558\ub294 \uacc4\uc808 \uc774\ubca4\ud2b8\uc5d0 \ucc38\uc5ec\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uaca8\uc6b8 \ucd95\uc81c' \uc774\ubca4\ud2b8\uc5d0\ub294 \uc774\ubca4\ud2b8 \uae30\uac04 \ud55c\uc815\uc73c\ub85c \uc81c\uacf5\ub418\ub294 \uace0\uc720\ud55c \ub9d0 \uc885\uc774 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub9d0 \uc2dc\ubbac\ub808\uc774\ud130 3D\uc758 \ub2e4\uc591\ud55c \uc9c0\ud615 \uac04\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub9d0 \uc2dc\ubbac\ub808\uc774\ud130 3D\uc758 \ub2e4\uc591\ud55c \uc9c0\ud615\uc740 \ub9d0\uc758 \uc774\ub3d9 \ubc0f \uc9c0\uad6c\ub825\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ucd08\ubcf4\uc790\uc5d0\uac8c\ub294 \ud3c9\ud3c9\ud558\uace0 \uc7a5\uc560\ubb3c\uc774 \uc5c6\ub294 \ud2b9\uc131 \ub54c\ubb38\uc5d0 \ucd08\uc6d0\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \uc232\uc740 \uc228\uaca8\uc9c4 \ubcf4\uc0c1\uc774 \uc788\ub294 \ub354 \uc5b4\ub824\uc6b4 \uae38\uc744 \uc81c\uacf5\ud558\uc9c0\ub9cc \ub9d0\uc758 \uc18d\ub3c4\ub97c \ub2a6\ucd9c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc0b0\uc545 \uc9c0\ud615\uc740 \uac00\ud30c\ub978 \uacbd\uc0ac \ub54c\ubb38\uc5d0 \uc8fc\uc758 \uae4a\uc740 \ud0d0\uc0c9\uacfc \uc9c0\uad6c\ub825 \uad00\ub9ac\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc232 \uc9c0\ud615\uc744 \ud1b5\uacfc\ud558\uba74 \uc228\uaca8\uc9c4 \uc0c1\uc790\ub97c \ubc1c\uacac\ud560 \uc218 \uc788\uc9c0\ub9cc, \ub9d0\uc758 \uc9c0\uad6c\ub825\uc740 \ucd08\uc6d0\uc5d0 \ube44\ud574 \ub354 \ube68\ub9ac \uc18c\ubaa8\ub429\ub2c8\ub2e4."}, {"question": "\ub0a0\uc528 \uc2dc\uc2a4\ud15c\uc740 \ub9d0 \uc2dc\ubbac\ub808\uc774\ud130 3D\uc758 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ub9d0 \uc2dc\ubbac\ub808\uc774\ud130 3D\uc758 \ub0a0\uc528 \uc2dc\uc2a4\ud15c\uc740 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5ed\ub3d9\uc801\uc778 \uc694\uc18c\ub97c \ucd94\uac00\ud569\ub2c8\ub2e4. \ube44\ub294 \uc2dc\uc57c\ub97c \uac10\uc18c\uc2dc\ud0a4\uace0 \uae38\uc744 \ubbf8\ub044\ub7fd\uac8c \ub9cc\ub4e4 \uc218 \uc788\uc73c\ubbc0\ub85c \uc870\uc2ec\uc2a4\ub7ec\uc6b4 \uc774\ub3d9\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub208\uc740 \ub9d0\uc758 \uc18d\ub3c4\ub97c \ub2a6\ucd94\uace0 \uc9c0\uad6c\ub825 \uc18c\ubaa8\ub97c \uc99d\uac00\uc2dc\ud0b5\ub2c8\ub2e4. \ub9d1\uc740 \ub0a0\uc528\ub294 \ud0c1 \ud2b8\uc778 \uc2dc\uc57c\uc640 \uc548\uc815\uc801\uc778 \uc9c0\ud615 \ub54c\ubb38\uc5d0 \ud0d0\ud5d8\uacfc \uacbd\uc8fc\uc5d0 \uc774\uc0c1\uc801\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ube44\uac00 \uc624\ub294 \ub3d9\uc548 \uacbd\uc8fc\ub97c \ud560 \ub54c\ub294 \ubbf8\ub044\ub7ec\uc9d0\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \ucf54\ub108\uc5d0\uc11c \uc18d\ub3c4\ub97c \uc904\uc5ec\uc57c \ud558\uc9c0\ub9cc, \ub9d1\uc740 \ub0a0\uc528\uc5d0\ub294 \uc18d\ub3c4\ub97c \ub192\uc5ec \uacbd\uc8fc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub9d0 \uc2dc\ubbac\ub808\uc774\ud130 3D\uc5d0\uc11c \ubaa8\ubc14\uc77c \uc9c4\ud589 \uc0c1\ud669\uc744 PC\ub85c \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub124, \ub9d0 \uc2dc\ubbac\ub808\uc774\ud130 3D\uc5d0\uc11c \ubaa8\ubc14\uc77c \uc9c4\ud589 \uc0c1\ud669\uc744 PC\ub85c \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \ub450 \uc7a5\uce58 \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \uac8c\uc784 \uc124\uc815\uc5d0\uc11c '\ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5' \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ubaa8\ubc14\uc77c \uc7a5\uce58\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5c5\ub85c\ub4dc\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: PC \ubc84\uc804\uc5d0\uc11c '\ud074\ub77c\uc6b0\ub4dc \ubd88\ub7ec\uc624\uae30'\ub97c \uc120\ud0dd\ud558\uc5ec \uc800\uc7a5\ub41c \uc9c4\ud589 \uc0c1\ud669\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubaa8\ubc14\uc77c\uc5d0 \uc544\ub77c\ube44\uc548 \ub9d0\uc744 \ud574\uc81c\ud588\ub2e4\uba74 \uc774\uc804 \ud6c4 PC\uc5d0\uc11c\ub3c4 \uc774\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub9d0 \uc2dc\ubbac\ub808\uc774\ud130 3D\uc5d0\uc11c \ube60\ub974\uac8c \ub808\ubca8\uc5c5\ud558\ub294 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub9d0 \uc2dc\ubbac\ub808\uc774\ud130 3D\uc5d0\uc11c \ube60\ub974\uac8c \ub808\ubca8\uc5c5\ud558\ub294 \uac83\uc740 \uace0 XP \ud65c\ub3d9\uc5d0 \uc9d1\uc911\ud558\ub294 \uac83\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc8fc\uc694 \uc2a4\ud1a0\ub9ac \ud018\uc2a4\ud2b8\ub97c \uc644\ub8cc\ud558\uba74 \uc0c1\ub2f9\ud55c XP \ubcf4\uc0c1\uc744 \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 2: \uacbd\uc7c1 \uacbd\uc8fc\uc5d0 \ucc38\uc5ec\ud558\uc5ec \uc6b0\uc2b9 \ubcf4\ub108\uc2a4 XP\ub97c \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 3: \ub9e4 24\uc2dc\uac04\ub9c8\ub2e4 \uc7ac\uc124\uc815\ub418\ub294 \uc77c\uc77c \ucc4c\ub9b0\uc9c0\uc5d0 \ucc38\uc5ec\ud558\uc5ec XP \uc99d\uac00\ub97c \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uadf8\ub79c\ub4dc \ucc54\ud53c\uc5b8\uc2ed' \uc774\ubca4\ud2b8\uc5d0\uc11c \uacbd\uc8fc\ub97c \uc774\uae30\uba74 500 XP\ub97c \ubc1b\uc544 \ub808\ubca8\uc744 \ud06c\uac8c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub9d0 \uc2dc\ubbac\ub808\uc774\ud130 3D\uc5d0 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub124, \ub9d0 \uc2dc\ubbac\ub808\uc774\ud130 3D\uc5d0\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ub208\uc5d0 \ub744\ub294 \uc608\ub85c \ub3d9\uad74 \uc9c0\uc5ed\uc5d0 \uc228\uaca8\uc9c4 '\uace8\ub4e0 \ud6c4\uc288'\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ucc3e\uc73c\ub824\uba74 \ub3d9\uad74 \ub4a4\ucabd\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec \ube5b\ub098\ub294 \ubc14\uc704\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\uc2ed\uc2dc\uc624. \ub610 \ub2e4\ub978 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uc232\uc5d0 \uc788\ub294 '\ubbf8\uc2a4\ud14c\ub9ac \ubd84\uc218'\uc785\ub2c8\ub2e4. \ud65c\uc131\ud654\ud558\uba74 \uadf8 \uc8fc\ubcc0\uc5d0 \ud76c\uadc0\ud55c \ud488\ubaa9\uc774 \uc0dd\uc131\ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uae30\ub2a5\uc740 \uc131\uc2e4\ud55c \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ucd94\uac00\uc801\uc778 \ud0d0\ud5d8\uacfc \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}]
[{"question": "\u5982\u4f55\u63a7\u5236\u6211\u7684\u99ac\u5339\u5728\u300a\u99ac\u8853\u6a21\u64ec 3D\u300b\u904a\u6232\u4e2d\u4f5c\u70ba\u65b0\u624b\uff1f", "answer": "\u5728\u300a\u99ac\u8853\u6a21\u64ec 3D\u300b\u4e2d\u63a7\u5236\u60a8\u7684\u99ac\u5339\u975e\u5e38\u7c21\u55ae\u3002\u4f7f\u7528\u87a2\u5e55\u5de6\u908a\u7684\u6416\u687f\u4f86\u79fb\u52d5\u99ac\u5339\u5230\u4efb\u4f55\u65b9\u5411\u3002\u53f3\u5074\u7684\u6309\u9215\u5247\u5141\u8a31\u60a8\u57f7\u884c\u8df3\u8e8d\u3001\u75be\u99b3\u548c\u8207\u7269\u4ef6\u4e92\u52d5\u7b49\u52d5\u4f5c\u3002\u4f8b\u5982\uff0c\u70ba\u4e86\u8df3\u904e\u67f5\u6b04\uff0c\u53ea\u9700\u5728\u63a5\u8fd1\u969c\u7919\u7269\u6642\u9ede\u64ca\u8df3\u8e8d\u6309\u9215\u5373\u53ef\u3002\u5728\u7a7a\u66e0\u7684\u5340\u57df\u7df4\u7fd2\uff0c\u4ee5\u4fbf\u719f\u6089\u63a7\u5236\u65b9\u5f0f\u3002"}, {"question": "\u5728\u300a\u99ac\u8853\u6a21\u64ec 3D\u300b\u4e2d\u7372\u5f97\u786c\u5e63\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u300a\u99ac\u8853\u6a21\u64ec 3D\u300b\u4e2d\u6709\u6548\u7387\u5730\u7372\u5f97\u786c\u5e63\u9700\u8981\u4e00\u4e9b\u95dc\u9375\u7b56\u7565\u3002\u6b65\u9a5f\u4e00\uff1a\u5b8c\u6210\u6bcf\u65e5\u4efb\u52d9\uff0c\u9019\u4e9b\u4efb\u52d9\u901a\u5e38\u6703\u734e\u52f5\u5927\u91cf\u786c\u5e63\u3002\u6b65\u9a5f\u4e8c\uff1a\u53c3\u52a0\u8cfd\u4e8b\u548c\u5c0f\u578b\u904a\u6232\uff0c\u56e0\u70ba\u5b83\u5011\u6703\u63d0\u4f9b\u8fc5\u901f\u7684\u786c\u5e63\u63d0\u5347\u3002\u6b65\u9a5f\u4e09\uff1a\u5fb9\u5e95\u63a2\u7d22\u5730\u5716\u4ee5\u627e\u5230\u96b1\u85cf\u7684\u5bf6\u7bb1\uff0c\u9019\u4e9b\u5bf6\u7bb1\u5305\u542b\u786c\u5e63\u3002\u4f8b\u5982\uff0c\u68ee\u6797\u5340\u57df\u7011\u5e03\u9644\u8fd1\u7684\u5bf6\u7bb1\u7e3d\u662f\u5305\u542b 50 \u500b\u786c\u5e63\u3002\u7d50\u5408\u9019\u4e9b\u65b9\u6cd5\u5c07\u6700\u5927\u5316\u60a8\u7684\u786c\u5e63\u6536\u76ca\u3002"}, {"question": "\u5728\u300a\u99ac\u8853\u6a21\u64ec 3D\u300b\u4e2d\uff0c\u6211\u61c9\u8a72\u8abf\u6574\u54ea\u4e9b\u8a2d\u5b9a\u624d\u80fd\u7372\u5f97\u6700\u4f73\u6548\u80fd\uff1f", "answer": "\u78ba\u4fdd\u5728\u300a\u99ac\u8853\u6a21\u64ec 3D\u300b\u4e2d\u7372\u5f97\u6700\u4f73\u6548\u80fd\uff0c\u8acb\u8abf\u6574\u4e0b\u5217\u8a2d\u5b9a\uff1a\u5982\u679c\u60a8\u7684\u88dd\u7f6e\u51fa\u73fe\u5ef6\u9072\uff0c\u8acb\u964d\u4f4e\u5716\u5f62\u54c1\u8cea\u3002\u555f\u7528\u8a2d\u5b9a\u9078\u55ae\u4e2d\u7684\u300e\u6548\u80fd\u6a21\u5f0f\u300f\u4ee5\u512a\u5148\u8003\u616e\u9806\u66a2\u7684\u904a\u6232\u9ad4\u9a57\uff0c\u800c\u4e0d\u662f\u8996\u89ba\u4fdd\u771f\u5ea6\u3002\u6b64\u5916\uff0c\u5982\u679c\u60a8\u5728\u5927\u578b\u958b\u653e\u5340\u57df\u6ce8\u610f\u5230\u756b\u9762\u6389\u5e40\uff0c\u8acb\u6e1b\u5c11\u7e6a\u88fd\u8ddd\u96e2\u3002\u4f8b\u5982\uff0c\u5728\u4e2d\u6a94\u88dd\u7f6e\u4e0a\uff0c\u5c07\u5716\u5f62\u8a2d\u5b9a\u70ba\u300e\u4e2d\u7b49\u300f\uff0c\u7e6a\u88fd\u8ddd\u96e2\u8a2d\u5b9a\u70ba\u300e\u6b63\u5e38\u300f\uff0c\u5373\u53ef\u63d0\u4f9b\u5e73\u8861\u7684\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u4e86\u89e3\u300a\u99ac\u8853\u6a21\u64ec 3D\u300b\u4e2d\u7684\u9ad4\u529b\u7cfb\u7d71\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u4e86\u89e3\u300a\u99ac\u8853\u6a21\u64ec 3D\u300b\u4e2d\u7684\u9ad4\u529b\u7cfb\u7d71\u5c0d\u65bc\u9577\u6642\u9593\u6d3b\u52d5\u81f3\u95dc\u91cd\u8981\u3002\u7576\u60a8\u75be\u99b3\u6216\u57f7\u884c\u5287\u70c8\u52d5\u4f5c\u6642\uff0c\u9ad4\u529b\u6703\u8017\u76e1\u3002\u9ad4\u529b\u8017\u76e1\u5f8c\uff0c\u60a8\u7684\u99ac\u5339\u6703\u660e\u986f\u6e1b\u901f\u3002\u70ba\u6709\u6548\u7ba1\u7406\u9ad4\u529b\uff0c\u8acb\u5728\u75be\u99b3\u548c\u6b65\u884c\u4e4b\u9593\u4ea4\u66ff\u3002\u4f8b\u5982\uff0c\u5728\u8cfd\u4e8b\u671f\u9593\uff0c\u4ee5\u77ed\u66ab\u7684\u75be\u99b3\u548c\u6b65\u884c\u4f86\u6062\u5fa9\u9ad4\u529b\u3002\u6b64\u7b56\u7565\u53ef\u78ba\u4fdd\u60a8\u7684\u99ac\u5339\u4fdd\u6301\u7a69\u5b9a\u7684\u901f\u5ea6\uff0c\u800c\u4e0d\u6703\u7b4b\u75b2\u529b\u76e1\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u99ac\u8853\u6a21\u64ec 3D\u300b\u4e2d\u89e3\u9396\u6240\u6709\u99ac\u7a2e\uff1f", "answer": "\u5728\u300a\u99ac\u8853\u6a21\u64ec 3D\u300b\u4e2d\u89e3\u9396\u6240\u6709\u99ac\u7a2e\uff0c\u9700\u8981\u7d50\u5408\u904a\u6232\u6210\u5c31\u548c\u786c\u5e63\u652f\u51fa\u3002\u6b65\u9a5f\u4e00\uff1a\u5b8c\u6210\u7279\u5b9a\u6210\u5c31\uff0c\u4f8b\u5982\u300e\u8d0f\u5f97 10 \u5834\u8cfd\u4e8b\u300f\u4ee5\u89e3\u9396\u963f\u62c9\u4f2f\u99ac\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u5f9e\u4efb\u52d9\u548c\u8cfd\u4e8b\u4e2d\u7372\u5f97\u7684\u786c\u5e63\uff0c\u5f9e\u904a\u6232\u5167\u5546\u5e97\u8cfc\u8cb7\u99ac\u7a2e\u3002\u6b65\u9a5f\u4e09\uff1a\u53c3\u52a0\u5b63\u7bc0\u6027\u6d3b\u52d5\uff0c\u9019\u4e9b\u6d3b\u52d5\u6703\u63d0\u4f9b\u7368\u5bb6\u99ac\u7a2e\u4f5c\u70ba\u734e\u52f5\u3002\u4f8b\u5982\uff0c\u300e\u51ac\u5b63\u7bc0\u6176\u300f\u6d3b\u52d5\u901a\u5e38\u5305\u542b\u5728\u6d3b\u52d5\u671f\u9593\u7368\u5bb6\u63d0\u4f9b\u7684\u7368\u7279\u99ac\u7a2e\u3002"}, {"question": "\u300a\u99ac\u8853\u6a21\u64ec 3D\u300b\u4e2d\u5404\u7a2e\u5730\u5f62\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "\u300a\u99ac\u8853\u6a21\u64ec 3D\u300b\u4e2d\u7684\u4e0d\u540c\u5730\u5f62\u6703\u5f71\u97ff\u60a8\u7684\u99ac\u5339\u7684\u79fb\u52d5\u548c\u9ad4\u529b\u3002\u8349\u539f\u5c0d\u65bc\u521d\u5b78\u8005\u4f86\u8aaa\u975e\u5e38\u7406\u60f3\uff0c\u56e0\u70ba\u5176\u5e73\u5766\u4e14\u6c92\u6709\u969c\u7919\u3002\u68ee\u6797\u63d0\u4f9b\u66f4\u591a\u5177\u6709\u96b1\u85cf\u734e\u52f5\u7684\u5177\u6709\u6311\u6230\u6027\u7684\u8def\u5f91\uff0c\u4f46\u53ef\u80fd\u6703\u6e1b\u6162\u60a8\u7684\u99ac\u5339\u3002\u5c71\u5730\u9700\u8981\u4ed4\u7d30\u7684\u5c0e\u822a\u548c\u9ad4\u529b\u7ba1\u7406\uff0c\u56e0\u70ba\u5761\u5ea6\u9661\u5ced\u3002\u4f8b\u5982\uff0c\u7a7f\u8d8a\u68ee\u6797\u5730\u5f62\u53ef\u80fd\u6703\u767c\u73fe\u96b1\u85cf\u7684\u5bf6\u7bb1\uff0c\u4f46\u8207\u8349\u539f\u76f8\u6bd4\uff0c\u60a8\u7684\u99ac\u5339\u7684\u9ad4\u529b\u6703\u66f4\u5feb\u5730\u8017\u76e1\u3002"}, {"question": "\u5929\u6c23\u7cfb\u7d71\u5982\u4f55\u5728\u300a\u99ac\u8853\u6a21\u64ec 3D\u300b\u4e2d\u5f71\u97ff\u904a\u6232\uff1f", "answer": "\u300a\u99ac\u8853\u6a21\u64ec 3D\u300b\u4e2d\u7684\u5929\u6c23\u7cfb\u7d71\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u52d5\u614b\u5c64\u9762\u3002\u4e0b\u96e8\u6703\u964d\u4f4e\u80fd\u898b\u5ea6\uff0c\u4e26\u53ef\u80fd\u4f7f\u9053\u8def\u8b8a\u5f97\u6fd5\u6ed1\uff0c\u9700\u8981\u8b39\u614e\u7684\u79fb\u52d5\u3002\u4e0b\u96ea\u6703\u6e1b\u6162\u60a8\u7684\u99ac\u5339\u4e26\u589e\u52a0\u9ad4\u529b\u6d88\u8017\u3002\u6674\u5929\u975e\u5e38\u9069\u5408\u63a2\u7d22\u548c\u8cfd\u8dd1\uff0c\u56e0\u70ba\u80fd\u898b\u5ea6\u6e05\u6670\u4e14\u5730\u5f62\u7a69\u5b9a\u3002\u4f8b\u5982\uff0c\u5728\u96e8\u4e2d\u8cfd\u8dd1\u53ef\u80fd\u9700\u8981\u60a8\u5728\u8f49\u5f4e\u6642\u653e\u6162\u901f\u5ea6\u4ee5\u907f\u514d\u6ed1\u5012\uff0c\u800c\u6674\u5929\u5247\u5141\u8a31\u5168\u901f\u8cfd\u8dd1\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5728\u300a\u99ac\u8853\u6a21\u64ec 3D\u300b\u4e2d\u5c07\u624b\u6a5f\u7248\u9032\u5ea6\u8f49\u79fb\u5230\u96fb\u8166\u7248\u55ce\uff1f", "answer": "\u662f\u7684\uff0c\u60a8\u53ef\u4ee5\u5728\u300a\u99ac\u8853\u6a21\u64ec 3D\u300b\u4e2d\u5c07\u624b\u6a5f\u7248\u9032\u5ea6\u8f49\u79fb\u5230\u96fb\u8166\u7248\u3002\u6b65\u9a5f\u4e00\uff1a\u78ba\u4fdd\u60a8\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u90fd\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u3002\u6b65\u9a5f\u4e8c\uff1a\u4f7f\u7528\u904a\u6232\u8a2d\u5b9a\u4e2d\u7684\u300e\u96f2\u7aef\u5132\u5b58\u300f\u529f\u80fd\u5c07\u60a8\u7684\u624b\u6a5f\u7248\u9032\u5ea6\u4e0a\u50b3\u3002\u6b65\u9a5f\u4e09\uff1a\u5728\u96fb\u8166\u7248\u4e2d\uff0c\u9078\u64c7\u300e\u96f2\u7aef\u8f09\u5165\u300f\u4f86\u4e0b\u8f09\u60a8\u7684\u5132\u5b58\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5df2\u5728\u624b\u6a5f\u4e0a\u89e3\u9396\u963f\u62c9\u4f2f\u99ac\uff0c\u5247\u8f49\u79fb\u5f8c\u5b83\u5c07\u5728\u96fb\u8166\u4e0a\u53ef\u7528\u3002"}, {"question": "\u5728\u300a\u99ac\u8853\u6a21\u64ec 3D\u300b\u4e2d\u5feb\u901f\u63d0\u5347\u7b49\u7d1a\u7684\u6700\u6709\u6548\u65b9\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u300a\u99ac\u8853\u6a21\u64ec 3D\u300b\u4e2d\u5feb\u901f\u63d0\u5347\u7b49\u7d1a\uff0c\u9700\u8981\u5c08\u6ce8\u65bc\u9ad8\u7d93\u9a57\u503c\u7684\u6d3b\u52d5\u3002\u6b65\u9a5f\u4e00\uff1a\u5b8c\u6210\u4e3b\u8981\u6545\u4e8b\u4efb\u52d9\uff0c\u56e0\u70ba\u5b83\u5011\u6703\u63d0\u4f9b\u5927\u91cf\u7684\u7d93\u9a57\u503c\u734e\u52f5\u3002\u6b65\u9a5f\u4e8c\uff1a\u53c3\u52a0\u7af6\u722d\u6027\u8cfd\u8dd1\uff0c\u7372\u52dd\u53ef\u984d\u5916\u7372\u5f97\u7d93\u9a57\u503c\u3002\u6b65\u9a5f\u4e09\uff1a\u53c3\u8207\u6bcf\u65e5\u6311\u6230\uff0c\u9019\u4e9b\u6311\u6230\u6bcf 24 \u5c0f\u6642\u91cd\u7f6e\u4e00\u6b21\uff0c\u4e26\u63d0\u4f9b\u7d93\u9a57\u503c\u63d0\u5347\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5927\u8cfd\u51a0\u8ecd\u300f\u6d3b\u52d5\u4e2d\u7372\u52dd\u53ef\u4ee5\u7372\u5f97 500 \u9ede\u7d93\u9a57\u503c\uff0c\u986f\u8457\u63d0\u5347\u60a8\u7684\u7b49\u7d1a\u3002"}, {"question": "\u5728\u300a\u99ac\u8853\u6a21\u64ec 3D\u300b\u4e2d\u662f\u5426\u5b58\u5728\u4efb\u4f55\u96b1\u85cf\u7684\u5f69\u86cb\uff1f", "answer": "\u662f\u7684\uff0c\u300a\u99ac\u8853\u6a21\u64ec 3D\u300b\u5305\u542b\u4e00\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\u3002\u4e00\u500b\u503c\u5f97\u6ce8\u610f\u7684\u4f8b\u5b50\u662f\u96b1\u85cf\u5728\u6d1e\u7a74\u5340\u57df\u7684\u300e\u91d1\u8272\u99ac\u8e44\u9435\u300f\u3002\u70ba\u4e86\u627e\u5230\u5b83\uff0c\u8acb\u524d\u5f80\u6d1e\u7a74\u7684\u5f8c\u65b9\uff0c\u4e26\u8207\u767c\u5149\u5ca9\u77f3\u4e92\u52d5\u3002\u53e6\u4e00\u500b\u5f69\u86cb\u662f\u68ee\u6797\u5340\u57df\u7684\u300e\u795e\u79d8\u5674\u6cc9\u300f\uff0c\u7576\u555f\u52d5\u6642\uff0c\u5b83\u6703\u5728\u5468\u570d\u7522\u751f\u7a00\u6709\u7269\u54c1\u3002\u9019\u4e9b\u96b1\u85cf\u529f\u80fd\u70ba\u52e4\u596e\u7684\u73a9\u5bb6\u589e\u6dfb\u4e86\u984d\u5916\u7684\u63a2\u7d22\u548c\u734e\u52f5\u3002"}]
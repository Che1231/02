[{"question": "\u521d\u3081\u3066\u306e\u65b9\u3067\u3082\u3001Fun Water Sorting\u3092\u59cb\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Fun Water Sorting\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u307e\u305a\u30a2\u30d7\u30ea\u30b9\u30c8\u30a2\u304b\u3089\u30b2\u30fc\u30e0\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u5f8c\u3001\u30b2\u30fc\u30e0\u3092\u958b\u304d\u3001\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u306b\u5f93\u3044\u307e\u3059\u3002\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3067\u306f\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u65b9\u6cd5\u3092\u30ac\u30a4\u30c9\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30c1\u30e5\u30fc\u30d6\u3092\u30bf\u30c3\u30d7\u3057\u3066\u6c34\u3092\u30c1\u30e5\u30fc\u30d6\u9593\u3067\u9078\u629e\u3057\u3001\u6ce8\u3050\u65b9\u6cd5\u3092\u5b66\u3073\u307e\u3059\u3002\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3067\u306f\u3001\u8272\u4ed8\u304d\u306e\u6c34\u3092\u6df7\u305c\u308b\u3053\u3068\u306a\u304f\u3001\u7570\u306a\u308b\u30c1\u30e5\u30fc\u30d6\u306b\u5206\u985e\u3059\u308b\u3068\u3044\u3046\u76ee\u7684\u3082\u7d39\u4ecb\u3055\u308c\u307e\u3059\u3002\u3053\u306e\u521d\u671f\u6bb5\u968e\u306f\u3001\u30b2\u30fc\u30e0\u306e\u57fa\u672c\u7684\u306a\u6982\u5ff5\u3092\u7406\u89e3\u3059\u308b\u4e0a\u3067\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002"}, {"question": "Fun Water Sorting\u3067\u3001100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u30b2\u30fc\u30e0\u3092\u9032\u3081\u308b\u305f\u3081\u306e\u91cd\u8981\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u4ee5\u4e0b\u306e\u6226\u7565\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u304f\u3060\u3055\u3044\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u5404\u30c1\u30e5\u30fc\u30d6\u306e\u6700\u7d42\u72b6\u614b\u3092\u4e88\u6e2c\u3059\u308b\u3053\u3068\u3067\u3001\u624b\u9806\u3092\u8
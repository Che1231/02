[{"question": "\u5982\u4f55\u4f5c\u4e3a\u5b8c\u5168\u65b0\u624b\u5f00\u59cb\u73a9\"\u4e50\u8da3\u6c34\u6392\u5e8f\"\u6e38\u620f\uff1f", "answer": "\u8981\u5f00\u59cb\u73a9\"\u4e50\u8da3\u6c34\u6392\u5e8f\"\u6e38\u620f\uff0c\u9996\u5148\u9700\u8981\u4ece\u5e94\u7528\u5546\u5e97\u4e0b\u8f7d\u6e38\u620f\u3002\u5b89\u88c5\u540e\uff0c\u6253\u5f00\u6e38\u620f\uff0c\u6309\u7167\u6559\u7a0b\u8fdb\u884c\u64cd\u4f5c\uff0c\u8fd9\u5c06\u5f15\u5bfc\u4f60\u4e86\u89e3\u57fa\u672c\u7684\u6e38\u620f\u673a\u5236\u3002\u4f8b\u5982\uff0c\u4f60\u5c06\u5b66\u4e60\u5982\u4f55\u901a\u8fc7\u70b9\u51fb\u7ba1\u9053\u6765\u9009\u62e9\u548c\u5012\u6c34\u3002\u6559\u7a0b\u8fd8\u4f1a\u4ecb\u7ecd\u76ee\u6807\uff1a\u5c06\u5f69\u8272\u6c34\u5206\u7c7b\u5230\u4e0d\u540c\u7684\u7ba1\u9053\u4e2d\uff0c\u907f\u514d\u6df7\u5408\u3002\u8fd9\u4e00\u521d\u59cb\u6b65\u9aa4\u5bf9\u4e8e\u7406\u89e3\u6e38\u620f\u7684\u6838\u5fc3\u6982\u5ff5\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u5728\u73a9\u4e86\"\u4e50\u8da3\u6c34\u6392\u5e8f\"\u6e38\u620f100\u5c0f\u65f6\u540e\uff0c\u54ea\u4e9b\u662f\u63d0\u5347\u7684\u5173\u952e\u7b56\u7565\uff1f", "answer": "\u5728\u73a9\u4e86100\u5c0f\u65f6\u540e\uff0c\u8bf7\u5173\u6ce8\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9aa41- \u901a\u8fc7\u60f3\u8c61\u6bcf\u4e2a\u7ba1\u9053\u7684\u6700\u7ec8\u72b6\u6001\u6765\u89c4\u5212\u4f60\u7684\u52a8\u4f5c\u3002\u6b65\u9aa42- \u4f7f\u7528\u7a7a\u7ba1\u4f5c\u4e3a\u4e34\u65f6\u5b58\u50a8\uff0c\u907f\u514d\u989c\u8272\u6df7\u5408\u3002\u6b65\u9aa43- \u4f18\u5148\u89e3\u51b3\u53d7\u9650\u5236\u6700\u4e25\u91cd\u7684\u7ba1\u9053\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4e00\u4e2a\u7ba1\u9053\u53ea\u5269\u4e0b\u4e00\u79cd\u989c\u8272\uff0c\u8bf7\u7acb\u5373\u5b8c\u6210\u5b83\uff0c\u817e\u51fa\u7a7a\u95f4\u3002\u8fd9\u4e9b\u6b65\u9aa4\u5c06\u5e2e\u52a9\u4f60\u66f4\u9ad8\u6548\u5730\u5904\u7406\u590d\u6742\u5173\u5361\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\"\u4e50\u8da3\u6c34\u6392\u5e8f\"\u6e38\u620f\u7684\u4e00\u4e9b\u5173\u5361\u4f1a\u9650\u5236\u79fb\u52a8\u6b21\u6570\uff1f", "answer": "\"\u4e50\u8da3\u6c34\u6392\u5e8f\"\u6e38\u620f\u5728\u4e00\u4e9b\u5173\u5361\u4e2d\u5f15\u5165\u79fb\u52a8\u6b21\u6570\u9650\u5236\uff0c\u4ee5\u589e\u52a0\u6311\u6218\u6027\u5e76\u9f13\u52b1\u73a9\u5bb6\u8fdb\u884c\u7b56\u7565\u601d\u8003\u3002\u8fd9\u79cd\u9650\u5236\u8feb\u4f7f\u73a9\u5bb6\u4ed4\u7ec6\u89c4\u5212\u6bcf\u4e00\u6b21\u79fb\u52a8\uff0c\u4f18\u5316\u4ed6\u4eec\u7684\u6e38\u620f\u65b9\u5f0f\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 45 \u5173\uff0c\u4f60\u53ea\u6709 15 \u6b21\u79fb\u52a8\u6765\u5206\u7c7b\u4e94\u6839\u6df7\u5408\u989c\u8272\u7684\u7ba1\u9053\u3002\u8fd9\u4e2a\u9650\u5236\u6d4b\u8bd5\u4e86\u4f60\u63d0\u524d\u601d\u8003\u548c\u6709\u6548\u7ba1\u7406\u8d44\u6e90\u7684\u80fd\u529b\uff0c\u4e3a\u6e38\u620f\u6dfb\u52a0\u4e86\u4e00\u5c42\u6df1\u5ea6\u3002"}, {"question": "\"\u4e50\u8da3\u6c34\u6392\u5e8f\"\u6e38\u620f\u4e2d\u7684\u54ea\u4e9b\u673a\u5236\u786e\u4fdd\u4e86\u5e73\u8861\u7684\u96be\u5ea6\u66f2\u7ebf\uff1f", "answer": "\"\u4e50\u8da3\u6c34\u6392\u5e8f\"\u6e38\u620f\u4f7f\u7528\u591a\u79cd\u673a\u5236\u6765\u4fdd\u6301\u5e73\u8861\u7684\u96be\u5ea6\u66f2\u7ebf\uff1a 1\uff09\u9010\u6e10\u5f15\u5165\u65b0\u7684\u989c\u8272\u548c\u7ba1\u72b6\u914d\u7f6e\u3002 2\uff09\u6839\u636e\u5173\u5361\u590d\u6742\u6027\u8c03\u6574\u79fb\u52a8\u6b21\u6570\u9650\u5236\u3002 3\uff09\u4e3a\u5361\u4f4f\u7684\u73a9\u5bb6\u63d0\u4f9b\u63d0\u793a\u7cfb\u7edf\u3002\u4f8b\u5982\uff0c\u7b2c 20 \u5173\u5f15\u5165\u4e86\u7b2c\u4e94\u79cd\u989c\u8272\uff0c\u4f46\u63d0\u4f9b\u4e86\u989d\u5916\u7684\u79fb\u52a8\u6b21\u6570\u4ee5\u9002\u5e94\u589e\u52a0\u7684\u590d\u6742\u6027\u3002\u8fd9\u4e9b\u673a\u5236\u786e\u4fdd\u73a9\u5bb6\u5728\u524d\u8fdb\u7684\u8fc7\u7a0b\u4e2d\u65e2\u4e0d\u4f1a\u611f\u5230\u4e0d\u77e5\u6240\u63aa\uff0c\u4e5f\u4e0d\u4f1a\u611f\u5230\u538c\u70e6\u3002"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684 \"\u4e50\u8da3\u6c34\u6392\u5e8f\" \u6e38\u620f\u8fdb\u5ea6\u8f6c\u79fb\u5230\u65b0\u8bbe\u5907\uff1f", "answer": "\u8981\u4f20\u8f93\u60a8\u7684\"\u4e50\u8da3\u6c34\u6392\u5e8f\"\u6e38\u620f\u8fdb\u5ea6\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41- \u786e\u4fdd\u60a8\u5728\u4e24\u53f0\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u540c\u4e00\u4e2a\u5e10\u6237\uff08\u4f8b\u5982\uff0cGoogle Play \u6216 Apple ID\uff09\u3002\u6b65\u9aa42- \u5728\u65e7\u8bbe\u5907\u4e0a\u6253\u5f00\u6e38\u620f\uff0c\u8fdb\u5165\u8bbe\u7f6e\u83dc\u5355\u3002\u6b65\u9aa43- \u9009\u62e9\"\u4e91\u4fdd\u5b58\"\u5e76\u5c06\u60a8\u7684\u8fdb\u5ea6\u4e0a\u4f20\u3002\u7136\u540e\uff0c\u5728\u65b0\u8bbe\u5907\u4e0a\u4e0b\u8f7d\u6e38\u620f\uff0c\u767b\u5f55\uff0c\u5e76\u4f7f\u7528\"\u4e91\u52a0\u8f7d\"\u9009\u9879\u6765\u68c0\u7d22\u60a8\u7684\u6570\u636e\u3002\u6b64\u65b9\u6cd5\u786e\u4fdd\u60a8\u7684\u6210\u5c31\u548c\u5173\u5361\u8fdb\u5ea6\u53ef\u4ee5\u65e0\u7f1d\u5730\u8f6c\u79fb\u3002"}, {"question": "\u54ea\u4e9b\u9690\u85cf\u529f\u80fd\u53ef\u4ee5\u589e\u5f3a\u6211\u7684\"\u4e50\u8da3\u6c34\u6392\u5e8f\"\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": " \"\u4e50\u8da3\u6c34\u6392\u5e8f\"\u6e38\u620f\u5305\u542b\u82e5\u5e72\u9690\u85cf\u529f\u80fd\uff1a1\uff09\u6bcf\u65e5\u6311\u6218\uff0c\u63d0\u4f9b\u72ec\u7279\u5956\u52b1\u3002 2\uff09\u67d0\u4e9b\u5173\u5361\u4e2d\u7684\u5f69\u86cb\uff0c\u4f8b\u5982\u7b2c 50 \u5173\u4e2d\u7684\u9690\u85cf\u4fe1\u606f\u3002 3\uff09\u5728\u5b8c\u6210 100 \u4e2a\u5173\u5361\u540e\u89e3\u9501\u79d8\u5bc6\u6a21\u5f0f\uff0c\u63d0\u4f9b\u65b0\u7684\u6e38\u620f\u673a\u5236\u3002 \u4f8b\u5982\uff0c\u5728\u7b2c 50 \u5173\uff0c\u5982\u679c\u60a8\u6309\u7167\u7279\u5b9a\u987a\u5e8f\u6392\u5e8f\u7ba1\u9053\uff0c\u5219\u4f1a\u51fa\u73b0\u795d\u8d3a\u4fe1\u606f\u3002\u63a2\u7d22\u8fd9\u4e9b\u529f\u80fd\u53ef\u4ee5\u4e3a\u6e38\u620f\u589e\u6dfb\u989d\u5916\u7684\u4e50\u8da3\u3002"}, {"question": "\u5982\u4f55\u5728\"\u4e50\u8da3\u6c34\u6392\u5e8f\"\u6e38\u620f\u4e2d\u4f18\u5316\u7ba1\u9053\u7684\u6392\u5217\u4ee5\u8fbe\u5230\u6700\u5927\u6548\u7387\uff1f", "answer": "\u4f18\u5316\u7ba1\u9053\u6392\u5217\u5305\u62ec\uff1a\u6b65\u9aa41- \u5c06\u76f8\u4f3c\u7684\u989c\u8272\u7ec4\u5408\u5728\u4e00\u8d77\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u79fb\u52a8\u3002\u6b65\u9aa42- \u4fdd\u6301\u81f3\u5c11\u4e00\u4e2a\u7ba1\u9053\u4e3a\u7a7a\uff0c\u7528\u4f5c\u4e34\u65f6\u5b58\u50a8\u3002\u6b65\u9aa43- \u4f18\u5148\u5904\u7406\u5305\u542b\u989c\u8272\u79cd\u7c7b\u8f83\u5c11\u7684\u7ba1\u9053\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u6709\u4e00\u4e2a\u4ec5\u5305\u542b\u7ea2\u8272\u548c\u84dd\u8272\u7684\u7ba1\u9053\uff0c\u8bf7\u5c3d\u65e9\u89e3\u51b3\u5b83\uff0c\u4ee5\u964d\u4f4e\u590d\u6742\u6027\u3002\u8fd9\u79cd\u65b9\u6cd5\u53ef\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u5197\u4f59\u52a8\u4f5c\uff0c\u52a0\u5feb\u6392\u5e8f\u8fc7\u7a0b\u3002"}, {"question": "\u79fb\u52a8\u7aef\u548cPC\u7aef\u7684\"\u4e50\u8da3\u6c34\u6392\u5e8f\"\u6e38\u620f\u6709\u4ec0\u4e48\u4e3b\u8981\u533a\u522b\uff1f", "answer": "\u79fb\u52a8\u7aef\u548cPC\u7aef\"\u4e50\u8da3\u6c34\u6392\u5e8f\"\u6e38\u620f\u7684\u4e3b\u8981\u533a\u522b\u5728\u4e8e\uff1a1\uff09\u63a7\u5236\u65b9\u5f0f\u2014\u2014\u79fb\u52a8\u7aef\u4f7f\u7528\u89e6\u6478\uff0c\u800cPC\u7aef\u4f7f\u7528\u9f20\u6807\u70b9\u51fb\u30022\uff09\u5c4f\u5e55\u5206\u8fa8\u7387\u2014\u2014PC\u7aef\u63d0\u4f9b\u66f4\u9ad8\u6e05\u6670\u5ea6\u548c\u66f4\u5927\u7684\u663e\u793a\u5c4f\u30023\uff09\u6027\u80fd\u2014\u2014\u7531\u4e8e\u786c\u4ef6\u66f4\u597d\uff0cPC\u7248\u672c\u53ef\u80fd\u8fd0\u884c\u66f4\u6d41\u7545\u3002\u4f8b\u5982\uff0c\u5728PC\u4e0a\uff0c\u60a8\u53ef\u4ee5\u653e\u5927\u4ee5\u8fdb\u884c\u7cbe\u786e\u7684\u5012\u6c34\uff0c\u8fd9\u5728\u79fb\u52a8\u7aef\u4e0a\u4e0d\u53ef\u7528\u3002\u8fd9\u4e9b\u5dee\u5f02\u4f1a\u5f71\u54cd\u8de8\u5e73\u53f0\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\"\u4e50\u8da3\u6c34\u6392\u5e8f\"\u4e2d\u7684\u63d0\u793a\u7cfb\u7edf\u5982\u4f55\u8fd0\u4f5c\uff0c\u4ee5\u53ca\u4ec0\u4e48\u65f6\u5019\u5e94\u8be5\u4f7f\u7528\u5b83\uff1f", "answer": " \"\u4e50\u8da3\u6c34\u6392\u5e8f\"\u4e2d\u7684\u63d0\u793a\u7cfb\u7edf\u4f1a\u5728\u4f60\u5361\u4f4f\u65f6\u63d0\u4f9b\u5efa\u8bae\u7684\u79fb\u52a8\u64cd\u4f5c\u3002\u5b83\u4f1a\u5206\u6790\u5f53\u524d\u7684\u7ba1\u9053\u914d\u7f6e\uff0c\u5e76\u63a8\u8350\u6700\u6709\u6548\u7684\u64cd\u4f5c\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 30 \u5173\uff0c\u5982\u679c\u60a8\u4e0d\u786e\u5b9a\u5982\u4f55\u5012\u7279\u5b9a\u989c\u8272\uff0c\u63d0\u793a\u53ef\u80fd\u4f1a\u5efa\u8bae\u5c06\u5176\u8f6c\u79fb\u5230\u4e00\u4e2a\u7a7a\u7ba1\u9053\u3002\u8bf7\u8c28\u614e\u4f7f\u7528\u63d0\u793a\uff0c\u56e0\u4e3a\u5b83\u4eec\u6570\u91cf\u6709\u9650\uff0c\u6700\u597d\u7559\u7ed9\u7279\u522b\u5177\u6709\u6311\u6218\u6027\u7684\u5173\u5361\u4f7f\u7528\u3002"}, {"question": "\u5728\"\u4e50\u8da3\u6c34\u6392\u5e8f\"\u7684\u6e38\u620f\u9650\u65f6\u6311\u6218\u4e2d\uff0c\u54ea\u4e9b\u6700\u4f73\u5b9e\u8df5\u53ef\u4ee5\u6709\u6548\u5b8c\u6210\uff1f", "answer": "\u8981\u51fa\u8272\u5730\u5b8c\u6210\u9650\u65f6\u6311\u6218\uff1a\u6b65\u9aa41- \u5feb\u901f\u8bc4\u4f30\u521d\u59cb\u7ba1\u9053\u8bbe\u7f6e\u3002\u6b65\u9aa42- \u4e00\u6b21\u4e13\u6ce8\u4e8e\u4e00\u79cd\u989c\u8272\uff0c\u907f\u514d\u6df7\u6dc6\u3002\u6b65\u9aa43- \u4f7f\u7528\u5feb\u6377\u65b9\u5f0f\uff0c\u4f8b\u5982\u53cc\u51fb\u4ee5\u52a0\u5feb\u5012\u6c34\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u9650\u65f6\u6311\u6218\u4e2d\uff0c\u5982\u679c\u53ea\u6709\u4e09\u4e2a\u7ba1\u9053\uff0c\u5219\u4f18\u5148\u89e3\u51b3\u989c\u8272\u79cd\u7c7b\u6700\u5c11\u7684\u7ba1\u9053\uff0c\u4ee5\u8282\u7701\u65f6\u95f4\u3002\u8fd9\u4e9b\u505a\u6cd5\u6709\u52a9\u4e8e\u4f60\u5728\u89c4\u5b9a\u7684\u65f6\u95f4\u5185\u9ad8\u6548\u5730\u5b8c\u6210\u6311\u6218\u3002"}]
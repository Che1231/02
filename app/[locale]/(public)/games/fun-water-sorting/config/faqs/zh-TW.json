[{"question": "\u904a\u6232\u65b0\u624b\u5982\u4f55\u958b\u59cb\u73a9\"\u8da3\u5473\u6c34\u6392\u5e8f\"\u904a\u6232\uff1f", "answer": "\u8981\u958b\u59cb\u73a9\"\u8da3\u5473\u6c34\u6392\u5e8f\"\uff0c\u9996\u5148\uff0c\u8acb\u5f9e\u60a8\u7684\u61c9\u7528\u7a0b\u5f0f\u5546\u5e97\u4e0b\u8f09\u904a\u6232\u3002\u5b89\u88dd\u5b8c\u6210\u5f8c\uff0c\u958b\u555f\u904a\u6232\u4e26\u6309\u7167\u6559\u5b78\u6b65\u9a5f\u9032\u884c\uff0c\u6559\u5b78\u6703\u5f15\u5c0e\u60a8\u5b8c\u6210\u57fa\u672c\u64cd\u4f5c\u3002\u4f8b\u5982\uff0c\u60a8\u5c07\u5b78\u7fd2\u5982\u4f55\u900f\u904e\u9ede\u64ca\u7ba1\u5b50\u4f86\u9078\u64c7\u548c\u50be\u5012\u6c34\u3002\u6559\u5b78\u4ea6\u6703\u8aaa\u660e\u904a\u6232\u76ee\u6a19\uff1a\u5c07\u4e0d\u540c\u984f\u8272\u7684\u6c34\u5206\u985e\u5230\u4e0d\u540c\u7684\u7ba1\u5b50\u4e2d\uff0c\u907f\u514d\u6df7\u5408\u3002\u9019\u4e00\u6b65\u9a5f\u5c0d\u65bc\u7406\u89e3\u904a\u6232\u6838\u5fc3\u6982\u5ff5\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u73a9\u4e86 100 \u5c0f\u6642\u5f8c\uff0c\u5728\"\u8da3\u5473\u6c34\u6392\u5e8f\"\u904a\u6232\u4e2d\u6709\u54ea\u4e9b\u9032\u968e\u7b56\u7565\uff1f", "answer": "\u5728\u73a9\u4e86 100 \u5c0f\u6642\u5f8c\uff0c\u8acb\u8457\u91cd\u65bc\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9a5f1 \u2013 \u9810\u5148\u898f\u5283\u60a8\u7684\u52d5\u4f5c\uff0c\u60f3\u50cf\u6bcf\u6839\u7ba1\u5b50\u7684\u6700\u7d42\u72c0\u614b\u3002\u6b65\u9a5f2 \u2013 \u4f7f\u7528\u7a7a\u7ba1\u4f5c\u70ba\u66ab\u5b58\u7a7a\u9593\uff0c\u907f\u514d\u984f\u8272\u6df7\u5408\u3002\u6b65\u9a5f3 \u2013 \u512a\u5148\u89e3\u6c7a\u9650\u5236\u6700\u56b4\u683c\u7684\u7ba1\u5b50\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4e00\u6839\u7ba1\u5b50\u53ea\u5269\u4e0b\u55ae\u4e00\u984f\u8272\uff0c\u8acb\u7acb\u5373\u5b8c\u6210\u5b83\uff0c\u4ee5\u9a30\u51fa\u7a7a\u9593\u3002\u9019\u4e9b\u6b65\u9a5f\u5c07\u6709\u52a9\u65bc\u60a8\u66f4\u9ad8\u6548\u5730\u8655\u7406\u8907\u96dc\u7684\u95dc\u5361\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\"\u8da3\u5473\u6c34\u6392\u5e8f\"\u904a\u6232\u4e2d\u7684\u67d0\u4e9b\u95dc\u5361\u6703\u6709\u79fb\u52d5\u6b21\u6578\u9650\u5236\uff1f", "answer": "\"\u8da3\u5473\u6c34\u6392\u5e8f\"\u904a\u6232\u5728\u67d0\u4e9b\u95dc\u5361\u8a2d\u5b9a\u79fb\u52d5\u6b21\u6578\u9650\u5236\uff0c\u4ee5\u63d0\u5347\u6311\u6230\u6027\u4e26\u9f13\u52f5\u73a9\u5bb6\u904b\u7528\u7b56\u7565\u601d\u8003\u3002\u6b64\u9650\u5236\u8feb\u4f7f\u73a9\u5bb6\u4ed4\u7d30\u898f\u5283\u6bcf\u6b21\u64cd\u4f5c\u4e26\u512a\u5316\u4ed6\u5011\u7684\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 45 \u95dc\u5361\uff0c\u60a8\u53ea\u6709 15 \u6b21\u79fb\u52d5\u6a5f\u6703\u4f86\u6392\u5e8f\u4e94\u6839\u6df7\u5408\u984f\u8272\u7684\u7ba1\u5b50\u3002\u9019\u500b\u9650\u5236\u8003\u9a57\u60a8\u9810\u5148\u601d\u8003\u548c\u6709\u6548\u7ba1\u7406\u8cc7\u6e90\u7684\u80fd\u529b\uff0c\u70ba\u904a\u6232\u589e\u6dfb\u6df1\u5ea6\u3002"}, {"question": "\"\u8da3\u5473\u6c34\u6392\u5e8f\"\u904a\u6232\u4e2d\u54ea\u4e9b\u6a5f\u5236\u78ba\u4fdd\u4e86\u96e3\u6613\u5ea6\u66f2\u7dda\u7684\u5e73\u8861\uff1f", "answer": "\"\u8da3\u5473\u6c34\u6392\u5e8f\"\u904a\u6232\u900f\u904e\u4ee5\u4e0b\u5e7e\u7a2e\u6a5f\u5236\u4f86\u7dad\u6301\u96e3\u6613\u5ea6\u66f2\u7dda\u7684\u5e73\u8861\uff1a1) \u9010\u6b65\u5f15\u5165\u65b0\u7684\u984f\u8272\u548c\u7ba1\u5b50\u914d\u7f6e\u30022) \u4f9d\u64da\u95dc\u5361\u8907\u96dc\u5ea6\u8abf\u6574\u79fb\u52d5\u6b21\u6578\u9650\u5236\u30023) \u70ba\u5361\u95dc\u7684\u73a9\u5bb6\u63d0\u4f9b\u63d0\u793a\u7cfb\u7d71\u3002\u4f8b\u5982\uff0c\u7b2c 20 \u95dc\u5361\u5f15\u5165\u7b2c\u4e94\u7a2e\u984f\u8272\uff0c\u4f46\u540c\u6642\u63d0\u4f9b\u984d\u5916\u7684\u79fb\u52d5\u6b21\u6578\u4ee5\u61c9\u5c0d\u589e\u52a0\u7684\u8907\u96dc\u5ea6\u3002\u9019\u4e9b\u6a5f\u5236\u78ba\u4fdd\u73a9\u5bb6\u5728\u904a\u6232\u904e\u7a0b\u4e2d\u65e2\u4e0d\u6703\u611f\u5230\u58d3\u5012\u6027\uff0c\u4e5f\u4e0d\u6703\u611f\u5230\u7121\u804a\u3002"}, {"question": "\u5982\u4f55\u5728\u65b0\u7684\u88dd\u7f6e\u4e0a\u50b3\u8f38\"\u8da3\u5473\u6c34\u6392\u5e8f\"\u904a\u6232\u7684\u9032\u5ea6\uff1f", "answer": "\u8981\u50b3\u8f38\"\u8da3\u5473\u6c34\u6392\u5e8f\"\u904a\u6232\u7684\u9032\u5ea6\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 \u2013 \u8acb\u78ba\u4fdd\u60a8\u5728\u5169\u90e8\u88dd\u7f6e\u4e0a\u90fd\u767b\u5165\u76f8\u540c\u7684\u5e33\u6236\uff08\u4f8b\u5982 Google Play \u6216 Apple ID\uff09\u3002\u6b65\u9a5f2 \u2013 \u5728\u60a8\u7684\u820a\u88dd\u7f6e\u4e0a\u958b\u555f\u904a\u6232\u4e26\u524d\u5f80\u8a2d\u5b9a\u9078\u55ae\u3002\u6b65\u9a5f3 \u2013 \u9078\u64c7\u300c\u96f2\u7aef\u5132\u5b58\u300d\u4e26\u4e0a\u50b3\u60a8\u7684\u904a\u6232\u9032\u5ea6\u3002\u7136\u5f8c\uff0c\u5728\u60a8\u7684\u65b0\u88dd\u7f6e\u4e0a\u4e0b\u8f09\u904a\u6232\uff0c\u767b\u5165\u4e26\u4f7f\u7528\u300c\u96f2\u7aef\u8f09\u5165\u300d\u9078\u9805\u4f86\u64f7\u53d6\u60a8\u7684\u8cc7\u6599\u3002\u9019\u7a2e\u65b9\u6cd5\u80fd\u78ba\u4fdd\u60a8\u7684\u6210\u5c31\u548c\u95dc\u5361\u9032\u5ea6\u9806\u5229\u5730\u50b3\u8f38\u3002"}, {"question": "\u6709\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\u53ef\u4ee5\u589e\u5f37\u6211\u7684\"\u8da3\u5473\u6c34\u6392\u5e8f\"\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\"\u8da3\u5473\u6c34\u6392\u5e8f\"\u904a\u6232\u5305\u542b\u4e00\u4e9b\u96b1\u85cf\u529f\u80fd\uff1a1) \u6bcf\u65e5\u6311\u6230\uff0c\u63d0\u4f9b\u7368\u7279\u7684\u734e\u52f5\u30022) \u67d0\u4e9b\u95dc\u5361\u5305\u542b\u5f69\u86cb\uff0c\u4f8b\u5982\u7b2c 50 \u95dc\u5361\u7684\u96b1\u85cf\u8a0a\u606f\u30023) \u5728\u5b8c\u6210 100 \u500b\u95dc\u5361\u5f8c\uff0c\u89e3\u9396\u79d8\u5bc6\u6a21\u5f0f\uff0c\u63d0\u4f9b\u65b0\u7684\u904a\u6232\u6a5f\u5236\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 50 \u95dc\u5361\uff0c\u5982\u679c\u4ee5\u7279\u5b9a\u9806\u5e8f\u6392\u5217\u7ba1\u5b50\uff0c\u5247\u6703\u51fa\u73fe\u795d\u8cc0\u8a0a\u606f\u3002\u63a2\u7d22\u9019\u4e9b\u529f\u80fd\u53ef\u4ee5\u70ba\u904a\u6232\u589e\u6dfb\u984d\u5916\u7684\u6a02\u8da3\u3002"}, {"question": "\u5982\u4f55\u5728\"\u8da3\u5473\u6c34\u6392\u5e8f\"\u904a\u6232\u4e2d\u6700\u4f73\u5316\u7ba1\u5b50\u7684\u6392\u5217\u65b9\u5f0f\u4ee5\u9054\u5230\u6700\u5927\u6548\u7387\uff1f", "answer": "\u6700\u4f73\u5316\u7ba1\u5b50\u6392\u5217\u65b9\u5f0f\u5305\u542b\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 \u2013 \u5c07\u76f8\u540c\u984f\u8272\u5206\u7d44\u5728\u4e00\u8d77\u4ee5\u6e1b\u5c11\u79fb\u52d5\u6b21\u6578\u3002\u6b65\u9a5f2 \u2013 \u4fdd\u6301\u81f3\u5c11\u4e00\u6839\u7ba1\u5b50\u70ba\u7a7a\uff0c\u7528\u65bc\u66ab\u5b58\u3002\u6b65\u9a5f3 \u2013 \u512a\u5148\u8655\u7406\u7a2e\u985e\u6700\u5c11\u7684\u7ba1\u5b50\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u6709\u4e00\u6839\u7ba1\u5b50\u53ea\u6709\u7d05\u8272\u548c\u85cd\u8272\uff0c\u8acb\u76e1\u65e9\u89e3\u6c7a\u5b83\u4ee5\u6e1b\u5c11\u8907\u96dc\u5ea6\u3002\u9019\u7a2e\u65b9\u6cd5\u53ef\u4ee5\u6e1b\u5c11\u5197\u9918\u52d5\u4f5c\u4e26\u52a0\u5feb\u6392\u5e8f\u904e\u7a0b\u3002"}, {"question": "\u884c\u52d5\u88dd\u7f6e\u5e73\u53f0\u548c\u500b\u4eba\u96fb\u8166\u5e73\u53f0\u4e0a\u7684\"\u8da3\u5473\u6c34\u6392\u5e8f\"\u904a\u6232\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "\u884c\u52d5\u88dd\u7f6e\u5e73\u53f0\u548c\u500b\u4eba\u96fb\u8166\u5e73\u53f0\u4e0a\u7684\"\u8da3\u5473\u6c34\u6392\u5e8f\"\u904a\u6232\u7684\u4e3b\u8981\u5dee\u7570\u5728\u65bc\uff1a1) \u63a7\u5236\u65b9\u5f0f \u2013 \u884c\u52d5\u88dd\u7f6e\u4f7f\u7528\u89f8\u63a7\uff0c\u500b\u4eba\u96fb\u8166\u5247\u4f7f\u7528\u6ed1\u9f20\u9ede\u64ca\u30022) \u87a2\u5e55\u89e3\u6790\u5ea6 \u2013 \u500b\u4eba\u96fb\u8166\u63d0\u4f9b\u66f4\u9ad8\u7684\u6e05\u6670\u5ea6\u548c\u66f4\u5927\u7684\u87a2\u5e55\u986f\u793a\u30023) \u6548\u80fd \u2013 \u500b\u4eba\u96fb\u8166\u7248\u672c\u7531\u65bc\u786c\u9ad4\u66f4\u597d\uff0c\u57f7\u884c\u53ef\u80fd\u6703\u66f4\u9806\u66a2\u3002\u4f8b\u5982\uff0c\u5728\u500b\u4eba\u96fb\u8166\u4e0a\uff0c\u60a8\u53ef\u4ee5\u653e\u5927\u4ee5\u9032\u884c\u7cbe\u78ba\u7684\u64cd\u4f5c\uff0c\u9019\u5728\u884c\u52d5\u88dd\u7f6e\u4e0a\u4e0d\u53ef\u7528\u3002\u9019\u4e9b\u5dee\u7570\u6703\u5f71\u97ff\u4e0d\u540c\u5e73\u53f0\u4e0a\u7684\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\"\u8da3\u5473\u6c34\u6392\u5e8f\"\u904a\u6232\u4e2d\u7684\u63d0\u793a\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff0c\u4ee5\u53ca\u4f55\u6642\u61c9\u8a72\u4f7f\u7528\u5b83\uff1f", "answer": "\"\u8da3\u5473\u6c34\u6392\u5e8f\"\u904a\u6232\u4e2d\u7684\u63d0\u793a\u7cfb\u7d71\u6703\u5728\u60a8\u5361\u95dc\u6642\u63d0\u4f9b\u5efa\u8b70\u7684\u52d5\u4f5c\u3002\u5b83\u6703\u5206\u6790\u7576\u524d\u7684\u7ba1\u5b50\u914d\u7f6e\u4e26\u63a8\u85a6\u6700\u6709\u6548\u7387\u7684\u64cd\u4f5c\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 30 \u95dc\u5361\uff0c\u5982\u679c\u60a8\u4e0d\u78ba\u5b9a\u5982\u4f55\u50be\u5012\u7279\u5b9a\u984f\u8272\uff0c\u63d0\u793a\u53ef\u80fd\u6703\u5efa\u8b70\u5c07\u5176\u8f49\u79fb\u5230\u7a7a\u7ba1\u3002\u8acb\u8b39\u614e\u4f7f\u7528\u63d0\u793a\uff0c\u56e0\u70ba\u63d0\u793a\u6578\u91cf\u6709\u9650\uff0c\u6700\u597d\u7559\u8457\u7528\u65bc\u7279\u5225\u5177\u6709\u6311\u6230\u6027\u7684\u95dc\u5361\u3002"}, {"question": "\u5728\"\u8da3\u5473\u6c34\u6392\u5e8f\"\u904a\u6232\u4e2d\u7684\u9650\u6642\u6311\u6230\u4e2d\uff0c\u54ea\u4e9b\u6700\u4f73\u5be6\u52d9\u53ef\u4ee5\u7372\u5f97\u9ad8\u5206\uff1f", "answer": "\u8981\u52dd\u4efb\u9650\u6642\u6311\u6230\uff1a\u6b65\u9a5f1 \u2013 \u5feb\u901f\u8a55\u4f30\u521d\u59cb\u7ba1\u5b50\u914d\u7f6e\u3002\u6b65\u9a5f2 \u2013 \u4e00\u6b21\u5c08\u6ce8\u65bc\u4e00\u7a2e\u984f\u8272\uff0c\u4ee5\u907f\u514d\u6df7\u6dc6\u3002\u6b65\u9a5f3 \u2013 \u4f7f\u7528\u5feb\u901f\u64cd\u4f5c\uff0c\u4f8b\u5982\u96d9\u64ca\uff0c\u4f86\u52a0\u5feb\u50be\u5012\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u5177\u6709\u4e09\u6839\u7ba1\u5b50\u7684\u9650\u6642\u6311\u6230\u4e2d\uff0c\u512a\u5148\u89e3\u6c7a\u5305\u542b\u6700\u5c11\u984f\u8272\u6578\u7684\u7ba1\u5b50\u4ee5\u7bc0\u7701\u6642\u9593\u3002\u9019\u4e9b\u6700\u4f73\u5be6\u52d9\u5c07\u6709\u52a9\u65bc\u60a8\u5728\u898f\u5b9a\u7684\u6642\u9593\u5167\u6709\u6548\u7387\u5730\u5b8c\u6210\u6311\u6230\u3002"}]
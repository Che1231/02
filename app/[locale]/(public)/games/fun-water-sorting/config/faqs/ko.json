[{"question": "\ucd08\ubcf4\uc790\ub85c\uc11c \uc7ac\ubbf8\uc788\ub294 \ubb3c \uc815\ub82c \uac8c\uc784\uc744 \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud574\uc57c \ud558\ub098\uc694?", "answer": "\uc7ac\ubbf8\uc788\ub294 \ubb3c \uc815\ub82c \uac8c\uc784\uc744 \uc2dc\uc791\ud558\ub824\uba74 \uba3c\uc800 \uc571 \uc2a4\ud1a0\uc5b4\uc5d0\uc11c \uac8c\uc784\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc138\uc694. \uc124\uce58 \ud6c4 \uac8c\uc784\uc744 \uc5f4\uace0 \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc744 \uc548\ub0b4\ud574\uc8fc\ub294 \ud29c\ud1a0\ub9ac\uc5bc\uc744 \ub530\ub77c\uc8fc\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud29c\ube0c\ub97c \ud0ed\ud558\uc5ec \ubb3c\uc744 \uc120\ud0dd\ud558\uace0 \ud29c\ube0c \uc0ac\uc774\uc5d0 \ubd80\uc744 \uc218 \uc788\ub294 \ubc29\ubc95\uc744 \ubc30\uc6b0\uac8c \ub429\ub2c8\ub2e4. \ud29c\ud1a0\ub9ac\uc5bc\uc5d0\uc11c\ub294 \ud63c\ud569\ud558\uc9c0 \uc54a\uace0 \uc0c9\uae54\ubcc4 \ubb3c\uc744 \ubd84\ub9ac\ub41c \ud29c\ube0c\uc5d0 \uc815\ub82c\ud558\ub294 \ubaa9\ud45c\ub97c \uc18c\uac1c\ud569\ub2c8\ub2e4. \uc774 \ucd08\uae30 \ub2e8\uacc4\ub294 \uac8c\uc784\uc758 \ud575\uc2ec \uac1c\ub150\uc744 \uc774\ud574\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4."}, {"question": "100\uc2dc\uac04 \uc774\uc0c1 \ud50c\ub808\uc774\ud55c \ud6c4 \uc7ac\ubbf8\uc788\ub294 \ubb3c \uc815\ub82c \uac8c\uc784\uc5d0\uc11c \uc9c4\ud589\uc744 \uc704\ud55c \ud544\uc218 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "100\uc2dc\uac04 \uc774\uc0c1 \ud50c\ub808\uc774\ud55c \ud6c4\uc5d0\ub294 \uc774\ub7ec\ud55c \uc804\ub7b5\uc5d0 \uc9d1\uc911\ud558\uc138\uc694: 1\ub2e8\uacc4 - \uac01 \ud29c\ube0c\uc758 \ucd5c\uc885 \uc0c1\ud0dc\ub97c \uc2dc\uac01\ud654\ud558\uc5ec \uc774\ub3d9\uc744 \uacc4\ud68d\ud558\uc138\uc694. 2\ub2e8\uacc4 - \uc0c9\uc0c1 \ud63c\ud569\uc744 \ud53c\ud558\uae30 \uc704\ud574 \ube48 \ud29c\ube0c\ub97c \uc784\uc2dc \uc800\uc7a5\uc18c\ub85c \uc0ac\uc6a9\ud558\uc138\uc694. 3\ub2e8\uacc4 - \uc81c\uc57d\uc774 \uac00\uc7a5 \ub9ce\uc740 \ud29c\ube0c\ubd80\ud130 \uc6b0\uc120\uc801\uc73c\ub85c \ud574\uacb0\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud29c\ube0c\uc5d0 \ud558\ub098\uc758 \uc0c9\uc0c1\ub9cc \ub0a8\uc558\ub2e4\uba74 \uacf5\uac04\uc744 \ud655\ubcf4\ud558\uae30 \uc704\ud574 \uc989\uc2dc \uc644\ub8cc\ud558\uc138\uc694. \uc774\ub7ec\ud55c \ub2e8\uacc4\ub294 \ubcf5\uc7a1\ud55c \ub808\ubca8\uc744 \ub354\uc6b1 \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4."}, {"question": "\uc7ac\ubbf8\uc788\ub294 \ubb3c \uc815\ub82c \uac8c\uc784\uc5d0\uc11c \uc77c\ubd80 \ub808\ubca8\uc774 \uc81c\ud55c\ub41c \uc6c0\uc9c1\uc784\uc744 \uc0ac\uc6a9\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc7ac\ubbf8\uc788\ub294 \ubb3c \uc815\ub82c \uac8c\uc784\uc740 \uc77c\ubd80 \ub808\ubca8\uc5d0\uc11c \uc81c\ud55c\ub41c \uc6c0\uc9c1\uc784\uc744 \ub3c4\uc785\ud558\uc5ec \ub3c4\uc804 \uacfc\uc81c\ub97c \ub192\uc774\uace0 \uc804\ub7b5\uc801\uc778 \uc0ac\uace0\ub97c \uc7a5\ub824\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc81c\uc57d\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uac01 \uc6c0\uc9c1\uc784\uc744 \uc2e0\uc911\ud558\uac8c \uacc4\ud68d\ud558\uace0 \uc790\uc2e0\uc758 \uc811\uadfc \ubc29\uc2dd\uc744 \ucd5c\uc801\ud654\ud558\ub3c4\ub85d \uac15\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 45\uc5d0\uc11c\ub294 \ud63c\ud569\ub41c \uc0c9\uc0c1\uc758 \ub2e4\uc12f \uac1c \ud29c\ube0c\ub97c \uc815\ub82c\ud558\uae30 \uc704\ud574 15\uac1c\uc758 \uc6c0\uc9c1\uc784\ub9cc \uc8fc\uc5b4\uc9d1\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc81c\ud55c\uc740 \ubbf8\ub9ac \uc0dd\uac01\ud558\uace0 \uc790\uc6d0\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \ub2a5\ub825\uc744 \uc2dc\ud5d8\ud558\uc5ec \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uae4a\uc774\ub97c \ub354\ud569\ub2c8\ub2e4."}, {"question": "\uc7ac\ubbf8\uc788\ub294 \ubb3c \uc815\ub82c \uac8c\uc784\uc5d0\uc11c \uade0\ud615 \uc7a1\ud78c \ub09c\uc774\ub3c4 \uace1\uc120\uc744 \ubcf4\uc7a5\ud558\ub294 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc7ac\ubbf8\uc788\ub294 \ubb3c \uc815\ub82c \uac8c\uc784\uc740 \uade0\ud615 \uc7a1\ud78c \ub09c\uc774\ub3c4 \uace1\uc120\uc744 \uc720\uc9c0\ud558\uae30 \uc704\ud574 \uc5ec\ub7ec \uba54\ucee4\ub2c8\uc998\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. 1) \uc0c8\ub85c\uc6b4 \uc0c9\uc0c1\uacfc \ud29c\ube0c \uad6c\uc131\uc744 \uc810\uc9c4\uc801\uc73c\ub85c \ub3c4\uc785\ud558\ub294 \uac83. 2) \ub808\ubca8 \ubcf5\uc7a1\uc131\uc5d0 \ub530\ub77c \uc870\uc815 \uac00\ub2a5\ud55c \uc6c0\uc9c1\uc784 \uc81c\ud55c. 3) \ub9c9\ud78c \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \ud78c\ud2b8 \uc2dc\uc2a4\ud15c. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 20\uc5d0\uc11c\ub294 \ub2e4\uc12f \ubc88\uc9f8 \uc0c9\uc0c1\uc744 \ub3c4\uc785\ud558\uc9c0\ub9cc, \uc99d\uac00\ub41c \ubcf5\uc7a1\uc131\uc744 \uc218\uc6a9\ud558\uae30 \uc704\ud574 \ucd94\uac00\uc801\uc778 \uc6c0\uc9c1\uc784\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc9c4\ud589\ud558\uba74\uc11c \uacfc\ub3c4\ud558\uac8c \uc555\ub3c4\ub418\uac70\ub098 \uc9c0\ub8e8\ud558\uc9c0 \uc54a\ub3c4\ub85d \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "\uc0c8\ub85c\uc6b4 \uae30\uae30\ub85c \uc7ac\ubbf8\uc788\ub294 \ubb3c \uc815\ub82c \uac8c\uc784\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud558\ub098\uc694?", "answer": "\uc7ac\ubbf8\uc788\ub294 \ubb3c \uc815\ub82c \uac8c\uc784\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: 1\ub2e8\uacc4 - \ub450 \uae30\uae30 \ubaa8\ub450(\uc608: \uad6c\uae00 \ud50c\ub808\uc774 \ub610\ub294 \uc560\ud50c ID) \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. 2\ub2e8\uacc4 - \uc774\uc804 \uae30\uae30\uc5d0\uc11c \uac8c\uc784\uc744 \uc5f4\uace0 \uc124\uc815 \uba54\ub274\ub85c \uc774\ub3d9\ud558\uc138\uc694. 3\ub2e8\uacc4 - '\ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5'\uc744 \uc120\ud0dd\ud558\uace0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5c5\ub85c\ub4dc\ud558\uc138\uc694. \uadf8\ub7f0 \ub2e4\uc74c \uc0c8 \uae30\uae30\uc5d0\uc11c \uac8c\uc784\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uace0 \ub85c\uadf8\uc778\ud55c \ud6c4 '\ud074\ub77c\uc6b0\ub4dc \ub85c\ub4dc' \uc635\uc158\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub370\uc774\ud130\ub97c \uac80\uc0c9\ud558\uc138\uc694. \uc774 \ubc29\ubc95\uc740 \uc131\ucde8\ub3c4\uc640 \ub808\ubca8 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc6d0\ud65c\ud558\uac8c \uc804\uc1a1\ub418\ub3c4\ub85d \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "\uc7ac\ubbf8\uc788\ub294 \ubb3c \uc815\ub82c \uac8c\uc784\uc758 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc7ac\ubbf8\uc788\ub294 \ubb3c \uc815\ub82c \uac8c\uc784\uc5d0\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. 1) \uace0\uc720\ud55c \ubcf4\uc0c1\uc774 \uc81c\uacf5\ub418\ub294 \uc77c\uc77c \ucc4c\ub9b0\uc9c0. 2) \ub808\ubca8 50\uacfc \uac19\uc740 \ud2b9\uc815 \ub808\ubca8\uc5d0 \uc788\ub294 \uc774\uc2a4\ud130 \uc5d0\uadf8. 3) 100\uac1c\uc758 \ub808\ubca8\uc744 \uc644\ub8cc\ud55c \ud6c4 \uc7a0\uae08 \ud574\uc81c\ub418\ub294 \ube44\ubc00 \ubaa8\ub4dc, \uc0c8\ub85c\uc6b4 \uba54\ucee4\ub2c8\uc998 \uc81c\uacf5. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 50\uc5d0\uc11c \ud29c\ube0c\ub97c \ud2b9\uc815 \uc21c\uc11c\ub85c \uc815\ub82c\ud558\uba74 \ucd95\ud558 \uba54\uc2dc\uc9c0\uac00 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uae30\ub2a5\uc744 \ud0d0\uc0c9\ud558\uba74 \uac8c\uc784\uc5d0 \ucd94\uac00\uc801\uc778 \uc7ac\ubbf8\ub97c \ub354\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc7ac\ubbf8\uc788\ub294 \ubb3c \uc815\ub82c \uac8c\uc784\uc5d0\uc11c \ucd5c\ub300 \ud6a8\uc728\uc744 \uc704\ud574 \ud29c\ube0c \ubc30\uce58\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud558\ub098\uc694?", "answer": "\ud29c\ube0c \ubc30\uce58\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \ub2e4\uc74c\uacfc \uac19\uc774 \ud558\uc138\uc694: 1\ub2e8\uacc4 - \uc774\ub3d9\uc744 \ucd5c\uc18c\ud654\ud558\uae30 \uc704\ud574 \ube44\uc2b7\ud55c \uc0c9\uc0c1\uc744 \ud568\uaed8 \uadf8\ub8f9\ud654\ud558\uc138\uc694. 2\ub2e8\uacc4 - \uc784\uc2dc \uc800\uc7a5\uc744 \uc704\ud574 \uc801\uc5b4\ub3c4 \ud55c \uac1c\uc758 \ud29c\ube0c\ub97c \ube44\uc6cc\ub450\uc138\uc694. 3\ub2e8\uacc4 - \uc885\ub958\uac00 \uac00\uc7a5 \uc801\uc740 \ud29c\ube0c\ubd80\ud130 \uc6b0\uc120 \uc21c\uc704\ub97c \ub192\uc774\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ube68\uac04\uc0c9\uacfc \ud30c\ub780\uc0c9\uc774 \uc788\ub294 \ud29c\ube0c\uac00 \uc788\ub2e4\uba74 \ubcf5\uc7a1\uc131\uc744 \uc904\uc774\uae30 \uc704\ud574 \uc870\uae30\uc5d0 \ud574\uacb0\ud558\uc138\uc694. \uc774\ub7ec\ud55c \uc811\uadfc \ubc29\uc2dd\uc740 \ubd88\ud544\uc694\ud55c \uc774\ub3d9\uc744 \ucd5c\uc18c\ud654\ud558\uace0 \uc815\ub82c \ud504\ub85c\uc138\uc2a4\ub97c \uac00\uc18d\ud654\ud569\ub2c8\ub2e4."}, {"question": "\ubaa8\ubc14\uc77c \ubc0f PC \ud50c\ub7ab\ud3fc\uc5d0\uc11c\uc758 \uc7ac\ubbf8\uc788\ub294 \ubb3c \uc815\ub82c \uac8c\uc784\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ubaa8\ubc14\uc77c \ubc0f PC \ud50c\ub7ab\ud3fc\uc5d0\uc11c\uc758 \uc7ac\ubbf8\uc788\ub294 \ubb3c \uc815\ub82c \uac8c\uc784\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. 1) \uc81c\uc5b4 \ubc29\uc2dd - \ubaa8\ubc14\uc77c\uc740 \ud130\uce58\ub97c \uc0ac\uc6a9\ud558\uc9c0\ub9cc PC\ub294 \ub9c8\uc6b0\uc2a4 \ud074\ub9ad\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. 2) \ud654\uba74 \ud574\uc0c1\ub3c4 - PC\ub294 \ub354 \ub192\uc740 \uc120\uba85\ub3c4\uc640 \ub354 \ud070 \ub514\uc2a4\ud50c\ub808\uc774\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. 3) \uc131\ub2a5 - PC \ubc84\uc804\uc740 \ub354 \ub098\uc740 \ud558\ub4dc\uc6e8\uc5b4\ub85c \uc778\ud574 \ub354 \ubd80\ub4dc\ub7fd\uac8c \uc2e4\ud589\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \uc815\ud655\ud558\uac8c \ubd80\uc5b4\uc57c \ud560 \uacbd\uc6b0 \ud655\ub300\ud560 \uc218 \uc788\uc9c0\ub9cc \ubaa8\ubc14\uc77c\uc740 \uc774 \uae30\ub2a5\uc774 \uc5c6\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ucc28\uc774\uc810\uc740 \ud50c\ub7ab\ud3fc \uc804\ubc18\uc758 \uac8c\uc784 \uacbd\ud5d8\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4."}, {"question": "\uc7ac\ubbf8\uc788\ub294 \ubb3c \uc815\ub82c \uac8c\uc784\uc758 \ud78c\ud2b8 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \uc5b8\uc81c \uc0ac\uc6a9\ud574\uc57c \ud558\ub098\uc694?", "answer": "\uc7ac\ubbf8\uc788\ub294 \ubb3c \uc815\ub82c \uac8c\uc784\uc758 \ud78c\ud2b8 \uc2dc\uc2a4\ud15c\uc740 \ub9c9\ud614\uc744 \ub54c \uc81c\uc548\ub41c \uc6c0\uc9c1\uc784\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ud604\uc7ac \ud29c\ube0c \uad6c\uc131\uc744 \ubd84\uc11d\ud558\uace0 \uac00\uc7a5 \ud6a8\uc728\uc801\uc778 \uc870\uce58\ub97c \uad8c\uc7a5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 30\uc5d0\uc11c \ud2b9\uc815 \uc0c9\uc0c1\uc744 \uc5b4\ub514\uc5d0 \ubd80\uc744\uc9c0 \ud655\uc2e0\ud558\uc9c0 \ubabb\ud558\uba74 \ud78c\ud2b8\uac00 \ube48 \ud29c\ube0c\ub85c \uc62e\uae30\ub3c4\ub85d \uc81c\uc548\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud78c\ud2b8\ub294 \uc81c\ud55c\uc801\uc774\uba70 \ud2b9\ud788 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc5d0\ub9cc \uac00\uc7a5 \uc801\ud569\ud558\uae30 \ub54c\ubb38\uc5d0 \uc808\uc57d\ud558\uc5ec \uc0ac\uc6a9\ud558\uc138\uc694."}, {"question": "\uc7ac\ubbf8\uc788\ub294 \ubb3c \uc815\ub82c \uac8c\uc784\uc5d0\uc11c \uc2dc\uac04 \uc81c\ud55c \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc2dc\uac04 \uc81c\ud55c \ucc4c\ub9b0\uc9c0\uc5d0\uc11c \uc131\uacf5\ud558\uae30 \uc704\ud574\uc11c\ub294 \ub2e4\uc74c\uacfc \uac19\uc774 \ud558\uc138\uc694: 1\ub2e8\uacc4 - \ucd08\uae30 \ud29c\ube0c \uc124\uc815\uc744 \uc2e0\uc18d\ud558\uac8c \ud3c9\uac00\ud558\uc138\uc694. 2\ub2e8\uacc4 - \ud63c\ub780\uc744 \ud53c\ud558\uae30 \uc704\ud574 \ud55c \uac00\uc9c0 \uc0c9\uc0c1\uc5d0 \uc9d1\uc911\ud558\uc138\uc694. 3\ub2e8\uacc4 - \ub354 \ube60\ub974\uac8c \ubd80\uc744 \uc218 \uc788\ub3c4\ub85d \ub450 \ubc88 \ud0ed\ud558\ub294 \ub4f1\uc758 \ubc14\ub85c\uac00\uae30\ub97c \uc0ac\uc6a9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc138 \uac1c\uc758 \ud29c\ube0c\uac00 \uc788\ub294 \uc2dc\uac04 \uc81c\ud55c \ucc4c\ub9b0\uc9c0\uc5d0\uc11c \uc2dc\uac04\uc744 \uc808\uc57d\ud558\uae30 \uc704\ud574 \uba3c\uc800 \uc0c9\uc0c1\uc774 \uac00\uc7a5 \uc801\uc740 \ud29c\ube0c\ubd80\ud130 \uc6b0\uc120\uc801\uc73c\ub85c \ud574\uacb0\ud558\uc138\uc694. \uc774\ub7ec\ud55c \ubc29\ubc95\ub4e4\uc740 \ud560\ub2f9\ub41c \uc2dc\uac04 \ub0b4\uc5d0 \ud6a8\uc728\uc801\uc73c\ub85c \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}]
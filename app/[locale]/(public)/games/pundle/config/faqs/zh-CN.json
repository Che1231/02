[{"question": "\u5982\u4f55\u5728\u65b0\u624b\u9636\u6bb5\u8fdb\u884c\u6f58\u5fb7\u5c14\u7684\u666e\u901a\u8fde\u62db\uff1f", "answer": "\u5728\u6f58\u5fb7\u5c14\u6267\u884c\u666e\u901a\u8fde\u62db\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u6309\u4e0b'A'\u952e\u53d1\u8d77\u8f7b\u653b\u51fb\u3002\u6b65\u9aa42\uff1a\u7acb\u5373\u6309\u4e0b'B'\u952e\u8854\u63a5\u91cd\u653b\u51fb\u3002\u6b65\u9aa43\uff1a\u6700\u540e\u6309\u4e0b'X'\u952e\u5b8c\u6210\u7279\u6b8a\u653b\u51fb\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u5173\uff0c\u8be5\u8fde\u62db\u53ef\u4ee5\u6709\u6548\u51fb\u8d25\u521d\u59cb\u654c\u4eba\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u6b64\u8fde\u62db\u60f3\u8c61\u6210\u62f3\u51fb\u4e2d\u7684\u8fde\u73af\u7ec4\u5408\u62f3\uff0c\u6bcf\u4e00\u6b65\u52a8\u4f5c\u90fd\u5efa\u7acb\u5728\u524d\u4e00\u6b65\u7684\u57fa\u7840\u4e0a\uff0c\u4ee5\u8fbe\u5230\u6700\u5927\u7684\u51b2\u51fb\u529b\u3002]"}, {"question": "\u5728\u6f58\u5fb7\u5c14\u6e38\u620f\u4e2d\uff0c\u9700\u8981\u638c\u63e1\u54ea\u4e9b\u5fc5\u5907\u7684\u64cd\u4f5c\uff1f", "answer": "\u6f58\u5fb7\u5c14\u6e38\u620f\u4e2d\u7684\u5fc5\u5907\u64cd\u4f5c\u5305\u62ec\u79fb\u52a8\u3001\u653b\u51fb\u548c\u4f7f\u7528\u7279\u6b8a\u80fd\u529b\u3002\u4f7f\u7528\u5de6\u6447\u6746\u8fdb\u884c\u79fb\u52a8\uff0c'A'\u952e\u8fdb\u884c\u8f7b\u653b\u51fb\uff0c'B'\u952e\u8fdb\u884c\u91cd\u653b\u51fb\uff0c'X'\u952e\u8fdb\u884c\u7279\u6b8a\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u719f\u7ec3\u638c\u63e1'Y'\u952e\u7684\u95ea\u907f\u6eda\u52a8\uff0c\u53ef\u4ee5\u5e2e\u52a9\u4f60\u5728\u7b2c\u4e8c\u5173\u8eb2\u907f\u654c\u4eba\u7684\u653b\u51fb\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u6447\u6746 - \u79fb\u52a8\uff0cA - \u8f7b\u653b\u51fb\uff0cB - \u91cd\u653b\u51fb\uff0cX - \u7279\u6b8a\u80fd\u529b\uff0cY - \u95ea\u907f\u6eda\u52a8\u3002]"}, {"question": "\u5728\u6f58\u5fb7\u5c14\u6e38\u620f\u4e2d\uff0c\u4e3a\u4ec0\u4e48\u7406\u89e3\u4f53\u529b\u6761\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u7406\u89e3\u4f53\u529b\u6761\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u9650\u5236\u4e86\u4f60\u7684\u884c\u52a8\u80fd\u529b\u3002\u6bcf\u6b21\u653b\u51fb\u6216\u95ea\u907f\u90fd\u4f1a\u6d88\u8017\u4f53\u529b\uff0c\u5982\u679c\u4f53\u529b\u8017\u5c3d\uff0c\u4f60\u5c06\u53d8\u5f97\u975e\u5e38\u8106\u5f31\u3002\u4f8b\u5982\uff0c\u5728\u6700\u7ec8\u7684BOSS\u6218\u4e2d\uff0c\u6709\u6548\u5730\u7ba1\u7406\u4f60\u7684\u4f53\u529b\u80fd\u591f\u8ba9\u4f60\u8eb2\u907f\u5173\u952e\u7684\u653b\u51fb\u5e76\u8fdb\u884c\u6709\u6548\u7684\u53cd\u51fb\u3002[\u6d41\u7a0b\u56fe\u89e3: \u884c\u52a8 -> \u4f53\u529b\u6d88\u8017 -> \u4f53\u529b\u6062\u590d -> \u91cd\u590d\u3002]"}, {"question": "\u54ea\u4e9b\u9ad8\u7ea7\u7b56\u7565\u53ef\u4ee5\u5e2e\u52a9\u6211\u5728\u6f58\u5fb7\u5c14\u6e38\u620f\u4e2d\u51fb\u8d25\u6700\u7ec8BOSS\uff1f", "answer": "\u8981\u51fb\u8d25\u6f58\u5fb7\u5c14\u6e38\u620f\u7684\u6700\u7ec8BOSS\uff0c\u8bf7\u8003\u8651\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9aa41\uff1a\u5b66\u4e60BOSS\u7684\u653b\u51fb\u6a21\u5f0f\u5e76\u76f8\u5e94\u5730\u95ea\u907f\u3002\u6b65\u9aa42\uff1a\u5728BOSS\u5904\u4e8e\u5f31\u70b9\u65f6\u4f7f\u7528\u4f60\u7684\u7279\u6b8a\u80fd\u529b\u3002\u6b65\u9aa43\uff1a\u5728\u5173\u952e\u65f6\u523b\u4fdd\u7559\u4f53\u529b\u3002\u4f8b\u5982\uff0c\u5728\u6700\u7ec8\u7684\u906d\u9047\u4e2d\uff0c\u5728\u95ea\u907f\u540e\u53ca\u65f6\u4f7f\u7528\u7279\u6b8a\u80fd\u529b\u53ef\u4ee5\u9020\u6210\u5de8\u5927\u7684\u4f24\u5bb3\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u65b9\u6848A - \u6fc0\u8fdb\u7b56\u7565\uff1a\u98ce\u9669\u9ad8\uff0c\u56de\u62a5\u9ad8\u3002\u65b9\u6848B - \u9632\u5b88\u7b56\u7565\uff1a\u98ce\u9669\u4f4e\uff0c\u4f24\u5bb3\u7a33\u5b9a\u3002]"}, {"question": "\u5982\u4f55\u4f18\u5316\u6211\u5728\u6f58\u5fb7\u5c14\u6e38\u620f\u4e2d\u7684\u89d2\u8272\u6784\u5efa\u4ee5\u5e94\u5bf9\u6700\u7ec8\u5185\u5bb9\uff1f", "answer": "\u4f18\u5316\u4f60\u7684\u89d2\u8272\u6784\u5efa\u5305\u62ec\u5e73\u8861\u5c5e\u6027\u548c\u88c5\u5907\u5408\u9002\u7684\u88c5\u5907\u3002\u4e13\u6ce8\u4e8e\u63d0\u9ad8\u4f60\u7684\u653b\u51fb\u548c\u4f53\u529b\u5c5e\u6027\uff0c\u540c\u65f6\u88c5\u5907\u80fd\u591f\u5f3a\u5316\u8fd9\u4e9b\u5c5e\u6027\u7684\u88c5\u5907\u3002\u4f8b\u5982\uff0c\u201c\u52c7\u58eb\u4e4b\u5203\u201d\u663e\u8457\u63d0\u9ad8\u4e86\u653b\u51fb\u529b\uff0c\u975e\u5e38\u9002\u5408\u6700\u7ec8\u5185\u5bb9\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u4f60\u7684\u89d2\u8272\u6784\u5efa\u60f3\u8c61\u6210\u7cbe\u7ec6\u8c03\u6574\u7684\u5f15\u64ce\uff0c\u6bcf\u4e00\u90e8\u5206\u90fd\u5bf9\u6574\u4f53\u6027\u80fd\u505a\u51fa\u8d21\u732e\u3002]"}, {"question": "\u5982\u4f55\u9ad8\u6548\u5730\u91c7\u96c6\u8d44\u6e90\uff1f", "answer": "\u9ad8\u6548\u91c7\u96c6\u8d44\u6e90\u7684\u65b9\u6cd5\u662f\u91cd\u73a9\u9ad8\u6536\u76ca\u5173\u5361\u5e76\u4f7f\u7528\u8d44\u6e90\u63d0\u5347\u88c5\u5907\u3002\u4e13\u6ce8\u4e8e\u62e5\u6709\u591a\u4e2a\u5b9d\u7bb1\u548c\u6389\u843d\u73cd\u8d35\u7269\u54c1\u7684\u5173\u5361\u3002\u4f8b\u5982\uff0c\u201c\u4e30\u9976\u68ee\u6797\u201d\u5173\u5361\u4ee5\u5176\u4e30\u5bcc\u7684\u8d44\u6e90\u6389\u843d\u800c\u95fb\u540d\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u5173\u5361 - \u4e30\u9976\u68ee\u6797\uff0c\u8d44\u6e90 - \u91d1\u5e01\uff0c\u5b9d\u77f3\uff0c\u6750\u6599\u3002]"}, {"question": "\u6f58\u5fb7\u5c14\u6e38\u620f\u4e2d\u7684\u4f24\u5bb3\u8ba1\u7b97\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u6f58\u5fb7\u5c14\u6e38\u620f\u4e2d\u7684\u4f24\u5bb3\u8ba1\u7b97\u7cfb\u7edf\u57fa\u4e8e\u4e00\u4e2a\u516c\u5f0f\uff0c\u8be5\u516c\u5f0f\u8003\u8651\u4e86\u653b\u51fb\u529b\u3001\u9632\u5fa1\u529b\u548c\u66b4\u51fb\u51e0\u7387\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u7684\u653b\u51fb\u529b\u4e3a100\uff0c\u654c\u4eba\u7684\u9632\u5fa1\u529b\u4e3a50\uff0c\u5219\u57fa\u7840\u4f24\u5bb3\u4e3a50\u3002\u66b4\u51fb\u4f1a\u4f7f\u8be5\u4f24\u5bb3\u4e58\u4ee51.5\u3002[\u6d41\u7a0b\u56fe\u89e3: \u653b\u51fb\u529b -> \u51cf\u53bb\u9632\u5fa1\u529b -> \u5e94\u7528\u66b4\u51fb\u500d\u7387 -> \u6700\u7ec8\u4f24\u5bb3\u3002]"}, {"question": "\u5728\u6f58\u5fb7\u5c14\u6e38\u620f\u4e2d\uff0c\u9632\u62a4\u7a7f\u900f\u5c5e\u6027\u4e3a\u4ec0\u4e48\u91cd\u8981\uff1f", "answer": "\u9632\u62a4\u7a7f\u900f\u5c5e\u6027\u5f88\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u964d\u4f4e\u4e86\u654c\u4eba\u7684\u9632\u5fa1\u529b\uff0c\u4f7f\u4f60\u80fd\u591f\u9020\u6210\u66f4\u5927\u7684\u4f24\u5bb3\u3002\u4f8b\u5982\uff0c\u62e5\u670920\u70b9\u9632\u62a4\u7a7f\u900f\uff0c\u4e00\u4e2a\u9632\u5fa1\u529b\u4e3a50\u7684\u654c\u4eba\u6709\u6548\u9632\u5fa1\u529b\u53d8\u4e3a30\uff0c\u4ece\u800c\u63d0\u9ad8\u4f60\u7684\u4f24\u5bb3\u8f93\u51fa\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u9632\u62a4\u7a7f\u900f\u60f3\u8c61\u6210\u4e00\u628a\u94a5\u5319\uff0c\u6253\u5f00\u654c\u4eba\u7684\u9632\u5fa1\uff0c\u4f7f\u4ed6\u4eec\u66f4\u5bb9\u6613\u88ab\u51fb\u8d25\u3002]"}, {"question": "\u662f\u5426\u53ef\u4ee5\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u6211\u7684\u6f58\u5fb7\u5c14\u5b58\u6863\u6570\u636e\uff1f", "answer": "\u662f\u7684\uff0c\u60a8\u53ef\u4ee5\u4f7f\u7528\u4e91\u5b58\u6863\u529f\u80fd\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u60a8\u7684\u6f58\u5fb7\u5c14\u5b58\u6863\u6570\u636e\u3002\u8bf7\u786e\u4fdd\u60a8\u5728\u4e24\u4e2a\u5e73\u53f0\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u8d26\u53f7\u3002\u4f8b\u5982\uff0c\u5c06\u6570\u636e\u4ecePC\u8f6c\u79fb\u5230\u6e38\u620f\u4e3b\u673a\uff0c\u53ef\u4ee5\u8ba9\u4f60\u65e0\u7f1d\u5730\u7ee7\u7eed\u4f60\u7684\u8fdb\u5ea6\u3002[\u65b9\u6848\u5bf9\u6bd4\uff1a\u65b9\u6848A - \u4e91\u5b58\u6863\uff1a\u7b80\u5355\u53ef\u9760\u3002\u65b9\u6848B - \u624b\u52a8\u8f6c\u79fb\uff1a\u9700\u8981\u5916\u90e8\u5b58\u50a8\u8bbe\u5907\u3002]"}, {"question": "\u901a\u8fc7\u63a2\u7d22\u504f\u79bb\u4e3b\u7ebf\u5267\u60c5\u7684\u5185\u5bb9\uff0c\u6211\u53ef\u4ee5\u5728\u6f58\u5fb7\u5c14\u6e38\u620f\u4e2d\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u5185\u5bb9\uff1f", "answer": "\u5728\u6f58\u5fb7\u5c14\u6e38\u620f\u4e2d\u63a2\u7d22\u504f\u79bb\u4e3b\u7ebf\u5267\u60c5\u7684\u5185\u5bb9\uff0c\u53ef\u4ee5\u53d1\u73b0\u9690\u85cf\u7684\u5b9d\u7bb1\u3001\u79d8\u5bc6\u5173\u5361\u548c\u72ec\u7279\u7684\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u201c\u8ff7\u5931\u6d1e\u7a74\u201d\u5173\u5361\u4e2d\uff0c\u4e00\u6761\u9690\u85cf\u8def\u5f84\u901a\u5f80\u4e00\u628a\u7a00\u6709\u6b66\u5668\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u8fd9\u4e9b\u9690\u85cf\u8def\u5f84\u60f3\u8c61\u6210\u5b9d\u85cf\u5730\u56fe\uff0c\u63a2\u7d22\u4e4b\u65c5\u5c06\u83b7\u5f97\u5b9d\u8d35\u7684\u5956\u52b1\u3002]"}]
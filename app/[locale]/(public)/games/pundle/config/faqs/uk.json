[{"question": "\u042f\u043a \u0432\u0438\u043a\u043e\u043d\u0430\u0442\u0438 \u0431\u0430\u0437\u043e\u0432\u0443 \u043a\u043e\u043c\u0431\u0456\u043d\u0430\u0446\u0456\u044e \u0432 Pundle \u044f\u043a \u043f\u043e\u0447\u0430\u0442\u043a\u0456\u0432\u0435\u0446\u044c?", "answer": "\u0429\u043e\u0431 \u0432\u0438\u043a\u043e\u043d\u0430\u0442\u0438 \u0431\u0430\u0437\u043e\u0432\u0443 \u043a\u043e\u043c\u0431\u0456\u043d\u0430\u0446\u0456\u044e \u0432 Pundle, \u0432\u0438\u043a\u043e\u043d\u0430\u0439\u0442\u0435 \u0446\u0456 \u043a\u0440\u043e\u043a\u0438: \u041a\u0420\u041e\u041a 1: \u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u043a\u043b\u0430\u0432\u0456\u0448\u0443 'A', \u0449\u043e\u0431 \u043f\u043e\u0447\u0430\u0442\u0438 \u043b\u0435\u0433\u043a\u0443 \u0430\u0442\u0430\u043a\u0443. \u041a\u0420\u041e\u041a 2: \u0411\u0435\u0437\u043f\u043e\u0441\u0435\u0440\u0435\u0434\u043d\u044c\u043e \u043d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u043a\u043b\u0430\u0432\u0456\u0448\u0443 'B', \u0449\u043e\u0431 \u043f\u0435\u0440\u0435\u0439\u0442\u0438 \u0434\u043e \u0432\u0430\u0436\u043a\u043e\u0457 \u0430\u0442\u0430\u043a\u0438. \u041a\u0420\u041e\u041a 3: \u041d\u0430\u0440\u0435\u0448\u0442\u0456, \u043d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u043a\u043b\u0430\u0432\u0456\u0448\u0443 'X', \u0449\u043e\u0431 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0438 \u0441\u043f\u0435\u0446\u0456\u0430\u043b\u044c\u043d\u043e\u044e \u0430\u0442\u0430\u043a\u043e\u044e. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043d\u0430 \u043f\u0435\u0440\u0448\u043e\u043c\u0443 \u0440\u0456\u0432\u043d\u0456 \u0446\u044f \u043a\u043e\u043c\u0431\u0456\u043d\u0430\u0446\u0456\u044f \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u043f\u0435\u0440\u0435\u043c\u0430\u0433\u0430\u0454 \u043f\u043e\u0447\u0430\u0442\u043a\u043e\u0432\u0443 \u0445\u0432\u0438\u043b\u044e \u0432\u043e\u0440\u043e\u0433\u0456\u0432. [\u041f\u0440\u0438\u043a\u043b\u0430\u0434: \u0423\u044f\u0432\u0456\u0442\u044c \u0446\u044e \u043a\u043e\u043c\u0431\u0456\u043d\u0430\u0446\u0456\u044e \u044f\u043a \u043e\u0434\u043d\u043e-\u0434\u0432\u0430 \u0443\u0434\u0430\u0440\u0438 \u0432 \u0431\u043e\u043a\u0441\u0456, \u0434\u0435 \u043a\u043e\u0436\u0435\u043d \u0440\u0443\u0445 \u0431\u0443\u0434\u0443\u0454\u0442\u044c\u0441\u044f \u043d\u0430 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u043c\u0443 \u0434\u043b\u044f \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0432\u043f\u043b\u0438\u0432\u0443.]"}, {"question": "\u042f\u043a\u0456 \u043e\u0441\u043d\u043e\u0432\u043d\u0456 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u044f \u043f\u043e\u0432\u0438\u043d\u0435\u043d \u043e\u0441\u0432\u043e\u0457\u0442\u0438 \u0432 Pundle?", "answer": "\u041e\u0441\u043d\u043e\u0432\u043d\u0456 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0432 Pundle \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442\u044c \u0440\u0443\u0445, \u0430\u0442\u0430\u043a\u0438 \u0442\u0430 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0441\u043f\u0435\u0446\u0456\u0430\u043b\u044c\u043d\u0438\u0445 \u0437\u0434\u0456\u0431\u043d\u043e\u0441\u0442\u0435\u0439. \u0414\u043b\u044f \u0440\u0443\u0445\u0443 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u043b\u0456\u0432\u0438\u0439 \u0434\u0436\u043e\u0439\u0441\u0442\u0438\u043a, \u0434\u043b\u044f \u043b\u0435\u0433\u043a\u0438\u0445 \u0430\u0442\u0430\u043a - 'A', \u0434\u043b\u044f \u0432\u0430\u0436\u043a\u0438\u0445 \u0430\u0442\u0430\u043a - 'B', \u0430 \u0434\u043b\u044f \u0441\u043f\u0435\u0446\u0456\u0430\u043b\u044c\u043d\u0438\u0445 \u0437\u0434\u0456\u0431\u043d\u043e\u0441\u0442\u0435\u0439 - 'X'. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043e\u0432\u043e\u043b\u043e\u0434\u0456\u043d\u043d\u044f \u0440\u0443\u0445\u043e\u043c \u0443\u0445\u0438\u043b\u0435\u043d\u043d\u044f \u0437 \u043a\u043b\u0430\u0432\u0456\u0448\u0435\u044e 'Y' \u0434\u043e\u043f\u043e\u043c\u043e\u0436\u0435 \u0443\u043d\u0438\u043a\u043d\u0443\u0442\u0438 \u0430\u0442\u0430\u043a \u0432\u043e\u0440\u043e\u0433\u0456\u0432 \u043d\u0430 \u0434\u0440\u0443\u0433\u043e\u043c\u0443 \u0440\u0456\u0432\u043d\u0456. [\u0422\u0430\u0431\u043b\u0438\u0446\u044f \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c: \u041e\u0441\u044c \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u0434\u043e\u0432\u0456\u0434\u043d\u0438\u043a: \u0414\u0436\u043e\u0439\u0441\u0442\u0438\u043a - \u0420\u0443\u0445, A - \u041b\u0435\u0433\u043a\u0430 \u0430\u0442\u0430\u043a\u0430, B - \u0412\u0430\u0436\u043a\u0430 \u0430\u0442\u0430\u043a\u0430, X - \u0421\u043f\u0435\u0446\u0456\u0430\u043b\u044c\u043d\u0430 \u0437\u0434\u0430\u0442\u043d\u0456\u0441\u0442\u044c, Y - \u0420\u0443\u0445 \u0443\u0445\u0438\u043b\u0435\u043d\u043d\u044f.]"}, {"question": "\u0427\u043e\u043c\u0443 \u0440\u043e\u0437\u0443\u043c\u0456\u043d\u043d\u044f \u0441\u043c\u0443\u0433\u0438 \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043b\u043e\u0441\u0442\u0456 \u043c\u0430\u0454 \u0432\u0438\u0440\u0456\u0448\u0430\u043b\u044c\u043d\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0432 Pundle?", "answer": "\u0420\u043e\u0437\u0443\u043c\u0456\u043d\u043d\u044f \u0441\u043c\u0443\u0433\u0438 \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043b\u043e\u0441\u0442\u0456 \u043c\u0430\u0454 \u0432\u0438\u0440\u0456\u0448\u0430\u043b\u044c\u043d\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f, \u0442\u043e\u043c\u0443 \u0449\u043e \u0432\u043e\u043d\u0430 \u043e\u0431\u043c\u0435\u0436\u0443\u0454 \u0432\u0430\u0448\u0456 \u043c\u043e\u0436\u043b\u0438\u0432\u043e\u0441\u0442\u0456 \u0432\u0438\u043a\u043e\u043d\u0443\u0432\u0430\u0442\u0438 \u0434\u0456\u0457. \u041a\u043e\u0436\u043d\u0430 \u0430\u0442\u0430\u043a\u0430 \u0430\u0431\u043e \u0443\u0445\u0438\u043b\u0435\u043d\u043d\u044f \u0441\u043f\u043e\u0436\u0438\u0432\u0430\u0454 \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043b\u0456\u0441\u0442\u044c, \u0456 \u044f\u043a\u0449\u043e \u0432\u043e\u043d\u0430 \u0432\u0438\u0447\u0435\u0440\u043f\u0430\u0454\u0442\u044c\u0441\u044f, \u0432\u0438 \u0441\u0442\u0430\u0454\u0442\u0435 \u0432\u0440\u0430\u0437\u043b\u0438\u0432\u0438\u043c\u0438. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0443 \u0431\u0438\u0442\u0432\u0456 \u0437 \u0431\u043e\u0441\u043e\u043c, \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043b\u0456\u0441\u0442\u044e \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u0454 \u0443\u0445\u0438\u043b\u044f\u0442\u0438\u0441\u044f \u0432\u0456\u0434 \u043a\u0440\u0438\u0442\u0438\u0447\u043d\u0438\u0445 \u0430\u0442\u0430\u043a \u0456 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u043a\u043e\u043d\u0442\u0440\u0430\u0442\u0430\u043a\u0443\u0432\u0430\u0442\u0438. [\u0421\u0445\u0435\u043c\u0430\u0442\u0438\u0447\u043d\u0435 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f \u043f\u0440\u043e\u0446\u0435\u0441\u0443: \u0414\u0456\u044f -> \u0421\u043f\u043e\u0436\u0438\u0432\u0430\u043d\u043d\u044f \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043b\u043e\u0441\u0442\u0456 -> \u0412\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043b\u043e\u0441\u0442\u0456 -> \u041f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u0438.]"}, {"question": "\u042f\u043a\u0456 \u0440\u043e\u0437\u0448\u0438\u0440\u0435\u043d\u0456 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0457 \u043c\u043e\u0436\u0443\u0442\u044c \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0442\u0438 \u043c\u0435\u043d\u0456 \u043f\u0435\u0440\u0435\u043c\u043e\u0433\u0442\u0438 \u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u0431\u043e\u0441\u0430 \u0432 Pundle?", "answer": "\u0429\u043e\u0431 \u043f\u0435\u0440\u0435\u043c\u043e\u0433\u0442\u0438 \u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u0431\u043e\u0441\u0430 \u0432 Pundle, \u0440\u043e\u0437\u0433\u043b\u044f\u043d\u044c\u0442\u0435 \u0446\u0456 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0457: \u041a\u0420\u041e\u041a 1: \u0412\u0438\u0432\u0447\u0456\u0442\u044c \u0441\u0445\u0435\u043c\u0438 \u0430\u0442\u0430\u043a \u0431\u043e\u0441\u0430 \u0442\u0430 \u0443\u0445\u0438\u043b\u044f\u0439\u0442\u0435\u0441\u044f \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u043e. \u041a\u0420\u041e\u041a 2: \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0441\u0432\u043e\u0457 \u0441\u043f\u0435\u0446\u0456\u0430\u043b\u044c\u043d\u0456 \u0437\u0434\u0456\u0431\u043d\u043e\u0441\u0442\u0456, \u043a\u043e\u043b\u0438 \u0431\u043e\u0441 \u0432\u0440\u0430\u0437\u043b\u0438\u0432\u0438\u0439. \u041a\u0420\u041e\u041a 3: \u0415\u043a\u043e\u043d\u043e\u043c\u0442\u0435 \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043b\u0456\u0441\u0442\u044c \u0434\u043b\u044f \u043a\u0440\u0438\u0442\u0438\u0447\u043d\u0438\u0445 \u043c\u043e\u043c\u0435\u043d\u0442\u0456\u0432. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0443 \u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u0456\u0439 \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0456, \u0432\u043b\u0443\u0447\u0435\u043d\u043d\u044f \u0441\u0432\u043e\u0454\u0457 \u0441\u043f\u0435\u0446\u0456\u0430\u043b\u044c\u043d\u043e\u0457 \u0437\u0434\u0456\u0431\u043d\u043e\u0441\u0442\u0456 \u043f\u0456\u0441\u043b\u044f \u0443\u0445\u0438\u043b\u0435\u043d\u043d\u044f \u043c\u043e\u0436\u0435 \u0437\u0430\u0432\u0434\u0430\u0442\u0438 \u0437\u043d\u0430\u0447\u043d\u043e\u0457 \u0448\u043a\u043e\u0434\u0438. [\u041f\u043e\u0440\u0456\u0432\u043d\u044f\u043d\u043d\u044f \u0440\u0456\u0437\u043d\u0438\u0445 \u0432\u0430\u0440\u0456\u0430\u043d\u0442\u0456\u0432: \u0412\u0430\u0440\u0456\u0430\u043d\u0442 \u0410 - \u0410\u0433\u0440\u0435\u0441\u0438\u0432\u043d\u0438\u0439 \u043f\u0456\u0434\u0445\u0456\u0434: \u0412\u0438\u0441\u043e\u043a\u0438\u0439 \u0440\u0438\u0437\u0438\u043a, \u0432\u0438\u0441\u043e\u043a\u0430 \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0430. \u0412\u0430\u0440\u0456\u0430\u043d\u0442 \u0411 - \u041e\u0431\u043e\u0440\u043e\u043d\u043d\u0438\u0439 \u043f\u0456\u0434\u0445\u0456\u0434: \u041d\u0438\u0437\u044c\u043a\u0438\u0439 \u0440\u0438\u0437\u0438\u043a, \u0441\u0442\u0430\u0431\u0456\u043b\u044c\u043d\u0438\u0439 \u0443\u0440\u043e\u043d.]"}, {"question": "\u042f\u043a \u044f \u043c\u043e\u0436\u0443 \u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0441\u0432\u043e\u044e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0443 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0430 \u0432 Pundle \u0434\u043b\u044f \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u0443 \u043a\u0456\u043d\u0446\u0435\u0432\u043e\u0457 \u0433\u0440\u0438?", "answer": "\u041e\u043f\u0442\u0438\u043c\u0456\u0437\u0430\u0446\u0456\u044f \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a \u0432\u0430\u0448\u043e\u0433\u043e \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0430 \u043f\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0430\u0454 \u0431\u0430\u043b\u0430\u043d\u0441\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0456\u0432 \u0442\u0430 \u043e\u0431\u043b\u0430\u0434\u043d\u0430\u043d\u043d\u044f \u043d\u0430\u043b\u0435\u0436\u043d\u043e\u0433\u043e \u0435\u043a\u0456\u043f\u0456\u0440\u0443\u0432\u0430\u043d\u043d\u044f. \u0417\u043e\u0441\u0435\u0440\u0435\u0434\u044c\u0442\u0435\u0441\u044f \u043d\u0430 \u0437\u0431\u0456\u043b\u044c\u0448\u0435\u043d\u043d\u0456 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0456\u0432 \u0430\u0442\u0430\u043a\u0438 \u0442\u0430 \u0432\u0438\u0442\u0440\u0438\u0432\u0430\u043b\u043e\u0441\u0442\u0456, \u043e\u0434\u043d\u043e\u0447\u0430\u0441\u043d\u043e \u043e\u0431\u043b\u0430\u0434\u043d\u0443\u044e\u0447\u0438 \u0435\u043a\u0456\u043f\u0456\u0440\u0443\u0432\u0430\u043d\u043d\u044f, \u0449\u043e \u043f\u043e\u043a\u0440\u0430\u0449\u0443\u0454 \u0446\u0456 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \"\u041a\u043b\u0438\u043d\u043e\u043a \u0421\u043b\u0430\u0432\u043d\u043e\u0433\u043e\" \u0437\u043d\u0430\u0447\u043d\u043e \u0437\u0431\u0456\u043b\u044c\u0448\u0443\u0454 \u0441\u0438\u043b\u0443 \u0430\u0442\u0430\u043a\u0438, \u0449\u043e \u0440\u043e\u0431\u0438\u0442\u044c \u0439\u043e\u0433\u043e \u0456\u0434\u0435\u0430\u043b\u044c\u043d\u0438\u043c \u0434\u043b\u044f \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u0443 \u043a\u0456\u043d\u0446\u0435\u0432\u043e\u0457 \u0433\u0440\u0438. [\u041f\u0440\u0438\u043a\u043b\u0430\u0434: \u0423\u044f\u0432\u0456\u0442\u044c \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438 \u0432\u0430\u0448\u043e\u0433\u043e \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0430 \u044f\u043a \u0434\u043e\u0431\u0440\u0435 \u0432\u0456\u0434\u0440\u0435\u0433\u0443\u043b\u044c\u043e\u0432\u0430\u043d\u0438\u0439 \u0434\u0432\u0438\u0433\u0443\u043d, \u0434\u0435 \u043a\u043e\u0436\u043d\u0430 \u0434\u0435\u0442\u0430\u043b\u044c \u0432\u043d\u0435\u0441 \u0432\u043a\u043b\u0430\u0434 \u0434\u043e \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u043e\u0457 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0456.]"}, {"question": "\u042f\u043a\u0438\u043c \u0454 \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u0439 \u0441\u043f\u043e\u0441\u0456\u0431 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u0437\u0431\u0438\u0440\u0430\u0442\u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u0438 \u0432 Pundle?", "answer": "\u041d\u0430\u0439\u043a\u0440\u0430\u0449\u0438\u0439 \u0441\u043f\u043e\u0441\u0456\u0431 \u0437\u0431\u043e\u0440\u0443 \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u043f\u043e\u043b\u044f\u0433\u0430\u0454 \u0443 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e\u043c\u0443 \u043f\u0440\u043e\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u0456 \u0440\u0456\u0432\u043d\u0456\u0432 \u0437 \u0432\u0438\u0441\u043e\u043a\u043e\u044e \u0432\u0456\u0434\u0434\u0430\u0447\u0435\u044e \u0442\u0430 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u0456 \u043e\u0431\u043b\u0430\u0434\u043d\u0430\u043d\u043d\u044f, \u0449\u043e \u043f\u043e\u043a\u0440\u0430\u0449\u0443\u0454 \u0437\u0431\u0456\u0440 \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432. \u0417\u043e\u0441\u0435\u0440\u0435\u0434\u044c\u0442\u0435\u0441\u044f \u043d\u0430 \u0440\u0456\u0432\u043d\u044f\u0445 \u0437 \u043a\u0456\u043b\u044c\u043a\u043e\u043c\u0430 \u0441\u043a\u0440\u0438\u043d\u044f\u043c\u0438 \u0442\u0430 \u0432\u043e\u0440\u043e\u0433\u0430\u043c\u0438, \u044f\u043a\u0456 \u0441\u043a\u0438\u0434\u0430\u044e\u0442\u044c \u0446\u0456\u043d\u043d\u0456 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0438. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0440\u0456\u0432\u0435\u043d\u044c \"\u041b\u0456\u0441 \u0411\u0430\u0433\u0430\u0442\u0441\u0442\u0432\u0430\" \u0432\u0456\u0434\u043e\u043c\u0438\u0439 \u0432\u0435\u043b\u0438\u043a\u043e\u044e \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044e \u043f\u0430\u0434\u0456\u043d\u044c \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432. [\u0422\u0430\u0431\u043b\u0438\u0446\u044f \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c: \u0420\u0456\u0432\u0435\u043d\u044c - \u041b\u0456\u0441 \u0411\u0430\u0433\u0430\u0442\u0441\u0442\u0432\u0430, \u0420\u0435\u0441\u0443\u0440\u0441\u0438 - \u0417\u043e\u043b\u043e\u0442\u043e, \u041a\u0430\u043c\u0435\u043d\u0456, \u041c\u0430\u0442\u0435\u0440\u0456\u0430\u043b\u0438.]"}, {"question": "\u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0440\u043e\u0437\u0440\u0430\u0445\u0443\u043d\u043a\u0443 \u0448\u043a\u043e\u0434\u0438 \u0432 Pundle?", "answer": "\u0421\u0438\u0441\u0442\u0435\u043c\u0430 \u0440\u043e\u0437\u0440\u0430\u0445\u0443\u043d\u043a\u0443 \u0448\u043a\u043e\u0434\u0438 \u0432 Pundle \u0431\u0430\u0437\u0443\u0454\u0442\u044c\u0441\u044f \u043d\u0430 \u0444\u043e\u0440\u043c\u0443\u043b\u0456, \u044f\u043a\u0430 \u0432\u0440\u0430\u0445\u043e\u0432\u0443\u0454 \u0441\u0438\u043b\u0443 \u0430\u0442\u0430\u043a\u0438, \u043e\u0431\u043e\u0440\u043e\u043d\u0438 \u0442\u0430 \u0439\u043c\u043e\u0432\u0456\u0440\u043d\u043e\u0441\u0442\u0456 \u043a\u0440\u0438\u0442\u0438\u0447\u043d\u043e\u0433\u043e \u0443\u0434\u0430\u0440\u0443. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u044f\u043a\u0449\u043e \u0432\u0430\u0448\u0430 \u0441\u0438\u043b\u0430 \u0430\u0442\u0430\u043a\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c 100, \u0430 \u043e\u0431\u043e\u0440\u043e\u043d\u0430 \u0432\u043e\u0440\u043e\u0433\u0430 - 50, \u0442\u043e \u0431\u0430\u0437\u043e\u0432\u0438\u0439 \u0443\u0440\u043e\u043d \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c 50. \u041a\u0440\u0438\u0442\u0438\u0447\u043d\u0456 \u0443\u0434\u0430\u0440\u0438 \u043c\u043d\u043e\u0436\u0430\u0442\u044c \u0446\u0435\u0439 \u0443\u0440\u043e\u043d \u043d\u0430 1,5. [\u0421\u0445\u0435\u043c\u0430\u0442\u0438\u0447\u043d\u0435 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f \u043f\u0440\u043e\u0446\u0435\u0441\u0443: \u0421\u0438\u043b\u0430 \u0430\u0442\u0430\u043a\u0438 -> \u0412\u0456\u0434\u043d\u0456\u043c\u0430\u043d\u043d\u044f \u043e\u0431\u043e\u0440\u043e\u043d\u0438 -> \u0417\u0430\u0441\u0442\u043e\u0441\u0443\u0432\u0430\u043d\u043d\u044f \u043c\u043d\u043e\u0436\u043d\u0438\u043a\u0430 \u043a\u0440\u0438\u0442\u0438\u0447\u043d\u043e\u0457 \u0448\u043a\u043e\u0434\u0438 -> \u041e\u0441\u0442\u0430\u043d\u043d\u0456\u0439 \u0443\u0440\u043e\u043d.]"}, {"question": "\u0427\u043e\u043c\u0443 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440 \u043f\u0440\u043e\u0431\u0438\u0442\u0442\u044f \u0431\u0440\u043e\u043d\u0456 \u0432\u0430\u0436\u043b\u0438\u0432\u0438\u0439 \u0443 Pundle?", "answer": "\u041f\u0430\u0440\u0430\u043c\u0435\u0442\u0440 \u043f\u0440\u043e\u0431\u0438\u0442\u0442\u044f \u0431\u0440\u043e\u043d\u0456 \u0432\u0430\u0436\u043b\u0438\u0432\u0438\u0439, \u043e\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u0432\u0456\u043d \u0437\u043c\u0435\u043d\u0448\u0443\u0454 \u043e\u0431\u043e\u0440\u043e\u043d\u0443 \u0432\u043e\u0440\u043e\u0433\u0430, \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0447\u0438 \u0437\u0430\u0432\u0434\u0430\u0432\u0430\u0442\u0438 \u0431\u0456\u043b\u044c\u0448\u043e\u0457 \u0448\u043a\u043e\u0434\u0438. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043f\u0440\u0438 20 \u043e\u0434\u0438\u043d\u0438\u0446\u044f\u0445 \u043f\u0440\u043e\u0431\u0438\u0442\u0442\u044f \u0431\u0440\u043e\u043d\u0456 \u0432\u043e\u0440\u043e\u0433 \u0437 50 \u043e\u0434\u0438\u043d\u0438\u0446\u044f\u043c\u0438 \u043e\u0431\u043e\u0440\u043e\u043d\u0438 \u0444\u0430\u043a\u0442\u0438\u0447\u043d\u043e \u043c\u0430\u0454 30 \u043e\u0434\u0438\u043d\u0438\u0446\u044c \u043e\u0431\u043e\u0440\u043e\u043d\u0438, \u0449\u043e \u0437\u0431\u0456\u043b\u044c\u0448\u0443\u0454 \u0432\u0430\u0448 \u0443\u0440\u043e\u043d. [\u041f\u0440\u0438\u043a\u043b\u0430\u0434: \u0423\u044f\u0432\u0456\u0442\u044c \u043f\u0440\u043e\u0431\u0438\u0442\u0442\u044f \u0431\u0440\u043e\u043d\u0456 \u044f\u043a \u043a\u043b\u044e\u0447, \u044f\u043a\u0438\u0439 \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u0454 \u043e\u0431\u043e\u0440\u043e\u043d\u0443 \u0432\u043e\u0440\u043e\u0433\u0430, \u0440\u043e\u0431\u043b\u044f\u0447\u0438 \u0439\u043e\u0433\u043e \u043b\u0435\u0433\u0448\u0438\u043c \u0434\u043b\u044f \u043f\u043e\u0440\u0430\u0437\u043a\u0438.]"}, {"question": "\u0427\u0438 \u043c\u043e\u0436\u0443 \u044f \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0442\u0438 \u0434\u0430\u043d\u0456 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f Pundle \u043c\u0456\u0436 \u0440\u0456\u0437\u043d\u0438\u043c\u0438 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430\u043c\u0438?", "answer": "\u0422\u0430\u043a, \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0442\u0438 \u0434\u0430\u043d\u0456 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f Pundle \u043c\u0456\u0436 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430\u043c\u0438 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0444\u0443\u043d\u043a\u0446\u0456\u0457 \u0445\u043c\u0430\u0440\u043d\u043e\u0433\u043e \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f. \u041f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044c, \u0449\u043e \u0432\u0438 \u0443\u0432\u0456\u0439\u0448\u043b\u0438 \u0432 \u0441\u0432\u043e\u044e \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441 \u043d\u0430 \u043e\u0431\u043e\u0445 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430\u0445. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0435\u043d\u043d\u044f \u0434\u0430\u043d\u0438\u0445 \u0437 \u041f\u041a \u043d\u0430 \u043a\u043e\u043d\u0441\u043e\u043b\u044c \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u0454 \u0431\u0435\u0437\u043f\u0435\u0440\u0435\u0431\u0456\u0439\u043d\u043e \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u0438 \u0441\u0432\u0456\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441. [\u041f\u043e\u0440\u0456\u0432\u043d\u044f\u043d\u043d\u044f \u0432\u0430\u0440\u0456\u0430\u043d\u0442\u0456\u0432: \u0412\u0430\u0440\u0456\u0430\u043d\u0442 \u0410 - \u0425\u043c\u0430\u0440\u043d\u0435 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f: \u041b\u0435\u0433\u043a\u043e \u0442\u0430 \u043d\u0430\u0434\u0456\u0439\u043d\u043e. \u0412\u0430\u0440\u0456\u0430\u043d\u0442 \u0411 - \u0420\u0443\u0447\u043d\u0435 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0435\u043d\u043d\u044f: \u041d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u0435 \u0437\u043e\u0432\u043d\u0456\u0448\u043d\u0454 \u0441\u0445\u043e\u0432\u0438\u0449\u0435.]"}, {"question": "\u042f\u043a\u0438\u0439 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0438\u0439 \u0432\u043c\u0456\u0441\u0442 \u044f \u043c\u043e\u0436\u0443 \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u0438 \u0432 Pundle, \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0443\u044e\u0447\u0438 \u043f\u043e\u0437\u0430 \u0441\u0442\u0435\u0436\u043a\u043e\u044e?", "answer": "\u0414\u043e\u0441\u043b\u0456\u0434\u0436\u0443\u044e\u0447\u0438 \u043f\u043e\u0437\u0430 \u0441\u0442\u0435\u0436\u043a\u043e\u044e \u0432 Pundle, \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u043d\u0430\u0439\u0442\u0438 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 \u0441\u043a\u0440\u0438\u043d\u0456, \u0441\u0435\u043a\u0440\u0435\u0442\u043d\u0456 \u0440\u0456\u0432\u043d\u0456 \u0442\u0430 \u0443\u043d\u0456\u043a\u0430\u043b\u044c\u043d\u0456 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0438. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043d\u0430 \u0440\u0456\u0432\u043d\u0456 \"\u0417\u0430\u0433\u0443\u0431\u043b\u0435\u043d\u0456 \u043f\u0435\u0447\u0435\u0440\u0438\" \u0442\u0430\u0454\u043c\u043d\u0438\u0439 \u0448\u043b\u044f\u0445 \u0432\u0435\u0434\u0435 \u0434\u043e \u0440\u0456\u0434\u043a\u0456\u0441\u043d\u043e\u0457 \u0437\u0431\u0440\u043e\u0457. [\u041f\u0440\u0438\u043a\u043b\u0430\u0434: \u0423\u044f\u0432\u0456\u0442\u044c \u0446\u0456 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 \u0448\u043b\u044f\u0445\u0438 \u044f\u043a \u043a\u0430\u0440\u0442\u0438 \u0441\u043a\u0430\u0440\u0431\u0456\u0432, \u0434\u0435 \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u044f \u0432\u0435\u0434\u0435 \u0434\u043e \u0446\u0456\u043d\u043d\u0438\u0445 \u0432\u0438\u043d\u0430\u0433\u043e\u0440\u043e\u0434.]"}]
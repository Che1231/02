[{"question": "\u5982\u4f55\u9032\u884c\u84ec\u9054\u65b0\u624b\u7684\u57fa\u672c\u9023\u64ca\uff1f", "answer": "\u5728\u84ec\u9054\u57f7\u884c\u57fa\u672c\u9023\u64ca\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u6309\u4e0b\"A\"\u9375\u958b\u59cb\u8f15\u653b\u64ca\u3002\u6b65\u9a5f2\uff1a\u7acb\u5373\u6309\u4e0b\"B\"\u9375\u9023\u63a5\u91cd\u653b\u64ca\u3002\u6b65\u9a5f3\uff1a\u6700\u5f8c\u6309\u4e0b\"X\"\u9375\u4ee5\u7279\u6b8a\u52d5\u4f5c\u7d50\u675f\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u95dc\u4e2d\uff0c\u6b64\u9023\u64ca\u53ef\u4ee5\u6709\u6548\u64ca\u6557\u521d\u59cb\u6575\u4eba\u6ce2\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u6b64\u9023\u64ca\u60f3\u50cf\u6210\u62f3\u64ca\u4e2d\u7684\u9023\u74b0\u5feb\u6253\uff0c\u6bcf\u4e00\u6b21\u52d5\u4f5c\u90fd\u5efa\u7acb\u5728\u524d\u4e00\u500b\u52d5\u4f5c\u7684\u57fa\u790e\u4e0a\uff0c\u4ee5\u6700\u5927\u5316\u885d\u64ca\u529b\u3002]"}, {"question": "\u5728\u84ec\u9054\u4e2d\uff0c\u6211\u9700\u8981\u638c\u63e1\u54ea\u4e9b\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u84ec\u9054\u7684\u57fa\u672c\u63a7\u5236\u5305\u62ec\u79fb\u52d5\u3001\u653b\u64ca\u548c\u4f7f\u7528\u7279\u6b8a\u80fd\u529b\u3002\u4f7f\u7528\u5de6\u6416\u687f\u9032\u884c\u79fb\u52d5\uff0c\"A\"\u9375\u9032\u884c\u8f15\u653b\u64ca\uff0c\"B\"\u9375\u9032\u884c\u91cd\u653b\u64ca\uff0c\"X\"\u9375\u9032\u884c\u7279\u6b8a\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u638c\u63e1\"Y\"\u9375\u7684\u9583\u907f\u6efe\u52d5\uff0c\u53ef\u4ee5\u5e6b\u52a9\u4f60\u5728\u7b2c\u4e8c\u95dc\u8eb2\u907f\u6575\u4eba\u7684\u653b\u64ca\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6416\u687f - \u79fb\u52d5\uff0cA - \u8f15\u653b\u64ca\uff0cB - \u91cd\u653b\u64ca\uff0cX - \u7279\u6b8a\u80fd\u529b\uff0cY - \u9583\u907f\u6efe\u52d5\u3002]"}, {"question": "\u5728\u84ec\u9054\u4e2d\uff0c\u70ba\u4ec0\u9ebc\u7406\u89e3\u7cbe\u529b\u689d\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u7406\u89e3\u7cbe\u529b\u689d\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u9650\u5236\u4e86\u4f60\u7684\u884c\u52d5\u80fd\u529b\u3002\u6bcf\u6b21\u653b\u64ca\u6216\u9583\u907f\u90fd\u6703\u6d88\u8017\u7cbe\u529b\uff0c\u5982\u679c\u7cbe\u529b\u8017\u76e1\uff0c\u4f60\u5c31\u6703\u8b8a\u5f97\u8106\u5f31\u3002\u4f8b\u5982\uff0c\u5728\u8207\u9996\u9818\u6230\u9b25\u6642\uff0c\u6709\u6548\u7ba1\u7406\u4f60\u7684\u7cbe\u529b\u53ef\u4ee5\u8b93\u4f60\u8eb2\u907f\u95dc\u9375\u653b\u64ca\u4e26\u6709\u6548\u53cd\u64ca\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u884c\u52d5 -> \u7cbe\u529b\u6d88\u8017 -> \u7cbe\u529b\u6062\u5fa9 -> \u91cd\u8907\u3002]"}, {"question": "\u54ea\u4e9b\u5148\u9032\u7b56\u7565\u53ef\u4ee5\u5e6b\u52a9\u6211\u5728\u84ec\u9054\u64ca\u6557\u6700\u7d42\u9996\u9818\uff1f", "answer": "\u8981\u64ca\u6557\u84ec\u9054\u7684\u6700\u7d42\u9996\u9818\uff0c\u8acb\u8003\u616e\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9a5f1\uff1a\u5b78\u7fd2\u9996\u9818\u7684\u653b\u64ca\u6a21\u5f0f\u4e26\u76f8\u61c9\u5730\u9583\u907f\u3002\u6b65\u9a5f2\uff1a\u5728\u9996\u9818\u8106\u5f31\u6642\u4f7f\u7528\u4f60\u7684\u7279\u6b8a\u80fd\u529b\u3002\u6b65\u9a5f3\uff1a\u5728\u95dc\u9375\u6642\u523b\u7bc0\u7d04\u7cbe\u529b\u3002\u4f8b\u5982\uff0c\u5728\u6700\u5f8c\u7684\u5c0d\u6c7a\u4e2d\uff0c\u5728\u9583\u907f\u5f8c\u9069\u6642\u4f7f\u7528\u7279\u6b8a\u80fd\u529b\u53ef\u4ee5\u9020\u6210\u5de8\u5927\u7684\u50b7\u5bb3\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u65b9\u6848A - \u6fc0\u9032\u65b9\u6cd5\uff1a\u98a8\u96aa\u9ad8\uff0c\u56de\u5831\u9ad8\u3002\u65b9\u6848B - \u9632\u79a6\u65b9\u6cd5\uff1a\u98a8\u96aa\u4f4e\uff0c\u50b7\u5bb3\u7a69\u5b9a\u3002]"}, {"question": "\u5982\u4f55\u5728\u84ec\u9054\u7684\u6700\u7d42\u5167\u5bb9\u4e2d\u512a\u5316\u6211\u7684\u89d2\u8272\u914d\u7f6e\uff1f", "answer": "\u512a\u5316\u4f60\u7684\u89d2\u8272\u914d\u7f6e\u5305\u62ec\u5e73\u8861\u5c6c\u6027\u4e26\u88dd\u5099\u5408\u9069\u7684\u88dd\u5099\u3002\u5c08\u6ce8\u65bc\u63d0\u9ad8\u4f60\u7684\u653b\u64ca\u548c\u7cbe\u529b\u5c6c\u6027\uff0c\u4e26\u88dd\u5099\u53ef\u4ee5\u589e\u5f37\u9019\u4e9b\u5c6c\u6027\u7684\u88dd\u5099\u3002\u4f8b\u5982\uff0c\"\u52c7\u6c23\u4e4b\u5203\"\u986f\u8457\u63d0\u9ad8\u4e86\u653b\u64ca\u529b\uff0c\u4f7f\u5176\u975e\u5e38\u9069\u5408\u6700\u7d42\u5167\u5bb9\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u4f60\u7684\u89d2\u8272\u914d\u7f6e\u60f3\u50cf\u6210\u7cbe\u5bc6\u7684\u5f15\u64ce\uff0c\u5176\u4e2d\u6bcf\u500b\u90e8\u4ef6\u90fd\u8ca2\u737b\u65bc\u6574\u9ad4\u6027\u80fd\u3002]"}, {"question": "\u5982\u4f55\u6709\u6548\u5730\u5728\u5730\u5716\u4e2d\u6536\u96c6\u8cc7\u6e90\uff1f", "answer": "\u6709\u6548\u6536\u96c6\u8cc7\u6e90\u7684\u65b9\u6cd5\u662f\u91cd\u73a9\u9ad8\u7522\u51fa\u95dc\u5361\uff0c\u4e26\u4f7f\u7528\u63d0\u5347\u8cc7\u6e90\u7684\u88dd\u5099\u3002\u5c08\u6ce8\u65bc\u5305\u542b\u591a\u500b\u5bf6\u7bb1\u548c\u6389\u843d\u8cb4\u91cd\u7269\u54c1\u7684\u6575\u4eba\u7684\u95dc\u5361\u3002\u4f8b\u5982\uff0c\"\u8c50\u76db\u68ee\u6797\"\u95dc\u5361\u4ee5\u5176\u8c50\u5bcc\u7684\u8cc7\u6e90\u6389\u843d\u800c\u805e\u540d\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u95dc\u5361 - \u8c50\u76db\u68ee\u6797\uff0c\u8cc7\u6e90 - \u91d1\u9322\uff0c\u5bf6\u77f3\uff0c\u6750\u6599\u3002]"}, {"question": "\u84ec\u9054\u7684\u50b7\u5bb3\u8a08\u7b97\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u84ec\u9054\u7684\u50b7\u5bb3\u8a08\u7b97\u7cfb\u7d71\u57fa\u65bc\u4e00\u500b\u516c\u5f0f\uff0c\u8003\u616e\u653b\u64ca\u529b\u3001\u9632\u79a6\u529b\u548c\u66b4\u64ca\u7387\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u7684\u653b\u64ca\u529b\u662f100\uff0c\u6575\u4eba\u7684\u9632\u79a6\u529b\u662f50\uff0c\u57fa\u672c\u50b7\u5bb3\u662f50\u3002\u66b4\u64ca\u6703\u5c07\u6b64\u50b7\u5bb3\u4e58\u4ee51.5\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u653b\u64ca\u529b -> \u6e1b\u53bb\u9632\u79a6\u529b -> \u61c9\u7528\u66b4\u64ca\u500d\u6578 -> \u6700\u7d42\u50b7\u5bb3\u3002]"}, {"question": "\u5728\u84ec\u9054\u4e2d\uff0c\u88dd\u7532\u7a7f\u900f\u5c6c\u6027\u70ba\u4ec0\u9ebc\u91cd\u8981\uff1f", "answer": "\u88dd\u7532\u7a7f\u900f\u5c6c\u6027\u5f88\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u964d\u4f4e\u4e86\u6575\u4eba\u7684\u9632\u79a6\u529b\uff0c\u4f7f\u4f60\u80fd\u5920\u9020\u6210\u66f4\u591a\u50b7\u5bb3\u3002\u4f8b\u5982\uff0c\u64c1\u670920\u9ede\u88dd\u7532\u7a7f\u900f\uff0c\u4e00\u500b\u9632\u79a6\u529b\u70ba50\u7684\u6575\u4eba\u5be6\u969b\u4e0a\u53ea\u670930\u9ede\u9632\u79a6\u529b\uff0c\u9019\u5c07\u63d0\u9ad8\u4f60\u7684\u50b7\u5bb3\u8f38\u51fa\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u88dd\u7532\u7a7f\u900f\u60f3\u50cf\u6210\u4e00\u628a\u9470\u5319\uff0c\u53ef\u4ee5\u89e3\u9396\u6575\u4eba\u7684\u9632\u79a6\uff0c\u4f7f\u5176\u66f4\u5bb9\u6613\u88ab\u64ca\u6557\u3002]"}, {"question": "\u6211\u53ef\u4ee5\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u9593\u8f49\u79fb\u6211\u7684\u84ec\u9054\u5132\u5b58\u6578\u64da\u55ce\uff1f", "answer": "\u662f\u7684\uff0c\u4f60\u53ef\u4ee5\u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u9593\u8f49\u79fb\u4f60\u7684\u84ec\u9054\u5132\u5b58\u6578\u64da\u3002\u78ba\u4fdd\u4f60\u5728\u5169\u500b\u5e73\u53f0\u90fd\u767b\u9304\u540c\u4e00\u500b\u5e33\u6236\u3002\u4f8b\u5982\uff0c\u5f9e\u96fb\u8166\u8f49\u79fb\u5230\u4e3b\u6a5f\u904a\u6232\u6578\u64da\u53ef\u4ee5\u8b93\u4f60\u9806\u5229\u7e7c\u7e8c\u4f60\u7684\u9032\u5ea6\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u65b9\u6848A - \u96f2\u7aef\u5132\u5b58\uff1a\u7c21\u55ae\u53ef\u9760\u3002\u65b9\u6848B - \u624b\u52d5\u8f49\u79fb\uff1a\u9700\u8981\u5916\u90e8\u5132\u5b58\u8a2d\u5099\u3002]"}, {"question": "\u6211\u900f\u904e\u63a2\u7d22\u504f\u50fb\u8def\u7dda\uff0c\u53ef\u4ee5\u5728\u84ec\u9054\u4e2d\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u5167\u5bb9\uff1f", "answer": "\u5728\u84ec\u9054\u4e2d\u63a2\u7d22\u504f\u50fb\u8def\u7dda\u53ef\u4ee5\u767c\u73fe\u96b1\u85cf\u7684\u5bf6\u7bb1\u3001\u79d8\u5bc6\u95dc\u5361\u548c\u7368\u7279\u7684\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5728\"\u5931\u843d\u6d1e\u7a74\"\u95dc\u5361\u4e2d\uff0c\u4e00\u689d\u96b1\u85cf\u8def\u7dda\u901a\u5f80\u4e00\u628a\u7a00\u6709\u6b66\u5668\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u9019\u4e9b\u96b1\u85cf\u8def\u7dda\u60f3\u50cf\u6210\u85cf\u5bf6\u5716\uff0c\u63a2\u7d22\u5c07\u901a\u5f80\u6709\u50f9\u503c\u7684\u734e\u52f5\u3002]"}]
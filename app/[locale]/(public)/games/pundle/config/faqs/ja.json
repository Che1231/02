[{"question": "\u30d1\u30f3\u30c9\u30eb\u306e\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001\u57fa\u672c\u30b3\u30f3\u30dc\u3092\u3069\u306e\u3088\u3046\u306b\u5b9f\u884c\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30f3\u30c9\u30eb\u306e\u57fa\u672c\u30b3\u30f3\u30dc\u3092\u5b9f\u884c\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u8efd\u3044\u653b\u6483\u3092\u958b\u59cb\u3059\u308b\u305f\u3081\u306b\u300eA\u300f\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u3059\u3050\u306b\u300eB\u300f\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u3066\u3001\u91cd\u3044\u653b\u6483\u306b\u7e4b\u3052\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6700\u5f8c\u306b\u300eX\u300f\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u3066\u3001\u7279\u6b8a\u653b\u6483\u3067\u7d42\u4e86\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u3053\u306e\u30b3\u30f3\u30dc\u3067\u6575\u306e\u6700\u521d\u306e\u6ce2\u3092\u52b9\u7387\u7684\u306b\u5012\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u3053\u306e\u30b3\u30f3\u30dc\u3092\u30dc\u30af\u30b7\u30f3\u30b0\u306e\u30ef\u30f3\u30c4\u30fc\u30d1\u30f3\u30c1\u3068\u8003\u3048\u3001\u5404\u653b\u6483\u304c\u6700\u5927\u306e\u5f71\u97ff\u529b\u306e\u305f\u3081\u306b\u524d\u306e\u653b\u6483\u306b\u57fa\u3065\u3044\u3066\u3044\u308b\u3068\u6349\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30d1\u30f3\u30c9\u30eb\u3067\u30de\u30b9\u30bf\u30fc\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u5fc5\u9808\u306e\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30f3\u30c9\u30eb\u3067\u5fc5\u9808\u306e\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u306b\u306f\u3001\u79fb\u52d5\u3001\u653b\u6483\u3001\u7279\u6b8a\u80fd\u529b\u306e\u4f7f\u7528\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u5de6\u30b9\u30c6\u30a3\u30c3\u30af\u3067\u79fb\u52d5\u3057\u3001\u300eA\u300f\u30dc\u30bf\u30f3\u3067\u8efd\u3044\u653b\u6483\u3001\u300eB\u300f\u30dc\u30bf\u30f3\u3067\u91cd\u3044\u653b\u6483\u3001\u300eX\u300f\u30dc\u30bf\u30f3\u3067\u7279\u6b8a\u80fd\u529b\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300eY\u300f\u30dc\u30bf\u30f3\u3092\u4f7f\u3063\u305f\u56de\u907f\u30ed\u30fc\u30eb\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u3067\u30012\u756a\u76ee\u306e\u30ec\u30d9\u30eb\u3067\u6575\u306e\u653b\u6483\u3092\u56de\u907f\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002[\u5bfe\u5fdc\u8868\uff1a\u30b9\u30c6\u30a3\u30c3\u30af-\u79fb\u52d5\u3001A-\u8efd\u3044\u653b\u6483\u3001B-\u91cd\u3044\u653b\u6483\u3001X-\u7279\u6b8a\u80fd\u529b\u3001Y-\u56de\u907f\u30ed\u30fc\u30eb\u3002]"}, {"question": "\u30d1\u30f3\u30c9\u30eb\u3067\u30b9\u30bf\u30df\u30ca\u30d0\u30fc\u306e\u7406\u89e3\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30bf\u30df\u30ca\u30d0\u30fc\u306e\u7406\u89e3\u304c\u91cd\u8981\u306a\u306e\u306f\u3001\u305d\u308c\u304c\u3042\u306a\u305f\u306e\u884c\u52d5\u3092\u5b9f\u884c\u3059\u308b\u80fd\u529b\u3092\u5236\u9650\u3059\u308b\u305f\u3081\u3067\u3059\u3002\u5404\u653b\u6483\u3084\u56de\u907f\u306f\u30b9\u30bf\u30df\u30ca\u3092\u6d88\u8cbb\u3057\u3001\u305d\u308c\u304c\u67af\u6e07\u3059\u308b\u3068\u3001\u3042\u306a\u305f\u306f\u5f31\u4f53\u306b\u306a\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30dc\u30b9\u6226\u3067\u306f\u3001\u30b9\u30bf\u30df\u30ca\u3092\u7ba1\u7406\u3059\u308b\u3053\u3068\u3067\u3001\u91cd\u8981\u306a\u653b\u6483\u3092\u56de\u907f\u3057\u3001\u52b9\u679c\u7684\u306b\u53cd\u6483\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30a2\u30af\u30b7\u30e7\u30f3->\u30b9\u30bf\u30df\u30ca\u6d88\u8cbb->\u30b9\u30bf\u30df\u30ca\u56de\u5fa9->\u7e70\u308a\u8fd4\u3059\u3002]"}, {"question": "\u30d1\u30f3\u30c9\u30eb\u3067\u6700\u7d42\u30dc\u30b9\u3092\u5012\u3059\u306e\u306b\u5f79\u7acb\u3064\u9ad8\u5ea6\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30f3\u30c9\u30eb\u3067\u6700\u7d42\u30dc\u30b9\u3092\u5012\u3059\u306b\u306f\u3001\u6b21\u306e\u6226\u7565\u3092\u691c\u8a0e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30dc\u30b9\u306e\u653b\u6483\u30d1\u30bf\u30fc\u30f3\u3092\u5b66\u3073\u3001\u305d\u308c\u306b\u5fdc\u3058\u3066\u56de\u907f\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30dc\u30b9\u304c\u5f31\u3063\u3066\u3044\u308b\u3068\u304d\u306b\u7279\u6b8a\u80fd\u529b\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u91cd\u8981\u306a\u5834\u9762\u306e\u305f\u3081\u306b\u30b9\u30bf\u30df\u30ca\u3092\u7bc0\u7d04\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6700\u7d42\u6c7a\u6226\u3067\u306f\u3001\u56de\u907f\u5f8c\u306b\u7279\u6b8a\u80fd\u529b\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3001\u5927\u304d\u306a\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u8907\u6570\u6848\u6bd4\u8f03\uff1a\u30aa\u30d7\u30b7\u30e7\u30f3A-\u7a4d\u6975\u7684\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\uff1a\u30ea\u30b9\u30af\u304c\u9ad8\u304f\u3001\u30ea\u30bf\u30fc\u30f3\u3082\u9ad8\u3044\u3002\u30aa\u30d7\u30b7\u30e7\u30f3B-\u9632\u5fa1\u7684\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\uff1a\u30ea\u30b9\u30af\u306f\u4f4e\u304f\u3001\u30c0\u30e1\u30fc\u30b8\u306f\u5b89\u5b9a\u3057\u3066\u3044\u308b\u3002]"}, {"question": "\u30a8\u30f3\u30c9\u30b2\u30fc\u30e0\u30b3\u30f3\u30c6\u30f3\u30c4\u306e\u305f\u3081\u306b\u30d1\u30f3\u30c9\u30eb\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30d3\u30eb\u30c9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30d3\u30eb\u30c9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u30b9\u30c6\u30fc\u30bf\u30b9\u3068\u88c5\u5099\u3059\u308b\u30a2\u30a4\u30c6\u30e0\u306e\u30d0\u30e9\u30f3\u30b9\u3092\u3068\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u653b\u6483\u529b\u3068\u30b9\u30bf\u30df\u30ca\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u4e0a\u3052\u3001\u3053\u308c\u3089\u306e\u5c5e\u6027\u3092\u5f37\u5316\u3059\u308b\u88c5\u5099\u3092\u88c5\u5099\u3059\u308b\u3053\u3068\u306b\u91cd\u70b9\u3092\u7f6e\u3044\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u300e\u52c7\u8005\u306e\u5203\u300f\u306f\u653b\u6483\u529b\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u3001\u30a8\u30f3\u30c9\u30b2\u30fc\u30e0\u306b\u6700\u9069\u3067\u3059\u3002[\u4f8b\u3048\uff1a\u3042\u306a\u305f\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30d3\u30eb\u30c9\u306f\u3001\u5168\u4f53\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u8ca2\u732e\u3059\u308b\u5404\u90e8\u5206\u3092\u6301\u3064\u7cbe\u5bc6\u306b\u8abf\u6574\u3055\u308c\u305f\u30a8\u30f3\u30b8\u30f3\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30d1\u30f3\u30c9\u30eb\u3067\u52b9\u7387\u7684\u306b\u8cc7\u6e90\u3092\u53ce\u96c6\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u8cc7\u6e90\u3092\u52b9\u7387\u7684\u306b\u53ce\u96c6\u3059\u308b\u6700\u826f\u306e\u65b9\u6cd5\u306f\u3001\u53ce\u76ca\u306e\u9ad8\u3044\u30ec\u30d9\u30eb\u3092\u7e70\u308a\u8fd4\u3057\u30d7\u30ec\u30a4\u3057\u3001\u8cc7\u6e90\u5f37\u5316\u30ae\u30a2\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u8907\u6570\u306e\u5b9d\u7bb1\u3068\u3001\u8cb4\u91cd\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u843d\u3068\u3059\u6575\u304c\u3044\u308b\u30ec\u30d9\u30eb\u306b\u96c6\u4e2d\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3068\u3057\u3066\u3001\u300e\u8c4a\u7a63\u306e\u68ee\u300f\u30ec\u30d9\u30eb\u306f\u8c4a\u5bcc\u306a\u8cc7\u6e90\u306e\u30c9\u30ed\u30c3\u30d7\u3067\u77e5\u3089\u308c\u3066\u3044\u307e\u3059\u3002[\u5bfe\u5fdc\u8868\uff1a\u30ec\u30d9\u30eb-\u8c4a\u7a63\u306e\u68ee\u3001\u8cc7\u6e90-\u30b4\u30fc\u30eb\u30c9\u3001\u5b9d\u77f3\u3001\u7d20\u6750\u3002]"}, {"question": "\u30d1\u30f3\u30c9\u30eb\u306e\u30c0\u30e1\u30fc\u30b8\u8a08\u7b97\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30f3\u30c9\u30eb\u306e\u30c0\u30e1\u30fc\u30b8\u8a08\u7b97\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u653b\u6483\u529b\u3001\u9632\u5fa1\u529b\u3001\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u7387\u3092\u8003\u616e\u3059\u308b\u6570\u5f0f\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u3042\u306a\u305f\u306e\u653b\u6483\u529b\u304c100\u3067\u3001\u6575\u306e\u9632\u5fa1\u529b\u304c50\u306e\u5834\u5408\u3001\u57fa\u790e\u30c0\u30e1\u30fc\u30b8\u306f50\u3067\u3059\u3002\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u306f\u3001\u3053\u306e\u30c0\u30e1\u30fc\u30b8\u30921.5\u500d\u306b\u3057\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u653b\u6483\u529b->\u9632\u5fa1\u529b\u3092\u5f15\u304f->\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u500d\u7387\u3092\u9069\u7528\u3059\u308b->\u6700\u7d42\u30c0\u30e1\u30fc\u30b8\u3002]"}, {"question": "\u30d1\u30f3\u30c9\u30eb\u3067\u30a2\u30fc\u30de\u30fc\u8cab\u901a\u30b9\u30c6\u30fc\u30bf\u30b9\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u30a2\u30fc\u30de\u30fc\u8cab\u901a\u30b9\u30c6\u30fc\u30bf\u30b9\u304c\u91cd\u8981\u306a\u306e\u306f\u3001\u6575\u306e\u9632\u5fa1\u529b\u3092\u4e0b\u3052\u3001\u3088\u308a\u591a\u304f\u306e\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u305f\u3081\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30a2\u30fc\u30de\u30fc\u8cab\u901a\u304c20\u306e\u5834\u5408\u3001\u9632\u5fa1\u529b\u304c50\u306e\u6575\u306f\u5b9f\u969b\u306b\u306f30\u306e\u9632\u5fa1\u529b\u3068\u306a\u308a\u3001\u30c0\u30e1\u30fc\u30b8\u51fa\u529b\u3092\u9ad8\u3081\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u30a2\u30fc\u30de\u30fc\u8cab\u901a\u306f\u3001\u6575\u306e\u9632\u5fa1\u3092\u89e3\u304d\u653e\u3064\u9375\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u6575\u3092\u5012\u3059\u3053\u3068\u3092\u5bb9\u6613\u306b\u3057\u307e\u3059\u3002]"}, {"question": "\u30d1\u30f3\u30c9\u30eb\u306e\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u3092\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30af\u30e9\u30a6\u30c9\u30bb\u30fc\u30d6\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u3001\u30d1\u30f3\u30c9\u30eb\u306e\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u3092\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u8ee2\u9001\u3067\u304d\u307e\u3059\u3002\u4e21\u65b9\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001PC\u304b\u3089\u30b3\u30f3\u30bd\u30fc\u30eb\u3078\u306e\u30c7\u30fc\u30bf\u8ee2\u9001\u306b\u3088\u308a\u3001\u30b9\u30e0\u30fc\u30ba\u306b\u9032\u884c\u72b6\u6cc1\u3092\u7d9a\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u8907\u6570\u6848\u6bd4\u8f03\uff1a\u30aa\u30d7\u30b7\u30e7\u30f3A-\u30af\u30e9\u30a6\u30c9\u30bb\u30fc\u30d6\uff1a\u7c21\u5358\u3067\u4fe1\u983c\u6027\u304c\u9ad8\u3044\u3002\u30aa\u30d7\u30b7\u30e7\u30f3B-\u624b\u52d5\u8ee2\u9001\uff1a\u5916\u90e8\u30b9\u30c8\u30ec\u30fc\u30b8\u304c\u5fc5\u8981\u3067\u3059\u3002]"}, {"question": "\u30d1\u30f3\u30c9\u30eb\u3092\u63a2\u7d22\u3059\u308b\u3053\u3068\u3067\u3001\u9053\u5916\u306b\u51fa\u308b\u3053\u3068\u3067\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30f3\u30c9\u30eb\u3067\u9053\u5916\u3092\u63a2\u7d22\u3059\u308b\u3053\u3068\u3067\u3001\u96a0\u3055\u308c\u305f\u5b9d\u7bb1\u3001\u79d8\u5bc6\u30ec\u30d9\u30eb\u3001\u30e6\u30cb\u30fc\u30af\u30a2\u30a4\u30c6\u30e0\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u5931\u308f\u308c\u305f\u6d1e\u7a9f\u300f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u96a0\u308c\u305f\u901a\u8def\u304c\u30ec\u30a2\u306a\u6b66\u5668\u306b\u901a\u3058\u3066\u3044\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u3053\u308c\u3089\u306e\u96a0\u308c\u305f\u9053\u306f\u3001\u63a2\u6c42\u306b\u3088\u3063\u3066\u8cb4\u91cd\u306a\u5831\u916c\u306b\u3064\u306a\u304c\u308b\u5b9d\u5730\u56f3\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}]
[{"question": "\ucd08\uc2ec\uc790\ub97c \uc704\ud55c \ud380\ub4e4 \uae30\ubcf8 \uc5f0\uacc4 \uacf5\uaca9\uc740 \uc5b4\ub5bb\uac8c \uc218\ud589\ud558\ub098\uc694?", "answer": "\ud380\ub4e4 \uae30\ubcf8 \uc5f0\uacc4 \uacf5\uaca9\uc744 \uc218\ud589\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: \ub2e8\uacc4 1: \uac00\ubcbc\uc6b4 \uacf5\uaca9\uc744 \uc2dc\uc791\ud558\uae30 \uc704\ud574 'A' \ubc84\ud2bc\uc744 \ub204\ub985\ub2c8\ub2e4. \ub2e8\uacc4 2: \ubc14\ub85c 'B' \ubc84\ud2bc\uc744 \ub20c\ub7ec \uac15\ub825\ud55c \uacf5\uaca9\uc73c\ub85c \uc5f0\uacb0\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ub9c8\uc9c0\ub9c9\uc73c\ub85c 'X' \ubc84\ud2bc\uc744 \ub20c\ub7ec \ud2b9\uc218 \uacf5\uaca9\uc73c\ub85c \ub9c8\ubb34\ub9ac\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c \uc774 \uc5f0\uacc4 \uacf5\uaca9\uc740 \ucd08\uae30 \uc801\uc73c\ub85c \ud6a8\uc728\uc801\uc73c\ub85c \uc2b9\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc774 \uc5f0\uacc4 \uacf5\uaca9\uc744 \ubcf5\uc2f1\uc5d0\uc11c\uc758 \uc6d0\ud22c\ud380\uce58\ub85c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694. \uac01 \ub3d9\uc791\uc774 \ucd5c\ub300\uc758 \ud0c0\uaca9\uc744 \uc704\ud574 \uc774\uc804 \ub3d9\uc791\uc5d0 \uad6c\ucd95\ub429\ub2c8\ub2e4.]"}, {"question": "\ud380\ub4e4\uc5d0\uc11c \uc219\ub2ec\ud574\uc57c \ud560 \ud544\uc218 \ucee8\ud2b8\ub864\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud380\ub4e4\uc5d0\uc11c \uc219\ub2ec\ud574\uc57c \ud560 \ud544\uc218 \ucee8\ud2b8\ub864\uc5d0\ub294 \uc774\ub3d9, \uacf5\uaca9 \ubc0f \ud2b9\uc218 \ub2a5\ub825 \uc0ac\uc6a9\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc67c\ucabd \uc870\uc774\uc2a4\ud2f1\uc73c\ub85c \uc774\ub3d9\ud558\uace0, 'A'\ub294 \uac00\ubcbc\uc6b4 \uacf5\uaca9, 'B'\ub294 \uac15\ub825\ud55c \uacf5\uaca9, 'X'\ub294 \ud2b9\uc218 \ub2a5\ub825\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'Y' \ubc84\ud2bc\uc73c\ub85c \ud68c\ud53c \uad74\ub9bc\uc744 \uc219\ub2ec\ud558\uba74 2\ub2e8\uacc4\uc5d0\uc11c \uc801 \uacf5\uaca9\uc744 \ud53c\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ub300\uc870\ud45c: \uc870\uc774\uc2a4\ud2f1 - \uc774\ub3d9, A - \uac00\ubcbc\uc6b4 \uacf5\uaca9, B - \uac15\ub825\ud55c \uacf5\uaca9, X - \ud2b9\uc218 \ub2a5\ub825, Y - \ud68c\ud53c \uad74\ub9bc.]"}, {"question": "\ud380\ub4e4\uc5d0\uc11c \uc2a4\ud0dc\ubbf8\ub098 \ubc14\ub97c \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc2a4\ud0dc\ubbf8\ub098 \ubc14\ub97c \uc774\ud574\ud558\ub294 \uac83\uc740 \uc911\uc694\ud569\ub2c8\ub2e4. \uc65c\ub0d0\ud558\uba74 \uc2a4\ud0dc\ubbf8\ub098 \ubc14\ub294 \uc5ec\ub7ec\ubd84\uc774 \ud589\ub3d9\uc744 \uc218\ud589\ud560 \uc218 \uc788\ub294 \ub2a5\ub825\uc744 \uc81c\ud55c\ud558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uac01 \uacf5\uaca9\uc774\ub098 \ud68c\ud53c\ub294 \uc2a4\ud0dc\ubbf8\ub098\ub97c \uc18c\ubaa8\ud558\uba70, \uc2a4\ud0dc\ubbf8\ub098\uac00 \uace0\uac08\ub418\uba74 \ucde8\uc57d\ud574\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubcf4\uc2a4\uc804\uc5d0\uc11c \uc2a4\ud0dc\ubbf8\ub098\ub97c \uad00\ub9ac\ud558\uba74 \uce58\uba85\uc801\uc778 \uacf5\uaca9\uc744 \ud68c\ud53c\ud558\uace0 \ud6a8\uacfc\uc801\uc73c\ub85c \ubc18\uaca9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \ud589\ub3d9 -> \uc2a4\ud0dc\ubbf8\ub098 \uc18c\ubaa8 -> \uc2a4\ud0dc\ubbf8\ub098 \ud68c\ubcf5 -> \ubc18\ubcf5.]"}, {"question": "\ud380\ub4e4\uc5d0\uc11c \ucd5c\uc885 \ubcf4\uc2a4\ub97c \ubb3c\ub9ac\uce58\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ub294 \uace0\uae09 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud380\ub4e4\uc5d0\uc11c \ucd5c\uc885 \ubcf4\uc2a4\ub97c \ubb3c\ub9ac\uce58\ub824\uba74 \ub2e4\uc74c \uc804\ub7b5\uc744 \uace0\ub824\ud558\uc138\uc694: \ub2e8\uacc4 1: \ubcf4\uc2a4\uc758 \uacf5\uaca9 \ud328\ud134\uc744 \ubc30\uc6b0\uace0 \uadf8\uc5d0 \ub530\ub77c \ud68c\ud53c\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ubcf4\uc2a4\uac00 \ucde8\uc57d\ud560 \ub54c \ud2b9\uc218 \ub2a5\ub825\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uc911\uc694\ud55c \uc21c\uac04\uc744 \uc704\ud574 \uc2a4\ud0dc\ubbf8\ub098\ub97c \uc808\uc57d\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucd5c\uc885 \uc804\ud22c\uc5d0\uc11c \ud68c\ud53c \ud6c4 \ud2b9\uc218 \ub2a5\ub825\uc744 \ud0c0\uc774\ubc0d\ud558\uba74 \uc0c1\ub2f9\ud55c \ud53c\ud574\ub97c \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: \uc635\uc158 A - \uacf5\uaca9\uc801\uc778 \uc811\uadfc: \ub192\uc740 \uc704\ud5d8, \ub192\uc740 \ubcf4\uc0c1. \uc635\uc158 B - \uc218\ube44\uc801\uc778 \uc811\uadfc: \ub0ae\uc740 \uc704\ud5d8, \uc548\uc815\uc801\uc778 \ud53c\ud574.]"}, {"question": "\uc5d4\ub4dc \uac8c\uc784 \ucf58\ud150\uce20\ub97c \uc704\ud574 \ud380\ub4e4\uc5d0\uc11c \uce90\ub9ad\ud130 \ube4c\ub4dc\ub97c \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uce90\ub9ad\ud130 \ube4c\ub4dc\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc2a4\ud15f\uc744 \uade0\ud615 \uc788\uac8c \ub9de\ucd94\uace0 \uc62c\ubc14\ub978 \uc7a5\ube44\ub97c \ucc29\uc6a9\ud574\uc57c \ud569\ub2c8\ub2e4. \uacf5\uaca9\ub825\uacfc \uc2a4\ud0dc\ubbf8\ub098 \uc2a4\ud15f\uc744 \ub192\uc774\uace0 \uc774\ub7ec\ud55c \ud2b9\uc131\uc744 \uac15\ud654\ud558\ub294 \uc7a5\ube44\ub97c \ucc29\uc6a9\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uc6a9\uae30\uc758 \uac80'\uc740 \uacf5\uaca9\ub825\uc744 \ud06c\uac8c \uc99d\uac00\uc2dc\ucf1c \uc5d4\ub4dc \uac8c\uc784\uc5d0 \uc774\uc0c1\uc801\uc785\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uce90\ub9ad\ud130 \ube4c\ub4dc\ub97c \uc815\uad50\ud558\uac8c \uc870\uc728\ub41c \uc5d4\uc9c4\uc73c\ub85c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694. \uac01 \ubd80\ubd84\uc774 \uc804\uccb4 \uc131\ub2a5\uc5d0 \uae30\uc5ec\ud569\ub2c8\ub2e4.]"}, {"question": "\ud380\ub4e4\uc5d0\uc11c \uc790\uc6d0\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uc218\uc9d1\ud558\ub294 \ucd5c\uace0\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc790\uc6d0\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uc218\uc9d1\ud558\ub294 \ucd5c\uace0\uc758 \ubc29\ubc95\uc740 \uace0\uc218\uc775 \ub808\ubca8\uc744 \ubc18\ubcf5 \ud50c\ub808\uc774\ud558\uace0 \uc790\uc6d0 \uc99d\uac00 \uc7a5\ube44\ub97c \uc0ac\uc6a9\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc5ec\ub7ec \uc0c1\uc790\uc640 \uadc0\uc911\ud55c \uc544\uc774\ud15c\uc744 \ub4dc\ub86d\ud558\ub294 \uc801\uc774 \uc788\ub294 \ub808\ubca8\uc5d0 \uc9d1\uc911\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\ud48d\uc694\uc758 \uc232' \ub808\ubca8\uc740 \ud48d\ubd80\ud55c \uc790\uc6d0 \ub4dc\ub86d\uc73c\ub85c \uc720\uba85\ud569\ub2c8\ub2e4. [\uc124\uc815 \ub300\uc870\ud45c: \ub808\ubca8 - \ud48d\uc694\uc758 \uc232, \uc790\uc6d0 - \uae08, \ubcf4\uc11d, \uc7ac\ub8cc.]"}, {"question": "\ud380\ub4e4\uc5d0\uc11c \ud53c\ud574 \uacc4\uc0b0 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "\ud380\ub4e4 \ud53c\ud574 \uacc4\uc0b0 \uc2dc\uc2a4\ud15c\uc740 \uacf5\uaca9\ub825, \ubc29\uc5b4\ub825 \ubc0f \uce58\uba85\ud0c0 \ud655\ub960\uc744 \uace0\ub824\ud558\ub294 \uacf5\uc2dd\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uacf5\uaca9\ub825\uc774 100\uc774\uace0 \uc801\uc758 \ubc29\uc5b4\ub825\uc774 50\uc774\uba74 \uae30\ubcf8 \ud53c\ud574\ub294 50\uc785\ub2c8\ub2e4. \uce58\uba85\ud0c0\ub294 \uc774 \ud53c\ud574\ub97c 1.5\ubc30\ub85c \uacf1\ud569\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uacf5\uaca9\ub825 -> \ubc29\uc5b4\ub825 \ucc28\uac10 -> \uce58\uba85\ud0c0 \uacf1\uc148 -> \ucd5c\uc885 \ud53c\ud574.]"}, {"question": "\ud380\ub4e4\uc5d0\uc11c \ubc29\uc5b4\ub825 \uad00\ud1b5 \uc2a4\ud15f\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ubc29\uc5b4\ub825 \uad00\ud1b5 \uc2a4\ud15f\uc740 \uc911\uc694\ud569\ub2c8\ub2e4. \uc801\uc758 \ubc29\uc5b4\ub825\uc744 \ub0ae\ucd94\uace0 \ub354 \ub9ce\uc740 \ud53c\ud574\ub97c \uc785\ud790 \uc218 \uc788\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubc29\uc5b4\ub825 \uad00\ud1b5\uc774 20\uc774\uba74 \ubc29\uc5b4\ub825\uc774 50\uc778 \uc801\uc740 \uc2e4\uc9c8\uc801\uc73c\ub85c 30\uc758 \ubc29\uc5b4\ub825\uc744 \uac16\uac8c \ub418\uc5b4 \ud53c\ud574\ub7c9\uc774 \uc99d\uac00\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ubc29\uc5b4\ub825 \uad00\ud1b5\uc744 \uc801\uc758 \ubc29\uc5b4\ub97c \ud574\uc81c\ud558\ub294 \uc5f4\uc1e0\ub77c\uace0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694. \uc801\uc744 \ub354 \uc27d\uac8c \ubb3c\ub9ac\uce60 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ud380\ub4e4\uc758 \uc800\uc7a5 \ub370\uc774\ud130\ub97c \ub2e4\ub978 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub124, \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud380\ub4e4 \uc800\uc7a5 \ub370\uc774\ud130\ub97c \ub2e4\ub978 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub450 \ud50c\ub7ab\ud3fc \ubaa8\ub450 \uac19\uc740 \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ucf58\uc194\ub85c \ub370\uc774\ud130\ub97c \uc804\uc1a1\ud558\uba74 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc6d0\ud65c\ud558\uac8c \uc774\uc5b4\uac08 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: \uc635\uc158 A - \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5: \uac04\ud3b8\ud558\uace0 \uc548\uc815\uc801\uc785\ub2c8\ub2e4. \uc635\uc158 B - \uc218\ub3d9 \uc804\uc1a1: \uc678\ubd80 \uc800\uc7a5 \uc7a5\uce58\uac00 \ud544\uc694\ud569\ub2c8\ub2e4.]"}, {"question": "\ud380\ub4e4\uc5d0\uc11c \ubc97\uc5b4\ub09c \uae38\uc744 \ud0d0\ud5d8\ud558\uc5ec \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud380\ub4e4\uc5d0\uc11c \ubc97\uc5b4\ub09c \uae38\uc744 \ud0d0\ud5d8\ud558\uba74 \uc228\uaca8\uc9c4 \uc0c1\uc790, \ube44\ubc00 \ub808\ubca8 \ubc0f \uace0\uc720\ud55c \uc544\uc774\ud15c\uc744 \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc783\uc5b4\ubc84\ub9b0 \ub3d9\uad74' \ub808\ubca8\uc5d0\uc11c \uc228\uaca8\uc9c4 \uae38\uc744 \ub530\ub77c \ub4dc\ubb38 \ubb34\uae30\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uae38\uc744 \ubcf4\ubb3c \uc9c0\ub3c4\ub77c\uace0 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694. \ud0d0\ud5d8\uc744 \ud1b5\ud574 \uac12\uc9c4 \ubcf4\uc0c1\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}]
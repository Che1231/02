[{"question": "Battledudes.io\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub824\uba74 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "Battledudes.io\uc5d0\uc11c \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub824\uba74, \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub294 \uba3c\uc800 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc5d0 \uc775\uc219\ud574\uc838\uc57c \ud569\ub2c8\ub2e4. \uc774\ub3d9\uc740 WASD \ud0a4\ub97c \uc0ac\uc6a9\ud558\uace0, \uc870\uc900 \ubc0f \uc0ac\uaca9\uc740 \ub9c8\uc6b0\uc2a4\ub85c \uc218\ud589\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uce90\ub9ad\ud130\ub97c \uc624\ub978\ucabd\uc73c\ub85c \uc774\ub3d9\ud558\ub824\uba74 'D' \ud0a4\ub97c \ub204\ub974\uc138\uc694. \ub610\ud55c, \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \ub204\ub974\uba74 \uc801\uc758 \uacf5\uaca9\uc744 \ud53c\ud558\ub294 \ub370 \uc720\uc6a9\ud55c \uc810\ud504\uac00 \uac00\ub2a5\ud569\ub2c8\ub2e4. \uc2e4\uc81c \uc804\ud22c\uc5d0 \ub4e4\uc5b4\uac00\uae30 \uc804\uc5d0 \ud6c8\ub828 \uad6c\uc5ed\uc5d0\uc11c \uc774\ub7ec\ud55c \ucee8\ud2b8\ub864\uc744 \uc5f0\uc2b5\ud558\uc5ec \uc790\uc2e0\uac10\uc744 \uac16\ub3c4\ub85d \ud558\uc138\uc694. [\ube44\uc720 \uc124\uba85: \ud6c8\ub828 \uad6c\uc5ed\uc740 \uace8\ud504 \uc5f0\uc2b5\uc7a5\uacfc \uac19\uc73c\uba70, \ucf54\uc2a4\uc5d0 \ub098\uac00\uae30 \uc804\uc5d0 \uc2a4\uc719 \uc5f0\uc2b5\uc744 \ud560 \uc218 \uc788\ub294 \uacf3\uc785\ub2c8\ub2e4.]"}, {"question": "100\uc2dc\uac04 \uc774\uc0c1 \ud50c\ub808\uc774\ud55c Battledudes.io \ud50c\ub808\uc774\uc5b4\uac00 \ub354 \uc624\ub798 \ubc84\ud2f0\uae30 \uc704\ud55c \uc8fc\uc694 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Battledudes.io\uc5d0\uc11c 100\uc2dc\uac04 \uc774\uc0c1 \ud50c\ub808\uc774\ud55c \ubca0\ud14c\ub791 \ud50c\ub808\uc774\uc5b4\uc758 \uacbd\uc6b0 \uc0dd\uc874\uc740 \uace0\uae09 \uc804\ub7b5\uc5d0 \ub2ec\ub824 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \ubbf8\ub2c8\ub9f5\uc744 \uc790\uc8fc \ud655\uc778\ud558\uc5ec \uc8fc\ubcc0 \uc0c1\ud669\uc744 \ud56d\uc0c1 \ud30c\uc545\ud569\ub2c8\ub2e4. STEP2: \uc801\uc758 \uacf5\uaca9\uc744 \ud53c\ud558\uae30 \uc704\ud574 \ubcbd\uc774\ub098 \uad6c\uc870\ubb3c \ub4a4\uc5d0 \ud6a8\uacfc\uc801\uc73c\ub85c \uc228\uc73c\uc138\uc694. STEP3: \uc704\uae09\ud55c \uc21c\uac04\uc5d0 \uccb4\ub825\uc744 \ud68c\ubcf5\ud560 \uc218 \uc788\ub294 '\uccb4\ub825 \ud68c\ubcf5 \uc81c'\uc640 \uac19\uc740 \ud30c\uc6cc\uc5c5 \uc544\uc774\ud15c\uc744 \ub9c8\uc2a4\ud130\ud558\uc138\uc694. [\ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: \uacf5\uaca9\uc801\uc778 \ud50c\ub808\uc774\ub294 \ube60\ub978 \ucc98\uce58\ub97c \uac00\uc838\uc62c \uc218 \uc788\uc9c0\ub9cc, \ub354 \ubc29\uc5b4\uc801\uc778 \uc811\uadfc \ubc29\uc2dd\uc740 \uc885\uc885 \ub354 \uc624\ub7ab\ub3d9\uc548 \uc0dd\uc874\ud558\ub294 \uacb0\uacfc\ub97c \uac00\uc838\uc635\ub2c8\ub2e4.]"}, {"question": "Battledudes.io\uc5d0\uc11c \ubd80\ud65c \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Battledudes.io\uc5d0\uc11c \ubd80\ud65c \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \ud50c\ub808\uc774 \ubc29\uc2dd\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \ud328\ubc30\ud558\uba74 \uc9c0\ub3c4\uc758 \uc784\uc758\uc758 \uc704\uce58\uc5d0\uc11c \ubd80\ud65c\ud569\ub2c8\ub2e4. \uc774\ub294 \ube60\ub974\uac8c \ubc29\ud5a5\uc744 \uc7a1\uace0 \uc804\ud22c\uc5d0 \ub2e4\uc2dc \ucc38\uc5ec\ud574\uc57c \ud568\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud328\ubc30\ud558\uae30 \uc804\uc5d0 \uc911\uc694\ud55c \uc704\uce58\ub97c \ucc28\uc9c0\ud558\uace0 \uc788\uc5c8\ub2e4\uba74, \ubd80\ud65c \uc9c0\uc810\uc744 \uc54c\uba74 \ud574\ub2f9 \uc9c0\uc5ed\uc73c\ub85c \uc2e0\uc18d\ud558\uac8c \ub3cc\uc544\uac08 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \ud328\ubc30 \u2192 \uc784\uc758 \uc704\uce58\uc5d0\uc11c \ubd80\ud65c \u2192 \ubc29\ud5a5 \uc7a1\uae30 \u2192 \uc804\ud22c \uc7ac\ucc38\uc5ec.]"}, {"question": "\ub2e4\uc591\ud55c \uc804\ud22c \uc0c1\ud669\uc5d0\uc11c Battledudes.io\uc5d0\uc11c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ubb34\uae30\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Battledudes.io\uc5d0\uc11c \ubb34\uae30\uc758 \ud6a8\uacfc\ub294 \uc804\ud22c \uc0c1\ud669\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. \uadfc\uc811 \uc804\ud22c\uc5d0\uc11c\ub294 \ub2e8\uac70\ub9ac\uc5d0\uc11c \ub192\uc740 \ud53c\ud574\ub7c9\uc744 \uc790\ub791\ud558\ub294 \uc0b0\ud0c4\ucd1d\uc774 \ub9e4\uc6b0 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. \uc7a5\uac70\ub9ac \uad50\uc804\uc5d0\uc11c\ub294 \uc6d0\uac70\ub9ac\uc5d0\uc11c \uc815\ud655\ud55c \uc0ac\uaca9\uc774 \uac00\ub2a5\ud55c \uc800\uaca9 \uc18c\ucd1d\uc774 \uc720\uc6a9\ud569\ub2c8\ub2e4.  \uc911\uac70\ub9ac \uad50\uc804\uc5d0\uc11c\ub294 \uc815\ud655\ub3c4\uc640 \uc0ac\uaca9 \uc18d\ub3c4\uc758 \uade0\ud615\uc774 \ub6f0\uc5b4\ub09c \ub3cc\uaca9 \uc18c\ucd1d\uc774 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \uc0b0\ud0c4\ucd1d - \uadfc\uc811 \uc804\ud22c, \uc800\uaca9 \uc18c\ucd1d - \uc7a5\uac70\ub9ac \uad50\uc804, \ub3cc\uaca9 \uc18c\ucd1d - \uc911\uac70\ub9ac \uad50\uc804.]"}, {"question": "Battledudes.io\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \uade0\ud615 \uc7a1\ud78c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc5b4\ub5bb\uac8c \ubcf4\uc7a5\ud569\ub2c8\uae4c?", "answer": "Battledudes.io\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uc758 \uae30\uc220 \uc218\uc900\uc774 \ube44\uc2b7\ud55c \uc0ac\ub78c\ub4e4\ub07c\ub9ac \ub9e4\uce6d\ud568\uc73c\ub85c\uc368 \uade0\ud615 \uc7a1\ud78c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ubcf4\uc7a5\ud569\ub2c8\ub2e4. \uc774\ub294 \ud0ac/\ub370\uc2a4 \ube44\uc728 \ubc0f \uc2b9\ub960\uacfc \uac19\uc740 \uc131\ub2a5 \uc9c0\ud45c\ub97c \ud3c9\uac00\ud558\ub294 \uc54c\uace0\ub9ac\uc998\uc744 \ud1b5\ud574 \uc774\ub8e8\uc5b4\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub192\uc740 \uc2b9\ub960\uc744 \uac00\uc9c4 \ud50c\ub808\uc774\uc5b4\ub294 \ub2e4\ub978 \uace0\uc131\ub2a5 \ud50c\ub808\uc774\uc5b4\uc640 \ub9e4\uce6d\ub418\uc5b4 \uacbd\uc7c1\uc801\uc774\uace0 \uacf5\uc815\ud55c \ub9e4\uce58\uac00 \ub418\ub3c4\ub85d \ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uccb4\uc2a4 \ub300\ud68c\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\ub4e4\uc774 \uac01 \ub9e4\uce58\uac00 \uade0\ud615 \uc7a1\ud788\ub3c4\ub85d \uc790\uc2e0\uc758 \uc5d8\ub85c \ub808\uc774\ud305\uc5d0 \ub530\ub77c \uadf8\ub8f9\ud654\ub418\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "Battledudes.io\uc5d0\uc11c \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uac00 \ud074\ub79c\uc5d0 \uac00\uc785\ud558\uba74 \uc5b4\ub5a4 \uc774\uc810\uc774 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Battledudes.io\uc5d0\uc11c \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uac00 \ud074\ub79c\uc5d0 \uac00\uc785\ud558\uba74 \uc5ec\ub7ec \uac00\uc9c0 \uc774\uc810\uc774 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \uc804\ub7b5 \uacf5\uc720 \ubc0f \ud300 \ud611\ub825\uc744 \uc704\ud55c \uc720\uc0ac\ud55c \uc0dd\uac01\uc744 \uac00\uc9c4 \ud50c\ub808\uc774\uc5b4 \ucee4\ubba4\ub2c8\ud2f0\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. STEP2: \ud074\ub79c\uc740 \uc885\uc885 \ud074\ub79c \uc804\uc7c1\uc5d0 \ucc38\uc5ec\ud558\uc5ec \ub3c5\ud2b9\ud55c \ubcf4\uc0c1\uacfc \uc790\ub791\uac70\ub9ac\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. STEP3: \ud074\ub79c\uc5d0 \uc18d\ud558\uba74 \ub354 \ub9ce\uc740 \uacbd\ud5d8\uc744 \uac00\uc9c4 \uba64\ubc84\ub85c\ubd80\ud130 \ub3c5\uc810\uc801\uc778 \uac8c\uc784 \ub0b4 \ub9ac\uc18c\uc2a4 \ubc0f \ud301\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: \uc194\ub85c \ud50c\ub808\uc774\ub294 \uc790\uc720\ub97c \uc81c\uacf5\ud558\uc9c0\ub9cc, \ud074\ub79c \uba64\ubc84\uc2ed\uc740 \uad6c\uc870\ud654\ub41c \uc9c0\uc6d0\uacfc \ud5a5\uc0c1\ub41c \uac8c\uc784 \ud50c\ub808\uc774 \uae30\ud68c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4.]"}, {"question": "Battledudes.io\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\ub294 \uac8c\uc784 \ub0b4 \uc124\uc815\uc744 \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud558\uc5ec \uc131\ub2a5\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Battledudes.io\uc5d0\uc11c \uac8c\uc784 \ub0b4 \uc124\uc815\uc744 \ucd5c\uc801\ud654\ud558\uba74 \uc131\ub2a5\uc774 \ud06c\uac8c \ud5a5\uc0c1\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud14d\uc2a4\ucc98 \ud488\uc9c8 \ubc0f \uadf8\ub9bc\uc790 \uc138\ubd80 \uc0ac\ud56d\uacfc \uac19\uc740 \uadf8\ub798\ud53d \uc124\uc815\uc744 \ub0ae\ucd94\uba74 \ud2b9\ud788 \uc800\uc0ac\uc591 \uc2dc\uc2a4\ud15c\uc5d0\uc11c \ud504\ub808\uc784 \uc18d\ub3c4\uac00 \ud5a5\uc0c1\ub429\ub2c8\ub2e4. \ub610\ud55c, \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\uac8c \ub9c8\uc6b0\uc2a4 \ubbfc\uac10\ub3c4\ub97c \uc870\uc815\ud558\uba74 \uc870\uc900 \uc815\ud655\ub3c4\uac00 \ud5a5\uc0c1\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub0ae\uc740 \ubbfc\uac10\ub3c4 \uc124\uc815\uc740 \uc815\ud655\ud55c \uc800\uaca9 \uc0ac\uaca9\uc5d0 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \ud14d\uc2a4\ucc98 \ud488\uc9c8 - \ub0ae\uc74c, \uadf8\ub9bc\uc790 \uc138\ubd80 \uc0ac\ud56d - \ub044\uae30, \ub9c8\uc6b0\uc2a4 \ubbfc\uac10\ub3c4 - \uc0ac\uc6a9\uc790 \uc9c0\uc815.]"}, {"question": "Battledudes.io\uc5d0\uc11c \uae30\uae30\ub97c \ubc14\uafc0 \ub54c \ub370\uc774\ud130 \ub9c8\uc774\uadf8\ub808\uc774\uc158\uc5d0 \ub300\ud574 \ud50c\ub808\uc774\uc5b4\uac00 \uc54c\uc544\uc57c \ud560 \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Battledudes.io\uc5d0\uc11c \uae30\uae30\ub97c \ubc14\uafc0 \ub54c \ud50c\ub808\uc774\uc5b4\ub294 \uac8c\uc784 \ub370\uc774\ud130\uac00 \uc81c\ub300\ub85c \ub9c8\uc774\uadf8\ub808\uc774\uc158\ub418\ub294\uc9c0 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc73c\ub85c \uac8c\uc784 \uacc4\uc815\uc744 \uc774\uba54\uc77c \ub610\ub294 \uc18c\uc15c \ubbf8\ub514\uc5b4 \uacc4\uc815\uacfc \uc5f0\uacb0\ud558\ub294 \uc791\uc5c5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ubaa8\ubc14\uc77c \uae30\uae30\ub85c \uc774\ub3d9\ud558\ub294 \uacbd\uc6b0 \uc5f0\uacb0\ub41c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uba74 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc6d0\ud65c\ud558\uac8c \uc804\uc1a1\ub429\ub2c8\ub2e4. \uc0c8 \uae30\uae30\uc5d0\uc11c \ud50c\ub808\uc774\ub97c \uc2dc\uc791\ud558\uae30 \uc804\uc5d0 \ub370\uc774\ud130\uac00 \uc81c\ub300\ub85c \ub3d9\uae30\ud654\ub418\uc5c8\ub294\uc9c0 \ud56d\uc0c1 \ud655\uc778\ud558\uc138\uc694. [\ube44\uc720 \uc124\uba85: \ub370\uc774\ud130 \ub9c8\uc774\uadf8\ub808\uc774\uc158\uc740 \uc774\uc0ac\uc640 \uac19\uc2b5\ub2c8\ub2e4. \ubaa8\ub4e0 \uc18c\uc9c0\ud488\uc774 \uc548\uc804\ud558\uac8c \uc0c8\ub85c\uc6b4 \uc7a5\uc18c\ub85c \uc6b4\ubc18\ub418\ub294\uc9c0 \ud655\uc778\ud574\uc57c \ud569\ub2c8\ub2e4.]"}, {"question": "Battledudes.io\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \ubc1c\uacac\ud558\uace0 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Battledudes.io\uc5d0\uc11c \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \ubc1c\uacac\ud558\uace0 \ud574\uc81c\ud558\ub824\uba74 \ud0d0\ud5d8\uacfc \ud2b9\uc815 \ucc4c\ub9b0\uc9c0 \uc644\ub8cc\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc9c0\ub3c4\uc758 \ube44\ubc00 \uc9c0\uc5ed\uc744 \ucc3e\uac70\ub098 \ud2b9\uc815 \ub9c8\uc77c\uc2a4\ud1a4\uc744 \ub2ec\uc131\ud558\uba74 \ud2b9\ubcc4\ud55c \uc2a4\ud0a8\uc774\ub098 \ubb34\uae30\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud658\uacbd \ub2e8\uc11c\uc5d0 \uc8fc\uc758\ud558\uace0 \uc758\uc2ec\uc2a4\ub7ec\uc6b4 \ubb3c\uccb4\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\uc5ec \uc774\ub7ec\ud55c \ube44\ubc00\uc744 \ubc1d\ud600\ub0b4\uc138\uc694. [\ubcf4\ubb3c \ucc3e\uae30: \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub294 \uc885\uc885 \uc804\ud22c\uc5d0\uc11c \uc720\ub9ac\ud55c \uc704\uce58\ub97c \uc81c\uacf5\ud558\ub294 \ud76c\uadc0\ud55c \uc544\uc774\ud15c\uc73c\ub85c \ubcf4\uc0c1\ud569\ub2c8\ub2e4.]"}, {"question": "\uc2b9\ub9ac\ud558\ub294 \ub370 \ud6a8\uacfc\uc801\uc778 Battledudes.io\uc758 \ud300 \uc5ed\ud560\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Battledudes.io\uc5d0\uc11c \ud6a8\uacfc\uc801\uc778 \ud300 \uc5ed\ud560\uc740 \uc2b9\ub9ac\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uacf5\uaca9 \uc5ed\ud560\uc740 \uc804\uc120 \uc804\ud22c\uc5d0 \uc9d1\uc911\ud558\uc5ec \uc801\uc5d0\uac8c \uc0c1\ub2f9\ud55c \ud53c\ud574\ub97c \uc785\ud799\ub2c8\ub2e4. \uc9c0\uc6d0 \uc5ed\ud560\uc740 \ub3d9\ub8cc\uc758 \uc0dd\uc874\ub825\uc744 \ub192\uc5ec\uc8fc\ub294 \uce58\uc720 \ubc0f \ubc84\ud504\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc800\uaca9\uc218 \uc5ed\ud560\uc740 \uc6d0\uac70\ub9ac\uc5d0\uc11c \uace0\uac00\uce58 \ubaa9\ud45c\ubb3c\uc744 \uc81c\uac70\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uade0\ud615 \uc7a1\ud78c \uc5ed\ud560\uc744 \uac00\uc9c4 \uc798 \uc870\uc815\ub41c \ud300\uc740 \uc11c\ub85c\uc758 \uc57d\uc810\uc744 \ucee4\ubc84\ud568\uc73c\ub85c\uc368 \uc804\uc7a5\uc744 \uc9c0\ubc30\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: \ubaa8\ub450 \uacf5\uaca9 \ud50c\ub808\uc774\uc5b4\ub85c \uad6c\uc131\ub41c \ud300\uc740 \uc9c0\uc18d\uc131\uc774 \ubd80\uc871\ud560 \uc218 \uc788\uc9c0\ub9cc, \uade0\ud615 \uc7a1\ud78c \ud300\uc740 \ub2e4\uc591\ud55c \uc804\ud22c \uc0c1\ud669\uc5d0 \uc801\uc751\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}]
[{"question": "\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u5728Battledudes.io\u5feb\u901f\u4e0a\u624b\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u65b0\u624b\u73a9\u5bb6\u5728Battledudes.io\u5feb\u901f\u4e0a\u624b\uff0c\u9996\u5148\u5e94\u719f\u6089\u57fa\u672c\u64cd\u4f5c\u3002\u79fb\u52a8\u4f7f\u7528 WASD \u952e\u63a7\u5236\uff0c\u7784\u51c6\u548c\u5c04\u51fb\u4f7f\u7528\u9f20\u6807\u3002\u4f8b\u5982\uff0c\u8981\u5c06\u89d2\u8272\u5411\u53f3\u79fb\u52a8\uff0c\u8bf7\u6309'D'\u952e\u3002\u6b64\u5916\uff0c\u6309\u4e0b\u7a7a\u683c\u952e\u53ef\u4ee5\u8df3\u8dc3\uff0c\u8fd9\u5bf9\u4e8e\u8eb2\u907f\u654c\u4eba\u7684\u706b\u529b\u5f88\u6709\u5e2e\u52a9\u3002\u5728\u8bad\u7ec3\u533a\u7ec3\u4e60\u8fd9\u4e9b\u64cd\u4f5c\uff0c\u5728\u8fdb\u5165\u771f\u5b9e\u6218\u6597\u524d\u5efa\u7acb\u4fe1\u5fc3\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u8bad\u7ec3\u533a\u60f3\u8c61\u6210\u9ad8\u5c14\u592b\u7ec3\u4e60\u573a\uff0c\u53ef\u4ee5\u5728\u6b63\u5f0f\u6253\u7403\u524d\u7ec3\u4e60\u6325\u6746\u3002]"}, {"question": "\u6e38\u620f\u65f6\u957f\u8d85\u8fc7100\u5c0f\u65f6\u7684\u73a9\u5bb6\uff0c\u5728Battledudes.io\u4e2d\u5982\u4f55\u624d\u80fd\u66f4\u957f\u65f6\u95f4\u751f\u5b58\uff1f", "answer": "\u5bf9\u4e8e\u5728Battledudes.io\u4e2d\u6e38\u620f\u65f6\u957f\u8d85\u8fc7100\u5c0f\u65f6\u7684\u8001\u73a9\u5bb6\u6765\u8bf4\uff0c\u751f\u5b58\u7684\u5173\u952e\u5728\u4e8e\u9ad8\u7ea7\u7b56\u7565\u3002\u6b65\u9aa4\u4e00\uff1a\u7ecf\u5e38\u67e5\u770b\u8ff7\u4f60\u5730\u56fe\uff0c\u65f6\u523b\u5173\u6ce8\u5468\u56f4\u73af\u5883\u3002\u6b65\u9aa4\u4e8c\uff1a\u6709\u6548\u5229\u7528\u63a9\u4f53\uff1b\u4f8b\u5982\uff0c\u8eb2\u5728\u5899\u58c1\u6216\u5efa\u7b51\u7269\u540e\u9762\u6765\u8eb2\u907f\u654c\u4eba\u7684\u706b\u529b\u3002\u6b65\u9aa4\u4e09\uff1a\u7cbe\u901a\u4f7f\u7528\u4f8b\u5982\u201c\u6025\u6551\u5305\u201d\u4e4b\u7c7b\u7684\u9053\u5177\uff0c\u5b83\u53ef\u4ee5\u5728\u5173\u952e\u65f6\u523b\u6062\u590d\u4f60\u7684\u751f\u547d\u503c\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u867d\u7136\u6fc0\u8fdb\u7684\u73a9\u6cd5\u53ef\u4ee5\u5feb\u901f\u51fb\u6740\uff0c\u4f46\u66f4\u9632\u5b88\u7684\u7b56\u7565\u901a\u5e38\u80fd\u83b7\u5f97\u66f4\u957f\u7684\u751f\u5b58\u65f6\u95f4\u3002]"}, {"question": "\u5728Battledudes.io\u4e2d\uff0c\u4e3a\u4ec0\u4e48\u7406\u89e3\u91cd\u751f\u673a\u5236\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u7406\u89e3Battledudes.io\u4e2d\u7684\u91cd\u751f\u673a\u5236\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u76f4\u63a5\u5f71\u54cd\u4f60\u7684\u6e38\u620f\u7b56\u7565\u3002\u5f53\u88ab\u51fb\u8d25\u65f6\uff0c\u4f60\u5c06\u5728\u5730\u56fe\u4e0a\u7684\u968f\u673a\u4f4d\u7f6e\u91cd\u751f\u3002\u8fd9\u610f\u5473\u7740\u4f60\u9700\u8981\u8fc5\u901f\u91cd\u65b0\u5b9a\u4f4d\u81ea\u5df1\u5e76\u91cd\u65b0\u52a0\u5165\u6218\u6597\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u88ab\u51fb\u8d25\u4e4b\u524d\u5360\u636e\u4e86\u4e00\u4e2a\u5173\u952e\u4f4d\u7f6e\uff0c\u90a3\u4e48\u4e86\u89e3\u91cd\u751f\u70b9\u53ef\u4ee5\u5e2e\u52a9\u4f60\u8fc5\u901f\u8fd4\u56de\u8be5\u533a\u57df\u3002[\u6d41\u7a0b\u56fe\u89e3: \u51fb\u8d25 \u2192 \u5728\u968f\u673a\u4f4d\u7f6e\u91cd\u751f \u2192 \u91cd\u65b0\u5b9a\u4f4d \u2192 \u91cd\u65b0\u52a0\u5165\u6218\u6597\u3002]"}, {"question": "\u5728Battledudes.io\u4e2d\uff0c\u54ea\u4e9b\u6b66\u5668\u5728\u4e0d\u540c\u7684\u6218\u6597\u573a\u666f\u4e0b\u6700\u6709\u6548\uff1f", "answer": "\u5728Battledudes.io\u4e2d\uff0c\u6b66\u5668\u7684\u6709\u6548\u6027\u56e0\u6218\u6597\u573a\u666f\u800c\u5f02\u3002\u5bf9\u4e8e\u8fd1\u8ddd\u79bb\u6218\u6597\uff0c\u6563\u5f39\u67aa\u7531\u4e8e\u5176\u5728\u8fd1\u8ddd\u79bb\u7684\u9ad8\u4f24\u5bb3\u8f93\u51fa\u800c\u975e\u5e38\u6709\u6548\u3002\u5bf9\u4e8e\u8fdc\u7a0b\u6218\u6597\uff0c\u72d9\u51fb\u6b65\u67aa\u5141\u8bb8\u4ece\u8fdc\u5904\u8fdb\u884c\u7cbe\u786e\u5c04\u51fb\u3002\u4f8b\u5982\uff0c\u5728\u4e2d\u8ddd\u79bb\u4ea4\u706b\u4e2d\u4f7f\u7528\u7a81\u51fb\u6b65\u67aa\uff0c\u5176\u51c6\u786e\u6027\u548c\u5c04\u901f\u7684\u5e73\u8861\u6027\u975e\u5e38\u51fa\u8272\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u6563\u5f39\u67aa - \u8fd1\u8ddd\u79bb\uff0c\u72d9\u51fb\u6b65\u67aa - \u8fdc\u7a0b\uff0c\u7a81\u51fb\u6b65\u67aa - \u4e2d\u8ddd\u79bb\u3002]"}, {"question": "Battledudes.io\u7684\u5339\u914d\u7cfb\u7edf\u5982\u4f55\u786e\u4fdd\u6e38\u620f\u5e73\u8861\uff1f", "answer": "Battledudes.io\u7684\u5339\u914d\u7cfb\u7edf\u901a\u8fc7\u5c06\u7c7b\u4f3c\u6280\u80fd\u6c34\u5e73\u7684\u73a9\u5bb6\u914d\u5bf9\u6765\u786e\u4fdd\u6e38\u620f\u5e73\u8861\u3002\u8fd9\u662f\u901a\u8fc7\u4e00\u4e2a\u8bc4\u4f30\u4f60\u7684\u7ee9\u6548\u6307\u6807\uff08\u4f8b\u5982\uff0c\u51fb\u6740/\u6b7b\u4ea1\u6bd4\u548c\u83b7\u80dc\u7387\uff09\u7684\u7b97\u6cd5\u5b9e\u73b0\u7684\u3002\u4f8b\u5982\uff0c\u83b7\u80dc\u7387\u9ad8\u7684\u73a9\u5bb6\u5c06\u4e0e\u5176\u4ed6\u9ad8\u7ee9\u6548\u73a9\u5bb6\u5339\u914d\uff0c\u4ee5\u786e\u4fdd\u6bd4\u8d5b\u5177\u6709\u7ade\u4e89\u6027\u548c\u516c\u5e73\u6027\u3002[\u6bd4\u55bb\u8bf4\u660e: \u60f3\u8c61\u4e00\u4e0b\u8c61\u68cb\u6bd4\u8d5b\uff0c\u73a9\u5bb6\u6839\u636e\u4ed6\u4eec\u7684 Elo \u8bc4\u7ea7\u5206\u7ec4\uff0c\u4ee5\u786e\u4fdd\u6bcf\u573a\u6bd4\u8d5b\u90fd\u662f\u4e00\u573a\u6311\u6218\u3002]"}, {"question": "\u5bf9\u4e8e\u9ad8\u7ea7\u73a9\u5bb6\u6765\u8bf4\uff0c\u5728Battledudes.io\u4e2d\u52a0\u5165\u516c\u4f1a\u6709\u4ec0\u4e48\u597d\u5904\uff1f", "answer": "\u5728Battledudes.io\u4e2d\u52a0\u5165\u516c\u4f1a\u4e3a\u9ad8\u7ea7\u73a9\u5bb6\u63d0\u4f9b\u8bb8\u591a\u597d\u5904\u3002\u6b65\u9aa4\u4e00\uff1a\u5b83\u53ef\u4ee5\u63d0\u4f9b\u4e00\u4e2a\u5fd7\u540c\u9053\u5408\u7684\u73a9\u5bb6\u793e\u533a\uff0c\u7528\u4e8e\u5206\u4eab\u7b56\u7565\u548c\u56e2\u961f\u534f\u8c03\u3002\u6b65\u9aa4\u4e8c\uff1a\u516c\u4f1a\u901a\u5e38\u53c2\u4e0e\u516c\u4f1a\u6218\u4e89\uff0c\u8fd9\u63d0\u4f9b\u4e86\u72ec\u7279\u7684\u5956\u52b1\u548c\u70ab\u8000\u7684\u6743\u5229\u3002\u6b65\u9aa4\u4e09\uff1a\u52a0\u5165\u516c\u4f1a\u8fd8\u53ef\u4ee5\u8ba9\u4f60\u83b7\u5f97\u72ec\u5bb6\u6e38\u620f\u8d44\u6e90\u548c\u7ecf\u9a8c\u4e30\u5bcc\u7684\u6210\u5458\u63d0\u4f9b\u7684\u5efa\u8bae\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u867d\u7136\u5355\u4eba\u6e38\u620f\u63d0\u4f9b\u4e86\u81ea\u7531\u5ea6\uff0c\u4f46\u52a0\u5165\u516c\u4f1a\u5219\u63d0\u4f9b\u4e86\u7ed3\u6784\u5316\u7684\u652f\u6301\u548c\u589e\u5f3a\u7684\u6e38\u620f\u673a\u4f1a\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728Battledudes.io\u4e2d\u4f18\u5316\u6e38\u620f\u8bbe\u7f6e\u4ee5\u83b7\u5f97\u66f4\u597d\u7684\u6027\u80fd\uff1f", "answer": "\u4f18\u5316Battledudes.io\u4e2d\u7684\u6e38\u620f\u8bbe\u7f6e\u53ef\u4ee5\u663e\u7740\u63d0\u9ad8\u6027\u80fd\u3002\u964d\u4f4e\u56fe\u5f62\u8bbe\u7f6e\uff08\u4f8b\u5982\u7eb9\u7406\u8d28\u91cf\u548c\u9634\u5f71\u7ec6\u8282\uff09\u53ef\u4ee5\u63d0\u9ad8\u5e27\u7387\uff0c\u5c24\u5176\u662f\u5728\u4f4e\u7aef\u7cfb\u7edf\u4e0a\u3002\u6b64\u5916\uff0c\u5c06\u9f20\u6807\u7075\u654f\u5ea6\u8c03\u6574\u5230\u9002\u5408\u4f60\u7684\u6e38\u620f\u98ce\u683c\u53ef\u4ee5\u63d0\u9ad8\u7784\u51c6\u7cbe\u5ea6\u3002\u4f8b\u5982\uff0c\u8f83\u4f4e\u7684\u7075\u654f\u5ea6\u8bbe\u7f6e\u53ef\u4ee5\u5e2e\u52a9\u8fdb\u884c\u7cbe\u786e\u7684\u72d9\u51fb\u5c04\u51fb\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u7eb9\u7406\u8d28\u91cf - \u4f4e\uff0c\u9634\u5f71\u7ec6\u8282 - \u5173\u95ed\uff0c\u9f20\u6807\u7075\u654f\u5ea6 - \u81ea\u5b9a\u4e49\u3002]"}, {"question": "\u5728Battledudes.io\u4e2d\u66f4\u6362\u8bbe\u5907\u65f6\uff0c\u73a9\u5bb6\u5e94\u8be5\u4e86\u89e3\u54ea\u4e9b\u5173\u4e8e\u6570\u636e\u8fc1\u79fb\u7684\u4fe1\u606f\uff1f", "answer": "\u5728Battledudes.io\u4e2d\u66f4\u6362\u8bbe\u5907\u65f6\uff0c\u73a9\u5bb6\u5e94\u8be5\u786e\u4fdd\u5176\u6e38\u620f\u6570\u636e\u8fc1\u79fb\u5230\u4f4d\u3002\u8fd9\u901a\u5e38\u6d89\u53ca\u5c06\u4f60\u7684\u6e38\u620f\u5e10\u6237\u94fe\u63a5\u5230\u7535\u5b50\u90ae\u4ef6\u6216\u793e\u4ea4\u5a92\u4f53\u5e10\u6237\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4ece\u4e2a\u4eba\u7535\u8111\u8fc1\u79fb\u5230\u79fb\u52a8\u8bbe\u5907\uff0c\u767b\u5f55\u5230\u540c\u4e00\u94fe\u63a5\u5e10\u6237\u5c06\u65e0\u7f1d\u5730\u4f20\u8f93\u4f60\u7684\u8fdb\u5ea6\u3002\u5728\u65b0\u7684\u8bbe\u5907\u4e0a\u5f00\u59cb\u6e38\u620f\u4e4b\u524d\uff0c\u8bf7\u52a1\u5fc5\u9a8c\u8bc1\u4f60\u7684\u6570\u636e\u5df2\u6b63\u786e\u540c\u6b65\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u6570\u636e\u8fc1\u79fb\u60f3\u8c61\u6210\u642c\u5bb6\uff1b\u4f60\u9700\u8981\u786e\u4fdd\u6240\u6709\u7269\u54c1\u90fd\u5b89\u5168\u5730\u8fd0\u9001\u5230\u65b0\u5730\u70b9\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728Battledudes.io\u4e2d\u53d1\u73b0\u548c\u89e3\u9501\u9690\u85cf\u5185\u5bb9\uff1f", "answer": "\u5728Battledudes.io\u4e2d\u53d1\u73b0\u548c\u89e3\u9501\u9690\u85cf\u5185\u5bb9\u9700\u8981\u63a2\u7d22\u548c\u5b8c\u6210\u7279\u5b9a\u6311\u6218\u3002\u4f8b\u5982\uff0c\u5728\u5730\u56fe\u4e0a\u627e\u5230\u79d8\u5bc6\u533a\u57df\u6216\u8fbe\u5230\u7279\u5b9a\u91cc\u7a0b\u7891\u53ef\u4ee5\u89e3\u9501\u72ec\u7279\u7684\u5916\u89c2\u6216\u6b66\u5668\u3002\u6ce8\u610f\u73af\u5883\u7ebf\u7d22\uff0c\u4e0e\u53ef\u7591\u7269\u4f53\u4e92\u52a8\uff0c\u4ee5\u63ed\u793a\u8fd9\u4e9b\u79d8\u5bc6\u3002[\u5f69\u86cb\u6316\u6398: \u9690\u85cf\u5185\u5bb9\u901a\u5e38\u4f1a\u5956\u52b1\u73a9\u5bb6\u7a00\u6709\u7269\u54c1\uff0c\u8fd9\u4e9b\u7269\u54c1\u53ef\u4ee5\u5728\u6218\u6597\u4e2d\u8d4b\u4e88\u4ed6\u4eec\u4f18\u52bf\u3002]"}, {"question": "\u5728Battledudes.io\u4e2d\uff0c\u54ea\u4e9b\u56e2\u961f\u89d2\u8272\u6700\u6709\u6548\uff0c\u80fd\u5e2e\u52a9\u53d6\u5f97\u80dc\u5229\uff1f", "answer": "\u5728Battledudes.io\u4e2d\uff0c\u6709\u6548\u7684\u56e2\u961f\u89d2\u8272\u5bf9\u53d6\u5f97\u80dc\u5229\u81f3\u5173\u91cd\u8981\u3002\u653b\u51fb\u89d2\u8272\u4e13\u6ce8\u4e8e\u524d\u7ebf\u6218\u6597\uff0c\u5bf9\u654c\u4eba\u9020\u6210\u91cd\u5927\u4f24\u5bb3\u3002\u652f\u63f4\u89d2\u8272\u4e3a\u961f\u53cb\u63d0\u4f9b\u6cbb\u7597\u548c\u589e\u76ca\uff0c\u589e\u5f3a\u4ed6\u4eec\u7684\u751f\u5b58\u80fd\u529b\u3002\u72d9\u51fb\u89d2\u8272\u4ece\u8fdc\u5904\u6e05\u9664\u9ad8\u4ef7\u503c\u76ee\u6807\u3002\u4f8b\u5982\uff0c\u4e00\u4e2a\u534f\u8c03\u826f\u597d\u7684\u56e2\u961f\uff0c\u89d2\u8272\u5e73\u8861\uff0c\u53ef\u4ee5\u51ed\u501f\u4e92\u76f8\u5f25\u8865\u5f31\u70b9\u6765\u4e3b\u5bfc\u6218\u573a\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u867d\u7136\u7531\u5168\u90e8\u653b\u51fb\u89d2\u8272\u7ec4\u6210\u7684\u56e2\u961f\u7f3a\u4e4f\u6301\u7eed\u6027\uff0c\u4f46\u5e73\u8861\u7684\u56e2\u961f\u80fd\u591f\u9002\u5e94\u5404\u79cd\u6218\u6597\u573a\u666f\u3002]"}]
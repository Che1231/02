[{"question": "\u5982\u4f55\u8b93\u65b0\u7684\u73a9\u5bb6\u5feb\u901f\u4e0a\u624bBattledudes.io\u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u5feb\u901f\u4e0a\u624bBattledudes.io\uff0c\u65b0\u73a9\u5bb6\u61c9\u5148\u719f\u6089\u57fa\u672c\u63a7\u5236\u3002\u79fb\u52d5\u4f7f\u7528WASD\u9375\uff0c\u7784\u6e96\u548c\u5c04\u64ca\u4f7f\u7528\u6ed1\u9f20\u3002\u4f8b\u5982\uff0c\u8981\u5c07\u89d2\u8272\u79fb\u5230\u53f3\u5074\uff0c\u8acb\u6309\"D\"\u9375\u3002\u6b64\u5916\uff0c\u6309\u4e0b\u7a7a\u683c\u9375\u53ef\u4ee5\u8df3\u8e8d\uff0c\u9019\u6709\u52a9\u65bc\u8eb2\u907f\u6575\u4eba\u7684\u653b\u64ca\u3002\u5728\u8a13\u7df4\u5340\u7df4\u7fd2\u9019\u4e9b\u63a7\u5236\uff0c\u5728\u9032\u5165\u771f\u5be6\u6230\u9b25\u524d\u5efa\u7acb\u4fe1\u5fc3\u3002[\u6bd4\u55bb\u8aaa\u660e: \u60f3\u50cf\u8a13\u7df4\u5340\u5c31\u50cf\u9ad8\u723e\u592b\u64ca\u7403\u7df4\u7fd2\u5834\uff0c\u53ef\u4ee5\u8b93\u4f60\u7df4\u7fd2\u63ee\u687f\u52d5\u4f5c\uff0c\u518d\u5230\u7403\u5834\u4e0a\u63ee\u687f\u3002]"}, {"question": "\u5c0d\u65bc\u904a\u6232\u6642\u9593\u8d85\u904e 100 \u5c0f\u6642\u7684\u73a9\u5bb6\u4f86\u8aaa\uff0c\u5728Battledudes.io\u4e2d\u751f\u5b58\u66f4\u4e45\u7684\u95dc\u9375\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5c0d\u65bc\u5728Battledudes.io\u904a\u6232\u6642\u9593\u8d85\u904e 100 \u5c0f\u6642\u7684\u8cc7\u6df1\u73a9\u5bb6\u4f86\u8aaa\uff0c\u751f\u5b58\u53d6\u6c7a\u65bc\u5148\u9032\u7684\u7b56\u7565\u3002\u6b65\u9a5f\u4e00\uff1a\u59cb\u7d42\u6ce8\u610f\u5468\u570d\u74b0\u5883\uff0c\u7d93\u5e38\u67e5\u770b\u5c0f\u5730\u5716\u3002\u6b65\u9a5f\u4e8c\uff1a\u6709\u6548\u5229\u7528\u63a9\u9ad4\uff1b\u4f8b\u5982\uff0c\u8eb2\u5728\u7246\u58c1\u6216\u5efa\u7bc9\u7269\u5f8c\u9762\u4ee5\u907f\u514d\u6575\u4eba\u653b\u64ca\u3002\u6b65\u9a5f\u4e09\uff1a\u719f\u7df4\u4f7f\u7528\u80fd\u529b\u63d0\u5347\u9053\u5177\uff0c\u4f8b\u5982\uff0c\"\u5065\u5eb7\u5305\"\uff0c\u53ef\u5728\u95dc\u9375\u6642\u523b\u6062\u5fa9\u4f60\u7684\u751f\u547d\u503c\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u96d6\u7136\u7a4d\u6975\u7684\u904a\u6232\u65b9\u5f0f\u53ef\u4ee5\u5feb\u901f\u64ca\u6bba\u6575\u4eba\uff0c\u4f46\u66f4\u88ab\u52d5\u7684\u65b9\u5f0f\u901a\u5e38\u6703\u5c0e\u81f4\u66f4\u9577\u6642\u9593\u7684\u751f\u5b58\u6642\u9593\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u77ad\u89e3Battledudes.io\u7684\u91cd\u751f\u6a5f\u5236\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u77ad\u89e3Battledudes.io\u7684\u91cd\u751f\u6a5f\u5236\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u76f4\u63a5\u5f71\u97ff\u4f60\u7684\u904a\u6232\u7b56\u7565\u3002\u7576\u4f60\u88ab\u64ca\u6557\u6642\uff0c\u4f60\u6703\u5728\u5730\u5716\u4e0a\u7684\u96a8\u6a5f\u4f4d\u7f6e\u91cd\u751f\u3002\u9019\u610f\u5473\u8457\u4f60\u9700\u8981\u5feb\u901f\u91cd\u65b0\u5b9a\u4f4d\u81ea\u5df1\u4e26\u91cd\u65b0\u52a0\u5165\u6230\u9b25\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u88ab\u64ca\u6557\u4e4b\u524d\u4f54\u64da\u4e00\u500b\u95dc\u9375\u4f4d\u7f6e\uff0c\u77ad\u89e3\u91cd\u751f\u9ede\u53ef\u4ee5\u5e6b\u52a9\u4f60\u8fc5\u901f\u8fd4\u56de\u8a72\u5340\u57df\u3002[\u6d41\u7a0b\u5716\u89e3: \u64ca\u6557 \u2192 \u96a8\u6a5f\u4f4d\u7f6e\u91cd\u751f \u2192 \u91cd\u65b0\u5b9a\u4f4d \u2192 \u91cd\u65b0\u52a0\u5165\u6230\u9b25\u3002]"}, {"question": "\u5728Battledudes.io\u4e2d\uff0c\u54ea\u4e9b\u6b66\u5668\u5728\u4e0d\u540c\u7684\u6230\u9b25\u5834\u666f\u4e0b\u6700\u6709\u6548\uff1f", "answer": "\u5728Battledudes.io\u4e2d\uff0c\u6b66\u5668\u7684\u6709\u6548\u6027\u96a8\u6230\u9b25\u5834\u666f\u800c\u7570\u3002\u8fd1\u8ddd\u96e2\u6230\u9b25\uff0c\u6563\u5f48\u69cd\u7531\u65bc\u5176\u5728\u8fd1\u8ddd\u96e2\u7684\u9ad8\u50b7\u5bb3\u8f38\u51fa\u800c\u975e\u5e38\u6709\u6548\u3002\u9060\u8ddd\u96e2\u6230\u9b25\uff0c\u72d9\u64ca\u6b65\u69cd\u5141\u8a31\u5f9e\u9060\u8655\u9032\u884c\u7cbe\u78ba\u5c04\u64ca\u3002\u4f8b\u5982\uff0c\u5728\u4e2d\u8ddd\u96e2\u4ea4\u6230\u4e2d\u4f7f\u7528\u7a81\u64ca\u6b65\u69cd\uff0c\u5176\u6e96\u78ba\u6027\u548c\u5c04\u901f\u7684\u5e73\u8861\u6027\u975e\u5e38\u51fa\u8272\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u6563\u5f48\u69cd - \u8fd1\u8ddd\u96e2\uff0c\u72d9\u64ca\u6b65\u69cd - \u9060\u8ddd\u96e2\uff0c\u7a81\u64ca\u6b65\u69cd - \u4e2d\u8ddd\u96e2\u3002]"}, {"question": "Battledudes.io\u7684\u914d\u5c0d\u7cfb\u7d71\u5982\u4f55\u78ba\u4fdd\u5e73\u8861\u7684\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "Battledudes.io\u7684\u914d\u5c0d\u7cfb\u7d71\u901a\u904e\u5c07\u6280\u80fd\u6c34\u5e73\u76f8\u4f3c\u7684\u73a9\u5bb6\u914d\u5c0d\u4f86\u78ba\u4fdd\u5e73\u8861\u7684\u904a\u6232\u9ad4\u9a57\u3002\u9019\u901a\u904e\u4e00\u500b\u8a55\u4f30\u4f60\u7684\u7e3e\u6548\u6307\u6a19\u7684\u6f14\u7b97\u6cd5\u5be6\u73fe\uff0c\u4f8b\u5982\u64ca\u6bba/\u6b7b\u4ea1\u6bd4\u548c\u7372\u52dd\u7387\u3002\u4f8b\u5982\uff0c\u7372\u52dd\u7387\u9ad8\u7684\u73a9\u5bb6\u5c07\u8207\u5176\u4ed6\u9ad8\u8868\u73fe\u73a9\u5bb6\u914d\u5c0d\uff0c\u78ba\u4fdd\u6bd4\u8cfd\u5177\u6709\u7af6\u722d\u6027\u548c\u516c\u5e73\u6027\u3002[\u6bd4\u55bb\u8aaa\u660e: \u60f3\u50cf\u4e00\u4e0b\u8c61\u68cb\u6bd4\u8cfd\uff0c\u73a9\u5bb6\u6839\u64da\u4ed6\u5011\u7684Elo\u8a55\u7d1a\u5206\u7d44\uff0c\u4ee5\u78ba\u4fdd\u6bcf\u4e00\u5834\u6bd4\u8cfd\u90fd\u662f\u4e00\u5834\u6311\u6230\u3002]"}, {"question": "\u5c0d\u65bc\u9ad8\u7d1a\u73a9\u5bb6\u4f86\u8aaa\uff0c\u52a0\u5165Battledudes.io\u7684\u5e6b\u6d3e\u6709\u4ec0\u9ebc\u597d\u8655\uff1f", "answer": "\u5728Battledudes.io\u4e2d\u52a0\u5165\u5e6b\u6d3e\uff0c\u5c0d\u9ad8\u7d1a\u73a9\u5bb6\u4f86\u8aaa\u6709\u5f88\u591a\u597d\u8655\u3002\u6b65\u9a5f\u4e00\uff1a\u5b83\u63d0\u4f9b\u4e86\u4e00\u500b\u5fd7\u540c\u9053\u5408\u7684\u73a9\u5bb6\u793e\u7fa4\uff0c\u7528\u65bc\u5206\u4eab\u7b56\u7565\u548c\u5718\u968a\u5354\u8abf\u3002\u6b65\u9a5f\u4e8c\uff1a\u5e6b\u6d3e\u901a\u5e38\u53c3\u8207\u5e6b\u6d3e\u6230\u722d\uff0c\u9019\u63d0\u4f9b\u7368\u7279\u7684\u734e\u52f5\u548c\u70ab\u8000\u7684\u6a5f\u6703\u3002\u6b65\u9a5f\u4e09\uff1a\u6210\u70ba\u5e6b\u6d3e\u6210\u54e1\u9084\u53ef\u4ee5\u8b93\u4f60\u5f9e\u7d93\u9a57\u8c50\u5bcc\u7684\u6210\u54e1\u90a3\u88e1\u7372\u5f97\u7368\u5bb6\u7684\u904a\u6232\u8cc7\u6e90\u548c\u6280\u5de7\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u96d6\u7136\u55ae\u4eba\u904a\u6232\u63d0\u4f9b\u81ea\u7531\u5ea6\uff0c\u4f46\u5e6b\u6d3e\u6210\u54e1\u63d0\u4f9b\u7d50\u69cb\u5316\u7684\u652f\u63f4\u548c\u589e\u5f37\u7684\u904a\u6232\u6a5f\u6703\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728Battledudes.io\u4e2d\u512a\u5316\u904a\u6232\u8a2d\u5b9a\u4ee5\u7372\u5f97\u66f4\u597d\u7684\u6548\u80fd\uff1f", "answer": "\u512a\u5316Battledudes.io\u4e2d\u7684\u904a\u6232\u8a2d\u5b9a\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u6548\u80fd\u3002\u964d\u4f4e\u5716\u5f62\u8a2d\u5b9a\uff0c\u4f8b\u5982\u7d0b\u7406\u54c1\u8cea\u548c\u9670\u5f71\u7d30\u7bc0\uff0c\u53ef\u4ee5\u6539\u5584\u756b\u9762\u5e40\u6578\uff0c\u5c24\u5176\u662f\u5728\u4f4e\u7aef\u7cfb\u7d71\u4e0a\u3002\u6b64\u5916\uff0c\u8abf\u6574\u6ed1\u9f20\u9748\u654f\u5ea6\u4ee5\u7b26\u5408\u4f60\u7684\u904a\u6232\u98a8\u683c\uff0c\u53ef\u4ee5\u63d0\u9ad8\u7784\u6e96\u6e96\u78ba\u6027\u3002\u4f8b\u5982\uff0c\u8f03\u4f4e\u7684\u9748\u654f\u5ea6\u8a2d\u5b9a\u6709\u52a9\u65bc\u7cbe\u78ba\u7684\u72d9\u64ca\u5c04\u64ca\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u7d0b\u7406\u54c1\u8cea - \u4f4e\uff0c\u9670\u5f71\u7d30\u7bc0 - \u95dc\u9589\uff0c\u6ed1\u9f20\u9748\u654f\u5ea6 - \u6839\u64da\u500b\u4eba\u9700\u6c42\u8abf\u6574\u3002]"}, {"question": "\u73a9\u5bb6\u5728Battledudes.io\u4e2d\u5207\u63db\u88dd\u7f6e\u6642\uff0c\u61c9\u8a72\u6ce8\u610f\u54ea\u4e9b\u95dc\u65bc\u8cc7\u6599\u9077\u79fb\u7684\u4e8b\u9805\uff1f", "answer": "\u5728Battledudes.io\u4e2d\u5207\u63db\u88dd\u7f6e\u6642\uff0c\u73a9\u5bb6\u61c9\u78ba\u4fdd\u5176\u904a\u6232\u8cc7\u6599\u5df2\u6b63\u78ba\u9077\u79fb\u3002\u9019\u901a\u5e38\u6d89\u53ca\u5c07\u4f60\u7684\u904a\u6232\u5e33\u6236\u9023\u7d50\u81f3\u96fb\u5b50\u90f5\u4ef6\u6216\u793e\u4ea4\u5a92\u9ad4\u5e33\u6236\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5f9e\u96fb\u8166\u79fb\u5230\u884c\u52d5\u88dd\u7f6e\uff0c\u767b\u5165\u76f8\u540c\u7684\u9023\u7d50\u5e33\u6236\u5c07\u6703\u9806\u5229\u5730\u50b3\u8f38\u4f60\u7684\u9032\u5ea6\u3002\u5728\u65b0\u7684\u88dd\u7f6e\u4e0a\u958b\u59cb\u904a\u6232\u4e4b\u524d\uff0c\u52d9\u5fc5\u9a57\u8b49\u4f60\u7684\u8cc7\u6599\u5df2\u6b63\u78ba\u540c\u6b65\u3002[\u6bd4\u55bb\u8aaa\u660e: \u60f3\u50cf\u8cc7\u6599\u9077\u79fb\u5c31\u50cf\u642c\u5bb6\u4e00\u6a23\uff1b\u4f60\u60f3\u8981\u78ba\u4fdd\u6240\u6709\u4f60\u7684\u7269\u54c1\u90fd\u5b89\u5168\u5730\u904b\u9001\u5230\u65b0\u7684\u5730\u9ede\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u767c\u73fe\u548c\u89e3\u9396Battledudes.io\u4e2d\u7684\u96b1\u85cf\u5167\u5bb9\uff1f", "answer": "\u767c\u73fe\u548c\u89e3\u9396Battledudes.io\u4e2d\u7684\u96b1\u85cf\u5167\u5bb9\uff0c\u9700\u8981\u63a2\u7d22\u548c\u5b8c\u6210\u7279\u5b9a\u6311\u6230\u3002\u4f8b\u5982\uff0c\u5728\u5730\u5716\u4e0a\u627e\u5230\u79d8\u5bc6\u5340\u57df\u6216\u9054\u6210\u7279\u5b9a\u91cc\u7a0b\u7891\uff0c\u53ef\u4ee5\u89e3\u9396\u7368\u7279\u7684\u76ae\u819a\u6216\u6b66\u5668\u3002\u6ce8\u610f\u74b0\u5883\u7dda\u7d22\uff0c\u4e26\u8207\u53ef\u7591\u7269\u4ef6\u4e92\u52d5\uff0c\u4ee5\u63ed\u793a\u9019\u4e9b\u79d8\u5bc6\u3002[\u5f69\u86cb\u6316\u6398: \u96b1\u85cf\u5167\u5bb9\u901a\u5e38\u6703\u734e\u52f5\u73a9\u5bb6\u7a00\u6709\u7684\u7269\u54c1\uff0c\u9019\u80fd\u8b93\u4ed6\u5011\u5728\u6230\u9b25\u4e2d\u6709\u512a\u52e2\u3002]"}, {"question": "\u5728Battledudes.io\u4e2d\uff0c\u54ea\u4e9b\u5718\u968a\u89d2\u8272\u6700\u6709\u6548\uff0c\u53ef\u4ee5\u53d6\u5f97\u52dd\u5229\uff1f", "answer": "\u5728Battledudes.io\u4e2d\uff0c\u6709\u6548\u7684\u5718\u968a\u89d2\u8272\u5c0d\u65bc\u53d6\u5f97\u52dd\u5229\u81f3\u95dc\u91cd\u8981\u3002\u7a81\u64ca\u89d2\u8272\u5c08\u6ce8\u65bc\u524d\u7dda\u6230\u9b25\uff0c\u5c0d\u6575\u4eba\u9020\u6210\u5927\u91cf\u50b7\u5bb3\u3002\u652f\u63f4\u89d2\u8272\u70ba\u968a\u53cb\u63d0\u4f9b\u6cbb\u7642\u548c\u589e\u76ca\uff0c\u589e\u5f37\u5176\u751f\u5b58\u80fd\u529b\u3002\u72d9\u64ca\u89d2\u8272\u5247\u5f9e\u9060\u8ddd\u96e2\u6e05\u9664\u9ad8\u50f9\u503c\u76ee\u6a19\u3002\u4f8b\u5982\uff0c\u4e00\u500b\u5354\u8abf\u826f\u597d\u7684\u5718\u968a\uff0c\u89d2\u8272\u5e73\u8861\uff0c\u80fd\u5920\u901a\u904e\u4e92\u76f8\u5f4c\u88dc\u5f31\u9ede\u4f86\u638c\u63a7\u6230\u5834\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u96d6\u7136\u7531\u6240\u6709\u7a81\u64ca\u968a\u54e1\u7d44\u6210\u7684\u5718\u968a\u53ef\u80fd\u7f3a\u4e4f\u6301\u7e8c\u529b\uff0c\u4f46\u5e73\u8861\u7684\u5718\u968a\u53ef\u4ee5\u9069\u61c9\u5404\u7a2e\u6230\u9b25\u5834\u666f\u3002]"}]
[{"question": "\u042f\u043a \u0440\u043e\u0437\u043f\u043e\u0447\u0430\u0442\u0438 \u0433\u0440\u0443 \u0432 \u0432\u0456\u0441\u0456\u043c\u043a\u0438? \u042f\u043a\u0443 \u043f\u0435\u0440\u0448\u0443 \u0431\u0443\u043a\u0432\u0443 \u044f \u043f\u043e\u0432\u0438\u043d\u0435\u043d \u0432\u0433\u0430\u0434\u0430\u0442\u0438, \u044f\u043a \u043d\u043e\u0432\u0430\u0447\u043e\u043a?", "answer": "\u0413\u0440\u0430 \u0432 \u0432\u0456\u0441\u0456\u043c\u043a\u0438 \u0434\u0443\u0436\u0435 \u043f\u0440\u043e\u0441\u0442\u0430. \u041f\u0456\u0441\u043b\u044f \u0437\u0430\u043f\u0443\u0441\u043a\u0443 \u0433\u0440\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0432\u0438\u043f\u0430\u0434\u043a\u043e\u0432\u0438\u043c \u0447\u0438\u043d\u043e\u043c \u043e\u0431\u0438\u0440\u0430\u0454 \u0441\u043b\u043e\u0432\u043e, \u0456 \u0432\u0430\u043c \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u043f\u043e\u0447\u0430\u0442\u0438 \u0432\u0433\u0430\u0434\u0443\u0432\u0430\u0442\u0438 \u0431\u0443\u043a\u0432\u0438. \u0414\u043b\u044f \u043d\u043e\u0432\u0430\u0447\u043a\u0456\u0432 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0454\u0442\u044c\u0441\u044f \u0441\u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u0432\u0433\u0430\u0434\u0443\u0432\u0430\u0442\u0438 \u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0456 \u0433\u043e\u043b\u043e\u0441\u043d\u0456 \u0431\u0443\u043a\u0432\u0438, \u0442\u0430\u043a\u0456 \u044f\u043a 'E', 'A', 'I', \u043e\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u0432\u043e\u043d\u0438 \u0447\u0430\u0441\u0442\u043e \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u044e\u0442\u044c\u0441\u044f \u0432 \u0430\u043d\u0433\u043b\u0456\u0439\u0441\u044c\u043a\u0438\u0445 \u0441\u043b\u043e\u0432\u0430\u0445 \u0456 \u043f\u0456\u0434\u0432\u0438\u0449\u0443\u044e\u0442\u044c \u0439\u043c\u043e\u0432\u0456\u0440\u043d\u0456\u0441\u0442\u044c \u0432\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u043d\u044f. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u044f\u043a\u0449\u043e \u0432\u0438 \u0441\u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u0432\u0433\u0430\u0434\u0430\u0454\u0442\u0435 'E' \u0456 \u0432\u0438\u044f\u0432\u0438\u0442\u0435, \u0449\u043e \u0442\u0430\u043a\u043e\u0433\u043e \u0441\u043b\u043e\u0432\u0430 \u043d\u0435\u043c\u0430\u0454, \u0442\u043e \u043c\u043e\u0436\u0435\u0442\u0435 \u0441\u043f\u0440\u043e\u0431\u0443\u0432\u0430\u0442\u0438 'A'. \u0426\u0435 \u043f\u0440\u043e\u0446\u0435\u0441 \u043f\u043e\u0441\u0442\u0443\u043f\u043e\u0432\u043e\u0433\u043e \u0437\u0432\u0443\u0436\u0435\u043d\u043d\u044f \u043a\u043e\u043b\u0430 \u043c\u043e\u0436\u043b\u0438\u0432\u0438\u0445 \u0432\u0430\u0440\u0456\u0430\u043d\u0442\u0456\u0432."}, {"question": "\u0427\u043e\u043c\u0443 \u0432 \u0433\u0440\u0456 \u0432 \u0432\u0456\u0441\u0456\u043c\u043a\u0438 \u043f\u043e\u043c\u0438\u043b\u043a\u0430 \u0432 \u0432\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u043d\u0456 \u0431\u0443\u043a\u0432\u0438 \u043f\u0440\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u044c \u0434\u043e \u043f\u043e\u043a\u0430\u0440\u0430\u043d\u043d\u044f? \u042f\u043a \u043f\u043e\u043a\u0430\u0440\u0430\u043d\u043d\u044f \u0432\u043f\u043b\u0438\u0432\u0430\u0454 \u043d\u0430 \u043c\u043e\u044e \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u044e \u0433\u0440\u0438?", "answer": "\u0423 \u0433\u0440\u0456 \u0432\u0456\u0441\u0456\u043c\u043a\u0438 \u043f\u043e\u043c\u0438\u043b\u043a\u0430 \u0443 \u0432\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u043d\u0456 \u043b\u0456\u0442\u0435\u0440\u0438 \u043f\u0440\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u044c \u0434\u043e \u043f\u043e\u0441\u0442\u0443\u043f\u043e\u0432\u043e\u0433\u043e \u043f\u043e\u0431\u0443\u0434\u043e\u0432\u0438 \u0448\u0438\u0431\u0435\u043d\u0438\u0446\u0456. \u0417\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u0433\u0440\u0430 \u043d\u0430\u0434\u0430\u0454 \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u0443 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u043f\u043e\u043c\u0438\u043b\u043e\u043a (\u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u0448\u0456\u0441\u0442\u044c). \u0417\u0430 \u043a\u043e\u0436\u043d\u0443 \u043f\u043e\u043c\u0438\u043b\u043a\u0443 \u0448\u0438\u0431\u0435\u043d\u0438\u0446\u044f \u0434\u043e\u043f\u043e\u0432\u043d\u044e\u0454\u0442\u044c\u0441\u044f, \u0434\u043e\u043a\u0438 \u043d\u0435 \u0431\u0443\u0434\u0435 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u043f\u043e\u0431\u0443\u0434\u043e\u0432\u0430\u043d\u0430, \u0456 \u0432\u0438 \u043f\u0440\u043e\u0433\u0440\u0430\u0454\u0442\u0435. \u0422\u043e\u043c\u0443 \u043d\u0430\u044f\u0432\u043d\u0456\u0441\u0442\u044c \u043f\u043e\u043a\u0430\u0440\u0430\u043d\u043d\u044f \u0437\u043d\u0430\u0447\u043d\u043e \u0432\u043f\u043b\u0438\u0432\u0430\u0454 \u043d\u0430 \u0432\u0430\u0448\u0443 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u044e \u0433\u0440\u0438. \u0412\u0430\u043c \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u0440\u0435\u0442\u0435\u043b\u044c\u043d\u043e \u0432\u0438\u0431\u0438\u0440\u0430\u0442\u0438 \u0431\u0443\u043a\u0432\u0438, \u0443\u043d\u0438\u043a\u0430\u044e\u0447\u0438 \u0432\u0438\u043f\u0430\u0434\u043a\u043e\u0432\u0438\u0445 \u0441\u043f\u0440\u043e\u0431. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043a\u043e\u043b\u0438 \u0443 \u0432\u0430\u0441 \u0437\u0430\u043b\u0438\u0448\u0438\u043b\u043e\u0441\u044f \u043b\u0438\u0448\u0435 \u0434\u0432\u0456 \u0441\u043f\u0440\u043e\u0431\u0438, \u0432\u0438 \u043f\u043e\u0432\u0438\u043d\u043d\u0456 \u043d\u0430\u0441\u0430\u043c\u043f\u0435\u0440\u0435\u0434 \u0432\u0433\u0430\u0434\u0430\u0442\u0438 \u0442\u0456 \u0431\u0443\u043a\u0432\u0438, \u0432 \u044f\u043a\u0456 \u0432\u0438 \u0449\u0438\u0440\u043e \u0432\u043f\u0435\u0432\u043d\u0435\u043d\u0456, \u0430\u0431\u043e \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0456 \u0432\u0456\u0434\u043e\u043c\u0438\u0445 \u0431\u0443\u043a\u0432 \u0441\u043f\u0440\u043e\u0431\u0443\u0432\u0430\u0442\u0438 \u043f\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0438\u0442\u0438 \u043c\u043e\u0436\u043b\u0438\u0432\u0435 \u0441\u043b\u043e\u0432\u043e."}, {"question": "\u042f\u043a\u0430 \u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0430 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u044f \u0432 \u0433\u0440\u0456 \u0432 \u0432\u0456\u0441\u0456\u043c\u043a\u0438, \u0449\u043e\u0431 \u0443\u043d\u0438\u043a\u043d\u0443\u0442\u0438 \"\u043f\u043e\u0432\u0435\u0448\u0435\u043d\u043d\u044f\"? \u0427\u0438 \u0454 \u0443\u043d\u0456\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u0438\u0439 \u043c\u0435\u0442\u043e\u0434, \u044f\u043a\u0438\u0439 \u043f\u0456\u0434\u0445\u043e\u0434\u0438\u0442\u044c \u0434\u043b\u044f \u0441\u043b\u0456\u0432 \u0431\u0443\u0434\u044c-\u044f\u043a\u043e\u0457 \u0434\u043e\u0432\u0436\u0438\u043d\u0438?", "answer": "\u041a\u043b\u044e\u0447 \u0434\u043e \u0443\u043d\u0438\u043a\u043d\u0435\u043d\u043d\u044f \"\u043f\u043e\u0432\u0435\u0448\u0435\u043d\u043d\u044f\" \u043f\u043e\u043b\u044f\u0433\u0430\u0454 \u0443 \u043f\u0456\u0434\u0432\u0438\u0449\u0435\u043d\u043d\u0456 \u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0456 \u0432\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u043d\u044f. \u041a\u0420\u041e\u041a 1: \u0421\u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0432\u0433\u0430\u0434\u0430\u0442\u0438 \u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0456 \u0433\u043e\u043b\u043e\u0441\u043d\u0456 \u0431\u0443\u043a\u0432\u0438 (E, A, I, O, U). \u041a\u0420\u041e\u041a 2: \u041e\u0431\u0435\u0440\u0456\u0442\u044c \u0431\u0443\u043a\u0432\u0438, \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0456 \u0432\u0436\u0435 \u0432\u0433\u0430\u0434\u0430\u043d\u0438\u0445 \u0431\u0443\u043a\u0432, \u0442\u0430 \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0434\u043e\u043f\u043e\u0432\u043d\u0438\u0442\u0438 \u0457\u0445 \u0434\u043e \u0447\u0430\u0441\u0442\u043e \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u0454\u043c\u0438\u0445 \u0431\u0443\u043a\u0432\u0435\u043d\u0438\u0445 \u0441\u043f\u043e\u043b\u0443\u0447\u0435\u043d\u044c, \u0442\u0430\u043a\u0438\u0445 \u044f\u043a 'TH', 'ST', 'ING'. \u041a\u0420\u041e\u041a 3: \u041d\u0430 \u043e\u0441\u043d\u043e\u0432\u0456 \u0434\u043e\u0432\u0436\u0438\u043d\u0438 \u0441\u043b\u043e\u0432\u0430 \u0442\u0430 \u0432\u0456\u0434\u043e\u043c\u0438\u0445 \u0431\u0443\u043a\u0432 \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0437\u0432\u0443\u0437\u0438\u0442\u0438 \u043a\u043e\u043b\u043e \u043c\u043e\u0436\u043b\u0438\u0432\u0438\u0445 \u0432\u0430\u0440\u0456\u0430\u043d\u0442\u0456\u0432. \u0425\u043e\u0447\u0430 \u043d\u0435\u043c\u0430\u0454 \u0443\u043d\u0456\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043c\u0435\u0442\u043e\u0434\u0443, \u0449\u043e \u043f\u0456\u0434\u0445\u043e\u0434\u0438\u0442\u044c \u0434\u043b\u044f \u0432\u0441\u0456\u0445 \u0432\u0438\u043f\u0430\u0434\u043a\u0456\u0432, \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u043d\u0430\u0431\u0443\u0432\u0430\u0442\u0438 \u0434\u043e\u0441\u0432\u0456\u0434\u0443 \u0442\u0430 \u043f\u043e\u0441\u0442\u0443\u043f\u043e\u0432\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0438 \u0434\u0435\u044f\u043a\u0456 \u0437\u0430\u043a\u043e\u043d\u043e\u043c\u0456\u0440\u043d\u043e\u0441\u0442\u0456. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u044f\u043a\u0449\u043e \u0441\u043b\u043e\u0432\u043e \u043a\u043e\u0440\u043e\u0442\u043a\u0435, \u043c\u0430\u0454 3-4 \u043b\u0456\u0442\u0435\u0440\u0438, \u0442\u043e \u0432\u043e\u043d\u043e, \u0439\u043c\u043e\u0432\u0456\u0440\u043d\u043e, \u0454 \u0437\u0432\u0438\u0447\u0430\u0439\u043d\u0438\u043c \u0441\u043b\u043e\u0432\u043e\u043c. \u042f\u043a\u0449\u043e \u0441\u043b\u043e\u0432\u043e \u0434\u043e\u0432\u0433\u0435, \u0446\u0435 \u043c\u043e\u0436\u0435 \u0431\u0443\u0442\u0438 \u0441\u043f\u0435\u0446\u0456\u0430\u043b\u044c\u043d\u0435 \u0441\u043b\u043e\u0432\u043e \u0430\u0431\u043e \u0441\u043a\u043b\u0430\u0434\u0435\u043d\u0435 \u0441\u043b\u043e\u0432\u043e. \u041f\u0440\u0438\u043a\u043b\u0430\u0434: \u0423\u044f\u0432\u0456\u0442\u044c \u0433\u0440\u0443 \u0432 \u0432\u0456\u0441\u0456\u043c\u043a\u0438 \u044f\u043a \u0440\u043e\u0437\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u043d\u044f \u0437\u0430\u0433\u0430\u0434\u043a\u0438, \u043a\u043e\u0436\u043d\u0430 \u0432\u0433\u0430\u0434\u0430\u043d\u0430 \u0431\u0443\u043a\u0432\u0430 \u2014 \u0446\u0435 \u043f\u0456\u0434\u043a\u0430\u0437\u043a\u0430, \u044f\u043a\u0430 \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u0454 \u043f\u043e\u0441\u0442\u0443\u043f\u043e\u0432\u043e \u0440\u043e\u0437\u043a\u0440\u0438\u0442\u0438 \u0442\u0430\u0454\u043c\u043d\u0438\u0446\u044e."}, {"question": "\u042f\u043a \u0443 \u0433\u0440\u0456 \u0432 \u0432\u0456\u0441\u0456\u043c\u043a\u0438, \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0432\u0456\u0434\u043e\u043c\u0438\u0445 \u0431\u0443\u043a\u0432, \u043f\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0438\u0442\u0438 \u043c\u043e\u0436\u043b\u0438\u0432\u0456 \u0441\u043b\u043e\u0432\u0430? \u0427\u0438 \u0454 \u0434\u0435\u044f\u043a\u0456 \u043f\u0440\u0438\u0439\u043e\u043c\u0438, \u044f\u043a\u0456 \u043c\u043e\u0436\u043d\u0430 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438?", "answer": "\u0429\u043e\u0431 \u043f\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0438\u0442\u0438 \u043c\u043e\u0436\u043b\u0438\u0432\u0456 \u0441\u043b\u043e\u0432\u0430 \u0437\u0430 \u0432\u0456\u0434\u043e\u043c\u0438\u043c\u0438 \u0431\u0443\u043a\u0432\u0430\u043c\u0438, \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u0442\u0438 \u0434\u0435\u044f\u043a\u0456 \u043f\u0440\u0438\u0439\u043e\u043c\u0438. \u041f\u043e-\u043f\u0435\u0440\u0448\u0435, \u0437\u0432\u0435\u0440\u043d\u0456\u0442\u044c\u0441\u044f \u0434\u043e \u0440\u043e\u0437\u0442\u0430\u0448\u0443\u0432\u0430\u043d\u043d\u044f \u0431\u0443\u043a\u0432. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u044f\u043a\u0449\u043e \u0432 \u0441\u043b\u043e\u0432\u0456 \u0454 \u043f\u043e\u0441\u043b\u0456\u0434\u043e\u0432\u043d\u0456\u0441\u0442\u044c '-A-', \u0442\u043e \u043c\u043e\u0436\u043b\u0438\u0432\u0438\u043c\u0438 \u0441\u043b\u043e\u0432\u0430\u043c\u0438 \u043c\u043e\u0436\u0443\u0442\u044c \u0431\u0443\u0442\u0438 'BATH', 'PATH', 'MATH' \u0442\u0430 \u0456\u043d\u0448\u0456. \u041f\u043e-\u0434\u0440\u0443\u0433\u0435, \u0432\u0440\u0430\u0445\u0443\u0439\u0442\u0435 \u0447\u0430\u0441\u0442\u0438\u043d\u0443 \u043c\u043e\u0432\u0438 \u0441\u043b\u043e\u0432\u0430. \u042f\u043a\u0449\u043e \u043d\u0435\u043e\u0431\u0445\u0456\u0434\u043d\u043e \u0441\u043b\u043e\u0432\u043e-\u0456\u043c\u0435\u043d\u043d\u0438\u043a, \u0442\u043e \u0432\u0438\u043a\u043b\u044e\u0447\u0456\u0442\u044c \u0434\u0456\u0454\u0441\u043b\u043e\u0432\u0430. \u041f\u043e-\u0442\u0440\u0435\u0442\u0454, \u0441\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u0439\u0442\u0435\u0441\u044f \u0441\u043b\u043e\u0432\u043d\u0438\u043a\u043e\u043c \u0430\u0431\u043e \u043e\u043d\u043b\u0430\u0439\u043d-\u0440\u0435\u0441\u0443\u0440\u0441\u0430\u043c\u0438. \u0411\u0430\u0433\u0430\u0442\u043e \u043e\u043d\u043b\u0430\u0439\u043d-\u0441\u043b\u043e\u0432\u043d\u0438\u043a\u0456\u0432 \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0442\u044c \u0437\u0434\u0456\u0439\u0441\u043d\u044e\u0432\u0430\u0442\u0438 \u043f\u043e\u0448\u0443\u043a \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u043d\u0435\u043f\u043e\u0432\u043d\u043e\u0433\u043e \u0441\u043b\u043e\u0432\u0430, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0432\u0432\u0435\u0434\u0456\u0442\u044c 'b?t?' \u0443 \u0441\u043b\u043e\u0432\u043d\u0438\u043a\u0443 Cambridge, \u0449\u043e\u0431 \u0437\u043d\u0430\u0439\u0442\u0438 \u043c\u043e\u0436\u043b\u0438\u0432\u0456 \u0441\u043b\u043e\u0432\u0430 'BATH', 'BAT' \u0442\u0430 \u0456\u043d\u0448\u0456. \u0422\u0430\u0431\u043b\u0438\u0446\u044f \u043a\u043e\u0440\u0435\u043b\u044f\u0446\u0456\u0457: [\u0434\u043e\u0432\u0436\u0438\u043d\u0430 \u0441\u043b\u043e\u0432\u0430|\u0442\u0438\u043f\u043e\u0432\u0430 \u0447\u0430\u0441\u0442\u0438\u043d\u0430 \u043c\u043e\u0432\u0438]."}, {"question": "\u0423 \u0433\u0440\u0456 \u0432 \u0432\u0456\u0441\u0456\u043c\u043a\u0438 \u0434\u0435\u044f\u043a\u0456 \u0432\u0435\u0431-\u0441\u0430\u0439\u0442\u0438 \u0430\u0431\u043e \u0434\u043e\u0434\u0430\u0442\u043a\u0438 \u043f\u0440\u043e\u043f\u043e\u043d\u0443\u044e\u0442\u044c \u0442\u0435\u043c\u0430\u0442\u0438\u0447\u043d\u0456 \u0441\u043b\u043e\u0432\u043d\u0438\u043a\u0438, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0442\u0432\u0430\u0440\u0438\u043d\u0438, \u0440\u043e\u0441\u043b\u0438\u043d\u0438, \u0456\u0441\u0442\u043e\u0440\u0438\u0447\u043d\u0456 \u043f\u043e\u0441\u0442\u0430\u0442\u0456. \u042f\u043a \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0446\u0456 \u0442\u0435\u043c\u0430\u0442\u0438\u0447\u043d\u0456 \u0441\u043b\u043e\u0432\u043d\u0438\u043a\u0438, \u0449\u043e\u0431 \u043f\u0456\u0434\u0432\u0438\u0449\u0438\u0442\u0438 \u0439\u043c\u043e\u0432\u0456\u0440\u043d\u0456\u0441\u0442\u044c \u043f\u0435\u0440\u0435\u043c\u043e\u0433\u0438?", "answer": "\u041a\u043b\u044e\u0447 \u0434\u043e \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0442\u0435\u043c\u0430\u0442\u0438\u0447\u043d\u0438\u0445 \u0441\u043b\u043e\u0432\u043d\u0438\u043a\u0456\u0432 \u043f\u043e\u043b\u044f\u0433\u0430\u0454 \u0443 \u0437\u0432\u0443\u0436\u0435\u043d\u043d\u0456 \u043a\u043e\u043b\u0430 \u043c\u043e\u0436\u043b\u0438\u0432\u0438\u0445 \u0432\u0430\u0440\u0456\u0430\u043d\u0442\u0456\u0432. \u042f\u043a\u0449\u043e \u0442\u0435\u043c\u0430 \u0433\u0440\u0438 \u2014 \"\u0422\u0432\u0430\u0440\u0438\u043d\u0438\", \u0442\u043e \u0432\u0430\u043c \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u0437\u043e\u0441\u0435\u0440\u0435\u0434\u0438\u0442\u0438\u0441\u044f \u043d\u0430 \u0441\u043b\u043e\u0432\u0430\u0445, \u0449\u043e \u0441\u0442\u043e\u0441\u0443\u044e\u0442\u044c\u0441\u044f \u0442\u0432\u0430\u0440\u0438\u043d. \u041f\u043e-\u043f\u0435\u0440\u0448\u0435, \u043f\u0440\u0438\u0433\u0430\u0434\u0430\u0439\u0442\u0435 \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u043e\u0432\u0456\u0434\u043e\u043c\u0456 \u043d\u0430\u0437\u0432\u0438 \u0442\u0432\u0430\u0440\u0438\u043d, \u0442\u0430\u043a\u0456 \u044f\u043a \"CAT\", \"DOG\", \"ELEPHANT\". \u041f\u043e-\u0434\u0440\u0443\u0433\u0435, \u043f\u043e\u0434\u0443\u043c\u0430\u0439\u0442\u0435 \u043f\u0440\u043e \u043f\u0435\u0432\u043d\u0456 \u0442\u0438\u043f\u0438 \u0442\u0432\u0430\u0440\u0438\u043d, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043f\u0442\u0430\u0445\u0456\u0432, \u0440\u0438\u0431, \u043a\u043e\u043c\u0430\u0445. \u041f\u043e-\u0442\u0440\u0435\u0442\u0454, \u044f\u043a\u0449\u043e \u0432\u0438 \u0434\u043e\u0431\u0440\u0435 \u0437\u043d\u0430\u0439\u043e\u043c\u0456 \u0437 \u043f\u0435\u0432\u043d\u043e\u044e \u0442\u0435\u043c\u043e\u044e, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0432\u0438 \u043b\u044e\u0431\u0438\u0442\u0435\u043b\u044c \u0442\u0432\u0430\u0440\u0438\u043d, \u0442\u043e \u043c\u043e\u0436\u0435\u0442\u0435 \u0440\u043e\u0437\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u0439 \u043c\u0435\u043d\u0448 \u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0456 \u043d\u0430\u0437\u0432\u0438 \u0442\u0432\u0430\u0440\u0438\u043d. \u0414\u0456\u0430\u0433\u0440\u0430\u043c\u0430 \u043f\u0440\u043e\u0446\u0435\u0441\u0443: [\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u043d\u0435 \u0437\u0430\u0432\u0434\u0430\u043d\u043d\u044f] -> [\u043f\u0440\u0438\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u043d\u044f \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u043e\u0432\u0456\u0434\u043e\u043c\u0438\u0445 \u0441\u043b\u0456\u0432] -> [\u0440\u043e\u0437\u0434\u0443\u043c\u0438 \u043f\u0440\u043e \u043f\u0435\u0432\u043d\u0456 \u0442\u0438\u043f\u0438] -> [\u0432\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0435\u0447\u0430\u0441\u0442\u043e \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u0454\u043c\u0438\u0445 \u0441\u043b\u0456\u0432]. \u0417\u0430\u0432\u0434\u044f\u043a\u0438 \u0446\u044c\u043e\u043c\u0443 \u043c\u0435\u0442\u043e\u0434\u0443 \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u043d\u0430\u0447\u043d\u043e \u043f\u0456\u0434\u0432\u0438\u0449\u0438\u0442\u0438 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c \u0432\u0430\u0448\u0438\u0445 \u0441\u043f\u0440\u043e\u0431."}, {"question": "\u042f\u043a \u0433\u0440\u0430\u0432\u0446\u0456 \u0432\u0438\u0441\u043e\u043a\u043e\u0433\u043e \u0440\u0456\u0432\u043d\u044f \u0432 \u0433\u0440\u0456 \u0432 \u0432\u0456\u0441\u0456\u043c\u043a\u0438 \u0430\u043d\u0430\u043b\u0456\u0437\u0443\u044e\u0442\u044c \u0447\u0430\u0441\u0442\u043e\u0442\u0443 \u0432\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u043d\u044f \u0431\u0443\u043a\u0432? \u0427\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0432\u0438 \u043f\u043e\u0434\u0456\u043b\u0438\u0442\u0438\u0441\u044f \u0434\u0435\u044f\u043a\u0438\u043c\u0438 \u0440\u043e\u0437\u0448\u0438\u0440\u0435\u043d\u0438\u043c\u0438 \u0441\u043f\u0438\u0441\u043a\u0430\u043c\u0438 \u043f\u0440\u0456\u043e\u0440\u0438\u0442\u0435\u0442\u0456\u0432 \u0431\u0443\u043a\u0432?", "answer": "\u0414\u043e\u0441\u0432\u0456\u0434\u0447\u0435\u043d\u0456 \u0433\u0440\u0430\u0432\u0446\u0456 \u043a\u043e\u0440\u0438\u0433\u0443\u044e\u0442\u044c \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u044e \u0432\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0456 \u0447\u0430\u0441\u0442\u043e\u0442\u0438 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0431\u0443\u043a\u0432. \u0425\u043e\u0447\u0430 '\u0415' \u0454 \u043d\u0430\u0439\u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0456\u0448\u043e\u044e \u043b\u0456\u0442\u0435\u0440\u043e\u044e, \u043f\u0440\u0456\u043e\u0440\u0438\u0442\u0435\u0442\u0438 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u0445 \u0431\u0443\u043a\u0432 \u043c\u043e\u0436\u0443\u0442\u044c \u0437\u043c\u0456\u043d\u044e\u0432\u0430\u0442\u0438\u0441\u044f \u0437\u0430\u043b\u0435\u0436\u043d\u043e \u0432\u0456\u0434 \u043a\u043e\u0440\u043f\u0443\u0441\u0443 \u0442\u0435\u043a\u0441\u0442\u0443. \u041e\u0434\u0438\u043d \u0456\u0437 \u043f\u043e\u0448\u0438\u0440\u0435\u043d\u0438\u0445 \u0441\u043f\u0438\u0441\u043a\u0456\u0432 \u043f\u0440\u0456\u043e\u0440\u0438\u0442\u0435\u0442\u0456\u0432 \u0431\u0443\u043a\u0432 \u2014 E-T-A-O-I-N-S-H-R-D-L-C-U-M-W-F-G-P-Y-B-V-K-X-Q-J-Z. \u0426\u0435\u0439 \u0441\u043f\u0438\u0441\u043e\u043a \u043c\u043e\u0436\u043d\u0430 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u044f\u043a \u0434\u043e\u0432\u0456\u0434\u043d\u0438\u043a, \u0430\u043b\u0435 \u043d\u0430\u0431\u0430\u0433\u0430\u0442\u043e \u0432\u0430\u0436\u043b\u0438\u0432\u0456\u0448\u0435 \u0430\u0434\u0430\u043f\u0442\u0443\u0432\u0430\u0442\u0438 \u0439\u043e\u0433\u043e \u0434\u043e \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e\u0457 \u0433\u0440\u0438. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u044f\u043a\u0449\u043e \u0432\u0438 \u0432\u0436\u0435 \u0432\u0433\u0430\u0434\u0430\u043b\u0438 'C', 'A', 'T', \u0442\u043e \u0439\u043c\u043e\u0432\u0456\u0440\u043d\u0456\u0441\u0442\u044c \u0432\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u043d\u044f 'H' \u0431\u0443\u0434\u0435 \u0431\u0456\u043b\u044c\u0448\u043e\u044e, \u043e\u0441\u043a\u0456\u043b\u044c\u043a\u0438 'CAT' \u0442\u0430 'H' \u0447\u0430\u0441\u0442\u043e \u0443\u0442\u0432\u043e\u0440\u044e\u044e\u0442\u044c \u0441\u043b\u043e\u0432\u043e 'CATCH'. \u0420\u0456\u0437\u043d\u0456 \u043f\u0456\u0434\u0445\u043e\u0434\u0438: [\u0442\u0440\u0430\u0434\u0438\u0446\u0456\u0439\u043d\u0430 \u0442\u0430\u0431\u043b\u0438\u0446\u044f \u0447\u0430\u0441\u0442\u043e\u0442|\u043a\u043e\u0440\u0435\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0447\u0430\u0441\u0442\u043e\u0442\u0438 \u0432 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0456|\u043e\u0441\u043e\u0431\u0438\u0441\u0442\u0438\u0439 \u0434\u043e\u0441\u0432\u0456\u0434]. \u0420\u0435\u0442\u0435\u043b\u044c\u043d\u043e \u0440\u043e\u0437\u0433\u043b\u044f\u0434\u0430\u044e\u0447\u0438 \u0446\u0456 \u0442\u0440\u0438 \u0444\u0430\u043a\u0442\u043e\u0440\u0438, \u043c\u043e\u0436\u043d\u0430 \u0440\u043e\u0437\u0440\u043e\u0431\u0438\u0442\u0438 \u0441\u0432\u043e\u044e \u043e\u043f\u0442\u0438\u043c\u0430\u043b\u044c\u043d\u0443 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u044e."}, {"question": "\u042f\u043a\u0438\u0439 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u0439 \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u0440\u043e\u0431\u043e\u0442\u0438 \u0433\u0440\u0438 \u0432 \u0432\u0456\u0441\u0456\u043c\u043a\u0438? \u042f\u043a \u043f\u0440\u0430\u0446\u044e\u0454 \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u0432\u0438\u0431\u043e\u0440\u0443 \u0441\u043b\u0456\u0432? \u0427\u0438 \u043c\u043e\u0436\u043b\u0438\u0432\u043e \u0437\u0430\u0437\u0434\u0430\u043b\u0435\u0433\u0456\u0434\u044c \u043f\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0438\u0442\u0438 \u0441\u043b\u043e\u0432\u043e, \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0432\u0430\u0432\u0448\u0438 \u0441\u0430\u043c \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c?", "answer": "\u041e\u0441\u043d\u043e\u0432\u043d\u0438\u0439 \u043f\u0440\u0438\u043d\u0446\u0438\u043f \u0433\u0440\u0438 \u0432 \u0432\u0456\u0441\u0456\u043c\u043a\u0438 \u0437\u0430\u043b\u0435\u0436\u0438\u0442\u044c \u0432\u0456\u0434 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e\u0457 \u0440\u0435\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u0457. \u0417\u0430\u0437\u0432\u0438\u0447\u0430\u0439, \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c \u0432\u0438\u0431\u043e\u0440\u0443 \u0441\u043b\u0456\u0432 \u043e\u0431\u0438\u0440\u0430\u0454 \u0432\u0438\u043f\u0430\u0434\u043a\u043e\u0432\u043e \u0441\u043b\u043e\u0432\u043e \u0437 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u044c\u043e \u0432\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043e\u0433\u043e \u0441\u043f\u0438\u0441\u043a\u0443 \u0441\u043b\u0456\u0432. \u041f\u0440\u043e\u0441\u0442\u0435 \u0432\u0442\u0456\u043b\u0435\u043d\u043d\u044f \u043c\u043e\u0436\u0435 \u0431\u0443\u0442\u0438 \u043f\u0440\u043e\u0441\u0442\u0438\u043c \u0433\u0435\u043d\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u043c \u0432\u0438\u043f\u0430\u0434\u043a\u043e\u0432\u0438\u0445 \u0447\u0438\u0441\u0435\u043b \u0434\u043b\u044f \u0432\u0438\u0431\u043e\u0440\u0443 \u0456\u043d\u0434\u0435\u043a\u0441\u0443 \u0437\u0456 \u0441\u043f\u0438\u0441\u043a\u0443. \u0411\u0456\u043b\u044c\u0448 \u0441\u043a\u043b\u0430\u0434\u043d\u0456 \u0440\u0435\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u0457 \u043c\u043e\u0436\u0443\u0442\u044c \u0432\u0440\u0430\u0445\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0434\u043e\u0432\u0436\u0438\u043d\u0443 \u0441\u043b\u043e\u0432\u0430, \u0440\u0456\u0432\u0435\u043d\u044c \u0441\u043a\u043b\u0430\u0434\u043d\u043e\u0441\u0442\u0456, \u0442\u0435\u043c\u0443 \u0442\u043e\u0449\u043e. \u0425\u043e\u0447\u0430, \u0442\u0435\u043e\u0440\u0435\u0442\u0438\u0447\u043d\u043e, \u043c\u043e\u0436\u043d\u0430 \u0441\u043f\u0440\u043e\u0431\u0443\u0432\u0430\u0442\u0438 \u043f\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0438\u0442\u0438 \u0441\u043b\u043e\u0432\u043e, \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0432\u0430\u0432\u0448\u0438 \u0441\u0430\u043c \u0430\u043b\u0433\u043e\u0440\u0438\u0442\u043c, \u0430\u043b\u0435 \u0446\u0435 \u043d\u0430\u0434\u0437\u0432\u0438\u0447\u0430\u0439\u043d\u043e \u0432\u0430\u0436\u043a\u043e, \u043e\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u0441\u043f\u0438\u0441\u043e\u043a \u0441\u043b\u0456\u0432 \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u0432\u0435\u043b\u0438\u043a\u0438\u0439, \u0430 \u0433\u0435\u043d\u0435\u0440\u0430\u0442\u043e\u0440 \u0432\u0438\u043f\u0430\u0434\u043a\u043e\u0432\u0438\u0445 \u0447\u0438\u0441\u0435\u043b, \u044f\u043a \u043f\u0440\u0430\u0432\u0438\u043b\u043e, \u0454 \u043f\u0441\u0435\u0432\u0434\u043e\u0432\u0438\u043f\u0430\u0434\u043a\u043e\u0432\u0438\u043c. \u0422\u043e\u043c\u0443, \u043a\u0440\u0430\u0449\u0435 \u0437\u043e\u0441\u0435\u0440\u0435\u0434\u0438\u0442\u0438\u0441\u044f \u043d\u0430 \u043f\u043e\u043b\u0456\u043f\u0448\u0435\u043d\u043d\u0456 \u043d\u0430\u0432\u0438\u0447\u043e\u043a \u0432\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u043d\u044f, \u0430 \u043d\u0435 \u043d\u0430 \u0441\u043f\u0440\u043e\u0431\u0430\u0445 \u043f\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0435\u043d\u043d\u044f \u0441\u043b\u0456\u0432."}, {"question": "\u042f\u043a \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u044e\u0454\u0442\u044c\u0441\u044f \u0440\u0456\u0432\u0435\u043d\u044c \u0441\u043a\u043b\u0430\u0434\u043d\u043e\u0441\u0442\u0456 \u0433\u0440\u0438 \u0432 \u0432\u0456\u0441\u0456\u043c\u043a\u0438? \u0427\u0438 \u0454 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u043e\u0446\u0456\u043d\u043a\u0438 \u0441\u043a\u043b\u0430\u0434\u043d\u043e\u0441\u0442\u0456, \u044f\u043a\u0430 \u043c\u043e\u0436\u0435 \u0431\u0443\u0442\u0438 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u0430 \u0434\u043b\u044f \u043e\u0446\u0456\u043d\u043a\u0438 \u0441\u043a\u043b\u0430\u0434\u043d\u043e\u0441\u0442\u0456 \u0440\u0456\u0437\u043d\u0438\u0445 \u0456\u0433\u043e\u0440 \u0443 \u0432\u0456\u0441\u0456\u043c\u043a\u0438?", "answer": "\u0420\u0456\u0432\u0435\u043d\u044c \u0441\u043a\u043b\u0430\u0434\u043d\u043e\u0441\u0442\u0456 \u0433\u0440\u0438 \u0432 \u0432\u0456\u0441\u0456\u043c\u043a\u0438 \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c\u0443 \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u0454\u0442\u044c\u0441\u044f \u0434\u043e\u0432\u0436\u0438\u043d\u043e\u044e, \u0441\u043a\u043b\u0430\u0434\u043d\u0456\u0441\u0442\u044e \u0442\u0430 \u0440\u0456\u0434\u043a\u0456\u0441\u043d\u0456\u0441\u0442\u044e \u0441\u043b\u0456\u0432. \u0417\u0430\u0433\u0430\u043b\u043e\u043c, \u0447\u0438\u043c \u0434\u043e\u0432\u0448\u0435, \u0441\u043a\u043b\u0430\u0434\u043d\u0456\u0448\u0435 \u0442\u0430 \u0440\u0456\u0434\u0448\u0435 \u0441\u043b\u043e\u0432\u043e, \u0442\u0438\u043c \u0432\u0438\u0449\u0430 \u0441\u043a\u043b\u0430\u0434\u043d\u0456\u0441\u0442\u044c. \u0414\u0435\u044f\u043a\u0456 \u0456\u0433\u0440\u0438 \u0432 \u0432\u0456\u0441\u0456\u043c\u043a\u0438 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u044e\u044e\u0442\u044c \u0440\u0456\u0432\u043d\u0456 \u0441\u043a\u043b\u0430\u0434\u043d\u043e\u0441\u0442\u0456 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0456 \u0441\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u0457 \u0434\u043e\u0432\u0436\u0438\u043d\u0438 \u0441\u043b\u0456\u0432 \u0430\u0431\u043e \u0447\u0438\u0441\u043b\u0430 \u0441\u043f\u0440\u043e\u0431 \u0432\u0433\u0430\u0434\u0443\u0432\u0430\u043d\u043d\u044f. \u0425\u043e\u0447\u0430 \u043d\u0435\u043c\u0430\u0454 \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u043e\u0457 \u0441\u0438\u0441\u0442\u0435\u043c\u0438 \u043e\u0446\u0456\u043d\u043a\u0438 \u0441\u043a\u043b\u0430\u0434\u043d\u043e\u0441\u0442\u0456, \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u043e\u0440\u0456\u0432\u043d\u044f\u0442\u0438 \u0440\u0456\u0437\u043d\u0456 \u0456\u0433\u0440\u0438 \u0437\u0430 \u0441\u043f\u0438\u0441\u043a\u043e\u043c \u0441\u043b\u0456\u0432 \u0442\u0430 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044e \u0441\u043f\u0440\u043e\u0431, \u0449\u043e\u0431 \u043e\u0446\u0456\u043d\u0438\u0442\u0438 \u0457\u0445 \u0441\u043a\u043b\u0430\u0434\u043d\u0456\u0441\u0442\u044c. \u041a\u0440\u0456\u043c \u0442\u043e\u0433\u043e, \u0432 \u0434\u0435\u044f\u043a\u0438\u0445 \u0456\u0433\u0440\u0430\u0445 \u043f\u0440\u0438\u0441\u0443\u0442\u043d\u0456\u0439 \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u043d\u044f \u0442\u0435\u043c, \u044f\u043a\u0456 \u0442\u0430\u043a\u043e\u0436 \u0432\u043f\u043b\u0438\u0432\u0430\u044e\u0442\u044c \u043d\u0430 \u0441\u043a\u043b\u0430\u0434\u043d\u0456\u0441\u0442\u044c. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0433\u0440\u0430 \u0432 \u0432\u0456\u0441\u0456\u043c\u043a\u0438, \u0449\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454 \u043b\u0438\u0448\u0435 \u0441\u043f\u0435\u0446\u0456\u0430\u043b\u044c\u043d\u0443 \u0442\u0435\u0440\u043c\u0456\u043d\u043e\u043b\u043e\u0433\u0456\u044e, \u0431\u0443\u0434\u0435 \u0441\u043a\u043b\u0430\u0434\u043d\u0456\u0448\u043e\u044e. \u0410\u043d\u0430\u043b\u043e\u0433\u0456\u044f: \u0420\u0435\u0433\u0443\u043b\u044e\u0432\u0430\u043d\u043d\u044f \u0441\u043a\u043b\u0430\u0434\u043d\u043e\u0441\u0442\u0456 \u2014 \u0446\u0435 \u044f\u043a \u0440\u0435\u0433\u0443\u043b\u044e\u0432\u0430\u043d\u043d\u044f \u0456\u043d\u0433\u0440\u0435\u0434\u0456\u0454\u043d\u0442\u0456\u0432 \u0442\u0430 \u0432\u043e\u0433\u043d\u044e \u043f\u0456\u0434 \u0447\u0430\u0441 \u043f\u0440\u0438\u0433\u043e\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0457\u0436\u0456, \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u0432\u0438\u0431\u0438\u0440\u0430\u0442\u0438 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u0443 \"\u0440\u0435\u0446\u0435\u043f\u0442\u0443\u0440\u0443\" \u0434\u043b\u044f \u0440\u0456\u0437\u043d\u0438\u0445 \"\u0441\u0442\u0440\u0430\u0432\"."}, {"question": "\u0427\u0438 \u043c\u043e\u0436\u043d\u0430 \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u043f\u0440\u043e\u0433\u0440\u0435\u0441 \u0443 \u0433\u0440\u0456 \u0432 \u0432\u0456\u0441\u0456\u043c\u043a\u0438 \u043d\u0430 \u0440\u0456\u0437\u043d\u0438\u0445 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044f\u0445? \u0427\u0438 \u0456\u0441\u043d\u0443\u0454 \u0440\u0456\u0448\u0435\u043d\u043d\u044f \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0435\u043d\u043d\u044f \u0434\u0430\u043d\u0438\u0445 \u043c\u0456\u0436 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430\u043c\u0438? \u042f\u043a\u0449\u043e \u043d\u0456, \u0442\u043e \u044f\u043a\u0456 \u0430\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u043d\u0456 \u0441\u043f\u043e\u0441\u043e\u0431\u0438 \u0456\u0441\u043d\u0443\u044e\u0442\u044c \u0434\u043b\u044f \u0437\u0430\u043f\u0438\u0441\u0443 \u043c\u043e\u0457\u0445 \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u044c?", "answer": "\u0427\u0438 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454 \u0433\u0440\u0430 \u0432 \u0432\u0456\u0441\u0456\u043c\u043a\u0438 \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0456\u0437\u0430\u0446\u0456\u044e \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0443 \u0442\u0430 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0435\u043d\u043d\u044f \u0434\u0430\u043d\u0438\u0445 \u043c\u0456\u0436 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430\u043c\u0438, \u0437\u0430\u043b\u0435\u0436\u0438\u0442\u044c \u0432\u0456\u0434 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e\u0457 \u0440\u0435\u0430\u043b\u0456\u0437\u0430\u0446\u0456\u0457 \u0433\u0440\u0438. \u0414\u0435\u044f\u043a\u0456 \u043e\u043d\u043b\u0430\u0439\u043d-\u0456\u0433\u0440\u0438 \u0432 \u0432\u0456\u0441\u0456\u043c\u043a\u0438 \u043c\u043e\u0436\u0443\u0442\u044c \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0445\u043c\u0430\u0440\u043d\u0435 \u0441\u0445\u043e\u0432\u0438\u0449\u0435 \u0434\u043b\u044f \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0456\u0437\u0430\u0446\u0456\u0457 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0443 \u0433\u0440\u0438. \u042f\u043a\u0449\u043e \u043d\u0435\u043c\u0430\u0454 \u043e\u0444\u0456\u0446\u0456\u0439\u043d\u043e\u0433\u043e \u0440\u0456\u0448\u0435\u043d\u043d\u044f \u0434\u043b\u044f \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0456\u0437\u0430\u0446\u0456\u0457, \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0432\u0440\u0443\u0447\u043d\u0443 \u0437\u0430\u043f\u0438\u0441\u0443\u0432\u0430\u0442\u0438 \u0441\u0432\u043e\u0457 \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u0432\u0433\u0430\u0434\u0430\u043d\u0438\u0445 \u0441\u043b\u0456\u0432, \u0432\u0438\u0442\u0440\u0430\u0447\u0435\u043d\u0438\u0439 \u0447\u0430\u0441 \u0442\u043e\u0449\u043e. \u0410\u043b\u044c\u0442\u0435\u0440\u043d\u0430\u0442\u0438\u0432\u043d\u0456 \u0432\u0430\u0440\u0456\u0430\u043d\u0442\u0438: \u0444\u043e\u0442\u043e, \u0437\u0430\u043f\u0438\u0441\u0438, \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u0441\u0442\u043e\u0440\u043e\u043d\u043d\u0456\u0445 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432 \u0434\u043b\u044f \u0443\u043f\u0440\u0430\u0432\u043b\u0456\u043d\u043d\u044f \u0434\u0430\u043d\u0438\u043c\u0438."}, {"question": "\u0427\u0438 \u0454 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0456 \u044f\u0439\u0446\u044f \u0432 \u0433\u0440\u0456 \u0432 \u0432\u0456\u0441\u0456\u043c\u043a\u0438? \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0447\u0438 \u0454 \u043f\u0435\u0432\u043d\u0456 \u0441\u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043d\u044f \u0441\u043b\u0456\u0432, \u044f\u043a\u0456 \u043c\u043e\u0436\u0443\u0442\u044c \u0441\u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u0441\u043f\u0435\u0446\u0456\u0430\u043b\u044c\u043d\u0456 \u0430\u043d\u0456\u043c\u0430\u0446\u0456\u0457 \u0447\u0438 \u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0438? \u0414\u0435 \u043c\u043e\u0436\u043d\u0430 \u0437\u043d\u0430\u0439\u0442\u0438 \u0446\u0456 \"\u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456\" \u0432\u0430\u0440\u0456\u0430\u043d\u0442\u0438?", "answer": "\u041d\u0430\u044f\u0432\u043d\u0456\u0441\u0442\u044c \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0438\u0445 \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0438\u0445 \u044f\u0454\u0446\u044c \u0443 \u0433\u0440\u0456 \u0432 \u0432\u0456\u0441\u0456\u043c\u043a\u0438 \u0437\u0430\u043b\u0435\u0436\u0438\u0442\u044c \u0432\u0456\u0434 \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0430. \u0414\u0435\u044f\u043a\u0456 \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0438 \u043c\u043e\u0436\u0443\u0442\u044c \u0434\u043e\u0434\u0430\u0442\u0438 \u0446\u0456\u043a\u0430\u0432\u0456 \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0456 \u044f\u0439\u0446\u044f, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u044f\u043a\u0449\u043e \u0433\u0440\u0430\u0432\u0435\u0446\u044c \u0432\u0433\u0430\u0434\u0443\u0454 \u043f\u0435\u0432\u043d\u0435 \u0441\u043b\u043e\u0432\u043e, \u0442\u043e \u043c\u043e\u0436\u0435 \u0441\u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u0441\u043f\u0435\u0446\u0456\u0430\u043b\u044c\u043d\u0430 \u0430\u043d\u0456\u043c\u0430\u0446\u0456\u044f \u0430\u0431\u043e \u043d\u0430\u0433\u043e\u0440\u043e\u0434\u0430. \u0428\u043b\u044f\u0445\u0438 \u043f\u043e\u0448\u0443\u043a\u0443 \u0446\u0438\u0445 \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0438\u0445 \u044f\u0454\u0446\u044c \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442\u044c \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434 \u0444\u043e\u0440\u0443\u043c\u0456\u0432 \u0456\u0433\u043e\u0440, \u0447\u0438\u0442\u0430\u043d\u043d\u044f \u0433\u0430\u0439\u0434\u0456\u0432 \u0434\u043e \u0433\u0440\u0438, \u043e\u0431\u043c\u0456\u043d \u0434\u043e\u0441\u0432\u0456\u0434\u043e\u043c \u0437 \u0456\u043d\u0448\u0438\u043c\u0438 \u0433\u0440\u0430\u0432\u0446\u044f\u043c\u0438. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0443 \u0434\u0435\u044f\u043a\u0438\u0445 \u0432\u0435\u0440\u0441\u0456\u044f\u0445 \u0433\u0440\u0438 \u0432 \u0432\u0456\u0441\u0456\u043c\u043a\u0438, \u0437\u0430\u0433\u0430\u0434\u0443\u044e\u0447\u0438 \u0441\u043b\u043e\u0432\u043e \"EPIC\", \u043c\u043e\u0436\u0435 \u0441\u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u0441\u043f\u0435\u0446\u0456\u0430\u043b\u044c\u043d\u0430 \u0430\u043d\u0456\u043c\u0430\u0446\u0456\u044f. \u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u043f\u043e\u0448\u0443\u043a \u0443 Google \u0437\u0430 \u0437\u0430\u043f\u0438\u0442\u043e\u043c \"Hangman [\u043d\u0430\u0437\u0432\u0430 \u0433\u0440\u0438] \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0456 \u044f\u0439\u0446\u044f\", \u0449\u043e\u0431 \u0437\u043d\u0430\u0439\u0442\u0438 \u043f\u0456\u0434\u043a\u0430\u0437\u043a\u0438."}]
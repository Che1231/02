[{"question": "\ud589\ub9e8 \uac8c\uc784\uc740 \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud558\uba70, \ucd08\uc2ec\uc790\ub77c\uba74 \ucc98\uc74c\uc5d0 \uc5b4\ub5a4 \ubb38\uc790\ub97c \ucd94\uce21\ud574\uc57c \ud560\uae4c\uc694?", "answer": "\ud589\ub9e8 \uac8c\uc784\uc740 \uc2dc\uc791\ud558\uae30\uac00 \ub9e4\uc6b0 \uac04\ub2e8\ud569\ub2c8\ub2e4. \uac8c\uc784\uc744 \uc2dc\uc791\ud558\uba74 \uc2dc\uc2a4\ud15c\uc774 \ubb34\uc791\uc704\ub85c \ub2e8\uc5b4\ub97c \uc120\ud0dd\ud558\uace0, \ud50c\ub808\uc774\uc5b4\ub294 \ubb38\uc790\ub97c \ucd94\uce21\ud558\uae30 \uc2dc\uc791\ud569\ub2c8\ub2e4. \ucd08\uc2ec\uc790\ub77c\uba74 \uc601\uc5b4 \ub2e8\uc5b4\uc5d0\uc11c \uc790\uc8fc \ub4f1\uc7a5\ud558\ub294 \ubaa8\uc74c \ubb38\uc790('E', 'A', 'I')\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \ucd94\uce21\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. \uc774\ub294 \ubb38\uc790\ub97c \ub9de\ud790 \ud655\ub960\uc744 \ub192\uc5ec\uc90d\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucc98\uc74c\uc5d0 'E'\ub97c \ucd94\uce21\ud588\ub294\ub370 \ub2e8\uc5b4\uc5d0 'E'\uac00 \uc5c6\ub2e4\uba74 'A'\ub97c \ucd94\uce21\ud574 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub807\uac8c \uac00\ub2a5\uc131\uc744 \uc810\ucc28 \uc904\uc5ec\ub098\uac00\ub294 \uacfc\uc815\uc785\ub2c8\ub2e4."}, {"question": "\ud589\ub9e8 \uac8c\uc784\uc5d0\uc11c \ubb38\uc790\ub97c \ud2c0\ub9ac\uba74 \uc5b4\ub5a4 \ucc98\ubc8c\uc774 \uc788\ub098\uc694? \ucc98\ubc8c\uc740 \uac8c\uc784 \uc804\ub7b5\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ud589\ub9e8 \uac8c\uc784\uc5d0\uc11c \ubb38\uc790\ub97c \ud2c0\ub9ac\uba74 \uad50\uc218\ub300\uac00 \uc810\uc810 \uc644\uc131\ub429\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc73c\ub85c \uac8c\uc784\uc5d0\ub294 \uc81c\ud55c\ub41c \ud2c0\ub9b0 \ud69f\uc218(\ubcf4\ud1b5 6\ud68c)\uac00 \uc8fc\uc5b4\uc9d1\ub2c8\ub2e4. \ub9e4\ubc88 \ud2c0\ub9b4 \ub54c\ub9c8\ub2e4 \uad50\uc218\ub300\uac00 \uc870\uae08\uc529 \uc644\uc131\ub418\uace0, \uad50\uc218\ub300\uac00 \uc644\uc804\ud788 \uadf8\ub824\uc9c0\uba74 \uac8c\uc784\uc5d0\uc11c \ud328\ubc30\ud569\ub2c8\ub2e4. \ub530\ub77c\uc11c \ucc98\ubc8c\uc740 \uac8c\uc784 \uc804\ub7b5\uc5d0 \ud070 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\ub294 \uc2e0\uc911\ud558\uac8c \ubb38\uc790\ub97c \ucd94\uce21\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uae30\ud68c\uac00 2\ubc88 \ub0a8\uc558\ub2e4\uba74 \ud655\uc2e4\ud558\uac8c \ub9de\ud790 \uc218 \uc788\ub294 \ubb38\uc790\ub098 \uc774\ubbf8 \uc54c\uace0 \uc788\ub294 \ubb38\uc790 \uc870\ud569\uc73c\ub85c \uac00\ub2a5\ud55c \ub2e8\uc5b4\ub97c \ucd94\uce21\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4."}, {"question": "\ud589\ub9e8 \uac8c\uc784\uc5d0\uc11c \u2018\uad50\uc218\ud615\u2019\uc744 \ud53c\ud558\ub294 \ucd5c\uc0c1\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694? \ubaa8\ub4e0 \uae38\uc774\uc758 \ub2e8\uc5b4\uc5d0 \uc801\uc6a9\ud560 \uc218 \uc788\ub294 \uc77c\ubc18\uc801\uc778 \ubc29\ubc95\uc774 \uc788\ub098\uc694?", "answer": "\u2018\uad50\uc218\ud615\u2019\uc744 \ud53c\ud558\uae30 \uc704\ud574\uc11c\ub294 \ubb38\uc790 \ucd94\uce21\uc758 \uc815\ud655\ub3c4\ub97c \ub192\uc5ec\uc57c \ud569\ub2c8\ub2e4. STEP1: \ud754\ud55c \ubaa8\uc74c \ubb38\uc790(E, A, I, O, U)\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \ucd94\uce21\ud569\ub2c8\ub2e4. STEP2: \uc774\ubbf8 \ub9de\ud78c \ubb38\uc790 \uc870\ud569\uc744 \uad00\ucc30\ud558\uace0, \ud754\ud55c \ubb38\uc790 \uc870\ud569(\uc608: 'TH', 'ST', 'ING')\uc744 \uc2dc\ub3c4\ud569\ub2c8\ub2e4. STEP3: \ub2e8\uc5b4\uc758 \uae38\uc774\uc640 \uc54c\uace0 \uc788\ub294 \ubb38\uc790\ub97c \ubc14\ud0d5\uc73c\ub85c \ub2e8\uc5b4\uc758 \ubc94\uc704\ub97c \uc881\ud799\ub2c8\ub2e4. \ubaa8\ub4e0 \uacbd\uc6b0\uc5d0 \uc801\uc6a9\ud560 \uc218 \uc788\ub294 \uc77c\ubc18\uc801\uc778 \ubc29\ubc95\uc740 \uc5c6\uc9c0\ub9cc, \uc5f0\uc2b5\uc744 \ud1b5\ud574 \uacbd\ud5d8\uc744 \uc313\uace0 \uaddc\uce59\uc744 \ud30c\uc545\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub2e8\uc5b4\uac00 \uc9e7\ub2e4\uba74(3~4\uac1c\uc758 \ubb38\uc790) \ud754\ud788 \uc0ac\uc6a9\ub418\ub294 \ub2e8\uc5b4\uc77c \uac00\ub2a5\uc131\uc774 \ub192\uc2b5\ub2c8\ub2e4. \ub2e8\uc5b4\uac00 \uae38\ub2e4\uba74 \uc804\ubb38 \uc6a9\uc5b4\ub098 \ud569\uc131\uc5b4\uc77c \uac00\ub2a5\uc131\uc774 \ub192\uc2b5\ub2c8\ub2e4. \ube44\uc720\uc801\uc73c\ub85c \ub9d0\ud558\uc790\uba74, \ud589\ub9e8 \uac8c\uc784\uc740 \uc554\ud638 \ud574\ub3c5 \uac8c\uc784\uacfc \uac19\uc73c\uba70, \ub9de\ud78c \ubb38\uc790\ub294 \ubbf8\uc2a4\ud130\ub9ac\ub97c \ud480\uc5b4\uac00\ub294 \ub2e8\uc11c\uac00 \ub429\ub2c8\ub2e4."}, {"question": "\ud589\ub9e8 \uac8c\uc784\uc5d0\uc11c \uc54c\uace0 \uc788\ub294 \ubb38\uc790\ub97c \ubc14\ud0d5\uc73c\ub85c \uac00\ub2a5\ud55c \ub2e8\uc5b4\ub97c \ucd94\uce21\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694? \ud65c\uc6a9\ud560 \uc218 \uc788\ub294 \uba87 \uac00\uc9c0 \ud301\uc774 \uc788\ub098\uc694?", "answer": "\uc54c\uace0 \uc788\ub294 \ubb38\uc790\ub97c \ubc14\ud0d5\uc73c\ub85c \uac00\ub2a5\ud55c \ub2e8\uc5b4\ub97c \ucd94\uce21\ud558\ub824\uba74 \uba87 \uac00\uc9c0 \ud301\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uccab\uc9f8, \ubb38\uc790\uc758 \uc704\uce58\ub97c \uace0\ub824\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub2e8\uc5b4 \uc911\uac04\uc5d0 '-A-'\uac00 \uc788\ub2e4\uba74 'BATH', 'PATH', 'MATH' \ub4f1\uc774 \uac00\ub2a5\ud55c \ub2e8\uc5b4\uc785\ub2c8\ub2e4. \ub458\uc9f8, \ub2e8\uc5b4\uc758 \ud488\uc0ac\ub97c \uace0\ub824\ud569\ub2c8\ub2e4. \ubb38\uc7a5\uc5d0\uc11c \ud544\uc694\ud55c \uac83\uc774 \uba85\uc0ac\ub77c\uba74 \ub3d9\uc0ac\ub294 \ubc30\uc81c\ud569\ub2c8\ub2e4. \uc14b\uc9f8, \uc0ac\uc804 \ub610\ub294 \uc628\ub77c\uc778 \ub9ac\uc18c\uc2a4\ub97c \ud65c\uc6a9\ud569\ub2c8\ub2e4. \ub9ce\uc740 \uc628\ub77c\uc778 \uc0ac\uc804\uc740 \uc54c\uace0 \uc788\ub294 \ubb38\uc790\ub97c \ubc14\ud0d5\uc73c\ub85c \ubaa8\ud638\ud55c \uac80\uc0c9\uc744 \ud5c8\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, Cambridge \uc0ac\uc804\uc5d0\uc11c 'b?t?'\ub97c \uc785\ub825\ud558\uba74 'BATH', 'BAT' \ub4f1\uc758 \ud6c4\ubcf4 \ub2e8\uc5b4\ub97c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ucc38\uace0\uc790\ub8cc\ub85c [\ub2e8\uc5b4 \uae38\uc774 | \ud754\ud55c \ud488\uc0ac] \ud14c\uc774\ube14\uc744 \ud65c\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \ud14c\uc774\ube14\uc740 \ucd94\uce21 \uacfc\uc815\uc744 \ubcf4\uc644\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud589\ub9e8 \uac8c\uc784\uc5d0\uc11c \ub3d9\ubb3c, \uc2dd\ubb3c, \uc5ed\uc0ac \uc778\ubb3c \ub4f1\uc758 \uc8fc\uc81c \ub2e8\uc5b4 \ubaa9\ub85d\uc744 \uc81c\uacf5\ud558\ub294 \uc6f9\uc0ac\uc774\ud2b8\ub098 \uc571\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc8fc\uc81c \ub2e8\uc5b4 \ubaa9\ub85d\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\uc5ec \uc2b9\ub960\uc744 \ub192\uc774\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc8fc\uc81c \ub2e8\uc5b4 \ubaa9\ub85d\uc744 \ud65c\uc6a9\ud558\ub294 \ud575\uc2ec\uc740 \ucd94\uce21 \ubc94\uc704\ub97c \uc881\ud788\ub294 \uac83\uc785\ub2c8\ub2e4. \ub9cc\uc57d \uac8c\uc784\uc758 \uc8fc\uc81c\uac00 \u201c\ub3d9\ubb3c\u201d\uc774\ub77c\uba74 \ub3d9\ubb3c\uacfc \uad00\ub828\ub41c \ub2e8\uc5b4\ub97c \uc911\uc2ec\uc73c\ub85c \ucd94\uce21\ud574\uc57c \ud569\ub2c8\ub2e4. \uba3c\uc800 \ud754\ud55c \ub3d9\ubb3c \uc774\ub984(\uc608: \u201cCAT\u201d, \u201cDOG\u201d, \u201cELEPHANT\u201d)\uc744 \uc0dd\uac01\ud574 \ubd05\ub2c8\ub2e4. \ub2e4\uc74c\uc73c\ub85c \ud2b9\uc815 \uc720\ud615\uc758 \ub3d9\ubb3c(\uc608: \uc870\ub958, \uc5b4\ub958, \uace4\ucda9)\uc744 \uace0\ub824\ud569\ub2c8\ub2e4. \ub9c8\uc9c0\ub9c9\uc73c\ub85c, \ud574\ub2f9 \uc8fc\uc81c\uc5d0 \ub300\ud574 \uc798 \uc544\ub294 \uacbd\uc6b0(\uc608: \ub3d9\ubb3c \uc560\ud638\uac00\uc778 \uacbd\uc6b0) \ub35c \ud754\ud55c \ub3d9\ubb3c \uc774\ub984\uc744 \uc0dd\uac01\ud574 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud750\ub984\ub3c4: [\uc8fc\uc81c \ud45c\uc2dc] -> [\ud754\ud55c \ub2e8\uc5b4 \uae30\uc5b5] -> [\ud2b9\uc815 \uc720\ud615 \uace0\ub824] -> [\ub35c \ud754\ud55c \ub2e8\uc5b4 \ucd94\uce21] \uc774\ub7ec\ud55c \ubc29\uc2dd\uc73c\ub85c \ucd94\uce21 \ud6a8\uc728\uc744 \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud589\ub9e8 \uac8c\uc784\uc758 \uace0\uc218\ub4e4\uc740 \ubb38\uc790 \ucd94\uce21 \ube48\ub3c4\ub97c \uc5b4\ub5bb\uac8c \ubd84\uc11d\ud558\ub098\uc694? \uace0\uae09 \ubb38\uc790 \uc6b0\uc120\uc21c\uc704 \ubaa9\ub85d\uc744 \uacf5\uc720\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uace0\uc218\ub4e4\uc740 \ubb38\uc790 \uc0ac\uc6a9 \ube48\ub3c4\uc5d0 \ub530\ub77c \ucd94\uce21 \uc804\ub7b5\uc744 \uc870\uc815\ud569\ub2c8\ub2e4. \u2018E\u2019\uac00 \uac00\uc7a5 \ud754\ud55c \ubb38\uc790\uc774\uae30\ub294 \ud558\uc9c0\ub9cc, \uadf8 \ub2e4\uc74c \ubb38\uc790 \uc6b0\uc120\uc21c\uc704\ub294 \uc0ac\uc6a9\ub418\ub294 \ubb38\uccb4\ub098 \ub370\uc774\ud130\ubca0\uc774\uc2a4\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc778 \uc6b0\uc120\uc21c\uc704 \ubaa9\ub85d\uc740 E-T-A-O-I-N-S-H-R-D-L-C-U-M-W-F-G-P-Y-B-V-K-X-Q-J-Z\uc785\ub2c8\ub2e4. \uc774 \ubaa9\ub85d\uc740 \ucc38\uace0\uac00 \ub420 \uc218 \uc788\uc9c0\ub9cc, \uac8c\uc784 \uc0c1\ud669\uc5d0 \ub530\ub77c \uc870\uc815\ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc774\ubbf8 \u2018C\u2019, \u2018A\u2019, \u2018T\u2019 \uc138 \ubb38\uc790\ub97c \ub9de\ud614\ub2e4\uba74, \ub2e4\uc74c \ubb38\uc790\ub85c \u2018H\u2019\ub97c \ucd94\uce21\ud560 \uac00\ub2a5\uc131\uc774 \ub192\uc2b5\ub2c8\ub2e4. \u2018CAT\u2019\uc5d0 \u2018H\u2019\ub97c \ub354\ud558\uba74 \u2018CATCH\u2019\uac00 \ub420 \uc218 \uc788\uc73c\ubbc0\ub85c. \uc5ec\ub7ec \uc804\ub7b5 \ube44\uad50: [\uae30\uc874 \ube48\ub3c4\ud45c | \ub9e5\ub77d\uc5d0 \ub530\ub978 \ube48\ub3c4 \uc870\uc815 | \uac1c\uc778 \uacbd\ud5d8] \uc774 \uc138 \uac00\uc9c0\ub97c \uc885\ud569\ud558\uc5ec \uc790\uc2e0\uc5d0\uac8c \ub9de\ub294 \ucd94\uce21 \uc804\ub7b5\uc744 \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud589\ub9e8 \uac8c\uc784\uc758 \uae30\ubcf8 \uc6d0\ub9ac\ub294 \ubb34\uc5c7\uc778\uac00\uc694? \ub2e8\uc5b4 \uc120\ud0dd \uc54c\uace0\ub9ac\uc998\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694? \uc54c\uace0\ub9ac\uc998\uc744 \ubd84\uc11d\ud558\uc5ec \ubbf8\ub9ac \ub2e8\uc5b4\ub97c \uc608\uce21\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud589\ub9e8 \uac8c\uc784\uc758 \uae30\ubcf8 \uc6d0\ub9ac\ub294 \uad6c\uccb4\uc801\uc778 \uad6c\ud604\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc73c\ub85c \ub2e8\uc5b4 \uc120\ud0dd \uc54c\uace0\ub9ac\uc998\uc740 \ubbf8\ub9ac \uc815\ud574\uc9c4 \ub2e8\uc5b4 \ubaa9\ub85d\uc5d0\uc11c \ubb34\uc791\uc704\ub85c \ub2e8\uc5b4\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. \uac04\ub2e8\ud55c \uad6c\ud604\uc740 \ub2e8\uc21c\ud788 \ub79c\ub364 \uc22b\uc790 \uc0dd\uc131\uae30\ub97c \uc0ac\uc6a9\ud558\uc5ec \ubaa9\ub85d\uc758 \uc778\ub371\uc2a4\ub97c \uc120\ud0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub354 \ubcf5\uc7a1\ud55c \uad6c\ud604\uc740 \ub2e8\uc5b4 \uae38\uc774, \ub09c\uc774\ub3c4, \uc8fc\uc81c \ub4f1\uc744 \uace0\ub824\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub860\uc801\uc73c\ub85c \uc54c\uace0\ub9ac\uc998\uc744 \ubd84\uc11d\ud558\uc5ec \ub2e8\uc5b4\ub97c \uc608\uce21\ud560 \uc218 \uc788\uc9c0\ub9cc, \uc2e4\uc81c\ub85c\ub294 \ub9e4\uc6b0 \uc5b4\ub835\uc2b5\ub2c8\ub2e4. \ub2e8\uc5b4 \ubaa9\ub85d\uc774 \uc77c\ubc18\uc801\uc73c\ub85c \ud06c\uace0, \ub79c\ub364 \uc22b\uc790 \uc0dd\uc131\uae30\ub294 \ud754\ud788 \uc758\uc0ac \ub79c\ub364\uc774\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \ub530\ub77c\uc11c \ub2e8\uc5b4\ub97c \uc608\uce21\ud558\ub824\uace0 \ud558\uae30\ubcf4\ub2e4\ub294 \ucd94\uce21 \uae30\uc220\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ub370 \uc9d1\uc911\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4."}, {"question": "\ud589\ub9e8 \uac8c\uc784\uc758 \ub09c\uc774\ub3c4\ub294 \uc5b4\ub5bb\uac8c \uc124\uc815\ub418\ub098\uc694? \ub2e4\uc591\ud55c \ud589\ub9e8 \uac8c\uc784\uc758 \ub09c\uc774\ub3c4\ub97c \ud3c9\uac00\ud558\uae30 \uc704\ud55c \uc77c\ubc18\uc801\uc778 \uae30\uc900\uc774 \uc788\ub098\uc694?", "answer": "\ud589\ub9e8 \uac8c\uc784\uc758 \ub09c\uc774\ub3c4\ub294 \uc8fc\ub85c \ub2e8\uc5b4\uc758 \uae38\uc774, \ubcf5\uc7a1\uc131, \ub4dc\ubb38 \uc815\ub3c4\uc5d0 \ub530\ub77c \uacb0\uc815\ub429\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc73c\ub85c \ub2e8\uc5b4\uac00 \uae38\uace0, \ubcf5\uc7a1\ud558\uace0, \ub4dc\ubb3c\uba74 \ub09c\uc774\ub3c4\uac00 \ub192\uc2b5\ub2c8\ub2e4. \uc77c\ubd80 \ud589\ub9e8 \uac8c\uc784\uc740 \ub2e8\uc5b4\uc758 \ud3c9\uade0 \uae38\uc774 \ub610\ub294 \ucd94\uce21 \ud69f\uc218\uc5d0 \ub530\ub77c \ub09c\uc774\ub3c4 \ub808\ubca8\uc744 \uc124\uc815\ud569\ub2c8\ub2e4. \uc77c\ubc18\uc801\uc778 \ub09c\uc774\ub3c4 \ud3c9\uac00 \uae30\uc900\uc740 \uc5c6\uc9c0\ub9cc, \ub2e4\uc591\ud55c \uac8c\uc784\uc758 \ub2e8\uc5b4 \ubaa9\ub85d\uacfc \ucd94\uce21 \ud69f\uc218\ub97c \ube44\uad50\ud558\uc5ec \ub09c\uc774\ub3c4\ub97c \ud3c9\uac00\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \ud2b9\uc815 \uc8fc\uc81c\uc5d0 \uc81c\ud55c\uc744 \ub450\ub294 \uac83(\uc608: \uc804\ubb38 \uc6a9\uc5b4\ub9cc \uc0ac\uc6a9\ud558\ub294 \ud589\ub9e8)\ub3c4 \ub09c\uc774\ub3c4\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ube44\uc720\uc801\uc73c\ub85c \ub09c\uc774\ub3c4 \uc870\uc808\uc740 \uc694\ub9ac\ud560 \ub54c \uc7ac\ub8cc\uc640 \ubd88\uc758 \uc138\uae30\ub97c \uc870\uc808\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uac01 \uac8c\uc784\uc5d0 \ub9de\ub294 \uc870\ub9ac\ubc95\uc744 \uc120\ud0dd\ud574\uc57c \ud569\ub2c8\ub2e4."}, {"question": "\ub2e4\ub978 \uae30\uae30\uc5d0\uc11c \ud589\ub9e8 \uac8c\uc784\uc744 \uc990\uae38 \ub54c \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc774 \ub3d9\uae30\ud654\ub420 \uc218 \uc788\ub098\uc694? \ud50c\ub7ab\ud3fc \uac04 \ub370\uc774\ud130 \uc774\uc804 \ubc29\uc548\uc774 \uc788\ub098\uc694? \uc5c6\ub2e4\uba74 \uac8c\uc784 \uc131\uacfc\ub97c \uae30\ub85d\ud560 \ub300\uc548\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud589\ub9e8 \uac8c\uc784\uc5d0\uc11c \ud50c\ub7ab\ud3fc \uac04 \ub3d9\uae30\ud654\uc640 \ub370\uc774\ud130 \uc774\uc804 \uc5ec\ubd80\ub294 \uad6c\uccb4\uc801\uc778 \uac8c\uc784 \uad6c\ud604\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. \uc77c\ubd80 \uc628\ub77c\uc778 \ud589\ub9e8 \uac8c\uc784\uc740 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc18c\ub97c \uc0ac\uc6a9\ud558\uc5ec \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uacf5\uc2dd\uc801\uc778 \ub3d9\uae30\ud654 \ubc29\uc548\uc774 \uc5c6\ub2e4\uba74 \uac8c\uc784 \uc131\uacfc\ub97c \uc218\ub3d9\uc73c\ub85c \uae30\ub85d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub9de\ud78c \ub2e8\uc5b4 \uc218, \uc18c\uc694 \uc2dc\uac04 \ub4f1\uc744 \uae30\ub85d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub300\uc548\uc73c\ub85c \uc2a4\ud06c\ub9b0 \uc0f7, \uae30\ub85d, \uc81c3\uc790 \ub370\uc774\ud130 \uad00\ub9ac \ub3c4\uad6c \ub4f1\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc131\uacfc\ub97c \uae30\ub85d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud5a5\ud6c4 \ud074\ub77c\uc6b0\ub4dc \uc11c\ubc84\ub97c \ud1b5\ud55c \ub3d9\uae30\ud654 \ubc29\uc548\uc744 \uace0\ub824\ud574 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud589\ub9e8 \uac8c\uc784\uc5d0 \uc228\uaca8\uc9c4 \uc7ac\ubbf8\uc788\ub294 \uc694\uc18c(\uc608: \ud2b9\uc815 \ub2e8\uc5b4 \uc870\ud569\uc774 \ud2b9\ubcc4\ud55c \uc560\ub2c8\uba54\uc774\uc158\uc774\ub098 \ubcf4\uc0c1\uc744 \uc720\ubc1c\ud558\ub294 \uacbd\uc6b0)\uac00 \uc788\ub098\uc694? \uc5b4\ub514\uc5d0\uc11c \uc774\ub7ec\ud55c \u2018\uc228\uaca8\uc9c4 \uc694\uc18c\u2019\ub97c \ucc3e\uc744 \uc218 \uc788\ub098\uc694?", "answer": "\ud589\ub9e8 \uac8c\uc784\uc5d0 \uc228\uaca8\uc9c4 \uc7ac\ubbf8\uc788\ub294 \uc694\uc18c\uac00 \uc788\ub294\uc9c0 \uc5ec\ubd80\ub294 \uac8c\uc784 \uac1c\ubc1c\uc790\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. \uc77c\ubd80 \uac1c\ubc1c\uc790\ub294 \uac8c\uc784\uc5d0 \uc7ac\ubbf8\uc788\ub294 \uc694\uc18c\ub97c \ucd94\uac00\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud50c\ub808\uc774\uc5b4\uac00 \ud2b9\uc815 \ub2e8\uc5b4\ub97c \ub9de\ud788\uba74 \ud2b9\ubcc4\ud55c \uc560\ub2c8\uba54\uc774\uc158\uc774\ub098 \uc0ac\uc6b4\ub4dc \ud6a8\uacfc\uac00 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc7ac\ubbf8\uc788\ub294 \uc694\uc18c\ub97c \ucc3e\ub294 \ubc29\ubc95\uc740 \uac8c\uc784 \ud3ec\ub7fc\uc744 \uac80\uc0c9\ud558\uac70\ub098, \uac8c\uc784 \uac00\uc774\ub4dc\ub97c \uc77d\uac70\ub098, \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uc640 \uc815\ubcf4\ub97c \uad50\ud658\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5b4\ub5a4 \ubc84\uc804\uc758 \ud589\ub9e8 \uac8c\uc784\uc5d0\uc11c\ub294 \u2018EPIC\u2019\uc774\ub77c\ub294 \ub2e8\uc5b4\ub97c \ub9de\ud788\uba74 \ud2b9\ubcc4\ud55c \uc560\ub2c8\uba54\uc774\uc158\uc774 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \u2018Hangman [\uac8c\uc784 \uc774\ub984] easter eggs\u2019\ub97c \uac80\uc0c9\ud574 \ubcf4\uba74 \ud78c\ud2b8\ub97c \uc5bb\uc744 \uc218 \uc788\uc744 \uac83\uc785\ub2c8\ub2e4."}]
[{"question": "\u30cf\u30f3\u30b0\u30de\u30f3\u30b2\u30fc\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u958b\u59cb\u3055\u308c\u307e\u3059\u304b\uff1f\u521d\u5fc3\u8005\u306e\u79c1\u306f\u3001\u6700\u521d\u306e\u6587\u5b57\u306f\u4f55\u3092\u63a8\u6e2c\u3059\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u30cf\u30f3\u30b0\u30de\u30f3\u30b2\u30fc\u30e0\u306e\u958b\u59cb\u306f\u975e\u5e38\u306b\u7c21\u5358\u3067\u3059\u3002\u30b2\u30fc\u30e0\u3092\u8d77\u52d5\u3059\u308b\u3068\u3001\u30b7\u30b9\u30c6\u30e0\u306f\u30e9\u30f3\u30c0\u30e0\u306a\u5358\u8a9e\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u3042\u306a\u305f\u306b\u6c42\u3081\u3089\u308c\u308b\u306e\u306f\u3001\u6587\u5b57\u3092\u63a8\u6e2c\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u521d\u5fc3\u8005\u306f\u3001\u82f1\u8a9e\u306e\u5358\u8a9e\u4e2d\u3067\u983b\u5ea6\u304c\u9ad8\u3044\u6bcd\u97f3\u6587\u5b57\uff08'E'\u3001'A'\u3001'I'\u306a\u3069\uff09\u3092\u512a\u5148\u7684\u306b\u63a8\u6e2c\u3059\u308b\u3053\u3068\u3092\u304a\u52e7\u3081\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u6587\u5b57\u3092\u63a8\u6e2c\u3059\u308b\u3053\u3068\u3067\u3001\u6587\u5b57\u3092\u5f53\u3066\u308b\u78ba\u7387\u304c\u9ad8\u307e\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6700\u521d\u306b'E'\u3092\u63a8\u6e2c\u3057\u3001\u5358\u8a9e\u306e\u4e2d\u306b'E'\u304c\u306a\u3044\u3053\u3068\u304c\u308f\u304b\u3063\u305f\u5834\u5408\u306f\u3001'A'\u3092\u8a66\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u53ef\u80fd\u6027\u3092\u6bb5\u968e\u7684\u306b\u7d5e\u308a\u8fbc\u3080\u30d7\u30ed\u30bb\u30b9\u3067\u3059\u3002"}, {"question": "\u30cf\u30f3\u30b0\u30de\u30f3\u30b2\u30fc\u30e0\u3067\u3001\u6587\u5b57\u3092\u9593\u9055\u3063\u3066\u63a8\u6e2c\u3059\u308b\u3068\u3069\u306e\u3088\u3046\u306a\u7f70\u5247\u304c\u3042\u308a\u307e\u3059\u304b\uff1f\u7f70\u5247\u306f\u3001\u79c1\u306e\u30b2\u30fc\u30e0\u6226\u7565\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30cf\u30f3\u30b0\u30de\u30f3\u30b2\u30fc\u30e0\u3067\u3001\u6587\u5b57\u3092\u9593\u9055\u3063\u3066\u63a8\u6e2c\u3059\u308b\u3068\u3001\u7d5e\u9996\u53f0\u306e\u56f3\u304c\u5f90\u3005\u306b\u5b8c\u6210\u3057\u3066\u3044\u304d\u307e\u3059\u3002\u4e00\u822c\u7684\u306b\u3001\u30b2\u30fc\u30e0\u3067\u306f\u5236\u9650\u3055\u308c\u305f\u56de\u6570\uff08\u901a\u5e38\u306f6\u56de\uff09\u306e\u8aa4\u7b54\u304c\u8a31\u3055\u308c\u307e\u3059\u3002\u8aa4\u7b54\u3059\u308b\u305f\u3073\u306b\u7d5e\u9996\u53f0\u306e\u56f3\u304c\u8ffd\u52a0\u3055\u308c\u3001\u7d5e\u9996\u53f0\u304c\u5b8c\u5168\u306b\u63cf\u304b\u308c\u308b\u3068\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u8ca0\u3051\u3068\u306a\u308a\u307e\u3059\u3002\u3053\u306e\u7f70\u5247\u306f\u3001\u3042\u306a\u305f\u306e\u30b2\u30fc\u30e0\u6226\u7565\u306b\u5927\u304d\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u63a8\u6e2c\u3059\u308b\u6587\u5b57\u3092\u614e\u91cd\u306b\u9078\u3073\u3001\u5b89\u6613\u306a\u63a8\u6e2c\u3092\u907f\u3051\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6b8b\u308a\u306e\u30c1\u30e3\u30f3\u30b9\u304c2\u56de\u3057\u304b\u306a\u3044\u5834\u5408\u3001\u9ad8\u3044\u78ba\u4fe1\u5ea6\u3092\u6301\u3064\u6587\u5b57\u3092\u512a\u5148\u7684\u306b\u63a8\u6e2c\u3059\u308b\u304b\u3001\u65e2\u77e5\u306e\u6587\u5b57\u306e\u7d44\u307f\u5408\u308f\u305b\u304b\u3089\u3001\u53ef\u80fd\u6027\u306e\u3042\u308b\u5358\u8a9e\u3092\u63a8\u6e2c\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30cf\u30f3\u30b0\u30de\u30f3\u30b2\u30fc\u30e0\u3067\"\u7d5e\u9996\u5211\"\u3092\u907f\u3051\u308b\u305f\u3081\u306e\u6700\u9069\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f\u3059\u3079\u3066\u306e\u9577\u3055\u306e\u5358\u8a9e\u306b\u9069\u7528\u3067\u304d\u308b\u4e00\u822c\u7684\u306a\u65b9\u6cd5\u306f\u3042\u308b\u3067\u3057\u3087\u3046\u304b\uff1f", "answer": "\u300c\u7d5e\u9996\u5211\u300d\u3092\u907f\u3051\u308b\u9375\u306f\u3001\u63a8\u6e2c\u306e\u6b63\u78ba\u6027\u3092\u9ad8\u3081\u308b\u3053\u3068\u3067\u3059\u3002STEP1\uff1a\u4e00\u822c\u7684\u306a\u6bcd\u97f3\u6587\u5b57\uff08E, A, I, O, U\uff09\u3092\u512a\u5148\u7684\u306b\u63a8\u6e2c\u3057\u307e\u3059\u3002STEP2\uff1a\u65e2\u77e5\u306e\u6587\u5b57\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u89b3\u5bdf\u3057\u3001\u4e00\u822c\u7684\u306a\u6587\u5b57\u306e\u7d44\u307f\u5408\u308f\u305b\uff08'TH'\u3001'ST'\u3001'ING'\u306a\u3069\uff09\u3092\u8a66\u3057\u307e\u3059\u3002STEP3\uff1a\u5358\u8a9e\u306e\u9577\u3055\u3068\u65e2\u77e5\u306e\u6587\u5b57\u306b\u57fa\u3065\u3044\u3066\u3001\u5358\u8a9e\u306e\u7bc4\u56f2\u3092\u72ed\u3081\u307e\u3059\u3002\u3059\u3079\u3066\u306e\u72b6\u6cc1\u306b\u9069\u7528\u3067\u304d\u308b\u4e07\u80fd\u306a\u65b9\u6cd5\u306f\u5b58\u5728\u3057\u307e\u305b\u3093\u304c\u3001\u7df4\u7fd2\u3092\u901a\u3057\u3066\u7d4c\u9a13\u3092\u7a4d\u307f\u91cd\u306d\u3001\u3044\u304f\u3064\u304b\u306e\u6cd5\u5247\u3092\u5f90\u3005\u306b\u628a\u63e1\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5358\u8a9e\u304c\u77ed\u304f\u30013\uff5e4\u6587\u5b57\u3057\u304b\u306a\u3044\u5834\u5408\u306f\u3001\u4e00\u822c\u7684\u306a\u5358\u8a9e\u3067\u3042\u308b\u53ef\u80fd\u6027\u304c\u9ad8\u3044\u3067\u3059\u3002\u5358\u8a9e\u304c\u9577\u3044\u5834\u5408\u306f\u3001\u5c02\u9580\u7528\u8a9e\u307e\u305f\u306f\u8907\u5408\u8a9e\u3067\u3042\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\uff1a\u30cf\u30f3\u30b0\u30de\u30f3\u3092\u6697\u53f7\u89e3\u8aad\u30b2\u30fc\u30e0\u3068\u60f3\u50cf\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6b63\u89e3\u3057\u305f\u305d\u308c\u305e\u308c\u306e\u6587\u5b57\u306f\u3001\u8b0e\u3092\u6bb5\u968e\u7684\u306b\u89e3\u304d\u660e\u304b\u3059\u305f\u3081\u306e\u624b\u304c\u304b\u308a\u3067\u3059\u3002"}, {"question": "\u30cf\u30f3\u30b0\u30de\u30f3\u30b2\u30fc\u30e0\u3067\u3001\u65e2\u77e5\u306e\u6587\u5b57\u304b\u3089\u53ef\u80fd\u6027\u306e\u3042\u308b\u5358\u8a9e\u3092\u63a8\u6e2c\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f\u5229\u7528\u3067\u304d\u308b\u30c6\u30af\u30cb\u30c3\u30af\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u65e2\u77e5\u306e\u6587\u5b57\u304b\u3089\u53ef\u80fd\u6027\u306e\u3042\u308b\u5358\u8a9e\u3092\u63a8\u6e2c\u3059\u308b\u306b\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u30c6\u30af\u30cb\u30c3\u30af\u304c\u5fc5\u8981\u3067\u3059\u3002\u307e\u305a\u3001\u6587\u5b57\u306e\u4f4d\u7f6e\u3092\u8003\u616e\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5358\u8a9e\u306e\u4e2d\u592e\u306b'-A-'\u304c\u3042\u308b\u5834\u5408\u3001\u53ef\u80fd\u6027\u306e\u3042\u308b\u5358\u8a9e\u306f'BATH'\u3001'PATH'\u3001'MATH'\u306a\u3069\u3067\u3059\u3002\u6b21\u306b\u3001\u5358\u8a9e\u306e\u7a2e\u985e\u3092\u8003\u616e\u3057\u307e\u3059\u3002\u6587\u4e2d\u306b\u5fc5\u8981\u306a\u5358\u8a9e\u304c\u540d\u8a5e\u3067\u3042\u308c\u3070\u3001\u52d5\u8a5e\u3092\u6392\u9664\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u6700\u5f8c\u306b\u3001\u8f9e\u66f8\u3084\u30aa\u30f3\u30e9\u30a4\u30f3\u30ea\u30bd\u30fc\u30b9\u3092\u88dc\u52a9\u7684\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002\u591a\u304f\u306e\u30aa\u30f3\u30e9\u30a4\u30f3\u8f9e\u66f8\u3067\u306f\u3001\u65e2\u77e5\u306e\u6587\u5b57\u306b\u57fa\u3065\u3044\u3066\u3042\u3044\u307e\u3044\u306a\u691c\u7d22\u3092\u5b9f\u884c\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001Cambridge\u8f9e\u66f8\u3067'b?t?'\u3068\u5165\u529b\u3059\u308b\u3068\u3001'BATH'\u3001'BAT'\u306a\u3069\u306e\u5019\u88dc\u8a9e\u304c\u898b\u3064\u304b\u308a\u307e\u3059\u3002\u6bd4\u8f03\u8868\uff1a[\u5358\u8a9e\u306e\u9577\u3055|\u4e00\u822c\u7684\u306a\u54c1\u8a5e]\u3002\u3053\u306e\u8868\u3092\u53c2\u7167\u3057\u3066\u3001\u63a8\u6e2c\u30d7\u30ed\u30bb\u30b9\u3092\u88dc\u52a9\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30cf\u30f3\u30b0\u30de\u30f3\u30b2\u30fc\u30e0\u3067\u3001\u52d5\u7269\u3001\u690d\u7269\u3001\u6b74\u53f2\u7684\u4eba\u7269\u306a\u3069\u3001\u7279\u5b9a\u306e\u30c6\u30fc\u30de\u306e\u5358\u8a9e\u30ea\u30b9\u30c8\u304c\u63d0\u4f9b\u3055\u308c\u308b\u5834\u5408\u304c\u3088\u304f\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30c6\u30fc\u30de\u306e\u5358\u8a9e\u30ea\u30b9\u30c8\u3092\u52b9\u679c\u7684\u306b\u6d3b\u7528\u3057\u3066\u52dd\u7387\u3092\u9ad8\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30c6\u30fc\u30de\u306e\u5358\u8a9e\u30ea\u30b9\u30c8\u3092\u6d3b\u7528\u3059\u308b\u9375\u306f\u3001\u63a8\u6e2c\u3059\u308b\u7bc4\u56f2\u3092\u72ed\u3081\u308b\u3053\u3068\u3067\u3059\u3002\u30b2\u30fc\u30e0\u306e\u30c6\u30fc\u30de\u304c\u300c\u52d5\u7269\u300d\u3067\u3042\u308b\u5834\u5408\u3001\u52d5\u7269\u306b\u95a2\u9023\u3059\u308b\u5358\u8a9e\u3092\u63a8\u6e2c\u3059\u308b\u4e8b\u306b\u96c6\u4e2d\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u307e\u305a\u3001\u4e00\u822c\u7684\u306a\u52d5\u7269\u306e\u540d\u524d\uff08\u300cCAT\u300d\u3001\u300cDOG\u300d\u3001\u300cELEPHANT\u300d\u306a\u3069\uff09\u3092\u601d\u3044\u51fa\u3057\u307e\u3059\u3002\u6b21\u306b\u3001\u7279\u5b9a\u306e\u52d5\u7269\u306e\u7a2e\u985e\uff08\u9ce5\u985e\u3001\u9b5a\u985e\u3001\u6606\u866b\u306a\u3069\uff09\u3092\u8003\u3048\u307e\u3059\u3002\u6700\u5f8c\u306b\u3001\u3042\u308b\u7279\u5b9a\u306e\u30c6\u30fc\u30de\u306b\u975e\u5e38\u306b\u7cbe\u901a\u3057\u3066\u3044\u308b\u5834\u5408\uff08\u4f8b\u3048\u3070\u3001\u52d5\u7269\u611b\u597d\u5bb6\u3067\u3042\u308b\u5834\u5408\uff09\u3001\u307e\u308c\u306a\u52d5\u7269\u306e\u540d\u524d\u3092\u8003\u616e\u3059\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u3002\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a[\u30c6\u30fc\u30de\u306e\u63d0\u793a] -> [\u4e00\u822c\u7684\u306a\u5358\u8a9e\u306e\u60f3\u8d77] -> [\u7279\u5b9a\u306e\u30bf\u30a4\u30d7\u3092\u691c\u8a0e] -> [\u307e\u308c\u306a\u5358\u8a9e\u3092\u63a8\u6e2c]\u3002\u3053\u306e\u65b9\u6cd5\u3067\u63a8\u6e2c\u306e\u52b9\u7387\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u4e0a\u7d1a\u306e\u30cf\u30f3\u30b0\u30de\u30f3\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u63a8\u6e2c\u983b\u5ea6\u3092\u3069\u306e\u3088\u3046\u306b\u5206\u6790\u3057\u3066\u3044\u307e\u3059\u304b\uff1f\u4e0a\u7d1a\u30ec\u30d9\u30eb\u306e\u6587\u5b57\u512a\u5148\u9806\u4f4d\u30ea\u30b9\u30c8\u3092\u3044\u304f\u3064\u304b\u6559\u3048\u3066\u3044\u305f\u3060\u3051\u307e\u3059\u304b\uff1f", "answer": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u6587\u5b57\u306e\u4f7f\u7528\u983b\u5ea6\u306b\u57fa\u3065\u3044\u3066\u63a8\u6e2c\u6226\u7565\u3092\u8abf\u6574\u3057\u307e\u3059\u3002'E'\u304c\u6700\u3082\u4e00\u822c\u7684\u306a\u6587\u5b57\u3067\u3042\u308b\u3068\u3057\u3066\u3082\u3001\u305d\u306e\u5f8c\u306e\u6587\u5b57\u306e\u512a\u5148\u9806\u4f4d\u306f\u3001\u30b3\u30fc\u30d1\u30b9\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u3002\u4e00\u822c\u7684\u306a\u512a\u5148\u9806\u4f4d\u30ea\u30b9\u30c8\u306f\u3001E-T-A-O-I-N-S-H-R-D-L-C-U-M-W-F-G-P-Y-B-V-K-X-Q-J-Z\u3067\u3059\u3002\u3053\u306e\u30ea\u30b9\u30c8\u306f\u53c2\u7167\u3068\u3057\u3066\u4f7f\u7528\u3067\u304d\u307e\u3059\u304c\u3001\u91cd\u8981\u306a\u306e\u306f\u3001\u30b2\u30fc\u30e0\u306e\u72b6\u6cc1\u306b\u57fa\u3065\u3044\u3066\u8abf\u6574\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001'C'\u3001'A'\u3001'T'\u306e3\u6587\u5b57\u3092\u63a8\u6e2c\u3057\u305f\u5834\u5408\u3001\u6b21\u306e\u6587\u5b57\u3068\u3057\u3066'H'\u3092\u63a8\u6e2c\u3059\u308b\u78ba\u7387\u306f\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002\u306a\u305c\u306a\u3089'CAT'\u306b'H'\u3092\u52a0\u3048\u308b\u3068'CATCH'\u3068\u3044\u3046\u5358\u8a9e\u306b\u306a\u308a\u3084\u3059\u3044\u304b\u3089\u3067\u3059\u3002\u8907\u6570\u306e\u63d0\u6848\uff1a[\u5f93\u6765\u306e\u983b\u5ea6\u8868|\u30b3\u30f3\u30c6\u30ad\u30b9\u30c8\u983b\u5ea6\u306e\u8abf\u6574|\u500b\u4eba\u7684\u306a\u7d4c\u9a13]\u3002\u3053\u308c\u3089\u306e3\u70b9\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3001\u81ea\u5206\u81ea\u8eab\u306e\u63a8\u6e2c\u6226\u7565\u3092\u69cb\u7bc9\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30cf\u30f3\u30b0\u30de\u30f3\u306e\u6839\u672c\u7684\u306a\u8ad6\u7406\u306f\u4f55\u3067\u3059\u304b\uff1f\u5358\u8a9e\u9078\u629e\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u3092\u5206\u6790\u3059\u308b\u3053\u3068\u3067\u3001\u4e8b\u524d\u306b\u5358\u8a9e\u3092\u4e88\u6e2c\u3059\u308b\u3053\u3068\u306f\u53ef\u80fd\u3067\u3059\u304b\uff1f", "answer": "\u30cf\u30f3\u30b0\u30de\u30f3\u306e\u6839\u672c\u7684\u306a\u8ad6\u7406\u306f\u3001\u5b9f\u88c5\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u3002\u4e00\u822c\u7684\u306b\u3001\u5358\u8a9e\u9078\u629e\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u4e88\u3081\u8a2d\u5b9a\u3055\u308c\u305f\u5358\u8a9e\u30ea\u30b9\u30c8\u306e\u4e2d\u304b\u3089\u30e9\u30f3\u30c0\u30e0\u306b\u5358\u8a9e\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u5358\u7d14\u306a\u5b9f\u88c5\u3067\u306f\u3001\u30e9\u30f3\u30c0\u30e0\u756a\u53f7\u30b8\u30a7\u30cd\u30ec\u30fc\u30bf\u3092\u4f7f\u7528\u3057\u3066\u3001\u30ea\u30b9\u30c8\u5185\u306e\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u3092\u9078\u629e\u3059\u308b\u3060\u3051\u3067\u3059\u3002\u3088\u308a\u8907\u96d1\u306a\u5b9f\u88c5\u3067\u306f\u3001\u5358\u8a9e\u306e\u9577\u3055\u3001\u96e3\u6613\u5ea6\u30ec\u30d9\u30eb\u3001\u30c6\u30fc\u30de\u306a\u3069\u306e\u8981\u56e0\u3092\u8003\u616e\u3057\u3066\u3044\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u7406\u8ad6\u7684\u306b\u306f\u3001\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u3092\u5206\u6790\u3059\u308b\u3053\u3068\u3067\u5358\u8a9e\u3092\u4e88\u6e2c\u3059\u308b\u3053\u3068\u304c\u53ef\u80fd\u3067\u3059\u304c\u3001\u5b9f\u969b\u306b\u306f\u975e\u5e38\u306b\u56f0\u96e3\u3067\u3059\u3002\u306a\u305c\u306a\u3089\u3001\u5358\u8a9e\u30ea\u30b9\u30c8\u306f\u901a\u5e38\u5927\u304d\u304f\u3001\u30e9\u30f3\u30c0\u30e0\u6570\u751f\u6210\u5668\u306f\u901a\u5e38\u64ec\u4f3c\u30e9\u30f3\u30c0\u30e0\u3067\u3042\u308b\u304b\u3089\u3067\u3059\u3002\u3057\u305f\u304c\u3063\u3066\u3001\u5358\u8a9e\u3092\u4e88\u6e2c\u3057\u3088\u3046\u3068\u8a66\u307f\u308b\u3088\u308a\u3082\u3001\u63a8\u6e2c\u306e\u6280\u8853\u3092\u9ad8\u3081\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u30cf\u30f3\u30b0\u30de\u30f3\u306e\u96e3\u6613\u5ea6\u4fc2\u6570\u306f\u3069\u306e\u3088\u3046\u306b\u8a2d\u5b9a\u3055\u308c\u3066\u3044\u307e\u3059\u304b\uff1f\u7570\u306a\u308b\u30cf\u30f3\u30b0\u30de\u30f3\u30b2\u30fc\u30e0\u306e\u96e3\u6613\u5ea6\u3092\u8a55\u4fa1\u3059\u308b\u305f\u3081\u306b\u3001\u666e\u904d\u7684\u306a\u96e3\u6613\u5ea6\u8a55\u4fa1\u57fa\u6e96\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30cf\u30f3\u30b0\u30de\u30f3\u306e\u96e3\u6613\u5ea6\u4fc2\u6570\u306f\u3001\u5358\u8a9e\u306e\u9577\u3055\u3001\u8907\u96d1\u3055\u3001\u5e0c\u5c11\u6027\u306b\u3088\u3063\u3066\u4e3b\u306b\u6c7a\u5b9a\u3055\u308c\u307e\u3059\u3002\u4e00\u822c\u7684\u306b\u3001\u5358\u8a9e\u304c\u9577\u304f\u3066\u8907\u96d1\u3067\u5e0c\u5c11\u306a\u307b\u3069\u3001\u96e3\u6613\u5ea6\u304c\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002\u3044\u304f\u3064\u304b\u306e\u30cf\u30f3\u30b0\u30de\u30f3\u30b2\u30fc\u30e0\u3067\u306f\u3001\u5358\u8a9e\u306e\u5e73\u5747\u9577\u307e\u305f\u306f\u63a8\u6e2c\u56de\u6570\u3092\u57fa\u306b\u96e3\u6613\u5ea6\u30ec\u30d9\u30eb\u3092\u8a2d\u5b9a\u3057\u3066\u3044\u307e\u3059\u3002\u666e\u904d\u7684\u306a\u96e3\u6613\u5ea6\u8a55\u4fa1\u57fa\u6e96\u306f\u3042\u308a\u307e\u305b\u3093\u304c\u3001\u7570\u306a\u308b\u30b2\u30fc\u30e0\u306e\u5358\u8a9e\u30ea\u30b9\u30c8\u3068\u63a8\u6e2c\u56de\u6570\u3092\u6bd4\u8f03\u3057\u3066\u3001\u96e3\u6613\u5ea6\u3092\u8a55\u4fa1\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u7279\u5b9a\u306e\u30c6\u30fc\u30de\u306b\u9650\u5b9a\u3055\u308c\u305f\u30b2\u30fc\u30e0\uff08\u4f8b\u3048\u3070\u3001\u5c02\u9580\u7528\u8a9e\u306e\u307f\u3092\u4f7f\u7528\u3059\u308b\u30cf\u30f3\u30b0\u30de\u30f3\u30b2\u30fc\u30e0\uff09\u3082\u96e3\u6613\u5ea6\u306b\u95a2\u4e0e\u3057\u307e\u3059\u3002\u6bd4\u55a9\uff1a\u96e3\u6613\u5ea6\u8abf\u6574\u306f\u3001\u98df\u6750\u3084\u706b\u52a0\u6e1b\u3092\u8abf\u6574\u3059\u308b\u6599\u7406\u306b\u4f8b\u3048\u3089\u308c\u307e\u3059\u3002\u305d\u308c\u305e\u308c\u306e\u300c\u6599\u7406\u300d\u306b\u5bfe\u3057\u3066\u9069\u5207\u306a\u300c\u30ec\u30b7\u30d4\u300d\u3092\u9078\u629e\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u3067\u30cf\u30f3\u30b0\u30de\u30f3\u30b2\u30fc\u30e0\u3092\u30d7\u30ec\u30a4\u3057\u305f\u5834\u5408\u3001\u30b2\u30fc\u30e0\u306e\u9032\u884c\u72b6\u6cc1\u306f\u540c\u671f\u3067\u304d\u307e\u3059\u304b\uff1f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u306e\u30c7\u30fc\u30bf\u79fb\u884c\u306e\u4ed5\u7d44\u307f\u306f\u3042\u308a\u307e\u3059\u304b\uff1f\u306a\u3051\u308c\u3070\u3001\u30b2\u30fc\u30e0\u306e\u6210\u679c\u3092\u8a18\u9332\u3059\u308b\u305f\u3081\u306e\u4ee3\u66ff\u6848\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30cf\u30f3\u30b0\u30de\u30f3\u30b2\u30fc\u30e0\u306e\u9032\u884c\u72b6\u6cc1\u304c\u3001\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u540c\u671f\u3055\u308c\u308b\u304b\u3069\u3046\u304b\u306f\u3001\u5177\u4f53\u7684\u306a\u30b2\u30fc\u30e0\u306e\u5b9f\u88c5\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u3002\u30aa\u30f3\u30e9\u30a4\u30f3\u306e\u30cf\u30f3\u30b0\u30de\u30f3\u30b2\u30fc\u30e0\u306e\u4e2d\u306b\u306f\u3001\u30af\u30e9\u30a6\u30c9\u30b9\u30c8\u30ec\u30fc\u30b8\u3092\u4f7f\u7528\u3057\u3066\u3001\u30b2\u30fc\u30e0\u9032\u884c\u72b6\u6cc1\u3092\u540c\u671f\u3059\u308b\u3082\u306e\u304c\u5b58\u5728\u3059\u308b\u5834\u5408\u3082\u3042\u308a\u307e\u3059\u3002\u516c\u5f0f\u306e\u540c\u671f\u65b9\u6cd5\u304c\u306a\u3044\u5834\u5408\u306f\u3001\u624b\u52d5\u3067\u30b2\u30fc\u30e0\u306e\u6210\u679c\u3092\u8a18\u9332\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6b63\u89e3\u3057\u305f\u5358\u8a9e\u6570\u3001\u6240\u8981\u6642\u9593\u306a\u3069\u3092\u8a18\u9332\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4ee3\u66ff\u7b56\uff1a\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\u3001\u8a18\u9332\u3001\u30b5\u30fc\u30c9\u30d1\u30fc\u30c6\u30a3\u88fd\u30c7\u30fc\u30bf\u7ba1\u7406\u30c4\u30fc\u30eb\u306a\u3069\u3092\u7528\u3044\u308b\u3053\u3068\u3067\u3001\u6210\u679c\u3092\u8a18\u9332\u3067\u304d\u307e\u3059\u3002\u5c06\u6765\u3001\u30af\u30e9\u30a6\u30c9\u30b5\u30fc\u30d0\u30fc\u3092\u4f7f\u7528\u3057\u3066\u306e\u540c\u671f\u3092\u8003\u616e\u3067\u304d\u308b\u3067\u3057\u3087\u3046\u3002"}, {"question": "\u30cf\u30f3\u30b0\u30de\u30f3\u30b2\u30fc\u30e0\u306b\u96a0\u3055\u308c\u305f\u8981\u7d20\uff08\u5f69\u86cb\uff09\u306f\u3042\u308a\u307e\u3059\u304b\uff1f\u305f\u3068\u3048\u3070\u3001\u7279\u5b9a\u306e\u5358\u8a9e\u306e\u7d44\u307f\u5408\u308f\u305b\u3067\u3001\u7279\u5225\u306a\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3\u3084\u5831\u916c\u304c\u30c8\u30ea\u30ac\u30fc\u3055\u308c\u308b\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u304b\uff1f\u3053\u308c\u3089\u306e\u300c\u96a0\u3055\u308c\u305f\u8981\u7d20\u300d\u306f\u3069\u3053\u3067\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30cf\u30f3\u30b0\u30de\u30f3\u30b2\u30fc\u30e0\u306b\u96a0\u3057\u8981\u7d20\uff08\u5f69\u86cb\uff09\u304c\u542b\u307e\u308c\u308b\u304b\u3069\u3046\u304b\u306f\u3001\u30b2\u30fc\u30e0\u958b\u767a\u8005\u6b21\u7b2c\u3067\u3059\u3002\u4e00\u90e8\u306e\u958b\u767a\u8005\u306f\u3001\u30b2\u30fc\u30e0\u306b\u5e7e\u3064\u304b\u306e\u9762\u767d\u3044\u5f69\u86cb\u3092\u8ffd\u52a0\u3057\u3066\u3044\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u7279\u5b9a\u306e\u5358\u8a9e\u3092\u63a8\u6e2c\u3059\u308b\u3068\u3001\u7279\u5225\u306a\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3\u3084\u97f3\u52b9\u679c\u304c\u767a\u52d5\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u5f69\u86cb\u3092\u898b\u3064\u3051\u308b\u65b9\u6cd5\u3068\u3057\u3066\u3001\u30b2\u30fc\u30e0\u306e\u30d5\u30a9\u30fc\u30e9\u30e0\u3001\u653b\u7565\u60c5\u5831\u3001\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u306e\u4ea4\u6d41\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u3042\u308b\u30d0\u30fc\u30b8\u30e7\u30f3\u306e\u30cf\u30f3\u30b0\u30de\u30f3\u30b2\u30fc\u30e0\u3067\u306f\u3001\u300cEPIC\u300d\u3068\u3044\u3046\u5358\u8a9e\u3092\u63a8\u6e2c\u3059\u308b\u3068\u3001\u7279\u5225\u306a\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3\u304c\u8868\u793a\u3055\u308c\u308b\u5834\u5408\u3082\u3042\u308a\u307e\u3059\u3002\u300e\u30cf\u30f3\u30b0\u30de\u30f3 [\u30b2\u30fc\u30e0\u540d] \u5f69\u86cb\u300f\u3067\u691c\u7d22\u3059\u308b\u3068\u3001\u624b\u304c\u304b\u308a\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u3067\u3057\u3087\u3046\u3002"}]
[{"question": "Hangman\u6e38\u620f\u5982\u4f55\u5f00\u59cb\uff1f\u4f5c\u4e3a\u65b0\u624b\uff0c\u6211\u7684\u7b2c\u4e00\u4e2a\u5b57\u6bcd\u5e94\u8be5\u731c\u4ec0\u4e48\uff1f", "answer": "Hangman\u6e38\u620f\u5f00\u59cb\u975e\u5e38\u7b80\u5355\uff0c\u542f\u52a8\u6e38\u620f\u540e\uff0c\u7cfb\u7edf\u4f1a\u968f\u673a\u9009\u62e9\u4e00\u4e2a\u5355\u8bcd\uff0c\u4f60\u9700\u8981\u505a\u7684\u5c31\u662f\u5f00\u59cb\u731c\u6d4b\u5b57\u6bcd\u3002\u65b0\u624b\u63a8\u8350\u4f18\u5148\u731c\u6d4b\u5e38\u89c1\u7684\u5143\u97f3\u5b57\u6bcd\uff0c\u5982'E', 'A', 'I'\uff0c\u8fd9\u4e9b\u5b57\u6bcd\u5728\u82f1\u6587\u5355\u8bcd\u4e2d\u51fa\u73b0\u7684\u9891\u7387\u8f83\u9ad8\uff0c\u80fd\u63d0\u9ad8\u4f60\u731c\u4e2d\u5b57\u6bcd\u7684\u6982\u7387\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5148\u731c'E'\uff0c\u53d1\u73b0\u5355\u8bcd\u4e2d\u6ca1\u6709'E'\uff0c\u90a3\u4e48\u4f60\u53ef\u4ee5\u5c1d\u8bd5'A'\u3002\u8fd9\u662f\u4e00\u4e2a\u9010\u6b65\u7f29\u51cf\u53ef\u80fd\u6027\u7684\u8fc7\u7a0b\u3002"}, {"question": "Why\u5728Hangman\u6e38\u620f\u4e2d\uff0c\u731c\u9519\u5b57\u6bcd\u4f1a\u6709\u4ec0\u4e48\u60e9\u7f5a\uff1f\u60e9\u7f5a\u5982\u4f55\u5f71\u54cd\u6211\u7684\u6e38\u620f\u7b56\u7565\uff1f", "answer": "\u5728Hangman\u6e38\u620f\u4e2d\uff0c\u731c\u9519\u5b57\u6bcd\u4f1a\u5bfc\u81f4\u7ede\u5211\u67b6\u9010\u6e10\u7ed8\u5236\u5b8c\u6210\u3002\u4e00\u822c\u6765\u8bf4\uff0c\u6e38\u620f\u4f1a\u7ed9\u4e88\u4f60\u6709\u9650\u7684\u9519\u8bef\u6b21\u6570\uff08\u901a\u5e38\u662f6\u6b21\uff09\u3002\u6bcf\u6b21\u731c\u9519\uff0c\u7ede\u5211\u67b6\u4f1a\u589e\u52a0\u4e00\u90e8\u5206\uff0c\u76f4\u5230\u7ede\u5211\u67b6\u5b8c\u5168\u753b\u597d\uff0c\u4f60\u5c31\u8f93\u4e86\u3002\u56e0\u6b64\uff0c\u60e9\u7f5a\u7684\u5b58\u5728\u5f3a\u70c8\u5f71\u54cd\u7740\u4f60\u7684\u6e38\u620f\u7b56\u7565\u3002\u4f60\u9700\u8981\u5ba1\u614e\u9009\u62e9\u731c\u6d4b\u7684\u5b57\u6bcd\uff0c\u907f\u514d\u76f2\u76ee\u731c\u6d4b\u3002\u6bd4\u5982\uff0c\u5f53\u4f60\u53ea\u5269\u4e0b2\u6b21\u673a\u4f1a\u65f6\uff0c\u5c31\u5e94\u8be5\u4f18\u5148\u8003\u8651\u90a3\u4e9b\u4f60\u9ad8\u5ea6\u786e\u4fe1\u5b58\u5728\u7684\u5b57\u6bcd\uff0c\u6216\u8005\u6839\u636e\u5df2\u77e5\u7684\u5b57\u6bcd\u7ec4\u5408\uff0c\u63a8\u6d4b\u53ef\u80fd\u7684\u5355\u8bcd\u3002"}, {"question": "What\u662fHangman\u4e2d\u907f\u514d\u201c\u7ede\u5211\u201d\u7684\u6700\u4f73\u7b56\u7565\uff1f\u6709\u6ca1\u6709\u9002\u7528\u4e8e\u6240\u6709\u957f\u5ea6\u5355\u8bcd\u7684\u901a\u7528\u65b9\u6cd5\uff1f", "answer": "\u907f\u514d\u201c\u7ede\u5211\u201d\u7684\u5173\u952e\u5728\u4e8e\u63d0\u9ad8\u731c\u6d4b\u7684\u51c6\u786e\u7387\u3002STEP1\uff1a\u4f18\u5148\u731c\u6d4b\u5e38\u89c1\u7684\u5143\u97f3\u5b57\u6bcd\uff08E, A, I, O, U\uff09\u3002STEP2\uff1a\u89c2\u5bdf\u5df2\u731c\u4e2d\u5b57\u6bcd\u7684\u7ec4\u5408\uff0c\u5c1d\u8bd5\u5e38\u89c1\u7684\u5b57\u6bcd\u7ec4\u5408\uff0c\u5982'TH'\uff0c'ST'\uff0c'ING'\u7b49\u3002STEP3\uff1a\u6839\u636e\u5355\u8bcd\u7684\u957f\u5ea6\u548c\u5df2\u77e5\u7684\u5b57\u6bcd\uff0c\u7f29\u5c0f\u5355\u8bcd\u7684\u8303\u56f4\u3002\u867d\u7136\u6ca1\u6709\u9002\u7528\u4e8e\u6240\u6709\u60c5\u51b5\u7684\u901a\u7528\u65b9\u6cd5\uff0c\u4f46\u4f60\u53ef\u4ee5\u901a\u8fc7\u7ec3\u4e60\u79ef\u7d2f\u7ecf\u9a8c\uff0c\u9010\u6e10\u638c\u63e1\u4e00\u4e9b\u89c4\u5f8b\u3002\u6bd4\u5982\uff0c\u5982\u679c\u5355\u8bcd\u5f88\u77ed\uff0c\u53ea\u67093-4\u4e2a\u5b57\u6bcd\uff0c\u90a3\u4e48\u5f88\u53ef\u80fd\u662f\u4e00\u4e9b\u5e38\u89c1\u7684\u8bcd\u6c47\u3002\u5982\u679c\u5355\u8bcd\u5f88\u957f\uff0c\u90a3\u4e48\u53ef\u80fd\u662f\u4e00\u4e9b\u4e13\u4e1a\u672f\u8bed\u6216\u8005\u590d\u5408\u8bcd\u3002\u6bd4\u55bb\u8bf4\u660e\uff1a\u4f60\u53ef\u4ee5\u628aHangman\u60f3\u8c61\u6210\u89e3\u5bc6\u6e38\u620f\uff0c\u6bcf\u4e00\u4e2a\u731c\u5bf9\u7684\u5b57\u6bcd\u90fd\u662f\u4e00\u4e2a\u7ebf\u7d22\uff0c\u5e2e\u52a9\u4f60\u9010\u6b65\u63ed\u5f00\u8c1c\u5e95\u3002"}, {"question": "\u5728Hangman\u4e2d\uff0c\u5982\u4f55\u6839\u636e\u5df2\u77e5\u7684\u5b57\u6bcd\uff0c\u63a8\u65ad\u51fa\u53ef\u80fd\u7684\u5355\u8bcd\uff1f\u6709\u6ca1\u6709\u4e00\u4e9b\u6280\u5de7\u53ef\u4ee5\u5229\u7528\uff1f", "answer": "\u6839\u636e\u5df2\u77e5\u7684\u5b57\u6bcd\u63a8\u65ad\u53ef\u80fd\u7684\u5355\u8bcd\u9700\u8981\u4e00\u4e9b\u6280\u5de7\u3002\u9996\u5148\uff0c\u8003\u8651\u5b57\u6bcd\u7684\u4f4d\u7f6e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5355\u8bcd\u4e2d\u95f4\u662f'-A-', \u90a3\u4e48\u53ef\u80fd\u7684\u5355\u8bcd\u6709'BATH', 'PATH', 'MATH'\u7b49\u7b49\u3002\u5176\u6b21\uff0c\u8003\u8651\u5355\u8bcd\u7684\u8bcd\u6027\u3002\u5982\u679c\u53e5\u5b50\u9700\u8981\u4e00\u4e2a\u540d\u8bcd\uff0c\u90a3\u4e48\u5c31\u6392\u9664\u52a8\u8bcd\u3002\u6700\u540e\uff0c\u5229\u7528\u8bcd\u5178\u6216\u5728\u7ebf\u8d44\u6e90\u8fdb\u884c\u8f85\u52a9\u3002\u5f88\u591a\u5728\u7ebf\u8bcd\u5178\u5141\u8bb8\u4f60\u6839\u636e\u5df2\u77e5\u7684\u5b57\u6bcd\u8fdb\u884c\u6a21\u7cca\u641c\u7d22\u3002\u4f8b\u5982\uff0c\u5728Cambridge\u8bcd\u5178\u4e2d\u8f93\u5165'b?t?' \u53ef\u4ee5\u627e\u5230'BATH'\uff0c 'BAT' \u7b49\u5019\u9009\u8bcd\u6c47.\u914d\u7f6e\u5bf9\u7167\u8868\uff1a[\u5355\u8bcd\u957f\u5ea6|\u5e38\u89c1\u8bcd\u6027]\u3002 \u53ef\u4ee5\u53c2\u8003\u8fd9\u4e2a\u8868 \u6765\u8f85\u52a9\u731c\u6d4b\u8fc7\u7a0b\u3002"}, {"question": "Hangman\u6e38\u620f\u91cc\uff0c\u4e00\u4e9b\u7f51\u7ad9\u6216App\u63d0\u4f9b\u4e86\u4e3b\u9898\u8bcd\u5e93\uff0c\u4f8b\u5982\u52a8\u7269\u3001\u690d\u7269\u3001\u5386\u53f2\u4eba\u7269\u7b49\u3002\u5982\u4f55\u9ad8\u6548\u5229\u7528\u8fd9\u4e9b\u4e3b\u9898\u8bcd\u5e93\u6765\u63d0\u9ad8\u80dc\u7387\uff1f", "answer": "\u5229\u7528\u4e3b\u9898\u8bcd\u5e93\u7684\u5173\u952e\u5728\u4e8e\u7f29\u5c0f\u731c\u6d4b\u8303\u56f4\u3002\u5982\u679c\u6e38\u620f\u63d0\u793a\u4e3b\u9898\u662f\u201c\u52a8\u7269\u201d\uff0c\u90a3\u4e48\u4f60\u5c31\u5e94\u8be5\u96c6\u4e2d\u7cbe\u529b\u731c\u6d4b\u4e0e\u52a8\u7269\u76f8\u5173\u7684\u5355\u8bcd\u3002\u9996\u5148\uff0c\u56de\u5fc6\u5e38\u89c1\u7684\u52a8\u7269\u540d\u79f0\uff0c\u4f8b\u5982\u201cCAT\u201d\uff0c\u201cDOG\u201d\uff0c\u201cELEPHANT\u201d\u7b49\u3002\u5176\u6b21\uff0c\u8003\u8651\u7279\u5b9a\u7c7b\u578b\u7684\u52a8\u7269\uff0c\u4f8b\u5982\u9e1f\u7c7b\u3001\u9c7c\u7c7b\u3001\u6606\u866b\u7b49\u3002\u6700\u540e\uff0c\u5982\u679c\u4f60\u5bf9\u67d0\u4e2a\u4e3b\u9898\u975e\u5e38\u719f\u6089\uff0c\u4f8b\u5982\u4f60\u662f\u4e00\u540d\u52a8\u7269\u7231\u597d\u8005\uff0c\u90a3\u4e48\u4f60\u53ef\u4ee5\u8003\u8651\u4e00\u4e9b\u4e0d\u592a\u5e38\u89c1\u7684\u52a8\u7269\u540d\u79f0\u3002\u6d41\u7a0b\u56fe\u89e3\uff1a[\u4e3b\u9898\u63d0\u793a] -> [\u56de\u5fc6\u5e38\u89c1\u8bcd\u6c47] -> [\u8003\u8651\u7279\u5b9a\u7c7b\u578b] -> [\u731c\u6d4b\u4e0d\u5e38\u89c1\u8bcd\u6c47]\u3002\u901a\u8fc7\u8fd9\u79cd\u65b9\u5f0f\uff0c\u4f60\u53ef\u4ee5\u5927\u5927\u63d0\u9ad8\u731c\u6d4b\u7684\u6548\u7387\u3002"}, {"question": "\u9ad8\u7ea7Hangman\u73a9\u5bb6\u662f\u5982\u4f55\u5206\u6790\u731c\u6d4b\u9891\u7387\u7684\uff1f\u80fd\u5206\u4eab\u4e00\u4e9b\u8fdb\u9636\u7684\u5b57\u6bcd\u4f18\u5148\u7ea7\u5217\u8868\u5417\uff1f", "answer": "\u9ad8\u7ea7\u73a9\u5bb6\u4f1a\u6839\u636e\u5b57\u6bcd\u7684\u4f7f\u7528\u9891\u7387\u8c03\u6574\u731c\u6d4b\u7b56\u7565\u3002\u867d\u7136'E'\u662f\u6700\u5e38\u7528\u7684\u5b57\u6bcd\uff0c\u4f46\u540e\u7eed\u7684\u5b57\u6bcd\u4f18\u5148\u7ea7\u4f1a\u6839\u636e\u8bed\u6599\u5e93\u7684\u4e0d\u540c\u800c\u6709\u6240\u53d8\u5316\u3002\u4e00\u79cd\u5e38\u89c1\u7684\u4f18\u5148\u7ea7\u5217\u8868\u662f\uff1aE-T-A-O-I-N-S-H-R-D-L-C-U-M-W-F-G-P-Y-B-V-K-X-Q-J-Z\u3002\u8fd9\u4e2a\u5217\u8868\u53ef\u4ee5\u4f5c\u4e3a\u4e00\u4e2a\u53c2\u8003\uff0c\u4f46\u66f4\u91cd\u8981\u7684\u662f\u6839\u636e\u6e38\u620f\u4e2d\u7684\u5b9e\u9645\u60c5\u51b5\u8fdb\u884c\u8c03\u6574\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5df2\u7ecf\u731c\u51fa\u4e86'C','A','T'\u8fd9\u4e09\u4e2a\u5b57\u6bcd\uff0c\u90a3\u4e48\u4e0b\u4e00\u4e2a\u5b57\u6bcd\u731c'H'\u7684\u6982\u7387\u4f1a\u6bd4\u8f83\u9ad8\uff0c\u56e0\u4e3a'CAT' \u52a0\u4e0a'H'\u5f88\u5bb9\u6613\u7ec4\u6210'CATCH'\u3002\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a[\u4f20\u7edf\u9891\u7387\u8868|\u8bed\u5883\u9891\u7387\u8c03\u6574|\u4e2a\u4eba\u7ecf\u9a8c]\u3002\u7ed3\u5408\u8fd9\u4e09\u70b9\uff0c\u53ef\u4ee5\u5f62\u6210\u4e00\u5957\u9002\u5408\u81ea\u5df1\u7684\u731c\u6d4b\u7b56\u7565\u3002"}, {"question": "Hangman\u7684\u5e95\u5c42\u903b\u8f91\u662f\u4ec0\u4e48\uff1f\u5355\u8bcd\u9009\u62e9\u7684\u7b97\u6cd5\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f\u662f\u5426\u6709\u53ef\u80fd\u901a\u8fc7\u5206\u6790\u7b97\u6cd5\u63d0\u524d\u9884\u6d4b\u5355\u8bcd\uff1f", "answer": "Hangman\u7684\u5e95\u5c42\u903b\u8f91\u53d6\u51b3\u4e8e\u5177\u4f53\u7684\u5b9e\u73b0\u3002\u4e00\u822c\u6765\u8bf4\uff0c\u5355\u8bcd\u9009\u62e9\u7684\u7b97\u6cd5\u662f\u4ece\u4e00\u4e2a\u9884\u5148\u8bbe\u5b9a\u7684\u5355\u8bcd\u5217\u8868\u4e2d\u968f\u673a\u9009\u62e9\u7684\u3002\u7b80\u5355\u7684\u5b9e\u73b0\u53ef\u80fd\u53ea\u662f\u4e00\u4e2a\u968f\u673a\u6570\u751f\u6210\u5668\uff0c\u7528\u6765\u9009\u62e9\u5217\u8868\u4e2d\u7684\u7d22\u5f15\u3002\u66f4\u590d\u6742\u7684\u5b9e\u73b0\u53ef\u80fd\u4f1a\u8003\u8651\u5355\u8bcd\u7684\u957f\u5ea6\u3001\u96be\u5ea6\u7b49\u7ea7\u3001\u4e3b\u9898\u7b49\u56e0\u7d20\u3002\u867d\u7136\u7406\u8bba\u4e0a\u53ef\u4ee5\u901a\u8fc7\u5206\u6790\u7b97\u6cd5\u6765\u9884\u6d4b\u5355\u8bcd\uff0c\u4f46\u5b9e\u9645\u4e0a\u975e\u5e38\u56f0\u96be\uff0c\u56e0\u4e3a\u5355\u8bcd\u5217\u8868\u901a\u5e38\u5f88\u5927\uff0c\u4e14\u968f\u673a\u6570\u751f\u6210\u5668\u901a\u5e38\u662f\u4f2a\u968f\u673a\u7684\u3002\u56e0\u6b64\uff0c\u4e0e\u5176\u5c1d\u8bd5\u9884\u6d4b\u5355\u8bcd\uff0c\u4e0d\u5982\u4e13\u6ce8\u4e8e\u63d0\u9ad8\u731c\u6d4b\u7684\u6280\u5de7\u3002"}, {"question": "Hangman\u7684\u96be\u5ea6\u7cfb\u6570\u662f\u5982\u4f55\u8bbe\u5b9a\u7684\uff1f\u662f\u5426\u5b58\u5728\u4e00\u5957\u901a\u7528\u7684\u96be\u5ea6\u8bc4\u4f30\u6807\u51c6\uff0c\u53ef\u4ee5\u7528\u6765\u8861\u91cf\u4e0d\u540cHangman\u6e38\u620f\u7684\u96be\u6613\u7a0b\u5ea6\uff1f", "answer": "Hangman\u7684\u96be\u5ea6\u7cfb\u6570\u4e3b\u8981\u53d6\u51b3\u4e8e\u5355\u8bcd\u7684\u957f\u5ea6\u3001\u590d\u6742\u5ea6\u548c\u7f55\u89c1\u7a0b\u5ea6\u3002\u4e00\u822c\u6765\u8bf4\uff0c\u5355\u8bcd\u8d8a\u957f\u3001\u8d8a\u590d\u6742\u3001\u8d8a\u7f55\u89c1\uff0c\u96be\u5ea6\u5c31\u8d8a\u9ad8\u3002\u4e00\u4e9bHangman\u6e38\u620f\u4f1a\u6839\u636e\u5355\u8bcd\u7684\u5e73\u5747\u957f\u5ea6\u6216\u731c\u6d4b\u6b21\u6570\u6765\u8bbe\u5b9a\u96be\u5ea6\u7b49\u7ea7\u3002\u867d\u7136\u6ca1\u6709\u901a\u7528\u7684\u96be\u5ea6\u8bc4\u4f30\u6807\u51c6\uff0c\u4f46\u4f60\u53ef\u4ee5\u901a\u8fc7\u6bd4\u8f83\u4e0d\u540c\u6e38\u620f\u7684\u5355\u8bcd\u5217\u8868\u548c\u731c\u6d4b\u6b21\u6570\u6765\u8861\u91cf\u5176\u96be\u6613\u7a0b\u5ea6\u3002\u53e6\u5916\uff0c\u4e00\u4e9b\u6e38\u620f\u4f1a\u52a0\u5165\u4e3b\u9898\u9650\u5236\uff0c\u4e5f\u4f1a\u5f71\u54cd\u96be\u5ea6\uff0c\u4f8b\u5982\u53ea\u4f7f\u7528\u4e13\u4e1a\u672f\u8bed\u7684Hangman\u4f1a\u66f4\u96be\u3002 \u6bd4\u55bb\u8bf4\u660e\uff1a\u96be\u5ea6\u8c03\u8282\u5c31\u50cf\u70f9\u996a\u65f6\u8c03\u6574\u98df\u6750\u548c\u706b\u5019\uff0c\u9700\u8981\u6839\u636e\u4e0d\u540c'\u83dc\u54c1'\u9009\u62e9\u5408\u9002\u7684'\u914d\u65b9'\u3002"}, {"question": "\u5982\u679c\u6211\u5728\u4e0d\u540c\u8bbe\u5907\u4e0a\u73a9Hangman\uff0c\u6e38\u620f\u8fdb\u5ea6\u53ef\u4ee5\u540c\u6b65\u5417\uff1f\u662f\u5426\u5b58\u5728\u8de8\u5e73\u53f0\u7684\u6570\u636e\u8fc1\u79fb\u65b9\u6848\uff1f\u5982\u679c\u6ca1\u6709\uff0c\u6709\u54ea\u4e9b\u66ff\u4ee3\u65b9\u6848\u53ef\u4ee5\u8bb0\u5f55\u6211\u7684\u6e38\u620f\u6210\u5c31\uff1f", "answer": "Hangman\u6e38\u620f\u662f\u5426\u652f\u6301\u8de8\u5e73\u53f0\u540c\u6b65\u548c\u6570\u636e\u8fc1\u79fb\u53d6\u51b3\u4e8e\u5177\u4f53\u7684\u6e38\u620f\u5b9e\u73b0\u3002\u4e00\u4e9b\u5728\u7ebfHangman\u6e38\u620f\u53ef\u80fd\u4f1a\u4f7f\u7528\u4e91\u5b58\u50a8\u6765\u540c\u6b65\u4f60\u7684\u6e38\u620f\u8fdb\u5ea6\u3002\u5982\u679c\u6ca1\u6709\u5b98\u65b9\u7684\u540c\u6b65\u65b9\u6848\uff0c\u4f60\u53ef\u4ee5\u624b\u52a8\u8bb0\u5f55\u4f60\u7684\u6e38\u620f\u6210\u5c31\uff0c\u4f8b\u5982\u8bb0\u5f55\u4f60\u731c\u5bf9\u7684\u5355\u8bcd\u6570\u91cf\u3001\u82b1\u8d39\u7684\u65f6\u95f4\u7b49\u3002 \u66ff\u4ee3\u65b9\u6848\uff1a\u4f7f\u7528\u622a\u56fe\u3001\u8bb0\u5f55\u3001\u7b2c\u4e09\u65b9\u6570\u636e\u7ba1\u7406\u5de5\u5177\u7b49\u65b9\u6cd5\u6765\u8bb0\u5f55\u6210\u5c31\u3002 \u672a\u6765\u53ef\u4ee5\u8003\u8651\u7edf\u4e00\u4f7f\u7528\u4e91\u670d\u52a1\u5668\u540c\u6b65\u3002"}, {"question": "Hangman\u6e38\u620f\u4e2d\u662f\u5426\u5b58\u5728\u9690\u85cf\u5f69\u86cb\uff1f\u4f8b\u5982\uff0c\u7279\u5b9a\u5355\u8bcd\u7ec4\u5408\u4f1a\u89e6\u53d1\u7279\u6b8a\u52a8\u753b\u6216\u5956\u52b1\u5417\uff1f\u5728\u54ea\u91cc\u53ef\u4ee5\u627e\u5230\u8fd9\u4e9b'\u9690\u85cf\u6b3e'\uff1f", "answer": "Hangman\u6e38\u620f\u4e2d\u662f\u5426\u5305\u542b\u9690\u85cf\u5f69\u86cb\u53d6\u51b3\u4e8e\u6e38\u620f\u5f00\u53d1\u8005\u3002\u4e00\u4e9b\u5f00\u53d1\u8005\u53ef\u80fd\u4f1a\u5728\u6e38\u620f\u4e2d\u52a0\u5165\u4e00\u4e9b\u6709\u8da3\u7684\u5f69\u86cb\uff0c\u4f8b\u5982\uff0c\u5f53\u73a9\u5bb6\u731c\u4e2d\u67d0\u4e2a\u7279\u5b9a\u7684\u5355\u8bcd\u65f6\uff0c\u4f1a\u89e6\u53d1\u7279\u6b8a\u7684\u52a8\u753b\u6216\u97f3\u6548\u3002\u5bfb\u627e\u8fd9\u4e9b\u5f69\u86cb\u7684\u65b9\u6cd5\u5305\u62ec\uff1a\u6d4f\u89c8\u6e38\u620f\u8bba\u575b\u3001\u9605\u8bfb\u6e38\u620f\u653b\u7565\u3001\u4e0e\u5176\u4ed6\u73a9\u5bb6\u4ea4\u6d41\u5206\u4eab\u3002\u4f8b\u5982\uff0c\u6709\u4e9b\u7248\u672c\u7684Hangman\u5728\u731c\u4e2d\u201cEPIC\u201d\u8fd9\u4e2a\u5355\u8bcd\u65f6\u4f1a\u6709\u7279\u6b8a\u52a8\u753b\u3002\u4f60\u53ef\u4ee5\u5c1d\u8bd5\u641c\u7d22'Hangman [\u6e38\u620f\u540d\u79f0] easter eggs'\u6765\u5bfb\u627e\u7ebf\u7d22\u3002"}]
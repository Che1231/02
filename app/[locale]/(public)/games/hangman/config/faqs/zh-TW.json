[{"question": "Hangman\u904a\u6232\u5982\u4f55\u958b\u59cb\uff1f\u4f5c\u70ba\u65b0\u624b\uff0c\u6211\u7684\u7b2c\u4e00\u500b\u5b57\u6bcd\u61c9\u8a72\u731c\u4ec0\u9ebc\uff1f", "answer": "Hangman\u904a\u6232\u958b\u59cb\u975e\u5e38\u7c21\u55ae\uff0c\u555f\u52d5\u904a\u6232\u5f8c\uff0c\u7cfb\u7d71\u6703\u96a8\u6a5f\u9078\u64c7\u4e00\u500b\u55ae\u5b57\uff0c\u4f60\u9700\u8981\u505a\u7684\u5c31\u662f\u958b\u59cb\u731c\u5b57\u6bcd\u3002\u65b0\u624b\u5efa\u8b70\u512a\u5148\u731c\u5e38\u898b\u7684\u6bcd\u97f3\u5b57\u6bcd\uff0c\u4f8b\u5982'E'\u3001'A'\u3001'I'\uff0c\u9019\u4e9b\u5b57\u6bcd\u5728\u82f1\u6587\u55ae\u5b57\u4e2d\u51fa\u73fe\u7684\u983b\u7387\u8f03\u9ad8\uff0c\u80fd\u63d0\u9ad8\u4f60\u731c\u4e2d\u5b57\u6bcd\u7684\u6a5f\u7387\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5148\u731c'E'\uff0c\u767c\u73fe\u55ae\u5b57\u4e2d\u6c92\u6709'E'\uff0c\u90a3\u9ebc\u4f60\u53ef\u4ee5\u5617\u8a66'A'\u3002\u9019\u662f\u4e00\u500b\u9010\u6b65\u7e2e\u5c0f\u53ef\u80fd\u6027\u7684\u904e\u7a0b\u3002"}, {"question": "Why\u5728Hangman\u904a\u6232\u4e2d\uff0c\u731c\u932f\u5b57\u6bcd\u6703\u6709\u4ec0\u9ebc\u61f2\u7f70\uff1f\u61f2\u7f70\u5982\u4f55\u5f71\u97ff\u6211\u7684\u904a\u6232\u7b56\u7565\uff1f", "answer": "\u5728Hangman\u904a\u6232\u4e2d\uff0c\u731c\u932f\u5b57\u6bcd\u6703\u5c0e\u81f4\u7d5e\u5211\u67b6\u9010\u6f38\u7e6a\u88fd\u5b8c\u6210\u3002\u4e00\u822c\u4f86\u8aaa\uff0c\u904a\u6232\u6703\u7d66\u4e88\u4f60\u6709\u9650\u7684\u932f\u8aa4\u6b21\u6578\uff08\u901a\u5e38\u662f6\u6b21\uff09\u3002\u6bcf\u6b21\u731c\u932f\uff0c\u7d5e\u5211\u67b6\u6703\u589e\u52a0\u4e00\u90e8\u5206\uff0c\u76f4\u5230\u7d5e\u5211\u67b6\u5b8c\u5168\u756b\u597d\uff0c\u4f60\u5c31\u8f38\u4e86\u3002\u56e0\u6b64\uff0c\u61f2\u7f70\u7684\u5b58\u5728\u5f37\u70c8\u5f71\u97ff\u4f60\u7684\u904a\u6232\u7b56\u7565\u3002\u4f60\u9700\u8981\u8b39\u614e\u9078\u64c7\u731c\u6e2c\u7684\u5b57\u6bcd\uff0c\u907f\u514d\u76f2\u76ee\u731c\u6e2c\u3002\u4f8b\u5982\uff0c\u7576\u4f60\u53ea\u5269\u4e0b2\u6b21\u6a5f\u6703\u6642\uff0c\u5c31\u61c9\u8a72\u512a\u5148\u8003\u616e\u90a3\u4e9b\u4f60\u9ad8\u5ea6\u78ba\u4fe1\u5b58\u5728\u7684\u5b57\u6bcd\uff0c\u6216\u8005\u6839\u64da\u5df2\u77e5\u7684\u5b57\u6bcd\u7d44\u5408\uff0c\u63a8\u6e2c\u53ef\u80fd\u7684\u55ae\u5b57\u3002"}, {"question": "What\u662fHangman\u4e2d\u907f\u514d\u300c\u7d5e\u5211\u300d\u7684\u6700\u4f73\u7b56\u7565\uff1f\u6709\u6c92\u6709\u9069\u7528\u65bc\u6240\u6709\u9577\u5ea6\u55ae\u5b57\u7684\u901a\u7528\u65b9\u6cd5\uff1f", "answer": "\u907f\u514d\u300c\u7d5e\u5211\u300d\u7684\u95dc\u9375\u5728\u65bc\u63d0\u9ad8\u731c\u6e2c\u7684\u6e96\u78ba\u5ea6\u3002\u6b65\u9a5f\u4e00\uff1a\u512a\u5148\u731c\u5e38\u898b\u7684\u6bcd\u97f3\u5b57\u6bcd\uff08E, A, I, O, U\uff09\u3002\u6b65\u9a5f\u4e8c\uff1a\u89c0\u5bdf\u5df2\u731c\u4e2d\u7684\u5b57\u6bcd\u7d44\u5408\uff0c\u5617\u8a66\u5e38\u898b\u7684\u5b57\u6bcd\u7d44\u5408\uff0c\u4f8b\u5982'TH'\u3001'ST'\u3001'ING'\u7b49\u3002\u6b65\u9a5f\u4e09\uff1a\u6839\u64da\u55ae\u5b57\u7684\u9577\u5ea6\u548c\u5df2\u77e5\u7684\u5b57\u6bcd\uff0c\u7e2e\u5c0f\u55ae\u5b57\u7684\u7bc4\u570d\u3002\u96d6\u7136\u6c92\u6709\u9069\u7528\u65bc\u6240\u6709\u60c5\u6cc1\u7684\u901a\u7528\u65b9\u6cd5\uff0c\u4f46\u4f60\u53ef\u4ee5\u900f\u904e\u7df4\u7fd2\u7d2f\u7a4d\u7d93\u9a57\uff0c\u9010\u6f38\u638c\u63e1\u4e00\u4e9b\u898f\u5f8b\u3002\u4f8b\u5982\uff0c\u5982\u679c\u55ae\u5b57\u5f88\u77ed\uff0c\u53ea\u67093-4\u500b\u5b57\u6bcd\uff0c\u90a3\u9ebc\u5f88\u53ef\u80fd\u662f\u67d0\u4e9b\u5e38\u898b\u7684\u8a5e\u5f59\u3002\u5982\u679c\u55ae\u5b57\u5f88\u9577\uff0c\u90a3\u9ebc\u53ef\u80fd\u662f\u4e00\u4e9b\u5c08\u696d\u8853\u8a9e\u6216\u8907\u5408\u8a5e\u3002\u6bd4\u55bb\u8aaa\u660e\uff1a\u4f60\u53ef\u4ee5\u628aHangman\u60f3\u50cf\u6210\u89e3\u5bc6\u904a\u6232\uff0c\u6bcf\u500b\u731c\u5c0d\u7684\u5b57\u6bcd\u90fd\u662f\u4e00\u500b\u7dda\u7d22\uff0c\u5e6b\u52a9\u4f60\u9010\u6b65\u63ed\u958b\u8b0e\u5e95\u3002"}, {"question": "\u5728Hangman\u4e2d\uff0c\u5982\u4f55\u6839\u64da\u5df2\u77e5\u7684\u5b57\u6bcd\uff0c\u63a8\u65b7\u51fa\u53ef\u80fd\u7684\u55ae\u5b57\uff1f\u6709\u6c92\u6709\u4e00\u4e9b\u6280\u5de7\u53ef\u4ee5\u5229\u7528\uff1f", "answer": "\u6839\u64da\u5df2\u77e5\u7684\u5b57\u6bcd\u63a8\u65b7\u53ef\u80fd\u7684\u55ae\u5b57\u9700\u8981\u4e00\u4e9b\u6280\u5de7\u3002\u9996\u5148\uff0c\u8003\u616e\u5b57\u6bcd\u7684\u4f4d\u7f6e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u55ae\u5b57\u4e2d\u9593\u662f'-A-'\uff0c\u90a3\u9ebc\u53ef\u80fd\u7684\u55ae\u5b57\u6709'BATH'\u3001'PATH'\u3001'MATH'\u7b49\u7b49\u3002\u5176\u6b21\uff0c\u8003\u616e\u55ae\u5b57\u7684\u8a5e\u6027\u3002\u5982\u679c\u53e5\u5b50\u9700\u8981\u4e00\u500b\u540d\u8a5e\uff0c\u90a3\u9ebc\u5c31\u6392\u9664\u52d5\u8a5e\u3002\u6700\u5f8c\uff0c\u5229\u7528\u8a5e\u5178\u6216\u7dda\u4e0a\u8cc7\u6e90\u9032\u884c\u8f14\u52a9\u3002\u8a31\u591a\u7dda\u4e0a\u8a5e\u5178\u5141\u8a31\u4f60\u6839\u64da\u5df2\u77e5\u7684\u5b57\u6bcd\u9032\u884c\u6a21\u7cca\u641c\u5c0b\u3002\u4f8b\u5982\uff0c\u5728Cambridge\u8a5e\u5178\u4e2d\u8f38\u5165'b?t?' \u53ef\u4ee5\u627e\u5230'BATH'\u3001'BAT' \u7b49\u5019\u9078\u8a5e\u5f59\u3002\u914d\u7f6e\u5c0d\u7167\u8868\uff1a[\u55ae\u5b57\u9577\u5ea6|\u5e38\u898b\u8a5e\u6027]\u3002\u53ef\u4ee5\u53c3\u8003\u9019\u500b\u8868\u4f86\u8f14\u52a9\u731c\u6e2c\u904e\u7a0b\u3002"}, {"question": "Hangman\u904a\u6232\u88e1\uff0c\u4e00\u4e9b\u7db2\u7ad9\u6216App\u63d0\u4f9b\u4e86\u4e3b\u984c\u8a5e\u5eab\uff0c\u4f8b\u5982\u52d5\u7269\u3001\u690d\u7269\u3001\u6b77\u53f2\u4eba\u7269\u7b49\u3002\u5982\u4f55\u6709\u6548\u5229\u7528\u9019\u4e9b\u4e3b\u984c\u8a5e\u5eab\u4f86\u63d0\u9ad8\u52dd\u7387\uff1f", "answer": "\u5229\u7528\u4e3b\u984c\u8a5e\u5eab\u7684\u95dc\u9375\u5728\u65bc\u7e2e\u5c0f\u731c\u6e2c\u7bc4\u570d\u3002\u5982\u679c\u904a\u6232\u63d0\u793a\u4e3b\u984c\u662f\u300c\u52d5\u7269\u300d\uff0c\u90a3\u9ebc\u4f60\u61c9\u8a72\u96c6\u4e2d\u7cbe\u529b\u731c\u6e2c\u8207\u52d5\u7269\u76f8\u95dc\u7684\u55ae\u5b57\u3002\u9996\u5148\uff0c\u56de\u61b6\u5e38\u898b\u7684\u52d5\u7269\u540d\u7a31\uff0c\u4f8b\u5982\u300cCAT\u300d\u3001\u300cDOG\u300d\u3001\u300cELEPHANT\u300d\u7b49\u3002\u5176\u6b21\uff0c\u8003\u616e\u7279\u5b9a\u985e\u578b\u7684\u52d5\u7269\uff0c\u4f8b\u5982\u9ce5\u985e\u3001\u9b5a\u985e\u3001\u6606\u87f2\u7b49\u3002\u6700\u5f8c\uff0c\u5982\u679c\u4f60\u5c0d\u67d0\u500b\u4e3b\u984c\u975e\u5e38\u719f\u6089\uff0c\u4f8b\u5982\u4f60\u662f\u4e00\u4f4d\u52d5\u7269\u611b\u597d\u8005\uff0c\u90a3\u9ebc\u4f60\u53ef\u4ee5\u8003\u616e\u4e00\u4e9b\u4e0d\u592a\u5e38\u898b\u7684\u52d5\u7269\u540d\u7a31\u3002\u6d41\u7a0b\u5716\u89e3\uff1a[\u4e3b\u984c\u63d0\u793a] -> [\u56de\u61b6\u5e38\u898b\u8a5e\u5f59] -> [\u8003\u616e\u7279\u5b9a\u985e\u578b] -> [\u731c\u6e2c\u4e0d\u5e38\u898b\u8a5e\u5f59]\u3002\u900f\u904e\u9019\u7a2e\u65b9\u5f0f\uff0c\u4f60\u53ef\u4ee5\u5927\u5927\u63d0\u9ad8\u731c\u6e2c\u7684\u6548\u7387\u3002"}, {"question": "\u9ad8\u7d1aHangman\u73a9\u5bb6\u662f\u5982\u4f55\u5206\u6790\u731c\u6e2c\u983b\u7387\u7684\uff1f\u80fd\u5206\u4eab\u4e00\u4e9b\u9032\u968e\u7684\u5b57\u6bcd\u512a\u5148\u7d1a\u6e05\u55ae\u55ce\uff1f", "answer": "\u9ad8\u7d1a\u73a9\u5bb6\u6703\u6839\u64da\u5b57\u6bcd\u7684\u4f7f\u7528\u983b\u7387\u8abf\u6574\u731c\u6e2c\u7b56\u7565\u3002\u96d6\u7136'E'\u662f\u6700\u5e38\u7528\u7684\u5b57\u6bcd\uff0c\u4f46\u5f8c\u7e8c\u5b57\u6bcd\u7684\u512a\u5148\u7d1a\u6703\u6839\u64da\u8a9e\u6599\u5eab\u7684\u4e0d\u540c\u800c\u6709\u6240\u8b8a\u5316\u3002\u4e00\u7a2e\u5e38\u898b\u7684\u512a\u5148\u7d1a\u6e05\u55ae\u662f\uff1aE-T-A-O-I-N-S-H-R-D-L-C-U-M-W-F-G-P-Y-B-V-K-X-Q-J-Z\u3002\u9019\u500b\u6e05\u55ae\u53ef\u4ee5\u4f5c\u70ba\u53c3\u8003\uff0c\u4f46\u66f4\u91cd\u8981\u7684\u662f\u6839\u64da\u904a\u6232\u4e2d\u7684\u5be6\u969b\u60c5\u6cc1\u9032\u884c\u8abf\u6574\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5df2\u7d93\u731c\u51fa\u4e86'C'\u3001'A'\u3001'T'\u9019\u4e09\u500b\u5b57\u6bcd\uff0c\u90a3\u9ebc\u4e0b\u4e00\u500b\u5b57\u6bcd\u731c'H'\u7684\u6a5f\u7387\u6703\u6bd4\u8f03\u9ad8\uff0c\u56e0\u70ba'CAT'\u52a0\u4e0a'H'\u5f88\u5bb9\u6613\u7d44\u6210'CATCH'\u3002\u591a\u65b9\u6848\u6bd4\u8f03\uff1a[\u50b3\u7d71\u983b\u7387\u8868|\u8a9e\u5883\u983b\u7387\u8abf\u6574|\u500b\u4eba\u7d93\u9a57]\u3002\u7d50\u5408\u9019\u4e09\u9ede\uff0c\u53ef\u4ee5\u5f62\u6210\u4e00\u5957\u9069\u5408\u81ea\u5df1\u7684\u731c\u6e2c\u7b56\u7565\u3002"}, {"question": "Hangman\u7684\u5e95\u5c64\u908f\u8f2f\u662f\u4ec0\u9ebc\uff1f\u55ae\u5b57\u9078\u64c7\u7684\u6f14\u7b97\u6cd5\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f\u662f\u5426\u6709\u53ef\u80fd\u900f\u904e\u5206\u6790\u6f14\u7b97\u6cd5\u63d0\u524d\u9810\u6e2c\u55ae\u5b57\uff1f", "answer": "Hangman\u7684\u5e95\u5c64\u908f\u8f2f\u53d6\u6c7a\u65bc\u5177\u9ad4\u7684\u5be6\u73fe\u3002\u4e00\u822c\u4f86\u8aaa\uff0c\u55ae\u5b57\u9078\u64c7\u7684\u6f14\u7b97\u6cd5\u662f\u4ece\u9810\u5148\u8a2d\u5b9a\u7684\u55ae\u5b57\u6e05\u55ae\u4e2d\u96a8\u6a5f\u9078\u64c7\u7684\u3002\u7c21\u55ae\u7684\u5be6\u73fe\u53ef\u80fd\u53ea\u662f\u4e00\u500b\u96a8\u6a5f\u6578\u751f\u6210\u5668\uff0c\u7528\u4f86\u9078\u64c7\u6e05\u55ae\u4e2d\u7684\u7d22\u5f15\u3002\u66f4\u8907\u96dc\u7684\u5be6\u73fe\u53ef\u80fd\u6703\u8003\u616e\u55ae\u5b57\u7684\u9577\u5ea6\u3001\u96e3\u6613\u5ea6\u7b49\u7d1a\u3001\u4e3b\u984c\u7b49\u56e0\u7d20\u3002\u96d6\u7136\u7406\u8ad6\u4e0a\u53ef\u4ee5\u900f\u904e\u5206\u6790\u6f14\u7b97\u6cd5\u4f86\u9810\u6e2c\u55ae\u5b57\uff0c\u4f46\u5be6\u969b\u4e0a\u975e\u5e38\u56f0\u96e3\uff0c\u56e0\u70ba\u55ae\u5b57\u6e05\u55ae\u901a\u5e38\u5f88\u5927\uff0c\u4e14\u96a8\u6a5f\u6578\u751f\u6210\u5668\u901a\u5e38\u662f\u507d\u96a8\u6a5f\u7684\u3002\u56e0\u6b64\uff0c\u4e0e\u5176\u5617\u8a66\u9810\u6e2c\u55ae\u5b57\uff0c\u4e0d\u5982\u5c08\u6ce8\u65bc\u63d0\u9ad8\u731c\u6e2c\u6280\u5de7\u3002"}, {"question": "Hangman\u7684\u96e3\u6613\u5ea6\u4fc2\u6578\u662f\u5982\u4f55\u8a2d\u5b9a\u7684\uff1f\u662f\u5426\u5b58\u5728\u4e00\u5957\u901a\u7528\u7684\u96e3\u6613\u5ea6\u8a55\u4f30\u6a19\u6e96\uff0c\u53ef\u4ee5\u7528\u4f86\u8861\u91cf\u4e0d\u540cHangman\u904a\u6232\u7684\u96e3\u6613\u7a0b\u5ea6\uff1f", "answer": "Hangman\u7684\u96e3\u6613\u5ea6\u4fc2\u6578\u4e3b\u8981\u53d6\u6c7a\u65bc\u55ae\u5b57\u7684\u9577\u5ea6\u3001\u8907\u96dc\u5ea6\u548c\u7f55\u898b\u7a0b\u5ea6\u3002\u4e00\u822c\u4f86\u8aaa\uff0c\u55ae\u5b57\u8d8a\u9577\u3001\u8d8a\u8907\u96dc\u3001\u8d8a\u7f55\u898b\uff0c\u96e3\u6613\u5ea6\u5c31\u8d8a\u9ad8\u3002\u4e00\u4e9bHangman\u904a\u6232\u6703\u6839\u64da\u55ae\u5b57\u7684\u5e73\u5747\u9577\u5ea6\u6216\u731c\u6e2c\u6b21\u6578\u4f86\u8a2d\u5b9a\u96e3\u6613\u5ea6\u7b49\u7d1a\u3002\u96d6\u7136\u6c92\u6709\u901a\u7528\u7684\u96e3\u6613\u5ea6\u8a55\u4f30\u6a19\u6e96\uff0c\u4f46\u4f60\u53ef\u4ee5\u900f\u904e\u6bd4\u8f03\u4e0d\u540c\u904a\u6232\u7684\u55ae\u5b57\u6e05\u55ae\u548c\u731c\u6e2c\u6b21\u6578\u4f86\u8861\u91cf\u5176\u96e3\u6613\u7a0b\u5ea6\u3002\u53e6\u5916\uff0c\u4e00\u4e9b\u904a\u6232\u6703\u52a0\u5165\u4e3b\u984c\u9650\u5236\uff0c\u4e5f\u6703\u5f71\u97ff\u96e3\u6613\u5ea6\uff0c\u4f8b\u5982\u53ea\u4f7f\u7528\u5c08\u696d\u8853\u8a9e\u7684Hangman\u6703\u66f4\u96e3\u3002 \u6bd4\u55bb\u8aaa\u660e\uff1a\u96e3\u6613\u5ea6\u8abf\u6574\u5c31\u50cf\u70f9\u98ea\u6642\u8abf\u6574\u98df\u6750\u548c\u706b\u5019\uff0c\u9700\u8981\u6839\u64da\u4e0d\u540c\u300c\u83dc\u54c1\u300d\u9078\u64c7\u5408\u9069\u7684\u300c\u914d\u65b9\u300d\u3002"}, {"question": "\u5982\u679c\u6211\u5728\u4e0d\u540c\u88dd\u7f6e\u4e0a\u73a9Hangman\uff0c\u904a\u6232\u9032\u5ea6\u53ef\u4ee5\u540c\u6b65\u55ce\uff1f\u662f\u5426\u5b58\u5728\u8de8\u5e73\u53f0\u7684\u8cc7\u6599\u9077\u79fb\u65b9\u6848\uff1f\u5982\u679c\u6c92\u6709\uff0c\u6709\u54ea\u4e9b\u66ff\u4ee3\u65b9\u6848\u53ef\u4ee5\u8a18\u9304\u6211\u7684\u904a\u6232\u6210\u5c31\uff1f", "answer": "Hangman\u904a\u6232\u662f\u5426\u652f\u63f4\u8de8\u5e73\u53f0\u540c\u6b65\u548c\u8cc7\u6599\u9077\u79fb\u53d6\u6c7a\u65bc\u5177\u9ad4\u7684\u904a\u6232\u5be6\u73fe\u3002\u4e00\u4e9b\u7dda\u4e0aHangman\u904a\u6232\u53ef\u80fd\u6703\u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u4f86\u540c\u6b65\u4f60\u7684\u904a\u6232\u9032\u5ea6\u3002\u5982\u679c\u6c92\u6709\u5b98\u65b9\u7684\u540c\u6b65\u65b9\u6848\uff0c\u4f60\u53ef\u4ee5\u624b\u52d5\u8a18\u9304\u4f60\u7684\u904a\u6232\u6210\u5c31\uff0c\u4f8b\u5982\u8a18\u9304\u4f60\u731c\u5c0d\u7684\u55ae\u5b57\u6578\u91cf\u3001\u82b1\u8cbb\u7684\u6642\u9593\u7b49\u3002 \u66ff\u4ee3\u65b9\u6848\uff1a\u4f7f\u7528\u622a\u5716\u3001\u8a18\u9304\u3001\u7b2c\u4e09\u65b9\u8cc7\u6599\u7ba1\u7406\u5de5\u5177\u7b49\u65b9\u6cd5\u4f86\u8a18\u9304\u6210\u5c31\u3002 \u672a\u4f86\u53ef\u4ee5\u8003\u616e\u7d71\u4e00\u4f7f\u7528\u96f2\u7aef\u4f3a\u670d\u5668\u540c\u6b65\u3002"}, {"question": "Hangman\u904a\u6232\u4e2d\u662f\u5426\u5b58\u5728\u96b1\u85cf\u5f69\u86cb\uff1f\u4f8b\u5982\uff0c\u7279\u5b9a\u55ae\u5b57\u7d44\u5408\u6703\u89f8\u767c\u7279\u6b8a\u52d5\u756b\u6216\u734e\u52f5\u55ce\uff1f\u5728\u54ea\u88e1\u53ef\u4ee5\u627e\u5230\u9019\u4e9b\u300c\u96b1\u85cf\u6b3e\u300d\uff1f", "answer": "Hangman\u904a\u6232\u4e2d\u662f\u5426\u5b58\u5728\u96b1\u85cf\u5f69\u86cb\u53d6\u6c7a\u65bc\u904a\u6232\u958b\u767c\u8005\u3002\u4e00\u4e9b\u958b\u767c\u8005\u53ef\u80fd\u6703\u5728\u904a\u6232\u4e2d\u52a0\u5165\u4e00\u4e9b\u6709\u8da3\u7684\u5f69\u86cb\uff0c\u4f8b\u5982\uff0c\u7576\u73a9\u5bb6\u731c\u4e2d\u67d0\u500b\u7279\u5b9a\u7684\u55ae\u5b57\u6642\uff0c\u6703\u89f8\u767c\u7279\u6b8a\u7684\u52d5\u756b\u6216\u97f3\u6548\u3002\u5c0b\u627e\u9019\u4e9b\u5f69\u86cb\u7684\u65b9\u6cd5\u5305\u62ec\uff1a\u700f\u89bd\u904a\u6232\u8ad6\u58c7\u3001\u95b1\u8b80\u904a\u6232\u653b\u7565\u3001\u8207\u5176\u4ed6\u73a9\u5bb6\u4ea4\u6d41\u5206\u4eab\u3002\u4f8b\u5982\uff0c\u6709\u4e9b\u7248\u672c\u7684Hangman\u5728\u731c\u4e2d\u300cEPIC\u300d\u9019\u500b\u55ae\u5b57\u6642\u6703\u6709\u7279\u6b8a\u52d5\u756b\u3002\u4f60\u53ef\u4ee5\u5617\u8a66\u641c\u5c0b'Hangman [\u904a\u6232\u540d\u7a31] easter eggs'\u4f86\u5c0b\u627e\u7dda\u7d22\u3002"}]
[{"question": "\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u5feb\u901f\u638c\u63e1\u300a\u67aa\u6797\u5f39\u96e8\u91cd\u5236\u7248\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1\u300a\u67aa\u6797\u5f39\u96e8\u91cd\u5236\u7248\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u719f\u6089\u79fb\u52a8\u952e\uff08WASD\u6216\u65b9\u5411\u952e\uff09\u548c\u8df3\u8dc3\u952e\uff08\u7a7a\u683c\u952e\uff09\u3002\u6b65\u9aa42 - \u7ec3\u4e60\u4f7f\u7528\u5de6\u9f20\u6807\u952e\u5c04\u51fb\u548cR\u952e\u88c5\u586b\u5f39\u836f\u3002\u6b65\u9aa43 - \u5c1d\u8bd5\u4f7f\u7528\u4e0d\u540c\u7684\u6b66\u5668\uff0c\u4f8b\u5982\u8fd1\u6218\u7684\u6563\u5f39\u67aa\u548c\u8fdc\u7a0b\u7cbe\u786e\u72d9\u51fb\u6b65\u67aa\u3002\u4f8b\u5982\uff0c\u5728\u8fd1\u8ddd\u79bb\u4f7f\u7528\u6563\u5f39\u67aa\u53ef\u4ee5\u8fc5\u901f\u6d88\u706d\u654c\u4eba\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u64cd\u4f5c\u60f3\u8c61\u6210\u5b66\u4e60\u5f00\u8f66\uff1b\u4e00\u65e6\u638c\u63e1\u4e86\u57fa\u7840\uff0c\u5176\u4f59\u90e8\u5206\u5c31\u53d8\u5f97\u76f4\u89c2\u6613\u61c2\u4e86\u3002]"}, {"question": "\u9ad8\u7ea7\u73a9\u5bb6\u5728\u300a\u67aa\u6797\u5f39\u96e8\u91cd\u5236\u7248\u300b\u4e2d\u53d6\u5f97\u7edf\u6cbb\u5730\u4f4d\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u9ad8\u7ea7\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u4ee5\u4e0b\u7b56\u7565\u5728\u300a\u67aa\u6797\u5f39\u96e8\u91cd\u5236\u7248\u300b\u4e2d\u53d6\u5f97\u7edf\u6cbb\u5730\u4f4d\uff1a\u6b65\u9aa41 - \u638c\u63e1\u8eb2\u95ea\u548c\u7a7f\u68ad\u6280\u5de7\uff0c\u4ee5\u907f\u5f00\u654c\u4eba\u7684\u653b\u51fb\u3002\u6b65\u9aa42 - \u5145\u5206\u5229\u7528\u73af\u5883\u4f18\u52bf\uff0c\u4f8b\u5982\u5229\u7528\u5e73\u53f0\u83b7\u5f97\u66f4\u9ad8\u7684\u4f4d\u7f6e\u548c\u66f4\u597d\u7684\u89d2\u5ea6\u3002\u6b65\u9aa43 - \u7cbe\u786e\u638c\u63e1\u53cc\u500d\u4f24\u5bb3\u6216\u751f\u547d\u6062\u590d\u7b49\u80fd\u529b\u7684\u65f6\u673a\u3002\u4f8b\u5982\uff0c\u5728\u7cbe\u786e\u7684\u72d9\u51fb\u5c04\u51fb\u4e2d\u914d\u5408\u53cc\u500d\u4f24\u5bb3\u80fd\u529b\uff0c\u53ef\u4ee5\u626d\u8f6c\u6218\u5c40\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u8eb2\u95ea\u5c31\u50cf\u4e0b\u68cb\u4e00\u6837\uff1b\u63d0\u524d\u9884\u6d4b\u5bf9\u624b\u7684\u884c\u52a8\u5e76\u6709\u6548\u53cd\u51fb\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u5728\u300a\u67aa\u6797\u5f39\u96e8\u91cd\u5236\u7248\u300b\u4e2d\u7406\u89e3\u6b66\u5668\u673a\u5236\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u5728\u300a\u67aa\u6797\u5f39\u96e8\u91cd\u5236\u7248\u300b\u4e2d\u7406\u89e3\u6b66\u5668\u673a\u5236\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u4f7f\u73a9\u5bb6\u80fd\u591f\u5728\u6218\u6597\u4e2d\u505a\u51fa\u660e\u667a\u7684\u51b3\u7b56\u3002\u6bcf\u79cd\u6b66\u5668\u90fd\u6709\u72ec\u7279\u7684\u5c5e\u6027\uff0c\u4f8b\u5982\u5c04\u901f\u3001\u4f24\u5bb3\u548c\u5c04\u7a0b\u3002\u4f8b\u5982\uff0c\u6563\u5f39\u67aa\u5728\u8fd1\u8ddd\u79bb\u6218\u6597\u4e2d\u8868\u73b0\u51fa\u8272\uff0c\u4f46\u5728\u8fdc\u8ddd\u79bb\u5219\u6548\u679c\u8f83\u5dee\u3002\u901a\u8fc7\u4e86\u89e3\u8fd9\u4e9b\u673a\u5236\uff0c\u73a9\u5bb6\u53ef\u4ee5\u6839\u636e\u4e0d\u540c\u7684\u60c5\u51b5\u9009\u62e9\u5408\u9002\u7684\u6b66\u5668\uff0c\u4ece\u800c\u63d0\u5347\u6574\u4f53\u6027\u80fd\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6563\u5f39\u67aa - \u9ad8\u4f24\u5bb3\uff0c\u77ed\u5c04\u7a0b\uff1b\u72d9\u51fb\u6b65\u67aa - \u4f4e\u5c04\u901f\uff0c\u957f\u5c04\u7a0b\u3002]"}, {"question": "\u300a\u67aa\u6797\u5f39\u96e8\u91cd\u5236\u7248\u300b\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u73a9\u5bb6\u5982\u4f55\u6700\u5927\u5316\u5f97\u5206\uff1f", "answer": "\u300a\u67aa\u6797\u5f39\u96e8\u91cd\u5236\u7248\u300b\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u6d88\u706d\u5bf9\u624b\u548c\u5b8c\u6210\u4efb\u52a1\u3002\u73a9\u5bb6\u6bcf\u51fb\u6740\u4e00\u540d\u654c\u4eba\u90fd\u4f1a\u83b7\u5f97\u5206\u6570\uff0c\u51fb\u4e2d\u5934\u90e8\u6216\u4f7f\u7528\u7279\u5b9a\u6b66\u5668\u8fd8\u4f1a\u989d\u5916\u52a0\u5206\u3002\u4e3a\u4e86\u6700\u5927\u5316\u5f97\u5206\uff0c\u8bf7\u4e13\u6ce8\u4e8e\u51c6\u786e\u6027\u548c\u6548\u7387\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u72d9\u51fb\u6b65\u67aa\u51fb\u4e2d\u5934\u90e8\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u5f97\u5206\u3002\u6b64\u5916\uff0c\u5b8c\u6210\u989d\u5916\u4efb\u52a1\uff0c\u4f8b\u5982\u751f\u5b58\u6ce2\u6d6a\u5f0f\u654c\u4eba\u653b\u51fb\uff0c\u4e5f\u80fd\u83b7\u5f97\u989d\u5916\u5206\u6570\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u5f97\u5206\u60f3\u8c61\u6210\u6bd4\u8d5b\uff1b\u4f60\u5b8c\u6210\u4efb\u52a1\u7684\u901f\u5ea6\u548c\u51c6\u786e\u6027\u8d8a\u9ad8\uff0c\u5f97\u5206\u5c31\u8d8a\u9ad8\u3002]"}, {"question": "\u300a\u67aa\u6797\u5f39\u96e8\u91cd\u5236\u7248\u300b\u5404\u79cd\u6e38\u620f\u6a21\u5f0f\u4e4b\u95f4\u7684\u4e3b\u8981\u533a\u522b\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u67aa\u6797\u5f39\u96e8\u91cd\u5236\u7248\u300b\u63d0\u4f9b\u591a\u79cd\u6e38\u620f\u6a21\u5f0f\uff0c\u6bcf\u4e2a\u6a21\u5f0f\u90fd\u6709\u72ec\u7279\u7684\u6311\u6218\u3002\u6218\u5f79\u6a21\u5f0f\u63d0\u4f9b\u9010\u6b65\u63d0\u5347\u7684\u96be\u5ea6\u3002\u751f\u5b58\u6a21\u5f0f\u8003\u9a8c\u73a9\u5bb6\u7684\u8010\u529b\uff0c\u5bf9\u6297\u65e0\u4f11\u6b62\u7684\u654c\u6d6a\u3002\u5bf9\u6218\u6a21\u5f0f\u8ba9\u73a9\u5bb6\u76f8\u4e92\u7ade\u4e89\u3002\u4f8b\u5982\uff0c\u5728\u751f\u5b58\u6a21\u5f0f\u4e2d\uff0c\u73a9\u5bb6\u5fc5\u987b\u5e73\u8861\u8fdb\u653b\u548c\u9632\u5fa1\uff0c\u4ee5\u5c3d\u53ef\u80fd\u957f\u65f6\u95f4\u5730\u751f\u5b58\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u6218\u5f79\u5c31\u50cf\u9a6c\u62c9\u677e\uff0c\u800c\u751f\u5b58\u5c31\u50cf\u77ed\u8dd1\uff1b\u4e24\u8005\u90fd\u9700\u8981\u4e0d\u540c\u7684\u7b56\u7565\u3002]"}, {"question": "\u300a\u67aa\u6797\u5f39\u96e8\u91cd\u5236\u7248\u300b\u4e2d\u54ea\u4e9b\u6b66\u5668\u88ab\u8ba4\u4e3a\u662f\u6700\u5f3a\u5927\u7684\uff0c\u4e3a\u4ec0\u4e48\uff1f", "answer": "\u300a\u67aa\u6797\u5f39\u96e8\u91cd\u5236\u7248\u300b\u4e2d\u5a01\u529b\u6700\u5f3a\u5927\u7684\u6b66\u5668\u901a\u5e38\u662f\u90a3\u4e9b\u5177\u6709\u9ad8\u4f24\u5bb3\u8f93\u51fa\u548c\u591a\u529f\u80fd\u6027\u7684\u6b66\u5668\u3002\u4f8b\u5982\uff0c\u706b\u7bad\u7b52\u4f1a\u9020\u6210\u5de8\u5927\u7684\u8303\u56f4\u4f24\u5bb3\uff0c\u4f46\u88c5\u586b\u901f\u5ea6\u5f88\u6162\u3002\u5fae\u578b\u673a\u67aa\u63d0\u4f9b\u6301\u7eed\u7684\u706b\u529b\uff0c\u4f46\u4f1a\u8fc7\u70ed\u3002\u73a9\u5bb6\u901a\u5e38\u66f4\u559c\u6b22\u706b\u7bad\u7b52\uff0c\u56e0\u4e3a\u5b83\u53ef\u4ee5\u4e00\u6b21\u6e05\u9664\u591a\u540d\u654c\u4eba\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u706b\u7bad\u7b52 - \u9ad8\u4f24\u5bb3\uff0c\u6162\u88c5\u586b\uff1b\u5fae\u578b\u673a\u67aa - \u6301\u7eed\u706b\u529b\uff0c\u8fc7\u70ed\u98ce\u9669\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u67aa\u6797\u5f39\u96e8\u91cd\u5236\u7248\u300b\u4e2d\u6709\u6548\u5730\u4f7f\u7528\u80fd\u529b\u63d0\u5347\u6765\u83b7\u5f97\u4f18\u52bf\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u6218\u7565\u6027\u5730\u63a7\u5236\u80fd\u529b\u63d0\u5347\u7684\u4f7f\u7528\u65f6\u673a\u6765\u6709\u6548\u5730\u4f7f\u7528\u300a\u67aa\u6797\u5f39\u96e8\u91cd\u5236\u7248\u300b\u4e2d\u7684\u80fd\u529b\u63d0\u5347\u3002\u6b65\u9aa41 - \u8bc6\u522b\u80fd\u529b\u63d0\u5347\uff0c\u4f8b\u5982\u53cc\u500d\u4f24\u5bb3\u6216\u751f\u547d\u6062\u590d\u3002\u6b65\u9aa42 - \u5728\u5408\u9002\u7684\u65f6\u673a\u6fc0\u6d3b\u5b83\uff0c\u4f8b\u5982\u5728\u4e0e\u654c\u4ebaBOSS\u6218\u6597\u6216\u88ab\u654c\u4eba\u5305\u56f4\u65f6\u3002\u6b65\u9aa43 - \u7ed3\u5408\u4f7f\u7528\u80fd\u529b\u63d0\u5347\u4ee5\u8fbe\u5230\u6700\u5927\u6548\u679c\uff0c\u4f8b\u5982\u5c06\u53cc\u500d\u4f24\u5bb3\u4e0e\u9ad8\u4f24\u5bb3\u6b66\u5668\u76f8\u7ed3\u5408\u3002\u4f8b\u5982\uff0c\u7528\u706b\u7bad\u7b52\u6fc0\u6d3b\u53cc\u500d\u4f24\u5bb3\u53ef\u4ee5\u5927\u91cf\u6d88\u706d\u654c\u4eba\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u8bc6\u522b -> \u6fc0\u6d3b -> \u7ed3\u5408 -> \u638c\u63a7\u3002]"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u8fd0\u884c\u300a\u67aa\u6797\u5f39\u96e8\u91cd\u5236\u7248\u300b\u7684\u7cfb\u7edf\u8981\u6c42\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u67aa\u6797\u5f39\u96e8\u91cd\u5236\u7248\u300b\u7684\u7cfb\u7edf\u8981\u6c42\u9002\u4e2d\uff0c\u4f7f\u5176\u80fd\u591f\u5728\u5404\u79cd\u5e73\u53f0\u4e0a\u8fd0\u884c\u3002\u5bf9\u4e8ePC\uff0c\u5b83\u81f3\u5c11\u9700\u8981\u53cc\u6838\u5904\u7406\u5668\u30012GB\u5185\u5b58\u548c\u652f\u6301DirectX 9\u7684\u663e\u5361\u3002\u5728\u79fb\u52a8\u7aef\uff0c\u5b83\u53ef\u4ee5\u5728\u8fd0\u884cAndroid 4.4\u6216iOS 9\u53ca\u4ee5\u4e0a\u7248\u672c\u7684\u8bbe\u5907\u4e0a\u6d41\u7545\u8fd0\u884c\u3002\u4f8b\u5982\uff0c2018\u5e74\u5de6\u53f3\u7684\u4e2d\u7aef\u667a\u80fd\u624b\u673a\u53ef\u4ee5\u6beb\u65e0\u95ee\u9898\u5730\u8fd0\u884c\u8fd9\u6b3e\u6e38\u620f\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1aPC - \u53cc\u6838\u5904\u7406\u5668\uff0c2GB\u5185\u5b58\uff1b\u79fb\u52a8\u7aef - Android 4.4/iOS 9\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u67aa\u6797\u5f39\u96e8\u91cd\u5236\u7248\u300b\u4e2d\u89e3\u9501\u9690\u85cf\u89d2\u8272\u548c\u5173\u5361\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u5b8c\u6210\u7279\u5b9a\u7684\u6311\u6218\u6216\u627e\u5230\u79d8\u5bc6\u533a\u57df\u6765\u89e3\u9501\u300a\u67aa\u6797\u5f39\u96e8\u91cd\u5236\u7248\u300b\u4e2d\u7684\u9690\u85cf\u89d2\u8272\u548c\u5173\u5361\u3002\u4f8b\u5982\uff0c\u5728\u6218\u5f79\u6a21\u5f0f\u4e2d\u51fb\u8d25\u4e00\u5b9a\u6570\u91cf\u7684\u654c\u4eba\u53ef\u80fd\u4f1a\u89e3\u9501\u65b0\u89d2\u8272\u3002\u63a2\u7d22\u5173\u5361\u7684\u6bcf\u4e00\u4e2a\u89d2\u843d\u53ef\u80fd\u4f1a\u53d1\u73b0\u901a\u5f80\u79d8\u5bc6\u5173\u5361\u7684\u9690\u85cf\u5165\u53e3\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u89e3\u9501\u9690\u85cf\u5185\u5bb9\u5c31\u50cf\u89e3\u8c1c\uff1b\u4f60\u627e\u5230\u7684\u6bcf\u4e00\u5757\u788e\u7247\u90fd\u4f7f\u4f60\u66f4\u63a5\u8fd1\u5b8c\u6574\u7684\u56fe\u666f\u3002]"}, {"question": "\u5728\u300a\u67aa\u6797\u5f39\u96e8\u91cd\u5236\u7248\u300b\u7684\u5bf9\u6218\u6a21\u5f0f\u4e2d\uff0c\u54ea\u4e9b\u662f\u8d62\u5f97\u6bd4\u8d5b\u7684\u6700\u6709\u6548\u7b56\u7565\uff1f", "answer": "\u5728\u300a\u67aa\u6797\u5f39\u96e8\u91cd\u5236\u7248\u300b\u7684\u5bf9\u6218\u6a21\u5f0f\u4e2d\u53d6\u80dc\u9700\u8981\u7ed3\u5408\u7b56\u7565\u548c\u6280\u5de7\u3002\u6b65\u9aa41 - \u9009\u62e9\u9002\u5408\u4f60\u7684\u6e38\u620f\u98ce\u683c\u7684\u89d2\u8272\u548c\u6b66\u5668\u3002\u6b65\u9aa42 - \u901a\u8fc7\u8ba9\u81ea\u5df1\u5904\u4e8e\u6709\u5229\u4f4d\u7f6e\u6765\u63a7\u5236\u5730\u56fe\u3002\u6b65\u9aa43 - \u6709\u6548\u9884\u6d4b\u4f60\u7684\u5bf9\u624b\u7684\u884c\u52a8\u5e76\u53cd\u51fb\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u79fb\u52a8\u6027\u9ad8\u7684\u89d2\u8272\u53ef\u4ee5\u5e2e\u52a9\u4f60\u7075\u6d3b\u5730\u8eb2\u907f\u8f83\u6162\u7684\u5bf9\u624b\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u673a\u52a8\u6027\u4e0e\u529b\u91cf\uff1b\u6839\u636e\u5bf9\u624b\u7684\u5f31\u70b9\u9009\u62e9\u3002]"}]
[{"question": "\u5982\u4f55\u8b93\u65b0\u73a9\u5bb6\u5feb\u901f\u638c\u63e1\u300a\u69cd\u6230\u72c2\u6f6e Redux\u300b\u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1\u300a\u69cd\u6230\u72c2\u6f6e Redux\u300b\u7684\u57fa\u672c\u63a7\u5236\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u719f\u6089\u79fb\u52d5\u9375 (WASD \u6216\u65b9\u5411\u9375) \u548c\u8df3\u8e8d\u9375 (\u7a7a\u683c\u9375)\u3002\u6b65\u9a5f2 - \u7df4\u7fd2\u4f7f\u7528\u5de6\u9375\u5c04\u64ca\u548c\u4f7f\u7528 R \u9375\u88dd\u586b\u5f48\u85e5\u3002\u6b65\u9a5f3 - \u5617\u8a66\u4e0d\u540c\u6b66\u5668\uff0c\u4f8b\u5982\u8fd1\u8ddd\u96e2\u7684\u6563\u5f48\u69cd\u548c\u9060\u8ddd\u96e2\u7684\u72d9\u64ca\u69cd\u3002\u4f8b\u5982\uff0c\u5728\u8fd1\u8ddd\u96e2\u6230\u9b25\u4e2d\u4f7f\u7528\u6563\u5f48\u69cd\u53ef\u4ee5\u5feb\u901f\u6d88\u6ec5\u6575\u4eba\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u9019\u4e9b\u63a7\u5236\u9375\u60f3\u50cf\u6210\u5b78\u7fd2\u99d5\u99db\uff1b\u4e00\u65e6\u638c\u63e1\u4e86\u57fa\u672c\u6982\u5ff5\uff0c\u5176\u9918\u90e8\u5206\u5c31\u6703\u8b8a\u5f97\u76f4\u89c0\u3002]"}, {"question": "\u9032\u968e\u73a9\u5bb6\u5728\u300a\u69cd\u6230\u72c2\u6f6e Redux\u300b\u4e2d\u53d6\u5f97\u512a\u52e2\u7684\u6700\u4f73\u7b56\u7565\u70ba\u4f55\uff1f", "answer": "\u9032\u968e\u73a9\u5bb6\u5728\u300a\u69cd\u6230\u72c2\u6f6e Redux\u300b\u4e2d\u53ef\u4ee5\u900f\u904e\u4ee5\u4e0b\u7b56\u7565\u53d6\u5f97\u512a\u52e2\uff1a\u6b65\u9a5f1 - \u638c\u63e1\u8eb2\u907f\u548c\u9583\u907f\u6575\u706b\u6280\u5de7\u3002\u6b65\u9a5f2 - \u5145\u5206\u5229\u7528\u74b0\u5883\uff0c\u4f8b\u5982\u4f7f\u7528\u5e73\u53f0\u7372\u5f97\u66f4\u9ad8\u7684\u4f4d\u7f6e\u548c\u66f4\u597d\u7684\u89d2\u5ea6\u3002\u6b65\u9a5f3 - \u7cbe\u6e96\u638c\u63a7\u50cf\u96d9\u500d\u50b7\u5bb3\u6216\u751f\u547d\u6062\u5fa9\u7b49\u589e\u76ca\u6548\u679c\u7684\u6642\u9593\u3002\u4f8b\u5982\uff0c\u5728\u7cbe\u6e96\u7684\u72d9\u64ca\u69cd\u5c04\u64ca\u6642\u904b\u7528\u96d9\u500d\u50b7\u5bb3\u589e\u76ca\u6548\u679c\uff0c\u80fd\u5920\u626d\u8f49\u6230\u5c40\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u8eb2\u907f\u5c31\u50cf\u4e0b\u68cb\uff1b\u9810\u6e2c\u5c0d\u624b\u52d5\u4f5c\u4e26\u6709\u6548\u53cd\u5236\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u4e86\u89e3\u6b66\u5668\u6a5f\u5236\u5728\u300a\u69cd\u6230\u72c2\u6f6e Redux\u300b\u4e2d\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u5728\u300a\u69cd\u6230\u72c2\u6f6e Redux\u300b\u4e2d\u4e86\u89e3\u6b66\u5668\u6a5f\u5236\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u8b93\u73a9\u5bb6\u80fd\u5728\u6230\u9b25\u4e2d\u505a\u51fa\u660e\u667a\u7684\u6c7a\u5b9a\u3002\u6bcf\u7a2e\u6b66\u5668\u90fd\u6709\u7368\u7279\u7684\u5c6c\u6027\uff0c\u4f8b\u5982\u5c04\u901f\u3001\u50b7\u5bb3\u548c\u5c04\u7a0b\u3002\u4f8b\u5982\uff0c\u6563\u5f48\u69cd\u5728\u8fd1\u8ddd\u96e2\u6230\u9b25\u4e2d\u8868\u73fe\u51fa\u8272\uff0c\u4f46\u5728\u9060\u8ddd\u96e2\u5247\u6548\u679c\u8f03\u5dee\u3002\u900f\u904e\u4e86\u89e3\u9019\u4e9b\u6a5f\u5236\uff0c\u73a9\u5bb6\u53ef\u4ee5\u70ba\u6bcf\u7a2e\u60c5\u6cc1\u9078\u64c7\u6b63\u78ba\u7684\u6b66\u5668\uff0c\u63d0\u5347\u6574\u9ad4\u8868\u73fe\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u6563\u5f48\u69cd - \u9ad8\u50b7\u5bb3\uff0c\u77ed\u5c04\u7a0b\uff1b\u72d9\u64ca\u69cd - \u4f4e\u5c04\u901f\uff0c\u9577\u5c04\u7a0b\u3002]"}, {"question": "\u300a\u69cd\u6230\u72c2\u6f6e Redux\u300b\u7684\u5f97\u5206\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff0c\u4ee5\u53ca\u73a9\u5bb6\u5982\u4f55\u6700\u5927\u5316\u5f97\u5206\uff1f", "answer": "\u300a\u69cd\u6230\u72c2\u6f6e Redux\u300b\u7684\u5f97\u5206\u7cfb\u7d71\u57fa\u65bc\u64ca\u6bba\u6575\u4eba\u548c\u5b8c\u6210\u76ee\u6a19\u3002\u73a9\u5bb6\u6bcf\u64ca\u6bba\u4e00\u6b21\u6575\u4eba\u5c31\u6703\u7372\u5f97\u5206\u6578\uff0c\u64ca\u4e2d\u982d\u90e8\u6216\u4f7f\u7528\u7279\u5b9a\u6b66\u5668\u5c07\u7372\u5f97\u984d\u5916\u734e\u52f5\u3002\u70ba\u6700\u5927\u5316\u5f97\u5206\uff0c\u8acb\u5c08\u6ce8\u65bc\u6e96\u78ba\u6027\u548c\u6548\u7387\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u72d9\u64ca\u69cd\u64ca\u4e2d\u6575\u4eba\u7684\u982d\u90e8\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u60a8\u7684\u5f97\u5206\u3002\u6b64\u5916\uff0c\u5b8c\u6210\u984d\u5916\u76ee\u6a19\uff0c\u4f8b\u5982\u751f\u5b58\u6575\u4eba\u7684\u6ce2\u6b21\u653b\u64ca\uff0c\u4e5f\u80fd\u7372\u5f97\u984d\u5916\u5206\u6578\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u5f97\u5206\u60f3\u50cf\u6210\u6bd4\u8cfd\uff1b\u60a8\u5b8c\u6210\u4efb\u52d9\u7684\u901f\u5ea6\u548c\u6e96\u78ba\u5ea6\u8d8a\u9ad8\uff0c\u5f97\u5206\u5c31\u8d8a\u9ad8\u3002]"}, {"question": "\u300a\u69cd\u6230\u72c2\u6f6e Redux\u300b\u4e2d\u4e0d\u540c\u904a\u6232\u6a21\u5f0f\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u70ba\u4f55\uff1f", "answer": "\u300a\u69cd\u6230\u72c2\u6f6e Redux\u300b\u63d0\u4f9b\u591a\u7a2e\u904a\u6232\u6a21\u5f0f\uff0c\u6bcf\u500b\u6a21\u5f0f\u90fd\u6709\u7368\u7279\u7684\u6311\u6230\u3002\u5287\u60c5\u6a21\u5f0f\u63d0\u4f9b\u9010\u6b65\u63d0\u5347\u7684\u96e3\u5ea6\u3002\u751f\u5b58\u6a21\u5f0f\u5247\u8003\u9a57\u73a9\u5bb6\u5728\u9762\u5c0d\u7121\u76e1\u6575\u4eba\u6ce2\u6b21\u7684\u8010\u529b\u3002\u5c0d\u6230\u6a21\u5f0f\u5247\u8b93\u73a9\u5bb6\u4e92\u76f8\u7af6\u722d\u3002\u4f8b\u5982\uff0c\u5728\u751f\u5b58\u6a21\u5f0f\u4e2d\uff0c\u73a9\u5bb6\u5fc5\u9808\u5728\u9032\u653b\u548c\u9632\u5b88\u4e4b\u9593\u53d6\u5f97\u5e73\u8861\uff0c\u4ee5\u7dad\u6301\u751f\u5b58\u6642\u9593\u8d8a\u4e45\u8d8a\u597d\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u5287\u60c5\u6a21\u5f0f\u5c31\u50cf\u99ac\u62c9\u677e\uff0c\u800c\u751f\u5b58\u6a21\u5f0f\u5c31\u50cf\u77ed\u8dd1\uff1b\u5169\u8005\u90fd\u8981\u6c42\u4e0d\u540c\u7684\u7b56\u7565\u3002]"}, {"question": "\u300a\u69cd\u6230\u72c2\u6f6e Redux\u300b\u4e2d\u6700\u5f37\u5927\u7684\u6b66\u5668\u70ba\u4f55\uff0c\u4ee5\u53ca\u539f\u56e0\u70ba\u4f55\uff1f", "answer": "\u300a\u69cd\u6230\u72c2\u6f6e Redux\u300b\u4e2d\u6700\u5f37\u5927\u7684\u6b66\u5668\u901a\u5e38\u662f\u90a3\u4e9b\u5177\u6709\u9ad8\u50b7\u5bb3\u8f38\u51fa\u548c\u591a\u529f\u80fd\u6027\u7684\u6b66\u5668\u3002\u4f8b\u5982\uff0c\u706b\u7bad\u767c\u5c04\u5668\u53ef\u4ee5\u9020\u6210\u5de8\u5927\u7684\u7bc4\u570d\u50b7\u5bb3\uff0c\u4f46\u88dd\u586b\u6642\u9593\u8f03\u6162\u3002\u6a5f\u69cd\u63d0\u4f9b\u6301\u7e8c\u7684\u706b\u529b\uff0c\u4f46\u5bb9\u6613\u904e\u71b1\u3002\u73a9\u5bb6\u901a\u5e38\u66f4\u9752\u775e\u706b\u7bad\u767c\u5c04\u5668\uff0c\u56e0\u70ba\u5b83\u53ef\u4ee5\u4e00\u6b21\u6027\u6e05\u9664\u591a\u500b\u6575\u4eba\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u706b\u7bad\u767c\u5c04\u5668 - \u9ad8\u50b7\u5bb3\uff0c\u88dd\u586b\u6642\u9593\u6162\uff1b\u6a5f\u69cd - \u6301\u7e8c\u706b\u529b\uff0c\u5bb9\u6613\u904e\u71b1\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u69cd\u6230\u72c2\u6f6e Redux\u300b\u4e2d\u6709\u6548\u5730\u4f7f\u7528\u589e\u76ca\u6548\u679c\u4f86\u7372\u5f97\u512a\u52e2\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u5728\u300a\u69cd\u6230\u72c2\u6f6e Redux\u300b\u4e2d\u6709\u6548\u5730\u4f7f\u7528\u589e\u76ca\u6548\u679c\uff0c\u65b9\u6cd5\u662f\u7b56\u7565\u6027\u5730\u8abf\u6574\u555f\u52d5\u6642\u9593\u3002\u6b65\u9a5f1 - \u8b58\u5225\u589e\u76ca\u6548\u679c\uff0c\u4f8b\u5982\u96d9\u500d\u50b7\u5bb3\u6216\u751f\u547d\u6062\u5fa9\u3002\u6b65\u9a5f2 - \u5728\u6b63\u78ba\u7684\u6642\u523b\u555f\u52d5\u589e\u76ca\u6548\u679c\uff0c\u4f8b\u5982\u5728\u8207 Boss \u5c0d\u6230\u6216\u88ab\u6575\u4eba\u5305\u570d\u6642\u3002\u6b65\u9a5f3 - \u5c07\u589e\u76ca\u6548\u679c\u7d44\u5408\u8d77\u4f86\u4ee5\u9054\u5230\u6700\u5927\u6548\u679c\uff0c\u4f8b\u5982\u5c07\u96d9\u500d\u50b7\u5bb3\u8207\u9ad8\u50b7\u5bb3\u6b66\u5668\u7d50\u5408\u4f7f\u7528\u3002\u4f8b\u5982\uff0c\u5728\u706b\u7bad\u767c\u5c04\u5668\u4e0a\u4f7f\u7528\u96d9\u500d\u50b7\u5bb3\u589e\u76ca\u6548\u679c\u53ef\u4ee5\u6467\u6bc0\u4e00\u5927\u7fa4\u6575\u4eba\u3002[\u6d41\u7a0b\u5716\u89e3: \u8b58\u5225 -> \u555f\u52d5 -> \u7d44\u5408 -> \u4e3b\u5bb0\u3002]"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u904b\u884c\u300a\u69cd\u6230\u72c2\u6f6e Redux\u300b\u7684\u7cfb\u7d71\u9700\u6c42\u70ba\u4f55\uff1f", "answer": "\u300a\u69cd\u6230\u72c2\u6f6e Redux\u300b\u7684\u7cfb\u7d71\u9700\u6c42\u9069\u4e2d\uff0c\u4f7f\u5176\u53ef\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u904b\u884c\u3002\u5c0d\u65bc\u96fb\u8166\uff0c\u5b83\u81f3\u5c11\u9700\u8981\u96d9\u6838\u5fc3\u8655\u7406\u5668\u30012GB RAM \u548c DirectX 9 \u76f8\u5bb9\u986f\u5361\u3002\u5728\u884c\u52d5\u88dd\u7f6e\u4e0a\uff0c\u5b83\u53ef\u4ee5\u5728\u642d\u8f09 Android 4.4 \u6216 iOS 9 \u4ee5\u4e0a\u7684\u88dd\u7f6e\u4e0a\u9806\u5229\u904b\u884c\u3002\u4f8b\u5982\uff0c2018 \u5e74\u7684\u4e2d\u968e\u667a\u6167\u624b\u6a5f\u53ef\u4ee5\u9806\u66a2\u904b\u884c\u6b64\u904a\u6232\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u96fb\u8166 - \u96d9\u6838\u5fc3\uff0c2GB RAM\uff1b\u884c\u52d5\u88dd\u7f6e - Android 4.4/iOS 9\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u69cd\u6230\u72c2\u6f6e Redux\u300b\u4e2d\u89e3\u9396\u96b1\u85cf\u89d2\u8272\u548c\u95dc\u5361\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u5728\u300a\u69cd\u6230\u72c2\u6f6e Redux\u300b\u4e2d\u900f\u904e\u5b8c\u6210\u7279\u5b9a\u6311\u6230\u6216\u5c0b\u627e\u79d8\u5bc6\u5340\u57df\u4f86\u89e3\u9396\u96b1\u85cf\u89d2\u8272\u548c\u95dc\u5361\u3002\u4f8b\u5982\uff0c\u5728\u5287\u60c5\u6a21\u5f0f\u4e2d\u64ca\u6557\u4e00\u5b9a\u6578\u91cf\u7684\u6575\u4eba\u53ef\u80fd\u6703\u89e3\u9396\u65b0\u7684\u89d2\u8272\u3002\u63a2\u7d22\u95dc\u5361\u7684\u6bcf\u500b\u89d2\u843d\u53ef\u80fd\u6703\u767c\u73fe\u901a\u5f80\u79d8\u5bc6\u95dc\u5361\u7684\u96b1\u85cf\u5165\u53e3\u3002[\u6bd4\u55bb\u8aaa\u660e: \u89e3\u9396\u96b1\u85cf\u5167\u5bb9\u5c31\u50cf\u89e3\u8b0e\uff1b\u6bcf\u627e\u5230\u4e00\u500b\u788e\u7247\u90fd\u8b93\u60a8\u66f4\u63a5\u8fd1\u5b8c\u6574\u5716\u50cf\u3002]"}, {"question": "\u5728\u300a\u69cd\u6230\u72c2\u6f6e Redux\u300b\u7684\u5c0d\u6230\u6a21\u5f0f\u4e2d\uff0c\u54ea\u4e9b\u662f\u8d0f\u5f97\u6bd4\u8cfd\u6700\u6709\u6548\u7684\u7b56\u7565\uff1f", "answer": "\u5728\u300a\u69cd\u6230\u72c2\u6f6e Redux\u300b\u7684\u5c0d\u6230\u6a21\u5f0f\u4e2d\uff0c\u8d0f\u5f97\u6bd4\u8cfd\u9700\u8981\u7b56\u7565\u548c\u6280\u5de7\u7684\u7d50\u5408\u3002\u6b65\u9a5f1 - \u9078\u64c7\u9069\u5408\u81ea\u5df1\u98a8\u683c\u7684\u89d2\u8272\u548c\u6b66\u5668\u3002\u6b65\u9a5f2 - \u63a7\u5236\u5730\u5716\uff0c\u5c07\u81ea\u5df1\u7f6e\u65bc\u6709\u5229\u4f4d\u7f6e\u3002\u6b65\u9a5f3 - \u9810\u6e2c\u5c0d\u624b\u7684\u52d5\u4f5c\u4e26\u6709\u6548\u53cd\u5236\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u79fb\u52d5\u6027\u9ad8\u7684\u89d2\u8272\u53ef\u4ee5\u5e6b\u52a9\u60a8\u8d85\u8d8a\u8f03\u6162\u7684\u5c0d\u624b\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u79fb\u52d5\u6027 vs. \u80fd\u529b\uff1b\u6839\u64da\u5c0d\u624b\u7684\u5f31\u9ede\u505a\u51fa\u9078\u64c7\u3002]"}]
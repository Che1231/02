[{"question": "\uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 Gun Mayhem Redux\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \ub9c8\uc2a4\ud130\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Gun Mayhem Redux\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \ub9c8\uc2a4\ud130\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1 - \uc774\ub3d9 \ud0a4(WASD \ub610\ub294 \ud654\uc0b4\ud45c \ud0a4)\uc640 \uc810\ud504 \ud0a4(\uc2a4\ud398\uc774\uc2a4\ubc14)\ub97c \uc775\uc219\ud574\uc9c0\uc138\uc694. STEP2 - \uc67c\ucabd \ub9c8\uc6b0\uc2a4 \ubc84\ud2bc\uc73c\ub85c \uc0ac\uaca9 \uc5f0\uc2b5\ud558\uace0 R \ud0a4\ub85c \uc7ac\uc7a5\uc804 \uc5f0\uc2b5\ud558\uc138\uc694. STEP3 - \uadfc\uc811\uc804\uc5d0\ub294 \uc0b0\ud0c4\ucd1d, \uc6d0\uac70\ub9ac \uc815\ubc00 \uc0ac\uaca9\uc5d0\ub294 \uc800\uaca9 \uc18c\ucd1d\uacfc \uac19\uc740 \ub2e4\uc591\ud55c \ubb34\uae30\ub97c \uc0ac\uc6a9\ud574 \ubcf4\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc881\uc740 \uacf5\uac04\uc5d0\uc11c \uc0b0\ud0c4\ucd1d\uc744 \uc0ac\uc6a9\ud558\uba74 \uc801\ub4e4\uc744 \ube60\ub974\uac8c \uc81c\uac70\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ucee8\ud2b8\ub864\uc744 \uc6b4\uc804 \ubc30\uc6b0\ub294 \uac83\uc73c\ub85c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694. \uae30\ubcf8\uc744 \uc775\ud788\uba74 \ub098\uba38\uc9c0\ub294 \uc790\uc5f0\uc2a4\ub7ec\uc6cc\uc9d1\ub2c8\ub2e4.]"}, {"question": "Gun Mayhem Redux\uc5d0\uc11c \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uac00 \uac8c\uc784\uc744 \uc9c0\ubc30\ud558\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 Gun Mayhem Redux\uc5d0\uc11c \ub2e4\uc74c \uc804\ub7b5\uc744 \ud65c\uc6a9\ud558\uc5ec \uac8c\uc784\uc744 \uc9c0\ubc30\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4: STEP1 - \uc801\uc758 \uacf5\uaca9\uc744 \ud53c\ud558\uae30 \uc704\ud574 \ud68c\ud53c\ud558\uace0 \ubab8\uc744 \uc6c0\uc9c1\uc774\ub294 \uae30\uc220\uc744 \ub9c8\uc2a4\ud130\ud558\uc138\uc694. STEP2 - \ud50c\ub7ab\ud3fc\uc744 \uc774\uc6a9\ud558\uc5ec \ub192\uc774\ub97c \ud655\ubcf4\ud558\uace0 \ub354 \uc88b\uc740 \uac01\ub3c4\ub97c \ud655\ubcf4\ud558\ub294 \ub4f1 \ud658\uacbd\uc744 \ud65c\uc6a9\ud558\uc138\uc694. STEP3 - \uc774\uc911 \ud53c\ud574 \ub610\ub294 \uccb4\ub825 \ud68c\ubcf5\uacfc \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc644\ubcbd\ud558\uac8c \uc0ac\uc6a9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc801\uc808\ud55c \uc7a5\uc18c\uc5d0 \uc800\uaca9 \uc18c\ucd1d\uc73c\ub85c \uc774\uc911 \ud53c\ud574 \ud30c\uc6cc\uc5c5\uc744 \ud65c\uc6a9\ud558\uba74 \uc2b9\ubd80\ub97c \ub4a4\uc9d1\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: \ud68c\ud53c\ub294 \uccb4\uc2a4\uc640 \uac19\uc2b5\ub2c8\ub2e4. \uc0c1\ub300\ubc29\uc758 \uc218\ub97c \uc608\uce21\ud558\uace0 \ud6a8\uacfc\uc801\uc73c\ub85c \ub300\uc751\ud558\uc138\uc694.]"}, {"question": "Gun Mayhem Redux\uc5d0\uc11c \ubb34\uae30 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Gun Mayhem Redux\uc5d0\uc11c \ubb34\uae30 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \uc804\ud22c \uc911\uc5d0 \uc815\ubcf4\uc5d0 \uc785\uac01\ud55c \uacb0\uc815\uc744 \ub0b4\ub9b4 \uc218 \uc788\ub3c4\ub85d \ub3c4\uc640\uc8fc\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uac01 \ubb34\uae30\ub294 \ubc1c\uc0ac \uc18d\ub3c4, \ud53c\ud574\ub7c9, \uc0ac\uc815\uac70\ub9ac\uc640 \uac19\uc740 \uace0\uc720\ud55c \uc18d\uc131\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc0b0\ud0c4\ucd1d\uc740 \uadfc\uc811\uc804\uc5d0\uc11c \ub6f0\uc5b4\ub098\uc9c0\ub9cc \uc6d0\uac70\ub9ac\uc5d0\uc11c\ub294 \uadf8 \ud6a8\uacfc\uac00 \ub5a8\uc5b4\uc9d1\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\uba74 \ud50c\ub808\uc774\uc5b4\ub294 \uac01 \uc0c1\ud669\uc5d0 \ub9de\ub294 \uc801\uc808\ud55c \ubb34\uae30\ub97c \uc120\ud0dd\ud558\uc5ec \uc804\uccb4\uc801\uc778 \uc131\ub2a5\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \uc0b0\ud0c4\ucd1d - \ub192\uc740 \ud53c\ud574\ub7c9, \uc9e7\uc740 \uc0ac\uc815\uac70\ub9ac; \uc800\uaca9 \uc18c\ucd1d - \ub0ae\uc740 \ubc1c\uc0ac \uc18d\ub3c4, \uae34 \uc0ac\uc815\uac70\ub9ac.]"}, {"question": "Gun Mayhem Redux\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Gun Mayhem Redux\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc0c1\ub300\ub97c \uc81c\uac70\ud558\uace0 \ubaa9\ud45c\ub97c \ub2ec\uc131\ud558\ub294 \ub370 \uae30\ubc18\uc744 \ub450\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\ub294 \uac01 \ucc98\uce58\ub2f9 \uc810\uc218\ub97c \uc5bb\uc73c\uba70, \ud5e4\ub4dc\uc0f7 \ub610\ub294 \ud2b9\uc815 \ubb34\uae30 \uc0ac\uc6a9 \uc2dc \ubcf4\ub108\uc2a4 \uc810\uc218\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud558\ub824\uba74 \uc815\ud655\uc131\uacfc \ud6a8\uc728\uc131\uc5d0 \uc9d1\uc911\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc800\uaca9 \uc18c\ucd1d\uc73c\ub85c \ud5e4\ub4dc\uc0f7\uc744 \ud558\uba74 \uc810\uc218\uac00 \ud06c\uac8c \uc0c1\uc2b9\ud569\ub2c8\ub2e4. \ub610\ud55c, \uc801\uc758 \uc6e8\uc774\ube0c\ub97c \ubc84\ud2f0\ub294 \uac83\uacfc \uac19\uc740 \ubcf4\ub108\uc2a4 \ubaa9\ud45c\ub97c \ub2ec\uc131\ud558\uba74 \ucd94\uac00 \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc810\uc218 \ud68d\ub4dd\uc744 \uacbd\uc8fc\ub85c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694. \uc791\uc5c5\uc744 \ub354 \ube60\ub974\uace0 \uc815\ud655\ud558\uac8c \uc644\ub8cc\ud560\uc218\ub85d \uc810\uc218\uac00 \ub192\uc544\uc9d1\ub2c8\ub2e4.]"}, {"question": "Gun Mayhem Redux\uc758 \ub2e4\uc591\ud55c \uac8c\uc784 \ubaa8\ub4dc \uac04\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Gun Mayhem Redux\ub294 \uac01\uac01 \uace0\uc720\ud55c \ub3c4\uc804\uacfc\uc81c\ub97c \uac00\uc9c4 \uc5ec\ub7ec \uac8c\uc784 \ubaa8\ub4dc\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ucea0\ud398\uc778 \ubaa8\ub4dc\ub294 \uc810\uc810 \uc5b4\ub824\uc6cc\uc9c0\ub294 \uad6c\uc870\ud654\ub41c \uc9c4\ud589\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc0dd\uc874 \ubaa8\ub4dc\ub294 \ub05d\uc5c6\uc774 \ubab0\ub824\uc624\ub294 \uc801\ub4e4\uacfc\uc758 \uc778\ub0b4\uc2ec \uc2dc\ud5d8\uc785\ub2c8\ub2e4. \ub300\uacb0 \ubaa8\ub4dc\ub294 \ud50c\ub808\uc774\uc5b4\ub4e4\uc774 \uc11c\ub85c \uacbd\uc7c1\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc0dd\uc874 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uac00\ub2a5\ud55c \ud55c \uc624\ub798 \ubc84\ud2f0\uae30 \uc704\ud574 \uacf5\uaca9\uacfc \ubc29\uc5b4\ub97c \uade0\ud615 \uc788\uac8c \uc720\uc9c0\ud574\uc57c \ud569\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: \ucea0\ud398\uc778\uc740 \ub9c8\ub77c\ud1a4\uacfc \uac19\uace0, \uc0dd\uc874\uc740 \uc2a4\ud504\ub9b0\ud2b8\uc640 \uac19\uc2b5\ub2c8\ub2e4. \ubaa8\ub450 \ub2e4\ub978 \uc804\ub7b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.]"}, {"question": "Gun Mayhem Redux\uc5d0\uc11c \uac00\uc7a5 \uac15\ub825\ud55c \ubb34\uae30\ub294 \ubb34\uc5c7\uc774\uba70, \uadf8 \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Gun Mayhem Redux\uc5d0\uc11c \uac00\uc7a5 \uac15\ub825\ud55c \ubb34\uae30\ub294 \uc77c\ubc18\uc801\uc73c\ub85c \ub192\uc740 \ud53c\ud574\ub7c9\uacfc \ub2e4\uc7ac\ub2e4\ub2a5\ud568\uc744 \uac00\uc9c4 \ubb34\uae30\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub85c\ucf13 \ubc1c\uc0ac\uae30\ub294 \uad11\ubc94\uc704\ud55c \ud53c\ud574\ub97c \uc785\ud788\uc9c0\ub9cc \uc7ac\uc7a5\uc804 \uc2dc\uac04\uc774 \ub290\ub9bd\ub2c8\ub2e4. \ubbf8\ub2c8\uac74\uc740 \uc9c0\uc18d\uc801\uc778 \ud654\ub825\uc744 \uc81c\uacf5\ud558\uc9c0\ub9cc \uacfc\uc5f4\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\ub294 \uc885\uc885 \ub85c\ucf13 \ubc1c\uc0ac\uae30\ub97c \ud55c \ubc88\uc5d0 \uc5ec\ub7ec \uba85\uc758 \uc801\uc744 \uc81c\uac70\ud560 \uc218 \uc788\ub294 \ub2a5\ub825 \ub54c\ubb38\uc5d0 \uc120\ud638\ud569\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \ub85c\ucf13 \ubc1c\uc0ac\uae30 - \ub192\uc740 \ud53c\ud574\ub7c9, \ub290\ub9b0 \uc7ac\uc7a5\uc804; \ubbf8\ub2c8\uac74 - \uc9c0\uc18d\uc801\uc778 \ud654\ub825, \uacfc\uc5f4 \uc704\ud5d8.]"}, {"question": "Gun Mayhem Redux\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \ud30c\uc6cc\uc5c5\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc5ec \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Gun Mayhem Redux\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\ub294 \ud30c\uc6cc\uc5c5\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \ud65c\uc131\ud654\ud568\uc73c\ub85c\uc368 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1 - \uc774\uc911 \ud53c\ud574 \ub610\ub294 \uccb4\ub825 \ud68c\ubcf5\uacfc \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \ud655\uc778\ud558\uc138\uc694. STEP2 - \ubcf4\uc2a4\uc804\uc774\ub098 \uc801\uc5d0\uac8c \ud3ec\uc704\ub2f9\ud588\uc744 \ub54c\uc640 \uac19\uc774 \uc801\uc808\ud55c \uc2dc\uae30\uc5d0 \ud65c\uc131\ud654\ud558\uc138\uc694. STEP3 - \uc774\uc911 \ud53c\ud574\uc640 \uace0\ud53c\ud574 \ubb34\uae30\ub97c \uacb0\ud569\ud558\uc5ec \ucd5c\ub300 \ud6a8\uacfc\ub97c \uc5bb\uc73c\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub85c\ucf13 \ubc1c\uc0ac\uae30\uc5d0 \uc774\uc911 \ud53c\ud574\ub97c \ud65c\uc131\ud654\ud558\uba74 \uc801\uad70\uc744 \uc4f8\uc5b4\ubc84\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \uc124\uba85: \ud30c\uc545 -> \ud65c\uc131\ud654 -> \uc870\ud569 -> \uc2b9\ub9ac.]"}, {"question": "\ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c Gun Mayhem Redux\ub97c \uc2e4\ud589\ud558\uae30 \uc704\ud55c \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Gun Mayhem Redux\ub294 \ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc561\uc138\uc2a4\ud560 \uc218 \uc788\ub3c4\ub85d \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc774 \ub0ae\uc2b5\ub2c8\ub2e4. PC\uc5d0\uc11c\ub294 \ucd5c\uc18c\ud55c \ub4c0\uc5bc\ucf54\uc5b4 \ud504\ub85c\uc138\uc11c, 2GB RAM, DirectX 9 \ud638\ud658 \uadf8\ub798\ud53d \uce74\ub4dc\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ubaa8\ubc14\uc77c\uc5d0\uc11c\ub294 Android 4.4 \uc774\uc0c1 \ub610\ub294 iOS 9 \uc774\uc0c1\uc758 \uae30\uae30\uc5d0\uc11c \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 2018\ub144 \uc911\ubc18\ud615 \uc2a4\ub9c8\ud2b8\ud3f0\uc73c\ub85c\ub3c4 \ubb38\uc81c\uc5c6\uc774 \uac8c\uc784\uc744 \uc2e4\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: PC - \ub4c0\uc5bc\ucf54\uc5b4, 2GB RAM; \ubaa8\ubc14\uc77c - Android 4.4/iOS 9.]"}, {"question": "Gun Mayhem Redux\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \uc228\uaca8\uc9c4 \uce90\ub9ad\ud130\uc640 \ub808\ubca8\uc744 \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Gun Mayhem Redux\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\ub294 \ud2b9\uc815 \ucc4c\ub9b0\uc9c0 \uc644\ub8cc \ub610\ub294 \ube44\ubc00 \uc601\uc5ed \ubc1c\uacac\uc73c\ub85c \uc228\uaca8\uc9c4 \uce90\ub9ad\ud130\uc640 \ub808\ubca8\uc744 \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucea0\ud398\uc778 \ubaa8\ub4dc\uc5d0\uc11c \ud2b9\uc815 \uc218\uc758 \uc801\uc744 \ucc98\uce58\ud558\uba74 \uc0c8\ub85c\uc6b4 \uce90\ub9ad\ud130\ub97c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub808\ubca8\uc758 \ubaa8\ub4e0 \uad6c\uc11d\uc744 \ud0d0\ud5d8\ud558\uba74 \ube44\ubc00 \uc2a4\ud14c\uc774\uc9c0\ub85c \uc5f0\uacb0\ub418\ub294 \uc228\uaca8\uc9c4 \ud3ec\ud138\uc744 \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \uc7a0\uae08 \ud574\uc81c\ud558\ub294 \uac83\uc740 \ud37c\uc990 \ud480\uc774\uc640 \uac19\uc2b5\ub2c8\ub2e4. \uac01 \uc870\uac01\uc744 \ucc3e\uc744 \ub54c\ub9c8\ub2e4 \uc804\uccb4 \uadf8\ub9bc\uc5d0 \ub354 \uac00\uae4c\uc6cc\uc9d1\ub2c8\ub2e4.]"}, {"question": "Gun Mayhem Redux\uc758 \ub300\uacb0 \ubaa8\ub4dc\uc5d0\uc11c \uc2b9\ub9ac\ud558\uae30 \uc704\ud55c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \uc804\uc220\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Gun Mayhem Redux\uc758 \ub300\uacb0 \ubaa8\ub4dc\uc5d0\uc11c \uc2b9\ub9ac\ud558\ub824\uba74 \uc804\ub7b5\uacfc \uae30\uc220\uc758 \uc870\ud569\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1 - \uc790\uc2e0\uc758 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\ub294 \uce90\ub9ad\ud130\uc640 \ubb34\uae30\ub97c \uc120\ud0dd\ud558\uc138\uc694. STEP2 - \uc720\ub9ac\ud55c \uc704\uce58\uc5d0 \uc790\ub9ac \uc7a1\uc544 \ub9f5\uc744 \uc81c\uc5b4\ud558\uc138\uc694. STEP3 - \uc0c1\ub300\ubc29\uc758 \uc6c0\uc9c1\uc784\uc744 \uc608\uce21\ud558\uace0 \ud6a8\uacfc\uc801\uc73c\ub85c \ub300\uc751\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc774\ub3d9\uc131\uc774 \ub192\uc740 \uce90\ub9ad\ud130\ub97c \uc0ac\uc6a9\ud558\uba74 \ub354 \ub290\ub9b0 \uc0c1\ub300\ub97c \uc81c\uc555\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: \uc774\ub3d9\uc131 \ub300 \ud30c\uc6cc; \uc0c1\ub300\uc758 \uc57d\uc810\uc5d0 \ub530\ub77c \uc120\ud0dd\ud558\uc138\uc694.]"}]
[{"question": "\u30ac\u30f3\u30e1\u30a4\u30d8\u30e0\u30ea\u30c7\u30e5\u30af\u30b9\u3067\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u8fc5\u901f\u306b\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30ac\u30f3\u30e1\u30a4\u30d8\u30e0\u30ea\u30c7\u30e5\u30af\u30b9\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u7d20\u65e9\u304f\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71-\u79fb\u52d5\u30ad\u30fc\uff08WASD\u307e\u305f\u306f\u77e2\u5370\u30ad\u30fc\uff09\u3068\u30b8\u30e3\u30f3\u30d7\u30ad\u30fc\uff08\u30b9\u30da\u30fc\u30b9\u30d0\u30fc\uff09\u3092\u899a\u3048\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d72-\u5de6\u30de\u30a6\u30b9\u30dc\u30bf\u30f3\u3067\u5c04\u6483\u3057\u3001R\u30ad\u30fc\u3067\u88c5\u586b\u7df4\u7fd2\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d73-\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\uff08\u8fd1\u8ddd\u96e2\u6226\u95d8\u7528\uff09\u3084\u30b9\u30ca\u30a4\u30d1\u30fc\u30e9\u30a4\u30d5\u30eb\uff08\u9060\u8ddd\u96e2\u7cbe\u5bc6\u5c04\u6483\u7528\uff09\u306a\u3069\u3001\u69d8\u3005\u306a\u6b66\u5668\u3092\u8a66\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u8fd1\u8ddd\u96e2\u3067\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\u3092\u4f7f\u3046\u3053\u3068\u3067\u6575\u3092\u7d20\u65e9\u304f\u6392\u9664\u3067\u304d\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u64cd\u4f5c\u3092\u904b\u8ee2\u306e\u5b66\u7fd2\u306b\u4f8b\u3048\u308b\u306a\u3089\u3001\u57fa\u672c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308c\u3070\u3001\u5f8c\u306f\u76f4\u611f\u7684\u306b\u306a\u308a\u307e\u3059\u3002]"}, {"question": "\u30ac\u30f3\u30e1\u30a4\u30d8\u30e0\u30ea\u30c7\u30e5\u30af\u30b9\u3067\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u512a\u4f4d\u306b\u7acb\u3064\u305f\u3081\u306e\u6700\u9069\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30ac\u30f3\u30e1\u30a4\u30d8\u30e0\u30ea\u30c7\u30e5\u30af\u30b9\u3067\u512a\u4f4d\u306b\u7acb\u3064\u306b\u306f\u3001\u6b21\u306e\u6226\u7565\u3092\u63a1\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71-\u6575\u306e\u653b\u6483\u3092\u56de\u907f\u3059\u308b\u305f\u3081\u306b\u3001\u304b\u308f\u3059\u6280\u8853\u3092\u30de\u30b9\u30bf\u30fc\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d72-\u9ad8\u307f\u304b\u3089\u306e\u6709\u5229\u306a\u4f4d\u7f6e\u3092\u5f97\u308b\u305f\u3081\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306a\u3069\u3092\u5229\u7528\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d73-\u30c0\u30e1\u30fc\u30b8\u500d\u7387\u3084\u4f53\u529b\u56de\u5fa9\u306a\u3069\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306e\u52b9\u679c\u7684\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u719f\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u30c0\u30e1\u30fc\u30b8\u500d\u7387\u30a2\u30c3\u30d7\u3092\u9069\u5207\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u72d9\u6483\u306b\u5408\u308f\u305b\u3066\u4f7f\u3046\u3053\u3068\u3067\u3001\u8a66\u5408\u306e\u5c55\u958b\u3092\u5909\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u304b\u308f\u3059\u3053\u3068\u306f\u30c1\u30a7\u30b9\u306e\u30b2\u30fc\u30e0\u3068\u540c\u3058\u3067\u3059\u3002\u76f8\u624b\u306e\u52d5\u304d\u3092\u4e88\u6e2c\u3057\u3066\u3001\u52b9\u679c\u7684\u306b\u5bfe\u5fdc\u3057\u307e\u3057\u3087\u3046\u3002]"}, {"question": "\u30ac\u30f3\u30e1\u30a4\u30d8\u30e0\u30ea\u30c7\u30e5\u30af\u30b9\u3067\u6b66\u5668\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u306a\u305c\u91cd\u8981\u3067\u3059\u304b\uff1f", "answer": "\u30ac\u30f3\u30e1\u30a4\u30d8\u30e0\u30ea\u30c7\u30e5\u30af\u30b9\u3067\u6b66\u5668\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u6226\u95d8\u4e2d\u306b\u9069\u5207\u306a\u5224\u65ad\u3092\u3059\u308b\u305f\u3081\u306b\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u5404\u6b66\u5668\u306b\u306f\u3001\u5c04\u6483\u901f\u5ea6\u3001\u30c0\u30e1\u30fc\u30b8\u91cf\u3001\u5c04\u7a0b\u8ddd\u96e2\u306a\u3069\u306e\u56fa\u6709\u306e\u7279\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\u306f\u8fd1\u8ddd\u96e2\u6226\u95d8\u3067\u306f\u512a\u308c\u3066\u3044\u307e\u3059\u304c\u3001\u9060\u8ddd\u96e2\u3067\u306f\u52b9\u679c\u304c\u3042\u308a\u307e\u305b\u3093\u3002\u3053\u308c\u3089\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u77e5\u308b\u3053\u3068\u304c\u3067\u304d\u308c\u3070\u3001\u72b6\u6cc1\u306b\u5408\u3063\u305f\u6b66\u5668\u3092\u9078\u629e\u3057\u3001\u5168\u4f53\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u4e00\u89a7\u8868\uff1a\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3 - \u9ad8\u30c0\u30e1\u30fc\u30b8\u3001\u77ed\u5c04\u7a0b; \u30b9\u30ca\u30a4\u30d1\u30fc\u30e9\u30a4\u30d5\u30eb - \u4f4e\u5c04\u6483\u901f\u5ea6\u3001\u9577\u5c04\u7a0b\u3002]"}, {"question": "\u30ac\u30f3\u30e1\u30a4\u30d8\u30e0\u30ea\u30c7\u30e5\u30af\u30b9\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u3088\u3046\u306b\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30ac\u30f3\u30e1\u30a4\u30d8\u30e0\u30ea\u30c7\u30e5\u30af\u30b9\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6575\u3092\u6392\u9664\u3057\u3001\u76ee\u6a19\u3092\u9054\u6210\u3059\u308b\u3053\u3068\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u5404\u30ad\u30eb\u3067\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u3001\u30d8\u30c3\u30c9\u30b7\u30e7\u30c3\u30c8\u3084\u7279\u5b9a\u306e\u6b66\u5668\u306e\u4f7f\u7528\u3067\u30dc\u30fc\u30ca\u30b9\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u6b63\u78ba\u3055\u3068\u52b9\u7387\u6027\u3092\u91cd\u8996\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u30b9\u30ca\u30a4\u30d1\u30fc\u30e9\u30a4\u30d5\u30eb\u3067\u30d8\u30c3\u30c9\u30b7\u30e7\u30c3\u30c8\u3092\u3059\u308b\u3053\u3068\u3067\u3001\u30b9\u30b3\u30a2\u304c\u5927\u5e45\u306b\u4e0a\u6607\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u6575\u306e\u6ce2\u3092\u751f\u304d\u6b8b\u308b\u3068\u3044\u3063\u305f\u30dc\u30fc\u30ca\u30b9\u76ee\u6a19\u3092\u9054\u6210\u3059\u308b\u3053\u3068\u3067\u3001\u8ffd\u52a0\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u3092\u7af6\u4e89\u306b\u4f8b\u3048\u308b\u306a\u3089\u3001\u3088\u308a\u65e9\u304f\u305d\u3057\u3066\u6b63\u78ba\u306b\u30bf\u30b9\u30af\u3092\u5b8c\u4e86\u3059\u308c\u3070\u3001\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002]"}, {"question": "\u30ac\u30f3\u30e1\u30a4\u30d8\u30e0\u30ea\u30c7\u30e5\u30af\u30b9\u306e\u3055\u307e\u3056\u307e\u306a\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u306e\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ac\u30f3\u30e1\u30a4\u30d8\u30e0\u30ea\u30c7\u30e5\u30af\u30b9\u306b\u306f\u3001\u305d\u308c\u305e\u308c\u56fa\u6709\u306e\u8ab2\u984c\u3092\u6301\u3064\u3044\u304f\u3064\u304b\u306e\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u304c\u3042\u308a\u307e\u3059\u3002\u30ad\u30e3\u30f3\u30da\u30fc\u30f3\u30e2\u30fc\u30c9\u306f\u3001\u96e3\u6613\u5ea6\u304c\u4e0a\u304c\u308b\u69cb\u9020\u5316\u3055\u308c\u305f\u9032\u884c\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u30b5\u30d0\u30a4\u30d0\u30eb\u30e2\u30fc\u30c9\u306f\u3001\u7d42\u308f\u308a\u306e\u306a\u3044\u6575\u306e\u6ce2\u306b\u5bfe\u3059\u308b\u6301\u4e45\u529b\u3092\u8a66\u3057\u307e\u3059\u3002\u5bfe\u6226\u30e2\u30fc\u30c9\u3067\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u540c\u58eb\u304c\u7af6\u3044\u5408\u3048\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b5\u30d0\u30a4\u30d0\u30eb\u30e2\u30fc\u30c9\u3067\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u53ef\u80fd\u306a\u9650\u308a\u9577\u304f\u751f\u304d\u6b8b\u308b\u305f\u3081\u306b\u3001\u653b\u6483\u3068\u9632\u5fa1\u306e\u30d0\u30e9\u30f3\u30b9\u3092\u3068\u3089\u306a\u3051\u308c\u3070\u306a\u308a\u307e\u305b\u3093\u3002[\u6bd4\u8f03\uff1a\u30ad\u30e3\u30f3\u30da\u30fc\u30f3\u306f\u30de\u30e9\u30bd\u30f3\u3001\u30b5\u30d0\u30a4\u30d0\u30eb\u306f\u77ed\u8ddd\u96e2\u8d70\u3068\u540c\u3058\u3067\u3059\u3002\u4e21\u65b9\u306b\u7570\u306a\u308b\u6226\u7565\u304c\u6c42\u3081\u3089\u308c\u307e\u3059\u3002]"}, {"question": "\u30ac\u30f3\u30e1\u30a4\u30d8\u30e0\u30ea\u30c7\u30e5\u30af\u30b9\u3067\u6700\u3082\u5f37\u529b\u306a\u6b66\u5668\u306f\u3069\u308c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u306e\u7406\u7531\u306f\uff1f", "answer": "\u30ac\u30f3\u30e1\u30a4\u30d8\u30e0\u30ea\u30c7\u30e5\u30af\u30b9\u3067\u6700\u3082\u5f37\u529b\u306a\u6b66\u5668\u306f\u3001\u901a\u5e38\u3001\u9ad8\u3044\u30c0\u30e1\u30fc\u30b8\u3068\u591a\u7528\u9014\u6027\u3092\u5099\u3048\u305f\u3082\u306e\u3067\u3059\u3002\u30ed\u30b1\u30c3\u30c8\u30e9\u30f3\u30c1\u30e3\u30fc\u306f\u3001\u4f8b\u3048\u3070\u3001\u5e83\u7bc4\u56f2\u306b\u5927\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u307e\u3059\u304c\u3001\u88c5\u586b\u6642\u9593\u304c\u9045\u3044\u3067\u3059\u3002\u30df\u30cb\u30ac\u30f3\u306f\u6301\u7d9a\u7684\u306a\u706b\u529b\u304c\u3042\u308a\u307e\u3059\u304c\u3001\u30aa\u30fc\u30d0\u30fc\u30d2\u30fc\u30c8\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30ed\u30b1\u30c3\u30c8\u30e9\u30f3\u30c1\u30e3\u30fc\u3092\u4e00\u5ea6\u306b\u8907\u6570\u306e\u6575\u3092\u6392\u9664\u3067\u304d\u308b\u80fd\u529b\u306e\u305f\u3081\u306b\u3001\u3057\u3070\u3057\u3070\u597d\u307f\u307e\u3059\u3002[\u4e00\u89a7\u8868\uff1a\u30ed\u30b1\u30c3\u30c8\u30e9\u30f3\u30c1\u30e3\u30fc - \u9ad8\u30c0\u30e1\u30fc\u30b8\u3001\u88c5\u586b\u6642\u9593\u9045\u5ef6; \u30df\u30cb\u30ac\u30f3 - \u6301\u7d9a\u7684\u306a\u706b\u529b\u3001\u30aa\u30fc\u30d0\u30fc\u30d2\u30fc\u30c8\u30ea\u30b9\u30af\u3002]"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30ac\u30f3\u30e1\u30a4\u30d8\u30e0\u30ea\u30c7\u30e5\u30af\u30b9\u3067\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u52b9\u679c\u7684\u306b\u4f7f\u7528\u3057\u3066\u3069\u306e\u3088\u3046\u306b\u6709\u5229\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30ac\u30f3\u30e1\u30a4\u30d8\u30e0\u30ea\u30c7\u30e5\u30af\u30b9\u3067\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u52b9\u679c\u7684\u306b\u4f7f\u7528\u3059\u308b\u305f\u3081\u306b\u3001\u6226\u7565\u7684\u306b\u305d\u306e\u6709\u52b9\u5229\u7528\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u8abf\u6574\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71-\u30c0\u30d6\u30eb\u30c0\u30e1\u30fc\u30b8\u3084\u4f53\u529b\u56de\u5fa9\u306a\u3069\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u7279\u5b9a\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d72-\u30dc\u30b9\u6226\u3084\u6575\u306b\u56f2\u307e\u308c\u305f\u3068\u304d\u306a\u3069\u3001\u9069\u5207\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u30a2\u30af\u30c6\u30a3\u30d6\u5316\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d73-\u30c0\u30d6\u30eb\u30c0\u30e1\u30fc\u30b8\u3092\u9ad8\u5a01\u529b\u6b66\u5668\u3068\u7d44\u307f\u5408\u308f\u305b\u308b\u306a\u3069\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u6700\u5927\u9650\u306b\u52b9\u679c\u7684\u306b\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3092\u8003\u3048\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u30ed\u30b1\u30c3\u30c8\u30e9\u30f3\u30c1\u30e3\u30fc\u3068\u306e\u30c0\u30d6\u30eb\u30c0\u30e1\u30fc\u30b8\u306e\u6709\u52b9\u6d3b\u7528\u306f\u3001\u6575\u306e\u30b0\u30eb\u30fc\u30d7\u3092\u58ca\u6ec5\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u7279\u5b9a -> \u30a2\u30af\u30c6\u30a3\u30d6\u5316 -> \u7d44\u307f\u5408\u308f\u305b -> \u512a\u4f4d\u306b\u7acb\u3064\u3002]"}, {"question": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u30ac\u30f3\u30e1\u30a4\u30d8\u30e0\u30ea\u30c7\u30e5\u30af\u30b9\u3092\u5b9f\u884c\u3059\u308b\u305f\u3081\u306e\u30b7\u30b9\u30c6\u30e0\u8981\u4ef6\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ac\u30f3\u30e1\u30a4\u30d8\u30e0\u30ea\u30c7\u30e5\u30af\u30b9\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u4e0a\u3067\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u307b\u3069\u3001\u30b7\u30b9\u30c6\u30e0\u8981\u4ef6\u306f\u63a7\u3048\u3089\u308c\u3066\u3044\u307e\u3059\u3002PC\u306e\u5834\u5408\u3001\u5c11\u306a\u304f\u3068\u3082\u30c7\u30e5\u30a2\u30eb\u30b3\u30a2\u30d7\u30ed\u30bb\u30c3\u30b5\u30fc\u30012GB\u306eRAM\u3001DirectX 9\u4e92\u63db\u306e\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u30ab\u30fc\u30c9\u304c\u5fc5\u8981\u3067\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u306e\u5834\u5408\u3001Android 4.4\u4ee5\u964d\u307e\u305f\u306fiOS 9\u4ee5\u964d\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u30b9\u30e0\u30fc\u30ba\u306b\u5b9f\u884c\u3055\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u30012018\u5e74\u306e\u30df\u30c3\u30c9\u30ec\u30f3\u30b8\u30b9\u30de\u30fc\u30c8\u30d5\u30a9\u30f3\u3067\u3042\u308c\u3070\u3001\u554f\u984c\u306a\u304f\u30b2\u30fc\u30e0\u3092\u5b9f\u884c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03\uff1aPC - \u30c7\u30e5\u30a2\u30eb\u30b3\u30a2\u30012GB RAM; \u30e2\u30d0\u30a4\u30eb - Android 4.4/iOS 9\u3002]"}, {"question": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30ac\u30f3\u30e1\u30a4\u30d8\u30e0\u30ea\u30c7\u30e5\u30af\u30b9\u3067\u96a0\u3057\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3084\u30ec\u30d9\u30eb\u3092\u3069\u306e\u3088\u3046\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30ac\u30f3\u30e1\u30a4\u30d8\u30e0\u30ea\u30c7\u30e5\u30af\u30b9\u3067\u96a0\u3057\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3084\u30ec\u30d9\u30eb\u3092\u3001\u7279\u5b9a\u306e\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u5b8c\u4e86\u3057\u305f\u308a\u79d8\u5bc6\u306e\u30a8\u30ea\u30a2\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ad\u30e3\u30f3\u30da\u30fc\u30f3\u30e2\u30fc\u30c9\u3067\u4e00\u5b9a\u6570\u306e\u6575\u3092\u5012\u3059\u3068\u3001\u65b0\u3057\u3044\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u30ec\u30d9\u30eb\u306e\u9685\u3005\u307e\u3067\u63a2\u7d22\u3059\u308b\u3068\u3001\u79d8\u5bc6\u306e\u30b9\u30c6\u30fc\u30b8\u3078\u306e\u96a0\u3057\u30dd\u30fc\u30bf\u30eb\u304c\u898b\u3064\u304b\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002[\u4f8b\u3048\uff1a\u96a0\u3057\u30b3\u30f3\u30c6\u30f3\u30c4\u306e\u30a2\u30f3\u30ed\u30c3\u30af\u306f\u30d1\u30ba\u30eb\u306e\u89e3\u6c7a\u3068\u540c\u3058\u3067\u3059\u3002\u5404\u30d4\u30fc\u30b9\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u3067\u3001\u5168\u4f53\u50cf\u306b\u8fd1\u3065\u3051\u307e\u3059\u3002]"}, {"question": "\u30ac\u30f3\u30e1\u30a4\u30d8\u30e0\u30ea\u30c7\u30e5\u30af\u30b9\u306e\u5bfe\u6226\u30e2\u30fc\u30c9\u3067\u52dd\u5229\u3059\u308b\u305f\u3081\u306e\u6700\u3082\u52b9\u679c\u7684\u306a\u6226\u8853\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30ac\u30f3\u30e1\u30a4\u30d8\u30e0\u30ea\u30c7\u30e5\u30af\u30b9\u306e\u5bfe\u6226\u30e2\u30fc\u30c9\u3067\u52dd\u5229\u3059\u308b\u306b\u306f\u3001\u6226\u7565\u3068\u30b9\u30ad\u30eb\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71-\u81ea\u5206\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u5408\u3063\u305f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3068\u6b66\u5668\u3092\u9078\u3073\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d72-\u6709\u5229\u306a\u5834\u6240\u306b\u81ea\u5206\u3092\u914d\u7f6e\u3059\u308b\u3053\u3068\u3067\u30de\u30c3\u30d7\u3092\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d73-\u76f8\u624b\u306e\u52d5\u304d\u3092\u4e88\u6e2c\u3057\u3001\u52b9\u679c\u7684\u306b\u5bfe\u5fdc\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u9ad8\u3044\u79fb\u52d5\u80fd\u529b\u3092\u6301\u3064\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u3088\u308a\u9045\u3044\u6575\u3092\u51fa\u3057\u629c\u304f\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u79fb\u52d5\u529bvs.\u30d1\u30ef\u30fc\u3002\u76f8\u624b\u306e\u7279\u5fb4\u306b\u5408\u308f\u305b\u3066\u9078\u629e\u3057\u307e\u3057\u3087\u3046\u3002]"}]
[{"question": "\u65b0\u624b\u5982\u4f55\u5feb\u901f\u638c\u63e1\u300a\u77db\u982d\u68cd\u68d2\u4eba\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1\u300a\u77db\u982d\u68cd\u68d2\u4eba\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u719f\u6089\u6416\u687f\u79fb\u52d5\u548c\u653b\u64ca\u6309\u9215\u6295\u64f2\u9577\u77db\u3002\u6b65\u9a5f2 - \u7df4\u7fd2\u653b\u64ca\u6642\u6a5f\uff0c\u4ee5\u64ca\u4e2d\u79fb\u52d5\u76ee\u6a19\uff0c\u4f8b\u5982\u904a\u6232\u65e9\u671f\u51fa\u73fe\u7684\u9ab7\u9acf\u3002\u6b65\u9a5f3 - \u4f7f\u7528\u9583\u907f\u6309\u9215\u4f86\u8eb2\u907f\u6575\u4eba\u7684\u653b\u64ca\uff0c\u9019\u5c0d\u751f\u5b58\u81f3\u95dc\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u95dc\uff0c\u60a8\u53ef\u4ee5\u7df4\u7fd2\u9583\u907f\u9ab7\u9acf\u7de9\u6162\u79fb\u52d5\u7684\u9577\u77db\uff0c\u540c\u6642\u9032\u884c\u53cd\u64ca\u3002\u628a\u5b83\u60f3\u6210\u5b78\u7fd2\u9a0e\u81ea\u884c\u8eca\uff1a\u6162\u6162\u958b\u59cb\uff0c\u7136\u5f8c\u9010\u6f38\u63d0\u9ad8\u901f\u5ea6\u548c\u6e96\u78ba\u6027\u3002"}, {"question": "\u5728\u300a\u77db\u982d\u68cd\u68d2\u4eba\u300b\u4e2d\uff0c\u70ba\u4ec0\u9ebc\u5347\u7d1a\u9577\u77db\u5f88\u91cd\u8981\uff1f\u61c9\u8a72\u512a\u5148\u5347\u7d1a\u54ea\u4e9b\u529f\u80fd\uff1f", "answer": "\u5728\u300a\u77db\u982d\u68cd\u68d2\u4eba\u300b\u4e2d\u5347\u7d1a\u9577\u77db\u5c0d\u65bc\u901a\u904e\u66f4\u96e3\u7684\u95dc\u5361\u81f3\u95dc\u91cd\u8981\u3002\u512a\u5148\u5347\u7d1a\u4ee5\u4e0b\u529f\u80fd\uff1a\u6b65\u9a5f1 - \u63d0\u5347\u9577\u77db\u50b7\u5bb3\uff0c\u4ee5\u66f4\u5feb\u5730\u64ca\u6557\u6575\u4eba\u3002\u6b65\u9a5f2 - \u589e\u5f37\u653b\u64ca\u901f\u5ea6\uff0c\u4ee5\u61c9\u5c0d\u66f4\u591a\u6575\u4eba\u3002\u6b65\u9a5f3 - \u89e3\u9396\u7279\u6b8a\u80fd\u529b\uff0c\u4f8b\u5982\u7206\u70b8\u9577\u77db\uff0c\u7528\u65bc\u63a7\u5236\u7fa4\u9ad4\u3002\u4f8b\u5982\uff0c\u5728\u904a\u6232\u4e2d\u671f\uff0c\u5347\u7d1a\u70ba\u7206\u70b8\u9577\u77db\u53ef\u4ee5\u5e6b\u52a9\u60a8\u6e05\u9664\u6c99\u6f20\u95dc\u5361\u4e2d\u7684\u6575\u4eba\u7fa4\u3002\u60f3\u50cf\u60a8\u7684\u9577\u77db\u5c31\u50cf\u4e00\u4ef6\u96a8\u8457\u60a8\u7684\u6280\u80fd\u9032\u5316\u800c\u8b8a\u5316\u7684\u5de5\u5177\uff0c\u96a8\u8457\u60a8\u7684\u9032\u6b65\u8b8a\u5f97\u66f4\u92d2\u5229\u548c\u66f4\u901a\u7528\u3002"}, {"question": "\u300a\u77db\u982d\u68cd\u68d2\u4eba\u300b\u4e2d\u7684\u68cd\u68d2\u4eba\u89d2\u8272\u4e4b\u9593\u6709\u4ec0\u9ebc\u4e3b\u8981\u5340\u5225\uff1f\u54ea\u500b\u89d2\u8272\u6700\u9069\u5408\u65b0\u624b\uff1f", "answer": "\u300a\u77db\u982d\u68cd\u68d2\u4eba\u300b\u63d0\u4f9b\u4e09\u7a2e\u68cd\u68d2\u4eba\u89d2\u8272\uff1a\u6230\u58eb\u3001\u5f13\u7bad\u624b\u548c\u9b54\u6cd5\u5e2b\u3002\u5c0d\u65bc\u65b0\u624b\u4f86\u8aaa\uff0c\u6230\u58eb\u662f\u6700\u4f73\u9078\u64c7\uff0c\u56e0\u70ba\u5176\u5e73\u8861\u7684\u5c6c\u6027\u548c\u7c21\u55ae\u7684\u904a\u6232\u98a8\u683c\u3002\u6230\u58eb\u64c1\u6709\u66f4\u9ad8\u7684\u751f\u547d\u503c\u548c\u8fd1\u6230\u50b7\u5bb3\uff0c\u9019\u8b93\u65b0\u624b\u66f4\u8f15\u9b06\u4e0a\u624b\u3002\u4f8b\u5982\uff0c\u5728\u65e9\u671f\u95dc\u5361\u4e2d\uff0c\u6230\u58eb\u53ef\u4ee5\u627f\u53d7\u66f4\u591a\u4f86\u81ea\u9ab7\u9acf\u7684\u653b\u64ca\uff0c\u540c\u6642\u9020\u6210\u986f\u8457\u7684\u50b7\u5bb3\u3002\u60f3\u50cf\u6230\u58eb\u662f\u4e00\u500b\u53ef\u9760\u7684\u5168\u80fd\u89d2\u8272\uff0c\u800c\u5f13\u7bad\u624b\u548c\u9b54\u6cd5\u5e2b\u5247\u9700\u8981\u66f4\u7cbe\u78ba\u7684\u7784\u6e96\u548c\u6cd5\u529b\u7ba1\u7406\u3002"}, {"question": "\u9ad8\u7d1a\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u77db\u982d\u68cd\u68d2\u4eba\u300b\u4e2d\u512a\u5316\u8cc7\u6e90\u7ba1\u7406\uff1f", "answer": "\u9ad8\u7d1a\u73a9\u5bb6\u53ef\u4ee5\u900f\u904e\u4ee5\u4e0b\u7b56\u7565\u5728\u300a\u77db\u982d\u68cd\u68d2\u4eba\u300b\u4e2d\u512a\u5316\u8cc7\u6e90\u7ba1\u7406\uff1a\u6b65\u9a5f1 - \u96c6\u4e2d\u6536\u96c6\u88ab\u64ca\u6557\u7684\u6575\u4eba\u548c\u7bb1\u5b50\u6389\u843d\u7684\u786c\u5e63\u548c\u5bf6\u77f3\u3002\u6b65\u9a5f2 - \u512a\u5148\u5347\u7d1a\u5fc5\u8981\u7684\u6280\u80fd\uff0c\u4f8b\u5982\u9577\u77db\u50b7\u5bb3\u548c\u751f\u547d\u503c\uff0c\u800c\u4e0d\u662f\u5916\u89c0\u7269\u54c1\u3002\u6b65\u9a5f3 - \u5728BOSS\u6230\u4e2d\u7b56\u7565\u6027\u5730\u4f7f\u7528\u6d88\u8017\u54c1\uff0c\u4f8b\u5982\u751f\u547d\u85e5\u6c34\u3002\u4f8b\u5982\uff0c\u5728\u7194\u5ca9\u95dc\u5361\u4e2d\uff0c\u5c07\u751f\u547d\u85e5\u6c34\u5132\u5b58\u5230\u6700\u7d42BOSS\u6230\u4e2d\u53ef\u4ee5\u7522\u751f\u986f\u8457\u5dee\u5225\u3002\u60f3\u50cf\u4e00\u4e0b\u60a8\u7684\u8cc7\u6e90\u5c31\u50cf\u4e00\u500b\u6709\u9650\u7684\u9810\u7b97\uff1a\u660e\u667a\u5730\u82b1\u8cbb\u4ee5\u6700\u5927\u5316\u60a8\u7684\u9032\u5ea6\u3002"}, {"question": "\u5728\u300a\u77db\u982d\u68cd\u68d2\u4eba\u300b\u4e2d\u64ca\u6557\u6700\u7d42BOSS\u6700\u6709\u6548\u7684\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u64ca\u6557\u300a\u77db\u982d\u68cd\u68d2\u4eba\u300b\u4e2d\u7684\u6700\u7d42BOSS\u9700\u8981\u4e00\u500b\u5468\u5bc6\u7684\u7b56\u7565\uff1a\u6b65\u9a5f1 - \u88dd\u5099\u6700\u9ad8\u7d1a\u5225\u7684\u9577\u77db\u548c\u88dd\u7532\u3002\u6b65\u9a5f2 - \u5b78\u7fd2BOSS\u7684\u653b\u64ca\u6a21\u5f0f\u4e26\u76f8\u61c9\u5730\u9583\u907f\u3002\u6b65\u9a5f3 - \u5728BOSS\u7684\u8106\u5f31\u968e\u6bb5\u4f7f\u7528\u7279\u6b8a\u80fd\u529b\uff0c\u4f8b\u5982\u7206\u70b8\u9577\u77db\u3002\u4f8b\u5982\uff0c\u7576BOSS\u84c4\u52e2\u5f85\u767c\u9032\u884c\u5f37\u529b\u653b\u64ca\u6642\uff0c\u6b63\u662f\u91cb\u653e\u7206\u70b8\u9577\u77db\u7684\u6700\u4f73\u6642\u6a5f\u3002\u628a\u9019\u5834\u6230\u9b25\u60f3\u50cf\u6210\u4e00\u5834\u68cb\u5c40\uff1a\u9810\u6e2c\u5c0d\u624b\u7684\u52d5\u4f5c\u4e26\u6709\u6548\u53cd\u5236\u3002"}, {"question": "\u300a\u77db\u982d\u68cd\u68d2\u4eba\u300b\u54ea\u4e9b\u904a\u6232\u6a5f\u5236\u5c0d\u9577\u671f\u9032\u5ea6\u6700\u5177\u5f71\u97ff\u529b\uff1f", "answer": "\u300a\u77db\u982d\u68cd\u68d2\u4eba\u300b\u4e2d\u5c0d\u9577\u671f\u9032\u5ea6\u6700\u5177\u5f71\u97ff\u529b\u7684\u904a\u6232\u6a5f\u5236\u662f\uff1a1) \u9577\u77db\u5347\u7d1a\uff0c\u63d0\u5347\u60a8\u7684\u50b7\u5bb3\u548c\u80fd\u529b\u30022) \u751f\u547d\u503c\u548c\u88dd\u7532\u63d0\u5347\uff0c\u589e\u5f37\u60a8\u7684\u751f\u5b58\u80fd\u529b\u30023) \u6280\u80fd\u6a39\u89e3\u9396\uff0c\u63d0\u4f9b\u88ab\u52d5\u52a0\u6210\u548c\u4e3b\u52d5\u6280\u80fd\u3002\u4f8b\u5982\uff0c\u5728\u6280\u80fd\u6a39\u4e2d\u89e3\u9396\u300c\u81f4\u547d\u4e00\u64ca\u300d\u6280\u80fd\u53ef\u4ee5\u5728\u5f8c\u671f\u7684\u95dc\u5361\u4e2d\u986f\u8457\u63d0\u9ad8\u60a8\u7684\u50b7\u5bb3\u8f38\u51fa\u3002\u60f3\u50cf\u9019\u4e9b\u6a5f\u5236\u662f\u623f\u5c4b\u7684\u57fa\u790e\uff1a\u5b83\u5011\u8d8a\u5f37\uff0c\u60a8\u53ef\u4ee5\u5efa\u9020\u5f97\u8d8a\u9ad8\u3002"}, {"question": "\u300a\u77db\u982d\u68cd\u68d2\u4eba\u300b\u7684\u96e3\u5ea6\u63d0\u5347\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f\u95dc\u9375\u9580\u6abb\u70ba\u4f55\uff1f", "answer": "\u300a\u77db\u982d\u68cd\u68d2\u4eba\u300b\u7684\u96e3\u5ea6\u63d0\u5347\u8a2d\u8a08\u7406\u5ff5\u662f\u9010\u6b65\u6311\u6230\u73a9\u5bb6\u3002\u95dc\u9375\u9580\u6abb\u5305\u62ec\uff1a1) \u65e9\u671f\u95dc\u5361\uff0c\u6575\u4eba\u7684\u751f\u547d\u503c\u4f4e\uff0c\u653b\u64ca\u901f\u5ea6\u6162\u30022) \u904a\u6232\u4e2d\u671f\u95dc\u5361\uff0c\u6575\u4eba\u8b8a\u5f97\u66f4\u5feb\u4e14\u6578\u91cf\u66f4\u591a\u30023) \u904a\u6232\u5f8c\u671f\u95dc\u5361\uff0cBOSS\u64c1\u6709\u8907\u96dc\u7684\u653b\u64ca\u6a21\u5f0f\u548c\u9ad8\u751f\u547d\u503c\u3002\u4f8b\u5982\uff0c\u5728\u6c99\u6f20\u95dc\u5361\u4e2d\uff0c\u60a8\u5c07\u9762\u5c0d\u6bd4\u68ee\u6797\u95dc\u5361\u66f4\u5feb\u4e14\u66f4\u5177\u4fb5\u7565\u6027\u7684\u6575\u4eba\u3002\u60f3\u50cf\u96e3\u5ea6\u63d0\u5347\u5c31\u50cf\u4e00\u7d44\u968e\u68af\uff1a\u6bcf\u4e00\u6b65\u90fd\u70ba\u60a8\u6e96\u5099\u597d\u4e0b\u4e00\u6b65\u66f4\u5177\u6311\u6230\u6027\u7684\u968e\u68af\u3002"}, {"question": "\u300a\u77db\u982d\u68cd\u68d2\u4eba\u300b\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u7684\u7cfb\u7d71\u9700\u6c42\u70ba\u4f55\uff1f\u73a9\u5bb6\u5982\u4f55\u78ba\u4fdd\u904a\u6232\u9806\u66a2\uff1f", "answer": "\u300a\u77db\u982d\u68cd\u68d2\u4eba\u300b\u7684\u7cfb\u7d71\u9700\u6c42\u4e2d\u7b49\uff0c\u4f46\u8981\u78ba\u4fdd\u904a\u6232\u9806\u66a2\uff1a1) \u5728\u96fb\u8166\u4e0a\uff0c\u96d9\u6838\u5fc3\u8655\u7406\u5668\u548c 4GB RAM \u5c31\u8db3\u5920\u30022) \u5728\u624b\u6a5f\u4e0a\uff0c\u5efa\u8b70\u81f3\u5c11 2GB RAM \u7684\u88dd\u7f6e\u548c Android 7.0 \u6216 iOS 10\u30023) \u95dc\u9589\u80cc\u666f\u61c9\u7528\u7a0b\u5f0f\u4ee5\u91cb\u653e\u8cc7\u6e90\u3002\u4f8b\u5982\uff0c\u5728\u4e2d\u968e\u624b\u6a5f\u4e0a\uff0c\u95dc\u9589\u4e0d\u4f7f\u7528\u7684\u61c9\u7528\u7a0b\u5f0f\u53ef\u4ee5\u907f\u514d\u6fc0\u70c8\u6230\u9b25\u6642\u7684\u5ef6\u9072\u3002\u60f3\u50cf\u60a8\u7684\u88dd\u7f6e\u5c31\u50cf\u4e00\u8f1b\u6c7d\u8eca\uff1a\u5b9a\u671f\u4fdd\u990a\u78ba\u4fdd\u5176\u5728\u4efb\u4f55\u9053\u8def\u4e0a\u90fd\u80fd\u9806\u5229\u904b\u884c\u3002"}, {"question": "\u300a\u77db\u982d\u68cd\u68d2\u4eba\u300b\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u79d8\u5bc6\u6216\u5f69\u86cb\u73a9\u5bb6\u53ef\u4ee5\u767c\u73fe\uff1f", "answer": "\u300a\u77db\u982d\u68cd\u68d2\u4eba\u300b\u5145\u6eff\u4e86\u96b1\u85cf\u79d8\u5bc6\u548c\u5f69\u86cb\u3002\u4e00\u500b\u503c\u5f97\u6ce8\u610f\u7684\u79d8\u5bc6\u662f\u300c\u91d1\u8272\u9577\u77db\u300d\uff0c\u53ef\u4ee5\u5728\u7194\u5ca9\u95dc\u5361\u5b8c\u6210\u96b1\u85cf\u6311\u6230\u6642\u627e\u5230\u3002\u8981\u89e3\u9396\u5b83\uff1a\u6b65\u9a5f1 - \u627e\u5230\u53ef\u7834\u58de\u7246\u58c1\u5f8c\u9762\u7684\u96b1\u85cf\u6d1e\u7a74\u3002\u6b65\u9a5f2 - \u6253\u6557\u6d1e\u7a74\u5167\u7684\u8ff7\u4f60BOSS\u3002\u6b65\u9a5f3 - \u7372\u5f97\u91d1\u8272\u9577\u77db\uff0c\u5b83\u6703\u9020\u6210\u984d\u5916\u50b7\u5bb3\u3002\u4f8b\u5982\uff0c\u5728\u6700\u7d42BOSS\u6230\u4e2d\u4f7f\u7528\u91d1\u8272\u9577\u77db\u53ef\u4ee5\u986f\u8457\u964d\u4f4e\u6230\u9b25\u96e3\u5ea6\u3002\u60f3\u50cf\u9019\u4e9b\u79d8\u5bc6\u5c31\u50cf\u57cb\u85cf\u7684\u5bf6\u85cf\uff1a\u60a8\u5c0b\u627e\u5f97\u8d8a\u6df1\u5165\uff0c\u734e\u52f5\u5c31\u8d8a\u5927\u3002"}]
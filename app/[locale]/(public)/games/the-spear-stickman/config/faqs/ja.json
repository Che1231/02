[{"question": "The Spear Stickman\u306f\u3069\u3046\u3084\u3063\u3066\u904a\u3076\u306e\u3067\u3059\u304b\uff1f \u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u5411\u3051\u5165\u9580\u30ac\u30a4\u30c9\uff1a\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u79fb\u52d5\u3068\u57fa\u672c\u653b\u6483\u65b9\u6cd5\u306f\uff1f", "answer": "\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u65b9\u3005\u306b\u3068\u3063\u3066\u3001\u307e\u305a\u306f\u300eThe Spear Stickman\u300f\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u79fb\u52d5\u306f\u753b\u9762\u5de6\u4e0b\u306e\u4eee\u60f3\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u3067\u5236\u5fa1\u3055\u308c\u3001\u706b\u67f4\u4eba\u5f62\u3092\u4e0a\u4e0b\u5de6\u53f3\u306b\u52d5\u304b\u3057\u3001\u969c\u5bb3\u7269\u3092\u56de\u907f\u3057\u307e\u3059\u3002\u653b\u6483\u65b9\u6cd5\u306f\u4e3b\u306b2\u7a2e\u985e\u3042\u308a\u307e\u3059\u3002\u753b\u9762\u53f3\u5074\u306b\u3042\u308b\u653b\u6483\u30dc\u30bf\u30f3\u3092\u30bf\u30c3\u30d7\u3057\u3066\u666e\u901a\u653b\u6483\u3092\u884c\u3046\u304b\u3001\u653b\u6483\u30dc\u30bf\u30f3\u3092\u9577\u62bc\u3057\u3057\u3066\u5f37\u529b\u306a\u30b9\u30ad\u30eb\u3092\u653e\u51fa\u3057\u307e\u3059\u3002\u521d\u671f\u6bb5\u968e\u3067\u306f\u3001\u307e\u305a\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u64cd\u4f5c\u306b\u6163\u308c\u3001\u7a81\u304d\u523a\u3059\u7bc4\u56f2\u3092\u628a\u63e1\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u6700\u521d\u306e\u30c0\u30f3\u30b8\u30e7\u30f3\u306b\u767b\u5834\u3059\u308b\u30b9\u30e9\u30a4\u30e0\u3092\u5012\u3059\u305f\u3081\u306b\u306f\u3001\u6b63\u78ba\u306a\u653b\u6483\u3067\u3001\u30b9\u30e9\u30a4\u30e0\u304c\u8fd1\u3065\u3044\u3066\u304f\u308b\u524d\u306b\u5012\u3059\u7df4\u7fd2\u3092\u3057\u307e\u3057\u3087\u3046\u3002\u907f\u3051\u3089\u308c\u306a\u3044\u969c\u5bb3\u7269\u306b\u906d\u9047\u3057\u305f\u5834\u5408\u3001\u84c4\u529b\u30b9\u30ad\u30eb\u3092\u4f7f\u7528\u3057\u3066\u4e00\u5ea6\u306b\u30af\u30ea\u30a2\u3059\u308b\u3053\u3068\u3092\u8a66\u307f\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u306a\u305c\u79c1\u306eSpear Stickman\u306f\u653b\u6483\u3092\u53d7\u3051\u7d9a\u3051\u3066\u3044\u308b\u306e\u3067\u3059\u304b\uff1fThe Spear Stickman\u3067\u306e\u751f\u5b58\u7387\u3092\u9ad8\u3081\u308b\u306b\u306f\uff1f", "answer": "\u300eThe Spear Stickman\u300f\u306b\u304a\u3051\u308b\u751f\u5b58\u7387\u3092\u9ad8\u3081\u308b\u9375\u306f\u3001\u79fb\u52d5\u3068\u30b9\u30ad\u30eb\u306e\u9069\u5207\u306a\u904b\u7528\u3067\u3059\u3002STEP 1\uff1a\u6b63\u78ba\u306a\u79fb\u52d5\u3067\u307b\u3068\u3093\u3069\u306e\u6575\u306e\u653b\u6483\u3092\u56de\u907f\u3067\u304d\u307e\u3059\u3002\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u64cd\u4f5c\u306e\u7df4\u7fd2\u3092\u91cd\u306d\u3001\u6ed1\u8d70\u6280\u8853\u3092\u30de\u30b9\u30bf\u30fc\u3057\u307e\u3057\u3087\u3046\u3002STEP 2\uff1a\u30b9\u30ad\u30eb\u306b\u3064\u3044\u3066\u306f\u3001\u521d\u671f\u6bb5\u968e\u3067\u306f\u9632\u5fa1\u7cfb\u306e\u30b9\u30ad\u30eb(\u4f8b\u3048\u3070\u3001\u6700\u5927\u4f53\u529b\u5897\u52a0\u3084\u9632\u5fa1\u529b\u5411\u4e0a)\u3092\u512a\u5148\u7684\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u307e\u3057\u3087\u3046\u3002STEP 3\uff1a\u6575\u306e\u653b\u6483\u30d1\u30bf\u30fc\u30f3\u3092\u89b3\u5bdf\u3057\u3001\u653b\u6483\u306e\u9699\u3092\u7a81\u3044\u3066\u53cd\u6483\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u5f13\u5175\u306e\u3088\u3046\u306a\u9060\u8ddd\u96e2\u653b\u6483\u578b\u306e\u6575\u306e\u5834\u5408\u3001\u6ed1\u8d70\u3067\u77e2\u3092\u907f\u3051\u3001\u7d20\u65e9\u304f\u63a5\u8fd1\u3057\u3066\u653b\u6483\u3057\u307e\u3057\u3087\u3046\u3002\u307e\u305f\u3001\u5730\u5f62\u3092\u6d3b\u7528\u3059\u308b\u3053\u3068\u3082\u751f\u5b58\u7387\u3092\u9ad8\u3081\u308b\u4e0a\u3067\u91cd\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u969c\u5bb3\u7269\u306e\u5f8c\u308d\u306b\u96a0\u308c\u308b\u3053\u3068\u3067\u9060\u8ddd\u96e2\u653b\u6483\u304b\u3089\u306e\u30c0\u30e1\u30fc\u30b8\u3092\u56de\u907f\u3067\u304d\u307e\u3059\u3002"}, {"question": "The Spear Stickman\u306e\u6b66\u5668\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u304b\uff1f\u6700\u9069\u306a\u6b66\u5668\u3092\u9078\u3076\u306b\u306f\uff1f", "answer": "\u300eThe Spear Stickman\u300f\u306f\u3001\u69d8\u3005\u306a\u6b66\u5668\u9078\u629e\u3092\u63d0\u4f9b\u3057\u3066\u304a\u308a\u3001\u5404\u6b66\u5668\u306b\u306f\u7570\u306a\u308b\u5c5e\u6027\u3068\u653b\u6483\u65b9\u6cd5\u304c\u3042\u308a\u307e\u3059\u3002\u6b66\u5668\u306f\u4e3b\u306b\u77ed\u69cd\u3001\u9577\u69cd\u3001\u91cd\u69cd\u306a\u3069\u3001\u6b66\u5668\u306e\u7a2e\u985e\u304c\u533a\u5225\u3055\u308c\u3066\u304a\u308a\u3001\u6b66\u5668\u306e\u5c5e\u6027\u306b\u306f\u653b\u6483\u529b\u3001\u653b\u6483\u901f\u5ea6\u3001\u653b\u6483\u7bc4\u56f2\u306a\u3069\u304c\u3042\u308a\u307e\u3059\u3002\u6b66\u5668\u3092\u9078\u629e\u3059\u308b\u969b\u306b\u306f\u3001\u81ea\u5206\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u3068\u30b9\u30c6\u30fc\u30b8\u306e\u7279\u5fb4\u306b\u57fa\u3065\u3044\u3066\u9078\u629e\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u77ed\u69cd\u306f\u653b\u6483\u901f\u5ea6\u304c\u901f\u304f\u3001\u6a5f\u654f\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u9069\u3057\u3066\u3044\u307e\u3059\u3002\u9577\u69cd\u306f\u653b\u6483\u7bc4\u56f2\u304c\u5e83\u304f\u3001\u9060\u8ddd\u96e2\u6d88\u8017\u6226\u306b\u9069\u3057\u3066\u3044\u307e\u3059\u3002\u91cd\u69cd\u306f\u653b\u6483\u529b\u306f\u9ad8\u3044\u3067\u3059\u304c\u653b\u6483\u901f\u5ea6\u304c\u9045\u304f\u3001\u7206\u767a\u7684\u306a\u653b\u6483\u306b\u9069\u3057\u3066\u3044\u307e\u3059\u3002\u521d\u671f\u6bb5\u968e\u3067\u306f\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u9577\u69cd\u306e\u6b66\u5668\u306e\u4f7f\u7528\u3092\u63a8\u5968\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u6bd4\u8f03\u7684\u7fd2\u5f97\u3057\u3084\u3059\u304f\u3001\u653b\u5b88\u306e\u4e21\u65b9\u3092\u6e80\u305f\u3057\u307e\u3059\u3002\u6b66\u5668\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u305f\u308a\u3001\u65b0\u305f\u306a\u6b66\u5668\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u3066\u3001\u69d8\u3005\u306a\u6226\u95d8\u30b9\u30bf\u30a4\u30eb\u3092\u4f53\u9a13\u3067\u304d\u307e\u3059\u3002\u6700\u9ad8\u306e\u4e00\u3064\u306e\u6b66\u5668\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u81ea\u5206\u306b\u6700\u9069\u306a\u6b66\u5668\u3060\u3051\u304c\u3042\u308b\u306e\u3067\u3059\u3002"}, {"question": "Spear Stickman\u306e\u30b9\u30ad\u30eb\u5f37\u5316\u512a\u5148\u9806\u4f4d\uff1aThe Spear Stickman\u3067\u6700\u3082\u5f37\u5316\u3059\u3079\u304d\u30b9\u30ad\u30eb\u3068\u305d\u306e\u6642\u671f\u3068\u306f\uff1f", "answer": "\u300eThe Spear Stickman\u300f\u306b\u304a\u3044\u3066\u30b9\u30ad\u30eb\u306e\u5f37\u5316\u306f\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u521d\u671f\u6bb5\u968e(\u30ec\u30d9\u30eb1\uff5e20)\u3067\u306f\u3001\u751f\u5b58\u529b\u3092\u78ba\u4fdd\u3059\u308b\u305f\u3081\u306b\u751f\u5b58\u7cfb\u30b9\u30ad\u30eb(\u4f53\u529b\u3001\u9632\u5fa1\u529b)\u3092\u512a\u5148\u7684\u306b\u5f37\u5316\u3057\u307e\u3057\u3087\u3046\u3002\u4e2d\u76e4(\u30ec\u30d9\u30eb21\uff5e50)\u3067\u306f\u3001\u653b\u6483\u529b\u7cfb\u306e\u30b9\u30ad\u30eb(\u4f8b\u3048\u3070\u3001\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u7387\u3001\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30c0\u30e1\u30fc\u30b8)\u3092\u5f37\u5316\u3057\u59cb\u3081\u307e\u3057\u3087\u3046\u3002\u5f8c\u671f(\u30ec\u30d9\u30eb50\u4ee5\u4e0a)\u304b\u3089\u306f\u3001\u500b\u3005\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u5408\u308f\u305b\u3066\u30b9\u30ad\u30eb\u3092\u9078\u629e\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u79fb\u52d5\u901f\u5ea6\u306e\u5411\u4e0a\u3084\u30b9\u30ad\u30eb\u30af\u30fc\u30eb\u30bf\u30a4\u30e0\u306e\u77ed\u7e2e\u306a\u3069\u3067\u3059\u3002\u30b9\u30ad\u30eb\u5f37\u5316\u306e\u512a\u5148\u9806\u4f4d\u306f\u3001\u4ee5\u4e0b\u3092\u63a8\u5968\u3057\u307e\u3059\u30021. \u4f53\u529b/\u9632\u5fa1\u529b(\u521d\u671f) > 2. \u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u7387/\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30c0\u30e1\u30fc\u30b8(\u4e2d\u76e4) > 3. \u79fb\u52d5\u901f\u5ea6/\u30af\u30fc\u30eb\u30bf\u30a4\u30e0\u77ed\u7e2e(\u5f8c\u671f)\u3002\u4f8b\u3048\u3070\u3001\u84c4\u529b\u4e2d\u306b\u30c0\u30e1\u30fc\u30b8\u8efd\u6e1b\u3084\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u5f37\u5316\u3068\u3044\u3063\u305f\u30b9\u30ad\u30eb\u306f\u3001\u64cd\u4f5c\u306e\u5931\u6557\u7387\u3092\u5927\u5e45\u306b\u4e0b\u3052\u308b\u52b9\u679c\u304c\u3042\u308a\u307e\u3059\u3002\u81ea\u8eab\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u5408\u308f\u305b\u3066\u6700\u9069\u306a\u30b9\u30ad\u30eb\u30c4\u30ea\u30fc\u3092\u69cb\u7bc9\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "The Spear Stickman\u306e\u9054\u6210\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u304b\uff1f\u6311\u6226\u3059\u308b\u4fa1\u5024\u306e\u3042\u308b\u96a0\u3057\u5b9f\u7e3e\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u300eThe Spear Stickman\u300f\u306f\u3001\u5145\u5b9f\u3057\u305f\u9054\u6210\u30b7\u30b9\u30c6\u30e0\u3092\u6301\u3063\u3066\u304a\u308a\u3001\u9054\u6210\u3059\u308b\u3053\u3068\u3067\u5831\u916c\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u901a\u5e38\u306e\u30af\u30ea\u30a2\u9054\u6210\u3001\u6575\u6483\u7834\u9054\u6210\u4ee5\u5916\u306b\u3082\u3001\u767a\u898b\u3059\u308b\u4fa1\u5024\u306e\u3042\u308b\u96a0\u3057\u5b9f\u7e3e\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30ce\u30fc\u30c0\u30e1\u30fc\u30b8\u30af\u30ea\u30a2\u300d\u3068\u3044\u3046\u5b9f\u7e3e\u306f\u3001\u6307\u5b9a\u306e\u30b9\u30c6\u30fc\u30b8\u3092\u4e00\u5207\u30c0\u30e1\u30fc\u30b8\u3092\u53d7\u3051\u305a\u306b\u30af\u30ea\u30a2\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u305f\u3081\u3001\u30b9\u30c6\u30fc\u30b8\u5730\u5f62\u3084\u6575\u306e\u653b\u6483\u30d1\u30bf\u30fc\u30f3\u3092\u7406\u89e3\u3057\u3001\u79fb\u52d5\u3084\u30b9\u30ad\u30eb\u3092\u3046\u307e\u304f\u6d3b\u7528\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u300c\u5b8c\u74a7\u306a\u7a81\u304d\u523a\u3057\u300d\u3068\u3044\u3046\u5b9f\u7e3e\u306f\u3001\u6575\u3092\u9023\u7d9a\u3057\u3066\u6b63\u78ba\u306b\u653b\u6483\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u96a0\u3057\u5b9f\u7e3e\u306b\u6311\u6226\u3059\u308b\u306b\u306f\u3001\u6839\u6c17\u3068\u6280\u8853\u304c\u5fc5\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u300c\u30ce\u30fc\u30c0\u30e1\u30fc\u30b8\u30af\u30ea\u30a2\u300d\u306e\u5834\u5408\u306f\u3001\u30de\u30c3\u30d7\u5730\u5f62\u3084\u6575\u306e\u653b\u6483\u30d1\u30bf\u30fc\u30f3\u3092\u7406\u89e3\u3057\u3001\u79fb\u52d5\u3068\u30b9\u30ad\u30eb\u3092\u5de7\u307f\u306b\u4f7f\u7528\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u901a\u5e38\u30e2\u30fc\u30c9\u306e\u30af\u30ea\u30a2\u5f8c\u3001\u56f0\u96e3\u30e2\u30fc\u30c9\u306e\u96a0\u3057\u5b9f\u7e3e\u306b\u30c1\u30e3\u30ec\u30f3\u30b8\u3059\u308b\u3053\u3068\u3092\u304a\u52e7\u3081\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306f\u3001\u9054\u6210\u611f\u3092\u5473\u308f\u3048\u308b\u3060\u3051\u3067\u306a\u304f\u3001\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u3088\u308a\u6df1\u304f\u7406\u89e3\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u96a0\u3057\u5b9f\u7e3e\u306e\u653b\u7565\u6cd5\u306f\u3001\u30b2\u30fc\u30e0\u306e\u30d5\u30a9\u30fc\u30e9\u30e0\u3084\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u3092\u901a\u3058\u3066\u5f97\u3089\u308c\u308b\u3067\u3057\u3087\u3046\u3002"}, {"question": "The Spear Stickman\u306f\u3069\u306e\u3088\u3046\u306b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u306e\u30c7\u30fc\u30bf\u540c\u671f\u3092\u5b9f\u73fe\u3057\u3066\u3044\u307e\u3059\u304b\uff1fAndroid\u3068iOS\u306e\u30c7\u30fc\u30bf\u306f\u76f8\u4e92\u306b\u9023\u643a\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u73fe\u5728\u3001\u300eThe Spear Stickman\u300f\u306fAndroid\u3068iOS\u9593\u306e\u76f4\u63a5\u7684\u306a\u30c7\u30fc\u30bf\u9023\u643a\u306f\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u306a\u3044\u53ef\u80fd\u6027\u304c\u9ad8\u3044\u3067\u3059\u3002\u901a\u5e38\u3001\u30b2\u30fc\u30e0\u306e\u9032\u6357\u72b6\u6cc1\u306f\u3001\u7279\u5b9a\u306e\u30b2\u30fc\u30e0\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\uff08Google Play\u3084Game Center\u306a\u3069\uff09\u306b\u7d10\u3065\u3051\u3066\u4fdd\u5b58\u3055\u308c\u307e\u3059\u3002\u30b2\u30fc\u30e0\u304c\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u306e\u30c7\u30fc\u30bf\u540c\u671f\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u308b\u5834\u5408\u3001\u901a\u5e38\u306fFacebook\u3084Twitter\u306a\u3069\u306e\u30b5\u30fc\u30c9\u30d1\u30fc\u30c6\u30a3\u30fc\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30b2\u30fc\u30e0\u8a2d\u5b9a\u3067\u9023\u643a\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3082\u3057\u5225\u306e\u30c7\u30d0\u30a4\u30b9\u3084\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u79fb\u884c\u3057\u305f\u3044\u5834\u5408\u306f\u3001\u540c\u3058\u30b2\u30fc\u30e0\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u4f7f\u7528\u3057\u3066\u30ed\u30b0\u30a4\u30f3\u3057\u3001\u30b2\u30fc\u30e0\u306e\u9032\u6357\u72b6\u6cc1\u3092\u5fa9\u5143\u3067\u304d\u308b\u304b\u8a66\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u5fa9\u5143\u3067\u304d\u306a\u3044\u5834\u5408\u306f\u3001\u30b2\u30fc\u30e0\u30ab\u30b9\u30bf\u30de\u30fc\u30b5\u30fc\u30d3\u30b9\u306b\u76f8\u8ac7\u3059\u308b\u3053\u3068\u304c\u63a8\u5968\u3055\u308c\u307e\u3059\u3002"}, {"question": "The Spear Stickman\u306e\u6570\u5b57\u30b7\u30b9\u30c6\u30e0\u306e\u6df1\u3044\u89e3\u6790\uff1a\u653b\u6483\u529b\u3001\u9632\u5fa1\u529b\u306a\u3069\u306e\u5c5e\u6027\u304c\u6226\u95d8\u7d50\u679c\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3059\u308b\u304b\uff1f", "answer": "\u300eThe Spear Stickman\u300f\u306e\u6226\u95d8\u7d50\u679c\u306b\u306f\u3001\u653b\u6483\u529b\u3001\u9632\u5fa1\u529b\u3001\u4f53\u529b\u3001\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u7387\u3001\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30c0\u30e1\u30fc\u30b8\u306a\u3069\u3001\u3055\u307e\u3056\u307e\u306a\u6570\u5024\u5c5e\u6027\u304c\u5f71\u97ff\u3057\u307e\u3059\u3002\u653b\u6483\u529b\u306f\u6575\u306b\u4e0e\u3048\u308b\u30c0\u30e1\u30fc\u30b8\u91cf\u3092\u6c7a\u5b9a\u3057\u307e\u3059\u3002\u9632\u5fa1\u529b\u306f\u53d7\u3051\u308b\u30c0\u30e1\u30fc\u30b8\u91cf\u3092\u8efd\u6e1b\u3057\u307e\u3059\u3002\u4f53\u529b\u306f\u751f\u5b58\u80fd\u529b\u3092\u793a\u3057\u3001\u4f53\u529b\u30bc\u30ed\u306b\u306a\u308b\u3068\u30b2\u30fc\u30e0\u30aa\u30fc\u30d0\u30fc\u3068\u306a\u308a\u307e\u3059\u3002\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u7387\u306f\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u3059\u308b\u78ba\u7387\u3092\u793a\u3057\u3001\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30c0\u30e1\u30fc\u30b8\u306f\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u6642\u306e\u8ffd\u52a0\u30c0\u30e1\u30fc\u30b8\u91cf\u3092\u793a\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u5c5e\u6027\u306f\u8907\u96d1\u306b\u7d61\u307f\u5408\u3063\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u9ad8\u3044\u653b\u6483\u529b\u306f\u6575\u3092\u7d20\u65e9\u304f\u5012\u3057\u3001\u53d7\u3051\u308b\u30c0\u30e1\u30fc\u30b8\u3092\u6e1b\u3089\u3059\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u9ad8\u3044\u9632\u5fa1\u529b\u306f\u6226\u95d8\u3092\u3088\u308a\u9577\u304f\u7d9a\u3051\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u6570\u5024\u5c5e\u6027\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u88c5\u5099\u3084\u30b9\u30ad\u30eb\u3092\u3088\u308a\u52b9\u679c\u7684\u306b\u9078\u629e\u3057\u3066\u6226\u95d8\u529b\u3092\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u5c5e\u6027\u306e\u5177\u4f53\u7684\u306a\u6570\u5024\u306f\u3001\u30b2\u30fc\u30e0\u5185\u5c5e\u6027\u30d1\u30cd\u30eb\u3067\u78ba\u8a8d\u3067\u304d\u307e\u3059\u3002\u81ea\u8eab\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u5408\u308f\u305b\u3066\u5c5e\u6027\u3092\u8abf\u6574\u3059\u308b\u3053\u3068\u3092\u5fd8\u308c\u305a\u306b\u3002"}, {"question": "The Spear Stickman\u306e\u96a0\u3057\u30b9\u30c6\u30fc\u30b8\u3084\u79d8\u5bc6\u306e\u30a8\u30ea\u30a2\u306f\u3069\u3053\u306b\u3042\u308a\u307e\u3059\u304b\uff1f\u3059\u3079\u3066\u306e\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u306b\u306f\uff1f", "answer": "\u300eThe Spear Stickman\u300f\u306b\u306f\u3001\u96a0\u3057\u30b9\u30c6\u30fc\u30b8\u3084\u79d8\u5bc6\u306e\u30a8\u30ea\u30a2\u304c\u3042\u308a\u3001\u7279\u5b9a\u306e\u6761\u4ef6\u3092\u6e80\u305f\u3059\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u6761\u4ef6\u306b\u306f\u3001\u7279\u5b9a\u306e\u30b9\u30c6\u30fc\u30b8\u3067\u7279\u5b9a\u306e\u30bf\u30b9\u30af\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3001\u7279\u5b9a\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3084\u88c5\u5099\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u3001\u307e\u305f\u306f\u7279\u5b9a\u306e\u5834\u6240\u306b\u3042\u308b\u96a0\u3055\u308c\u305f\u4ed5\u639b\u3051\u3092\u30c8\u30ea\u30ac\u30fc\u3059\u308b\u3053\u3068\u306a\u3069\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u5177\u4f53\u7684\u306a\u30a2\u30f3\u30ed\u30c3\u30af\u65b9\u6cd5\u306f\u3001\u30d0\u30fc\u30b8\u30e7\u30f3\u306b\u3088\u3063\u3066\u7570\u306a\u308b\u5834\u5408\u304c\u3042\u308b\u305f\u3081\u3001\u30b2\u30fc\u30e0\u306e\u30d5\u30a9\u30fc\u30e9\u30e0\u3084\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u306e\u653b\u7565\u60c5\u5831\u3092\u53c2\u8003\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u3042\u308b\u30d0\u30fc\u30b8\u30e7\u30f3\u3067\u306f\u3001\u7279\u5b9a\u306e\u30b9\u30c6\u30fc\u30b8\u306e\u96a0\u3055\u308c\u305f\u6587\u69d8\u3092\u96c6\u3081\u3001\u3059\u3079\u3066\u306e\u6587\u69d8\u3092\u96c6\u3081\u308b\u3053\u3068\u3067\u96a0\u3057\u30b9\u30c6\u30fc\u30b8\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u96a0\u3057\u30b9\u30c6\u30fc\u30b8\u306f\u901a\u5e38\u3001\u96e3\u6613\u5ea6\u304c\u9ad8\u304f\u3001\u5831\u916c\u3082\u8c4a\u5bcc\u3067\u3059\u3002\u96a0\u3057\u30b9\u30c6\u30fc\u30b8\u306b\u6311\u6226\u3059\u308b\u3053\u3068\u3067\u3001\u8cb4\u91cd\u306a\u88c5\u5099\u3092\u5165\u624b\u3059\u308b\u3060\u3051\u3067\u306a\u304f\u3001\u72ec\u7279\u306a\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u5f97\u3089\u308c\u308b\u3067\u3057\u3087\u3046\u3002"}, {"question": "\u300eThe Spear Stickman\u300f\u306e\u30dc\u30b9\u6226\u306e\u30c7\u30b6\u30a4\u30f3\u30b3\u30f3\u30bb\u30d7\u30c8\u306f\uff1f\u69d8\u3005\u306a\u30dc\u30b9\u306b\u5bfe\u3057\u3066\u52b9\u679c\u7684\u306a\u6226\u95d8\u6226\u7565\u3092\u7acb\u3066\u308b\u306b\u306f\uff1f", "answer": "\u300eThe Spear Stickman\u300f\u306e\u30dc\u30b9\u6226\u306f\u3001\u901a\u5e38\u3001\u72ec\u81ea\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3068\u653b\u6483\u30d1\u30bf\u30fc\u30f3\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002\u3055\u307e\u3056\u307e\u306a\u30dc\u30b9\u306b\u5bfe\u3057\u3066\u3001\u7570\u306a\u308b\u6226\u95d8\u6226\u7565\u3092\u7acb\u3066\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002STEP 1\uff1a\u30dc\u30b9\u306e\u653b\u6483\u30d1\u30bf\u30fc\u30f3\u3092\u89b3\u5bdf\u3057\u3001\u653b\u6483\u7bc4\u56f2\u3001\u653b\u6483\u901f\u5ea6\u3001\u653b\u6483\u983b\u5ea6\u306a\u3069\u3092\u628a\u63e1\u3057\u307e\u3059\u3002STEP 2\uff1a\u30dc\u30b9\u306e\u5f31\u70b9\u3092\u898b\u3064\u3051\u3066\u3001\u4f8b\u3048\u3070\u3001\u653b\u6483\u3092\u53d7\u3051\u305f\u5f8c\u306b\u4e00\u6642\u7684\u306b\u786c\u76f4\u3059\u308b\u3001\u307e\u305f\u306f\u7279\u5b9a\u306e\u5c5e\u6027\u3078\u306e\u653b\u6483\u306b\u5f31\u3044\u304b\u306a\u3069\u306e\u5f31\u70b9\u3067\u3059\u3002STEP 3\uff1a\u30dc\u30b9\u306e\u7279\u5fb4\u3092\u8e0f\u307e\u3048\u3001\u9069\u5207\u306a\u6b66\u5668\u3068\u30b9\u30ad\u30eb\u3092\u9078\u629e\u3057\u3001\u79fb\u52d5\u3068\u56de\u907f\u30b9\u30ad\u30eb\u3092\u6d3b\u7528\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u3042\u308b\u30dc\u30b9\u306e\u653b\u6483\u7bc4\u56f2\u306f\u5e83\u3044\u304c\u653b\u6483\u901f\u5ea6\u306f\u9045\u3044\u306e\u3067\u3001\u79fb\u52d5\u3067\u653b\u6483\u3092\u907f\u3051\u3001\u30dc\u30b9\u306e\u653b\u6483\u306e\u9593\u306b\u53cd\u6483\u3057\u307e\u3059\u3002\u9060\u8ddd\u96e2\u6b66\u5668\u3092\u4f7f\u3063\u3066\u6d88\u8017\u6226\u306b\u6301\u3061\u8fbc\u3080\u3001\u307e\u305f\u306f\u3001\u30dc\u30b9\u3092\u62d8\u675f\u3059\u308b\u30b9\u30ad\u30eb\u3092\u6d3b\u7528\u3059\u308b\u306e\u3082\u6709\u52b9\u3067\u3059\u3002"}, {"question": "The Spear Stickman\u5f8c\u671f\u306b\u304a\u3044\u3066\u3001\u6226\u95d8\u529b\u3092\u3069\u306e\u3088\u3046\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f\u6b66\u5668\u3084\u30b9\u30ad\u30eb\u306e\u5f37\u5316\u4ee5\u5916\u306b\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u80fd\u529b\u3092\u9ad8\u3081\u308b\u65b9\u6cd5\u306f\u3042\u308b\u306e\u3067\u3057\u3087\u3046\u304b\uff1f", "answer": "\u300eThe Spear Stickman\u300f\u5f8c\u671f\u306b\u304a\u3044\u3066\u3001\u6b66\u5668\u3084\u30b9\u30ad\u30eb\u306e\u5f37\u5316\u306b\u52a0\u3048\u3066\u3001\u4ee5\u4e0b\u306e\u65b9\u6cd5\u3067\u6226\u95d8\u529b\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u30021. \u30bb\u30c3\u30c8\u88c5\u5099\uff1a\u30b2\u30fc\u30e0\u5185\u306e\u30bb\u30c3\u30c8\u88c5\u5099\u3092\u96c6\u3081\u3001\u8ffd\u52a0\u306e\u5c5e\u6027\u30dc\u30fc\u30ca\u30b9\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u7570\u306a\u308b\u30bb\u30c3\u30c8\u88c5\u5099\u306f\u7570\u306a\u308b\u5c5e\u6027\u3092\u6301\u3061\u3001\u81ea\u5206\u306e\u30cb\u30fc\u30ba\u306b\u5408\u308f\u305b\u3066\u9078\u629e\u3067\u304d\u307e\u3059\u30022. \u5b9d\u77f3\u306e\u57cb\u3081\u8fbc\u307f\uff1a\u88c5\u5099\u306b\u5b9d\u77f3\u3092\u57cb\u3081\u8fbc\u3080\u3053\u3068\u3067\u3001\u88c5\u5099\u306e\u5c5e\u6027\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u5b9d\u77f3\u306f\u3001\u30b2\u30fc\u30e0\u5185\u306e\u30a4\u30d9\u30f3\u30c8\u3084\u30b7\u30e7\u30c3\u30d7\u3092\u901a\u3058\u3066\u5165\u624b\u3067\u304d\u307e\u3059\u30023. \u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30ec\u30d9\u30eb\u306e\u5411\u4e0a\uff1a\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30ec\u30d9\u30eb\u304c\u9ad8\u304f\u306a\u308b\u3068\u3001\u5c5e\u6027\u3082\u5411\u4e0a\u3057\u307e\u3059\u3002\u30bf\u30b9\u30af\u306e\u5b8c\u4e86\u3084\u30c0\u30f3\u30b8\u30e7\u30f3\u6311\u6226\u306a\u3069\u3092\u901a\u3058\u3066\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30ec\u30d9\u30eb\u3092\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u6bd4\u8f03\u3057\u3066\u307f\u308b\u3068\u3001\u30bb\u30c3\u30c8\u88c5\u5099\u306b\u3088\u308b\u5229\u76ca\u306f\u901a\u5e38\u3001\u500b\u3005\u306e\u88c5\u5099\u304b\u3089\u5f97\u3089\u308c\u308b\u5c5e\u6027\u3088\u308a\u3082\u9ad8\u304f\u3001\u30bb\u30c3\u30c8\u88c5\u5099\u306e\u53ce\u96c6\u3092\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u307e\u305f\u3001\u30b2\u30fc\u30e0\u30a4\u30d9\u30f3\u30c8\u3092\u5b9a\u671f\u7684\u306b\u53c2\u52a0\u3059\u308b\u3053\u3068\u3067\u3001\u8cb4\u91cd\u306a\u8cc7\u6e90\u3092\u7372\u5f97\u3057\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u6210\u9577\u3092\u52a0\u901f\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}]
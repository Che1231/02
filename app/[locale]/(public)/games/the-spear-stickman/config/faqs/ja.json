[{"question": "\u300e\u69cd\u306e\u68d2\u4eba\u9593\u300f\u3067\u521d\u5fc3\u8005\u304c\u57fa\u672c\u64cd\u4f5c\u3092\u7d20\u65e9\u304f\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "\u300e\u69cd\u306e\u68d2\u4eba\u9593\u300f\u3067\u57fa\u672c\u64cd\u4f5c\u3092\u7d20\u65e9\u304f\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u79fb\u52d5\u7528\u306e\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u3068\u69cd\u3092\u6295\u3052\u308b\u653b\u6483\u30dc\u30bf\u30f3\u306b\u6163\u308c\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u521d\u671f\u306e\u9aa8\u683c\u5175\u306e\u3088\u3046\u306a\u52d5\u304f\u6575\u3092\u653b\u6483\u3059\u308b\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u7df4\u7fd2\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6575\u306e\u653b\u6483\u3092\u304b\u308f\u3059\u56de\u907f\u30dc\u30bf\u30f3\u3092\u4f7f\u3044\u3001\u751f\u5b58\u3059\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u306a\u30b9\u30ad\u30eb\u3092\u7fd2\u5f97\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u9aa8\u683c\u5175\u306e\u3086\u3063\u304f\u308a\u3068\u79fb\u52d5\u3059\u308b\u69cd\u3092\u304b\u308f\u3057\u306a\u304c\u3089\u53cd\u6483\u3059\u308b\u7df4\u7fd2\u304c\u3067\u304d\u307e\u3059\u3002\u81ea\u8ee2\u8eca\u306b\u4e57\u308b\u306e\u3068\u540c\u3058\u3067\u3001\u6700\u521d\u306f\u3086\u3063\u304f\u308a\u3068\u3001\u5f90\u3005\u306b\u30b9\u30d4\u30fc\u30c9\u3068\u7cbe\u5ea6\u3092\u9ad8\u3081\u3066\u3044\u304d\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u300e\u69cd\u306e\u68d2\u4eba\u9593\u300f\u3067\u69cd\u3092\u5f37\u5316\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u3069\u306e\u5f37\u5316\u3092\u512a\u5148\u3059\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u300e\u69cd\u306e\u68d2\u4eba\u9593\u300f\u3067\u69cd\u3092\u5f37\u5316\u3059\u308b\u3053\u3068\u306f\u3001\u3088\u308a\u96e3\u3057\u3044\u30ec\u30d9\u30eb\u3092\u653b\u7565\u3059\u308b\u305f\u3081\u306e\u91cd\u8981\u306a\u30b9\u30c6\u30c3\u30d7\u3067\u3059\u3002\u512a\u5148\u3059\u308b\u5f37\u5316\u306f\u4ee5\u4e0b\u306e\u901a\u308a\u3067\u3059\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u6575\u3092\u3088\u308a\u65e9\u304f\u5012\u3059\u305f\u3081\u306b\u69cd\u306e\u30c0\u30e1\u30fc\u30b8\u3092\u5897\u3084\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u3088\u308a\u591a\u304f\u306e\u6575\u3092\u76f8\u624b\u306b\u52b9\u7387\u3088\u304f\u5bfe\u51e6\u3059\u308b\u305f\u3081\u306b\u653b\u6483\u901f\u5ea6\u3092\u5411\u4e0a\u3055\u305b\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7fa4\u8846\u5236\u5fa1\u306e\u305f\u3081\u306e\u7206\u767a\u6027\u69cd\u306a\u3069\u306e\u7279\u6b8a\u80fd\u529b\u3092\u89e3\u7981\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u4e2d\u76e4\u306e\u7802\u6f20\u30b9\u30c6\u30fc\u30b8\u3067\u306f\u3001\u7206\u767a\u6027\u69cd\u3078\u306e\u5f37\u5316\u306b\u3088\u308a\u6575\u306e\u7fa4\u308c\u3092\u7d20\u65e9\u304f\u6392\u9664\u3067\u304d\u307e\u3059\u3002\u3042\u306a\u305f\u306e\u69cd\u306f\u3001\u30b9\u30ad\u30eb\u3068\u3068\u3082\u306b\u9032\u5316\u3059\u308b\u30c4\u30fc\u30eb\u3067\u3059\u3002\u9032\u6b69\u3059\u308b\u306b\u3064\u308c\u3066\u3001\u3088\u308a\u92ed\u304f\u3001\u3088\u308a\u591a\u7528\u9014\u306b\u306a\u308a\u307e\u3059\u3002"}, {"question": "\u300e\u69cd\u306e\u68d2\u4eba\u9593\u300f\u306e\u68d2\u4eba\u9593\u30af\u30e9\u30b9\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u521d\u5fc3\u8005\u306b\u3068\u3063\u3066\u6700\u9069\u306a\u30af\u30e9\u30b9\u306f\u3069\u308c\u3067\u3059\u304b\uff1f", "answer": "\u300e\u69cd\u306e\u68d2\u4eba\u9593\u300f\u306b\u306f\u3001\u6226\u58eb\u3001\u5f13\u5175\u3001\u9b54\u6cd5\u4f7f\u3044\u306e3\u3064\u306e\u68d2\u4eba\u9593\u30af\u30e9\u30b9\u304c\u3042\u308a\u307e\u3059\u3002\u521d\u5fc3\u8005\u306e\u5834\u5408\u3001\u6226\u58eb\u306f\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u30b9\u30c6\u30fc\u30bf\u30b9\u3068\u30b7\u30f3\u30d7\u30eb\u3067\u76f4\u611f\u7684\u306a\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u304b\u3089\u6700\u9069\u306a\u9078\u629e\u80a2\u3068\u306a\u308a\u307e\u3059\u3002\u6226\u58eb\u306f\u9ad8\u3044\u4f53\u529b\u3068\u8fd1\u63a5\u653b\u6483\u529b\u3092\u6301\u3063\u3066\u3044\u308b\u306e\u3067\u3001\u521d\u5fc3\u8005\u3067\u3082\u6271\u3044\u3084\u3059\u3044\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u521d\u671f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u6226\u58eb\u306f\u9aa8\u683c\u5175\u306e\u653b\u6483\u3092\u3088\u308a\u8010\u3048\u306a\u304c\u3089\u3001\u5927\u304d\u306a\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u6226\u58eb\u306f\u4e07\u80fd\u306a\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3067\u3059\u304c\u3001\u5f13\u5175\u3068\u9b54\u6cd5\u4f7f\u3044\u306f\u3088\u308a\u7cbe\u5bc6\u306a\u5c04\u6483\u3068\u9b54\u529b\u7ba1\u7406\u304c\u5fc5\u8981\u3068\u306a\u308a\u307e\u3059\u3002"}, {"question": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u300e\u69cd\u306e\u68d2\u4eba\u9593\u300f\u3067\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u300e\u69cd\u306e\u68d2\u4eba\u9593\u300f\u3067\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u3092\u6700\u9069\u5316\u3059\u308b\u305f\u3081\u306b\u3001\u4ee5\u4e0b\u306e\u6226\u7565\u306b\u5f93\u3046\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5012\u3057\u305f\u6575\u3084\u5b9d\u7bb1\u304b\u3089\u30b3\u30a4\u30f3\u3068\u5b9d\u77f3\u3092\u96c6\u3081\u308b\u3053\u3068\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u898b\u305f\u76ee\u306e\u30a2\u30a4\u30c6\u30e0\u3088\u308a\u3082\u3001\u69cd\u306e\u30c0\u30e1\u30fc\u30b8\u3084\u4f53\u529b\u306e\u5f37\u5316\u306a\u3069\u306e\u91cd\u8981\u306a\u80fd\u529b\u306e\u5f37\u5316\u3092\u512a\u5148\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30dc\u30b9\u6226\u4e2d\u306b\u56de\u5fa9\u85ac\u306a\u3069\u306e\u6d88\u8cbb\u30a2\u30a4\u30c6\u30e0\u3092\u6226\u7565\u7684\u306b\u4f7f\u7528\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u6eb6\u5ca9\u30b9\u30c6\u30fc\u30b8\u3067\u306f\u3001\u6700\u7d42\u30dc\u30b9\u6226\u306e\u305f\u3081\u306b\u56de\u5fa9\u85ac\u3092\u6e29\u5b58\u3057\u3066\u304a\u304f\u3068\u5927\u304d\u306a\u5dee\u3068\u306a\u308a\u307e\u3059\u3002\u3042\u306a\u305f\u306e\u30ea\u30bd\u30fc\u30b9\u306f\u9650\u3089\u308c\u305f\u4e88\u7b97\u3068\u6349\u3048\u3001\u8ce2\u304f\u4f7f\u3048\u308b\u3088\u3046\u306b\u3059\u308b\u3068\u3001\u3088\u308a\u591a\u304f\u306e\u9032\u6b69\u304c\u5f97\u3089\u308c\u307e\u3059\u3002"}, {"question": "\u300e\u69cd\u306e\u68d2\u4eba\u9593\u300f\u306e\u6700\u7d42\u30dc\u30b9\u3092\u5012\u3059\u305f\u3081\u306e\u6700\u3082\u52b9\u679c\u7684\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u300e\u69cd\u306e\u68d2\u4eba\u9593\u300f\u306e\u6700\u7d42\u30dc\u30b9\u3092\u5012\u3059\u306b\u306f\u3001\u7dbf\u5bc6\u306a\u6226\u7565\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5165\u624b\u53ef\u80fd\u306a\u6700\u9ad8\u30ec\u30d9\u30eb\u306e\u69cd\u3068\u9632\u5177\u3092\u88c5\u5099\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30dc\u30b9\u306e\u653b\u6483\u30d1\u30bf\u30fc\u30f3\u3092\u5b66\u3073\u3001\u305d\u308c\u306b\u5408\u308f\u305b\u3066\u56de\u907f\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7206\u767a\u6027\u69cd\u306a\u3069\u306e\u7279\u6b8a\u80fd\u529b\u3092\u3001\u30dc\u30b9\u306e\u9699\u9593\u306b\u5408\u308f\u305b\u3066\u4f7f\u7528\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u30dc\u30b9\u304c\u5f37\u529b\u306a\u653b\u6483\u306e\u6e96\u5099\u3092\u3057\u3066\u3044\u308b\u5834\u5408\u3001\u305d\u306e\u77ac\u9593\u3053\u305d\u7206\u767a\u6027\u69cd\u3092\u4f7f\u3046\u7d76\u597d\u306e\u6a5f\u4f1a\u3067\u3059\u3002\u3053\u306e\u6226\u3044\u306f\u304a\u4e92\u3044\u306e\u52d5\u304d\u3092\u4e88\u6e2c\u3057\u3066\u52b9\u679c\u7684\u306b\u53cd\u6483\u3059\u308b\u3001\u30c1\u30a7\u30b9\u306e\u30b2\u30fc\u30e0\u3068\u6349\u3048\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u300e\u69cd\u306e\u68d2\u4eba\u9593\u300f\u3067\u9577\u671f\u7684\u306a\u9032\u6b69\u306b\u6700\u3082\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u300e\u69cd\u306e\u68d2\u4eba\u9593\u300f\u3067\u9577\u671f\u7684\u306a\u9032\u6b69\u306b\u6700\u3082\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u4ee5\u4e0b\u306e3\u3064\u3067\u3059\u30021) \u69cd\u306e\u5f37\u5316\uff1a\u30c0\u30e1\u30fc\u30b8\u3068\u80fd\u529b\u3092\u5411\u4e0a\u3055\u305b\u308b\u30022) \u4f53\u529b\u3068\u9632\u5177\u306e\u5f37\u5316\uff1a\u751f\u5b58\u6027\u3092\u9ad8\u3081\u308b\u30023) \u30b9\u30ad\u30eb\u30c4\u30ea\u30fc\u306e\u89e3\u653e\uff1a\u30d1\u30c3\u30b7\u30d6\u30dc\u30fc\u30ca\u30b9\u3068\u30a2\u30af\u30c6\u30a3\u30d6\u30b9\u30ad\u30eb\u3092\u5f97\u308b\u3002\u4f8b\u3048\u3070\u3001\u30b9\u30ad\u30eb\u30c4\u30ea\u30fc\u3067\u300e\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u300f\u3092\u89e3\u653e\u3059\u308b\u3068\u3001\u5f8c\u306e\u30ec\u30d9\u30eb\u3067\u30c0\u30e1\u30fc\u30b8\u52b9\u679c\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u5bb6\u306e\u57fa\u790e\u3068\u6349\u3048\u307e\u3057\u3087\u3046\u3002\u3053\u308c\u3089\u306e\u57fa\u790e\u304c\u5f37\u3051\u308c\u3070\u5f37\u3044\u307b\u3069\u3001\u9ad8\u3044\u5efa\u7269\u3092\u7bc9\u3051\u307e\u3059\u3002"}, {"question": "\u300e\u69cd\u306e\u68d2\u4eba\u9593\u300f\u306e\u96e3\u6613\u5ea6\u8abf\u6574\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u91cd\u8981\u306a\u3057\u304d\u3044\u5024\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u300e\u69cd\u306e\u68d2\u4eba\u9593\u300f\u306e\u96e3\u6613\u5ea6\u8abf\u6574\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u6bb5\u968e\u7684\u306b\u6311\u6226\u3055\u305b\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u91cd\u8981\u306a\u3057\u304d\u3044\u5024\u306f\u4ee5\u4e0b\u306e\u901a\u308a\u3067\u3059\u30021) \u521d\u671f\u30ec\u30d9\u30eb\uff1a\u6575\u306e\u4f53\u529b\u306f\u4f4e\u304f\u3001\u653b\u6483\u306f\u9045\u3044\u30022) \u4e2d\u76e4\u30ec\u30d9\u30eb\uff1a\u6575\u306f\u901f\u304f\u306a\u308a\u3001\u6570\u304c\u591a\u304f\u306a\u308b\u30023) \u5f8c\u671f\u30ec\u30d9\u30eb\uff1a\u30dc\u30b9\u306f\u8907\u96d1\u306a\u653b\u6483\u30d1\u30bf\u30fc\u30f3\u3092\u6301\u3061\u3001\u4f53\u529b\u3082\u9ad8\u3044\u3002\u4f8b\u3048\u3070\u3001\u7802\u6f20\u30b9\u30c6\u30fc\u30b8\u3067\u306f\u3001\u68ee\u30b9\u30c6\u30fc\u30b8\u306b\u6bd4\u3079\u3066\u3001\u7d20\u65e9\u304f\u653b\u6483\u529b\u306e\u9ad8\u3044\u6575\u306e\u6ce2\u306b\u906d\u9047\u3057\u307e\u3059\u3002\u96e3\u6613\u5ea6\u8abf\u6574\u306f\u3001\u968e\u6bb5\u3068\u6349\u3048\u307e\u3057\u3087\u3046\u3002\u5404\u30b9\u30c6\u30c3\u30d7\u306f\u3001\u6b21\u306e\u3001\u3088\u308a\u6311\u6226\u7684\u306a\u30b9\u30c6\u30c3\u30d7\u306e\u6e96\u5099\u3092\u3057\u307e\u3059\u3002"}, {"question": "\u300e\u69cd\u306e\u68d2\u4eba\u9593\u300f\u3092\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u5b9f\u884c\u3059\u308b\u305f\u3081\u306e\u30b7\u30b9\u30c6\u30e0\u8981\u4ef6\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u30b9\u30e0\u30fc\u30ba\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u78ba\u4fdd\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "\u300e\u69cd\u306e\u68d2\u4eba\u9593\u300f\u306f\u63a7\u3048\u3081\u306a\u30b7\u30b9\u30c6\u30e0\u8981\u4ef6\u3092\u5099\u3048\u3066\u3044\u307e\u3059\u3002\u305f\u3060\u3057\u3001\u30b9\u30e0\u30fc\u30ba\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u78ba\u4fdd\u3059\u308b\u305f\u3081\u306b\u4ee5\u4e0b\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u30021) PC\u3067\u306f\u3001\u30c7\u30e5\u30a2\u30eb\u30b3\u30a2\u30d7\u30ed\u30bb\u30c3\u30b5\u30684GB\u306eRAM\u304c\u3042\u308c\u3070\u5341\u5206\u3067\u3059\u30022) \u30e2\u30d0\u30a4\u30eb\u3067\u306f\u3001\u5c11\u306a\u304f\u3068\u30822GB\u306eRAM\u3068Android 7.0\u4ee5\u4e0a\u307e\u305f\u306fiOS 10\u4ee5\u4e0a\u304c\u63a8\u5968\u3055\u308c\u307e\u3059\u30023) \u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u30a2\u30d7\u30ea\u3092\u9589\u3058\u3066\u30ea\u30bd\u30fc\u30b9\u3092\u89e3\u653e\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u30df\u30c3\u30c9\u30ec\u30f3\u30b8\u30b9\u30de\u30fc\u30c8\u30d5\u30a9\u30f3\u3067\u306f\u3001\u4e0d\u8981\u306a\u30a2\u30d7\u30ea\u3092\u9589\u3058\u308c\u3070\u3001\u6fc0\u3057\u3044\u6226\u95d8\u4e2d\u306e\u30e9\u30b0\u3092\u9632\u6b62\u3067\u304d\u307e\u3059\u3002\u3042\u306a\u305f\u306e\u30c7\u30d0\u30a4\u30b9\u306f\u8eca\u3068\u6349\u3048\u307e\u3057\u3087\u3046\u3002\u5b9a\u671f\u7684\u306a\u30e1\u30f3\u30c6\u30ca\u30f3\u30b9\u306f\u3001\u3069\u3093\u306a\u9053\u3067\u3082\u30b9\u30e0\u30fc\u30ba\u306b\u8d70\u884c\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u300e\u69cd\u306e\u68d2\u4eba\u9593\u300f\u306b\u306f\u3069\u306e\u3088\u3046\u306a\u96a0\u3055\u308c\u305f\u79d8\u5bc6\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u300e\u69cd\u306e\u68d2\u4eba\u9593\u300f\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u79d8\u5bc6\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u305f\u304f\u3055\u3093\u96a0\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u79d8\u5bc6\u306e\u4e00\u3064\u306f\u3001\u6eb6\u5ca9\u30b9\u30c6\u30fc\u30b8\u306e\u96a0\u3055\u308c\u305f\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u30af\u30ea\u30a2\u3059\u308b\u3053\u3068\u3067\u5165\u624b\u3067\u304d\u308b\u300e\u91d1\u306e\u69cd\u300f\u3067\u3059\u3002\u4ee5\u4e0b\u306e\u624b\u9806\u3067\u5165\u624b\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u58ca\u305b\u308b\u58c1\u306e\u5f8c\u308d\u306b\u3042\u308b\u96a0\u3055\u308c\u305f\u6d1e\u7a9f\u3092\u898b\u3064\u3051\u51fa\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6d1e\u7a9f\u5185\u306e\u30df\u30cb\u30dc\u30b9\u3092\u5012\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u8ffd\u52a0\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u91d1\u306e\u69cd\u3092\u5165\u624b\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u6700\u7d42\u30dc\u30b9\u6226\u3067\u91d1\u306e\u69cd\u3092\u4f7f\u7528\u3059\u308c\u3070\u3001\u6226\u95d8\u306e\u96e3\u6613\u5ea6\u3092\u5927\u5e45\u306b\u8efd\u6e1b\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u79d8\u5bc6\u306f\u57cb\u3082\u308c\u305f\u5b9d\u3068\u6349\u3048\u307e\u3057\u3087\u3046\u3002\u63a2\u6c42\u3059\u308b\u307b\u3069\u3001\u5927\u304d\u306a\u5831\u916c\u304c\u5f97\u3089\u308c\u307e\u3059\u3002"}]
[{"question": "\u65b0\u624b\u5982\u4f55\u5feb\u901f\u638c\u63e1\u300a\u77db\u4eba\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u5feb\u901f\u638c\u63e1\u300a\u77db\u4eba\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u719f\u6089\u64cd\u7eb5\u6746\u8fdb\u884c\u79fb\u52a8\uff0c\u5e76\u4f7f\u7528\u653b\u51fb\u6309\u94ae\u6295\u63b7\u957f\u77db\u3002\u6b65\u9aa42 - \u7ec3\u4e60\u653b\u51fb\u65f6\u673a\uff0c\u51fb\u4e2d\u79fb\u52a8\u76ee\u6807\uff0c\u4f8b\u5982\u6e38\u620f\u65e9\u671f\u7684\u5c0f\u9ab7\u9ac5\u3002\u6b65\u9aa43 - \u4f7f\u7528\u95ea\u907f\u6309\u94ae\u8eb2\u907f\u654c\u4eba\u653b\u51fb\uff0c\u8fd9\u5bf9\u4e8e\u751f\u5b58\u81f3\u5173\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u5173\uff0c\u60a8\u53ef\u4ee5\u7ec3\u4e60\u8eb2\u907f\u9ab7\u9ac5\u7f13\u6162\u79fb\u52a8\u7684\u957f\u77db\u5e76\u8fdb\u884c\u53cd\u51fb\u3002\u60f3\u8c61\u4e00\u4e0b\u5b66\u4e60\u9a91\u81ea\u884c\u8f66\uff1a\u4ece\u7f13\u6162\u5f00\u59cb\uff0c\u7136\u540e\u9010\u6e10\u63d0\u9ad8\u901f\u5ea6\u548c\u7cbe\u5ea6\u3002"}, {"question": "\u5728\u300a\u77db\u4eba\u300b\u4e2d\uff0c\u4e3a\u4ec0\u4e48\u5347\u7ea7\u957f\u77db\u5f88\u91cd\u8981\uff0c\u5e94\u8be5\u4f18\u5148\u5347\u7ea7\u54ea\u4e9b\uff1f", "answer": "\u5728\u300a\u77db\u4eba\u300b\u4e2d\u5347\u7ea7\u957f\u77db\u5bf9\u4e8e\u901a\u5173\u66f4\u96be\u7684\u5173\u5361\u81f3\u5173\u91cd\u8981\u3002\u4f18\u5148\u5347\u7ea7\u4ee5\u4e0b\u5185\u5bb9\uff1a\u6b65\u9aa41 - \u589e\u52a0\u957f\u77db\u4f24\u5bb3\uff0c\u66f4\u5feb\u5730\u51fb\u8d25\u654c\u4eba\u3002\u6b65\u9aa42 - \u63d0\u5347\u653b\u51fb\u901f\u5ea6\uff0c\u5e94\u5bf9\u66f4\u591a\u654c\u4eba\u3002\u6b65\u9aa43 - \u89e3\u9501\u7279\u6b8a\u80fd\u529b\uff0c\u4f8b\u5982\u7206\u70b8\u957f\u77db\uff0c\u7528\u4e8e\u63a7\u5236\u4eba\u7fa4\u3002\u4f8b\u5982\uff0c\u5728\u4e2d\u671f\uff0c\u5347\u7ea7\u6210\u7206\u70b8\u957f\u77db\u53ef\u4ee5\u5e2e\u52a9\u60a8\u6e05\u9664\u6c99\u6f20\u5173\u5361\u4e2d\u7684\u654c\u4eba\u3002\u60f3\u8c61\u4e00\u4e0b\uff0c\u60a8\u7684\u957f\u77db\u5c31\u50cf\u4e00\u628a\u968f\u7740\u60a8\u7684\u6280\u80fd\u800c\u8fdb\u5316\u7684\u5de5\u5177\uff0c\u968f\u7740\u60a8\u7684\u8fdb\u6b65\u800c\u53d8\u5f97\u66f4\u950b\u5229\u548c\u66f4\u7075\u6d3b\u3002"}, {"question": "\u300a\u77db\u4eba\u300b\u4e2d\u4e0d\u540c\u89d2\u8272\u4e4b\u95f4\u7684\u4e3b\u8981\u533a\u522b\u662f\u4ec0\u4e48\uff0c\u54ea\u79cd\u89d2\u8272\u6700\u9002\u5408\u65b0\u624b\uff1f", "answer": "\u300a\u77db\u4eba\u300b\u63d0\u4f9b\u4e09\u79cd\u89d2\u8272\uff1a\u6218\u58eb\u3001\u5f13\u7bad\u624b\u548c\u6cd5\u5e08\u3002\u5bf9\u4e8e\u65b0\u624b\u6765\u8bf4\uff0c\u6218\u58eb\u662f\u6700\u5408\u9002\u7684\uff0c\u56e0\u4e3a\u5b83\u62e5\u6709\u5e73\u8861\u7684\u5c5e\u6027\u548c\u76f4\u89c2\u7684\u73a9\u6cd5\u3002\u6218\u58eb\u62e5\u6709\u66f4\u9ad8\u7684\u751f\u547d\u503c\u548c\u8fd1\u6218\u4f24\u5bb3\uff0c\u8ba9\u65b0\u624b\u73a9\u5bb6\u66f4\u5bb9\u6613\u4e0a\u624b\u3002\u4f8b\u5982\uff0c\u5728\u65e9\u671f\u5173\u5361\u4e2d\uff0c\u6218\u58eb\u53ef\u4ee5\u627f\u53d7\u66f4\u591a\u6765\u81ea\u9ab7\u9ac5\u7684\u653b\u51fb\uff0c\u540c\u65f6\u9020\u6210\u5927\u91cf\u4f24\u5bb3\u3002\u60f3\u8c61\u4e00\u4e0b\uff0c\u6218\u58eb\u662f\u4e00\u4e2a\u53ef\u9760\u7684\u5168\u80fd\u89d2\u8272\uff0c\u800c\u5f13\u7bad\u624b\u548c\u6cd5\u5e08\u5206\u522b\u9700\u8981\u66f4\u7cbe\u786e\u7684\u7784\u51c6\u548c\u9b54\u6cd5\u503c\u7ba1\u7406\u3002"}, {"question": "\u9ad8\u7ea7\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u77db\u4eba\u300b\u4e2d\u4f18\u5316\u8d44\u6e90\u7ba1\u7406\uff1f", "answer": "\u9ad8\u7ea7\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u4ee5\u4e0b\u7b56\u7565\u4f18\u5316\u300a\u77db\u4eba\u300b\u4e2d\u7684\u8d44\u6e90\u7ba1\u7406\uff1a\u6b65\u9aa41 - \u4e13\u6ce8\u4e8e\u4ece\u88ab\u51fb\u8d25\u7684\u654c\u4eba\u548c\u5b9d\u7bb1\u4e2d\u6536\u96c6\u91d1\u5e01\u548c\u5b9d\u77f3\u3002\u6b65\u9aa42 - \u4f18\u5148\u5347\u7ea7\u91cd\u8981\u6280\u80fd\uff0c\u4f8b\u5982\u957f\u77db\u4f24\u5bb3\u548c\u751f\u547d\u503c\uff0c\u800c\u4e0d\u662f\u5916\u89c2\u7269\u54c1\u3002\u6b65\u9aa43 - \u5728\u6218\u6597\u4e2d\u6218\u7565\u6027\u5730\u4f7f\u7528\u6d88\u8017\u54c1\uff0c\u4f8b\u5982\u751f\u547d\u836f\u6c34\u3002\u4f8b\u5982\uff0c\u5728\u7194\u5ca9\u5173\u5361\u4e2d\uff0c\u5c06\u751f\u547d\u836f\u6c34\u4fdd\u5b58\u5230\u6700\u7ec8\u7684BOSS\u6218\u4e2d\u53ef\u4ee5\u4ea7\u751f\u663e\u8457\u5dee\u5f02\u3002\u60f3\u8c61\u4e00\u4e0b\uff0c\u60a8\u7684\u8d44\u6e90\u5c31\u50cf\u4e00\u4e2a\u6709\u9650\u7684\u9884\u7b97\uff1a\u660e\u667a\u5730\u652f\u51fa\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u60a8\u7684\u8fdb\u5ea6\u3002"}, {"question": "\u5728\u300a\u77db\u4eba\u300b\u4e2d\u51fb\u8d25\u6700\u7ec8BOSS\u6700\u6709\u6548\u7684\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300a\u77db\u4eba\u300b\u4e2d\u51fb\u8d25\u6700\u7ec8BOSS\u9700\u8981\u4e00\u4e2a\u5468\u5bc6\u7684\u7b56\u7565\uff1a\u6b65\u9aa41 - \u88c5\u5907\u6700\u9ad8\u7b49\u7ea7\u7684\u957f\u77db\u548c\u76d4\u7532\u3002\u6b65\u9aa42 - \u719f\u6089BOSS\u7684\u653b\u51fb\u6a21\u5f0f\u5e76\u76f8\u5e94\u5730\u95ea\u907f\u3002\u6b65\u9aa43 - \u5728BOSS\u7684\u8106\u5f31\u671f\u4f7f\u7528\u7279\u6b8a\u80fd\u529b\uff0c\u4f8b\u5982\u7206\u70b8\u957f\u77db\u3002\u4f8b\u5982\uff0c\u5f53BOSS\u84c4\u529b\u8fdb\u884c\u5f3a\u529b\u653b\u51fb\u65f6\uff0c\u6b63\u662f\u4f7f\u7528\u7206\u70b8\u957f\u77db\u7684\u6700\u4f73\u65f6\u673a\u3002\u5c06\u6218\u6597\u60f3\u8c61\u6210\u4e00\u573a\u56fd\u9645\u8c61\u68cb\u6bd4\u8d5b\uff1a\u9884\u5224\u5bf9\u624b\u7684\u4e3e\u52a8\u5e76\u6709\u6548\u5730\u53cd\u51fb\u3002"}, {"question": "\u300a\u77db\u4eba\u300b\u4e2d\u54ea\u4e9b\u6e38\u620f\u673a\u5236\u5bf9\u957f\u671f\u8fdb\u5ea6\u63d0\u5347\u5f71\u54cd\u6700\u5927\uff1f", "answer": "\u300a\u77db\u4eba\u300b\u4e2d\u5bf9\u957f\u671f\u8fdb\u5ea6\u63d0\u5347\u5f71\u54cd\u6700\u5927\u7684\u6e38\u620f\u673a\u5236\u662f\uff1a1) \u957f\u77db\u5347\u7ea7\uff0c\u589e\u52a0\u60a8\u7684\u4f24\u5bb3\u548c\u80fd\u529b\u30022) \u751f\u547d\u503c\u548c\u76d4\u7532\u63d0\u5347\uff0c\u589e\u5f3a\u60a8\u7684\u751f\u5b58\u80fd\u529b\u30023) \u6280\u80fd\u6811\u89e3\u9501\uff0c\u63d0\u4f9b\u88ab\u52a8\u52a0\u6210\u548c\u4e3b\u52a8\u6280\u80fd\u3002\u4f8b\u5982\uff0c\u5728\u6280\u80fd\u6811\u4e2d\u89e3\u9501\u201c\u66b4\u51fb\u201d\u6280\u80fd\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u540e\u671f\u5173\u5361\u7684\u4f24\u5bb3\u8f93\u51fa\u3002\u60f3\u8c61\u4e00\u4e0b\uff0c\u8fd9\u4e9b\u673a\u5236\u5c31\u50cf\u623f\u5c4b\u7684\u57fa\u7840\uff1a\u5b83\u4eec\u8d8a\u5f3a\u5927\uff0c\u60a8\u5c31\u80fd\u5efa\u9020\u5f97\u8d8a\u9ad8\u3002"}, {"question": "\u300a\u77db\u4eba\u300b\u7684\u96be\u5ea6\u63d0\u5347\u673a\u5236\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u5173\u952e\u7684\u96be\u5ea6\u9600\u503c\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u77db\u4eba\u300b\u7684\u96be\u5ea6\u63d0\u5347\u673a\u5236\u65e8\u5728\u9010\u6b65\u6311\u6218\u73a9\u5bb6\u3002\u5173\u952e\u7684\u96be\u5ea6\u9600\u503c\u5305\u62ec\uff1a1) \u65e9\u671f\u5173\u5361\uff0c\u654c\u4eba\u751f\u547d\u503c\u4f4e\uff0c\u653b\u51fb\u901f\u5ea6\u6162\u30022) \u4e2d\u671f\u5173\u5361\uff0c\u654c\u4eba\u53d8\u5f97\u66f4\u5feb\uff0c\u6570\u91cf\u66f4\u591a\u30023) \u540e\u671f\u5173\u5361\uff0cBOSS\u62e5\u6709\u590d\u6742\u7684\u653b\u51fb\u6a21\u5f0f\u548c\u9ad8\u751f\u547d\u503c\u3002\u4f8b\u5982\uff0c\u5728\u6c99\u6f20\u5173\u5361\u4e2d\uff0c\u4e0e\u68ee\u6797\u5173\u5361\u76f8\u6bd4\uff0c\u60a8\u5c06\u9762\u4e34\u66f4\u5feb\u901f\u548c\u66f4\u5177\u4fb5\u7565\u6027\u7684\u654c\u4eba\u3002\u60f3\u8c61\u4e00\u4e0b\u96be\u5ea6\u63d0\u5347\u673a\u5236\u5c31\u50cf\u4e00\u4e2a\u697c\u68af\uff1a\u6bcf\u4e00\u7ea7\u90fd\u4e3a\u4e0b\u4e00\u4e2a\u66f4\u5177\u6311\u6218\u6027\u7684\u7ea7\u522b\u505a\u597d\u51c6\u5907\u3002"}, {"question": "\u300a\u77db\u4eba\u300b\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u7684\u7cfb\u7edf\u8981\u6c42\u662f\u4ec0\u4e48\uff0c\u73a9\u5bb6\u5982\u4f55\u786e\u4fdd\u6e38\u620f\u6d41\u7545\u8fd0\u884c\uff1f", "answer": "\u300a\u77db\u4eba\u300b\u7684\u7cfb\u7edf\u8981\u6c42\u9002\u4e2d\uff0c\u4f46\u4e3a\u4e86\u786e\u4fdd\u6e38\u620f\u6d41\u7545\uff1a1) \u5728PC\u4e0a\uff0c\u53cc\u6838\u5904\u7406\u5668\u548c4GB\u5185\u5b58\u5c31\u8db3\u591f\u4e86\u30022) \u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\uff0c\u5efa\u8bae\u4f7f\u7528\u5185\u5b58\u81f3\u5c112GB\uff0c\u5e76\u4e14Android 7.0\u6216iOS 10\u53ca\u4ee5\u4e0a\u7248\u672c\u30023) \u5173\u95ed\u540e\u53f0\u5e94\u7528\u7a0b\u5e8f\u4ee5\u91ca\u653e\u8d44\u6e90\u3002\u4f8b\u5982\uff0c\u5728\u4e2d\u7b49\u6027\u80fd\u7684\u667a\u80fd\u624b\u673a\u4e0a\uff0c\u5173\u95ed\u672a\u4f7f\u7528\u7684\u5e94\u7528\u7a0b\u5e8f\u53ef\u4ee5\u9632\u6b62\u5728\u6fc0\u70c8\u6218\u6597\u4e2d\u51fa\u73b0\u5ef6\u8fdf\u3002\u60f3\u8c61\u4e00\u4e0b\u60a8\u7684\u8bbe\u5907\u5c31\u50cf\u4e00\u8f86\u6c7d\u8f66\uff1a\u5b9a\u671f\u7ef4\u62a4\u786e\u4fdd\u5b83\u5728\u4efb\u4f55\u9053\u8def\u4e0a\u90fd\u80fd\u5e73\u7a33\u884c\u9a76\u3002"}, {"question": "\u300a\u77db\u4eba\u300b\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u7684\u79d8\u5bc6\u6216\u5f69\u86cb\u73a9\u5bb6\u53ef\u4ee5\u53d1\u73b0\uff1f", "answer": "\u300a\u77db\u4eba\u300b\u5145\u6ee1\u4e86\u9690\u85cf\u7684\u79d8\u5bc6\u548c\u5f69\u86cb\u3002\u4e00\u4e2a\u503c\u5f97\u6ce8\u610f\u7684\u79d8\u5bc6\u662f\u201c\u9ec4\u91d1\u957f\u77db\u201d\uff0c\u53ef\u4ee5\u901a\u8fc7\u5728\u7194\u5ca9\u5173\u5361\u5b8c\u6210\u4e00\u4e2a\u9690\u85cf\u6311\u6218\u6765\u627e\u5230\u3002\u89e3\u9501\u65b9\u6cd5\uff1a\u6b65\u9aa41 - \u5728\u53ef\u7834\u574f\u7684\u5899\u58c1\u540e\u627e\u5230\u9690\u85cf\u7684\u6d1e\u7a74\u3002\u6b65\u9aa42 - \u51fb\u8d25\u6d1e\u7a74\u5185\u7684\u8ff7\u4f60BOSS\u3002\u6b65\u9aa43 - \u9886\u53d6\u9ec4\u91d1\u957f\u77db\uff0c\u5b83\u4f1a\u9020\u6210\u989d\u5916\u4f24\u5bb3\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u9ec4\u91d1\u957f\u77db\u5bf9\u6297\u6700\u7ec8BOSS\u53ef\u4ee5\u663e\u8457\u964d\u4f4e\u6218\u6597\u96be\u5ea6\u3002\u60f3\u8c61\u4e00\u4e0b\u8fd9\u4e9b\u79d8\u5bc6\u5c31\u50cf\u57cb\u85cf\u7684\u5b9d\u85cf\uff1a\u60a8\u5bfb\u627e\u5f97\u8d8a\u4ed4\u7ec6\uff0c\u5956\u52b1\u5c31\u8d8a\u5927\u3002"}]
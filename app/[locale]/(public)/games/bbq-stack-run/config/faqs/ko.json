[{"question": "Bbq \uc2a4\ud0dd \ub7f0\uc5d0\uc11c \uae30\ubcf8 \ub3d9\uc791\uc740 \uc5b4\ub5bb\uac8c \uc218\ud589\ud569\ub2c8\uae4c?", "answer": "Bbq \uc2a4\ud0dd \ub7f0\uc5d0\uc11c \uae30\ubcf8 \ub3d9\uc791\uc740 \ub2ec\ub9ac\uae30, \uc810\ud504 \ubc0f \uc2a4\ud0dd\ud0b9\uc785\ub2c8\ub2e4. \ub2ec\ub9ac\ub824\uba74 \ud654\uba74\uc744 \uc55e\uc73c\ub85c \uc4f8\uc5b4 \ub0b4\ub9ac\uba74 \ub429\ub2c8\ub2e4. \uc810\ud504\ud558\ub824\uba74 \uc704\ub85c \uc4f8\uc5b4 \ub0b4\ub9ac\uba74 \ub418\uace0, BBQ \uc81c\ud488 \uadfc\ucc98\uc5d0 \uc788\uc744 \ub54c \uc2a4\ud0dd\ud558\ub824\uba74 \uc544\ub798\ub85c \uc4f8\uc5b4 \ub0b4\ub9ac\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4 \ud584\ubc84\uac70 \ubb49\uce58\uc5d0 \ub2e4\uac00\uac00\uba74 \uc2a4\ud0dd\uc5d0 \ucd94\uac00\ud558\uae30 \uc704\ud574 \uc544\ub798\ub85c \uc4f8\uc5b4 \ub0b4\ub9ac\uc138\uc694. \uc774\uac83\uc740 \uade0\ud615\uacfc \uc18d\ub3c4\ub97c \uc720\uc9c0\ud558\ub294 \ub370 \uc911\uc694\ud569\ub2c8\ub2e4."}, {"question": "Bbq \uc2a4\ud0dd \ub7f0\uc5d0\uc11c \uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \uc8fc\uc694 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \uc138 \uac00\uc9c0 \uc8fc\uc694 \uc804\ub7b5\uc5d0 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. 1) **\uc815\ud655\ud55c \uc2a4\ud0dd\ud0b9**: \ub118\uc5b4\uc9c0\uc9c0 \uc54a\ub3c4\ub85d \uac01 \ud56d\ubaa9\uc744 \uc644\ubcbd\ud558\uac8c \uc815\ub82c\ud558\uc2ed\uc2dc\uc624. 2) **\ud0c0\uc774\ubc0d \uc810\ud504**: \ub9c8\uc9c0\ub9c9 \uc21c\uac04 \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uc810\ud504\ub97c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. 3) **\uc18d\ub3c4 \uad00\ub9ac**: \uc2a4\ud0dd\uc744 \uacfc\ubd80\ud558\ud558\uc9c0 \uc54a\uc74c\uc73c\ub85c\uc368 \uc18d\ub3c4\uc640 \uc548\uc815\uc131\uc744 \uade0\ud615\uc788\uac8c \uc720\uc9c0\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4 \uc881\uc740 \ub2e4\ub9ac\uc5d0 \uc811\uadfc\ud560 \ub54c\ub294 \ud1b5\uc81c\ub825\uc744 \uc720\uc9c0\ud558\uae30 \uc704\ud574 \uc18d\ub3c4\ub97c \uc904\uc774\uc138\uc694."}, {"question": "Bbq \uc2a4\ud0dd \ub7f0\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "Bbq \uc2a4\ud0dd \ub7f0\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uac70\ub9ac, \uc2a4\ud0dd \ub192\uc774 \ubc0f \ud488\ubaa9 \ud488\uc9c8\uc744 \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. \uac01 \ubbf8\ud130\ub97c \ub2ec\ub9ac\uba74 \uc810\uc218\uac00 \ucd94\uac00\ub418\uace0, \ud504\ub9ac\ubbf8\uc5c4 \uc2a4\ud14c\uc774\ud06c\uc640 \uac19\uc740 \uace0\ud488\uc9c8 \ud488\ubaa9\uc744 \uc313\uc73c\uba74 \uc810\uc218\uac00 \uacf1\ud574\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 10\uac1c\uc758 \ud504\ub9ac\ubbf8\uc5c4 \uc2a4\ud14c\uc774\ud06c\ub97c \uc313\uc73c\uba74 10\uac1c\uc758 \uae30\ubcf8 \ud584\ubc84\uac70\ub97c \uc313\ub294 \uac83\ubcf4\ub2e4 \uc810\uc218\uac00 \ud06c\uac8c \uc99d\uac00\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc694\uc18c\ub4e4\uc744 \uade0\ud615\uc788\uac8c \uc720\uc9c0\ud558\ub294 \uac83\uc774 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\ub294 \ub370 \uc911\uc694\ud569\ub2c8\ub2e4."}, {"question": "Bbq \uc2a4\ud0dd \ub7f0\uc5d0\uc11c \uc2a4\ud0dd \ub192\uc774\ub97c \uad00\ub9ac\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc2a4\ud0dd \ub192\uc774\ub97c \uad00\ub9ac\ud558\ub294 \uac83\uc740 \uc18d\ub3c4\uc640 \uc548\uc815\uc131\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc2a4\ud0dd\uc774 \ub192\uc544\uc9c0\uba74 \uc810\uc218 \uac00\uc911\uce58\uac00 \uc99d\uac00\ud558\uc9c0\ub9cc \uc81c\uc5b4\ud558\uae30\uac00 \ub354 \uc5b4\ub835\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 15\uac1c\uc758 \ud488\ubaa9\uc744 \uc313\uc73c\uba74 \uc810\uc218\uac00 \ub450 \ubc30\uac00 \ub418\uc9c0\ub9cc \uc7a5\uc560\ubb3c\uc744 \ub118\uc5b4\uc9c8 \uc704\ud5d8\ub3c4 \uc99d\uac00\ud569\ub2c8\ub2e4. \uade0\ud615\uacfc \ud1b5\uc81c\ub825\uc744 \uade0\ud615\uc788\uac8c \uc720\uc9c0\ud558\ub294 \uac83\uc774 \uc9c0\uc18d\uc801\uc778 \uc131\uacf5\uc744 \uc704\ud55c \ud544\uc218 \uc694\uc18c\uc785\ub2c8\ub2e4."}, {"question": "\ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c Bbq \uc2a4\ud0dd \ub7f0\uc744 \ud50c\ub808\uc774\ud558\uae30 \uc704\ud55c \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Bbq \uc2a4\ud0dd \ub7f0\uc740 \ubaa8\ubc14\uc77c \ubc0f PC \ud50c\ub7ab\ud3fc \ubaa8\ub450\uc5d0\uc11c \ucd5c\uc801\ud654\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \ubaa8\ubc14\uc77c\uc758 \uacbd\uc6b0 \ucd5c\uc18c 2GB RAM\uc744 \uac16\ucd98 iOS 10 \uc774\uc0c1 \ub610\ub294 Android 5.0 \uc774\uc0c1\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. PC\uc5d0\uc11c \uc2e4\ud589\ud558\ub824\uba74 Windows 10, 4GB RAM \ubc0f DirectX 11 \ud638\ud658 GPU\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ud1b5\ud574 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud560 \uc218 \uc788\ub3c4\ub85d \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774\uac00 \uc9c0\uc6d0\ub429\ub2c8\ub2e4."}, {"question": "Bbq \uc2a4\ud0dd \ub7f0\uc5d0\uc11c \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \uc5b4\ub5bb\uac8c \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Bbq \uc2a4\ud0dd \ub7f0\uc758 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\uc5d0\ub294 \ube44\ubc00 \ub808\ubca8\uacfc \ud76c\uadc0 \uc544\uc774\ud15c\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ucf58\ud150\uce20\ub97c \ubc1c\uacac\ud558\ub824\uba74 \uacbd\ub85c\uc5d0\uc11c \ubc97\uc5b4\ub09c \uc9c0\uc5ed\uc744 \ud0d0\ud5d8\ud558\uace0 \ud2b9\uc815 \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4 5\ub2e8\uacc4\uc5d0\uc11c \uc228\uaca8\uc9c4 \uace8\ubaa9\uae38\uc744 \ud1b5\ud574 \uc6b0\ud68c\ud558\uba74 \ud76c\uadc0\ud55c \ud669\uae08\uc0c9 BBQ \uc544\uc774\ud15c\uc744 \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ubc1c\uacac\uc740 \uc885\uc885 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ub3c5\ud2b9\ud55c \ubcf4\ub108\uc2a4\uc640 \uc131\ucde8\uac10\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}, {"question": "Bbq \uc2a4\ud0dd \ub7f0 \ucd08\ubcf4\uc790\ub97c \uc704\ud55c \ucd5c\uace0\uc758 \ud301\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ucd08\ubcf4\uc790\ub294 \uae30\ubcf8 \uc81c\uc5b4\ub97c \uc219\ub2ec\ud558\uace0 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\ub294 \ub370 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. \uc2a4\ud0dd\ud0b9\uacfc \uc810\ud504 \uc5f0\uc2b5\uc744 \uc704\ud574 \uc9e7\uc740 \uac70\ub9ac\ub97c \ub2ec\ub9ac\uae30 \uc2dc\uc791\ud558\uc138\uc694. \uac8c\uc784\uc758 \ubb3c\ub9ac\uc801 \ud2b9\uc131\uc744 \ud30c\uc545\ud558\uae30 \uc704\ud574 \ud29c\ud1a0\ub9ac\uc5bc \ub808\ubca8\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4 \ud29c\ud1a0\ub9ac\uc5bc\uc5d0\uc11c \uade0\ud615\uacfc \ubb34\uac8c \ubd84\ud3ec\ub97c \uc774\ud574\ud558\uae30 \uc704\ud574 \ubc84\uac70\ub97c \uc313\ub294 \uc5f0\uc2b5\uc744 \ud558\uc138\uc694."}, {"question": "\ub192\uc740 \uc810\uc218\ub97c \uc704\ud574 Bbq \uc2a4\ud0dd \ub7f0\uc5d0\uc11c \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\uc131\ub2a5 \ucd5c\uc801\ud654\uc5d0\ub294 \uc138 \uac00\uc9c0 \ub2e8\uacc4\uac00 \uc788\uc2b5\ub2c8\ub2e4. 1) **\ud6a8\uc728\uc801\uc778 \uc2a4\ud0dd\ud0b9**: \ub354 \ub098\uc740 \ubc30\uc218\ub97c \uc704\ud574 \uace0\ud488\uc9c8 \ud488\ubaa9\uc744 \uc6b0\uc120\uc2dc\ud558\uc2ed\uc2dc\uc624. 2) **\uc7a5\uc560\ubb3c \ud68c\ud53c**: \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\uae30 \uc704\ud55c \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \ubc30\uc6b0\uc2ed\uc2dc\uc624. 3) **\uc18d\ub3c4 \uc81c\uc5b4**: \uc2a4\ud0dd \ub192\uc774 \ubc0f \uacbd\ub85c \ubcf5\uc7a1\uc131\uc5d0 \ub530\ub77c \uc18d\ub3c4\ub97c \uc870\uc815\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4 \uae09\ucee4\ube0c \uc804\uc5d0 \uc18d\ub3c4\ub97c \uc904\uc774\uba74 \uc2a4\ud0dd\uc744 \uc783\ub294 \uac83\uc744 \ubc29\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ubaa8\ubc14\uc77c \ubc0f PC \ubc84\uc804\uc758 Bbq \uc2a4\ud0dd \ub7f0\uc5d0\ub294 \uc5b4\ub5a4 \ucc28\uc774\uc810\uc774 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ubaa8\ubc14\uc77c \ubc0f PC \ubc84\uc804\uc758 Bbq \uc2a4\ud0dd \ub7f0\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \uc81c\uc5b4 \ubc29\uc2dd\uacfc \uadf8\ub798\ud53d \uc815\ubc00\ub3c4\uc785\ub2c8\ub2e4. \ubaa8\ubc14\uc77c\uc740 \ud130\uce58 \uc81c\uc5b4\ub97c \uc0ac\uc6a9\ud558\ub294 \ubc18\uba74, PC\ub294 \ud0a4\ubcf4\ub4dc \ubc0f \ub9c8\uc6b0\uc2a4\ub97c \uc9c0\uc6d0\ud569\ub2c8\ub2e4. PC\ub294 \ub610\ud55c \ud574\uc0c1\ub3c4\uc640 \ud504\ub808\uc784 \uc18d\ub3c4\uac00 \ub354 \ub192\uc2b5\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ud1b5\ud574 \uc6d0\ud65c\ud55c \uc9c4\ud589 \uc0c1\ud669 \uc804\uc1a1\uc774 \uac00\ub2a5\ud558\ubbc0\ub85c \uae30\ubcf8 \uac8c\uc784 \ud50c\ub808\uc774 \ubc0f \ucf58\ud150\uce20\ub294 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \uc77c\uad00\uc131\uc744 \uc720\uc9c0\ud569\ub2c8\ub2e4."}, {"question": "Bbq \uc2a4\ud0dd \ub7f0\uc5d0\uc11c \uc548\uc815\uc801\uc778 \uc2a4\ud0dd\uc744 \uc720\uc9c0\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ub294 \uae30\uc220\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc548\uc815\uc801\uc778 \uc2a4\ud0dd\uc744 \uc720\uc9c0\ud558\ub294 \ubc29\ubc95\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. 1) **\uc911\uc2ec \ud56d\ubaa9**: \uac01 \ud56d\ubaa9\uc774 \uc2a4\ud0dd\uc758 \uc911\uc559\uc5d0 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. 2) **\ubb34\uac8c \uade0\ud615**: \ub354 \ubb34\uac70\uc6b4 \ud488\ubaa9\uc744 \uc544\ub798\uc5d0 \ubc30\uce58\ud558\uc2ed\uc2dc\uc624. 3) **\ubd80\ub4dc\ub7ec\uc6b4 \uc6c0\uc9c1\uc784**: \uc2a4\ud0dd\uc744 \ubd88\uc548\uc815\ud558\uac8c \ub9cc\ub4dc\ub294 \uac11\uc791\uc2a4\ub7ec\uc6b4 \uc4f8\uc5b4 \ub0b4\ub9bc\uc744 \ud53c\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4 \ubb34\uac70\uc6b4 \uc2a4\ud14c\uc774\ud06c\ub97c \uc313\uc744 \ub54c\ub294 \uae30\ubcf8\uc5d0 \ub450\uace0 \uade0\ud615\uc744 \uc720\uc9c0\ud558\uae30 \uc704\ud574 \uc704\uc5d0 \ube75\uacfc \uac19\uc740 \uac00\ubcbc\uc6b4 \ud488\ubaa9\uc744 \ucd94\uac00\ud558\uc138\uc694."}]
[{"question": "\u5982\u4f55\u5728 Bbq Stack Run \u4e2d\u57f7\u884c\u57fa\u672c\u52d5\u4f5c\uff1f", "answer": "\u5728 Bbq Stack Run \u4e2d\uff0c\u57fa\u672c\u52d5\u4f5c\u5305\u62ec\u8dd1\u6b65\u3001\u8df3\u8e8d\u548c\u5806\u758a\u3002\u8981\u8dd1\u6b65\uff0c\u53ea\u9700\u5728\u87a2\u5e55\u4e0a\u5411\u524d\u65b9\u6ed1\u52d5\u3002\u8981\u8df3\u8e8d\uff0c\u5411\u4e0a\u6ed1\u52d5\uff1b\u8981\u5806\u758a\uff0c\u5247\u5728\u9760\u8fd1 BBQ \u7269\u54c1\u6642\u5411\u4e0b\u6ed1\u52d5\u3002\u4f8b\u5982\uff0c\u7576\u63a5\u8fd1\u4e00\u758a\u6f22\u5821\u6642\uff0c\u5411\u4e0b\u6ed1\u52d5\u5c07\u5b83\u5011\u6dfb\u52a0\u5230\u60a8\u7684\u5806\u758a\u4e2d\u3002\u9019\u5c0d\u65bc\u7dad\u6301\u5e73\u8861\u548c\u901f\u5ea6\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u9032\u968e\u73a9\u5bb6\u5728 Bbq Stack Run \u4e2d\u7684\u4e3b\u8981\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u9032\u968e\u73a9\u5bb6\u61c9\u5c08\u6ce8\u65bc\u4e09\u500b\u4e3b\u8981\u7b56\u7565\uff1a1) **\u7cbe\u78ba\u5806\u758a**: \u78ba\u4fdd\u6bcf\u500b\u7269\u54c1\u90fd\u5b8c\u7f8e\u5c0d\u9f4a\uff0c\u4ee5\u907f\u514d\u50be\u8986\u30022) **\u8a08\u6642\u8df3\u8e8d**: \u5229\u7528\u8df3\u8e8d\u5728\u6700\u5f8c\u4e00\u523b\u8eb2\u907f\u969c\u7919\u7269\u30023) **\u901f\u5ea6\u7ba1\u7406**: \u5e73\u8861\u901f\u5ea6\u548c\u7a69\u5b9a\u6027\uff0c\u907f\u514d\u904e\u5ea6\u8ca0\u8f09\u5806\u758a\u3002\u4f8b\u5982\uff0c\u7576\u63a5\u8fd1\u72f9\u7a84\u7684\u6a4b\u6a11\u6642\uff0c\u8acb\u6e1b\u6162\u901f\u5ea6\u4ee5\u4fdd\u6301\u63a7\u5236\u3002"}, {"question": "Bbq Stack Run \u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "Bbq Stack Run \u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u8ddd\u96e2\u3001\u5806\u758a\u9ad8\u5ea6\u548c\u7269\u54c1\u54c1\u8cea\u3002\u6bcf\u4e00\u516c\u5c3a\u7684\u5954\u8dd1\u90fd\u6703\u589e\u52a0\u60a8\u7684\u5f97\u5206\uff0c\u800c\u5806\u758a\u9ad8\u54c1\u8cea\u7269\u54c1\uff0c\u4f8b\u5982\u9ad8\u7d1a\u725b\u6392\uff0c\u5247\u6703\u5c07\u5f97\u5206\u500d\u589e\u3002\u4f8b\u5982\uff0c\u4e00\u758a 10 \u500b\u9ad8\u7d1a\u725b\u6392\u7684\u5f97\u5206\u5c07\u6703\u986f\u8457\u9ad8\u65bc 10 \u500b\u57fa\u672c\u6f22\u5821\u3002\u5e73\u8861\u9019\u4e9b\u5143\u7d20\u662f\u7372\u5f97\u9ad8\u5206\u7684\u95dc\u9375\u3002"}, {"question": "\u5728 Bbq Stack Run \u4e2d\u70ba\u4ec0\u9ebc\u8981\u7ba1\u7406\u5806\u758a\u9ad8\u5ea6\uff1f", "answer": "\u7ba1\u7406\u5806\u758a\u9ad8\u5ea6\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6703\u5f71\u97ff\u901f\u5ea6\u548c\u7a69\u5b9a\u6027\u3002\u5806\u758a\u8d8a\u9ad8\uff0c\u5f97\u5206\u4e58\u6578\u8d8a\u9ad8\uff0c\u4f46\u63a7\u5236\u8d77\u4f86\u4e5f\u8d8a\u56f0\u96e3\u3002\u4f8b\u5982\uff0c\u4e00\u758a 15 \u500b\u7269\u54c1\u53ef\u80fd\u6703\u5c07\u60a8\u7684\u5f97\u5206\u52a0\u500d\uff0c\u4f46\u4e5f\u589e\u52a0\u50be\u8986\u969c\u7919\u7269\u7684\u98a8\u96aa\u3002\u5e73\u8861\u9ad8\u5ea6\u8207\u63a7\u5236\u662f\u6301\u7e8c\u6210\u529f\u7684\u95dc\u9375\u3002"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u73a9 Bbq Stack Run \u7684\u7cfb\u7d71\u9700\u6c42\u662f\u4ec0\u9ebc\uff1f", "answer": "Bbq Stack Run \u91dd\u5c0d\u884c\u52d5\u88dd\u7f6e\u548c\u96fb\u8166\u5e73\u53f0\u9032\u884c\u6700\u4f73\u5316\u3002\u5c0d\u65bc\u884c\u52d5\u88dd\u7f6e\uff0c\u5b83\u9700\u8981 iOS 10 \u6216 Android 5.0\uff0c\u4e14\u81f3\u5c11\u9700\u8981 2GB \u8a18\u61b6\u9ad4\u3002\u5728\u96fb\u8166\u4e0a\uff0c\u5b83\u53ef\u4ee5\u5728 Windows 10 \u7cfb\u7d71\u4e0a\u904b\u884c\uff0c\u9700\u8981 4GB \u8a18\u61b6\u9ad4\u548c DirectX 11 \u76f8\u5bb9\u7684\u986f\u793a\u5361\u3002\u652f\u63f4\u8de8\u5e73\u53f0\u904a\u6232\uff0c\u8b93\u60a8\u53ef\u4ee5\u900f\u904e\u96f2\u7aef\u5132\u5b58\u540c\u6b65\u904a\u6232\u9032\u5ea6\u3002"}, {"question": "\u5982\u4f55\u5728 Bbq Stack Run \u4e2d\u767c\u73fe\u96b1\u85cf\u5167\u5bb9\uff1f", "answer": "Bbq Stack Run \u4e2d\u7684\u96b1\u85cf\u5167\u5bb9\u5305\u62ec\u79d8\u5bc6\u95dc\u5361\u548c\u7a00\u6709\u7269\u54c1\u3002\u8981\u767c\u73fe\u9019\u4e9b\u5167\u5bb9\uff0c\u8acb\u63a2\u7d22\u504f\u96e2\u7684\u5340\u57df\u4e26\u5b8c\u6210\u7279\u5b9a\u6311\u6230\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 5 \u95dc\u4e2d\uff0c\u7a7f\u8d8a\u96b1\u85cf\u7684\u5df7\u5f04\u6703\u767c\u73fe\u7a00\u6709\u91d1\u8272\u7684 BBQ \u7269\u54c1\u3002\u9019\u4e9b\u767c\u73fe\u901a\u5e38\u6703\u734e\u52f5\u73a9\u5bb6\u7368\u7279\u7684\u734e\u52f5\u548c\u6210\u5c31\u3002"}, {"question": "Bbq Stack Run \u521d\u5b78\u8005\u7684\u6700\u4f73\u505a\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "\u521d\u5b78\u8005\u61c9\u5c08\u6ce8\u65bc\u638c\u63e1\u57fa\u672c\u63a7\u5236\u548c\u4e86\u89e3\u904a\u6232\u6a5f\u5236\u3002\u5f9e\u77ed\u8ddd\u96e2\u7684\u5954\u8dd1\u958b\u59cb\u7df4\u7fd2\u5806\u758a\u548c\u8df3\u8e8d\u3002\u4f7f\u7528\u6559\u5b78\u95dc\u5361\u4f86\u611f\u53d7\u904a\u6232\u7684\u7269\u7406\u7279\u6027\u3002\u4f8b\u5982\uff0c\u5728\u6559\u5b78\u95dc\u5361\u4e2d\uff0c\u7df4\u7fd2\u5806\u758a\u6f22\u5821\u4ee5\u4e86\u89e3\u5e73\u8861\u548c\u91cd\u91cf\u5206\u914d\u3002"}, {"question": "\u5982\u4f55\u512a\u5316\u6211\u7684 Bbq Stack Run \u8868\u73fe\u4ee5\u7372\u5f97\u9ad8\u5206\uff1f", "answer": "\u512a\u5316\u8868\u73fe\u5305\u542b\u4e09\u500b\u6b65\u9a5f\uff1a1) **\u6709\u6548\u5806\u758a**: \u512a\u5148\u9078\u64c7\u9ad8\u54c1\u8cea\u7269\u54c1\u4ee5\u7372\u5f97\u66f4\u9ad8\u7684\u500d\u6578\u30022) **\u969c\u7919\u7269\u8ff4\u907f**: \u5b78\u7fd2\u8df3\u8e8d\u7684\u6642\u9593\u4ee5\u8eb2\u907f\u969c\u7919\u7269\u30023) **\u901f\u5ea6\u63a7\u5236**: \u4f9d\u64da\u5806\u758a\u9ad8\u5ea6\u548c\u8def\u5f91\u8907\u96dc\u5ea6\u8abf\u6574\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u8f49\u5f4e\u524d\u6e1b\u6162\u901f\u5ea6\u53ef\u4ee5\u9632\u6b62\u5806\u758a\u50be\u5012\u3002"}, {"question": "\u884c\u52d5\u88dd\u7f6e\u7248\u548c\u96fb\u8166\u7248\u7684 Bbq Stack Run \u6709\u4ec0\u9ebc\u4e0d\u540c\uff1f", "answer": "\u884c\u52d5\u88dd\u7f6e\u7248\u548c\u96fb\u8166\u7248 Bbq Stack Run \u7684\u4e3b\u8981\u5dee\u7570\u5728\u65bc\u63a7\u5236\u65b9\u5f0f\u548c\u5716\u5f62\u5448\u73fe\u3002\u884c\u52d5\u88dd\u7f6e\u4f7f\u7528\u89f8\u63a7\u63a7\u5236\uff0c\u800c\u96fb\u8166\u7248\u5247\u652f\u63f4\u9375\u76e4\u548c\u6ed1\u9f20\u3002\u96fb\u8166\u7248\u4e5f\u63d0\u4f9b\u66f4\u9ad8\u7684\u89e3\u6790\u5ea6\u548c\u5e40\u7387\u3002\u7136\u800c\uff0c\u6838\u5fc3\u904a\u6232\u73a9\u6cd5\u548c\u5167\u5bb9\u5728\u8de8\u5e73\u53f0\u4fdd\u6301\u4e00\u81f4\uff0c\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u5247\u8b93\u9032\u5ea6\u8f49\u79fb\u9806\u66a2\u7121\u7919\u3002"}, {"question": "\u54ea\u4e9b\u6280\u5de7\u6709\u52a9\u65bc\u5728 Bbq Stack Run \u4e2d\u4fdd\u6301\u5806\u758a\u7a69\u5b9a\uff1f", "answer": "\u7dad\u6301\u7a69\u5b9a\u5806\u758a\u5305\u62ec\uff1a1) **\u7269\u54c1\u4e2d\u5fc3**: \u78ba\u4fdd\u6bcf\u500b\u7269\u54c1\u90fd\u4f4d\u65bc\u5806\u758a\u7684\u4e2d\u5fc3\u30022) **\u5e73\u8861\u91cd\u91cf**: \u5c07\u8f03\u91cd\u7684\u7269\u54c1\u653e\u5728\u5e95\u90e8\u30023) **\u5e73\u7a69\u52d5\u4f5c**: \u907f\u514d\u7a81\u7136\u7684\u6ed1\u52d5\uff0c\u9019\u53ef\u80fd\u6703\u4f7f\u5806\u758a\u4e0d\u7a69\u5b9a\u3002\u4f8b\u5982\uff0c\u7576\u5806\u758a\u91cd\u725b\u6392\u6642\uff0c\u5c07\u5176\u653e\u5728\u5e95\u90e8\uff0c\u4e26\u5728\u4e0a\u9762\u6dfb\u52a0\u8f03\u8f15\u7684\u7269\u54c1\uff08\u5982\u9eb5\u5305\uff09\uff0c\u4ee5\u4fdd\u6301\u5e73\u8861\u3002"}]
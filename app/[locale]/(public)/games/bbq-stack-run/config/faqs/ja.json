[{"question": "Bbq Stack Run\u306e\u57fa\u672c\u7684\u306a\u52d5\u304d\u3092\u3069\u306e\u3088\u3046\u306b\u5b9f\u884c\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Bbq Stack Run\u306e\u57fa\u672c\u7684\u306a\u52d5\u304d\u306b\u306f\u3001\u8d70\u308b\u3001\u30b8\u30e3\u30f3\u30d7\u3001\u7a4d\u307f\u91cd\u306d\u304c\u3042\u308a\u307e\u3059\u3002\u8d70\u308b\u306b\u306f\u3001\u753b\u9762\u3092\u524d\u65b9\u306b\u30b9\u30ef\u30a4\u30d7\u3057\u307e\u3059\u3002\u30b8\u30e3\u30f3\u30d7\u3059\u308b\u306b\u306f\u3001\u4e0a\u65b9\u306b\u30b9\u30ef\u30a4\u30d7\u3057\u3001BBQ\u30a2\u30a4\u30c6\u30e0\u306e\u8fd1\u304f\u306b\u6765\u305f\u3068\u304d\u306b\u7a4d\u307f\u91cd\u306d\u308b\u306b\u306f\u3001\u4e0b\u306b\u30b9\u30ef\u30a4\u30d7\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30cf\u30f3\u30d0\u30fc\u30ac\u30fc\u306e\u7a4d\u307f\u91cd\u306d\u306b\u8fd1\u3065\u304f\u3068\u3001\u7a4d\u307f\u91cd\u306d\u306b\u8ffd\u52a0\u3059\u308b\u305f\u3081\u306b\u4e0b\u306b\u30b9\u30ef\u30a4\u30d7\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u30d0\u30e9\u30f3\u30b9\u3068\u901f\u5ea6\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u91cd\u8981\u3067\u3059\u3002"}, {"question": "Bbq Stack Run\u306e\u9ad8\u5ea6\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u91cd\u8981\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f3\u3064\u306e\u91cd\u8981\u306a\u6226\u7565\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3079\u304d\u3067\u3059\u30021) **\u6b63\u78ba\u306a\u7a4d\u307f\u91cd\u306d**:  \u7a4d\u307f\u91cd\u306d\u3092\u5d29\u3055\u306a\u3044\u3088\u3046\u306b\u3001\u5404\u30a2\u30a4\u30c6\u30e0\u3092\u5b8c\u5168\u306b\u6574\u5217\u3055\u305b\u307e\u3059\u30022) **\u30bf\u30a4\u30df\u30f3\u30b0\u306e\u5408\u3063\u305f\u30b8\u30e3\u30f3\u30d7**: \u6700\u5f8c\u306e\u77ac\u9593\u306b\u969c\u5bb3\u7269\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u30b8\u30e3\u30f3\u30d7\u3092\u4f7f\u7528\u3057\u307e\u3059\u30023) **\u901f\u5ea6\u7ba1\u7406**: \u7a4d\u307f\u91cd\u306d\u3092\u904e\u8ca0\u8377\u306b\u3057\u306a\u3044\u3088\u3046\u306b\u3001\u901f\u5ea6\u3068\u5b89\u5b9a\u6027\u3092\u30d0\u30e9\u30f3\u30b9\u3055\u305b\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u72ed\u3044\u6a4b\u306b\u8fd1\u3065\u304f\u3068\u3001\u5236\u5fa1\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u901f\u5ea6\u3092\u843d\u3068\u3057\u307e\u3059\u3002"}, {"question": "Bbq Stack Run\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "Bbq Stack Run\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u8ddd\u96e2\u3001\u7a4d\u307f\u91cd\u306d\u306e\u9ad8\u3055\u3001\u30a2\u30a4\u30c6\u30e0\u306e\u54c1\u8cea\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u8d70\u3063\u305f\u5404\u30e1\u30fc\u30c8\u30eb\u306f\u30b9\u30b3\u30a2\u306b\u52a0\u7b97\u3055\u308c\u3001\u9ad8\u54c1\u8cea\u306e\u30a2\u30a4\u30c6\u30e0\uff08\u4f8b\u3048\u3070\u3001\u9ad8\u7d1a\u30b9\u30c6\u30fc\u30ad\uff09\u3092\u9ad8\u304f\u7a4d\u307f\u91cd\u306d\u308b\u3068\u30b9\u30b3\u30a2\u500d\u7387\u304c\u4e0a\u6607\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u300110\u500b\u306e\u9ad8\u7d1a\u30b9\u30c6\u30fc\u30ad\u306e\u7a4d\u307f\u91cd\u306d\u306f\u300110\u500b\u306e\u57fa\u672c\u7684\u306a\u30cf\u30f3\u30d0\u30fc\u30ac\u30fc\u306e\u7a4d\u307f\u91cd\u306d\u306b\u6bd4\u3079\u3066\u3001\u5927\u5e45\u306b\u30b9\u30b3\u30a2\u3092\u5897\u52a0\u3055\u305b\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u8981\u7d20\u3092\u30d0\u30e9\u30f3\u30b9\u3055\u305b\u308b\u3053\u3068\u304c\u3001\u9ad8\u5f97\u70b9\u3092\u9054\u6210\u3059\u308b\u305f\u3081\u306e\u9375\u3068\u306a\u308a\u307e\u3059\u3002"}, {"question": "Bbq Stack Run\u3067\u7a4d\u307f\u91cd\u306d\u306e\u9ad8\u3055\u3092\u7ba1\u7406\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u7a4d\u307f\u91cd\u306d\u306e\u9ad8\u3055\u3092\u7ba1\u7406\u3059\u308b\u3053\u3068\u306f\u3001\u901f\u5ea6\u3068\u5b89\u5b9a\u6027\u306e\u4e21\u65b9\u306b\u5f71\u97ff\u3059\u308b\u305f\u3081\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u7a4d\u307f\u91cd\u306d\u304c\u5927\u304d\u304f\u306a\u308b\u3068\u3001\u30b9\u30b3\u30a2\u306e\u500d\u7387\u306f\u4e0a\u304c\u308a\u307e\u3059\u304c\u3001\u5236\u5fa1\u3057\u3065\u3089\u304f\u306a\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u300115\u500b\u30a2\u30a4\u30c6\u30e0\u306e\u7a4d\u307f\u91cd\u306d\u306f\u30b9\u30b3\u30a2\u30922\u500d\u306b\u3059\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u304c\u3001\u969c\u5bb3\u7269\u3092\u4e57\u308a\u8d8a\u3048\u308b\u30ea\u30b9\u30af\u3082\u9ad8\u307e\u308a\u307e\u3059\u3002\u9ad8\u3055\uff08\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\uff09\u3068\u5236\u5fa1\u306e\u30d0\u30e9\u30f3\u30b9\u3092\u3068\u308b\u3053\u3068\u304c\u3001\u6301\u7d9a\u7684\u306a\u6210\u529f\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002"}, {"question": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067Bbq Stack Run\u3092\u30d7\u30ec\u30a4\u3059\u308b\u305f\u3081\u306e\u30b7\u30b9\u30c6\u30e0\u8981\u4ef6\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Bbq Stack Run\u306f\u3001\u30e2\u30d0\u30a4\u30eb\u3068PC\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u4e21\u65b9\u3067\u6700\u9069\u5316\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u306e\u5834\u5408\u3001iOS 10\u307e\u305f\u306fAndroid 5.0\u4ee5\u4e0a\u30012GB\u4ee5\u4e0a\u306eRAM\u304c\u5fc5\u8981\u3067\u3059\u3002PC\u306e\u5834\u5408\u3001Windows 10\u30014GB\u306eRAM\u3001DirectX 11\u4e92\u63db\u306eGPU\u304c\u5fc5\u8981\u3067\u3059\u3002\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30d7\u30ec\u30a4\u304c\u30b5\u30dd\u30fc\u30c8\u3055\u308c\u3066\u3044\u308b\u305f\u3081\u3001\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u901a\u3058\u3066\u9032\u6357\u72b6\u6cc1\u3092\u540c\u671f\u3067\u304d\u307e\u3059\u3002"}, {"question": "Bbq Stack Run\u3067\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u767a\u898b\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Bbq Stack Run\u306e\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u306b\u306f\u3001\u96a0\u3057\u30ec\u30d9\u30eb\u3068\u30ec\u30a2\u30a2\u30a4\u30c6\u30e0\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u3053\u308c\u3089\u3092\u898b\u3064\u3051\u308b\u305f\u3081\u306b\u306f\u3001\u30aa\u30d5\u30d1\u30b9\u30a8\u30ea\u30a2\u3092\u63a2\u691c\u3057\u3001\u7279\u5b9a\u306e\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u5b8c\u4e86\u3059\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb5\u3067\u306f\u3001\u96a0\u308c\u305f\u901a\u308a\u3092\u8fc2\u56de\u3059\u308b\u3053\u3068\u306b\u3088\u308a\u3001\u30ec\u30a2\u306a\u9ec4\u91d1\u306eBBQ\u30a2\u30a4\u30c6\u30e0\u304c\u898b\u3064\u304b\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u767a\u898b\u306b\u3088\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30e6\u30cb\u30fc\u30af\u306a\u30dc\u30fc\u30ca\u30b9\u3084\u5b9f\u7e3e\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Bbq Stack Run\u306e\u521d\u5fc3\u8005\u306b\u3068\u3063\u3066\u3001\u3069\u306e\u3088\u3046\u306a\u30d9\u30b9\u30c8\u30d7\u30e9\u30af\u30c6\u30a3\u30b9\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u521d\u5fc3\u8005\u306e\u65b9\u306f\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u7fd2\u5f97\u3057\u3001\u30b2\u30fc\u30e0\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3079\u304d\u3067\u3059\u3002\u77ed\u3044\u30e9\u30f3\u30cb\u30f3\u30b0\u304b\u3089\u59cb\u3081\u3066\u3001\u7a4d\u307f\u91cd\u306d\u3068\u30b8\u30e3\u30f3\u30d7\u306e\u7df4\u7fd2\u3092\u884c\u3044\u307e\u3057\u3087\u3046\u3002\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30ec\u30d9\u30eb\u3092\u4f7f\u7528\u3057\u3066\u3001\u30b2\u30fc\u30e0\u306e\u7269\u7406\u7684\u306a\u611f\u899a\u3092\u63b4\u307f\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3067\u306f\u3001\u30d0\u30e9\u30f3\u30b9\u3068\u91cd\u91cf\u5206\u5e03\u3092\u7406\u89e3\u3059\u308b\u305f\u3081\u306b\u30cf\u30f3\u30d0\u30fc\u30ac\u30fc\u3092\u7a4d\u307f\u91cd\u306d\u308b\u7df4\u7fd2\u3092\u884c\u3044\u307e\u3059\u3002"}, {"question": "Bbq Stack Run\u3067\u9ad8\u5f97\u70b9\u3092\u53d6\u308b\u305f\u3081\u306b\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u30013\u3064\u306e\u30b9\u30c6\u30c3\u30d7\u304c\u3042\u308a\u307e\u3059\u30021) **\u52b9\u7387\u7684\u306a\u7a4d\u307f\u91cd\u306d**: \u3088\u308a\u826f\u3044\u500d\u7387\u3092\u5f97\u308b\u305f\u3081\u306b\u9ad8\u54c1\u8cea\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u512a\u5148\u3057\u307e\u3059\u30022) **\u969c\u5bb3\u7269\u306e\u56de\u907f**: \u969c\u5bb3\u7269\u3092\u907f\u3051\u308b\u305f\u3081\u306e\u30b8\u30e3\u30f3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5b66\u3073\u307e\u3059\u30023) **\u901f\u5ea6\u306e\u5236\u5fa1**: \u7a4d\u307f\u91cd\u306d\u306e\u9ad8\u3055\u3084\u9053\u306e\u8907\u96d1\u3055\u306b\u3088\u3063\u3066\u901f\u5ea6\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6025\u306a\u30ab\u30fc\u30d6\u306e\u524d\u306b\u901f\u5ea6\u3092\u843d\u3068\u3059\u3068\u3001\u7a4d\u307f\u91cd\u306d\u3092\u5931\u3046\u306e\u3092\u9632\u3050\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30e2\u30d0\u30a4\u30eb\u7248\u3068PC\u7248\u306eBbq Stack Run\u306e\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30e2\u30d0\u30a4\u30eb\u7248\u3068PC\u7248\u306eBbq Stack Run\u306e\u4e3b\u306a\u9055\u3044\u306f\u3001\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u30b9\u30ad\u30fc\u30e0\u3068\u30b0\u30e9\u30d5\u30a3\u30ab\u30eb\u306a\u5fe0\u5b9f\u5ea6\u3067\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u306f\u30bf\u30c3\u30c1\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3092\u4f7f\u7528\u3057\u307e\u3059\u304c\u3001PC\u306f\u30ad\u30fc\u30dc\u30fc\u30c9\u3068\u30de\u30a6\u30b9\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u307e\u3059\u3002PC\u306f\u3088\u308a\u9ad8\u3044\u89e3\u50cf\u5ea6\u3068\u30d5\u30ec\u30fc\u30e0\u30ec\u30fc\u30c8\u3092\u5b9f\u73fe\u3057\u307e\u3059\u3002\u305f\u3060\u3057\u3001\u30b2\u30fc\u30e0\u306e\u57fa\u672c\u7684\u306a\u30d7\u30ec\u30a4\u3068\u30b3\u30f3\u30c6\u30f3\u30c4\u306f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u4e00\u8cab\u3057\u3066\u304a\u308a\u3001\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u306b\u3088\u308a\u9032\u6357\u72b6\u6cc1\u306e\u30b7\u30fc\u30e0\u30ec\u30b9\u306a\u8ee2\u9001\u304c\u53ef\u80fd\u306b\u306a\u308a\u307e\u3059\u3002"}, {"question": "Bbq Stack Run\u3067\u5b89\u5b9a\u3057\u305f\u7a4d\u307f\u91cd\u306d\u3092\u7dad\u6301\u3059\u308b\u30c6\u30af\u30cb\u30c3\u30af\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u5b89\u5b9a\u3057\u305f\u7a4d\u307f\u91cd\u306d\u3092\u7dad\u6301\u3059\u308b\u306b\u306f\u3001\u6b21\u306e\u30c6\u30af\u30cb\u30c3\u30af\u304c\u3042\u308a\u307e\u3059\u30021) **\u30a2\u30a4\u30c6\u30e0\u306e\u4e2d\u5fc3\u5316**: \u5404\u30a2\u30a4\u30c6\u30e0\u3092\u7a4d\u307f\u91cd\u306d\u306e\u4e2d\u5fc3\u306b\u304d\u3061\u3093\u3068\u914d\u7f6e\u3057\u307e\u3059\u30022) **\u91cd\u307f\u306e\u30d0\u30e9\u30f3\u30b9**: \u91cd\u3044\u30a2\u30a4\u30c6\u30e0\u3092\u4e0b\u90e8\u306b\u914d\u7f6e\u3057\u307e\u3059\u30023) **\u6ed1\u3089\u304b\u306a\u52d5\u304d**: \u7a4d\u307f\u91cd\u306d\u3092\u4e0d\u5b89\u5b9a\u306b\u3059\u308b\u53ef\u80fd\u6027\u306e\u3042\u308b\u7a81\u7136\u306e\u30b9\u30ef\u30a4\u30d7\u3092\u907f\u3051\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u91cd\u3044\u30b9\u30c6\u30fc\u30ad\u3092\u7a4d\u307f\u91cd\u306d\u308b\u969b\u306b\u306f\u3001\u4e0b\u90e8\u306b\u7f6e\u304d\u3001\u30d0\u30e9\u30f3\u30b9\u3092\u4fdd\u3064\u305f\u3081\u306b\u4e0a\u90e8\u306b\u8efd\u3044\u30a2\u30a4\u30c6\u30e0\uff08\u4f8b\u3048\u3070\u3001\u30d0\u30f3\u30ba\uff09\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002"}]
[{"question": "\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u70b8\u5f487\u300b\u5feb\u901f\u4e0a\u624b\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u958b\u59cb\u300a\u70b8\u5f487\u300b\uff0c\u8acb\u5148\u719f\u6089\u57fa\u672c\u63a7\u5236\uff1a\u4f7f\u7528\u65b9\u5411\u9375\u6216 WASD \u9375\u79fb\u52d5\uff0c\u7a7a\u683c\u9375\u653e\u7f6e\u70b8\u5f48\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u95dc\uff0c\u4f60\u53ef\u4ee5\u7df4\u7fd2\u5728\u5730\u5716\u4e0a\u79fb\u52d5\u4e26\u653e\u7f6e\u70b8\u5f48\u6467\u6bc0\u65b9\u584a\u3002\u6b64\u5916\uff0c\u5f37\u70c8\u5efa\u8b70\u65b0\u624b\u73a9\u5bb6\u4f7f\u7528\u6559\u5b78\u6a21\u5f0f\u4f86\u7406\u89e3\u6838\u5fc3\u6a5f\u5236\u3002"}, {"question": "\u300a\u70b8\u5f487\u300b\u4e2d\u6709\u54ea\u4e9b\u5fc5\u5099\u589e\u76ca\u9053\u5177\uff0c\u4ee5\u53ca\u5b83\u5011\u5982\u4f55\u63d0\u5347\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u300a\u70b8\u5f487\u300b\u4e2d\u5fc5\u5099\u7684\u589e\u76ca\u9053\u5177\u5305\u62ec\u70b8\u5f48\u5bb9\u91cf\uff0c\u589e\u52a0\u4f60\u80fd\u540c\u6642\u653e\u7f6e\u7684\u70b8\u5f48\u6578\u91cf\uff1b\u4ee5\u53ca\u706b\u7130\u529b\u91cf\uff0c\u64f4\u5c55\u7206\u70b8\u7bc4\u570d\u3002\u4f8b\u5982\uff0c\u62fe\u53d6\u70b8\u5f48\u5bb9\u91cf\u589e\u76ca\u9053\u5177\uff0c\u8b93\u4f60\u4e00\u6b21\u653e\u7f6e\u591a\u9054\u4e09\u500b\u70b8\u5f48\uff0c\u5728\u6e05\u9664\u969c\u7919\u7269\u548c\u64ca\u6557\u6575\u4eba\u6642\uff0c\u80fd\u7372\u5f97\u7b56\u7565\u512a\u52e2\u3002\u9019\u4e9b\u589e\u76ca\u9053\u5177\u5c0d\u65bc\u901a\u95dc\u66f4\u5177\u6311\u6230\u6027\u7684\u95dc\u5361\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u5728\u300a\u70b8\u5f487\u300b\u4e2d\uff0c\u70ba\u4f55\u653e\u7f6e\u70b8\u5f48\u7684\u6642\u6a5f\u5f88\u91cd\u8981\uff1f\u73a9\u5bb6\u5982\u4f55\u638c\u63e1\u5b83\uff1f", "answer": "\u5728\u300a\u70b8\u5f487\u300b\u4e2d\uff0c\u6642\u9593\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u70b8\u5f48\u5728\u7206\u70b8\u524d\u6709\u4e00\u500b\u5012\u6578\u8a08\u6642\u3002\u638c\u63e1\u6642\u6a5f\u9700\u8981\u9810\u6e2c\u6575\u4eba\u52d5\u4f5c\u548c\u70b8\u5f48\u7206\u70b8\u7bc4\u570d\u3002\u4f8b\u5982\uff0c\u5728\u64c1\u64e0\u7684\u5340\u57df\uff0c\u7576\u6575\u4eba\u63a5\u8fd1\u6642\uff0c\u5c07\u70b8\u5f48\u653e\u7f6e\u5728\u5176\u9644\u8fd1\uff0c\u5373\u53ef\u5c07\u5176\u56f0\u4f4f\u4e26\u6d88\u6ec5\u3002\u5728\u8f03\u65e9\u7684\u95dc\u5361\u4e2d\u7df4\u7fd2\u611f\u53d7\u70b8\u5f48\u8a08\u6642\u5668\u548c\u7206\u70b8\u534a\u5f91\u3002"}, {"question": "\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u70b8\u5f487\u300b\u7684\u591a\u4eba\u6a21\u5f0f\u4e2d\u4f54\u64da\u512a\u52e2\uff1f", "answer": "\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u53ef\u4ee5\u5728\u300a\u70b8\u5f487\u300b\u591a\u4eba\u6a21\u5f0f\u4e2d\u904b\u7528\u9ad8\u7d1a\u7b56\u7565\uff0c\u4f8b\u5982\u9023\u9396\u70b8\u5f48\u548c\u589e\u76ca\u9053\u5177\u63a7\u5236\u3002\u9023\u9396\u70b8\u5f48\u662f\u6307\u9023\u7e8c\u653e\u7f6e\u591a\u500b\u70b8\u5f48\uff0c\u5275\u9020\u66f4\u5927\u7206\u70b8\u7bc4\u570d\u3002\u4f8b\u5982\uff0c\u5148\u653e\u7f6e\u4e00\u679a\u70b8\u5f48\uff0c\u7b49\u5f85\u8a08\u6642\u5668\uff0c\u7136\u5f8c\u518d\u653e\u7f6e\u53e6\u4e00\u500b\u70b8\u5f48\u4ee5\u64f4\u5c55\u7206\u70b8\u534a\u5f91\u3002\u589e\u76ca\u9053\u5177\u63a7\u5236\u6307\u7684\u662f\u5728\u904a\u6232\u521d\u671f\u6436\u596a\u95dc\u9375\u589e\u76ca\u9053\u5177\uff0c\u4f8b\u5982\u901f\u5ea6\u548c\u706b\u7130\u529b\u91cf\uff0c\u4ee5\u7372\u5f97\u5c0d\u624b\u512a\u52e2\u3002"}, {"question": "\u300a\u70b8\u5f487\u300b\u7684\u5f97\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f\u54ea\u4e9b\u56e0\u7d20\u53ef\u4ee5\u6700\u5927\u5316\u5f97\u5206\uff1f", "answer": "\u300a\u70b8\u5f487\u300b\u7684\u5f97\u5206\u7cfb\u7d71\u6703\u734e\u52f5\u73a9\u5bb6\u6467\u6bc0\u65b9\u584a\u3001\u64ca\u6557\u6575\u4eba\u548c\u6536\u96c6\u589e\u76ca\u9053\u5177\u3002\u6700\u5927\u5316\u5f97\u5206\u7684\u95dc\u9375\u56e0\u7d20\u5305\u62ec\u5feb\u901f\u901a\u95dc\u3001\u4f7f\u7528\u9023\u9396\u7206\u70b8\u548c\u7dad\u6301\u9ad8\u8840\u91cf\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u55ae\u679a\u70b8\u5f48\u6467\u6bc0\u591a\u500b\u65b9\u584a\u6703\u7372\u5f97\u9023\u9396\u5f97\u5206\uff0c\u986f\u8457\u63d0\u5347\u4f60\u7684\u5206\u6578\u3002"}, {"question": "\u300a\u70b8\u5f487\u300b\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u6a5f\u5236\u53ef\u4ee5\u8b93\u73a9\u5bb6\u5728\u7af6\u722d\u6027\u904a\u6232\u4e2d\u7372\u5f97\u512a\u52e2\uff1f", "answer": "\u300a\u70b8\u5f487\u300b\u4e2d\u7684\u96b1\u85cf\u6a5f\u5236\u5305\u62ec\u70b8\u5f48\u758a\u52a0\u548c\u7246\u58c1\u7a7f\u900f\u3002\u70b8\u5f48\u758a\u52a0\u5141\u8a31\u73a9\u5bb6\u5c07\u70b8\u5f48\u758a\u653e\u5728\u4e00\u8d77\uff0c\u4ee5\u7372\u5f97\u66f4\u96c6\u4e2d\u7684\u7206\u70b8\u6548\u679c\u3002\u7246\u58c1\u7a7f\u900f\u6709\u6642\u5141\u8a31\u73a9\u5bb6\u7a7f\u904e\u67d0\u4e9b\u7246\u58c1\uff0c\u63d0\u4f9b\u6230\u8853\u512a\u52e2\u3002\u9019\u4e9b\u6a5f\u5236\u4e26\u975e\u660e\u78ba\u6559\u5b78\uff0c\u800c\u662f\u9700\u8981\u900f\u904e\u5be6\u9a57\u548c\u7df4\u7fd2\u624d\u80fd\u767c\u73fe\u3002"}, {"question": "\u300a\u70b8\u5f487\u300b\u7684\u95dc\u5361\u8a2d\u8a08\u5982\u4f55\u5f71\u97ff\u73a9\u5bb6\u7684\u7b56\u7565\u548c\u6c7a\u7b56\uff1f", "answer": "\u300a\u70b8\u5f487\u300b\u7684\u95dc\u5361\u8a2d\u8a08\u6703\u5f71\u97ff\u7b56\u7565\uff0c\u4f8b\u5982\u900f\u904e\u6539\u8b8a\u65b9\u584a\u3001\u6575\u4eba\u548c\u589e\u76ca\u9053\u5177\u7684\u4f48\u5c40\u3002\u4f8b\u5982\uff0c\u72f9\u7a84\u8d70\u5eca\u7684\u95dc\u5361\u9700\u8981\u7cbe\u78ba\u7684\u70b8\u5f48\u653e\u7f6e\uff0c\u800c\u958b\u653e\u5340\u57df\u5247\u5141\u8a31\u66f4\u591a\u7b56\u7565\u6027\u79fb\u52d5\u3002\u73a9\u5bb6\u5fc5\u9808\u6839\u64da\u95dc\u5361\u8a2d\u8a08\u8abf\u6574\u4ed6\u5011\u7684\u7b56\u7565\uff0c\u4f8b\u5982\u512a\u5148\u8003\u616e\u67d0\u4e9b\u589e\u76ca\u9053\u5177\u6216\u96c6\u4e2d\u65bc\u6575\u4eba\u6d88\u6ec5\u3002"}, {"question": "\u300a\u70b8\u5f487\u300b\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u7684\u6280\u8853\u9700\u6c42\u70ba\u4f55\uff1f\u6548\u80fd\u5982\u4f55\u8b8a\u5316\uff1f", "answer": "\u300a\u70b8\u5f487\u300b\u7684\u6280\u8853\u8981\u6c42\u4e0d\u9ad8\uff0c\u53ef\u5728\u5927\u591a\u6578\u73fe\u4ee3\u88dd\u7f6e\u4e0a\u9806\u66a2\u904b\u884c\u3002\u5728\u96fb\u8166\u4e0a\uff0c\u5efa\u8b70\u81f3\u5c11\u914d\u7f6e 2GB \u8a18\u61b6\u9ad4\u548c\u96d9\u6838\u5fc3\u8655\u7406\u5668\u3002\u5728\u624b\u6a5f\u4e0a\uff0c\u81f3\u5c11\u9700\u8981 1GB \u8a18\u61b6\u9ad4\u4ee5\u53ca Android 5.0 \u6216 iOS 9.0 \u7cfb\u7d71\u3002\u6548\u80fd\u7565\u6709\u5dee\u7570\uff0c\u96fb\u8166\u63d0\u4f9b\u66f4\u9ad8\u7684\u756b\u9762\u5e40\u7387\uff0c\u800c\u624b\u6a5f\u5247\u63d0\u4f9b\u651c\u5e36\u6027\u3002\u8de8\u5e73\u53f0\u904a\u6232\u652f\u63f4\uff0c\u5141\u8a31\u9806\u66a2\u7684\u591a\u4eba\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u300a\u70b8\u5f487\u300b\u4e2d\u54ea\u4e9b\u79d8\u5bc6\u95dc\u5361\u6216\u96b1\u85cf\u5167\u5bb9\u53ef\u4ee5\u89e3\u9396\uff0c\u4ee5\u53ca\u5176\u689d\u4ef6\u70ba\u4f55\uff1f", "answer": "\u300a\u70b8\u5f487\u300b\u7684\u79d8\u5bc6\u95dc\u5361\u53ef\u900f\u904e\u9054\u6210\u7279\u5b9a\u91cc\u7a0b\u7891\u89e3\u9396\uff0c\u4f8b\u5982\u4ee5\u5b8c\u7f8e\u5206\u6578\u5b8c\u6210\u6240\u6709\u95dc\u5361\u6216\u5728\u7279\u5b9a\u95dc\u5361\u4e2d\u627e\u5230\u96b1\u85cf\u9470\u5319\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 5 \u95dc\u627e\u5230\u96b1\u85cf\u9470\u5319\uff0c\u5373\u53ef\u89e3\u9396\u5177\u6709\u7368\u7279\u6311\u6230\u548c\u734e\u52f5\u7684\u984d\u5916\u95dc\u5361\u3002\u63a2\u7d22\u5730\u5716\u7684\u6bcf\u500b\u89d2\u843d\u4e26\u5617\u8a66\u4e0d\u540c\u7684\u7b56\u7565\uff0c\u53ef\u4ee5\u5e6b\u52a9\u4f60\u767c\u73fe\u9019\u4e9b\u96b1\u85cf\u5bf6\u85cf\u3002"}, {"question": "\u5982\u4f55\u5728\u300a\u70b8\u5f487\u300b\u6709\u6548\u7ba1\u7406\u70b8\u5f48\u5b58\u91cf\uff0c\u907f\u514d\u88ab\u56f0\u4f4f\uff1f", "answer": "\u5728\u300a\u70b8\u5f487\u300b\u4e2d\u6709\u6548\u7ba1\u7406\u70b8\u5f48\u5b58\u91cf\u6d89\u53ca\u7b56\u7565\u6027\u7684\u653e\u7f6e\u548c\u6642\u6a5f\u3002\u6b65\u9a5f\u4e00\uff1a\u6c38\u9060\u4fdd\u7559\u4e00\u679a\u70b8\u5f48\u4f5c\u70ba\u9003\u751f\u8def\u7dda\u3002\u6b65\u9a5f\u4e8c\uff1a\u5728\u6700\u5927\u5316\u50b7\u5bb3\u4e14\u4e0d\u963b\u7919\u4f60\u524d\u9032\u7684\u5340\u57df\u653e\u7f6e\u70b8\u5f48\u3002\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u901f\u5ea6\u589e\u76ca\u9053\u5177\u5feb\u901f\u9060\u96e2\u7206\u70b8\u3002\u4f8b\u5982\uff0c\u5728\u72f9\u5c0f\u7684\u7a7a\u9593\u4e2d\uff0c\u5148\u653e\u7f6e\u4e00\u679a\u70b8\u5f48\uff0c\u7136\u5f8c\u7acb\u5373\u79fb\u52d5\u5230\u5b89\u5168\u5340\u57df\uff0c\u4ee5\u907f\u514d\u88ab\u56f0\u3002"}]
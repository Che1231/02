[{"question": "Bomb-it-7\u5982\u4f55\u958b\u59cb\u904a\u6232\uff1f\u65b0\u624b\u5feb\u901f\u4e0a\u624b\u6307\u5357\uff1a\u6309\u4e0b\u54ea\u500b\u9375\u958b\u59cb\uff0c\u4ee5\u53ca\u5982\u4f55\u700f\u89bd\u83dc\u55ae\uff1f", "answer": "\u958b\u59cbBomb-it-7\u975e\u5e38\u7c21\u55ae\uff01\u904a\u6232\u8f09\u5165\u5b8c\u6210\u5f8c\uff0c\u5728\u4e3b\u9078\u55ae\u4e2d\u4f7f\u7528\u65b9\u5411\u9375\u9078\u64c7\u904a\u6232\u6a21\u5f0f\uff08\u4f8b\u5982\uff1a\u55ae\u4eba\u6a21\u5f0f\u3001\u96d9\u4eba\u6a21\u5f0f\uff09\uff0c\u7136\u5f8c\u6309\u4e0bEnter\u9375\u78ba\u8a8d\u3002\u5982\u679c\u662f\u96d9\u4eba\u6a21\u5f0f\uff0cP1\u53ef\u4ee5\u4f7f\u7528WASD\u9032\u884c\u79fb\u52d5\uff0cJ\u9375\u653e\u7f6e\u70b8\u5f48\uff1bP2\u4f7f\u7528\u65b9\u5411\u9375\u79fb\u52d5\uff0cEnter\u9375\u653e\u7f6e\u70b8\u5f48\u3002\u904a\u6232\u76ee\u6a19\u662f\u70b8\u6389\u6240\u6709\u6575\u4eba\u6216\u9054\u6210\u6307\u5b9a\u689d\u4ef6\uff01\u6bd4\u55bb\u8aaa\u660e\uff1a\u65b0\u624b\u968e\u6bb5\uff0c\u4f60\u53ef\u4ee5\u60f3\u50cf\u81ea\u5df1\u662f\u62c6\u5f48\u90e8\u968a\uff0c\u51b7\u975c\u6c7a\u7b56\uff0c\u6b65\u6b65\u70ba\u71df\u3002\u65b0\u624b\u5efa\u8b70\u512a\u5148\u9078\u64c7\u7c21\u55ae\u96e3\u5ea6\uff0c\u719f\u6089\u64cd\u4f5c\u548c\u904a\u6232\u898f\u5247\u3002"}, {"question": "Bomb-it-7\u6709\u54ea\u4e9b\u4e0d\u540c\u7684\u9053\u5177\uff0c\u4ee5\u53ca\u5b83\u5011\u5982\u4f55\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff1f\u6709\u54ea\u4e9b\u9053\u5177\uff1f", "answer": "Bomb-it-7\u6709\u5f88\u591a\u6709\u8da3\u7684\u9053\u5177\u53ef\u4ee5\u62fe\u53d6\uff0c\u62fe\u53d6\u5f8c\u7acb\u5373\u751f\u6548\u3002\u5e38\u898b\u5305\u62ec\uff1a\n1.  \u706b\u7130\u589e\u5f37\uff1a\u589e\u52a0\u70b8\u5f48\u7206\u70b8\u7bc4\u570d\uff0c\u8b93\u60a8\u66f4\u5bb9\u6613\u70b8\u5230\u6575\u4eba\u3002\u4f8b\u5982\uff0c\u521d\u59cb\u70b8\u5f48\u7bc4\u570d\u53ea\u67091\u683c\uff0c\u62fe\u53d6\u706b\u7130\u589e\u5f37\u5f8c\u53ef\u64f4\u5927\u52302\u683c\uff0c\u751a\u81f3\u5168\u5c4f\u3002\n2.  \u70b8\u5f48\u6578\u91cf\u589e\u52a0\uff1a \u5141\u8a31\u60a8\u4e00\u6b21\u653e\u7f6e\u66f4\u591a\u7684\u70b8\u5f48\uff0c\u5f62\u6210\u66f4\u5bc6\u96c6\u7684\u8f5f\u70b8\u5340\u3002\u4f8b\u5982\uff0c\u521d\u59cb\u53ea\u80fd\u653e1\u500b\u70b8\u5f48\uff0c\u62fe\u53d6\u5f8c\u53ef\u4ee5\u540c\u6642\u653e\u7f6e2\u500b\u62163\u500b\u3002\n3.  \u901f\u5ea6\u63d0\u5347\uff1a \u589e\u52a0\u60a8\u7684\u79fb\u52d5\u901f\u5ea6\uff0c\u8b93\u60a8\u66f4\u9748\u6d3b\u5730\u8eb2\u907f\u6575\u4eba\u7684\u653b\u64ca\uff0c\u6216\u8005\u66f4\u5feb\u5730\u8ffd\u64ca\u6575\u4eba\u3002\u901f\u5ea6\u63d0\u5347\u7684\u6548\u679c\u5728\u87a2\u5e55\u4e0b\u65b9\u901a\u5e38\u6703\u6709\u986f\u793a\u3002\n4.  \u7a7f\u7246\u6280\u80fd\uff1a\u60a8\u53ef\u4ee5\u7a7f\u904e\u7246\u58c1\uff0c\u65b9\u4fbf\u7e5e\u5f8c\u5077\u8972\u3002\u8a18\u4f4f\uff0c\u719f\u7df4\u638c\u63e1\u9053\u5177\u7684\u904b\u7528\u662f\u8d0f\u5f97\u6bd4\u8cfd\u7684\u95dc\u9375\uff01\u5f37\u5316\u5143\u7d20\uff1a\u914d\u7f6e\u5c0d\u7167\u8868\uff0c\u5217\u8209\u6240\u6709\u9053\u5177\u53ca\u5176\u529f\u80fd\u3002"}, {"question": "Bomb-it-7\u7684\u70b8\u5f48\u5982\u4f55\u5f15\u7206\uff1f\u5982\u4f55\u624b\u52d5\u5f15\u7206\u70b8\u5f48\uff1f", "answer": "\u5728Bomb-it-7\u4e2d\uff0c\u70b8\u5f48\u9810\u8a2d\u662f\u653e\u7f6e\u5f8c\u4e00\u6bb5\u6642\u9593\u81ea\u52d5\u7206\u70b8\u3002\u60a8\u7121\u6cd5\u624b\u52d5\u5f15\u7206\u70b8\u5f48\u3002\u4f46\u662f\uff0c\u60a8\u53ef\u4ee5\u900f\u904e\u4ee5\u4e0b\u65b9\u5f0f\u9593\u63a5\u63a7\u5236\u7206\u70b8\u6642\u6a5f\uff1a\n1.  \u9023\u7e8c\u653e\u7f6e\uff1a \u56e0\u70ba\u70b8\u5f48\u6709\u653e\u7f6e\u6578\u91cf\u9650\u5236\uff0c\u7576\u9054\u5230\u4e0a\u9650\u6642\uff0c\u65b0\u653e\u7f6e\u7684\u70b8\u5f48\u6703\u66ff\u63db\u6700\u65e9\u653e\u7f6e\u7684\u70b8\u5f48\uff0c\u5c0e\u81f4\u5176\u7206\u70b8\u3002\n2.  \u5229\u7528\u9053\u5177\uff1a \u67d0\u4e9b\u9053\u5177\u53ef\u80fd\u6703\u5f71\u97ff\u70b8\u5f48\u7684\u7206\u70b8\u6642\u9593\u6216\u65b9\u5f0f\uff0c\u8acb\u6ce8\u610f\u904a\u6232\u5167\u63d0\u793a\u3002\n\u6d41\u7a0b\u5716\u89e3\uff1a\u653e\u7f6e\u70b8\u5f48->\u7b49\u5f85\u4e00\u6bb5\u6642\u9593->\u70b8\u5f48\u7206\u70b8"}, {"question": "\u5728Bomb-it-7\u4e2d\uff0c\u5982\u4f55\u6709\u6548\u5730\u5229\u7528\u5730\u5f62\u548c\u969c\u7919\u7269\u4f86\u7372\u5f97\u512a\u52e2\uff1f\u70ba\u4ec0\u9ebc\u5730\u5716\u610f\u8b58\u5f88\u91cd\u8981\uff1f", "answer": "\u5728Bomb-it-7\u4e2d\uff0c\u5730\u5f62\u548c\u969c\u7919\u7269\u662f\u91cd\u8981\u7684\u6230\u7565\u8cc7\u6e90\u3002\u5de7\u5999\u5229\u7528\u5b83\u5011\u53ef\u4ee5\u8b93\u60a8\u5728\u5c0d\u6230\u4e2d\u4f54\u64da\u512a\u52e2\uff1a\n1.  \u5229\u7528\u7246\u58c1\uff1a \u5c07\u6575\u4eba\u5f15\u8a98\u5230\u7246\u58c1\u9644\u8fd1\uff0c\u7136\u5f8c\u653e\u7f6e\u70b8\u5f48\uff0c\u4f7f\u5176\u7121\u8655\u53ef\u9003\u3002\u7279\u5225\u662f\u5c0d\u65bc\u79fb\u52d5\u901f\u5ea6\u8f03\u6162\u7684\u6575\u4eba\uff0c\u9019\u7a2e\u65b9\u6cd5\u975e\u5e38\u6709\u6548\u3002\u7bc4\u4f8b\uff1a\u5728\u72f9\u7a84\u7684\u901a\u9053\u4e2d\uff0c\u7246\u58c1\u662f\u5929\u7136\u7684\u5c4f\u969c\uff0c\u53ef\u4ee5\u9650\u5236\u6575\u4eba\u7684\u79fb\u52d5\u3002\n2.  \u88fd\u9020\u9677\u9631\uff1a \u5728\u969c\u7919\u7269\u5468\u570d\u653e\u7f6e\u70b8\u5f48\uff0c\u5f62\u6210\u4e00\u500b\u9677\u9631\uff0c\u7b49\u5f85\u6575\u4eba\u81ea\u6295\u7f85\u7db2\u3002\u6b65\u9a5f1: \u9078\u64c7\u969c\u7919\u7269\u5bc6\u96c6\u5340\u57df\uff0c\u6b65\u9a5f2: \u5728\u5468\u570d\u653e\u7f6e\u70b8\u5f48\uff0c\u6b65\u9a5f3: \u5f15\u8a98\u6575\u4eba\u9032\u5165\u3002\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u76f4\u63a5\u653b\u64ca vs \u9677\u9631\u57cb\u4f0f\u3002\n3.  \u4fdd\u8b77\u81ea\u5df1\uff1a \u5229\u7528\u7246\u58c1\u4f5c\u70ba\u63a9\u8b77\uff0c\u8eb2\u907f\u6575\u4eba\u7684\u70b8\u5f48\u3002\u5728\u653e\u7f6e\u70b8\u5f48\u5f8c\uff0c\u8fc5\u901f\u79fb\u52d5\u5230\u7246\u58c1\u5f8c\u9762\uff0c\u53ef\u4ee5\u6709\u6548\u9632\u6b62\u88ab\u70b8\u5f48\u6ce2\u53ca\u3002\u719f\u7df4\u638c\u63e1\u5730\u5f62\u5229\u7528\u662f\u6210\u70baBomb-it-7\u9ad8\u624b\u7684\u95dc\u9375\uff01"}, {"question": "Bomb-it-7\u4e2d\u5982\u4f55\u6709\u6548\u8eb2\u907f\u6575\u4eba\u7684\u70b8\u5f48\uff1f\u6709\u54ea\u4e9b\u9032\u968e\u7684\u8eb2\u907f\u6280\u5de7\uff1f", "answer": "\u8eb2\u907f\u70b8\u5f48\u662fBomb-it-7\u751f\u5b58\u7684\u95dc\u9375\u3002\u4ee5\u4e0b\u662f\u4e00\u4e9b\u9032\u968e\u6280\u5de7\uff1a\n1.  \u9810\u5224\u8d70\u4f4d\uff1a \u89c0\u5bdf\u6575\u4eba\u7684\u884c\u52d5\u8ecc\u8de1\u548c\u70b8\u5f48\u7684\u653e\u7f6e\u4f4d\u7f6e\uff0c\u63d0\u524d\u9810\u5224\u7206\u70b8\u7bc4\u570d\uff0c\u4e26\u8fc5\u901f\u79fb\u52d5\u5230\u5b89\u5168\u5340\u57df\u3002\u4f8b\u5982\uff0c\u7576\u6575\u4eba\u5c07\u60a8\u903c\u5230\u89d2\u843d\u6642\uff0c\u8981\u7acb\u523b\u5c0b\u627e\u9003\u751f\u8def\u7dda\uff0c\u800c\u4e0d\u662f\u539f\u5730\u7b49\u5f85\u3002\n2.  \u5229\u7528\u9053\u5177\uff1a \u901f\u5ea6\u63d0\u5347\u9053\u5177\u53ef\u4ee5\u8b93\u60a8\u66f4\u5feb\u5730\u79fb\u52d5\uff0c\u66f4\u5bb9\u6613\u8eb2\u907f\u70b8\u5f48\u3002\u5408\u7406\u5229\u7528\u52a0\u901f\u9053\u5177\uff0c\u80fd\u5920\u5feb\u901f\u812b\u96e2\u5371\u96aa\u5340\u57df\u3002\n3.  \u8072\u6771\u64ca\u897f\uff1a \u5728\u4e00\u500b\u65b9\u5411\u653e\u7f6e\u70b8\u5f48\uff0c\u5438\u5f15\u6575\u4eba\u7684\u6ce8\u610f\u529b\uff0c\u7136\u5f8c\u8fc5\u901f\u5f9e\u53e6\u4e00\u500b\u65b9\u5411\u9003\u812b\u3002\u9019\u662f\u4e00\u7a2e\u5fc3\u7406\u6230\u8853\uff0c\u53ef\u4ee5\u8ff7\u60d1\u6575\u4eba\uff0c\u70ba\u60a8\u722d\u53d6\u6642\u9593\u3002\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u81ea\u5df1\u60f3\u50cf\u6210\u4e00\u96bb\u9748\u6d3b\u7684\u5154\u5b50\uff0c\u6642\u523b\u4fdd\u6301\u8b66\u60d5\uff0c\u4f3a\u6a5f\u800c\u52d5\u3002"}, {"question": "Bomb-it-7\u96d9\u4eba\u6a21\u5f0f\u4e0b\uff0c\u5982\u4f55\u8207\u968a\u53cb\u914d\u5408\u624d\u80fd\u53d6\u5f97\u52dd\u5229\uff1f\u5982\u4f55\u6709\u6548\u5408\u4f5c\uff1f", "answer": "\u5728Bomb-it-7\u96d9\u4eba\u6a21\u5f0f\u4e2d\uff0c\u9ed8\u5951\u7684\u914d\u5408\u662f\u5236\u52dd\u7684\u95dc\u9375\u3002\u4ee5\u4e0b\u662f\u4e00\u4e9b\u5efa\u8b70\uff1a\n1.  \u660e\u78ba\u5206\u5de5\uff1a \u5169\u500b\u73a9\u5bb6\u53ef\u4ee5\u5206\u5225\u8ca0\u8cac\u4e0d\u540c\u7684\u5340\u57df\uff0c\u6216\u8005\u4e00\u500b\u8ca0\u8cac\u653b\u64ca\uff0c\u4e00\u500b\u8ca0\u8cac\u9632\u5b88\u3002\u4f8b\u5982\uff0c\u4e00\u500b\u968a\u53cb\u8ca0\u8cac\u5f15\u8a98\u6575\u4eba\uff0c\u53e6\u4e00\u500b\u968a\u53cb\u8ca0\u8cac\u653e\u7f6e\u70b8\u5f48\u3002\n2.  \u4e92\u76f8\u63a9\u8b77\uff1a \u7576\u4e00\u500b\u968a\u53cb\u653e\u7f6e\u70b8\u5f48\u6642\uff0c\u53e6\u4e00\u500b\u968a\u53cb\u53ef\u4ee5\u63d0\u4f9b\u706b\u529b\u63a9\u8b77\uff0c\u9632\u6b62\u6575\u4eba\u9760\u8fd1\u3002\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u653b\u64ca\u578b vs \u9632\u79a6\u578b\u968a\u53cb\u7b56\u7565\u3002\n3.  \u5171\u4eab\u9053\u5177\uff1a \u53ca\u6642\u5411\u968a\u53cb\u5206\u4eab\u6709\u7528\u7684\u9053\u5177\uff0c\u4f8b\u5982\u901f\u5ea6\u63d0\u5347\u6216\u706b\u7130\u589e\u5f37\u3002\u5718\u968a\u5408\u4f5c\u624d\u80fd\u6700\u5927\u5316\u9053\u5177\u7684\u50f9\u503c\u3002\u8a18\u4f4f\uff0c\u5718\u968a\u5408\u4f5c\u662f\u96d9\u4eba\u6a21\u5f0f\u7684\u6838\u5fc3\uff01"}, {"question": "Bomb-it-7\u7684AI\u96e3\u5ea6\u662f\u5982\u4f55\u5f71\u97ff\u904a\u6232\u9ad4\u9a57\u7684\uff1f\u54ea\u4e9b\u56e0\u7d20\u5f71\u97ffAI\u96e3\u5ea6\u7b49\u7d1a\uff1f", "answer": "Bomb-it-7\u7684AI\u96e3\u5ea6\u76f4\u63a5\u5f71\u97ff\u904a\u6232\u9ad4\u9a57\u3002\u96e3\u5ea6\u8d8a\u9ad8\uff0cAI\u7684\u53cd\u61c9\u901f\u5ea6\u3001\u7b56\u7565\u9078\u64c7\u548c\u9053\u5177\u4f7f\u7528\u90fd\u6703\u66f4\u52a0\u7cbe\u660e\u3002\u9019\u610f\u5473\u8457\uff1a\n1.  \u66f4\u9ad8\u7684\u53cd\u61c9\u901f\u5ea6\uff1a AI\u6703\u66f4\u5feb\u5730\u8eb2\u907f\u60a8\u7684\u70b8\u5f48\uff0c\u8b93\u60a8\u66f4\u96e3\u64ca\u4e2d\u5b83\u5011\u3002\n2.  \u66f4\u667a\u80fd\u7684\u7b56\u7565\uff1a AI\u6703\u66f4\u61c2\u5f97\u5229\u7528\u5730\u5f62\u548c\u969c\u7919\u7269\uff0c\u88fd\u9020\u9677\u9631\uff0c\u6216\u8005\u5305\u6284\u60a8\u3002\u8209\u4f8b\uff1a\u9ad8\u96e3\u5ea6AI\u6703\u512a\u5148\u4f54\u64da\u5730\u5716\u7684\u6709\u5229\u4f4d\u7f6e\uff0c\u4f8b\u5982\u89d2\u843d\u6216\u901a\u9053\u53e3\u3002\n3.  \u66f4\u9ad8\u6548\u7684\u9053\u5177\u4f7f\u7528\uff1a AI\u6703\u66f4\u5408\u7406\u5730\u5229\u7528\u9053\u5177\uff0c\u4f8b\u5982\u5728\u95dc\u9375\u6642\u523b\u4f7f\u7528\u901f\u5ea6\u63d0\u5347\u4f86\u8eb2\u907f\u70b8\u5f48\uff0c\u6216\u8005\u4f7f\u7528\u706b\u7130\u589e\u5f37\u4f86\u64f4\u5927\u7206\u70b8\u7bc4\u570d\u3002\u7cfb\u7d71\u89e3\u6790\uff1a\u904a\u6232AI\u7684\u6c7a\u7b56\u6a39\u5206\u6790\u3002"}, {"question": "Bomb-it-7\u7684\u6578\u503c\u6a5f\u5236\u662f\u600e\u6a23\u7684\uff1f\u54ea\u4e9b\u5e95\u5c64\u6578\u5b78\u6c7a\u5b9a\u4e86\u904a\u6232\uff1f", "answer": "Bomb-it-7\u7684\u6578\u503c\u6a5f\u5236\u4e3b\u8981\u9ad4\u73fe\u5728\u4ee5\u4e0b\u5e7e\u500b\u65b9\u9762\uff1a\n1.  \u7206\u70b8\u7bc4\u570d\uff1a \u521d\u59cb\u70b8\u5f48\u7684\u7206\u70b8\u7bc4\u570d\u901a\u5e38\u662f1\u683c\uff0c\u900f\u904e\u62fe\u53d6\u706b\u7130\u589e\u5f37\u9053\u5177\u53ef\u4ee5\u589e\u52a0\u7206\u70b8\u7bc4\u570d\u3002\u7206\u70b8\u7bc4\u570d\u7684\u589e\u52a0\u662f\u7dda\u6027\u800c\u975e\u6307\u6578\u578b\u7684\u3002\u4f8b\u5982\uff0c\u7206\u70b8\u7bc4\u570d+1\uff0c\u5728\u5341\u5b57\u65b9\u5411\u6703\u591a\u51fa\u4e00\u500b\u683c\u5b50\u3002\n2.  \u79fb\u52d5\u901f\u5ea6\uff1a \u521d\u59cb\u79fb\u52d5\u901f\u5ea6\u662f\u56fa\u5b9a\u7684\uff0c\u900f\u904e\u62fe\u53d6\u901f\u5ea6\u63d0\u5347\u9053\u5177\u53ef\u4ee5\u52a0\u5feb\u79fb\u52d5\u901f\u5ea6\u3002\u6d41\u7a0b\u5716\u89e3\uff1a\u901f\u5ea6\u63d0\u5347\u9053\u5177 -> \u79fb\u52d5\u901f\u5ea6\u589e\u52a0 -> \u66f4\u5bb9\u6613\u8eb2\u907f/\u8ffd\u64ca\u6575\u4eba\u3002\n3.  \u70b8\u5f48\u6578\u91cf\uff1a \u521d\u59cb\u70b8\u5f48\u6578\u91cf\u662f1\u500b\uff0c\u900f\u904e\u62fe\u53d6\u70b8\u5f48\u6578\u91cf\u589e\u52a0\u9053\u5177\u53ef\u4ee5\u589e\u52a0\u540c\u6642\u653e\u7f6e\u7684\u70b8\u5f48\u6578\u91cf\u3002\u70b8\u5f48\u6578\u91cf\u4e0a\u9650\u4e00\u822c\u662f5\u500b\u5de6\u53f3\u3002\n4.  AI\u96e3\u5ea6\uff1a AI\u96e3\u5ea6\u8d8a\u9ad8\uff0c\u5176\u53cd\u61c9\u901f\u5ea6\uff08\u4f8b\u5982\u8eb2\u907f\u70b8\u5f48\u7684\u6642\u9593\uff09\u548c\u6c7a\u7b56\u983b\u7387\u6703\u986f\u8457\u63d0\u5347\u3002\u6578\u503c\u5206\u6790\uff1a\u4e0d\u540cAI\u96e3\u5ea6\u4e0b\u7684\u7d71\u8a08\u6578\u64da\u6bd4\u8f03\u3002"}, {"question": "Bomb-it-7\u662f\u5426\u652f\u63f4\u8de8\u5e73\u53f0\u904a\u6232\u6216\u6578\u64da\u9077\u79fb\uff1f\u80fd\u5426\u8f49\u79fb\u5132\u5b58\u6578\u64da\uff1f", "answer": "\u901a\u5e38\u4f86\u8aaa\uff0cBomb-it-7\u6b64\u985eFlash\u5c0f\u904a\u6232\u539f\u751f\u4e26\u4e0d\u652f\u63f4\u8de8\u5e73\u53f0\u904a\u6232\u6216\u6578\u64da\u9077\u79fb\u3002\u56e0\u70ba\u5b83\u5011\u7684\u6578\u64da\u901a\u5e38\u5132\u5b58\u5728\u672c\u5730\u700f\u89bd\u5668\u7684\u5feb\u53d6\u4e2d\uff0c\u800c\u975e\u96f2\u7aef\u4f3a\u670d\u5668\u3002\u6240\u4ee5\uff0c\u5982\u679c\u66f4\u63db\u8a2d\u5099\u6216\u700f\u89bd\u5668\uff0c\u4e4b\u524d\u7684\u904a\u6232\u9032\u5ea6\u53ef\u80fd\u6703\u907a\u5931\u3002\u4e0d\u904e\uff0c\u6709\u4e9bBomb-it-7\u7684\u91cd\u88fd\u7248\u6216\u79fb\u690d\u7248\u53ef\u80fd\u6703\u63d0\u4f9b\u96f2\u7aef\u5132\u5b58\u529f\u80fd\uff0c\u4f46\u9019\u53d6\u6c7a\u65bc\u5177\u9ad4\u7684\u904a\u6232\u7248\u672c\u548c\u5e73\u53f0\u3002"}, {"question": "Bomb-it-7\u662f\u5426\u5b58\u5728\u96b1\u85cf\u89d2\u8272\u6216\u95dc\u5361\uff1f\u5982\u4f55\u89f8\u767c\u5f69\u86cb\uff1f", "answer": "\u5728\u4e00\u4e9b\u7248\u672c\u7684Bomb-it-7\u4e2d\uff0c\u53ef\u80fd\u5b58\u5728\u4e00\u4e9b\u96b1\u85cf\u89d2\u8272\u6216\u95dc\u5361\u3002\u89f8\u767c\u65b9\u5f0f\u901a\u5e38\u6bd4\u8f03\u96b1\u853d\uff0c\u9700\u8981\u73a9\u5bb6\u9032\u884c\u4e00\u4e9b\u7279\u5b9a\u7684\u64cd\u4f5c\u6216\u9054\u6210\u67d0\u4e9b\u7279\u5b9a\u7684\u689d\u4ef6\u3002\u4f8b\u5982\uff1a\u5728\u67d0\u4e9b\u95dc\u5361\u4e2d\uff0c\u9023\u7e8c\u653e\u7f6e\u6307\u5b9a\u6578\u91cf\u7684\u70b8\u5f48\u800c\u4e0d\u5f15\u7206\uff0c\u53ef\u80fd\u6703\u89f8\u767c\u96b1\u85cf\u95dc\u5361\uff1b\u6216\u8005\u5728\u7279\u5b9a\u6a21\u5f0f\u4e0b\uff0c\u4f7f\u7528\u7279\u5b9a\u89d2\u8272\u8d0f\u5f97\u6bd4\u8cfd\uff0c\u53ef\u80fd\u6703\u89e3\u9396\u96b1\u85cf\u89d2\u8272\u3002\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u66b4\u529b\u7834\u89e3 vs \u7b56\u7565\u89e3\u9396\u96b1\u85cf\u8981\u7d20\u3002"}]
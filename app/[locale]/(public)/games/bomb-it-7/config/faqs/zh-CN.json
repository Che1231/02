[{"question": "\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u5feb\u901f\u638c\u63e1Bomb It 7\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u5f00\u59cb\u73a9Bomb It 7\uff0c\u8bf7\u5148\u719f\u6089\u57fa\u672c\u64cd\u4f5c\uff1a\u4f7f\u7528\u65b9\u5411\u952e\u6216WASD\u952e\u8fdb\u884c\u79fb\u52a8\uff0c\u7a7a\u683c\u952e\u653e\u7f6e\u70b8\u5f39\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u5173\uff0c\u4f60\u53ef\u4ee5\u7ec3\u4e60\u5728\u5730\u56fe\u4e0a\u79fb\u52a8\u5e76\u653e\u7f6e\u70b8\u5f39\u6765\u6467\u6bc1\u65b9\u5757\u3002\u6b64\u5916\uff0c\u5f3a\u70c8\u5efa\u8bae\u65b0\u624b\u73a9\u5bb6\u4f7f\u7528\u6559\u7a0b\u6a21\u5f0f\u6765\u4e86\u89e3\u6838\u5fc3\u673a\u5236\u3002"}, {"question": "Bomb It 7\u4e2d\u6709\u54ea\u4e9b\u5fc5\u5907\u7684\u9053\u5177\uff0c\u4ee5\u53ca\u5b83\u4eec\u5982\u4f55\u589e\u5f3a\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "Bomb It 7\u4e2d\u7684\u5fc5\u5907\u9053\u5177\u5305\u62ec\u70b8\u5f39\u5bb9\u91cf\uff0c\u53ef\u4ee5\u589e\u52a0\u540c\u65f6\u653e\u7f6e\u7684\u70b8\u5f39\u6570\u91cf\uff0c\u4ee5\u53ca\u706b\u7130\u80fd\u529b\uff0c\u53ef\u4ee5\u6269\u5c55\u7206\u70b8\u8303\u56f4\u3002\u4f8b\u5982\uff0c\u62fe\u53d6\u70b8\u5f39\u5bb9\u91cf\u9053\u5177\u540e\uff0c\u4f60\u4e00\u6b21\u53ef\u4ee5\u653e\u7f6e\u591a\u8fbe\u4e09\u679a\u70b8\u5f39\uff0c\u8fd9\u4f1a\u5728\u6e05\u9664\u969c\u788d\u7269\u548c\u51fb\u8d25\u654c\u4eba\u65f6\u7ed9\u4f60\u6218\u7565\u4f18\u52bf\u3002\u8fd9\u4e9b\u9053\u5177\u5bf9\u4e8e\u901a\u5173\u66f4\u5177\u6311\u6218\u6027\u7684\u5173\u5361\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u5728Bomb It 7\u4e2d\uff0c\u4e3a\u4ec0\u4e48\u653e\u7f6e\u70b8\u5f39\u7684\u65f6\u95f4\u5f88\u91cd\u8981\uff0c\u73a9\u5bb6\u5982\u4f55\u638c\u63e1\u65f6\u673a\uff1f", "answer": "\u5728Bomb It 7\u4e2d\uff0c\u65f6\u673a\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u70b8\u5f39\u5728\u7206\u70b8\u524d\u6709\u4e00\u4e2a\u5012\u8ba1\u65f6\u3002\u638c\u63e1\u65f6\u673a\u9700\u8981\u9884\u6d4b\u654c\u4eba\u7684\u79fb\u52a8\u548c\u70b8\u5f39\u7206\u70b8\u8303\u56f4\u3002\u4f8b\u5982\uff0c\u5728\u62e5\u6324\u7684\u533a\u57df\uff0c\u5728\u654c\u4eba\u63a5\u8fd1\u65f6\u653e\u7f6e\u70b8\u5f39\u53ef\u4ee5\u5c06\u5176\u56f0\u4f4f\u5e76\u6d88\u706d\u3002\u5728\u65e9\u671f\u5173\u5361\u7ec3\u4e60\uff0c\u611f\u53d7\u70b8\u5f39\u8ba1\u65f6\u5668\u548c\u7206\u70b8\u534a\u5f84\u3002"}, {"question": "\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u53ef\u4ee5\u5728Bomb It 7\u7684\u8054\u673a\u6a21\u5f0f\u4e2d\u4f7f\u7528\u54ea\u4e9b\u7b56\u7565\u6765\u5360\u636e\u4f18\u52bf\uff1f", "answer": "\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u4f7f\u7528\u9ad8\u7ea7\u7b56\u7565\uff0c\u5982\u70b8\u5f39\u8fde\u9501\u548c\u9053\u5177\u63a7\u5236\uff0c\u5728Bomb It 7\u7684\u8054\u673a\u6a21\u5f0f\u4e2d\u5360\u636e\u4f18\u52bf\u3002\u70b8\u5f39\u8fde\u9501\u662f\u6307\u4f9d\u6b21\u653e\u7f6e\u591a\u679a\u70b8\u5f39\uff0c\u4ee5\u521b\u9020\u66f4\u5927\u7684\u7206\u70b8\u6548\u679c\u3002\u4f8b\u5982\uff0c\u5148\u653e\u4e00\u9897\u70b8\u5f39\uff0c\u7b49\u5f85\u8ba1\u65f6\u5668\uff0c\u7136\u540e\u653e\u7f6e\u53e6\u4e00\u9897\u70b8\u5f39\u6765\u6269\u5927\u7206\u70b8\u8303\u56f4\u3002\u9053\u5177\u63a7\u5236\u610f\u5473\u7740\u5728\u6e38\u620f\u521d\u671f\u62a2\u593a\u5173\u952e\u9053\u5177\uff0c\u5982\u901f\u5ea6\u548c\u706b\u7130\u80fd\u529b\uff0c\u4ee5\u5728\u5bf9\u624b\u9762\u524d\u83b7\u5f97\u4f18\u52bf\u3002"}, {"question": "Bomb It 7\u7684\u6e38\u620f\u5f97\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u5927\u5316\u5f97\u5206\uff1f", "answer": "Bomb It 7\u7684\u6e38\u620f\u5f97\u5206\u7cfb\u7edf\u4f1a\u5956\u52b1\u73a9\u5bb6\u6467\u6bc1\u65b9\u5757\u3001\u51fb\u8d25\u654c\u4eba\u548c\u6536\u96c6\u9053\u5177\u3002\u6700\u5927\u5316\u5f97\u5206\u7684\u5173\u952e\u56e0\u7d20\u5305\u62ec\u5feb\u901f\u901a\u5173\u5173\u5361\u3001\u4f7f\u7528\u8fde\u9501\u7206\u70b8\u4ee5\u53ca\u4fdd\u6301\u9ad8\u751f\u547d\u503c\u3002\u4f8b\u5982\uff0c\u7528\u4e00\u679a\u70b8\u5f39\u7206\u70b8\u6467\u6bc1\u591a\u4e2a\u65b9\u5757\u4f1a\u83b7\u5f97\u8fde\u9501\u5f97\u5206\uff0c\u663e\u8457\u63d0\u5347\u4f60\u7684\u5206\u6570\u3002"}, {"question": "Bomb It 7\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u673a\u5236\u53ef\u4ee5\u5e2e\u52a9\u73a9\u5bb6\u5728\u7ade\u6280\u4e2d\u83b7\u5f97\u4f18\u52bf\uff1f", "answer": "Bomb It 7\u4e2d\u7684\u9690\u85cf\u673a\u5236\u5305\u62ec\u70b8\u5f39\u5806\u53e0\u548c\u5899\u58c1\u6280\u5de7\u3002\u70b8\u5f39\u5806\u53e0\u5141\u8bb8\u73a9\u5bb6\u5c06\u70b8\u5f39\u53e0\u653e\u5728\u4e00\u8d77\uff0c\u4ece\u800c\u4ea7\u751f\u66f4\u96c6\u4e2d\u7684\u7206\u70b8\u3002\u5899\u58c1\u6280\u5de7\u6709\u65f6\u80fd\u8ba9\u73a9\u5bb6\u7a7f\u5899\u800c\u8fc7\uff0c\u5e26\u6765\u6218\u672f\u4e0a\u7684\u4f18\u52bf\u3002\u8fd9\u4e9b\u673a\u5236\u5e76\u6ca1\u6709\u660e\u786e\u8bb2\u89e3\uff0c\u4f46\u53ef\u4ee5\u901a\u8fc7\u5b9e\u9a8c\u548c\u7ec3\u4e60\u6765\u53d1\u73b0\u3002"}, {"question": "Bomb It 7\u4e2d\u7684\u5173\u5361\u8bbe\u8ba1\u5982\u4f55\u5f71\u54cd\u73a9\u5bb6\u7684\u7b56\u7565\u548c\u51b3\u7b56\uff1f", "answer": "Bomb It 7\u4e2d\u7684\u5173\u5361\u8bbe\u8ba1\u901a\u8fc7\u6539\u53d8\u65b9\u5757\u3001\u654c\u4eba\u548c\u9053\u5177\u7684\u5e03\u5c40\u6765\u5f71\u54cd\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u72ed\u7a84\u8d70\u5eca\u7684\u5173\u5361\u9700\u8981\u7cbe\u786e\u7684\u70b8\u5f39\u653e\u7f6e\uff0c\u800c\u5f00\u9614\u533a\u57df\u5219\u5141\u8bb8\u66f4\u5927\u7684\u6218\u7565\u79fb\u52a8\u3002\u73a9\u5bb6\u5fc5\u987b\u6839\u636e\u5173\u5361\u7684\u8bbe\u8ba1\u8c03\u6574\u4ed6\u4eec\u7684\u7b56\u7565\uff0c\u4f8b\u5982\u4f18\u5148\u8003\u8651\u67d0\u4e9b\u9053\u5177\u6216\u4e13\u6ce8\u4e8e\u6d88\u706d\u654c\u4eba\u3002"}, {"question": "\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e0a\u8fd0\u884cBomb It 7\u9700\u8981\u54ea\u4e9b\u6280\u672f\u8981\u6c42\uff0c\u4ee5\u53ca\u6027\u80fd\u4f1a\u6709\u54ea\u4e9b\u5dee\u5f02\uff1f", "answer": "Bomb It 7\u7684\u6280\u672f\u8981\u6c42\u9002\u4e2d\uff0c\u53ef\u4ee5\u5728\u5927\u591a\u6570\u73b0\u4ee3\u8bbe\u5907\u4e0a\u987a\u5229\u8fd0\u884c\u3002\u5728PC\u4e0a\uff0c\u5efa\u8bae\u81f3\u5c112GB\u5185\u5b58\u548c\u53cc\u6838\u5904\u7406\u5668\u3002\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\uff0c\u81f3\u5c11\u9700\u89811GB\u5185\u5b58\u4ee5\u53caAndroid 5.0\u6216iOS 9.0\u3002\u6027\u80fd\u5dee\u5f02\u5f88\u5c0f\uff0cPC\u63d0\u4f9b\u66f4\u9ad8\u7684\u5e27\u7387\uff0c\u79fb\u52a8\u8bbe\u5907\u5219\u63d0\u4f9b\u4fbf\u6377\u6027\u3002\u8de8\u5e73\u53f0\u6e38\u620f\u652f\u6301\uff0c\u5141\u8bb8\u65e0\u7f1d\u7684\u8054\u673a\u4f53\u9a8c\u3002"}, {"question": "\u73a9\u5bb6\u53ef\u4ee5\u5728Bomb It 7\u4e2d\u89e3\u9501\u54ea\u4e9b\u79d8\u5bc6\u5173\u5361\u6216\u9690\u85cf\u5185\u5bb9\uff0c\u4ee5\u53ca\u9700\u8981\u54ea\u4e9b\u6761\u4ef6\uff1f", "answer": "Bomb It 7\u4e2d\u7684\u79d8\u5bc6\u5173\u5361\u53ef\u4ee5\u901a\u8fc7\u5b8c\u6210\u7279\u5b9a\u91cc\u7a0b\u7891\u6765\u89e3\u9501\uff0c\u4f8b\u5982\u4ee5\u5b8c\u7f8e\u6210\u7ee9\u5b8c\u6210\u6240\u6709\u5173\u5361\uff0c\u6216\u5728\u67d0\u4e9b\u5173\u5361\u4e2d\u627e\u5230\u9690\u85cf\u94a5\u5319\u3002\u4f8b\u5982\uff0c\u5728\u7b2c5\u5173\u627e\u5230\u9690\u85cf\u94a5\u5319\u53ef\u4ee5\u89e3\u9501\u4e00\u4e2a\u5177\u6709\u72ec\u7279\u6311\u6218\u548c\u5956\u52b1\u7684\u989d\u5916\u5173\u5361\u3002\u63a2\u7d22\u5730\u56fe\u7684\u6bcf\u4e00\u4e2a\u89d2\u843d\u5e76\u5c1d\u8bd5\u4e0d\u540c\u7684\u7b56\u7565\u53ef\u4ee5\u5e2e\u52a9\u53d1\u73b0\u8fd9\u4e9b\u9690\u85cf\u7684\u5b9d\u85cf\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728Bomb It 7\u4e2d\u6709\u6548\u5730\u7ba1\u7406\u70b8\u5f39\u5e93\u5b58\uff0c\u907f\u514d\u88ab\u56f0\u4f4f\uff1f", "answer": "\u5728Bomb It 7\u4e2d\u6709\u6548\u5730\u7ba1\u7406\u70b8\u5f39\u5e93\u5b58\u9700\u8981\u7b56\u7565\u6027\u7684\u653e\u7f6e\u548c\u65f6\u673a\u3002\u6b65\u9aa4\u4e00\uff1a\u59cb\u7ec8\u4fdd\u7559\u4e00\u679a\u70b8\u5f39\u4f5c\u4e3a\u9003\u751f\u8def\u7ebf\u3002\u6b65\u9aa4\u4e8c\uff1a\u5c06\u70b8\u5f39\u653e\u7f6e\u5728\u6700\u5927\u5316\u7834\u574f\u4f46\u4e0d\u4f1a\u963b\u788d\u4f60\u8def\u5f84\u7684\u533a\u57df\u3002\u6b65\u9aa4\u4e09\uff1a\u4f7f\u7528\u901f\u5ea6\u7c7b\u9053\u5177\u8fc5\u901f\u8fdc\u79bb\u7206\u70b8\u3002\u4f8b\u5982\uff0c\u5728\u72ed\u7a84\u7684\u7a7a\u95f4\uff0c\u5148\u653e\u7f6e\u70b8\u5f39\uff0c\u7136\u540e\u7acb\u5373\u79fb\u52a8\u5230\u5b89\u5168\u533a\u57df\uff0c\u4ee5\u907f\u514d\u88ab\u56f0\u4f4f\u3002"}]
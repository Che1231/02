[{"question": "\u30dc\u30f3\u30d6\u30a4\u30c3\u30c87\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3067\u3001\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u3059\u3050\u306b\u59cb\u3081\u3089\u308c\u308b\u65b9\u6cd5\u306f\uff1f", "answer": "\u30dc\u30f3\u30d6\u30a4\u30c3\u30c87\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u306b\u6163\u308c\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u79fb\u52d5\u306b\u306f\u77e2\u5370\u30ad\u30fc\u307e\u305f\u306fWASD\u30ad\u30fc\u3092\u4f7f\u7528\u3057\u3001\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u3067\u7206\u5f3e\u3092\u914d\u7f6e\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30de\u30c3\u30d7\u3092\u79fb\u52d5\u3057\u3066\u7206\u5f3e\u3092\u914d\u7f6e\u3057\u3066\u30d6\u30ed\u30c3\u30af\u3092\u7834\u58ca\u3059\u308b\u7df4\u7fd2\u304c\u3067\u304d\u307e\u3059\u3002\u307e\u305f\u3001\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30e2\u30fc\u30c9\u306f\u3001\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30b3\u30a2\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u305f\u3081\u306b\u5f37\u304f\u304a\u52e7\u3081\u3057\u307e\u3059\u3002"}, {"question": "\u30dc\u30f3\u30d6\u30a4\u30c3\u30c87\u3067\u91cd\u8981\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u4f55\u3067\u3042\u308a\u3001\u3069\u306e\u3088\u3046\u306b\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5f37\u5316\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30dc\u30f3\u30d6\u30a4\u30c3\u30c87\u3067\u91cd\u8981\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306b\u306f\u3001\u540c\u6642\u306b\u914d\u7f6e\u3067\u304d\u308b\u7206\u5f3e\u306e\u6570\u3092\u5897\u3084\u3059\u7206\u5f3e\u5bb9\u91cf\u3068\u3001\u7206\u767a\u7bc4\u56f2\u3092\u5e83\u3052\u308b\u708e\u529b\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u7206\u5f3e\u5bb9\u91cf\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u62fe\u3046\u3068\u3001\u4e00\u5ea6\u306b\u6700\u59273\u500b\u306e\u7206\u5f3e\u3092\u914d\u7f6e\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u3001\u969c\u5bb3\u7269\u3092\u30af\u30ea\u30a2\u3057\u6575\u3092\u5012\u3059\u4e0a\u3067\u6226\u7565\u7684\u306a\u512a\u4f4d\u6027\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u3001\u3088\u308a\u96e3\u3057\u3044\u30ec\u30d9\u30eb\u3092\u9032\u3081\u308b\u305f\u3081\u306b\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002"}, {"question": "\u30dc\u30f3\u30d6\u30a4\u30c3\u30c87\u3067\u7206\u5f3e\u3092\u914d\u7f6e\u3059\u308b\u969b\u306b\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u3088\u3046\u306b\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u30de\u30b9\u30bf\u30fc\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30dc\u30f3\u30d6\u30a4\u30c3\u30c87\u3067\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u306a\u306e\u306f\u3001\u7206\u5f3e\u306b\u306f\u7206\u767a\u3059\u308b\u307e\u3067\u306e\u30ab\u30a6\u30f3\u30c8\u30c0\u30a6\u30f3\u304c\u3042\u308b\u304b\u3089\u3067\u3059\u3002\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u6575\u306e\u52d5\u304d\u3068\u7206\u5f3e\u7206\u767a\u7bc4\u56f2\u3092\u4e88\u6e2c\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6df7\u96d1\u3057\u305f\u30a8\u30ea\u30a2\u3067\u306f\u3001\u6575\u304c\u8fd1\u3065\u3044\u3066\u3044\u308b\u3068\u304d\u306b\u7206\u5f3e\u3092\u914d\u7f6e\u3059\u308b\u3053\u3068\u3067\u3001\u6575\u3092\u8ffd\u3044\u8a70\u3081\u3066\u6392\u9664\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u521d\u671f\u30ec\u30d9\u30eb\u3067\u7df4\u7fd2\u3057\u3066\u3001\u7206\u5f3e\u30bf\u30a4\u30de\u30fc\u3068\u7206\u767a\u534a\u5f84\u3092\u628a\u63e1\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u7d4c\u9a13\u8c4a\u5bcc\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30dc\u30f3\u30d6\u30a4\u30c3\u30c87\u306e\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3067\u512a\u4f4d\u306b\u7acb\u3064\u305f\u3081\u306b\u3069\u306e\u3088\u3046\u306a\u6226\u7565\u3092\u4f7f\u7528\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u7d4c\u9a13\u8c4a\u5bcc\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30dc\u30f3\u30d6\u30a4\u30c3\u30c87\u306e\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3067\u3001\u7206\u5f3e\u9023\u9396\u3068\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u5236\u5fa1\u306a\u3069\u306e\u9ad8\u5ea6\u306a\u6226\u7565\u3092\u4f7f\u7528\u3057\u3066\u512a\u4f4d\u306b\u7acb\u3064\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u7206\u5f3e\u9023\u9396\u3068\u306f\u3001\u3088\u308a\u5927\u304d\u306a\u7206\u767a\u3092\u5f15\u304d\u8d77\u3053\u3059\u305f\u3081\u306b\u8907\u6570\u306e\u7206\u5f3e\u3092\u9023\u7d9a\u3057\u3066\u914d\u7f6e\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u4f8b\u3048\u3070\u30011\u500b\u306e\u7206\u5f3e\u3092\u914d\u7f6e\u3057\u3001\u30bf\u30a4\u30de\u30fc\u304c\u5207\u308c\u308b\u306e\u3092\u5f85\u3063\u3066\u304b\u3089\u3082\u30461\u500b\u3092\u914d\u7f6e\u3057\u3066\u7206\u767a\u7bc4\u56f2\u3092\u5e83\u3052\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u5236\u5fa1\u3068\u306f\u3001\u30b9\u30d4\u30fc\u30c9\u3084\u708e\u529b\u306a\u3069\u3001\u30b2\u30fc\u30e0\u5e8f\u76e4\u306b\u91cd\u8981\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u7372\u5f97\u3057\u3066\u3001\u5bfe\u6226\u76f8\u624b\u3088\u308a\u6709\u5229\u306b\u306a\u308b\u3053\u3068\u3067\u3059\u3002"}, {"question": "\u30dc\u30f3\u30d6\u30a4\u30c3\u30c87\u306e\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u3069\u306e\u3088\u3046\u306b\u30dd\u30a4\u30f3\u30c8\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30dc\u30f3\u30d6\u30a4\u30c3\u30c87\u306e\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30d6\u30ed\u30c3\u30af\u3092\u7834\u58ca\u3057\u3001\u6575\u3092\u5012\u3057\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u96c6\u3081\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u5831\u916c\u3092\u4e0e\u3048\u307e\u3059\u3002\u30dd\u30a4\u30f3\u30c8\u3092\u6700\u5927\u5316\u3059\u308b\u305f\u3081\u306e\u91cd\u8981\u306a\u8981\u7d20\u306b\u306f\u3001\u30ec\u30d9\u30eb\u3092\u8fc5\u901f\u306b\u30af\u30ea\u30a2\u3057\u3001\u30b3\u30f3\u30dc\u7206\u767a\u3092\u4f7f\u7528\u3057\u3001\u9ad8\u3044\u4f53\u529b\u30ec\u30d9\u30eb\u3092\u7dad\u6301\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u4f8b\u3048\u3070\u30011\u3064\u306e\u7206\u5f3e\u7206\u767a\u3067\u8907\u6570\u306e\u30d6\u30ed\u30c3\u30af\u3092\u7834\u58ca\u3059\u308b\u3068\u3001\u30b3\u30f3\u30dc\u30dd\u30a4\u30f3\u30c8\u304c\u7372\u5f97\u3055\u308c\u3001\u30b9\u30b3\u30a2\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002"}, {"question": "\u30dc\u30f3\u30d6\u30a4\u30c3\u30c87\u3067\u3001\u7af6\u5408\u30d7\u30ec\u30a4\u3067\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u6709\u5229\u306a\u96a0\u3055\u308c\u305f\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30dc\u30f3\u30d6\u30a4\u30c3\u30c87\u306e\u96a0\u3055\u308c\u305f\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u306f\u3001\u7206\u5f3e\u7a4d\u307f\u91cd\u306d\u3068\u58c1\u306e\u4e0d\u6b63\u5229\u7528\u304c\u3042\u308a\u307e\u3059\u3002\u7206\u5f3e\u7a4d\u307f\u91cd\u306d\u306b\u3088\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u7206\u5f3e\u3092\u7a4d\u307f\u91cd\u306d\u3066\u3088\u308a\u96c6\u4e2d\u3057\u305f\u7206\u767a\u3092\u5f15\u304d\u8d77\u3053\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u58c1\u306e\u4e0d\u6b63\u5229\u7528\u306b\u3088\u3063\u3066\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u7279\u5b9a\u306e\u58c1\u3092\u901a\u904e\u3067\u304d\u308b\u5834\u5408\u304c\u3042\u308a\u3001\u6226\u8853\u7684\u306a\u512a\u4f4d\u6027\u3092\u3082\u305f\u3089\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u660e\u793a\u7684\u306b\u6559\u3048\u3089\u308c\u3066\u3044\u307e\u305b\u3093\u304c\u3001\u5b9f\u9a13\u3068\u7df4\u7fd2\u306b\u3088\u3063\u3066\u767a\u898b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30dc\u30f3\u30d6\u30a4\u30c3\u30c87\u306e\u30ec\u30d9\u30eb\u30c7\u30b6\u30a4\u30f3\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u6226\u7565\u3068\u610f\u601d\u6c7a\u5b9a\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30dc\u30f3\u30d6\u30a4\u30c3\u30c87\u306e\u30ec\u30d9\u30eb\u30c7\u30b6\u30a4\u30f3\u306f\u3001\u30d6\u30ed\u30c3\u30af\u3001\u6575\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306e\u914d\u7f6e\u65b9\u6cd5\u3092\u5909\u3048\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u6226\u7565\u306b\u5f71\u97ff\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u72ed\u3044\u901a\u8def\u3092\u6301\u3064\u30ec\u30d9\u30eb\u3067\u306f\u6b63\u78ba\u306a\u7206\u5f3e\u914d\u7f6e\u304c\u5fc5\u8981\u3068\u3055\u308c\u308b\u4e00\u65b9\u3067\u3001\u958b\u653e\u7684\u306a\u30a8\u30ea\u30a2\u3067\u306f\u3088\u308a\u6226\u7565\u7684\u306a\u79fb\u52d5\u304c\u53ef\u80fd\u306b\u306a\u308a\u307e\u3059\u3002\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u7279\u5b9a\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u512a\u5148\u3057\u305f\u308a\u3001\u6575\u306e\u6392\u9664\u306b\u7126\u70b9\u3092\u5f53\u3066\u305f\u308a\u306a\u3069\u3001\u30ec\u30d9\u30eb\u306e\u30c7\u30b6\u30a4\u30f3\u306b\u57fa\u3065\u3044\u3066\u30a2\u30d7\u30ed\u30fc\u30c1\u3092\u9069\u5fdc\u3055\u305b\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30dc\u30f3\u30d6\u30a4\u30c3\u30c87\u3092\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u5b9f\u884c\u3059\u308b\u305f\u3081\u306e\u6280\u8853\u7684\u306a\u8981\u4ef6\u306f\u4f55\u3067\u3042\u308a\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306f\u3069\u306e\u3088\u3046\u306b\u7570\u306a\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30dc\u30f3\u30d6\u30a4\u30c3\u30c87\u306f\u3001\u6700\u65b0\u306e\u30c7\u30d0\u30a4\u30b9\u306e\u307b\u3068\u3093\u3069\u3067\u30b9\u30e0\u30fc\u30ba\u306b\u52d5\u4f5c\u3059\u308b\u3001\u4e2d\u7a0b\u5ea6\u306e\u6280\u8853\u8981\u4ef6\u304c\u3042\u308a\u307e\u3059\u3002PC\u3067\u306f\u3001\u6700\u5c0f2GB\u306eRAM\u3068\u30c7\u30e5\u30a2\u30eb\u30b3\u30a2\u30d7\u30ed\u30bb\u30c3\u30b5\u304c\u63a8\u5968\u3055\u308c\u307e\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u3067\u306f\u3001\u5c11\u306a\u304f\u3068\u30821GB\u306eRAM\u3068Android 5.0\u307e\u305f\u306fiOS 9.0\u304c\u5fc5\u8981\u3067\u3059\u3002\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306f\u308f\u305a\u304b\u306b\u7570\u306a\u308a\u307e\u3059\u3002PC\u306f\u9ad8\u3044\u30d5\u30ec\u30fc\u30e0\u30ec\u30fc\u30c8\u3092\u63d0\u4f9b\u3057\u3001\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u306f\u643a\u5e2f\u6027\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u5bfe\u5fdc\u3057\u3066\u304a\u308a\u3001\u30b7\u30fc\u30e0\u30ec\u30b9\u306a\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u4f53\u9a13\u304c\u53ef\u80fd\u3067\u3059\u3002"}, {"question": "\u30dc\u30f3\u30d6\u30a4\u30c3\u30c87\u3067\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u3088\u3046\u306a\u79d8\u5bc6\u30ec\u30d9\u30eb\u307e\u305f\u306f\u96a0\u3057\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u3001\u3069\u306e\u3088\u3046\u306a\u8981\u4ef6\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30dc\u30f3\u30d6\u30a4\u30c3\u30c87\u306e\u79d8\u5bc6\u30ec\u30d9\u30eb\u306f\u3001\u3059\u3079\u3066\u306e\u30ec\u30d9\u30eb\u3092\u30d1\u30fc\u30d5\u30a7\u30af\u30c8\u30b9\u30b3\u30a2\u3067\u30af\u30ea\u30a2\u3057\u305f\u308a\u3001\u7279\u5b9a\u306e\u30b9\u30c6\u30fc\u30b8\u306b\u3042\u308b\u96a0\u3057\u30ad\u30fc\u3092\u898b\u3064\u3051\u308b\u306a\u3069\u3001\u7279\u5b9a\u306e\u76ee\u6a19\u3092\u9054\u6210\u3059\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb5\u306e\u96a0\u3057\u30ad\u30fc\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u3067\u3001\u30e6\u30cb\u30fc\u30af\u306a\u30c1\u30e3\u30ec\u30f3\u30b8\u3068\u5831\u916c\u306e\u3042\u308b\u30dc\u30fc\u30ca\u30b9\u30ec\u30d9\u30eb\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u30de\u30c3\u30d7\u306e\u9685\u3005\u3092\u63a2\u691c\u3057\u3001\u3055\u307e\u3056\u307e\u306a\u6226\u7565\u3092\u8a66\u3059\u3053\u3068\u3067\u3001\u3053\u308c\u3089\u306e\u96a0\u3057\u8981\u7d20\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30dc\u30f3\u30d6\u30a4\u30c3\u30c87\u3067\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u9589\u3058\u8fbc\u3081\u3089\u308c\u308b\u306e\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u3001\u7206\u5f3e\u306e\u5728\u5eab\u3092\u52b9\u679c\u7684\u306b\u3069\u306e\u3088\u3046\u306b\u7ba1\u7406\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30dc\u30f3\u30d6\u30a4\u30c3\u30c87\u3067\u7206\u5f3e\u306e\u5728\u5eab\u3092\u52b9\u679c\u7684\u306b\u7ba1\u7406\u3059\u308b\u306b\u306f\u3001\u6226\u7565\u7684\u306a\u914d\u7f6e\u3068\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5e38\u306b\u8131\u51fa\u30eb\u30fc\u30c8\u3092\u4f5c\u6210\u3059\u308b\u305f\u3081\u306b\u4e88\u5099\u306e\u7206\u5f3e\u30921\u500b\u4fdd\u6301\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u7206\u5f3e\u3092\u3001\u81ea\u5206\u306e\u901a\u8def\u3092\u585e\u304c\u306a\u3044\u3067\u30c0\u30e1\u30fc\u30b8\u3092\u6700\u5927\u5316\u3067\u304d\u308b\u5834\u6240\u306b\u914d\u7f6e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b9\u30d4\u30fc\u30c9\u306e\u3088\u3046\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u3063\u3066\u7206\u767a\u304b\u3089\u8fc5\u901f\u306b\u79fb\u52d5\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u72ed\u3044\u30b9\u30da\u30fc\u30b9\u3067\u306f\u7206\u5f3e\u3092\u914d\u7f6e\u3057\u3001\u3059\u3050\u306b\u5b89\u5168\u306a\u5834\u6240\u3078\u79fb\u52d5\u3057\u3066\u9589\u3058\u8fbc\u3081\u3089\u308c\u306a\u3044\u3088\u3046\u306b\u3057\u307e\u3059\u3002"}]
[{"question": "Bomb-it-7\u306f\u3069\u306e\u3088\u3046\u306b\u30b2\u30fc\u30e0\u3092\u59cb\u3081\u307e\u3059\u304b\uff1f \u65b0\u898f\u30e6\u30fc\u30b6\u30fc\u5411\u3051\u8fc5\u901f\u306a\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\uff1a\u958b\u59cb\u3059\u308b\u30ad\u30fc\u3068\u30e1\u30cb\u30e5\u30fc\u306e\u79fb\u52d5\u65b9\u6cd5\u3092\u6559\u3048\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "Bomb-it-7\u306e\u958b\u59cb\u306f\u7c21\u5358\u3067\u3059\uff01\u30b2\u30fc\u30e0\u306e\u8aad\u307f\u8fbc\u307f\u304c\u5b8c\u4e86\u3057\u305f\u3089\u3001\u30e1\u30a4\u30f3\u30e1\u30cb\u30e5\u30fc\u3067\u65b9\u5411\u30ad\u30fc\u3092\u4f7f\u3063\u3066\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\uff08\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u3001\u30c0\u30d6\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u306a\u3069\uff09\u3092\u9078\u629e\u3057\u3001Enter\u30ad\u30fc\u3092\u62bc\u3057\u3066\u78ba\u5b9a\u3057\u307e\u3059\u3002\u30c0\u30d6\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u5834\u5408\u3001P1\u306fWASD\u3067\u79fb\u52d5\u3057\u3001J\u30ad\u30fc\u3067\u7206\u5f3e\u3092\u914d\u7f6e\u3057\u307e\u3059\u3002P2\u306f\u65b9\u5411\u30ad\u30fc\u3067\u79fb\u52d5\u3057\u3001Enter\u30ad\u30fc\u3067\u7206\u5f3e\u3092\u914d\u7f6e\u3057\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306e\u76ee\u6a19\u306f\u3001\u3059\u3079\u3066\u306e\u6575\u3092\u7834\u58ca\u3059\u308b\u304b\u3001\u307e\u305f\u306f\u6307\u5b9a\u3055\u308c\u305f\u6761\u4ef6\u3092\u6e80\u305f\u3059\u3053\u3068\u3067\u3059\uff01\u4f8b\u3048\u8a71\uff1a\u521d\u5fc3\u8005\u306e\u6bb5\u968e\u3067\u306f\u3001\u3042\u306a\u305f\u306f\u7206\u5f3e\u51e6\u7406\u73ed\u54e1\u3060\u3068\u8003\u3048\u3066\u3001\u51b7\u9759\u306b\u5224\u65ad\u3057\u3001\u4e00\u6b69\u305a\u3064\u9032\u307f\u307e\u3057\u3087\u3046\u3002\u521d\u5fc3\u8005\u306e\u65b9\u306b\u306f\u3001\u7c21\u5358\u306a\u96e3\u6613\u5ea6\u3092\u9078\u629e\u3059\u308b\u3053\u3068\u3092\u304a\u52e7\u3081\u3057\u307e\u3059\u3002\u64cd\u4f5c\u3084\u30b2\u30fc\u30e0\u30eb\u30fc\u30eb\u306b\u6163\u308c\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "Bomb-it-7\u306b\u306f\u3069\u306e\u3088\u3046\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u304c\u3042\u308a\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f\u3069\u306e\u3088\u3046\u306a\u30a2\u30a4\u30c6\u30e0\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "Bomb-it-7\u306b\u306f\u62fe\u3046\u3068\u3059\u3050\u306b\u52b9\u679c\u3092\u767a\u63ee\u3059\u308b\u3001\u9762\u767d\u3044\u30a2\u30a4\u30c6\u30e0\u304c\u305f\u304f\u3055\u3093\u3042\u308a\u307e\u3059\u3002\n1. \u708e\u4e0a\u5f37\u5316\uff1a\u7206\u5f3e\u306e\u7206\u767a\u7bc4\u56f2\u3092\u5897\u3084\u3057\u3001\u6575\u3092\u3088\u308a\u7c21\u5358\u306b\u7834\u58ca\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u521d\u671f\u306e\u7206\u5f3e\u306e\u7bc4\u56f2\u306f1\u30de\u30b9\u3067\u3059\u304c\u3001\u708e\u4e0a\u5f37\u5316\u3092\u62fe\u3046\u3053\u3068\u30672\u30de\u30b9\u3001\u5834\u5408\u306b\u3088\u3063\u3066\u306f\u5168\u753b\u9762\u306b\u3082\u62e1\u5927\u3055\u308c\u307e\u3059\u3002\n2. \u7206\u5f3e\u6570\u5897\u52a0\uff1a\u3088\u308a\u591a\u304f\u306e\u7206\u5f3e\u3092\u4e00\u5ea6\u306b\u914d\u7f6e\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u3001\u3088\u308a\u5bc6\u96c6\u3057\u305f\u7206\u6483\u533a\u57df\u3092\u4f5c\u6210\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u521d\u671f\u72b6\u614b\u3067\u306f1\u500b\u3057\u304b\u7206\u5f3e\u3092\u7f6e\u3051\u307e\u305b\u3093\u3067\u3057\u305f\u304c\u3001\u62fe\u3046\u3053\u3068\u30672\u500b\u307e\u305f\u306f3\u500b\u540c\u6642\u306b\u914d\u7f6e\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002\n3. \u30b9\u30d4\u30fc\u30c9\u5f37\u5316\uff1a\u79fb\u52d5\u901f\u5ea6\u304c\u4e0a\u304c\u308a\u3001\u6575\u306e\u653b\u6483\u3092\u3088\u308a\u7d20\u65e9\u304f\u56de\u907f\u3057\u305f\u308a\u3001\u6575\u3092\u3088\u308a\u65e9\u304f\u8ffd\u6483\u3057\u305f\u308a\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30d4\u30fc\u30c9\u5f37\u5316\u306e\u52b9\u679c\u306f\u3001\u753b\u9762\u306e\u4e0b\u90e8\u306b\u901a\u5e38\u8868\u793a\u3055\u308c\u307e\u3059\u3002\n4. \u58c1\u8cab\u901a\uff1a\u58c1\u3092\u901a\u308a\u629c\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u6575\u306e\u80cc\u5f8c\u304b\u3089\u5947\u8972\u3059\u308b\u306e\u306b\u4fbf\u5229\u3067\u3059\u3002\u30a2\u30a4\u30c6\u30e0\u3092\u52b9\u679c\u7684\u306b\u4f7f\u3046\u3053\u3068\u306f\u3001\u52dd\u5229\u3078\u306e\u9375\u3068\u306a\u308b\u306e\u3067\u3001\u899a\u3048\u3066\u304a\u3044\u3066\u304f\u3060\u3055\u3044\uff01\u5f37\u5316\u9805\u76ee\uff1a\u3059\u3079\u3066\u306e\u30a2\u30a4\u30c6\u30e0\u3068\u305d\u306e\u6a5f\u80fd\u3092\u30ea\u30b9\u30c8\u3059\u308b\u5bfe\u7167\u8868\u3002"}, {"question": "Bomb-it-7\u306e\u7206\u5f3e\u3092\u624b\u52d5\u3067\u7206\u767a\u3055\u305b\u308b\u65b9\u6cd5\u306f\uff1f", "answer": "Bomb-it-7\u3067\u306f\u3001\u7206\u5f3e\u306f\u901a\u5e38\u3001\u914d\u7f6e\u5f8c\u4e00\u5b9a\u6642\u9593\u5f8c\u306b\u81ea\u52d5\u7684\u306b\u7206\u767a\u3057\u307e\u3059\u3002\u7206\u5f3e\u3092\u624b\u52d5\u3067\u7206\u767a\u3055\u305b\u308b\u3053\u3068\u306f\u3067\u304d\u307e\u305b\u3093\u3002\u305f\u3060\u3057\u3001\u7206\u767a\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u9593\u63a5\u7684\u306b\u5236\u5fa1\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n1. \u9023\u7d9a\u914d\u7f6e\uff1a\u7206\u5f3e\u306e\u914d\u7f6e\u6570\u306b\u306f\u5236\u9650\u304c\u3042\u308a\u3001\u4e0a\u9650\u306b\u9054\u3059\u308b\u3068\u3001\u65b0\u3057\u304f\u914d\u7f6e\u3057\u305f\u7206\u5f3e\u304c\u6700\u3082\u53e4\u3044\u7206\u5f3e\u3092\u7f6e\u304d\u63db\u3048\u3066\u7206\u767a\u3057\u307e\u3059\u3002\n2. \u30a2\u30a4\u30c6\u30e0\u5229\u7528\uff1a\u4e00\u90e8\u306e\u30a2\u30a4\u30c6\u30e0\u306f\u7206\u5f3e\u306e\u7206\u767a\u6642\u9593\u3084\u65b9\u6cd5\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u30b2\u30fc\u30e0\u5185\u306e\u30e1\u30c3\u30bb\u30fc\u30b8\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u7206\u5f3e\u914d\u7f6e->\u3057\u3070\u3089\u304f\u5f85\u3064->\u7206\u5f3e\u7206\u767a"}, {"question": "Bomb-it-7\u3067\u3001\u5730\u5f62\u3084\u969c\u5bb3\u7269\u3092\u52b9\u679c\u7684\u306b\u6d3b\u7528\u3057\u3066\u512a\u4f4d\u306b\u7acb\u3064\u65b9\u6cd5\u306f\uff1f\u30de\u30c3\u30d7\u8a8d\u8b58\u306f\u306a\u305c\u91cd\u8981\u306a\u306e\u3067\u3059\u304b\uff1f", "answer": "Bomb-it-7\u3067\u306f\u3001\u5730\u5f62\u3084\u969c\u5bb3\u7269\u306f\u91cd\u8981\u306a\u6226\u7565\u7684\u30ea\u30bd\u30fc\u30b9\u3067\u3059\u3002\u305d\u308c\u3089\u3092\u5de7\u307f\u306b\u6d3b\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u6226\u95d8\u3067\u512a\u4f4d\u306b\u7acb\u3064\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n1. \u58c1\u5229\u7528\uff1a\u6575\u3092\u58c1\u306e\u8fd1\u304f\u306b\u8a98\u5c0e\u3057\u3001\u7206\u5f3e\u3092\u914d\u7f6e\u3057\u3066\u3001\u6575\u3092\u8ffd\u3044\u8a70\u3081\u3089\u308c\u307e\u3059\u3002\u7279\u306b\u79fb\u52d5\u901f\u5ea6\u304c\u9045\u3044\u6575\u306e\u5834\u5408\u3001\u3053\u306e\u65b9\u6cd5\u304c\u975e\u5e38\u306b\u6709\u52b9\u3067\u3059\u3002\u4f8b\uff1a\u72ed\u3044\u901a\u8def\u3067\u306f\u3001\u58c1\u304c\u81ea\u7136\u306a\u969c\u58c1\u3068\u306a\u308a\u3001\u6575\u306e\u52d5\u304d\u3092\u5236\u9650\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n2. \u7f60\u4f5c\u6210\uff1a\u969c\u5bb3\u7269\u306e\u5468\u308a\u306b\u7206\u5f3e\u3092\u914d\u7f6e\u3057\u3066\u7f60\u3092\u4f5c\u308a\u3001\u6575\u304c\u81ea\u3089\u7f60\u306b\u5d4c\u307e\u308b\u306e\u3092\u5f85\u3061\u307e\u3059\u3002\u624b\u98061\uff1a\u969c\u5bb3\u7269\u304c\u5bc6\u96c6\u3057\u305f\u5730\u57df\u3092\u9078\u629e\u3001\u624b\u98062\uff1a\u5468\u56f2\u306b\u7206\u5f3e\u3092\u914d\u7f6e\u3001\u624b\u98063\uff1a\u6575\u3092\u8a98\u5c0e\u3057\u307e\u3059\u3002\u8907\u6570\u6848\u6bd4\u8f03\uff1a\u76f4\u63a5\u653b\u6483 vs \u7f60\u5f85\u3061\u3002\n3. \u81ea\u5df1\u9632\u885b\uff1a\u58c1\u3092\u5229\u7528\u3057\u3066\u3001\u6575\u306e\u7206\u5f3e\u304b\u3089\u8eab\u3092\u96a0\u3057\u307e\u3059\u3002\u7206\u5f3e\u3092\u914d\u7f6e\u5f8c\u3001\u8fc5\u901f\u306b\u58c1\u306e\u5f8c\u308d\u306b\u79fb\u52d5\u3059\u308b\u3053\u3068\u3067\u3001\u7206\u5f3e\u306e\u885d\u6483\u304b\u3089\u8eab\u3092\u5b88\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u5730\u5f62\u6d3b\u7528\u3092\u719f\u7df4\u3059\u308b\u3053\u3068\u3067Bomb-it-7\u306e\u9054\u4eba\u306b\u306a\u308c\u308b\u3067\u3057\u3087\u3046\uff01"}, {"question": "Bomb-it-7\u3067\u3001\u6575\u306e\u7206\u5f3e\u3092\u52b9\u679c\u7684\u306b\u56de\u907f\u3059\u308b\u65b9\u6cd5\u306f\uff1f\u9ad8\u5ea6\u306a\u56de\u907f\u30c6\u30af\u30cb\u30c3\u30af\u306f\uff1f", "answer": "\u7206\u5f3e\u3092\u56de\u907f\u3059\u308b\u3053\u3068\u306fBomb-it-7\u3067\u751f\u304d\u6b8b\u308b\u305f\u3081\u306e\u9375\u3067\u3059\u3002\u4ee5\u4e0b\u306f\u9ad8\u5ea6\u306a\u30c6\u30af\u30cb\u30c3\u30af\u3067\u3059\u3002\n1. \u4e88\u6e2c\u79fb\u52d5\uff1a\u6575\u306e\u884c\u52d5\u30d1\u30bf\u30fc\u30f3\u3068\u7206\u5f3e\u306e\u914d\u7f6e\u4f4d\u7f6e\u3092\u89b3\u5bdf\u3057\u3001\u7206\u767a\u7bc4\u56f2\u3092\u4e88\u6e2c\u3057\u3066\u3001\u8fc5\u901f\u306b\u5b89\u5168\u306a\u5834\u6240\u306b\u79fb\u52d5\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6575\u306b\u89d2\u306b\u8ffd\u3044\u3064\u3081\u3089\u308c\u305f\u3089\u3001\u3059\u3050\u306b\u8131\u51fa\u8def\u3092\u63a2\u3057\u3066\u304f\u3060\u3055\u3044\u3001\u305d\u306e\u5834\u3067\u5f85\u3064\u306e\u3067\u306f\u306a\u304f\u3002\n2. \u30a2\u30a4\u30c6\u30e0\u5229\u7528\uff1a\u30b9\u30d4\u30fc\u30c9\u5f37\u5316\u30a2\u30a4\u30c6\u30e0\u306f\u3001\u3088\u308a\u7d20\u65e9\u304f\u79fb\u52d5\u3057\u3001\u7206\u5f3e\u3092\u3088\u308a\u7c21\u5358\u306b\u56de\u907f\u3067\u304d\u307e\u3059\u3002\u9069\u5207\u306a\u6642\u9593\u3001\u52a0\u901f\u30a2\u30a4\u30c6\u30e0\u3092\u6d3b\u7528\u3057\u3066\u3001\u5371\u967a\u5730\u57df\u304b\u3089\u8fc5\u901f\u306b\u96e2\u308c\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n3. \u58f0\u639b\u3051\uff1a\u3042\u308b\u65b9\u5411\u306b\u7206\u5f3e\u3092\u914d\u7f6e\u3057\u3066\u3001\u6575\u306e\u6ce8\u610f\u3092\u5f15\u304d\u3064\u3051\u3001\u305d\u306e\u5f8c\u5225\u306e\u65b9\u5411\u304b\u3089\u8131\u51fa\u3057\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u6575\u3092\u6df7\u4e71\u3055\u305b\u3001\u3042\u306a\u305f\u306b\u6642\u9593\u3092\u7a3c\u3050\u5fc3\u7406\u6226\u8853\u3067\u3059\u3002\u4f8b\u3048\u8a71\uff1a\u5e38\u306b\u8b66\u6212\u3057\u3001\u30c1\u30e3\u30f3\u30b9\u3092\u4f3a\u3046\u6a5f\u654f\u306a\u30a6\u30b5\u30ae\u3092\u81ea\u5206\u306b\u4f8b\u3048\u307e\u3057\u3087\u3046\u3002"}, {"question": "Bomb-it-7\u306e\u30c0\u30d6\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3067\u3001\u30c1\u30fc\u30e0\u3068\u3057\u3066\u52dd\u5229\u3059\u308b\u305f\u3081\u306b\u3069\u306e\u3088\u3046\u306b\u5354\u529b\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Bomb-it-7\u306e\u30c0\u30d6\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3067\u306f\u3001\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u304c\u52dd\u5229\u3078\u306e\u9375\u3068\u306a\u308a\u307e\u3059\u3002\u4ee5\u4e0b\u306f\u3044\u304f\u3064\u304b\u306e\u30a2\u30c9\u30d0\u30a4\u30b9\u3067\u3059\u3002\n1 \u660e\u78ba\u306a\u5f79\u5272\u5206\u62c5\uff1a2\u4eba\u3068\u3082\u305d\u308c\u305e\u308c\u7570\u306a\u308b\u533a\u57df\u3092\u62c5\u5f53\u3057\u305f\u308a\u30011\u4eba\u306f\u653b\u6483\u3001\u3082\u30461\u4eba\u306f\u9632\u5fa1\u3092\u62c5\u5f53\u3057\u305f\u308a\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u30011\u4eba\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u6575\u3092\u8a98\u5f15\u3057\u3001\u3082\u30461\u4eba\u306f\u7206\u5f3e\u3092\u914d\u7f6e\u3059\u308b\u5f79\u5272\u3092\u62c5\u5f53\u3057\u307e\u3059\u3002\n2 \u76f8\u4e92\u652f\u63f4\uff1a1\u4eba\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u7206\u5f3e\u3092\u914d\u7f6e\u3057\u3066\u3044\u308b\u6642\u3001\u3082\u30461\u4eba\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u706b\u529b\u652f\u63f4\u3092\u884c\u3063\u3066\u6575\u306b\u8fd1\u3065\u304b\u306a\u3044\u3088\u3046\u306b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u5f79\u5272\u8868\uff1a\u653b\u6483\u578b vs \u9632\u885b\u578b \u30c1\u30fc\u30e0\u6226\u7565\u3002\n3 \u30a2\u30a4\u30c6\u30e0\u5171\u6709\uff1a\u30b9\u30d4\u30fc\u30c9\u5f37\u5316\u3084\u708e\u4e0a\u5f37\u5316\u306a\u3069\u306e\u6709\u52b9\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u9069\u5b9c\u30c1\u30fc\u30e0\u30e1\u30a4\u30c8\u3068\u5171\u6709\u3057\u307e\u3059\u3002\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u304c\u3001\u30a2\u30a4\u30c6\u30e0\u306e\u4fa1\u5024\u3092\u6700\u5927\u5316\u3057\u307e\u3059\u3002\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u306f\u30c0\u30d6\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u6839\u672c\u3067\u3059\uff01"}, {"question": "Bomb-it-7\u306eAI\u306e\u96e3\u6613\u5ea6\u304c\u30b2\u30fc\u30e0\u4f53\u9a13\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f\u3069\u306e\u8981\u56e0\u304cAI\u306e\u96e3\u6613\u5ea6\u30ec\u30d9\u30eb\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "Bomb-it-7\u306eAI\u306e\u96e3\u6613\u5ea6\u304c\u30b2\u30fc\u30e0\u306e\u4f53\u9a13\u306b\u76f4\u63a5\u5f71\u97ff\u3057\u307e\u3059\u3002\u96e3\u6613\u5ea6\u304c\u9ad8\u304f\u306a\u308b\u307b\u3069\u3001AI\u306e\u53cd\u5fdc\u901f\u5ea6\u3001\u6226\u7565\u9078\u629e\u3001\u30a2\u30a4\u30c6\u30e0\u4f7f\u7528\u306f\u3088\u308a\u6d17\u7df4\u3055\u308c\u307e\u3059\u3002\u3064\u307e\u308a\uff1a\n1. \u3088\u308a\u901f\u3044\u53cd\u5fdc\u901f\u5ea6\uff1aAI\u306f\u3042\u306a\u305f\u306e\u7206\u5f3e\u3092\u3088\u308a\u901f\u304f\u56de\u907f\u3057\u3001\u3042\u306a\u305f\u306e\u653b\u6483\u3092\u96e3\u3057\u304f\u3057\u307e\u3059\u3002\n2. \u3088\u308a\u6d17\u7df4\u3055\u308c\u305f\u6226\u7565\uff1aAI\u306f\u5730\u5f62\u3084\u969c\u5bb3\u7269\u3092\u3088\u308a\u826f\u304f\u6d3b\u7528\u3057\u3066\u3001\u7f60\u3092\u4ed5\u639b\u3051\u305f\u308a\u3001\u5305\u56f2\u3057\u307e\u3059\u3002\u4f8b\uff1a\u9ad8\u96e3\u6613\u5ea6\u306eAI\u306f\u3001\u30de\u30c3\u30d7\u306e\u6709\u5229\u306a\u5834\u6240\u306b\u512a\u5148\u7684\u306b\u914d\u7f6e\u3055\u308c\u307e\u3059\u3002\uff08\u4f8b\uff1a\u30b3\u30fc\u30ca\u30fc\u3084\u901a\u9053\uff09\u3002\n3. \u3088\u308a\u52b9\u7387\u7684\u306a\u30a2\u30a4\u30c6\u30e0\u4f7f\u7528\uff1aAI\u306f\u3088\u308a\u9069\u5207\u306b\u30a2\u30a4\u30c6\u30e0\uff08\u4f8b\uff1a\u7206\u5f3e\u907f\u3051\u306e\u305f\u3081\u306e\u30b9\u30d4\u30fc\u30c9\u5f37\u5316\u3001\u7206\u767a\u7bc4\u56f2\u62e1\u5927\u306e\u305f\u3081\u306e\u708e\u4e0a\u5f37\u5316\uff09\u3092\u6d3b\u7528\u3057\u307e\u3059\u3002\u30b7\u30b9\u30c6\u30e0\u89e3\u6790\uff1a\u30b2\u30fc\u30e0AI\u306e\u610f\u601d\u6c7a\u5b9a\u30c4\u30ea\u30fc\u5206\u6790\u3002"}, {"question": "Bomb-it-7\u306e\u6570\u5b57\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f\u3069\u306e\u57fa\u672c\u7684\u306a\u6570\u5b66\u304c\u30b2\u30fc\u30e0\u3092\u6c7a\u5b9a\u3057\u307e\u3059\u304b\uff1f", "answer": "Bomb-it-7\u306e\u6570\u5b57\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u4ee5\u4e0b\u306e\u70b9\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u3044\u307e\u3059\u3002\n1. \u7206\u767a\u7bc4\u56f2\uff1a\u521d\u671f\u306e\u7206\u5f3e\u306e\u7206\u767a\u7bc4\u56f2\u306f\u901a\u5e381\u30de\u30b9\u3067\u3059\u304c\u3001\u708e\u4e0a\u5f37\u5316\u30a2\u30a4\u30c6\u30e0\u3092\u62fe\u3046\u3053\u3068\u3067\u7206\u767a\u7bc4\u56f2\u304c\u5897\u52a0\u3057\u307e\u3059\u3002\u7206\u767a\u7bc4\u56f2\u306e\u5897\u52a0\u306f\u7dda\u5f62\u3067\u3042\u308a\u3001\u6307\u6570\u578b\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u4f8b\u3048\u3070\u3001\u7206\u767a\u7bc4\u56f2\u304c+1\u306b\u306a\u308b\u3068\u3001\u5341\u5b57\u5f62\u306b1\u30de\u30b9\u305a\u3064\u8ffd\u52a0\u3055\u308c\u307e\u3059\u3002\n2. \u79fb\u52d5\u901f\u5ea6\uff1a\u521d\u671f\u306e\u79fb\u52d5\u901f\u5ea6\u306f\u56fa\u5b9a\u3055\u308c\u3066\u3044\u307e\u3059\u304c\u3001\u30b9\u30d4\u30fc\u30c9\u5f37\u5316\u30a2\u30a4\u30c6\u30e0\u3092\u62fe\u3046\u3053\u3068\u3067\u79fb\u52d5\u901f\u5ea6\u304c\u901f\u304f\u306a\u308a\u307e\u3059\u3002\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30b9\u30d4\u30fc\u30c9\u5f37\u5316\u30a2\u30a4\u30c6\u30e0-> \u79fb\u52d5\u901f\u5ea6\u5897\u52a0 ->\u3088\u308a\u7c21\u5358\u306b\u56de\u907f/\u8ffd\u6483\u304c\u53ef\u80fd\u3002\n3. \u7206\u5f3e\u6570\uff1a\u521d\u671f\u306e\u7206\u5f3e\u6570\u306f1\u500b\u3067\u3059\u3002\u7206\u5f3e\u6570\u5897\u52a0\u30a2\u30a4\u30c6\u30e0\u3092\u62fe\u3046\u3053\u3068\u3067\u3001\u4e00\u5ea6\u306b\u914d\u7f6e\u3067\u304d\u308b\u7206\u5f3e\u6570\u304c\u5897\u52a0\u3057\u307e\u3059\u3002\u7206\u5f3e\u6570\u306e\u4e0a\u9650\u306f\u4e00\u822c\u7684\u306b5\u500b\u524d\u5f8c\u3067\u3059\u3002\n4. AI\u96e3\u6613\u5ea6\uff1aAI\u96e3\u6613\u5ea6\u304c\u9ad8\u304f\u306a\u308b\u307b\u3069\u3001\u53cd\u5fdc\u901f\u5ea6\uff08\u7206\u5f3e\u3092\u56de\u907f\u3059\u308b\u6642\u9593\u306a\u3069\uff09\u3068\u6c7a\u5b9a\u983b\u5ea6\u304c\u9855\u8457\u306b\u5897\u52a0\u3057\u307e\u3059\u3002\u6570\u5024\u5206\u6790\uff1a\u7570\u306a\u308bAI\u96e3\u6613\u5ea6\u3067\u306e\u7d71\u8a08\u30c7\u30fc\u30bf\u6bd4\u8f03\u3002"}, {"question": "Bomb-it-7\u306f\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u306e\u30b2\u30fc\u30e0\u307e\u305f\u306f\u30c7\u30fc\u30bf\u306e\u79fb\u884c\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u307e\u3059\u304b\uff1f\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u3092\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u901a\u5e38\u3001Bomb-it-7\u306e\u3088\u3046\u306aFlash\u30b2\u30fc\u30e0\u306f\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u30b2\u30fc\u30e0\u3084\u30c7\u30fc\u30bf\u306e\u79fb\u884c\u3092\u30cd\u30a4\u30c6\u30a3\u30d6\u3067\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u307e\u305b\u3093\u3002\u306a\u305c\u306a\u3089\u3001\u3053\u308c\u3089\u306e\u30b2\u30fc\u30e0\u306e\u30c7\u30fc\u30bf\u306f\u901a\u5e38\u3001\u30ed\u30fc\u30ab\u30eb\u30d6\u30e9\u30a6\u30b6\u30ad\u30e3\u30c3\u30b7\u30e5\u306b\u4fdd\u5b58\u3055\u308c\u3001\u30af\u30e9\u30a6\u30c9\u30b5\u30fc\u30d0\u30fc\u306b\u4fdd\u5b58\u3055\u308c\u306a\u3044\u304b\u3089\u3067\u3059\u3002\u305d\u306e\u305f\u3081\u3001\u30c7\u30d0\u30a4\u30b9\u3084\u30d6\u30e9\u30a6\u30b6\u3092\u5909\u66f4\u3059\u308b\u3068\u3001\u4ee5\u524d\u306e\u30b2\u30fc\u30e0\u9032\u884c\u72b6\u6cc1\u304c\u5931\u308f\u308c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3057\u304b\u3057\u3001Bomb-it-7\u306e\u518d\u5236\u4f5c\u7248\u3084\u79fb\u690d\u7248\u306e\u4e2d\u306b\u306f\u3001\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u63d0\u4f9b\u3057\u3066\u3044\u308b\u3082\u306e\u304c\u3042\u308a\u307e\u3059\u3002\u3057\u304b\u3057\u3001\u3053\u308c\u306f\u5177\u4f53\u7684\u306a\u30b2\u30fc\u30e0\u30d0\u30fc\u30b8\u30e7\u30f3\u3084\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u6b21\u7b2c\u3067\u3059\u3002"}, {"question": "Bomb-it-7\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3084\u30ec\u30d9\u30eb\u306f\u3042\u308a\u307e\u3059\u304b\uff1f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u30c8\u30ea\u30ac\u30fc\u3059\u308b\u65b9\u6cd5\u3092\u6559\u3048\u3066\u304f\u3060\u3055\u3044\uff1f", "answer": "\u4e00\u90e8\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u306eBomb-it-7\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3084\u30ec\u30d9\u30eb\u304c\u5b58\u5728\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u30c8\u30ea\u30ac\u30fc\u65b9\u6cd5\u306f\u3001\u901a\u5e38\u3001\u975e\u5e38\u306b\u96a0\u3055\u308c\u3066\u3044\u3066\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u3042\u308b\u7279\u5b9a\u306e\u64cd\u4f5c\u3084\u6761\u4ef6\u3092\u6e80\u305f\u3059\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3068\u3057\u3066\u3001\u3042\u308b\u30ec\u30d9\u30eb\u3067\u6307\u5b9a\u3055\u308c\u305f\u6570\u306e\u7206\u5f3e\u3092\u9023\u7d9a\u3057\u3066\u914d\u7f6e\u3057\u3066\u7206\u767a\u3055\u305b\u306a\u3044\u3067\u3044\u308b\u3068\u3001\u96a0\u3055\u308c\u305f\u30ec\u30d9\u30eb\u304c\u89e3\u653e\u3055\u308c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u307e\u305f\u306f\u3001\u7279\u5b9a\u306e\u30e2\u30fc\u30c9\u3067\u7279\u5b9a\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u4f7f\u3063\u3066\u30b2\u30fc\u30e0\u306b\u52dd\u5229\u3059\u308b\u3068\u3001\u96a0\u3057\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u89e3\u653e\u3055\u308c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u8907\u6570\u6848\u6bd4\u8f03\uff1a\u66b4\u529b\u7684\u306a\u65b9\u6cd5 vs \u6226\u7565\u7684\u306a\u96a0\u3057\u8981\u7d20\u306e\u89e3\u653e\u3002"}]
[{"question": "Bomb-it-7\ub294 \uc5b4\ub5bb\uac8c \uac8c\uc784\uc744 \uc2dc\uc791\ud569\ub2c8\uae4c? \ucd08\ubcf4\uc790 \ube60\ub978 \uc219\ub2ec \uac00\uc774\ub4dc: \uc2dc\uc791 \ubc84\ud2bc\uacfc \uba54\ub274 \ud0d0\uc0c9 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Bomb-it-7 \uc2dc\uc791\uc740 \ub9e4\uc6b0 \uac04\ud3b8\ud569\ub2c8\ub2e4! \uac8c\uc784 \ub85c\ub529\uc774 \uc644\ub8cc\ub418\uba74 \uba54\uc778 \uba54\ub274\uc5d0\uc11c \ubc29\ud5a5\ud0a4\ub85c \uac8c\uc784 \ubaa8\ub4dc(\uc608: 1\uc778 \ubaa8\ub4dc, 2\uc778 \ubaa8\ub4dc)\ub97c \uc120\ud0dd\ud558\uace0 \uc5d4\ud130 \ud0a4\ub85c \ud655\uc778\ud569\ub2c8\ub2e4. 2\uc778 \ubaa8\ub4dc\uc778 \uacbd\uc6b0, P1\ub294 WASD\ub85c \uc774\ub3d9\ud558\uace0 J \ud0a4\ub85c \ud3ed\ud0c4\uc744 \uc124\uce58\ud558\uba70, P2\ub294 \ubc29\ud5a5\ud0a4\ub85c \uc774\ub3d9\ud558\uace0 \uc5d4\ud130 \ud0a4\ub85c \ud3ed\ud0c4\uc744 \uc124\uce58\ud569\ub2c8\ub2e4. \uac8c\uc784\uc758 \ubaa9\ud45c\ub294 \ubaa8\ub4e0 \uc801\uc744 \ud30c\uad34\ud558\uac70\ub098 \uc9c0\uc815\ub41c \uc870\uac74\uc744 \ub2ec\uc131\ud558\ub294 \uac83\uc785\ub2c8\ub2e4! \ube44\uc720 \uc124\uba85: \ucd08\ubcf4 \ub2e8\uacc4\uc5d0\uc11c\ub294 \uc790\uc2e0\uc744 \ud574\uccb4 \uc804\ubb38\uac00\ub85c \uc0dd\uac01\ud558\uace0 \uce68\ucc29\ud558\uac8c \uacb0\uc815\ud558\uace0 \uc810\uc9c4\uc801\uc73c\ub85c \ub098\uc544\uac08 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ucd08\ubcf4\uc790\ub294 \uc26c\uc6b4 \ub09c\uc774\ub3c4\ub97c \uba3c\uc800 \uc120\ud0dd\ud558\uc5ec \uc870\uc791 \ubc29\ubc95\uacfc \uac8c\uc784 \uaddc\uce59\uc5d0 \uc775\uc219\ud574\uc9c0\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4."}, {"question": "Bomb-it-7\uc5d0\ub294 \uc5b4\ub5a4 \ub2e4\ub978 \ud30c\uc6cc\uc5c5\uc774 \uc788\uc73c\uba70 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c? \uc5b4\ub5a4 \uc544\uc774\ud15c\ub4e4\uc774 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Bomb-it-7\uc5d0\ub294 \uc218\uc9d1\ud560 \uc218 \uc788\ub294 \uc7ac\ubbf8\uc788\ub294 \uc544\uc774\ud15c\uc774 \ub9ce\uc2b5\ub2c8\ub2e4. \uc218\uc9d1\ud558\uba74 \ubc14\ub85c \ud6a8\uacfc\uac00 \ubc1c\uc0dd\ud569\ub2c8\ub2e4.\n1. \ubd88\uaf43 \uac15\ud654: \ud3ed\ud0c4\uc758 \ud3ed\ubc1c \ubc94\uc704\ub97c \ub298\ub824 \uc801\uc744 \ub354 \uc27d\uac8c \ud30c\uad34\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucd08\uae30 \ud3ed\ud0c4 \ubc94\uc704\ub294 1\uce78\uc774\uc9c0\ub9cc \ubd88\uaf43 \uac15\ud654\ub97c \uc5bb\uc73c\uba74 2\uce78 \ub610\ub294 \uc804\uccb4 \ud654\uba74\uc73c\ub85c \ud655\ub300\ub429\ub2c8\ub2e4.\n2. \ud3ed\ud0c4 \uac1c\uc218 \uc99d\uac00: \ud55c \ubc88\uc5d0 \ub354 \ub9ce\uc740 \ud3ed\ud0c4\uc744 \uc124\uce58\ud558\uc5ec \ub354 \uc9d1\uc911\uc801\uc778 \ud3ed\uaca9 \ud6a8\uacfc\ub97c \ub0bc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucd08\uae30\uc5d0\ub294 1\uac1c\uc758 \ud3ed\ud0c4\uc744 \uc124\uce58\ud560 \uc218 \uc788\uc9c0\ub9cc \uc544\uc774\ud15c\uc744 \uc5bb\uc73c\uba74 \ub3d9\uc2dc\uc5d0 2\uac1c \ub610\ub294 3\uac1c\ub97c \uc124\uce58\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n3. \uc18d\ub3c4 \ud5a5\uc0c1: \uc774\ub3d9 \uc18d\ub3c4\ub97c \ub192\uc5ec \uc801\uc758 \uacf5\uaca9\uc744 \ub354 \ud6a8\uacfc\uc801\uc73c\ub85c \ud53c\ud558\uac70\ub098 \uc801\uc744 \ub354 \ube60\ub974\uac8c \ucd94\uaca9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc18d\ub3c4 \ud5a5\uc0c1 \ud6a8\uacfc\ub294 \ud654\uba74 \ud558\ub2e8\uc5d0 \uc77c\ubc18\uc801\uc73c\ub85c \ud45c\uc2dc\ub429\ub2c8\ub2e4.\n4. \ubcbd \ud22c\uacfc: \ubcbd\uc744 \ud1b5\uacfc\ud558\uc5ec \uc801\uc744 \ud6c4\ubc29\uc5d0\uc11c \uae30\uc2b5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc544\uc774\ud15c \ud65c\uc6a9\uc744 \uc219\ub2ec\ud558\ub294 \uac83\uc740 \uac8c\uc784 \uc2b9\ub9ac\uc758 \ud575\uc2ec\uc785\ub2c8\ub2e4! \uac15\ud654 \uc694\uc18c: \ubaa8\ub4e0 \uc544\uc774\ud15c\uacfc \uae30\ub2a5\uc744 \ub098\uc5f4\ud55c \ucc38\uc870\ud45c.\n"}, {"question": "Bomb-it-7\uc758 \ud3ed\ud0c4\uc740 \uc5b4\ub5bb\uac8c \uc218\ub3d9\uc73c\ub85c \ud3ed\ubc1c\uc2dc\ud0a4\ub098\uc694? \ud3ed\ud0c4\uc744 \uc218\ub3d9\uc73c\ub85c \uc791\ub3d9\uc2dc\ud0a4\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Bomb-it-7\uc5d0\uc11c \ud3ed\ud0c4\uc740 \uae30\ubcf8\uc801\uc73c\ub85c \uc124\uce58 \ud6c4 \uc77c\uc815 \uc2dc\uac04\uc774 \uc9c0\ub098\uba74 \uc790\ub3d9\uc73c\ub85c \ud3ed\ubc1c\ud569\ub2c8\ub2e4. \ud3ed\ud0c4\uc744 \uc218\ub3d9\uc73c\ub85c \ud3ed\ubc1c\uc2dc\ud0a4\ub294 \ubc29\ubc95\uc740 \uc5c6\uc2b5\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \ub2e4\uc74c\uacfc \uac19\uc740 \ubc29\ubc95\uc73c\ub85c \ud3ed\ubc1c \uc2dc\uae30\ub97c \uac04\uc811\uc801\uc73c\ub85c \uc81c\uc5b4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n1. \uc5f0\uc18d \uc124\uce58: \ud3ed\ud0c4 \uc124\uce58 \uac1c\uc218 \uc81c\ud55c\uc774 \uc788\uae30 \ub54c\ubb38\uc5d0, \uc81c\ud55c \uc218\uce58\uc5d0 \ub3c4\ub2ec\ud558\uba74 \ucd5c\uadfc\uc5d0 \uc124\uce58\ub41c \ud3ed\ud0c4\uc774 \uac00\uc7a5 \uc624\ub798 \uc804\uc5d0 \uc124\uce58\ub41c \ud3ed\ud0c4\uc744 \ub300\uccb4\ud558\uc5ec \ud3ed\ubc1c\ud569\ub2c8\ub2e4.\n2. \uc544\uc774\ud15c \ud65c\uc6a9: \uc77c\ubd80 \uc544\uc774\ud15c\uc740 \ud3ed\ud0c4\uc758 \ud3ed\ubc1c \uc2dc\uac04\uc774\ub098 \ubc29\ubc95\uc5d0 \uc601\ud5a5\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784 \ub0b4 \ud78c\ud2b8\ub97c \uc8fc\uc758 \uae4a\uac8c \ud655\uc778\ud558\uc2ed\uc2dc\uc624.\n\ud750\ub984\ub3c4: \ud3ed\ud0c4 \uc124\uce58 -> \uc77c\uc815 \uc2dc\uac04 \ub300\uae30 -> \ud3ed\ud0c4 \ud3ed\ubc1c\n"}, {"question": "Bomb-it-7\uc5d0\uc11c \uc9c0\ud615\uacfc \uc7a5\uc560\ubb3c\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\uc5ec \uc5b4\ub5a4 \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c? \uc9c0\ud615 \uc778\uc2dd\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Bomb-it-7\uc5d0\uc11c \uc9c0\ud615\uacfc \uc7a5\uc560\ubb3c\uc740 \uc911\uc694\ud55c \uc804\ub7b5\uc801 \uc790\uc6d0\uc785\ub2c8\ub2e4. \uc774\ub4e4\uc744 \uad50\ubb18\ud788 \ud65c\uc6a9\ud558\uba74 \uc804\ud22c\uc5d0\uc11c \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n1. \ubcbd \ud65c\uc6a9: \uc801\uc744 \ubcbd \uadfc\ucc98\ub85c \uc720\uc778\ud55c \ub2e4\uc74c \ud3ed\ud0c4\uc744 \uc124\uce58\ud558\uc5ec \uadf8\ub4e4\uc774 \ub3c4\ub9dd\uce60 \uc218 \uc5c6\ub3c4\ub85d \ub9cc\ub4ed\ub2c8\ub2e4. \ud2b9\ud788 \uc774\ub3d9 \uc18d\ub3c4\uac00 \ub290\ub9b0 \uc801\uc5d0\uac8c\ub294 \uc774 \ubc29\ubc95\uc774 \ub9e4\uc6b0 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. \uc608\uc2dc: \uc881\uc740 \ud1b5\ub85c\uc5d0\uc11c \ubcbd\uc740 \uc790\uc5f0\uc801\uc778 \uc7a5\ubcbd \uc5ed\ud560\uc744 \ud558\uc5ec \uc801\uc758 \uc774\ub3d9\uc744 \uc81c\ud55c\ud569\ub2c8\ub2e4.\n2. \ud568\uc815 \uc81c\uc791: \uc7a5\uc560\ubb3c \uc8fc\ubcc0\uc5d0 \ud3ed\ud0c4\uc744 \uc124\uce58\ud558\uc5ec \ud568\uc815\uc744 \ub9cc\ub4e4\uace0 \uc801\uc774 \uc2a4\uc2a4\ub85c \ud568\uc815\uc5d0 \ube60\uc9c0\ub3c4\ub85d \uae30\ub2e4\ub9bd\ub2c8\ub2e4. STEP1: \uc7a5\uc560\ubb3c\uc774 \ubc00\uc9d1\ub41c \uc9c0\uc5ed\uc744 \uc120\ud0dd, STEP2: \uc8fc\ubcc0\uc5d0 \ud3ed\ud0c4 \uc124\uce58, STEP3: \uc801\uc744 \uc720\uc778\ud569\ub2c8\ub2e4. \ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: \uc9c1\uc811 \uacf5\uaca9 vs. \ud568\uc815 \ub9e4\ubcf5\n3. \uc790\uae30 \ubcf4\ud638: \ubcbd\uc744 \uc774\uc6a9\ud558\uc5ec \uc801\uc758 \ud3ed\ud0c4\uc73c\ub85c\ubd80\ud130 \ud53c\uc2e0\ud569\ub2c8\ub2e4. \ud3ed\ud0c4\uc744 \uc124\uce58\ud55c \ud6c4 \ubcbd \ub4a4\ub85c \uc2e0\uc18d\ud558\uac8c \uc774\ub3d9\ud558\uc5ec \ud3ed\ud0c4 \ud30c\ud3b8\uc73c\ub85c\ubd80\ud130 \ud6a8\uacfc\uc801\uc73c\ub85c \ubcf4\ud638\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc9c0\ud615 \ud65c\uc6a9 \ub2a5\ub825\uc744 \uc219\ub2ec\ud558\ub294 \uac83\uc740 Bomb-it-7 \uace0\uc218\uac00 \ub418\ub294 \uc911\uc694\ud55c \uc694\uc18c\uc785\ub2c8\ub2e4!\n"}, {"question": "Bomb-it-7\uc5d0\uc11c \uc801\uc758 \ud3ed\ud0c4\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \ud53c\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c? \uc5b4\ub5a4 \uace0\uae09 \ud68c\ud53c \uae30\uc220\uc774 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud3ed\ud0c4\uc744 \ud53c\ud558\ub294 \uac83\uc740 Bomb-it-7 \uc0dd\uc874\uc758 \ud575\uc2ec\uc785\ub2c8\ub2e4. \ub2e4\uc74c\uc740 \uba87 \uac00\uc9c0 \uace0\uae09 \uae30\uc220\uc785\ub2c8\ub2e4.\n1. \uc608\uce21 \uc774\ub3d9: \uc801\uc758 \uc774\ub3d9 \uacbd\ub85c\uc640 \ud3ed\ud0c4 \uc124\uce58 \uc704\uce58\ub97c \uad00\ucc30\ud558\uc5ec \ud3ed\ubc1c \ubc94\uc704\ub97c \ubbf8\ub9ac \uc608\uce21\ud558\uace0 \uc548\uc804\ud55c \uc9c0\uc5ed\uc73c\ub85c \uc2e0\uc18d\ud558\uac8c \uc774\ub3d9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc801\uc774 \ub2f9\uc2e0\uc744 \uad6c\uc11d\uc73c\ub85c \ubab0\uc544\ub123\uc73c\uba74 \uc989\uc2dc \ud0c8\ucd9c \uacbd\ub85c\ub97c \ucc3e\uc544\uc57c \ud558\uba70, \uadf8 \uc790\ub9ac\uc5d0 \uae30\ub2e4\ub9ac\uba74 \uc548 \ub429\ub2c8\ub2e4.\n2. \uc544\uc774\ud15c \ud65c\uc6a9: \uc18d\ub3c4 \ud5a5\uc0c1 \uc544\uc774\ud15c\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub354 \ube68\ub9ac \uc6c0\uc9c1\uc5ec \ud3ed\ud0c4\uc744 \ub354 \uc27d\uac8c \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac00\uc18d \uc544\uc774\ud15c\uc744 \uc801\uc808\ud788 \ud65c\uc6a9\ud558\uba74 \uc704\ud5d8 \uc9c0\uc5ed\uc5d0\uc11c \ube60\ub974\uac8c \ubc97\uc5b4\ub0a0 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n3. \ud63c\ub780 \uc720\ub3c4: \ud55c \ubc29\ud5a5\uc5d0 \ud3ed\ud0c4\uc744 \uc124\uce58\ud558\uc5ec \uc801\uc758 \uc8fc\uc758\ub97c \ub04c\uace0 \ub2e4\ub978 \ubc29\ud5a5\uc5d0\uc11c \ud0c8\ucd9c\ud569\ub2c8\ub2e4. \uc774\uac83\uc740 \uc2ec\ub9ac\uc801\uc778 \uc804\uc220\ub85c \uc801\uc744 \ud604\ud639\ud558\uace0 \uc2dc\uac04\uc744 \ubc8c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ube44\uc720 \uc124\uba85: \uc6c0\uc9c1\uc784\uc774 \ubbfc\ucca9\ud55c \ud1a0\ub07c\ucc98\ub7fc \ud56d\uc0c1 \uacbd\uacc4\ud558\uace0 \uae30\ud68c\ub97c \uc5ff\ubcf4\uc2ed\uc2dc\uc624.\n"}, {"question": "Bomb-it-7 2\uc778 \ubaa8\ub4dc\uc5d0\uc11c \ud300\uc6cc\ud06c\ub97c \ud1b5\ud574 \uc2b9\ub9ac\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c? 2\uc778 \ud50c\ub808\uc774\uc5d0\uc11c \uc5b4\ub5bb\uac8c \ud6a8\uacfc\uc801\uc73c\ub85c \ud611\ub825\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "Bomb-it-7 2\uc778 \ubaa8\ub4dc\uc5d0\uc11c \ub048\ub048\ud55c \ud611\ub825\uc740 \uc2b9\ub9ac\uc758 \uc5f4\uc1e0\uc785\ub2c8\ub2e4. \ub2e4\uc74c\uc740 \uba87 \uac00\uc9c0 \uc81c\uc548\uc785\ub2c8\ub2e4.\n1. \uc5ed\ud560 \ubd84\ub2f4: \ub450 \uba85\uc774 \uc11c\ub85c \ub2e4\ub978 \uc9c0\uc5ed\uc744 \ub2f4\ub2f9\ud558\uac70\ub098 \ud55c \uba85\uc740 \uacf5\uaca9, \ub2e4\ub978 \ud55c \uba85\uc740 \ubc29\uc5b4\ub97c \ub2f4\ub2f9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud55c \uba85\uc758 \ud300\uc6d0\uc774 \uc801\uc744 \uc720\uc778\ud558\uace0 \ub2e4\ub978 \ud300\uc6d0\uc774 \ud3ed\ud0c4\uc744 \uc124\uce58\ud569\ub2c8\ub2e4.\n2. \uc11c\ub85c \uc9c0\uc6d0: \ud55c \ud300\uc6d0\uc774 \ud3ed\ud0c4\uc744 \uc124\uce58\ud558\uba74 \ub2e4\ub978 \ud300\uc6d0\uc774 \uc801\uc758 \uc811\uadfc\uc744 \ub9c9\uae30 \uc704\ud574 \ud654\ub825 \uc9c0\uc6d0\uc744 \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uad6c\uc131 \ud45c: \uacf5\uaca9\ud615 vs. \ubc29\uc5b4\ud615 \ud300\uc6d0 \uc804\ub7b5\n3. \uc544\uc774\ud15c \uacf5\uc720: \uc18d\ub3c4 \ud5a5\uc0c1\uc774\ub098 \ubd88\uaf43 \uac15\ud654\uc640 \uac19\uc740 \uc720\uc6a9\ud55c \uc544\uc774\ud15c\uc744 \ud300\uc6d0\uacfc \uc2e0\uc18d\ud558\uac8c \uacf5\uc720\ud558\uc2ed\uc2dc\uc624. \ud300\uc6cc\ud06c\ub294 \uc544\uc774\ud15c\uc758 \uac00\uce58\ub97c \uadf9\ub300\ud654\ud558\ub294 \ud575\uc2ec\uc785\ub2c8\ub2e4! \uae30\uc5b5\ud558\uc138\uc694, \ud300\uc6cc\ud06c\ub294 2\uc778 \ubaa8\ub4dc\uc758 \ud575\uc2ec\uc785\ub2c8\ub2e4!\n"}, {"question": "Bomb-it-7\uc758 AI \ub09c\uc774\ub3c4\ub294 \uac8c\uc784 \uacbd\ud5d8\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c? AI \ub09c\uc774\ub3c4 \ub808\ubca8\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc694\uc778\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Bomb-it-7\uc758 AI \ub09c\uc774\ub3c4\ub294 \uac8c\uc784 \uacbd\ud5d8\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ub09c\uc774\ub3c4\uac00 \ub192\uc744\uc218\ub85d AI\uc758 \ubc18\uc751 \uc18d\ub3c4, \uc804\ub7b5 \uc120\ud0dd, \uc544\uc774\ud15c \uc0ac\uc6a9\uc740 \ub354\uc6b1 \uad50\ubb18\ud574\uc9d1\ub2c8\ub2e4. \uc774\ub294 \ub2e4\uc74c\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4:\n1. \ub354 \ube60\ub978 \ubc18\uc751 \uc18d\ub3c4: AI\ub294 \ub2f9\uc2e0\uc758 \ud3ed\ud0c4\uc744 \ub354 \ube68\ub9ac \ud53c\ud558\uba70, \ub2f9\uc2e0\uc774 \uadf8\ub4e4\uc744 \uacf5\uaca9\ud558\ub294 \uac83\uc744 \ub354 \uc5b4\ub835\uac8c \ub9cc\ub4ed\ub2c8\ub2e4.\n2. \ub354 \uc9c0\ub2a5\uc801\uc778 \uc804\ub7b5: AI\ub294 \uc9c0\ud615\uacfc \uc7a5\uc560\ubb3c\uc744 \ub354 \uc798 \ud65c\uc6a9\ud558\uc5ec \ud568\uc815\uc744 \ub9cc\ub4e4\uac70\ub098 \ud3ec\uc704\ud569\ub2c8\ub2e4. \uc608: \uace0\ub09c\uc774\ub3c4 AI\ub294 \ub9f5\uc758 \uc720\ub9ac\ud55c \uc704\uce58(\uc608: \ubaa8\uc11c\ub9ac \ub610\ub294 \ud1b5\ub85c)\ub97c \uba3c\uc800 \ucc28\uc9c0\ud569\ub2c8\ub2e4.\n3. \ub354 \ud6a8\uc728\uc801\uc778 \uc544\uc774\ud15c \uc0ac\uc6a9: AI\ub294 \ud3ed\ud0c4\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uc801\uc808\ud55c \uc2dc\uc810\uc5d0 \uc18d\ub3c4 \ud5a5\uc0c1 \uc544\uc774\ud15c\uc744 \uc0ac\uc6a9\ud558\uac70\ub098 \ud3ed\ubc1c \ubc94\uc704\ub97c \ud655\ub300\ud558\uae30 \uc704\ud574 \ubd88\uaf43 \uac15\ud654 \uc544\uc774\ud15c\uc744 \uc0ac\uc6a9\ud558\ub294 \ub4f1 \uc544\uc774\ud15c\uc744 \ub354 \uc798 \ud65c\uc6a9\ud569\ub2c8\ub2e4.\n\uc2dc\uc2a4\ud15c \ubd84\uc11d: \uac8c\uc784 AI\uc758 \uc758\uc0ac \uacb0\uc815 \ud2b8\ub9ac \ubd84\uc11d.\n"}, {"question": "Bomb-it-7\uc758 \uc22b\uc790 \uba54\ucee4\ub2c8\uc998\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c? \uac8c\uc784\uc5d0 \uae30\ubcf8\uc774 \ub418\ub294 \uc218\ud559\uc801 \uc6d0\ub9ac\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Bomb-it-7\uc758 \uc22b\uc790 \uba54\ucee4\ub2c8\uc998\uc740 \ub2e4\uc74c \uba87 \uac00\uc9c0 \uce21\uba74\uc5d0\uc11c \ub098\ud0c0\ub0a9\ub2c8\ub2e4.\n1. \ud3ed\ubc1c \ubc18\uacbd: \ucd08\uae30 \ud3ed\ud0c4\uc758 \ud3ed\ubc1c \ubc18\uacbd\uc740 \uc77c\ubc18\uc801\uc73c\ub85c 1\uce78\uc774\uba70, \ubd88\uaf43 \uac15\ud654 \uc544\uc774\ud15c\uc744 \ud1b5\ud574 \ud3ed\ubc1c \ubc18\uacbd\uc744 \ub298\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud3ed\ubc1c \ubc18\uacbd \uc99d\uac00\ub294 \uc120\ud615\uc801\uc774\uba70 \uc9c0\uc218\uc801\uc774\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud3ed\ubc1c \ubc18\uacbd +1\uc774\uba74 \uad50\ucc28 \ubc29\ud5a5\uc73c\ub85c 1\uce78\uc529 \ucd94\uac00\ub429\ub2c8\ub2e4.\n2. \uc774\ub3d9 \uc18d\ub3c4: \ucd08\uae30 \uc774\ub3d9 \uc18d\ub3c4\ub294 \uace0\uc815\ub418\uc5b4 \uc788\uc73c\uba70, \uc18d\ub3c4 \ud5a5\uc0c1 \uc544\uc774\ud15c\uc744 \ud1b5\ud574 \uc774\ub3d9 \uc18d\ub3c4\ub97c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud750\ub984\ub3c4: \uc18d\ub3c4 \ud5a5\uc0c1 \uc544\uc774\ud15c -> \uc774\ub3d9 \uc18d\ub3c4 \uc99d\uac00 -> \uc801 \ud53c\ud558\uae30/\ucd94\uaca9 \uc6a9\uc774\n3. \ud3ed\ud0c4 \uac1c\uc218: \ucd08\uae30 \ud3ed\ud0c4 \uac1c\uc218\ub294 1\uac1c\uc774\uba70, \ud3ed\ud0c4 \uac1c\uc218 \uc99d\uac00 \uc544\uc774\ud15c\uc744 \ud1b5\ud574 \ub3d9\uc2dc\uc5d0 \uc124\uce58\ud560 \uc218 \uc788\ub294 \ud3ed\ud0c4 \uac1c\uc218\ub97c \ub298\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud3ed\ud0c4 \uac1c\uc218 \uc81c\ud55c\uc740 \uc77c\ubc18\uc801\uc73c\ub85c 5\uac1c \uc815\ub3c4\uc785\ub2c8\ub2e4.\n4. AI \ub09c\uc774\ub3c4: AI \ub09c\uc774\ub3c4\uac00 \ub192\uc744\uc218\ub85d \ubc18\uc751 \uc18d\ub3c4(\uc608: \ud3ed\ud0c4 \ud68c\ud53c \uc2dc\uac04)\uc640 \uc758\uc0ac \uacb0\uc815 \ube48\ub3c4\uac00 \ud604\uc800\ud558\uac8c \ub192\uc544\uc9d1\ub2c8\ub2e4. \uc218\uce58 \ubd84\uc11d: \ub2e4\uc591\ud55c AI \ub09c\uc774\ub3c4\uc758 \ud1b5\uacc4 \ub370\uc774\ud130 \ube44\uad50.\n"}, {"question": "Bomb-it-7\uc740 \ud50c\ub7ab\ud3fc \uac04 \uac8c\uc784\uc774\ub098 \ub370\uc774\ud130 \uc774\uc804\uc744 \uc9c0\uc6d0\ud569\ub2c8\uae4c? \uc800\uc7a5 \ub370\uc774\ud130\ub97c \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uc77c\ubc18\uc801\uc73c\ub85c Bomb-it-7\uacfc \uac19\uc740 \ud50c\ub798\uc2dc \uae30\ubc18 \uac8c\uc784\uc740 \uc6d0\ub798 \ud50c\ub7ab\ud3fc \uac04 \uac8c\uc784\uc774\ub098 \ub370\uc774\ud130 \uc774\uc804\uc744 \uc9c0\uc6d0\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uac8c\uc784 \ub370\uc774\ud130\ub294 \uc77c\ubc18\uc801\uc73c\ub85c \ub85c\uceec \ube0c\ub77c\uc6b0\uc800 \uce90\uc2dc\uc5d0 \uc800\uc7a5\ub418\uba70, \ud074\ub77c\uc6b0\ub4dc \uc11c\ubc84\uc5d0 \uc800\uc7a5\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ub530\ub77c\uc11c \uc7a5\uce58\ub098 \ube0c\ub77c\uc6b0\uc800\ub97c \ubcc0\uacbd\ud558\uba74 \uc774\uc804 \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc190\uc2e4\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \uc77c\ubd80 Bomb-it-7\uc758 \ub9ac\uba54\uc774\ud06c \ubc84\uc804\uc774\ub098 \ud3ec\ud305 \ubc84\uc804\uc740 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc81c\uacf5\ud560 \uc218 \uc788\uc9c0\ub9cc, \uad6c\uccb4\uc801\uc778 \uac8c\uc784 \ubc84\uc804\uacfc \ud50c\ub7ab\ud3fc\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4.\n"}, {"question": "Bomb-it-7\uc5d0 \uc228\uaca8\uc9c4 \uce90\ub9ad\ud130\ub098 \ub808\ubca8\uc774 \uc788\uc2b5\ub2c8\uae4c? \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ud2b8\ub9ac\uac70\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc77c\ubd80 Bomb-it-7 \ubc84\uc804\uc5d0\ub294 \uc228\uaca8\uc9c4 \uce90\ub9ad\ud130\ub098 \ub808\ubca8\uc774 \uc788\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc228\uaca8\uc9c4 \uc694\uc18c\ub97c \ud65c\uc131\ud654\ud558\ub294 \ubc29\ubc95\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \ub9e4\uc6b0 \uc740\ubc00\ud558\uba70, \ud50c\ub808\uc774\uc5b4\uac00 \ud2b9\uc815 \uc870\uc791\uc774\ub098 \uc870\uac74\uc744 \ucda9\uc871\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud2b9\uc815 \ub808\ubca8\uc5d0\uc11c \uc9c0\uc815\ub41c \uc218\uc758 \ud3ed\ud0c4\uc744 \uc5f0\uc18d\ud574 \uc124\uce58\ud558\uc9c0 \uc54a\uace0 \ud3ed\ubc1c\uc2dc\ud0a4\uba74 \uc228\uaca8\uc9c4 \ub808\ubca8\uc774 \ud65c\uc131\ud654\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ub294 \ud2b9\uc815 \ubaa8\ub4dc\uc5d0\uc11c \ud2b9\uc815 \uce90\ub9ad\ud130\ub85c \uac8c\uc784\uc744 \uc774\uae30\uba74 \uc228\uaca8\uc9c4 \uce90\ub9ad\ud130\ub97c \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: \ubb34\ucc28\ubcc4 \uacf5\uaca9 vs. \uc804\ub7b5\uc801 \uc228\uaca8\uc9c4 \uc694\uc18c \ud574\uc81c.\n"}]
[{"question": "\ud3ed\ud0c4 7\uc758 \ucd08\ubcf4 \ud50c\ub808\uc774\uc5b4\uac00 \uae30\ubcf8 \uc870\uc791\uc744 \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud3ed\ud0c4 7\uc744 \uc2dc\uc791\ud558\ub824\uba74 \uae30\ubcf8 \uc870\uc791\uc5d0 \uc775\uc219\ud574\uc838\uc57c \ud569\ub2c8\ub2e4. \ud654\uc0b4\ud45c \ud0a4 \ub610\ub294 WASD\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc774\ub3d9\ud558\uace0 \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud3ed\ud0c4\uc744 \uc124\uce58\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c\ub294 \uc9c0\ub3c4\ub97c \uc6c0\uc9c1\uc774\uace0 \ud3ed\ud0c4\uc744 \uc124\uce58\ud558\uc5ec \ube14\ub85d\uc744 \ud30c\uad34\ud558\ub294 \uc5f0\uc2b5\uc744 \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \ud29c\ud1a0\ub9ac\uc5bc \ubaa8\ub4dc\ub294 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \ud575\uc2ec \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\ub294 \ub370 \ub9e4\uc6b0 \uc88b\uc2b5\ub2c8\ub2e4."}, {"question": "\ud3ed\ud0c4 7\uc758 \ud544\uc218 \uac15\ud654 \uc544\uc774\ud15c\uc740 \ubb34\uc5c7\uc774\uba70, \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0a4\ub098\uc694?", "answer": "\ud3ed\ud0c4 7\uc758 \ud544\uc218 \uac15\ud654 \uc544\uc774\ud15c\uc5d0\ub294 \ub3d9\uc2dc\uc5d0 \uc124\uce58\ud560 \uc218 \uc788\ub294 \ud3ed\ud0c4\uc758 \uc218\ub97c \ub298\ub9ac\ub294 \ud3ed\ud0c4 \uc6a9\ub7c9\uacfc \ud3ed\ubc1c \ubc94\uc704\ub97c \ub113\ud788\ub294 \ubd88\uaf43 \uac15\ud654\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud3ed\ud0c4 \uc6a9\ub7c9 \uac15\ud654 \uc544\uc774\ud15c\uc744 \ud68d\ub4dd\ud558\uba74 \ud55c \ubc88\uc5d0 \ucd5c\ub300 \uc138 \uac1c\uc758 \ud3ed\ud0c4\uc744 \uc124\uce58\ud558\uc5ec \uc7a5\uc560\ubb3c\uc744 \uc81c\uac70\ud558\uace0 \uc801\uc744 \ubb3c\ub9ac\uce58\ub294 \uc804\ub7b5\uc801 \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uac15\ud654 \uc544\uc774\ud15c\uc740 \ub354 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc744 \uc9c4\ud589\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4."}, {"question": "\ud3ed\ud0c4 7\uc5d0\uc11c \ud3ed\ud0c4\uc744 \uc124\uce58\ud560 \ub54c \ud0c0\uc774\ubc0d\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \ud50c\ub808\uc774\uc5b4\ub294 \uc5b4\ub5bb\uac8c \ud0c0\uc774\ubc0d\uc744 \uc219\ub2ec\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud3ed\ud0c4 7\uc5d0\uc11c\ub294 \ud3ed\ud0c4\uc774 \ud3ed\ubc1c\ud558\uae30 \uc804\uc5d0 \uce74\uc6b4\ud2b8\ub2e4\uc6b4\uc774 \uc788\uae30 \ub54c\ubb38\uc5d0 \ud0c0\uc774\ubc0d\uc774 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \ud0c0\uc774\ubc0d \uc219\ub2ec\uc740 \uc801\uc758 \uc6c0\uc9c1\uc784\uacfc \ud3ed\ud0c4 \ud3ed\ubc1c \ubc94\uc704\ub97c \uc608\uce21\ud558\ub294 \uac83\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud63c\uc7a1\ud55c \uc9c0\uc5ed\uc5d0\uc11c \uc801\uc774 \ub2e4\uac00\uc624\ub294 \uc21c\uac04 \ud3ed\ud0c4\uc744 \uc124\uce58\ud558\uba74 \uc801\uc744 \uac00\ub450\uace0 \uc81c\uac70\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\uc804 \ub2e8\uacc4\uc5d0\uc11c \uc5f0\uc2b5\ud558\uc5ec \ud3ed\ud0c4 \ud0c0\uc774\uba38\uc640 \ud3ed\ubc1c \ubc18\uacbd\uc5d0 \ub300\ud55c \uac10\uac01\uc744 \ud0a4\uc6b0\uc2ed\uc2dc\uc624."}, {"question": "\uacbd\ud5d8\uc774 \ud48d\ubd80\ud55c \ud50c\ub808\uc774\uc5b4\ub294 \ud3ed\ud0c4 7 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c \uc5b4\ub5a4 \uc804\ub7b5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc2b9\ub9ac\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\uacbd\ud5d8\uc774 \ud48d\ubd80\ud55c \ud50c\ub808\uc774\uc5b4\ub294 \ud3ed\ud0c4 7 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c \ud3ed\ud0c4 \uc5f0\uc1c4\uc640 \uac15\ud654 \uc544\uc774\ud15c \uc81c\uc5b4\uc640 \uac19\uc740 \uace0\uae09 \uc804\ub7b5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc2b9\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud3ed\ud0c4 \uc5f0\uc1c4\ub294 \uc77c\ub828\uc758 \ud3ed\ud0c4\uc744 \uc124\uce58\ud558\uc5ec \ub354 \ud070 \ud3ed\ubc1c\uc744 \ub9cc\ub4dc\ub294 \uac83\uc744 \ub9d0\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud55c \uac1c\uc758 \ud3ed\ud0c4\uc744 \uc124\uce58\ud558\uace0 \ud0c0\uc774\uba38\ub97c \uae30\ub2e4\ub9b0 \ud6c4 \ub2e4\ub978 \ud3ed\ud0c4\uc744 \uc124\uce58\ud558\uc5ec \ud3ed\ubc1c \ubc18\uacbd\uc744 \ub113\ud790 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac15\ud654 \uc544\uc774\ud15c \uc81c\uc5b4\ub294 \uac8c\uc784 \ucd08\uae30\uc5d0 \uc18d\ub3c4\uc640 \ubd88\uaf43 \uac15\ud654\uc640 \uac19\uc740 \uc8fc\uc694 \uac15\ud654 \uc544\uc774\ud15c\uc744 \ud655\ubcf4\ud558\uc5ec \uc0c1\ub300\ubc29\ubcf4\ub2e4 \uc720\ub9ac\ud55c \uc704\uce58\ub97c \uc120\uc810\ud558\ub294 \uac83\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4."}, {"question": "\uac8c\uc784\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ud3ed\ud0c4 7\uc5d0\uc11c \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud558\uae30 \uc704\ud55c \ud575\uc2ec \uc694\uc18c\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud3ed\ud0c4 7\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \ube14\ub85d\uc744 \ud30c\uad34\ud558\uace0 \uc801\uc744 \ubb3c\ub9ac\uce58\uace0 \uac15\ud654 \uc544\uc774\ud15c\uc744 \uc218\uc9d1\ud558\ub294 \uac83\uc744 \ubcf4\uc0c1\ud569\ub2c8\ub2e4. \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud558\uae30 \uc704\ud55c \ud575\uc2ec \uc694\uc18c\ub294 \ub808\ubca8\uc744 \uc2e0\uc18d\ud558\uac8c \ud074\ub9ac\uc5b4\ud558\uace0 \ucf64\ubcf4 \ud3ed\ubc1c\uc744 \uc0ac\uc6a9\ud558\uace0 \ub192\uc740 \uccb4\ub825\uc744 \uc720\uc9c0\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud55c \ubc88\uc758 \ud3ed\ud0c4 \ud3ed\ubc1c\ub85c \uc5ec\ub7ec \ube14\ub85d\uc744 \ud30c\uad34\ud558\uba74 \ucf64\ubcf4 \uc810\uc218\uac00 \ubd80\uc5ec\ub418\uc5b4 \uc810\uc218\uac00 \ud06c\uac8c \uc99d\uac00\ud569\ub2c8\ub2e4."}, {"question": "\uacbd\uc7c1 \ud50c\ub808\uc774\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc774\uc810\uc744 \uc904 \uc218 \uc788\ub294 \ud3ed\ud0c4 7\uc758 \uc228\uaca8\uc9c4 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud3ed\ud0c4 7\uc758 \uc228\uaca8\uc9c4 \uba54\ucee4\ub2c8\uc998\uc5d0\ub294 \ud3ed\ud0c4 \uc801\uce35\uacfc \ubcbd \uaf3c\uc218\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ud3ed\ud0c4 \uc801\uce35\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \ud3ed\ud0c4\uc744 \uc11c\ub85c \uacb9\uccd0\uc11c \ub354 \uc9d1\uc911\uc801\uc778 \ud3ed\ubc1c\uc744 \uc77c\uc73c\ud0a4\ub294 \uac83\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4. \ubcbd \uaf3c\uc218\ub294 \ub54c\ub85c\ub294 \ud2b9\uc815 \ubcbd\uc744 \ud1b5\uacfc\ud560 \uc218 \uc788\uac8c \ud558\uc5ec \uc804\uc220\uc801 \uc774\uc810\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc740 \uba85\uc2dc\uc801\uc73c\ub85c \uac00\ub974\uccd0\uc9c0\uc9c0 \uc54a\uc9c0\ub9cc \uc2e4\ud5d8\uacfc \uc5f0\uc2b5\uc744 \ud1b5\ud574 \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud3ed\ud0c4 7\uc758 \ub808\ubca8 \ub514\uc790\uc778\uc740 \ud50c\ub808\uc774\uc5b4\uc758 \uc804\ub7b5\uacfc \uc758\uc0ac \uacb0\uc815\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "\ud3ed\ud0c4 7\uc758 \ub808\ubca8 \ub514\uc790\uc778\uc740 \ube14\ub85d, \uc801, \uac15\ud654 \uc544\uc774\ud15c\uc758 \ubc30\uce58\ub97c \ub2e4\uc591\ud654\ud558\uc5ec \uc804\ub7b5\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc881\uc740 \ubcf5\ub3c4\uac00 \uc788\ub294 \ub808\ubca8\uc5d0\uc11c\ub294 \uc815\ubc00\ud55c \ud3ed\ud0c4 \ubc30\uce58\uac00 \ud544\uc694\ud55c \ubc18\uba74, \ub113\uc740 \uacf5\uac04\uc5d0\uc11c\ub294 \ub354 \uc804\ub7b5\uc801\uc778 \uc774\ub3d9\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\ub294 \ub808\ubca8 \ub514\uc790\uc778\uc5d0 \ub530\ub77c \uc811\uadfc \ubc29\uc2dd\uc744 \ubc14\uafb8\uc5b4\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud2b9\uc815 \uac15\ud654 \uc544\uc774\ud15c\uc744 \uc6b0\uc120\uc2dc\ud558\uac70\ub098 \uc801 \uc81c\uac70\uc5d0 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4."}, {"question": "\ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ud3ed\ud0c4 7\uc744 \uc2e4\ud589\ud558\uae30 \uc704\ud55c \uae30\uc220\uc801 \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc774\uba70, \uc131\ub2a5\uc740 \uc5b4\ub5bb\uac8c \ub2ec\ub77c\uc9c0\ub098\uc694?", "answer": "\ud3ed\ud0c4 7\uc740 \ub300\ubd80\ubd84\uc758 \ud604\ub300 \uae30\uae30\uc5d0\uc11c \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ub418\ub294 \uc54c\ub9de\uc740 \uae30\uc220\uc801 \uc694\uad6c \uc0ac\ud56d\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. PC\uc758 \uacbd\uc6b0 \ucd5c\uc18c 2GB RAM\uacfc \ub4c0\uc5bc \ucf54\uc5b4 \ud504\ub85c\uc138\uc11c\uac00 \uad8c\uc7a5\ub429\ub2c8\ub2e4. \ubaa8\ubc14\uc77c\uc758 \uacbd\uc6b0 \ucd5c\uc18c 1GB RAM\uacfc Android 5.0 \ub610\ub294 iOS 9.0\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc131\ub2a5\uc740 \uc57d\uac04 \ub2e4\ub974\uac8c \ub098\ud0c0\ub098\ub294\ub370, PC\ub294 \ub354 \ub192\uc740 \ud504\ub808\uc784 \uc18d\ub3c4\ub97c \uc81c\uacf5\ud558\uace0 \ubaa8\ubc14\uc77c \uae30\uae30\ub294 \ud734\ub300\uc131\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774\uac00 \uc9c0\uc6d0\ub418\uc5b4 \uc6d0\ud65c\ud55c \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}, {"question": "\ud3ed\ud0c4 7\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 \uc228\uaca8\uc9c4 \ub808\ubca8\uc774\ub098 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \uc5b4\ub5bb\uac8c \ud574\uc81c\ud560 \uc218 \uc788\uc73c\uba70, \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud3ed\ud0c4 7\uc758 \uc228\uaca8\uc9c4 \ub808\ubca8\uc740 \ubaa8\ub4e0 \ub808\ubca8\uc744 \uc644\ubcbd\ud55c \uc810\uc218\ub85c \uc644\ub8cc\ud558\uac70\ub098 \ud2b9\uc815 \ub2e8\uacc4 \ub0b4\uc5d0 \uc228\uaca8\uc9c4 \uc5f4\uc1e0\ub97c \ucc3e\ub294 \uac83\uacfc \uac19\uc740 \ud2b9\uc815 \ub9c8\uc77c\uc2a4\ud1a4\uc744 \ub2ec\uc131\ud558\uc5ec \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 5\ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c \uc228\uaca8\uc9c4 \uc5f4\uc1e0\ub97c \ucc3e\uc73c\uba74 \uace0\uc720\ud55c \uacfc\uc81c\uc640 \ubcf4\uc0c1\uc774 \uc788\ub294 \ubcf4\ub108\uc2a4 \ub808\ubca8\uc774 \ud574\uc81c\ub429\ub2c8\ub2e4. \uc9c0\ub3c4\uc758 \ubaa8\ub4e0 \uad6c\uc11d\uc744 \ud0d0\ud5d8\ud558\uace0 \ub2e4\uc591\ud55c \uc804\ub7b5\uc744 \uc2e4\ud5d8\ud558\uba74 \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uc744 \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 \ud3ed\ud0c4 7\uc5d0\uc11c \ud568\uc815\uc5d0 \ube60\uc9c0\uc9c0 \uc54a\uace0 \ud3ed\ud0c4 \uc7ac\uace0\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud3ed\ud0c4 7\uc5d0\uc11c \ud3ed\ud0c4 \uc7ac\uace0\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \ubc29\ubc95\uc740 \uc804\ub7b5\uc801\uc778 \ubc30\uce58\uc640 \ud0c0\uc774\ubc0d\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \ud56d\uc0c1 \ud0c8\ucd9c \uacbd\ub85c\ub97c \ud655\ubcf4\ud558\uae30 \uc704\ud574 \uc608\ube44 \ud3ed\ud0c4\uc744 \ud558\ub098 \uc720\uc9c0\ud558\uc138\uc694. \ub2e8\uacc4 2: \ud3ed\ud0c4\uc744 \uc124\uce58\ud558\uc5ec \ub300\ubbf8\uc9c0\ub97c \uadf9\ub300\ud654\ud558\uace0 \ub3d9\uc2dc\uc5d0 \uacbd\ub85c\ub97c \ucc28\ub2e8\ud558\uc9c0 \ub9c8\uc138\uc694. \ub2e8\uacc4 3: \uc18d\ub3c4\uc640 \uac19\uc740 \uac15\ud654 \uc544\uc774\ud15c\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud3ed\ubc1c\uc5d0\uc11c \ube60\ub974\uac8c \uc774\ub3d9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc881\uc740 \uacf5\uac04\uc5d0\uc11c \ud3ed\ud0c4\uc744 \uc124\uce58\ud558\uace0 \uc989\uc2dc \uc548\uc804\ud55c \uc9c0\uc5ed\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec \ud568\uc815\uc5d0 \ube60\uc9c0\ub294 \uac83\uc744 \ud53c\ud558\uc2ed\uc2dc\uc624."}]
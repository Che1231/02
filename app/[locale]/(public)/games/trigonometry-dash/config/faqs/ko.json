[{"question": "\ucd08\uc2ec\uc790\ub97c \uc704\ud55c \uc0bc\uac01\ud568\uc218 \ub300\uc2dc\uc758 \uae30\ubcf8 \uc810\ud504\ub294 \uc5b4\ub5bb\uac8c \uc218\ud589\ud569\ub2c8\uae4c?", "answer": "\uc0bc\uac01\ud568\uc218 \ub300\uc2dc\uc5d0\uc11c \uae30\ubcf8 \uc810\ud504\ub294 \ucd08\uae30 \ub808\ubca8\uc744 \ud0d0\uc0c9\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc810\ud504\ud558\ub824\uba74 \ud654\uba74\uc744 \ud55c \ubc88 \ud0ed\ud558\uba74 \ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub808\ubca8\uc778 '\uc0ac\uc778\ud30c'\uc5d0\uc11c\ub294 \uc801\uc808\ud55c \uc2dc\uc810\uc5d0 \ud0ed\ud558\uc5ec \uc791\uc740 \uc7a5\uc560\ubb3c\uc744 \ub6f0\uc5b4\ub118\uc5b4\uc57c \ud569\ub2c8\ub2e4. \ud0c0\uc774\ubc0d\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \ub108\ubb34 \uc77c\ucc0d \ub610\ub294 \ub108\ubb34 \ub2a6\uac8c \ud0ed\ud558\uba74 \uc7a5\uc560\ubb3c\uc5d0 \ubd80\ub52a\ud799\ub2c8\ub2e4. \ub9ac\ub4ec\uac10\uc744 \uc775\ud788\uae30 \uc704\ud574 \ud29c\ud1a0\ub9ac\uc5bc \uc139\uc158\uc5d0\uc11c \uc5f0\uc2b5\ud558\uc2ed\uc2dc\uc624. (\ube44\uc720 \uc124\uba85: \uc904\ub118\uae30\ub97c \ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ub118\uc5b4\uc9c0\uc9c0 \uc54a\uc73c\ub824\uba74 \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uc644\ubcbd\ud558\uac8c \ub9de\ucdb0\uc57c \ud569\ub2c8\ub2e4.)"}, {"question": "\uc0bc\uac01\ud568\uc218 \ub300\uc2dc\uc5d0\uc11c '\uc0ac\uc778' \ubaa8\ub4dc\uc640 '\ucf54\uc0ac\uc778' \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc0bc\uac01\ud568\uc218 \ub300\uc2dc\uc5d0\uc11c '\uc0ac\uc778' \ubc0f '\ucf54\uc0ac\uc778' \ubaa8\ub4dc\ub294 \uc11c\ub85c \ub2e4\ub978 \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. '\uc0ac\uc778' \ubaa8\ub4dc\ub294 \ubd80\ub4dc\ub7ec\uc6b4 \ud30c\ub3d9\uacfc \uac19\uc740 \uc6c0\uc9c1\uc784\uc5d0 \ucd08\uc810\uc744 \ub9de\ucd94\uc5b4 \ucd08\uc2ec\uc790\uac00 \ud0d0\uc0c9\ud558\uae30 \uc27d\uc2b5\ub2c8\ub2e4. \ubc18\uba74 '\ucf54\uc0ac\uc778' \ubaa8\ub4dc\ub294 \ub354 \ub0a0\uce74\ub85c\uc6b4 \ud68c\uc804\uacfc \ub354 \ubcf5\uc7a1\ud55c \ud328\ud134\uc744 \ub3c4\uc785\ud558\uc5ec \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc801\ud569\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ucf54\uc0ac\uc778' \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uacfc \ube60\ub978 \ubc18\uc751\uc774 \ud544\uc694\ud55c \uc7a5\uc560\ubb3c\uc744 \ub9cc\ub0a0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. (\uc124\uc815 \ube44\uad50\ud45c: \uc0ac\uc778 \ubaa8\ub4dc - \ubd80\ub4dc\ub7fd\uace0 \ucd08\uc2ec\uc790 \uce5c\ud654\uc801; \ucf54\uc0ac\uc778 \ubaa8\ub4dc - \ub0a0\uce74\ub85c\uc6b4 \ud68c\uc804, \uace0\uae09.)"}, {"question": "\uc0bc\uac01\ud568\uc218 \ub300\uc2dc\uc5d0\uc11c \ud654\uba74\uc744 \ud0ed\ud588\ub294\ub370\ub3c4 \uce90\ub9ad\ud130\uac00 \ub54c\ub54c\ub85c \uc810\ud504\ub97c \ub193\uce58\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc0bc\uac01\ud568\uc218 \ub300\uc2dc\uc5d0\uc11c \uc810\ud504\ub97c \ub193\uce58\ub294 \uac83\uc740 \uc9c0\uc5f0 \ub610\ub294 \ud0c0\uc774\ubc0d \ubb38\uc81c \ub54c\ubb38\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubc31\uadf8\ub77c\uc6b4\ub4dc \uc571\uc744 \uc885\ub8cc\ud558\uace0 \ud654\uba74 \ubc1d\uae30\ub97c \uc904\uc5ec \uae30\uae30\ub97c \uac8c\uc784\uc5d0 \ucd5c\uc801\ud654\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \ub610\ud55c \uac8c\uc784 \uc18c\ud504\ud2b8\uc6e8\uc5b4 \uc5c5\ub370\uc774\ud2b8\ub97c \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\uc811\uc120 \ud2b8\ub808\uc77c' \ub808\ubca8\uc5d0\uc11c\ub294 \ud2c8\uc0c8\uc5d0 \ube60\uc9c0\uc9c0 \uc54a\ub3c4\ub85d \uc815\ud655\ud55c \uc810\ud504\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. (\ub2e4\uc591\ud55c \ud574\uacb0\ucc45 \ube44\uad50: \ud574\uacb0\ucc45 1 - \uae30\uae30 \ucd5c\uc801\ud654; \ud574\uacb0\ucc45 2 - \uac8c\uc784 \uc5c5\ub370\uc774\ud2b8; \ud574\uacb0\ucc45 3 - \ud0c0\uc774\ubc0d \uc5f0\uc2b5.)"}, {"question": "100\uc2dc\uac04 \uc774\uc0c1 \uc0bc\uac01\ud568\uc218 \ub300\uc2dc\ub97c \ud50c\ub808\uc774\ud55c \ud6c4 '\uc811\uc120' \ub808\ubca8\uc744 \ub9c8\uc2a4\ud130\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc0bc\uac01\ud568\uc218 \ub300\uc2dc\uc5d0\uc11c '\uc811\uc120' \ub808\ubca8\uc744 \ub9c8\uc2a4\ud130\ud558\ub824\uba74 \uace0\uae09 \uc804\ub7b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \uc7a5\uc560\ubb3c \ud328\ud134\uc744 \uc5f0\uad6c\ud558\uace0 \ud0c0\uc774\ubc0d\uc744 \uc554\uae30\ud569\ub2c8\ub2e4. STEP2: \ub808\ubca8\uc744 \ubc18\ubcf5\uc801\uc73c\ub85c \uc5f0\uc2b5\ud558\uc5ec \uadfc\uc721 \uae30\uc5b5\uc744 \ub9cc\ub4ed\ub2c8\ub2e4. STEP3: \uc5b4\ub824\uc6b4 \uad6c\uac04\uc744 \uc6b0\ud68c\ud558\uae30 \uc704\ud574 \ud30c\uc6cc\uc5c5\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc18d\ub3c4 \ubd80\uc2a4\ud2b8' \ud30c\uc6cc\uc5c5\uc740 \uc881\uc740 \uacf5\uac04\uc744 \uc774\ub3d9\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. (\ud750\ub984\ub3c4: \uc5f0\uad6c \u2192 \uc5f0\uc2b5 \u2192 \ud30c\uc6cc\uc5c5 \uc0ac\uc6a9 \u2192 \ub808\ubca8 \ub9c8\uc2a4\ud130.)"}, {"question": "'\ud604' \ub808\ubca8\uc5d0\uc11c \uc0bc\uac01\ud568\uc218 \ub300\uc2dc\uc5d0\uc11c \uc0ac\uc6a9\ud560 \ucd5c\uace0\uc758 \ud30c\uc6cc\uc5c5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "'\ud604' \ub808\ubca8\uc5d0\uc11c \uc0bc\uac01\ud568\uc218 \ub300\uc2dc\uc5d0\uc11c \ucd5c\uace0\uc758 \ud30c\uc6cc\uc5c5\uc740 '\ubc29\ud328'\uc640 '\ub354\ube14 \uc810\ud504'\uc785\ub2c8\ub2e4. '\ubc29\ud328'\ub294 \ud55c \ubc88\uc758 \uacf5\uaca9\uc73c\ub85c\ubd80\ud130 \ubcf4\ud638\ud574\uc8fc\uace0, '\ub354\ube14 \uc810\ud504'\ub294 \ub192\uc740 \uc7a5\uc560\ubb3c\uc744 \uc6b0\ud68c\ud560 \uc218 \uc788\uac8c \ud574\uc90d\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 '\ub354\ube14 \uc810\ud504'\ub97c \uc0ac\uc6a9\ud558\uba74 \ub808\ubca8 \uc911\uac04\uc758 \uc77c\ub828\uc758 \ub192\uc740 \ubcbd\uc744 \ub118\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. (\uc124\uc815 \ube44\uad50\ud45c: \ubc29\ud328 - \ubcf4\ud638; \ub354\ube14 \uc810\ud504 - \ub192\uc740 \uc7a5\uc560\ubb3c \uc6b0\ud68c.)"}, {"question": "\uc0bc\uac01\ud568\uc218 \ub300\uc2dc\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \uc810\uc218\ub97c \uadf9\ub300\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc0bc\uac01\ud568\uc218 \ub300\uc2dc\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc774\ub3d9 \uac70\ub9ac, \uc218\uc9d1\ud55c \ucf54\uc778 \ubc0f \uc0ac\uc6a9\ud55c \ud30c\uc6cc\uc5c5\uc744 \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. \uc810\uc218\ub97c \uadf9\ub300\ud654\ud558\ub824\uba74 \ubaa8\ub4e0 \ucf54\uc778\uc744 \uc218\uc9d1\ud558\uace0 \ud30c\uc6cc\uc5c5\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\ucf54\uc2dc\ucee8\ud2b8' \ub808\ubca8\uc5d0\uc11c \ud55c \ubc88\uc758 \uc2e4\ud589\uc73c\ub85c \ubaa8\ub4e0 \ucf54\uc778\uc744 \ubaa8\uc73c\uba74 \uc810\uc218\uac00 \ud06c\uac8c \ud5a5\uc0c1\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. (\ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: \uc804\ub7b5 1 - \ucf54\uc778 \uc218\uc9d1; \uc804\ub7b5 2 - \ud30c\uc6cc\uc5c5 \uc0ac\uc6a9; \uc804\ub7b5 3 - \ub808\ubca8 \uc2e0\uc18d \uc644\ub8cc.)"}, {"question": "\uc0bc\uac01\ud568\uc218 \ub300\uc2dc\uc758 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc5d0\uc11c '\ub77c\ub514\uc548'\uc758 \uc911\uc694\uc131\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc0bc\uac01\ud568\uc218 \ub300\uc2dc\uc5d0\uc11c '\ub77c\ub514\uc548'\uc740 \uce90\ub9ad\ud130\uc758 \uc6c0\uc9c1\uc784\uacfc \ud68c\uc804\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \ud575\uc2ec \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc785\ub2c8\ub2e4. \uac01 \ub77c\ub514\uc548\uc740 \ud2b9\uc815 \uac01\ub3c4\uc5d0 \ud574\ub2f9\ud558\uba70 \uce90\ub9ad\ud130\uac00 \uc7a5\uc560\ubb3c\uc744 \ud0d0\uc0c9\ud558\ub294 \ubc29\uc2dd\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ubc18\uacbd' \ub808\ubca8\uc5d0\uc11c \ub77c\ub514\uc548\uc744 \uc774\ud574\ud558\uba74 \uc774\ub3d9\ud558\ub294 \ud50c\ub7ab\ud3fc\uc758 \uacbd\ub85c\ub97c \uc608\uce21\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. (\ube44\uc720 \uc124\uba85: \ub77c\ub514\uc548\uc740 \uc2dc\uacc4\uc758 \ubc14\ub298\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uac01 \uc704\uce58\ub294 \ud2b9\uc815 \ubc29\ud5a5\uc744 \ub098\ud0c0\ub0c5\ub2c8\ub2e4.)"}, {"question": "\uc774\uc804 \uae30\uae30\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \uae30\uae30\ub85c \uc0bc\uac01\ud568\uc218 \ub300\uc2dc\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc0bc\uac01\ud568\uc218 \ub300\uc2dc\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub824\uba74 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. STEP1: \uc774\uc804 \uae30\uae30\uc5d0\uc11c \uc124\uc815 \uba54\ub274\ub85c \uc774\ub3d9\ud558\uace0 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4. STEP2: \uc0c8 \uae30\uae30\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. STEP3: \ud074\ub77c\uc6b0\ub4dc\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc774\uc804 \uae30\uae30\uc5d0\uc11c '\uc0ac\uc778\ud30c' \ub808\ubca8\uc744 \uc644\ub8cc\ud588\ub2e4\uba74 \uc0c8 \uae30\uae30\uc5d0\uc11c\ub3c4 \uc644\ub8cc\ub41c \uac83\uc73c\ub85c \ud45c\uc2dc\ub429\ub2c8\ub2e4. (\ud750\ub984\ub3c4: \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \ud65c\uc131\ud654 \u2192 \ub85c\uadf8\uc778 \u2192 \uc9c4\ud589 \uc0c1\ud669 \ub3d9\uae30\ud654.)"}, {"question": "\uc0bc\uac01\ud568\uc218 \ub300\uc2dc\uc758 \uc228\uaca8\uc9c4 \uc131\ucde8\ub294 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc0bc\uac01\ud568\uc218 \ub300\uc2dc\uc5d0\ub294 \ud2b9\uc815 \ub3d9\uc791\uc744 \ud1b5\ud574 \uc7a0\uae08 \ud574\uc81c\ud574\uc57c \ud558\ub294 \uc228\uaca8\uc9c4 \uc131\ucde8\uac00 \uc5ec\ub7ec \uac00\uc9c0 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc644\ubcbd\ud55c \ud30c\ub3d9' \uc131\ucde8\ub294 \uc810\ud504\ub97c \ub193\uce58\uc9c0 \uc54a\uace0 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uba74 \uc7a0\uae08 \ud574\uc81c\ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc131\ucde8\ub97c \ucc3e\uc73c\ub824\uba74 \ub2e4\ub978 \ub808\ubca8\uc744 \ud0d0\uc0c9\ud558\uace0 \ub2e4\uc591\ud55c \uc804\ub7b5\uc744 \uc2dc\ub3c4\ud558\uc2ed\uc2dc\uc624. (\ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: \uc804\ub7b5 1 - \ub808\ubca8 \uc644\ubcbd \uc644\ub8cc; \uc804\ub7b5 2 - \uc228\uaca8\uc9c4 \uc601\uc5ed \ud0d0\uc0c9; \uc804\ub7b5 3 - \ud2b9\uc815 \ud30c\uc6cc\uc5c5 \uc0ac\uc6a9.)"}, {"question": "\uc0bc\uac01\ud568\uc218 \ub300\uc2dc\uc758 \ube44\ubc00 \ub808\ubca8\uc744 \uc5b4\ub5bb\uac8c \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc0bc\uac01\ud568\uc218 \ub300\uc2dc\uc758 \ube44\ubc00 \ub808\ubca8\uc744 \ubc1c\uacac\ud558\ub824\uba74 \ub2e4\ub978 \ub808\ubca8\uc5d0 \ud769\uc5b4\uc838 \uc788\ub294 \ubaa8\ub4e0 \uc228\uaca8\uc9c4 \uc5f4\uc1e0\ub97c \ubaa8\uc544\uc57c \ud569\ub2c8\ub2e4. \ubaa8\ub4e0 \uc5f4\uc1e0\ub97c \ubaa8\uc73c\uba74 '\ubbf8\uc2a4\ud130\ub9ac \uac01\ub3c4'\ub77c\ub294 \uc0c8\ub85c\uc6b4 \ub808\ubca8\uc774 \uc7a0\uae08 \ud574\uc81c\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 '\ucf54\uc0ac\uc778' \ub808\ubca8\uc5d0\uc11c\ub294 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uc774 \ud544\uc694\ud55c \uc774\ub3d9 \ud50c\ub7ab\ud3fc \ub4a4\uc5d0 \uc228\uaca8\uc9c4 \ud55c \uac1c\uc758 \uc5f4\uc1e0\uac00 \uc788\uc2b5\ub2c8\ub2e4. (\ube44\uc720 \uc124\uba85: \uc5f4\uc1e0\ub294 \ud37c\uc990 \uc870\uac01\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ubaa8\ub4e0 \uc870\uac01\uc744 \ubaa8\uc73c\uba74 \uc644\uc131\ub41c \uadf8\ub9bc\uc774 \ub4dc\ub7ec\ub0a9\ub2c8\ub2e4.)"}]
[{"question": "\u521d\u5b66\u8005\u5982\u4f55\u5728\u4e09\u89d2\u51fd\u6570\u8d5b\u8dd1\u6e38\u620f\u4e2d\u8fdb\u884c\u57fa\u672c\u8df3\u8dc3\uff1f", "answer": "\u5728\u4e09\u89d2\u51fd\u6570\u8d5b\u8dd1\u6e38\u620f\u4e2d\uff0c\u8fdb\u884c\u57fa\u672c\u8df3\u8dc3\u5bf9\u4e8e\u521d\u5b66\u8005\u6765\u8bf4\uff0c\u987a\u5229\u901a\u8fc7\u6700\u521d\u7684\u5173\u5361\u81f3\u5173\u91cd\u8981\u3002\u8981\u8df3\u8dc3\uff0c\u53ea\u9700\u8f7b\u70b9\u5c4f\u5e55\u4e00\u6b21\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u4e2a\u5173\u5361\u201c\u6b63\u5f26\u6ce2\u201d\u4e2d\uff0c\u60a8\u9700\u8981\u5728\u9002\u5f53\u7684\u65f6\u673a\u8f7b\u70b9\u5c4f\u5e55\u6765\u8df3\u8fc7\u5c0f\u7684\u969c\u788d\u7269\u3002\u65f6\u673a\u81f3\u5173\u91cd\u8981\uff1b\u8f7b\u70b9\u592a\u65e9\u6216\u592a\u665a\uff0c\u60a8\u5c31\u4f1a\u649e\u5230\u969c\u788d\u7269\u3002\u5728\u6559\u7a0b\u90e8\u5206\u7ec3\u4e60\uff0c\u624d\u80fd\u638c\u63e1\u8282\u594f\u3002 (\u6bd4\u55bb\u8bf4\u660e: \u5c06\u5176\u60f3\u8c61\u6210\u8df3\u7ef3\uff1b\u60a8\u9700\u8981\u5b8c\u7f8e\u5730\u63a7\u5236\u8df3\u8dc3\u65f6\u95f4\u4ee5\u907f\u514d\u7eca\u5012\u3002)"}, {"question": "\u4e09\u89d2\u51fd\u6570\u8d5b\u8dd1\u6e38\u620f\u4e2d\u7684\u201c\u6b63\u5f26\u201d\u548c\u201c\u4f59\u5f26\u201d\u6a21\u5f0f\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u5728\u4e09\u89d2\u51fd\u6570\u8d5b\u8dd1\u6e38\u620f\u4e2d\uff0c\u201c\u6b63\u5f26\u201d\u548c\u201c\u4f59\u5f26\u201d\u6a21\u5f0f\u63d0\u4f9b\u4e0d\u540c\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u201c\u6b63\u5f26\u201d\u6a21\u5f0f\u4fa7\u91cd\u4e8e\u5e73\u6ed1\u7684\u6ce2\u6d6a\u72b6\u52a8\u4f5c\uff0c\u8ba9\u521d\u5b66\u8005\u66f4\u5bb9\u6613\u5bfc\u822a\u3002\u201c\u4f59\u5f26\u201d\u6a21\u5f0f\u5219\u5f15\u5165\u4e86\u66f4\u6025\u8f6c\u5f2f\u548c\u66f4\u590d\u6742\u7684\u6a21\u5f0f\uff0c\u9002\u5408\u9ad8\u7ea7\u73a9\u5bb6\u3002\u4f8b\u5982\uff0c\u5728\u201c\u4f59\u5f26\u201d\u6a21\u5f0f\u4e2d\uff0c\u60a8\u53ef\u80fd\u4f1a\u9047\u5230\u9700\u8981\u7cbe\u786e\u65f6\u673a\u548c\u5feb\u901f\u53cd\u5e94\u624d\u80fd\u901a\u8fc7\u7684\u969c\u788d\u7269\u3002(\u914d\u7f6e\u5bf9\u7167\u8868: \u6b63\u5f26\u6a21\u5f0f - \u5e73\u6ed1\uff0c\u9002\u5408\u521d\u5b66\u8005\uff1b\u4f59\u5f26\u6a21\u5f0f - \u6025\u8f6c\u5f2f\uff0c\u9002\u5408\u9ad8\u7ea7\u73a9\u5bb6\u3002)"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u7684\u89d2\u8272\u5728\u4e09\u89d2\u51fd\u6570\u8d5b\u8dd1\u6e38\u620f\u4e2d\u5373\u4f7f\u6211\u70b9\u51fb\u4e86\u5c4f\u5e55\u6709\u65f6\u4e5f\u4f1a\u9519\u8fc7\u8df3\u8dc3\uff1f", "answer": "\u5728\u4e09\u89d2\u51fd\u6570\u8d5b\u8dd1\u6e38\u620f\u4e2d\uff0c\u9519\u8fc7\u8df3\u8dc3\u53ef\u80fd\u662f\u7531\u4e8e\u5ef6\u8fdf\u6216\u65f6\u673a\u95ee\u9898\u3002\u8bf7\u786e\u4fdd\u60a8\u7684\u8bbe\u5907\u9488\u5bf9\u6e38\u620f\u8fdb\u884c\u4e86\u4f18\u5316\uff0c\u65b9\u6cd5\u662f\u5173\u95ed\u540e\u53f0\u5e94\u7528\u7a0b\u5e8f\u5e76\u964d\u4f4e\u5c4f\u5e55\u4eae\u5ea6\u3002\u6b64\u5916\uff0c\u68c0\u67e5\u6e38\u620f\u662f\u5426\u6709\u4efb\u4f55\u8f6f\u4ef6\u66f4\u65b0\u3002\u4f8b\u5982\uff0c\u5728\u201c\u6b63\u5207\u8f68\u8ff9\u201d\u5173\u5361\u4e2d\uff0c\u7cbe\u786e\u7684\u8df3\u8dc3\u624d\u80fd\u907f\u514d\u6389\u5165\u7a7a\u9699\u3002(\u591a\u65b9\u6848\u5bf9\u6bd4: \u65b9\u6848 1 - \u4f18\u5316\u8bbe\u5907\uff1b\u65b9\u6848 2 - \u66f4\u65b0\u6e38\u620f\uff1b\u65b9\u6848 3 - \u7ec3\u4e60\u65f6\u673a\u3002)"}, {"question": "\u7ecf\u8fc7 100 \u5c0f\u65f6\u7684\u6e38\u620f\u540e\uff0c\u5982\u4f55\u638c\u63e1\u4e09\u89d2\u51fd\u6570\u8d5b\u8dd1\u6e38\u620f\u4e2d\u7684\u201c\u6b63\u5207\u201d\u5173\u5361\uff1f", "answer": "\u8981\u638c\u63e1\u4e09\u89d2\u51fd\u6570\u8d5b\u8dd1\u6e38\u620f\u4e2d\u7684\u201c\u6b63\u5207\u201d\u5173\u5361\uff0c\u9700\u8981\u9ad8\u7ea7\u7b56\u7565\u3002\u6b65\u9aa4 1\uff1a\u7814\u7a76\u969c\u788d\u7269\u6a21\u5f0f\u5e76\u8bb0\u4f4f\u5b83\u4eec\u7684\u65f6\u673a\u3002\u6b65\u9aa4 2\uff1a\u91cd\u590d\u7ec3\u4e60\u5173\u5361\u4ee5\u5efa\u7acb\u808c\u8089\u8bb0\u5fc6\u3002\u6b65\u9aa4 3\uff1a\u6218\u7565\u6027\u5730\u4f7f\u7528\u9053\u5177\u6765\u7ed5\u8fc7\u56f0\u96be\u533a\u57df\u3002\u4f8b\u5982\uff0c\u201c\u52a0\u901f\u201d\u9053\u5177\u53ef\u4ee5\u5e2e\u52a9\u60a8\u901a\u8fc7\u72ed\u7a84\u7684\u7a7a\u95f4\u3002(\u6d41\u7a0b\u56fe\u89e3: \u7814\u7a76 \u2192 \u7ec3\u4e60 \u2192 \u4f7f\u7528\u9053\u5177 \u2192 \u7cbe\u901a\u5173\u5361\u3002)"}, {"question": "\u5728\u4e09\u89d2\u51fd\u6570\u8d5b\u8dd1\u6e38\u620f\u4e2d\u7684\u201c\u6b63\u5272\u201d\u5173\u5361\u4e2d\uff0c\u54ea\u4e9b\u9053\u5177\u6700\u597d\u7528\uff1f", "answer": "\u5728\u4e09\u89d2\u51fd\u6570\u8d5b\u8dd1\u6e38\u620f\u4e2d\u7684\u201c\u6b63\u5272\u201d\u5173\u5361\u4e2d\uff0c\u6700\u597d\u7684\u9053\u5177\u662f\u201c\u62a4\u76fe\u201d\u548c\u201c\u53cc\u8df3\u201d\u3002\u201c\u62a4\u76fe\u201d\u53ef\u4ee5\u4fdd\u62a4\u60a8\u514d\u53d7\u4e00\u6b21\u653b\u51fb\uff0c\u201c\u53cc\u8df3\u201d\u53ef\u4ee5\u5e2e\u52a9\u60a8\u8df3\u8fc7\u9ad8\u969c\u788d\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u201c\u53cc\u8df3\u201d\u53ef\u4ee5\u5e2e\u52a9\u60a8\u6e05\u9664\u5173\u5361\u4e2d\u95f4\u4e00\u7cfb\u5217\u7684\u9ad8\u5899\u3002(\u914d\u7f6e\u5bf9\u7167\u8868: \u62a4\u76fe - \u9632\u5fa1\uff1b\u53cc\u8df3 - \u8df3\u8fc7\u9ad8\u969c\u788d\u3002)"}, {"question": "\u4e09\u89d2\u51fd\u6570\u8d5b\u8dd1\u6e38\u620f\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u5927\u5316\u6211\u7684\u5f97\u5206\uff1f", "answer": "\u4e09\u89d2\u51fd\u6570\u8d5b\u8dd1\u6e38\u620f\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u884c\u8fdb\u8ddd\u79bb\u3001\u6536\u96c6\u7684\u786c\u5e01\u548c\u4f7f\u7528\u7684\u9053\u5177\u3002\u8981\u6700\u5927\u5316\u5f97\u5206\uff0c\u8bf7\u4e13\u6ce8\u4e8e\u6536\u96c6\u6240\u6709\u786c\u5e01\u5e76\u6709\u6548\u5730\u4f7f\u7528\u9053\u5177\u3002\u4f8b\u5982\uff0c\u5728\u201c\u4f59\u5272\u201d\u5173\u5361\u4e2d\uff0c\u5728\u5355\u6b21\u8fd0\u884c\u4e2d\u6536\u96c6\u6240\u6709\u786c\u5e01\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u60a8\u7684\u5f97\u5206\u3002(\u591a\u65b9\u6848\u5bf9\u6bd4: \u7b56\u7565 1 - \u6536\u96c6\u786c\u5e01\uff1b\u7b56\u7565 2 - \u4f7f\u7528\u9053\u5177\uff1b\u7b56\u7565 3 - \u5feb\u901f\u5b8c\u6210\u5173\u5361\u3002)"}, {"question": "\u201c\u5f27\u5ea6\u201d\u5728\u4e09\u89d2\u51fd\u6570\u8d5b\u8dd1\u6e38\u620f\u7684\u6e38\u620f\u673a\u5236\u4e2d\u6709\u4ec0\u4e48\u610f\u4e49\uff1f", "answer": "\u5728\u4e09\u89d2\u51fd\u6570\u8d5b\u8dd1\u6e38\u620f\u4e2d\uff0c\u201c\u5f27\u5ea6\u201d\u662f\u5173\u952e\u7684\u6e38\u620f\u673a\u5236\uff0c\u5b83\u4f1a\u5f71\u54cd\u89d2\u8272\u7684\u52a8\u4f5c\u548c\u65cb\u8f6c\u3002\u6bcf\u4e2a\u5f27\u5ea6\u5bf9\u5e94\u4e00\u4e2a\u7279\u5b9a\u7684\u89d2\u5ea6\uff0c\u5f71\u54cd\u7740\u89d2\u8272\u5982\u4f55\u901a\u8fc7\u969c\u788d\u7269\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5f84\u5411\u201d\u5173\u5361\u4e2d\uff0c\u7406\u89e3\u5f27\u5ea6\u6709\u52a9\u4e8e\u9884\u6d4b\u79fb\u52a8\u5e73\u53f0\u7684\u8def\u5f84\u3002(\u6bd4\u55bb\u8bf4\u660e: \u5c06\u5f27\u5ea6\u60f3\u8c61\u6210\u65f6\u949f\u7684\u6307\u9488\uff1b\u6bcf\u4e2a\u4f4d\u7f6e\u90fd\u8868\u793a\u7279\u5b9a\u7684\u65b9\u5411\u3002)"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684\u4e09\u89d2\u51fd\u6570\u8d5b\u8dd1\u6e38\u620f\u8fdb\u5ea6\u4ece\u65e7\u8bbe\u5907\u8f6c\u79fb\u5230\u65b0\u8bbe\u5907\uff1f", "answer": "\u8981\u8f6c\u79fb\u60a8\u7684\u4e09\u89d2\u51fd\u6570\u8d5b\u8dd1\u6e38\u620f\u8fdb\u5ea6\uff0c\u8bf7\u4f7f\u7528\u4e91\u4fdd\u5b58\u529f\u80fd\u3002\u6b65\u9aa4 1\uff1a\u5728\u65e7\u8bbe\u5907\u4e0a\uff0c\u8f6c\u5230\u8bbe\u7f6e\u83dc\u5355\u5e76\u542f\u7528\u4e91\u4fdd\u5b58\u3002\u6b65\u9aa4 2\uff1a\u5728\u65b0\u8bbe\u5907\u4e0a\u4f7f\u7528\u76f8\u540c\u7684\u5e10\u6237\u767b\u5f55\u3002\u6b65\u9aa4 3\uff1a\u4ece\u4e91\u7aef\u540c\u6b65\u60a8\u7684\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5df2\u5728\u65e7\u8bbe\u5907\u4e0a\u5b8c\u6210\u4e86\u201c\u6b63\u5f26\u6ce2\u201d\u5173\u5361\uff0c\u5b83\u5c06\u5728\u65b0\u8bbe\u5907\u4e0a\u6807\u8bb0\u4e3a\u5df2\u5b8c\u6210\u3002(\u6d41\u7a0b\u56fe\u89e3: \u542f\u7528\u4e91\u4fdd\u5b58 \u2192 \u767b\u5f55 \u2192 \u540c\u6b65\u8fdb\u5ea6\u3002)"}, {"question": "\u4e09\u89d2\u51fd\u6570\u8d5b\u8dd1\u6e38\u620f\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u6210\u5c31\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9501\u5b83\u4eec\uff1f", "answer": "\u4e09\u89d2\u51fd\u6570\u8d5b\u8dd1\u6e38\u620f\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u6210\u5c31\uff0c\u9700\u8981\u91c7\u53d6\u7279\u5b9a\u884c\u52a8\u624d\u80fd\u89e3\u9501\u3002\u4f8b\u5982\uff0c\u201c\u5b8c\u7f8e\u6ce2\u6d6a\u201d\u6210\u5c31\u53ef\u4ee5\u901a\u8fc7\u5728\u4e0d\u9519\u8fc7\u4efb\u4f55\u8df3\u8dc3\u7684\u60c5\u51b5\u4e0b\u5b8c\u6210\u5173\u5361\u6765\u89e3\u9501\u3002\u8981\u627e\u5230\u8fd9\u4e9b\u6210\u5c31\uff0c\u8bf7\u63a2\u7d22\u4e0d\u540c\u7684\u5173\u5361\u5e76\u5c1d\u8bd5\u5404\u79cd\u7b56\u7565\u3002(\u591a\u65b9\u6848\u5bf9\u6bd4: \u7b56\u7565 1 - \u5b8c\u7f8e\u5b8c\u6210\u5173\u5361\uff1b\u7b56\u7565 2 - \u63a2\u7d22\u9690\u85cf\u533a\u57df\uff1b\u7b56\u7565 3 - \u4f7f\u7528\u7279\u5b9a\u9053\u5177\u3002)"}, {"question": "\u5982\u4f55\u53d1\u73b0\u4e09\u89d2\u51fd\u6570\u8d5b\u8dd1\u6e38\u620f\u4e2d\u7684\u79d8\u5bc6\u5173\u5361\uff1f", "answer": "\u8981\u53d1\u73b0\u4e09\u89d2\u51fd\u6570\u8d5b\u8dd1\u6e38\u620f\u4e2d\u7684\u79d8\u5bc6\u5173\u5361\uff0c\u60a8\u9700\u8981\u6536\u96c6\u6563\u843d\u5728\u4e0d\u540c\u5173\u5361\u4e2d\u7684\u6240\u6709\u9690\u85cf\u94a5\u5319\u3002\u4e00\u65e6\u60a8\u6536\u96c6\u4e86\u6240\u6709\u94a5\u5319\uff0c\u4e00\u4e2a\u540d\u4e3a\u201c\u795e\u79d8\u89d2\u5ea6\u201d\u7684\u65b0\u5173\u5361\u5c06\u88ab\u89e3\u9501\u3002\u4f8b\u5982\uff0c\u5728\u201c\u4f59\u5f26\u201d\u5173\u5361\u4e2d\uff0c\u4e00\u4e2a\u94a5\u5319\u9690\u85cf\u5728\u9700\u8981\u7cbe\u786e\u65f6\u673a\u624d\u80fd\u5230\u8fbe\u7684\u79fb\u52a8\u5e73\u53f0\u540e\u9762\u3002(\u6bd4\u55bb\u8bf4\u660e: \u5c06\u94a5\u5319\u60f3\u8c61\u6210\u62fc\u56fe\u788e\u7247\uff1b\u6536\u96c6\u6240\u6709\u788e\u7247\u624d\u80fd\u63ed\u793a\u5b8c\u6574\u7684\u753b\u9762\u3002)"}]
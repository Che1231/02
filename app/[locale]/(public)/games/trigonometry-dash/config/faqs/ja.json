[{"question": "\u4e09\u89d2\u95a2\u6570\u30c0\u30c3\u30b7\u30e5\u3067\u3001\u521d\u5fc3\u8005\u3068\u3057\u3066\u57fa\u672c\u7684\u306a\u30b8\u30e3\u30f3\u30d7\u3092\u3069\u306e\u3088\u3046\u306b\u5b9f\u884c\u3057\u307e\u3059\u304b\uff1f", "answer": "\u4e09\u89d2\u95a2\u6570\u30c0\u30c3\u30b7\u30e5\u3067\u3001\u521d\u671f\u30ec\u30d9\u30eb\u3092\u79fb\u52d5\u3059\u308b\u306b\u306f\u3001\u57fa\u672c\u7684\u306a\u30b8\u30e3\u30f3\u30d7\u306e\u5b9f\u884c\u304c\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u30b8\u30e3\u30f3\u30d7\u3059\u308b\u306b\u306f\u3001\u753b\u9762\u3092\u4e00\u5ea6\u30bf\u30c3\u30d7\u3059\u308b\u3060\u3051\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u300c\u30b5\u30a4\u30f3\u6ce2\u300d\u3067\u306f\u3001\u9069\u5207\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u30bf\u30c3\u30d7\u3059\u308b\u3053\u3068\u3067\u3001\u5c0f\u3055\u306a\u969c\u5bb3\u7269\u306e\u4e0a\u3092\u30b8\u30e3\u30f3\u30d7\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u3067\u3059\u3002\u65e9\u3059\u304e\u305f\u308a\u3001\u9045\u3059\u304e\u305f\u308a\u3059\u308b\u3068\u3001\u969c\u5bb3\u7269\u306b\u3076\u3064\u304b\u3063\u3066\u3057\u307e\u3044\u307e\u3059\u3002\u30ea\u30ba\u30e0\u3092\u63b4\u3080\u305f\u3081\u306b\u3001\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30bb\u30af\u30b7\u30e7\u30f3\u3067\u7df4\u7fd2\u3057\u307e\u3057\u3087\u3046\u3002(\u6bd4\u55a9\u8aac\u660e:\u8df3\u3073\u7e04\u3092\u3059\u308b\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u3064\u307e\u3065\u304b\u306a\u3044\u3088\u3046\u306b\u3001\u30b8\u30e3\u30f3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u6b63\u78ba\u306b\u5408\u308f\u305b\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002)"}, {"question": "\u4e09\u89d2\u95a2\u6570\u30c0\u30c3\u30b7\u30e5\u306e\u300c\u30b5\u30a4\u30f3\u300d\u30e2\u30fc\u30c9\u3068\u300c\u30b3\u30b5\u30a4\u30f3\u300d\u30e2\u30fc\u30c9\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u4e09\u89d2\u95a2\u6570\u30c0\u30c3\u30b7\u30e5\u306e\u300c\u30b5\u30a4\u30f3\u300d\u30e2\u30fc\u30c9\u3068\u300c\u30b3\u30b5\u30a4\u30f3\u300d\u30e2\u30fc\u30c9\u306f\u3001\u72ec\u7279\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4f53\u9a13\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u300c\u30b5\u30a4\u30f3\u300d\u30e2\u30fc\u30c9\u306f\u6ed1\u3089\u304b\u3067\u6ce2\u306e\u3088\u3046\u306a\u52d5\u304d\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u304a\u308a\u3001\u521d\u5fc3\u8005\u3067\u3082\u30ca\u30d3\u30b2\u30fc\u30c8\u3057\u3084\u3059\u304f\u306a\u3063\u3066\u3044\u307e\u3059\u3002\u300c\u30b3\u30b5\u30a4\u30f3\u300d\u30e2\u30fc\u30c9\u306f\u3001\u3088\u308a\u92ed\u3044\u30bf\u30fc\u30f3\u3068\u3088\u308a\u8907\u96d1\u306a\u30d1\u30bf\u30fc\u30f3\u3092\u5c0e\u5165\u3057\u3066\u304a\u308a\u3001\u4e0a\u7d1a\u8005\u5411\u3051\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30b3\u30b5\u30a4\u30f3\u300d\u30e2\u30fc\u30c9\u3067\u306f\u3001\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u7d20\u65e9\u3044\u53cd\u5c04\u795e\u7d4c\u304c\u5fc5\u8981\u3068\u306a\u308b\u969c\u5bb3\u7269\u306b\u906d\u9047\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002(\u914d\u7f6e\u5bfe\u7167\u8868: \u30b5\u30a4\u30f3\u30e2\u30fc\u30c9 - \u6ed1\u3089\u304b\u3067\u521d\u5fc3\u8005\u5411\u3051; \u30b3\u30b5\u30a4\u30f3\u30e2\u30fc\u30c9 - \u92ed\u3044\u30bf\u30fc\u30f3\u3001\u4e0a\u7d1a\u8005\u5411\u3051\u3002)"}, {"question": "\u4e09\u89d2\u95a2\u6570\u30c0\u30c3\u30b7\u30e5\u3067\u3001\u753b\u9762\u3092\u30bf\u30c3\u30d7\u3057\u3066\u3082\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u30b8\u30e3\u30f3\u30d7\u3092\u30df\u30b9\u3059\u308b\u3053\u3068\u304c\u3042\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u4e09\u89d2\u95a2\u6570\u30c0\u30c3\u30b7\u30e5\u3067\u30b8\u30e3\u30f3\u30d7\u3092\u30df\u30b9\u3059\u308b\u539f\u56e0\u306f\u3001\u9045\u5ef6\u3084\u30bf\u30a4\u30df\u30f3\u30b0\u306e\u554f\u984c\u3067\u3042\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u30c7\u30d0\u30a4\u30b9\u304c\u30b2\u30fc\u30e0\u306b\u6700\u9069\u5316\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3059\u308b\u305f\u3081\u306b\u3001\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u30a2\u30d7\u30ea\u3092\u9589\u3058\u3066\u3001\u753b\u9762\u306e\u660e\u308b\u3055\u3092\u4e0b\u3052\u3066\u304f\u3060\u3055\u3044\u3002\u3055\u3089\u306b\u3001\u30b2\u30fc\u30e0\u306e\u30bd\u30d5\u30c8\u30a6\u30a7\u30a2\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb\u300c\u30bf\u30f3\u30b8\u30a7\u30f3\u30c8\u30c8\u30ec\u30a4\u30eb\u300d\u3067\u306f\u3001\u30ae\u30e3\u30c3\u30d7\u306b\u843d\u3061\u306a\u3044\u3088\u3046\u306b\u3001\u6b63\u78ba\u306a\u30b8\u30e3\u30f3\u30d7\u304c\u5fc5\u8981\u3067\u3059\u3002(\u591a\u65b9\u6848\u6bd4\u8f03: \u30bd\u30ea\u30e5\u30fc\u30b7\u30e7\u30f31 - \u30c7\u30d0\u30a4\u30b9\u3092\u6700\u9069\u5316; \u30bd\u30ea\u30e5\u30fc\u30b7\u30e7\u30f32 - \u30b2\u30fc\u30e0\u3092\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8; \u30bd\u30ea\u30e5\u30fc\u30b7\u30e7\u30f33 - \u30bf\u30a4\u30df\u30f3\u30b0\u306e\u7df4\u7fd2\u3002)"}, {"question": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u4e09\u89d2\u95a2\u6570\u30c0\u30c3\u30b7\u30e5\u306e\u300c\u30bf\u30f3\u30b8\u30a7\u30f3\u30c8\u300d\u30ec\u30d9\u30eb\u3092\u3069\u306e\u3088\u3046\u306b\u30de\u30b9\u30bf\u30fc\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u4e09\u89d2\u95a2\u6570\u30c0\u30c3\u30b7\u30e5\u306e\u300c\u30bf\u30f3\u30b8\u30a7\u30f3\u30c8\u300d\u30ec\u30d9\u30eb\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u9ad8\u5ea6\u306a\u6226\u7565\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71: \u969c\u5bb3\u7269\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u7814\u7a76\u3057\u3001\u305d\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u8a18\u61b6\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72: \u30ec\u30d9\u30eb\u3092\u7e70\u308a\u8fd4\u3057\u7df4\u7fd2\u3057\u3066\u3001\u7b4b\u8089\u306e\u8a18\u61b6\u3092\u4f5c\u308b\u3002\u30b9\u30c6\u30c3\u30d73: \u56f0\u96e3\u306a\u90e8\u5206\u3092\u56de\u907f\u3059\u308b\u305f\u3081\u306b\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u6226\u7565\u7684\u306b\u4f7f\u7528\u3059\u308b\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u300d\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u3001\u72ed\u3044\u5834\u6240\u3092\u79fb\u52d5\u3059\u308b\u969b\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002(\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8: \u7814\u7a76\u2192\u7df4\u7fd2\u2192\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306e\u4f7f\u7528\u2192\u30ec\u30d9\u30eb\u30de\u30b9\u30bf\u30fc\u3002)"}, {"question": "\u4e09\u89d2\u95a2\u6570\u30c0\u30c3\u30b7\u30e5\u306e\u300c\u30bb\u30ab\u30f3\u30c8\u300d\u30ec\u30d9\u30eb\u3067\u4f7f\u7528\u3059\u308b\u6700\u9069\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u4e09\u89d2\u95a2\u6570\u30c0\u30c3\u30b7\u30e5\u306e\u300c\u30bb\u30ab\u30f3\u30c8\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u6700\u9069\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u300c\u30b7\u30fc\u30eb\u30c9\u300d\u3068\u300c\u30c0\u30d6\u30eb\u30b8\u30e3\u30f3\u30d7\u300d\u3067\u3059\u3002\u300c\u30b7\u30fc\u30eb\u30c9\u300d\u306f\u4e00\u5ea6\u306e\u653b\u6483\u304b\u3089\u3042\u306a\u305f\u3092\u5b88\u308a\u3001\u300c\u30c0\u30d6\u30eb\u30b8\u30e3\u30f3\u30d7\u300d\u306f\u9ad8\u3044\u969c\u5bb3\u7269\u3092\u98db\u3073\u8d8a\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30c0\u30d6\u30eb\u30b8\u30e3\u30f3\u30d7\u300d\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u3001\u30ec\u30d9\u30eb\u306e\u4e2d\u9593\u306b\u3042\u308b\u4e00\u9023\u306e\u9ad8\u3044\u58c1\u3092\u30af\u30ea\u30a2\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002(\u914d\u7f6e\u5bfe\u7167\u8868: \u30b7\u30fc\u30eb\u30c9 - \u9632\u5fa1\u529b; \u30c0\u30d6\u30eb\u30b8\u30e3\u30f3\u30d7 - \u9ad8\u3044\u969c\u5bb3\u7269\u3092\u56de\u907f\u3002)"}, {"question": "\u4e09\u89d2\u95a2\u6570\u30c0\u30c3\u30b7\u30e5\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u3069\u306e\u3088\u3046\u306b\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u4e09\u89d2\u95a2\u6570\u30c0\u30c3\u30b7\u30e5\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u79fb\u52d5\u8ddd\u96e2\u3001\u53ce\u96c6\u3057\u305f\u30b3\u30a4\u30f3\u3001\u4f7f\u7528\u3057\u305f\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3001\u3059\u3079\u3066\u306e\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u52b9\u7387\u7684\u306b\u4f7f\u7528\u3059\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30b3\u30bb\u30ab\u30f3\u30c8\u300d\u30ec\u30d9\u30eb\u3067\u306f\u30011\u56de\u306e\u30e9\u30f3\u3067\u3059\u3079\u3066\u306e\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u308b\u3053\u3068\u3067\u3001\u30b9\u30b3\u30a2\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002(\u591a\u65b9\u6848\u6bd4\u8f03: \u6226\u75651 - \u30b3\u30a4\u30f3\u3092\u96c6\u3081\u308b; \u6226\u75652 - \u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3059\u308b; \u6226\u75653 - \u30ec\u30d9\u30eb\u3092\u7d20\u65e9\u304f\u30af\u30ea\u30a2\u3059\u308b\u3002)"}, {"question": "\u4e09\u89d2\u95a2\u6570\u30c0\u30c3\u30b7\u30e5\u306e\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u3067\u300c\u30e9\u30b8\u30a2\u30f3\u300d\u306e\u91cd\u8981\u6027\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u4e09\u89d2\u95a2\u6570\u30c0\u30c3\u30b7\u30e5\u3067\u3001\u300c\u30e9\u30b8\u30a2\u30f3\u300d\u306f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u79fb\u52d5\u3068\u56de\u8ee2\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u91cd\u8981\u306a\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u3067\u3059\u3002\u5404\u30e9\u30b8\u30a2\u30f3\u306f\u7279\u5b9a\u306e\u89d2\u5ea6\u306b\u5bfe\u5fdc\u3057\u3066\u304a\u308a\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u969c\u5bb3\u7269\u3092\u3069\u306e\u3088\u3046\u306b\u79fb\u52d5\u3059\u308b\u304b\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30e9\u30b8\u30a2\u30eb\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30e9\u30b8\u30a2\u30f3\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u79fb\u52d5\u3059\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u30d1\u30b9\u3092\u4e88\u6e2c\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002(\u6bd4\u55a9\u8aac\u660e: \u30e9\u30b8\u30a2\u30f3\u306f\u6642\u8a08\u306e\u91dd\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u305d\u308c\u305e\u308c\u306e\u4f4d\u7f6e\u306f\u7279\u5b9a\u306e\u65b9\u5411\u3092\u793a\u3057\u3066\u3044\u307e\u3059\u3002)"}, {"question": "\u53e4\u3044\u30c7\u30d0\u30a4\u30b9\u304b\u3089\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u4e09\u89d2\u95a2\u6570\u30c0\u30c3\u30b7\u30e5\u306e\u9032\u884c\u72b6\u6cc1\u3092\u79fb\u884c\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u4e09\u89d2\u95a2\u6570\u30c0\u30c3\u30b7\u30e5\u306e\u9032\u884c\u72b6\u6cc1\u3092\u79fb\u884c\u3059\u308b\u306b\u306f\u3001\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71: \u53e4\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u3001\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u306b\u79fb\u52d5\u3057\u3066\u3001\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u6709\u52b9\u306b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72: \u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73: \u30af\u30e9\u30a6\u30c9\u304b\u3089\u9032\u884c\u72b6\u6cc1\u3092\u540c\u671f\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u53e4\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u300c\u30b5\u30a4\u30f3\u6ce2\u300d\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3057\u3066\u3044\u305f\u5834\u5408\u3001\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u3082\u30af\u30ea\u30a2\u6e08\u307f\u3068\u3057\u3066\u8868\u793a\u3055\u308c\u307e\u3059\u3002(\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8: \u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u6709\u52b9\u306b\u3059\u308b\u2192\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u2192\u9032\u884c\u72b6\u6cc1\u3092\u540c\u671f\u3059\u308b\u3002)"}, {"question": "\u4e09\u89d2\u95a2\u6570\u30c0\u30c3\u30b7\u30e5\u306e\u96a0\u3057\u5b9f\u7e3e\u306f\u4f55\u3067\u3001\u3069\u306e\u3088\u3046\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u4e09\u89d2\u95a2\u6570\u30c0\u30c3\u30b7\u30e5\u306b\u306f\u3001\u7279\u5b9a\u306e\u30a2\u30af\u30b7\u30e7\u30f3\u3092\u5fc5\u8981\u3068\u3059\u308b\u96a0\u3055\u308c\u305f\u5b9f\u7e3e\u304c\u3044\u304f\u3064\u304b\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u5b8c\u74a7\u306a\u6ce2\u300d\u5b9f\u7e3e\u306f\u3001\u30b8\u30e3\u30f3\u30d7\u3092\u30df\u30b9\u3059\u308b\u3053\u3068\u306a\u304f\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u5b9f\u7e3e\u3092\u898b\u3064\u3051\u308b\u306b\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u30ec\u30d9\u30eb\u3092\u63a2\u7d22\u3057\u3001\u3055\u307e\u3056\u307e\u306a\u6226\u7565\u3092\u8a66\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002(\u591a\u65b9\u6848\u6bd4\u8f03: \u6226\u75651 - \u30ec\u30d9\u30eb\u3092\u5b8c\u74a7\u306b\u30af\u30ea\u30a2\u3059\u308b; \u6226\u75652 - \u96a0\u3055\u308c\u305f\u30a8\u30ea\u30a2\u3092\u63a2\u691c\u3059\u308b; \u6226\u75653 - \u7279\u5b9a\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3059\u308b\u3002)"}, {"question": "\u4e09\u89d2\u95a2\u6570\u30c0\u30c3\u30b7\u30e5\u306e\u79d8\u5bc6\u30ec\u30d9\u30eb\u3092\u767a\u898b\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u4e09\u89d2\u95a2\u6570\u30c0\u30c3\u30b7\u30e5\u306e\u79d8\u5bc6\u30ec\u30d9\u30eb\u3092\u767a\u898b\u3059\u308b\u306b\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u30ec\u30d9\u30eb\u306b\u6563\u3089\u3070\u3063\u305f\u3059\u3079\u3066\u306e\u96a0\u3055\u308c\u305f\u30ad\u30fc\u3092\u96c6\u3081\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3059\u3079\u3066\u306e\u30ad\u30fc\u3092\u96c6\u3081\u308b\u3068\u3001\u300c\u8b0e\u306e\u89d2\u5ea6\u300d\u3068\u547c\u3070\u308c\u308b\u65b0\u3057\u3044\u30ec\u30d9\u30eb\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30b3\u30b5\u30a4\u30f3\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u79fb\u52d5\u3059\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u5f8c\u308d\u306b\u96a0\u3055\u308c\u305f\u30ad\u30fc\u304c1\u3064\u3042\u308a\u307e\u3059\u3002(\u6bd4\u55a9\u8aac\u660e: \u30ad\u30fc\u306f\u30d1\u30ba\u30eb\u30d4\u30fc\u30b9\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u3059\u3079\u3066\u306e\u30ad\u30fc\u3092\u96c6\u3081\u308b\u3053\u3068\u3067\u3001\u5168\u4f53\u306e\u7d75\u304c\u660e\u3089\u304b\u306b\u306a\u308a\u307e\u3059\u3002)"}]
[{"question": "\u5982\u4f55\u5728\u521d\u5b78\u8005\u7684\u4e09\u89d2\u51fd\u6578\u885d\u523a\u904a\u6232\u4e2d\u57f7\u884c\u57fa\u672c\u8df3\u8e8d\uff1f", "answer": "\u5728\u4e09\u89d2\u51fd\u6578\u885d\u523a\u904a\u6232\u4e2d\uff0c\u57f7\u884c\u57fa\u672c\u8df3\u8e8d\u5c0d\u65bc\u521d\u7d1a\u95dc\u5361\u7684\u904a\u73a9\u81f3\u95dc\u91cd\u8981\u3002\u8981\u8df3\u8e8d\uff0c\u53ea\u9700\u8f15\u89f8\u87a2\u5e55\u4e00\u6b21\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u95dc\u300e\u6b63\u5f26\u6ce2\u300f\u4e2d\uff0c\u60a8\u9700\u8981\u5728\u9069\u7576\u7684\u6642\u6a5f\u8f15\u89f8\u87a2\u5e55\u4ee5\u8df3\u904e\u5c0f\u969c\u7919\u7269\u3002\u6642\u6a5f\u628a\u63e1\u81f3\u95dc\u91cd\u8981\uff1b\u89f8\u63a7\u904e\u65e9\u6216\u904e\u665a\uff0c\u60a8\u5c31\u6703\u649e\u5230\u969c\u7919\u7269\u3002\u5728\u6559\u5b78\u90e8\u5206\u7df4\u7fd2\uff0c\u4ee5\u4fbf\u719f\u6089\u7bc0\u594f\u3002 (\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4e00\u4e0b\u8df3\u7e69\uff1b\u60a8\u9700\u8981\u5b8c\u7f8e\u5730\u63a7\u5236\u8df3\u8e8d\u6642\u9593\uff0c\u624d\u80fd\u907f\u514d\u7d46\u5012\u3002)"}, {"question": "\u4e09\u89d2\u51fd\u6578\u885d\u523a\u904a\u6232\u4e2d\u300e\u6b63\u5f26\u300f\u548c\u300e\u9918\u5f26\u300f\u6a21\u5f0f\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u4e09\u89d2\u51fd\u6578\u885d\u523a\u904a\u6232\u4e2d\uff0c\u300e\u6b63\u5f26\u300f\u548c\u300e\u9918\u5f26\u300f\u6a21\u5f0f\u63d0\u4f9b\u4e0d\u540c\u7684\u904a\u6232\u9ad4\u9a57\u3002\u300e\u6b63\u5f26\u300f\u6a21\u5f0f\u5074\u91cd\u65bc\u5e73\u6ed1\u7684\u6ce2\u6d6a\u5f0f\u79fb\u52d5\uff0c\u8b93\u521d\u5b78\u8005\u66f4\u5bb9\u6613\u904a\u73a9\u3002\u300e\u9918\u5f26\u300f\u6a21\u5f0f\u5247\u5f15\u5165\u66f4\u92b3\u5229\u7684\u8f49\u5f4e\u548c\u66f4\u8907\u96dc\u7684\u6a21\u5f0f\uff0c\u9069\u5408\u9032\u968e\u73a9\u5bb6\u3002\u4f8b\u5982\uff0c\u5728\u300e\u9918\u5f26\u300f\u6a21\u5f0f\u4e2d\uff0c\u60a8\u53ef\u80fd\u6703\u9047\u5230\u9700\u8981\u7cbe\u78ba\u7684\u6642\u6a5f\u548c\u5feb\u901f\u53cd\u61c9\u7684\u969c\u7919\u7269\u3002 (\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u6b63\u5f26\u6a21\u5f0f - \u5e73\u6ed1\uff0c\u9069\u5408\u521d\u5b78\u8005\uff1b\u9918\u5f26\u6a21\u5f0f - \u92b3\u5229\u8f49\u5f4e\uff0c\u9069\u5408\u9032\u968e\u73a9\u5bb6\u3002)"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u7684\u89d2\u8272\u5728\u4e09\u89d2\u51fd\u6578\u885d\u523a\u904a\u6232\u4e2d\uff0c\u5373\u4f7f\u6211\u5df2\u7d93\u89f8\u63a7\u87a2\u5e55\uff0c\u6709\u6642\u4e5f\u6703\u932f\u904e\u8df3\u8e8d\uff1f", "answer": "\u5728\u4e09\u89d2\u51fd\u6578\u885d\u523a\u904a\u6232\u4e2d\u932f\u904e\u8df3\u8e8d\u53ef\u80fd\u7531\u65bc\u5ef6\u9072\u6216\u6642\u6a5f\u554f\u984c\u3002\u8acb\u78ba\u4fdd\u60a8\u7684\u88dd\u7f6e\u5df2\u91dd\u5c0d\u904a\u6232\u512a\u5316\uff0c\u65b9\u6cd5\u662f\u95dc\u9589\u5f8c\u53f0\u61c9\u7528\u7a0b\u5f0f\u4e26\u964d\u4f4e\u87a2\u5e55\u4eae\u5ea6\u3002\u6b64\u5916\uff0c\u4e5f\u8acb\u6aa2\u67e5\u904a\u6232\u662f\u5426\u6709\u4efb\u4f55\u8edf\u9ad4\u66f4\u65b0\u3002\u4f8b\u5982\uff0c\u5728\u300e\u6b63\u5207\u4e4b\u8def\u300f\u95dc\u5361\u4e2d\uff0c\u9700\u8981\u7cbe\u78ba\u7684\u8df3\u8e8d\u4ee5\u907f\u514d\u6389\u5165\u7a7a\u9699\u3002 (\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u89e3\u6c7a\u65b9\u6848 1 - \u512a\u5316\u88dd\u7f6e\uff1b\u89e3\u6c7a\u65b9\u6848 2 - \u66f4\u65b0\u904a\u6232\uff1b\u89e3\u6c7a\u65b9\u6848 3 - \u7df4\u7fd2\u6642\u6a5f\u3002)"}, {"question": "\u5728\u73a9\u4e86 100 \u5c0f\u6642\u4e09\u89d2\u51fd\u6578\u885d\u523a\u904a\u6232\u5f8c\uff0c\u5982\u4f55\u638c\u63e1\u300e\u6b63\u5207\u300f\u95dc\u5361\uff1f", "answer": "\u5728\u4e09\u89d2\u51fd\u6578\u885d\u523a\u904a\u6232\u4e2d\u638c\u63e1\u300e\u6b63\u5207\u300f\u95dc\u5361\u9700\u8981\u5148\u9032\u7684\u7b56\u7565\u3002\u6b65\u9a5f1\uff1a\u7814\u7a76\u969c\u7919\u6a21\u5f0f\u4e26\u8a18\u4f4f\u5b83\u5011\u7684\u6642\u6a5f\u3002\u6b65\u9a5f2\uff1a\u53cd\u8986\u7df4\u7fd2\u8a72\u95dc\u5361\uff0c\u5efa\u7acb\u808c\u8089\u8a18\u61b6\u3002\u6b65\u9a5f3\uff1a\u7b56\u7565\u6027\u5730\u4f7f\u7528\u9053\u5177\uff0c\u7e5e\u904e\u56f0\u96e3\u90e8\u5206\u3002\u4f8b\u5982\uff0c\u300e\u52a0\u901f\u300f\u9053\u5177\u53ef\u4ee5\u5e6b\u52a9\u60a8\u5728\u72f9\u7a84\u7684\u7a7a\u9593\u4e2d\u904a\u73a9\u3002 (\u6d41\u7a0b\u5716\u89e3\uff1a\u7814\u7a76 \u2192 \u7df4\u7fd2 \u2192 \u4f7f\u7528\u9053\u5177 \u2192 \u638c\u63e1\u95dc\u5361\u3002)"}, {"question": "\u5728\u4e09\u89d2\u51fd\u6578\u885d\u523a\u904a\u6232\u7684\u300e\u6b63\u5272\u300f\u95dc\u5361\u4e2d\uff0c\u4f7f\u7528\u54ea\u4e9b\u6700\u4f73\u9053\u5177\uff1f", "answer": "\u5728\u4e09\u89d2\u51fd\u6578\u885d\u523a\u904a\u6232\u7684\u300e\u6b63\u5272\u300f\u95dc\u5361\u4e2d\uff0c\u6700\u4f73\u9053\u5177\u662f\u300e\u8b77\u76fe\u300f\u548c\u300e\u96d9\u8df3\u300f\u3002\u300e\u8b77\u76fe\u300f\u53ef\u4ee5\u4fdd\u8b77\u60a8\u514d\u53d7\u4e00\u6b21\u653b\u64ca\uff0c\u800c\u300e\u96d9\u8df3\u300f\u5247\u5141\u8a31\u60a8\u7e5e\u904e\u9ad8\u969c\u7919\u7269\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u300e\u96d9\u8df3\u300f\u53ef\u4ee5\u5e6b\u52a9\u60a8\u6e05\u9664\u8a72\u95dc\u5361\u4e2d\u9593\u9023\u7e8c\u7684\u9ad8\u7246\u3002\uff08\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u8b77\u76fe - \u4fdd\u8b77\uff1b\u96d9\u8df3 - \u7e5e\u904e\u9ad8\u969c\u7919\u7269\uff09"}, {"question": "\u4e09\u89d2\u51fd\u6578\u885d\u523a\u904a\u6232\u7684\u5f97\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u5927\u5316\u5f97\u5206\uff1f", "answer": "\u4e09\u89d2\u51fd\u6578\u885d\u523a\u904a\u6232\u7684\u5f97\u5206\u7cfb\u7d71\u57fa\u65bc\u884c\u9032\u8ddd\u96e2\u3001\u6536\u96c6\u7684\u786c\u5e63\u548c\u4f7f\u7528\u7684\u9053\u5177\u3002\u8981\u6700\u5927\u5316\u5f97\u5206\uff0c\u8acb\u5c08\u6ce8\u65bc\u6536\u96c6\u6240\u6709\u786c\u5e63\u4e26\u6709\u6548\u4f7f\u7528\u9053\u5177\u3002\u4f8b\u5982\uff0c\u5728\u300e\u9918\u5272\u300f\u95dc\u5361\u4e2d\uff0c\u5728\u55ae\u6b21\u904b\u884c\u4e2d\u6536\u96c6\u6240\u6709\u786c\u5e63\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u60a8\u7684\u5f97\u5206\u3002 (\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u7b56\u7565 1 - \u6536\u96c6\u786c\u5e63\uff1b\u7b56\u7565 2 - \u4f7f\u7528\u9053\u5177\uff1b\u7b56\u7565 3 - \u5feb\u901f\u5b8c\u6210\u95dc\u5361\u3002)"}, {"question": "\u300e\u5f27\u5ea6\u300f\u5728\u4e09\u89d2\u51fd\u6578\u885d\u523a\u904a\u6232\u7684\u904a\u6232\u6a5f\u5236\u4e2d\u5177\u6709\u4ec0\u9ebc\u610f\u7fa9\uff1f", "answer": "\u5728\u4e09\u89d2\u51fd\u6578\u885d\u523a\u904a\u6232\u4e2d\uff0c\u300e\u5f27\u5ea6\u300f\u662f\u5f71\u97ff\u89d2\u8272\u79fb\u52d5\u548c\u65cb\u8f49\u7684\u4e00\u500b\u95dc\u9375\u904a\u6232\u6a5f\u5236\u3002\u6bcf\u500b\u5f27\u5ea6\u5c0d\u61c9\u4e00\u500b\u7279\u5b9a\u7684\u89d2\u5ea6\uff0c\u5f71\u97ff\u4e86\u89d2\u8272\u5982\u4f55\u7e5e\u904e\u969c\u7919\u7269\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5f91\u5411\u300f\u95dc\u5361\u4e2d\uff0c\u4e86\u89e3\u5f27\u5ea6\u6709\u52a9\u65bc\u60a8\u9810\u6e2c\u79fb\u52d5\u5e73\u53f0\u7684\u8def\u7dda\u3002 (\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u5f27\u5ea6\u5c31\u50cf\u6642\u9418\u7684\u6307\u91dd\uff1b\u6bcf\u500b\u4f4d\u7f6e\u90fd\u8868\u793a\u4e00\u500b\u7279\u5b9a\u7684\u65b9\u5411\u3002)"}, {"question": "\u5982\u4f55\u5c07\u6211\u7684\u4e09\u89d2\u51fd\u6578\u885d\u523a\u904a\u6232\u9032\u5ea6\u5f9e\u820a\u88dd\u7f6e\u8f49\u79fb\u5230\u65b0\u88dd\u7f6e\uff1f", "answer": "\u8981\u8f49\u79fb\u60a8\u7684\u4e09\u89d2\u51fd\u6578\u885d\u523a\u904a\u6232\u9032\u5ea6\uff0c\u8acb\u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u3002\u6b65\u9a5f 1\uff1a\u5728\u60a8\u7684\u820a\u88dd\u7f6e\u4e0a\uff0c\u524d\u5f80\u8a2d\u5b9a\u9078\u55ae\u4e26\u555f\u7528\u96f2\u7aef\u5132\u5b58\u3002\u6b65\u9a5f 2\uff1a\u5728\u65b0\u88dd\u7f6e\u4e0a\u4f7f\u7528\u76f8\u540c\u7684\u5e33\u6236\u767b\u5165\u3002\u6b65\u9a5f 3\uff1a\u5f9e\u96f2\u7aef\u540c\u6b65\u60a8\u7684\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5df2\u5728\u820a\u88dd\u7f6e\u4e0a\u5b8c\u6210\u300e\u6b63\u5f26\u6ce2\u300f\u95dc\u5361\uff0c\u5247\u5728\u65b0\u88dd\u7f6e\u4e0a\u4e5f\u6703\u6a19\u8a18\u70ba\u5df2\u5b8c\u6210\u3002 (\u6d41\u7a0b\u5716\u89e3\uff1a\u555f\u7528\u96f2\u7aef\u5132\u5b58 \u2192 \u767b\u5165 \u2192 \u540c\u6b65\u9032\u5ea6\u3002)"}, {"question": "\u4e09\u89d2\u51fd\u6578\u885d\u523a\u904a\u6232\u4e2d\u7684\u96b1\u85cf\u6210\u5c31\u6709\u54ea\u4e9b\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9396\u5b83\u5011\uff1f", "answer": "\u4e09\u89d2\u51fd\u6578\u885d\u523a\u904a\u6232\u4e2d\u6709\u5e7e\u500b\u96b1\u85cf\u6210\u5c31\uff0c\u9700\u8981\u5b8c\u6210\u7279\u5b9a\u52d5\u4f5c\u624d\u80fd\u89e3\u9396\u3002\u4f8b\u5982\uff0c\u300c\u5b8c\u7f8e\u6ce2\u6d6a\u300d\u6210\u5c31\u662f\u5728\u4e0d\u8df3\u904e\u4efb\u4f55\u8df3\u8e8d\u7684\u60c5\u6cc1\u4e0b\u5b8c\u6210\u4e00\u500b\u95dc\u5361\u540e\u89e3\u9396\u7684\u3002\u8981\u627e\u5230\u9019\u4e9b\u6210\u5c31\uff0c\u8acb\u63a2\u7d22\u4e0d\u540c\u7684\u95dc\u5361\u4e26\u5617\u8a66\u5404\u7a2e\u7b56\u7565\u3002 (\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u7b56\u7565 1 - \u5b8c\u7f8e\u5b8c\u6210\u95dc\u5361\uff1b\u7b56\u7565 2 - \u63a2\u7d22\u96b1\u85cf\u5340\u57df\uff1b\u7b56\u7565 3 - \u4f7f\u7528\u7279\u5b9a\u9053\u5177\u3002) "}, {"question": "\u5982\u4f55\u5728\u4e09\u89d2\u51fd\u6578\u885d\u523a\u904a\u6232\u4e2d\u767c\u73fe\u79d8\u5bc6\u95dc\u5361\uff1f", "answer": "\u8981\u767c\u73fe\u4e09\u89d2\u51fd\u6578\u885d\u523a\u904a\u6232\u4e2d\u7684\u79d8\u5bc6\u95dc\u5361\uff0c\u60a8\u9700\u8981\u6536\u96c6\u96b1\u85cf\u5728\u4e0d\u540c\u95dc\u5361\u4e2d\u7684\u6240\u6709\u96b1\u85cf\u9470\u5319\u3002\u64c1\u6709\u6240\u6709\u9470\u5319\u5f8c\uff0c\u5c07\u6703\u89e3\u9396\u4e00\u500b\u540d\u70ba\u300e\u8b0e\u984c\u89d2\u5ea6\u300f\u7684\u65b0\u95dc\u5361\u3002\u4f8b\u5982\uff0c\u5728\u300e\u9918\u5f26\u300f\u95dc\u5361\u4e2d\uff0c\u6709\u4e00\u628a\u9470\u5319\u96b1\u85cf\u5728\u9700\u8981\u7cbe\u78ba\u63a7\u5236\u6642\u6a5f\u624d\u80fd\u5230\u9054\u7684\u79fb\u52d5\u5e73\u53f0\u5f8c\u9762\u3002 (\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u9019\u4e9b\u9470\u5319\u5c31\u50cf\u62fc\u5716\u788e\u7247\uff1b\u6536\u96c6\u6240\u6709\u788e\u7247\u6703\u62fc\u6e4a\u51fa\u5b8c\u6574\u7684\u5716\u5f62\u3002)"}]
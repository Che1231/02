[{"question": "\uc7a5\ube44 \ucda9\ub3cc\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc7a5\ube44 \ucda9\ub3cc\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub824\uba74 \uba3c\uc800 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc775\uc219\ud574\uc838\uc57c \ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \uba54\uc778 \uba54\ub274\ub97c \ud0d0\uc0c9\ud558\uc5ec \ud29c\ud1a0\ub9ac\uc5bc \uc139\uc158\uc5d0 \uc811\uadfc\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \ud654\uba74\uc758 \uba54\uc2dc\uc9c0\ub97c \ub530\ub77c \uc774\ub3d9, \uc870\uc900 \ubc0f \uc0ac\uaca9 \uba54\ucee4\ub2c8\uc998\uc744 \ubc30\uc6b0\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc67c\ucabd \uc870\uc774\uc2a4\ud2f1\uc73c\ub85c \uce90\ub9ad\ud130\ub97c \uc774\ub3d9\ud558\uace0 \uc624\ub978\ucabd \uc870\uc774\uc2a4\ud2f1\uc73c\ub85c \uc870\uc900\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ud6c8\ub828 \uc544\ub808\ub098\uc5d0\uc11c \uc774\ub7ec\ud55c \ucee8\ud2b8\ub864\uc744 \uc5f0\uc2b5\ud558\uc5ec \uadfc\uc721 \uba54\ubaa8\ub9ac\ub97c \uad6c\ucd95\ud569\ub2c8\ub2e4. \ud3b8\ub9ac\ud55c \ud301\uc740 \uc790\uc2e0\uc758 \uc218\uc900\uc5d0 \ub9de\uac8c \ubbfc\uac10\ub3c4 \uc124\uc815\uc744 \uc870\uc815\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ucee8\ud2b8\ub864\uc744 \uc6b4\uc804 \ubc30\uc6b0\ub294 \uac83\uc73c\ub85c \uc0dd\uac01\ud558\uc138\uc694. \ucc9c\ucc9c\ud788 \uc2dc\uc791\ud55c \ub2e4\uc74c \uc790\uc2e0\uac10\uc744 \uc5bb\uc73c\uba74 \uc810\ucc28 \uc18d\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4.]"}, {"question": "\uc7a5\ube44 \ucda9\ub3cc \uc804\ud22c\uc5d0\uc11c \ub354 \uc624\ub798 \ubc84\ud2f0\uae30 \uc704\ud55c \ud544\uc218 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc7a5\ube44 \ucda9\ub3cc \uc804\ud22c\uc5d0\uc11c \ub354 \uc624\ub798 \ubc84\ud2f0\ub824\uba74 \uc804\ub7b5\uacfc \uae30\uc220\uc758 \uc870\ud569\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \ud56d\uc0c1 \uc8fc\ubcc0 \ud658\uacbd\uc744 \uc778\uc9c0\ud558\uace0 \ub36e\uac1c\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ubcbd \ub4a4\ub85c \uc228\uac70\ub098 \ud070 \ubb3c\uccb4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc801\uc758 \uacf5\uaca9\uc73c\ub85c\ubd80\ud130 \uc790\uc2e0\uc744 \ubcf4\ud638\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \uc790\uc6d0\uc744 \ud604\uba85\ud558\uac8c \uad00\ub9ac\ud558\uc138\uc694. \ud0c4\uc57d\uc774\ub098 \uccb4\ub825 \ud3ec\uc158\uc744 \ub0ad\ube44\ud558\uc9c0 \ub9c8\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \uacbd\uc7c1\ub825\uc744 \uc720\uc9c0\ud558\uae30 \uc704\ud574 \uc815\uae30\uc801\uc73c\ub85c \uc7a5\ube44\uc640 \ubb34\uae30\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc2ed\uc2dc\uc624. \uc88b\uc740 \uc608\ub294 \uc8fc\uc694 \ubb34\uae30\ub97c \uba3c\uc800 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc65c\ub0d0\ud558\uba74 \uc774\uac83\uc740 \ubc29\uc5b4\uc758 \uc8fc\uc694 \ub3c4\uad6c\uc774\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\ub294 \uc740\ubc00\ud55c \uc811\uadfc \ubc29\uc2dd\uc744 \uc120\ud638\ud558\ub294 \ubc18\uba74, \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub294 \uacf5\uaca9\uc801\uc778 \uc804\uc220\uc744 \uc120\ud638\ud569\ub2c8\ub2e4. \uc790\uc2e0\uc758 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\ub294 \uac83\uc744 \uc120\ud0dd\ud558\uc138\uc694.]"}, {"question": "\uc7a5\ube44 \ucda9\ub3cc\uc5d0\uc11c \ub2e4\uc591\ud55c \uc804\ud22c \uc0c1\ud669\uc5d0 \uac00\uc7a5 \uc801\ud569\ud55c \ubb34\uae30\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc7a5\ube44 \ucda9\ub3cc\uc5d0\uc11c \ub2e4\uc591\ud55c \uc804\ud22c \uc0c1\ud669\uc740 \ub2e4\uc591\ud55c \ubb34\uae30\ub97c \uc694\uad6c\ud569\ub2c8\ub2e4. \uadfc\uc811 \uc804\ud22c\uc5d0\uc11c \"\ubcf4\uc634\uc2a4\ud2f1\"\uacfc \uac19\uc740 \uc0b0\ud0c4\ucd1d\uc740 \ub2e8\uac70\ub9ac\uc5d0\uc11c \ub192\uc740 \ud53c\ud574\ub7c9\uc744 \ub0b4\uae30 \ub54c\ubb38\uc5d0 \ub9e4\uc6b0 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. \uc7a5\uac70\ub9ac \uad50\uc804\uc5d0\uc11c\ub294 \"\ub871\uc0f7\"\uacfc \uac19\uc740 \uc800\uaca9 \uc18c\ucd1d\uc774 \uc801\uc744 \uba40\ub9ac\uc11c \uc81c\uac70\ud558\uae30\uc5d0 \uc774\uc0c1\uc801\uc785\ub2c8\ub2e4. \uc911\uac70\ub9ac \uc804\ud22c\uc5d0\uc11c\ub294 \"\uc2a4\ud2b8\ub77c\uc774\ucee4\"\uc640 \uac19\uc740 \ub3cc\uaca9 \uc18c\ucd1d\uc774 \ud53c\ud574\ub7c9\uacfc \uc815\ud655\ub3c4\ub97c \uc801\uc808\ud558\uac8c \uc870\ud569\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubcf5\ub3c4\uac00 \uc881\uc740 \uc9c0\ub3c4\uc5d0\uc11c\ub294 \uc0b0\ud0c4\ucd1d\uc774 \uce58\uba85\uc801\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \uc0b0\ud0c4\ucd1d - \ub192\uc740 \ud53c\ud574\ub7c9, \ub2e8\uac70\ub9ac; \uc800\uaca9 \uc18c\ucd1d - \ub192\uc740 \uc815\ud655\ub3c4, \uc7a5\uac70\ub9ac; \ub3cc\uaca9 \uc18c\ucd1d - \uade0\ud615 \uc7a1\ud78c \uc911\uac70\ub9ac.]"}, {"question": "\uc7a5\ube44 \ucda9\ub3cc\uc758 \uc7a5\ube44 \uc5c5\uadf8\ub808\uc774\ub4dc \uc2dc\uc2a4\ud15c\uc740 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\uc7a5\ube44 \ucda9\ub3cc\uc758 \uc7a5\ube44 \uc5c5\uadf8\ub808\uc774\ub4dc \uc2dc\uc2a4\ud15c\uc740 \uce90\ub9ad\ud130\uc758 \uc0dd\uc874\ub825\uacfc \ud6a8\uc728\uc131\uc744 \ub192\uc5ec \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc0c1\ub2f9\ud55c \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc7a5\ube44 \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \uccb4\ub825 \ud480\uacfc \ud53c\ud574 \uc800\ud56d\ub825\uc744 \ub192\uc5ec \uc804\ud22c\uc5d0\uc11c \ub354 \ub9ce\uc740 \ud0c0\uaca9\uc744 \uacac\ub51c \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ud5e4\ube44 \ud50c\ub808\uc774\ud2b8\" \uc7a5\ube44\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uba74 \uc801\uc744 \uc555\ub3c4\ud560 \uc218 \uc788\ub294 \ucd94\uac00\uc801\uc778 \ub0b4\uad6c\uc131\uc744 \uc81c\uacf5\ud558\uc5ec \uc5b4\ub824\uc6b4 \ucd1d\uaca9\uc804\uc5d0\uc11c \uc2b9\ubd80\ub97c \ub4a4\uc9d1\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \ud2b9\uc815 \uc7a5\ube44 \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \uc774\ub3d9\uc131 \ud5a5\uc0c1\uc774\ub098 \uccb4\ub825 \ud68c\ubcf5 \uc18d\ub3c4 \uc99d\uac00\uc640 \uac19\uc740 \ud2b9\uc218 \ub2a5\ub825\uc744 \ud574\uc81c\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc7a5\ube44 \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \ub9c8\uce58 \uae30\uc0ac\uac00 \ub354 \ubb34\uac70\uc6b4 \uac11\uc637\uc744 \uc785\ub4ef\uc774 \ubcf4\ud638\uce35\uc744 \ucd94\uac00\ud558\ub294 \uac83\uc73c\ub85c \uc0dd\uac01\ud558\uc138\uc694.]"}, {"question": "\uc7a5\ube44 \ucda9\ub3cc\uc758 \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc9c0\ub3c4 \ub808\uc774\uc544\uc6c3\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc7a5\ube44 \ucda9\ub3cc\uc758 \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc9c0\ub3c4 \ub808\uc774\uc544\uc6c3\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \uc804\ub7b5\uc801\uc778 \ubc30\uce58\uc640 \ub354 \ub098\uc740 \uc790\uc6d0 \uad00\ub9ac\ub97c \uac00\ub2a5\ud558\uac8c \ud558\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc8fc\uc694 \uc9c0\uc5ed(\uccb4\ub825 \ud3ec\uc158, \ud0c4\uc57d \ubcf4\uae09\uc18c \ubc0f \uc881\uc740 \uc9c0\uc810)\uc758 \uc704\uce58\ub97c \uc54c\uba74 \uc0c1\ub2f9\ud55c \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uce90\ub144 \ucda9\ub3cc\" \uac19\uc740 \uc9c0\ub3c4\uc5d0\uc11c \ub192\uc740 \uc9c0\ub300\ub97c \uc7a5\uc545\ud558\uba74 \uc801\uc744 \uc800\uaca9\ud558\ub294 \uc804\uc220\uc801 \uc6b0\uc704\ub97c \ud655\ubcf4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \ud0c8\ucd9c \uacbd\ub85c\uc640 \uce21\uba74 \uacf5\uaca9 \uacbd\ub85c\ub97c \uc219\uc9c0\ud558\uba74 \ub9e4\ubcf5\uc744 \ud53c\ud558\uace0 \uc801\uc744 \uae30\uc2b5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc2dc\uc791 \uc9c0\uc810 \u2192 \uc8fc\uc694 \uc704\uce58 \uc2dd\ubcc4 \u2192 \uc774\ub3d9 \uacbd\ub85c \uacc4\ud68d \u2192 \uc804\ub7b5 \uc2e4\ud589.]"}, {"question": "\uc7a5\ube44 \ucda9\ub3cc\uc758 PvP \ubc0f PvE \ubaa8\ub4dc \uac04\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc7a5\ube44 \ucda9\ub3cc\uc758 PvP(\ud50c\ub808\uc774\uc5b4 \ub300 \ud50c\ub808\uc774\uc5b4) \ubc0f PvE(\ud50c\ub808\uc774\uc5b4 \ub300 \ud658\uacbd) \ubaa8\ub4dc \uac04\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubaa9\ud45c\uc640 \uac8c\uc784 \ub2e4\uc774\ub098\ubbf9\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. PvP\uc5d0\uc11c\ub294 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub97c \uc18d\uc5ec \uc774\uae30\ub294 \ub370 \ucd08\uc810\uc744 \ub9de\ucd94\uae30 \ub54c\ubb38\uc5d0 \ube60\ub978 \ubc18\uc751 \uc18d\ub3c4\uc640 \uc804\ub7b5\uc801 \uc0ac\uace0\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PvP \ub9e4\uce58\uc5d0\uc11c \uc801\uc758 \uc6c0\uc9c1\uc784\uc744 \uc608\uce21\ud558\uace0 \ub36e\uac1c\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud574\uc57c \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. PvE\uc5d0\uc11c\ub294 AI \uae30\ubc18 \uc801\uc744 \ubb3c\ub9ac\uce58\uace0 \uc784\ubb34 \ubaa9\ud45c\ub97c \uc644\ub8cc\ud558\ub294 \ub370 \ub3c4\uc804\ud558\ub294 \uac83\uc774\uba70, \uc774\ub294 \uc885\uc885 \ud611\ub825\uacfc \uc790\uc6d0 \uad00\ub9ac\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PvE \uc784\ubb34\uc5d0\uc11c \uc5ec\ub7ec \ud30c\ub3c4\uc758 \uc801 \uacf5\uaca9\uc73c\ub85c\ubd80\ud130 \uae30\uc9c0\ub97c \ubc29\uc5b4\ud574\uc57c \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: PvP\ub294 \uacbd\uc7c1\uc5d0 \ub354 \ucd08\uc810\uc774 \ub9de\ucdb0\uc838 \uc788\ub294 \ubc18\uba74, PvE\ub294 \ud611\ub825\uacfc \uc784\ubb34 \uc644\ub8cc\uc5d0 \uc911\uc810\uc744 \ub461\ub2c8\ub2e4.]"}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 \uc7a5\ube44 \ucda9\ub3cc\uc758 \ud2b9\uc815 \uc784\ubb34\uc5d0 \ub300\ud55c \ub85c\ub4dc\uc544\uc6c3\uc744 \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc7a5\ube44 \ucda9\ub3cc\uc758 \ud2b9\uc815 \uc784\ubb34\uc5d0 \ub300\ud55c \ub85c\ub4dc\uc544\uc6c3\uc744 \ucd5c\uc801\ud654\ud558\ub294 \uac83\uc740 \uc784\ubb34 \uc694\uad6c \uc0ac\ud56d\uc5d0 \ub9de\ub294 \ubb34\uae30, \uc7a5\ube44 \ubc0f \uc7a5\ube44\uc758 \uc801\uc808\ud55c \uc870\ud569\uc744 \uc120\ud0dd\ud558\ub294 \uac83\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc784\ubb34 \ubaa9\ud45c\uc640 \uc801 \uc720\ud615\uc744 \ubd84\uc11d\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc784\ubb34\uac00 \uadfc\uc811 \uc804\ud22c\ub97c \ud3ec\ud568\ud558\ub294 \uacbd\uc6b0 \uc774\ub3d9\uc131\uc744 \uc704\ud574 \uc0b0\ud0c4\ucd1d\uacfc \uacbd\uc7a5\ube44\ub97c \uac16\ucd94\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \uc9c0\uc5ed \uc81c\uc5b4\uc6a9 \uc218\ub958\ud0c4 \ub610\ub294 \uce58\uc720\uc6a9 \uc758\ub8cc \ud0a4\ud2b8\uc640 \uac19\uc774 \uc790\uc2e0\uc758 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\uace0 \uc784\ubb34 \ud544\uc694\uc5d0 \ubd80\ud569\ud558\ub294 \uc7a5\ube44\ub97c \uc120\ud0dd\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \ub85c\ub4dc\uc544\uc6c3\uc774 \ud6a8\uacfc\uc801\uc778\uc9c0 \ud655\uc778\ud558\uae30 \uc704\ud574 \uc5f0\uc2b5 \uc2e4\ud589\uc5d0\uc11c \ud14c\uc2a4\ud2b8\ud569\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \uadfc\uc811 \uc804\ud22c \uc784\ubb34 - \uc0b0\ud0c4\ucd1d, \uacbd\uc7a5\ube44, \uc218\ub958\ud0c4; \uc7a5\uac70\ub9ac \uc784\ubb34 - \uc800\uaca9 \uc18c\ucd1d, \uc911\uc7a5\ube44, \uc758\ub8cc \ud0a4\ud2b8.]"}, {"question": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc7a5\ube44 \ucda9\ub3cc\uc744 \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ud558\uae30 \uc704\ud55c \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc7a5\ube44 \ucda9\ub3cc\uc744 \uc6d0\ud65c\ud558\uac8c \uc2e4\ud589\ud558\ub824\uba74 \ud2b9\uc815 \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc744 \ucda9\uc871\ud574\uc57c \ud569\ub2c8\ub2e4. PC\uc758 \uacbd\uc6b0 \ucd5c\uc18c \uc778\ud154 i5 \ud504\ub85c\uc138\uc11c, 8GB RAM \ubc0f GTX 1050 \uadf8\ub798\ud53d \uce74\ub4dc\uac00 \uad8c\uc7a5\ub429\ub2c8\ub2e4. PlayStation 5 \ubc0f Xbox \uc2dc\ub9ac\uc988 X\uc640 \uac19\uc740 \ucf58\uc194\uc5d0\uc11c\ub294 \uac8c\uc784\uc774 \uae30\ubcf8 \uc124\uc815\uc5d0\uc11c \ucd5c\uc801\ud654\ub429\ub2c8\ub2e4. \ubaa8\ubc14\uc77c \uae30\uae30\uc758 \uacbd\uc6b0 \uc801\uc5b4\ub3c4 4GB RAM \ubc0f Snapdragon 835 \ud504\ub85c\uc138\uc11c\uac00 \uc788\ub294 \uae30\uae30\uac00 \uad8c\uc7a5\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, i7 \ud504\ub85c\uc138\uc11c\uc640 16GB RAM\uc774 \uc788\ub294 PC\uc5d0\uc11c \ubd80\ub4dc\ub7ec\uc6b4 \ud504\ub808\uc784 \uc18d\ub3c4\ub85c \ub192\uc740 \uc124\uc815\uc744 \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: PC - \uc778\ud154 i5, 8GB RAM, GTX 1050; \ucf58\uc194 - PS5/Xbox \uc2dc\ub9ac\uc988 X \uae30\ubcf8 \uc124\uc815; \ubaa8\ubc14\uc77c - Snapdragon 835, 4GB RAM.]"}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 \uc7a5\ube44 \ucda9\ub3cc\uc5d0\uc11c \ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc7a5\ube44 \ucda9\ub3cc\uc5d0\uc11c \ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub294 \uac83\uc740 \uac8c\uc784\uc758 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uba74 \uac04\ub2e8\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \ub450 \ud50c\ub7ab\ud3fc \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \uc124\uc815 \uba54\ub274\ub85c \uc774\ub3d9\ud558\uc5ec \"\ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\" \uc635\uc158\uc744 \uc120\ud0dd\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \ud604\uc7ac \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc800\uc7a5 \ub370\uc774\ud130\ub97c \uc5c5\ub85c\ub4dc\ud558\uace0 \uc0c8 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c PlayStation\uc73c\ub85c \uc774\ub3d9\ud558\ub294 \uacbd\uc6b0 PC\uc5d0\uc11c \uc800\uc7a5 \ub370\uc774\ud130\ub97c \uc5c5\ub85c\ub4dc\ud558\uace0 PlayStation\uc5d0\uc11c \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc2ed\uc2dc\uc624. [\ube44\uc720 \uc124\uba85: \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc740 \uc5b4\ub514\ub4e0\uc9c0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uac00\uc9c0\uace0 \ub2e4\ub2c8\ub294 \ub514\uc9c0\ud138 \ubc30\ub0ad\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\uc7a5\ube44 \ucda9\ub3cc\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ube44\ubc00\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc7a5\ube44 \ucda9\ub3cc\uc5d0\ub294 \ud638\uae30\uc2ec \ub9ce\uc740 \ud50c\ub808\uc774\uc5b4\ub97c \ubcf4\uc0c1\ud558\ub294 \uc228\uaca8\uc9c4 \ube44\ubc00\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uac00\ub4dd\ud569\ub2c8\ub2e4. \ub208\uc5d0 \ub744\ub294 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \"\uc0ac\ub9c9 \ub454\ub355\" \uc9c0\ub3c4\uc5d0 \uc228\uaca8\uc9c4 \"\uace8\ub4e0 \ud0f1\ud06c\"\uc785\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\ub294 \ubbf8\ubb18\ud55c \ud658\uacbd \ud78c\ud2b8(\uc608: \ud2b9\uc774\ud55c \uc554\uc11d \uc9c0\ud615)\ub85c \ud45c\uc2dc\ub41c \ud2b9\uc815 \uacbd\ub85c\ub97c \ub530\ub77c\uc57c \ud569\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \ube44\ubc00\uc740 \"\ub3c4\uc2dc \uc720\uc801\" \uc9c0\ub3c4\uc5d0 \uc788\ub294 \"\ubbf8\uc2a4\ud130\ub9ac \ub8f8\"\uc73c\ub85c \ud76c\uadc0\ud55c \ubcf4\uc0c1\uacfc \ub3c5\ud2b9\ud55c \ubb34\uae30 \uc2a4\ud0a8\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ube44\ubc00\uc744 \ubc1c\uacac\ud558\ub294 \uac83\uc740 \uc885\uc885 \uc608\ub9ac\ud55c \uad00\ucc30\ub825\uacfc \ud0d0\ud5d8\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. [\uc774\uc2a4\ud130 \uc5d0\uadf8 \ud0d0\ud5d8: \"\uace8\ub4e0 \ud0f1\ud06c\"\ub294 \uace0\uc804\uc801\uc778 \ud0f1\ud06c \uac8c\uc784\uc5d0 \ub300\ud55c \uc624\ub9c8\uc8fc\uc785\ub2c8\ub2e4. \"\ubbf8\uc2a4\ud130\ub9ac \ub8f8\"\uc740 \uc5f4\uc815\uc801\uc778 \ud0d0\ud5d8\uac00\uc5d0\uac8c \ubcf4\ubb3c \uc0c1\uc790\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4.]"}]
[{"question": "\u30a2\u30fc\u30de\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u306e\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u8fc5\u901f\u306b\u59cb\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30a2\u30fc\u30de\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u3092\u8fc5\u901f\u306b\u59cb\u3081\u308b\u305f\u3081\u306b\u3001\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u307e\u305a\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u306b\u6163\u308c\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30e1\u30a4\u30f3\u30e1\u30cb\u30e5\u30fc\u304b\u3089\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30bb\u30af\u30b7\u30e7\u30f3\u306b\u30a2\u30af\u30bb\u30b9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u753b\u9762\u306e\u6307\u793a\u306b\u5f93\u3063\u3066\u3001\u79fb\u52d5\u3001\u7167\u6e96\u3001\u5c04\u6483\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u5b66\u7fd2\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5de6\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u3067\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u79fb\u52d5\u3057\u3001\u53f3\u30b8\u30e7\u30a4\u30b9\u30c6\u30a3\u30c3\u30af\u3067\u7167\u6e96\u3092\u5408\u308f\u305b\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u30a8\u30ea\u30a2\u3067\u3053\u308c\u3089\u306e\u64cd\u4f5c\u3092\u7df4\u7fd2\u3057\u3066\u3001\u7b4b\u8089\u306e\u8a18\u61b6\u3092\u69cb\u7bc9\u3057\u307e\u3059\u3002\u4fbf\u5229\u306a\u30d2\u30f3\u30c8\u3068\u3057\u3066\u3001\u611f\u5ea6\u8a2d\u5b9a\u3092\u81ea\u5206\u306e\u5feb\u9069\u306a\u30ec\u30d9\u30eb\u306b\u8abf\u6574\u3057\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u64cd\u4f5c\u3092\u904b\u8ee2\u306e\u5b66\u7fd2\u306b\u4f8b\u3048\u308b\u3068\u3001\u6700\u521d\u306f\u3086\u3063\u304f\u308a\u3068\u3001\u81ea\u4fe1\u3092\u6301\u3064\u306b\u3064\u308c\u3066\u5f90\u3005\u306b\u901f\u5ea6\u3092\u4e0a\u3052\u3066\u3044\u304f\u3088\u3046\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30a2\u30fc\u30de\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u306e\u6226\u3044\u3067\u9577\u304f\u751f\u304d\u6b8b\u308b\u305f\u3081\u306e\u91cd\u8981\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30a2\u30fc\u30de\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u306e\u6226\u3044\u3067\u9577\u304f\u751f\u304d\u6b8b\u308b\u306b\u306f\u3001\u6226\u7565\u3068\u30b9\u30ad\u30eb\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5e38\u306b\u5468\u56f2\u306b\u6ce8\u610f\u3092\u6255\u3044\u3001\u30ab\u30d0\u30fc\u3092\u52b9\u679c\u7684\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u58c1\u306e\u5f8c\u308d\u306b\u96a0\u308c\u305f\u308a\u3001\u5927\u304d\u306a\u7269\u4f53\u3092\u4f7f\u3063\u3066\u6575\u306e\u653b\u6483\u304b\u3089\u8eab\u3092\u5b88\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30ea\u30bd\u30fc\u30b9\u3092\u8ce2\u304f\u7ba1\u7406\u3057\u307e\u3059\u3002\u5f3e\u85ac\u3084\u56de\u5fa9\u85ac\u3092\u7121\u99c4\u306b\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7af6\u4e89\u529b\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u3001\u5b9a\u671f\u7684\u306b\u30a2\u30fc\u30de\u30fc\u3068\u6b66\u5668\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u4e3b\u8981\u306a\u6b66\u5668\u3092\u6700\u521d\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3053\u3068\u3092\u512a\u5148\u3059\u308b\u65b9\u304c\u826f\u3044\u3067\u3057\u3087\u3046\u3002\u306a\u305c\u306a\u3089\u3001\u305d\u308c\u306f\u9632\u5fa1\u306e\u305f\u3081\u306e\u4e3b\u306a\u30c4\u30fc\u30eb\u3060\u304b\u3089\u3067\u3059\u3002[\u69d8\u3005\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\uff1a\u3042\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30b9\u30c6\u30eb\u30b9\u30a2\u30d7\u30ed\u30fc\u30c1\u3092\u597d\u3080\u4e00\u65b9\u3067\u3001\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u7a4d\u6975\u7684\u306a\u6226\u8853\u3092\u9078\u3073\u307e\u3059\u3002\u81ea\u5206\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u5408\u3063\u305f\u3082\u306e\u3092\u9078\u3093\u3067\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30a2\u30fc\u30de\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u3067\u3001\u3055\u307e\u3056\u307e\u306a\u6226\u95d8\u30b7\u30ca\u30ea\u30aa\u306b\u6700\u9069\u306a\u6b66\u5668\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30a2\u30fc\u30de\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u306e\u3055\u307e\u3056\u307e\u306a\u6226\u95d8\u30b7\u30ca\u30ea\u30aa\u3067\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u6b66\u5668\u304c\u9069\u3057\u3066\u3044\u307e\u3059\u3002\u8fd1\u63a5\u6226\u95d8\u3067\u306f\u3001\u300c\u30d6\u30fc\u30e0\u30b9\u30c6\u30a3\u30c3\u30af\u300d\u306e\u3088\u3046\u306a\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\u304c\u3001\u77ed\u8ddd\u96e2\u3067\u306e\u9ad8\u3044\u30c0\u30e1\u30fc\u30b8\u51fa\u529b\u306b\u3088\u308a\u975e\u5e38\u306b\u52b9\u679c\u7684\u3067\u3059\u3002\u9060\u8ddd\u96e2\u6226\u95d8\u3067\u306f\u3001\u300c\u30ed\u30f3\u30b0\u30b7\u30e7\u30c3\u30c8\u300d\u306e\u3088\u3046\u306a\u30b9\u30ca\u30a4\u30d1\u30fc\u30e9\u30a4\u30d5\u30eb\u304c\u3001\u9060\u8ddd\u96e2\u304b\u3089\u6575\u3092\u5012\u3059\u306e\u306b\u6700\u9069\u3067\u3059\u3002\u4e2d\u8ddd\u96e2\u6226\u95d8\u3067\u306f\u3001\u300c\u30b9\u30c8\u30e9\u30a4\u30ab\u30fc\u300d\u306e\u3088\u3046\u306a\u30a2\u30b5\u30eb\u30c8\u30e9\u30a4\u30d5\u30eb\u304c\u3001\u30c0\u30e1\u30fc\u30b8\u3068\u6b63\u78ba\u6027\u306e\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u6b66\u5668\u3068\u306a\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u901a\u8def\u306e\u72ed\u3044\u30de\u30c3\u30d7\u3067\u306f\u3001\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\u306f\u58ca\u6ec5\u7684\u306a\u5a01\u529b\u306b\u306a\u308a\u307e\u3059\u3002[\u6bd4\u8f03\u8868\uff1a\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3 - \u9ad8\u3044\u30c0\u30e1\u30fc\u30b8\u3001\u77ed\u8ddd\u96e2\uff1b\u30b9\u30ca\u30a4\u30d1\u30fc\u30e9\u30a4\u30d5\u30eb - \u9ad8\u3044\u7cbe\u5ea6\u3001\u9577\u8ddd\u96e2\uff1b\u30a2\u30b5\u30eb\u30c8\u30e9\u30a4\u30d5\u30eb - \u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u6027\u80fd\u3001\u4e2d\u8ddd\u96e2\u3002]"}, {"question": "\u30a2\u30fc\u30de\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u306e\u30a2\u30fc\u30de\u30fc\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u304b\uff1f", "answer": "\u30a2\u30fc\u30de\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u306e\u30a2\u30fc\u30de\u30fc\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u751f\u5b58\u529b\u3068\u6226\u95d8\u80fd\u529b\u3092\u5f37\u5316\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u5927\u304d\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u30a2\u30fc\u30de\u30fc\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3068\u3001\u3042\u306a\u305f\u306e\u4f53\u529b\u3068\u30c0\u30e1\u30fc\u30b8\u306b\u5bfe\u3059\u308b\u8010\u6027\u304c\u5411\u4e0a\u3057\u3001\u6226\u95d8\u3067\u3088\u308a\u591a\u304f\u306e\u30d2\u30c3\u30c8\u3092\u8010\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30d8\u30d3\u30fc\u30d7\u30ec\u30fc\u30c8\u300d\u30a2\u30fc\u30de\u30fc\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3068\u3001\u56f0\u96e3\u306a\u6226\u95d8\u3067\u3001\u6575\u3092\u51cc\u99d5\u3059\u308b\u305f\u3081\u306b\u5fc5\u8981\u306a\u8010\u4e45\u6027\u304c\u5f97\u3089\u308c\u3001\u6226\u6cc1\u3092\u8ee2\u63db\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u7279\u5b9a\u306e\u30a2\u30fc\u30de\u30fc\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u3088\u3063\u3066\u3001\u79fb\u52d5\u901f\u5ea6\u5411\u4e0a\u3084\u56de\u5fa9\u901f\u5ea6\u5411\u4e0a\u306a\u3069\u306e\u7279\u5225\u306a\u80fd\u529b\u304c\u89e3\u7981\u3055\u308c\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u30a2\u30fc\u30de\u30fc\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u3001\u9a0e\u58eb\u304c\u3088\u308a\u91cd\u539a\u306a\u30d7\u30ec\u30fc\u30c8\u30e1\u30a4\u30eb\u3092\u7740\u7528\u3057\u3066\u9632\u5fa1\u529b\u3092\u9ad8\u3081\u308b\u3088\u3046\u306b\u3001\u4fdd\u8b77\u306e\u5c64\u3092\u8ffd\u52a0\u3059\u308b\u306e\u3060\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30a2\u30fc\u30de\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u3067\u3001\u30de\u30c3\u30d7\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u306a\u305c\u91cd\u8981\u3067\u3059\u304b\uff1f", "answer": "\u30a2\u30fc\u30de\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u3067\u30de\u30c3\u30d7\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u6226\u7565\u7684\u306a\u914d\u7f6e\u3068\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u3092\u53ef\u80fd\u306b\u3059\u308b\u305f\u3081\u3001\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u91cd\u8981\u306a\u5834\u6240\uff08\u56de\u5fa9\u85ac\u3001\u5f3e\u85ac\u3001\u9698\u8def\u306a\u3069\uff09\u306e\u4f4d\u7f6e\u3092\u77e5\u3063\u3066\u3044\u308c\u3070\u3001\u5927\u304d\u306a\u30a2\u30c9\u30d0\u30f3\u30c6\u30fc\u30b8\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30ad\u30e3\u30cb\u30aa\u30f3\u30af\u30e9\u30c3\u30b7\u30e5\u300d\u306e\u3088\u3046\u306a\u30de\u30c3\u30d7\u3067\u9ad8\u5730\u3092\u652f\u914d\u3059\u308c\u3070\u3001\u6575\u3092\u5c04\u6483\u3059\u308b\u6226\u8853\u7684\u306a\u6709\u5229\u306a\u5834\u6240\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u8131\u51fa\u30eb\u30fc\u30c8\u3084\u5074\u9762\u653b\u6483\u7d4c\u8def\u3092\u628a\u63e1\u3057\u3066\u304a\u3051\u3070\u3001\u5f85\u3061\u4f0f\u305b\u3092\u56de\u907f\u3057\u3001\u6575\u3092\u5947\u8972\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u51fa\u9663\u30dd\u30a4\u30f3\u30c8\u2192\u91cd\u8981\u306a\u5834\u6240\u3092\u7279\u5b9a\u3059\u308b\u2192\u79fb\u52d5\u30eb\u30fc\u30c8\u3092\u8a08\u753b\u3059\u308b\u2192\u6226\u7565\u3092\u5b9f\u884c\u3059\u308b\u3002]"}, {"question": "\u30a2\u30fc\u30de\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u306ePvP\u30e2\u30fc\u30c9\u3068PvE\u30e2\u30fc\u30c9\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30a2\u30fc\u30de\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u306ePvP\uff08\u30d7\u30ec\u30a4\u30e4\u30fc\u5bfe\u30d7\u30ec\u30a4\u30e4\u30fc\uff09\u30e2\u30fc\u30c9\u3068PvE\uff08\u30d7\u30ec\u30a4\u30e4\u30fc\u5bfe\u74b0\u5883\uff09\u30e2\u30fc\u30c9\u306e\u4e3b\u306a\u9055\u3044\u306f\u3001\u76ee\u6a19\u3068\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u30c0\u30a4\u30ca\u30df\u30af\u30b9\u306b\u3042\u308a\u307e\u3059\u3002PvP\u3067\u306f\u3001\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u51fa\u3057\u629c\u3044\u3066\u6253\u3061\u8ca0\u304b\u3059\u3053\u3068\u306b\u7126\u70b9\u3092\u5f53\u3066\u3001\u7d20\u65e9\u3044\u53cd\u5fdc\u3068\u6226\u7565\u7684\u601d\u8003\u304c\u5fc5\u8981\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001PvP\u306e\u8a66\u5408\u3067\u306f\u3001\u6575\u306e\u52d5\u304d\u3092\u4e88\u6e2c\u3057\u3001\u30ab\u30d0\u30fc\u3092\u52b9\u679c\u7684\u306b\u4f7f\u3046\u5fc5\u8981\u304c\u3042\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002PvE\u3067\u306f\u3001AI\u5236\u5fa1\u306e\u6575\u3092\u5012\u3057\u3001\u30df\u30c3\u30b7\u30e7\u30f3\u76ee\u6a19\u3092\u9054\u6210\u3059\u308b\u3053\u3068\u306b\u6311\u6226\u3059\u308b\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u591a\u304f\u306e\u5834\u5408\u3001\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u3068\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u304c\u5fc5\u8981\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001PvE\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u6575\u306e\u653b\u6483\u306e\u6ce2\u304b\u3089\u57fa\u5730\u3092\u5b88\u308b\u5fc5\u8981\u304c\u3042\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002[\u6bd4\u8f03\u8868\uff1aPvP\u306f\u7af6\u4e89\u3092\u91cd\u8996\u3059\u308b\u306e\u306b\u5bfe\u3057\u3001PvE\u306f\u5354\u529b\u3068\u30df\u30c3\u30b7\u30e7\u30f3\u9054\u6210\u3092\u91cd\u8996\u3057\u307e\u3059\u3002]"}, {"question": "\u30a2\u30fc\u30de\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u3067\u3001\u7279\u5b9a\u306e\u30df\u30c3\u30b7\u30e7\u30f3\u306b\u6700\u9069\u306a\u88c5\u5099\u3092\u3069\u306e\u3088\u3046\u306b\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30a2\u30fc\u30de\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u3067\u7279\u5b9a\u306e\u30df\u30c3\u30b7\u30e7\u30f3\u306b\u6700\u9069\u306a\u88c5\u5099\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u30df\u30c3\u30b7\u30e7\u30f3\u306e\u8981\u4ef6\u306b\u5408\u3046\u3088\u3046\u306b\u3001\u6b66\u5668\u3001\u30a2\u30fc\u30de\u30fc\u3001\u30ac\u30b8\u30a7\u30c3\u30c8\u306e\u9069\u5207\u306a\u7d44\u307f\u5408\u308f\u305b\u3092\u9078\u629e\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30df\u30c3\u30b7\u30e7\u30f3\u76ee\u6a19\u3068\u6575\u306e\u7a2e\u985e\u3092\u5206\u6790\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30df\u30c3\u30b7\u30e7\u30f3\u304c\u8fd1\u63a5\u6226\u95d8\u3067\u3042\u308b\u5834\u5408\u3001\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\u3068\u8efd\u88c5\u5099\u3092\u88c5\u5099\u3057\u3066\u3001\u6a5f\u52d5\u529b\u3092\u9ad8\u3081\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u3084\u30df\u30c3\u30b7\u30e7\u30f3\u306e\u30cb\u30fc\u30ba\u306b\u5408\u308f\u305b\u3066\u3001\u30b0\u30ec\u30cd\u30fc\u30c9\u306b\u3088\u308b\u30a8\u30ea\u30a2\u5236\u5727\u3084\u56de\u5fa9\u85ac\u306b\u3088\u308b\u6cbb\u7642\u306a\u3069\u3001\u30ac\u30b8\u30a7\u30c3\u30c8\u3082\u9078\u629e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u88c5\u5099\u304c\u52b9\u679c\u7684\u3067\u3042\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3059\u308b\u305f\u3081\u306b\u3001\u7df4\u7fd2\u30e2\u30fc\u30c9\u3067\u30c6\u30b9\u30c8\u3057\u307e\u3059\u3002[\u6bd4\u8f03\u8868\uff1a\u8fd1\u63a5\u6226\u95d8\u30df\u30c3\u30b7\u30e7\u30f3 - \u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\u3001\u8efd\u88c5\u5099\u3001\u30b0\u30ec\u30cd\u30fc\u30c9\uff1b\u9060\u8ddd\u96e2\u30df\u30c3\u30b7\u30e7\u30f3 - \u30b9\u30ca\u30a4\u30d1\u30fc\u30e9\u30a4\u30d5\u30eb\u3001\u91cd\u88c5\u5099\u3001\u56de\u5fa9\u85ac\u3002]"}, {"question": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u30a2\u30fc\u30de\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u3092\u30b9\u30e0\u30fc\u30ba\u306b\u5b9f\u884c\u3059\u308b\u305f\u3081\u306e\u30b7\u30b9\u30c6\u30e0\u8981\u4ef6\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u30a2\u30fc\u30de\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u3092\u30b9\u30e0\u30fc\u30ba\u306b\u5b9f\u884c\u3059\u308b\u306b\u306f\u3001\u7279\u5b9a\u306e\u30b7\u30b9\u30c6\u30e0\u8981\u4ef6\u3092\u6e80\u305f\u3059\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002PC\u306e\u5834\u5408\u3001Intel i5\u30d7\u30ed\u30bb\u30c3\u30b5\u30018GB RAM\u3001GTX 1050\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u30ab\u30fc\u30c9\u306e\u6700\u5c0f\u8981\u4ef6\u304c\u63a8\u5968\u3055\u308c\u307e\u3059\u3002PlayStation 5\u3084Xbox Series X\u306a\u3069\u306e\u30b3\u30f3\u30bd\u30fc\u30eb\u3067\u306f\u3001\u30b2\u30fc\u30e0\u306f\u30c7\u30d5\u30a9\u30eb\u30c8\u8a2d\u5b9a\u3067\u6700\u9069\u306b\u52d5\u4f5c\u3057\u307e\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u306e\u5834\u5408\u3001\u5c11\u306a\u304f\u3068\u30824GB RAM\u3068Snapdragon 835\u30d7\u30ed\u30bb\u30c3\u30b5\u642d\u8f09\u306e\u30c7\u30d0\u30a4\u30b9\u3092\u304a\u52e7\u3081\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001i7\u30d7\u30ed\u30bb\u30c3\u30b5\u306816GB RAM\u3092\u642d\u8f09\u3057\u305fPC\u3067\u306f\u3001\u9ad8\u8a2d\u5b9a\u3067\u30b9\u30e0\u30fc\u30ba\u306a\u30d5\u30ec\u30fc\u30e0\u30ec\u30fc\u30c8\u3092\u697d\u3057\u3080\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03\u8868\uff1aPC - Intel i5\u30018GB RAM\u3001GTX 1050\uff1b\u30b3\u30f3\u30bd\u30fc\u30eb - PS5/Xbox Series X\u306f\u30c7\u30d5\u30a9\u30eb\u30c8\u8a2d\u5b9a\uff1b\u30e2\u30d0\u30a4\u30eb - Snapdragon 835\u30014GB RAM\u3002]"}, {"question": "\u30a2\u30fc\u30de\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u3067\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u8907\u6570\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u9032\u6357\u72b6\u6cc1\u3092\u3069\u306e\u3088\u3046\u306b\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30a2\u30fc\u30de\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u3067\u3001\u8907\u6570\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u9032\u6357\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001\u30b2\u30fc\u30e0\u306e\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u4fdd\u5b58\u6a5f\u80fd\u304c\u4fbf\u5229\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u4e21\u65b9\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u306b\u79fb\u52d5\u3057\u3001\u300c\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u300d\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u73fe\u5728\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u304b\u3089\u4fdd\u5b58\u30c7\u30fc\u30bf\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3057\u3001\u65b0\u3057\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001PC\u304b\u3089PlayStation\u306b\u79fb\u52d5\u3059\u308b\u5834\u5408\u3001PC\u3067\u4fdd\u5b58\u30c7\u30fc\u30bf\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3057\u3001PlayStation\u3067\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u306f\u3001\u9032\u6357\u72b6\u6cc1\u3092\u3069\u3053\u306b\u3067\u3082\u6301\u3061\u904b\u3079\u308b\u30c7\u30b8\u30bf\u30eb\u306a\u30ea\u30e5\u30c3\u30af\u30b5\u30c3\u30af\u3060\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30a2\u30fc\u30de\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u3067\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3069\u306e\u3088\u3046\u306a\u96a0\u3055\u308c\u305f\u79d8\u5bc6\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30a2\u30fc\u30de\u30fc\u30af\u30e9\u30c3\u30b7\u30e5\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u79d8\u5bc6\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u6e80\u8f09\u3055\u308c\u3066\u304a\u308a\u3001\u597d\u5947\u5fc3\u65fa\u76db\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u5831\u916c\u3067\u6e80\u305f\u3057\u3066\u3044\u307e\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306e1\u3064\u306f\u3001\u300c\u30c7\u30b6\u30fc\u30c8\u30c7\u30e5\u30fc\u30f3\u30ba\u300d\u30de\u30c3\u30d7\u306b\u3042\u308b\u300c\u30b4\u30fc\u30eb\u30c7\u30f3\u30bf\u30f3\u30af\u300d\u3067\u3059\u3002\u305d\u308c\u3092\u63a2\u3059\u306b\u306f\u3001\u5fae\u5999\u306a\u74b0\u5883\u306e\u30d2\u30f3\u30c8\uff08\u4f8b\u3048\u3070\u3001\u5947\u5999\u306a\u5ca9\u306e\u5f62\u6210\uff09\u306b\u5f93\u3063\u305f\u7279\u5b9a\u306e\u30d1\u30b9\u306b\u5f93\u3046\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3082\u30461\u3064\u306e\u79d8\u5bc6\u306f\u3001\u300c\u30a2\u30fc\u30d0\u30f3\u30eb\u30a4\u30f3\u30ba\u300d\u30de\u30c3\u30d7\u306b\u3042\u308b\u300c\u30df\u30b9\u30c6\u30ea\u30fc\u30eb\u30fc\u30e0\u300d\u3067\u3001\u73cd\u3057\u3044\u6226\u5229\u54c1\u3068\u30e6\u30cb\u30fc\u30af\u306a\u6b66\u5668\u30b9\u30ad\u30f3\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u79d8\u5bc6\u3092\u767a\u898b\u3059\u308b\u306b\u306f\u3001\u92ed\u3044\u89b3\u5bdf\u529b\u3068\u63a2\u6c42\u5fc3\u304c\u6b20\u304b\u305b\u307e\u305b\u3093\u3002[\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\uff1a \u300c\u30b4\u30fc\u30eb\u30c7\u30f3\u30bf\u30f3\u30af\u300d\u306f\u30af\u30e9\u30b7\u30c3\u30af\u306a\u6226\u8eca\u30b2\u30fc\u30e0\u3078\u306e\u30aa\u30de\u30fc\u30b8\u30e5\u3067\u3042\u308a\u3001\u300c\u30df\u30b9\u30c6\u30ea\u30fc\u30eb\u30fc\u30e0\u300d\u306f\u71b1\u5fc3\u306a\u63a2\u6c42\u8005\u306b\u3068\u3063\u3066\u5b9d\u7269\u3067\u3059\u3002]"}]
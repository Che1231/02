[{"question": "\u5982\u4f55\u4f5c\u70ba\u65b0\u624b\u5728\u5f48\u7c27\u5f13\u7bad\u624b\u904a\u6232\u4e2d\u57f7\u884c\u57fa\u672c\u5c04\u64ca\u52d5\u4f5c\uff1f", "answer": "\u5728\u5f48\u7c27\u5f13\u7bad\u624b\u904a\u6232\u4e2d\u57f7\u884c\u57fa\u672c\u5c04\u64ca\u52d5\u4f5c\uff0c\u8acb\u6309\u7167\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u5728\u87a2\u5e55\u4e0a\u6309\u4f4f\u624b\u6307\u62c9\u5f13\u3002\u6b65\u9a5f2\uff1a\u900f\u904e\u62d6\u66f3\u624b\u6307\u5230\u76ee\u6a19\u65b9\u5411\u9032\u884c\u7784\u6e96\u3002\u6b65\u9a5f3\uff1a\u653e\u958b\u624b\u6307\u767c\u5c04\u7bad\u77e2\u3002\u4f8b\u5982\uff0c\u7a0d\u5fae\u5411\u4e0a\u7784\u6e96\u53ef\u4ee5\u5f4c\u88dc\u91cd\u529b\u5f71\u97ff\u3002\u6b64\u65b9\u6cd5\u5c0d\u65bc\u65b0\u73a9\u5bb6\u719f\u6089\u904a\u6232\u6a5f\u5236\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u5728\u5f48\u7c27\u5f13\u7bad\u624b\u904a\u6232\u4e2d\uff0c\u8abf\u6574\u5c04\u64ca\u89d2\u5ea6\u70ba\u4f55\u91cd\u8981\uff1f", "answer": "\u5728\u5f48\u7c27\u5f13\u7bad\u624b\u904a\u6232\u4e2d\uff0c\u8abf\u6574\u5c04\u64ca\u89d2\u5ea6\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6703\u5f71\u97ff\u7bad\u77e2\u7684\u8ecc\u8de1\u3002\u4f8b\u5982\uff0c\u4ee5 45 \u5ea6\u89d2\u5c04\u64ca\u53ef\u4ee5\u6700\u5927\u5316\u7bad\u77e2\u7684\u98db\u884c\u8ddd\u96e2\u3002\u6b64\u6280\u5de7\u5728\u7784\u6e96\u9060\u8655\u7684\u6575\u4eba\u6216\u76ee\u6a19\u6642\u7279\u5225\u6709\u7528\u3002\u4e86\u89e3\u9019\u500b\u6982\u5ff5\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u4f60\u5728\u904a\u6232\u4e2d\u7684\u6e96\u78ba\u6027\u548c\u6548\u7387\u3002"}, {"question": "\u5728\u5f48\u7c27\u5f13\u7bad\u624b\u904a\u6232\u4e2d\u64ca\u4e2d\u79fb\u52d5\u76ee\u6a19\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u5f48\u7c27\u5f13\u7bad\u624b\u904a\u6232\u4e2d\u64ca\u4e2d\u79fb\u52d5\u76ee\u6a19\uff0c\u8acb\u8003\u616e\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9a5f1\uff1a\u9810\u6e2c\u76ee\u6a19\u7684\u79fb\u52d5\u8def\u5f91\u3002\u6b65\u9a5f2\uff1a\u7784\u6e96\u76ee\u6a19\u524d\u65b9\u4e00\u9ede\uff0c\u4ee5\u8003\u616e\u5176\u901f\u5ea6\u3002\u6b65\u9a5f3\uff1a\u6839\u64da\u76ee\u6a19\u7684\u52a0\u901f\u5ea6\u8abf\u6574\u5c04\u64ca\u6642\u6a5f\u3002\u4f8b\u5982\uff0c\u5982\u679c\u6575\u4eba\u5411\u5de6\u79fb\u52d5\uff0c\u5247\u7784\u6e96\u5176\u76ee\u524d\u4f4d\u7f6e\u5de6\u5074\u3002\u9019\u7a2e\u65b9\u6cd5\u53ef\u4ee5\u63d0\u9ad8\u4f60\u6301\u7e8c\u64ca\u4e2d\u79fb\u52d5\u76ee\u6a19\u7684\u6a5f\u7387\u3002"}, {"question": "\u54ea\u4e9b\u9032\u968e\u6280\u5de7\u53ef\u4ee5\u63d0\u5347\u6211\u5728\u5f48\u7c27\u5f13\u7bad\u624b\u904a\u6232\u4e2d\u7684\u6e96\u78ba\u5ea6\uff1f", "answer": "\u63d0\u5347\u5f48\u7c27\u5f13\u7bad\u624b\u904a\u6232\u4e2d\u6e96\u78ba\u5ea6\u7684\u9032\u968e\u6280\u5de7\u5305\u62ec\uff1a\u6b65\u9a5f1\uff1a\u7cbe\u78ba\u638c\u63e1\u5c04\u64ca\u6642\u6a5f\u3002\u6b65\u9a5f2\uff1a\u5229\u7528\u904a\u6232\u7684\u7269\u7406\u5f15\u64ce\u9810\u6e2c\u7bad\u77e2\u8ecc\u8de1\u3002\u6b65\u9a5f3\uff1a\u91dd\u5c0d\u4e0d\u540c\u8ddd\u96e2\u7df4\u7fd2\u4e00\u81f4\u7684\u5c04\u64ca\u89d2\u5ea6\u3002\u4f8b\u5982\uff0c\u7df4\u7fd2\u4e0d\u540c\u8ddd\u96e2\u7684\u5c04\u64ca\u53ef\u4ee5\u5e6b\u52a9\u4f60\u638c\u63e1\u904a\u6232\u7684\u6a5f\u5236\u3002\u9019\u4e9b\u6280\u5de7\u5c0d\u65bc\u5e0c\u671b\u589e\u5f37\u904a\u6232\u9ad4\u9a57\u7684\u73a9\u5bb6\u4f86\u8aaa\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u5982\u4f55\u5728\u5f48\u7c27\u5f13\u7bad\u624b\u904a\u6232\u4e2d\u6709\u6548\u4f7f\u7528\u589e\u76ca\u9053\u5177\uff1f", "answer": "\u5728\u5f48\u7c27\u5f13\u7bad\u624b\u904a\u6232\u4e2d\u6709\u6548\u4f7f\u7528\u589e\u76ca\u9053\u5177\uff0c\u8acb\u6309\u7167\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u8fa8\u5225\u589e\u76ca\u9053\u5177\u985e\u578b\uff08\u4f8b\u5982\uff0c\u7206\u70b8\u7bad\u77e2\u3001\u6162\u52d5\u4f5c\uff09\u3002\u6b65\u9a5f2\uff1a\u5728\u6700\u9069\u7576\u7684\u6642\u6a5f\u555f\u52d5\u589e\u76ca\u9053\u5177\uff0c\u4ee5\u7372\u5f97\u6700\u5927\u6548\u76ca\u3002\u6b65\u9a5f3\uff1a\u5c07\u589e\u76ca\u9053\u5177\u8207\u7b56\u7565\u6027\u5c04\u64ca\u7d50\u5408\uff0c\u4ee5\u7372\u5f97\u66f4\u4f73\u6548\u679c\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u7206\u70b8\u7bad\u77e2\u5c0d\u4ed8\u805a\u96c6\u7684\u6575\u4eba\u53ef\u4ee5\u4e00\u6b21\u6e05\u9664\u591a\u500b\u76ee\u6a19\u3002\u6b64\u7b56\u7565\u53ef\u5728\u5177\u6709\u6311\u6230\u6027\u7684\u95dc\u5361\u4e2d\u986f\u8457\u63d0\u5347\u4f60\u7684\u8868\u73fe\u3002"}, {"question": "\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u5728\u5f48\u7c27\u5f13\u7bad\u624b\u904a\u6232\u4e2d\u7684\u4e3b\u8981\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5f48\u7c27\u5f13\u7bad\u624b\u904a\u6232\u4e2d\uff0c\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u7684\u4e3b\u8981\u5dee\u7570\u5305\u62ec\uff1a1. \u55ae\u4eba\u6a21\u5f0f\u91cd\u9ede\u5728\u65bc\u500b\u4eba\u6280\u80fd\u548c\u9032\u5ea6\uff0c\u800c\u591a\u4eba\u6a21\u5f0f\u5247\u5f37\u8abf\u7af6\u722d\u548c\u5718\u968a\u5408\u4f5c\u30022. \u5728\u55ae\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f60\u9762\u5c0d\u7684\u662f\u4eba\u5de5\u667a\u6167\u63a7\u5236\u7684\u6575\u4eba\uff0c\u800c\u591a\u4eba\u6a21\u5f0f\u5247\u6d89\u53ca\u8207\u5176\u4ed6\u73a9\u5bb6\u9032\u884c\u5be6\u6642\u7684\u6230\u9b25\u30023. \u591a\u4eba\u6a21\u5f0f\u901a\u5e38\u5305\u542b\u55ae\u4eba\u6a21\u5f0f\u4e2d\u6c92\u6709\u7684\u7368\u7279\u6311\u6230\u548c\u734e\u52f5\u3002\u4f8b\u5982\uff0c\u591a\u4eba\u6a21\u5f0f\u53ef\u80fd\u6703\u5f15\u5165\u7279\u6b8a\u6d3b\u52d5\u548c\u6392\u884c\u699c\u3002\u4e86\u89e3\u9019\u4e9b\u5dee\u7570\u53ef\u4ee5\u5e6b\u52a9\u4f60\u9078\u64c7\u6700\u9069\u5408\u4f60\u7684\u904a\u6232\u98a8\u683c\u7684\u6a21\u5f0f\u3002"}, {"question": "\u5f48\u7c27\u5f13\u7bad\u624b\u904a\u6232\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u5982\u4f55\u5f71\u97ff\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u5f48\u7c27\u5f13\u7bad\u624b\u904a\u6232\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u900f\u904e\u6a21\u64ec\u771f\u5be6\u7684\u7bad\u77e2\u8ecc\u8de1\u548c\u5f48\u7c27\u53cd\u61c9\u4f86\u986f\u8457\u5f71\u97ff\u904a\u6232\u9ad4\u9a57\u3002\u4f8b\u5982\uff0c\u7bad\u77e2\u6703\u53d7\u5230\u91cd\u529b\u548c\u98a8\u7684\u5f71\u97ff\uff0c\u56e0\u6b64\u73a9\u5bb6\u9700\u8981\u76f8\u61c9\u8abf\u6574\u7784\u6e96\u3002\u6b64\u5916\uff0c\u5f48\u7c27\u7269\u7406\u5f15\u64ce\u4e5f\u8b93\u6575\u4eba\u7684\u79fb\u52d5\u8b8a\u5f97\u4e0d\u53ef\u9810\u6e2c\uff0c\u589e\u52a0\u4e86\u6311\u6230\u6027\u3002\u4e86\u89e3\u9019\u4e9b\u6a5f\u5236\u53ef\u4ee5\u5e6b\u52a9\u4f60\u9032\u884c\u66f4\u6e96\u78ba\u7684\u5c04\u64ca\uff0c\u4e26\u9810\u6e2c\u6575\u4eba\u7684\u884c\u70ba\u3002"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u904b\u884c\u5f48\u7c27\u5f13\u7bad\u624b\u904a\u6232\u7684\u7cfb\u7d71\u9700\u6c42\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u904b\u884c\u5f48\u7c27\u5f13\u7bad\u624b\u904a\u6232\u7684\u7cfb\u7d71\u9700\u6c42\u6709\u6240\u4e0d\u540c\uff1a1. iOS\uff1a\u9700\u8981 iOS 10.0 \u6216\u66f4\u9ad8\u7248\u672c\uff0c\u8207 iPhone\u3001iPad \u548c iPod touch \u76f8\u5bb9\u30022. Android\uff1a\u9700\u8981 Android 5.0 \u6216\u66f4\u9ad8\u7248\u672c\uff0c\u4e14\u81f3\u5c11\u64c1\u6709 2GB \u7684 RAM\u30023. \u96fb\u8166\uff1a\u9700\u8981 Windows 7 \u6216\u66f4\u9ad8\u7248\u672c\uff0c\u914d\u5099\u96d9\u6838\u5fc3\u8655\u7406\u5668\u548c 4GB \u7684 RAM\u3002\u4f8b\u5982\uff0c\u78ba\u4fdd\u4f60\u7684\u8a2d\u5099\u7b26\u5408\u9019\u4e9b\u898f\u683c\u53ef\u4ee5\u907f\u514d\u6548\u80fd\u554f\u984c\uff0c\u4e26\u63d0\u5347\u4f60\u7684\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u5982\u4f55\u5c07\u6211\u7684\u5f48\u7c27\u5f13\u7bad\u624b\u904a\u6232\u9032\u5ea6\u5f9e\u4e00\u500b\u88dd\u7f6e\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u88dd\u7f6e\uff1f", "answer": "\u8981\u5c07\u4f60\u7684\u5f48\u7c27\u5f13\u7bad\u624b\u904a\u6232\u9032\u5ea6\u5f9e\u4e00\u500b\u88dd\u7f6e\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u88dd\u7f6e\uff0c\u8acb\u6309\u7167\u4e0b\u5217\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u78ba\u4fdd\u4f60\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u90fd\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\uff08\u4f8b\u5982\uff0cGoogle Play\u3001Apple ID\uff09\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u904a\u6232\u7684\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u5c07\u4f60\u7684\u9032\u5ea6\u4e0a\u50b3\u3002\u6b65\u9a5f3\uff1a\u5728\u65b0\u88dd\u7f6e\u4e0a\u4e0b\u8f09\u904a\u6232\uff0c\u4e26\u767b\u5165\u4ee5\u6062\u5fa9\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u5f9e\u820a iPhone \u8f49\u79fb\u9032\u5ea6\u5230\u65b0\u7684 Android \u88dd\u7f6e\uff0c\u5982\u679c\u5169\u500b\u5e33\u6236\u90fd\u9023\u7d50\uff0c\u53ef\u4ee5\u9806\u5229\u5b8c\u6210\u3002\u6b64\u65b9\u6cd5\u53ef\u4ee5\u78ba\u4fdd\u4f60\u4e0d\u6703\u907a\u5931\u4f60\u8f9b\u8f9b\u82e6\u82e6\u53d6\u5f97\u7684\u6210\u5c31\u3002"}, {"question": "\u5728\u5f48\u7c27\u5f13\u7bad\u624b\u904a\u6232\u4e2d\uff0c\u6211\u6709\u54ea\u4e9b\u53ef\u4ee5\u767c\u73fe\u7684\u96b1\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "\u5f48\u7c27\u5f13\u7bad\u624b\u904a\u6232\u5305\u542b\u4e00\u4e9b\u96b1\u85cf\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u4f8b\u5982\uff1a1. \u5b8c\u6210\u7279\u5b9a\u6311\u6230\u5f8c\u89e3\u9396\u7684\u79d8\u5bc6\u95dc\u5361\u30022. \u5b8c\u6210\u7279\u5b9a\u91cc\u7a0b\u7891\u5f8c\u53ef\u4ee5\u89e3\u9396\u7684\u96b1\u85cf\u89d2\u8272\u30023. \u53c3\u8003\u6d41\u884c\u6587\u5316\u6216\u5176\u4ed6\u904a\u6232\u7684\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u627e\u5230\u96b1\u85cf\u7684\u91d1\u7bad\u53ef\u4ee5\u89e3\u9396\u5177\u6709\u7368\u7279\u734e\u52f5\u7684\u7279\u6b8a\u95dc\u5361\u3002\u63a2\u7d22\u9019\u4e9b\u96b1\u85cf\u5143\u7d20\u53ef\u4ee5\u70ba\u4f60\u7684\u904a\u6232\u9ad4\u9a57\u589e\u6dfb\u984d\u5916\u7684\u8da3\u5473\u3002"}]
[{"question": "\u30e9\u30b0\u30c9\u30fc\u30eb\u30a2\u30fc\u30c1\u30e3\u30fc\u306e\u521d\u5fc3\u8005\u5411\u3051\u306e\u57fa\u672c\u7684\u306a\u5c04\u6483\u306f\u3069\u306e\u3088\u3046\u306b\u884c\u3046\u306e\u3067\u3059\u304b\uff1f", "answer": "\u30e9\u30b0\u30c9\u30fc\u30eb\u30a2\u30fc\u30c1\u30e3\u30fc\u306e\u57fa\u672c\u7684\u306a\u5c04\u6483\u3092\u884c\u3046\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u5f13\u3092\u5f15\u304f\u305f\u3081\u306b\u753b\u9762\u306b\u89e6\u308c\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6307\u3092\u30c9\u30e9\u30c3\u30b0\u3057\u3066\u76ee\u6a19\u3092\u5b9a\u3081\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6307\u3092\u96e2\u3057\u3066\u77e2\u3092\u653e\u3064\u3002\u4f8b\u3048\u3070\u3001\u76ee\u6a19\u306e\u4e0a\u90e8\u306b\u5c11\u3057\u305a\u3089\u3057\u3066\u72d9\u3046\u3053\u3068\u3067\u3001\u91cd\u529b\u306b\u3088\u308b\u5f71\u97ff\u3092\u88dc\u6b63\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u65b9\u6cd5\u306f\u3001\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30b2\u30fc\u30e0\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u6163\u308c\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002"}, {"question": "\u30e9\u30b0\u30c9\u30fc\u30eb\u30a2\u30fc\u30c1\u30e3\u30fc\u3067\u5c04\u6483\u89d2\u5ea6\u3092\u8abf\u6574\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u30e9\u30b0\u30c9\u30fc\u30eb\u30a2\u30fc\u30c1\u30e3\u30fc\u3067\u5c04\u6483\u89d2\u5ea6\u3092\u8abf\u6574\u3059\u308b\u3053\u3068\u306f\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u306a\u305c\u306a\u3089\u3001\u77e2\u306e\u8ecc\u9053\u3092\u5909\u5316\u3055\u305b\u308b\u304b\u3089\u3067\u3059\u3002\u4f8b\u3048\u3070\u300145\u5ea6\u306e\u89d2\u5ea6\u3067\u5c04\u6483\u3059\u308b\u3053\u3068\u3067\u3001\u77e2\u306e\u5230\u9054\u8ddd\u96e2\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u6280\u8853\u306f\u3001\u9060\u304f\u306e\u6575\u3084\u7269\u4f53\u3092\u72d9\u3046\u969b\u306b\u7279\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u3053\u306e\u6982\u5ff5\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u3067\u306e\u7cbe\u5ea6\u3068\u52b9\u7387\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30e9\u30b0\u30c9\u30fc\u30eb\u30a2\u30fc\u30c1\u30e3\u30fc\u3067\u52d5\u304f\u76ee\u6a19\u3092\u78ba\u5b9f\u306b\u547d\u4e2d\u3055\u305b\u308b\u305f\u3081\u306e\u6700\u9069\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30e9\u30b0\u30c9\u30fc\u30eb\u30a2\u30fc\u30c1\u30e3\u30fc\u3067\u52d5\u304f\u76ee\u6a19\u3092\u547d\u4e2d\u3055\u305b\u308b\u305f\u3081\u306e\u6226\u7565\u306f\u4ee5\u4e0b\u306e\u901a\u308a\u3067\u3059\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u30bf\u30fc\u30b2\u30c3\u30c8\u306e\u79fb\u52d5\u7d4c\u8def\u3092\u4e88\u6e2c\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30bf\u30fc\u30b2\u30c3\u30c8\u306e\u901f\u5ea6\u3092\u8003\u616e\u3057\u3066\u3001\u5c11\u3057\u5148\u3078\u76ee\u6a19\u3092\u5b9a\u3081\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30bf\u30fc\u30b2\u30c3\u30c8\u306e\u52a0\u901f\u5ea6\u306b\u57fa\u3065\u3044\u3066\u5c04\u6483\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u8abf\u6574\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u6575\u304c\u5de6\u306b\u52d5\u3044\u3066\u3044\u308b\u5834\u5408\u3001\u73fe\u5728\u306e\u4f4d\u7f6e\u306e\u5de6\u5074\u306b\u76ee\u6a19\u3092\u5b9a\u3081\u308b\u3002\u3053\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u306b\u3088\u308a\u3001\u7740\u5b9f\u306b\u52d5\u304f\u76ee\u6a19\u3092\u547d\u4e2d\u3055\u305b\u308b\u78ba\u7387\u304c\u9ad8\u307e\u308a\u307e\u3059\u3002"}, {"question": "\u30e9\u30b0\u30c9\u30fc\u30eb\u30a2\u30fc\u30c1\u30e3\u30fc\u3067\u7cbe\u5ea6\u3092\u9ad8\u3081\u308b\u305f\u3081\u306e\u9ad8\u5ea6\u306a\u6280\u8853\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30e9\u30b0\u30c9\u30fc\u30eb\u30a2\u30fc\u30c1\u30e3\u30fc\u3067\u7cbe\u5ea6\u3092\u9ad8\u3081\u308b\u305f\u3081\u306e\u9ad8\u5ea6\u306a\u6280\u8853\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u5c04\u6483\u3059\u308b\u6280\u8853\u3092\u7fd2\u5f97\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b2\u30fc\u30e0\u306e\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u3092\u6d3b\u7528\u3057\u3066\u77e2\u306e\u8ecc\u9053\u3092\u4e88\u6e2c\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u3055\u307e\u3056\u307e\u306a\u8ddd\u96e2\u306b\u5bfe\u3057\u3066\u4e00\u8cab\u3057\u305f\u5c04\u6483\u89d2\u5ea6\u3092\u7df4\u7fd2\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u3055\u307e\u3056\u307e\u306a\u8ddd\u96e2\u3067\u5c04\u6483\u306e\u7df4\u7fd2\u3092\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u6280\u8853\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5411\u4e0a\u3055\u305b\u305f\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u91cd\u8981\u3067\u3059\u3002"}, {"question": "\u30e9\u30b0\u30c9\u30fc\u30eb\u30a2\u30fc\u30c1\u30e3\u30fc\u3067\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u3092\u52b9\u679c\u7684\u306b\u4f7f\u7528\u3059\u308b\u65b9\u6cd5\u306f\uff1f", "answer": "\u30e9\u30b0\u30c9\u30fc\u30eb\u30a2\u30fc\u30c1\u30e3\u30fc\u3067\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u3092\u52b9\u679c\u7684\u306b\u4f7f\u7528\u3059\u308b\u624b\u9806\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u306e\u7a2e\u985e\uff08\u4f8b\u3048\u3070\u3001\u7206\u767a\u77e2\u3001\u30b9\u30ed\u30fc\u30e2\u30fc\u30b7\u30e7\u30f3\uff09\u3092\u7279\u5b9a\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6700\u5927\u9650\u306e\u52b9\u679c\u3092\u5f97\u308b\u305f\u3081\u306b\u3001\u9069\u5207\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u3092\u4f7f\u7528\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6226\u7565\u7684\u306a\u5c04\u6483\u3068\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3001\u3055\u3089\u306b\u52b9\u679c\u3092\u9ad8\u3081\u308b\u3002\u4f8b\u3048\u3070\u3001\u7206\u767a\u77e2\u3092\u6575\u306e\u5bc6\u96c6\u3057\u305f\u96c6\u56e3\u306b\u4f7f\u3046\u3053\u3068\u3067\u3001\u8907\u6570\u306e\u6575\u3092\u540c\u6642\u306b\u653b\u6483\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u6226\u7565\u306b\u3088\u308a\u3001\u56f0\u96e3\u306a\u30ec\u30d9\u30eb\u3067\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30e9\u30b0\u30c9\u30fc\u30eb\u30a2\u30fc\u30c1\u30e3\u30fc\u306e\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30e9\u30b0\u30c9\u30fc\u30eb\u30a2\u30fc\u30c1\u30e3\u30fc\u306e\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3068\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306e\u4e3b\u306a\u9055\u3044\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\uff1a\uff11. \u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u500b\u3005\u306e\u30b9\u30ad\u30eb\u3068\u9032\u6b69\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u3044\u307e\u3059\u304c\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306f\u7af6\u4e89\u3068\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u3044\u307e\u3059\u3002\uff12. \u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3067\u306f\u3001AI\u5236\u5fa1\u306e\u6575\u3068\u6226\u3044\u307e\u3059\u304c\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3067\u306f\u3001\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u306e\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u306e\u6226\u95d8\u3068\u306a\u308a\u307e\u3059\u3002\uff13. \u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306b\u306f\u3001\u30b7\u30f3\u30b0\u30eb\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u306b\u306f\u306a\u3044\u3001\u72ec\u7279\u306e\u6311\u6226\u3068\u5831\u916c\u304c\u3057\u3070\u3057\u3070\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc\u30e2\u30fc\u30c9\u3067\u306f\u3001\u7279\u5225\u306a\u30a4\u30d9\u30f3\u30c8\u3084\u30e9\u30f3\u30ad\u30f3\u30b0\u304c\u5c0e\u5165\u3055\u308c\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u9055\u3044\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u3042\u306a\u305f\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u6700\u9069\u306a\u30e2\u30fc\u30c9\u3092\u9078\u629e\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30e9\u30b0\u30c9\u30fc\u30eb\u30a2\u30fc\u30c1\u30e3\u30fc\u306e\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u306f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u304b\uff1f", "answer": "\u30e9\u30b0\u30c9\u30fc\u30eb\u30a2\u30fc\u30c1\u30e3\u30fc\u306e\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u306f\u3001\u73fe\u5b9f\u7684\u306a\u77e2\u306e\u8ecc\u9053\u3068\u30e9\u30b0\u30c9\u30fc\u30eb\u53cd\u5fdc\u3092\u30b7\u30df\u30e5\u30ec\u30fc\u30c8\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u5927\u304d\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u77e2\u306f\u91cd\u529b\u3084\u98a8\u306b\u3088\u3063\u3066\u5f71\u97ff\u3092\u53d7\u3051\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u305d\u308c\u306b\u5fdc\u3058\u3066\u76ee\u6a19\u3092\u8abf\u6574\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30e9\u30b0\u30c9\u30fc\u30eb\u7269\u7406\u5b66\u306f\u4e88\u6e2c\u3067\u304d\u306a\u3044\u6575\u306e\u52d5\u304d\u3092\u4f5c\u308a\u51fa\u3057\u3001\u6311\u6226\u306e\u8981\u7d20\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u6b63\u78ba\u306a\u5c04\u6483\u3092\u884c\u3044\u3001\u6575\u306e\u884c\u52d5\u3092\u4e88\u6e2c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30e9\u30b0\u30c9\u30fc\u30eb\u30a2\u30fc\u30c1\u30e3\u30fc\u3092\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u5b9f\u884c\u3059\u308b\u305f\u3081\u306e\u30b7\u30b9\u30c6\u30e0\u8981\u4ef6\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30e9\u30b0\u30c9\u30fc\u30eb\u30a2\u30fc\u30c1\u30e3\u30fc\u3092\u5b9f\u884c\u3059\u308b\u305f\u3081\u306e\u30b7\u30b9\u30c6\u30e0\u8981\u4ef6\u306f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\uff1a1. iOS\uff1aiOS 10.0\u4ee5\u964d\u304c\u5fc5\u8981\u3067\u3001iPhone\u3001iPad\u3001iPod touch\u306b\u5bfe\u5fdc\u3057\u3066\u3044\u307e\u3059\u30022. Android\uff1aAndroid 5.0\u4ee5\u964d\u304c\u5fc5\u8981\u3067\u3001\u5c11\u306a\u304f\u3068\u30822GB\u306eRAM\u304c\u5fc5\u8981\u3067\u3059\u30023. PC\uff1aWindows 7\u4ee5\u964d\u304c\u5fc5\u8981\u3067\u3001\u30c7\u30e5\u30a2\u30eb\u30b3\u30a2\u30d7\u30ed\u30bb\u30c3\u30b5\u30684GB\u306eRAM\u304c\u5fc5\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30c7\u30d0\u30a4\u30b9\u304c\u3053\u308c\u3089\u306e\u8981\u4ef6\u3092\u6e80\u305f\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3059\u308b\u3053\u3068\u3067\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306e\u554f\u984c\u3092\u9632\u304e\u3001\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u3001\u30e9\u30b0\u30c9\u30fc\u30eb\u30a2\u30fc\u30c1\u30e3\u30fc\u306e\u9032\u884c\u72b6\u6cc1\u3092\u5225\u306e\u30c7\u30d0\u30a4\u30b9\u306b\u79fb\u52d5\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30e9\u30b0\u30c9\u30fc\u30eb\u30a2\u30fc\u30c1\u30e3\u30fc\u306e\u9032\u884c\u72b6\u6cc1\u3092\u5225\u306e\u30c7\u30d0\u30a4\u30b9\u306b\u79fb\u52d5\u3055\u305b\u308b\u306b\u306f\u3001\u6b21\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\uff08Google Play\u3001Apple ID\u306a\u3069\uff09\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b2\u30fc\u30e0\u306e\u30af\u30e9\u30a6\u30c9\u30bb\u30fc\u30d6\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u3001\u9032\u884c\u72b6\u6cc1\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u30b2\u30fc\u30e0\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3001\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u9032\u884c\u72b6\u6cc1\u3092\u5fa9\u5143\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u53e4\u3044iPhone\u304b\u3089\u65b0\u3057\u3044Android\u30c7\u30d0\u30a4\u30b9\u306b\u9032\u884c\u72b6\u6cc1\u3092\u79fb\u52d5\u3059\u308b\u3053\u3068\u306f\u3001\u4e21\u65b9\u306e\u30a2\u30ab\u30a6\u30f3\u30c8\u304c\u9023\u643a\u3055\u308c\u3066\u3044\u308c\u3070\u7c21\u5358\u306b\u53ef\u80fd\u3067\u3059\u3002\u3053\u306e\u65b9\u6cd5\u306b\u3088\u308a\u3001\u82e6\u52b4\u3057\u3066\u7372\u5f97\u3057\u305f\u6210\u679c\u3092\u7121\u99c4\u306b\u3059\u308b\u3053\u3068\u304c\u3042\u308a\u307e\u305b\u3093\u3002"}, {"question": "\u30e9\u30b0\u30c9\u30fc\u30eb\u30a2\u30fc\u30c1\u30e3\u30fc\u3067\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30e9\u30b0\u30c9\u30fc\u30eb\u30a2\u30fc\u30c1\u30e3\u30fc\u306b\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u3042\u308a\u3001\u6b21\u306e\u3088\u3046\u306a\u3082\u306e\u304c\u3042\u308a\u307e\u3059\uff1a\uff11. \u7279\u5b9a\u306e\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u30af\u30ea\u30a2\u3057\u305f\u5f8c\u3001\u958b\u304b\u308c\u308b\u79d8\u5bc6\u306e\u30ec\u30d9\u30eb\u3002\uff12. \u3042\u308b\u30de\u30a4\u30eb\u30b9\u30c8\u30fc\u30f3\u3092\u9054\u6210\u3059\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u308b\u96a0\u3057\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3002\uff13. \u6d41\u884c\u6587\u5316\u3084\u4ed6\u306e\u30b2\u30fc\u30e0\u3092\u53c2\u7167\u3057\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3002\u4f8b\u3048\u3070\u3001\u96a0\u3055\u308c\u305f\u30b4\u30fc\u30eb\u30c7\u30f3\u30a2\u30ed\u30fc\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u3067\u3001\u7279\u5225\u306a\u5831\u916c\u306e\u3042\u308b\u7279\u5225\u306a\u30ec\u30d9\u30eb\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u96a0\u3055\u308c\u305f\u8981\u7d20\u3092\u63a2\u6c42\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3055\u3089\u306b\u8208\u596e\u3092\u52a0\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}]
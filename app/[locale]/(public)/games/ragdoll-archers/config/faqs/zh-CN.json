[{"question": "\u5982\u4f55\u4f5c\u4e3a\u65b0\u624b\u5728\u300aRagdoll Archers\u300b\u4e2d\u8fdb\u884c\u57fa\u672c\u5c04\u51fb\uff1f", "answer": "\u8981\u5728\u300aRagdoll Archers\u300b\u4e2d\u8fdb\u884c\u57fa\u672c\u5c04\u51fb\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u5c06\u624b\u6307\u653e\u5728\u5c4f\u5e55\u4e0a\u62c9\u5f13\u3002\u6b65\u9aa42\uff1a\u901a\u8fc7\u5728\u6240\u9700\u65b9\u5411\u4e0a\u62d6\u52a8\u624b\u6307\u6765\u7784\u51c6\u3002\u6b65\u9aa43\uff1a\u677e\u5f00\u624b\u6307\u53d1\u5c04\u7bad\u77e2\u3002\u4f8b\u5982\uff0c\u7784\u51c6\u76ee\u6807\u7565\u9ad8\u4e8e\u76ee\u6807\u53ef\u4ee5\u5f25\u8865\u91cd\u529b\u5f71\u54cd\u3002\u6b64\u65b9\u6cd5\u5bf9\u4e8e\u65b0\u73a9\u5bb6\u719f\u6089\u6e38\u620f\u673a\u5236\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u5728\u300aRagdoll Archers\u300b\u4e2d\u8c03\u6574\u5c04\u51fb\u89d2\u5ea6\u4e3a\u4ec0\u4e48\u5f88\u91cd\u8981\uff1f", "answer": "\u5728\u300aRagdoll Archers\u300b\u4e2d\u8c03\u6574\u5c04\u51fb\u89d2\u5ea6\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u4f1a\u5f71\u54cd\u7bad\u77e2\u7684\u8f68\u8ff9\u3002\u4f8b\u5982\uff0c\u4ee545\u5ea6\u89d2\u5c04\u51fb\u53ef\u4ee5\u6700\u5927\u5316\u7bad\u77e2\u7684\u98de\u884c\u8ddd\u79bb\u3002\u6b64\u6280\u5de7\u5bf9\u4e8e\u7784\u51c6\u8fdc\u5904\u7684\u654c\u4eba\u6216\u76ee\u6807\u5c24\u5176\u6709\u7528\u3002\u7406\u89e3\u8fd9\u4e2a\u6982\u5ff5\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u5728\u6e38\u620f\u4e2d\u7684\u51c6\u786e\u6027\u548c\u6548\u7387\u3002"}, {"question": "\u5728\u300aRagdoll Archers\u300b\u4e2d\u51fb\u4e2d\u79fb\u52a8\u76ee\u6807\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u8981\u5728\u300aRagdoll Archers\u300b\u4e2d\u51fb\u4e2d\u79fb\u52a8\u76ee\u6807\uff0c\u8bf7\u8003\u8651\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9aa41\uff1a\u9884\u6d4b\u76ee\u6807\u7684\u79fb\u52a8\u8def\u5f84\u3002\u6b65\u9aa42\uff1a\u63d0\u524d\u7784\u51c6\u76ee\u6807\uff0c\u4ee5\u8003\u8651\u5176\u901f\u5ea6\u3002\u6b65\u9aa43\uff1a\u6839\u636e\u76ee\u6807\u7684\u52a0\u901f\u5ea6\u8c03\u6574\u5c04\u51fb\u65f6\u673a\u3002\u4f8b\u5982\uff0c\u5982\u679c\u654c\u4eba\u5411\u5de6\u79fb\u52a8\uff0c\u5219\u7784\u51c6\u5176\u5f53\u524d\u4f4d\u7f6e\u5de6\u4fa7\u3002\u8fd9\u79cd\u65b9\u6cd5\u53ef\u4ee5\u63d0\u9ad8\u4f60\u6301\u7eed\u51fb\u4e2d\u79fb\u52a8\u76ee\u6807\u7684\u51e0\u7387\u3002"}, {"question": "\u54ea\u4e9b\u9ad8\u7ea7\u6280\u5de7\u53ef\u4ee5\u63d0\u9ad8\u6211\u5728\u300aRagdoll Archers\u300b\u4e2d\u7684\u51c6\u786e\u6027\uff1f", "answer": "\u63d0\u9ad8\u300aRagdoll Archers\u300b\u4e2d\u51c6\u786e\u6027\u7684\u9ad8\u7ea7\u6280\u5de7\u5305\u62ec\uff1a\u6b65\u9aa41\uff1a\u7cbe\u901a\u7cbe\u786e\u5c04\u51fb\u65f6\u673a\u3002\u6b65\u9aa42\uff1a\u5229\u7528\u6e38\u620f\u7269\u7406\u5b66\u6765\u9884\u6d4b\u7bad\u77e2\u8f68\u8ff9\u3002\u6b65\u9aa43\uff1a\u7ec3\u4e60\u4e0d\u540c\u8ddd\u79bb\u7684\u4e00\u81f4\u5c04\u51fb\u89d2\u5ea6\u3002\u4f8b\u5982\uff0c\u7ec3\u4e60\u4e0d\u540c\u8ddd\u79bb\u7684\u5c04\u51fb\u53ef\u4ee5\u5e2e\u52a9\u4f60\u638c\u63e1\u6e38\u620f\u673a\u5236\u3002\u8fd9\u4e9b\u6280\u5de7\u5bf9\u4e8e\u5e0c\u671b\u63d0\u5347\u6e38\u620f\u4f53\u9a8c\u7684\u73a9\u5bb6\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u5982\u4f55\u5728\u300aRagdoll Archers\u300b\u4e2d\u6709\u6548\u5730\u4f7f\u7528\u9053\u5177\uff1f", "answer": "\u8981\u5728\u300aRagdoll Archers\u300b\u4e2d\u6709\u6548\u5730\u4f7f\u7528\u9053\u5177\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u8bc6\u522b\u9053\u5177\u7c7b\u578b\uff08\u4f8b\u5982\uff0c\u7206\u70b8\u7bad\u3001\u6162\u52a8\u4f5c\uff09\u3002\u6b65\u9aa42\uff1a\u5728\u6070\u5f53\u7684\u65f6\u673a\u6fc0\u6d3b\u9053\u5177\uff0c\u4ee5\u8fbe\u5230\u6700\u5927\u6548\u679c\u3002\u6b65\u9aa43\uff1a\u5c06\u9053\u5177\u4e0e\u6218\u7565\u5c04\u51fb\u76f8\u7ed3\u5408\uff0c\u4ee5\u83b7\u5f97\u66f4\u597d\u7684\u7ed3\u679c\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u7206\u70b8\u7bad\u653b\u51fb\u805a\u96c6\u7684\u654c\u4eba\u53ef\u4ee5\u4e00\u6b21\u6e05\u9664\u591a\u4e2a\u76ee\u6807\u3002\u6b64\u7b56\u7565\u53ef\u4ee5\u663e\u8457\u63d0\u5347\u4f60\u5728\u6311\u6218\u5173\u5361\u4e2d\u7684\u8868\u73b0\u3002"}, {"question": "\u300aRagdoll Archers\u300b\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u6709\u4ec0\u4e48\u4e3b\u8981\u533a\u522b\uff1f", "answer": "\u300aRagdoll Archers\u300b\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u7684\u4e3b\u8981\u533a\u522b\u5305\u62ec\uff1a1. \u5355\u4eba\u6a21\u5f0f\u4fa7\u91cd\u4e8e\u4e2a\u4eba\u6280\u80fd\u548c\u8fdb\u6b65\uff0c\u800c\u591a\u4eba\u6a21\u5f0f\u4fa7\u91cd\u4e8e\u7ade\u4e89\u548c\u56e2\u961f\u5408\u4f5c\u30022. \u5728\u5355\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f60\u5c06\u9762\u5bf9\u4eba\u5de5\u667a\u80fd\u63a7\u5236\u7684\u654c\u4eba\uff0c\u800c\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4f60\u5c06\u9762\u5bf9\u5176\u4ed6\u73a9\u5bb6\u7684\u5b9e\u65f6\u6218\u6597\u30023. \u591a\u4eba\u6a21\u5f0f\u901a\u5e38\u5305\u542b\u5355\u4eba\u6a21\u5f0f\u4e2d\u6ca1\u6709\u7684\u72ec\u7279\u6311\u6218\u548c\u5956\u52b1\u3002\u4f8b\u5982\uff0c\u591a\u4eba\u6a21\u5f0f\u53ef\u80fd\u5f15\u5165\u7279\u6b8a\u7684\u6d3b\u52a8\u548c\u6392\u884c\u699c\u3002\u7406\u89e3\u8fd9\u4e9b\u5dee\u5f02\u53ef\u4ee5\u5e2e\u52a9\u4f60\u9009\u62e9\u6700\u9002\u5408\u4f60\u6e38\u620f\u98ce\u683c\u7684\u6a21\u5f0f\u3002"}, {"question": "\u300aRagdoll Archers\u300b\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u300aRagdoll Archers\u300b\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u901a\u8fc7\u6a21\u62df\u73b0\u5b9e\u7684\u7bad\u77e2\u8f68\u8ff9\u548c\u65ad\u80a2\u53cd\u5e94\u6765\u663e\u8457\u5f71\u54cd\u6e38\u620f\u4f53\u9a8c\u3002\u4f8b\u5982\uff0c\u7bad\u77e2\u4f1a\u53d7\u5230\u91cd\u529b\u548c\u98ce\u7684\u5f71\u54cd\uff0c\u8981\u6c42\u73a9\u5bb6\u76f8\u5e94\u5730\u8c03\u6574\u7784\u51c6\u3002\u6b64\u5916\uff0c\u65ad\u80a2\u7269\u7406\u4f1a\u521b\u9020\u51fa\u4e0d\u53ef\u9884\u6d4b\u7684\u654c\u4eba\u52a8\u4f5c\uff0c\u589e\u52a0\u6311\u6218\u6027\u3002\u7406\u89e3\u8fd9\u4e9b\u673a\u5236\u53ef\u4ee5\u5e2e\u52a9\u4f60\u505a\u51fa\u66f4\u51c6\u786e\u7684\u5c04\u51fb\u5e76\u9884\u6d4b\u654c\u4eba\u884c\u4e3a\u3002"}, {"question": "\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e0a\u8fd0\u884c\u300aRagdoll Archers\u300b\u7684\u7cfb\u7edf\u8981\u6c42\u662f\u4ec0\u4e48\uff1f", "answer": "\u300aRagdoll Archers\u300b\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u7684\u7cfb\u7edf\u8981\u6c42\u5404\u4e0d\u76f8\u540c\uff1a1. iOS\uff1a\u9700\u8981 iOS 10.0 \u6216\u66f4\u9ad8\u7248\u672c\uff0c\u517c\u5bb9 iPhone\u3001iPad \u548c iPod touch\u30022. Android\uff1a\u9700\u8981 Android 5.0 \u6216\u66f4\u9ad8\u7248\u672c\uff0c\u81f3\u5c11 2GB \u5185\u5b58\u30023. PC\uff1a\u9700\u8981 Windows 7 \u6216\u66f4\u9ad8\u7248\u672c\uff0c\u914d\u5907\u53cc\u6838\u5904\u7406\u5668\u548c 4GB \u5185\u5b58\u3002\u4f8b\u5982\uff0c\u786e\u4fdd\u4f60\u7684\u8bbe\u5907\u7b26\u5408\u8fd9\u4e9b\u89c4\u8303\u53ef\u4ee5\u907f\u514d\u6027\u80fd\u95ee\u9898\u5e76\u589e\u5f3a\u4f60\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684\u300aRagdoll Archers\u300b\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u8bbe\u5907\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u8bbe\u5907\uff1f", "answer": "\u8981\u5c06\u4f60\u7684\u300aRagdoll Archers\u300b\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u8bbe\u5907\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u8bbe\u5907\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u786e\u4fdd\u4f60\u5728\u4e24\u4e2a\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u5e10\u6237\uff08\u4f8b\u5982\uff0cGoogle Play\u3001Apple ID\uff09\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u6e38\u620f\u7684\u4e91\u4fdd\u5b58\u529f\u80fd\u4e0a\u4f20\u4f60\u7684\u8fdb\u5ea6\u3002\u6b65\u9aa43\uff1a\u5728\u65b0\u8bbe\u5907\u4e0a\u4e0b\u8f7d\u6e38\u620f\u5e76\u767b\u5f55\u4ee5\u6062\u590d\u4f60\u7684\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4e24\u4e2a\u5e10\u6237\u90fd\u94fe\u63a5\u4e86\uff0c\u90a3\u4e48\u5c06\u8fdb\u5ea6\u4ece\u65e7 iPhone \u8f6c\u79fb\u5230\u65b0 Android \u8bbe\u5907\u53ef\u4ee5\u505a\u5230\u65e0\u7f1d\u8fdb\u884c\u3002\u6b64\u65b9\u6cd5\u4fdd\u8bc1\u4f60\u4e0d\u4f1a\u4e22\u5931\u4f60\u8f9b\u8f9b\u82e6\u82e6\u83b7\u5f97\u7684\u6210\u5c31\u3002"}, {"question": "\u5728\u300aRagdoll Archers\u300b\u4e2d\uff0c\u6211\u80fd\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "\u300aRagdoll Archers\u300b\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u4f8b\u5982\uff1a1. \u5b8c\u6210\u7279\u5b9a\u6311\u6218\u540e\u89e3\u9501\u7684\u79d8\u5bc6\u5173\u5361\u30022. \u901a\u8fc7\u8fbe\u5230\u7279\u5b9a\u91cc\u7a0b\u7891\u53ef\u4ee5\u89e3\u9501\u7684\u9690\u85cf\u89d2\u8272\u30023. \u53c2\u8003\u6d41\u884c\u6587\u5316\u6216\u5176\u4ed6\u6e38\u620f\u7684\u5f69\u86cb\u3002\u4f8b\u5982\uff0c\u627e\u5230\u9690\u85cf\u7684\u91d1\u7bad\u53ef\u4ee5\u89e3\u9501\u5177\u6709\u72ec\u7279\u5956\u52b1\u7684\u7279\u6b8a\u5173\u5361\u3002\u63a2\u7d22\u8fd9\u4e9b\u9690\u85cf\u5143\u7d20\u53ef\u4ee5\u4e3a\u4f60\u7684\u6e38\u620f\u4f53\u9a8c\u589e\u6dfb\u989d\u5916\u7684\u4e50\u8da3\u3002"}]
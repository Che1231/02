[{"question": "\ucd08\ubcf4\uc790\ub97c \uc704\ud55c \ub798\uae00\ub3cc \uad81\uc218 \uac8c\uc784\uc758 \uae30\ubcf8\uc801\uc778 \uc0f7\uc744 \uc5b4\ub5bb\uac8c \uc218\ud589\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub798\uae00\ub3cc \uad81\uc218 \uac8c\uc784\uc5d0\uc11c \uae30\ubcf8 \uc0f7\uc744 \uc218\ud589\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: 1\ub2e8\uacc4: \ud65c\uc744 \ub2f9\uae30\ub824\uba74 \ud654\uba74\uc5d0 \uc190\uac00\ub77d\uc744 \ub300\uace0 \uc720\uc9c0\ud558\uc138\uc694. 2\ub2e8\uacc4: \uc6d0\ud558\ub294 \ubc29\ud5a5\uc73c\ub85c \uc190\uac00\ub77d\uc744 \ub04c\uc5b4 \ubaa9\ud45c\ubb3c\uc744 \uc870\uc900\ud558\uc138\uc694. 3\ub2e8\uacc4: \uc190\uac00\ub77d\uc744 \ub193\uc544 \ud654\uc0b4\uc744 \ubc1c\uc0ac\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud45c\uc801 \uc704\ucabd\uc5d0 \uc57d\uac04 \uc870\uc900\ud558\uba74 \uc911\ub825\uc744 \ubcf4\uc815\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \ubc29\ubc95\uc740 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc5d0 \uc775\uc219\ud574\uc9c0\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4."}, {"question": "\ub798\uae00\ub3cc \uad81\uc218 \uac8c\uc784\uc5d0\uc11c \uc0f7\uc758 \uac01\ub3c4\ub97c \uc870\uc815\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub798\uae00\ub3cc \uad81\uc218 \uac8c\uc784\uc5d0\uc11c \uc0f7\uc758 \uac01\ub3c4\ub97c \uc870\uc815\ud558\ub294 \uac83\uc740 \ud654\uc0b4\uc758 \uada4\uc801\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc5d0 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 45\ub3c4 \uac01\ub3c4\ub85c \uc3d8\uba74 \ud654\uc0b4\uc774 \ub354 \uba40\ub9ac \ub0a0\uc544\uac08 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uae30\uc220\uc740 \uba3c \uac70\ub9ac\uc758 \uc801\uc774\ub098 \ubb3c\uccb4\ub97c \uacf5\uaca9\ud560 \ub54c \ud2b9\ud788 \uc720\uc6a9\ud569\ub2c8\ub2e4. \uc774 \uac1c\ub150\uc744 \uc774\ud574\ud558\uba74 \uac8c\uc784\uc5d0\uc11c \uc815\ud655\uc131\uacfc \ud6a8\uc728\uc131\uc744 \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub798\uae00\ub3cc \uad81\uc218 \uac8c\uc784\uc5d0\uc11c \uc6c0\uc9c1\uc774\ub294 \ud45c\uc801\uc744 \uba85\uc911\ud558\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub798\uae00\ub3cc \uad81\uc218 \uac8c\uc784\uc5d0\uc11c \uc6c0\uc9c1\uc774\ub294 \ud45c\uc801\uc744 \uba85\uc911\ud558\ub824\uba74 \ub2e4\uc74c \uc804\ub7b5\uc744 \uace0\ub824\ud558\uc138\uc694: 1\ub2e8\uacc4: \ud45c\uc801\uc758 \uc774\ub3d9 \uacbd\ub85c\ub97c \uc608\uce21\ud558\uc138\uc694. 2\ub2e8\uacc4: \ud45c\uc801\uc758 \uc18d\ub3c4\ub97c \uace0\ub824\ud558\uc5ec \ud45c\uc801 \uc55e\ucabd\uc5d0 \uc57d\uac04 \uc870\uc900\ud558\uc138\uc694. 3\ub2e8\uacc4: \ud45c\uc801\uc758 \uac00\uc18d\ub3c4\ub97c \ubc14\ud0d5\uc73c\ub85c \uc0f7 \ud0c0\uc774\ubc0d\uc744 \uc870\uc808\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc801\uc774 \uc67c\ucabd\uc73c\ub85c \uc774\ub3d9\ud558\uba74 \ud604\uc7ac \uc704\uce58\uc758 \uc67c\ucabd\uc5d0 \uc870\uc900\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774 \uc811\uadfc \ubc29\uc2dd\uc740 \uc6c0\uc9c1\uc774\ub294 \ud45c\uc801\uc744 \uc9c0\uc18d\uc801\uc73c\ub85c \uba85\uc911\ud560 \uac00\ub2a5\uc131\uc744 \ub192\uc785\ub2c8\ub2e4."}, {"question": "\ub798\uae00\ub3cc \uad81\uc218 \uac8c\uc784\uc5d0\uc11c \uc815\ud655\uc131\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \uace0\uae09 \uae30\uc220\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub798\uae00\ub3cc \uad81\uc218 \uac8c\uc784\uc5d0\uc11c \uc815\ud655\uc131\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \uace0\uae09 \uae30\uc220\uc5d0\ub294 \ub2e4\uc74c\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4: 1\ub2e8\uacc4: \uc0f7 \ud0c0\uc774\ubc0d\uc744 \uc815\ud655\ud558\uac8c \uc81c\uc5b4\ud558\ub294 \uae30\uc220\uc744 \uc775\ud788\uc138\uc694. 2\ub2e8\uacc4: \uac8c\uc784\uc758 \ubb3c\ub9ac \uc5d4\uc9c4\uc744 \ud65c\uc6a9\ud558\uc5ec \ud654\uc0b4\uc758 \uada4\uc801\uc744 \uc608\uce21\ud558\uc138\uc694. 3\ub2e8\uacc4: \ub2e4\uc591\ud55c \uac70\ub9ac\uc5d0 \ub300\ud574 \uc77c\uad00\ub41c \uc0f7 \uac01\ub3c4\ub97c \uc5f0\uc2b5\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub2e4\uc591\ud55c \uac70\ub9ac\uc5d0\uc11c \uc0f7\uc744 \uc5f0\uc2b5\ud558\uba74 \uac8c\uc784\uc758 \uba54\ucee4\ub2c8\uc998\uc5d0 \ub300\ud55c \uac10\uac01\uc744 \ud0a4\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uae30\uc220\uc740 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\uace0\uc790 \ud558\ub294 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ud544\uc218\uc801\uc785\ub2c8\ub2e4."}, {"question": "\ub798\uae00\ub3cc \uad81\uc218 \uac8c\uc784\uc5d0\uc11c \uac15\ud654 \uc544\uc774\ud15c\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub798\uae00\ub3cc \uad81\uc218 \uac8c\uc784\uc5d0\uc11c \uac15\ud654 \uc544\uc774\ud15c\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: 1\ub2e8\uacc4: \uac15\ud654 \uc544\uc774\ud15c\uc758 \uc885\ub958(\uc608: \ud3ed\ubc1c \ud654\uc0b4, \uc2ac\ub85c\uc6b0 \ubaa8\uc158)\ub97c \ud30c\uc545\ud558\uc138\uc694. 2\ub2e8\uacc4: \ucd5c\ub300 \ud6a8\uacfc\ub97c \uc704\ud574 \uc801\uc808\ud55c \uc2dc\uc810\uc5d0 \uac15\ud654 \uc544\uc774\ud15c\uc744 \ud65c\uc131\ud654\ud558\uc138\uc694. 3\ub2e8\uacc4: \uc804\ub7b5\uc801\uc778 \uc0f7\uacfc \uac15\ud654 \uc544\uc774\ud15c\uc744 \uacb0\ud569\ud558\uc5ec \ub354\uc6b1 \ud5a5\uc0c1\ub41c \uacb0\uacfc\ub97c \uc5bb\uc73c\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc9d1\uc911\ub41c \uc801\ub4e4\uc744 \uc0c1\ub300\ub85c \ud3ed\ubc1c \ud654\uc0b4\uc744 \uc0ac\uc6a9\ud558\uba74 \ud55c \ubc88\uc5d0 \uc5ec\ub7ec \uac1c\uc758 \ubaa9\ud45c\ubb3c\uc744 \uc81c\uac70\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc804\ub7b5\uc740 \uae4c\ub2e4\ub85c\uc6b4 \ub808\ubca8\uc5d0\uc11c \uc131\ub2a5\uc744 \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub798\uae00\ub3cc \uad81\uc218 \uac8c\uc784\uc758 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub798\uae00\ub3cc \uad81\uc218 \uac8c\uc784\uc758 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: 1. \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \uac1c\uc778\uc801\uc778 \uae30\uc220\uacfc \uc9c4\ucc99\uc5d0 \ucd08\uc810\uc744 \ub450\ub294 \ubc18\uba74, \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\ub294 \uacbd\uc7c1\uacfc \ud611\ub3d9\uc5d0 \uc911\uc810\uc744 \ub461\ub2c8\ub2e4. 2. \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c\ub294 AI\uac00 \uc81c\uc5b4\ud558\ub294 \uc801\uacfc \ub9de\uc11c \uc2f8\uc6b0\ub294 \ubc18\uba74, \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uc640 \uc2e4\uc2dc\uac04 \uc804\ud22c\ub97c \ubc8c\uc785\ub2c8\ub2e4. 3. \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\ub294 \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \ucc3e\uc544\ubcfc \uc218 \uc5c6\ub294 \ud2b9\ubcc4\ud55c \ub3c4\uc804\uacfc \ubcf4\uc0c1\uc774 \uc790\uc8fc \ub4f1\uc7a5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc5d0\ub294 \ud2b9\ubcc4 \uc774\ubca4\ud2b8\uc640 \uc21c\uc704\ud45c\uac00 \ucd94\uac00\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ucc28\uc774\uc810\uc744 \uc774\ud574\ud558\uba74 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \uac00\uc7a5 \uc801\ud569\ud55c \ubaa8\ub4dc\ub97c \uc120\ud0dd\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\ub798\uae00\ub3cc \uad81\uc218 \uac8c\uc784\uc758 \ubb3c\ub9ac \uc5d4\uc9c4\uc740 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "\ub798\uae00\ub3cc \uad81\uc218 \uac8c\uc784\uc758 \ubb3c\ub9ac \uc5d4\uc9c4\uc740 \ud604\uc2e4\uc801\uc778 \ud654\uc0b4 \uada4\uc801\uacfc \ub798\uae00\ub3cc \ubc18\uc751\uc744 \uc2dc\ubbac\ub808\uc774\uc158\ud558\uc5ec \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc0c1\ub2f9\ud55c \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud654\uc0b4\uc740 \uc911\ub825\uacfc \ubc14\ub78c\uc5d0 \uc601\ud5a5\uc744 \ubc1b\uc73c\ubbc0\ub85c \ud50c\ub808\uc774\uc5b4\ub294 \uc870\uc900\uc744 \uc870\uc815\ud574\uc57c \ud569\ub2c8\ub2e4. \ub610\ud55c, \ub798\uae00\ub3cc \ubb3c\ub9ac\ub294 \uc608\uce21\ud560 \uc218 \uc5c6\ub294 \uc801\uc758 \uc6c0\uc9c1\uc784\uc744 \ub9cc\ub4e4\uc5b4 \uc5b4\ub824\uc6c0\uc758 \uce35\uc744 \ub354\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\uba74 \ub354 \uc815\ud655\ud55c \uc0f7\uc744 \ub0a0\ub9ac\uace0 \uc801\uc758 \ud589\ub3d9\uc744 \uc608\uce21\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub798\uae00\ub3cc \uad81\uc218 \uac8c\uc784\uc744 \uc2e4\ud589\ud558\uae30 \uc704\ud55c \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub798\uae00\ub3cc \uad81\uc218 \uac8c\uc784\uc744 \uc2e4\ud589\ud558\uae30 \uc704\ud55c \uc2dc\uc2a4\ud15c \uc694\uad6c \uc0ac\ud56d\uc740 \ud50c\ub7ab\ud3fc\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4: 1. iOS: iOS 10.0 \uc774\uc0c1 \ud544\uc694\ud558\uba70, iPhone, iPad, iPod touch\uc640 \ud638\ud658\ub429\ub2c8\ub2e4. 2. \uc548\ub4dc\ub85c\uc774\ub4dc: \uc548\ub4dc\ub85c\uc774\ub4dc 5.0 \uc774\uc0c1 \ud544\uc694\ud558\uba70, \ucd5c\uc18c 2GB\uc758 RAM\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. 3. PC: Windows 7 \uc774\uc0c1 \ud544\uc694\ud558\uba70, \ub4c0\uc5bc \ucf54\uc5b4 \ud504\ub85c\uc138\uc11c\uc640 4GB\uc758 RAM\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc7a5\uce58\uac00 \uc774\ub7ec\ud55c \uc0ac\uc591\uc744 \ucda9\uc871\ud558\uba74 \uc131\ub2a5 \ubb38\uc81c\ub97c \ubc29\uc9c0\ud558\uace0 \uac8c\uc784 \ud658\uacbd\uc744 \uac1c\uc120\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub2e4\ub978 \uae30\uae30\uc5d0\uc11c \ub798\uae00\ub3cc \uad81\uc218 \uac8c\uc784\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub2e4\ub978 \uae30\uae30\uc5d0\uc11c \ub798\uae00\ub3cc \uad81\uc218 \uac8c\uc784\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: 1\ub2e8\uacc4: \ub450 \uae30\uae30 \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815(\uc608: Google Play, Apple ID)\uc5d0 \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. 2\ub2e8\uacc4: \uac8c\uc784\uc758 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5c5\ub85c\ub4dc\ud558\uc138\uc694. 3\ub2e8\uacc4: \uc0c8 \uae30\uae30\uc5d0\uc11c \uac8c\uc784\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uace0 \ub85c\uadf8\uc778\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \ubcf5\uad6c\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc774\uc804 iPhone\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \uc548\ub4dc\ub85c\uc774\ub4dc \uae30\uae30\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\uba74 \ub450 \uacc4\uc815\uc774 \uc5f0\uacb0\ub418\uc5b4 \uc788\ub2e4\uba74 \uc6d0\ud65c\ud558\uac8c \uc774\ub8e8\uc5b4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \ubc29\ubc95\uc73c\ub85c \uc5f4\uc2ec\ud788 \uc5bb\uc740 \uc131\ucde8\ub3c4\ub97c \uc783\uc9c0 \uc54a\uace0 \uac8c\uc784\uc744 \uacc4\uc18d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub798\uae00\ub3cc \uad81\uc218 \uac8c\uc784\uc5d0\uc11c \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ub798\uae00\ub3cc \uad81\uc218 \uac8c\uc784\uc5d0\ub294 \uc5ec\ub7ec \uac00\uc9c0 \uc228\uaca8\uc9c4 \uae30\ub2a5\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. 1. \ud2b9\uc815 \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud55c \ud6c4 \uc228\uaca8\uc9c4 \ub808\ubca8\uc774 \ud574\uc81c\ub429\ub2c8\ub2e4. 2. \ud2b9\uc815 \uc774\uc815\ud45c\ub97c \ub2ec\uc131\ud558\uba74 \uc228\uaca8\uc9c4 \uce90\ub9ad\ud130\ub97c \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 3. \ub300\uc911 \ubb38\ud654\ub098 \ub2e4\ub978 \uac8c\uc784\uc5d0 \ub300\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc228\uaca8\uc9c4 \ud669\uae08 \ud654\uc0b4\uc744 \ucc3e\uc73c\uba74 \ud2b9\ubcc4\ud55c \ubcf4\uc0c1\uc774 \uc788\ub294 \ud2b9\ubcc4\ud55c \ub808\ubca8\uc774 \ud574\uc81c\ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uc694\uc18c\ub97c \ud0d0\uc0c9\ud558\uba74 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \ud765\ubd84\uc774 \ub354\ud574\uc9d1\ub2c8\ub2e4."}]
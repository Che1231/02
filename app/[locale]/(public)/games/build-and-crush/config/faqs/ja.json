[{"question": "\u521d\u3081\u3066Build and Crush\u3067\u69cb\u9020\u7269\u3092\u69cb\u7bc9\u3059\u308b\u306b\u306f\u3001\u521d\u5fc3\u8005\u306e\u65b9\u5411\u3051\u306b\u3069\u306e\u3088\u3046\u306b\u59cb\u3081\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Build and Crush\u3067\u69cb\u7bc9\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b2\u30fc\u30e0\u3092\u958b\u304d\u3001\u300e\u5efa\u9020\u30e2\u30fc\u30c9\u300f\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30e1\u30cb\u30e5\u30fc\u304b\u3089\u3001\u30b7\u30f3\u30d7\u30eb\u306a\u5bb6\u306e\u3088\u3046\u306a\u57fa\u672c\u7684\u306a\u69cb\u9020\u7269\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u3092\u9078\u3073\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u753b\u9762\u4e0a\u306e\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3092\u4f7f\u3063\u3066\u3001\u3042\u306a\u305f\u306e\u6577\u5730\u306b\u69cb\u9020\u7269\u3092\u914d\u7f6e\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u6163\u308c\u308b\u305f\u3081\u306b\u30012x2\u306e\u30a6\u30c3\u30c9\u88fd\u306e\u5c0f\u5c4b\u304b\u3089\u59cb\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306b\u306f\u3001\u3053\u308c\u3089\u306e\u521d\u671f\u30b9\u30c6\u30c3\u30d7\u3092\u30ac\u30a4\u30c9\u3059\u308b\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u304c\u3042\u308b\u306e\u3067\u3001\u521d\u5fc3\u8005\u306b\u3082\u512a\u3057\u3044\u8a2d\u8a08\u3067\u3059\u3002"}, {"question": "Build and Crush\u306e\u300e\u5efa\u9020\u30e2\u30fc\u30c9\u300f\u3068\u300e\u7834\u58ca\u30e2\u30fc\u30c9\u300f\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Build and Crush\u3067\u306f\u3001\u300e\u5efa\u9020\u30e2\u30fc\u30c9\u300f\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u7d20\u6750\u3084\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u3092\u4f7f\u7528\u3057\u3066\u69cb\u9020\u7269\u3092\u69cb\u7bc9\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u8a73\u7d30\u306a\u30a4\u30f3\u30c6\u30ea\u30a2\u3092\u6301\u3064\u591a\u5c64\u5efa\u9020\u7269\u3092\u69cb\u7bc9\u3067\u304d\u307e\u3059\u3002\u300e\u7834\u58ca\u30e2\u30fc\u30c9\u300f\u306f\u3001\u7834\u58ca\u7403\u3084\u7206\u767a\u7269\u306a\u3069\u306e\u3055\u307e\u3056\u307e\u306a\u30c4\u30fc\u30eb\u3092\u4f7f\u3063\u3066\u3053\u308c\u3089\u306e\u69cb\u9020\u7269\u3092\u7834\u58ca\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u5177\u4f53\u7684\u306a\u4f8b\u3068\u3057\u3066\u306f\u3001\u300e\u5efa\u9020\u30e2\u30fc\u30c9\u300f\u3067\u5854\u3092\u69cb\u7bc9\u3057\u3001\u300e\u7834\u58ca\u30e2\u30fc\u30c9\u300f\u3067\u5236\u5fa1\u3055\u308c\u305f\u7206\u767a\u3092\u4f7f\u3063\u3066\u5012\u58ca\u3055\u305b\u308b\u3053\u3068\u3067\u3001\u697d\u3057\u304f\u6226\u7565\u7684\u306a\u4f5c\u696d\u306b\u306a\u308a\u307e\u3059\u3002"}, {"question": "Build and Crush\u306e\u521d\u671f\u6bb5\u968e\u306e\u9032\u884c\u306b\u6700\u3082\u91cd\u8981\u306a\u30ea\u30bd\u30fc\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Build and Crush\u306e\u521d\u671f\u6bb5\u968e\u306e\u9032\u884c\u306f\u3001\u6728\u6750\u3068\u77f3\u6750\u306b\u5927\u304d\u304f\u4f9d\u5b58\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u8cc7\u6e90\u306f\u3001\u57fa\u672c\u7684\u306a\u69cb\u9020\u7269\u306e\u69cb\u7bc9\u3068\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u6728\u6750\u306f\u67a0\u7d44\u307f\u3084\u57fa\u672c\u7684\u306a\u58c1\u306b\u4f7f\u7528\u3055\u308c\u3001\u77f3\u6750\u306f\u3088\u308a\u8010\u4e45\u6027\u306e\u9ad8\u3044\u69cb\u9020\u7269\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u3053\u308c\u3089\u306e\u8cc7\u6e90\u306f\u3001\u30de\u30c3\u30d7\u3092\u63a2\u7d22\u3059\u308b\u304b\u3001\u7c21\u5358\u306a\u30df\u30c3\u30b7\u30e7\u30f3\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3067\u5165\u624b\u3067\u304d\u307e\u3059\u3002\u521d\u671f\u6bb5\u968e\u3067\u3053\u308c\u3089\u306e\u8cc7\u6e90\u3092\u52b9\u7387\u7684\u306b\u7ba1\u7406\u3059\u308b\u3053\u3068\u3067\u3001\u30b9\u30e0\u30fc\u30ba\u306b\u9032\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4100\u6642\u9593\u5f8c\u3001Build and Crush\u3067\u5efa\u7bc9\u6226\u7565\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Build and Crush\u3067100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u5efa\u7bc9\u6226\u7565\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b9\u30da\u30fc\u30b9\u3068\u52b9\u7387\u3092\u6700\u5927\u9650\u306b\u6d3b\u304b\u3059\u305f\u3081\u306b\u914d\u7f6e\u8a08\u753b\u3092\u7acb\u3066\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u3088\u308a\u8907\u96d1\u306a\u69cb\u9020\u7269\u306e\u305f\u3081\u306b\u3001\u92fc\u9244\u3084\u30ac\u30e9\u30b9\u306a\u3069\u306e\u9ad8\u5ea6\u306a\u7d20\u6750\u3092\u6d3b\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u666f\u89b3\u3084\u30a4\u30f3\u30c6\u30ea\u30a2\u30c7\u30b6\u30a4\u30f3\u306a\u3069\u306e\u7f8e\u7684\u8981\u7d20\u3092\u53d6\u308a\u8fbc\u307f\u3001\u8996\u899a\u7684\u306a\u9b45\u529b\u3092\u9ad8\u3081\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5c4b\u6839\u306b\u5ead\u5712\u3092\u5099\u3048\u305f\u591a\u6a5f\u80fd\u306a\u5efa\u9020\u7269\u3092\u69cb\u7bc9\u3059\u308b\u3053\u3068\u3067\u3001\u5b9f\u7528\u7684\u306a\u30e1\u30ea\u30c3\u30c8\u3068\u7f8e\u7684\u52b9\u679c\u306e\u4e21\u65b9\u3092\u9054\u6210\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u69cb\u6210\u8868\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u3055\u307e\u3056\u307e\u306a\u7d20\u6750\u3068\u305d\u306e\u5229\u70b9\u3092\u6bd4\u8f03\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u3001Build and Crush\u3067\u8a2d\u8a08\u56f3\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u306e\u5229\u70b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Build and Crush\u306b\u304a\u3051\u308b\u8a2d\u8a08\u56f3\u306f\u3001\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u8907\u96d1\u306a\u69cb\u9020\u7269\u3092\u52b9\u7387\u7684\u306b\u69cb\u7bc9\u3059\u308b\u305f\u3081\u306e\u624b\u6bb5\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u305d\u308c\u3089\u306f\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u53ef\u80fd\u306a\u4e8b\u524d\u8a2d\u8a08\u3055\u308c\u305f\u914d\u7f6e\u3092\u63d0\u4f9b\u3057\u3001\u6642\u9593\u3092\u7bc0\u7d04\u3057\u3001\u69cb\u9020\u306e\u5b8c\u5168\u6027\u3092\u78ba\u4fdd\u3057\u307e\u3059\u3002 \u4f8b\u3048\u3070\u3001\u8d85\u9ad8\u5c64\u30d3\u30eb\u306e\u8a2d\u8a08\u56f3\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u30bc\u30ed\u304b\u3089\u59cb\u3081\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u30a4\u30f3\u30c6\u30ea\u30a2\u3084\u30a8\u30af\u30b9\u30c6\u30ea\u30a2\u306e\u8a73\u7d30\u306e\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u306b\u96c6\u4e2d\u3067\u304d\u307e\u3059\u3002\u8a2d\u8a08\u56f3\u306f\u3001\u6700\u9069\u306a\u8a2d\u8a08\u3068\u6a5f\u80fd\u6027\u3092\u78ba\u4fdd\u3059\u308b\u3053\u3068\u3067\u3001\u5efa\u7bc9\u30c1\u30e3\u30ec\u30f3\u30b8\u3067\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u4e0a\u3067\u3082\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "Build and Crush\u3067\u52b9\u7387\u7684\u306a\u8cc7\u6e90\u7ba1\u7406\u306e\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Build and Crush\u306b\u304a\u3051\u308b\u52b9\u7387\u7684\u306a\u8cc7\u6e90\u7ba1\u7406\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u3067\u69cb\u6210\u3055\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6728\u6750\u3001\u77f3\u6750\u3001\u91d1\u5c5e\u306a\u3069\u306e\u5fc5\u9808\u8cc7\u6e90\u3092\u512a\u5148\u7684\u306b\u53ce\u96c6\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u3088\u308a\u591a\u304f\u306e\u8cc7\u6e90\u3092\u53ce\u5bb9\u3059\u308b\u305f\u3081\u306b\u8caf\u8535\u65bd\u8a2d\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u53d6\u308a\u58ca\u3055\u308c\u305f\u69cb\u9020\u7269\u3092\u30ea\u30b5\u30a4\u30af\u30eb\u3057\u3066\u7d20\u6750\u3092\u56de\u53ce\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5efa\u7269\u3092\u7834\u58ca\u3057\u305f\u5f8c\u3001\u4f7f\u7528\u3055\u308c\u305f\u6750\u6599\u306e\u4e00\u90e8\u3092\u53d6\u308a\u623b\u3059\u305f\u3081\u306b\u3001\u5ec3\u6750\u3092\u30ea\u30b5\u30a4\u30af\u30eb\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u8cc7\u6e90\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u4f5c\u6210\u3059\u308b\u3053\u3068\u3067\u3001\u8cc7\u6e90\u306e\u5272\u308a\u5f53\u3066\u3092\u3088\u308a\u52b9\u679c\u7684\u306b\u53ef\u8996\u5316\u3057\u3001\u7ba1\u7406\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "Build and Crush\u306e\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u306f\u3001\u5efa\u9020\u7269\u306e\u5b89\u5b9a\u6027\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "Build and Crush\u306e\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u306f\u3001\u69cb\u9020\u7269\u306e\u5b89\u5b9a\u6027\u3092\u6c7a\u5b9a\u3059\u308b\u4e0a\u3067\u975e\u5e38\u306b\u91cd\u8981\u306a\u5f79\u5272\u3092\u679c\u305f\u3057\u307e\u3059\u3002\u69cb\u9020\u7269\u304c\u5012\u58ca\u3057\u306a\u3044\u3088\u3046\u306b\u3001\u3057\u3063\u304b\u308a\u3068\u652f\u3048\u3089\u308c\u3066\u3044\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5341\u5206\u306a\u57fa\u790e\u304c\u306a\u3044\u9ad8\u5c64\u30d3\u30eb\u306f\u5012\u58ca\u3057\u307e\u3059\u3002\u7269\u7406\u30a8\u30f3\u30b8\u30f3\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u5b89\u5b9a\u3057\u3066\u3044\u3066\u8010\u4e45\u6027\u306e\u9ad8\u3044\u69cb\u9020\u7269\u3092\u8a2d\u8a08\u3067\u304d\u307e\u3059\u3002\u3055\u307e\u3056\u307e\u306a\u7d20\u6750\u3068\u305d\u306e\u5b89\u5b9a\u6027\u8a55\u4fa1\u306e\u6bd4\u8f03\u8868\u306f\u3001\u60c5\u5831\u306b\u57fa\u3065\u3044\u305f\u5efa\u7bc9\u5224\u65ad\u3092\u884c\u3046\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "Build and Crush\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306e\u57fa\u672c\u7684\u306a\u4ed5\u7d44\u307f\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Build and Crush\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u8907\u96d1\u3055\u3001\u5b89\u5b9a\u6027\u3001\u7f8e\u89b3\u3001\u6a5f\u80fd\u6027\u306e\u3044\u304f\u3064\u304b\u306e\u8981\u56e0\u306b\u57fa\u3065\u3044\u3066\u69cb\u9020\u7269\u3092\u8a55\u4fa1\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u8a2d\u8a08\u304c\u826f\u304f\u3001\u5b89\u5b9a\u3057\u3066\u3044\u3066\u8996\u899a\u7684\u306b\u9b45\u529b\u7684\u306a\u5efa\u7269\u306f\u3001\u30b7\u30f3\u30d7\u30eb\u3067\u4e0d\u5b89\u5b9a\u306a\u5efa\u7269\u3088\u308a\u3082\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u53d7\u3051\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306f\u307e\u305f\u3001\u5275\u9020\u6027\u3068\u8cc7\u6e90\u306e\u52b9\u7387\u7684\u306a\u4f7f\u7528\u306b\u3082\u5831\u3044\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u4ed5\u7d44\u307f\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u5efa\u7bc9\u30c1\u30e3\u30ec\u30f3\u30b8\u3067\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u76ee\u6307\u305b\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002\u30b9\u30b3\u30a2\u57fa\u6e96\u306e\u8a73\u7d30\u306a\u5206\u89e3\u306f\u3001\u3088\u308a\u826f\u3044\u7406\u89e3\u306e\u305f\u3081\u306b\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3067\u8996\u899a\u5316\u3067\u304d\u307e\u3059\u3002"}, {"question": "Build and Crush\u306e\u9032\u884c\u72b6\u6cc1\u3092\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067Build and Crush\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1aGoogle Play\u3084Apple ID\u306a\u3069\u3092\u901a\u3058\u3066\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30ea\u30f3\u30af\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b2\u30fc\u30e0\u5185\u306e\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u3001\u9032\u6357\u72b6\u6cc1\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u65b0\u3057\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3001\u4fdd\u5b58\u3055\u308c\u305f\u30c7\u30fc\u30bf\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001PC\u304b\u3089\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u306b\u5207\u308a\u66ff\u3048\u305f\u5834\u5408\u3067\u3082\u3001\u3042\u306a\u305f\u306e\u5efa\u9020\u7269\u3068\u8cc7\u6e90\u306f\u4fdd\u5b58\u3055\u308c\u307e\u3059\u3002\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u4e92\u63db\u6027\u8868\u306f\u3001\u3053\u306e\u6a5f\u80fd\u3092\u30b5\u30dd\u30fc\u30c8\u3059\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u7406\u89e3\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "Build and Crush\u306b\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u898b\u843d\u3068\u3059\u53ef\u80fd\u6027\u306e\u3042\u308b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3084\u79d8\u5bc6\u30a8\u30ea\u30a2\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001Build and Crush\u306b\u306f\u8907\u6570\u306e\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3084\u79d8\u5bc6\u30a8\u30ea\u30a2\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30de\u30c3\u30d7\u306e\u7aef\u3092\u63a2\u7d22\u3059\u308b\u3068\u3001\u5e0c\u5c11\u306a\u8cc7\u6e90\u3084\u72ec\u7279\u306e\u5efa\u7bc9\u8cc7\u6750\u304c\u5165\u624b\u3067\u304d\u308b\u96a0\u3057\u6d1e\u7a9f\u304c\u898b\u3064\u304b\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u5225\u306e\u4f8b\u306f\u3001\u69cb\u7bc9\u3057\u305f\u8907\u96d1\u306a\u69cb\u9020\u7269\u306e\u4e2d\u306b\u96a0\u3055\u308c\u305f\u7279\u5225\u306a\u8a2d\u8a08\u56f3\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u3067\u3059\u3002\u3053\u308c\u3089\u306e\u96a0\u3055\u308c\u305f\u8981\u7d20\u306f\u3001\u30b2\u30fc\u30e0\u306b\u8208\u596e\u3068\u767a\u898b\u306e\u5c64\u3092\u52a0\u3048\u307e\u3059\u3002\u6f5c\u5728\u7684\u306a\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306e\u5834\u6240\u3092\u793a\u3057\u305f\u30de\u30c3\u30d7\u306f\u3001\u3053\u308c\u3089\u306e\u79d8\u5bc6\u3092\u767a\u898b\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}]
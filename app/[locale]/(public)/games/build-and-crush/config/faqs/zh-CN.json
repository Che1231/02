[{"question": "\u6211\u4f5c\u4e3a\u4e00\u540d\u65b0\u624b\uff0c\u5982\u4f55\u5f00\u59cb\u5728\u300a\u5efa\u9020\u4e0e\u6467\u6bc1\u300b\u4e2d\u5efa\u9020\u6211\u7684\u7b2c\u4e00\u4e2a\u5efa\u7b51\uff1f", "answer": "\u8981\u5728\u300a\u5efa\u9020\u4e0e\u6467\u6bc1\u300b\u4e2d\u5f00\u59cb\u5efa\u9020\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u6253\u5f00\u6e38\u620f\u5e76\u9009\u62e9\"\u5efa\u9020\u6a21\u5f0f\"\u3002 \u6b65\u9aa42\uff1a\u4ece\u83dc\u5355\u4e2d\u9009\u62e9\u4e00\u4e2a\u57fa\u672c\u7684\u5efa\u7b51\u6a21\u677f\uff0c\u4f8b\u5982\u7b80\u5355\u7684\u623f\u5c4b\u3002 \u6b65\u9aa43\uff1a\u4f7f\u7528\u5c4f\u5e55\u4e0a\u7684\u63a7\u4ef6\u5c06\u5efa\u7b51\u7269\u653e\u7f6e\u5728\u4f60\u7684\u5730\u5757\u4e0a\u3002 \u4f8b\u5982\uff0c\u4f60\u53ef\u4ee5\u4ece\u4e00\u4e2a2x2\u7684\u6728\u5236\u5c0f\u5c4b\u5f00\u59cb\uff0c\u4ee5\u719f\u6089\u6e38\u620f\u673a\u5236\u3002 \u8bf7\u8bb0\u4f4f\uff0c\u6e38\u620f\u63d0\u4f9b\u4e86\u4e00\u4e2a\u6559\u7a0b\uff0c\u6307\u5bfc\u4f60\u5b8c\u6210\u8fd9\u4e9b\u521d\u59cb\u6b65\u9aa4\uff0c\u8ba9\u6e38\u620f\u5bf9\u65b0\u624b\u53cb\u597d\u3002"}, {"question": "\u300a\u5efa\u9020\u4e0e\u6467\u6bc1\u300b\u4e2d\"\u5efa\u9020\"\u6a21\u5f0f\u548c\"\u6467\u6bc1\"\u6a21\u5f0f\u7684\u4e3b\u8981\u533a\u522b\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300a\u5efa\u9020\u4e0e\u6467\u6bc1\u300b\u4e2d\uff0c\"\u5efa\u9020\u6a21\u5f0f\"\u5141\u8bb8\u4f60\u4f7f\u7528\u5404\u79cd\u6750\u6599\u548c\u6a21\u677f\u521b\u5efa\u5efa\u7b51\u7269\u3002 \u4f8b\u5982\uff0c\u4f60\u53ef\u4ee5\u5efa\u9020\u4e00\u4e2a\u5e26\u6709\u8be6\u7ec6\u5185\u90e8\u7684\u591a\u5c42\u5efa\u7b51\u3002 \u53e6\u4e00\u65b9\u9762\uff0c\"\u6467\u6bc1\u6a21\u5f0f\"\u5141\u8bb8\u4f60\u4f7f\u7528\u5404\u79cd\u5de5\u5177\uff08\u4f8b\u5982\u63a8\u571f\u673a\u6216\u70b8\u836f\uff09\u6467\u6bc1\u8fd9\u4e9b\u5efa\u7b51\u7269\u3002 \u4e00\u4e2a\u5b9e\u9645\u7684\u4f8b\u5b50\u662f\uff1a\u5728\"\u5efa\u9020\u6a21\u5f0f\"\u4e2d\u5efa\u9020\u4e00\u5ea7\u5854\uff0c\u7136\u540e\u5728\"\u6467\u6bc1\u6a21\u5f0f\"\u4e2d\u4f7f\u7528\u63a7\u5236\u7206\u70b8\u5c06\u5176\u6467\u6bc1\uff0c\u8fd9\u65e2\u6709\u8da3\u53c8\u5177\u6709\u6218\u7565\u6027\u3002"}, {"question": "\u300a\u5efa\u9020\u4e0e\u6467\u6bc1\u300b\u65e9\u671f\u6e38\u620f\u8fdb\u5c55\u4e2d\u54ea\u4e9b\u8d44\u6e90\u6700\u91cd\u8981\uff1f", "answer": "\u300a\u5efa\u9020\u4e0e\u6467\u6bc1\u300b\u65e9\u671f\u6e38\u620f\u8fdb\u5c55\u6781\u5927\u5730\u4f9d\u8d56\u6728\u6750\u548c\u77f3\u5934\u3002 \u8fd9\u4e9b\u8d44\u6e90\u5bf9\u4e8e\u5efa\u9020\u57fa\u7840\u5efa\u7b51\u7269\u548c\u5347\u7ea7\u5b83\u4eec\u81f3\u5173\u91cd\u8981\u3002 \u4f8b\u5982\uff0c\u6728\u6750\u7528\u4e8e\u6846\u67b6\u548c\u57fa\u672c\u5899\u58c1\uff0c\u800c\u77f3\u5934\u5bf9\u4e8e\u66f4\u575a\u56fa\u7684\u5efa\u7b51\u7269\u81f3\u5173\u91cd\u8981\u3002 \u4f60\u53ef\u4ee5\u901a\u8fc7\u63a2\u7d22\u5730\u56fe\u6216\u5b8c\u6210\u7b80\u5355\u7684\u4efb\u52a1\u6765\u6536\u96c6\u8fd9\u4e9b\u8d44\u6e90\u3002 \u5728\u6e38\u620f\u521d\u671f\u6709\u6548\u5730\u7ba1\u7406\u8fd9\u4e9b\u8d44\u6e90\u5c06\u5e2e\u52a9\u4f60\u987a\u5229\u5730\u53d6\u5f97\u8fdb\u5c55\u3002"}, {"question": "\u5728\u6e38\u620f\u4e2d\u73a9\u4e86100\u4e2a\u5c0f\u65f6\u540e\uff0c\u5982\u4f55\u5728\u300a\u5efa\u9020\u4e0e\u6467\u6bc1\u300b\u4e2d\u4f18\u5316\u6211\u7684\u5efa\u9020\u7b56\u7565\uff1f", "answer": "\u5728\u300a\u5efa\u9020\u4e0e\u6467\u6bc1\u300b\u4e2d\u73a9\u4e86 100 \u4e2a\u5c0f\u65f6\u540e\uff0c\u4f18\u5316\u4f60\u7684\u5efa\u9020\u7b56\u7565\u5305\u62ec\uff1a\u6b65\u9aa41\uff1a\u89c4\u5212\u4f60\u7684\u5e03\u5c40\u4ee5\u6700\u5927\u5316\u7a7a\u95f4\u548c\u6548\u7387\u3002 \u6b65\u9aa42\uff1a\u4f7f\u7528\u94a2\u6750\u548c\u73bb\u7483\u7b49\u9ad8\u7ea7\u6750\u6599\u6765\u5efa\u9020\u66f4\u590d\u6742\u7684\u5efa\u7b51\u7269\u3002 \u6b65\u9aa43\uff1a\u878d\u5165\u666f\u89c2\u548c\u5ba4\u5185\u8bbe\u8ba1\u7b49\u7f8e\u5b66\u5143\u7d20\u6765\u589e\u5f3a\u89c6\u89c9\u5438\u5f15\u529b\u3002 \u4f8b\u5982\uff0c\u5728\u5c4b\u9876\u4e0a\u5efa\u9020\u4e00\u4e2a\u591a\u529f\u80fd\u5efa\u7b51\u548c\u82b1\u56ed\uff0c\u53ef\u4ee5\u517c\u987e\u5b9e\u7528\u6027\u548c\u7f8e\u89c2\u6027\u3002 \u4f7f\u7528\u914d\u7f6e\u8868\u53ef\u4ee5\u5e2e\u52a9\u4f60\u6bd4\u8f83\u4e0d\u540c\u6750\u6599\u53ca\u5176\u76ca\u5904\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u9ad8\u7ea7\u73a9\u5bb6\u5728\u300a\u5efa\u9020\u4e0e\u6467\u6bc1\u300b\u4e2d\u4f7f\u7528\u84dd\u56fe\u662f\u6709\u76ca\u7684\uff1f", "answer": "\u5728\u300a\u5efa\u9020\u4e0e\u6467\u6bc1\u300b\u4e2d\uff0c\u84dd\u56fe\u4e3a\u9ad8\u7ea7\u73a9\u5bb6\u63d0\u4f9b\u4e86\u4e00\u79cd\u521b\u5efa\u590d\u6742\u5efa\u7b51\u7684\u7b80\u5316\u65b9\u6cd5\u3002\u5b83\u4eec\u63d0\u4f9b\u9884\u8bbe\u8ba1\u7684\u5e03\u5c40\uff0c\u53ef\u4ee5\u8fdb\u884c\u5b9a\u5236\uff0c\u8282\u7701\u65f6\u95f4\u5e76\u786e\u4fdd\u7ed3\u6784\u5b8c\u6574\u6027\u3002 \u4f8b\u5982\uff0c\u4f7f\u7528\u84dd\u56fe\u5efa\u9020\u6469\u5929\u5927\u697c\uff0c\u53ef\u4ee5\u8ba9\u4f60\u4e13\u6ce8\u4e8e\u5b9a\u5236\u5185\u90e8\u548c\u5916\u90e8\u7ec6\u8282\uff0c\u800c\u4e0d\u662f\u4ece\u5934\u5f00\u59cb\u3002 \u84dd\u56fe\u4e5f\u6709\u52a9\u4e8e\u901a\u8fc7\u786e\u4fdd\u6700\u4f73\u8bbe\u8ba1\u548c\u529f\u80fd\u6765\u5728\u5efa\u7b51\u6311\u6218\u4e2d\u83b7\u5f97\u66f4\u9ad8\u7684\u5206\u6570\u3002"}, {"question": "\u5728\u300a\u5efa\u9020\u4e0e\u6467\u6bc1\u300b\u4e2d\uff0c\u9ad8\u6548\u7ba1\u7406\u8d44\u6e90\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300a\u5efa\u9020\u4e0e\u6467\u6bc1\u300b\u4e2d\u9ad8\u6548\u7ba1\u7406\u8d44\u6e90\u5305\u62ec\uff1a\u6b65\u9aa41\uff1a\u4f18\u5148\u6536\u96c6\u6728\u6750\u3001\u77f3\u5934\u548c\u91d1\u5c5e\u7b49\u57fa\u672c\u8d44\u6e90\u3002 \u6b65\u9aa42\uff1a\u5347\u7ea7\u4f60\u7684\u5b58\u50a8\u8bbe\u65bd\u4ee5\u5bb9\u7eb3\u66f4\u591a\u8d44\u6e90\u3002 \u6b65\u9aa43\uff1a\u56de\u6536\u62c6\u9664\u7684\u5efa\u7b51\u7269\u4ee5\u56de\u6536\u6750\u6599\u3002 \u4f8b\u5982\uff0c\u5728\u6467\u6bc1\u5efa\u7b51\u7269\u540e\uff0c\u4f60\u53ef\u4ee5\u56de\u6536\u788e\u7247\u4ee5\u83b7\u5f97\u90e8\u5206\u6240\u7528\u6750\u6599\u3002 \u521b\u5efa\u8d44\u6e90\u6d41\u7a0b\u56fe\u53ef\u4ee5\u5e2e\u52a9\u4f60\u66f4\u6709\u6548\u5730\u53ef\u89c6\u5316\u548c\u7ba1\u7406\u4f60\u7684\u8d44\u6e90\u5206\u914d\u3002"}, {"question": "\u300a\u5efa\u9020\u4e0e\u6467\u6bc1\u300b\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u5982\u4f55\u5f71\u54cd\u5efa\u7b51\u7684\u7a33\u5b9a\u6027\uff1f", "answer": "\u300a\u5efa\u9020\u4e0e\u6467\u6bc1\u300b\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u5728\u51b3\u5b9a\u5efa\u7b51\u7269\u7a33\u5b9a\u6027\u65b9\u9762\u8d77\u7740\u81f3\u5173\u91cd\u8981\u7684\u4f5c\u7528\u3002\u5b83\u6a21\u62df\u73b0\u5b9e\u4e16\u754c\u7684\u7269\u7406\uff0c\u8fd9\u610f\u5473\u7740\u5efa\u7b51\u7269\u5fc5\u987b\u5f97\u5230\u9002\u5f53\u7684\u652f\u6301\u624d\u80fd\u907f\u514d\u5012\u584c\u3002 \u4f8b\u5982\uff0c\u4e00\u5ea7\u6ca1\u6709\u8db3\u591f\u57fa\u7840\u652f\u6301\u7684\u9ad8\u5c42\u5efa\u7b51\u5c06\u4f1a\u503e\u5012\u3002 \u7406\u89e3\u7269\u7406\u5f15\u64ce\u53ef\u4ee5\u8ba9\u4f60\u8bbe\u8ba1\u51fa\u66f4\u7a33\u5b9a\u3001\u66f4\u8010\u7528\u7684\u5efa\u7b51\u7269\u3002 \u6750\u6599\u7a33\u5b9a\u6027\u8bc4\u7ea7\u6bd4\u8f83\u8868\u53ef\u4ee5\u5e2e\u52a9\u4f60\u505a\u51fa\u660e\u667a\u7684\u5efa\u7b51\u51b3\u7b56\u3002"}, {"question": "\u300a\u5efa\u9020\u4e0e\u6467\u6bc1\u300b\u4e2d\u8ba1\u5206\u7cfb\u7edf\u7684\u57fa\u672c\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u5efa\u9020\u4e0e\u6467\u6bc1\u300b\u4e2d\u7684\u8ba1\u5206\u7cfb\u7edf\u6839\u636e\u51e0\u4e2a\u56e0\u7d20\u8bc4\u4f30\u5efa\u7b51\u7269\uff1a\u590d\u6742\u6027\u3001\u7a33\u5b9a\u6027\u3001\u7f8e\u89c2\u6027\u548c\u529f\u80fd\u6027\u3002 \u4f8b\u5982\uff0c\u8bbe\u8ba1\u826f\u597d\u3001\u7a33\u5b9a\u4e14\u89c6\u89c9\u5438\u5f15\u529b\u7684\u5efa\u7b51\u7269\u5f97\u5206\u5c06\u4f1a\u9ad8\u4e8e\u7b80\u5355\u7684\uff0c\u4e0d\u7a33\u5b9a\u7684\u5efa\u7b51\u7269\u3002 \u8be5\u6e38\u620f\u8fd8\u4f1a\u5956\u52b1\u521b\u9020\u529b\u548c\u6709\u6548\u5229\u7528\u8d44\u6e90\u3002 \u4e86\u89e3\u8fd9\u4e9b\u673a\u5236\u53ef\u4ee5\u5e2e\u52a9\u4f60\u5728\u5efa\u9020\u6311\u6218\u4e2d\u83b7\u5f97\u66f4\u9ad8\u7684\u5206\u6570\u3002 \u8bc4\u5206\u6807\u51c6\u7684\u8be6\u7ec6\u5206\u89e3\u53ef\u4ee5\u7528\u6d41\u7a0b\u56fe\u6765\u66f4\u597d\u5730\u7406\u89e3\u3002"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684\u300a\u5efa\u9020\u4e0e\u6467\u6bc1\u300b\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u5e73\u53f0\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u5e73\u53f0\uff1f", "answer": "\u8981\u5c06\u300a\u5efa\u9020\u4e0e\u6467\u6bc1\u300b\u8fdb\u5ea6\u8de8\u5e73\u53f0\u8f6c\u79fb\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u786e\u4fdd\u4f60\u62e5\u6709\u5df2\u8fde\u63a5\u7684\u5e10\u6237\uff08\u4f8b\u5982\uff0c\u901a\u8fc7 Google Play \u6216 Apple ID\uff09\u3002 \u6b65\u9aa42\uff1a\u4f7f\u7528\u6e38\u620f\u4e2d\u7684\u4e91\u4fdd\u5b58\u529f\u80fd\u5c06\u4f60\u7684\u8fdb\u5ea6\u4e0a\u4f20\u3002 \u6b65\u9aa43\uff1a\u5728\u65b0\u5e73\u53f0\u4e0a\u4f7f\u7528\u76f8\u540c\u7684\u5e10\u6237\u767b\u5f55\u5e76\u4e0b\u8f7d\u4f60\u7684\u4fdd\u5b58\u6570\u636e\u3002 \u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4ece PC \u5207\u6362\u5230\u79fb\u52a8\u8bbe\u5907\uff0c\u4f60\u7684\u5efa\u7b51\u7269\u548c\u8d44\u6e90\u5c06\u5f97\u5230\u4fdd\u7559\u3002 \u8de8\u5e73\u53f0\u517c\u5bb9\u6027\u8868\u683c\u53ef\u4ee5\u5e2e\u52a9\u4f60\u4e86\u89e3\u54ea\u4e9b\u5e73\u53f0\u652f\u6301\u6b64\u529f\u80fd\u3002"}, {"question": "\u300a\u5efa\u9020\u4e0e\u6467\u6bc1\u300b\u4e2d\u662f\u5426\u5b58\u5728\u73a9\u5bb6\u53ef\u80fd\u5ffd\u7565\u7684\u9690\u85cf\u5f69\u86cb\u6216\u79d8\u5bc6\u533a\u57df\uff1f", "answer": "\u662f\u7684\uff0c\u300a\u5efa\u9020\u4e0e\u6467\u6bc1\u300b\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u7684\u5f69\u86cb\u548c\u79d8\u5bc6\u533a\u57df\u3002 \u4f8b\u5982\uff0c\u63a2\u7d22\u5730\u56fe\u8fb9\u7f18\u53ef\u80fd\u4f1a\u53d1\u73b0\u4e00\u4e2a\u9690\u85cf\u7684\u6d1e\u7a74\uff0c\u5176\u4e2d\u5305\u542b\u7a00\u6709\u8d44\u6e90\u6216\u72ec\u7279\u7684\u5efa\u7b51\u6750\u6599\u3002 \u53e6\u4e00\u4e2a\u4f8b\u5b50\u662f\u5728\u4f60\u5efa\u9020\u7684\u590d\u6742\u5efa\u7b51\u7269\u4e2d\u627e\u5230\u4e00\u4e2a\u9690\u85cf\u7684\u7279\u6b8a\u84dd\u56fe\u3002 \u8fd9\u4e9b\u9690\u85cf\u5143\u7d20\u4e3a\u6e38\u620f\u589e\u52a0\u4e86\u989d\u5916\u7684\u5174\u594b\u548c\u53d1\u73b0\u3002\u5305\u542b\u6f5c\u5728\u5f69\u86cb\u4f4d\u7f6e\u7684\u5730\u56fe\u53ef\u4ee5\u5f15\u5bfc\u4f60\u53d1\u73b0\u8fd9\u4e9b\u79d8\u5bc6\u3002"}]
[{"question": "\u5982\u4f55\u958b\u59cb\u5728\u300a\u5efa\u9020\u8207\u6467\u6bc0\u300b\u904a\u6232\u4e2d\u5efa\u9020\u6211\u7684\u7b2c\u4e00\u500b\u7d50\u69cb\uff0c\u4f5c\u70ba\u4e00\u500b\u65b0\u624b\uff1f", "answer": "\u8981\u5728\u300a\u5efa\u9020\u8207\u6467\u6bc0\u300b\u4e2d\u958b\u59cb\u5efa\u9020\uff0c\u8acb\u6309\u7167\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u958b\u555f\u904a\u6232\u4e26\u9078\u64c7\u300c\u5efa\u9020\u6a21\u5f0f\u300d\u3002\u6b65\u9a5f2\uff1a\u5f9e\u9078\u55ae\u4e2d\u9078\u64c7\u4e00\u500b\u57fa\u672c\u7d50\u69cb\u6a21\u677f\uff0c\u4f8b\u5982\u7c21\u55ae\u7684\u623f\u5c4b\u3002\u6b65\u9a5f3\uff1a\u4f7f\u7528\u87a2\u5e55\u4e0a\u7684\u63a7\u5236\u9805\u5c07\u7d50\u69cb\u653e\u7f6e\u5728\u60a8\u7684\u5834\u5730\u4e0a\u3002\u4f8b\u5982\uff0c\u60a8\u53ef\u4ee5\u5f9e\u4e00\u500b 2x2 \u7684\u6728\u5c4b\u958b\u59cb\uff0c\u4ee5\u719f\u6089\u904a\u6232\u6a5f\u5236\u3002\u8acb\u8a18\u4f4f\uff0c\u904a\u6232\u63d0\u4f9b\u6559\u5b78\uff0c\u6307\u5c0e\u60a8\u5b8c\u6210\u9019\u4e9b\u521d\u59cb\u6b65\u9a5f\uff0c\u8b93\u904a\u6232\u5c0d\u65b0\u624b\u4f86\u8aaa\u66f4\u52a0\u53cb\u597d\u3002"}, {"question": "\u300a\u5efa\u9020\u8207\u6467\u6bc0\u300b\u904a\u6232\u4e2d\u7684\u300c\u5efa\u9020\u6a21\u5f0f\u300d\u548c\u300c\u6467\u6bc0\u6a21\u5f0f\u300d\u4e4b\u9593\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "\u5728\u300a\u5efa\u9020\u8207\u6467\u6bc0\u300b\u4e2d\uff0c\u300c\u5efa\u9020\u6a21\u5f0f\u300d\u5141\u8a31\u60a8\u4f7f\u7528\u5404\u7a2e\u6750\u6599\u548c\u6a21\u677f\u4f86\u5275\u5efa\u7d50\u69cb\u3002\u4f8b\u5982\uff0c\u60a8\u53ef\u4ee5\u5efa\u9020\u4e00\u500b\u5177\u6709\u8a73\u7d30\u5167\u90e8\u7684\u591a\u5c64\u5efa\u7bc9\u3002\u53e6\u4e00\u65b9\u9762\uff0c\u300c\u6467\u6bc0\u6a21\u5f0f\u300d\u5141\u8a31\u60a8\u4f7f\u7528\u4e0d\u540c\u7684\u5de5\u5177\uff08\u4f8b\u5982\u63a8\u571f\u6a5f\u6216\u70b8\u85e5\uff09\u4f86\u62c6\u9664\u9019\u4e9b\u7d50\u69cb\u3002\u4e00\u500b\u5be6\u7528\u7684\u4f8b\u5b50\u662f\uff0c\u5728\u300c\u5efa\u9020\u6a21\u5f0f\u300d\u4e2d\u5efa\u9020\u4e00\u5ea7\u5854\uff0c\u7136\u5f8c\u5728\u300c\u6467\u6bc0\u6a21\u5f0f\u300d\u4e2d\u4f7f\u7528\u53d7\u63a7\u7206\u70b8\u5c07\u5176\u6467\u6bc0\uff0c\u9019\u65e2\u6709\u8da3\u53c8\u5177\u6709\u7b56\u7565\u6027\u3002"}, {"question": "\u904a\u6232\u521d\u671f\u5728\u300a\u5efa\u9020\u8207\u6467\u6bc0\u300b\u4e2d\u54ea\u4e9b\u8cc7\u6e90\u5c0d\u65bc\u904a\u6232\u9032\u5ea6\u6700\u70ba\u91cd\u8981\uff1f", "answer": "\u5728\u300a\u5efa\u9020\u8207\u6467\u6bc0\u300b\u904a\u6232\u521d\u671f\uff0c\u6728\u6750\u548c\u77f3\u982d\u5c0d\u65bc\u904a\u6232\u9032\u5ea6\u81f3\u95dc\u91cd\u8981\u3002\u9019\u4e9b\u8cc7\u6e90\u662f\u5efa\u9020\u57fa\u672c\u7d50\u69cb\u548c\u5347\u7d1a\u5b83\u5011\u6240\u4e0d\u53ef\u6216\u7f3a\u7684\u3002\u4f8b\u5982\uff0c\u6728\u6750\u7528\u65bc\u6846\u67b6\u548c\u57fa\u672c\u7246\u58c1\uff0c\u800c\u77f3\u982d\u5c0d\u65bc\u66f4\u5805\u56fa\u7684\u7d50\u69cb\u81f3\u95dc\u91cd\u8981\u3002\u60a8\u53ef\u4ee5\u900f\u904e\u63a2\u7d22\u5730\u5716\u6216\u5b8c\u6210\u7c21\u55ae\u7684\u4efb\u52d9\u4f86\u6536\u96c6\u9019\u4e9b\u8cc7\u6e90\u3002\u6709\u6548\u5730\u7ba1\u7406\u9019\u4e9b\u8cc7\u6e90\u5c07\u5e6b\u52a9\u60a8\u5728\u904a\u6232\u521d\u671f\u9806\u5229\u9032\u5c55\u3002"}, {"question": "\u5728\u300a\u5efa\u9020\u8207\u6467\u6bc0\u300b\u904a\u6232\u4e2d\u73a9\u4e86 100 \u5c0f\u6642\u5f8c\uff0c\u5982\u4f55\u512a\u5316\u6211\u7684\u5efa\u7bc9\u7b56\u7565\uff1f", "answer": "\u5728\u300a\u5efa\u9020\u8207\u6467\u6bc0\u300b\u904a\u6232\u4e2d\u73a9\u4e86 100 \u5c0f\u6642\u5f8c\uff0c\u512a\u5316\u60a8\u7684\u5efa\u7bc9\u7b56\u7565\u5305\u62ec\uff1a\u6b65\u9a5f1\uff1a\u898f\u5283\u60a8\u7684\u4f48\u5c40\u4ee5\u6700\u5927\u5316\u7a7a\u9593\u548c\u6548\u7387\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u92fc\u9435\u548c\u73bb\u7483\u7b49\u5148\u9032\u6750\u6599\u4f86\u5efa\u9020\u66f4\u8907\u96dc\u7684\u7d50\u69cb\u3002\u6b65\u9a5f3\uff1a\u878d\u5165\u7f8e\u5b78\u5143\u7d20\uff0c\u4f8b\u5982\u666f\u89c0\u548c\u5ba4\u5167\u8a2d\u8a08\uff0c\u4ee5\u63d0\u5347\u8996\u89ba\u5438\u5f15\u529b\u3002\u4f8b\u5982\uff0c\u5728\u5c4b\u9802\u4e0a\u5efa\u9020\u4e00\u500b\u591a\u529f\u80fd\u5efa\u7bc9\u548c\u82b1\u5712\uff0c\u53ef\u4ee5\u517c\u9867\u5be6\u7528\u6027\u548c\u7f8e\u89c0\u6027\u3002\u4f7f\u7528\u914d\u7f6e\u8868\u683c\u53ef\u4ee5\u5e6b\u52a9\u60a8\u6bd4\u8f03\u4e0d\u540c\u6750\u6599\u53ca\u5176\u512a\u9ede\u3002"}, {"question": "\u5728\u300a\u5efa\u9020\u8207\u6467\u6bc0\u300b\u904a\u6232\u4e2d\uff0c\u5c0d\u65bc\u4e0a\u7d1a\u73a9\u5bb6\u4f86\u8aaa\u4f7f\u7528\u85cd\u5716\u6709\u4ec0\u9ebc\u597d\u8655\uff1f", "answer": "\u5728\u300a\u5efa\u9020\u8207\u6467\u6bc0\u300b\u904a\u6232\u4e2d\uff0c\u85cd\u5716\u70ba\u4e0a\u7d1a\u73a9\u5bb6\u63d0\u4f9b\u4e86\u4e00\u7a2e\u7c21\u5316\u65b9\u5f0f\u4f86\u5275\u5efa\u8907\u96dc\u7684\u7d50\u69cb\u3002\u5b83\u5011\u63d0\u4f9b\u53ef\u4ee5\u5ba2\u88fd\u5316\u7684\u9810\u5148\u8a2d\u8a08\u4f48\u5c40\uff0c\u7bc0\u7701\u6642\u9593\u4e26\u78ba\u4fdd\u7d50\u69cb\u5b8c\u6574\u6027\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u85cd\u5716\u4f86\u5efa\u9020\u6469\u5929\u5927\u6a13\uff0c\u8b93\u60a8\u53ef\u4ee5\u5c08\u6ce8\u65bc\u5ba2\u88fd\u5316\u5ba4\u5167\u548c\u5ba4\u5916\u7d30\u7bc0\uff0c\u800c\u4e0d\u662f\u5f9e\u982d\u958b\u59cb\u3002\u85cd\u5716\u4e5f\u80fd\u5920\u900f\u904e\u78ba\u4fdd\u6700\u4f73\u8a2d\u8a08\u548c\u529f\u80fd\u4f86\u5e6b\u52a9\u60a8\u5728\u5efa\u7bc9\u6311\u6230\u4e2d\u7372\u5f97\u66f4\u9ad8\u5206\u6578\u3002"}, {"question": "\u5728\u300a\u5efa\u9020\u8207\u6467\u6bc0\u300b\u904a\u6232\u4e2d\uff0c\u5982\u4f55\u6709\u6548\u7ba1\u7406\u8cc7\u6e90\uff1f", "answer": "\u5728\u300a\u5efa\u9020\u8207\u6467\u6bc0\u300b\u904a\u6232\u4e2d\uff0c\u6709\u6548\u7ba1\u7406\u8cc7\u6e90\u5305\u62ec\uff1a\u6b65\u9a5f1\uff1a\u512a\u5148\u6536\u96c6\u6728\u6750\u3001\u77f3\u982d\u548c\u91d1\u5c6c\u7b49\u5fc5\u8981\u8cc7\u6e90\u3002\u6b65\u9a5f2\uff1a\u5347\u7d1a\u60a8\u7684\u5132\u5b58\u8a2d\u65bd\u4ee5\u5bb9\u7d0d\u66f4\u591a\u8cc7\u6e90\u3002\u6b65\u9a5f3\uff1a\u56de\u6536\u62c6\u9664\u7684\u7d50\u69cb\u4ee5\u56de\u6536\u6750\u6599\u3002\u4f8b\u5982\uff0c\u5728\u6467\u6bc0\u5efa\u7bc9\u7269\u5f8c\uff0c\u60a8\u53ef\u4ee5\u56de\u6536\u788e\u7247\u4ee5\u6536\u56de\u90e8\u5206\u6240\u7528\u6750\u6599\u3002\u5efa\u7acb\u8cc7\u6e90\u6d41\u7a0b\u5716\u53ef\u4ee5\u66f4\u6709\u6548\u5730\u5e6b\u52a9\u60a8\u8996\u89ba\u5316\u548c\u7ba1\u7406\u60a8\u7684\u8cc7\u6e90\u5206\u914d\u3002"}, {"question": "\u300a\u5efa\u9020\u8207\u6467\u6bc0\u300b\u904a\u6232\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u5982\u4f55\u5f71\u97ff\u5efa\u7bc9\u7269\u7684\u7a69\u5b9a\u6027\uff1f", "answer": "\u300a\u5efa\u9020\u8207\u6467\u6bc0\u300b\u904a\u6232\u4e2d\u7684\u7269\u7406\u5f15\u64ce\u5728\u6c7a\u5b9a\u60a8\u7684\u5efa\u7bc9\u7a69\u5b9a\u6027\u65b9\u9762\u626e\u6f14\u8457\u81f3\u95dc\u91cd\u8981\u7684\u89d2\u8272\u3002\u5b83\u6a21\u64ec\u771f\u5be6\u4e16\u754c\u7684\u7269\u7406\u5b78\uff0c\u610f\u5473\u8457\u7d50\u69cb\u5fc5\u9808\u5f97\u5230\u9069\u7576\u652f\u6490\u624d\u80fd\u907f\u514d\u5012\u584c\u3002\u4f8b\u5982\uff0c\u7f3a\u4e4f\u8db3\u5920\u57fa\u790e\u652f\u6490\u7684\u9ad8\u5c64\u5efa\u7bc9\u6703\u50be\u5012\u3002\u4e86\u89e3\u7269\u7406\u5f15\u64ce\u5c07\u4f7f\u60a8\u80fd\u5920\u8a2d\u8a08\u51fa\u66f4\u7a69\u5b9a\u548c\u66f4\u6301\u4e45\u7684\u7d50\u69cb\u3002\u4e0d\u540c\u6750\u6599\u53ca\u5176\u7a69\u5b9a\u6027\u8a55\u7d1a\u7684\u5c0d\u7167\u8868\u53ef\u4ee5\u5e6b\u52a9\u60a8\u505a\u51fa\u660e\u667a\u7684\u5efa\u7bc9\u6c7a\u7b56\u3002"}, {"question": "\u300a\u5efa\u9020\u8207\u6467\u6bc0\u300b\u904a\u6232\u4e2d\u7684\u7a4d\u5206\u7cfb\u7d71\u80cc\u5f8c\u7684\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "\u300a\u5efa\u9020\u8207\u6467\u6bc0\u300b\u904a\u6232\u4e2d\u7684\u7a4d\u5206\u7cfb\u7d71\u6839\u64da\u5e7e\u500b\u56e0\u7d20\u8a55\u4f30\u7d50\u69cb\uff1a\u8907\u96dc\u5ea6\u3001\u7a69\u5b9a\u6027\u3001\u7f8e\u89c0\u6027\u548c\u529f\u80fd\u6027\u3002\u4f8b\u5982\uff0c\u8a2d\u8a08\u7cbe\u826f\u3001\u7a69\u5b9a\u4e14\u7f8e\u89c0\u7684\u5efa\u7bc9\u7269\u5c07\u6bd4\u7c21\u55ae\u4e14\u4e0d\u7a69\u5b9a\u7684\u5efa\u7bc9\u7269\u7372\u5f97\u66f4\u9ad8\u7684\u7a4d\u5206\u3002\u904a\u6232\u4e5f\u734e\u52f5\u5275\u9020\u529b\u548c\u6709\u6548\u5229\u7528\u8cc7\u6e90\u3002\u4e86\u89e3\u9019\u4e9b\u6a5f\u5236\u53ef\u4ee5\u5e6b\u52a9\u60a8\u5728\u5efa\u7bc9\u6311\u6230\u4e2d\u7372\u5f97\u66f4\u9ad8\u7684\u7a4d\u5206\u3002\u7a4d\u5206\u6a19\u6e96\u7684\u8a73\u7d30\u5206\u89e3\u53ef\u4ee5\u7528\u6d41\u7a0b\u5716\u4f86\u66f4\u597d\u5730\u7406\u89e3\u3002"}, {"question": "\u5982\u4f55\u5c07\u6211\u7684\u300a\u5efa\u9020\u8207\u6467\u6bc0\u300b\u904a\u6232\u9032\u5ea6\u5f9e\u4e00\u500b\u5e73\u53f0\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u5e73\u53f0\uff1f", "answer": "\u8981\u5c07\u60a8\u7684\u300a\u5efa\u9020\u8207\u6467\u6bc0\u300b\u904a\u6232\u9032\u5ea6\u8de8\u5e73\u53f0\u8f49\u79fb\uff0c\u8acb\u6309\u7167\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u78ba\u4fdd\u60a8\u5df2\u9023\u7d50\u5e33\u6236\uff08\u4f8b\u5982\uff0c\u900f\u904e Google Play \u6216 Apple ID\uff09\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u904a\u6232\u4e2d\u7684\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u4e0a\u50b3\u60a8\u7684\u9032\u5ea6\u3002\u6b65\u9a5f3\uff1a\u5728\u65b0\u7684\u5e73\u53f0\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u4e26\u4e0b\u8f09\u60a8\u7684\u5132\u5b58\u8cc7\u6599\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9e\u500b\u4eba\u96fb\u8166\u8f49\u63db\u5230\u884c\u52d5\u88dd\u7f6e\uff0c\u60a8\u7684\u5efa\u7bc9\u7269\u548c\u8cc7\u6e90\u5c07\u5f97\u5230\u4fdd\u7559\u3002\u8de8\u5e73\u53f0\u76f8\u5bb9\u6027\u8868\u53ef\u4ee5\u5e6b\u52a9\u60a8\u4e86\u89e3\u54ea\u4e9b\u5e73\u53f0\u652f\u63f4\u6b64\u529f\u80fd\u3002"}, {"question": "\u300a\u5efa\u9020\u8207\u6467\u6bc0\u300b\u904a\u6232\u4e2d\u662f\u5426\u6709\u4efb\u4f55\u96b1\u85cf\u7684\u5f69\u86cb\u6216\u73a9\u5bb6\u53ef\u80fd\u6703\u5ffd\u7565\u7684\u79d8\u5bc6\u5340\u57df\uff1f", "answer": "\u662f\u7684\uff0c\u300a\u5efa\u9020\u8207\u6467\u6bc0\u300b\u5305\u542b\u4e00\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\u548c\u79d8\u5bc6\u5340\u57df\u3002\u4f8b\u5982\uff0c\u63a2\u7d22\u5730\u5716\u7684\u908a\u7de3\u53ef\u80fd\u6703\u767c\u73fe\u4e00\u500b\u96b1\u85cf\u7684\u6d1e\u7a74\uff0c\u5176\u4e2d\u5305\u542b\u7a00\u6709\u8cc7\u6e90\u6216\u7368\u7279\u7684\u5efa\u7bc9\u6750\u6599\u3002\u53e6\u4e00\u500b\u4f8b\u5b50\u662f\uff0c\u5728\u60a8\u5efa\u9020\u7684\u8907\u96dc\u7d50\u69cb\u4e2d\u627e\u5230\u4e00\u500b\u7279\u6b8a\u7684\u85cd\u5716\u3002\u9019\u4e9b\u96b1\u85cf\u5143\u7d20\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u984d\u5916\u7684\u8208\u596e\u548c\u767c\u73fe\u3002\u5730\u5716\u4e2d\u7684\u6f5b\u5728\u5f69\u86cb\u4f4d\u7f6e\u53ef\u4ee5\u6307\u5c0e\u60a8\u63ed\u958b\u9019\u4e9b\u79d8\u5bc6\u3002"}]
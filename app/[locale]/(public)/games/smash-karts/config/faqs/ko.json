[{"question": "\uc2e0\uaddc \ud50c\ub808\uc774\uc5b4\uac00 \uc288\ud37c \uce74\ud2b8\uc5d0\uc11c \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \uc219\ub2ec\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc288\ud37c \uce74\ud2b8\uc5d0\uc11c \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \uc219\ub2ec\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. 1\ub2e8\uacc4 - WASD \ud0a4 \ub610\ub294 \ud654\uc0b4\ud45c \ud0a4\uc640 \ubd80\uc2a4\ud130 \ubc84\ud2bc(\uc26c\ud504\ud2b8)\uc744 \uc775\uc219\ud574\uc9c0\uc138\uc694. 2\ub2e8\uacc4 - \uc801\uc744 \uc870\uc900\ud558\uace0 \uacf5\uaca9\ud558\ub294 \uc288\ud305 \uba54\ucee4\ub2c8\uc998(\uc2a4\ud398\uc774\uc2a4\ubc14) \uc0ac\uc6a9\ubc95\uc744 \uc5f0\uc2b5\ud558\uc138\uc694. 3\ub2e8\uacc4 - '\ub85c\ucf13 \ub7f0\ucc98'\uc640 \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \ucc28\uc5d0 \ud0c0\uace0 \ud68d\ub4dd\ud558\uc5ec \uc0ac\uc6a9\ud558\ub294 \ubc95\uc744 \ubc30\uc6b0\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uc0ac\ub9c9 \uc9c8\uc8fc' \uc9c0\ub3c4\uc5d0\uc11c \ubd80\uc2a4\ud130\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc881\uc740 \ucf54\ub108\ub97c \ub3cc\uace0 \ud30c\uc6cc\uc5c5\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \ud68d\ub4dd\ud558\uc138\uc694. [\ube44\uc720 \uc124\uba85: \ucee8\ud2b8\ub864\uc744 \uaca9\ud22c \uc694\uc18c\uac00 \ucd94\uac00\ub41c \uace8\ud504 \uce74\ud2b8 \uc6b4\uc804\uacfc \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uc138\uc694.]"}, {"question": "\uc288\ud37c \uce74\ud2b8 \ub9e4\uce58\uc5d0\uc11c \ucd08\ubcf4\uc790\uac00 \ub354 \uc624\ub798 \ubc84\ud2f0\ub294 \ub370 \uac00\uc7a5 \uc88b\uc740 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc288\ud37c \uce74\ud2b8 \ub9e4\uce58\uc5d0\uc11c \ub354 \uc624\ub798 \ubc84\ud2f0\ub824\uba74 \ucd08\ubcf4\uc790\ub294 \ub2e4\uc74c \uc804\ub7b5\uc5d0 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. 1\ub2e8\uacc4 - \uc27d\uac8c \ud45c\uc801\uc774 \ub418\uc9c0 \uc54a\ub3c4\ub85d \uacc4\uc18d \uc6c0\uc9c1\uc774\uc138\uc694. 2\ub2e8\uacc4 - \ubcbd\uacfc \uc7a5\uc560\ubb3c\uacfc \uac19\uc740 \ud658\uacbd\uc744 \uc774\uc6a9\ud558\uc5ec \uc740\uc2e0\ucc98\ub97c \ud655\ubcf4\ud558\uc138\uc694. 3\ub2e8\uacc4 - \uacf5\uaca9\uc801\uc778 \ud30c\uc6cc\uc5c5\ubcf4\ub2e4\ub294 '\ubc29\ud328'\uc640 \uac19\uc740 \ubc29\uc5b4\ud615 \ud30c\uc6cc\uc5c5\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\ub3c4\uc2dc \uacbd\uae30\uc7a5' \uc9c0\ub3c4\uc5d0\uc11c \uc881\uc740 \uace8\ubaa9\uae38\uc744 \uc774\uc6a9\ud558\uc5ec \uc801\uc758 \uacf5\uaca9\uc744 \ud53c\ud558\uc138\uc694. [\ub2e4\uc591\ud55c \ud574\ubc95 \ube44\uad50: \uacf5\uaca9\uc801\uc778 \ud50c\ub808\uc774\ub294 \ube60\ub978 \ucc98\uce58\ub97c \uac00\uc838\ub2e4\uc904 \uc218 \uc788\uc9c0\ub9cc \uc704\ud5d8\ub3c4\uac00 \ub192\uace0, \ubc29\uc5b4\uc801\uc778 \ud50c\ub808\uc774\ub294 \uc7a5\uae30\uc801\uc778 \uc0dd\uc874\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4.]"}, {"question": "\uc288\ud37c \uce74\ud2b8\uc5d0\uc11c \uc2e0\uaddc \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ud30c\uc6cc\uc5c5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc288\ud37c \uce74\ud2b8\uc5d0\uc11c \uc2e0\uaddc \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ud30c\uc6cc\uc5c5\uc740 '\ubc29\ud328'\uc640 '\uccb4\ub825 \ud68c\ubcf5'\uc785\ub2c8\ub2e4. '\ubc29\ud328'\ub294 \uc77c\uc2dc\uc801\uc778 \ubb34\uc801 \uc0c1\ud0dc\ub97c \uc81c\uacf5\ud558\uc5ec \uc704\ud5d8\ud55c \uc0c1\ud669\uc5d0\uc11c \ubc97\uc5b4\ub0a0 \uc218 \uc788\uac8c \ud558\uace0, '\uccb4\ub825 \ud68c\ubcf5'\uc740 \uccb4\ub825\uc744 \ud68c\ubcf5\uc2dc\ucf1c\uc90d\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc815\uae00 \uc720\uc801' \uc9c0\ub3c4\uc5d0\uc11c \ud3ed\ud3ec \uadfc\ucc98 '\uccb4\ub825 \ud68c\ubcf5' \uc544\uc774\ud15c\uc744 \ud68d\ub4dd\ud558\uba74 \uc804\ud22c\uc758 \uc0c1\ud669\uc744 \ubc14\uafc0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \ubc29\ud328(\ubc29\uc5b4) \ub300 \ub85c\ucf13 \ub7f0\ucc98(\uacf5\uaca9) - \ubc29\ud328\ub294 \ucd08\ubcf4\uc790\uc5d0\uac8c \uc548\uc804\ud569\ub2c8\ub2e4.]"}, {"question": "\uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\uac00 \uc288\ud37c \uce74\ud2b8\uc5d0\uc11c \uc790\uc2e0\uc758 \uce74\ud2b8 \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\ub294 \ub2e4\uc74c \uace0\uae09 \uae30\uc220\uc5d0 \uc9d1\uc911\ud558\uc5ec \uce74\ud2b8 \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 1\ub2e8\uacc4 - \ub4dc\ub9ac\ud504\ud2b8 \ubc84\ud2bc(Ctrl)\uc744 \ub204\ub974\uace0 \uc801\uc808\ud55c \uc2dc\uae30\uc5d0 \ub5bc\uc5b4\ub0b4\ub294 \ub4dc\ub9ac\ud504\ud2b8 \ubd80\uc2a4\ud130 \uae30\uc220\uc744 \uc644\ubcbd\ud558\uac8c \uc219\ub2ec\ud558\uc138\uc694. 2\ub2e8\uacc4 - \ubd80\uc2a4\ud130\ub97c \uc5f0\uc18d\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc5ec \ub192\uc740 \uc18d\ub3c4\ub97c \uc720\uc9c0\ud558\uc138\uc694. 3\ub2e8\uacc4 - \uc0c1\ub300\ub97c \uc81c\uc555\ud558\uae30 \uc704\ud574 '\uc18d\ub3c4 \ubd80\uc2a4\ud130'\uc640 \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\ub208\uae38 \ucf54\uc2a4' \uc9c0\ub3c4\uc5d0\uc11c \uc5bc\uc74c\uae38 \ucf54\ub108\ub97c \ub4dc\ub9ac\ud504\ud2b8 \ubd80\uc2a4\ud130\ub85c \ub3cc\uba74 \uc0c1\ub2f9\ud55c \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \ub4dc\ub9ac\ud504\ud2b8 -> \ubd80\uc2a4\ud130 -> \uc5f0\uc18d \ubd80\uc2a4\ud130 \ucd5c\ub300 \uc18d\ub3c4.]"}, {"question": "\uc288\ud37c \uce74\ud2b8\uc5d0\uc11c \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc9c0\ub3c4 \uc778\uc2dd\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc288\ud37c \uce74\ud2b8\uc5d0\uc11c \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc9c0\ub3c4 \uc778\uc2dd\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \uc801\uc758 \uc6c0\uc9c1\uc784\uc744 \uc608\uce21\ud558\uace0 \ud30c\uc6cc\uc5c5 \ud68d\ub4dd \uc704\uce58\ub97c \ud1b5\uc81c\ud560 \uc218 \uc788\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. 1\ub2e8\uacc4 - \ud30c\uc6cc\uc5c5\uacfc \uccb4\ub825 \ud68c\ubcf5 \uc544\uc774\ud15c\uc758 \uc704\uce58\ub97c \uc219\uc9c0\ud558\uc138\uc694. 2\ub2e8\uacc4 - \ubbf8\ub2c8\ub9f5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc801\uc758 \uc704\uce58\ub97c \ucd94\uc801\ud558\uc138\uc694. 3\ub2e8\uacc4 - \uc0dd\uc874 \ubc0f \uc2b9\ub9ac \uac00\ub2a5\uc131\uc744 \uadf9\ub300\ud654\ud558\ub294 \uacbd\ub85c\ub97c \uacc4\ud68d\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\ub3c4\uc2dc \uac70\ub9ac' \uc9c0\ub3c4\uc5d0\uc11c \ubd84\uc218 \uadfc\ucc98\uc758 \uc9c0\ub984\uae38\uc744 \uc54c\uace0 \uc788\ub2e4\uba74 \uc801\uc744 \ud53c\ud558\uac70\ub098 \uae30\uc2b5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc9c0\ub3c4\ub97c \uccb4\uc2a4\ud310\uc73c\ub85c \uc0dd\uac01\ud558\uc138\uc694. \ubc30\uce58\uac00 \uc2b9\ub9ac\uc758 \ud575\uc2ec\uc785\ub2c8\ub2e4.]"}, {"question": "\uc288\ud37c \uce74\ud2b8\uc5d0\uc11c \uc194\ub85c \ud50c\ub808\uc774\uc640 \ud300 \ud50c\ub808\uc774 \uc804\ub7b5\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc288\ud37c \uce74\ud2b8\uc5d0\uc11c \uc194\ub85c \ud50c\ub808\uc774\uc640 \ud300 \ud50c\ub808\uc774 \uc804\ub7b5\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ud611\ub825\uacfc \uc5ed\ud560 \uc804\ubb38\ud654\uc785\ub2c8\ub2e4. 1\ub2e8\uacc4 - \uc194\ub85c \ud50c\ub808\uc774\uc5d0\uc11c\ub294 \uc790\uae30 \ubcf4\uc874\uacfc \uc801\uc808\ud55c \ud0c0\uc774\ubc0d\uc758 \ucc98\uce58\uc5d0 \uc9d1\uc911\ud558\uc138\uc694. 2\ub2e8\uacc4 - \ud300 \ud50c\ub808\uc774\uc5d0\uc11c\ub294 \ub3d9\ub8cc\ub4e4\uacfc \uc758\uc0ac\uc18c\ud1b5\ud558\uc5ec \uacf5\uaca9\uacfc \ubc29\uc5b4\ub97c \uc870\uc728\ud558\uc138\uc694. 3\ub2e8\uacc4 - \ud30c\uc6cc\uc5c5\uacfc \uce74\ud2b8 \uc131\ub2a5\uc5d0 \ub530\ub77c '\uacf5\uaca9\uc218' \ub610\ub294 '\uc218\ube44\uc218'\uc640 \uac19\uc740 \uc5ed\ud560\uc744 \ubd84\ub2f4\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\ud654\uc0b0 \uacc4\uace1' \uc9c0\ub3c4\uc5d0\uc11c \ud300\uc6cc\ud06c\uac00 \uc798 \ub9de\ub294 \ud300\uc740 \uace0\uc9c0\ub300\ub97c \uc7a5\uc545\ud558\uace0 \uacbd\uae30\ub97c \uc9c0\ubc30\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ud574\ubc95 \ube44\uad50: \uc194\ub85c \ud50c\ub808\uc774\ub294 \uac1c\uc778 \uae30\uc220\uc5d0 \ucd08\uc810\uc744 \ub9de\ucd94\ub294 \ubc18\uba74, \ud300 \ud50c\ub808\uc774\ub294 \ud300\uc6cc\ud06c\uac00 \ud544\uc218\uc801\uc785\ub2c8\ub2e4.]"}, {"question": "\uc288\ud37c \uce74\ud2b8\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc11c\ub85c \ub2e4\ub978 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc744 \uc5b4\ub5bb\uac8c \uc7a5\ub824\ud569\ub2c8\uae4c?", "answer": "\uc288\ud37c \uce74\ud2b8\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ucc98\uce58\uc640 \uc0dd\uc874 \ubaa8\ub450\ub97c \ubcf4\uc0c1\ud558\uc5ec \uc11c\ub85c \ub2e4\ub978 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc744 \uc7a5\ub824\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4 - \ud50c\ub808\uc774\uc5b4\ub294 \uc0c1\ub300\ub97c \uc81c\uac70\ud558\uc5ec \uacf5\uaca9\uc801\uc778 \ud50c\ub808\uc774\ub97c \uc7a5\ub824\ud558\ub294 \uc810\uc218\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. 2\ub2e8\uacc4 - \uacbd\uae30 \uc885\ub8cc\uc2dc\uae4c\uc9c0 \uc0b4\uc544\ub0a8\ub294 \uac83\ub3c4 \ubc29\uc5b4\uc801\uc778 \uc804\ub7b5\uc744 \uc7a5\ub824\ud558\ub294 \uc810\uc218\ub97c \uac00\uc838\uc635\ub2c8\ub2e4. 3\ub2e8\uacc4 - \ud30c\uc6cc\uc5c5\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uba74 \ubcf4\ub108\uc2a4 \uc810\uc218\uac00 \uc81c\uacf5\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc6b0\uc8fc \uc815\uac70\uc7a5' \uc9c0\ub3c4\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 '\ub85c\ucf13 \ub7f0\ucc98'\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc5ec\ub7ec \uba85\uc744 \ucc98\uce58\ud558\uba74 \ub354 \ub9ce\uc740 \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \ucc98\uce58(\uacf5\uaca9\uc801) vs \uc0dd\uc874(\ubc29\uc5b4\uc801) - \ub458 \ub2e4 \uc810\uc218 \ud68d\ub4dd\uc5d0 \uc720\ud6a8\ud569\ub2c8\ub2e4.]"}, {"question": "\uc288\ud37c \uce74\ud2b8\uc758 \ud30c\uc6cc\uc5c5 \uc0dd\uc131 \uc2dc\uc2a4\ud15c\uc758 \uae30\ubcf8 \uc6d0\ub9ac\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc288\ud37c \uce74\ud2b8\uc758 \ud30c\uc6cc\uc5c5 \uc0dd\uc131 \uc2dc\uc2a4\ud15c\uc740 \ud0c0\uc774\uba38 \uae30\ubc18\uc774\uace0 \uc704\uce58\uac00 \ubb34\uc791\uc704\ub85c \uacb0\uc815\ub429\ub2c8\ub2e4. 1\ub2e8\uacc4 - \ud30c\uc6cc\uc5c5\uc740 \uc77c\ubc18\uc801\uc73c\ub85c 30\ucd08\ub9c8\ub2e4 \uace0\uc815\ub41c \uac04\uaca9\uc73c\ub85c \uc0dd\uc131\ub429\ub2c8\ub2e4. 2\ub2e8\uacc4 - \uadf8\ub4e4\uc758 \uc704\uce58\ub294 \uc9c0\ub3c4\uc758 \uc0ac\uc804 \uc815\uc758\ub41c \uc601\uc5ed \ub0b4\uc5d0\uc11c \ubb34\uc791\uc704\ub85c \uacb0\uc815\ub429\ub2c8\ub2e4. 3\ub2e8\uacc4 - \uc77c\ubd80 \ud30c\uc6cc\uc5c5, \uc608\ub97c \ub4e4\uc5b4 '\uace8\ub4e0 \uac74'\uacfc \uac19\uc740 \ud30c\uc6cc\uc5c5\uc740 \uc0dd\uc131 \ube48\ub3c4\uac00 \ub0ae\uc9c0\ub9cc \uc601\ud5a5\ub825\uc774 \ub354 \ub192\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud574\uc801 \ud56d\uad6c' \uc9c0\ub3c4\uc5d0\uc11c \ud30c\uc6cc\uc5c5\uc740 \uc885\uc885 \ub09c\ud30c\uc120 \uadfc\ucc98\uc5d0 \uc0dd\uc131\ub418\uc5b4 \uc804\ud22c\uc758 \ud56b\uc2a4\ud31f\uc774 \ub429\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud30c\uc6cc\uc5c5\uc744 \ubc30\ud2c0 \ub85c\uc584 \uac8c\uc784\uc758 \uc804\ub9ac\ud488 \ub4dc\ub78d\uacfc \uac19\ub2e4\uace0 \uc0dd\uac01\ud558\uc138\uc694.]"}, {"question": "\uc288\ud37c \uce74\ud2b8\ub294 \ub2e4\uc911 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774\uc640 \ub370\uc774\ud130 \ub3d9\uae30\ud654\ub97c \uc5b4\ub5bb\uac8c \ucc98\ub9ac\ud569\ub2c8\uae4c?", "answer": "\uc288\ud37c \uce74\ud2b8\ub294 \ud1b5\ud569 \uacc4\uc815 \uc2dc\uc2a4\ud15c\uc744 \ud1b5\ud574 \ub2e4\uc911 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774\uc640 \ub370\uc774\ud130 \ub3d9\uae30\ud654\ub97c \ucc98\ub9ac\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4 - \ud50c\ub808\uc774\uc5b4\ub294 \uc774\uba54\uc77c \ub610\ub294 \uc18c\uc15c \ubbf8\ub514\uc5b4 \ub85c\uadf8\uc778\uc744 \uc0ac\uc6a9\ud558\uc5ec PC, \ucf58\uc194, \ubaa8\ubc14\uc77c \ub4f1 \uc5ec\ub7ec \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uacc4\uc815\uc744 \uc5f0\uacb0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 2\ub2e8\uacc4 - \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669(\uc7a0\uae08 \ud574\uc81c \ubc0f \uc5c5\uc801 \ud3ec\ud568)\uc740 \ubaa8\ub4e0 \uae30\uae30\uc5d0\uc11c \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. 3\ub2e8\uacc4 - \ub2e4\uc911 \ud50c\ub7ab\ud3fc \ub9e4\uce58\ub294 \uacf5\uc815\ud55c \ud50c\ub808\uc774\ub97c \ubcf4\uc7a5\ud558\ub3c4\ub85d \uade0\ud615\uc774 \ub9de\ucdb0\uc838 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud50c\ub808\uc774\uc5b4\uac00 PC\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \uce74\ud2b8 \uc2a4\ud0a8\uc744 \uc7a0\uae08 \ud574\uc81c\ud558\uba74 \ubaa8\ubc14\uc77c \uacc4\uc815\uc5d0\uc11c\ub3c4 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: PC \ub300 \ubaa8\ubc14\uc77c \ucee8\ud2b8\ub864 - \ub2e4\uc911 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774\ub294 \ubaa8\ub4e0 \ud50c\ub808\uc774\uc5b4\uac00 \uacf5\uc815\ud55c \uacbd\ud5d8\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4.]"}, {"question": "\uc288\ud37c \uce74\ud2b8\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud50c\ub808\uc774\uc5b4\ub294 \uc9c0\ub3c4\ub97c \ucca0\uc800\ud788 \ud0d0\ud5d8\ud558\uc5ec \uc288\ud37c \uce74\ud2b8\uc5d0\uc11c \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 1\ub2e8\uacc4 - '\uc815\uae00 \uc720\uc801' \uc9c0\ub3c4\uc758 '\ubbf8\uc2a4\ud130\ub9ac \ub3d9\uad74'\uacfc \uac19\uc740 \uc228\uaca8\uc9c4 \uc9c0\uc5ed\uc774\ub098 \uc0c1\ud638 \uc791\uc6a9 \ub300\uc0c1\uc744 \ucc3e\uc544\ubcf4\uc138\uc694. 2\ub2e8\uacc4 - \uc77c\ubd80 \ud30c\uc6cc\uc5c5\uc740 \ud2b9\uc815 \uc704\uce58\uc5d0\uc11c \uc0ac\uc6a9\ud560 \ub54c \uace0\uc720\ud55c \uc2dc\uac01\uc801 \ub610\ub294 \uc74c\ud5a5 \ud6a8\uacfc\ub97c \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. 3\ub2e8\uacc4 - \uc5f0\uc18d 10\ubc88 \uc2b9\ub9ac\uc640 \uac19\uc740 \ud2b9\uc815 \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\uba74 \ube44\ubc00 \uce74\ud2b8 \uc2a4\ud0a8\uc744 \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc6b0\uc8fc \uc815\uac70\uc7a5' \uc9c0\ub3c4\uc5d0\uc11c \ud2b9\uc815 \uc21c\uc11c\ub300\ub85c \ubaa8\ub4e0 \uc18c\ud589\uc131\uc744 \ud30c\uad34\ud558\uba74 \ud2b9\ubcc4\ud55c \uc560\ub2c8\uba54\uc774\uc158\uc744 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc774\uc2a4\ud130 \uc5d0\uadf8 \ud0d0\ud5d8: \uc774\ub7ec\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uac8c\uc784\uc5d0 \uc7ac\ubbf8\uc640 \ubc1c\uacac\uc758 \ub610 \ub2e4\ub978 \uce35\uc744 \ucd94\uac00\ud569\ub2c8\ub2e4.]"}]
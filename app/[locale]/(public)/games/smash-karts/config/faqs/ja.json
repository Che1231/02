[{"question": "\u30b9\u30de\u30c3\u30b7\u30e5\u30ab\u30fc\u30c8\u3067\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u57fa\u672c\u64cd\u4f5c\u3092\u8fc5\u901f\u306b\u7fd2\u5f97\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30de\u30c3\u30b7\u30e5\u30ab\u30fc\u30c8\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u8fc5\u901f\u306b\u7fd2\u5f97\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\uff1a\u30b9\u30c6\u30c3\u30d71 - \u79fb\u52d5\u30ad\u30fc\uff08WASD\u307e\u305f\u306f\u77e2\u5370\u30ad\u30fc\uff09\u3068\u30d6\u30fc\u30b9\u30c8\u30dc\u30bf\u30f3\uff08Shift\uff09\u3092\u628a\u63e1\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - \u6575\u3092\u6a19\u7684\u306b\u3057\u653b\u6483\u3059\u308b\u5c04\u6483\u30e1\u30ab\u30cb\u30ba\u30e0\uff08\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\uff09\u306e\u7df4\u7fd2\u3092\u884c\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \"\u30ed\u30b1\u30c3\u30c8\u30e9\u30f3\u30c1\u30e3\u30fc\"\u306a\u3069\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u3092\u4e57\u308a\u8d8a\u3048\u3066\u62fe\u3044\u3001\u4f7f\u7528\u3059\u308b\u65b9\u6cd5\u3092\u5b66\u3073\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\"\u7802\u6f20\u75be\u8d70\"\u30de\u30c3\u30d7\u3067\u306f\u3001\u30d6\u30fc\u30b9\u30c8\u3092\u4f7f\u3063\u3066\u72ed\u3044\u30b3\u30fc\u30ca\u30fc\u3092\u30af\u30ea\u30a2\u3057\u3001\u6226\u7565\u7684\u306b\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u3092\u62fe\u3046\u3088\u3046\u306b\u3057\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u64cd\u4f5c\u3092\u3001\u6226\u95d8\u8981\u7d20\u304c\u52a0\u308f\u3063\u305f\u30b4\u30fc\u30ab\u30fc\u30c8\u306e\u904b\u8ee2\u3068\u6349\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30b9\u30de\u30c3\u30b7\u30e5\u30ab\u30fc\u30c8\u306e\u8a66\u5408\u3067\u521d\u5fc3\u8005\u306e\u65b9\u304c\u9577\u304f\u751f\u304d\u6b8b\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30de\u30c3\u30b7\u30e5\u30ab\u30fc\u30c8\u306e\u8a66\u5408\u3067\u9577\u304f\u751f\u304d\u6b8b\u308b\u305f\u3081\u306b\u306f\u3001\u521d\u5fc3\u8005\u306e\u65b9\u3005\u306f\u3001\u4ee5\u4e0b\u306e\u6226\u7565\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3079\u304d\u3067\u3059\uff1a\u30b9\u30c6\u30c3\u30d71 - \u7c21\u5358\u306b\u72d9\u308f\u308c\u308b\u6a19\u7684\u306b\u306a\u3089\u306a\u3044\u3088\u3046\u306b\u3001\u5e38\u306b\u52d5\u3044\u3066\u304a\u304f\u3002\u30b9\u30c6\u30c3\u30d72 - \u58c1\u3084\u969c\u5bb3\u7269\u306a\u3069\u3001\u74b0\u5883\u3092\u30ab\u30d0\u30fc\u3068\u3057\u3066\u5229\u7528\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73 - \u653b\u6483\u7cfb\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3088\u308a\u3082\u3001\u9632\u5fa1\u7cfb\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\uff08\u4f8b\u3048\u3070\u300c\u30b7\u30fc\u30eb\u30c9\u300d\uff09\u3092\u512a\u5148\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u300c\u90fd\u5e02\u30a2\u30ea\u30fc\u30ca\u300d\u30de\u30c3\u30d7\u3067\u306f\u3001\u72ed\u3044\u901a\u8def\u3092\u4f7f\u3063\u3066\u6575\u306e\u653b\u6483\u3092\u56de\u907f\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u8907\u6570\u9078\u629e\u80a2\u6bd4\u8f03\uff1a\u653b\u6483\u7684\u306a\u30d7\u30ec\u30a4\u306f\u7d20\u65e9\u3044\u30ad\u30eb\u3092\u3082\u305f\u3089\u3057\u307e\u3059\u304c\u30ea\u30b9\u30af\u3082\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002\u4e00\u65b9\u3001\u9632\u5fa1\u7684\u306a\u30d7\u30ec\u30a4\u306f\u9577\u7d9a\u304d\u3059\u308b\u3002]"}, {"question": "\u30b9\u30de\u30c3\u30b7\u30e5\u30ab\u30fc\u30c8\u3067\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u6700\u3082\u52b9\u679c\u7684\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30de\u30c3\u30b7\u30e5\u30ab\u30fc\u30c8\u3067\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u6700\u3082\u52b9\u679c\u7684\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u306f\u3001\u300c\u30b7\u30fc\u30eb\u30c9\u300d\u3068\u300c\u30d8\u30eb\u30b9\u30d1\u30c3\u30af\u300d\u3067\u3059\u3002\u300c\u30b7\u30fc\u30eb\u30c9\u300d\u306f\u4e00\u6642\u7684\u306b\u7121\u6575\u72b6\u614b\u3068\u306a\u308a\u3001\u5371\u967a\u306a\u72b6\u6cc1\u304b\u3089\u8131\u51fa\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u300c\u30d8\u30eb\u30b9\u30d1\u30c3\u30af\u300d\u306f\u4f53\u529b\u56de\u5fa9\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30b8\u30e3\u30f3\u30b0\u30eb\u907a\u8de1\u300d\u30de\u30c3\u30d7\u3067\u306f\u3001\u6edd\u306e\u8fd1\u304f\u306b\u300c\u30d8\u30eb\u30b9\u30d1\u30c3\u30af\u300d\u3092\u62fe\u3046\u3053\u3068\u3067\u3001\u6226\u95d8\u306e\u5c55\u958b\u3092\u5909\u3048\u308b\u3053\u3068\u304c\u53ef\u80fd\u3067\u3059\u3002[\u69cb\u6210\u5bfe\u7167\u8868:\u30b7\u30fc\u30eb\u30c9(\u9632\u5fa1) \u5bfe \u30ed\u30b1\u30c3\u30c8\u30e9\u30f3\u30c1\u30e3\u30fc(\u653b\u6483) - \u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u306f\u30b7\u30fc\u30eb\u30c9\u304c\u5b89\u5168\u3067\u3059\u3002]"}, {"question": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30b9\u30de\u30c3\u30b7\u30e5\u30ab\u30fc\u30c8\u3067\u30ab\u30fc\u30c8\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u3069\u306e\u3088\u3046\u306b\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u9ad8\u5ea6\u306a\u30c6\u30af\u30cb\u30c3\u30af\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3053\u3068\u3067\u3001\u30ab\u30fc\u30c8\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3067\u304d\u307e\u3059\uff1a\u30b9\u30c6\u30c3\u30d71 - \u30c9\u30ea\u30d5\u30c8\u30dc\u30bf\u30f3\uff08Ctrl\uff09\u3092\u62bc\u3057\u306a\u304c\u3089\u3001\u9069\u5207\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3067\u96e2\u3059\u3053\u3068\u3067\u3001\u30c9\u30ea\u30d5\u30c8\u30d6\u30fc\u30b9\u30c8\u306e\u6280\u8853\u3092\u7fd2\u5f97\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72 - \u30d6\u30fc\u30b9\u30c8\u3092\u7e4b\u3052\u3066\u3001\u9ad8\u3044\u901f\u5ea6\u3092\u7dad\u6301\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73 - \u6575\u3092\u51fa\u3057\u629c\u304f\u305f\u3081\u306b\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\uff08\u4f8b\u3048\u3070\u300c\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u300d\uff09\u3092\u4f7f\u7528\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u300c\u30b9\u30ad\u30fc\u30b5\u30fc\u30ad\u30c3\u30c8\u300d\u30de\u30c3\u30d7\u3067\u306f\u3001\u51cd\u7d50\u3057\u305f\u30b3\u30fc\u30ca\u30fc\u3092\u30c9\u30ea\u30d5\u30c8\u30d6\u30fc\u30b9\u30c8\u3059\u308b\u3053\u3068\u3067\u3001\u5927\u304d\u306a\u30a2\u30c9\u30d0\u30f3\u30c6\u30fc\u30b8\u3092\u5f97\u308b\u3053\u3068\u304c\u53ef\u80fd\u3067\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30c9\u30ea\u30d5\u30c8\u2192\u30d6\u30fc\u30b9\u30c8\u2192\u30d6\u30fc\u30b9\u30c8\u9023\u9396\u3067\u6700\u5927\u901f\u5ea6\u3092\u9054\u6210\u3002]"}, {"question": "\u30b9\u30de\u30c3\u30b7\u30e5\u30ab\u30fc\u30c8\u3067\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u3001\u30de\u30c3\u30d7\u8a8d\u8b58\u306f\u306a\u305c\u91cd\u8981\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30de\u30c3\u30b7\u30e5\u30ab\u30fc\u30c8\u3067\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u3001\u30de\u30c3\u30d7\u8a8d\u8b58\u306f\u91cd\u8981\u3067\u3059\u3002\u306a\u305c\u306a\u3089\u3001\u6575\u306e\u52d5\u304d\u3092\u4e88\u6e2c\u3057\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u306e\u51fa\u73fe\u4f4d\u7f6e\u3092\u628a\u63e1\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u304b\u3089\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71 - \u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u3068\u30d8\u30eb\u30b9\u30d1\u30c3\u30af\u306e\u4f4d\u7f6e\u3092\u8a18\u61b6\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72 - \u30df\u30cb\u30de\u30c3\u30d7\u3092\u4f7f\u3063\u3066\u6575\u306e\u4f4d\u7f6e\u3092\u8ffd\u8de1\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73 - \u751f\u5b58\u7387\u3068\u52dd\u5229\u306e\u6a5f\u4f1a\u3092\u6700\u5927\u5316\u3059\u308b\u30eb\u30fc\u30c8\u3092\u8a08\u753b\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u300c\u5e02\u8857\u5730\u300d\u30de\u30c3\u30d7\u3067\u306f\u3001\u5674\u6c34\u8fd1\u304f\u306e\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u3092\u77e5\u3063\u3066\u3044\u308c\u3070\u3001\u6575\u304b\u3089\u9003\u308c\u308b\u304b\u3001\u5947\u8972\u3092\u304b\u3051\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u30de\u30c3\u30d7\u3092\u30c1\u30a7\u30b9\u76e4\u3068\u8003\u3048\u308c\u3070\u3001\u914d\u7f6e\u304c\u52dd\u5229\u306e\u30ab\u30ae\u3067\u3059\u3002]"}, {"question": "\u30b9\u30de\u30c3\u30b7\u30e5\u30ab\u30fc\u30c8\u3067\u3001\u30bd\u30ed\u30d7\u30ec\u30a4\u3068\u30c1\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u6226\u7565\u306e\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30de\u30c3\u30b7\u30e5\u30ab\u30fc\u30c8\u3067\u30bd\u30ed\u30d7\u30ec\u30a4\u3068\u30c1\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u6226\u7565\u306e\u9055\u3044\u306f\u3001\u9023\u643a\u3068\u5f79\u5272\u5206\u62c5\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71 - \u30bd\u30ed\u30d7\u30ec\u30a4\u3067\u306f\u3001\u81ea\u5df1\u9632\u885b\u3068\u597d\u6a5f\u3092\u6349\u3048\u305f\u30ad\u30eb\u306b\u91cd\u70b9\u3092\u7f6e\u304f\u3002\u30b9\u30c6\u30c3\u30d72 - \u30c1\u30fc\u30e0\u30d7\u30ec\u30a4\u3067\u306f\u3001\u653b\u6483\u3068\u9632\u5fa1\u3092\u8abf\u6574\u3059\u308b\u305f\u3081\u306b\u30c1\u30fc\u30e0\u30e1\u30a4\u30c8\u3068\u9023\u643a\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73 - \u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u3068\u30ab\u30fc\u30c8\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u57fa\u3065\u3044\u3066\u3001\u300c\u653b\u6483\u8005\u300d\u3084\u300c\u9632\u5fa1\u8005\u300d\u306a\u3069\u306e\u5f79\u5272\u3092\u5272\u308a\u5f53\u3066\u308b\u3002\u4f8b\u3048\u3070\u3001\u300c\u706b\u5c71\u6e13\u8c37\u300d\u30de\u30c3\u30d7\u3067\u306f\u3001\u9023\u643a\u306e\u3068\u308c\u305f\u30c1\u30fc\u30e0\u306f\u9ad8\u5730\u3092\u5236\u5727\u3057\u3001\u8a66\u5408\u3092\u652f\u914d\u3059\u308b\u3053\u3068\u304c\u53ef\u80fd\u3067\u3059\u3002[\u8907\u6570\u9078\u629e\u80a2\u6bd4\u8f03\uff1a\u30bd\u30ed\u30d7\u30ec\u30a4\u306f\u500b\u3005\u306e\u30b9\u30ad\u30eb\u3001\u30c1\u30fc\u30e0\u30d7\u30ec\u30a4\u306f\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u3092\u5fc5\u8981\u3068\u3057\u307e\u3059\u3002]"}, {"question": "\u30b9\u30de\u30c3\u30b7\u30e5\u30ab\u30fc\u30c8\u306e\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u306a\u305c\u69d8\u3005\u306a\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u3092\u4fc3\u9032\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30b9\u30de\u30c3\u30b7\u30e5\u30ab\u30fc\u30c8\u306e\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30ad\u30eb\u3068\u751f\u5b58\u306e\u4e21\u65b9\u3092\u5831\u916c\u3068\u3057\u3066\u4e0e\u3048\u308b\u3053\u3068\u3067\u3001\u69d8\u3005\u306a\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u3092\u4fc3\u9032\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71 - \u6575\u3092\u6392\u9664\u3059\u308b\u3068\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u3001\u653b\u6483\u7684\u306a\u30d7\u30ec\u30a4\u3092\u4fc3\u9032\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72 - \u8a66\u5408\u7d42\u4e86\u307e\u3067\u751f\u304d\u6b8b\u308b\u3068\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u3001\u9632\u5fa1\u7684\u306a\u6226\u7565\u3092\u4fc3\u9032\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73 - \u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u3092\u52b9\u679c\u7684\u306b\u4f7f\u7528\u3057\u305f\u5834\u5408\u306f\u3001\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u304c\u4e0e\u3048\u3089\u308c\u308b\u3002\u4f8b\u3048\u3070\u3001\u300c\u5b87\u5b99\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u300d\u30de\u30c3\u30d7\u3067\u306f\u3001\u300c\u30ed\u30b1\u30c3\u30c8\u30e9\u30f3\u30c1\u30e3\u30fc\u300d\u3092\u4f7f\u7528\u3057\u3066\u8907\u6570\u30ad\u30eb\u3092\u7372\u5f97\u3057\u305f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u591a\u304f\u306e\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u307e\u3059\u3002[\u69cb\u6210\u5bfe\u7167\u8868:\u30ad\u30eb(\u653b\u6483\u7684) \u5bfe \u751f\u5b58(\u9632\u5fa1\u7684) - \u4e21\u65b9\u3068\u3082\u5f97\u70b9\u306b\u6709\u52b9\u3067\u3059\u3002]"}, {"question": "\u30b9\u30de\u30c3\u30b7\u30e5\u30ab\u30fc\u30c8\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u51fa\u73fe\u30b7\u30b9\u30c6\u30e0\u306e\u57fa\u672c\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30de\u30c3\u30b7\u30e5\u30ab\u30fc\u30c8\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u51fa\u73fe\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30bf\u30a4\u30de\u30fc\u3068\u5834\u6240\u306e\u30e9\u30f3\u30c0\u30e0\u5316\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71 - \u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u306f\u3001\u901a\u5e3830\u79d2\u9593\u9694\u3067\u51fa\u73fe\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - \u30de\u30c3\u30d7\u4e0a\u306e\u4e88\u3081\u6c7a\u3081\u3089\u308c\u305f\u30be\u30fc\u30f3\u5185\u3067\u3001\u4f4d\u7f6e\u304c\u30e9\u30f3\u30c0\u30e0\u5316\u3055\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u300c\u30b4\u30fc\u30eb\u30c7\u30f3\u30ac\u30f3\u300d\u306e\u3088\u3046\u306a\u4e00\u90e8\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u306f\u3001\u51fa\u73fe\u983b\u5ea6\u304c\u4f4e\u3044\u304c\u3001\u5f71\u97ff\u529b\u304c\u5927\u304d\u3044\u3002\u4f8b\u3048\u3070\u3001\u300c\u6d77\u8cca\u6e7e\u300d\u30de\u30c3\u30d7\u3067\u306f\u3001\u3057\u3070\u3057\u3070\u6b8b\u9ab8\u306e\u8fd1\u304f\u306b\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u304c\u51fa\u73fe\u3059\u308b\u305f\u3081\u3001\u6226\u95d8\u306e\u30db\u30c3\u30c8\u30b9\u30dd\u30c3\u30c8\u3068\u306a\u308a\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u3092\u30d0\u30c8\u30eb\u30ed\u30a4\u30e4\u30eb\u30b2\u30fc\u30e0\u306e\u6226\u5229\u54c1\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u30b9\u30de\u30c3\u30b7\u30e5\u30ab\u30fc\u30c8\u306f\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30d7\u30ec\u30a4\u3068\u30c7\u30fc\u30bf\u540c\u671f\u3092\u3069\u306e\u3088\u3046\u306b\u51e6\u7406\u3057\u3066\u3044\u307e\u3059\u304b\uff1f", "answer": "\u30b9\u30de\u30c3\u30b7\u30e5\u30ab\u30fc\u30c8\u306f\u7d71\u5408\u30a2\u30ab\u30a6\u30f3\u30c8\u30b7\u30b9\u30c6\u30e0\u3092\u901a\u3058\u3066\u3001\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30d7\u30ec\u30a4\u3068\u30c7\u30fc\u30bf\u540c\u671f\u3092\u51e6\u7406\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71 - \u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30e1\u30fc\u30eb\u30a2\u30c9\u30ec\u30b9\u307e\u305f\u306f\u30bd\u30fc\u30b7\u30e3\u30eb\u30e1\u30c7\u30a3\u30a2\u30ed\u30b0\u30a4\u30f3\u3092\u4f7f\u7528\u3057\u3066\u3001PC\u3001\u30b3\u30f3\u30bd\u30fc\u30eb\u3001\u30e2\u30d0\u30a4\u30eb\u306a\u3069\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30ea\u30f3\u30af\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - \u30b2\u30fc\u30e0\u306e\u9032\u6357\u72b6\u6cc1\uff08\u30a2\u30f3\u30ed\u30c3\u30af\u3084\u5b9f\u7e3e\u306a\u3069\uff09\u306f\u3001\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u540c\u671f\u3055\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u516c\u5e73\u306a\u30d7\u30ec\u30a4\u3092\u78ba\u4fdd\u3059\u308b\u305f\u3081\u306b\u3001\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u30de\u30c3\u30c1\u306f\u8abf\u6574\u3055\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001PC\u3067\u65b0\u3057\u3044\u30ab\u30fc\u30c8\u30b9\u30ad\u30f3\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u305f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30e2\u30d0\u30a4\u30eb\u30a2\u30ab\u30a6\u30f3\u30c8\u3067\u3082\u5229\u7528\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002[\u69cb\u6210\u5bfe\u7167\u8868:PC\u5bfe\u30e2\u30d0\u30a4\u30eb\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc - \u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3088\u308a\u3001\u3059\u3079\u3066\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u516c\u5e73\u306a\u4f53\u9a13\u304c\u3067\u304d\u307e\u3059\u3002]"}, {"question": "\u30b9\u30de\u30c3\u30b7\u30e5\u30ab\u30fc\u30c8\u306b\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30b9\u30de\u30c3\u30b7\u30e5\u30ab\u30fc\u30c8\u3067\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30de\u30c3\u30d7\u5168\u4f53\u3092\u5fb9\u5e95\u7684\u306b\u63a2\u7d22\u3059\u308b\u3053\u3068\u3067\u3001\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71 - \u300c\u30b8\u30e3\u30f3\u30b0\u30eb\u907a\u8de1\u300d\u30de\u30c3\u30d7\u306e\u300c\u8b0e\u306e\u6d1e\u7a9f\u300d\u306e\u3088\u3046\u306a\u3001\u96a0\u3055\u308c\u305f\u30a8\u30ea\u30a2\u3084\u30a4\u30f3\u30bf\u30e9\u30af\u30c6\u30a3\u30d6\u306a\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u63a2\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72 - \u4e00\u90e8\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u30a2\u30a4\u30c6\u30e0\u306f\u3001\u7279\u5b9a\u306e\u5834\u6240\u3067\u4f7f\u7528\u3059\u308b\u3068\u3001\u72ec\u7279\u306e\u8996\u899a\u52b9\u679c\u3084\u97f3\u97ff\u52b9\u679c\u3092\u6301\u3064\u3002\u30b9\u30c6\u30c3\u30d73 - \u7279\u5b9a\u306e\u30c1\u30e3\u30ec\u30f3\u30b8\uff08\u4f8b\u3048\u3070\u300110\u9023\u52dd\uff09\u3092\u5b8c\u4e86\u3059\u308b\u3068\u3001\u79d8\u5bc6\u306e\u30ab\u30fc\u30c8\u30b9\u30ad\u30f3\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u5b87\u5b99\u30b9\u30c6\u30fc\u30b7\u30e7\u30f3\u300d\u30de\u30c3\u30d7\u3067\u306f\u3001\u7279\u5b9a\u306e\u9806\u756a\u3067\u5c0f\u60d1\u661f\u3092\u3059\u3079\u3066\u6483\u3061\u843d\u3068\u3059\u3068\u3001\u7279\u5225\u306a\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3\u304c\u518d\u751f\u3055\u308c\u307e\u3059\u3002[\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306e\u767a\u898b\uff1a\u3053\u308c\u3089\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3001\u30b2\u30fc\u30e0\u306b\u3055\u3089\u306a\u308b\u697d\u3057\u307f\u3068\u767a\u898b\u306e\u8981\u7d20\u3092\u52a0\u3048\u307e\u3059\u3002]"}]
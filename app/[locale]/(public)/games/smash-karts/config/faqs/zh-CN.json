[{"question": "\u65b0\u73a9\u5bb6\u5982\u4f55\u5feb\u901f\u638c\u63e1\u300aSmash Karts\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1\u300aSmash Karts\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa4\u4e00 - \u719f\u6089\u79fb\u52a8\u952e\uff08WASD\u6216\u65b9\u5411\u952e\uff09\u548c\u52a0\u901f\u952e\uff08Shift\uff09\u3002\u6b65\u9aa4\u4e8c - \u7ec3\u4e60\u4f7f\u7528\u5c04\u51fb\u673a\u5236\uff08\u7a7a\u683c\u952e\uff09\u7784\u51c6\u5e76\u653b\u51fb\u5bf9\u624b\u3002\u6b65\u9aa4\u4e09 - \u5b66\u4e60\u62fe\u53d6\u548c\u4f7f\u7528\u9053\u5177\uff0c\u4f8b\u5982\u2018\u706b\u7bad\u53d1\u5c04\u5668\u2019\uff0c\u65b9\u6cd5\u662f\u9a7e\u8f66\u7ecf\u8fc7\u8fd9\u4e9b\u9053\u5177\u3002\u4f8b\u5982\uff0c\u5728\u2018\u6c99\u6f20\u51b2\u523a\u2019\u5730\u56fe\u4e2d\uff0c\u5229\u7528\u52a0\u901f\u5668\u5de7\u5999\u5730\u901a\u8fc7\u72ed\u7a84\u5f2f\u9053\u5e76\u62fe\u53d6\u9053\u5177\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u8fd9\u4e9b\u64cd\u4f5c\u60f3\u8c61\u6210\u9a7e\u9a76\u4e00\u8f86\u5e26\u6709\u989d\u5916\u6218\u6597\u5143\u7d20\u7684\u5361\u4e01\u8f66\u3002]"}, {"question": "\u65b0\u624b\u5728\u300aSmash Karts\u300b\u6bd4\u8d5b\u4e2d\u5982\u4f55\u4fdd\u6301\u66f4\u957f\u65f6\u95f4\u7684\u751f\u5b58\uff1f", "answer": "\u4e3a\u4e86\u5728\u300aSmash Karts\u300b\u6bd4\u8d5b\u4e2d\u751f\u5b58\u66f4\u957f\u65f6\u95f4\uff0c\u65b0\u624b\u5e94\u4e13\u6ce8\u4e8e\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9aa4\u4e00 - \u4fdd\u6301\u79fb\u52a8\uff0c\u907f\u514d\u6210\u4e3a\u5bb9\u6613\u7684\u76ee\u6807\u3002\u6b65\u9aa4\u4e8c - \u5229\u7528\u73af\u5883\u4f5c\u4e3a\u63a9\u62a4\uff0c\u4f8b\u5982\u5899\u58c1\u548c\u969c\u788d\u7269\u3002\u6b65\u9aa4\u4e09 - \u4f18\u5148\u9009\u62e9\u9632\u5fa1\u6027\u9053\u5177\uff0c\u5982\u2018\u62a4\u76fe\u2019\uff0c\u800c\u4e0d\u662f\u8fdb\u653b\u6027\u9053\u5177\u3002\u4f8b\u5982\uff0c\u5728\u2018\u57ce\u5e02\u7ade\u6280\u573a\u2019\u5730\u56fe\u4e2d\uff0c\u5229\u7528\u72ed\u7a84\u7684\u5df7\u9053\u8eb2\u907f\u654c\u4eba\u7684\u653b\u51fb\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u8fdb\u653b\u6027\u6e38\u620f\u53ef\u80fd\u5feb\u901f\u51fb\u6740\uff0c\u4f46\u98ce\u9669\u8f83\u9ad8\uff0c\u800c\u9632\u5fa1\u6027\u6e38\u620f\u5219\u4fdd\u8bc1\u4e86\u66f4\u957f\u65f6\u95f4\u7684\u751f\u5b58\u3002]"}, {"question": "\u54ea\u4e9b\u9053\u5177\u5bf9\u300aSmash Karts\u300b\u7684\u65b0\u73a9\u5bb6\u6765\u8bf4\u6700\u6709\u6548\uff1f", "answer": "\u5bf9\u4e8e\u300aSmash Karts\u300b\u7684\u65b0\u73a9\u5bb6\u6765\u8bf4\uff0c\u6700\u6709\u6548\u7684\u9053\u5177\u662f\u2018\u62a4\u76fe\u2019\u548c\u2018\u751f\u547d\u836f\u5242\u2019\u3002\u2018\u62a4\u76fe\u2019\u63d0\u4f9b\u77ed\u6682\u7684\u65e0\u654c\u72b6\u6001\uff0c\u8ba9\u4f60\u80fd\u591f\u6446\u8131\u5371\u9669\u5c40\u9762\uff0c\u800c\u2018\u751f\u547d\u836f\u5242\u2019\u5219\u6062\u590d\u4f60\u7684\u751f\u547d\u503c\u3002\u4f8b\u5982\uff0c\u5728\u2018\u4e1b\u6797\u5e9f\u589f\u2019\u5730\u56fe\u4e2d\uff0c\u5728\u7011\u5e03\u9644\u8fd1\u62fe\u53d6\u2018\u751f\u547d\u836f\u5242\u2019\u53ef\u4ee5\u626d\u8f6c\u6218\u5c40\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u62a4\u76fe\uff08\u9632\u5fa1\uff09\u4e0e\u706b\u7bad\u53d1\u5c04\u5668\uff08\u8fdb\u653b\uff09 - \u5bf9\u4e8e\u65b0\u624b\u6765\u8bf4\uff0c\u62a4\u76fe\u66f4\u5b89\u5168\u3002]"}, {"question": "\u8001\u73a9\u5bb6\u5982\u4f55\u4f18\u5316\u300aSmash Karts\u300b\u8d5b\u8f66\u6027\u80fd\uff1f", "answer": "\u8001\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u4e13\u6ce8\u4e8e\u9ad8\u7ea7\u6280\u5de7\u6765\u4f18\u5316\u8d5b\u8f66\u7684\u6027\u80fd\uff1a\u6b65\u9aa4\u4e00 - \u7cbe\u901a\u6f02\u79fb\u52a0\u901f\uff0c\u65b9\u6cd5\u662f\u6309\u4f4f\u6f02\u79fb\u952e\uff08Ctrl\uff09\u5e76\u5728\u5408\u9002\u7684\u65f6\u673a\u677e\u5f00\u3002\u6b65\u9aa4\u4e8c - \u4e32\u8054\u52a0\u901f\uff0c\u4ee5\u4fdd\u6301\u9ad8\u901f\u5ea6\u3002\u6b65\u9aa4\u4e09 - \u4f7f\u7528\u8bf8\u5982\u2018\u52a0\u901f\u2019\u4e4b\u7c7b\u7684\u9053\u5177\u6765\u8d85\u8d8a\u5bf9\u624b\u3002\u4f8b\u5982\uff0c\u5728\u2018\u96ea\u5730\u8d5b\u9053\u2019\u5730\u56fe\u4e2d\uff0c\u5728\u51b0\u96ea\u5f2f\u9053\u9644\u8fd1\u8fdb\u884c\u6f02\u79fb\u52a0\u901f\u53ef\u4ee5\u83b7\u5f97\u663e\u8457\u4f18\u52bf\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u6f02\u79fb -> \u52a0\u901f -> \u4e32\u8054\u52a0\u901f\u4ee5\u8fbe\u5230\u6700\u5927\u901f\u5ea6\u3002]"}, {"question": "\u5730\u56fe\u610f\u8bc6\u5bf9\u300aSmash Karts\u300b\u7684\u9ad8\u7ea7\u73a9\u5bb6\u6765\u8bf4\u4e3a\u4ec0\u4e48\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u5730\u56fe\u610f\u8bc6\u5bf9\u4e8e\u300aSmash Karts\u300b\u7684\u9ad8\u7ea7\u73a9\u5bb6\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u4f7f\u4ed6\u4eec\u80fd\u591f\u9884\u6d4b\u5bf9\u624b\u7684\u884c\u52a8\u5e76\u63a7\u5236\u9053\u5177\u5237\u65b0\u70b9\u3002\u6b65\u9aa4\u4e00 - \u8bb0\u4f4f\u9053\u5177\u548c\u751f\u547d\u836f\u5242\u7684\u4f4d\u7f6e\u3002\u6b65\u9aa4\u4e8c - \u4f7f\u7528\u8ff7\u4f60\u5730\u56fe\u8ddf\u8e2a\u5bf9\u624b\u7684\u4f4d\u7f6e\u3002\u6b65\u9aa4\u4e09 - \u89c4\u5212\u8def\u7ebf\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u751f\u5b58\u548c\u83b7\u80dc\u7684\u673a\u4f1a\u3002\u4f8b\u5982\uff0c\u5728\u2018\u57ce\u5e02\u8857\u9053\u2019\u5730\u56fe\u4e2d\uff0c\u77e5\u9053\u55b7\u6cc9\u9644\u8fd1\u7684\u6377\u5f84\u53ef\u4ee5\u5e2e\u52a9\u4f60\u9003\u8131\u6216\u4f0f\u51fb\u5bf9\u624b\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u5730\u56fe\u60f3\u8c61\u6210\u56fd\u9645\u8c61\u68cb\u68cb\u76d8\uff1b\u4f4d\u7f6e\u662f\u83b7\u80dc\u7684\u5173\u952e\u3002]"}, {"question": "\u300aSmash Karts\u300b\u4e2d\u5355\u4eba\u6a21\u5f0f\u548c\u56e2\u961f\u6a21\u5f0f\u7b56\u7565\u7684\u5173\u952e\u533a\u522b\u662f\u4ec0\u4e48\uff1f", "answer": "\u300aSmash Karts\u300b\u4e2d\u5355\u4eba\u6a21\u5f0f\u548c\u56e2\u961f\u6a21\u5f0f\u7b56\u7565\u7684\u5173\u952e\u533a\u522b\u5728\u4e8e\u534f\u8c03\u6027\u548c\u89d2\u8272\u4e13\u4e1a\u5316\u3002\u6b65\u9aa4\u4e00 - \u5728\u5355\u4eba\u6a21\u5f0f\u4e2d\uff0c\u4e13\u6ce8\u4e8e\u81ea\u6211\u4fdd\u62a4\u548c\u673a\u4f1a\u6027\u51fb\u6740\u3002\u6b65\u9aa4\u4e8c - \u5728\u56e2\u961f\u6a21\u5f0f\u4e2d\uff0c\u4e0e\u961f\u53cb\u6c9f\u901a\u534f\u8c03\u653b\u51fb\u548c\u9632\u5fa1\u3002\u6b65\u9aa4\u4e09 - \u6839\u636e\u9053\u5177\u548c\u8d5b\u8f66\u6027\u80fd\u5206\u914d\u89d2\u8272\uff0c\u4f8b\u5982\u2018\u653b\u51fb\u8005\u2019\u6216\u2018\u9632\u5fa1\u8005\u2019\u3002\u4f8b\u5982\uff0c\u5728\u2018\u706b\u5c71\u5ce1\u8c37\u2019\u5730\u56fe\u4e2d\uff0c\u4e00\u4e2a\u534f\u4f5c\u826f\u597d\u7684\u56e2\u961f\u53ef\u4ee5\u63a7\u5236\u5236\u9ad8\u70b9\u5e76\u4e3b\u5bfc\u6bd4\u8d5b\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u5355\u4eba\u6a21\u5f0f\u662f\u5173\u4e8e\u4e2a\u4eba\u6280\u80fd\uff0c\u800c\u56e2\u961f\u6a21\u5f0f\u5219\u9700\u8981\u56e2\u961f\u5408\u4f5c\u3002]"}, {"question": "\u300aSmash Karts\u300b\u7684\u5f97\u5206\u7cfb\u7edf\u5982\u4f55\u6fc0\u52b1\u4e0d\u540c\u7684\u6e38\u620f\u98ce\u683c\uff1f", "answer": "\u300aSmash Karts\u300b\u7684\u5f97\u5206\u7cfb\u7edf\u901a\u8fc7\u5956\u52b1\u51fb\u6740\u548c\u751f\u5b58\u6765\u6fc0\u52b1\u4e0d\u540c\u7684\u6e38\u620f\u98ce\u683c\u3002\u6b65\u9aa4\u4e00 - \u73a9\u5bb6\u51fb\u6740\u5bf9\u624b\u53ef\u4ee5\u83b7\u5f97\u5206\u6570\uff0c\u9f13\u52b1\u4fb5\u7565\u6027\u6e38\u620f\u3002\u6b65\u9aa4\u4e8c - \u5728\u6bd4\u8d5b\u7ed3\u675f\u65f6\u751f\u5b58\u4e5f\u53ef\u4ee5\u83b7\u5f97\u5206\u6570\uff0c\u4ece\u800c\u4fc3\u8fdb\u9632\u5fa1\u578b\u7b56\u7565\u3002\u6b65\u9aa4\u4e09 - \u6709\u6548\u4f7f\u7528\u9053\u5177\u53ef\u4ee5\u83b7\u5f97\u989d\u5916\u5206\u6570\u3002\u4f8b\u5982\uff0c\u5728\u2018\u592a\u7a7a\u7ad9\u2019\u5730\u56fe\u4e2d\uff0c\u4f7f\u7528\u2018\u706b\u7bad\u53d1\u5c04\u5668\u2019\u591a\u6b21\u51fb\u6740\u7684\u73a9\u5bb6\u5c06\u83b7\u5f97\u66f4\u591a\u5206\u6570\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u51fb\u6740\uff08\u4fb5\u7565\u6027\uff09\u4e0e\u751f\u5b58\uff08\u9632\u5fa1\u6027\uff09 - \u4e24\u8005\u90fd\u662f\u53ef\u884c\u7684\u5f97\u5206\u65b9\u6cd5\u3002]"}, {"question": "\u300aSmash Karts\u300b\u7684\u9053\u5177\u5237\u65b0\u7cfb\u7edf\u80cc\u540e\u662f\u4ec0\u4e48\u673a\u5236\uff1f", "answer": "\u300aSmash Karts\u300b\u7684\u9053\u5177\u5237\u65b0\u7cfb\u7edf\u57fa\u4e8e\u8ba1\u65f6\u5668\u548c\u4f4d\u7f6e\u968f\u673a\u5316\u3002\u6b65\u9aa4\u4e00 - \u9053\u5177\u4f1a\u4ee5\u56fa\u5b9a\u95f4\u9694\u5237\u65b0\uff0c\u901a\u5e38\u6bcf 30 \u79d2\u4e00\u6b21\u3002\u6b65\u9aa4\u4e8c - \u5b83\u4eec\u7684\u5237\u65b0\u4f4d\u7f6e\u5728\u5730\u56fe\u4e0a\u9884\u5b9a\u4e49\u533a\u57df\u5185\u8fdb\u884c\u968f\u673a\u5316\u3002\u6b65\u9aa4\u4e09 - \u4e00\u4e9b\u9053\u5177\uff0c\u4f8b\u5982\u2018\u9ec4\u91d1\u624b\u67aa\u2019\uff0c\u5237\u65b0\u7387\u8f83\u4f4e\uff0c\u4f46\u5f71\u54cd\u8f83\u5927\u3002\u4f8b\u5982\uff0c\u5728\u2018\u6d77\u76d7\u6e7e\u2019\u5730\u56fe\u4e2d\uff0c\u9053\u5177\u7ecf\u5e38\u5728\u6c89\u8239\u9644\u8fd1\u5237\u65b0\uff0c\u4f7f\u5176\u6210\u4e3a\u6218\u6597\u70ed\u70b9\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u9053\u5177\u60f3\u8c61\u6210\u6218\u6597\u7687\u5ba4\u6e38\u620f\u4e2d\u6389\u843d\u7684\u6218\u5229\u54c1\u3002]"}, {"question": "\u300aSmash Karts\u300b\u5982\u4f55\u5904\u7406\u8de8\u5e73\u53f0\u6e38\u620f\u548c\u6570\u636e\u540c\u6b65\uff1f", "answer": "\u300aSmash Karts\u300b\u901a\u8fc7\u7edf\u4e00\u7684\u5e10\u6237\u7cfb\u7edf\u5904\u7406\u8de8\u5e73\u53f0\u6e38\u620f\u548c\u6570\u636e\u540c\u6b65\u3002\u6b65\u9aa4\u4e00 - \u73a9\u5bb6\u53ef\u4ee5\u4f7f\u7528\u7535\u5b50\u90ae\u4ef6\u6216\u793e\u4ea4\u5a92\u4f53\u767b\u5f55\u94fe\u63a5\u4ed6\u4eec\u7684\u8de8\u5e73\u53f0\u5e10\u6237\uff08PC\u3001\u4e3b\u673a\u3001\u79fb\u52a8\u8bbe\u5907\uff09\u3002\u6b65\u9aa4\u4e8c - \u6e38\u620f\u8fdb\u5ea6\uff0c\u5305\u62ec\u89e3\u9501\u548c\u6210\u5c31\uff0c\u5c06\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u540c\u6b65\u3002\u6b65\u9aa4\u4e09 - \u8de8\u5e73\u53f0\u6bd4\u8d5b\u4f1a\u8fdb\u884c\u5e73\u8861\u8c03\u6574\uff0c\u4ee5\u786e\u4fdd\u516c\u5e73\u5bf9\u6218\u3002\u4f8b\u5982\uff0c\u5728PC\u4e0a\u89e3\u9501\u4e86\u65b0\u6b3e\u8d5b\u8f66\u76ae\u80a4\u7684\u73a9\u5bb6\uff0c\u5c06\u5728\u4ed6\u4eec\u7684\u79fb\u52a8\u8bbe\u5907\u5e10\u6237\u4e2d\u770b\u5230\u8be5\u76ae\u80a4\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1aPC\u4e0e\u79fb\u52a8\u8bbe\u5907\u63a7\u5236 - \u8de8\u5e73\u53f0\u6e38\u620f\u786e\u4fdd\u6240\u6709\u73a9\u5bb6\u90fd\u80fd\u83b7\u5f97\u516c\u5e73\u7684\u6e38\u620f\u4f53\u9a8c\u3002]"}, {"question": "\u300aSmash Karts\u300b\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u5f69\u86cb\u73a9\u5bb6\u53ef\u4ee5\u53d1\u73b0\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u5f7b\u5e95\u63a2\u7d22\u5730\u56fe\u6765\u53d1\u73b0\u300aSmash Karts\u300b\u4e2d\u7684\u9690\u85cf\u5f69\u86cb\u3002\u6b65\u9aa4\u4e00 - \u5bfb\u627e\u9690\u85cf\u533a\u57df\u6216\u4e92\u52a8\u7269\u4ef6\uff0c\u4f8b\u5982\u2018\u8ff7\u96fe\u6d1e\u7a74\u2019\uff0c\u4f4d\u4e8e\u2018\u4e1b\u6797\u5e9f\u589f\u2019\u5730\u56fe\u4e2d\u3002\u6b65\u9aa4\u4e8c - \u4e00\u4e9b\u9053\u5177\u5728\u7279\u5b9a\u4f4d\u7f6e\u4f7f\u7528\u65f6\u4f1a\u6709\u72ec\u7279\u7684\u89c6\u89c9\u6216\u58f0\u97f3\u6548\u679c\u3002\u6b65\u9aa4\u4e09 - \u5b8c\u6210\u7279\u5b9a\u6311\u6218\uff0c\u4f8b\u5982\u8fde\u7eed\u8d62\u5f9710\u573a\u6e38\u620f\uff0c\u53ef\u4ee5\u89e3\u9501\u79d8\u5bc6\u8d5b\u8f66\u76ae\u80a4\u3002\u4f8b\u5982\uff0c\u5728\u2018\u592a\u7a7a\u7ad9\u2019\u5730\u56fe\u4e2d\uff0c\u6309\u7167\u7279\u5b9a\u987a\u5e8f\u51fb\u7834\u6240\u6709\u5c0f\u884c\u661f\u4f1a\u89e6\u53d1\u7279\u6b8a\u52a8\u753b\u3002[\u5f69\u86cb\u6316\u6398\uff1a\u8fd9\u4e9b\u5f69\u86cb\u4e3a\u6e38\u620f\u589e\u6dfb\u4e86\u989d\u5916\u7684\u4e50\u8da3\u548c\u53d1\u73b0\u4e50\u8da3\u3002]"}]
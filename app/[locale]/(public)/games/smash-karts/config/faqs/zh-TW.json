[{"question": "\u885d\u64ca\u8cfd\u8eca\u65b0\u73a9\u5bb6\u5982\u4f55\u5feb\u901f\u638c\u63e1\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1\u885d\u64ca\u8cfd\u8eca\u7684\u57fa\u672c\u63a7\u5236\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u719f\u6089\u79fb\u52d5\u9375\uff08 WASD \u6216\u65b9\u5411\u9375\uff09\u548c\u52a0\u901f\u9375\uff08Shift\uff09\u3002\u6b65\u9a5f2 - \u7df4\u7fd2\u4f7f\u7528\u5c04\u64ca\u6a5f\u5236\uff08\u7a7a\u683c\u9375\uff09\u7784\u6e96\u4e26\u653b\u64ca\u5c0d\u624b\u3002\u6b65\u9a5f3 - \u5b78\u7fd2\u62fe\u53d6\u548c\u4f7f\u7528\u4f8b\u5982\u300c\u706b\u7bad\u767c\u5c04\u5668\u300d\u7b49\u9053\u5177\uff0c\u65b9\u6cd5\u662f\u99d5\u99db\u901a\u904e\u5b83\u5011\u3002\u4f8b\u5982\uff0c\u5728\u300c\u6c99\u6f20\u75be\u99b3\u300d\u5730\u5716\u4e2d\uff0c\u5229\u7528\u52a0\u901f\u4f86\u99d5\u99ad\u72f9\u7a84\u7684\u8f49\u5f4e\u4e26\u7b56\u7565\u6027\u5730\u62fe\u53d6\u9053\u5177\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u9019\u4e9b\u63a7\u5236\u60f3\u50cf\u6210\u99d5\u99db\u56db\u8f2a\u6469\u6258\uff0c\u52a0\u5165\u4e86\u6230\u9b25\u5143\u7d20\u3002]"}, {"question": "\u65b0\u624b\u5728\u885d\u64ca\u8cfd\u8eca\u6bd4\u8cfd\u4e2d\u5982\u4f55\u624d\u80fd\u66f4\u9577\u6642\u9593\u751f\u5b58\uff1f", "answer": "\u70ba\u4e86\u5728\u885d\u64ca\u8cfd\u8eca\u6bd4\u8cfd\u4e2d\u751f\u5b58\u66f4\u9577\u6642\u9593\uff0c\u65b0\u624b\u61c9\u8a72\u5c08\u6ce8\u65bc\u9019\u4e9b\u7b56\u7565\uff1a\u6b65\u9a5f1 - \u4fdd\u6301\u79fb\u52d5\u4ee5\u907f\u514d\u6210\u70ba\u5bb9\u6613\u7684\u76ee\u6a19\u3002\u6b65\u9a5f2 - \u5229\u7528\u74b0\u5883\u4f5c\u70ba\u63a9\u8b77\uff0c\u4f8b\u5982\u7246\u58c1\u548c\u969c\u7919\u7269\u3002\u6b65\u9a5f3 - \u4ee5\u300c\u9632\u79a6\u300d\u985e\u9053\u5177\uff08\u4f8b\u5982\u300c\u76fe\u724c\u300d\uff09\u512a\u5148\u65bc\u300c\u653b\u64ca\u300d\u985e\u9053\u5177\u3002\u4f8b\u5982\uff0c\u5728\u300c\u90fd\u5e02\u7af6\u6280\u5834\u300d\u5730\u5716\u4e2d\uff0c\u4f7f\u7528\u72f9\u7a84\u7684\u5df7\u9053\u4f86\u8eb2\u907f\u6575\u4eba\u7684\u653b\u64ca\u3002 [\u591a\u65b9\u6848\u5c0d\u6bd4: \u653b\u64ca\u985e\u73a9\u6cd5\u53ef\u80fd\u6703\u5feb\u901f\u64ca\u6bba\uff0c\u4f46\u98a8\u96aa\u4e5f\u66f4\u5927\uff1b\u800c\u9632\u79a6\u985e\u73a9\u6cd5\u5247\u78ba\u4fdd\u66f4\u9577\u6642\u9593\u7684\u5b58\u6d3b\u3002]"}, {"question": "\u885d\u64ca\u8cfd\u8eca\u4e2d\u54ea\u4e9b\u9053\u5177\u5c0d\u65b0\u73a9\u5bb6\u6700\u6709\u6548\uff1f", "answer": "\u5c0d\u65bc\u885d\u64ca\u8cfd\u8eca\u7684\u65b0\u73a9\u5bb6\u4f86\u8aaa\uff0c\u6700\u6709\u6548\u7684\u9053\u5177\u662f\u300c\u76fe\u724c\u300d\u548c\u300c\u751f\u547d\u85e5\u6c34\u300d\u3002\u300c\u76fe\u724c\u300d\u63d0\u4f9b\u66ab\u6642\u7684\u7121\u6575\u72c0\u614b\uff0c\u8b93\u60a8\u64fa\u812b\u5371\u96aa\u7684\u60c5\u6cc1\uff1b\u800c\u300c\u751f\u547d\u85e5\u6c34\u300d\u5247\u6062\u5fa9\u60a8\u7684\u751f\u547d\u503c\u3002\u4f8b\u5982\uff0c\u5728\u300c\u53e2\u6797\u5ee2\u589f\u300d\u5730\u5716\u4e2d\uff0c\u5728\u7011\u5e03\u9644\u8fd1\u64bf\u8d77\u300c\u751f\u547d\u85e5\u6c34\u300d\u53ef\u4ee5\u626d\u8f49\u6230\u5c40\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u76fe\u724c (\u9632\u79a6) \u5c0d\u6bd4 \u706b\u7bad\u767c\u5c04\u5668 (\u653b\u64ca) - \u76fe\u724c\u5c0d\u65b0\u624b\u4f86\u8aaa\u66f4\u5b89\u5168\u3002]"}, {"question": "\u8001\u7df4\u7684\u73a9\u5bb6\u5982\u4f55\u6700\u4f73\u5316\u885d\u64ca\u8cfd\u8eca\u4e2d\u8cfd\u8eca\u7684\u6027\u80fd\uff1f", "answer": "\u8001\u7df4\u7684\u73a9\u5bb6\u53ef\u4ee5\u900f\u904e\u5c08\u6ce8\u65bc\u5148\u9032\u6280\u5de7\u4f86\u6700\u4f73\u5316\u8cfd\u8eca\u6027\u80fd\uff1a\u6b65\u9a5f1 - \u7cbe\u901a\u6f02\u79fb\u52a0\u901f\u6280\u5de7\uff0c\u65b9\u6cd5\u662f\u6309\u4f4f\u6f02\u79fb\u9375(Ctrl) \u4e26\u5728\u9069\u7576\u6642\u6a5f\u91cb\u653e\u3002\u6b65\u9a5f2 - \u9023\u7e8c\u4f7f\u7528\u52a0\u901f\u4f86\u7dad\u6301\u9ad8\u901f\u3002\u6b65\u9a5f3 - \u4f7f\u7528\u4f8b\u5982\u300c\u901f\u5ea6\u52a0\u6210\u300d\u7b49\u9053\u5177\u4f86\u8d85\u8d8a\u5c0d\u624b\u3002\u4f8b\u5982\uff0c\u5728\u300c\u96ea\u5730\u8cfd\u9053\u300d\u5730\u5716\u4e2d\uff0c\u5728\u51b0\u96ea\u5f4e\u9053\u9032\u884c\u6f02\u79fb\u52a0\u901f\u53ef\u4ee5\u7372\u5f97\u986f\u8457\u7684\u512a\u52e2\u3002[\u6d41\u7a0b\u5716\u89e3: \u6f02\u79fb -> \u52a0\u901f -> \u9023\u7e8c\u52a0\u901f\u4ee5\u9054\u5230\u6700\u5927\u901f\u5ea6\u3002]"}, {"question": "\u5730\u5716\u610f\u8b58\u5c0d\u885d\u64ca\u8cfd\u8eca\u7684\u9ad8\u968e\u73a9\u5bb6\u800c\u8a00\u70ba\u4f55\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u5730\u5716\u610f\u8b58\u5c0d\u885d\u64ca\u8cfd\u8eca\u7684\u9ad8\u968e\u73a9\u5bb6\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u4f7f\u4ed6\u5011\u80fd\u5920\u9810\u6e2c\u6575\u4eba\u7684\u884c\u52d5\u4e26\u63a7\u5236\u9053\u5177\u7684\u51fa\u73fe\u4f4d\u7f6e\u3002\u6b65\u9a5f1 - \u8a18\u4f4f\u9053\u5177\u548c\u751f\u547d\u85e5\u6c34\u7684\u6240\u5728\u4f4d\u7f6e\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u8ff7\u4f60\u5730\u5716\u4f86\u8ffd\u8e64\u6575\u4eba\u7684\u4f4d\u7f6e\u3002\u6b65\u9a5f3 - \u898f\u5283\u8def\u7dda\uff0c\u6700\u5927\u5316\u5b58\u6d3b\u548c\u7372\u52dd\u7684\u6a5f\u6703\u3002\u4f8b\u5982\uff0c\u5728\u300c\u5e02\u5340\u8857\u9053\u300d\u5730\u5716\u4e2d\uff0c\u77e5\u9053\u5674\u6cc9\u9644\u8fd1\u7684\u6377\u5f91\u53ef\u4ee5\u5e6b\u52a9\u60a8\u9003\u812b\u6216\u4f0f\u64ca\u5c0d\u624b\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u5730\u5716\u60f3\u50cf\u6210\u68cb\u76e4\uff1b\u4f4d\u7f6e\u662f\u7372\u52dd\u7684\u95dc\u9375\u3002]"}, {"question": "\u885d\u64ca\u8cfd\u8eca\u55ae\u4eba\u6a21\u5f0f\u548c\u5718\u968a\u6a21\u5f0f\u7b56\u7565\u4e4b\u9593\u7684\u95dc\u9375\u5dee\u7570\u662f\u4ec0\u9ebc\uff1f", "answer": "\u885d\u64ca\u8cfd\u8eca\u55ae\u4eba\u6a21\u5f0f\u548c\u5718\u968a\u6a21\u5f0f\u7b56\u7565\u4e4b\u9593\u7684\u95dc\u9375\u5dee\u7570\u5728\u65bc\u5354\u8abf\u548c\u89d2\u8272\u5c08\u696d\u5316\u3002\u6b65\u9a5f1 - \u5728\u55ae\u4eba\u6a21\u5f0f\u4e2d\uff0c\u5c08\u6ce8\u65bc\u81ea\u6211\u4fdd\u8b77\u548c\u6a5f\u6703\u6027\u64ca\u6bba\u3002\u6b65\u9a5f2 - \u5728\u5718\u968a\u6a21\u5f0f\u4e2d\uff0c\u8207\u968a\u53cb\u6e9d\u901a\u5354\u8abf\u653b\u64ca\u548c\u9632\u5b88\u3002\u6b65\u9a5f3 - \u6839\u64da\u9053\u5177\u548c\u8cfd\u8eca\u6027\u80fd\u5206\u914d\u89d2\u8272\uff0c\u4f8b\u5982\u300c\u653b\u64ca\u8005\u300d\u6216\u300c\u9632\u5b88\u8005\u300d\u3002\u4f8b\u5982\uff0c\u5728\u300c\u706b\u5c71\u8c37\u300d\u5730\u5716\u4e2d\uff0c\u5354\u8abf\u826f\u597d\u7684\u5718\u968a\u53ef\u4ee5\u63a7\u5236\u5236\u9ad8\u9ede\u4e26\u4f54\u9818\u6bd4\u8cfd\u512a\u52e2\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u55ae\u4eba\u6a21\u5f0f\u95dc\u4e4e\u500b\u4eba\u6280\u5de7\uff0c\u800c\u5718\u968a\u6a21\u5f0f\u5247\u9700\u8981\u5718\u968a\u5408\u4f5c\u3002]"}, {"question": "\u885d\u64ca\u8cfd\u8eca\u7684\u8a08\u5206\u7cfb\u7d71\u5982\u4f55\u9f13\u52f5\u4e0d\u540c\u7684\u904a\u6232\u98a8\u683c\uff1f", "answer": "\u885d\u64ca\u8cfd\u8eca\u7684\u8a08\u5206\u7cfb\u7d71\u900f\u904e\u734e\u52f5\u64ca\u6bba\u548c\u5b58\u6d3b\u4f86\u9f13\u52f5\u4e0d\u540c\u7684\u904a\u6232\u98a8\u683c\u3002\u6b65\u9a5f1 - \u73a9\u5bb6\u900f\u904e\u64ca\u6bba\u5c0d\u624b\u7372\u5f97\u7a4d\u5206\uff0c\u9f13\u52f5\u7a4d\u6975\u9032\u653b\u7684\u904a\u6232\u98a8\u683c\u3002\u6b65\u9a5f2 - \u5728\u6bd4\u8cfd\u7d50\u675f\u6642\u5b58\u6d3b\u4e5f\u5c07\u7372\u5f97\u7a4d\u5206\uff0c\u4fc3\u9032\u9632\u79a6\u7b56\u7565\u3002\u6b65\u9a5f3 - \u6709\u6548\u4f7f\u7528\u9053\u5177\u5c07\u7372\u5f97\u984d\u5916\u7a4d\u5206\u3002\u4f8b\u5982\uff0c\u5728\u300c\u592a\u7a7a\u7ad9\u300d\u5730\u5716\u4e2d\uff0c\u4f7f\u7528\u300c\u706b\u7bad\u767c\u5c04\u5668\u300d\u7372\u5f97\u591a\u6b21\u64ca\u6bba\u7684\u73a9\u5bb6\u5c07\u7372\u5f97\u66f4\u591a\u7a4d\u5206\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u64ca\u6bba (\u7a4d\u6975\u9032\u653b) \u5c0d\u6bd4 \u5b58\u6d3b (\u9632\u79a6) - \u5169\u8005\u90fd\u662f\u53ef\u884c\u7684\u5f97\u5206\u65b9\u5f0f\u3002]"}, {"question": "\u885d\u64ca\u8cfd\u8eca\u9053\u5177\u751f\u6210\u7cfb\u7d71\u7684\u5e95\u5c64\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "\u885d\u64ca\u8cfd\u8eca\u7684\u9053\u5177\u751f\u6210\u7cfb\u7d71\u57fa\u65bc\u6642\u9593\u548c\u4f4d\u7f6e\u96a8\u6a5f\u5316\u3002\u6b65\u9a5f1 - \u9053\u5177\u6703\u5b9a\u671f\u751f\u6210\uff0c\u901a\u5e38\u6bcf 30 \u79d2\u4e00\u6b21\u3002\u6b65\u9a5f2 - \u5b83\u5011\u7684\u4f4d\u7f6e\u5728\u9810\u5148\u5b9a\u7fa9\u7684\u5730\u5716\u5340\u57df\u5167\u9032\u884c\u96a8\u6a5f\u5316\u3002\u6b65\u9a5f3 - \u4e00\u4e9b\u9053\u5177\uff0c\u4f8b\u5982\u300c\u9ec3\u91d1\u69cd\u300d\uff0c\u751f\u6210\u7387\u8f03\u4f4e\uff0c\u4f46\u5f71\u97ff\u529b\u8f03\u5927\u3002\u4f8b\u5982\uff0c\u5728\u300c\u6d77\u76dc\u7063\u300d\u5730\u5716\u4e2d\uff0c\u9053\u5177\u7d93\u5e38\u5728\u6c89\u8239\u9644\u8fd1\u751f\u6210\uff0c\u4f7f\u5176\u6210\u70ba\u6230\u9b25\u7684\u71b1\u9ede\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u9053\u5177\u60f3\u50cf\u6210\u6230\u5834\u738b\u724c\u904a\u6232\u4e2d\u7684\u6389\u843d\u7269\u3002]"}, {"question": "\u885d\u64ca\u8cfd\u8eca\u5982\u4f55\u8655\u7406\u8de8\u5e73\u53f0\u904a\u6232\u548c\u6578\u64da\u540c\u6b65\uff1f", "answer": "\u885d\u64ca\u8cfd\u8eca\u900f\u904e\u7d71\u4e00\u7684\u5e33\u6236\u7cfb\u7d71\u4f86\u8655\u7406\u8de8\u5e73\u53f0\u904a\u6232\u548c\u6578\u64da\u540c\u6b65\u3002\u6b65\u9a5f1 - \u73a9\u5bb6\u53ef\u4ee5\u4f7f\u7528\u96fb\u5b50\u90f5\u4ef6\u6216\u793e\u4ea4\u5a92\u9ad4\u767b\u5165\u4f86\u9023\u7d50\u8de8\u5e73\u53f0\u5e33\u6236\uff08PC\u3001\u4e3b\u6a5f\u548c\u884c\u52d5\u88dd\u7f6e\uff09\u3002\u6b65\u9a5f2 - \u904a\u6232\u9032\u5ea6\uff0c\u5305\u62ec\u89e3\u9396\u548c\u6210\u5c31\uff0c\u5c07\u6703\u5728\u5404\u88dd\u7f6e\u4e0a\u540c\u6b65\u3002\u6b65\u9a5f3 - \u8de8\u5e73\u53f0\u6bd4\u8cfd\u5c07\u6703\u9032\u884c\u5e73\u8861\uff0c\u4ee5\u78ba\u4fdd\u516c\u5e73\u7684\u904a\u6232\u9ad4\u9a57\u3002\u4f8b\u5982\uff0c\u5728 PC \u4e0a\u89e3\u9396\u65b0\u8cfd\u8eca\u5916\u89c0\u7684\u73a9\u5bb6\uff0c\u5c07\u6703\u5728\u4ed6\u5011\u7684\u884c\u52d5\u88dd\u7f6e\u5e33\u6236\u4e0a\u770b\u5230\u5b83\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: PC \u5c0d\u6bd4 \u884c\u52d5\u88dd\u7f6e\u63a7\u5236 - \u8de8\u5e73\u53f0\u904a\u6232\u80fd\u78ba\u4fdd\u6240\u6709\u73a9\u5bb6\u90fd\u80fd\u4eab\u53d7\u5230\u516c\u5e73\u7684\u9ad4\u9a57\u3002]"}, {"question": "\u885d\u64ca\u8cfd\u8eca\u4e2d\u73a9\u5bb6\u53ef\u4ee5\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u5f69\u86cb\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u900f\u904e\u5fb9\u5e95\u63a2\u7d22\u5730\u5716\u4f86\u767c\u73fe\u885d\u64ca\u8cfd\u8eca\u4e2d\u7684\u96b1\u85cf\u5f69\u86cb\u3002\u6b65\u9a5f1 - \u5c0b\u627e\u96b1\u85cf\u5340\u57df\u6216\u4e92\u52d5\u7269\u4ef6\uff0c\u4f8b\u5982\u300c\u53e2\u6797\u5ee2\u589f\u300d\u5730\u5716\u4e2d\u7684\u300c\u795e\u79d8\u6d1e\u7a74\u300d\u3002\u6b65\u9a5f2 - \u4e00\u4e9b\u9053\u5177\u5728\u7279\u5b9a\u4f4d\u7f6e\u4f7f\u7528\u6642\u6703\u6709\u7368\u7279\u7684\u8996\u89ba\u6216\u97f3\u6548\u6548\u679c\u3002\u6b65\u9a5f3 - \u5b8c\u6210\u7279\u5b9a\u6311\u6230\uff0c\u4f8b\u5982\u9023\u7e8c\u8d0f\u5f97 10 \u5834\u6bd4\u8cfd\uff0c\u53ef\u4ee5\u89e3\u9396\u79d8\u5bc6\u8cfd\u8eca\u5916\u89c0\u3002\u4f8b\u5982\uff0c\u5728\u300c\u592a\u7a7a\u7ad9\u300d\u5730\u5716\u4e2d\uff0c\u4f9d\u7279\u5b9a\u9806\u5e8f\u5c04\u64ca\u6240\u6709\u5c0f\u884c\u661f\u6703\u89f8\u767c\u7279\u6b8a\u52d5\u756b\u3002[\u5f69\u86cb\u6316\u6398: \u9019\u4e9b\u5f69\u86cb\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u984d\u5916\u6a02\u8da3\u548c\u63a2\u7d22\u5143\u7d20\u3002]"}]
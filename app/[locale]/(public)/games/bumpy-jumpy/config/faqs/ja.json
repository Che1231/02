[{"question": "\u30d0\u30f3\u30d4\u30fc\u30b8\u30e3\u30f3\u30d1\u30fc\u3067\u57fa\u672c\u30b8\u30e3\u30f3\u30d7\u306f\u3069\u3046\u3059\u308c\u3070\u5b9f\u884c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30f3\u30d4\u30fc\u30b8\u30e3\u30f3\u30d1\u30fc\u3067\u57fa\u672c\u30b8\u30e3\u30f3\u30d7\u3092\u884c\u3046\u3053\u3068\u306f\u3001\u30b2\u30fc\u30e0\u3092\u30b9\u30e0\u30fc\u30ba\u306b\u9032\u3081\u308b\u4e0a\u3067\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u30ad\u30fc\u30dc\u30fc\u30c9\u306e\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u3092\u62bc\u3059\u304b\u3001\u30e2\u30d0\u30a4\u30eb\u753b\u9762\u306e\u30b8\u30e3\u30f3\u30d7\u30dc\u30bf\u30f3\u3092\u30bf\u30c3\u30d7\u3059\u308b\u3060\u3051\u3067\u5b9f\u884c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5c0f\u3055\u306a\u969c\u5bb3\u7269\u306b\u8fd1\u3065\u3044\u3066\u3044\u308b\u5834\u5408\u3001\u30b8\u30e3\u30f3\u30d7\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u9069\u5207\u306b\u5408\u308f\u305b\u308b\u3053\u3068\u304c\u30b9\u30e0\u30fc\u30ba\u306b\u30af\u30ea\u30a2\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u30b8\u30e3\u30f3\u30d7\u30dc\u30bf\u30f3\u3092\u9577\u62bc\u3057\u3059\u308c\u3070\u3059\u308b\u307b\u3069\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306f\u9ad8\u304f\u30b8\u30e3\u30f3\u30d7\u3057\u307e\u3059\u3002"}, {"question": "\u30d0\u30f3\u30d4\u30fc\u30b8\u30e3\u30f3\u30d1\u30fc\u3067\u9ad8\u5f97\u70b9\u3092\u53d6\u308b\u305f\u3081\u306e\u6700\u9069\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d0\u30f3\u30d4\u30fc\u30b8\u30e3\u30f3\u30d1\u30fc\u3067\u9ad8\u5f97\u70b9\u3092\u53d6\u308b\u306b\u306f\u3001\u6b63\u78ba\u3055\u3068\u30bf\u30a4\u30df\u30f3\u30b0\u306e\u4e21\u65b9\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b3\u30a4\u30f3\u3084\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u96c6\u3081\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305d\u308c\u3089\u306f\u30b9\u30b3\u30a2\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b8\u30e3\u30f3\u30d7\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u3067\u3001\u969c\u5bb3\u7269\u3092\u907f\u3051\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u201d\u30c0\u30d6\u30eb\u30b8\u30e3\u30f3\u30d7\u201d\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u6d3b\u7528\u3057\u3066\u3001\u3088\u308a\u9ad8\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u5230\u9054\u3057\u3001\u3055\u3089\u306b\u591a\u304f\u306e\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u300c\u30b9\u30ab\u30a4\u30cf\u30a4\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30c0\u30d6\u30eb\u30b8\u30e3\u30f3\u30d7\u3092\u4f7f\u3063\u3066\u96a0\u308c\u305f\u30b3\u30a4\u30f3\u306e\u584a\u306b\u30a2\u30af\u30bb\u30b9\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u306a\u305c\u3001\u30d0\u30f3\u30d4\u30fc\u30b8\u30e3\u30f3\u30d1\u30fc\u3067\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u6642\u3005\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u3059\u308a\u629c\u3051\u3066\u3057\u307e\u3046\u306e\u3067\u3059\u304b\uff1f", "answer": "\u30d0\u30f3\u30d4\u30fc\u30b8\u30e3\u30f3\u30d1\u30fc\u3067\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u3059\u308a\u629c\u3051\u3066\u3057\u307e\u3046\u73fe\u8c61\u306f\u3001\u9045\u5ef6\u3084\u885d\u7a81\u691c\u51fa\u306e\u8aa4\u308a\u306b\u3088\u3063\u3066\u767a\u751f\u3059\u308b\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u3002\u30b2\u30fc\u30e0\u3092\u6700\u65b0\u30d0\u30fc\u30b8\u30e7\u30f3\u306b\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3057\u3001\u30aa\u30f3\u30e9\u30a4\u30f3\u30d7\u30ec\u30a4\u306e\u5834\u5408\u306f\u30a4\u30f3\u30bf\u30fc\u30cd\u30c3\u30c8\u63a5\u7d9a\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u300c\u30af\u30e9\u30a6\u30c9\u30b7\u30c6\u30a3\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306f\u5b89\u5b9a\u3057\u3066\u3044\u308b\u3088\u3046\u306b\u898b\u3048\u307e\u3059\u304c\u3001\u6642\u6298\u30d0\u30b0\u304c\u767a\u751f\u3059\u308b\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u3002\u554f\u984c\u304c\u7d9a\u304f\u5834\u5408\u306f\u3001\u30b2\u30fc\u30e0\u3092\u518d\u8d77\u52d5\u3059\u308b\u3053\u3068\u3067\u89e3\u6c7a\u3055\u308c\u308b\u3053\u3068\u304c\u3088\u304f\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30e2\u30d0\u30a4\u30eb\u7248\u306e\u30d0\u30f3\u30d4\u30fc\u30b8\u30e3\u30f3\u30d1\u30fc\u306e\u9032\u6357\u72b6\u6cc1\u3092PC\u7248\u306b\u79fb\u884c\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u30d0\u30f3\u30d4\u30fc\u30b8\u30e3\u30f3\u30d1\u30fc\u306e\u9032\u6357\u72b6\u6cc1\u3092\u79fb\u884c\u3059\u308b\u306e\u306f\u7c21\u5358\u3067\u3059\u3002\u6700\u521d\u306b\u3001\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u3067\u30af\u30e9\u30a6\u30c9\u30bb\u30fc\u30d6\u3092\u6709\u52b9\u306b\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6b21\u306b\u3001PC\u7248\u30b2\u30fc\u30e0\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30e2\u30d0\u30a4\u30eb\u7248\u306e\u300c\u30b8\u30e3\u30f3\u30b0\u30eb\u30a2\u30c9\u30d9\u30f3\u30c1\u30e3\u30fc\u300d\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3057\u305f\u5834\u5408\u306f\u3001\u9032\u6357\u72b6\u6cc1\u304cPC\u7248\u306b\u81ea\u52d5\u7684\u306b\u540c\u671f\u3055\u308c\u307e\u3059\u3002\u4e21\u65b9\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u304c\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ea\u30f3\u30af\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u304c\u3001\u30b9\u30e0\u30fc\u30ba\u306a\u30c7\u30fc\u30bf\u79fb\u884c\u306e\u305f\u3081\u306b\u91cd\u8981\u3067\u3059\u3002"}, {"question": "\u30d0\u30f3\u30d4\u30fc\u30b8\u30e3\u30f3\u30d1\u30fc\u306b\u304a\u3051\u308b\u201d\u30d0\u30a6\u30f3\u30b9\u30d1\u30c3\u30c9\u201d\u306e\u91cd\u8981\u6027\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d0\u30f3\u30d4\u30fc\u30b8\u30e3\u30f3\u30d1\u30fc\u306b\u304a\u3051\u308b\u201d\u30d0\u30a6\u30f3\u30b9\u30d1\u30c3\u30c9\u201d\u306f\u3001\u3088\u308a\u9ad8\u3044\u30a8\u30ea\u30a2\u306b\u5230\u9054\u3057\u3001\u969c\u5bb3\u7269\u3092\u56de\u907f\u3059\u308b\u4e0a\u3067\u975e\u5e38\u306b\u91cd\u8981\u306a\u8981\u7d20\u3067\u3059\u3002\u30d0\u30a6\u30f3\u30b9\u30d1\u30c3\u30c9\u306b\u7740\u5730\u3059\u308b\u3068\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306f\u5f37\u529b\u306a\u63a8\u9032\u529b\u3067\u4e0a\u6607\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30de\u30a6\u30f3\u30c6\u30f3\u30d4\u30fc\u30af\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u30d0\u30a6\u30f3\u30b9\u30d1\u30c3\u30c9\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u30b3\u30a4\u30f3\u3084\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3067\u6e80\u3061\u305f\u96a0\u308c\u305f\u30a8\u30ea\u30a2\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30d1\u30c3\u30c9\u3067\u306e\u30b8\u30e3\u30f3\u30d7\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d0\u30f3\u30d4\u30fc\u30b8\u30e3\u30f3\u30d1\u30fc\u3067\u6700\u3082\u52b9\u679c\u7684\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u3092\u3069\u306e\u3088\u3046\u306b\u4f7f\u7528\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30f3\u30d4\u30fc\u30b8\u30e3\u30f3\u30d1\u30fc\u306b\u304a\u3044\u3066\u3001\u201d\u30b7\u30fc\u30eb\u30c9\u201d\u3068\u201d\u78c1\u77f3\u201d\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u7279\u306b\u52b9\u679c\u7684\u3067\u3059\u3002\u30b7\u30fc\u30eb\u30c9\u306f1\u56de\u306e\u969c\u5bb3\u7269\u3078\u306e\u885d\u7a81\u304b\u3089\u4fdd\u8b77\u3057\u3001\u78c1\u77f3\u306f\u8fd1\u304f\u306e\u30b2\u30fc\u30e0\u5185\u901a\u8ca8\u3092\u5f15\u304d\u5bc4\u305b\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30af\u30ea\u30b9\u30bf\u30eb\u30b1\u30a4\u30d6\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u78c1\u77f3\u3092\u4f7f\u3063\u3066\u6b63\u78ba\u306b\u4f4d\u7f6e\u5408\u308f\u305b\u3092\u3059\u308b\u3053\u3068\u306a\u304f\u30b2\u30fc\u30e0\u5185\u901a\u8ca8\u3092\u96c6\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3059\u308b\u306b\u306f\u3001\u51fa\u73fe\u3057\u305f\u6642\u3001\u305d\u306e\u4e0a\u306b\u6b69\u3051\u3070\u81ea\u52d5\u7684\u306b\u6d3b\u6027\u5316\u3057\u307e\u3059\u3002"}, {"question": "\u30d0\u30f3\u30d4\u30fc\u30b8\u30e3\u30f3\u30d1\u30fc\u306e\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30f3\u30d4\u30fc\u30b8\u30e3\u30f3\u30d1\u30fc\u306e\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u96c6\u3081\u305f\u30b3\u30a4\u30f3\u6570\u3001\u79fb\u52d5\u8ddd\u96e2\u3001\u4f7f\u7528\u3057\u305f\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306e3\u3064\u306e\u8981\u7d20\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u5404\u30b3\u30a4\u30f3\u306f\u30b9\u30b3\u30a2\u306b\u52a0\u7b97\u3055\u308c\u307e\u3059\u3002\u307e\u305f\u201d\u30c0\u30d6\u30eb\u30b8\u30e3\u30f3\u30d7\u201d\u306e\u3088\u3046\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u3001\u3088\u308a\u9ad8\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u5230\u9054\u3057\u3001\u8ffd\u52a0\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30c7\u30b6\u30fc\u30c8\u30c0\u30c3\u30b7\u30e5\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u3059\u3079\u3066\u306e\u30b2\u30fc\u30e0\u5185\u901a\u8ca8\u3092\u96c6\u3081\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u52b9\u7387\u7684\u306b\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u6700\u7d42\u30b9\u30b3\u30a2\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306f\u3001\u30d2\u30c3\u30c8\u3059\u308b\u3053\u3068\u306a\u304f\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3057\u305f\u5834\u5408\u3001\u30dc\u30fc\u30ca\u30b9\u70b9\u3092\u4ed8\u4e0e\u3057\u307e\u3059\u3002"}, {"question": "\u30d0\u30f3\u30d4\u30fc\u30b8\u30e3\u30f3\u30d1\u30fc\u306e\u96a0\u3055\u308c\u305f\u30ec\u30d9\u30eb\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u3092\u3069\u306e\u3088\u3046\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30f3\u30d4\u30fc\u30b8\u30e3\u30f3\u30d1\u30fc\u306b\u306f\u3001\u7279\u5b9a\u306e\u6761\u4ef6\u3092\u6e80\u305f\u3059\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u308b\u3001\u3044\u304f\u3064\u304b\u306e\u96a0\u3055\u308c\u305f\u30ec\u30d9\u30eb\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u79d8\u5bc6\u306e\u5ead\u5712\u300d\u30ec\u30d9\u30eb\u306f\u3001\u300c\u68ee\u306e\u5c0f\u9053\u300d\u30ec\u30d9\u30eb\u306b\u3042\u308b\u3059\u3079\u3066\u306e\u96a0\u3055\u308c\u305f\u82b1\u3092\u96c6\u3081\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u96a0\u3055\u308c\u305f\u30ec\u30d9\u30eb\u306f\u3001\u3057\u3070\u3057\u3070\u30e6\u30cb\u30fc\u30af\u306a\u6311\u6226\u3068\u5831\u916c\u3092\u542b\u307f\u3001\u719f\u7df4\u3057\u305f\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u65b0\u9bae\u306a\u4f53\u9a13\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u74b0\u5883\u306e\u5fae\u5999\u306a\u624b\u304c\u304b\u308a\u306b\u6ce8\u610f\u3092\u6255\u3044\u3001\u3053\u308c\u3089\u306e\u96a0\u3055\u308c\u305f\u30a8\u30ea\u30a2\u3092\u793a\u3059\u5146\u5019\u3092\u63a2\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30d0\u30f3\u30d4\u30fc\u30b8\u30e3\u30f3\u30d1\u30fc\u3067\u64cd\u4f5c\u3092\u6700\u9069\u5316\u3057\u3001\u3088\u308a\u826f\u3044\u6027\u80fd\u3092\u51fa\u3059\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d0\u30f3\u30d4\u30fc\u30b8\u30e3\u30f3\u30d1\u30fc\u3067\u306e\u64cd\u4f5c\u3092\u6700\u9069\u5316\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5927\u304d\u304f\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002PC\u7248\u3067\u306f\u3001\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u304c\u4f7f\u3044\u306b\u304f\u3044\u5834\u5408\u306f\u3001\u30b8\u30e3\u30f3\u30d7\u30ad\u30fc\u3092\u3088\u308a\u30a2\u30af\u30bb\u30b9\u3057\u3084\u3059\u3044\u30dc\u30bf\u30f3\u306b\u518d\u30de\u30c3\u30d4\u30f3\u30b0\u3059\u308b\u3053\u3068\u3092\u691c\u8a0e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30e2\u30d0\u30a4\u30eb\u7248\u3067\u306f\u3001\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u3067\u30dc\u30bf\u30f3\u30b5\u30a4\u30ba\u3068\u4f4d\u7f6e\u3092\u8abf\u6574\u3057\u3066\u3001\u3088\u308a\u53cd\u5fdc\u6027\u306e\u9ad8\u3044\u64cd\u4f5c\u3092\u5b9f\u73fe\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30a2\u30a4\u30b9\u30d1\u30ec\u30b9\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u6b63\u78ba\u306a\u64cd\u4f5c\u8abf\u6574\u306b\u3088\u308a\u3001\u6ed1\u308a\u3084\u3059\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u3088\u308a\u52b9\u679c\u7684\u306b\u79fb\u52d5\u3067\u304d\u307e\u3059\u3002\u81ea\u5206\u306b\u3068\u3063\u3066\u6700\u9069\u306a\u8a2d\u5b9a\u3092\u898b\u3064\u3051\u308b\u305f\u3081\u306b\u3001\u3055\u307e\u3056\u307e\u306a\u8a2d\u5b9a\u3092\u8a66\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30d0\u30f3\u30d4\u30fc\u30b8\u30e3\u30f3\u30d1\u30fc\u3067\u6700\u3082\u96e3\u3057\u3044\u30ec\u30d9\u30eb\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u3092\u3069\u306e\u3088\u3046\u306b\u30af\u30ea\u30a2\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d0\u30f3\u30d4\u30fc\u30b8\u30e3\u30f3\u30d1\u30fc\u3067\u6700\u3082\u96e3\u3057\u3044\u30ec\u30d9\u30eb\u306f\u3001\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u3068\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306e\u6226\u7565\u7684\u306a\u4f7f\u7528\u3092\u5fc5\u8981\u3068\u3059\u308b\u5834\u5408\u304c\u3088\u304f\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u706b\u5c71\u8131\u51fa\u300d\u30ec\u30d9\u30eb\u306f\u3001\u6025\u901f\u306b\u79fb\u52d5\u3059\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3068\u6eb6\u5ca9\u306e\u6d41\u308c\u3092\u7279\u5fb4\u3068\u3057\u3066\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u201d\u30b7\u30fc\u30eb\u30c9\u201d\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u4f7f\u7528\u3057\u3066\u3001\u4e88\u671f\u305b\u306c\u30d2\u30c3\u30c8\u304b\u3089\u8eab\u3092\u5b88\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6eb6\u5ca9\u306b\u843d\u3061\u306a\u3044\u3088\u3046\u306b\u3001\u30b8\u30e3\u30f3\u30d7\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u614e\u91cd\u306b\u8abf\u6574\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u969c\u5bb3\u7269\u3092\u907f\u3051\u306a\u304c\u3089\u3001\u3067\u304d\u308b\u3060\u3051\u591a\u304f\u306e\u30b2\u30fc\u30e0\u5185\u901a\u8ca8\u3092\u96c6\u3081\u3066\u3001\u30b9\u30b3\u30a2\u3092\u5411\u4e0a\u3055\u305b\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u3089\u306e\u30ec\u30d9\u30eb\u3092\u8907\u6570\u56de\u7df4\u7fd2\u3059\u308b\u3053\u3068\u3067\u3001\u5fc5\u8981\u306a\u30b9\u30ad\u30eb\u3092\u7fd2\u5f97\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}]
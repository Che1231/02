[{"question": "\u5982\u4f55\u5728Bumpy Jumpy\u4e2d\u8fdb\u884c\u57fa\u672c\u8df3\u8dc3\uff1f", "answer": "\u5728Bumpy Jumpy\u4e2d\uff0c\u8fdb\u884c\u57fa\u672c\u8df3\u8dc3\u5bf9\u4e8e\u6e38\u620f\u5bfc\u822a\u81f3\u5173\u91cd\u8981\u3002\u53ea\u9700\u6309\u4e0b\u952e\u76d8\u4e0a\u7684\u7a7a\u683c\u952e\u6216\u5728\u624b\u673a\u5c4f\u5e55\u4e0a\u70b9\u51fb\"\u8df3\u8dc3\"\u6309\u94ae\u5373\u53ef\u3002\u4f8b\u5982\uff0c\u5728\u63a5\u8fd1\u5c0f\u969c\u788d\u7269\u65f6\uff0c\u6b63\u786e\u5730\u8fdb\u884c\u8df3\u8dc3\u53ef\u4ee5\u5e2e\u52a9\u4f60\u5e73\u7a33\u5730\u8d8a\u8fc7\u5b83\u3002\u8bb0\u4f4f\uff0c\u6309\u4f4f\u8df3\u8dc3\u6309\u94ae\u7684\u65f6\u95f4\u8d8a\u957f\uff0c\u4f60\u7684\u89d2\u8272\u8df3\u8dc3\u7684\u9ad8\u5ea6\u8d8a\u9ad8\u3002"}, {"question": "\u5728Bumpy Jumpy\u4e2d\u83b7\u5f97\u9ad8\u5206\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728Bumpy Jumpy\u4e2d\u83b7\u5f97\u9ad8\u5206\u9700\u8981\u7cbe\u786e\u548c\u65f6\u95f4\u4e0a\u7684\u914d\u5408\u3002\u6b65\u9aa4\u4e00\uff1a\u4e13\u6ce8\u4e8e\u6536\u96c6\u786c\u5e01\u548c\u9053\u5177\uff0c\u5b83\u4eec\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u5206\u6570\u3002\u6b65\u9aa4\u4e8c\uff1a\u901a\u8fc7\u638c\u63e1\u8df3\u8dc3\u65f6\u673a\u6765\u907f\u5f00\u969c\u788d\u7269\u3002\u6b65\u9aa4\u4e09\uff1a\u5229\u7528\"\u53cc\u8df3\"\u9053\u5177\u5230\u8fbe\u66f4\u9ad8\u7684\u5e73\u53f0\u5e76\u6536\u96c6\u66f4\u591a\u786c\u5e01\u3002\u4f8b\u5982\uff0c\u5728\"\u9ad8\u7a7a\"\u5173\u5361\u4e2d\uff0c\u4f7f\u7528\u53cc\u8df3\u53ef\u4ee5\u5e2e\u52a9\u4f60\u83b7\u53d6\u9690\u85cf\u7684\u786c\u5e01\u7c07\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u7684\u89d2\u8272\u6709\u65f6\u4f1a\u5728Bumpy Jumpy\u4e2d\u7a7f\u8fc7\u5e73\u53f0\uff1f", "answer": "\u5728Bumpy Jumpy\u4e2d\u7a7f\u8fc7\u5e73\u53f0\u53ef\u80fd\u662f\u7531\u4e8e\u5ef6\u8fdf\u6216\u78b0\u649e\u68c0\u6d4b\u9519\u8bef\u3002\u786e\u4fdd\u4f60\u7684\u6e38\u620f\u5df2\u66f4\u65b0\u5230\u6700\u65b0\u7248\u672c\uff0c\u5e76\u5728\u5728\u7ebf\u6e38\u620f\u4e2d\u68c0\u67e5\u4f60\u7684\u4e92\u8054\u7f51\u8fde\u63a5\u3002\u4f8b\u5982\uff0c\u5728\"\u4e91\u57ce\"\u5173\u5361\u4e2d\uff0c\u5e73\u53f0\u53ef\u80fd\u770b\u8d77\u6765\u7a33\u5b9a\uff0c\u4f46\u6709\u65f6\u53ef\u80fd\u4f1a\u51fa\u73b0\u6545\u969c\u3002\u5982\u679c\u95ee\u9898\u6301\u7eed\u5b58\u5728\uff0c\u91cd\u65b0\u542f\u52a8\u6e38\u620f\u901a\u5e38\u53ef\u4ee5\u89e3\u51b3\u5b83\u3002"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684Bumpy Jumpy\u79fb\u52a8\u7aef\u8fdb\u5ea6\u8f6c\u79fb\u5230PC\u7aef\uff1f", "answer": "\u5728Bumpy Jumpy\u4e2d\uff0c\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u8fdb\u5ea6\u975e\u5e38\u7b80\u5355\u3002\u9996\u5148\uff0c\u786e\u4fdd\u4f60\u7684\u79fb\u52a8\u8bbe\u5907\u542f\u7528\u4e86\u4e91\u4fdd\u5b58\u3002\u7136\u540e\uff0c\u767b\u5f55\u4f60\u6e38\u620fPC\u7248\u672c\u7684\u540c\u4e00\u5e10\u6237\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5df2\u5728\u79fb\u52a8\u7aef\u5b8c\u6210\"\u4e1b\u6797\u63a2\u9669\"\u5173\u5361\uff0c\u4f60\u7684\u8fdb\u5ea6\u5c06\u81ea\u52a8\u540c\u6b65\u5230PC\u7aef\u3002\u6ce8\u610f\uff0c\u8fd9\u4e24\u4e2a\u7248\u672c\u5fc5\u987b\u94fe\u63a5\u5230\u540c\u4e00\u4e2a\u5e10\u6237\u624d\u80fd\u5b9e\u73b0\u65e0\u7f1d\u6570\u636e\u4f20\u8f93\u3002"}, {"question": "Bumpy Jumpy\u4e2d\u7684\"\u5f39\u8df3\u57ab\"\u6709\u4ec0\u4e48\u610f\u4e49\uff1f", "answer": "Bumpy Jumpy\u4e2d\u7684\"\u5f39\u8df3\u57ab\"\u662f\u5230\u8fbe\u66f4\u9ad8\u533a\u57df\u5e76\u907f\u5f00\u969c\u788d\u7269\u7684\u5173\u952e\u8981\u7d20\u3002\u5f53\u4f60\u5728\u5f39\u8df3\u57ab\u4e0a\u7740\u9646\u65f6\uff0c\u4f60\u7684\u89d2\u8272\u5c06\u4ee5\u5de8\u5927\u7684\u529b\u91cf\u5411\u4e0a\u5f39\u8d77\u3002\u4f8b\u5982\uff0c\u5728\"\u5c71\u5cf0\"\u5173\u5361\u4e2d\uff0c\u4f7f\u7528\u5f39\u8df3\u57ab\u53ef\u4ee5\u5e2e\u52a9\u4f60\u5230\u8fbe\u9690\u85cf\u533a\u57df\uff0c\u90a3\u91cc\u5145\u6ee1\u4e86\u786c\u5e01\u548c\u9053\u5177\u3002\u638c\u63e1\u8fd9\u4e9b\u57ab\u5b50\u4e0a\u7684\u8df3\u8dc3\u65f6\u673a\u53ef\u4ee5\u6781\u5927\u5730\u63d0\u5347\u4f60\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "Bumpy Jumpy\u4e2d\u6700\u6709\u6548\u7684\u9053\u5177\u6709\u54ea\u4e9b\u4ee5\u53ca\u5982\u4f55\u4f7f\u7528\u5b83\u4eec\uff1f", "answer": "\u5728Bumpy Jumpy\u4e2d\uff0c\"\u62a4\u76fe\"\u548c\"\u78c1\u94c1\"\u9053\u5177\u7279\u522b\u6709\u6548\u3002\u62a4\u76fe\u53ef\u4ee5\u4fdd\u62a4\u4f60\u514d\u53d7\u4e00\u6b21\u969c\u788d\u7269\u7684\u649e\u51fb\uff0c\u800c\u78c1\u94c1\u53ef\u4ee5\u5438\u5f15\u9644\u8fd1\u7684\u786c\u5e01\u3002\u4f8b\u5982\uff0c\u5728\"\u6c34\u6676\u6d1e\u7a74\"\u5173\u5361\u4e2d\uff0c\u4f7f\u7528\u78c1\u94c1\u53ef\u4ee5\u5e2e\u52a9\u4f60\u6536\u96c6\u786c\u5e01\uff0c\u800c\u65e0\u9700\u5b8c\u7f8e\u5bf9\u9f50\u3002\u8981\u4f7f\u7528\u8fd9\u4e9b\u9053\u5177\uff0c\u53ea\u9700\u5728\u5b83\u4eec\u51fa\u73b0\u65f6\u8d70\u8fc7\u53bb\uff0c\u5b83\u4eec\u5c31\u4f1a\u81ea\u52a8\u6fc0\u6d3b\u3002"}, {"question": "Bumpy Jumpy\u4e2d\u7684\u5f97\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "Bumpy Jumpy\u4e2d\u7684\u5f97\u5206\u7cfb\u7edf\u57fa\u4e8e\u51e0\u4e2a\u56e0\u7d20\uff1a\u6536\u96c6\u7684\u786c\u5e01\u3001\u884c\u8fdb\u7684\u8ddd\u79bb\u4ee5\u53ca\u4f7f\u7528\u7684\u9053\u5177\u3002\u6bcf\u4e2a\u786c\u5e01\u90fd\u4f1a\u589e\u52a0\u4f60\u7684\u5206\u6570\uff0c\u800c\u50cf\"\u53cc\u8df3\"\u8fd9\u6837\u7684\u9053\u5177\u53ef\u4ee5\u5e2e\u52a9\u4f60\u5230\u8fbe\u66f4\u9ad8\u7684\u5e73\u53f0\u4ee5\u83b7\u5f97\u989d\u5916\u5206\u6570\u3002\u4f8b\u5982\uff0c\u5728\"\u6c99\u6f20\u51b2\u523a\"\u5173\u5361\u4e2d\uff0c\u6536\u96c6\u6240\u6709\u786c\u5e01\u5e76\u6709\u6548\u5730\u4f7f\u7528\u9053\u5177\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u6700\u7ec8\u5f97\u5206\u3002\u6e38\u620f\u8fd8\u4f1a\u5956\u52b1\u4f60\u5728\u6ca1\u6709\u53d7\u5230\u4efb\u4f55\u649e\u51fb\u7684\u60c5\u51b5\u4e0b\u5b8c\u6210\u5173\u5361\u7684\u5206\u6570\u3002"}, {"question": "Bumpy Jumpy\u4e2d\u7684\u9690\u85cf\u5173\u5361\u6709\u54ea\u4e9b\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9501\u5b83\u4eec\uff1f", "answer": "Bumpy Jumpy\u5305\u542b\u51e0\u4e2a\u9690\u85cf\u5173\u5361\uff0c\u53ef\u4ee5\u901a\u8fc7\u6ee1\u8db3\u7279\u5b9a\u6761\u4ef6\u6765\u89e3\u9501\u3002\u4f8b\u5982\uff0c\"\u79d8\u5bc6\u82b1\u56ed\"\u5173\u5361\u53ef\u4ee5\u901a\u8fc7\u5728\"\u68ee\u6797\u5c0f\u5f84\"\u5173\u5361\u4e2d\u6536\u96c6\u6240\u6709\u9690\u85cf\u7684\u82b1\u6735\u6765\u89e3\u9501\u3002\u8fd9\u4e9b\u9690\u85cf\u5173\u5361\u901a\u5e38\u5305\u542b\u72ec\u7279\u7684\u6311\u6218\u548c\u5956\u52b1\uff0c\u4e3a\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u63d0\u4f9b\u65b0\u7684\u4f53\u9a8c\u3002\u7559\u610f\u73af\u5883\u4e2d\u7684\u5fae\u5999\u7ebf\u7d22\uff0c\u5b83\u4eec\u6697\u793a\u7740\u8fd9\u4e9b\u9690\u85cf\u533a\u57df\u3002"}, {"question": "\u5982\u4f55\u4f18\u5316\u6211\u7684Bumpy Jumpy\u63a7\u5236\u8bbe\u7f6e\u4ee5\u83b7\u5f97\u66f4\u597d\u7684\u6e38\u620f\u8868\u73b0\uff1f", "answer": "\u4f18\u5316Bumpy Jumpy\u4e2d\u7684\u63a7\u5236\u8bbe\u7f6e\u53ef\u4ee5\u6781\u5927\u5730\u63d0\u5347\u4f60\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u5728PC\u7aef\uff0c\u5982\u679c\u7a7a\u683c\u952e\u611f\u89c9\u4e0d\u65b9\u4fbf\uff0c\u53ef\u4ee5\u8003\u8651\u5c06\u8df3\u8dc3\u952e\u91cd\u65b0\u6620\u5c04\u5230\u66f4\u6613\u4e8e\u8bbf\u95ee\u7684\u6309\u952e\u3002\u5728\u79fb\u52a8\u7aef\uff0c\u5728\u8bbe\u7f6e\u83dc\u5355\u4e2d\u8c03\u6574\u6309\u94ae\u7684\u5927\u5c0f\u548c\u4f4d\u7f6e\u4ee5\u83b7\u5f97\u66f4\u597d\u7684\u54cd\u5e94\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\"\u51b0\u5bab\"\u5173\u5361\u4e2d\uff0c\u7cbe\u786e\u7684\u63a7\u5236\u8c03\u6574\u53ef\u4ee5\u5e2e\u52a9\u4f60\u66f4\u6709\u6548\u5730\u9a7e\u9a6d\u5149\u6ed1\u7684\u5e73\u53f0\u3002\u5c1d\u8bd5\u4e0d\u540c\u7684\u914d\u7f6e\uff0c\u627e\u5230\u6700\u9002\u5408\u4f60\u7684\u914d\u7f6e\u3002"}, {"question": "Bumpy Jumpy\u4e2d\u6700\u5177\u6311\u6218\u6027\u7684\u5173\u5361\u6709\u54ea\u4e9b\uff0c\u4ee5\u53ca\u5982\u4f55\u901a\u5173\uff1f", "answer": "Bumpy Jumpy\u4e2d\u6700\u5177\u6311\u6218\u6027\u7684\u5173\u5361\u901a\u5e38\u9700\u8981\u7cbe\u786e\u7684\u65f6\u95f4\u63a7\u5236\u548c\u6218\u7565\u6027\u5730\u4f7f\u7528\u9053\u5177\u3002\u4f8b\u5982\uff0c\"\u706b\u5c71\u9003\u751f\"\u5173\u5361\u5177\u6709\u5feb\u901f\u79fb\u52a8\u7684\u5e73\u53f0\u548c\u7194\u5ca9\u6d41\u3002\u6b65\u9aa4\u4e00\uff1a\u4f7f\u7528\"\u62a4\u76fe\"\u9053\u5177\u4ee5\u9632\u610f\u5916\u78b0\u649e\u3002\u6b65\u9aa4\u4e8c\uff1a\u4ed4\u7ec6\u8c03\u6574\u8df3\u8dc3\u65f6\u673a\u4ee5\u907f\u514d\u6389\u5165\u7194\u5ca9\u3002\u6b65\u9aa4\u4e09\uff1a\u5c3d\u91cf\u6536\u96c6\u5c3d\u53ef\u80fd\u591a\u7684\u786c\u5e01\u6765\u63d0\u9ad8\u5206\u6570\uff0c\u540c\u65f6\u5728\u89c4\u907f\u5371\u9669\u3002\u591a\u6b21\u7ec3\u4e60\u8fd9\u4e9b\u5173\u5361\u5c06\u5e2e\u52a9\u4f60\u638c\u63e1\u5fc5\u8981\u7684\u6280\u5de7\u3002"}]
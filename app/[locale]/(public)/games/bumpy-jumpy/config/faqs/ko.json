[{"question": "Bumpy Jumpy\uc5d0\uc11c \uae30\ubcf8 \uc810\ud504\ub294 \uc5b4\ub5bb\uac8c \uc218\ud589\ud569\ub2c8\uae4c?", "answer": "Bumpy Jumpy\uc5d0\uc11c \uae30\ubcf8 \uc810\ud504\ub294 \uac8c\uc784\uc744 \ud0d0\uc0c9\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \ud0a4\ubcf4\ub4dc\uc758 '\uc2a4\ud398\uc774\uc2a4\ubc14'\ub97c \ub204\ub974\uac70\ub098 \ubaa8\ubc14\uc77c \ud654\uba74\uc758 '\uc810\ud504' \ubc84\ud2bc\uc744 \ud0ed\ud558\uae30\ub9cc \ud558\uba74 \ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 \uc791\uc740 \uc7a5\uc560\ubb3c\uc5d0 \uc811\uadfc\ud560 \ub54c \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uc815\ud655\ud788 \ub9de\ucd94\uba74 \ubd80\ub4dc\ub7fd\uac8c \uc7a5\uc560\ubb3c\uc744 \ub118\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc810\ud504 \ubc84\ud2bc\uc744 \uae38\uac8c \ub204\ub97c\uc218\ub85d \uce90\ub9ad\ud130\uac00 \ub354 \ub192\uc774 \uc810\ud504\ud55c\ub2e4\ub294 \uc810\uc744 \uae30\uc5b5\ud558\uc2ed\uc2dc\uc624."}, {"question": "Bumpy Jumpy\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Bumpy Jumpy\uc5d0\uc11c \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc73c\ub824\uba74 \uc815\ud655\uc131\uacfc \ud0c0\uc774\ubc0d\uc774 \uacb0\ud569\ub418\uc5b4\uc57c \ud569\ub2c8\ub2e4. STEP1: \ub3d9\uc804\uacfc \ud30c\uc6cc\uc5c5\uc744 \ubaa8\uc73c\ub294 \ub370 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \uc774\ub4e4\uc740 \uc810\uc218\ub97c \ud06c\uac8c \ub192\uc5ec\uc90d\ub2c8\ub2e4. STEP2: \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uc775\ud788\uba74\uc11c \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\uc2ed\uc2dc\uc624. STEP3: '\ub354\ube14 \uc810\ud504' \ud30c\uc6cc\uc5c5\uc744 \ud65c\uc6a9\ud558\uc5ec \ub354 \ub192\uc740 \ud50c\ub7ab\ud3fc\uc5d0 \ub3c4\ub2ec\ud558\uace0 \ub354 \ub9ce\uc740 \ub3d9\uc804\uc744 \ubaa8\uc73c\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4 '\ud558\ub298 \ub192\uc774' \ub808\ubca8\uc5d0\uc11c \ub354\ube14 \uc810\ud504\ub97c \uc0ac\uc6a9\ud558\uba74 \uc228\uaca8\uc9c4 \ub3d9\uc804 \ub369\uc5b4\ub9ac\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc65c Bumpy Jumpy\uc5d0\uc11c \uce90\ub9ad\ud130\uac00 \ub54c\ub54c\ub85c \ud50c\ub7ab\ud3fc\uc744 \ud1b5\ud574 \ub5a8\uc5b4\uc9d1\ub2c8\uae4c?", "answer": "Bumpy Jumpy\uc5d0\uc11c \ud50c\ub7ab\ud3fc\uc744 \ud1b5\ud574 \ub5a8\uc5b4\uc9c0\ub294 \ud604\uc0c1\uc740 \uc9c0\uc5f0 \ub610\ub294 \uc798\ubabb\ub41c \ucda9\ub3cc \uac10\uc9c0\ub85c \uc778\ud574 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc628\ub77c\uc778\uc73c\ub85c \ud50c\ub808\uc774\ud558\ub294 \uacbd\uc6b0 \uac8c\uc784\uc774 \ucd5c\uc2e0 \ubc84\uc804\uc73c\ub85c \uc5c5\ub370\uc774\ud2b8\ub418\uc5c8\ub294\uc9c0 \ud655\uc778\ud558\uace0 \uc778\ud130\ub137 \uc5f0\uacb0\uc744 \uc810\uac80\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4 '\uad6c\ub984 \ub3c4\uc2dc' \ub808\ubca8\uc5d0\uc11c \ud50c\ub7ab\ud3fc\uc740 \uc548\uc815\uc801\uc73c\ub85c \ubcf4\uc77c \uc218 \uc788\uc9c0\ub9cc \ub54c\ub54c\ub85c \uc624\ub958\uac00 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubb38\uc81c\uac00 \uc9c0\uc18d\ub418\uba74 \uac8c\uc784\uc744 \ub2e4\uc2dc \uc2dc\uc791\ud558\uba74 \uc885\uc885 \ud574\uacb0\ub429\ub2c8\ub2e4."}, {"question": "Bumpy Jumpy\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ubaa8\ubc14\uc77c\uc5d0\uc11c PC\ub85c \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Bumpy Jumpy\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \uc804\uc1a1\ud558\ub294 \ubc29\ubc95\uc740 \uac04\ub2e8\ud569\ub2c8\ub2e4. \uba3c\uc800 \ubaa8\ubc14\uc77c \uc7a5\uce58\uc5d0\uc11c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ud65c\uc131\ud654\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uadf8\ub7f0 \ub2e4\uc74c PC \ubc84\uc804\uc758 \uac8c\uc784\uc5d0\uc11c \uac19\uc740 \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4 \ubaa8\ubc14\uc77c\uc5d0\uc11c '\uc815\uae00 \ubaa8\ud5d8' \ub808\ubca8\uc744 \uc644\ub8cc\ud588\ub2e4\uba74 \uc9c4\ud589 \uc0c1\ud669\uc774 PC\ub85c \uc790\ub3d9 \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. \ub450 \ubc84\uc804 \ubaa8\ub450 \uac19\uc740 \uacc4\uc815\uc5d0 \uc5f0\uacb0\ub418\uc5b4 \uc788\uc5b4\uc57c \uc6d0\ud65c\ud55c \ub370\uc774\ud130 \uc804\uc1a1\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4."}, {"question": "Bumpy Jumpy\uc5d0\uc11c '\ubc14\uc6b4\uc2a4 \ud328\ub4dc'\uc758 \uc911\uc694\uc131\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Bumpy Jumpy\uc5d0\uc11c '\ubc14\uc6b4\uc2a4 \ud328\ub4dc'\ub294 \ub354 \ub192\uc740 \uc9c0\uc5ed\uc5d0 \ub3c4\ub2ec\ud558\uace0 \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\ub294 \ub370 \uc911\uc694\ud55c \uc694\uc18c\uc785\ub2c8\ub2e4. \ubc14\uc6b4\uc2a4 \ud328\ub4dc\uc5d0 \ucc29\ub959\ud558\uba74 \uce90\ub9ad\ud130\uac00 \uc0c1\ub2f9\ud55c \ud798\uc73c\ub85c \uc704\ub85c \ud295\uaca8 \uc624\ub985\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 '\uc0b0 \uc815\uc0c1' \ub808\ubca8\uc5d0\uc11c \ubc14\uc6b4\uc2a4 \ud328\ub4dc\ub97c \uc0ac\uc6a9\ud558\uba74 \ub3d9\uc804\uacfc \ud30c\uc6cc\uc5c5\uc774 \uac00\ub4dd\ud55c \uc228\uaca8\uc9c4 \uc9c0\uc5ed\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud328\ub4dc\uc5d0\uc11c \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uc219\ub2ec\ud558\uba74 \uac8c\uc784 \uacbd\ud5d8\uc774 \ud06c\uac8c \ud5a5\uc0c1\ub429\ub2c8\ub2e4."}, {"question": "Bumpy Jumpy\uc5d0\uc11c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ud30c\uc6cc\uc5c5\uc740 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \uc0ac\uc6a9\ud569\ub2c8\uae4c?", "answer": "Bumpy Jumpy\uc5d0\uc11c '\ubc29\ud328'\uc640 '\uc790\uc11d' \ud30c\uc6cc\uc5c5\uc740 \ud2b9\ud788 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4. \ubc29\ud328\ub294 \ud55c \ubc88\uc758 \uc7a5\uc560\ubb3c \ucda9\ub3cc\ub85c\ubd80\ud130 \ubcf4\ud638\ud558\uace0, \uc790\uc11d\uc740 \uc8fc\ubcc0 \ub3d9\uc804\uc744 \ub04c\uc5b4\ub4e4\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 '\ud06c\ub9ac\uc2a4\ud0c8 \ub3d9\uad74' \ub808\ubca8\uc5d0\uc11c \uc790\uc11d\uc744 \uc0ac\uc6a9\ud558\uba74 \uc644\ubcbd\ud558\uac8c \uc815\ub82c\ud558\uc9c0 \uc54a\uace0\ub3c4 \ub3d9\uc804\uc744 \ubaa8\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud558\ub824\uba74 \ub098\ud0c0\ub0a0 \ub54c \uac78\uc5b4\uc11c \ub118\uae30\uba74 \uc790\ub3d9\uc73c\ub85c \ud65c\uc131\ud654\ub429\ub2c8\ub2e4."}, {"question": "Bumpy Jumpy\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "Bumpy Jumpy\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5ec\ub7ec \uc694\uc18c\ub97c \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. \ubaa8\uc740 \ub3d9\uc804 \uc218, \uc774\ub3d9 \uac70\ub9ac \ubc0f \uc0ac\uc6a9\ud55c \ud30c\uc6cc\uc5c5\uc785\ub2c8\ub2e4. \uac01 \ub3d9\uc804\uc740 \uc810\uc218\uc5d0 \ucd94\uac00\ub418\uace0, '\ub354\ube14 \uc810\ud504'\uc640 \uac19\uc740 \ud30c\uc6cc\uc5c5\uc740 \ub354 \ub192\uc740 \ud50c\ub7ab\ud3fc\uc5d0 \ub3c4\ub2ec\ud558\uc5ec \ucd94\uac00 \uc810\uc218\ub97c \uc5bb\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 '\uc0ac\ub9c9 \uc9c8\uc8fc' \ub808\ubca8\uc5d0\uc11c \ubaa8\ub4e0 \ub3d9\uc804\uc744 \ubaa8\uc73c\uace0 \ud30c\uc6cc\uc5c5\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uba74 \ucd5c\uc885 \uc810\uc218\uac00 \ud06c\uac8c \ub192\uc544\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784\uc740 \ub610\ud55c \ub808\ubca8\uc744 \uc544\ubb34\ub7f0 \ucda9\ub3cc \uc5c6\uc774 \uc644\ub8cc\ud558\uba74 \ubcf4\ub108\uc2a4 \uc810\uc218\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4."}, {"question": "Bumpy Jumpy\uc758 \uc228\uaca8\uc9c4 \ub808\ubca8\uc740 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Bumpy Jumpy\uc5d0\ub294 \ud2b9\uc815 \uae30\uc900\uc744 \ucda9\uc871\ud558\uba74 \ud574\uc81c\ud560 \uc218 \uc788\ub294 \uc5ec\ub7ec \uc228\uaca8\uc9c4 \ub808\ubca8\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 '\ube44\ubc00 \uc815\uc6d0' \ub808\ubca8\uc740 '\uc232\uae38' \ub808\ubca8\uc5d0\uc11c \ubaa8\ub4e0 \uc228\uaca8\uc9c4 \uaf43\uc744 \ubaa8\uc544\uc11c \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ub808\ubca8\uc740 \uc885\uc885 \uace0\uc720\ud55c \ucc4c\ub9b0\uc9c0\uc640 \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud558\uc5ec \uacbd\ud5d8\uc774 \ud48d\ubd80\ud55c \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc0c8\ub85c\uc6b4 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ud658\uacbd\uc5d0\uc11c \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uc9c0\uc5ed\uc744 \uc554\uc2dc\ud558\ub294 \ubbf8\ubb18\ud55c \ub2e8\uc11c\ub97c \uc8fc\uc758 \uae4a\uac8c \uc0b4\ud3b4\ubcf4\uc2ed\uc2dc\uc624."}, {"question": "Bumpy Jumpy\uc5d0\uc11c \uc131\ub2a5\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uae30 \uc704\ud574 \uc81c\uc5b4\ub97c \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Bumpy Jumpy\uc5d0\uc11c \uc81c\uc5b4\ub97c \ucd5c\uc801\ud654\ud558\uba74 \uac8c\uc784 \ud50c\ub808\uc774\uac00 \ud06c\uac8c \ud5a5\uc0c1\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. PC\uc5d0\uc11c '\uc2a4\ud398\uc774\uc2a4\ubc14'\uac00 \uc5b4\uc0c9\ud558\ub2e4\uba74 \uc810\ud504 \ud0a4\ub97c \ub354 \uc811\uadfc\ud558\uae30 \uc26c\uc6b4 \ubc84\ud2bc\uc73c\ub85c \ub2e4\uc2dc \ub9e4\ud551\ud558\ub294 \uac83\uc744 \uace0\ub824\ud558\uc2ed\uc2dc\uc624. \ubaa8\ubc14\uc77c\uc5d0\uc11c \ubc84\ud2bc \ud06c\uae30\uc640 \uc704\uce58\ub97c \uc124\uc815 \uba54\ub274\uc5d0\uc11c \uc870\uc815\ud558\uc5ec \ubc18\uc751\uc131\uc744 \ub192\uc774\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4 '\uc5bc\uc74c \uad81\uc804' \ub808\ubca8\uc5d0\uc11c \uc815\ud655\ud55c \uc81c\uc5b4 \uc870\uc815\uc744 \ud1b5\ud574 \ubbf8\ub044\ub7ec\uc6b4 \ud50c\ub7ab\ud3fc\uc744 \ub354 \ud6a8\uacfc\uc801\uc73c\ub85c \ud0d0\uc0c9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc5ec\ub7ec \uac00\uc9c0 \uad6c\uc131\uc744 \uc2dc\ub3c4\ud558\uc5ec \uc790\uc2e0\uc5d0\uac8c \uac00\uc7a5 \uc801\ud569\ud55c \uac83\uc744 \ucc3e\uc544\ubcf4\uc2ed\uc2dc\uc624."}, {"question": "Bumpy Jumpy\uc5d0\uc11c \uac00\uc7a5 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc740 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \ud074\ub9ac\uc5b4\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Bumpy Jumpy\uc5d0\uc11c \uac00\uc7a5 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc740 \uc885\uc885 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uacfc \ud30c\uc6cc\uc5c5\uc758 \uc804\ub7b5\uc801 \uc0ac\uc6a9\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 '\ud654\uc0b0 \ud0c8\ucd9c' \ub808\ubca8\uc740 \ube60\ub974\uac8c \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uacfc \uc6a9\uc554 \ud750\ub984\uc774 \ud2b9\uc9d5\uc785\ub2c8\ub2e4. STEP1: '\ubc29\ud328' \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc608\uae30\uce58 \uc54a\uc740 \ucda9\ub3cc\ub85c\ubd80\ud130 \ubcf4\ud638\ud558\uc2ed\uc2dc\uc624. STEP2: \uc6a9\uc554\uc5d0 \ube60\uc9c0\uc9c0 \uc54a\ub3c4\ub85d \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uc2e0\uc911\ud558\uac8c \uc870\uc808\ud558\uc2ed\uc2dc\uc624. STEP3: \uc704\ud5d8 \uc694\uc18c\ub97c \uadf9\ubcf5\ud558\ub294 \ub3d9\uc548 \uac00\ub2a5\ud55c \ud55c \ub9ce\uc740 \ub3d9\uc804\uc744 \ubaa8\uc544 \uc810\uc218\ub97c \ub192\uc774\uc2ed\uc2dc\uc624. \uc5ec\ub7ec \ubc88 \uc5f0\uc2b5\ud558\uba74 \ud544\uc694\ud55c \uae30\uc220\uc744 \uc775\ud790 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
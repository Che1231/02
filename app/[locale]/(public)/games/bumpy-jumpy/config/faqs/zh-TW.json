[{"question": "\u5982\u4f55\u5728Bumpy Jumpy\u4e2d\u57f7\u884c\u57fa\u672c\u8df3\u8e8d\uff1f", "answer": "\u5728Bumpy Jumpy\u4e2d\uff0c\u57f7\u884c\u57fa\u672c\u8df3\u8e8d\u5c0d\u65bc\u904a\u73a9\u904a\u6232\u81f3\u95dc\u91cd\u8981\u3002\u53ea\u9700\u6309\u4e0b\u9375\u76e4\u4e0a\u7684\"\u7a7a\u683c\u9375\"\u6216\u5728\u624b\u6a5f\u87a2\u5e55\u4e0a\u8f15\u89f8\"\u8df3\u8e8d\"\u6309\u9215\u5373\u53ef\u3002\u4f8b\u5982\uff0c\u7576\u63a5\u8fd1\u5c0f\u969c\u7919\u7269\u6642\uff0c\u6b63\u78ba\u5730\u8a08\u6642\u8df3\u8e8d\u5c07\u6709\u52a9\u65bc\u60a8\u9806\u5229\u8d8a\u904e\u5b83\u3002\u8acb\u8a18\u4f4f\uff0c\u6309\u4f4f\u8df3\u8e8d\u6309\u9215\u7684\u6642\u9593\u8d8a\u9577\uff0c\u60a8\u7684\u89d2\u8272\u8df3\u8e8d\u7684\u9ad8\u5ea6\u8d8a\u9ad8\u3002"}, {"question": "\u5728Bumpy Jumpy\u4e2d\u53d6\u5f97\u9ad8\u5206\u6709\u54ea\u4e9b\u6700\u4f73\u7b56\u7565\uff1f", "answer": "\u5728Bumpy Jumpy\u4e2d\u53d6\u5f97\u9ad8\u5206\u9700\u8981\u7cbe\u78ba\u5ea6\u548c\u6642\u9593\u7684\u7d50\u5408\u3002\u6b65\u9a5f\u4e00\uff1a\u5c08\u6ce8\u65bc\u6536\u96c6\u786c\u5e63\u548c\u9053\u5177\uff0c\u56e0\u70ba\u5b83\u5011\u6703\u986f\u8457\u63d0\u5347\u60a8\u7684\u5206\u6578\u3002\u6b65\u9a5f\u4e8c\uff1a\u900f\u904e\u638c\u63e1\u8df3\u8e8d\u6642\u9593\u4f86\u907f\u514d\u969c\u7919\u7269\u3002\u6b65\u9a5f\u4e09\uff1a\u5229\u7528\"\u96d9\u8df3\"\u9053\u5177\u4f86\u5230\u9054\u66f4\u9ad8\u7684\u5e73\u53f0\uff0c\u6536\u96c6\u66f4\u591a\u786c\u5e63\u3002\u4f8b\u5982\uff0c\u5728\"\u9ad8\u7a7a\"\u95dc\u5361\u4e2d\uff0c\u4f7f\u7528\u96d9\u8df3\u53ef\u4ee5\u5e6b\u52a9\u60a8\u9032\u5165\u96b1\u85cf\u7684\u786c\u5e63\u7fa4\u96c6\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u7684\u89d2\u8272\u6709\u6642\u6703\u7a7f\u904eBumpy Jumpy\u4e2d\u7684\u5e73\u53f0\uff1f", "answer": "\u5728Bumpy Jumpy\u4e2d\uff0c\u89d2\u8272\u7a7f\u904e\u5e73\u53f0\u53ef\u80fd\u7531\u65bc\u5ef6\u9072\u6216\u78b0\u649e\u5075\u6e2c\u932f\u8aa4\u3002\u8acb\u78ba\u4fdd\u60a8\u7684\u904a\u6232\u5df2\u66f4\u65b0\u81f3\u6700\u65b0\u7248\u672c\uff0c\u4e26\u4e14\u5982\u679c\u5728\u7dda\u4e0a\u904a\u73a9\uff0c\u8acb\u6aa2\u67e5\u60a8\u7684\u7db2\u8def\u9023\u7dda\u3002\u4f8b\u5982\uff0c\u5728\"\u96f2\u7aef\u57ce\u5e02\"\u95dc\u5361\u4e2d\uff0c\u5e73\u53f0\u53ef\u80fd\u770b\u8d77\u4f86\u7a69\u5b9a\uff0c\u4f46\u6709\u6642\u53ef\u80fd\u6703\u51fa\u73fe\u6545\u969c\u3002\u5982\u679c\u554f\u984c\u6301\u7e8c\u5b58\u5728\uff0c\u91cd\u555f\u904a\u6232\u901a\u5e38\u53ef\u4ee5\u89e3\u6c7a\u3002"}, {"question": "\u5982\u4f55\u5728Bumpy Jumpy\u4e2d\u5c07\u624b\u6a5f\u7248\u9032\u5ea6\u8f49\u79fb\u5230\u96fb\u8166\u7248\uff1f", "answer": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u9593\u8f49\u79fbBumpy Jumpy\u9032\u5ea6\u975e\u5e38\u7c21\u55ae\u3002\u9996\u5148\uff0c\u8acb\u78ba\u4fdd\u60a8\u7684\u624b\u6a5f\u88dd\u7f6e\u555f\u7528\u4e86\u96f2\u7aef\u5132\u5b58\u3002\u7136\u5f8c\uff0c\u767b\u5165\u60a8\u5728\u96fb\u8166\u7248\u904a\u6232\u4e2d\u7684\u540c\u4e00\u500b\u5e33\u6236\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5df2\u5728\u624b\u6a5f\u7248\u5b8c\u6210\"\u53e2\u6797\u5192\u96aa\"\u95dc\u5361\uff0c\u60a8\u7684\u9032\u5ea6\u5c07\u81ea\u52d5\u540c\u6b65\u5230\u96fb\u8166\u7248\u3002\u8acb\u6ce8\u610f\uff0c\u5169\u500b\u7248\u672c\u5fc5\u9808\u9023\u7d50\u5230\u76f8\u540c\u7684\u5e33\u6236\u624d\u80fd\u7121\u7e2b\u5730\u8f49\u79fb\u8cc7\u6599\u3002"}, {"question": "Bumpy Jumpy\u4e2d\u7684\"\u5f48\u8df3\u588a\"\u6709\u4ec0\u9ebc\u610f\u7fa9\uff1f", "answer": "Bumpy Jumpy\u4e2d\u7684\"\u5f48\u8df3\u588a\"\u662f\u5230\u9054\u66f4\u9ad8\u5340\u57df\u548c\u907f\u514d\u969c\u7919\u7269\u7684\u95dc\u9375\u5143\u7d20\u3002\u7576\u60a8\u843d\u5728\u5f48\u8df3\u588a\u4e0a\u6642\uff0c\u60a8\u7684\u89d2\u8272\u6703\u88ab\u5f37\u5927\u7684\u529b\u91cf\u5f48\u5c04\u5230\u7a7a\u4e2d\u3002\u4f8b\u5982\uff0c\u5728\"\u5c71\u5cf0\"\u95dc\u5361\u4e2d\uff0c\u4f7f\u7528\u5f48\u8df3\u588a\u53ef\u4ee5\u5e6b\u52a9\u60a8\u9032\u5165\u5145\u6eff\u786c\u5e63\u548c\u9053\u5177\u7684\u96b1\u85cf\u5340\u57df\u3002\u638c\u63e1\u9019\u4e9b\u588a\u5b50\u4e0a\u8df3\u8e8d\u7684\u6642\u9593\u53ef\u4ee5\u5927\u5927\u63d0\u5347\u60a8\u7684\u904a\u6232\u9ad4\u9a57\u3002"}, {"question": "\u5728Bumpy Jumpy\u4e2d\u54ea\u4e9b\u9053\u5177\u6700\u6709\u6548\uff0c\u4ee5\u53ca\u5982\u4f55\u4f7f\u7528\u5b83\u5011\uff1f", "answer": "\u5728Bumpy Jumpy\u4e2d\uff0c\"\u9632\u8b77\u76fe\"\u548c\"\u78c1\u9435\"\u9053\u5177\u7279\u5225\u6709\u6548\u3002\u9632\u8b77\u76fe\u53ef\u4ee5\u4fdd\u8b77\u60a8\u514d\u53d7\u4e00\u6b21\u969c\u7919\u7269\u7684\u649e\u64ca\uff0c\u800c\u78c1\u9435\u5247\u53ef\u4ee5\u5438\u5f15\u9644\u8fd1\u7684\u786c\u5e63\u3002\u4f8b\u5982\uff0c\u5728\"\u6c34\u6676\u6d1e\u7a74\"\u95dc\u5361\u4e2d\uff0c\u4f7f\u7528\u78c1\u9435\u53ef\u4ee5\u5e6b\u52a9\u60a8\u6536\u96c6\u786c\u5e63\uff0c\u800c\u7121\u9700\u5b8c\u7f8e\u5c0d\u9f4a\u3002\u8981\u4f7f\u7528\u9019\u4e9b\u9053\u5177\uff0c\u53ea\u9700\u5728\u5b83\u5011\u51fa\u73fe\u6642\u8d70\u904e\u5b83\u5011\uff0c\u5b83\u5011\u5c31\u6703\u81ea\u52d5\u555f\u52d5\u3002"}, {"question": "Bumpy Jumpy\u4e2d\u7684\u8a08\u5206\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff1f", "answer": "Bumpy Jumpy\u4e2d\u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u5e7e\u500b\u56e0\u7d20\uff1a\u6536\u96c6\u7684\u786c\u5e63\u3001\u884c\u9032\u8ddd\u96e2\u548c\u4f7f\u7528\u7684\u9053\u5177\u3002\u6bcf\u679a\u786c\u5e63\u90fd\u6703\u589e\u52a0\u60a8\u7684\u5206\u6578\uff0c\u800c\u50cf\"\u96d9\u8df3\"\u9019\u6a23\u7684\u9053\u5177\u53ef\u4ee5\u5e6b\u52a9\u60a8\u5230\u9054\u66f4\u9ad8\u7684\u5e73\u53f0\u4ee5\u7372\u5f97\u984d\u5916\u5206\u6578\u3002\u4f8b\u5982\uff0c\u5728\"\u6c99\u6f20\u885d\u523a\"\u95dc\u5361\u4e2d\uff0c\u6709\u6548\u5730\u6536\u96c6\u6240\u6709\u786c\u5e63\u548c\u4f7f\u7528\u9053\u5177\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u60a8\u7684\u6700\u7d42\u5206\u6578\u3002\u904a\u6232\u4e5f\u6703\u5728\u60a8\u5b8c\u6210\u95dc\u5361\u4e14\u6c92\u6709\u4efb\u4f55\u649e\u64ca\u7684\u60c5\u6cc1\u4e0b\uff0c\u734e\u52f5\u984d\u5916\u5206\u6578\u3002"}, {"question": "Bumpy Jumpy\u4e2d\u7684\u96b1\u85cf\u95dc\u5361\u6709\u54ea\u4e9b\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9396\u5b83\u5011\uff1f", "answer": "Bumpy Jumpy\u5305\u542b\u5e7e\u500b\u96b1\u85cf\u95dc\u5361\uff0c\u53ef\u900f\u904e\u6eff\u8db3\u7279\u5b9a\u689d\u4ef6\u4f86\u89e3\u9396\u3002\u4f8b\u5982\uff0c\"\u79d8\u5bc6\u82b1\u5712\"\u95dc\u5361\u662f\u900f\u904e\u5728\"\u68ee\u6797\u5c0f\u5f91\"\u95dc\u5361\u6536\u96c6\u6240\u6709\u96b1\u85cf\u7684\u82b1\u6735\u4f86\u89e3\u9396\u7684\u3002\u9019\u4e9b\u96b1\u85cf\u95dc\u5361\u901a\u5e38\u6703\u5305\u542b\u7368\u7279\u7684\u6311\u6230\u548c\u734e\u52f5\uff0c\u70ba\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u63d0\u4f9b\u65b0\u9bae\u7684\u9ad4\u9a57\u3002\u8acb\u6ce8\u610f\u74b0\u5883\u4e2d\u7684\u7d30\u5fae\u7dda\u7d22\uff0c\u9019\u4e9b\u7dda\u7d22\u6697\u793a\u8457\u9019\u4e9b\u96b1\u85cf\u5340\u57df\u3002"}, {"question": "\u5982\u4f55\u5728Bumpy Jumpy\u4e2d\u512a\u5316\u6211\u7684\u63a7\u5236\uff0c\u4ee5\u7372\u5f97\u66f4\u597d\u7684\u8868\u73fe\uff1f", "answer": "\u512a\u5316Bumpy Jumpy\u4e2d\u7684\u63a7\u5236\u53ef\u4ee5\u5927\u5927\u63d0\u5347\u60a8\u7684\u904a\u6232\u9ad4\u9a57\u3002\u5728\u96fb\u8166\u7248\u904a\u6232\u4e2d\uff0c\u5982\u679c\u89ba\u5f97\"\u7a7a\u683c\u9375\"\u4e0d\u65b9\u4fbf\uff0c\u53ef\u4ee5\u8003\u616e\u5c07\u8df3\u8e8d\u6309\u9375\u91cd\u65b0\u8a2d\u5b9a\u5230\u66f4\u6613\u65bc\u4f7f\u7528\u7684\u6309\u9215\u3002\u5728\u624b\u6a5f\u7248\u904a\u6232\u4e2d\uff0c\u8abf\u6574\u8a2d\u5b9a\u9078\u55ae\u4e2d\u7684\u6309\u9215\u5927\u5c0f\u548c\u4f4d\u7f6e\uff0c\u4ee5\u7372\u5f97\u66f4\u597d\u7684\u53cd\u61c9\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\"\u51b0\u5bae\u6bbf\"\u95dc\u5361\u4e2d\uff0c\u7cbe\u78ba\u7684\u63a7\u5236\u8abf\u6574\u53ef\u4ee5\u5e6b\u52a9\u60a8\u66f4\u6709\u6548\u5730\u99d5\u99ad\u6ed1\u6e9c\u7684\u5e73\u53f0\u3002\u5617\u8a66\u4e0d\u540c\u7684\u914d\u7f6e\uff0c\u627e\u5230\u6700\u9069\u5408\u60a8\u7684\u8a2d\u5b9a\u3002"}, {"question": "Bumpy Jumpy\u4e2d\u6700\u5177\u6311\u6230\u6027\u7684\u95dc\u5361\u6709\u54ea\u4e9b\uff0c\u4ee5\u53ca\u5982\u4f55\u6253\u6557\u5b83\u5011\uff1f", "answer": "\u5728Bumpy Jumpy\u4e2d\u6700\u5177\u6311\u6230\u6027\u7684\u95dc\u5361\u901a\u5e38\u9700\u8981\u7cbe\u78ba\u7684\u6642\u9593\u548c\u7b56\u7565\u6027\u7684\u9053\u5177\u4f7f\u7528\u3002\u4f8b\u5982\uff0c\"\u706b\u5c71\u9003\u812b\"\u95dc\u5361\u7684\u5e73\u53f0\u79fb\u52d5\u8fc5\u901f\uff0c\u7194\u5ca9\u6d41\u66a2\u3002\u6b65\u9a5f\u4e00\uff1a\u4f7f\u7528\"\u9632\u8b77\u76fe\"\u9053\u5177\u4f86\u4fdd\u8b77\u514d\u53d7\u610f\u5916\u649e\u64ca\u3002\u6b65\u9a5f\u4e8c\uff1a\u5c0f\u5fc3\u8a08\u6642\u8df3\u8e8d\uff0c\u907f\u514d\u6389\u5165\u7194\u5ca9\u3002\u6b65\u9a5f\u4e09\uff1a\u5728\u61c9\u5c0d\u5371\u96aa\u7684\u540c\u6642\u6536\u96c6\u76e1\u53ef\u80fd\u591a\u7684\u786c\u5e63\u4ee5\u63d0\u5347\u5206\u6578\u3002\u53cd\u8986\u7df4\u7fd2\u9019\u4e9b\u95dc\u5361\u5c07\u80fd\u5e6b\u52a9\u60a8\u638c\u63e1\u5fc5\u8981\u7684\u6280\u5de7\u3002"}]
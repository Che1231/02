[{"question": "\u5982\u4f55\u5728\u300aUnpuzzle Master Tap Away\u300b\u521d\u5b66\u8005\u7248\u4e2d\u6267\u884c\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u5728\u300aUnpuzzle Master Tap Away\u300b\u6e38\u620f\u4e2d\uff0c\u57fa\u672c\u64cd\u4f5c\u5305\u62ec\u70b9\u51fb\u5c4f\u5e55\u4e0e\u62fc\u56fe\u5143\u7d20\u8fdb\u884c\u4ea4\u4e92\u3002\u4f8b\u5982\uff0c\u70b9\u51fb\u65b9\u5757\u4f1a\u5c06\u5176\u79fb\u52a8\u5230\u76f8\u90bb\u7684\u7a7a\u4f4d\u3002\u8981\u638c\u63e1\u6b64\u64cd\u4f5c\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41- \u901a\u8fc7\u5176\u7a81\u51fa\u663e\u793a\u7684\u8fb9\u6846\u8bc6\u522b\u53ef\u79fb\u52a8\u65b9\u5757\u3002\u6b65\u9aa42- \u70b9\u51fb\u60a8\u60f3\u8981\u79fb\u52a8\u7684\u65b9\u5757\u3002\u6b65\u9aa43- \u89c2\u5bdf\u65b0\u7684\u4f4d\u7f6e\u5e76\u8ba1\u5212\u4e0b\u4e00\u6b65\u3002\u8fd9\u9879\u57fa\u7840\u6280\u80fd\u5bf9\u4e8e\u901a\u5173\u65e9\u671f\u5173\u5361\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u300aUnpuzzle Master Tap Away\u300b\u4e2d\u7684\u67d0\u4e9b\u5173\u5361\u5bf9\u4e8e\u9ad8\u7ea7\u73a9\u5bb6\u6765\u8bf4\u66f4\u5177\u6311\u6218\u6027\uff1f", "answer": "\u300aUnpuzzle Master Tap Away\u300b\u7684\u9ad8\u7ea7\u5173\u5361\u5f15\u5165\u4e86\u590d\u6742\u7684\u673a\u5236\uff0c\u4f8b\u5982\u591a\u6b65\u9aa4\u8c1c\u9898\u548c\u65f6\u95f4\u9650\u5236\u3002\u4f8b\u5982\uff0c45\u7ea7\u9700\u8981\u73a9\u5bb6\u5728\u9650\u5b9a\u65f6\u95f4\u5185\u5b8c\u6210\u4e00\u7cfb\u5217\u79fb\u52a8\u3002\u8fd9\u4e9b\u5173\u5361\u8003\u9a8c\u73a9\u5bb6\u7684\u7b56\u7565\u89c4\u5212\u548c\u5feb\u901f\u51b3\u7b56\u80fd\u529b\u3002\u7406\u89e3\u5e95\u5c42\u673a\u5236\uff0c\u4f8b\u5982\u65b9\u5757\u7684\u4ea4\u4e92\u548c\u8c1c\u9898\u6a21\u5f0f\uff0c\u5bf9\u4e8e\u514b\u670d\u8fd9\u4e9b\u6311\u6218\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u5728\u300aUnpuzzle Master Tap Away\u300b\u4e2d\uff0c\u638c\u63e1\u9ad8\u7ea7\u8c1c\u9898\u7684\u5173\u952e\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300aUnpuzzle Master Tap Away\u300b\u4e2d\uff0c\u638c\u63e1\u9ad8\u7ea7\u8c1c\u9898\u9700\u8981\u591a\u79cd\u7b56\u7565\uff1a\u6b65\u9aa41- \u5206\u6790\u8c1c\u9898\u5e03\u5c40\uff0c\u8bc6\u522b\u5173\u952e\u5143\u7d20\u3002\u6b65\u9aa42- \u9884\u5148\u8ba1\u5212\u60a8\u7684\u79fb\u52a8\uff0c\u8003\u8651\u6f5c\u5728\u7684\u65b9\u5757\u4ea4\u4e92\u3002\u6b65\u9aa43- \u9ad8\u6548\u5730\u6267\u884c\u60a8\u7684\u8ba1\u5212\uff0c\u6839\u636e\u9700\u8981\u8fdb\u884c\u8c03\u6574\u3002\u4f8b\u5982\uff0c\u572860\u7ea7\u4e2d\uff0c\u73a9\u5bb6\u5fc5\u987b\u7ed3\u5408\u6ed1\u52a8\u548c\u65cb\u8f6c\u65b9\u5757\u6765\u4e3a\u4e3b\u89d2\u521b\u9020\u4e00\u6761\u8def\u5f84\u3002\u8fd9\u79cd\u65b9\u6cd5\u80fd\u591f\u5728\u590d\u6742\u7684\u8c1c\u9898\u4e2d\u83b7\u5f97\u66f4\u9ad8\u7684\u6210\u529f\u7387\u3002"}, {"question": "\u300aUnpuzzle Master Tap Away\u300b\u4e2d\u54ea\u4e9b\u6e38\u620f\u673a\u5236\u5bf9\u4e8e\u7406\u89e3\u6e38\u620f\u6838\u5fc3\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u300aUnpuzzle Master Tap Away\u300b\u7684\u6838\u5fc3\u673a\u5236\u5305\u62ec\u65b9\u5757\u79fb\u52a8\u3001\u65cb\u8f6c\u548c\u4e0e\u73af\u5883\u5143\u7d20\u7684\u4ea4\u4e92\u3002\u4f8b\u5982\uff0c\u65cb\u8f6c\u65b9\u5757\u53ef\u4ee5\u6539\u53d8\u5176\u65b9\u5411\uff0c\u4f7f\u5176\u80fd\u591f\u9002\u5e94\u7279\u5b9a\u7a7a\u95f4\u3002\u7406\u89e3\u8fd9\u4e9b\u673a\u5236\u5bf9\u4e8e\u6709\u6548\u5730\u89e3\u5f00\u8c1c\u9898\u81f3\u5173\u91cd\u8981\u3002\u4e00\u4e2a\u6bd4\u8f83\u65b9\u5757\u7c7b\u578b\u53ca\u5176\u4ea4\u4e92\u4f5c\u7528\u7684\u914d\u7f6e\u8868\u53ef\u4ee5\u5e2e\u52a9\u73a9\u5bb6\u66f4\u6709\u6548\u5730\u7406\u89e3\u8fd9\u4e9b\u6982\u5ff5\u3002"}, {"question": "\u300aUnpuzzle Master Tap Away\u300b\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u51b3\u7b56\uff1f", "answer": "\u300aUnpuzzle Master Tap Away\u300b\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u6839\u636e\u5b8c\u6210\u5173\u5361\u6240\u9700\u79fb\u52a8\u6b21\u6570\u548c\u65f6\u95f4\u5956\u52b1\u73a9\u5bb6\u3002\u4f8b\u5982\uff0c\u5728\u66f4\u5c11\u7684\u65f6\u95f4\u5185\u5b8c\u621030\u7ea7\u80fd\u83b7\u5f97\u66f4\u9ad8\u7684\u5206\u6570\u3002\u8be5\u7cfb\u7edf\u9f13\u52b1\u73a9\u5bb6\u4f18\u5316\u7b56\u7565\u5e76\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u4e0d\u5fc5\u8981\u7684\u52a8\u4f5c\u3002\u4e00\u4e2a\u8bf4\u660e\u8bc4\u5206\u6807\u51c6\u7684\u6d41\u7a0b\u56fe\u53ef\u4ee5\u5e2e\u52a9\u73a9\u5bb6\u5728\u6e38\u620f\u4e2d\u505a\u51fa\u660e\u667a\u7684\u51b3\u7b56\u3002"}, {"question": "\u300aUnpuzzle Master Tap Away\u300b\u7684\u79fb\u52a8\u7aef\u548cPC\u7248\u672c\u5728\u6e38\u620f\u4f53\u9a8c\u65b9\u9762\u6709\u4f55\u4e0d\u540c\uff1f", "answer": "\u300aUnpuzzle Master Tap Away\u300b\u7684\u79fb\u52a8\u7aef\u548cPC\u7248\u672c\u63d0\u4f9b\u4e86\u4e0d\u540c\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\uff0c\u57fa\u4e8e\u89e6\u6478\u7684\u63a7\u5236\u65b9\u5f0f\u4e3a\u89e3\u8c1c\u63d0\u4f9b\u4e86\u66f4\u76f4\u89c2\u7684\u4ea4\u4e92\uff0c\u800cPC\u7248\u672c\u5219\u901a\u8fc7\u9f20\u6807\u70b9\u51fb\u63d0\u4f9b\u4e86\u66f4\u7cbe\u786e\u7684\u64cd\u4f5c\u3002\u4f8b\u5982\uff0c\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\u5b8c\u621020\u7ea7\u53ef\u80fd\u4f1a\u611f\u89c9\u66f4\u6d41\u7545\uff0c\u56e0\u4e3a\u76f4\u63a5\u89e6\u6478\u8f93\u5165\uff0c\u800c\u5728PC\u4e0a\uff0c\u540c\u6837\u7684\u5173\u5361\u5f97\u76ca\u4e8e\u7cbe\u786e\u7684\u5149\u6807\u79fb\u52a8\u3002\u8fd9\u79cd\u6bd4\u8f83\u7a81\u51fa\u4e86\u8be5\u6e38\u620f\u8de8\u5e73\u53f0\u7684\u9002\u5e94\u6027\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u300aUnpuzzle Master Tap Away\u300b\u4e2d\u53d1\u73b0\u9690\u85cf\u5185\u5bb9\uff1f", "answer": "\u5728\u300aUnpuzzle Master Tap Away\u300b\u4e2d\u53d1\u73b0\u9690\u85cf\u5185\u5bb9\u901a\u5e38\u9700\u8981\u63a2\u7d22\u4e0d\u592a\u660e\u663e\u7684\u8def\u5f84\u548c\u89e3\u51b3\u53ef\u9009\u8c1c\u9898\u3002\u4f8b\u5982\uff0c\u572850\u7ea7\uff0c\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u89e3\u51b3\u4e3b\u5173\u5361\u5185\u7684\u6b21\u8981\u8c1c\u9898\u6765\u53d1\u73b0\u9690\u85cf\u7684\u989d\u5916\u533a\u57df\u3002\u8fd9\u4e9b\u5185\u5bb9\u53ef\u80fd\u5305\u62ec\u989d\u5916\u751f\u547d\u3001\u9053\u5177\u6216\u72ec\u7279\u7684\u6311\u6218\u3002\u4e00\u4e2a\u9010\u6b65\u6307\u5357\uff0c\u53ef\u4ee5\u5e2e\u52a9\u73a9\u5bb6\u627e\u5230\u8fd9\u4e9b\u9690\u85cf\u5143\u7d20\uff0c\u63d0\u5347\u6574\u4f53\u6e38\u620f\u4f53\u9a8c\u3002"}, {"question": "\u5728\u300aUnpuzzle Master Tap Away\u300b\u4e2d\u5207\u6362\u8bbe\u5907\u65f6\uff0c\u6570\u636e\u8fc1\u79fb\u7684\u6700\u4f73\u5b9e\u8df5\u662f\u4ec0\u4e48\uff1f", "answer": "\u8981\u8fc1\u79fb\u300aUnpuzzle Master Tap Away\u300b\u4e2d\u7684\u6570\u636e\uff0c\u8bf7\u786e\u4fdd\u60a8\u5728\u4e24\u53f0\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u5e10\u6237\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4ece\u5b89\u5353\u624b\u673a\u79fb\u52a8\u5230iPad\uff0c\u8bf7\u4f7f\u7528\u4e91\u4fdd\u5b58\u529f\u80fd\u540c\u6b65\u60a8\u7684\u8fdb\u5ea6\u3002\u6b65\u9aa41- \u5728\u60a8\u5f53\u524d\u7684\u8bbe\u5907\u4e0a\u6253\u5f00\u6e38\u620f\u5e76\u542f\u7528\u4e91\u4fdd\u5b58\u3002\u6b65\u9aa42- \u5728\u65b0\u8bbe\u5907\u4e0a\u767b\u5f55\u76f8\u540c\u7684\u5e10\u6237\u3002\u6b65\u9aa43- \u4e0b\u8f7d\u60a8\u7684\u4fdd\u5b58\u6570\u636e\uff0c\u4ee5\u4fbf\u65e0\u7f1d\u7ee7\u7eed\u60a8\u7684\u8fdb\u5ea6\u3002"}, {"question": "\u6e38\u620f\u4e2d\u7684\u89c6\u89c9\u548c\u97f3\u9891\u63d0\u793a\u5982\u4f55\u589e\u5f3a\u300aUnpuzzle Master Tap Away\u300b\u4e2d\u7684\u89e3\u8c1c\u4f53\u9a8c\uff1f", "answer": "\u300aUnpuzzle Master Tap Away\u300b\u4e2d\u7684\u89c6\u89c9\u548c\u97f3\u9891\u63d0\u793a\u5728\u5f15\u5bfc\u73a9\u5bb6\u89e3\u51b3\u8c1c\u9898\u65b9\u9762\u8d77\u7740\u91cd\u8981\u4f5c\u7528\u3002\u4f8b\u5982\uff0c\u53d1\u5149\u7684\u65b9\u5757\u8868\u793a\u53ef\u4ee5\u79fb\u52a8\uff0c\u800c\u7279\u5b9a\u7684\u58f0\u97f3\u6548\u679c\u5219\u8868\u793a\u64cd\u4f5c\u6b63\u786e\u3002\u8fd9\u4e9b\u63d0\u793a\u5e2e\u52a9\u73a9\u5bb6\u505a\u51fa\u660e\u667a\u7684\u51b3\u7b56\uff0c\u5e76\u589e\u5f3a\u6574\u4f53\u6c89\u6d78\u611f\u3002\u4e00\u4e2a\u6bd4\u8f83\u4e0d\u540c\u63d0\u793a\u53ca\u5176\u542b\u4e49\u7684\u8868\u683c\u53ef\u4ee5\u5e2e\u52a9\u73a9\u5bb6\u66f4\u5feb\u5730\u89e3\u51b3\u8c1c\u9898\u3002"}, {"question": "\u5728\u300aUnpuzzle Master Tap Away\u300b\u4e2d\u89e3\u51b3\u65f6\u95f4\u654f\u611f\u8c1c\u9898\u7684\u6700\u6709\u6548\u6280\u5de7\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300aUnpuzzle Master Tap Away\u300b\u4e2d\u89e3\u51b3\u65f6\u95f4\u654f\u611f\u8c1c\u9898\u9700\u8981\u5feb\u901f\u601d\u8003\u548c\u9ad8\u6548\u6267\u884c\u3002\u4f8b\u5982\uff0c\u572875\u7ea7\uff0c\u73a9\u5bb6\u5fc5\u987b\u572830\u79d2\u5185\u5b8c\u6210\u4e00\u7cfb\u5217\u52a8\u4f5c\u3002\u6280\u5de7\u5305\u62ec\uff1a\u6b65\u9aa41- \u9884\u5148\u719f\u6089\u8c1c\u9898\u5e03\u5c40\u3002\u6b65\u9aa42- \u4f18\u5148\u8003\u8651\u6253\u5f00\u591a\u6761\u8def\u5f84\u7684\u52a8\u4f5c\u3002\u6b65\u9aa43- \u591a\u6b21\u7ec3\u4e60\u8be5\u987a\u5e8f\uff0c\u4ee5\u51cf\u5c11\u53cd\u5e94\u65f6\u95f4\u3002\u6b64\u65b9\u6cd5\u53ef\u786e\u4fdd\u5728\u9ad8\u538b\u60c5\u51b5\u4e0b\u53d6\u5f97\u6210\u529f\u3002"}]
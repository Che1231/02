[{"question": "\u30a2\u30f3\u30d1\u30ba\u30eb\u30de\u30b9\u30bf\u30fc\u30bf\u30c3\u30d7\u30a2\u30a6\u30a7\u30a4\u306e\u521d\u5fc3\u8005\u5411\u3051\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u65b9\u6cd5\u3092\u6559\u3048\u3066\u304f\u3060\u3055\u3044\uff1f", "answer": "\u30a2\u30f3\u30d1\u30ba\u30eb\u30de\u30b9\u30bf\u30fc\u30bf\u30c3\u30d7\u30a2\u30a6\u30a7\u30a4\u3067\u306f\u3001\u30d1\u30ba\u30eb\u8981\u7d20\u3068\u5bfe\u8a71\u3059\u308b\u305f\u3081\u306b\u753b\u9762\u3092\u30bf\u30c3\u30d7\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30d6\u30ed\u30c3\u30af\u3092\u30bf\u30c3\u30d7\u3059\u308b\u3068\u3001\u96a3\u63a5\u3059\u308b\u7a7a\u3044\u3066\u3044\u308b\u5834\u6240\u306b\u79fb\u52d5\u3057\u307e\u3059\u3002\u3053\u308c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30cf\u30a4\u30e9\u30a4\u30c8\u3055\u308c\u305f\u67a0\u7dda\u3067\u79fb\u52d5\u53ef\u80fd\u306a\u30d6\u30ed\u30c3\u30af\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u79fb\u52d5\u3057\u305f\u3044\u30d6\u30ed\u30c3\u30af\u3092\u30bf\u30c3\u30d7\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u65b0\u3057\u3044\u4f4d\u7f6e\u3092\u89b3\u5bdf\u3057\u3001\u6b21\u306e\u624b\u3092\u8a08\u753b\u3057\u307e\u3059\u3002\u3053\u306e\u57fa\u672c\u7684\u306a\u30b9\u30ad\u30eb\u306f\u3001\u521d\u671f\u30ec\u30d9\u30eb\u3092\u9032\u3081\u308b\u4e0a\u3067\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002"}, {"question": "\u9ad8\u5ea6\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u30a2\u30f3\u30d1\u30ba\u30eb\u30de\u30b9\u30bf\u30fc\u30bf\u30c3\u30d7\u30a2\u30a6\u30a7\u30a4\u306e\u3044\u304f\u3064\u304b\u306e\u30ec\u30d9\u30eb\u304c\u96e3\u3057\u3044\u3068\u3055\u308c\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u30a2\u30f3\u30d1\u30ba\u30eb\u30de\u30b9\u30bf\u30fc\u30bf\u30c3\u30d7\u30a2\u30a6\u30a7\u30a4\u306e\u9ad8\u5ea6\u306a\u30ec\u30d9\u30eb\u3067\u306f\u3001\u8907\u6570\u30b9\u30c6\u30c3\u30d7\u306e\u30d1\u30ba\u30eb\u3084\u6642\u9593\u5236\u9650\u3068\u3044\u3063\u305f\u8907\u96d1\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u304c\u5c0e\u5165\u3055\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb45\u3067\u306f\u3001\u5236\u9650\u3055\u308c\u305f\u6642\u9593\u67a0\u306e\u4e2d\u3067\u4e00\u9023\u306e\u64cd\u4f5c\u3092\u89e3\u6c7a\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30ec\u30d9\u30eb\u306f\u3001\u6226\u7565\u7684\u306a\u8a08\u753b\u80fd\u529b\u3068\u8fc5\u901f\u306a\u610f\u601d\u6c7a\u5b9a\u80fd\u529b\u3092\u8a66\u3057\u307e\u3059\u3002\u30d6\u30ed\u30c3\u30af\u306e\u76f8\u4e92\u4f5c\u7528\u3084\u30d1\u30ba\u30eb\u30d1\u30bf\u30fc\u30f3\u3068\u3044\u3063\u305f\u57fa\u672c\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u3053\u308c\u3089\u306e\u8ab2\u984c\u3092\u514b\u670d\u3059\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002"}, {"question": "\u30a2\u30f3\u30d1\u30ba\u30eb\u30de\u30b9\u30bf\u30fc\u30bf\u30c3\u30d7\u30a2\u30a6\u30a7\u30a4\u3067\u4e0a\u7d1a\u30d1\u30ba\u30eb\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u305f\u3081\u306e\u91cd\u8981\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30a2\u30f3\u30d1\u30ba\u30eb\u30de\u30b9\u30bf\u30fc\u30bf\u30c3\u30d7\u30a2\u30a6\u30a7\u30a4\u3067\u4e0a\u7d1a\u30d1\u30ba\u30eb\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u6226\u7565\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u4e3b\u8981\u306a\u8981\u7d20\u3092\u7279\u5b9a\u3059\u308b\u305f\u3081\u306b\u30d1\u30ba\u30eb\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u5206\u6790\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6f5c\u5728\u7684\u306a\u30d6\u30ed\u30c3\u30af\u306e\u76f8\u4e92\u4f5c\u7528\u3092\u8003\u616e\u3057\u3066\u3001\u4e8b\u524d\u306b\u624b\u9806\u3092\u8a08\u753b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5fc5\u8981\u306b\u5fdc\u3058\u3066\u8abf\u6574\u3057\u306a\u304c\u3089\u3001\u8a08\u753b\u3092\u52b9\u7387\u7684\u306b\u5b9f\u884c\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb60\u3067\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30e1\u30a4\u30f3\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u30d1\u30b9\u3092\u4f5c\u6210\u3059\u308b\u305f\u3081\u306b\u3001\u30d6\u30ed\u30c3\u30af\u306e\u79fb\u52d5\u3068\u56de\u8ee2\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u4f7f\u7528\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u3001\u8907\u96d1\u306a\u30d1\u30ba\u30eb\u3067\u9ad8\u3044\u6210\u529f\u7387\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002"}, {"question": "\u30a2\u30f3\u30d1\u30ba\u30eb\u30de\u30b9\u30bf\u30fc\u30bf\u30c3\u30d7\u30a2\u30a6\u30a7\u30a4\u306e\u30b2\u30fc\u30e0\u306e\u6838\u5fc3\u3092\u7406\u89e3\u3059\u308b\u4e0a\u3067\u6700\u3082\u91cd\u8981\u306a\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30a2\u30f3\u30d1\u30ba\u30eb\u30de\u30b9\u30bf\u30fc\u30bf\u30c3\u30d7\u30a2\u30a6\u30a7\u30a4\u306e\u57fa\u672c\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u306f\u3001\u30d6\u30ed\u30c3\u30af\u306e\u79fb\u52d5\u3001\u56de\u8ee2\u3001\u74b0\u5883\u8981\u7d20\u3068\u306e\u76f8\u4e92\u4f5c\u7528\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30d6\u30ed\u30c3\u30af\u3092\u56de\u8ee2\u3055\u305b\u308b\u3053\u3068\u3067\u305d\u306e\u5411\u304d\u3092\u5909\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u3001\u7279\u5b9a\u306e\u5834\u6240\u306b\u5408\u3046\u3088\u3046\u306b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u30d1\u30ba\u30eb\u3092\u52b9\u7387\u7684\u306b\u89e3\u6c7a\u3059\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u30d6\u30ed\u30c3\u30af\u30bf\u30a4\u30d7\u3068\u305d\u306e\u76f8\u4e92\u4f5c\u7528\u3092\u6bd4\u8f03\u3059\u308b\u69cb\u6210\u8868\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u3053\u308c\u3089\u306e\u6982\u5ff5\u3092\u3088\u308a\u52b9\u679c\u7684\u306b\u7406\u89e3\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30a2\u30f3\u30d1\u30ba\u30eb\u30de\u30b9\u30bf\u30fc\u30bf\u30c3\u30d7\u30a2\u30a6\u30a7\u30a4\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u6c7a\u5b9a\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30a2\u30f3\u30d1\u30ba\u30eb\u30de\u30b9\u30bf\u30fc\u30bf\u30c3\u30d7\u30a2\u30a6\u30a7\u30a4\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u3067\u306f\u3001\u30ec\u30d9\u30eb\u3092\u5b8c\u4e86\u3059\u308b\u305f\u3081\u306b\u5fc5\u8981\u306a\u79fb\u52d5\u6570\u3068\u6642\u9593\u306b\u57fa\u3065\u3044\u3066\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u5831\u916c\u3092\u4e0e\u3048\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb30\u3092\u3088\u308a\u5c11\u306a\u3044\u79fb\u52d5\u6570\u3068\u6642\u9593\u3067\u5b8c\u4e86\u3059\u308b\u3068\u3001\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u6226\u7565\u3092\u6700\u9069\u5316\u3057\u3001\u4e0d\u5fc5\u8981\u306a\u64cd\u4f5c\u3092\u6700\u5c0f\u9650\u306b\u3059\u308b\u3053\u3068\u3092\u5968\u52b1\u3057\u307e\u3059\u3002\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u57fa\u6e96\u3092\u793a\u3059\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4e2d\u306b\u9069\u5207\u306a\u5224\u65ad\u3092\u4e0b\u3059\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30e2\u30d0\u30a4\u30eb\u7248\u3068PC\u7248\u306e\u30a2\u30f3\u30d1\u30ba\u30eb\u30de\u30b9\u30bf\u30fc\u30bf\u30c3\u30d7\u30a2\u30a6\u30a7\u30a4\u306e\u30b2\u30fc\u30e0\u4f53\u9a13\u306e\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30a2\u30f3\u30d1\u30ba\u30eb\u30de\u30b9\u30bf\u30fc\u30bf\u30c3\u30d7\u30a2\u30a6\u30a7\u30a4\u306e\u30e2\u30d0\u30a4\u30eb\u7248\u3068PC\u7248\u306f\u3001\u7570\u306a\u308b\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u7248\u3067\u306f\u3001\u30bf\u30c3\u30c1\u30d9\u30fc\u30b9\u306e\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u306b\u3088\u308a\u3001\u30d1\u30ba\u30eb\u3068\u306e\u5bfe\u8a71\u304c\u3088\u308a\u76f4\u611f\u7684\u306b\u306a\u308a\u307e\u3059\u3002\u4e00\u65b9\u3001PC\u7248\u3067\u306f\u3001\u30de\u30a6\u30b9\u3092\u30af\u30ea\u30c3\u30af\u3059\u308b\u3053\u3068\u3067\u7cbe\u5ea6\u3092\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30e2\u30d0\u30a4\u30eb\u7248\u30ec\u30d9\u30eb20\u306f\u3001\u76f4\u63a5\u30bf\u30c3\u30c1\u5165\u529b\u306b\u3088\u3063\u3066\u30b9\u30e0\u30fc\u30ba\u306b\u611f\u3058\u3089\u308c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u304c\u3001PC\u7248\u3067\u306f\u3001\u540c\u3058\u30ec\u30d9\u30eb\u3067\u3082\u7cbe\u5ea6\u306e\u9ad8\u3044\u30ab\u30fc\u30bd\u30eb\u79fb\u52d5\u306b\u3088\u3063\u3066\u6069\u6075\u3092\u53d7\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u6bd4\u8f03\u306f\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u5168\u4f53\u3067\u306e\u30b2\u30fc\u30e0\u306e\u9069\u5fdc\u6027\u3092\u793a\u3057\u3066\u3044\u307e\u3059\u3002"}, {"question": "\u30a2\u30f3\u30d1\u30ba\u30eb\u30de\u30b9\u30bf\u30fc\u30bf\u30c3\u30d7\u30a2\u30a6\u30a7\u30a4\u3067\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u767a\u898b\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30a2\u30f3\u30d1\u30ba\u30eb\u30de\u30b9\u30bf\u30fc\u30bf\u30c3\u30d7\u30a2\u30a6\u30a7\u30a4\u3067\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u767a\u898b\u3059\u308b\u306b\u306f\u3001\u3042\u307e\u308a\u660e\u3089\u304b\u3067\u306a\u3044\u30d1\u30b9\u3092\u63a2\u6c42\u3057\u3001\u30aa\u30d7\u30b7\u30e7\u30f3\u306e\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u3053\u3068\u304c\u3057\u3070\u3057\u3070\u5fc5\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb50\u3067\u306f\u3001\u30e1\u30a4\u30f3\u30ec\u30d9\u30eb\u5185\u306e\u88dc\u52a9\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u3053\u3068\u306b\u3088\u3063\u3066\u3001\u96a0\u3057\u30dc\u30fc\u30ca\u30b9\u30a8\u30ea\u30a2\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u30b3\u30f3\u30c6\u30f3\u30c4\u306b\u306f\u3001\u8ffd\u52a0\u306e\u30e9\u30a4\u30d5\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3001\u307e\u305f\u306f\u30e6\u30cb\u30fc\u30af\u306a\u30c1\u30e3\u30ec\u30f3\u30b8\u304c\u542b\u307e\u308c\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u96a0\u308c\u305f\u8981\u7d20\u3092\u767a\u898b\u3059\u308b\u305f\u3081\u306e\u30b9\u30c6\u30c3\u30d7\u30d0\u30a4\u30b9\u30c6\u30c3\u30d7\u30ac\u30a4\u30c9\u306f\u3001\u5168\u4f53\u7684\u306a\u30b2\u30fc\u30e0\u4f53\u9a13\u3092\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30c7\u30d0\u30a4\u30b9\u3092\u5909\u66f4\u3059\u308b\u969b\u306b\u30a2\u30f3\u30d1\u30ba\u30eb\u30de\u30b9\u30bf\u30fc\u30bf\u30c3\u30d7\u30a2\u30a6\u30a7\u30a4\u3067\u30c7\u30fc\u30bf\u79fb\u884c\u3092\u884c\u3046\u305f\u3081\u306e\u30d9\u30b9\u30c8\u30d7\u30e9\u30af\u30c6\u30a3\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30a2\u30f3\u30d1\u30ba\u30eb\u30de\u30b9\u30bf\u30fc\u30bf\u30c3\u30d7\u30a2\u30a6\u30a7\u30a4\u3067\u30c7\u30fc\u30bf\u3092\u79fb\u884c\u3059\u308b\u306b\u306f\u3001\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001Android\u643a\u5e2f\u96fb\u8a71\u304b\u3089iPad\u306b\u79fb\u52d5\u3059\u308b\u5834\u5408\u3001\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u9032\u6357\u72b6\u6cc1\u3092\u540c\u671f\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u73fe\u5728\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u30b2\u30fc\u30e0\u3092\u958b\u3044\u3066\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u6709\u52b9\u306b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u4fdd\u5b58\u3055\u308c\u305f\u30c7\u30fc\u30bf\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3066\u3001\u30b9\u30e0\u30fc\u30ba\u306b\u9032\u6357\u72b6\u6cc1\u3092\u7d9a\u884c\u3057\u307e\u3059\u3002"}, {"question": "\u30a2\u30f3\u30d1\u30ba\u30eb\u30de\u30b9\u30bf\u30fc\u30bf\u30c3\u30d7\u30a2\u30a6\u30a7\u30a4\u306e\u30d1\u30ba\u30eb\u4f53\u9a13\u3092\u5f37\u5316\u3059\u308b\u30b2\u30fc\u30e0\u306e\u8996\u899a\u7684\u304a\u3088\u3073\u97f3\u306e\u30d2\u30f3\u30c8\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30a2\u30f3\u30d1\u30ba\u30eb\u30de\u30b9\u30bf\u30fc\u30bf\u30c3\u30d7\u30a2\u30a6\u30a7\u30a4\u306e\u8996\u899a\u7684\u304a\u3088\u3073\u97f3\u306e\u30d2\u30f3\u30c8\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u30d1\u30ba\u30eb\u3092\u901a\u3057\u3066\u5c0e\u304f\u4e0a\u3067\u91cd\u8981\u306a\u5f79\u5272\u3092\u679c\u305f\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u5149\u308b\u30d6\u30ed\u30c3\u30af\u306f\u79fb\u52d5\u3067\u304d\u308b\u3053\u3068\u3092\u793a\u3057\u3001\u7279\u5b9a\u306e\u97f3\u306f\u6b63\u3057\u3044\u64cd\u4f5c\u3092\u793a\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30d2\u30f3\u30c8\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u9069\u5207\u306a\u5224\u65ad\u3092\u884c\u3044\u3001\u5168\u4f53\u7684\u306a\u6ca1\u5165\u611f\u3092\u9ad8\u3081\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u7570\u306a\u308b\u30d2\u30f3\u30c8\u3068\u305d\u306e\u610f\u5473\u3092\u6bd4\u8f03\u3059\u308b\u8868\u306f\u3001\u3088\u308a\u8fc5\u901f\u306a\u30d1\u30ba\u30eb\u89e3\u6c7a\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30a2\u30f3\u30d1\u30ba\u30eb\u30de\u30b9\u30bf\u30fc\u30bf\u30c3\u30d7\u30a2\u30a6\u30a7\u30a4\u3067\u6642\u9593\u5236\u9650\u306e\u3042\u308b\u30d1\u30ba\u30eb\u3092\u89e3\u6c7a\u3059\u308b\u305f\u3081\u306e\u6700\u3082\u52b9\u679c\u7684\u306a\u30c6\u30af\u30cb\u30c3\u30af\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30a2\u30f3\u30d1\u30ba\u30eb\u30de\u30b9\u30bf\u30fc\u30bf\u30c3\u30d7\u30a2\u30a6\u30a7\u30a4\u3067\u6642\u9593\u5236\u9650\u306e\u3042\u308b\u30d1\u30ba\u30eb\u3092\u89e3\u6c7a\u3059\u308b\u306b\u306f\u3001\u8fc5\u901f\u306a\u601d\u8003\u3068\u52b9\u7387\u7684\u306a\u5b9f\u884c\u304c\u5fc5\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb75\u3067\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f30\u79d2\u4ee5\u5185\u306b\u4e00\u9023\u306e\u64cd\u4f5c\u3092\u5b8c\u4e86\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30c6\u30af\u30cb\u30c3\u30af\u306f\u4ee5\u4e0b\u306e\u3068\u304a\u308a\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30d1\u30ba\u30eb\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u4e8b\u524d\u306b\u628a\u63e1\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u8907\u6570\u306e\u30d1\u30b9\u3092\u958b\u304f\u64cd\u4f5c\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u53cd\u5fdc\u6642\u9593\u3092\u77ed\u7e2e\u3059\u308b\u305f\u3081\u306b\u624b\u9806\u3092\u8907\u6570\u56de\u7df4\u7fd2\u3057\u307e\u3059\u3002\u3053\u306e\u65b9\u6cd5\u306b\u3088\u308a\u3001\u9ad8\u5727\u72b6\u6cc1\u3067\u306e\u6210\u529f\u304c\u4fdd\u8a3c\u3055\u308c\u307e\u3059\u3002"}]
[{"question": "\u5982\u4f55\u9032\u884c\u521d\u5b78\u8005\u7248\u300aUnpuzzle Master Tap Away\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u5728\u300aUnpuzzle Master Tap Away\u300b\u4e2d\uff0c\u57fa\u672c\u64cd\u4f5c\u5305\u62ec\u9ede\u64ca\u87a2\u5e55\u8207\u62fc\u5716\u5143\u7d20\u4e92\u52d5\u3002\u4f8b\u5982\uff0c\u9ede\u64ca\u65b9\u584a\u6703\u5c07\u5176\u79fb\u52d5\u5230\u76f8\u9130\u7684\u7a7a\u4f4d\u3002\u8981\u638c\u63e1\u6b64\u6280\u5de7\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u8b58\u5225\u908a\u6846\u7a81\u51fa\u986f\u793a\u7684\u53ef\u79fb\u52d5\u65b9\u584a\u3002\u6b65\u9a5f2 - \u9ede\u64ca\u8981\u79fb\u52d5\u7684\u65b9\u584a\u3002\u6b65\u9a5f3 - \u89c0\u5bdf\u65b0\u7684\u4f4d\u7f6e\u4e26\u8a08\u5283\u4e0b\u4e00\u6b65\u3002\u6b64\u57fa\u790e\u6280\u80fd\u5c0d\u65bc\u5728\u65e9\u671f\u95dc\u5361\u4e2d\u9032\u5c55\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u300aUnpuzzle Master Tap Away\u300b\u7684\u4e00\u4e9b\u95dc\u5361\u88ab\u8a8d\u70ba\u5c0d\u9ad8\u7d1a\u73a9\u5bb6\u66f4\u5177\u6311\u6230\u6027\uff1f", "answer": "\u300aUnpuzzle Master Tap Away\u300b\u7684\u9ad8\u7d1a\u95dc\u5361\u5f15\u5165\u4e86\u8907\u96dc\u7684\u6a5f\u5236\uff0c\u4f8b\u5982\u591a\u6b65\u9a5f\u62fc\u5716\u548c\u6642\u9593\u9650\u5236\u3002\u4f8b\u5982\uff0c45\u95dc\u9700\u8981\u73a9\u5bb6\u5728\u6709\u9650\u7684\u6642\u9593\u5167\u89e3\u6c7a\u4e00\u7cfb\u5217\u52d5\u4f5c\u3002\u9019\u4e9b\u95dc\u5361\u8003\u9a57\u7b56\u7565\u898f\u5283\u548c\u5feb\u901f\u6c7a\u7b56\u80fd\u529b\u3002\u4e86\u89e3\u5e95\u5c64\u6a5f\u5236\uff0c\u4f8b\u5982\u65b9\u584a\u4e92\u52d5\u548c\u62fc\u5716\u6a21\u5f0f\uff0c\u5c0d\u65bc\u514b\u670d\u9019\u4e9b\u6311\u6230\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u5728\u300aUnpuzzle Master Tap Away\u300b\u4e2d\uff0c\u638c\u63e1\u9ad8\u968e\u62fc\u5716\u7684\u95dc\u9375\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u300aUnpuzzle Master Tap Away\u300b\u4e2d\uff0c\u638c\u63e1\u9ad8\u968e\u62fc\u5716\u9700\u8981\u4e00\u4e9b\u7b56\u7565\uff1a\u6b65\u9a5f1 - \u5206\u6790\u62fc\u5716\u4f48\u5c40\u4ee5\u8b58\u5225\u95dc\u9375\u5143\u7d20\u3002\u6b65\u9a5f2 - \u9810\u5148\u8a08\u5283\u60a8\u7684\u52d5\u4f5c\uff0c\u8003\u616e\u6f5b\u5728\u7684\u65b9\u584a\u4e92\u52d5\u3002\u6b65\u9a5f3 - \u9ad8\u6548\u5730\u57f7\u884c\u60a8\u7684\u8a08\u5283\uff0c\u4e26\u6839\u64da\u9700\u8981\u9032\u884c\u8abf\u6574\u3002\u4f8b\u5982\uff0c\u572860\u95dc\uff0c\u73a9\u5bb6\u5fc5\u9808\u7d50\u5408\u6ed1\u52d5\u548c\u65cb\u8f49\u65b9\u584a\u4f86\u70ba\u4e3b\u89d2\u5275\u9020\u4e00\u689d\u8def\u5f91\u3002\u9019\u7a2e\u65b9\u6cd5\u78ba\u4fdd\u5728\u8907\u96dc\u7684\u62fc\u5716\u4e2d\u7372\u5f97\u66f4\u9ad8\u7684\u6210\u529f\u7387\u3002"}, {"question": "\u300aUnpuzzle Master Tap Away\u300b\u54ea\u4e9b\u904a\u6232\u6a5f\u5236\u5c0d\u65bc\u7406\u89e3\u904a\u6232\u6838\u5fc3\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u300aUnpuzzle Master Tap Away\u300b\u7684\u6838\u5fc3\u6a5f\u5236\u5305\u62ec\u65b9\u584a\u79fb\u52d5\u3001\u65cb\u8f49\u4ee5\u53ca\u8207\u74b0\u5883\u5143\u7d20\u7684\u4e92\u52d5\u3002\u4f8b\u5982\uff0c\u65cb\u8f49\u65b9\u584a\u53ef\u4ee5\u6539\u8b8a\u5176\u65b9\u5411\uff0c\u4f7f\u5176\u9069\u5408\u7279\u5b9a\u7684\u4f4d\u7f6e\u3002\u7406\u89e3\u9019\u4e9b\u6a5f\u5236\u5c0d\u65bc\u6709\u6548\u89e3\u6c7a\u62fc\u5716\u81f3\u95dc\u91cd\u8981\u3002\u4e00\u500b\u6bd4\u8f03\u65b9\u584a\u985e\u578b\u53ca\u5176\u4e92\u52d5\u7684\u914d\u7f6e\u8868\u53ef\u4ee5\u5e6b\u52a9\u73a9\u5bb6\u66f4\u6709\u6548\u5730\u7406\u89e3\u9019\u4e9b\u6982\u5ff5\u3002"}, {"question": "\u300aUnpuzzle Master Tap Away\u300b\u7684\u7a4d\u5206\u7cfb\u7d71\u5982\u4f55\u5f71\u97ff\u904a\u6232\u6c7a\u7b56\uff1f", "answer": "\u300aUnpuzzle Master Tap Away\u300b\u7684\u7a4d\u5206\u7cfb\u7d71\u6839\u64da\u5b8c\u6210\u95dc\u5361\u6240\u9700\u7684\u52d5\u4f5c\u6b21\u6578\u548c\u6642\u9593\u4f86\u734e\u52f5\u73a9\u5bb6\u3002\u4f8b\u5982\uff0c\u5728\u8f03\u5c11\u7684\u52d5\u4f5c\u548c\u66f4\u77ed\u7684\u6642\u9593\u5167\u5b8c\u621030\u95dc\u53ef\u4ee5\u7372\u5f97\u66f4\u9ad8\u7684\u5206\u6578\u3002\u6b64\u7cfb\u7d71\u9f13\u52f5\u73a9\u5bb6\u512a\u5316\u7b56\u7565\u4e26\u5c07\u4e0d\u5fc5\u8981\u7684\u52d5\u4f5c\u964d\u5230\u6700\u4f4e\u3002\u4e00\u500b\u8aaa\u660e\u7a4d\u5206\u6a19\u6e96\u7684\u6d41\u7a0b\u5716\u53ef\u4ee5\u5e6b\u52a9\u73a9\u5bb6\u5728\u904a\u6232\u904e\u7a0b\u4e2d\u505a\u51fa\u660e\u667a\u7684\u6c7a\u7b56\u3002"}, {"question": "\u300aUnpuzzle Master Tap Away\u300b\u7684\u79fb\u52d5\u7248\u548c\u96fb\u8166\u7248\u5728\u904a\u6232\u9ad4\u9a57\u4e0a\u6709\u54ea\u4e9b\u5dee\u5225\uff1f", "answer": "\u300aUnpuzzle Master Tap Away\u300b\u7684\u79fb\u52d5\u7248\u548c\u96fb\u8166\u7248\u63d0\u4f9b\u4e0d\u540c\u7684\u904a\u6232\u9ad4\u9a57\u3002\u5728\u79fb\u52d5\u7248\u4e0a\uff0c\u89f8\u63a7\u63a7\u5236\u70ba\u8207\u62fc\u5716\u4e92\u52d5\u63d0\u4f9b\u66f4\u76f4\u89c0\u7684\u9ad4\u9a57\uff0c\u800c\u96fb\u8166\u7248\u5247\u63d0\u4f9b\u7cbe\u78ba\u7684\u6ed1\u9f20\u9ede\u64ca\u3002\u4f8b\u5982\uff0c\u5728\u79fb\u52d5\u7248\u4e0a\uff0c\u7531\u65bc\u76f4\u63a5\u7684\u89f8\u63a7\u8f38\u5165\uff0c20\u95dc\u53ef\u80fd\u611f\u89ba\u66f4\u6d41\u66a2\uff0c\u800c\u5728\u96fb\u8166\u7248\u4e0a\uff0c\u540c\u4e00\u95dc\u5361\u53d7\u76ca\u65bc\u7cbe\u78ba\u7684\u5149\u6a19\u79fb\u52d5\u3002\u9019\u9805\u6bd4\u8f03\u7a81\u986f\u4e86\u904a\u6232\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u7684\u9069\u61c9\u80fd\u529b\u3002"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u300aUnpuzzle Master Tap Away\u300b\u4e2d\u767c\u73fe\u96b1\u85cf\u5167\u5bb9\uff1f", "answer": "\u5728\u300aUnpuzzle Master Tap Away\u300b\u4e2d\uff0c\u767c\u73fe\u96b1\u85cf\u5167\u5bb9\u901a\u5e38\u9700\u8981\u63a2\u7d22\u4e0d\u986f\u773c\u7684\u8def\u5f91\u4e26\u89e3\u6c7a\u984d\u5916\u7684\u62fc\u5716\u3002\u4f8b\u5982\uff0c\u572850\u95dc\uff0c\u73a9\u5bb6\u53ef\u4ee5\u901a\u904e\u89e3\u6c7a\u4e3b\u95dc\u5361\u4e2d\u7684\u6b21\u8981\u62fc\u5716\u4f86\u767c\u73fe\u96b1\u85cf\u7684\u734e\u52f5\u5340\u57df\u3002\u8a72\u5167\u5bb9\u53ef\u80fd\u5305\u542b\u984d\u5916\u751f\u547d\u503c\u3001\u589e\u76ca\u9053\u5177\u6216\u7368\u7279\u7684\u6311\u6230\u3002\u9010\u6b65\u6307\u5357\u53ef\u4ee5\u63d0\u9ad8\u73a9\u5bb6\u767c\u73fe\u9019\u4e9b\u96b1\u85cf\u5143\u7d20\u7684\u6548\u7387\u3002"}, {"question": "\u5728\u300aUnpuzzle Master Tap Away\u300b\u4e2d\uff0c\u5728\u5207\u63db\u8a2d\u5099\u6642\u5982\u4f55\u9032\u884c\u8cc7\u6599\u9077\u79fb\uff1f", "answer": "\u8981\u9077\u79fb\u300aUnpuzzle Master Tap Away\u300b\u4e2d\u7684\u8cc7\u6599\uff0c\u8acb\u78ba\u4fdd\u60a8\u5728\u5169\u500b\u8a2d\u5099\u4e0a\u90fd\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5f9eAndroid\u624b\u6a5f\u8f49\u79fb\u5230iPad\uff0c\u8acb\u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u5c07\u60a8\u7684\u9032\u5ea6\u540c\u6b65\u3002\u6b65\u9a5f1 - \u5728\u60a8\u7684\u7576\u524d\u8a2d\u5099\u4e0a\u6253\u958b\u904a\u6232\u4e26\u555f\u7528\u96f2\u7aef\u5132\u5b58\u3002\u6b65\u9a5f2 - \u5728\u65b0\u8a2d\u5099\u4e0a\u767b\u5165\u540c\u4e00\u5e33\u6236\u3002\u6b65\u9a5f3 - \u4e0b\u8f09\u60a8\u7684\u5132\u5b58\u8cc7\u6599\u4ee5\u9806\u5229\u7e7c\u7e8c\u60a8\u7684\u9032\u5ea6\u3002"}, {"question": "\u904a\u6232\u7684\u8996\u89ba\u548c\u97f3\u6548\u63d0\u793a\u5982\u4f55\u589e\u5f37\u300aUnpuzzle Master Tap Away\u300b\u7684\u89e3\u8b0e\u9ad4\u9a57\uff1f", "answer": "\u300aUnpuzzle Master Tap Away\u300b\u4e2d\u7684\u8996\u89ba\u548c\u97f3\u6548\u63d0\u793a\u5728\u5f15\u5c0e\u73a9\u5bb6\u89e3\u6c7a\u62fc\u5716\u65b9\u9762\u767c\u63ee\u4e86\u91cd\u8981\u4f5c\u7528\u3002\u4f8b\u5982\uff0c\u767c\u5149\u7684\u65b9\u584a\u8868\u793a\u53ef\u4ee5\u79fb\u52d5\uff0c\u800c\u7279\u5b9a\u7684\u97f3\u6548\u5247\u8868\u793a\u6b63\u78ba\u7684\u52d5\u4f5c\u3002\u9019\u4e9b\u63d0\u793a\u6709\u52a9\u65bc\u73a9\u5bb6\u505a\u51fa\u660e\u667a\u7684\u6c7a\u7b56\uff0c\u4e26\u589e\u5f37\u6574\u9ad4\u6c89\u6d78\u611f\u3002\u4e0d\u540c\u7684\u63d0\u793a\u53ca\u5176\u542b\u7fa9\u7684\u6bd4\u8f03\u8868\u683c\u6709\u52a9\u65bc\u66f4\u5feb\u5730\u89e3\u6c7a\u62fc\u5716\u3002"}, {"question": "\u5728\u300aUnpuzzle Master Tap Away\u300b\u4e2d\u89e3\u6c7a\u6642\u9593\u654f\u611f\u578b\u62fc\u5716\u7684\u6700\u6709\u6548\u6280\u5de7\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u300aUnpuzzle Master Tap Away\u300b\u4e2d\u89e3\u6c7a\u6642\u9593\u654f\u611f\u578b\u62fc\u5716\u9700\u8981\u5feb\u901f\u601d\u8003\u548c\u9ad8\u6548\u7684\u57f7\u884c\u3002\u4f8b\u5982\uff0c\u572875\u95dc\uff0c\u73a9\u5bb6\u5fc5\u9808\u572830\u79d2\u5167\u5b8c\u6210\u4e00\u7cfb\u5217\u52d5\u4f5c\u3002\u9019\u4e9b\u6280\u5de7\u5305\u62ec\uff1a\u6b65\u9a5f1 - \u9810\u5148\u719f\u6089\u62fc\u5716\u4f48\u5c40\u3002\u6b65\u9a5f2 - \u512a\u5148\u8003\u616e\u80fd\u5920\u958b\u555f\u591a\u689d\u8def\u5f91\u7684\u52d5\u4f5c\u3002\u6b65\u9a5f3 - \u591a\u6b21\u7df4\u7fd2\u9806\u5e8f\u4ee5\u6e1b\u5c11\u53cd\u61c9\u6642\u9593\u3002\u9019\u7a2e\u65b9\u6cd5\u78ba\u4fdd\u5728\u9ad8\u58d3\u60c5\u6cc1\u4e0b\u53d6\u5f97\u6210\u529f\u3002"}]
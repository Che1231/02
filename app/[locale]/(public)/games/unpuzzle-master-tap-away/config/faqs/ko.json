[{"question": "\ucd08\ubcf4\uc790\ub97c \uc704\ud55c \uc5b8\ud37c\uc990 \ub9c8\uc2a4\ud130 \ud0ed \uc5b4\uc6e8\uc774 \uae30\ubcf8 \uc6c0\uc9c1\uc784\uc740 \uc5b4\ub5bb\uac8c \uc218\ud589\ud569\ub2c8\uae4c?", "answer": "\uc5b8\ud37c\uc990 \ub9c8\uc2a4\ud130 \ud0ed \uc5b4\uc6e8\uc774\uc5d0\uc11c \uae30\ubcf8 \uc6c0\uc9c1\uc784\uc740 \ud37c\uc990 \uc694\uc18c\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\uae30 \uc704\ud574 \ud654\uba74\uc744 \ud0ed\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ube14\ub85d\uc744 \ud0ed\ud558\uba74 \uc778\uc811\ud55c \ube48 \uacf5\uac04\uc73c\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4. \uc774\ub97c \ub9c8\uc2a4\ud130\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: 1\ub2e8\uacc4 \u2013 \uac15\uc870 \ud45c\uc2dc\ub41c \ud14c\ub450\ub9ac\ub85c \uc774\ub3d9 \uac00\ub2a5\ud55c \ube14\ub85d\uc744 \uc2dd\ubcc4\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4 \u2013 \uc774\ub3d9\ud558\ub824\ub294 \ube14\ub85d\uc744 \ud0ed\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4 \u2013 \uc0c8\ub85c\uc6b4 \uc704\uce58\ub97c \uad00\ucc30\ud558\uace0 \ub2e4\uc74c \uc6c0\uc9c1\uc784\uc744 \uacc4\ud68d\ud569\ub2c8\ub2e4. \uc774 \uae30\ubcf8\uc801\uc778 \uae30\uc220\uc740 \ucd08\uae30 \ub808\ubca8\uc744 \uc9c4\ud589\ud558\ub294 \ub370 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4."}, {"question": "\uc5b8\ud37c\uc990 \ub9c8\uc2a4\ud130 \ud0ed \uc5b4\uc6e8\uc774\uc5d0\uc11c \uc77c\ubd80 \ub808\ubca8\uc774 \uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c\ub294 \uc65c \ub354 \uc5b4\ub824\uc6b4 \uac83\uc73c\ub85c \uac04\uc8fc\ub429\ub2c8\uae4c?", "answer": "\uc5b8\ud37c\uc990 \ub9c8\uc2a4\ud130 \ud0ed \uc5b4\uc6e8\uc774\uc5d0\uc11c \uace0\uae09 \ub808\ubca8\uc740 \ub2e4\ub2e8\uacc4 \ud37c\uc990 \ubc0f \uc2dc\uac04 \uc81c\ud55c\uacfc \uac19\uc740 \ubcf5\uc7a1\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \uc18c\uac1c\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 45\uc5d0\uc11c\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uc81c\ud55c\ub41c \uc2dc\uac04 \ub0b4\uc5d0 \uc6c0\uc9c1\uc784\uc758 \uc2dc\ud000\uc2a4\ub97c \ud480\uc5b4\uc57c \ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ub808\ubca8\uc740 \uc804\ub7b5\uc801 \uacc4\ud68d\uacfc \uc2e0\uc18d\ud55c \uc758\uc0ac \uacb0\uc815\uc744 \uc2dc\ud5d8\ud569\ub2c8\ub2e4. \ube14\ub85d \uc0c1\ud638 \uc791\uc6a9 \ubc0f \ud37c\uc990 \ud328\ud134\uacfc \uac19\uc740 \uae30\ubcf8\uc801\uc778 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc774\ub7ec\ud55c \uc5b4\ub824\uc6c0\uc744 \uadf9\ubcf5\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4."}, {"question": "\uc5b8\ud37c\uc990 \ub9c8\uc2a4\ud130 \ud0ed \uc5b4\uc6e8\uc774\uc5d0\uc11c \uace0\uae09 \ud37c\uc990\uc744 \ub9c8\uc2a4\ud130\ud558\uae30 \uc704\ud55c \uc8fc\uc694 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc5b8\ud37c\uc990 \ub9c8\uc2a4\ud130 \ud0ed \uc5b4\uc6e8\uc774\uc5d0\uc11c \uace0\uae09 \ud37c\uc990\uc744 \ub9c8\uc2a4\ud130\ud558\ub824\uba74 \uc5ec\ub7ec \uc804\ub7b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4: 1\ub2e8\uacc4 \u2013 \ud575\uc2ec \uc694\uc18c\ub97c \uc2dd\ubcc4\ud558\uae30 \uc704\ud574 \ud37c\uc990 \ub808\uc774\uc544\uc6c3\uc744 \ubd84\uc11d\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4 \u2013 \uc7a0\uc7ac\uc801\uc778 \ube14\ub85d \uc0c1\ud638 \uc791\uc6a9\uc744 \uace0\ub824\ud558\uc5ec \ubbf8\ub9ac \uc6c0\uc9c1\uc784\uc744 \uacc4\ud68d\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4 \u2013 \ud544\uc694\uc5d0 \ub530\ub77c \uc870\uc815\ud558\uba74\uc11c \ud6a8\uc728\uc801\uc73c\ub85c \uacc4\ud68d\uc744 \uc2e4\ud589\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 60\uc5d0\uc11c\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uc8fc\uc778\uacf5\uc744 \uc704\ud55c \uacbd\ub85c\ub97c \ub9cc\ub4e4\uae30 \uc704\ud574 \ube14\ub85d\uc744 \ubbf8\ub044\ub7ec\uc9c0\uac8c \ud558\uace0 \ud68c\uc804\uc2dc\ud0a4\ub294 \uc870\ud569\uc744 \uc0ac\uc6a9\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc811\uadfc \ubc29\uc2dd\uc740 \ubcf5\uc7a1\ud55c \ud37c\uc990\uc5d0\uc11c \uc131\uacf5\ub960\uc744 \ub192\uc785\ub2c8\ub2e4."}, {"question": "\uc5b8\ud37c\uc990 \ub9c8\uc2a4\ud130 \ud0ed \uc5b4\uc6e8\uc774 \uac8c\uc784\uc758 \ud575\uc2ec\uc744 \uc774\ud574\ud558\ub294 \ub370 \uac00\uc7a5 \uc911\uc694\ud55c \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc5b8\ud37c\uc990 \ub9c8\uc2a4\ud130 \ud0ed \uc5b4\uc6e8\uc774\uc758 \ud575\uc2ec \uba54\ucee4\ub2c8\uc998\uc740 \ube14\ub85d \uc774\ub3d9, \ud68c\uc804 \ubc0f \ud658\uacbd \uc694\uc18c\uc640\uc758 \uc0c1\ud638 \uc791\uc6a9\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ube14\ub85d\uc744 \ud68c\uc804\ud558\uba74 \ubc29\ud5a5\uc774 \ubc14\ub00c\uc5b4 \ud2b9\uc815 \uacf5\uac04\uc5d0 \ub9de\uac8c \uc870\uc815\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \ud37c\uc990\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \ud478\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \ube14\ub85d \uc720\ud615\uacfc \uc0c1\ud638 \uc791\uc6a9\uc744 \ube44\uad50\ud558\ub294 \uad6c\uc131\ud45c\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uc774\ub7ec\ud55c \uac1c\ub150\uc744 \ub354 \ud6a8\uacfc\uc801\uc73c\ub85c \uc774\ud574\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc5b8\ud37c\uc990 \ub9c8\uc2a4\ud130 \ud0ed \uc5b4\uc6e8\uc774\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uac8c\uc784 \ud50c\ub808\uc774 \uacb0\uc815\uc5d0 \uc5b4\ub5bb\uac8c \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\uc5b8\ud37c\uc990 \ub9c8\uc2a4\ud130 \ud0ed \uc5b4\uc6e8\uc774\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\ub294 \ub370 \uac78\ub9b0 \uc2dc\uac04\uacfc \uc6c0\uc9c1\uc784 \uc218\uc5d0 \ub530\ub77c \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 30\uc744 \ub35c \uc6c0\uc9c1\uc774\uace0 \ub35c \uc2dc\uac04\uc744 \ub4e4\uc5ec \uc644\ub8cc\ud558\uba74 \ub354 \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc2b5\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc804\ub7b5\uc744 \ucd5c\uc801\ud654\ud558\uace0 \ubd88\ud544\uc694\ud55c \ud589\ub3d9\uc744 \uc904\uc774\ub3c4\ub85d \uc7a5\ub824\ud569\ub2c8\ub2e4. \uc810\uc218 \uae30\uc900\uc744 \ubcf4\uc5ec\uc8fc\ub294 \ud50c\ub85c\uc6b0\ucc28\ud2b8\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uac8c\uc784 \ud50c\ub808\uc774 \uc911\uc5d0 \uc815\ubcf4\uc5d0 \uc785\uac01\ud55c \uacb0\uc815\uc744 \ub0b4\ub9ac\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ubaa8\ubc14\uc77c \ubc0f PC \ubc84\uc804\uc758 \uc5b8\ud37c\uc990 \ub9c8\uc2a4\ud130 \ud0ed \uc5b4\uc6e8\uc774 \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc758 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubaa8\ubc14\uc77c \ubc0f PC \ubc84\uc804\uc758 \uc5b8\ud37c\uc990 \ub9c8\uc2a4\ud130 \ud0ed \uc5b4\uc6e8\uc774\ub294 \uc11c\ub85c \ub2e4\ub978 \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ubaa8\ubc14\uc77c\uc5d0\uc11c\ub294 \ud130\uce58 \uae30\ubc18 \ucee8\ud2b8\ub864\uc744 \ud1b5\ud574 \ud37c\uc990\uacfc \ub354 \uc9c1\uad00\uc801\uc73c\ub85c \uc0c1\ud638 \uc791\uc6a9\ud560 \uc218 \uc788\uace0 PC \ubc84\uc804\uc740 \ub9c8\uc6b0\uc2a4 \ud074\ub9ad\uc73c\ub85c \uc815\ubc00\uc131\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubaa8\ubc14\uc77c\uc5d0\uc11c \ub808\ubca8 20\uc740 \uc9c1\uc811\uc801\uc778 \ud130\uce58 \uc785\ub825\uc73c\ub85c \uc778\ud574 \ub354 \uc6d0\ud65c\ud558\uac8c \ub290\uaef4\uc9c8 \uc218 \uc788\uc9c0\ub9cc, PC\uc5d0\uc11c\ub294 \ub3d9\uc77c\ud55c \ub808\ubca8\uc5d0\uc11c \uc815\ud655\ud55c \ucee4\uc11c \uc6c0\uc9c1\uc784\uc744 \ud1b5\ud574 \uc774\uc810\uc744 \uc5bb\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ube44\uad50\ub294 \uac8c\uc784\uc774 \ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc801\uc751\ub825\uc774 \uc788\uc74c\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4."}, {"question": "\ud50c\ub808\uc774\uc5b4\ub294 \uc5b8\ud37c\uc990 \ub9c8\uc2a4\ud130 \ud0ed \uc5b4\uc6e8\uc774\uc5d0\uc11c \uc5b4\ub5bb\uac8c \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc5b8\ud37c\uc990 \ub9c8\uc2a4\ud130 \ud0ed \uc5b4\uc6e8\uc774\uc5d0\uc11c \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \ucc3e\uc73c\ub824\uba74 \ub54c\ub85c\ub294 \uba85\ud655\ud558\uc9c0 \uc54a\uc740 \uacbd\ub85c\ub97c \ud0d0\uc0c9\ud558\uace0 \uc120\ud0dd\uc801 \ud37c\uc990\uc744 \ud480\uc5b4\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 50\uc5d0\uc11c\ub294 \uc8fc \ub808\ubca8 \ub0b4\uc758 \ubcf4\uc870 \ud37c\uc990\uc744 \ud480\uc5b4 \uc228\uaca8\uc9c4 \ubcf4\ub108\uc2a4 \uc601\uc5ed\uc744 \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \ucf58\ud150\uce20\uc5d0\ub294 \ucd94\uac00 \ub77c\uc774\ud504, \ud30c\uc6cc\uc5c5 \ub610\ub294 \ub3c5\ud2b9\ud55c \ucc4c\ub9b0\uc9c0\uac00 \ud3ec\ud568\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uc694\uc18c\ub97c \ucc3e\ub294 \ub2e8\uacc4\ubcc4 \uac00\uc774\ub4dc\ub294 \uc804\uccb4 \uac8c\uc784 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc7a5\uce58\ub97c \ubcc0\uacbd\ud560 \ub54c \uc5b8\ud37c\uc990 \ub9c8\uc2a4\ud130 \ud0ed \uc5b4\uc6e8\uc774\uc5d0\uc11c \ub370\uc774\ud130 \ub9c8\uc774\uadf8\ub808\uc774\uc158\uc744 \uc704\ud55c \ucd5c\uc120\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc5b8\ud37c\uc990 \ub9c8\uc2a4\ud130 \ud0ed \uc5b4\uc6e8\uc774\uc5d0\uc11c \ub370\uc774\ud130\ub97c \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud558\ub824\uba74 \ub450 \uc7a5\uce58 \ubaa8\ub450\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc548\ub4dc\ub85c\uc774\ub4dc \ud734\ub300\uc804\ud654\uc5d0\uc11c iPad\ub85c \uc774\ub3d9\ud558\ub294 \uacbd\uc6b0 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4 \u2013 \ud604\uc7ac \uc7a5\uce58\uc5d0\uc11c \uac8c\uc784\uc744 \uc5f4\uace0 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4 \u2013 \uc0c8 \uc7a5\uce58\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4 \u2013 \uc800\uc7a5\ub41c \ub370\uc774\ud130\ub97c \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \uc6d0\ud65c\ud558\uac8c \uc774\uc5b4\ub098\uac11\ub2c8\ub2e4."}, {"question": "\uac8c\uc784\uc758 \uc2dc\uac01 \ubc0f \uccad\uac01 \ud050\ub294 \uc5b8\ud37c\uc990 \ub9c8\uc2a4\ud130 \ud0ed \uc5b4\uc6e8\uc774\uc5d0\uc11c \ud37c\uc990 \ud480\uc774 \uacbd\ud5d8\uc744 \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\uae4c?", "answer": "\uc5b8\ud37c\uc990 \ub9c8\uc2a4\ud130 \ud0ed \uc5b4\uc6e8\uc774\uc5d0\uc11c \uc2dc\uac01 \ubc0f \uccad\uac01 \ud050\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \ud37c\uc990\uc744 \ud1b5\ud574 \uc548\ub0b4\ud558\ub294 \ub370 \uc911\uc694\ud55c \uc5ed\ud560\uc744 \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ube5b\ub098\ub294 \ube14\ub85d\uc740 \uc774\ub3d9 \uac00\ub2a5\ud568\uc744 \ub098\ud0c0\ub0b4\uace0 \ud2b9\uc815 \uc0ac\uc6b4\ub4dc \ud6a8\uacfc\ub294 \uc62c\ubc14\ub978 \uc6c0\uc9c1\uc784\uc744 \uc54c\ub9bd\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud050\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uc815\ubcf4\uc5d0 \uc785\uac01\ud55c \uacb0\uc815\uc744 \ub0b4\ub9ac\uace0 \uc804\uccb4 \ubab0\uc785\uac10\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \ub2e4\ub978 \ud050\uc640 \uadf8 \uc758\ubbf8\ub97c \ube44\uad50\ud558\ub294 \ud45c\ub294 \ud37c\uc990\uc744 \ube60\ub974\uac8c \ud574\uacb0\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uc2dc\uac04 \uc81c\ud55c \ud37c\uc990\uc744 \uc5b8\ud37c\uc990 \ub9c8\uc2a4\ud130 \ud0ed \uc5b4\uc6e8\uc774\uc5d0\uc11c \ud574\uacb0\ud558\uae30 \uc704\ud55c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \uae30\uc220\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc5b8\ud37c\uc990 \ub9c8\uc2a4\ud130 \ud0ed \uc5b4\uc6e8\uc774\uc5d0\uc11c \uc2dc\uac04 \uc81c\ud55c \ud37c\uc990\uc744 \ud574\uacb0\ud558\ub824\uba74 \uc2e0\uc18d\ud55c \uc0ac\uace0\uc640 \ud6a8\uc728\uc801\uc778 \uc2e4\ud589\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 75\uc5d0\uc11c\ub294 \ud50c\ub808\uc774\uc5b4\uac00 30\ucd08 \uc548\uc5d0 \uc77c\ub828\uc758 \uc6c0\uc9c1\uc784\uc744 \uc644\ub8cc\ud574\uc57c \ud569\ub2c8\ub2e4. \uae30\uc220\uc5d0\ub294 \ub2e4\uc74c\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4: 1\ub2e8\uacc4 \u2013 \ubbf8\ub9ac \ud37c\uc990 \ub808\uc774\uc544\uc6c3\uc744 \uc219\uc9c0\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4 \u2013 \uc5ec\ub7ec \uacbd\ub85c\ub97c \uc5f4 \uc218 \uc788\ub294 \uc6c0\uc9c1\uc784\uc744 \uc6b0\uc120\uc2dc\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4 \u2013 \ubc18\uc751 \uc2dc\uac04\uc744 \uc904\uc774\uae30 \uc704\ud574 \uc2dc\ud000\uc2a4\ub97c \uc5ec\ub7ec \ubc88 \uc5f0\uc2b5\ud569\ub2c8\ub2e4. \uc774 \ubc29\ubc95\uc740 \uae34\uae09\ud55c \uc0c1\ud669\uc5d0\uc11c \uc131\uacf5\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}]
[{"question": "\u042f\u043a \u044f \u043c\u043e\u0436\u0443 \u0448\u0432\u0438\u0434\u043a\u043e \u0440\u043e\u0437\u043f\u043e\u0447\u0430\u0442\u0438 \u0440\u043e\u0431\u043e\u0442\u0443 \u0437 ColorUp \u044f\u043a \u043d\u043e\u0432\u0430\u0447\u043e\u043a?", "answer": "\u0429\u043e\u0431 \u0440\u043e\u0437\u043f\u043e\u0447\u0430\u0442\u0438 \u0440\u043e\u0431\u043e\u0442\u0443 \u0437 ColorUp, \u0441\u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u043e\u0437\u043d\u0430\u0439\u043e\u043c\u0442\u0435\u0441\u044f \u0437 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c\u0438 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f\u043c\u0438. \u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c, \u0449\u043e\u0431 \u0432\u0438\u0431\u0440\u0430\u0442\u0438 \u043a\u043e\u043b\u044c\u043e\u0440\u0438, \u0456 \u043f\u0440\u043e\u0432\u0435\u0434\u0456\u0442\u044c \u043f\u0430\u043b\u044c\u0446\u0435\u043c, \u0449\u043e\u0431 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u0432\u0430\u0442\u0438 \u0457\u0445 \u0434\u043e \u0441\u0456\u0442\u043a\u0438. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0443 \u043f\u0435\u0440\u0448\u043e\u043c\u0443 \u0440\u0456\u0432\u043d\u0456 \u0432\u0438 \u043f\u043e\u0431\u0430\u0447\u0438\u0442\u0435 \u0441\u0456\u0442\u043a\u0443 3\u04453 \u0456\u0437 \u043a\u0456\u043b\u044c\u043a\u043e\u043c\u0430 \u0437\u0430\u0444\u0430\u0440\u0431\u043e\u0432\u0430\u043d\u0438\u043c\u0438 \u043a\u043b\u0456\u0442\u0438\u043d\u043a\u0430\u043c\u0438. \u0412\u0430\u0448\u0430 \u043c\u0435\u0442\u0430 \u2013 \u0437\u0430\u043f\u043e\u0432\u043d\u0438\u0442\u0438 \u0432\u0441\u044e \u0441\u0456\u0442\u043a\u0443 \u043e\u0434\u043d\u0438\u043c \u043a\u043e\u043b\u044c\u043e\u0440\u043e\u043c, \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0447\u043d\u043e \u0437\u0430\u0441\u0442\u043e\u0441\u043e\u0432\u0443\u044e\u0447\u0438 \u043a\u043e\u043b\u044c\u043e\u0440\u0438. \u041f\u043e\u0447\u043d\u0456\u0442\u044c \u0437 \u0444\u043e\u043a\u0443\u0441\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u043a\u0443\u0442\u0430\u0445 \u0456 \u043a\u0440\u0430\u044f\u0445, \u0449\u043e\u0431 \u043c\u0430\u043a\u0441\u0438\u043c\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u043f\u043e\u043a\u0440\u0438\u0442\u0442\u044f. \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u043a\u043d\u043e\u043f\u043a\u0443 \u0432\u0456\u0434\u043c\u0456\u043d\u0438, \u044f\u043a\u0449\u043e \u0437\u0440\u043e\u0431\u0438\u0442\u0435 \u043f\u043e\u043c\u0438\u043b\u043a\u0443. \u041f\u0430\u043c'\u044f\u0442\u0430\u0439\u0442\u0435, \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0430 \u2013 \u0446\u0435 \u0448\u043b\u044f\u0445 \u0434\u043e \u0434\u043e\u0441\u043a\u043e\u043d\u0430\u043b\u043e\u0441\u0442\u0456!"}, {"question": "\u0427\u043e\u043c\u0443 ColorUp \u0432\u0438\u043c\u0430\u0433\u0430\u0454 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0447\u043d\u043e\u0433\u043e \u043f\u043b\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0441\u043a\u043b\u0430\u0434\u043d\u0438\u0445 \u0440\u0456\u0432\u043d\u044f\u0445?", "answer": "\u041d\u0430 \u0441\u043a\u043b\u0430\u0434\u043d\u0438\u0445 \u0440\u0456\u0432\u043d\u044f\u0445 ColorUp \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0447\u043d\u0435 \u043f\u043b\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u0454 \u043a\u0440\u0438\u0442\u0438\u0447\u043d\u043e \u0432\u0430\u0436\u043b\u0438\u0432\u0438\u043c \u0447\u0435\u0440\u0435\u0437 \u0437\u0431\u0456\u043b\u044c\u0448\u0435\u043d\u043d\u044f \u0441\u043a\u043b\u0430\u0434\u043d\u043e\u0441\u0442\u0456 \u0441\u0456\u0442\u043a\u0438 \u0442\u0430 \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u0443 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u0445\u043e\u0434\u0456\u0432. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043d\u0430 \u0440\u0456\u0432\u043d\u0456 50, \u0432\u0438 \u0437\u0443\u0441\u0442\u0440\u0456\u043d\u0435\u0442\u0435 \u0441\u0456\u0442\u043a\u0443 5\u04455 \u0437 \u0434\u0435\u043a\u0456\u043b\u044c\u043a\u043e\u043c\u0430 \u0437\u043e\u043d\u0430\u043c\u0438 \u043a\u043e\u043b\u044c\u043e\u0440\u0456\u0432. \u0429\u043e\u0431 \u0432\u0438\u0440\u0456\u0448\u0438\u0442\u0438 \u0446\u0435, \u0432\u0430\u043c \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u043e \u0441\u043f\u043b\u0430\u043d\u0443\u0432\u0430\u0442\u0438 \u0441\u0432\u043e\u0457 \u0445\u043e\u0434\u0438 \u0443 \u0437\u0432\u043e\u0440\u043e\u0442\u043d\u043e\u043c\u0443 \u043f\u043e\u0440\u044f\u0434\u043a\u0443. \u041a\u0440\u043e\u043a 1: \u0412\u0438\u0437\u043d\u0430\u0447\u0442\u0435 \u0434\u043e\u043c\u0456\u043d\u0443\u044e\u0447\u0443 \u0437\u043e\u043d\u0443 \u043a\u043e\u043b\u044c\u043e\u0440\u0443. \u041a\u0440\u043e\u043a 2: \u0420\u043e\u0431\u0456\u0442\u044c \u0437\u0432\u043e\u0440\u043e\u0442\u043d\u0456 \u0434\u0456\u0457 \u0449\u043e\u0434\u043e \u043a\u043e\u043b\u044c\u043e\u0440\u0443 \u043c\u0435\u0442\u0438. \u041a\u0440\u043e\u043a 3: \u0417\u0430\u0441\u0442\u043e\u0441\u043e\u0432\u0443\u0439\u0442\u0435 \u043a\u043e\u043b\u044c\u043e\u0440\u0438, \u044f\u043a\u0456 \u043e\u0431'\u0454\u0434\u043d\u0430\u044e\u0442\u044c \u043c\u0435\u043d\u0448\u0456 \u0437\u043e\u043d\u0438 \u0432 \u0434\u043e\u043c\u0456\u043d\u0443\u044e\u0447\u0443. \u0426\u0435\u0439 \u043c\u0435\u0442\u043e\u0434 \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0443\u0454 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0456\u0441\u0442\u044c \u0442\u0430 \u0434\u043e\u043f\u043e\u043c\u0430\u0433\u0430\u0454 \u0432\u0430\u043c \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0438 \u0440\u0456\u0432\u0435\u043d\u044c \u0443 \u043c\u0435\u0436\u0430\u0445 \u043b\u0456\u043c\u0456\u0442\u0443 \u0445\u043e\u0434\u0456\u0432."}, {"question": "\u042f\u043a\u0456 \u043a\u043b\u044e\u0447\u043e\u0432\u0456 \u043c\u0435\u0445\u0430\u043d\u0456\u043a\u0438 \u0432 ColorUp \u0432\u043f\u043b\u0438\u0432\u0430\u044e\u0442\u044c \u043d\u0430 \u0433\u0435\u0439\u043c\u043f\u043b\u0435\u0439?", "answer": "\u0413\u0435\u0439\u043c\u043f\u043b\u0435\u0439 \u0443 ColorUp \u0432\u043f\u043b\u0438\u0432\u0430\u044e\u0442\u044c \u043a\u0456\u043b\u044c\u043a\u0430 \u043a\u043b\u044e\u0447\u043e\u0432\u0438\u0445 \u043c\u0435\u0445\u0430\u043d\u0456\u043a: \u0440\u043e\u0437\u043c\u0456\u0440 \u0441\u0456\u0442\u043a\u0438, \u0437\u043e\u043d\u0438 \u043a\u043e\u043b\u044c\u043e\u0440\u0456\u0432 \u0442\u0430 \u043b\u0456\u043c\u0456\u0442 \u0445\u043e\u0434\u0456\u0432. \u0420\u043e\u0437\u043c\u0456\u0440 \u0441\u0456\u0442\u043a\u0438 \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u0454 \u0441\u043a\u043b\u0430\u0434\u043d\u0456\u0441\u0442\u044c, \u0432\u0435\u043b\u0438\u043a\u0456 \u0440\u043e\u0437\u043c\u0456\u0440\u0438 \u0441\u0456\u0442\u043e\u043a \u0432\u0438\u043c\u0430\u0433\u0430\u044e\u0442\u044c \u0431\u0456\u043b\u044c\u0448 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0447\u043d\u043e\u0433\u043e \u043f\u043b\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f. \u0417\u043e\u043d\u0438 \u043a\u043e\u043b\u044c\u043e\u0440\u0456\u0432 \u2013 \u0446\u0435 \u0434\u0456\u043b\u044f\u043d\u043a\u0438 \u0441\u0456\u0442\u043a\u0438, \u0437'\u0454\u0434\u043d\u0430\u043d\u0456 \u0442\u0438\u043c \u0441\u0430\u043c\u0438\u043c \u043a\u043e\u043b\u044c\u043e\u0440\u043e\u043c, \u0430 \u0437\u043b\u0438\u0442\u0442\u044f \u0446\u0438\u0445 \u0437\u043e\u043d \u0454 \u0432\u0430\u0436\u043b\u0438\u0432\u0438\u043c \u0434\u043b\u044f \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0443. \u041e\u0431\u043c\u0435\u0436\u0435\u043d\u043d\u044f \u0445\u043e\u0434\u0456\u0432 \u0434\u043e\u0434\u0430\u044e\u0442\u044c \u0448\u0430\u0440 \u0441\u043a\u043b\u0430\u0434\u043d\u043e\u0441\u0442\u0456, \u0437\u043c\u0443\u0448\u0443\u044e\u0447\u0438 \u0433\u0440\u0430\u0432\u0446\u0456\u0432 \u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0441\u0432\u043e\u0457 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0457. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043d\u0430 \u0440\u0456\u0432\u043d\u0456 30, \u0441\u0456\u0442\u043a\u0430 4\u04454 \u0437 \u0447\u043e\u0442\u0438\u0440\u043c\u0430 \u0437\u043e\u043d\u0430\u043c\u0438 \u043a\u043e\u043b\u044c\u043e\u0440\u0456\u0432 \u0432\u0438\u043c\u0430\u0433\u0430\u0454 \u0442\u043e\u0447\u043d\u0438\u0445 \u0445\u043e\u0434\u0456\u0432, \u0449\u043e\u0431 \u043e\u0431'\u0454\u0434\u043d\u0430\u0442\u0438 \u0432\u0441\u0456 \u0437\u043e\u043d\u0438 \u0432 \u043e\u0434\u043d\u0443 \u0437\u0430 15 \u0445\u043e\u0434\u0456\u0432."}, {"question": "\u042f\u043a \u044f \u043c\u043e\u0436\u0443 \u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u0445\u043e\u0434\u0456\u0432 \u043d\u0430 \u0431\u0456\u043b\u044c\u0448 \u0432\u0438\u0441\u043e\u043a\u0438\u0445 \u0440\u0456\u0432\u043d\u044f\u0445 ColorUp?", "answer": "\u041e\u043f\u0442\u0438\u043c\u0456\u0437\u0430\u0446\u0456\u044f \u043a\u0456\u043b\u044c\u043a\u043e\u0441\u0442\u0456 \u0445\u043e\u0434\u0456\u0432 \u043d\u0430 \u0431\u0456\u043b\u044c\u0448 \u0432\u0438\u0441\u043e\u043a\u0438\u0445 \u0440\u0456\u0432\u043d\u044f\u0445 ColorUp \u0432\u043a\u043b\u044e\u0447\u0430\u0454 \u043a\u0456\u043b\u044c\u043a\u0430 \u043a\u043b\u044e\u0447\u043e\u0432\u0438\u0445 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0439. \u041a\u0440\u043e\u043a 1: \u041f\u0440\u043e\u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0439\u0442\u0435 \u0441\u0456\u0442\u043a\u0443, \u0449\u043e\u0431 \u0432\u0438\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448\u0443 \u0437\u043e\u043d\u0443 \u043a\u043e\u043b\u044c\u043e\u0440\u0443. \u041a\u0440\u043e\u043a 2: \u0421\u043f\u043b\u0430\u043d\u0443\u0439\u0442\u0435 \u0441\u0432\u043e\u0457 \u0445\u043e\u0434\u0438, \u0449\u043e\u0431 \u043e\u0431'\u0454\u0434\u043d\u0430\u0442\u0438 \u043c\u0435\u043d\u0448\u0456 \u0437\u043e\u043d\u0438 \u0432 \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448\u0443. \u041a\u0440\u043e\u043a 3: \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0444\u0443\u043d\u043a\u0446\u0456\u044e \u0432\u0456\u0434\u043c\u0456\u043d\u0438, \u044f\u043a\u0449\u043e \u0445\u0456\u0434 \u043d\u0435 \u0454 \u043a\u043e\u0440\u0438\u0441\u043d\u0438\u043c \u0434\u043b\u044f \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u043c\u0435\u0442\u0438. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043d\u0430 \u0440\u0456\u0432\u043d\u0456 75, \u0441\u0456\u0442\u043a\u0430 6\u04456 \u0437 \u0448\u0456\u0441\u0442\u044c\u043c\u0430 \u0437\u043e\u043d\u0430\u043c\u0438 \u043a\u043e\u043b\u044c\u043e\u0440\u0456\u0432 \u043c\u043e\u0436\u0435 \u0431\u0443\u0442\u0438 \u0440\u043e\u0437\u0432'\u044f\u0437\u0430\u043d\u0430 \u0437\u0430 20 \u0445\u043e\u0434\u0456\u0432, \u0444\u043e\u043a\u0443\u0441\u0443\u044e\u0447\u0438\u0441\u044c \u043d\u0430 \u0437\u043b\u0438\u0442\u0442\u0456 \u0437\u043e\u043d \u043f\u043e \u0434\u0456\u0430\u0433\u043e\u043d\u0430\u043b\u0456, \u0449\u043e \u0447\u0430\u0441\u0442\u043e \u043e\u0445\u043e\u043f\u043b\u044e\u0454 \u0431\u0456\u043b\u044c\u0448\u0435 \u043a\u043b\u0456\u0442\u0438\u043d\u043e\u043a \u0437\u0430 \u043e\u0434\u0438\u043d \u0445\u0456\u0434."}, {"question": "\u042f\u043a\u0456 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0457 \u0454 \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448 \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0438\u043c\u0438 \u0434\u043b\u044f \u0432\u0438\u0440\u0456\u0448\u0435\u043d\u043d\u044f \u0440\u0456\u0432\u043d\u0456\u0432 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043e\u043a ColorUp?", "answer": "\u0415\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0456 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0457 \u0434\u043b\u044f \u0432\u0438\u0440\u0456\u0448\u0435\u043d\u043d\u044f \u0440\u0456\u0432\u043d\u0456\u0432 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043e\u043a ColorUp \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442\u044c \u0444\u043e\u043a\u0443\u0441\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u043a\u0443\u0442\u0430\u0445, \u0437\u043b\u0438\u0442\u0442\u044f \u0437\u043e\u043d \u0442\u0430 \u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0430\u0446\u0456\u044e \u0445\u043e\u0434\u0456\u0432. \u0424\u043e\u043a\u0443\u0441\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u043a\u0443\u0442\u0430\u0445 \u043f\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0430\u0454 \u043f\u043e\u0447\u0430\u0442\u043e\u043a \u0444\u0430\u0440\u0431\u0443\u0432\u0430\u043d\u043d\u044f \u043a\u043e\u043b\u044c\u043e\u0440\u043e\u043c \u0437 \u043a\u0443\u0442\u0456\u0432 \u0434\u043b\u044f \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043e\u0445\u043e\u043f\u043b\u0435\u043d\u043d\u044f. \u0417\u043b\u0438\u0442\u0442\u044f \u0437\u043e\u043d \u0432\u0438\u043c\u0430\u0433\u0430\u0454 \u0456\u0434\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0430\u0446\u0456\u0457 \u0442\u0430 \u043e\u0431'\u0454\u0434\u043d\u0430\u043d\u043d\u044f \u043c\u0435\u043d\u0448\u0438\u0445 \u0437\u043e\u043d \u043a\u043e\u043b\u044c\u043e\u0440\u0456\u0432 \u0432 \u0431\u0456\u043b\u044c\u0448\u0456. \u041e\u043f\u0442\u0438\u043c\u0456\u0437\u0430\u0446\u0456\u044f \u0445\u043e\u0434\u0456\u0432 \u043e\u0437\u043d\u0430\u0447\u0430\u0454 \u043f\u043b\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u043a\u043e\u0436\u043d\u043e\u0433\u043e \u0445\u043e\u0434\u0443, \u0449\u043e\u0431 \u0432\u0456\u043d \u043d\u0430\u043f\u0440\u044f\u043c\u0443 \u0441\u043f\u0440\u0438\u044f\u0432 \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044e \u043c\u0435\u0442\u0438. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043d\u0430 \u0440\u0456\u0432\u043d\u0456 60, \u0441\u0456\u0442\u043a\u0430 5\u04455 \u0437 \u043f'\u044f\u0442\u044c\u043c\u0430 \u0437\u043e\u043d\u0430\u043c\u0438 \u043a\u043e\u043b\u044c\u043e\u0440\u0456\u0432 \u043c\u043e\u0436\u0435 \u0431\u0443\u0442\u0438 \u0440\u043e\u0437\u0432'\u044f\u0437\u0430\u043d\u0430 \u0448\u043b\u044f\u0445\u043e\u043c \u043f\u043e\u0447\u0430\u0442\u043a\u043e\u0432\u043e\u0433\u043e \u0437\u043b\u0438\u0442\u0442\u044f \u0437\u043e\u043d \u0443 \u0432\u0435\u0440\u0445\u043d\u044c\u043e\u043c\u0443 \u043b\u0456\u0432\u043e\u043c\u0443 \u0442\u0430 \u043d\u0438\u0436\u043d\u044c\u043e\u043c\u0443 \u043f\u0440\u0430\u0432\u043e\u043c\u0443 \u043a\u0443\u0442\u0430\u0445, \u0430 \u043f\u043e\u0442\u0456\u043c \u0437\u0430\u043f\u043e\u0432\u043d\u0435\u043d\u043d\u044f \u0437\u0430\u043b\u0438\u0448\u043a\u0456\u0432 \u043a\u043b\u0456\u0442\u0438\u043d\u043e\u043a."}, {"question": "\u042f\u043a\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u043c\u0430\u044e\u0442\u044c \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u043d\u044f \u0445\u043e\u0434\u0456\u0432 \u0443 \u0434\u0438\u0437\u0430\u0439\u043d\u0456 \u0433\u0440\u0438 ColorUp?", "answer": "\u041e\u0431\u043c\u0435\u0436\u0435\u043d\u043d\u044f \u0445\u043e\u0434\u0456\u0432 \u0443 ColorUp \u043f\u0440\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u0456 \u0434\u043b\u044f \u0434\u043e\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0447\u043d\u043e\u0457 \u0433\u043b\u0438\u0431\u0438\u043d\u0438 \u0442\u0430 \u0441\u043a\u043b\u0430\u0434\u043d\u043e\u0441\u0442\u0456. \u0412\u043e\u043d\u0438 \u0437\u043c\u0443\u0448\u0443\u044e\u0442\u044c \u0433\u0440\u0430\u0432\u0446\u0456\u0432 \u043a\u0440\u0438\u0442\u0438\u0447\u043d\u043e \u0434\u0443\u043c\u0430\u0442\u0438 \u043f\u0440\u043e \u043a\u043e\u0436\u0435\u043d \u0445\u0456\u0434 \u0442\u0430 \u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0441\u0432\u043e\u0457 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0457. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043d\u0430 \u0440\u0456\u0432\u043d\u0456 40, \u0441\u0456\u0442\u043a\u0430 4\u04454 \u0437 \u0447\u043e\u0442\u0438\u0440\u043c\u0430 \u0437\u043e\u043d\u0430\u043c\u0438 \u043a\u043e\u043b\u044c\u043e\u0440\u0456\u0432 \u0442\u0430 \u043b\u0456\u043c\u0456\u0442\u043e\u043c 12 \u0445\u043e\u0434\u0456\u0432 \u0432\u0438\u043c\u0430\u0433\u0430\u0454 \u0432\u0456\u0434 \u0433\u0440\u0430\u0432\u0446\u0456\u0432 \u0440\u0435\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u043b\u0430\u043d\u0443\u0432\u0430\u0442\u0438 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u0432\u0430\u043d\u043d\u044f \u043a\u043e\u043b\u044c\u043e\u0440\u0456\u0432 \u0434\u043b\u044f \u0435\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0437\u043b\u0438\u0442\u0442\u044f \u0432\u0441\u0456\u0445 \u0437\u043e\u043d. \u0426\u0435\u0439 \u043c\u0435\u0445\u0430\u043d\u0456\u0437\u043c \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0443\u0454 \u0442\u0435, \u0449\u043e \u0433\u0440\u0430\u0432\u0446\u0456 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u0438\u043f\u0430\u0434\u043a\u043e\u0432\u043e \u0444\u0430\u0440\u0431\u0443\u044e\u0442\u044c \u043a\u043e\u043b\u044c\u043e\u0440\u0430\u043c\u0438, \u0430 \u0431\u0435\u0440\u0443\u0442\u044c \u0443\u0447\u0430\u0441\u0442\u044c \u0443 \u0440\u043e\u0437\u0432\u0430\u0436\u043b\u0438\u0432\u043e\u043c\u0443 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0447\u043d\u043e\u043c\u0443 \u0433\u0435\u0439\u043c\u043f\u043b\u0435\u0457."}, {"question": "\u042f\u043a \u0440\u043e\u0437\u043c\u0456\u0440 \u0441\u0456\u0442\u043a\u0438 ColorUp \u0432\u043f\u043b\u0438\u0432\u0430\u0454 \u043d\u0430 \u0441\u043a\u043b\u0430\u0434\u043d\u0456\u0441\u0442\u044c \u043a\u043e\u0436\u043d\u043e\u0433\u043e \u0440\u0456\u0432\u043d\u044f?", "answer": "\u0420\u043e\u0437\u043c\u0456\u0440 \u0441\u0456\u0442\u043a\u0438 \u0443 ColorUp \u0431\u0435\u0437\u043f\u043e\u0441\u0435\u0440\u0435\u0434\u043d\u044c\u043e \u0432\u043f\u043b\u0438\u0432\u0430\u0454 \u043d\u0430 \u0441\u043a\u043b\u0430\u0434\u043d\u0456\u0441\u0442\u044c, \u0437\u0431\u0456\u043b\u044c\u0448\u0443\u044e\u0447\u0438 \u0441\u043a\u043b\u0430\u0434\u043d\u0456\u0441\u0442\u044c \u0456 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u043c\u043e\u0436\u043b\u0438\u0432\u0438\u0445 \u0445\u043e\u0434\u0456\u0432. \u0411\u0456\u043b\u044c\u0448\u0456 \u0441\u0456\u0442\u043a\u0438 \u0432\u0438\u043c\u0430\u0433\u0430\u044e\u0442\u044c \u0431\u0456\u043b\u044c\u0448 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0447\u043d\u043e\u0433\u043e \u043f\u043b\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u0430 \u0442\u043e\u0447\u043d\u043e\u0433\u043e \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u0432\u0430\u043d\u043d\u044f \u043a\u043e\u043b\u044c\u043e\u0440\u0456\u0432. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u0441\u0456\u0442\u043a\u0430 3\u04453 \u043d\u0430 \u0440\u0456\u0432\u043d\u0456 1 \u0434\u043e\u0441\u0438\u0442\u044c \u043f\u0440\u043e\u0441\u0442\u0430, \u0442\u043e\u0434\u0456 \u044f\u043a \u0441\u0456\u0442\u043a\u0430 6\u04456 \u043d\u0430 \u0440\u0456\u0432\u043d\u0456 80 \u0432\u0438\u043c\u0430\u0433\u0430\u0454 \u043f\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0445 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0439, \u0442\u0430\u043a\u0438\u0445 \u044f\u043a \u0437\u043b\u0438\u0442\u0442\u044f \u0437\u043e\u043d \u0442\u0430 \u043e\u043f\u0442\u0438\u043c\u0456\u0437\u0430\u0446\u0456\u044f \u0445\u043e\u0434\u0456\u0432. \u0417\u0431\u0456\u043b\u044c\u0448\u0435\u043d\u0430 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u043a\u043b\u0456\u0442\u0438\u043d\u043e\u043a \u0442\u0430 \u0437\u043e\u043d \u043a\u043e\u043b\u044c\u043e\u0440\u0456\u0432 \u0443 \u0431\u0456\u043b\u044c\u0448\u0438\u0445 \u0441\u0456\u0442\u043a\u0430\u0445 \u0443\u0441\u043a\u043b\u0430\u0434\u043d\u044e\u0454 \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u043c\u0435\u0442\u0438 \u0432 \u043c\u0435\u0436\u0430\u0445 \u043b\u0456\u043c\u0456\u0442\u0443 \u0445\u043e\u0434\u0456\u0432."}, {"question": "\u0427\u0438 \u043c\u043e\u0436\u0443 \u044f \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0442\u0438 \u0441\u0432\u0456\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441 \u0443 ColorUp \u043c\u0456\u0436 \u0440\u0456\u0437\u043d\u0438\u043c\u0438 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044f\u043c\u0438?", "answer": "\u0422\u0430\u043a, \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0442\u0438 \u0441\u0432\u0456\u0439 \u043f\u0440\u043e\u0433\u0440\u0435\u0441 \u0443 ColorUp \u043c\u0456\u0436 \u0440\u0456\u0437\u043d\u0438\u043c\u0438 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044f\u043c\u0438, \u043f\u0440\u0438\u0432'\u044f\u0437\u0430\u0432\u0448\u0438 \u0441\u0432\u0456\u0439 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441 \u0433\u0440\u0438 \u0434\u043e \u0445\u043c\u0430\u0440\u043d\u043e\u0433\u043e \u0441\u0435\u0440\u0432\u0456\u0441\u0443. \u0426\u0435 \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u0454 \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0456\u0437\u0443\u0432\u0430\u0442\u0438 \u0432\u0430\u0448 \u043f\u0440\u043e\u0433\u0440\u0435\u0441, \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u0442\u0430 \u0440\u043e\u0437\u0431\u043b\u043e\u043a\u043e\u0432\u0430\u043d\u0456 \u0440\u0456\u0432\u043d\u0456 \u043d\u0430 \u0440\u0456\u0437\u043d\u0438\u0445 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430\u0445. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u044f\u043a\u0449\u043e \u0432\u0438 \u043f\u043e\u0447\u0430\u043b\u0438 \u0433\u0440\u0430\u0442\u0438 \u043d\u0430 \u0441\u043c\u0430\u0440\u0442\u0444\u043e\u043d\u0456, \u0430 \u043f\u043e\u0442\u0456\u043c \u043f\u0435\u0440\u0435\u0439\u0448\u043b\u0438 \u043d\u0430 \u043f\u043b\u0430\u043d\u0448\u0435\u0442, \u043f\u0440\u043e\u0441\u0442\u043e \u0443\u0432\u0456\u0439\u0434\u0456\u0442\u044c \u0443 \u0441\u0432\u0456\u0439 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441 \u0443 \u0445\u043c\u0430\u0440\u0456 \u043d\u0430 \u043d\u043e\u0432\u043e\u043c\u0443 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u0457, \u0449\u043e\u0431 \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u0438 \u0437 \u0442\u043e\u0433\u043e \u043c\u0456\u0441\u0446\u044f, \u0434\u0435 \u0437\u0443\u043f\u0438\u043d\u0438\u043b\u0438\u0441\u044f. \u0426\u044f \u0444\u0443\u043d\u043a\u0446\u0456\u044f \u0433\u0430\u0440\u0430\u043d\u0442\u0443\u0454 \u0431\u0435\u0437\u0448\u043e\u0432\u043d\u0438\u0439 \u0433\u0435\u0439\u043c\u043f\u043b\u0435\u0439 \u043d\u0430 \u0432\u0441\u0456\u0445 \u0432\u0430\u0448\u0438\u0445 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044f\u0445."}, {"question": "\u0427\u0438 \u0454 \u0443 ColorUp \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 \u0444\u0443\u043d\u043a\u0446\u0456\u0457 \u0430\u0431\u043e \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0456 \u044f\u0439\u0446\u044f?", "answer": "\u0423 ColorUp \u0454 \u0434\u0435\u043a\u0456\u043b\u044c\u043a\u0430 \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0438\u0445 \u0444\u0443\u043d\u043a\u0446\u0456\u0439 \u0442\u0430 \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0438\u0445 \u044f\u0454\u0446\u044c, \u0449\u043e \u0434\u043e\u0434\u0430\u044e\u0442\u044c \u0434\u043e \u0437\u0430\u0434\u043e\u0432\u043e\u043b\u0435\u043d\u043d\u044f. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u044f\u043a\u0449\u043e \u0432\u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u0440\u0456\u0432\u0435\u043d\u044c \u0437 \u0456\u0434\u0435\u0430\u043b\u044c\u043d\u0438\u043c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c (\u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u044e\u0447\u0438 \u043c\u0456\u043d\u0456\u043c\u0430\u043b\u044c\u043d\u0443 \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u0445\u043e\u0434\u0456\u0432), \u0432\u0438 \u043c\u043e\u0436\u0435\u0442\u0435 \u0440\u043e\u0437\u0431\u043b\u043e\u043a\u0443\u0432\u0430\u0442\u0438 \u043e\u0441\u043e\u0431\u043b\u0438\u0432\u0435 \u0434\u043e\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u0430\u0431\u043e \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 \u0440\u0456\u0432\u043d\u0456. \u041a\u0440\u0456\u043c \u0442\u043e\u0433\u043e, \u0434\u0435\u044f\u043a\u0456 \u0440\u0456\u0432\u043d\u0456 \u043c\u0430\u044e\u0442\u044c \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0456 \u043a\u043e\u043b\u044c\u043e\u0440\u043e\u0432\u0456 \u0432\u0456\u0437\u0435\u0440\u0443\u043d\u043a\u0438, \u044f\u043a\u0456, \u044f\u043a\u0449\u043e \u0457\u0445 \u0440\u043e\u0437\u043a\u0440\u0438\u0442\u0438, \u043c\u043e\u0436\u0443\u0442\u044c \u043d\u0430\u0434\u0430\u0442\u0438 \u043f\u0456\u0434\u043a\u0430\u0437\u043a\u0438 \u0430\u0431\u043e \u0441\u043a\u043e\u0440\u043e\u0447\u0435\u043d\u043d\u044f \u0434\u043b\u044f \u0440\u043e\u0437\u0432'\u044f\u0437\u0430\u043d\u043d\u044f \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0438. \u0421\u0442\u0435\u0436\u0442\u0435 \u0437\u0430 \u0446\u0438\u043c\u0438 \u0442\u043e\u043d\u043a\u0438\u043c\u0438 \u0434\u0435\u0442\u0430\u043b\u044f\u043c\u0438 \u043f\u0456\u0434 \u0447\u0430\u0441 \u0433\u0440\u0438!"}, {"question": "\u042f\u043a \u043c\u0435\u0445\u0430\u043d\u0456\u043a\u0430 \u0437\u043e\u043d \u043a\u043e\u043b\u044c\u043e\u0440\u0456\u0432 ColorUp \u043f\u043e\u043a\u0440\u0430\u0449\u0443\u0454 \u0434\u043e\u0441\u0432\u0456\u0434 \u0440\u043e\u0437\u0432'\u044f\u0437\u0430\u043d\u043d\u044f \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043e\u043a?", "answer": "\u041c\u0435\u0445\u0430\u043d\u0456\u043a\u0430 \u0437\u043e\u043d \u043a\u043e\u043b\u044c\u043e\u0440\u0456\u0432 ColorUp \u043f\u043e\u043a\u0440\u0430\u0449\u0443\u0454 \u0434\u043e\u0441\u0432\u0456\u0434 \u0440\u043e\u0437\u0432'\u044f\u0437\u0430\u043d\u043d\u044f \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043e\u043a, \u0434\u043e\u0434\u0430\u044e\u0447\u0438 \u0448\u0430\u0440 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0447\u043d\u043e\u0457 \u0441\u043a\u043b\u0430\u0434\u043d\u043e\u0441\u0442\u0456. \u0417\u043e\u043d\u0438 \u043a\u043e\u043b\u044c\u043e\u0440\u0456\u0432 \u2013 \u0446\u0435 \u0437'\u0454\u0434\u043d\u0430\u043d\u0456 \u0434\u0456\u043b\u044f\u043d\u043a\u0438 \u0441\u0456\u0442\u043a\u0438 \u0437 \u0442\u0438\u043c \u0441\u0430\u043c\u0438\u043c \u043a\u043e\u043b\u044c\u043e\u0440\u043e\u043c, \u0430 \u0457\u0445 \u0437\u043b\u0438\u0442\u0442\u044f \u0454 \u0432\u0430\u0436\u043b\u0438\u0432\u0438\u043c \u0434\u043b\u044f \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0443. \u0426\u0435\u0439 \u043c\u0435\u0445\u0430\u043d\u0456\u0437\u043c \u0437\u0430\u043e\u0445\u043e\u0447\u0443\u0454 \u0433\u0440\u0430\u0432\u0446\u0456\u0432 \u043c\u0438\u0441\u043b\u0438\u0442\u0438 \u043f\u0440\u043e\u0441\u0442\u043e\u0440\u043e\u0432\u043e \u0442\u0430 \u0440\u0435\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u043b\u0430\u043d\u0443\u0432\u0430\u0442\u0438 \u0441\u0432\u043e\u0457 \u0445\u043e\u0434\u0438. \u041d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, \u043d\u0430 \u0440\u0456\u0432\u043d\u0456 20, \u0441\u0456\u0442\u043a\u0430 4\u04454 \u0437 \u0442\u0440\u044c\u043e\u043c\u0430 \u0437\u043e\u043d\u0430\u043c\u0438 \u043a\u043e\u043b\u044c\u043e\u0440\u0456\u0432 \u0432\u0438\u043c\u0430\u0433\u0430\u0454 \u0432\u0456\u0434 \u0433\u0440\u0430\u0432\u0446\u0456\u0432 \u043e\u0431'\u0454\u0434\u043d\u0430\u0442\u0438 \u043c\u0435\u043d\u0448\u0456 \u0437\u043e\u043d\u0438 \u0432 \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0449\u0443, \u0449\u043e \u043d\u0435 \u0442\u0456\u043b\u044c\u043a\u0438 \u0432\u0438\u0440\u0456\u0448\u0443\u0454 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0443, \u0430\u043b\u0435 \u0439 \u043d\u0430\u0432\u0447\u0430\u0454 \u043a\u043e\u0440\u0438\u0441\u043d\u0438\u043c \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u0447\u043d\u0438\u043c \u043d\u0430\u0432\u0438\u0447\u043a\u0430\u043c."}]
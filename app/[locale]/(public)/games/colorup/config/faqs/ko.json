[{"question": "\ucd08\ubcf4\uc790\ub85c\uc11c ColorUp\uc744 \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud558\ub098\uc694?", "answer": "ColorUp\uc744 \uc2dc\uc791\ud558\ub824\uba74 \uba3c\uc800 \uae30\ubcf8 \uc81c\uc5b4 \ubc29\ubc95\uc744 \uc219\uc9c0\ud558\uc138\uc694. \uc0c9\uc0c1\uc744 \uc120\ud0dd\ud558\ub824\uba74 \ud0ed\ud558\uace0, \uadf8\ub9ac\ub4dc\uc5d0 \uc801\uc6a9\ud558\ub824\uba74 \uc2a4 \uc640\uc774\ud504 \ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c\ub294 3x3 \uadf8\ub9ac\ub4dc\uc5d0 \uba87 \uac1c\uc758 \uc0c9\uce60\ub41c \ud0c0\uc77c\uc774 \ud45c\uc2dc\ub429\ub2c8\ub2e4. \uc804\ub7b5\uc801\uc73c\ub85c \uc0c9\uc0c1\uc744 \uc801\uc6a9\ud558\uc5ec \uc804\uccb4 \uadf8\ub9ac\ub4dc\ub97c \ub2e8\uc77c \uc0c9\uc0c1\uc73c\ub85c \ucc44\uc6b0\ub294 \uac83\uc774 \ubaa9\ud45c\uc785\ub2c8\ub2e4. \ubc94\uc704\ub97c \ucd5c\ub300\ud654\ud558\uae30 \uc704\ud574 \ubaa8\uc11c\ub9ac\uc640 \uac00\uc7a5\uc790\ub9ac\uc5d0 \uc9d1\uc911\ud558\uc5ec \uc2dc\uc791\ud558\uc138\uc694. \uc2e4\uc218\ub97c \ud558\uba74 \ub418\ub3cc\ub9ac\uae30 \ubc84\ud2bc\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. \uc5f0\uc2b5\uc774 \uc644\ubcbd\ud574\uc9c4\ub2e4\ub294 \uac83\uc744 \uae30\uc5b5\ud558\uc138\uc694!"}, {"question": "ColorUp\uc758 \uace0\uae09 \ub808\ubca8\uc5d0\uc11c \uc804\ub7b5\uc801\uc778 \uacc4\ud68d\uc774 \ud544\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "ColorUp\uc758 \uace0\uae09 \ub808\ubca8\uc5d0\uc11c\ub294 \uadf8\ub9ac\ub4dc\uc758 \ubcf5\uc7a1\uc131\uc774 \uc99d\uac00\ud558\uace0 \uc774\ub3d9 \ud69f\uc218\uac00 \uc81c\ud55c\ub418\uae30 \ub54c\ubb38\uc5d0 \uc804\ub7b5\uc801\uc778 \uacc4\ud68d\uc774 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 50\ub808\ubca8\uc5d0\uc11c\ub294 5x5 \uadf8\ub9ac\ub4dc\uc5d0 \uc5ec\ub7ec \uac1c\uc758 \uc0c9\uc0c1 \uc601\uc5ed\uc774 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \uc774\ub97c \ud574\uacb0\ud558\ub824\uba74 \uc5ed\uc21c\uc73c\ub85c \uc774\ub3d9\uc744 \uacc4\ud68d\ud574\uc57c \ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \uc8fc\uc694 \uc0c9\uc0c1 \uc601\uc5ed\uc744 \uc2dd\ubcc4\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \ubaa9\ud45c \uc0c9\uc0c1\uc5d0\uc11c \uc5ed\uc73c\ub85c \uc791\uc5c5\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \uc791\uc740 \uc601\uc5ed\uc744 \uc8fc\uc694 \uc601\uc5ed\uc73c\ub85c \ud569\uce60 \uc0c9\uc0c1\uc744 \uc801\uc6a9\ud569\ub2c8\ub2e4. \uc774 \ubc29\ubc95\uc740 \ud6a8\uc728\uc131\uc744 \ubcf4\uc7a5\ud558\uace0 \uc774\ub3d9 \uc81c\ud55c \ub0b4\uc5d0\uc11c \ub808\ubca8\uc744 \uc644\ub8cc\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "ColorUp\uc758 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc8fc\uc694 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "ColorUp\uc758 \uac8c\uc784 \ud50c\ub808\uc774\ub294 \uadf8\ub9ac\ub4dc \ud06c\uae30, \uc0c9\uc0c1 \uc601\uc5ed \ubc0f \uc774\ub3d9 \uc81c\ud55c\uacfc \uac19\uc740 \uc5ec\ub7ec \uc8fc\uc694 \uba54\ucee4\ub2c8\uc998\uc5d0 \uc758\ud574 \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \uadf8\ub9ac\ub4dc \ud06c\uae30\ub294 \ubcf5\uc7a1\uc131\uc744 \uacb0\uc815\ud558\uba70, \ub354 \ud070 \uadf8\ub9ac\ub4dc\ub294 \ub354 \ub9ce\uc740 \uc804\ub7b5\uc801 \uacc4\ud68d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc0c9\uc0c1 \uc601\uc5ed\uc740 \ub3d9\uc77c\ud55c \uc0c9\uc0c1\uc73c\ub85c \uc5f0\uacb0\ub41c \uadf8\ub9ac\ub4dc\uc758 \uc601\uc5ed\uc774\uba70, \uc774\ub7ec\ud55c \uc601\uc5ed\uc744 \ubcd1\ud569\ud558\ub294 \uac83\uc740 \uc9c4\ud589\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc774\ub3d9 \uc81c\ud55c\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc804\ub7b5\uc744 \ucd5c\uc801\ud654\ud558\ub3c4\ub85d \uac15\uc81c\ud558\uc5ec \ub3c4\uc804 \uc694\uc18c\ub97c \ucd94\uac00\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 30\ub808\ubca8\uc5d0\uc11c\ub294 4x4 \uadf8\ub9ac\ub4dc\uc5d0 \ub124 \uac1c\uc758 \uc0c9\uc0c1 \uc601\uc5ed\uc774 \uc788\uc73c\uba70, \ubaa8\ub4e0 \uc601\uc5ed\uc744 15\ud68c \uc774\ub3d9 \uc548\uc5d0 \ud558\ub098\ub85c \ubcd1\ud569\ud558\ub824\uba74 \uc815\ud655\ud55c \uc774\ub3d9\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."}, {"question": "ColorUp\uc758 \uace0\uae09 \ub808\ubca8\uc5d0\uc11c \uc774\ub3d9 \ud69f\uc218\ub97c \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "ColorUp\uc758 \uace0\uae09 \ub808\ubca8\uc5d0\uc11c \uc774\ub3d9 \ud69f\uc218\ub97c \ucd5c\uc801\ud654\ud558\ub294 \ub370\ub294 \uba87 \uac00\uc9c0 \uc8fc\uc694 \uc804\ub7b5\uc774 \uc788\uc2b5\ub2c8\ub2e4. 1\ub2e8\uacc4: \uac00\uc7a5 \ud070 \uc0c9\uc0c1 \uc601\uc5ed\uc744 \uc2dd\ubcc4\ud558\uae30 \uc704\ud574 \uadf8\ub9ac\ub4dc\ub97c \ubd84\uc11d\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \uc791\uc740 \uc601\uc5ed\uc744 \uac00\uc7a5 \ud070 \uc601\uc5ed\uc73c\ub85c \ubcd1\ud569\ud560 \uc218 \uc788\ub3c4\ub85d \uc774\ub3d9\uc744 \uacc4\ud68d\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \uc774\ub3d9\uc774 \ubaa9\ud45c\uc5d0 \uae30\uc5ec\ud558\uc9c0 \uc54a\uc73c\uba74 \ub418\ub3cc\ub9ac\uae30 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub418\ub3cc\ub9bd\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 75\ub808\ubca8\uc5d0\uc11c\ub294 6x6 \uadf8\ub9ac\ub4dc\uc5d0 \uc5ec\uc12f \uac1c\uc758 \uc0c9\uc0c1 \uc601\uc5ed\uc774 \uc788\uc73c\uba70, \ub300\uac01\uc120\uc73c\ub85c \uc601\uc5ed\uc744 \ubcd1\ud569\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uba74 \ud55c \ubc88\uc758 \uc774\ub3d9\uc73c\ub85c \ub354 \ub9ce\uc740 \ud0c0\uc77c\uc744 \ucee4\ubc84\ud560 \uc218 \uc788\uc73c\ubbc0\ub85c 20\ud68c \uc774\ub3d9\uc73c\ub85c \ud574\uacb0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "ColorUp\uc758 \ud37c\uc990 \ub808\ubca8\uc744 \ud574\uacb0\ud558\ub294 \ub370 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "ColorUp\uc758 \ud37c\uc990 \ub808\ubca8\uc744 \ud574\uacb0\ud558\ub294 \ub370 \ud6a8\uacfc\uc801\uc778 \uc804\ub7b5\uc5d0\ub294 \ubaa8\uc11c\ub9ac \uc911\uc2ec, \uc601\uc5ed \ubcd1\ud569 \ubc0f \uc774\ub3d9 \ucd5c\uc801\ud654\uac00 \ud3ec\ud568\ub429\ub2c8\ub2e4. \ubaa8\uc11c\ub9ac \uc911\uc2ec\uc740 \ubc94\uc704\ub97c \ucd5c\ub300\ud654\ud558\uae30 \uc704\ud574 \ubaa8\uc11c\ub9ac\uc5d0\uc11c \uc0c9\uc0c1 \uc801\uc6a9\uc744 \uc2dc\uc791\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc601\uc5ed \ubcd1\ud569\uc740 \uc791\uc740 \uc0c9\uc0c1 \uc601\uc5ed\uc744 \ub354 \ud070 \uc601\uc5ed\uc73c\ub85c \uc2dd\ubcc4\ud558\uace0 \uacb0\ud569\ud558\ub294 \uac83\uc744 \ud544\uc694\ub85c \ud569\ub2c8\ub2e4. \uc774\ub3d9 \ucd5c\uc801\ud654\ub294 \uac01 \uc774\ub3d9\uc744 \ubaa9\ud45c\uc5d0 \uc9c1\uc811 \uae30\uc5ec\ud558\ub3c4\ub85d \uacc4\ud68d\ud558\ub294 \uac83\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 60\ub808\ubca8\uc5d0\uc11c\ub294 5x5 \uadf8\ub9ac\ub4dc\uc5d0 \ub2e4\uc12f \uac1c\uc758 \uc0c9\uc0c1 \uc601\uc5ed\uc774 \uc788\uc73c\uba70, \uba3c\uc800 \uc88c\uce21 \uc0c1\ub2e8 \ubc0f \uc6b0\uce21 \ud558\ub2e8 \uc601\uc5ed\uc744 \ubcd1\ud569\ud558\uace0 \ub098\uba38\uc9c0 \ud0c0\uc77c\uc744 \ucc44\uc6cc\uc11c \ud574\uacb0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "ColorUp \uac8c\uc784 \ub514\uc790\uc778\uc5d0\uc11c \uc774\ub3d9 \uc81c\ud55c\uc758 \uc911\uc694\uc131\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "ColorUp\uc758 \uc774\ub3d9 \uc81c\ud55c\uc740 \uc804\ub7b5\uc801\uc778 \uae4a\uc774\uc640 \ub3c4\uc804 \uacfc\uc81c\ub97c \ucd94\uac00\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc774\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uac01 \uc774\ub3d9\uc5d0 \ub300\ud574 \uc2e0\uc911\ud558\uac8c \uc0dd\uac01\ud558\uace0 \uc804\ub7b5\uc744 \ucd5c\uc801\ud654\ud558\ub3c4\ub85d \uac15\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 40\ub808\ubca8\uc5d0\uc11c\ub294 4x4 \uadf8\ub9ac\ub4dc\uc5d0 \ub124 \uac1c\uc758 \uc0c9\uc0c1 \uc601\uc5ed\uacfc 12\ud68c \uc774\ub3d9 \uc81c\ud55c\uc774 \uc788\uc73c\uba70, \ud50c\ub808\uc774\uc5b4\ub294 \ubaa8\ub4e0 \uc601\uc5ed\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \ud569\uce58\uae30 \uc704\ud574 \uc0c9\uc0c1 \uc801\uc6a9\uc744 \uc2e0\uc911\ud558\uac8c \uacc4\ud68d\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774 \uba54\ucee4\ub2c8\uc998\uc744 \ud1b5\ud574 \ud50c\ub808\uc774\uc5b4\ub294 \ubb34\uc791\uc704\ub85c \uc0c9\uc0c1\uc744 \uc801\uc6a9\ud558\ub294 \uac83\uc774 \uc544\ub2c8\ub77c \uc0ac\ub824 \uae4a\uace0 \uc804\ub7b5\uc801\uc778 \uac8c\uc784\ud50c\ub808\uc774\uc5d0 \ucc38\uc5ec\ud558\ub3c4\ub85d \ud569\ub2c8\ub2e4."}, {"question": "ColorUp\uc758 \uadf8\ub9ac\ub4dc \ud06c\uae30\uac00 \uac01 \ub808\ubca8\uc758 \ub09c\uc774\ub3c4\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "ColorUp\uc758 \uadf8\ub9ac\ub4dc \ud06c\uae30\ub294 \ubcf5\uc7a1\uc131\uacfc \uac00\ub2a5\ud55c \uc774\ub3d9 \uc218\ub97c \uc99d\uac00\uc2dc\ucf1c \ub09c\uc774\ub3c4\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ub354 \ud070 \uadf8\ub9ac\ub4dc\ub294 \ub354 \ub9ce\uc740 \uc804\ub7b5\uc801 \uacc4\ud68d\uacfc \uc815\ud655\ud55c \uc0c9\uc0c1 \uc801\uc6a9\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 1\ub808\ubca8\uc758 3x3 \uadf8\ub9ac\ub4dc\ub294 \uac04\ub2e8\ud558\uc9c0\ub9cc, 80\ub808\ubca8\uc758 6x6 \uadf8\ub9ac\ub4dc\ub294 \uc601\uc5ed \ubcd1\ud569 \ubc0f \uc774\ub3d9 \ucd5c\uc801\ud654\uc640 \uac19\uc740 \uace0\uae09 \uc804\ub7b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub354 \ud070 \uadf8\ub9ac\ub4dc\uc758 \ud0c0\uc77c \uc218\uc640 \uc0c9\uc0c1 \uc601\uc5ed\uc774 \uc99d\uac00\ud568\uc5d0 \ub530\ub77c \uc774\ub3d9 \uc81c\ud55c \ub0b4\uc5d0\uc11c \ubaa9\ud45c\ub97c \ub2ec\uc131\ud558\ub294 \uac83\uc774 \ub354\uc6b1 \uc5b4\ub824\uc6cc\uc9d1\ub2c8\ub2e4."}, {"question": "\ub2e4\ub978 \uae30\uae30\uc5d0\uc11c ColorUp\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub124, \uac8c\uc784 \uacc4\uc815\uc744 \ud074\ub77c\uc6b0\ub4dc \uc11c\ube44\uc2a4\uc5d0 \uc5f0\uacb0\ud558\uba74 \ub2e4\ub978 \uae30\uae30\uc5d0\uc11c ColorUp\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub97c \ud1b5\ud574 \uc5ec\ub7ec \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669, \uc131\ucde8\ub3c4 \ubc0f \uc7a0\uae08 \ud574\uc81c\ub41c \ub808\ubca8\uc744 \ub3d9\uae30\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc2a4\ub9c8\ud2b8\ud3f0\uc5d0\uc11c \uac8c\uc784\uc744 \uc2dc\uc791\ud55c \ud6c4 \ud0dc\ube14\ub9bf\uc73c\ub85c \uc804\ud658\ud558\uba74 \uc0c8 \uae30\uae30\uc5d0\uc11c \ud074\ub77c\uc6b0\ub4dc \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uae30\ub9cc \ud558\uba74 \uc911\ub2e8\ud588\ub358 \uc704\uce58\uc5d0\uc11c \uacc4\uc18d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uae30\ub2a5\uc740 \ubaa8\ub4e0 \uae30\uae30\uc5d0\uc11c \uc6d0\ud65c\ud55c \uac8c\uc784 \ud658\uacbd\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4."}, {"question": "ColorUp\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "ColorUp\uc5d0\ub294 \uc7ac\ubbf8\ub97c \ub354\ud558\ub294 \uba87 \uac00\uc9c0 \uc228\uaca8\uc9c4 \uae30\ub2a5\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8\uc744 \ucd5c\uc18c \uc774\ub3d9 \uc218\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc644\ubcbd\ud55c \uc810\uc218\ub85c \uc644\ub8cc\ud558\uba74 \ud2b9\ubcc4\ud55c \uc131\ucde8\ub3c4\ub098 \uc228\uaca8\uc9c4 \ub808\ubca8\uc744 \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uc77c\ubd80 \ub808\ubca8\uc5d0\ub294 \ud37c\uc990\uc744 \ud478\ub294 \ub370 \ud78c\ud2b8\ub098 \ubc14\ub85c \uac00\uae30 \ubc29\ubc95\uc744 \uc81c\uacf5\ud558\ub294 \uc228\uaca8\uc9c4 \uc0c9\uc0c1 \ud328\ud134\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ud50c\ub808\uc774\ud558\ub294 \ub3d9\uc548 \uc774\ub7ec\ud55c \ubbf8\ubb18\ud55c \uc138\ubd80 \uc0ac\ud56d\uc744 \uc8fc\uc758 \uae4a\uac8c \uc0b4\ud3b4\ubcf4\uc138\uc694!"}, {"question": "ColorUp\uc758 \uc0c9\uc0c1 \uc601\uc5ed \uba54\ucee4\ub2c8\uc998\uc774 \ud37c\uc990 \ud480\uc774 \uacbd\ud5d8\uc744 \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0a4\ub098\uc694?", "answer": "ColorUp\uc758 \uc0c9\uc0c1 \uc601\uc5ed \uba54\ucee4\ub2c8\uc998\uc740 \uc804\ub7b5\uc801\uc778 \ubcf5\uc7a1\uc131\uc744 \ucd94\uac00\ud558\uc5ec \ud37c\uc990 \ud480\uc774 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4. \uc0c9\uc0c1 \uc601\uc5ed\uc740 \ub3d9\uc77c\ud55c \uc0c9\uc0c1\uc73c\ub85c \uc5f0\uacb0\ub41c \uadf8\ub9ac\ub4dc\uc758 \uc5f0\uacb0\ub41c \uc601\uc5ed\uc774\uba70, \uc774\ub7ec\ud55c \uc601\uc5ed\uc744 \ubcd1\ud569\ud558\ub294 \uac83\uc740 \uc9c4\ud589\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc774 \uba54\ucee4\ub2c8\uc998\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uacf5\uac04\uc801\uc73c\ub85c \uc0dd\uac01\ud558\uace0 \uc774\ub3d9\uc744 \uc2e0\uc911\ud558\uac8c \uacc4\ud68d\ud558\ub3c4\ub85d \uc7a5\ub824\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 20\ub808\ubca8\uc5d0\uc11c\ub294 4x4 \uadf8\ub9ac\ub4dc\uc5d0 \uc138 \uac1c\uc758 \uc0c9\uc0c1 \uc601\uc5ed\uc774 \uc788\uc73c\uba70, \ud50c\ub808\uc774\uc5b4\ub294 \uc791\uc740 \uc601\uc5ed\uc744 \uac00\uc7a5 \ud070 \uc601\uc5ed\uc73c\ub85c \ubcd1\ud569\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774\ub294 \ud37c\uc990\uc744 \ud478\ub294 \uac83\uc740 \ubb3c\ub860 \uadc0\uc911\ud55c \uc804\ub7b5\uc801 \uae30\uc220\uc744 \uac00\ub974\uccd0\uc90d\ub2c8\ub2e4."}]
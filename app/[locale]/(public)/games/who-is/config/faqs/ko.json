[{"question": "\uc800 \uc0ac\ub78c\uc740 \ub204\uad6c\uc8e0...? \uc2dc\uc791\ud558\uc790\ub9c8\uc790 \uc790\uafb8 \uadf8 \uc0ac\ub78c\ud55c\ud14c \uc8fd\ub294\ub370, \uc81c\uac00 \ubb58 \uc798\ubabb\ud558\uace0 \uc788\ub294 \uac78\uae4c\uc694? \ucd08\ubc18 \uac8c\uc784\uc5d0\uc11c \uc0b4\uc544\ub0a8\uae30 \uc704\ud55c \ud301\uc774 \uc788\uc744\uae4c\uc694?", "answer": "\uadf8 '\uc0ac\ub78c'\uc740 \uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\uc774\uac70\ub098 \ucd08\ubc18 \uac8c\uc784 \uc7a5\ube44\uac00 \ucd5c\uc801\ud654\ub41c \uce90\ub9ad\ud130\uc778 \uac83 \uac19\uc2b5\ub2c8\ub2e4. \uac71\uc815 \ub9c8\uc138\uc694, \ub204\uad6c\ub098 \uacaa\ub294 \uc77c\uc785\ub2c8\ub2e4! \uac1c\uc120\ud558\ub294 \ubc29\ubc95\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4.\n\n1\ub2e8\uacc4: \uc6c0\uc9c1\uc784\uc5d0 \uc9d1\uc911\ud558\uc138\uc694. \ucd08\ubcf4 \ud50c\ub808\uc774\uc5b4\ub294 \uc885\uc885 \uac00\ub9cc\ud788 \uc11c \uc788\uc5b4\uc11c \uc26c\uc6b4 \ud45c\uc801\uc774 \ub429\ub2c8\ub2e4. \ud68c\ud53c\uc640 \uc88c\uc6b0 \uc774\ub3d9\uc744 \uc5f0\uc2b5\ud558\uc138\uc694. \uc5c4\ud3d0\ubb3c\uc744 \uc911\uc2ec\uc73c\ub85c 8\uc790 \ubaa8\uc591\uc744 \uadf8\ub9b0\ub2e4\uace0 \uc0c1\uc0c1\ud574 \ubcf4\uc138\uc694.\n\n2\ub2e8\uacc4: \ud604\uba85\ud558\uac8c \ud30c\ubc0d\ud558\uc138\uc694. \uc2dc\uc791 \uc9c0\uc5ed\uc5d0\uc11c\ub294 \uc678\ud615 \uc544\uc774\ud15c\ubcf4\ub2e4 \ubb34\uae30\uc640 \uae30\ubcf8 \ubc29\uc5b4\uad6c/\uc18c\ubaa8\ud488\uc744 \uc6b0\uc120\uc2dc\ud558\uc138\uc694. \uc62c\ub4dc \uac00\uc2a4 \uc2a4\ud14c\uc774\uc158 \uadfc\ucc98\uc758 \uc0c1\uc790\uc5d0\ub294 \ud56d\uc0c1 \ucd1d\uc774 \uc788\ub294 \uac83\ucc98\ub7fc, \uc804\ub9ac\ud488 \uc0dd\uc131 \uc704\uce58\ub97c \uc54c\uba74 \uc720\ub9ac\ud569\ub2c8\ub2e4.\n\n3\ub2e8\uacc4: \uc218\ube44\uc801\uc73c\ub85c \ud50c\ub808\uc774\ud558\uc138\uc694. \uc2f8\uc6c0\uc5d0 \uc131\uae09\ud558\uac8c \ub6f0\uc5b4\ub4e4\uc9c0 \ub9c8\uc138\uc694. \ubc1c\uc18c\ub9ac\uc640 \ucd1d\uc18c\ub9ac\ub97c \ub4e3\uace0 \uc801\uc758 \uc6c0\uc9c1\uc784\uc744 \uc608\uce21\ud558\uc138\uc694. \uc5c4\ud3d0\ubb3c\uc744 \ud65c\uc6a9\ud558\uc138\uc694. \uccb4\uc2a4\ucc98\ub7fc \uc0dd\uac01\ud558\uc138\uc694. \ucd08\ubc18 \uac8c\uc784\uc5d0\uc11c\ub294 \uc704\uce58 \uc120\uc815\uc774 \uc804\ubd80\uc785\ub2c8\ub2e4.\n\ube44\uc720: \ucd08\ubc18 \uac8c\uc784\uc744 \uc11c\ubc14\uc774\ubc8c \ud638\ub7ec\ub77c\uace0 \uc0dd\uac01\ud558\uc138\uc694. \ub2f9\uc2e0\uc740 \uc57d\ud558\uc9c0\ub9cc, \uc0c1\ub300\ub97c \uc18d\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Who Is\uc5d0\uc11c '\ubb34\uae30 \ube14\ub8f8'\uc774\ub780 \ubb34\uc5c7\uc774\uba70, \uadf8\uac83\uc774 \uc81c \uc0ac\uaca9\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "\ubb34\uae30 \ube14\ub8f8\uc740 \uc0ac\uaca9 \uc2dc \ucd1d\uc54c\uc774 \ubb34\uc791\uc704\ub85c \ud769\uc5b4\uc9c0\ub294 \ud604\uc0c1\uc744 \ub9d0\ud558\uba70, \ud2b9\ud788 \uc790\ub3d9 \ubb34\uae30\uc5d0\uc11c \ub450\ub4dc\ub7ec\uc9d1\ub2c8\ub2e4. \uc774\ub294 \uc644\ubcbd\ud558\uac8c \uc870\uc900\ud558\ub354\ub77c\ub3c4 \ucd1d\uc54c\uc774 \uc870\uc900\uc810\uacfc \uc815\ud655\ud788 \uac19\uc740 \uc704\uce58\uc5d0 \ub5a8\uc5b4\uc9c0\uc9c0 \uc54a\uc744 \uc218 \uc788\uc74c\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4. \ubc18\ub3d9\uc774 \uc2ec\ud560\uc218\ub85d \ubb34\uc791\uc704\uc131\uc774 \ucee4\uc9d1\ub2c8\ub2e4. \uc774\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud55c \ud301\uc740 \ubc29\uc544\uc1e0\ub97c \uacc4\uc18d \ub204\ub974\uae30\ubcf4\ub2e4\ub294 \uc9e7\uac8c \ub04a\uc5b4\uc11c \uc0ac\uaca9\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc774\ub807\uac8c \ud558\uba74 \ube14\ub8f8\uc774 \uc904\uc5b4\ub4e4\uace0 \uc815\ud655\ub3c4\uac00 \ud5a5\uc0c1\ub429\ub2c8\ub2e4. \ub610\ud55c \uc548\uc815\uc131\uc744 \ub192\uc774\uace0 \ubc18\ub3d9\uc744 \uc904\uc774\ub294 \ubb34\uae30 \uac1c\uc870 \ubd80\ud488\uc744 \uc7a5\ucc29\ud574 \ubcf4\uc138\uc694. \ud070 \ucc28\uc774\ub97c \ubcf4\uac8c \ub420 \uac83\uc785\ub2c8\ub2e4. '\uc548\uc815\ud654 \uac1c\uba38\ub9ac\ud310' \uac1c\uc870 \ubd80\ud488\uc740 \ud6cc\ub96d\ud55c \uc2dc\uc791\uc810\uc785\ub2c8\ub2e4."}, {"question": "\uc65c \ub2e4\ub4e4 \uc11c\ubc84 '\ud2f1 \ub808\uc774\ud2b8'\uc5d0 \ub300\ud574 \uc774\uc57c\uae30\ud558\ub294 \uac70\uc8e0? \uadf8\uac8c \ubb34\uc2a8 \ub73b\uc774\uace0, Who Is \uac8c\uc784\ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "\uc11c\ubc84 \ud2f1 \ub808\uc774\ud2b8\ub294 \uac8c\uc784 \uc11c\ubc84\uac00 \ucd08\ub2f9 \uac8c\uc784 \uc0c1\ud0dc\ub97c \uc5c5\ub370\uc774\ud2b8\ud558\ub294 \ube48\ub3c4\ub97c \ub098\ud0c0\ub0c5\ub2c8\ub2e4. \ud2f1 \ub808\uc774\ud2b8\uac00 \ub192\uc744\uc218\ub85d(\uc608: 60Hz \uc774\uc0c1) \uc5c5\ub370\uc774\ud2b8\uac00 \ub354 \uc790\uc8fc \ubc1c\uc0dd\ud558\uc5ec \uac8c\uc784\ud50c\ub808\uc774\uac00 \ub354 \ubd80\ub4dc\ub7fd\uace0 \ubc18\uc751\uc131\uc774 \uc88b\uc544\uc9d1\ub2c8\ub2e4. \ud2f1 \ub808\uc774\ud2b8\uac00 \ub0ae\uc73c\uba74 \ub208\uc5d0 \ub744\ub294 \uc9c0\uc5f0 \ub610\ub294 \ube44\ub3d9\uae30\ud654\uac00 \ubc1c\uc0dd\ud558\uc5ec \ub3d9\uc791\uc774 \uc9c0\uc5f0\ub418\ub294 \uac83\ucc98\ub7fc \ub290\uaef4\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uac8c\uc784\ud50c\ub808\uc774\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5: \ud2f1 \ub808\uc774\ud2b8\uac00 \ub192\uc73c\uba74 \uce90\ub9ad\ud130 \uc704\uce58\uc640 \ub3d9\uc791\uc774 \ub354 \uc790\uc8fc \uc5c5\ub370\uc774\ud2b8\ub418\uc5b4 \ud53c\uaca9 \ud310\uc815 \ubb38\uc81c\uac00 \uc644\ud654\ub429\ub2c8\ub2e4. \ud2f1 \ub808\uc774\ud2b8\uac00 \ub0ae\uc73c\uba74 \uc870\uc900\uc774 \uc77c\uad00\uc131 \uc5c6\uac8c \ub290\uaef4\uc9d1\ub2c8\ub2e4. \uc9c1\uc811\uc801\uc73c\ub85c \uc601\ud5a5\uc744 \uc904 \uc218\ub294 \uc5c6\uc9c0\ub9cc, \ud551\uc774 \ub0ae\uc740 \uc11c\ubc84\ub97c \uc120\ud0dd\ud558\uba74 \uc77c\ubc18\uc801\uc73c\ub85c \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\ud604\uc7ac '\uba54\ud0c0' \uce90\ub9ad\ud130 \ube4c\ub4dc\ub294 \ubb34\uc5c7\uc73c\ub85c \uac04\uc8fc\ub418\uba70, \uadf8 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694? \uc5b4\ub5a4 \ub2a5\ub825\uacfc \uc2a4\ud0ac\uc5d0 \uc9d1\uc911\ud574\uc57c \ud560\uae4c\uc694?", "answer": "\ud604\uc7ac '\uba54\ud0c0'\ub294 \ub192\uc740 \uae30\ub3d9\uc131\uacfc \ub192\uc740 \uc21c\uac04 \ud53c\ud574\ub7c9 \ube4c\ub4dc\ub85c \uae30\uc6b8\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub294 \uc885\uc885 '\uc100\ub3c4\uc6b0 \uc2a4\ud15d' \uc2a4\ud0ac\uacfc \uac19\uc774 \uc774\ub3d9 \uc18d\ub3c4\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ub2a5\ub825\uc744 \uac00\uc9c4 \uce90\ub9ad\ud130\uc640 \ud2b9\uc815 \uc0f7\uac74 \uc720\ud615\uacfc \uac19\uc774 \uc9e7\uc740 \uc2dc\uac04\uc5d0 \uc0c1\ub2f9\ud55c \ud53c\ud574\ub97c \uc904 \uc218 \uc788\ub294 \ubb34\uae30\ub97c \uacb0\ud569\ud558\ub294 \uac83\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \ucd08\uc810\uc740 \ube60\ub974\uac8c \uac70\ub9ac\ub97c \uc881\ud788\uace0, \uc21c\uac04 \ud53c\ud574\ub97c \uac00\ud558\uace0, \ucc98\uce58\ub97c \ud655\ubcf4\ud558\uac70\ub098 \uc774\ud0c8\ud558\ub294 \ub370 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \ube4c\ub4dc\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc790\uc6d0 \uc0dd\uc131\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \uc2a4\ud0ac\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc138\uc694. \ub610\ud55c \uc7ac\uc0ac\uc6a9 \ub300\uae30 \uc2dc\uac04\uc744 \uc904\uc774\ub294 \uc7a5\ube44\ub97c \uc7a5\ucc29\ud558\ub294 \uac83\uc744 \uace0\ub824\ud574 \ubcf4\uc138\uc694."}, {"question": "\ud76c\uadc0 \uc81c\uc791 \uc7ac\ub8cc\ub97c '\ud30c\ubc0d'\ud558\ub294 \uac00\uc7a5 \uc88b\uc740 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "'\ucd5c\uace0'\uc758 \ubc29\ubc95\uc740 \uc0c1\ud669\uc5d0 \ub530\ub77c \ub2e4\ub974\uc9c0\ub9cc, \uc77c\ubc18\uc801\uc73c\ub85c \uad50\ud1b5\ub7c9\uc774 \ub9ce\uc740 \uc9c0\uc5ed\uc774 \uac00\uc7a5 \uc88b\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc9c0\uc5ed\uc5d0\ub294 \uc77c\ubc18\uc801\uc73c\ub85c \ub354 \ub9ce\uc740 \uc0c1\uc790/\uc804\ub9ac\ud488 \uc0dd\uc131 \uc704\uce58\uac00 \uc788\uc5b4 \uae30\ud68c\uac00 \uc99d\uac00\ud569\ub2c8\ub2e4.\n\n1\ub2e8\uacc4: \uc790\uc6d0 \ud56b\uc2a4\ud31f\uc744 \ucc3e\uc73c\uc138\uc694. \uc218\ud655 \uac00\ub2a5\ud55c \uc790\uc6d0 \ub610\ub294 \ud76c\uadc0 \uc0c1\uc790 \uc0dd\uc131 \uc704\uce58\uac00 \ub192\uc740 \uac83\uc73c\ub85c \uc54c\ub824\uc9c4 \uc9c0\uc5ed\uc744 \uc2dd\ubcc4\ud558\uc138\uc694. \uc774 \uc815\ubcf4\ub294 \uc885\uc885 \ucee4\ubba4\ub2c8\ud2f0 \ud3ec\ub7fc\uc5d0\uc11c \uacf5\uc720\ub429\ub2c8\ub2e4.\n2\ub2e8\uacc4: \uacbd\ub85c\ub97c \ucd5c\uc801\ud654\ud558\uc138\uc694. \uc774\ub7ec\ud55c \ud56b\uc2a4\ud31f\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \ucee4\ubc84\ud558\uc5ec \uc774\ub3d9 \uc2dc\uac04\uc744 \ucd5c\uc18c\ud654\ud558\uace0 \uc2dc\uac04\ub2f9 \uc218\uc9d1\ud558\ub294 \uc804\ub9ac\ud488\uc744 \ucd5c\ub300\ud654\ud558\ub294 \uacbd\ub85c\ub97c \ub9cc\ub4dc\uc138\uc694.\n3\ub2e8\uacc4: \uc778\ubca4\ud1a0\ub9ac\ub97c \uad00\ub9ac\ud558\uc138\uc694. \ucd5c\uc0c1\uc758 \uacb0\uacfc\ub97c \uc704\ud574 \ub0a8\uc740 \uc778\ubca4\ud1a0\ub9ac \uc6a9\ub7c9\uc744 \ucd94\uc801\ud558\uc138\uc694."}, {"question": "PC\uc5d0\uc11c \ubaa8\ubc14\uc77c\ub85c 'Who Is' \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud558\uba70, \uc81c\ud55c \uc0ac\ud56d\uc774 \uc788\ub098\uc694?", "answer": "\ud604\uc7ac PC\uc640 \ubaa8\ubc14\uc77c \uac04\uc758 \uc9c1\uc811\uc801\uc778 \uc9c4\ud589 \uc0c1\ud669 \uc804\uc1a1\uc740 \uc9c0\uc6d0\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ub450 \ubc84\uc804 \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \uc5f0\uacb0\ub418\uc5b4 \uc788\uc9c0\ub9cc, \uac01\uac01 \uc790\uccb4 \uc9c4\ud589 \uc2dc\uc2a4\ud15c\uc744 \uac00\uc9c4 \ubcc4\ub3c4\uc758 \uc5d4\ud130\ud2f0\ub85c \uc791\ub3d9\ud569\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \uac1c\ubc1c\uc790\ub4e4\uc740 \ud5a5\ud6c4 \uae30\ub2a5\uc73c\ub85c \ud06c\ub85c\uc2a4 \uc9c4\ud589\uc744 \ubaa8\uc0c9\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\ub978 \uac8c\uc784\uc5d0\uc11c\ub294 \ub2e4\uc74c\uacfc \uac19\uc774 \ucc98\ub9ac\ud569\ub2c8\ub2e4.\n\n[\uad6c\uc131 \ube44\uad50 \ud14c\uc774\ube14]\n\uacc4\uc815 \uc5f0\uacb0: \ub450 \ubc84\uc804 \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \uc5f0\uacb0\ub428\n\uc544\uc774\ud15c \uc804\uc1a1: \ubd88\uac00\ub2a5\n\uc678\ud615 \uc544\uc774\ud15c: \uc804\uc1a1 \uac00\ub2a5\n\uc2dc\uc98c \ud328\uc2a4: \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc\uc77c \uc218\ub3c4 \uc788\uace0 \uc544\ub2d0 \uc218\ub3c4 \uc788\uc74c"}, {"question": "'\uc2a4\ud1a0\ub9ac\ud154\ub7ec' NPC\ub294 \ub204\uad6c\uc8e0? \uc228\uaca8\uc9c4 \uc704\uce58\uc5d0\uc11c \uadf8\ub4e4\uc744 \ucc3e\uc558\uc9c0\ub9cc, \uadf8\ub4e4\uc740 \ubaa8\ud638\ud55c \ub2e8\uc11c\ub9cc \uc8fc\ub358\ub370\uc694??", "answer": "'\uc2a4\ud1a0\ub9ac\ud154\ub7ec'\ub294 \ud45c\uc2dc\ub418\uc9c0 \uc54a\uc740 \uc77c\ub828\uc758 \uc0ac\uc774\ub4dc \ud018\uc2a4\ud2b8\uc640 \uad00\ub828\ub41c \uc228\uaca8\uc9c4 NPC\uc785\ub2c8\ub2e4. \uadf8\ub4e4\uc744 \ucc3e\ub294 \uac83 \uc790\uccb4\uac00 \ud070 \uc5c5\uc801\uc785\ub2c8\ub2e4! \uadf8\ub4e4\uc740 \uc228\uaca8\uc9c4 \uc9c0\uc5ed, \uace0\uc720\ud55c \uc544\uc774\ud15c \ub610\ub294 \uace0\uae09 \uc2a4\ud0ac \uc7a0\uae08 \ud574\uc81c\ub85c \uc774\uc5b4\uc9c8 \uc218 \uc788\ub294 \ubaa8\ud638\ud55c \ub2e8\uc11c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ud575\uc2ec\uc740 \ub2e8\uc11c\ub97c \uc8fc\uc758 \uae4a\uac8c \ub530\ub974\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc2a4\ud1a0\ub9ac\ud154\ub7ec\ub294 '\uace0\ub300 \ub098\ubb34 \uadfc\ucc98\uc5d0\uc11c \uc7a0\uc790\ub294 \uc6a9'\uc744 \uc5b8\uae09\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub294 \ub0a8\ubd80 \uc9c0\uc5ed\uc758 \ud070 \ub5a1\uac08\ub098\ubb34\ub85c \ud5a5\ud574\uc57c \ud568\uc744 \uc758\ubbf8\ud560 \uac00\ub2a5\uc131\uc774 \ub192\uc2b5\ub2c8\ub2e4. \ud798\ub4e0 \uc2f8\uc6c0\uc744 \uc900\ube44\ud558\uc138\uc694. \uadf8\ub294 \uace0\uc804\uc801\uc778 '\uc624\ub77c\ud074' \uc544\ud0a4\ud0c0\uc785\uc785\ub2c8\ub2e4."}, {"question": "\uc81c 'K/D' \ube44\uc728\uc744 \uac1c\uc120\ud558\ub294 \uac00\uc7a5 \uc26c\uc6b4 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "K/D\ub97c \uac1c\uc120\ud558\ub824\uba74 \ubb34\uae30 \uc120\ud0dd, \ub9f5 \uc9c0\uc2dd, \uc0c1\ud669 \uc778\uc2dd \ub4f1 \uc5ec\ub7ec \uc694\uc18c\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ud3b8\uc548\ud558\uac8c \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \ubb34\uae30\ub97c \uace0\uc218\ud558\uace0, \uadf8 \uac15\uc810\uc744 \ud65c\uc6a9\ud558\ub294 \ubc29\ubc95\uc744 \ubc30\uc6b0\uc138\uc694. \ubd88\ub9ac\ud55c \uc2f8\uc6c0\uc5d0 \ucc38\uc5ec\ud558\uc9c0 \ub9c8\uc138\uc694. \ub9f5 \uc9c0\uc2dd: \uc801\uc758 \uc6c0\uc9c1\uc784\uc744 \uc608\uce21\ud560 \uc218 \uc788\ub3c4\ub85d \ub9f5 \ub808\uc774\uc544\uc6c3\uc744 \ubc30\uc6b0\uc138\uc694. \uc0c1\ud669 \uc778\uc2dd: \uc18c\ub9ac \uc2e0\ud638\uc640 \ubbf8\ub2c8\ub9f5\uc5d0 \uc8fc\uc758\ub97c \uae30\uc6b8\uc5ec \uc801\uc744 \ucd94\uc801\ud558\uace0 \uae30\uc2b5\uc744 \ud53c\ud558\uc138\uc694.\n\n[\uc2dc\uac01\ud654]\n[K/D \ube44\uc728 \uac1c\uc120 \ub8e8\ud504\ub97c \ubcf4\uc5ec\uc8fc\ub294 \uc21c\uc11c\ub3c4 -> \ub9f5 \uc778\uc2dd -> \uc6b0\uc218\ud55c \ubb34\uae30 \uc81c\uc5b4 -> \uacc4\uc0b0\ub41c \uc704\ud5d8 -> \uac1c\uc120\ub41c K/D \ube44\uc728]"}, {"question": "'\ud504\ub808\uc784 \uc18d\ub3c4'\uac00 \uc65c \uadf8\ub807\uac8c \uc911\uc694\ud55c\uac00\uc694? \uc911\uae09 PC\uc5d0\uc11c \ub354 \ubd80\ub4dc\ub7ec\uc6b4 \uac8c\uc784\ud50c\ub808\uc774\ub97c \uc704\ud574 \uc5b4\ub5a4 \uc124\uc815\uc744 \uc870\uc815\ud574\uc57c \ud560\uae4c\uc694?", "answer": "\ud504\ub808\uc784 \uc18d\ub3c4\ub294 \ucd08\ub2f9 \ud654\uba74\uc5d0 \ub098\ud0c0\ub098\ub294 \uc774\ubbf8\uc9c0 \uc218\uc774\uba70, \uac8c\uc784\uc774 \uc5bc\ub9c8\ub098 \ubd80\ub4dc\ub7fd\uac8c \ub290\uaef4\uc9c0\ub294\uc9c0\ub97c \uacb0\uc815\ud569\ub2c8\ub2e4. \ud504\ub808\uc784 \uc18d\ub3c4\uac00 \ub0ae\uc73c\uba74 \ub04a\uae40 \ud604\uc0c1\uc774 \ubc1c\uc0dd\ud558\uc5ec \uc870\uc900\uc774 \uc5b4\ub824\uc6cc\uc9d1\ub2c8\ub2e4. \uc911\uae09 PC\uc5d0\uc11c\ub294 \ub2e4\uc74c \uc124\uc815\uc744 \uc6b0\uc120\uc2dc\ud558\uc138\uc694.\n\n1. \ud574\uc0c1\ub3c4 \ub0ae\ucd94\uae30: \uac8c\uc784 \ud574\uc0c1\ub3c4\ub97c 1920x1080 \ub610\ub294 1600x900\uc73c\ub85c \uc124\uc815\ud558\uc138\uc694.\n2. \ud14d\uc2a4\ucc98 \ud488\uc9c8 \uc904\uc774\uae30: \uc774 \uc124\uc815\uc744 \ub0ae\ucd94\uba74 \ud06c\uac8c \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4.\n3. \uadf8\ub9bc\uc790 \ud488\uc9c8: \uadf8\ub9bc\uc790 \ud488\uc9c8\uc744 \ub0ae\ucd94\uac70\ub098 \ub044\uc138\uc694. \ub9ac\uc18c\uc2a4\ub97c \ub9e4\uc6b0 \ub9ce\uc774 \uc0ac\uc6a9\ud569\ub2c8\ub2e4.\n4. \uc548\ud2f0 \uc568\ub9ac\uc5b4\uc2f1 \ube44\ud65c\uc131\ud654: \uc548\ud2f0 \uc568\ub9ac\uc5b4\uc2f1\uc740 \ub4e4\ucb49\ub0a0\ucb49\ud55c \uac00\uc7a5\uc790\ub9ac\ub97c \ubd80\ub4dc\ub7fd\uac8c \ud558\uc9c0\ub9cc \uc131\ub2a5\uc774 \uc800\ud558\ub418\ubbc0\ub85c \ube44\ud65c\uc131\ud654\ud558\uac70\ub098 FXAA\uc640 \uac19\uc740 \ub0ae\uc740 \uc124\uc815\uc73c\ub85c \uc124\uc815\ud558\uc138\uc694. \uc815\ud655\ud55c \uc218\uce58\ub97c \ud655\uc778\ud558\uace0 \uac01 \uc124\uc815\uc774 \uac8c\uc784\uc744 \uc5bc\ub9c8\ub098 \ud5a5\uc0c1\uc2dc\ud0a4\ub294\uc9c0 \uc815\ud655\ud788 \ud655\uc778\ud558\uc138\uc694."}, {"question": "'\uc544\ub808\ub098 \ubaa8\ub4dc'\uc5d0\uc11c \ubc18\ubcf5\uc801\uc73c\ub85c \uc2b9\ub9ac\ud55c \ud6c4 \uace0\uc720\ud55c \ubb34\uae30 \uc124\uacc4\ub3c4\ub97c \uc900\ub2e4\uace0 \uc18c\ubb38\ub09c \uc0ac\ub78c\uc740 \ub204\uad6c\uc8e0? \uba87 \ubc88 \uc2dc\ub3c4\ud588\uc9c0\ub9cc \uc5ec\uc804\ud788 \ud45c\uc900 \ud1b5\ud654\ub9cc \ucd95\uc801\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.", "answer": "NPC\ub294 '\uc544\ub808\ub098 \ub9c8\uc2a4\ud130'\ub77c\uace0 \ubd88\ub9bd\ub2c8\ub2e4. \ub124, \uace0\uc720\ud55c \uc124\uacc4\ub3c4 \ubcf4\uc0c1\uc774 \uc788\uc9c0\ub9cc, \uba87 \ubc88\uc758 \uc2b9\ub9ac\ub9cc\uc73c\ub85c\ub294 \ubcf4\uc7a5\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ucda9\ubd84\ud788 \uc2b9\ub9ac\ud558\uba74 \uc7a0\uae08 \ud574\uc81c\ub429\ub2c8\ub2e4. \uae30\ud68c\ub97c \ucd5c\ub300\ud654\ud558\ub824\uba74 \uc5f0\uc18d\uc73c\ub85c \uc5ec\ub7ec \uacbd\uae30\ub97c \uc2b9\ub9ac\ud574 \ubcf4\uc138\uc694. \uace0\uc720\ud55c \ubcf4\uc0c1\uc744 \uc5bb\uc744 \ud655\ub960\uc774 \ub192\uc544\uc9d1\ub2c8\ub2e4. \uac8c\uc784 \ub0b4 \uc608\uc2dc: \ud55c \ud50c\ub808\uc774\uc5b4\uac00 \ud2b9\uc815 \ud76c\uadc0 \uc870\uac74\uc774 \ud65c\uc131\ud654\ub41c \uc0c1\ud0dc\uc5d0\uc11c 25\ubc88 \uc5f0\uc18d\uc73c\ub85c \uc2b9\ub9ac\ud558\uc5ec '\ud384\uc2a4 \ub77c\uc774\ud50c' \uc124\uacc4\ub3c4\ub97c \uc7a0\uae08 \ud574\uc81c\ud588\uc2b5\ub2c8\ub2e4. \uc778\ub0b4\uc2ec\uc744 \uac00\uc9c0\uc138\uc694. \uc9c0\uc18d\uc801\uc778 \uae30\uc220\uc774 \ud544\uc694\ud569\ub2c8\ub2e4!"}]
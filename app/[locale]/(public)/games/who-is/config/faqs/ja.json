[{"question": "\u8ab0\u3067\u3057\u3087\u3046\u2026\u305d\u306e\u7537\uff1f\u5e8f\u76e4\u3067\u5f7c\u306b\u4f55\u5ea6\u3082\u6bba\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u4f55\u304c\u9593\u9055\u3063\u3066\u3044\u308b\u306e\u3067\u3057\u3087\u3046\u304b\uff1f\u5e8f\u76e4\u3092\u751f\u304d\u629c\u304f\u305f\u3081\u306e\u30d2\u30f3\u30c8\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u305d\u306e\u300e\u7537\u300f\u306f\u3001\u7d4c\u9a13\u8c4a\u5bcc\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u304b\u3001\u5e8f\u76e4\u306b\u6700\u9069\u5316\u3055\u308c\u305f\u88c5\u5099\u3092\u6301\u3064\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u3088\u3046\u3067\u3059\u3002\u5fc3\u914d\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3001\u8ab0\u3082\u304c\u3053\u308c\u3068\u76f4\u9762\u3057\u307e\u3059\uff01\u6539\u5584\u65b9\u6cd5\u306f\u3053\u3061\u3089\u3067\u3059\uff1a\n\n\u30b9\u30c6\u30c3\u30d71\uff1a\u79fb\u52d5\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u304f\u3060\u3055\u3044\u3002\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3057\u3070\u3057\u3070\u52d5\u304b\u306a\u3044\u305f\u3081\u3001\u6a19\u7684\u306b\u306a\u308a\u3084\u3059\u3044\u3067\u3059\u3002\u56de\u907f\u3084\u304b\u308f\u3057\u3092\u7df4\u7fd2\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30ab\u30d0\u30fc\u306e\u5468\u56f2\u3092\u56f3\u5f62\uff18\u306e\u5b57\u30d1\u30bf\u30fc\u30f3\u3067\u60f3\u50cf\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\n\n\u30b9\u30c6\u30c3\u30d72\uff1a\u8ce2\u304f\u6226\u5229\u54c1\u3092\u56de\u53ce\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u5e8f\u76e4\u306e\u5730\u57df\u3067\u306f\u3001\u6b66\u5668\u3068\u57fa\u672c\u7684\u306a\u9632\u5177/\u6d88\u8017\u54c1\u3092\u3001\u88c5\u98fe\u54c1\u3088\u308a\u3082\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6226\u5229\u54c1\u306e\u51fa\u73fe\u5834\u6240\u3092\u77e5\u308c\u3070\u6709\u5229\u306b\u306a\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u53e4\u3044\u30ac\u30bd\u30ea\u30f3\u30b9\u30bf\u30f3\u30c9\u8fd1\u304f\u306e\u7bb1\u306b\u306f\u5e38\u306b\u9283\u304c\u3042\u308a\u307e\u3059\u3002\n\n\u30b9\u30c6\u30c3\u30d73\uff1a\u9632\u5fa1\u7684\u306b\u30d7\u30ec\u30a4\u3057\u307e\u3057\u3087\u3046\u3002\u6025\u3044\u3067\u6226\u95d8\u306b\u98db\u3073\u8fbc\u307e\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002\u8db3\u97f3\u3084\u9283\u58f0\u3092\u805e\u3044\u3066\u3001\u6575\u306e\u52d5\u304d\u3092\u4e88\u6e2c\u3057\u307e\u3059\u3002\u6709\u5229\u306b\u30ab\u30d0\u30fc\u3092\u6d3b\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30c1\u30a7\u30b9\u306e\u3088\u3046\u306b\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u5e8f\u76e4\u306f\u914d\u7f6e\u304c\u3059\u3079\u3066\u3067\u3059\u3002\n\u985e\u63a8\uff1a\u5e8f\u76e4\u3092\u30b5\u30d0\u30a4\u30d0\u30eb\u30db\u30e9\u30fc\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u3042\u306a\u305f\u306f\u5f31\u3044\u304c\u3001\u305d\u308c\u3067\u3082\u6575\u3092\u51fa\u3057\u629c\u304f\u3053\u3068\u304c\u3067\u304d\u308b\u306e\u3067\u3059\u3002"}, {"question": "\u300e\u6b66\u5668\u306e\u30d6\u30ec\u300f\u3068\u306f\u3001\u8ab0\u3067\u3057\u3087\u3046\u306b\u304a\u3051\u308b\u3082\u306e\u3067\u3001\u79c1\u306e\u30b7\u30e7\u30c3\u30c8\u306b\u3069\u306e\u3088\u3046\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u304b\uff1f", "answer": "\u6b66\u5668\u306e\u30d6\u30ec\u3068\u306f\u3001\u7279\u306b\u81ea\u52d5\u6b66\u5668\u3067\u767a\u5c04\u3059\u308b\u3068\u304d\u306b\u5f3e\u4e38\u304c\u30e9\u30f3\u30c0\u30e0\u306b\u5e83\u304c\u308b\u73fe\u8c61\u306e\u3053\u3068\u3067\u3059\u3002\u6b63\u78ba\u306b\u7167\u6e96\u3092\u5408\u308f\u305b\u3066\u3082\u3001\u5f3e\u304c\u6b63\u78ba\u306b\u7167\u6e96\u70b9\u306b\u547d\u4e2d\u3057\u306a\u3044\u3053\u3068\u3092\u610f\u5473\u3057\u307e\u3059\u3002\u53cd\u52d5\u304c\u5927\u304d\u3044\u307b\u3069\u3001\u30e9\u30f3\u30c0\u30e0\u3055\u304c\u5927\u304d\u304f\u306a\u308a\u307e\u3059\u3002\u5bfe\u51e6\u3059\u308b\u305f\u3081\u306e\u30d2\u30f3\u30c8\uff1a\u77ed\u6642\u9593\u306e\u30d0\u30fc\u30b9\u30c8\u3067\u6483\u3064\u3088\u3046\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30c8\u30ea\u30ac\u30fc\u3092\u62bc\u3057\u7d9a\u3051\u308b\u306e\u3092\u907f\u3051\u307e\u3057\u3087\u3046\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u30d6\u30ec\u304c\u5c0f\u3055\u304f\u306a\u308a\u3001\u6b63\u78ba\u6027\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002\u307e\u305f\u3001\u5b89\u5b9a\u6027\u3068\u53cd\u52d5\u3092\u8efd\u6e1b\u3059\u308b\u6b66\u5668\u306e\u4fee\u6b63\u3092\u88c5\u5099\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\u3042\u306a\u305f\u306f\u5927\u304d\u306a\u9055\u3044\u3092\u898b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u300c\u5b89\u5b9a\u5316\u30b9\u30c8\u30c3\u30af\u300d\u4fee\u6b63\u306f\u3001\u826f\u3044\u51fa\u767a\u70b9\u3067\u3059\u3002"}, {"question": "\u306a\u305c\u7686\u3001\u30b5\u30fc\u30d0\u30fc\u306e\u300e\u30c6\u30a3\u30c3\u30af\u30ec\u30fc\u30c8\u300f\u306b\u3064\u3044\u3066\u8a71\u3057\u3066\u3044\u308b\u306e\u3067\u3059\u304b\uff1f\u305d\u308c\u306f\u4f55\u3092\u610f\u5473\u3057\u3001\u300e\u8ab0\u3067\u3057\u3087\u3046\u300f\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u304b\uff1f", "answer": "\u30b5\u30fc\u30d0\u30fc\u306e\u30c6\u30a3\u30c3\u30af\u30ec\u30fc\u30c8\u3068\u306f\u3001\u30b2\u30fc\u30e0\u30b5\u30fc\u30d0\u30fc\u304c1\u79d2\u9593\u306b\u30b2\u30fc\u30e0\u306e\u72b6\u614b\u3092\u66f4\u65b0\u3059\u308b\u983b\u5ea6\u306e\u3053\u3068\u3067\u3059\u3002\u30c6\u30a3\u30c3\u30af\u30ec\u30fc\u30c8\u304c\u9ad8\u3044\uff08\u4f8b\uff1a60Hz\u4ee5\u4e0a\uff09\u5834\u5408\u3001\u66f4\u65b0\u983b\u5ea6\u304c\u9ad8\u3044\u305f\u3081\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u304c\u6ed1\u3089\u304b\u3067\u53cd\u5fdc\u6027\u304c\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002\u30c6\u30a3\u30c3\u30af\u30ec\u30fc\u30c8\u304c\u4f4e\u3044\u3068\u3001\u76ee\u306b\u898b\u3048\u308b\u30e9\u30b0\u3084\u975e\u540c\u671f\u304c\u751f\u3058\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u3001\u30a2\u30af\u30b7\u30e7\u30f3\u304c\u9045\u308c\u308b\u3088\u3046\u306b\u611f\u3058\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\n\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3078\u306e\u5f71\u97ff\uff1a\u30c6\u30a3\u30c3\u30af\u30ec\u30fc\u30c8\u304c\u9ad8\u3044\u5834\u5408\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u4f4d\u7f6e\u3068\u30a2\u30af\u30b7\u30e7\u30f3\u304c\u3088\u308a\u983b\u7e41\u306b\u66f4\u65b0\u3055\u308c\u308b\u305f\u3081\u3001\u30d2\u30c3\u30c8\u767b\u9332\u306e\u554f\u984c\u304c\u8efd\u6e1b\u3055\u308c\u307e\u3059\u3002\u4f4e\u3044\u30c6\u30a3\u30c3\u30af\u30ec\u30fc\u30c8\u306e\u5834\u5408\u3001\u7167\u6e96\u304c\u4e0d\u898f\u5247\u306b\u611f\u3058\u3089\u308c\u307e\u3059\u3002\u76f4\u63a5\u5f71\u97ff\u3059\u308b\u3053\u3068\u306f\u3067\u304d\u307e\u305b\u3093\u304c\u3001\u4f4e\u9045\u5ef6\u30b5\u30fc\u30d0\u30fc\u3092\u9078\u629e\u3059\u308b\u3068\u3001\u4e00\u822c\u7684\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u73fe\u5728\u3001\u6700\u3082\u300e\u30e1\u30bf\u300f\u3068\u3055\u308c\u308b\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u30d3\u30eb\u30c9\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u306a\u305c\u3067\u3059\u304b\uff1f\u3069\u306e\u30b9\u30ad\u30eb\u306b\u96c6\u4e2d\u3059\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u73fe\u5728\u306e\u300e\u30e1\u30bf\u300f\u306f\u3001\u9ad8\u6a5f\u52d5\u3001\u9ad8\u30d0\u30fc\u30b9\u30c8\u30c0\u30e1\u30fc\u30b8\u306e\u30d3\u30eb\u30c9\u306b\u50be\u3044\u3066\u3044\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u901a\u5e38\u3001\u300c\u5f71\u306e\u30b9\u30c6\u30c3\u30d7\u300d\u30b9\u30ad\u30eb\u306e\u3088\u3046\u306a\u79fb\u52d5\u901f\u5ea6\u3092\u5411\u4e0a\u3055\u305b\u308b\u80fd\u529b\u3092\u6301\u3064\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3068\u3001\u77ed\u6642\u9593\u3067\u5927\u304d\u306a\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u7279\u5b9a\u306e\u7a2e\u985e\u306e\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\u306e\u3088\u3046\u306a\u6b66\u5668\u3092\u7d44\u307f\u5408\u308f\u305b\u305f\u3082\u306e\u3067\u3059\u3002\u76ee\u7684\u306f\u3001\u8fc5\u901f\u306b\u8ddd\u96e2\u3092\u8a70\u3081\u3066\u3001\u30d0\u30fc\u30b9\u30c8\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u3066\u3001\u30ad\u30eb\u3092\u78ba\u5b9a\u3059\u308b\u304b\u3001\u64a4\u9000\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u3053\u306e\u30d3\u30eb\u30c9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u30ea\u30bd\u30fc\u30b9\u751f\u6210\u3092\u5411\u4e0a\u3055\u305b\u308b\u30b9\u30ad\u30eb\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u307e\u305f\u3001\u30af\u30fc\u30eb\u30c0\u30a6\u30f3\u3092\u77ed\u7e2e\u3059\u308b\u88c5\u5099\u3092\u88c5\u5099\u3059\u308b\u3053\u3068\u3092\u691c\u8a0e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30ec\u30a2\u306a\u30af\u30e9\u30d5\u30c8\u6750\u6599\u3092\u300e\u53ce\u96c6\u300f\u3059\u308b\u6700\u826f\u306e\u65b9\u6cd5\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u300e\u6700\u826f\u300f\u306e\u65b9\u6cd5\u306f\u72b6\u6cc1\u306b\u3088\u308b\u304c\u3001\u4e00\u822c\u7684\u306b\u4eba\u304c\u591a\u304f\u96c6\u307e\u308b\u5730\u57df\u304c\u6700\u3082\u671f\u5f85\u3067\u304d\u308b\u3002\u3053\u308c\u3089\u306e\u30a8\u30ea\u30a2\u306b\u306f\u3001\u53ce\u7a6b\u53ef\u80fd\u306a\u30ea\u30bd\u30fc\u30b9\u307e\u305f\u306f\u30ec\u30a2\u306a\u30c1\u30a7\u30b9\u30c8\u306e\u51fa\u73fe\u5834\u6240\u304c\u591a\u3044\u50be\u5411\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u306e\u60c5\u5831\u306f\u5927\u62b5\u3001\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u30d5\u30a9\u30fc\u30e9\u30e0\u306a\u3069\u3067\u5171\u6709\u3055\u308c\u3066\u3044\u307e\u3059\u3002\n\n\u30b9\u30c6\u30c3\u30d71\uff1a\u30ea\u30bd\u30fc\u30b9\u306e\u30db\u30c3\u30c8\u30b9\u30dd\u30c3\u30c8\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002\u53ce\u96c6\u53ef\u80fd\u306a\u30ea\u30bd\u30fc\u30b9\u307e\u305f\u306f\u5e0c\u5c11\u306a\u30c1\u30a7\u30b9\u30c8\u306e\u51fa\u73fe\u5834\u6240\u304c\u591a\u3044\u9818\u57df\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002\n\u30b9\u30c6\u30c3\u30d72\uff1a\u30eb\u30fc\u30c8\u3092\u6700\u9069\u5316\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30db\u30c3\u30c8\u30b9\u30dd\u30c3\u30c8\u3092\u52b9\u7387\u7684\u306b\u30ab\u30d0\u30fc\u3059\u308b\u30eb\u30fc\u30c8\u3092\u4f5c\u6210\u3057\u3001\u79fb\u52d5\u6642\u9593\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u30011\u6642\u9593\u306b\u53ce\u96c6\u3059\u308b\u6226\u5229\u54c1\u3092\u6700\u5927\u5316\u3057\u307e\u3059\u3002\n\u30b9\u30c6\u30c3\u30d73\uff1a\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u3092\u7ba1\u7406\u3057\u307e\u3059\u3002\u6700\u9ad8\u306e\u7d50\u679c\u3092\u5f97\u308b\u305f\u3081\u306b\u3001\u6b8b\u308a\u306e\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u306e\u30ad\u30e3\u30d1\u30b7\u30c6\u30a3\u3092\u8ffd\u8de1\u3057\u307e\u3059\u3002"}, {"question": "PC\u7248\u306e\u300e\u8ab0\u3067\u3057\u3087\u3046\u300f\u306e\u9032\u6357\u72b6\u6cc1\u3092\u30e2\u30d0\u30a4\u30eb\u7248\u306b\u79fb\u884c\u3059\u308b\u65b9\u6cd5\u3068\u3001\u5236\u9650\u4e8b\u9805\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u73fe\u5728\u3001PC\u7248\u3068\u30e2\u30d0\u30a4\u30eb\u7248\u306e\u9593\u3067\u76f4\u63a5\u9032\u6357\u72b6\u6cc1\u3092\u79fb\u884c\u3059\u308b\u3053\u3068\u306f\u3067\u304d\u307e\u305b\u3093\u3002\u4e21\u65b9\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u306f\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ea\u30f3\u30af\u3055\u308c\u3066\u3044\u307e\u3059\u304c\u3001\u305d\u308c\u305e\u308c\u72ec\u81ea\u306e\u9032\u6357\u30b7\u30b9\u30c6\u30e0\u3092\u6301\u3061\u3001\u72ec\u7acb\u3057\u305f\u5b58\u5728\u3068\u3057\u3066\u6a5f\u80fd\u3057\u3066\u3044\u307e\u3059\u3002\u305f\u3060\u3057\u3001\u958b\u767a\u30c1\u30fc\u30e0\u306f\u5c06\u6765\u3001\u30af\u30ed\u30b9\u30d7\u30ed\u30b0\u30ec\u30b9\u3092\u691c\u8a0e\u3057\u3066\u3044\u307e\u3059\u3002\u4ed6\u306e\u30b2\u30fc\u30e0\u304c\u3069\u306e\u3088\u3046\u306b\u5bfe\u5fdc\u3057\u3066\u3044\u308b\u304b\u3092\u793a\u3057\u3001\u3088\u308a\u660e\u78ba\u306b\u7406\u89e3\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3057\u305f\u3002\n\n[\u69cb\u6210\u6bd4\u8f03\u8868]\n\u30a2\u30ab\u30a6\u30f3\u30c8\u9023\u643a\uff1a\u4e21\u65b9\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u306f\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u63a5\u7d9a\u3055\u308c\u3066\u3044\u307e\u3059\n\u30a2\u30a4\u30c6\u30e0\u306e\u79fb\u52d5\uff1a\u3067\u304d\u307e\u305b\u3093\n\u88c5\u98fe\u54c1\uff1a\u79fb\u52d5\u53ef\u80fd\u3067\u3059\n\u30b7\u30fc\u30ba\u30f3\u30d1\u30b9\uff1a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u9069\u7528\u3055\u308c\u308b\u5834\u5408\u304c\u3042\u308b"}, {"question": "\u300e\u8a9e\u308a\u90e8\u300f\u3068\u3044\u3046NPC\u306f\u8ab0\u3067\u3059\u304b\uff1f\u79c1\u306f\u5f7c\u3089\u3092\u96a0\u308c\u305f\u5834\u6240\u3067\u898b\u3064\u3051\u307e\u3057\u305f\u304c\u3001\u5f7c\u3089\u306f\u79c1\u306b\u8b0e\u3081\u3044\u305f\u624b\u304c\u304b\u308a\u3057\u304b\u4e0e\u3048\u306a\u3044\u3067\u3044\u307e\u3059\u304b\uff1f", "answer": "\u300e\u8a9e\u308a\u90e8\u300f\u306f\u3001\u672a\u6307\u5b9a\u306e\u30b5\u30a4\u30c9\u30af\u30a8\u30b9\u30c8\u306e\u7cfb\u5217\u306b\u95a2\u308f\u308b\u96a0\u3055\u308c\u305fNPC\u3067\u3059\u3002\u5f7c\u3089\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u306f\u3001\u305d\u308c\u81ea\u4f53\u304c\u5927\u304d\u306a\u6210\u679c\u3067\u3059\uff01\u5f7c\u3089\u306f\u96a0\u308c\u305f\u30a8\u30ea\u30a2\u3001\u30e6\u30cb\u30fc\u30af\u306a\u30a2\u30a4\u30c6\u30e0\u3001\u307e\u305f\u306f\u9ad8\u5ea6\u306a\u30b9\u30ad\u30eb\u30a2\u30f3\u30ed\u30c3\u30af\u306b\u3064\u306a\u304c\u308b\u3001\u8b0e\u3081\u3044\u305f\u624b\u304c\u304b\u308a\u3092\u63d0\u4f9b\u3057\u3066\u304f\u308c\u307e\u3059\u3002\u91cd\u8981\u306a\u306e\u306f\u3001\u624b\u304c\u304b\u308a\u3092\u6ce8\u610f\u6df1\u304f\u305f\u3069\u308b\u3053\u3068\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u8a9e\u308a\u90e8\u304c\u300e\u53e4\u4ee3\u306e\u6728\u306e\u305d\u3070\u306b\u7720\u308b\u30c9\u30e9\u30b4\u30f3\u300f\u306e\u3053\u3068\u3092\u8a00\u53ca\u3057\u3066\u3044\u308b\u5834\u5408\u3001\u3053\u308c\u306f\u304a\u305d\u3089\u304f\u5357\u90e8\u306e\u5730\u57df\u306b\u3042\u308b\u5927\u304d\u306a\u30aa\u30fc\u30af\u306e\u6728\u306e\u65b9\u5411\u3092\u610f\u5473\u3057\u307e\u3059\u3002\u6fc0\u3057\u3044\u6226\u95d8\u306b\u5099\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u5f7c\u306f\u53e4\u5178\u7684\u306a\u300e\u4e88\u8a00\u8005\u300f\u306e\u30bf\u30a4\u30d7\u3067\u3059\u3002"}, {"question": "\u79c1\u306e\u300e\u30ad\u30eb/\u30c7\u30b9\u6bd4\u300f\u3092\u5411\u4e0a\u3055\u305b\u308b\u6700\u5584\u306e\u65b9\u6cd5\u306f\uff1f", "answer": "\u30ad\u30eb/\u30c7\u30b9\u6bd4\u3092\u5411\u4e0a\u3055\u305b\u308b\u306b\u306f\u3001\u6b66\u5668\u306e\u9078\u629e\u3001\u30de\u30c3\u30d7\u306e\u77e5\u8b58\u3001\u72b6\u6cc1\u5224\u65ad\u306e3\u3064\u306e\u8981\u7d20\u304c\u95a2\u308f\u3063\u3066\u304d\u307e\u3059\u3002\u4f7f\u3044\u6163\u308c\u305f\u6b66\u5668\u3092\u4f7f\u3044\u7d9a\u3051\u3001\u305d\u306e\u5f37\u307f\u3092\u6d3b\u304b\u3059\u3053\u3068\u3092\u5b66\u3073\u307e\u3057\u3087\u3046\u3002\u4e0d\u5229\u306a\u7acb\u5834\u3067\u6226\u3046\u306e\u306f\u907f\u3051\u307e\u3057\u3087\u3046\u3002\u30de\u30c3\u30d7\u306e\u77e5\u8b58\uff1a\u6575\u306e\u52d5\u304d\u3092\u4e88\u6e2c\u3067\u304d\u308b\u3088\u3046\u306b\u3001\u30de\u30c3\u30d7\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u5b66\u3073\u307e\u3057\u3087\u3046\u3002\u72b6\u6cc1\u5224\u65ad\uff1a\u97f3\u306e\u5146\u5019\u3068\u30df\u30cb\u30de\u30c3\u30d7\u306b\u6ce8\u610f\u3057\u3066\u6575\u3092\u8ffd\u8de1\u3057\u3001\u4e0d\u610f\u3092\u7a81\u304b\u308c\u306a\u3044\u3088\u3046\u306b\u3057\u307e\u3057\u3087\u3046\u3002\n\n[\u53ef\u8996\u5316]\n[\u30ad\u30eb/\u30c7\u30b9\u6bd4\u5411\u4e0a\u30eb\u30fc\u30d7\u3092\u793a\u3059\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u2192\u30de\u30c3\u30d7\u8a8d\u8b58\u2192\u512a\u308c\u305f\u6b66\u5668\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u2192\u8a08\u7b97\u3055\u308c\u305f\u30ea\u30b9\u30af\u2192\u5411\u4e0a\u3057\u305f\u30ad\u30eb/\u30c7\u30b9\u6bd4]"}, {"question": "\u306a\u305c\u300e\u30d5\u30ec\u30fc\u30e0\u30ec\u30fc\u30c8\u300f\u306f\u305d\u308c\u307b\u3069\u91cd\u8981\u306a\u306e\u3067\u3059\u304b\uff1f\u4e2d\u7a0b\u5ea6\u306ePC\u3067\u3088\u308a\u30b9\u30e0\u30fc\u30ba\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u305f\u3081\u306b\u3001\u3069\u306e\u3088\u3046\u306a\u8a2d\u5b9a\u3092\u8abf\u6574\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d5\u30ec\u30fc\u30e0\u30ec\u30fc\u30c8\u3068\u306f\u30011\u79d2\u9593\u306b\u753b\u9762\u306b\u8868\u793a\u3055\u308c\u308b\u753b\u50cf\u306e\u6570\u3067\u3042\u308a\u3001\u30b2\u30fc\u30e0\u306e\u6ed1\u3089\u304b\u3055\u3092\u6c7a\u5b9a\u3059\u308b\u91cd\u8981\u306a\u8981\u7d20\u3067\u3059\u3002\u30d5\u30ec\u30fc\u30e0\u30ec\u30fc\u30c8\u304c\u4f4e\u3044\u3068\u3001\u51e6\u7406\u304c\u304e\u3053\u3061\u306a\u304f\u306a\u3063\u3066\u3057\u307e\u3046\u305f\u3081\u3001\u7167\u6e96\u304c\u96e3\u3057\u304f\u306a\u308a\u307e\u3059\u3002\u4e2d\u7a0b\u5ea6\u306ePC\u3067\u306f\u3001\u4ee5\u4e0b\u306e\u8a2d\u5b9a\u3092\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\uff1a\n\n1. \u89e3\u50cf\u5ea6\u306e\u4f4e\u4e0b\uff1a\u30b2\u30fc\u30e0\u306e\u89e3\u50cf\u5ea6\u30921920x1080\u3001\u307e\u305f\u306f1600x900\u306b\u4e0b\u3052\u307e\u3059\u3002\n2. \u30c6\u30af\u30b9\u30c1\u30e3\u54c1\u8cea\u306e\u4f4e\u4e0b\uff1a\u3053\u306e\u8a2d\u5b9a\u3092\u4e0b\u3052\u308b\u3053\u3068\u3067\u3001\u5927\u5e45\u306a\u6539\u5584\u304c\u898b\u8fbc\u3081\u307e\u3059\u3002\n3. \u30b7\u30e3\u30c9\u30a6\u54c1\u8cea\uff1a\u30b7\u30e3\u30c9\u30a6\u54c1\u8cea\u3092\u4e0b\u3052\u308b\u304b\u3001\u30aa\u30d5\u306b\u3057\u307e\u3059\u3002\u5f7c\u3089\u306f\u975e\u5e38\u306b\u591a\u304f\u306e\u30ea\u30bd\u30fc\u30b9\u3092\u6d88\u8cbb\u3057\u307e\u3059\u3002\n4. \u30a2\u30f3\u30c1\u30a8\u30a4\u30ea\u30a2\u30b7\u30f3\u30b0\u306e\u7121\u52b9\u5316\uff1a\u30a2\u30f3\u30c1\u30a8\u30a4\u30ea\u30a2\u30b7\u30f3\u30b0\u306f\u30ae\u30b6\u30ae\u30b6\u306e\u30a8\u30c3\u30b8\u3092\u30b9\u30e0\u30fc\u30ba\u306b\u3057\u307e\u3059\u3002\u3057\u304b\u3057\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u305f\u3081\u3001\u7121\u52b9\u5316\u3059\u308b\u304b\u3001FXAA\u306a\u3069\u306e\u4f4e\u3044\u8a2d\u5b9a\u306b\u3057\u307e\u3059\u3002\u5177\u4f53\u7684\u306a\u6570\u5024\u3092\u78ba\u8a8d\u3057\u3001\u5404\u8a2d\u5b9a\u304c\u30b2\u30fc\u30e0\u306b\u3069\u308c\u307b\u3069\u6539\u5584\u3092\u4e0e\u3048\u308b\u306e\u304b\u3092\u898b\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u300e\u30a2\u30ea\u30fc\u30ca\u30e2\u30fc\u30c9\u300f\u3067\u7e70\u308a\u8fd4\u3057\u52dd\u5229\u3059\u308b\u3068\u3001\u30e6\u30cb\u30fc\u30af\u306a\u6b66\u5668\u56f3\u9762\u3092\u63d0\u4f9b\u3057\u3066\u304f\u308c\u308b\u3068\u5642\u3055\u308c\u3066\u3044\u308b\u4eba\u7269\u306f\u8ab0\u3067\u3059\u304b\uff1f\u4f55\u5ea6\u3082\u8a66\u3057\u307e\u3057\u305f\u304c\u3001\u6a19\u6e96\u901a\u8ca8\u3057\u304b\u96c6\u307e\u3063\u3066\u3044\u306a\u3044\u306e\u3067\u3059\u304c\u3002", "answer": "\u305d\u306eNPC\u306f\u300e\u30a2\u30ea\u30fc\u30ca\u30de\u30b9\u30bf\u30fc\u300f\u3068\u547c\u3070\u308c\u3066\u3044\u307e\u3059\u3002\u306f\u3044\u3001\u30e6\u30cb\u30fc\u30af\u306a\u56f3\u9762\u5831\u916c\u304c\u3042\u308a\u307e\u3059\u3002\u3057\u304b\u3057\u3001\u6570\u56de\u306e\u52dd\u5229\u3060\u3051\u3067\u4fdd\u8a3c\u3055\u308c\u308b\u308f\u3051\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u5341\u5206\u306b\u52dd\u5229\u3059\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u30c1\u30e3\u30f3\u30b9\u3092\u6700\u5927\u5316\u3059\u308b\u65b9\u6cd5\u306f\u3001\u9023\u7d9a\u3057\u305f\u30de\u30c3\u30c1\u3067\u52dd\u5229\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u3053\u308c\u306f\u30e6\u30cb\u30fc\u30af\u306a\u5831\u916c\u3092\u5f97\u308b\u78ba\u7387\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002\u30b2\u30fc\u30e0\u5185\u4f8b\uff1a\u3042\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u7279\u5b9a\u306e\u30ec\u30a2\u306a\u6761\u4ef6\u304c\u6709\u52b9\u306a\u72b6\u614b\u306725\u56de\u306e\u9023\u7d9a\u52dd\u5229\u3092\u53ce\u3081\u305f\u3053\u3068\u3067\u3001\u300c\u30d1\u30eb\u30b9\u30e9\u30a4\u30d5\u30eb\u300d\u56f3\u9762\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u307e\u3057\u305f\u3002\u3057\u304b\u3057\u3001\u5fcd\u8010\u5f37\u304f\u5f85\u3064\u5fc5\u8981\u304c\u3042\u308b\u3053\u3068\u3092\u899a\u3048\u3066\u304a\u304d\u307e\u3057\u3087\u3046\u3002\u3053\u308c\u306f\u6301\u7d9a\u7684\u306a\u30b9\u30ad\u30eb\u304c\u5fc5\u8981\u3067\u3059\uff01"}]
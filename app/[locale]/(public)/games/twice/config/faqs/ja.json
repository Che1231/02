[{"question": "Twice\uff1a\u30b2\u30fc\u30e0\u5185\u3067\u306e\u57fa\u672c\u653b\u6483\u3068\u79fb\u52d5\u65b9\u6cd5\u3092\u6559\u3048\u3066\u304f\u3060\u3055\u3044\uff08\u521d\u5fc3\u8005\u5411\u3051\uff09", "answer": "Twice\u306e\u57fa\u672c\u653b\u6483\u306f\u3001\u5de6\u30de\u30a6\u30b9\u30dc\u30bf\u30f3\u3067\u3059\u3002\u79fb\u52d5\u306fWASD\u30ad\u30fc\u3067\u884c\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300eW\u300f\u30ad\u30fc\u3092\u62bc\u3059\u3068\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u524d\u306b\u9032\u307f\u307e\u3059\u3002\u958b\u59cb\u30a8\u30ea\u30a2\u3067\u7df4\u7fd2\u3059\u308b\u3053\u3068\u3092\u5f37\u304f\u304a\u52e7\u3081\u3057\u307e\u3059\u3002\u3053\u306e\u57fa\u672c\u7684\u306a\u30b9\u30ad\u30eb\u306f\u3001Twice\u3067\u6226\u95d8\u3092\u5b66\u3076\u4e0a\u3067\u975e\u5e38\u306b\u91cd\u8981\u3067\u3042\u308a\u3001\u5c0f\u8aac\u3092\u66f8\u304f\u524d\u306b\u30a2\u30eb\u30d5\u30a1\u30d9\u30c3\u30c8\u3092\u5b66\u3076\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002[\u985e\u63a8\uff1a\u8d70\u308b\u3053\u3068\u306e\u524d\u306b\u6b69\u304f\u3053\u3068\u3092\u5b66\u3076]"}, {"question": "Twice\u306e\u7570\u306a\u308b\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30af\u30e9\u30b9\u3068\u305d\u306e\u4e2d\u3067\u521d\u5fc3\u8005\u306b\u304a\u3059\u3059\u3081\u306e\u30af\u30e9\u30b9\u306f\u3069\u308c\u3067\u3059\u304b\uff1f\uff08Twice\u30af\u30e9\u30b9\u30ac\u30a4\u30c9\uff09", "answer": "Twice\u306b\u306f\u3001\u6226\u58eb\u3001\u9b54\u6cd5\u4f7f\u3044\u3001\u5f13\u4f7f\u3044\u3001\u5fcd\u8005\u3068\u3044\u30464\u3064\u306e\u7570\u306a\u308b\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30af\u30e9\u30b9\u304c\u3042\u308a\u307e\u3059\u3002\u521d\u5fc3\u8005\u306b\u3068\u3063\u3066\u3001\u6226\u58eb\u306f\u8010\u4e45\u6027\u304c\u9ad8\u304f\u3001\u5358\u7d14\u306a\u8fd1\u63a5\u6226\u95d8\u3067\u3042\u308b\u305f\u3081\u6700\u9069\u3067\u3059\u3002\u9b54\u6cd5\u4f7f\u3044\u306f\u5f37\u529b\u3067\u3059\u304c\u3001HP\u304c\u4f4e\u3044\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u5f13\u4f7f\u3044\u3068\u5fcd\u8005\u306e\u65b9\u304c\u8907\u96d1\u3067\u3001\u3088\u308a\u9ad8\u5ea6\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u7d4c\u9a13\u304c\u5fc5\u8981\u3067\u3059\u3002[\u8a2d\u5b9a\u8868\uff1a\u30af\u30e9\u30b9/\u96e3\u6613\u5ea6/\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\uff08\u6226\u58eb\uff1a\u7c21\u5358\u3001\u8fd1\u63a5\u6226\uff09\u3001\uff08\u9b54\u6cd5\u4f7f\u3044\uff1a\u4e2d\u7d1a\u3001\u9060\u8ddd\u96e2\uff09\u3001\uff08\u5f13\u4f7f\u3044\uff1a\u4e0a\u7d1a\u3001\u9060\u8ddd\u96e2DPS\uff09\u3001\uff08\u5fcd\u8005\uff1a\u4e2d\u7d1a\u3001\u8fd1\u63a5DPS\uff09]"}, {"question": "Twice\uff1a\u30b2\u30fc\u30e0\u5e8f\u76e4\u3067\u5fc5\u8981\u306a\u56de\u5fa9\u85ac\u306f\u3069\u3053\u3067\u5165\u624b\u3067\u304d\u307e\u3059\u304b\uff1f\uff08\u5e8f\u76e4\u30ac\u30a4\u30c9\uff09", "answer": "Twice\u3067\u5fc5\u8981\u306a\u56de\u5fa9\u85ac\u306f\u3001\u30b2\u30fc\u30e0\u5e8f\u76e4\u3067\u3044\u304f\u3064\u304b\u306e\u5834\u6240\u304b\u3089\u5165\u624b\u3067\u304d\u307e\u3059\u3002\u30b9\u30bf\u30fc\u30c8\u30bf\u30a6\u30f3\u3092\u5fb9\u5e95\u7684\u306b\u8abf\u3079\u307e\u3057\u3087\u3046\u3002\u8ca9\u58f2\u54e1\u304c\u57fa\u672c\u7684\u306a\u85ac\u3092\u8ca9\u58f2\u3057\u3066\u304a\u308a\u3001\u5468\u56f2\u306b\u6563\u3089\u3070\u3063\u305f\u7bb1\u3084\u6a3d\u3092\u58ca\u3057\u3066\u85ac\u3092\u5165\u624b\u3059\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u3002\u307e\u305f\u3001\u30af\u30a8\u30b9\u30c8\u306e\u5831\u916c\u3068\u3057\u3066\u3082\u5165\u624b\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u753a\u9577\u304b\u3089\u6700\u521d\u306b\u4e0e\u3048\u3089\u308c\u308b\u30af\u30a8\u30b9\u30c8\u306f\u3001\u901a\u5e383\u3064\u306e\u56de\u5fa9\u85ac\u3067\u5831\u916c\u3092\u5f97\u307e\u3059\u3002[\u4f8b\uff1a\u753a\u9577\u6700\u521d\u306e\u30af\u30a8\u30b9\u30c8\u306f3\u3064\u306e\u56de\u5fa9\u85ac\u306e\u5831\u916c\u3067\u3042\u308b]\u3002"}, {"question": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30a8\u30f3\u30c7\u30a3\u30f3\u30b0\u3067Twice\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30d3\u30eb\u30c9\u3092\u6700\u5927\u30c0\u30e1\u30fc\u30b8\u51fa\u529b\u306e\u305f\u3081\u306b\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f\uff08\u30a8\u30f3\u30c7\u30a3\u30f3\u30b0\u30d3\u30eb\u30c9\u6700\u9069\u5316\uff09", "answer": "Twice\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30d3\u30eb\u30c9\u3092\u30a8\u30f3\u30c7\u30a3\u30f3\u30b0\u3067\u6700\u5927\u30c0\u30e1\u30fc\u30b8\u51fa\u529b\u306e\u305f\u3081\u306b\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u30b9\u30c6\u30fc\u30bf\u30b9\u914d\u5206\u3068\u88c5\u5099\u306e\u9078\u629e\u3092\u614e\u91cd\u306b\u884c\u3046\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u88c5\u5099\u306e\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u7387\u3068\u30c0\u30e1\u30fc\u30b8\u30b9\u30c6\u30fc\u30bf\u30b9\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u4e92\u3044\u306b\u76f8\u4e57\u52b9\u679c\u306e\u3042\u308b\u30b9\u30ad\u30eb\u3092\u9078\u629e\u3057\u3001\u30b3\u30f3\u30dc\u306e\u6a5f\u4f1a\u3092\u4f5c\u308a\u51fa\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30af\u30e9\u30d5\u30c8\u307e\u305f\u306f\u53d6\u5f15\u3092\u901a\u3058\u3066\u88c5\u5099\u3092\u5b9a\u671f\u7684\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u3001\u7d42\u76e4\u306b\u5411\u3051\u305f\u30d1\u30ef\u30fc\u30d0\u30e9\u30f3\u30b9\u3092\u7dad\u6301\u3057\u307e\u3057\u3087\u3046\u3002[\u30b9\u30c6\u30c3\u30d7\u30d0\u30a4\u30b9\u30c6\u30c3\u30d7\uff1a\u30c0\u30e1\u30fc\u30b8\u6700\u9069\u5316\u30d7\u30ed\u30bb\u30b9]"}, {"question": "Twice\u3067\u3001\u30d9\u30c6\u30e9\u30f3\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u8a71\u984c\u306b\u3059\u308b\u3001\u975e\u5e38\u306b\u96e3\u3057\u3044\u30dc\u30b9\u300c\u5f71\u306e\u9818\u4e3b\u300d\u3092\u5012\u3059\u305f\u3081\u306e\u6700\u9069\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f\uff08\u30dc\u30b9\u6226\u6226\u7565\uff09", "answer": "Twice\u3067\u5f71\u306e\u9818\u4e3b\u30dc\u30b9\u3092\u5012\u3059\u306b\u306f\u3001\u7dbf\u5bc6\u306a\u6226\u7565\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u653b\u6483\u30d1\u30bf\u30fc\u30f3\u3092\u7406\u89e3\u3057\u307e\u3057\u3087\u3046\u3002\u5f71\u306e\u9818\u4e3b\u306f\u983b\u7e41\u306b30\u79d2\u3054\u3068\u306b\u5f37\u529b\u306a\u7bc4\u56f2\u653b\u6483\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u5f8c\u308d\u304b\u3089DPS\u306b\u96c6\u4e2d\u3057\u3066\u3044\u308b\u9593\u30011\u4eba\u306f\u5f71\u306e\u9818\u4e3b\u306e\u6ce8\u610f\u3092\u5f15\u304d\u3001\u30bf\u30f3\u30af\u5f79\u3092\u4efb\u305b\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7bc4\u56f2\u653b\u6483\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u74b0\u5883\u3092\u6d3b\u7528\u3057\u3001\u5fc5\u8981\u306b\u5fdc\u3058\u3066\u518d\u7de8\u6210\u3057\u307e\u3057\u3087\u3046\u3002\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u304c\u91cd\u8981\u3067\u3059\uff01[\u30b9\u30c6\u30c3\u30d7\u30d0\u30a4\u30b9\u30c6\u30c3\u30d7\uff1a\u5f71\u306e\u9818\u4e3b\u653b\u7565\u6cd5]"}, {"question": "Twice\u306e\u3001\u30b3\u30f3\u30d7\u30ea\u30fc\u30c8\u3092\u76ee\u6307\u3059\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u8cb4\u91cd\u306a\u5831\u916c\u3068\u6311\u6226\u3092\u63d0\u4f9b\u3059\u308b\u96a0\u3055\u308c\u305f\u30af\u30a8\u30b9\u30c8\u3084\u79d8\u5bc6\u30a8\u30ea\u30a2\u306f\u3069\u3053\u3067\u3059\u304b\uff1f\uff08\u79d8\u5bc6\u30a8\u30ea\u30a2\u30ac\u30a4\u30c9\uff09", "answer": "Twice\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u30af\u30a8\u30b9\u30c8\u3068\u30a8\u30ea\u30a2\u304c\u3042\u308a\u3001\u305d\u308c\u305e\u308c\u306b\u72ec\u81ea\u306e\u5831\u916c\u304c\u3042\u308a\u307e\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u4f8b\u3068\u3057\u3066\u3001\u300c\u3055\u3055\u3084\u304d\u68ee\u300d\u8fd1\u304f\u306b\u3042\u308b\u4e00\u9023\u306e\u74b0\u5883\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u3053\u3068\u306b\u3088\u3063\u3066\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u300c\u53e4\u4ee3\u8056\u5802\u300d\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u306e\u30af\u30a8\u30b9\u30c8\u3092\u5b8c\u4e86\u3059\u308b\u3068\u3001\u5f37\u529b\u306a\u30a2\u30fc\u30c6\u30a3\u30d5\u30a1\u30af\u30c8\u304c\u3082\u3089\u3048\u3001\u3042\u306a\u305f\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002\u3053\u306e\u8056\u5802\u306f\u3001\u9806\u756a\u306b\u5149\u3001\u97f3\u3001\u52d5\u4f5c\u306b\u95a2\u3059\u308b3\u3064\u306e\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u9811\u5f35\u3063\u3066\u304f\u3060\u3055\u3044\uff01[\u4f8b\uff1a\u53e4\u4ee3\u8056\u5802\u30d1\u30ba\u30eb\u30af\u30a8\u30b9\u30c8]"}, {"question": "Twice\u306e\u300c\u9b54\u529b\u66b4\u8d70\u300d\u30b7\u30b9\u30c6\u30e0\u306f\u306a\u305c\u3053\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3059\u308b\u306e\u3067\u3057\u3087\u3046\u304b\u3002\u305d\u3057\u3066\u3001\u9b54\u529b\u56de\u5fa9\u3092\u8868\u3059\u5f0f\u306f\u3042\u308a\u307e\u3059\u304b\uff1f\uff08\u30b7\u30b9\u30c6\u30e0\u89e3\u5256\uff09", "answer": "Twice\u306e\u300c\u9b54\u529b\u66b4\u8d70\u300d\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u80fd\u529b\u306e\u4f7f\u7528\u3068\u6226\u7565\u7684\u306a\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u3092\u8abf\u6574\u3059\u308b\u3053\u3068\u3092\u76ee\u7684\u3068\u3057\u3066\u3044\u307e\u3059\u3002\u9b54\u529b\u306f5\u79d2\u3054\u3068\u306b\u518d\u751f\u3055\u308c\u307e\u3059\u3002\u88c5\u5099\u306e\u5f71\u97ff\u3092\u53d7\u3051\u308b\u4fee\u6b63\u304c\u3042\u308a\u307e\u3059\u3002\u5b9f\u969b\u306e\u5f0f\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\u3002\u9b54\u529b\u56de\u5fa9/\u79d2\u9593=\u57fa\u672c\u56de\u5fa9*(1+\u9b54\u529b\u56de\u5fa9\u30dc\u30fc\u30ca\u30b9%)\u3002\u672c\u8cea\u7684\u306b\u3001\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u306b\u5965\u884c\u304d\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002[\u5f0f\uff1a\u9b54\u529b\u56de\u5fa9\u5206\u6790]"}, {"question": "Twice\u306b\u304a\u3051\u308b\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u7387\u3068\u30c0\u30e1\u30fc\u30b8\u3092\u8a08\u7b97\u3059\u308b\u5185\u90e8\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f\uff08\u30c0\u30e1\u30fc\u30b8\u8a08\u7b97\u8a73\u7d30\uff09", "answer": "Twice\u306b\u304a\u3051\u308b\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u7387\u3068\u30c0\u30e1\u30fc\u30b8\u306f\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u3068\u88c5\u5099\u30dc\u30fc\u30ca\u30b9\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u8a08\u7b97\u3055\u308c\u307e\u3059\u3002\u57fa\u672c\u7684\u306a\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u7387\u306f5\uff05\u3067\u3042\u308a\u3001\u88c5\u5099\u3084\u30b9\u30ad\u30eb\u306b\u3088\u3063\u3066\u5897\u52a0\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u6700\u7d42\u7684\u306a\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30c0\u30e1\u30fc\u30b8\u500d\u7387\u306f\u3001(\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30c0\u30e1\u30fc\u30b8\u30dc\u30fc\u30ca\u30b9)+1 \u3068\u3057\u3066\u8a08\u7b97\u3055\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u300160%\u306e\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u7387\u306830%\u306e\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30c0\u30e1\u30fc\u30b8\u500d\u7387\u306e\u5834\u5408\u3001\u7d50\u679c\u7684\u306b130%\u306e\u30c0\u30e1\u30fc\u30b8\u309260%\u306e\u78ba\u7387\u3067\u4e0e\u3048\u308b\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002[\u30e1\u30ab\u30cb\u30ba\u30e0\uff1a\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30c0\u30e1\u30fc\u30b8\u5f0f]"}, {"question": "PC\u7248\u306eTwice\u304b\u3089\u30e2\u30d0\u30a4\u30eb\u7248\u306b\u5207\u308a\u66ff\u3048\u308b\u3068\u3001\u3059\u3079\u3066\u306e\u9032\u6357\u304c\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u4fdd\u5b58\u3055\u308c\u307e\u3059\u304b\uff1f\uff08\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30bb\u30fc\u30d6\uff09", "answer": "\u306f\u3044\u3001Twice\u306f\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u30bb\u30fc\u30d6\u306b\u5bfe\u5fdc\u3057\u3066\u3044\u307e\u3059\u3002PC\u7248\u3068\u30e2\u30d0\u30a4\u30eb\u7248\u306e\u4e21\u65b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30ec\u30d9\u30eb\u3001\u88c5\u5099\u3001\u30af\u30a8\u30b9\u30c8\u306e\u9032\u884c\u72b6\u6cc1\u306a\u3069\u3001\u3042\u306a\u305f\u306e\u9032\u6357\u72b6\u6cc1\u306f\u81ea\u52d5\u7684\u306b\u4e3b\u8981\u30b5\u30fc\u30d0\u30fc\u306b\u540c\u671f\u3055\u308c\u307e\u3059\u3002[\u30d7\u30ed\u30bb\u30b9\u30d5\u30ed\u30fc\uff1a\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30d7\u30ec\u30a4]"}, {"question": "Twice\u3067\u3001\u30b2\u30fc\u30e0\u5185\u3067\u6700\u3082\u30ec\u30a2\u306a\u30b3\u30b9\u30c1\u30e5\u30fc\u30e0\u3068\u5642\u3055\u308c\u3066\u3044\u308b\u300c\u5929\u4e0a\u306e\u30c9\u30e9\u30b4\u30f3\u300d\u30b9\u30ad\u30f3\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f\uff08\u30b3\u30b9\u30c1\u30e5\u30fc\u30e0\u6226\u7565\uff09", "answer": "Twice\u306e\u300c\u5929\u4e0a\u306e\u30c9\u30e9\u30b4\u30f3\u300d\u30b9\u30ad\u30f3\u306f\u3001\u975e\u5e38\u306b\u7a00\u3067\u3001\u975e\u5e38\u306b\u4eba\u6c17\u306e\u3042\u308b\u30b3\u30b9\u30c1\u30e5\u30fc\u30e0\u3067\u3059\u3002\u305d\u308c\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u306b\u306f\u3001\u4e00\u9023\u306e\u96a0\u308c\u305f\u5b9f\u7e3e\u3092\u9054\u6210\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u6bce\u9031\u6642\u9593\u9650\u5b9a\u306e\u30a2\u30a4\u30c6\u30e0/\u30c9\u30ed\u30c3\u30d7\u3092\u542b\u3080\u9577\u671f\u306e\u30b2\u30fc\u30e0\u5185\u5b9d\u63a2\u3057\u3067\u3059\u3002\u7279\u306b\u30011\u30f6\u6708\u5185\u306b\u3059\u3079\u3066\u306e\u30e6\u30cb\u30fc\u30af\u306a\u30af\u30a8\u30b9\u30c8\u30ec\u30ea\u30c3\u30af\u304c\u5fc5\u8981\u3067\u3059\u3002\u3053\u306e\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u306f\u6642\u9593\u5236\u9650\u4ed8\u304d\u3067\u3042\u308b\u3053\u3068\u306b\u6ce8\u610f\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002[\u96a0\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\uff1a\u30b3\u30b9\u30c1\u30e5\u30fc\u30e0\u30a2\u30f3\u30ed\u30c3\u30af]"}]
[{"question": "Twice: \u0995\u09bf\u09ad\u09be\u09ac\u09c7 \u0986\u09ae\u09bf \u0997\u09c7\u09ae\u09c7 \u09ae\u09cc\u09b2\u09bf\u0995 \u0986\u0995\u09cd\u09b0\u09ae\u09a3 \u098f\u09ac\u0982 \u099a\u09b2\u09be\u09ab\u09c7\u09b0\u09be \u0995\u09b0\u09ac? (\u09a8\u09a4\u09c1\u09a8\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8)", "answer": "Twice-\u098f \u09ae\u09cc\u09b2\u09bf\u0995 \u0986\u0995\u09cd\u09b0\u09ae\u09a3 \u0995\u09b0\u09a4\u09c7, \u09ac\u09be\u09ae \u09ae\u09be\u0989\u09b8 \u09ac\u09cb\u09a4\u09be\u09ae \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c1\u09a8\u0964 \u099a\u09b2\u09be\u099a\u09b2\u09c7\u09b0 \u099c\u09a8\u09cd\u09af WASD \u0995\u09c0 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c1\u09a8\u0964 \u0989\u09a6\u09be\u09b9\u09b0\u09a3\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa, 'W'-\u098f\u09b0 \u0993\u09aa\u09b0 \u099a\u09be\u09aa \u09a6\u09bf\u09b2\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u0995\u09cd\u09b7\u09b0\u099f\u09bf \u098f\u0997\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u09ac\u09c7\u0964 \u09b6\u09c1\u09b0\u09c1\u09b0 \u098f\u09b2\u09be\u0995\u09be\u09af\u09bc \u0985\u09a8\u09c1\u09b6\u09c0\u09b2\u09a8 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0985\u09a4\u09cd\u09af\u09a8\u09cd\u09a4 \u09b8\u09c1\u09aa\u09be\u09b0\u09bf\u09b6 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u0964 Twice-\u098f \u09af\u09c1\u09a6\u09cd\u09a7\u09c7 \u0985\u0997\u09cd\u09b0\u09b8\u09b0 \u098f\u09ac\u0982 \u09a6\u0995\u09cd\u09b7 \u09b9\u0993\u09af\u09bc\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u098f\u0987 \u09ae\u09cc\u09b2\u09bf\u0995 \u09a6\u0995\u09cd\u09b7\u09a4\u09be \u0985\u09a4\u09cd\u09af\u09a8\u09cd\u09a4 \u0997\u09c1\u09b0\u09c1\u09a4\u09cd\u09ac\u09aa\u09c2\u09b0\u09cd\u09a3\u0964 \u098f\u099f\u09bf\u09b0 \u09b8\u09be\u09a5\u09c7  \u098f\u0995\u099f\u09bf \u0989\u09aa\u09ae\u09be \u09b9\u09b2, \u0989\u09aa\u09a8\u09cd\u09af\u09be\u09b8 \u09b2\u09c7\u0996\u09be\u09b0 \u0986\u0997\u09c7 \u09ac\u09b0\u09cd\u09a3\u09ae\u09be\u09b2\u09be \u09b6\u09c7\u0996\u09be\u0964 [\u0989\u09aa\u09ae\u09be: \u09a6\u09cc\u09a1\u09bc\u09be\u09a8\u09cb\u09b0 \u0986\u0997\u09c7 \u09b9\u09be\u0981\u099f\u09be \u09b6\u09c7\u0996\u09be]"}, {"question": "Twice-\u098f \u09ac\u09bf\u09ad\u09bf\u09a8\u09cd\u09a8 \u099a\u09b0\u09bf\u09a4\u09cd\u09b0\u09c7\u09b0 \u09b6\u09cd\u09b0\u09c7\u09a3\u09c0 \u0995\u09c0 \u0995\u09c0 \u098f\u09ac\u0982 \u09a8\u09a4\u09c1\u09a8\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0995\u09cb\u09a8\u099f\u09bf \u09b8\u09ac\u099a\u09c7\u09af\u09bc\u09c7 \u09ad\u09be\u09b2\u09cb? (Twice \u09b6\u09cd\u09b0\u09c7\u09a3\u09c0\u09b0 \u0997\u09be\u0987\u09a1)", "answer": "Twice-\u098f \u099a\u09be\u09b0\u099f\u09bf \u09ad\u09bf\u09a8\u09cd\u09a8 \u099a\u09b0\u09bf\u09a4\u09cd\u09b0\u09c7\u09b0 \u09b6\u09cd\u09b0\u09c7\u09a3\u09c0 \u09b0\u09af\u09bc\u09c7\u099b\u09c7: \u09af\u09cb\u09a6\u09cd\u09a7\u09be, \u09ae\u09a8\u09cd\u09a4\u09cd\u09b0\u09c0, \u09a7\u09a8\u09c1\u09b0\u09cd\u09a7\u09be\u09b0\u09c0 \u098f\u09ac\u0982 \u099a\u09cb\u09b0\u0964 \u09a8\u09a4\u09c1\u09a8\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af, \u09af\u09cb\u09a6\u09cd\u09a7\u09be \u09b8\u09b0\u09cd\u09ac\u09cb\u09a4\u09cd\u09a4\u09ae \u0995\u09be\u09b0\u09a3 \u098f\u099f\u09bf\u09b0 \u09b8\u09cd\u09ac\u09be\u09b8\u09cd\u09a5\u09cd\u09af \u09ac\u09c7\u09b6\u09bf \u098f\u09ac\u0982 \u09b8\u09b0\u09b2 \u09b9\u09be\u09a4\u09be\u09b9\u09be\u09a4\u09bf \u09af\u09c1\u09a6\u09cd\u09a7\u0964 \u09ae\u09a8\u09cd\u09a4\u09cd\u09b0\u09c0 \u09b6\u0995\u09cd\u09a4\u09bf\u09b6\u09be\u09b2\u09c0 \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u09a4\u09be\u09b0 HP \u0995\u09ae\u0964 \u09a7\u09a8\u09c1\u09b0\u09cd\u09a7\u09be\u09b0\u09c0 \u098f\u09ac\u0982 \u099a\u09cb\u09b0 \u0986\u09b0\u0993 \u099c\u099f\u09bf\u09b2 \u098f\u09ac\u0982 \u0986\u09b0\u0993 \u0989\u09a8\u09cd\u09a8\u09a4 \u0997\u09c7\u09ae\u09bf\u0982 \u0985\u09ad\u09bf\u099c\u09cd\u099e\u09a4\u09be \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u0964 [\u0995\u09a8\u09ab\u09bf\u0997\u09be\u09b0\u09c7\u09b6\u09a8 \u099f\u09c7\u09ac\u09bf\u09b2: \u09b6\u09cd\u09b0\u09c7\u09a3\u09c0 / \u0995\u09a0\u09bf\u09a8\u09a4\u09be / \u0996\u09c7\u09b2\u09be\u09b0 \u09a7\u09b0\u09a3 (\u09af\u09cb\u09a6\u09cd\u09a7\u09be: \u09b8\u09b9\u099c, \u09b9\u09be\u09a4\u09be\u09b9\u09be\u09a4\u09bf), (\u09ae\u09a8\u09cd\u09a4\u09cd\u09b0\u09c0: \u09ae\u09be\u099d\u09be\u09b0\u09bf, \u09a6\u09c2\u09b0\u09aa\u09be\u09b2\u09cd\u09b2\u09be\u09b0), (\u09a7\u09a8\u09c1\u09b0\u09cd\u09a7\u09be\u09b0\u09c0: \u0995\u09a0\u09bf\u09a8, \u09a6\u09c2\u09b0\u09aa\u09be\u09b2\u09cd\u09b2\u09be\u09b0 DPS), (\u099a\u09cb\u09b0: \u09ae\u09be\u099d\u09be\u09b0\u09bf, \u09b9\u09be\u09a4\u09be\u09b9\u09be\u09a4\u09bf DPS)]"}, {"question": "Twice-\u098f \u0997\u09c7\u09ae\u09c7\u09b0 \u09b6\u09c1\u09b0\u09c1\u09a4\u09c7 \u0995\u09cb\u09a5\u09be\u09af\u09bc \u099c\u09b0\u09c1\u09b0\u09c0 \u09b8\u09ae\u09cd\u09aa\u09a6 \u09af\u09c7\u09ae\u09a8 \u09b8\u09cd\u09ac\u09be\u09b8\u09cd\u09a5\u09cd\u09af\u09c7\u09b0 \u09ac\u09bf\u0995\u09be\u09b6 \u09aa\u09be\u09a8? (\u09b6\u09c1\u09b0\u09c1\u09b0 \u0997\u09c7\u09ae \u0997\u09be\u0987\u09a1)", "answer": "Twice-\u098f \u0997\u09c7\u09ae\u09c7\u09b0 \u09b6\u09c1\u09b0\u09c1\u09b0 \u09a6\u09bf\u0995\u09c7 \u099c\u09b0\u09c1\u09b0\u09c0 \u09b8\u09ae\u09cd\u09aa\u09a6 \u09af\u09c7\u09ae\u09a8 \u09b8\u09cd\u09ac\u09be\u09b8\u09cd\u09a5\u09cd\u09af\u09c7\u09b0 \u09ac\u09bf\u0995\u09be\u09b6 \u09aa\u09c7\u09a4\u09c7 \u09ac\u09c7\u09b6 \u0995\u09af\u09bc\u09c7\u0995\u099f\u09bf \u09b8\u09cd\u09a5\u09be\u09a8 \u0986\u099b\u09c7\u0964 \u09b6\u09c1\u09b0\u09c1\u09b0 \u09b6\u09b9\u09b0\u09c7 \u09ad\u09be\u09b2\u09cb\u09ad\u09be\u09ac\u09c7 \u0996\u09c1\u0981\u099c\u09c7 \u09a6\u09c7\u0996\u09c1\u09a8; \u09ac\u09bf\u0995\u09cd\u09b0\u09c7\u09a4\u09be\u09b0\u09be \u09ae\u09cc\u09b2\u09bf\u0995 \u09ac\u09bf\u0995\u09be\u09b6 \u09ac\u09bf\u0995\u09cd\u09b0\u09bf \u0995\u09b0\u09c7 \u098f\u09ac\u0982 \u098f\u09b2\u09be\u0995\u09be \u099c\u09c1\u09a1\u09bc\u09c7 \u099b\u09a1\u09bc\u09bf\u09af\u09bc\u09c7 \u099b\u09bf\u099f\u09bf\u09af\u09bc\u09c7 \u09a5\u09be\u0995\u09be \u09ac\u09be\u0995\u09cd\u09b8 \u098f\u09ac\u0982 \u09aa\u09bf\u09af\u09bc\u09be\u09b0 \u0996\u09c1\u09b2\u09c1\u09a8\u0964 \u0986\u09aa\u09a8\u09bf \u098f\u0997\u09c1\u09b2\u09bf \u0995\u09c1\u09af\u09bc\u09c7\u09b8\u09cd\u099f \u09aa\u09c1\u09b0\u09b8\u09cd\u0995\u09be\u09b0 \u09b9\u09bf\u09b8\u09c7\u09ac\u09c7\u0993 \u09aa\u09c7\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964 \u0989\u09a6\u09be\u09b9\u09b0\u09a3\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa, \u09b6\u09b9\u09b0\u09c7\u09b0 \u09ac\u09c3\u09a6\u09cd\u09a7\u09c7\u09b0 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09aa\u09cd\u09b0\u09a5\u09ae \u0995\u09c1\u09af\u09bc\u09c7\u09b8\u09cd\u099f \u09b8\u09be\u09a7\u09be\u09b0\u09a3\u09a4 \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u09e9 \u099f\u09bf \u09b8\u09cd\u09ac\u09be\u09b8\u09cd\u09a5\u09cd\u09af\u09c7\u09b0 \u09ac\u09bf\u0995\u09be\u09b6 \u09aa\u09c1\u09b0\u09b8\u09cd\u0995\u09be\u09b0 \u09a6\u09c7\u09af\u09bc\u0964 [\u0989\u09a6\u09be\u09b9\u09b0\u09a3: \u09b6\u09b9\u09b0\u09c7\u09b0 \u09ac\u09c3\u09a6\u09cd\u09a7\u09be\u09b0 \u09aa\u09cd\u09b0\u09a5\u09ae \u0995\u09c1\u09af\u09bc\u09c7\u09b8\u09cd\u099f \u09aa\u09c1\u09b0\u09b8\u09cd\u0995\u09be\u09b0 \u09e9 \u099f\u09bf \u09b8\u09cd\u09ac\u09be\u09b8\u09cd\u09a5\u09cd\u09af \u09ac\u09bf\u0995\u09be\u09b6]"}, {"question": "\u09b6\u09c7\u09b7 \u09aa\u09b0\u09cd\u09af\u09be\u09af\u09bc\u09c7 \u09b8\u09b0\u09cd\u09ac\u09cb\u099a\u09cd\u099a \u0995\u09cd\u09b7\u09a4\u09bf\u09b0 \u099c\u09a8\u09cd\u09af \u0985\u0997\u09cd\u09b0\u09b8\u09b0 \u0993\u099c\u09a8\u09c7\u09b0 \u0996\u09c7\u09b2\u09cb\u09af\u09bc\u09be\u09a1\u09bc\u09b0\u09be \u09a4\u09be\u09a6\u09c7\u09b0 Twice \u0985\u0995\u09cd\u09b7\u09b0\u09c7\u09b0 \u09ac\u09bf\u09b2\u09cd\u09a1 \u0995\u09c7\u09ae\u09a8 \u0995\u09b0\u09c7 \u0985\u09aa\u09cd\u099f\u09bf\u09ae\u09be\u0987\u099c \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7? (\u09b6\u09c7\u09b7 \u09aa\u09b0\u09cd\u09af\u09be\u09af\u09bc\u09c7\u09b0 \u09ac\u09bf\u09b2\u09cd\u09a1 \u0985\u09aa\u09cd\u099f\u09bf\u09ae\u09be\u0987\u099c\u09c7\u09b6\u09be\u09a8)", "answer": "\u09b6\u09c7\u09b7 \u09aa\u09b0\u09cd\u09af\u09be\u09af\u09bc\u09c7 \u09b8\u09b0\u09cd\u09ac\u09cb\u099a\u09cd\u099a \u0995\u09cd\u09b7\u09a4\u09bf\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09aa\u09a8\u09be\u09b0 Twice \u0985\u0995\u09cd\u09b7\u09b0\u09c7\u09b0 \u09ac\u09bf\u09b2\u09cd\u09a1 \u0985\u09aa\u09cd\u099f\u09bf\u09ae\u09be\u0987\u099c \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u09b8\u09be\u09ac\u09a7\u09be\u09a8\u09c7 \u09aa\u09b0\u09bf\u09b8\u0982\u0996\u09cd\u09af\u09be\u09a8 \u09ac\u09a3\u09cd\u099f\u09a8 \u098f\u09ac\u0982 \u0997\u09bf\u09af\u09bc\u09be\u09b0 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964 \u09a7\u09be\u09aa \u09e7: \u0986\u09aa\u09a8\u09be\u09b0 \u0997\u09bf\u09af\u09bc\u09be\u09b0\u09c7 \u0997\u09c1\u09b0\u09c1\u09a4\u09cd\u09ac\u09aa\u09c2\u09b0\u09cd\u09a3 \u09b9\u09bf\u099f\u09c7\u09b0 \u09b8\u09ae\u09cd\u09ad\u09be\u09ac\u09a8\u09be \u098f\u09ac\u0982 \u0995\u09cd\u09b7\u09a4\u09bf\u09b0 \u09aa\u09b0\u09bf\u09b8\u0982\u0996\u09cd\u09af\u09be\u09a8\u09c7\u09b0 \u0989\u09aa\u09b0 \u09ab\u09cb\u0995\u09be\u09b8 \u0995\u09b0\u09c1\u09a8\u0964 \u09a7\u09be\u09aa \u09e8: \u098f\u0995\u09c7 \u0985\u09aa\u09b0\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b8\u09b9\u09af\u09cb\u0997\u09c0\u09a4\u09be \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09be \u09a6\u0995\u09cd\u09b7\u09a4\u09be \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8, \u09af\u09be \u0995\u09ae\u09cd\u09ac\u09cb \u09b8\u09c1\u09af\u09cb\u0997 \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09c7\u0964 \u09a7\u09be\u09aa \u09e9: \u0995\u09cd\u09b0\u09be\u09ab\u09cd\u099f\u09bf\u0982 \u09ac\u09be \u099f\u09cd\u09b0\u09c7\u09a1\u09bf\u0982-\u098f\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u09a8\u09bf\u09af\u09bc\u09ae\u09bf\u09a4 \u0986\u09aa\u09a8\u09be\u09b0 \u0997\u09bf\u09af\u09bc\u09be\u09b0\u09c7\u09b0 \u0989\u09a8\u09cd\u09a8\u09a4\u09bf \u0995\u09b0\u09c1\u09a8, \u09b6\u09c7\u09b7 \u09aa\u09b0\u09cd\u09af\u09be\u09af\u09bc\u09c7 \u09b6\u0995\u09cd\u09a4\u09bf \u09b8\u09be\u09ae\u09cd\u09af \u09ac\u099c\u09be\u09af\u09bc \u09b0\u09be\u0996\u09a4\u09c7\u0964 [\u09a7\u09be\u09aa\u09c7 \u09a7\u09be\u09aa\u09c7: \u0995\u09cd\u09b7\u09a4\u09bf\u09b0 \u0985\u09aa\u09cd\u099f\u09bf\u09ae\u09be\u0987\u099c\u09c7\u09b6\u09be\u09a8 \u09aa\u09cd\u09b0\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be]"}, {"question": "Twice-\u098f \u0996\u09cd\u09af\u09be\u09a4\u09bf\u09ae\u09be\u09a8 \u0995\u09a0\u09bf\u09a8 '\u099b\u09be\u09af\u09bc\u09be \u09b2\u09b0\u09cd\u09a1' \u09ac\u09b8\u0995\u09c7 \u09aa\u09b0\u09be\u099c\u09bf\u09a4 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u09b0\u09cd\u09ac\u09cb\u09a4\u09cd\u09a4\u09ae \u0995\u09cc\u09b6\u09b2\u0997\u09c1\u09b2\u09bf \u0995\u09c0 \u0995\u09c0?  (\u09ac\u09b8\u09c7\u09b0 \u09af\u09c1\u09a6\u09cd\u09a7 \u0995\u09cc\u09b6\u09b2)", "answer": "Twice-\u098f \u099b\u09be\u09af\u09bc\u09be \u09b2\u09b0\u09cd\u09a1 \u09ac\u09b8\u0995\u09c7 \u09aa\u09b0\u09be\u099c\u09bf\u09a4 \u0995\u09b0\u09a4\u09c7 \u098f\u0995\u099f\u09bf \u09ad\u09be\u09b2\u09ad\u09be\u09ac\u09c7 \u09b8\u09ae\u09a8\u09cd\u09ac\u09bf\u09a4 \u0995\u09cc\u09b6\u09b2 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u0964 \u09a7\u09be\u09aa \u09e7: \u098f\u09b0 \u0986\u0995\u09cd\u09b0\u09ae\u09a3\u09c7\u09b0 \u09a7\u09b0\u09a3 \u09ac\u09c1\u099d\u09c1\u09a8; \u099b\u09be\u09af\u09bc\u09be \u09b2\u09b0\u09cd\u09a1 \u09aa\u09cd\u09b0\u09be\u09af\u09bc \u09e9\u09e6 \u09b8\u09c7\u0995\u09c7\u09a8\u09cd\u09a1 \u0985\u09a8\u09cd\u09a4\u09b0 \u098f\u0995\u099f\u09bf \u09b6\u0995\u09cd\u09a4\u09bf\u09b6\u09be\u09b2\u09c0 AoE \u0986\u0995\u09cd\u09b0\u09ae\u09a3 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7\u0964 \u09a7\u09be\u09aa \u09e8: \u0985\u09a8\u09cd\u09af\u09b0\u09be \u09af\u09a4\u0995\u09cd\u09b7\u09a3 \u09a6\u09cd\u09ac\u09bf\u09a4\u09c0\u09af\u09bc \u09b2\u09be\u0987\u09a8 \u09a5\u09c7\u0995\u09c7 DPS-\u098f\u09b0 \u0989\u09aa\u09b0 \u09ab\u09cb\u0995\u09be\u09b8 \u0995\u09b0\u09ac\u09c7, \u098f\u0995\u099f\u09bf \u099f\u09cd\u09af\u09be\u0982\u0995\u09c7 \u099b\u09be\u09af\u09bc\u09be \u09b2\u09b0\u09cd\u09a1\u09c7\u09b0 \u09a6\u09bf\u0995\u09c7 \u09a6\u09c3\u09b7\u09cd\u099f\u09bf \u0986\u0995\u09b0\u09cd\u09b7\u09a3 \u0995\u09b0\u09be\u09b0 \u09a6\u09be\u09af\u09bc\u09bf\u09a4\u09cd\u09ac \u09a6\u09bf\u09a8\u0964 \u09a7\u09be\u09aa \u09e9:  AoE \u098f\u09a1\u09bc\u09be\u09a8\u09cb\u09b0 \u099c\u09a8\u09cd\u09af \u09aa\u09b0\u09bf\u09ac\u09c7\u09b6 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c1\u09a8 \u098f\u09ac\u0982 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8 \u0985\u09a8\u09c1\u09af\u09be\u09af\u09bc\u09c0 \u09aa\u09c1\u09a8\u09b0\u09be\u09af\u09bc \u0997\u09cd\u09b0\u09c1\u09aa \u0995\u09b0\u09c1\u09a8\u0964 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0985\u09a4\u09cd\u09af\u09a8\u09cd\u09a4 \u0997\u09c1\u09b0\u09c1\u09a4\u09cd\u09ac\u09aa\u09c2\u09b0\u09cd\u09a3! [\u09a7\u09be\u09aa\u09c7 \u09a7\u09be\u09aa\u09c7: \u099b\u09be\u09af\u09bc\u09be \u09b2\u09b0\u09cd\u09a1 \u09aa\u09b0\u09be\u099c\u09af\u09bc]"}, {"question": "Twice-\u098f \u0995\u09cb\u09a8 \u0997\u09cb\u09aa\u09a8 \u0995\u09c1\u09af\u09bc\u09c7\u09b8\u09cd\u099f \u09ac\u09be \u0997\u09cb\u09aa\u09a8 \u098f\u09b2\u09be\u0995\u09be\u0997\u09c1\u09b2\u09bf \u09b8\u09ae\u09cd\u09aa\u09a8\u09cd\u09a8\u0995\u09be\u09b0\u09c0 \u0997\u09c7\u09ae\u09be\u09b0\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0985\u09a8\u09a8\u09cd\u09af \u09aa\u09c1\u09b0\u09b7\u09cd\u0995\u09be\u09b0 \u098f\u09ac\u0982 \u099a\u09cd\u09af\u09be\u09b2\u09c7\u099e\u09cd\u099c \u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u0995\u09b0\u09c7? (\u0997\u09cb\u09aa\u09a8 \u098f\u09b2\u09be\u0995\u09be\u09b0 \u0997\u09be\u0987\u09a1)", "answer": "Twice-\u098f \u09ac\u09c7\u09b6 \u0995\u09af\u09bc\u09c7\u0995\u099f\u09bf \u0997\u09cb\u09aa\u09a8 \u0995\u09c1\u09af\u09bc\u09c7\u09b8\u09cd\u099f \u098f\u09ac\u0982 \u098f\u09b2\u09be\u0995\u09be \u0986\u099b\u09c7 \u09af\u09be \u0985\u09a8\u09a8\u09cd\u09af \u09aa\u09c1\u09b0\u09b7\u09cd\u0995\u09be\u09b0 \u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u0995\u09b0\u09c7\u0964 \u098f\u0995\u099f\u09bf \u0989\u09b2\u09cd\u09b2\u09c7\u0996\u09af\u09cb\u0997\u09cd\u09af \u0989\u09a6\u09be\u09b9\u09b0\u09a3 \u09b9\u09b2 '\u09ac\u09c3\u09a6\u09cd\u09a7\u09a6\u09c7\u09b0 \u09b9\u09be\u09b0\u09be\u09a8\u09cb \u09ae\u09a8\u09cd\u09a6\u09bf\u09b0', \u09af\u09be \u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09b0 \u09ab\u09bf\u09b8\u09ab\u09bf\u09b8 \u0995\u09b0\u09be\u09b0 \u09ac\u09a8 \u098f\u09b0 \u0995\u09be\u099b\u09c7 \u098f\u0995\u099f\u09bf \u09b8\u09bf\u09b0\u09bf\u099c\u09c7\u09b0 \u09aa\u09b0\u09bf\u09ac\u09c7\u09b6\u0997\u09a4 \u09aa\u09be\u099c\u09b2 \u09b8\u09ae\u09be\u09a7\u09be\u09a8 \u0995\u09b0\u09c7 \u09aa\u09cc\u0981\u099b\u09be\u09a8\u09cb \u09af\u09be\u09af\u09bc\u0964 \u098f\u0987 \u0995\u09c1\u09af\u09bc\u09c7\u09b8\u09cd\u099f \u09b8\u09ae\u09cd\u09aa\u09a8\u09cd\u09a8 \u0995\u09b0\u09b2\u09c7 \u098f\u0995\u099f\u09bf \u09b6\u0995\u09cd\u09a4\u09bf\u09b6\u09be\u09b2\u09c0 \u0986\u09b0\u09cd\u099f\u09bf\u09ab\u09cd\u09af\u09be\u0995\u09cd\u099f \u09aa\u09c1\u09b0\u09b8\u09cd\u0995\u09be\u09b0 \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09b9\u09af\u09bc, \u09af\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09b0\u09bf\u09b8\u0982\u0996\u09cd\u09af\u09be\u09a8 \u0989\u09b2\u09cd\u09b2\u09c7\u0996\u09af\u09cb\u0997\u09cd\u09af\u09ad\u09be\u09ac\u09c7 \u0989\u09a8\u09cd\u09a8\u09a4 \u0995\u09b0\u09c7\u0964 \u09ae\u09a8\u09cd\u09a6\u09bf\u09b0\u09c7 \u0986\u09b2\u09cb, \u09b6\u09ac\u09cd\u09a6 \u098f\u09ac\u0982 \u099a\u09b2\u09be\u099a\u09b2\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09bf\u09a4 \u09e9\u099f\u09bf \u09aa\u09be\u099c\u09b2 \u0995\u09cd\u09b0\u09ae\u09bf\u0995\u09ad\u09be\u09ac\u09c7 \u09b8\u09ae\u09be\u09a7\u09be\u09a8 \u0995\u09b0\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964 \u09ad\u09be\u0997\u09cd\u09af\u0995\u09cd\u09b0\u09ae\u09c7! [\u0989\u09a6\u09be\u09b9\u09b0\u09a3: \u09b9\u09be\u09b0\u09be\u09a8\u09cb \u09ae\u09a8\u09cd\u09a6\u09bf\u09b0\u09c7\u09b0 \u09aa\u09be\u099c\u09b2 \u0995\u09c1\u09af\u09bc\u09c7\u09b8\u09cd\u099f]"}, {"question": "'\u09ae\u09a8\u09cd\u09a4\u09cd\u09b0\u09c7\u09b0 \u099d\u09a1\u09bc' \u09ac\u09cd\u09af\u09ac\u09b8\u09cd\u09a5\u09be Twice-\u098f \u0995\u09c7\u09a8 \u098f\u09ad\u09be\u09ac\u09c7 \u0995\u09be\u099c \u0995\u09b0\u09c7 \u098f\u09ac\u0982 \u0995\u09bf \u0995\u09cb\u09a8 \u09b8\u09c2\u09a4\u09cd\u09b0 \u0986\u099b\u09c7 \u09af\u09be \u09ae\u09a8\u09cd\u09a4\u09cd\u09b0\u09c7\u09b0 \u09aa\u09c1\u09a8\u09b0\u09cd\u099c\u09a8\u09cd\u09ae \u09ac\u09b0\u09cd\u09a3\u09a8\u09be \u0995\u09b0\u09c7? (\u09ac\u09cd\u09af\u09ac\u09b8\u09cd\u09a5\u09be\u09b0 \u09ac\u09bf\u09b6\u09cd\u09b2\u09c7\u09b7\u09a3)", "answer": "Twice-\u098f\u09b0 '\u09ae\u09a8\u09cd\u09a4\u09cd\u09b0\u09c7\u09b0 \u099d\u09a1\u09bc' \u09ac\u09cd\u09af\u09ac\u09b8\u09cd\u09a5\u09be \u0995\u09cd\u09b7\u09ae\u09a4\u09be \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u098f\u09ac\u0982 \u0995\u09cc\u09b6\u09b2\u0997\u09a4 \u09b8\u09ae\u09cd\u09aa\u09a6 \u09ac\u09cd\u09af\u09ac\u09b8\u09cd\u09a5\u09be\u09aa\u09a8\u09be\u0995\u09c7 \u09a8\u09bf\u09af\u09bc\u09a8\u09cd\u09a4\u09cd\u09b0\u09a3 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09a1\u09bf\u099c\u09be\u0987\u09a8 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u0964  \u0997\u09bf\u09af\u09bc\u09be\u09b0 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09aa\u09cd\u09b0\u09ad\u09be\u09ac\u09bf\u09a4 \u09b8\u0982\u09b6\u09cb\u09a7\u0995\u0997\u09c1\u09b2\u09bf\u09b0 \u09b8\u09be\u09a5\u09c7 \u09ae\u09a8\u09cd\u09a4\u09cd\u09b0 \u09eb \u09b8\u09c7\u0995\u09c7\u09a8\u09cd\u09a1\u09c7\u09b0 \u099f\u09bf\u0995 \u0987\u09a8\u09cd\u099f\u09be\u09b0\u09ad\u09be\u09b2\u09c7 \u09aa\u09c1\u09a8\u09b0\u09cd\u099c\u09a8\u09cd\u09ae \u09b9\u09af\u09bc\u0964 \u09aa\u09cd\u09b0\u0995\u09c3\u09a4 \u09b8\u09c2\u09a4\u09cd\u09b0 \u09b9\u09b2: \u09ae\u09a8\u09cd\u09a4\u09cd\u09b0\u09c7\u09b0 \u09aa\u09c1\u09a8\u09b0\u09cd\u099c\u09a8\u09cd\u09ae/\u099f\u09bf\u0995 = \u09ac\u09c7\u09b8 \u09aa\u09c1\u09a8\u09b0\u09cd\u099c\u09a8\u09cd\u09ae * (\u09e7 + \u09ae\u09a8\u09cd\u09a4\u09cd\u09b0\u09c7\u09b0 \u09aa\u09c1\u09a8\u09b0\u09cd\u099c\u09a8\u09cd\u09ae \u09ac\u09cb\u09a8\u09be\u09b8%)\u0964 \u09b8\u0982\u0995\u09cd\u09b7\u09c7\u09aa\u09c7, \u098f\u0987 \u09ac\u09cd\u09af\u09ac\u09b8\u09cd\u09a5\u09be \u09b8\u09ae\u09cd\u09aa\u09a6 \u09ac\u09cd\u09af\u09ac\u09b8\u09cd\u09a5\u09be\u09aa\u09a8\u09be\u09af\u09bc \u0997\u09ad\u09c0\u09b0\u09a4\u09be \u09af\u09cb\u0997 \u0995\u09b0\u09c7\u0964 [\u09b8\u09c2\u09a4\u09cd\u09b0: \u09ae\u09a8\u09cd\u09a4\u09cd\u09b0\u09c7\u09b0 \u09aa\u09c1\u09a8\u09b0\u09cd\u099c\u09a8\u09cd\u09ae \u09ac\u09bf\u09b6\u09cd\u09b2\u09c7\u09b7\u09a3]"}, {"question": "Twice-\u098f \u09b8\u09ae\u09be\u09b2\u09cb\u099a\u09a8\u09be\u09ae\u09c2\u09b2\u0995 \u09b9\u09bf\u099f\u09c7\u09b0 \u09b8\u09ae\u09cd\u09ad\u09be\u09ac\u09a8\u09be \u098f\u09ac\u0982 \u0995\u09cd\u09b7\u09a4\u09bf \u0997\u09a3\u09a8\u09be \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0985\u09ad\u09cd\u09af\u09a8\u09cd\u09a4\u09b0\u09c0\u09a3 \u09af\u09be\u09a8\u09cd\u09a4\u09cd\u09b0\u09bf\u0995\u09a4\u09be\u0997\u09c1\u09b2\u09bf \u0995\u09c0 \u0995\u09c0? (\u0995\u09cd\u09b7\u09a4\u09bf\u09b0 \u0997\u09a3\u09a8\u09be \u0997\u09ad\u09c0\u09b0 \u09a1\u09be\u0987\u09ad)", "answer": "Twice-\u098f \u09b8\u09ae\u09be\u09b2\u09cb\u099a\u09a8\u09be\u09ae\u09c2\u09b2\u0995 \u09b9\u09bf\u099f\u09c7\u09b0 \u09b8\u09ae\u09cd\u09ad\u09be\u09ac\u09a8\u09be \u098f\u09ac\u0982 \u0995\u09cd\u09b7\u09a4\u09bf \u099a\u09b0\u09bf\u09a4\u09cd\u09b0\u09c7\u09b0 \u09aa\u09b0\u09bf\u09b8\u0982\u0996\u09cd\u09af\u09be\u09a8 \u098f\u09ac\u0982 \u09b8\u09b0\u099e\u09cd\u099c\u09be\u09ae \u09ac\u09cb\u09a8\u09be\u09b8\u09c7\u09b0 \u09b8\u09ae\u09a8\u09cd\u09ac\u09af\u09bc\u09c7\u09b0 \u0989\u09aa\u09b0 \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf \u0995\u09b0\u09c7 \u0997\u09a3\u09a8\u09be \u0995\u09b0\u09be \u09b9\u09af\u09bc\u0964  \u09ac\u09c7\u09b8 \u09b8\u09ae\u09be\u09b2\u09cb\u099a\u09a8\u09be\u09ae\u09c2\u09b2\u0995 \u09b9\u09bf\u099f\u09c7\u09b0 \u09b8\u09ae\u09cd\u09ad\u09be\u09ac\u09a8\u09be \u09eb%, \u09af\u09be \u0997\u09bf\u09af\u09bc\u09be\u09b0 \u098f\u09ac\u0982 \u09a6\u0995\u09cd\u09b7\u09a4\u09be\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u09ac\u09be\u09a1\u09bc\u09be\u09a8\u09cb \u09af\u09be\u09af\u09bc\u0964  \u09b6\u09c7\u09b7 \u09b8\u09ae\u09be\u09b2\u09cb\u099a\u09a8\u09be\u09ae\u09c2\u09b2\u0995 \u0995\u09cd\u09b7\u09a4\u09bf\u09b0 \u0997\u09c1\u09a3\u0995 \u0997\u09a3\u09a8\u09be \u0995\u09b0\u09be \u09b9\u09af\u09bc \u09e7 + (\u09b8\u09ae\u09be\u09b2\u09cb\u099a\u09a8\u09be\u09ae\u09c2\u09b2\u0995 \u0995\u09cd\u09b7\u09a4\u09bf\u09b0 \u09ac\u09cb\u09a8\u09be\u09b8)  \u0989\u09a6\u09be\u09b9\u09b0\u09a3\u09b8\u09cd\u09ac\u09b0\u09c2\u09aa, \u09ec\u09e6% \u09b8\u09ae\u09be\u09b2\u09cb\u099a\u09a8\u09be\u09ae\u09c2\u09b2\u0995 \u09b9\u09bf\u099f\u09c7\u09b0 \u09b8\u09ae\u09cd\u09ad\u09be\u09ac\u09a8\u09be \u098f\u09ac\u0982 \u09e9\u09e6% \u09b8\u09ae\u09be\u09b2\u09cb\u099a\u09a8\u09be\u09ae\u09c2\u09b2\u0995 \u0995\u09cd\u09b7\u09a4\u09bf\u09b0 \u09ab\u09b2\u09be\u09ab\u09b2 = \u09ec\u09e6% \u09b8\u09ae\u09cd\u09ad\u09be\u09ac\u09a8\u09be 130% \u0995\u09cd\u09b7\u09a4\u09bf \u0995\u09b0\u09be\u09b0! [\u09af\u09be\u09a8\u09cd\u09a4\u09cd\u09b0\u09bf\u0995\u09a4\u09be: \u09b8\u09ae\u09be\u09b2\u09cb\u099a\u09a8\u09be\u09ae\u09c2\u09b2\u0995 \u0995\u09cd\u09b7\u09a4\u09bf\u09b0 \u09b8\u09c2\u09a4\u09cd\u09b0]"}, {"question": "\u09af\u09a6\u09bf \u0986\u09ae\u09bf Twice \u0997\u09c7\u09ae\u099f\u09bf \u0995\u09ae\u09cd\u09aa\u09bf\u0989\u099f\u09be\u09b0 \u09a5\u09c7\u0995\u09c7 \u09ae\u09cb\u09ac\u09be\u0987\u09b2\u09c7 \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u09a8\u09cd\u09a4\u09b0 \u0995\u09b0\u09bf, \u09a4\u09be\u09b9\u09b2\u09c7 \u0986\u09ae\u09be\u09b0 \u09b8\u09ac \u0985\u0997\u09cd\u09b0\u0997\u09a4\u09bf \u09ac\u09bf\u09ad\u09bf\u09a8\u09cd\u09a8 \u09aa\u09cd\u09b2\u09cd\u09af\u09be\u099f\u09ab\u09b0\u09cd\u09ae\u09c7 \u09b8\u0982\u09b0\u0995\u09cd\u09b7\u09bf\u09a4 \u09a5\u09be\u0995\u09ac\u09c7 \u0995\u09bf? (\u0995\u09cd\u09b0\u09b8-\u09aa\u09cd\u09b2\u09cd\u09af\u09be\u099f\u09ab\u09b0\u09cd\u09ae \u09b8\u0982\u09b0\u0995\u09cd\u09b7\u09a3)", "answer": "\u09b9\u09cd\u09af\u09be\u0981, Twice \u0995\u09cd\u09b0\u09b8-\u09aa\u09cd\u09b2\u09cd\u09af\u09be\u099f\u09ab\u09b0\u09cd\u09ae \u09b8\u0982\u09b0\u0995\u09cd\u09b7\u09a3 \u09b8\u09ae\u09b0\u09cd\u09a5\u09a8 \u0995\u09b0\u09c7\u0964 \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u09c1\u09a8 \u09af\u09c7 \u0986\u09aa\u09a8\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u0995\u09ae\u09cd\u09aa\u09bf\u0989\u099f\u09be\u09b0 \u098f\u09ac\u0982 \u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u09a1\u09bf\u09ad\u09be\u0987\u09b8 \u0989\u09ad\u09af\u09bc\u09c7\u09b0 \u098f\u0995\u0987 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f\u09c7 \u09b2\u0997\u0987\u09a8 \u0995\u09b0\u09c7\u099b\u09c7\u09a8\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u0997\u09cd\u09b0\u0997\u09a4\u09bf, \u09af\u09c7\u09ae\u09a8 \u099a\u09b0\u09bf\u09a4\u09cd\u09b0\u09c7\u09b0 \u09b8\u09cd\u09a4\u09b0, \u09b8\u09b0\u099e\u09cd\u099c\u09be\u09ae \u098f\u09ac\u0982 \u0995\u09c1\u09af\u09bc\u09c7\u09b8\u09cd\u099f\u09c7\u09b0 \u0985\u0997\u09cd\u09b0\u0997\u09a4\u09bf \u09b8\u09cd\u09ac\u09af\u09bc\u0982\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09ad\u09be\u09ac\u09c7 \u09aa\u09cd\u09b0\u09be\u09a5\u09ae\u09bf\u0995 \u09b8\u09be\u09b0\u09cd\u09ad\u09be\u09b0\u09c7 \u09b8\u09bf\u0999\u09cd\u0995\u09cd\u09b0\u09cb\u09a8\u09be\u0987\u099c \u09b9\u09ac\u09c7\u0964 [\u09aa\u09cd\u09b0\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be \u09aa\u09cd\u09b0\u09ac\u09be\u09b9: \u0995\u09cd\u09b0\u09b8 \u09aa\u09cd\u09b2\u09cd\u09af\u09be\u099f\u09ab\u09b0\u09cd\u09ae \u0996\u09c7\u09b2\u09be]"}, {"question": "Twice-\u098f \u0997\u09cb\u09aa\u09a8 '\u0986\u0995\u09be\u09b6\u0997\u0999\u09cd\u0997\u09be\u09b0 \u09a1\u09cd\u09b0\u09be\u0997\u09a8' \u09b8\u09cd\u0995\u09bf\u09a8\u099f\u09bf \u0995\u09c0\u09ad\u09be\u09ac\u09c7 \u0986\u09a8\u09b2\u0995 \u0995\u09b0\u09be \u09af\u09be\u09af\u09bc, \u09af\u09be \u09b8\u09ae\u09b8\u09cd\u09a4 \u0997\u09c7\u09ae\u09c7\u09b0 \u09b8\u09ac\u099a\u09c7\u09af\u09bc\u09c7 \u09ac\u09bf\u09b0\u09b2 \u0995\u09b8\u09ae\u09c7\u099f\u09bf\u0995 \u09ac\u09b2\u09c7 \u0997\u09b2\u09cd\u09aa\u09c7 \u09ac\u09b2\u09be \u09b9\u099a\u09cd\u099b\u09c7? (\u0995\u09b8\u09ae\u09c7\u099f\u09bf\u0995 \u0995\u09cc\u09b6\u09b2)", "answer": "'\u0986\u0995\u09be\u09b6\u0997\u0999\u09cd\u0997\u09be\u09b0 \u09a1\u09cd\u09b0\u09be\u0997\u09a8' \u09b8\u09cd\u0995\u09bf\u09a8 Twice-\u098f \u0986\u09b8\u09b2\u09c7\u0987 \u0985\u09a8\u09c7\u0995\u099f\u09be \u09ac\u09bf\u09b0\u09b2 \u098f\u09ac\u0982 \u09aa\u09cd\u09b0\u09bf\u09af\u09bc\u0964 \u098f\u099f\u09bf \u0986\u09a8\u09b2\u0995 \u0995\u09b0\u09a4\u09c7 \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u098f\u0995\u099f\u09bf \u09b8\u09bf\u09b0\u09bf\u099c\u09c7\u09b0 \u0997\u09cb\u09aa\u09a8 \u0985\u09b0\u09cd\u099c\u09a8 \u09b8\u09ae\u09cd\u09aa\u09a8\u09cd\u09a8 \u0995\u09b0\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964 \u09b8\u09aa\u09cd\u09a4\u09be\u09b9\u09c7 \u09b8\u09ae\u09af\u09bc\u09b8\u09c0\u09ae\u09be\u09b0 \u09b8\u09be\u09a5\u09c7 \u098f\u0995\u099f\u09be \u09aa\u09cd\u09b0\u099a\u09c1\u09b0 \u099a\u09b2\u09ae\u09be\u09a8 \u0987\u09a8-\u0997\u09c7\u09ae \u09b8\u09be\u09b0\u09cd\u09ad\u09c7\u0987\u09af\u09bc\u09be\u09b0 \u09b9\u09be\u09a8\u09cd\u099f/\u0986\u0987\u099f\u09c7\u09ae\u0964 \u09ac\u09bf\u09b6\u09c7\u09b7 \u0995\u09b0\u09c7, \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u098f\u0995 \u09ae\u09be\u09b8\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u09b8\u09ac \u0985\u09a8\u09a8\u09cd\u09af \u0995\u09c1\u09af\u09bc\u09c7\u09b8\u09cd\u099f\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09c0\u0995 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u0964 \u098f\u099f\u09bf \u09b2\u0995\u09cd\u09b7\u09cd\u09af \u0995\u09b0\u09be \u0997\u09c1\u09b0\u09c1\u09a4\u09cd\u09ac\u09aa\u09c2\u09b0\u09cd\u09a3 \u09af\u09c7 \u098f\u0987 \u0997\u09cb\u09aa\u09a8 \u09ac\u09bf\u09b7\u09af\u09bc\u09ac\u09b8\u09cd\u09a4\u09c1  \u09b8\u09ae\u09af\u09bc\u09b8\u09c0\u09ae\u09be\u09ac\u09a6\u09cd\u09a7\u0964 [\u0997\u09cb\u09aa\u09a8 \u09ac\u09bf\u09b7\u09af\u09bc\u09ac\u09b8\u09cd\u09a4\u09c1: \u0995\u09b8\u09ae\u09c7\u099f\u09bf\u0995 \u0986\u09a8\u09b2\u0995]"}]
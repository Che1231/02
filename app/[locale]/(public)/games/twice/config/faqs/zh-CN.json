[{"question": "\u300a\u51b3\u6597\u8005\u300b\uff1a\u5982\u4f55\u8fdb\u884c\u57fa\u7840\u653b\u51fb\u548c\u79fb\u52a8\uff1f (\u65b0\u624b\u95ee\u9898)", "answer": "\u5728\u300a\u51b3\u6597\u8005\u300b\u4e2d\uff0c\u8fdb\u884c\u57fa\u7840\u653b\u51fb\u53ef\u4ee5\u4f7f\u7528\u9f20\u6807\u5de6\u952e\u3002\u79fb\u52a8\u5219\u901a\u8fc7 WASD \u952e\u63a7\u5236\u3002\u4f8b\u5982\uff0c\u6309\u4e0b\u201cW\u201d\u952e\u53ef\u4ee5\u4f7f\u89d2\u8272\u5411\u524d\u79fb\u52a8\u3002\u5f3a\u70c8\u5efa\u8bae\u5728\u8d77\u59cb\u533a\u57df\u7ec3\u4e60\u3002\u8be5\u57fa\u672c\u6280\u80fd\u5bf9\u4e8e\u5728\u300a\u51b3\u6597\u8005\u300b\u4e2d\u63d0\u5347\u548c\u638c\u63e1\u6218\u6597\u81f3\u5173\u91cd\u8981\u3002\u53ef\u4ee5\u5c06\u5176\u89c6\u4e3a\u5728\u64b0\u5199\u5c0f\u8bf4\u4e4b\u524d\u5b66\u4e60\u5b57\u6bcd\u8868\u3002[\u7c7b\u6bd4\uff1a\u5b66\u4e60\u8d70\u8def\u624d\u80fd\u8dd1\u6b65]"}, {"question": "\u300a\u51b3\u6597\u8005\u300b\u4e2d\u6709\u54ea\u4e9b\u4e0d\u540c\u7684\u89d2\u8272\u7c7b\u522b\uff0c\u54ea\u79cd\u6700\u9002\u5408\u65b0\u624b\uff1f (\u89d2\u8272\u6307\u5357)", "answer": "\u300a\u51b3\u6597\u8005\u300b\u62e5\u6709\u56db\u79cd\u4e0d\u540c\u7684\u89d2\u8272\u7c7b\u522b\uff1a\u6218\u58eb\u3001\u6cd5\u5e08\u3001\u5f13\u7bad\u624b\u548c\u523a\u5ba2\u3002\u5bf9\u4e8e\u65b0\u624b\u6765\u8bf4\uff0c\u6218\u58eb\u6700\u9002\u5408\uff0c\u56e0\u4e3a\u5b83\u62e5\u6709\u8f83\u9ad8\u7684\u751f\u547d\u503c\uff0c\u5e76\u4e14\u8fd1\u6218\u6218\u6597\u7b80\u5355\u660e\u4e86\u3002\u6cd5\u5e08\u4e5f\u5f88\u5f3a\u5927\uff0c\u4f46\u751f\u547d\u503c\u8f83\u4f4e\u3002\u5f13\u7bad\u624b\u548c\u523a\u5ba2\u66f4\u590d\u6742\uff0c\u9700\u8981\u66f4\u9ad8\u7ea7\u7684\u73a9\u6cd5\u7ecf\u9a8c\u3002[\u914d\u7f6e\u8868\uff1a\u89d2\u8272/\u96be\u5ea6/\u73a9\u6cd5\u98ce\u683c (\u6218\u58eb\uff1a\u7b80\u5355\uff0c\u8fd1\u6218)\uff0c(\u6cd5\u5e08\uff1a\u4e2d\u7b49\uff0c\u8fdc\u7a0b)\uff0c(\u5f13\u7bad\u624b\uff1a\u56f0\u96be\uff0c\u8fdc\u7a0bDPS)\uff0c(\u523a\u5ba2\uff1a\u4e2d\u7b49\uff0c\u8fd1\u6218DPS)]"}, {"question": "\u300a\u51b3\u6597\u8005\u300b\uff1a\u5982\u4f55\u5728\u6e38\u620f\u521d\u671f\u627e\u5230\u5fc5\u8981\u7684\u8d44\u6e90\uff0c\u4f8b\u5982\u751f\u547d\u836f\u6c34\uff1f (\u6e38\u620f\u521d\u671f\u6307\u5357)", "answer": "\u5728\u300a\u51b3\u6597\u8005\u300b\u7684\u65e9\u671f\u9636\u6bb5\uff0c\u53ef\u4ee5\u4ece\u51e0\u4e2a\u5730\u70b9\u627e\u5230\u5fc5\u8981\u7684\u8d44\u6e90\uff0c\u4f8b\u5982\u751f\u547d\u836f\u6c34\u3002\u4ed4\u7ec6\u68c0\u67e5\u8d77\u59cb\u57ce\u9547\uff1b\u5546\u8d29\u51fa\u552e\u57fa\u672c\u836f\u6c34\uff0c\u800c\u4e14\u533a\u57df\u5185\u6563\u843d\u7740\u53ef\u6253\u5f00\u7684\u7bb1\u5b50\u548c\u6876\u3002\u4f60\u4e5f\u53ef\u4ee5\u901a\u8fc7\u5b8c\u6210\u4efb\u52a1\u83b7\u5f97\u3002\u4f8b\u5982\uff0c\u9547\u957f\u7ed9\u4f60\u7684\u7b2c\u4e00\u4e2a\u4efb\u52a1\u901a\u5e38\u4f1a\u5956\u52b1\u4f60 3 \u74f6\u751f\u547d\u836f\u6c34\u3002[\u793a\u4f8b\uff1a\u9547\u957f\u7b2c\u4e00\u4e2a\u4efb\u52a1\u5956\u52b1 3 \u74f6\u751f\u547d\u836f\u6c34]"}, {"question": "\u9ad8\u7ea7\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u51b3\u6597\u8005\u300b\u7684\u540e\u671f\u9636\u6bb5\u4f18\u5316\u89d2\u8272\u6784\u5efa\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u6700\u7ec8\u4f24\u5bb3\uff1f (\u540e\u671f\u6784\u5efa\u4f18\u5316)", "answer": "\u4f18\u5316\u300a\u51b3\u6597\u8005\u300b\u89d2\u8272\u6784\u5efa\u4ee5\u63d0\u9ad8\u540e\u671f\u4f24\u5bb3\u9700\u8981\u4ed4\u7ec6\u5206\u914d\u5c5e\u6027\u5e76\u9009\u62e9\u88c5\u5907\u3002\u6b65\u9aa4 1\uff1a\u4e13\u6ce8\u4e8e\u88c5\u5907\u4e0a\u7684\u66b4\u51fb\u7387\u548c\u4f24\u5bb3\u5c5e\u6027\u3002\u6b65\u9aa4 2\uff1a\u9009\u62e9\u6280\u80fd\uff0c\u4ee5\u4fbf\u76f8\u4e92\u534f\u540c\uff0c\u521b\u9020\u8fde\u62db\u673a\u4f1a\u3002\u6b65\u9aa4 3\uff1a\u901a\u8fc7\u6253\u9020\u6216\u4ea4\u6613\u5b9a\u671f\u5347\u7ea7\u88c5\u5907\uff0c\u4ee5\u4fdd\u6301\u5230\u540e\u671f\u9636\u6bb5\u7684\u529b\u91cf\u5e73\u8861\u3002[\u5206\u6b65\uff1a\u4f24\u5bb3\u4f18\u5316\u6d41\u7a0b]"}, {"question": "\u300a\u51b3\u6597\u8005\u300b\uff1a\u5982\u4f55\u51fb\u8d25\u81ed\u540d\u662d\u8457\u7684\u201c\u9634\u5f71\u9886\u4e3b\u201d\u9996\u9886\uff0c\u8fd9\u662f\u8d44\u6df1\u73a9\u5bb6\u4eec\u5728\u8c08\u8bba\u7684\uff1f(\u9996\u9886\u6218\u7b56\u7565)", "answer": "\u5728\u300a\u51b3\u6597\u8005\u300b\u4e2d\u51fb\u8d25\u9634\u5f71\u9886\u4e3b\u9996\u9886\u9700\u8981\u4e00\u4e2a\u534f\u8c03\u7684\u7b56\u7565\u3002\u6b65\u9aa4 1\uff1a\u4e86\u89e3\u5176\u653b\u51fb\u6a21\u5f0f\uff1b\u9634\u5f71\u9886\u4e3b\u6bcf 30 \u79d2\u949f\u7ecf\u5e38\u4f7f\u7528\u5f3a\u5927\u7684 AoE \u653b\u51fb\u3002\u6b65\u9aa4 2\uff1a\u6307\u5b9a\u4e00\u540d\u5766\u514b\u5438\u5f15\u9634\u5f71\u9886\u4e3b\u7684\u6ce8\u610f\u529b\uff0c\u8ba9\u5176\u4ed6\u4eba\u4e13\u6ce8\u4e8e\u4ece\u540e\u9762\u9020\u6210 DPS \u4f24\u5bb3\u3002\u6b65\u9aa4 3\uff1a\u5229\u7528\u73af\u5883\u89c4\u907f AoE \u5e76\u6839\u636e\u9700\u8981\u91cd\u65b0\u96c6\u7ed3\u3002\u6c9f\u901a\u662f\u5173\u952e\uff01[\u5206\u6b65\uff1a\u9634\u5f71\u9886\u4e3b\u51fb\u6740\u65b9\u6cd5]"}, {"question": "\u300a\u51b3\u6597\u8005\u300b\u4e2d\u54ea\u4e9b\u9690\u85cf\u4efb\u52a1\u6216\u79d8\u5bc6\u533a\u57df\u4e3a\u5b8c\u6210\u5ea6\u73a9\u5bb6\u63d0\u4f9b\u4e86\u72ec\u7279\u7684\u5956\u52b1\u548c\u6311\u6218\uff1f (\u79d8\u5bc6\u533a\u57df\u6307\u5357)", "answer": "\u300a\u51b3\u6597\u8005\u300b\u4e2d\u4e00\u4e9b\u9690\u85cf\u4efb\u52a1\u548c\u533a\u57df\u63d0\u4f9b\u4e86\u72ec\u7279\u7684\u5956\u52b1\u3002\u4e00\u4e2a\u663e\u8457\u7684\u4f8b\u5b50\u662f\u201c\u5931\u843d\u7684\u8001\u8005\u795e\u6bbf\u201d\uff0c\u53ea\u6709\u901a\u8fc7\u89e3\u51b3\u8033\u8bed\u68ee\u6797\u9644\u8fd1\u7684\u7cfb\u5217\u73af\u5883\u8c1c\u9898\u624d\u80fd\u8fdb\u5165\u3002\u5b8c\u6210\u6b64\u4efb\u52a1\u5c06\u5956\u52b1\u4e00\u4e2a\u5f3a\u5927\u7684\u795e\u5668\uff0c\u663e\u7740\u63d0\u5347\u4f60\u7684\u5c5e\u6027\u3002\u8be5\u795e\u6bbf\u9700\u8981\u4f9d\u6b21\u89e3\u51b3 3 \u4e2a\u5173\u4e8e\u5149\u3001\u58f0\u97f3\u548c\u8fd0\u52a8\u7684\u8c1c\u9898\u3002\u795d\u4f60\u597d\u8fd0\uff01[\u793a\u4f8b\uff1a\u5931\u843d\u7684\u8001\u8005\u795e\u6bbf\u8c1c\u9898\u4efb\u52a1]"}, {"question": "\u300a\u51b3\u6597\u8005\u300b\u4e2d\u7684\u201c\u9b54\u529b\u6d8c\u52a8\u201d\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u662f\u5426\u5b58\u5728\u63cf\u8ff0\u9b54\u529b\u6062\u590d\u7684\u516c\u5f0f\uff1f (\u7cfb\u7edf\u5206\u89e3)", "answer": "\u300a\u51b3\u6597\u8005\u300b\u4e2d\u7684\u201c\u9b54\u529b\u6d8c\u52a8\u201d\u7cfb\u7edf\u65e8\u5728\u8c03\u8282\u6280\u80fd\u4f7f\u7528\u548c\u6218\u7565\u8d44\u6e90\u7ba1\u7406\u3002\u9b54\u529b\u4ee5 5 \u79d2\u7684\u95f4\u9694\u6062\u590d\uff0c\u88c5\u5907\u7684\u4fee\u6539\u4f1a\u5f71\u54cd\u8be5\u6570\u503c\u3002\u5b9e\u9645\u516c\u5f0f\u4e3a\uff1a\u9b54\u529b\u6062\u590d/\u79d2 = \u57fa\u7840\u6062\u590d * (1 + \u9b54\u529b\u6062\u590d\u52a0\u6210%)\u3002\u4ece\u672c\u8d28\u4e0a\u8bb2\uff0c\u8be5\u7cfb\u7edf\u4e3a\u8d44\u6e90\u7ba1\u7406\u589e\u52a0\u4e86\u6df1\u5ea6\u3002[\u516c\u5f0f\uff1a\u9b54\u529b\u6062\u590d\u5206\u6790]"}, {"question": "\u300a\u51b3\u6597\u8005\u300b\u4e2d\u8ba1\u7b97\u66b4\u51fb\u7387\u548c\u66b4\u51fb\u4f24\u5bb3\u7684\u5185\u90e8\u673a\u5236\u662f\u4ec0\u4e48\uff1f(\u4f24\u5bb3\u8ba1\u7b97\u6df1\u5165\u63a2\u8ba8)", "answer": "\u300a\u51b3\u6597\u8005\u300b\u4e2d\u66b4\u51fb\u7387\u548c\u66b4\u51fb\u4f24\u5bb3\u7684\u8ba1\u7b97\u57fa\u4e8e\u89d2\u8272\u5c5e\u6027\u548c\u88c5\u5907\u52a0\u6210\u7684\u7ec4\u5408\u3002\u57fa\u7840\u66b4\u51fb\u7387\u4e3a 5%\uff0c\u53ef\u4ee5\u901a\u8fc7\u88c5\u5907\u548c\u6280\u80fd\u63d0\u9ad8\u3002\u6700\u7ec8\u66b4\u51fb\u4f24\u5bb3\u4e58\u6570\u8ba1\u7b97\u4e3a 1 + (\u66b4\u51fb\u4f24\u5bb3\u52a0\u6210)\u3002\u4f8b\u5982\uff0c60% \u66b4\u51fb\u7387\u548c 30% \u66b4\u51fb\u4f24\u5bb3\u5c06\u7ed3\u679c = 60% \u673a\u4f1a\u9020\u6210 130% \u4f24\u5bb3\uff01[\u673a\u5236\uff1a\u66b4\u51fb\u4f24\u5bb3\u516c\u5f0f]"}, {"question": "\u5982\u679c\u6211\u5c06\u300a\u51b3\u6597\u8005\u300b\u4ece\u6211\u7684 PC \u5e73\u53f0\u8f6c\u6362\u4e3a\u79fb\u52a8\u5e73\u53f0\uff0c\u6240\u6709\u8fdb\u5ea6\u662f\u5426\u4f1a\u8de8\u5e73\u53f0\u4fdd\u5b58\uff1f(\u8de8\u5e73\u53f0\u4fdd\u5b58)", "answer": "\u662f\u7684\uff0c\u300a\u51b3\u6597\u8005\u300b\u652f\u6301\u8de8\u5e73\u53f0\u4fdd\u5b58\u3002\u8bf7\u786e\u4fdd\u4f60\u5728\u4f60\u7684 PC \u548c\u79fb\u52a8\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u5e10\u6237\u3002\u4f60\u7684\u8fdb\u5ea6\uff0c\u5305\u62ec\u89d2\u8272\u7b49\u7ea7\u3001\u88c5\u5907\u548c\u4efb\u52a1\u8fdb\u5ea6\uff0c\u5c06\u81ea\u52a8\u540c\u6b65\u5230\u4e3b\u670d\u52a1\u5668\u3002[\u6d41\u7a0b\u56fe\uff1a\u8de8\u5e73\u53f0\u6e38\u620f]"}, {"question": "\u300a\u51b3\u6597\u8005\u300b\uff1a\u5982\u4f55\u89e3\u9501\u4f20\u8bf4\u4e2d\u662f\u6700\u7a00\u6709\u88c5\u9970\u54c1\u7684\u201c\u661f\u9645\u5de8\u9f99\u201d\u76ae\u80a4\uff1f (\u88c5\u9970\u7b56\u7565)", "answer": "\u300a\u51b3\u6597\u8005\u300b\u4e2d\u7684\u201c\u661f\u9645\u5de8\u9f99\u201d\u76ae\u80a4\u786e\u5b9e\u975e\u5e38\u7a00\u6709\u4e14\u5907\u53d7\u8ffd\u6367\u3002\u8981\u89e3\u9501\u5b83\uff0c\u4f60\u5fc5\u987b\u5b8c\u6210\u4e00\u7cfb\u5217\u4e0d\u4e3a\u4eba\u77e5\u7684\u6210\u5c31\u3002\u4e00\u4e2a\u6301\u7eed\u8fdb\u884c\u7684\u6bcf\u5468\u9650\u65f6\u6389\u843d/\u7269\u54c1\u7684\u5728\u7ebf\u5bfb\u5b9d\u6e38\u620f\u3002\u5177\u4f53\u800c\u8a00\uff0c\u4f60\u9700\u8981\u5728\u5355\u4e2a\u6708\u4efd\u5185\u6536\u96c6\u6240\u6709\u72ec\u7279\u7684\u4efb\u52a1\u9057\u7269\u3002\u53e6\u5916\uff0c\u503c\u5f97\u6ce8\u610f\u7684\u662f\uff0c\u6b64\u9690\u85cf\u5185\u5bb9\u7684\u65f6\u6548\u6027\u3002[\u9690\u85cf\u5185\u5bb9\uff1a\u88c5\u9970\u89e3\u9501]"}]
[{"question": "Twice: \uae30\ubcf8 \uacf5\uaca9 \ubc0f \uac8c\uc784 \ub0b4 \uc774\ub3d9 \ubc29\ubc95\uc740 \uc5b4\ub5bb\uac8c \ud558\ub098\uc694? (\ucd08\ubcf4 \uc9c8\ubb38)", "answer": "Twice\uc5d0\uc11c \uae30\ubcf8 \uacf5\uaca9\uc740 \uc67c\ucabd \ub9c8\uc6b0\uc2a4 \ubc84\ud2bc\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc774\ub3d9\uc740 WASD \ud0a4\ub85c \uc870\uc791\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 'W'\ud0a4\ub97c \ub204\ub974\uba74 \uce90\ub9ad\ud130\uac00 \uc55e\uc73c\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4. \uc2dc\uc791 \uc9c0\uc5ed\uc5d0\uc11c \uc5f0\uc2b5\ud558\ub294 \uac83\uc744 \uc801\uadf9\uc801\uc73c\ub85c \uad8c\uc7a5\ud569\ub2c8\ub2e4. \uc774 \uae30\ubcf8\uc801\uc778 \uae30\uc220\uc740 Twice\uc5d0\uc11c \uc804\ud22c\ub97c \uc9c4\ud589\ud558\uace0 \ub9c8\uc2a4\ud130\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc18c\uc124\uc744 \uc4f0\uae30 \uc804\uc5d0 \uc54c\ud30c\ubcb3\uc744 \ubc30\uc6b0\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. [\ube44\uc720: \ub2ec\ub9ac\uae30 \uc804\uc5d0 \uac77\ub294 \ubc95 \ubc30\uc6b0\uae30]"}, {"question": "Twice\uc758 \ub2e4\uc591\ud55c \uce90\ub9ad\ud130 \ud074\ub798\uc2a4\ub294 \ubb34\uc5c7\uc774\uba70, \ucd08\ubcf4\uc790\uc5d0\uac8c \uac00\uc7a5 \uc801\ud569\ud55c \ud074\ub798\uc2a4\ub294 \ubb34\uc5c7\uc778\uac00\uc694? (Twice \ud074\ub798\uc2a4 \uac00\uc774\ub4dc)", "answer": "Twice\uc5d0\ub294 \uc804\uc0ac, \ub9c8\ubc95\uc0ac, \uad81\uc218, \ub3c4\uc801 \ub4f1 \ub124 \uac00\uc9c0 \ub3c5\ud2b9\ud55c \uce90\ub9ad\ud130 \ud074\ub798\uc2a4\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ucd08\ubcf4\uc790\uc5d0\uac8c\ub294 \ub192\uc740 \uccb4\ub825\uacfc \uac04\ub2e8\ud55c \uadfc\uc811 \uc804\ud22c\ub97c \ud2b9\uc9d5\uc73c\ub85c \ud558\ub294 \uc804\uc0ac\uac00 \uac00\uc7a5 \uc88b\uc2b5\ub2c8\ub2e4. \ub9c8\ubc95\uc0ac\ub294 \uac15\ub825\ud558\uc9c0\ub9cc \uccb4\ub825\uc774 \ub0ae\uc2b5\ub2c8\ub2e4. \uad81\uc218\uc640 \ub3c4\uc801\uc740 \ub354 \ubcf5\uc7a1\ud558\uace0 \ub354 \uace0\uae09 \uac8c\uc784 \uacbd\ud5d8\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. [\uad6c\uc131\ud45c: \ud074\ub798\uc2a4/\ub09c\uc774\ub3c4/\ud50c\ub808\uc774\uc2a4\ud0c0\uc77c (\uc804\uc0ac: \uc26c\uc6c0, \uadfc\uc811), (\ub9c8\ubc95\uc0ac: \uc911\uac04, \uc6d0\uac70\ub9ac), (\uad81\uc218: \uc5b4\ub824\uc6c0, \uc6d0\uac70\ub9ac DPS), (\ub3c4\uc801: \uc911\uac04, \uadfc\uc811 DPS)]"}, {"question": "Twice\uc5d0\uc11c \uac8c\uc784 \ucd08\ubc18\uc5d0 \ud544\uc218\uc801\uc778 \uc790\uc6d0(\uc608: \uccb4\ub825 \ud3ec\uc158)\uc744 \uc5b4\ub514\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\ub098\uc694? (\ucd08\ubc18 \uac00\uc774\ub4dc)", "answer": "Twice\uc5d0\uc11c \uac8c\uc784 \ucd08\ubc18\uc5d0 \ud544\uc218\uc801\uc778 \uc790\uc6d0(\uc608: \uccb4\ub825 \ud3ec\uc158)\uc740 \uc5ec\ub7ec \uacf3\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2dc\uc791 \ub9c8\uc744\uc744 \ucca0\uc800\ud788 \uc870\uc0ac\ud574\ubcf4\uc138\uc694. \ud310\ub9e4\uc790\ub294 \uae30\ubcf8 \ud3ec\uc158\uc744 \ud310\ub9e4\ud558\uace0, \uc9c0\uc5ed \uacf3\uacf3\uc5d0 \ud769\uc5b4\uc838 \uc788\ub294 \uc0c1\uc790\uc640 \ud1b5\uc744 \ubd80\uc218\uba74 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud018\uc2a4\ud2b8 \ubcf4\uc0c1\uc73c\ub85c\ub3c4 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub9c8\uc744 \ub178\uc778\uc774 \uc8fc\ub294 \uccab \ubc88\uc9f8 \ud018\uc2a4\ud2b8\ub294 \uc77c\ubc18\uc801\uc73c\ub85c 3\uac1c\uc758 \uccb4\ub825 \ud3ec\uc158\uc744 \ubcf4\uc0c1\uc73c\ub85c \uc90d\ub2c8\ub2e4. [\uc608: \ub9c8\uc744 \ub178\uc778\uc758 \uccab \ubc88\uc9f8 \ud018\uc2a4\ud2b8 \ubcf4\uc0c1: 3\uac1c\uc758 \uccb4\ub825 \ud3ec\uc158]"}, {"question": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\uac00 \uc5d4\ub4dc \uac8c\uc784\uc5d0\uc11c \ucd5c\ub300 \ud53c\ud574\ub7c9\uc744 \uc704\ud574 Twice \uce90\ub9ad\ud130 \ube4c\ub4dc\ub97c \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694? (\uc5d4\ub4dc \uac8c\uc784 \ube4c\ub4dc \ucd5c\uc801\ud654)", "answer": "\uc5d4\ub4dc \uac8c\uc784\uc5d0\uc11c Twice \uce90\ub9ad\ud130 \ube4c\ub4dc\ub97c \ucd5c\ub300 \ud53c\ud574\ub7c9\uc73c\ub85c \ucd5c\uc801\ud654\ud558\ub824\uba74 \ud1b5\uacc4 \ubc30\ubd84 \ubc0f \uc7a5\ube44 \uc120\ud0dd\uc5d0 \uc2e0\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \uc7a5\ube44\uc5d0 \uce58\uba85\ud0c0 \ud655\ub960 \ubc0f \ud53c\ud574\ub7c9 \ud1b5\uacc4\uc5d0 \uc9d1\uc911\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \uc11c\ub85c \uc2dc\ub108\uc9c0 \ud6a8\uacfc\uac00 \uc88b\uc740 \uc2a4\ud0ac\uc744 \uc120\ud0dd\ud558\uc5ec \ucf64\ubcf4 \uae30\ud68c\ub97c \ub9cc\ub4ed\ub2c8\ub2e4. 3\ub2e8\uacc4: \uc81c\uc791 \ub610\ub294 \uac70\ub798\ub97c \ud1b5\ud574 \uc815\uae30\uc801\uc73c\ub85c \uc7a5\ube44\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc5ec \uc5d4\ub4dc \uac8c\uc784\uae4c\uc9c0 \uc804\ub825 \uade0\ud615\uc744 \uc720\uc9c0\ud569\ub2c8\ub2e4. [\ub2e8\uacc4\ubcc4: \ud53c\ud574\ub7c9 \ucd5c\uc801\ud654 \uacfc\uc815]"}, {"question": "\ubca0\ud14c\ub791 \ud50c\ub808\uc774\uc5b4\ub4e4\uc774 \uc774\uc57c\uae30\ud558\ub294 \uc545\uba85 \ub192\uc740 '\uc100\ub3c4\uc6b0\ub85c\ub4dc' \ubcf4\uc2a4\ub97c \ubb3c\ub9ac\uce58\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694? (\ubcf4\uc2a4 \uc804\ud22c \uc804\ub7b5)", "answer": "Twice\uc5d0\uc11c \uc100\ub3c4\uc6b0\ub85c\ub4dc \ubcf4\uc2a4\ub97c \ubb3c\ub9ac\uce58\ub824\uba74 \uc798 \uc870\uc815\ub41c \uc804\ub7b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. 1\ub2e8\uacc4: \uacf5\uaca9 \ud328\ud134\uc744 \uc774\ud574\ud558\uc138\uc694. \uc100\ub3c4\uc6b0\ub85c\ub4dc\ub294 30\ucd08\ub9c8\ub2e4 \uac15\ub825\ud55c AoE \uacf5\uaca9\uc744 \uc790\uc8fc \uc0ac\uc6a9\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \ud0f1\ucee4\ub97c \uc9c0\uc815\ud558\uc5ec \uc100\ub3c4\uc6b0\ub85c\ub4dc\uc758 \uc8fc\uc758\ub97c \ub04c\ub3c4\ub85d \ud558\uace0, \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub294 \ub4a4\uc5d0\uc11c DPS\uc5d0 \uc9d1\uc911\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \ud544\uc694\uc5d0 \ub530\ub77c AoE\ub97c \ud53c\ud558\uace0 \ud658\uacbd\uc744 \ud65c\uc6a9\ud558\uc5ec \uc7ac\uc815\ube44\ud569\ub2c8\ub2e4. \uc18c\ud1b5\uc774 \uc911\uc694\ud569\ub2c8\ub2e4! [\ub2e8\uacc4\ubcc4: \uc100\ub3c4\uc6b0\ub85c\ub4dc \ucc98\uce58]"}, {"question": "Twice\uc758 \uc228\uaca8\uc9c4 \ud018\uc2a4\ud2b8\ub098 \ube44\ubc00 \uc9c0\uc5ed \uc911 \uc644\uc131\ub3c4\ub97c \ucd94\uad6c\ud558\ub294 \uac8c\uc774\uba38\uc5d0\uac8c \ub3c5\ud2b9\ud55c \ubcf4\uc0c1\uacfc \ub3c4\uc804\uc744 \uc81c\uacf5\ud558\ub294 \uacf3\uc740 \uc5b4\ub514\uc778\uac00\uc694? (\ube44\ubc00 \uc9c0\uc5ed \uac00\uc774\ub4dc)", "answer": "Twice\uc5d0\ub294 \uc228\uaca8\uc9c4 \ud018\uc2a4\ud2b8\uc640 \uc9c0\uc5ed\uc774 \uba87 \uad70\ub370 \uc788\uc73c\uba70 \ub3c5\ud2b9\ud55c \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub208\uc5d0 \ub744\ub294 \uc608\ub294 \uc18d\uc0ad\uc774\ub294 \uc232 \uadfc\ucc98\uc758 \uc77c\ub828\uc758 \ud658\uacbd \ud37c\uc990\uc744 \ud480\uc5b4\uc57c\ub9cc \uc811\uadfc\ud560 \uc218 \uc788\ub294 '\uace0\ub300 \uc218\ud638\uc790\uc758 \uc783\uc5b4\ubc84\ub9b0 \uc2e0\uc804'\uc785\ub2c8\ub2e4. \uc774 \ud018\uc2a4\ud2b8\ub97c \uc644\ub8cc\ud558\uba74 \uac15\ub825\ud55c \uc720\ubb3c\uc744 \ud68d\ub4dd\ud558\uc5ec \ud1b5\uacc4\ub97c \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc2e0\uc804\uc740 \ube5b, \uc18c\ub9ac, \uc6c0\uc9c1\uc784\uacfc \uad00\ub828\ub41c 3\uac1c\uc758 \ud37c\uc990\uc744 \uc21c\ucc28\uc801\uc73c\ub85c \ud480\uc5b4\uc57c \ud569\ub2c8\ub2e4. \ud654\uc774\ud305! [\uc608: \uace0\ub300 \uc218\ud638\uc790\uc758 \uc783\uc5b4\ubc84\ub9b0 \uc2e0\uc804 \ud37c\uc990 \ud018\uc2a4\ud2b8]"}, {"question": "Twice\uc758 '\ub9c8\ub098 \uc288\ub974\uc9c0' \uc2dc\uc2a4\ud15c\uc774 \uc791\ub3d9\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \ub9c8\ub098 \uc7ac\uc0dd\uc744 \uc124\uba85\ud558\ub294 \uacf5\uc2dd\uc774 \uc788\ub098\uc694? (\uc2dc\uc2a4\ud15c \ud574\uccb4)", "answer": "Twice\uc758 '\ub9c8\ub098 \uc288\ub974\uc9c0' \uc2dc\uc2a4\ud15c\uc740 \ub2a5\ub825 \uc0ac\uc6a9\uacfc \uc804\ub7b5\uc801\uc778 \uc790\uc6d0 \uad00\ub9ac\ub97c \uc870\uc808\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ub9c8\ub098\ub294 \uc7a5\ube44\uc5d0 \uc601\ud5a5\uc744 \ubc1b\ub294 \uc218\uc815\uc790\uc640 \ud568\uaed8 5\ucd08 \uac04\uaca9\uc73c\ub85c \uc7ac\uc0dd\ub429\ub2c8\ub2e4. \uc2e4\uc81c \uacf5\uc2dd\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ub9c8\ub098 \uc7ac\uc0dd/\ud2f1 = \uae30\ubcf8 \uc7ac\uc0dd * (1 + \ub9c8\ub098 \uc7ac\uc0dd \ubcf4\ub108\uc2a4%). \ubcf8\uc9c8\uc801\uc73c\ub85c \uc774 \uc2dc\uc2a4\ud15c\uc740 \uc790\uc6d0 \uad00\ub9ac\uc5d0 \uae4a\uc774\ub97c \ub354\ud569\ub2c8\ub2e4. [\uacf5\uc2dd: \ub9c8\ub098 \uc7ac\uc0dd \ubd84\uc11d]"}, {"question": "Twice\uc5d0\uc11c \uce58\uba85\ud0c0 \ud655\ub960\uacfc \ud53c\ud574\ub7c9\uc744 \uacc4\uc0b0\ud558\ub294 \ub0b4\ubd80 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc778\uac00\uc694? (\ud53c\ud574 \uacc4\uc0b0 \uc2ec\uce35 \ud0d0\uad6c)", "answer": "Twice\uc5d0\uc11c \uce58\uba85\ud0c0 \ud655\ub960\uacfc \ud53c\ud574\ub7c9\uc740 \uce90\ub9ad\ud130 \ud1b5\uacc4\uc640 \uc7a5\ube44 \ubcf4\ub108\uc2a4\uc758 \uc870\ud569\uc5d0 \uae30\ubc18\ud558\uc5ec \uacc4\uc0b0\ub429\ub2c8\ub2e4. \uae30\ubcf8 \uce58\uba85\ud0c0 \ud655\ub960\uc740 5%\uc774\uba70, \uc7a5\ube44\uc640 \uc2a4\ud0ac\ub85c \uc99d\uac00\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ucd5c\uc885 \uce58\uba85\ud0c0 \ud53c\ud574 \ubc30\uc218\ub294 1 + (\uce58\uba85\ud0c0 \ud53c\ud574 \ubcf4\ub108\uc2a4)\ub85c \uacc4\uc0b0\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 60%\uc758 \uce58\uba85\ud0c0 \ud655\ub960\uacfc 30%\uc758 \uce58\uba85\ud0c0 \ud53c\ud574\ub294 \uacb0\uacfc\uc801\uc73c\ub85c 60% \ud655\ub960\ub85c 130%\uc758 \ud53c\ud574\ub97c \uc785\ud799\ub2c8\ub2e4! [\uba54\ucee4\ub2c8\uc998: \uce58\uba85\ud0c0 \ud53c\ud574 \uacf5\uc2dd]"}, {"question": "PC\uc5d0\uc11c \ubaa8\ubc14\uc77c\ub85c Twice\ub97c \uc804\ud658\ud558\uba74 \ubaa8\ub4e0 \uc9c4\ud589 \uc0c1\ud669\uc774 \ubaa8\ub4e0 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc800\uc7a5\ub420\uae4c\uc694? (\ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \uc800\uc7a5)", "answer": "\ub124, Twice\ub294 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \uc800\uc7a5\uc744 \uc9c0\uc6d0\ud569\ub2c8\ub2e4. PC\uc640 \ubaa8\ubc14\uc77c \uae30\uae30\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uce90\ub9ad\ud130 \ub808\ubca8, \uc7a5\ube44 \ubc0f \ud018\uc2a4\ud2b8 \uc9c4\ud589 \uc0c1\ud669 \ub4f1 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc790\ub3d9\uc73c\ub85c \uc8fc \uc11c\ubc84\uc5d0 \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \ud750\ub984: \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \uac8c\uc784 \ud50c\ub808\uc774]"}, {"question": "Twice\uc5d0\uc11c \uc804\uc124\uc801\uc778 \ud76c\uadc0 \ucf54\uc2a4\uba54\ud2f1\uc73c\ub85c \uc54c\ub824\uc9c4 \ube44\ubc00 '\ucc9c\uccb4 \uc6a9' \uc2a4\ud0a8\uc744 \uc5b4\ub5bb\uac8c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\ub098\uc694? (\ucf54\uc2a4\uba54\ud2f1 \uc804\ub7b5)", "answer": "Twice\uc758 '\ucc9c\uccb4 \uc6a9' \uc2a4\ud0a8\uc740 \uc2e4\uc81c\ub85c \ub9e4\uc6b0 \ub4dc\ubb3c\uace0 \uc778\uae30\uac00 \ub9ce\uc2b5\ub2c8\ub2e4. \uc774\ub97c \uc7a0\uae08 \ud574\uc81c\ud558\ub824\uba74 \uc77c\ub828\uc758 \uc228\uaca8\uc9c4 \uc131\ucde8\ub3c4\ub97c \ub2ec\uc131\ud574\uc57c \ud569\ub2c8\ub2e4. \ud2b9\uc815 \uc8fc\uc5d0 \uc8fc\uae30\uc801\uc73c\ub85c \ub4dc\ub86d\ub418\ub294 \uc228\uaca8\uc9c4 \uc228\uaca8\uc9c4 \uc544\uc774\ud15c\uc778 \uc7a5\uae30 \uac8c\uc784 \uc0ac\ub0e5\uafbc\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uad6c\uccb4\uc801\uc73c\ub85c, \ud55c \ub2ec \uc548\uc5d0 \ubaa8\ub4e0 \uace0\uc720 \ud018\uc2a4\ud2b8 \uc720\ubb3c\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub610\ud55c, \uc774 \uc228\uaca8\uc9c4 \ub0b4\uc6a9\uc740 \uc2dc\uac04 \uc81c\ud55c\uc774 \uc788\uc74c\uc744 \uc54c\ub824\ub4dc\ub9bd\ub2c8\ub2e4.[\uc228\uaca8\uc9c4 \ucf58\ud150\uce20: \ucf54\uc2a4\uba54\ud2f1 \uc7a0\uae08 \ud574\uc81c]"}]
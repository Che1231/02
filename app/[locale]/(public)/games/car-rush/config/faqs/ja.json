[{"question": "Car-Rush\u65b0\u624b\u6307\u5357\uff1a\u30c9\u30ea\u30d5\u30c8\u3084\u904b\u8ee2\u306e\u57fa\u672c\u64cd\u4f5c\u306f\u4f55\u304b\u3001\u58c1\u306b\u885d\u7a81\u3057\u306a\u3044\u305f\u3081\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u65b0\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u3001\u57fa\u672c\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u306f\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u30c7\u30d5\u30a9\u30eb\u30c8\u306e\u64cd\u4f5c\u306f\u901a\u5e38\u3001\u79fb\u52d5\u306b[WASD\u307e\u305f\u306f\u77e2\u5370\u30ad\u30fc]\u3001\u30c9\u30ea\u30d5\u30c8\u306b[\u30b9\u30da\u30fc\u30b9\u30d0\u30fc\u307e\u305f\u306f\u30b7\u30d5\u30c8\u30ad\u30fc]\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u885d\u7a81\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u306f\u3001\u30b9\u30c6\u30a2\u30ea\u30f3\u30b0\u3092\u30b9\u30e0\u30fc\u30ba\u306b\u64cd\u4f5c\u3057\u3001\u30c9\u30ea\u30d5\u30c8\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u7d9a\u3051\u305a\u306b\u30bf\u30c3\u30d7\u3059\u308b\u7df4\u7fd2\u3092\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u300e\u30c0\u30a6\u30f3\u30bf\u30a6\u30f3\u30fb\u30c9\u30ea\u30d5\u30c8\u300f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u5674\u6c34\u8fd1\u304f\u306e\u89d2\u3092\u3001\u58c1\u306b\u5f53\u305f\u3089\u306a\u3044\u3067\u901f\u5ea6\u3092\u7dad\u6301\u3059\u308b\u305f\u3081\u306b\u3001\u77ed\u3044\u30c9\u30ea\u30d5\u30c8\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u8eca\u306e\u52e2\u3044\u3092\u632f\u308a\u5b50\u306e\u3088\u3046\u306b\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u5c0f\u3055\u306a\u8abf\u6574\u306f\u3001\u5927\u304d\u306a\u7a81\u7136\u306e\u5909\u66f4\u3088\u308a\u3082\u52b9\u679c\u7684\u3067\u3059\u3002\u30bf\u30a4\u30c8\u306a\u30bf\u30fc\u30f3\u524d\u306b\u30d6\u30ec\u30fc\u30ad\uff08\u901a\u5e38\u306f[B]\uff09\u3092\u8e0f\u3080\u3053\u3068\u3067\u3001\u3088\u308a\u5236\u5fa1\u3055\u308c\u305f\u30c9\u30ea\u30d5\u30c8\u304c\u53ef\u80fd\u306b\u306a\u308a\u307e\u3059\u3002\u3053\u306e\u30b9\u30ad\u30eb\u306f\u3001\u5f8c\u3005\u306e\u3088\u308a\u56f0\u96e3\u306a\u8ab2\u984c\u306b\u4e0d\u53ef\u6b20\u306b\u306a\u308a\u307e\u3059\u3002"}, {"question": "Car-Rush\u3067\u8eca\u304c\u6025\u306b\u6e1b\u901f\u3059\u308b\u7406\u7531\u3001\u7570\u306a\u308b\u5730\u5f62\u304c\u901f\u5ea6\u306b\u4e0e\u3048\u308b\u5f71\u97ff\u3001\u6700\u9ad8\u901f\u5ea6\u3092\u7dad\u6301\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u8eca\u306f\u901a\u5e38\u3001\u8352\u308c\u305f\u5730\u5f62\u3084\u885d\u7a81\u306b\u3088\u3063\u3066\u6e1b\u901f\u3057\u307e\u3059\u3002\u7570\u306a\u308b\u8def\u9762\u306f\u901f\u5ea6\u306b\u7570\u306a\u308b\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u30a2\u30b9\u30d5\u30a1\u30eb\u30c8\u306f\u6700\u9ad8\u306e\u30b0\u30ea\u30c3\u30d7\u3068\u901f\u5ea6\u3092\u63d0\u4f9b\u3057\u307e\u3059\u304c\u3001\u829d\u751f\u3084\u7802\u306f\u305d\u308c\u3092\u5927\u5e45\u306b\u4f4e\u4e0b\u3055\u305b\u307e\u3059\u3002\u6700\u9ad8\u901f\u5ea6\u3092\u7dad\u6301\u3059\u308b\u306b\u306f\u3001\u5e38\u306b\u8217\u88c5\u3055\u308c\u305f\u9053\u8def\u306b\u3068\u3069\u307e\u308a\u3001\u53ef\u80fd\u306a\u9650\u308a\u30aa\u30d5\u30ed\u30fc\u30c9\u30a8\u30ea\u30a2\u3092\u907f\u3051\u3066\u304f\u3060\u3055\u3044\u3002\u901f\u5ea6\u4f4e\u4e0b\u306e\u4e00\u3064\u306e\u5927\u304d\u306a\u7406\u7531\u306f\u30c0\u30e1\u30fc\u30b8\u3067\u3059\u3002\u6bce\u56de\u30af\u30e9\u30c3\u30b7\u30e5\u3059\u308b\u3068\u3001\u8eca\u306e\u8010\u4e45\u6027\u304c\u4f4e\u4e0b\u3057\u3001\u540c\u6642\u306b\u901f\u5ea6\u3082\u4f4e\u4e0b\u3057\u307e\u3059\u3002\u5730\u5f62\u304c\u8eca\u306e\u901f\u5ea6\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3059\u308b\u304b\u3092\u3088\u308a\u826f\u304f\u7406\u89e3\u3059\u308b\u305f\u3081\u306b\u3001\u4ee5\u4e0b\u306e\u753b\u50cf\u3092\u53c2\u7167\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u30a2\u30b9\u30d5\u30a1\u30eb\u30c8\u3001\u829d\u751f\u3001\u7802\u3067\u901f\u5ea6\u3092\u6bd4\u8f03\u3057\u305f\u753b\u50cf]\u3002\u6700\u5f8c\u306b\u3001\u30ec\u30fc\u30b9\u5f8c\u306b\u306f\u5fc5\u305a\u8eca\u3092\u4fee\u7406\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "Car-Rush\u30b7\u30b9\u30c6\u30e0\u89e3\u8aac\uff1a\u8eca\u306e\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u30aa\u30d7\u30b7\u30e7\u30f3\u3068\u3001\u7279\u306b\u30bf\u30a4\u30e0\u30c8\u30e9\u30a4\u30a2\u30eb\u3067\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u5927\u304d\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\uff1f", "answer": "\u8eca\u306e\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u306b\u3088\u308a\u3001\u3055\u307e\u3056\u307e\u306a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u901a\u3057\u3066\u8eca\u4e21\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u91cd\u8981\u306a\u90e8\u5206\u306f\u30a8\u30f3\u30b8\u30f3\u3001\u30bf\u30a4\u30e4\u3001\u30b5\u30b9\u30da\u30f3\u30b7\u30e7\u30f3\u3001\u305d\u3057\u3066\u7a7a\u529b\u3067\u3059\u3002\u30bf\u30a4\u30e0\u30c8\u30e9\u30a4\u30a2\u30eb\u3067\u306f\u3001\u52a0\u901f\u3068\u30cf\u30f3\u30c9\u30ea\u30f3\u30b0\u3092\u5411\u4e0a\u3055\u305b\u308b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u91cd\u70b9\u3092\u7f6e\u3044\u3066\u304f\u3060\u3055\u3044\u3002\u30a8\u30f3\u30b8\u30f3\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u7d14\u7c8b\u306a\u901f\u5ea6\u3001\u30bf\u30a4\u30e4\u306f\u3088\u308a\u826f\u3044\u30b0\u30ea\u30c3\u30d7\u3068\u30b3\u30fc\u30ca\u30ea\u30f3\u30b0\u306e\u305f\u3081\u306b\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b5\u30b9\u30da\u30f3\u30b7\u30e7\u30f3\u306f\u6bb5\u5dee\u3078\u306e\u5bfe\u5fdc\u3092\u52a9\u3051\u3001\u7a7a\u529b\u306f\u9ad8\u901f\u6642\u306e\u7a7a\u6c17\u62b5\u6297\u3092\u8efd\u6e1b\u3057\u307e\u3059\u3002 \u4f8b\uff1a\u300e\u6a19\u6e96\u30bf\u30a4\u30e4\u300f\u304b\u3089\u300e\u30b9\u30dd\u30fc\u30c4\u30bf\u30a4\u30e4\u300f\u3078\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u3001\u300e\u6d77\u5cb8\u7dda\u30b5\u30fc\u30ad\u30c3\u30c8\u300f\u30b3\u30fc\u30b9\u3067\u30e9\u30c3\u30d7\u30bf\u30a4\u30e0\u30921\u301c2\u79d2\u77ed\u7e2e\u3067\u304d\u307e\u3059\u3002\u52b9\u7387\u7684\u306a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u6226\u7565\u306e\u305f\u3081\u306e\u8868\u3092\u4ee5\u4e0b\u306b\u793a\u3057\u307e\u3059\u3002\n | \u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9 | \u5f71\u97ff | \u5229\u76ca | \n | --------- | ------- | -------- | \n | \u30a8\u30f3\u30b8\u30f3  | \u9ad8\u3044 | \u52a0\u901f\u529b/\u6700\u9ad8\u901f\u5ea6 | \n | \u30bf\u30a4\u30e4     | \u9ad8\u3044 | \u30b0\u30ea\u30c3\u30d7/\u30b3\u30fc\u30ca\u30ea\u30f3\u30b0 | \n | \u30b5\u30b9\u30da\u30f3\u30b7\u30e7\u30f3| \u4e2d | \u5b89\u5b9a\u6027/\u30cf\u30f3\u30c9\u30ea\u30f3\u30b0 | \n | \u7a7a\u529b | \u4e2d | \u6700\u9ad8\u901f\u5ea6 |"}, {"question": "Car-Rush\u3067\u5229\u7528\u53ef\u80fd\u306a\u5177\u4f53\u7684\u306a\u30c1\u30e5\u30fc\u30cb\u30f3\u30b0\u30aa\u30d7\u30b7\u30e7\u30f3\u306f\u4f55\u304b\u3001\u305d\u308c\u3089\u306f\u30cf\u30f3\u30c9\u30ea\u30f3\u30b0\u3068\u901f\u5ea6\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f\u3053\u308c\u3089\u306e\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u4f7f\u3063\u3066\u3001\u30ec\u30fc\u30b9\u3092\u3088\u308a\u826f\u304f\u3059\u308b\u306b\u306f\uff1f", "answer": "Car-Rush\u306e\u30c1\u30e5\u30fc\u30cb\u30f3\u30b0\u30aa\u30d7\u30b7\u30e7\u30f3\u306b\u306f\u3001\u901a\u5e38\u3001\u30bf\u30a4\u30e4\u7a7a\u6c17\u5727\u3001\u30b5\u30b9\u30da\u30f3\u30b7\u30e7\u30f3\u306e\u786c\u3055\u3001\u30ae\u30e4\u6bd4\u306a\u3069\u306e\u30d1\u30e9\u30e1\u30fc\u30bf\u306e\u8abf\u6574\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u30bf\u30a4\u30e4\u7a7a\u6c17\u5727\u306f\u30b0\u30ea\u30c3\u30d7\u3068\u8ee2\u304c\u308a\u62b5\u6297\u306b\u5f71\u97ff\u3057\u307e\u3059\u3002\u7a7a\u6c17\u5727\u304c\u4f4e\u3044\u3068\u30b0\u30ea\u30c3\u30d7\u306f\u5411\u4e0a\u3057\u307e\u3059\u304c\u3001\u6700\u9ad8\u901f\u5ea6\u306f\u4f4e\u4e0b\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u30b5\u30b9\u30da\u30f3\u30b7\u30e7\u30f3\u306e\u786c\u3055\u306f\u30cf\u30f3\u30c9\u30ea\u30f3\u30b0\u306e\u5fdc\u7b54\u6027\u306b\u5f71\u97ff\u3057\u307e\u3059\u3002\u30b5\u30b9\u30da\u30f3\u30b7\u30e7\u30f3\u304c\u786c\u3044\u3068\u30dc\u30c7\u30a3\u30ed\u30fc\u30eb\u306f\u6e1b\u5c11\u3057\u307e\u3059\u304c\u3001\u8eca\u306e\u6bb5\u5dee\u3078\u306e\u53cd\u5fdc\u304c\u654f\u611f\u306b\u306a\u308a\u307e\u3059\u3002\u30ae\u30e4\u6bd4\u306f\u52a0\u901f\u3068\u6700\u9ad8\u901f\u5ea6\u306b\u5f71\u97ff\u3057\u307e\u3059\u3002\u77ed\u3044\u30ae\u30a2\u306f\u52a0\u901f\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u304c\u3001\u6700\u9ad8\u901f\u5ea6\u3092\u4f4e\u4e0b\u3055\u305b\u307e\u3059\u3002\u9006\u306b\u3001\u9577\u3044\u30ae\u30a2\u306f\u3088\u308a\u9ad8\u3044\u6700\u9ad8\u901f\u5ea6\u3092\u63d0\u4f9b\u3057\u307e\u3059\u304c\u3001\u52a0\u901f\u529b\u306f\u5f31\u307e\u308a\u307e\u3059\u3002\u8a2d\u5b9a\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u5c0f\u3055\u306a\u8abf\u6574\u3092\u8a66\u3057\u3066\u3001\u30e9\u30c3\u30d7\u30bf\u30a4\u30e0\u3092\u8a18\u9332\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30c7\u30d5\u30a9\u30eb\u30c8\u8a2d\u5b9a\u304b\u3089\u59cb\u3081\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u4e00\u5ea6\u306b1\u3064\u306e\u30d1\u30e9\u30e1\u30fc\u30bf\uff08\u4f8b\uff1a\u30bf\u30a4\u30e4\u7a7a\u6c17\u5727\uff09\u3092\u5909\u66f4\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u65b0\u3057\u3044\u8abf\u6574\u3092\u8907\u6570\u56de\u30c6\u30b9\u30c8\u3057\u307e\u3059\u3002\u8abf\u6574\u3068\u7d50\u679c\u3092\u8a18\u9332\u3059\u308b\u305f\u3081\u306b\u30b9\u30d7\u30ec\u30c3\u30c9\u30b7\u30fc\u30c8\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "Car-Rush\u306e\u9ad8\u5ea6\u306a\u6226\u7565\uff1a\u3055\u307e\u3056\u307e\u306a\u30ec\u30fc\u30b9\u72b6\u6cc1\u3067\u30cb\u30c8\u30ed\u30d6\u30fc\u30b9\u30c8\u3092\u52b9\u679c\u7684\u306b\u4f7f\u7528\u3059\u308b\u65b9\u6cd5\u306f\u3001\u305d\u3057\u3066\u305d\u308c\u3089\u3092\u7bc0\u7d04\u3059\u308b\u6700\u826f\u306e\u6226\u7565\u306f\uff1f", "answer": "\u30cb\u30c8\u30ed\u30d6\u30fc\u30b9\u30c8\u306f\u4e00\u6642\u7684\u306b\u901f\u5ea6\u3092\u4e0a\u3052\u308b\u6a5f\u80fd\u3067\u3059\u304c\u3001\u52b9\u679c\u7684\u306b\u4f7f\u7528\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u306e\u3067\u3059\u3002\u30b9\u30c8\u30ec\u30fc\u30c8\u30bb\u30af\u30b7\u30e7\u30f3\u3067\u306f\u3001\u30cb\u30c8\u30ed\u30d6\u30fc\u30b9\u30c8\u3092\u4f7f\u7528\u3057\u3066\u6700\u9ad8\u901f\u5ea6\u3092\u7dad\u6301\u3059\u308b\u304b\u3001\u5bfe\u6226\u76f8\u624b\u3092\u8ffd\u3044\u629c\u3044\u3066\u304f\u3060\u3055\u3044\u3002\u30b3\u30fc\u30ca\u30fc\u3067\u306f\u3001\u30bf\u30fc\u30f3\u304b\u3089\u629c\u3051\u51fa\u3059\u305f\u3081\u306b\u30cb\u30c8\u30ed\u30d6\u30fc\u30b9\u30c8\u3092\u7bc0\u7d04\u3057\u3066\u3001\u512a\u4f4d\u6027\u3092\u7372\u5f97\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30cb\u30c8\u30ed\u30d6\u30fc\u30b9\u30c8\u3092\u7121\u99c4\u306b\u3057\u306a\u3044\u3088\u3046\u306b\u6ce8\u610f\u3057\u3066\u7bc0\u7d04\u3057\u307e\u3059\u3002\u7279\u306b\u4e0b\u308a\u5742\u3067\u306f\u3001\u91cd\u529b\u306b\u3088\u308a\u3059\u3067\u306b\u52a0\u901f\u3057\u3066\u3044\u308b\u305f\u3081\u3001\u30cb\u30c8\u30ed\u30d6\u30fc\u30b9\u30c8\u3092\u4f7f\u7528\u3059\u308b\u306e\u3092\u907f\u3051\u307e\u3057\u3087\u3046\u3002\u30ec\u30fc\u30b9\u4e2d\u306b\u30cb\u30c8\u30ed\u30d6\u30fc\u30b9\u30c8\u3092\u62fe\u3046\u3053\u3068\u3067\u3001\u30bf\u30f3\u30af\u306f\u88dc\u5145\u3055\u308c\u307e\u3059\u3002\u8996\u899a\u8868\u73fe\u3092\u7528\u3044\u3066\u3001\u8eca\u304c\u52a0\u901f\u304c\u5fc5\u8981\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u72b6\u6cc1\u306e\u6d41\u308c\u3092\u793a\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u7570\u306a\u308b\u30ec\u30fc\u30b9\u72b6\u6cc1\u3067\u30cb\u30c8\u30ed\u30d6\u30fc\u30b9\u30c8\u3092\u4f7f\u7528\u3059\u3079\u304d\u304b\u3092\u6c7a\u5b9a\u3059\u308b\u610f\u601d\u6c7a\u5b9a\u30c4\u30ea\u30fc\u3092\u793a\u3059\u30d5\u30ed\u30fc\u30b0\u30e9\u30d5]"}, {"question": "Car-Rush\u30b7\u30b9\u30c6\u30e0\u5206\u6790\uff1a\u30b2\u30fc\u30e0\u306f\u30c9\u30ea\u30d5\u30c8\u30b9\u30b3\u30a2\u3092\u3069\u306e\u3088\u3046\u306b\u8a08\u7b97\u3057\u307e\u3059\u304b\u3002\u30c9\u30ea\u30d5\u30c8\u30c1\u30e3\u30ec\u30f3\u30b8\u3067\u30dd\u30a4\u30f3\u30c8\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3069\u306e\u3088\u3046\u306a\u6280\u8853\u304c\u5fc5\u8981\u3067\u3059\u304b\uff1f\u30b7\u30f3\u30d7\u30eb\u306a\u30c9\u30ea\u30d5\u30c8\u304b\u3089\u3001\u30c9\u30ea\u30d5\u30c8\u3092\u9023\u9396\u3055\u305b\u3066\u30b9\u30b3\u30a2\u500d\u7387\u3092\u4e0a\u3052\u308b\u65b9\u6cd5\u3092\u6bd4\u8f03\u3057\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "\u30c9\u30ea\u30d5\u30c8\u30b9\u30b3\u30a2\u306f\u3001\u30c9\u30ea\u30d5\u30c8\u89d2\u5ea6\u3001\u901f\u5ea6\u3001\u304a\u3088\u3073\u7d99\u7d9a\u6642\u9593\u306b\u57fa\u3065\u3044\u3066\u8a08\u7b97\u3055\u308c\u307e\u3059\u3002\u30c9\u30ea\u30d5\u30c8\u304c\u9577\u304f\u3066\u5e83\u3051\u308c\u3070\u3001\u30b9\u30b3\u30a2\u304c\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002\u30c9\u30ea\u30d5\u30c8\u3092\u7e4b\u304e\u5408\u308f\u305b\u3001\u76f4\u7dda\u306b\u306a\u3089\u306a\u3044\u3067\u30c9\u30ea\u30d5\u30c8\u3092\u7d9a\u3051\u308b\u3053\u3068\u3067\u3001\u30b9\u30b3\u30a2\u500d\u7387\u304c\u5927\u5e45\u306b\u4e0a\u6607\u3057\u307e\u3059\u3002\u30dd\u30a4\u30f3\u30c8\u3092\u6700\u5927\u5316\u3059\u308b\u65b9\u6cd5\u306f\u3001\u30bf\u30fc\u30f3\u3092\u59cb\u3081\u308b\u65e9\u3055\u3068\u3001\u30bf\u30fc\u30f3\u5168\u4f53\u3067\u4e00\u5b9a\u306e\u89d2\u5ea6\u3092\u7dad\u6301\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u30a2\u30af\u30bb\u30eb\u5236\u5fa1\u3068\u30b9\u30c6\u30a2\u30ea\u30f3\u30b0\u306e\u308f\u305a\u304b\u306a\u8abf\u6574\u3092\u4f7f\u7528\u3057\u3066\u3001\u30b9\u30d4\u30f3\u30a2\u30a6\u30c8\u3092\u9632\u304e\u307e\u3059\u3002'\u30a2\u30fc\u30d0\u30f3\u30fb\u30a2\u30ec\u30fc'\u306e\u3088\u3046\u306a\u30c9\u30ea\u30d5\u30c8\u30c1\u30e3\u30ec\u30f3\u30b8\u3067\u306f\u3001\u89d2\u3092\u9577\u304f\u9023\u7d9a\u3057\u305f\u30c9\u30ea\u30d5\u30c8\u3067\u8d70\u308a\u3001\u53ef\u80fd\u3067\u3042\u308c\u3070\u305d\u308c\u3089\u3092\u7e4b\u304e\u5408\u308f\u305b\u307e\u3059\u3002\u5358\u4e00\u306e\u30c9\u30ea\u30d5\u30c8\u3068\u9023\u9396\u3057\u305f\u30c9\u30ea\u30d5\u30c8\u306e\u30b9\u30b3\u30a2\u3092\u6bd4\u8f03\u3057\u305f\u8868\u306f\u3001\u30c9\u30ea\u30d5\u30c8\u6280\u8853\u306b\u3088\u308b\u30dd\u30a4\u30f3\u30c8\u5897\u52a0\u3092\u660e\u78ba\u306b\u793a\u3057\u3066\u3044\u307e\u3059\u3002[\u5358\u4e00\u30c9\u30ea\u30d5\u30c8\u3068\u9023\u9396\u30c9\u30ea\u30d5\u30c8\u306e\u5e73\u5747\u30b9\u30b3\u30a2\u3092\u6bd4\u8f03\u3057\u305f\u8868]\u3002\u9ad8\u5f97\u70b9\u3092\u5f97\u308b\u305f\u3081\u306b\u306f\u3001\u30c9\u30ea\u30d5\u30c8\u3092\u9023\u9396\u3055\u305b\u306a\u304c\u3089\u9ad8\u3044\u901f\u5ea6\u3092\u7dad\u6301\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002"}, {"question": "Car-Rush\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\uff1aCar-Rush\u306f\u8907\u6570\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u5229\u7528\u3067\u304d\u307e\u3059\u304b\u3002PC\u3001\u30b3\u30f3\u30bd\u30fc\u30eb\u3001\u30e2\u30d0\u30a4\u30eb\u9593\u3067\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30fb\u30d7\u30ec\u30a4\u3084\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u306e\u540c\u671f\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u73fe\u5728\u3001Car-Rush\u306f\u30e2\u30d0\u30a4\u30eb\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\uff08iOS\u304a\u3088\u3073Android\uff09\u3068PC\uff08Steam\uff09\u3067\u5229\u7528\u53ef\u80fd\u3067\u3059\u3002\u6b8b\u5ff5\u306a\u304c\u3089\u3001\u30b2\u30fc\u30e0\u306f\u73fe\u5728\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30fb\u30d7\u30ec\u30a4\u3092\u63d0\u4f9b\u3057\u3066\u3044\u307e\u305b\u3093\u3002\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u30fb\u30d7\u30ec\u30a4\u306f\u5229\u7528\u3067\u304d\u307e\u305b\u3093\u304c\u3001\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u30af\u30ed\u30b9\u30bb\u30fc\u30d6/\u540c\u671f\u6a5f\u80fd\u304c\u73fe\u5728\u5229\u7528\u53ef\u80fd\u3067\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u30b9\u30e0\u30fc\u30ba\u306a\u5207\u308a\u66ff\u3048\u3068\u30b9\u30c6\u30fc\u30bf\u30b9\u306e\u7dad\u6301\u304c\u53ef\u80fd\u306b\u306a\u308a\u307e\u3059\u3002"}, {"question": "Car-Rush\u306e\u7d4c\u6e08\u30b7\u30b9\u30c6\u30e0\u89e3\u8aac\uff1aCar-Rush\u306b\u306f\u3069\u306e\u3088\u3046\u306a\u7a2e\u985e\u306e\u901a\u8ca8\u304c\u3042\u308a\u307e\u3059\u304b\u3002\u5831\u916c\u3092\u6700\u9069\u5316\u3057\u3001\u8eca\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3084\u8eca\u306e\u8cfc\u5165\u3092\u52b9\u7387\u7684\u306b\u6d3b\u7528\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "Car-Rush\u306b\u306f\u3001\u901a\u5e38\u30012\u7a2e\u985e\u306e\u30b2\u30fc\u30e0\u5185\u901a\u8ca8\u304c\u3042\u308a\u307e\u3059\u3002\u30ec\u30fc\u30b9\u3084\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3067\u7372\u5f97\u3067\u304d\u308b\u30ad\u30e3\u30c3\u30b7\u30e5\u3001\u30de\u30a4\u30af\u30ed\u30c8\u30e9\u30f3\u30b6\u30af\u30b7\u30e7\u30f3\u3084\u7279\u5225\u306a\u30a4\u30d9\u30f3\u30c8\u3092\u901a\u3058\u3066\u5165\u624b\u3067\u304d\u308b\u30b4\u30fc\u30eb\u30c9\uff08\u307e\u305f\u306f\u540c\u7b49\u306e\u30d7\u30ec\u30df\u30a2\u30e0\u901a\u8ca8\uff09\u3067\u3059\u3002\u30ad\u30e3\u30c3\u30b7\u30e5\u306f\u4e3b\u306b\u8eca\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3084\u3001\u4e0b\u4f4d\u8eca\u4e21\u306e\u8cfc\u5165\u306b\u4f7f\u7528\u3055\u308c\u307e\u3059\u3002\u4e00\u65b9\u3001\u30b4\u30fc\u30eb\u30c9\u306f\u30d7\u30ec\u30df\u30a2\u30e0\u30ab\u30fc\u3084\u9650\u5b9a\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u30a2\u30a4\u30c6\u30e0\u306e\u30a2\u30f3\u30ed\u30c3\u30af\u306b\u4f7f\u7528\u3055\u308c\u307e\u3059\u3002\u5831\u916c\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u65e5\u3005\u306e\u30c1\u30e3\u30ec\u30f3\u30b8\u306b\u53c2\u52a0\u3057\u3001\u30ad\u30e3\u30ea\u30a2\u30e2\u30fc\u30c9\u30ec\u30d9\u30eb\u3092\u9032\u3081\u3066\u30ad\u30e3\u30c3\u30b7\u30e5\u3092\u7372\u5f97\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u885d\u52d5\u7684\u306a\u8cfc\u5165\u3092\u907f\u3051\u3001\u5fc5\u9808\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u90e8\u54c1\u306e\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u512a\u5148\u3057\u3001\u65b0\u3057\u3044\u8eca\u3092\u8cfc\u5165\u3057\u305f\u3044\u5834\u5408\u306f\u3001\u305d\u306e\u72b6\u614b\u3092\u8abf\u3079\u3066\u3001\u4ee5\u524d\u306e\u8cc7\u7523\u3068\u6bd4\u8f03\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u512a\u5148\u9806\u4f4d\u4ed8\u3051\u304c\u91cd\u8981\u3067\u3059\u3002\u3053\u306e\u72b6\u6cc1\u3092\u8003\u3048\u3066\u304f\u3060\u3055\u3044\uff1a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u30b4\u30fc\u30eb\u30c9\u3092\u4f7f\u7528\u3059\u308b\u304b\u3001\u30b4\u30fc\u30eb\u30c9\u3092\u4f7f\u7528\u3057\u3066\u3059\u3050\u306b\u65b0\u3057\u3044\u8eca\u3092\u8cb7\u3046\u304b\u306e\u3069\u3061\u3089\u304b\u3067\u3059\u3002"}, {"question": "Car-Rush\u306e\u96a0\u3055\u308c\u305f\u5185\u5bb9\uff1aCar-Rush\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u8eca\u3084\u79d8\u5bc6\u306e\u30b3\u30fc\u30b9\u306f\u3042\u308a\u307e\u3059\u304b\uff1f \u3082\u3057\u3042\u308c\u3070\u3001\u3069\u306e\u3088\u3046\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u304b\u3002\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3068\u3001\u96a0\u3055\u308c\u305f\u8eca\u306e\u30b3\u30fc\u30c9\u30cd\u30fc\u30e0\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "\u306f\u3044\u3001Car-Rush\u306b\u306f\u3001\u7279\u5225\u306a\u5b9f\u7e3e\u3092\u9054\u6210\u3057\u305f\u308a\u3001\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u308b\u3001\u96a0\u3055\u308c\u305f\u8eca\u3084\u30b3\u30fc\u30b9\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002 \u4f8b\u306f\u3001\u300e\u30ca\u30a4\u30c8\u30e9\u30a4\u30c0\u30fc\u300f\u8eca\u3067\u3059\u3002\u30b3\u30fc\u30c9\u30cd\u30fc\u30e0\u306f\u300e\u30d7\u30ed\u30b8\u30a7\u30af\u30c8X\u300f\u3067\u3042\u308a\u3001\u3059\u3079\u3066\u306e\u30bf\u30a4\u30e0\u30c8\u30e9\u30a4\u30a2\u30eb\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u91d1\u30e1\u30c0\u30eb\u3067\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u3002\u3082\u3046\u4e00\u3064\u306e\u79d8\u5bc6\u3001'\u5fd8\u308c\u3089\u308c\u305f\u5de5\u5834'\u30b3\u30fc\u30b9\u306f\u3001'\u7523\u696d\u5730\u533a'\u30ec\u30d9\u30eb\u306b\u3042\u308b\u96a0\u3055\u308c\u305f\u843d\u66f8\u304d\u306e\u58c1\u753b\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u5404\u30b3\u30fc\u30b9\u306e\u9685\u3005\u307e\u3067\u63a2\u3057\u3001\u958b\u767a\u8005\u304b\u3089\u306e\u30e1\u30c3\u30bb\u30fc\u30b8\u3084\u30b7\u30f3\u30dc\u30eb\u304c\u3053\u308c\u3089\u306e\u79d8\u5bc6\u3092\u793a\u5506\u3057\u3066\u3044\u308b\u5834\u5408\u306b\u6ce8\u610f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u79d8\u5bc6\u306e\u5834\u6240\u3092\u898b\u3064\u3051\u308b\u305f\u3081\u306e\u4fbf\u5229\u306a\u6bd4\u55a9\u306f\u3001\u8857\u3067\u5b9f\u969b\u306b\u4f01\u753b\u3055\u308c\u308b\u5b9d\u63a2\u3057\u3067\u3059\u3002"}, {"question": "Car-Rush\u306f\u5e38\u306b\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u3092\u8003\u3048\u308b\u3068\u3001Car-Rush\u306e\u30a8\u30f3\u30b8\u30f3\u3068\u80fd\u529b\u306b\u3064\u3044\u3066\u8aac\u660e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3069\u306e\u3088\u3046\u306b\u3055\u307e\u3056\u307e\u306a\u8981\u7d20\u3092\u8a08\u7b97\u3057\u3066\u3044\u307e\u3059\u304b\u3002\u3053\u306e\u30a8\u30f3\u30b8\u30f3\u3092\u7c21\u5358\u306b\u7406\u89e3\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Car-Rush\u306e\u30b2\u30fc\u30e0\u30a8\u30f3\u30b8\u30f3\u30bd\u30fc\u30b9\u30b3\u30fc\u30c9\u306b\u76f4\u63a5\u30a2\u30af\u30bb\u30b9\u3067\u304d\u306a\u3044\u305f\u3081\u3001\u660e\u78ba\u306a\u7406\u89e3\u306f\u307b\u307c\u4e0d\u53ef\u80fd\u3067\u3059\u3002\u3057\u304b\u3057\u3001\u30b2\u30fc\u30e0\u306e\u52d5\u4f5c\u3092\u63a8\u6e2c\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002Car-Rush\u306f\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u3068\u30ec\u30f3\u30c0\u30ea\u30f3\u30b0\u306e\u8a08\u7b97\u3068\u6700\u9069\u5316\u306bUnreal Engine 5\u3092\u4f7f\u7528\u3057\u3066\u3044\u308b\u3053\u3068\u304c\u77e5\u3089\u308c\u3066\u304a\u308a\u3001\u7269\u7406\u8a08\u7b97\u306b\u306fPhysX\u3092\u4f7f\u7528\u3057\u3066\u3044\u307e\u3059\u3002\u30a8\u30f3\u30b8\u30f3\u3092\u7406\u89e3\u3059\u308b\u305f\u3081\u306e\u6d41\u308c\u3092\u4ee5\u4e0b\u306b\u793a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4e2d\u306b\u901f\u5ea6\u3001\u30c9\u30ea\u30d5\u30c8\u89d2\u5ea6\u3001\u5730\u5f62\u306a\u3069\u306e\u30c6\u30ec\u30e1\u30c8\u30ea\u30c7\u30fc\u30bf\u3092\u5206\u6790\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3084\u8a2d\u5b9a\u5909\u66f4\u5f8c\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u30d9\u30f3\u30c1\u30de\u30fc\u30af\u3092\u89b3\u5bdf\u3057\u3001\u8a18\u9332\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b2\u30fc\u30e0\u30d5\u30a1\u30a4\u30eb\u3092\u53d6\u308a\u51fa\u3057\u3066\u3001\u958b\u767a\u8005\u304c\u8ffd\u52a0\u3057\u305f\u5f79\u7acb\u3064\u60c5\u5831\u3092\u898b\u3064\u3051\u3088\u3046\u3068\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u8981\u7d20\u3092\u8003\u616e\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u611b\u597d\u5bb6\u306f\u76f4\u63a5\u7684\u306a\u30bd\u30fc\u30b9\u3067\u306f\u306a\u3044\u306b\u3057\u3066\u3082\u3001\u305d\u308c\u3092\u3088\u308a\u3088\u304f\u7406\u89e3\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}]
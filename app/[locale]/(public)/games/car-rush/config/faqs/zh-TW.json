[{"question": "Car-Rush\u65b0\u624b\u6307\u5357\uff1a\u95dc\u65bc\u99d5\u99db\u548c\u6f02\u79fb\u7684\u57fa\u672c\u63a7\u5236\uff0c\u4ee5\u53ca\u5982\u4f55\u907f\u514d\u649e\u5230\u7246\u58c1\uff1f", "answer": "\u4f5c\u70ba\u65b0\u73a9\u5bb6\uff0c\u638c\u63e1\u57fa\u672c\u63a7\u5236\u81f3\u95dc\u91cd\u8981\u3002\u9810\u8a2d\u63a7\u5236\u901a\u5e38\u662f [WASD \u6216\u65b9\u5411\u9375] \u9032\u884c\u79fb\u52d5\uff0c[\u7a7a\u767d\u9375\u6216 Shift \u9375] \u9032\u884c\u6f02\u79fb\u3002\u70ba\u4e86\u907f\u514d\u649e\u8eca\uff0c\u8acb\u7df4\u7fd2\u5e73\u7a69\u64cd\u63a7\u65b9\u5411\u76e4\uff0c\u4e26\u9ede\u6309\u6f02\u79fb\u6309\u9215\uff0c\u800c\u4e0d\u662f\u6301\u7e8c\u6309\u4f4f\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5e02\u4e2d\u5fc3\u6f02\u79fb\u300f\u95dc\u5361\u4e2d\uff0c\u5728\u5674\u6cc9\u9644\u8fd1\u92b3\u5229\u7684\u5f4e\u9053\u8655\u4f7f\u7528\u77ed\u6642\u9593\u6f02\u79fb\uff0c\u4ee5\u4fdd\u6301\u901f\u5ea6\uff0c\u907f\u514d\u649e\u5230\u7246\u58c1\u3002\u60f3\u50cf\u4f60\u7684\u8eca\u5b50\u7684\u52d5\u91cf\u5c31\u50cf\u4e00\u500b\u64fa\u9318\uff1b\u5fae\u5c0f\u7684\u8abf\u6574\u52dd\u65bc\u5de8\u5927\u7684\u3001\u7a81\u7136\u7684\u6539\u8b8a\u3002\u8a18\u4f4f\uff0c\u5728\u7dca\u5bc6\u8f49\u5f4e\u524d\u715e\u8eca\uff08\u901a\u5e38\u662f [B]\uff09\uff0c\u4ee5\u7372\u5f97\u66f4\u53d7\u63a7\u5236\u7684\u6f02\u79fb\u3002\u9019\u9805\u6280\u5de7\u5c0d\u65bc\u5f8c\u7e8c\u66f4\u8271\u96e3\u7684\u6311\u6230\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u7684\u8eca\u8f1b\u5728 Car-Rush \u4e2d\u7a81\u7136\u6e1b\u901f\uff0c\u4e0d\u540c\u5730\u5f62\u5c0d\u901f\u5ea6\u7684\u5f71\u97ff\u662f\u4ec0\u9ebc\uff1f\u6211\u5982\u4f55\u4fdd\u6301\u6700\u9ad8\u901f\u5ea6\uff1f", "answer": "\u4f60\u7684\u8eca\u8f1b\u901a\u5e38\u6703\u56e0\u5728\u5d0e\u5d87\u5730\u5f62\u884c\u99db\u6216\u78b0\u649e\u800c\u6e1b\u901f\u3002\u4e0d\u540c\u8868\u9762\u6703\u5c0d\u4f60\u7684\u901f\u5ea6\u7522\u751f\u4e0d\u540c\u7684\u5f71\u97ff\uff1b\u67cf\u6cb9\u8def\u63d0\u4f9b\u6700\u4f73\u7684\u6293\u5730\u529b\u548c\u901f\u5ea6\uff0c\u800c\u8349\u5730\u548c\u6c99\u5730\u5247\u6703\u986f\u8457\u964d\u4f4e\u5b83\u3002\u70ba\u4e86\u4fdd\u6301\u6700\u9ad8\u901f\u5ea6\uff0c\u8acb\u59cb\u7d42\u5805\u6301\u92ea\u780c\u9053\u8def\uff0c\u4e26\u76e1\u53ef\u80fd\u907f\u514d\u8d8a\u91ce\u5340\u57df\u3002\u901f\u5ea6\u4e0b\u964d\u7684\u53e6\u4e00\u500b\u4e3b\u8981\u539f\u56e0\u662f\u640d\u58de\u3002\u6bcf\u6b21\u78b0\u649e\uff0c\u4f60\u7684\u8eca\u8f1b\u5b8c\u6574\u6027\u90fd\u6703\u964d\u4f4e\uff0c\u540c\u6642\u4f60\u7684\u901f\u5ea6\u5c6c\u6027\u4e5f\u6703\u964d\u4f4e\u3002\u8acb\u53c3\u95b1\u4e0b\u65b9\u5716\u7247\uff0c\u4ee5\u66f4\u597d\u5730\u4e86\u89e3\u5730\u5f62\u5982\u4f55\u5f71\u97ff\u4f60\u7684\u8eca\u8f1b\u901f\u5ea6\u3002\n [\u6bd4\u8f03\u67cf\u6cb9\u8def\u3001\u8349\u5730\u548c\u6c99\u5730\u901f\u5ea6\u7684\u5716\u7247]\u3002\u6700\u5f8c\uff0c\u6bcf\u6b21\u6bd4\u8cfd\u5f8c\uff0c\u8acb\u52d9\u5fc5\u7dad\u4fee\u4f60\u7684\u8eca\u8f1b\u3002"}, {"question": "Car-Rush\u7cfb\u7d71\u8aaa\u660e\uff1a\u4f60\u80fd\u89e3\u91cb\u6c7d\u8eca\u5ba2\u88fd\u5316\u9078\u9805\u4ee5\u53ca\u54ea\u4e9b\u5347\u7d1a\u5c0d\u6027\u80fd\u7684\u5f71\u97ff\u6700\u5927\uff0c\u5c24\u5176\u662f\u5728\u6642\u9593\u8cfd\u4e2d\uff1f", "answer": "\u6c7d\u8eca\u5ba2\u88fd\u5316\u5141\u8a31\u4f60\u900f\u904e\u5404\u7a2e\u5347\u7d1a\u4f86\u63d0\u5347\u8eca\u8f1b\u7684\u6027\u80fd\u3002\u95dc\u9375\u9818\u57df\u5305\u62ec\u5f15\u64ce\u3001\u8f2a\u80ce\u3001\u61f8\u540a\u548c\u7a7a\u6c23\u529b\u5b78\u3002\u5c0d\u65bc\u6642\u9593\u8cfd\uff0c\u91cd\u9ede\u662f\u63d0\u5347\u52a0\u901f\u548c\u64cd\u63a7\u7684\u5347\u7d1a\u3002\u512a\u5148\u8003\u616e\u5f15\u64ce\u4ee5\u7372\u5f97\u539f\u59cb\u901f\u5ea6\uff0c\u4e26\u512a\u5148\u8003\u616e\u8f2a\u80ce\u4ee5\u7372\u5f97\u66f4\u597d\u7684\u6293\u5730\u529b\u548c\u5f4e\u9053\u6027\u80fd\u3002\u61f8\u540a\u6709\u52a9\u65bc\u61c9\u5c0d\u985b\u7c38\uff0c\u800c\u7a7a\u6c23\u529b\u5b78\u5247\u53ef\u964d\u4f4e\u9ad8\u901f\u6642\u7684\u963b\u529b\u3002\n \u4f8b\uff1a\u5c07\u300e\u539f\u5ee0\u8f2a\u80ce\u300f\u5347\u7d1a\u70ba\u300e\u904b\u52d5\u8f2a\u80ce\u300f\u53ef\u4ee5\u5728\u300e\u6cbf\u6d77\u8cfd\u9053\u300f\u8cfd\u9053\u4e0a\u5c07\u4f60\u7684\u55ae\u5708\u6642\u9593\u7e2e\u77ed 1-2 \u79d2\u3002\u4ee5\u4e0b\u662f\u4e00\u4efd\u95dc\u65bc\u9ad8\u6548\u5347\u7d1a\u7b56\u7565\u7684\u8868\u683c\uff1a\n | \u5347\u7d1a | \u5f71\u97ff | \u597d\u8655 | \n | --------- | ------- | -------- | \n | \u5f15\u64ce | \u9ad8 | \u52a0\u901f/\u6700\u9ad8\u901f\u5ea6 | \n | \u8f2a\u80ce | \u9ad8 | \u6293\u5730\u529b/\u5f4e\u9053\u6027\u80fd | \n | \u61f8\u540a | \u4e2d | \u7a69\u5b9a\u6027/\u64cd\u63a7\u6027 | \n | \u7a7a\u6c23\u529b\u5b78 | \u4e2d | \u6700\u9ad8\u901f\u5ea6 |"}, {"question": "Car-Rush\u6709\u54ea\u4e9b\u7279\u5b9a\u7684\u8abf\u6821\u9078\u9805\uff0c\u4ee5\u53ca\u5b83\u5011\u5982\u4f55\u5f71\u97ff\u64cd\u63a7\u6027\u548c\u901f\u5ea6\uff1f\u6211\u5982\u4f55\u5229\u7528\u9019\u4e9b\u9078\u9805\u4f86\u53d6\u5f97\u66f4\u597d\u7684\u6bd4\u8cfd\u6210\u7e3e\uff1f", "answer": "Car-Rush \u7684\u8abf\u6821\u9078\u9805\u901a\u5e38\u6d89\u53ca\u8abf\u6574\u8af8\u5982\u8f2a\u80ce\u58d3\u529b\u3001\u61f8\u540a\u786c\u5ea6\u548c\u9f52\u8f2a\u6bd4\u7b49\u53c3\u6578\u3002\u8f2a\u80ce\u58d3\u529b\u5f71\u97ff\u6293\u5730\u529b\u548c\u6efe\u52d5\u963b\u529b\uff1b\u8f03\u4f4e\u7684\u58d3\u529b\u6703\u589e\u52a0\u6293\u5730\u529b\uff0c\u4f46\u53ef\u80fd\u6703\u964d\u4f4e\u6700\u9ad8\u901f\u5ea6\u3002\u61f8\u540a\u786c\u5ea6\u6703\u5f71\u97ff\u64cd\u63a7\u53cd\u61c9\uff1b\u8f03\u786c\u7684\u61f8\u540a\u53ef\u4ee5\u6e1b\u5c11\u8eca\u8eab\u6416\u6643\uff0c\u4f46\u6703\u4f7f\u8eca\u8f1b\u5c0d\u985b\u7c38\u66f4\u654f\u611f\u3002\u9f52\u8f2a\u6bd4\u6703\u5f71\u97ff\u52a0\u901f\u548c\u6700\u9ad8\u901f\u5ea6\uff1b\u8f03\u77ed\u7684\u9f52\u8f2a\u6bd4\u53ef\u4ee5\u63d0\u9ad8\u52a0\u901f\u6027\u80fd\uff0c\u4f46\u6703\u964d\u4f4e\u6700\u9ad8\u901f\u5ea6\uff0c\u53cd\u4e4b\u4ea6\u7136\uff0c\u8f03\u9577\u7684\u9f52\u8f2a\u6bd4\u5247\u80fd\u63d0\u4f9b\u66f4\u9ad8\u7684\u6700\u9ad8\u901f\u5ea6\uff0c\u4f46\u52a0\u901f\u6027\u80fd\u8f03\u5f31\u3002\u70ba\u512a\u5316\u4f60\u7684\u8a2d\u5b9a\uff0c\u8acb\u5617\u8a66\u9032\u884c\u5c0f\u5e45\u8abf\u6574\uff0c\u4e26\u8ffd\u8e64\u4f60\u7684\u55ae\u5708\u6642\u9593\u3002\u6b65\u9a5f 1\uff1a\u5f9e\u9810\u8a2d\u8a2d\u5b9a\u958b\u59cb\u3002\u6b65\u9a5f 2\uff1a\u6bcf\u6b21\u4fee\u6539\u4e00\u500b\u53c3\u6578\uff08\u4f8b\u5982\uff0c\u8f2a\u80ce\u58d3\u529b\uff09\uff0c\u6b65\u9a5f 3\uff1a\u6e2c\u8a66\u65b0\u8abf\u6574\u591a\u6b21\u3002\u4f7f\u7528\u8a66\u7b97\u8868\u8a18\u9304\u8abf\u6574\u548c\u7d50\u679c\u3002"}, {"question": "Car-Rush\u9032\u968e\u7b56\u7565\uff1a\u5982\u4f55\u5728\u4e0d\u540c\u7684\u6bd4\u8cfd\u5834\u666f\u4e2d\u6709\u6548\u5730\u4f7f\u7528\u6c2e\u6c23\u589e\u76ca\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u4f73\u5316\u4fdd\u5b58\u5b83\u5011\uff1f", "answer": "\u6c2e\u6c23\u589e\u76ca\u63d0\u4f9b\u66ab\u6642\u7684\u52a0\u901f\u63d0\u5347\uff0c\u4f46\u6709\u6548\u5730\u4f7f\u7528\u5b83\u5011\u9700\u8981\u7b56\u7565\u3002\u5728\u76f4\u7dda\u8def\u6bb5\uff0c\u4f7f\u7528\u6c2e\u6c23\u589e\u76ca\u4ee5\u4fdd\u6301\u6700\u9ad8\u901f\u5ea6\u6216\u8d85\u8d8a\u5c0d\u624b\u3002\u5728\u5f4e\u9053\uff0c\u4fdd\u7559\u6c2e\u6c23\u589e\u76ca\u7528\u65bc\u99db\u51fa\u5f4e\u9053\u4ee5\u7372\u5f97\u512a\u52e2\u3002\u70ba\u4e86\u7bc0\u7d04\u6c2e\u6c23\u589e\u76ca\uff0c\u8acb\u907f\u514d\u4e0d\u5fc5\u8981\u7684\u6d6a\u8cbb\uff0c\u5c24\u5176\u662f\u5728\u4e0b\u5761\u8def\u6bb5\uff0c\u91cd\u529b\u5df2\u7d93\u63d0\u4f9b\u52a0\u901f\u3002\u5728\u6bd4\u8cfd\u671f\u9593\u6536\u96c6\u6c2e\u6c23\u589e\u76ca\u53ef\u4ee5\u88dc\u5145\u4f60\u7684\u80fd\u91cf\u3002\u5716\u793a\u53ef\u4ee5\u986f\u793a\u904a\u6232\u73a9\u6cd5\u60c5\u5883\u6d41\uff0c\u8aaa\u660e\u4f55\u6642\u5728\u4e0d\u540c\u7684\u8cfd\u8eca\u5834\u666f\u4e2d\u52a0\u901f\u6c7d\u8eca\u3002\n [\u8aaa\u660e\u5982\u4f55\u5728\u4e0d\u540c\u8cfd\u8eca\u5834\u666f\u4e2d\u4f7f\u7528\u6c2e\u6c23\u589e\u76ca\u7684\u6c7a\u7b56\u6a39\u6d41\u7a0b\u5716]"}, {"question": "Car-Rush\u7cfb\u7d71\u5206\u6790\uff1a\u904a\u6232\u5982\u4f55\u8a08\u7b97\u6f02\u79fb\u5f97\u5206\uff0c\u4ee5\u53ca\u5728\u6f02\u79fb\u6311\u6230\u4e2d\u54ea\u4e9b\u6280\u5de7\u80fd\u6700\u5927\u5316\u6211\u7684\u5f97\u5206\uff1f\u6bd4\u8f03\u7c21\u55ae\u6f02\u79fb\u8207\u9023\u7e8c\u6f02\u79fb\u7684\u5f97\u5206\uff0c\u4ee5\u53ca\u5f97\u5206\u500d\u6578\u3002", "answer": "\u6f02\u79fb\u5f97\u5206\u662f\u6839\u64da\u6f02\u79fb\u89d2\u5ea6\u3001\u901f\u5ea6\u548c\u6301\u7e8c\u6642\u9593\u8a08\u7b97\u7684\u3002\u6f02\u79fb\u6642\u9593\u548c\u89d2\u5ea6\u8d8a\u9577\u8d8a\u9ad8\u3002\u5c07\u6f02\u79fb\u9023\u7e8c\u8d77\u4f86\uff0c\u800c\u4e0d\u6703\u76f4\u63a5\u99db\u51fa\u5f4e\u9053\uff0c\u6703\u986f\u8457\u589e\u52a0\u4f60\u7684\u5f97\u5206\u500d\u6578\u3002\u70ba\u4e86\u6700\u5927\u5316\u5f97\u5206\uff0c\u8acb\u76e1\u65e9\u555f\u52d5\u6f02\u79fb\uff0c\u4e26\u5728\u6574\u500b\u8f49\u5f4e\u904e\u7a0b\u4e2d\u4fdd\u6301\u4e00\u81f4\u7684\u89d2\u5ea6\u3002\u904b\u7528\u6cb9\u9580\u63a7\u5236\u548c\u8f15\u5fae\u65b9\u5411\u76e4\u8abf\u6574\uff0c\u4ee5\u9632\u8eca\u8f1b\u6253\u6ed1\u3002\u5728\u300e\u57ce\u5e02\u5df7\u5f04\u300d\u4e00\u985e\u7684\u6f02\u79fb\u6311\u6230\u4e2d\uff0c\u52d9\u5fc5\u5728\u5f4e\u9053\u8655\u9032\u884c\u9577\u6642\u9593\u9023\u7e8c\u6f02\u79fb\uff0c\u4e26\u76e1\u53ef\u80fd\u5c07\u5176\u9023\u63a5\u8d77\u4f86\u3002\u4e00\u5f35\u6bd4\u8f03\u55ae\u6b21\u6f02\u79fb\u8207\u9023\u7e8c\u6f02\u79fb\u7684\u5f97\u5206\u8868\u7684\u6e05\u6670\u8868\u793a\uff0c\u6e05\u695a\u5730\u986f\u793a\u4e86\u6f02\u79fb\u6280\u5de7\u63d0\u5347\u7684\u5f97\u5206\u56de\u5831\u3002\n [\u55ae\u6b21\u6f02\u79fb\u8207\u9023\u7e8c\u6f02\u79fb\u5e73\u5747\u5f97\u5206\u7684\u6bd4\u8f03\u8868]\u3002\u8a18\u4f4f\uff0c\u5728\u9023\u7e8c\u6f02\u79fb\u7684\u540c\u6642\u4fdd\u6301\u9ad8\u901f\u5ea6\u5c0d\u65bc\u7372\u5f97\u9ad8\u5206\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "Car-Rush\u8de8\u5e73\u53f0\uff1aCar-Rush\u53ef\u5728\u591a\u500b\u5e73\u53f0\u4e0a\u4f7f\u7528\u55ce\uff1f\u904a\u6232\u662f\u5426\u63d0\u4f9b\u8de8\u5e73\u53f0\u904a\u6232\u6216\u5728 PC\u3001\u4e3b\u6a5f\u548c\u884c\u52d5\u88dd\u7f6e\u4e4b\u9593\u540c\u6b65\u5b58\u6a94\u8cc7\u6599\uff1f", "answer": "\u76ee\u524d\uff0cCar-Rush \u5728\u884c\u52d5\u88dd\u7f6e\u5e73\u53f0\uff08iOS \u548c Android\uff09\u548c PC\uff08Steam\uff09\u4e0a\u53ef\u7528\u3002\u907a\u61be\u7684\u662f\uff0c\u904a\u6232\u76ee\u524d\u4e0d\u63d0\u4f9b\u8de8\u5e73\u53f0\u904a\u6232\u529f\u80fd\u3002\u5118\u7ba1\u6c92\u6709\u8de8\u5e73\u53f0\u904a\u6232\u529f\u80fd\uff0c\u4f46\u76ee\u524d\u6709\u884c\u52d5\u88dd\u7f6e\u4e4b\u9593\u7684\u8de8\u5132\u5b58/\u540c\u6b65\u529f\u80fd\u3002\u9019\u5141\u8a31\u4f60\u8f15\u9b06\u5730\u5207\u63db\u4e26\u4fdd\u7559\u4f60\u7684\u7d71\u8a08\u6578\u64da\u3002"}, {"question": "Car-Rush\u7684\u7d93\u6fdf\u9ad4\u7cfb\u8aaa\u660e\uff1aCar-Rush\u4e2d\u6709\u54ea\u5e7e\u7a2e\u985e\u578b\u7684\u8ca8\u5e63\uff1f\u5982\u4f55\u6700\u4f73\u5316\u734e\u52f5\uff0c\u4ee5\u53ca\u5982\u4f55\u6709\u6548\u5730\u5229\u7528\u6c7d\u8eca\u5347\u7d1a\u548c\u8cfc\u8cb7\u6c7d\u8eca\uff1f", "answer": "Car-Rush \u901a\u5e38\u5305\u542b\u5169\u7a2e\u904a\u6232\u8ca8\u5e63\uff1a\u73fe\u91d1\uff0c\u900f\u904e\u5b8c\u6210\u6bd4\u8cfd\u548c\u6311\u6230\u7372\u5f97\uff0c\u4ee5\u53ca\u91d1\u5e63\uff08\u6216\u7b49\u540c\u65bc\u9ad8\u7d1a\u8ca8\u5e63\uff09\uff0c\u900f\u904e\u5fae\u4ea4\u6613\u6216\u7279\u6b8a\u6d3b\u52d5\u7372\u5f97\u3002\u73fe\u91d1\u4e3b\u8981\u7528\u65bc\u6c7d\u8eca\u5347\u7d1a\u548c\u8cfc\u8cb7\u8f03\u4f4e\u7d1a\u5225\u7684\u8eca\u8f1b\uff0c\u800c\u91d1\u5e63\u5247\u53ef\u4ee5\u89e3\u9396\u9ad8\u7d1a\u8eca\u8f1b\u548c\u7368\u5bb6\u5ba2\u88fd\u5316\u7269\u54c1\u3002\u70ba\u4e86\u6700\u4f73\u5316\u734e\u52f5\uff0c\u8acb\u53c3\u52a0\u6bcf\u65e5\u6311\u6230\u4e26\u900f\u904e\u8077\u696d\u6a21\u5f0f\u95dc\u5361\u7372\u5f97\u73fe\u91d1\u3002\u907f\u514d\u885d\u52d5\u8cfc\u8cb7\uff0c\u512a\u5148\u5347\u7d1a\u5fc5\u8981\u7684\u6027\u80fd\u96f6\u4ef6\uff0c\u4e26\u5982\u679c\u60f3\u8981\u7372\u5f97\u65b0\u8eca\u8f1b\uff0c\u5247\u53ef\u89c0\u5bdf\u5176\u73fe\u72c0\u4e26\u8207\u4f60\u7684\u5148\u524d\u8cc7\u7522\u9032\u884c\u6bd4\u8f03\u3002\u512a\u5148\u9806\u4f4d\u81f3\u95dc\u91cd\u8981\u3002\u8003\u616e\u4ee5\u4e0b\u60c5\u6cc1\uff1a\u7528\u91d1\u5e63\u9032\u884c\u5347\u7d1a\u6216\u7acb\u5373\u7528\u91d1\u5e63\u8cfc\u8cb7\u65b0\u8eca\u3002"}, {"question": "Car-Rush\u96b1\u85cf\u5167\u5bb9\uff1aCar-Rush \u4e2d\u662f\u5426\u6709\u4efb\u4f55\u96b1\u85cf\u8eca\u8f1b\u6216\u79d8\u5bc6\u8cfd\u9053\uff1f\u5982\u679c\u6709\uff0c\u6211\u5982\u4f55\u89e3\u9396\u5b83\u5011\uff0c\u91cd\u9ede\u653e\u5728\u5f69\u86cb\u548c\u96b1\u85cf\u8eca\u8f1b\u7684\u4ee3\u865f\uff1f", "answer": "\u662f\u7684\uff0cCar-Rush \u5305\u542b\u53ef\u4ee5\u5728\u900f\u904e\u7279\u6b8a\u6210\u5c31\u6216\u627e\u5230\u5f69\u86cb\u4f86\u89e3\u9396\u7684\u96b1\u85cf\u8eca\u8f1b\u548c\u8cfd\u9053\u3002\u4e00\u500b\u4f8b\u5b50\u662f\u300e\u591c\u884c\u8005\u300f\u8eca\u8f1b\uff0c\u4ee3\u865f\u70ba\u300eProject X\u300f\uff0c\u53ef\u900f\u904e\u6240\u6709\u6642\u9593\u8cfd\u6311\u6230\u4ee5\u91d1\u724c\u5b8c\u6210\u4f86\u89e3\u9396\u3002\u53e6\u4e00\u500b\u79d8\u5bc6\uff0c\u300e\u5ee2\u68c4\u5de5\u5ee0\u300f\u8cfd\u9053\uff0c\u662f\u900f\u904e\u5728\u300e\u5de5\u696d\u78bc\u982d\u300f\u95dc\u5361\u627e\u5230\u4e00\u5e45\u96b1\u85cf\u7684\u5857\u9d09\u58c1\u756b\u4f86\u89e3\u9396\u3002\u4ed4\u7d30\u641c\u5c0b\u6bcf\u500b\u5340\u57df\uff0c\u4e26\u6ce8\u610f\u53ef\u80fd\u6697\u793a\u9019\u4e9b\u96b1\u85cf\u79d8\u5bc6\u7684\u958b\u767c\u4eba\u54e1\u8a0a\u606f\u6216\u7b26\u865f\u3002\u4e00\u500b\u7528\u65bc\u5c0b\u627e\u79d8\u5bc6\u4f4d\u7f6e\u7684\u5be6\u7528\u6bd4\u55bb\u662f\u57ce\u5e02\u88e1\u7684\u771f\u5be6\u4e16\u754c\u5c0b\u5bf6\u904a\u6232\u3002"}, {"question": "\u8003\u616e\u5230\u300eCar-Rush\u300f\u6301\u7e8c\u66f4\u65b0\uff0c\u8acb\u89e3\u91cb Car-Rush \u7684\u5f15\u64ce\u53ca\u5176\u5bb9\u91cf\uff1f\u5b83\u5982\u4f55\u8a08\u7b97\u5404\u7a2e\u5143\u7d20\uff1f\u6211\u5982\u4f55\u8f15\u9b06\u5730\u7406\u89e3\u9019\u500b\u5f15\u64ce\uff1f", "answer": "\u6c92\u6709 Car-Rush \u904a\u6232\u5f15\u64ce\u539f\u59cb\u78bc\u7684\u76f4\u63a5\u5b58\u53d6\uff0c\u660e\u78ba\u7684\u4e86\u89e3\u5e7e\u4e4e\u662f\u4e0d\u53ef\u80fd\u7684\u3002\u7136\u800c\uff0c\u53ef\u4ee5\u91dd\u5c0d\u904a\u6232\u884c\u70ba\u9032\u884c\u63a8\u8ad6\u3002Car-Rush \u64da\u6089\u4f7f\u7528\u865b\u5e7b\u5f15\u64ce 5 \u9032\u884c\u5716\u5f62\u548c\u6e32\u67d3\u8a08\u7b97\u4ee5\u53ca\u6700\u4f73\u5316\uff1b\u800c PhysX \u5247\u7528\u65bc\u7269\u7406\u904b\u7b97\u3002\u4ee5\u4e0b\u63d0\u4f9b\u66f4\u77ad\u89e3\u5f15\u64ce\u7684\u6d41\u7a0b\u3002\u6b65\u9a5f 1\uff1a\u5728\u904a\u6232\u904e\u7a0b\u4e2d\u5206\u6790\u9059\u6e2c\u6578\u64da\uff1b\u4f8b\u5982\u901f\u5ea6\u3001\u6f02\u79fb\u89d2\u5ea6\u548c\u5730\u5f62\u3002\u6b65\u9a5f 2\uff1a\u89c0\u5bdf\u66f4\u65b0/\u66f4\u6539\u8a2d\u5b9a\u5f8c\u7684\u5de5\u4f5c\u6548\u80fd\uff1b\u4e26\u5c07\u5176\u8a18\u9304\u4e0b\u4f86\u3002\u6b65\u9a5f 3\uff1a\u5617\u8a66\u63d0\u53d6\u904a\u6232\u6a94\u6848\u4ee5\u7372\u5f97\u958b\u767c\u4eba\u54e1\u65b0\u589e\u7684\u4efb\u4f55\u6709\u7528\u8cc7\u8a0a\u3002\u900f\u904e\u8003\u616e\u9019\u4e9b\u56e0\u7d20\uff0c\u904a\u6232\u611b\u597d\u8005\u53ef\u4ee5\u66f4\u597d\u5730\u4e86\u89e3\u5b83\uff0c\u5118\u7ba1\u5b83\u4e0d\u662f\u6e90\u78bc\u3002"}]
[{"question": "Car-Rush\u65b0\u624b\u6307\u5357\uff1a\u9a7e\u9a76\u548c\u6f02\u79fb\u7684\u57fa\u672c\u63a7\u5236\u662f\u4ec0\u4e48\uff0c\u5982\u4f55\u907f\u514d\u649e\u5230\u5899\u58c1\uff1f", "answer": "\u4f5c\u4e3a\u65b0\u73a9\u5bb6\uff0c\u638c\u63e1\u57fa\u672c\u63a7\u5236\u81f3\u5173\u91cd\u8981\u3002\u9ed8\u8ba4\u63a7\u5236\u901a\u5e38\u662f[WASD\u6216\u65b9\u5411\u952e]\u7528\u4e8e\u79fb\u52a8\uff0c[\u7a7a\u683c\u952e\u6216Shift\u952e]\u7528\u4e8e\u6f02\u79fb\u3002\u4e3a\u4e86\u907f\u514d\u78b0\u649e\uff0c\u8bf7\u7ec3\u4e60\u5e73\u7a33\u8f6c\u5411\uff0c\u5e76\u8f7b\u6309\u6f02\u79fb\u6309\u94ae\uff0c\u800c\u4e0d\u662f\u6309\u4f4f\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5e02\u533a\u6f02\u79fb\u201d\u5173\u5361\u4e2d\uff0c\u5728\u55b7\u6cc9\u9644\u8fd1\u7684\u6025\u8f6c\u5f2f\u5904\u8fdb\u884c\u77ed\u6f02\u79fb\uff0c\u4ee5\u4fdd\u6301\u901f\u5ea6\uff0c\u907f\u514d\u649e\u5230\u5899\u58c1\u3002\u60f3\u8c61\u4e00\u4e0b\uff0c\u4f60\u7684\u6c7d\u8f66\u7684\u52a8\u91cf\u5c31\u50cf\u4e00\u4e2a\u6446\u9524\uff1b\u5c0f\u8c03\u6574\u6bd4\u5927\u7684\u7a81\u7136\u53d8\u5316\u66f4\u597d\u3002\u8bb0\u4f4f\u5728\u8fdb\u884c\u6025\u8f6c\u5f2f\u4e4b\u524d\u5236\u52a8\uff08\u901a\u5e38\u662f[B]\uff09\uff0c\u4ee5\u4fbf\u8fdb\u884c\u66f4\u53d7\u63a7\u5236\u7684\u6f02\u79fb\u3002\u8fd9\u9879\u6280\u80fd\u5bf9\u4e8e\u4ee5\u540e\u66f4\u5177\u6311\u6218\u6027\u7684\u4efb\u52a1\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u7684\u8f66\u5728Car-Rush\u4e2d\u7a81\u7136\u51cf\u901f\uff0c\u4e0d\u540c\u5730\u5f62\u5bf9\u901f\u5ea6\u7684\u5f71\u54cd\u662f\u4ec0\u4e48\uff0c\u6211\u8be5\u5982\u4f55\u4fdd\u6301\u6700\u9ad8\u901f\u5ea6\uff1f", "answer": "\u4f60\u7684\u8f66\u901a\u5e38\u5728\u884c\u9a76\u5728\u5d0e\u5c96\u5730\u5f62\u6216\u53d1\u751f\u78b0\u649e\u65f6\u51cf\u901f\u3002\u4e0d\u540c\u7684\u8def\u9762\u4f1a\u5bf9\u4f60\u7684\u901f\u5ea6\u4ea7\u751f\u4e0d\u540c\u7684\u5f71\u54cd\uff1b\u6ca5\u9752\u63d0\u4f9b\u4e86\u6700\u4f73\u7684\u6293\u5730\u529b\u548c\u901f\u5ea6\uff0c\u800c\u8349\u5730\u548c\u6c99\u5b50\u4f1a\u663e\u8457\u964d\u4f4e\u901f\u5ea6\u3002\u4e3a\u4e86\u4fdd\u6301\u6700\u9ad8\u901f\u5ea6\uff0c\u8bf7\u59cb\u7ec8\u575a\u6301\u94fa\u597d\u7684\u9053\u8def\uff0c\u5e76\u5c3d\u53ef\u80fd\u907f\u514d\u8d8a\u91ce\u533a\u57df\u3002\u901f\u5ea6\u4e0b\u964d\u7684\u53e6\u4e00\u4e2a\u4e3b\u8981\u539f\u56e0\u662f\u635f\u574f\u3002\u6bcf\u6b21\u4f60\u53d1\u751f\u78b0\u649e\uff0c\u4f60\u7684\u6c7d\u8f66\u5b8c\u6574\u6027\u90fd\u4f1a\u964d\u4f4e\uff0c\u540c\u65f6\u901f\u5ea6\u5c5e\u6027\u4e5f\u4f1a\u964d\u4f4e\u3002\u8bf7\u67e5\u770b\u4e0b\u9762\u7684\u56fe\u7247\u4ee5\u66f4\u597d\u5730\u4e86\u89e3\u5730\u5f62\u5982\u4f55\u5f71\u54cd\u4f60\u7684\u6c7d\u8f66\u901f\u5ea6\u3002\n[\u6bd4\u8f83\u6ca5\u9752\u3001\u8349\u5730\u548c\u6c99\u5730\u901f\u5ea6\u7684\u56fe\u7247]\u3002\u6700\u540e\uff0c\u6bd4\u8d5b\u7ed3\u675f\u540e\u8bf7\u59cb\u7ec8\u4fee\u7406\u4f60\u7684\u6c7d\u8f66\u3002"}, {"question": "Car-Rush\u7cfb\u7edf\u8be6\u89e3\uff1a\u4f60\u80fd\u89e3\u91ca\u6c7d\u8f66\u5b9a\u5236\u9009\u9879\u4ee5\u53ca\u54ea\u4e9b\u5347\u7ea7\u5bf9\u6027\u80fd\u5f71\u54cd\u6700\u5927\uff0c\u7279\u522b\u662f\u5bf9\u4e8e\u8ba1\u65f6\u8d5b\uff1f", "answer": "\u6c7d\u8f66\u5b9a\u5236\u5141\u8bb8\u4f60\u901a\u8fc7\u5404\u79cd\u5347\u7ea7\u6765\u6539\u5584\u8f66\u8f86\u6027\u80fd\u3002\u5173\u952e\u533a\u57df\u662f\u53d1\u52a8\u673a\u3001\u8f6e\u80ce\u3001\u60ac\u6302\u548c\u7a7a\u6c14\u52a8\u529b\u5b66\u3002\u5bf9\u4e8e\u8ba1\u65f6\u8d5b\uff0c\u91cd\u70b9\u662f\u63d0\u5347\u52a0\u901f\u548c\u64cd\u63a7\u7684\u5347\u7ea7\u3002\u4f18\u5148\u8003\u8651\u53d1\u52a8\u673a\u7684\u539f\u59cb\u901f\u5ea6\u548c\u8f6e\u80ce\u7684\u6293\u5730\u529b\u548c\u8fc7\u5f2f\u6027\u80fd\u3002\u60ac\u6302\u6709\u52a9\u4e8e\u5e94\u5bf9\u98a0\u7c38\uff0c\u7a7a\u6c14\u52a8\u529b\u5b66\u5219\u5728\u9ad8\u901f\u884c\u9a76\u65f6\u51cf\u5c11\u963b\u529b\u3002\n\u4f8b\u5982\uff1a\u5c06\u201c\u666e\u901a\u8f6e\u80ce\u201d\u5347\u7ea7\u4e3a\u201c\u8fd0\u52a8\u8f6e\u80ce\u201d\u53ef\u4ee5\u5728\u201c\u6d77\u5cb8\u7ebf\u8d5b\u9053\u201d\u4e0a\u5c06\u4f60\u7684\u5708\u901f\u51cf\u5c111-2\u79d2\u3002\u4ee5\u4e0b\u662f\u4e00\u4e9b\u9ad8\u6548\u5347\u7ea7\u7b56\u7565\u7684\u8868\u683c\uff1a\n| \u5347\u7ea7 | \u5f71\u54cd | \u4f18\u52bf |\n| -------- | -------- | -------- |\n| \u53d1\u52a8\u673a | \u9ad8 | \u52a0\u901f/\u6700\u9ad8\u901f\u5ea6 |\n| \u8f6e\u80ce | \u9ad8 | \u6293\u5730\u529b/\u8fc7\u5f2f |\n| \u60ac\u6302 | \u4e2d | \u7a33\u5b9a\u6027/\u64cd\u63a7\u6027 |\n| \u7a7a\u6c14\u52a8\u529b\u5b66 | \u4e2d | \u6700\u9ad8\u901f\u5ea6 |"}, {"question": "\u6709\u54ea\u4e9b\u5177\u4f53\u7684\u8c03\u6821\u9009\u9879\u53ef\u5728Car-Rush\u4e2d\u4f7f\u7528\uff0c\u5b83\u4eec\u5982\u4f55\u5f71\u54cd\u64cd\u63a7\u6027\u548c\u901f\u5ea6\uff1f\u6211\u8be5\u5982\u4f55\u5229\u7528\u8fd9\u4e9b\u9009\u9879\u6765\u83b7\u5f97\u66f4\u597d\u7684\u6bd4\u8d5b\u6210\u7ee9\uff1f", "answer": "Car-Rush\u4e2d\u7684\u8c03\u6821\u9009\u9879\u901a\u5e38\u6d89\u53ca\u8c03\u6574\u8bf8\u5982\u8f6e\u80ce\u538b\u529b\u3001\u60ac\u6302\u786c\u5ea6\u548c\u9f7f\u8f6e\u6bd4\u7b49\u53c2\u6570\u3002\u8f6e\u80ce\u538b\u529b\u4f1a\u5f71\u54cd\u6293\u5730\u529b\u548c\u6eda\u52a8\u963b\u529b\uff1b\u8f83\u4f4e\u7684\u538b\u529b\u4f1a\u589e\u52a0\u6293\u5730\u529b\uff0c\u4f46\u53ef\u80fd\u4f1a\u964d\u4f4e\u6700\u9ad8\u901f\u5ea6\u3002\u60ac\u6302\u786c\u5ea6\u4f1a\u5f71\u54cd\u64cd\u63a7\u54cd\u5e94\uff1b\u66f4\u786c\u7684\u60ac\u6302\u4f1a\u51cf\u5c11\u8f66\u8eab\u4fa7\u503e\uff0c\u4f46\u4f1a\u4f7f\u8f66\u8f86\u5bf9\u98a0\u7c38\u66f4\u654f\u611f\u3002\u9f7f\u8f6e\u6bd4\u4f1a\u5f71\u54cd\u52a0\u901f\u548c\u6700\u9ad8\u901f\u5ea6\uff1b\u8f83\u77ed\u7684\u9f7f\u8f6e\u4f1a\u63d0\u9ad8\u52a0\u901f\u80fd\u529b\uff0c\u4f46\u4f1a\u964d\u4f4e\u6700\u9ad8\u901f\u5ea6\uff0c\u53cd\u4e4b\u4ea6\u7136\uff0c\u8f83\u957f\u7684\u9f7f\u8f6e\u6bd4\u5219\u4f1a\u63d0\u4f9b\u66f4\u9ad8\u7684\u6700\u9ad8\u901f\u5ea6\uff0c\u4f46\u52a0\u901f\u80fd\u529b\u8f83\u5f31\u3002\u4e3a\u4e86\u4f18\u5316\u4f60\u7684\u8bbe\u7f6e\uff0c\u8bf7\u5c1d\u8bd5\u8fdb\u884c\u5c11\u91cf\u8c03\u6574\u5e76\u8ddf\u8e2a\u4f60\u7684\u5708\u901f\u3002\u6b65\u9aa41\uff1a\u4ece\u9ed8\u8ba4\u8bbe\u7f6e\u5f00\u59cb\u3002\u6b65\u9aa42\uff1a\u6bcf\u6b21\u4fee\u6539\u4e00\u4e2a\u53c2\u6570\uff08\u4f8b\u5982\uff0c\u8f6e\u80ce\u538b\u529b\uff09\uff0c\u6b65\u9aa43\uff1a\u591a\u6b21\u6d4b\u8bd5\u65b0\u7684\u8c03\u6574\u3002\u4f7f\u7528\u7535\u5b50\u8868\u683c\u8bb0\u5f55\u8c03\u6574\u548c\u7ed3\u679c\u3002"}, {"question": "Car-Rush\u8fdb\u9636\u7b56\u7565\uff1a\u5982\u4f55\u5728\u4e0d\u540c\u7684\u6bd4\u8d5b\u573a\u666f\u4e2d\u6709\u6548\u5730\u4f7f\u7528\u6c2e\u6c14\u589e\u76ca\uff0c\u4ee5\u53ca\u5982\u4f55\u6700\u597d\u5730\u4fdd\u5b58\u5b83\u4eec\uff1f", "answer": "\u6c2e\u6c14\u589e\u76ca\u63d0\u4f9b\u77ed\u6682\u7684\u901f\u5ea6\u63d0\u5347\uff0c\u4f46\u6709\u6548\u5229\u7528\u5b83\u4eec\u9700\u8981\u7b56\u7565\u3002\u5728\u76f4\u9053\u4e0a\uff0c\u4f7f\u7528\u6c2e\u6c14\u6765\u4fdd\u6301\u6700\u9ad8\u901f\u5ea6\u6216\u8d85\u8d8a\u5bf9\u624b\u3002\u5728\u5f2f\u9053\u4e0a\uff0c\u4fdd\u7559\u6c2e\u6c14\u4ee5\u52a0\u5feb\u9a76\u51fa\u5f2f\u9053\uff0c\u83b7\u5f97\u4f18\u52bf\u3002\u4e3a\u4e86\u8282\u7701\u6c2e\u6c14\uff0c\u907f\u514d\u4e0d\u5fc5\u8981\u7684\u6d6a\u8d39\uff0c\u5c24\u5176\u662f\u5728\u4e0b\u5761\u8def\u6bb5\uff0c\u91cd\u529b\u672c\u8eab\u5df2\u7ecf\u63d0\u4f9b\u4e86\u52a0\u901f\u5ea6\u3002\u5728\u6bd4\u8d5b\u4e2d\u6536\u96c6\u6c2e\u6c14\u9053\u5177\u53ef\u4ee5\u8865\u5145\u4f60\u7684\u50a8\u5907\u3002\u4e00\u4e2a\u89c6\u89c9\u8868\u793a\u53ef\u4ee5\u663e\u793a\u6e38\u620f\u73a9\u6cd5\u573a\u666f\u7684\u6d41\u7a0b\uff0c \u5728\u8fd9\u4e9b\u573a\u666f\u4e2d\u4f60\u5e94\u8be5\u63d0\u5347\u6c7d\u8f66\u3002\n[\u8bf4\u660e\u5982\u4f55\u5728\u4e0d\u540c\u8d5b\u8f66\u573a\u666f\u4e2d\u4f7f\u7528\u6c2e\u6c14\u7684\u51b3\u7b56\u6811\u6d41\u7a0b\u56fe]"}, {"question": "Car-Rush\u7cfb\u7edf\u89e3\u6790\uff1a\u6e38\u620f\u5982\u4f55\u8ba1\u7b97\u6f02\u79fb\u5206\u6570\uff0c\u4ee5\u53ca\u5728\u6f02\u79fb\u6311\u6218\u4e2d\u54ea\u4e9b\u6280\u5de7\u53ef\u4ee5\u6700\u5927\u5316\u6211\u7684\u5f97\u5206\uff1f\u6bd4\u8f83\u7b80\u5355\u7684\u6f02\u79fb\u548c\u8fde\u73af\u6f02\u79fb\u7684\u5206\u6570\uff0c\u4ee5\u53ca\u5206\u6570\u4e58\u6570\u3002", "answer": "\u6f02\u79fb\u5206\u6570\u57fa\u4e8e\u6f02\u79fb\u89d2\u5ea6\u3001\u901f\u5ea6\u548c\u6301\u7eed\u65f6\u95f4\u8ba1\u7b97\u3002\u6f02\u79fb\u7684\u65f6\u95f4\u548c\u5bbd\u5ea6\u8d8a\u957f\uff0c\u5206\u6570\u8d8a\u9ad8\u3002\u5c06\u6f02\u79fb\u8fde\u63a5\u5728\u4e00\u8d77\uff0c\u800c\u4e0d\u4f7f\u5176\u53d8\u76f4\uff0c\u4f1a\u663e\u8457\u589e\u52a0\u4f60\u7684\u5f97\u5206\u4e58\u6570\u3002\u4e3a\u4e86\u6700\u5927\u5316\u5206\u6570\uff0c\u5c3d\u65e9\u5f00\u59cb\u6f02\u79fb\uff0c\u5e76\u5728\u6574\u4e2a\u8f6c\u5f2f\u8fc7\u7a0b\u4e2d\u4fdd\u6301\u4e00\u81f4\u7684\u89d2\u5ea6\u3002\u4f7f\u7528\u6cb9\u95e8\u63a7\u5236\u548c\u8f7b\u5fae\u7684\u8f6c\u5411\u8c03\u6574\uff0c\u4ee5\u9632\u6b62\u8f66\u8f86\u6253\u8f6c\u3002\u5728\u50cf\u201c\u57ce\u5e02\u5df7\u9053\u201d\u8fd9\u6837\u7684\u6f02\u79fb\u6311\u6218\u4e2d\uff0c\u76ee\u6807\u662f\u5728\u89d2\u843d\u91cc\u8fdb\u884c\u957f\u65f6\u95f4\u3001\u8fde\u7eed\u7684\u6f02\u79fb\uff0c\u5e76\u5c3d\u53ef\u80fd\u5c06\u5b83\u4eec\u8fde\u63a5\u5728\u4e00\u8d77\u3002\u4e00\u5f20\u6bd4\u8f83\u5355\u6b21\u6f02\u79fb\u4e0e\u8fde\u73af\u6f02\u79fb\u5206\u6570\u7684\u8868\u683c\u6e05\u695a\u5730\u5c55\u793a\u4e86\u6f02\u79fb\u6280\u5de7\u5e26\u6765\u7684\u5f97\u5206\u589e\u52a0\u3002\n[\u6bd4\u8f83\u5355\u6b21\u6f02\u79fb\u4e0e\u8fde\u73af\u6f02\u79fb\u5e73\u5747\u5206\u6570\u7684\u8868\u683c]\u3002\u8bb0\u4f4f\uff0c\u5728\u8fde\u73af\u6f02\u79fb\u7684\u540c\u65f6\u4fdd\u6301\u9ad8\u901f\u5bf9\u9ad8\u5206\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "Car-Rush\u8de8\u5e73\u53f0\uff1aCar-Rush\u662f\u5426\u53ef\u5728\u591a\u4e2a\u5e73\u53f0\u4e0a\u4f7f\u7528\uff0c\u6e38\u620f\u662f\u5426\u63d0\u4f9b\u8de8\u5e73\u53f0\u6e38\u620f\u6216PC\u3001\u4e3b\u673a\u548c\u79fb\u52a8\u8bbe\u5907\u4e4b\u95f4\u7684\u5b58\u6863\u6570\u636e\u540c\u6b65\uff1f", "answer": "\u76ee\u524d\uff0cCar-Rush\u53ef\u5728\u79fb\u52a8\u5e73\u53f0\uff08iOS\u548cAndroid\uff09\u4ee5\u53caPC\uff08Steam\uff09\u4e0a\u4f7f\u7528\u3002\u4e0d\u5e78\u7684\u662f\uff0c\u6e38\u620f\u76ee\u524d\u4e0d\u63d0\u4f9b\u8de8\u5e73\u53f0\u6e38\u620f\u3002\u867d\u7136\u6ca1\u6709\u8de8\u5e73\u53f0\u6e38\u620f\uff0c\u4f46\u76ee\u524d\u5df2\u5728\u79fb\u52a8\u8bbe\u5907\u4e4b\u95f4\u5b9e\u73b0\u4e86\u8de8\u5e73\u53f0\u5b58\u6863/\u540c\u6b65\u529f\u80fd\u3002\u8fd9\u4f7f\u4f60\u80fd\u591f\u8f7b\u677e\u8f6c\u6362\u5e76\u4fdd\u7559\u4f60\u7684\u6570\u636e\u3002"}, {"question": "Car-Rush\u7684\u7ecf\u6d4e\u4f53\u7cfb\u8bf4\u660e\uff1aCar-Rush\u4e2d\u6709\u54ea\u4e9b\u4e0d\u540c\u7c7b\u578b\u7684\u8d27\u5e01\uff0c\u5982\u4f55\u4f18\u5316\u5956\u52b1\uff0c\u4ee5\u53ca\u5982\u4f55\u6709\u6548\u5730\u4f7f\u7528\u6c7d\u8f66\u5347\u7ea7\u548c\u8d2d\u4e70\u6c7d\u8f66\uff1f", "answer": "Car-Rush\u901a\u5e38\u5305\u542b\u4e24\u79cd\u7c7b\u578b\u7684\u6e38\u620f\u8d27\u5e01\uff1a\u73b0\u91d1\uff0c\u901a\u8fc7\u5b8c\u6210\u6bd4\u8d5b\u548c\u6311\u6218\u83b7\u5f97\uff1b\u4ee5\u53ca\u91d1\u5e01\uff08\u6216\u7b49\u6548\u7684\u4ed8\u8d39\u8d27\u5e01\uff09\uff0c\u901a\u8fc7\u5fae\u4ea4\u6613\u6216\u7279\u522b\u6d3b\u52a8\u83b7\u5f97\u3002\u73b0\u91d1\u4e3b\u8981\u7528\u4e8e\u6c7d\u8f66\u5347\u7ea7\u548c\u8d2d\u4e70\u8f83\u4f4e\u7ea7\u522b\u7684\u8f66\u8f86\uff0c\u800c\u91d1\u5e01\u5219\u53ef\u89e3\u9501\u9ad8\u7ea7\u6c7d\u8f66\u548c\u4e13\u5c5e\u5b9a\u5236\u7269\u54c1\u3002\u4e3a\u4e86\u4f18\u5316\u5956\u52b1\uff0c\u53c2\u4e0e\u6bcf\u65e5\u6311\u6218\u5e76\u52aa\u529b\u5b8c\u6210\u804c\u4e1a\u6a21\u5f0f\u5173\u5361\u4ee5\u83b7\u5f97\u73b0\u91d1\u3002\u907f\u514d\u51b2\u52a8\u6d88\u8d39\uff0c\u4f18\u5148\u5347\u7ea7\u5fc5\u4e0d\u53ef\u5c11\u7684\u6027\u80fd\u90e8\u4ef6\uff0c\u5982\u679c\u60a8\u60f3\u8981\u83b7\u5f97\u65b0\u8f66\uff0c\u8bf7\u89c2\u5bdf\u5176\u72b6\u6001\u5e76\u4e0e\u60a8\u7684\u5148\u524d\u8d44\u4ea7\u8fdb\u884c\u6bd4\u8f83\u3002\u4f18\u5148\u7ea7\u81f3\u5173\u91cd\u8981\u3002\u8003\u8651\u4ee5\u4e0b\u60c5\u51b5\uff1a\u82b1\u91d1\u5e01\u5347\u7ea7\uff0c\u6216\u7acb\u5373\u7528\u91d1\u5e01\u8d2d\u4e70\u65b0\u8f66\u3002"}, {"question": "Car-Rush\u9690\u85cf\u5185\u5bb9\uff1aCar-Rush\u4e2d\u662f\u5426\u5b58\u5728\u4efb\u4f55\u9690\u85cf\u8f66\u8f86\u6216\u79d8\u5bc6\u8d5b\u9053\uff1f\u5982\u679c\u6709\uff0c\u5982\u4f55\u89e3\u9501\u5b83\u4eec\uff0c\u5177\u4f53\u5173\u6ce8\u5f69\u86cb\u548c\u9690\u85cf\u8f66\u8f86\u7684\u4ee3\u53f7\uff1f", "answer": "\u662f\u7684\uff0cCar-Rush\u5305\u542b\u53ef\u4ee5\u901a\u8fc7\u7279\u6b8a\u6210\u5c31\u6216\u627e\u5230\u5f69\u86cb\u6765\u89e3\u9501\u7684\u9690\u85cf\u8f66\u8f86\u548c\u8d5b\u9053\u3002\u4e00\u4e2a\u4f8b\u5b50\u662f\u201c\u591c\u884c\u8005\u201d\u6c7d\u8f66\uff0c\u4ee3\u53f7\u4e3a\u201cX\u8ba1\u5212\u201d\uff0c\u53ef\u4ee5\u901a\u8fc7\u5728\u6240\u6709\u8ba1\u65f6\u8d5b\u6311\u6218\u4e2d\u83b7\u5f97\u91d1\u724c\u6765\u89e3\u9501\u3002\u53e6\u4e00\u4e2a\u79d8\u5bc6\u8d5b\u9053\u201c\u88ab\u9057\u5fd8\u7684\u5de5\u5382\u201d\u53ef\u4ee5\u901a\u8fc7\u5728\u201c\u5de5\u4e1a\u7801\u5934\u201d\u5173\u5361\u4e2d\u627e\u5230\u9690\u85cf\u7684\u6d82\u9e26\u58c1\u753b\u6765\u89e3\u9501\u3002\u4ed4\u7ec6\u641c\u7d22\u6bcf\u4e2a\u5173\u5361\u7684\u6bcf\u4e00\u4e2a\u89d2\u843d\uff0c\u5e76\u6ce8\u610f\u53ef\u80fd\u6697\u793a\u8fd9\u4e9b\u9690\u85cf\u79d8\u5bc6\u7684\u5f00\u53d1\u4eba\u5458\u6d88\u606f\u6216\u7b26\u53f7\u3002\u627e\u5230\u79d8\u5bc6\u4f4d\u7f6e\u7684\u6709\u7528\u7c7b\u6bd4\u662f\u4f60\u5728\u57ce\u5e02\u4e2d\u8fdb\u884c\u7684\u73b0\u5b9e\u4e16\u754c\u5bfb\u5b9d\u6e38\u620f\u3002"}, {"question": "\u8003\u8651\u5230'Car-Rush'\u6301\u7eed\u66f4\u65b0\uff0c\u4f60\u80fd\u89e3\u91ca'Car-Rush'\u7684\u5f15\u64ce\u4ee5\u53ca\u5176\u80fd\u529b\u5417\uff1f\u5b83\u5982\u4f55\u8ba1\u7b97\u5404\u79cd\u5143\u7d20\u4ee5\u53ca\u5982\u4f55\u8f7b\u677e\u7406\u89e3\u8fd9\u4e2a\u5f15\u64ce\uff1f", "answer": "\u6ca1\u6709\u76f4\u63a5\u8bbf\u95eeCar-Rush\u6e38\u620f\u5f15\u64ce\u6e90\u4ee3\u7801\uff0c\u56e0\u6b64\u5f88\u96be\u83b7\u5f97\u660e\u786e\u7684\u7406\u89e3\u3002\u4f46\u662f\u53ef\u4ee5\u636e\u6e38\u620f\u7684\u884c\u4e3a\u8fdb\u884c\u63a8\u6d4b\u3002\u636e\u6089\uff0cCar-Rush\u4f7f\u7528\u865a\u5e7b\u5f15\u64ce5\u8fdb\u884c\u56fe\u5f62\u548c\u6e32\u67d3\u8ba1\u7b97\u4ee5\u53ca\u4f18\u5316\uff1bPhysisX\u7528\u4e8e\u7269\u7406\u8ba1\u7b97\u3002\u4ee5\u4e0b\u662f\u66f4\u597d\u5730\u4e86\u89e3\u5f15\u64ce\u7684\u6d41\u7a0b\u3002\u6b65\u9aa41\uff1a\u5206\u6790\u6e38\u620f\u8fc7\u7a0b\u4e2d\u7684\u9065\u6d4b\u6570\u636e\uff1b\u4f8b\u5982\u901f\u5ea6\u3001\u6f02\u79fb\u89d2\u5ea6\u548c\u5730\u5f62\u3002\u6b65\u9aa42\uff1a\u89c2\u5bdf\u66f4\u65b0/\u66f4\u6539\u8bbe\u7f6e\u540e\u7684\u6027\u80fd\u57fa\u51c6\uff1b\u5e76\u8bb0\u5f55\u5b83\u4eec\u3002\u6b65\u9aa43\uff1a\u5c1d\u8bd5\u63d0\u53d6\u6e38\u620f\u6587\u4ef6\u4ee5\u83b7\u53d6\u5f00\u53d1\u8005\u6dfb\u52a0\u7684\u4efb\u4f55\u6709\u7528\u4fe1\u606f\u3002\u901a\u8fc7\u8003\u8651\u8fd9\u4e9b\u56e0\u7d20\uff0c\u6e38\u620f\u7231\u597d\u8005\u53ef\u4ee5\u66f4\u597d\u5730\u7406\u89e3\u5b83\uff0c\u5c3d\u7ba1\u8fd9\u5e76\u4e0d\u662f\u76f4\u63a5\u7684\u6e90\u4ee3\u7801\u3002"}]
[{"question": "Car-Rush \ucd08\ubcf4 \uc548\ub0b4: \uc6b4\uc804 \ubc0f \ub4dc\ub9ac\ud504\ud2b8 \uae30\ubcf8 \uc870\uc791\ubc95\uacfc \ubcbd \ucda9\ub3cc\uc744 \ud53c\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub85c\uc11c \uae30\ubcf8 \uc870\uc791\ubc95\uc744 \uc219\ub2ec\ud558\ub294 \uac83\uc740 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uae30\ubcf8 \uc870\uc791\uc740 \uc77c\ubc18\uc801\uc73c\ub85c [WASD \ub610\ub294 \ud654\uc0b4\ud45c \ud0a4]\ub85c \uc774\ub3d9\ud558\uace0 [\uc2a4\ud398\uc774\uc2a4\ubc14 \ub610\ub294 \uc26c\ud504\ud2b8 \ud0a4]\ub85c \ub4dc\ub9ac\ud504\ud2b8\ud569\ub2c8\ub2e4. \ucda9\ub3cc\uc744 \ud53c\ud558\ub824\uba74 \uc2a4\ud2f0\uc5b4\ub9c1\uc744 \ubd80\ub4dc\ub7fd\uac8c \uc870\uc791\ud558\uace0 \ub4dc\ub9ac\ud504\ud2b8 \ubc84\ud2bc\uc744 \ub204\ub974\ub294 \ub300\uc2e0 \ud0ed\ud558\ub294 \uc5f0\uc2b5\uc744 \ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, '\ub3c4\uc2ec \ub4dc\ub9ac\ud504\ud2b8' \ub808\ubca8\uc5d0\uc11c\ub294 \ubd84\uc218 \uadfc\ucc98\uc758 \uae09\ucee4\ube0c\uc5d0\uc11c \uc9e7\uc740 \ub4dc\ub9ac\ud504\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc5ec \ubcbd\uc5d0 \ubd80\ub52a\ud788\uc9c0 \uc54a\uace0 \uc18d\ub3c4\ub97c \uc720\uc9c0\ud558\uc2ed\uc2dc\uc624. \ucc28\ub7c9\uc758 \uc6b4\ub3d9\ub7c9\uc744 \ucd94\ub97c \uc0dd\uac01\ud558\ub4ef\uc774 \uc791\uc740 \uc870\uc815\uc774 \ud070 \uac11\uc791\uc2a4\ub7ec\uc6b4 \ubcc0\ud654\ubcf4\ub2e4 \ub0ab\uc2b5\ub2c8\ub2e4. \uc881\uc740 \ucf54\ub108\uc5d0\uc11c\ub294 (\uc77c\ubc18\uc801\uc73c\ub85c [B]) \ube0c\ub808\uc774\ud06c\ub97c \ubc1f\uc544 \ub354\uc6b1 \ud1b5\uc81c\ub41c \ub4dc\ub9ac\ud504\ud2b8\ub97c \ud558\uc2ed\uc2dc\uc624. \uc774 \uae30\uc220\uc740 \ub098\uc911\uc5d0 \ub354 \uc5b4\ub824\uc6b4 \ucc4c\ub9b0\uc9c0\uc5d0 \ud544\uc218\uc801\uc785\ub2c8\ub2e4."}, {"question": "Car-Rush\uc5d0\uc11c \uac11\uc790\uae30 \ucc28\uac00 \ub290\ub824\uc9c0\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc11c\ub85c \ub2e4\ub978 \uc9c0\ud615\uc774 \uc18d\ub3c4\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uacfc \ucd5c\uace0 \uc18d\ub3c4\ub97c \uc720\uc9c0\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ucc28\uac00 \uc77c\ubc18\uc801\uc73c\ub85c \uac70\uce5c \uc9c0\ud615 \uc8fc\ud589\uc774\ub098 \ucda9\ub3cc\ub85c \uc778\ud574 \uc18d\ub3c4\uac00 \ub290\ub824\uc9d1\ub2c8\ub2e4. \uc11c\ub85c \ub2e4\ub978 \ud45c\uba74\uc740 \uc18d\ub3c4\uc5d0 \ub2e4\ub978 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc544\uc2a4\ud314\ud2b8\ub294 \ucd5c\uc0c1\uc758 \uadf8\ub9bd\ub825\uacfc \uc18d\ub3c4\ub97c \uc81c\uacf5\ud558\ub294 \ubc18\uba74, \uc794\ub514\uc640 \ubaa8\ub798\ub294 \uc18d\ub3c4\ub97c \ud06c\uac8c \uc904\uc785\ub2c8\ub2e4. \ucd5c\uace0 \uc18d\ub3c4\ub97c \uc720\uc9c0\ud558\ub824\uba74 \ud56d\uc0c1 \ud3ec\uc7a5\ub41c \ub3c4\ub85c\ub97c \ub530\ub77c \ub2e4\ub2c8\uace0 \uac00\ub2a5\ud55c \ud55c \uc624\ud504\ub85c\ub4dc \uad6c\uc5ed\uc744 \ud53c\ud558\uc2ed\uc2dc\uc624. \uc18d\ub3c4 \uc800\ud558\uc758 \ub610 \ub2e4\ub978 \uc8fc\uc694 \uc6d0\uc778\uc740 \uc190\uc0c1\uc785\ub2c8\ub2e4. \ub9e4\ubc88 \ucda9\ub3cc\ud560 \ub54c\ub9c8\ub2e4 \ucc28\ub7c9\uc758 \uc548\uc804\uc131\uc774 \uac10\uc18c\ud558\uace0 \ub3d9\uc2dc\uc5d0 \uc18d\ub3c4\uac00 \ub5a8\uc5b4\uc9d1\ub2c8\ub2e4. \uc9c0\ud615\uc774 \ucc28\ub7c9 \uc18d\ub3c4\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294\uc9c0 \ub354 \uc798 \uc774\ud574\ud558\ub824\uba74 \uc544\ub798 \uc774\ubbf8\uc9c0\ub97c \ucc38\uc870\ud558\uc2ed\uc2dc\uc624. \n [\uc544\uc2a4\ud314\ud2b8, \uc794\ub514, \ubaa8\ub798\uc5d0\uc11c\uc758 \uc18d\ub3c4 \ube44\uad50 \uc774\ubbf8\uc9c0]. \ub9c8\uc9c0\ub9c9\uc73c\ub85c \uacbd\uc8fc \ud6c4\uc5d0\ub294 \ud56d\uc0c1 \ucc28\ub7c9\uc744 \uc218\ub9ac\ud558\uc2ed\uc2dc\uc624."}, {"question": "Car-Rush \uc2dc\uc2a4\ud15c \uc124\uba85: \ucc28\ub7c9 \uac1c\uc870 \uc635\uc158\uacfc \uc131\ub2a5\uc5d0 \uac00\uc7a5 \ud070 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uc5c5\uadf8\ub808\uc774\ub4dc(\ud2b9\ud788 \uc2dc\uac04 \uacbd\uc7c1)\uc5d0 \ub300\ud574 \uc124\uba85\ud574\uc8fc\uc2ed\uc2dc\uc624.", "answer": "\ucc28\ub7c9 \uac1c\uc870\ub97c \ud1b5\ud574 \ub2e4\uc591\ud55c \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \ud1b5\ud574 \ucc28\ub7c9 \uc131\ub2a5\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc8fc\uc694 \uc601\uc5ed\uc740 \uc5d4\uc9c4, \ud0c0\uc774\uc5b4, \uc11c\uc2a4\ud39c\uc158 \ubc0f \uacf5\ub825\ud559\uc785\ub2c8\ub2e4. \uc2dc\uac04 \uacbd\uc7c1\uc5d0\uc11c\ub294 \uac00\uc18d\ub3c4\uc640 \ud578\ub4e4\ub9c1\uc744 \ub192\uc774\ub294 \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \uc21c\uc218\ud55c \uc18d\ub3c4\ub97c \uc704\ud574 \uc5d4\uc9c4\uc744 \uc6b0\uc120\uc2dc\ud558\uace0, \ub354 \ub098\uc740 \uadf8\ub9bd\ub825\uacfc \ucf54\ub108\ub9c1\uc744 \uc704\ud574 \ud0c0\uc774\uc5b4\ub97c \uc6b0\uc120\uc2dc\ud558\uc2ed\uc2dc\uc624. \uc11c\uc2a4\ud39c\uc158\uc740 \ucda9\uaca9\uc5d0 \ub300\ud55c \ud578\ub4e4\ub9c1\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uace0, \uacf5\ub825\ud559\uc740 \uace0\uc18d\uc5d0\uc11c\uc758 \uacf5\uae30 \uc800\ud56d\uc744 \uc904\uc785\ub2c8\ub2e4. \n \uc608: '\uc2a4\ud1a1 \ud0c0\uc774\uc5b4'\ub97c '\uc2a4\ud3ec\uce20 \ud0c0\uc774\uc5b4'\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uba74 '\ud574\uc548 \uc11c\ud0b7' \ud2b8\ub799\uc5d0\uc11c \ub7a9 \ud0c0\uc784\uc774 1~2\ucd08 \ub2e8\ucd95\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud6a8\uc728\uc801\uc778 \uc5c5\uadf8\ub808\uc774\ub4dc \uc804\ub7b5\uc5d0 \ub300\ud55c \ud45c\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: \n | \uc5c5\uadf8\ub808\uc774\ub4dc | \uc601\ud5a5 | \uc774\uc810 | \n | --------- | ------- | -------- | \n | \uc5d4\uc9c4 | \ub192\uc74c | \uac00\uc18d\ub3c4/\ucd5c\uace0 \uc18d\ub3c4 | \n | \ud0c0\uc774\uc5b4 | \ub192\uc74c | \uadf8\ub9bd/\ucf54\ub108\ub9c1 | \n | \uc11c\uc2a4\ud39c\uc158 | \uc911\uac04 | \uc548\uc815\uc131/\ud578\ub4e4\ub9c1 | \n | \uacf5\ub825\ud559 | \uc911\uac04 | \ucd5c\uace0 \uc18d\ub3c4 |"}, {"question": "Car-Rush\uc5d0\uc11c \uc0ac\uc6a9 \uac00\ub2a5\ud55c \ud2b9\uc815 \ud29c\ub2dd \uc635\uc158\uc740 \ubb34\uc5c7\uc774\uba70, \ud578\ub4e4\ub9c1\uacfc \uc18d\ub3c4\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c? \uc5b4\ub5bb\uac8c \ud558\uba74 \uc774\ub7ec\ud55c \uc635\uc158\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub354 \ub098\uc740 \ub808\uc774\uc2a4\ub97c \ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Car-Rush\uc758 \ud29c\ub2dd \uc635\uc158\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \ud0c0\uc774\uc5b4 \uacf5\uae30\uc555, \uc11c\uc2a4\ud39c\uc158 \uac15\uc131 \ubc0f \uae30\uc5b4\ube44\uc640 \uac19\uc740 \ub9e4\uac1c\ubcc0\uc218 \uc870\uc815\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \ud0c0\uc774\uc5b4 \uacf5\uae30\uc555\uc740 \uadf8\ub9bd\ub825\uacfc \uad74\ub9bc \uc800\ud56d\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uacf5\uae30\uc555\uc774 \ub0ae\uc744\uc218\ub85d \uadf8\ub9bd\ub825\uc740 \uc99d\uac00\ud558\uc9c0\ub9cc \ucd5c\uace0 \uc18d\ub3c4\ub294 \uac10\uc18c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc11c\uc2a4\ud39c\uc158 \uac15\uc131\uc740 \ud578\ub4e4\ub9c1 \ubc18\uc751\uc131\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc11c\uc2a4\ud39c\uc158 \uac15\uc131\uc774 \ub192\uc744\uc218\ub85d \ub864\ub9c1\uc774 \uc904\uc5b4\ub4e4\uc9c0\ub9cc \ucc28\ub7c9\uc774 \ucda9\uaca9\uc5d0 \ubbfc\uac10\ud574\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uae30\uc5b4\ube44\ub294 \uac00\uc18d\ub3c4\uc640 \ucd5c\uace0 \uc18d\ub3c4\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc9e7\uc740 \uae30\uc5b4\ub294 \uac00\uc18d\ub3c4\ub97c \ub192\uc774\uc9c0\ub9cc \ucd5c\uace0 \uc18d\ub3c4\ub97c \ub0ae\ucd94\uace0, \ubc18\ub300\ub85c \uae34 \uae30\uc5b4\ub294 \ucd5c\uace0 \uc18d\ub3c4\ub97c \ub192\uc774\uc9c0\ub9cc \uac00\uc18d\ub3c4\ub294 \ub0ae\ucda5\ub2c8\ub2e4. \uc124\uc815\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc791\uc740 \uc870\uc815\uc744 \uc2dc\ub3c4\ud558\uace0 \ub7a9 \ud0c0\uc784\uc744 \ucd94\uc801\ud558\uc2ed\uc2dc\uc624. STEP1: \uae30\ubcf8 \uc124\uc815\uc73c\ub85c \uc2dc\uc791\ud569\ub2c8\ub2e4. STEP2: \ud55c \ubc88\uc5d0 \ud558\ub098\uc758 \ub9e4\uac1c\ubcc0\uc218\ub97c \uc218\uc815\ud569\ub2c8\ub2e4(\uc608: \ud0c0\uc774\uc5b4 \uacf5\uae30\uc555). STEP3: \uc0c8\ub85c\uc6b4 \uc870\uc815\uc744 \uc5ec\ub7ec \ubc88 \ud14c\uc2a4\ud2b8\ud569\ub2c8\ub2e4. \uc870\uc815 \ubc0f \uacb0\uacfc\ub97c \uae30\ub85d\ud558\uae30 \uc704\ud574 \uc2a4\ud504\ub808\ub4dc\uc2dc\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624."}, {"question": "Car-Rush \uace0\uae09 \uc804\ub7b5: \uc11c\ub85c \ub2e4\ub978 \ub808\uc774\uc2f1 \uc0c1\ud669\uc5d0\uc11c \ub2c8\ud2b8\ub85c \ubd80\uc2a4\ud2b8\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \ubc29\ubc95\uacfc \uc774\ub97c \uc808\uc57d\ud558\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub2c8\ud2b8\ub85c \ubd80\uc2a4\ud2b8\ub294 \uc77c\uc2dc\uc801\uc778 \uc18d\ub3c4 \uc99d\uac00\ub97c \uc81c\uacf5\ud558\uc9c0\ub9cc, \uc774\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub824\uba74 \uc804\ub7b5\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc9c1\uc120 \ucf54\uc2a4\uc5d0\uc11c\ub294 \ub2c8\ud2b8\ub85c\ub97c \uc0ac\uc6a9\ud558\uc5ec \ucd5c\uace0 \uc18d\ub3c4\ub97c \uc720\uc9c0\ud558\uac70\ub098 \uc0c1\ub300\ub97c \ucd94\uc6d4\ud558\uc2ed\uc2dc\uc624. \ucf54\ub108\uc5d0\uc11c\ub294 \ucf54\ub108\ub97c \ube60\uc838\ub098\uac00\ub294 \ub370 \ub2c8\ud2b8\ub85c\ub97c \ubcf4\uc874\ud558\uc5ec \uc6b0\uc704\ub97c \uc810\ud558\uc2ed\uc2dc\uc624. \ub2c8\ud2b8\ub85c\ub97c \ubd88\ud544\uc694\ud558\uac8c \uc0ac\uc6a9\ud558\uc9c0 \uc54a\uace0, \ud2b9\ud788 \uc911\ub825\uc774 \uc774\ubbf8 \uac00\uc18d\ub3c4\ub97c \uc81c\uacf5\ud558\ub294 \ub0b4\ub9ac\ub9c9 \uae38\uc5d0\uc11c\ub294 \uc0ac\uc6a9\ud558\uc9c0 \uc54a\ub3c4\ub85d \ud558\uc5ec \ub2c8\ud2b8\ub85c\ub97c \uc808\uc57d\ud558\uc2ed\uc2dc\uc624. \uacbd\uc8fc \uc911\uc5d0 \ub2c8\ud2b8\ub85c \ud53d\uc5c5\uc744 \uc218\uc9d1\ud558\uba74 \ud0f1\ud06c\uac00 \ucc44\uc6cc\uc9d1\ub2c8\ub2e4. \uac8c\uc784 \ud50c\ub808\uc774 \uc0c1\ud669\uc758 \ud750\ub984\uc744 \ubcf4\uc5ec\uc8fc\ub294 \uc2dc\uac01\uc801 \ud45c\ud604\uc73c\ub85c \uc5b4\ub5a4 \uc0c1\ud669\uc5d0\uc11c \ucc28\ub7c9 \uac00\uc18d\uc744 \ud574\uc57c \ud558\ub294\uc9c0 \ubcf4\uc5ec\uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \n [\ub2e4\uc591\ud55c \ub808\uc774\uc2f1 \uc2dc\ub098\ub9ac\uc624\uc5d0\uc11c \ub2c8\ud2b8\ub85c\ub97c \uc0ac\uc6a9\ud560\uc9c0 \uc5ec\ubd80\uc5d0 \ub300\ud55c \uc758\uc0ac \uacb0\uc815 \ud2b8\ub9ac\ub97c \ubcf4\uc5ec\uc8fc\ub294 \ud750\ub984\ub3c4]"}, {"question": "Car-Rush \uc2dc\uc2a4\ud15c \ubd84\uc11d: \uac8c\uc784\uc740 \ub4dc\ub9ac\ud504\ud2b8 \uc810\uc218\ub97c \uc5b4\ub5bb\uac8c \uacc4\uc0b0\ud558\uba70, \ub4dc\ub9ac\ud504\ud2b8 \ucc4c\ub9b0\uc9c0\uc5d0\uc11c \uc810\uc218\ub97c \uadf9\ub300\ud654\ud558\ub294 \uae30\uc220\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c? \ub2e8\uc21c \ub4dc\ub9ac\ud504\ud2b8\uc5d0\uc11c \ub4dc\ub9ac\ud504\ud2b8 \uccb4\uc778\uae4c\uc9c0 \uc810\uc218 \ubc30\uc218\ub97c \ube44\uad50\ud558\uc2ed\uc2dc\uc624.", "answer": "\ub4dc\ub9ac\ud504\ud2b8 \uc810\uc218\ub294 \ub4dc\ub9ac\ud504\ud2b8 \uac01\ub3c4, \uc18d\ub3c4 \ubc0f \uc9c0\uc18d \uc2dc\uac04\uc744 \uae30\ubc18\uc73c\ub85c \uacc4\uc0b0\ub429\ub2c8\ub2e4. \ub4dc\ub9ac\ud504\ud2b8\uac00 \uae38\uace0 \ub113\uc744\uc218\ub85d \uc810\uc218\uac00 \ub192\uc2b5\ub2c8\ub2e4. \ub4dc\ub9ac\ud504\ud2b8\ub97c \uc774\uc5b4\uc11c \uace7\uac8c \ud3b4\uc9c0\uc9c0 \uc54a\uc73c\uba74 \uc810\uc218 \ubc30\uc218\uac00 \ud06c\uac8c \uc99d\uac00\ud569\ub2c8\ub2e4. \uc810\uc218\ub97c \ucd5c\ub300\ud654\ud558\ub824\uba74 \ub4dc\ub9ac\ud504\ud2b8\ub97c \uc870\uae30\uc5d0 \uc2dc\uc791\ud558\uace0 \ucf54\ub108\ub97c \uc9c0\ub098\ub3c4\ub85d \uc77c\uad00\ub41c \uac01\ub3c4\ub97c \uc720\uc9c0\ud558\uc2ed\uc2dc\uc624. \uc2a4\ud540\uc544\uc6c3\uc744 \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \uac00\uc18d \ud398\ub2ec\uacfc \uc870\ud5a5 \uc870\uc815\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. '\ub3c4\uc2ec \uace8\ubaa9\uae38'\uacfc \uac19\uc740 \ub4dc\ub9ac\ud504\ud2b8 \ucc4c\ub9b0\uc9c0\uc5d0\uc11c\ub294 \uac00\ub2a5\ud55c \ud55c \ucf54\ub108 \uc8fc\ubcc0\uc5d0\uc11c \uae38\uace0 \uc5f0\uc18d\uc801\uc778 \ub4dc\ub9ac\ud504\ud2b8\ub97c \ucde8\ud558\uace0 \uc5f0\uacb0\ud558\uc2ed\uc2dc\uc624. \ub2e8\uc77c \ub4dc\ub9ac\ud504\ud2b8\uc640 \uccb4\uc778 \ub4dc\ub9ac\ud504\ud2b8\uc758 \uc810\uc218\ub97c \ube44\uad50\ud558\ub294 \ud45c\uac00 \ub4dc\ub9ac\ud504\ud2b8 \uae30\uc220\ubcc4 \uc810\uc218 \uc99d\uac00\ub97c \uba85\ud655\ud558\uac8c \ubcf4\uc5ec\uc90d\ub2c8\ub2e4. \n [\ub2e8\uc77c \ub4dc\ub9ac\ud504\ud2b8 \ub300 \uccb4\uc778 \ub4dc\ub9ac\ud504\ud2b8\uc758 \ud3c9\uade0 \uc810\uc218\ub97c \ube44\uad50\ud558\ub294 \ud45c]. \ub192\uc740 \uc810\uc218\ub97c \uc5bb\uc73c\ub824\uba74 \ub4dc\ub9ac\ud504\ud2b8 \uccb4\uc778\uc744 \ud558\ub294 \ub3d9\uc548 \uace0\uc18d\uc744 \uc720\uc9c0\ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4."}, {"question": "Car-Rush \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc: Car-Rush\ub294 \uc5ec\ub7ec \ud50c\ub7ab\ud3fc\uc5d0\uc11c \uc0ac\uc6a9 \uac00\ub2a5\ud569\ub2c8\uae4c? PC, \ucf58\uc194 \ubc0f \ubaa8\ubc14\uc77c \uac04 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774 \ub610\ub294 \uc800\uc7a5 \ub370\uc774\ud130 \ub3d9\uae30\ud654\ub97c \uc9c0\uc6d0\ud569\ub2c8\uae4c?", "answer": "\ud604\uc7ac Car-Rush\ub294 \ubaa8\ubc14\uc77c \ud50c\ub7ab\ud3fc(iOS \ubc0f Android)\uacfc PC(Steam)\uc5d0\uc11c \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc548\ud0c0\uae5d\uac8c\ub3c4 \ud604\uc7ac \uac8c\uc784\uc740 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774\ub97c \uc9c0\uc6d0\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774\ub294 \uc9c0\uc6d0\ub418\uc9c0 \uc54a\uc9c0\ub9cc \ud604\uc7ac \ubaa8\ubc14\uc77c \uae30\uae30 \uac04 \ud06c\ub85c\uc2a4 \uc800\uc7a5/\ub3d9\uae30\ud654 \uae30\ub2a5\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub97c \ud1b5\ud574 \uc6d0\ud65c\ud558\uac8c \uc804\ud658\ud558\uace0 \ud1b5\uacc4\ub97c \uc720\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Car-Rush \uacbd\uc81c \uc124\uba85: Car-Rush\uc5d0\ub294 \uc5b4\ub5a4 \uc885\ub958\uc758 \ud1b5\ud654\uac00 \uc788\uc73c\uba70, \ubcf4\uc0c1\uc744 \ucd5c\uc801\ud654\ud558\uace0 \ucc28\ub7c9 \uc5c5\uadf8\ub808\uc774\ub4dc \ubc0f \ucc28\ub7c9 \uad6c\ub9e4\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Car-Rush\ub294 \uc77c\ubc18\uc801\uc73c\ub85c \uacbd\uc8fc \ubc0f \ucc4c\ub9b0\uc9c0 \uc644\ub8cc\ub85c \uc5bb\ub294 \ud604\uae08\uacfc \ub9c8\uc774\ud06c\ub85c \uac70\ub798 \ub610\ub294 \ud2b9\ubcc4 \uc774\ubca4\ud2b8\ub97c \ud1b5\ud574 \uc5bb\ub294 \uace8\ub4dc(\ub610\ub294 \ub3d9\ub4f1\ud55c \ud504\ub9ac\ubbf8\uc5c4 \ud1b5\ud654)\uc640 \uac19\uc740 \ub450 \uac00\uc9c0 \uc885\ub958\uc758 \uac8c\uc784 \ub0b4 \ud1b5\ud654\ub97c \ud2b9\uc9d5\uc73c\ub85c \ud569\ub2c8\ub2e4. \ud604\uae08\uc740 \uc8fc\ub85c \ucc28\ub7c9 \uc5c5\uadf8\ub808\uc774\ub4dc \ubc0f \ud558\uc704 \ucc28\ub7c9 \uad6c\ub9e4\uc5d0 \uc0ac\uc6a9\ub418\uace0, \uace8\ub4dc\ub294 \ud504\ub9ac\ubbf8\uc5c4 \ucc28\ub7c9\uacfc \ub3c5\uc810 \uac1c\uc870 \uc544\uc774\ud15c\uc744 \ud574\uc81c\ud569\ub2c8\ub2e4. \ubcf4\uc0c1\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \ub9e4\uc77c \ucc4c\ub9b0\uc9c0\ub97c \uc218\ud589\ud558\uace0 \uacbd\ub825 \ubaa8\ub4dc \ub808\ubca8\uc744 \ud1b5\ud574 \ud604\uae08\uc744 \ud68d\ub4dd\ud558\uc2ed\uc2dc\uc624. \ucda9\ub3d9\uc801\uc778 \uad6c\ub9e4\ub97c \ud53c\ud558\uace0 \ud544\uc218 \uc131\ub2a5 \ubd80\ud488 \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0 \uc6b0\uc120\uc21c\uc704\ub97c \ub450\uc2ed\uc2dc\uc624. \uc0c8 \ucc28\ub97c \uad6c\ub9e4\ud558\ub824\uba74 \uc0c1\ud0dc\ub97c \uc870\uc0ac\ud558\uace0 \uc774\uc804 \uc790\uc0b0\uacfc \ube44\uad50\ud558\uc2ed\uc2dc\uc624. \uc6b0\uc120\uc21c\uc704 \uc124\uc815\uc774 \uc911\uc694\ud569\ub2c8\ub2e4. \ub2e4\uc74c \uc0c1\ud669\uc744 \uace0\ub824\ud558\uc2ed\uc2dc\uc624. \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0 \uace8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uac70\ub098 \uace8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc989\uc2dc \uc0c8 \ucc28\ub97c \uad6c\ub9e4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Car-Rush \uc228\uaca8\uc9c4 \ub0b4\uc6a9: Car-Rush\uc5d0 \uc228\uaca8\uc9c4 \ucc28\ub7c9\uc774\ub098 \ube44\ubc00 \ud2b8\ub799\uc774 \uc788\uc2b5\ub2c8\uae4c? \uadf8\ub807\ub2e4\uba74 \uc774\ub4e4\uc744 \uc5b4\ub5bb\uac8c \ud574\uc81c\ud558\uba70, \uc774\uc2a4\ud130 \uc5d0\uadf8\uc640 \uc228\uaca8\uc9c4 \ucc28\ub7c9\uc758 \ucf54\ub4dc\uba85\uc5d0 \uc911\uc810\uc744 \ub450\uc2ed\uc2dc\uc624?", "answer": "\ub124, Car-Rush\uc5d0\ub294 \ud2b9\ubcc4\ud55c \uc131\ucde8\ub97c \ub2ec\uc131\ud558\uac70\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ucc3e\uc74c\uc73c\ub85c\uc368 \ud574\uc81c\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ucc28\ub7c9\uacfc \ud2b8\ub799\uc774 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub098\uc774\ud2b8\ub77c\uc774\ub354' \ucc28\ub7c9(\ucf54\ub4dc\uba85 '\ud504\ub85c\uc81d\ud2b8 X')\uc740 \ubaa8\ub4e0 \uc2dc\uac04 \uacbd\uc7c1 \ucc4c\ub9b0\uc9c0\ub97c \uae08\uba54\ub2ec\ub85c \uc644\ub8cc\ud568\uc73c\ub85c\uc368 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\ub978 \ube44\ubc00\uc778 '\uc78a\ud600\uc9c4 \uacf5\uc7a5' \ud2b8\ub799\uc740 '\uc0b0\uc5c5 \ud56d\uad6c' \ub808\ubca8\uc758 \uc228\uaca8\uc9c4 \ubcbd\ud654\ub97c \ucc3e\uc74c\uc73c\ub85c\uc368 \ud574\uc81c\ub429\ub2c8\ub2e4. \uac01 \ud2b8\ub799\uc758 \ubaa8\ub4e0 \uad6c\uc11d\uad6c\uc11d\uc744 \uac80\uc0c9\ud558\uace0, \uac1c\ubc1c\uc790 \uba54\uc2dc\uc9c0\ub098 \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ube44\ubc00\uc744 \uc554\uc2dc\ud560 \uc218 \uc788\ub294 \uae30\ud638\uc5d0 \uc8fc\uc758\ud558\uc2ed\uc2dc\uc624. \ube44\ubc00 \uc704\uce58\ub97c \ucc3e\ub294 \uc720\uc6a9\ud55c \ube44\uc720\ub294 \ub3c4\uc2dc\uc758 \uc2e4\uc81c \uc2a4\uce90\ube48\uc800 \ud5cc\ud2b8\uc785\ub2c8\ub2e4."}, {"question": "Car-Rush\ub294 \uc9c0\uc18d\uc801\uc73c\ub85c \uc5c5\ub370\uc774\ud2b8\ub418\uace0 \uc788\uc73c\ubbc0\ub85c Car-Rush\uc758 \uc5d4\uc9c4\uacfc \uc6a9\ub7c9\uc5d0 \ub300\ud574 \uc124\uba85\ud574\uc8fc\uc2ed\uc2dc\uc624. \uc5ec\ub7ec \uc694\uc18c\ub97c \uc5b4\ub5bb\uac8c \uacc4\uc0b0\ud569\ub2c8\uae4c? \uc774 \uc5d4\uc9c4\uc744 \uc27d\uac8c \uc774\ud574\ud560 \uc218 \uc788\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Car-Rush\uc758 \uac8c\uc784 \uc5d4\uc9c4 \uc18c\uc2a4 \ucf54\ub4dc\uc5d0 \uc9c1\uc811\uc801\uc73c\ub85c \uc811\uadfc\ud560 \uc218 \uc5c6\uae30 \ub54c\ubb38\uc5d0 \ud655\uc2e4\ud55c \uc774\ud574\ub294 \uac70\uc758 \ubd88\uac00\ub2a5\ud569\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \uac8c\uc784 \ud589\ub3d9\uc5d0 \ub300\ud574 \uac00\uc815\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. Car-Rush\ub294 \uadf8\ub798\ud53d \ubc0f \ub80c\ub354\ub9c1 \uacc4\uc0b0 \ubc0f \ucd5c\uc801\ud654\uc5d0 Unreal Engine 5\ub97c, \ubb3c\ub9ac \uacc4\uc0b0\uc5d0 PhysX\ub97c \uc0ac\uc6a9\ud558\ub294 \uac83\uc73c\ub85c \uc54c\ub824\uc838 \uc788\uc2b5\ub2c8\ub2e4. \uc5d4\uc9c4\uc744 \ub354 \uc798 \uc774\ud574\ud558\ub294 \ud750\ub984\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. STEP1: \uac8c\uc784 \ud50c\ub808\uc774 \uc911 \uc18d\ub3c4, \ub4dc\ub9ac\ud504\ud2b8 \uac01\ub3c4 \ubc0f \uc9c0\ud615\uacfc \uac19\uc740 \uc804\uc1a1 \ub370\uc774\ud130 \ubd84\uc11d. STEP2: \uc5c5\ub370\uc774\ud2b8/\uc124\uc815 \ubcc0\uacbd \ud6c4 \uc131\ub2a5 \ubca4\uce58\ub9c8\ud06c \uad00\ucc30 \ubc0f \uae30\ub85d. STEP3: \uac8c\uc784 \ud30c\uc77c\uc744 \ucd94\ucd9c\ud558\uc5ec \uac1c\ubc1c\uc790\uac00 \ucd94\uac00\ud55c \uc720\uc6a9\ud55c \uc815\ubcf4 \uc5bb\uae30 \uc2dc\ub3c4. \uc774\ub7ec\ud55c \uc694\uc18c\ub97c \uace0\ub824\ud558\uc5ec \uac8c\uc784 \uc560\ud638\uac00\ub4e4\uc774 \uc9c1\uc811\uc801\uc778 \uc18c\uc2a4\ub294 \uc544\ub2c8\uc9c0\ub9cc \ub354 \uc798 \uc774\ud574\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
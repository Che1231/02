[{"question": "\u5982\u4f55\u63a7\u5236\u868a\u5b50\u5728\u65b0\u624b\u7248\u7684\u300a\u868a\u5b50\u53ee\u54ac 3D\u300b\u904a\u6232\u4e2d\uff1f", "answer": "\u5728\u300a\u868a\u5b50\u53ee\u54ac 3D\u300b\u4e2d\uff0c\u63a7\u5236\u868a\u5b50\u9700\u8981\u4f7f\u7528\u64cd\u7e31\u687f\u79fb\u52d5\uff0c\u4e26\u4f7f\u7528\u52d5\u4f5c\u6309\u9215\u53ee\u54ac\u3002\u4f8b\u5982\uff0c\u8981\u53ee\u54ac\u4eba\u985e\uff0c\u8acb\u9760\u8fd1\u4ed6\u5011\uff0c\u4e26\u5728\u63d0\u793a\u51fa\u73fe\u6642\u6309\u4e0b\u52d5\u4f5c\u6309\u9215\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u5b83\u60f3\u50cf\u6210\u99d5\u99db\u4e00\u8f1b\u5c0f\u578b\u6c7d\u8eca\uff0c\u53ea\u6709\u4e00\u500b\u76ee\u7684\u2014\u2014\u53ee\u54ac\uff01]"}, {"question": "\u300a\u868a\u5b50\u53ee\u54ac 3D\u300b\u65b0\u73a9\u5bb6\u7684\u57fa\u672c\u76ee\u6a19\u662f\u4ec0\u9ebc\uff1f", "answer": "\u300a\u868a\u5b50\u53ee\u54ac 3D\u300b\u7684\u57fa\u672c\u76ee\u6a19\u5305\u62ec\u53ee\u54ac\u4eba\u985e\u4ee5\u7372\u5f97\u751f\u547d\u503c\u3001\u907f\u514d\u88ab\u62cd\u6253\u4ee5\u53ca\u5b8c\u6210\u95dc\u5361\uff0c\u9054\u5230\u7279\u5b9a\u7684\u53ee\u54ac\u76ee\u6a19\u3002\u4f8b\u5982\uff0c\u5728 1 \u95dc\u4e2d\uff0c\u4f60\u9700\u8981\u53ee\u54ac 5 \u500b\u4eba\u985e\u624d\u80fd\u524d\u9032\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u76ee\u6a19 | \u76ee\u6a19\u503c | \u4f8b\u9805]"}, {"question": "\u70ba\u4ec0\u9ebc\u868a\u5b50\u7684\u751f\u547d\u503c\u6703\u5728\u300a\u868a\u5b50\u53ee\u54ac 3D\u300b\u4e2d\u4e0b\u964d\uff0c\u4ee5\u53ca\u5982\u4f55\u88dc\u5145\u751f\u547d\u503c\uff1f", "answer": "\u868a\u5b50\u7684\u751f\u547d\u503c\u6703\u56e0\u62cd\u6253\u5617\u8a66\u548c\u74b0\u5883\u5371\u5bb3\u800c\u4e0b\u964d\u3002\u8981\u88dc\u5145\u751f\u547d\u503c\uff0c\u8acb\u53ee\u54ac\u4eba\u985e\uff1b\u6bcf\u6b21\u6210\u529f\u53ee\u54ac\u90fd\u6703\u6062\u5fa9\u4e00\u90e8\u5206\u751f\u547d\u503c\u3002\u4f8b\u5982\uff0c\u5728 2 \u95dc\u4e2d\u53ee\u54ac\u4e00\u500b\u4eba\u985e\u6703\u6062\u5fa9 20% \u7684\u751f\u547d\u503c\u3002[\u591a\u65b9\u6848\u6bd4\u8f03: \u53ee\u54ac\u8207\u907f\u958b\u5371\u96aa]"}, {"question": "\u5982\u4f55\u512a\u5316\u868a\u5b50\u5728\u300a\u868a\u5b50\u53ee\u54ac 3D\u300b\u904a\u6232\u4e2d\u7684\u79fb\u52d5\u901f\u5ea6\uff0c\u4ee5\u63d0\u5347\u9ad8\u968e\u73a9\u5bb6\u9ad4\u9a57\uff1f", "answer": "\u8981\u512a\u5316\u79fb\u52d5\u901f\u5ea6\uff0c\u8acb\u4f7f\u7528\u96d9\u64ca\u64cd\u7e31\u687f\u4f86\u57f7\u884c\u885d\u523a\u529f\u80fd\u3002\u9019\u80fd\u8b93\u868a\u5b50\u66f4\u5feb\u5730\u9003\u812b\u4e26\u9032\u884c\u6230\u7565\u90e8\u7f72\u3002\u4f8b\u5982\uff0c\u5728 5 \u95dc\u4e2d\uff0c\u885d\u523a\u6709\u52a9\u65bc\u8eb2\u907f\u591a\u6b21\u62cd\u6253\u5617\u8a66\u3002[\u6d41\u7a0b\u5716\u89e3: \u79fb\u52d5 -> \u885d\u523a -> \u8eb2\u907f]"}, {"question": "\u5728\u300a\u868a\u5b50\u53ee\u54ac 3D\u300b\u4e2d\uff0c\u6709\u54ea\u4e9b\u7b56\u7565\u53ef\u4ee5\u907f\u514d\u88ab\u62cd\u6253\uff1f", "answer": "\u7b56\u7565\u5305\u62ec\u5f85\u5728\u4eba\u985e\u8eab\u5f8c\u3001\u5229\u7528\u74b0\u5883\u63a9\u8b77\u4ee5\u53ca\u5728\u4eba\u985e\u9592\u6687\u6642\u9593\u9032\u884c\u53ee\u54ac\u3002\u4f8b\u5982\uff0c\u5728 3 \u95dc\u4e2d\uff0c\u8eb2\u5728\u50a2\u4ff1\u4e0b\u53ef\u4ee5\u907f\u514d\u88ab\u767c\u73fe\u3002[\u591a\u65b9\u6848\u6bd4\u8f03: \u63a9\u8b77 vs. \u6642\u9593\u63a7\u5236]"}, {"question": "\u5728\u300a\u868a\u5b50\u53ee\u54ac 3D\u300b\u4e2d\uff0c\u54ea\u4e9b\u80fd\u529b\u61c9\u8a72\u512a\u5148\u5347\u7d1a\uff1f", "answer": "\u512a\u5148\u5347\u7d1a\u53ee\u54ac\u5f37\u5ea6\u548c\u751f\u547d\u503c\u6062\u5fa9\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u5728 4 \u95dc\u4e2d\u5347\u7d1a\u53ee\u54ac\u5f37\u5ea6\uff0c\u53ef\u4ee5\u66f4\u5feb\u5730\u6062\u5fa9\u751f\u547d\u503c\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u80fd\u529b | \u5347\u7d1a\u6210\u672c | \u597d\u8655]"}, {"question": "\u300a\u868a\u5b50\u53ee\u54ac 3D\u300b\u4e2d\u7684\u751f\u547d\u503c\u6062\u5fa9\u6a5f\u5236\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u751f\u547d\u503c\u6062\u5fa9\u662f\u7531\u6210\u529f\u53ee\u54ac\u89f8\u767c\u7684\u3002\u6bcf\u6b21\u53ee\u54ac\u90fd\u6703\u6062\u5fa9\u56fa\u5b9a\u767e\u5206\u6bd4\u7684\u751f\u547d\u503c\uff0c\u5347\u7d1a\u5c07\u63d0\u5347\u6062\u5fa9\u91cf\u3002\u4f8b\u5982\uff0c3 \u95dc\u5347\u7d1a\u53ef\u5c07\u6062\u5fa9\u91cf\u63d0\u9ad8 10%\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u5b83\u60f3\u50cf\u6210\u6bcf\u6b21\u53ee\u54ac\u90fd\u80fd\u7372\u5f97\u4e00\u5c0f\u74f6\u751f\u547d\u85e5\u6c34\u3002]"}, {"question": "\u74b0\u5883\u5371\u5bb3\u5728\u300a\u868a\u5b50\u53ee\u54ac 3D\u300b\u904a\u6232\u4e2d\u5c0d\u904a\u6232\u9ad4\u9a57\u6709\u4ec0\u9ebc\u5f71\u97ff\uff1f", "answer": "\u50cf\u662f\u6bba\u87f2\u5291\u548c\u98a8\u6247\u7b49\u74b0\u5883\u5371\u5bb3\u6703\u964d\u4f4e\u751f\u547d\u503c\uff0c\u4e26\u9650\u5236\u79fb\u52d5\u3002\u4f8b\u5982\uff0c\u5728 6 \u95dc\u7684\u6bba\u87f2\u5291\u6703\u88fd\u9020\u51fa\u5feb\u901f\u6d88\u8017\u751f\u547d\u503c\u7684\u5340\u57df\u3002[\u591a\u65b9\u6848\u6bd4\u8f03: \u5371\u5bb3 vs. \u5b89\u5168\u5340\u57df]"}, {"question": "\u5982\u4f55\u5728\u300a\u868a\u5b50\u53ee\u54ac 3D\u300b\u4e2d\u5c07\u904a\u6232\u9032\u5ea6\u5f9e\u4e00\u500b\u5e73\u53f0\u9077\u79fb\u5230\u53e6\u4e00\u500b\u5e73\u53f0\uff1f", "answer": "\u8981\u9077\u79fb\u9032\u5ea6\uff0c\u8acb\u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u3002\u5728\u65b0\u5e73\u53f0\u4e0a\u4f7f\u7528\u76f8\u540c\u7684\u5e33\u6236\u767b\u5165\u5373\u53ef\u540c\u6b65\u8cc7\u6599\u3002\u4f8b\u5982\uff0c\u5f9e iOS \u8f49\u79fb\u5230 Android \u9700\u8981\u4f7f\u7528\u76f8\u540c\u7684\u5e33\u865f\u5bc6\u78bc\u767b\u5165\u3002[\u6d41\u7a0b\u5716\u89e3: \u820a\u5e73\u53f0 -> \u96f2\u7aef\u5132\u5b58 -> \u65b0\u5e73\u53f0]"}, {"question": "\u5728\u300a\u868a\u5b50\u53ee\u54ac 3D\u300b\u4e2d\uff0c\u6210\u5c31\u7375\u4eba\u53ef\u4ee5\u627e\u5230\u54ea\u4e9b\u96b1\u85cf\u5167\u5bb9\uff1f", "answer": "\u96b1\u85cf\u5167\u5bb9\u5305\u62ec\u79d8\u5bc6\u95dc\u5361\u548c\u7a00\u6709\u6210\u5c31\u3002\u4f8b\u5982\uff0c\u5728 7 \u95dc\u627e\u5230\u6240\u6709\u96b1\u85cf\u7684\u5de2\u7a74\uff0c\u5c07\u89e3\u9396\u79d8\u5bc6\u95dc\u5361\u3002[\u5f69\u86cb\u6316\u6398: \u79d8\u5bc6\u95dc\u5361 | \u89e3\u9396\u689d\u4ef6]"}]
[{"question": "\u5982\u4f55\u63a7\u5236\u868a\u5b50\u5728\u868a\u5b50\u53ee\u54ac3D\u6e38\u620f\u4e2d\uff08\u521d\u5b66\u8005\uff09\uff1f", "answer": "\u5728\u868a\u5b50\u53ee\u54ac3D\u6e38\u620f\u4e2d\uff0c\u63a7\u5236\u868a\u5b50\u9700\u8981\u4f7f\u7528\u64cd\u7eb5\u6746\u79fb\u52a8\uff0c\u5e76\u4f7f\u7528\u52a8\u4f5c\u6309\u94ae\u53ee\u54ac\u3002\u4f8b\u5982\uff0c\u4e3a\u4e86\u53ee\u54ac\u4eba\u7c7b\uff0c\u9760\u8fd1\u4ed6\u4eec\uff0c\u5e76\u5728\u63d0\u793a\u51fa\u73b0\u65f6\u6309\u4e0b\u52a8\u4f5c\u6309\u94ae\u3002[\u6bd4\u55bb\u8bf4\u660e: \u60f3\u8c61\u4e00\u4e0b\uff0c\u4f60\u9a7e\u9a76\u7740\u4e00\u8f86\u5fae\u578b\u6c7d\u8f66\uff0c\u53ea\u6709\u4e00\u4e2a\u76ee\u7684\u2014\u2014\u53ee\u54ac\uff01]"}, {"question": "\u868a\u5b50\u53ee\u54ac3D\u6e38\u620f\u4e2d\u65b0\u73a9\u5bb6\u7684\u57fa\u672c\u76ee\u6807\u662f\u4ec0\u4e48\uff1f", "answer": "\u868a\u5b50\u53ee\u54ac3D\u6e38\u620f\u4e2d\uff0c\u65b0\u73a9\u5bb6\u7684\u57fa\u672c\u76ee\u6807\u5305\u62ec\u53ee\u54ac\u4eba\u7c7b\u4ee5\u83b7\u5f97\u751f\u547d\u503c\uff0c\u907f\u514d\u88ab\u62cd\u6253\uff0c\u5e76\u901a\u8fc7\u5b8c\u6210\u7279\u5b9a\u53ee\u54ac\u76ee\u6807\u6765\u5b8c\u6210\u5173\u5361\u3002\u4f8b\u5982\uff0c\u5728\u7b2c1\u5173\uff0c\u4f60\u9700\u8981\u53ee\u54ac5\u4e2a\u4eba\u624d\u80fd\u7ee7\u7eed\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u76ee\u6807 | \u76ee\u6807 | \u4f8b\u5b50]"}, {"question": "\u868a\u5b50\u53ee\u54ac3D\u6e38\u620f\u4e2d\u868a\u5b50\u7684\u751f\u547d\u503c\u4e3a\u4ec0\u4e48\u4f1a\u51cf\u5c11\uff0c\u4ee5\u53ca\u5982\u4f55\u8865\u5145\uff1f", "answer": "\u868a\u5b50\u7684\u751f\u547d\u503c\u4f1a\u56e0\u62cd\u6253\u5c1d\u8bd5\u548c\u73af\u5883\u5371\u5bb3\u800c\u51cf\u5c11\u3002\u8981\u8865\u5145\u751f\u547d\u503c\uff0c\u9700\u8981\u53ee\u54ac\u4eba\u7c7b\uff1b\u6bcf\u6b21\u6210\u529f\u53ee\u54ac\u90fd\u4f1a\u6062\u590d\u4e00\u90e8\u5206\u751f\u547d\u503c\u3002\u4f8b\u5982\uff0c\u5728\u7b2c2\u5173\u53ee\u54ac\u4e00\u4e2a\u4eba\u53ef\u4ee5\u6062\u590d20%\u7684\u751f\u547d\u503c\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u53ee\u54ac\u4e0e\u907f\u514d\u5371\u5bb3]"}, {"question": "\u5982\u4f55\u4f18\u5316\u868a\u5b50\u53ee\u54ac3D\u6e38\u620f\u4e2d\u9ad8\u7ea7\u73a9\u5bb6\u7684\u79fb\u52a8\u901f\u5ea6\uff1f", "answer": "\u4e3a\u4e86\u4f18\u5316\u79fb\u52a8\u901f\u5ea6\uff0c\u8bf7\u53cc\u51fb\u64cd\u7eb5\u6746\u4f7f\u7528\u51b2\u523a\u529f\u80fd\u3002\u8fd9\u53ef\u4ee5\u8ba9\u868a\u5b50\u66f4\u5feb\u5730\u9003\u8131\u548c\u8fdb\u884c\u6218\u7565\u6027\u5b9a\u4f4d\u3002\u4f8b\u5982\uff0c\u5728\u7b2c5\u5173\uff0c\u51b2\u523a\u6709\u52a9\u4e8e\u8eb2\u907f\u591a\u6b21\u62cd\u6253\u5c1d\u8bd5\u3002[\u6d41\u7a0b\u56fe\u89e3: \u79fb\u52a8 -> \u51b2\u523a -> \u8eb2\u907f]"}, {"question": "\u5728\u868a\u5b50\u53ee\u54ac3D\u6e38\u620f\u4e2d\uff0c\u6709\u54ea\u4e9b\u7b56\u7565\u53ef\u4ee5\u907f\u514d\u88ab\u62cd\u6253\uff1f", "answer": "\u7b56\u7565\u5305\u62ec\u5f85\u5728\u4eba\u7c7b\u8eab\u540e\uff0c\u5229\u7528\u73af\u5883\u63a9\u62a4\uff0c\u5e76\u5728\u4ed6\u4eec\u95f2\u6687\u65f6\u628a\u63e1\u53ee\u54ac\u65f6\u673a\u3002\u4f8b\u5982\uff0c\u5728\u7b2c3\u5173\uff0c\u8eb2\u5728\u5bb6\u5177\u4e0b\u53ef\u4ee5\u907f\u514d\u88ab\u53d1\u73b0\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u63a9\u62a4\u4e0e\u65f6\u673a]"}, {"question": "\u5728\u868a\u5b50\u53ee\u54ac3D\u6e38\u620f\u4e2d\uff0c\u5e94\u8be5\u4f18\u5148\u5347\u7ea7\u54ea\u4e9b\u80fd\u529b\uff1f", "answer": "\u4f18\u5148\u5347\u7ea7\u54ac\u5408\u529b\u4e0e\u751f\u547d\u503c\u6062\u590d\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u5728\u7b2c4\u5173\u5347\u7ea7\u54ac\u5408\u529b\u53ef\u4ee5\u66f4\u5feb\u5730\u6062\u590d\u751f\u547d\u503c\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u80fd\u529b | \u5347\u7ea7\u6210\u672c | \u6548\u76ca]"}, {"question": "\u868a\u5b50\u53ee\u54ac3D\u6e38\u620f\u4e2d\u751f\u547d\u503c\u6062\u590d\u673a\u5236\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u751f\u547d\u503c\u6062\u590d\u7531\u6210\u529f\u53ee\u54ac\u89e6\u53d1\u3002\u6bcf\u6b21\u53ee\u54ac\u90fd\u4f1a\u6062\u590d\u56fa\u5b9a\u767e\u5206\u6bd4\u7684\u751f\u547d\u503c\uff0c\u5347\u7ea7\u4f1a\u589e\u5f3a\u6062\u590d\u91cf\u3002\u4f8b\u5982\uff0c\u5728\u7b2c3\u5173\u5347\u7ea7\u540e\uff0c\u6062\u590d\u91cf\u589e\u52a010%\u3002[\u6bd4\u55bb\u8bf4\u660e: \u60f3\u8c61\u4e00\u4e0b\uff0c\u6bcf\u6b21\u53ee\u54ac\u5c31\u50cf\u83b7\u5f97\u4e00\u4e2a\u5c0f\u5c0f\u7684\u751f\u547d\u836f\u5242\u3002]"}, {"question": "\u868a\u5b50\u53ee\u54ac3D\u6e38\u620f\u4e2d\u73af\u5883\u5371\u5bb3\u5bf9\u6e38\u620f\u4f53\u9a8c\u6709\u4ec0\u4e48\u5f71\u54cd\uff1f", "answer": "\u73af\u5883\u5371\u5bb3\uff0c\u5982\u6740\u866b\u5242\u548c\u98ce\u6247\uff0c\u4f1a\u964d\u4f4e\u751f\u547d\u503c\u5e76\u9650\u5236\u79fb\u52a8\u3002\u4f8b\u5982\uff0c\u5728\u7b2c6\u5173\u7684\u6740\u866b\u5242\u4f1a\u521b\u5efa\u6301\u7eed\u6d88\u8017\u751f\u547d\u503c\u7684\u533a\u57df\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u5371\u5bb3\u4e0e\u5b89\u5168\u533a\u57df]"}, {"question": "\u5982\u4f55\u5728\u868a\u5b50\u53ee\u54ac3D\u6e38\u620f\u4e2d\u5c06\u6e38\u620f\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u5e73\u53f0\u8fc1\u79fb\u5230\u53e6\u4e00\u4e2a\u5e73\u53f0\uff1f", "answer": "\u8981\u8fc1\u79fb\u8fdb\u5ea6\uff0c\u8bf7\u4f7f\u7528\u4e91\u4fdd\u5b58\u529f\u80fd\u3002\u5728\u65b0\u5e73\u53f0\u4e0a\u4f7f\u7528\u76f8\u540c\u7684\u5e10\u6237\u767b\u5f55\u4ee5\u540c\u6b65\u6570\u636e\u3002\u4f8b\u5982\uff0c\u4eceiOS\u8fc1\u79fb\u5230Android\u9700\u8981\u4f7f\u7528\u76f8\u540c\u7684\u51ed\u636e\u767b\u5f55\u3002[\u6d41\u7a0b\u56fe\u89e3: \u65e7\u5e73\u53f0 -> \u4e91\u4fdd\u5b58 -> \u65b0\u5e73\u53f0]"}, {"question": "\u5728\u868a\u5b50\u53ee\u54ac3D\u6e38\u620f\u4e2d\uff0c\u6210\u5c31\u730e\u4eba\u53ef\u4ee5\u627e\u5230\u54ea\u4e9b\u9690\u85cf\u5185\u5bb9\uff1f", "answer": "\u9690\u85cf\u5185\u5bb9\u5305\u62ec\u79d8\u5bc6\u5173\u5361\u548c\u7a00\u6709\u6210\u5c31\u3002\u4f8b\u5982\uff0c\u5728\u7b2c7\u5173\u627e\u5230\u6240\u6709\u9690\u85cf\u7684\u5de2\u7a74\u53ef\u4ee5\u89e3\u9501\u4e00\u4e2a\u79d8\u5bc6\u5173\u5361\u3002[\u5f69\u86cb\u6316\u6398: \u79d8\u5bc6\u5173\u5361 | \u89e3\u9501\u6761\u4ef6]"}]
[{"question": "\ucd08\ubcf4\uc790\ub97c \uc704\ud55c \ubaa8\uae30 \ubb3c\ub9bc 3D\uc5d0\uc11c \ubaa8\uae30\ub97c \uc5b4\ub5bb\uac8c \uc81c\uc5b4\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ubaa8\uae30 \ubb3c\ub9bc 3D\uc5d0\uc11c \ubaa8\uae30\ub97c \uc81c\uc5b4\ud558\ub824\uba74 \uc870\uc774\uc2a4\ud2f1\uc73c\ub85c \uc774\ub3d9\ud558\uace0 \ub3d9\uc791 \ubc84\ud2bc\uc73c\ub85c \ubb3c\ub9bd\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc0ac\ub78c\uc744 \ubb3c\ub824\uba74 \uc0ac\ub78c\uc5d0\uac8c \uc811\uadfc\ud558\uace0 \ud504\ub86c\ud504\ud2b8\uac00 \ub098\ud0c0\ub098\uba74 \ub3d9\uc791 \ubc84\ud2bc\uc744 \ub204\ub985\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc791\uc740 \uc790\ub3d9\ucc28\ub97c \uc6b4\uc804\ud558\ub294 \uac83\ucc98\ub7fc \uc0dd\uac01\ud558\uba74 \ub429\ub2c8\ub2e4. \ubaa9\uc801\uc740 \ub2e8 \ud558\ub098, \ubb3c\uae30!] "}, {"question": "\ubaa8\uae30 \ubb3c\ub9bc 3D\uc758 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \uae30\ubcf8 \ubaa9\ud45c\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ubaa8\uae30 \ubb3c\ub9bc 3D\uc758 \uae30\ubcf8 \ubaa9\ud45c\ub294 \uc0ac\ub78c\uc744 \ubb3c\uc5b4 \uac74\uac15\uc744 \uc5bb\uace0, \ucad3\uaca8\ub098\ub294 \uac83\uc744 \ud53c\ud558\uba70, \ud2b9\uc815 \ubb3c\uae30 \ubaa9\ud45c\ub97c \ub2ec\uc131\ud558\uc5ec \ub808\ubca8\uc744 \uc644\ub8cc\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 1\uc5d0\uc11c\ub294 \uc9c4\ud589\ud558\uae30 \uc704\ud574 5\uba85\uc758 \uc0ac\ub78c\uc744 \ubb3c\uc5b4\uc57c \ud569\ub2c8\ub2e4. [\uad6c\uc131 \ub300\uc870\ud45c: \ubaa9\ud45c | \ub300\uc0c1 | \uc608\uc2dc]"}, {"question": "\ubaa8\uae30 \ubb3c\ub9bc 3D\uc5d0\uc11c \ubaa8\uae30\uc758 \uccb4\ub825\uc774 \uac10\uc18c\ud558\ub294 \uc774\uc720\uc640 \uc5b4\ub5bb\uac8c \ud68c\ubcf5\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ubaa8\uae30\uc758 \uccb4\ub825\uc740 \ucad3\uae30 \uc2dc\ub3c4\uc640 \ud658\uacbd \uc704\ud5d8 \uc694\uc18c\ub85c \uc778\ud574 \uac10\uc18c\ud569\ub2c8\ub2e4. \uccb4\ub825\uc744 \ud68c\ubcf5\ud558\ub824\uba74 \uc0ac\ub78c\uc744 \ubb3c\uc5b4\uc57c \ud569\ub2c8\ub2e4. \uc131\uacf5\uc801\uc73c\ub85c \uc0ac\ub78c\uc744 \ubb3c \ub54c\ub9c8\ub2e4 \uccb4\ub825\uc758 \uc77c\ubd80\uac00 \ud68c\ubcf5\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 2\uc5d0\uc11c \uc0ac\ub78c\uc744 \ubb3c\uba74 20%\uc758 \uccb4\ub825\uc774 \ud68c\ubcf5\ub429\ub2c8\ub2e4. [\ub2e4\uc911 \ubc29\uc548 \ube44\uad50: \ubb3c\uae30 vs. \uc704\ud5d8 \uc694\uc18c \ud68c\ud53c]"}, {"question": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \ubaa8\uae30 \ubb3c\ub9bc 3D\uc5d0\uc11c \ubaa8\uae30\uc758 \uc774\ub3d9 \uc18d\ub3c4\ub97c \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc774\ub3d9 \uc18d\ub3c4\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc870\uc774\uc2a4\ud2f1\uc744 \ub450 \ubc88 \ud0ed\ud558\uc5ec \uc810\ud504 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc774\ub97c \ud1b5\ud574 \ub354 \ube60\ub978 \ub3c4\uc8fc\uc640 \uc804\ub7b5\uc801\uc778 \uc704\uce58 \uc120\uc815\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 5\uc5d0\uc11c \uc810\ud504\ub294 \uc5ec\ub7ec \ubc88\uc758 \ucad3\uae30 \uc2dc\ub3c4\ub97c \ud53c\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc774\ub3d9 -> \uc810\ud504 -> \ud68c\ud53c]"}, {"question": "\ubaa8\uae30 \ubb3c\ub9bc 3D\uc5d0\uc11c \ucad3\uaca8\ub098\ub294 \uac83\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc804\ub7b5\uc5d0\ub294 \uc0ac\ub78c \ub4a4\uc5d0 \uba38\ubb34\ub974\uae30, \ud658\uacbd\uc744 \uc774\uc6a9\ud558\uc5ec \uc228\uae30, \uc0ac\ub78c\uc774 \uac00\ub9cc\ud788 \uc788\uc744 \ub54c \ubb3c\uae30 \ud0c0\uc774\ubc0d\uc744 \ub9de\ucd94\ub294 \uac83\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 3\uc5d0\uc11c \uac00\uad6c \ubc11\uc5d0 \uc228\ub294 \uac83\uc740 \uac10\uc9c0\ub418\ub294 \uac83\uc744 \ub9c9\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc911 \ubc29\uc548 \ube44\uad50: \uc228\uae30 vs. \ud0c0\uc774\ubc0d \ub9de\ucd94\uae30]"}, {"question": "\ubaa8\uae30 \ubb3c\ub9bc 3D\uc5d0\uc11c \uc5c5\uadf8\ub808\uc774\ub4dc \uc6b0\uc120\uc21c\uc704\uac00 \uc788\ub294 \ub2a5\ub825\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ubb3c\uae30 \uac15\ub3c4\uc640 \uccb4\ub825 \uc7ac\uc0dd\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 4\uc5d0\uc11c \ubb3c\uae30 \uac15\ub3c4\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uba74 \uccb4\ub825\uc774 \ub354 \ube68\ub9ac \ud68c\ubcf5\ub429\ub2c8\ub2e4. [\uad6c\uc131 \ub300\uc870\ud45c: \ub2a5\ub825 | \uc5c5\uadf8\ub808\uc774\ub4dc \ube44\uc6a9 | \uc774\uc810]"}, {"question": "\ubaa8\uae30 \ubb3c\ub9bc 3D\uc5d0\uc11c \uccb4\ub825 \uc7ac\uc0dd \uba54\ucee4\ub2c8\uc998\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "\uccb4\ub825 \uc7ac\uc0dd\uc740 \uc131\uacf5\uc801\uc778 \ubb3c\uae30\ub85c \ud65c\uc131\ud654\ub429\ub2c8\ub2e4. \ub9e4\ubc88 \ubb3c \ub54c\ub9c8\ub2e4 \uace0\uc815\ub41c \ube44\uc728\uc758 \uccb4\ub825\uc774 \ud68c\ubcf5\ub418\uba70, \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \ud1b5\ud574 \ud68c\ubcf5\ub7c9\uc774 \ud5a5\uc0c1\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 3 \uc5c5\uadf8\ub808\uc774\ub4dc\ub85c \uc7ac\uc0dd\ub7c9\uc774 10% \uc99d\uac00\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ub9e4\ubc88 \ubb3c \ub54c\ub9c8\ub2e4 \uc791\uc740 \uccb4\ub825 \ud68c\ubcf5\uc81c\ucc98\ub7fc \uc0dd\uac01\ud558\uc138\uc694.]"}, {"question": "\ubaa8\uae30 \ubb3c\ub9bc 3D\uc5d0\uc11c \ud658\uacbd \uc704\ud5d8 \uc694\uc18c\ub294 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "\ubaa8\uae30\ud1f4\uce58\uc81c\uc640 \uc120\ud48d\uae30\uc640 \uac19\uc740 \ud658\uacbd \uc704\ud5d8 \uc694\uc18c\ub294 \uccb4\ub825\uc744 \uac10\uc18c\uc2dc\ud0a4\uace0 \uc774\ub3d9\uc5d0 \uc81c\ud55c\uc744 \uc90d\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 6\uc758 \ubaa8\uae30\ud1f4\uce58\uc81c\ub294 \uccb4\ub825\uc774 \ube60\ub974\uac8c \uc18c\ubaa8\ub418\ub294 \uc601\uc5ed\uc744 \ub9cc\ub4ed\ub2c8\ub2e4. [\ub2e4\uc911 \ubc29\uc548 \ube44\uad50: \uc704\ud5d8 \uc694\uc18c vs. \uc548\uc804 \uad6c\uc5ed]"}, {"question": "\ubaa8\uae30 \ubb3c\ub9bc 3D\uc5d0\uc11c \ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc73c\ub85c \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\ub824\uba74 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc0c8 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uc5ec \ub370\uc774\ud130\ub97c \ub3d9\uae30\ud654\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, iOS\uc5d0\uc11c Android\ub85c \uc774\ub3d9\ud558\ub824\uba74 \ub3d9\uc77c\ud55c \uc790\uaca9 \uc99d\uba85\uc73c\ub85c \ub85c\uadf8\uc778\ud574\uc57c \ud569\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc774\uc804 \ud50c\ub7ab\ud3fc -> \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 -> \uc0c8 \ud50c\ub7ab\ud3fc]"}, {"question": "\ubaa8\uae30 \ubb3c\ub9bc 3D\uc5d0\uc11c \uc131\ucde8\ub3c4 \uc0ac\ub0e5\uafbc\uc744 \uc704\ud55c \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc228\uaca8\uc9c4 \ucf58\ud150\uce20\uc5d0\ub294 \ube44\ubc00 \ub808\ubca8\uacfc \ud76c\uadc0\ud55c \uc131\ucde8\ub3c4\uac00 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub808\ubca8 7\uc758 \ubaa8\ub4e0 \uc228\uaca8\uc9c4 \ub465\uc9c0\ub97c \ucc3e\uc73c\uba74 \ube44\ubc00 \ub808\ubca8\uc774 \ud574\uc81c\ub429\ub2c8\ub2e4. [\ubcf4\ub108\uc2a4 \ucf58\ud150\uce20: \ube44\ubc00 \ub808\ubca8 | \ud574\uc81c \uc870\uac74]"}]
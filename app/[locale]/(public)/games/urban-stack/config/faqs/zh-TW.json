[{"question": "\u5982\u4f55\u5feb\u901f\u638c\u63e1Urban Stack\u4f5c\u70ba\u65b0\u73a9\u5bb6\u7684\u57fa\u672c\u63a7\u5236?", "answer": "\u8981\u5feb\u901f\u638c\u63e1Urban Stack\u7684\u57fa\u672c\u63a7\u5236\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u719f\u6089\u79fb\u52d5\u9375 (WASD) \u548c\u8df3\u8e8d\u9375 (\u7a7a\u683c\u9375)\u3002\u6b65\u9a5f2 - \u7df4\u7fd2\u4f7f\u7528\u4e92\u52d5\u9375 (E) \u958b\u9580\u548c\u62fe\u53d6\u7269\u54c1\u3002\u6b65\u9a5f3 - \u5617\u8a66\u4f7f\u7528\u6230\u9b25\u63a7\u5236 (\u5de6\u9375\u653b\u64ca\uff0c\u53f3\u9375\u683c\u64cb)\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u95dc\uff0c\u60a8\u53ef\u4ee5\u900f\u904e\u5728\u74b0\u5883\u4e2d\u79fb\u52d5\u548c\u8207 NPC \u4e92\u52d5\u4f86\u7df4\u7fd2\u9019\u4e9b\u63a7\u5236\u3002[\u6bd4\u55bb\u8aaa\u660e: \u60f3\u60f3\u63a7\u5236\u5c31\u50cf\u5b78\u7fd2\u958b\u8eca\uff1b\u4e00\u65e6\u4f60\u638c\u63e1\u4e86\u8a23\u7ac5\uff0c\u5b83\u5c31\u6703\u8b8a\u6210\u81ea\u7136\u800c\u7136\u7684\u4e8b\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u4e86\u89e3Urban Stack\u7684\u5de5\u85dd\u7cfb\u7d71\u5c0d\u65bc\u904a\u6232\u9032\u5ea6\u81f3\u95dc\u91cd\u8981?", "answer": "\u4e86\u89e3Urban Stack\u7684\u5de5\u85dd\u7cfb\u7d71\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u5141\u8a31\u60a8\u5275\u9020\u904a\u6232\u4e2d\u7121\u6cd5\u900f\u904e\u666e\u901a\u904a\u6232\u73a9\u6cd5\u7372\u5f97\u7684\u5fc5\u8981\u7269\u54c1\u548c\u5347\u7d1a\u3002\u4f8b\u5982\uff0c\u88fd\u4f5c\u5065\u5eb7\u85e5\u6c34\u53ef\u4ee5\u5728\u8207\u56f0\u96e3\u7684BOSS\u6230\u9b25\u6642\u62ef\u6551\u60a8\u3002\u8a72\u7cfb\u7d71\u900f\u904e\u7d50\u5408\u904a\u6232\u4e16\u754c\u5404\u5730\u767c\u73fe\u7684\u8cc7\u6e90\u8d77\u4f5c\u7528\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u4ee5\u4e0b\u662f\u5feb\u901f\u53c3\u8003\uff1a\u8cc7\u6e90A + \u8cc7\u6e90B = \u5065\u5eb7\u85e5\u6c34\uff0c\u8cc7\u6e90C + \u8cc7\u6e90D = \u6b66\u5668\u5347\u7d1a\u3002]"}, {"question": "\u5728Urban Stack\u4e2d\u7ba1\u7406\u8cc7\u6e90\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc?", "answer": "\u5728Urban Stack\u4e2d\u6709\u6548\u7ba1\u7406\u8cc7\u6e90\u9700\u8981\u512a\u5148\u8003\u616e\u5fc5\u8981\u7684\u7269\u54c1\u548c\u9810\u5148\u898f\u5283\u3002\u6b65\u9a5f1 - \u63a2\u7d22\u6642\u59cb\u7d42\u6536\u96c6\u8cc7\u6e90\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u8cc7\u6e90\u5206\u914d\u5716\u8868\u4f86\u8ffd\u8e64\u60a8\u64c1\u6709\u7684\u8cc7\u6e90\u548c\u9700\u8981\u7684\u8cc7\u6e90\u3002\u6b65\u9a5f3 - \u5c08\u6ce8\u65bc\u88fd\u4f5c\u63d0\u4f9b\u6700\u5927\u597d\u8655\u7684\u7269\u54c1\uff0c\u4f8b\u5982\u5065\u5eb7\u85e5\u6c34\u548c\u6b66\u5668\u5347\u7d1a\u3002\u4f8b\u5982\uff0c\u5728\u904a\u6232\u521d\u671f\uff0c\u512a\u5148\u6536\u96c6\u6728\u6750\u548c\u77f3\u982d\u4f86\u88fd\u4f5c\u57fa\u672c\u5de5\u5177\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u9078\u9805A - \u6536\u96c6\u4f60\u770b\u5230\u7684\u6bcf\u4e00\u4ef6\u7269\u54c1\uff0c\u9078\u9805B - \u5c08\u6ce8\u65bc\u7279\u5b9a\u8cc7\u6e90\uff0c\u9078\u9805C - \u5e73\u8861\u6536\u96c6\u548c\u88fd\u4f5c\u3002]"}, {"question": "\u5982\u4f55\u6700\u4f73\u5316\u6211\u7684\u89d2\u8272\u7d44\u5408\u4ee5\u61c9\u5c0dUrban Stack\u7684\u6700\u7d42\u5167\u5bb9?", "answer": "\u5728Urban Stack\u4e2d\u6700\u4f73\u5316\u60a8\u7684\u89d2\u8272\u7d44\u5408\u4ee5\u61c9\u5c0d\u6700\u7d42\u5167\u5bb9\u9700\u8981\u4ed4\u7d30\u7684\u898f\u5283\u548c\u6230\u7565\u6027\u7684\u9078\u64c7\u3002\u6b65\u9a5f1 - \u57fa\u65bc\u60a8\u504f\u597d\u7684\u904a\u6232\u98a8\u683c\uff0c\u5c08\u6ce8\u65bc\u63d0\u5347\u60a8\u7684\u4e3b\u8981\u5c6c\u6027 (\u529b\u91cf\u3001\u654f\u6377\u3001\u667a\u529b)\u3002\u6b65\u9a5f2 - \u7a7f\u6234\u8207\u60a8\u7684\u5c6c\u6027\u76f8\u8f14\u76f8\u6210\u7684\u88dd\u5099\uff0c\u4f8b\u5982\u5c0d\u5766\u514b\u89d2\u8272\u4f86\u8aaa\u9ad8\u9632\u79a6\u529b\u76d4\u7532\u3002\u6b65\u9a5f3 - \u5229\u7528\u6280\u80fd\u6a39\u4f86\u89e3\u9396\u5f37\u5927\u7684\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u9b54\u6cd5\u5e2b\u7684\u89d2\u8272\u53ef\u80fd\u6703\u512a\u5148\u8003\u616e\u667a\u529b\u4e26\u914d\u5099\u6cd5\u6756\u4ee5\u63d0\u9ad8\u9b54\u6cd5\u50b7\u5bb3\u3002[\u6d41\u7a0b\u5716\u89e3: \u958b\u59cb \u2192 \u9078\u64c7\u904a\u6232\u98a8\u683c \u2192 \u63d0\u5347\u5c6c\u6027 \u2192 \u88dd\u5099\u88dd\u5099 \u2192 \u89e3\u9396\u80fd\u529b \u2192 \u7d42\u6975\u6e96\u5099\u3002]"}, {"question": "\u5728Urban Stack\u6280\u80fd\u6a39\u4e2d\uff0c\u6211\u61c9\u8a72\u512a\u5148\u8003\u616e\u54ea\u4e9b\u6280\u80fd\u4ee5\u7372\u5f97\u5e73\u8861\u7684\u89d2\u8272?", "answer": "\u5728Urban Stack\u4e2d\uff0c\u70ba\u4e86\u7372\u5f97\u5e73\u8861\u7684\u89d2\u8272\uff0c\u8acb\u512a\u5148\u8003\u616e\u90a3\u4e9b\u52a0\u5f37\u9032\u653b\u548c\u9632\u79a6\u7684\u6280\u80fd\u3002\u5c08\u6ce8\u65bc\u300c\u6230\u9b25\u5927\u5e2b\u300d\u6280\u80fd\uff0c\u4ee5\u63d0\u9ad8\u50b7\u5bb3\uff0c\u4ee5\u53ca\u300c\u9632\u79a6\u59ff\u614b\u300d\u6280\u80fd\uff0c\u4ee5\u63d0\u9ad8\u751f\u5b58\u80fd\u529b\u3002\u6b64\u5916\uff0c\u6295\u8cc7\u65bc\u300c\u8cc7\u6e90\u8c50\u5bcc\u300d\u7b49\u8f14\u52a9\u6280\u80fd\uff0c\u4ee5\u6539\u5584\u8cc7\u6e90\u6536\u96c6\u3002\u4f8b\u5982\uff0c\u5e73\u8861\u7684\u89d2\u8272\u69cb\u5efa\u53ef\u80fd\u5305\u542b\u300c\u6230\u9b25\u5927\u5e2b\u300d\u6280\u80fd\uff0c\u4ee5\u63d0\u9ad8\u653b\u64ca\u529b\uff0c\u4ee5\u53ca\u300c\u9632\u79a6\u59ff\u614b\u300d\u4f86\u6e1b\u5c11\u53d7\u5230\u7684\u50b7\u5bb3\u3002[\u6bd4\u55bb\u8aaa\u660e: \u60f3\u60f3\u5e73\u8861\u89d2\u8272\u5c31\u50cf\u745e\u58eb\u8ecd\u5200\uff0c\u591a\u529f\u80fd\u4e14\u6e96\u5099\u597d\u9762\u5c0d\u4efb\u4f55\u60c5\u6cc1\u3002]"}, {"question": "Urban Stack\u6230\u9b25\u7cfb\u7d71\u80cc\u5f8c\u7684\u95dc\u9375\u6a5f\u5236\u662f\u4ec0\u9ebc?", "answer": "Urban Stack\u6230\u9b25\u7cfb\u7d71\u80cc\u5f8c\u7684\u95dc\u9375\u6a5f\u5236\u5305\u62ec\u653b\u64ca\u9023\u64ca\u3001\u683c\u64cb\u548c\u9ad4\u529b\u7ba1\u7406\u3002\u653b\u64ca\u9023\u64ca\u5141\u8a31\u60a8\u9023\u7e8c\u52d5\u4f5c\uff0c\u4ee5\u63d0\u9ad8\u50b7\u5bb3\uff0c\u800c\u683c\u64cb\u5247\u6e1b\u5c11\u53d7\u5230\u7684\u50b7\u5bb3\u3002\u9ad4\u529b\u7ba1\u7406\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u9650\u5236\u4e86\u60a8\u53ef\u4ee5\u5728\u77ed\u6642\u9593\u5167\u57f7\u884c\u7684\u52d5\u4f5c\u6578\u91cf\u3002\u4f8b\u5982\uff0c\u5728BOSS\u6230\u4e2d\uff0c\u60a8\u53ef\u80fd\u6703\u4f7f\u7528\u9023\u64ca\u4f86\u9020\u6210\u50b7\u5bb3\uff0c\u683c\u64cb\u4ee5\u6e1b\u8f15BOSS\u7684\u653b\u64ca\uff0c\u4e26\u7ba1\u7406\u60a8\u7684\u9ad4\u529b\u4ee5\u907f\u514d\u88ab\u7559\u4e0b\u8106\u5f31\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u7d44\u5408\u653b\u64ca - \u9ad8\u50b7\u5bb3\uff0c\u683c\u64cb - \u6e1b\u5c11\u50b7\u5bb3\uff0c\u9ad4\u529b - \u9650\u5236\u52d5\u4f5c\u3002]"}, {"question": "Urban Stack\u7684\u7b49\u7d1a\u7cfb\u7d71\u5982\u4f55\u5f71\u97ff\u904a\u6232\u9032\u5ea6?", "answer": "Urban Stack\u7684\u7b49\u7d1a\u7cfb\u7d71\u6703\u5f71\u97ff\u904a\u6232\u9032\u5ea6\uff0c\u56e0\u70ba\u5b83\u6703\u89e3\u9396\u65b0\u6280\u80fd\u3001\u63d0\u5347\u5c6c\u6027\u4e26\u63d0\u4f9b\u66f4\u9ad8\u968e\u5225\u7684\u88dd\u5099\u3002\u96a8\u8457\u60a8\u5347\u7d1a\uff0c\u60a8\u6703\u7372\u5f97\u6280\u80fd\u9ede\u6578\u4f86\u6295\u8cc7\u65bc\u60a8\u7684\u6280\u80fd\u6a39\uff0c\u9019\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u60a8\u89d2\u8272\u7684\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u9054\u5230 10 \u7d1a\u53ef\u80fd\u6703\u89e3\u9396\u4e00\u7a2e\u6539\u8b8a\u60a8\u6230\u9b25\u65b9\u5f0f\u7684\u5f37\u5927\u80fd\u529b\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5347\u7d1a\u7b49\u7d1a\u5c31\u50cf\u5347\u7d1a\u60a8\u7684\u6c7d\u8eca\uff1b\u6bcf\u500b\u7b49\u7d1a\u90fd\u6703\u65b0\u589e\u65b0\u529f\u80fd\u4e26\u6539\u9032\u6027\u80fd\u3002]"}, {"question": "\u6211\u53ef\u4ee5\u5c07\u6211\u7684Urban Stack\u9032\u5ea6\u8f49\u79fb\u5230\u4e0d\u540c\u7684\u5e73\u53f0\u55ce\uff1f", "answer": "\u662f\u7684\uff0c\u60a8\u53ef\u4ee5\u4f7f\u7528\u904a\u6232\u7684\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u5c07\u60a8\u7684Urban Stack\u9032\u5ea6\u8f49\u79fb\u5230\u4e0d\u540c\u7684\u5e73\u53f0\u3002\u9019\u8b93\u60a8\u53ef\u4ee5\u9806\u5229\u5730\u5728 PC\u3001\u4e3b\u6a5f\u548c\u884c\u52d5\u8a2d\u5099\u4e4b\u9593\u7e7c\u7e8c\u60a8\u7684\u5192\u96aa\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728 PC \u4e0a\u958b\u59cb\u904a\u6232\uff0c\u4e4b\u5f8c\u5207\u63db\u5230\u4e3b\u6a5f\uff0c\u60a8\u7684\u9032\u5ea6\uff0c\u5305\u62ec\u89d2\u8272\u5c6c\u6027\u548c\u5eab\u5b58\uff0c\u90fd\u5c07\u88ab\u4fdd\u7559\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u9078\u9805A - \u96f2\u7aef\u5132\u5b58 (\u63a8\u85a6)\uff0c\u9078\u9805B - \u624b\u52d5\u8f49\u79fb\u5132\u5b58\uff0c\u9078\u9805C - \u7121\u8f49\u79fb\u53ef\u7528\u3002]"}, {"question": "\u900f\u904e\u63a2\u7d22Urban Stack\u7684\u6bcf\u500b\u89d2\u843d\uff0c\u6211\u53ef\u4ee5\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u5167\u5bb9\uff1f", "answer": "\u900f\u904e\u63a2\u7d22Urban Stack\u7684\u6bcf\u500b\u89d2\u843d\uff0c\u60a8\u53ef\u4ee5\u767c\u73fe\u96b1\u85cf\u5167\u5bb9\uff0c\u4f8b\u5982\u79d8\u5bc6\u5340\u57df\u3001\u7a00\u6709\u7269\u54c1\u548c\u7368\u7279\u7684 NPC\u3002\u4f8b\u5982\uff0c\u5728\u5ee2\u68c4\u5009\u5eab\u7684\u968e\u5c64\u4e2d\uff0c\u6709\u4e00\u500b\u96b1\u85cf\u623f\u9593\u5305\u542b\u4e00\u628a\u53ea\u6709\u900f\u904e\u89e3\u6c7a\u8b0e\u984c\u624d\u80fd\u627e\u5230\u7684\u5f37\u529b\u6b66\u5668\u3002[\u5f69\u86cb\u6316\u6398: \u6ce8\u610f\u89c0\u5bdf\u74b0\u5883\u4e2d\u7684\u7d30\u5fae\u7dda\u7d22\uff0c\u4f8b\u5982\u4e0d\u5c0b\u5e38\u7684\u6a19\u8a18\u6216\u4e0d\u5354\u8abf\u7684\u7269\u4ef6\uff0c\u9019\u4e9b\u7dda\u7d22\u6697\u793a\u8457\u96b1\u85cf\u5167\u5bb9\u3002]"}, {"question": "\u5982\u4f55\u5728Urban Stack\u6230\u9b25\u4e2d\u6709\u6548\u5229\u7528\u74b0\u5883\uff1f", "answer": "\u5728Urban Stack\u7684\u6230\u9b25\u4e2d\u6709\u6548\u5229\u7528\u74b0\u5883\u53ef\u4ee5\u7d66\u60a8\u986f\u8457\u7684\u512a\u52e2\u3002\u6b65\u9a5f1 - \u5229\u7528\u9ad8\u8655\u4f86\u7372\u5f97\u6230\u8853\u512a\u52e2\u4e26\u907f\u514d\u6575\u4eba\u653b\u64ca\u3002\u6b65\u9a5f2 - \u5229\u7528\u53ef\u7834\u58de\u7684\u7269\u4ef6\u4f86\u5efa\u9020\u969c\u7919\u6216\u963b\u64cb\u6575\u4eba\u8def\u7dda\u3002\u6b65\u9a5f3 - \u5229\u7528\u74b0\u5883\u5371\u96aa\uff0c\u4f8b\u5982\u7206\u70b8\u6876\uff0c\u4f86\u9020\u6210\u5340\u57df\u50b7\u5bb3\u3002\u4f8b\u5982\uff0c\u5728\u57ce\u5e02\u516c\u5712\u7684\u5730\u5c64\u4e2d\uff0c\u60a8\u53ef\u4ee5\u4f7f\u7528\u904a\u6a02\u5834\u8a2d\u65bd\u4f86\u7372\u5f97\u9ad8\u8655\uff0c\u4e26\u907f\u514d\u6575\u4eba\u7684\u8fd1\u6230\u653b\u64ca\u3002[\u6bd4\u55bb\u8aaa\u660e: \u60f3\u60f3\u74b0\u5883\u5c31\u50cf\u60a8\u6b66\u5668\u5eab\u4e2d\u7684\u984d\u5916\u6b66\u5668\uff0c\u96a8\u6642\u6e96\u5099\u7528\u65bc\u512a\u52e2\u3002]"}]
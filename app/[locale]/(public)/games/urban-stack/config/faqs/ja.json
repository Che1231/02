[{"question": "\u90fd\u5e02\u30b9\u30bf\u30c3\u30af\u306e\u65b0\u898f\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u3057\u3066\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u8fc5\u901f\u306b\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u90fd\u5e02\u30b9\u30bf\u30c3\u30af\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u8fc5\u901f\u306b\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u624b\u98061 - \u79fb\u52d5\u30ad\u30fc\uff08WASD\uff09\u3068\u30b8\u30e3\u30f3\u30d7\u30ad\u30fc\uff08\u30b9\u30da\u30fc\u30b9\u30d0\u30fc\uff09\u306b\u6163\u308c\u308b\u3002\u624b\u98062 - \u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3\u30ad\u30fc\uff08E\uff09\u3092\u4f7f\u3063\u3066\u6249\u3092\u958b\u3051\u305f\u308a\u3001\u30a2\u30a4\u30c6\u30e0\u3092\u62fe\u3063\u305f\u308a\u3059\u308b\u7df4\u7fd2\u3092\u3059\u308b\u3002\u624b\u98063 - \u653b\u6483\uff08\u5de6\u30af\u30ea\u30c3\u30af\uff09\u3068\u9632\u5fa1\uff08\u53f3\u30af\u30ea\u30c3\u30af\uff09\u306e\u64cd\u4f5c\u3092\u8a66\u3059\u3002\u4f8b\u3048\u3070\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u74b0\u5883\u5185\u3092\u79fb\u52d5\u3057\u305f\u308aNPC\u3068\u63a5\u3057\u305f\u308a\u3059\u308b\u3053\u3068\u3067\u3001\u3053\u308c\u3089\u306e\u64cd\u4f5c\u3092\u7df4\u7fd2\u3067\u304d\u307e\u3059\u3002[\u4f8b\u55a9\u8aac\u660e\uff1a\u64cd\u4f5c\u3092\u8eca\u306e\u904b\u8ee2\u3092\u5b66\u3076\u3053\u3068\u306b\u4f8b\u3048\u308b\u3068\u3001\u4e00\u5ea6\u30b3\u30c4\u3092\u3064\u304b\u3081\u3070\u81ea\u7136\u306b\u306a\u308a\u307e\u3059\u3002]"}, {"question": "\u90fd\u5e02\u30b9\u30bf\u30c3\u30af\u3067\u30af\u30e9\u30d5\u30c8\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u30b2\u30fc\u30e0\u3092\u9032\u3081\u308b\u4e0a\u3067\u306a\u305c\u91cd\u8981\u3067\u3059\u304b\uff1f", "answer": "\u90fd\u5e02\u30b9\u30bf\u30c3\u30af\u306e\u30af\u30e9\u30d5\u30c8\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u901a\u5e38\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3067\u306f\u5165\u624b\u3067\u304d\u306a\u3044\u91cd\u8981\u306a\u30a2\u30a4\u30c6\u30e0\u3084\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u4f5c\u6210\u3067\u304d\u308b\u305f\u3081\u3001\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u56de\u5fa9\u85ac\u3092\u30af\u30e9\u30d5\u30c8\u3059\u308b\u3053\u3068\u3067\u3001\u30dc\u30b9\u6226\u3067\u82e6\u6226\u3059\u308b\u5834\u9762\u3092\u56de\u907f\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u4e16\u754c\u4e2d\u306b\u6563\u3089\u3070\u3063\u3066\u3044\u308b\u30ea\u30bd\u30fc\u30b9\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u6a5f\u80fd\u3057\u307e\u3059\u3002[\u5bfe\u5fdc\u8868\uff1a\u8cc7\u6e90A + \u8cc7\u6e90B = \u56de\u5fa9\u85ac\u3001\u8cc7\u6e90C + \u8cc7\u6e90D = \u6b66\u5668\u5f37\u5316\u3002]"}, {"question": "\u90fd\u5e02\u30b9\u30bf\u30c3\u30af\u306b\u304a\u3051\u308b\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u306e\u6700\u9069\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u90fd\u5e02\u30b9\u30bf\u30c3\u30af\u3067\u306e\u52b9\u679c\u7684\u306a\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u306f\u3001\u5fc5\u9808\u30a2\u30a4\u30c6\u30e0\u3092\u512a\u5148\u3057\u3001\u4e8b\u524d\u306b\u8a08\u753b\u3059\u308b\u3053\u3068\u3092\u542b\u307f\u307e\u3059\u3002\u624b\u98061 - \u63a2\u7d22\u4e2d\u306b\u5e38\u306b\u30ea\u30bd\u30fc\u30b9\u3092\u96c6\u3081\u308b\u3002\u624b\u98062 - \u6240\u6301\u3057\u3066\u3044\u308b\u30ea\u30bd\u30fc\u30b9\u3068\u5fc5\u8981\u306a\u30ea\u30bd\u30fc\u30b9\u3092\u8ffd\u8de1\u3059\u308b\u305f\u3081\u306b\u3001\u30ea\u30bd\u30fc\u30b9\u914d\u5206\u8868\u3092\u4f7f\u7528\u3059\u308b\u3002\u624b\u98063 - \u56de\u5fa9\u85ac\u3084\u6b66\u5668\u5f37\u5316\u306a\u3069\u3001\u6700\u5927\u306e\u30e1\u30ea\u30c3\u30c8\u3092\u3082\u305f\u3089\u3059\u30a2\u30a4\u30c6\u30e0\u3092\u30af\u30e9\u30d5\u30c8\u306b\u91cd\u70b9\u3092\u7f6e\u304f\u3002\u4f8b\u3048\u3070\u3001\u521d\u671f\u306e\u30b2\u30fc\u30e0\u3067\u306f\u3001\u57fa\u672c\u7684\u306a\u9053\u5177\u3092\u30af\u30e9\u30d5\u30c8\u3059\u308b\u305f\u3081\u306b\u6728\u6750\u3068\u77f3\u306e\u53ce\u96c6\u3092\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u6bd4\u8f03\uff1a\u30aa\u30d7\u30b7\u30e7\u30f3A - \u898b\u3048\u308b\u3082\u306e\u306f\u3059\u3079\u3066\u96c6\u3081\u308b\u3001\u30aa\u30d7\u30b7\u30e7\u30f3B - \u7279\u5b9a\u306e\u30ea\u30bd\u30fc\u30b9\u306b\u96c6\u4e2d\u3059\u308b\u3001\u30aa\u30d7\u30b7\u30e7\u30f3C - \u96c6\u3081\u3068\u30af\u30e9\u30d5\u30c8\u306e\u30d0\u30e9\u30f3\u30b9\u3092\u53d6\u308b\u3002]"}, {"question": "\u30a8\u30f3\u30c9\u30b2\u30fc\u30e0\u30b3\u30f3\u30c6\u30f3\u30c4\u306e\u305f\u3081\u306b\u90fd\u5e02\u30b9\u30bf\u30c3\u30af\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30d3\u30eb\u30c9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30a8\u30f3\u30c9\u30b2\u30fc\u30e0\u30b3\u30f3\u30c6\u30f3\u30c4\u306e\u305f\u3081\u306b\u90fd\u5e02\u30b9\u30bf\u30c3\u30af\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30d3\u30eb\u30c9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u614e\u91cd\u306a\u8a08\u753b\u3068\u6226\u7565\u7684\u306a\u9078\u629e\u304c\u5fc5\u8981\u3067\u3059\u3002\u624b\u98061 - \u597d\u307f\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u57fa\u3065\u3044\u3066\u3001\u4e3b\u8981\u306a\u30b9\u30c6\u30fc\u30bf\u30b9\uff08\u529b\u3001\u654f\u6377\u6027\u3001\u77e5\u529b\uff09\u3092\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u3059\u308b\u3002\u624b\u98062 - \u30bf\u30f3\u30af\u30d3\u30eb\u30c9\u3067\u3042\u308c\u3070\u3001\u9ad8\u3044\u9632\u5fa1\u529b\u306e\u88c5\u5099\u3092\u88c5\u5099\u3059\u308b\u306a\u3069\u3001\u30b9\u30c6\u30fc\u30bf\u30b9\u306b\u5408\u3063\u305f\u88c5\u5099\u3092\u88c5\u5099\u3059\u308b\u3002\u624b\u98063 - \u30b9\u30ad\u30eb\u30c4\u30ea\u30fc\u3092\u6d3b\u7528\u3057\u3066\u5f37\u529b\u306a\u80fd\u529b\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u9b54\u6cd5\u4f7f\u3044\u30d3\u30eb\u30c9\u3067\u3042\u308c\u3070\u3001\u77e5\u529b\u306b\u91cd\u70b9\u3092\u7f6e\u304d\u3001\u6756\u3092\u88c5\u5099\u3057\u3066\u9b54\u6cd5\u30c0\u30e1\u30fc\u30b8\u3092\u5897\u3084\u3059\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u958b\u59cb\u2192\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u3092\u9078\u629e\u2192\u30b9\u30c6\u30fc\u30bf\u30b9\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u2192\u88c5\u5099\u88c5\u5099\u2192\u80fd\u529b\u30a2\u30f3\u30ed\u30c3\u30af\u2192\u30a8\u30f3\u30c9\u30b2\u30fc\u30e0\u6e96\u5099\u3002]"}, {"question": "\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u305f\u3081\u306b\u3001\u90fd\u5e02\u30b9\u30bf\u30c3\u30af\u306e\u30b9\u30ad\u30eb\u30c4\u30ea\u30fc\u3067\u512a\u5148\u3059\u3079\u304d\u30b9\u30ad\u30eb\u306f\u3069\u308c\u3067\u3059\u304b\uff1f", "answer": "\u90fd\u5e02\u30b9\u30bf\u30c3\u30af\u3067\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u4f5c\u308b\u969b\u306b\u306f\u3001\u653b\u6483\u529b\u3068\u9632\u5fa1\u529b\u306e\u4e21\u65b9\u3092\u5f37\u5316\u3059\u308b\u30b9\u30ad\u30eb\u3092\u512a\u5148\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u300c\u6226\u95d8\u306e\u9054\u4eba\u300d\u306e\u3088\u3046\u306a\u653b\u6483\u529b\u3092\u9ad8\u3081\u308b\u30b9\u30ad\u30eb\u3068\u3001\u300c\u9632\u5fa1\u59ff\u52e2\u300d\u306e\u3088\u3046\u306a\u751f\u5b58\u7387\u3092\u9ad8\u3081\u308b\u30b9\u30ad\u30eb\u306b\u91cd\u70b9\u3092\u7f6e\u304d\u307e\u3059\u3002\u307e\u305f\u3001\u30ea\u30bd\u30fc\u30b9\u53ce\u96c6\u3092\u6539\u5584\u3059\u308b\u305f\u3081\u306e\u300c\u6a5f\u8ee2\u300d\u306e\u3088\u3046\u306a\u30e6\u30fc\u30c6\u30a3\u30ea\u30c6\u30a3\u30b9\u30ad\u30eb\u306b\u3082\u6295\u8cc7\u3057\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u30d3\u30eb\u30c9\u306b\u306f\u3001\u300c\u6226\u95d8\u306e\u9054\u4eba\u300d\u3067\u653b\u6483\u529b\u3092\u9ad8\u3081\u3001\u300c\u9632\u5fa1\u59ff\u52e2\u300d\u3067\u53d7\u3051\u308b\u30c0\u30e1\u30fc\u30b8\u3092\u8efd\u6e1b\u3059\u308b\u3082\u306e\u304c\u542b\u307e\u308c\u308b\u3067\u3057\u3087\u3046\u3002[\u4f8b\u55a9\u8aac\u660e\uff1a\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306f\u3001\u3042\u3089\u3086\u308b\u72b6\u6cc1\u306b\u5bfe\u5fdc\u3067\u304d\u308b\u4e07\u80fd\u30c4\u30fc\u30eb\u3068\u6349\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u90fd\u5e02\u30b9\u30bf\u30c3\u30af\u306e\u6226\u95d8\u30b7\u30b9\u30c6\u30e0\u306e\u80cc\u5f8c\u306b\u3042\u308b\u91cd\u8981\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u90fd\u5e02\u30b9\u30bf\u30c3\u30af\u306e\u6226\u95d8\u30b7\u30b9\u30c6\u30e0\u306e\u80cc\u5f8c\u306b\u3042\u308b\u91cd\u8981\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u306f\u3001\u653b\u6483\u30b3\u30f3\u30dc\u3001\u30d6\u30ed\u30c3\u30af\u3001\u30b9\u30bf\u30df\u30ca\u7ba1\u7406\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u653b\u6483\u30b3\u30f3\u30dc\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u30c0\u30e1\u30fc\u30b8\u3092\u5897\u3084\u3059\u305f\u3081\u306b\u9023\u7d9a\u6280\u3092\u7e4b\u3052\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4e00\u65b9\u3001\u30d6\u30ed\u30c3\u30af\u306f\u53d7\u3051\u53d6\u308b\u30c0\u30e1\u30fc\u30b8\u3092\u6e1b\u3089\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30bf\u30df\u30ca\u7ba1\u7406\u306f\u3001\u3059\u3050\u306b\u9023\u7d9a\u3057\u3066\u5b9f\u884c\u3067\u304d\u308b\u30a2\u30af\u30b7\u30e7\u30f3\u6570\u3092\u5236\u9650\u3059\u308b\u305f\u3081\u3001\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30dc\u30b9\u6226\u3067\u306f\u3001\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u305f\u3081\u306e\u30b3\u30f3\u30dc\u3001\u30dc\u30b9\u304b\u3089\u306e\u653b\u6483\u3092\u8efd\u6e1b\u3059\u308b\u305f\u3081\u306e\u30d6\u30ed\u30c3\u30af\u3001\u305d\u3057\u3066\u5f31\u4f53\u5316\u3057\u306a\u3044\u3088\u3046\u306b\u30b9\u30bf\u30df\u30ca\u3092\u7ba1\u7406\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u5bfe\u5fdc\u8868\uff1a\u30b3\u30f3\u30dc\u653b\u6483 - \u9ad8\u30c0\u30e1\u30fc\u30b8\u3001\u30d6\u30ed\u30c3\u30af - \u30c0\u30e1\u30fc\u30b8\u8efd\u6e1b\u3001\u30b9\u30bf\u30df\u30ca - \u30a2\u30af\u30b7\u30e7\u30f3\u5236\u9650\u3002]"}, {"question": "\u90fd\u5e02\u30b9\u30bf\u30c3\u30af\u306e\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u9032\u884c\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u90fd\u5e02\u30b9\u30bf\u30c3\u30af\u306e\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u65b0\u3057\u3044\u80fd\u529b\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u3001\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u4e0a\u3052\u3001\u4e0a\u7d1a\u88c5\u5099\u3078\u306e\u30a2\u30af\u30bb\u30b9\u3092\u63d0\u4f9b\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u9032\u884c\u306b\u5f71\u97ff\u3057\u307e\u3059\u3002\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u3059\u308b\u306b\u3064\u308c\u3066\u3001\u30b9\u30ad\u30eb\u30c4\u30ea\u30fc\u306b\u6295\u8cc7\u3059\u308b\u305f\u3081\u306e\u30b9\u30ad\u30eb\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u3001\u3053\u308c\u306b\u3088\u308a\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u80fd\u529b\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb10\u306b\u5230\u9054\u3059\u308b\u3068\u5f37\u529b\u306a\u80fd\u529b\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u3001\u6226\u95d8\u3078\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u65b9\u6cd5\u304c\u5909\u5316\u3059\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002[\u4f8b\u55a9\u8aac\u660e\uff1a\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u306f\u3001\u8eca\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3059\u308b\u3053\u3068\u3068\u540c\u69d8\u3067\u3059\u3002\u5404\u30ec\u30d9\u30eb\u3067\u65b0\u3057\u3044\u6a5f\u80fd\u304c\u8ffd\u52a0\u3055\u308c\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002]"}, {"question": "\u90fd\u5e02\u30b9\u30bf\u30c3\u30af\u306e\u9032\u884c\u72b6\u6cc1\u3092\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u79fb\u52d5\u3055\u305b\u308b\u3053\u3068\u306f\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30b2\u30fc\u30e0\u306e\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u3001\u90fd\u5e02\u30b9\u30bf\u30c3\u30af\u306e\u9032\u884c\u72b6\u6cc1\u3092\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u79fb\u52d5\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001PC\u3001\u30b3\u30f3\u30bd\u30fc\u30eb\u3001\u30e2\u30d0\u30a4\u30eb\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u30b7\u30fc\u30e0\u30ec\u30b9\u306b\u5192\u967a\u3092\u7d9a\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001PC\u3067\u30b2\u30fc\u30e0\u3092\u59cb\u3081\u3001\u5f8c\u3067\u30b3\u30f3\u30bd\u30fc\u30eb\u306b\u5207\u308a\u66ff\u3048\u3066\u3082\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u3084\u30a4\u30f3\u30d9\u30f3\u30c8\u30ea\u3092\u542b\u3080\u9032\u884c\u72b6\u6cc1\u304c\u4fdd\u5b58\u3055\u308c\u307e\u3059\u3002[\u6bd4\u8f03\uff1a\u30aa\u30d7\u30b7\u30e7\u30f3A - \u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\uff08\u63a8\u5968\uff09\u3001\u30aa\u30d7\u30b7\u30e7\u30f3B - \u624b\u52d5\u4fdd\u5b58\u8ee2\u9001\u3001\u30aa\u30d7\u30b7\u30e7\u30f3C - \u79fb\u52d5\u4e0d\u53ef\u3002]"}, {"question": "\u90fd\u5e02\u30b9\u30bf\u30c3\u30af\u306e\u9685\u3005\u307e\u3067\u63a2\u7d22\u3059\u308b\u3053\u3068\u3067\u3001\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u306f\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u90fd\u5e02\u30b9\u30bf\u30c3\u30af\u306e\u9685\u3005\u307e\u3067\u63a2\u7d22\u3059\u308b\u3068\u3001\u79d8\u5bc6\u30a8\u30ea\u30a2\u3001\u30ec\u30a2\u30a2\u30a4\u30c6\u30e0\u3001\u30e6\u30cb\u30fc\u30af\u306aNPC\u306a\u3069\u306e\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u653e\u68c4\u3055\u308c\u305f\u5009\u5eab\u30ec\u30d9\u30eb\u306b\u306f\u3001\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u3053\u3068\u3067\u3057\u304b\u767a\u898b\u3067\u304d\u306a\u3044\u5f37\u529b\u306a\u6b66\u5668\u304c\u5165\u3063\u305f\u96a0\u3057\u90e8\u5c4b\u304c\u3042\u308a\u307e\u3059\u3002[\u88dc\u8db3\uff1a\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u306f\u3001\u74b0\u5883\u306b\u5fae\u5999\u306a\u624b\u304c\u304b\u308a\u3001\u4f8b\u3048\u3070\u3001\u7570\u5e38\u306a\u5370\u8a18\u3084\u4e0d\u81ea\u7136\u306a\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u306a\u3069\u306b\u6ce8\u76ee\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u90fd\u5e02\u30b9\u30bf\u30c3\u30af\u306e\u6226\u95d8\u3067\u74b0\u5883\u3092\u52b9\u679c\u7684\u306b\u6d3b\u7528\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u90fd\u5e02\u30b9\u30bf\u30c3\u30af\u306e\u6226\u95d8\u3067\u74b0\u5883\u3092\u52b9\u679c\u7684\u306b\u6d3b\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u5927\u304d\u306a\u30a2\u30c9\u30d0\u30f3\u30c6\u30fc\u30b8\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u624b\u98061 - \u9ad8\u3044\u5834\u6240\u3092\u5229\u7528\u3057\u3066\u6226\u8853\u7684\u512a\u4f4d\u6027\u3092\u7bc9\u304d\u3001\u6575\u306e\u653b\u6483\u3092\u56de\u907f\u3059\u308b\u3002\u624b\u98062 - \u7834\u58ca\u53ef\u80fd\u306a\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u5229\u7528\u3057\u3066\u3001\u969c\u5bb3\u7269\u3092\u4f5c\u308a\u3001\u6575\u306e\u30eb\u30fc\u30c8\u3092\u906e\u65ad\u3059\u308b\u3002\u624b\u98063 - \u7206\u767a\u6027\u306e\u3042\u308b\u6a3d\u306a\u3069\u306e\u74b0\u5883\u4e0a\u306e\u5371\u967a\u3092\u5229\u7528\u3057\u3066\u3001\u7bc4\u56f2\u653b\u6483\u3092\u884c\u3046\u3002\u4f8b\u3048\u3070\u3001\u90fd\u5e02\u516c\u5712\u30ec\u30d9\u30eb\u3067\u306f\u3001\u904a\u5177\u3092\u4f7f\u7528\u3057\u3066\u9ad8\u3044\u5834\u6240\u3092\u5f97\u3066\u3001\u6575\u306e\u8fd1\u63a5\u653b\u6483\u3092\u56de\u907f\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u4f8b\u55a9\u8aac\u660e\uff1a\u74b0\u5883\u3092\u3001\u3042\u306a\u305f\u306e\u6b66\u5668\u5eab\u306b\u3042\u308b\u8ffd\u52a0\u306e\u6b66\u5668\u3068\u6349\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}]
[{"question": "\ub3c4\uc2dc \uc2a4\ud0dd\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub85c\uc11c \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \ub9c8\uc2a4\ud130\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub3c4\uc2dc \uc2a4\ud0dd\uc5d0\uc11c \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \ub9c8\uc2a4\ud130\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1 - \uc774\ub3d9 \ud0a4(WASD)\uc640 \uc810\ud504 \ud0a4(\uc2a4\ud398\uc774\uc2a4\ubc14)\uc5d0 \uc775\uc219\ud574\uc9c0\uc138\uc694. STEP2 - \uc0c1\ud638 \uc791\uc6a9 \ud0a4(E)\ub97c \uc0ac\uc6a9\ud558\uc5ec \ubb38\uc744 \uc5f4\uace0 \uc544\uc774\ud15c\uc744 \uc90d\ub294 \uc5f0\uc2b5\uc744 \ud558\uc138\uc694. STEP3 - \uc804\ud22c \ucee8\ud2b8\ub864(\uc67c\ucabd \ud074\ub9ad\uc73c\ub85c \uacf5\uaca9, \uc624\ub978\ucabd \ud074\ub9ad\uc73c\ub85c \ubc29\uc5b4)\uc744 \uc2e4\ud5d8\ud574 \ubcf4\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c \ud658\uacbd\uc744 \ub3cc\uc544\ub2e4\ub2c8\uace0 NPC\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\uba74\uc11c \uc774\ub7ec\ud55c \ucee8\ud2b8\ub864\uc744 \uc5f0\uc2b5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ucee8\ud2b8\ub864\uc744 \uc790\ub3d9\ucc28 \uc6b4\uc804 \ud559\uc2b5\uc5d0 \ube44\uc720\ud574 \ubcf4\uc138\uc694. \uc775\uc219\ud574\uc9c0\uba74 \uc790\uc5f0\uc2a4\ub7ec\uc6cc\uc9d1\ub2c8\ub2e4.]"}, {"question": "\ub3c4\uc2dc \uc2a4\ud0dd\uc5d0\uc11c \ud06c\ub798\ud504\ud305 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uac8c\uc784 \uc9c4\ud589\uc5d0 \ud544\uc218\uc801\uc778 \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub3c4\uc2dc \uc2a4\ud0dd\uc758 \ud06c\ub798\ud504\ud305 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \uc815\uae30\uc801\uc778 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud1b5\ud574 \uc5bb\uc744 \uc218 \uc5c6\ub294 \ud544\uc218 \uc544\uc774\ud15c\uacfc \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc81c\uc791\ud560 \uc218 \uc788\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccb4\ub825 \ud3ec\uc158\uc744 \uc81c\uc791\ud558\uba74 \uc5b4\ub824\uc6b4 \ubcf4\uc2a4\uc804\uc5d0\uc11c \uc0dd\uc874\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \uac8c\uc784 \uc138\uacc4 \uacf3\uacf3\uc5d0\uc11c \ubc1c\uacac\ub418\ub294 \uc790\uc6d0\uc744 \uacb0\ud569\ud558\uc5ec \uc791\ub3d9\ud569\ub2c8\ub2e4. [\uc124\uc815 \ub300\uc870\ud45c: \uc790\uc6d0 A + \uc790\uc6d0 B = \uccb4\ub825 \ud3ec\uc158, \uc790\uc6d0 C + \uc790\uc6d0 D = \ubb34\uae30 \uc5c5\uadf8\ub808\uc774\ub4dc.]"}, {"question": "\ub3c4\uc2dc \uc2a4\ud0dd\uc5d0\uc11c \uc790\uc6d0 \uad00\ub9ac\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \ud558\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub3c4\uc2dc \uc2a4\ud0dd\uc5d0\uc11c \ud6a8\uacfc\uc801\uc778 \uc790\uc6d0 \uad00\ub9ac\uc5d0\ub294 \ud544\uc218 \uc544\uc774\ud15c\uc744 \uc6b0\uc120\uc2dc\ud558\uace0 \ubbf8\ub9ac \uacc4\ud68d\ud558\ub294 \uac83\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. STEP1 - \ud0d0\ud5d8\ud558\uba70 \ud56d\uc0c1 \uc790\uc6d0\uc744 \uc218\uc9d1\ud558\uc138\uc694. STEP2 - \uac00\uc9c0\uace0 \uc788\ub294 \uc790\uc6d0\uacfc \ud544\uc694\ud55c \uc790\uc6d0\uc744 \ucd94\uc801\ud558\uae30 \uc704\ud574 \uc790\uc6d0 \ud560\ub2f9 \ucc28\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc138\uc694. STEP3 - \uccb4\ub825 \ud3ec\uc158 \ubc0f \ubb34\uae30 \uc5c5\uadf8\ub808\uc774\ub4dc\uc640 \uac19\uc774 \uac00\uc7a5 \ud070 \uc774\uc810\uc744 \uc81c\uacf5\ud558\ub294 \uc544\uc774\ud15c \uc81c\uc791\uc5d0 \uc9d1\uc911\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ucd08\ubc18\uc5d0\ub294 \uae30\ubcf8 \ub3c4\uad6c\ub97c \uc81c\uc791\ud558\uae30 \uc704\ud574 \ub098\ubb34\uc640 \ub3cc\uc744 \uc218\uc9d1\ud558\ub294 \uac83\uc744 \uc6b0\uc120\uc2dc\ud558\uc138\uc694. [\ub2e4\uc911 \uc194\ub8e8\uc158 \ube44\uad50: \uc635\uc158 A - \ub208\uc5d0 \ubcf4\uc774\ub294 \ubaa8\ub4e0 \uac83\uc744 \uc218\uc9d1, \uc635\uc158 B - \ud2b9\uc815 \uc790\uc6d0\uc5d0 \uc9d1\uc911, \uc635\uc158 C - \uc218\uc9d1\uacfc \uc81c\uc791\uc758 \uade0\ud615.]"}, {"question": "\ub3c4\uc2dc \uc2a4\ud0dd\uc758 \uc5d4\ub4dc \uac8c\uc784 \ucf58\ud150\uce20\ub97c \uc704\ud574 \uce90\ub9ad\ud130 \ube4c\ub4dc\ub97c \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub3c4\uc2dc \uc2a4\ud0dd\uc758 \uc5d4\ub4dc \uac8c\uc784 \ucf58\ud150\uce20\ub97c \uc704\ud574 \uce90\ub9ad\ud130 \ube4c\ub4dc\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc2e0\uc911\ud55c \uacc4\ud68d\uacfc \uc804\ub7b5\uc801\uc778 \uc120\ud0dd\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1 - \uc120\ud638\ud558\ub294 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub530\ub77c \uc8fc\uc694 \uc2a4\ud0ef(\ud798, \ubbfc\ucca9\uc131, \uc9c0\ub2a5)\uc744 \ub808\ubca8\uc5c5\uc5d0 \uc9d1\uc911\ud558\uc138\uc694. STEP2 - \ud0f1\ud06c \ube4c\ub4dc\uc640 \uac19\uc774 \uc2a4\ud0ef\uc5d0 \ubcf4\uc644\uc801\uc778 \uc7a5\ube44\ub97c \ucc29\uc6a9\ud558\uc138\uc694. STEP3 - \uac15\ub825\ud55c \ub2a5\ub825\uc744 \ud574\uc81c\ud558\uae30 \uc704\ud574 \uc2a4\ud0ac \ud2b8\ub9ac\ub97c \ud65c\uc6a9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub9c8\ubc95\uc0ac \ube4c\ub4dc\ub294 \ub192\uc740 \ub9c8\ubc95 \ud53c\ud574\ub97c \uc704\ud574 \uc9c0\ub2a5\uacfc \uc9c0\ud321\uc774\ub97c \uc6b0\uc120\uc2dc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \ub2e4\uc774\uc5b4\uadf8\ub7a8: \uc2dc\uc791 \u2192 \ud50c\ub808\uc774\uc2a4\ud0c0\uc77c \uc120\ud0dd \u2192 \uc2a4\ud0ef \ub808\ubca8\uc5c5 \u2192 \uc7a5\ube44 \ucc29\uc6a9 \u2192 \ub2a5\ub825 \ud574\uc81c \u2192 \uc5d4\ub4dc \uac8c\uc784 \uc900\ube44.]"}, {"question": "\uade0\ud615 \uc7a1\ud78c \uce90\ub9ad\ud130\ub97c \uc704\ud574 \ub3c4\uc2dc \uc2a4\ud0dd \uc2a4\ud0ac \ud2b8\ub9ac\uc5d0\uc11c \uc5b4\ub5a4 \uc2a4\ud0ac\uc744 \uc6b0\uc120\uc2dc\ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\ub3c4\uc2dc \uc2a4\ud0dd\uc5d0\uc11c \uade0\ud615 \uc7a1\ud78c \uce90\ub9ad\ud130\ub97c \uc704\ud574 \uacf5\uaca9\uacfc \ubc29\uc5b4\ub97c \ubaa8\ub450 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \uc2a4\ud0ac\uc744 \uc6b0\uc120\uc2dc\ud558\uc138\uc694. \uc99d\uac00\ub41c \ud53c\ud574\ub97c \uc704\ud55c \"\uc804\ud22c \ub9c8\uc2a4\ud130\ub9ac\"\uc640 \uc0dd\uc874\ub825 \ud5a5\uc0c1\uc744 \uc704\ud55c \"\ubc29\uc5b4 \uc790\uc138\"\uc640 \uac19\uc740 \uc2a4\ud0ac\uc5d0 \uc9d1\uc911\ud558\uc138\uc694. \ub610\ud55c, \uc790\uc6d0 \uc218\uc9d1\uc744 \uac1c\uc120\ud558\uae30 \uc704\ud55c \"\uc790\uc6d0 \ud0d0\uc0c9\"\uacfc \uac19\uc740 \uc720\ud2f8\ub9ac\ud2f0 \uc2a4\ud0ac\uc5d0 \ud22c\uc790\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uade0\ud615 \uc7a1\ud78c \ube4c\ub4dc\uc5d0\ub294 \uacf5\uaca9\ub825 \ud5a5\uc0c1\uc744 \uc704\ud55c \"\uc804\ud22c \ub9c8\uc2a4\ud130\ub9ac\"\uc640 \ub4e4\uc5b4\uc624\ub294 \ud53c\ud574 \uac10\uc18c\ub97c \uc704\ud55c \"\ubc29\uc5b4 \uc790\uc138\"\uac00 \ud3ec\ud568\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uade0\ud615 \uc7a1\ud78c \uce90\ub9ad\ud130\ub97c \ub9cc\ub2a5 \uce7c\ucc98\ub7fc \uc0dd\uac01\ud574 \ubcf4\uc138\uc694. \uc5b4\ub5a4 \uc0c1\ud669\uc5d0\ub3c4 \uc801\uc751\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ub3c4\uc2dc \uc2a4\ud0dd \uc804\ud22c \uc2dc\uc2a4\ud15c\uc758 \uc8fc\uc694 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub3c4\uc2dc \uc2a4\ud0dd \uc804\ud22c \uc2dc\uc2a4\ud15c\uc758 \uc8fc\uc694 \uba54\ucee4\ub2c8\uc998\uc740 \uacf5\uaca9 \uc870\ud569, \ucc28\ub2e8 \ubc0f \uc2a4\ud0dc\ubbf8\ub098 \uad00\ub9ac\uc785\ub2c8\ub2e4. \uacf5\uaca9 \uc870\ud569\uc744 \ud1b5\ud574 \uc5f0\uc18d\uc801\uc778 \uacf5\uaca9\uc73c\ub85c \ud53c\ud574\ub7c9\uc744 \uc99d\uac00\uc2dc\ud0ac \uc218 \uc788\uace0, \ucc28\ub2e8\uc740 \ub4e4\uc5b4\uc624\ub294 \ud53c\ud574\ub97c \uac10\uc18c\uc2dc\ud0b5\ub2c8\ub2e4. \uc2a4\ud0dc\ubbf8\ub098\ub294 \ube60\ub978 \uc5f0\uc18d \ub3d9\uc791\uc744 \uc81c\ud55c\ud558\uae30 \ub54c\ubb38\uc5d0 \uc2a4\ud0dc\ubbf8\ub098 \uad00\ub9ac\uac00 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 \ubcf4\uc2a4\uc804\uc5d0\uc11c \uacf5\uaca9 \uc870\ud569\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud53c\ud574\ub97c \uc785\ud788\uace0 \ubcf4\uc2a4\uc758 \uacf5\uaca9\uc744 \ucc28\ub2e8\ud558\uba70 \uc5f0\uc18d\uc801\uc778 \ud589\ub3d9\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uc2a4\ud0dc\ubbf8\ub098\ub97c \uad00\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc124\uc815 \ub300\uc870\ud45c: \uc870\ud569 \uacf5\uaca9 - \ub192\uc740 \ud53c\ud574, \ucc28\ub2e8 - \ud53c\ud574 \uac10\uc18c, \uc2a4\ud0dc\ubbf8\ub098 - \uc81c\ud55c\ub41c \ud589\ub3d9.]"}, {"question": "\ub3c4\uc2dc \uc2a4\ud0dd\uc758 \ub808\ubca8 \uc2dc\uc2a4\ud15c\uc740 \uac8c\uc784 \uc9c4\ud589\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ub3c4\uc2dc \uc2a4\ud0dd\uc758 \ub808\ubca8 \uc2dc\uc2a4\ud15c\uc740 \uc0c8\ub85c\uc6b4 \ub2a5\ub825\uc744 \ud574\uc81c\ud558\uace0, \uc2a4\ud0ef\uc744 \uc99d\uac00\uc2dc\ud0a4\uba70, \uace0\uae09 \uc7a5\ube44\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\ub3c4\ub85d \ud558\uc5ec \uac8c\uc784 \uc9c4\ud589\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \ub808\ubca8\uc5c5\ud558\uba74 \uc2a4\ud0ac \ud2b8\ub9ac\uc5d0 \ud22c\uc790\ud560 \uc2a4\ud0ac \ud3ec\uc778\ud2b8\ub97c \uc5bb\uc5b4 \uce90\ub9ad\ud130 \ub2a5\ub825\uc744 \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 10\ub808\ubca8\uc5d0 \ub3c4\ub2ec\ud558\uba74 \uc804\ud22c \ubc29\uc2dd\uc744 \ubc14\uafc0 \uc218 \uc788\ub294 \uac15\ub825\ud55c \ub2a5\ub825\uc774 \uc5f4\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ub808\ubca8\uc5c5\uc740 \uc790\ub3d9\ucc28\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uac01 \ub808\ubca8\uc740 \uc0c8\ub85c\uc6b4 \uae30\ub2a5\uc744 \ucd94\uac00\ud558\uace0 \uc131\ub2a5\uc744 \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4.]"}, {"question": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub3c4\uc2dc \uc2a4\ud0dd\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub124, \uac8c\uc784\uc758 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ub3c4\uc2dc \uc2a4\ud0dd \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub97c \ud1b5\ud574 PC, \ucf58\uc194 \ubc0f \ubaa8\ubc14\uc77c \uae30\uae30\uc5d0\uc11c \uc6d0\ud65c\ud558\uac8c \uacc4\uc18d\ud574\uc11c \ubaa8\ud5d8\uc744 \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \uac8c\uc784\uc744 \uc2dc\uc791\ud55c \ud6c4 \ub098\uc911\uc5d0 \ucf58\uc194\ub85c \uc804\ud658\ud558\uba74 \uce90\ub9ad\ud130 \uc2a4\ud0ef \ubc0f \uc778\ubca4\ud1a0\ub9ac \ud3ec\ud568\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc774 \ubcf4\uc874\ub429\ub2c8\ub2e4. [\ub2e4\uc911 \uc194\ub8e8\uc158 \ube44\uad50: \uc635\uc158 A - \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 (\uad8c\uc7a5), \uc635\uc158 B - \uc218\ub3d9 \uc800\uc7a5 \uc804\uc1a1, \uc635\uc158 C - \uc804\uc1a1 \ubd88\uac00.]"}, {"question": "\ub3c4\uc2dc \uc2a4\ud0dd\uc758 \ubaa8\ub4e0 \uad6c\uc11d\uc744 \ud0d0\ud5d8\ud558\uc5ec \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub3c4\uc2dc \uc2a4\ud0dd\uc758 \ubaa8\ub4e0 \uad6c\uc11d\uc744 \ud0d0\ud5d8\ud558\uba74 \ube44\ubc00 \uc601\uc5ed, \ud76c\uadc0 \uc544\uc774\ud15c \ubc0f \ub3c5\ud2b9\ud55c NPC\uc640 \uac19\uc740 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubc84\ub824\uc9c4 \ucc3d\uace0 \ub808\ubca8\uc5d0\ub294 \ud37c\uc990\uc744 \ud480\uc5b4\uc57c\ub9cc \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uac15\ub825\ud55c \ubb34\uae30\ub97c \ubcf4\uad00\ud55c \uc228\uaca8\uc9c4 \ubc29\uc774 \uc788\uc2b5\ub2c8\ub2e4. [\ubcf4\ubb3c \ud0d0\uc0c9: \ubbf8\ubb18\ud55c \ud658\uacbd \ub2e8\uc11c, \uc608\ub97c \ub4e4\uc5b4, \ube44\uc815\uc0c1\uc801\uc778 \ud45c\uc2dc\ub098 \uc801\uc808\ud558\uc9c0 \uc54a\uc740 \ubb3c\uac74\uc5d0 \uc8fc\uc758\ud558\uc5ec \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \ucc3e\uc73c\uc138\uc694.]"}, {"question": "\ub3c4\uc2dc \uc2a4\ud0dd \uc804\ud22c\uc5d0\uc11c \ud658\uacbd\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub3c4\uc2dc \uc2a4\ud0dd \uc804\ud22c\uc5d0\uc11c \ud658\uacbd\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \ud65c\uc6a9\ud558\uba74 \uc0c1\ub2f9\ud55c \uc774\uc810\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1 - \uace0\uc9c0\ub300\ub97c \ud65c\uc6a9\ud558\uc5ec \uc804\uc220\uc801 \uc6b0\uc704\ub97c \ud655\ubcf4\ud558\uace0 \uc801\uc758 \uacf5\uaca9\uc744 \ud53c\ud558\uc138\uc694. STEP2 - \ud30c\uad34 \uac00\ub2a5\ud55c \ubb3c\uccb4\ub97c \ud65c\uc6a9\ud558\uc5ec \uc7a5\ubcbd\uc744 \ub9cc\ub4e4\uac70\ub098 \uc801\uc758 \uacbd\ub85c\ub97c \ucc28\ub2e8\ud558\uc138\uc694. STEP3 - \ud3ed\ubc1c\uc131 \ub4dc\ub7fc\ud1b5\uacfc \uac19\uc740 \ud658\uacbd\uc801 \uc704\ud5d8 \uc694\uc18c\ub97c \ud65c\uc6a9\ud558\uc5ec \uc9c0\uc5ed \ud53c\ud574\ub97c \uc785\ud788\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub3c4\uc2dc \uacf5\uc6d0 \ub808\ubca8\uc5d0\uc11c \ub180\uc774\ud130 \uc2dc\uc124\uc744 \ud65c\uc6a9\ud558\uc5ec \uace0\uc9c0\ub300\ub97c \ud655\ubcf4\ud558\uace0 \uc801\uc758 \uadfc\uc811 \uacf5\uaca9\uc744 \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud658\uacbd\uc744 \ubb34\uae30\uace0\uc5d0 \ucd94\uac00\ub418\ub294 \ubb34\uae30\ucc98\ub7fc \uc0dd\uac01\ud574 \ubcf4\uc138\uc694. \uc5ec\ub7ec\ubd84\uc758 \uc774\uc810\uc744 \uc704\ud574 \ud65c\uc6a9\ud560 \uc900\ube44\uac00 \ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4.]"}]
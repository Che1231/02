[{"question": "\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u5feb\u901f\u638c\u63e1Urban Stack\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1Urban Stack\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u719f\u6089\u79fb\u52a8\u952e\uff08WASD\uff09\u548c\u8df3\u8dc3\u952e\uff08\u7a7a\u683c\u952e\uff09\u3002\u6b65\u9aa42 - \u7ec3\u4e60\u4f7f\u7528\u4ea4\u4e92\u952e\uff08E\uff09\u6253\u5f00\u95e8\u548c\u62fe\u53d6\u7269\u54c1\u3002\u6b65\u9aa43 - \u5c1d\u8bd5\u4f7f\u7528\u6218\u6597\u63a7\u5236\u952e\uff08\u5de6\u952e\u653b\u51fb\uff0c\u53f3\u952e\u683c\u6321\uff09\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u5173\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u5728\u73af\u5883\u4e2d\u79fb\u52a8\u5e76\u4e0eNPC\u4e92\u52a8\u6765\u7ec3\u4e60\u8fd9\u4e9b\u63a7\u5236\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u60f3\u8c61\u4e00\u4e0b\uff0c\u63a7\u5236\u952e\u5c31\u50cf\u5b66\u4e60\u9a7e\u9a76\u6c7d\u8f66\uff1b\u4e00\u65e6\u60a8\u638c\u63e1\u4e86\uff0c\u5b83\u5c31\u4f1a\u6210\u4e3a\u7b2c\u4e8c\u5929\u6027\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u7406\u89e3Urban Stack\u7684\u5236\u4f5c\u7cfb\u7edf\u5bf9\u4e8e\u6e38\u620f\u8fdb\u5ea6\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u5728Urban Stack\u4e2d\u7406\u89e3\u5236\u4f5c\u7cfb\u7edf\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u5141\u8bb8\u60a8\u521b\u5efa\u5728\u5e38\u89c4\u6e38\u620f\u4e2d\u65e0\u6cd5\u83b7\u5f97\u7684\u5fc5\u8981\u7269\u54c1\u548c\u5347\u7ea7\u3002\u4f8b\u5982\uff0c\u5236\u4f5c\u4e00\u4e2a\u751f\u547d\u836f\u5242\u53ef\u4ee5\u5728\u8270\u96be\u7684boss\u6218\u4e2d\u62ef\u6551\u60a8\u3002\u8be5\u7cfb\u7edf\u901a\u8fc7\u7ec4\u5408\u5728\u6e38\u620f\u4e16\u754c\u4e2d\u53d1\u73b0\u7684\u8d44\u6e90\u6765\u8fd0\u4f5c\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u8d44\u6e90A + \u8d44\u6e90B = \u751f\u547d\u836f\u5242\uff0c\u8d44\u6e90C + \u8d44\u6e90D = \u6b66\u5668\u5347\u7ea7\u3002]"}, {"question": "Urban Stack\u4e2d\u6709\u6548\u7ba1\u7406\u8d44\u6e90\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728Urban Stack\u4e2d\u6709\u6548\u7ba1\u7406\u8d44\u6e90\u9700\u8981\u4f18\u5148\u8003\u8651\u5fc5\u8981\u7269\u54c1\u5e76\u8fdb\u884c\u8ba1\u5212\u3002\u6b65\u9aa41 - \u5728\u63a2\u7d22\u65f6\u59cb\u7ec8\u6536\u96c6\u8d44\u6e90\u3002\u6b65\u9aa42 - \u4f7f\u7528\u8d44\u6e90\u5206\u914d\u56fe\u8868\u6765\u8ddf\u8e2a\u60a8\u62e5\u6709\u7684\u8d44\u6e90\u548c\u6240\u9700\u8d44\u6e90\u3002\u6b65\u9aa43 - \u4e13\u6ce8\u4e8e\u5236\u4f5c\u63d0\u4f9b\u6700\u5927\u6548\u76ca\u7684\u7269\u54c1\uff0c\u4f8b\u5982\u751f\u547d\u836f\u5242\u548c\u6b66\u5668\u5347\u7ea7\u3002\u4f8b\u5982\uff0c\u5728\u6e38\u620f\u521d\u671f\uff0c\u4f18\u5148\u6536\u96c6\u6728\u6750\u548c\u77f3\u5934\u6765\u5236\u4f5c\u57fa\u672c\u5de5\u5177\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u9009\u9879A - \u6536\u96c6\u60a8\u770b\u5230\u7684\u4e00\u5207\uff0c\u9009\u9879B - \u4e13\u6ce8\u4e8e\u7279\u5b9a\u8d44\u6e90\uff0c\u9009\u9879C - \u5e73\u8861\u6536\u96c6\u548c\u5236\u4f5c\u3002]"}, {"question": "\u5982\u4f55\u5728Urban Stack\u4e2d\u4f18\u5316\u6211\u7684\u89d2\u8272\u6784\u5efa\u4ee5\u5e94\u5bf9\u6700\u7ec8\u5185\u5bb9\uff1f", "answer": "\u5728Urban Stack\u4e2d\u4f18\u5316\u89d2\u8272\u6784\u5efa\u4ee5\u5e94\u5bf9\u6700\u7ec8\u5185\u5bb9\u9700\u8981\u4ed4\u7ec6\u8ba1\u5212\u548c\u7b56\u7565\u9009\u62e9\u3002\u6b65\u9aa41 - \u6839\u636e\u60a8\u7684\u9996\u9009\u6e38\u620f\u98ce\u683c\uff0c\u4e13\u6ce8\u4e8e\u63d0\u5347\u60a8\u7684\u4e3b\u8981\u5c5e\u6027\uff08\u529b\u91cf\u3001\u654f\u6377\u3001\u667a\u529b\uff09\u3002\u6b65\u9aa42 - \u7a7f\u6234\u4e0e\u60a8\u7684\u5c5e\u6027\u76f8\u5339\u914d\u7684\u88c5\u5907\uff0c\u4f8b\u5982\u5766\u514b\u6784\u5efa\u7684\u9ad8\u9632\u5fa1\u62a4\u7532\u3002\u6b65\u9aa43 - \u5229\u7528\u6280\u80fd\u6811\u6765\u89e3\u9501\u5f3a\u5927\u7684\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u6cd5\u5e08\u6784\u5efa\u53ef\u80fd\u4f18\u5148\u8003\u8651\u667a\u529b\u548c\u88c5\u5907\u6cd5\u6756\u4ee5\u589e\u52a0\u9b54\u6cd5\u4f24\u5bb3\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u5f00\u59cb\u2192\u9009\u62e9\u6e38\u620f\u98ce\u683c\u2192\u63d0\u5347\u5c5e\u6027\u2192\u88c5\u5907\u88c5\u5907\u2192\u89e3\u9501\u6280\u80fd\u2192\u6700\u7ec8\u51c6\u5907\u3002]"}, {"question": "\u5728Urban Stack\u6280\u80fd\u6811\u4e2d\uff0c\u6211\u5e94\u8be5\u4f18\u5148\u8003\u8651\u54ea\u4e9b\u6280\u80fd\u624d\u80fd\u83b7\u5f97\u5e73\u8861\u89d2\u8272\uff1f", "answer": "\u5bf9\u4e8eUrban Stack\u4e2d\u7684\u5e73\u8861\u89d2\u8272\uff0c\u8bf7\u4f18\u5148\u8003\u8651\u80fd\u591f\u589e\u5f3a\u653b\u51fb\u548c\u9632\u5fa1\u7684\u6280\u80fd\u3002\u4e13\u6ce8\u4e8e\u201c\u6218\u6597\u5927\u5e08\u201d\u6280\u80fd\u4ee5\u589e\u52a0\u4f24\u5bb3\u548c\u201c\u9632\u5fa1\u59ff\u6001\u201d\u6280\u80fd\u4ee5\u63d0\u9ad8\u751f\u5b58\u80fd\u529b\u3002\u6b64\u5916\uff0c\u6295\u5165\u5230\u5b9e\u7528\u6280\u80fd\uff0c\u4f8b\u5982\u201c\u8d44\u6e90\u83b7\u53d6\u201d\u6280\u80fd\uff0c\u4ee5\u6539\u5584\u8d44\u6e90\u6536\u96c6\u3002\u4f8b\u5982\uff0c\u5e73\u8861\u6784\u5efa\u53ef\u80fd\u5305\u62ec\u201c\u6218\u6597\u5927\u5e08\u201d\u6280\u80fd\u4ee5\u589e\u52a0\u653b\u51fb\u529b\uff0c\u201c\u9632\u5fa1\u59ff\u6001\u201d\u6280\u80fd\u4ee5\u51cf\u5c11\u6240\u53d7\u4f24\u5bb3\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u60f3\u8c61\u4e00\u4e0b\uff0c\u5e73\u8861\u89d2\u8272\u5c31\u50cf\u4e00\u628a\u745e\u58eb\u519b\u5200\uff0c\u7528\u9014\u5e7f\u6cdb\uff0c\u968f\u65f6\u51c6\u5907\u5e94\u5bf9\u4efb\u4f55\u60c5\u51b5\u3002]"}, {"question": "Urban Stack\u6218\u6597\u7cfb\u7edf\u80cc\u540e\u7684\u4e3b\u8981\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "Urban Stack\u6218\u6597\u7cfb\u7edf\u80cc\u540e\u7684\u4e3b\u8981\u673a\u5236\u5305\u62ec\u8fde\u62db\u3001\u683c\u6321\u548c\u4f53\u529b\u7ba1\u7406\u3002\u8fde\u62db\u5141\u8bb8\u60a8\u5c06\u52a8\u4f5c\u8fde\u6210\u4e00\u4e32\u4ee5\u589e\u52a0\u4f24\u5bb3\uff0c\u800c\u683c\u6321\u5219\u51cf\u5c11\u6240\u53d7\u4f24\u5bb3\u3002\u4f53\u529b\u7ba1\u7406\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u9650\u5236\u4e86\u60a8\u53ef\u4ee5\u5728\u5feb\u901f\u8fde\u7eed\u7684\u52a8\u4f5c\u4e2d\u6267\u884c\u7684\u64cd\u4f5c\u6b21\u6570\u3002\u4f8b\u5982\uff0c\u5728boss\u6218\u4e2d\uff0c\u60a8\u53ef\u80fd\u4f1a\u4f7f\u7528\u8fde\u62db\u6765\u9020\u6210\u4f24\u5bb3\uff0c\u683c\u6321\u6765\u51cf\u8f7bboss\u7684\u653b\u51fb\uff0c\u5e76\u7ba1\u7406\u60a8\u7684\u4f53\u529b\u4ee5\u907f\u514d\u88ab\u7559\u7a7a\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u8fde\u51fb\u653b\u51fb - \u9ad8\u4f24\u5bb3\uff0c\u683c\u6321 - \u51cf\u5c11\u4f24\u5bb3\uff0c\u4f53\u529b - \u9650\u5236\u884c\u52a8\u3002]"}, {"question": "Urban Stack\u7684\u7b49\u7ea7\u7cfb\u7edf\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u8fdb\u5ea6\uff1f", "answer": "Urban Stack\u7684\u7b49\u7ea7\u7cfb\u7edf\u4f1a\u5f71\u54cd\u6e38\u620f\u8fdb\u5ea6\uff0c\u56e0\u4e3a\u5b83\u53ef\u4ee5\u89e3\u9501\u65b0\u6280\u80fd\u3001\u63d0\u5347\u5c5e\u6027\u5e76\u63d0\u4f9b\u66f4\u9ad8\u7b49\u7ea7\u7684\u88c5\u5907\u3002\u968f\u7740\u7b49\u7ea7\u7684\u63d0\u5347\uff0c\u60a8\u5c06\u83b7\u5f97\u6280\u80fd\u70b9\uff0c\u7528\u4e8e\u6295\u8d44\u5230\u60a8\u7684\u6280\u80fd\u6811\u4e2d\uff0c\u8fd9\u53ef\u4ee5\u663e\u7740\u589e\u5f3a\u60a8\u89d2\u8272\u7684\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u8fbe\u523010\u7ea7\u53ef\u80fd\u4f1a\u89e3\u9501\u4e00\u79cd\u5f3a\u5927\u7684\u80fd\u529b\uff0c\u8fd9\u5c06\u6539\u53d8\u60a8\u5e94\u5bf9\u6218\u6597\u7684\u65b9\u5f0f\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5347\u7ea7\u5c31\u50cf\u5347\u7ea7\u60a8\u7684\u6c7d\u8f66\uff1b\u6bcf\u4e2a\u7b49\u7ea7\u90fd\u4f1a\u6dfb\u52a0\u65b0\u529f\u80fd\u5e76\u63d0\u9ad8\u6027\u80fd\u3002]"}, {"question": "\u6211\u53ef\u4ee5\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u6211\u7684Urban Stack\u8fdb\u5ea6\u5417\uff1f", "answer": "\u662f\u7684\uff0c\u60a8\u53ef\u4ee5\u4f7f\u7528\u6e38\u620f\u7684\u4e91\u4fdd\u5b58\u529f\u80fd\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u60a8\u7684Urban Stack\u8fdb\u5ea6\u3002\u8fd9\u5141\u8bb8\u60a8\u5728PC\u3001\u6e38\u620f\u673a\u548c\u79fb\u52a8\u8bbe\u5907\u4e4b\u95f4\u65e0\u7f1d\u5730\u7ee7\u7eed\u60a8\u7684\u5192\u9669\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728PC\u4e0a\u5f00\u59cb\u6e38\u620f\uff0c\u7136\u540e\u5207\u6362\u5230\u6e38\u620f\u673a\uff0c\u60a8\u7684\u8fdb\u5ea6\uff0c\u5305\u62ec\u89d2\u8272\u5c5e\u6027\u548c\u5e93\u5b58\uff0c\u90fd\u5c06\u5f97\u5230\u4fdd\u7559\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u9009\u9879A - \u4e91\u4fdd\u5b58\uff08\u63a8\u8350\uff09\uff0c\u9009\u9879B - \u624b\u52a8\u4fdd\u5b58\u8f6c\u79fb\uff0c\u9009\u9879C - \u65e0\u53ef\u7528\u8f6c\u79fb\u3002]"}, {"question": "\u901a\u8fc7\u63a2\u7d22Urban Stack\u7684\u6bcf\u4e2a\u89d2\u843d\uff0c\u6211\u53ef\u4ee5\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u5185\u5bb9\uff1f", "answer": "\u901a\u8fc7\u63a2\u7d22Urban Stack\u7684\u6bcf\u4e00\u4e2a\u89d2\u843d\uff0c\u60a8\u53ef\u4ee5\u53d1\u73b0\u9690\u85cf\u5185\u5bb9\uff0c\u4f8b\u5982\u79d8\u5bc6\u533a\u57df\u3001\u7a00\u6709\u7269\u54c1\u548c\u72ec\u7279\u7684NPC\u3002\u4f8b\u5982\uff0c\u5728\u5e9f\u5f03\u4ed3\u5e93\u7ea7\u522b\u4e2d\uff0c\u6709\u4e00\u4e2a\u9690\u85cf\u623f\u95f4\u5305\u542b\u4e00\u628a\u5f3a\u5927\u7684\u6b66\u5668\uff0c\u53ea\u80fd\u901a\u8fc7\u89e3\u51b3\u8c1c\u9898\u624d\u80fd\u627e\u5230\u3002[\u5f69\u86cb\u6316\u6398\uff1a\u5bc6\u5207\u5173\u6ce8\u73af\u5883\u4e2d\u7684\u7ec6\u5fae\u7ebf\u7d22\uff0c\u4f8b\u5982\u4e0d\u5bfb\u5e38\u7684\u6807\u8bb0\u6216\u4e0d\u5408\u9002\u7684\u7269\u4f53\uff0c\u8fd9\u4e9b\u63d0\u793a\u9690\u85cf\u5185\u5bb9\u3002]"}, {"question": "\u5982\u4f55\u5728Urban Stack\u6218\u6597\u4e2d\u6709\u6548\u5730\u5229\u7528\u73af\u5883\uff1f", "answer": "\u5728Urban Stack\u6218\u6597\u4e2d\u6709\u6548\u5730\u5229\u7528\u73af\u5883\u53ef\u4ee5\u4e3a\u60a8\u63d0\u4f9b\u663e\u8457\u4f18\u52bf\u3002\u6b65\u9aa41 - \u5229\u7528\u9ad8\u5730\u6765\u83b7\u5f97\u6218\u672f\u4f18\u52bf\u5e76\u907f\u514d\u654c\u4eba\u88ad\u51fb\u3002\u6b65\u9aa42 - \u5229\u7528\u53ef\u7834\u574f\u7684\u7269\u4f53\u6765\u521b\u5efa\u969c\u788d\u6216\u963b\u585e\u654c\u4eba\u8def\u5f84\u3002\u6b65\u9aa43 - \u5229\u7528\u73af\u5883\u5371\u5bb3\uff0c\u4f8b\u5982\u7206\u70b8\u6876\uff0c\u9020\u6210\u533a\u57df\u4f24\u5bb3\u3002\u4f8b\u5982\uff0c\u5728\u57ce\u5e02\u516c\u56ed\u7ea7\u522b\u4e2d\uff0c\u60a8\u53ef\u4ee5\u4f7f\u7528\u6e38\u4e50\u573a\u7ed3\u6784\u6765\u83b7\u5f97\u9ad8\u5730\u5e76\u907f\u514d\u654c\u4eba\u8fd1\u6218\u653b\u51fb\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u60f3\u8c61\u4e00\u4e0b\uff0c\u73af\u5883\u662f\u60a8\u6b66\u5668\u5e93\u4e2d\u7684\u989d\u5916\u6b66\u5668\uff0c\u968f\u65f6\u51c6\u5907\u4e3a\u60a8\u6240\u7528\u3002]"}]
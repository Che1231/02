[{"question": "\u30de\u30f3\u30e9\u30f3\u30ca\u30fc2048\u306e\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u7d20\u65e9\u304f\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30de\u30f3\u30e9\u30f3\u30ca\u30fc2048\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u7d20\u65e9\u304f\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71 - \u30b9\u30ef\u30a4\u30d7\u30b8\u30a7\u30b9\u30c1\u30e3\u30fc\u306b\u6163\u308c\u308b\uff1a\u30b8\u30e3\u30f3\u30d7\u3059\u308b\u306b\u306f\u4e0a\u306b\u3001\u30b9\u30e9\u30a4\u30c9\u3059\u308b\u306b\u306f\u4e0b\u306b\u3001\u30ec\u30fc\u30f3\u3092\u5909\u3048\u308b\u306b\u306f\u5de6\u307e\u305f\u306f\u53f3\u306b\u30b9\u30ef\u30a4\u30d7\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - \u30d0\u30ea\u30a2\u3084\u30c8\u30e9\u30c3\u30d7\u306a\u3069\u306e\u969c\u5bb3\u7269\u3092\u56de\u907f\u3059\u308b\u305f\u3081\u306b\u3001\u30b9\u30ef\u30a4\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u7df4\u7fd2\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u30da\u30ca\u30eb\u30c6\u30a3\u306a\u3057\u3067\u5b9f\u8df5\u7684\u306a\u7d4c\u9a13\u3092\u5f97\u308b\u305f\u3081\u306b\u3001\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30e2\u30fc\u30c9\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u305d\u308c\u3092\u98db\u3073\u8d8a\u3048\u308b\u305f\u3081\u306b\u4e0a\u306b\u30b9\u30ef\u30a4\u30d7\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u5358\u7d14\u306a\u30d0\u30ea\u30a2\u306b\u906d\u9047\u3057\u307e\u3059\u3002\u5e38\u306b\u7df4\u7fd2\u3059\u308b\u3053\u3068\u3067\u3001\u3042\u306a\u305f\u306e\u53cd\u5c04\u795e\u7d4c\u3068\u64cd\u4f5c\u306e\u7cbe\u5ea6\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u64cd\u4f5c\u3092\u8eca\u306e\u904b\u8ee2\u306e\u3088\u3046\u306b\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u6ed1\u3089\u304b\u3067\u610f\u56f3\u7684\u306a\u52d5\u304d\u304c\u6700\u9ad8\u306e\u7d50\u679c\u3092\u3082\u305f\u3089\u3057\u307e\u3059\u3002]"}, {"question": "\u30de\u30f3\u30e9\u30f3\u30ca\u30fc2048\u3067\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u3092\u52b9\u679c\u7684\u306b\u4f7f\u7528\u3059\u308b\u65b9\u6cd5\u306f\uff1f", "answer": "\u30de\u30f3\u30e9\u30f3\u30ca\u30fc2048\u306e\u30b3\u30a4\u30f3\u306f\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306e\u30a2\u30f3\u30ed\u30c3\u30af\u3068\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u52b9\u679c\u7684\u306b\u4f7f\u7528\u3059\u308b\u65b9\u6cd5\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71 - \u30e9\u30f3\u30cb\u30f3\u30b0\u4e2d\u306b\u30b3\u30a4\u30f3\u3092\u7a4d\u6975\u7684\u306b\u96c6\u3081\u3001\u7279\u306b\u969c\u5bb3\u7269\u304c\u5c11\u306a\u3044\u30a8\u30ea\u30a2\u3092\u91cd\u70b9\u7684\u306b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - \u30b7\u30fc\u30eb\u30c9\u306e\u3088\u3046\u306a\u5fc5\u9808\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u8cfc\u5165\u3059\u308b\u305f\u3081\u306b\u30b3\u30a4\u30f3\u3092\u8caf\u3081\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u4e00\u5ea6\u306e\u30d2\u30c3\u30c8\u304b\u3089\u3042\u306a\u305f\u3092\u5b88\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u30b2\u30fc\u30e0\u306e\u521d\u671f\u6bb5\u968e\u3067\u3001\u88c5\u98fe\u54c1\u306b\u30b3\u30a4\u30f3\u3092\u8cbb\u3084\u3059\u306e\u3092\u63a7\u3048\u307e\u3057\u3087\u3046\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb3\u3067\u306f\u3001\u30c8\u30e9\u30c3\u30d7\u30b7\u30fc\u30b1\u30f3\u30b9\u306e\u524d\u306b\u30b3\u30a4\u30f3\u306e\u584a\u304c\u898b\u3064\u304b\u308b\u3067\u3057\u3087\u3046\u3002\u8b66\u6212\u3057\u306a\u304c\u3089\u305d\u308c\u3092\u3064\u304b\u3080\u3053\u3068\u306b\u96c6\u4e2d\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u8868\uff1a\u30b3\u30a4\u30f3\u3068\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\uff1a100\u30b3\u30a4\u30f3 = 1\u30b7\u30fc\u30eb\u30c9\u3001500\u30b3\u30a4\u30f3 = 1\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u3002]"}, {"question": "\u30de\u30f3\u30e9\u30f3\u30ca\u30fc2048\u306e\u7c21\u5358\u30e2\u30fc\u30c9\u3068\u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30de\u30f3\u30e9\u30f3\u30ca\u30fc2048\u306e\u7c21\u5358\u30e2\u30fc\u30c9\u3068\u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\u306e\u9055\u3044\u306f\u3001\u4e3b\u306b3\u3064\u3042\u308a\u307e\u3059\u30021) \u969c\u5bb3\u7269\u306e\u5bc6\u5ea6 - \u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\u3067\u306f\u3001\u969c\u5bb3\u7269\u306e\u65b9\u304c\u983b\u7e41\u3067\u8907\u96d1\u3067\u3059\u30022) \u30b9\u30d4\u30fc\u30c9 - \u30e9\u30f3\u30ca\u30fc\u306f\u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\u3067\u306f\u3088\u308a\u901f\u304f\u79fb\u52d5\u3059\u308b\u305f\u3081\u3001\u3088\u308a\u7d20\u65e9\u3044\u53cd\u5fdc\u304c\u6c42\u3081\u3089\u308c\u307e\u3059\u30023) \u30dc\u30fc\u30ca\u30b9 - \u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\u3067\u306f\u3001\u719f\u7df4\u3057\u305f\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u5bfe\u3057\u3066\u3088\u308a\u9ad8\u3044\u30b3\u30a4\u30f3\u306e\u500d\u7387\u304c\u4e0e\u3048\u3089\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\u3067\u306f\u3001\u7c21\u5358\u30e2\u30fc\u30c9\u3067\u306f\u9593\u9694\u3092\u3042\u3051\u3066\u3044\u308b\u306e\u306b\u5bfe\u3057\u3001\u8fc5\u901f\u306a\u9023\u7d9a\u30673\u3064\u306e\u30d0\u30ea\u30a2\u306e\u30b7\u30fc\u30b1\u30f3\u30b9\u306b\u906d\u9047\u3059\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u7c21\u5358\u30e2\u30fc\u30c9\u2192\u969c\u5bb3\u7269\u304c\u5c11\u306a\u3044\u2192\u901f\u5ea6\u304c\u9045\u3044\u2192\u30dc\u30fc\u30ca\u30b9\u304c\u5c11\u306a\u3044 | \u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\u2192\u969c\u5bb3\u7269\u304c\u591a\u3044\u2192\u901f\u5ea6\u304c\u901f\u3044\u2192\u30dc\u30fc\u30ca\u30b9\u304c\u591a\u3044\u3002]"}, {"question": "\u30de\u30f3\u30e9\u30f3\u30ca\u30fc2048\u3067\u9ad8\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u305f\u3081\u306b\u5f79\u7acb\u3064\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30de\u30f3\u30e9\u30f3\u30ca\u30fc2048\u3067\u9ad8\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u306b\u306f\u3001\u30b9\u30ad\u30eb\u3068\u6226\u7565\u306e\u4e21\u65b9\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71 - \u30bf\u30a4\u30df\u30f3\u30b0\u30df\u30b9\u3092\u9632\u3050\u305f\u3081\u306b\u3001\u5b89\u5b9a\u3057\u305f\u30ea\u30ba\u30e0\u3092\u7dad\u6301\u3059\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - \u78c1\u77f3\u306e\u3088\u3046\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u6226\u7565\u7684\u306b\u4f7f\u7528\u3057\u3066\u3001\u7c21\u5358\u306b\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u4e00\u6642\u505c\u6b62\u3059\u308b\u3053\u3068\u306a\u304f\u969c\u5bb3\u7269\u3092\u7d99\u7d9a\u7684\u306b\u56de\u907f\u3059\u308b\u3053\u3068\u3067\u3001\u30b3\u30f3\u30dc\u30c1\u30a7\u30fc\u30f3\u3092\u76ee\u6307\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb5\u3067\u306f\u3001\u8907\u6570\u306e\u30d0\u30ea\u30a2\u3092\u9023\u7d9a\u3057\u3066\u30b8\u30e3\u30f3\u30d7\u3057\u3066\u9ad8\u30b3\u30f3\u30dc\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3067\u304d\u308b\u30bb\u30af\u30b7\u30e7\u30f3\u304c\u3042\u308a\u307e\u3059\u3002[\u6bd4\u8f03\u8868\uff1a\u6226\u7565A - \u30a2\u30b0\u30ec\u30c3\u30b7\u30d6\u30b3\u30a4\u30f3\u53ce\u96c6\u3068\u6226\u7565B - \u30bb\u30fc\u30d5\u969c\u5bb3\u7269\u56de\u907f\u3002]"}, {"question": "\u30de\u30f3\u30e9\u30f3\u30ca\u30fc2048\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u30dd\u30a4\u30f3\u30c8\u3092\u8a08\u7b97\u3057\u3001\u3069\u306e\u3088\u3046\u306a\u8981\u56e0\u304c\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30de\u30f3\u30e9\u30f3\u30ca\u30fc2048\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u30013\u3064\u306e\u8981\u56e0\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u30021) \u8ddd\u96e2 - \u8d70\u884c\u8ddd\u96e2\u304c\u9577\u3044\u307b\u3069\u3001\u30b9\u30b3\u30a2\u306f\u9ad8\u304f\u306a\u308a\u307e\u3059\u30022) \u30b3\u30a4\u30f3 - \u96c6\u3081\u305f\u5404\u30b3\u30a4\u30f3\u306f\u3001\u5408\u8a08\u30b9\u30b3\u30a2\u306b\u52a0\u7b97\u3055\u308c\u307e\u3059\u30023) \u30b3\u30f3\u30dc - \u969c\u5bb3\u7269\u3092\u56de\u907f\u3059\u308b\u30c1\u30a7\u30fc\u30f3\u306f\u3001\u30dd\u30a4\u30f3\u30c8\u3092\u500d\u5897\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001500\u30e1\u30fc\u30c8\u30eb\u8d70\u3063\u3066\u300150\u500b\u306e\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u30013\u500d\u306e\u30b3\u30f3\u30dc\u3092\u7372\u5f97\u3057\u305f\u5834\u5408\u3001\u30b9\u30b3\u30a2\u306f (500 + 50) \u00d7 3 = 1650\u30dd\u30a4\u30f3\u30c8\u3068\u8a08\u7b97\u3055\u308c\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u3092\u9280\u884c\u53e3\u5ea7\u306e\u3088\u3046\u306b\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u8ddd\u96e2\u306f\u3042\u306a\u305f\u306e\u8caf\u84c4\u3001\u30b3\u30a4\u30f3\u306f\u9810\u91d1\u3001\u30b3\u30f3\u30dc\u306f\u305d\u306e\u5229\u606f\u3067\u3059\u3002]"}, {"question": "\u30de\u30f3\u30e9\u30f3\u30ca\u30fc2048\u3067\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u6700\u9069\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u3092\u3069\u306e\u3088\u3046\u306b\u30bf\u30a4\u30df\u30f3\u30b0\u3088\u304f\u4f7f\u7528\u3059\u3079\u304d\u3067\u3059\u304b\uff1f", "answer": "\u30de\u30f3\u30e9\u30f3\u30ca\u30fc2048\u306e\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u3053\u308c\u3089\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u512a\u5148\u7684\u306b\u4f7f\u7528\u3059\u3079\u304d\u3067\u3059\u30021) \u30b7\u30fc\u30eb\u30c9 - \u9ad8\u30ea\u30b9\u30af\u30bb\u30af\u30b7\u30e7\u30f3\u306b\u5165\u308b\u524d\u306b\u4f7f\u7528\u3057\u3066\u3001\u9032\u884c\u72b6\u6cc1\u3092\u5931\u3046\u306e\u3092\u9632\u304e\u307e\u3059\u30022) \u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8 - \u76f4\u7dda\u90e8\u5206\u3067\u30a2\u30af\u30c6\u30a3\u30d6\u306b\u3057\u3066\u3001\u8ddd\u96e2\u3092\u6700\u5927\u9650\u306b\u4f38\u3070\u3057\u307e\u3059\u30023) \u78c1\u77f3 - \u30b3\u30a4\u30f3\u306e\u584a\u304c\u591a\u3044\u30a8\u30ea\u30a2\u3067\u4f7f\u7528\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb7\u3067\u306f\u3001\u6700\u521d\u306e\u30c1\u30a7\u30c3\u30af\u30dd\u30a4\u30f3\u30c8\u306e\u3059\u3050\u5f8c\u306b\u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u3088\u308a\u591a\u304f\u306e\u8ddd\u96e2\u3092\u901f\u304f\u30ab\u30d0\u30fc\u3067\u304d\u307e\u3059\u3002[\u8868\uff1a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0 - \u30b7\u30fc\u30eb\u30c9\uff1a\u30c8\u30e9\u30c3\u30d7\u306e\u524d\u306b | \u30b9\u30d4\u30fc\u30c9\u30d6\u30fc\u30b9\u30c8\uff1a\u958b\u3051\u305f\u30a8\u30ea\u30a2 | \u78c1\u77f3\uff1a\u30b3\u30a4\u30f3\u306e\u584a\u3002]"}, {"question": "\u30de\u30f3\u30e9\u30f3\u30ca\u30fc2048\u306e\u30ec\u30fc\u30f3\u30c1\u30a7\u30f3\u30b8\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u304b\uff1f\u305d\u306e\u9650\u754c\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30de\u30f3\u30e9\u30f3\u30ca\u30fc2048\u306e\u30ec\u30fc\u30f3\u30c1\u30a7\u30f3\u30b8\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u3088\u308a\u52b9\u679c\u7684\u306b\u969c\u5bb3\u7269\u3092\u907f\u3051\u3001\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u305f\u3060\u3057\u3001\u9650\u754c\u304c\u3042\u308a\u307e\u3059\u30021) \u51b7\u5374\u6642\u9593 - \u30e9\u30f3\u30cb\u30f3\u30b0\u30ec\u30fc\u30f3\u30c1\u30a7\u30f3\u30b8\u306f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u30df\u30b9\u306b\u3064\u306a\u304c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u30022) \u969c\u5bb3\u7269\u306e\u914d\u7f6e - \u3044\u304f\u3064\u304b\u306e\u969c\u5bb3\u7269\u306f\u8907\u6570\u306e\u30ec\u30fc\u30f3\u306b\u307e\u305f\u304c\u308b\u305f\u3081\u3001\u30b8\u30e3\u30f3\u30d7\u3084\u30b9\u30e9\u30a4\u30c9\u304c\u5fc5\u8981\u306b\u306a\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb4\u3067\u306f\u30012\u3064\u306e\u30ec\u30fc\u30f3\u3092\u8986\u3046\u30d0\u30ea\u30a2\u306b\u906d\u9047\u3059\u308b\u305f\u3081\u3001\u30ec\u30fc\u30f3\u3092\u5909\u3048\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u305d\u308c\u3092\u98db\u3073\u8d8a\u3048\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u30ec\u30fc\u30f3\u30c1\u30a7\u30f3\u30b8\u306f\u3001\u4ea4\u901a\u3067\u5225\u306e\u30ec\u30fc\u30f3\u306b\u5909\u66f4\u3059\u308b\u306e\u3068\u540c\u3058\u3067\u3059\u3002\u5f79\u7acb\u3061\u307e\u3059\u304c\u3001\u5e38\u306b\u89e3\u6c7a\u7b56\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002]"}, {"question": "\u30de\u30f3\u30e9\u30f3\u30ca\u30fc2048\u306e\u9032\u884c\u72b6\u6cc1\u306f\u3001\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u8ee2\u9001\u3067\u304d\u307e\u3059\u304b\uff1f\u4f55\u306e\u624b\u9806\u304c\u5fc5\u8981\u3067\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30de\u30f3\u30e9\u30f3\u30ca\u30fc2048\u306e\u9032\u884c\u72b6\u6cc1\u306f\u3001Google Play\u3084Apple Game Center\u306a\u3069\u306e\u30af\u30e9\u30a6\u30c9\u30b5\u30fc\u30d3\u30b9\u306b\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30ea\u30f3\u30af\u3059\u308b\u3053\u3068\u3067\u3001\u7570\u306a\u308b\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u8ee2\u9001\u3067\u304d\u307e\u3059\u3002\u624b\u9806\u306f\u4ee5\u4e0b\u306e\u3068\u304a\u308a\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71 - \u30b2\u30fc\u30e0\u306e\u8a2d\u5b9a\u3092\u958b\u304d\u3001\u300c\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u300d\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72 - \u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u30a2\u30ab\u30a6\u30f3\u30c8\u306e\u8cc7\u683c\u60c5\u5831\u3092\u5165\u529b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73 - \u300c\u30c7\u30fc\u30bf\u3092\u8aad\u307f\u8fbc\u3080\u300d\u3092\u9078\u629e\u3057\u3066\u3001\u9032\u884c\u72b6\u6cc1\u3092\u540c\u671f\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001Android\u643a\u5e2f\u96fb\u8a71\u304b\u3089iPhone\u306b\u5207\u308a\u66ff\u3048\u305f\u5834\u5408\u3001\u9ad8\u5f97\u70b9\u3068\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u305f\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u304c\u5f15\u304d\u7d99\u304c\u308c\u307e\u3059\u3002[\u6bd4\u8f03\u8868\uff1aGoogle Play\u3068Apple Game Center - \u4e21\u65b9\u3068\u3082\u30b7\u30fc\u30e0\u30ec\u30b9\u306a\u8ee2\u9001\u3092\u63d0\u4f9b\u3057\u307e\u3059\u304c\u3001\u305d\u308c\u305e\u308c\u306e\u30a2\u30ab\u30a6\u30f3\u30c8\u304c\u5fc5\u8981\u3067\u3059\u3002]"}, {"question": "\u30de\u30f3\u30e9\u30f3\u30ca\u30fc2048\u3067\u5229\u7528\u53ef\u80fd\u306a\u975e\u8868\u793a\u306e\u9054\u6210\u306f\u4f55\u3067\u3059\u304b\uff1f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u305d\u308c\u3089\u306f\u3069\u3046\u3084\u3063\u3066\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30de\u30f3\u30e9\u30f3\u30ca\u30fc2048\u306b\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u975e\u8868\u793a\u306e\u9054\u6210\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300c\u30d1\u30fc\u30d5\u30a7\u30af\u30c8\u30e9\u30f3\u300d\uff08\u969c\u5bb3\u7269\u306b\u5f53\u305f\u3089\u306a\u3044\u3067\u30ec\u30d9\u30eb\u3092\u5b8c\u4e86\u3059\u308b\uff09\u3084\u3001\u300c\u30b3\u30a4\u30f3\u30b3\u30ec\u30af\u30bf\u30fc\u300d\uff081\u56de\u306e\u30e9\u30f3\u30671,000\u500b\u306e\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u308b\uff09\u306a\u3069\u3067\u3059\u3002\u305d\u308c\u3089\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u305f\u3081\u306b\u3001\u969c\u5bb3\u7269\u3092\u56de\u907f\u3057\u3001\u30b3\u30a4\u30f3\u53ce\u96c6\u30eb\u30fc\u30c8\u3092\u6700\u9069\u5316\u3059\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb6\u306b\u306f\u3001\u7279\u5225\u306a\u30b3\u30a4\u30f3\u304c\u3042\u308b\u96a0\u308c\u9053\u304c\u3042\u308a\u3001\u3053\u308c\u306b\u3088\u308a\u300c\u30b3\u30a4\u30f3\u30b3\u30ec\u30af\u30bf\u30fc\u300d\u3092\u9054\u6210\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u975e\u8868\u793a\u306e\u9054\u6210\u30d1\u30b9 - \u969c\u5bb3\u7269\u3092\u56de\u907f\u2192\u30b3\u30a4\u30f3\u3092\u96c6\u3081\u308b\u2192\u30ec\u30d9\u30eb\u3092\u5b8c\u4e86\u3059\u308b\u2192\u9054\u6210\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u3002]"}]
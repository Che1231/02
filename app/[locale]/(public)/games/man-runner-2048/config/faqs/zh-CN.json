[{"question": "\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u5feb\u901f\u638c\u63e1\u300a\u8dd1\u9177\u80052048\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1\u300a\u8dd1\u9177\u80052048\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u719f\u6089\u6ed1\u52a8\u64cd\u4f5c\uff1a\u5411\u4e0a\u6ed1\u52a8\u8fdb\u884c\u8df3\u8dc3\uff0c\u5411\u4e0b\u6ed1\u52a8\u8fdb\u884c\u6ed1\u884c\uff0c\u5de6\u53f3\u6ed1\u52a8\u8fdb\u884c\u8dd1\u9053\u5207\u6362\u3002\u6b65\u9aa42 - \u7ec3\u4e60\u6ed1\u52a8\u65f6\u673a\uff0c\u4ee5\u907f\u5f00\u969c\u788d\u7269\uff0c\u4f8b\u5982\u969c\u788d\u548c\u9677\u9631\u3002\u6b65\u9aa43 - \u4f7f\u7528\u6559\u7a0b\u6a21\u5f0f\uff0c\u5728\u6ca1\u6709\u60e9\u7f5a\u7684\u60c5\u51b5\u4e0b\u83b7\u5f97\u5b9e\u8df5\u7ecf\u9a8c\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u5173\uff0c\u4f60\u5c06\u9047\u5230\u4e00\u4e2a\u7b80\u5355\u7684\u969c\u788d\uff0c\u9700\u8981\u5411\u4e0a\u6ed1\u52a8\u624d\u80fd\u8df3\u8fc7\u5b83\u3002\u8bb0\u4f4f\uff0c\u6301\u7eed\u7ec3\u4e60\u5c06\u63d0\u9ad8\u4f60\u7684\u53cd\u5e94\u901f\u5ea6\u548c\u63a7\u5236\u7cbe\u5ea6\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u64cd\u4f5c\u60f3\u8c61\u6210\u5f00\u8f66\u2014\u2014\u5e73\u7a33\u800c\u6709\u76ee\u7684\u7684\u884c\u52a8\u624d\u80fd\u83b7\u5f97\u6700\u4f73\u6548\u679c\u3002]"}, {"question": "\u5728\u300a\u8dd1\u9177\u80052048\u300b\u4e2d\u6536\u96c6\u786c\u5e01\u6709\u4ec0\u4e48\u91cd\u8981\u610f\u4e49\uff0c\u4ee5\u53ca\u5982\u4f55\u6709\u6548\u5229\u7528\u5b83\u4eec\uff1f", "answer": "\u300a\u8dd1\u9177\u80052048\u300b\u4e2d\u7684\u786c\u5e01\u5bf9\u4e8e\u89e3\u9501\u9053\u5177\u548c\u81ea\u5b9a\u4e49\u89d2\u8272\u81f3\u5173\u91cd\u8981\u3002\u4ee5\u4e0b\u662f\u5982\u4f55\u6709\u6548\u5229\u7528\u5b83\u4eec\uff1a\u6b65\u9aa41 - \u5728\u8dd1\u9177\u8fc7\u7a0b\u4e2d\u4f18\u5148\u6536\u96c6\u786c\u5e01\uff0c\u5c24\u5176\u662f\u5728\u969c\u788d\u7269\u8f83\u5c11\u7684\u533a\u57df\u3002\u6b65\u9aa42 - \u8282\u7701\u786c\u5e01\u6765\u8d2d\u4e70\u5fc5\u8981\u7684\u9053\u5177\uff0c\u4f8b\u5982\u62a4\u76fe\uff0c\u53ef\u4ee5\u4fdd\u62a4\u4f60\u514d\u53d7\u4e00\u6b21\u653b\u51fb\u3002\u6b65\u9aa43 - \u6e38\u620f\u521d\u671f\u907f\u514d\u5728\u975e\u5fc5\u8981\u9053\u5177\u4e0a\u82b1\u8d39\u786c\u5e01\u3002\u4f8b\u5982\uff0c\u57283\u5173\uff0c\u4f60\u5c06\u5728\u9677\u9631\u5e8f\u5217\u524d\u627e\u5230\u4e00\u5806\u786c\u5e01\u2014\u2014\u5728\u4fdd\u6301\u8b66\u60d5\u7684\u540c\u65f6\u4e13\u6ce8\u4e8e\u6536\u96c6\u5b83\u4eec\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u786c\u5e01\u4e0e\u9053\u5177\uff1a100\u4e2a\u786c\u5e01=1\u4e2a\u62a4\u76fe\uff0c500\u4e2a\u786c\u5e01=1\u4e2a\u52a0\u901f\u9053\u5177\u3002]"}, {"question": "\u300a\u8dd1\u9177\u80052048\u300b\u7684\u7b80\u5355\u6a21\u5f0f\u548c\u56f0\u96be\u6a21\u5f0f\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u300a\u8dd1\u9177\u80052048\u300b\u7684\u7b80\u5355\u6a21\u5f0f\u548c\u56f0\u96be\u6a21\u5f0f\u4e3b\u8981\u5b58\u5728\u4e09\u4e2a\u4e0d\u540c\u70b9\uff1a1) \u969c\u788d\u7269\u5bc6\u5ea6 - \u56f0\u96be\u6a21\u5f0f\u4e2d\u969c\u788d\u7269\u51fa\u73b0\u9891\u7387\u66f4\u9ad8\uff0c\u4e14\u66f4\u590d\u6742\u30022) \u901f\u5ea6 - \u56f0\u96be\u6a21\u5f0f\u4e2d\u8dd1\u9177\u8005\u7684\u79fb\u52a8\u901f\u5ea6\u66f4\u5feb\uff0c\u9700\u8981\u66f4\u5feb\u7684\u53cd\u5e94\u901f\u5ea6\u30023) \u5956\u52b1 - \u56f0\u96be\u6a21\u5f0f\u4e3a\u719f\u7ec3\u73a9\u5bb6\u63d0\u4f9b\u66f4\u9ad8\u7684\u786c\u5e01\u500d\u7387\u3002\u4f8b\u5982\uff0c\u5728\u56f0\u96be\u6a21\u5f0f\u4e2d\uff0c\u4f60\u53ef\u80fd\u4f1a\u9047\u5230\u5feb\u901f\u8fde\u7eed\u51fa\u73b0\u7684\u4e09\u4e2a\u969c\u788d\uff0c\u800c\u5728\u7b80\u5355\u6a21\u5f0f\u4e2d\uff0c\u8fd9\u4e9b\u969c\u788d\u4f1a\u95f4\u9694\u5f00\u6765\u3002[\u6d41\u7a0b\u56fe\u89e3: \u7b80\u5355\u6a21\u5f0f \u2192 \u8f83\u5c11\u969c\u788d\u7269 \u2192 \u8f83\u6162\u901f\u5ea6 \u2192 \u8f83\u4f4e\u5956\u52b1 | \u56f0\u96be\u6a21\u5f0f \u2192 \u66f4\u591a\u969c\u788d\u7269 \u2192 \u66f4\u5feb\u901f\u5ea6 \u2192 \u8f83\u9ad8\u5956\u52b1\u3002]"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u53ef\u4ee5\u5e2e\u52a9\u73a9\u5bb6\u5728\u300a\u8dd1\u9177\u80052048\u300b\u4e2d\u83b7\u5f97\u9ad8\u5206\uff1f", "answer": "\u5728\u300a\u8dd1\u9177\u80052048\u300b\u4e2d\u83b7\u5f97\u9ad8\u5206\u9700\u8981\u7ed3\u5408\u6280\u5de7\u548c\u7b56\u7565\uff1a\u6b65\u9aa41 - \u4e13\u6ce8\u4e8e\u4fdd\u6301\u7a33\u5b9a\u7684\u8282\u594f\uff0c\u907f\u514d\u6ed1\u52a8\u65f6\u673a\u5931\u8bef\u3002\u6b65\u9aa42 - \u6709\u7b56\u7565\u5730\u4f7f\u7528\u9053\u5177\uff0c\u4f8b\u5982\u78c1\u94c1\uff0c\u53ef\u4ee5\u8f7b\u677e\u6536\u96c6\u786c\u5e01\u3002\u6b65\u9aa43 - \u4e89\u53d6\u8fde\u51fb\uff0c\u6301\u7eed\u907f\u5f00\u969c\u788d\u7269\uff0c\u4e0d\u95f4\u65ad\u3002\u4f8b\u5982\uff0c\u5728\u7b2c5\u5173\uff0c\u6709\u4e00\u4e2a\u533a\u57df\u4f60\u53ef\u4ee5\u8fde\u7eed\u8df3\u8dc3\u8de8\u8d8a\u591a\u4e2a\u969c\u788d\uff0c\u83b7\u5f97\u9ad8\u8fde\u51fb\u5f97\u5206\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u7b56\u7565A - \u79ef\u6781\u6536\u96c6\u786c\u5e01 vs. \u7b56\u7565B - \u5b89\u5168\u907f\u5f00\u969c\u788d\u3002]"}, {"question": "\u300a\u8dd1\u9177\u80052048\u300b\u7684\u8bc4\u5206\u7cfb\u7edf\u5982\u4f55\u8ba1\u7b97\u5206\u6570\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u5b83\uff1f", "answer": "\u300a\u8dd1\u9177\u80052048\u300b\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u4e09\u4e2a\u56e0\u7d20\uff1a1) \u8ddd\u79bb - \u4f60\u8dd1\u5f97\u8d8a\u8fdc\uff0c\u5206\u6570\u8d8a\u9ad8\u30022) \u786c\u5e01 - \u6bcf\u6536\u96c6\u4e00\u679a\u786c\u5e01\u90fd\u4f1a\u589e\u52a0\u4f60\u7684\u603b\u5206\u30023) \u8fde\u51fb - \u8fde\u7eed\u907f\u5f00\u969c\u788d\u7269\u4f1a\u83b7\u5f97\u5206\u6570\u500d\u589e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u8dd1\u4e86500\u7c73\uff0c\u6536\u96c6\u4e8650\u4e2a\u786c\u5e01\uff0c\u5e76\u83b7\u5f97\u4e863\u500d\u7684\u8fde\u51fb\uff0c\u90a3\u4e48\u4f60\u7684\u5206\u6570\u5c06\u8ba1\u7b97\u4e3a(500 + 50) * 3 = 1650\u5206\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u8bc4\u5206\u7cfb\u7edf\u60f3\u8c61\u6210\u94f6\u884c\u8d26\u6237\u2014\u2014\u8ddd\u79bb\u662f\u4f60\u7684\u5b58\u6b3e\uff0c\u786c\u5e01\u662f\u4f60\u7684\u50a8\u84c4\uff0c\u800c\u8fde\u51fb\u5219\u662f\u5229\u606f\u3002]"}, {"question": "\u300a\u8dd1\u9177\u80052048\u300b\u4e2d\u54ea\u4e9b\u9ad8\u7ea7\u9053\u5177\u6700\u9002\u5408\u9ad8\u7ea7\u73a9\u5bb6\uff0c\u4ee5\u53ca\u8be5\u5982\u4f55\u5408\u7406\u4f7f\u7528\uff1f", "answer": "\u300a\u8dd1\u9177\u80052048\u300b\u4e2d\u7684\u9ad8\u7ea7\u73a9\u5bb6\u5e94\u8be5\u4f18\u5148\u8003\u8651\u8fd9\u4e9b\u9053\u5177\uff1a1) \u62a4\u76fe - \u5728\u8fdb\u5165\u9ad8\u98ce\u9669\u533a\u57df\u524d\u4f7f\u7528\u5b83\uff0c\u907f\u514d\u4e22\u5931\u8fdb\u5ea6\u30022) \u52a0\u901f\u9053\u5177 - \u5728\u76f4\u7ebf\u533a\u57df\u6fc0\u6d3b\u5b83\uff0c\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u8ddd\u79bb\u30023) \u78c1\u94c1 - \u5728\u786c\u5e01\u5bc6\u96c6\u533a\u57df\u90e8\u7f72\u5b83\u3002\u4f8b\u5982\uff0c\u5728\u7b2c7\u5173\uff0c\u5728\u7b2c\u4e00\u4e2a\u68c0\u67e5\u70b9\u540e\u7acb\u5373\u4f7f\u7528\u52a0\u901f\u9053\u5177\uff0c\u5feb\u901f\u8986\u76d6\u66f4\u591a\u5730\u9762\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u9053\u5177\u4f7f\u7528\u65f6\u673a - \u62a4\u76fe\uff1a\u5728\u9677\u9631\u524d | \u52a0\u901f\u9053\u5177\uff1a\u5f00\u9614\u533a\u57df | \u78c1\u94c1\uff1a\u786c\u5e01\u5bc6\u96c6\u533a\u3002]"}, {"question": "\u300a\u8dd1\u9177\u80052048\u300b\u4e2d\u7684\u8dd1\u9053\u5207\u6362\u673a\u5236\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u4f53\u9a8c\uff0c\u4ee5\u53ca\u5b83\u7684\u5c40\u9650\u6027\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u8dd1\u9177\u80052048\u300b\u4e2d\u7684\u8dd1\u9053\u5207\u6362\u673a\u5236\u5141\u8bb8\u73a9\u5bb6\u66f4\u6709\u6548\u5730\u8eb2\u907f\u969c\u788d\u7269\u548c\u6536\u96c6\u786c\u5e01\u3002\u7136\u800c\uff0c\u5b83\u4e5f\u5b58\u5728\u5c40\u9650\u6027\uff1a1) \u51b7\u5374\u65f6\u95f4 - \u5feb\u901f\u5207\u6362\u8dd1\u9053\u53ef\u80fd\u4f1a\u5bfc\u81f4\u6ed1\u52a8\u65f6\u673a\u5931\u8bef\u30022) \u969c\u788d\u7269\u4f4d\u7f6e - \u4e00\u4e9b\u969c\u788d\u7269\u6a2a\u8de8\u591a\u6761\u8dd1\u9053\uff0c\u9700\u8981\u8df3\u8dc3\u6216\u6ed1\u884c\uff0c\u800c\u4e0d\u662f\u5207\u6362\u8dd1\u9053\u3002\u4f8b\u5982\uff0c\u5728\u7b2c4\u5173\uff0c\u4f60\u5c06\u9047\u5230\u6a2a\u8de8\u4e24\u6761\u8dd1\u9053\u7684\u969c\u788d\uff0c\u8feb\u4f7f\u4f60\u8df3\u8dc3\u8fc7\u53bb\uff0c\u800c\u4e0d\u662f\u5207\u6362\u8dd1\u9053\u3002[\u6bd4\u55bb\u8bf4\u660e: \u8dd1\u9053\u5207\u6362\u5c31\u50cf\u5728\u4ea4\u901a\u4e2d\u5207\u6362\u8f66\u9053\u2014\u2014\u5b83\u5f88\u6709\u7528\uff0c\u4f46\u5e76\u975e\u603b\u80fd\u89e3\u51b3\u95ee\u9898\u3002]"}, {"question": "\u300a\u8dd1\u9177\u80052048\u300b\u7684\u6e38\u620f\u8fdb\u5ea6\u53ef\u4ee5\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u8f6c\u79fb\u5417\uff0c\u9700\u8981\u54ea\u4e9b\u6b65\u9aa4\uff1f", "answer": "\u662f\u7684\uff0c\u300a\u8dd1\u9177\u80052048\u300b\u7684\u6e38\u620f\u8fdb\u5ea6\u53ef\u4ee5\u901a\u8fc7\u5c06\u4f60\u7684\u8d26\u6237\u94fe\u63a5\u5230\u4e91\u670d\u52a1\uff08\u4f8b\u5982Google Play\u6216\u82f9\u679c\u6e38\u620f\u4e2d\u5fc3\uff09\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u8f6c\u79fb\u3002\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41 - \u6253\u5f00\u6e38\u620f\u8bbe\u7f6e\uff0c\u9009\u62e9\u201c\u4e91\u4fdd\u5b58\u201d\u9009\u9879\u3002\u6b65\u9aa42 - \u5728\u65b0\u8bbe\u5907\u4e0a\u4f7f\u7528\u4f60\u7684\u8d26\u6237\u51ed\u636e\u767b\u5f55\u3002\u6b65\u9aa43 - \u901a\u8fc7\u9009\u62e9\u201c\u8f7d\u5165\u6570\u636e\u201d\u6765\u540c\u6b65\u4f60\u7684\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4ece\u5b89\u5353\u624b\u673a\u5207\u6362\u5230\u82f9\u679c\u624b\u673a\uff0c\u4f60\u7684\u9ad8\u5206\u548c\u5df2\u89e3\u9501\u7684\u9053\u5177\u5c06\u968f\u4e4b\u8f6c\u79fb\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: Google Play vs. \u82f9\u679c\u6e38\u620f\u4e2d\u5fc3 - \u4e24\u79cd\u65b9\u6cd5\u90fd\u80fd\u5b9e\u73b0\u65e0\u7f1d\u8f6c\u79fb\uff0c\u4f46\u9700\u8981\u5404\u81ea\u7684\u8d26\u6237\u3002]"}, {"question": "\u300a\u8dd1\u9177\u80052048\u300b\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u6210\u5c31\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9501\u5b83\u4eec\uff1f", "answer": "\u300a\u8dd1\u9177\u80052048\u300b\u4e2d\u6709\u591a\u4e2a\u9690\u85cf\u6210\u5c31\uff0c\u4f8b\u5982\u201c\u5b8c\u7f8e\u8dd1\u9177\u201d\uff08\u5728\u4e0d\u78b0\u5230\u4efb\u4f55\u969c\u788d\u7269\u7684\u60c5\u51b5\u4e0b\u5b8c\u6210\u5173\u5361\uff09\u548c\u201c\u786c\u5e01\u6536\u96c6\u5bb6\u201d\uff08\u5728\u5355\u6b21\u8dd1\u9177\u4e2d\u6536\u96c61000\u679a\u786c\u5e01\uff09\u3002\u8981\u89e3\u9501\u8fd9\u4e9b\u6210\u5c31\uff0c\u4f60\u9700\u8981\u4e13\u6ce8\u4e8e\u638c\u63e1\u969c\u788d\u7269\u907f\u514d\u6280\u5de7\uff0c\u5e76\u4f18\u5316\u786c\u5e01\u6536\u96c6\u8def\u7ebf\u3002\u4f8b\u5982\uff0c\u5728\u7b2c6\u5173\uff0c\u6709\u4e00\u4e2a\u9690\u85cf\u8def\u5f84\uff0c\u6709\u989d\u5916\u7684\u786c\u5e01\u53ef\u4ee5\u5e2e\u52a9\u4f60\u8fbe\u6210\u201c\u786c\u5e01\u6536\u96c6\u5bb6\u201d\u6210\u5c31\u3002[\u6d41\u7a0b\u56fe\u89e3: \u9690\u85cf\u6210\u5c31\u8def\u5f84 - \u907f\u5f00\u969c\u788d\u7269 \u2192 \u6536\u96c6\u786c\u5e01 \u2192 \u5b8c\u6210\u5173\u5361 \u2192 \u89e3\u9501\u6210\u5c31\u3002]"}]
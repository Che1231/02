[{"question": "\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u5feb\u901f\u638c\u63e1\u4eba\u8dd1\u80052048\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1\u4eba\u8dd1\u80052048\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u8acb\u6309\u7167\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u719f\u6089\u6ed1\u52d5\u52d5\u4f5c\uff1a\u5411\u4e0a\u6ed1\u52d5\u8df3\u8e8d\uff0c\u5411\u4e0b\u6ed1\u52d5\u6ed1\u884c\uff0c\u5411\u5de6\u6216\u5411\u53f3\u6ed1\u52d5\u8b8a\u63db\u8dd1\u9053\u3002\u6b65\u9a5f2 - \u7df4\u7fd2\u6ed1\u52d5\u7684\u6642\u6a5f\u4ee5\u907f\u514d\u969c\u7919\u7269\uff0c\u4f8b\u5982\u969c\u7919\u548c\u9677\u9631\u3002\u6b65\u9a5f3 - \u4f7f\u7528\u6559\u5b78\u6a21\u5f0f\uff0c\u5728\u6c92\u6709\u61f2\u7f70\u7684\u60c5\u6cc1\u4e0b\u7372\u5f97\u5be6\u969b\u64cd\u4f5c\u7d93\u9a57\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u95dc\uff0c\u60a8\u6703\u9047\u5230\u4e00\u500b\u9700\u8981\u5411\u4e0a\u6ed1\u52d5\u8df3\u904e\u7684\u5c0f\u969c\u7919\u3002\u8acb\u8a18\u4f4f\uff0c\u6301\u7e8c\u7684\u7df4\u7fd2\u5c07\u63d0\u9ad8\u60a8\u7684\u53cd\u61c9\u901f\u5ea6\u548c\u63a7\u5236\u7cbe\u78ba\u5ea6\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u64cd\u4f5c\u60f3\u50cf\u6210\u958b\u8eca\u4e00\u6a23\uff0c\u5e73\u7a69\u4e14\u6709\u76ee\u7684\u7684\u52d5\u4f5c\u624d\u80fd\u7372\u5f97\u6700\u4f73\u7d50\u679c\u3002]"}, {"question": "\u5728\u4eba\u8dd1\u80052048\u4e2d\u6536\u96c6\u786c\u5e63\u6709\u4ec0\u9ebc\u91cd\u8981\u6027\uff0c\u4ee5\u53ca\u5982\u4f55\u6709\u6548\u5730\u4f7f\u7528\u5b83\u5011\uff1f", "answer": "\u5728\u4eba\u8dd1\u80052048\u4e2d\uff0c\u786c\u5e63\u5c0d\u65bc\u89e3\u9396\u80fd\u529b\u63d0\u5347\u548c\u5ba2\u88fd\u5316\u89d2\u8272\u81f3\u95dc\u91cd\u8981\u3002\u4ee5\u4e0b\u662f\u5982\u4f55\u6709\u6548\u5730\u4f7f\u7528\u5b83\u5011\uff1a\u6b65\u9a5f1 - \u5728\u8dd1\u6b65\u904e\u7a0b\u4e2d\u512a\u5148\u6536\u96c6\u786c\u5e63\uff0c\u5c24\u5176\u662f\u5728\u969c\u7919\u7269\u8f03\u5c11\u7684\u5340\u57df\u3002\u6b65\u9a5f2 - \u5b58\u5920\u786c\u5e63\u4f86\u8cfc\u8cb7\u5fc5\u8981\u7684\u589e\u5f37\u80fd\u529b\uff0c\u4f8b\u5982\u8b77\u76fe\uff0c\u53ef\u4fdd\u8b77\u60a8\u514d\u53d7\u4e00\u6b21\u649e\u64ca\u3002\u6b65\u9a5f3 - \u5728\u904a\u6232\u521d\u671f\u907f\u514d\u82b1\u8cbb\u786c\u5e63\u5728\u7f8e\u5316\u7269\u54c1\u4e0a\u3002\u4f8b\u5982\uff0c\u5728\u7b2c3\u95dc\uff0c\u60a8\u6703\u5728\u9677\u9631\u5e8f\u5217\u4e4b\u524d\u627e\u5230\u4e00\u7d44\u786c\u5e63\u2014\u2014\u5c08\u6ce8\u65bc\u5728\u4fdd\u6301\u8b66\u89ba\u7684\u540c\u6642\u64bf\u8d77\u5b83\u5011\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u786c\u5e63 vs. \u589e\u5f37\u80fd\u529b\uff1a100\u500b\u786c\u5e63 = 1\u500b\u8b77\u76fe\uff0c500\u500b\u786c\u5e63 = 1\u500b\u52a0\u901f\u589e\u5f37\u3002]"}, {"question": "\u4eba\u8dd1\u80052048\u7684\u7c21\u55ae\u6a21\u5f0f\u548c\u56f0\u96e3\u6a21\u5f0f\u6709\u4ec0\u9ebc\u4e3b\u8981\u5340\u5225\uff1f", "answer": "\u4eba\u8dd1\u80052048\u7684\u7c21\u55ae\u6a21\u5f0f\u548c\u56f0\u96e3\u6a21\u5f0f\u5728\u4e09\u65b9\u9762\u6709\u6240\u4e0d\u540c\uff1a1) \u969c\u7919\u5bc6\u5ea6 - \u56f0\u96e3\u6a21\u5f0f\u5305\u542b\u66f4\u591a\u983b\u7e41\u4e14\u8907\u96dc\u7684\u969c\u7919\u7269\u30022) \u901f\u5ea6 - \u8dd1\u6b65\u8005\u7684\u79fb\u52d5\u901f\u5ea6\u5728\u56f0\u96e3\u6a21\u5f0f\u4e0b\u66f4\u5feb\uff0c\u9700\u8981\u66f4\u5feb\u7684\u53cd\u61c9\u30023) \u734e\u52f5 - \u56f0\u96e3\u6a21\u5f0f\u70ba\u719f\u7df4\u7684\u73a9\u5bb6\u63d0\u4f9b\u66f4\u9ad8\u7684\u786c\u5e63\u500d\u6578\u3002\u4f8b\u5982\uff0c\u5728\u56f0\u96e3\u6a21\u5f0f\u4e0b\uff0c\u60a8\u53ef\u80fd\u6703\u9047\u5230\u5feb\u901f\u9023\u7e8c\u51fa\u73fe\u7684\u4e09\u500b\u969c\u7919\u7269\uff0c\u800c\u5728\u7c21\u55ae\u6a21\u5f0f\u4e0b\u6703\u5c07\u5b83\u5011\u5206\u6563\u958b\u4f86\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u7c21\u55ae\u6a21\u5f0f \u2192 \u8f03\u5c11\u969c\u7919\u7269 \u2192 \u8f03\u6162\u901f\u5ea6 \u2192 \u8f03\u4f4e\u734e\u52f5 | \u56f0\u96e3\u6a21\u5f0f \u2192 \u66f4\u591a\u969c\u7919\u7269 \u2192 \u66f4\u5feb\u901f\u5ea6 \u2192 \u66f4\u9ad8\u734e\u52f5\u3002]"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u53ef\u4ee5\u5e6b\u52a9\u73a9\u5bb6\u5728\u4eba\u8dd1\u80052048\u4e2d\u7372\u5f97\u9ad8\u5206\uff1f", "answer": "\u5728\u4eba\u8dd1\u80052048\u4e2d\u53d6\u5f97\u9ad8\u5206\u9700\u8981\u6280\u5de7\u548c\u7b56\u7565\u7684\u7d50\u5408\uff1a\u6b65\u9a5f1 - \u5c08\u6ce8\u65bc\u4fdd\u6301\u7a69\u5b9a\u7684\u7bc0\u594f\uff0c\u4ee5\u907f\u514d\u6ed1\u52d5\u6642\u9593\u9ede\u932f\u8aa4\u3002\u6b65\u9a5f2 - \u6709\u7b56\u7565\u5730\u4f7f\u7528\u589e\u5f37\u80fd\u529b\uff0c\u4f8b\u5982\u78c1\u9435\uff0c\u4ee5\u4fbf\u8f15\u9b06\u6536\u96c6\u786c\u5e63\u3002\u6b65\u9a5f3 - \u5617\u8a66\u9023\u9396\u52d5\u4f5c\uff0c\u4e0d\u65b7\u907f\u958b\u969c\u7919\u7269\uff0c\u4e0d\u9593\u65b7\u3002\u4f8b\u5982\uff0c\u5728\u7b2c5\u95dc\uff0c\u6709\u4e00\u500b\u5340\u57df\u60a8\u53ef\u4ee5\u9023\u7e8c\u8df3\u904e\u591a\u500b\u969c\u7919\u7269\u4ee5\u7372\u5f97\u9ad8\u9023\u9396\u5206\u6578\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u7b56\u7565A - \u7a4d\u6975\u6536\u96c6\u786c\u5e63 vs. \u7b56\u7565B - \u5b89\u5168\u907f\u958b\u969c\u7919\u3002]"}, {"question": "\u4eba\u8dd1\u80052048\u7684\u8a08\u5206\u7cfb\u7d71\u5982\u4f55\u8a08\u7b97\u5206\u6578\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u5b83\uff1f", "answer": "\u4eba\u8dd1\u80052048\u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u4e09\u500b\u56e0\u7d20\uff1a1) \u8ddd\u96e2 - \u60a8\u8dd1\u5f97\u8d8a\u9060\uff0c\u5206\u6578\u8d8a\u9ad8\u30022) \u786c\u5e63 - \u6bcf\u6536\u96c6\u4e00\u679a\u786c\u5e63\u90fd\u6703\u589e\u52a0\u7e3d\u5206\u6578\u30023) \u9023\u9396\u52d5\u4f5c - \u9023\u7e8c\u907f\u958b\u969c\u7919\u7269\u6703\u5c07\u60a8\u7684\u5206\u6578\u4e58\u4ee5\u500d\u6578\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u8dd1\u4e86500\u7c73\uff0c\u6536\u96c6\u4e8650\u679a\u786c\u5e63\uff0c\u4e26\u53d6\u5f97\u4e863\u500d\u7684\u9023\u9396\u52d5\u4f5c\uff0c\u60a8\u7684\u5206\u6578\u5c07\u8a08\u7b97\u70ba (500 + 50) * 3 = 1650 \u5206\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u8a08\u5206\u7cfb\u7d71\u60f3\u50cf\u6210\u9280\u884c\u5e33\u6236\u4e00\u6a23\u2014\u2014\u8ddd\u96e2\u662f\u60a8\u7684\u5b58\u6b3e\uff0c\u786c\u5e63\u662f\u5132\u84c4\uff0c\u800c\u9023\u9396\u52d5\u4f5c\u662f\u5229\u606f\u3002]"}, {"question": "\u5728\u4eba\u8dd1\u80052048\u4e2d\uff0c\u54ea\u4e9b\u589e\u5f37\u80fd\u529b\u6700\u9069\u5408\u9032\u968e\u73a9\u5bb6\uff0c\u4ee5\u53ca\u5982\u4f55\u6b63\u78ba\u4f7f\u7528\u5b83\u5011\u7684\u6642\u9593\uff1f", "answer": "\u5728\u4eba\u8dd1\u80052048\u4e2d\uff0c\u9032\u968e\u73a9\u5bb6\u61c9\u8a72\u512a\u5148\u8003\u616e\u4ee5\u4e0b\u589e\u5f37\u80fd\u529b\uff1a1) \u8b77\u76fe - \u5728\u9032\u5165\u9ad8\u98a8\u96aa\u5340\u57df\u4e4b\u524d\u4f7f\u7528\u5b83\uff0c\u4ee5\u907f\u514d\u4e1f\u5931\u9032\u5ea6\u30022) \u52a0\u901f\u589e\u5f37 - \u5728\u76f4\u7dda\u5340\u57df\u555f\u52d5\u5b83\u53ef\u4ee5\u6700\u5927\u5316\u8ddd\u96e2\u30023) \u78c1\u9435 - \u5728\u786c\u5e63\u5bc6\u96c6\u5340\u57df\u90e8\u7f72\u5b83\u3002\u4f8b\u5982\uff0c\u5728\u7b2c7\u95dc\uff0c\u5728\u7b2c\u4e00\u500b\u6aa2\u67e5\u9ede\u5f8c\u7acb\u5373\u4f7f\u7528\u52a0\u901f\u589e\u5f37\uff0c\u5feb\u901f\u8986\u84cb\u66f4\u591a\u5730\u9762\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u589e\u5f37\u80fd\u529b\u4f7f\u7528\u6642\u9593 - \u8b77\u76fe\uff1a\u5728\u9677\u9631\u524d | \u52a0\u901f\u589e\u5f37\uff1a\u5728\u7a7a\u66e0\u5340\u57df | \u78c1\u9435\uff1a\u5728\u786c\u5e63\u5bc6\u96c6\u8655\u3002]"}, {"question": "\u4eba\u8dd1\u80052048\u4e2d\u7684\u8dd1\u9053\u8b8a\u66f4\u6a5f\u5236\u5982\u4f55\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff0c\u4ee5\u53ca\u5176\u9650\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "\u4eba\u8dd1\u80052048\u4e2d\u7684\u8dd1\u9053\u8b8a\u66f4\u6a5f\u5236\u4f7f\u73a9\u5bb6\u80fd\u5920\u66f4\u6709\u6548\u5730\u8eb2\u907f\u969c\u7919\u7269\u548c\u6536\u96c6\u786c\u5e63\u3002\u4f46\u662f\uff0c\u5b83\u6709\u4ee5\u4e0b\u9650\u5236\uff1a1) \u51b7\u537b\u6642\u9593 - \u5feb\u901f\u8b8a\u66f4\u8dd1\u9053\u53ef\u80fd\u6703\u5c0e\u81f4\u64cd\u4f5c\u6642\u9593\u9ede\u932f\u8aa4\u30022) \u969c\u7919\u7269\u64fa\u653e - \u4e00\u4e9b\u969c\u7919\u7269\u6a6b\u8de8\u591a\u500b\u8dd1\u9053\uff0c\u9700\u8981\u8df3\u8e8d\u6216\u6ed1\u884c\uff0c\u800c\u4e0d\u662f\u8b8a\u66f4\u8dd1\u9053\u3002\u4f8b\u5982\uff0c\u5728\u7b2c4\u95dc\uff0c\u60a8\u6703\u9047\u5230\u6a6b\u8de8\u5169\u500b\u8dd1\u9053\u7684\u969c\u7919\u7269\uff0c\u8feb\u4f7f\u60a8\u8df3\u904e\u5b83\uff0c\u800c\u4e0d\u662f\u8b8a\u66f4\u8dd1\u9053\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u8b8a\u66f4\u8dd1\u9053\u5c31\u50cf\u5728\u4ea4\u901a\u4e2d\u8b8a\u63db\u8eca\u9053\u4e00\u6a23\u2014\u2014\u5b83\u6709\u7528\uff0c\u4f46\u4e26\u975e\u7e3d\u662f\u89e3\u6c7a\u65b9\u6848\u3002]"}, {"question": "\u4eba\u8dd1\u80052048\u7684\u904a\u6232\u9032\u5ea6\u53ef\u4ee5\u5728\u4e0d\u540c\u88dd\u7f6e\u4e4b\u9593\u8f49\u79fb\u55ce\uff1f\u5982\u679c\u53ef\u4ee5\uff0c\u6b65\u9a5f\u70ba\u4f55\uff1f", "answer": "\u662f\u7684\uff0c\u4eba\u8dd1\u80052048\u7684\u904a\u6232\u9032\u5ea6\u53ef\u4ee5\u900f\u904e\u5c07\u60a8\u7684\u5e33\u6236\u9023\u7d50\u5230\u96f2\u7aef\u670d\u52d9\uff08\u4f8b\u5982Google Play \u6216 Apple Game Center\uff09\u5728\u4e0d\u540c\u88dd\u7f6e\u4e4b\u9593\u8f49\u79fb\u3002\u8acb\u6309\u7167\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u958b\u555f\u904a\u6232\u8a2d\u5b9a\uff0c\u4e26\u9078\u64c7\u300c\u96f2\u7aef\u5132\u5b58\u300d\u9078\u9805\u3002\u6b65\u9a5f2 - \u5728\u65b0\u88dd\u7f6e\u4e0a\u4f7f\u7528\u60a8\u7684\u5e33\u6236\u6191\u8b49\u767b\u5165\u3002\u6b65\u9a5f3 - \u9078\u64c7\u300c\u8f09\u5165\u8cc7\u6599\u300d\u4f86\u540c\u6b65\u60a8\u7684\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9e Android \u624b\u6a5f\u5207\u63db\u5230 iPhone\uff0c\u60a8\u7684\u9ad8\u5206\u548c\u89e3\u9396\u7684\u589e\u5f37\u80fd\u529b\u5c07\u6703\u7e7c\u7e8c\u4fdd\u7559\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1aGoogle Play vs. Apple Game Center - \u5169\u8005\u90fd\u63d0\u4f9b\u7121\u7e2b\u8f49\u79fb\uff0c\u4f46\u9700\u8981\u5404\u81ea\u7684\u5e33\u6236\u3002]"}, {"question": "\u4eba\u8dd1\u80052048\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u6210\u5c31\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9396\u5b83\u5011\uff1f", "answer": "\u4eba\u8dd1\u80052048\u4e2d\u6709\u5e7e\u500b\u96b1\u85cf\u6210\u5c31\uff0c\u4f8b\u5982\u300c\u5b8c\u7f8e\u5954\u8dd1\u300d\uff08\u5728\u4e0d\u78b0\u5230\u4efb\u4f55\u969c\u7919\u7269\u7684\u60c5\u6cc1\u4e0b\u5b8c\u6210\u4e00\u95dc\uff09\u548c\u300c\u786c\u5e63\u6536\u96c6\u8005\u300d\uff08\u5728\u55ae\u6b21\u8dd1\u6b65\u4e2d\u6536\u96c6 1,000 \u679a\u786c\u5e63\uff09\u3002\u70ba\u4e86\u89e3\u9396\u9019\u4e9b\u6210\u5c31\uff0c\u8acb\u5c08\u6ce8\u65bc\u638c\u63e1\u969c\u7919\u7269\u7684\u8ff4\u907f\u6280\u5de7\u548c\u6700\u4f73\u5316\u786c\u5e63\u6536\u96c6\u8def\u7dda\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 6 \u95dc\uff0c\u6709\u4e00\u500b\u96b1\u85cf\u8def\u5f91\uff0c\u6709\u984d\u5916\u786c\u5e63\u53ef\u4ee5\u5e6b\u52a9\u60a8\u9054\u6210\u300c\u786c\u5e63\u6536\u96c6\u8005\u300d\u6210\u5c31\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u96b1\u85cf\u6210\u5c31\u8def\u5f91 - \u907f\u958b\u969c\u7919\u7269 \u2192 \u6536\u96c6\u786c\u5e63 \u2192 \u5b8c\u6210\u95dc\u5361 \u2192 \u89e3\u9396\u6210\u5c31\u3002]"}]
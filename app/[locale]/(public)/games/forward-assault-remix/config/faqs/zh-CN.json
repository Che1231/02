[{"question": "\u5982\u4f55\u5728\u300a\u524d\u8fdb\u7a81\u51fbRemix\u300b\u4e2d\u81ea\u5b9a\u4e49\u63a7\u5236\u8bbe\u7f6e\u6765\u63d0\u5347\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u5728\u300a\u524d\u8fdb\u7a81\u51fbRemix\u300b\u4e2d\u81ea\u5b9a\u4e49\u63a7\u5236\u8bbe\u7f6e\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u6e38\u620f\u8868\u73b0\u3002\u9996\u5148\uff0c\u524d\u5f80\u8bbe\u7f6e\u83dc\u5355\uff0c\u9009\u62e9\u201c\u63a7\u5236\u201d\u3002\u5728\u8fd9\u91cc\uff0c\u4f60\u53ef\u4ee5\u8c03\u6574\u5e03\u5c40\u4ee5\u9002\u5e94\u4f60\u7684\u6e38\u620f\u98ce\u683c\u3002\u4f8b\u5982\uff0c\u5c06\u5c04\u51fb\u6309\u94ae\u79fb\u52a8\u5230\u62c7\u6307\u9644\u8fd1\u53ef\u4ee5\u7f29\u77ed\u53cd\u5e94\u65f6\u95f4\u3002\u6b64\u5916\uff0c\u8fd8\u53ef\u4ee5\u63d0\u9ad8\u7075\u654f\u5ea6\u4ee5\u52a0\u5feb\u7784\u51c6\u901f\u5ea6\u3002\u4e00\u4e2a\u597d\u7684\u65b9\u6cd5\u662f\u5728\u7ec3\u4e60\u6a21\u5f0f\u4e2d\u6d4b\u8bd5\u4e0d\u540c\u7684\u914d\u7f6e\uff0c\u770b\u770b\u54ea\u79cd\u611f\u89c9\u6700\u8212\u9002\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u60f3\u8c61\u4e00\u4e0b\uff0c\u5c31\u50cf\u8c03\u6574\u6c7d\u8f66\u7684\u5ea7\u6905\u548c\u540e\u89c6\u955c\u4ee5\u83b7\u5f97\u66f4\u597d\u7684\u9a7e\u9a76\u4f53\u9a8c\u4e00\u6837\u3002]"}, {"question": "\u5728\u300a\u524d\u8fdb\u7a81\u51fbRemix\u300b\u7684\u56e2\u961f\u6a21\u5f0f\u4e2d\uff0c\u54ea\u4e9b\u7b56\u7565\u6700\u9002\u5408\u8d62\u5f97\u6bd4\u8d5b\uff1f", "answer": "\u5728\u300a\u524d\u8fdb\u7a81\u51fbRemix\u300b\u7684\u56e2\u961f\u6a21\u5f0f\u4e2d\u8d62\u5f97\u6bd4\u8d5b\u9700\u8981\u7b56\u7565\u548c\u56e2\u961f\u5408\u4f5c\u3002\u6b65\u9aa4\u4e00\uff1a\u901a\u8fc7\u6e38\u620f\u5185\u804a\u5929\u6216\u8bed\u97f3\u4e0e\u4f60\u7684\u961f\u53cb\u6c9f\u901a\u534f\u8c03\u653b\u51fb\u3002\u6b65\u9aa4\u4e8c\uff1a\u5206\u914d\u72d9\u51fb\u624b\u3001\u7a81\u51fb\u624b\u548c\u652f\u63f4\u7b49\u89d2\u8272\u4ee5\u5e73\u8861\u56e2\u961f\u5b9e\u529b\u3002\u6b65\u9aa4\u4e09\uff1a\u4e13\u6ce8\u4e8e\u63a7\u5236\u5730\u56fe\u7684\u5173\u952e\u533a\u57df\u4ee5\u9650\u5236\u654c\u4eba\u7684\u884c\u52a8\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5de5\u5382\u201d\u5730\u56fe\u4e2d\uff0c\u63a7\u5236\u4e2d\u592e\u4ed3\u5e93\u53ef\u4ee5\u83b7\u5f97\u6218\u7565\u4f18\u52bf\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u867d\u7136\u6fc0\u8fdb\u7684\u73a9\u5bb6\u53ef\u80fd\u66f4\u559c\u6b22\u51b2\u950b\uff0c\u4f46\u5747\u8861\u7684\u65b9\u6cd5\u901a\u5e38\u4f1a\u53d6\u5f97\u66f4\u597d\u7684\u6548\u679c\u3002]"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u7684\u300a\u524d\u8fdb\u7a81\u51fbRemix\u300b\u6e38\u620f\u4f1a\u5ef6\u8fdf\uff0c\u8be5\u5982\u4f55\u89e3\u51b3\uff1f", "answer": "\u300a\u524d\u8fdb\u7a81\u51fbRemix\u300b\u6e38\u620f\u5ef6\u8fdf\u53ef\u80fd\u7531\u591a\u79cd\u56e0\u7d20\u5bfc\u81f4\u3002\u9996\u5148\uff0c\u68c0\u67e5\u4f60\u7684\u4e92\u8054\u7f51\u8fde\u63a5\uff1b\u7a33\u5b9a\u7684Wi-Fi\u6216\u79fb\u52a8\u6570\u636e\u8fde\u63a5\u81f3\u5173\u91cd\u8981\u3002\u5176\u6b21\uff0c\u964d\u4f4e\u6e38\u620f\u5185\u7684\u56fe\u5f62\u8bbe\u7f6e\u4ee5\u51cf\u5c11\u8bbe\u5907\u8d1f\u8f7d\u3002\u4f8b\u5982\uff0c\u5c06\u7eb9\u7406\u8d28\u91cf\u8bbe\u7f6e\u4e3a\u201c\u4f4e\u201d\u53ef\u4ee5\u63d0\u9ad8\u6027\u80fd\u3002\u6700\u540e\uff0c\u5173\u95ed\u540e\u53f0\u5e94\u7528\u4ee5\u91ca\u653e\u5185\u5b58\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u9ad8\u753b\u8d28 = \u5ef6\u8fdf\u5927\uff0c\u4f4e\u753b\u8d28 = \u6e38\u620f\u66f4\u6d41\u7545]\u5982\u679c\u95ee\u9898\u4ecd\u7136\u5b58\u5728\uff0c\u8bf7\u8003\u8651\u66f4\u65b0\u8bbe\u5907\u7684\u7cfb\u7edf\u548c\u6e38\u620f\u672c\u8eab\u3002"}, {"question": "\u5728\u300a\u524d\u8fdb\u7a81\u51fbRemix\u300b\u4e2d\uff0c\u4e0d\u540c\u89d2\u8272\u6700\u6709\u6548\u7684\u6b66\u5668\u6709\u54ea\u4e9b\uff1f", "answer": "\u5728\u300a\u524d\u8fdb\u7a81\u51fbRemix\u300b\u4e2d\uff0c\u9009\u62e9\u5408\u9002\u7684\u6b66\u5668\u53d6\u51b3\u4e8e\u4f60\u7684\u89d2\u8272\u3002\u72d9\u51fb\u624b\u5e94\u8be5\u9009\u62e9AWM\uff0c\u56e0\u4e3a\u5b83\u5177\u6709\u9ad8\u4f24\u5bb3\u548c\u5c04\u7a0b\u3002\u7a81\u51fb\u624b\u53ef\u4ee5\u4f7f\u7528AK-47\uff0c\u56e0\u4e3a\u5176\u706b\u529b\u548c\u51c6\u786e\u6027\u90fd\u6bd4\u8f83\u5747\u8861\u3002\u652f\u63f4\u89d2\u8272\u53ef\u4ee5\u4f7f\u7528M249\uff0c\u56e0\u4e3a\u5b83\u62e5\u6709\u9ad8\u5f39\u5323\u5bb9\u91cf\uff0c\u975e\u5e38\u9002\u5408\u538b\u5236\u706b\u529b\u3002\u4f8b\u5982\uff0c\u5728\u56e2\u961f\u6a21\u5f0f\u4e2d\uff0c\u4f7f\u7528AWM\u7684\u72d9\u51fb\u624b\u53ef\u4ee5\u6709\u6548\u5730\u51fb\u6740\u8fdc\u8ddd\u79bb\u7684\u654c\u4eba\uff0c\u800c\u7a81\u51fb\u624b\u5219\u4f1a\u5411\u524d\u63a8\u8fdb\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u53ef\u4ee5\u628a\u5b83\u60f3\u8c61\u6210\u7ec4\u88c5\u5de5\u5177\u7bb1\uff0c\u6bcf\u79cd\u5de5\u5177\u90fd\u6709\u7279\u5b9a\u7684\u7528\u9014\u3002]"}, {"question": "\u5982\u4f55\u5728\u300a\u524d\u8fdb\u7a81\u51fbRemix\u300b\u4e2d\u89e3\u9501\u9690\u85cf\u76ae\u80a4\uff1f", "answer": "\u5728\u300a\u524d\u8fdb\u7a81\u51fbRemix\u300b\u4e2d\u89e3\u9501\u9690\u85cf\u76ae\u80a4\u901a\u5e38\u9700\u8981\u5b8c\u6210\u7279\u5b9a\u6311\u6218\u3002\u4f8b\u5982\uff0cAK-47\u7684\u201c\u6697\u5f71\u201d\u76ae\u80a4\u53ef\u4ee5\u901a\u8fc7\u5728\u6392\u4f4d\u8d5b\u4e2d\u83b7\u5f97100\u6b21\u7206\u5934\u6765\u89e3\u9501\u3002\u53e6\u4e00\u79cd\u65b9\u6cd5\u662f\u53c2\u4e0e\u5b63\u8282\u6027\u6d3b\u52a8\uff0c\u6709\u65f6\u4f1a\u4ee5\u5956\u52b1\u7684\u5f62\u5f0f\u63d0\u4f9b\u72ec\u5bb6\u76ae\u80a4\u3002\u8bf7\u5bc6\u5207\u5173\u6ce8\u6e38\u620f\u516c\u544a\u548c\u6d3b\u52a8\u65e5\u5386\u4ee5\u83b7\u53d6\u8fd9\u4e9b\u673a\u4f1a\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u5b8c\u6210\u6311\u6218 \u2192 \u8d5a\u53d6\u79ef\u5206 \u2192 \u89e3\u9501\u76ae\u80a4]\u6b64\u5916\uff0c\u4e00\u4e9b\u76ae\u80a4\u53ef\u4ee5\u901a\u8fc7\u5728\u5e38\u89c4\u6e38\u620f\u73a9\u6cd5\u4e2d\u83b7\u5f97\u7684\u6e38\u620f\u5185\u8d27\u5e01\u6765\u8d2d\u4e70\u3002"}, {"question": "\u300a\u524d\u8fdb\u7a81\u51fbRemix\u300b\u4e0e\u5176\u524d\u4f5c\u6709\u54ea\u4e9b\u5173\u952e\u533a\u522b\uff1f", "answer": "\u300a\u524d\u8fdb\u7a81\u51fbRemix\u300b\u5728\u4e4b\u524d\u7684\u7248\u672c\u4e0a\u8fdb\u884c\u4e86\u591a\u9879\u6539\u8fdb\u3002\u56fe\u5f62\u5f97\u5230\u4e86\u663e\u8457\u63d0\u5347\uff0c\u63d0\u4f9b\u4e86\u66f4\u8be6\u7ec6\u7684\u73af\u5883\u548c\u89d2\u8272\u6a21\u578b\u3002\u6e38\u620f\u8fd8\u65b0\u589e\u4e86\u201c\u57ce\u5e02\u7a81\u51fb\u201d\u548c\u201c\u6c99\u6f20\u98ce\u66b4\u201d\u7b49\u5730\u56fe\uff0c\u63d0\u4f9b\u4e86\u65b0\u7684\u6218\u672f\u673a\u4f1a\u3002\u6b64\u5916\uff0c\u6b66\u5668\u81ea\u5b9a\u4e49\u9009\u9879\u4e5f\u5f97\u5230\u4e86\u6269\u5c55\uff0c\u5141\u8bb8\u8fdb\u884c\u66f4\u591a\u4e2a\u6027\u5316\u7684\u914d\u7f6e\u3002\u4f8b\u5982\uff0c\u4f60\u73b0\u5728\u53ef\u4ee5\u5c06\u5404\u79cd\u7784\u51c6\u955c\u548c\u63e1\u628a\u9644\u52a0\u5230\u4f60\u7684\u6b66\u5668\u4e0a\uff0c\u4ee5\u589e\u5f3a\u5b83\u4eec\u5728\u4e0d\u540c\u573a\u666f\u4e0b\u7684\u6027\u80fd\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u867d\u7136\u539f\u59cb\u7248\u672c\u4e3b\u8981\u4e13\u6ce8\u4e8e\u57fa\u7840\u673a\u5236\uff0c\u300aRemix\u300b\u7248\u672c\u5219\u63d0\u4f9b\u4e86\u66f4\u5177\u6c89\u6d78\u611f\u548c\u53ef\u5b9a\u5236\u6027\u7684\u4f53\u9a8c\u3002]"}, {"question": "\u5982\u4f55\u63d0\u9ad8\u6211\u5728\u300a\u524d\u8fdb\u7a81\u51fbRemix\u300b\u4e2d\u7684\u7784\u51c6\u80fd\u529b\uff1f", "answer": "\u63d0\u9ad8\u4f60\u5728\u300a\u524d\u8fdb\u7a81\u51fbRemix\u300b\u4e2d\u7684\u7784\u51c6\u80fd\u529b\u9700\u8981\u7ec3\u4e60\u548c\u5408\u9002\u7684\u8bbe\u7f6e\u3002\u9996\u5148\uff0c\u8c03\u6574\u4f60\u7684\u7075\u654f\u5ea6\u8bbe\u7f6e\uff1b\u8f83\u4f4e\u7684\u7075\u654f\u5ea6\u53ef\u4ee5\u5e2e\u52a9\u4f60\u8fdb\u884c\u7cbe\u786e\u7784\u51c6\u3002\u5176\u6b21\uff0c\u4f7f\u7528\u8bad\u7ec3\u6a21\u5f0f\u7ec3\u4e60\u5c04\u51fb\u79fb\u52a8\u76ee\u6807\u3002\u4f8b\u5982\uff0c\u6bcf\u5929\u82b110\u5206\u949f\u5728\u201c\u9776\u573a\u201d\u6a21\u5f0f\u4e2d\u78e8\u7ec3\u4f60\u7684\u6280\u5de7\u3002\u7b2c\u4e09\uff0c\u5b66\u4e60\u63a7\u5236\u540e\u5750\u529b\u901a\u8fc7\u77ed\u4fc3\u5c04\u51fb\u800c\u4e0d\u662f\u8fde\u7eed\u6309\u4f4f\u6273\u673a\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u53ef\u4ee5\u628a\u5b83\u60f3\u8c61\u6210\u5b66\u4e60\u6f14\u594f\u4e50\u5668\uff1b\u6301\u7eed\u7ec3\u4e60\u624d\u80fd\u7cbe\u901a\u3002]"}, {"question": "\u5728\u300a\u524d\u8fdb\u7a81\u51fbRemix\u300b\u4e2d\uff0c\u54ea\u4e9b\u5730\u56fe\u6700\u9002\u5408\u72d9\u51fb\uff1f", "answer": "\u300a\u524d\u8fdb\u7a81\u51fbRemix\u300b\u4e2d\u67d0\u4e9b\u5730\u56fe\u7531\u4e8e\u5176\u8f83\u957f\u7684\u89c6\u7ebf\u548c\u6218\u7565\u5236\u9ad8\u70b9\u800c\u975e\u5e38\u9002\u5408\u72d9\u51fb\u3002 \u201c\u5de5\u5382\u201d\u662f\u4e00\u4e2a\u70ed\u95e8\u9009\u62e9\uff0c\u5176\u4e2d\u592e\u4ed3\u5e93\u63d0\u4f9b\u4e86\u5bf9\u5173\u952e\u533a\u57df\u7684\u6e05\u6670\u89c6\u91ce\u3002\u201c\u57ce\u5e02\u7a81\u51fb\u201d\u4e5f\u63d0\u4f9b\u4e86\u4f18\u79c0\u7684\u72d9\u51fb\u70b9\uff0c\u7279\u522b\u662f\u4fef\u77b0\u4e3b\u8981\u901a\u9053\u7684\u5c4b\u9876\u3002\u4f8b\u5982\uff0c\u5728\u201c\u57ce\u5e02\u7a81\u51fb\u201d\u4e2d\uff0c\u5360\u636e\u5c4b\u9876\u4f4d\u7f6e\u53ef\u4ee5\u8ba9\u4f60\u5728\u654c\u4eba\u8bd5\u56fe\u7a7f\u8fc7\u5f00\u653e\u533a\u57df\u65f6\u7cbe\u51c6\u51fb\u6740\u4ed6\u4eec\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u5de5\u5382 = \u4e2d\u592e\u5236\u9ad8\u70b9\uff0c\u57ce\u5e02\u7a81\u51fb = \u9ad8\u5904\u4f4d\u7f6e]\u59cb\u7ec8\u8bb0\u4f4f\u4fdd\u6301\u79fb\u52a8\u4ee5\u907f\u514d\u6210\u4e3a\u654c\u4eba\u72d9\u51fb\u624b\u7684\u6613\u653b\u51fb\u76ee\u6807\u3002"}, {"question": "\u6211\u80fd\u5426\u5c06\u6211\u7684\u300a\u524d\u8fdb\u7a81\u51fbRemix\u300b\u6e38\u620f\u8fdb\u5ea6\u8f6c\u79fb\u5230\u5176\u4ed6\u8bbe\u5907\uff1f", "answer": "\u662f\u7684\uff0c\u4f60\u53ef\u4ee5\u5c06\u4f60\u7684\u300a\u524d\u8fdb\u7a81\u51fbRemix\u300b\u6e38\u620f\u8fdb\u5ea6\u8f6c\u79fb\u5230\u5176\u4ed6\u8bbe\u5907\u3002\u9996\u5148\uff0c\u786e\u4fdd\u4f60\u5728\u4e24\u53f0\u8bbe\u5907\u4e0a\u767b\u5f55\u540c\u4e00\u4e2a\u8d26\u53f7\u3002\u6e38\u620f\u4f7f\u7528\u4e91\u4fdd\u5b58\u529f\u80fd\uff0c\u56e0\u6b64\u4f60\u7684\u8fdb\u5ea6\u4f1a\u81ea\u52a8\u540c\u6b65\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4ece\u5b89\u5353\u624b\u673a\u5207\u6362\u5230 iPhone\uff0c\u53ea\u9700\u4f7f\u7528\u4f60\u7684\u73b0\u6709\u8d26\u53f7\u767b\u5f55\uff0c\u4f60\u7684\u8fdb\u5ea6\u5c31\u4f1a\u6062\u590d\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u5728\u65b0\u8bbe\u5907\u4e0a\u767b\u5f55 \u2192 \u540c\u6b65\u6570\u636e \u2192 \u7ee7\u7eed\u6e38\u620f]\u6b64\u529f\u80fd\u5141\u8bb8\u4f60\u65e0\u7f1d\u5730\u7ee7\u7eed\u6e38\u620f\uff0c\u800c\u4e0d\u4f1a\u4e22\u5931\u4efb\u4f55\u6210\u5c31\u6216\u6e38\u620f\u5185\u8d2d\u4e70\u3002"}, {"question": "\u300a\u524d\u8fdb\u7a81\u51fbRemix\u300b\u4e2d\u7684\u9690\u85cf\u5f69\u86cb\u6709\u54ea\u4e9b\uff1f", "answer": "\u300a\u524d\u8fdb\u7a81\u51fbRemix\u300b\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u5f69\u86cb\uff0c\u4e3a\u6e38\u620f\u589e\u6dfb\u4e86\u4e50\u8da3\u3002\u503c\u5f97\u4e00\u63d0\u7684\u662f\uff0c\u9690\u85cf\u5728\u201c\u5de5\u5382\u201d\u5730\u56fe\u4e2d\u7684\u201c\u9ec4\u91d1\u4e4b\u67aa\u201d\u3002\u8981\u627e\u5230\u5b83\uff0c\u5bfc\u822a\u5230\u4ed3\u5e93\u540e\u9762\uff0c\u5bfb\u627e\u4e00\u4e2a\u5c0f\u578b\u672a\u6807\u8bb0\u7684\u7bb1\u5b50\u3002\u91cc\u9762\u4f60\u4f1a\u627e\u5230\u201c\u9ec4\u91d1\u4e4b\u67aa\u201d\uff0c\u5b83\u63d0\u4f9b\u72ec\u7279\u7684\u97f3\u6548\u548c\u91d1\u8272\u76ae\u80a4\u3002\u53e6\u4e00\u4e2a\u5f69\u86cb\u6d89\u53ca\u201c\u57ce\u5e02\u7a81\u51fb\u201d\u5730\u56fe\u4e2d\u7684\u79d8\u5bc6\u623f\u95f4\uff0c\u53ef\u4ee5\u901a\u8fc7\u89e3\u51b3\u6d89\u53ca\u6309\u7279\u5b9a\u987a\u5e8f\u5c04\u51fb\u7279\u5b9a\u76ee\u6807\u7684\u8c1c\u9898\u6765\u8bbf\u95ee\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u628a\u5b83\u60f3\u8c61\u6210\u6e38\u620f\u5185\u85cf\u5b9d\u56fe\uff0c\u5956\u52b1\u63a2\u7d22\u548c\u597d\u5947\u5fc3\u3002]"}]
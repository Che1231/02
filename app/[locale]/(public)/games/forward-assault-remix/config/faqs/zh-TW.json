[{"question": "\u5982\u4f55\u81ea\u8a02\u300a\u524d\u9032\u7a81\u64caRemix\u300b\u4e2d\u7684\u63a7\u5236\u9805\u4ee5\u63d0\u5347\u904a\u6232\u8868\u73fe\uff1f", "answer": "\u81ea\u8a02\u300a\u524d\u9032\u7a81\u64caRemix\u300b\u7684\u63a7\u5236\u9805\u80fd\u986f\u8457\u63d0\u5347\u4f60\u7684\u904a\u6232\u8868\u73fe\u3002\u9996\u5148\uff0c\u8acb\u524d\u5f80\u8a2d\u5b9a\u9078\u55ae\uff0c\u4e26\u9078\u64c7\u300e\u63a7\u5236\u300f\u3002 \u5728\u9019\u88e1\uff0c\u4f60\u53ef\u4ee5\u8abf\u6574\u4f48\u5c40\u4ee5\u7b26\u5408\u4f60\u7684\u904a\u6232\u98a8\u683c\u3002 \u4f8b\u5982\uff0c\u5c07\u958b\u706b\u6309\u9215\u79fb\u8fd1\u62c7\u6307\u53ef\u4ee5\u7e2e\u77ed\u53cd\u61c9\u6642\u9593\u3002\u6b64\u5916\uff0c\u4f60\u53ef\u4ee5\u63d0\u5347\u611f\u61c9\u5ea6\u4ee5\u9054\u5230\u66f4\u5feb\u7684\u7784\u6e96\u901f\u5ea6\u3002 \u5efa\u8b70\u5728\u7df4\u7fd2\u8cfd\u4e2d\u6e2c\u8a66\u4e0d\u540c\u7684\u8a2d\u5b9a\uff0c\u627e\u51fa\u6700\u8212\u9069\u7684\u7d44\u5408\u3002 [\u6bd4\u55bb\u8aaa\u660e: \u5c31\u50cf\u8abf\u6574\u6c7d\u8eca\u5ea7\u6905\u548c\u5f8c\u8996\u93e1\u4ee5\u7372\u5f97\u66f4\u597d\u7684\u99d5\u99db\u9ad4\u9a57\u4e00\u6a23\u3002]"}, {"question": "\u5728\u300a\u524d\u9032\u7a81\u64caRemix\u300b\u7684\u5718\u968a\u8cfd\u4e2d\uff0c\u54ea\u4e9b\u662f\u8d0f\u5f97\u6bd4\u8cfd\u7684\u6700\u4f73\u7b56\u7565\uff1f", "answer": "\u5728\u300a\u524d\u9032\u7a81\u64caRemix\u300b\u7684\u5718\u968a\u8cfd\u4e2d\u7372\u52dd\u9700\u8981\u7b56\u7565\u548c\u5718\u968a\u5408\u4f5c\u3002 \u7b2c\u4e00\u6b65\uff1a\u4f7f\u7528\u904a\u6232\u5167\u7684\u804a\u5929\u6216\u8a9e\u97f3\u8207\u968a\u53cb\u5354\u8abf\u653b\u64ca\u3002 \u7b2c\u4e8c\u6b65\uff1a\u5206\u914d\u72d9\u64ca\u624b\u3001\u7a81\u64ca\u624b\u548c\u652f\u63f4\u7b49\u89d2\u8272\uff0c\u4ee5\u5e73\u8861\u5718\u968a\u7684\u512a\u52e2\u3002 \u7b2c\u4e09\u6b65\uff1a \u96c6\u4e2d\u63a7\u5236\u5730\u5716\u4e0a\u7684\u95dc\u9375\u5340\u57df\u4ee5\u9650\u5236\u6575\u4eba\u7684\u884c\u52d5\u3002\u4f8b\u5982\uff0c\u5728\u300c\u5de5\u5ee0\u300d\u5730\u5716\u4e2d\uff0c\u4f54\u9818\u4e2d\u592e\u5009\u5eab\u53ef\u4ee5\u7372\u5f97\u6230\u7565\u512a\u52e2\u3002 [\u591a\u65b9\u6848\u5c0d\u6bd4: \u96d6\u7136\u7a4d\u6975\u7684\u73a9\u5bb6\u53ef\u80fd\u504f\u597d\u885d\u92d2\u9677\u9663\uff0c\u4f46\u5747\u8861\u7684\u7b56\u7565\u901a\u5e38\u6703\u5e36\u4f86\u66f4\u597d\u7684\u7d50\u679c\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u7684\u300a\u524d\u9032\u7a81\u64caRemix\u300b\u904a\u6232\u6703\u5ef6\u9072\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u6c7a\u9019\u500b\u554f\u984c\uff1f", "answer": "\u300a\u524d\u9032\u7a81\u64caRemix\u300b\u904a\u6232\u5ef6\u9072\u53ef\u80fd\u7531\u5e7e\u500b\u56e0\u7d20\u9020\u6210\u3002\u9996\u5148\uff0c\u8acb\u6aa2\u67e5\u4f60\u7684\u7db2\u8def\u9023\u7dda\uff1b\u7a69\u5b9a\u7684 Wi-Fi \u6216\u884c\u52d5\u7db2\u8def\u9023\u7dda\u662f\u5fc5\u4e0d\u53ef\u5c11\u7684\u3002\u5176\u6b21\uff0c\u964d\u4f4e\u904a\u6232\u4e2d\u7684\u5716\u5f62\u8a2d\u5b9a\uff0c\u4ee5\u6e1b\u5c11\u88dd\u7f6e\u8ca0\u8f09\u3002 \u4f8b\u5982\uff0c\u5c07\u6750\u8cea\u54c1\u8cea\u8a2d\u5b9a\u70ba\u300c\u4f4e\u300d\u53ef\u4ee5\u6539\u5584\u6548\u80fd\u3002\u6700\u5f8c\uff0c\u95dc\u9589\u5f8c\u53f0\u61c9\u7528\u7a0b\u5f0f\u4ee5\u91cb\u653e RAM\u3002 [\u914d\u7f6e\u5c0d\u7167\u8868: \u9ad8\u5716\u5f62 = \u5ef6\u9072\u66f4\u591a\uff0c\u4f4e\u5716\u5f62 = \u904a\u6232\u66f4\u6d41\u66a2]\u5982\u679c\u554f\u984c\u6301\u7e8c\u5b58\u5728\uff0c\u8acb\u8003\u616e\u66f4\u65b0\u88dd\u7f6e\u4f5c\u696d\u7cfb\u7d71\u548c\u904a\u6232\u672c\u8eab\u3002"}, {"question": "\u5728\u300a\u524d\u9032\u7a81\u64caRemix\u300b\u4e2d\uff0c\u54ea\u4e9b\u6b66\u5668\u6700\u9069\u5408\u4e0d\u540c\u7684\u89d2\u8272\uff1f", "answer": "\u5728\u300a\u524d\u9032\u7a81\u64caRemix\u300b\u4e2d\uff0c\u9078\u64c7\u6b63\u78ba\u7684\u6b66\u5668\u53d6\u6c7a\u65bc\u4f60\u7684\u89d2\u8272\u3002\u72d9\u64ca\u624b\u61c9\u8a72\u9078\u64c7 AWM\uff0c\u56e0\u70ba\u5b83\u5177\u6709\u9ad8\u50b7\u5bb3\u548c\u5c04\u7a0b\u3002\u7a81\u64ca\u624b\u5247\u53d7\u76ca\u65bc AK-47\uff0c\u56e0\u70ba\u5b83\u64c1\u6709\u5747\u8861\u7684\u706b\u529b\u548c\u6e96\u78ba\u5ea6\u3002\u652f\u63f4\u89d2\u8272\u53ef\u4ee5\u4f7f\u7528 M249\uff0c\u56e0\u70ba\u5b83\u5177\u6709\u9ad8\u5f48\u85e5\u5bb9\u91cf\uff0c\u975e\u5e38\u9069\u5408\u58d3\u5236\u706b\u529b\u3002\u4f8b\u5982\uff0c\u5728\u5718\u968a\u6bd4\u8cfd\u4e2d\uff0c\u4f7f\u7528 AWM \u7684\u72d9\u64ca\u624b\u53ef\u4ee5\u6709\u6548\u5730\u5f9e\u9060\u8ddd\u96e2\u64ca\u6bba\u6575\u4eba\uff0c\u800c\u7a81\u64ca\u624b\u5247\u5411\u524d\u63a8\u9032\u3002 [\u6bd4\u55bb\u8aaa\u660e: \u5c07\u5176\u60f3\u50cf\u6210\u7d44\u88dd\u5de5\u5177\u5305\uff0c\u6bcf\u7a2e\u5de5\u5177\u90fd\u6709\u7279\u5b9a\u7684\u7528\u9014\u3002]"}, {"question": "\u5982\u4f55\u5728\u300a\u524d\u9032\u7a81\u64caRemix\u300b\u4e2d\u89e3\u9396\u96b1\u85cf\u76ae\u819a\uff1f", "answer": "\u5728\u300a\u524d\u9032\u7a81\u64caRemix\u300b\u4e2d\u89e3\u9396\u96b1\u85cf\u76ae\u819a\u901a\u5e38\u9700\u8981\u5b8c\u6210\u7279\u5b9a\u7684\u6311\u6230\u3002\u4f8b\u5982\uff0cAK-47 \u7684\u300c\u6697\u5f71\u300d\u76ae\u819a\uff0c\u53ef\u4ee5\u900f\u904e\u5728\u6392\u4f4d\u8cfd\u4e2d\u9054\u6210 100 \u6b21\u7206\u982d\u4f86\u89e3\u9396\u3002\u53e6\u4e00\u7a2e\u65b9\u6cd5\u662f\u53c3\u8207\u5b63\u7bc0\u6027\u6d3b\u52d5\uff0c\u6709\u6642\u6703\u63d0\u4f9b\u7368\u5bb6\u76ae\u819a\u4f5c\u70ba\u734e\u52f5\u3002\u8acb\u5bc6\u5207\u6ce8\u610f\u904a\u6232\u7684\u516c\u544a\u548c\u6d3b\u52d5\u65e5\u66c6\u4ee5\u638c\u63e1\u9019\u4e9b\u6a5f\u6703\u3002 [\u6d41\u7a0b\u5716\u89e3: \u5b8c\u6210\u6311\u6230 \u2192 \u7372\u5f97\u7a4d\u5206 \u2192 \u89e3\u9396\u76ae\u819a] \u6b64\u5916\uff0c\u6709\u4e9b\u76ae\u819a\u53ef\u4ee5\u4f7f\u7528\u900f\u904e\u6b63\u5e38\u904a\u6232\u7372\u5f97\u7684\u904a\u6232\u5167\u8ca8\u5e63\u4f86\u8cfc\u8cb7\u3002"}, {"question": "\u300a\u524d\u9032\u7a81\u64caRemix\u300b\u8207\u5176\u524d\u8eab\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "\u300a\u524d\u9032\u7a81\u64caRemix\u300b\u5728\u539f\u7248\u904a\u6232\u4e0a\u5f15\u5165\u4e86\u591a\u9805\u6539\u9032\u3002\u5716\u5f62\u5df2\u986f\u8457\u5347\u7d1a\uff0c\u63d0\u4f9b\u66f4\u8a73\u7d30\u7684\u74b0\u5883\u548c\u89d2\u8272\u6a21\u578b\u3002\u904a\u6232\u9084\u65b0\u589e\u4e86\u65b0\u7684\u5730\u5716\uff0c\u4f8b\u5982\u300c\u57ce\u5e02\u7a81\u64ca\u300d\u548c\u300c\u6c99\u6f20\u98a8\u66b4\u300d\uff0c\u63d0\u4f9b\u65b0\u7684\u6230\u8853\u6a5f\u6703\u3002\u6b64\u5916\uff0c\u6b66\u5668\u81ea\u8a02\u9078\u9805\u4e5f\u5df2\u64f4\u5145\uff0c\u5141\u8a31\u66f4\u591a\u500b\u4eba\u5316\u7684\u88dd\u5099\u3002\u4f8b\u5982\uff0c\u73fe\u5728\u53ef\u4ee5\u5411\u4f60\u7684\u6b66\u5668\u9644\u52a0\u5404\u7a2e\u7784\u6e96\u93e1\u548c\u63e1\u628a\uff0c\u4ee5\u589e\u5f37\u5b83\u5011\u5728\u4e0d\u540c\u5834\u666f\u4e0b\u7684\u6548\u80fd\u3002 [\u591a\u65b9\u6848\u5c0d\u6bd4: \u96d6\u7136\u539f\u7248\u904a\u6232\u5074\u91cd\u65bc\u57fa\u672c\u6a5f\u5236\uff0c\u4f46 Remix \u63d0\u4f9b\u4e86\u66f4\u6c89\u6d78\u4e14\u53ef\u81ea\u8a02\u7684\u904a\u6232\u9ad4\u9a57\u3002]"}, {"question": "\u5982\u4f55\u5728\u300a\u524d\u9032\u7a81\u64caRemix\u300b\u4e2d\u63d0\u5347\u6211\u7684\u7784\u6e96\u80fd\u529b\uff1f", "answer": "\u5728\u300a\u524d\u9032\u7a81\u64caRemix\u300b\u4e2d\u63d0\u5347\u4f60\u7684\u7784\u6e96\u80fd\u529b\u9700\u8981\u7df4\u7fd2\u548c\u6b63\u78ba\u7684\u8a2d\u5b9a\u3002\u9996\u5148\uff0c\u8abf\u6574\u4f60\u7684\u611f\u61c9\u5ea6\u8a2d\u5b9a\uff1b\u8f03\u4f4e\u7684\u611f\u61c9\u5ea6\u53ef\u4ee5\u5e6b\u52a9\u4f60\u9032\u884c\u7cbe\u78ba\u7784\u6e96\u3002\u5176\u6b21\uff0c\u4f7f\u7528\u8a13\u7df4\u6a21\u5f0f\u7df4\u7fd2\u5c04\u64ca\u79fb\u52d5\u76ee\u6a19\u3002\u4f8b\u5982\uff0c\u6bcf\u5929\u5728\u300c\u9776\u5834\u7df4\u7fd2\u300d\u6a21\u5f0f\u4e2d\u82b1 10 \u5206\u9418\u4f86\u78e8\u7df4\u4f60\u7684\u6280\u5de7\u3002\u7b2c\u4e09\uff0c\u5b78\u7fd2\u63a7\u5236\u5f8c\u5750\u529b\uff0c\u900f\u904e\u77ed\u4fc3\u7684\u9023\u767c\u800c\u4e0d\u662f\u6301\u7e8c\u6309\u58d3\u6273\u6a5f\u3002 [\u6bd4\u55bb\u8aaa\u660e: \u5c07\u5176\u60f3\u50cf\u6210\u5b78\u7fd2\u6f14\u594f\u6a02\u5668\uff1b\u6301\u7e8c\u7684\u7df4\u7fd2\u624d\u80fd\u9054\u5230\u7cbe\u901a\u3002]"}, {"question": "\u5728\u300a\u524d\u9032\u7a81\u64caRemix\u300b\u4e2d\uff0c\u54ea\u4e9b\u5730\u5716\u6700\u9069\u5408\u72d9\u64ca\uff1f", "answer": "\u300a\u524d\u9032\u7a81\u64caRemix\u300b\u4e2d\u67d0\u4e9b\u5730\u5716\u975e\u5e38\u9069\u5408\u72d9\u64ca\uff0c\u56e0\u70ba\u5b83\u5011\u5177\u6709\u9577\u8ddd\u96e2\u8996\u91ce\u548c\u6230\u7565\u512a\u52e2\u9ede\u3002 \u300c\u5de5\u5ee0\u300d\u662f\u53d7\u6b61\u8fce\u7684\u9078\u64c7\uff0c\u5176\u4e2d\u592e\u5009\u5eab\u63d0\u4f9b\u4e86\u5c0d\u95dc\u9375\u5340\u57df\u7684\u6e05\u6670\u8996\u91ce\u3002\u300c\u57ce\u5e02\u7a81\u64ca\u300d\u4e5f\u63d0\u4f9b\u4e86\u6975\u4f73\u7684\u72d9\u64ca\u5730\u9ede\uff0c\u7279\u5225\u662f\u4fef\u77b0\u4e3b\u8981\u901a\u9053\u7684\u5c4b\u9802\u3002\u4f8b\u5982\uff0c\u5728\u300c\u57ce\u5e02\u7a81\u64ca\u300d\u4e2d\uff0c\u628a\u81ea\u5df1\u653e\u7f6e\u5728\u5c4b\u9802\u4e0a\uff0c\u53ef\u4ee5\u8b93\u4f60\u64ca\u6bba\u8a66\u5716\u6a6b\u8de8\u7a7a\u66e0\u5340\u57df\u7684\u6575\u4eba\u3002 [\u914d\u7f6e\u5c0d\u7167\u8868: \u5de5\u5ee0 = \u4e2d\u592e\u512a\u52e2\u9ede\uff0c\u57ce\u5e02\u7a81\u64ca = \u9ad8\u8655\u4f4d\u7f6e] \u52d9\u5fc5\u4fdd\u6301\u884c\u52d5\u907f\u514d\u6210\u70ba\u6575\u4eba\u72d9\u64ca\u624b\u7684\u5bb9\u6613\u6a19\u9776\u3002"}, {"question": "\u6211\u662f\u5426\u53ef\u4ee5\u5c07\u6211\u7684\u300a\u524d\u9032\u7a81\u64caRemix\u300b\u904a\u6232\u9032\u5ea6\u8f49\u79fb\u5230\u53e6\u4e00\u53f0\u88dd\u7f6e\uff1f", "answer": "\u662f\u7684\uff0c\u4f60\u53ef\u4ee5\u5c07\u300a\u524d\u9032\u7a81\u64caRemix\u300b\u7684\u904a\u6232\u9032\u5ea6\u8f49\u79fb\u5230\u53e6\u4e00\u53f0\u88dd\u7f6e\u3002\u9996\u5148\uff0c\u78ba\u4fdd\u4f60\u5728\u5169\u53f0\u88dd\u7f6e\u4e0a\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u3002\u904a\u6232\u4f7f\u7528\u96f2\u7aef\u5132\u5b58\uff0c\u56e0\u6b64\u4f60\u7684\u9032\u5ea6\u6703\u81ea\u52d5\u540c\u6b65\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5f9e Android \u624b\u6a5f\u8f49\u63db\u5230 iPhone\uff0c\u53ea\u9700\u4f7f\u7528\u4f60\u7684\u73fe\u6709\u5e33\u6236\u767b\u5165\uff0c\u4f60\u7684\u9032\u5ea6\u5c07\u6703\u6062\u5fa9\u3002 [\u6d41\u7a0b\u5716\u89e3: \u5728\u65b0\u88dd\u7f6e\u4e0a\u767b\u5165 \u2192 \u540c\u6b65\u8cc7\u6599 \u2192 \u7e7c\u7e8c\u904a\u73a9] \u9019\u500b\u529f\u80fd\u5141\u8a31\u4f60\u5728\u4e0d\u907a\u5931\u4efb\u4f55\u6210\u5c31\u6216\u904a\u6232\u5167\u8cfc\u8cb7\u7684\u60c5\u6cc1\u4e0b\u9806\u5229\u7e7c\u7e8c\u4f60\u7684\u904a\u6232\u3002"}, {"question": "\u5728\u300a\u524d\u9032\u7a81\u64caRemix\u300b\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\uff1f", "answer": "\u300a\u524d\u9032\u7a81\u64caRemix\u300b\u5305\u542b\u4e00\u4e9b\u96b1\u85cf\u5f69\u86cb\uff0c\u70ba\u904a\u6232\u589e\u6dfb\u6a02\u8da3\u3002\u4e00\u500b\u986f\u8457\u7684\u5f69\u86cb\u662f\u300c\u9ec4\u91d1\u69cd\u300d\uff0c\u5b83\u85cf\u5728\u300c\u5de5\u5ee0\u300d\u5730\u5716\u4e2d\u3002\u8981\u627e\u5230\u5b83\uff0c\u8acb\u524d\u5f80\u5009\u5eab\u5f8c\u65b9\uff0c\u5c0b\u627e\u4e00\u500b\u5c0f\u4e14\u6c92\u6709\u6a19\u8a18\u7684\u7bb1\u5b50\u3002\u88e1\u9762\u4f60\u6703\u767c\u73fe\u9ec3\u91d1\u69cd\uff0c\u5b83\u63d0\u4f9b\u7368\u7279\u7684\u97f3\u6548\u548c\u9ec3\u91d1\u76ae\u819a\u3002\u53e6\u4e00\u500b\u5f69\u86cb\u8207\u300c\u57ce\u5e02\u7a81\u64ca\u300d\u5730\u5716\u4e2d\u7684\u79d8\u5bc6\u623f\u9593\u6709\u95dc\uff0c\u900f\u904e\u89e3\u958b\u6d89\u53ca\u6309\u7167\u7279\u5b9a\u9806\u5e8f\u5c04\u64ca\u7279\u5b9a\u76ee\u6a19\u7684\u8b0e\u984c\u5c31\u80fd\u9032\u5165\u3002 [\u6bd4\u55bb\u8aaa\u660e: \u5c07\u5176\u60f3\u50cf\u6210\u904a\u6232\u4e2d\u7684\u5c0b\u5bf6\u6d3b\u52d5\uff0c\u734e\u52f5\u63a2\u7d22\u548c\u597d\u5947\u5fc3\u3002]"}]
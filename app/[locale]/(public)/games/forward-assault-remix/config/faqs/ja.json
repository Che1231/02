[{"question": "\u30d5\u30a9\u30ef\u30fc\u30c9\u30a2\u30b5\u30eb\u30c8\u30ea\u30df\u30c3\u30af\u30b9\u3067\u64cd\u4f5c\u3092\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3057\u3066\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u6539\u5584\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d5\u30a9\u30ef\u30fc\u30c9\u30a2\u30b5\u30eb\u30c8\u30ea\u30df\u30c3\u30af\u30b9\u306e\u64cd\u4f5c\u3092\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3059\u308b\u3053\u3068\u3067\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u307e\u305a\u3001\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u306b\u79fb\u52d5\u3057\u3001\u300e\u64cd\u4f5c\u300f\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u3053\u3053\u3067\u306f\u3001\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u5408\u3046\u3088\u3046\u306b\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u8abf\u6574\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5c04\u6483\u30dc\u30bf\u30f3\u3092\u89aa\u6307\u306e\u8fd1\u304f\u306b\u79fb\u52d5\u3059\u308b\u3068\u3001\u53cd\u5fdc\u6642\u9593\u3092\u77ed\u7e2e\u3067\u304d\u307e\u3059\u3002\u307e\u305f\u3001\u3088\u308a\u8fc5\u901f\u306a\u7167\u6e96\u306e\u305f\u3081\u306b\u611f\u5ea6\u3092\u4e0a\u3052\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u3002\u7df4\u7fd2\u8a66\u5408\u3067\u3055\u307e\u3056\u307e\u306a\u8a2d\u5b9a\u3092\u8a66\u3057\u3066\u3001\u6700\u3082\u5feb\u9069\u306a\u8a2d\u5b9a\u3092\u898b\u3064\u3051\u308b\u306e\u304c\u826f\u3044\u65b9\u6cd5\u3067\u3059\u3002[\u6bd4\u55a9\u8aac\u660e: \u904b\u8ee2\u4f53\u9a13\u3092\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u306b\u8eca\u306e\u4e2d\u306e\u30b7\u30fc\u30c8\u3068\u30df\u30e9\u30fc\u3092\u8abf\u6574\u3059\u308b\u3053\u3068\u3068\u4f3c\u3066\u3044\u307e\u3059\u3002]"}, {"question": "\u30d5\u30a9\u30ef\u30fc\u30c9\u30a2\u30b5\u30eb\u30c8\u30ea\u30df\u30c3\u30af\u30b9\u3067\u30c1\u30fc\u30e0\u30de\u30c3\u30c1\u306b\u52dd\u3064\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d5\u30a9\u30ef\u30fc\u30c9\u30a2\u30b5\u30eb\u30c8\u30ea\u30df\u30c3\u30af\u30b9\u3067\u30c1\u30fc\u30e0\u30de\u30c3\u30c1\u306b\u52dd\u3064\u305f\u3081\u306b\u306f\u3001\u6226\u7565\u3068\u30c1\u30fc\u30e0\u30ef\u30fc\u30af\u306e\u4e21\u65b9\u304c\u5fc5\u8981\u3067\u3059\u3002STEP1: \u30b2\u30fc\u30e0\u5185\u30c1\u30e3\u30c3\u30c8\u307e\u305f\u306f\u30dc\u30a4\u30b9\u30c1\u30e3\u30c3\u30c8\u3092\u4f7f\u7528\u3057\u3066\u30c1\u30fc\u30e0\u3068\u9023\u643a\u3057\u3001\u653b\u6483\u3092\u8abf\u6574\u3057\u307e\u3059\u3002STEP2: \u30b9\u30ca\u30a4\u30d1\u30fc\u3001\u30a2\u30b5\u30eb\u30c8\u3001\u30b5\u30dd\u30fc\u30c8\u306a\u3069\u306e\u5f79\u5272\u3092\u5272\u308a\u5f53\u3066\u308b\u3053\u3068\u3067\u3001\u30c1\u30fc\u30e0\u306e\u5f37\u307f\u3092\u30d0\u30e9\u30f3\u30b9\u3055\u305b\u307e\u3059\u3002STEP3: \u30de\u30c3\u30d7\u306e\u91cd\u8981\u306a\u30a8\u30ea\u30a2\u3092\u5236\u5727\u3059\u308b\u3053\u3068\u3067\u3001\u6575\u306e\u52d5\u304d\u3092\u5236\u9650\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u5de5\u5834\u300f\u30de\u30c3\u30d7\u3067\u306f\u3001\u4e2d\u592e\u306e\u5009\u5eab\u3092\u4fdd\u6301\u3059\u308b\u3053\u3068\u3067\u3001\u6226\u7565\u7684\u306a\u512a\u4f4d\u6027\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u591a\u65b9\u6848\u6bd4\u8f03: \u30a2\u30b0\u30ec\u30c3\u30b7\u30d6\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u6025\u8972\u3092\u597d\u3080\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u304c\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u30a2\u30d7\u30ed\u30fc\u30c1\u306e\u65b9\u304c\u3001\u591a\u304f\u306e\u5834\u5408\u3001\u3088\u308a\u826f\u3044\u7d50\u679c\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002]"}, {"question": "\u30d5\u30a9\u30ef\u30fc\u30c9\u30a2\u30b5\u30eb\u30c8\u30ea\u30df\u30c3\u30af\u30b9\u3067\u30b2\u30fc\u30e0\u304c\u30d5\u30ea\u30fc\u30ba\u3059\u308b\u539f\u56e0\u306f\u4f55\u3067\u3059\u304b\u3002\u307e\u305f\u3001\u3069\u306e\u3088\u3046\u306b\u4fee\u6b63\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d5\u30a9\u30ef\u30fc\u30c9\u30a2\u30b5\u30eb\u30c8\u30ea\u30df\u30c3\u30af\u30b9\u3067\u9045\u5ef6\u304c\u767a\u751f\u3059\u308b\u539f\u56e0\u306f\u3044\u304f\u3064\u304b\u3042\u308a\u307e\u3059\u3002\u307e\u305a\u3001\u30a4\u30f3\u30bf\u30fc\u30cd\u30c3\u30c8\u63a5\u7d9a\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u5b89\u5b9a\u3057\u305fWi-Fi\u307e\u305f\u306f\u30e2\u30d0\u30a4\u30eb\u30c7\u30fc\u30bf\u63a5\u7d9a\u306f\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u6b21\u306b\u3001\u30b2\u30fc\u30e0\u5185\u306e\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3092\u4e0b\u3052\u3066\u3001\u30c7\u30d0\u30a4\u30b9\u3078\u306e\u8ca0\u8377\u3092\u8efd\u6e1b\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30c6\u30af\u30b9\u30c1\u30e3\u54c1\u8cea\u3092\u300e\u4f4e\u300f\u306b\u8a2d\u5b9a\u3059\u308b\u3068\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002\u6700\u5f8c\u306b\u3001\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u30a2\u30d7\u30ea\u3092\u9589\u3058\u308b\u3068\u3001RAM\u304c\u89e3\u653e\u3055\u308c\u307e\u3059\u3002[\u69cb\u6210\u5bfe\u7167\u8868: \u9ad8\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\uff1d\u9045\u5ef6\u5897\u52a0\u3001\u4f4e\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\uff1d\u30b9\u30e0\u30fc\u30ba\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\uff3d\u554f\u984c\u304c\u7d9a\u304f\u5834\u5408\u306f\u3001\u30c7\u30d0\u30a4\u30b9\u306e\u30aa\u30da\u30ec\u30fc\u30c6\u30a3\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u3068\u30b2\u30fc\u30e0\u81ea\u4f53\u3092\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3059\u308b\u3053\u3068\u3092\u691c\u8a0e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30d5\u30a9\u30ef\u30fc\u30c9\u30a2\u30b5\u30eb\u30c8\u30ea\u30df\u30c3\u30af\u30b9\u3067\u3001\u3055\u307e\u3056\u307e\u306a\u5f79\u5272\u306b\u6700\u9069\u306a\u6b66\u5668\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d5\u30a9\u30ef\u30fc\u30c9\u30a2\u30b5\u30eb\u30c8\u30ea\u30df\u30c3\u30af\u30b9\u3067\u9069\u5207\u306a\u6b66\u5668\u3092\u9078\u3076\u3053\u3068\u306f\u3001\u3042\u306a\u305f\u306e\u5f79\u5272\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u3002\u30b9\u30ca\u30a4\u30d1\u30fc\u306fAWM\u3092\u9078\u3073\u3001\u305d\u306e\u9ad8\u3044\u30c0\u30e1\u30fc\u30b8\u3068\u5c04\u7a0b\u3092\u5229\u7528\u3059\u3079\u304d\u3067\u3059\u3002\u30a2\u30b5\u30eb\u30c8\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u706b\u529b\u3068\u6b63\u78ba\u3055\u3092\u6301\u3064AK-47\u304c\u9069\u3057\u3066\u3044\u307e\u3059\u3002\u30b5\u30dd\u30fc\u30c8\u306e\u5f79\u5272\u306f\u3001\u9ad8\u3044\u5f3e\u85ac\u6570\u3092\u6301\u3064M249\u3092\u4f7f\u7528\u3067\u304d\u308b\u305f\u3081\u3001\u6575\u3092\u5236\u5727\u3059\u308b\u306e\u306b\u6700\u9069\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30c1\u30fc\u30e0\u30de\u30c3\u30c1\u3067\u306f\u3001AWM\u3092\u4f7f\u7528\u3059\u308b\u30b9\u30ca\u30a4\u30d1\u30fc\u304c\u9060\u8ddd\u96e2\u304b\u3089\u6575\u3092\u52b9\u679c\u7684\u306b\u6483\u3061\u843d\u3068\u3057\u3001\u30a2\u30b5\u30eb\u30c8\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u524d\u9032\u3057\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e: \u305d\u308c\u305e\u308c\u306e\u30c4\u30fc\u30eb\u306b\u56fa\u6709\u306e\u76ee\u7684\u304c\u3042\u308b\u30c4\u30fc\u30eb\u30ad\u30c3\u30c8\u3092\u7d44\u307f\u7acb\u3066\u3066\u3044\u308b\u3068\u8003\u3048\u307e\u3059\u3002]"}, {"question": "\u30d5\u30a9\u30ef\u30fc\u30c9\u30a2\u30b5\u30eb\u30c8\u30ea\u30df\u30c3\u30af\u30b9\u3067\u96a0\u3055\u308c\u305f\u30b9\u30ad\u30f3\u3092\u3069\u306e\u3088\u3046\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30d5\u30a9\u30ef\u30fc\u30c9\u30a2\u30b5\u30eb\u30c8\u30ea\u30df\u30c3\u30af\u30b9\u3067\u96a0\u3055\u308c\u305f\u30b9\u30ad\u30f3\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u306b\u306f\u3001\u7279\u5b9a\u306e\u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u5b8c\u4e86\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001AK-47\u306e\u300c\u5f71\u300d\u30b9\u30ad\u30f3\u306f\u3001\u30e9\u30f3\u30af\u30de\u30c3\u30c1\u3067100\u56de\u306e\u30d8\u30c3\u30c9\u30b7\u30e7\u30c3\u30c8\u3092\u9054\u6210\u3059\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u3002\u3082\u3046\u4e00\u3064\u306e\u65b9\u6cd5\u306f\u3001\u5b63\u7bc0\u30a4\u30d9\u30f3\u30c8\u306b\u53c2\u52a0\u3059\u308b\u3053\u3068\u3067\u3001\u3068\u304d\u306b\u9650\u5b9a\u7684\u306a\u30b9\u30ad\u30f3\u304c\u5831\u916c\u3068\u3057\u3066\u63d0\u4f9b\u3055\u308c\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u6a5f\u4f1a\u306b\u3064\u3044\u3066\u306f\u3001\u30b2\u30fc\u30e0\u306e\u767a\u8868\u3068\u30a4\u30d9\u30f3\u30c8\u30ab\u30ec\u30f3\u30c0\u30fc\u3092\u6ce8\u610f\u6df1\u304f\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8: \u30c1\u30e3\u30ec\u30f3\u30b8\u3092\u5b8c\u4e86\u2192\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u2192\u30b9\u30ad\u30f3\u3092\u30a2\u30f3\u30ed\u30c3\u30af]\u3055\u3089\u306b\u3001\u4e00\u90e8\u306e\u30b9\u30ad\u30f3\u306f\u3001\u901a\u5e38\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u901a\u3058\u3066\u7a3c\u3044\u3060\u30b2\u30fc\u30e0\u5185\u901a\u8ca8\u3067\u8cfc\u5165\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d5\u30a9\u30ef\u30fc\u30c9\u30a2\u30b5\u30eb\u30c8\u30ea\u30df\u30c3\u30af\u30b9\u3068\u305d\u306e\u524d\u4f5c\u306e\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d5\u30a9\u30ef\u30fc\u30c9\u30a2\u30b5\u30eb\u30c8\u30ea\u30df\u30c3\u30af\u30b9\u306f\u3001\u524d\u4f5c\u306b\u6bd4\u3079\u3066\u3044\u304f\u3064\u304b\u306e\u6539\u5584\u70b9\u304c\u3042\u308a\u307e\u3059\u3002\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u306f\u5927\u5e45\u306b\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3055\u308c\u3001\u3088\u308a\u8a73\u7d30\u306a\u74b0\u5883\u3068\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30e2\u30c7\u30eb\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u3053\u306e\u30b2\u30fc\u30e0\u306b\u306f\u3001\u65b0\u3057\u3044\u30de\u30c3\u30d7\u300e\u90fd\u5e02\u653b\u6483\u300f\u3068\u300e\u7802\u6f20\u306e\u5d50\u300f\u3082\u542b\u307e\u308c\u3066\u304a\u308a\u3001\u65b0\u3057\u3044\u6226\u8853\u7684\u6a5f\u4f1a\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u6b66\u5668\u306e\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u30aa\u30d7\u30b7\u30e7\u30f3\u3082\u62e1\u5f35\u3055\u308c\u3066\u304a\u308a\u3001\u3088\u308a\u30d1\u30fc\u30bd\u30ca\u30e9\u30a4\u30ba\u3055\u308c\u305f\u88c5\u5099\u304c\u53ef\u80fd\u306b\u306a\u308a\u307e\u3057\u305f\u3002\u305f\u3068\u3048\u3070\u3001\u6b66\u5668\u306b\u3055\u307e\u3056\u307e\u306a\u30b9\u30b3\u30fc\u30d7\u3084\u30b0\u30ea\u30c3\u30d7\u3092\u53d6\u308a\u4ed8\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u3001\u3055\u307e\u3056\u307e\u306a\u72b6\u6cc1\u3067\u6027\u80fd\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u591a\u65b9\u6848\u6bd4\u8f03: \u5143\u306e\u30b2\u30fc\u30e0\u306f\u57fa\u672c\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u3044\u305f\u306e\u306b\u5bfe\u3057\u3001Remix\u306f\u3088\u308a\u6ca1\u5165\u611f\u304c\u3042\u308a\u3001\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u53ef\u80fd\u306a\u4f53\u9a13\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002]"}, {"question": "\u30d5\u30a9\u30ef\u30fc\u30c9\u30a2\u30b5\u30eb\u30c8\u30ea\u30df\u30c3\u30af\u30b9\u3067\u5c04\u6483\u30b9\u30ad\u30eb\u3092\u5411\u4e0a\u3055\u305b\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d5\u30a9\u30ef\u30fc\u30c9\u30a2\u30b5\u30eb\u30c8\u30ea\u30df\u30c3\u30af\u30b9\u3067\u5c04\u6483\u30b9\u30ad\u30eb\u3092\u5411\u4e0a\u3055\u305b\u308b\u306b\u306f\u3001\u7df4\u7fd2\u3068\u9069\u5207\u306a\u8a2d\u5b9a\u304c\u5fc5\u8981\u3067\u3059\u3002\u307e\u305a\u3001\u611f\u5ea6\u8a2d\u5b9a\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u611f\u5ea6\u3092\u4e0b\u3052\u308b\u3068\u3001\u6b63\u78ba\u306a\u5c04\u6483\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u6b21\u306b\u3001\u8a13\u7df4\u30e2\u30fc\u30c9\u3092\u4f7f\u7528\u3057\u3066\u3001\u52d5\u304f\u30bf\u30fc\u30b2\u30c3\u30c8\u3092\u5c04\u6483\u3059\u308b\u7df4\u7fd2\u3092\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6bce\u65e510\u5206\u9593\u300e\u5c04\u6483\u7df4\u7fd2\u300f\u30e2\u30fc\u30c9\u3067\u30b9\u30ad\u30eb\u3092\u78e8\u304d\u307e\u3057\u3087\u3046\u30023\u3064\u76ee\u306f\u3001\u30c8\u30ea\u30ac\u30fc\u3092\u62bc\u3057\u7d9a\u3051\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u77ed\u3044\u30d0\u30fc\u30b9\u30c8\u3067\u767a\u7832\u3057\u3066\u53cd\u52d5\u3092\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u3059\u308b\u3053\u3068\u3092\u5b66\u3073\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e: \u97f3\u697d\u306e\u697d\u5668\u3092\u6f14\u594f\u3059\u308b\u3053\u3068\u3092\u5b66\u3076\u306e\u3068\u540c\u69d8\u3067\u3059\u3002\u7d99\u7d9a\u7684\u306a\u7df4\u7fd2\u304c\u8155\u524d\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002]"}, {"question": "\u30d5\u30a9\u30ef\u30fc\u30c9\u30a2\u30b5\u30eb\u30c8\u30ea\u30df\u30c3\u30af\u30b9\u3067\u30b9\u30ca\u30a4\u30d4\u30f3\u30b0\u306b\u6700\u9069\u306a\u30de\u30c3\u30d7\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d5\u30a9\u30ef\u30fc\u30c9\u30a2\u30b5\u30eb\u30c8\u30ea\u30df\u30c3\u30af\u30b9\u3067\u306f\u3001\u9577\u8ddd\u96e2\u306e\u8996\u7dda\u3068\u6226\u7565\u7684\u306a\u6709\u5229\u306a\u4f4d\u7f6e\u304c\u3042\u308b\u305f\u3081\u3001\u7279\u5b9a\u306e\u30de\u30c3\u30d7\u304c\u30b9\u30ca\u30a4\u30d4\u30f3\u30b0\u306b\u6700\u9069\u3067\u3059\u3002\u300e\u5de5\u5834\u300f\u306f\u4eba\u6c17\u306e\u3042\u308b\u9078\u629e\u3067\u3001\u4e2d\u592e\u306e\u5009\u5eab\u306f\u4e3b\u8981\u306a\u30a8\u30ea\u30a2\u306e\u660e\u78ba\u306a\u8996\u754c\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u300e\u90fd\u5e02\u653b\u6483\u300f\u3067\u3082\u512a\u308c\u305f\u30b9\u30ca\u30a4\u30d4\u30f3\u30b0\u30b9\u30dd\u30c3\u30c8\u304c\u63d0\u4f9b\u3055\u308c\u3001\u7279\u306b\u30e1\u30a4\u30f3\u901a\u8def\u3092\u898b\u4e0b\u308d\u3059\u5c4b\u6839\u88cf\u90e8\u5c4b\u304c\u305d\u3046\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u300e\u90fd\u5e02\u653b\u6483\u300f\u306e\u5c4b\u6839\u306e\u4e0a\u306e\u30dd\u30b8\u30b7\u30e7\u30f3\u3092\u3068\u308b\u3068\u3001\u6575\u304c\u958b\u653e\u7684\u306a\u30a8\u30ea\u30a2\u3092\u901a\u904e\u3057\u3088\u3046\u3068\u3059\u308b\u3068\u304d\u306b\u3001\u6575\u3092\u6483\u3061\u843d\u3068\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u69cb\u6210\u5bfe\u7167\u8868: \u5de5\u5834\uff1d\u4e2d\u592e\u306e\u6709\u5229\u306a\u4f4d\u7f6e\u3001\u90fd\u5e02\u653b\u6483\uff1d\u9ad8\u5730\u306e\u30dd\u30b8\u30b7\u30e7\u30f3] \u5e38\u306b\u79fb\u52d5\u3057\u7d9a\u3051\u308b\u3053\u3068\u3067\u3001\u6575\u306e\u30b9\u30ca\u30a4\u30d1\u30fc\u306e\u6a19\u7684\u306b\u306a\u308a\u3084\u3059\u3044\u72b6\u614b\u3092\u907f\u3051\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u5225\u306e\u30c7\u30d0\u30a4\u30b9\u306b\u30d5\u30a9\u30ef\u30fc\u30c9\u30a2\u30b5\u30eb\u30c8\u30ea\u30df\u30c3\u30af\u30b9\u306e\u9032\u6357\u72b6\u6cc1\u3092\u79fb\u884c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30d5\u30a9\u30ef\u30fc\u30c9\u30a2\u30b5\u30eb\u30c8\u30ea\u30df\u30c3\u30af\u30b9\u306e\u9032\u6357\u72b6\u6cc1\u3092\u5225\u306e\u30c7\u30d0\u30a4\u30b9\u306b\u8ee2\u9001\u3067\u304d\u307e\u3059\u3002\u307e\u305a\u3001\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u3053\u306e\u30b2\u30fc\u30e0\u306f\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u4f7f\u7528\u3057\u3066\u3044\u308b\u306e\u3067\u3001\u9032\u6357\u72b6\u6cc1\u306f\u81ea\u52d5\u7684\u306b\u540c\u671f\u3055\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001Android\u30b9\u30de\u30fc\u30c8\u30d5\u30a9\u30f3\u304b\u3089iPhone\u306b\u5207\u308a\u66ff\u3048\u308b\u5834\u5408\u3001\u65e2\u5b58\u306e\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3060\u3051\u3067\u3001\u9032\u6357\u72b6\u6cc1\u304c\u5fa9\u5143\u3055\u308c\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8: \u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u30ed\u30b0\u30a4\u30f3\u2192\u30c7\u30fc\u30bf\u3092\u540c\u671f\u2192\u30d7\u30ec\u30a4\u3092\u7d9a\u3051\u308b] \u3053\u306e\u6a5f\u80fd\u306b\u3088\u308a\u3001\u9054\u6210\u3084\u30b2\u30fc\u30e0\u5185\u8cfc\u5165\u306a\u3069\u3092\u5931\u3046\u3053\u3068\u306a\u304f\u3001\u30b7\u30fc\u30e0\u30ec\u30b9\u306b\u30b2\u30fc\u30e0\u3092\u7d9a\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30d5\u30a9\u30ef\u30fc\u30c9\u30a2\u30b5\u30eb\u30c8\u30ea\u30df\u30c3\u30af\u30b9\u306e\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d5\u30a9\u30ef\u30fc\u30c9\u30a2\u30b5\u30eb\u30c8\u30ea\u30df\u30c3\u30af\u30b9\u306b\u306f\u3001\u30b2\u30fc\u30e0\u306b\u697d\u3057\u307f\u3092\u52a0\u3048\u308b\u3044\u304f\u3064\u304b\u306e\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306e1\u3064\u306f\u3001\u300e\u5de5\u5834\u300f\u30de\u30c3\u30d7\u306b\u3042\u308b\u96a0\u3055\u308c\u305f\u300e\u30b4\u30fc\u30eb\u30c7\u30f3\u30ac\u30f3\u300f\u3067\u3059\u3002\u5009\u5eab\u306e\u88cf\u5074\u306b\u79fb\u52d5\u3057\u3001\u5c0f\u3055\u306a\u76ee\u5370\u306e\u306a\u3044\u7bb1\u3092\u63a2\u3057\u307e\u3059\u3002\u4e2d\u306b\u3042\u308b\u30b4\u30fc\u30eb\u30c7\u30f3\u30ac\u30f3\u306f\u3001\u30e6\u30cb\u30fc\u30af\u306a\u97f3\u97ff\u52b9\u679c\u3068\u91d1\u8272\u30b9\u30ad\u30f3\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u3082\u30461\u3064\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3001\u300e\u90fd\u5e02\u653b\u6483\u300f\u30de\u30c3\u30d7\u306e\u79d8\u5bc6\u306e\u90e8\u5c4b\u3067\u3001\u7279\u5b9a\u306e\u30bf\u30fc\u30b2\u30c3\u30c8\u3092\u7279\u5b9a\u306e\u9806\u5e8f\u3067\u6483\u3064\u3068\u3044\u3046\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u3053\u3068\u3067\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e: \u30b2\u30fc\u30e0\u5185\u306e\u5b9d\u63a2\u3057\u3068\u8003\u3048\u3089\u308c\u3001\u63a2\u691c\u3068\u597d\u5947\u5fc3\u306b\u5bfe\u3059\u308b\u5831\u916c\u3067\u3059\u3002]"}]
[{"question": "Forward Assault Remix \uac8c\uc784\uc5d0\uc11c \ud50c\ub808\uc774\ub97c \uac1c\uc120\ud558\uae30 \uc704\ud574 \ucee8\ud2b8\ub864\uc744 \uc5b4\ub5bb\uac8c \uc0ac\uc6a9\uc790 \uc9c0\uc815\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Forward Assault Remix\uc5d0\uc11c \ucee8\ud2b8\ub864\uc744 \uc0ac\uc6a9\uc790 \uc9c0\uc815\ud558\uba74 \uc131\ub2a5\uc774 \ud06c\uac8c \ud5a5\uc0c1\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uba3c\uc800 \uc124\uc815 \uba54\ub274\ub85c \uc774\ub3d9\ud558\uc5ec '\ucee8\ud2b8\ub864'\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc5ec\uae30\uc11c \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\uac8c \ub808\uc774\uc544\uc6c3\uc744 \uc870\uc815\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubc1c\uc0ac \ubc84\ud2bc\uc744 \uc5c4\uc9c0\uc190\uac00\ub77d\uc5d0 \ub354 \uac00\uae5d\uac8c \uc62e\uae30\uba74 \ubc18\uc751 \uc2dc\uac04\uc744 \uc904\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \ub354 \ube60\ub978 \uc870\uc900\uc744 \uc704\ud574 \ubbfc\uac10\ub3c4\ub97c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc5f0\uc2b5 \ub9e4\uce58\uc5d0\uc11c \ub2e4\uc591\ud55c \uad6c\uc131\uc744 \ud14c\uc2a4\ud2b8\ud558\uc5ec \uac00\uc7a5 \ud3b8\uc548\ud55c \uac83\uc744 \ud655\uc778\ud558\ub294 \uac83\uc774 \uc88b\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ucc28\ub7c9\uc5d0\uc11c \ub354 \ub098\uc740 \uc6b4\uc804 \uacbd\ud5d8\uc744 \uc704\ud574 \uc2dc\ud2b8\uc640 \uac70\uc6b8\uc744 \uc870\uc815\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "Forward Assault Remix \ud300 \ub9e4\uce58\uc5d0\uc11c \uc774\uae30\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Forward Assault Remix \ud300 \ub9e4\uce58\uc5d0\uc11c \uc774\uae30\ub824\uba74 \uc804\ub7b5\uacfc \ud300\uc6cc\ud06c\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. STEP1: \uac8c\uc784 \ub0b4 \ucc44\ud305\uc774\ub098 \uc74c\uc131\uc73c\ub85c \ud300\uc6d0\uacfc \uc18c\ud1b5\ud558\uc5ec \uacf5\uaca9\uc744 \uc870\uc815\ud569\ub2c8\ub2e4. STEP2: \uc800\uaca9\uc218, \ub3cc\uaca9\uc218, \uc9c0\uc6d0\uc218 \ub4f1 \uc5ed\ud560\uc744 \ubc30\ubd84\ud558\uc5ec \ud300\uc758 \uac15\uc810\uc744 \uade0\ud615 \uc788\uac8c \ub9cc\ub4ed\ub2c8\ub2e4. STEP3: \uc801\uc758 \uc774\ub3d9\uc744 \uc81c\ud55c\ud558\uae30 \uc704\ud574 \uc9c0\ub3c4\uc758 \uc8fc\uc694 \uc9c0\uc5ed\uc744 \uc7a5\uc545\ud558\ub294 \ub370 \uc9d1\uc911\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud329\ud1a0\ub9ac' \uc9c0\ub3c4\uc5d0\uc11c \uc911\uc559 \ucc3d\uace0\ub97c \uc810\ub839\ud558\uba74 \uc804\ub7b5\uc801 \uc6b0\uc704\ub97c \ud655\ubcf4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: \uacf5\uaca9\uc801\uc778 \ud50c\ub808\uc774\uc5b4\uac00 \ub3cc\uaca9\uc744 \uc120\ud638\ud560 \uc218 \uc788\uc9c0\ub9cc, \uade0\ud615 \uc7a1\ud78c \uc811\uadfc \ubc29\uc2dd\uc774 \uc885\uc885 \ub354 \ub098\uc740 \uacb0\uacfc\ub97c \uac00\uc838\uc635\ub2c8\ub2e4.]"}, {"question": "Forward Assault Remix\uc5d0\uc11c \uc65c \uac8c\uc784\uc774 \ub04a\uae30\ub294\uc9c0, \uadf8\ub9ac\uace0 \uc5b4\ub5bb\uac8c \ud574\uacb0\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Forward Assault Remix\uc5d0\uc11c \ub04a\uae40 \ud604\uc0c1\uc740 \uc5ec\ub7ec \uc694\uc778\uc5d0 \uc758\ud574 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uba3c\uc800 \uc778\ud130\ub137 \uc5f0\uacb0\uc744 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uc548\uc815\uc801\uc778 Wi-Fi \ub610\ub294 \ubaa8\ubc14\uc77c \ub370\uc774\ud130 \uc5f0\uacb0\uc774 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \ub458\uc9f8, \uae30\uae30 \ubd80\ud558\ub97c \uc904\uc774\uae30 \uc704\ud574 \uac8c\uc784 \ub0b4 \uadf8\ub798\ud53d \uc124\uc815\uc744 \ub0ae\ucd94\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc9c8\uac10 \ud488\uc9c8\uc744 '\ub0ae\uc74c'\uc73c\ub85c \uc124\uc815\ud558\uba74 \uc131\ub2a5\uc774 \ud5a5\uc0c1\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub9c8\uc9c0\ub9c9\uc73c\ub85c \ubc31\uadf8\ub77c\uc6b4\ub4dc \uc571\uc744 \ub2eb\uc544 RAM\uc744 \ud655\ubcf4\ud558\uc2ed\uc2dc\uc624. [\uad6c\uc131 \ube44\uad50\ud45c: \uace0\ud488\uc9c8 \uadf8\ub798\ud53d = \ub354 \ub9ce\uc740 \ub04a\uae40, \uc800\ud488\uc9c8 \uadf8\ub798\ud53d = \ub354 \ubd80\ub4dc\ub7ec\uc6b4 \uac8c\uc784 \ud50c\ub808\uc774] \ubb38\uc81c\uac00 \uc9c0\uc18d\ub418\uba74 \uae30\uae30\uc758 \uc6b4\uc601 \uccb4\uc81c\uc640 \uac8c\uc784 \uc790\uccb4\ub97c \uc5c5\ub370\uc774\ud2b8\ud558\uc2ed\uc2dc\uc624."}, {"question": "Forward Assault Remix\uc5d0\uc11c \ub2e4\ub978 \uc5ed\ud560\uc5d0 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ubb34\uae30\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Forward Assault Remix\uc5d0\uc11c \uc801\uc808\ud55c \ubb34\uae30\ub97c \uc120\ud0dd\ud558\ub294 \uac83\uc740 \uc5ed\ud560\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. \uc800\uaca9\uc218\ub294 \ub192\uc740 \ud53c\ud574\ub7c9\uacfc \uc0ac\uac70\ub9ac\ub97c \uac00\uc9c4 AWM\uc744 \uc120\ud0dd\ud574\uc57c \ud569\ub2c8\ub2e4. \ub3cc\uaca9\uc218\ub294 \uade0\ud615 \uc7a1\ud78c \ud654\ub825\uacfc \uc815\ud655\ub3c4\ub97c \uac00\uc9c4 AK-47\uc744 \ud65c\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc9c0\uc6d0 \uc5ed\ud560\uc740 \ub300\ub7c9\uc758 \ud0c4\uc57d\uc73c\ub85c \uc801\uc744 \uc9c4\uc555\ud558\uae30\uc5d0 \uc88b\uc740 M249\ub97c \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud300 \ub9e4\uce58\uc5d0\uc11c AWM\uc744 \uc0ac\uc6a9\ud558\ub294 \uc800\uaca9\uc218\ub294 \uac70\ub9ac\ub97c \ub450\uace0 \uc801\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc81c\uac70\ud560 \uc218 \uc788\ub294 \ubc18\uba74, \ub3cc\uaca9\uc218\ub294 \uc804\uc9c4\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uac01 \ub3c4\uad6c\uc5d0 \uace0\uc720\ud55c \uc6a9\ub3c4\uac00 \uc788\ub294 \ub3c4\uad6c \uc0c1\uc790\ub97c \ub9cc\ub4dc\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "Forward Assault Remix\uc5d0\uc11c \uc228\uaca8\uc9c4 \uc2a4\ud0a8\uc744 \uc5b4\ub5bb\uac8c \ud574\uc81c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Forward Assault Remix\uc5d0\uc11c \uc228\uaca8\uc9c4 \uc2a4\ud0a8\uc744 \ud574\uc81c\ud558\ub294 \uac83\uc740 \uc77c\ubc18\uc801\uc73c\ub85c \ud2b9\uc815 \ucc4c\ub9b0\uc9c0\ub97c \uc644\ub8cc\ud558\ub294 \uac83\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 AK-47\uc758 '\uc250\ub3c4\uc6b0' \uc2a4\ud0a8\uc740 \ub7ad\ud06c \ub9e4\uce58\uc5d0\uc11c 100\ud68c \ud5e4\ub4dc\uc0f7\uc744 \ub2ec\uc131\ud568\uc73c\ub85c\uc368 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \ubc29\ubc95\uc740 \uacc4\uc808 \uc774\ubca4\ud2b8\uc5d0 \ucc38\uc5ec\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc774\ubca4\ud2b8\uc5d0\uc11c \ub54c\ub54c\ub85c \ub3c5\uc810 \uc2a4\ud0a8\uc744 \ubcf4\uc0c1\uc73c\ub85c \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uae30\ud68c\uc5d0 \ub300\ud55c \ucd5c\uc2e0 \uc815\ubcf4\ub97c \uc5bb\uc73c\ub824\uba74 \uac8c\uc784\uc758 \ubc1c\ud45c \ubc0f \uc774\ubca4\ud2b8 \uc77c\uc815\uc744 \uc8fc\uc2dc\ud558\uc2ed\uc2dc\uc624. [\ud750\ub984\ub3c4: \ucc4c\ub9b0\uc9c0 \uc644\ub8cc \u2192 \uc810\uc218 \ud68d\ub4dd \u2192 \uc2a4\ud0a8 \ud574\uc81c] \ub610\ud55c \uc77c\uc0c1\uc801\uc778 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ud1b5\ud574 \ud68d\ub4dd\ud55c \uac8c\uc784 \ub0b4 \ud1b5\ud654\ub85c \uc77c\ubd80 \uc2a4\ud0a8\uc744 \uad6c\ub9e4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Forward Assault Remix\uc640 \uadf8 \uc804\uc791\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Forward Assault Remix\ub294 \uc804\uc791\ubcf4\ub2e4 \uc5ec\ub7ec \uac00\uc9c0 \uac1c\uc120 \uc0ac\ud56d\uc744 \ub3c4\uc785\ud588\uc2b5\ub2c8\ub2e4. \uadf8\ub798\ud53d\uc774 \ud06c\uac8c \ud5a5\uc0c1\ub418\uc5b4 \ub354\uc6b1 \uc0c1\uc138\ud55c \ud658\uacbd\uacfc \uce90\ub9ad\ud130 \ubaa8\ub378\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub610\ud55c '\ub3c4\uc2ec \uacf5\uaca9'\uacfc '\uc0ac\ub9c9 \ud3ed\ud48d'\uacfc \uac19\uc740 \uc0c8\ub85c\uc6b4 \uc9c0\ub3c4\uac00 \ub4f1\uc7a5\ud558\uc5ec \uc0c8\ub85c\uc6b4 \uc804\uc220\uc801 \uae30\ud68c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub610\ud55c, \ubb34\uae30 \uc0ac\uc6a9\uc790 \uc9c0\uc815 \uc635\uc158\uc774 \ud655\uc7a5\ub418\uc5b4 \ub354\uc6b1 \uac1c\uc778\ud654\ub41c \uc7a5\ube44\ub97c \uad6c\uc131\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc774\uc81c \ub2e4\uc591\ud55c \ubc94\uc704\uc640 \uadf8\ub9bd\uc744 \ubb34\uae30\uc5d0 \ucd94\uac00\ud558\uc5ec \ub2e4\uc591\ud55c \uc2dc\ub098\ub9ac\uc624\uc5d0\uc11c \uc131\ub2a5\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: \uc6d0\ub798 \uac8c\uc784\uc740 \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc5d0 \uc911\uc810\uc744 \ub450\uc5c8\uc9c0\ub9cc, Remix\ub294 \ub354\uc6b1 \ubab0\uc785\uc801\uc774\uace0 \uc0ac\uc6a9\uc790 \uc9c0\uc815 \uac00\ub2a5\ud55c \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.]"}, {"question": "Forward Assault Remix\uc5d0\uc11c \uc870\uc900\ub825\uc744 \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\ub098\uc694?", "answer": "Forward Assault Remix\uc5d0\uc11c \uc870\uc900\ub825\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub824\uba74 \uc5f0\uc2b5\uacfc \uc801\uc808\ud55c \uc124\uc815\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uba3c\uc800 \ubbfc\uac10\ub3c4 \uc124\uc815\uc744 \uc870\uc815\ud558\uc2ed\uc2dc\uc624. \ub0ae\uc740 \ubbfc\uac10\ub3c4\ub294 \uc815\ud655\ud55c \uc870\uc900\uc5d0 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub458\uc9f8, \uc774\ub3d9 \ud45c\uc801\uc744 \ud5a5\ud574 \ucd2c\uc601\ud558\ub294 \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ub9e4\uc77c '\ud45c\uc801 \uc5f0\uc2b5' \ubaa8\ub4dc\uc5d0\uc11c 10\ubd84\uc744 \ud560\uc560\ud558\uc5ec \uae30\uc220\uc744 \uac08\uace0\ub2e6\uc73c\uc2ed\uc2dc\uc624. \uc14b\uc9f8, \ud2b8\ub9ac\uac70\ub97c \ub204\ub974\ub294 \ub300\uc2e0 \uc9e7\uc740 \ubc94\uc704\ub85c \ubc1c\uc0ac\ud558\uc5ec \ubc18\ub3d9\uc744 \uc81c\uc5b4\ud558\ub294 \ubc95\uc744 \ubc30\uc6b0\uc2ed\uc2dc\uc624. [\ube44\uc720 \uc124\uba85: \uc545\uae30\ub97c \ubc30\uc6b0\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uafb8\uc900\ud55c \uc5f0\uc2b5\uc740 \ub9c8\uc2a4\ud130\ub85c \uc774\uc5b4\uc9d1\ub2c8\ub2e4.]"}, {"question": "Forward Assault Remix\uc5d0\uc11c \uc800\uaca9\uc5d0 \uac00\uc7a5 \uc801\ud569\ud55c \uc9c0\ub3c4\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Forward Assault Remix\uc758 \ud2b9\uc815 \uc9c0\ub3c4\ub294 \uae34 \uc2dc\uc57c\uc120\uacfc \uc804\ub7b5\uc801 \uad00\ucc30 \uc9c0\uc810\uc73c\ub85c \uc778\ud574 \uc800\uaca9\uc5d0 \uc774\uc0c1\uc801\uc785\ub2c8\ub2e4. '\ud329\ud1a0\ub9ac'\ub294 \uc911\uc559 \ucc3d\uace0\uac00 \uc8fc\uc694 \uc9c0\uc5ed\uc758 \uc804\ub9dd\uc744 \uc81c\uacf5\ud558\uace0 \uc778\uae30 \uc788\ub294 \uc120\ud0dd \uc0ac\ud56d\uc785\ub2c8\ub2e4. '\ub3c4\uc2ec \uacf5\uaca9' \ub610\ud55c \uc8fc\uc694 \ud1b5\ub85c\ub97c \ub0b4\ub824\ub2e4\ubcf4\ub294 \uc9c0\ubd95\uc774 \ud2b9\ud788 \ud6cc\ub96d\ud55c \uc800\uaca9 \uc9c0\uc810\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub3c4\uc2ec \uacf5\uaca9'\uc5d0\uc11c \uc9c0\ubd95\uc5d0 \uc704\uce58\ud558\uba74 \uac1c\ubc29\ub41c \uc9c0\uc5ed\uc744 \ud1b5\uacfc\ud558\ub824\ub294 \uc801\uc744 \uc81c\uac70\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \ud329\ud1a0\ub9ac = \uc911\uc559 \uad00\ucc30 \uc9c0\uc810, \ub3c4\uc2ec \uacf5\uaca9 = \ub192\uc740 \uc704\uce58] \ud56d\uc0c1 \uc774\ub3d9\ud558\uba74\uc11c \uc801 \uc800\uaca9\uc218\uc758 \ud45c\uc801\uc73c\ub85c \ub418\uc9c0 \uc54a\ub3c4\ub85d \uc8fc\uc758\ud558\uc2ed\uc2dc\uc624."}, {"question": "Forward Assault Remix\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30\uc5d0 \ub0b4 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub124, Forward Assault Remix\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30\uc5d0 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uba3c\uc800 \ub450 \uae30\uae30 \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uac8c\uc784\uc740 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \uc0ac\uc6a9\ud558\ubbc0\ub85c \uc9c4\ud589 \uc0c1\ud669\uc774 \uc790\ub3d9\uc73c\ub85c \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, Android \ud734\ub300\ud3f0\uc5d0\uc11c iPhone\uc73c\ub85c \uc804\ud658\ud558\ub294 \uacbd\uc6b0 \uae30\uc874 \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uae30\ub9cc \ud558\uba74 \uc9c4\ud589 \uc0c1\ud669\uc774 \ubcf5\uc6d0\ub429\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc0c8 \uae30\uae30\uc5d0\uc11c \ub85c\uadf8\uc778 \u2192 \ub370\uc774\ud130 \ub3d9\uae30\ud654 \u2192 \uacc4\uc18d \ud50c\ub808\uc774] \uc774 \uae30\ub2a5\uc744 \ud1b5\ud574 \uc5b4\ub5a4 \uc131\ucde8\ub098 \uac8c\uc784 \ub0b4 \uad6c\ub9e4\ub3c4 \uc190\uc2e4\ud558\uc9c0 \uc54a\uace0 \uac8c\uc784\uc744 \uc6d0\ud65c\ud558\uac8c \uacc4\uc18d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Forward Assault Remix\uc5d0 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Forward Assault Remix\uc5d0\ub294 \uac8c\uc784\uc5d0 \uc7ac\ubbf8\ub97c \ub354\ud558\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uba87 \uac00\uc9c0 \uc788\uc2b5\ub2c8\ub2e4. \uc8fc\ubaa9\ud560 \ub9cc\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 '\ud329\ud1a0\ub9ac' \uc9c0\ub3c4\uc5d0 \uc228\uaca8\uc9c4 '\uace8\ub4e0 \uac74'\uc785\ub2c8\ub2e4. \ub4a4\ucabd \ucc3d\uace0\ub85c \uc774\ub3d9\ud558\uc5ec \ud45c\uc2dc\ub418\uc9c0 \uc54a\ub294 \uc791\uc740 \uc0c1\uc790\ub97c \ucc3e\uc73c\uc2ed\uc2dc\uc624. \uadf8 \uc548\uc5d0\ub294 \uace0\uc720\ud55c \uc0ac\uc6b4\ub4dc \ud6a8\uacfc\uc640 \uae08\uc0c9 \uc2a4\ud0a8\uc744 \uc81c\uacf5\ud558\ub294 \uace8\ub4e0 \uac74\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ud2b9\uc815 \ud45c\uc801\uc744 \ud2b9\uc815 \uc21c\uc11c\ub85c \uc3d8\ub294 \ud37c\uc990\uc744 \ud480\uc5b4 \uc811\uadfc\ud560 \uc218 \uc788\ub294 '\ub3c4\uc2ec \uacf5\uaca9' \uc9c0\ub3c4\uc758 \ube44\ubc00 \ubc29\uc785\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uac8c\uc784 \ub0b4 \ubcf4\ubb3c \ucc3e\uae30\uc640 \uac19\uc2b5\ub2c8\ub2e4. \ud0d0\uad6c\uc640 \ud638\uae30\uc2ec\uc744 \ubcf4\uc0c1\ud569\ub2c8\ub2e4.]"}]
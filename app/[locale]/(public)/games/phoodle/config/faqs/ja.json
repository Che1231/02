[{"question": "\u521d\u3081\u3066\u306e\u65b9\u5411\u3051\u306b\u3001Phoodle\u3092\u30d7\u30ec\u30a4\u3057\u3001\u57fa\u672c\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Phoodle\u3092\u30d7\u30ec\u30a4\u3059\u308b\u306b\u306f\u3001\u307e\u305a\u304a\u597d\u307f\u306e\u30a2\u30d7\u30ea\u30b9\u30c8\u30a2\u304b\u3089\u30b2\u30fc\u30e0\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u8d77\u52d5\u3059\u308b\u3068\u3001\u9650\u5b9a\u3055\u308c\u305f\u8a66\u884c\u56de\u6570\u306e\u4e2d\u3067\u6b63\u3057\u3044\u5358\u8a9e\u3092\u63a8\u6e2c\u3059\u308b\u30b3\u30a2\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u8aac\u660e\u3059\u308b\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u306b\u6848\u5185\u3055\u308c\u307e\u3059\u3002\u5404\u63a8\u6e2c\u306f\u3001\u6587\u5b57\u306e\u6b63\u89e3\u3068\u4f4d\u7f6e\u306b\u95a2\u3059\u308b\u30d5\u30a3\u30fc\u30c9\u30d0\u30c3\u30af\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u3042\u306a\u305f\u304c\u300cAPPLE\u300d\u3068\u63a8\u6e2c\u3057\u3001\u6b63\u3057\u3044\u5358\u8a9e\u304c\u300cGRAPE\u300d\u306e\u5834\u5408\u3001\u300cA\u300d\u3068\u300cP\u300d\u3068\u3044\u3046\u6587\u5b57\u304c\u9ec4\u8272\u3067\u5f37\u8abf\u8868\u793a\u3055\u308c\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u3053\u308c\u306f\u3001\u5358\u8a9e\u306e\u4e2d\u306b\u5b58\u5728\u3059\u308b\u3082\u306e\u306e\u3001\u9593\u9055\u3063\u305f\u4f4d\u7f6e\u306b\u3042\u308b\u3053\u3068\u3092\u793a\u3057\u3066\u3044\u307e\u3059\u3002\u3053\u306e\u5373\u5ea7\u306e\u30d5\u30a3\u30fc\u30c9\u30d0\u30c3\u30af\u306f\u3001\u5f8c\u7d9a\u306e\u63a8\u6e2c\u3092\u6d17\u7df4\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u3053\u308c\u306f\u3001\u305d\u308c\u305e\u308c\u306e\u63a8\u6e2c\u304c\u53ef\u80fd\u6027\u3092\u7d5e\u308a\u8fbc\u3080\u30af\u30ed\u30b9\u30ef\u30fc\u30c9\u30d1\u30ba\u30eb\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002]"}, {"question": "Phoodle\u3092\u30d7\u30ec\u30a4\u3057\u3066\u304b\u3089100\u6642\u9593\u5f8c\u3001\u63a8\u6e2c\u306e\u7cbe\u5ea6\u3092\u5411\u4e0a\u3055\u305b\u308b\u305f\u3081\u306e\u6700\u5584\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u63a8\u6e2c\u306e\u6226\u7565\u3092\u6700\u9069\u5316\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u4e00\u822c\u7684\u306a\u6bcd\u97f3\u3068\u5b50\u97f3\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u6301\u3064\u5358\u8a9e\u304b\u3089\u59cb\u3081\u307e\u3059\u3002\u300cCRANE\u300d\u306e\u3088\u3046\u306a\u5358\u8a9e\u304c\u826f\u3044\u3067\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d5\u30a3\u30fc\u30c9\u30d0\u30c3\u30af\u3092\u5206\u6790\u3057\u3066\u3001\u4e0d\u53ef\u80fd\u306a\u6587\u5b57\u3068\u4f4d\u7f6e\u3092\u6392\u9664\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300cC\u300d\u304c\u5358\u8a9e\u306e\u4e2d\u306b\u306a\u3044\u5834\u5408\u3001\u300cC\u300d\u3092\u542b\u3080\u5358\u8a9e\u3092\u5c06\u6765\u306e\u63a8\u6e2c\u3067\u907f\u3051\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u53ef\u80fd\u6027\u3092\u7d5e\u308a\u8fbc\u3080\u305f\u3081\u306b\u3001\u6d88\u53bb\u6cd5\u3092\u4f7f\u3044\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u5358\u8a9e\u306e\u4e2d\u306b\u300cE\u300d\u304c\u542b\u307e\u308c\u3001\u6700\u5f8c\u306e\u4f4d\u7f6e\u306b\u306f\u306a\u3044\u3053\u3068\u304c\u5206\u304b\u3063\u3066\u3044\u308b\u306a\u3089\u3001\u300cTABLE\u300d\u3084\u300cGRAPE\u300d\u306e\u3088\u3046\u306a\u5358\u8a9e\u3092\u8a66\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u4ee3\u66ff\u6848\u6bd4\u8f03\uff1a \u300cCRANE\u300d\u3068\u300cAUDIO\u300d\u3092\u6700\u521d\u306e\u5358\u8a9e\u3068\u3057\u3066\u6bd4\u8f03\u3059\u308b\u3053\u3068\u306f\u3001\u3069\u306e\u6226\u7565\u304c\u3042\u306a\u305f\u306b\u6700\u9069\u304b\u3092\u5224\u65ad\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002]"}, {"question": "Phoodle\u304c\u8a66\u884c\u56de\u6570\u3092\u5236\u9650\u3059\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u3053\u308c\u306f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "Phoodle\u306f\u8a66\u884c\u56de\u6570\u3092\u5236\u9650\u3059\u308b\u3053\u3068\u306b\u3088\u308a\u3001\u30b2\u30fc\u30e0\u306b\u30c1\u30e3\u30ec\u30f3\u30b8\u3068\u6226\u7565\u306e\u8981\u7d20\u3092\u52a0\u3048\u3066\u3044\u307e\u3059\u3002\u3053\u306e\u5236\u9650\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30d6\u30eb\u30fc\u30c8\u30d5\u30a9\u30fc\u30b9\u306b\u983c\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u5404\u63a8\u6e2c\u306b\u3064\u3044\u3066\u614e\u91cd\u306b\u8003\u3048\u308b\u3053\u3068\u3092\u5f37\u5236\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u30015\u6587\u5b57\u306e\u5358\u8a9e\u30926\u56de\u306e\u8a66\u884c\u3067\u63a8\u6e2c\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u5834\u5408\u3001\u5404\u63a8\u6e2c\u306f\u53ef\u80fd\u306a\u9650\u308a\u60c5\u5831\u304c\u8c4a\u5bcc\u3067\u306a\u3051\u308c\u3070\u306a\u308a\u307e\u305b\u3093\u3002\u3053\u306e\u5236\u9650\u306f\u3001\u73fe\u5b9f\u4e16\u754c\u306e\u554f\u984c\u89e3\u6c7a\u306e\u5834\u9762\uff08\u30ea\u30bd\u30fc\u30b9\u304c\u9650\u3089\u308c\u3066\u3044\u308b\u5834\u5408\uff09\u3092\u53cd\u6620\u3057\u3066\u3044\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u9650\u3089\u308c\u305f\u624b\u304c\u304b\u308a\u3067\u8b0e\u3092\u89e3\u304f\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u305d\u308c\u305e\u308c\u306e\u63a8\u6e2c\u306f\u6b63\u78ba\u3067\u719f\u616e\u3055\u308c\u3066\u3044\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002]"}, {"question": "Phoodle\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u6700\u7d42\u30b9\u30b3\u30a2\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u308b\u8981\u7d20\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Phoodle\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6b63\u3057\u3044\u5358\u8a9e\u3092\u63a8\u6e2c\u3059\u308b\u306e\u306b\u5fc5\u8981\u306a\u8a66\u884c\u56de\u6570\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u5c11\u306a\u3044\u8a66\u884c\u56de\u6570\u306f\u3001\u9ad8\u3044\u30b9\u30b3\u30a2\u306b\u7e4b\u304c\u308a\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30b2\u30fc\u30e0\u306f\u5358\u8a9e\u306e\u8907\u96d1\u3055\u3068\u3001\u5404\u63a8\u6e2c\u306b\u304b\u304b\u3063\u305f\u6642\u9593\u3092\u8003\u616e\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300cGRAPE\u300d\u30923\u56de\u306e\u8a66\u884c\u3067\u63a8\u6e2c\u3059\u308b\u3068\u3001\u300cGRAPE\u300d\u30926\u56de\u306e\u8a66\u884c\u3067\u63a8\u6e2c\u3059\u308b\u3088\u308a\u3082\u9ad8\u3044\u30b9\u30b3\u30a2\u306b\u306a\u308a\u307e\u3059\u3002[\u69cb\u6210\u8868\uff1a\u8a66\u884c\u56de\u6570\u3068\u5358\u8a9e\u306e\u8907\u96d1\u3055\u306b\u57fa\u3065\u3044\u305f\u30b9\u30b3\u30a2\u306e\u6bd4\u8f03\u8868\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u3069\u306e\u3088\u3046\u306b\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3059\u308b\u304b\u3092\u7406\u89e3\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002]"}, {"question": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067Phoodle\u3092\u5b9f\u884c\u3059\u308b\u305f\u3081\u306e\u6280\u8853\u7684\u306a\u8981\u4ef6\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u306f\u3069\u306e\u3088\u3046\u306b\u6bd4\u8f03\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Phoodle\u306f\u8efd\u91cf\u3067\u3001\u5e45\u5e83\u3044\u30c7\u30d0\u30a4\u30b9\u3068\u4e92\u63db\u6027\u304c\u3042\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002iOS\u306e\u5834\u5408\u3001iOS 12.0\u4ee5\u964d\u304c\u5fc5\u8981\u3067\u3059\u3002Android\u306e\u5834\u5408\u306f\u3001Android 6.0\u4ee5\u964d\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b2\u30fc\u30e0\u306e\u30df\u30cb\u30de\u30eb\u306a\u30c7\u30b6\u30a4\u30f3\u306f\u3001\u53e4\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u3082\u30b9\u30e0\u30fc\u30ba\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001iOS 12\u3092\u5b9f\u884c\u3057\u3066\u3044\u308biPhone 6s\u306fPhoodle\u3092\u554f\u984c\u306a\u304f\u5b9f\u884c\u3067\u304d\u307e\u3059\u3002\u307e\u305f\u30012GB\u306eRAM\u3092\u642d\u8f09\u3057\u305f\u4e88\u7b97\u578b\u306eAndroid\u643a\u5e2f\u96fb\u8a71\u3067\u3082\u826f\u597d\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u767a\u63ee\u3057\u307e\u3059\u3002[\u69cb\u6210\u8868\uff1aiOS\u3068Android\u306e\u6280\u8853\u4ed5\u69d8\u306e\u6bd4\u8f03\u8868\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u81ea\u5206\u306e\u30c7\u30d0\u30a4\u30b9\u304c\u4e92\u63db\u6027\u304c\u3042\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002]"}, {"question": "\u30c7\u30fc\u30bf\u3092\u5931\u3046\u3053\u3068\u306a\u304f\u3001Phoodle\u306e\u9032\u884c\u72b6\u6cc1\u3092\u5225\u306e\u30c7\u30d0\u30a4\u30b9\u306b\u79fb\u884c\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Phoodle\u306e\u9032\u884c\u72b6\u6cc1\u3092\u79fb\u884c\u3059\u308b\u306b\u306f\u3001\u30b2\u30fc\u30e0\u8a2d\u5b9a\u3067\u5229\u7528\u53ef\u80fd\u306a\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u73fe\u5728\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u8a2d\u5b9a\u306b\u79fb\u52d5\u3057\u3001\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u6709\u52b9\u306b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u3092\u518d\u5ea6\u6709\u52b9\u306b\u3057\u3066\u3001\u9032\u884c\u72b6\u6cc1\u3092\u540c\u671f\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u4ee5\u524d\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u30ec\u30d9\u30eb20\u307e\u3067\u9032\u3081\u3066\u3044\u305f\u5834\u5408\u3001\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067\u3082\u30ec\u30d9\u30eb20\u304b\u3089\u59cb\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002 [\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u79fb\u884c\u624b\u9806\u3092\u8aac\u660e\u3059\u308b\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u624b\u9806\u306b\u5f93\u3046\u3053\u3068\u3092\u5bb9\u6613\u306b\u3057\u307e\u3059\u3002]"}, {"question": "\u5e83\u7bc4\u56f2\u306b\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001Phoodle\u3067\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Phoodle\u306f\u3001\u71b1\u5fc3\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u305f\u3081\u306b\u3001\u3044\u304f\u3064\u304b\u306e\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u542b\u3093\u3067\u3044\u307e\u3059\u3002\u305d\u306e1\u3064\u306f\u3001\u300c\u30b4\u30fc\u30eb\u30c7\u30f3\u30ef\u30fc\u30c9\u300d\u30e2\u30fc\u30c9\u3067\u3059\u3002\u3053\u308c\u306f\u3001\u9023\u7d9a\u3057\u3066100\u56de\u6b63\u89e3\u3059\u308b\u3068\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u3053\u306e\u30e2\u30fc\u30c9\u3067\u306f\u3001\u63a8\u6e2c\u3059\u308b\u5358\u8a9e\u304c\u91d1\u8272\u3067\u5f37\u8abf\u8868\u793a\u3055\u308c\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u305d\u308c\u3092\u6b63\u3057\u304f\u63a8\u6e2c\u3059\u308b\u3068\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u3082\u30461\u3064\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u300c\u79d8\u5bc6\u306e\u8f9e\u66f8\u300d\u3067\u3059\u3002\u30e1\u30a4\u30f3\u30e1\u30cb\u30e5\u30fc\u3067\u5de6\u306b3\u56de\u30b9\u30ef\u30a4\u30d7\u3059\u308b\u3068\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u8f9e\u66f8\u306b\u306f\u3001\u30b2\u30fc\u30e0\u3067\u4f7f\u7528\u3067\u304d\u308b\u73cd\u3057\u3044\u304a\u3088\u3073\u73cd\u3057\u3044\u5358\u8a9e\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u3053\u308c\u3089\u306e\u6a5f\u80fd\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u306f\u3001\u5e83\u5927\u306a\u672a\u958b\u306e\u9818\u57df\u306b\u3042\u308b\u96a0\u3055\u308c\u305f\u5b9d\u7269\u3092\u898b\u3064\u3051\u308b\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002]"}, {"question": "Phoodle\u306e\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u5404\u5358\u8a9e\u306e\u96e3\u6613\u5ea6\u3092\u3069\u306e\u3088\u3046\u306b\u6c7a\u5b9a\u3057\u307e\u3059\u304b\uff1f\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3053\u308c\u3089\u3092\u5f71\u97ff\u3055\u305b\u308b\u3053\u3068\u306f\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Phoodle\u306e\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u306f\u3001\u5358\u8a9e\u306e\u9577\u3055\u3001\u8907\u96d1\u3055\u3001\u82f1\u8a9e\u3067\u306e\u4f7f\u7528\u983b\u5ea6\u306b\u57fa\u3065\u3044\u3066\u3001\u5358\u8a9e\u306b\u96e3\u6613\u5ea6\u30ec\u30d9\u30eb\u3092\u5272\u308a\u5f53\u3066\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300cGRAPE\u300d\u306e\u3088\u3046\u306a5\u6587\u5b57\u306e\u5358\u8a9e\u306f\u3001\u300cZYGOTIC\u300d\u306e\u3088\u3046\u306a7\u6587\u5b57\u306e\u5358\u8a9e\u3088\u308a\u3082\u7c21\u5358\u3068\u8003\u3048\u3089\u308c\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u7570\u306a\u308b\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u3092\u9078\u629e\u3059\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u3001\u96e3\u6613\u5ea6\u3092\u8abf\u6574\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u7c21\u5358\u30e2\u30fc\u30c9\u300d\u3067\u306f\u77ed\u3044\u5358\u8a9e\u3001\u300c\u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\u300d\u3067\u306f\u9577\u3044\u8907\u96d1\u306a\u5358\u8a9e\u3092\u9078\u629e\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u69cb\u6210\u8868\uff1a\u7570\u306a\u308b\u30e2\u30fc\u30c9\u306e\u5358\u8a9e\u96e3\u6613\u5ea6\u30ec\u30d9\u30eb\u3092\u793a\u3059\u8868\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u81ea\u5206\u306e\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u306b\u5408\u3063\u305f\u6311\u6226\u3092\u9078\u629e\u3059\u308b\u306e\u3092\u52a9\u3051\u307e\u3059\u3002]"}, {"question": "Phoodle\u3067\u3001\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u3088\u304f\u72af\u3059\u4e00\u822c\u7684\u306a\u9593\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u3092\u3069\u306e\u3088\u3046\u306b\u907f\u3051\u3089\u308c\u307e\u3059\u304b\uff1f", "answer": "\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u6226\u7565\u306a\u3057\u3067\u30e9\u30f3\u30c0\u30e0\u306a\u5358\u8a9e\u3092\u63a8\u6e2c\u3057\u3066\u3057\u307e\u3046\u3068\u3044\u3046\u9593\u9055\u3044\u3092\u3057\u3070\u3057\u3070\u72af\u3057\u3001\u8a66\u884c\u3092\u7121\u99c4\u306b\u3057\u3066\u3057\u307e\u3044\u307e\u3059\u3002\u3082\u3046\u4e00\u3064\u306e\u4e00\u822c\u7684\u306a\u9593\u9055\u3044\u306f\u3001\u5404\u63a8\u6e2c\u5f8c\u306b\u4e0e\u3048\u3089\u308c\u308b\u30d5\u30a3\u30fc\u30c9\u30d0\u30c3\u30af\u3092\u7121\u8996\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u3053\u308c\u3089\u306e\u30a8\u30e9\u30fc\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u3001\u4e00\u822c\u7684\u306a\u6bcd\u97f3\u3068\u5b50\u97f3\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u6301\u3064\u5358\u8a9e\uff08\u4f8b\uff1a\u300cCRANE\u300d\uff09\u304b\u3089\u5e38\u306b\u59cb\u3081\u307e\u3059\u3002\u30d5\u30a3\u30fc\u30c9\u30d0\u30c3\u30af\u306b\u6ce8\u610f\u6df1\u304f\u6ce8\u610f\u3092\u6255\u3044\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u300cA\u300d\u304c\u5358\u8a9e\u306e\u4e2d\u306b\u3042\u308a\u3001\u6700\u521d\u306e\u4f4d\u7f6e\u306b\u306f\u306a\u3044\u5834\u5408\u3001\u6b21\u306e\u63a8\u6e2c\u3092\u305d\u308c\u306b\u5fdc\u3058\u3066\u8abf\u6574\u3057\u307e\u3059\u3002[\u4ee3\u66ff\u6848\u6bd4\u8f03\uff1a\u52b9\u679c\u7684\u306a\u63a8\u6e2c\u6226\u7565\u3068\u975e\u52b9\u7387\u7684\u306a\u63a8\u6e2c\u6226\u7565\u3092\u6bd4\u8f03\u3059\u308b\u3053\u3068\u306f\u3001\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u69cb\u9020\u5316\u3055\u308c\u305f\u30a2\u30d7\u30ed\u30fc\u30c1\u306e\u91cd\u8981\u6027\u3092\u7406\u89e3\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002]"}, {"question": "Phoodle\u306e\u30c7\u30a4\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u30e2\u30fc\u30c9\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u53c2\u52a0\u3059\u308b\u30e1\u30ea\u30c3\u30c8\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Phoodle\u306e\u30c7\u30a4\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u30e2\u30fc\u30c9\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u6bce\u65e5\u63a8\u6e2c\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u30e6\u30cb\u30fc\u30af\u306a\u5358\u8a9e\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u3053\u306e\u30e2\u30fc\u30c9\u306f\u3001\u3042\u306a\u305f\u306e\u30b9\u30ad\u30eb\u3092\u30c6\u30b9\u30c8\u3057\u3001\u30b2\u30fc\u30e0\u3092\u65b0\u9bae\u306b\u4fdd\u3064\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u53c2\u52a0\u306e\u30e1\u30ea\u30c3\u30c8\u306b\u306f\u3001\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3059\u308b\u3001\u7279\u5225\u306a\u9054\u6210\u4e8b\u9805\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u3001\u305d\u3057\u3066\u3042\u306a\u305f\u306e\u5168\u4f53\u7684\u306a\u63a8\u6e2c\u6226\u7565\u3092\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30c7\u30a4\u30ea\u30fc\u30ef\u30fc\u30c9\u300cZYGOTIC\u300d\u3092\u6210\u529f\u3057\u3066\u63a8\u6e2c\u3059\u308b\u3068\u300150\u30dd\u30a4\u30f3\u30c8\u306e\u30dc\u30fc\u30ca\u30b9\u3068\u7279\u5225\u306a\u30d0\u30c3\u30b8\u304c\u4e0e\u3048\u3089\u308c\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002[\u6bd4\u55a9\uff1a\u30c7\u30a4\u30ea\u30fc\u30c1\u30e3\u30ec\u30f3\u30b8\u306f\u3001\u3042\u306a\u305f\u306e\u5fc3\u3092\u30b7\u30e3\u30fc\u30d7\u306b\u4fdd\u3061\u3001\u6b21\u306e\u30d1\u30ba\u30eb\u3092\u6e96\u5099\u3059\u308b\u305f\u3081\u306e\u30df\u30cb\u8a66\u9a13\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002]"}]
[{"question": "\ucd08\ubcf4\uc790\uac00 Phoodle\uc744 \uc2dc\uc791\ud558\uace0 \uae30\ubcf8 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Phoodle\uc744 \uc2dc\uc791\ud558\ub824\uba74 \uba3c\uc800 \uc6d0\ud558\ub294 \uc571 \uc2a4\ud1a0\uc5b4\uc5d0\uc11c \uac8c\uc784\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc138\uc694. \uc2e4\ud589\ud558\uba74 \uc81c\ud55c\ub41c \uc2dc\ub3c4 \ud69f\uc218 \ub0b4\uc5d0\uc11c \uc62c\ubc14\ub978 \ub2e8\uc5b4\ub97c \ucd94\uce21\ud558\ub294 \ud575\uc2ec \uba54\ucee4\ub2c8\uc998\uc744 \uc124\uba85\ud558\ub294 \ud29c\ud1a0\ub9ac\uc5bc\uc774 \uc548\ub0b4\ud569\ub2c8\ub2e4. \uac01 \ucd94\uce21\uc740 \ubb38\uc790\uc758 \uc815\ud655\uc131\uacfc \uc704\uce58\uc5d0 \ub300\ud55c \ud53c\ub4dc\ubc31\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc0ac\uacfc'\ub97c \ucd94\uce21\ud558\uace0 \uc62c\ubc14\ub978 \ub2e8\uc5b4\uac00 '\ud3ec\ub3c4'\ub77c\uba74, '\uc0ac'\uc640 '\uacfc' \ubb38\uc790\uac00 \ub178\ub780\uc0c9\uc73c\ub85c \uac15\uc870 \ud45c\uc2dc\ub418\uc5b4 \ub2e8\uc5b4\uc5d0 \uc788\uc9c0\ub9cc \uc798\ubabb\ub41c \uc704\uce58\uc784\uc744 \ub098\ud0c0\ub0c5\ub2c8\ub2e4. \uc774 \uc989\uac01\uc801\uc778 \ud53c\ub4dc\ubc31\uc740 \ud6c4\uc18d \ucd94\uce21\uc744 \uac1c\uc120\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc774\ub294 \uac01 \ucd94\uce21\uc73c\ub85c \uac00\ub2a5\uc131\uc744 \uc881\ud788\ub294 \ub2e8\uc5b4\ud37c\uc990\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "100\uc2dc\uac04 \ud50c\ub808\uc774 \ud6c4 Phoodle\uc5d0\uc11c \ucd94\uce21 \uc815\ud655\ub3c4\ub97c \ud5a5\uc0c1\uc2dc\ud0a4\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "100\uc2dc\uac04 \ud50c\ub808\uc774 \ud6c4 \ucd94\uce21 \uc804\ub7b5\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ub370 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. STEP1: \uc77c\ubc18\uc801\uc778 \ubaa8\uc74c\uacfc \uc790\uc74c\uc774 \ud63c\ud569\ub41c \ub2e8\uc5b4\ub85c \uc2dc\uc791\ud558\uc138\uc694, \uc608\ub97c \ub4e4\uc5b4 '\ud559', STEP2: \ud53c\ub4dc\ubc31\uc744 \ubd84\uc11d\ud558\uc5ec \ubd88\uac00\ub2a5\ud55c \ubb38\uc790 \ubc0f \uc704\uce58\ub97c \uc81c\uac70\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\ud559'\uc774 \ub2e8\uc5b4\uc5d0 \uc5c6\ub2e4\uba74 \ubbf8\ub798\uc758 \ucd94\uce21\uc5d0\uc11c '\ud559'\uc774 \ud3ec\ud568\ub41c \ub2e8\uc5b4\ub97c \ud53c\ud558\uc138\uc694. STEP3: \uac00\ub2a5\uc131\uc744 \uc881\ud788\uae30 \uc704\ud574 \uc18c\uac70\ubc95\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub2e8\uc5b4\uc5d0 '\uc5b4'\uac00 \uc788\uc9c0\ub9cc \ub9c8\uc9c0\ub9c9 \uc704\uce58\uc5d0 \uc5c6\ub2e4\ub294 \uac83\uc744 \uc54c\uace0 \uc788\ub2e4\uba74, '\ud45c'\ub098 '\ud3ec\ub3c4'\uc640 \uac19\uc740 \ub2e8\uc5b4\ub97c \uc2dc\ub3c4\ud558\uc138\uc694. [\ub2e4\uc911 \uc194\ub8e8\uc158 \ube44\uad50: '\ud559' \ub300 '\uc624\ub514\uc624'\ub97c \uc2dc\uc791 \ub2e8\uc5b4\ub85c \ube44\uad50\ud558\uba74 \uc5b4\ub5a4 \uc804\ub7b5\uc774 \uc790\uc2e0\uc5d0\uac8c \uac00\uc7a5 \uc801\ud569\ud55c\uc9c0 \uacb0\uc815\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "Phoodle\uc774 \ucd94\uce21 \ud69f\uc218\ub97c \uc81c\ud55c\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "Phoodle\uc740 \uac8c\uc784\uc5d0 \ub3c4\uc804\uacfc \uc804\ub7b5\uc131\uc744 \ucd94\uac00\ud558\uae30 \uc704\ud574 \ucd94\uce21 \ud69f\uc218\ub97c \uc81c\ud55c\ud569\ub2c8\ub2e4. \uc774 \uc81c\uc57d\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \ubb34\ucc28\ubcc4 \ub300\uc785\uc5d0 \uc758\uc874\ud558\uae30\ubcf4\ub2e4\ub294 \uac01 \ucd94\uce21\uc5d0 \ub300\ud574 \uae4a\uc774 \uc0dd\uac01\ud558\ub3c4\ub85d \uac15\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 5\uae00\uc790 \ub2e8\uc5b4\ub97c 6\ubc88\uc758 \uc2dc\ub3c4\ub9cc\uc73c\ub85c \ucd94\uce21\ud574\uc57c \ud55c\ub2e4\uba74, \uac01 \ucd94\uce21\uc740 \uac00\ub2a5\ud55c \ud55c \uc815\ubcf4\uac00 \ud48d\ubd80\ud574\uc57c\ub9cc \ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc81c\ud55c\uc740 \uc2e4\uc81c \ubb38\uc81c \ud574\uacb0 \uc2dc\ub098\ub9ac\uc624\uc5d0\uc11c \uc790\uc6d0\uc774 \uc81c\ud55c\uc801\uc778 \uc0c1\ud669\uc744 \ubc18\uc601\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc81c\ud55c\ub41c \ub2e8\uc11c\ub97c \uac00\uc9c0\uace0 \ubbf8\uc2a4\ud130\ub9ac\ub97c \ud478\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uac01 \ucd94\uce21\uc740 \uc815\ud655\ud558\uace0 \uc2e0\uc911\ud558\uac8c \uace0\ub824\ud574\uc57c \ud569\ub2c8\ub2e4.]"}, {"question": "Phoodle\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \ucd5c\uc885 \uc810\uc218\uc5d0 \uc5b4\ub5a4 \uc694\uc778\uc774 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "Phoodle\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc62c\ubc14\ub978 \ub2e8\uc5b4\ub97c \ucd94\uce21\ud558\ub294 \ub370 \uac78\ub9ac\ub294 \uc2dc\ub3c4 \ud69f\uc218\ub97c \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. \uc2dc\ub3c4 \ud69f\uc218\uac00 \uc801\uc744\uc218\ub85d \uc810\uc218\uac00 \ub192\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uac8c\uc784\uc740 \ub2e8\uc5b4\uc758 \ubcf5\uc7a1\uc131\uacfc \uac01 \ucd94\uce21\uc5d0 \uac78\ub9b0 \uc2dc\uac04\uc744 \uace0\ub824\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud3ec\ub3c4'\ub97c 3\ubc88\uc758 \uc2dc\ub3c4\ub85c \ucd94\uce21\ud558\uba74 6\ubc88\uc758 \uc2dc\ub3c4\ub85c \ucd94\uce21\ud558\ub294 \uac83\ubcf4\ub2e4 \ub354 \ub192\uc740 \uc810\uc218\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \uc2dc\ub3c4 \ud69f\uc218\uc640 \ub2e8\uc5b4\uc758 \ubcf5\uc7a1\uc131\uc744 \uae30\ubc18\uc73c\ub85c \uc810\uc218\ub97c \ube44\uad50\ud558\ub294 \ud45c\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uc810\uc218\ub97c \uadf9\ub300\ud654\ud558\ub294 \ubc29\ubc95\uc744 \uc774\ud574\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c Phoodle\uc744 \uc2e4\ud589\ud558\uae30 \uc704\ud55c \uae30\uc220\uc801\uc778 \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ube44\uad50\ub429\ub2c8\uae4c?", "answer": "Phoodle\uc740 \ub2e4\uc591\ud55c \uae30\uae30\uc640 \ud638\ud658\ub418\ub3c4\ub85d \uc124\uacc4\ub418\uc5b4 \uac00\ubccd\uc2b5\ub2c8\ub2e4. iOS\uc758 \uacbd\uc6b0 iOS 12.0 \uc774\uc0c1\uc774 \ud544\uc694\ud558\uba70, Android\uc758 \uacbd\uc6b0 Android 6.0 \uc774\uc0c1\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uac8c\uc784\uc758 \ucd5c\uc18c\ud55c \ub514\uc790\uc778\uc740 \uad6c\ud615 \uae30\uae30\uc5d0\uc11c\ub3c4 \uc6d0\ud65c\ud55c \uc131\ub2a5\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, iOS 12\ub97c \uc2e4\ud589\ud558\ub294 iPhone 6s\ub294 Phoodle\uc744 \ubb38\uc81c\uc5c6\uc774 \uc2e4\ud589\ud560 \uc218 \uc788\uc73c\uba70, 2GB RAM\uc774 \uc7a5\ucc29\ub41c \uc800\ub834\ud55c \uc548\ub4dc\ub85c\uc774\ub4dc \ud734\ub300\ud3f0\ub3c4 \uc798 \uc791\ub3d9\ud569\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: iOS \ubc0f Android\uc6a9 \uae30\uc220 \uc694\uad6c \uc0ac\ud56d\uc744 \ube44\uad50\ud558\ub294 \ud45c\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uc790\uc2e0\uc774 \uc0ac\uc6a9\ud558\ub294 \uae30\uae30\uac00 \ud638\ud658\ub418\ub294\uc9c0 \ud655\uc778\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ub370\uc774\ud130 \uc190\uc2e4 \uc5c6\uc774 \ud55c \uae30\uae30\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30\ub85c Phoodle \uc9c4\ud589 \uc0c1\ud669\uc744 \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Phoodle \uc9c4\ud589 \uc0c1\ud669\uc744 \ub9c8\uc774\uadf8\ub808\uc774\uc158\ud558\ub824\uba74 \uac8c\uc784 \uc124\uc815\uc5d0\uc11c \uc0ac\uc6a9 \uac00\ub2a5\ud55c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. STEP1: \ud604\uc7ac \uae30\uae30\uc5d0\uc11c \uc124\uc815\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ud65c\uc131\ud654\ud569\ub2c8\ub2e4. STEP2: \uc0c8 \uae30\uae30\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. STEP3: \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5\uc744 \ub2e4\uc2dc \ud65c\uc131\ud654\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc774\uc804 \uae30\uae30\uc5d0\uc11c 20\ub808\ubca8\uc774\uc5c8\ub2e4\uba74, \uc0c8 \uae30\uae30\uc5d0\uc11c 20\ub808\ubca8\ubd80\ud130 \uc2dc\uc791\ud569\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \ub9c8\uc774\uadf8\ub808\uc774\uc158 \ud504\ub85c\uc138\uc2a4\ub97c \ubcf4\uc5ec\uc8fc\ub294 \ud750\ub984\ub3c4\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \ub2e8\uacc4\ub97c \ub354 \uc27d\uac8c \ub530\ub77c\uac08 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4.]"}, {"question": "\uad11\ubc94\uc704\ud55c \ud50c\ub808\uc774 \ud6c4 Phoodle\uc5d0\uc11c \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uae30\ub2a5\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Phoodle\uc5d0\ub294 \ud5cc\uc2e0\uc801\uc778 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \uc5ec\ub7ec \uc228\uaca8\uc9c4 \uae30\ub2a5\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uae30\ub2a5 \uc911 \ud558\ub098\ub294 100\ubc88 \uc5f0\uc18d\uc73c\ub85c \uc62c\ubc14\ub978 \ucd94\uce21\uc744 \ud55c \ud6c4 \ud65c\uc131\ud654\ub418\ub294 '\uace8\ub4e0 \uc6cc\ub4dc' \ubaa8\ub4dc\uc785\ub2c8\ub2e4. \uc774 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \ucd94\uce21\ud560 \ub2e8\uc5b4\uac00 \uae08\uc0c9\uc73c\ub85c \uac15\uc870 \ud45c\uc2dc\ub418\uace0, \ud50c\ub808\uc774\uc5b4\ub294 \uc62c\ubc14\ub974\uac8c \ucd94\uce21\ud558\uba74 \ubcf4\ub108\uc2a4 \uc810\uc218\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \ub2e4\ub978 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uba54\uc778 \uba54\ub274\uc5d0\uc11c \uc67c\ucabd\uc73c\ub85c 3\ubc88 \uc4f8\uc5b4\ub0b4\ub9ac\uba74 \uc561\uc138\uc2a4\ud560 \uc218 \uc788\ub294 '\ube44\ubc00 \uc0ac\uc804'\uc785\ub2c8\ub2e4. \uc774 \uc0ac\uc804\uc5d0\ub294 \uac8c\uc784\uc5d0\uc11c \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \ub4dc\ubb38 \ubc0f \uc5b4\ub824\uc6b4 \ub2e8\uc5b4\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc774\ub7ec\ud55c \uae30\ub2a5\uc744 \ubc1c\uacac\ud558\ub294 \uac83\uc740 \uad11\ud65c\ud558\uace0 \ubbf8\uc9c0\uc758 \uc9c0\uc5ed\uc5d0\uc11c \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uc744 \ucc3e\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "Phoodle\uc758 \uc54c\uace0\ub9ac\uc998\uc740 \uac01 \ub2e8\uc5b4\uc758 \ub09c\uc774\ub3c4\ub97c \uc5b4\ub5bb\uac8c \uacb0\uc815\ud558\uba70 \ud50c\ub808\uc774\uc5b4\uac00 \uc774\ub97c \uc601\ud5a5\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Phoodle\uc758 \uc54c\uace0\ub9ac\uc998\uc740 \ub2e8\uc5b4\uc758 \uae38\uc774, \ubcf5\uc7a1\uc131 \ubc0f \uc601\uc5b4\uc5d0\uc11c\uc758 \uc0ac\uc6a9 \ube48\ub3c4\ub97c \uae30\ubc18\uc73c\ub85c \ub2e8\uc5b4\uc5d0 \ub09c\uc774\ub3c4 \ub808\ubca8\uc744 \ud560\ub2f9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud3ec\ub3c4'\uc640 \uac19\uc740 5\uae00\uc790 \ub2e8\uc5b4\ub294 '\uc720\uc804\uc790'\uc640 \uac19\uc740 7\uae00\uc790 \ub2e8\uc5b4\ubcf4\ub2e4 \uc26c\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\ub294 '\uc26c\uc6b4 \ubaa8\ub4dc'\uc640 \uac19\uc774 \uc9e7\uc740 \ub2e8\uc5b4\ub97c \uc704\ud55c \ubaa8\ub4dc \ub610\ub294 '\uc5b4\ub824\uc6b4 \ubaa8\ub4dc'\uc640 \uac19\uc774 \uae38\uace0 \ubcf5\uc7a1\ud55c \ub2e8\uc5b4\ub97c \uc704\ud55c \ubaa8\ub4dc\ub97c \uc120\ud0dd\ud558\uc5ec \ub09c\uc774\ub3c4\uc5d0 \uc601\ud5a5\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \uc11c\ub85c \ub2e4\ub978 \ubaa8\ub4dc\uc5d0\uc11c \ub2e8\uc5b4 \ub09c\uc774\ub3c4 \uc218\uc900\uc744 \ubcf4\uc5ec\uc8fc\ub294 \ud45c\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uc790\uc2e0\uc758 \ub808\ubca8\uc5d0 \ub9de\ub294 \ub3c4\uc804\uc744 \uc120\ud0dd\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "Phoodle\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \uc790\uc8fc \uc800\uc9c0\ub974\ub294 \uac00\uc7a5 \uc77c\ubc18\uc801\uc778 \uc2e4\uc218\ub294 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub294 \uc885\uc885 \uc804\ub7b5 \uc5c6\uc774 \ubb34\uc791\uc704 \ub2e8\uc5b4\ub97c \ucd94\uce21\ud558\uc5ec \uc2dc\ub3c4\ub97c \ub0ad\ube44\ud558\ub294 \uc2e4\uc218\ub97c \uc800\uc9c0\ub985\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uc77c\ubc18\uc801\uc778 \uc2e4\uc218\ub294 \uac01 \ucd94\uce21 \ud6c4 \uc81c\uacf5\ub418\ub294 \ud53c\ub4dc\ubc31\uc744 \ubb34\uc2dc\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc624\ub958\ub97c \ud53c\ud558\ub824\uba74 \uc77c\ubc18\uc801\uc778 \ubaa8\uc74c\uacfc \uc790\uc74c\uc774 \ud63c\ud569\ub41c \ub2e8\uc5b4, \uc608\ub97c \ub4e4\uc5b4 '\ud559'\uacfc \uac19\uc740 \ub2e8\uc5b4\ub85c \ud56d\uc0c1 \uc2dc\uc791\ud558\uc138\uc694. \ud53c\ub4dc\ubc31\uc5d0 \uc8fc\uc758\ub97c \uae30\uc6b8\uc774\uc138\uc694; \uc608\ub97c \ub4e4\uc5b4, '\uc5b4'\uac00 \ub2e8\uc5b4\uc5d0 \uc788\uc9c0\ub9cc \uccab \ubc88\uc9f8 \uc704\uce58\uc5d0 \uc5c6\ub2e4\uba74 \ub2e4\uc74c \ucd94\uce21\uc744 \uadf8\uc5d0 \ub530\ub77c \uc870\uc815\ud558\uc138\uc694. [\ub2e4\uc911 \uc194\ub8e8\uc158 \ube44\uad50: \ud6a8\uacfc\uc801\uc778 \ucd94\uce21 \uc804\ub7b5\uacfc \ube44\ud6a8\uacfc\uc801\uc778 \ucd94\uce21 \uc804\ub7b5\uc744 \ube44\uad50\ud558\uba74 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \uccb4\uacc4\uc801\uc778 \uc811\uadfc \ubc29\uc2dd\uc758 \uc911\uc694\uc131\uc744 \uc774\ud574\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "Phoodle\uc758 \uc77c\uc77c \ucc4c\ub9b0\uc9c0 \ubaa8\ub4dc\ub294 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \ucc38\uc5ec\ud558\ub294 \uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Phoodle\uc758 \uc77c\uc77c \ucc4c\ub9b0\uc9c0 \ubaa8\ub4dc\ub294 \ub9e4\uc77c \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ucd94\uce21\ud560 \ub3c5\ud2b9\ud55c \ub2e8\uc5b4\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc774 \ubaa8\ub4dc\ub294 \ud50c\ub808\uc774\uc5b4\uc758 \uae30\uc220\uc744 \uc2dc\ud5d8\ud558\uace0 \uac8c\uc784\uc744 \uc0c8\ub86d\uac8c \uc720\uc9c0\ud558\ub294 \ub370 \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ucc38\uc5ec\ud558\ub294 \uc774\uc810\uc5d0\ub294 \ubcf4\ub108\uc2a4 \ud3ec\uc778\ud2b8 \ud68d\ub4dd, \ud2b9\ubcc4\ud55c \uc5c5\uc801 \ud574\uc81c \ubc0f \uc804\uccb4 \ucd94\uce21 \uc804\ub7b5 \ud5a5\uc0c1\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc77c\uc77c \ub2e8\uc5b4\uc778 '\uc720\uc804\uc790'\ub97c \uc131\uacf5\uc801\uc73c\ub85c \ucd94\uce21\ud558\uba74 50\uac1c\uc758 \ubcf4\ub108\uc2a4 \ud3ec\uc778\ud2b8\uc640 \ud2b9\ubcc4\ud55c \ubc30\uc9c0\ub97c \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc77c\uc77c \ucc4c\ub9b0\uc9c0\ub294 \ub9c8\uc74c\uc744 \ub0a0\uce74\ub86d\uac8c \uc720\uc9c0\ud558\uace0 \ub2e4\uc74c \ud37c\uc990\uc5d0 \ub300\ube44\ud558\ub294 \ubbf8\ub2c8 \uc2dc\ud5d8\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}]
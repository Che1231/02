[{"question": "\u521d\u5b66\u8005\u5982\u4f55\u5f00\u59cb\u73a9Phoodle\u5e76\u7406\u89e3\u5176\u57fa\u672c\u673a\u5236\uff1f", "answer": "\u8981\u5f00\u59cb\u73a9Phoodle\uff0c\u9996\u5148\u9700\u8981\u4ece\u60a8\u559c\u6b22\u7684\u5e94\u7528\u5546\u5e97\u4e0b\u8f7d\u6e38\u620f\u3002\u542f\u52a8\u6e38\u620f\u540e\uff0c\u60a8\u5c06\u88ab\u5f15\u5bfc\u5b8c\u6210\u6559\u7a0b\uff0c\u8be5\u6559\u7a0b\u89e3\u91ca\u4e86\u6838\u5fc3\u673a\u5236\uff1a\u5728\u6709\u9650\u7684\u5c1d\u8bd5\u6b21\u6570\u5185\u731c\u6d4b\u6b63\u786e\u7684\u5355\u8bcd\u3002\u6bcf\u6b21\u731c\u6d4b\u90fd\u4f1a\u63d0\u4f9b\u5173\u4e8e\u5b57\u6bcd\u6b63\u786e\u6027\u548c\u4f4d\u7f6e\u7684\u53cd\u9988\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u731c\u6d4b\u300eAPPLE\u300f\u800c\u6b63\u786e\u7684\u5355\u8bcd\u662f\u300eGRAPE\u300f\uff0c\u5b57\u6bcd\u300eA\u300f\u548c\u300eP\u300f\u53ef\u80fd\u4f1a\u4ee5\u9ec4\u8272\u7a81\u51fa\u663e\u793a\uff0c\u8868\u660e\u5b83\u4eec\u5728\u5355\u8bcd\u4e2d\uff0c\u4f46\u4f4d\u7f6e\u9519\u8bef\u3002\u8fd9\u79cd\u5373\u65f6\u53cd\u9988\u6709\u52a9\u4e8e\u60a8\u6539\u8fdb\u540e\u7eed\u7684\u731c\u6d4b\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u5176\u89c6\u4e3a\u4e00\u4e2a\u586b\u5b57\u6e38\u620f\uff0c\u6bcf\u6b21\u731c\u6d4b\u90fd\u4f1a\u7f29\u5c0f\u53ef\u80fd\u6027\u8303\u56f4\u3002]"}, {"question": "\u5728\u73a9Phoodle 100 \u5c0f\u65f6\u540e\uff0c\u63d0\u9ad8\u731c\u6d4b\u51c6\u786e\u6027\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u73a9\u4e86 100 \u4e2a\u5c0f\u65f6\u540e\uff0c\u60a8\u5e94\u8be5\u4e13\u6ce8\u4e8e\u4f18\u5316\u4f60\u7684\u731c\u6d4b\u7b56\u7565\u3002\u6b65\u9aa4\u4e00\uff1a\u4ece\u5305\u542b\u5e38\u89c1\u5143\u97f3\u548c\u8f85\u97f3\u7684\u5355\u8bcd\u5f00\u59cb\uff0c\u4f8b\u5982\u300eCRANE\u300f\u3002\u6b65\u9aa4\u4e8c\uff1a\u5206\u6790\u53cd\u9988\uff0c\u6d88\u9664\u4e0d\u53ef\u80fd\u7684\u5b57\u6bcd\u548c\u4f4d\u7f6e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5355\u8bcd\u4e2d\u6ca1\u6709\u300eC\u300f\uff0c\u5219\u5728\u672a\u6765\u7684\u731c\u6d4b\u4e2d\u907f\u514d\u5305\u542b\u300eC\u300f\u7684\u5355\u8bcd\u3002\u6b65\u9aa4\u4e09\uff1a\u5229\u7528\u6392\u9664\u6cd5\u7f29\u5c0f\u53ef\u80fd\u6027\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u77e5\u9053\u5355\u8bcd\u5305\u542b\u300eE\u300f\u4f46\u4e0d\u5728\u6700\u540e\u4e00\u4e2a\u4f4d\u7f6e\uff0c\u5c1d\u8bd5\u50cf\u300eTABLE\u300f\u6216\u300eGRAPE\u300f\u8fd9\u6837\u7684\u5355\u8bcd\u3002 [\u591a\u65b9\u6848\u5bf9\u6bd4: \u5c06\u300eCRANE\u300f\u4e0e\u300eAUDIO\u300f\u4f5c\u4e3a\u8d77\u59cb\u8bcd\u8fdb\u884c\u6bd4\u8f83\uff0c\u53ef\u4ee5\u5e2e\u52a9\u60a8\u786e\u5b9a\u54ea\u79cd\u7b56\u7565\u6700\u9002\u5408\u60a8\u3002]"}, {"question": "Phoodle\u4e3a\u4ec0\u4e48\u9650\u5236\u731c\u6d4b\u6b21\u6570\uff0c\u4ee5\u53ca\u8fd9\u5982\u4f55\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\uff1f", "answer": "Phoodle\u9650\u5236\u731c\u6d4b\u6b21\u6570\u662f\u4e3a\u4e86\u589e\u52a0\u6e38\u620f\u7684\u6311\u6218\u6027\u548c\u7b56\u7565\u6027\u3002\u8fd9\u79cd\u9650\u5236\u8feb\u4f7f\u73a9\u5bb6\u66f4\u4ed4\u7ec6\u5730\u601d\u8003\u6bcf\u6b21\u731c\u6d4b\uff0c\u800c\u4e0d\u662f\u4f9d\u8d56\u86ee\u529b\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u53ea\u6709\u516d\u6b21\u5c1d\u8bd5\u731c\u6d4b\u4e00\u4e2a\u4e94\u4e2a\u5b57\u6bcd\u7684\u5355\u8bcd\uff0c\u6bcf\u6b21\u731c\u6d4b\u90fd\u5fc5\u987b\u5c3d\u53ef\u80fd\u63d0\u4f9b\u4fe1\u606f\u3002\u8fd9\u79cd\u9650\u5236\u4e5f\u53cd\u6620\u4e86\u73b0\u5b9e\u751f\u6d3b\u4e2d\u7684\u95ee\u9898\u89e3\u51b3\u573a\u666f\uff0c\u5176\u4e2d\u8d44\u6e90\u662f\u6709\u9650\u7684\u3002[\u6bd4\u55bb\u8bf4\u660e: \u8fd9\u5c31\u50cf\u7528\u6709\u9650\u7684\u7ebf\u7d22\u89e3\u5f00\u4e00\u4e2a\u8c1c\u56e2\uff1b\u6bcf\u6b21\u731c\u6d4b\u90fd\u5fc5\u987b\u7cbe\u786e\u4e14\u6df1\u601d\u719f\u8651\u3002]"}, {"question": "Phoodle\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u6700\u7ec8\u5f97\u5206\uff1f", "answer": "Phoodle\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u60a8\u731c\u6d4b\u6b63\u786e\u5355\u8bcd\u6240\u9700\u7684\u5c1d\u8bd5\u6b21\u6570\u3002\u5c1d\u8bd5\u6b21\u6570\u8d8a\u5c11\uff0c\u5f97\u5206\u8d8a\u9ad8\u3002\u6b64\u5916\uff0c\u6e38\u620f\u53ef\u80fd\u4f1a\u8003\u8651\u5355\u8bcd\u7684\u590d\u6742\u6027\u548c\u6bcf\u6b21\u731c\u6d4b\u6240\u9700\u7684\u65f6\u95f4\u3002\u4f8b\u5982\uff0c\u5728\u4e09\u6b21\u5c1d\u8bd5\u4e2d\u731c\u6d4b\u300eGRAPE\u300f\u7684\u5f97\u5206\u4f1a\u6bd4\u5728\u516d\u6b21\u5c1d\u8bd5\u4e2d\u731c\u6d4b\u5b83\u66f4\u9ad8\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u4e00\u5f20\u6bd4\u8f83\u57fa\u4e8e\u5c1d\u8bd5\u6b21\u6570\u548c\u5355\u8bcd\u590d\u6742\u5ea6\u7684\u5206\u6570\u7684\u8868\u683c\uff0c\u53ef\u4ee5\u5e2e\u52a9\u73a9\u5bb6\u4e86\u89e3\u5982\u4f55\u6700\u5927\u5316\u4ed6\u4eec\u7684\u5206\u6570\u3002]"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u8fd0\u884cPhoodle\u7684\u6280\u672f\u8981\u6c42\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5b83\u4eec\u4e4b\u95f4\u6709\u4ec0\u4e48\u6bd4\u8f83\uff1f", "answer": "Phoodle\u7684\u8bbe\u8ba1\u8f7b\u5de7\uff0c\u5e76\u517c\u5bb9\u5404\u79cd\u8bbe\u5907\u3002\u5bf9\u4e8eiOS\uff0c\u5b83\u9700\u8981iOS 12.0\u6216\u66f4\u9ad8\u7248\u672c\uff1b\u5bf9\u4e8eAndroid\uff0c\u5b83\u9700\u8981Android 6.0\u6216\u66f4\u9ad8\u7248\u672c\u3002\u6e38\u620f\u7684\u7b80\u7ea6\u8bbe\u8ba1\u786e\u4fdd\u5373\u4f7f\u5728\u65e7\u8bbe\u5907\u4e0a\u4e5f\u80fd\u6d41\u7545\u8fd0\u884c\u3002\u4f8b\u5982\uff0c\u8fd0\u884ciOS 12\u7684iPhone 6s\u53ef\u4ee5\u6beb\u65e0\u95ee\u9898\u5730\u8fd0\u884cPhoodle\uff0c\u800c\u5185\u5b58\u4e3a2GB\u7684\u5ec9\u4ef7Android\u624b\u673a\u4e5f\u8fd0\u884c\u826f\u597d\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u4e00\u5f20\u6bd4\u8f83iOS\u548cAndroid\u6280\u672f\u8981\u6c42\u7684\u8868\u683c\u53ef\u4ee5\u5e2e\u52a9\u73a9\u5bb6\u786e\u4fdd\u4ed6\u4eec\u7684\u8bbe\u5907\u517c\u5bb9\u3002]"}, {"question": "\u5982\u4f55\u5728\u4e0d\u4e22\u5931\u6570\u636e\u7684\u60c5\u51b5\u4e0b\u5c06\u60a8\u7684Phoodle\u8fdb\u5ea6\u4ece\u4e00\u53f0\u8bbe\u5907\u8fc1\u79fb\u5230\u53e6\u4e00\u53f0\u8bbe\u5907\uff1f", "answer": "\u8981\u8fc1\u79fb\u60a8\u7684Phoodle\u8fdb\u5ea6\uff0c\u8bf7\u4f7f\u7528\u6e38\u620f\u8bbe\u7f6e\u4e2d\u53ef\u7528\u7684\u4e91\u4fdd\u5b58\u529f\u80fd\u3002\u6b65\u9aa4\u4e00\uff1a\u5728\u60a8\u5f53\u524d\u7684\u8bbe\u5907\u4e0a\uff0c\u8f6c\u5230\u8bbe\u7f6e\u5e76\u542f\u7528\u4e91\u4fdd\u5b58\u3002\u6b65\u9aa4\u4e8c\uff1a\u5728\u65b0\u8bbe\u5907\u4e0a\u4f7f\u7528\u540c\u4e00\u5e10\u6237\u767b\u5f55\u3002\u6b65\u9aa4\u4e09\uff1a\u518d\u6b21\u542f\u7528\u4e91\u4fdd\u5b58\u4ee5\u540c\u6b65\u60a8\u7684\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u65e7\u8bbe\u5907\u4e0a\u5904\u4e8e20\u7ea7\uff0c\u60a8\u5c06\u5728\u65b0\u8bbe\u5907\u4e0a\u4ece20\u7ea7\u5f00\u59cb\u3002[\u6d41\u7a0b\u56fe\u89e3:  \u4e00\u5f20\u8bf4\u660e\u8fc1\u79fb\u8fc7\u7a0b\u7684\u6d41\u7a0b\u56fe\u53ef\u4ee5\u66f4\u5bb9\u6613\u5730\u5e2e\u52a9\u73a9\u5bb6\u6309\u7167\u6b65\u9aa4\u64cd\u4f5c\u3002]"}, {"question": "\u7ecf\u8fc7\u957f\u65f6\u95f4\u7684\u6e38\u620f\u540e\uff0c\u73a9\u5bb6\u53ef\u4ee5\u5728Phoodle\u4e2d\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "Phoodle\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u4f9b\u4e13\u6ce8\u7684\u73a9\u5bb6\u53d1\u73b0\u3002\u5176\u4e2d\u4e00\u4e2a\u529f\u80fd\u662f\u300e\u9ec4\u91d1\u5355\u8bcd\u300f\u6a21\u5f0f\uff0c\u5728\u8fde\u7eed\u6b63\u786e\u731c\u6d4b100\u6b21\u540e\u89e3\u9501\u3002\u5728\u6b64\u6a21\u5f0f\u4e0b\uff0c\u8981\u731c\u6d4b\u7684\u5355\u8bcd\u4ee5\u91d1\u8272\u7a81\u51fa\u663e\u793a\uff0c\u5e76\u4e14\u73a9\u5bb6\u6b63\u786e\u731c\u6d4b\u8be5\u5355\u8bcd\u5c06\u83b7\u5f97\u989d\u5916\u79ef\u5206\u3002\u53e6\u4e00\u4e2a\u5f69\u86cb\u662f\u300e\u79d8\u5bc6\u8bcd\u5178\u300f\uff0c\u53ef\u4ee5\u901a\u8fc7\u5728\u4e3b\u83dc\u5355\u4e0a\u5411\u5de6\u6ed1\u52a8\u4e09\u6b21\u8bbf\u95ee\u3002\u6b64\u8bcd\u5178\u5305\u542b\u6e38\u620f\u4e2d\u53ef\u7528\u7684\u7f55\u89c1\u548c\u6666\u6da9\u7684\u5355\u8bcd\u3002[\u6bd4\u55bb\u8bf4\u660e: \u53d1\u73b0\u8fd9\u4e9b\u529f\u80fd\u5c31\u50cf\u5728\u4e00\u4e2a\u5e7f\u88a4\u3001\u672a\u77e5\u7684\u9886\u57df\u4e2d\u53d1\u73b0\u9690\u85cf\u7684\u5b9d\u85cf\u3002]"}, {"question": "Phoodle\u7684\u7b97\u6cd5\u5982\u4f55\u786e\u5b9a\u6bcf\u4e2a\u5355\u8bcd\u7684\u96be\u5ea6\uff0c\u73a9\u5bb6\u80fd\u5426\u5f71\u54cd\u5b83\uff1f", "answer": "Phoodle\u7684\u7b97\u6cd5\u6839\u636e\u5355\u8bcd\u7684\u957f\u5ea6\u3001\u590d\u6742\u6027\u548c\u5728\u82f1\u8bed\u4e2d\u7684\u4f7f\u7528\u9891\u7387\u4e3a\u5355\u8bcd\u5206\u914d\u96be\u5ea6\u7b49\u7ea7\u3002\u4f8b\u5982\uff0c\u50cf\u300eGRAPE\u300f\u8fd9\u6837\u7684\u4e94\u4e2a\u5b57\u6bcd\u5355\u8bcd\u53ef\u80fd\u6bd4\u50cf\u300eZYGOTIC\u300f\u8fd9\u6837\u7684\u4e03\u4e2a\u5b57\u6bcd\u5355\u8bcd\u66f4\u5bb9\u6613\u3002\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u9009\u62e9\u4e0d\u540c\u7684\u6e38\u620f\u6a21\u5f0f\u6765\u5f71\u54cd\u96be\u5ea6\uff0c\u4f8b\u5982\uff0c\u9009\u62e9\u300e\u7b80\u5355\u6a21\u5f0f\u300f\u6765\u4f7f\u7528\u66f4\u77ed\u7684\u5355\u8bcd\uff0c\u6216\u9009\u62e9\u300e\u56f0\u96be\u6a21\u5f0f\u300f\u6765\u4f7f\u7528\u66f4\u957f\u3001\u66f4\u590d\u6742\u7684\u5355\u8bcd\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u4e00\u5f20\u663e\u793a\u4e0d\u540c\u6a21\u5f0f\u4e0b\u5355\u8bcd\u96be\u5ea6\u7b49\u7ea7\u7684\u8868\u683c\u53ef\u4ee5\u5e2e\u52a9\u73a9\u5bb6\u6839\u636e\u81ea\u5df1\u7684\u6280\u80fd\u9009\u62e9\u5408\u9002\u7684\u6311\u6218\u3002]"}, {"question": "Phoodle\u65b0\u624b\u6700\u5e38\u72af\u7684\u9519\u8bef\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5982\u4f55\u907f\u514d\u8fd9\u4e9b\u9519\u8bef\uff1f", "answer": "\u65b0\u624b\u73a9\u5bb6\u7ecf\u5e38\u72af\u7684\u9519\u8bef\u662f\uff0c\u5728\u6ca1\u6709\u7b56\u7565\u7684\u60c5\u51b5\u4e0b\u968f\u673a\u731c\u6d4b\u5355\u8bcd\uff0c\u8fd9\u4f1a\u6d6a\u8d39\u5c1d\u8bd5\u6b21\u6570\u3002\u53e6\u4e00\u4e2a\u5e38\u89c1\u9519\u8bef\u662f\u5ffd\u7565\u6bcf\u6b21\u731c\u6d4b\u540e\u7684\u53cd\u9988\u3002\u8981\u907f\u514d\u8fd9\u4e9b\u9519\u8bef\uff0c\u8bf7\u59cb\u7ec8\u4ece\u5305\u542b\u5e38\u89c1\u5143\u97f3\u548c\u8f85\u97f3\u7684\u5355\u8bcd\u5f00\u59cb\uff0c\u4f8b\u5982\u300eCRANE\u300f\u3002\u5bc6\u5207\u5173\u6ce8\u53cd\u9988\uff1b\u4f8b\u5982\uff0c\u5982\u679c\u5355\u8bcd\u4e2d\u5305\u542b\u300eA\u300f\uff0c\u4f46\u4e0d\u5728\u7b2c\u4e00\u4e2a\u4f4d\u7f6e\uff0c\u5219\u76f8\u5e94\u5730\u8c03\u6574\u60a8\u7684\u4e0b\u4e00\u4e2a\u731c\u6d4b\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u5c06\u6709\u6548\u7684\u548c\u65e0\u6548\u7684\u731c\u6d4b\u7b56\u7565\u8fdb\u884c\u6bd4\u8f83\u53ef\u4ee5\u5e2e\u52a9\u65b0\u73a9\u5bb6\u7406\u89e3\u7ed3\u6784\u5316\u65b9\u6cd5\u7684\u91cd\u8981\u6027\u3002]"}, {"question": "Phoodle\u7684\u6bcf\u65e5\u6311\u6218\u6a21\u5f0f\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u53c2\u4e0e\u5176\u4e2d\u6709\u4ec0\u4e48\u597d\u5904\uff1f", "answer": "Phoodle\u7684\u6bcf\u65e5\u6311\u6218\u6a21\u5f0f\u6bcf\u5929\u90fd\u4f1a\u5411\u73a9\u5bb6\u5448\u73b0\u4e00\u4e2a\u72ec\u7279\u7684\u8981\u731c\u6d4b\u7684\u5355\u8bcd\u3002\u6b64\u6a21\u5f0f\u65e8\u5728\u6d4b\u8bd5\u60a8\u7684\u6280\u80fd\u5e76\u4fdd\u6301\u6e38\u620f\u7684\u8da3\u5473\u6027\u3002\u53c2\u4e0e\u5176\u4e2d\u7684\u597d\u5904\u5305\u62ec\u83b7\u5f97\u989d\u5916\u79ef\u5206\u3001\u89e3\u9501\u7279\u6b8a\u6210\u5c31\u4ee5\u53ca\u6539\u8fdb\u60a8\u7684\u6574\u4f53\u731c\u6d4b\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u6210\u529f\u731c\u6d4b\u6bcf\u65e5\u5355\u8bcd\u300eZYGOTIC\u300f\u53ef\u80fd\u4f1a\u5956\u52b1\u60a850\u4e2a\u989d\u5916\u79ef\u5206\u548c\u4e00\u4e2a\u7279\u6b8a\u5fbd\u7ae0\u3002 [\u6bd4\u55bb\u8bf4\u660e: \u6bcf\u65e5\u6311\u6218\u5c31\u50cf\u4e00\u4e2a\u5c0f\u578b\u8003\u8bd5\uff0c\u8ba9\u60a8\u7684\u601d\u7ef4\u4fdd\u6301\u654f\u9510\uff0c\u4e3a\u4e0b\u4e00\u4e2a\u8c1c\u9898\u505a\u597d\u51c6\u5907\u3002]"}]
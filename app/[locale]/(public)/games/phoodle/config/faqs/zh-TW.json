[{"question": "\u5982\u4f55\u8b93\u521d\u5b78\u8005\u958b\u59cb\u73a9 Phoodle \u4e26\u4e86\u89e3\u5176\u57fa\u672c\u6a5f\u5236\uff1f", "answer": "\u8981\u958b\u59cb\u73a9 Phoodle\uff0c\u9996\u5148\u5f9e\u60a8\u559c\u6b61\u7684\u61c9\u7528\u7a0b\u5f0f\u5546\u5e97\u4e0b\u8f09\u904a\u6232\u3002\u555f\u52d5\u5f8c\uff0c\u60a8\u5c07\u6703\u88ab\u5f15\u5c0e\u5b8c\u6210\u4e00\u500b\u6559\u5b78\uff0c\u8aaa\u660e\u6838\u5fc3\u6a5f\u5236\uff1a\u5728\u6709\u9650\u6b21\u6578\u7684\u5617\u8a66\u4e2d\u731c\u51fa\u6b63\u78ba\u7684\u55ae\u5b57\u3002\u6bcf\u6b21\u731c\u6e2c\u90fd\u6703\u63d0\u4f9b\u6709\u95dc\u5b57\u6bcd\u6b63\u78ba\u6027\u53ca\u4f4d\u7f6e\u7684\u53cd\u994b\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u731c\u6e2c \"APPLE\"\uff0c\u800c\u6b63\u78ba\u7684\u55ae\u5b57\u662f \"GRAPE\"\uff0c\u5b57\u6bcd \"A\" \u548c \"P\" \u53ef\u80fd\u6703\u4ee5\u9ec3\u8272\u6a19\u793a\uff0c\u8868\u793a\u5b83\u5011\u5728\u55ae\u5b57\u4e2d\uff0c\u4f46\u4f4d\u7f6e\u932f\u8aa4\u3002\u6b64\u5373\u6642\u53cd\u994b\u6709\u52a9\u65bc\u60a8\u6539\u9032\u5f8c\u7e8c\u7684\u731c\u6e2c\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u5176\u8996\u70ba\u7e31\u6a6b\u5b57\u8b0e\u904a\u6232\uff0c\u6bcf\u6b21\u731c\u6e2c\u90fd\u6703\u7e2e\u5c0f\u53ef\u80fd\u6027\u7bc4\u570d\u3002]"}, {"question": "\u5728\u73a9\u4e86 100 \u5c0f\u6642 Phoodle \u5f8c\uff0c\u5982\u4f55\u6700\u4f73\u5316\u731c\u6e2c\u6e96\u78ba\u5ea6\uff1f", "answer": "\u5728\u73a9\u4e86 100 \u5c0f\u6642\u5f8c\uff0c\u60a8\u61c9\u8a72\u5c08\u6ce8\u65bc\u512a\u5316\u731c\u6e2c\u7b56\u7565\u3002\u6b65\u9a5f1\uff1a\u5f9e\u5305\u542b\u5e38\u898b\u5143\u97f3\u548c\u8f14\u97f3\u7684\u55ae\u5b57\u958b\u59cb\uff0c\u4f8b\u5982 \"CRANE\"\u3002\u6b65\u9a5f2\uff1a\u5206\u6790\u53cd\u994b\u4ee5\u6392\u9664\u4e0d\u53ef\u80fd\u7684\u5b57\u6bcd\u548c\u4f4d\u7f6e\u3002\u4f8b\u5982\uff0c\u5982\u679c \"C\" \u4e0d\u5728\u55ae\u5b57\u4e2d\uff0c\u5247\u5728\u5f8c\u7e8c\u731c\u6e2c\u4e2d\u907f\u514d\u5305\u542b \"C\" \u7684\u55ae\u5b57\u3002\u6b65\u9a5f3\uff1a\u5229\u7528\u6392\u9664\u6cd5\u4f86\u7e2e\u5c0f\u53ef\u80fd\u6027\u7bc4\u570d\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u77e5\u9053\u8a72\u55ae\u5b57\u5305\u542b \"E\" \u4f46\u4e0d\u5728\u6700\u5f8c\u4e00\u500b\u4f4d\u7f6e\uff0c\u8acb\u5617\u8a66\u50cf \"TABLE\" \u6216 \"GRAPE\" \u9019\u6a23\u7684\u55ae\u5b57\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u6bd4\u8f03 \"CRANE\" \u8207 \"AUDIO\" \u4f5c\u70ba\u8d77\u59cb\u55ae\u5b57\uff0c\u53ef\u4ee5\u5e6b\u52a9\u60a8\u6c7a\u5b9a\u54ea\u7a2e\u7b56\u7565\u6700\u9069\u5408\u60a8\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc Phoodle \u6703\u9650\u5236\u731c\u6e2c\u6b21\u6578\uff0c\u4ee5\u53ca\u9019\u5982\u4f55\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\uff1f", "answer": "Phoodle \u9650\u5236\u731c\u6e2c\u6b21\u6578\uff0c\u662f\u70ba\u4e86\u589e\u52a0\u904a\u6232\u7684\u6311\u6230\u6027\u548c\u7b56\u7565\u6027\u3002\u6b64\u9650\u5236\u8feb\u4f7f\u73a9\u5bb6\u5728\u4f9d\u8cf4\u883b\u529b\u731c\u6e2c\u6642\uff0c\u66f4\u8457\u91cd\u601d\u8003\u6bcf\u6b21\u731c\u6e2c\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u53ea\u6709\u516d\u6b21\u5617\u8a66\u731c\u6e2c\u4e00\u500b\u4e94\u500b\u5b57\u6bcd\u7684\u55ae\u5b57\uff0c\u6bcf\u6b21\u731c\u6e2c\u90fd\u5fc5\u9808\u76e1\u53ef\u80fd\u63d0\u4f9b\u8cc7\u8a0a\u3002\u6b64\u9650\u5236\u4e5f\u53cd\u6620\u4e86\u73fe\u5be6\u4e16\u754c\u7684\u554f\u984c\u89e3\u6c7a\u60c5\u5883\uff0c\u8cc7\u6e90\u662f\u6709\u9650\u7684\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u9019\u5c31\u50cf\u7528\u6709\u9650\u7684\u7dda\u7d22\u4f86\u89e3\u958b\u8b0e\u984c\uff0c\u6bcf\u6b21\u731c\u6e2c\u90fd\u5fc5\u9808\u7cbe\u78ba\u4e14\u6df1\u601d\u719f\u616e\u3002]"}, {"question": "Phoodle \u7684\u8a08\u5206\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff0c\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u6700\u7d42\u5f97\u5206\uff1f", "answer": "Phoodle \u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u731c\u5c0d\u6b63\u78ba\u55ae\u5b57\u6240\u82b1\u7684\u5617\u8a66\u6b21\u6578\u3002\u5617\u8a66\u6b21\u6578\u8d8a\u5c11\uff0c\u5206\u6578\u8d8a\u9ad8\u3002\u6b64\u5916\uff0c\u904a\u6232\u53ef\u80fd\u6703\u8003\u616e\u55ae\u5b57\u7684\u8907\u96dc\u5ea6\u4ee5\u53ca\u6bcf\u6b21\u731c\u6e2c\u6240\u9700\u7684\u6642\u9593\u3002\u4f8b\u5982\uff0c\u5728\u4e09\u6b21\u5617\u8a66\u5167\u731c\u51fa \"GRAPE\" \u6703\u6bd4\u5728\u516d\u6b21\u5617\u8a66\u5167\u731c\u51fa\u5b83\u7372\u5f97\u66f4\u9ad8\u7684\u5206\u6578\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u4e00\u5f35\u6839\u64da\u5617\u8a66\u6b21\u6578\u548c\u55ae\u5b57\u8907\u96dc\u5ea6\u6bd4\u8f03\u5206\u6578\u7684\u8868\u683c\uff0c\u53ef\u4ee5\u5e6b\u52a9\u73a9\u5bb6\u4e86\u89e3\u5982\u4f55\u6700\u5927\u5316\u5f97\u5206\u3002]"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u904b\u884c Phoodle \u7684\u6280\u8853\u9700\u6c42\u70ba\u4f55\uff0c\u4ee5\u53ca\u5b83\u5011\u4e4b\u9593\u7684\u5dee\u7570\uff1f", "answer": "Phoodle \u8a2d\u8a08\u70ba\u8f15\u5de7\u4e14\u517c\u5bb9\u5404\u7a2e\u88dd\u7f6e\u3002\u5c0d\u65bc iOS\uff0c\u5b83\u9700\u8981 iOS 12.0 \u6216\u66f4\u9ad8\u7248\u672c\uff1b\u5c0d\u65bc Android\uff0c\u5b83\u9700\u8981 Android 6.0 \u6216\u66f4\u9ad8\u7248\u672c\u3002\u904a\u6232\u7684\u7c21\u6f54\u8a2d\u8a08\u78ba\u4fdd\u5373\u4f7f\u5728\u820a\u7248\u88dd\u7f6e\u4e0a\u4e5f\u80fd\u9806\u66a2\u904b\u884c\u3002\u4f8b\u5982\uff0c\u904b\u884c iOS 12 \u7684 iPhone 6s \u53ef\u4ee5\u9806\u66a2\u904b\u884c Phoodle\uff0c\u800c\u5177\u6709 2GB \u8a18\u61b6\u9ad4\u7684\u5ec9\u50f9 Android \u624b\u6a5f\u4e5f\u80fd\u826f\u597d\u904b\u884c\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u4e00\u5f35\u6bd4\u8f03 iOS \u548c Android \u6280\u8853\u9700\u6c42\u7684\u8868\u683c\uff0c\u53ef\u4ee5\u5e6b\u52a9\u73a9\u5bb6\u78ba\u4fdd\u4ed6\u5011\u7684\u88dd\u7f6e\u76f8\u5bb9\u3002]"}, {"question": "\u5982\u4f55\u5728\u4e0d\u640d\u5931\u8cc7\u6599\u7684\u60c5\u6cc1\u4e0b\u5c07 Phoodle \u9032\u5ea6\u5f9e\u4e00\u500b\u88dd\u7f6e\u9077\u79fb\u5230\u53e6\u4e00\u500b\u88dd\u7f6e\uff1f", "answer": "\u8981\u9077\u79fb\u60a8\u7684 Phoodle \u9032\u5ea6\uff0c\u8acb\u4f7f\u7528\u904a\u6232\u8a2d\u5b9a\u4e2d\u63d0\u4f9b\u7684\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u3002\u6b65\u9a5f1\uff1a\u5728\u60a8\u76ee\u524d\u7684\u88dd\u7f6e\u4e0a\uff0c\u524d\u5f80\u8a2d\u5b9a\u4e26\u555f\u7528\u96f2\u7aef\u5132\u5b58\u3002\u6b65\u9a5f2\uff1a\u5728\u60a8\u7684\u65b0\u88dd\u7f6e\u4e0a\u4f7f\u7528\u76f8\u540c\u7684\u5e33\u6236\u767b\u5165\u3002\u6b65\u9a5f3\uff1a\u518d\u6b21\u555f\u7528\u96f2\u7aef\u5132\u5b58\u4ee5\u540c\u6b65\u60a8\u7684\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u820a\u88dd\u7f6e\u4e0a\u5df2\u9054\u5230 20 \u7d1a\uff0c\u60a8\u5c07\u5728\u65b0\u88dd\u7f6e\u4e0a\u5f9e 20 \u7d1a\u958b\u59cb\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u4e00\u5f35\u8aaa\u660e\u9077\u79fb\u6d41\u7a0b\u7684\u6d41\u7a0b\u5716\uff0c\u53ef\u4ee5\u8b93\u73a9\u5bb6\u66f4\u5bb9\u6613\u9075\u5faa\u6b65\u9a5f\u3002]"}, {"question": "\u5728\u9577\u6642\u9593\u904a\u73a9\u5f8c\uff0c\u73a9\u5bb6\u53ef\u4ee5\u5728 Phoodle \u4e2d\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "Phoodle \u5305\u542b\u5e7e\u500b\u96b1\u85cf\u529f\u80fd\u548c\u5f69\u86cb\uff0c\u4f9b\u71b1\u8877\u73a9\u5bb6\u63a2\u7d22\u3002\u5176\u4e2d\u4e00\u500b\u529f\u80fd\u662f\u300c\u9ec3\u91d1\u55ae\u5b57\u300d\u6a21\u5f0f\uff0c\u5728\u9023\u7e8c 100 \u6b21\u6b63\u78ba\u731c\u6e2c\u5f8c\u89e3\u9396\u3002\u5728\u6b64\u6a21\u5f0f\u4e0b\uff0c\u8981\u731c\u6e2c\u7684\u55ae\u5b57\u6703\u4ee5\u91d1\u8272\u7a81\u51fa\u986f\u793a\uff0c\u800c\u4e14\u73a9\u5bb6\u731c\u5c0d\u6642\u6703\u7372\u5f97\u984d\u5916\u5206\u6578\u3002\u53e6\u4e00\u500b\u5f69\u86cb\u662f\u300c\u79d8\u5bc6\u5b57\u5178\u300d\uff0c\u53ef\u900f\u904e\u5728\u4e3b\u9078\u55ae\u4e0a\u5411\u5de6\u6ed1\u52d5\u4e09\u6b21\u4f86\u5b58\u53d6\u3002\u6b64\u5b57\u5178\u5305\u542b\u904a\u6232\u4e2d\u53ef\u7528\u7684\u7a00\u6709\u4e14\u6666\u6f80\u7684\u55ae\u5b57\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u767c\u73fe\u9019\u4e9b\u529f\u80fd\u5c31\u50cf\u5728\u5ee3\u88a4\u3001\u672a\u958b\u767c\u7684\u9818\u57df\u4e2d\u767c\u73fe\u5bf6\u85cf\u3002]"}, {"question": "Phoodle \u7684\u6f14\u7b97\u6cd5\u5982\u4f55\u6c7a\u5b9a\u6bcf\u500b\u55ae\u5b57\u7684\u96e3\u5ea6\uff0c\u73a9\u5bb6\u662f\u5426\u53ef\u4ee5\u5f71\u97ff\u9019\u4e00\u9ede\uff1f", "answer": "Phoodle \u7684\u6f14\u7b97\u6cd5\u6839\u64da\u55ae\u5b57\u7684\u9577\u5ea6\u3001\u8907\u96dc\u5ea6\u548c\u5728\u82f1\u6587\u4e2d\u7684\u4f7f\u7528\u983b\u7387\u4f86\u7d66\u4e88\u55ae\u5b57\u96e3\u5ea6\u7b49\u7d1a\u3002\u4f8b\u5982\uff0c\u50cf \"GRAPE\" \u9019\u6a23\u7684\u4e94\u500b\u5b57\u6bcd\u55ae\u5b57\u53ef\u80fd\u88ab\u8a8d\u70ba\u6bd4\u50cf \"ZYGOTIC\" \u9019\u6a23\u7684\u4e03\u500b\u5b57\u6bcd\u55ae\u5b57\u66f4\u5bb9\u6613\u3002\u73a9\u5bb6\u53ef\u4ee5\u900f\u904e\u9078\u64c7\u4e0d\u540c\u7684\u904a\u6232\u6a21\u5f0f\u4f86\u5f71\u97ff\u96e3\u5ea6\uff0c\u4f8b\u5982\uff0c\u70ba\u8f03\u77ed\u55ae\u5b57\u9078\u64c7\u300c\u7c21\u55ae\u6a21\u5f0f\u300d\uff0c\u6216\u70ba\u8f03\u9577\u3001\u8f03\u8907\u96dc\u55ae\u5b57\u9078\u64c7\u300c\u56f0\u96e3\u6a21\u5f0f\u300d\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u4e00\u5f35\u986f\u793a\u4e0d\u540c\u6a21\u5f0f\u4e0b\u55ae\u5b57\u96e3\u5ea6\u7b49\u7d1a\u7684\u8868\u683c\uff0c\u53ef\u4ee5\u5e6b\u52a9\u73a9\u5bb6\u6839\u64da\u81ea\u5df1\u7684\u6280\u80fd\u9078\u64c7\u5408\u9069\u7684\u6311\u6230\u3002]"}, {"question": "\u65b0\u73a9\u5bb6\u5728 Phoodle \u4e2d\u6700\u5e38\u72af\u7684\u932f\u8aa4\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5982\u4f55\u907f\u514d\u9019\u4e9b\u932f\u8aa4\uff1f", "answer": "\u65b0\u73a9\u5bb6\u7d93\u5e38\u72af\u7684\u932f\u8aa4\u662f\u96a8\u6a5f\u731c\u6e2c\u55ae\u5b57\u800c\u4e0d\u4f7f\u7528\u7b56\u7565\uff0c\u9019\u6703\u6d6a\u8cbb\u5617\u8a66\u6b21\u6578\u3002\u53e6\u4e00\u500b\u5e38\u898b\u932f\u8aa4\u662f\u5ffd\u7565\u6bcf\u6b21\u731c\u6e2c\u5f8c\u63d0\u4f9b\u7684\u53cd\u994b\u3002\u70ba\u907f\u514d\u9019\u4e9b\u932f\u8aa4\uff0c\u8acb\u59cb\u7d42\u5f9e\u5305\u542b\u5e38\u898b\u5143\u97f3\u548c\u8f14\u97f3\u7684\u55ae\u5b57\u958b\u59cb\uff0c\u4f8b\u5982\u300cCRANE\u300d\u3002\u5bc6\u5207\u6ce8\u610f\u53cd\u994b\uff1b\u4f8b\u5982\uff0c\u5982\u679c\u55ae\u5b57\u4e2d\u5305\u542b\u300cA\u300d\u4f46\u4e0d\u5728\u7b2c\u4e00\u500b\u4f4d\u7f6e\uff0c\u5247\u8abf\u6574\u60a8\u7684\u4e0b\u4e00\u500b\u731c\u6e2c\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u6bd4\u8f03\u6709\u6548\u7684\u548c\u7121\u6548\u7684\u731c\u6e2c\u7b56\u7565\uff0c\u53ef\u4ee5\u5e6b\u52a9\u65b0\u73a9\u5bb6\u4e86\u89e3\u7d50\u69cb\u5316\u65b9\u6cd5\u7684\u91cd\u8981\u6027\u3002]"}, {"question": "Phoodle \u7684\u6bcf\u65e5\u6311\u6230\u6a21\u5f0f\u5982\u4f55\u904b\u4f5c\uff0c\u53c3\u8207\u7684\u76ca\u8655\u6709\u54ea\u4e9b\uff1f", "answer": "Phoodle \u7684\u6bcf\u65e5\u6311\u6230\u6a21\u5f0f\u6bcf\u5929\u6703\u5411\u73a9\u5bb6\u63d0\u4f9b\u4e00\u500b\u7368\u7279\u7684\u55ae\u5b57\u9032\u884c\u731c\u6e2c\u3002\u6b64\u6a21\u5f0f\u65e8\u5728\u6e2c\u8a66\u60a8\u7684\u6280\u80fd\u4e26\u4fdd\u6301\u904a\u6232\u7684\u65b0\u9bae\u611f\u3002\u53c3\u8207\u7684\u76ca\u8655\u5305\u62ec\u7372\u5f97\u984d\u5916\u5206\u6578\u3001\u89e3\u9396\u7279\u6b8a\u6210\u5c31\u4ee5\u53ca\u63d0\u5347\u60a8\u7684\u6574\u9ad4\u731c\u6e2c\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u6210\u529f\u731c\u51fa\u6bcf\u65e5\u55ae\u5b57\u300cZYGOTIC\u300d\u53ef\u80fd\u6703\u734e\u52f5\u60a8 50 \u500b\u984d\u5916\u5206\u6578\u548c\u4e00\u500b\u7279\u6b8a\u5fbd\u7ae0\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u6bcf\u65e5\u6311\u6230\u5c31\u50cf\u4e00\u500b\u5c0f\u8003\u9a57\uff0c\u8b93\u60a8\u7684\u601d\u7dad\u4fdd\u6301\u654f\u92b3\uff0c\u4e26\u6e96\u5099\u597d\u8fce\u63a5\u4e0b\u4e00\u500b\u8b0e\u984c\u3002]"}]
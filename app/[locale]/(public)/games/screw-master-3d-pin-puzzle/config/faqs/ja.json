[{"question": "\u30cd\u30b8\u30de\u30b9\u30bf\u30fc3D\uff1a\u30d4\u30f3\u30d1\u30ba\u30eb\u3067\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u7d20\u65e9\u304f\u59cb\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30cd\u30b8\u30de\u30b9\u30bf\u30fc3D\uff1a\u30d4\u30f3\u30d1\u30ba\u30eb\u3067\u7d20\u65e9\u304f\u59cb\u3081\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30bf\u30c3\u30c1\u64cd\u4f5c\u306b\u6163\u308c\u308b\uff1a\u30cd\u30b8\u3092\u56de\u8ee2\u3055\u305b\u308b\u306b\u306f\u3001\u30bf\u30c3\u30d7\u3057\u3066\u30c9\u30e9\u30c3\u30b0\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30ba\u30fc\u30e0\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u30d1\u30ba\u30eb\u3092\u3088\u308a\u8a73\u7d30\u306b\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30ec\u30d9\u30eb\u304b\u3089\u59cb\u3081\u3066\u3001\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30ec\u30d9\u30eb1\u3067\u306f\u3001\u30cd\u30b8\u3092\u56de\u8ee2\u3055\u305b\u3066\u30d4\u30f3\u306b\u5408\u308f\u305b\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u30cd\u30b8\u3092\u8abf\u6574\u3059\u308b\u65b9\u6cd5\u3092\u5b66\u3073\u307e\u3059\u3002\u9375\u3092\u30ab\u30ae\u7a74\u306b\u5408\u308f\u305b\u308b\u3088\u3046\u306a\u3082\u306e\u3067\u3001\u6b63\u78ba\u3055\u304c\u30ab\u30ae\u3068\u306a\u308a\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e]"}, {"question": "\u30cd\u30b8\u30de\u30b9\u30bf\u30fc3D\uff1a\u30d4\u30f3\u30d1\u30ba\u30eb\u3067\u3001\u4e00\u90e8\u306e\u30cd\u30b8\u3092\u8abf\u6574\u3059\u308b\u3053\u3068\u304c\u56f0\u96e3\u306b\u611f\u3058\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u30cd\u30b8\u30de\u30b9\u30bf\u30fc3D\uff1a\u30d4\u30f3\u30d1\u30ba\u30eb\u3067\u3001\u4e00\u90e8\u306e\u30cd\u30b8\u3092\u8abf\u6574\u3059\u308b\u3053\u3068\u304c\u56f0\u96e3\u306b\u611f\u3058\u308b\u306e\u306f\u3001\u305d\u306e\u8907\u96d1\u306a\u5f62\u72b6\u3068\u89d2\u5ea6\u306e\u305f\u3081\u3067\u3059\u3002\u3053\u308c\u3089\u3092\u514b\u670d\u3059\u308b\u65b9\u6cd5\u3092\u4ee5\u4e0b\u306b\u793a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6b63\u3057\u3044\u89d2\u5ea6\u3092\u898b\u3064\u3051\u308b\u307e\u3067\u3001\u30cd\u30b8\u3092\u3086\u3063\u304f\u308a\u3068\u56de\u8ee2\u3055\u305b\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30ba\u30fc\u30e0\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u30cd\u30b8\u306e\u6e9d\u3092\u691c\u67fb\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u8abf\u6574\u3092\u59a8\u3052\u308b\u96a0\u308c\u305f\u30d4\u30f3\u304c\u306a\u3044\u304b\u78ba\u8a8d\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb15\u3067\u306f\u3001\u30cd\u30b8\u304c\u305a\u308c\u3066\u3044\u308b\u3088\u3046\u306b\u898b\u3048\u307e\u3059\u304c\u3001\u308f\u305a\u304b\u306a\u56de\u8ee2\u3067\u3001\u8abf\u6574\u304c\u5fc5\u8981\u306a\u96a0\u308c\u305f\u30d4\u30f3\u304c\u73fe\u308c\u307e\u3059\u3002[\u591a\u65b9\u6848\u6bd4\u8f03]"}, {"question": "\u30cd\u30b8\u30de\u30b9\u30bf\u30fc3D\uff1a\u30d4\u30f3\u30d1\u30ba\u30eb\u3067\u9ad8\u5ea6\u306a\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u305f\u3081\u306e\u6700\u9069\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30cd\u30b8\u30de\u30b9\u30bf\u30fc3D\uff1a\u30d4\u30f3\u30d1\u30ba\u30eb\u3067\u9ad8\u5ea6\u306a\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u305f\u3081\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u6226\u7565\u3092\u691c\u8a0e\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u79fb\u52d5\u3059\u308b\u524d\u306b\u30d1\u30ba\u30eb\u306e\u914d\u7f6e\u3092\u5206\u6790\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6700\u3082\u8907\u96d1\u306a\u30cd\u30b8\u304b\u3089\u59cb\u3081\u307e\u3059\u3002\u306a\u305c\u306a\u3089\u3001\u305d\u308c\u3089\u306f\u4ed6\u306e\u30cd\u30b8\u306e\u914d\u7f6e\u3092\u3057\u3070\u3057\u3070\u6c7a\u5b9a\u3059\u308b\u304b\u3089\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u8aa4\u308a\u304c\u3042\u3063\u305f\u5834\u5408\u306f\u3001\u30a2\u30f3\u30c9\u30a5\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u5143\u306b\u623b\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb30\u3067\u306f\u3001\u4e2d\u592e\u306e\u30cd\u30b8\u304b\u3089\u59cb\u3081\u308b\u3053\u3068\u3067\u3001\u5468\u56f2\u306e\u30d4\u30f3\u3092\u8abf\u6574\u3057\u3084\u3059\u304f\u306a\u308a\u307e\u3059\u3002\u30eb\u30d3\u30c3\u30af\u30b9\u30ad\u30e5\u30fc\u30d6\u3092\u89e3\u304f\u3088\u3046\u306a\u3082\u306e\u3067\u3001\u6700\u3082\u96e3\u3057\u3044\u90e8\u5206\u304b\u3089\u59cb\u3081\u308b\u3053\u3068\u3067\u3001\u6b8b\u308a\u306e\u90e8\u5206\u304c\u697d\u306b\u306a\u308a\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e]"}, {"question": "\u30cd\u30b8\u30de\u30b9\u30bf\u30fc3D\uff1a\u30d4\u30f3\u30d1\u30ba\u30eb\u3067\u6210\u529f\u306b\u6700\u3082\u91cd\u8981\u306a\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30cd\u30b8\u30de\u30b9\u30bf\u30fc3D\uff1a\u30d4\u30f3\u30d1\u30ba\u30eb\u3067\u6210\u529f\u306b\u6700\u3082\u91cd\u8981\u306a\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u7cbe\u5bc6\u306a\u56de\u8ee2\u3001\u30ba\u30fc\u30e0\u6a5f\u80fd\u3001\u30a2\u30f3\u30c9\u30a5\u6a5f\u80fd\u3067\u3059\u3002\u7cbe\u5bc6\u306a\u56de\u8ee2\u306b\u3088\u308a\u3001\u30cd\u30b8\u3092\u6b63\u78ba\u306b\u8abf\u6574\u3067\u304d\u307e\u3059\u3002\u30ba\u30fc\u30e0\u6a5f\u80fd\u306f\u8a73\u7d30\u3092\u78ba\u8a8d\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u30a2\u30f3\u30c9\u30a5\u6a5f\u80fd\u306f\u8aa4\u308a\u3092\u4fee\u6b63\u3059\u308b\u4e0a\u3067\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb25\u3067\u306f\u3001\u30cd\u30b8\u306e\u6e9d\u3092\u691c\u67fb\u3059\u308b\u305f\u3081\u306b\u30ba\u30fc\u30e0\u6a5f\u80fd\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u3067\u3001\u305a\u308c\u3092\u9632\u3050\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u69cb\u6210\u5bfe\u7167\u8868]"}, {"question": "\u30cd\u30b8\u30de\u30b9\u30bf\u30fc3D\uff1a\u30d4\u30f3\u30d1\u30ba\u30eb\u3067\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30cd\u30b8\u30de\u30b9\u30bf\u30fc3D\uff1a\u30d4\u30f3\u30d1\u30ba\u30eb\u3067\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30ec\u30d9\u30eb\u3092\u5b8c\u4e86\u3059\u308b\u306e\u306b\u5fc5\u8981\u306a\u52d5\u304d\u6570\u3068\u6642\u9593\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u52d5\u304d\u304c\u5c11\u306a\u3044\u307b\u3069\u3001\u5b8c\u4e86\u6642\u9593\u304c\u77ed\u3044\u307b\u3069\u3001\u30b9\u30b3\u30a2\u304c\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb10\u30922\u5206\u672a\u6e80\u3067\u6700\u5c0f\u9650\u306e\u52d5\u304d\u3067\u5b8c\u4e86\u3059\u308b\u3068\u30013\u3064\u661f\u8a55\u4fa1\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u305d\u308c\u306f\u30bf\u30a4\u30de\u30fc\u3068\u306e\u7af6\u4e89\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3001\u52b9\u7387\u304c\u5831\u308f\u308c\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e]"}, {"question": "\u30cd\u30b8\u30de\u30b9\u30bf\u30fc3D\uff1a\u30d4\u30f3\u30d1\u30ba\u30eb\u3067\u9ad8\u5ea6\u306a\u30ec\u30d9\u30eb\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u306e\u5229\u70b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30cd\u30b8\u30de\u30b9\u30bf\u30fc3D\uff1a\u30d4\u30f3\u30d1\u30ba\u30eb\u3067\u9ad8\u5ea6\u306a\u30ec\u30d9\u30eb\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u306b\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u5229\u70b9\u304c\u3042\u308a\u307e\u3059\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u554f\u984c\u89e3\u6c7a\u80fd\u529b\u306e\u5411\u4e0a\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u306e\u3088\u308a\u6df1\u3044\u7406\u89e3\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u96a0\u3055\u308c\u305f\u30ec\u30d9\u30eb\u3068\u9054\u6210\u5ea6\u306e\u30a2\u30f3\u30ed\u30c3\u30af\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb50\u3092\u5b8c\u4e86\u3059\u308b\u3068\u3001\u30e6\u30cb\u30fc\u30af\u306a\u8ab2\u984c\u3092\u6301\u3064\u96a0\u3055\u308c\u305f\u30ec\u30d9\u30eb\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u30b2\u30fc\u30e0\u3067\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\u3059\u308b\u306e\u3068\u540c\u3058\u3067\u3001\u30de\u30b9\u30bf\u30fc\u3059\u308b\u305f\u3073\u306b\u65b0\u3057\u3044\u5831\u916c\u304c\u5f97\u3089\u308c\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e]"}, {"question": "\u30cd\u30b8\u30de\u30b9\u30bf\u30fc3D\uff1a\u30d4\u30f3\u30d1\u30ba\u30eb\u3067\u3001\u9032\u6357\u72b6\u6cc1\u3092\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30cd\u30b8\u30de\u30b9\u30bf\u30fc3D\uff1a\u30d4\u30f3\u30d1\u30ba\u30eb\u3067\u3001\u9032\u6357\u72b6\u6cc1\u3092\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u3001\u53e4\u3044\u30c7\u30d0\u30a4\u30b9\u304b\u3089\u306e\u9032\u6357\u72b6\u6cc1\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306b\u4fdd\u5b58\u3055\u308c\u305f\u30c7\u30fc\u30bf\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001Android\u304b\u3089iOS\u30c7\u30d0\u30a4\u30b9\u306b\u5207\u308a\u66ff\u3048\u305f\u5834\u5408\u3001Google Play\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3053\u3068\u3067\u3001\u30b9\u30e0\u30fc\u30ba\u306b\u9032\u6357\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u69cb\u6210\u5bfe\u7167\u8868]"}, {"question": "\u30cd\u30b8\u30de\u30b9\u30bf\u30fc3D\uff1a\u30d4\u30f3\u30d1\u30ba\u30eb\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30cd\u30b8\u30de\u30b9\u30bf\u30fc3D\uff1a\u30d4\u30f3\u30d1\u30ba\u30eb\u306b\u306f\u3001\u3044\u304f\u3064\u304b\u306e\u96a0\u3055\u308c\u305f\u6a5f\u80fd\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u3042\u308a\u307e\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u4f8b\u306f\u3001\u3059\u3079\u3066\u306e\u30ec\u30d9\u30eb\u30923\u3064\u661f\u3067\u5b8c\u4e86\u3059\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u308b\u96a0\u3057\u30ec\u30d9\u30eb\u3067\u3059\u3002\u3055\u3089\u306b\u3001\u7279\u5b9a\u306e\u30ec\u30d9\u30eb\u306b\u306f\u3001\u6b63\u3057\u304f\u8abf\u6574\u3059\u308b\u3068\u30dc\u30fc\u30ca\u30b9\u30dd\u30a4\u30f3\u30c8\u3092\u8868\u793a\u3059\u308b\u96a0\u3057\u30cd\u30b8\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb40\u3067\u306f\u3001\u7279\u5b9a\u306e\u30cd\u30b8\u3092\u30e6\u30cb\u30fc\u30af\u306a\u30d1\u30bf\u30fc\u30f3\u3067\u8abf\u6574\u3059\u308b\u3068\u3001\u96a0\u3057\u9054\u6210\u5ea6\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002[\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u767a\u898b]"}, {"question": "\u30cd\u30b8\u30de\u30b9\u30bf\u30fc3D\uff1a\u30d4\u30f3\u30d1\u30ba\u30eb\u306b\u304a\u3051\u308b\u96e3\u6613\u5ea6\u66f2\u7dda\u306f\u3001\u4ed6\u306e\u30d1\u30ba\u30eb\u30b2\u30fc\u30e0\u3068\u6bd4\u3079\u3066\u3069\u3046\u3067\u3059\u304b\uff1f", "answer": "\u30cd\u30b8\u30de\u30b9\u30bf\u30fc3D\uff1a\u30d4\u30f3\u30d1\u30ba\u30eb\u306b\u304a\u3051\u308b\u96e3\u6613\u5ea6\u66f2\u7dda\u306f\u3001\u6bb5\u968e\u7684\u3067\u3059\u304c\u6025\u52fe\u914d\u3067\u3001\u30d0\u30e9\u30f3\u30b9\u306e\u3068\u308c\u305f\u6311\u6226\u3092\u63d0\u4f9b\u3057\u3066\u3044\u307e\u3059\u3002\u521d\u671f\u30ec\u30d9\u30eb\u306f\u57fa\u672c\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u3044\u307e\u3059\u3002\u4e00\u65b9\u3001\u9ad8\u5ea6\u306a\u30ec\u30d9\u30eb\u3067\u306f\u3001\u8907\u96d1\u306a\u5f62\u72b6\u3068\u8907\u6570\u306e\u30cd\u30b8\u304c\u5c0e\u5165\u3055\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb20\u3067\u306f\u3001\u7cbe\u5bc6\u306a\u8abf\u6574\u3092\u5fc5\u8981\u3068\u3059\u308b\u30de\u30eb\u30c1\u30cd\u30b8\u30d1\u30ba\u30eb\u304c\u5c0e\u5165\u3055\u308c\u307e\u3059\u3002\u4ed6\u306e\u30d1\u30ba\u30eb\u30b2\u30fc\u30e0\u3068\u6bd4\u8f03\u3057\u3066\u3001\u30cd\u30b8\u30de\u30b9\u30bf\u30fc3D\uff1a\u30d4\u30f3\u30d1\u30ba\u30eb\u306f\u3001\u6b63\u78ba\u3055\u3068\u6226\u7565\u306e\u30e6\u30cb\u30fc\u30af\u306a\u7d44\u307f\u5408\u308f\u305b\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002[\u591a\u65b9\u6848\u6bd4\u8f03]"}, {"question": "\u30cd\u30b8\u30de\u30b9\u30bf\u30fc3D\uff1a\u30d4\u30f3\u30d1\u30ba\u30eb\u3067\u3001\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u3088\u304f\u72af\u3059\u4e00\u822c\u7684\u306a\u30df\u30b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30cd\u30b8\u30de\u30b9\u30bf\u30fc3D\uff1a\u30d4\u30f3\u30d1\u30ba\u30eb\u3067\u3001\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u3088\u304f\u72af\u3059\u4e00\u822c\u7684\u306a\u30df\u30b9\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u9069\u5207\u306a\u5206\u6790\u306a\u3057\u3067\u30ec\u30d9\u30eb\u3092\u6025\u3044\u3067\u9032\u3081\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u8a73\u7d30\u306a\u691c\u67fb\u306e\u305f\u3081\u306b\u30ba\u30fc\u30e0\u6a5f\u80fd\u3092\u898b\u843d\u3068\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30a8\u30e9\u30fc\u3092\u4fee\u6b63\u3059\u308b\u305f\u3081\u306b\u30a2\u30f3\u30c9\u30a5\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u306a\u3044\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb5\u3067\u306f\u3001\u30d4\u30f3\u4f4d\u7f6e\u306e\u691c\u67fb\u306a\u3057\u306b\u30cd\u30b8\u306e\u8abf\u6574\u3092\u6025\u3050\u3068\u3001\u305a\u308c\u304c\u751f\u3058\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u904b\u8ee2\u3068\u540c\u3058\u3067\u3001\u3086\u3063\u304f\u308a\u3068\u6642\u9593\u3092\u304b\u3051\u308b\u3053\u3068\u3067\u3001\u3088\u308a\u30b9\u30e0\u30fc\u30ba\u306a\u9053\u306e\u308a\u306b\u306a\u308a\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e]"}]
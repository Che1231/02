[{"question": "\u5982\u4f55\u5feb\u901f\u4e0a\u624b\u87ba\u4e1d\u5927\u5e08 3D\uff1a\u9500\u9489\u76ca\u667a\u6e38\u620f\u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u5feb\u901f\u4e0a\u624b\u87ba\u4e1d\u5927\u5e08 3D\uff1a\u9500\u9489\u76ca\u667a\u6e38\u620f\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u719f\u6089\u89e6\u6478\u63a7\u5236\uff1a\u70b9\u51fb\u5e76\u62d6\u52a8\u65cb\u8f6c\u87ba\u4e1d\u3002\u6b65\u9aa42 - \u4f7f\u7528\u7f29\u653e\u529f\u80fd\u66f4\u4ed4\u7ec6\u5730\u89c2\u5bdf\u76ca\u667a\u6e38\u620f\u3002\u6b65\u9aa43 - \u4ece\u6559\u7a0b\u5173\u5361\u5f00\u59cb\uff0c\u4e86\u89e3\u6e38\u620f\u673a\u5236\u3002\u4f8b\u5982\uff0c\u5728 1 \u7ea7\uff0c\u60a8\u5c06\u5b66\u4e60\u5982\u4f55\u901a\u8fc7\u65cb\u8f6c\u87ba\u4e1d\u4f7f\u5176\u4e0e\u9500\u9489\u5339\u914d\u6765\u5bf9\u9f50\u87ba\u4e1d\u3002\u53ef\u4ee5\u628a\u5b83\u60f3\u8c61\u6210\u5c06\u94a5\u5319\u63d2\u5165\u9501\u5b54\uff1b\u7cbe\u51c6\u81f3\u5173\u91cd\u8981\u3002[\u6bd4\u55bb\u8bf4\u660e]"}, {"question": "\u4e3a\u4ec0\u4e48\u87ba\u4e1d\u5927\u5e08 3D\uff1a\u9500\u9489\u76ca\u667a\u6e38\u620f\u4e2d\u7684\u67d0\u4e9b\u87ba\u4e1d\u4f3c\u4e4e\u65e0\u6cd5\u5bf9\u9f50\uff1f", "answer": "\u87ba\u4e1d\u5927\u5e08 3D\uff1a\u9500\u9489\u76ca\u667a\u6e38\u620f\u4e2d\u7684\u67d0\u4e9b\u87ba\u4e1d\u53ef\u80fd\u770b\u8d77\u6765\u65e0\u6cd5\u5bf9\u9f50\uff0c\u539f\u56e0\u662f\u5176\u5f62\u72b6\u548c\u89d2\u5ea6\u590d\u6742\u3002\u4ee5\u4e0b\u662f\u5982\u4f55\u5904\u7406\u5b83\u4eec\uff1a\u6b65\u9aa41 - \u6162\u6162\u65cb\u8f6c\u87ba\u4e1d\uff0c\u627e\u5230\u6b63\u786e\u7684\u89d2\u5ea6\u3002\u6b65\u9aa42 - \u4f7f\u7528\u7f29\u653e\u529f\u80fd\u68c0\u67e5\u87ba\u4e1d\u7684\u69fd\u3002\u6b65\u9aa43 - \u68c0\u67e5\u662f\u5426\u6709\u4efb\u4f55\u9690\u85cf\u7684\u9500\u9489\u53ef\u80fd\u963b\u788d\u5bf9\u9f50\u3002\u4f8b\u5982\uff0c\u5728 15 \u7ea7\uff0c\u4e00\u4e2a\u87ba\u4e1d\u770b\u8d77\u6765\u53ef\u80fd\u5bf9\u9f50\u9519\u8bef\uff0c\u4f46\u7a0d\u5fae\u65cb\u8f6c\u4e00\u4e0b\u5c31\u4f1a\u53d1\u73b0\u4e00\u4e2a\u9690\u85cf\u7684\u9700\u8981\u5339\u914d\u7684\u9500\u9489\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4]"}, {"question": "\u5728\u87ba\u4e1d\u5927\u5e08 3D\uff1a\u9500\u9489\u76ca\u667a\u6e38\u620f\u4e2d\u89e3\u51b3\u9ad8\u7ea7\u76ca\u667a\u6e38\u620f\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5bf9\u4e8e\u87ba\u4e1d\u5927\u5e08 3D\uff1a\u9500\u9489\u76ca\u667a\u6e38\u620f\u4e2d\u7684\u9ad8\u7ea7\u76ca\u667a\u6e38\u620f\uff0c\u8bf7\u8003\u8651\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9aa41 - \u5728\u8fdb\u884c\u4efb\u4f55\u64cd\u4f5c\u4e4b\u524d\u5206\u6790\u76ca\u667a\u6e38\u620f\u7684\u5e03\u5c40\u3002\u6b65\u9aa42 - \u9996\u5148\u4ece\u6700\u590d\u6742\u7684\u87ba\u4e1d\u5f00\u59cb\uff0c\u56e0\u4e3a\u5b83\u4eec\u901a\u5e38\u51b3\u5b9a\u5176\u4ed6\u87ba\u4e1d\u7684\u5bf9\u9f50\u65b9\u5f0f\u3002\u6b65\u9aa43 - \u5982\u679c\u51fa\u9519\uff0c\u8bf7\u4f7f\u7528\u64a4\u9500\u529f\u80fd\u8fdb\u884c\u56de\u6eaf\u3002\u4f8b\u5982\uff0c\u5728 30 \u7ea7\uff0c\u4ece\u4e2d\u5fc3\u87ba\u4e1d\u5f00\u59cb\u53ef\u4ee5\u7b80\u5316\u5468\u56f4\u9500\u9489\u7684\u5bf9\u9f50\u3002\u53ef\u4ee5\u628a\u5b83\u60f3\u8c61\u6210\u89e3\u51b3\u9b54\u65b9\uff1b\u6709\u65f6\uff0c\u4ece\u6700\u96be\u7684\u90e8\u5206\u5f00\u59cb\u53ef\u4ee5\u4f7f\u5269\u4e0b\u7684\u90e8\u5206\u66f4\u5bb9\u6613\u3002[\u6bd4\u55bb\u8bf4\u660e]"}, {"question": "\u87ba\u4e1d\u5927\u5e08 3D\uff1a\u9500\u9489\u76ca\u667a\u6e38\u620f\u4e2d\u54ea\u4e9b\u6e38\u620f\u673a\u5236\u5bf9\u4e8e\u6210\u529f\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u87ba\u4e1d\u5927\u5e08 3D\uff1a\u9500\u9489\u76ca\u667a\u6e38\u620f\u4e2d\u6700\u91cd\u8981\u7684\u6e38\u620f\u673a\u5236\u662f\u7cbe\u51c6\u65cb\u8f6c\u3001\u7f29\u653e\u529f\u80fd\u548c\u64a4\u9500\u529f\u80fd\u3002\u7cbe\u51c6\u65cb\u8f6c\u4f7f\u60a8\u53ef\u4ee5\u51c6\u786e\u5730\u5bf9\u9f50\u87ba\u4e1d\uff0c\u800c\u7f29\u653e\u529f\u80fd\u5219\u5e2e\u52a9\u60a8\u68c0\u67e5\u7ec6\u8282\u3002\u64a4\u9500\u529f\u80fd\u5bf9\u4e8e\u7ea0\u6b63\u9519\u8bef\u975e\u5e38\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5728 25 \u7ea7\uff0c\u4f7f\u7528\u7f29\u653e\u529f\u80fd\u68c0\u67e5\u87ba\u4e1d\u7684\u69fd\u53ef\u4ee5\u9632\u6b62\u5bf9\u9f50\u9519\u8bef\u3002[\u914d\u7f6e\u5bf9\u7167\u8868]"}, {"question": "\u87ba\u4e1d\u5927\u5e08 3D\uff1a\u9500\u9489\u76ca\u667a\u6e38\u620f\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u87ba\u4e1d\u5927\u5e08 3D\uff1a\u9500\u9489\u76ca\u667a\u6e38\u620f\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u5b8c\u6210\u5173\u5361\u6240\u9700\u7684\u64cd\u4f5c\u6b21\u6570\u548c\u65f6\u95f4\u3002\u64cd\u4f5c\u6b21\u6570\u5c11\u3001\u5b8c\u6210\u65f6\u95f4\u5feb\uff0c\u5f97\u5206\u8d8a\u9ad8\u3002\u4f8b\u5982\uff0c\u5728 2 \u5206\u949f\u5185\u4ee5\u6700\u5c11\u7684\u64cd\u4f5c\u6b21\u6570\u5b8c\u6210 10 \u7ea7\uff0c\u53ef\u4ee5\u83b7\u5f97 3 \u661f\u8bc4\u7ea7\u3002\u8fd9\u5c31\u50cf\u4e00\u573a\u4e0e\u65f6\u95f4\u7684\u8d5b\u8dd1\uff1b\u6548\u7387\u4f1a\u5f97\u5230\u56de\u62a5\u3002[\u6bd4\u55bb\u8bf4\u660e]"}, {"question": "\u7cbe\u901a\u87ba\u4e1d\u5927\u5e08 3D\uff1a\u9500\u9489\u76ca\u667a\u6e38\u620f\u7684\u9ad8\u7ea7\u5173\u5361\u6709\u4ec0\u4e48\u597d\u5904\uff1f", "answer": "\u7cbe\u901a\u87ba\u4e1d\u5927\u5e08 3D\uff1a\u9500\u9489\u76ca\u667a\u6e38\u620f\u7684\u9ad8\u7ea7\u5173\u5361\u5e26\u6765\u4e00\u4e9b\u597d\u5904\uff1a\u6b65\u9aa41 - \u589e\u5f3a\u95ee\u9898\u89e3\u51b3\u80fd\u529b\u3002\u6b65\u9aa42 - \u66f4\u6df1\u5165\u5730\u4e86\u89e3\u6e38\u620f\u673a\u5236\u3002\u6b65\u9aa43 - \u8bbf\u95ee\u9690\u85cf\u5173\u5361\u548c\u6210\u5c31\u3002\u4f8b\u5982\uff0c\u5b8c\u6210 50 \u7ea7\u53ef\u89e3\u9501\u4e00\u4e2a\u5177\u6709\u72ec\u7279\u6311\u6218\u7684\u9690\u85cf\u5173\u5361\u3002\u53ef\u4ee5\u628a\u5b83\u60f3\u8c61\u6210\u6e38\u620f\u4e2d\u5347\u7ea7\uff1b\u6bcf\u4e2a\u638c\u63e1\u7684\u5173\u5361\u90fd\u4f1a\u5e26\u6765\u65b0\u7684\u5956\u52b1\u3002[\u6bd4\u55bb\u8bf4\u660e]"}, {"question": "\u5982\u4f55\u5728\u65b0\u7684\u8bbe\u5907\u4e0a\u8f6c\u79fb\u6211\u5728\u87ba\u4e1d\u5927\u5e08 3D\uff1a\u9500\u9489\u76ca\u667a\u6e38\u620f\u4e2d\u7684\u8fdb\u5ea6\uff1f", "answer": "\u8981\u5c06\u60a8\u5728\u87ba\u4e1d\u5927\u5e08 3D\uff1a\u9500\u9489\u76ca\u667a\u6e38\u620f\u4e2d\u7684\u8fdb\u5ea6\u8f6c\u79fb\u5230\u65b0\u8bbe\u5907\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41 - \u786e\u4fdd\u60a8\u5728\u4e24\u53f0\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u5e10\u6237\u3002\u6b65\u9aa42 - \u4f7f\u7528\u4e91\u4fdd\u5b58\u529f\u80fd\u5c06\u65e7\u8bbe\u5907\u7684\u8fdb\u5ea6\u4e0a\u4f20\u3002\u6b65\u9aa43 - \u5728\u65b0\u8bbe\u5907\u4e0a\u4e0b\u8f7d\u4fdd\u5b58\u7684\u6570\u636e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u4ece Android \u8bbe\u5907\u5207\u6362\u5230 iOS \u8bbe\u5907\uff0c\u767b\u5f55\u60a8\u7684 Google Play \u5e10\u6237\u53ef\u4ee5\u65e0\u7f1d\u5730\u8f6c\u79fb\u60a8\u7684\u8fdb\u5ea6\u3002[\u914d\u7f6e\u5bf9\u7167\u8868]"}, {"question": "\u87ba\u4e1d\u5927\u5e08 3D\uff1a\u9500\u9489\u76ca\u667a\u6e38\u620f\u4e2d\u6709\u54ea\u4e9b\u9690\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "\u87ba\u4e1d\u5927\u5e08 3D\uff1a\u9500\u9489\u76ca\u667a\u6e38\u620f\u4e2d\u5305\u542b\u4e00\u4e9b\u9690\u85cf\u529f\u80fd\u548c\u5f69\u86cb\u3002\u4e00\u4e2a\u503c\u5f97\u6ce8\u610f\u7684\u4f8b\u5b50\u662f\u901a\u8fc7\u4ee5 3 \u661f\u8bc4\u7ea7\u5b8c\u6210\u6240\u6709\u5173\u5361\u6765\u89e3\u9501\u7684\u79d8\u5bc6\u5173\u5361\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u5173\u5361\u4e2d\u9690\u85cf\u7740\u4e00\u4e9b\u87ba\u4e1d\uff0c\u5982\u679c\u6b63\u786e\u5bf9\u9f50\uff0c\u5219\u4f1a\u663e\u793a\u5956\u52b1\u5206\u6570\u3002\u4f8b\u5982\uff0c\u5728 40 \u7ea7\uff0c\u4ee5\u72ec\u7279\u6a21\u5f0f\u5bf9\u9f50\u7279\u5b9a\u87ba\u4e1d\u53ef\u4ee5\u63ed\u793a\u9690\u85cf\u6210\u5c31\u3002[\u5f69\u86cb\u6316\u6398]"}, {"question": "\u87ba\u4e1d\u5927\u5e08 3D\uff1a\u9500\u9489\u76ca\u667a\u6e38\u620f\u7684\u96be\u5ea6\u66f2\u7ebf\u4e0e\u5176\u4ed6\u76ca\u667a\u6e38\u620f\u76f8\u6bd4\u5982\u4f55\uff1f", "answer": "\u87ba\u4e1d\u5927\u5e08 3D\uff1a\u9500\u9489\u76ca\u667a\u6e38\u620f\u7684\u96be\u5ea6\u66f2\u7ebf\u9010\u6e10\u9661\u5ced\uff0c\u63d0\u4f9b\u4e86\u5e73\u8861\u7684\u6311\u6218\u3002\u65e9\u671f\u5173\u5361\u4fa7\u91cd\u4e8e\u57fa\u672c\u673a\u5236\uff0c\u800c\u9ad8\u7ea7\u5173\u5361\u5219\u5f15\u5165\u4e86\u590d\u6742\u7684\u5f62\u72b6\u548c\u591a\u4e2a\u87ba\u4e1d\u3002\u4f8b\u5982\uff0c20 \u7ea7\u5f15\u5165\u4e86\u591a\u87ba\u4e1d\u76ca\u667a\u6e38\u620f\uff0c\u9700\u8981\u7cbe\u786e\u7684\u5bf9\u9f50\u3002\u4e0e\u5176\u4ed6\u76ca\u667a\u6e38\u620f\u76f8\u6bd4\uff0c\u87ba\u4e1d\u5927\u5e08 3D\uff1a\u9500\u9489\u76ca\u667a\u6e38\u620f\u63d0\u4f9b\u4e86\u4e00\u79cd\u72ec\u7279\u7ed3\u5408\u4e86\u7cbe\u786e\u6027\u548c\u7b56\u7565\u7684\u6e38\u620f\u4f53\u9a8c\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4]"}, {"question": "\u65b0\u73a9\u5bb6\u5728\u87ba\u4e1d\u5927\u5e08 3D\uff1a\u9500\u9489\u76ca\u667a\u6e38\u620f\u4e2d\u6700\u5e38\u89c1\u7684\u9519\u8bef\u662f\u4ec0\u4e48\uff1f", "answer": "\u87ba\u4e1d\u5927\u5e08 3D\uff1a\u9500\u9489\u76ca\u667a\u6e38\u620f\u7684\u65b0\u73a9\u5bb6\u7ecf\u5e38\u72af\u4ee5\u4e0b\u8fd9\u4e9b\u5e38\u89c1\u9519\u8bef\uff1a\u6b65\u9aa41 - \u5728\u6ca1\u6709\u5145\u5206\u5206\u6790\u7684\u60c5\u51b5\u4e0b\u5306\u5fd9\u5b8c\u6210\u5173\u5361\u3002\u6b65\u9aa42 - \u5ffd\u7565\u7f29\u653e\u529f\u80fd\u8fdb\u884c\u8be6\u7ec6\u68c0\u67e5\u3002\u6b65\u9aa43 - \u4e0d\u4f7f\u7528\u64a4\u9500\u529f\u80fd\u7ea0\u6b63\u9519\u8bef\u3002\u4f8b\u5982\uff0c\u5728 5 \u7ea7\uff0c\u5306\u5fd9\u5bf9\u9f50\u87ba\u4e1d\u800c\u6ca1\u6709\u68c0\u67e5\u9500\u9489\u4f4d\u7f6e\u4f1a\u5bfc\u81f4\u5bf9\u9f50\u9519\u8bef\u3002\u60f3\u60f3\u5f00\u8f66\uff1b\u6162\u6162\u6765\u53ef\u4ee5\u4f7f\u65c5\u7a0b\u66f4\u987a\u7545\u3002[\u6bd4\u55bb\u8bf4\u660e]"}]
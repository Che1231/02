[{"question": "\u5982\u4f55\u5feb\u901f\u5165\u9580 Screw Master 3D\uff1a\u87ba\u7d72\u62fc\u5716 \u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u5feb\u901f\u5165\u9580 Screw Master 3D\uff1a\u87ba\u7d72\u62fc\u5716\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u719f\u6089\u89f8\u63a7\u63a7\u5236\uff1a\u8f15\u89f8\u4e26\u62d6\u66f3\u65cb\u8f49\u87ba\u7d72\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u653e\u5927\u529f\u80fd\u66f4\u4ed4\u7d30\u5730\u89c0\u5bdf\u62fc\u5716\u3002\u6b65\u9a5f3 - \u5f9e\u6559\u5b78\u95dc\u5361\u958b\u59cb\u4e86\u89e3\u904a\u6232\u6a5f\u5236\u3002\u4f8b\u5982\uff0c\u5728\u95dc\u5361 1 \u4e2d\uff0c\u60a8\u5c07\u5b78\u7fd2\u5982\u4f55\u900f\u904e\u65cb\u8f49\u4f7f\u87ba\u7d72\u8207\u87ba\u91d8\u5c0d\u9f4a\u3002\u60f3\u50cf\u4e00\u4e0b\u5c07\u9470\u5319\u63d2\u5165\u9396\u5b54\uff1b\u7cbe\u6e96\u5ea6\u81f3\u95dc\u91cd\u8981\u3002[\u6bd4\u55bb\u8aaa\u660e]"}, {"question": "\u70ba\u4ec0\u9ebc Screw Master 3D\uff1a\u87ba\u7d72\u62fc\u5716 \u4e2d\u6709\u4e9b\u87ba\u7d72\u4f3c\u4e4e\u7121\u6cd5\u5c0d\u9f4a\uff1f", "answer": "Screw Master 3D\uff1a\u87ba\u7d72\u62fc\u5716 \u4e2d\u6709\u4e9b\u87ba\u7d72\u53ef\u80fd\u770b\u8d77\u4f86\u7121\u6cd5\u5c0d\u9f4a\uff0c\u9019\u662f\u7531\u65bc\u5b83\u5011\u7684\u5f62\u72c0\u548c\u89d2\u5ea6\u8907\u96dc\u3002\u4ee5\u4e0b\u662f\u5982\u4f55\u8655\u7406\u9019\u4e9b\u60c5\u6cc1\uff1a\u6b65\u9a5f1 - \u6162\u6162\u65cb\u8f49\u87ba\u7d72\uff0c\u4ee5\u627e\u5230\u6b63\u78ba\u7684\u89d2\u5ea6\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u653e\u5927\u529f\u80fd\u6aa2\u67e5\u87ba\u7d72\u7684\u6e9d\u69fd\u3002\u6b65\u9a5f3 - \u6aa2\u67e5\u662f\u5426\u6709\u4efb\u4f55\u96b1\u85cf\u7684\u87ba\u91d8\u53ef\u80fd\u6703\u59a8\u7919\u5c0d\u9f4a\u3002\u4f8b\u5982\uff0c\u5728\u95dc\u5361 15 \u4e2d\uff0c\u87ba\u7d72\u53ef\u80fd\u770b\u8d77\u4f86\u6c92\u6709\u5c0d\u9f4a\uff0c\u4f46\u7a0d\u7a0d\u65cb\u8f49\u5373\u53ef\u767c\u73fe\u9700\u8981\u5339\u914d\u7684\u96b1\u85cf\u87ba\u91d8\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4]"}, {"question": "\u89e3\u6c7a Screw Master 3D\uff1a\u87ba\u7d72\u62fc\u5716 \u4e2d\u9032\u968e\u62fc\u5716\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5c0d\u65bc Screw Master 3D\uff1a\u87ba\u7d72\u62fc\u5716 \u4e2d\u7684\u9032\u968e\u62fc\u5716\uff0c\u8acb\u8003\u616e\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9a5f1 - \u5728\u9032\u884c\u4efb\u4f55\u52d5\u4f5c\u4e4b\u524d\uff0c\u5148\u5206\u6790\u62fc\u5716\u4f48\u5c40\u3002\u6b65\u9a5f2 - \u5f9e\u6700\u8907\u96dc\u7684\u87ba\u7d72\u958b\u59cb\uff0c\u56e0\u70ba\u5b83\u5011\u901a\u5e38\u6703\u6c7a\u5b9a\u5176\u4ed6\u87ba\u7d72\u7684\u5c0d\u9f4a\u65b9\u5f0f\u3002\u6b65\u9a5f3 - \u5982\u679c\u72af\u932f\uff0c\u8acb\u4f7f\u7528\u5fa9\u539f\u529f\u80fd\u9032\u884c\u56de\u6eaf\u3002\u4f8b\u5982\uff0c\u5728\u95dc\u5361 30 \u4e2d\uff0c\u5f9e\u4e2d\u5fc3\u87ba\u7d72\u958b\u59cb\u53ef\u4ee5\u7c21\u5316\u5468\u570d\u87ba\u91d8\u7684\u5c0d\u9f4a\u3002\u60f3\u50cf\u4e00\u4e0b\u89e3 Rubik\u2019s \u7acb\u65b9\u9ad4\uff1b\u6709\u6642\uff0c\u5f9e\u6700\u96e3\u7684\u90e8\u5206\u958b\u59cb\u6703\u4f7f\u5176\u4ed6\u90e8\u5206\u66f4\u5bb9\u6613\u3002[\u6bd4\u55bb\u8aaa\u660e]"}, {"question": "Screw Master 3D\uff1a\u87ba\u7d72\u62fc\u5716 \u4e2d\u54ea\u4e9b\u904a\u6232\u6a5f\u5236\u5c0d\u6210\u529f\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "Screw Master 3D\uff1a\u87ba\u7d72\u62fc\u5716 \u4e2d\u6700\u95dc\u9375\u7684\u904a\u6232\u6a5f\u5236\u662f\u7cbe\u78ba\u65cb\u8f49\u3001\u653e\u5927\u529f\u80fd\u548c\u5fa9\u539f\u529f\u80fd\u3002\u7cbe\u78ba\u65cb\u8f49\u5141\u8a31\u60a8\u7cbe\u78ba\u5730\u5c0d\u9f4a\u87ba\u7d72\uff0c\u800c\u653e\u5927\u529f\u80fd\u5247\u6709\u52a9\u65bc\u6aa2\u67e5\u7d30\u7bc0\u3002\u5fa9\u539f\u529f\u80fd\u5c0d\u65bc\u66f4\u6b63\u932f\u8aa4\u81f3\u95dc\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5728\u95dc\u5361 25 \u4e2d\uff0c\u4f7f\u7528\u653e\u5927\u529f\u80fd\u6aa2\u67e5\u87ba\u7d72\u7684\u6e9d\u69fd\u53ef\u4ee5\u9632\u6b62\u932f\u4f4d\u3002[\u914d\u7f6e\u5c0d\u7167\u8868]"}, {"question": "Screw Master 3D\uff1a\u87ba\u7d72\u62fc\u5716 \u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "Screw Master 3D\uff1a\u87ba\u7d72\u62fc\u5716 \u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u5b8c\u6210\u95dc\u5361\u6240\u9700\u7684\u64cd\u4f5c\u6b21\u6578\u548c\u6642\u9593\u3002\u64cd\u4f5c\u6b21\u6578\u5c11\u4e14\u5b8c\u6210\u6642\u9593\u5feb\uff0c\u5c07\u6703\u7372\u5f97\u66f4\u9ad8\u7684\u5206\u6578\u3002\u4f8b\u5982\uff0c\u5728 2 \u5206\u9418\u5167\u4e14\u64cd\u4f5c\u6700\u5c11\u7684\u60c5\u6cc1\u4e0b\u5b8c\u6210\u95dc\u5361 10\uff0c\u53ef\u4ee5\u7372\u5f97 3 \u661f\u8a55\u7d1a\u3002\u9019\u5c31\u50cf\u4e00\u5834\u8207\u6642\u9593\u8cfd\u8dd1\uff1b\u6548\u7387\u6703\u5f97\u5230\u734e\u52f5\u3002[\u6bd4\u55bb\u8aaa\u660e]"}, {"question": "\u5728 Screw Master 3D\uff1a\u87ba\u7d72\u62fc\u5716 \u4e2d\u7cbe\u901a\u9ad8\u7d1a\u95dc\u5361\u6709\u4ec0\u9ebc\u597d\u8655\uff1f", "answer": "\u5728 Screw Master 3D\uff1a\u87ba\u7d72\u62fc\u5716 \u4e2d\u7cbe\u901a\u9ad8\u7d1a\u95dc\u5361\u63d0\u4f9b\u591a\u9805\u597d\u8655\uff1a\u6b65\u9a5f1 - \u589e\u5f37\u554f\u984c\u89e3\u6c7a\u80fd\u529b\u3002\u6b65\u9a5f2 - \u66f4\u6df1\u5165\u5730\u4e86\u89e3\u904a\u6232\u6a5f\u5236\u3002\u6b65\u9a5f3 - \u7372\u5f97\u96b1\u85cf\u95dc\u5361\u548c\u6210\u5c31\u3002\u4f8b\u5982\uff0c\u5b8c\u6210\u95dc\u5361 50 \u5c07\u89e3\u9396\u4e00\u500b\u5177\u6709\u7368\u7279\u6311\u6230\u7684\u96b1\u85cf\u95dc\u5361\u3002\u60f3\u50cf\u4e00\u4e0b\u5728\u904a\u6232\u4e2d\u5347\u7d1a\uff1b\u6bcf\u4e00\u95dc\u7684\u7cbe\u901a\u90fd\u6703\u5e36\u4f86\u65b0\u7684\u734e\u52f5\u3002[\u6bd4\u55bb\u8aaa\u660e]"}, {"question": "\u5982\u4f55\u5c07 Screw Master 3D\uff1a\u87ba\u7d72\u62fc\u5716 \u7684\u9032\u5ea6\u8f49\u79fb\u5230\u65b0\u7684\u88dd\u7f6e\uff1f", "answer": "\u8981\u5c07 Screw Master 3D\uff1a\u87ba\u7d72\u62fc\u5716 \u7684\u9032\u5ea6\u8f49\u79fb\u5230\u65b0\u7684\u88dd\u7f6e\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u78ba\u4fdd\u60a8\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u90fd\u767b\u5165\u540c\u4e00\u500b\u5e33\u6236\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u5c07\u9032\u5ea6\u5f9e\u820a\u88dd\u7f6e\u4e0a\u50b3\u3002\u6b65\u9a5f3 - \u5728\u65b0\u88dd\u7f6e\u4e0a\u4e0b\u8f09\u5132\u5b58\u7684\u6578\u64da\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9e Android \u88dd\u7f6e\u5207\u63db\u5230 iOS \u88dd\u7f6e\uff0c\u767b\u5165\u60a8\u7684 Google Play \u5e33\u6236\u53ef\u4ee5\u9806\u5229\u5730\u8f49\u79fb\u60a8\u7684\u9032\u5ea6\u3002[\u914d\u7f6e\u5c0d\u7167\u8868]"}, {"question": "Screw Master 3D\uff1a\u87ba\u7d72\u62fc\u5716 \u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u529f\u80fd\u6216\u5f69\u86cb\uff1f", "answer": "Screw Master 3D\uff1a\u87ba\u7d72\u62fc\u5716 \u5305\u542b\u4e00\u4e9b\u96b1\u85cf\u529f\u80fd\u548c\u5f69\u86cb\u3002\u4e00\u500b\u503c\u5f97\u6ce8\u610f\u7684\u4f8b\u5b50\u662f\u900f\u904e\u4ee5 3 \u661f\u8a55\u7d1a\u5b8c\u6210\u6240\u6709\u95dc\u5361\u800c\u89e3\u9396\u7684\u79d8\u5bc6\u95dc\u5361\u3002\u6b64\u5916\uff0c\u67d0\u4e9b\u95dc\u5361\u6709\u96b1\u85cf\u7684\u87ba\u7d72\uff0c\u5982\u679c\u6b63\u78ba\u5c0d\u9f4a\uff0c\u5247\u6703\u986f\u793a\u984d\u5916\u5206\u6578\u3002\u4f8b\u5982\uff0c\u5728\u95dc\u5361 40 \u4e2d\uff0c\u4ee5\u7368\u7279\u6a21\u5f0f\u5c0d\u9f4a\u7279\u5b9a\u87ba\u7d72\u5c07\u6703\u63ed\u793a\u96b1\u85cf\u6210\u5c31\u3002[\u5f69\u86cb\u6316\u6398]"}, {"question": "Screw Master 3D\uff1a\u87ba\u7d72\u62fc\u5716 \u7684\u96e3\u5ea6\u66f2\u7dda\u8207\u5176\u4ed6\u76ca\u667a\u904a\u6232\u76f8\u6bd4\u5982\u4f55\uff1f", "answer": "Screw Master 3D\uff1a\u87ba\u7d72\u62fc\u5716 \u7684\u96e3\u5ea6\u66f2\u7dda\u662f\u9010\u6f38\u589e\u52a0\u4f46\u9661\u5ced\u7684\uff0c\u63d0\u4f9b\u5e73\u8861\u7684\u6311\u6230\u3002\u65e9\u671f\u95dc\u5361\u91cd\u9ede\u653e\u5728\u57fa\u790e\u6a5f\u5236\uff0c\u800c\u9ad8\u7d1a\u95dc\u5361\u5247\u5f15\u5165\u8907\u96dc\u7684\u5f62\u72c0\u548c\u591a\u500b\u87ba\u7d72\u3002\u4f8b\u5982\uff0c\u95dc\u5361 20 \u5f15\u5165\u591a\u87ba\u7d72\u62fc\u5716\uff0c\u9700\u8981\u7cbe\u78ba\u7684\u5c0d\u9f4a\u3002\u8207\u5176\u4ed6\u76ca\u667a\u904a\u6232\u76f8\u6bd4\uff0cScrew Master 3D\uff1a\u87ba\u7d72\u62fc\u5716 \u63d0\u4f9b\u4e86\u7cbe\u78ba\u6027\u548c\u7b56\u7565\u7684\u7368\u7279\u7d50\u5408\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4]"}, {"question": "Screw Master 3D\uff1a\u87ba\u7d72\u62fc\u5716 \u4e2d\u65b0\u73a9\u5bb6\u6700\u5e38\u898b\u7684\u932f\u8aa4\u662f\u4ec0\u9ebc\uff1f", "answer": "Screw Master 3D\uff1a\u87ba\u7d72\u62fc\u5716 \u4e2d\u7684\u65b0\u73a9\u5bb6\u7d93\u5e38\u72af\u9019\u4e9b\u5e38\u898b\u932f\u8aa4\uff1a\u6b65\u9a5f1 - \u5728\u6c92\u6709\u5145\u5206\u5206\u6790\u7684\u60c5\u6cc1\u4e0b\u5009\u4fc3\u5b8c\u6210\u95dc\u5361\u3002\u6b65\u9a5f2 - \u5ffd\u7565\u653e\u5927\u529f\u80fd\u4ee5\u9032\u884c\u8a73\u7d30\u6aa2\u67e5\u3002\u6b65\u9a5f3 - \u672a\u4f7f\u7528\u5fa9\u539f\u529f\u80fd\u66f4\u6b63\u932f\u8aa4\u3002\u4f8b\u5982\uff0c\u5728\u95dc\u5361 5 \u4e2d\uff0c\u5728\u4e0d\u6aa2\u67e5\u87ba\u91d8\u4f4d\u7f6e\u7684\u60c5\u6cc1\u4e0b\u5009\u4fc3\u5c0d\u9f4a\u87ba\u7d72\uff0c\u6703\u5c0e\u81f4\u932f\u4f4d\u3002\u9019\u5c31\u50cf\u958b\u8eca\uff1b\u653e\u6162\u8eca\u901f\u53ef\u4ee5\u4f7f\u65c5\u7a0b\u66f4\u9806\u5229\u3002[\u6bd4\u55bb\u8aaa\u660e]"}]
[{"question": "\ucd08\ubcf4\uc790\ub85c\uc11c \ud0b9\ub364 \ud37c\uc990\uc744 \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud0b9\ub364 \ud37c\uc990\uc744 \uc2dc\uc791\ud558\ub824\uba74 \uba3c\uc800 \uc6d0\ud558\ub294 \uc571 \uc2a4\ud1a0\uc5b4\uc5d0\uc11c \uac8c\uc784\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc138\uc694. \uc124\uce58 \ud6c4 \uac8c\uc784\uc744 \uc2e4\ud589\ud558\uace0 \ud654\uba74\uc758 \ud29c\ud1a0\ub9ac\uc5bc\uc744 \ub530\ub974\uc138\uc694. \ud29c\ud1a0\ub9ac\uc5bc\uc740 \uc870\uac01\uc744 \uc6c0\uc9c1\uc5ec \ud37c\uc990\uc744 \ud478\ub294 \uae30\ubcf8\uc801\uc778 \uba54\ucee4\ub2c8\uc998\uc744 \uc548\ub0b4\ud574 \uc90d\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c\ub294 \uc131\ubcbd\uc744 \uc7ac\uac74\ud558\uae30 \uc704\ud574 \uc870\uac01\uc744 \ub9de\ucd94\uc5b4\uc57c \ud569\ub2c8\ub2e4. \ub9c9\ud788\uba74 '\ud78c\ud2b8' \ubc84\ud2bc\uc744 \ub20c\ub7ec\ubcf4\uc138\uc694. [\ube44\uc720 \uc124\uba85: \ud29c\ud1a0\ub9ac\uc5bc\uc740 \uc0c8\ub85c\uc6b4 \ub3c4\uc2dc\ub97c \uc548\ub0b4\ud558\ub294 \uc9c0\ub3c4\uc640 \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ud0b9\ub364 \ud37c\uc990\uc758 \uace0\uae09 \ud37c\uc990\uc744 \ud574\uacb0\ud558\uae30 \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud0b9\ub364 \ud37c\uc990\uc758 \uace0\uae09 \ud37c\uc990\uc744 \uc704\ud574 \ub2e4\uc74c \uc804\ub7b5\uc5d0 \uc9d1\uc911\ud558\uc138\uc694: STEP1: \uc5b4\ub5a4 \uc6c0\uc9c1\uc784\uc744 \ucde8\ud558\uae30 \uc804\uc5d0 \ud37c\uc990 \ub808\uc774\uc544\uc6c3\uc744 \ubd84\uc11d\ud558\uc138\uc694. STEP2: \uac00\uc7a5 \uba3c\uc800 \ud14c\ub450\ub9ac \uc870\uac01\uc744 \ucc3e\uc73c\uc138\uc694. \ubc30\uce58\ud558\uae30\uac00 \ub354 \uc27d\uc2b5\ub2c8\ub2e4. STEP3: \uc720\uc0ac\ud55c \uc0c9\uc0c1\uc774\ub098 \ud328\ud134\uc744 \uadf8\ub8f9\ud654\ud558\uc5ec \ubcf5\uc7a1\uc131\uc744 \uc904\uc774\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\ub9c8\ubc95\uc758 \uc232' \ub808\ubca8\uc5d0\uc11c \ub179\uc0c9 \uc78e\uc0ac\uadc0 \uc870\uac01\uc744 \uba3c\uc800 \uadf8\ub8f9\ud654\ud558\uba74 \ud37c\uc990\uc744 \uac04\uc18c\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc5ec\ub7ec \ubc29\uc548 \ube44\uad50: \ucd08\ubcf4\uc790\ub294 \ubb34\uc791\uc704\ub85c \uc870\uac01\uc744 \ubc30\uce58\ud558\ub294 \ubc18\uba74, \uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \uc804\ub7b5\uc801\uc73c\ub85c \uc6c0\uc9c1\uc784\uc744 \uacc4\ud68d\ud569\ub2c8\ub2e4.]"}, {"question": "\ud0b9\ub364 \ud37c\uc990\uc774 \uc644\ub8cc\ub41c \ub808\ubca8\uc5d0 \ubcc4\uc810 \uc2dc\uc2a4\ud15c\uc744 \uc0ac\uc6a9\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud0b9\ub364 \ud37c\uc990\uc740 \uac01 \ub808\ubca8\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uc758 \uc131\uacfc\ub97c \ud3c9\uac00\ud558\uae30 \uc704\ud574 \ubcc4\uc810 \uc2dc\uc2a4\ud15c\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \uc0ac\uc6a9\ud55c \uc6c0\uc9c1\uc784 \uc218\uc640 \uc18c\uc694 \uc2dc\uac04\uacfc \uac19\uc740 \uc694\uc18c\ub4e4\uc744 \uace0\ub824\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc655\uc2e4 \uc815\uc6d0' \ub808\ubca8\uc744 10\uac1c \ubbf8\ub9cc\uc758 \uc6c0\uc9c1\uc784\uc73c\ub85c \uc644\ub8cc\ud558\uba74 3\uac1c\uc758 \ubcc4\uc744 \ubc1b\uc2b5\ub2c8\ub2e4. \uc774 \uc2dc\uc2a4\ud15c\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc804\ub7b5\uc744 \uac1c\uc120\ud558\uace0 \ub354 \ub098\uc740 \uc810\uc218\ub97c \uc704\ud574 \ub808\ubca8\uc744 \ub2e4\uc2dc \ud50c\ub808\uc774\ud558\ub3c4\ub85d \uc7a5\ub824\ud569\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: 1\uac1c \ubcc4 - \uae30\ubcf8 \uc644\ub8cc, 2\uac1c \ubcc4 - \ud6a8\uc728\uc801\uc778 \uc6c0\uc9c1\uc784, 3\uac1c \ubcc4 - \ucd5c\uc801\uc758 \uc131\uacfc.]"}, {"question": "\ud0b9\ub364 \ud37c\uc990\uc5d0\uc11c \uac00\uc7a5 \uac00\uce58 \uc788\ub294 \uac8c\uc784 \ub0b4 \uc790\uc6d0\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud68d\ub4dd\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud0b9\ub364 \ud37c\uc990\uc5d0\uc11c \uac00\uc7a5 \uac00\uce58 \uc788\ub294 \uc790\uc6d0\uc740 \ucf54\uc778\uacfc \ud30c\uc6cc\uc5c5\uc785\ub2c8\ub2e4. \ucf54\uc778\uc740 \ub808\ubca8\uc744 \uc644\ub8cc\ud558\uac70\ub098 \uad11\uace0\ub97c \ubcf4\ub294 \uac83\uc73c\ub85c \uc5bb\uc744 \uc218 \uc788\uc73c\uba70, \ud78c\ud2b8\ub97c \uad6c\ub9e4\ud558\ub294 \ub370 \uc0ac\uc6a9\ub429\ub2c8\ub2e4. \"\ub9c8\ubc95 \uc9c0\ud321\uc774\"\uc640 \uac19\uc740 \ud30c\uc6cc\uc5c5\uc740 \ud2b9\ubcc4\ud55c \uc0c1\uc790\uc5d0\uc11c \ubc1c\uacac\ub418\uac70\ub098 \ucf54\uc778\uc73c\ub85c \uad6c\ub9e4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc6a9\uc758 \ub3d9\uad74\" \ub808\ubca8\uc5d0\uc11c \"\ub9c8\ubc95 \uc9c0\ud321\uc774\"\ub97c \uc0ac\uc6a9\ud558\uba74 \uc5b4\ub824\uc6b4 \ubd80\ubd84\uc744 \uc989\uc2dc \ud574\uacb0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ucf54\uc778\uc740 \ud654\ud3d0\uc640 \uac19\uace0, \ud30c\uc6cc\uc5c5\uc740 \ub3c4\uad6c \uc0c1\uc790\uc758 \ub3c4\uad6c\uc640 \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ud55c \uae30\uae30\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30\ub85c \ud0b9\ub364 \ud37c\uc990\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud0b9\ub364 \ud37c\uc990\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\ub824\uba74 \ub450 \uae30\uae30 \ubaa8\ub450\uc5d0\uc11c \uac19\uc740 \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud574\uc57c \ud569\ub2c8\ub2e4. \uc124\uc815 \uba54\ub274\uc5d0\uc11c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, iPhone\uc5d0\uc11c Android\ub85c \uc774\ub3d9\ud558\ub294 \uacbd\uc6b0 \uc0c8\ub85c\uc6b4 \uae30\uae30\uc5d0\uc11c Google Play \ub610\ub294 Apple ID\uc5d0 \ub85c\uadf8\uc778\ud558\uace0 \uc800\uc7a5\ub41c \ub370\uc774\ud130\ub97c \ubd88\ub7ec\uc624\uc138\uc694. [\ud504\ub85c\uc138\uc2a4 \ub2e4\uc774\uc5b4\uadf8\ub7a8: \uae30\uae30 A \u2192 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \u2192 \uae30\uae30 B.]"}, {"question": "\ud0b9\ub364 \ud37c\uc990\uc758 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uc640 \uc774\ub97c \ucc3e\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud0b9\ub364 \ud37c\uc990\uc5d0\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc2e0\ube44\ud55c \uc0ac\uc6d0' \ub808\ubca8\uc5d0\uc11c \ud2b9\uc815 \uc870\uac01\uc0c1\uc744 \uc138 \ubc88 \ub204\ub974\uba74 \uc228\uaca8\uc9c4 \ud37c\uc990\uc774 \uc5f4\ub9bd\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uc5f4\uc131\uc801\uc778 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \ucd94\uac00\uc801\uc778 \uc990\uac70\uc6c0\uacfc \ubc1c\uacac\uc744 \ub354\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ucc3e\ub294 \uac83\uc740 \uad11\ud65c\ud55c \uc655\uad6d\uc5d0\uc11c \ubb3b\ud78c \ubcf4\ubb3c\uc744 \ubc1c\uacac\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ud0b9\ub364 \ud37c\uc990\uc758 \ub09c\uc774\ub3c4 \uace1\uc120\uc740 \uc9c4\ud589\ub418\ub294 \ub3d9\uc548 \uc5b4\ub5bb\uac8c \uc9c4\ud654\ud558\ub098\uc694?", "answer": "\ud0b9\ub364 \ud37c\uc990\uc758 \ub09c\uc774\ub3c4\ub294 \uc810\uc9c4\uc801\uc73c\ub85c \uc99d\uac00\ud558\uc5ec \ub354 \ubcf5\uc7a1\ud55c \ud37c\uc990 \uba54\ucee4\ub2c8\uc998\uacfc \ub354 \ub9ce\uc740 \uc870\uac01 \uc218\ub97c \uc18c\uac1c\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucd08\uae30 \ub808\ubca8\uc740 20\uac1c \uc870\uac01\uc758 \ud37c\uc990\uc744 \ud2b9\uc9d5\uc73c\ub85c \ud558\ub294 \ubc18\uba74, \ud6c4\ubc18 \ub808\ubca8\uc778 '\ud06c\ub9ac\uc2a4\ud0c8 \ub3d9\uad74'\uc740 100\uac1c \uc774\uc0c1\uc758 \uc870\uac01\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784\uc740 \ub610\ud55c \uc870\uac01 \ud68c\uc804 \ubc0f \uc2dc\uac04 \uc81c\ud55c \ud37c\uc990\uacfc \uac19\uc740 \uc0c8\ub85c\uc6b4 \ub3c4\uc804 \uacfc\uc81c\ub97c \uc18c\uac1c\ud569\ub2c8\ub2e4. [\uc5ec\ub7ec \ubc29\uc548 \ube44\uad50: \ucd08\uae30 \ub808\ubca8\uc740 \uac04\ub2e8\ud558\uc9c0\ub9cc, \uace0\uae09 \ub808\ubca8\uc740 \uc138\uc2ec\ud55c \uacc4\ud68d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.]"}, {"question": "\ubaa8\ubc14\uc77c \ubc84\uc804\uacfc PC \ubc84\uc804\uc758 \ud0b9\ub364 \ud37c\uc990\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ubaa8\ubc14\uc77c \ubc84\uc804\uacfc PC \ubc84\uc804\uc758 \ud0b9\ub364 \ud37c\uc990\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \uc81c\uc5b4 \ubc29\uc2dd\uacfc \ub514\uc2a4\ud50c\ub808\uc774 \uc635\uc158\uc785\ub2c8\ub2e4. \ubaa8\ubc14\uc77c \ubc84\uc804\uc740 \ud130\uce58 \uc81c\uc5b4\ub97c \uc0ac\uc6a9\ud558\ub294 \ubc18\uba74, PC \ubc84\uc804\uc740 \ub9c8\uc6b0\uc2a4 \ubc0f \ud0a4\ubcf4\ub4dc\ub97c \uc9c0\uc6d0\ud569\ub2c8\ub2e4. \ub610\ud55c PC \ubc84\uc804\uc740 \ub354 \ub192\uc740 \ud574\uc0c1\ub3c4\uc758 \uadf8\ub798\ud53d\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ub300\uc131\ub2f9' \ub808\ubca8\uc740 PC \ubaa8\ub2c8\ud130\uc5d0\uc11c \ub354 \uc790\uc138\ud558\uac8c \ubcf4\uc785\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: \ubaa8\ubc14\uc77c - \ud130\uce58 \uc81c\uc5b4, PC - \ub9c8\uc6b0\uc2a4/\ud0a4\ubcf4\ub4dc \uc81c\uc5b4.]"}, {"question": "\ud0b9\ub364 \ud37c\uc990 \ud50c\ub808\uc774\ub97c \uc704\ud574 \uae30\uae30 \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud0b9\ub364 \ud37c\uc990\uc744 \uc704\ud574 \uae30\uae30\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \ucd5c\uc2e0 \uc6b4\uc601 \uccb4\uc81c\uc640 \ucda9\ubd84\ud55c \uc800\uc7a5 \uacf5\uac04\uc744 \ud655\ubcf4\ud558\uc2ed\uc2dc\uc624. \ubc31\uadf8\ub77c\uc6b4\ub4dc \uc571\uc744 \ub2eb\uc544 RAM\uc744 \ud655\ubcf4\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, iPhone\uc5d0\uc11c \uac8c\uc784\uc744 \uc2e4\ud589\ud558\uae30 \uc804\uc5d0 \uc0ac\uc6a9\ud558\uc9c0 \uc54a\ub294 \uc571\uc744 \uc4f8\uc5b4\ub0b4\ub824 \ub2eb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784\uc758 \uc635\uc158 \uba54\ub274\uc5d0\uc11c \uadf8\ub798\ud53d \uc124\uc815\uc744 \ub0ae\ucd94\uba74 \uc131\ub2a5\ub3c4 \ud5a5\uc0c1\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uae30\uae30\ub97c \uc790\ub3d9\ucc28\uc5d0 \ube44\uc720\ud558\uba74 \uc815\uae30\uc801\uc778 \uc720\uc9c0\ubcf4\uc218\ub85c \uc6d0\ud65c\ud55c \uc8fc\ud589\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4.]"}, {"question": "\ud0b9\ub364 \ud37c\uc990 \ucee4\ubba4\ub2c8\ud2f0\uc640 \uc5b4\ub5bb\uac8c \uc18c\ud1b5\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud0b9\ub364 \ud37c\uc990 \ucee4\ubba4\ub2c8\ud2f0\uc640 \uc18c\ud1b5\ud558\ub824\uba74 \uacf5\uc2dd \ud3ec\ub7fc\uc5d0 \uac00\uc785\ud558\uace0, \uc18c\uc15c \ubbf8\ub514\uc5b4 \uadf8\ub8f9\uc5d0 \ucc38\uc5ec\ud558\uace0, \ub77c\uc774\ube0c \uc774\ubca4\ud2b8\uc5d0 \ucc38\uc11d\ud558\uc138\uc694. \uc790\uc2e0\uc758 \uc131\uacfc\uc640 \uc804\ub7b5\uc744 \uacf5\uc720\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\ud574\uc801\uc758 \ub9cc' \ub808\ubca8\uc5d0\uc11c 3\uc131 \ub2ec\uc131\ud55c \uc2a4\ud06c\ub9b0\uc0f7\uc744 \uac8c\uc2dc\ud558\uba74 \ub2e4\ub978 \uc0ac\ub78c\ub4e4\uc5d0\uac8c \uc601\uac10\uc744 \uc904 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ucee4\ubba4\ub2c8\ud2f0\uc5d0 \ucc38\uc5ec\ud558\ub294 \uac83\uc740 \uc911\uc138 \uc655\uad6d\uc5d0\uc11c \uae38\ub4dc\uc5d0 \uac00\uc785\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}]
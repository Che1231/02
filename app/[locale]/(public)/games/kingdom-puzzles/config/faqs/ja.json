[{"question": "\u521d\u5fc3\u8005\u5411\u3051\u306b\u738b\u56fd\u30d1\u30ba\u30eb\u3092\u59cb\u3081\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u738b\u56fd\u30d1\u30ba\u30eb\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u307e\u305a\u304a\u597d\u307f\u306e\u30a2\u30d7\u30ea\u30b9\u30c8\u30a2\u304b\u3089\u30b2\u30fc\u30e0\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u5f8c\u3001\u30b2\u30fc\u30e0\u3092\u8d77\u52d5\u3057\u3001\u753b\u9762\u306e\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u306b\u5f93\u3044\u307e\u3059\u3002\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3067\u306f\u3001\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u305f\u3081\u306b\u30d4\u30fc\u30b9\u3092\u30c9\u30e9\u30c3\u30b0\u3059\u308b\u306a\u3069\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u65b9\u6cd5\u3092\u30ac\u30a4\u30c9\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u57ce\u58c1\u3092\u518d\u5efa\u3059\u308b\u305f\u3081\u306b\u30d4\u30fc\u30b9\u3092\u4e00\u81f4\u3055\u305b\u307e\u3059\u3002\u884c\u304d\u8a70\u307e\u3063\u305f\u5834\u5408\u306f\u3001\u300e\u30d2\u30f3\u30c8\u300f\u30dc\u30bf\u30f3\u3092\u30bf\u30c3\u30d7\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u306f\u3001\u65b0\u3057\u3044\u8857\u3092\u6848\u5185\u3059\u308b\u5730\u56f3\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u738b\u56fd\u30d1\u30ba\u30eb\u3067\u4e0a\u7d1a\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u738b\u56fd\u30d1\u30ba\u30eb\u3067\u4e0a\u7d1a\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u305f\u3081\u306e\u6226\u7565\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u79fb\u52d5\u3059\u308b\u524d\u306b\u30d1\u30ba\u30eb\u914d\u7f6e\u3092\u5206\u6790\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u7aef\u306e\u30d4\u30fc\u30b9\u3092\u6700\u521d\u306b\u7279\u5b9a\u3057\u307e\u3059\u3002\u914d\u7f6e\u3057\u3084\u3059\u3044\u304b\u3089\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u4f3c\u305f\u8272\u306e\u30d4\u30fc\u30b9\u307e\u305f\u306f\u30d1\u30bf\u30fc\u30f3\u3092\u30b0\u30eb\u30fc\u30d7\u5316\u3057\u3066\u8907\u96d1\u3055\u3092\u8efd\u6e1b\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001 \u300c\u9b54\u6cd5\u306e\u68ee\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u7dd1\u8272\u306e\u8449\u3063\u3071\u306e\u30d4\u30fc\u30b9\u3092\u6700\u521d\u306b\u30b0\u30eb\u30fc\u30d7\u5316\u3059\u308b\u3068\u3001\u30d1\u30ba\u30eb\u306e\u96e3\u6613\u5ea6\u3092\u4e0b\u3052\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u521d\u5fc3\u8005\u3068\u306f\u7570\u306a\u308a\u3001\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u6226\u7565\u7684\u306b\u79fb\u52d5\u3092\u8a08\u753b\u3057\u307e\u3059\u3002]"}, {"question": "\u738b\u56fd\u30d1\u30ba\u30eb\u304c\u5b8c\u6210\u3057\u305f\u30ec\u30d9\u30eb\u306e\u661f\u8a55\u4fa1\u30b7\u30b9\u30c6\u30e0\u3092\u4f7f\u7528\u3059\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u738b\u56fd\u30d1\u30ba\u30eb\u306f\u3001\u5404\u30ec\u30d9\u30eb\u3067\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u8a55\u4fa1\u3059\u308b\u305f\u3081\u306b\u661f\u8a55\u4fa1\u30b7\u30b9\u30c6\u30e0\u3092\u4f7f\u7528\u3057\u3066\u3044\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u3067\u306f\u3001\u4f7f\u7528\u3057\u305f\u79fb\u52d5\u6570\u3068\u6240\u8981\u6642\u9593\u306a\u3069\u306e\u8981\u7d20\u3092\u8003\u616e\u3057\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30ed\u30a4\u30e4\u30eb\u30ac\u30fc\u30c7\u30f3\u300d\u30ec\u30d9\u30eb\u309210\u624b\u4ee5\u5185\u3067\u30af\u30ea\u30a2\u3059\u308b\u3068\u30013\u3064\u306e\u661f\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u6226\u7565\u3092\u6d17\u7df4\u3057\u3001\u3088\u308a\u826f\u3044\u30b9\u30b3\u30a2\u306e\u305f\u3081\u306b\u30ec\u30d9\u30eb\u3092\u7e70\u308a\u8fd4\u3057\u30d7\u30ec\u30a4\u3059\u308b\u3053\u3068\u3092\u5968\u52b1\u3057\u307e\u3059\u3002[\u69cb\u6210\u5bfe\u7167\u8868\uff1a1\u661f - \u57fa\u672c\u7684\u306a\u30af\u30ea\u30a2\u30012\u661f - \u52b9\u7387\u7684\u306a\u79fb\u52d5\u30013\u661f - \u6700\u9069\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3002]"}, {"question": "\u738b\u56fd\u30d1\u30ba\u30eb\u3067\u6700\u3082\u4fa1\u5024\u306e\u3042\u308b\u30b2\u30fc\u30e0\u5185\u30ea\u30bd\u30fc\u30b9\u306f\u4f55\u304b\u3001\u305d\u3057\u3066\u305d\u308c\u3089\u3092\u5165\u624b\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u738b\u56fd\u30d1\u30ba\u30eb\u3067\u6700\u3082\u4fa1\u5024\u306e\u3042\u308b\u30ea\u30bd\u30fc\u30b9\u306f\u30b3\u30a4\u30f3\u3068\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3067\u3059\u3002\u30b3\u30a4\u30f3\u306f\u3001\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3057\u305f\u308a\u3001\u5e83\u544a\u3092\u898b\u305f\u308a\u3059\u308b\u3053\u3068\u3067\u7372\u5f97\u3067\u304d\u3001\u30d2\u30f3\u30c8\u3092\u8cfc\u5165\u3059\u308b\u305f\u3081\u306b\u4f7f\u7528\u3055\u308c\u307e\u3059\u3002 \u300e\u9b54\u6cd5\u306e\u6756\u300f\u306a\u3069\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u3001\u7279\u5225\u306a\u7bb1\u306e\u4e2d\u306b\u3042\u3063\u305f\u308a\u3001\u30b3\u30a4\u30f3\u3067\u8cfc\u5165\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30c9\u30e9\u30b4\u30f3'\u30ba\u30fb\u30ec\u30a2\u30fc\u300f\u30ec\u30d9\u30eb\u3067\u300e\u9b54\u6cd5\u306e\u6756\u300f\u3092\u4f7f\u3046\u3068\u3001\u96e3\u3057\u3044\u90e8\u5206\u3092\u77ac\u6642\u306b\u89e3\u304f\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u30b3\u30a4\u30f3\u306f\u901a\u8ca8\u3001\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306f\u5de5\u5177\u7bb1\u306e\u9053\u5177\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u8907\u6570\u306e\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u738b\u56fd\u30d1\u30ba\u30eb\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u738b\u56fd\u30d1\u30ba\u30eb\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u306b\u3042\u308b\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001iPhone\u304b\u3089Android\u306b\u79fb\u52d5\u3059\u308b\u5834\u5408\u306f\u3001\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u3067Google Play\u307e\u305f\u306fApple ID\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3001\u4fdd\u5b58\u3055\u308c\u305f\u30c7\u30fc\u30bf\u3092\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30c7\u30d0\u30a4\u30b9A \u2192 \u30af\u30e9\u30a6\u30c9\u4fdd\u5b58 \u2192 \u30c7\u30d0\u30a4\u30b9B\u3002]"}, {"question": "\u738b\u56fd\u30d1\u30ba\u30eb\u306b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u3092\u898b\u3064\u3051\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u738b\u56fd\u30d1\u30ba\u30eb\u306b\u306f\u3001\u96a0\u3057\u30ec\u30d9\u30eb\u3084\u30ec\u30a2\u306a\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306a\u3069\u306e\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u795e\u79d8\u306e\u5bfa\u9662\u300d\u30ec\u30d9\u30eb\u3067\u306f\u3001\u7279\u5b9a\u306e\u50cf\u30923\u56de\u30bf\u30c3\u30d7\u3059\u308b\u3068\u3001\u96a0\u3055\u308c\u305f\u30d1\u30ba\u30eb\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3001\u71b1\u5fc3\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u305f\u3081\u306b\u3001\u3055\u3089\u306b\u697d\u3057\u3044\u767a\u898b\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u63a2\u3059\u3053\u3068\u306f\u3001\u5e83\u5927\u306a\u738b\u56fd\u3067\u57cb\u3082\u308c\u305f\u5b9d\u7269\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u3068\u540c\u3058\u3067\u3059\u3002]"}, {"question": "\u738b\u56fd\u30d1\u30ba\u30eb\u306b\u304a\u3051\u308b\u96e3\u6613\u5ea6\u66f2\u7dda\u306f\u3001\u9032\u884c\u72b6\u6cc1\u306b\u5408\u308f\u305b\u3066\u3069\u306e\u3088\u3046\u306b\u5909\u5316\u3057\u307e\u3059\u304b\uff1f", "answer": "\u738b\u56fd\u30d1\u30ba\u30eb\u306b\u304a\u3051\u308b\u96e3\u6613\u5ea6\u304c\u6bb5\u968e\u7684\u306b\u4e0a\u6607\u3059\u308b\u305f\u3081\u306b\u306f\u3001\u3088\u308a\u8907\u96d1\u306a\u30d1\u30ba\u30eb\u30e1\u30ab\u30cb\u30ba\u30e0\u3068\u3088\u308a\u591a\u304f\u306e\u30d4\u30fc\u30b9\u6570\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u521d\u671f\u306e\u30ec\u30d9\u30eb\u3067\u306f20\u500b\u306e\u30d4\u30fc\u30b9\u306e\u30d1\u30ba\u30eb\u304c\u3042\u308a\u307e\u3059\u304c\u3001\u5f8c\u671f\u306e\u30ec\u30d9\u30eb\uff08\u300c\u6c34\u6676\u306e\u6d1e\u7a9f\u300d\u306a\u3069\uff09\u3067\u306f100\u500b\u4ee5\u4e0a\u306e\u30d4\u30fc\u30b9\u304c\u4f7f\u7528\u3055\u308c\u307e\u3059\u3002\u307e\u305f\u3001\u30d4\u30fc\u30b9\u3092\u56de\u8ee2\u3055\u305b\u305f\u308a\u3001\u5236\u9650\u6642\u9593\u306e\u30d1\u30ba\u30eb\u306a\u3069\u3001\u65b0\u3057\u3044\u8ab2\u984c\u3082\u5c0e\u5165\u3055\u308c\u3066\u3044\u307e\u3059\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u521d\u671f\u306e\u30ec\u30d9\u30eb\u306f\u7c21\u5358\u3067\u3059\u304c\u3001\u4e0a\u7d1a\u30ec\u30d9\u30eb\u306f\u7dbf\u5bc6\u306a\u8a08\u753b\u304c\u5fc5\u8981\u3067\u3059\u3002]"}, {"question": "\u30e2\u30d0\u30a4\u30eb\u7248\u3068PC\u7248\u306e\u738b\u56fd\u30d1\u30ba\u30eb\u306b\u306f\u3069\u306e\u3088\u3046\u306a\u4e3b\u306a\u9055\u3044\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30e2\u30d0\u30a4\u30eb\u7248\u3068PC\u7248\u306e\u738b\u56fd\u30d1\u30ba\u30eb\u306b\u306f\u3001\u5236\u5fa1\u65b9\u6cd5\u3084\u8868\u793a\u30aa\u30d7\u30b7\u30e7\u30f3\u306a\u3069\u306e\u4e3b\u306a\u9055\u3044\u304c\u3042\u308a\u307e\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u7248\u306f\u30bf\u30c3\u30c1\u64cd\u4f5c\u3092\u4f7f\u7528\u3057\u307e\u3059\u304c\u3001PC\u7248\u306f\u30de\u30a6\u30b9\u3068\u30ad\u30fc\u30dc\u30fc\u30c9\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001PC\u7248\u3067\u306f\u89e3\u50cf\u5ea6\u304c\u9ad8\u3044\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u3092\u63d0\u4f9b\u3057\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u5927\u8056\u5802\u300d\u30ec\u30d9\u30eb\u306fPC\u30e2\u30cb\u30bf\u30fc\u3067\u3088\u308a\u8a73\u7d30\u306b\u898b\u3048\u307e\u3059\u3002[\u69cb\u6210\u5bfe\u7167\u8868\uff1a\u30e2\u30d0\u30a4\u30eb - \u30bf\u30c3\u30c1\u64cd\u4f5c\u3001PC - \u30de\u30a6\u30b9/\u30ad\u30fc\u30dc\u30fc\u30c9\u64cd\u4f5c\u3002]"}, {"question": "\u738b\u56fd\u30d1\u30ba\u30eb\u3092\u30d7\u30ec\u30a4\u3059\u308b\u305f\u3081\u306b\u3001\u30c7\u30d0\u30a4\u30b9\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u738b\u56fd\u30d1\u30ba\u30eb\u7528\u306b\u30c7\u30d0\u30a4\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u6700\u65b0\u306e\u30aa\u30da\u30ec\u30fc\u30c6\u30a3\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u3068\u5341\u5206\u306a\u30b9\u30c8\u30ec\u30fc\u30b8\u5bb9\u91cf\u3092\u78ba\u4fdd\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u30a2\u30d7\u30ea\u3092\u9589\u3058\u308b\u3068\u3001RAM\u3092\u89e3\u653e\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001iPhone\u3067\u306f\u3001\u30b2\u30fc\u30e0\u8d77\u52d5\u524d\u306b\u4f7f\u7528\u3057\u3066\u3044\u306a\u3044\u30a2\u30d7\u30ea\u3092\u30b9\u30ef\u30a4\u30d7\u30a2\u30c3\u30d7\u3067\u9589\u3058\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306e\u30aa\u30d7\u30b7\u30e7\u30f3\u30e1\u30cb\u30e5\u30fc\u3067\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3092\u4e0b\u3052\u308b\u3053\u3068\u3082\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u5411\u4e0a\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u30c7\u30d0\u30a4\u30b9\u3092\u8eca\u3068\u8003\u3048\u308b\u3068\u3001\u5b9a\u671f\u7684\u306a\u30e1\u30f3\u30c6\u30ca\u30f3\u30b9\u3067\u30b9\u30e0\u30fc\u30ba\u306a\u8d70\u884c\u304c\u78ba\u4fdd\u3055\u308c\u307e\u3059\u3002]"}, {"question": "\u738b\u56fd\u30d1\u30ba\u30eb\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u306b\u53c2\u52a0\u3059\u308b\u306b\u306f\u3001\u3069\u306e\u3088\u3046\u306a\u6700\u826f\u306e\u65b9\u6cd5\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u516c\u5f0f\u30d5\u30a9\u30fc\u30e9\u30e0\u306b\u53c2\u52a0\u3057\u305f\u308a\u3001\u30bd\u30fc\u30b7\u30e3\u30eb\u30e1\u30c7\u30a3\u30a2\u30b0\u30eb\u30fc\u30d7\u306b\u53c2\u52a0\u3057\u305f\u308a\u3001\u30e9\u30a4\u30d6\u30a4\u30d9\u30f3\u30c8\u306b\u53c2\u52a0\u3057\u305f\u308a\u3059\u308b\u3053\u3068\u3067\u3001\u738b\u56fd\u30d1\u30ba\u30eb\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u3068\u4ea4\u6d41\u3057\u307e\u3059\u3002\u6210\u679c\u3084\u6226\u7565\u3092\u5171\u6709\u3057\u3001\u305f\u3068\u3048\u3070\u300c\u6d77\u8cca\u306e\u5165\u308a\u6c5f\u300d\u30ec\u30d9\u30eb\u30673\u3064\u661f\u3092\u7372\u5f97\u3057\u305f\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\u3092\u6295\u7a3f\u3059\u308b\u3068\u3001\u4ed6\u306e\u4eba\u306b\u30a4\u30f3\u30b9\u30d4\u30ec\u30fc\u30b7\u30e7\u30f3\u3092\u4e0e\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u306b\u53c2\u52a0\u3059\u308b\u3053\u3068\u306f\u3001\u4e2d\u4e16\u306e\u738b\u56fd\u3067\u30ae\u30eb\u30c9\u306b\u53c2\u52a0\u3059\u308b\u306e\u3068\u540c\u3058\u3067\u3059\u3002]"}]
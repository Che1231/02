[{"question": "\u65b0\u624b\u5982\u4f55\u5f00\u59cb\u73a9\u738b\u56fd\u62fc\u56fe\u6e38\u620f\uff1f", "answer": "\u8981\u5f00\u59cb\u73a9\u738b\u56fd\u62fc\u56fe\u6e38\u620f\uff0c\u9996\u5148\u9700\u8981\u4ece\u60a8\u9009\u62e9\u7684\u5e94\u7528\u5546\u5e97\u4e0b\u8f7d\u6e38\u620f\u3002\u5b89\u88c5\u540e\uff0c\u542f\u52a8\u6e38\u620f\u5e76\u6309\u7167\u5c4f\u5e55\u4e0a\u7684\u6559\u7a0b\u64cd\u4f5c\u3002\u6559\u7a0b\u5c06\u6307\u5bfc\u60a8\u5b8c\u6210\u57fa\u672c\u7684\u62fc\u56fe\u64cd\u4f5c\uff0c\u4f8b\u5982\u62d6\u52a8\u788e\u7247\u6765\u89e3\u51b3\u62fc\u56fe\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u5173\u4e2d\uff0c\u60a8\u9700\u8981\u5339\u914d\u788e\u7247\u6765\u91cd\u5efa\u57ce\u5821\u5899\u3002\u5982\u679c\u9047\u5230\u56f0\u96be\uff0c\u8bf7\u70b9\u51fb\u201c\u63d0\u793a\u201d\u6309\u94ae\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u6559\u7a0b\u60f3\u8c61\u6210\u5f15\u5bfc\u60a8\u8fdb\u5165\u65b0\u57ce\u5e02\u7684\u6307\u5357\u5730\u56fe\u3002]"}, {"question": "\u5728\u738b\u56fd\u62fc\u56fe\u6e38\u620f\u4e2d\u89e3\u51b3\u9ad8\u7ea7\u62fc\u56fe\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5bf9\u4e8e\u738b\u56fd\u62fc\u56fe\u6e38\u620f\u4e2d\u7684\u9ad8\u7ea7\u62fc\u56fe\uff0c\u8bf7\u5173\u6ce8\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9aa41\uff1a\u5728\u8fdb\u884c\u4efb\u4f55\u79fb\u52a8\u4e4b\u524d\uff0c\u5206\u6790\u62fc\u56fe\u5e03\u5c40\u3002\u6b65\u9aa42\uff1a\u9996\u5148\u8bc6\u522b\u8fb9\u7f18\u788e\u7247\uff0c\u56e0\u4e3a\u5b83\u4eec\u66f4\u5bb9\u6613\u653e\u7f6e\u3002\u6b65\u9aa43\uff1a\u5c06\u76f8\u540c\u989c\u8272\u6216\u56fe\u6848\u7684\u788e\u7247\u7ec4\u5408\u5728\u4e00\u8d77\u4ee5\u964d\u4f4e\u590d\u6742\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u201c\u795e\u5947\u68ee\u6797\u201d\u5173\u5361\u4e2d\uff0c\u5c06\u7eff\u8272\u690d\u7269\u788e\u7247\u7ec4\u5408\u5728\u4e00\u8d77\u53ef\u4ee5\u7b80\u5316\u62fc\u56fe\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u4e0e\u65b0\u624b\u53ef\u80fd\u4f1a\u968f\u673a\u653e\u7f6e\u788e\u7247\u4e0d\u540c\uff0c\u9ad8\u7ea7\u73a9\u5bb6\u4f1a\u6218\u7565\u6027\u5730\u89c4\u5212\u4ed6\u4eec\u7684\u884c\u52a8\u3002]"}, {"question": "\u738b\u56fd\u62fc\u56fe\u6e38\u620f\u4e3a\u4f55\u4f7f\u7528\u661f\u7ea7\u8bc4\u4ef7\u7cfb\u7edf\u6765\u8bc4\u4ef7\u5b8c\u6210\u5173\u5361\uff1f", "answer": "\u738b\u56fd\u62fc\u56fe\u6e38\u620f\u4f7f\u7528\u661f\u7ea7\u8bc4\u4ef7\u7cfb\u7edf\u6765\u8bc4\u4f30\u60a8\u5728\u6bcf\u4e2a\u5173\u5361\u4e2d\u7684\u8868\u73b0\u3002\u8be5\u7cfb\u7edf\u4f1a\u8003\u8651\u6240\u7528\u6b65\u6570\u548c\u8017\u8d39\u65f6\u95f4\u7b49\u56e0\u7d20\u3002\u4f8b\u5982\uff0c\u5728\u201c\u7687\u5bb6\u82b1\u56ed\u201d\u5173\u5361\u4e2d\uff0c\u5728 10 \u6b65\u4ee5\u5185\u5b8c\u6210\u5173\u5361\u5c06\u83b7\u5f97\u4e09\u9897\u661f\u3002\u8be5\u7cfb\u7edf\u9f13\u52b1\u73a9\u5bb6\u6539\u8fdb\u7b56\u7565\u5e76\u91cd\u73a9\u5173\u5361\u4ee5\u83b7\u5f97\u66f4\u597d\u7684\u5206\u6570\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a1 \u661f - \u57fa\u672c\u5b8c\u6210\uff0c2 \u661f - \u9ad8\u6548\u79fb\u52a8\uff0c3 \u661f - \u6700\u4f73\u6027\u80fd\u3002]"}, {"question": "\u738b\u56fd\u62fc\u56fe\u6e38\u620f\u4e2d\u54ea\u4e9b\u6e38\u620f\u8d44\u6e90\u6700\u6709\u4ef7\u503c\uff0c\u4ee5\u53ca\u5982\u4f55\u83b7\u5f97\u5b83\u4eec\uff1f", "answer": "\u738b\u56fd\u62fc\u56fe\u6e38\u620f\u4e2d\u6700\u6709\u4ef7\u503c\u7684\u8d44\u6e90\u662f\u91d1\u5e01\u548c\u9053\u5177\u3002\u91d1\u5e01\u53ef\u4ee5\u901a\u8fc7\u5b8c\u6210\u5173\u5361\u6216\u89c2\u770b\u5e7f\u544a\u83b7\u5f97\uff0c\u7528\u4e8e\u8d2d\u4e70\u63d0\u793a\u3002\u50cf\u201c\u9b54\u6cd5\u68d2\u201d\u8fd9\u6837\u7684\u9053\u5177\u53ef\u4ee5\u5728\u7279\u6b8a\u7684\u5b9d\u7bb1\u4e2d\u627e\u5230\uff0c\u6216\u8005\u7528\u91d1\u5e01\u8d2d\u4e70\u3002\u4f8b\u5982\uff0c\u5728\u201c\u9f99\u7a74\u201d\u5173\u5361\u4e2d\u4f7f\u7528\u201c\u9b54\u6cd5\u68d2\u201d\u53ef\u4ee5\u7acb\u5373\u89e3\u51b3\u56f0\u96be\u90e8\u5206\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u91d1\u5e01\u89c6\u4e3a\u8d27\u5e01\uff0c\u5c06\u9053\u5177\u89c6\u4e3a\u5de5\u5177\u7bb1\u4e2d\u7684\u5de5\u5177\u3002]"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684\u738b\u56fd\u62fc\u56fe\u6e38\u620f\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u8bbe\u5907\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u8bbe\u5907\uff1f", "answer": "\u8981\u8f6c\u79fb\u60a8\u7684\u738b\u56fd\u62fc\u56fe\u6e38\u620f\u8fdb\u5ea6\uff0c\u8bf7\u786e\u4fdd\u60a8\u5728\u4e24\u4e2a\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u5e10\u6237\u3002\u4f7f\u7528\u8bbe\u7f6e\u83dc\u5355\u4e2d\u7684\u4e91\u4fdd\u5b58\u529f\u80fd\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u4ece iPhone \u8f6c\u79fb\u5230 Android\uff0c\u8bf7\u5728\u65b0\u7684\u8bbe\u5907\u4e0a\u767b\u5f55\u60a8\u7684 Google Play \u6216 Apple ID \u5e76\u52a0\u8f7d\u60a8\u7684\u4fdd\u5b58\u6570\u636e\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u8bbe\u5907 A \u2192 \u4e91\u4fdd\u5b58 \u2192 \u8bbe\u5907 B\u3002]"}, {"question": "\u738b\u56fd\u62fc\u56fe\u6e38\u620f\u4e2d\u7684\u9690\u85cf\u5f69\u86cb\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5982\u4f55\u627e\u5230\u5b83\u4eec\uff1f", "answer": "\u738b\u56fd\u62fc\u56fe\u6e38\u620f\u5305\u542b\u9690\u85cf\u5f69\u86cb\uff0c\u4f8b\u5982\u9690\u85cf\u5173\u5361\u548c\u7a00\u6709\u9053\u5177\u3002\u4f8b\u5982\uff0c\u5728\u201c\u795e\u79d8\u795e\u5e99\u201d\u5173\u5361\u4e2d\uff0c\u70b9\u51fb\u7279\u5b9a\u96d5\u50cf\u4e09\u6b21\u53ef\u4ee5\u89e3\u9501\u4e00\u4e2a\u9690\u85cf\u62fc\u56fe\u3002\u8fd9\u4e9b\u5f69\u86cb\u4e3a\u4e13\u6ce8\u7684\u73a9\u5bb6\u589e\u52a0\u4e86\u989d\u5916\u7684\u4e50\u8da3\u548c\u53d1\u73b0\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5bfb\u627e\u5f69\u86cb\u5c31\u50cf\u5728\u4e00\u4e2a\u5e7f\u9614\u7684\u738b\u56fd\u4e2d\u53d1\u73b0\u57cb\u85cf\u7684\u5b9d\u85cf\u3002]"}, {"question": "\u968f\u7740\u6e38\u620f\u8fdb\u5ea6\uff0c\u738b\u56fd\u62fc\u56fe\u6e38\u620f\u7684\u96be\u5ea6\u66f2\u7ebf\u5982\u4f55\u6f14\u53d8\uff1f", "answer": "\u738b\u56fd\u62fc\u56fe\u6e38\u620f\u7684\u96be\u5ea6\u4f1a\u9010\u6e10\u589e\u52a0\uff0c\u901a\u8fc7\u5f15\u5165\u66f4\u590d\u6742\u7684\u62fc\u56fe\u673a\u5236\u548c\u66f4\u5927\u7684\u788e\u7247\u6570\u91cf\u3002\u4f8b\u5982\uff0c\u65e9\u671f\u5173\u5361\u7684\u62fc\u56fe\u5305\u542b 20 \u5757\u788e\u7247\uff0c\u800c\u540e\u671f\u5173\u5361\uff0c\u4f8b\u5982\u201c\u6c34\u6676\u6d1e\u7a74\u201d\uff0c\u5219\u5305\u542b\u8d85\u8fc7 100 \u5757\u788e\u7247\u3002\u6e38\u620f\u8fd8\u4f1a\u5f15\u5165\u65b0\u7684\u6311\u6218\uff0c\u4f8b\u5982\u65cb\u8f6c\u788e\u7247\u548c\u9650\u65f6\u62fc\u56fe\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u65e9\u671f\u5173\u5361\u7b80\u5355\u6613\u61c2\uff0c\u800c\u9ad8\u7ea7\u5173\u5361\u5219\u9700\u8981\u5468\u5bc6\u7684\u89c4\u5212\u3002]"}, {"question": "\u79fb\u52a8\u7aef\u548c PC \u7aef\u7684\u738b\u56fd\u62fc\u56fe\u6e38\u620f\u6709\u4ec0\u4e48\u4e3b\u8981\u533a\u522b\uff1f", "answer": "\u79fb\u52a8\u7aef\u548c PC \u7aef\u7684\u738b\u56fd\u62fc\u56fe\u6e38\u620f\u7684\u4e3b\u8981\u533a\u522b\u5728\u4e8e\u63a7\u5236\u65b9\u6848\u548c\u663e\u793a\u9009\u9879\u3002\u79fb\u52a8\u7aef\u4f7f\u7528\u89e6\u6478\u63a7\u5236\uff0c\u800c PC \u7aef\u652f\u6301\u9f20\u6807\u548c\u952e\u76d8\u3002\u6b64\u5916\uff0cPC \u7aef\u63d0\u4f9b\u66f4\u9ad8\u7684\u5206\u8fa8\u7387\u56fe\u5f62\u3002\u4f8b\u5982\uff0c\u201c\u5927\u57ce\u5821\u201d\u5173\u5361\u5728 PC \u663e\u793a\u5668\u4e0a\u770b\u8d77\u6765\u66f4\u52a0\u8be6\u7ec6\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u79fb\u52a8\u7aef - \u89e6\u6478\u63a7\u5236\uff0cPC \u7aef - \u9f20\u6807/\u952e\u76d8\u63a7\u5236\u3002]"}, {"question": "\u5982\u4f55\u4f18\u5316\u8bbe\u5907\u6027\u80fd\u4ee5\u66f4\u597d\u5730\u73a9\u738b\u56fd\u62fc\u56fe\u6e38\u620f\uff1f", "answer": "\u8981\u4f18\u5316\u60a8\u7684\u8bbe\u5907\u4ee5\u66f4\u597d\u5730\u8fd0\u884c\u738b\u56fd\u62fc\u56fe\u6e38\u620f\uff0c\u8bf7\u786e\u4fdd\u5b83\u5177\u6709\u6700\u65b0\u7684\u64cd\u4f5c\u7cfb\u7edf\u548c\u8db3\u591f\u7684\u5b58\u50a8\u7a7a\u95f4\u3002\u5173\u95ed\u540e\u53f0\u5e94\u7528\u7a0b\u5e8f\u4ee5\u91ca\u653e RAM\u3002\u4f8b\u5982\uff0c\u5728 iPhone \u4e0a\uff0c\u5728\u542f\u52a8\u6e38\u620f\u4e4b\u524d\uff0c\u5148\u5c06\u4e0d\u4f7f\u7528\u7684\u5e94\u7528\u7a0b\u5e8f\u6ed1\u52a8\u5173\u95ed\u3002\u964d\u4f4e\u6e38\u620f\u9009\u9879\u83dc\u5355\u4e2d\u7684\u56fe\u5f62\u8bbe\u7f6e\u4e5f\u53ef\u4ee5\u63d0\u9ad8\u6027\u80fd\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u60a8\u7684\u8bbe\u5907\u60f3\u8c61\u6210\u4e00\u8f86\u6c7d\u8f66\uff1b\u5b9a\u671f\u7ef4\u62a4\u53ef\u4ee5\u786e\u4fdd\u5e73\u7a33\u7684\u9a7e\u9a76\u3002]"}, {"question": "\u5982\u4f55\u53c2\u4e0e\u738b\u56fd\u62fc\u56fe\u6e38\u620f\u793e\u533a\uff1f", "answer": "\u53ef\u4ee5\u901a\u8fc7\u52a0\u5165\u5b98\u65b9\u8bba\u575b\u3001\u53c2\u4e0e\u793e\u4ea4\u5a92\u4f53\u7fa4\u7ec4\u548c\u53c2\u52a0\u7ebf\u4e0b\u6d3b\u52a8\u6765\u53c2\u4e0e\u738b\u56fd\u62fc\u56fe\u6e38\u620f\u793e\u533a\u3002\u5206\u4eab\u60a8\u7684\u6210\u5c31\u548c\u7b56\u7565\uff1b\u4f8b\u5982\uff0c\u5728\u201c\u6d77\u76d7\u6e7e\u201d\u5173\u5361\u4e2d\u53d1\u5e03\u60a8\u5b8c\u6210\u5e76\u83b7\u5f97\u4e09\u661f\u7684\u622a\u56fe\u53ef\u4ee5\u6fc0\u52b1\u4ed6\u4eba\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u6210\u4e3a\u793e\u533a\u7684\u4e00\u5458\u5c31\u50cf\u52a0\u5165\u4e2d\u4e16\u7eaa\u738b\u56fd\u4e2d\u7684\u4e00\u4e2a\u516c\u4f1a\u3002]"}]
[{"question": "\u65b0\u624b\u5982\u4f55\u958b\u59cb\u73a9\u738b\u570b\u62fc\u5716\u904a\u6232\uff1f", "answer": "\u8981\u958b\u59cb\u73a9\u738b\u570b\u62fc\u5716\uff0c\u9996\u5148\u8acb\u5f9e\u60a8\u559c\u6b61\u7684\u61c9\u7528\u7a0b\u5f0f\u5546\u5e97\u4e0b\u8f09\u904a\u6232\u3002\u5b89\u88dd\u5f8c\uff0c\u555f\u52d5\u904a\u6232\u4e26\u6309\u7167\u87a2\u5e55\u4e0a\u7684\u6559\u5b78\u6b65\u9a5f\u64cd\u4f5c\u3002\u6559\u5b78\u5c07\u6307\u5c0e\u60a8\u5b8c\u6210\u57fa\u672c\u7684\u62fc\u5716\u904a\u6232\u6a5f\u5236\uff0c\u4f8b\u5982\u62d6\u52d5\u5716\u584a\u4f86\u89e3\u6c7a\u62fc\u5716\u3002\u4f8b\u5982\uff0c\u7b2c\u4e00\u95dc\u9700\u8981\u5c07\u5716\u584a\u5c0d\u9f4a\u91cd\u5efa\u57ce\u5821\u7246\u3002\u5982\u679c\u5361\u95dc\uff0c\u8acb\u8a18\u5f97\u9ede\u64ca\u300c\u63d0\u793a\u300d\u6309\u9215\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u6559\u5b78\u8996\u70ba\u5f15\u5c0e\u60a8\u9032\u5165\u65b0\u57ce\u5e02\u7684\u8def\u7dda\u5716\u3002]"}, {"question": "\u5982\u4f55\u624d\u80fd\u5728\u738b\u570b\u62fc\u5716\u4e2d\u89e3\u6c7a\u9ad8\u7d1a\u62fc\u5716\uff1f", "answer": "\u91dd\u5c0d\u738b\u570b\u62fc\u5716\u7684\u9ad8\u7d1a\u62fc\u5716\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9a5f\u4e00\uff1a\u5728\u79fb\u52d5\u4e4b\u524d\u5148\u5206\u6790\u62fc\u5716\u4f48\u5c40\u3002\u6b65\u9a5f\u4e8c\uff1a\u5148\u627e\u5230\u908a\u7de3\u5716\u584a\uff0c\u56e0\u70ba\u5b83\u5011\u66f4\u5bb9\u6613\u653e\u7f6e\u3002\u6b65\u9a5f\u4e09\uff1a\u5c07\u984f\u8272\u6216\u5716\u6848\u76f8\u4f3c\u7684\u5716\u584a\u5206\u7d44\u5728\u4e00\u8d77\uff0c\u4ee5\u964d\u4f4e\u8907\u96dc\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u300c\u5922\u5e7b\u68ee\u6797\u300d\u95dc\u5361\u4e2d\uff0c\u5148\u5c07\u7da0\u8272\u6a39\u8449\u5716\u584a\u5206\u7d44\uff0c\u53ef\u4ee5\u7c21\u5316\u62fc\u5716\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u8207\u521d\u5b78\u8005\u96a8\u6a5f\u653e\u7f6e\u5716\u584a\u4e0d\u540c\uff0c\u9ad8\u7d1a\u73a9\u5bb6\u6703\u7b56\u7565\u6027\u5730\u898f\u5283\u4ed6\u5011\u7684\u79fb\u52d5\u3002]"}, {"question": "\u738b\u570b\u62fc\u5716\u70ba\u4f55\u4f7f\u7528\u661f\u7d1a\u8a55\u5206\u7cfb\u7d71\u4f86\u8a55\u4f30\u5b8c\u6210\u7684\u95dc\u5361\uff1f", "answer": "\u738b\u570b\u62fc\u5716\u4f7f\u7528\u661f\u7d1a\u8a55\u5206\u7cfb\u7d71\u4f86\u8a55\u4f30\u60a8\u5728\u6bcf\u500b\u95dc\u5361\u4e2d\u7684\u8868\u73fe\u3002\u6b64\u7cfb\u7d71\u6703\u8003\u616e\u4f7f\u7528\u79fb\u52d5\u6b21\u6578\u548c\u6240\u82b1\u6642\u9593\u3002\u4f8b\u5982\uff0c\u5728\u300c\u7687\u5bb6\u82b1\u5712\u300d\u95dc\u5361\u4e2d\uff0c\u4f7f\u7528\u5c11\u65bc 10 \u6b21\u79fb\u52d5\u5373\u53ef\u7372\u5f97\u4e09\u9846\u661f\u3002\u6b64\u7cfb\u7d71\u9f13\u52f5\u73a9\u5bb6\u6539\u9032\u7b56\u7565\u4e26\u91cd\u73a9\u95dc\u5361\u4ee5\u7372\u5f97\u66f4\u597d\u7684\u6210\u7e3e\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a1 \u661f \u2013 \u57fa\u672c\u5b8c\u6210\uff0c2 \u661f \u2013 \u9ad8\u6548\u79fb\u52d5\uff0c3 \u661f \u2013 \u512a\u79c0\u8868\u73fe\u3002]"}, {"question": "\u5728\u738b\u570b\u62fc\u5716\u4e2d\uff0c\u54ea\u4e9b\u904a\u6232\u8cc7\u6e90\u6700\u6709\u50f9\u503c\uff0c\u4ee5\u53ca\u5982\u4f55\u7372\u5f97\u5b83\u5011\uff1f", "answer": "\u738b\u570b\u62fc\u5716\u4e2d\u6700\u6709\u50f9\u503c\u7684\u8cc7\u6e90\u662f\u91d1\u5e63\u548c\u589e\u5f37\u9053\u5177\u3002\u73a9\u5bb6\u53ef\u4ee5\u900f\u904e\u5b8c\u6210\u95dc\u5361\u6216\u89c0\u770b\u5ee3\u544a\u4f86\u7372\u5f97\u91d1\u5e63\uff0c\u4e26\u7528\u65bc\u8cfc\u8cb7\u63d0\u793a\u3002\u589e\u5f37\u9053\u5177\uff0c\u4f8b\u5982\u300c\u9b54\u6756\u300d\uff0c\u53ef\u4ee5\u5728\u7279\u6b8a\u5bf6\u7bb1\u4e2d\u627e\u5230\u6216\u7528\u91d1\u5e63\u8cfc\u8cb7\u3002\u4f8b\u5982\uff0c\u5728\u300c\u9f8d\u7a74\u300d\u95dc\u5361\u4e2d\u4f7f\u7528\u300c\u9b54\u6756\u300d\u53ef\u4ee5\u7acb\u5373\u89e3\u6c7a\u96e3\u984c\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u91d1\u5e63\u8996\u70ba\u8ca8\u5e63\uff0c\u589e\u5f37\u9053\u5177\u8996\u70ba\u5de5\u5177\u7bb1\u4e2d\u7684\u5de5\u5177\u3002]"}, {"question": "\u5982\u4f55\u5c07\u738b\u570b\u62fc\u5716\u7684\u9032\u5ea6\u5f9e\u4e00\u500b\u88dd\u7f6e\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u88dd\u7f6e\uff1f", "answer": "\u8981\u5c07\u738b\u570b\u62fc\u5716\u7684\u9032\u5ea6\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u88dd\u7f6e\uff0c\u8acb\u78ba\u4fdd\u60a8\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u90fd\u767b\u5165\u4e86\u540c\u4e00\u500b\u5e33\u6236\u3002\u4f7f\u7528\u8a2d\u5b9a\u9078\u55ae\u4e2d\u7684\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u8981\u5f9e iPhone \u8f49\u63db\u5230 Android\uff0c\u8acb\u5728\u65b0\u88dd\u7f6e\u4e0a\u767b\u5165\u60a8\u7684 Google Play \u6216 Apple ID \u4e26\u8f09\u5165\u5132\u5b58\u7684\u8cc7\u6599\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u88dd\u7f6e A \u2192 \u96f2\u7aef\u5132\u5b58 \u2192 \u88dd\u7f6e B\u3002]"}, {"question": "\u738b\u570b\u62fc\u5716\u4e2d\u6709\u54ea\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\uff0c\u4ee5\u53ca\u5982\u4f55\u627e\u5230\u5b83\u5011\uff1f", "answer": "\u738b\u570b\u62fc\u5716\u5305\u542b\u96b1\u85cf\u5f69\u86cb\uff0c\u4f8b\u5982\u79d8\u5bc6\u95dc\u5361\u548c\u7a00\u6709\u589e\u5f37\u9053\u5177\u3002\u4f8b\u5982\uff0c\u5728\u300c\u795e\u79d8\u795e\u5edf\u300d\u95dc\u5361\u4e2d\uff0c\u9ede\u64ca\u7279\u5b9a\u96d5\u50cf\u4e09\u6b21\u5373\u53ef\u89e3\u9396\u96b1\u85cf\u62fc\u5716\u3002\u9019\u4e9b\u5f69\u86cb\u70ba\u71b1\u8877\u73a9\u5bb6\u589e\u52a0\u4e86\u984d\u5916\u7684\u6a02\u8da3\u548c\u767c\u73fe\u4e4b\u65c5\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c0b\u627e\u5f69\u86cb\u5c31\u50cf\u5728\u5ee3\u95ca\u738b\u570b\u4e2d\u63ed\u958b\u57cb\u85cf\u7684\u5bf6\u85cf\u3002]"}, {"question": "\u96a8\u8457\u904a\u6232\u9032\u5ea6\uff0c\u738b\u570b\u62fc\u5716\u7684\u96e3\u5ea6\u66f2\u7dda\u5982\u4f55\u6f14\u8b8a\uff1f", "answer": "\u738b\u570b\u62fc\u5716\u7684\u96e3\u5ea6\u6703\u9010\u6f38\u589e\u52a0\uff0c\u65b9\u6cd5\u662f\u5f15\u5165\u66f4\u8907\u96dc\u7684\u62fc\u5716\u6a5f\u5236\u548c\u66f4\u5927\u7684\u5716\u584a\u6578\u91cf\u3002\u4f8b\u5982\uff0c\u65e9\u671f\u95dc\u5361\u7684\u62fc\u5716\u5305\u542b 20 \u500b\u5716\u584a\uff0c\u800c\u5f8c\u671f\u7684\u95dc\u5361\uff0c\u4f8b\u5982\u300c\u6c34\u6676\u6d1e\u7a9f\u300d\uff0c\u5247\u5305\u542b\u8d85\u904e 100 \u500b\u5716\u584a\u3002\u904a\u6232\u9084\u5c07\u5f15\u5165\u65b0\u7684\u6311\u6230\uff0c\u4f8b\u5982\u65cb\u8f49\u5716\u584a\u548c\u9650\u6642\u62fc\u5716\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u65e9\u671f\u95dc\u5361\u7c21\u55ae\u6613\u61c2\uff0c\u800c\u9ad8\u7d1a\u95dc\u5361\u5247\u9700\u8981\u4ed4\u7d30\u898f\u5283\u3002]"}, {"question": "\u884c\u52d5\u88dd\u7f6e\u7248\u548c\u96fb\u8166\u7248\u738b\u570b\u62fc\u5716\u4e4b\u9593\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "\u884c\u52d5\u88dd\u7f6e\u7248\u548c\u96fb\u8166\u7248\u738b\u570b\u62fc\u5716\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u5728\u65bc\u64cd\u4f5c\u65b9\u5f0f\u548c\u986f\u793a\u9078\u9805\u3002\u884c\u52d5\u88dd\u7f6e\u7248\u4f7f\u7528\u89f8\u63a7\u64cd\u4f5c\uff0c\u800c\u96fb\u8166\u7248\u652f\u63f4\u6ed1\u9f20\u548c\u9375\u76e4\u3002\u6b64\u5916\uff0c\u96fb\u8166\u7248\u63d0\u4f9b\u66f4\u9ad8\u89e3\u6790\u5ea6\u7684\u5716\u5f62\u3002\u4f8b\u5982\uff0c\u300c\u5b8f\u5049\u57ce\u5821\u300d\u95dc\u5361\u5728\u96fb\u8166\u87a2\u5e55\u4e0a\u770b\u8d77\u4f86\u7d30\u7bc0\u66f4\u8c50\u5bcc\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u884c\u52d5\u88dd\u7f6e \u2013 \u89f8\u63a7\u64cd\u4f5c\uff0c\u96fb\u8166 \u2013 \u6ed1\u9f20/\u9375\u76e4\u64cd\u4f5c\u3002]"}, {"question": "\u5982\u4f55\u512a\u5316\u88dd\u7f6e\u6548\u80fd\u4ee5\u73a9\u738b\u570b\u62fc\u5716\uff1f", "answer": "\u8981\u512a\u5316\u88dd\u7f6e\u4ee5\u73a9\u738b\u570b\u62fc\u5716\uff0c\u8acb\u78ba\u4fdd\u5b83\u5df2\u66f4\u65b0\u81f3\u6700\u65b0\u4f5c\u696d\u7cfb\u7d71\u4e26\u6709\u8db3\u5920\u7684\u5132\u5b58\u7a7a\u9593\u3002\u95dc\u9589\u80cc\u666f\u61c9\u7528\u7a0b\u5f0f\u4ee5\u91cb\u653e\u8a18\u61b6\u9ad4\u3002\u4f8b\u5982\uff0c\u5728 iPhone \u4e0a\uff0c\u5728\u555f\u52d5\u904a\u6232\u4e4b\u524d\uff0c\u8acb\u5411\u4e0a\u6ed1\u52d5\u4ee5\u95dc\u9589\u672a\u4f7f\u7528\u7684\u61c9\u7528\u7a0b\u5f0f\u3002\u5728\u904a\u6232\u9078\u9805\u4e2d\u964d\u4f4e\u5716\u5f62\u8a2d\u5b9a\u4e5f\u53ef\u4ee5\u63d0\u9ad8\u6548\u80fd\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u60a8\u7684\u88dd\u7f6e\u8996\u70ba\u6c7d\u8eca\uff1b\u5b9a\u671f\u4fdd\u990a\u53ef\u78ba\u4fdd\u9806\u66a2\u7684\u904a\u6232\u9ad4\u9a57\u3002]"}, {"question": "\u5982\u4f55\u8207\u738b\u570b\u62fc\u5716\u793e\u7fa4\u4e92\u52d5\uff1f", "answer": "\u900f\u904e\u52a0\u5165\u5b98\u65b9\u8ad6\u58c7\u3001\u53c3\u8207\u793e\u7fa4\u5a92\u9ad4\u7fa4\u7d44\u548c\u53c3\u52a0\u73fe\u5834\u6d3b\u52d5\uff0c\u60a8\u53ef\u4ee5\u8207\u738b\u570b\u62fc\u5716\u793e\u7fa4\u4e92\u52d5\u3002\u5206\u4eab\u60a8\u7684\u6210\u5c31\u548c\u7b56\u7565\uff1b\u4f8b\u5982\uff0c\u5728\u300c\u6d77\u76dc\u7063\u300d\u95dc\u5361\u4e2d\uff0c\u5f35\u8cbc\u60a8\u5b8c\u6210\u4e09\u9846\u661f\u7684\u622a\u5716\u53ef\u4ee5\u555f\u767c\u5176\u4ed6\u4eba\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u6210\u70ba\u793e\u7fa4\u4e00\u54e1\u5c31\u50cf\u662f\u52a0\u5165\u4e2d\u4e16\u7d00\u738b\u570b\u7684\u516c\u6703\u3002]"}]
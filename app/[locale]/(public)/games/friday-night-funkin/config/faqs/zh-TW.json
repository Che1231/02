[{"question": "\u5982\u4f55\u958b\u59cb\u4f7f\u7528Friday Night Funkin\u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u958b\u59cb\u4f7f\u7528Friday Night Funkin\uff0c\u60a8\u9700\u8981\u719f\u6089\u57fa\u672c\u63a7\u5236\u3002\u904a\u6232\u4f7f\u7528\u65b9\u5411\u9375\uff08\u5de6\u3001\u4e0b\u3001\u4e0a\u3001\u53f3\uff09\u4f86\u5c0d\u61c9\u87a2\u5e55\u4e0a\u51fa\u73fe\u7684\u97f3\u7b26\u3002\u7576\u97f3\u7b26\u5230\u9054\u9802\u90e8\u7684\u7bad\u982d\u6642\uff0c\u8acb\u6309\u4e0b\u5c0d\u61c9\u7684\u9375\u4f86\u64ca\u6253\u97f3\u7b26\u3002\u4f8b\u5982\uff0c\u5982\u679c\u97f3\u7b26\u51fa\u73fe\u5728\u5de6\u7bad\u982d\u4e0a\uff0c\u8acb\u6309\u4e0b\u5de6\u65b9\u5411\u9375\u3002\u5728\u6559\u5b78\u6216\u524d\u5e7e\u500b\u95dc\u5361\u7df4\u7fd2\uff0c\u5c31\u80fd\u638c\u63e1\u7bc0\u594f\u3002\u8a18\u4f4f\uff0c\u6e96\u78ba\u6027\u662f\u904a\u6232\u9032\u6b65\u7684\u95dc\u9375\u3002"}, {"question": "\u6539\u9032Friday Night Funkin\u5206\u6578\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u63d0\u9ad8Friday Night Funkin\u5206\u6578\u9700\u8981\u7d50\u5408\u7bc0\u594f\u3001\u6e96\u78ba\u6027\u548c\u7df4\u7fd2\u3002\u4ee5\u4e0b\u662f\u4e00\u4e9b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u5c08\u6ce8\u65bc\u5b8c\u7f8e\u9ede\u64ca\u97f3\u7b26\uff0c\u56e0\u70ba\u9019\u6703\u7d66\u60a8\u6700\u9ad8\u7684\u5f97\u5206\u500d\u6578\u3002\u6b65\u9a5f2 - \u5728\u81ea\u7531\u904a\u6232\u6a21\u5f0f\u4e2d\u7df4\u7fd2\uff0c\u4ee5\u719f\u6089\u6b4c\u66f2\u6a21\u5f0f\u3002\u6b65\u9a5f3 - \u4f7f\u7528\u7df4\u7fd2\u6a21\u5f0f\u4f86\u6e1b\u6162\u56f0\u96e3\u90e8\u5206\u7684\u7bc0\u594f\uff0c\u4e26\u638c\u63e1\u5b83\u5011\u3002\u4f8b\u5982\uff0c\u5728\u6b4c\u66f2\u300cDad Battle\u300d\u4e2d\uff0c\u5feb\u901f\u7bc0\u594f\u90e8\u5206\u53ef\u80fd\u5177\u6709\u6311\u6230\u6027\uff0c\u56e0\u6b64\u653e\u6162\u901f\u5ea6\u53ef\u4ee5\u5e6b\u52a9\u60a8\u6539\u9032\u3002\u6b64\u5916\uff0c\u4fdd\u6301\u653e\u9b06\u548c\u7a69\u5b9a\u7684\u7bc0\u594f\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u60a8\u7684\u8868\u73fe\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u7684\u89d2\u8272\u6709\u6642\u6703\u5728Friday Night Funkin\u4e2d\u932f\u904e\u97f3\u7b26\uff0c\u4ee5\u53ca\u5982\u4f55\u4fee\u6b63\u5b83\uff1f", "answer": "\u5728Friday Night Funkin\u4e2d\u932f\u904e\u97f3\u7b26\u53ef\u80fd\u6709\u5e7e\u500b\u539f\u56e0\uff0c\u4f8b\u5982\u7bc0\u594f\u4e0d\u6b63\u78ba\u3001\u5ef6\u9072\u6216\u6309\u9375\u6309\u4e0b\u4e0d\u6b63\u78ba\u3002\u8981\u89e3\u6c7a\u6b64\u554f\u984c\uff0c\u8acb\u78ba\u4fdd\u60a8\u7684\u9375\u76e4\u53cd\u61c9\u9748\u654f\uff0c\u6c92\u6709\u4efb\u4f55\u8f38\u5165\u5ef6\u9072\u3002\u5982\u679c\u9700\u8981\uff0c\u8acb\u8abf\u6574\u904a\u6232\u8a2d\u5b9a\u4ee5\u964d\u4f4e\u5716\u5f62\u54c1\u8cea\uff0c\u5f9e\u800c\u6e1b\u5c11\u5ef6\u9072\u3002\u900f\u904e\u6f14\u594f\u8f03\u7c21\u55ae\u7684\u6b4c\u66f2\u7df4\u7fd2\u60a8\u7684\u7bc0\u594f\uff0c\u4e26\u9010\u6b65\u904e\u6e21\u5230\u66f4\u8907\u96dc\u7684\u6b4c\u66f2\u3002\u4f8b\u5982\uff0c\u5728\u6b4c\u66f2\u300c\u6559\u5b78\u300d\u4e2d\uff0c\u8acb\u5728\u5617\u8a66\u66f4\u96e3\u7684\u95dc\u5361\u4e4b\u524d\u5c08\u6ce8\u65bc\u5b8c\u7f8e\u64ca\u6253\u6bcf\u500b\u97f3\u7b26\u3002\u6301\u7e8c\u7684\u7df4\u7fd2\u5c07\u6709\u52a9\u65bc\u63d0\u9ad8\u6e96\u78ba\u6027\u3002"}, {"question": "\u5982\u4f55\u5728Friday Night Funkin\u4e2d\u89e3\u9396\u96b1\u85cf\u89d2\u8272\uff1f", "answer": "\u5728Friday Night Funkin\u4e2d\u89e3\u9396\u96b1\u85cf\u89d2\u8272\u901a\u5e38\u9700\u8981\u5b8c\u6210\u7279\u5b9a\u7684\u6311\u6230\u6216\u627e\u5230\u79d8\u5bc6\u8def\u5f91\u3002\u4f8b\u5982\uff0c\u8981\u89e3\u9396\u89d2\u8272\u300cSkid and Pump\u300d\uff0c\u60a8\u9700\u8981\u5728\u300cSpookeez\u300d\u6b4c\u66f2\u7684\u56f0\u96e3\u6a21\u5f0f\u4e0b\u5b8c\u6210\u3002\u4e00\u4e9b\u89d2\u8272\u4e5f\u51fa\u73fe\u5728\u6a21\u7d44\u4e2d\uff0c\u53ef\u4ee5\u4e0b\u8f09\u4e26\u6dfb\u52a0\u5230\u904a\u6232\u4e2d\u3002\u63a2\u7d22\u4e0d\u540c\u7684\u6a21\u7d44\u548c\u793e\u7fa4\u5167\u5bb9\uff0c\u4ee5\u767c\u73fe\u66f4\u591a\u96b1\u85cf\u7684\u89d2\u8272\u3002\u8acb\u52d9\u5fc5\u5f9e\u4fe1\u8b7d\u826f\u597d\u7684\u4f86\u6e90\u4e0b\u8f09\u6a21\u7d44\uff0c\u4ee5\u907f\u514d\u4efb\u4f55\u554f\u984c\u3002"}, {"question": "Friday Night Funkin\u7684\u5065\u5eb7\u689d\u6709\u4ec0\u9ebc\u610f\u7fa9\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u5f71\u97ff\u904a\u6232\uff1f", "answer": "Friday Night Funkin\u4e2d\u7684\u5065\u5eb7\u689d\u4ee3\u8868\u60a8\u5728\u6b4c\u66f2\u4e2d\u7684\u8868\u73fe\u3002\u7576\u60a8\u932f\u904e\u97f3\u7b26\u6642\uff0c\u5b83\u6703\u6e1b\u5c11\uff1b\u7576\u60a8\u6e96\u78ba\u5730\u64ca\u4e2d\u97f3\u7b26\u6642\uff0c\u5b83\u6703\u589e\u52a0\u3002\u5982\u679c\u5065\u5eb7\u689d\u5b8c\u5168\u8017\u76e1\uff0c\u60a8\u5c07\u8f38\u6389\u9019\u8f2a\u6bd4\u8cfd\u3002\u70ba\u4e86\u7dad\u6301\u5065\u5eb7\u689d\uff0c\u8acb\u5c08\u6ce8\u65bc\u6e96\u78ba\u9ede\u64ca\u97f3\u7b26\u4e26\u907f\u514d\u932f\u904e\u3002\u4f8b\u5982\uff0c\u5728\u6b4c\u66f2\u300cPico\u300d\u4e2d\uff0c\u5feb\u901f\u97f3\u7b26\u5982\u679c\u6c92\u6709\u7cbe\u78ba\u64ca\u4e2d\uff0c\u6703\u8fc5\u901f\u8017\u76e1\u60a8\u7684\u5065\u5eb7\u689d\u3002\u5bc6\u5207\u95dc\u6ce8\u5065\u5eb7\u689d\u4e26\u76f8\u61c9\u5730\u8abf\u6574\u60a8\u7684\u904a\u6232\u98a8\u683c\u5c0d\u6210\u529f\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u96e3\u5ea6\u7b49\u7d1a\u5982\u4f55\u5f71\u97ffFriday Night Funkin\u7684\u904a\u6232\u73a9\u6cd5\uff1f", "answer": "Friday Night Funkin\u4e2d\u7684\u96e3\u5ea6\u7b49\u7d1a\u6703\u986f\u8457\u5f71\u97ff\u97f3\u7b26\u7684\u901f\u5ea6\u548c\u8907\u96dc\u6027\u3002\u5728\u7c21\u55ae\u6a21\u5f0f\u4e2d\uff0c\u97f3\u7b26\u51fa\u73fe\u8f03\u6162\u4e14\u983b\u7387\u8f03\u4f4e\uff0c\u975e\u5e38\u9069\u5408\u521d\u5b78\u8005\u3002\u666e\u901a\u6a21\u5f0f\u6703\u63d0\u9ad8\u97f3\u7b26\u7684\u901f\u5ea6\u548c\u6578\u91cf\uff0c\u800c\u56f0\u96e3\u6a21\u5f0f\u5247\u6703\u5f15\u5165\u901f\u5ea6\u66f4\u5feb\u4e14\u66f4\u8907\u96dc\u7684\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u5728\u6b4c\u66f2\u300cBopeebo\u300d\u4e2d\uff0c\u56f0\u96e3\u6a21\u5f0f\u5305\u542b\u5feb\u901f\u97f3\u7b26\u5e8f\u5217\uff0c\u9700\u8981\u5feb\u901f\u53cd\u61c9\u3002\u6839\u64da\u60a8\u7684\u6280\u80fd\u9078\u64c7\u5408\u9069\u7684\u96e3\u5ea6\u7b49\u7d1a\u53ef\u4ee5\u589e\u5f37\u60a8\u7684\u904a\u6232\u9ad4\u9a57\u4e26\u5e6b\u52a9\u60a8\u6539\u9032\u3002"}, {"question": "\u7df4\u7fd2\u548c\u638c\u63e1Friday Night Funkin\u4e2d\u56f0\u96e3\u6b4c\u66f2\u7684\u6700\u4f73\u65b9\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "\u8981\u7cbe\u901aFriday Night Funkin\u4e2d\u7684\u56f0\u96e3\u6b4c\u66f2\uff0c\u9700\u8981\u6301\u7e8c\u7df4\u7fd2\u548c\u7b56\u7565\u65b9\u6cd5\u3002\u4ee5\u4e0b\u662f\u4e00\u4e9b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u4f7f\u7528\u7df4\u7fd2\u6a21\u5f0f\u4f86\u6e1b\u6162\u6b4c\u66f2\u901f\u5ea6\uff0c\u4e26\u5c08\u6ce8\u65bc\u5177\u6709\u6311\u6230\u6027\u7684\u90e8\u5206\u3002\u6b65\u9a5f2 - \u5c07\u6b4c\u66f2\u5206\u89e3\u6210\u8f03\u5c0f\u7684\u90e8\u5206\uff0c\u4e26\u53cd\u8986\u7df4\u7fd2\u6bcf\u500b\u90e8\u5206\u3002\u6b65\u9a5f3 - \u5728\u60a8\u66f4\u719f\u7df4\u5f8c\uff0c\u9010\u6b65\u63d0\u9ad8\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u6b4c\u66f2\u300cFresh\u300d\u4e2d\uff0c\u5feb\u901f\u7bc0\u594f\u90e8\u5206\u53ef\u80fd\u4ee4\u4eba\u4e0d\u77e5\u6240\u63aa\uff0c\u56e0\u6b64\u4e00\u958b\u59cb\u6e1b\u6162\u901f\u5ea6\u53ef\u4ee5\u5e6b\u52a9\u60a8\u638c\u63e1\u5b83\u5011\u3002\u898f\u5f8b\u7df4\u7fd2\u548c\u8010\u5fc3\u662f\u63d0\u9ad8\u6280\u80fd\u7684\u95dc\u9375\u3002"}, {"question": "\u5982\u4f55\u5728\u53e6\u4e00\u53f0\u88dd\u7f6e\u4e0a\u50b3\u8f38Friday Night Funkin\u7684\u9032\u5ea6\uff1f", "answer": "\u5c07Friday Night Funkin\u7684\u9032\u5ea6\u50b3\u8f38\u5230\u53e6\u4e00\u53f0\u88dd\u7f6e\uff0c\u53ef\u4ee5\u901a\u904e\u8907\u88fd\u5132\u5b58\u6a94\u6848\u4f86\u5b8c\u6210\u3002\u5728\u60a8\u76ee\u524d\u88dd\u7f6e\u4e0a\u627e\u5230\u5132\u5b58\u6a94\u6848\uff0c\u5132\u5b58\u6a94\u6848\u901a\u5e38\u4f4d\u65bc\u904a\u6232\u5b89\u88dd\u76ee\u9304\u4e2d\u3002\u5c07\u9019\u4e9b\u6a94\u6848\u8907\u88fd\u5230\u65b0\u88dd\u7f6e\u4e0a\u7684\u76f8\u540c\u76ee\u9304\u4e2d\u3002\u78ba\u4fdd\u5169\u53f0\u88dd\u7f6e\u90fd\u64c1\u6709\u76f8\u540c\u7248\u672c\u7684\u904a\u6232\uff0c\u4ee5\u907f\u514d\u76f8\u5bb9\u6027\u554f\u984c\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u96fb\u8166\u4e0a\u5b8c\u6210\u4e86\u5e7e\u9996\u6b4c\u66f2\uff0c\u5c07\u5132\u5b58\u6a94\u6848\u8907\u88fd\u5230\u7b46\u8a18\u578b\u96fb\u8166\uff0c\u5c07\u5141\u8a31\u60a8\u5f9e\u4e0a\u6b21\u505c\u6b62\u7684\u4f4d\u7f6e\u7e7c\u7e8c\u3002\u5728\u8f49\u79fb\u5132\u5b58\u6a94\u6848\u4e4b\u524d\uff0c\u8acb\u52d9\u5fc5\u5099\u4efd\u5132\u5b58\u6a94\u6848\u3002"}, {"question": "Friday Night Funkin\u4e2d\u4e00\u4e9b\u6211\u53ef\u80fd\u932f\u904e\u7684\u96b1\u85cf\u5f69\u86cb\u662f\u4ec0\u9ebc\uff1f", "answer": "Friday Night Funkin\u4e2d\u5145\u6eff\u4e86\u96b1\u85cf\u7684\u5f69\u86cb\uff0c\u8c50\u5bcc\u4e86\u904a\u6232\u7684\u9b45\u529b\u3002\u4e00\u500b\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\uff0c\u900f\u904e\u5728\u6a19\u984c\u756b\u9762\u6309\u7279\u5b9a\u6309\u9375\uff0c\u5c31\u80fd\u89e3\u9396\u300c\u7b2c7\u9031\u300d\u7684\u79d8\u5bc6\u6b4c\u66f2\u3002\u53e6\u4e00\u500b\u5f69\u86cb\u662f\u96b1\u85cf\u89d2\u8272\u300cWhitty\u300d\uff0c\u53ef\u4ee5\u900f\u904e\u7279\u5b9a\u7684\u6a21\u7d44\u89e3\u9396\u3002\u63a2\u7d22\u793e\u7fa4\u8ad6\u58c7\u548c\u6a21\u7d44\u793e\u7fa4\u53ef\u4ee5\u63ed\u793a\u66f4\u591a\u96b1\u85cf\u5167\u5bb9\u3002\u4f8b\u5982\uff0c\u300cWhitty\u6a21\u7d44\u300d\u5f15\u5165\u4e86\u65b0\u7684\u89d2\u8272\u548c\u6b4c\u66f2\uff0c\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u65b0\u9bae\u7684\u9ad4\u9a57\u3002\u5bc6\u5207\u95dc\u6ce8\u66f4\u65b0\u548c\u793e\u7fa4\u767c\u73fe\uff0c\u4ee5\u5c0b\u627e\u66f4\u591a\u5f69\u86cb\u3002"}, {"question": "Friday Night Funkin\u7684\u5206\u6578\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u5b83\uff1f", "answer": "Friday Night Funkin\u7684\u5206\u6578\u7cfb\u7d71\u57fa\u65bc\u60a8\u9ede\u64ca\u97f3\u7b26\u7684\u6e96\u78ba\u6027\u548c\u7bc0\u594f\u3002\u5b8c\u7f8e\u9ede\u64ca\u97f3\u7b26\u6703\u63d0\u9ad8\u60a8\u7684\u5f97\u5206\u500d\u6578\uff0c\u800c\u932f\u904e\u97f3\u7b26\u6216\u9ede\u64ca\u4e0d\u6e96\u78ba\u5247\u6703\u964d\u4f4e\u5b83\u3002\u904a\u6232\u4e5f\u6703\u734e\u52f5\u9023\u7e8c\u9ede\u64ca\uff0c\u7a31\u70ba\u9023\u64ca\uff0c\u9019\u6703\u986f\u8457\u63d0\u5347\u60a8\u7684\u5206\u6578\u3002\u4f8b\u5982\uff0c\u5728\u6b4c\u66f2\u300cMilf\u300d\u4e2d\uff0c\u4fdd\u6301\u9ad8\u9023\u64ca\u7387\u4e26\u5b8c\u7f8e\u9ede\u64ca\u97f3\u7b26\uff0c\u8207\u4e0d\u9023\u8cab\u7684\u9ede\u64ca\u76f8\u6bd4\uff0c\u53ef\u4ee5\u7372\u5f97\u66f4\u9ad8\u7684\u5206\u6578\u3002\u77ad\u89e3\u5206\u6578\u7cfb\u7d71\u4e26\u5c08\u6ce8\u65bc\u6e96\u78ba\u6027\u548c\u9023\u64ca\u53ef\u4ee5\u5e6b\u52a9\u60a8\u5728\u904a\u6232\u4e2d\u7372\u5f97\u66f4\u9ad8\u7684\u5206\u6578\u3002"}]
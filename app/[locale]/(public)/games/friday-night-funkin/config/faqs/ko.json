[{"question": "Friday Night Funkin\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Friday Night Funkin\uc744 \uc2dc\uc791\ud558\ub824\uba74 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc5d0 \uc775\uc219\ud574\uc838\uc57c \ud569\ub2c8\ub2e4. \uc774 \uac8c\uc784\uc740 \ud654\uba74\uc5d0 \ub098\ud0c0\ub098\ub294 \uc74c\ud45c\uc640 \uc77c\uce58\ud558\ub294 \ubc29\ud5a5\ud0a4(\uc67c\ucabd, \uc544\ub798\ucabd, \uc704\ucabd, \uc624\ub978\ucabd)\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \uc74c\ud45c\uac00 \ud654\uba74 \uc0c1\ub2e8\uc758 \ud654\uc0b4\ud45c\uc5d0 \ub3c4\ub2ec\ud558\uba74 \ud574\ub2f9 \ud0a4\ub97c \ub20c\ub7ec \uc74c\ud45c\ub97c \ub9de\ucdb0\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc67c\ucabd \ud654\uc0b4\ud45c\uc5d0 \uc74c\ud45c\uac00 \ub098\ud0c0\ub098\uba74 \uc67c\ucabd \ud654\uc0b4\ud45c \ud0a4\ub97c \ub204\ub974\uc138\uc694. \ud29c\ud1a0\ub9ac\uc5bc\uc774\ub098 \ucc98\uc74c \uba87 \uac1c\uc758 \ub808\ubca8\uc5d0\uc11c \uc5f0\uc2b5\ud558\uc5ec \ud0c0\uc774\ubc0d\uc5d0 \uc775\uc219\ud574\uc9c0\uc138\uc694. \uac8c\uc784\uc5d0\uc11c \uc9c4\ud589\ud558\ub824\uba74 \uc815\ud655\uc131\uc774 \uc911\uc694\ud569\ub2c8\ub2e4."}, {"question": "Friday Night Funkin\uc5d0\uc11c \uc810\uc218\ub97c \ub192\uc774\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Friday Night Funkin\uc5d0\uc11c \uc810\uc218\ub97c \ub192\uc774\ub824\uba74 \ud0c0\uc774\ubc0d, \uc815\ud655\uc131, \uc5f0\uc2b5\uc758 \uc870\ud569\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e4\uc74c \ub2e8\uacc4\ub97c \ud1b5\ud574 \ub3c4\uc6c0\uc744 \ubc1b\uc73c\uc138\uc694: 1\ub2e8\uacc4 - \ucd5c\uace0\uc758 \uc810\uc218 \ubc30\uc728\uc744 \uc5bb\uae30 \uc704\ud574 \uc74c\ud45c\ub97c \uc644\ubcbd\ud558\uac8c \ub9de\ucd94\ub294 \ub370 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. 2\ub2e8\uacc4 - \uc790\uc720 \ud50c\ub808\uc774 \ubaa8\ub4dc\uc5d0\uc11c \uc5f0\uc2b5\ud558\uc5ec \uace1 \ud328\ud134\uc5d0 \uc775\uc219\ud574\uc9c0\uc138\uc694. 3\ub2e8\uacc4 - \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc5b4\ub824\uc6b4 \ubd80\ubd84\uc758 \uc18d\ub3c4\ub97c \ub2a6\ucd94\uace0 \uc219\ub2ec\uc2dc\ud0a4\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \"Dad Battle\" \uace1\uc5d0\uc11c \ube60\ub978 \ubd80\ubd84\uc740 \uc5b4\ub824\uc6b8 \uc218 \uc788\uc73c\ubbc0\ub85c \uc774\ub97c \ub2a6\ucd94\uba74 \uac1c\uc120\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \ud3b8\uc548\ud558\uac8c \uc720\uc9c0\ud558\uace0 \uafb8\uc900\ud55c \ub9ac\ub4ec\uc744 \uc720\uc9c0\ud558\uba74 \uc131\ub2a5\uc774 \ud06c\uac8c \ud5a5\uc0c1\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Friday Night Funkin\uc5d0\uc11c \uce90\ub9ad\ud130\uac00 \ub54c\ub54c\ub85c \uc74c\ud45c\ub97c \ub193\uce58\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud574\uacb0\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Friday Night Funkin\uc5d0\uc11c \uc74c\ud45c\ub97c \ub193\uce58\ub294 \uc774\uc720\ub294 \uc798\ubabb\ub41c \ud0c0\uc774\ubc0d, \ub799, \ub610\ub294 \ud0a4 \uc785\ub825 \uc624\ub958 \ub4f1 \uc5ec\ub7ec \uac00\uc9c0\uac00 \uc788\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\ub824\uba74 \ud0a4\ubcf4\ub4dc\uac00 \ubc18\uc751\uc801\uc774\uace0 \uc785\ub825 \uc9c0\uc5f0\uc774 \uc5c6\uc5b4\uc57c \ud569\ub2c8\ub2e4. \ud544\uc694\uc5d0 \ub530\ub77c \uac8c\uc784 \uc124\uc815\uc744 \uc870\uc815\ud558\uc5ec \uadf8\ub798\ud53d \ud488\uc9c8\uc744 \ub0ae\ucd94\uc5b4 \ub799\uc744 \uc904\uc774\uc138\uc694. \uc26c\uc6b4 \uace1\uc744 \uc5f0\uc8fc\ud558\uc5ec \ud0c0\uc774\ubc0d \uc5f0\uc2b5\uc744 \ud558\uace0 \uc810\ucc28 \ub354 \ubcf5\uc7a1\ud55c \uace1\uc73c\ub85c \ub118\uc5b4\uac00\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \"Tutorial\" \uace1\uc5d0\uc11c \ub354 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc744 \uc2dc\ub3c4\ud558\uae30 \uc804\uc5d0 \ubaa8\ub4e0 \uc74c\ud45c\ub97c \uc644\ubcbd\ud558\uac8c \ub9de\ucd94\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. \uafb8\uc900\ud55c \uc5f0\uc2b5\uc740 \uc815\ud655\uc131\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4."}, {"question": "Friday Night Funkin\uc5d0\uc11c \uc228\uaca8\uc9c4 \uce90\ub9ad\ud130\ub97c \uc5b4\ub5bb\uac8c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Friday Night Funkin\uc5d0\uc11c \uc228\uaca8\uc9c4 \uce90\ub9ad\ud130\ub97c \uc7a0\uae08 \ud574\uc81c\ud558\ub824\uba74 \ud2b9\uc815 \ucc4c\ub9b0\uc9c0\ub098 \ube44\ubc00 \uacbd\ub85c\ub97c \uc644\ub8cc\ud574\uc57c \ud558\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"Skid and Pump\" \uce90\ub9ad\ud130\ub97c \uc7a0\uae08 \ud574\uc81c\ud558\ub824\uba74 \"Spookeez\" \uace1\uc744 \ud558\ub4dc \ubaa8\ub4dc\ub85c \uc644\ub8cc\ud574\uc57c \ud569\ub2c8\ub2e4. \uc77c\ubd80 \uce90\ub9ad\ud130\ub294 \ubaa8\ub4dc\uc5d0\uc11c\ub3c4 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc73c\uba70, \uc774\ub294 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc5ec \uac8c\uc784\uc5d0 \ucd94\uac00\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\ub978 \ubaa8\ub4dc\uc640 \ucee4\ubba4\ub2c8\ud2f0 \ucf58\ud150\uce20\ub97c \ud0d0\uc0c9\ud558\uc5ec \ub354 \ub9ce\uc740 \uc228\uaca8\uc9c4 \uce90\ub9ad\ud130\ub97c \ubc1c\uacac\ud558\uc138\uc694. \ud56d\uc0c1 \uc2e0\ub8b0\ud560 \uc218 \uc788\ub294 \ucd9c\ucc98\uc5d0\uc11c \ubaa8\ub4dc\ub97c \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc5ec \ubb38\uc81c\ub97c \ubc29\uc9c0\ud558\uc138\uc694."}, {"question": "Friday Night Funkin\uc5d0\uc11c \uccb4\ub825 \ubc14\uc758 \uc758\ubbf8\ub294 \ubb34\uc5c7\uc774\uba70, \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "Friday Night Funkin\uc5d0\uc11c \uccb4\ub825 \ubc14\ub294 \uace1\uc744 \uc5f0\uc8fc\ud558\ub294 \ub3d9\uc548\uc758 \uc131\ub2a5\uc744 \ub098\ud0c0\ub0c5\ub2c8\ub2e4. \uc74c\ud45c\ub97c \ub193\uce58\uba74 \uccb4\ub825 \ubc14\uac00 \uc904\uc5b4\ub4e4\uace0 \uc815\ud655\ud558\uac8c \ub9de\ucd94\uba74 \ub298\uc5b4\ub0a9\ub2c8\ub2e4. \uccb4\ub825 \ubc14\uac00 \uc644\uc804\ud788 \uc18c\ubaa8\ub418\uba74 \ub77c\uc6b4\ub4dc\ub97c \uc783\uc2b5\ub2c8\ub2e4. \uccb4\ub825 \ubc14\ub97c \uc720\uc9c0\ud558\ub824\uba74 \uc815\ud655\uc131\uc744 \uc720\uc9c0\ud558\uace0 \uc2e4\uc218\ub97c \ud53c\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"Pico\" \uace1\uc5d0\uc11c \ube60\ub978 \uc74c\ud45c\uac00 \uc815\ud655\ud558\uac8c \ub9de\ucd94\uc9c0 \ubabb\ud558\uba74 \uccb4\ub825\uc774 \ube60\ub974\uac8c \uc904\uc5b4\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uccb4\ub825 \ubc14\uc5d0 \uc8fc\uc758\ud558\uace0 \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub530\ub77c \uc870\uc815\ud558\ub294 \uac83\uc774 \uc131\uacf5\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4."}, {"question": "Friday Night Funkin\uc5d0\uc11c \ub09c\uc774\ub3c4 \ub808\ubca8\uc740 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "Friday Night Funkin\uc5d0\uc11c \ub09c\uc774\ub3c4 \ub808\ubca8\uc740 \uc74c\ud45c\uc758 \uc18d\ub3c4\uc640 \ubcf5\uc7a1\uc131\uc5d0 \uc0c1\ub2f9\ud55c \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc774\uc9c0 \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uc74c\ud45c\uac00 \ub290\ub9ac\uace0 \ube48\ub3c4\uac00 \uc801\uae30 \ub54c\ubb38\uc5d0 \ucd08\ubcf4\uc790\uc5d0\uac8c \uc801\ud569\ud569\ub2c8\ub2e4. \ub178\uba40 \ubaa8\ub4dc\ub294 \uc18d\ub3c4\uc640 \uc74c\ud45c \uc218\uac00 \uc99d\uac00\ud558\uace0, \ud558\ub4dc \ubaa8\ub4dc\ub294 \ub354 \ube60\ub974\uace0 \ubcf5\uc7a1\ud55c \ud328\ud134\uc744 \ub3c4\uc785\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"Bopeebo\" \uace1\uc5d0\uc11c \ud558\ub4dc \ubaa8\ub4dc\ub294 \ube60\ub978 \ubc18\uc751 \uc18d\ub3c4\uac00 \ud544\uc694\ud55c \ube60\ub978 \uc74c\ud45c \uc2dc\ud000\uc2a4\ub97c \ud3ec\ud568\ud569\ub2c8\ub2e4. \uc790\uc2e0\uc758 \uae30\uc220\uc5d0 \ub530\ub77c \uc801\uc808\ud55c \ub09c\uc774\ub3c4 \ub808\ubca8\uc744 \uc120\ud0dd\ud558\uba74 \uac8c\uc784 \uacbd\ud5d8\uc744 \ub192\uc774\uace0 \ud5a5\uc0c1\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Friday Night Funkin\uc5d0\uc11c \uc5b4\ub824\uc6b4 \uace1\uc744 \uc5f0\uc2b5\ud558\uace0 \uc219\ub2ec\ud558\ub294 \ucd5c\uace0\uc758 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Friday Night Funkin\uc5d0\uc11c \uc5b4\ub824\uc6b4 \uace1\uc744 \uc219\ub2ec\ud558\ub824\uba74 \uc9c0\uc18d\uc801\uc778 \uc5f0\uc2b5\uacfc \uc804\ub7b5\uc801\uc778 \uc811\uadfc\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e4\uc74c\uc740 \uba87 \uac00\uc9c0 \ub2e8\uacc4\uc785\ub2c8\ub2e4: 1\ub2e8\uacc4 - \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \uace1\uc758 \uc18d\ub3c4\ub97c \ub2a6\ucd94\uace0 \uc5b4\ub824\uc6b4 \ubd80\ubd84\uc5d0 \uc9d1\uc911\ud558\uc138\uc694. 2\ub2e8\uacc4 - \uace1\uc744 \uc791\uc740 \ubd80\ubd84\uc73c\ub85c \ub098\ub204\uace0 \uac01 \ubd80\ubd84\uc744 \ubc18\ubcf5\uc801\uc73c\ub85c \uc5f0\uc2b5\ud558\uc138\uc694. 3\ub2e8\uacc4 - \uc775\uc219\ud574\uc9c8\uc218\ub85d \uc810\uc9c4\uc801\uc73c\ub85c \uc18d\ub3c4\ub97c \ub192\uc774\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \"Fresh\" \uace1\uc5d0\uc11c \ube60\ub978 \ubd80\ubd84\uc740 \uc555\ub3c4\uc801\uc77c \uc218 \uc788\uc73c\ubbc0\ub85c \ucc98\uc74c\uc5d0\ub294 \uc18d\ub3c4\ub97c \ub2a6\ucd94\uba74 \uc219\ub2ec\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc815\uae30\uc801\uc778 \uc5f0\uc2b5\uacfc \uc778\ub0b4\uc2ec\uc740 \uae30\uc220 \ud5a5\uc0c1\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4."}, {"question": "Friday Night Funkin\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694?", "answer": "Friday Night Funkin\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30\ub85c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub824\uba74 \uc800\uc7a5 \ud30c\uc77c\uc744 \ubcf5\uc0ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud604\uc7ac \uae30\uae30\uc5d0\uc11c \uc800\uc7a5 \ud30c\uc77c\uc744 \ucc3e\uc73c\uc138\uc694. \uc77c\ubc18\uc801\uc73c\ub85c \uac8c\uc784 \uc124\uce58 \ub514\ub809\ud1a0\ub9ac\uc5d0 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \ud30c\uc77c\ub4e4\uc744 \uc0c8 \uae30\uae30\uc758 \ub3d9\uc77c\ud55c \ub514\ub809\ud1a0\ub9ac\uc5d0 \ubcf5\uc0ac\ud558\uc138\uc694. \ud638\ud658\uc131 \ubb38\uc81c\ub97c \ud53c\ud558\uae30 \uc704\ud574 \ub450 \uae30\uae30\uac00 \ub3d9\uc77c\ud55c \uac8c\uc784 \ubc84\uc804\uc778\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \uc5ec\ub7ec \uace1\uc744 \uc644\ub8cc\ud588\ub2e4\uba74 \uc800\uc7a5 \ud30c\uc77c\uc744 \ub178\ud2b8\ubd81\uc73c\ub85c \ubcf5\uc0ac\ud558\uc5ec \uc911\ub2e8\ud588\ub358 \uacf3\uc5d0\uc11c \uacc4\uc18d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc800\uc7a5 \ud30c\uc77c\uc744 \uc804\uc1a1\ud558\uae30 \uc804\uc5d0 \ud56d\uc0c1 \ubc31\uc5c5\ud558\uc138\uc694."}, {"question": "Friday Night Funkin\uc5d0\uc11c \ub193\uce60 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uba87 \uac00\uc9c0 \uc788\ub098\uc694?", "answer": "Friday Night Funkin\uc5d0\ub294 \uac8c\uc784\uc758 \ub9e4\ub825\uc744 \ub354\ud558\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uac00\ub4dd\ud569\ub2c8\ub2e4. \uc8fc\ubaa9\ud560\ub9cc\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ud0c0\uc774\ud2c0 \ud654\uba74\uc5d0\uc11c \ud2b9\uc815 \ud0a4\ub97c \ub204\ub974\uba74 \"Week 7\" \ube44\ubc00 \uace1\uc744 \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\ub2e4\ub294 \uac83\uc785\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ud2b9\uc815 \ubaa8\ub4dc\ub97c \ud1b5\ud574 \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uce90\ub9ad\ud130 \"Whitty\"\uc785\ub2c8\ub2e4. \ucee4\ubba4\ub2c8\ud2f0 \ud3ec\ub7fc\uacfc \ubaa8\ub529 \ucee4\ubba4\ub2c8\ud2f0\ub97c \ud0d0\uc0c9\ud558\uba74 \ub354 \ub9ce\uc740 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"Whitty Mod\"\ub294 \uc0c8\ub85c\uc6b4 \uce90\ub9ad\ud130\uc640 \uace1\uc744 \uc18c\uac1c\ud558\uc5ec \uac8c\uc784\uc5d0 \uc0c8\ub85c\uc6b4 \uacbd\ud5d8\uc744 \ub354\ud569\ub2c8\ub2e4. \uc5c5\ub370\uc774\ud2b8 \ubc0f \ucee4\ubba4\ub2c8\ud2f0 \ubc1c\uacac\uc5d0 \uc8fc\uc758\ud558\uba74 \ub354 \ub9ce\uc740 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "Friday Night Funkin\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uc5b4\ub5a4 \uc694\uc778\uc774 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "Friday Night Funkin\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc74c\ud45c\ub97c \ub9de\ud788\ub294 \uc815\ud655\uc131\uacfc \ud0c0\uc774\ubc0d\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uc74c\ud45c\ub97c \uc644\ubcbd\ud558\uac8c \ub9de\ucd94\uba74 \uc810\uc218 \ubc30\uc728\uc774 \uc99d\uac00\ud558\uace0, \uc74c\ud45c\ub97c \ub193\uce58\uac70\ub098 \ubd80\uc815\ud655\ud558\uac8c \ub9de\ucd94\uba74 \uac10\uc18c\ud569\ub2c8\ub2e4. \uac8c\uc784\uc740 \ub610\ud55c \uc5f0\uc18d\uc801\uc778 \ub9de\ucda4, \uc989 \ucf64\ubcf4\ub97c \ubcf4\uc0c1\ud558\uc5ec \uc810\uc218\ub97c \ud06c\uac8c \ub192\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"Milf\" \uace1\uc5d0\uc11c \ub192\uc740 \ucf64\ubcf4\ub97c \uc720\uc9c0\ud558\uace0 \uc74c\ud45c\ub97c \uc644\ubcbd\ud558\uac8c \ub9de\ud788\uba74 \uc77c\uad00\uc131 \uc5c6\ub294 \ub9de\ucda4\uc5d0 \ube44\ud574 \uc810\uc218\uac00 \ud6e8\uc52c \ub192\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc810\uc218 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\uace0 \uc815\ud655\uc131\uacfc \ucf64\ubcf4\uc5d0 \uc9d1\uc911\ud558\uba74 \uac8c\uc784\uc5d0\uc11c \ub354 \ub192\uc740 \uc810\uc218\ub97c \ub2ec\uc131\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
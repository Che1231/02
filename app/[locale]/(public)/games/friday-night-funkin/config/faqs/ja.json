1\u30e2\u30c3\u30c9\u3067\u3082\u5165\u624b\u53ef\u80fd\u3067\u3059\u3002\u30b2\u30fc\u30e0\u306b\u8ffd\u52a0\u3067\u304d\u308b\u30e2\u30c3\u30c9\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3067\u304d\u307e\u3059\u3002\u3055\u307e\u3056\u307e\u306a\u30e2\u30c3\u30c9\u3068\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u63a2\u6c42\u3057\u3066\u3001\u3088\u308a\u591a\u304f\u306e\u96a0\u308c\u305f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u898b\u3064\u3051\u3066\u304f\u3060\u3055\u3044\u3002\u5e38\u306b\u4fe1\u983c\u3067\u304d\u308b\u30bd\u30fc\u30b9\u304b\u3089\u30e2\u30c3\u30c9\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3059\u308b\u3088\u3046\u306b\u3057\u3001\u554f\u984c\u3092\u56de\u907f\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "Friday Night Funkin\u306e\u30d8\u30eb\u30b9\u30d0\u30fc\u306f\u3001\u3069\u306e\u3088\u3046\u306a\u610f\u5473\u304c\u3042\u308a\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "Friday Night Funkin\u306e\u30d8\u30eb\u30b9\u30d0\u30fc\u306f\u3001\u697d\u66f2\u4e2d\u306b\u3042\u306a\u305f\u306e\u6f14\u594f\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u8868\u3057\u3066\u3044\u307e\u3059\u3002\u97f3\u7b26\u3092\u5916\u3059\u3068\u6e1b\u5c11\u3057\u307e\u3059\u3057\u3001\u6b63\u78ba\u306b\u30d2\u30c3\u30c8\u3059\u308b\u3068\u5897\u52a0\u3057\u307e\u3059\u3002\u3082\u3057\u30d8\u30eb\u30b9\u30d0\u30fc\u304c\u5b8c\u5168\u306b\u6d88\u8cbb\u3055\u308c\u308b\u3068\u3001\u305d\u306e\u30e9\u30a6\u30f3\u30c9\u306f\u5931\u308f\u308c\u307e\u3059\u3002\u30d8\u30eb\u30b9\u30d0\u30fc\u3092\u7dad\u6301\u3059\u308b\u306b\u306f\u3001\u6b63\u78ba\u306b\u97f3\u7b26\u3092\u30d2\u30c3\u30c8\u3057\u3001\u30df\u30b9\u3092\u56de\u907f\u3059\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u307e\u3057\u3087\u3046\u3002\u300cPico\u300d\u306e\u66f2\u306f\u3001\u6b63\u78ba\u306b\u30d2\u30c3\u30c8\u3057\u306a\u3044\u3068\u3001\u6025\u901f\u306b\u30d8\u30eb\u30b9\u30d0\u30fc\u304c\u6e1b\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u30d8\u30eb\u30b9\u30d0\u30fc\u306b\u6ce8\u610f\u3057\u3001\u305d\u308c\u306b\u5fdc\u3058\u3066\u3042\u306a\u305f\u306e\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u3092\u8abf\u6574\u3059\u308b\u3053\u3068\u304c\u3001\u6210\u529f\u306e\u30ab\u30ae\u3067\u3059\u3002"}, {"question": "\u96e3\u6613\u5ea6\u30ec\u30d9\u30eb\u306f\u3001Friday Night Funkin\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "Friday Night Funkin\u306e\u96e3\u6613\u5ea6\u30ec\u30d9\u30eb\u306f\u3001\u97f3\u7b26\u306e\u901f\u5ea6\u3068\u8907\u96d1\u3055\u306b\u5927\u304d\u306a\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u30a4\u30fc\u30b8\u30fc\u30e2\u30fc\u30c9\u3067\u306f\u3001\u97f3\u7b26\u306f\u3086\u3063\u304f\u308a\u3068\u3001\u983b\u5ea6\u3082\u4f4e\u304f\u8868\u793a\u3055\u308c\u308b\u305f\u3081\u3001\u521d\u5fc3\u8005\u306b\u3068\u3063\u3066\u6700\u9069\u3067\u3059\u3002\u30ce\u30fc\u30de\u30eb\u30e2\u30fc\u30c9\u3067\u306f\u3001\u901f\u5ea6\u3068\u97f3\u7b26\u306e\u6570\u304c\u4e0a\u6607\u3057\u307e\u3059\u3002\u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\u3067\u306f\u3001\u3088\u308a\u901f\u304f\u3001\u3088\u308a\u8907\u96d1\u306a\u30d1\u30bf\u30fc\u30f3\u304c\u767b\u5834\u3057\u307e\u3059\u3002\u300cBopeebo\u300d\u306e\u66f2\u3067\u306f\u3001\u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\u3067\u306f\u7d20\u65e9\u3044\u53cd\u5c04\u795e\u7d4c\u304c\u5fc5\u8981\u3068\u306a\u308b\u3001\u9ad8\u901f\u306a\u97f3\u7b26\u306e\u9023\u7d9a\u304c\u767b\u5834\u3057\u307e\u3059\u3002\u3042\u306a\u305f\u306e\u30b9\u30ad\u30eb\u306b\u5fdc\u3058\u3066\u9069\u5207\u306a\u96e3\u6613\u5ea6\u30ec\u30d9\u30eb\u3092\u9078\u629e\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u4f53\u9a13\u304c\u5411\u4e0a\u3057\u3001\u30b9\u30ad\u30eb\u5411\u4e0a\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "Friday Night Funkin\u3067\u96e3\u3057\u3044\u66f2\u3092\u7df4\u7fd2\u3057\u3001\u30de\u30b9\u30bf\u30fc\u3059\u308b\u305f\u3081\u306e\u6700\u5584\u306e\u65b9\u6cd5\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Friday Night Funkin\u3067\u96e3\u3057\u3044\u66f2\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u7d99\u7d9a\u7684\u306a\u7df4\u7fd2\u3068\u6226\u7565\u7684\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u304c\u5fc5\u8981\u3067\u3059\u3002\u4ee5\u4e0b\u306b\u624b\u9806\u3092\u793a\u3057\u307e\u3059\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u7df4\u7fd2\u30e2\u30fc\u30c9\u3092\u4f7f\u7528\u3057\u3066\u3001\u66f2\u3092\u30b9\u30ed\u30fc\u30c0\u30a6\u30f3\u3057\u3001\u96e3\u3057\u3044\u30bb\u30af\u30b7\u30e7\u30f3\u306b\u96c6\u4e2d\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u66f2\u3092\u5c0f\u3055\u306a\u90e8\u5206\u306b\u5206\u5272\u3057\u3001\u5404\u90e8\u5206\u3092\u7e70\u308a\u8fd4\u3057\u7df4\u7fd2\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6163\u308c\u3066\u304d\u305f\u3089\u3001\u5f90\u3005\u306b\u901f\u5ea6\u3092\u4e0a\u3052\u3066\u3044\u304d\u307e\u3057\u3087\u3046\u3002\u300cFresh\u300d\u306a\u3069\u306e\u66f2\u3067\u306f\u3001\u30c6\u30f3\u30dd\u306e\u901f\u3044\u30bb\u30af\u30b7\u30e7\u30f3\u306f\u5727\u5012\u3055\u308c\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u305d\u306e\u305f\u3081\u3001\u6700\u521d\u306f\u305d\u308c\u3089\u3092\u30b9\u30ed\u30fc\u30c0\u30a6\u30f3\u3059\u308b\u3053\u3068\u3067\u3001\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u7d99\u7d9a\u7684\u306a\u7df4\u7fd2\u3068\u5fcd\u8010\u529b\u304c\u3001\u3042\u306a\u305f\u306e\u30b9\u30ad\u30eb\u5411\u4e0a\u306b\u91cd\u8981\u3067\u3059\u3002"}, {"question": "Friday Night Funkin\u306e\u9032\u884c\u72b6\u6cc1\u3092\u5225\u306e\u30c7\u30d0\u30a4\u30b9\u306b\u8ee2\u9001\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3044\u3044\u3067\u3059\u304b\uff1f", "answer": "Friday Night Funkin\u306e\u9032\u884c\u72b6\u6cc1\u3092\u5225\u306e\u30c7\u30d0\u30a4\u30b9\u306b\u8ee2\u9001\u3059\u308b\u306b\u306f\u3001\u4fdd\u5b58\u30d5\u30a1\u30a4\u30eb\u3092\u30b3\u30d4\u30fc\u3059\u308b\u3053\u3068\u3067\u53ef\u80fd\u3067\u3059\u3002\u73fe\u5728\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u4fdd\u5b58\u30d5\u30a1\u30a4\u30eb\u3092\u898b\u3064\u3051\u3001\u901a\u5e38\u306f\u30b2\u30fc\u30e0\u306e\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u306b\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30d5\u30a1\u30a4\u30eb\u3092\u3001\u65b0\u3057\u3044\u30c7\u30d0\u30a4\u30b9\u306e\u540c\u3058\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u306b\u30b3\u30d4\u30fc\u3057\u307e\u3059\u3002\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u30b2\u30fc\u30e0\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u304c\u540c\u3058\u3067\u3042\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305d\u3046\u3057\u306a\u3044\u3068\u4e92\u63db\u6027\u554f\u984c\u304c\u767a\u751f\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001PC\u3067\u3044\u304f\u3064\u304b\u306e\u66f2\u3092\u30d7\u30ec\u30a4\u3057\u3066\u5b8c\u4e86\u3057\u305f\u5834\u5408\u306f\u3001\u4fdd\u5b58\u30d5\u30a1\u30a4\u30eb\u3092\u30e9\u30c3\u30d7\u30c8\u30c3\u30d7\u306b\u30b3\u30d4\u30fc\u3059\u308b\u3053\u3068\u3067\u3001\u4e2d\u65ad\u3057\u305f\u3068\u3053\u308d\u304b\u3089\u518d\u958b\u3067\u304d\u307e\u3059\u3002\u4fdd\u5b58\u30d5\u30a1\u30a4\u30eb\u3092\u8ee2\u9001\u3059\u308b\u524d\u306b\u3001\u5fc5\u305a\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u3092\u4f5c\u6210\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "Friday Night Funkin\u3067\u3001\u898b\u9003\u3057\u3066\u3044\u308b\u53ef\u80fd\u6027\u306e\u3042\u308b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "Friday Night Funkin\u306b\u306f\u3001\u30b2\u30fc\u30e0\u306e\u9b45\u529b\u3092\u9ad8\u3081\u308b\u96a0\u3055\u308c\u305f\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u305f\u304f\u3055\u3093\u3042\u308a\u307e\u3059\u3002\u6ce8\u76ee\u3059\u3079\u304d\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306e1\u3064\u306f\u3001\u30bf\u30a4\u30c8\u30eb\u753b\u9762\u3067\u7279\u5b9a\u306e\u30ad\u30fc\u3092\u62bc\u3059\u3053\u3068\u3067\u300cWeek 7\u300d\u306e\u79d8\u5bc6\u306e\u66f2\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u308b\u3053\u3068\u3067\u3059\u3002\u3082\u3046\u4e00\u3064\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3001\u300cWhitty\u300d\u3068\u3044\u3046\u96a0\u3055\u308c\u305f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3067\u3059\u3002\u3053\u308c\u306f\u3001\u7279\u5b9a\u306e\u30e2\u30c3\u30c9\u3092\u4ecb\u3057\u3066\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u3002\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u30d5\u30a9\u30fc\u30e9\u30e0\u3084\u30e2\u30c7\u30a3\u30f3\u30b0\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u3092\u63a2\u6c42\u3059\u308b\u3068\u3001\u3088\u308a\u591a\u304f\u306e\u96a0\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u300cWhitty Mod\u300d\u306f\u3001\u65b0\u3057\u3044\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3068\u66f2\u3092\u5c0e\u5165\u3057\u3001\u30b2\u30fc\u30e0\u306b\u65b0\u305f\u306a\u4f53\u9a13\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3084\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u306e\u767a\u898b\u306b\u6ce8\u610f\u3057\u3066\u3001\u3088\u308a\u591a\u304f\u306e\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3092\u898b\u3064\u3051\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "Friday Night Funkin\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u3069\u306e\u3088\u3046\u306a\u8981\u7d20\u304c\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "Friday Night Funkin\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u97f3\u7b26\u3092\u6b63\u78ba\u304b\u3064\u30bf\u30a4\u30df\u30f3\u30b0\u3088\u304f\u30d2\u30c3\u30c8\u3057\u305f\u3053\u3068\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u97f3\u7b26\u3092\u5b8c\u74a7\u306b\u30d2\u30c3\u30c8\u3059\u308b\u3068\u3001\u30b9\u30b3\u30a2\u500d\u7387\u304c\u4e0a\u304c\u308a\u307e\u3059\u3002\u97f3\u7b26\u3092\u5916\u3057\u305f\u308a\u3001\u4e0d\u6b63\u78ba\u306b\u30d2\u30c3\u30c8\u3057\u305f\u308a\u3059\u308b\u3068\u3001\u6e1b\u5c11\u3057\u307e\u3059\u3002\u3053\u306e\u30b2\u30fc\u30e0\u306f\u3001\u9023\u7d9a\u3057\u3066\u30d2\u30c3\u30c8\u3057\u305f\u3053\u3068\u3092\u3001\u3064\u307e\u308a\u30b3\u30f3\u30dc\u3092\u8912\u3081\u3066\u3001\u30b9\u30b3\u30a2\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002\u300cMilf\u300d\u306a\u3069\u306e\u66f2\u3067\u306f\u3001\u9ad8\u3044\u30b3\u30f3\u30dc\u3092\u7dad\u6301\u3057\u3001\u97f3\u7b26\u3092\u5b8c\u74a7\u306b\u30d2\u30c3\u30c8\u3059\u308b\u3053\u3068\u3067\u3001\u4e00\u8cab\u6027\u306e\u306a\u3044\u30d2\u30c3\u30c8\u3068\u6bd4\u3079\u3066\u3001\u306f\u308b\u304b\u306b\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3057\u3001\u6b63\u78ba\u6027\u3068\u30b3\u30f3\u30dc\u306b\u96c6\u4e2d\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u3067\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002"}]
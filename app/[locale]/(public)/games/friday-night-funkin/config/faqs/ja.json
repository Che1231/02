[{"question": "Friday Night Funkin\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u3069\u306e\u3088\u3046\u306b\u59cb\u3081\u3089\u308c\u307e\u3059\u304b\uff1f", "answer": "Friday Night Funkin\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u306b\u6163\u308c\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u306e\u30b2\u30fc\u30e0\u3067\u306f\u3001\u753b\u9762\u306b\u8868\u793a\u3055\u308c\u308b\u97f3\u7b26\u306b\u5bfe\u5fdc\u3057\u3066\u3001\u77e2\u5370\u30ad\u30fc\uff08\u5de6\u3001\u4e0b\u3001\u4e0a\u3001\u53f3\uff09\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u97f3\u7b26\u304c\u753b\u9762\u4e0a\u90e8\u306e\u77e2\u5370\u306b\u5230\u9054\u3057\u305f\u3089\u3001\u5bfe\u5fdc\u3059\u308b\u30ad\u30fc\u3092\u62bc\u3057\u3066\u97f3\u7b26\u3092\u30d2\u30c3\u30c8\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u97f3\u7b26\u304c\u5de6\u77e2\u5370\u306b\u8868\u793a\u3055\u308c\u305f\u5834\u5408\u3001\u5de6\u77e2\u5370\u30ad\u30fc\u3092\u62bc\u3057\u307e\u3059\u3002\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3084\u6700\u521d\u306e\u6570\u30ec\u30d9\u30eb\u3067\u7df4\u7fd2\u3057\u3066\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u63b4\u307f\u307e\u3057\u3087\u3046\u3002\u6b63\u78ba\u3055\u306f\u3001\u30b2\u30fc\u30e0\u3092\u9032\u3081\u308b\u4e0a\u3067\u91cd\u8981\u3067\u3059\u3002"}, {"question": "Friday Night Funkin\u3067\u30b9\u30b3\u30a2\u3092\u4e0a\u3052\u308b\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Friday Night Funkin\u3067\u30b9\u30b3\u30a2\u3092\u4e0a\u3052\u308b\u306b\u306f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u3001\u6b63\u78ba\u6027\u3001\u305d\u3057\u3066\u7df4\u7fd2\u306e\u7d44\u307f\u5408\u308f\u305b\u304c\u5fc5\u8981\u3067\u3059\u3002\u4ee5\u4e0b\u306f\u3001\u3042\u306a\u305f\u3092\u52a9\u3051\u308b\u305f\u3081\u306e\u624b\u9806\u3067\u3059\uff1a\u30b9\u30c6\u30c3\u30d71\uff1a\u97f3\u7b26\u3092\u5b8c\u74a7\u306b\u30d2\u30c3\u30c8\u3059\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u3001\u3053\u308c\u306b\u3088\u308a\u3001\u6700\u9ad8\u306e\u30b9\u30b3\u30a2\u500d\u7387\u3092\u5f97\u3089\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d5\u30ea\u30fc\u30d7\u30ec\u30a4\u30e2\u30fc\u30c9\u3067\u7df4\u7fd2\u3057\u3066\u3001\u697d\u66f2\u306e\u30d1\u30bf\u30fc\u30f3\u306b\u6163\u308c\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7df4\u7fd2\u30e2\u30fc\u30c9\u3092\u4f7f\u7528\u3057\u3066\u3001\u96e3\u3057\u3044\u90e8\u5206\u3092\u30b9\u30ed\u30fc\u30c0\u30a6\u30f3\u3057\u3001\u7fd2\u5f97\u3057\u307e\u3057\u3087\u3046\u3002\u300cDad Battle\u300d\u306a\u3069\u306e\u66f2\u3067\u306f\u3001\u30c6\u30f3\u30dd\u306e\u901f\u3044\u30bb\u30af\u30b7\u30e7\u30f3\u306f\u96e3\u3057\u3044\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\u305d\u306e\u305f\u3081\u3001\u305d\u308c\u3089\u3092\u30b9\u30ed\u30fc\u30c0\u30a6\u30f3\u3059\u308b\u3053\u3068\u3067\u3001\u6539\u5584\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30ea\u30e9\u30c3\u30af\u30b9\u3092\u7d9a\u3051\u3001\u4e00\u5b9a\u306e\u30ea\u30ba\u30e0\u3092\u7dad\u6301\u3059\u308b\u3053\u3068\u3067\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002"}, {"question": "\u306a\u305cFriday Night Funkin\u3067\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u6642\u3005\u97f3\u7b26\u3092\u5916\u3057\u3066\u3057\u307e\u3046\u306e\u3067\u3057\u3087\u3046\u304b\uff1f\u3069\u306e\u3088\u3046\u306b\u4fee\u6b63\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "Friday Night Funkin\u3067\u97f3\u7b26\u3092\u5916\u3057\u3066\u3057\u307e\u3046\u306e\u306f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u9593\u9055\u3063\u3066\u3044\u308b\u3001\u30e9\u30b0\u304c\u3042\u308b\u3001\u307e\u305f\u306f\u30ad\u30fc\u5165\u529b\u306b\u305a\u308c\u304c\u3042\u308b\u306a\u3069\u3001\u3044\u304f\u3064\u304b\u306e\u7406\u7531\u304c\u8003\u3048\u3089\u308c\u307e\u3059\u3002\u3053\u308c\u3089\u3092\u4fee\u6b63\u3059\u308b\u306b
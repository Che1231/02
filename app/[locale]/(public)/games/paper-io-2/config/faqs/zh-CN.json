[{"question": "\u5982\u4f55\u4f5c\u4e3a\u5b8c\u5168\u7684\u65b0\u624b\u5f00\u59cb\u73a9Paper.io 2\uff1f", "answer": "\u8981\u5f00\u59cb\u73a9Paper.io 2\uff0c\u9996\u5148\uff0c\u4ece\u60a8\u7684\u5e94\u7528\u5546\u5e97\u4e0b\u8f7d\u6e38\u620f\u3002\u6253\u5f00\u6e38\u620f\uff0c\u60a8\u5c06\u88ab\u63d0\u793a\u9009\u62e9\u7528\u6237\u540d\u3002\u8fdb\u5165\u6e38\u620f\u540e\uff0c\u7528\u624b\u6307\u5728\u60a8\u60f3\u8981\u89d2\u8272\u79fb\u52a8\u7684\u65b9\u5411\u6ed1\u52a8\u3002\u76ee\u6807\u662f\u901a\u8fc7\u5728\u5730\u56fe\u4e0a\u79fb\u52a8\u548c\u95ed\u5408\u73af\u5f62\u533a\u57df\u6765\u638c\u63a7\u9886\u571f\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u4ee5\u6b63\u65b9\u5f62\u79fb\u52a8\u5e76\u8fd4\u56de\u8d77\u70b9\uff0c\u5219\u6b63\u65b9\u5f62\u5185\u7684\u533a\u57df\u5c06\u6210\u4e3a\u60a8\u7684\u9886\u571f\u3002\u907f\u514d\u5176\u4ed6\u73a9\u5bb6\u7684\u8f68\u8ff9\uff0c\u4ee5\u9632\u6b62\u88ab\u6dd8\u6c70\u3002"}, {"question": "Paper.io 2\u7684\u57fa\u672c\u63a7\u5236\u65b9\u6cd5\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5b83\u4eec\u5982\u4f55\u8fd0\u4f5c\uff1f", "answer": "Paper.io 2\u7684\u57fa\u672c\u63a7\u5236\u65b9\u6cd5\u5305\u62ec\u5728\u5c4f\u5e55\u4e0a\u6ed1\u52a8\u6765\u79fb\u52a8\u60a8\u7684\u89d2\u8272\u3002\u5411\u5de6\u3001\u5411\u53f3\u3001\u5411\u4e0a\u6216\u5411\u4e0b\u6ed1\u52a8\u6765\u6539\u53d8\u65b9\u5411\u3002\u8981\u638c\u63a7\u9886\u571f\uff0c\u8bf7\u4ee5\u521b\u5efa\u95ed\u5408\u73af\u5f62\u533a\u57df\u7684\u65b9\u5f0f\u79fb\u52a8\uff1b\u73af\u5f62\u533a\u57df\u5185\u7684\u533a\u57df\u5c06\u6210\u4e3a\u60a8\u7684\u9886\u571f\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u4ee5\u5706\u5f62\u79fb\u52a8\u5e76\u8fd4\u56de\u8d77\u70b9\uff0c\u5219\u5c01\u95ed\u533a\u57df\u5c31\u662f\u60a8\u7684\u3002\u8bf7\u6ce8\u610f\u5176\u4ed6\u73a9\u5bb6\u7684\u8f68\u8ff9\uff0c\u56e0\u4e3a\u89e6\u78b0\u5230\u5b83\u4eec\u5c06\u4f1a\u6dd8\u6c70\u60a8\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u6211\u5728Paper.io 2\u4e2d\u4e0d\u65ad\u88ab\u6dd8\u6c70\uff1f", "answer": "\u60a8\u5728Paper.io 2\u4e2d\u4e0d\u65ad\u88ab\u6dd8\u6c70\uff0c\u53ef\u80fd\u662f\u56e0\u4e3a\u60a8\u89e6\u78b0\u5230\u4e86\u5176\u4ed6\u73a9\u5bb6\u7684\u8f68\u8ff9\u3002\u5f53\u60a8\u7684\u89d2\u8272\u89e6\u78b0\u5230\u5176\u4ed6\u73a9\u5bb6\u7684\u8f68\u8ff9\u65f6\uff0c\u60a8\u5c31\u4f1a\u88ab\u6dd8\u6c70\u3002\u4e3a\u4e86\u907f\u514d\u8fd9\u79cd\u60c5\u51b5\uff0c\u8bf7\u5f85\u5728\u60a8\u81ea\u5df1\u7684\u9886\u571f\u5185\uff0c\u5e76\u5728\u6269\u5f20\u65f6\u8c28\u614e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u770b\u5230\u4e00\u6761\u7ea2\u8272\u7684\u8f68\u8ff9\u63a5\u8fd1\uff0c\u8bf7\u8fc5\u901f\u6539\u53d8\u65b9\u5411\u4ee5\u907f\u514d\u5b83\u3002\u6b64\u5916\uff0c\u4e0d\u8981\u5728\u6ca1\u6709\u660e\u786e\u56de\u7a0b\u8def\u7ebf\u7684\u60c5\u51b5\u4e0b\u8fdc\u79bb\u60a8\u7684\u9886\u571f\u3002"}, {"question": "\u5982\u4f55\u5728Paper.io 2\u4e2d\u6539\u8fdb\u6211\u7684\u9886\u571f\u6269\u5f20\u7b56\u7565\uff1f", "answer": "\u5728Paper.io 2\u4e2d\u6539\u8fdb\u60a8\u7684\u9886\u571f\u6269\u5f20\u7b56\u7565\u9700\u8981\u4ed4\u7ec6\u7684\u89c4\u5212\u548c\u6267\u884c\u3002\u6b65\u9aa41\uff1a\u9996\u5148\uff0c\u5728\u8d77\u70b9\u9644\u8fd1\u4fdd\u62a4\u4e00\u5c0f\u5757\u533a\u57df\u3002\u6b65\u9aa42\uff1a\u9010\u6e10\u5411\u5916\u6269\u5f20\uff0c\u786e\u4fdd\u60a8\u6709\u660e\u786e\u7684\u56de\u7a0b\u8def\u7ebf\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u5feb\u901f\u3001\u77ed\u5c0f\u7684\u73af\u5f62\u533a\u57df\u6765\u638c\u63a7\u5c0f\u533a\u57df\uff0c\u800c\u4e0d\u662f\u5c1d\u8bd5\u5927\u89c4\u6a21\u7684\u5192\u9669\u6269\u5f20\u3002\u4f8b\u5982\uff0c\u4e0e\u5176\u5c1d\u8bd5\u638c\u63a7\u5de8\u5927\u7684\u77e9\u5f62\uff0c\u4e0d\u5982\u5236\u4f5c\u66f4\u5c0f\u7684\u6b63\u65b9\u5f62\uff0c\u8fd9\u6837\u66f4\u5bb9\u6613\u95ed\u5408\u548c\u9632\u5fa1\u3002"}, {"question": "Paper.io 2\u4e2d\u6700\u597d\u7684\u9632\u5fa1\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728Paper.io 2\u4e2d\u6700\u597d\u7684\u9632\u5fa1\u7b56\u7565\u5305\u62ec\u5f85\u5728\u60a8\u7684\u9886\u571f\u5185\uff0c\u5e76\u7559\u610f\u5176\u4ed6\u73a9\u5bb6\u7684\u4e3e\u52a8\u3002\u6b65\u9aa41\uff1a\u59cb\u7ec8\u5173\u6ce8\u5730\u56fe\u4e0a\u7684\u9760\u8fd1\u73a9\u5bb6\u3002\u6b65\u9aa42\uff1a\u5982\u679c\u73a9\u5bb6\u9760\u8fd1\uff0c\u8bf7\u9000\u56de\u5230\u60a8\u7684\u9886\u571f\u5185\uff0c\u7b49\u5f85\u4ed6\u4eec\u7ecf\u8fc7\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u5feb\u901f\u3001\u4e0d\u53ef\u9884\u6d4b\u7684\u79fb\u52a8\u6765\u8ff7\u60d1\u653b\u51fb\u8005\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4e00\u4e2a\u73a9\u5bb6\u5728\u8ffd\u9010\u60a8\uff0c\u8bf7\u7a81\u7136\u6539\u53d8\u65b9\u5411\u4ee5\u8ba9\u4ed6\u4eec\u5206\u5fc3\uff0c\u7136\u540e\u8fc5\u901f\u8fd4\u56de\u60a8\u7684\u5b89\u5168\u533a\u57df\u3002"}, {"question": "\u5982\u4f55\u5728Paper.io 2\u4e2d\u6709\u6548\u5730\u7ba1\u7406\u6211\u7684\u65f6\u95f4\u548c\u8d44\u6e90\uff1f", "answer": "\u5728Paper.io 2\u4e2d\u6709\u6548\u5730\u7ba1\u7406\u60a8\u7684\u65f6\u95f4\u548c\u8d44\u6e90\u9700\u8981\u5e73\u8861\u6269\u5f20\u548c\u9632\u5fa1\u3002\u6b65\u9aa41\uff1a\u5206\u914d\u65f6\u95f4\u6765\u4fdd\u62a4\u5c0f\u800c\u6613\u4e8e\u9632\u5fa1\u7684\u533a\u57df\u3002\u6b65\u9aa42\uff1a\u907f\u514d\u8fc7\u5ea6\u6269\u5f20\uff1b\u59cb\u7ec8\u62e5\u6709\u901a\u5f80\u60a8\u9886\u571f\u7684\u660e\u786e\u8def\u5f84\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u5feb\u901f\u3001\u6709\u7b56\u7565\u7684\u79fb\u52a8\u6765\u638c\u63a7\u9886\u571f\uff0c\u800c\u4e0d\u4f1a\u5192\u88ab\u6dd8\u6c70\u7684\u98ce\u9669\u3002\u4f8b\u5982\uff0c\u4e0e\u5176\u82b1\u8d39\u5927\u91cf\u65f6\u95f4\u5c1d\u8bd5\u638c\u63a7\u4e00\u4e2a\u5927\u533a\u57df\uff0c\u4e0d\u5982\u4e13\u6ce8\u4e8e\u66f4\u5c0f\u3001\u66f4\u5bb9\u6613\u7ba1\u7406\u7684\u90e8\u5206\uff0c\u5e76\u80fd\u5feb\u901f\u638c\u63a7\u3002"}, {"question": "\u5728Paper.io 2\u4e2d\u638c\u63a7\u9886\u571f\u80cc\u540e\u7684\u5173\u952e\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728Paper.io 2\u4e2d\u638c\u63a7\u9886\u571f\u80cc\u540e\u7684\u5173\u952e\u673a\u5236\u5305\u62ec\u521b\u5efa\u95ed\u5408\u7684\u73af\u5f62\u533a\u57df\u3002\u5f53\u60a8\u4ee5\u5f62\u6210\u95ed\u5408\u5f62\u72b6\u7684\u65b9\u5f0f\u79fb\u52a8\u60a8\u7684\u89d2\u8272\u65f6\uff0c\u8be5\u5f62\u72b6\u5185\u7684\u533a\u57df\u5c06\u6210\u4e3a\u60a8\u7684\u9886\u571f\u3002\u6e38\u620f\u4f7f\u7528\u7f51\u683c\u7cfb\u7edf\u6765\u786e\u5b9a\u60a8\u7684\u9886\u571f\u7684\u8fb9\u754c\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u4ee5\u6b63\u65b9\u5f62\u79fb\u52a8\u5e76\u8fd4\u56de\u8d77\u70b9\uff0c\u5219\u8be5\u6b63\u65b9\u5f62\u5185\u7684\u7f51\u683c\u65b9\u5757\u5c06\u88ab\u638c\u63a7\u3002\u60a8\u521b\u5efa\u8fd9\u4e9b\u73af\u5f62\u533a\u57df\u7684\u6548\u7387\u8d8a\u9ad8\uff0c\u60a8\u5c31\u80fd\u638c\u63a7\u8d8a\u591a\u7684\u9886\u571f\u3002"}, {"question": "Paper.io 2\u7684\u5206\u6570\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "Paper.io 2\u7684\u5206\u6570\u7cfb\u7edf\u57fa\u4e8e\u60a8\u638c\u63a7\u7684\u9886\u571f\u6570\u91cf\u3002\u60a8\u638c\u63a7\u7684\u6bcf\u4e2a\u7f51\u683c\u65b9\u5757\u90fd\u4f1a\u589e\u52a0\u60a8\u7684\u5206\u6570\u3002\u6b64\u5916\uff0c\u901a\u8fc7\u89e6\u78b0\u5176\u4ed6\u73a9\u5bb6\u7684\u8f68\u8ff9\u6dd8\u6c70\u4ed6\u4eec\u4e5f\u4f1a\u589e\u52a0\u60a8\u7684\u5206\u6570\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u638c\u63a7\u4e86\u4e00\u4e2a10x10\u7684\u533a\u57df\uff0c\u8fd9\u5c06\u589e\u52a0100\u5206\u5230\u60a8\u7684\u5206\u6570\u3002\u8be5\u6e38\u620f\u8fd8\u62e5\u6709\u4e00\u4e2a\u6392\u884c\u699c\uff0c\u6839\u636e\u73a9\u5bb6\u7684\u5206\u6570\u5bf9\u4ed6\u4eec\u8fdb\u884c\u6392\u540d\uff0c\u9f13\u52b1\u7ade\u4e89\u548c\u6218\u7565\u73a9\u6cd5\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5728\u591a\u4e2a\u8bbe\u5907\u4e0a\u73a9Paper.io 2\uff0c\u5e76\u540c\u6b65\u6211\u7684\u8fdb\u5ea6\u5417\uff1f", "answer": "\u76ee\u524d\uff0cPaper.io 2\u4e0d\u652f\u6301\u8de8\u8bbe\u5907\u8fdb\u5ea6\u540c\u6b65\u3002\u6bcf\u4e2a\u8bbe\u5907\u5c06\u62e5\u6709\u5176\u72ec\u7acb\u7684\u6e38\u620f\u6570\u636e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u624b\u673a\u4e0a\u73a9\uff0c\u7136\u540e\u5207\u6362\u5230\u5e73\u677f\u7535\u8111\uff0c\u60a8\u5c06\u5728\u5e73\u677f\u7535\u8111\u4e0a\u4ece\u5934\u5f00\u59cb\u3002\u4f46\u662f\uff0c\u60a8\u53ef\u4ee5\u901a\u8fc7\u5728\u4e24\u4e2a\u8bbe\u5907\u4e0a\u4f7f\u7528\u76f8\u540c\u7684\u5e10\u6237\u624b\u52a8\u8f6c\u79fb\u8fdb\u5ea6\uff0c\u4f46\u8fd9\u53ef\u80fd\u9700\u8981\u989d\u5916\u6b65\u9aa4\uff0c\u5e76\u4e14\u4e0d\u53d7\u5b98\u65b9\u652f\u6301\u3002"}, {"question": "Paper.io 2\u4e2d\u662f\u5426\u6709\u4efb\u4f55\u9690\u85cf\u7684\u6210\u5c31\u6216\u79d8\u5bc6\uff1f", "answer": "\u662f\u7684\uff0cPaper.io 2\u4e2d\u6709\u4e00\u4e9b\u9690\u85cf\u7684\u6210\u5c31\u548c\u79d8\u5bc6\uff0c\u53ef\u4ee5\u901a\u8fc7\u6267\u884c\u7279\u5b9a\u64cd\u4f5c\u6765\u89e3\u9501\u3002\u4f8b\u5982\uff0c\u6709\u4e00\u4e2a\u6210\u5c31\u9700\u8981\u5728\u4e00\u6b21\u6e38\u620f\u4e2d\u638c\u63a7\u4e00\u5b9a\u767e\u5206\u6bd4\u7684\u5730\u56fe\u3002\u53e6\u4e00\u4e2a\u79d8\u5bc6\u6d89\u53ca\u4f7f\u7528\u7279\u5b9a\u6a21\u5f0f\u6765\u638c\u63a7\u9886\u571f\uff0c\u8fd9\u53ef\u4ee5\u89e3\u9501\u72ec\u7279\u7684\u76ae\u80a4\u6216\u5956\u52b1\u3002\u63a2\u7d22\u4e0d\u540c\u7684\u7b56\u7565\u5e76\u5c1d\u8bd5\u4e0d\u540c\u7684\u79fb\u52a8\u65b9\u5f0f\u53ef\u4ee5\u5e2e\u52a9\u60a8\u53d1\u73b0\u8fd9\u4e9b\u9690\u85cf\u5143\u7d20\u3002"}]
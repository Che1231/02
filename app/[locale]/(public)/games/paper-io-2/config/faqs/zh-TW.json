[{"question": "\u5982\u4f55\u958b\u59cb\u73a9 Paper.io 2\uff0c\u4f5c\u70ba\u5b8c\u5168\u7684\u65b0\u624b\uff1f", "answer": "\u8981\u958b\u59cb\u73a9 Paper.io 2\uff0c\u9996\u5148\uff0c\u8acb\u5f9e\u60a8\u7684\u61c9\u7528\u7a0b\u5f0f\u5546\u5e97\u4e0b\u8f09\u904a\u6232\u3002\u958b\u555f\u904a\u6232\u5f8c\uff0c\u7cfb\u7d71\u6703\u63d0\u793a\u60a8\u9078\u64c7\u4f7f\u7528\u8005\u540d\u7a31\u3002\u4e00\u65e6\u9032\u5165\u904a\u6232\uff0c\u8acb\u7528\u624b\u6307\u5728\u60a8\u60f3\u8981\u89d2\u8272\u79fb\u52d5\u7684\u65b9\u5411\u8f15\u62c2\u3002\u76ee\u6a19\u662f\u900f\u904e\u79fb\u52d5\u5730\u5716\u548c\u5c01\u9589\u8ff4\u8def\u4f86\u4f54\u9818\u9818\u571f\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u6b63\u65b9\u5f62\u5340\u57df\u5167\u79fb\u52d5\u4e26\u56de\u5230\u539f\u9ede\uff0c\u5247\u8a72\u6b63\u65b9\u5f62\u5340\u57df\u5167\u7684\u7bc4\u570d\u6703\u8b8a\u6210\u60a8\u7684\u9818\u571f\u3002\u907f\u514d\u89f8\u78b0\u5176\u4ed6\u73a9\u5bb6\u7684\u8ecc\u8de1\uff0c\u4ee5\u514d\u88ab\u6dd8\u6c70\u3002"}, {"question": "Paper.io 2 \u7684\u57fa\u672c\u63a7\u5236\u9805\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5b83\u5011\u5982\u4f55\u904b\u4f5c\uff1f", "answer": "Paper.io 2 \u7684\u57fa\u672c\u63a7\u5236\u9805\u5305\u62ec\u5728\u87a2\u5e55\u4e0a\u8f15\u62c2\u4f86\u79fb\u52d5\u89d2\u8272\u3002\u5411\u5de6\u3001\u5411\u53f3\u3001\u5411\u4e0a\u6216\u5411\u4e0b\u8f15\u62c2\u4ee5\u6539\u8b8a\u65b9\u5411\u3002\u8981\u4f54\u9818\u9818\u571f\uff0c\u8acb\u4ee5\u5f62\u6210\u5c01\u9589\u8ff4\u8def\u7684\u65b9\u5f0f\u79fb\u52d5\uff1b\u8ff4\u8def\u5167\u90e8\u7684\u5340\u57df\u5c07\u6210\u70ba\u60a8\u7684\u9818\u571f\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u6cbf\u8457\u5713\u5708\u79fb\u52d5\u4e26\u56de\u5230\u539f\u9ede\uff0c\u5247\u5c01\u9589\u5340\u57df\u5373\u70ba\u60a8\u7684\u9818\u571f\u3002\u8acb\u5c0f\u5fc3\u5176\u4ed6\u73a9\u5bb6\u7684\u8ecc\u8de1\uff0c\u56e0\u70ba\u89f8\u78b0\u5230\u5b83\u5011\u6703\u5c0e\u81f4\u60a8\u88ab\u6dd8\u6c70\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u6211\u5728 Paper.io 2 \u4e2d\u4e00\u76f4\u88ab\u6dd8\u6c70\uff1f", "answer": "\u60a8\u5728 Paper.io 2 \u4e2d\u4e0d\u65b7\u88ab\u6dd8\u6c70\uff0c\u5f88\u53ef\u80fd\u662f\u56e0\u70ba\u60a8\u78b0\u5230\u5176\u4ed6\u73a9\u5bb6\u7684\u8ecc\u8de1\u3002\u7576\u60a8\u7684\u89d2\u8272\u89f8\u78b0\u5230\u5176\u4ed6\u73a9\u5bb6\u7684\u8ecc\u8de1\u6642\uff0c\u60a8\u5c31\u6703\u88ab\u6dd8\u6c70\u3002\u70ba\u907f\u514d\u9019\u7a2e\u60c5\u6cc1\uff0c\u8acb\u5f85\u5728\u60a8\u81ea\u5df1\u7684\u9818\u571f\u5167\uff0c\u4e26\u5728\u64f4\u5f35\u9818\u571f\u6642\u52d9\u5fc5\u5c0f\u5fc3\u8b39\u614e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u770b\u5230\u4e00\u689d\u7d05\u8272\u8ecc\u8de1\u903c\u8fd1\uff0c\u8acb\u8fc5\u901f\u6539\u8b8a\u65b9\u5411\u4ee5\u907f\u514d\u89f8\u78b0\u3002\u6b64\u5916\uff0c\u4e0d\u8981\u5728\u6c92\u6709\u660e\u78ba\u56de\u7a0b\u8def\u5f91\u7684\u60c5\u6cc1\u4e0b\uff0c\u96e2\u958b\u60a8\u7684\u9818\u571f\u7bc4\u570d\u904e\u9060\u3002"}, {"question": "\u5982\u4f55\u5728 Paper.io 2 \u4e2d\u6539\u9032\u6211\u7684\u9818\u571f\u64f4\u5f35\u7b56\u7565\uff1f", "answer": "\u5728 Paper.io 2 \u4e2d\u6539\u9032\u60a8\u7684\u9818\u571f\u64f4\u5f35\u7b56\u7565\u9700\u8981\u4ed4\u7d30\u7684\u8a08\u756b\u548c\u57f7\u884c\u3002\u6b65\u9a5f\u4e00\uff1a\u5f9e\u9760\u8fd1\u8d77\u59cb\u9ede\u7684\u5c0f\u5340\u57df\u958b\u59cb\u78ba\u4fdd\u3002\u6b65\u9a5f\u4e8c\uff1a\u9010\u6b65\u5411\u5916\u64f4\u5f35\uff0c\u78ba\u4fdd\u60a8\u6709\u8fd4\u56de\u9818\u571f\u7684\u660e\u78ba\u8def\u5f91\u3002\u6b65\u9a5f\u4e09\uff1a\u5229\u7528\u5feb\u901f\u7c21\u77ed\u7684\u8ff4\u8def\u4f54\u9818\u5c0f\u5340\u57df\uff0c\u800c\u975e\u5617\u8a66\u5927\u578b\u4e14\u6709\u98a8\u96aa\u7684\u64f4\u5f35\u3002\u4f8b\u5982\uff0c\u4e0d\u8981\u8a66\u5716\u4f54\u9818\u4e00\u500b\u5de8\u5927\u7684\u9577\u65b9\u5f62\uff0c\u800c\u662f\u5efa\u7acb\u8f03\u5c0f\u7684\u6b63\u65b9\u5f62\uff0c\u9019\u4e9b\u6b63\u65b9\u5f62\u66f4\u5bb9\u6613\u5c01\u9589\u4e14\u66f4\u5bb9\u6613\u9632\u79a6\u3002"}, {"question": "Paper.io 2 \u4e2d\u6700\u4f73\u7684\u9632\u5b88\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "Paper.io 2 \u4e2d\u6700\u4f73\u7684\u9632\u5b88\u7b56\u7565\u5305\u62ec\u5f85\u5728\u60a8\u7684\u9818\u571f\u5167\u4e26\u7559\u610f\u5176\u4ed6\u73a9\u5bb6\u7684\u52d5\u4f5c\u3002\u6b65\u9a5f\u4e00\uff1a\u59cb\u7d42\u6ce8\u610f\u5730\u5716\u4e0a\u903c\u8fd1\u7684\u73a9\u5bb6\u3002\u6b65\u9a5f\u4e8c\uff1a\u5982\u679c\u9130\u8fd1\u73a9\u5bb6\uff0c\u5247\u64a4\u9000\u5230\u60a8\u7684\u9818\u571f\u5167\uff0c\u7b49\u5f85\u4ed6\u5011\u901a\u904e\u3002\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u5feb\u901f\u4e14\u96e3\u4ee5\u9810\u6e2c\u7684\u52d5\u4f5c\u4f86\u6df7\u6dc6\u653b\u64ca\u8005\u3002\u4f8b\u5982\uff0c\u5982\u679c\u73a9\u5bb6\u5728\u8ffd\u9010\u60a8\uff0c\u5247\u5feb\u901f\u8f49\u5f4e\u4f86\u4f7f\u4ed6\u5011\u5931\u53bb\u76ee\u6a19\uff0c\u7136\u5f8c\u8fc5\u901f\u56de\u5230\u5b89\u5168\u5340\u57df\u3002"}, {"question": "\u5982\u4f55\u5728 Paper.io 2 \u4e2d\u6709\u6548\u5730\u7ba1\u7406\u6211\u7684\u6642\u9593\u548c\u8cc7\u6e90\uff1f", "answer": "\u5728 Paper.io 2 \u4e2d\u6709\u6548\u5730\u7ba1\u7406\u60a8\u7684\u6642\u9593\u548c\u8cc7\u6e90\u9700\u8981\u5e73\u8861\u64f4\u5f35\u548c\u9632\u5b88\u3002\u6b65\u9a5f\u4e00\uff1a\u5206\u914d\u6642\u9593\u4f86\u78ba\u4fdd\u5c0f\u4e14\u6613\u65bc\u9632\u5b88\u7684\u5340\u57df\u3002\u6b65\u9a5f\u4e8c\uff1a\u907f\u514d\u904e\u5ea6\u64f4\u5f35\uff1b\u59cb\u7d42\u4fdd\u6301\u8fd4\u56de\u9818\u571f\u7684\u660e\u78ba\u8def\u5f91\u3002\u6b65\u9a5f\u4e09\uff1a\u4f7f\u7528\u5feb\u901f\u4e14\u7b56\u7565\u6027\u7684\u52d5\u4f5c\u4f86\u4f54\u9818\u9818\u571f\uff0c\u800c\u7121\u9700\u5192\u88ab\u6dd8\u6c70\u7684\u98a8\u96aa\u3002\u4f8b\u5982\uff0c\u4e0d\u8981\u82b1\u8cbb\u5927\u91cf\u6642\u9593\u8a66\u5716\u4f54\u9818\u4e00\u500b\u5927\u5340\u57df\uff0c\u800c\u662f\u5c08\u6ce8\u65bc\u53ef\u4ee5\u5feb\u901f\u78ba\u4fdd\u7684\u5c0f\u5340\u57df\u3002"}, {"question": "\u9818\u571f\u4f54\u9818\u5728 Paper.io 2 \u4e2d\u80cc\u5f8c\u7684\u95dc\u9375\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "Paper.io 2 \u4e2d\u9818\u571f\u4f54\u9818\u80cc\u5f8c\u7684\u95dc\u9375\u6a5f\u5236\u5305\u62ec\u5275\u9020\u5c01\u9589\u8ff4\u8def\u3002\u7576\u60a8\u4ee5\u5f62\u6210\u5c01\u9589\u5f62\u72c0\u7684\u65b9\u5f0f\u79fb\u52d5\u89d2\u8272\u6642\uff0c\u8a72\u5f62\u72c0\u5167\u90e8\u7684\u5340\u57df\u5c07\u8b8a\u6210\u60a8\u7684\u9818\u571f\u3002\u904a\u6232\u4f7f\u7528\u7db2\u683c\u7cfb\u7d71\u4f86\u6c7a\u5b9a\u60a8\u7684\u9818\u571f\u908a\u754c\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u6b63\u65b9\u5f62\u5340\u57df\u5167\u79fb\u52d5\u4e26\u56de\u5230\u51fa\u767c\u9ede\uff0c\u5247\u8a72\u6b63\u65b9\u5f62\u5340\u57df\u5167\u7684\u7db2\u683c\u65b9\u584a\u6703\u88ab\u4f54\u9818\u3002\u60a8\u80fd\u5920\u66f4\u6709\u6548\u5730\u5275\u9020\u9019\u4e9b\u8ff4\u8def\uff0c\u5247\u53ef\u4ee5\u4f54\u9818\u66f4\u591a\u9818\u571f\u3002"}, {"question": "Paper.io 2 \u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "Paper.io 2 \u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u60a8\u4f54\u9818\u7684\u9818\u571f\u9762\u7a4d\u3002\u60a8\u4f54\u9818\u7684\u6bcf\u500b\u7db2\u683c\u65b9\u584a\u90fd\u6703\u589e\u52a0\u60a8\u7684\u5206\u6578\u3002\u6b64\u5916\uff0c\u900f\u904e\u89f8\u53ca\u5176\u4ed6\u73a9\u5bb6\u7684\u8ecc\u8de1\u4f86\u6dd8\u6c70\u4ed6\u5011\u4e5f\u6703\u589e\u52a0\u60a8\u7684\u5206\u6578\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u4f54\u9818\u4e00\u500b 10x10 \u7684\u5340\u57df\uff0c\u5247\u6703\u589e\u52a0 100 \u5206\u3002\u904a\u6232\u4e5f\u6709\u6392\u884c\u699c\uff0c\u6839\u64da\u73a9\u5bb6\u7684\u5206\u6578\u6392\u5217\uff0c\u9f13\u52f5\u7af6\u722d\u548c\u7b56\u7565\u6027\u7684\u904a\u6232\u3002"}, {"question": "\u6211\u53ef\u4ee5\u5728\u591a\u500b\u88dd\u7f6e\u4e0a\u73a9 Paper.io 2 \u4e26\u540c\u6b65\u6211\u7684\u9032\u5ea6\u55ce\uff1f", "answer": "\u76ee\u524d\uff0cPaper.io 2 \u4e0d\u652f\u63f4\u8de8\u88dd\u7f6e\u9032\u5ea6\u540c\u6b65\u3002\u6bcf\u500b\u88dd\u7f6e\u90fd\u5c07\u64c1\u6709\u81ea\u5df1\u7368\u7acb\u7684\u904a\u6232\u8cc7\u6599\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u624b\u6a5f\u4e0a\u73a9\uff0c\u7136\u5f8c\u5207\u63db\u5230\u5e73\u677f\u96fb\u8166\uff0c\u60a8\u5c07\u6703\u5728\u5e73\u677f\u96fb\u8166\u4e0a\u5f9e\u982d\u958b\u59cb\u3002\u7136\u800c\uff0c\u60a8\u53ef\u4ee5\u900f\u904e\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u4f7f\u7528\u76f8\u540c\u7684\u5e33\u6236\u624b\u52d5\u50b3\u8f38\u60a8\u7684\u9032\u5ea6\uff0c\u4f46\u9019\u53ef\u80fd\u9700\u8981\u984d\u5916\u7684\u6b65\u9a5f\uff0c\u4e26\u4e14\u672a\u7d93\u5b98\u65b9\u652f\u63f4\u3002"}, {"question": "Paper.io 2 \u4e2d\u662f\u5426\u6709\u4efb\u4f55\u96b1\u85cf\u6210\u5c31\u6216\u79d8\u5bc6\uff1f", "answer": "\u662f\u7684\uff0cPaper.io 2 \u6709\u5e7e\u500b\u96b1\u85cf\u6210\u5c31\u548c\u79d8\u5bc6\uff0c\u900f\u904e\u57f7\u884c\u7279\u5b9a\u52d5\u4f5c\u53ef\u4ee5\u89e3\u9396\u3002\u4f8b\u5982\uff0c\u6709\u4e00\u500b\u6210\u5c31\u7528\u65bc\u5728\u55ae\u4e00\u904a\u6232\u4e2d\u4f54\u9818\u7279\u5b9a\u767e\u5206\u6bd4\u7684\u5730\u5716\u3002\u53e6\u4e00\u500b\u79d8\u5bc6\u662f\u4f7f\u7528\u7279\u5b9a\u6a21\u5f0f\u4f86\u4f54\u9818\u9818\u571f\uff0c\u9019\u53ef\u4ee5\u89e3\u9396\u7368\u7279\u7684\u76ae\u819a\u6216\u734e\u52f5\u3002\u63a2\u7d22\u4e0d\u540c\u7684\u7b56\u7565\u548c\u5617\u8a66\u4e0d\u540c\u7684\u79fb\u52d5\u65b9\u5f0f\u53ef\u4ee5\u5e6b\u52a9\u60a8\u767c\u73fe\u9019\u4e9b\u96b1\u85cf\u5143\u7d20\u3002"}]
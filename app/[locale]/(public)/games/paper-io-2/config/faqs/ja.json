[{"question": "\u30da\u30fc\u30d1\u30fc.io 2\u3092\u307e\u3063\u305f\u304f\u306e\u521d\u5fc3\u8005\u3068\u3057\u3066\u3069\u306e\u3088\u3046\u306b\u30d7\u30ec\u30a4\u3092\u59cb\u3081\u3089\u308c\u307e\u3059\u304b\uff1f", "answer": "\u30da\u30fc\u30d1\u30fc.io 2\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u307e\u305a\u30a2\u30d7\u30ea\u30b9\u30c8\u30a2\u304b\u3089\u30b2\u30fc\u30e0\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u307e\u3059\u3002\u30b2\u30fc\u30e0\u3092\u958b\u304f\u3068\u3001\u30e6\u30fc\u30b6\u30fc\u540d\u3092\u9078\u629e\u3059\u308b\u3088\u3046\u6c42\u3081\u3089\u308c\u307e\u3059\u3002\u30b2\u30fc\u30e0\u5185\u3067\u306f\u3001\u6307\u3067\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u52d5\u304b\u3057\u305f\u3044\u65b9\u5411\u306b\u30b9\u30ef\u30a4\u30d7\u3057\u307e\u3059\u3002\u76ee\u6a19\u306f\u3001\u30de\u30c3\u30d7\u3092\u79fb\u52d5\u3057\u3066\u30eb\u30fc\u30d7\u3092\u9589\u3058\u308b\u3053\u3068\u3067\u9818\u571f\u3092\u4e3b\u5f35\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6b63\u65b9\u5f62\u306b\u79fb\u52d5\u3057\u3066\u51fa\u767a\u70b9\u306b\u623b\u308b\u3068\u3001\u305d\u306e\u6b63\u65b9\u5f62\u5185\u306e\u9818\u57df\u304c\u3042\u306a\u305f\u306e\u9818\u571f\u306b\u306a\u308a\u307e\u3059\u3002\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30c8\u30ec\u30a4\u30eb\u3092\u907f\u3051\u3066\u3001\u6392\u9664\u3055\u308c\u308b\u306e\u3092\u9632\u304e\u307e\u3059\u3002"}, {"question": "\u30da\u30fc\u30d1\u30fc.io 2\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3068\u305d\u308c\u3089\u306e\u52d5\u4f5c\u65b9\u6cd5\u306f\uff1f", "answer": "\u30da\u30fc\u30d1\u30fc.io 2\u306e\u57fa\u672c\u64cd\u4f5c\u306f\u3001\u753b\u9762\u3092\u30b9\u30ef\u30a4\u30d7\u3057\u3066\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u79fb\u52d5\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u5de6\u3001\u53f3\u3001\u4e0a\u3001\u307e\u305f\u306f\u4e0b\u306b\u30b9\u30ef\u30a4\u30d7\u3057\u3066\u65b9\u5411\u3092\u5909\u3048\u307e\u3059\u3002\u9818\u571f\u3092\u4e3b\u5f35\u3059\u308b\u306b\u306f\u3001\u9589\u3058\u305f\u30eb\u30fc\u30d7\u3092\u4f5c\u6210\u3059\u308b\u3088\u3046\u306a\u65b9\u6cd5\u3067\u79fb\u52d5\u3057\u307e\u3059\u3002\u305d\u306e\u30eb\u30fc\u30d7\u5185\u306e\u9818\u57df\u306f\u3042\u306a\u305f\u306e\u9818\u571f\u306b\u306a\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5186\u3092\u79fb\u52d5\u3057\u3066\u51fa\u767a\u70b9\u306b\u623b\u308b\u3068\u3001\u56f2\u307e\u308c\u305f\u9818\u57df\u304c\u3042\u306a\u305f\u306e\u3082\u306e\u306b\u306a\u308a\u307e\u3059\u3002\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30c8\u30ec\u30a4\u30eb\u306b\u89e6\u308c\u308b\u3068\u6392\u9664\u3055\u308c\u308b\u306e\u3067\u3001\u6ce8\u610f\u304c\u5fc5\u8981\u3067\u3059\u3002"}, {"question": "\u30da\u30fc\u30d1\u30fc.io 2\u3067\u4f55\u5ea6\u3082\u6392\u9664\u3055\u308c\u3066\u3044\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "\u30da\u30fc\u30d1\u30fc.io 2\u3067\u4f55\u5ea6\u3082\u6392\u9664\u3055\u308c\u3066\u3044\u308b\u306e\u306f\u3001\u304a\u305d\u3089\u304f\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30c8\u30ec\u30a4\u30eb\u306b\u3076\u3064\u304b\u308b\u305f\u3081\u3067\u3059\u3002\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30c8\u30ec\u30a4\u30eb\u306b\u89e6\u308c\u308b\u3068\u3001\u6392\u9664\u3055\u308c\u307e\u3059\u3002\u3053\u308c\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u306f\u3001\u81ea\u5206\u306e\u9818\u571f\u5185\u306b\u7559\u307e\u308a\u3001\u62e1\u5927\u3059\u308b\u3068\u304d\u306f\u6ce8\u610f\u304c\u5fc5\u8981\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u8d64\u3044\u30c8\u30ec\u30a4\u30eb\u304c\u8fd1\u3065\u3044\u3066\u304d\u305f\u3089\u3001\u3059\u3050\u306b\u65b9\u5411\u3092\u5909\u3048\u3066\u907f\u3051\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u307e\u305f\u3001\u660e\u78ba\u306a\u7d4c\u8def\u304c\u306a\u3044\u3068\u9818\u571f\u304b\u3089\u96e2\u308c\u3059\u304e\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u30da\u30fc\u30d1\u30fc.io 2\u306e\u9818\u571f\u62e1\u5927\u6226\u7565\u3092\u3069\u306e\u3088\u3046\u306b\u6539\u5584\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30da\u30fc\u30d1\u30fc.io 2\u306e\u9818\u571f\u62e1\u5927\u6226\u7565\u3092\u6539\u5584\u3059\u308b\u306b\u306f\u3001\u8a08\u753b\u7684\u3067\u5b9f\u884c\u529b\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u307e\u305a\u3001\u51fa\u767a\u70b9\u306b\u8fd1\u3044\u5c0f\u3055\u306a\u30a8\u30ea\u30a2\u3092\u78ba\u4fdd\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5f90\u3005\u306b\u5916\u5074\u306b\u62e1\u5927\u3057\u3001\u9818\u571f\u306b\u623b\u308b\u660e\u78ba\u306a\u7d4c\u8def\u3092\u78ba\u4fdd\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5927\u304d\u306a\u30ea\u30b9\u30af\u306e\u3042\u308b\u62e1\u5927\u3092\u8a66\u307f\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u5c0f\u3055\u306a\u30a8\u30ea\u30a2\u3092\u4e3b\u5f35\u3059\u308b\u305f\u3081\u306b\u77ed\u3044\u30eb\u30fc\u30d7\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5de8\u5927\u306a\u9577\u65b9\u5f62\u3092\u4e3b\u5f35\u3057\u3088\u3046\u3068\u3059\u308b\u4ee3\u308f\u308a\u306b\u3001\u9589\u3058\u3084\u3059\u304f\u9632\u5fa1\u3057\u3084\u3059\u3044\u5c0f\u3055\u306a\u6b63\u65b9\u5f62\u3092\u3044\u304f\u3064\u3082\u4f5c\u308a\u307e\u3059\u3002"}, {"question": "\u30da\u30fc\u30d1\u30fc.io 2\u306e\u6700\u9ad8\u306e\u9632\u5fa1\u6226\u8853\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30da\u30fc\u30d1\u30fc.io 2\u306e\u6700\u9ad8\u306e\u9632\u5fa1\u6226\u8853\u306b\u306f\u3001\u9818\u571f\u5185\u306b\u7559\u307e\u308a\u3001\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u52d5\u304d\u306b\u6ce8\u610f\u3059\u308b\u3053\u3068\u306a\u3069\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5e38\u306b\u30de\u30c3\u30d7\u3092\u6ce8\u610f\u6df1\u304f\u898b\u3066\u3001\u8fd1\u3065\u3044\u3066\u304f\u308b\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u63a2\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u8fd1\u304f\u306b\u3044\u305f\u3089\u3001\u9818\u571f\u306e\u4e2d\u306b\u9000\u3044\u3066\u3001\u5f7c\u3089\u304c\u901a\u308a\u904e\u304e\u308b\u306e\u3092\u5f85\u3061\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u653b\u6483\u8005\u3092\u6df7\u4e71\u3055\u305b\u308b\u305f\u3081\u306b\u3001\u7d20\u65e9\u304f\u4e88\u6e2c\u3067\u304d\u306a\u3044\u52d5\u304d\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u3042\u306a\u305f\u3092\u8ffd\u3044\u304b\u3051\u3066\u304d\u305f\u3089\u3001\u7a81\u7136\u65b9\u5411\u8ee2\u63db\u3057\u3066\u5f7c\u3089\u3092\u60d1\u308f\u305b\u3001\u305d\u306e\u5f8c\u3059\u3050\u306b\u5b89\u5168\u306a\u5834\u6240\u306b\u623b\u308a\u307e\u3059\u3002"}, {"question": "\u30da\u30fc\u30d1\u30fc.io 2\u3067\u6642\u9593\u3068\u30ea\u30bd\u30fc\u30b9\u3092\u52b9\u7387\u7684\u306b\u7ba1\u7406\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30da\u30fc\u30d1\u30fc.io 2\u3067\u6642\u9593\u3068\u30ea\u30bd\u30fc\u30b9\u3092\u52b9\u7387\u7684\u306b\u7ba1\u7406\u3059\u308b\u306b\u306f\u3001\u62e1\u5927\u3068\u9632\u5fa1\u306e\u30d0\u30e9\u30f3\u30b9\u3092\u3068\u308b\u3053\u3068\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u7c21\u5358\u306b\u9632\u5fa1\u3067\u304d\u308b\u5c0f\u3055\u306a\u30a8\u30ea\u30a2\u3092\u78ba\u4fdd\u3059\u308b\u305f\u3081\u306b\u6642\u9593\u3092\u5272\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u62e1\u5927\u3057\u3059\u304e\u306a\u3044\u3088\u3046\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u5e38\u306b\u9818\u571f\u306b\u623b\u308b\u660e\u78ba\u306a\u7d4c\u8def\u3092\u78ba\u4fdd\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u8fc5\u901f\u3067\u6226\u7565\u7684\u306a\u52d5\u304d\u3092\u4f7f\u3063\u3066\u6392\u9664\u306e\u30ea\u30b9\u30af\u306a\u3057\u306b\u9818\u571f\u3092\u4e3b\u5f35\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5927\u304d\u306a\u30a8\u30ea\u30a2\u3092\u4e3b\u5f35\u3059\u308b\u3053\u3068\u306b\u591a\u304f\u306e\u6642\u9593\u3092\u8cbb\u3084\u3059\u306e\u3067\u306f\u306a\u304f\u3001\u8fc5\u901f\u306b\u78ba\u4fdd\u3067\u304d\u308b\u3088\u308a\u5c0f\u3055\u306a\u3001\u3088\u308a\u7ba1\u7406\u3057\u3084\u3059\u3044\u30bb\u30af\u30b7\u30e7\u30f3\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002"}, {"question": "\u30da\u30fc\u30d1\u30fc.io 2\u3067\u9818\u571f\u3092\u4e3b\u5f35\u3059\u308b\u80cc\u5f8c\u306b\u3042\u308b\u4e3b\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30da\u30fc\u30d1\u30fc.io 2\u3067\u9818\u571f\u3092\u4e3b\u5f35\u3059\u308b\u80cc\u5f8c\u306b\u3042\u308b\u4e3b\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u9589\u3058\u305f\u30eb\u30fc\u30d7\u3092\u4f5c\u6210\u3059\u308b\u3053\u3068\u3067\u3059\u3002\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u9589\u3058\u305f\u5f62\u306b\u306a\u308b\u3088\u3046\u306b\u52d5\u304b\u3059\u3068\u3001\u305d\u306e\u5f62\u5185\u306e\u9818\u57df\u304c\u3042\u306a\u305f\u306e\u9818\u571f\u306b\u306a\u308a\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306f\u30b0\u30ea\u30c3\u30c9\u30b7\u30b9\u30c6\u30e0\u3092\u4f7f\u7528\u3057\u3066\u3001\u3042\u306a\u305f\u306e\u9818\u571f\u306e\u5883\u754c\u3092\u6c7a\u5b9a\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u6b63\u65b9\u5f62\u306b\u79fb\u52d5\u3057\u3066\u51fa\u767a\u70b9\u306b\u623b\u308b\u3068\u3001\u305d\u306e\u6b63\u65b9\u5f62\u5185\u306e\u30b0\u30ea\u30c3\u30c9\u306e\u30de\u30b9\u76ee\u304c\u4e3b\u5f35\u3055\u308c\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30eb\u30fc\u30d7\u3092\u52b9\u7387\u7684\u306b\u4f5c\u6210\u3067\u304d\u308b\u307b\u3069\u3001\u4e3b\u5f35\u3067\u304d\u308b\u9818\u571f\u304c\u5897\u3048\u307e\u3059\u3002"}, {"question": "\u30da\u30fc\u30d1\u30fc.io 2\u306e\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306e\u4ed5\u7d44\u307f\u306f\uff1f", "answer": "\u30da\u30fc\u30d1\u30fc.io 2\u306e\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u4e3b\u5f35\u3057\u305f\u9818\u571f\u306e\u91cf\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u4e3b\u5f35\u3059\u308b\u305d\u308c\u305e\u308c\u306e\u30b0\u30ea\u30c3\u30c9\u306e\u30de\u30b9\u76ee\u306f\u3001\u3042\u306a\u305f\u306e\u30b9\u30b3\u30a2\u306b\u52a0\u7b97\u3055\u308c\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30c8\u30ec\u30a4\u30eb\u306b\u89e6\u308c\u3066\u6392\u9664\u3059\u308b\u3053\u3068\u3082\u3001\u3042\u306a\u305f\u306e\u30b9\u30b3\u30a2\u306b\u52a0\u7b97\u3055\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u300110\u00d710\u306e\u30a8\u30ea\u30a2\u3092\u4e3b\u5f35\u3059\u308c\u3070\u3001\u30b9\u30b3\u30a2\u306b100\u30dd\u30a4\u30f3\u30c8\u52a0\u7b97\u3055\u308c\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306b\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u30b9\u30b3\u30a2\u306b\u57fa\u3065\u3044\u3066\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u30e9\u30f3\u30af\u4ed8\u3051\u3059\u308b\u30ea\u30fc\u30c0\u30fc\u30dc\u30fc\u30c9\u3082\u3042\u308a\u307e\u3059\u3002\u7af6\u4e89\u3068\u6226\u7565\u7684\u30d7\u30ec\u30a4\u3092\u4fc3\u9032\u3057\u307e\u3059\u3002"}, {"question": "\u8907\u6570\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u30da\u30fc\u30d1\u30fc.io 2\u3092\u30d7\u30ec\u30a4\u3057\u3066\u3001\u9032\u884c\u72b6\u6cc1\u3092\u540c\u671f\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u73fe\u5728\u3001\u30da\u30fc\u30d1\u30fc.io 2\u3067\u306f\u3001\u8907\u6570\u306e\u30c7\u30d0\u30a4\u30b9\u9593\u306e\u9032\u884c\u72b6\u6cc1\u306e\u540c\u671f\u306f\u30b5\u30dd\u30fc\u30c8\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002\u5404\u30c7\u30d0\u30a4\u30b9\u306f\u3001\u72ec\u81ea\u306e\u30b2\u30fc\u30e0\u30c7\u30fc\u30bf\u3092\u6301\u3064\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30b9\u30de\u30fc\u30c8\u30d5\u30a9\u30f3\u3067\u30d7\u30ec\u30a4\u3057\u3066\u304b\u3089\u30bf\u30d6\u30ec\u30c3\u30c8\u306b\u5207\u308a\u66ff\u3048\u308b\u3068\u3001\u30bf\u30d6\u30ec\u30c3\u30c8\u3067\u306f\u6700\u521d\u304b\u3089\u30d7\u30ec\u30a4\u3059\u308b\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002\u305f\u3060\u3057\u3001\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u3067\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u4f7f\u7528\u3057\u3066\u3001\u624b\u52d5\u3067\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u3053\u3068\u306f\u3067\u304d\u307e\u3059\u3002\u305f\u3060\u3057\u3001\u3053\u308c\u306f\u8ffd\u52a0\u306e\u624b\u9806\u3092\u5fc5\u8981\u3068\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u3001\u516c\u5f0f\u306b\u306f\u30b5\u30dd\u30fc\u30c8\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002"}, {"question": "\u30da\u30fc\u30d1\u30fc.io 2\u306b\u306f\u3001\u96a0\u308c\u305f\u9054\u6210\u5ea6\u3084\u79d8\u5bc6\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30da\u30fc\u30d1\u30fc.io 2\u306b\u306f\u3001\u7279\u5b9a\u306e\u884c\u52d5\u3092\u5b9f\u884c\u3059\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u308b\u3001\u3044\u304f\u3064\u304b\u306e\u96a0\u308c\u305f\u9054\u6210\u5ea6\u3068\u79d8\u5bc6\u304c\u3042\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u30011\u3064\u306e\u30b2\u30fc\u30e0\u3067\u30de\u30c3\u30d7\u306e\u7279\u5b9a\u306e\u30d1\u30fc\u30bb\u30f3\u30c6\u30fc\u30b8\u3092\u4e3b\u5f35\u3059\u308b\u305f\u3081\u306e\u9054\u6210\u5ea6\u304c\u3042\u308a\u307e\u3059\u3002\u3082\u30461\u3064\u306e\u79d8\u5bc6\u306f\u3001\u9818\u571f\u3092\u4e3b\u5f35\u3059\u308b\u305f\u3081\u306b\u7279\u5b9a\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u4f7f\u3046\u3053\u3068\u3067\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u30e6\u30cb\u30fc\u30af\u306a\u30b9\u30ad\u30f3\u3084\u30dc\u30fc\u30ca\u30b9\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3055\u307e\u3056\u307e\u306a\u6226\u7565\u3092\u63a2\u6c42\u3057\u3001\u52d5\u304d\u306e\u5b9f\u9a13\u3092\u884c\u3046\u3053\u3068\u3067\u3001\u3053\u308c\u3089\u306e\u96a0\u308c\u305f\u8981\u7d20\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}]
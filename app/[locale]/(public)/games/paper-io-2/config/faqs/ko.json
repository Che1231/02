[{"question": "\ucd08\ubcf4\uc790\uac00 \ud398\uc774\ud37c.io 2\ub97c \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud398\uc774\ud37c.io 2\ub97c \uc2dc\uc791\ud558\ub824\uba74 \uba3c\uc800 \uc571 \uc2a4\ud1a0\uc5b4\uc5d0\uc11c \uac8c\uc784\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uc2ed\uc2dc\uc624. \uac8c\uc784\uc744 \uc5f4\uba74 \uc0ac\uc6a9\uc790 \uc774\ub984\uc744 \uc120\ud0dd\ud558\ub77c\ub294 \uba54\uc2dc\uc9c0\uac00 \ud45c\uc2dc\ub429\ub2c8\ub2e4. \uac8c\uc784\uc5d0 \ub4e4\uc5b4\uac00\uba74 \uc190\uac00\ub77d\uc73c\ub85c \uc6d0\ud558\ub294 \ubc29\ud5a5\uc73c\ub85c \uce90\ub9ad\ud130\ub97c \uc6c0\uc9c1\uc774\ub3c4\ub85d \uc4f8\uc5b4\uc8fc\uc138\uc694. \ubaa9\ud45c\ub294 \ub9f5\uc744 \ub3cc\uc544\ub2e4\ub2c8\uba74\uc11c \ub8e8\ud504\ub97c \ub2eb\uc544 \uc601\ud1a0\ub97c \ud655\ubcf4\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc815\uc0ac\uac01\ud615\uc73c\ub85c \uc6c0\uc9c1\uc5ec \ucd9c\ubc1c\uc810\uc73c\ub85c \ub3cc\uc544\uc624\uba74 \uadf8 \uc0ac\uac01\ud615 \ub0b4\ubd80\uc758 \uc601\uc5ed\uc774 \uc790\uc2e0\uc758 \uc601\ud1a0\uac00 \ub429\ub2c8\ub2e4. \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uc758 \uacbd\ub85c\ub97c \ud53c\ud558\uc5ec \uc81c\uac70\ub418\ub294 \uac83\uc744 \ubc29\uc9c0\ud558\uc138\uc694."}, {"question": "\ud398\uc774\ud37c.io 2\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc740 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "\ud398\uc774\ud37c.io 2\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc740 \ud654\uba74\uc744 \uc4f8\uc5b4\uc11c \uce90\ub9ad\ud130\ub97c \uc774\ub3d9\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc67c\ucabd, \uc624\ub978\ucabd, \uc704 \ub610\ub294 \uc544\ub798\ub85c \uc4f8\uc5b4\uc11c \ubc29\ud5a5\uc744 \ubc14\uafb8\uc138\uc694. \uc601\ud1a0\ub97c \ud655\ubcf4\ud558\ub824\uba74 \ub2eb\ud78c \ub8e8\ud504\ub97c \ub9cc\ub4dc\ub294 \ubc29\uc2dd\uc73c\ub85c \uc6c0\uc9c1\uc774\uc2ed\uc2dc\uc624. \uadf8 \ub8e8\ud504 \uc548\uc758 \uc601\uc5ed\uc774 \uadc0\ud558\uc758 \uc601\ud1a0\uac00 \ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc6d0\uc744 \uadf8\ub9ac\uba70 \ucd9c\ubc1c\uc810\uc73c\ub85c \ub3cc\uc544\uc624\uba74 \uadf8 \uc548\uc758 \uc601\uc5ed\uc774 \uadc0\ud558\uc758 \uc601\ud1a0\uac00 \ub429\ub2c8\ub2e4. \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uc758 \uacbd\ub85c\ub97c \ub9cc\uc9c0\uba74 \uc81c\uac70\ub418\ubbc0\ub85c \uc8fc\uc758\ud558\uc138\uc694."}, {"question": "\ud398\uc774\ud37c.io 2\uc5d0\uc11c \uacc4\uc18d\ud574\uc11c \uc81c\uac70\ub418\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud398\uc774\ud37c.io 2\uc5d0\uc11c \uacc4\uc18d\ud574\uc11c \uc81c\uac70\ub418\ub294 \uc774\uc720\ub294 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uc758 \uacbd\ub85c\ub97c \uac74\ub4dc\ub9ac\uae30 \ub54c\ubb38\uc77c \uac00\ub2a5\uc131\uc774 \ub192\uc2b5\ub2c8\ub2e4. \uce90\ub9ad\ud130\uac00 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uc758 \uacbd\ub85c\uc5d0 \ub2ff\uc73c\uba74 \uc81c\uac70\ub429\ub2c8\ub2e4. \uc774\ub97c \ubc29\uc9c0\ud558\ub824\uba74 \uc790\uc2e0\uc758 \uc601\ud1a0 \ub0b4\uc5d0 \uba38\ubb34\ub974\uace0 \ud655\uc7a5\ud560 \ub54c \uc8fc\uc758\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \ube68\uac04 \uacbd\ub85c\uac00 \ub2e4\uac00\uc624\ub294 \uac83\uc744 \ubcf4\uba74 \ubc29\ud5a5\uc744 \ubc14\uafb8\uc5b4 \ud53c\ud558\uc138\uc694. \ub610\ud55c \uba85\ud655\ud55c \ubcf5\uadc0 \uacbd\ub85c \uc5c6\uc774 \uc601\ud1a0\uc5d0\uc11c \ub108\ubb34 \uba40\ub9ac \ub098\uac00\uc9c0 \ub9c8\uc138\uc694."}, {"question": "\ud398\uc774\ud37c.io 2\uc5d0\uc11c \uc601\ud1a0 \ud655\uc7a5 \uc804\ub7b5\uc744 \uc5b4\ub5bb\uac8c \uac1c\uc120\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud398\uc774\ud37c.io 2\uc5d0\uc11c \uc601\ud1a0 \ud655\uc7a5 \uc804\ub7b5\uc744 \uac1c\uc120\ud558\ub824\uba74 \uc2e0\uc911\ud55c \uacc4\ud68d\uacfc \uc2e4\ud589\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc2dc\uc791 \uc9c0\uc810 \uadfc\ucc98\uc758 \uc791\uc740 \uc601\uc5ed\uc744 \ud655\ubcf4\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \uc11c\uc11c\ud788 \uc678\ubd80\ub85c \ud655\uc7a5\ud558\uc5ec \uc601\ud1a0\ub85c \ub3cc\uc544\uac08 \uc218 \uc788\ub294 \uba85\ud655\ud55c \uacbd\ub85c\ub97c \ud655\ubcf4\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \uc704\ud5d8\ud55c \ub300\uaddc\ubaa8 \ud655\uc7a5 \uc2dc\ub3c4 \ub300\uc2e0 \ube60\ub974\uace0 \uc9e7\uc740 \ub8e8\ud504\ub85c \uc791\uc740 \uc601\uc5ed\uc744 \ud655\ubcf4\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uac70\ub300\ud55c \uc0ac\uac01\ud615\uc744 \ud655\ubcf4\ud558\ub824\uace0 \ud558\uae30\ubcf4\ub2e4\ub294 \ub2eb\uace0 \ubc29\uc5b4\ud558\uae30 \uc26c\uc6b4 \uc791\uc740 \uc815\uc0ac\uac01\ud615\uc744 \ub9cc\ub4dc\uc138\uc694."}, {"question": "\ud398\uc774\ud37c.io 2\uc5d0\uc11c \uac00\uc7a5 \uc88b\uc740 \ubc29\uc5b4 \uc804\uc220\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud398\uc774\ud37c.io 2\uc5d0\uc11c \uac00\uc7a5 \uc88b\uc740 \ubc29\uc5b4 \uc804\uc220\uc740 \uc601\ud1a0 \ub0b4\uc5d0 \uba38\ubb34\ub974\uace0 \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uc758 \uc6c0\uc9c1\uc784\uc5d0 \uc8fc\uc758\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \ub2e8\uacc4 1: \ud56d\uc0c1 \ub9f5\uc5d0\uc11c \ub2e4\uac00\uc624\ub294 \ud50c\ub808\uc774\uc5b4\ub97c \uc0b4\ud3b4\ubcf4\uc138\uc694. \ub2e8\uacc4 2: \ud50c\ub808\uc774\uc5b4\uac00 \uac00\uae4c\uc774 \uc788\uc73c\uba74 \uc601\ud1a0\ub85c \ud6c4\ud1f4\ud558\uace0 \uadf8\ub4e4\uc774 \uc9c0\ub098\uac00\ub3c4\ub85d \uae30\ub2e4\ub9ac\uc138\uc694. \ub2e8\uacc4 3: \uacf5\uaca9\uc790\ub97c \ub2f9\ud669\uc2dc\ud0a4\uae30 \uc704\ud574 \ube60\ub974\uace0 \uc608\uce21\ud560 \uc218 \uc5c6\ub294 \uc6c0\uc9c1\uc784\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud50c\ub808\uc774\uc5b4\uac00 \ub2f9\uc2e0\uc744 \ucd94\uaca9\ud558\uba74 \uac11\uc791\uc2a4\ub7ec\uc6b4 \ud68c\uc804\uc744 \ud558\uc5ec \uadf8\ub4e4\uc744 \ud63c\ub780\uc2a4\ub7fd\uac8c \ud55c \ub2e4\uc74c \uc548\uc804\ud55c \uc9c0\uc5ed\uc73c\ub85c \ube60\ub974\uac8c \ub3cc\uc544\uac00\uc138\uc694."}, {"question": "\ud398\uc774\ud37c.io 2\uc5d0\uc11c \uc2dc\uac04\uacfc \uc790\uc6d0\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud398\uc774\ud37c.io 2\uc5d0\uc11c \uc2dc\uac04\uacfc \uc790\uc6d0\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \uad00\ub9ac\ud558\ub824\uba74 \ud655\uc7a5\uacfc \ubc29\uc5b4\ub97c \uade0\ud615 \uc788\uac8c \uc720\uc9c0\ud574\uc57c \ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc27d\uac8c \ubc29\uc5b4\ud560 \uc218 \uc788\ub294 \uc791\uc740 \uc601\uc5ed\uc744 \ud655\ubcf4\ud558\ub294 \ub370 \uc2dc\uac04\uc744 \ud560\ub2f9\ud558\uc138\uc694. \ub2e8\uacc4 2: \uacfc\ub3c4\ud558\uac8c \ud655\uc7a5\ud558\uc9c0 \ub9c8\uc2ed\uc2dc\uc624. \ud56d\uc0c1 \uc601\ud1a0\ub85c \ub3cc\uc544\uac08 \uc218 \uc788\ub294 \uba85\ud655\ud55c \uacbd\ub85c\ub97c \uc720\uc9c0\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \ube60\ub974\uace0 \uc804\ub7b5\uc801\uc778 \uc6c0\uc9c1\uc784\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc81c\uac70 \uc704\ud5d8 \uc5c6\uc774 \uc601\ud1a0\ub97c \ud655\ubcf4\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uac70\ub300\ud55c \uc601\uc5ed\uc744 \ud655\ubcf4\ud558\ub824\uace0 \uc624\ub79c \uc2dc\uac04\uc744 \ubcf4\ub0b4\ub294 \ub300\uc2e0, \uc2e0\uc18d\ud558\uac8c \ud655\ubcf4\ud560 \uc218 \uc788\ub294 \uaddc\ubaa8\uac00 \uc801\uc808\ud55c \uc791\uc740 \uad6c\uc5ed\uc5d0 \uc9d1\uc911\ud558\uc138\uc694."}, {"question": "\ud398\uc774\ud37c.io 2\uc5d0\uc11c \uc601\ud1a0 \ud655\ubcf4\uc758 \ud575\uc2ec \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud398\uc774\ud37c.io 2\uc5d0\uc11c \uc601\ud1a0 \ud655\ubcf4\uc758 \ud575\uc2ec \uba54\ucee4\ub2c8\uc998\uc740 \ub2eb\ud78c \ub8e8\ud504\ub97c \ub9cc\ub4dc\ub294 \uac83\uc785\ub2c8\ub2e4. \uce90\ub9ad\ud130\ub97c \uc6c0\uc9c1\uc5ec \ub2eb\ud78c \ubaa8\uc591\uc744 \ub9cc\ub4e4\uba74 \uadf8 \ubaa8\uc591 \ub0b4\ubd80\uc758 \uc601\uc5ed\uc774 \uadc0\ud558\uc758 \uc601\ud1a0\uac00 \ub429\ub2c8\ub2e4. \uac8c\uc784\uc740 \uadf8\ub9ac\ub4dc \uc2dc\uc2a4\ud15c\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc601\ud1a0\uc758 \uacbd\uacc4\ub97c \uacb0\uc815\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc815\uc0ac\uac01\ud615\uc73c\ub85c \uc6c0\uc9c1\uc5ec \ucd9c\ubc1c\uc810\uc73c\ub85c \ub3cc\uc544\uc624\uba74 \uadf8 \uc0ac\uac01\ud615 \uc548\uc758 \uadf8\ub9ac\ub4dc \uce78\uc774 \ud655\ubcf4\ub429\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ub8e8\ud504\ub97c \uc5bc\ub9c8\ub098 \ud6a8\uc728\uc801\uc73c\ub85c \ub9cc\ub4e4 \uc218 \uc788\ub294\uc9c0\uc5d0 \ub530\ub77c \uc5bc\ub9c8\ub098 \ub9ce\uc740 \uc601\ud1a0\ub97c \ud655\ubcf4\ud560 \uc218 \uc788\ub294\uc9c0\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4."}, {"question": "\ud398\uc774\ud37c.io 2\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "\ud398\uc774\ud37c.io 2\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ud655\ubcf4\ud55c \uc601\ud1a0\uc758 \uc591\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uac01 \uadf8\ub9ac\ub4dc \uce78\uc744 \ud655\ubcf4\ud560 \ub54c\ub9c8\ub2e4 \uc810\uc218\uac00 \ucd94\uac00\ub429\ub2c8\ub2e4. \ub610\ud55c \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uc758 \uacbd\ub85c\uc5d0 \ub2ff\uc544 \uc81c\uac70\ud558\uba74 \uc810\uc218\uac00 \ucd94\uac00\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 10x10 \uc601\uc5ed\uc744 \ud655\ubcf4\ud558\uba74 \uc810\uc218\uac00 100\uc810 \ucd94\uac00\ub429\ub2c8\ub2e4. \uac8c\uc784\uc5d0\ub294 \ud50c\ub808\uc774\uc5b4\uc758 \uc810\uc218\ub97c \uae30\uc900\uc73c\ub85c \uc21c\uc704\ub97c \ub9e4\uae30\ub294 \ub9ac\ub354\ubcf4\ub4dc\uac00 \uc788\uc5b4 \uacbd\uc7c1\uacfc \uc804\ub7b5\uc801\uc778 \uac8c\uc784\uc744 \uc7a5\ub824\ud569\ub2c8\ub2e4."}, {"question": "\uc5ec\ub7ec \uae30\uae30\uc5d0\uc11c \ud398\uc774\ud37c.io 2\ub97c \ud50c\ub808\uc774\ud558\uace0 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud604\uc7ac \ud398\uc774\ud37c.io 2\ub294 \uc5ec\ub7ec \uae30\uae30 \uac04 \uc9c4\ud589 \uc0c1\ud669 \ub3d9\uae30\ud654\ub97c \uc9c0\uc6d0\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uac01 \uae30\uae30\ub294 \uc790\uccb4 \uac8c\uc784 \ub370\uc774\ud130\ub97c \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud734\ub300\ud3f0\uc5d0\uc11c \ud50c\ub808\uc774\ud55c \ud6c4 \ud0dc\ube14\ub9bf\uc73c\ub85c \uc804\ud658\ud558\uba74 \ud0dc\ube14\ub9bf\uc5d0\uc11c \ucc98\uc74c\ubd80\ud130 \uc2dc\uc791\ud569\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \ub3d9\uc77c\ud55c \uacc4\uc815\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub450 \uae30\uae30\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \uc218\ub3d9\uc73c\ub85c \uc804\uc1a1\ud560 \uc218 \uc788\uc9c0\ub9cc \uc774\ub7ec\ud55c \uc791\uc5c5\uc774 \uacf5\uc2dd\uc801\uc73c\ub85c \uc9c0\uc6d0\ub418\uc9c0\ub294 \uc54a\uc2b5\ub2c8\ub2e4."}, {"question": "\ud398\uc774\ud37c.io 2\uc5d0 \uc228\uaca8\uc9c4 \uc131\ucde8\ub3c4\ub098 \ube44\ubc00\uc774 \uc788\ub098\uc694?", "answer": "\ub124, \ud398\uc774\ud37c.io 2\uc5d0\ub294 \ud2b9\uc815 \uc791\uc5c5\uc744 \uc218\ud589\ud558\uc5ec \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc131\ucde8\ub3c4\uc640 \ube44\ubc00\uc774 \uc5ec\ub7ec \uac00\uc9c0 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud55c \uac8c\uc784\uc5d0\uc11c \ub9f5\uc758 \ud2b9\uc815 \ube44\uc728\uc744 \ud655\ubcf4\ud558\ub294 \uc131\ucde8\ub3c4\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \ube44\ubc00\uc740 \ud2b9\uc815 \ud328\ud134\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc601\ud1a0\ub97c \ud655\ubcf4\ud558\ub294 \uac83\uc73c\ub85c, \uace0\uc720\ud55c \uc2a4\ud0a8\uc774\ub098 \ubcf4\ub108\uc2a4\ub97c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\uc591\ud55c \uc804\ub7b5\uc744 \ud0d0\uc0c9\ud558\uace0 \uc6c0\uc9c1\uc784\uc744 \uc2e4\ud5d8\ud558\uba74 \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \uc694\uc18c\ub97c \ubc1c\uacac\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
[{"question": "\u5982\u4f55\u57f7\u884c\u300aBLEACH vs NARUTO 3.3\u300b\u521d\u5b78\u8005\u7684\u57fa\u672c\u653b\u64ca\u548c\u9023\u62db\uff1f", "answer": "\u5728\u300aBLEACH vs NARUTO 3.3\u300b\u4e2d\uff0c\u57fa\u672c\u653b\u64ca\u4f7f\u7528\u8f15\u653b\u64ca\u6309\u9215 (L) \u57f7\u884c\uff0c\u800c\u9023\u62db\u5247\u5305\u542b\u9023\u9396\u8f15\u653b\u64ca\u548c\u91cd\u653b\u64ca (H)\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u9cf4\u4eba\uff0c\u6309\u4e0b L-L-H \u5c07\u89f8\u767c\u7c21\u55ae\u9023\u62db\u3002\u8981\u7cbe\u901a\u9023\u62db\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1) \u7df4\u7fd2\u57fa\u672c L \u653b\u64ca\uff0c\u4e86\u89e3\u6642\u6a5f\u3002\u6b65\u9a5f2) \u52a0\u5165 H \u653b\u64ca\u4ee5\u5ef6\u9577\u9023\u62db\u3002\u6b65\u9a5f3) \u5617\u8a66\u4f7f\u7528\u89d2\u8272\u7279\u5b9a\u62db\u5f0f\uff0c\u4f8b\u5982\u9cf4\u4eba\u7684\u87ba\u65cb\u4e38 (L-L-L-H)\u3002\u8acb\u4f7f\u7528\u8a13\u7df4\u6a21\u5f0f\u4f86\u63d0\u5347\u60a8\u7684\u6280\u5de7\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u9023\u62db\u8996\u70ba\u7a4d\u6728\uff0c\u5f9e\u5c0f\u958b\u59cb\uff0c\u9010\u6b65\u589e\u52a0\u8907\u96dc\u6027\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u5728\u300aBLEACH vs NARUTO 3.3\u300b\u904a\u6232\u4e2d\u4e86\u89e3\u67e5\u514b\u62c9\u7cfb\u7d71\u81f3\u95dc\u91cd\u8981\uff0c\u4ee5\u53ca\u5b83\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u300aBLEACH vs NARUTO 3.3\u300b\u4e2d\u7684\u67e5\u514b\u62c9\u7cfb\u7d71\u638c\u63a7\u7279\u6b8a\u80fd\u529b\u548c\u6700\u7d42\u62db\u5f0f\u3002\u67e5\u514b\u62c9\u900f\u904e\u653b\u64ca\u8457\u9678\u6216\u683c\u64cb\u4f86\u88dc\u5145\u3002\u4f8b\u5982\uff0c\u9cf4\u4eba\u7684\u87ba\u65cb\u4e38\u9700\u8981\u6d88\u8017 2 \u500b\u67e5\u514b\u62c9\u689d\u3002\u70ba\u512a\u5316\u67e5\u514b\u62c9\u4f7f\u7528\uff1a\u6b65\u9a5f1) \u5728\u6230\u9b25\u4e2d\u76e3\u63a7\u60a8\u7684\u67e5\u514b\u62c9\u689d\u3002\u6b65\u9a5f2) \u4f7f\u7528\u67e5\u514b\u62c9\u4f86\u767c\u52d5\u95dc\u9375\u80fd\u529b\uff0c\u4f8b\u5982\u4e00\u8b77\u7684\u6708\u7259\u5929\u885d\u3002\u6b65\u9a5f3) \u5728\u95dc\u9375\u6642\u523b\u5132\u5b58\u67e5\u514b\u62c9\u4f86\u4f7f\u7528\u6700\u7d42\u62db\u5f0f\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u67e5\u514b\u62c9\u4f7f\u7528\u91cf\u8207\u5f71\u97ff - \u87ba\u65cb\u4e38\uff1a\u4f4e\u67e5\u514b\u62c9\uff0c\u4e2d\u7b49\u50b7\u5bb3\uff1b\u87ba\u65cb\u4e38\uff1a\u9ad8\u67e5\u514b\u62c9\uff0c\u9ad8\u50b7\u5bb3\u3002]"}, {"question": "\u5728\u300aBLEACH vs NARUTO 3.3\u300b\u4e2d\uff0c\u5982\u4f55\u5c0d\u6297\u7a4d\u6975\u7684\u73a9\u5bb6\uff0c\u6700\u4f73\u7b56\u7565\u70ba\u4f55\uff1f", "answer": "\u5728\u300aBLEACH vs NARUTO 3.3\u300b\u4e2d\uff0c\u5c0d\u6297\u7a4d\u6975\u7684\u73a9\u5bb6\u9700\u8981\u7cbe\u78ba\u7684\u6642\u6a5f\u548c\u9632\u5b88\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u9cf4\u4eba\u7684\u5f71\u5b50\u5206\u8eab\u8853 (R2) \u53ef\u4ee5\u5275\u9020\u6a5f\u6703\u3002\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1) \u683c\u64cb\u4e26\u7b49\u5f85\u6a5f\u6703\u3002\u6b65\u9a5f2) \u4f7f\u7528\u53cd\u64ca\u624b\u6bb5\uff0c\u4f8b\u5982\u4e00\u8b77\u7684\u77ac\u6b65 (R1)\u3002\u6b65\u9a5f3) \u4ee5\u9ad8\u50b7\u5bb3\u9023\u62db\u53cd\u64ca\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u683c\u64cb\u8207\u53cd\u64ca - \u683c\u64cb\u8f03\u5b89\u5168\uff0c\u4f46\u56de\u5831\u8f03\u4f4e\uff1b\u53cd\u64ca\u98a8\u96aa\u8f03\u9ad8\uff0c\u4f46\u53ef\u4ee5\u626d\u8f49\u5c40\u52e2\u3002]"}, {"question": "\u300aBLEACH vs NARUTO 3.3\u300b\u4e2d\u7684\u50b7\u5bb3\u63d0\u5347\u6a5f\u5236\u5982\u4f55\u904b\u4f5c\uff0c\u4ee5\u53ca\u70ba\u4ec0\u9ebc\u5b83\u5f88\u91cd\u8981\uff1f", "answer": "\u300aBLEACH vs NARUTO 3.3\u300b\u4e2d\u7684\u50b7\u5bb3\u63d0\u5347\u6a5f\u5236\u6703\u964d\u4f4e\u9023\u7e8c\u9023\u62db\u7684\u50b7\u5bb3\uff0c\u4ee5\u7dad\u6301\u5e73\u8861\u3002\u4f8b\u5982\uff0c\u5982\u679c\u9cf4\u4eba\u7684 L-L-L-H \u9023\u62db\u4e4b\u524d\u6709\u5176\u4ed6\u591a\u6b21\u653b\u64ca\uff0c\u5247\u50b7\u5bb3\u6703\u6e1b\u5c11\u3002\u6b64\u6a5f\u5236\u53ef\u4ee5\u907f\u514d\u904e\u5f37\u7684\u9023\u62db\uff0c\u4e26\u9f13\u52f5\u7b56\u7565\u6027\u7684\u904a\u6232\u73a9\u6cd5\u3002\u4e86\u89e3\u63d0\u5347\u6a5f\u5236\u6709\u52a9\u65bc\u512a\u5316\u9023\u62db\u6548\u7387\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u50b7\u5bb3\u63d0\u5347\u6a5f\u5236\u8996\u70ba\u8abf\u5149\u958b\u95dc\uff1b\u9023\u62db\u6642\u9593\u8d8a\u9577\uff0c\u50b7\u5bb3\u8f38\u51fa\u8d8a\u4f4e\u3002]"}, {"question": "\u5728\u300aBLEACH vs NARUTO 3.3\u300b\u7684\u5718\u968a\u6230\u9b25\u4e2d\uff0c\u54ea\u4e9b\u89d2\u8272\u5177\u6709\u6700\u9ad8\u7684\u5354\u540c\u4f5c\u7528\uff0c\u4ee5\u53ca\u539f\u56e0\u70ba\u4f55\uff1f", "answer": "\u5728\u300aBLEACH vs NARUTO 3.3\u300b\u4e2d\uff0c\u9cf4\u4eba\u548c\u4f50\u52a9\u7531\u65bc\u4e92\u88dc\u7684\u80fd\u529b\u800c\u5177\u6709\u9ad8\u5354\u540c\u4f5c\u7528\u3002\u9cf4\u4eba\u7684\u87ba\u65cb\u4e38\u70ba\u4f50\u52a9\u7684\u5343\u9ce5\u5275\u9020\u4e86\u6bc0\u6ec5\u6027\u7684\u9023\u62db\u6a5f\u6703\u3002\u540c\u6a23\u5730\uff0c\u4e00\u8b77\u548c\u9732\u742a\u4e9e\u7684\u914d\u5408\u4e5f\u76f8\u7576\u826f\u597d\uff0c\u4e00\u8b77\u7684\u8fd1\u6230\u653b\u64ca\u548c\u9732\u742a\u4e9e\u7684\u9060\u7a0b\u51b0\u7cfb\u9b54\u6cd5\u76f8\u5f97\u76ca\u5f70\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u89d2\u8272\u5354\u540c\u4f5c\u7528 - \u9cf4\u4eba+\u4f50\u52a9\uff1a\u9ad8\u50b7\u5bb3\u3001\u9ad8\u9023\u62db\u6f5b\u529b\uff1b\u4e00\u8b77+\u9732\u742a\u4e9e\uff1a\u5e73\u8861\u7684\u653b\u64ca\u548c\u9632\u5b88\u3002]"}, {"question": "\u5982\u4f55\u5728\u300aBLEACH vs NARUTO 3.3\u300b\u4e2d\u89e3\u9396\u96b1\u85cf\u89d2\u8272\uff0c\u4ee5\u53ca\u4ed6\u5011\u7684\u7368\u7279\u80fd\u529b\u70ba\u4f55\uff1f", "answer": "\u300aBLEACH vs NARUTO 3.3\u300b\u4e2d\u7684\u96b1\u85cf\u89d2\u8272\uff0c\u4f8b\u5982\u534d\u89e3\u4e00\u8b77\uff0c\u662f\u900f\u904e\u5b8c\u6210\u7279\u5b9a\u6311\u6230\u800c\u89e3\u9396\u7684\u3002\u4f8b\u5982\uff0c\u5728\u8857\u6a5f\u6a21\u5f0f\u4e2d\u64ca\u6557 100 \u500b\u5c0d\u624b\u53ef\u4ee5\u89e3\u9396\u534d\u89e3\u4e00\u8b77\uff0c\u4ed6\u64c1\u6709\u66f4\u9ad8\u7684\u901f\u5ea6\u548c\u529b\u91cf\u3002\u4ed6\u7684\u6708\u7259\u5929\u885d\u9020\u6210\u7684\u50b7\u5bb3\u66f4\u5927\uff0c\u7bc4\u570d\u4e5f\u66f4\u5ee3\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u89e3\u9396\u65b9\u6cd5 - \u8857\u6a5f\u6a21\u5f0f\uff1a\u8017\u6642\u4f46\u6709\u56de\u5831\uff1b\u6545\u4e8b\u6a21\u5f0f\uff1a\u5287\u60c5\u5c0e\u5411\uff0c\u4f46\u6548\u7387\u8f03\u4f4e\u3002]"}, {"question": "\u5728\u300aBLEACH vs NARUTO 3.3\u300b\u4e2d\uff0cBLEACH \u548c NARUTO \u89d2\u8272\u9663\u5bb9\u4e4b\u9593\u7684\u4e3b\u8981\u5dee\u7570\u70ba\u4f55\uff1f", "answer": "\u300aBLEACH vs NARUTO 3.3\u300b\u4e2d\u7684 BLEACH \u89d2\u8272\u9663\u5bb9\u5074\u91cd\u65bc\u8fd1\u6230\u548c\u901f\u5ea6\uff0c\u4f8b\u5982\u4e00\u8b77\u5728\u8fd1\u8eab\u6230\u9b25\u4e2d\u8868\u73fe\u51fa\u8272\u3002NARUTO \u89d2\u8272\u9663\u5bb9\u5074\u91cd\u65bc\u591a\u529f\u80fd\u6027\uff0c\u4f8b\u5982\u9cf4\u4eba\u5e73\u8861\u4e86\u8fd1\u6230\u548c\u9060\u7a0b\u653b\u64ca\u3002\u4f8b\u5982\uff0c\u4e00\u8b77\u7684\u6708\u7259\u5929\u885d\u662f\u8fd1\u8ddd\u96e2\u65ac\u64ca\uff0c\u800c\u9cf4\u4eba\u7684\u87ba\u65cb\u4e38\u662f\u9060\u7a0b\u6295\u5c04\u7269\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1aBLEACH vs NARUTO - BLEACH\uff1a\u9ad8\u901f\u5ea6\uff0c\u8fd1\u6230\u91cd\u9ede\uff1bNARUTO\uff1a\u5e73\u8861\uff0c\u591a\u529f\u80fd\u3002]"}, {"question": "\u300aBLEACH vs NARUTO 3.3\u300b\u7684\u8de8\u5e73\u53f0\u76f8\u5bb9\u6027\u5982\u4f55\u904b\u4f5c\uff0c\u6211\u662f\u5426\u53ef\u4ee5\u8f49\u79fb\u6211\u7684\u9032\u5ea6\uff1f", "answer": "\u300aBLEACH vs NARUTO 3.3\u300b\u652f\u63f4 PC \u548c\u4e3b\u6a5f\u4e4b\u9593\u7684\u8de8\u5e73\u53f0\u904a\u6232\uff0c\u4f46\u9032\u5ea6\u8f49\u79fb\u53d6\u6c7a\u65bc\u5e73\u53f0\u3002\u4f8b\u5982\uff0cSteam \u5b58\u6a94\u53ef\u4ee5\u4f7f\u7528\u96f2\u7aef\u540c\u6b65\u8f49\u79fb\u5230 PS4\u3002\u8acb\u78ba\u4fdd\u60a8\u7684\u5e33\u6236\u9023\u7d50\uff0c\u4e26\u9075\u5faa\u7279\u5b9a\u5e73\u53f0\u7684\u8cc7\u6599\u9077\u79fb\u8aaa\u660e\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u8de8\u5e73\u53f0\u6d41\u7a0b - \u9023\u7d50\u5e33\u6236 \u2192 \u540c\u6b65\u8cc7\u6599 \u2192 \u9a57\u8b49\u9032\u5ea6 \u2192 \u5728\u4e0d\u540c\u5e73\u53f0\u904a\u6232\u3002]"}, {"question": "\u300aBLEACH vs NARUTO 3.3\u300b\u4e2d\u7684\u79d8\u5bc6\u5f69\u86cb\u662f\u4ec0\u9ebc\uff0c\u6211\u5982\u4f55\u627e\u5230\u5b83\u5011\uff1f", "answer": "\u300aBLEACH vs NARUTO 3.3\u300b\u5305\u542b\u5f69\u86cb\uff0c\u4f8b\u5982\u96b1\u85cf\u5c0d\u8a71\u548c\u7279\u6b8a\u62db\u5f0f\u3002\u4f8b\u5982\uff0c\u5728\u5c0d\u6230\u6a21\u5f0f\u4e2d\u626e\u6f14\u9cf4\u4eba\u548c\u4e00\u8b77\u6703\u89f8\u767c\u5f15\u7528\u4ed6\u5011\u4e4b\u9593\u7af6\u722d\u95dc\u4fc2\u7684\u7368\u7279\u5c0d\u8a71\u3002\u8981\u767c\u73fe\u9019\u4e9b\u5f69\u86cb\uff0c\u8acb\u63a2\u7d22\u6240\u6709\u904a\u6232\u6a21\u5f0f\uff0c\u4e26\u5617\u8a66\u4e0d\u540c\u7684\u89d2\u8272\u7d44\u5408\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c0b\u627e\u5f69\u86cb\u5c31\u50cf\u5c0b\u5bf6\uff1b\u8010\u5fc3\u548c\u597d\u5947\u5fc3\u662f\u95dc\u9375\u3002]"}, {"question": "\u5982\u4f55\u512a\u5316\u6211\u7684\u63a7\u5236\u5668\u8a2d\u5b9a\uff0c\u4ee5\u4fbf\u5728\u300aBLEACH vs NARUTO 3.3\u300b\u4e2d\u7372\u5f97\u66f4\u597d\u7684\u6548\u80fd\uff1f", "answer": "\u5728\u300aBLEACH vs NARUTO 3.3\u300b\u4e2d\u512a\u5316\u63a7\u5236\u5668\u8a2d\u5b9a\u6d89\u53ca\u8abf\u6574\u654f\u611f\u5ea6\u548c\u6309\u9215\u6620\u5c04\u3002\u4f8b\u5982\uff0c\u5c07\u91cd\u653b\u64ca\u6620\u5c04\u5230\u6273\u6a5f\u6309\u9215 (R2) \u53ef\u4ee5\u6539\u5584\u9023\u62db\u57f7\u884c\u3002\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1) \u8abf\u6574\u654f\u611f\u5ea6\u4ee5\u7372\u5f97\u7cbe\u78ba\u7684\u8f38\u5165\u3002\u6b65\u9a5f2) \u5c07\u6309\u9215\u6620\u5c04\u5230\u9069\u5408\u60a8\u7684\u904a\u6232\u98a8\u683c\u3002\u6b65\u9a5f3) \u5728\u8a13\u7df4\u6a21\u5f0f\u4e2d\u6e2c\u8a66\u8a2d\u5b9a\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u9810\u8a2d\u8a2d\u5b9a\u8207\u81ea\u5b9a\u7fa9\u8a2d\u5b9a - \u9810\u8a2d\uff1a\u5bb9\u6613\u4f7f\u7528\u4f46\u6548\u7387\u8f03\u4f4e\uff1b\u81ea\u5b9a\u7fa9\uff1a\u91cf\u8eab\u5b9a\u88fd\uff0c\u4f46\u9700\u8981\u8abf\u6574\u3002]"}]
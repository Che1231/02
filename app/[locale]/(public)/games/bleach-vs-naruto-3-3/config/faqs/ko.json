[{"question": "\ucd08\ubcf4\uc790\ub97c \uc704\ud55c \ube14\ub9ac\uce58 \ub300 \ub098\ub8e8\ud1a0 3.3\uc5d0\uc11c \uae30\ubcf8 \uacf5\uaca9 \ubc0f \ucf64\ubcf4 \uc5f0\ucd9c \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ube14\ub9ac\uce58 \ub300 \ub098\ub8e8\ud1a0 3.3\uc5d0\uc11c \uae30\ubcf8 \uacf5\uaca9\uc740 \uc88c\uce21 \uc2a4\ud2f1 \uc785\ub825(L)\uc73c\ub85c \uc218\ud589\ub418\uace0, \ucf64\ubcf4\ub294 \uc88c\uce21 \uc2a4\ud2f1(L)\uacfc \uac15\ub825 \uacf5\uaca9(H)\uc744 \uc870\ud569\ud558\uc5ec \uc5f0\uacb0\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub098\ub8e8\ud1a0 \uce90\ub9ad\ud130\uc758 \uacbd\uc6b0 L-L-H\ub97c \uc785\ub825\ud558\uba74 \uac04\ub2e8\ud55c \ucf64\ubcf4\uac00 \ubc1c\ub3d9\ub429\ub2c8\ub2e4. \ucf64\ubcf4\ub97c \ub9c8\uc2a4\ud130\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1) \ud0c0\uc774\ubc0d\uc744 \uc774\ud574\ud558\uae30 \uc704\ud574 \uae30\ubcf8 L \uacf5\uaca9 \uc5f0\uc2b5\uc744 \ud569\ub2c8\ub2e4. STEP2) \ucf64\ubcf4\ub97c \ub298\ub9ac\uae30 \uc704\ud574 H \uacf5\uaca9\uc744 \ucd94\uac00\ud569\ub2c8\ub2e4. STEP3) \ub098\ub8e8\ud1a0\uc758 \ub77c\uc13c\uc288\ub9ac\ucf04(L-L-L-H)\uacfc \uac19\uc740 \uce90\ub9ad\ud130 \ud2b9\uc815 \uae30\uc220\uc744 \uc2dc\ub3c4\ud569\ub2c8\ub2e4. \uc5f0\uc2b5 \ubaa8\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \uae30\uc220\uc744 \uc5f0\ub9c8\ud558\uc138\uc694. [\ube44\uc720 \uc124\uba85: \ucf64\ubcf4\ub294 \ube14\ub85d\uc744 \uc313\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc791\uc740 \ube14\ub85d\ubd80\ud130 \uc2dc\uc791\ud558\uc5ec \uc810\ucc28 \ubcf5\uc7a1\uc131\uc744 \ub192\uc5ec\ub098\uac00\uc138\uc694.]"}, {"question": "\ube14\ub9ac\uce58 \ub300 \ub098\ub8e8\ud1a0 3.3\uc5d0\uc11c \ucc28\ud06c\ub77c \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\uc640 \uc791\ub3d9 \ubc29\uc2dd\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ube14\ub9ac\uce58 \ub300 \ub098\ub8e8\ud1a0 3.3\uc5d0\uc11c \ucc28\ud06c\ub77c \uc2dc\uc2a4\ud15c\uc740 \ud2b9\uc218 \ub2a5\ub825\uacfc \ucd5c\uc885 \uae30\uc220\uc744 \uc81c\uc5b4\ud569\ub2c8\ub2e4. \ucc28\ud06c\ub77c\ub294 \uacf5\uaca9\uc774\ub098 \ub9c9\uae30\uc5d0 \uc131\uacf5\ud558\uba74 \ud68c\ubcf5\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub098\ub8e8\ud1a0\uc758 \ub77c\uc13c\uc288\ub9ac\ucf04\uc740 2\uac1c\uc758 \ucc28\ud06c\ub77c \ubc14\ub97c \uc18c\ubaa8\ud569\ub2c8\ub2e4. \ucc28\ud06c\ub77c \uc0ac\uc6a9\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1) \uc804\ud22c \uc911 \ucc28\ud06c\ub77c \ubc14\ub97c \uc9c0\uc18d\uc801\uc73c\ub85c \ud655\uc778\ud569\ub2c8\ub2e4. STEP2) \uc774\uce58\uace0\uc758 \uac9f\uc2a4\uac00 \ud150\uc1fc\uc640 \uac19\uc740 \ud575\uc2ec \ub2a5\ub825\uc5d0 \ucc28\ud06c\ub77c\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. STEP3) \uc704\uae09\ud55c \uc21c\uac04 \ucd5c\uc885 \uae30\uc220\uc5d0 \ucc28\ud06c\ub77c\ub97c \ube44\ucd95\ud569\ub2c8\ub2e4. [\ud45c \uc124\uba85: \ucc28\ud06c\ub77c \uc0ac\uc6a9\ub7c9 \ub300\ube44 \uc601\ud5a5 - \ub77c\uc13c\uc548: \ucc28\ud06c\ub77c \uc18c\ubaa8\ub7c9 \uc801\uc74c, \ud53c\ud574\ub7c9 \uc911\uac04; \ub77c\uc13c\uc288\ub9ac\ucf04: \ucc28\ud06c\ub77c \uc18c\ubaa8\ub7c9 \ub9ce\uc74c, \ud53c\ud574\ub7c9 \ub192\uc74c.]"}, {"question": "\ube14\ub9ac\uce58 \ub300 \ub098\ub8e8\ud1a0 3.3\uc5d0\uc11c \uacf5\uaca9\uc801\uc778 \ud50c\ub808\uc774\uc5b4\ub97c \uc0c1\ub300\ud558\ub294 \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ube14\ub9ac\uce58 \ub300 \ub098\ub8e8\ud1a0 3.3\uc5d0\uc11c \uacf5\uaca9\uc801\uc778 \ud50c\ub808\uc774\uc5b4\ub97c \uc0c1\ub300\ud558\ub824\uba74 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uacfc \ubc29\uc5b4 \uc804\uc220\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub098\ub8e8\ud1a0\uc758 \uadf8\ub9bc\uc790 \ubd84\uc2e0\uc220(R2)\uc744 \uc0ac\uc6a9\ud558\uba74 \uacf5\uaca9\uc758 \ud2c8\uc744 \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1) \ub9c9\uace0 \uc801\uc808\ud55c \ud0c0\uc774\ubc0d\uc744 \uae30\ub2e4\ub9bd\ub2c8\ub2e4. STEP2) \uc774\uce58\uace0\uc758 \ud50c\ub798\uc2dc \uc2a4\ud15d(R1)\uacfc \uac19\uc740 \ubc18\uaca9 \uae30\uc220\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4. STEP3) \ub192\uc740 \ud53c\ud574\ub7c9\uc758 \ucf64\ubcf4\ub85c \uacf5\uaca9\ud569\ub2c8\ub2e4. [\ube44\uad50 \uc124\uba85: \ub9c9\uae30 vs \ubc18\uaca9 - \ub9c9\uae30\ub294 \ub354 \uc548\uc804\ud558\uc9c0\ub9cc \ubcf4\uc0c1\uc740 \uc801\uc2b5\ub2c8\ub2e4.  \ubc18\uaca9\uc740 \uc704\ud5d8\ud558\uc9c0\ub9cc \uc0c1\ud669\uc744 \uc5ed\uc804\uc2dc\ud0ac \uc218 \uc788\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ube14\ub9ac\uce58 \ub300 \ub098\ub8e8\ud1a0 3.3\uc5d0\uc11c \ud53c\ud574\ub7c9 \uc99d\uac00 \uba54\ucee4\ub2c8\uc998\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uc65c \uc911\uc694\ud569\ub2c8\uae4c?", "answer": "\ube14\ub9ac\uce58 \ub300 \ub098\ub8e8\ud1a0 3.3\uc758 \ud53c\ud574\ub7c9 \uc99d\uac00 \uba54\ucee4\ub2c8\uc998\uc740 \uc5f0\uc18d\uc801\uc778 \ucf64\ubcf4\uc758 \ud53c\ud574\ub7c9\uc744 \uc904\uc5ec \uade0\ud615\uc744 \uc720\uc9c0\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub098\ub8e8\ud1a0\uc758 L-L-L-H \ucf64\ubcf4\ub294 \uc5ec\ub7ec \uacf5\uaca9\uc5d0 \uc774\uc5b4\uc9c4 \uacbd\uc6b0 \ud53c\ud574\ub7c9\uc774 \uc904\uc5b4\ub4ed\ub2c8\ub2e4. \uc774 \uba54\ucee4\ub2c8\uc998\uc740 \uacfc\ud55c \ucf64\ubcf4\ub97c \ubc29\uc9c0\ud558\uace0 \uc804\ub7b5\uc801\uc778 \ud50c\ub808\uc774\ub97c \uc7a5\ub824\ud569\ub2c8\ub2e4. \uc99d\uac00 \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud558\uba74 \ucf64\ubcf4 \ud6a8\uc728\uc131\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud53c\ud574\ub7c9 \uc99d\uac00\ub294 \uc5b4\ub450\uc6c0\uc744 \uc870\uc808\ud558\ub294 \ub2e4\uc774\uba38 \uc2a4\uc704\uce58\uc640 \uac19\uc2b5\ub2c8\ub2e4. \ucf64\ubcf4\uac00 \uae38\uc5b4\uc9c8\uc218\ub85d \ud53c\ud574\ub7c9\uc740 \ub0ae\uc544\uc9d1\ub2c8\ub2e4.]"}, {"question": "\ube14\ub9ac\uce58 \ub300 \ub098\ub8e8\ud1a0 3.3\uc5d0\uc11c \ud300 \uc804\ud22c\uc5d0\uc11c \uc2dc\ub108\uc9c0 \ud6a8\uacfc\uac00 \uac00\uc7a5 \ub192\uc740 \uce90\ub9ad\ud130\ub294 \ub204\uad6c\uc774\uba70, \uadf8 \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ube14\ub9ac\uce58 \ub300 \ub098\ub8e8\ud1a0 3.3\uc5d0\uc11c \ub098\ub8e8\ud1a0\uc640 \uc0ac\uc2a4\ucf00\ub294 \uc0c1\ud638 \ubcf4\uc644\uc801\uc778 \ub2a5\ub825\uc73c\ub85c \uc778\ud574 \ub192\uc740 \uc2dc\ub108\uc9c0 \ud6a8\uacfc\ub97c \ubcf4\uc785\ub2c8\ub2e4. \ub098\ub8e8\ud1a0\uc758 \ub77c\uc13c\uc548\uc740 \uc0ac\uc2a4\ucf00\uc758 \uce58\ub3c4\ub9ac\ub97c \uc704\ud55c \uc900\ube44\ub97c \ud558\uc5ec \ud30c\uad34\uc801\uc778 \ucf64\ubcf4\ub97c \ub9cc\ub4ed\ub2c8\ub2e4. \ub9c8\ucc2c\uac00\uc9c0\ub85c \uc774\uce58\uace0\uc640 \ub8e8\ud0a4\uc544\ub294 \uc774\uce58\uace0\uc758 \uadfc\uc811 \uacf5\uaca9\uacfc \ub8e8\ud0a4\uc544\uc758 \uc6d0\uac70\ub9ac \uc5bc\uc74c \ub9c8\ubc95\uc73c\ub85c \uc798 \uc870\ud654\ub429\ub2c8\ub2e4. [\ud45c \uc124\uba85: \uce90\ub9ad\ud130 \uc2dc\ub108\uc9c0 - \ub098\ub8e8\ud1a0+\uc0ac\uc2a4\ucf00: \ub192\uc740 \ud53c\ud574\ub7c9, \ub192\uc740 \ucf64\ubcf4 \uac00\ub2a5\uc131; \uc774\uce58\uace0+\ub8e8\ud0a4\uc544: \uade0\ud615 \uc7a1\ud78c \uacf5\uaca9\uacfc \ubc29\uc5b4.]"}, {"question": "\ube14\ub9ac\uce58 \ub300 \ub098\ub8e8\ud1a0 3.3\uc5d0\uc11c \uc228\uaca8\uc9c4 \uce90\ub9ad\ud130\ub97c \uc5b4\ub5bb\uac8c \ud574\uc81c\ud560 \uc218 \uc788\uc73c\uba70, \uadf8\ub4e4\uc758 \uace0\uc720\ud55c \ub2a5\ub825\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ube14\ub9ac\uce58 \ub300 \ub098\ub8e8\ud1a0 3.3\uc758 \uc228\uaca8\uc9c4 \uce90\ub9ad\ud130(\uc608: \ubc18\uce74\uc774 \uc774\uce58\uace0)\ub294 \ud2b9\uc815 \ucc4c\ub9b0\uc9c0(\uc608: \uc544\ucf00\uc774\ub4dc \ubaa8\ub4dc\uc5d0\uc11c 100\uba85\uc758 \uc0c1\ub300\ubc29\uc744 \ubb3c\ub9ac\uce58\uae30)\ub97c \uc644\ub8cc\ud558\uc5ec \ud574\uc81c\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc544\ucf00\uc774\ub4dc \ubaa8\ub4dc\uc5d0\uc11c 100\uba85\uc758 \uc0c1\ub300\ubc29\uc744 \ubb3c\ub9ac\uce58\uba74 \ubc18\uce74\uc774 \uc774\uce58\uace0\ub97c \ud574\uc81c\ud558\uace0, \ubc18\uce74\uc774 \uc774\uce58\uace0\ub294 \uc18d\ub3c4\uc640 \ud30c\uc6cc\uac00 \ud5a5\uc0c1\ub41c \ub2a5\ub825\uc744 \ubcf4\uc720\ud569\ub2c8\ub2e4. \uadf8\uc758 \uac9f\uc2a4\uac00 \ud150\uc1fc\ub294 \ub354 \ub192\uc740 \ud53c\ud574\ub7c9\uacfc \ub354 \ub113\uc740 \uc0ac\uc815\uac70\ub9ac\ub97c \uac00\uc9d1\ub2c8\ub2e4. [\ube44\uad50 \uc124\uba85: \ud574\uc81c \ubc29\ubc95 - \uc544\ucf00\uc774\ub4dc \ubaa8\ub4dc: \uc2dc\uac04\uc774 \uc624\ub798 \uac78\ub9ac\uc9c0\ub9cc \ubcf4\ub78c\uc774 \uc788\uc2b5\ub2c8\ub2e4; \uc2a4\ud1a0\ub9ac \ubaa8\ub4dc: \uc774\uc57c\uae30 \uc911\uc2ec\uc774\uc9c0\ub9cc \ud6a8\uc728\uc774 \ub0ae\uc2b5\ub2c8\ub2e4.]"}, {"question": "\ube14\ub9ac\uce58 \ub300 \ub098\ub8e8\ud1a0 3.3\uc5d0\uc11c \ube14\ub9ac\uce58\uc640 \ub098\ub8e8\ud1a0 \uce90\ub9ad\ud130 \ubaa9\ub85d\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ube14\ub9ac\uce58 \ub300 \ub098\ub8e8\ud1a0 3.3\uc758 \ube14\ub9ac\uce58 \uce90\ub9ad\ud130 \ubaa9\ub85d\uc740 \uc774\uce58\uace0\uc640 \uac19\uc740 \uce90\ub9ad\ud130\uac00 \uadfc\uc811 \uc804\ud22c\uc5d0\uc11c \ub6f0\uc5b4\ub098 \uc18d\ub3c4\uc640 \uadfc\uc811 \uc804\ud22c\uc5d0 \ucd08\uc810\uc744 \ub9de\ucda5\ub2c8\ub2e4. \ub098\ub8e8\ud1a0 \uce90\ub9ad\ud130 \ubaa9\ub85d\uc740 \ub098\ub8e8\ud1a0\uc640 \uac19\uc774 \uadfc\uc811 \ubc0f \uc6d0\uac70\ub9ac \uacf5\uaca9\uc744 \uc870\ud654\uc2dc\ud0a4\ub294 \ub2e4\uc7ac\ub2e4\ub2a5\ud568\uc5d0 \ucd08\uc810\uc744 \ub9de\ucda5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc774\uce58\uace0\uc758 \uac9f\uc2a4\uac00 \ud150\uc1fc\ub294 \uadfc\uc811 \uacf5\uaca9\uc774\uace0, \ub098\ub8e8\ud1a0\uc758 \ub77c\uc13c\uc288\ub9ac\ucf04\uc740 \uc6d0\uac70\ub9ac \uacf5\uaca9\uc785\ub2c8\ub2e4. [\ud45c \uc124\uba85: \ube14\ub9ac\uce58 \ub300 \ub098\ub8e8\ud1a0 - \ube14\ub9ac\uce58: \ube60\ub978 \uc18d\ub3c4, \uadfc\uc811 \uc804\ud22c \uc911\uc2ec; \ub098\ub8e8\ud1a0: \uade0\ud615 \uc7a1\ud78c \ub2e4\uc7ac\ub2e4\ub2a5\ud568.]"}, {"question": "\ube14\ub9ac\uce58 \ub300 \ub098\ub8e8\ud1a0 3.3\uc5d0\uc11c \ud50c\ub7ab\ud3fc \uac04 \ud638\ud658\uc131\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ube14\ub9ac\uce58 \ub300 \ub098\ub8e8\ud1a0 3.3\ub294 PC\uc640 \ucf58\uc194 \uac04\uc758 \ud50c\ub7ab\ud3fc \uac04 \ud50c\ub808\uc774\ub97c \uc9c0\uc6d0\ud558\uc9c0\ub9cc, \uc9c4\ud589 \uc0c1\ud669 \uc774\uc804\uc740 \ud50c\ub7ab\ud3fc\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc2a4\ud300 \uc800\uc7a5 \ub370\uc774\ud130\ub97c \ud074\ub77c\uc6b0\ub4dc \ub3d9\uae30\ud654\ub97c \ud1b5\ud574 PS4\ub85c \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uacc4\uc815\uc744 \uc5f0\uacb0\ud558\uace0 \ud50c\ub7ab\ud3fc\ubcc4 \ub370\uc774\ud130 \ub9c8\uc774\uadf8\ub808\uc774\uc158 \uc9c0\uce68\uc744 \ub530\ub974\uc138\uc694. [\ub3c4\uc2dd \uc124\uba85: \ud50c\ub7ab\ud3fc \uac04 \ud504\ub85c\uc138\uc2a4 - \uacc4\uc815 \uc5f0\uacb0 \u2192 \ub370\uc774\ud130 \ub3d9\uae30\ud654 \u2192 \uc9c4\ud589 \uc0c1\ud669 \ud655\uc778 \u2192 \uc5ec\ub7ec \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ud50c\ub808\uc774.]"}, {"question": "\ube14\ub9ac\uce58 \ub300 \ub098\ub8e8\ud1a0 3.3\uc758 \ube44\ubc00 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ube14\ub9ac\uce58 \ub300 \ub098\ub8e8\ud1a0 3.3\uc5d0\ub294 \uc228\uaca8\uc9c4 \ub300\ud654\uc640 \ud2b9\uc218 \uae30\uc220\uacfc \uac19\uc740 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub300\uacb0 \ubaa8\ub4dc\uc5d0\uc11c \ub098\ub8e8\ud1a0\uc640 \uc774\uce58\uace0 \uce90\ub9ad\ud130\ub85c \ud50c\ub808\uc774\ud558\uba74 \uadf8\ub4e4\uc758 \ub77c\uc774\ubc8c \uad00\uacc4\ub97c \uc5b8\uae09\ud558\ub294 \ub3c5\ud2b9\ud55c \ub300\ud654\uac00 \ub098\uc635\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc694\uc18c\ub97c \ubc1c\uacac\ud558\ub824\uba74 \ubaa8\ub4e0 \uac8c\uc784 \ubaa8\ub4dc\ub97c \ud0d0\uc0c9\ud558\uace0 \uce90\ub9ad\ud130 \uc870\ud569\uc744 \uc2dc\ub3c4\ud574 \ubcf4\uc138\uc694. [\ube44\uc720 \uc124\uba85: \uc774\uc2a4\ud130 \uc5d0\uadf8 \ucc3e\uae30\ub294 \ubcf4\ubb3c\ucc3e\uae30\uc640 \uac19\uc2b5\ub2c8\ub2e4. \uc778\ub0b4\uc640 \ud638\uae30\uc2ec\uc774 \uc911\uc694\ud569\ub2c8\ub2e4.]"}, {"question": "\ube14\ub9ac\uce58 \ub300 \ub098\ub8e8\ud1a0 3.3\uc5d0\uc11c \ucee8\ud2b8\ub864\ub7ec \uc124\uc815\uc744 \ucd5c\uc801\ud654\ud558\uc5ec \uc131\ub2a5\uc744 \uac1c\uc120\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ube14\ub9ac\uce58 \ub300 \ub098\ub8e8\ud1a0 3.3\uc5d0\uc11c \ucee8\ud2b8\ub864\ub7ec \uc124\uc815\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \ubbfc\uac10\ub3c4 \ubc0f \ubc84\ud2bc \ub9e4\ud551\uc744 \uc870\uc815\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac15\ub825 \uacf5\uaca9\uc744 \ud2b8\ub9ac\uac70 \ubc84\ud2bc(R2)\uc5d0 \ub9e4\ud551\ud558\uba74 \ucf64\ubcf4 \uc2e4\ud589\uc774 \ud5a5\uc0c1\ub429\ub2c8\ub2e4. \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1) \uc815\ud655\ud55c \uc785\ub825\uc744 \uc704\ud574 \ubbfc\uac10\ub3c4\ub97c \uc870\uc815\ud569\ub2c8\ub2e4. STEP2) \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\uac8c \ubc84\ud2bc\uc744 \ub9e4\ud551\ud569\ub2c8\ub2e4. STEP3) \uc5f0\uc2b5 \ubaa8\ub4dc\uc5d0\uc11c \uc124\uc815\uc744 \ud14c\uc2a4\ud2b8\ud569\ub2c8\ub2e4. [\ube44\uad50 \uc124\uba85: \uae30\ubcf8 \uc124\uc815\uacfc \uc0ac\uc6a9\uc790 \uc124\uc815 - \uae30\ubcf8 \uc124\uc815: \uc0ac\uc6a9\ud558\uae30 \uc27d\uc9c0\ub9cc \ud6a8\uc728\uc774 \ub0ae\uc2b5\ub2c8\ub2e4. \uc0ac\uc6a9\uc790 \uc124\uc815: \ub9de\ucda4\ud615\uc774\uc9c0\ub9cc \uc870\uc815\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.]"}]
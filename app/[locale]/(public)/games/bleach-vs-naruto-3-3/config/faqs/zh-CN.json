[{"question": "\u5982\u4f55\u8fdb\u884c\u300a\u6b7b\u795e vs \u9e23\u4eba3.3\u300b\u521d\u5b66\u8005\u57fa\u7840\u653b\u51fb\u548c\u8fde\u62db\uff1f", "answer": "\u5728\u300a\u6b7b\u795e vs \u9e23\u4eba3.3\u300b\u4e2d\uff0c\u57fa\u7840\u653b\u51fb\u662f\u4f7f\u7528\u8f7b\u653b\u51fb\u952e\uff08L\uff09\u6267\u884c\u7684\uff0c\u800c\u8fde\u62db\u5219\u9700\u8981\u8fde\u9501\u8f7b\u653b\u51fb\uff08L\uff09\u548c\u91cd\u653b\u51fb\uff08H\uff09\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u9e23\u4eba\uff0c\u6309\u4e0bL-L-H\u53ef\u4ee5\u89e6\u53d1\u7b80\u5355\u7684\u8fde\u62db\u3002\u8981\u638c\u63e1\u8fde\u62db\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41\uff09\u7ec3\u4e60\u57fa\u672cL\u653b\u51fb\uff0c\u4e86\u89e3\u8282\u594f\u3002\u6b65\u9aa42\uff09\u6dfb\u52a0H\u653b\u51fb\u4ee5\u5ef6\u957f\u8fde\u62db\u3002\u6b65\u9aa43\uff09\u5c1d\u8bd5\u4f7f\u7528\u89d2\u8272\u7279\u5b9a\u52a8\u4f5c\uff0c\u4f8b\u5982\u9e23\u4eba\u7684\u87ba\u65cb\u4e38\uff08L-L-L-H\uff09\u3002\u4f7f\u7528\u8bad\u7ec3\u6a21\u5f0f\u6765\u63d0\u5347\u4f60\u7684\u6280\u80fd\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u8fde\u62db\u60f3\u8c61\u6210\u79ef\u6728\uff0c\u4ece\u5c0f\u5f00\u59cb\u9010\u6e10\u589e\u52a0\u590d\u6742\u6027\u3002]"}, {"question": "\u5728\u300a\u6b7b\u795e vs \u9e23\u4eba3.3\u300b\u4e2d\uff0c\u4e3a\u4ec0\u4e48\u7406\u89e3\u67e5\u514b\u62c9\u7cfb\u7edf\u81f3\u5173\u91cd\u8981\uff0c\u4ee5\u53ca\u5b83\u5982\u4f55\u8fd0\u4f5c\uff1f", "answer": "\u300a\u6b7b\u795e vs \u9e23\u4eba3.3\u300b\u4e2d\u7684\u67e5\u514b\u62c9\u7cfb\u7edf\u63a7\u5236\u7740\u7279\u6b8a\u80fd\u529b\u548c\u6700\u7ec8\u62db\u5f0f\u3002\u67e5\u514b\u62c9\u53ef\u4ee5\u901a\u8fc7\u653b\u51fb\u547d\u4e2d\u6216\u683c\u6321\u6765\u6062\u590d\u3002\u4f8b\u5982\uff0c\u9e23\u4eba\u7684\u87ba\u65cb\u624b\u91cc\u5251\u9700\u8981\u6d88\u80172\u4e2a\u67e5\u514b\u62c9\u6761\u3002\u4e3a\u4e86\u4f18\u5316\u67e5\u514b\u62c9\u7684\u4f7f\u7528\uff1a\u6b65\u9aa41\uff09\u5728\u6218\u6597\u4e2d\u76d1\u63a7\u4f60\u7684\u67e5\u514b\u62c9\u6761\u3002\u6b65\u9aa42\uff09\u4f7f\u7528\u67e5\u514b\u62c9\u6765\u6267\u884c\u5173\u952e\u80fd\u529b\uff0c\u4f8b\u5982\u4e00\u62a4\u7684\u6708\u65a9\u3002\u6b65\u9aa43\uff09\u5728\u5173\u952e\u65f6\u523b\u4fdd\u5b58\u67e5\u514b\u62c9\u7528\u4e8e\u6700\u7ec8\u62db\u5f0f\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u67e5\u514b\u62c9\u4f7f\u7528\u7387\u4e0e\u5f71\u54cd - \u87ba\u65cb\u4e38\uff1a\u4f4e\u67e5\u514b\u62c9\uff0c\u4e2d\u7b49\u4f24\u5bb3\uff1b\u87ba\u65cb\u624b\u91cc\u5251\uff1a\u9ad8\u67e5\u514b\u62c9\uff0c\u9ad8\u4f24\u5bb3\u3002]"}, {"question": "\u5728\u300a\u6b7b\u795e vs \u9e23\u4eba3.3\u300b\u4e2d\uff0c\u9488\u5bf9\u5f3a\u653b\u73a9\u5bb6\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u300a\u6b7b\u795e vs \u9e23\u4eba3.3\u300b\u4e2d\uff0c\u5bf9\u6297\u5f3a\u653b\u73a9\u5bb6\u9700\u8981\u7cbe\u786e\u7684\u65f6\u673a\u548c\u9632\u5fa1\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u9e23\u4eba\u7684\u5206\u8eab\u672f\uff08R2\uff09\u53ef\u4ee5\u521b\u9020\u673a\u4f1a\u3002\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff09\u683c\u6321\u5e76\u7b49\u5f85\u673a\u4f1a\u3002\u6b65\u9aa42\uff09\u4f7f\u7528\u53cd\u51fb\u62db\u5f0f\uff0c\u4f8b\u5982\u4e00\u62a4\u7684\u77ac\u6b65\uff08R1\uff09\u3002\u6b65\u9aa43\uff09\u7528\u9ad8\u4f24\u5bb3\u8fde\u62db\u8fdb\u884c\u53cd\u51fb\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u683c\u6321\u4e0e\u53cd\u51fb - \u683c\u6321\u66f4\u5b89\u5168\u4f46\u56de\u62a5\u66f4\u5c11\uff1b\u53cd\u51fb\u98ce\u9669\u66f4\u5927\uff0c\u4f46\u53ef\u4ee5\u626d\u8f6c\u5c40\u9762\u3002]"}, {"question": "\u300a\u6b7b\u795e vs \u9e23\u4eba3.3\u300b\u4e2d\u7684\u4f24\u5bb3\u52a0\u6210\u673a\u5236\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4e3a\u4ec0\u4e48\u5b83\u5f88\u91cd\u8981\uff1f", "answer": "\u300a\u6b7b\u795e vs \u9e23\u4eba3.3\u300b\u4e2d\u7684\u4f24\u5bb3\u52a0\u6210\u673a\u5236\u4f1a\u964d\u4f4e\u6301\u7eed\u8fde\u62db\u7684\u4f24\u5bb3\u4ee5\u4fdd\u6301\u5e73\u8861\u3002\u4f8b\u5982\uff0c\u5982\u679c\u9e23\u4eba\u7684L-L-L-H\u8fde\u62db\u4e4b\u524d\u6709\u591a\u6b21\u653b\u51fb\uff0c\u5219\u4f24\u5bb3\u4f1a\u964d\u4f4e\u3002\u8fd9\u4e2a\u673a\u5236\u53ef\u4ee5\u9632\u6b62\u8fc7\u5f3a\u7684\u8fde\u62db\uff0c\u5e76\u9f13\u52b1\u73a9\u5bb6\u91c7\u53d6\u6218\u7565\u6027\u73a9\u6cd5\u3002\u4e86\u89e3\u52a0\u6210\u673a\u5236\u6709\u52a9\u4e8e\u4f18\u5316\u8fde\u62db\u6548\u7387\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u4f24\u5bb3\u52a0\u6210\u60f3\u8c61\u6210\u8c03\u5149\u5f00\u5173\uff1b\u8fde\u62db\u65f6\u95f4\u8d8a\u957f\uff0c\u4f24\u5bb3\u8f93\u51fa\u8d8a\u4f4e\u3002]"}, {"question": "\u5728\u300a\u6b7b\u795e vs \u9e23\u4eba3.3\u300b\u7684\u56e2\u961f\u6218\u6597\u4e2d\uff0c\u54ea\u4e9b\u89d2\u8272\u7684\u534f\u540c\u4f5c\u7528\u6700\u9ad8\uff0c\u4e3a\u4ec0\u4e48\uff1f", "answer": "\u5728\u300a\u6b7b\u795e vs \u9e23\u4eba3.3\u300b\u4e2d\uff0c\u9e23\u4eba\u548c\u4f50\u52a9\u7531\u4e8e\u4ed6\u4eec\u4e92\u8865\u7684\u80fd\u529b\u800c\u5177\u6709\u5f88\u9ad8\u7684\u534f\u540c\u4f5c\u7528\u3002\u9e23\u4eba\u7684\u87ba\u65cb\u4e38\u4e3a\u4f50\u52a9\u7684\u5343\u9e1f\u521b\u9020\u4e86\u673a\u4f1a\uff0c\u4ea7\u751f\u6bc1\u706d\u6027\u7684\u8fde\u62db\u3002\u540c\u6837\uff0c\u4e00\u62a4\u548c\u673d\u6728\u9732\u742a\u4e9a\u4e5f\u6709\u5f88\u597d\u7684\u7ec4\u5408\uff0c\u4e00\u62a4\u7684\u8fd1\u8eab\u653b\u51fb\u548c\u9732\u742a\u4e9a\u7684\u8fdc\u7a0b\u51b0\u7cfb\u9b54\u6cd5\u76f8\u5f97\u76ca\u5f70\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u89d2\u8272\u534f\u540c\u4f5c\u7528 - \u9e23\u4eba+\u4f50\u52a9\uff1a\u9ad8\u4f24\u5bb3\uff0c\u9ad8\u8fde\u62db\u6f5c\u529b\uff1b\u4e00\u62a4+\u9732\u742a\u4e9a\uff1a\u5e73\u8861\u7684\u653b\u51fb\u4e0e\u9632\u5fa1\u3002]"}, {"question": "\u5982\u4f55\u5728\u300a\u6b7b\u795e vs \u9e23\u4eba3.3\u300b\u4e2d\u89e3\u9501\u9690\u85cf\u89d2\u8272\uff0c\u4ee5\u53ca\u4ed6\u4eec\u7684\u72ec\u7279\u80fd\u529b\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u6b7b\u795e vs \u9e23\u4eba3.3\u300b\u4e2d\u7684\u9690\u85cf\u89d2\u8272\uff0c\u4f8b\u5982\u534d\u89e3\u4e00\u62a4\uff0c\u662f\u901a\u8fc7\u5b8c\u6210\u7279\u5b9a\u6311\u6218\u6765\u89e3\u9501\u7684\u3002\u4f8b\u5982\uff0c\u5728\u8857\u673a\u6a21\u5f0f\u4e2d\u51fb\u8d25100\u4e2a\u5bf9\u624b\u53ef\u4ee5\u89e3\u9501\u534d\u89e3\u4e00\u62a4\uff0c\u4ed6\u62e5\u6709\u66f4\u9ad8\u7684\u901f\u5ea6\u548c\u529b\u91cf\u3002\u4ed6\u7684\u6708\u65a9\u9020\u6210\u7684\u4f24\u5bb3\u66f4\u5927\uff0c\u8303\u56f4\u66f4\u5e7f\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u89e3\u9501\u65b9\u6cd5 - \u8857\u673a\u6a21\u5f0f\uff1a\u8017\u65f6\u4f46\u56de\u62a5\u4e30\u539a\uff1b\u6545\u4e8b\u6a21\u5f0f\uff1a\u4ee5\u53d9\u4e8b\u4e3a\u4e3b\uff0c\u6548\u7387\u8f83\u4f4e\u3002]"}, {"question": "\u5728\u300a\u6b7b\u795e vs \u9e23\u4eba3.3\u300b\u4e2d\uff0c\u6b7b\u795e\u548c\u9e23\u4eba\u89d2\u8272\u9635\u5bb9\u7684\u4e3b\u8981\u533a\u522b\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u6b7b\u795e vs \u9e23\u4eba3.3\u300b\u4e2d\u7684\u6b7b\u795e\u89d2\u8272\u9635\u5bb9\u4fa7\u91cd\u4e8e\u8fd1\u6218\u548c\u901f\u5ea6\uff0c\u50cf\u4e00\u62a4\u8fd9\u6837\u7684\u89d2\u8272\u64c5\u957f\u8fd1\u8eab\u6218\u6597\u3002\u9e23\u4eba\u89d2\u8272\u9635\u5bb9\u5f3a\u8c03\u591a\u529f\u80fd\u6027\uff0c\u5982\u9e23\u4eba\u8fd9\u6837\u7684\u89d2\u8272\u5728\u8fd1\u6218\u548c\u8fdc\u7a0b\u653b\u51fb\u4e4b\u95f4\u53d6\u5f97\u5e73\u8861\u3002\u4f8b\u5982\uff0c\u4e00\u62a4\u7684\u6708\u65a9\u662f\u8fd1\u8ddd\u79bb\u65a9\u51fb\uff0c\u800c\u9e23\u4eba\u7684\u87ba\u65cb\u624b\u91cc\u5251\u662f\u8fdc\u7a0b\u6295\u63b7\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6b7b\u795e vs \u9e23\u4eba - \u6b7b\u795e\uff1a\u9ad8\u901f\u5ea6\uff0c\u8fd1\u6218\uff1b\u9e23\u4eba\uff1a\u5747\u8861\uff0c\u591a\u529f\u80fd\u3002]"}, {"question": "\u300a\u6b7b\u795e vs \u9e23\u4eba3.3\u300b\u4e2d\u7684\u8de8\u5e73\u53f0\u517c\u5bb9\u6027\u5982\u4f55\u8fd0\u4f5c\uff0c\u6211\u53ef\u4ee5\u8f6c\u79fb\u6211\u7684\u8fdb\u5ea6\u5417\uff1f", "answer": "\u300a\u6b7b\u795e vs \u9e23\u4eba3.3\u300b\u652f\u6301PC\u548c\u4e3b\u673a\u4e4b\u95f4\u7684\u8de8\u5e73\u53f0\u6e38\u620f\uff0c\u4f46\u8fdb\u5ea6\u8f6c\u79fb\u53d6\u51b3\u4e8e\u5e73\u53f0\u3002\u4f8b\u5982\uff0cSteam\u5b58\u6863\u53ef\u4ee5\u901a\u8fc7\u4e91\u540c\u6b65\u8f6c\u79fb\u5230PS4\u3002\u786e\u4fdd\u4f60\u7684\u8d26\u6237\u5df2\u94fe\u63a5\uff0c\u5e76\u6309\u7167\u5e73\u53f0\u7684\u7279\u5b9a\u8bf4\u660e\u8fdb\u884c\u6570\u636e\u8fc1\u79fb\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u8de8\u5e73\u53f0\u6d41\u7a0b - \u94fe\u63a5\u8d26\u6237 \u2192 \u540c\u6b65\u6570\u636e \u2192 \u786e\u8ba4\u8fdb\u5ea6 \u2192 \u5728\u4e0d\u540c\u5e73\u53f0\u6e38\u620f\u3002]"}, {"question": "\u300a\u6b7b\u795e vs \u9e23\u4eba3.3\u300b\u4e2d\u7684\u9690\u85cf\u5f69\u86cb\u662f\u4ec0\u4e48\uff0c\u6211\u8be5\u5982\u4f55\u627e\u5230\u5b83\u4eec\uff1f", "answer": "\u300a\u6b7b\u795e vs \u9e23\u4eba3.3\u300b\u5305\u542b\u9690\u85cf\u5f69\u86cb\uff0c\u4f8b\u5982\u9690\u85cf\u5bf9\u8bdd\u548c\u7279\u6b8a\u62db\u5f0f\u3002\u4f8b\u5982\uff0c\u5728\u5bf9\u6218\u6a21\u5f0f\u4e2d\u4f7f\u7528\u9e23\u4eba\u548c\u4e00\u62a4\u7684\u89d2\u8272\uff0c\u4f1a\u89e6\u53d1\u5f15\u7528\u4ed6\u4eec\u4e4b\u95f4\u7ade\u4e89\u7684\u72ec\u7279\u5bf9\u8bdd\u3002\u8981\u53d1\u73b0\u8fd9\u4e9b\u5f69\u86cb\uff0c\u8bf7\u63a2\u7d22\u6240\u6709\u6e38\u620f\u6a21\u5f0f\uff0c\u5e76\u5c1d\u8bd5\u4e0d\u540c\u7684\u89d2\u8272\u7ec4\u5408\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5bfb\u627e\u5f69\u86cb\u5c31\u50cf\u5bfb\u5b9d\uff1b\u8010\u5fc3\u548c\u597d\u5947\u5fc3\u662f\u5173\u952e\u3002]"}, {"question": "\u5982\u4f55\u4f18\u5316\u6211\u7684\u63a7\u5236\u5668\u8bbe\u7f6e\uff0c\u4ee5\u4fbf\u5728\u300a\u6b7b\u795e vs \u9e23\u4eba3.3\u300b\u4e2d\u83b7\u5f97\u66f4\u597d\u7684\u6027\u80fd\uff1f", "answer": "\u5728\u300a\u6b7b\u795e vs \u9e23\u4eba3.3\u300b\u4e2d\u4f18\u5316\u63a7\u5236\u5668\u8bbe\u7f6e\u5305\u62ec\u8c03\u6574\u7075\u654f\u5ea6\u548c\u6309\u952e\u6620\u5c04\u3002\u4f8b\u5982\uff0c\u5c06\u91cd\u653b\u51fb\u6620\u5c04\u5230\u6273\u673a\u952e\uff08R2\uff09\u53ef\u4ee5\u6539\u5584\u8fde\u62db\u6267\u884c\u3002\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff09\u8c03\u6574\u7075\u654f\u5ea6\uff0c\u5b9e\u73b0\u7cbe\u786e\u7684\u8f93\u5165\u3002\u6b65\u9aa42\uff09\u5c06\u6309\u952e\u6620\u5c04\u5230\u9002\u5408\u4f60\u6e38\u620f\u98ce\u683c\u7684\u6309\u952e\u4e0a\u3002\u6b65\u9aa43\uff09\u5728\u8bad\u7ec3\u6a21\u5f0f\u4e2d\u6d4b\u8bd5\u8bbe\u7f6e\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u9ed8\u8ba4\u8bbe\u7f6e\u4e0e\u81ea\u5b9a\u4e49\u8bbe\u7f6e - \u9ed8\u8ba4\u8bbe\u7f6e\uff1a\u6613\u4e8e\u4f7f\u7528\u4f46\u6548\u7387\u8f83\u4f4e\uff1b\u81ea\u5b9a\u4e49\u8bbe\u7f6e\uff1a\u5b9a\u5236\u4f46\u9700\u8981\u8c03\u6574\u3002]"}]
[{"question": "\u5982\u4f55\u89e3\u958b\u505c\u8eca\u5834\u5927\u4e82\u9b25\u7b2c\u4e00\u95dc\u7684\u8eca\u8f1b\u79fb\u52d5\uff1f", "answer": "\u8981\u79fb\u52d5\u505c\u8eca\u5834\u5927\u4e82\u9b25\u4e2d\u7684\u8eca\u8f1b\uff0c\u53ea\u9700\u8f15\u89f8\u4e26\u62d6\u66f3\u8eca\u8f1b\u5230\u5b83\u53ef\u4ee5\u79fb\u52d5\u7684\u65b9\u5411\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u95dc\u4e2d\uff0c\u60a8\u53ef\u4ee5\u5c07\u7d05\u8272\u6c7d\u8eca\u79fb\u5230\u53f3\u5074\uff0c\u70ba\u9ec3\u8272\u6c7d\u8eca\u6e05\u9664\u9053\u8def\u3002\u8acb\u8a18\u4f4f\uff0c\u6c7d\u8eca\u53ea\u80fd\u524d\u5f8c\u79fb\u52d5\uff0c\u800c\u4e0d\u80fd\u5de6\u53f3\u79fb\u52d5\u3002\u9019\u500b\u57fa\u672c\u6a5f\u5236\u5c0d\u65bc\u901a\u95dc\u904a\u6232\u81f3\u95dc\u91cd\u8981\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4e00\u4e0b\uff0c\u9019\u5c31\u50cf\u79fb\u52d5\u62fc\u5716\u788e\u7247\uff0c\u4ee5\u5efa\u7acb\u4e00\u689d\u6e05\u6670\u7684\u8def\u7dda\u3002]"}, {"question": "\u5728\u505c\u8eca\u5834\u5927\u4e82\u9b25\u4e2d\uff0c\u4e8b\u5148\u898f\u5283\u52d5\u4f5c\u70ba\u4f55\u91cd\u8981\uff1f", "answer": "\u5728\u505c\u8eca\u5834\u5927\u4e82\u9b25\u4e2d\uff0c\u4e8b\u5148\u898f\u5283\u52d5\u4f5c\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6709\u52a9\u65bc\u907f\u514d\u53d7\u56f0\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u79fb\u52d5\u4e00\u8f1b\u8eca\u6642\u6c92\u6709\u8003\u616e\u4e0b\u4e00\u6b65\uff0c\u60a8\u53ef\u80fd\u6703\u963b\u6b62\u53e6\u4e00\u8f1b\u8eca\u7684\u51fa\u53e3\u3002\u59cb\u7d42\u9810\u60f3\u6bcf\u8f1b\u8eca\u7684\u6700\u7d42\u4f4d\u7f6e\uff0c\u4e26\u5f9e\u5f8c\u5f80\u524d\u5de5\u4f5c\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u9078\u9805 A\uff1a\u5148\u79fb\u52d5\u85cd\u8272\u6c7d\u8eca\u3002\u9078\u9805 B\uff1a\u5148\u79fb\u52d5\u7d05\u8272\u6c7d\u8eca\u3002\u6bd4\u8f03\u54ea\u500b\u9078\u9805\u80fd\u66f4\u5feb\u5730\u627e\u5230\u89e3\u6c7a\u65b9\u6848\u3002]"}, {"question": "\u6bcf\u500b\u65b0\u73a9\u5bb6\u90fd\u61c9\u8a72\u4e86\u89e3\u7684\u505c\u8eca\u5834\u5927\u4e82\u9b25\u7684\u57fa\u672c\u898f\u5247\u662f\u4ec0\u9ebc\uff1f", "answer": "\u505c\u8eca\u5834\u5927\u4e82\u9b25\u7684\u57fa\u672c\u898f\u5247\u5305\u62ec\uff1a1) \u8eca\u8f1b\u53ea\u80fd\u524d\u5f8c\u79fb\u52d5\u30022) \u60a8\u9700\u8981\u70ba\u76ee\u6a19\u8eca\u8f1b\u7684\u51fa\u53e3\u6e05\u9664\u9053\u8def\u30023) \u6bcf\u4e00\u95dc\u90fd\u6709\u7368\u7279\u7684\u4f48\u5c40\uff0c\u9700\u8981\u4e0d\u540c\u7684\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e94\u95dc\u4e2d\uff0c\u60a8\u9700\u8981\u5148\u79fb\u52d5\u7da0\u8272\u6c7d\u8eca\uff0c\u624d\u80fd\u8b93\u85cd\u8272\u6c7d\u8eca\u99db\u51fa\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u7b2c\u4e00\u95dc\uff1a\u5c07\u7d05\u8272\u6c7d\u8eca\u79fb\u5230\u53f3\u5074\u3002\u7b2c\u4e94\u95dc\uff1a\u5148\u79fb\u52d5\u7da0\u8272\u6c7d\u8eca\u3002]"}, {"question": "\u5982\u4f55\u512a\u5316\u6211\u7684\u52d5\u4f5c\uff0c\u4ee5\u66f4\u5feb\u5730\u5b8c\u6210\u505c\u8eca\u5834\u5927\u4e82\u9b25\u95dc\u5361\uff1f", "answer": "\u8981\u512a\u5316\u5728\u505c\u8eca\u5834\u5927\u4e82\u9b25\u4e2d\u7684\u52d5\u4f5c\uff0c\u8acb\u9075\u5faa\u9019\u4e9b\u6b65\u9a5f\uff1a\u6b65\u9a5f 1\uff1a\u8b58\u5225\u76ee\u6a19\u8eca\u8f1b\u53ca\u5176\u51fa\u53e3\u8def\u7dda\u3002\u6b65\u9a5f 2\uff1a\u78ba\u5b9a\u54ea\u4e9b\u8eca\u8f1b\u963b\u7919\u4e86\u8def\u7dda\u3002\u6b65\u9a5f 3\uff1a\u6709\u6548\u5730\u898f\u5283\u79fb\u52d5\u9806\u5e8f\uff0c\u4ee5\u6e05\u9664\u9053\u8def\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 10 \u95dc\u4e2d\uff0c\u5148\u79fb\u52d5\u9ec3\u8272\u6c7d\u8eca\u53ef\u4ee5\u986f\u8457\u6e1b\u5c11\u6240\u9700\u7684\u79fb\u52d5\u6b21\u6578\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u958b\u59cb -> \u8b58\u5225\u76ee\u6a19\u8eca\u8f1b -> \u6e05\u9664\u9053\u8def -> \u51fa\u53e3\u3002]"}, {"question": "\u54ea\u4e9b\u9032\u968e\u7b56\u7565\u53ef\u4ee5\u5e6b\u52a9\u6211\u89e3\u6c7a\u8907\u96dc\u7684\u505c\u8eca\u5834\u5927\u4e82\u9b25\u8b0e\u984c\uff1f", "answer": "\u505c\u8eca\u5834\u5927\u4e82\u9b25\u7684\u9032\u968e\u7b56\u7565\u5305\u62ec\uff1a1) \u56de\u6eaf\uff1a\u6709\u6642\uff0c\u5c07\u6c7d\u8eca\u5411\u5f8c\u79fb\u52d5\u53ef\u4ee5\u958b\u555f\u65b0\u7684\u8def\u7dda\u30022) \u9023\u9396\u52d5\u4f5c\uff1a\u898f\u5283\u4e00\u500b\u52d5\u4f5c\u9023\u9396\uff0c\u5176\u4e2d\u4e00\u500b\u52d5\u4f5c\u6703\u555f\u7528\u4e0b\u4e00\u500b\u52d5\u4f5c\u30023) \u512a\u5148\u9806\u5e8f\uff1a\u9996\u5148\u5c08\u6ce8\u65bc\u79fb\u52d5\u963b\u7919\u591a\u689d\u8def\u7dda\u7684\u6c7d\u8eca\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 20 \u95dc\u4e2d\uff0c\u5c07\u85cd\u8272\u6c7d\u8eca\u5411\u5f8c\u79fb\u52d5\uff0c\u5247\u8b93\u7d05\u8272\u6c7d\u8eca\u5411\u524d\u79fb\u52d5\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u9078\u9805 A\uff1a\u5c07\u85cd\u8272\u6c7d\u8eca\u79fb\u56de\u3002\u9078\u9805 B\uff1a\u5148\u79fb\u52d5\u7d05\u8272\u6c7d\u8eca\u3002\u6bd4\u8f03\u54ea\u500b\u9078\u9805\u66f4\u6709\u6548\u7387\u3002]"}, {"question": "\u505c\u8eca\u5834\u5927\u4e82\u9b25\u4e2d\u7684\u7db2\u683c\u4f48\u5c40\u6709\u4ec0\u9ebc\u610f\u7fa9\uff1f", "answer": "\u505c\u8eca\u5834\u5927\u4e82\u9b25\u4e2d\u7684\u7db2\u683c\u4f48\u5c40\u6c7a\u5b9a\u4e86\u6bcf\u8f1b\u8eca\u7684\u79fb\u52d5\u53ef\u80fd\u6027\u3002\u6bcf\u4e00\u95dc\u90fd\u6709\u7368\u7279\u7684\u7db2\u683c\uff0c\u5b9a\u7fa9\u4e86\u8d77\u59cb\u4f4d\u7f6e\u548c\u53ef\u80fd\u7684\u79fb\u52d5\u3002\u4f8b\u5982\uff0c\u5728\u7b2c 15 \u95dc\u4e2d\uff0c\u7db2\u683c\u8a2d\u8a08\u5f97\u53ea\u5141\u8a31\u7da0\u8272\u6c7d\u8eca\u6700\u521d\u79fb\u52d5\uff0c\u70ba\u5176\u9918\u8b0e\u984c\u5960\u5b9a\u57fa\u790e\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u60f3\u50cf\u4e00\u4e0b\uff0c\u7db2\u683c\u5c31\u50cf\u68cb\u76e4\uff0c\u6bcf\u8f1b\u8eca\u90fd\u662f\u5177\u6709\u7279\u5b9a\u79fb\u52d5\u898f\u5247\u7684\u68cb\u5b50\u3002]"}, {"question": "\u505c\u8eca\u5834\u5927\u4e82\u9b25\u7684\u904a\u6232\u6a5f\u5236\u5982\u4f55\u5f71\u97ff\u73a9\u5bb6\u7684\u7b56\u7565\uff1f", "answer": "\u505c\u8eca\u5834\u5927\u4e82\u9b25\u7684\u904a\u6232\u6a5f\u5236\uff08\u4f8b\u5982\u79fb\u52d5\u9650\u5236\u548c\u7db2\u683c\u4f48\u5c40\uff09\u76f4\u63a5\u5f71\u97ff\u73a9\u5bb6\u7684\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u7531\u65bc\u8eca\u8f1b\u53ea\u80fd\u524d\u5f8c\u79fb\u52d5\uff0c\u73a9\u5bb6\u5fc5\u9808\u4ed4\u7d30\u898f\u5283\u4ed6\u5011\u7684\u52d5\u4f5c\uff0c\u907f\u514d\u6b7b\u80e1\u540c\u3002\u5728\u7b2c 25 \u95dc\u4e2d\uff0c\u6709\u9650\u7a7a\u9593\u7684\u6a5f\u5236\u8feb\u4f7f\u73a9\u5bb6\u63d0\u524d\u591a\u6b65\u601d\u8003\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u7b2c 10 \u95dc\uff1a\u7c21\u55ae\u7db2\u683c\u3002\u7b2c 25 \u95dc\uff1a\u8907\u96dc\u7db2\u683c\uff0c\u7a7a\u9593\u6709\u9650\u3002]"}, {"question": "\u6211\u53ef\u4ee5\u5c07\u6211\u7684\u505c\u8eca\u5834\u5927\u4e82\u9b25\u9032\u5ea6\u5f9e\u4e00\u500b\u88dd\u7f6e\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u88dd\u7f6e\u55ce\uff1f", "answer": "\u662f\u7684\uff0c\u60a8\u53ef\u4ee5\u5c07\u60a8\u7684\u505c\u8eca\u5834\u5927\u4e82\u9b25\u9032\u5ea6\u900f\u904e\u9023\u7d50\u5230\u96f2\u7aef\u5e33\u6236\u4f86\u8f49\u79fb\u3002\u9019\u8b93\u60a8\u53ef\u4ee5\u5728\u591a\u500b\u88dd\u7f6e\u4e0a\u540c\u6b65\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9e Android \u624b\u6a5f\u5207\u63db\u5230 iPhone\uff0c\u53ea\u9700\u4f7f\u7528\u76f8\u540c\u7684\u5e33\u6236\u767b\u5165\uff0c\u5373\u53ef\u7e7c\u7e8c\u4e4b\u524d\u7684\u904a\u6232\u9032\u5ea6\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u88dd\u7f6e A -> \u96f2\u7aef\u540c\u6b65 -> \u88dd\u7f6e B\u3002]"}, {"question": "\u505c\u8eca\u5834\u5927\u4e82\u9b25\u4e2d\u662f\u5426\u6709\u4efb\u4f55\u96b1\u85cf\u6210\u5c31\u6216\u79d8\u5bc6\uff1f", "answer": "\u662f\u7684\uff0c\u505c\u8eca\u5834\u5927\u4e82\u9b25\u4e2d\u6709\u96b1\u85cf\u6210\u5c31\uff0c\u734e\u52f5\u73a9\u5bb6\u4ee5\u7368\u7279\u7684\u65b9\u5f0f\u5b8c\u6210\u95dc\u5361\u3002\u4f8b\u5982\uff0c\u5b8c\u6210\u95dc\u5361\u6240\u9700\u79fb\u52d5\u6b21\u6578\u6700\u5c11\u5373\u53ef\u7372\u5f97\u6210\u5c31\u3002\u8981\u89e3\u9396\u5b83\uff0c\u60a8\u9700\u8981\u4ed4\u7d30\u898f\u5283\u6bcf\u6b21\u52d5\u4f5c\uff0c\u4e26\u907f\u514d\u4e0d\u5fc5\u8981\u7684\u6b65\u9a5f\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u9019\u5c31\u50cf\u900f\u904e\u9075\u5faa\u7cbe\u78ba\u7684\u5730\u5716\u4f86\u627e\u5230\u96b1\u85cf\u7684\u5bf6\u85cf\u3002]"}, {"question": "\u8207\u5176\u4ed6\u76ca\u667a\u904a\u6232\u76f8\u6bd4\uff0c\u4ec0\u9ebc\u8b93\u505c\u8eca\u5834\u5927\u4e82\u9b25\u6210\u70ba\u7368\u7279\u7684\u76ca\u667a\u904a\u6232\uff1f", "answer": "\u505c\u8eca\u5834\u5927\u4e82\u9b25\u4e4b\u6240\u4ee5\u7a81\u51fa\uff0c\u5728\u65bc\u5176\u7c21\u55ae\u537b\u5177\u6709\u6311\u6230\u6027\u7684\u6a5f\u5236\u548c\u591a\u6a23\u5316\u7684\u95dc\u5361\u8a2d\u8a08\u3002\u8207\u5176\u4ed6\u76ca\u667a\u904a\u6232\u4e0d\u540c\uff0c\u5b83\u5074\u91cd\u65bc\u7b56\u7565\u898f\u5283\u548c\u7a7a\u9593\u610f\u8b58\u3002\u4f8b\u5982\uff0c\u96a8\u8457\u904a\u6232\u7684\u9032\u5c55\uff0c\u904a\u6232\u5f15\u5165\u4e86\u4e0d\u540c\u8eca\u8f1b\u5927\u5c0f\u548c\u969c\u7919\u7269\u7b49\u65b0\u5143\u7d20\uff0c\u4fdd\u6301\u904a\u6232\u73a9\u6cd5\u7684\u65b0\u9bae\u611f\u548c\u5438\u5f15\u529b\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u505c\u8eca\u5834\u5927\u4e82\u9b25\uff1a\u5c08\u6ce8\u65bc\u8eca\u8f1b\u7684\u79fb\u52d5\u3002\u5176\u4ed6\u76ca\u667a\u904a\u6232\uff1a\u5c08\u6ce8\u65bc\u5339\u914d\u6216\u6642\u9593\u63a7\u5236\u3002]"}]
[{"question": "\u99d0\u8eca\u30b8\u30e3\u30e0\u306e\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u305f\u3081\u306b\u3001\u8eca\u3092\u3069\u306e\u3088\u3046\u306b\u79fb\u52d5\u3057\u307e\u3059\u304b\uff1f", "answer": "\u99d0\u8eca\u30b8\u30e3\u30e0\u3067\u8eca\u3092\u52d5\u304b\u3059\u306b\u306f\u3001\u8eca\u3092\u79fb\u52d5\u3067\u304d\u308b\u65b9\u5411\u306b\u30bf\u30c3\u30d7\uff06\u30c9\u30e9\u30c3\u30b0\u3059\u308b\u3060\u3051\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u6700\u521d\u306e\u30ec\u30d9\u30eb\u3067\u306f\u3001\u8d64\u3044\u8eca\u3092\u53f3\u306b\u79fb\u52d5\u3057\u3066\u3001\u9ec4\u8272\u306e\u8eca\u306e\u901a\u8def\u3092\u958b\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u899a\u3048\u3066\u304a\u3044\u3066\u304f\u3060\u3055\u3044\u3002\u8eca\u304c\u6a2a\u306b\u79fb\u52d5\u3059\u308b\u3053\u3068\u306f\u3067\u304d\u307e\u305b\u3093\u3002\u3053\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u306f\u3001\u30b2\u30fc\u30e0\u3092\u9032\u3081\u308b\u305f\u3081\u306e\u9375\u3068\u306a\u308a\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u30d1\u30ba\u30eb\u30d4\u30fc\u30b9\u3092\u30b9\u30e9\u30a4\u30c9\u3055\u305b\u3066\u901a\u8def\u3092\u78ba\u4fdd\u3059\u308b\u3053\u3068\u3092\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u99d0\u8eca\u30b8\u30e3\u30e0\u3067\u3001\u5148\u306b\u624b\u3092\u52d5\u304b\u3059\u8a08\u753b\u3092\u7acb\u3066\u308b\u3053\u3068\u306f\u306a\u305c\u91cd\u8981\u3067\u3059\u304b\uff1f", "answer": "\u99d0\u8eca\u30b8\u30e3\u30e0\u3067\u3001\u5148\u306b\u624b\u3092\u52d5\u304b\u3059\u8a08\u753b\u3092\u7acb\u3066\u308b\u3053\u3068\u306f\u3001\u8a70\u307e\u3063\u3066\u3057\u307e\u3046\u306e\u3092\u9632\u3050\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u6b21\u306e\u624b\u9806\u3092\u8003\u3048\u305a\u306b\u8eca\u3092\u52d5\u304b\u3059\u5834\u5408\u3001\u5225\u306e\u8eca\u306e\u51fa\u53e3\u3092\u585e\u3044\u3067\u3057\u307e\u3046\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u5e38\u306b\u5404\u8eca\u306e\u6700\u7d42\u7684\u306a\u4f4d\u7f6e\u3092\u4e88\u6e2c\u3057\u3001\u5f8c\u308d\u5411\u304d\u306b\u4f5c\u696d\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u8907\u6570\u306e\u9078\u629e\u80a2\u306e\u6bd4\u8f03\uff1a\u30aa\u30d7\u30b7\u30e7\u30f3A\uff1a\u307e\u305a\u9752\u3044\u8eca\u3002\u30aa\u30d7\u30b7\u30e7\u30f3B\uff1a\u307e\u305a\u8d64\u3044\u8eca\u3002\u3069\u3061\u3089\u306e\u9078\u629e\u80a2\u304c\u3088\u308a\u8fc5\u901f\u306a\u89e3\u6c7a\u7b56\u306b\u3064\u306a\u304c\u308b\u304b\u3092\u6bd4\u8f03\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u3059\u3079\u3066\u306e\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u77e5\u3063\u3066\u3044\u308b\u3079\u304d\u3001\u99d0\u8eca\u30b8\u30e3\u30e0\u306e\u57fa\u672c\u7684\u306a\u30eb\u30fc\u30eb\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u99d0\u8eca\u30b8\u30e3\u30e0\u306e\u57fa\u672c\u7684\u306a\u30eb\u30fc\u30eb\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\u30021) \u8eca\u306f\u524d\u5f8c\u306b\u3057\u304b\u79fb\u52d5\u3067\u304d\u307e\u305b\u3093\u30022) \u76ee\u6a19\u306e\u8eca\u304c\u51fa\u53e3\u306b\u51fa\u308b\u305f\u3081\u306e\u901a\u8def\u3092\u958b\u3051\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u30023) \u5404\u30ec\u30d9\u30eb\u306f\u3001\u7570\u306a\u308b\u6226\u7565\u304c\u5fc5\u8981\u306a\u72ec\u7279\u306e\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb5\u3067\u306f\u3001\u9752\u3044\u8eca\u304c\u51fa\u53e3\u306b\u51fa\u3089\u308c\u308b\u3088\u3046\u306b\u3001\u307e\u305a\u7dd1\u306e\u8eca\u3092\u52d5\u304b\u3059\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002[\u69cb\u6210\u5bfe\u7167\u8868\uff1a\u30ec\u30d9\u30eb1\uff1a\u8d64\u3044\u8eca\u3092\u53f3\u306b\u52d5\u304b\u3059\u3002\u30ec\u30d9\u30eb5\uff1a\u307e\u305a\u7dd1\u306e\u8eca\u3092\u52d5\u304b\u3059\u3002]"}, {"question": "\u99d0\u8eca\u30b8\u30e3\u30e0\u306e\u30ec\u30d9\u30eb\u3092\u3088\u308a\u65e9\u304f\u30af\u30ea\u30a2\u3059\u308b\u305f\u3081\u306b\u3001\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u79fb\u52d5\u3092\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u99d0\u8eca\u30b8\u30e3\u30e0\u3067\u79fb\u52d5\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u76ee\u6a19\u306e\u8eca\u3068\u305d\u306e\u51fa\u53e3\u306e\u901a\u8def\u3092\u7279\u5b9a\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u901a\u8def\u3092\u585e\u3044\u3067\u3044\u308b\u8eca\u3092\u7279\u5b9a\u3059\u308b\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u901a\u8def\u3092\u52b9\u7387\u7684\u306b\u30af\u30ea\u30a2\u3059\u308b\u305f\u3081\u306e\u79fb\u52d5\u624b\u9806\u3092\u8a08\u753b\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb10\u3067\u306f\u3001\u307e\u305a\u9ec4\u8272\u306e\u8eca\u3092\u52d5\u304b\u3059\u3053\u3068\u3067\u3001\u5fc5\u8981\u306a\u79fb\u52d5\u6570\u3092\u5927\u5e45\u306b\u6e1b\u3089\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u958b\u59cb\u2192\u76ee\u6a19\u8eca\u3092\u7279\u5b9a\u3059\u308b\u2192\u901a\u8def\u3092\u958b\u3051\u308b\u2192\u51fa\u53e3\u3002]"}, {"question": "\u8907\u96d1\u306a\u99d0\u8eca\u30b8\u30e3\u30e0\u306e \u30d1\u30ba\u30eb\u3092\u89e3\u6c7a\u3059\u308b\u305f\u3081\u306b\u5f79\u7acb\u3064\u9ad8\u5ea6\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u99d0\u8eca\u30b8\u30e3\u30e0\u306e\u9ad8\u5ea6\u306a\u6226\u7565\u306f\u6b21\u306e\u3068\u304a\u308a\u3067\u3059\u30021) \u5f8c\u623b\u308a\uff1a\u6642\u3005\u3001\u8eca\u3092\u5f8c\u308d\u306b\u52d5\u304b\u3059\u3053\u3068\u3067\u3001\u65b0\u3057\u3044\u901a\u8def\u304c\u958b\u304b\u308c\u307e\u3059\u30022) \u9023\u7d9a\u3059\u308b\u79fb\u52d5\uff1a\u6b21\u306e\u79fb\u52d5\u3092\u53ef\u80fd\u306b\u3059\u308b\u4e00\u9023\u306e\u79fb\u52d5\u3092\u8a08\u753b\u3059\u308b\u30023) \u512a\u5148\u9806\u4f4d\u4ed8\u3051\uff1a\u8907\u6570\u306e\u901a\u8def\u3092\u585e\u3044\u3067\u3044\u308b\u8eca\u3092\u6700\u521d\u306b\u52d5\u304b\u3059\u3053\u3068\u306b\u96c6\u4e2d\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb20\u3067\u306f\u3001\u9752\u3044\u8eca\u3092\u5f8c\u623b\u308a\u3055\u305b\u308b\u3053\u3068\u3067\u3001\u8d64\u3044\u8eca\u304c\u524d\u9032\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002[\u8907\u6570\u306e\u9078\u629e\u80a2\u306e\u6bd4\u8f03\uff1a\u30aa\u30d7\u30b7\u30e7\u30f3A\uff1a\u9752\u3044\u8eca\u3092\u5f8c\u308d\u306b\u52d5\u304b\u3059\u3002\u30aa\u30d7\u30b7\u30e7\u30f3B\uff1a\u307e\u305a\u8d64\u3044\u8eca\u3092\u52d5\u304b\u3059\u3002\u3069\u3061\u3089\u304c\u3088\u308a\u52b9\u7387\u7684\u304b\u3092\u6bd4\u8f03\u3057\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u99d0\u8eca\u30b8\u30e3\u30e0\u306b\u304a\u3051\u308b\u30b0\u30ea\u30c3\u30c9\u30ec\u30a4\u30a2\u30a6\u30c8\u306e\u91cd\u8981\u6027\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u99d0\u8eca\u30b8\u30e3\u30e0\u306b\u304a\u3051\u308b\u30b0\u30ea\u30c3\u30c9\u30ec\u30a4\u30a2\u30a6\u30c8\u306f\u3001\u5404\u8eca\u306e\u79fb\u52d5\u53ef\u80fd\u6027\u3092\u6c7a\u5b9a\u3057\u307e\u3059\u3002\u5404\u30ec\u30d9\u30eb\u306f\u3001\u958b\u59cb\u4f4d\u7f6e\u3068\u53ef\u80fd\u306a\u79fb\u52d5\u3092\u5b9a\u7fa9\u3059\u308b\u72ec\u81ea\u306e\u30b0\u30ea\u30c3\u30c9\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30ec\u30d9\u30eb15\u3067\u306f\u3001\u30b0\u30ea\u30c3\u30c9\u306f\u3001\u6700\u521d\u306b\u7dd1\u306e\u8eca\u3057\u304b\u52d5\u304b\u305b\u306a\u3044\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u304a\u308a\u3001\u6b8b\u308a\u306e\u30d1\u30ba\u30eb\u306e\u821e\u53f0\u3092\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7\u3057\u3066\u3044\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u30b0\u30ea\u30c3\u30c9\u3092\u3001\u7279\u5b9a\u306e\u79fb\u52d5\u30eb\u30fc\u30eb\u3092\u6301\u3064\u99d2\u304c\u7f6e\u304b\u308c\u305f\u30c1\u30a7\u30b9\u76e4\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002]"}, {"question": "\u99d0\u8eca\u30b8\u30e3\u30e0\u306e\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u6226\u7565\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u99d0\u8eca\u30b8\u30e3\u30e0\u306e\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\uff08\u8eca\u306e\u79fb\u52d5\u5236\u9650\u3084\u30b0\u30ea\u30c3\u30c9\u30ec\u30a4\u30a2\u30a6\u30c8\u306a\u3069\uff09\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u6226\u7565\u306b\u76f4\u63a5\u5f71\u97ff\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u8eca\u304c\u524d\u5f8c\u306b\u3057\u304b\u52d5\u304b\u305b\u306a\u3044\u305f\u3081\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u884c\u304d\u6b62\u307e\u308a\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u614e\u91cd\u306b\u79fb\u52d5\u3092\u8a08\u753b\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u30ec\u30d9\u30eb25\u3067\u306f\u3001\u9650\u3089\u308c\u305f\u30b9\u30da\u30fc\u30b9\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u6570\u624b\u5148\u3092\u8aad\u3080\u3053\u3068\u3092\u5f37\u5236\u3057\u307e\u3059\u3002[\u69cb\u6210\u5bfe\u7167\u8868\uff1a\u30ec\u30d9\u30eb10\uff1a\u5358\u7d14\u306a\u30b0\u30ea\u30c3\u30c9\u3002\u30ec\u30d9\u30eb25\uff1a\u9650\u3089\u308c\u305f\u30b9\u30da\u30fc\u30b9\u306e\u8907\u96d1\u306a\u30b0\u30ea\u30c3\u30c9\u3002]"}, {"question": "\u8907\u6570\u306e\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u3001\u99d0\u8eca\u30b8\u30e3\u30e0\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3059\u308b\u3053\u3068\u306f\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30b2\u30fc\u30e0\u3092\u30af\u30e9\u30a6\u30c9\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ea\u30f3\u30af\u3059\u308b\u3053\u3068\u3067\u3001\u99d0\u8eca\u30b8\u30e3\u30e0\u306e\u9032\u884c\u72b6\u6cc1\u3092\u8ee2\u9001\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u8907\u6570\u306e\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u9032\u884c\u72b6\u6cc1\u3092\u540c\u671f\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001Android\u306e\u30b9\u30de\u30fc\u30c8\u30d5\u30a9\u30f3\u304b\u3089iPhone\u306b\u5207\u308a\u66ff\u3048\u308b\u5834\u5408\u3001\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u3067\u30ed\u30b0\u30a4\u30f3\u3059\u308c\u3070\u3001\u4e2d\u65ad\u3057\u305f\u3068\u3053\u308d\u304b\u3089\u518d\u958b\u3067\u304d\u307e\u3059\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30c7\u30d0\u30a4\u30b9A\u2192\u30af\u30e9\u30a6\u30c9\u540c\u671f\u2192\u30c7\u30d0\u30a4\u30b9B\u3002]"}, {"question": "\u99d0\u8eca\u30b8\u30e3\u30e0\u306b\u306f\u3001\u96a0\u3055\u308c\u305f\u9054\u6210\u5ea6\u3084\u79d8\u5bc6\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u99d0\u8eca\u30b8\u30e3\u30e0\u306b\u306f\u3001\u30e6\u30cb\u30fc\u30af\u306a\u65b9\u6cd5\u3067\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3057\u305f\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u5831\u916c\u3092\u4e0e\u3048\u308b\u96a0\u3055\u308c\u305f\u9054\u6210\u5ea6\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u6700\u5c0f\u306e\u79fb\u52d5\u6570\u3067\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u9054\u6210\u5ea6\u304c\u3042\u308a\u307e\u3059\u3002\u305d\u308c\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u306b\u306f\u3001\u5404\u79fb\u52d5\u3092\u614e\u91cd\u306b\u8a08\u753b\u3057\u3001\u4e0d\u8981\u306a\u30b9\u30c6\u30c3\u30d7\u3092\u907f\u3051\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002[\u4f8b\u3048\uff1a\u6b63\u78ba\u306a\u5730\u56f3\u306b\u5f93\u3063\u3066\u3001\u96a0\u3055\u308c\u305f\u5b9d\u3092\u898b\u3064\u3051\u308b\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002]"}, {"question": "\u99d0\u8eca\u30b8\u30e3\u30e0\u304c\u4ed6\u306e\u30d1\u30ba\u30eb\u30b2\u30fc\u30e0\u3068\u6bd4\u3079\u3066\u3001\u30e6\u30cb\u30fc\u30af\u306a\u70b9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u99d0\u8eca\u30b8\u30e3\u30e0\u306f\u3001\u30b7\u30f3\u30d7\u30eb\u3067\u3042\u308a\u306a\u304c\u3089\u6311\u6226\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3068\u591a\u69d8\u306a\u30ec\u30d9\u30eb\u30c7\u30b6\u30a4\u30f3\u306b\u3088\u308a\u969b\u7acb\u3063\u3066\u3044\u307e\u3059\u3002\u4ed6\u306e\u30d1\u30ba\u30eb\u30b2\u30fc\u30e0\u3068\u306f\u7570\u306a\u308a\u3001\u6226\u7565\u7684\u306a\u8a08\u753b\u3068\u7a7a\u9593\u7684\u306a\u8a8d\u8b58\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30b2\u30fc\u30e0\u306f\u3001\u9032\u3081\u308b\u306b\u3064\u308c\u3066\u3055\u307e\u3056\u307e\u306a\u8eca\u30b5\u30a4\u30ba\u3084\u969c\u5bb3\u7269\u3068\u3044\u3063\u305f\u65b0\u3057\u3044\u8981\u7d20\u3092\u8ffd\u52a0\u3057\u3066\u304a\u308a\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u5e38\u306b\u65b0\u9bae\u3067\u9b45\u529b\u7684\u306a\u3082\u306e\u306b\u3057\u3066\u304f\u308c\u307e\u3059\u3002[\u8907\u6570\u306e\u9078\u629e\u80a2\u306e\u6bd4\u8f03\uff1a\u99d0\u8eca\u30b8\u30e3\u30e0\uff1a\u8eca\u306e\u79fb\u52d5\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3002\u4ed6\u306e\u30d1\u30ba\u30eb\u30b2\u30fc\u30e0\uff1a\u30de\u30c3\u30c1\u30f3\u30b0\u3084\u30bf\u30a4\u30df\u30f3\u30b0\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3002]"}]
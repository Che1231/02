[{"question": "\uc8fc\ucc28 \uc7bc\uc5d0\uc11c \uccab \ubc88\uc9f8 \ub808\ubca8\uc744 \ud574\uacb0\ud558\ub824\uba74 \uc790\ub3d9\ucc28\ub97c \uc5b4\ub5bb\uac8c \uc774\ub3d9\uc2dc\ucf1c\uc57c \ud558\ub098\uc694?", "answer": "\uc8fc\ucc28 \uc7bc\uc5d0\uc11c \uc790\ub3d9\ucc28\ub97c \uc774\ub3d9\ud558\ub824\uba74, \uc790\ub3d9\ucc28\uac00 \uc774\ub3d9\ud560 \uc218 \uc788\ub294 \ubc29\ud5a5\uc73c\ub85c \ud0ed\ud558\uace0 \ub4dc\ub798\uadf8\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ub808\ubca8\uc5d0\uc11c \ube68\uac04\uc0c9 \uc790\ub3d9\ucc28\ub97c \uc624\ub978\ucabd\uc73c\ub85c \uc774\ub3d9\ud558\uc5ec \ub178\ub780\uc0c9 \uc790\ub3d9\ucc28\uc758 \uacbd\ub85c\ub97c \ud655\ubcf4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc790\ub3d9\ucc28\ub294 \uc606\uc73c\ub85c\ub294 \uc774\ub3d9\ud560 \uc218 \uc5c6\uace0 \uc55e\uc73c\ub85c \ub610\ub294 \ub4a4\ub85c\ub9cc \uc774\ub3d9\ud560 \uc218 \uc788\ub2e4\ub294 \uc810\uc744 \uae30\uc5b5\ud558\uc138\uc694. \uc774 \uae30\ubcf8\uc801\uc778 \uba54\ucee4\ub2c8\uc998\uc740 \uac8c\uc784\uc744 \uc9c4\ud589\ud558\ub294 \ub370 \uc911\uc694\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ud37c\uc990 \uc870\uac01\uc744 \uc6c0\uc9c1\uc5ec\uc11c \uae68\ub057\ud55c \uacbd\ub85c\ub97c \ub9cc\ub4dc\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\uc8fc\ucc28 \uc7bc\uc5d0\uc11c \ubbf8\ub9ac \uc774\ub3d9\uc744 \uacc4\ud68d\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc8fc\ucc28 \uc7bc\uc5d0\uc11c \ubbf8\ub9ac \uc774\ub3d9\uc744 \uacc4\ud68d\ud558\ub294 \uac83\uc740 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc65c\ub0d0\ud558\uba74 \ubbf8\ub798\uc758 \uc774\ub3d9\uc744 \uace0\ub824\ud558\uc9c0 \uc54a\uace0 \uc790\ub3d9\ucc28\ub97c \uc774\ub3d9\ud558\uba74 \ub2e4\ub978 \uc790\ub3d9\ucc28\uac00 \ube60\uc838\ub098\uac08 \ucd9c\uad6c\ub97c \ub9c9\uc744 \uc218 \uc788\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \ud56d\uc0c1 \uac01 \uc790\ub3d9\ucc28\uc758 \ucd5c\uc885 \uc704\uce58\ub97c \uc2dc\uac01\ud654\ud558\uace0 \uac70\uafb8\ub85c \uc791\uc5c5\ud558\uc138\uc694. [\uc5ec\ub7ec \ubc29\ubc95 \ube44\uad50: \uc635\uc158 A: \uba3c\uc800 \ud30c\ub780\uc0c9 \uc790\ub3d9\ucc28\ub97c \uc774\ub3d9\ud569\ub2c8\ub2e4. \uc635\uc158 B: \uba3c\uc800 \ube68\uac04\uc0c9 \uc790\ub3d9\ucc28\ub97c \uc774\ub3d9\ud569\ub2c8\ub2e4. \uc5b4\ub5a4 \uc635\uc158\uc774 \ub354 \ube60\ub978 \ud574\uacb0\ucc45\uc73c\ub85c \uc774\uc5b4\uc9c0\ub294\uc9c0 \ube44\uad50\ud574 \ubcf4\uc138\uc694.]"}, {"question": "\ubaa8\ub4e0 \uc2e0\uaddc \ud50c\ub808\uc774\uc5b4\uac00 \uc54c\uc544\uc57c \ud560 \uc8fc\ucc28 \uc7bc\uc758 \uae30\ubcf8 \uaddc\uce59\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc8fc\ucc28 \uc7bc\uc758 \uae30\ubcf8 \uaddc\uce59\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: 1) \uc790\ub3d9\ucc28\ub294 \uc55e\uc73c\ub85c \ub610\ub294 \ub4a4\ub85c\ub9cc \uc774\ub3d9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 2) \ubaa9\ud45c \uc790\ub3d9\ucc28\uac00 \ube60\uc838\ub098\uac08 \uc218 \uc788\ub3c4\ub85d \uacbd\ub85c\ub97c \ud655\ubcf4\ud574\uc57c \ud569\ub2c8\ub2e4. 3) \uac01 \ub808\ubca8\uc740 \ub2e4\ub978 \uc804\ub7b5\uc774 \ud544\uc694\ud55c \uace0\uc720\ud55c \ub808\uc774\uc544\uc6c3\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 5\ubc88 \ub808\ubca8\uc5d0\uc11c\ub294 \ud30c\ub780\uc0c9 \uc790\ub3d9\ucc28\uac00 \ube60\uc838\ub098\uac08 \uc218 \uc788\ub3c4\ub85d \ub179\uc0c9 \uc790\ub3d9\ucc28\ub97c \uba3c\uc800 \uc774\ub3d9\ud574\uc57c \ud569\ub2c8\ub2e4. [\uc124\uc815 \ub300\uc870\ud45c: \ub808\ubca8 1: \ube68\uac04\uc0c9 \uc790\ub3d9\ucc28 \uc624\ub978\ucabd \uc774\ub3d9. \ub808\ubca8 5: \uba3c\uc800 \ub179\uc0c9 \uc790\ub3d9\ucc28 \uc774\ub3d9.]"}, {"question": "\uc8fc\ucc28 \uc7bc \ub808\ubca8\uc744 \ub354 \ube68\ub9ac \uc644\ub8cc\ud558\uae30 \uc704\ud574 \uc774\ub3d9\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc8fc\ucc28 \uc7bc\uc5d0\uc11c \uc774\ub3d9\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: \ub2e8\uacc4 1: \ubaa9\ud45c \uc790\ub3d9\ucc28\uc640 \uadf8 \ucd9c\uad6c \uacbd\ub85c\ub97c \ud655\uc778\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uacbd\ub85c\ub97c \ucc28\ub2e8\ud558\ub294 \uc790\ub3d9\ucc28\ub97c \ud30c\uc545\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \uacbd\ub85c\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \ud655\ubcf4\ud558\uae30 \uc704\ud55c \uc774\ub3d9 \uc21c\uc11c\ub97c \uacc4\ud68d\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 10\ubc88 \ub808\ubca8\uc5d0\uc11c \uba3c\uc800 \ub178\ub780\uc0c9 \uc790\ub3d9\ucc28\ub97c \uc774\ub3d9\ud558\uba74 \ud544\uc694\ud55c \uc774\ub3d9 \ud69f\uc218\ub97c \ud06c\uac8c \uc904\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uc2dc\uc791 -> \ubaa9\ud45c \uc790\ub3d9\ucc28 \ud655\uc778 -> \uacbd\ub85c \ud655\ubcf4 -> \ucd9c\uad6c.]"}, {"question": "\ubcf5\uc7a1\ud55c \uc8fc\ucc28 \uc7bc \ud37c\uc990\uc744 \ud574\uacb0\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ub294 \uace0\uae09 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc8fc\ucc28 \uc7bc\uc758 \uace0\uae09 \uc804\ub7b5\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: 1) \ub418\ub3cc\ub9ac\uae30: \ub54c\ub85c\ub294 \uc790\ub3d9\ucc28\ub97c \ub4a4\ub85c \uc774\ub3d9\ud558\uba74 \uc0c8\ub85c\uc6b4 \uacbd\ub85c\uac00 \uc5f4\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. 2) \uc5f0\uc1c4 \uc774\ub3d9: \ub2e4\uc74c \uc774\ub3d9\uc744 \uac00\ub2a5\ud558\uac8c \ud558\ub294 \uc5f0\uc18d\uc801\uc778 \uc774\ub3d9 \uc21c\uc11c\ub97c \uacc4\ud68d\ud569\ub2c8\ub2e4. 3) \uc6b0\uc120\uc21c\uc704 \uc124\uc815: \uc5ec\ub7ec \uacbd\ub85c\ub97c \ucc28\ub2e8\ud558\ub294 \uc790\ub3d9\ucc28\ub97c \uba3c\uc800 \uc6b0\uc120\uc801\uc73c\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 20\ubc88 \ub808\ubca8\uc5d0\uc11c \ud30c\ub780\uc0c9 \uc790\ub3d9\ucc28\ub97c \ub418\ub3cc\ub9ac\uba74 \ube68\uac04\uc0c9 \uc790\ub3d9\ucc28\uac00 \uc55e\uc73c\ub85c \uc774\ub3d9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uc5ec\ub7ec \ubc29\ubc95 \ube44\uad50: \uc635\uc158 A: \ud30c\ub780\uc0c9 \uc790\ub3d9\ucc28\ub97c \ub4a4\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4. \uc635\uc158 B: \uba3c\uc800 \ube68\uac04\uc0c9 \uc790\ub3d9\ucc28\ub97c \uc774\ub3d9\ud569\ub2c8\ub2e4. \uc5b4\ub5a4 \uc635\uc158\uc774 \ub354 \ud6a8\uc728\uc801\uc778\uc9c0 \ube44\uad50\ud574 \ubcf4\uc138\uc694.]"}, {"question": "\uc8fc\ucc28 \uc7bc\uc5d0\uc11c \uadf8\ub9ac\ub4dc \ub808\uc774\uc544\uc6c3\uc758 \uc911\uc694\uc131\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc8fc\ucc28 \uc7bc\uc5d0\uc11c \uadf8\ub9ac\ub4dc \ub808\uc774\uc544\uc6c3\uc740 \uac01 \uc790\ub3d9\ucc28\uc758 \uc774\ub3d9 \uac00\ub2a5\uc131\uc744 \uacb0\uc815\ud569\ub2c8\ub2e4. \uac01 \ub808\ubca8\uc740 \uc2dc\uc791 \uc704\uce58\uc640 \uac00\ub2a5\ud55c \uc774\ub3d9\uc744 \uc815\uc758\ud558\ub294 \uace0\uc720\ud55c \uadf8\ub9ac\ub4dc\ub97c \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, 15\ubc88 \ub808\ubca8\uc5d0\uc11c\ub294 \uadf8\ub9ac\ub4dc\uac00 \ucc98\uc74c\uc5d0\ub294 \ub179\uc0c9 \uc790\ub3d9\ucc28\ub9cc \uc774\ub3d9\ud560 \uc218 \uc788\ub3c4\ub85d \uc124\uacc4\ub418\uc5b4 \ub098\uba38\uc9c0 \ud37c\uc990\uc758 \ub2e8\uc11c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uccb4\uc2a4\ud310\ucc98\ub7fc \uac01 \uc790\ub3d9\ucc28\ub294 \ud2b9\uc815 \uc774\ub3d9 \uaddc\uce59\uc744 \uac00\uc9c4 \ub9d0\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\uc8fc\ucc28 \uc7bc\uc758 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998\uc774 \ud50c\ub808\uc774\uc5b4 \uc804\ub7b5\uc5d0 \uc5b4\ub5bb\uac8c \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "\uc8fc\ucc28 \uc7bc\uc758 \uac8c\uc784 \uba54\ucee4\ub2c8\uc998(\uc608: \uc774\ub3d9 \uc81c\uc57d \ubc0f \uadf8\ub9ac\ub4dc \ub808\uc774\uc544\uc6c3)\uc740 \ud50c\ub808\uc774\uc5b4 \uc804\ub7b5\uc5d0 \uc9c1\uc811\uc801\uc778 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc790\ub3d9\ucc28\uac00 \uc55e\uc774\ub098 \ub4a4\ub85c\ub9cc \uc774\ub3d9\ud560 \uc218 \uc788\uae30 \ub54c\ubb38\uc5d0 \ud50c\ub808\uc774\uc5b4\ub294 \ub9c9\ub2e4\ub978 \uace8\ubaa9\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uc774\ub3d9\uc744 \uc2e0\uc911\ud558\uac8c \uacc4\ud68d\ud574\uc57c \ud569\ub2c8\ub2e4. 25\ubc88 \ub808\ubca8\uc5d0\uc11c \uacf5\uac04 \uc81c\uc57d \uba54\ucee4\ub2c8\uc998\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uba87 \ub2e8\uacc4 \uc55e\uc11c \uc0dd\uac01\ud558\ub3c4\ub85d \uac15\uc694\ud569\ub2c8\ub2e4. [\uc124\uc815 \ub300\uc870\ud45c: \ub808\ubca8 10: \uac04\ub2e8\ud55c \uadf8\ub9ac\ub4dc. \ub808\ubca8 25: \uc81c\ud55c\ub41c \uacf5\uac04\uc744 \uac00\uc9c4 \ubcf5\uc7a1\ud55c \uadf8\ub9ac\ub4dc.]"}, {"question": "\ud558\ub098\uc758 \uae30\uae30\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30\ub85c \uc8fc\ucc28 \uc7bc \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub124, \ud074\ub77c\uc6b0\ub4dc \uacc4\uc815\uc5d0 \uac8c\uc784\uc744 \uc5f0\uacb0\ud558\uc5ec \uc8fc\ucc28 \uc7bc \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub807\uac8c \ud558\uba74 \uc5ec\ub7ec \uae30\uae30\uc5d0\uc11c \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc548\ub4dc\ub85c\uc774\ub4dc \ud3f0\uc5d0\uc11c \uc544\uc774\ud3f0\uc73c\ub85c \uc804\ud658\ud558\ub294 \uacbd\uc6b0, \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uc5ec \uc911\ub2e8\ud588\ub358 \uacf3\uc5d0\uc11c \uacc4\uc18d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \uae30\uae30 A -> \ud074\ub77c\uc6b0\ub4dc \ub3d9\uae30\ud654 -> \uae30\uae30 B.]"}, {"question": "\uc8fc\ucc28 \uc7bc\uc5d0\ub294 \uc228\uaca8\uc9c4 \uc131\ucde8\ub3c4\ub098 \ube44\ubc00\uc774 \uc788\ub098\uc694?", "answer": "\ub124, \uc8fc\ucc28 \uc7bc\uc5d0\ub294 \uace0\uc720\ud55c \ubc29\uc2dd\uc73c\ub85c \ub808\ubca8\uc744 \uc644\ub8cc\ud55c \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ubcf4\uc0c1\uc744 \uc8fc\ub294 \uc228\uaca8\uc9c4 \uc131\ucde8\ub3c4\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ucd5c\uc18c\ud55c\uc758 \uc774\ub3d9\uc73c\ub85c \ub808\ubca8\uc744 \ud574\uacb0\ud558\ub294 \uc131\ucde8\ub3c4\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc774\uac83\uc744 \ud574\uc81c\ud558\ub824\uba74 \uac01 \uc774\ub3d9\uc744 \uc2e0\uc911\ud558\uac8c \uacc4\ud68d\ud558\uace0 \ubd88\ud544\uc694\ud55c \ub2e8\uacc4\ub97c \ud53c\ud574\uc57c \ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc815\ud655\ud55c \uc9c0\ub3c4\ub97c \ub530\ub77c \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uc744 \ucc3e\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "\uc8fc\ucc28 \uc7bc\uc774 \ub2e4\ub978 \ud37c\uc990 \uac8c\uc784\uacfc \ub2e4\ub978 \ub3c5\ud2b9\ud55c \uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc8fc\ucc28 \uc7bc\uc740 \uac04\ub2e8\ud558\uc9c0\ub9cc \ub3c4\uc804\uc801\uc778 \uba54\ucee4\ub2c8\uc998\uacfc \ub2e4\uc591\ud55c \ub808\ubca8 \ub514\uc790\uc778\uc73c\ub85c \ub2e4\ub978 \ud37c\uc990 \uac8c\uc784\uacfc \ucc28\ubcc4\ud654\ub429\ub2c8\ub2e4. \ub2e4\ub978 \ud37c\uc990 \uac8c\uc784\uacfc \ub2ec\ub9ac \uc804\ub7b5\uc801 \uacc4\ud68d\uacfc \uacf5\uac04 \uc778\uc2dd\uc5d0 \uc911\uc810\uc744 \ub461\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uac8c\uc784\uc740 \uc9c4\ud589\ud558\uba74\uc11c \uc790\ub3d9\ucc28 \ud06c\uae30\uac00 \ub2e4\ub974\uace0 \uc7a5\uc560\ubb3c\uacfc \uac19\uc740 \uc0c8\ub85c\uc6b4 \uc694\uc18c\ub97c \ub3c4\uc785\ud558\uc5ec \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc2e0\uc120\ud558\uace0 \ub9e4\ub825\uc801\uc73c\ub85c \uc720\uc9c0\ud569\ub2c8\ub2e4. [\uc5ec\ub7ec \ubc29\ubc95 \ube44\uad50: \uc8fc\ucc28 \uc7bc: \uc790\ub3d9\ucc28 \uc774\ub3d9\uc5d0 \uc911\uc810. \ub2e4\ub978 \ud37c\uc990 \uac8c\uc784: \ub9e4\uce58\ub098 \ud0c0\uc774\ubc0d\uc5d0 \uc911\uc810.]"}]
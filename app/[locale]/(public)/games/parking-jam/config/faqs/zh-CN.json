[{"question": "\u5982\u4f55\u5728\u505c\u8f66\u573a\u62e5\u5835\u6e38\u620f\u4e2d\u5b8c\u6210\u7b2c\u4e00\u4e2a\u5173\u5361\uff1f", "answer": "\u5728\u505c\u8f66\u573a\u62e5\u5835\u6e38\u620f\u4e2d\u79fb\u52a8\u8f66\u8f86\uff0c\u53ea\u9700\u8f7b\u89e6\u5e76\u62d6\u52a8\u8f66\u8f86\u5230\u53ef\u4ee5\u79fb\u52a8\u7684\u65b9\u5411\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u4e2a\u5173\u5361\u4e2d\uff0c\u4f60\u53ef\u4ee5\u5c06\u7ea2\u8272\u6c7d\u8f66\u5411\u53f3\u79fb\u52a8\uff0c\u4e3a\u9ec4\u8272\u6c7d\u8f66\u6e05\u7406\u9053\u8def\u3002\u8bb0\u4f4f\uff0c\u6c7d\u8f66\u53ea\u80fd\u524d\u540e\u79fb\u52a8\uff0c\u4e0d\u80fd\u5de6\u53f3\u79fb\u52a8\u3002\u8fd9\u79cd\u57fa\u672c\u673a\u5236\u5bf9\u4e8e\u901a\u5173\u6e38\u620f\u81f3\u5173\u91cd\u8981\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u53ef\u4ee5\u5c06\u5b83\u60f3\u8c61\u6210\u6ed1\u52a8\u62fc\u56fe\uff0c\u521b\u5efa\u4e00\u6761\u6e05\u6670\u7684\u8def\u5f84\u3002]"}, {"question": "\u5728\u505c\u8f66\u573a\u62e5\u5835\u6e38\u620f\u4e2d\u63d0\u524d\u89c4\u5212\u79fb\u52a8\u6b65\u9aa4\u6709\u4ec0\u4e48\u91cd\u8981\u6027\uff1f", "answer": "\u5728\u505c\u8f66\u573a\u62e5\u5835\u6e38\u620f\u4e2d\u63d0\u524d\u89c4\u5212\u79fb\u52a8\u6b65\u9aa4\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u80fd\u5e2e\u52a9\u4f60\u907f\u514d\u5361\u4f4f\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u79fb\u52a8\u4e00\u8f86\u6c7d\u8f66\u800c\u6ca1\u6709\u8003\u8651\u4e0b\u4e00\u6b65\uff0c\u4f60\u53ef\u80fd\u4f1a\u5835\u4f4f\u53e6\u4e00\u8f86\u6c7d\u8f66\u7684\u51fa\u53e3\u3002\u59cb\u7ec8\u9884\u60f3\u6bcf\u8f86\u8f66\u7684\u6700\u7ec8\u4f4d\u7f6e\uff0c\u5e76\u5012\u63a8\u89e3\u51b3\u65b9\u6cd5\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u65b9\u6848A\uff1a\u5148\u79fb\u52a8\u84dd\u8272\u6c7d\u8f66\u3002\u65b9\u6848B\uff1a\u5148\u79fb\u52a8\u7ea2\u8272\u6c7d\u8f66\u3002\u6bd4\u8f83\u54ea\u79cd\u65b9\u6848\u80fd\u66f4\u5feb\u5730\u89e3\u51b3\u95ee\u9898\u3002]"}, {"question": "\u6bcf\u4e2a\u65b0\u73a9\u5bb6\u90fd\u5e94\u8be5\u4e86\u89e3\u505c\u8f66\u573a\u62e5\u5835\u6e38\u620f\u7684\u57fa\u672c\u89c4\u5219\u662f\u4ec0\u4e48\uff1f", "answer": "\u505c\u8f66\u573a\u62e5\u5835\u6e38\u620f\u7684\u57fa\u672c\u89c4\u5219\u5305\u62ec\uff1a1\uff09\u6c7d\u8f66\u53ea\u80fd\u524d\u540e\u79fb\u52a8\uff1b2\uff09\u4f60\u9700\u8981\u6e05\u7406\u76ee\u6807\u6c7d\u8f66\u7684\u51fa\u53e3\u8def\u5f84\uff1b3\uff09\u6bcf\u4e2a\u5173\u5361\u90fd\u6709\u72ec\u7279\u7684\u5e03\u5c40\uff0c\u9700\u8981\u4e0d\u540c\u7684\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e94\u5173\uff0c\u4f60\u9700\u8981\u5148\u79fb\u52a8\u7eff\u8272\u6c7d\u8f66\uff0c\u624d\u80fd\u8ba9\u84dd\u8272\u6c7d\u8f66\u9a76\u51fa\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u7b2c\u4e00\u5173\uff1a\u79fb\u52a8\u7ea2\u8272\u8f66\u8f86\u5411\u53f3\u3002\u7b2c\u4e94\u5173\uff1a\u5148\u79fb\u52a8\u7eff\u8272\u6c7d\u8f66\u3002]"}, {"question": "\u5982\u4f55\u4f18\u5316\u6211\u7684\u79fb\u52a8\u4ee5\u66f4\u5feb\u5730\u5b8c\u6210\u505c\u8f66\u573a\u62e5\u5835\u6e38\u620f\u7684\u5173\u5361\uff1f", "answer": "\u4e3a\u4e86\u4f18\u5316\u505c\u8f66\u573a\u62e5\u5835\u6e38\u620f\u4e2d\u7684\u79fb\u52a8\uff0c\u8bf7\u9075\u5faa\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41\uff1a\u8bc6\u522b\u76ee\u6807\u6c7d\u8f66\u53ca\u5176\u51fa\u53e3\u8def\u5f84\u3002\u6b65\u9aa42\uff1a\u786e\u5b9a\u54ea\u4e9b\u6c7d\u8f66\u963b\u585e\u4e86\u8def\u5f84\u3002\u6b65\u9aa43\uff1a\u6709\u6548\u5730\u89c4\u5212\u79fb\u52a8\u987a\u5e8f\uff0c\u6e05\u7406\u8def\u5f84\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u5341\u5173\uff0c\u5148\u79fb\u52a8\u9ec4\u8272\u6c7d\u8f66\u53ef\u4ee5\u663e\u8457\u51cf\u5c11\u6240\u9700\u7684\u79fb\u52a8\u6b21\u6570\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u5f00\u59cb -> \u8bc6\u522b\u76ee\u6807\u6c7d\u8f66 -> \u6e05\u7406\u8def\u5f84 -> \u9a76\u51fa\u3002]"}, {"question": "\u54ea\u4e9b\u9ad8\u7ea7\u7b56\u7565\u53ef\u4ee5\u5e2e\u52a9\u6211\u89e3\u51b3\u590d\u6742\u7684\u505c\u8f66\u573a\u62e5\u5835\u96be\u9898\uff1f", "answer": "\u505c\u8f66\u573a\u62e5\u5835\u6e38\u620f\u7684\u9ad8\u7ea7\u7b56\u7565\u5305\u62ec\uff1a1\uff09\u56de\u6eaf\uff1a\u6709\u65f6\uff0c\u5c06\u6c7d\u8f66\u5411\u540e\u79fb\u52a8\u53ef\u4ee5\u5f00\u8f9f\u65b0\u7684\u8def\u5f84\u30022\uff09\u8fde\u73af\u79fb\u52a8\uff1a\u89c4\u5212\u4e00\u4e2a\u5e8f\u5217\uff0c\u5176\u4e2d\u4e00\u6b21\u79fb\u52a8\u53ef\u4ee5\u542f\u7528\u4e0b\u4e00\u6b21\u79fb\u52a8\u30023\uff09\u4f18\u5148\u7ea7\uff1a\u9996\u5148\u5173\u6ce8\u963b\u788d\u591a\u6761\u8def\u5f84\u7684\u8f66\u8f86\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e8c\u5341\u5173\uff0c\u56de\u6eaf\u84dd\u8272\u6c7d\u8f66\u53ef\u4ee5\u8ba9\u7ea2\u8272\u6c7d\u8f66\u5411\u524d\u79fb\u52a8\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u65b9\u6848A\uff1a\u5c06\u84dd\u8272\u6c7d\u8f66\u5411\u540e\u79fb\u52a8\u3002\u65b9\u6848B\uff1a\u5148\u79fb\u52a8\u7ea2\u8272\u6c7d\u8f66\u3002\u6bd4\u8f83\u54ea\u79cd\u65b9\u6848\u66f4\u9ad8\u6548\u3002]"}, {"question": "\u505c\u8f66\u573a\u62e5\u5835\u6e38\u620f\u4e2d\u7684\u7f51\u683c\u5e03\u5c40\u6709\u4ec0\u4e48\u610f\u4e49\uff1f", "answer": "\u505c\u8f66\u573a\u62e5\u5835\u6e38\u620f\u4e2d\u7684\u7f51\u683c\u5e03\u5c40\u51b3\u5b9a\u4e86\u6bcf\u8f86\u8f66\u7684\u79fb\u52a8\u53ef\u80fd\u6027\u3002\u6bcf\u4e2a\u5173\u5361\u90fd\u6709\u4e00\u4e2a\u72ec\u7279\u7684\u7f51\u683c\uff0c\u5b9a\u4e49\u4e86\u8d77\u59cb\u4f4d\u7f6e\u548c\u53ef\u80fd\u7684\u79fb\u52a8\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u5341\u4e94\u5173\uff0c\u7f51\u683c\u8bbe\u8ba1\u4f7f\u5f97\u6700\u521d\u53ea\u6709\u7eff\u8272\u6c7d\u8f66\u53ef\u4ee5\u79fb\u52a8\uff0c\u4e3a\u5176\u4f59\u6e38\u620f\u7684\u8c1c\u9898\u5960\u5b9a\u4e86\u57fa\u7840\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u5c06\u7f51\u683c\u60f3\u8c61\u6210\u68cb\u76d8\uff0c\u6bcf\u8f86\u8f66\u90fd\u662f\u5177\u6709\u7279\u5b9a\u79fb\u52a8\u89c4\u5219\u7684\u68cb\u5b50\u3002]"}, {"question": "\u505c\u8f66\u573a\u62e5\u5835\u6e38\u620f\u7684\u6e38\u620f\u673a\u5236\u5982\u4f55\u5f71\u54cd\u73a9\u5bb6\u7684\u7b56\u7565\uff1f", "answer": "\u505c\u8f66\u573a\u62e5\u5835\u6e38\u620f\u7684\u6e38\u620f\u673a\u5236\uff0c\u4f8b\u5982\u79fb\u52a8\u9650\u5236\u548c\u7f51\u683c\u5e03\u5c40\uff0c\u76f4\u63a5\u5f71\u54cd\u73a9\u5bb6\u7684\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u7531\u4e8e\u6c7d\u8f66\u53ea\u80fd\u524d\u540e\u79fb\u52a8\uff0c\u73a9\u5bb6\u5fc5\u987b\u4ed4\u7ec6\u8ba1\u5212\u4ed6\u4eec\u7684\u79fb\u52a8\uff0c\u907f\u514d\u6b7b\u80e1\u540c\u3002\u5728\u7b2c\u4e8c\u5341\u4e94\u5173\uff0c\u6709\u9650\u7684\u7a7a\u95f4\u673a\u5236\u8feb\u4f7f\u73a9\u5bb6\u63d0\u524d\u591a\u6b65\u601d\u8003\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u7b2c\u5341\u5173\uff1a\u7b80\u5355\u7684\u7f51\u683c\u3002\u7b2c\u4e8c\u5341\u4e94\u5173\uff1a\u590d\u6742\u7684\u7f51\u683c\uff0c\u7a7a\u95f4\u6709\u9650\u3002]"}, {"question": "\u6211\u80fd\u5426\u5c06\u6211\u7684\u505c\u8f66\u573a\u62e5\u5835\u6e38\u620f\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u8bbe\u5907\u8f6c\u79fb\u5230\u53e6\u4e00\u4e2a\u8bbe\u5907\uff1f", "answer": "\u662f\u7684\uff0c\u4f60\u53ef\u4ee5\u901a\u8fc7\u5c06\u4f60\u7684\u6e38\u620f\u94fe\u63a5\u5230\u4e91\u5e10\u6237\u6765\u8f6c\u79fb\u4f60\u7684\u505c\u8f66\u573a\u62e5\u5835\u6e38\u620f\u8fdb\u5ea6\u3002\u8fd9\u5141\u8bb8\u4f60\u5728\u591a\u4e2a\u8bbe\u5907\u4e0a\u540c\u6b65\u4f60\u7684\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4ece\u5b89\u5353\u624b\u673a\u5207\u6362\u5230\u82f9\u679c\u624b\u673a\uff0c\u53ea\u9700\u4f7f\u7528\u76f8\u540c\u7684\u5e10\u6237\u767b\u5f55\u5373\u53ef\u7ee7\u7eed\u672a\u5b8c\u6210\u7684\u6e38\u620f\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u8bbe\u5907A -> \u4e91\u540c\u6b65 -> \u8bbe\u5907B\u3002]"}, {"question": "\u505c\u8f66\u573a\u62e5\u5835\u6e38\u620f\u4e2d\u662f\u5426\u5b58\u5728\u4efb\u4f55\u9690\u85cf\u6210\u5c31\u6216\u79d8\u5bc6\uff1f", "answer": "\u662f\u7684\uff0c\u505c\u8f66\u573a\u62e5\u5835\u6e38\u620f\u6709\u9690\u85cf\u6210\u5c31\uff0c\u5956\u52b1\u73a9\u5bb6\u4ee5\u72ec\u7279\u7684\u65b9\u5f0f\u5b8c\u6210\u5173\u5361\u3002\u4f8b\u5982\uff0c\u6709\u4e00\u4e2a\u6210\u5c31\u5956\u52b1\u73a9\u5bb6\u4ee5\u6700\u5c11\u79fb\u52a8\u6b21\u6570\u89e3\u51b3\u4e00\u4e2a\u5173\u5361\u3002\u4e3a\u4e86\u89e3\u5f00\u5b83\uff0c\u4f60\u9700\u8981\u4ed4\u7ec6\u8ba1\u5212\u6bcf\u6b21\u79fb\u52a8\uff0c\u907f\u514d\u4e0d\u5fc5\u8981\u7684\u6b65\u9aa4\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u8fd9\u5c31\u50cf\u6839\u636e\u7cbe\u786e\u7684\u5730\u56fe\u627e\u5230\u9690\u85cf\u7684\u5b9d\u85cf\u3002]"}, {"question": "\u4e0e\u5176\u4ed6\u76ca\u667a\u6e38\u620f\u76f8\u6bd4\uff0c\u4ec0\u4e48\u8ba9\u505c\u8f66\u573a\u62e5\u5835\u6e38\u620f\u72ec\u5177\u7279\u8272\uff1f", "answer": "\u505c\u8f66\u573a\u62e5\u5835\u6e38\u620f\u51ed\u501f\u5176\u7b80\u5355\u800c\u5177\u6709\u6311\u6218\u6027\u7684\u673a\u5236\u548c\u5404\u79cd\u5173\u5361\u8bbe\u8ba1\u8131\u9896\u800c\u51fa\u3002\u4e0e\u5176\u4ed6\u76ca\u667a\u6e38\u620f\u4e0d\u540c\uff0c\u5b83\u4e13\u6ce8\u4e8e\u6218\u7565\u89c4\u5212\u548c\u7a7a\u95f4\u610f\u8bc6\u3002\u4f8b\u5982\uff0c\u968f\u7740\u6e38\u620f\u7684\u8fdb\u5c55\uff0c\u6e38\u620f\u5f15\u5165\u4e86\u4e0d\u540c\u6c7d\u8f66\u5c3a\u5bf8\u548c\u969c\u788d\u7269\u7b49\u65b0\u5143\u7d20\uff0c\u4f7f\u6e38\u620f\u73a9\u6cd5\u4fdd\u6301\u65b0\u9c9c\u548c\u5f15\u4eba\u5165\u80dc\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u505c\u8f66\u573a\u62e5\u5835\u6e38\u620f\uff1a\u4e13\u6ce8\u4e8e\u6c7d\u8f66\u79fb\u52a8\u3002\u5176\u4ed6\u76ca\u667a\u6e38\u620f\uff1a\u4e13\u6ce8\u4e8e\u5339\u914d\u6216\u65f6\u95f4\u3002]"}]
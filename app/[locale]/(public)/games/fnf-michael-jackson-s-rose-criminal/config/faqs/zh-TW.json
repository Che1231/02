[{"question": "\u5982\u4f55\u5728\u521d\u5b78\u8005\u6a21\u5f0f\u4e0b\u9032\u884cFNF\uff1a\u9ea5\u53ef\u5091\u514b\u68ee\u7684\u73ab\u7470\u7f6a\u72af\u7684\u57fa\u672c\u52d5\u4f5c\uff1f", "answer": "\u5728FNF\uff1a\u9ea5\u53ef\u5091\u514b\u68ee\u7684\u73ab\u7470\u7f6a\u72af\u4e2d\uff0c\u57fa\u672c\u52d5\u4f5c\u5305\u62ec\u6839\u64da\u97f3\u6a02\u7bc0\u62cd\u6572\u64ca\u65b9\u5411\u9375\u3002\u4f8b\u5982\uff0c\u5728\u300cBeat It\u300d\u7247\u6bb5\u4e2d\uff0c\u4f60\u6703\u770b\u5230\u7bad\u982d\u5728\u87a2\u5e55\u4e0a\u6efe\u52d5\u3002\u7576\u7bad\u982d\u5230\u9054\u76ee\u6a19\u5340\u57df\u6642\uff0c\u6309\u4e0b\u76f8\u61c9\u7684\u65b9\u5411\u9375\u3002\u6b65\u9a5f1\uff1a\u4ed4\u7d30\u89c0\u5bdf\u7bad\u982d\u3002\u6b65\u9a5f2\uff1a\u6e96\u78ba\u5730\u5c07\u6309\u9375\u6642\u9593\u8207\u7bc0\u62cd\u5339\u914d\u3002\u6b65\u9a5f3\uff1a\u7e7c\u7e8c\u7df4\u7fd2\u4ee5\u63d0\u9ad8\u6e96\u78ba\u6027\u3002\u628a\u5b83\u60f3\u6210\u4e00\u6bb5\u821e\u8e48\uff0c\u6bcf\u500b\u52d5\u4f5c\u90fd\u5fc5\u9808\u8207\u7bc0\u594f\u5354\u8abf\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u6642\u9593\u5728FNF\uff1a\u9ea5\u53ef\u5091\u514b\u68ee\u7684\u73ab\u7470\u7f6a\u72af\u4e2d\u81f3\u95dc\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u63d0\u9ad8\u6642\u9593\u611f\uff1f", "answer": "\u5728FNF\uff1a\u9ea5\u53ef\u5091\u514b\u68ee\u7684\u73ab\u7470\u7f6a\u72af\u4e2d\uff0c\u6642\u9593\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u76f4\u63a5\u5f71\u97ff\u4f60\u7684\u5f97\u5206\u548c\u8868\u73fe\u3002\u4f8b\u5982\uff0c\u5728\u300cThriller\u300d\u6b4c\u66f2\u4e2d\uff0c\u932f\u904e\u7bc0\u62cd\u6703\u5c0e\u81f4\u9023\u64ca\u65b7\u88c2\u3002\u8981\u6539\u5584\uff0c\u6b65\u9a5f1\uff1a\u4f7f\u7528\u7df4\u7fd2\u6a21\u5f0f\u719f\u6089\u6b4c\u66f2\u7bc0\u594f\u3002\u6b65\u9a5f2\uff1a\u5c08\u6ce8\u65bc\u8996\u89ba\u63d0\u793a\u548c\u97f3\u6a02\u7684\u7bc0\u594f\u3002\u6b65\u9a5f3\uff1a\u96a8\u8457\u4f60\u7684\u63d0\u5347\uff0c\u9010\u6b65\u63d0\u9ad8\u96e3\u5ea6\u3002\u9019\u5c31\u50cf\u5b78\u7fd2\u6f14\u594f\u6a02\u5668\u4e00\u6a23\uff0c\u719f\u80fd\u751f\u5de7\u3002"}, {"question": "\u5728FNF\uff1a\u9ea5\u53ef\u5091\u514b\u68ee\u7684\u73ab\u7470\u7f6a\u72af\u4e2d\uff0c\u6211\u9700\u8981\u4e86\u89e3\u54ea\u4e9b\u57fa\u672c\u63a7\u5236\uff1f", "answer": "FNF\uff1a\u9ea5\u53ef\u5091\u514b\u68ee\u7684\u73ab\u7470\u7f6a\u72af\u4e2d\u7684\u57fa\u672c\u63a7\u5236\u662f\u65b9\u5411\u9375\uff1a\u4e0a\u3001\u4e0b\u3001\u5de6\u3001\u53f3\u3002\u4f8b\u5982\uff0c\u5728\u300cBillie Jean\u300d\u66f2\u76ee\u4e2d\uff0c\u4f60\u5c07\u4f7f\u7528\u9019\u4e9b\u9375\u8207\u97f3\u6a02\u7bc0\u62cd\u540c\u6b65\u64ca\u6253\u7bc0\u62cd\u9ede\u3002\u6b64\u5916\uff0c\u5728\u67d0\u4e9b\u7247\u6bb5\u4e2d\uff0c\u53ef\u4ee5\u4f7f\u7528\u7a7a\u683c\u9375\u57f7\u884c\u7279\u6b8a\u52d5\u4f5c\u3002\u628a\u9019\u4e9b\u63a7\u5236\u9375\u60f3\u50cf\u6210\u9ea5\u53ef\u5091\u514b\u68ee\u7d93\u5178\u821e\u6b65\u7684\u821e\u6b65\u3002"}, {"question": "\u5728\u73a9\u4e86FNF\uff1a\u9ea5\u53ef\u5091\u514b\u68ee\u7684\u73ab\u7470\u7f6a\u72af100\u5c0f\u6642\u5f8c\uff0c\u5982\u4f55\u638c\u63e1\u5148\u9032\u7b56\u7565\uff1f", "answer": "\u5728FNF\uff1a\u9ea5\u53ef\u5091\u514b\u68ee\u7684\u73ab\u7470\u7f6a\u72af\u4e2d\u638c\u63e1\u5148\u9032\u7b56\u7565\uff0c\u9700\u8981\u7406\u89e3\u6a21\u5f0f\u4e26\u512a\u5316\u4f60\u7684\u8868\u73fe\u3002\u4f8b\u5982\uff0c\u5728\u300cSmooth Criminal\u300d\u4e2d\uff0c\u7bc0\u62cd\u6a21\u5f0f\u91cd\u8907\uff0c\u56e0\u6b64\u8b58\u5225\u5b83\u5011\u53ef\u4ee5\u8b93\u4f60\u4f54\u64da\u512a\u52e2\u3002\u6b65\u9a5f1\uff1a\u5206\u6790\u6b4c\u66f2\u7684\u7d50\u69cb\u548c\u7bc0\u62cd\u6a21\u5f0f\u3002\u6b65\u9a5f2\uff1a\u6301\u7e8c\u7df4\u7fd2\u5efa\u7acb\u808c\u8089\u8a18\u61b6\u3002\u6b65\u9a5f3\uff1a\u5617\u8a66\u4e0d\u540c\u7684\u7b56\u7565\uff0c\u627e\u5230\u6700\u9069\u5408\u4f60\u7684\u7b56\u7565\u3002\u9019\u5c31\u50cf\u638c\u63e1\u4e00\u9023\u4e32\u8907\u96dc\u7684\u821e\u8e48\u52d5\u4f5c\uff0c\u5176\u4e2d\u7cbe\u78ba\u6027\u548c\u6642\u9593\u611f\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u5728FNF\uff1a\u9ea5\u53ef\u5091\u514b\u68ee\u7684\u73ab\u7470\u7f6a\u72af\u4e2d\uff0c\u6211\u53ef\u4ee5\u7528\u4ec0\u9ebc\u7b56\u7565\u7372\u5f97\u9ad8\u5206\uff1f", "answer": "\u5728FNF\uff1a\u9ea5\u53ef\u5091\u514b\u68ee\u7684\u73ab\u7470\u7f6a\u72af\u4e2d\u7372\u5f97\u9ad8\u5206\u9700\u8981\u6e96\u78ba\u6027\u548c\u4e00\u81f4\u6027\u76f8\u7d50\u5408\u3002\u4f8b\u5982\uff0c\u5728\u300cBad\u300d\u4e2d\uff0c\u4fdd\u6301\u9023\u64ca\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u4f60\u7684\u5f97\u5206\u3002\u6b65\u9a5f1\uff1a\u5c08\u6ce8\u65bc\u5b8c\u7f8e\u5730\u64ca\u4e2d\u6bcf\u500b\u7bc0\u62cd\u9ede\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u7df4\u7fd2\u6a21\u5f0f\u4f86\u7cbe\u7149\u4f60\u7684\u6642\u9593\u611f\u3002\u6b65\u9a5f3\uff1a\u4fdd\u6301\u51b7\u975c\u548c\u93ae\u5b9a\uff0c\u5373\u4f7f\u5728\u7bc0\u594f\u5feb\u901f\u7684\u6bb5\u843d\u3002\u9019\u5c31\u50cf\u5728\u97f3\u6a02\u6703\u4e2d\u8868\u6f14\u4e00\u6a23\uff0c\u6bcf\u500b\u97f3\u7b26\u90fd\u5f88\u91cd\u8981\u3002"}, {"question": "\u5982\u4f55\u5728FNF\uff1a\u9ea5\u53ef\u5091\u514b\u68ee\u7684\u73ab\u7470\u7f6a\u72af\u4e2d\u512a\u5316\u6211\u7684\u904a\u6232\uff0c\u4ee5\u61c9\u5c0d\u66f4\u9ad8\u96e3\u5ea6\uff1f", "answer": "\u5728FNF\uff1a\u9ea5\u53ef\u5091\u514b\u68ee\u7684\u73ab\u7470\u7f6a\u72af\u4e2d\u512a\u5316\u66f4\u9ad8\u96e3\u5ea6\u7684\u904a\u6232\uff0c\u9700\u8981\u63d0\u9ad8\u53cd\u61c9\u6642\u9593\u548c\u6a21\u5f0f\u8b58\u5225\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u5728\u300cBlack or White\u300d\u4e2d\uff0c\u7bc0\u62cd\u9ede\u51fa\u73fe\u5f97\u66f4\u5feb\uff0c\u4e26\u4e14\u66f4\u8907\u96dc\u3002\u9019\u9700\u8981\u66f4\u5feb\u7684\u53cd\u61c9\u901f\u5ea6\u548c\u66f4\u597d\u7684\u6642\u9593\u611f\u3002\u904a\u6232\u6a5f\u5236\u4fdd\u6301\u4e0d\u8b8a\uff0c\u4f46\u6311\u6230\u6027\u589e\u52a0\uff0c\u56e0\u6b64\u9069\u61c9\u7b56\u7565\u81f3\u95dc\u91cd\u8981\u3002\u628a\u5b83\u60f3\u8c61\u6210\u4e00\u5834\u96a8\u8457\u9032\u5ea6\u8b8a\u5f97\u8d8a\u4f86\u8d8a\u8907\u96dc\u7684\u821e\u8e48\u8868\u6f14\u3002"}, {"question": "FNF\uff1a\u9ea5\u53ef\u5091\u514b\u68ee\u7684\u73ab\u7470\u7f6a\u72af\u4e2d\u8a08\u5206\u7cfb\u7d71\u80cc\u5f8c\u7684\u95dc\u9375\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "FNF\uff1a\u9ea5\u53ef\u5091\u514b\u68ee\u7684\u73ab\u7470\u7f6a\u72af\u4e2d\u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u6e96\u78ba\u6027\u548c\u9023\u64ca\u3002\u4f8b\u5982\uff0c\u5728\u300cDon't Stop 'Til You Get Enough\u300d\u4e2d\uff0c\u5b8c\u7f8e\u64ca\u4e2d\u7bc0\u62cd\u9ede\u6703\u589e\u52a0\u4f60\u7684\u5f97\u5206\u500d\u6578\u3002\u4f60\u7684\u6642\u9593\u611f\u8d8a\u597d\uff0c\u5f97\u5206\u5c31\u8d8a\u9ad8\u3002\u6b64\u5916\uff0c\u4fdd\u6301\u9023\u64ca\u800c\u4e0d\u932f\u904e\u7bc0\u62cd\u9ede\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u4f60\u7684\u6700\u7d42\u5f97\u5206\u3002\u9019\u5c31\u50cf\u4e00\u5834\u821e\u8e48\u8868\u6f14\uff0c\u6bcf\u500b\u52d5\u4f5c\u90fd\u6839\u64da\u7cbe\u6e96\u6027\u548c\u6280\u5de7\u9032\u884c\u8a55\u4f30\u3002"}, {"question": "\u904a\u6232\u96e3\u5ea6\u5982\u4f55\u5f71\u97ffFNF\uff1a\u9ea5\u53ef\u5091\u514b\u68ee\u7684\u73ab\u7470\u7f6a\u72af\u7684\u904a\u6232\u6a5f\u5236\uff1f", "answer": "FNF\uff1a\u9ea5\u53ef\u5091\u514b\u68ee\u7684\u73ab\u7470\u7f6a\u72af\u4e2d\u7684\u904a\u6232\u96e3\u5ea6\u6703\u5f71\u97ff\u7bc0\u62cd\u9ede\u7684\u901f\u7387\u548c\u8907\u96dc\u6027\u3002\u4f8b\u5982\uff0c\u5728\u300cRock with You\u300d\u4e2d\uff0c\u66f4\u9ad8\u96e3\u5ea6\u6703\u5f15\u5165\u66f4\u5feb\u901f\u548c\u66f4\u7cbe\u5bc6\u7684\u7bc0\u62cd\u9ede\u5e8f\u5217\u3002\u9019\u9700\u8981\u66f4\u5feb\u7684\u53cd\u61c9\u80fd\u529b\u548c\u66f4\u597d\u7684\u6642\u9593\u611f\u3002\u904a\u6232\u6a5f\u5236\u4fdd\u6301\u4e0d\u8b8a\uff0c\u4f46\u6311\u6230\u6027\u589e\u52a0\uff0c\u56e0\u6b64\u9069\u61c9\u4f60\u7684\u7b56\u7565\u81f3\u95dc\u91cd\u8981\u3002\u628a\u5b83\u60f3\u50cf\u6210\u4e00\u5834\u821e\u52d5\u52d5\u4f5c\u65e5\u76ca\u8907\u96dc\u7684\u821e\u8e48\u8868\u6f14\u3002"}, {"question": "\u5982\u4f55\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e0a\u78ba\u4fddFNF\uff1a\u9ea5\u53ef\u5091\u514b\u68ee\u7684\u73ab\u7470\u7f6a\u72af\u7684\u76f8\u5bb9\u6027\uff1f", "answer": "\u78ba\u4fddFNF\uff1a\u9ea5\u53ef\u5091\u514b\u68ee\u7684\u73ab\u7470\u7f6a\u72af\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u7684\u76f8\u5bb9\u6027\uff0c\u9700\u8981\u6aa2\u67e5\u7cfb\u7d71\u9700\u6c42\u548c\u4f7f\u7528\u76f8\u5bb9\u7684\u8f38\u5165\u88dd\u7f6e\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728PC\u4e0a\u904a\u6232\uff0c\u8acb\u78ba\u4fdd\u4f60\u7684\u9375\u76e4\u53cd\u61c9\u9748\u654f\u3002\u5982\u679c\u4f60\u5207\u63db\u5230\u904a\u6232\u4e3b\u6a5f\uff0c\u8acb\u78ba\u4fdd\u904a\u6232\u652f\u63f4\u5b83\uff0c\u4e26\u4e14\u4f60\u7684\u63a7\u5236\u5668\u5df2\u6b63\u78ba\u914d\u7f6e\u3002\u9019\u5c31\u50cf\u78ba\u4fdd\u4f60\u7684\u821e\u8e48\u978b\u5728\u4e0d\u540c\u821e\u53f0\u4e0a\u8868\u6f14\u6642\u5408\u9069\u3002"}, {"question": "\u5728FNF\uff1a\u9ea5\u53ef\u5091\u514b\u68ee\u7684\u73ab\u7470\u7f6a\u72af\u4e2d\uff0c\u6211\u53ef\u4ee5\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u5167\u5bb9\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9396\u5b83\u5011\uff1f", "answer": "FNF\uff1a\u9ea5\u53ef\u5091\u514b\u68ee\u7684\u73ab\u7470\u7f6a\u72af\u5305\u542b\u96b1\u85cf\u5167\u5bb9\uff0c\u4f8b\u5982\u5f69\u86cb\u548c\u984d\u5916\u66f2\u76ee\u3002\u4f8b\u5982\uff0c\u5b8c\u6210\u6240\u6709\u6b4c\u66f2\u7684\u9ad8\u7d1a\u96e3\u5ea6\u53ef\u80fd\u6703\u89e3\u9396\u4e00\u500b\u7279\u5225\u7684\u9ea5\u53ef\u5091\u514b\u68ee\u4e3b\u984c\u76ae\u819a\u3002\u8981\u627e\u5230\u9019\u4e9b\uff0c\u6b65\u9a5f1\uff1a\u5fb9\u5e95\u63a2\u7d22\u6240\u6709\u904a\u6232\u6a21\u5f0f\u3002\u6b65\u9a5f2\uff1a\u6ce8\u610f\u904a\u6232\u63d0\u793a\u548c\u6210\u5c31\u3002\u6b65\u9a5f3\uff1a\u5411\u793e\u7fa4\u5c0b\u6c42\u5efa\u8b70\u548c\u79d8\u5bc6\u3002\u9019\u5c31\u50cf\u5728\u821e\u8e48\u8868\u6f14\u4e2d\u767c\u73fe\u96b1\u85cf\u7684\u7de8\u6392\u3002"}]
[{"question": "\u5982\u4f55\u5728FNF\uff1a\u8fc8\u514b\u5c14\u00b7\u6770\u514b\u900a\u7684\u73ab\u7470\u7f6a\u6848\u4e2d\u4f5c\u4e3a\u65b0\u624b\u6267\u884c\u57fa\u672c\u52a8\u4f5c\uff1f", "answer": "\u5728FNF\uff1a\u8fc8\u514b\u5c14\u00b7\u6770\u514b\u900a\u7684\u73ab\u7470\u7f6a\u6848\u4e2d\uff0c\u57fa\u672c\u52a8\u4f5c\u5305\u62ec\u4e0e\u97f3\u4e50\u540c\u6b65\u70b9\u51fb\u65b9\u5411\u952e\u3002\u4f8b\u5982\uff0c\u5728\u300aBeat It\u300b\u7247\u6bb5\u4e2d\uff0c\u4f60\u4f1a\u770b\u5230\u7bad\u5934\u4ece\u5c4f\u5e55\u4e0a\u6eda\u52a8\u3002\u5f53\u7bad\u5934\u5230\u8fbe\u76ee\u6807\u533a\u57df\u65f6\uff0c\u6309\u4e0b\u76f8\u5e94\u7684\u7bad\u5934\u952e\u3002\u6b65\u9aa41\uff1a\u4ed4\u7ec6\u89c2\u5bdf\u7bad\u5934\u3002\u6b65\u9aa42\uff1a\u5c06\u6309\u952e\u65f6\u95f4\u4e0e\u8282\u62cd\u5339\u914d\u3002\u6b65\u9aa43\uff1a\u7ee7\u7eed\u7ec3\u4e60\u4ee5\u63d0\u9ad8\u51c6\u786e\u6027\u3002\u628a\u5b83\u60f3\u8c61\u6210\u4e00\u4e2a\u821e\u8e48\u52a8\u4f5c\uff0c\u6bcf\u4e2a\u6b65\u9aa4\u90fd\u5fc5\u987b\u4e0e\u8282\u594f\u4e00\u81f4\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u5728FNF\uff1a\u8fc8\u514b\u5c14\u00b7\u6770\u514b\u900a\u7684\u73ab\u7470\u7f6a\u6848\u4e2d\u65f6\u95f4\u81f3\u5173\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u6539\u8fdb\u5b83\uff1f", "answer": "\u5728FNF\uff1a\u8fc8\u514b\u5c14\u00b7\u6770\u514b\u900a\u7684\u73ab\u7470\u7f6a\u6848\u4e2d\uff0c\u65f6\u95f4\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u76f4\u63a5\u5f71\u54cd\u4f60\u7684\u5f97\u5206\u548c\u8868\u73b0\u3002\u4f8b\u5982\uff0c\u5728\u300aThriller\u300b\u6b4c\u66f2\u4e2d\uff0c\u9519\u8fc7\u4e00\u4e2a\u8282\u62cd\u53ef\u80fd\u4f1a\u7834\u574f\u4f60\u7684\u8fde\u51fb\u3002\u8981\u6539\u8fdb\uff0c\u6b65\u9aa41\uff1a\u4f7f\u7528\u7ec3\u4e60\u6a21\u5f0f\u719f\u6089\u6b4c\u66f2\u7684\u8282\u594f\u3002\u6b65\u9aa42\uff1a\u5173\u6ce8\u89c6\u89c9\u63d0\u793a\u548c\u97f3\u4e50\u7684\u8282\u62cd\u3002\u6b65\u9aa43\uff1a\u968f\u7740\u4f60\u7684\u8fdb\u6b65\u9010\u6e10\u63d0\u9ad8\u96be\u5ea6\u3002\u8fd9\u5c31\u50cf\u5b66\u4e60\u6f14\u594f\u4e50\u5668\u4e00\u6837\u2014\u2014\u719f\u80fd\u751f\u5de7\u3002"}, {"question": "\u5728FNF\uff1a\u8fc8\u514b\u5c14\u00b7\u6770\u514b\u900a\u7684\u73ab\u7470\u7f6a\u6848\u4e2d\uff0c\u6211\u9700\u8981\u4e86\u89e3\u54ea\u4e9b\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u5728FNF\uff1a\u8fc8\u514b\u5c14\u00b7\u6770\u514b\u900a\u7684\u73ab\u7470\u7f6a\u6848\u4e2d\uff0c\u57fa\u672c\u63a7\u5236\u662f\u65b9\u5411\u952e\uff1a\u4e0a\u3001\u4e0b\u3001\u5de6\u3001\u53f3\u3002\u4f8b\u5982\uff0c\u5728\u300aBillie Jean\u300b\u66f2\u76ee\u4e2d\uff0c\u4f60\u9700\u8981\u4f7f\u7528\u8fd9\u4e9b\u6309\u952e\u5728\u4e0e\u97f3\u4e50\u540c\u6b65\u7684\u60c5\u51b5\u4e0b\u51fb\u6253\u97f3\u7b26\u3002\u6b64\u5916\uff0c\u5728\u67d0\u4e9b\u5e8f\u5217\u4e2d\u53ef\u4ee5\u4f7f\u7528\u7a7a\u683c\u952e\u8fdb\u884c\u7279\u6b8a\u52a8\u4f5c\u3002\u628a\u8fd9\u4e9b\u63a7\u5236\u60f3\u8c61\u6210\u8fc8\u514b\u5c14\u00b7\u6770\u514b\u900a\u6807\u5fd7\u6027\u821e\u6b65\u7684\u821e\u6b65\u3002"}, {"question": "\u5728\u73a9\u4e86FNF\uff1a\u8fc8\u514b\u5c14\u00b7\u6770\u514b\u900a\u7684\u73ab\u7470\u7f6a\u6848100\u5c0f\u65f6\u540e\uff0c\u5982\u4f55\u638c\u63e1\u9ad8\u7ea7\u7b56\u7565\uff1f", "answer": "\u5728FNF\uff1a\u8fc8\u514b\u5c14\u00b7\u6770\u514b\u900a\u7684\u73ab\u7470\u7f6a\u6848\u4e2d\u638c\u63e1\u9ad8\u7ea7\u7b56\u7565\u9700\u8981\u7406\u89e3\u6a21\u5f0f\u5e76\u4f18\u5316\u4f60\u7684\u8868\u73b0\u3002\u4f8b\u5982\uff0c\u5728\u300aSmooth Criminal\u300b\u4e2d\uff0c\u97f3\u7b26\u6a21\u5f0f\u91cd\u590d\u51fa\u73b0\uff0c\u56e0\u6b64\u8bc6\u522b\u5b83\u4eec\u53ef\u4ee5\u8ba9\u4f60\u66f4\u80dc\u4e00\u7b79\u3002\u6b65\u9aa41\uff1a\u5206\u6790\u6b4c\u66f2\u7684\u7ed3\u6784\u548c\u97f3\u7b26\u6a21\u5f0f\u3002\u6b65\u9aa42\uff1a\u6301\u7eed\u7ec3\u4e60\u4ee5\u5efa\u7acb\u808c\u8089\u8bb0\u5fc6\u3002\u6b65\u9aa43\uff1a\u5c1d\u8bd5\u4e0d\u540c\u7684\u7b56\u7565\uff0c\u627e\u5230\u6700\u9002\u5408\u4f60\u7684\u65b9\u6cd5\u3002\u8fd9\u5c31\u50cf\u638c\u63e1\u4e00\u4e2a\u590d\u6742\u7684\u821e\u8e48\u52a8\u4f5c\uff0c\u7cbe\u786e\u548c\u65f6\u95f4\u662f\u5173\u952e\u3002"}, {"question": "\u4e3a\u4e86\u5728FNF\uff1a\u8fc8\u514b\u5c14\u00b7\u6770\u514b\u900a\u7684\u73ab\u7470\u7f6a\u6848\u4e2d\u83b7\u5f97\u9ad8\u5206\uff0c\u6211\u53ef\u4ee5\u4f7f\u7528\u54ea\u4e9b\u7b56\u7565\uff1f", "answer": "\u5728FNF\uff1a\u8fc8\u514b\u5c14\u00b7\u6770\u514b\u900a\u7684\u73ab\u7470\u7f6a\u6848\u4e2d\u83b7\u5f97\u9ad8\u5206\u9700\u8981\u51c6\u786e\u6027\u548c\u4e00\u81f4\u6027\u7684\u7ed3\u5408\u3002\u4f8b\u5982\uff0c\u5728\u300aBad\u300b\u4e2d\uff0c\u4fdd\u6301\u8fde\u51fb\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u5206\u6570\u3002\u6b65\u9aa41\uff1a\u4e13\u6ce8\u4e8e\u5b8c\u7f8e\u5730\u51fb\u6253\u6bcf\u4e2a\u97f3\u7b26\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u7ec3\u4e60\u6a21\u5f0f\u6765\u6539\u8fdb\u4f60\u7684\u65f6\u95f4\u611f\u3002\u6b65\u9aa43\uff1a\u4fdd\u6301\u51b7\u9759\u548c\u4e13\u6ce8\uff0c\u5373\u4f7f\u5728\u8282\u594f\u5feb\u901f\u7684\u7247\u6bb5\u4e2d\u3002\u8fd9\u5c31\u50cf\u5728\u97f3\u4e50\u4f1a\u4e2d\u8868\u6f14\u2014\u2014\u6bcf\u4e2a\u97f3\u7b26\u90fd\u5f88\u91cd\u8981\u3002"}, {"question": "\u5982\u4f55\u5728FNF\uff1a\u8fc8\u514b\u5c14\u00b7\u6770\u514b\u900a\u7684\u73ab\u7470\u7f6a\u6848\u4e2d\u4f18\u5316\u6211\u7684\u6e38\u620f\uff0c\u4ee5\u4fbf\u5e94\u5bf9\u66f4\u9ad8\u96be\u5ea6\u7684\u5173\u5361\uff1f", "answer": "\u5728FNF\uff1a\u8fc8\u514b\u5c14\u00b7\u6770\u514b\u900a\u7684\u73ab\u7470\u7f6a\u6848\u4e2d\u4f18\u5316\u66f4\u9ad8\u96be\u5ea6\u5173\u5361\u7684\u6e38\u620f\u9700\u8981\u63d0\u9ad8\u53cd\u5e94\u65f6\u95f4\u548c\u6a21\u5f0f\u8bc6\u522b\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u5728\u300aBlack or White\u300b\u4e2d\uff0c\u97f3\u7b26\u51fa\u73b0\u5f97\u66f4\u5feb\uff0c\u5e76\u4e14\u66f4\u590d\u6742\u3002\u8fd9\u9700\u8981\u66f4\u5feb\u7684\u53cd\u5e94\u901f\u5ea6\u548c\u66f4\u597d\u7684\u65f6\u95f4\u611f\u3002\u6e38\u620f\u673a\u5236\u4fdd\u6301\u4e0d\u53d8\uff0c\u4f46\u6311\u6218\u589e\u52a0\u4e86\uff0c\u8fd9\u4f7f\u5f97\u8c03\u6574\u4f60\u7684\u7b56\u7565\u81f3\u5173\u91cd\u8981\u3002\u628a\u5b83\u60f3\u8c61\u6210\u4e00\u4e2a\u968f\u7740\u4f60\u8fdb\u9636\u800c\u53d8\u5f97\u8d8a\u6765\u8d8a\u590d\u6742\u7684\u821e\u8e48\u52a8\u4f5c\u3002"}, {"question": "FNF\uff1a\u8fc8\u514b\u5c14\u00b7\u6770\u514b\u900a\u7684\u73ab\u7470\u7f6a\u6848\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u80cc\u540e\u7684\u5173\u952e\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "FNF\uff1a\u8fc8\u514b\u5c14\u00b7\u6770\u514b\u900a\u7684\u73ab\u7470\u7f6a\u6848\u4e2d\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u51c6\u786e\u6027\u548c\u8fde\u51fb\u3002\u4f8b\u5982\uff0c\u5728\u300aDon't Stop 'Til You Get Enough\u300b\u4e2d\uff0c\u5b8c\u7f8e\u51fb\u4e2d\u97f3\u7b26\u4f1a\u589e\u52a0\u4f60\u7684\u5206\u6570\u500d\u6570\u3002\u4f60\u7684\u65f6\u95f4\u8d8a\u51c6\u786e\uff0c\u5206\u6570\u5c31\u8d8a\u9ad8\u3002\u6b64\u5916\uff0c\u4fdd\u6301\u8fde\u51fb\uff0c\u4e0d\u6f0f\u6389\u4efb\u4f55\u97f3\u7b26\uff0c\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u6700\u7ec8\u5f97\u5206\u3002\u8fd9\u5c31\u50cf\u4e00\u573a\u821e\u8e48\u8868\u6f14\uff0c\u6bcf\u4e2a\u52a8\u4f5c\u90fd\u6839\u636e\u7cbe\u786e\u5ea6\u548c\u6280\u5de7\u8fdb\u884c\u8bc4\u5224\u3002"}, {"question": "\u96be\u5ea6\u7b49\u7ea7\u5982\u4f55\u5728FNF\uff1a\u8fc8\u514b\u5c14\u00b7\u6770\u514b\u900a\u7684\u73ab\u7470\u7f6a\u6848\u4e2d\u5f71\u54cd\u6e38\u620f\u673a\u5236\uff1f", "answer": "FNF\uff1a\u8fc8\u514b\u5c14\u00b7\u6770\u514b\u900a\u7684\u73ab\u7470\u7f6a\u6848\u4e2d\u7684\u96be\u5ea6\u7b49\u7ea7\u4f1a\u5f71\u54cd\u97f3\u7b26\u6a21\u5f0f\u7684\u901f\u5ea6\u548c\u590d\u6742\u6027\u3002\u4f8b\u5982\uff0c\u5728\u300aRock with You\u300b\u4e2d\uff0c\u66f4\u9ad8\u96be\u5ea6\u7b49\u7ea7\u4f1a\u5f15\u5165\u66f4\u5feb\u901f\u548c\u66f4\u590d\u6742\u7684\u5e8f\u5217\u3002\u8fd9\u9700\u8981\u66f4\u5feb\u7684\u53cd\u5e94\u80fd\u529b\u548c\u66f4\u597d\u7684\u65f6\u95f4\u611f\u3002\u6e38\u620f\u673a\u5236\u4fdd\u6301\u4e0d\u53d8\uff0c\u4f46\u6311\u6218\u589e\u52a0\u4e86\uff0c\u8fd9\u4f7f\u5f97\u8c03\u6574\u4f60\u7684\u7b56\u7565\u81f3\u5173\u91cd\u8981\u3002\u628a\u5b83\u60f3\u8c61\u6210\u4e00\u4e2a\u968f\u7740\u4f60\u8fdb\u6b65\u800c\u53d8\u5f97\u8d8a\u6765\u8d8a\u590d\u6742\u7684\u821e\u8e48\u52a8\u4f5c\u3002"}, {"question": "\u5982\u4f55\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u786e\u4fddFNF\uff1a\u8fc8\u514b\u5c14\u00b7\u6770\u514b\u900a\u7684\u73ab\u7470\u7f6a\u6848\u7684\u6e38\u620f\u517c\u5bb9\u6027\uff1f", "answer": "\u786e\u4fddFNF\uff1a\u8fc8\u514b\u5c14\u00b7\u6770\u514b\u900a\u7684\u73ab\u7470\u7f6a\u6848\u8de8\u5e73\u53f0\u517c\u5bb9\u6027\u9700\u8981\u68c0\u67e5\u7cfb\u7edf\u8981\u6c42\u5e76\u4f7f\u7528\u517c\u5bb9\u7684\u8f93\u5165\u8bbe\u5907\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728PC\u4e0a\u73a9\uff0c\u786e\u4fdd\u4f60\u7684\u952e\u76d8\u54cd\u5e94\u7075\u654f\u3002\u5982\u679c\u5207\u6362\u5230\u6e38\u620f\u673a\uff0c\u8bf7\u786e\u4fdd\u6e38\u620f\u652f\u6301\u8be5\u5e73\u53f0\uff0c\u5e76\u4e14\u4f60\u7684\u63a7\u5236\u5668\u914d\u7f6e\u6b63\u786e\u3002\u8fd9\u5c31\u50cf\u786e\u4fdd\u4f60\u7684\u821e\u978b\u5728\u4e0d\u540c\u821e\u53f0\u4e0a\u7684\u8868\u6f14\u4e2d\u5b8c\u5168\u5408\u811a\u3002"}, {"question": "\u5728FNF\uff1a\u8fc8\u514b\u5c14\u00b7\u6770\u514b\u900a\u7684\u73ab\u7470\u7f6a\u6848\u4e2d\uff0c\u6211\u53ef\u4ee5\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u5185\u5bb9\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9501\u5b83\u4eec\uff1f", "answer": "FNF\uff1a\u8fc8\u514b\u5c14\u00b7\u6770\u514b\u900a\u7684\u73ab\u7470\u7f6a\u6848\u5305\u62ec\u9690\u85cf\u5185\u5bb9\uff0c\u4f8b\u5982\u5f69\u86cb\u548c\u989d\u5916\u66f2\u76ee\u3002\u4f8b\u5982\uff0c\u4ee5\u4e13\u5bb6\u96be\u5ea6\u5b8c\u6210\u6240\u6709\u6b4c\u66f2\u53ef\u80fd\u4f1a\u89e3\u9501\u4e00\u4e2a\u7279\u6b8a\u7684\u8fc8\u514b\u5c14\u00b7\u6770\u514b\u900a\u4e3b\u9898\u76ae\u80a4\u3002\u8981\u627e\u5230\u8fd9\u4e9b\u5185\u5bb9\uff0c\u6b65\u9aa41\uff1a\u5f7b\u5e95\u63a2\u7d22\u6240\u6709\u6e38\u620f\u6a21\u5f0f\u3002\u6b65\u9aa42\uff1a\u6ce8\u610f\u6e38\u620f\u4e2d\u7684\u63d0\u793a\u548c\u6210\u5c31\u3002\u6b65\u9aa43\uff1a\u53c2\u4e0e\u793e\u533a\uff0c\u83b7\u53d6\u6280\u5de7\u548c\u79d8\u5bc6\u3002\u8fd9\u5c31\u50cf\u5728\u821e\u8e48\u8868\u6f14\u4e2d\u53d1\u73b0\u9690\u85cf\u7684\u7f16\u821e\u3002"}]
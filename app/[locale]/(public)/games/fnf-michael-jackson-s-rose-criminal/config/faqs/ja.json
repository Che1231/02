[{"question": "FNF:\u30de\u30a4\u30b1\u30eb\u30fb\u30b8\u30e3\u30af\u30bd\u30f3\u306e\u30ed\u30fc\u30ba\u30fb\u30af\u30ea\u30df\u30ca\u30eb\u306e\u521d\u5fc3\u8005\u5411\u3051\u306e\u57fa\u672c\u7684\u306a\u52d5\u304d\u306f\u3069\u306e\u3088\u3046\u306b\u5b9f\u884c\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "FNF:\u30de\u30a4\u30b1\u30eb\u30fb\u30b8\u30e3\u30af\u30bd\u30f3\u306e\u30ed\u30fc\u30ba\u30fb\u30af\u30ea\u30df\u30ca\u30eb\u306e\u57fa\u672c\u7684\u306a\u52d5\u304d\u306f\u3001\u97f3\u697d\u306b\u5408\u308f\u305b\u3066\u77e2\u5370\u30ad\u30fc\u3092\u62bc\u3059\u3053\u3068\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30d3\u30fc\u30c8\u30fb\u30a4\u30c3\u30c8\u300f\u30b7\u30fc\u30b1\u30f3\u30b9\u3067\u306f\u3001\u77e2\u5370\u304c\u753b\u9762\u4e0a\u3092\u30b9\u30af\u30ed\u30fc\u30eb\u3057\u307e\u3059\u3002\u77e2\u5370\u304c\u30bf\u30fc\u30b2\u30c3\u30c8\u30a8\u30ea\u30a2\u306b\u9054\u3057\u305f\u3089\u3001\u5bfe\u5fdc\u3059\u308b\u77e2\u5370\u30ad\u30fc\u3092\u62bc\u3057\u307e\u3059\u3002\u624b\u9806\uff11\uff1a\u77e2\u5370\u3092\u6ce8\u610f\u6df1\u304f\u898b\u307e\u3059\u3002\u624b\u9806\uff12\uff1a\u30d3\u30fc\u30c8\u306b\u5408\u308f\u305b\u3066\u30ad\u30fc\u3092\u62bc\u3059\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u5408\u308f\u305b\u307e\u3059\u3002\u624b\u9806\uff13\uff1a\u6b63\u78ba\u6027\u3092\u9ad8\u3081\u308b\u305f\u3081\u306b\u7df4\u7fd2\u3092\u7d9a\u3051\u307e\u3057\u3087\u3046\u3002\u3053\u308c\u306f\u3001\u5404\u30b9\u30c6\u30c3\u30d7\u304c\u30ea\u30ba\u30e0\u306b\u5408\u3063\u3066\u3044\u306a\u3051\u308c\u3070\u306a\u3089\u306a\u3044\u30c0\u30f3\u30b9\u30eb\u30fc\u30c6\u30a3\u30f3\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002"}, {"question": "FNF:\u30de\u30a4\u30b1\u30eb\u30fb\u30b8\u30e3\u30af\u30bd\u30f3\u306e\u30ed\u30fc\u30ba\u30fb\u30af\u30ea\u30df\u30ca\u30eb\u3067\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u3069\u306e\u3088\u3046\u306b\u6539\u5584\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "FNF:\u30de\u30a4\u30b1\u30eb\u30fb\u30b8\u30e3\u30af\u30bd\u30f3\u306e\u30ed\u30fc\u30ba\u30fb\u30af\u30ea\u30df\u30ca\u30eb\u3067\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u306a\u306e\u306f\u3001\u305d\u308c\u304c\u76f4\u63a5\u30b9\u30b3\u30a2\u3068\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u5f71\u97ff\u3059\u308b\u304b\u3089\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30b9\u30ea\u30e9\u30fc\u300f\u306e\u66f2\u4e2d\u3001\u30d3\u30fc\u30c8\u3092\u9003\u3059\u3068\u30b3\u30f3\u30dc\u304c\u9014\u5207\u308c\u307e\u3059\u3002\u6539\u5584\u3059\u308b\u306b\u306f\u3001\u624b\u9806\uff11\uff1a\u7df4\u7fd2\u30e2\u30fc\u30c9\u3092\u4f7f\u7528\u3057\u3066\u697d\u66f2\u306e\u30ea\u30ba\u30e0\u306b\u6163\u308c\u308b\u3002\u624b\u9806\uff12\uff1a\u8996\u899a\u7684\u306a\u624b\u304c\u304b\u308a\u3068\u97f3\u697d\u306e\u30c6\u30f3\u30dd\u306b\u96c6\u4e2d\u3059\u308b\u3002\u624b\u9806\uff13\uff1a\u3088\u308a\u826f\u3044\u30b9\u30ad\u30eb\u306b\u306a\u308b\u306b\u3064\u308c\u3066\u5f90\u3005\u306b\u96e3\u6613\u5ea6\u3092\u4e0a\u3052\u308b\u3002\u3053\u308c\u306f\u3001\u97f3\u697d\u306e\u697d\u5668\u3092\u5b66\u3076\u3088\u3046\u306a\u3082\u306e\u3067\u3001\u7df4\u7fd2\u306f\u5b8c\u74a7\u3078\u306e\u9053\u3067\u3059\u3002"}, {"question": "FNF:\u30de\u30a4\u30b1\u30eb\u30fb\u30b8\u30e3\u30af\u30bd\u30f3\u306e\u30ed\u30fc\u30ba\u30fb\u30af\u30ea\u30df\u30ca\u30eb\u3067\u5fc5\u8981\u306a\u91cd\u8981\u306a\u64cd\u4f5c\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "FNF:\u30de\u30a4\u30b1\u30eb\u30fb\u30b8\u30e3\u30af\u30bd\u30f3\u306e\u30ed\u30fc\u30ba\u30fb\u30af\u30ea\u30df\u30ca\u30eb\u3067\u5fc5\u8981\u306a\u91cd\u8981\u306a\u64cd\u4f5c\u306f\u3001\u4e0a\u3001\u4e0b\u3001\u5de6\u3001\u53f3\u306e\u77e2\u5370\u30ad\u30fc\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30d3\u30ea\u30fc\u30fb\u30b8\u30fc\u30f3\u300f\u306e\u30c8\u30e9\u30c3\u30af\u3067\u306f\u3001\u3053\u308c\u3089\u306e\u30ad\u30fc\u3092\u4f7f\u7528\u3057\u3066\u97f3\u697d\u306b\u5408\u308f\u305b\u3066\u97f3\u3092\u30d2\u30c3\u30c8\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u7279\u5b9a\u306e\u30b7\u30fc\u30b1\u30f3\u30b9\u3067\u306f\u300e\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u300f\u3092\u4f7f\u7528\u3057\u3066\u7279\u6b8a\u306a\u52d5\u304d\u3092\u5b9f\u884c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u64cd\u4f5c\u306f\u3001\u30de\u30a4\u30b1\u30eb\u30fb\u30b8\u30e3\u30af\u30bd\u30f3\u306e\u8c61\u5fb4\u7684\u306a\u52d5\u304d\u306e\u305f\u3081\u306e\u30c0\u30f3\u30b9\u30b9\u30c6\u30c3\u30d7\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001FNF:\u30de\u30a4\u30b1\u30eb\u30fb\u30b8\u30e3\u30af\u30bd\u30f3\u306e\u30ed\u30fc\u30ba\u30fb\u30af\u30ea\u30df\u30ca\u30eb\u3067\u9ad8\u5ea6\u306a\u6226\u7565\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "FNF:\u30de\u30a4\u30b1\u30eb\u30fb\u30b8\u30e3\u30af\u30bd\u30f3\u306e\u30ed\u30fc\u30ba\u30fb\u30af\u30ea\u30df\u30ca\u30eb\u3067\u9ad8\u5ea6\u306a\u6226\u7565\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u30d1\u30bf\u30fc\u30f3\u3092\u7406\u89e3\u3057\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30b9\u30e0\u30fc\u30b9\u30fb\u30af\u30ea\u30df\u30ca\u30eb\u300f\u3067\u306f\u3001\u30ce\u30fc\u30c8\u306e\u30d1\u30bf\u30fc\u30f3\u304c\u7e70\u308a\u8fd4\u3055\u308c\u308b\u306e\u3067\u3001\u305d\u308c\u3089\u3092\u8a8d\u8b58\u3059\u308b\u3053\u3068\u3067\u512a\u4f4d\u6027\u3092\u5f97\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u624b\u9806\uff11\uff1a\u697d\u66f2\u306e\u69cb\u9020\u3068\u30ce\u30fc\u30c8\u30d1\u30bf\u30fc\u30f3\u3092\u5206\u6790\u3059\u308b\u3002\u624b\u9806\uff12\uff1a\u7b4b\u8089\u8a18\u61b6\u3092\u69cb\u7bc9\u3059\u308b\u305f\u3081\u306b\u7d99\u7d9a\u7684\u306b\u7df4\u7fd2\u3059\u308b\u3002\u624b\u9806\uff13\uff1a\u3042\u306a\u305f\u306b\u6700\u9069\u306a\u65b9\u6cd5\u3092\u898b\u3064\u3051\u308b\u305f\u3081\u306b\u3055\u307e\u3056\u307e\u306a\u6226\u7565\u3092\u8a66\u3059\u3002\u6b63\u78ba\u3055\u3068\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u91cd\u8981\u306a\u3001\u8907\u96d1\u306a\u30c0\u30f3\u30b9\u30eb\u30fc\u30c6\u30a3\u30f3\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002"}, {"question": "FNF:\u30de\u30a4\u30b1\u30eb\u30fb\u30b8\u30e3\u30af\u30bd\u30f3\u306e\u30ed\u30fc\u30ba\u30fb\u30af\u30ea\u30df\u30ca\u30eb\u3067\u9ad8\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u305f\u3081\u306b\u4f7f\u7528\u3067\u304d\u308b\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "FNF:\u30de\u30a4\u30b1\u30eb\u30fb\u30b8\u30e3\u30af\u30bd\u30f3\u306e\u30ed\u30fc\u30ba\u30fb\u30af\u30ea\u30df\u30ca\u30eb\u3067\u9ad8\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u306b\u306f\u3001\u6b63\u78ba\u3055\u3068\u4e00\u8cab\u6027\u306e\u4e21\u65b9\u304c\u5fc5\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30d0\u30c3\u30c9\u300f\u3067\u306f\u3001\u30b3\u30f3\u30dc\u30b9\u30c8\u30ea\u30fc\u30e0\u3092\u7dad\u6301\u3059\u308b\u3053\u3068\u3067\u3001\u30b9\u30b3\u30a2\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u624b\u9806\uff11\uff1a\u3059\u3079\u3066\u306e\u97f3\u7b26\u3092\u5b8c\u74a7\u306b\u30d2\u30c3\u30c8\u3059\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3059\u308b\u3002\u624b\u9806\uff12\uff1a\u7df4\u7fd2\u30e2\u30fc\u30c9\u3092\u4f7f\u7528\u3057\u3066\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u8abf\u6574\u3059\u308b\u3002\u624b\u9806\uff13\uff1a\u30da\u30fc\u30b9\u306e\u901f\u3044\u30bb\u30af\u30b7\u30e7\u30f3\u3067\u3082\u843d\u3061\u7740\u3044\u3066\u3044\u3066\u843d\u3061\u7740\u3044\u3066\u3044\u308b\u3002\u30b3\u30f3\u30b5\u30fc\u30c8\u3067\u6f14\u594f\u3059\u308b\u3088\u3046\u306b\u3001\u3059\u3079\u3066\u306e\u97f3\u304c\u91cd\u8981\u3067\u3059\u3002"}, {"question": "FNF:\u30de\u30a4\u30b1\u30eb\u30fb\u30b8\u30e3\u30af\u30bd\u30f3\u306e\u30ed\u30fc\u30ba\u30fb\u30af\u30ea\u30df\u30ca\u30eb\u3067\u3088\u308a\u96e3\u3057\u3044\u30ec\u30d9\u30eb\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "FNF:\u30de\u30a4\u30b1\u30eb\u30fb\u30b8\u30e3\u30af\u30bd\u30f3\u306e\u30ed\u30fc\u30ba\u30fb\u30af\u30ea\u30df\u30ca\u30eb\u3067\u3088\u308a\u96e3\u3057\u3044\u30ec\u30d9\u30eb\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u53cd\u5fdc\u6642\u9593\u3068\u30d1\u30bf\u30fc\u30f3\u8a8d\u8b58\u3092\u5411\u4e0a\u3055\u305b\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30d6\u30e9\u30c3\u30af\u30fb\u30aa\u30a2\u30fb\u30db\u30ef\u30a4\u30c8\u300f\u3067\u306f\u3001\u97f3\u304c\u3088\u308a\u901f\u304f\u3001\u3088\u308a\u8907\u96d1\u306a\u30b7\u30fc\u30b1\u30f3\u30b9\u3067\u8868\u793a\u3055\u308c\u307e\u3059\u3002\u3053\u308c\u306b\u306f\u3001\u3088\u308a\u7d20\u65e9\u3044\u53cd\u5c04\u795e\u7d4c\u3068\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b2\u30fc\u30e0\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u540c\u3058\u3067\u3059\u304c\u3001\u96e3\u3057\u3055\u304c\u5897\u3057\u3001\u6226\u7565\u3092\u9069\u5fdc\u3055\u305b\u308b\u3053\u3068\u304c\u91cd\u8981\u306b\u306a\u308a\u307e\u3059\u3002\u30c0\u30f3\u30b9\u30b3\u30f3\u30c6\u30b9\u30c8\u3067\u9032\u884c\u3059\u308b\u306b\u3064\u308c\u3066\u8907\u96d1\u306b\u306a\u308b\u30c0\u30f3\u30b9\u30eb\u30fc\u30c6\u30a3\u30f3\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "FNF:\u30de\u30a4\u30b1\u30eb\u30fb\u30b8\u30e3\u30af\u30bd\u30f3\u306e\u30ed\u30fc\u30ba\u30fb\u30af\u30ea\u30df\u30ca\u30eb\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306e\u80cc\u5f8c\u306b\u3042\u308b\u4e3b\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "FNF:\u30de\u30a4\u30b1\u30eb\u30fb\u30b8\u30e3\u30af\u30bd\u30f3\u306e\u30ed\u30fc\u30ba\u30fb\u30af\u30ea\u30df\u30ca\u30eb\u306e\u30b9\u30b3\u30a2\u30ea\u30f3\u30b0\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6b63\u78ba\u3055\u3068\u30b3\u30f3\u30dc\u30b9\u30c8\u30ea\u30fc\u30e0\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30c9\u30f3\u30c8\u30fb\u30b9\u30c8\u30c3\u30d7\u30fb\u30c6\u30a3\u30eb\u30fb\u30e6\u30fc\u30fb\u30b2\u30c3\u30c8\u30fb\u30a4\u30ca\u30d5\u300f\u3067\u306f\u3001\u5b8c\u74a7\u306b\u97f3\u7b26\u3092\u30d2\u30c3\u30c8\u3059\u308b\u3068\u3001\u30b9\u30b3\u30a2\u4e57\u6570\u304c\u4e0a\u304c\u308a\u307e\u3059\u3002\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u826f\u3044\u307b\u3069\u3001\u30b9\u30b3\u30a2\u304c\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u97f3\u7b26\u3092\u9003\u3055\u305a\u306b\u30b3\u30f3\u30dc\u30b9\u30c8\u30ea\u30fc\u30e0\u3092\u7dad\u6301\u3059\u308b\u3053\u3068\u3067\u3001\u6700\u7d42\u7684\u306a\u30b9\u30b3\u30a2\u3092\u5927\u5e45\u306b\u4e0a\u3052\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u6b63\u78ba\u3055\u3068\u6a5f\u8ee2\u306b\u8a55\u4fa1\u3055\u308c\u308b\u30c0\u30f3\u30b9\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002"}, {"question": "FNF:\u30de\u30a4\u30b1\u30eb\u30fb\u30b8\u30e3\u30af\u30bd\u30f3\u306e\u30ed\u30fc\u30ba\u30fb\u30af\u30ea\u30df\u30ca\u30eb\u306e\u96e3\u6613\u5ea6\u30ec\u30d9\u30eb\u306f\u3001\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "FNF:\u30de\u30a4\u30b1\u30eb\u30fb\u30b8\u30e3\u30af\u30bd\u30f3\u306e\u30ed\u30fc\u30ba\u30fb\u30af\u30ea\u30df\u30ca\u30eb\u306e\u96e3\u6613\u5ea6\u30ec\u30d9\u30eb\u306f\u3001\u30ce\u30fc\u30c8\u30d1\u30bf\u30fc\u30f3\u306e\u901f\u5ea6\u3068\u8907\u96d1\u3055\u306b\u5f71\u97ff\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30ed\u30c3\u30af\u30fb\u30a6\u30a3\u30ba\u30fb\u30e6\u30fc\u300f\u3067\u306f\u3001\u96e3\u6613\u5ea6\u30ec\u30d9\u30eb\u304c\u9ad8\u304f\u306a\u308b\u3068\u3001\u3088\u308a\u901f\u304f\u3001\u3088\u308a\u8907\u96d1\u306a\u30b7\u30fc\u30b1\u30f3\u30b9\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002\u3053\u308c\u306f\u3088\u308a\u9ad8\u901f\u306a\u53cd\u5c04\u795e\u7d4c\u3068\u3088\u308a\u512a\u308c\u305f\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b2\u30fc\u30e0\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u540c\u3058\u3067\u3059\u304c\u3001\u30c1\u30e3\u30ec\u30f3\u30b8\u304c\u5897\u3057\u3001\u6226\u7565\u3092\u9069\u5fdc\u3055\u305b\u308b\u3053\u3068\u304c\u4e0d\u53ef\u6b20\u306b\u306a\u308a\u307e\u3059\u3002\u9032\u6b69\u3059\u308b\u306b\u3064\u308c\u3066\u8907\u96d1\u306b\u306a\u308b\u30c0\u30f3\u30b9\u30eb\u30fc\u30c6\u30a3\u30f3\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067FNF:\u30de\u30a4\u30b1\u30eb\u30fb\u30b8\u30e3\u30af\u30bd\u30f3\u306e\u30ed\u30fc\u30ba\u30fb\u30af\u30ea\u30df\u30ca\u30eb\u3092\u30d7\u30ec\u30a4\u3059\u308b\u3068\u304d\u306e\u4e92\u63db\u6027\u3092\u3069\u306e\u3088\u3046\u306b\u78ba\u4fdd\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "FNF:\u30de\u30a4\u30b1\u30eb\u30fb\u30b8\u30e3\u30af\u30bd\u30f3\u306e\u30ed\u30fc\u30ba\u30fb\u30af\u30ea\u30df\u30ca\u30eb\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u306e\u4e92\u63db\u6027\u3092\u78ba\u4fdd\u3059\u308b\u306b\u306f\u3001\u30b7\u30b9\u30c6\u30e0\u8981\u4ef6\u3092\u78ba\u8a8d\u3057\u3001\u4e92\u63db\u6027\u306e\u3042\u308b\u5165\u529b\u30c7\u30d0\u30a4\u30b9\u3092\u4f7f\u7528\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001PC\u3067\u30d7\u30ec\u30a4\u3057\u3066\u3044\u308b\u5834\u5408\u3001\u30ad\u30fc\u30dc\u30fc\u30c9\u304c\u53cd\u5fdc\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b3\u30f3\u30bd\u30fc\u30eb\u306b\u5207\u308a\u66ff\u3048\u308b\u5834\u5408\u306f\u3001\u30b2\u30fc\u30e0\u304c\u305d\u308c\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u304a\u308a\u3001\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u304c\u6b63\u3057\u304f\u8a2d\u5b9a\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u30b9\u30c6\u30fc\u30b8\u3067\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306e\u305f\u3081\u306b\u30c0\u30f3\u30b9\u30b7\u30e5\u30fc\u30ba\u304c\u5b8c\u74a7\u306b\u5408\u3046\u3088\u3046\u306b\u3059\u308b\u305f\u3081\u306e\u3082\u306e\u3067\u3059\u3002"}, {"question": "FNF:\u30de\u30a4\u30b1\u30eb\u30fb\u30b8\u30e3\u30af\u30bd\u30f3\u306e\u30ed\u30fc\u30ba\u30fb\u30af\u30ea\u30df\u30ca\u30eb\u3067\u767a\u898b\u3067\u304d\u308b\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u3069\u306e\u3088\u3046\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "FNF:\u30de\u30a4\u30b1\u30eb\u30fb\u30b8\u30e3\u30af\u30bd\u30f3\u306e\u30ed\u30fc\u30ba\u30fb\u30af\u30ea\u30df\u30ca\u30eb\u306b\u306f\u3001\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u3084\u30dc\u30fc\u30ca\u30b9\u30c8\u30e9\u30c3\u30af\u306a\u3069\u306e\u96a0\u3055\u308c\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u3059\u3079\u3066\u306e\u66f2\u3092\u30a8\u30ad\u30b9\u30d1\u30fc\u30c8\u96e3\u6613\u5ea6\u3067\u30af\u30ea\u30a2\u3059\u308b\u3053\u3068\u3067\u3001\u7279\u5225\u306a\u30de\u30a4\u30b1\u30eb\u30fb\u30b8\u30e3\u30af\u30bd\u30f3\u30c6\u30fc\u30de\u306e\u30b9\u30ad\u30f3\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u305d\u308c\u3089\u3092\u898b\u3064\u3051\u308b\u305f\u3081\u306b\u3001\u624b\u9806\uff11\uff1a\u3059\u3079\u3066\u306e\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u3092\u5fb9\u5e95\u7684\u306b\u63a2\u308b\u3002\u624b\u9806\uff12\uff1a\u30b2\u30fc\u30e0\u5185\u306e\u30d2\u30f3\u30c8\u3084\u9054\u6210\u72b6\u6cc1\u306b\u6ce8\u610f\u3059\u308b\u3002\u624b\u9806\uff13\uff1a\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u306b\u30d2\u30f3\u30c8\u3084\u79d8\u5bc6\u3092\u5c0b\u306d\u308b\u3002"}]
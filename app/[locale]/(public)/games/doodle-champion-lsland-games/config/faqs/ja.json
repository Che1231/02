[{"question": "\u30c9\u30fc\u30c9\u30eb\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u30a2\u30a4\u30e9\u30f3\u30c9\u30b2\u30fc\u30e0\u30ba\uff1a\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u79fb\u52d5\u65b9\u6cd5\u3068\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3068\u306e\u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3\u3092\u6559\u3048\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "\u30b2\u30fc\u30e0\u3078\u3088\u3046\u3053\u305d\uff01\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u79fb\u52d5\u306f\u7c21\u5358\u3067\u3059\u3002\u30ad\u30fc\u30dc\u30fc\u30c9\u306e\u77e2\u5370\u30ad\u30fc\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3084\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3068\u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3\u3059\u308b\u306b\u306f\u3001\u8fd1\u3065\u3044\u3066\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u3092\u62bc\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b\u3048\u3070\u3001\u8d64\u3044\u9ce5\u5c45\u306b\u8fd1\u3065\u3044\u3066\u30b9\u30da\u30fc\u30b9\u30ad\u30fc\u3092\u62bc\u3059\u3068\u3001\u30b2\u30fc\u30e0\u958b\u59cb\u30a4\u30d9\u30f3\u30c8\u304c\u30c8\u30ea\u30ac\u30fc\u3055\u308c\u3001\u30b2\u30fc\u30e0\u304c\u59cb\u307e\u308a\u307e\u3059\uff01"}, {"question": "\u30c9\u30fc\u30c9\u30eb\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u30a2\u30a4\u30e9\u30f3\u30c9\u30b2\u30fc\u30e0\u30ba\u3067\u3001\u3069\u306e\u3088\u3046\u306a\u30b9\u30dd\u30fc\u30c4\u304c\u3042\u308a\u3001\u521d\u5fc3\u8005\u306b\u3068\u3063\u3066\u6700\u3082\u7fd2\u5f97\u3057\u3084\u3059\u3044\u30b9\u30dd\u30fc\u30c4\u306f\u3069\u308c\u3067\u3059\u304b\uff1f", "answer": "\u30c9\u30fc\u30c9\u30eb\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u30a2\u30a4\u30e9\u30f3\u30c9\u30b2\u30fc\u30e0\u30ba\u306b\u306f\u3001\u5353\u7403\u3001\u30b9\u30b1\u30fc\u30c8\u30dc\u30fc\u30c9\u3001\u5c04\u6483\u3001\u30e9\u30b0\u30d3\u30fc\u3001\u82b8\u8853\u7684\u30b9\u30a4\u30df\u30f3\u30b0\u3001\u767b\u5c71\u3001\u30de\u30e9\u30bd\u30f3\u306a\u3069\u30017\u3064\u306e\u7570\u306a\u308b\u30b9\u30dd\u30fc\u30c4\u304c\u3042\u308a\u307e\u3059\u3002\u521d\u5fc3\u8005\u306b\u3068\u3063\u3066\u3001\u5353\u7403\u306f\u30b7\u30f3\u30d7\u30eb\u306a\u64cd\u4f5c\u306e\u305f\u3081\u3001\u7fd2\u5f97\u3057\u3084\u3059\u3044\u3068\u4e00\u822c\u7684\u306b\u8003\u3048\u3089\u308c\u3066\u3044\u307e\u3059\u3002"}, {"question": "\u30c9\u30fc\u30c9\u30eb\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u30a2\u30a4\u30e9\u30f3\u30c9\u30b2\u30fc\u30e0\u30ba\u3067\u3001\u767b\u5c71\u30df\u30cb\u30b2\u30fc\u30e0\u3067\u82e6\u52b4\u3057\u3066\u3044\u308b\u306e\u3067\u3059\u304c\u3001\u6539\u5584\u306e\u305f\u3081\u306e\u30d2\u30f3\u30c8\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u591a\u304f\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u767b\u5c71\u30df\u30cb\u30b2\u30fc\u30e0\u306e\u96e3\u6613\u5ea6\u3092\u611f\u3058\u3066\u3044\u307e\u3059\u3002\u4ee5\u4e0b\u306b\u624b\u9806\u3092\u793a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u624b\u3059\u308a\uff08\u63b4\u3080\u5834\u6240\uff09\u3092\u89b3\u5bdf\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3059\u3050\u306b\u6d88\u3048\u3066\u3057\u307e\u3044\u307e\u3059\uff01\u30b9\u30c6\u30c3\u30d72\uff1aA\u30ad\u30fc\u3068D\u30ad\u30fc\uff08\u307e\u305f\u306f\u5de6\u53f3\u306e\u77e2\u5370\u30ad\u30fc\uff09\u3092\u4f7f\u7528\u3057\u3066\u3001\u7d20\u65e9\u304f\u624b\u3092\u5207\u308a\u66ff\u3048\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u4e0a\u6607\u8a08\u753b\u3092\u7acb\u3066\u3001\u30e9\u30f3\u30c0\u30e0\u306b\u63b4\u3080\u306e\u3067\u306f\u306a\u304f\u3001\u6b21\u306e\u3064\u304b\u3081\u308b\u5834\u6240\u3092\u4e88\u6e2c\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u307e\u308b\u3067\u97f3\u697d\u6905\u5b50\u306e\u3088\u3046\u306b\u3001\u6b21\u306e\u3064\u304b\u3081\u308b\u5834\u6240\u3092\u4e88\u6e2c\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u30c9\u30fc\u30c9\u30eb\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u30a2\u30a4\u30e9\u30f3\u30c9\u30b2\u30fc\u30e0\u30ba\uff1a\u30bb\u30eb\u30d5\u30e1\u30c7\u30a3\u30a2\u30e6\u30fc\u30b6\u30fc\u3068\u3057\u3066\u3001\u7d20\u6674\u3089\u3057\u3044\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\u3092\u3069\u306e\u3088\u3046\u306b\u64ae\u5f71\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30b3\u30f3\u30c6\u30f3\u30c4\u7528\u306b\u7d20\u6674\u3089\u3057\u3044\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\u3092\u30ad\u30e3\u30d7\u30c1\u30e3\u3059\u308b\u306b\u306f\u3001\u30ad\u30fc\u30dc\u30fc\u30c9\u306e\u300cPrtScn\u300d\uff08\u30d7\u30ea\u30f3\u30c8\u30b9\u30af\u30ea\u30fc\u30f3\uff09\u30ad\u30fc\u3092\u62bc\u3057\u307e\u3059\u3002\u753b\u50cf\u304c\u30af\u30ea\u30c3\u30d7\u30dc\u30fc\u30c9\u306b\u30b3\u30d4\u30fc\u3055\u308c\u307e\u3059\u3002\u305d\u306e\u5f8c\u3001\u30da\u30a4\u30f3\u30c8\u3084\u30d5\u30a9\u30c8\u30b7\u30e7\u30c3\u30d7\u306a\u3069\u306e\u753b\u50cf\u7de8\u96c6\u30bd\u30d5\u30c8\u30a6\u30a7\u30a2\u3092\u958b\u304d\u3001Ctrl + V\uff08\u8cbc\u308a\u4ed8\u3051\uff09\u3092\u62bc\u3057\u3066\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\u3092\u8cbc\u308a\u4ed8\u3051\u307e\u3059\u3002\u3042\u308b\u3044\u306f\u3001Windows\u30ad\u30fc + Shift + 'S' \u3092\u4f7f\u7528\u3057\u3066\u3001\u753b\u9762\u306e\u4e00\u90e8\u3092\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\u3059\u308b\u5207\u308a\u53d6\u308a\u30c4\u30fc\u30eb\u3092\u4f7f\u7528\u3059\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u3002\u3088\u308a\u9ad8\u54c1\u8cea\u306a\u30ad\u30e3\u30d7\u30c1\u30e3\u306e\u305f\u3081\u306b\u3001\u753b\u9762\u89e3\u50cf\u5ea6\u3092\u9ad8\u304f\u8a2d\u5b9a\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}, {"question": "\u52dd\u5229\u4ee5\u5916\u306b\u3082\u3001\u30c9\u30fc\u30c9\u30eb\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u30a2\u30a4\u30e9\u30f3\u30c9\u30b2\u30fc\u30e0\u30ba\u3067\u30c1\u30fc\u30e0\u306b\u53c2\u52a0\u3059\u308b\u30e1\u30ea\u30c3\u30c8\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30c1\u30fc\u30e0\u306b\u53c2\u52a0\u3059\u308b\u3053\u3068\u3067\u3001\u81ea\u6162\u306e\u6a29\u5229\u3060\u3051\u3067\u306a\u304f\u3001\u30ed\u30fc\u30c9\u753b\u9762\u306e\u898b\u305f\u76ee\u3082\u5909\u308f\u308a\u3001\u30b2\u30fc\u30e0\u5168\u4f53\u3067\u3044\u304f\u3064\u304b\u306e\u8996\u899a\u52b9\u679c\u306e\u8272\u304c\u5909\u308f\u308a\u307e\u3059\u3002\u307e\u305f\u3001\u30c1\u30fc\u30e0\u56fa\u6709\u306e\u9054\u6210\u611f\u3082\u5f97\u3089\u308c\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u8d64\u30c1\u30fc\u30e0\u306b\u53c2\u52a0\u3059\u308b\u3068\u3001\u4e00\u90e8\u306e\u8981\u7d20\u304c\u8d64\u8272\u3067\u5f37\u8abf\u8868\u793a\u3055\u308c\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u9054\u6210\u611f\u3092\u5f97\u3089\u308c\u308b\u898b\u305f\u76ee\u306e\u5411\u4e0a\u3068\u898b\u306a\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\uff01"}, {"question": "\u30c9\u30fc\u30c9\u30eb\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u30a2\u30a4\u30e9\u30f3\u30c9\u30b2\u30fc\u30e0\u30ba\uff1a\u30b3\u30f3\u30d7\u30ea\u30fc\u30c8\u3092\u76ee\u6307\u3059\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u521d\u671f\u6bb5\u968e\u3067\u512a\u5148\u7684\u306b\u63a2\u3059\u3079\u304d\u96a0\u308c\u305f\u30a8\u30ea\u30a2\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u521d\u671f\u6bb5\u968e\u3067\u306f\u3001\u5c04\u6483\u5834\u8fd1\u304f\u306e\u96a0\u308c\u305f\u30bf\u30cc\u30ad\u50cf\u3092\u898b\u3064\u3051\u307e\u3057\u3087\u3046\u3002\u305d\u308c\u3068\u30a4\u30f3\u30bf\u30e9\u30af\u30b7\u30e7\u30f3\u3059\u308b\u3053\u3068\u3067\u3001\u81ea\u7136\u4fdd\u8b77\u306b\u95a2\u3059\u308b\u4e00\u9023\u306e\u30b5\u30a4\u30c9\u30af\u30a8\u30b9\u30c8\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u3001\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3067\u73cd\u3057\u3044\u30d0\u30c3\u30b8\u304c\u3082\u3089\u3048\u307e\u3059\u3002\u30bf\u30cc\u30ad\u50cf\u306f\u3001\u5c04\u6483\u5834\u30b2\u30fc\u30c8\u306e\u53f3\u5074\u3001\u8349\u3080\u3089\u4ed8\u8fd1\u306b\u96a0\u308c\u3066\u3044\u307e\u3059\u3002"}, {"question": "\u30b9\u30bf\u30df\u30ca\u306a\u3069\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u306f\u3001\u30c9\u30fc\u30c9\u30eb\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u30a2\u30a4\u30e9\u30f3\u30c9\u30b2\u30fc\u30e0\u30ba\u306e\u3055\u307e\u3056\u307e\u306a\u30b9\u30dd\u30fc\u30c4\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u898b\u3048\u308b\u3088\u3046\u306b\u660e\u793a\u7684\u306b\u5b9a\u7fa9\u3055\u308c\u305f\u30b9\u30bf\u30df\u30ca\u30b9\u30c6\u30fc\u30bf\u30b9\u306f\u3042\u308a\u307e\u305b\u3093\u304c\u3001\u30a2\u30d0\u30bf\u30fc\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306f\u3001\u7279\u5b9a\u306e\u96a0\u308c\u305f\u30b9\u30c6\u30fc\u30bf\u30b9\u304c\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u3066\u3044\u308b\u3053\u3068\u3092\u793a\u5506\u3057\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30de\u30e9\u30bd\u30f3\u3067\u306f\u3001\u4f4e\u3044\u9045\u5ef6\u63a5\u7d9a\u306f\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u3088\u308a\u591a\u304f\u306e\u5165\u529b\u3092\u5b9f\u884c\u3067\u304d\u308b\u3053\u3068\u3092\u610f\u5473\u3057\u3001\u57fa\u672c\u7684\u306b\u96a0\u308c\u305f\u30b9\u30bf\u30df\u30ca\u306e\u5229\u70b9\u3068\u306a\u308a\u307e\u3059\u3002\u540c\u69d8\u306b\u3001\u82b8\u8853\u7684\u30b9\u30a4\u30df\u30f3\u30b0\u4e2d\u306e\u30ea\u30ba\u30e0\u3067\u306e\u30dc\u30bf\u30f3\u62bc\u3057\u306f\u3001\u30a2\u30d0\u30bf\u30fc\u304c\u969c\u5bb3\u7269\u9593\u3092\u3088\u308a\u30b9\u30e0\u30fc\u30ba\u306b\u79fb\u52d5\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u3001\u4ed6\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30de\u30fc\u30b2\u30fc\u30e0\u3067\u30b9\u30bf\u30df\u30ca\u304c\u4f7f\u7528\u3055\u308c\u308b\u65b9\u6cd5\u306b\u4f3c\u3066\u3044\u307e\u3059\u3002"}, {"question": "\u30c9\u30fc\u30c9\u30eb\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u30a2\u30a4\u30e9\u30f3\u30c9\u30b2\u30fc\u30e0\u30ba\uff1a\u30de\u30e9\u30bd\u30f3\u30a4\u30d9\u30f3\u30c8\u306e\u30b9\u30d4\u30fc\u30c9\u30e9\u30f3\u30cb\u30f3\u30b0\u306b\u304a\u3051\u308b\u7406\u8ad6\u7684\u306a\u9650\u754c\u3068\u3001\u4e0d\u53ef\u6b20\u306a\u30c6\u30af\u30cb\u30c3\u30af\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u7406\u8ad6\u7684\u306a\u30b9\u30d4\u30fc\u30c9\u30e9\u30f3\u30cb\u30f3\u30b0\u306e\u9650\u754c\u306f\u3001\u30c8\u30e9\u30f3\u30b8\u30b7\u30e7\u30f3\u4e2d\u306e\u30d5\u30ec\u30fc\u30e0\u30ed\u30b9\u3092\u6700\u5c0f\u9650\u306b\u3057\u3001\u30ea\u30ba\u30e0\u3092\u6700\u9069\u5316\u3059\u308b\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002\u4e0d\u53ef\u6b20\u306a\u30c6\u30af\u30cb\u30c3\u30af\u306f\u4ee5\u4e0b\u306e\u3068\u304a\u308a\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30ea\u30ba\u30e0\u3092\u5b8c\u74a7\u306b\u3059\u308b\uff1a\u5b89\u5b9a\u3057\u305f\u30c6\u30f3\u30dd\u306f\u30b9\u30bf\u30c3\u30bf\u30fc\u3092\u6700\u5c0f\u9650\u306b\u6291\u3048\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30d7\u30ea\u30ed\u30fc\u30c9\uff1a\u308f\u305a\u304b\u306a\u904b\u52d5\u91cf\u306e\u512a\u4f4d\u6027\u3092\u7372\u5f97\u3059\u308b\u305f\u3081\u306b\u30bf\u30fc\u30f3\u3092\u4e88\u6e2c\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30eb\u30fc\u30c8\u306e\u6700\u9069\u5316\uff1aNPC\u306e\u4ea4\u901a\u6e0b\u6ede\u304c\u306a\u304f\u3001\u30eb\u30fc\u30c8\u3092\u6700\u77ed\u3067\u79fb\u52d5\u3057\u307e\u3059\u3002\u30e9\u30f3\u30ad\u30f3\u30b0\u306b\u5165\u3063\u3066\u304f\u3060\u3055\u3044\uff01"}, {"question": "\u30c9\u30fc\u30c9\u30eb\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u30a2\u30a4\u30e9\u30f3\u30c9\u30b2\u30fc\u30e0\u30ba\u306f\u3001\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u4e92\u63db\u6027\u307e\u305f\u306f\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u8ee2\u9001\u3092\u5229\u7528\u3067\u304d\u307e\u3059\u304b\uff1f\u5229\u7528\u3067\u304d\u306a\u3044\u5834\u5408\u3001\u3069\u306e\u3088\u3046\u306a\u5f71\u97ff\u304c\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30c9\u30fc\u30c9\u30eb\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u30a2\u30a4\u30e9\u30f3\u30c9\u30b2\u30fc\u30e0\u30ba\u306f\u30d6\u30e9\u30a6\u30b6\u30d9\u30fc\u30b9\u306e\u30b2\u30fc\u30e0\u3067\u3042\u308a\u3001\u5f93\u6765\u306e\u610f\u5473\u3067\u306e\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u4e92\u63db\u6027\u307e\u305f\u306f\u30bb\u30fc\u30d6\u30c7\u30fc\u30bf\u8ee2\u9001\u306f\u63d0\u4f9b\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002\u3053\u306e\u30b2\u30fc\u30e0\u306f\u3001\u30c7\u30b9\u30af\u30c8\u30c3\u30d7\u307e\u305f\u306f\u30e2\u30d0\u30a4\u30ebWeb\u30d6\u30e9\u30a6\u30b6\u3067\u30aa\u30f3\u30e9\u30a4\u30f3\u3067\u30d7\u30ec\u30a4\u3059\u308b\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u9032\u884c\u72b6\u6cc1\u306f\uff08\u8a72\u5f53\u3059\u308b\u5834\u5408\uff09Google\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u7d10\u4ed8\u3051\u3089\u308c\u3066\u3044\u308b\u305f\u3081\u3001\u30c7\u30d0\u30a4\u30b9\u3092\u5207\u308a\u66ff\u3048\u308b\u306b\u306f\u3001\u5358\u306b\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3060\u3051\u3067\u3059\u3002\u3053\u308c\u306f\u3001\u540c\u3058Google\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u4f7f\u7528\u3057\u3066\u3044\u308b\u9650\u308a\u3001\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u30b7\u30fc\u30e0\u30ec\u30b9\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002"}, {"question": "\u30c9\u30fc\u30c9\u30eb\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u30a2\u30a4\u30e9\u30f3\u30c9\u30b2\u30fc\u30e0\u30ba\u306b\u304a\u3051\u308b\u69d8\u3005\u306a\u300c\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u300d\u306e\u80cc\u666f\u30b9\u30c8\u30fc\u30ea\u30fc\u3068\u306f\u4f55\u3067\u3059\u304b\uff1f\u3069\u306e\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u304c\u6700\u3082\u6df1\u3044\u7269\u8a9e\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u304b\uff1f", "answer": "\u5404\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u306f\u65e5\u672c\u306e\u6c11\u8a71\u306b\u95a2\u9023\u3059\u308b\u7279\u5fb4\u3092\u4f53\u73fe\u3057\u3066\u3044\u307e\u3059\u3002\u3059\u3079\u3066\u306e\u30c1\u30e3\u30f3\u30d4\u30aa\u30f3\u306e\u4e2d\u3067\u3001\u9b3c\u306f\u3001\u65e5\u672c\u306e\u6c11\u8a71\u306b\u304a\u3051\u308b\u60aa\u9b54\u7684\u3067\u60aa\u610f\u306e\u3042\u308b\u4eba\u7269\u304b\u3089\u6d3e\u751f\u3057\u3001\u304a\u305d\u3089\u304f\u6700\u3082\u6df1\u3044\u7269\u8a9e\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002\u30b9\u30c8\u30fc\u30ea\u30fc\u306b\u53c2\u52a0\u3057\u3001\u9b3c\u306e\u30af\u30a8\u30b9\u30c8\u3092\u30d7\u30ec\u30a4\u3059\u308b\u3053\u3068\u3067\u3001\u53e4\u5178\u7684\u306a\u6c11\u8a71\u3092\u30b2\u30fc\u30e0\u5185\u3067\u518d\u8a71\u3067\u304d\u308b\u3067\u3057\u3087\u3046\uff01"}]
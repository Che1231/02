[{"question": "\ub450\ub4e4 \ucc54\ud53c\uc5b8 \uc544\uc77c\ub79c\ub4dc \uac8c\uc784: \uc644\uc804 \ucd08\ubcf4\ub85c\uc11c \uce90\ub9ad\ud130\ub97c \uc6c0\uc9c1\uc774\uace0 \ubb3c\uccb4\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\uac8c\uc784\uc5d0 \uc624\uc2e0 \uac83\uc744 \ud658\uc601\ud569\ub2c8\ub2e4! \uce90\ub9ad\ud130\ub97c \uc6c0\uc9c1\uc774\ub294 \uac83\uc740 \uac04\ub2e8\ud569\ub2c8\ub2e4. \ud0a4\ubcf4\ub4dc\uc758 \ud654\uc0b4\ud45c \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc138\uc694. \ubb3c\uccb4\ub098 \uce90\ub9ad\ud130\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\ub824\uba74 \ubb3c\uccb4\ub098 \uce90\ub9ad\ud130\uc5d0 \ub2e4\uac00\uac00 \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \ub204\ub974\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ube68\uac04\uc0c9 \ud1a0\ub9ac\uc774 \ubb38\uc5d0 \ub2e4\uac00\uac00 \uc2a4\ud398\uc774\uc2a4\ubc14\ub97c \ub204\ub974\uba74 \uac8c\uc784\uc5d0 \ucc38\uc5ec\ud558\ub294 \uc774\ubca4\ud2b8\uac00 \uc2dc\uc791\ub429\ub2c8\ub2e4!"}, {"question": "\ub450\ub4e4 \ucc54\ud53c\uc5b8 \uc544\uc77c\ub79c\ub4dc \uac8c\uc784\uc758 \ub2e4\uc591\ud55c \uc885\ubaa9\uc740 \ubb34\uc5c7\uc774\uba70, \ucd08\ubcf4\uc790\uac00 \uc27d\uac8c \uc219\ub2ec\ud560 \uc218 \uc788\ub294 \uc885\ubaa9\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub450\ub4e4 \ucc54\ud53c\uc5b8 \uc544\uc77c\ub79c\ub4dc \uac8c\uc784\uc5d0\ub294 \ud0c1\uad6c, \uc2a4\ucf00\uc774\ud2b8\ubcf4\ub4dc, \uad81\ub3c4, \ub7ed\ube44, \uc608\uc220 \uc218\uc601, \ub4f1\ubc18 \ubc0f \ub9c8\ub77c\ud1a4 \ub4f1 7 \uac00\uc9c0 \ub2e4\ub978 \uc885\ubaa9\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ucd08\ubcf4\uc790\uc5d0\uac8c \ud0c1\uad6c\ub294 \uac04\ub2e8\ud55c \uc870\uc791 \ub355\ubd84\uc5d0 \uac00\uc7a5 \uc27d\uac8c \uc774\ud574\ud560 \uc218 \uc788\ub294 \uc885\ubaa9\uc73c\ub85c \uac04\uc8fc\ub418\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc2b5\ub2c8\ub2e4."}, {"question": "\ub450\ub4e4 \ucc54\ud53c\uc5b8 \uc544\uc77c\ub79c\ub4dc \uac8c\uc784\uc758 \ub4f1\ubc18 \ubbf8\ub2c8 \uac8c\uc784\uc5d0 \uc5b4\ub824\uc6c0\uc744 \uacaa\uace0 \uc788\uc2b5\ub2c8\uae4c? \ud5a5\uc0c1\uc744 \uc704\ud55c \ud301\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub9ce\uc740 \ud50c\ub808\uc774\uc5b4\ub4e4\uc774 \ub4f1\ubc18 \ubbf8\ub2c8 \uac8c\uc784\uc744 \uc5b4\ub824\uc6cc\ud569\ub2c8\ub2e4. \ub2e4\uc74c\uc740 \ud574\uacb0 \ubc29\ubc95\uc785\ub2c8\ub2e4. 1\ub2e8\uacc4: \uc190\uc7a1\uc774\ub97c \uad00\ucc30\ud558\uc138\uc694. \uace7 \uc0ac\ub77c\uc9d1\ub2c8\ub2e4! 2\ub2e8\uacc4: A \ud0a4\uc640 D \ud0a4(\ub610\ub294 \uc88c/\uc6b0 \ud654\uc0b4\ud45c \ud0a4)\ub97c \ube60\ub974\uac8c \uc804\ud658\ud558\uc5ec \uc190\uc744 \ubc14\uafd4 \uc6c0\uc9c1\uc774\uc138\uc694. 3\ub2e8\uacc4: \uc624\ub974\ub294 \uae38\uc744 \uacc4\ud68d\ud558\uc138\uc694. \ubb34\uc791\uc704\ub85c \uc7a1\uc9c0 \ub9c8\uc138\uc694. \ub9c8\uce58 \ubba4\uc9c0\uceec \uc758\uc790\ucc98\ub7fc \uc0dd\uac01\ud558\uc138\uc694. \ub2e4\uc74c \uc190\uc7a1\uc774\ub97c \ubbf8\ub9ac \uc608\uce21\ud574\uc57c \ud569\ub2c8\ub2e4."}, {"question": "\ub450\ub4e4 \ucc54\ud53c\uc5b8 \uc544\uc77c\ub79c\ub4dc \uac8c\uc784: \uc140\ud504 \ubbf8\ub514\uc5b4 \uc0ac\uc6a9\uc790\ub85c\uc11c \uba4b\uc9c4 \uc2a4\ud06c\ub9b0\uc0f7\uc744 \ucea1\ucc98\ud558\ub824\uba74 \uc5b4\ub5bb\uac8c \ud574\uc57c \ud569\ub2c8\uae4c?", "answer": "\ucf58\ud150\uce20\ub97c \uc704\ud574 \uba4b\uc9c4 \uc2a4\ud06c\ub9b0\uc0f7\uc744 \ucea1\ucc98\ud558\ub824\uba74 \ud0a4\ubcf4\ub4dc\uc758 'PrtScn'(Print Screen) \ud0a4\ub97c \ub204\ub974\uc138\uc694. \uc774\ubbf8\uc9c0\ub294 \ud074\ub9bd\ubcf4\ub4dc\uc5d0 \ubcf5\uc0ac\ub418\uace0, Paint \ub610\ub294 Photoshop\uacfc \uac19\uc740 \uc774\ubbf8\uc9c0 \ud3b8\uc9d1 \uc18c\ud504\ud2b8\uc6e8\uc5b4\ub97c \uc5f4\uc5b4 Ctrl+V(\ubd99\uc5ec\ub123\uae30)\ub97c \ub20c\ub7ec \uc2a4\ud06c\ub9b0\uc0f7\uc744 \ubd99\uc5ec\ub123\uc73c\uc138\uc694. \ub610\ub294 Windows \ud0a4 + Shift + 'S'\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud654\uba74\uc758 \uc77c\ubd80\ubd84\uc744 \uc2a4\ud06c\ub9b0\uc0f7\ud558\uae30 \uc704\ud55c \uc2a4\ub2c8\ud551 \ub3c4\uad6c\ub97c \ud65c\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud654\uba74 \ud574\uc0c1\ub3c4\ub97c \ub192\uac8c \uc124\uc815\ud558\uc5ec \ub354 \ub098\uc740 \ud488\uc9c8\uc758 \ucea1\ucc98\ub97c \ubcf4\uc7a5\ud558\uc138\uc694."}, {"question": "\uc2b9\ub9ac \uc678\uc5d0\ub3c4 \ub450\ub4e4 \ucc54\ud53c\uc5b8 \uc544\uc77c\ub79c\ub4dc \uac8c\uc784\uc5d0\uc11c \ud300\uc5d0 \ucc38\uc5ec\ud558\ub294 \uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud300\uc5d0 \ud569\ub958\ud558\ub294 \uac83\uc740 \ub2e8\uc21c\ud55c \uc790\ub791\uac70\ub9ac \uc774\uc0c1\uc785\ub2c8\ub2e4. \ub85c\ub529 \ud654\uba74\uc758 \ubaa8\uc2b5\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\uace0, \uac8c\uc784 \uc804\uccb4\uc758 \uc77c\ubd80 \uc2dc\uac01 \ud6a8\uacfc\uc758 \uc0c9\uc0c1\uc744 \ubcc0\uacbd\ud558\uba70, \uace0\uc720\ud55c \ud300 \ud2b9\uc815 \uc5c5\uc801\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ube68\uac04\uc0c9 \ud300\uc5d0 \ud569\ub958\ud558\uba74 \uc77c\ubd80 \uc694\uc18c\uac00 \ube68\uac04\uc0c9\uc73c\ub85c \ud45c\uc2dc\ub429\ub2c8\ub2e4. \uc774\ub294 \uc5c5\uc801 \ubcf4\ub108\uc2a4\uac00 \ud3ec\ud568\ub41c \ubbf8\uc801 \ud5a5\uc0c1\uc73c\ub85c \uac04\uc8fc\ud558\uc138\uc694!"}, {"question": "\ub450\ub4e4 \ucc54\ud53c\uc5b8 \uc544\uc77c\ub79c\ub4dc \uac8c\uc784: \uc644\ubcbd\uc8fc\uc758\uc790\ub294 \ucd08\ubc18\uc5d0 \uc5b4\ub5a4 \uc228\uaca8\uc9c4 \uc9c0\uc5ed\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub97c \uc6b0\uc120\uc801\uc73c\ub85c \ucc3e\uc544\uc57c \ud569\ub2c8\uae4c?", "answer": "\ucd08\ubc18\uc5d0\ub294 \uad81\ub3c4\uc7a5 \uadfc\ucc98\uc5d0 \uc228\uaca8\uc9c4 \ud0c0\ub204\ud0a4 \uc870\uac01\uc0c1\uc744 \ucc3e\uc544\uc57c \ud569\ub2c8\ub2e4. \uc774\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\uba74 \uc790\uc5f0 \ubcf4\ud638\uc640 \uad00\ub828\ub41c \uc77c\ub828\uc758 \ud018\uc2a4\ud2b8\uac00 \ud574\uc81c\ub418\uace0, \uc644\ub8cc\ud558\uba74 \ud76c\uadc0\ud55c \ubc30\uc9c0\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \ud0c0\ub204\ud0a4\ub294 \uad81\ub3c4 \ubb38 \uc624\ub978\ucabd\uc5d0, \ud480 \uadfc\ucc98\uc5d0 \uc228\uaca8\uc838 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\uccb4\ub825\uacfc \uac19\uc740 \ud1b5\uacc4\ub294 \ub450\ub4e4 \ucc54\ud53c\uc5b8 \uc544\uc77c\ub79c\ub4dc \uac8c\uc784\uc758 \ub2e4\uc591\ud55c \uc885\ubaa9\uc5d0\uc11c \uc131\ub2a5\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ud50c\ub808\uc774\uc5b4\uac00 \uba85\uc2dc\uc801\uc73c\ub85c \ubcfc \uc218 \uc788\ub294 \uccb4\ub825\uc774\ub77c\ub294 \ud1b5\uacc4\ub294 \uc5c6\uc2b5\ub2c8\ub2e4. \ud558\uc9c0\ub9cc, \uc5ec\ub7ec\ubd84\uc758 \uc544\ubc14\ud0c0 \uc131\ub2a5\uc740 \ud2b9\uc815\ud55c \uc228\uaca8\uc9c4 \ud1b5\uacc4\uac00 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \uac83\uc744 \uc554\uc2dc\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ub9c8\ub77c\ud1a4\uc5d0\uc11c \ub0ae\uc740 \uc9c0\uc5f0 \uc2dc\uac04 \uc5f0\uacb0\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \ub354 \ub9ce\uc740 \uc785\ub825\uc744 \uc2e4\ud589\ud560 \uc218 \uc788\uc74c\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4. \uc774\ub294 \uc2e4\uc81c\ub85c \uccb4\ub825\uc758 \uc228\uaca8\uc9c4 \uc774\uc810\uc785\ub2c8\ub2e4. \ub610\ud55c \uc608\uc220 \uc218\uc601 \ub3c4\uc911 \ub9ac\ub4ec\uac10 \uc788\ub294 \ubc84\ud2bc \ub204\ub974\uae30\ub294 \uc7a5\uc560\ubb3c \uc0ac\uc774\ub97c \ub354 \ubd80\ub4dc\ub7fd\uac8c \uc774\ub3d9\ud560 \uc218 \uc788\uac8c \ud574\uc90d\ub2c8\ub2e4. \uc774\ub294 \ub2e4\ub978 \ud50c\ub7ab\ud3fc \uac8c\uc784\uc5d0\uc11c \uccb4\ub825\uc774 \uc0ac\uc6a9\ub418\ub294 \ubc29\uc2dd\uacfc \uc720\uc0ac\ud569\ub2c8\ub2e4."}, {"question": "\ub450\ub4e4 \ucc54\ud53c\uc5b8 \uc544\uc77c\ub79c\ub4dc \uac8c\uc784\uc758 \ub9c8\ub77c\ud1a4 \uc774\ubca4\ud2b8\ub97c \uc2a4\ud53c\ub4dc\ub7f0\ud558\ub294 \uc774\ub860\uc801 \ud55c\uacc4\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5a4 \uae30\uc220\uc774 \ud544\uc218\uc801\uc785\ub2c8\uae4c?", "answer": "\uc774\ub860\uc801 \uc2a4\ud53c\ub4dc\ub7f0 \ud55c\uacc4\ub294 \uc804\ud658 \uc2dc \ud504\ub808\uc784 \uc190\uc2e4 \ucd5c\uc18c\ud654 \ubc0f \ub9ac\ub4ec \ucd5c\uc801\ud654\ub85c \uadc0\uacb0\ub429\ub2c8\ub2e4. \ud544\uc218 \uae30\uc220\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. 1\ub2e8\uacc4: \ub9ac\ub4ec \uc644\ubcbd\ud654; \uafb8\uc900\ud55c \ubc15\uc790\ub294 \uba48\ucda4\uc744 \ucd5c\uc18c\ud654\ud569\ub2c8\ub2e4. 2\ub2e8\uacc4: \uc0ac\uc804 \ub85c\ub529; \uac00\ubcbc\uc6b4 \ubaa8\uba58\ud140 \uc774\uc810\uc744 \uc704\ud574 \ud68c\uc804\uc744 \ubbf8\ub9ac \uc608\uce21\ud569\ub2c8\ub2e4. 3\ub2e8\uacc4: \uacbd\ub85c \ucd5c\uc801\ud654: NPC \uad50\ud1b5 \uccb4\uc99d\uc774 \uc5c6\ub294 \uacbd\ub85c\ub97c \uc120\ud0dd\ud569\ub2c8\ub2e4. \ub7ad\ud0b9\uc5d0 \uc624\ub974\ub294 \ub370 \ud589\uc6b4\uc744 \ube55\ub2c8\ub2e4!"}, {"question": "\ub450\ub4e4 \ucc54\ud53c\uc5b8 \uc544\uc77c\ub79c\ub4dc \uac8c\uc784\uc5d0\uc11c \ud50c\ub7ab\ud3fc \uac04 \ud638\ud658\uc131 \ub610\ub294 \uc800\uc7a5 \ub370\uc774\ud130 \uc804\uc1a1\uc774 \uac00\ub2a5\ud569\ub2c8\uae4c? \uadf8\ub807\uc9c0 \uc54a\uc73c\uba74 \uc5b4\ub5a4 \ud568\ucd95\uc801\uc778 \uc758\ubbf8\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub450\ub4e4 \ucc54\ud53c\uc5b8 \uc544\uc77c\ub79c\ub4dc \uac8c\uc784\uc740 \uc6f9 \uae30\ubc18 \uac8c\uc784\uc774\uba70, \uc804\ud1b5\uc801\uc778 \uc758\ubbf8\uc5d0\uc11c \ud50c\ub7ab\ud3fc \uac04 \ud638\ud658\uc131\uc774\ub098 \uc800\uc7a5 \ub370\uc774\ud130 \uc804\uc1a1\uc744 \uc81c\uacf5\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc774 \uac8c\uc784\uc740 \ub370\uc2a4\ud06c\ud0d1 \ub610\ub294 \ubaa8\ubc14\uc77c \uc6f9 \ube0c\ub77c\uc6b0\uc800\uc5d0\uc11c \uc628\ub77c\uc778\uc73c\ub85c \ud50c\ub808\uc774\ud558\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc9c4\ud589 \uc0c1\ud669\uc740(\ud574\ub2f9\ub418\ub294 \uacbd\uc6b0) Google \uacc4\uc815\uacfc \uc5f0\uacb0\ub418\uc5b4 \uc788\uc73c\ubbc0\ub85c \uc7a5\uce58\ub97c \uc804\ud658\ud558\ub824\uba74 \ub2e8\uc21c\ud788 \ub85c\uadf8\uc778\ud558\uba74 \ub429\ub2c8\ub2e4. \uc774\ub294 \ub3d9\uc77c\ud55c Google \uacc4\uc815\uc744 \uc0ac\uc6a9\ud558\ub294 \ud55c, \uc7a5\uce58 \uac04\uc5d0 \uc6d0\ud65c\ud558\uac8c \uc561\uc138\uc2a4\ud560 \uc218 \uc788\ub2e4\ub294 \uac83\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4."}, {"question": "\ub450\ub4e4 \ucc54\ud53c\uc5b8 \uc544\uc77c\ub79c\ub4dc \uac8c\uc784\uc758 \uc11c\ub85c \ub2e4\ub978 '\ucc54\ud53c\uc5b8' \ub4a4\uc5d0\ub294 \uc5b4\ub5a4 \uc774\uc57c\uae30\uac00 \uc788\uc73c\uba70, \uc5b4\ub5a4 \ucc54\ud53c\uc5b8\uc774 \uac00\uc7a5 \uae4a\uc740 \ubc30\uacbd \uc2a4\ud1a0\ub9ac\ub97c \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uac01 \ucc54\ud53c\uc5b8\uc740 \uc77c\ubcf8 \ubbfc\ub2f4\uacfc \uad00\ub828\ub41c \ud2b9\uc131\uc744 \ubc18\uc601\ud569\ub2c8\ub2e4. \ubaa8\ub4e0 \ucc54\ud53c\uc5b8 \uc911 \uc624\ub2c8\ub294 \uc544\ub9c8\ub3c4 \uc77c\ubcf8 \ubbfc\ub2f4\uc758 \uc804\ud1b5\uc801\uc778 \uc545\ub9c8\uc801\uc774\uace0 \uc545\uc758\uc801\uc778 \uc778\ubb3c\uc5d0\uc11c \ube44\ub86f\ub418\uc5b4 \uac00\uc7a5 \uae4a\uc740 \ubc30\uacbd \uc2a4\ud1a0\ub9ac\ub97c \uac00\uc9c4 \uac83\uc73c\ub85c \uac04\uc8fc\ub429\ub2c8\ub2e4. \uc624\ub2c8 \ud018\uc2a4\ud2b8\ub97c \ud1b5\ud574 \uc774\uc57c\uae30\uc640 \ud50c\ub808\uc774\ud558\uba74 \uace0\uc804\uc801\uc778 \ubbfc\ub2f4\uc758 \uac8c\uc784 \ub0b4 \uc7ac\ud574\uc11d\uc744 \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4!"}]
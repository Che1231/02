[{"question": "Doodle Champion Island Games\uff1a\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u79fb\u52d5\u89d2\u8272\u4e26\u8207\u7269\u4ef6\u4e92\u52d5\uff1f", "answer": "\u6b61\u8fce\u4f86\u5230\u904a\u6232\uff01\u79fb\u52d5\u60a8\u7684\u89d2\u8272\u5f88\u7c21\u55ae\uff1a\u4f7f\u7528\u9375\u76e4\u4e0a\u7684\u65b9\u5411\u9375\u3002\u8981\u8207\u7269\u4ef6\u6216\u89d2\u8272\u4e92\u52d5\uff0c\u8acb\u9760\u8fd1\u5b83\u5011\uff0c\u7136\u5f8c\u6309\u4e0b\u7a7a\u683c\u9375\u3002\u4f8b\u5982\uff0c\u8d70\u5230\u7d05\u8272\u7684\u9ce5\u5c45\uff0c\u6309\u4e0b\u7a7a\u683c\u9375\uff0c\u5373\u53ef\u89f8\u767c\u958b\u555f\u4e8b\u4ef6\uff0c\u958b\u59cb\u904a\u6232\uff01"}, {"question": "Doodle Champion Island Games\u6709\u54ea\u4e9b\u4e0d\u540c\u7684\u904b\u52d5\u9805\u76ee\uff1f\u54ea\u4e00\u7a2e\u6700\u9069\u5408\u65b0\u624b\u5165\u9580\uff1f", "answer": "Doodle Champion Island Games\u5305\u542b\u4e03\u7a2e\u4e0d\u540c\u7684\u904b\u52d5\u9805\u76ee\u3002\u9019\u4e9b\u5305\u62ec\u684c\u7403\u3001\u6ed1\u677f\u3001\u5c04\u7bad\u3001\u6a44\u6b16\u7403\u3001\u85dd\u8853\u6e38\u6cf3\u3001\u6500\u5ca9\u548c\u99ac\u62c9\u677e\u3002\u5c0d\u65bc\u65b0\u624b\u4f86\u8aaa\uff0c\u684c\u7403\u901a\u5e38\u88ab\u8a8d\u70ba\u662f\u6700\u5bb9\u6613\u638c\u63e1\u7684\uff0c\u56e0\u70ba\u5b83\u7684\u63a7\u5236\u65b9\u5f0f\u76f8\u7576\u76f4\u63a5\u3002"}, {"question": "\u6211\u5728 Doodle Champion Island Games \u7684\u6500\u722c\u5c0f\u904a\u6232\u9047\u5230\u56f0\u96e3\uff1f\u6709\u4ec0\u9ebc\u6539\u5584\u6280\u5de7\uff1f", "answer": "\u8a31\u591a\u73a9\u5bb6\u767c\u73fe\u6500\u722c\u5c0f\u904a\u6232\u5177\u6709\u6311\u6230\u6027\u3002\u4ee5\u4e0b\u5206\u89e3\u6b65\u9a5f\uff1a\u6b65\u9a5f 1\uff1a\u89c0\u5bdf\u624b\u628a\u3002\u5b83\u5011\u6703\u8fc5\u901f\u6d88\u5931\uff01\u6b65\u9a5f 2\uff1a\u4f7f\u7528 A \u548c D \u9375\uff08\u6216\u5de6\u53f3\u65b9\u5411\u9375\uff09\u5feb\u901f\u5207\u63db\u96d9\u624b\u3002\u6b65\u9a5f 3\uff1a\u898f\u5283\u4f60\u7684\u6500\u722c\uff1b\u4e0d\u8981\u96a8\u6a5f\u6293\u53d6\u3002\u60f3\u50cf\u4e00\u4e0b\uff0c\u9019\u5c31\u50cf\u97f3\u6a02\u6905\uff1b\u4f60\u9700\u8981\u9810\u6e2c\u4e0b\u4e00\u500b\u53ef\u7528\u7684\u652f\u9ede\u3002"}, {"question": "Doodle Champion Island Games\uff1a\u4f5c\u70ba\u81ea\u5a92\u9ad4\u4f7f\u7528\u8005\uff0c\u5982\u4f55\u62cd\u651d\u7cbe\u7f8e\u7684\u622a\u5716\uff1f", "answer": "\u8981\u70ba\u60a8\u7684\u5167\u5bb9\u62cd\u651d\u7cbe\u5f69\u7684\u622a\u5716\uff0c\u8acb\u6309\u4e0b\u9375\u76e4\u4e0a\u7684\u300ePrint Screen\u300f\uff08PrtScn\uff09\u9375\u3002\u5716\u7247\u5c07\u6703\u8907\u88fd\u5230\u526a\u8cbc\u7c3f\uff0c\u7136\u5f8c\u958b\u555f\u5716\u7247\u7de8\u8f2f\u8edf\u9ad4\uff08\u4f8b\u5982 Paint \u6216 Photoshop\uff09\uff0c\u6309\u4e0b Ctrl+V\uff08\u8cbc\u4e0a\uff09\u5c07\u622a\u5716\u8cbc\u4e0a\u3002\u6216\u8005\uff0c\u4f7f\u7528 Windows \u9375 + Shift + 'S' \u4f86\u4f7f\u7528\u87a2\u5e55\u64f7\u53d6\u5de5\u5177\u64f7\u53d6\u87a2\u5e55\u7684\u4e00\u90e8\u5206\u3002\u8acb\u78ba\u4fdd\u60a8\u7684\u87a2\u5e55\u89e3\u6790\u5ea6\u8a2d\u5b9a\u70ba\u9ad8\uff0c\u4ee5\u7372\u5f97\u66f4\u597d\u7684\u64f7\u5716\u54c1\u8cea\u3002"}, {"question": "\u9664\u4e86\u7372\u52dd\u4e4b\u5916\uff0c\u5728 Doodle Champion Island Games \u52a0\u5165\u5718\u968a\u6709\u4ec0\u9ebc\u597d\u8655\uff1f", "answer": "\u52a0\u5165\u5718\u968a\u4e0d\u50c5\u50c5\u662f\u7372\u5f97\u70ab\u8000\u7684\u8cc7\u683c\u3002\u5b83\u9084\u6703\u5f71\u97ff\u8f09\u5165\u756b\u9762\u7684\u5916\u89c0\uff0c\u6539\u8b8a\u904a\u6232\u4e2d\u67d0\u4e9b\u8996\u89ba\u6548\u679c\u7684\u984f\u8272\uff0c\u4e26\u6388\u4e88\u7368\u7279\u7684\u5718\u968a\u7279\u5b9a\u6210\u5c31\u3002\u4f8b\u5982\uff0c\u52a0\u5165\u7d05\u968a\u6703\u8b93\u60a8\u770b\u5230\u4e00\u4e9b\u5e36\u6709\u7d05\u8272\u98a8\u683c\u7684\u5143\u7d20\u3002\u53ef\u4ee5\u5c07\u6b64\u8996\u70ba\u5177\u6709\u6210\u5c31\u734e\u52f5\u7684\u88dd\u98fe\u5347\u7d1a\uff01"}, {"question": "Doodle Champion Island Games\uff1a\u5b8c\u6210\u6240\u6709\u4efb\u52d9\u7684\u73a9\u5bb6\uff0c\u61c9\u8a72\u512a\u5148\u5728\u65e9\u671f\u5c0b\u627e\u54ea\u4e9b\u96b1\u85cf\u5340\u57df\u6216\u5f69\u86cb\uff1f", "answer": "\u521d\u671f\uff0c\u91cd\u9ede\u662f\u5c0b\u627e\u4f4d\u65bc\u5c04\u7bad\u5834\u9644\u8fd1\u96b1\u85cf\u7684\u72f8\u8c93\u96d5\u50cf\u3002\u8207\u5b83\u4e92\u52d5\u5c07\u6703\u89e3\u9396\u4e00\u7cfb\u5217\u8207\u81ea\u7136\u4fdd\u80b2\u76f8\u95dc\u7684\u652f\u7dda\u4efb\u52d9\uff0c\u5b8c\u6210\u5f8c\u6703\u7372\u5f97\u7a00\u6709\u5fbd\u7ae0\u3002\u72f8\u8c93\u96d5\u50cf\u96b1\u85cf\u5728\u5c04\u7bad\u9580\u7684\u53f3\u5074\uff0c\u9760\u8fd1\u4e00\u4e9b\u8349\u5730\u3002"}, {"question": "\u5728 Doodle Champion Island Games \u7684\u4e0d\u540c\u904b\u52d5\u9805\u76ee\u4e2d\uff0c\u8010\u529b\u7b49\u5c6c\u6027\u5982\u4f55\u5f71\u97ff\u8868\u73fe\uff1f", "answer": "\u96d6\u7136\u6c92\u6709\u660e\u78ba\u5b9a\u7fa9\u53ef\u4f9b\u73a9\u5bb6\u770b\u5230\u7684\u8010\u529b\u5c6c\u6027\uff0c\u4f46\u60a8\u7684\u5316\u8eab\u8868\u73fe\u6697\u793a\uff0c\u67d0\u4e9b\u96b1\u85cf\u5c6c\u6027\u78ba\u5be6\u6703\u5f71\u97ff\u904a\u6232\u73a9\u6cd5\u3002\u4f8b\u5982\uff0c\u5728\u99ac\u62c9\u677e\u6bd4\u8cfd\u4e2d\uff0c\u8f03\u4f4e\u7684\u5ef6\u9072\u9023\u7dda\u4ee3\u8868\u73a9\u5bb6\u53ef\u4ee5\u57f7\u884c\u66f4\u591a\u8f38\u5165\uff0c\u5f9e\u672c\u8cea\u4e0a\u4f86\u8aaa\uff0c\u63d0\u4f9b\u4e86\u96b1\u85cf\u7684\u8010\u529b\u512a\u52e2\u3002\u540c\u6a23\u5730\uff0c\u5728\u85dd\u8853\u6e38\u6cf3\u671f\u9593\u7684\u7bc0\u594f\u5f0f\u6309\u9375\u64cd\u4f5c\u53ef\u4ee5\u4f7f\u5316\u8eab\u5728\u969c\u7919\u7269\u4e4b\u9593\u64c1\u6709\u66f4\u9806\u66a2\u7684\u7a7f\u8d8a\uff0c\u9019\u985e\u4f3c\u65bc\u5176\u4ed6\u5e73\u53f0\u904a\u6232\u4e2d\u8010\u529b\u4f7f\u7528\u7684\u6a21\u5f0f\u3002"}, {"question": "Doodle Champion Island Games\u7684\u99ac\u62c9\u677e\u8cfd\u7a0b\u5728\u901f\u5ea6\u8dd1\u7684\u7406\u8ad6\u6975\u9650\u662f\u4ec0\u9ebc\uff1f\u54ea\u4e9b\u6280\u8853\u662f\u5fc5\u8981\u7684\uff1f", "answer": "\u901f\u5ea6\u8dd1\u7684\u7406\u8ad6\u6975\u9650\uff0c\u6b78\u7d50\u70ba\u6700\u5c0f\u5316\u8f49\u63db\u904e\u7a0b\u4e2d\u7684\u756b\u9762\u640d\u5931\uff0c\u4e26\u512a\u5316\u7bc0\u594f\u3002\u5fc5\u8981\u7684\u6280\u5de7\u5305\u62ec\uff1a\u6b65\u9a5f 1\uff1a\u5b8c\u7f8e\u5730\u638c\u63e1\u7bc0\u594f\uff1b\u7a69\u5b9a\u7684\u7bc0\u594f\u53ef\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u6e1b\u5c11\u5361\u9813\u3002\u6b65\u9a5f 2\uff1a\u9810\u8f09\u5165\uff1a\u63d0\u524d\u9810\u6e2c\u8f49\u5f4e\uff0c\u7372\u5f97\u7565\u5fae\u7684\u52d5\u91cf\u512a\u52e2\u3002\u6b65\u9a5f 3\uff1a\u512a\u5316\u8def\u7dda\uff1a\u907f\u958bNPC\u4ea4\u901a\u64c1\u5835\u7684\u8def\u5f91\u3002\u795d\u4f60\u5728\u6392\u884c\u699c\u4e0a\u53d6\u5f97\u597d\u6210\u7e3e\uff01"}, {"question": "Doodle Champion Island Games\u652f\u63f4\u8de8\u5e73\u53f0\u76f8\u5bb9\u6027\u6216\u5132\u5b58\u8cc7\u6599\u8f49\u79fb\u55ce\uff1f\u5982\u679c\u4e0d\u662f\uff0c\u6709\u4ec0\u9ebc\u5f8c\u679c\uff1f", "answer": "Doodle Champion Island Games \u662f\u4e00\u6b3e\u57fa\u65bc\u700f\u89bd\u5668\u7684\u904a\u6232\uff0c\u4e0d\u63d0\u4f9b\u50b3\u7d71\u610f\u7fa9\u4e0a\u7684\u8de8\u5e73\u53f0\u76f8\u5bb9\u6027\u6216\u5132\u5b58\u8cc7\u6599\u8f49\u79fb\u3002\u6b64\u904a\u6232\u8a2d\u8a08\u53ef\u5728\u684c\u9762\u6216\u884c\u52d5\u88dd\u7f6e\u7684\u7db2\u9801\u700f\u89bd\u5668\u4e0a\u7dda\u4e0a\u904a\u73a9\u3002\u7531\u65bc\u9032\u5ea6\u8207\u60a8\u7684Google\u5e33\u6236\u76f8\u95dc\u806f\uff08\u5982\u6709\u9069\u7528\uff09\uff0c\u56e0\u6b64\u5728\u4e0d\u540c\u88dd\u7f6e\u4e4b\u9593\u5207\u63db\u53ea\u9700\u767b\u5165\u5373\u53ef\u3002\u9019\u610f\u5473\u8457\uff0c\u53ea\u8981\u60a8\u4f7f\u7528\u76f8\u540c\u7684 Google \u5e33\u6236\uff0c\u5c31\u53ef\u4ee5\u5728\u4e0d\u540c\u88dd\u7f6e\u4e4b\u9593\u9806\u66a2\u5b58\u53d6\u3002"}, {"question": "\u5728 Doodle Champion Island Games\u4e2d\uff0c\u4e0d\u540c\u300e\u51a0\u8ecd\u300f\u80cc\u5f8c\u7684\u6545\u4e8b\u662f\u4ec0\u9ebc\uff1f\u54ea\u4e00\u500b\u6709\u6700\u8c50\u5bcc\u7684\u80cc\u666f\u6545\u4e8b\uff1f", "answer": "\u6bcf\u500b\u51a0\u8ecd\u90fd\u9ad4\u73fe\u8207\u65e5\u672c\u6c11\u9593\u50b3\u8aaa\u76f8\u95dc\u7684\u7279\u6027\u3002\u5728\u6240\u6709\u51a0\u8ecd\u4e2d\uff0c\u9b3c\uff08Oni\uff09\u53ef\u8b02\u64c1\u6709\u6700\u8c50\u5bcc\u7684\u80cc\u666f\u6545\u4e8b\uff0c\u6e90\u81ea\u65bc\u65e5\u672c\u6c11\u9593\u50b3\u8aaa\u4e2d\u90aa\u60e1\u4e14\u60e1\u6bd2\u7684\u4eba\u7269\u5f62\u8c61\u3002\u900f\u904e\u53c3\u8207\u6545\u4e8b\u4e26\u904a\u73a9\u9b3c\u7684\u4efb\u52d9\uff0c\u60a8\u53ef\u4ee5\u767c\u73fe\u4e00\u500b\u5728\u904a\u6232\u4e2d\u91cd\u8ff0\u7684\u7d93\u5178\u50b3\u8aaa\uff01"}]
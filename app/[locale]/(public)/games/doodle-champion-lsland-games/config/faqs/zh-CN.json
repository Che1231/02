[{"question": "Doodle Champion Island Games\uff1a\u4f5c\u4e3a\u65b0\u624b\uff0c\u6211\u8be5\u5982\u4f55\u79fb\u52a8\u89d2\u8272\u5e76\u4e0e\u6e38\u620f\u5bf9\u8c61\u4e92\u52a8\uff1f", "answer": "\u6b22\u8fce\u6765\u5230\u6e38\u620f\uff01\u79fb\u52a8\u89d2\u8272\u5f88\u7b80\u5355\uff1a\u4f7f\u7528\u952e\u76d8\u4e0a\u7684\u65b9\u5411\u952e\u3002\u8981\u4e0e\u6e38\u620f\u5bf9\u8c61\u6216\u89d2\u8272\u4e92\u52a8\uff0c\u9760\u8fd1\u5b83\u4eec\u5e76\u6309\u4e0b\u7a7a\u683c\u952e\u3002\u4f8b\u5982\uff0c\u8d70\u5230\u7ea2\u8272\u7684\u9e1f\u5c45\u95e8\u524d\uff0c\u6309\u4e0b\u7a7a\u683c\u952e\u89e6\u53d1\u5f00\u542f\u4e8b\u4ef6\uff0c\u8fdb\u5165\u6e38\u620f\uff01"}, {"question": "Doodle Champion Island Games\u4e2d\u6709\u54ea\u4e9b\u4e0d\u540c\u7684\u8fd0\u52a8\u9879\u76ee\uff0c\u54ea\u4e00\u9879\u6700\u9002\u5408\u65b0\u624b\u638c\u63e1\uff1f", "answer": "Doodle Champion Island Games\u5305\u542b\u4e03\u79cd\u4e0d\u540c\u7684\u8fd0\u52a8\u9879\u76ee\u3002\u5176\u4e2d\u5305\u62ec\u4e52\u4e53\u7403\u3001\u6ed1\u677f\u3001\u5c04\u7bad\u3001\u6a44\u6984\u7403\u3001\u827a\u672f\u6e38\u6cf3\u3001\u6500\u5ca9\u548c\u9a6c\u62c9\u677e\u3002\u5bf9\u4e8e\u65b0\u624b\u6765\u8bf4\uff0c\u4e52\u4e53\u7403\u901a\u5e38\u88ab\u8ba4\u4e3a\u662f\u6700\u5bb9\u6613\u638c\u63e1\u7684\uff0c\u56e0\u4e3a\u5b83\u63a7\u5236\u7b80\u5355\u3002"}, {"question": "\u6211\u5728Doodle Champion Island Games\u7684\u6500\u5ca9\u8ff7\u4f60\u6e38\u620f\u4e2d\u9047\u5230\u56f0\u96be\uff0c\u6709\u4ec0\u4e48\u6539\u8fdb\u5efa\u8bae\uff1f", "answer": "\u8bb8\u591a\u73a9\u5bb6\u53d1\u73b0\u6500\u5ca9\u8ff7\u4f60\u6e38\u620f\u5177\u6709\u6311\u6218\u6027\u3002\u4ee5\u4e0b\u662f\u5206\u89e3\u6b65\u9aa4\uff1a\u6b65\u9aa41\uff1a\u89c2\u5bdf\u6293\u624b\u3002\u5b83\u4eec\u4f1a\u8fc5\u901f\u6d88\u5931\uff01\u6b65\u9aa42\uff1a\u4f7f\u7528A\u548cD\u952e\uff08\u6216\u5de6\u53f3\u65b9\u5411\u952e\uff09\u5feb\u901f\u5207\u6362\u53cc\u624b\u3002\u6b65\u9aa43\uff1a\u8ba1\u5212\u4f60\u7684\u6500\u722c\uff0c\u4e0d\u8981\u968f\u610f\u6293\u53d6\u3002\u628a\u5b83\u60f3\u8c61\u6210\u97f3\u4e50\u6905\u5b50\u6e38\u620f\uff1b\u4f60\u9700\u8981\u9884\u6d4b\u4e0b\u4e00\u4e2a\u53ef\u7528\u7684\u6293\u624b\u3002"}, {"question": "Doodle Champion Island Games\uff1a\u4f5c\u4e3a\u81ea\u5a92\u4f53\u7528\u6237\uff0c\u5982\u4f55\u62cd\u6444\u4ee4\u4eba\u60ca\u53f9\u7684\u5c4f\u5e55\u622a\u56fe\uff1f", "answer": "\u4e3a\u4e86\u5728\u4f60\u7684\u5185\u5bb9\u4e2d\u6355\u6349\u4ee4\u4eba\u60ca\u53f9\u7684\u5c4f\u5e55\u622a\u56fe\uff0c\u8bf7\u6309\u4e0b\u952e\u76d8\u4e0a\u7684\u201cPrtScn\u201d\uff08\u6253\u5370\u5c4f\u5e55\uff09\u952e\u3002\u56fe\u7247\u5c06\u88ab\u590d\u5236\u5230\u526a\u8d34\u677f\uff0c\u7136\u540e\u6253\u5f00\u56fe\u50cf\u7f16\u8f91\u8f6f\u4ef6\uff08\u4f8b\u5982\u753b\u56fe\u6216Photoshop\uff09\uff0c\u6309\u4e0bCtrl+V\uff08\u7c98\u8d34\uff09\u5c06\u5c4f\u5e55\u622a\u56fe\u7c98\u8d34\u8fdb\u53bb\u3002\u6216\u8005\uff0c\u4f7f\u7528Windows\u952e+Shift+'S'\u4f7f\u7528\u622a\u56fe\u5de5\u5177\u6765\u622a\u53d6\u5c4f\u5e55\u7684\u4e00\u90e8\u5206\u3002\u4e3a\u83b7\u5f97\u66f4\u597d\u7684\u622a\u56fe\u8d28\u91cf\uff0c\u8bf7\u786e\u4fdd\u8bbe\u7f6e\u4e86\u8f83\u9ad8\u7684\u5c4f\u5e55\u5206\u8fa8\u7387\u3002"}, {"question": "\u9664\u4e86\u83b7\u80dc\uff0c\u5728Doodle Champion Island Games\u4e2d\u52a0\u5165\u56e2\u961f\u8fd8\u6709\u4ec0\u4e48\u597d\u5904\uff1f", "answer": "\u52a0\u5165\u56e2\u961f\u4e0d\u4ec5\u53ef\u4ee5\u83b7\u5f97\u70ab\u8000\u7684\u6743\u5229\u3002\u5b83\u8fd8\u4f1a\u5f71\u54cd\u52a0\u8f7d\u5c4f\u5e55\u7684\u5916\u89c2\uff0c\u6539\u53d8\u6e38\u620f\u8fc7\u7a0b\u4e2d\u67d0\u4e9b\u89c6\u89c9\u6548\u679c\u7684\u989c\u8272\uff0c\u5e76\u6388\u4e88\u72ec\u7279\u7684\u56e2\u961f\u7279\u5b9a\u6210\u5c31\u3002\u4f8b\u5982\uff0c\u52a0\u5165\u7ea2\u8272\u56e2\u961f\u53ef\u4ee5\u8ba9\u4f60\u770b\u5230\u4e00\u4e9b\u5e26\u6709\u7ea2\u8272\u4eae\u70b9\u7684\u5143\u7d20\u3002\u53ef\u4ee5\u5c06\u5176\u89c6\u4e3a\u5e26\u6709\u6210\u5c31\u5956\u52b1\u7684\u88c5\u9970\u5347\u7ea7\uff01"}, {"question": "Doodle Champion Island Games\uff1a\u5b8c\u6210\u4efb\u52a1\u7684\u73a9\u5bb6\u5e94\u8be5\u4f18\u5148\u5bfb\u627e\u54ea\u4e9b\u9690\u85cf\u533a\u57df\u6216\u5f69\u86cb\uff1f", "answer": "\u4e00\u5f00\u59cb\uff0c\u4e13\u6ce8\u4e8e\u5bfb\u627e\u5f13\u7bad\u573a\u9644\u8fd1\u9690\u85cf\u7684\u72f8\u732b\u96d5\u50cf\u3002\u4e0e\u5176\u4e92\u52a8\u5c06\u89e3\u9501\u4e00\u7cfb\u5217\u4e0e\u81ea\u7136\u4fdd\u62a4\u76f8\u5173\u7684\u652f\u7ebf\u4efb\u52a1\uff0c\u5b8c\u6210\u8fd9\u4e9b\u4efb\u52a1\u5c06\u5956\u52b1\u4f60\u4e00\u679a\u7a00\u6709\u5fbd\u7ae0\u3002\u72f8\u732b\u96d5\u50cf\u9690\u85cf\u5728\u5f13\u7bad\u95e8\u53f3\u4fa7\uff0c\u9760\u8fd1\u4e00\u4e9b\u8349\u5730\u3002"}, {"question": "\u5728Doodle Champion Island Games\u4e2d\uff0c\u4f53\u529b\u7b49\u5c5e\u6027\u5982\u4f55\u5f71\u54cd\u4e0d\u540c\u8fd0\u52a8\u9879\u76ee\u7684\u8868\u73b0\uff1f", "answer": "\u867d\u7136\u5bf9\u73a9\u5bb6\u6765\u8bf4\u6ca1\u6709\u660e\u786e\u5b9a\u4e49\u7684\u4f53\u529b\u5c5e\u6027\uff0c\u4f46\u4f60\u7684\u5316\u8eab\u7684\u8868\u73b0\u6697\u793a\u4e86\u67d0\u4e9b\u9690\u85cf\u5c5e\u6027\u786e\u5b9e\u4f1a\u5f71\u54cd\u6e38\u620f\u73a9\u6cd5\u3002\u4f8b\u5982\uff0c\u5728\u9a6c\u62c9\u677e\u4e2d\uff0c\u8f83\u4f4e\u7684\u5ef6\u8fdf\u8fde\u63a5\u610f\u5473\u7740\u73a9\u5bb6\u53ef\u4ee5\u6267\u884c\u66f4\u591a\u8f93\u5165\uff0c\u4ece\u672c\u8d28\u4e0a\u63d0\u4f9b\u9690\u85cf\u7684\u4f53\u529b\u4f18\u52bf\u3002\u540c\u6837\uff0c\u5728\u827a\u672f\u6e38\u6cf3\u8fc7\u7a0b\u4e2d\uff0c\u8282\u594f\u5316\u7684\u6309\u952e\u64cd\u4f5c\u53ef\u4ee5\u4f7f\u5316\u8eab\u5728\u969c\u788d\u7269\u4e4b\u95f4\u66f4\u6d41\u7545\u5730\u7a7f\u68ad\uff0c\u4e0e\u5176\u4ed6\u5e73\u53f0\u6e38\u620f\u4e2d\u4f53\u529b\u4f7f\u7528\u7684\u673a\u5236\u7c7b\u4f3c\u3002"}, {"question": "\u7406\u8bba\u4e0a\uff0c\u5728Doodle Champion Island Games\u7684\u9a6c\u62c9\u677e\u4e8b\u4ef6\u4e2d\uff0c\u901f\u5ea6\u8dd1\u7684\u6781\u9650\u662f\u591a\u5c11\uff1f\u54ea\u4e9b\u6280\u5de7\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u7406\u8bba\u4e0a\u7684\u901f\u5ea6\u8dd1\u6781\u9650\u5f52\u7ed3\u4e3a\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u8fc7\u6e21\u8fc7\u7a0b\u4e2d\u7684\u5e27\u635f\u5931\u4ee5\u53ca\u4f18\u5316\u8282\u594f\u3002\u5173\u952e\u6280\u672f\u5305\u62ec\uff1a\u6b65\u9aa41\uff1a\u5b8c\u7f8e\u5730\u638c\u63e1\u8282\u594f\uff1b\u7a33\u5b9a\u7684\u8282\u594f\u53ef\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u5361\u987f\u3002\u6b65\u9aa42\uff1a\u9884\u52a0\u8f7d\uff1a\u63d0\u524d\u9884\u6d4b\u8f6c\u5f2f\u4ee5\u83b7\u5f97\u5fae\u5c0f\u7684\u52a8\u91cf\u4f18\u52bf\u3002\u6b65\u9aa43\uff1a\u4f18\u5316\u8def\u7ebf\uff1a\u7ed5\u5f00NPC\u4ea4\u901a\u5835\u585e\u7684\u8def\u7ebf\u3002\u795d\u4f60\u5728\u6392\u884c\u699c\u4e0a\u53d6\u5f97\u597d\u6210\u7ee9\uff01"}, {"question": "Doodle Champion Island Games\u662f\u5426\u6709\u8de8\u5e73\u53f0\u517c\u5bb9\u6027\u6216\u5b58\u6863\u6570\u636e\u4f20\u8f93\u529f\u80fd\uff1f\u5982\u679c\u6ca1\u6709\uff0c\u4f1a\u6709\u4ec0\u4e48\u5f71\u54cd\uff1f", "answer": "Doodle Champion Island Games\u662f\u4e00\u6b3e\u57fa\u4e8e\u6d4f\u89c8\u5668\u7684\u6e38\u620f\uff0c\u5728\u4f20\u7edf\u610f\u4e49\u4e0a\u5e76\u4e0d\u63d0\u4f9b\u8de8\u5e73\u53f0\u517c\u5bb9\u6027\u6216\u5b58\u6863\u6570\u636e\u4f20\u8f93\u3002\u8be5\u6e38\u620f\u65e8\u5728\u901a\u8fc7\u684c\u9762\u6216\u79fb\u52a8\u7f51\u7edc\u6d4f\u89c8\u5668\u5728\u7ebf\u8fdb\u884c\u6e38\u620f\u3002\u7531\u4e8e\u8fdb\u5ea6\u4e0e\u4f60\u7684\u8c37\u6b4c\u8d26\u6237\uff08\u5982\u679c\u9002\u7528\uff09\u76f8\u5173\u8054\uff0c\u56e0\u6b64\u5728\u8bbe\u5907\u4e4b\u95f4\u5207\u6362\u53ea\u9700\u767b\u5f55\u5373\u53ef\u3002\u8fd9\u610f\u5473\u7740\u5728\u4f7f\u7528\u540c\u4e00\u8c37\u6b4c\u8d26\u6237\u7684\u60c5\u51b5\u4e0b\uff0c\u5728\u4e0d\u540c\u8bbe\u5907\u4e0a\u90fd\u80fd\u65e0\u7f1d\u8bbf\u95ee\u3002"}, {"question": "Doodle Champion Island Games\u4e2d\u4e0d\u540c\"\u51a0\u519b\"\u80cc\u540e\u7684\u6545\u4e8b\u662f\u4ec0\u4e48\uff1f\u54ea\u4e2a\u51a0\u519b\u7684\u4f20\u8bf4\u6700\u6df1\u539a\uff1f", "answer": "\u6bcf\u4e2a\u51a0\u519b\u90fd\u4f53\u73b0\u4e86\u4e0e\u65e5\u672c\u6c11\u95f4\u4f20\u8bf4\u76f8\u5173\u7684\u7279\u5f81\u3002\u5728\u6240\u6709\u51a0\u519b\u4e2d\uff0c\u9b3c\u7684\u4f20\u8bf4 Arguably \u6700\u4e3a\u6df1\u539a\uff0c\u56e0\u4e3a\u5b83\u6c72\u53d6\u4e86\u65e5\u672c\u6c11\u95f4\u4f20\u8bf4\u4e2d\u4f20\u7edf\u6076\u9b54\u548c\u90aa\u6076\u4eba\u7269\u7684\u7075\u611f\u3002\u901a\u8fc7\u53c2\u4e0e\u6545\u4e8b\u548c\u73a9\u9b3c\u7684\u4efb\u52a1\uff0c\u4f60\u53ef\u4ee5\u53d1\u73b0\u6e38\u620f\u5185\u5bf9\u7ecf\u5178\u4f20\u8bf4\u7684\u91cd\u65b0\u6f14\u7ece\uff01"}]
[{"question": "\ucd08\ubcf4\uc790\uac00 2\ub2e8\uacc4\uc758 \ubd88\uac00\ub2a5\ud55c \ud034\uc988 \uac8c\uc784\uc744 \uc5b4\ub5bb\uac8c \uc2dc\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "2\ub2e8\uacc4\uc758 \ubd88\uac00\ub2a5\ud55c \ud034\uc988 \uac8c\uc784\uc744 \uc2dc\uc791\ud558\ub824\uba74 \uba3c\uc800 \ud574\ub2f9 \uac8c\uc784\uc744 \uae30\uae30\uc5d0 \uc124\uce58\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc2ed\uc2dc\uc624. \uac8c\uc784\uc744 \uc2e4\ud589\ud558\uba74 \uba54\uc778 \uba54\ub274\uac00 \ud45c\uc2dc\ub429\ub2c8\ub2e4. \uc2dc\uc791\ud558\ub824\uba74 \"\ud50c\ub808\uc774\"\ub97c \uc120\ud0dd\ud558\uc2ed\uc2dc\uc624. \uccab \ubc88\uc9f8 \uc9c8\ubb38\uc774 \ub098\ud0c0\ub098\uace0 \ub9c8\uc6b0\uc2a4 \ub610\ub294 \ud130\uce58\uc2a4\ud06c\ub9b0\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub2f5\ubcc0\uc744 \uc120\ud0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \uc9c8\ubb38\uc5d0\uc11c \ud45c\uc2dc\ub41c \uac00\uc7a5 \ud070 \uc22b\uc790\ub97c \ud074\ub9ad\ud558\ub77c\ub294 \uc9c8\ubb38\uc744 \ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784\uc740 \uc5b4\ub824\uc6b8 \uc218 \uc788\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc73c\ubbc0\ub85c \uc0dd\uac01\uc744 \ubc97\uc5b4\ub098 \ubcf4\uc2ed\uc2dc\uc624. [\ube44\uc720 \uc124\uba85: \ubed4\ud55c \ub2f5\uc774 \uc815\ub2f5\uc774 \uc544\ub2d0 \uc218 \uc788\ub294 \uc218\uc218\uaed8\ub07c\ub97c \ud478\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "2\ub2e8\uacc4\uc758 \ubd88\uac00\ub2a5\ud55c \ud034\uc988 \uac8c\uc784\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc740 \ubb34\uc5c7\uc774\uba70 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \uc5b4\ub5bb\uac8c \ub2e4\ub985\ub2c8\uae4c?", "answer": "2\ub2e8\uacc4\uc758 \ubd88\uac00\ub2a5\ud55c \ud034\uc988 \uac8c\uc784\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc740 \uac04\ub2e8\ud569\ub2c8\ub2e4. \uc815\ub2f5\uc774\ub77c\uace0 \uc0dd\uac01\ud558\ub294 \ub2f5\ubcc0\uc744 \ud074\ub9ad\ud558\ub824\uba74 \ub9c8\uc6b0\uc2a4\ub97c \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \ubaa8\ubc14\uc77c \uae30\uae30\uc5d0\uc11c\ub294 \ub300\uc2e0 \ud654\uba74\uc744 \ud0ed\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uac8c\uc784\uc740 PC\uc640 \ubaa8\ubc14\uc77c \ud50c\ub7ab\ud3fc \ubaa8\ub450\uc640 \ud638\ud658\ub418\uc9c0\ub9cc \ucee8\ud2b8\ub864 \ubc29\uc2dd\uc740 \uc77c\uad00\uc131\uc744 \uc720\uc9c0\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ub2f5\ubcc0\uc744 \uc120\ud0dd\ud558\ub824\uba74 \uc67c\ucabd \ub9c8\uc6b0\uc2a4 \ubc84\ud2bc\uc744 \uc0ac\uc6a9\ud558\ub294 \ubc18\uba74, \ubaa8\ubc14\uc77c \uae30\uae30\uc5d0\uc11c\ub294 \ub2e8\uc21c\ud788 \ud0ed\ud558\ub294 \uac83\uc73c\ub85c \ucda9\ubd84\ud569\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: PC - \ub9c8\uc6b0\uc2a4 \ud074\ub9ad; \ubaa8\ubc14\uc77c - \ud654\uba74 \ud0ed]"}, {"question": "2\ub2e8\uacc4\uc758 \ubd88\uac00\ub2a5\ud55c \ud034\uc988 \uac8c\uc784\uc774 \uba87\uba87 \uc9c8\ubb38\uc5d0\uc11c \ube44\ud45c\uc900\uc801\uc778 \uc0ac\uace0\ub97c \uc694\uad6c\ud558\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "2\ub2e8\uacc4\uc758 \ubd88\uac00\ub2a5\ud55c \ud034\uc988 \uac8c\uc784\uc740 \uae30\uc874 \ud034\uc988 \ud615\uc2dd\uc744 \ubc97\uc5b4\ub098 \ud50c\ub808\uc774\uc5b4\uc758 \ube44\ud45c\uc900\uc801\uc778 \uc0ac\uace0\ub97c \ub3c4\uc804\ud558\uac8c \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ub9ce\uc740 \uc9c8\ubb38\uc740 \uc228\uaca8\uc9c4 \ub2e8\uc11c\ub97c \uac00\uc9c0\uace0 \uc788\uac70\ub098 \uce21\uba74\uc801\uc778 \uc0ac\uace0\ub97c \ud544\uc694\ub85c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5b4\ub5a4 \uc9c8\ubb38\uc740 \"\uc0c9\uc774 \uc544\ub2cc \ub2e8\uc5b4\ub97c \ud074\ub9ad\ud558\uc2ed\uc2dc\uc624\"\ub77c\uace0 \uc694\uad6c\ud560 \uc218 \uc788\uc9c0\ub9cc, \ub2e8\uc5b4\ub294 \ud558\ub098\ub97c \uc81c\uc678\ud558\uace0 \ubaa8\ub450 \uc0c9\uae54\uc774\uace0 \uadf8 \ud558\ub098\ub294 \ub3d9\uc74c\uc774\uc758\uc5b4\uc785\ub2c8\ub2e4. \uc774\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \ucc3d\uc758\uc801\uc73c\ub85c \uc0dd\uac01\ud558\uace0 \ud45c\uc900\uc801\uc778 \ub17c\ub9ac\uc5d0 \uc758\uc874\ud558\uc9c0 \uc54a\ub3c4\ub85d \ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ub9de\ub294 \ubc29\uc2dd\uc73c\ub85c \uc870\uac01\uc774 \ub9de\uc9c0 \uc54a\ub294 \ud37c\uc990\uc744 \ud478\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "100\uc2dc\uac04\uc758 \ud50c\ub808\uc774 \ud6c4 2\ub2e8\uacc4\uc758 \ubd88\uac00\ub2a5\ud55c \ud034\uc988 \uac8c\uc784\uc5d0\uc11c \uc9c4\ud589\uc744 \ub354 \ube60\ub974\uac8c \ud560 \uc218 \uc788\ub294 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "100\uc2dc\uac04\uc758 \ud50c\ub808\uc774 \ud6c4 2\ub2e8\uacc4\uc758 \ubd88\uac00\ub2a5\ud55c \ud034\uc988 \uac8c\uc784\uc5d0\uc11c \uc9c4\ud589\uc744 \ub354 \ube60\ub974\uac8c \ud558\ub824\uba74 \uc5ec\ub7ec \uc804\ub7b5\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc9c8\ubb38\uc758 \ud328\ud134\uacfc \ubc18\ubcf5\ub418\ub294 \uc8fc\uc81c\ub97c \uc219\uc9c0\ud569\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc5b4\ub824\uc6b4 \uc9c8\ubb38\uc744 \uac74\ub108\ub6f0\uae30 \uc704\ud574 \"\uac74\ub108\ub6f0\uae30\" \uae30\ub2a5\uc744 \ud604\uba85\ud558\uac8c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ubbf8\ub798\ub97c \uc704\ud574 \uc5b4\ub824\uc6b4 \uc9c8\ubb38\uacfc \ud574\uacb0\ucc45\uc5d0 \ub300\ud574 \uba54\ubaa8\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud2b9\uc815 \uac1d\uccb4 \uc2dc\ud000\uc2a4\ub97c \ud074\ub9ad\ud574\uc57c \ud558\ub294 \uc9c8\ubb38\uc774 \uc788\ub2e4\uba74 \ub098\uc911\uc5d0 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub3c4\ub85d \uc2dc\ud000\uc2a4\ub97c \uc801\uc5b4 \ub450\uc2ed\uc2dc\uc624. [\ub2e4\uc591\ud55c \ubc29\ubc95 \ube44\uad50: \uac74\ub108\ub6f0\uae30 vs. \uc989\uc2dc \ud480\uae30]"}, {"question": "2\ub2e8\uacc4\uc758 \ubd88\uac00\ub2a5\ud55c \ud034\uc988 \uac8c\uc784\uc5d0\uc11c \uc2dc\uac04 \uc81c\ud55c \uc9c8\ubb38\uc744 \uc5b4\ub5bb\uac8c \ub9c8\uc2a4\ud130\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "2\ub2e8\uacc4\uc758 \ubd88\uac00\ub2a5\ud55c \ud034\uc988 \uac8c\uc784\uc5d0\uc11c \uc2dc\uac04 \uc81c\ud55c \uc9c8\ubb38\uc744 \ub9c8\uc2a4\ud130\ud558\ub824\uba74 \uc5f0\uc2b5\uacfc \uc815\ud655\ub3c4\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \uce74\uc6b4\ud2b8\ub2e4\uc6b4 \ud0c0\uc774\uba38\ub098 \uc9c8\ubb38\uc758 \ub9ac\ub4ec\uc5d0 \uc8fc\uc758\ub97c \uae30\uc6b8\uc785\ub2c8\ub2e4. \ub2e8\uacc4 2: \ud544\uc694\ud55c \uc815\ud655\ud55c \uc21c\uac04\uc5d0 \ud074\ub9ad\ud558\uac70\ub098 \ud0ed\ud558\ub294 \uc5f0\uc2b5\uc744 \ud569\ub2c8\ub2e4. \ub2e8\uacc4 3: \ubaa9\uc228\uc744 \uc783\ub294 \uac83\uc744 \ud53c\ud558\uae30 \uc704\ud574 \ud655\uc2e0\uc774 \uc5c6\ub2e4\uba74 \"\uac74\ub108\ub6f0\uae30\" \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc62c\ubc14\ub978 \uc21c\uac04\uc5d0 \uc6c0\uc9c1\uc774\ub294 \ub300\uc0c1\uc744 \ud074\ub9ad\ud574\uc57c \ud558\ub294 \uc9c8\ubb38\uc5d0\uc11c\ub294 \uc815\ud655\ud560 \ub54c\uae4c\uc9c0 \ud0c0\uc774\ubc0d\uc744 \uc5f0\uc2b5\ud558\uc2ed\uc2dc\uc624. [\ud750\ub984\ub3c4: \uce74\uc6b4\ud2b8\ub2e4\uc6b4 -> \ud074\ub9ad/\ud0ed -> \uc815\ub2f5]"}, {"question": "2\ub2e8\uacc4\uc758 \ubd88\uac00\ub2a5\ud55c \ud034\uc988 \uac8c\uc784\uc5d0\uc11c \uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uac00\uc7a5 \ud754\ud55c \ud568\uc815\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "2\ub2e8\uacc4\uc758 \ubd88\uac00\ub2a5\ud55c \ud034\uc988 \uac8c\uc784\uc5d0\uc11c \uc219\ub828\ub41c \ud50c\ub808\uc774\uc5b4\ub294 \uc9c8\ubb38\uc5d0 \uc9c0\ub098\uce58\uac8c \uc0dd\uac01\ud558\ub294 \ud568\uc815\uc5d0 \ube60\uc9c0\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc2b5\ub2c8\ub2e4. \uadf8\ub4e4\uc740 \ubaa8\ub4e0 \uc9c8\ubb38\uc5d0 \uc228\uaca8\uc9c4 \ud2b8\ub9ad\uc774 \uc788\ub2e4\uace0 \uc0dd\uac01\ud558\uc5ec \uc798\ubabb\ub41c \ub2f5\ubcc0\uc744 \uc120\ud0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610 \ub2e4\ub978 \uc77c\ubc18\uc801\uc778 \ud568\uc815\uc740 \ud2b9\ud788 \uc5b4\ub824\uc6b4 \uc9c8\ubb38\uc5d0\uc11c \ubaa9\uc228\uc744 \uad6c\ud560 \uc218 \uc788\ub294 \"\uac74\ub108\ub6f0\uae30\" \uae30\ub2a5\uc744 \ubb34\uc2dc\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc9c8\ubb38\uc740 \uac04\ub2e8\ud574 \ubcf4\uc77c \uc218 \uc788\uc9c0\ub9cc \ub2f5\ubcc0\uc5d0\ub294 \ub2e4\ub978 \uad00\uc810\uc774 \ud544\uc694\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc0c9\uae54\uc774 \uc544\ub2c8\uc9c0\ub9cc \uc0c9\uae54\uacfc \ubc1c\uc74c\uc774 \uc720\uc0ac\ud55c \ub2e8\uc5b4\ub97c \ud074\ub9ad\ud574\uc57c \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ubbf8\ub85c\ub97c \ud480 \ub54c \ubcbd\ub9cc \ubcf4\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}, {"question": "2\ub2e8\uacc4\uc758 \ubd88\uac00\ub2a5\ud55c \ud034\uc988 \uac8c\uc784\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70 \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "2\ub2e8\uacc4\uc758 \ubd88\uac00\ub2a5\ud55c \ud034\uc988 \uac8c\uc784\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \uc815\ub2f5 \uac1c\uc218\uc640 \ub2f5\ubcc0 \uc18d\ub3c4\ub97c \uae30\ubc18\uc73c\ub85c \ud569\ub2c8\ub2e4. \uac01 \uc815\ub2f5\uc73c\ub85c \uc810\uc218\uac00 \ubd80\uc5ec\ub418\uba70, \ube60\ub978 \ub2f5\ubcc0\uc740 \ubcf4\ub108\uc2a4 \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc810\uc218\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc815\ud655\uc131\uc744 \uc6b0\uc120\uc73c\ub85c \ud55c \ub2e4\uc74c \uc18d\ub3c4\uc5d0 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, \uc9c8\ubb38\uc5d0 \ub300\ud55c \ub2f5\ubcc0\uc744 \uc989\uc2dc \uc54c \uc218 \uc788\ub2e4\uba74 \uc810\uc218\ub97c \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \uc2e0\uc18d\ud558\uac8c \ub2f5\ubcc0\ud558\uc2ed\uc2dc\uc624. \uadf8\ub7ec\ub098 \ud655\uc2e0\uc774 \uc5c6\ub2e4\uba74 \uc810\uc218\ub97c \uc783\uc9c0 \uc54a\uae30 \uc704\ud574 \uc2dc\uac04\uc744 \ub0b4\uc2ed\uc2dc\uc624. [\uc124\uc815 \ube44\uad50\ud45c: \uc815\ub2f5 + \uc18d\ub3c4 = \ub192\uc740 \uc810\uc218]"}, {"question": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc\uc5d0\uc11c 2\ub2e8\uacc4\uc758 \ubd88\uac00\ub2a5\ud55c \ud034\uc988 \uac8c\uc784\uc744 \uc2e4\ud589\ud558\uae30 \uc704\ud55c \uae30\uc220\uc801 \uc694\uad6c \uc0ac\ud56d\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "2\ub2e8\uacc4\uc758 \ubd88\uac00\ub2a5\ud55c \ud034\uc988 \uac8c\uc784\uc744 \uc2e4\ud589\ud558\uae30 \uc704\ud55c \uae30\uc220\uc801 \uc694\uad6c \uc0ac\ud56d\uc740 \ud50c\ub7ab\ud3fc\ubcc4\ub85c \ub2e4\ub985\ub2c8\ub2e4. PC\uc5d0\uc11c \uac8c\uc784\uc744 \uc2e4\ud589\ud558\ub824\uba74 \ucd5c\uc18c 2GB RAM\uacfc \ud638\ud658 \uac00\ub2a5\ud55c \uc6f9 \ube0c\ub77c\uc6b0\uc800\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ubaa8\ubc14\uc77c \uae30\uae30\uc5d0\uc11c\ub294 \ucd5c\uc18c 1GB RAM \ubc0f Android 5.0 \ub610\ub294 iOS 10.0\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ucd94\uac00 \uc18c\ud504\ud2b8\uc6e8\uc5b4 \uc5c6\uc774 \ube0c\ub77c\uc6b0\uc800\uc5d0\uc11c \uc9c1\uc811 \uac8c\uc784\uc744 \ud50c\ub808\uc774\ud560 \uc218 \uc788\ub294 \ubc18\uba74, \ubaa8\ubc14\uc77c\uc5d0\uc11c\ub294 \ud574\ub2f9 \uc571 \uc2a4\ud1a0\uc5b4\uc5d0\uc11c \uc571\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud574\uc57c \ud569\ub2c8\ub2e4. [\uc124\uc815 \ube44\uad50\ud45c: PC - 2GB RAM, \ubaa8\ubc14\uc77c - 1GB RAM]"}, {"question": "\ud55c \uae30\uae30\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30\ub85c 2\ub2e8\uacc4\uc758 \ubd88\uac00\ub2a5\ud55c \ud034\uc988 \uac8c\uc784\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud55c \uae30\uae30\uc5d0\uc11c \ub2e4\ub978 \uae30\uae30\ub85c 2\ub2e8\uacc4\uc758 \ubd88\uac00\ub2a5\ud55c \ud034\uc988 \uac8c\uc784\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub824\uba74 \uac8c\uc784 \ub370\uc774\ud130\ub97c \ub3d9\uae30\ud654\ud574\uc57c \ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \ub450 \uae30\uae30 \ubaa8\ub450\uc5d0\uc11c \ub3d9\uc77c\ud55c \ud504\ub85c\ud544\ub85c \uacc4\uc815\uc744 \ud655\uc778\ud558\uac70\ub098 \ub85c\uadf8\uc778\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \uac8c\uc784 \ub0b4 \uc9c0\uce68\uc744 \ub530\ub974\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ubaa8\ubc14\uc77c \uae30\uae30\ub85c \uc774\ub3d9\ud558\ub294 \uacbd\uc6b0 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uba74 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc790\ub3d9\uc73c\ub85c \ub3d9\uae30\ud654\ub418\uc5b4\uc57c \ud569\ub2c8\ub2e4. [\ud750\ub984\ub3c4: \ub85c\uadf8\uc778 -> \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 -> \uc9c4\ud589 \uc0c1\ud669 \ub3d9\uae30\ud654]"}, {"question": "2\ub2e8\uacc4\uc758 \ubd88\uac00\ub2a5\ud55c \ud034\uc988 \uac8c\uc784\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uc640 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0a4\ub294\uac00?", "answer": "2\ub2e8\uacc4\uc758 \ubd88\uac00\ub2a5\ud55c \ud034\uc988 \uac8c\uc784\uc5d0\ub294 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \uc7ac\ubbf8\ub97c \ub354\ud558\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ub9ce\uc774 \ud3ec\ud568\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc8fc\ubaa9\ud560\ub9cc\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \"\ud574\uace8 \uc9c8\ubb38\"\uc785\ub2c8\ub2e4. \uc798\ubabb \ub2f5\ubcc0\ud558\uba74 \ub3c5\ud2b9\ud55c \uc560\ub2c8\uba54\uc774\uc158\uacfc \uc0ac\uc6b4\ub4dc \ud6a8\uacfc\uac00 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ub2e8\uc21c\ud788 \uc5d4\ud130\ud14c\uc778\uba3c\ud2b8\ub97c \uc81c\uacf5\ud558\ub294 \uac83\ubfd0\ub9cc \uc544\ub2c8\ub77c \ud50c\ub808\uc774\uc5b4\uac00 \ub2e4\uc591\ud55c \ub2f5\ubcc0\uc744 \ud0d0\uc0c9\ud558\uace0 \ucc3d\uc758\uc801\uc73c\ub85c \uc0dd\uac01\ud558\ub3c4\ub85d \uc7a5\ub824\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5b4\ub5a4 \uc9c8\ubb38\uc5d0\uc11c \ubcf4\uc774\uc9c0 \uc54a\ub294 \uc798\ubabb\ub41c \ub2f5\ubcc0\uc744 \ud074\ub9ad\ud558\uba74 \uc7ac\ubbf8\uc788\ub294 \uc560\ub2c8\uba54\uc774\uc158\uc774 \ubc1c\uc0dd\ud558\uace0 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ub4dc\ub7ec\ub0a0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ubbf8\ub85c\uc5d0\uc11c \ube44\ubc00 \ubc29\uc744 \ucc3e\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4.]"}]
[{"question": "\u5982\u4f55\u4f5c\u4e3a\u5b8c\u5168\u7684\u65b0\u624b\u5f00\u59cb\u73a9\u201c\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c 2\u201d\uff1f", "answer": "\u8981\u5f00\u59cb\u73a9\u201c\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c 2\u201d\uff0c\u9996\u5148\uff0c\u786e\u4fdd\u6e38\u620f\u5df2\u5b89\u88c5\u5728\u60a8\u7684\u8bbe\u5907\u4e0a\u3002\u542f\u52a8\u6e38\u620f\uff0c\u60a8\u5c06\u770b\u5230\u4e3b\u83dc\u5355\u3002\u9009\u62e9\u201c\u5f00\u59cb\u6e38\u620f\u201d\u5373\u53ef\u5f00\u59cb\u3002\u7b2c\u4e00\u4e2a\u95ee\u9898\u4f1a\u663e\u793a\u51fa\u6765\uff0c\u60a8\u53ef\u4ee5\u4f7f\u7528\u9f20\u6807\u6216\u89e6\u6478\u5c4f\u9009\u62e9\u60a8\u7684\u7b54\u6848\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u4e2a\u95ee\u9898\u4e2d\uff0c\u53ef\u80fd\u4f1a\u8981\u6c42\u60a8\u70b9\u51fb\u663e\u793a\u7684\u6700\u5927\u7684\u6570\u5b57\u3002\u8bf7\u8bb0\u4f4f\uff0c\u6e38\u620f\u7684\u8bbe\u8ba1\u65e8\u5728\u5177\u6709\u6311\u6218\u6027\uff0c\u56e0\u6b64\u8981\u8df3\u51fa\u601d\u7ef4\u5b9a\u52bf\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u628a\u5b83\u60f3\u8c61\u6210\u89e3\u8c1c\uff0c\u663e\u800c\u6613\u89c1\u7684\u7b54\u6848\u53ef\u80fd\u5e76\u975e\u6b63\u786e\u7b54\u6848\u3002]"}, {"question": "\u201c\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c 2\u201d\u7684\u57fa\u672c\u63a7\u5236\u952e\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5b83\u4eec\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u7684\u5dee\u5f02\uff1f", "answer": "\u201c\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c 2\u201d\u7684\u57fa\u672c\u63a7\u5236\u952e\u5f88\u7b80\u5355\uff1a\u4f7f\u7528\u9f20\u6807\u70b9\u51fb\u60a8\u8ba4\u4e3a\u6b63\u786e\u7684\u7b54\u6848\u3002\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\uff0c\u60a8\u53ef\u4ee5\u70b9\u51fb\u5c4f\u5e55\u3002\u8be5\u6e38\u620f\u517c\u5bb9 PC \u548c\u79fb\u52a8\u5e73\u53f0\uff0c\u4f46\u63a7\u5236\u65b9\u6848\u4fdd\u6301\u4e00\u81f4\u3002\u4f8b\u5982\uff0c\u5728 PC \u4e0a\uff0c\u60a8\u53ef\u80fd\u4f7f\u7528\u5de6\u952e\u5355\u51fb\u6765\u9009\u62e9\u7b54\u6848\uff0c\u800c\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\uff0c\u53ea\u9700\u70b9\u51fb\u4e00\u4e0b\u5373\u53ef\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1aPC - \u9f20\u6807\u70b9\u51fb\uff1b\u79fb\u52a8 - \u70b9\u51fb\u5c4f\u5e55]"}, {"question": "\u4e3a\u4ec0\u4e48\u201c\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c 2\u201d\u7684\u4e00\u4e9b\u95ee\u9898\u9700\u8981\u975e\u5e38\u89c4\u601d\u7ef4\uff1f", "answer": "\u201c\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c 2\u201d\u65e8\u5728\u901a\u8fc7\u975e\u5e38\u89c4\u601d\u7ef4\u6765\u6311\u6218\u73a9\u5bb6\uff0c\u56e0\u4e3a\u5b83\u65e8\u5728\u6253\u7834\u4f20\u7edf\u7684\u6d4b\u9a8c\u683c\u5f0f\u3002\u8bb8\u591a\u95ee\u9898\u90fd\u5305\u542b\u9690\u85cf\u7684\u7ebf\u7d22\u6216\u9700\u8981\u6a2a\u5411\u601d\u7ef4\u3002\u4f8b\u5982\uff0c\u4e00\u4e2a\u95ee\u9898\u53ef\u80fd\u4f1a\u8981\u6c42\u60a8\u201c\u70b9\u51fb\u4e0d\u662f\u989c\u8272\u7684\u5355\u8bcd\u201d\uff0c\u4f46\u6240\u6709\u5355\u8bcd\u9664\u4e86\u4e00\u4e2a\u8bcd\uff08\u540c\u97f3\u5f02\u4e49\u8bcd\uff09\u4e4b\u5916\u90fd\u662f\u989c\u8272\uff0c\u8fd9\u9f13\u52b1\u73a9\u5bb6\u8fdb\u884c\u521b\u9020\u6027\u601d\u8003\uff0c\u800c\u4e0d\u4f9d\u8d56\u4e8e\u6807\u51c6\u903b\u8f91\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u8fd9\u5c31\u50cf\u89e3\u4e00\u4e2a\u6e38\u620f\uff0c\u5176\u4e2d\u62fc\u56fe\u5e76\u4e0d\u4ee5\u901a\u5e38\u7684\u65b9\u5f0f\u5408\u62e2\u3002]"}, {"question": "\u5728\u73a9\u4e86 100 \u5c0f\u65f6\u540e\uff0c\u54ea\u4e9b\u7b56\u7565\u53ef\u4ee5\u5e2e\u52a9\u6211\u5728\u201c\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c 2\u201d\u4e2d\u66f4\u5feb\u5730\u53d6\u5f97\u8fdb\u5c55\uff1f", "answer": "\u5728\u73a9\u4e86 100 \u5c0f\u65f6\u540e\uff0c\u60a8\u53ef\u4ee5\u91c7\u7528\u591a\u79cd\u7b56\u7565\u6765\u66f4\u5feb\u5730\u53d6\u5f97\u201c\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c 2\u201d\u7684\u8fdb\u5c55\u3002\u6b65\u9aa4 1\uff1a\u719f\u6089\u95ee\u9898\u4e2d\u7684\u6a21\u5f0f\u548c\u53cd\u590d\u51fa\u73b0\u7684\u4e3b\u9898\u3002\u6b65\u9aa4 2\uff1a\u660e\u667a\u5730\u4f7f\u7528\u201c\u8df3\u8fc7\u201d\u529f\u80fd\u6765\u7ed5\u8fc7\u7279\u522b\u5177\u6709\u6311\u6218\u6027\u7684\u95ee\u9898\u3002\u6b65\u9aa4 3\uff1a\u8bb0\u4e0b\u96be\u9898\u53ca\u5176\u89e3\u51b3\u65b9\u6848\uff0c\u4ee5\u5907\u5c06\u6765\u53c2\u8003\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u78b0\u5230\u9700\u8981\u70b9\u51fb\u7279\u5b9a\u5bf9\u8c61\u5e8f\u5217\u7684\u95ee\u9898\uff0c\u8bf7\u8bb0\u4e0b\u8be5\u5e8f\u5217\u4ee5\u5907\u540e\u7528\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4\uff1a\u8df3\u8fc7\u4e0e\u7acb\u5373\u89e3\u51b3]"}, {"question": "\u5982\u4f55\u638c\u63e1\u201c\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c 2\u201d\u4e2d\u7684\u57fa\u4e8e\u65f6\u95f4\u7684\u95ee\u7b54\uff1f", "answer": "\u638c\u63e1\u201c\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c 2\u201d\u4e2d\u7684\u57fa\u4e8e\u65f6\u95f4\u7684\u95ee\u7b54\u9700\u8981\u7ec3\u4e60\u548c\u7cbe\u786e\u6027\u3002\u6b65\u9aa4 1\uff1a\u5bc6\u5207\u5173\u6ce8\u5012\u8ba1\u65f6\u5668\u6216\u95ee\u9898\u7684\u8282\u594f\u3002\u6b65\u9aa4 2\uff1a\u7ec3\u4e60\u5728\u786e\u5207\u9700\u8981\u7684\u65f6\u95f4\u70b9\u51fb\u6216\u8f7b\u89e6\u3002\u6b65\u9aa4 3\uff1a\u5982\u679c\u60a8\u4e0d\u786e\u5b9a\uff0c\u8bf7\u4f7f\u7528\u201c\u8df3\u8fc7\u201d\u529f\u80fd\u4ee5\u907f\u514d\u5931\u53bb\u751f\u547d\u3002\u4f8b\u5982\uff0c\u5728\u4e00\u4e2a\u60a8\u9700\u8981\u5728\u6b63\u786e\u7684\u65f6\u95f4\u70b9\u51fb\u79fb\u52a8\u76ee\u6807\u7684\u95ee\u9898\u4e2d\uff0c\u8bf7\u7ec3\u4e60\u8ba1\u65f6\uff0c\u76f4\u5230\u60a8\u505a\u5bf9\u4e3a\u6b62\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u5012\u8ba1\u65f6 -> \u70b9\u51fb/\u8f7b\u89e6 -> \u6b63\u786e\u7b54\u6848]"}, {"question": "\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u5728\u201c\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c 2\u201d\u4e2d\u6700\u5e38\u89c1\u7684\u9677\u9631\u662f\u4ec0\u4e48\uff1f", "answer": "\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u5728\u201c\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c 2\u201d\u4e2d\u7ecf\u5e38\u4f1a\u9677\u5165\u8fc7\u5ea6\u601d\u8003\u95ee\u9898\u7684\u9677\u9631\u3002\u4ed6\u4eec\u53ef\u80fd\u4f1a\u5047\u8bbe\u6bcf\u4e2a\u95ee\u9898\u90fd\u6709\u9690\u85cf\u7684\u6280\u5de7\uff0c\u4ece\u800c\u5bfc\u81f4\u9519\u8bef\u7684\u7b54\u6848\u3002\u53e6\u4e00\u4e2a\u5e38\u89c1\u7684\u9677\u9631\u662f\u5ffd\u7565\u201c\u8df3\u8fc7\u201d\u529f\u80fd\uff0c\u5b83\u53ef\u4ee5\u5728\u7279\u522b\u56f0\u96be\u7684\u95ee\u9898\u4e0a\u8282\u7701\u751f\u547d\u3002\u4f8b\u5982\uff0c\u4e00\u4e2a\u95ee\u9898\u770b\u8d77\u6765\u5f88\u7b80\u5355\uff0c\u4f46\u7b54\u6848\u9700\u8981\u4e00\u4e2a\u4e0d\u540c\u7684\u89c6\u89d2\uff0c\u4f8b\u5982\u70b9\u51fb\u4e00\u4e2a\u4e0d\u662f\u989c\u8272\u4f46\u542c\u8d77\u6765\u50cf\u989c\u8272\u7684\u5355\u8bcd\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u8fd9\u5c31\u50cf\u8bd5\u56fe\u901a\u8fc7\u53ea\u770b\u5899\u58c1\u6765\u89e3\u51b3\u8ff7\u5bab\u3002]"}, {"question": "\u201c\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c 2\u201d\u7684\u8bc4\u5206\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u5982\u4f55\u4f18\u5316\u5b83\uff1f", "answer": "\u201c\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c 2\u201d\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u6b63\u786e\u7b54\u6848\u7684\u6570\u91cf\u4ee5\u53ca\u56de\u7b54\u95ee\u9898\u7684\u901f\u5ea6\u3002\u6bcf\u4e2a\u6b63\u786e\u7b54\u6848\u90fd\u4f1a\u83b7\u5f97\u5206\u6570\uff0c\u5e76\u4e14\u5feb\u901f\u56de\u7b54\u53ef\u4ee5\u83b7\u5f97\u989d\u5916\u5206\u6570\u3002\u4e3a\u4e86\u4f18\u5316\u5206\u6570\uff0c\u9996\u5148\u8981\u6ce8\u91cd\u51c6\u786e\u6027\uff0c\u7136\u540e\u662f\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u7acb\u5373\u77e5\u9053\u95ee\u9898\u7684\u7b54\u6848\uff0c\u8bf7\u5feb\u901f\u56de\u7b54\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u5206\u6570\u3002\u4f46\u662f\uff0c\u5982\u679c\u60a8\u4e0d\u786e\u5b9a\uff0c\u8bf7\u82b1\u65f6\u95f4\u4ee5\u907f\u514d\u5931\u5206\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1a\u6b63\u786e\u7b54\u6848 + \u901f\u5ea6 = \u9ad8\u5206\u6570]"}, {"question": "\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e0a\u8fd0\u884c\u201c\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c 2\u201d\u7684\u6280\u672f\u8981\u6c42\u662f\u4ec0\u4e48\uff1f", "answer": "\u8fd0\u884c\u201c\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c 2\u201d\u7684\u6280\u672f\u8981\u6c42\u56e0\u5e73\u53f0\u800c\u5f02\u3002\u5728 PC \u4e0a\uff0c\u8be5\u6e38\u620f\u9700\u8981\u81f3\u5c11 2GB \u5185\u5b58\u548c\u517c\u5bb9\u7684\u7f51\u7edc\u6d4f\u89c8\u5668\u3002\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\uff0c\u5b83\u9700\u8981\u81f3\u5c11 1GB \u5185\u5b58\u548c Android 5.0 \u6216 iOS 10.0\u3002\u4f8b\u5982\uff0c\u5728 PC \u4e0a\uff0c\u60a8\u53ef\u4ee5\u5728\u6d4f\u89c8\u5668\u4e2d\u76f4\u63a5\u73a9\u6e38\u620f\uff0c\u800c\u65e0\u9700\u4efb\u4f55\u5176\u4ed6\u8f6f\u4ef6\uff0c\u800c\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\uff0c\u60a8\u9700\u8981\u4ece\u5404\u81ea\u7684\u5e94\u7528\u5546\u5e97\u4e0b\u8f7d\u5e94\u7528\u7a0b\u5e8f\u3002[\u914d\u7f6e\u5bf9\u7167\u8868\uff1aPC - 2GB \u5185\u5b58\uff0c\u79fb\u52a8 - 1GB \u5185\u5b58]"}, {"question": "\u5982\u4f55\u5c06\u6211\u5728\u201c\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c 2\u201d\u4e2d\u4ece\u4e00\u4e2a\u8bbe\u5907\u4f20\u8f93\u5230\u53e6\u4e00\u4e2a\u8bbe\u5907\uff1f", "answer": "\u5c06\u6211\u5728\u201c\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c 2\u201d\u4e2d\u4ece\u4e00\u4e2a\u8bbe\u5907\u4f20\u8f93\u5230\u53e6\u4e00\u4e2a\u8bbe\u5907\u53ef\u4ee5\u901a\u8fc7\u540c\u6b65\u6211\u7684\u6e38\u620f\u6570\u636e\u6765\u5b8c\u6210\u3002\u6b65\u9aa4\u4e00\uff1a\u786e\u4fdd\u60a8\u5728\u4e24\u4e2a\u8bbe\u5907\u4e0a\u90fd\u62e5\u6709\u5e10\u6237\u6216\u5df2\u767b\u5f55\u540c\u4e00\u914d\u7f6e\u6587\u4ef6\u3002\u6b65\u9aa4\u4e8c\uff1a\u5982\u679c\u53ef\u7528\uff0c\u8bf7\u4f7f\u7528\u4e91\u4fdd\u5b58\u529f\u80fd\u3002\u6b65\u9aa4\u4e09\uff1a\u6309\u7167\u6e38\u620f\u4e2d\u7684\u8bf4\u660e\u540c\u6b65\u60a8\u7684\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u4ece PC \u79fb\u52a8\u5230\u79fb\u52a8\u8bbe\u5907\uff0c\u8bf7\u767b\u5f55\u540c\u4e00\u5e10\u6237\uff0c\u60a8\u7684\u8fdb\u5ea6\u5e94\u8be5\u4f1a\u81ea\u52a8\u540c\u6b65\u3002[\u6d41\u7a0b\u56fe\u89e3\uff1a\u767b\u5f55 -> \u4e91\u4fdd\u5b58 -> \u540c\u6b65\u8fdb\u5ea6]"}, {"question": "\u5728\u201c\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c 2\u201d\u4e2d\uff0c\u6211\u53ef\u4ee5\u627e\u5230\u54ea\u4e9b\u9690\u85cf\u7684\u5f69\u86cb\uff0c\u4ee5\u53ca\u5b83\u4eec\u5982\u4f55\u589e\u5f3a\u6e38\u620f\u4f53\u9a8c\uff1f", "answer": "\u201c\u4e0d\u53ef\u80fd\u7684\u6d4b\u9a8c 2\u201d\u4e2d\u5145\u6ee1\u4e86\u9690\u85cf\u7684\u5f69\u86cb\uff0c\u8fd9\u4e9b\u5f69\u86cb\u4e3a\u6e38\u620f\u4f53\u9a8c\u589e\u6dfb\u4e86\u989d\u5916\u7684\u4e50\u8da3\u3002\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\u201c\u9ab7\u9ac5\u95ee\u9898\u201d\uff0c\u5982\u679c\u56de\u7b54\u9519\u8bef\uff0c\u4f1a\u89e6\u53d1\u72ec\u7279\u52a8\u753b\u548c\u97f3\u6548\u3002\u8fd9\u4e9b\u5f69\u86cb\u4e0d\u4ec5\u63d0\u4f9b\u5a31\u4e50\uff0c\u800c\u4e14\u4e5f\u9f13\u52b1\u73a9\u5bb6\u63a2\u7d22\u4e0d\u540c\u7684\u7b54\u6848\u5e76\u8fdb\u884c\u521b\u9020\u6027\u601d\u8003\u3002\u4f8b\u5982\uff0c\u5728\u4e00\u4e2a\u95ee\u9898\u4e2d\uff0c\u70b9\u51fb\u770b\u4f3c\u9519\u8bef\u7684\u7b54\u6848\u53ef\u80fd\u4f1a\u89e6\u53d1\u4e00\u4e2a\u6ed1\u7a3d\u7684\u52a8\u753b\uff0c\u63ed\u793a\u5f69\u86cb\u3002[\u6bd4\u55bb\u8bf4\u660e\uff1a\u8fd9\u5c31\u50cf\u5728\u8ff7\u5bab\u4e2d\u627e\u5230\u4e00\u4e2a\u79d8\u5bc6\u623f\u95f4\u3002]"}]
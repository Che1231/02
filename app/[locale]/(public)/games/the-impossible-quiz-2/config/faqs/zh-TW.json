[{"question": "\u5982\u4f55\u958b\u59cb\u73a9\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57 2\u300b\uff1f", "answer": "\u8981\u958b\u59cb\u73a9\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57 2\u300b\uff0c\u9996\u5148\u8acb\u78ba\u4fdd\u904a\u6232\u5df2\u5b89\u88dd\u5728\u60a8\u7684\u88dd\u7f6e\u4e0a\u3002\u555f\u52d5\u904a\u6232\uff0c\u60a8\u6703\u770b\u5230\u4e3b\u9078\u55ae\u3002\u9078\u64c7\u300c\u958b\u59cb\u904a\u6232\u300d\u4ee5\u958b\u59cb\u3002\u7b2c\u4e00\u500b\u554f\u984c\u6703\u51fa\u73fe\uff0c\u60a8\u53ef\u4ee5\u4f7f\u7528\u6ed1\u9f20\u6216\u89f8\u63a7\u87a2\u5e55\u9078\u64c7\u7b54\u6848\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u500b\u554f\u984c\u4e2d\uff0c\u60a8\u53ef\u80fd\u9700\u8981\u9ede\u64ca\u986f\u793a\u7684\u6700\u5927\u6578\u5b57\u3002\u8a18\u4f4f\uff0c\u904a\u6232\u8a2d\u8a08\u5f97\u5f88\u68d8\u624b\uff0c\u6240\u4ee5\u8acb\u8df3\u51fa\u6846\u67b6\u601d\u8003\u3002[\u6bd4\u55bb\u8aaa\u660e: \u60f3\u60f3\u5b83\u5c31\u50cf\u89e3\u8b0e\uff0c\u986f\u800c\u6613\u898b\u7684\u7b54\u6848\u53ef\u80fd\u4e0d\u662f\u6b63\u78ba\u7b54\u6848]"}, {"question": "\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57 2\u300b\u7684\u57fa\u672c\u63a7\u5236\u65b9\u5f0f\u662f\u4ec0\u9ebc\uff0c\u4e14\u4e0d\u540c\u5e73\u53f0\u4e4b\u9593\u6709\u4f55\u5dee\u7570\uff1f", "answer": "\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57 2\u300b\u7684\u57fa\u672c\u63a7\u5236\u65b9\u5f0f\u5f88\u7c21\u55ae\uff1a\u4f7f\u7528\u6ed1\u9f20\u9ede\u64ca\u60a8\u8a8d\u70ba\u6b63\u78ba\u7684\u7b54\u6848\u3002\u5728\u884c\u52d5\u88dd\u7f6e\u4e0a\uff0c\u60a8\u53ef\u4ee5\u8f15\u89f8\u87a2\u5e55\u4ee3\u66ff\u3002\u904a\u6232\u76f8\u5bb9\u65bc\u96fb\u8166\u548c\u884c\u52d5\u88dd\u7f6e\u5e73\u53f0\uff0c\u4f46\u63a7\u5236\u65b9\u5f0f\u4fdd\u6301\u4e00\u81f4\u3002\u4f8b\u5982\uff0c\u5728\u96fb\u8166\u4e0a\uff0c\u60a8\u53ef\u80fd\u4f7f\u7528\u5de6\u9375\u9ede\u64ca\u4f86\u9078\u64c7\u7b54\u6848\uff0c\u800c\u5728\u884c\u52d5\u88dd\u7f6e\u4e0a\uff0c\u8f15\u89f8\u5373\u53ef\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u96fb\u8166 - \u6ed1\u9f20\u9ede\u64ca; \u884c\u52d5\u88dd\u7f6e - \u8f15\u89f8\u87a2\u5e55]"}, {"question": "\u70ba\u4ec0\u9ebc\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57 2\u300b\u67d0\u4e9b\u554f\u984c\u9700\u8981\u975e\u5e38\u898f\u7684\u601d\u8003\uff1f", "answer": "\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57 2\u300b\u8a2d\u8a08\u65e8\u5728\u900f\u904e\u975e\u5e38\u898f\u7684\u601d\u8003\u4f86\u6311\u6230\u73a9\u5bb6\uff0c\u56e0\u70ba\u5b83\u65e8\u5728\u7a81\u7834\u50b3\u7d71\u7684\u6e2c\u9a57\u683c\u5f0f\u3002\u8a31\u591a\u554f\u984c\u90fd\u96b1\u85cf\u4e86\u63d0\u793a\uff0c\u6216\u8005\u9700\u8981\u5074\u5411\u601d\u8003\u3002\u4f8b\u5982\uff0c\u4e00\u500b\u554f\u984c\u53ef\u80fd\u6703\u8981\u6c42\u60a8\u300c\u9ede\u64ca\u4e0d\u662f\u984f\u8272\u7684\u5b57\u8a5e\u300d\uff0c\u4f46\u6240\u6709\u5b57\u8a5e\u90fd\u662f\u984f\u8272\uff0c\u9664\u4e86\u5176\u4e2d\u4e00\u500b\u662f\u540c\u97f3\u7570\u7fa9\u8a5e\u3002\u9019\u9f13\u52f5\u73a9\u5bb6\u5275\u9020\u6027\u601d\u8003\uff0c\u800c\u4e0d\u662f\u4f9d\u8cf4\u6a19\u6e96\u908f\u8f2f\u3002[\u6bd4\u55bb\u8aaa\u660e: \u9019\u5c31\u50cf\u89e3\u8b0e\uff0c\u800c\u9019\u4e9b\u7247\u6bb5\u4e26\u975e\u4ee5\u901a\u5e38\u7684\u65b9\u5f0f\u7b26\u5408]"}, {"question": "\u5728\u73a9\u4e86 100 \u5c0f\u6642\u5f8c\uff0c\u54ea\u4e9b\u7b56\u7565\u53ef\u4ee5\u5e6b\u52a9\u6211\u5728\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57 2\u300b\u4e2d\u9032\u5c55\u5f97\u66f4\u5feb\uff1f", "answer": "\u5728\u73a9\u4e86 100 \u5c0f\u6642\u5f8c\uff0c\u60a8\u53ef\u4ee5\u63a1\u7528\u5e7e\u7a2e\u7b56\u7565\u4f86\u5728\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57 2\u300b\u4e2d\u9032\u5c55\u5f97\u66f4\u5feb\u3002\u6b65\u9a5f 1\uff1a\u719f\u6089\u554f\u984c\u4e2d\u7684\u6a21\u5f0f\u548c\u91cd\u8907\u4e3b\u984c\u3002\u6b65\u9a5f 2\uff1a\u660e\u667a\u5730\u4f7f\u7528\u300c\u8df3\u904e\u300d\u529f\u80fd\uff0c\u4ee5\u7565\u904e\u7279\u5225\u5177\u6709\u6311\u6230\u6027\u7684\u554f\u984c\u3002\u6b65\u9a5f 3\uff1a\u8a18\u4e0b\u68d8\u624b\u554f\u984c\u53ca\u5176\u89e3\u6c7a\u65b9\u6848\uff0c\u4ee5\u5099\u65e5\u5f8c\u53c3\u8003\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u9047\u5230\u9700\u8981\u9ede\u64ca\u7279\u5b9a\u7269\u4ef6\u5e8f\u5217\u7684\u554f\u984c\uff0c\u8acb\u8a18\u4e0b\u8a72\u5e8f\u5217\u4ee5\u5099\u5f8c\u7528\u3002 [\u591a\u65b9\u6848\u6bd4\u8f03: \u8df3\u904e\u8207\u7acb\u5373\u89e3\u6c7a]"}, {"question": "\u5982\u4f55\u638c\u63e1\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57 2\u300b\u4e2d\u7684\u57fa\u65bc\u6642\u9593\u7684\u554f\u984c\uff1f", "answer": "\u5728\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57 2\u300b\u4e2d\u638c\u63e1\u57fa\u65bc\u6642\u9593\u7684\u554f\u984c\u9700\u8981\u7df4\u7fd2\u548c\u7cbe\u78ba\u5ea6\u3002\u6b65\u9a5f 1\uff1a\u5bc6\u5207\u6ce8\u610f\u8a08\u6642\u5668\u6216\u554f\u984c\u7684\u7bc0\u594f\u3002\u6b65\u9a5f 2\uff1a\u7df4\u7fd2\u5728\u9700\u8981\u6642\u9ede\u64ca\u6216\u8f15\u89f8\u3002\u6b65\u9a5f 3\uff1a\u5982\u679c\u60a8\u4e0d\u78ba\u5b9a\uff0c\u8acb\u4f7f\u7528\u300c\u8df3\u904e\u300d\u529f\u80fd\u4ee5\u907f\u514d\u640d\u5931\u751f\u547d\u3002\u4f8b\u5982\uff0c\u5728\u60a8\u9700\u8981\u5728\u6b63\u78ba\u6642\u523b\u9ede\u64ca\u79fb\u52d5\u76ee\u6a19\u7684\u554f\u984c\u4e2d\uff0c\u7df4\u7fd2\u8a08\u6642\uff0c\u76f4\u5230\u60a8\u7b54\u5c0d\u3002[\u6d41\u7a0b\u5716\u89e3: \u8a08\u6642\u5668 -> \u9ede\u64ca/\u8f15\u89f8 -> \u6b63\u78ba\u7b54\u6848]"}, {"question": "\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57 2\u300b\u4e2d\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u6700\u5e38\u898b\u7684\u9677\u9631\u662f\u4ec0\u9ebc\uff1f", "answer": "\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57 2\u300b\u4e2d\u7684\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u7d93\u5e38\u6703\u9677\u5165\u904e\u5ea6\u601d\u8003\u554f\u984c\u7684\u9677\u9631\u3002\u4ed6\u5011\u53ef\u80fd\u6703\u5047\u8a2d\u6bcf\u500b\u554f\u984c\u90fd\u6709\u4e00\u500b\u96b1\u85cf\u7684\u6280\u5de7\uff0c\u5c0e\u81f4\u932f\u8aa4\u7684\u7b54\u6848\u3002\u53e6\u4e00\u500b\u5e38\u898b\u7684\u9677\u9631\u662f\u5ffd\u7565\u300c\u8df3\u904e\u300d\u529f\u80fd\uff0c\u9019\u53ef\u4ee5\u5728\u7279\u5225\u56f0\u96e3\u7684\u554f\u984c\u4e0a\u4fdd\u5b58\u751f\u547d\u3002\u4f8b\u5982\uff0c\u4e00\u500b\u554f\u984c\u53ef\u80fd\u770b\u8d77\u4f86\u5f88\u7c21\u55ae\uff0c\u4f46\u7b54\u6848\u9700\u8981\u4e0d\u540c\u7684\u89c0\u9ede\uff0c\u4f8b\u5982\u9ede\u64ca\u4e0d\u662f\u984f\u8272\u4f46\u807d\u8d77\u4f86\u50cf\u984f\u8272\u7684\u5b57\u8a5e\u3002[\u6bd4\u55bb\u8aaa\u660e: \u9019\u5c31\u50cf\u8a66\u5716\u901a\u904e\u50c5\u67e5\u770b\u7246\u58c1\u4f86\u89e3\u8ff7\u5bae\u3002]"}, {"question": "\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57 2\u300b\u7684\u5f97\u5206\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff0c\u4ee5\u53ca\u5982\u4f55\u512a\u5316\u5b83\uff1f", "answer": "\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57 2\u300b\u7684\u5f97\u5206\u7cfb\u7d71\u57fa\u65bc\u6b63\u78ba\u7b54\u6848\u7684\u6578\u91cf\u548c\u60a8\u56de\u7b54\u554f\u984c\u7684\u901f\u5ea6\u3002\u6bcf\u500b\u6b63\u78ba\u7b54\u6848\u90fd\u6703\u6388\u4e88\u7a4d\u5206\uff0c\u4e26\u4e14\u5feb\u901f\u56de\u7b54\u53ef\u4ee5\u7372\u5f97\u984d\u5916\u7a4d\u5206\u3002\u8981\u512a\u5316\u60a8\u7684\u5f97\u5206\uff0c\u8acb\u5148\u5c08\u6ce8\u65bc\u6e96\u78ba\u6027\uff0c\u7136\u5f8c\u518d\u5c08\u6ce8\u65bc\u901f\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u7acb\u5373\u77e5\u9053\u554f\u984c\u7684\u7b54\u6848\uff0c\u8acb\u5feb\u901f\u56de\u7b54\uff0c\u4ee5\u6700\u5927\u5316\u60a8\u7684\u5f97\u5206\u3002\u4f46\u662f\uff0c\u5982\u679c\u60a8\u4e0d\u78ba\u5b9a\uff0c\u8acb\u82b1\u6642\u9593\u4ee5\u907f\u514d\u640d\u5931\u5206\u6578\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u6b63\u78ba\u7b54\u6848 + \u901f\u5ea6 = \u9ad8\u5206]"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u904b\u884c\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57 2\u300b\u7684\u6280\u8853\u8981\u6c42\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u904b\u884c\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57 2\u300b\u7684\u6280\u8853\u9700\u6c42\u5404\u4e0d\u76f8\u540c\u3002\u5728\u96fb\u8166\u4e0a\uff0c\u904a\u6232\u9700\u8981\u81f3\u5c11 2GB \u8a18\u61b6\u9ad4\u548c\u517c\u5bb9\u7684\u7db2\u9801\u700f\u89bd\u5668\u3002\u5728\u884c\u52d5\u88dd\u7f6e\u4e0a\uff0c\u5b83\u9700\u8981\u81f3\u5c11 1GB \u8a18\u61b6\u9ad4\u548c Android 5.0 \u6216 iOS 10.0\u3002\u4f8b\u5982\uff0c\u5728\u96fb\u8166\u4e0a\uff0c\u60a8\u53ef\u4ee5\u5728\u700f\u89bd\u5668\u4e2d\u76f4\u63a5\u64ad\u653e\u904a\u6232\uff0c\u800c\u7121\u9700\u4efb\u4f55\u984d\u5916\u8edf\u9ad4\uff0c\u800c\u5728\u884c\u52d5\u88dd\u7f6e\u4e0a\uff0c\u60a8\u9700\u8981\u5f9e\u5404\u81ea\u7684\u61c9\u7528\u7a0b\u5f0f\u5546\u5e97\u4e0b\u8f09\u61c9\u7528\u7a0b\u5f0f\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u96fb\u8166 - 2GB \u8a18\u61b6\u9ad4\uff0c\u884c\u52d5\u88dd\u7f6e - 1GB \u8a18\u61b6\u9ad4]"}, {"question": "\u5982\u4f55\u5c07\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57 2\u300b\u7684\u9032\u5ea6\u5f9e\u4e00\u500b\u88dd\u7f6e\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u88dd\u7f6e\uff1f", "answer": "\u5c07\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57 2\u300b\u7684\u9032\u5ea6\u5f9e\u4e00\u500b\u88dd\u7f6e\u8f49\u79fb\u5230\u53e6\u4e00\u500b\u88dd\u7f6e\uff0c\u53ef\u4ee5\u901a\u904e\u540c\u6b65\u60a8\u7684\u904a\u6232\u8cc7\u6599\u4f86\u5b8c\u6210\u3002\u6b65\u9a5f 1\uff1a\u78ba\u4fdd\u60a8\u5728\u5169\u500b\u88dd\u7f6e\u4e0a\u90fd\u6709\u4e00\u500b\u5e33\u6236\u6216\u767b\u5165\u76f8\u540c\u500b\u8cc7\u3002\u6b65\u9a5f 2\uff1a\u5982\u679c\u53ef\u7528\uff0c\u8acb\u4f7f\u7528\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u3002\u6b65\u9a5f 3\uff1a\u9075\u5faa\u904a\u6232\u5167\u7684\u6307\u793a\u4f86\u540c\u6b65\u60a8\u7684\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9e\u96fb\u8166\u79fb\u52d5\u5230\u884c\u52d5\u88dd\u7f6e\uff0c\u8acb\u767b\u5165\u76f8\u540c\u7684\u5e33\u6236\uff0c\u60a8\u7684\u9032\u5ea6\u61c9\u8a72\u6703\u81ea\u52d5\u540c\u6b65\u3002[\u6d41\u7a0b\u5716\u89e3: \u767b\u5165 -> \u96f2\u7aef\u5132\u5b58 -> \u540c\u6b65\u9032\u5ea6]"}, {"question": "\u6211\u5728\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57 2\u300b\u4e2d\u53ef\u4ee5\u627e\u5230\u54ea\u4e9b\u96b1\u85cf\u7684\u5f69\u86cb\uff0c\u5b83\u5011\u5982\u4f55\u63d0\u5347\u904a\u6232\u9ad4\u9a57\uff1f", "answer": "\u300a\u4e0d\u53ef\u80fd\u7684\u6e2c\u9a57 2\u300b\u5145\u6eff\u4e86\u96b1\u85cf\u7684\u5f69\u86cb\uff0c\u9019\u4e9b\u5f69\u86cb\u8b93\u904a\u6232\u9ad4\u9a57\u66f4\u6709\u8da3\u3002\u4e00\u500b\u986f\u8457\u7684\u5f69\u86cb\u662f\u300c\u9ab7\u9acf\u554f\u984c\u300d\uff0c\u5176\u4e2d\u56de\u7b54\u932f\u8aa4\u6703\u5c0e\u81f4\u7368\u7279\u7684\u52d5\u756b\u548c\u97f3\u6548\u3002\u9019\u4e9b\u5f69\u86cb\u4e0d\u50c5\u63d0\u4f9b\u5a1b\u6a02\uff0c\u9084\u9f13\u52f5\u73a9\u5bb6\u63a2\u7d22\u4e0d\u540c\u7684\u7b54\u6848\u4e26\u9032\u884c\u5275\u9020\u6027\u601d\u8003\u3002\u4f8b\u5982\uff0c\u5728\u4e00\u500b\u554f\u984c\u4e2d\uff0c\u9ede\u64ca\u770b\u4f3c\u932f\u8aa4\u7684\u7b54\u6848\u53ef\u80fd\u6703\u89f8\u767c\u4e00\u500b\u5e7d\u9ed8\u7684\u52d5\u756b\uff0c\u63ed\u793a\u5f69\u86cb\u3002[\u6bd4\u55bb\u8aaa\u660e: \u9019\u5c31\u50cf\u5728\u8ff7\u5bae\u4e2d\u627e\u5230\u79d8\u5bc6\u623f\u9593\u3002]"}]
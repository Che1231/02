[{"question": "\ucd08\ubcf4\uc790\ub85c\uc11c \ubc14\ub514\ucea0 \uc288\ud130\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \ub9c8\uc2a4\ud130\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubc14\ub514\ucea0 \uc288\ud130\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \ub9c8\uc2a4\ud130\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1 - PC\uc5d0\uc11c\ub294 WASD \ud0a4\ub97c \uc0ac\uc6a9\ud558\ub294 \uc774\ub3d9 \ucee8\ud2b8\ub864\uacfc \uce74\uba54\ub77c \ubcf4\uae30 \uc804\ud658(C \ud0a4)\uc744 \uc775\uc219\ud574\uc9c0\uc138\uc694. STEP2 - \ud29c\ud1a0\ub9ac\uc5bc \ub808\ubca8\uc5d0\uc11c \uc815\uc9c0\ub41c \ud45c\uc801\uc744 \uc870\uc900\ud558\uace0 \uc0ac\uaca9 \uc5f0\uc2b5\uc744 \ud558\uc138\uc694. STEP3 - \ucf54\ub108\ub97c \uc0b4\uc9dd \ubcf4\ub294 \ubab8 \uae30\uc6b8\uc774\uae30 \uba54\ucee4\ub2c8\uc998(Q \ubc0f E \ud0a4)\uc744 \ud65c\uc6a9\ud574\ubcf4\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ubbf8\uc158\uc5d0\uc11c \ucc28 \ub4a4\uc5d0 \uc740\uc2e0\ucc98\ub97c \ub9c8\ub828\ud558\uace0 \uc801\uc758 \uacf5\uaca9\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uae30\uc6b8\uae30 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. [\ube44\uc720 \uc124\uba85: \uae30\uc6b8\uc774\uae30 \uba54\ucee4\ub2c8\uc998\uc744 \ubb38\ud2c8\uc73c\ub85c \ubc16\uc744 \uc0b4\ud3b4\ubcf4\ub294 \uac83\uacfc \uac19\uc740 \ubc29\uc2dd\uc73c\ub85c \uc0dd\uac01\ud574\ubcf4\uc138\uc694.]"}, {"question": "\ubc14\ub514\ucea0 \uc288\ud130\uc758 \uce74\uba54\ub77c \uc2dc\uc810\uc774 \uac8c\uc784\ubab0\uc785\ub3c4\uc5d0 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubc14\ub514\ucea0 \uc288\ud130\uc758 \uce74\uba54\ub77c \uc2dc\uc810\uc740 \uc2e4\uc81c \ubc14\ub514\ucea0\uc744 \ubaa8\ubc29\ud558\uc5ec 1\uc778\uce6d \uc2dc\uc810\uc744 \uc81c\uacf5\ud568\uc73c\ub85c\uc368 \ud604\uc2e4\uac10\uc744 \ub192\uc5ec \uac8c\uc784\ubab0\uc785\ub3c4\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. \uc774 \uc2dc\uc810\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc9c1\uc811 \uc0c1\ud669\uc5d0 \ubab0\uc785\ud558\uac8c \ud558\uc5ec \uae34\uc7a5\uac10\uacfc \ubab0\uc785\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 \uc778\uc9c8 \uad6c\ucd9c \ubbf8\uc158\uc5d0\uc11c \ub2ec\ub9ac\ub294 \ub3d9\uc548 \uce74\uba54\ub77c\uac00 \ud754\ub4e4\ub9ac\ub294 \ud6a8\uacfc\ub294 \uc0c1\ud669\uc758 \uae34\uae09\uc131\uacfc \uc2a4\ud2b8\ub808\uc2a4\ub97c \ub354\ud569\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \uc804\ud1b5\uc801\uc778 1\uc778\uce6d \uc2dc\uc810\uacfc \ubc14\ub514\ucea0 \uc2dc\uc810\uc758 \ucc28\uc774\uc810\uc744 \ube44\uad50\ud558\uc5ec \ucd94\uac00\ub41c \ud604\uc2e4\uac10\uc744 \uac15\uc870\ud558\uc138\uc694.]"}, {"question": "\ubc14\ub514\ucea0 \uc288\ud130\uc640 \uc804\ud1b5\uc801\uc778 FPS \uac8c\uc784\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubc14\ub514\ucea0 \uc288\ud130\uc640 \uc804\ud1b5\uc801\uc778 FPS \uac8c\uc784\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ud604\uc2e4\uac10\uacfc \ubab0\uc785\ub3c4\ub97c \ub354\ud558\ub294 \ub3c5\ud2b9\ud55c \ubc14\ub514\ucea0 \uc2dc\uc810\uacfc, \ub7f0\uc564\uac74 \ubc29\uc2dd\uc774 \uc544\ub2cc \uc804\uc220\uc801\uc778 \uac8c\uc784 \ud50c\ub808\uc774\uc5d0 \ucd08\uc810\uc744 \ub9de\ucd94\ub294 \uc810\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 \ubc14\ub514\ucea0 \uc288\ud130\uc5d0\uc11c\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uc801\uc758 \ubc1c\uacac\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uc790\uc138\uc640 \uc774\ub3d9\uc744 \uc2e0\uc911\ud558\uac8c \uc870\uc808\ud574\uc57c \ud558\uc9c0\ub9cc, \uc804\ud1b5\uc801\uc778 FPS \uac8c\uc784\uc5d0\uc11c\ub294 \uc18d\ub3c4\uc640 \ubc18\uc751 \uc18d\ub3c4\ub97c \uc6b0\uc120\uc2dc\ud569\ub2c8\ub2e4. [\ub2e4\uc911 \uc194\ub8e8\uc158 \ube44\uad50: \ubc14\ub514\ucea0 \uc288\ud130\uc758 \uc804\uc220\uc801\uc778 \uc811\uadfc \ubc29\uc2dd\uc744 \ucf5c \uc624\ube0c \ub4c0\ud2f0\uc640 \uac19\uc740 \ube60\ub974\uac8c \uc9c4\ud589\ub418\ub294 \uc561\uc158 \uac8c\uc784\uacfc \ube44\uad50\ud558\uc138\uc694.]"}, {"question": "\uace0\ub09c\uc774\ub3c4 \ubbf8\uc158\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \ud074\ub9ac\uc5b4\ud558\uae30 \uc704\ud574 \ubc14\ub514\ucea0 \uc288\ud130\uc5d0\uc11c \uc0ac\uc6a9\ud574\uc57c \ud560 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubc14\ub514\ucea0 \uc288\ud130\uc5d0\uc11c \uace0\ub09c\uc774\ub3c4 \ubbf8\uc158\uc744 \ud6a8\uc728\uc801\uc73c\ub85c \ud074\ub9ac\uc5b4\ud558\uae30 \uc704\ud55c \uc804\ub7b5\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4: STEP1 - \uce74\uba54\ub77c \ubcf4\uae30\ub97c \uc0ac\uc6a9\ud558\uc5ec \uba3c\uc800 \uc9c0\uc5ed\uc744 \uc815\ucc30\ud558\uc5ec \uc801\uc758 \uc704\uce58\ub97c \ud655\uc778\ud558\uc138\uc694. STEP2 - \uac00\ub2a5\ud55c \ud55c \uc9c1\uc811\uc801\uc778 \ub300\uacb0\uc744 \ud53c\ud558\uace0 \uc740\uc2e0\ucc98\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc138\uc694. STEP3 - \ubb34\uae30\uc5d0 \uc18c\uc74c\uae30 \uc7a5\ucc29\ud558\uc5ec \uc801\uc744 \uc740\ubc00\ud558\uac8c \uc81c\uac70\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \"\ucc3d\uace0 \uc2b5\uaca9\" \ubbf8\uc158\uc5d0\uc11c \uce74\uba54\ub77c\ub97c \uc0ac\uc6a9\ud558\uc5ec \uacbd\ube44\ubcd1\uc758 \uc704\uce58\ub97c \ud30c\uc545\ud558\uace0 \uba40\ub9ac\uc11c \ud558\ub098\uc529 \uc81c\uac70\ud558\uc138\uc694. [\ud504\ub85c\uc138\uc2a4 \ub2e4\uc774\uc5b4\uadf8\ub7a8: \ubbf8\uc158\uc744 \ud074\ub9ac\uc5b4\ud558\uae30 \uc704\ud55c \ub2e8\uacc4\ubcc4 \uc811\uadfc \ubc29\uc2dd\uc744 \ubcf4\uc5ec\uc8fc\ub294 \ud50c\ub85c\uc6b0\ucc28\ud2b8\ub97c \ub9cc\ub4dc\uc138\uc694.]"}, {"question": "\ubc14\ub514\ucea0 \uc288\ud130\uc758 \uc2a4\ud154\uc2a4 \uc2dc\uc2a4\ud15c\uc774 \ub2e4\ub978 \uc2a4\ud154\uc2a4 \uac8c\uc784\uacfc \uc5b4\ub5bb\uac8c \ub2e4\ub978\uac00\uc694?", "answer": "\ubc14\ub514\ucea0 \uc288\ud130\uc758 \uc2a4\ud154\uc2a4 \uc2dc\uc2a4\ud15c\uc740 \uc2dc\uc57c\uc640 \ubc1c\uacac\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub294 \ubc14\ub514\ucea0 \uc2dc\uc810\uc744 \ud1b5\ud569\ud558\uc5ec \ub2e4\ub978 \uc2a4\ud154\uc2a4 \uac8c\uc784\uacfc \ub2e4\ub985\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4\ub294 \uc790\uc2e0\uc774 \ubcf4\uc774\uc9c0 \uc54a\ub3c4\ub85d \uce74\uba54\ub77c \uac01\ub3c4\ub97c \uc870\uc808\ud574\uc57c \ud558\uba70, \uc774\ub294 \ub3c5\ud2b9\ud55c \uc804\ub7b5\uc801 \uc694\uc18c\ub97c \ub354\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc57c\uac04 \uce68\ud22c\" \ubbf8\uc158\uc5d0\uc11c \ubab8\uc744 \uad6c\ubd80\ub9ac\uace0 \uce74\uba54\ub77c\ub97c \ub0ae\uac8c \uc720\uc9c0\ud558\uba74 \uc21c\ucc30\ub300\ub85c\ubd80\ud130 \ubc1c\uacac\uc744 \ud53c\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uce74\uba54\ub77c \uac01\ub3c4\ub97c \uc81c\ub300\ub85c \uad00\ub9ac\ud558\uc9c0 \uc54a\uc73c\uba74 \uc704\uce58\ub97c \ub4dc\ub7ec\ub0bc \uc218 \uc788\ub294 \uc190\uc804\ub4f1\uc73c\ub85c \uc0dd\uac01\ud574 \ubcf4\uc138\uc694.]"}, {"question": "\ubc14\ub514\ucea0 \uc288\ud130\uc5d0\uc11c \ub2e4\uc591\ud55c \ubbf8\uc158 \uc720\ud615\uc5d0 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ub85c\ub4dc\uc544\uc6c3\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubc14\ub514\ucea0 \uc288\ud130\uc5d0\uc11c \ub2e4\uc591\ud55c \ubbf8\uc158 \uc720\ud615\uc5d0 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ub85c\ub4dc\uc544\uc6c3\uc740 \ubbf8\uc158\uc758 \uc694\uad6c \uc0ac\ud56d\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4. \uc2a4\ud154\uc2a4 \ubbf8\uc158\uc5d0\uc11c\ub294 \uc18c\uc74c\uae30\uac00 \ubd80\ucc29\ub41c \uad8c\ucd1d\uacfc \uc5f0\uae30\ud0c4\uc744 \uc7a5\ube44\ud558\uc138\uc694. \uc804\ud22c \uc911\uc2ec\uc758 \ubbf8\uc158\uc5d0\uc11c\ub294 \ub3cc\uaca9 \uc18c\ucd1d\uacfc \ud50c\ub798\uc2dc\ubc45\uc744 \uc120\ud0dd\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \"\uc778\uc9c8 \uad6c\ucd9c\" \ubbf8\uc158\uc5d0\uc11c \uc18c\uc74c\uae30\uac00 \ubd80\ucc29\ub41c \uad8c\ucd1d\uc740 \ub2e4\ub978 \uc0ac\ub78c\uc5d0\uac8c \uacbd\uace0\ud558\uc9c0 \uc54a\uace0 \uacbd\ube44\ubcd1\uc744 \uc81c\uac70\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \uc2a4\ud154\uc2a4, \uc804\ud22c \ubc0f \ud63c\ud569 \ubbf8\uc158\uc5d0 \ub300\ud55c \ub85c\ub4dc\uc544\uc6c3\uc744 \ube44\uad50\ud558\uc138\uc694.]"}, {"question": "\ubc14\ub514\ucea0 \uc288\ud130\uc758 AI \ud589\ub3d9\uc774 \uac8c\uc784 \uc804\ub7b5\uc5d0 \uc5b4\ub5a4 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\uae4c?", "answer": "\ubc14\ub514\ucea0 \uc288\ud130\uc758 AI \ud589\ub3d9\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc5ed\ub3d9\uc801\uc778 \uc801\uc758 \uc6c0\uc9c1\uc784\uacfc \ubc18\uc751\uc5d0 \uc801\uc751\ud574\uc57c \ud55c\ub2e4\ub294 \uc810\uc5d0\uc11c \uac8c\uc784 \uc804\ub7b5\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4. \uc801\ub4e4\uc740 \uce21\uba74 \uacf5\uaca9, \uc740\uc2e0, \uc9c0\uc6d0 \uc694\uccad\uc744 \ud558\uae30 \ub54c\ubb38\uc5d0 \ud56d\uc0c1 \uacbd\uacc4\ud558\uace0 \ubbf8\ub9ac \uacc4\ud68d\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc740\ud589 \uac15\ub3c4\" \ubbf8\uc158\uc5d0\uc11c\ub294 \ud55c \uacf3\uc5d0 \ub108\ubb34 \uc624\ub798 \uba38\ubb3c\uba74 \uc801\ub4e4\uc774 \ub2f9\uc2e0\uc744 \ud3ec\uc704\ud558\ub824\uace0 \ud560 \uac83\uc785\ub2c8\ub2e4. [\ub2e4\uc911 \uc194\ub8e8\uc158 \ube44\uad50: \ubc14\ub514\ucea0 \uc288\ud130\uc758 AI \ud589\ub3d9\uc744 \ub2e4\ub978 \uc804\uc220 \uc288\ud305 \uac8c\uc784\uc5d0\uc11c\uc758 AI \ud589\ub3d9\uacfc \ube44\uad50\ud558\uc138\uc694.]"}, {"question": "\ubc14\ub514\ucea0 \uc288\ud130\uc758 \uccb4\ub825\uacfc \ud53c\ud574 \uc2dc\uc2a4\ud15c\uc758 \uc8fc\uc694 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ubc14\ub514\ucea0 \uc288\ud130\uc758 \uccb4\ub825\uacfc \ud53c\ud574 \uc2dc\uc2a4\ud15c\uc758 \uc8fc\uc694 \uba54\ucee4\ub2c8\uc998\uc5d0\ub294 \uc2e4\uc81c \uccb4\ub825\uc774 \uacf5\uaca9\uc744 \ubc1b\uc73c\uba74 \ube68\ub9ac \uace0\uac08\ub418\uba70 \uc804\ud22c\uac00 \ub05d\ub09c \ud6c4\uc5d0\ub9cc \uc7ac\uc0dd\ub418\ub294 \uc7ac\uc0dd \uc2dc\uc2a4\ud15c\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc9e7\uc740 \uc2dc\uac04 \ub3d9\uc548 \uc5ec\ub7ec \ubc88 \ub9de\uc73c\uba74 \uccb4\ub825\uc774 \ud06c\uac8c \ub5a8\uc5b4\uc9c0\ubbc0\ub85c \uc740\uc2e0\ucc98\ub97c \ucc3e\uc544 \uc7ac\uc0dd \uc2dc\uac04\uc744 \uae30\ub2e4\ub9ac\ub294 \uac83\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uccb4\ub825 \uc2dc\uc2a4\ud15c\uc744 \uc0ac\uc6a9 \ud6c4 \uc7ac\ucda9\uc804\uc774 \ud544\uc694\ud55c \uc790\ub3d9\ucc28\uc758 \uc5f0\ub8cc \ud0f1\ud06c\ub85c \uc0dd\uac01\ud574\ubcf4\uc138\uc694.]"}, {"question": "PC\uc5d0\uc11c \ucf58\uc194\ub85c \ubc14\ub514\ucea0 \uc288\ud130 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc774\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "PC\uc5d0\uc11c \ucf58\uc194\ub85c \ubc14\ub514\ucea0 \uc288\ud130 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694: STEP1 - Steam Cloud \ub610\ub294 Xbox Live\uc640 \uac19\uc740 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uacc4\uc815\uc5d0 \uac8c\uc784\uc744 \uc5f0\uacb0\ud558\uc138\uc694. STEP2 - \ucf58\uc194\uc5d0\uc11c \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uc138\uc694. STEP3 - \ud074\ub77c\uc6b0\ub4dc\uc5d0\uc11c \uc800\uc7a5\ub41c \ub370\uc774\ud130\ub97c \ub2e4\uc6b4\ub85c\ub4dc\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \uc5ec\ub7ec \ubbf8\uc158\uc744 \uc644\ub8cc\ud588\ub2e4\uba74 Xbox Live \uacc4\uc815\uc5d0 Xbox\uc5d0\uc11c \ub85c\uadf8\uc778\ud558\uba74 \uc9c4\ud589 \uc0c1\ud669\uc774 \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \ub2e4\uc591\ud55c \ud50c\ub7ab\ud3fc\uc5d0\uc11c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uae30\ub2a5\uc744 \ube44\uad50\ud558\uc138\uc694.]"}, {"question": "\ubc14\ub514\ucea0 \uc288\ud130\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uc640 \uc774\ub7ec\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uacbd\ud5d8\uc744 \uc5b4\ub5bb\uac8c \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\uae4c?", "answer": "\ubc14\ub514\ucea0 \uc288\ud130\uc758 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \ud074\ub798\uc2dd \uc561\uc158 \uc601\ud654\uc640 \uac1c\ubc1c\uc790\uc758 \ub0b4\ubd80 \uc720\uba38\uc5d0 \ub300\ud55c \ucc38\uc870\ub97c \ud3ec\ud568\ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uc7ac\ubbf8\uc640 \ubc1c\uacac\uc758 \uacc4\uce35\uc744 \ucd94\uac00\ud558\uc5ec \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ub3c4\uc2dc \uc815\uae00\" \ubbf8\uc158\uc5d0\uc11c \uac8c\uc2dc\ud310\uc5d0\ub294 \uc720\uba85 \uc601\ud654 \ud3ec\uc2a4\ud130\uc758 \ud328\ub7ec\ub514\uac00 \ud45c\uc2dc\ub418\uc5b4 \uad00\ucc30\ub825 \uc788\ub294 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uc6c3\uc74c\uc744 \uc120\uc0ac\ud569\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc774\uc2a4\ud130 \uc5d0\uadf8\ub294 \uac8c\uc784 \uc138\uacc4\uc5d0 \uae4a\uc774\ub97c \ub354\ud558\ub294 \uc228\uaca8\uc9c4 \ubcf4\ubb3c\ub85c \uc0dd\uac01\ud574\ubcf4\uc138\uc694.]"}]
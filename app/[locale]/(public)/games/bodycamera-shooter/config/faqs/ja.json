[{"question": "\u521d\u5fc3\u8005\u3068\u3057\u3066\u3001BodyCamera Shooter\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u8fc5\u901f\u306b\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "BodyCamera Shooter\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u3092\u8fc5\u901f\u306b\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002STEP1 - \u79fb\u52d5\u64cd\u4f5c\uff08PC\u3067\u306fWASD\uff09\u3068\u30ab\u30e1\u30e9\u8996\u70b9\u5207\u308a\u66ff\u3048\uff08C\u30ad\u30fc\uff09\u306b\u6163\u308c\u308b\u3002STEP2 - \u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u30ec\u30d9\u30eb\u3067\u3001\u9759\u6b62\u3057\u305f\u6a19\u7684\u306b\u7167\u6e96\u3092\u5408\u308f\u305b\u3066\u6483\u3064\u7df4\u7fd2\u3092\u3059\u308b\u3002STEP3 - \u30ea\u30fc\u30f3\u6a5f\u69cb\uff08Q\u30ad\u30fc\u3068E\u30ad\u30fc\uff09\u3092\u4f7f\u3063\u3066\u3001\u30b3\u30fc\u30ca\u30fc\u3092\u8997\u304f\u7df4\u7fd2\u3092\u3059\u308b\u3002\u4f8b\u3048\u3070\u3001\u6700\u521d\u306e\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u8eca\u306e\u5f8c\u308d\u306b\u96a0\u308c\u3066\u6575\u306e\u653b\u6483\u3092\u304b\u308f\u3059\u305f\u3081\u306b\u3001\u30ea\u30fc\u30f3\u6a5f\u80fd\u3092\u6d3b\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u30ea\u30fc\u30f3\u6a5f\u69cb\u306f\u3001\u30c9\u30a2\u306e\u9699\u9593\u304b\u3089\u5916\u306e\u69d8\u5b50\u3092\u8997\u304d\u8fbc\u3080\u3053\u3068\u306b\u4f8b\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002]"}, {"question": "BodyCamera Shooter\u306e\u30ab\u30e1\u30e9\u8996\u70b9\u304c\u30b2\u30fc\u30e0\u4f53\u9a13\u306b\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "BodyCamera Shooter\u306e\u30ab\u30e1\u30e9\u8996\u70b9\u304c\u30b2\u30fc\u30e0\u4f53\u9a13\u306b\u91cd\u8981\u306a\u306e\u306f\u3001\u73fe\u5b9f\u4e16\u754c\u306e\u30dc\u30c7\u30a3\u30ab\u30e1\u30e9\u3092\u6a21\u5023\u3057\u3001\u4e00\u4eba\u79f0\u8996\u70b9\u3067\u30ea\u30a2\u30ea\u30c6\u30a3\u3092\u9ad8\u3081\u3066\u3044\u308b\u305f\u3081\u3067\u3059\u3002\u3053\u306e\u8996\u70b9\u306b\u3088\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u307e\u308b\u3067\u5b9f\u969b\u306b\u305d\u3053\u306b\u3044\u308b\u304b\u306e\u3088\u3046\u306b\u72b6\u6cc1\u306b\u6ca1\u982d\u3057\u3001\u7dca\u5f35\u611f\u3068\u95a2\u5fc3\u3092\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u4eba\u8cea\u6551\u51fa\u30df\u30c3\u30b7\u30e7\u30f3\u4e2d\u3001\u8d70\u3063\u3066\u3044\u308b\u6642\u306e\u30ab\u30e1\u30e9\u306e\u63fa\u308c\u306f\u3001\u7dca\u8feb\u611f\u3068\u30b9\u30c8\u30ec\u30b9\u3092\u5897\u5e45\u3055\u305b\u307e\u3059\u3002[\u914d\u7f6e\u5bfe\u7167\u8868\uff1a\u30dc\u30c7\u30a3\u30ab\u30e1\u30e9\u8996\u70b9\u3068\u5f93\u6765\u306e\u4e00\u4eba\u79f0\u8996\u70b9\u3068\u306e\u6bd4\u8f03\u3067\u3001\u30ea\u30a2\u30ea\u30c6\u30a3\u306e\u8ffd\u52a0\u70b9\u3092\u5f37\u8abf\u3057\u307e\u3059\u3002]"}, {"question": "BodyCamera Shooter\u3068\u5f93\u6765\u306eFPS\u30b2\u30fc\u30e0\u3068\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "BodyCamera Shooter\u3068\u5f93\u6765\u306eFPS\u30b2\u30fc\u30e0\u3068\u306e\u4e3b\u306a\u9055\u3044\u306f\u3001\u72ec\u81ea\u306e\u30dc\u30c7\u30a3\u30ab\u30e1\u30e9\u8996\u70b9\u306b\u3088\u308b\u30ea\u30a2\u30ea\u30c6\u30a3\u3068\u6ca1\u5165\u611f\u306e\u5411\u4e0a\u3001\u305d\u3057\u3066\u3001\u5f93\u6765\u306e\u30e9\u30f3\uff06\u30ac\u30f3\u91cd\u8996\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3067\u306f\u306a\u304f\u3001\u6226\u8853\u7684\u306a\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u7126\u70b9\u3092\u5f53\u3066\u3066\u3044\u308b\u3053\u3068\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001BodyCamera Shooter\u3067\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u5f93\u6765\u306eFPS\u30b2\u30fc\u30e0\u306e\u3088\u3046\u306b\u7d20\u65e9\u3055\u3068\u53cd\u5c04\u795e\u7d4c\u3092\u91cd\u8996\u3059\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u691c\u77e5\u3092\u907f\u3051\u3001\u8eab\u306e\u3053\u306a\u3057\u3092\u614e\u91cd\u306b\u7ba1\u7406\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1aBodyCamera Shooter\u306e\u6226\u8853\u7684\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u3068\u3001Call of Duty\u306e\u3088\u3046\u306a\u9ad8\u901f\u306a\u30a2\u30af\u30b7\u30e7\u30f3\u3068\u306e\u6bd4\u8f03\u3092\u793a\u3057\u307e\u3059\u3002]"}, {"question": "\u9ad8\u96e3\u5ea6\u30df\u30c3\u30b7\u30e7\u30f3\u3092\u52b9\u7387\u7684\u306b\u30af\u30ea\u30a2\u3059\u308b\u305f\u3081\u306b\u3001BodyCamera Shooter\u3067\u4f7f\u7528\u3059\u308b\u3079\u304d\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "BodyCamera Shooter\u3067\u9ad8\u96e3\u5ea6\u30df\u30c3\u30b7\u30e7\u30f3\u3092\u52b9\u7387\u7684\u306b\u30af\u30ea\u30a2\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u6226\u7565\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002STEP1 - \u307e\u305a\u3001\u30ab\u30e1\u30e9\u8996\u70b9\u3092\u4f7f\u3063\u3066\u30a8\u30ea\u30a2\u3092\u5075\u5bdf\u3057\u3001\u6575\u306e\u4f4d\u7f6e\u3092\u7279\u5b9a\u3057\u307e\u3059\u3002STEP2 - \u5fc5\u8981\u306b\u5fdc\u3058\u3066\u30ab\u30d0\u30fc\u3092\u6d3b\u7528\u3057\u3001\u53ef\u80fd\u306a\u9650\u308a\u76f4\u63a5\u5bfe\u6c7a\u3092\u907f\u3051\u307e\u3057\u3087\u3046\u3002STEP3 - \u6b66\u5668\u306b\u30b5\u30d7\u30ec\u30c3\u30b5\u30fc\u3092\u53d6\u308a\u4ed8\u3051\u308b\u3053\u3068\u3067\u3001\u6575\u3092\u9759\u304b\u306b\u6392\u9664\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u5009\u5eab\u8972\u6483\u300d\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u30ab\u30e1\u30e9\u3092\u4f7f\u3063\u3066\u8b66\u5099\u54e1\u3092\u898b\u3064\u3051\u51fa\u3057\u3001\u9060\u8ddd\u96e2\u304b\u30891\u4eba\u305a\u3064\u6392\u9664\u3057\u307e\u3057\u3087\u3046\u3002[\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\uff1a\u30df\u30c3\u30b7\u30e7\u30f3\u3092\u30af\u30ea\u30a2\u3059\u308b\u6bb5\u968e\u7684\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u3092\u793a\u3059\u30d5\u30ed\u30fc\u30c1\u30e3\u30fc\u30c8\u3092\u4f5c\u6210\u3057\u307e\u3059\u3002]"}, {"question": "BodyCamera Shooter\u306e\u30b9\u30c6\u30eb\u30b9\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u4ed6\u306e\u30b9\u30c6\u30eb\u30b9\u30b2\u30fc\u30e0\u3068\u3069\u306e\u3088\u3046\u306b\u7570\u306a\u308a\u307e\u3059\u304b\uff1f", "answer": "BodyCamera Shooter\u306e\u30b9\u30c6\u30eb\u30b9\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u30dc\u30c7\u30a3\u30ab\u30e1\u30e9\u8996\u70b9\u3092\u53d6\u308a\u5165\u308c\u3066\u3044\u308b\u70b9\u3067\u4ed6\u306e\u30b9\u30c6\u30eb\u30b9\u30b2\u30fc\u30e0\u3068\u306f\u7570\u306a\u308a\u307e\u3059\u3002\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30ab\u30e1\u30e9\u306e\u89d2\u5ea6\u3092\u7ba1\u7406\u3057\u3001\u898b\u3048\u306a\u3044\u3088\u3046\u306b\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u30e6\u30cb\u30fc\u30af\u306a\u6226\u7565\u306e\u5c64\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30ca\u30a4\u30c8\u30a4\u30f3\u30d5\u30a3\u30eb\u30c8\u30ec\u30fc\u30b7\u30e7\u30f3\u300d\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u3057\u3083\u304c\u307f\u8fbc\u307f\u306a\u304c\u3089\u30ab\u30e1\u30e9\u3092\u4f4e\u304f\u4fdd\u3064\u3053\u3068\u3067\u3001\u5de1\u56de\u30d1\u30c8\u30ed\u30fc\u30eb\u304b\u3089\u306e\u767a\u898b\u3092\u56de\u907f\u3067\u304d\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u30ab\u30e1\u30e9\u306e\u89d2\u5ea6\u306f\u3001\u9069\u5207\u306b\u7ba1\u7406\u3057\u306a\u3044\u3068\u3001\u81ea\u5206\u306e\u4f4d\u7f6e\u3092\u9732\u898b\u3055\u305b\u308b\u61d0\u4e2d\u96fb\u706f\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002]"}, {"question": "BodyCamera Shooter\u306e\u3055\u307e\u3056\u307e\u306a\u30df\u30c3\u30b7\u30e7\u30f3\u30bf\u30a4\u30d7\u306b\u6700\u9069\u306a\u88c5\u5099\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "BodyCamera Shooter\u306e\u3055\u307e\u3056\u307e\u306a\u30df\u30c3\u30b7\u30e7\u30f3\u30bf\u30a4\u30d7\u306b\u6700\u9069\u306a\u88c5\u5099\u306f\u3001\u30df\u30c3\u30b7\u30e7\u30f3\u306e\u8981\u4ef6\u306b\u3088\u3063\u3066\u7570\u306a\u308a\u307e\u3059\u3002\u30b9\u30c6\u30eb\u30b9\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u30b5\u30a4\u30ec\u30f3\u30b5\u30fc\u4ed8\u304d\u62f3\u9283\u3068\u7159\u5e55\u30b0\u30ec\u30cd\u30fc\u30c9\u3092\u88c5\u5099\u3057\u307e\u3059\u3002\u6226\u95d8\u91cd\u8996\u306e\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u30a2\u30b5\u30eb\u30c8\u30e9\u30a4\u30d5\u30eb\u3068\u30d5\u30e9\u30c3\u30b7\u30e5\u30d0\u30f3\u3092\u88c5\u5099\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u4eba\u8cea\u6551\u51fa\u300d\u30df\u30c3\u30b7\u30e7\u30f3\u3067\u306f\u3001\u30b5\u30a4\u30ec\u30f3\u30b5\u30fc\u4ed8\u304d\u62f3\u9283\u3092\u4f7f\u3046\u3053\u3068\u3067\u3001\u4ed6\u306e\u8b66\u5099\u54e1\u306b\u6c17\u3065\u304b\u308c\u308b\u3053\u3068\u306a\u304f\u6575\u3092\u6392\u9664\u3067\u304d\u307e\u3059\u3002[\u914d\u7f6e\u5bfe\u7167\u8868\uff1a\u30b9\u30c6\u30eb\u30b9\u3001\u6226\u95d8\u3001\u6df7\u5408\u30df\u30c3\u30b7\u30e7\u30f3\u306e\u88c5\u5099\u3092\u6bd4\u8f03\u3057\u307e\u3059\u3002]"}, {"question": "BodyCamera Shooter\u306eAI\u884c\u52d5\u306f\u3001\u30b2\u30fc\u30e0\u6226\u7565\u306b\u3069\u306e\u3088\u3046\u306b\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "BodyCamera Shooter\u306eAI\u884c\u52d5\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u52d5\u7684\u306a\u6575\u306e\u52d5\u304d\u3084\u53cd\u5fdc\u306b\u9069\u5fdc\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u3001\u30b2\u30fc\u30e0\u6226\u7565\u306b\u5f71\u97ff\u3092\u4e0e\u3048\u307e\u3059\u3002\u6575\u306f\u5074\u9762\u653b\u6483\u3092\u3057\u305f\u308a\u3001\u30ab\u30d0\u30fc\u3092\u53d6\u3063\u305f\u308a\u3001\u63f4\u8ecd\u3092\u8981\u8acb\u3057\u305f\u308a\u3057\u307e\u3059\u3002\u305d\u306e\u305f\u3081\u3001\u5e38\u306b\u8b66\u6212\u3057\u3001\u4e8b\u524d\u306b\u8a08\u753b\u3092\u7acb\u3066
[{"question": "\u5982\u4f55\u5feb\u901f\u4e0a\u624b Voxiom.io \u7684\u57fa\u672c\u63a7\u5236\uff0c\u4f5c\u70ba\u65b0\u73a9\u5bb6\uff1f", "answer": "\u8981\u5feb\u901f\u4e0a\u624b Voxiom.io\uff0c\u8acb\u5c08\u6ce8\u65bc\u638c\u63e1\u57fa\u672c\u63a7\u5236\u3002\u6b65\u9a5f1\uff1a\u4f7f\u7528 \"WASD\" \u9375\u9032\u884c\u79fb\u52d5\uff0c\u4e26\u4f7f\u7528\u6ed1\u9f20\u89c0\u770b\u5468\u570d\u74b0\u5883\u3002\u6b65\u9a5f2\uff1a\u5de6\u9375\u9ede\u64ca\u5c04\u64ca\uff0c\u53f3\u9375\u9ede\u64ca\u7784\u6e96\u3002\u6b65\u9a5f3\uff1a\u6309\u4e0b \"E\" \u9375\u8207\u7bb1\u5b50\u6216\u9580\u7b49\u7269\u4ef6\u4e92\u52d5\u3002\u4f8b\u5982\uff0c\u5728 \"\u751f\u5b58\" \u6a21\u5f0f\u4e2d\uff0c\u60a8\u9700\u8981\u6253\u958b\u7bb1\u5b50\u4f86\u6536\u96c6\u8cc7\u6e90\u3002\u4e00\u500b\u6709\u5e6b\u52a9\u7684\u6280\u5de7\u662f\u5728\u4f4e\u58d3\u74b0\u5883\uff08\u4f8b\u5982 \"\u7df4\u7fd2\" \u6a21\u5f0f\uff09\u4e2d\u7df4\u7fd2\u9019\u4e9b\u63a7\u5236\uff0c\u4ee5\u5efa\u7acb\u808c\u8089\u8a18\u61b6\u3002"}, {"question": "\u5728 Voxiom.io \u904a\u6232 100 \u5c0f\u6642\u5f8c\uff0c\u8cc7\u6e90\u6536\u96c6\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728 Voxiom.io \u904a\u6232 100 \u5c0f\u6642\u5f8c\uff0c\u9ad8\u6548\u7684\u8cc7\u6e90\u6536\u96c6\u8b8a\u5f97\u81f3\u95dc\u91cd\u8981\u3002\u6b65\u9a5f1\uff1a\u8b58\u5225\u9ad8\u7522\u51fa\u8cc7\u6e90\u5340\u57df\uff0c\u4f8b\u5982\u6d1e\u7a74\u6216\u8302\u5bc6\u68ee\u6797\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u93df\u5b50\u6316\u6398\u7926\u77f3\uff0c\u4f7f\u7528\u65a7\u982d\u780d\u4f10\u6a39\u6728\u3002\u6b65\u9a5f3\uff1a\u512a\u5148\u6536\u96c6\u7a00\u6709\u8cc7\u6e90\uff0c\u4f8b\u5982\u947d\u77f3\u6216\u9ec3\u91d1\uff0c\u7528\u65bc\u88fd\u4f5c\u9ad8\u7d1a\u88dd\u5099\u3002\u4f8b\u5982\uff0c\u5728 \"\u5927\u9003\u6bba\" \u6a21\u5f0f\u4e2d\uff0c\u53ca\u65e9\u53d6\u5f97\u7a00\u6709\u8cc7\u6e90\u53ef\u4ee5\u70ba\u60a8\u5e36\u4f86\u986f\u8457\u512a\u52e2\u3002\u8003\u616e\u4f7f\u7528\u8cc7\u6e90\u5730\u5716\u4f86\u898f\u5283\u8def\u7dda\uff0c\u4e26\u6700\u5927\u5316\u6548\u7387\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u4e86\u89e3 Voxiom.io \u7684\u5de5\u85dd\u7cfb\u7d71\u81f3\u95dc\u91cd\u8981\uff0c\u4ee5\u53ca\u5b83\u7684\u5de5\u4f5c\u539f\u7406\uff1f", "answer": "\u4e86\u89e3 Voxiom.io \u7684\u5de5\u85dd\u7cfb\u7d71\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u5141\u8a31\u60a8\u88fd\u4f5c\u5f37\u5927\u7684\u6b66\u5668\u3001\u5de5\u5177\u548c\u5efa\u7bc9\u7269\u3002\u6b65\u9a5f1\uff1a\u6536\u96c6\u57fa\u672c\u8cc7\u6e90\uff0c\u4f8b\u5982\u6728\u6750\u548c\u77f3\u982d\u3002\u6b65\u9a5f2\uff1a\u6309\u4e0b \"C\" \u9375\u4f86\u6253\u958b\u5de5\u85dd\u83dc\u55ae\uff0c\u7136\u5f8c\u9078\u64c7\u8981\u88fd\u4f5c\u7684\u7269\u54c1\u3002\u6b65\u9a5f3\uff1a\u78ba\u4fdd\u60a8\u64c1\u6709\u6240\u9700\u7684\u6750\u6599\uff0c\u7136\u5f8c\u9ede\u64ca \"\u88fd\u4f5c\"\u3002\u4f8b\u5982\uff0c\u88fd\u4f5c \"\u77f3\u528d\" \u9700\u8981 5 \u500b\u6728\u6750\u548c 3 \u500b\u77f3\u982d\u3002\u5de5\u85dd\u7cfb\u7d71\u5206\u5c64\uff0c\u56e0\u6b64\u50cf \"\u947d\u77f3\u76d4\u7532\" \u9019\u6a23\u7684\u9ad8\u7d1a\u7269\u54c1\u9700\u8981\u7a00\u6709\u6750\u6599\u3002\u4f7f\u7528\u5de5\u85dd\u6307\u5357\u4f86\u7b56\u7565\u6027\u5730\u898f\u5283\u60a8\u7684\u5347\u7d1a\u3002"}, {"question": "\u5728 Voxiom.io \u4e2d\uff0c\u54ea\u4e9b\u6b66\u5668\u6700\u6709\u6548\uff0c\u5b83\u5011\u5728\u50b7\u5bb3\u548c\u5c04\u7a0b\u65b9\u9762\u5982\u4f55\u6bd4\u8f03\uff1f", "answer": "\u5728 Voxiom.io \u4e2d\uff0c\u6b66\u5668\u7684\u6709\u6548\u6027\u53d6\u6c7a\u65bc\u50b7\u5bb3\u548c\u5c04\u7a0b\u3002\"\u7a81\u64ca\u6b65\u69cd\" \u63d0\u4f9b\u5e73\u8861\u7684\u6578\u64da\uff0c\u4f7f\u5176\u6210\u70ba\u4e2d\u7b49\u5c04\u7a0b\u6230\u9b25\u7684\u591a\u529f\u80fd\u6b66\u5668\u3002\"\u72d9\u64ca\u6b65\u69cd\" \u5728\u9060\u7a0b\u50b7\u5bb3\u65b9\u9762\u975e\u5e38\u51fa\u8272\uff0c\u4f46\u5c04\u901f\u8f03\u6162\u3002\u5c0d\u65bc\u8fd1\u8ddd\u96e2\u6230\u9b25\uff0c\"\u9730\u5f48\u69cd\" \u63d0\u4f9b\u9ad8\u50b7\u5bb3\uff0c\u4f46\u5c04\u7a0b\u6709\u9650\u3002\u4f8b\u5982\uff0c\u5728 \"\u5718\u968a\u6b7b\u4ea1\u7af6\u8cfd\" \u4e2d\uff0c\"\u7a81\u64ca\u6b65\u69cd\" \u975e\u5e38\u9069\u5408\u4f54\u9818\u95dc\u9375\u4f4d\u7f6e\uff0c\u800c \"\u72d9\u64ca\u6b65\u69cd\" \u5247\u975e\u5e38\u9069\u5408\u9060\u7a0b\u6d88\u6ec5\u6575\u4eba\u3002\u4f7f\u7528\u6b66\u5668\u6bd4\u8f03\u5716\u8868\u4f86\u9078\u64c7\u6700\u9069\u5408\u60a8\u904a\u6232\u98a8\u683c\u7684\u88dd\u5099\u3002"}, {"question": "Voxiom.io \u7684\u751f\u547d\u503c\u548c\u9632\u79a6\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u4ee5\u53ca\u6700\u4f73\u7684\u7ba1\u7406\u65b9\u5f0f\u662f\u4ec0\u9ebc\uff1f", "answer": "Voxiom.io \u7684\u751f\u547d\u503c\u548c\u9632\u79a6\u7cfb\u7d71\u5c0d\u65bc\u751f\u5b58\u81f3\u95dc\u91cd\u8981\u3002\u751f\u547d\u503c\u4ee5\u5fc3\u5f62\u5716\u6a19\u8868\u793a\uff0c\u53ef\u4ee5\u4f7f\u7528\u6025\u6551\u5305\u6216\u98df\u7269\u6062\u5fa9\u3002\u9632\u79a6\u529b\uff0c\u4ee5\u76fe\u724c\u5716\u6a19\u986f\u793a\uff0c\u53ef\u964d\u4f4e\u50b7\u5bb3\uff0c\u53ef\u4ee5\u901a\u904e\u88fd\u4f5c\u6216\u5728\u7bb1\u5b50\u4e2d\u627e\u5230\u3002\u4f8b\u5982\uff0c\u5728 \"\u751f\u5b58\u6a21\u5f0f\" \u4e2d\uff0c\u7a7f\u6234 \"\u947d\u77f3\u76d4\u7532\" \u53ef\u4ee5\u986f\u8457\u589e\u52a0\u60a8\u7684\u8010\u4e45\u529b\u3002\u6b65\u9a5f1\uff1a\u59cb\u7d42\u651c\u5e36\u6025\u6551\u5305\u4ee5\u5099\u4e0d\u6642\u4e4b\u9700\u3002\u6b65\u9a5f2\uff1a\u512a\u5148\u88fd\u4f5c\u6216\u5c0b\u627e\u9ad8\u7d1a\u88dd\u7532\u3002\u6b65\u9a5f3\uff1a\u907f\u514d\u4e0d\u5fc5\u8981\u7684\u6230\u9b25\uff0c\u4ee5\u7bc0\u7d04\u751f\u547d\u503c\u548c\u9632\u79a6\u529b\u3002\u4f7f\u7528\u751f\u547d\u503c\u548c\u9632\u79a6\u529b\u6d41\u7a0b\u5716\u4f86\u898f\u5283\u60a8\u7684\u751f\u5b58\u7b56\u7565\u3002"}, {"question": "Voxiom.io \u7684 \"\u751f\u5b58\" \u6a21\u5f0f\u548c \"\u5927\u9003\u6bba\" \u6a21\u5f0f\u4e4b\u9593\u7684\u4e3b\u8981\u5340\u5225\u662f\u4ec0\u9ebc\uff1f", "answer": "Voxiom.io \u7684 \"\u751f\u5b58\" \u6a21\u5f0f\u548c \"\u5927\u9003\u6bba\" \u6a21\u5f0f\u63d0\u4f9b\u4e0d\u540c\u7684\u904a\u6232\u9ad4\u9a57\u3002\u5728 \"\u751f\u5b58\" \u6a21\u5f0f\u4e2d\uff0c\u91cd\u9ede\u662f\u5728\u4e00\u6bb5\u6642\u9593\u5167\u6536\u96c6\u8cc7\u6e90\u3001\u5efa\u9020\u5efa\u7bc9\u7269\u4e26\u64ca\u9000\u6575\u4eba\u3002\u5728 \"\u5927\u9003\u6bba\" \u6a21\u5f0f\u4e2d\uff0c\u73a9\u5bb6\u4e00\u958b\u59cb\u53ea\u6709\u5f88\u5c11\u7684\u88dd\u5099\uff0c\u4e26\u4e14\u5fc5\u9808\u5728\u904a\u6232\u5340\u57df\u7e2e\u5c0f\u6642\u641c\u5c0b\u6b66\u5668\u548c\u88dc\u7d66\u3002\u4f8b\u5982\uff0c\u5728 \"\u751f\u5b58\" \u6a21\u5f0f\u4e2d\uff0c\u60a8\u53ef\u80fd\u6703\u5efa\u9020\u4e00\u5ea7\u5821\u58d8\u4f86\u62b5\u79a6\u6575\u4eba\u7684\u4e00\u6ce2\u6ce2\u8972\u64ca\uff0c\u800c\u5728 \"\u5927\u9003\u6bba\" \u6a21\u5f0f\u4e2d\uff0c\u60a8\u9700\u8981\u4fdd\u6301\u6a5f\u52d5\u6027\u4e26\u9069\u61c9\u7e2e\u5c0f\u7684\u5340\u57df\u3002\u4f7f\u7528\u6a21\u5f0f\u6bd4\u8f03\u8868\u4f86\u6c7a\u5b9a\u54ea\u7a2e\u6a21\u5f0f\u66f4\u9069\u5408\u60a8\u7684\u904a\u6232\u98a8\u683c\u3002"}, {"question": "\u5982\u4f55\u5c07\u6211\u7684 Voxiom.io \u9032\u5ea6\u5f9e\u4e00\u500b\u8a2d\u5099\u9077\u79fb\u5230\u53e6\u4e00\u500b\u8a2d\u5099\uff1f", "answer": "\u5728\u4e0d\u540c\u7684\u8a2d\u5099\u9593\u9077\u79fb\u60a8\u7684 Voxiom.io \u9032\u5ea6\u975e\u5e38\u7c21\u55ae\u3002\u6b65\u9a5f1\uff1a\u78ba\u4fdd\u60a8\u5728\u5169\u500b\u8a2d\u5099\u4e0a\u90fd\u767b\u9304\u540c\u4e00\u500b\u5e33\u6236\u3002\u6b65\u9a5f2\uff1a\u5982\u679c\u60a8\u4f7f\u7528\u8a3b\u518a\u5e33\u6236\uff0c\u60a8\u7684\u9032\u5ea6\u6703\u901a\u904e\u96f2\u7aef\u81ea\u52d5\u540c\u6b65\u3002\u6b65\u9a5f3\uff1a\u9a57\u8b49\u6240\u6709\u6578\u64da\uff08\u5305\u62ec\u5eab\u5b58\u548c\u7d71\u8a08\u6578\u64da\uff09\u5df2\u6b63\u78ba\u50b3\u8f38\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9e\u500b\u4eba\u96fb\u8166\u5207\u63db\u5230\u884c\u52d5\u88dd\u7f6e\uff0c\u60a8\u88fd\u4f5c\u7684\u7269\u54c1\u548c\u6210\u5c31\u61c9\u8a72\u80fd\u9806\u5229\u51fa\u73fe\u3002\u4f7f\u7528\u9077\u79fb\u6aa2\u67e5\u6e05\u55ae\u4f86\u78ba\u4fdd\u904e\u7a0b\u4e2d\u6c92\u6709\u4e1f\u5931\u4efb\u4f55\u6578\u64da\u3002"}, {"question": "Voxiom.io \u7684\u96b1\u85cf\u5f69\u86cb\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5982\u4f55\u627e\u5230\u5b83\u5011\uff1f", "answer": "Voxiom.io \u4e2d\u5145\u6eff\u4e86\u96b1\u85cf\u7684\u5f69\u86cb\uff0c\u70ba\u904a\u6232\u589e\u6dfb\u4e86\u6a02\u8da3\u3002\u4e00\u500b\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f \"\u9ec3\u91d1\u93df\u5b50\"\uff0c\u5b83\u53ef\u4ee5\u5728 \"\u751f\u5b58\" \u6a21\u5f0f\u7684\u4e00\u500b\u79d8\u5bc6\u6d1e\u7a74\u4e2d\u627e\u5230\u3002\u6b65\u9a5f1\uff1a\u4ed4\u7d30\u63a2\u7d22\u5730\u5716\uff0c\u5c24\u5176\u662f\u5728\u8f03\u5c11\u8a2a\u554f\u7684\u5340\u57df\u3002\u6b65\u9a5f2\uff1a\u5c0b\u627e\u7570\u5e38\u7684\u7d50\u69cb\u6216\u96b1\u85cf\u7684\u8def\u5f91\u3002\u6b65\u9a5f3\uff1a\u8207\u53ef\u7591\u7269\u4ef6\u4e92\u52d5\u4ee5\u63ed\u958b\u79d8\u5bc6\u3002\u4f8b\u5982\uff0c\u5728 \"\u6c99\u6f20\u751f\u7269\u7fa4\u7cfb\" \u4e2d\uff0c\u6253\u7834\u7279\u5b9a\u7684\u4ed9\u4eba\u638c\u53ef\u80fd\u6703\u63ed\u793a\u96b1\u85cf\u7684\u7bb1\u5b50\u3002\u4f7f\u7528\u5f69\u86cb\u5730\u5716\u4f86\u8ffd\u8e64\u9019\u4e9b\u96b1\u85cf\u7684\u5bf6\u85cf\u3002"}, {"question": "Voxiom.io \u7684\u914d\u5c0d\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u73a9\u5bb6\u914d\u5c0d\uff1f", "answer": "Voxiom.io \u7684\u914d\u5c0d\u7cfb\u7d71\u65e8\u5728\u900f\u904e\u8003\u616e\u591a\u500b\u56e0\u7d20\u4f86\u5275\u9020\u5e73\u8861\u7684\u6bd4\u8cfd\u3002\u6b65\u9a5f1\uff1a\u73a9\u5bb6\u6280\u80fd\u6c34\u5e73\uff08\u7531\u52dd/\u6557\u7387\u548c\u6bba/\u6b7b\u7387\u6c7a\u5b9a\uff09\u662f\u4e3b\u8981\u56e0\u7d20\u3002\u6b65\u9a5f2\uff1a\u9023\u7dda\u54c1\u8cea\u80fd\u78ba\u4fdd\u9806\u66a2\u7684\u904a\u6232\u9ad4\u9a57\u3002\u6b65\u9a5f3\uff1a\u5718\u968a\u7d44\u6210\u5e73\u8861\uff0c\u4ee5\u907f\u514d\u55ae\u65b9\u9762\u6bd4\u8cfd\u3002\u4f8b\u5982\uff0c\u5728 \"\u5718\u968a\u6b7b\u4ea1\u7af6\u8cfd\" \u4e2d\uff0c\u7cfb\u7d71\u78ba\u4fdd\u5169\u500b\u5718\u968a\u90fd\u5305\u542b\u7d93\u9a57\u8c50\u5bcc\u548c\u65b0\u73a9\u5bb6\u7684\u6df7\u5408\u3002\u4f7f\u7528\u914d\u5c0d\u6d41\u7a0b\u5716\u4f86\u4e86\u89e3\u9019\u4e9b\u56e0\u7d20\u5982\u4f55\u76f8\u4e92\u4f5c\u7528\u4ee5\u5275\u9020\u516c\u5e73\u7684\u904a\u6232\u3002"}, {"question": "\u5982\u4f55\u6700\u4f73\u5316 Voxiom.io \u5728\u4f4e\u968e\u8a2d\u5099\u4e0a\u7684\u6548\u80fd\uff1f", "answer": "\u6700\u4f73\u5316 Voxiom.io \u5728\u4f4e\u968e\u8a2d\u5099\u4e0a\u7684\u6548\u80fd\uff0c\u6d89\u53ca\u8abf\u6574\u8a2d\u5b9a\u4ee5\u5e73\u8861\u6548\u80fd\u548c\u8996\u89ba\u6548\u679c\u3002\u6b65\u9a5f1\uff1a\u5728 \"\u9078\u9805\" \u9078\u55ae\u4e2d\u964d\u4f4e\u5716\u5f62\u8a2d\u5b9a\uff0c\u4ee5\u6e1b\u5c11\u88dd\u7f6e\u8ca0\u64d4\u3002\u6b65\u9a5f2\uff1a\u505c\u7528\u4e0d\u5fc5\u8981\u7684\u8981\u7d20\uff0c\u4f8b\u5982\u9670\u5f71\u6216\u7c92\u5b50\u6548\u679c\u3002\u6b65\u9a5f3\uff1a\u95dc\u9589\u80cc\u666f\u61c9\u7528\u7a0b\u5f0f\uff0c\u4ee5\u91cb\u653e\u7cfb\u7d71\u8cc7\u6e90\u3002\u4f8b\u5982\uff0c\u5728\u4f4e\u968e\u500b\u4eba\u96fb\u8166\u4e0a\uff0c\u5c07\u89e3\u6790\u5ea6\u8a2d\u5b9a\u70ba 720p \u4e26\u95dc\u9589\u6297\u92f8\u9f52\uff0c\u53ef\u4ee5\u986f\u8457\u63d0\u9ad8\u756b\u9762\u66f4\u65b0\u7387\u3002\u4f7f\u7528\u6548\u80fd\u6700\u4f73\u5316\u6307\u5357\u4f86\u5fae\u8abf\u60a8\u7684\u8a2d\u5b9a\uff0c\u4ee5\u7372\u5f97\u6700\u4f73\u9ad4\u9a57\u3002"}]
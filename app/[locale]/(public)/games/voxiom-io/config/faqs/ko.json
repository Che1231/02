[{"question": "Voxiom.io\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub85c\uc11c \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Voxiom.io\uc5d0\uc11c \ube60\ub974\uac8c \uc2dc\uc791\ud558\ub824\uba74 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \uc219\ub2ec\ud558\ub294 \ub370 \uc9d1\uc911\ud558\uc138\uc694. STEP1: \uc774\ub3d9\uc5d0\ub294 'WASD'\ub97c, \uc2dc\uc57c \uc870\uc808\uc5d0\ub294 \ub9c8\uc6b0\uc2a4\ub97c \uc0ac\uc6a9\ud558\uc138\uc694. STEP2: \uc67c\ucabd \ud074\ub9ad\uc73c\ub85c \uc0ac\uaca9\ud558\uace0, \uc624\ub978\ucabd \ud074\ub9ad\uc73c\ub85c \uc870\uc900\ud558\uc138\uc694. STEP3: \uc0c1\uc790\ub098 \ubb38\uacfc \uac19\uc740 \ubb3c\uccb4\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\ub824\uba74 'E' \ud0a4\ub97c \ub204\ub974\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uc0dd\uc874' \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uc790\uc6d0\uc744 \ubaa8\uc73c\uae30 \uc704\ud574 \uc0c1\uc790\ub97c \uc5f4\uc5b4\uc57c \ud569\ub2c8\ub2e4. \ud301\uc73c\ub85c, '\ud6c8\ub828' \ubaa8\ub4dc \uac19\uc740 \uc555\ubc15\uac10\uc774 \uc801\uc740 \ud658\uacbd\uc5d0\uc11c \uc774\ub7ec\ud55c \ucee8\ud2b8\ub864 \uc5f0\uc2b5\uc744 \ud1b5\ud574 \uadfc\uc721 \uae30\uc5b5\ub825\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uc138\uc694."}, {"question": "Voxiom.io\uc5d0\uc11c 100\uc2dc\uac04 \ud50c\ub808\uc774 \ud6c4 \uc790\uc6d0 \uc218\uc9d1\uc5d0 \uac00\uc7a5 \uc88b\uc740 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Voxiom.io\uc5d0\uc11c 100\uc2dc\uac04 \ud50c\ub808\uc774 \ud6c4 \ud6a8\uc728\uc801\uc778 \uc790\uc6d0 \uc218\uc9d1\uc740 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. STEP1: \ub3d9\uad74\uc774\ub098 \uc6b8\ucc3d\ud55c \uc232\uacfc \uac19\uc740 \uace0\uc218\ud655 \uc790\uc6d0 \uc9c0\ub300\ub97c \ud30c\uc545\ud558\uc138\uc694. STEP2: \uad11\ubb3c \ucc44\uad74\uc5d0\ub294 \uace1\uad2d\uc774, \ub098\ubb34 \ubca0\uae30\uc5d0\ub294 \ub3c4\ub07c\ub97c \uc0ac\uc6a9\ud558\uc138\uc694. STEP3: \uace0\uae09 \uc7a5\ube44 \uc81c\uc791\uc5d0 \ud544\uc694\ud55c \ub2e4\uc774\uc544\ubaac\ub4dc\ub098 \uae08\uacfc \uac19\uc740 \ud76c\uadc0 \uc790\uc6d0\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \ud655\ubcf4\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\ubc30\ud2c0 \ub85c\uc584' \ubaa8\ub4dc\uc5d0\uc11c \ucd08\uae30 \ud76c\uadc0 \uc790\uc6d0 \ud655\ubcf4\ub294 \uc0c1\ub2f9\ud55c \uc774\uc810\uc744 \uc81c\uacf5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc790\uc6d0 \uc9c0\ub3c4\ub97c \ud65c\uc6a9\ud558\uc5ec \uacbd\ub85c\ub97c \uacc4\ud68d\ud558\uace0 \ud6a8\uc728\uc744 \uadf9\ub300\ud654\ud558\uc138\uc694."}, {"question": "Voxiom.io\uc5d0\uc11c \ud06c\ub798\ud504\ud305 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "Voxiom.io\uc5d0\uc11c \ud06c\ub798\ud504\ud305 \uc2dc\uc2a4\ud15c\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \uac15\ub825\ud55c \ubb34\uae30, \ub3c4\uad6c, \uad6c\uc870\ubb3c\uc744 \uc81c\uc791\ud560 \uc218 \uc788\uae30 \ub54c\ubb38\uc5d0 \uc911\uc694\ud569\ub2c8\ub2e4. STEP1: \ub098\ubb34\uc640 \ub3cc\uacfc \uac19\uc740 \uae30\ubcf8 \uc790\uc6d0\uc744 \ubaa8\uc73c\uc138\uc694. STEP2: 'C' \ud0a4\ub97c \ub20c\ub7ec \ud06c\ub798\ud504\ud305 \uba54\ub274\uc5d0 \uc811\uadfc\ud558\uace0 \uc81c\uc791\ud560 \uc544\uc774\ud15c\uc744 \uc120\ud0dd\ud558\uc138\uc694. STEP3: \ud544\uc694\ud55c \uc7ac\ub8cc\uac00 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uace0 '\uc81c\uc791'\uc744 \ud074\ub9ad\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\ub3cc \uac80'\uc744 \uc81c\uc791\ud558\ub824\uba74 \ub098\ubb34 5\uac1c\uc640 \ub3cc 3\uac1c\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ud06c\ub798\ud504\ud305 \uc2dc\uc2a4\ud15c\uc740 \uacc4\uce35\uc801\uc774\uba70, '\ub2e4\uc774\uc544\ubaac\ub4dc \uac11\uc637'\uacfc \uac19\uc740 \uace0\uae09 \uc544\uc774\ud15c\uc740 \ud76c\uadc0\ud55c \uc7ac\ub8cc\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \ud06c\ub798\ud504\ud305 \uac00\uc774\ub4dc\ub97c \ud65c\uc6a9\ud558\uc5ec \uc5c5\uadf8\ub808\uc774\ub4dc \uacc4\ud68d\uc744 \uc804\ub7b5\uc801\uc73c\ub85c \uc138\uc6b0\uc138\uc694."}, {"question": "Voxiom.io\uc5d0\uc11c \uc5b4\ub5a4 \ubb34\uae30\uac00 \uac00\uc7a5 \ud6a8\uacfc\uc801\uc774\uba70, \ub370\ubbf8\uc9c0\uc640 \uc0ac\uac70\ub9ac \uba74\uc5d0\uc11c \uc5b4\ub5bb\uac8c \ube44\uad50\ub418\ub098\uc694?", "answer": "Voxiom.io\uc5d0\uc11c \ubb34\uae30\uc758 \ud6a8\uacfc\ub294 \ub370\ubbf8\uc9c0\uc640 \uc0ac\uac70\ub9ac\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4. '\ub3cc\uaca9 \uc18c\ucd1d'\uc740 \uc911\uac70\ub9ac \uc804\ud22c\uc5d0 \ub2e4\uc7ac\ub2e4\ub2a5\ud55c \uade0\ud615 \uc7a1\ud78c \ud1b5\uacc4\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. '\uc800\uaca9 \uc18c\ucd1d'\uc740 \uc7a5\uac70\ub9ac \ub370\ubbf8\uc9c0\uc5d0 \ub6f0\uc5b4\ub098\uc9c0\ub9cc \ubc1c\uc0ac \uc18d\ub3c4\uac00 \ub290\ub9bd\ub2c8\ub2e4. \uadfc\uc811\uc804\uc5d0\ub294 '\uc0b0\ud0c4\ucd1d'\uc774 \ub192\uc740 \ub370\ubbf8\uc9c0\ub97c \uc81c\uacf5\ud558\uc9c0\ub9cc \uc0ac\uac70\ub9ac\uac00 \uc81c\ud55c\uc801\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud300 \ub370\uc2a4\ub9e4\uce58'\uc5d0\uc11c '\ub3cc\uaca9 \uc18c\ucd1d'\uc740 \uc8fc\uc694 \uc704\uce58\ub97c \uc9c0\ud0a4\uae30\uc5d0 \uc801\ud569\ud558\uace0, '\uc800\uaca9 \uc18c\ucd1d'\uc740 \uba40\ub9ac\uc11c \uc801\uc744 \uc81c\uac70\ud558\uae30\uc5d0 \uc801\ud569\ud569\ub2c8\ub2e4. \ubb34\uae30 \ube44\uad50 \ucc28\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\ub294 \ucd5c\uace0\uc758 \ubb34\uc7a5\uc744 \uc120\ud0dd\ud558\uc138\uc694."}, {"question": "Voxiom.io\uc758 \uccb4\ub825\uacfc \ubc29\uc5b4 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uc5b4\ub5bb\uac8c \uad00\ub9ac\ud558\ub294 \uac83\uc774 \uac00\uc7a5 \uc88b\ub098\uc694?", "answer": "Voxiom.io\uc758 \uccb4\ub825\uacfc \ubc29\uc5b4 \uc2dc\uc2a4\ud15c\uc740 \uc0dd\uc874\uc5d0 \ub9e4\uc6b0 \uc911\uc694\ud569\ub2c8\ub2e4. \uccb4\ub825\uc740 \uc2ec\uc7a5 \uc544\uc774\ucf58\uc73c\ub85c \ud45c\uc2dc\ub418\uba70, \uc758\ub8cc \ud0a4\ud2b8\ub098 \uc74c\uc2dd\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud68c\ubcf5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubc29\uc5b4\ub825\uc740 \ubc29\ud328 \uc544\uc774\ucf58\uc73c\ub85c \ud45c\uc2dc\ub418\uba70, \ubc1b\ub294 \ud53c\ud574\ub97c \uc904\uc5ec\uc90d\ub2c8\ub2e4. \ubc29\uc5b4\ub825\uc740 \uc81c\uc791\ud558\uac70\ub098 \uc0c1\uc790\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc0dd\uc874 \ubaa8\ub4dc'\uc5d0\uc11c '\ub2e4\uc774\uc544\ubaac\ub4dc \uac11\uc637'\uc744 \ucc29\uc6a9\ud558\uba74 \ub0b4\uad6c\uc131\uc774 \ud06c\uac8c \uc99d\uac00\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. STEP1: \uae34\uae09 \uc0c1\ud669\uc5d0 \ub300\ube44\ud574 \ud56d\uc0c1 \uc758\ub8cc \ud0a4\ud2b8\ub97c \ud734\ub300\ud558\uc138\uc694. STEP2: \ub192\uc740 \ub4f1\uae09\uc758 \ubc29\uc5b4\uad6c\ub97c \uc81c\uc791\ud558\uac70\ub098 \ucc3e\uc73c\ub824\uace0 \ub178\ub825\ud558\uc138\uc694. STEP3: \ubd88\ud544\uc694\ud55c \uc2f8\uc6c0\uc744 \ud53c\ud558\uc5ec \uccb4\ub825\uacfc \ubc29\uc5b4\ub825\uc744 \uc720\uc9c0\ud558\uc138\uc694. \uccb4\ub825 \ubc0f \ubc29\uc5b4 \ucc28\ud2b8\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc0dd\uc874 \uc804\ub7b5\uc744 \uacc4\ud68d\ud558\uc138\uc694."}, {"question": "Voxiom.io\uc758 '\uc0dd\uc874' \ubaa8\ub4dc\uc640 '\ubc30\ud2c0 \ub85c\uc584' \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "Voxiom.io\uc758 '\uc0dd\uc874' \ubaa8\ub4dc\uc640 '\ubc30\ud2c0 \ub85c\uc584' \ubaa8\ub4dc\ub294 \uc11c\ub85c \ub2e4\ub978 \uac8c\uc784 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. '\uc0dd\uc874' \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uc2dc\uac04\uc774 \uc9c0\ub0a8\uc5d0 \ub530\ub77c \uc790\uc6d0\uc744 \uc218\uc9d1\ud558\uace0 \uad6c\uc870\ubb3c\uc744 \uac74\uc124\ud558\uba70 \uc801\uc744 \ub9c9\ub294 \ub370 \ucd08\uc810\uc774 \ub9de\ucdb0\uc838 \uc788\uc2b5\ub2c8\ub2e4. '\ubc30\ud2c0 \ub85c\uc584' \ubaa8\ub4dc\uc5d0\uc11c\ub294 \ud50c\ub808\uc774\uc5b4\ub294 \ucd5c\uc18c\ud55c\uc758 \uc7a5\ube44\ub97c \uac16\uace0 \ud50c\ub808\uc774 \uc601\uc5ed\uc774 \uc904\uc5b4\ub4dc\ub294 \ub3d9\uc548 \ubb34\uae30\uc640 \ubb3c\ud488\uc744 \ubc1c\uacac\ud558\uc5ec \uc218\uc9d1\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\uc0dd\uc874' \ubaa8\ub4dc\uc5d0\uc11c \uc801\uc758 \uacf5\uaca9\uc73c\ub85c\ubd80\ud130 \ubc29\uc5b4\ud558\uae30 \uc704\ud55c \uc694\uc0c8\ub97c \uc9c0\uc744 \uc218 \uc788\ub294 \ubc18\uba74, '\ubc30\ud2c0 \ub85c\uc584' \ubaa8\ub4dc\uc5d0\uc11c\ub294 \uc774\ub3d9\uc131\uc744 \uc720\uc9c0\ud558\uace0 \uc904\uc5b4\ub4dc\ub294 \uad6c\uc5ed\uc5d0 \uc801\uc751\ud574\uc57c \ud569\ub2c8\ub2e4. \ubaa8\ub4dc \ube44\uad50 \ud45c\ub97c \ud65c\uc6a9\ud558\uc5ec \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uc5d0 \ub9de\ub294 \ubaa8\ub4dc\ub97c \uc120\ud0dd\ud558\uc138\uc694."}, {"question": "\ub2e4\ub978 \uae30\uae30\uc5d0\uc11c Voxiom.io\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ub2e4\ub978 \uae30\uae30\uc5d0\uc11c Voxiom.io\uc758 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\ub294 \uac83\uc740 \uac04\ub2e8\ud569\ub2c8\ub2e4. STEP1: \ub450 \uae30\uae30 \ubaa8\ub450 \uac19\uc740 \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud588\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. STEP2: \ub4f1\ub85d\ub41c \uacc4\uc815\uc744 \uc0ac\uc6a9\ud558\ub294 \uacbd\uc6b0 \ud074\ub77c\uc6b0\ub4dc\ub97c \ud1b5\ud574 \uc9c4\ud589 \uc0c1\ud669\uc774 \uc790\ub3d9\uc73c\ub85c \ub3d9\uae30\ud654\ub429\ub2c8\ub2e4. STEP3: \uc778\ubca4\ud1a0\ub9ac\uc640 \ud1b5\uacc4\ub97c \ud3ec\ud568\ud55c \ubaa8\ub4e0 \ub370\uc774\ud130\uac00 \uc62c\ubc14\ub974\uac8c \uc774\uc804\ub418\uc5c8\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ubaa8\ubc14\uc77c \uae30\uae30\ub85c \uc804\ud658\ud558\ub294 \uacbd\uc6b0 \uc81c\uc791\ud55c \uc544\uc774\ud15c\uacfc \uc5c5\uc801\uc774 \uc6d0\ud65c\ud558\uac8c \ub098\ud0c0\ub098\uc57c \ud569\ub2c8\ub2e4. \ub370\uc774\ud130 \uc190\uc2e4 \ubc29\uc9c0\ub97c \uc704\ud574 \uc774\uc804 \ud655\uc778 \ubaa9\ub85d\uc744 \ud65c\uc6a9\ud558\uc138\uc694."}, {"question": "Voxiom.io\uc758 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\ub4e4\uc740 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\ub098\uc694?", "answer": "Voxiom.io\uc5d0\ub294 \uac8c\uc784\uc5d0 \uc7ac\ubbf8\ub97c \ub354\ud558\ub294 \uc228\uaca8\uc9c4 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \ub9ce\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc8fc\ubaa9\ud560 \ub9cc\ud55c \uc774\uc2a4\ud130 \uc5d0\uadf8 \uc911 \ud558\ub098\ub294 '\uc0dd\uc874' \ubaa8\ub4dc\uc758 \ube44\ubc00 \ub3d9\uad74\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc788\ub294 '\uae08\uc0c9 \uace1\uad2d\uc774'\uc785\ub2c8\ub2e4. STEP1: \ud2b9\ud788 \ubc29\ubb38 \ube48\ub3c4\uac00 \uc801\uc740 \uc9c0\uc5ed\uc744 \ud3ec\ud568\ud558\uc5ec \uc9c0\ub3c4\ub97c \ucca0\uc800\ud788 \ud0d0\ud5d8\ud558\uc138\uc694. STEP2: \uc774\uc0c1\ud55c \uad6c\uc870\ubb3c\uc774\ub098 \uc228\uaca8\uc9c4 \uacbd\ub85c\ub97c \ucc3e\uc73c\uc138\uc694. STEP3: \uc758\uc2ec\uc2a4\ub7ec\uc6b4 \ubb3c\uccb4\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\uc5ec \ube44\ubc00\uc744 \ubc1c\uacac\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, '\uc0ac\ub9c9 \uc0dd\ud0dc\uacc4'\uc5d0\uc11c \ud2b9\uc815 \uc120\uc778\uc7a5\uc744 \ubd80\uc218\uba74 \uc228\uaca8\uc9c4 \uc0c1\uc790\uac00 \ub098\ud0c0\ub0a0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\uc2a4\ud130 \uc5d0\uadf8 \uc9c0\ub3c4\ub97c \ud65c\uc6a9\ud558\uc5ec \uc774\ub7ec\ud55c \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uc744 \ucc3e\uc73c\uc138\uc694."}, {"question": "Voxiom.io\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uc5b4\ub5a4 \uc694\uc18c\uac00 \ud50c\ub808\uc774\uc5b4 \ud398\uc5b4\ub9c1\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\ub098\uc694?", "answer": "Voxiom.io\uc758 \ub9e4\uce6d \uc2dc\uc2a4\ud15c\uc740 \uc2b9\ud328\uc728\uacfc \ud0ac\ub370\uc2a4\uc728\uc744 \uace0\ub824\ud558\ub294 \ub4f1 \uc5ec\ub7ec \uc694\uc18c\ub97c \uace0\ub824\ud558\uc5ec \uade0\ud615 \uc7a1\ud78c \ub9e4\uce58\ub97c \ub9cc\ub4e4\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. STEP1: \ud50c\ub808\uc774\uc5b4 \uc2e4\ub825 \uc218\uc900\uc740 \uc2b9\ud328\uc728\uacfc \ud0ac\ub370\uc2a4\uc728\uc5d0 \ub530\ub77c \uacb0\uc815\ub429\ub2c8\ub2e4. STEP2: \uc5f0\uacb0 \ud488\uc9c8\uc740 \uc6d0\ud65c\ud55c \uac8c\uc784 \ud50c\ub808\uc774\ub97c \ubcf4\uc7a5\ud569\ub2c8\ub2e4. STEP3: \ud300 \uad6c\uc131\uc740 \ud3b8\ud5a5\ub41c \ub9e4\uce58\ub97c \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \uade0\ud615\uc774 \ub9de\ucdb0\uc9d1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, '\ud300 \ub370\uc2a4\ub9e4\uce58'\uc5d0\uc11c \uc2dc\uc2a4\ud15c\uc740 \ub450 \ud300 \ubaa8\ub450 \uacbd\ud5d8\uc774 \ud48d\ubd80\ud55c \ud50c\ub808\uc774\uc5b4\uc640 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \ud63c\ud569\ub418\ub3c4\ub85d \ud569\ub2c8\ub2e4. \ub9e4\uce6d \ucc28\ud2b8\ub97c \ud65c\uc6a9\ud558\uc5ec \uc774\ub7ec\ud55c \uc694\uc18c\ub4e4\uc774 \uacf5\uc815\ud55c \uac8c\uc784\uc744 \ub9cc\ub4dc\ub294 \ubc29\uc2dd\uc744 \uc774\ud574\ud558\uc138\uc694."}, {"question": "\uc800\uc0ac\uc591 \uae30\uae30\uc5d0\uc11c Voxiom.io\uc758 \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub294 \uac00\uc7a5 \uc88b\uc740 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc800\uc0ac\uc591 \uae30\uae30\uc5d0\uc11c Voxiom.io \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uc131\ub2a5\uacfc \uc2dc\uac01 \ud6a8\uacfc \uc0ac\uc774\uc758 \uade0\ud615\uc744 \ub9de\ucd94\uae30 \uc704\ud574 \uc124\uc815\uc744 \uc870\uc815\ud574\uc57c \ud569\ub2c8\ub2e4. STEP1: '\uc635\uc158' \uba54\ub274\uc5d0\uc11c \uadf8\ub798\ud53d \uc124\uc815\uc744 \ub0ae\ucdb0 \uae30\uae30 \ubd80\ud558\ub97c \uc904\uc774\uc138\uc694. STEP2: \uadf8\ub9bc\uc790\ub098 \uc785\uc790 \ud6a8\uacfc\uc640 \uac19\uc740 \ubd88\ud544\uc694\ud55c \uae30\ub2a5\uc744 \ube44\ud65c\uc131\ud654\ud558\uc138\uc694. STEP3: \ubc31\uadf8\ub77c\uc6b4\ub4dc \uc751\uc6a9 \ud504\ub85c\uadf8\ub7a8\uc744 \ub2eb\uc544 \uc2dc\uc2a4\ud15c \ub9ac\uc18c\uc2a4\ub97c \ud655\ubcf4\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc800\uc0ac\uc591 PC\uc5d0\uc11c\ub294 \ud574\uc0c1\ub3c4\ub97c 720p\ub85c \uc124\uc815\ud558\uace0 \uc548\ud2f0\uc568\ub9ac\uc5b4\uc2f1\uc744 \ub044\uba74 \ud504\ub808\uc784 \uc18d\ub3c4\uac00 \ud06c\uac8c \uac1c\uc120\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc131\ub2a5 \ucd5c\uc801\ud654 \uac00\uc774\ub4dc\ub97c \uc0ac\uc6a9\ud558\uc5ec \ucd5c\uc0c1\uc758 \uacbd\ud5d8\uc744 \uc704\ud574 \uc124\uc815\uc744 \ubbf8\uc138 \uc870\uc815\ud558\uc138\uc694."}]
[{"question": "Voxiom.io\u65b0\u624b\u73a9\u5bb6\u5982\u4f55\u5feb\u901f\u5165\u95e8\u57fa\u7840\u63a7\u5236\uff1f", "answer": "\u5728Voxiom.io\u5feb\u901f\u5165\u95e8\uff0c\u5173\u952e\u5728\u4e8e\u638c\u63e1\u57fa\u7840\u63a7\u5236\u3002\u6b65\u9aa4\u4e00\uff1a\u4f7f\u7528\"WASD\"\u952e\u8fdb\u884c\u79fb\u52a8\uff0c\u9f20\u6807\u8fdb\u884c\u89c6\u89d2\u8c03\u6574\u3002\u6b65\u9aa4\u4e8c\uff1a\u5de6\u952e\u5c04\u51fb\uff0c\u53f3\u952e\u7784\u51c6\u3002\u6b65\u9aa4\u4e09\uff1a\u6309\"E\"\u952e\u4e0e\u7bb1\u5b50\u6216\u95e8\u7b49\u7269\u4f53\u4e92\u52a8\u3002\u4f8b\u5982\uff0c\u5728\"\u751f\u5b58\"\u6a21\u5f0f\u4e0b\uff0c\u9700\u8981\u6253\u5f00\u7bb1\u5b50\u6536\u96c6\u8d44\u6e90\u3002\u5efa\u8bae\u5728\"\u8bad\u7ec3\"\u6a21\u5f0f\u4e0b\u7ec3\u4e60\u8fd9\u4e9b\u63a7\u5236\uff0c\u5728\u8f7b\u677e\u7684\u73af\u5883\u4e2d\u57f9\u517b\u808c\u8089\u8bb0\u5fc6\u3002"}, {"question": "\u5728Voxiom.io\u6e38\u620f\u4e2d\u73a9\u6ee1100\u5c0f\u65f6\u540e\uff0c\u54ea\u4e9b\u8d44\u6e90\u6536\u96c6\u7b56\u7565\u6700\u6709\u6548\uff1f", "answer": "\u5728Voxiom.io\u6e38\u620f\u4e2d\u73a9\u6ee1100\u5c0f\u65f6\u540e\uff0c\u9ad8\u6548\u7684\u8d44\u6e90\u6536\u96c6\u81f3\u5173\u91cd\u8981\u3002\u6b65\u9aa4\u4e00\uff1a\u8bc6\u522b\u9ad8\u4ea7\u8d44\u6e90\u533a\u57df\uff0c\u4f8b\u5982\u6d1e\u7a74\u6216\u8302\u5bc6\u7684\u68ee\u6797\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f7f\u7528\u9550\u6316\u6398\u77ff\u77f3\uff0c\u4f7f\u7528\u65a7\u5934\u780d\u4f10\u6811\u6728\u3002\u6b65\u9aa4\u4e09\uff1a\u4f18\u5148\u6536\u96c6\u7a00\u6709\u8d44\u6e90\uff0c\u4f8b\u5982\u94bb\u77f3\u6216\u91d1\u5b50\uff0c\u7528\u4e8e\u5236\u4f5c\u9ad8\u7ea7\u88c5\u5907\u3002\u4f8b\u5982\uff0c\u5728\"\u5927\u9003\u6740\"\u6a21\u5f0f\u4e2d\uff0c\u5c3d\u65e9\u83b7\u5f97\u7a00\u6709\u8d44\u6e90\u53ef\u4ee5\u83b7\u5f97\u663e\u8457\u4f18\u52bf\u3002\u8003\u8651\u4f7f\u7528\u8d44\u6e90\u5730\u56fe\u89c4\u5212\u8def\u7ebf\uff0c\u6700\u5927\u5316\u6548\u7387\u3002"}, {"question": "\u5728Voxiom.io\u4e2d\uff0c\u4e3a\u4ec0\u4e48\u7406\u89e3\u5236\u4f5c\u7cfb\u7edf\u81f3\u5173\u91cd\u8981\uff0c\u4ee5\u53ca\u5236\u4f5c\u7cfb\u7edf\u662f\u5982\u4f55\u5de5\u4f5c\u7684\uff1f", "answer": "\u5728Voxiom.io\u4e2d\u7406\u89e3\u5236\u4f5c\u7cfb\u7edf\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u5141\u8bb8\u4f60\u5236\u4f5c\u5f3a\u5927\u7684\u6b66\u5668\u3001\u5de5\u5177\u548c\u5efa\u7b51\u3002\u6b65\u9aa4\u4e00\uff1a\u6536\u96c6\u57fa\u7840\u8d44\u6e90\uff0c\u4f8b\u5982\u6728\u6750\u548c\u77f3\u5934\u3002\u6b65\u9aa4\u4e8c\uff1a\u6309\"C\"\u952e\u8bbf\u95ee\u5236\u4f5c\u83dc\u5355\uff0c\u9009\u62e9\u8981\u5236\u4f5c\u7684\u7269\u54c1\u3002\u6b65\u9aa4\u4e09\uff1a\u786e\u4fdd\u4f60\u62e5\u6709\u6240\u9700\u7684\u6750\u6599\uff0c\u7136\u540e\u70b9\u51fb\"\u5236\u4f5c\"\u3002\u4f8b\u5982\uff0c\u5236\u4f5c\"\u77f3\u5251\"\u9700\u89815\u4e2a\u6728\u6750\u548c3\u5757\u77f3\u5934\u3002\u5236\u4f5c\u7cfb\u7edf\u5206\u5c42\uff0c\u6240\u4ee5\u9ad8\u7ea7\u7269\u54c1\uff0c\u4f8b\u5982\"\u94bb\u77f3\u76d4\u7532\"\uff0c\u9700\u8981\u7a00\u6709\u6750\u6599\u3002\u4f7f\u7528\u5236\u4f5c\u6307\u5357\u5236\u5b9a\u5347\u7ea7\u7b56\u7565\u3002"}, {"question": "\u5728Voxiom.io\u4e2d\uff0c\u54ea\u4e9b\u6b66\u5668\u6700\u6709\u6548\uff0c\u5b83\u4eec\u5728\u4f24\u5bb3\u548c\u5c04\u7a0b\u65b9\u9762\u5982\u4f55\u6bd4\u8f83\uff1f", "answer": "\u5728Voxiom.io\u4e2d\uff0c\u6b66\u5668\u7684\u6709\u6548\u6027\u53d6\u51b3\u4e8e\u4f24\u5bb3\u548c\u5c04\u7a0b\u3002\"\u7a81\u51fb\u6b65\u67aa\"\u7684\u5c5e\u6027\u5747\u8861\uff0c\u4f7f\u5176\u5728\u4e2d\u8ddd\u79bb\u6218\u6597\u4e2d\u5177\u6709\u591a\u529f\u80fd\u6027\u3002\"\u72d9\u51fb\u6b65\u67aa\"\u64c5\u957f\u8fdc\u8ddd\u79bb\u4f24\u5bb3\uff0c\u4f46\u5c04\u51fb\u901f\u5ea6\u8f83\u6162\u3002\"\u9730\u5f39\u67aa\"\u5728\u8fd1\u8ddd\u79bb\u6218\u6597\u4e2d\u5177\u6709\u9ad8\u4f24\u5bb3\uff0c\u4f46\u5c04\u7a0b\u6709\u9650\u3002\u4f8b\u5982\uff0c\u5728\"\u56e2\u961f\u6b7b\u4ea1\u7ade\u8d5b\"\u4e2d\uff0c\"\u7a81\u51fb\u6b65\u67aa\"\u9002\u5408\u63a7\u5236\u5173\u952e\u4f4d\u7f6e\uff0c\u800c\"\u72d9\u51fb\u6b65\u67aa\"\u5219\u9002\u5408\u8fdc\u8ddd\u79bb\u51fb\u6740\u654c\u4eba\u3002\u4f7f\u7528\u6b66\u5668\u5bf9\u6bd4\u56fe\u8868\uff0c\u9009\u62e9\u9002\u5408\u4f60\u6e38\u620f\u98ce\u683c\u7684\u6700\u4f73\u88c5\u5907\u3002"}, {"question": "Voxiom.io\u4e2d\u7684\u751f\u547d\u503c\u548c\u62a4\u7532\u7cfb\u7edf\u662f\u5982\u4f55\u5de5\u4f5c\u7684\uff0c\u4ee5\u53ca\u6700\u4f73\u7684\u7ba1\u7406\u65b9\u6cd5\u662f\u4ec0\u4e48\uff1f", "answer": "Voxiom.io\u4e2d\u7684\u751f\u547d\u503c\u548c\u62a4\u7532\u7cfb\u7edf\u5bf9\u4e8e\u751f\u5b58\u81f3\u5173\u91cd\u8981\u3002\u751f\u547d\u503c\u4ee5\u5fc3\u810f\u56fe\u6807\u8868\u793a\uff0c\u53ef\u4ee5\u4f7f\u7528\u6025\u6551\u5305\u6216\u98df\u7269\u6062\u590d\u3002\u62a4\u7532\u4ee5\u76fe\u724c\u56fe\u6807\u663e\u793a\uff0c\u53ef\u51cf\u5c11\u4f24\u5bb3\uff0c\u53ef\u4ee5\u5236\u4f5c\u6216\u4ece\u7bb1\u5b50\u4e2d\u83b7\u5f97\u3002\u4f8b\u5982\uff0c\u5728\"\u751f\u5b58\u6a21\u5f0f\"\u4e2d\uff0c\u7a7f\u7740\"\u94bb\u77f3\u76d4\u7532\"\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u8010\u4e45\u6027\u3002\u6b65\u9aa4\u4e00\uff1a\u59cb\u7ec8\u643a\u5e26\u6025\u6551\u5305\u4ee5\u5907\u4e0d\u65f6\u4e4b\u9700\u3002\u6b65\u9aa4\u4e8c\uff1a\u4f18\u5148\u5236\u4f5c\u6216\u5bfb\u627e\u9ad8\u7ea7\u62a4\u7532\u3002\u6b65\u9aa4\u4e09\uff1a\u907f\u514d\u4e0d\u5fc5\u8981\u7684\u6218\u6597\uff0c\u4ee5\u4fdd\u7559\u751f\u547d\u503c\u548c\u62a4\u7532\u8010\u4e45\u5ea6\u3002\u4f7f\u7528\u751f\u547d\u503c\u548c\u62a4\u7532\u6d41\u7a0b\u56fe\uff0c\u5236\u5b9a\u4f60\u7684\u751f\u5b58\u7b56\u7565\u3002"}, {"question": "Voxiom.io\u4e2d\u7684\"\u751f\u5b58\"\u548c\"\u5927\u9003\u6740\"\u6a21\u5f0f\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "Voxiom.io\u4e2d\u7684\"\u751f\u5b58\"\u548c\"\u5927\u9003\u6740\"\u6a21\u5f0f\u63d0\u4f9b\u4e86\u4e0d\u540c\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u5728\"\u751f\u5b58\"\u6a21\u5f0f\u4e2d\uff0c\u91cd\u70b9\u5728\u4e8e\u6536\u96c6\u8d44\u6e90\u3001\u5efa\u7b51\u7ed3\u6784\u548c\u62b5\u5fa1\u654c\u4eba\u3002\u5728\"\u5927\u9003\u6740\"\u6a21\u5f0f\u4e2d\uff0c\u73a9\u5bb6\u5f00\u59cb\u65f6\u88c5\u5907\u5f88\u5c11\uff0c\u5fc5\u987b\u641c\u96c6\u6b66\u5668\u548c\u8865\u7ed9\uff0c\u540c\u65f6\u6e38\u620f\u533a\u57df\u4f1a\u9010\u6e10\u7f29\u5c0f\u3002\u4f8b\u5982\uff0c\u5728\"\u751f\u5b58\"\u6a21\u5f0f\u4e2d\uff0c\u4f60\u53ef\u80fd\u4f1a\u5efa\u9020\u5821\u5792\u6765\u62b5\u5fa1\u654c\u4eba\u7684\u4e00\u6ce2\u6ce2\u653b\u51fb\uff0c\u800c\u5728\"\u5927\u9003\u6740\"\u6a21\u5f0f\u4e2d\uff0c\u4f60\u9700\u8981\u4fdd\u6301\u673a\u52a8\u6027\u548c\u9002\u5e94\u4e0d\u65ad\u7f29\u5c0f\u7684\u533a\u57df\u3002\u4f7f\u7528\u6a21\u5f0f\u6bd4\u8f83\u8868\uff0c\u51b3\u5b9a\u54ea\u79cd\u6a21\u5f0f\u66f4\u9002\u5408\u4f60\u7684\u6e38\u620f\u98ce\u683c\u3002"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684Voxiom.io\u6e38\u620f\u8fdb\u5ea6\u4ece\u4e00\u4e2a\u8bbe\u5907\u8fc1\u79fb\u5230\u53e6\u4e00\u4e2a\u8bbe\u5907\uff1f", "answer": "\u5728\u4e0d\u540c\u7684\u8bbe\u5907\u4e4b\u95f4\u8fc1\u79fbVoxiom.io\u6e38\u620f\u8fdb\u5ea6\u975e\u5e38\u7b80\u5355\u3002\u6b65\u9aa4\u4e00\uff1a\u786e\u4fdd\u4f60\u5728\u4e24\u4e2a\u8bbe\u5907\u4e0a\u90fd\u767b\u5f55\u4e86\u540c\u4e00\u4e2a\u8d26\u6237\u3002\u6b65\u9aa4\u4e8c\uff1a\u5982\u679c\u4f60\u4f7f\u7528\u6ce8\u518c\u8d26\u6237\uff0c\u4f60\u7684\u8fdb\u5ea6\u5c06\u901a\u8fc7\u4e91\u7aef\u81ea\u52a8\u540c\u6b65\u3002\u6b65\u9aa4\u4e09\uff1a\u9a8c\u8bc1\u6240\u6709\u6570\u636e\uff08\u5305\u62ec\u5e93\u5b58\u548c\u7edf\u8ba1\u6570\u636e\uff09\u5df2\u6b63\u786e\u4f20\u8f93\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4ecePC\u5207\u6362\u5230\u79fb\u52a8\u8bbe\u5907\uff0c\u4f60\u7684\u5df2\u5236\u4f5c\u7269\u54c1\u548c\u6210\u5c31\u5e94\u8be5\u4f1a\u65e0\u7f1d\u663e\u793a\u3002\u4f7f\u7528\u8fc1\u79fb\u68c0\u67e5\u6e05\u5355\uff0c\u4ee5\u786e\u4fdd\u5728\u8fc1\u79fb\u8fc7\u7a0b\u4e2d\u6ca1\u6709\u4e22\u5931\u4efb\u4f55\u6570\u636e\u3002"}, {"question": "Voxiom.io\u4e2d\u7684\u9690\u85cf\u5f69\u86cb\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5982\u4f55\u627e\u5230\u5b83\u4eec\uff1f", "answer": "Voxiom.io\u4e2d\u5145\u6ee1\u4e86\u9690\u85cf\u5f69\u86cb\uff0c\u4e3a\u6e38\u620f\u589e\u6dfb\u4e86\u4e50\u8da3\u3002\u4e00\u4e2a\u503c\u5f97\u6ce8\u610f\u7684\u5f69\u86cb\u662f\"\u91d1\u9550\"\uff0c\u5b83\u53ef\u4ee5\u5728\"\u751f\u5b58\"\u6a21\u5f0f\u7684\u79d8\u5bc6\u6d1e\u7a74\u4e2d\u627e\u5230\u3002\u6b65\u9aa4\u4e00\uff1a\u5f7b\u5e95\u63a2\u7d22\u5730\u56fe\uff0c\u7279\u522b\u662f\u90a3\u4e9b\u8f83\u5c11\u5149\u987e\u7684\u533a\u57df\u3002\u6b65\u9aa4\u4e8c\uff1a\u5bfb\u627e\u4e0d\u5bfb\u5e38\u7684\u7ed3\u6784\u6216\u9690\u85cf\u8def\u5f84\u3002\u6b65\u9aa4\u4e09\uff1a\u4e0e\u53ef\u7591\u7269\u4f53\u4e92\u52a8\uff0c\u4ee5\u63ed\u793a\u79d8\u5bc6\u3002\u4f8b\u5982\uff0c\u5728\"\u6c99\u6f20\u751f\u7269\u7fa4\u843d\"\u4e2d\uff0c\u6253\u7834\u7279\u5b9a\u7684\u4ed9\u4eba\u638c\u53ef\u80fd\u4f1a\u63ed\u793a\u9690\u85cf\u7684\u7bb1\u5b50\u3002\u4f7f\u7528\u5f69\u86cb\u5730\u56fe\u6765\u8ffd\u8e2a\u8fd9\u4e9b\u9690\u85cf\u7684\u5b9d\u85cf\u3002"}, {"question": "Voxiom.io\u7684\u5339\u914d\u7cfb\u7edf\u662f\u5982\u4f55\u5de5\u4f5c\u7684\uff0c\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u73a9\u5bb6\u5339\u914d\uff1f", "answer": "Voxiom.io\u7684\u5339\u914d\u7cfb\u7edf\u65e8\u5728\u901a\u8fc7\u8003\u8651\u51e0\u4e2a\u56e0\u7d20\u6765\u521b\u5efa\u5e73\u8861\u7684\u5339\u914d\u3002\u6b65\u9aa4\u4e00\uff1a\u73a9\u5bb6\u6280\u80fd\u6c34\u5e73\uff0c\u7531\u80dc\u8d1f\u6bd4\u548c\u6740\u654c\u6bd4\u51b3\u5b9a\uff0c\u662f\u4e3b\u8981\u56e0\u7d20\u3002\u6b65\u9aa4\u4e8c\uff1a\u8fde\u63a5\u8d28\u91cf\u786e\u4fdd\u6d41\u7545\u7684\u6e38\u620f\u4f53\u9a8c\u3002\u6b65\u9aa4\u4e09\uff1a\u56e2\u961f\u6784\u6210\u5e73\u8861\uff0c\u4ee5\u907f\u514d\u4e00\u65b9\u7684\u5339\u914d\u3002\u4f8b\u5982\uff0c\u5728\"\u56e2\u961f\u6b7b\u4ea1\u7ade\u8d5b\"\u4e2d\uff0c\u7cfb\u7edf\u4f1a\u786e\u4fdd\u4e24\u4e2a\u56e2\u961f\u90fd\u62e5\u6709\u7ecf\u9a8c\u4e30\u5bcc\u7684\u548c\u65b0\u73a9\u5bb6\u7684\u6df7\u5408\u3002\u4f7f\u7528\u5339\u914d\u6d41\u7a0b\u56fe\u6765\u4e86\u89e3\u8fd9\u4e9b\u56e0\u7d20\u5982\u4f55\u76f8\u4e92\u4f5c\u7528\uff0c\u4ee5\u521b\u5efa\u516c\u5e73\u7684\u6e38\u620f\u3002"}, {"question": "\u5982\u4f55\u4f18\u5316\u4f4e\u7aef\u8bbe\u5907\u4e0a\u7684Voxiom.io\u6027\u80fd\uff1f", "answer": "\u4f18\u5316\u4f4e\u7aef\u8bbe\u5907\u4e0a\u7684Voxiom.io\u6027\u80fd\u6d89\u53ca\u8c03\u6574\u8bbe\u7f6e\uff0c\u4ee5\u5e73\u8861\u6027\u80fd\u548c\u89c6\u89c9\u6548\u679c\u3002\u6b65\u9aa4\u4e00\uff1a\u5728\"\u9009\u9879\"\u83dc\u5355\u4e2d\u964d\u4f4e\u56fe\u5f62\u8bbe\u7f6e\uff0c\u4ee5\u51cf\u5c11\u5bf9\u8bbe\u5907\u7684\u538b\u529b\u3002\u6b65\u9aa4\u4e8c\uff1a\u7981\u7528\u4e0d\u5fc5\u8981\u7684\u7279\u6027\uff0c\u4f8b\u5982\u9634\u5f71\u6216\u7c92\u5b50\u6548\u679c\u3002\u6b65\u9aa4\u4e09\uff1a\u5173\u95ed\u540e\u53f0\u5e94\u7528\u7a0b\u5e8f\uff0c\u91ca\u653e\u7cfb\u7edf\u8d44\u6e90\u3002\u4f8b\u5982\uff0c\u5728\u4f4e\u7aefPC\u4e0a\uff0c\u5c06\u5206\u8fa8\u7387\u8bbe\u7f6e\u4e3a720p\uff0c\u5e76\u5173\u95ed\u6297\u952f\u9f7f\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u5e27\u7387\u3002\u4f7f\u7528\u6027\u80fd\u4f18\u5316\u6307\u5357\uff0c\u5fae\u8c03\u4f60\u7684\u8bbe\u7f6e\uff0c\u83b7\u5f97\u6700\u4f73\u4f53\u9a8c\u3002"}]
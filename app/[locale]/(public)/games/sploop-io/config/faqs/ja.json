[{"question": "Sploop.io\u3067\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u57fa\u672c\u64cd\u4f5c\u3092\u7d20\u65e9\u304f\u7406\u89e3\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "Sploop.io\u306e\u57fa\u672c\u64cd\u4f5c\u3092\u7d20\u65e9\u304f\u7406\u89e3\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d71\uff1aWASD\u30ad\u30fc\u307e\u305f\u306f\u77e2\u5370\u30ad\u30fc\u3092\u4f7f\u7528\u3057\u3066\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u79fb\u52d5\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5de6\u30af\u30ea\u30c3\u30af\u3067\u6398\u524a\u3057\u3001\u53f3\u30af\u30ea\u30c3\u30af\u3067\u69cb\u7bc9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u307e\u305f\u306f\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u5bfe\u8a71\u3059\u308b\u306b\u306f\u3001\u300eE\u300f\u30ad\u30fc\u3092\u62bc\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u9069\u5207\u306a\u5834\u6240\u306b\u6398\u524a\u3059\u308b\u3053\u3068\u3067\u3001\u91d1\u3084\u907a\u7269\u306a\u3069\u306e\u96a0\u3055\u308c\u305f\u5b9d\u7269\u3092\u767a\u898b\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u57fa\u672c\u7684\u306a\u77e5\u8b58\u306f\u3001\u30b2\u30fc\u30e0\u3092\u52b9\u679c\u7684\u306b\u30ca\u30d3\u30b2\u30fc\u30c8\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002[\u6bd4\u55a9\u8aac\u660e\uff1a\u64cd\u4f5c\u3092\u5b9d\u7bb1\u306e\u9375\u3068\u8003\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u305d\u308c\u3089\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u3067\u3001\u30b2\u30fc\u30e0\u306e\u53ef\u80fd\u6027\u304c\u89e3\u653e\u3055\u308c\u307e\u3059\u3002]"}, {"question": "Sploop.io\u3067100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u306e\u6700\u9069\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "Sploop.io\u3067100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u9ad8\u5ea6\u306a\u30ea\u30bd\u30fc\u30b9\u7ba1\u7406\u304c\u4e0d\u53ef\u6b20\u306b\u306a\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6d1e\u7a9f\u3084\u5730\u4e0b\u6e56\u306a\u3069\u3001\u30ea\u30bd\u30fc\u30b9\u5bc6\u5ea6\u304c\u9ad8\u3044\u5730\u57df\u3092\u512a\u5148\u3057\u3066\u6398\u524a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6700\u521d\u306b\u4fdd\u7ba1\u30e6\u30cb\u30c3\u30c8\u306a\u3069\u306e\u5fc5\u9808\u69cb\u9020\u7269\u3092\u5efa\u8a2d\u3059\u308b\u3053\u3068\u3067\u3001\u30ea\u30bd\u30fc\u30b9\u3092\u8ce2\u304f\u5229\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u4e0d\u8db3\u3057\u3066\u3044\u308b\u30a2\u30a4\u30c6\u30e0\u3068\u4ea4\u63db\u3059\u308b\u305f\u3081\u306b\u3001\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u4f59\u5270\u30ea\u30bd\u30fc\u30b9\u3092\u4ea4\u63db\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u5efa\u7bc9\u8cc7\u6750\u304c\u4e0d\u8db3\u3057\u3066\u3044\u308b\u5834\u5408\u3001\u6728\u6750\u3068\u77f3\u306e\u4ea4\u63db\u306f\u6709\u76ca\u3067\u3059\u3002[\u591a\u65b9\u6848\u6bd4\u8f03\uff1a\u4e00\u90e8\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30ea\u30bd\u30fc\u30b9\u3092\u84c4\u7a4d\u3059\u308b\u3053\u3068\u3092\u597d\u307f\u307e\u3059\u304c\u3001\u4ed6\u306e\u4eba\u306f\u5373\u6642\u5229\u7528\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3059\u3002\u5f8c\u8005\u306f\u3001\u3057\u3070\u3057\u3070\u9577\u671f\u7684\u306a\u6210\u679c\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002]"}, {"question": "Sploop.io\u3067\u5730\u5f62\u751f\u6210\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f", "answer": "Sploop.io\u3067\u5730\u5f62\u751f\u6210\u30a2\u30eb\u30b4\u30ea\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u3001\u6226\u7565\u7684\u8a08\u753b\u306b\u3068\u3063\u3066\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u30a2\u30eb\u30b4\u30ea\u30
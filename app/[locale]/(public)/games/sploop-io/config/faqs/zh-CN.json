[{"question": "Sploop.io\u65b0\u624b\u5982\u4f55\u5feb\u901f\u638c\u63e1\u57fa\u672c\u64cd\u4f5c?", "answer": "\u5feb\u901f\u638c\u63e1Sploop.io\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\uff1a\u6b65\u9aa41- \u4f7f\u7528WASD\u952e\u6216\u65b9\u5411\u952e\u79fb\u52a8\u89d2\u8272\u3002\u6b65\u9aa42- \u5de6\u952e\u6316\u6398\uff0c\u53f3\u952e\u5efa\u9020\u3002\u6b65\u9aa43- \u6309\"E\"\u952e\u4e0e\u7269\u4f53\u6216\u73a9\u5bb6\u4e92\u52a8\u3002\u4f8b\u5982\uff0c\u5728\u6b63\u786e\u7684\u5730\u65b9\u6316\u6398\u53ef\u4ee5\u53d1\u73b0\u9690\u85cf\u7684\u5b9d\u85cf\uff0c\u5982\u9ec4\u91d1\u6216\u6587\u7269\u3002\u8fd9\u4e9b\u57fa\u7840\u77e5\u8bc6\u5c06\u5e2e\u52a9\u4f60\u6709\u6548\u5730\u6e38\u73a9\u6e38\u620f\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u64cd\u4f5c\u89c6\u4e3a\u6253\u5f00\u5b9d\u7bb1\u7684\u94a5\u5319\uff1b\u638c\u63e1\u5b83\u4eec\u5c06\u91ca\u653e\u6e38\u620f\u7684\u6f5c\u529b\u3002]"}, {"question": "Sploop.io\u6e38\u620f100\u5c0f\u65f6\u540e\uff0c\u5982\u4f55\u6700\u4f73\u5730\u8fdb\u884c\u8d44\u6e90\u7ba1\u7406\uff1f", "answer": "\u5728Sploop.io\u6e38\u620f\u4e2d\u8fbe\u5230100\u5c0f\u65f6\u540e\uff0c\u9ad8\u7ea7\u8d44\u6e90\u7ba1\u7406\u81f3\u5173\u91cd\u8981\u3002\u6b65\u9aa41-\u4f18\u5148\u5728\u8d44\u6e90\u5bc6\u5ea6\u9ad8\u7684\u533a\u57df\u6316\u6398\uff0c\u4f8b\u5982\u6d1e\u7a74\u6216\u5730\u4e0b\u6e56\u6cca\u3002\u6b65\u9aa42- \u9996\u5148\u5efa\u9020\u5fc5\u8981\u7684\u5efa\u7b51\u7269\uff0c\u4f8b\u5982\u50a8\u85cf\u5355\u5143\uff0c\u5408\u7406\u5229\u7528\u8d44\u6e90\u3002\u6b65\u9aa43- \u4e0e\u5176\u4ed6\u73a9\u5bb6\u4ea4\u6613\u591a\u4f59\u7684\u8d44\u6e90\uff0c\u4ee5\u83b7\u5f97\u4f60\u7f3a\u5c11\u7684\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5efa\u7b51\u6750\u6599\u4e0d\u8db3\uff0c\u7528\u6728\u6750\u4ea4\u6362\u77f3\u5934\u4f1a\u6709\u76ca\u5904\u3002 [\u591a\u65b9\u6848\u5bf9\u6bd4: \u6709\u4e9b\u73a9\u5bb6\u559c\u6b22\u56e4\u79ef\u8d44\u6e90\uff0c\u800c\u53e6\u4e00\u4e9b\u73a9\u5bb6\u5219\u4e13\u6ce8\u4e8e\u7acb\u5373\u4f7f\u7528\uff1b\u540e\u8005\u901a\u5e38\u4f1a\u83b7\u5f97\u66f4\u597d\u7684\u957f\u671f\u7ed3\u679c\u3002]"}, {"question": "\u5728Sploop.io\u4e2d\uff0c\u4e86\u89e3\u5730\u5f62\u751f\u6210\u7b97\u6cd5\u4e3a\u4ec0\u4e48\u91cd\u8981\uff1f", "answer": "\u5728Sploop.io\u4e2d\u4e86\u89e3\u5730\u5f62\u751f\u6210\u7b97\u6cd5\u5bf9\u4e8e\u6218\u7565\u89c4\u5212\u81f3\u5173\u91cd\u8981\u3002\u8be5\u7b97\u6cd5\u51b3\u5b9a\u4e86\u8d44\u6e90\u3001\u969c\u788d\u7269\u548c\u9690\u85cf\u533a\u57df\u7684\u5e03\u5c40\u3002\u4f8b\u5982\uff0c\u77e5\u9053\u91d1\u77ff\u901a\u5e38\u51fa\u73b0\u5728\u7194\u5ca9\u6d41\u9644\u8fd1\u53ef\u4ee5\u6307\u5bfc\u4f60\u7684\u6316\u6398\u5de5\u4f5c\u3002\u8fd9\u4e9b\u77e5\u8bc6\u4f7f\u4f60\u80fd\u591f\u9884\u6d4b\u8d44\u6e90\u4f4d\u7f6e\u5e76\u76f8\u5e94\u5730\u89c4\u5212\u4f60\u7684\u884c\u52a8\u3002[\u6d41\u7a0b\u56fe\u89e3: \u5730\u5f62\u751f\u6210\u2192\u8d44\u6e90\u6446\u653e\u2192\u73a9\u5bb6\u7b56\u7565]"}, {"question": "Sploop.io\u5982\u4f55\u5904\u7406\u8de8\u5e73\u53f0\u517c\u5bb9\u6027\u4ee5\u786e\u4fdd\u73a9\u5bb6\u6570\u636e\uff1f", "answer": "Sploop.io\u901a\u8fc7\u4f7f\u7528\u57fa\u4e8e\u4e91\u7684\u5b58\u50a8\u6765\u786e\u4fdd\u8de8\u5e73\u53f0\u517c\u5bb9\u6027\u3002\u8fd9\u610f\u5473\u7740\u4f60\u7684\u8fdb\u5ea6\u4fdd\u5b58\u5728\u670d\u52a1\u5668\u4e0a\uff0c\u5e76\u4e14\u53ef\u4ee5\u4ece\u4efb\u4f55\u8bbe\u5907\u8bbf\u95ee\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728PC\u4e0a\u73a9\u6e38\u620f\uff0c\u7136\u540e\u5207\u6362\u5230\u79fb\u52a8\u8bbe\u5907\uff0c\u4f60\u7684\u5e93\u5b58\u548c\u6210\u5c31\u5c06\u4fdd\u6301\u4e0d\u53d8\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: PC\u2192\u4e91\u540c\u6b65\u2192\u79fb\u52a8\uff1b\u6570\u636e\u5b8c\u6574\u6027: \u9ad8]"}, {"question": "Sploop.io\u4e2d\u73a9\u5bb6\u53ef\u4ee5\u53d1\u73b0\u54ea\u4e9b\u9690\u85cf\u5185\u5bb9\uff0c\u4ee5\u53ca\u5982\u4f55\u627e\u5230\u5b83\u4eec\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u63a2\u7d22\u4e0d\u592a\u663e\u773c\u7684\u5730\u65b9\u6765\u53d1\u73b0Sploop.io\u4e2d\u7684\u9690\u85cf\u5185\u5bb9\u3002\u4f8b\u5982\uff0c\u6df1\u5165\u6316\u6398\u5730\u4e0b\u53ef\u80fd\u4f1a\u53d1\u73b0\u5145\u6ee1\u7a00\u6709\u6587\u7269\u7684\u79d8\u5bc6\u6d1e\u7a74\u3002\u6b64\u5916\uff0c\u4e0e\u67d0\u4e9bNPC\u4e92\u52a8\u53ef\u4ee5\u89e3\u9501\u9690\u85cf\u4efb\u52a1\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u6e38\u620f\u4e16\u754c\u89c6\u4e3a\u4e00\u5ea7\u51b0\u5c71\uff1b\u4f60\u770b\u5230\u7684\u8868\u9762\u53ea\u662f\u51b0\u5c71\u4e00\u89d2\u3002]"}, {"question": "Sploop.io\u4e2d\u54ea\u4e9b\u5de5\u5177\u5bf9\u9ad8\u7ea7\u73a9\u5bb6\u6700\u6709\u6548\uff0c\u4ee5\u53ca\u4e3a\u4ec0\u4e48\uff1f", "answer": "Sploop.io\u4e2d\u7684\u9ad8\u7ea7\u73a9\u5bb6\u901a\u5e38\u4f9d\u8d56\u4e8e\u94bb\u77f3\u9550\u548c\u55b7\u5c04\u80cc\u5305\u3002\u94bb\u77f3\u9550\u53ef\u4ee5\u66f4\u5feb\u5730\u6316\u6398\uff0c\u800c\u55b7\u5c04\u80cc\u5305\u5219\u63d0\u4f9b\u589e\u5f3a\u7684\u79fb\u52a8\u6027\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u55b7\u5c04\u80cc\u5305\u5230\u8fbe\u9ad8\u60ac\u5d16\u53ef\u4ee5\u8ba9\u4f60\u5728\u8d44\u6e90\u6536\u96c6\u4e2d\u83b7\u5f97\u6218\u7565\u4f18\u52bf\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u867d\u7136\u94c1\u9550\u5bf9\u65b0\u624b\u6765\u8bf4\u5f88\u597d\uff0c\u4f46\u94bb\u77f3\u9550\u5bf9\u4e8e\u9ad8\u7ea7\u73a9\u5bb6\u6765\u8bf4\u662f\u5fc5\u4e0d\u53ef\u5c11\u7684\uff0c\u56e0\u4e3a\u5b83\u66f4\u9ad8\u6548\u3002]"}, {"question": "\u5982\u4f55\u5728Sploop.io\u4e2d\u4f18\u5316\u57fa\u5730\u5efa\u8bbe\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u6548\u7387\uff1f", "answer": "\u4e3a\u4e86\u5728Sploop.io\u4e2d\u4f18\u5316\u57fa\u5730\u5efa\u8bbe\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41- \u9009\u62e9\u9760\u8fd1\u4e30\u5bcc\u8d44\u6e90\u7684\u4f4d\u7f6e\u3002\u6b65\u9aa42- \u4f7f\u7528\u7f51\u683c\u5e03\u5c40\u6765\u7ec4\u7ec7\u5efa\u7b51\u7269\uff0c\u5982\u50a8\u85cf\u5355\u5143\u548c\u5236\u4f5c\u7ad9\u3002\u6b65\u9aa43- \u5347\u7ea7\u5899\u58c1\u548c\u9632\u5fa1\u5de5\u4e8b\u4ee5\u4fdd\u62a4\u514d\u53d7\u5165\u4fb5\u8005\u88ad\u51fb\u3002\u4f8b\u5982\uff0c\u5728\u68ee\u6797\u9644\u8fd1\u5efa\u9020\u786e\u4fdd\u6728\u6750\u7684\u6301\u7eed\u4f9b\u5e94\u3002[\u6d41\u7a0b\u56fe\u89e3: \u4f4d\u7f6e\u9009\u62e9\u2192\u5e03\u5c40\u89c4\u5212\u2192\u9632\u5fa1\u5347\u7ea7]"}, {"question": "Sploop.io\u4e2d\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "Sploop.io\u4e2d\u7684\u5355\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u7684\u5173\u952e\u533a\u522b\u5305\u62ec\u8d44\u6e90\u7ade\u4e89\u548c\u5408\u4f5c\u673a\u4f1a\u3002\u5728\u591a\u4eba\u6a21\u5f0f\u4e0b\uff0c\u4f60\u53ef\u4ee5\u4ea4\u6613\u8d44\u6e90\u5e76\u7ed3\u6210\u8054\u76df\uff0c\u800c\u5355\u4eba\u6a21\u5f0f\u5219\u4e13\u6ce8\u4e8e\u4e2a\u4eba\u8fdb\u6b65\u3002\u4f8b\u5982\uff0c\u5728\u591a\u4eba\u6a21\u5f0f\u4e0b\u4e0e\u4ed6\u4eba\u7ec4\u961f\u53ef\u4ee5\u5e2e\u52a9\u4f60\u5b8c\u6210\u66f4\u5927\u7684\u9879\u76ee\uff0c\u4f8b\u5982\u5efa\u9020\u4e00\u5ea7\u5821\u5792\u3002[\u914d\u7f6e\u5bf9\u7167\u8868: \u5355\u4eba\u6a21\u5f0f: \u5355\u72ec\u8fdb\u6b65\uff1b\u591a\u4eba\u6a21\u5f0f: \u4ea4\u6613\u3001\u8054\u76df\u3001\u7ade\u4e89]"}, {"question": "\u5982\u4f55\u5728Sploop.io\u4e2d\u83b7\u5f97\u201c\u5927\u5e08\u63a2\u9669\u5bb6\u201d\u6210\u5c31\uff1f", "answer": "\u4e3a\u4e86\u5728Sploop.io\u4e2d\u83b7\u5f97\u201c\u5927\u5e08\u63a2\u9669\u5bb6\u201d\u6210\u5c31\uff0c\u73a9\u5bb6\u5fc5\u987b\u63a2\u7d22\u6bcf\u4e2a\u751f\u7269\u7fa4\u843d\u5e76\u53d1\u73b0\u6240\u6709\u9690\u85cf\u533a\u57df\u3002\u6b65\u9aa41- \u9996\u5148\u7ed8\u5236\u6bcf\u4e2a\u751f\u7269\u7fa4\u843d\u7684\u56fe\u3002\u6b65\u9aa42- \u6df1\u5165\u6316\u6398\u4ee5\u53d1\u73b0\u79d8\u5bc6\u6d1e\u7a74\u3002\u6b65\u9aa43- \u4e0eNPC\u4e92\u52a8\u4ee5\u89e3\u9501\u9690\u85cf\u4efb\u52a1\u3002\u4f8b\u5982\uff0c\u627e\u5230\u9690\u85cf\u7684\u4e1b\u6797\u795e\u5e99\u53ef\u4ee5\u6210\u4e3a\u4e00\u4e2a\u91cd\u8981\u7684\u91cc\u7a0b\u7891\u3002[\u6bd4\u55bb\u8bf4\u660e: \u5c06\u6210\u5c31\u89c6\u4e3a\u4e00\u5f20\u85cf\u5b9d\u56fe\uff1b\u6bcf\u4e00\u6b21\u53d1\u73b0\u90fd\u8ba9\u4f60\u66f4\u63a5\u8fd1\u6700\u7ec8\u7684\u5b9d\u85cf\u3002]"}, {"question": "Sploop.io\u4e2d\u65b0\u73a9\u5bb6\u6700\u5e38\u89c1\u7684\u9519\u8bef\u662f\u4ec0\u4e48\uff0c\u4ee5\u53ca\u5982\u4f55\u907f\u514d\u5b83\u4eec\uff1f", "answer": "Sploop.io\u4e2d\u7684\u65b0\u73a9\u5bb6\u7ecf\u5e38\u72af\u7684\u9519\u8bef\u5305\u62ec\u5ffd\u7565\u8d44\u6e90\u7ba1\u7406\u548c\u9009\u62e9\u7cdf\u7cd5\u7684\u57fa\u5730\u4f4d\u7f6e\u3002\u4e3a\u4e86\u907f\u514d\u8fd9\u4e9b\u9519\u8bef\uff0c\u8bf7\u4e13\u6ce8\u4e8e\u5e73\u8861\u7684\u8d44\u6e90\u6536\u96c6\uff0c\u5e76\u9009\u62e9\u9760\u8fd1\u5fc5\u8981\u8d44\u6e90\u7684\u57fa\u5730\u4f4d\u7f6e\u3002\u4f8b\u5982\uff0c\u5728\u6c34\u6e90\u9644\u8fd1\u5efa\u9020\u786e\u4fdd\u7a33\u5b9a\u7684\u9c7c\u7c7b\u4f9b\u5e94\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4: \u6709\u4e9b\u73a9\u5bb6\u4f18\u5148\u8003\u8651\u901f\u5ea6\u800c\u4e0d\u662f\u7b56\u7565\uff0c\u8fd9\u901a\u5e38\u4f1a\u5bfc\u81f4\u8d44\u6e90\u77ed\u7f3a\uff1b\u5e73\u8861\u7684\u65b9\u6cd5\u66f4\u6709\u6548\u3002]"}]
[{"question": "Sploop.io\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \uc774\ud574\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sploop.io\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc744 \ube60\ub974\uac8c \uc774\ud574\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. STEP1 - WASD \ud0a4 \ub610\ub294 \ud654\uc0b4\ud45c \ud0a4\ub97c \uc0ac\uc6a9\ud558\uc5ec \uce90\ub9ad\ud130\ub97c \uc774\ub3d9\ud569\ub2c8\ub2e4. STEP2 - \uc67c\ucabd \ud074\ub9ad\ud558\uc5ec \ud30c\uace0\ub4e4\uace0 \uc624\ub978\ucabd \ud074\ub9ad\ud558\uc5ec \uac74\uc124\ud569\ub2c8\ub2e4. STEP3 - 'E' \ud0a4\ub97c \ub20c\ub7ec \uac1d\uccb4 \ub610\ub294 \ud50c\ub808\uc774\uc5b4\uc640 \uc0c1\ud638 \uc791\uc6a9\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc801\uc808\ud55c \uc704\uce58\ub97c \ud30c\uba74 \uae08\uc774\ub098 \uc720\ubb3c\uacfc \uac19\uc740 \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uc744 \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uae30\ubcf8 \uc9c0\uc2dd\uc740 \uac8c\uc784\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \ud0d0\uc0c9\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \ucee8\ud2b8\ub864\uc744 \ubcf4\ubb3c \uc0c1\uc790\uc758 \uc5f4\uc1e0\ub77c\uace0 \uc0dd\uac01\ud558\uc138\uc694. \ucee8\ud2b8\ub864\uc744 \ub9c8\uc2a4\ud130\ud558\uba74 \uac8c\uc784\uc758 \uc7a0\uc7ac\ub825\uc774 \uc5f4\ub9bd\ub2c8\ub2e4.]"}, {"question": "100\uc2dc\uac04 \uc774\uc0c1 Sploop.io\uc5d0\uc11c \ub9ac\uc18c\uc2a4 \uad00\ub9ac\ub97c \uc704\ud55c \ucd5c\uace0\uc758 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sploop.io\uc5d0\uc11c 100\uc2dc\uac04\uc774 \uc9c0\ub09c \ud6c4, \uace0\uae09 \ub9ac\uc18c\uc2a4 \uad00\ub9ac\uac00 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. STEP1 - \ub3d9\uad74\uc774\ub098 \uc9c0\ud558 \ud638\uc218\uc640 \uac19\uc774 \ub9ac\uc18c\uc2a4 \ubc00\ub3c4\uac00 \ub192\uc740 \uc9c0\uc5ed\uc744 \uc6b0\uc120\uc801\uc73c\ub85c \ud30c\uc138\uc694. STEP2 - \uc800\uc7a5\uc18c \uc720\ub2db\uacfc \uac19\uc740 \ud544\uc218 \uad6c\uc870\ubb3c\uc744 \uba3c\uc800 \uac74\uc124\ud558\uc5ec \ub9ac\uc18c\uc2a4\ub97c \ud604\uba85\ud558\uac8c \uc0ac\uc6a9\ud558\uc138\uc694. STEP3 - \ubd80\uc871\ud55c \uc544\uc774\ud15c\uacfc \uad50\ud658\ud558\uc5ec \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uc640 \uc789\uc5ec \ub9ac\uc18c\uc2a4\ub97c \uac70\ub798\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uac74\uc124 \uc790\uc7ac\uac00 \ubd80\uc871\ud55c \uacbd\uc6b0 \ub098\ubb34\ub97c \ub3cc\uacfc \uad50\ud658\ud558\ub294 \uac83\uc774 \uc720\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\ub294 \ub9ac\uc18c\uc2a4\ub97c \ucd95\uc801\ud558\ub294 \uac83\uc744 \uc120\ud638\ud558\ub294 \ubc18\uba74, \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\ub294 \uc989\uac01\uc801\uc778 \uc0ac\uc6a9\uc5d0 \uc9d1\uc911\ud569\ub2c8\ub2e4. \ud6c4\uc790\ub294 \uc885\uc885 \uc7a5\uae30\uc801\uc778 \uacb0\uacfc\ub97c \ub354 \uc88b\uac8c \ub9cc\ub4ed\ub2c8\ub2e4.]"}, {"question": "Sploop.io\uc5d0\uc11c \uc9c0\ud615 \uc0dd\uc131 \uc54c\uace0\ub9ac\uc998\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sploop.io\uc5d0\uc11c \uc9c0\ud615 \uc0dd\uc131 \uc54c\uace0\ub9ac\uc998\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \uc804\ub7b5\uc801 \uacc4\ud68d\uc744 \uc704\ud574 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc54c\uace0\ub9ac\uc998\uc740 \ub9ac\uc18c\uc2a4, \uc7a5\uc560\ubb3c \ubc0f \uc228\uaca8\uc9c4 \uc601\uc5ed\uc758 \ubc30\uce58\ub97c \uacb0\uc815\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uae08\ub9e5\uc774 \uc885\uc885 \uc6a9\uc554 \ud750\ub984 \uadfc\ucc98\uc5d0 \ub098\ud0c0\ub09c\ub2e4\ub294 \uac83\uc744 \uc54c\uba74 \ud30c\ub294 \ub178\ub825\uc744 \uc720\ub3c4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc9c0\uc2dd\uc744 \ud1b5\ud574 \ub9ac\uc18c\uc2a4 \uc704\uce58\ub97c \uc608\uce21\ud558\uace0 \uc774\ub3d9 \uacc4\ud68d\uc744 \uc138\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \uc124\uba85: \uc9c0\ud615 \uc0dd\uc131 \u2192 \ub9ac\uc18c\uc2a4 \ubc30\uce58 \u2192 \ud50c\ub808\uc774\uc5b4 \uc804\ub7b5]"}, {"question": "Sploop.io\ub294 \ud50c\ub808\uc774\uc5b4 \ub370\uc774\ud130\uc5d0 \ub300\ud55c \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud638\ud658\uc131\uc744 \uc5b4\ub5bb\uac8c \ucc98\ub9ac\ud569\ub2c8\uae4c?", "answer": "Sploop.io\ub294 \ud074\ub77c\uc6b0\ub4dc \uae30\ubc18 \ub370\uc774\ud130 \uc800\uc7a5\uc18c\ub97c \uc0ac\uc6a9\ud558\uc5ec \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud638\ud658\uc131\uc744 \ubcf4\uc7a5\ud569\ub2c8\ub2e4. \ub530\ub77c\uc11c \uac8c\uc784 \uc9c4\ud589 \uc0c1\ud669\uc740 \uc11c\ubc84\uc5d0 \uc800\uc7a5\ub418\uba70 \ubaa8\ub4e0 \uae30\uae30\uc5d0\uc11c \uc561\uc138\uc2a4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c \ud50c\ub808\uc774\ud55c \ud6c4 \ubaa8\ubc14\uc77c \uae30\uae30\ub85c \uc804\ud658\ud558\uba74 \uc778\ubca4\ud1a0\ub9ac\uc640 \uc131\ucde8\ub3c4\uac00 \uadf8\ub300\ub85c \uc720\uc9c0\ub429\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: PC \u2192 \ud074\ub77c\uc6b0\ub4dc \ub3d9\uae30\ud654 \u2192 \ubaa8\ubc14\uc77c; \ub370\uc774\ud130 \ubb34\uacb0\uc131: \ub192\uc74c]"}, {"question": "Sploop.io\uc5d0\uc11c \ud50c\ub808\uc774\uc5b4\uac00 \ubc1c\uacac\ud560 \uc218 \uc788\ub294 \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud50c\ub808\uc774\uc5b4\ub294 Sploop.io\uc5d0\uc11c \ub35c \ub208\uc5d0 \ub744\ub294 \uc9c0\uc5ed\uc744 \ud0d0\ud5d8\ud558\uc5ec \uc228\uaca8\uc9c4 \ucf58\ud150\uce20\ub97c \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc9c0\ud558 \uae4a\uc219\uc774 \ud30c\uba74 \ud76c\uadc0\ud55c \uc720\ubb3c\uc774 \uac00\ub4dd\ud55c \ube44\ubc00 \ub3d9\uad74\uc744 \ubc1c\uacac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \ud2b9\uc815 NPC\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\uba74 \uc228\uaca8\uc9c4 \ud018\uc2a4\ud2b8\ub97c \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uac8c\uc784 \uc138\uacc4\ub97c \ube59\uc0b0\uc73c\ub85c \uc0dd\uac01\ud558\uc138\uc694. \ud45c\uba74\uc5d0 \ubcf4\uc774\ub294 \uac83\uc740 \ube59\uc0b0\uc758 \uc77c\uac01\uc77c \ubfd0\uc785\ub2c8\ub2e4.]"}, {"question": "Sploop.io\uc5d0\uc11c \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \ub3c4\uad6c\ub294 \ubb34\uc5c7\uc774\uba70, \uadf8 \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sploop.io\uc5d0\uc11c \uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \uc885\uc885 \ub2e4\uc774\uc544\ubaac\ub4dc \uace1\uad2d\uc774\uc640 \uc81c\ud2b8\ud329\uc5d0 \uc758\uc874\ud569\ub2c8\ub2e4. \ub2e4\uc774\uc544\ubaac\ub4dc \uace1\uad2d\uc774\ub294 \ub354 \ube60\ub974\uac8c \ud30c\uace0\ub4e4 \uc218 \uc788\uac8c \ud574\uc8fc\uace0, \uc81c\ud2b8\ud329\uc740 \uc774\ub3d9\uc131\uc744 \ub192\uc5ec\uc90d\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc81c\ud2b8\ud329\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub192\uc740 \uc808\ubcbd\uc5d0 \ub3c4\ub2ec\ud558\uba74 \uc790\uc6d0 \uc218\uc9d1\uc5d0\uc11c \uc804\ub7b5\uc801 \uc6b0\uc704\ub97c \ud655\ubcf4\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: \ucd08\ubcf4\uc790\uc5d0\uac8c \ucca0 \uace1\uad2d\uc774\uac00 \uc88b\uc740 \ubc18\uba74, \ub2e4\uc774\uc544\ubaac\ub4dc \uace1\uad2d\uc774\ub294 \ud6a8\uc728\uc131 \ub54c\ubb38\uc5d0 \uace0\uae09 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ud544\uc218\uc801\uc785\ub2c8\ub2e4.]"}, {"question": "Sploop.io\uc5d0\uc11c \ucd5c\ub300 \ud6a8\uc728\uc744 \uc704\ud55c \uae30\uc9c0 \uac74\uc124\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sploop.io\uc5d0\uc11c \uae30\uc9c0 \uac74\uc124\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc138\uc694. STEP1 - \ud48d\ubd80\ud55c \uc790\uc6d0 \uadfc\ucc98\uc5d0 \uc704\uce58\ub97c \uc120\ud0dd\ud558\uc138\uc694. STEP2 - \uc800\uc7a5\uc18c \uc720\ub2db\uacfc \uc81c\uc791\uc18c\uc640 \uac19\uc740 \uad6c\uc870\ubb3c\uc744 \uc815\ub9ac\ud558\uc5ec \uadf8\ub9ac\ub4dc \ub808\uc774\uc544\uc6c3\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. STEP3 - \uce68\uc785\uc790\ub85c\ubd80\ud130 \ubcf4\ud638\ud558\uae30 \uc704\ud574 \ubcbd\uacfc \ubc29\uc5b4 \uc2dc\uc124\uc744 \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc232 \uadfc\ucc98\uc5d0 \uac74\uc124\ud558\uba74 \ub098\ubb34 \uacf5\uae09\uc774 \uc9c0\uc18d\uc801\uc73c\ub85c \uc720\uc9c0\ub429\ub2c8\ub2e4. [\ud504\ub85c\uc138\uc2a4 \uc124\uba85: \uc704\uce58 \uc120\ud0dd \u2192 \ub808\uc774\uc544\uc6c3 \uacc4\ud68d \u2192 \ubc29\uc5b4 \uc2dc\uc124 \uc5c5\uadf8\ub808\uc774\ub4dc]"}, {"question": "Sploop.io\uc5d0\uc11c \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sploop.io\uc5d0\uc11c \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc640 \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ubaa8\ub4dc\uc758 \uc8fc\uc694 \ucc28\uc774\uc810\uc740 \uc790\uc6d0 \uacbd\uc7c1\uacfc \ud611\ub825 \uae30\ud68c\uc785\ub2c8\ub2e4. \uba40\ud2f0\ud50c\ub808\uc774\uc5b4\uc5d0\uc11c\ub294 \ub9ac\uc18c\uc2a4\ub97c \uac70\ub798\ud558\uace0 \ub3d9\ub9f9\uc744 \ud615\uc131\ud560 \uc218 \uc788\uc9c0\ub9cc, \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4\uc5d0\uc11c\ub294 \uac1c\uc778\uc758 \uc9c4\ud589 \uc0c1\ud669\uc5d0\ub9cc \uc9d1\uc911\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uba40\ud2f0\ud50c\ub808\uc774\uc5b4\uc5d0\uc11c \ub2e4\ub978 \uc0ac\ub78c\uacfc \ud300\uc744 \uc774\ub8e8\uba74 \uc694\uc0c8 \uac74\uc124\uacfc \uac19\uc740 \ub354 \ud070 \ud504\ub85c\uc81d\ud2b8\ub97c \uc218\ud589\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131 \ube44\uad50\ud45c: \uc2f1\uae00 \ud50c\ub808\uc774\uc5b4: \uc194\ub85c \uc9c4\ud589; \uba40\ud2f0\ud50c\ub808\uc774\uc5b4: \uac70\ub798, \ub3d9\ub9f9, \uacbd\uc7c1]"}, {"question": "Sploop.io\uc5d0\uc11c '\uc219\ub828\ub41c \ud0d0\ud5d8\uac00' \uc5c5\uc801\uc744 \ub2ec\uc131\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "Sploop.io\uc5d0\uc11c '\uc219\ub828\ub41c \ud0d0\ud5d8\uac00' \uc5c5\uc801\uc744 \ub2ec\uc131\ud558\ub824\uba74 \ubaa8\ub4e0 \uc0dd\ud0dc\uacc4\ub97c \ud0d0\ud5d8\ud558\uace0 \ubaa8\ub4e0 \uc228\uaca8\uc9c4 \uc9c0\uc5ed\uc744 \ubc1c\uacac\ud574\uc57c \ud569\ub2c8\ub2e4. STEP1 - \uac01 \uc0dd\ud0dc\uacc4\ub97c \uc9c0\ub3c4\ud558\uc138\uc694. STEP2 - \uae4a\uc774 \ud30c\ub0b4\uc11c \ube44\ubc00 \ub3d9\uad74\uc744 \ucc3e\uc73c\uc138\uc694. STEP3 - NPC\uc640 \uc0c1\ud638 \uc791\uc6a9\ud558\uc5ec \uc228\uaca8\uc9c4 \ud018\uc2a4\ud2b8\ub97c \ud574\uc81c\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \uc228\uaca8\uc9c4 \uc815\uae00 \uc0ac\uc6d0\uc744 \ucc3e\ub294 \uac83\uc740 \uc911\uc694\ud55c \uc774\uc815\ud45c\uac00 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85: \uc5c5\uc801\uc744 \ubcf4\ubb3c \uc9c0\ub3c4\ub85c \uc0dd\uac01\ud558\uc138\uc694. \uac01 \ubc1c\uacac\uc740 \ucd5c\uc885 \ubcf4\uc0c1\uc5d0 \ub354 \uac00\uae4c\uc6cc\uc9d1\ub2c8\ub2e4.]"}, {"question": "Sploop.io\uc5d0\uc11c \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \ud754\ud788 \uc800\uc9c0\ub974\ub294 \uc2e4\uc218\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud53c\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "Sploop.io\uc758 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\ub294 \uc885\uc885 \ub9ac\uc18c\uc2a4 \uad00\ub9ac\ub97c \ubb34\uc2dc\ud558\uace0 \uae30\uc9c0 \uc704\uce58\ub97c \uc798\ubabb \uc120\ud0dd\ud558\ub294 \uc2e4\uc218\ub97c \uc800\uc9c0\ub985\ub2c8\ub2e4. \uc774\ub97c \ud53c\ud558\ub824\uba74 \uade0\ud615 \uc788\ub294 \uc790\uc6d0 \uc218\uc9d1\uc5d0 \uc9d1\uc911\ud558\uace0 \ud544\uc218 \uc790\uc6d0 \uadfc\ucc98\uc5d0 \uae30\uc9c0\ub97c \uac74\uc124\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ubb3c \uadfc\ucc98\uc5d0 \uac74\uc124\ud558\uba74 \ubb3c\uace0\uae30 \uacf5\uae09\uc774 \uc9c0\uc18d\uc801\uc73c\ub85c \uc720\uc9c0\ub429\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \uc804\ub7b5 \ube44\uad50: \uc77c\ubd80 \ud50c\ub808\uc774\uc5b4\ub294 \uc804\ub7b5\ubcf4\ub2e4\ub294 \uc18d\ub3c4\ub97c \uc6b0\uc120\uc2dc\ud558\uc5ec \uc885\uc885 \uc790\uc6d0 \ubd80\uc871\uc744 \ucd08\ub798\ud569\ub2c8\ub2e4. \uade0\ud615 \uc7a1\ud78c \uc811\uadfc \ubc29\uc2dd\uc774 \ub354 \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4.]"}]
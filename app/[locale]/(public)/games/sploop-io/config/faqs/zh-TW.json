[{"question": "\u5982\u4f55\u8b93\u65b0\u73a9\u5bb6\u5feb\u901f\u4e86\u89e3 Sploop.io \u7684\u57fa\u672c\u63a7\u5236\uff1f", "answer": "\u8981\u5feb\u901f\u638c\u63e1 Sploop.io \u7684\u57fa\u672c\u63a7\u5236\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u4f7f\u7528 WASD \u9375\u6216\u65b9\u5411\u9375\u79fb\u52d5\u89d2\u8272\u3002\u6b65\u9a5f2 - \u5de6\u9375\u9ede\u64ca\u6316\u6398\uff0c\u53f3\u9375\u9ede\u64ca\u5efa\u9020\u3002\u6b65\u9a5f3 - \u6309 \"E\" \u9375\u8207\u7269\u4ef6\u6216\u73a9\u5bb6\u4e92\u52d5\u3002\u4f8b\u5982\uff0c\u5728\u6b63\u78ba\u7684\u5730\u9ede\u6316\u6398\u53ef\u4ee5\u767c\u73fe\u96b1\u85cf\u7684\u5bf6\u85cf\uff0c\u5982\u9ec3\u91d1\u6216\u6587\u7269\u3002\u9019\u9805\u57fa\u790e\u77e5\u8b58\u5c07\u6709\u52a9\u65bc\u60a8\u6709\u6548\u5730\u700f\u89bd\u904a\u6232\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u63a7\u5236\u9375\u60f3\u50cf\u6210\u5bf6\u7bb1\u9470\u5319\uff1b\u638c\u63e1\u5b83\u5011\u5c07\u89e3\u9396\u904a\u6232\u7684\u6f5b\u529b\u3002]"}, {"question": "\u5728 Sploop.io \u904a\u6232\u73a9\u4e86 100 \u5c0f\u6642\u5f8c\uff0c\u6700\u4f73\u7684\u8cc7\u6e90\u7ba1\u7406\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728 Sploop.io \u904a\u6232\u73a9\u4e86 100 \u5c0f\u6642\u5f8c\uff0c\u5148\u9032\u7684\u8cc7\u6e90\u7ba1\u7406\u81f3\u95dc\u91cd\u8981\u3002\u6b65\u9a5f1 - \u512a\u5148\u5728\u8cc7\u6e90\u5bc6\u5ea6\u9ad8\u7684\u5340\u57df\u6316\u6398\uff0c\u4f8b\u5982\u6d1e\u7a74\u6216\u5730\u4e0b\u6e56\u6cca\u3002\u6b65\u9a5f2 - \u8070\u660e\u5730\u4f7f\u7528\u8cc7\u6e90\uff0c\u9996\u5148\u5efa\u9020\u5fc5\u8981\u7684\u8a2d\u65bd\uff0c\u4f8b\u5982\u5132\u5b58\u55ae\u4f4d\u3002\u6b65\u9a5f3 - \u8207\u5176\u4ed6\u73a9\u5bb6\u4ea4\u6613\u591a\u9918\u7684\u8cc7\u6e90\u4ee5\u53d6\u5f97\u60a8\u7f3a\u4e4f\u7684\u7269\u54c1\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5efa\u7bc9\u6750\u6599\u4e0d\u8db3\uff0c\u4ea4\u6613\u6728\u6750\u63db\u77f3\u982d\u6703\u6709\u76ca\u8655\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u6709\u4e9b\u73a9\u5bb6\u559c\u6b61\u56e4\u7a4d\u8cc7\u6e90\uff0c\u800c\u53e6\u4e00\u4e9b\u5247\u5c08\u6ce8\u65bc\u7acb\u5373\u4f7f\u7528\uff1b\u5f8c\u8005\u901a\u5e38\u6703\u7372\u5f97\u66f4\u597d\u7684\u9577\u671f\u7d50\u679c\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u4e86\u89e3 Sploop.io \u7684\u5730\u5f62\u751f\u6210\u6f14\u7b97\u6cd5\u5f88\u91cd\u8981\uff1f", "answer": "\u4e86\u89e3 Sploop.io \u7684\u5730\u5f62\u751f\u6210\u6f14\u7b97\u6cd5\u5c0d\u65bc\u7b56\u7565\u898f\u5283\u81f3\u95dc\u91cd\u8981\u3002\u6f14\u7b97\u6cd5\u6c7a\u5b9a\u8cc7\u6e90\u3001\u969c\u7919\u7269\u548c\u96b1\u85cf\u5340\u57df\u7684\u4f48\u5c40\u3002\u4f8b\u5982\uff0c\u77e5\u9053\u9ec3\u91d1\u7926\u8108\u901a\u5e38\u51fa\u73fe\u5728\u7194\u5ca9\u6d41\u9644\u8fd1\uff0c\u53ef\u4ee5\u6307\u5c0e\u60a8\u7684\u6316\u6398\u5de5\u4f5c\u3002\u9019\u9805\u77e5\u8b58\u8b93\u60a8\u53ef\u4ee5\u9810\u6e2c\u8cc7\u6e90\u4f4d\u7f6e\u4e26\u76f8\u61c9\u5730\u898f\u5283\u52d5\u4f5c\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u5730\u5f62\u751f\u6210 \u2192 \u8cc7\u6e90\u653e\u7f6e \u2192 \u73a9\u5bb6\u7b56\u7565]"}, {"question": "Sploop.io \u5982\u4f55\u8655\u7406\u8de8\u5e73\u53f0\u7684\u73a9\u5bb6\u8cc7\u6599\u76f8\u5bb9\u6027\uff1f", "answer": "Sploop.io \u901a\u904e\u4f7f\u7528\u96f2\u7aef\u8cc7\u6599\u5132\u5b58\u78ba\u4fdd\u8de8\u5e73\u53f0\u76f8\u5bb9\u6027\u3002\u9019\u8868\u793a\u60a8\u7684\u904a\u6232\u9032\u5ea6\u6703\u5132\u5b58\u5728\u4f3a\u670d\u5668\u4e0a\uff0c\u4e14\u53ef\u4ee5\u5f9e\u4efb\u4f55\u88dd\u7f6e\u5b58\u53d6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728 PC \u4e0a\u904a\u73a9\uff0c\u7136\u5f8c\u5207\u63db\u5230\u884c\u52d5\u88dd\u7f6e\uff0c\u60a8\u7684\u7269\u54c1\u5eab\u548c\u6210\u5c31\u5c07\u4fdd\u6301\u4e0d\u8b8a\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1aPC \u2192 \u96f2\u7aef\u540c\u6b65 \u2192\u884c\u52d5\u88dd\u7f6e\uff1b \u8cc7\u6599\u5b8c\u6574\u6027\uff1a\u9ad8]"}, {"question": "\u73a9\u5bb6\u5728 Sploop.io \u53ef\u4ee5\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u5167\u5bb9\uff0c\u4ee5\u53ca\u5982\u4f55\u627e\u5230\u5b83\u5011\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u900f\u904e\u63a2\u7d22\u4e0d\u592a\u986f\u773c\u7684\u5730\u5340\u4f86\u767c\u73fe Sploop.io \u4e2d\u7684\u96b1\u85cf\u5167\u5bb9\u3002\u4f8b\u5982\uff0c\u6df1\u5165\u6316\u6398\u5730\u4e0b\uff0c\u53ef\u80fd\u6703\u767c\u73fe\u5145\u6eff\u7a00\u6709\u6587\u7269\u7684\u79d8\u5bc6\u6d1e\u7a74\u3002\u6b64\u5916\uff0c\u8207\u67d0\u4e9b NPC \u4e92\u52d5\u53ef\u4ee5\u89e3\u9396\u96b1\u85cf\u7684\u4efb\u52d9\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u904a\u6232\u4e16\u754c\u60f3\u50cf\u6210\u4e00\u5ea7\u51b0\u5c71\uff1b\u60a8\u5728\u8868\u9762\u770b\u5230\u7684\u53ea\u662f\u51b0\u5c71\u4e00\u89d2\u3002]"}, {"question": "\u54ea\u4e9b\u5de5\u5177\u5c0d\u65bc Sploop.io \u7684\u9ad8\u7d1a\u73a9\u5bb6\u4f86\u8aaa\u6700\u6709\u6548\uff0c\u70ba\u4ec0\u9ebc\uff1f", "answer": "Sploop.io \u7684\u9ad8\u7d1a\u73a9\u5bb6\u901a\u5e38\u4f9d\u8cf4\u947d\u77f3\u93df\u548c\u5674\u5c04\u80cc\u5305\u3002\u947d\u77f3\u93df\u53ef\u4ee5\u8b93\u6316\u6398\u901f\u5ea6\u66f4\u5feb\uff0c\u800c\u5674\u5c04\u80cc\u5305\u5247\u63d0\u4f9b\u589e\u5f37\u7684\u884c\u52d5\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u5674\u5c04\u80cc\u5305\u5230\u9054\u9ad8\u8655\u61f8\u5d16\u53ef\u4ee5\u8b93\u60a8\u5728\u8cc7\u6e90\u6536\u96c6\u65b9\u9762\u7372\u5f97\u7b56\u7565\u512a\u52e2\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u96d6\u7136\u9435\u93df\u9069\u5408\u521d\u5b78\u8005\uff0c\u4f46\u947d\u77f3\u93df\u5c0d\u65bc\u9ad8\u7d1a\u73a9\u5bb6\u4f86\u8aaa\u537b\u662f\u4e0d\u53ef\u6216\u7f3a\u7684\uff0c\u56e0\u70ba\u5b83\u6548\u7387\u66f4\u9ad8\u3002]"}, {"question": "\u5982\u4f55\u512a\u5316 Sploop.io \u7684\u57fa\u5730\u5efa\u7bc9\u4ee5\u9054\u5230\u6700\u5927\u6548\u7387\uff1f", "answer": "\u8981\u512a\u5316 Sploop.io \u7684\u57fa\u5730\u5efa\u7bc9\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1 - \u9078\u64c7\u9760\u8fd1\u8c50\u5bcc\u8cc7\u6e90\u7684\u4f4d\u7f6e\u3002\u6b65\u9a5f2 - \u4f7f\u7528\u7db2\u683c\u4f48\u5c40\u4f86\u7d44\u7e54\u50cf\u662f\u5132\u5b58\u55ae\u4f4d\u548c\u5de5\u85dd\u7ad9\u7b49\u5efa\u7bc9\u7269\u3002\u6b65\u9a5f3 - \u5347\u7d1a\u570d\u7246\u548c\u9632\u79a6\u8a2d\u65bd\u4ee5\u62b5\u79a6\u5165\u4fb5\u8005\u3002\u4f8b\u5982\uff0c\u5728\u68ee\u6797\u9644\u8fd1\u5efa\u9020\u53ef\u4ee5\u78ba\u4fdd\u7a69\u5b9a\u4f9b\u61c9\u6728\u6750\u3002[\u6d41\u7a0b\u5716\u89e3\uff1a\u4f4d\u7f6e\u9078\u64c7 \u2192 \u4f48\u5c40\u898f\u5283 \u2192 \u9632\u79a6\u5347\u7d1a]"}, {"question": "\u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u5728 Sploop.io \u4e2d\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "Sploop.io \u55ae\u4eba\u6a21\u5f0f\u548c\u591a\u4eba\u6a21\u5f0f\u7684\u4e3b\u8981\u5dee\u7570\u5728\u65bc\u8cc7\u6e90\u7af6\u722d\u548c\u5408\u4f5c\u7684\u6a5f\u6703\u3002\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\uff0c\u60a8\u53ef\u4ee5\u4ea4\u6613\u8cc7\u6e90\u4e26\u7d44\u6210\u806f\u76df\uff0c\u800c\u55ae\u4eba\u6a21\u5f0f\u5247\u50c5\u5c08\u6ce8\u65bc\u500b\u4eba\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u5728\u591a\u4eba\u6a21\u5f0f\u4e2d\u8207\u5176\u4ed6\u4eba\u7d44\u968a\u53ef\u4ee5\u5354\u52a9\u60a8\u5b8c\u6210\u66f4\u5927\u898f\u6a21\u7684\u8a08\u756b\uff0c\u4f8b\u5982\u5efa\u9020\u5821\u58d8\u3002[\u914d\u7f6e\u5c0d\u7167\u8868\uff1a\u55ae\u4eba\u6a21\u5f0f\uff1a\u55ae\u4eba\u9032\u5ea6\uff1b\u591a\u4eba\u6a21\u5f0f\uff1a\u4ea4\u6613\u3001\u806f\u76df\u3001\u7af6\u722d]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728 Sploop.io \u4e2d\u9054\u6210 \"\u5927\u5e2b\u63a2\u96aa\u5bb6\" \u7684\u6210\u5c31\uff1f", "answer": "\u8981\u9054\u6210 Sploop.io \u4e2d\u7684\u300c\u5927\u5e2b\u63a2\u96aa\u5bb6\u300d\u6210\u5c31\uff0c\u73a9\u5bb6\u5fc5\u9808\u63a2\u7d22\u6bcf\u500b\u751f\u7269\u7fa4\u7cfb\u4e26\u767c\u73fe\u6240\u6709\u96b1\u85cf\u5340\u57df\u3002\u6b65\u9a5f 1 - \u5148\u5c07\u6bcf\u500b\u751f\u7269\u7fa4\u7cfb\u88fd\u4f5c\u5730\u5716\u3002\u6b65\u9a5f 2 - \u6df1\u5ea6\u6316\u6398\u4ee5\u767c\u73fe\u79d8\u5bc6\u6d1e\u7a74\u3002\u6b65\u9a5f 3 - \u8207 NPC \u4e92\u52d5\u4ee5\u89e3\u9396\u96b1\u85cf\u4efb\u52d9\u3002\u4f8b\u5982\uff0c\u627e\u5230\u96b1\u85cf\u7684\u71b1\u5e36\u96e8\u6797\u5bfa\u5edf\u53ef\u4ee5\u662f\u4e00\u500b\u91cd\u8981\u7684\u91cc\u7a0b\u7891\u3002[\u6bd4\u55bb\u8aaa\u660e\uff1a\u5c07\u8a72\u6210\u5c31\u60f3\u50cf\u6210\u4e00\u5f35\u85cf\u5bf6\u5716\uff1b\u6bcf\u4e00\u6b21\u767c\u73fe\u90fd\u8b93\u60a8\u66f4\u63a5\u8fd1\u6700\u7d42\u7684\u734e\u52f5\u3002]"}, {"question": "\u65b0\u73a9\u5bb6\u5728 Sploop.io \u6700\u5e38\u898b\u7684\u932f\u8aa4\u6709\u54ea\u4e9b\uff0c\u4ee5\u53ca\u5982\u4f55\u907f\u514d\u5b83\u5011\uff1f", "answer": "Sploop.io \u7684\u65b0\u73a9\u5bb6\u5e38\u5e38\u72af\u7684\u932f\u8aa4\u5305\u62ec\u5ffd\u8996\u8cc7\u6e90\u7ba1\u7406\u548c\u9078\u64c7\u4e0d\u597d\u7684\u57fa\u5730\u4f4d\u7f6e\u3002\u70ba\u4e86\u907f\u514d\u9019\u4e9b\u932f\u8aa4\uff0c\u8acb\u5c08\u6ce8\u65bc\u5e73\u8861\u7684\u8cc7\u6e90\u6536\u96c6\uff0c\u4e26\u9078\u64c7\u9760\u8fd1\u91cd\u8981\u8cc7\u6e90\u7684\u57fa\u5730\u4f4d\u7f6e\u3002\u4f8b\u5982\uff0c\u5728\u6c34\u6e90\u9644\u8fd1\u5efa\u9020\u53ef\u4ee5\u78ba\u4fdd\u7a69\u5b9a\u4f9b\u61c9\u9b5a\u985e\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4\uff1a\u6709\u4e9b\u73a9\u5bb6\u512a\u5148\u8003\u616e\u901f\u5ea6\u800c\u4e0d\u662f\u7b56\u7565\uff0c\u9019\u5f80\u5f80\u5c0e\u81f4\u8cc7\u6e90\u77ed\u7f3a\uff1b\u5e73\u8861\u7684\u65b9\u6cd5\u66f4\u6709\u6548\u3002]"}]
[{"question": "\u5982\u4f55\u4ece\u5165\u95e8\u8005\u7684\u89d2\u5ea6\u5f00\u59cb\u5b66\u4e60\u87ba\u4e1d\u76ca\u667a\u62fc\u56fe - DIY \u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u5f00\u59cb\u4f7f\u7528\u87ba\u4e1d\u76ca\u667a\u62fc\u56fe - DIY\uff0c\u9996\u5148\u8981\u719f\u6089\u6838\u5fc3\u673a\u5236\u3002\u4ece\u9009\u62e9\u62fc\u56fe\u90e8\u4ef6\u5e76\u5c06\u5176\u62d6\u653e\u5230\u6b63\u786e\u4f4d\u7f6e\u5f00\u59cb\u3002\u4f8b\u5982\uff0c\u5728\u201c\u7b80\u5355\u6a21\u5f0f\u201d\u6559\u7a0b\u4e2d\uff0c\u4f60\u4f1a\u9047\u5230\u4e00\u4e2a\u7b80\u5355\u7684 5 \u5757\u62fc\u56fe\uff0c\u5176\u4e2d\u6bcf\u4e2a\u90e8\u4ef6\u90fd\u80fd\u5361\u5165\u5230\u4f4d\u3002\u4f7f\u7528\u4f4d\u4e8e\u5de6\u4e0b\u89d2\u7684\u65cb\u8f6c\u5de5\u5177\u8c03\u6574\u90e8\u4ef6\u7684\u89d2\u5ea6\u3002\u6b65\u9aa4 1\uff1a\u9009\u62e9\u4e00\u4e2a\u90e8\u4ef6\u3002\u6b65\u9aa4 2\uff1a\u5982\u6709\u5fc5\u8981\uff0c\u65cb\u8f6c\u5b83\u3002\u6b65\u9aa4 3\uff1a\u5c06\u5176\u62d6\u653e\u5230\u7a81\u51fa\u663e\u793a\u7684\u533a\u57df\u4e2d\u3002\u8fd9\u4e2a\u57fa\u7840\u6d41\u7a0b\u5c06\u5e2e\u52a9\u4f60\u5efa\u7acb\u4fe1\u5fc3\uff0c\u7136\u540e\u518d\u5e94\u5bf9\u66f4\u590d\u6742\u7684\u62fc\u56fe\u3002"}, {"question": "\u5728\u87ba\u4e1d\u76ca\u667a\u62fc\u56fe - DIY \u4e2d\u89e3\u51b3\u9ad8\u7ea7\u62fc\u56fe\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u5bf9\u4e8e\u87ba\u4e1d\u76ca\u667a\u62fc\u56fe - DIY \u4e2d\u7684\u9ad8\u7ea7\u62fc\u56fe\uff0c\u8bf7\u91c7\u7528\u7cfb\u7edf\u7684\u65b9\u6cd5\u3002\u6b65\u9aa4 1\uff1a\u6309\u989c\u8272\u6216\u56fe\u6848\u5bf9\u90e8\u4ef6\u5206\u7c7b\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5de5\u4e1a\u6311\u6218\u201d\u7ea7\u522b\u4e2d\uff0c\u5c06\u5177\u6709\u76f8\u4f3c\u7eb9\u7406\u7684\u90e8\u4ef6\u5206\u7ec4\u53ef\u4ee5\u8282\u7701\u65f6\u95f4\u3002\u6b65\u9aa4 2\uff1a\u9996\u5148\u5173\u6ce8\u8fb9\u7f18\uff0c\u56e0\u4e3a\u5b83\u4eec\u63d0\u4f9b\u4e86\u6846\u67b6\u3002\u6b65\u9aa4 3\uff1a\u4f7f\u7528\u7f29\u653e\u529f\u80fd\u4ed4\u7ec6\u68c0\u67e5\u7ec6\u8282\u3002\u6b64\u5916\uff0c\u5c1d\u8bd5\u4f7f\u7528\u201c\u9884\u89c8\u6a21\u5f0f\u201d\u6765\u53ef\u89c6\u5316\u6700\u7ec8\u56fe\u50cf\u3002\u8fd9\u79cd\u7b56\u7565\uff0c\u7ed3\u5408\u8010\u5fc3\uff0c\u5c06\u663e\u8457\u63d0\u9ad8\u4f60\u7684\u89e3\u51b3\u6548\u7387\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u87ba\u4e1d\u76ca\u667a\u62fc\u56fe - DIY \u5305\u542b\u65cb\u8f6c\u529f\u80fd\uff0c\u4ee5\u53ca\u5982\u4f55\u6709\u6548\u5730\u4f7f\u7528\u5b83\uff1f", "answer": "\u87ba\u4e1d\u76ca\u667a\u62fc\u56fe - DIY \u4e2d\u7684\u65cb\u8f6c\u529f\u80fd\u5bf9\u4e8e\u51c6\u786e\u5bf9\u9f50\u90e8\u4ef6\u81f3\u5173\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5728\u201c\u673a\u68b0\u5947\u89c2\u201d\u62fc\u56fe\u4e2d\uff0c\u67d0\u4e9b\u90e8\u4ef6\u9700\u8981\u65cb\u8f6c 90 \u5ea6\u624d\u80fd\u88c5\u914d\u3002\u4e3a\u4e86\u6709\u6548\u5730\u4f7f\u7528\u5b83\uff0c\u6b65\u9aa4 1\uff1a\u9009\u62e9\u90e8\u4ef6\u3002\u6b65\u9aa4 2\uff1a\u70b9\u51fb\u65cb\u8f6c\u6309\u94ae\u6216\u4f7f\u7528\u5feb\u6377\u952e (R \u952e)\u3002\u6b65\u9aa4 3\uff1a\u8c03\u6574\u89d2\u5ea6\uff0c\u76f4\u5230\u5b83\u4e0e\u5468\u56f4\u90e8\u4ef6\u5bf9\u9f50\u3002\u6b64\u5de5\u5177\u5bf9\u4e8e\u8bbe\u8ba1\u590d\u6742\u7684\u62fc\u56fe\u5c24\u5176\u6709\u7528\uff0c\u786e\u4fdd\u65e0\u7f1d\u8d34\u5408\u3002"}, {"question": "\u87ba\u4e1d\u76ca\u667a\u62fc\u56fe - DIY \u4e2d\u7684\u5206\u6570\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u4f1a\u5f71\u54cd\u5b83\uff1f", "answer": "\u87ba\u4e1d\u76ca\u667a\u62fc\u56fe - DIY \u4e2d\u7684\u5206\u6570\u7cfb\u7edf\u57fa\u4e8e\u4e09\u4e2a\u4e3b\u8981\u56e0\u7d20\uff1a\u65f6\u95f4\u3001\u51c6\u786e\u6027\u548c\u6548\u7387\u3002\u4f8b\u5982\uff0c\u5728 10 \u5206\u949f\u5185\u5b8c\u6210\u201c\u673a\u68b0\u6311\u6218\u201d\u4e14\u6ca1\u6709\u9519\u8bef\u653e\u7f6e\uff0c\u5373\u53ef\u83b7\u5f97\u5b8c\u7f8e\u5206\u6570\u3002\u65f6\u95f4\u662f\u4e3b\u8981\u6307\u6807\uff0c\u4f46\u51c6\u786e\u6027\uff08\u901a\u8fc7\u6b63\u786e\u653e\u7f6e\u6d4b\u91cf\uff09\u548c\u6548\u7387\uff08\u6700\u5c0f\u65cb\u8f6c\uff09\u4e5f\u8d77\u7740\u91cd\u8981\u4f5c\u7528\u3002\u6e38\u620f\u4f7f\u7528\u52a0\u6743\u516c\u5f0f\uff1a\u5206\u6570 = (1000 - \u79d2\u6570) + (\u51c6\u786e\u6027 * 10) - (\u65cb\u8f6c\u6b21\u6570 * 2)\u3002\u7406\u89e3\u8fd9\u4e2a\u7cfb\u7edf\u53ef\u4ee5\u5e2e\u52a9\u4f60\u4f18\u5316\u4f60\u7684\u8868\u73b0\u3002"}, {"question": "\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e0a\u8fd0\u884c\u87ba\u4e1d\u76ca\u667a\u62fc\u56fe - DIY \u9700\u8981\u54ea\u4e9b\u6280\u672f\u8981\u6c42\uff1f", "answer": "\u87ba\u4e1d\u76ca\u667a\u62fc\u56fe - DIY \u8bbe\u8ba1\u4e3a\u53ef\u5728\u591a\u4e2a\u5e73\u53f0\u4e0a\u517c\u5bb9\u3002\u5bf9\u4e8e PC\uff0c\u5b83\u9700\u8981 Windows 10\u30014GB \u5185\u5b58\u548c DirectX 11 \u517c\u5bb9\u663e\u5361\u3002\u5728\u79fb\u52a8\u8bbe\u5907\u4e0a\uff0c\u5b83\u652f\u6301 iOS 12+ \u548c Android 8.0+\uff0c\u5185\u5b58\u4e3a 2GB\u3002\u6e38\u620f\u7684\u4e91\u4fdd\u5b58\u529f\u80fd\u786e\u4fdd\u4e86\u8bbe\u5907\u4e4b\u95f4\u65e0\u7f1d\u7684\u6570\u636e\u8fc1\u79fb\u3002\u4f8b\u5982\uff0c\u4f60\u53ef\u4ee5\u5728 iPhone \u4e0a\u5f00\u59cb\u62fc\u56fe\uff0c\u5e76\u5728 Windows PC \u4e0a\u7ee7\u7eed\uff0c\u800c\u4e0d\u4f1a\u4e22\u5931\u8fdb\u5ea6\u3002\u8bf7\u59cb\u7ec8\u786e\u4fdd\u60a8\u7684\u8bbe\u5907\u7b26\u5408\u8fd9\u4e9b\u89c4\u683c\uff0c\u4ee5\u83b7\u5f97\u6700\u4f73\u6027\u80fd\u3002"}, {"question": "\u87ba\u4e1d\u76ca\u667a\u62fc\u56fe - DIY \u4e2d\u54ea\u4e9b\u5de5\u5177\u6700\u9002\u5408\u89e3\u51b3\u590d\u6742\u62fc\u56fe\uff0c\u4ee5\u53ca\u5b83\u4eec\u7684\u529f\u80fd\u662f\u4ec0\u4e48\uff1f", "answer": "\u87ba\u4e1d\u76ca\u667a\u62fc\u56fe - DIY \u63d0\u4f9b\u4e86\u4e00\u4e9b\u5de5\u5177\u6765\u5e2e\u52a9\u89e3\u51b3\u590d\u6742\u7684\u62fc\u56fe\u3002\"\u8fb9\u7f18\u67e5\u627e\u5668\" \u7a81\u51fa\u663e\u793a\u8fb9\u754c\u90e8\u4ef6\uff0c\"\u989c\u8272\u5339\u914d\u5668\" \u5c06\u76f8\u4f3c\u8272\u8c03\u7684\u90e8\u4ef6\u5206\u7ec4\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5f69\u8679\u8c1c\u9898\u201d\u62fc\u56fe\u4e2d\uff0c\u201c\u989c\u8272\u5339\u914d\u5668\u201d\u53ef\u4ee5\u9694\u79bb\u6240\u6709\u84dd\u8272\u90e8\u4ef6\uff0c\u7b80\u5316\u4e86\u8fc7\u7a0b\u3002\u6b65\u9aa4 1\uff1a\u6fc0\u6d3b\u201c\u8fb9\u7f18\u67e5\u627e\u5668\u201d\u6765\u6846\u67b6\u62fc\u56fe\u3002\u6b65\u9aa4 2\uff1a\u4f7f\u7528\u201c\u989c\u8272\u5339\u914d\u5668\u201d\u5bf9\u90e8\u4ef6\u8fdb\u884c\u5206\u7c7b\u3002\u6b65\u9aa4 3\uff1a\u4f7f\u7528\u201c\u653e\u5927\u955c\u201d\u68c0\u67e5\u7ec6\u8282\u3002\u8fd9\u4e9b\u5de5\u5177\u7ed3\u5408\u4f7f\u7528\u53ef\u4ee5\u663e\u8457\u7f29\u77ed\u89e3\u51b3\u65f6\u95f4\u3002"}, {"question": "\u5982\u4f55\u5728\u87ba\u4e1d\u76ca\u667a\u62fc\u56fe - DIY \u4e2d\u89e3\u9501\u9690\u85cf\u5173\u5361\uff0c\u4ee5\u53ca\u5b83\u4eec\u72ec\u7279\u7684\u6311\u6218\u662f\u4ec0\u4e48\uff1f", "answer": "\u87ba\u4e1d\u76ca\u667a\u62fc\u56fe - DIY \u4e2d\u7684\u9690\u85cf\u5173\u5361\u53ef\u4ee5\u901a\u8fc7\u5728\u7279\u5b9a\u62fc\u56fe\u4e2d\u83b7\u5f97\u9ad8\u5206\u6765\u89e3\u9501\u3002\u4f8b\u5982\uff0c\u5728\u201c\u9f7f\u8f6e\u7cbe\u901a\u201d\u7ea7\u522b\u4e2d\u83b7\u5f97 950 \u4ee5\u4e0a\u7684\u5206\u6570\u5c06\u89e3\u9501\u201c\u9690\u85cf\u8f66\u95f4\u201d\u3002\u8fd9\u4e9b\u5173\u5361\u901a\u5e38\u5177\u6709\u72ec\u7279\u7684\u6311\u6218\uff0c\u4f8b\u5982\u4e0d\u89c4\u5219\u7684\u90e8\u4ef6\u5f62\u72b6\u6216\u65f6\u95f4\u9650\u5236\u3002\u8981\u89e3\u9501\u5b83\u4eec\uff0c\u8bf7\u4e13\u6ce8\u4e8e\u4f18\u5316\u6807\u51c6\u5173\u5361\u4e2d\u7684\u8868\u73b0\u3002\u89e3\u9501\u540e\uff0c\u8bf7\u505a\u597d\u51c6\u5907\u8fce\u63a5\u6d4b\u8bd5\u4f60\u7684\u7cbe\u786e\u6027\u548c\u9002\u5e94\u80fd\u529b\u7684\u62fc\u56fe\uff0c\u63d0\u4f9b\u65b0\u9c9c\u800c\u6709\u76ca\u7684\u4f53\u9a8c\u3002"}, {"question": "\u87ba\u4e1d\u76ca\u667a\u62fc\u56fe - DIY \u4e2d\u7684\u7b80\u5355\u6a21\u5f0f\u548c\u56f0\u96be\u6a21\u5f0f\u6709\u4ec0\u4e48\u5173\u952e\u533a\u522b\uff1f", "answer": "\u87ba\u4e1d\u76ca\u667a\u62fc\u56fe - DIY \u4e2d\u7684\u7b80\u5355\u6a21\u5f0f\u548c\u56f0\u96be\u6a21\u5f0f\u7684\u4e3b\u8981\u533a\u522b\u5728\u4e8e\u62fc\u56fe\u7684\u590d\u6742\u6027\u548c\u65f6\u95f4\u9650\u5236\u3002\u7b80\u5355\u6a21\u5f0f\u5305\u542b\u8f83\u5c11\u7684\u90e8\u4ef6\uff0c\u5e76\u4e14\u6ca1\u6709\u65f6\u95f4\u9650\u5236\uff0c\u975e\u5e38\u9002\u5408\u521d\u5b66\u8005\u3002\u4f8b\u5982\uff0c\u201c\u57fa\u672c\u6784\u5efa\u201d\u62fc\u56fe\u6709 10 \u4e2a\u90e8\u4ef6\uff0c\u65f6\u95f4\u4e0d\u53d7\u9650\u5236\u3002\u53e6\u4e00\u65b9\u9762\uff0c\u56f0\u96be\u6a21\u5f0f\u5305\u542b\u66f4\u591a\u90e8\u4ef6\uff0c\u5e76\u4e14\u6709\u4e00\u4e2a\u5012\u8ba1\u65f6\u5668\u3002\u5728\u201c\u8ba1\u65f6\u8bd5\u9a8c\u201d\u62fc\u56fe\u4e2d\uff0c\u4f60\u5fc5\u987b\u5728 15 \u5206\u949f\u5185\u89e3\u51b3\u4e00\u4e2a 50 \u5757\u7684\u62fc\u56fe\u3002\u8fd9\u4e9b\u6a21\u5f0f\u8fce\u5408\u4e0d\u540c\u7684\u6280\u80fd\u7ea7\u522b\uff0c\u4e3a\u6240\u6709\u73a9\u5bb6\u63d0\u4f9b\u91cf\u8eab\u5b9a\u5236\u7684\u6311\u6218\u3002"}, {"question": "\u5982\u4f55\u5728\u4e0d\u5f71\u54cd\u8d28\u91cf\u7684\u60c5\u51b5\u4e0b\u63d0\u9ad8\u87ba\u4e1d\u76ca\u667a\u62fc\u56fe - DIY \u4e2d\u7684\u901f\u5ea6\u548c\u51c6\u786e\u6027\uff1f", "answer": "\u63d0\u9ad8\u87ba\u4e1d\u76ca\u667a\u62fc\u56fe - DIY \u4e2d\u7684\u901f\u5ea6\u548c\u51c6\u786e\u6027\u9700\u8981\u7ec3\u4e60\u548c\u7b56\u7565\u3002\u6b65\u9aa4 1\uff1a\u719f\u6089\u5e38\u89c1\u7684\u90e8\u4ef6\u5f62\u72b6\u548c\u56fe\u6848\u3002\u4f8b\u5982\uff0c\u5728\u201c\u5feb\u901f\u4fee\u590d\u201d\u62fc\u56fe\u4e2d\uff0c\u8bc6\u522b L \u5f62\u90e8\u4ef6\u53ef\u4ee5\u8282\u7701\u65f6\u95f4\u3002\u6b65\u9aa4 2\uff1a\u4f7f\u7528\u201c\u8fb9\u7f18\u67e5\u627e\u5668\u201d\u5feb\u901f\u5efa\u7acb\u62fc\u56fe\u7684\u8fb9\u754c\u3002\u6b65\u9aa4 3\uff1a\u907f\u514d\u8fc7\u591a\u7684\u65cb\u8f6c\uff0c\u9884\u5148\u8ba1\u5212\u653e\u7f6e\u3002\u6b64\u5916\uff0c\u5b9a\u671f\u7ec3\u4e60\u5c06\u589e\u5f3a\u4f60\u7684\u808c\u8089\u8bb0\u5fc6\uff0c\u4ece\u800c\u5b9e\u73b0\u66f4\u5feb\u3001\u66f4\u7cbe\u786e\u7684\u62fc\u56fe\u89e3\u51b3\uff0c\u800c\u4e0d\u4f1a\u727a\u7272\u8d28\u91cf\u3002"}, {"question": "\u638c\u63e1\u87ba\u4e1d\u76ca\u667a\u62fc\u56fe - DIY \u7684\u4e00\u4e9b\u9c9c\u4e3a\u4eba\u77e5\u7684\u6280\u5de7\u548c\u7a8d\u95e8\u662f\u4ec0\u4e48\uff1f", "answer": "\u638c\u63e1\u87ba\u4e1d\u76ca\u667a\u62fc\u56fe - DIY \u5305\u62ec\u53d1\u73b0\u9c9c\u4e3a\u4eba\u77e5\u7684\u6280\u5de7\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u201c\u653e\u5927\u955c\u201d\u5de5\u5177\u53ef\u4ee5\u63ed\u793a\u90e8\u4ef6\u4e0a\u7684\u7ec6\u5fae\u7ec6\u8282\uff0c\u6709\u52a9\u4e8e\u653e\u7f6e\u3002\u53e6\u4e00\u4e2a\u6280\u5de7\u662f\u9996\u5148\u5173\u6ce8\u72ec\u7279\u7684\u56fe\u6848\u6216\u989c\u8272\uff0c\u56e0\u4e3a\u5b83\u4eec\u66f4\u5bb9\u6613\u8bc6\u522b\u3002\u5728\u201c\u56fe\u6848\u62fc\u56fe\u201d\u4e2d\uff0c\u9996\u5148\u4ece\u6700\u660e\u663e\u7684\u90e8\u4ef6\u5f00\u59cb\u53ef\u4ee5\u7b80\u5316\u8fc7\u7a0b\u3002\u6b64\u5916\uff0c\u77ed\u6682\u4f11\u606f\u53ef\u4ee5\u5237\u65b0\u4f60\u7684\u89c6\u89d2\uff0c\u63d0\u9ad8\u6574\u4f53\u6548\u7387\u3002\u8fd9\u4e9b\u5c0f\u800c\u6709\u6548\u7684\u7b56\u7565\u53ef\u4ee5\u63d0\u5347\u4f60\u7684\u6e38\u620f\u4f53\u9a8c\u3002"}]
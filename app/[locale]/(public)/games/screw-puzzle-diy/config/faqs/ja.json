[{"question": "\u30cd\u30b8\u30d1\u30ba\u30eb - DIY\u306e\u521d\u5fc3\u8005\u5411\u3051\u57fa\u672c\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u3069\u306e\u3088\u3046\u306b\u59cb\u3081\u3089\u308c\u307e\u3059\u304b\uff1f", "answer": "\u30cd\u30b8\u30d1\u30ba\u30eb - DIY\u3092\u59cb\u3081\u308b\u306b\u306f\u3001\u57fa\u672c\u7684\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u304b\u3089\u59cb\u3081\u307e\u3059\u3002\u30d1\u30ba\u30eb\u30d4\u30fc\u30b9\u3092\u9078\u629e\u3057\u3001\u6b63\u3057\u3044\u4f4d\u7f6e\u306b\u30c9\u30e9\u30c3\u30b0\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u7c21\u5358\u30e2\u30fc\u30c9\u300f\u306e\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3067\u306f\u3001\u5404\u30d4\u30fc\u30b9\u304c\u306f\u307e\u308b\u7c21\u5358\u306a5\u30d4\u30fc\u30b9\u306e\u30d1\u30ba\u30eb\u306b\u51fa\u4f1a\u3044\u307e\u3059\u3002\u56de\u8ee2\u30c4\u30fc\u30eb\uff08\u5de6\u4e0b\u9685\u306b\u3042\u308b\uff09\u3092\u4f7f\u7528\u3057\u3066\u3001\u30d4\u30fc\u30b9\u306e\u89d2\u5ea6\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30d4\u30fc\u30b9\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u5fc5\u8981\u3067\u3042\u308c\u3070\u56de\u8ee2\u3055\u305b\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5f37\u8abf\u8868\u793a\u3055\u308c\u305f\u9818\u57df\u306b\u30c9\u30e9\u30c3\u30b0\u30a2\u30f3\u30c9\u30c9\u30ed\u30c3\u30d7\u3057\u307e\u3059\u3002\u3053\u306e\u57fa\u672c\u7684\u306a\u624b\u9806\u306f\u3001\u3088\u308a\u8907\u96d1\u306a\u30d1\u30ba\u30eb\u306b\u53d6\u308a\u7d44\u3080\u524d\u306b\u81ea\u4fe1\u3092\u6301\u3064\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u30cd\u30b8\u30d1\u30ba\u30eb - DIY\u3067\u9ad8\u5ea6\u306a\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u305f\u3081\u306e\u6700\u826f\u306e\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30cd\u30b8\u30d1\u30ba\u30eb - DIY\u306e\u9ad8\u5ea6\u306a\u30d1\u30ba\u30eb\u3067\u306f\u3001\u4f53\u7cfb\u7684\u306a\u30a2\u30d7\u30ed\u30fc\u30c1\u3092\u63a1\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u8272\u307e\u305f\u306f\u30d1\u30bf\u30fc\u30f3\u3067\u30d4\u30fc\u30b9\u3092\u5206\u985e\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u7523\u696d\u30c1\u30e3\u30ec\u30f3\u30b8\u300f\u30ec\u30d9\u30eb\u3067\u306f\u3001\u985e\u4f3c\u3057\u305f\u8cea\u611f\u3092\u6301\u3064\u30d4\u30fc\u30b9\u3092\u30b0\u30eb\u30fc\u30d7\u5316\u3059\u308b\u3068\u6642\u9593\u304c\u7bc0\u7d04\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u307e\u305a\u7aef\u304b\u3089\u59cb\u3081\u3001\u30d5\u30ec\u30fc\u30e0\u30ef\u30fc\u30af\u3092\u69cb\u7bc9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30ba\u30fc\u30e0\u6a5f\u80fd\u3092\u4f7f\u7528\u3057\u3066\u3001\u8a73\u7d30\u3092\u7dbf\u5bc6\u306b\u8abf\u3079\u307e\u3059\u3002\u307e\u305f\u3001\u300e\u30d7\u30ec\u30d3\u30e5\u30fc\u30e2\u30fc\u30c9\u300f\u3092\u4f7f\u7528\u3057\u3066\u3001\u6700\u7d42\u7684\u306a\u753b\u50cf\u3092\u8996\u899a\u5316\u3059\u308b\u3053\u3068\u3082\u304a\u52e7\u3081\u3057\u307e\u3059\u3002\u3053\u306e\u6226\u7565\u306f\u3001\u5fcd\u8010\u5f37\u304f\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3001\u89e3\u304d\u65b9\u306e\u52b9\u7387\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002"}, {"question": "\u30cd\u30b8\u30d1\u30ba\u30eb - DIY\u306b\u56de\u8ee2\u6a5f\u80fd\u304c\u542b\u307e\u308c\u3066\u3044\u308b\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u3069\u306e\u3088\u3046\u306b\u52b9\u679c\u7684\u306b\u4f7f\u7528\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30cd\u30b8\u30d1\u30ba\u30eb - DIY\u306e\u56de\u8ee2\u6a5f\u80fd\u306f\u3001\u30d4\u30fc\u30b9\u3092\u6b63\u78ba\u306b\u5408\u308f\u305b\u308b\u305f\u3081\u306b\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u6a5f\u68b0\u7684\u9a5a\u7570\u300f\u30d1\u30ba\u30eb\u3067\u306f\u3001\u4e00\u90e8\u306e\u30d4\u30fc\u30b9\u309290\u5ea6\u56de\u8ee2\u3055\u305b\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u52b9\u679c\u7684\u306b\u4f7f\u7528\u3059\u308b\u624b\u9806\u306f\u3001\u30b9\u30c6\u30c3\u30d71\uff1a\u30d4\u30fc\u30b9\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u56de\u8ee2\u30dc\u30bf\u30f3\u3092\u30af\u30ea\u30c3\u30af\u3059\u308b\u304b\u3001\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\uff08R\u30ad\u30fc\uff09\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u5468\u56f2\u306e\u30d4\u30fc\u30b9\u306b\u5408\u308f\u305b\u308b\u307e\u3067\u89d2\u5ea6\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u3053\u306e\u30c4\u30fc\u30eb\u306f\u3001\u8907\u96d1\u306a\u30c7\u30b6\u30a4\u30f3\u306e\u30d1\u30ba\u30eb\u306b\u7279\u306b\u5f79\u7acb\u3061\u3001\u30b7\u30fc\u30e0\u30ec\u30b9\u306a\u30d5\u30a3\u30c3\u30c8\u3092\u4fdd\u8a3c\u3057\u307e\u3059\u3002"}, {"question": "\u30cd\u30b8\u30d1\u30ba\u30eb - DIY\u306e\u30b9\u30b3\u30a2\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u3069\u306e\u3088\u3046\u306a\u8981\u7d20\u304c\u5f71\u97ff\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30cd\u30b8\u30d1\u30ba\u30eb - DIY\u306e\u8a55\u4fa1\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u6642\u9593\u3001\u6b63\u78ba\u3055\u3001\u52b9\u7387\u6027\u306e3\u3064\u306e\u4e3b\u8981\u306a\u8981\u7d20\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u6642\u8a08\u4ed5\u639b\u3051\u30c1\u30e3\u30ec\u30f3\u30b8\u300f\u309210\u5206\u672a\u6e80\u3067\u3001\u9593\u9055\u3044\u306a\u304f\u5b8c\u4e86\u3059\u308b\u3068\u3001\u6e80\u70b9\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u6642\u9593\u306f\u4e3b\u8981\u306a\u6307\u6a19\u3067\u3059\u304c\u3001\u6b63\u78ba\u3055\uff08\u6b63\u3057\u3044\u914d\u7f6e\u306b\u3088\u308b\uff09\u3068\u52b9\u7387\u6027\uff08\u6700\u5c0f\u9650\u306e\u56de\u8ee2\uff09\u3082\u5f79\u5272\u3092\u679c\u305f\u3057\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306f\u52a0\u91cd\u5f0f\u8a08\u7b97\u5f0f\u3092\u4f7f\u7528\u3057\u3066\u3044\u307e\u3059\uff1a\u30b9\u30b3\u30a2 = (1000 - \u79d2\u5358\u4f4d\u306e\u6642\u9593) + (\u6b63\u78ba\u3055 * 10) - (\u56de\u8ee2\u6570 * 2)\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3067\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u30cd\u30b8\u30d1\u30ba\u30eb - DIY\u3092\u5b9f\u884c\u3059\u308b\u305f\u3081\u306e\u6280\u8853\u7684\u306a\u8981\u4ef6\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30cd\u30b8\u30d1\u30ba\u30eb - DIY\u306f\u3001\u8907\u6570\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3068\u4e92\u63db\u6027\u3092\u6301\u3064\u3088\u3046\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059\u3002PC\u3067\u306f\u3001Windows 10\u30014GB\u306eRAM\u3001DirectX 11\u5bfe\u5fdc\u306eGPU\u304c\u5fc5\u8981\u3067\u3059\u3002\u30e2\u30d0\u30a4\u30eb\u3067\u306f\u3001iOS 12\u4ee5\u964d\u3001Android 8.0\u4ee5\u964d\u30012GB\u306eRAM\u304c\u30b5\u30dd\u30fc\u30c8\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u30b2\u30fc\u30e0\u306e\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u6a5f\u80fd\u306b\u3088\u308a\u3001\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u30c7\u30fc\u30bf\u3092\u30b7\u30fc\u30e0\u30ec\u30b9\u306b\u79fb\u884c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001iPhone\u3067\u30d1\u30ba\u30eb\u3092\u59cb\u3081\u3066\u3001Windows PC\u3067\u7d9a\u304d\u3092\u9032\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u306b\u3059\u308b\u306b\u306f\u3001\u5e38\u306b\u30c7\u30d0\u30a4\u30b9\u304c\u3053\u308c\u3089\u306e\u4ed5\u69d8\u3092\u6e80\u305f\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002"}, {"question": "\u30cd\u30b8\u30d1\u30ba\u30eb - DIY\u3067\u8907\u96d1\u306a\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u306e\u306b\u6700\u3082\u5f79\u7acb\u3064\u30c4\u30fc\u30eb\u306f\u3069\u308c\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30cd\u30b8\u30d1\u30ba\u30eb - DIY\u306f\u3001\u8907\u96d1\u306a\u30d1\u30ba\u30eb\u3092\u89e3\u304f\u306e\u3092\u52a9\u3051\u308b\u3044\u304f\u3064\u304b\u306e\u30c4\u30fc\u30eb\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\u300e\u30a8\u30c3\u30b8\u30d5\u30a1\u30a4\u30f3\u30c0\u30fc\u300f\u306f\u3001\u5883\u754c\u7dda\u306b\u3042\u308b\u30d4\u30fc\u30b9\u3092\u5f37\u8abf\u8868\u793a\u3057\u3001\u300e\u8272\u76f8\u4e00\u81f4\u30c4\u30fc\u30eb\u300f\u306f\u985e\u4f3c\u3057\u305f\u8272\u76f8\u306e\u30d4\u30fc\u30b9\u3092\u30b0\u30eb\u30fc\u30d7\u5316\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u8679\u306e\u8b0e\u300f\u30d1\u30ba\u30eb\u3067\u306f\u3001\u300e\u8272\u76f8\u4e00\u81f4\u30c4\u30fc\u30eb\u300f\u3092\u4f7f\u7528\u3057\u3066\u3001\u3059\u3079\u3066\u306e\u9752\u3044\u30d4\u30fc\u30b9\u3092\u5206\u96e2\u3057\u3001\u30d7\u30ed\u30bb\u30b9\u3092\u7c21\u7d20\u5316\u3067\u304d\u307e\u3059\u3002\u624b\u98061\uff1a\u30a8\u30c3\u30b8\u30d5\u30a1\u30a4\u30f3\u30c0\u30fc\u3092\u30a2\u30af\u30c6\u30a3\u30d6\u306b\u3057\u3066\u3001\u30d1\u30ba\u30eb\u3092\u30d5\u30ec\u30fc\u30e0\u3057\u307e\u3059\u3002\u624b\u98062\uff1a\u8272\u76f8\u4e00\u81f4\u30c4\u30fc\u30eb\u3092\u4f7f\u7528\u3057\u3066\u3001\u30d4\u30fc\u30b9\u3092\u5206\u985e\u3057\u307e\u3059\u3002\u624b\u98063\uff1a\u8a73\u7d30\u3092\u78ba\u8a8d\u3059\u308b\u305f\u3081\u306b\u300e\u62e1\u5927\u93e1\u300f\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30c4\u30fc\u30eb\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3001\u89e3\u304d\u6642\u9593\u3092\u5927\u5e45\u306b\u77ed\u7e2e\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30cd\u30b8\u30d1\u30ba\u30eb - DIY\u3067\u96a0\u3055\u308c\u305f\u30ec\u30d9\u30eb\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u306e\u72ec\u81ea\u306e\u8ab2\u984c\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30cd\u30b8\u30d1\u30ba\u30eb - DIY\u306e\u96a0\u3055\u308c\u305f\u30ec\u30d9\u30eb\u306f\u3001\u7279\u5b9a\u306e\u30d1\u30ba\u30eb\u3067\u9ad8\u30b9\u30b3\u30a2\u3092\u7372\u5f97\u3059\u308b\u3053\u3068\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u30ae\u30a2\u30de\u30b9\u30bf\u30fc\u300f\u30ec\u30d9\u30eb\u3067950\u70b9\u4ee5\u4e0a\u3092\u7372\u5f97\u3059\u308b\u3068\u3001\u300e\u96a0\u3057\u5de5\u623f\u300f\u304c\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30ec\u30d9\u30eb\u306f\u901a\u5e38\u3001\u72ec\u7279\u306e\u8ab2\u984c\u3001\u4f8b\u3048\u3070\u4e0d\u898f\u5247\u306a\u5f62\u72b6\u306e\u30d4\u30fc\u30b9\u3084\u6642\u9593\u5236\u9650\u306a\u3069\u304c\u3042\u308a\u307e\u3059\u3002\u305d\u308c\u3089\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3059\u308b\u306b\u306f\u3001\u6a19\u6e96\u30ec\u30d9\u30eb\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u3053\u3068\u306b\u96c6\u4e2d\u3057\u307e\u3059\u3002\u30a2\u30f3\u30ed\u30c3\u30af\u3055\u308c\u308b\u3068\u3001\u7cbe\u5bc6\u3055\u3068\u9069\u5fdc\u529b\u3092\u8a66\u3059\u30d1\u30ba\u30eb\u306b\u5099\u3048\u3001\u65b0\u9bae\u3067\u3084\u308a\u304c\u3044\u306e\u3042\u308b\u4f53\u9a13\u304c\u63d0\u4f9b\u3055\u308c\u307e\u3059\u3002"}, {"question": "\u30cd\u30b8\u30d1\u30ba\u30eb - DIY\u306e\u7c21\u5358\u30e2\u30fc\u30c9\u3068\u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\u306e\u9055\u3044\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30cd\u30b8\u30d1\u30ba\u30eb - DIY\u306e\u7c21\u5358\u30e2\u30fc\u30c9\u3068\u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\u306f\u3001\u4e3b\u306b\u30d1\u30ba\u30eb\u306e\u8907\u96d1\u3055\u3068\u6642\u9593\u5236\u9650\u304c\u7570\u306a\u308a\u307e\u3059\u3002\u7c21\u5358\u30e2\u30fc\u30c9\u306f\u3001\u30d4\u30fc\u30b9\u306e\u6570\u3084\u6642\u9593\u5236\u9650\u304c\u5c11\u306a\u3044\u305f\u3081\u3001\u521d\u5fc3\u8005\u5411\u304d\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u57fa\u672c\u69cb\u7bc9\u300f\u30d1\u30ba\u30eb\u306f\u3001\u30d4\u30fc\u30b9\u304c10\u500b\u3067\u3001\u6642\u9593\u306f\u7121\u5236\u9650\u3067\u3059\u3002\u4e00\u65b9\u3001\u30cf\u30fc\u30c9\u30e2\u30fc\u30c9\u306f\u3001\u30d4\u30fc\u30b9\u306e\u6570\u304c\u591a\u304f\u3001\u30ab\u30a6\u30f3\u30c8\u30c0\u30a6\u30f3\u30bf\u30a4\u30de\u30fc\u304c\u8a2d\u5b9a\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u300e\u6642\u9593\u30c8\u30e9\u30a4\u30a2\u30eb\u300f\u30d1\u30ba\u30eb\u3067\u306f\u300150\u500b\u306e\u30d4\u30fc\u30b9\u306e\u30d1\u30ba\u30eb\u309215\u5206\u4ee5\u5185\u306b\u89e3\u304f\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30e2\u30fc\u30c9\u306f\u3001\u3055\u307e\u3056\u307e\u306a\u30b9\u30ad\u30eb\u30ec\u30d9\u30eb\u306b\u5bfe\u5fdc\u3057\u3066\u304a\u308a\u3001\u3059\u3079\u3066\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u5408\u308f\u305b\u305f\u8ab2\u984c\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002"}, {"question": "\u30cd\u30b8\u30d1\u30ba\u30eb - DIY\u3067\u901f\u5ea6\u3068\u6b63\u78ba\u6027\u3092\u5411\u4e0a\u3055\u305b\u308b\u306b\u306f\u3001\u8cea\u3092\u640d\u306a\u3046\u3053\u3068\u306a\u304f\u3069\u3046\u3059\u308c\u3070\u826f\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30cd\u30b8\u30d1\u30ba\u30eb - DIY\u3067\u901f\u5ea6\u3068\u6b63\u78ba\u6027\u3092\u5411\u4e0a\u3055\u305b\u308b\u306b\u306f\u3001\u7df4\u7fd2\u3068\u6226\u7565\u304c\u5fc5\u8981\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u4e00\u822c\u7684\u306a\u30d4\u30fc\u30b9\u5f62\u72b6\u3084\u30d1\u30bf\u30fc\u30f3\u3092\u899a\u3048\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u300e\u30af\u30a4\u30c3\u30af\u30d5\u30a3\u30c3\u30af\u30b9\u300f\u30d1\u30ba\u30eb\u3067\u306f\u3001L\u5b57\u578b\u306e\u30d4\u30fc\u30b9\u3092\u8a8d\u8b58\u3059\u308b\u3068\u6642\u9593\u304c\u7bc0\u7d04\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u300e\u30a8\u30c3\u30b8\u30d5\u30a1\u30a4\u30f3\u30c0\u30fc\u300f\u3092\u4f7f\u7528\u3057\u3066\u3001\u30d1\u30ba\u30eb\u306e\u5883\u754c\u3092\u3059\u3070\u3084\u304f\u5b9a\u7fa9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u4e8b\u524d\u306b\u914d\u7f6e\u3092\u8a08\u753b\u3059\u308b\u3053\u3068\u3067\u3001\u904e\u5ea6\u306e\u56de\u8ee2\u3092\u907f\u3051\u307e\u3057\u3087\u3046\u3002\u3055\u3089\u306b\u3001\u5b9a\u671f\u7684\u306a\u7df4\u7fd2\u306f\u3001\u7b4b\u8089\u306e\u8a18\u61b6\u3092\u5f37\u5316\u3057\u3001\u8cea\u3092\u640d\u306a\u3046\u3053\u3068\u306a\u304f\u3001\u3088\u308a\u901f\u304f\u3066\u6b63\u78ba\u306a\u89e3\u304d\u65b9\u3092\u53ef\u80fd\u306b\u3057\u307e\u3059\u3002"}, {"question": "\u30cd\u30b8\u30d1\u30ba\u30eb - DIY\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u305f\u3081\u306e\u3001\u3042\u307e\u308a\u77e5\u3089\u308c\u3066\u3044\u306a\u3044\u30d2\u30f3\u30c8\u3068\u30b3\u30c4\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30cd\u30b8\u30d1\u30ba\u30eb - DIY\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u306b\u306f\u3001\u3042\u307e\u308a\u77e5\u3089\u308c\u3066\u3044\u306a\u3044\u30d2\u30f3\u30c8\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u304c\u91cd\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u62e1\u5927\u93e1\u300f\u30c4\u30fc\u30eb\u3092\u4f7f\u7528\u3059\u308b\u3068\u3001\u30d4\u30fc\u30b9\u306e\u5fae\u5999\u306a\u8a73\u7d30\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u3001\u914d\u7f6e\u3092\u652f\u63f4\u3057\u307e\u3059\u3002\u3082\u3046\u4e00\u3064\u306e\u30b3\u30c4\u306f\u3001\u72ec\u7279\u306e\u30d1\u30bf\u30fc\u30f3\u3084\u8272\u306b\u6700\u521d\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3053\u3068\u3067\u3059\u3002\u305d\u308c\u3089\u306f\u7279\u5b9a\u3057\u3084\u3059\u3044\u304b\u3089\u3067\u3059\u3002\u300e\u30d1\u30bf\u30fc\u30f3\u30d1\u30ba\u30eb\u300f\u3067\u306f\u3001\u6700\u3082\u969b\u7acb\u3063\u305f\u30d4\u30fc\u30b9\u304b\u3089\u59cb\u3081\u308b\u3068\u3001\u30d7\u30ed\u30bb\u30b9\u3092\u52b9\u7387\u5316\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u77ed\u3044\u4f11\u61a9\u3092\u53d6\u308b\u3053\u3068\u3067\u8996\u70b9\u304c\u30ea\u30d5\u30ec\u30c3\u30b7\u30e5\u3055\u308c\u3001\u5168\u4f53\u7684\u306a\u52b9\u7387\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u5c0f\u3055\u306a\u3051\u308c\u3069\u3082\u52b9\u679c\u7684\u306a\u6226\u7565\u306f\u3001\u3042\u306a\u305f\u306e\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u7d4c\u9a13\u3092\u9ad8\u3081\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}]
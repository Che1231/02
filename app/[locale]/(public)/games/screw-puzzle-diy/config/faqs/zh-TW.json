[{"question": "\u5982\u4f55\u958b\u59cb\u5b78\u7fd2\u87ba\u65cb\u76ca\u667a\u62fc\u5716 - DIY \u7684\u57fa\u672c\u6a5f\u5236\u4f5c\u70ba\u65b0\u624b\uff1f", "answer": "\u8981\u958b\u59cb\u87ba\u65cb\u76ca\u667a\u62fc\u5716 - DIY\uff0c\u8acb\u5148\u719f\u6089\u6838\u5fc3\u6a5f\u5236\u3002\u9996\u5148\uff0c\u9078\u64c7\u4e00\u500b\u62fc\u5716\u584a\uff0c\u4e26\u5c07\u5176\u62d6\u66f3\u5230\u6b63\u78ba\u7684\u4f4d\u7f6e\u3002\u4f8b\u5982\uff0c\u5728\u300e\u7c21\u55ae\u6a21\u5f0f\u300f\u7684\u6559\u5b78\u4e2d\uff0c\u60a8\u6703\u9047\u5230\u4e00\u500b\u7c21\u55ae\u7684\u4e94\u584a\u62fc\u5716\uff0c\u5176\u4e2d\u6bcf\u500b\u62fc\u584a\u90fd\u6703\u6e96\u78ba\u5730\u5361\u5165\u5230\u4f4d\u3002\u4f7f\u7528\u5e95\u89d2\u7684\u65cb\u8f49\u5de5\u5177\u8abf\u6574\u62fc\u584a\u7684\u89d2\u5ea6\u3002\u6b65\u9a5f 1\uff1a\u9078\u64c7\u4e00\u500b\u62fc\u584a\u3002\u6b65\u9a5f 2\uff1a\u5982\u6709\u9700\u8981\uff0c\u65cb\u8f49\u5b83\u3002\u6b65\u9a5f 3\uff1a\u5c07\u5176\u62d6\u653e\u5230\u9ad8\u4eae\u986f\u793a\u7684\u5340\u57df\u3002\u9019\u500b\u57fa\u790e\u904e\u7a0b\u5c07\u5728\u60a8\u5617\u8a66\u66f4\u8907\u96dc\u7684\u62fc\u5716\u4e4b\u524d\uff0c\u5e6b\u52a9\u60a8\u5efa\u7acb\u4fe1\u5fc3\u3002"}, {"question": "\u89e3\u6c7a\u87ba\u65cb\u76ca\u667a\u62fc\u5716 - DIY \u4e2d\u9ad8\u7d1a\u62fc\u5716\u7684\u6700\u4f73\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u91dd\u5c0d\u87ba\u65cb\u76ca\u667a\u62fc\u5716 - DIY \u4e2d\u9ad8\u7d1a\u62fc\u5716\uff0c\u8acb\u63a1\u7528\u7cfb\u7d71\u5316\u65b9\u6cd5\u3002\u6b65\u9a5f 1\uff1a\u4f9d\u984f\u8272\u6216\u5716\u6848\u5206\u985e\u62fc\u584a\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5de5\u696d\u6311\u6230\u300f\u7b49\u7d1a\u4e2d\uff0c\u5c07\u5177\u6709\u76f8\u4f3c\u7d0b\u7406\u7684\u62fc\u584a\u5206\u7d44\u53ef\u4ee5\u7bc0\u7701\u6642\u9593\u3002\u6b65\u9a5f 2\uff1a\u9996\u5148\u8457\u91cd\u65bc\u908a\u7de3\uff0c\u56e0\u70ba\u5b83\u5011\u63d0\u4f9b\u6846\u67b6\u3002\u6b65\u9a5f 3\uff1a\u4f7f\u7528\u653e\u5927\u529f\u80fd\u4ed4\u7d30\u6aa2\u67e5\u7d30\u7bc0\u3002\u6b64\u5916\uff0c\u8acb\u5617\u8a66\u4f7f\u7528\u300e\u9810\u89bd\u6a21\u5f0f\u300f\u4f86\u9810\u89bd\u6700\u7d42\u5716\u7247\u3002\u9019\u7a2e\u7b56\u7565\u52a0\u4e0a\u8010\u5fc3\uff0c\u5c07\u986f\u8457\u63d0\u9ad8\u60a8\u7684\u89e3\u6c7a\u6548\u7387\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u87ba\u65cb\u76ca\u667a\u62fc\u5716 - DIY \u5305\u542b\u65cb\u8f49\u529f\u80fd\uff0c\u4ee5\u53ca\u5982\u4f55\u6709\u6548\u5730\u4f7f\u7528\u5b83\uff1f", "answer": "\u87ba\u65cb\u76ca\u667a\u62fc\u5716 - DIY \u4e2d\u7684\u65cb\u8f49\u529f\u80fd\u5c0d\u65bc\u6e96\u78ba\u5c0d\u9f4a\u62fc\u584a\u81f3\u95dc\u91cd\u8981\u3002\u4f8b\u5982\uff0c\u5728\u300e\u6a5f\u68b0\u5947\u89c0\u300f\u62fc\u5716\u4e2d\uff0c\u67d0\u4e9b\u62fc\u584a\u9700\u8981\u65cb\u8f49 90 \u5ea6\u624d\u80fd\u5408\u9069\u3002\u6709\u6548\u4f7f\u7528\u5b83\u7684\u65b9\u6cd5\uff1a\u6b65\u9a5f 1\uff1a\u9078\u64c7\u62fc\u584a\u3002\u6b65\u9a5f 2\uff1a\u9ede\u64ca\u65cb\u8f49\u6309\u9215\u6216\u4f7f\u7528\u5feb\u6377\u9375 (R \u9375)\u3002\u6b65\u9a5f 3\uff1a\u8abf\u6574\u89d2\u5ea6\uff0c\u76f4\u5230\u5b83\u8207\u5468\u570d\u7684\u62fc\u584a\u5c0d\u9f4a\u3002\u6b64\u5de5\u5177\u5c0d\u65bc\u5177\u6709\u8907\u96dc\u8a2d\u8a08\u7684\u62fc\u5716\u7279\u5225\u6709\u7528\uff0c\u78ba\u4fdd\u62fc\u584a\u7121\u7e2b\u8cbc\u5408\u3002"}, {"question": "\u87ba\u65cb\u76ca\u667a\u62fc\u5716 - DIY \u7684\u8a08\u5206\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u5b83\uff1f", "answer": "\u87ba\u65cb\u76ca\u667a\u62fc\u5716 - DIY \u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u4e09\u500b\u4e3b\u8981\u56e0\u7d20\uff1a\u6642\u9593\u3001\u6e96\u78ba\u6027\u548c\u6548\u7387\u3002\u4f8b\u5982\uff0c\u5728 10 \u5206\u9418\u5167\u5b8c\u6210\u300e\u6a5f\u68b0\u6311\u6230\u300f\u4e14\u6c92\u6709\u932f\u8aa4\u653e\u7f6e\u53ef\u7372\u5f97\u6eff\u5206\u3002\u6642\u9593\u662f\u4e3b\u8981\u6307\u6a19\uff0c\u4f46\u6e96\u78ba\u6027\uff08\u901a\u904e\u6b63\u78ba\u7684\u653e\u7f6e\u6e2c\u91cf\uff09\u548c\u6548\u7387\uff08\u6700\u5c11\u65cb\u8f49\uff09\u4e5f\u767c\u63ee\u4f5c\u7528\u3002\u904a\u6232\u4f7f\u7528\u52a0\u6b0a\u516c\u5f0f\uff1a\u5f97\u5206 = (1000 - \u79d2\u6578) + (\u6e96\u78ba\u6027 \u00d7 10) - (\u65cb\u8f49 \u6b21\u6578 \u00d7 2)\u3002\u4e86\u89e3\u6b64\u7cfb\u7d71\u53ef\u4ee5\u5e6b\u52a9\u60a8\u512a\u5316\u8868\u73fe\u3002"}, {"question": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e0a\u904b\u884c\u87ba\u65cb\u76ca\u667a\u62fc\u5716 - DIY \u7684\u6280\u8853\u8981\u6c42\u662f\u4ec0\u9ebc\uff1f", "answer": "\u87ba\u65cb\u76ca\u667a\u62fc\u5716 - DIY \u65e8\u5728\u8207\u591a\u500b\u5e73\u53f0\u76f8\u5bb9\u3002\u5c0d\u65bc\u96fb\u8166\uff0c\u5b83\u9700\u8981 Windows 10\u30014GB \u8a18\u61b6\u9ad4\u548c DirectX 11 \u76f8\u5bb9\u7684 GPU\u3002\u5728\u884c\u52d5\u88dd\u7f6e\u4e0a\uff0c\u5b83\u652f\u63f4 iOS 12 \u4ee5\u4e0a\u548c Android 8.0 \u4ee5\u4e0a\uff0c\u914d\u5099 2GB \u8a18\u61b6\u9ad4\u3002\u904a\u6232\u7684\u96f2\u7aef\u5132\u5b58\u529f\u80fd\u78ba\u4fdd\u88dd\u7f6e\u9593\u7684\u8cc7\u6599\u7121\u7e2b\u9077\u79fb\u3002\u4f8b\u5982\uff0c\u60a8\u53ef\u4ee5\u5728 iPhone \u4e0a\u958b\u59cb\u62fc\u5716\uff0c\u7136\u5f8c\u5728 Windows \u96fb\u8166\u4e0a\u7e7c\u7e8c\uff0c\u800c\u4e0d\u6703\u907a\u5931\u9032\u5ea6\u3002\u8acb\u52d9\u5fc5\u78ba\u4fdd\u60a8\u7684\u8a2d\u5099\u7b26\u5408\u9019\u4e9b\u898f\u7bc4\u4ee5\u7372\u5f97\u6700\u4f73\u6548\u80fd\u3002"}, {"question": "\u87ba\u65cb\u76ca\u667a\u62fc\u5716 - DIY \u4e2d\u54ea\u4e9b\u5de5\u5177\u5c0d\u65bc\u89e3\u6c7a\u8907\u96dc\u7684\u62fc\u5716\u6700\u6709\u7528\uff0c\u4ee5\u53ca\u5b83\u5011\u7684\u529f\u80fd\u662f\u4ec0\u9ebc\uff1f", "answer": "\u87ba\u65cb\u76ca\u667a\u62fc\u5716 - DIY \u63d0\u4f9b\u4e00\u4e9b\u5de5\u5177\u4f86\u5354\u52a9\u89e3\u6c7a\u8907\u96dc\u7684\u62fc\u5716\u3002\u300e\u908a\u7de3\u67e5\u627e\u5668\u300f\u6703\u7a81\u51fa\u986f\u793a\u908a\u7de3\u62fc\u584a\uff0c\u800c\u300e\u984f\u8272\u5339\u914d\u5668\u300f\u6703\u5c07\u76f8\u4f3c\u7684\u984f\u8272\u5206\u7d44\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5f69\u8679\u8b0e\u984c\u300f\u62fc\u5716\u4e2d\uff0c\u984f\u8272\u5339\u914d\u5668\u53ef\u4ee5\u5206\u96e2\u6240\u6709\u85cd\u8272\u62fc\u584a\uff0c\u7c21\u5316\u904e\u7a0b\u3002\u6b65\u9a5f 1\uff1a\u555f\u52d5\u908a\u7de3\u67e5\u627e\u5668\u5efa\u7acb\u62fc\u5716\u6846\u67b6\u3002\u6b65\u9a5f 2\uff1a\u4f7f\u7528\u984f\u8272\u5339\u914d\u5668\u4f86\u5206\u985e\u62fc\u584a\u3002\u6b65\u9a5f 3\uff1a\u4f7f\u7528\u300e\u653e\u5927\u93e1\u300f\u4f86\u6aa2\u67e5\u7d30\u7bc0\u3002\u9019\u4e9b\u5de5\u5177\u7d50\u5408\u4f7f\u7528\u53ef\u4ee5\u986f\u8457\u7e2e\u77ed\u89e3\u984c\u6642\u9593\u3002"}, {"question": "\u5982\u4f55\u5728\u87ba\u65cb\u76ca\u667a\u62fc\u5716 - DIY \u4e2d\u89e3\u9396\u96b1\u85cf\u95dc\u5361\uff0c\u4ee5\u53ca\u5b83\u5011\u7684\u7368\u7279\u6311\u6230\u662f\u4ec0\u9ebc\uff1f", "answer": "\u87ba\u65cb\u76ca\u667a\u62fc\u5716 - DIY \u4e2d\u7684\u96b1\u85cf\u95dc\u5361\u662f\u900f\u904e\u5728\u7279\u5b9a\u62fc\u5716\u4e2d\u7372\u5f97\u9ad8\u5206\u4f86\u89e3\u9396\u7684\u3002\u4f8b\u5982\uff0c\u5728\u300e\u9f52\u8f2a\u5927\u5e2b\u300f\u95dc\u5361\u4e2d\u7372\u5f97 950 \u5206\u4ee5\u4e0a\u53ef\u89e3\u9396\u300e\u96b1\u85cf\u5de5\u574a\u300f\u3002\u9019\u4e9b\u95dc\u5361\u901a\u5e38\u5177\u6709\u7368\u7279\u7684\u6311\u6230\uff0c\u4f8b\u5982\u4e0d\u898f\u5247\u5f62\u72c0\u7684\u62fc\u584a\u6216\u6642\u9593\u9650\u5236\u3002\u8981\u89e3\u9396\u5b83\u5011\uff0c\u8acb\u5c08\u6ce8\u65bc\u512a\u5316\u6a19\u6e96\u95dc\u5361\u7684\u8868\u73fe\u3002\u89e3\u9396\u5f8c\uff0c\u6e96\u5099\u8fce\u63a5\u8003\u9a57\u60a8\u7684\u7cbe\u78ba\u5ea6\u548c\u9069\u61c9\u529b\u7684\u62fc\u5716\uff0c\u63d0\u4f9b\u65b0\u9bae\u4e14\u4ee4\u4eba\u6eff\u610f\u7684\u9ad4\u9a57\u3002"}, {"question": "\u87ba\u65cb\u76ca\u667a\u62fc\u5716 - DIY \u4e2d\u7c21\u55ae\u6a21\u5f0f\u548c\u56f0\u96e3\u6a21\u5f0f\u4e4b\u9593\u7684\u4e3b\u8981\u5340\u5225\u662f\u4ec0\u9ebc\uff1f", "answer": "\u87ba\u65cb\u76ca\u667a\u62fc\u5716 - DIY \u4e2d\u7684\u7c21\u55ae\u6a21\u5f0f\u548c\u56f0\u96e3\u6a21\u5f0f\u4e3b\u8981\u5340\u5225\u5728\u65bc\u62fc\u5716\u7684\u8907\u96dc\u6027\u548c\u6642\u9593\u9650\u5236\u3002\u7c21\u55ae\u6a21\u5f0f\u7684\u62fc\u5716\u584a\u8f03\u5c11\uff0c\u4e14\u6c92\u6709\u6642\u9593\u9650\u5236\uff0c\u975e\u5e38\u9069\u5408\u521d\u5b78\u8005\u3002\u4f8b\u5982\uff0c\u300e\u57fa\u672c\u7d50\u69cb\u300f\u62fc\u5716\u6709 10 \u500b\u62fc\u584a\uff0c\u6642\u9593\u7121\u9650\u5236\u3002\u56f0\u96e3\u6a21\u5f0f\u5247\u5305\u542b\u66f4\u591a\u62fc\u584a\u548c\u5012\u6578\u8a08\u6642\u5668\u3002\u5728\u300e\u8a08\u6642\u6e2c\u8a66\u300f\u62fc\u5716\u4e2d\uff0c\u60a8\u5fc5\u9808\u5728 15 \u5206\u9418\u5167\u89e3\u6c7a\u4e00\u500b 50 \u500b\u62fc\u584a\u7684\u62fc\u5716\u3002\u9019\u4e9b\u6a21\u5f0f\u9069\u7528\u65bc\u4e0d\u540c\u7684\u6280\u80fd\u6c34\u6e96\uff0c\u70ba\u6240\u6709\u73a9\u5bb6\u63d0\u4f9b\u91cf\u8eab\u6253\u9020\u7684\u6311\u6230\u3002"}, {"question": "\u5982\u4f55\u5728\u4e0d\u5f71\u97ff\u54c1\u8cea\u7684\u60c5\u6cc1\u4e0b\u63d0\u9ad8\u87ba\u65cb\u76ca\u667a\u62fc\u5716 - DIY \u7684\u901f\u5ea6\u548c\u6e96\u78ba\u6027\uff1f", "answer": "\u63d0\u9ad8\u87ba\u65cb\u76ca\u667a\u62fc\u5716 - DIY \u7684\u901f\u5ea6\u548c\u6e96\u78ba\u6027\u9700\u8981\u7df4\u7fd2\u548c\u7b56\u7565\u3002\u6b65\u9a5f 1\uff1a\u719f\u6089\u5e38\u898b\u7684\u62fc\u584a\u5f62\u72c0\u548c\u5716\u6848\u3002\u4f8b\u5982\uff0c\u5728\u300e\u5feb\u901f\u4fee\u5fa9\u300f\u62fc\u5716\u4e2d\uff0c\u8fa8\u8a8d L \u5f62\u62fc\u584a\u53ef\u4ee5\u7bc0\u7701\u6642\u9593\u3002\u6b65\u9a5f 2\uff1a\u4f7f\u7528\u300e\u908a\u7de3\u67e5\u627e\u5668\u300f\u5feb\u901f\u5efa\u7acb\u62fc\u5716\u7684\u908a\u754c\u3002\u6b65\u9a5f 3\uff1a\u9810\u5148\u898f\u5283\u653e\u7f6e\u4f4d\u7f6e\uff0c\u907f\u514d\u904e\u591a\u7684\u65cb\u8f49\u3002\u6b64\u5916\uff0c\u7d93\u5e38\u7df4\u7fd2\u5c07\u589e\u5f37\u60a8\u7684\u808c\u8089\u8a18\u61b6\uff0c\u8b93\u60a8\u53ef\u4ee5\u66f4\u5feb\u3001\u66f4\u6e96\u78ba\u5730\u89e3\u984c\uff0c\u800c\u4e0d\u6703\u72a7\u7272\u54c1\u8cea\u3002"}, {"question": "\u638c\u63e1\u87ba\u65cb\u76ca\u667a\u62fc\u5716 - DIY \u7684\u4e00\u4e9b\u9bae\u70ba\u4eba\u77e5\u7684\u6280\u5de7\u548c\u7ac5\u9580\u662f\u4ec0\u9ebc\uff1f", "answer": "\u638c\u63e1\u87ba\u65cb\u76ca\u667a\u62fc\u5716 - DIY \u5305\u62ec\u767c\u73fe\u9bae\u70ba\u4eba\u77e5\u7684\u6280\u5de7\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u300e\u653e\u5927\u93e1\u300f\u5de5\u5177\u53ef\u4ee5\u986f\u793a\u62fc\u584a\u4e0a\u7684\u7d30\u5fae\u7d30\u7bc0\uff0c\u5354\u52a9\u653e\u7f6e\u3002\u53e6\u4e00\u500b\u6280\u5de7\u662f\u9996\u5148\u5c08\u6ce8\u65bc\u7368\u7279\u7684\u5716\u6848\u6216\u984f\u8272\uff0c\u56e0\u70ba\u5b83\u5011\u66f4\u5bb9\u6613\u8b58\u5225\u3002\u5728\u300e\u5716\u6848\u62fc\u5716\u300f\u4e2d\uff0c\u5f9e\u6700\u660e\u986f\u7684\u62fc\u584a\u958b\u59cb\u53ef\u4ee5\u7c21\u5316\u904e\u7a0b\u3002\u6b64\u5916\uff0c\u66ab\u6642\u4f11\u606f\u53ef\u4ee5\u8b93\u60a8\u7684\u8996\u89d2\u5f97\u5230\u66f4\u65b0\uff0c\u6539\u5584\u6574\u9ad4\u6548\u7387\u3002\u9019\u4e9b\u5c0f\u800c\u6709\u6548\u7b56\u7565\u53ef\u4ee5\u63d0\u5347\u60a8\u7684\u904a\u6232\u9ad4\u9a57\u3002"}]
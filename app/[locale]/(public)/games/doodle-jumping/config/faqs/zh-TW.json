[{"question": "\u65b0\u624b\u5982\u4f55\u6709\u6548\u63a7\u5236\u89d2\u8272\u5728\u300a\u756b\u5716\u8df3\u8e8d\u300b\u4e2d\uff1f", "answer": "\u5728\u300a\u756b\u5716\u8df3\u8e8d\u300b\u4e2d\uff0c\u65b0\u624b\u8981\u6709\u6548\u63a7\u5236\u89d2\u8272\uff0c\u61c9\u8457\u91cd\u65bc\u50be\u659c\u611f\u61c9\u3002\u8acb\u5728\u8a2d\u5b9a\u4e2d\u8abf\u6574\u50be\u659c\u611f\u61c9\u5ea6\u81f3\u8212\u9069\u7684\u6c34\u5e73\u3002\u4f8b\u5982\uff0c\u8f03\u4f4e\u7684\u611f\u61c9\u5ea6\u53ef\u80fd\u6709\u52a9\u65bc\u65b0\u73a9\u5bb6\u907f\u514d\u8df3\u904e\u5e73\u53f0\u3002\u719f\u80fd\u751f\u5de7\uff0c\u56e0\u6b64\u8acb\u82b1\u6642\u9593\u900f\u904e\u77ed\u66ab\u800c\u983b\u7e41\u7684\u904a\u6232\u4f86\u7fd2\u6163\u64cd\u4f5c\u3002\u6b64\u65b9\u6cd5\u6709\u52a9\u65bc\u5efa\u7acb\u808c\u8089\u8a18\u61b6\u4e26\u96a8\u8457\u6642\u9593\u63d0\u9ad8\u6e96\u78ba\u6027\u3002"}, {"question": "\u300a\u756b\u5716\u8df3\u8e8d\u300b\u7684\u57fa\u672c\u63a7\u5236\u662f\u4ec0\u9ebc\uff0c\u4ee5\u53ca\u5b83\u5011\u7684\u529f\u80fd\uff1f", "answer": "\u300a\u756b\u5716\u8df3\u8e8d\u300b\u7684\u57fa\u672c\u63a7\u5236\u5305\u62ec\u5de6\u53f3\u50be\u659c\u88dd\u7f6e\u4ee5\u79fb\u52d5\u89d2\u8272\uff08\u756b\u5716\u4eba\uff09\u6a6b\u8de8\u87a2\u5e55\u3002\u5411\u5de6\u50be\u659c\u53ef\u79fb\u52d5\u5230\u5de6\u908a\uff0c\u5411\u53f3\u50be\u659c\u5247\u79fb\u52d5\u5230\u53f3\u908a\u3002\u6b64\u5916\uff0c\u8f15\u89f8\u87a2\u5e55\u53ef\u8b93\u756b\u5716\u4eba\u5411\u6575\u4eba\u767c\u5c04\u5b50\u5f48\u3002\u4f8b\u5982\uff0c\u5728\u9047\u5230\u98db\u789f\u6642\uff0c\u60a8\u53ef\u4ee5\u50be\u659c\u5c0d\u6e96\u5b83\u4e26\u8f15\u89f8\u4ee5\u64ca\u843d\u5b83\u3002\u719f\u7df4\u9019\u4e9b\u63a7\u5236\u5c0d\u65bc\u9019\u6b3e\u904a\u6232\u7684\u9032\u968e\u81f3\u95dc\u91cd\u8981\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u5728\u300a\u756b\u5716\u8df3\u8e8d\u300b\u4e2d\u7ba1\u7406\u8df3\u8e8d\u6642\u9593\u5f88\u91cd\u8981\uff1f", "answer": "\u5728\u300a\u756b\u5716\u8df3\u8e8d\u300b\u4e2d\u7ba1\u7406\u8df3\u8e8d\u6642\u9593\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6c7a\u5b9a\u4e86\u60a8\u5230\u9054\u66f4\u9ad8\u5e73\u53f0\u548c\u907f\u514d\u969c\u7919\u7269\u7684\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u8df3\u8e8d\u904e\u65e9\u6216\u904e\u9072\uff0c\u60a8\u53ef\u80fd\u6703\u932f\u904e\u4e00\u500b\u5e73\u53f0\u6216\u843d\u5728\u79fb\u52d5\u6216\u7834\u640d\u7684\u5e73\u53f0\u4e0a\u3002\u8acb\u900f\u904e\u89c0\u5bdf\u5e73\u53f0\u548c\u6575\u4eba\u7684\u79fb\u52d5\u6a21\u5f0f\u4f86\u7df4\u7fd2\u8a08\u6642\u8df3\u8e8d\u3002\u6301\u7e8c\u7684\u7df4\u7fd2\u5c07\u6709\u52a9\u65bc\u60a8\u5efa\u7acb\u6700\u5927\u5316\u60a8\u7684\u5206\u6578\u548c\u751f\u5b58\u6642\u9593\u7684\u7bc0\u594f\u3002"}, {"question": "\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u756b\u5716\u8df3\u8e8d\u300b\u4e2d\u6700\u5927\u5316\u4ed6\u5011\u7684\u5f97\u5206\uff1f", "answer": "\u7d93\u9a57\u8c50\u5bcc\u7684\u73a9\u5bb6\u53ef\u4ee5\u5728\u300a\u756b\u5716\u8df3\u8e8d\u300b\u4e2d\u6700\u5927\u5316\u4ed6\u5011\u7684\u5f97\u5206\uff0c\u65b9\u6cd5\u662f\u5c08\u6ce8\u65bc\u9023\u7e8c\u8df3\u8e8d\u548c\u6536\u96c6\u52a0\u5206\u9053\u5177\u3002\u4f8b\u5982\uff0c\u6301\u7e8c\u8457\u9678\u5728\u9023\u7e8c\u7684\u5f48\u7c27\u5e73\u53f0\u4e0a\u53ef\u4ee5\u5275\u9020\u4e00\u500b\u986f\u8457\u63d0\u5347\u60a8\u7684\u5206\u6578\u7684\u9023\u64ca\u3002\u6b64\u5916\uff0c\u59cb\u7d42\u81f4\u529b\u65bc\u6536\u96c6\u5674\u5c04\u80cc\u5305\u548c\u87ba\u65cb\u69f3\u5e3d\u5b50\u4ee5\u66f4\u5feb\u5730\u63d0\u5347\u548c\u907f\u514d\u5371\u96aa\u3002\u9019\u4e9b\u5143\u7d20\u7684\u7b56\u7565\u6027\u61c9\u7528\uff0c\u52a0\u4e0a\u7cbe\u78ba\u7684\u63a7\u5236\uff0c\u53ef\u4ee5\u9054\u5230\u7834\u7d00\u9304\u7684\u5206\u6578\u3002"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u6709\u52a9\u65bc\u5728\u300a\u756b\u5716\u8df3\u8e8d\u300b\u7684\u66f4\u5177\u6311\u6230\u6027\u7684\u95dc\u5361\u4e2d\u9032\u884c\u5c0e\u822a\uff1f", "answer": "\u5728\u300a\u756b\u5716\u8df3\u8e8d\u300b\u7684\u6311\u6230\u95dc\u5361\u4e2d\u9032\u884c\u5c0e\u822a\u9700\u8981\u5feb\u901f\u53cd\u61c9\u548c\u7b56\u7565\u898f\u5283\u7684\u7d50\u5408\u3002\u4f8b\u5982\uff0c\u5728\u9047\u5230\u591a\u500b\u79fb\u52d5\u5e73\u53f0\u6642\uff0c\u8acb\u9810\u6e2c\u5b83\u5011\u7684\u8def\u7dda\u4e26\u76f8\u61c9\u5730\u8a08\u6642\u8df3\u8e8d\u3002\u5229\u7528\u5674\u5c04\u80cc\u5305\u7b49\u52a0\u5206\u9053\u5177\u4f86\u7e5e\u904e\u56f0\u96e3\u7684\u90e8\u5206\u3002\u6b64\u5916\uff0c\u7df4\u7fd2\u8b58\u5225\u6575\u4eba\u7684\u884c\u70ba\u6a21\u5f0f\uff0c\u4ee5\u6709\u6548\u5730\u907f\u514d\u6216\u6d88\u6ec5\u4ed6\u5011\u3002\u9019\u4e9b\u7b56\u7565\u4e00\u65e6\u638c\u63e1\uff0c\u5c31\u80fd\u5e6b\u52a9\u60a8\u514b\u670d\u6700\u8271\u96e3\u7684\u95dc\u5361\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u4e86\u89e3\u5e73\u53f0\u985e\u578b\u5c0d\u65bc\u9ad8\u7d1a\u300a\u756b\u5716\u8df3\u8e8d\u300b\u904a\u6232\u81f3\u95dc\u91cd\u8981\uff1f", "answer": "\u4e86\u89e3\u5e73\u53f0\u985e\u578b\u5c0d\u65bc\u9ad8\u7d1a\u300a\u756b\u5716\u8df3\u8e8d\u300b\u904a\u6232\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u6bcf\u7a2e\u985e\u578b\u7684\u5e73\u53f0\u884c\u70ba\u65b9\u5f0f\u90fd\u4e0d\u540c\uff0c\u4e26\u4e14\u9700\u8981\u7368\u7279\u7684\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u79fb\u52d5\u5e73\u53f0\u6703\u6539\u8b8a\u4f4d\u7f6e\uff0c\u56e0\u6b64\u60a8\u9700\u8981\u6e96\u78ba\u8a08\u6642\u8df3\u8e8d\u3002\u7834\u58de\u5e73\u53f0\u5728\u55ae\u6b21\u8df3\u8e8d\u5f8c\u6d88\u5931\uff0c\u56e0\u6b64\u60a8\u5fc5\u9808\u5feb\u901f\u79fb\u52d5\u3002\u7df4\u7fd2\u8fa8\u8b58\u4e26\u9069\u61c9\u9019\u4e9b\u5e73\u53f0\u985e\u578b\u4ee5\u4fdd\u6301\u52d5\u529b\u4e26\u907f\u514d\u589c\u843d\u3002\u9019\u9805\u77e5\u8b58\u662f\u7372\u5f97\u66f4\u9ad8\u5206\u6578\u548c\u66f4\u9577\u6642\u9593\u904a\u6232\u9ad4\u9a57\u7684\u95dc\u9375\u3002"}, {"question": "\u300a\u756b\u5716\u8df3\u8e8d\u300b\u8a08\u5206\u7cfb\u7d71\u80cc\u5f8c\u7684\u95dc\u9375\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "\u300a\u756b\u5716\u8df3\u8e8d\u300b\u7684\u8a08\u5206\u7cfb\u7d71\u57fa\u65bc\u60a8\u9054\u5230\u7684\u9ad8\u5ea6\u548c\u6536\u96c6\u7684\u734e\u52f5\u3002\u60a8\u5728\u6bcf\u500b\u5e73\u53f0\u4e0a\u8457\u9678\u90fd\u6703\u589e\u52a0\u60a8\u7684\u5206\u6578\uff0c\u9ad8\u5ea6\u8f03\u9ad8\u7684\u5e73\u53f0\u8ca2\u737b\u7684\u5206\u6578\u8f03\u591a\u3002\u6b64\u5916\uff0c\u6536\u96c6\u786c\u5e63\u3001\u52a0\u5206\u9053\u5177\u7b49\u7269\u54c1\uff0c\u4e26\u64ca\u6557\u6575\u4eba\uff0c\u6703\u63d0\u4f9b\u984d\u5916\u5206\u6578\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u5674\u5c04\u80cc\u5305\u5feb\u901f\u4e0a\u5347\uff0c\u53ef\u4ee5\u5728\u77ed\u6642\u9593\u5167\u986f\u8457\u63d0\u5347\u60a8\u7684\u5206\u6578\u3002\u4e86\u89e3\u9019\u4e9b\u6a5f\u5236\uff0c\u8b93\u73a9\u5bb6\u53ef\u4ee5\u5236\u5b9a\u4ed6\u5011\u7684\u904a\u6232\u7b56\u7565\u4ee5\u6700\u5927\u5316\u4ed6\u5011\u7684\u7e3d\u5206\u3002"}, {"question": "\u300a\u756b\u5716\u8df3\u8e8d\u300b\u5982\u4f55\u5e73\u8861\u904a\u6232\u96e3\u5ea6\uff1f", "answer": "\u300a\u756b\u5716\u8df3\u8e8d\u300b\u900f\u904e\u7d50\u5408\u901f\u5ea6\u63d0\u5347\u548c\u5f15\u5165\u66f4\u8907\u96dc\u7684\u5e73\u53f0\u548c\u6575\u4eba\u6a21\u5f0f\u4f86\u5e73\u8861\u96e3\u5ea6\u3002\u96a8\u8457\u60a8\u5411\u4e0a\u63d0\u5347\uff0c\u904a\u6232\u901f\u5ea6\u6703\u52a0\u5feb\uff0c\u9700\u8981\u66f4\u5feb\u7684\u53cd\u61c9\u3002\u65b0\u7684\u969c\u7919\u7269\uff0c\u4f8b\u5982\u9ed1\u6d1e\u548c\u98db\u789f\uff0c\u6703\u88ab\u5f15\u5165\u4ee5\u6311\u6230\u73a9\u5bb6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u6c92\u6709\u907f\u514d\uff0c\u9ed1\u6d1e\u6703\u7a81\u7136\u7d50\u675f\u60a8\u7684\u904a\u6232\u3002\u9019\u7a2e\u52d5\u614b\u96e3\u5ea6\u78ba\u4fdd\u904a\u6232\u96a8\u8457\u73a9\u5bb6\u6280\u80fd\u7684\u63d0\u5347\u800c\u4fdd\u6301\u6311\u6230\u6027\u548c\u5438\u5f15\u529b\u3002"}, {"question": "\u73a9\u5bb6\u5728\u66f4\u63db\u88dd\u7f6e\u73a9\u300a\u756b\u5716\u8df3\u8e8d\u300b\u6642\uff0c\u61c9\u8a72\u77e5\u9053\u95dc\u65bc\u8cc7\u6599\u9077\u79fb\u7684\u4ec0\u9ebc\uff1f", "answer": "\u7576\u60a8\u66f4\u63db\u88dd\u7f6e\u73a9\u300a\u756b\u5716\u8df3\u8e8d\u300b\u6642\uff0c\u73a9\u5bb6\u61c9\u8a72\u78ba\u4fdd\u4f7f\u7528\u76f8\u540c\u7684\u5e33\u6236\u540c\u6b65\u4ed6\u5011\u7684\u904a\u6232\u9032\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9e iOS \u88dd\u7f6e\u8f49\u79fb\u5230 Android \u88dd\u7f6e\uff0c\u8acb\u4f7f\u7528\u76f8\u540c\u7684 Google Play \u6216 Apple ID \u767b\u5165\uff0c\u4ee5\u5b58\u53d6\u60a8\u7684\u5132\u5b58\u8cc7\u6599\u3002\u8acb\u6aa2\u67e5\u904a\u6232\u8a2d\u5b9a\u7684\u96f2\u7aef\u5132\u5b58\u9078\u9805\u4ee5\u4fc3\u9032\u9806\u5229\u8f49\u63db\u3002\u6b63\u78ba\u7ba1\u7406\u8cc7\u6599\u9077\u79fb\u53ef\u78ba\u4fdd\u60a8\u7684\u9ad8\u5206\u548c\u6210\u5c31\u53ef\u4ee5\u5728\u4e0d\u540c\u88dd\u7f6e\u4e0a\u4fdd\u7559\u3002"}, {"question": "\u300a\u756b\u5716\u8df3\u8e8d\u300b\u4e2d\u662f\u5426\u6709\u4efb\u4f55\u96b1\u85cf\u79d8\u5bc6\u6216\u5f69\u86cb\uff1f", "answer": "\u662f\u7684\uff0c\u300a\u756b\u5716\u8df3\u8e8d\u300b\u5305\u542b\u96b1\u85cf\u79d8\u5bc6\u548c\u5f69\u86cb\uff0c\u9019\u589e\u52a0\u4e86\u904a\u6232\u7684\u9b45\u529b\u3002\u4f8b\u5982\uff0c\u5728\u7279\u5b9a\u689d\u4ef6\u4e0b\u53ef\u4ee5\u89e3\u9396\u7a00\u6709\u7684\u7279\u6b8a\u5e73\u53f0\u6216\u89d2\u8272\uff0c\u5982\u5916\u661f\u756b\u5716\u4eba\u3002\u63a2\u7d22\u4e0d\u540c\u7684\u4e3b\u984c\u548c\u80cc\u666f\u4e5f\u53ef\u80fd\u6703\u767c\u73fe\u7368\u7279\u7684\u5143\u7d20\u3002\u8acb\u6ce8\u610f\u9019\u4e9b\u9a5a\u559c\uff0c\u56e0\u70ba\u5b83\u5011\u53ef\u4ee5\u589e\u5f37\u60a8\u7684\u904a\u6232\u9ad4\u9a57\uff0c\u4e26\u63d0\u4f9b\u984d\u5916\u7684\u6311\u6230\u548c\u734e\u52f5\u3002"}]
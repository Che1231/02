[{"question": "\u521d\u5fc3\u8005\u306e\u65b9\u3005\u306f\u3001\u30c9\u30fc\u30c9\u30a5\u30eb\u30b8\u30e3\u30f3\u30d7\u3067\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u52b9\u679c\u7684\u306b\u3069\u306e\u3088\u3046\u306b\u5236\u5fa1\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30c9\u30fc\u30c9\u30a5\u30eb\u30b8\u30e3\u30f3\u30d7\u3067\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u52b9\u679c\u7684\u306b\u5236\u5fa1\u3059\u308b\u306b\u306f\u3001\u521d\u5fc3\u8005\u306f\u50be\u304d\u53cd\u5fdc\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u8a2d\u5b9a\u3067\u50be\u304d\u53cd\u5fdc\u3092\u5feb\u9069\u306a\u30ec\u30d9\u30eb\u306b\u8abf\u6574\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u4f4e\u3044\u53cd\u5fdc\u306f\u3001\u65b0\u3057\u3044\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u901a\u308a\u904e\u304e\u306a\u3044\u3088\u3046\u306b\u3059\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002\u7df4\u7fd2\u306f\u5b8c\u74a7\u306a\u5e2b\u3067\u3042\u308a\u3001\u77ed\u3044\u6642\u9593\u3001\u983b\u7e41\u306a\u30bb\u30c3\u30b7\u30e7\u30f3\u3067\u30b2\u30fc\u30e0\u3092\u30d7\u30ec\u30a4\u3059\u308b\u3053\u3068\u3067\u3001\u5236\u5fa1\u306b\u6163\u308c\u308b\u6642\u9593\u3092\u8cbb\u3084\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u306e\u30a2\u30d7\u30ed\u30fc\u30c1\u306f\u3001\u7b4b\u8089\u8a18\u61b6\u306e\u69cb\u7bc9\u3092\u52a9\u3051\u3001\u6642\u9593\u306e\u7d4c\u904e\u3068\u3068\u3082\u306b\u7cbe\u5ea6\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002"}, {"question": "\u30c9\u30fc\u30c9\u30a5\u30eb\u30b8\u30e3\u30f3\u30d7\u306e\u57fa\u672c\u7684\u306a\u64cd\u4f5c\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30c9\u30fc\u30c9\u30a5\u30eb\u30b8\u30e3\u30f3\u30d7\u306e\u57fa\u672c\u64cd\u4f5c\u306f\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\uff08\u30c9\u30fc\u30c9\u30a5\u30e9\u30fc\uff09\u3092\u753b\u9762\u4e0a\u3092\u79fb\u52d5\u3055\u305b\u308b\u305f\u3081\u306b\u3001\u30c7\u30d0\u30a4\u30b9\u3092\u5de6\u53f3\u306b\u50be\u3051\u308b\u3053\u3068\u3067\u3059\u3002\u5de6\u306b\u50be\u3051\u308b\u3068\u5de6\u3078\u3001\u53f3\u306b\u50be\u3051\u308b\u3068\u53f3\u3078\u79fb\u52d5\u3057\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u753b\u9762\u3092\u30bf\u30c3\u30d7\u3059\u308b\u3068\u3001\u30c9\u30fc\u30c9\u30a5\u30e9\u30fc\u306f\u6575\u306b\u5f3e\u4e38\u3092\u767a\u5c04\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001UFO\u306b\u51fa\u304f\u308f\u3057\u305f\u5834\u5408\u3001\u305d\u308c\u306b\u5408\u308f\u305b\u308b\u3088\u3046\u306b\u50be\u3051\u3066\u30bf\u30c3\u30d7\u3059\u308b\u3068\u6483\u3061\u843d\u3068\u305b\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u64cd\u4f5c\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308b\u3053\u3068\u306f\u3001\u30b2\u30fc\u30e0\u3092\u30af\u30ea\u30a2\u3059\u308b\u4e0a\u3067\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002"}, {"question": "\u30c9\u30fc\u30c9\u30a5\u30eb\u30b8\u30e3\u30f3\u30d7\u3067\u30b8\u30e3\u30f3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u7ba1\u7406\u3059\u308b\u3053\u3068\u306f\u306a\u305c\u91cd\u8981\u3067\u3059\u304b\uff1f", "answer": "\u30c9\u30fc\u30c9\u30a5\u30eb\u30b8\u30e3\u30f3\u30d7\u3067\u30b8\u30e3\u30f3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u7ba1\u7406\u3059\u308b\u3053\u3068\u306f\u975e\u5e38\u306b\u91cd\u8981\u3067\u3059\u3002\u306a\u305c\u306a\u3089\u3001\u3088\u308a\u9ad8\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u5230\u9054\u3057\u3001\u969c\u5bb3\u7269\u3092\u56de\u907f\u3059\u308b\u52b9\u7387\u3092\u6c7a\u5b9a\u3059\u308b\u304b\u3089\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u65e9\u3059\u304e\u308b\u3001\u307e\u305f\u306f\u9045\u3059\u304e\u308b\u30b8\u30e3\u30f3\u30d7\u3092\u3059\u308b\u3068\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3092\u9003\u3057\u305f\u308a\u3001\u52d5\u304f\u304b\u58ca\u308c\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u7740\u9678\u3057\u305f\u308a\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3068\u6575\u306e\u52d5\u304d\u3092\u6ce8\u610f\u6df1\u304f\u89b3\u5bdf\u3057\u3066\u3001\u30b8\u30e3\u30f3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u7df4\u7fd2\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u7d99\u7d9a\u7684\u306a\u7df4\u7fd2\u306f\u3001\u30b9\u30b3\u30a2\u3068\u751f\u5b58\u6642\u9593\u3092\u6700\u5927\u9650\u306b\u5f15\u304d\u51fa\u3059\u30ea\u30ba\u30e0\u3092\u8eab\u306b\u3064\u3051\u308b\u306e\u306b\u5f79\u7acb\u3061\u307e\u3059\u3002"}, {"question": "\u7d4c\u9a13\u8c4a\u5bcc\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30c9\u30fc\u30c9\u30a5\u30eb\u30b8\u30e3\u30f3\u30d7\u3067\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u7d4c\u9a13\u8c4a\u5bcc\u306a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30b3\u30f3\u30dc\u30b8\u30e3\u30f3\u30d7\u3068\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306e\u30b3\u30ec\u30af\u30b7\u30e7\u30f3\u306b\u96c6\u4e2d\u3059\u308b\u3053\u3068\u3067\u3001\u30c9\u30fc\u30c9\u30a5\u30eb\u30b8\u30e3\u30f3\u30d7\u3067\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u9023\u7d9a\u3059\u308b\u30d0\u30cd\u4ed8\u304d\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u9023\u7d9a\u3057\u3066\u7740\u5730\u3059\u308b\u3068\u3001\u30b9\u30b3\u30a2\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u308b\u30b3\u30f3\u30dc\u304c\u4f5c\u6210\u3055\u308c\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30b8\u30a7\u30c3\u30c8\u30d1\u30c3\u30af\u3084\u30d7\u30ed\u30da\u30e9\u5e3d\u5b50\u3092\u96c6\u3081\u308b\u3053\u3068\u3092\u5e38\u306b\u76ee\u6307\u3057\u3066\u3001\u3088\u308a\u65e9\u304f\u4e0a\u6607\u3057\u3001\u5371\u967a\u3092\u56de\u907f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u3089\u306e\u8981\u7d20\u3092\u6226\u7565\u7684\u306b\u4f7f\u7528\u3057\u3001\u6b63\u78ba\u306a\u5236\u5fa1\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3001\u8a18\u9332\u7684\u306a\u30b9\u30b3\u30a2\u3092\u9054\u6210\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u3088\u308a\u96e3\u3057\u3044\u30ec\u30d9\u30eb\u3092\u30af\u30ea\u30a2\u3059\u308b\u305f\u3081\u306e\u6226\u7565\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u30c9\u30fc\u30c9\u30a5\u30eb\u30b8\u30e3\u30f3\u30d7\u306e\u96e3\u3057\u3044\u30ec\u30d9\u30eb\u3092\u653b\u7565\u3059\u308b\u306b\u306f\u3001\u7d20\u65e9\u3044\u53cd\u5fdc\u3068\u6226\u7565\u7684\u306a\u8a08\u753b\u306e\u7d44\u307f\u5408\u308f\u305b\u304c\u5fc5\u8981\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u8907\u6570\u306e\u52d5\u3044\u3066\u3044\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u906d\u9047\u3057\u305f\u5834\u5408\u306f\u3001\u305d\u306e\u52d5\u304d\u3092\u4e88\u6e2c\u3057\u3001\u305d\u308c\u306b\u5408\u308f\u305b\u3066\u30b8\u30e3\u30f3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u8abf\u6574\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b8\u30a7\u30c3\u30c8\u30d1\u30c3\u30af\u306a\u3069\u306e\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3092\u6d3b\u7528\u3057\u3066\u3001\u96e3\u3057\u3044\u30bb\u30af\u30b7\u30e7\u30f3\u3092\u8fc2\u56de\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u307e\u305f\u3001\u6575\u306e\u884c\u52d5\u30d1\u30bf\u30fc\u30f3\u3092\u8a8d\u8b58\u3057\u3066\u52b9\u7387\u7684\u306b\u56de\u907f\u3057\u305f\u308a\u6392\u9664\u3057\u305f\u308a\u3059\u308b\u7df4\u7fd2\u3082\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u308c\u3089\u306e\u6226\u7565\u3092\u30de\u30b9\u30bf\u30fc\u3059\u308c\u3070\u3001\u3069\u3093\u306a\u306b\u96e3\u3057\u3044\u30ec\u30d9\u30eb\u3082\u4e57\u308a\u8d8a\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u9ad8\u5ea6\u306a\u30c9\u30fc\u30c9\u30a5\u30eb\u30b8\u30e3\u30f3\u30d7\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u304a\u3044\u3066\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u7a2e\u985e\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u306a\u305c\u91cd\u8981\u3067\u3059\u304b\uff1f", "answer": "\u9ad8\u5ea6\u306a\u30c9\u30fc\u30c9\u30a5\u30eb\u30b8\u30e3\u30f3\u30d7\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u306b\u304a\u3044\u3066\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u7a2e\u985e\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306f\u91cd\u8981\u3067\u3059\u3002\u306a\u305c\u306a\u3089\u3001\u5404\u7a2e\u985e\u306f\u7570\u306a\u308b\u6319\u52d5\u3092\u793a\u3057\u3001\u72ec\u81ea\u306e\u6226\u7565\u304c\u5fc5\u8981\u306b\u306a\u308b\u304b\u3089\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u52d5\u304f\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306f\u4f4d\u7f6e\u3092\u5909\u3048\u308b\u306e\u3067\u3001\u6b63\u78ba\u306a\u30b8\u30e3\u30f3\u30d7\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u5fc5\u8981\u3067\u3059\u3002\u58ca\u308c\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306f\u4e00\u5ea6\u30b8\u30e3\u30f3\u30d7\u3059\u308b\u3068\u6d88\u3048\u308b\u305f\u3081\u3001\u7d20\u65e9\u304f\u79fb\u52d5\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u7a2e\u985e\u3092\u7279\u5b9a\u3057\u3001\u305d\u308c\u306b\u9069\u5fdc\u3059\u308b\u7df4\u7fd2\u3092\u7a4d\u3080\u3053\u3068\u3067\u3001\u52e2\u3044\u3092\u7dad\u6301\u3057\u3001\u843d\u4e0b\u3092\u907f\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u77e5\u8b58\u306f\u3001\u3088\u308a\u9ad8\u3044\u30b9\u30b3\u30a2\u3068\u3088\u308a\u9577\u3044\u30d7\u30ec\u30a4\u6642\u9593\u3092\u5b9f\u73fe\u3059\u308b\u4e0a\u3067\u91cd\u8981\u3067\u3059\u3002"}, {"question": "\u30c9\u30fc\u30c9\u30a5\u30eb\u30b8\u30e3\u30f3\u30d7\u306e\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306e\u80cc\u5f8c\u306b\u3042\u308b\u4e3b\u8981\u306a\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30c9\u30fc\u30c9\u30a5\u30eb\u30b8\u30e3\u30f3\u30d7\u306e\u5f97\u70b9\u30b7\u30b9\u30c6\u30e0\u306f\u3001\u9054\u6210\u3057\u305f\u9ad8\u3055\u3001\u304a\u3088\u3073\u53ce\u96c6\u3057\u305f\u30dc\u30fc\u30ca\u30b9\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u5404\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306b\u7740\u5730\u3059\u308b\u305f\u3073\u306b\u30b9\u30b3\u30a2\u304c\u52a0\u7b97\u3055\u308c\u3001\u3088\u308a\u9ad8\u3044\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u307b\u3069\u591a\u304f\u306e\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u3055\u3089\u306b\u3001\u30b3\u30a4\u30f3\u3084\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u306a\u3069\u306e\u30a2\u30a4\u30c6\u30e0\u3092\u53ce\u96c6\u3057\u305f\u308a\u3001\u6575\u3092\u5012\u3057\u305f\u308a\u3059\u308b\u3053\u3068\u3067\u3001\u8ffd\u52a0\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30b8\u30a7\u30c3\u30c8\u30d1\u30c3\u30af\u3092\u4f7f\u7528\u3057\u3066\u6025\u4e0a\u6607\u3059\u308b\u3068\u3001\u77ed\u6642\u9593\u3067\u30b9\u30b3\u30a2\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u306b\u3088\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u3092\u6226\u7565\u7684\u306b\u8abf\u6574\u3057\u3066\u7dcf\u5408\u7684\u306a\u30b9\u30b3\u30a2\u3092\u6700\u5927\u5316\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30c9\u30fc\u30c9\u30a5\u30eb\u30b8\u30e3\u30f3\u30d7\u306b\u304a\u3051\u308b\u96e3\u6613\u5ea6\u8abf\u6574\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30c9\u30fc\u30c9\u30a5\u30eb\u30b8\u30e3\u30f3\u30d7\u306e\u96e3\u6613\u5ea6\u8abf\u6574\u306f\u3001\u901f\u5ea6\u306e\u5411\u4e0a\u3001\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3068\u6575\u306e\u30d1\u30bf\u30fc\u30f3\u306e\u8907\u96d1\u5316\u306e\u7d44\u307f\u5408\u308f\u305b\u306b\u3088\u3063\u3066\u884c\u308f\u308c\u307e\u3059\u3002\u4e0a\u6607\u3059\u308b\u306b\u3064\u308c\u3066\u3001\u30b2\u30fc\u30e0\u306e\u901f\u5ea6\u304c\u901f\u304f\u306a\u308a\u3001\u3088\u308a\u8fc5\u901f\u306a\u53cd\u5fdc\u304c\u6c42\u3081\u3089\u308c\u307e\u3059\u3002\u30d6\u30e9\u30c3\u30af\u30db\u30fc\u30eb\u3084UFO\u306e\u3088\u3046\u306a\u65b0\u3057\u3044\u969c\u5bb3\u7269\u304c\u5c0e\u5165\u3055\u308c\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u6311\u6226\u3055\u305b\u3089\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u30d6\u30e9\u30c3\u30af\u30db\u30fc\u30eb\u306f\u56de\u907f\u3057\u306a\u3044\u3068\u3001\u6025\u306a\u4e2d\u65ad\u3092\u3082\u305f\u3089\u3059\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u306e\u30c0\u30a4\u30ca\u30df\u30c3\u30af\u306a\u96e3\u6613\u5ea6\u306b\u3088\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u30b9\u30ad\u30eb\u3092\u5411\u4e0a\u3055\u305b\u308b\u306b\u3064\u308c\u3066\u3001\u30b2\u30fc\u30e0\u304c\u5e38\u306b\u6311\u6226\u7684\u3067\u9b45\u529b\u7684\u306a\u307e\u307e\u3067\u3044\u3089\u308c\u307e\u3059\u3002"}, {"question": "\u30c7\u30d0\u30a4\u30b9\u3092\u5207\u308a\u66ff\u3048\u3066\u30c9\u30fc\u30c9\u30a5\u30eb\u30b8\u30e3\u30f3\u30d7\u3092\u3059\u308b\u969b\u306b\u3001\u30c7\u30fc\u30bf\u79fb\u884c\u306b\u3064\u3044\u3066\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u77e5\u3063\u3066\u304a\u304f\u3079\u304d\u3053\u3068\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30c7\u30d0\u30a4\u30b9\u3092\u5207\u308a\u66ff\u3048\u3066\u30c9\u30fc\u30c9\u30a5\u30eb\u30b8\u30e3\u30f3\u30d7\u3092\u3059\u308b\u5834\u5408\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u9032\u884c\u72b6\u6cc1\u3092\u540c\u671f\u3059\u308b\u305f\u3081\u306b\u3001\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u4f7f\u7528\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001iOS\u304b\u3089Android\u30c7\u30d0\u30a4\u30b9\u306b\u79fb\u884c\u3059\u308b\u5834\u5408\u3001\u4fdd\u5b58\u3055\u308c\u305f\u30c7\u30fc\u30bf\u3092\u30a2\u30af\u30bb\u30b9\u30d1\u30bf\u30fc\u30f3\u306b\u3059\u308b\u305f\u3081\u306b\u540c\u3058Google Play\u307e\u305f\u306fApple ID\u3067\u30ed\u30b0\u30a4\u30f3\u3057\u307e\u3059\u3002\u30b9\u30e0\u30fc\u30ba\u306a\u79fb\u884c\u3092\u4fc3\u9032\u3059\u308b\u305f\u3081\u306b\u3001\u30b2\u30fc\u30e0\u306e\u8a2d\u5b9a\u3067\u30af\u30e9\u30a6\u30c9\u4fdd\u5b58\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u30c1\u30a7\u30c3\u30af\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30c7\u30fc\u30bf\u79fb\u884c\u3092\u9069\u5207\u306b\u7ba1\u7406\u3059\u308b\u3053\u3068\u3067\u3001\u3055\u307e\u3056\u307e\u306a\u30c7\u30d0\u30a4\u30b9\u3067\u9ad8\u30b9\u30b3\u30a2\u3084\u9054\u6210\u3057\u305f\u3082\u306e\u3092\u7dad\u6301\u3067\u304d\u307e\u3059\u3002"}, {"question": "\u30c9\u30fc\u30c9\u30a5\u30eb\u30b8\u30e3\u30f3\u30d7\u306b\u306f\u96a0\u3055\u308c\u305f\u79d8\u5bc6\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u306f\u3042\u308a\u307e\u3059\u304b\uff1f", "answer": "\u306f\u3044\u3001\u30c9\u30fc\u30c9\u30a5\u30eb\u30b8\u30e3\u30f3\u30d7\u306b\u306f\u3001\u30b2\u30fc\u30e0\u306e\u9b45\u529b\u3092\u9ad8\u3081\u308b\u96a0\u3055\u308c\u305f\u79d8\u5bc6\u3084\u30a4\u30fc\u30b9\u30bf\u30fc\u30a8\u30c3\u30b0\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u7279\u5b9a\u306e\u6761\u4ef6\u4e0b\u3067\u30a2\u30f3\u30ed\u30c3\u30af\u3067\u304d\u308b\u3001\u7279\u5225\u306a\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3084\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\uff08\u30a8\u30a4\u30ea\u30a2\u30f3\u30fb\u30c9\u30fc\u30c9\u30a5\u30e9\u30fc\uff09\u306a\u3069\u3001\u73cd\u3057\u3044\u51fa\u73fe\u304c\u3042\u308a\u307e\u3059\u3002\u3055\u307e\u3056\u307e\u306a\u30c6\u30fc\u30de\u3084\u80cc\u666f\u3092\u63a2\u6c42\u3059\u308b\u3053\u3068\u3067\u3001\u30e6\u30cb\u30fc\u30af\u306a\u8981\u7d20\u3092\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u9a5a\u304d\u3092\u898b\u9003\u3055\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002\u305d\u308c\u3089\u306f\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u4f53\u9a13\u3092\u5f37\u5316\u3057\u3001\u8ffd\u52a0\u306e\u8ab2\u984c\u3068\u5831\u916c\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002"}]
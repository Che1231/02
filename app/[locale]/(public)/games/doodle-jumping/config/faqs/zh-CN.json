[{"question": "\u521d\u5b66\u8005\u5982\u4f55\u5728\u300a\u6d82\u9e26\u8df3\u8dc3\u300b\u4e2d\u6709\u6548\u63a7\u5236\u89d2\u8272\uff1f", "answer": "\u5728\u300a\u6d82\u9e26\u8df3\u8dc3\u300b\u4e2d\u6709\u6548\u63a7\u5236\u89d2\u8272\uff0c\u521d\u5b66\u8005\u5e94\u4e13\u6ce8\u4e8e\u503e\u659c\u7075\u654f\u5ea6\u3002\u8c03\u6574\u8bbe\u7f6e\u4e2d\u7684\u503e\u659c\u7075\u654f\u5ea6\u81f3\u8212\u9002\u7a0b\u5ea6\u3002\u4f8b\u5982\uff0c\u8f83\u4f4e\u7684\u7075\u654f\u5ea6\u53ef\u80fd\u6709\u52a9\u4e8e\u65b0\u73a9\u5bb6\u907f\u514d\u8fc7\u5ea6\u8de8\u8d8a\u5e73\u53f0\u3002\u719f\u80fd\u751f\u5de7\uff0c\u56e0\u6b64\u8bf7\u82b1\u65f6\u95f4\u901a\u8fc7\u77ed\u9891\u5feb\u7684\u6e38\u620f\u6765\u9002\u5e94\u63a7\u5236\uff0c\u8fd9\u6709\u52a9\u4e8e\u5efa\u7acb\u808c\u8089\u8bb0\u5fc6\u5e76\u968f\u7740\u65f6\u95f4\u7684\u63a8\u79fb\u63d0\u9ad8\u7cbe\u786e\u5ea6\u3002"}, {"question": "\u300a\u6d82\u9e26\u8df3\u8dc3\u300b\u7684\u57fa\u672c\u63a7\u5236\u6709\u54ea\u4e9b\uff0c\u5b83\u4eec\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u300a\u6d82\u9e26\u8df3\u8dc3\u300b\u7684\u57fa\u672c\u63a7\u5236\u5305\u62ec\u5de6\u53f3\u503e\u659c\u8bbe\u5907\u6765\u79fb\u52a8\u89d2\u8272\uff08\u6d82\u9e26\u4eba\uff09\u5728\u5c4f\u5e55\u4e0a\u79fb\u52a8\u3002\u5411\u5de6\u503e\u659c\u4ee5\u5411\u5de6\u79fb\u52a8\uff0c\u5411\u53f3\u503e\u659c\u4ee5\u5411\u53f3\u79fb\u52a8\u3002\u6b64\u5916\uff0c\u70b9\u51fb\u5c4f\u5e55\u5141\u8bb8\u6d82\u9e26\u4eba\u5411\u654c\u4eba\u53d1\u5c04\u5f39\u4e38\u3002\u4f8b\u5982\uff0c\u9047\u5230UFO\u65f6\uff0c\u60a8\u53ef\u4ee5\u503e\u659c\u5bf9\u51c6\u5b83\u5e76\u70b9\u51fb\u53d1\u5c04\u5c06\u5176\u51fb\u843d\u3002\u719f\u7ec3\u638c\u63e1\u8fd9\u4e9b\u63a7\u5236\u5bf9\u4e8e\u6e38\u620f\u8fdb\u5ea6\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u5728\u300a\u6d82\u9e26\u8df3\u8dc3\u300b\u4e2d\uff0c\u4e3a\u4ec0\u4e48\u7ba1\u7406\u8df3\u8dc3\u65f6\u673a\u5f88\u91cd\u8981\uff1f", "answer": "\u5728\u300a\u6d82\u9e26\u8df3\u8dc3\u300b\u4e2d\uff0c\u7ba1\u7406\u8df3\u8dc3\u65f6\u673a\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u51b3\u5b9a\u4e86\u60a8\u6709\u6548\u5230\u8fbe\u8f83\u9ad8\u5e73\u53f0\u5e76\u8eb2\u907f\u969c\u788d\u7684\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u5982\u679c\u8df3\u8dc3\u8fc7\u65e9\u6216\u8fc7\u665a\uff0c\u60a8\u53ef\u80fd\u4f1a\u9519\u8fc7\u5e73\u53f0\u6216\u843d\u5728\u79fb\u52a8\u6216\u7834\u788e\u7684\u5e73\u53f0\u4e0a\u3002\u901a\u8fc7\u89c2\u5bdf\u5e73\u53f0\u548c\u654c\u4eba\u7684\u79fb\u52a8\u6a21\u5f0f\u6765\u7ec3\u4e60\u8df3\u8dc3\u65f6\u673a\u3002\u6301\u7eed\u7ec3\u4e60\u5c06\u5e2e\u52a9\u60a8\u5f00\u53d1\u6700\u5927\u5316\u5206\u6570\u548c\u751f\u5b58\u65f6\u95f4\u7684\u8282\u594f\u3002"}, {"question": "\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u6d82\u9e26\u8df3\u8dc3\u300b\u4e2d\u6700\u5927\u5316\u5206\u6570\uff1f", "answer": "\u7ecf\u9a8c\u4e30\u5bcc\u7684\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u4e13\u6ce8\u4e8e\u8fde\u8df3\u548c\u6536\u96c6\u9053\u5177\u6765\u6700\u5927\u5316\u300a\u6d82\u9e26\u8df3\u8dc3\u300b\u4e2d\u7684\u5206\u6570\u3002\u4f8b\u5982\uff0c\u8fde\u7eed\u843d\u5728\u5f39\u7c27\u5e73\u53f0\u4e0a\u53ef\u4ee5\u521b\u9020\u51fa\u663e\u7740\u63d0\u5347\u5206\u6570\u7684\u8fde\u8df3\u3002\u6b64\u5916\uff0c\u59cb\u7ec8\u65e8\u5728\u6536\u96c6\u55b7\u6c14\u80cc\u5305\u548c\u87ba\u65cb\u6868\u5e3d\u4ee5\u66f4\u5feb\u5730\u4e0a\u5347\u5e76\u907f\u514d\u5371\u9669\u3002\u8fd9\u4e9b\u5143\u7d20\u7684\u6218\u7565\u6027\u4f7f\u7528\u4e0e\u7cbe\u786e\u63a7\u5236\u76f8\u7ed3\u5408\uff0c\u53ef\u4ee5\u521b\u9020\u7834\u7eaa\u5f55\u7684\u5206\u6570\u3002"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u6709\u52a9\u4e8e\u5728\u300a\u6d82\u9e26\u8df3\u8dc3\u300b\u7684\u66f4\u5177\u6311\u6218\u6027\u7684\u5173\u5361\u4e2d\u5bfc\u822a\uff1f", "answer": "\u5728\u300a\u6d82\u9e26\u8df3\u8dc3\u300b\u7684\u5177\u6709\u6311\u6218\u6027\u7684\u5173\u5361\u4e2d\u5bfc\u822a\u9700\u8981\u5feb\u901f\u53cd\u5e94\u548c\u6218\u7565\u89c4\u5212\u7684\u7ed3\u5408\u3002\u4f8b\u5982\uff0c\u5728\u9047\u5230\u591a\u4e2a\u79fb\u52a8\u5e73\u53f0\u65f6\uff0c\u8bf7\u9884\u6d4b\u5176\u8def\u5f84\u5e76\u76f8\u5e94\u5730\u8c03\u6574\u8df3\u8dc3\u65f6\u673a\u3002\u5229\u7528\u8bf8\u5982\u55b7\u6c14\u80cc\u5305\u4e4b\u7c7b\u7684\u9053\u5177\u6765\u7ed5\u8fc7\u56f0\u96be\u533a\u57df\u3002\u6b64\u5916\uff0c\u7ec3\u4e60\u8bc6\u522b\u654c\u4eba\u7684\u884c\u4e3a\u6a21\u5f0f\u4ee5\u6709\u6548\u5730\u907f\u514d\u6216\u6d88\u9664\u5b83\u4eec\u3002\u638c\u63e1\u8fd9\u4e9b\u7b56\u7565\u53ef\u4ee5\u5e2e\u52a9\u60a8\u514b\u670d\u751a\u81f3\u6700\u8270\u96be\u7684\u5173\u5361\u3002"}, {"question": "\u4e3a\u4ec0\u4e48\u7406\u89e3\u5e73\u53f0\u7c7b\u578b\u5bf9\u4e8e\u9ad8\u7ea7\u300a\u6d82\u9e26\u8df3\u8dc3\u300b\u6e38\u620f\u81f3\u5173\u91cd\u8981\uff1f", "answer": "\u7406\u89e3\u5e73\u53f0\u7c7b\u578b\u5bf9\u4e8e\u9ad8\u7ea7\u300a\u6d82\u9e26\u8df3\u8dc3\u300b\u6e38\u620f\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u6bcf\u79cd\u7c7b\u578b\u90fd\u4ee5\u4e0d\u540c\u7684\u65b9\u5f0f\u8fd0\u4f5c\uff0c\u9700\u8981\u72ec\u7279\u7684\u7b56\u7565\u3002\u4f8b\u5982\uff0c\u79fb\u52a8\u5e73\u53f0\u4f1a\u6539\u53d8\u4f4d\u7f6e\uff0c\u56e0\u6b64\u60a8\u9700\u8981\u7cbe\u786e\u5730\u8c03\u6574\u8df3\u8dc3\u65f6\u673a\u3002\u7834\u788e\u5e73\u53f0\u5728\u5355\u6b21\u8df3\u8dc3\u540e\u6d88\u5931\uff0c\u56e0\u6b64\u60a8\u5fc5\u987b\u5feb\u901f\u79fb\u52a8\u3002\u7ec3\u4e60\u8bc6\u522b\u5e76\u9002\u5e94\u8fd9\u4e9b\u5e73\u53f0\u7c7b\u578b\uff0c\u4ee5\u4fdd\u6301\u52a8\u529b\u5e76\u907f\u514d\u5760\u843d\u3002\u8fd9\u4e9b\u77e5\u8bc6\u5bf9\u4e8e\u83b7\u5f97\u66f4\u9ad8\u7684\u5206\u6570\u548c\u66f4\u957f\u7684\u6e38\u620f\u65f6\u95f4\u81f3\u5173\u91cd\u8981\u3002"}, {"question": "\u300a\u6d82\u9e26\u8df3\u8dc3\u300b\u8bc4\u5206\u7cfb\u7edf\u80cc\u540e\u7684\u5173\u952e\u673a\u5236\u662f\u4ec0\u4e48\uff1f", "answer": "\u300a\u6d82\u9e26\u8df3\u8dc3\u300b\u7684\u8bc4\u5206\u7cfb\u7edf\u57fa\u4e8e\u60a8\u8fbe\u5230\u7684\u9ad8\u5ea6\u548c\u6536\u96c6\u7684\u5956\u52b1\u3002\u60a8\u843d\u5728\u6bcf\u4e2a\u5e73\u53f0\u4e0a\u90fd\u4f1a\u589e\u52a0\u5206\u6570\uff0c\u9ad8\u5ea6\u8f83\u9ad8\u7684\u5e73\u53f0\u8d21\u732e\u7684\u5206\u6570\u4e5f\u66f4\u591a\u3002\u6b64\u5916\uff0c\u6536\u96c6\u786c\u5e01\u548c\u9053\u5177\u7b49\u7269\u54c1\u4ee5\u53ca\u51fb\u8d25\u654c\u4eba\u4e5f\u4f1a\u989d\u5916\u83b7\u5f97\u5206\u6570\u3002\u4f8b\u5982\uff0c\u4f7f\u7528\u55b7\u6c14\u80cc\u5305\u5feb\u901f\u4e0a\u5347\u53ef\u4ee5\u5728\u77ed\u65f6\u95f4\u5185\u663e\u7740\u63d0\u9ad8\u60a8\u7684\u5206\u6570\u3002\u4e86\u89e3\u8fd9\u4e9b\u673a\u5236\u5c06\u4f7f\u73a9\u5bb6\u80fd\u591f\u5236\u5b9a\u6e38\u620f\u7b56\u7565\u4ee5\u6700\u5927\u5316\u5176\u603b\u5206\u3002"}, {"question": "\u300a\u6d82\u9e26\u8df3\u8dc3\u300b\u5982\u4f55\u5e73\u8861\u6e38\u620f\u7684\u96be\u5ea6\uff1f", "answer": "\u300a\u6d82\u9e26\u8df3\u8dc3\u300b\u901a\u8fc7\u7ed3\u5408\u901f\u5ea6\u589e\u52a0\u548c\u5f15\u5165\u66f4\u590d\u6742\u7684\u5e73\u53f0\u548c\u654c\u4eba\u6a21\u5f0f\u6765\u5e73\u8861\u6e38\u620f\u96be\u5ea6\u3002\u968f\u7740\u60a8\u6500\u5347\uff0c\u6e38\u620f\u901f\u5ea6\u52a0\u5feb\uff0c\u9700\u8981\u66f4\u5feb\u7684\u53cd\u5e94\u3002\u65b0\u7684\u969c\u788d\uff0c\u4f8b\u5982\u9ed1\u6d1e\u548cUFO\uff0c\u88ab\u5f15\u5165\u4ee5\u6311\u6218\u73a9\u5bb6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u907f\u5f00\u4e0d\u4e86\uff0c\u9ed1\u6d1e\u4f1a\u7a81\u7136\u7ed3\u675f\u60a8\u7684\u6e38\u620f\u3002\u8fd9\u79cd\u52a8\u6001\u96be\u5ea6\u786e\u4fdd\u4e86\u6e38\u620f\u5728\u73a9\u5bb6\u63d0\u9ad8\u6280\u80fd\u65f6\u4ecd\u7136\u5177\u6709\u6311\u6218\u6027\u4e14\u5f15\u4eba\u5165\u80dc\u3002"}, {"question": "\u73a9\u5bb6\u5728\u66f4\u6362\u8bbe\u5907\u73a9\u300a\u6d82\u9e26\u8df3\u8dc3\u300b\u65f6\u5e94\u8be5\u77e5\u9053\u54ea\u4e9b\u5173\u4e8e\u6570\u636e\u8fc1\u79fb\u7684\u4fe1\u606f\uff1f", "answer": "\u5728\u66f4\u6362\u8bbe\u5907\u73a9\u300a\u6d82\u9e26\u8df3\u8dc3\u300b\u65f6\uff0c\u73a9\u5bb6\u5e94\u8be5\u786e\u4fdd\u4f7f\u7528\u76f8\u540c\u7684\u5e10\u6237\u540c\u6b65\u4ed6\u4eec\u7684\u8fdb\u5ea6\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u4ece iOS \u8bbe\u5907\u8fc1\u79fb\u5230 Android \u8bbe\u5907\uff0c\u8bf7\u4f7f\u7528\u76f8\u540c\u7684 Google Play \u6216 Apple ID \u767b\u5f55\u4ee5\u8bbf\u95ee\u60a8\u7684\u4fdd\u5b58\u6570\u636e\u3002\u68c0\u67e5\u6e38\u620f\u7684\u8bbe\u7f6e\u4ee5\u67e5\u770b\u4e91\u4fdd\u5b58\u9009\u9879\u4ee5\u4fc3\u8fdb\u5e73\u6ed1\u7684\u8fc7\u6e21\u3002\u6b63\u786e\u7ba1\u7406\u6570\u636e\u8fc1\u79fb\u53ef\u786e\u4fdd\u60a8\u7684\u9ad8\u5206\u548c\u6210\u5c31\u4fdd\u7559\u5728\u4e0d\u540c\u7684\u8bbe\u5907\u4e0a\u3002"}, {"question": "\u300a\u6d82\u9e26\u8df3\u8dc3\u300b\u4e2d\u6709\u4efb\u4f55\u9690\u85cf\u7684\u79d8\u5bc6\u6216\u5f69\u86cb\u5417\uff1f", "answer": "\u662f\u7684\uff0c\u300a\u6d82\u9e26\u8df3\u8dc3\u300b\u5305\u542b\u9690\u85cf\u7684\u79d8\u5bc6\u548c\u5f69\u86cb\uff0c\u589e\u6dfb\u4e86\u6e38\u620f\u7684\u9b45\u529b\u3002\u4f8b\u5982\uff0c\u5728\u7279\u5b9a\u6761\u4ef6\u4e0b\uff0c\u4f1a\u7a00\u6709\u51fa\u73b0\u7279\u6b8a\u5e73\u53f0\u6216\u89d2\u8272\uff0c\u4f8b\u5982\u5916\u661f\u4eba\u6d82\u9e26\u4eba\u3002\u63a2\u7d22\u4e0d\u540c\u7684\u4e3b\u9898\u548c\u80cc\u666f\u4e5f\u53ef\u80fd\u4f1a\u53d1\u73b0\u72ec\u7279\u5143\u7d20\u3002\u7559\u610f\u8fd9\u4e9b\u60ca\u559c\uff0c\u56e0\u4e3a\u5b83\u4eec\u53ef\u4ee5\u589e\u5f3a\u60a8\u7684\u6e38\u620f\u4f53\u9a8c\uff0c\u5e76\u63d0\u4f9b\u989d\u5916\u7684\u6311\u6218\u548c\u5956\u52b1\u3002"}]
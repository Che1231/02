[{"question": "\ub3c4\ub4e4 \uc810\ud504\uc5d0\uc11c \ucd08\ubcf4\uc790\ub294 \uce90\ub9ad\ud130\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc5b4\ub5bb\uac8c \uc81c\uc5b4\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub3c4\ub4e4 \uc810\ud504\uc5d0\uc11c \uce90\ub9ad\ud130\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc81c\uc5b4\ud558\ub824\uba74 \ucd08\ubcf4\uc790\ub294 \uae30\uc6b8\uae30 \uac10\ub3c4\uc5d0 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. \uc124\uc815\uc5d0\uc11c \uae30\uc6b8\uae30 \uac10\ub3c4\ub97c \ud3b8\uc548\ud55c \uc218\uc900\uc73c\ub85c \uc870\uc815\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ub0ae\uc740 \uac10\ub3c4\ub294 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uac00 \ud50c\ub7ab\ud3fc\uc744 \ub193\uce58\ub294 \uac83\uc744 \ubc29\uc9c0\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc5f0\uc2b5\uc774 \uc644\ubcbd\ud558\uac8c \ub9cc\ub4ed\ub2c8\ub2e4. \ub530\ub77c\uc11c \uc9e7\uace0 \uc7a6\uc740 \uc138\uc158\uc73c\ub85c \ud50c\ub808\uc774\ud558\uc5ec \ucee8\ud2b8\ub864\uc5d0 \uc775\uc219\ud574\uc9c0\ub294 \ub370 \uc2dc\uac04\uc744 \ud560\uc560\ud558\uc138\uc694. \uc774 \uc811\uadfc \ubc29\uc2dd\uc740 \uadfc\uc721 \uae30\uc5b5\uc744 \uad6c\ucd95\ud558\uace0 \uc2dc\uac04\uc774 \uc9c0\ub0a8\uc5d0 \ub530\ub77c \uc815\ud655\uc131\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4."}, {"question": "\ub3c4\ub4e4 \uc810\ud504\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc740 \ubb34\uc5c7\uc774\uba70 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "\ub3c4\ub4e4 \uc810\ud504\uc758 \uae30\ubcf8 \ucee8\ud2b8\ub864\uc740 \uc7a5\uce58\ub97c \uc67c\ucabd \ub610\ub294 \uc624\ub978\ucabd\uc73c\ub85c \uae30\uc6b8\uc5ec \uce90\ub9ad\ud130\uc778 \ub3c4\ub4e4\ub7ec\ub97c \ud654\uba74\uc5d0\uc11c \uc6c0\uc9c1\uc774\ub294 \uac83\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \uc67c\ucabd\uc73c\ub85c \uae30\uc6b8\uc774\uba74 \uc67c\ucabd\uc73c\ub85c, \uc624\ub978\ucabd\uc73c\ub85c \uae30\uc6b8\uc774\uba74 \uc624\ub978\ucabd\uc73c\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4. \ub610\ud55c \ud654\uba74\uc744 \ud0ed\ud558\uba74 \ub3c4\ub4e4\ub7ec\uac00 \uc801\uc5d0\uac8c \ud0c4\ud658\uc744 \ubc1c\uc0ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, UFO\ub97c \ub9cc\ub0a0 \ub54c\ub294 UFO\uc640 \uc77c\uce58\ud558\ub3c4\ub85d \uae30\uc6b8\uc774\uace0 \ud0ed\ud558\uc5ec \uaca9\ucd94\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ucee8\ud2b8\ub864\uc744 \ub9c8\uc2a4\ud130\ud558\ub294 \uac83\uc740 \uac8c\uc784\uc744 \uc9c4\ud589\ud558\ub294 \ub370 \ud544\uc218\uc801\uc785\ub2c8\ub2e4."}, {"question": "\ub3c4\ub4e4 \uc810\ud504\uc5d0\uc11c \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uad00\ub9ac\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub3c4\ub4e4 \uc810\ud504\uc5d0\uc11c \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uad00\ub9ac\ud558\ub294 \uac83\uc740 \ub192\uc740 \ud50c\ub7ab\ud3fc\uc5d0 \ud6a8\uacfc\uc801\uc73c\ub85c \ub3c4\ub2ec\ud558\uace0 \uc7a5\uc560\ubb3c\uc744 \ud53c\ud560 \uc218 \uc788\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc810\ud504\ub97c \ub108\ubb34 \uc77c\ucc0d\ud558\uac70\ub098 \ub108\ubb34 \ub2a6\uac8c \ud558\uba74 \ud50c\ub7ab\ud3fc\uc744 \ub193\uce58\uac70\ub098 \uc774\ub3d9\ud558\uac70\ub098 \ubd80\uc11c\uc9c0\ub294 \ud50c\ub7ab\ud3fc\uc5d0 \ucc29\ub959\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud50c\ub7ab\ud3fc\uacfc \uc801\uc758 \uc774\ub3d9 \ud328\ud134\uc744 \uad00\ucc30\ud558\uc5ec \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uc5f0\uc2b5\ud558\uc138\uc694. \uafb8\uc900\ud55c \uc5f0\uc2b5\uc740 \uc810\uc218\uc640 \uc0dd\uc874 \uc2dc\uac04\uc744 \uadf9\ub300\ud654\ud558\ub294 \ub9ac\ub4ec\uc744 \uac1c\ubc1c\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uac83\uc785\ub2c8\ub2e4."}, {"question": "\uacbd\ud5d8\uc774 \ud48d\ubd80\ud55c \ud50c\ub808\uc774\uc5b4\ub294 \ub3c4\ub4e4 \uc810\ud504\uc5d0\uc11c \uc810\uc218\ub97c \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \uc5b4\ub5a4 \uc804\ub7b5\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\uacbd\ud5d8\uc774 \ud48d\ubd80\ud55c \ud50c\ub808\uc774\uc5b4\ub294 \ub3c4\ub4e4 \uc810\ud504\uc5d0\uc11c \uc810\uc218\ub97c \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \uc5f0\uc18d \uc810\ud504\uc640 \ud30c\uc6cc\uc5c5 \uc218\uc9d1\uc5d0 \uc9d1\uc911\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5f0\uc18d\uc801\uc73c\ub85c \uc2a4\ud504\ub9c1 \ud50c\ub7ab\ud3fc\uc5d0 \ucc29\ub959\ud558\uba74 \uc810\uc218\ub97c \ud06c\uac8c \ub192\uc774\ub294 \uc5f0\uc18d \uc810\ud504\ub97c \uc0dd\uc131\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c, \uc81c\ud2b8\ud329\uacfc \ud504\ub85c\ud3a0\ub7ec \ubaa8\uc790\ub97c \uc218\uc9d1\ud558\uc5ec \ub354 \ube60\ub974\uac8c \uc0c1\uc2b9\ud558\uace0 \uc704\ud5d8\uc744 \ud53c\ud558\uc2ed\uc2dc\uc624. \uc774\ub7ec\ud55c \uc694\uc18c\ub97c \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uba74 \uc815\ud655\ud55c \uc81c\uc5b4\uc640 \ud568\uaed8 \uae30\ub85d\uc801\uc778 \uc810\uc218\ub97c \ub2ec\uc131\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub3c4\ub4e4 \uc810\ud504\uc758 \ub354 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc744 \ud0d0\uc0c9\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub418\ub294 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub3c4\ub4e4 \uc810\ud504\uc758 \uc5b4\ub824\uc6b4 \ub808\ubca8\uc744 \ud0d0\uc0c9\ud558\ub824\uba74 \ube60\ub978 \ubc18\uc0ac \uc2e0\uacbd\uacfc \uc804\ub7b5\uc801 \uacc4\ud68d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc5ec\ub7ec \uac1c\uc758 \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uc744 \ub9cc\ub0a0 \ub54c \ud50c\ub7ab\ud3fc\uc758 \uacbd\ub85c\ub97c \uc608\uce21\ud558\uace0 \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uc870\uc815\ud558\uc138\uc694. \uc81c\ud2b8\ud329\uacfc \uac19\uc740 \ud30c\uc6cc\uc5c5\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc5b4\ub824\uc6b4 \uad6c\uac04\uc744 \uc6b0\ud68c\ud558\uc138\uc694. \ub610\ud55c, \uc801\uc758 \ud589\ub3d9 \ud328\ud134\uc744 \uc778\uc2dd\ud558\uc5ec \ud6a8\uc728\uc801\uc73c\ub85c \ud53c\ud558\uac70\ub098 \uc81c\uac70\ud558\ub294 \uc5f0\uc2b5\uc744 \ud558\uc138\uc694. \uc774\ub7ec\ud55c \uc804\ub7b5\uc744 \ub9c8\uc2a4\ud130\ud558\uba74 \uac00\uc7a5 \uc5b4\ub824\uc6b4 \ub808\ubca8\ub3c4 \uadf9\ubcf5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub3c4\ub4e4 \uc810\ud504\uc758 \uace0\uae09 \ud50c\ub808\uc774\uc5d0\uc11c \ud50c\ub7ab\ud3fc \uc720\ud615\uc744 \uc774\ud574\ud558\ub294 \uac83\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub3c4\ub4e4 \uc810\ud504\uc758 \uace0\uae09 \ud50c\ub808\uc774\uc5d0\uc11c \ud50c\ub7ab\ud3fc \uc720\ud615\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \uac01 \uc720\ud615\uc774 \uc11c\ub85c \ub2e4\ub974\uac8c \uc791\ub3d9\ud558\uace0 \uace0\uc720\ud55c \uc804\ub7b5\uc774 \ud544\uc694\ud558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc6c0\uc9c1\uc774\ub294 \ud50c\ub7ab\ud3fc\uc740 \uc704\uce58\ub97c \ubcc0\uacbd\ud558\ubbc0\ub85c \uc810\ud504 \ud0c0\uc774\ubc0d\uc744 \uc815\ud655\ud558\uac8c \ub9de\ucdb0\uc57c \ud569\ub2c8\ub2e4. \ubd80\uc11c\uc9c0\ub294 \ud50c\ub7ab\ud3fc\uc740 \ub2e8\uc77c \uc810\ud504 \ud6c4 \uc0ac\ub77c\uc9c0\ubbc0\ub85c \ube60\ub974\uac8c \uc6c0\uc9c1\uc5ec\uc57c \ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud50c\ub7ab\ud3fc \uc720\ud615\uc744 \uc2dd\ubcc4\ud558\uace0 \uc774\uc5d0 \uc801\uc751\ud558\ub294 \uc5f0\uc2b5\uc744 \ud1b5\ud574  momentum\uc744 \uc720\uc9c0\ud558\uace0 \ub5a8\uc5b4\uc9c0\ub294 \uac83\uc744 \ubc29\uc9c0\ud558\uc138\uc694. \uc774 \uc9c0\uc2dd\uc740 \ub192\uc740 \uc810\uc218\uc640 \uae34 \ud50c\ub808\uc774 \uc2dc\uac04\uc744 \uc704\ud55c \uc5f4\uc1e0\uc785\ub2c8\ub2e4."}, {"question": "\ub3c4\ub4e4 \uc810\ud504\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c \ub4a4\uc5d0 \uc788\ub294 \uc8fc\uc694 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ub3c4\ub4e4 \uc810\ud504\uc758 \uc810\uc218 \uc2dc\uc2a4\ud15c\uc740 \ub2ec\uc131\ud55c \ub192\uc774\uc640 \uc218\uc9d1\ud55c \ubcf4\ub108\uc2a4\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uac01 \ud50c\ub7ab\ud3fc\uc5d0 \ucc29\ub959\ud560 \ub54c\ub9c8\ub2e4 \uc810\uc218\uac00 \ucd94\uac00\ub418\uba70, \ub192\uc740 \ud50c\ub7ab\ud3fc\uc740 \ub354 \ub9ce\uc740 \uc810\uc218\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4. \ub610\ud55c \ub3d9\uc804\uacfc \ud30c\uc6cc\uc5c5\uacfc \uac19\uc740 \uc544\uc774\ud15c\uc744 \uc218\uc9d1\ud558\uace0 \uc801\uc744 \ubb3c\ub9ac\uce58\uba74 \ucd94\uac00 \uc810\uc218\uac00 \uc81c\uacf5\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uc81c\ud2b8\ud329\uc744 \uc0ac\uc6a9\ud558\uc5ec \ube60\ub974\uac8c \uc0c1\uc2b9\ud558\uba74 \uc9e7\uc740 \uc2dc\uac04 \uc548\uc5d0 \uc810\uc218\ub97c \ud06c\uac8c \ub192\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \uba54\ucee4\ub2c8\uc998\uc744 \uc774\ud574\ud568\uc73c\ub85c\uc368 \ud50c\ub808\uc774\uc5b4\ub294 \ucd5c\ub300 \uc810\uc218\ub97c \uc5bb\uae30 \uc704\ud574 \uac8c\uc784 \ud50c\ub808\uc774\ub97c \uc804\ub7b5\uc801\uc73c\ub85c \uacc4\ud68d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ub3c4\ub4e4 \uc810\ud504\uc5d0\uc11c \uac8c\uc784\uc758 \ub09c\uc774\ub3c4\ub97c \uc5b4\ub5bb\uac8c \uc870\uc808\ud569\ub2c8\uae4c?", "answer": "\ub3c4\ub4e4 \uc810\ud504\ub294 \uc18d\ub3c4\ub97c \ub192\uc774\uace0 \ud50c\ub7ab\ud3fc\uacfc \uc801\uc758 \ud328\ud134\uc744 \ub354 \ubcf5\uc7a1\ud558\uac8c \ub9cc\ub4dc\ub294 \uc870\ud569\uc744 \ud1b5\ud574 \ub09c\uc774\ub3c4\ub97c \uc870\uc808\ud569\ub2c8\ub2e4. \uc0c1\uc2b9\ud568\uc5d0 \ub530\ub77c \uac8c\uc784 \uc18d\ub3c4\uac00 \ube68\ub77c\uc838 \ub354 \ube60\ub978 \ubc18\uc751\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ube14\ub799\ud640\uacfc UFO\uc640 \uac19\uc740 \uc0c8\ub85c\uc6b4 \uc7a5\uc560\ubb3c\uc774 \ud50c\ub808\uc774\uc5b4\ub97c \ud14c\uc2a4\ud2b8\ud558\uae30 \uc704\ud574 \ub3c4\uc785\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ube14\ub799\ud640\uc740 \ud53c\ud558\uc9c0 \uc54a\uc73c\uba74 \uac11\uc790\uae30 \ud50c\ub808\uc774\ub97c \ub05d\ub0bc \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ub3d9\uc801\uc778 \ub09c\uc774\ub3c4\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uae30\uc220\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \ud55c \uac8c\uc784\uc774 \uacc4\uc18d\ud574\uc11c \uc5b4\ub835\uace0 \ub9e4\ub825\uc801\uc73c\ub85c \uc720\uc9c0\ub418\ub3c4\ub85d \ud569\ub2c8\ub2e4."}, {"question": "\ub3c4\ub4e4 \uc810\ud504 \uc7a5\uce58\ub97c \uad50\uccb4\ud560 \ub54c \ub370\uc774\ud130 \ub9c8\uc774\uadf8\ub808\uc774\uc158\uc5d0 \ub300\ud574 \ud50c\ub808\uc774\uc5b4\ub294 \ubb34\uc5c7\uc744 \uc54c\uc544\uc57c \ud569\ub2c8\uae4c?", "answer": "\ub3c4\ub4e4 \uc810\ud504 \uc7a5\uce58\ub97c \uad50\uccb4\ud560 \ub54c \ud50c\ub808\uc774\uc5b4\ub294 \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud558\uae30 \uc704\ud574 \ub3d9\uc77c\ud55c \uacc4\uc815\uc744 \uc0ac\uc6a9\ud574\uc57c \ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, iOS\uc5d0\uc11c Android \uc7a5\uce58\ub85c \uc774\ub3d9\ud558\ub294 \uacbd\uc6b0 \uc800\uc7a5\ub41c \ub370\uc774\ud130\uc5d0 \uc561\uc138\uc2a4\ud558\ub824\uba74 \ub3d9\uc77c\ud55c Google Play \ub610\ub294 Apple ID\ub85c \ub85c\uadf8\uc778\ud558\uc138\uc694. \uc6d0\ud65c\ud55c \uc804\ud658\uc744 \uc704\ud574 \uac8c\uc784 \uc124\uc815\uc5d0\uc11c \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uc635\uc158\uc744 \ud655\uc778\ud558\uc138\uc694. \ub370\uc774\ud130 \ub9c8\uc774\uadf8\ub808\uc774\uc158\uc744 \uc801\uc808\ud558\uac8c \uad00\ub9ac\ud558\uba74 \uace0\ub4dd\uc810\uacfc \uc5c5\uc801\uc774 \ub2e4\ub978 \uc7a5\uce58\uc5d0\uc11c\ub3c4 \ubcf4\uc874\ub429\ub2c8\ub2e4."}, {"question": "\ub3c4\ub4e4 \uc810\ud504\uc5d0 \uc228\uaca8\uc9c4 \ube44\ubc00\uc774\ub098 \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub124, \ub3c4\ub4e4 \uc810\ud504\uc5d0\ub294 \uac8c\uc784\uc758 \ub9e4\ub825\uc744 \ub354\ud558\ub294 \uc228\uaca8\uc9c4 \ube44\ubc00\uacfc \uc774\uc2a4\ud130 \uc5d0\uadf8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud2b9\uc815 \uc870\uac74\uc5d0\uc11c \uc7a0\uae08 \ud574\uc81c\ud560 \uc218 \uc788\ub294 \uc678\uacc4\uc778 \ub3c4\ub4e4\ub7ec\uc640 \uac19\uc740 \ud2b9\uc218 \ud50c\ub7ab\ud3fc\uc774\ub098 \uce90\ub9ad\ud130\uac00 \ub4dc\ubb3c\uac8c \ub4f1\uc7a5\ud569\ub2c8\ub2e4. \ub2e4\ub978 \ud14c\ub9c8\uc640 \ubc30\uacbd\uc744 \ud0d0\uc0c9\ud558\uba74 \ub3c5\ud2b9\ud55c \uc694\uc18c\ub97c \ubc1c\uacac\ud560 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc784 \ud50c\ub808\uc774 \uacbd\ud5d8\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\uace0 \ucd94\uac00\uc801\uc778 \ub3c4\uc804\uacfc \ubcf4\uc0c1\uc744 \uc81c\uacf5\ud558\ub294 \uc774\ub7ec\ud55c \ub180\ub77c\uc6b4 \uc810\ub4e4\uc744 \uc8fc\ubaa9\ud558\uc2ed\uc2dc\uc624."}]
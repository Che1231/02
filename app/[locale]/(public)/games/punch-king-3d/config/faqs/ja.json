[{"question": "\u521d\u5fc3\u8005\u5411\u3051\u306b\u3001\u30d1\u30f3\u30c1\u30ad\u30f3\u30b03D\u306e\u57fa\u672c\u30b3\u30f3\u30dc\u306e\u5b9f\u884c\u65b9\u6cd5\u3092\u6559\u3048\u3066\u304f\u3060\u3055\u3044\u3002", "answer": "\u30d1\u30f3\u30c1\u30ad\u30f3\u30b03D\u3067\u306f\u3001\u57fa\u672c\u30b3\u30f3\u30dc\u306f\u65b0\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u3068\u3063\u3066\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u307e\u305a\u3001\u30e9\u30a4\u30c8\u30d1\u30f3\u30c1\uff08LP\uff09\u3068\u30d8\u30d3\u30fc\u30d1\u30f3\u30c1\uff08HP\uff09\u30dc\u30bf\u30f3\u3092\u30de\u30b9\u30bf\u30fc\u3057\u307e\u3057\u3087\u3046\u3002\u7c21\u5358\u306a\u30b3\u30f3\u30dc\u306fLP\u2192LP\u2192HP\u3067\u3059\u3002\u4f8b\u3048\u3070\u3001\u6700\u521d\u306e\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u30ec\u30d9\u30eb\u3067\u306f\u3001\u3053\u306e\u30b3\u30f3\u30dc\u3092\u4f7f\u3063\u3066\u7df4\u7fd2\u306e\u30c0\u30df\u30fc\u3092\u5012\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d71\uff1aLP\u30922\u56de\u62bc\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1aHP\u3067\u30d5\u30a9\u30ed\u30fc\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7b4b\u8089\u306e\u8a18\u61b6\u3092\u69cb\u7bc9\u3059\u308b\u305f\u3081\u306b\u7e70\u308a\u8fd4\u3057\u307e\u3059\u3002\u3053\u306e\u30b3\u30f3\u30dc\u306f\u3001\u521d\u671f\u306e\u5bfe\u6226\u76f8\u624b\u306e\u5927\u534a\u306b\u5bfe\u3057\u3066\u6709\u52b9\u3067\u3059\u3002"}, {"question": "\u30d1\u30f3\u30c1\u30ad\u30f3\u30b03D\u3067\u30b9\u30bf\u30df\u30ca\u7ba1\u7406\u304c\u91cd\u8981\u306a\u306e\u306f\u306a\u305c\u3067\u3059\u304b\uff1f\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30f3\u30c1\u30ad\u30f3\u30b03D\u3067\u306f\u3001\u30b9\u30bf\u30df\u30ca\u7ba1\u7406\u306f\u653b\u6483\u3068\u56de\u907f\u80fd\u529b\u306b\u5f71\u97ff\u3059\u308b\u305f\u3081\u3001\u4e0d\u53ef\u6b20\u3067\u3059\u3002\u30b9\u30bf\u30df\u30ca\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u653b\u6483\u3068\u79fb\u52d5\u3092\u30d0\u30e9\u30f3\u30b9\u3055\u305b\u307e\u3057\u3087\u3046\u3002\u4f8b\u3048\u3070\u3001\u300e\u738b\u8005\u306e\u7af6\u6280\u5834\u300f\u30e2\u30fc\u30c9\u3067\u306f\u3001\u30d1\u30f3\u30c1\u3092\u9023\u6253\u3059\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u30bf\u30a4\u30df\u30f3\u30b0\u306e\u826f\u3044\u653b\u6483\u3092\u4f7f\u3044\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6226\u95d8\u4e2d\u306b\u30b9\u30bf\u30df\u30ca\u30d0\u30fc\u3092\u76e3\u8996\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b9\u30bf\u30df\u30ca\u3092\u7bc0\u7d04\u3059\u308b\u305f\u3081\u306b\u3001\u30e9\u30a4\u30c8\u653b\u6483\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u91cd\u8981\u306a\u5834\u9762\u3067\u30d8\u30d3\u30fc\u653b\u6483\u3092\u6e29\u5b58\u3057\u307e\u3059\u3002\u30b9\u30bf\u30df\u30ca\u306f\u71c3\u6599\u30bf\u30f3\u30af\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u6226\u95d8\u4e2d\u306b\u71c3\u6599\u5207\u308c\u3057\u306a\u3044\u3088\u3046\u306b\u8ce2\u304f\u4f7f\u3044\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u5411\u3051\u306b\u3001\u30d1\u30f3\u30c1\u30ad\u30f3\u30b03D\u3067\u6700\u9ad8\u306e\u9632\u5fa1\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30f3\u30c1\u30ad\u30f3\u30b03D\u306e\u4e0a\u7d1a\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u30ac\u30fc\u30c9\u3068\u56de\u907f\u306b\u7126\u70b9\u3092\u5f53\u3066\u308b\u3079\u304d\u3067\u3059\u3002\u30ac\u30fc\u30c9\u306f\u6b63\u78ba\u306a\u30bf\u30a4\u30df\u30f3\u30b0\u304c\u5fc5\u8981\u3067\u3059\u304c\u3001\u6226\u6cc1\u3092\u5909\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u9244\u62f3\u300f\u30dc\u30b9\u306b\u5bfe\u3057\u3066\u306f\u3001\u5f7c\u306e\u30d8\u30d3\u30fc\u30d1\u30f3\u30c1\u3092\u30ac\u30fc\u30c9\u3057\u3066\u53cd\u6483\u3057\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u6575\u306e\u653b\u6483\u30a2\u30cb\u30e1\u30fc\u30b7\u30e7\u30f3\u3092\u89b3\u5bdf\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u885d\u7a81\u3059\u308b\u76f4\u524d\u306b\u30d6\u30ed\u30c3\u30af\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b3\u30f3\u30dc\u3067\u30d5\u30a9\u30ed\u30fc\u3057\u307e\u3059\u3002\u56de\u907f\u3082\u91cd\u8981\u3067\u3059\u3002\u76f4\u7dda\u7684\u306a\u653b\u6483\u3092\u907f\u3051\u308b\u305f\u3081\u306b\u6a2a\u306b\u79fb\u52d5\u3057\u307e\u3057\u3087\u3046\u3002\u30ac\u30fc\u30c9\u3092\u30bf\u30a4\u30df\u30f3\u30b0\u306e\u826f\u3044\u30c0\u30f3\u30b9\u30b9\u30c6\u30c3\u30d7\u306b\u4f8b\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30ea\u30ba\u30e0\u304c\u5927\u5207\u306a\u306e\u3067\u3059\u3002"}, {"question": "\u30d1\u30f3\u30c1\u30ad\u30f3\u30b03D\u306e\u30b9\u30ad\u30eb\u30c4\u30ea\u30fc\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u3001\u4e3b\u306a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30f3\u30c1\u30ad\u30f3\u30b03D\u306e\u30b9\u30ad\u30eb\u30c4\u30ea\u30fc\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u81ea\u5206\u306e\u30d5\u30a1\u30a4\u30bf\u30fc\u3092\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3067\u304d\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002\u91cd\u8981\u306a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306b\u306f\u3001\u300c\u30d1\u30ef\u30fc\u30d1\u30f3\u30c1\u300d\uff08\u30c0\u30e1\u30fc\u30b8\u5897\u52a0\uff09\u3068\u300c\u30b9\u30a6\u30a3\u30d5\u30c8\u30d5\u30c3\u30c8\u30ef\u30fc\u30af\u300d\uff08\u79fb\u52d5\u529b\u5411\u4e0a\uff09\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300c\u30d1\u30ef\u30fc\u30d1\u30f3\u30c1\u300d\u306b\u65e9\u671f\u306b\u6295\u8cc7\u3059\u308b\u3053\u3068\u3067\u3001\u300c\u7834\u58ca\u8005\u300d\u306e\u3088\u3046\u306a\u3088\u308a\u5f37\u529b\u306a\u6575\u306b\u52dd\u5229\u3067\u304d\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u8a66\u5408\u3092\u5b8c\u4e86\u3059\u308b\u3053\u3068\u3067\u30b9\u30ad\u30eb\u30dd\u30a4\u30f3\u30c8\u3092\u7372\u5f97\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b9\u30ad\u30eb\u30c4\u30ea\u30fc\u3092\u64cd\u4f5c\u3057\u3001\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306e\u512a\u5148\u9806\u4f4d\u3092\u3064\u3051\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u3055\u307e\u3056\u307e\u306a\u30d3\u30eb\u30c9\u3092\u8a66\u3057\u307e\u3059\u3002\u30b9\u30ad\u30eb\u30c4\u30ea\u30fc\u306f\u30ed\u30fc\u30c9\u30de\u30c3\u30d7\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u30d7\u30ec\u30a4\u30b9\u30bf\u30a4\u30eb\u306b\u5408\u3063\u305f\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u9078\u629e\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u30d1\u30f3\u30c1\u30ad\u30f3\u30b03D\u306e\u30b3\u30fc\u30d7\u30e2\u30fc\u30c9\u3067\u3001\u3069\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u6700\u3082\u826f\u3044\u76f8\u4e57\u52b9\u679c\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30f3\u30c1\u30ad\u30f3\u30b03D\u306e\u30b3\u30fc\u30d7\u30e2\u30fc\u30c9\u3067\u306f\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u76f8\u4e57\u52b9\u679c\u304c\u91cd\u8981\u3067\u3059\u3002\u300c\u683c\u95d8\u5bb6\u300d\u3068\u300c\u6280\u8853\u8005\u300d\u30af\u30e9\u30b9\u306f\u3046\u307e\u304f\u6a5f\u80fd\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u683c\u95d8\u5bb6\u306e\u9ad8\u3044\u30c0\u30e1\u30fc\u30b8\u51fa\u529b\u306f\u3001\u6280\u8853\u8005\u306e\u7fa4\u8846\u5236\u5fa1\u80fd\u529b\u3092\u88dc\u5b8c\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u76f8\u4e57\u52b9\u679c\u306e\u3042\u308b\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u52b9\u7387\u3092\u6700\u5927\u5316\u3059\u308b\u305f\u3081\u306b\u653b\u6483\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u56fa\u6709\u306e\u30b3\u30f3\u30dc\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u3053\u306e\u76f8\u4e57\u52b9\u679c\u306f\u3001\u6ed1\u3089\u304b\u306a\u6a5f\u68b0\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u305d\u308c\u305e\u308c\u306e\u90e8\u5206\u304c\u4ed6\u65b9\u306e\u6027\u80fd\u3092\u9ad8\u3081\u307e\u3059\u3002"}, {"question": "\u30d1\u30f3\u30c1\u30ad\u30f3\u30b03D\u3067\u3001\u591a\u304f\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u898b\u904e\u3054\u3057\u3066\u3044\u308b\u96a0\u308c\u305f\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30d1\u30f3\u30c1\u30ad\u30f3\u30b03D\u306e\u96a0\u308c\u305f\u30e1\u30ab\u30cb\u30ba\u30e0\u306e1\u3064\u306f\u3001\u300c\u6012\u308a\u30b2\u30fc\u30b8\u300d\u3067\u3059\u3002\u30c0\u30e1\u30fc\u30b8\u3092\u53d7\u3051\u308b\u306b\u3064\u308c\u3066\u30b2\u30fc\u30b8\u304c\u6e80\u30bf\u30f3\u306b\u306a\u308a\u307e\u3059\u3002\u6e80\u30bf\u30f3\u306b\u306a\u308b\u3068\u3001\u5f37\u529b\u306a\u300c\u6012\u308a\u30e2\u30fc\u30c9\u300d\u304c\u89e3\u653e\u3055\u308c\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u6700\u7d42\u6c7a\u6226\u300f\u30b9\u30c6\u30fc\u30b8\u3067\u6012\u308a\u30e2\u30fc\u30c9\u3092\u30a2\u30af\u30c6\u30a3\u30d6\u306b\u3059\u308b\u3068\u3001\u6557\u5317\u3057\u3066\u3044\u305f\u6226\u3044\u3092\u52dd\u5229\u306b\u5909\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30b2\u30fc\u30b8\u3092\u6e80\u305f\u3059\u305f\u3081\u306b\u8a08\u7b97\u3055\u308c\u305f\u30d2\u30c3\u30c8\u3092\u4e0e\u3048\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u91cd\u8981\u306a\u77ac\u9593\u306b\u6012\u308a\u30e2\u30fc\u30c9\u3092\u30a2\u30af\u30c6\u30a3\u30d6\u306b\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u7834\u58ca\u7684\u306a\u653b\u6483\u3092\u653e\u3061\u307e\u3059\u3002\u3053\u306e\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3001\u96a0\u3055\u308c\u305f\u30a8\u30fc\u30b9\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u6226\u7565\u7684\u306b\u4f7f\u7528\u3057\u307e\u3057\u3087\u3046\u3002"}, {"question": "\u30d1\u30f3\u30c1\u30ad\u30f3\u30b03D\u306e\u30c0\u30e1\u30fc\u30b8\u8a08\u7b97\u30b7\u30b9\u30c6\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30f3\u30c1\u30ad\u30f3\u30b03D\u306e\u30c0\u30e1\u30fc\u30b8\u8a08\u7b97\u306f\u3001\u653b\u6483\u529b\u3001\u9632\u5fa1\u529b\u3001\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u306b\u57fa\u3065\u3044\u3066\u3044\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u653b\u6483\u529b\u304c50\u306e\u30d8\u30d3\u30fc\u30d1\u30f3\u30c1\u3092\u3001\u9632\u5fa1\u529b\u304c20\u306e\u76f8\u624b\u306b\u5f53\u3066\u308b\u3068\u300130\u306e\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u653b\u6483\u529b\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u76f8\u624b\u306e\u9632\u5fa1\u529b\u3092\u8003\u616e\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u6700\u7d42\u7684\u306a\u30c0\u30e1\u30fc\u30b8\u3092\u8a08\u7b97\u3057\u307e\u3059\u3002\u3053\u306e\u30b7\u30b9\u30c6\u30e0\u306f\u6570\u5b66\u306e\u5f0f\u306b\u4f3c\u3066\u3044\u307e\u3059\u3002\u5404\u5909\u6570\u304c\u7d50\u679c\u306b\u5f71\u97ff\u3057\u307e\u3059\u3002"}, {"question": "\u30d1\u30f3\u30c1\u30ad\u30f3\u30b03D\u306f\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u5bfe\u5fdc\u3067\u3059\u304b\uff1f\u9032\u6357\u72b6\u6cc1\u3092\u3069\u306e\u3088\u3046\u306b\u79fb\u884c\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30f3\u30c1\u30ad\u30f3\u30b03D\u306f\u3001PC\u3068\u30b3\u30f3\u30bd\u30fc\u30eb\u9593\u3067\u30af\u30ed\u30b9\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u30d7\u30ec\u30a4\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u307e\u3059\u3002\u9032\u6357\u72b6\u6cc1\u3092\u79fb\u884c\u3059\u308b\u306b\u306f\u3001\u30b2\u30fc\u30e0\u306e\u30af\u30e9\u30a6\u30c9\u30bb\u30fc\u30d6\u30b7\u30b9\u30c6\u30e0\u306b\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30ea\u30f3\u30af\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001PC\u304b\u3089PlayStation\u306b\u5207\u308a\u66ff\u3048\u308b\u5834\u5408\u3001\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u3067\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u3068\u3001\u30c7\u30fc\u30bf\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u30af\u30e9\u30a6\u30c9\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u4f5c\u6210\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b2\u30fc\u30e0\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\u3092\u30ea\u30f3\u30af\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u9032\u6357\u72b6\u6cc1\u3092\u540c\u671f\u3057\u307e\u3059\u3002\u3053\u306e\u6a5f\u80fd\u306b\u3088\u308a\u3001\u8907\u6570\u306e\u30c7\u30d0\u30a4\u30b9\u9593\u3067\u30b9\u30e0\u30fc\u30ba\u306b\u3042\u306a\u305f\u306e\u5192\u967a\u304c\u7d9a\u304d\u307e\u3059\u3002"}, {"question": "\u30d1\u30f3\u30c1\u30ad\u30f3\u30b03D\u306e\u96a0\u3057\u9054\u6210\u4e8b\u9805\u306f\u4f55\u3067\u3059\u304b\uff1f\u305d\u3057\u3066\u3001\u305d\u308c\u3089\u3092\u3069\u306e\u3088\u3046\u306b\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30d1\u30f3\u30c1\u30ad\u30f3\u30b03D\u306b\u306f\u3044\u304f\u3064\u304b\u306e\u96a0\u3057\u9054\u6210\u4e8b\u9805\u304c\u3042\u308a\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u5f71\u306e\u30dc\u30af\u30b5\u30fc\u300f\u306f\u3001\u30c0\u30e1\u30fc\u30b8\u3092\u53d7\u3051\u305a\u306b\u8a66\u5408\u306b\u52dd\u3061\u629c\u304f\u3053\u3068\u3067\u7372\u5f97\u3067\u304d\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u300e\u9759\u304b\u306a\u9053\u5834\u300f\u30b9\u30c6\u30fc\u30b8\u3067\u306f\u3001\u5b8c\u74a7\u306a\u56de\u907f\u3068\u30ab\u30a6\u30f3\u30bf\u30fc\u3092\u4f7f\u3063\u3066\u3053\u308c\u3092\u5b9f\u73fe\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u9632\u5fa1\u6280\u8853\u3092\u7df4\u7fd2\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u6575\u306e\u3059\u3079\u3066\u306e\u653b\u6483\u3092\u907f\u3051\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u8a66\u5408\u3092\u5b8c\u74a7\u306b\u52dd\u3061\u629c\u304d\u307e\u3059\u3002\u3053\u308c\u3089\u306e\u9054\u6210\u4e8b\u9805\u306f\u3001\u96a0\u3055\u308c\u305f\u5b9d\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u6311\u6226\u7684\u3067\u3059\u304c\u3001\u3084\u308a\u304c\u3044\u304c\u3042\u308a\u307e\u3059\u3002"}, {"question": "\u4f4e\u30a8\u30f3\u30c9\u30c7\u30d0\u30a4\u30b9\u3067\u306e\u30d1\u30f3\u30c1\u30ad\u30f3\u30b03D\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3069\u3046\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u4f4e\u30a8\u30f3\u30c9\u30c7\u30d0\u30a4\u30b9\u3067\u30d1\u30f3\u30c1\u30ad\u30f3\u30b03D\u306e\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u3092\u6700\u9069\u5316\u3059\u308b\u306b\u306f\u3001\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u8a2d\u5b9a\u3092\u4e0b\u3052\u3001\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u30d7\u30ed\u30bb\u30b9\u3092\u7121\u52b9\u5316\u3057\u307e\u3059\u3002\u4f8b\u3048\u3070\u3001\u89e3\u50cf\u5ea6\u3092720p\u306b\u4e0b\u3052\u308b\u3053\u3068\u3067\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u8a2d\u5b9a\u30e1\u30cb\u30e5\u30fc\u306b\u30a2\u30af\u30bb\u30b9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u30b0\u30e9\u30d5\u30a3\u30c3\u30af\u3068\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u8abf\u6574\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u30b2\u30fc\u30e0\u3092\u4fdd\u5b58\u3057\u3066\u518d\u8d77\u52d5\u3057\u307e\u3059\u3002\u3053\u306e\u6700\u9069\u5316\u306f\u3001\u8eca\u306e\u8abf\u6574\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\u5c0f\u3055\u306a\u8abf\u6574\u3067\u3001\u6ed1\u3089\u304b\u306a\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002"}]
[{"question": "\ud380\uce58 \ud0b9 3D \ucd08\ubcf4\uc790\ub97c \uc704\ud55c \uae30\ubcf8 \ucf64\ubcf4 \uc5f0\ucd9c \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud380\uce58 \ud0b9 3D\uc5d0\uc11c \uae30\ubcf8 \ucf64\ubcf4\ub294 \uc0c8\ub85c\uc6b4 \ud50c\ub808\uc774\uc5b4\uc5d0\uac8c \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uba3c\uc800 \ub77c\uc774\ud2b8 \ud380\uce58(LP)\uc640 \ud5e4\ube44 \ud380\uce58(HP) \ubc84\ud2bc\uc744 \uc219\ub2ec\ud558\uc138\uc694. \uac04\ub2e8\ud55c \ucf64\ubcf4\ub294 LP \u2192 LP \u2192 HP\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uccab \ubc88\uc9f8 \ud6c8\ub828 \ub808\ubca8\uc5d0\uc11c \uc5f0\uc2b5\uc6a9 \uc778\ud615\uc744 \ubb3c\ub9ac\uce58\uae30 \uc704\ud574 \uc774 \ucf64\ubcf4\ub97c \uc0ac\uc6a9\ud558\uc138\uc694. \ub2e8\uacc4 1: LP\ub97c \ub450 \ubc88 \ub204\ub974\uc138\uc694. \ub2e8\uacc4 2: HP\ub97c \uc774\uc5b4\uc11c \ub204\ub974\uc138\uc694. \ub2e8\uacc4 3: \uadfc\uc721 \uae30\uc5b5\ub825\uc744 \ud0a4\uc6b0\uae30 \uc704\ud574 \ubc18\ubcf5\ud558\uc138\uc694. \uc774 \ucf64\ubcf4\ub294 \ub300\ubd80\ubd84\uc758 \ucd08\ubc18 \uc0c1\ub300\ubc29\uc5d0\uac8c \ud6a8\uacfc\uc801\uc785\ub2c8\ub2e4."}, {"question": "\ud380\uce58 \ud0b9 3D\uc5d0\uc11c \uc2a4\ud14c\ubbf8\ub108 \uad00\ub9ac\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ucd5c\uc801\ud654\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud380\uce58 \ud0b9 3D\uc5d0\uc11c \uc2a4\ud14c\ubbf8\ub108 \uad00\ub9ac\uac00 \uc911\uc694\ud55c \uc774\uc720\ub294 \uacf5\uaca9\uacfc \ud68c\ud53c \ub2a5\ub825\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce58\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \uc2a4\ud14c\ubbf8\ub108\ub97c \ucd5c\uc801\ud654\ud558\ub824\uba74 \uacf5\uaca9\uacfc \uc774\ub3d9\uc744 \uc801\uc808\ud788 \uc870\uc808\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \"\ud0b9\uc758 \uc544\ub808\ub098\" \ubaa8\ub4dc\uc5d0\uc11c \ud380\uce58\ub97c \ubc18\ubcf5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\ub294 \ub300\uc2e0 \uc2dc\uac04 \ub9de\ucdb0 \uacf5\uaca9\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. \ub2e8\uacc4 1: \uc804\ud22c \uc911 \uc2a4\ud14c\ubbf8\ub108 \ubc14\ub97c \uc8fc\uc2dc\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \uc2a4\ud14c\ubbf8\ub108\ub97c \uc808\uc57d\ud558\uae30 \uc704\ud574 \ub77c\uc774\ud2b8 \uacf5\uaca9\uc744 \uc0ac\uc6a9\ud558\uc138\uc694. \ub2e8\uacc4 3: \ud5e4\ube44 \uacf5\uaca9\uc740 \uc911\uc694\ud55c \uc21c\uac04\uc5d0 \uc0ac\uc6a9\ud558\uc138\uc694. \uc2a4\ud14c\ubbf8\ub108\ub97c \uc5f0\ub8cc \ud0f1\ud06c\ucc98\ub7fc \uc0dd\uac01\ud558\uace0 \uc804\ud22c \uc911\uc5d0 \uace0\uac08\ub418\uc9c0 \uc54a\ub3c4\ub85d \ud604\uba85\ud558\uac8c \uc0ac\uc6a9\ud558\uc138\uc694."}, {"question": "\uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub97c \uc704\ud55c \ud380\uce58 \ud0b9 3D\uc758 \ucd5c\uace0\uc758 \ubc29\uc5b4 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud380\uce58 \ud0b9 3D\uc758 \uace0\uae09 \ud50c\ub808\uc774\uc5b4\ub294 \ud30c\ub9ac\uc640 \ud68c\ud53c\uc5d0 \uc9d1\uc911\ud574\uc57c \ud569\ub2c8\ub2e4. \ud30c\ub9ac\ub294 \uc815\ud655\ud55c \ud0c0\uc774\ubc0d\uc774 \ud544\uc694\ud558\uc9c0\ub9cc \uc804\ud22c\uc758 \ud750\ub984\uc744 \ubc14\uafc0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ucca0\uad8c\" \ubcf4\uc2a4\uc5d0\uac8c \uadf8\uc758 \ud5e4\ube44 \ud380\uce58\ub97c \ud30c\ub9ac\ud558\uc5ec \ubc18\uaca9\ud558\uc138\uc694. \ub2e8\uacc4 1: \uc801\uc758 \uacf5\uaca9 \uc560\ub2c8\uba54\uc774\uc158\uc744 \uc0b4\ud3b4\ubcf4\uc138\uc694. \ub2e8\uacc4 2: \ucda9\ub3cc \uc9c1\uc804\uc5d0 \ube14\ub85d \ubc84\ud2bc\uc744 \ub204\ub974\uc138\uc694. \ub2e8\uacc4 3: \ucf64\ubcf4\ub97c \uc774\uc5b4\uc11c \uc0ac\uc6a9\ud558\uc138\uc694. \ud68c\ud53c\ub3c4 \ud544\uc218\uc801\uc785\ub2c8\ub2e4. \uc120\ud615 \uacf5\uaca9\uc744 \ud53c\ud558\uae30 \uc704\ud574 \uc606\uc73c\ub85c \uc774\ub3d9\ud558\uc138\uc694. \ud30c\ub9ac\ub97c \uc798 \ud0c0\uc774\ubc0d \ub9de\ucdb0 \ucda4\ucd94\ub294 \uac83\uacfc \ube44\uad50\ud574 \ubcf4\uc138\uc694. \ub9ac\ub4ec\uc774 \uc911\uc694\ud569\ub2c8\ub2e4."}, {"question": "\ud380\uce58 \ud0b9 3D\uc758 \uc2a4\ud0ac \ud2b8\ub9ac \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\uba70, \uc8fc\uc694 \uc5c5\uadf8\ub808\uc774\ub4dc\ub294 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud380\uce58 \ud0b9 3D\uc758 \uc2a4\ud0ac \ud2b8\ub9ac\ub294 \ud50c\ub808\uc774\uc5b4\uac00 \uc790\uc2e0\uc744 \ud2b9\ubcc4\ud558\uac8c \ub9cc\ub4e4 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4. \uc8fc\uc694 \uc5c5\uadf8\ub808\uc774\ub4dc\uc5d0\ub294 \uacf5\uaca9\ub825\uc744 \ub192\uc774\ub294 \"\ud30c\uc6cc \ud380\uce58\"\uc640 \uae30\ub3d9\uc131\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub294 \"\ube60\ub978 \ubc1c\ub180\ub9bc\"\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ud30c\uc6cc \ud380\uce58\"\uc5d0 \ucd08\uae30 \ud22c\uc790\ud558\uba74 \"\ud06c\ub7ec\uc154\"\uc640 \uac19\uc740 \ub354 \uac15\ub825\ud55c \uc0c1\ub300\ub97c \ubb3c\ub9ac\uce58\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4. \ub2e8\uacc4 1: \ub9e4\uce58\ub97c \uc644\ub8cc\ud558\uc5ec \uc2a4\ud0ac \ud3ec\uc778\ud2b8\ub97c \uc5bb\uc73c\uc138\uc694. \ub2e8\uacc4 2: \uc2a4\ud0ac \ud2b8\ub9ac\ub97c \ud0d0\uc0c9\ud558\uc5ec \uc5c5\uadf8\ub808\uc774\ub4dc \uc6b0\uc120\uc21c\uc704\ub97c \uc815\ud558\uc138\uc694. \ub2e8\uacc4 3: \ub2e4\uc591\ud55c \ube4c\ub4dc\ub97c \uc2dc\ub3c4\ud558\uc138\uc694. \uc2a4\ud0ac \ud2b8\ub9ac\ub97c \uc9c0\ub3c4\ucc98\ub7fc \uc0dd\uac01\ud558\uc138\uc694. \ud50c\ub808\uc774 \uc2a4\ud0c0\uc77c\uacfc \uc77c\uce58\ud558\ub294 \uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc120\ud0dd\ud558\uc138\uc694."}, {"question": "\ud380\uce58 \ud0b9 3D \ud611\ub3d9 \ubaa8\ub4dc\uc5d0\uc11c \uc5b4\ub5a4 \uce90\ub9ad\ud130\ub4e4\uc774 \uac00\uc7a5 \uc88b\uc740 \uc2dc\ub108\uc9c0\ub97c \ubcf4\uc774\uc8e0?", "answer": "\ud380\uce58 \ud0b9 3D \ud611\ub3d9 \ubaa8\ub4dc\uc5d0\uc11c \uce90\ub9ad\ud130 \uc2dc\ub108\uc9c0\ub294 \uc911\uc694\ud569\ub2c8\ub2e4. \"\uaca9\ud22c\uac00\"\uc640 \"\uae30\uc220\uac00\" \uacc4\uc5f4\uc774 \uc798 \uc5b4\uc6b8\ub9bd\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uaca9\ud22c\uac00\uc758 \ub192\uc740 \ud53c\ud574\ub7c9\uc740 \uae30\uc220\uac00\uc758 \uc81c\uc5b4 \ub2a5\ub825\uc744 \ubcf4\uc644\ud569\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc0c1\ud638 \ubcf4\uc644\uc801\uc778 \uc2a4\ud0ac\uc744 \uac00\uc9c4 \uce90\ub9ad\ud130\ub97c \uc120\ud0dd\ud558\uc138\uc694. \ub2e8\uacc4 2: \ud6a8\uc728\uc744 \uadf9\ub300\ud654\ud558\uae30 \uc704\ud574 \uacf5\uaca9\uc744 \uc870\uc815\ud558\uc138\uc694. \ub2e8\uacc4 3: \uce90\ub9ad\ud130 \ud2b9\uc815 \ucf64\ubcf4\ub97c \uc0ac\uc6a9\ud558\uc138\uc694. \uc774\ub7ec\ud55c \uc2dc\ub108\uc9c0\ub97c \uc798 \uc624\uc77c\uce60\ud55c \uae30\uacc4\ucc98\ub7fc \uc0dd\uac01\ud558\uc138\uc694. \uac01 \ubd80\ubd84\uc740 \ub2e4\ub978 \ubd80\ubd84\uc758 \uc131\ub2a5\uc744 \ub192\uc785\ub2c8\ub2e4."}, {"question": "\ud380\uce58 \ud0b9 3D\uc5d0\uc11c \ub300\ubd80\ubd84\uc758 \ud50c\ub808\uc774\uc5b4\uac00 \uac04\uacfc\ud558\ub294 \uc228\uaca8\uc9c4 \uba54\ucee4\ub2c8\uc998\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\ud380\uce58 \ud0b9 3D\uc758 \ud55c \uac00\uc9c0 \uc228\uaca8\uc9c4 \uba54\ucee4\ub2c8\uc998\uc740 \ud53c\ud574\ub97c \uc785\uc73c\uba74 \ucc44\uc6cc\uc9c0\ub294 \"\ubd84\ub178 \uac8c\uc774\uc9c0\"\uc785\ub2c8\ub2e4. \uac8c\uc774\uc9c0\uac00 \uac00\ub4dd \ucc28\uba74 \uac15\ub825\ud55c \"\ubd84\ub178 \ubaa8\ub4dc\"\uac00 \ud574\uc81c\ub429\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\ucd5c\uc885 \ub300\uacb0\" \uc2a4\ud14c\uc774\uc9c0\uc5d0\uc11c \ubd84\ub178 \ubaa8\ub4dc\ub97c \ud65c\uc131\ud654\ud558\uba74 \ud328\ubc30\uac00 \uc2b9\ub9ac\ub85c \ubc14\ub014 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \uac8c\uc774\uc9c0\ub97c \ucc44\uc6b0\uae30 \uc704\ud574 \uacc4\uc0b0\ub41c \ud0c0\uaca9\uc744 \uac00\ud558\uc138\uc694. \ub2e8\uacc4 2: \uc911\uc694\ud55c \uc21c\uac04\uc5d0 \ubd84\ub178 \ubaa8\ub4dc\ub97c \ud65c\uc131\ud654\ud558\uc138\uc694. \ub2e8\uacc4 3: \ud30c\uad34\uc801\uc778 \uacf5\uaca9\uc744 \ud37c\ubd80\uc73c\uc138\uc694. \uc774 \uba54\ucee4\ub2c8\uc998\uc740 \uc228\uaca8\uc9c4  ace\uc640 \uac19\uc2b5\ub2c8\ub2e4. \uc804\ub7b5\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc138\uc694."}, {"question": "\ud380\uce58 \ud0b9 3D\uc758 \ud53c\ud574 \uacc4\uc0b0 \uc2dc\uc2a4\ud15c\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?", "answer": "\ud380\uce58 \ud0b9 3D\uc758 \ud53c\ud574 \uacc4\uc0b0\uc740 \uacf5\uaca9\ub825, \ubc29\uc5b4\ub825 \ubc0f \uce58\uba85\ud0c0\uc5d0 \uae30\ubc18\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \uacf5\uaca9\ub825\uc774 50\uc778 \ud5e4\ube44 \ud380\uce58\ub97c \ubc29\uc5b4\ub825\uc774 20\uc778 \uc0c1\ub300\ubc29\uc5d0\uac8c \uac00\ud558\uba74 30\uc758 \ud53c\ud574\ub97c \uc785\ud799\ub2c8\ub2e4. \ub2e8\uacc4 1: \uce90\ub9ad\ud130\uc758 \uacf5\uaca9\ub825\uc744 \ud655\uc778\ud558\uc138\uc694. \ub2e8\uacc4 2: \uc0c1\ub300\ubc29\uc758 \ubc29\uc5b4\ub825\uc744 \uace0\ub824\ud558\uc138\uc694. \ub2e8\uacc4 3: \ucd5c\uc885 \ud53c\ud574\ub7c9\uc744 \uacc4\uc0b0\ud558\uc138\uc694. \uc774 \uc2dc\uc2a4\ud15c\uc740 \uc218\ud559 \ubc29\uc815\uc2dd\uacfc \uc720\uc0ac\ud569\ub2c8\ub2e4. \uac01 \ubcc0\uc218\ub294 \uacb0\uacfc\uc5d0 \uc601\ud5a5\uc744 \ubbf8\uce69\ub2c8\ub2e4."}, {"question": "\ud380\uce58 \ud0b9 3D\ub294 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud638\ud658\uc774 \ub418\uba70, \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc774\uc804\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud380\uce58 \ud0b9 3D\ub294 PC\uc640 \ucf58\uc194 \uac04\uc758 \ud06c\ub85c\uc2a4 \ud50c\ub7ab\ud3fc \ud50c\ub808\uc774\ub97c \uc9c0\uc6d0\ud569\ub2c8\ub2e4. \uc9c4\ud589 \uc0c1\ud669\uc744 \uc774\uc804\ud558\ub824\uba74 \uac8c\uc784\uc758 \ud074\ub77c\uc6b0\ub4dc \uc800\uc7a5 \uc2dc\uc2a4\ud15c\uc5d0 \uacc4\uc815\uc744 \uc5f0\uacb0\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, PC\uc5d0\uc11c PlayStation\uc73c\ub85c \uc804\ud658\ud558\ub294 \uacbd\uc6b0, \ub3d9\uc77c\ud55c \uacc4\uc815\uc73c\ub85c \ub85c\uadf8\uc778\ud558\uc5ec \ub370\uc774\ud130\uc5d0 \uc561\uc138\uc2a4\ud558\uc138\uc694. \ub2e8\uacc4 1: \ud074\ub77c\uc6b0\ub4dc \uacc4\uc815\uc744 \uc0dd\uc131\ud558\uc138\uc694. \ub2e8\uacc4 2: \uac8c\uc784 \ud504\ub85c\ud544\uc744 \uc5f0\uacb0\ud558\uc138\uc694. \ub2e8\uacc4 3: \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud558\uc138\uc694. \uc774 \uae30\ub2a5\uc744 \ud1b5\ud574 \uc7a5\uce58 \uac04\uc5d0 \uc6d0\ud65c\ud558\uac8c \uacc4\uc18d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, {"question": "\ud380\uce58 \ud0b9 3D\uc758 \ube44\ubc00\uc131\ucde8\ub294 \ubb34\uc5c7\uc774\uba70, \uc5b4\ub5bb\uac8c \ud574\uc81c\ud560 \uc218 \uc788\ub098\uc694?", "answer": "\ud380\uce58 \ud0b9 3D\uc5d0\ub294 \"\uc100\ub3c4\uc6b0 \ubcf5\uc11c\"\uc640 \uac19\uc740 \uc5ec\ub7ec \ube44\ubc00 \uc131\ucde8\uac00 \uc788\uc2b5\ub2c8\ub2e4. \ud53c\ud574\ub97c \uc785\uc9c0 \uc54a\uace0 \ub9e4\uce58\ub97c \uc774\uae30\uba74 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \"\uc0ac\uc77c\ub7f0\ud2b8 \ub3c4\uc7a5\" \uc2a4\ud14c\uc774\uc9c0\uc5d0\uc11c \uc644\ubcbd\ud55c \ud68c\ud53c\uc640 \ubc18\uaca9\uc744 \ud1b5\ud574 \uc774 \uc131\ucde8\ub97c \ub2ec\uc131\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \ubc29\uc5b4 \uae30\uc220\uc744 \uc5f0\uc2b5\ud558\uc138\uc694. \ub2e8\uacc4 2: \uc801\uc758 \ubaa8\ub4e0 \uacf5\uaca9\uc744 \ud53c\ud558\uc138\uc694. \ub2e8\uacc4 3: \uc644\ubcbd\ud558\uac8c \ub9e4\uce58\ub97c \uc774\uae30\uc138\uc694. \uc774\ub7ec\ud55c \uc131\ucde8\ub294 \uc228\uaca8\uc9c4 \ubcf4\ubb3c\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ub3c4\uc804\uc801\uc774\uc9c0\ub9cc \ubcf4\ub78c \uc788\ub294 \uc77c\uc785\ub2c8\ub2e4."}, {"question": "\uc800\uc0ac\uc591 \uae30\uae30\uc5d0\uc11c \ud380\uce58 \ud0b9 3D \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub294 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc778\uac00\uc694?", "answer": "\uc800\uc0ac\uc591 \uae30\uae30\uc5d0\uc11c \ud380\uce58 \ud0b9 3D \uc131\ub2a5\uc744 \ucd5c\uc801\ud654\ud558\ub824\uba74 \uadf8\ub798\ud53d \uc124\uc815\uc744 \ub0ae\ucd94\uace0 \ubc31\uadf8\ub77c\uc6b4\ub4dc \ud504\ub85c\uc138\uc2a4\ub97c \ube44\ud65c\uc131\ud654\ud558\uc138\uc694. \uc608\ub97c \ub4e4\uc5b4, \ud574\uc0c1\ub3c4\ub97c 720p\ub85c \ub0ae\ucd94\uba74 \uc131\ub2a5\uc774 \ud06c\uac8c \ud5a5\uc0c1\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \uc124\uc815 \uba54\ub274\uc5d0 \uc811\uadfc\ud558\uc138\uc694. \ub2e8\uacc4 2: \uadf8\ub798\ud53d \ubc0f \uc131\ub2a5 \uc635\uc158\uc744 \uc870\uc815\ud558\uc138\uc694. \ub2e8\uacc4 3: \uac8c\uc784\uc744 \uc800\uc7a5\ud558\uace0 \ub2e4\uc2dc \uc2dc\uc791\ud558\uc138\uc694. \uc774 \ucd5c\uc801\ud654\ub294 \uc790\ub3d9\ucc28\ub97c \uc870\uc815\ud558\ub294 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc791\uc740 \uc870\uc815\uc73c\ub85c \uc6d0\ud65c\ud55c \uc131\ub2a5\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]
[{"question": "\u62f3\u76873D\u65b0\u624b\u5982\u4f55\u8fdb\u884c\u57fa\u672c\u8fde\u62db\uff1f", "answer": "\u5728\u62f3\u76873D\u4e2d\uff0c\u638c\u63e1\u57fa\u672c\u8fde\u62db\u5bf9\u4e8e\u65b0\u624b\u73a9\u5bb6\u81f3\u5173\u91cd\u8981\u3002\u9996\u5148\u8981\u719f\u7ec3\u638c\u63e1\u8f7b\u62f3(LP)\u548c\u91cd\u62f3(HP)\u6309\u952e\u3002\u4e00\u4e2a\u7b80\u5355\u7684\u8fde\u62db\u662fLP\u2192LP\u2192HP\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u4e2a\u8bad\u7ec3\u5173\u5361\u4e2d\uff0c\u4f7f\u7528\u8fd9\u4e2a\u8fde\u62db\u51fb\u8d25\u8bad\u7ec3\u6728\u6869\u3002\u6b65\u9aa41\uff1a\u6309\u4e24\u6b21LP\u3002\u6b65\u9aa42\uff1a\u63a5\u7740\u6309HP\u3002\u6b65\u9aa43\uff1a\u91cd\u590d\u4ee5\u4e0a\u6b65\u9aa4\uff0c\u5efa\u7acb\u808c\u8089\u8bb0\u5fc6\u3002\u8fd9\u4e2a\u8fde\u62db\u5bf9\u5927\u591a\u6570\u65e9\u671f\u6e38\u620f\u5bf9\u624b\u90fd\u975e\u5e38\u6709\u6548\u3002"}, {"question": "\u5728\u62f3\u76873D\u4e2d\uff0c\u4e3a\u4ec0\u4e48\u4f53\u529b\u7ba1\u7406\u81f3\u5173\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u4f18\u5316\uff1f", "answer": "\u5728\u62f3\u76873D\u4e2d\uff0c\u4f53\u529b\u7ba1\u7406\u81f3\u5173\u91cd\u8981\uff0c\u56e0\u4e3a\u5b83\u4f1a\u5f71\u54cd\u4f60\u7684\u653b\u51fb\u548c\u95ea\u907f\u80fd\u529b\u3002\u8981\u4f18\u5316\u4f53\u529b\uff0c\u9700\u8981\u5e73\u8861\u4f60\u7684\u653b\u51fb\u548c\u79fb\u52a8\u3002\u4f8b\u5982\uff0c\u5728\u201c\u738b\u8005\u7ade\u6280\u573a\u201d\u6a21\u5f0f\u4e0b\uff0c\u907f\u514d\u8fde\u7eed\u731b\u653b\uff0c\u800c\u662f\u4f7f\u7528\u65f6\u673a\u7cbe\u51c6\u7684\u6253\u51fb\u3002\u6b65\u9aa41\uff1a\u5728\u6218\u6597\u4e2d\u76d1\u63a7\u4f53\u529b\u6761\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u8f7b\u653b\u51fb\u6765\u4fdd\u5b58\u4f53\u529b\u3002\u6b65\u9aa43\uff1a\u5c06\u91cd\u653b\u51fb\u7559\u7ed9\u5173\u952e\u65f6\u523b\u3002\u628a\u4f53\u529b\u60f3\u8c61\u6210\u4e00\u4e2a\u6cb9\u7bb1\u2014\u2014\u660e\u667a\u5730\u4f7f\u7528\u5b83\uff0c\u907f\u514d\u5728\u6218\u6597\u4e2d\u9014\u8017\u5c3d\u3002"}, {"question": "\u62f3\u76873D\u9ad8\u7ea7\u73a9\u5bb6\u7684\u6700\u4f73\u9632\u5fa1\u7b56\u7565\u662f\u4ec0\u4e48\uff1f", "answer": "\u62f3\u76873D\u4e2d\u7684\u9ad8\u7ea7\u73a9\u5bb6\u5e94\u8be5\u4e13\u6ce8\u4e8e\u683c\u6321\u548c\u95ea\u907f\u3002\u683c\u6321\u9700\u8981\u7cbe\u786e\u7684\u65f6\u673a\uff0c\u4f46\u53ef\u4ee5\u626d\u8f6c\u6218\u5c40\u3002\u4f8b\u5982\uff0c\u5bf9\u6297\u201c\u94c1\u62f3\u201d\u9996\u9886\uff0c\u683c\u6321\u4ed6\u7684\u91cd\u62f3\u8fdb\u884c\u53cd\u51fb\u3002\u6b65\u9aa41\uff1a\u89c2\u5bdf\u654c\u4eba\u653b\u51fb\u52a8\u753b\u3002\u6b65\u9aa42\uff1a\u5728\u51b2\u51fb\u524d\u6309\u4e0b\u683c\u6321\u952e\u3002\u6b65\u9aa43\uff1a\u8fdb\u884c\u540e\u7eed\u8fde\u62db\u3002\u95ea\u907f\u4e5f\u81f3\u5173\u91cd\u8981\u2014\u2014\u5411\u4fa7\u9762\u79fb\u52a8\u4ee5\u907f\u5f00\u76f4\u7ebf\u653b\u51fb\u3002\u5c06\u683c\u6321\u6bd4\u4f5c\u4e00\u6b21\u6070\u5230\u597d\u5904\u7684\u821e\u8e48\u52a8\u4f5c\u2014\u2014\u4e00\u5207\u90fd\u4e0e\u8282\u594f\u6709\u5173\u3002"}, {"question": "\u62f3\u76873D\u4e2d\u7684\u6280\u80fd\u6811\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff0c\u4ee5\u53ca\u54ea\u4e9b\u662f\u5173\u952e\u5347\u7ea7\uff1f", "answer": "\u62f3\u76873D\u4e2d\u7684\u6280\u80fd\u6811\u7cfb\u7edf\u5141\u8bb8\u73a9\u5bb6\u81ea\u5b9a\u4e49\u81ea\u5df1\u7684\u683c\u6597\u5bb6\u3002\u5173\u952e\u5347\u7ea7\u5305\u62ec\u201c\u5927\u529b\u62f3\u201d\uff0c\u4ee5\u589e\u52a0\u4f24\u5bb3\uff0c\u4ee5\u53ca\u201c\u8fc5\u6377\u6b65\u4f10\u201d\uff0c\u4ee5\u63d0\u9ad8\u673a\u52a8\u6027\u3002\u4f8b\u5982\uff0c\u5c3d\u65e9\u6295\u8d44\u4e8e\u201c\u5927\u529b\u62f3\u201d\u53ef\u4ee5\u5e2e\u52a9\u51fb\u8d25\u50cf\u201c\u7834\u574f\u8005\u201d\u8fd9\u6837\u66f4\u5f3a\u5927\u7684\u5bf9\u624b\u3002\u6b65\u9aa41\uff1a\u901a\u8fc7\u5b8c\u6210\u6bd4\u8d5b\u83b7\u5f97\u6280\u80fd\u70b9\u3002\u6b65\u9aa42\uff1a\u6d4f\u89c8\u6280\u80fd\u6811\uff0c\u4f18\u5148\u9009\u62e9\u5347\u7ea7\u3002\u6b65\u9aa43\uff1a\u5c1d\u8bd5\u4e0d\u540c\u7684\u6784\u5efa\u3002\u628a\u6280\u80fd\u6811\u60f3\u8c61\u6210\u4e00\u6761\u8def\u7ebf\u56fe\u2014\u2014\u9009\u62e9\u4e0e\u4f60\u7684\u6e38\u620f\u98ce\u683c\u76f8\u7b26\u7684\u5347\u7ea7\u3002"}, {"question": "\u62f3\u76873D\u4e2d\u54ea\u4e9b\u89d2\u8272\u5728\u5408\u4f5c\u6a21\u5f0f\u4e0b\u5177\u6709\u6700\u4f73\u534f\u540c\u4f5c\u7528\uff1f", "answer": "\u5728\u62f3\u76873D\u7684\u5408\u4f5c\u6a21\u5f0f\u4e2d\uff0c\u89d2\u8272\u534f\u540c\u4f5c\u7528\u81f3\u5173\u91cd\u8981\u3002\u201c\u683c\u6597\u5bb6\u201d\u548c\u201c\u6280\u672f\u5458\u201d\u8fd9\u4e24\u4e2a\u89d2\u8272\u7ec4\u5408\u5f97\u5f88\u597d\u3002\u4f8b\u5982\uff0c\u201c\u683c\u6597\u5bb6\u201d\u7684\u9ad8\u4f24\u5bb3\u8f93\u51fa\u8865\u5145\u4e86\u201c\u6280\u672f\u5458\u201d\u7684\u63a7\u5236\u80fd\u529b\u3002\u6b65\u9aa41\uff1a\u9009\u62e9\u6280\u80fd\u4e92\u8865\u7684\u89d2\u8272\u3002\u6b65\u9aa42\uff1a\u534f\u8c03\u653b\u51fb\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u6548\u7387\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u89d2\u8272\u7279\u6709\u7684\u8fde\u62db\u3002\u60f3\u8c61\u4e00\u4e0b\u8fd9\u79cd\u534f\u540c\u4f5c\u7528\u72b9\u5982\u4e00\u53f0\u8fd0\u8f6c\u826f\u597d\u7684\u673a\u5668\u2014\u2014\u6bcf\u4e00\u90e8\u5206\u90fd\u589e\u5f3a\u4e86\u5176\u4ed6\u90e8\u5206\u7684\u8868\u73b0\u3002"}, {"question": "\u62f3\u76873D\u4e2d\u54ea\u4e9b\u9690\u85cf\u673a\u5236\u662f\u5927\u591a\u6570\u73a9\u5bb6\u5ffd\u7565\u7684\uff1f", "answer": "\u62f3\u76873D\u7684\u4e00\u4e2a\u9690\u85cf\u673a\u5236\u662f\u201c\u72c2\u6012\u8ba1\u91cf\u5668\u201d\uff0c\u5728\u53d7\u5230\u4f24\u5bb3\u65f6\u4f1a\u9010\u6e10\u5145\u6ee1\u3002\u5145\u6ee1\u540e\uff0c\u5b83\u4f1a\u89e3\u9501\u5f3a\u5927\u7684\u72c2\u6012\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u5728\u201c\u6700\u7ec8\u51b3\u6218\u201d\u9636\u6bb5\uff0c\u6fc0\u6d3b\u72c2\u6012\u6a21\u5f0f\u53ef\u4ee5\u5c06\u4e00\u573a\u8d25\u5c40\u8f6c\u5316\u4e3a\u80dc\u5229\u3002\u6b65\u9aa41\uff1a\u6709\u8ba1\u5212\u5730\u6328\u6253\u6765\u586b\u5145\u8ba1\u91cf\u5668\u3002\u6b65\u9aa42\uff1a\u5728\u5173\u952e\u65f6\u523b\u6fc0\u6d3b\u72c2\u6012\u6a21\u5f0f\u3002\u6b65\u9aa43\uff1a\u91ca\u653e\u6bc1\u706d\u6027\u7684\u653b\u51fb\u3002\u8fd9\u4e2a\u673a\u5236\u5c31\u50cf\u4f60\u8896\u5b50\u91cc\u85cf\u7740\u7684\u79d8\u5bc6\u738b\u724c\u2014\u2014\u6218\u7565\u6027\u5730\u4f7f\u7528\u5b83\u3002"}, {"question": "\u62f3\u76873D\u7684\u4f24\u5bb3\u8ba1\u7b97\u7cfb\u7edf\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u62f3\u76873D\u7684\u4f24\u5bb3\u8ba1\u7b97\u57fa\u4e8e\u653b\u51fb\u529b\u3001\u9632\u5fa1\u503c\u548c\u66b4\u51fb\u4f24\u5bb3\u3002\u4f8b\u5982\uff0c\u4e00\u4e2a\u653b\u51fb\u529b\u4e3a50\u7684\u91cd\u62f3\u51fb\u6253\u4e00\u4e2a\u9632\u5fa1\u503c\u4e3a20\u7684\u5bf9\u624b\uff0c\u9020\u6210\u7684\u4f24\u5bb3\u4e3a30\u3002\u6b65\u9aa41\uff1a\u68c0\u67e5\u4f60\u7684\u89d2\u8272\u7684\u653b\u51fb\u5c5e\u6027\u3002\u6b65\u9aa42\uff1a\u8003\u8651\u5bf9\u624b\u7684\u9632\u5fa1\u503c\u3002\u6b65\u9aa43\uff1a\u8ba1\u7b97\u6700\u7ec8\u4f24\u5bb3\u3002\u8fd9\u4e2a\u7cfb\u7edf\u7c7b\u4f3c\u4e8e\u4e00\u4e2a\u6570\u5b66\u65b9\u7a0b\u5f0f\u2014\u2014\u6bcf\u4e2a\u53d8\u91cf\u90fd\u4f1a\u5f71\u54cd\u7ed3\u679c\u3002"}, {"question": "\u62f3\u76873D\u662f\u5426\u652f\u6301\u8de8\u5e73\u53f0\u517c\u5bb9\uff0c\u4ee5\u53ca\u5982\u4f55\u8f6c\u79fb\u8fdb\u5ea6\uff1f", "answer": "\u62f3\u76873D\u652f\u6301PC\u548c\u4e3b\u673a\u4e4b\u95f4\u7684\u8de8\u5e73\u53f0\u6e38\u620f\u3002\u8981\u8f6c\u79fb\u8fdb\u5ea6\uff0c\u8bf7\u5c06\u4f60\u7684\u5e10\u6237\u94fe\u63a5\u5230\u6e38\u620f\u7684\u4e91\u7aef\u5b58\u6863\u7cfb\u7edf\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u4ecePC\u5207\u6362\u5230PlayStation\uff0c\u8bf7\u4f7f\u7528\u540c\u4e00\u4e2a\u5e10\u6237\u767b\u5f55\uff0c\u4ee5\u8bbf\u95ee\u4f60\u7684\u6570\u636e\u3002\u6b65\u9aa41\uff1a\u521b\u5efa\u4e91\u7aef\u5e10\u6237\u3002\u6b65\u9aa42\uff1a\u94fe\u63a5\u4f60\u7684\u6e38\u620f\u4e2a\u4eba\u8d44\u6599\u3002\u6b65\u9aa43\uff1a\u540c\u6b65\u4f60\u7684\u8fdb\u5ea6\u3002\u6b64\u529f\u80fd\u786e\u4fdd\u4f60\u7684\u65c5\u7a0b\u53ef\u4ee5\u5728\u4e0d\u540c\u8bbe\u5907\u4e4b\u95f4\u65e0\u7f1d\u7ee7\u7eed\u3002"}, {"question": "\u62f3\u76873D\u6709\u54ea\u4e9b\u9690\u85cf\u6210\u5c31\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9501\u5b83\u4eec\uff1f", "answer": "\u62f3\u76873D\u6709\u4e00\u4e9b\u9690\u85cf\u6210\u5c31\uff0c\u4f8b\u5982\u201c\u5f71\u5b50\u62f3\u624b\u201d\uff0c\u901a\u8fc7\u5728\u4e0d\u53d7\u5230\u4f24\u5bb3\u7684\u60c5\u51b5\u4e0b\u8d62\u5f97\u6bd4\u8d5b\u83b7\u5f97\u3002\u4f8b\u5982\uff0c\u5728\u201c\u9759\u8c27\u6b66\u9053\u9986\u201d\u9636\u6bb5\uff0c\u4f7f\u7528\u5b8c\u7f8e\u7684\u95ea\u907f\u548c\u53cd\u51fb\u6765\u5b9e\u73b0\u8fd9\u4e00\u70b9\u3002\u6b65\u9aa41\uff1a\u7ec3\u4e60\u9632\u5fa1\u6280\u5de7\u3002\u6b65\u9aa42\uff1a\u907f\u514d\u6240\u6709\u654c\u4eba\u7684\u653b\u51fb\u3002\u6b65\u9aa43\uff1a\u5b8c\u7f8e\u8d62\u5f97\u6bd4\u8d5b\u3002\u8fd9\u4e9b\u6210\u5c31\u5c31\u50cf\u9690\u85cf\u7684\u5b9d\u85cf\u2014\u2014\u5145\u6ee1\u6311\u6218\uff0c\u4f46\u56de\u62a5\u4e30\u539a\u3002"}, {"question": "\u5982\u4f55\u4f18\u5316\u62f3\u76873D\u5728\u4f4e\u7aef\u8bbe\u5907\u4e0a\u7684\u6027\u80fd\uff1f", "answer": "\u8981\u5728\u4f4e\u7aef\u8bbe\u5907\u4e0a\u4f18\u5316\u62f3\u76873D\u7684\u6027\u80fd\uff0c\u8bf7\u964d\u4f4e\u56fe\u5f62\u8bbe\u7f6e\u5e76\u7981\u7528\u540e\u53f0\u8fdb\u7a0b\u3002\u4f8b\u5982\uff0c\u5c06\u5206\u8fa8\u7387\u964d\u4f4e\u5230720p\u53ef\u4ee5\u663e\u8457\u63d0\u9ad8\u6027\u80fd\u3002\u6b65\u9aa41\uff1a\u8bbf\u95ee\u8bbe\u7f6e\u83dc\u5355\u3002\u6b65\u9aa42\uff1a\u8c03\u6574\u56fe\u5f62\u548c\u6027\u80fd\u9009\u9879\u3002\u6b65\u9aa43\uff1a\u4fdd\u5b58\u5e76\u91cd\u65b0\u542f\u52a8\u6e38\u620f\u3002\u8fd9\u79cd\u4f18\u5316\u5c31\u50cf\u8c03\u6574\u6c7d\u8f66\u2014\u2014\u7ec6\u5fae\u7684\u8c03\u6574\u53ef\u4ee5\u5e26\u6765\u66f4\u6d41\u7545\u7684\u6027\u80fd\u3002"}]
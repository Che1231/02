[{"question": "\u5982\u4f55\u9032\u884c\u62f3\u738b3D\u521d\u5b78\u8005\u7684\u57fa\u672c\u9023\u64ca\uff1f", "answer": "\u5728\u62f3\u738b3D\u4e2d\uff0c\u57f7\u884c\u57fa\u672c\u9023\u64ca\u5c0d\u65bc\u65b0\u624b\u73a9\u5bb6\u81f3\u95dc\u91cd\u8981\u3002\u9996\u5148\u8981\u638c\u63e1\u8f15\u62f3\uff08LP\uff09\u548c\u91cd\u62f3\uff08HP\uff09\u6309\u9215\u3002\u4e00\u500b\u7c21\u55ae\u7684\u9023\u64ca\u662fLP \u2192 LP \u2192 HP\u3002\u4f8b\u5982\uff0c\u5728\u7b2c\u4e00\u500b\u8a13\u7df4\u7d1a\u5225\u4e2d\uff0c\u4f7f\u7528\u9019\u500b\u9023\u64ca\u4f86\u64ca\u6557\u7df4\u7fd2\u9776\u3002\u6b65\u9a5f1\uff1a\u9023\u6309LP\u5169\u6b21\u3002\u6b65\u9a5f2\uff1a\u63a5\u8457\u7528HP\u3002\u6b65\u9a5f3\uff1a\u91cd\u8907\u4ee5\u4e0a\u6b65\u9a5f\uff0c\u5efa\u7acb\u808c\u8089\u8a18\u61b6\u3002\u9019\u500b\u9023\u64ca\u5c0d\u5927\u591a\u6578\u521d\u671f\u5c0d\u624b\u90fd\u975e\u5e38\u6709\u6548\u3002"}, {"question": "\u70ba\u4ec0\u9ebc\u62f3\u738b3D\u4e2d\u7684\u9ad4\u529b\u7ba1\u7406\u81f3\u95dc\u91cd\u8981\uff0c\u4ee5\u53ca\u5982\u4f55\u512a\u5316\u5b83\uff1f", "answer": "\u5728\u62f3\u738b3D\u4e2d\uff0c\u9ad4\u529b\u7ba1\u7406\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u6703\u5f71\u97ff\u4f60\u7684\u653b\u64ca\u548c\u9583\u907f\u80fd\u529b\u3002\u70ba\u4e86\u512a\u5316\u9ad4\u529b\uff0c\u5e73\u8861\u4f60\u7684\u653b\u64ca\u548c\u52d5\u4f5c\u3002\u4f8b\u5982\uff0c\u5728\u300c\u738b\u5ea7\u7af6\u6280\u5834\u300d\u6a21\u5f0f\u4e2d\uff0c\u907f\u514d\u9023\u7e8c\u731b\u64ca\uff0c\u800c\u662f\u4f7f\u7528\u6642\u6a5f\u653b\u64ca\u3002\u6b65\u9a5f1\uff1a\u5728\u6230\u9b25\u4e2d\u76e3\u63a7\u9ad4\u529b\u689d\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u8f15\u653b\u64ca\u4f86\u7bc0\u7d04\u9ad4\u529b\u3002\u6b65\u9a5f3\uff1a\u5c07\u91cd\u653b\u64ca\u7559\u7d66\u95dc\u9375\u6642\u523b\u3002\u628a\u9ad4\u529b\u60f3\u50cf\u6210\u6c7d\u6cb9\u7bb1\uff0c\u660e\u667a\u5730\u4f7f\u7528\u5b83\uff0c\u907f\u514d\u5728\u6230\u9b25\u4e2d\u9014\u8017\u76e1\u3002"}, {"question": "\u62f3\u738b3D\u4e2d\u9032\u968e\u73a9\u5bb6\u7684\u6700\u4f73\u9632\u5b88\u7b56\u7565\u662f\u4ec0\u9ebc\uff1f", "answer": "\u62f3\u738b3D\u4e2d\u7684\u9032\u968e\u73a9\u5bb6\u61c9\u8a72\u5c08\u6ce8\u65bc\u683c\u64cb\u548c\u9583\u907f\u3002\u683c\u64cb\u9700\u8981\u7cbe\u78ba\u7684\u6642\u6a5f\uff0c\u4f46\u53ef\u4ee5\u626d\u8f49\u6230\u5c40\u3002\u4f8b\u5982\uff0c\u9762\u5c0d\u300c\u9435\u62f3\u300dBoss\uff0c\u683c\u64cb\u4ed6\u7684\u91cd\u62f3\u4ee5\u53cd\u64ca\u3002\u6b65\u9a5f1\uff1a\u89c0\u5bdf\u6575\u4eba\u7684\u653b\u64ca\u52d5\u756b\u3002\u6b65\u9a5f2\uff1a\u5728\u885d\u64ca\u767c\u751f\u524d\u6309\u4f4f\u683c\u64cb\u6309\u9215\u3002\u6b65\u9a5f3\uff1a\u63a5\u8457\u7528\u9023\u64ca\u3002\u9583\u907f\u4e5f\u5f88\u91cd\u8981\u2014\u2014\u5411\u5074\u9762\u79fb\u52d5\u4ee5\u8eb2\u907f\u7dda\u6027\u653b\u64ca\u3002\u628a\u683c\u64cb\u6bd4\u4f5c\u6070\u5230\u597d\u8655\u7684\u821e\u8e48\u52d5\u4f5c\u2014\u2014\u91cd\u9ede\u5728\u65bc\u7bc0\u594f\u3002"}, {"question": "\u62f3\u738b3D\u4e2d\u7684\u6280\u80fd\u6a39\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff0c\u4ee5\u53ca\u4e3b\u8981\u7684\u5347\u7d1a\u662f\u4ec0\u9ebc\uff1f", "answer": "\u62f3\u738b3D\u4e2d\u7684\u6280\u80fd\u6a39\u5141\u8a31\u73a9\u5bb6\u81ea\u8a02\u81ea\u5df1\u7684\u683c\u9b25\u5bb6\u3002\u4e3b\u8981\u5347\u7d1a\u5305\u62ec\u300c\u7206\u64ca\u62f3\u300d\u4ee5\u589e\u52a0\u50b7\u5bb3\u548c\u300c\u8fc5\u6377\u6b65\u4f10\u300d\u4ee5\u63d0\u9ad8\u884c\u52d5\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u5728\u65e9\u671f\u6295\u8cc7\u300c\u7206\u64ca\u62f3\u300d\u53ef\u4ee5\u5e6b\u52a9\u64ca\u6557\u50cf\u300c\u6bc0\u6ec5\u8005\u300d\u9019\u6a23\u7684\u66f4\u5f37\u5927\u7684\u5c0d\u624b\u3002\u6b65\u9a5f1\uff1a\u901a\u904e\u5b8c\u6210\u6bd4\u8cfd\u7372\u5f97\u6280\u80fd\u9ede\u3002\u6b65\u9a5f2\uff1a\u700f\u89bd\u6280\u80fd\u6a39\uff0c\u512a\u5148\u8003\u616e\u5347\u7d1a\u3002\u6b65\u9a5f3\uff1a\u5617\u8a66\u4e0d\u540c\u7684\u7d44\u5408\u3002\u5c07\u6280\u80fd\u6a39\u8996\u70ba\u8def\u7dda\u5716\u2014\u2014\u9078\u64c7\u8207\u4f60\u7684\u904a\u6232\u98a8\u683c\u76f8\u7b26\u7684\u5347\u7d1a\u3002"}, {"question": "\u62f3\u738b3D\u4e2d\u54ea\u4e9b\u89d2\u8272\u5728\u5408\u4f5c\u6a21\u5f0f\u4e0b\u5177\u6709\u6700\u4f73\u7684\u5354\u540c\u4f5c\u7528\uff1f", "answer": "\u5728\u62f3\u738b3D\u7684\u5408\u4f5c\u6a21\u5f0f\u4e2d\uff0c\u89d2\u8272\u4e4b\u9593\u7684\u5354\u540c\u4f5c\u7528\u81f3\u95dc\u91cd\u8981\u3002\u300c\u683c\u9b25\u5bb6\u300d\u548c\u300c\u6280\u8853\u5c08\u5bb6\u300d\u5169\u500b\u985e\u5225\u914d\u5408\u5f97\u5f88\u597d\u3002\u4f8b\u5982\uff0c\u683c\u9b25\u5bb6\u7684\u9ad8\u50b7\u5bb3\u8f38\u51fa\u88dc\u5145\u4e86\u6280\u8853\u5c08\u5bb6\u7684\u7fa4\u9ad4\u63a7\u5236\u80fd\u529b\u3002\u6b65\u9a5f1\uff1a\u9078\u64c7\u5177\u6709\u4e92\u88dc\u6280\u80fd\u7684\u89d2\u8272\u3002\u6b65\u9a5f2\uff1a\u5354\u8abf\u653b\u64ca\uff0c\u4ee5\u6700\u5927\u9650\u5ea6\u5730\u63d0\u9ad8\u6548\u7387\u3002\u6b65\u9a5f3\uff1a\u4f7f\u7528\u89d2\u8272\u7279\u5b9a\u9023\u64ca\u3002\u5c07\u9019\u7a2e\u5354\u540c\u4f5c\u7528\u60f3\u50cf\u6210\u4e00\u53f0\u7cbe\u5bc6\u7684\u6a5f\u5668\u2014\u2014\u6bcf\u500b\u90e8\u5206\u90fd\u589e\u5f37\u4e86\u53e6\u4e00\u500b\u90e8\u5206\u7684\u8868\u73fe\u3002"}, {"question": "\u62f3\u738b3D\u4e2d\u6700\u88ab\u5927\u591a\u6578\u73a9\u5bb6\u5ffd\u8996\u7684\u96b1\u85cf\u6a5f\u5236\u662f\u4ec0\u9ebc\uff1f", "answer": "\u62f3\u738b3D\u4e2d\u7684\u4e00\u500b\u96b1\u85cf\u6a5f\u5236\u662f\u300c\u72c2\u6012\u8a08\u91cf\u5668\u300d\uff0c\u5728\u53d7\u5230\u50b7\u5bb3\u6642\u6703\u7a4d\u7d2f\u3002\u7576\u7a4d\u6eff\u6642\uff0c\u5b83\u6703\u89e3\u9396\u5f37\u5927\u7684\u72c2\u6012\u6a21\u5f0f\u3002\u4f8b\u5982\uff0c\u5728\u300c\u6700\u7d42\u6c7a\u6230\u300d\u968e\u6bb5\uff0c\u555f\u52d5\u72c2\u6012\u6a21\u5f0f\u53ef\u4ee5\u5c07\u4e00\u5834\u5931\u6557\u7684\u6230\u9b25\u8f49\u8b8a\u70ba\u52dd\u5229\u3002\u6b65\u9a5f1\uff1a\u8a08\u7b97\u5730\u53d7\u50b7\u4ee5\u586b\u6eff\u8a08\u91cf\u5668\u3002\u6b65\u9a5f2\uff1a\u5728\u95dc\u9375\u6642\u523b\u555f\u52d5\u72c2\u6012\u6a21\u5f0f\u3002\u6b65\u9a5f3\uff1a\u91cb\u653e\u6bc0\u6ec5\u6027\u7684\u653b\u64ca\u3002\u9019\u500b\u6a5f\u5236\u5c31\u50cf\u4f60\u8896\u5b50\u88e1\u85cf\u7684\u4e00\u5f35\u738b\u724c\u2014\u2014\u7b56\u7565\u6027\u5730\u4f7f\u7528\u5b83\u3002"}, {"question": "\u62f3\u738b3D\u4e2d\u7684\u50b7\u5bb3\u8a08\u7b97\u7cfb\u7d71\u5982\u4f55\u904b\u4f5c\uff1f", "answer": "\u62f3\u738b3D\u4e2d\u7684\u50b7\u5bb3\u8a08\u7b97\u57fa\u65bc\u653b\u64ca\u529b\u3001\u9632\u79a6\u80fd\u529b\u548c\u66b4\u64ca\u50b7\u5bb3\u3002\u4f8b\u5982\uff0c50\u653b\u64ca\u529b\u7684\u91cd\u62f3\u5c0d\u9632\u79a6\u80fd\u529b\u70ba20\u7684\u5c0d\u624b\u9020\u621030\u9ede\u50b7\u5bb3\u3002\u6b65\u9a5f1\uff1a\u67e5\u770b\u4f60\u7684\u89d2\u8272\u7684\u653b\u64ca\u7d71\u8a08\u3002\u6b65\u9a5f2\uff1a\u8003\u616e\u5c0d\u624b\u7684\u9632\u79a6\u3002\u6b65\u9a5f3\uff1a\u8a08\u7b97\u6700\u7d42\u50b7\u5bb3\u3002\u9019\u500b\u7cfb\u7d71\u985e\u4f3c\u65bc\u4e00\u500b\u6578\u5b78\u65b9\u7a0b\u5f0f\u2014\u2014\u6bcf\u500b\u8b8a\u91cf\u90fd\u6703\u5f71\u97ff\u7d50\u679c\u3002"}, {"question": "\u62f3\u738b3D\u662f\u5426\u652f\u63f4\u8de8\u5e73\u53f0\u76f8\u5bb9\uff0c\u4ee5\u53ca\u5982\u4f55\u8f49\u79fb\u9032\u5ea6\uff1f", "answer": "\u62f3\u738b3D\u652f\u63f4PC\u548c\u4e3b\u6a5f\u4e4b\u9593\u7684\u8de8\u5e73\u53f0\u904a\u6232\u3002\u8981\u8f49\u79fb\u9032\u5ea6\uff0c\u8acb\u5c07\u60a8\u7684\u5e33\u6236\u9023\u7d50\u5230\u904a\u6232\u7684\u96f2\u7aef\u5132\u5b58\u7cfb\u7d71\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5f9ePC\u5207\u63db\u5230PlayStation\uff0c\u8acb\u4f7f\u7528\u76f8\u540c\u7684\u5e33\u6236\u767b\u5165\u4ee5\u5b58\u53d6\u60a8\u7684\u8cc7\u6599\u3002\u6b65\u9a5f1\uff1a\u5efa\u7acb\u4e00\u500b\u96f2\u7aef\u5e33\u6236\u3002\u6b65\u9a5f2\uff1a\u9023\u7d50\u60a8\u7684\u904a\u6232\u500b\u4eba\u6a94\u6848\u3002\u6b65\u9a5f3\uff1a\u540c\u6b65\u60a8\u7684\u9032\u5ea6\u3002\u6b64\u529f\u80fd\u78ba\u4fdd\u60a8\u7684\u65c5\u7a0b\u53ef\u5728\u4e0d\u540c\u88dd\u7f6e\u4e4b\u9593\u9806\u5229\u7e7c\u7e8c\u3002"}, {"question": "\u62f3\u738b3D\u4e2d\u7684\u79d8\u5bc6\u6210\u5c31\u6709\u54ea\u4e9b\uff0c\u4ee5\u53ca\u5982\u4f55\u89e3\u9396\u5b83\u5011\uff1f", "answer": "\u62f3\u738b3D\u6709\u4e00\u4e9b\u79d8\u5bc6\u6210\u5c31\uff0c\u4f8b\u5982\u300c\u5f71\u5b50\u62f3\u64ca\u5bb6\u300d\uff0c\u9019\u9805\u6210\u5c31\u662f\u5728\u4e0d\u53d7\u5230\u4efb\u4f55\u50b7\u5bb3\u7684\u60c5\u6cc1\u4e0b\u8d0f\u5f97\u6bd4\u8cfd\u800c\u7372\u5f97\u7684\u3002\u4f8b\u5982\uff0c\u5728\u300c\u975c\u8b10\u9053\u5834\u300d\u968e\u6bb5\uff0c\u4f7f\u7528\u5b8c\u7f8e\u7684\u9583\u907f\u548c\u53cd\u64ca\u4f86\u9054\u6210\u9019\u9805\u6210\u5c31\u3002\u6b65\u9a5f1\uff1a\u7df4\u7fd2\u9632\u5b88\u6280\u5de7\u3002\u6b65\u9a5f2\uff1a\u907f\u514d\u6240\u6709\u6575\u4eba\u653b\u64ca\u3002\u6b65\u9a5f3\uff1a\u5b8c\u7f8e\u5730\u8d0f\u5f97\u6bd4\u8cfd\u3002\u9019\u4e9b\u6210\u5c31\u5c31\u50cf\u96b1\u85cf\u7684\u5bf6\u85cf\u2014\u2014\u5177\u6709\u6311\u6230\u6027\u4f46\u56de\u5831\u8c50\u539a\u3002"}, {"question": "\u5982\u4f55\u512a\u5316\u62f3\u738b3D\u5728\u4f4e\u7aef\u88dd\u7f6e\u4e0a\u7684\u6548\u80fd\uff1f", "answer": "\u70ba\u4e86\u5728\u4f4e\u7aef\u88dd\u7f6e\u4e0a\u512a\u5316\u62f3\u738b3D\u7684\u6548\u80fd\uff0c\u8acb\u964d\u4f4e\u5716\u5f62\u8a2d\u5b9a\u4e26\u505c\u7528\u80cc\u666f\u8655\u7406\u3002\u4f8b\u5982\uff0c\u5c07\u89e3\u6790\u5ea6\u964d\u4f4e\u5230720p\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u6548\u80fd\u3002\u6b65\u9a5f1\uff1a\u9032\u5165\u8a2d\u5b9a\u9078\u55ae\u3002\u6b65\u9a5f2\uff1a\u8abf\u6574\u5716\u5f62\u548c\u6548\u80fd\u9078\u9805\u3002\u6b65\u9a5f3\uff1a\u5132\u5b58\u4e26\u91cd\u65b0\u555f\u52d5\u904a\u6232\u3002\u9019\u500b\u512a\u5316\u5c31\u50cf\u8abf\u6574\u6c7d\u8eca\u4e00\u6a23\u2014\u2014\u5c0f\u7684\u8abf\u6574\u53ef\u4ee5\u5e36\u4f86\u66f4\u9806\u66a2\u7684\u8868\u73fe\u3002"}]
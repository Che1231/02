[{"question": "\ucd08\ubcf4\uc790\ub97c \uc704\ud55c \ud130\ud0a4 \ub2e4\ub9c8\uc758 \ubcf4\ub4dc \uc124\uc815 \ubc29\ubc95\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud130\ud0a4 \ub2e4\ub9c8 \ubcf4\ub4dc\ub97c \uc124\uc815\ud558\ub824\uba74 8x8 \uccb4\ud06c\ubcf4\ub4dc\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \uac01 \ud50c\ub808\uc774\uc5b4\ub294 \uc790\uc2e0\uc5d0\uac8c \uac00\uc7a5 \uac00\uae4c\uc6b4 2\uc5f4\uacfc 3\uc5f4\uc5d0 16\uac1c\uc758 \ub9d0\uc744 \ub193\uace0, \uac80\uc740\uc0c9 \uce78\uc744 \ucc44\uc6c1\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ud50c\ub808\uc774\uc5b4 1\uc740 1\uc5f4\uacfc 2\uc5f4\uc5d0 \ub9d0\uc744 \ub193\uace0, \ud50c\ub808\uc774\uc5b4 2\ub294 7\uc5f4\uacfc 8\uc5f4\uc5d0 \ub9d0\uc744 \ub193\uc2b5\ub2c8\ub2e4. \uc774\ub807\uac8c \ud558\uba74 \ub450 \ud50c\ub808\uc774\uc5b4 \ubaa8\ub450 \uc804\ub7b5\uc801\uc778 \uc704\uce58\uc5d0 \ub3d9\uc77c\ud55c \uc218\uc758 \ub9d0\ub85c \uc2dc\uc791\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\uad6c\uc131\ud45c]"}, {"question": "\ud130\ud0a4 \ub2e4\ub9c8\uc758 \uae30\ubcf8 \uc774\ub3d9 \uaddc\uce59\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud130\ud0a4 \ub2e4\ub9c8\uc5d0\uc11c \ub9d0\uc740 \uc55e\uc73c\ub85c \ub610\ub294 \uc606\uc73c\ub85c \uc778\uc811\ud55c \uac80\uc740\uc0c9 \uce78\uc73c\ub85c \uc774\ub3d9\ud558\uc9c0\ub9cc, \ub300\uac01\uc120\uc73c\ub85c\ub294 \uc774\ub3d9\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, D4\uc5d0 \uc788\ub294 \ub9d0\uc740 C4, D5 \ub610\ub294 E4\ub85c \uc774\ub3d9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. (\uc774 \uce78\uc774 \ube44\uc5b4 \uc788\ub2e4\uba74). \uccb4\ud06c\ub294 \uc0c1\ub300\ubc29\uc758 \ub9d0\uc744 \uac74\ub108\ub6f0\uc5b4 \ubc14\ub85c \uadf8 \ub2e4\uc74c \uce78\uc5d0 \ub193\ub294 \ubc29\uc2dd\uc73c\ub85c \ud3ec\ud68d\ud569\ub2c8\ub2e4. \uc774 \uaddc\uce59\uc740 \uc55e\uc73c\ub85c \ub610\ub294 \uc606\uc73c\ub85c \ubaa8\ub450 \uc801\uc6a9\ub429\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85]"}, {"question": "\uc65c \ud130\ud0a4 \ub2e4\ub9c8\uc5d0\uc11c \ub9d0\uc740 \ub300\uac01\uc120\uc73c\ub85c \uc774\ub3d9\ud560 \uc218 \uc5c6\ub294 \uac83\uc785\ub2c8\uae4c?", "answer": "\ud130\ud0a4 \ub2e4\ub9c8\ub294 \ub2e4\ub978 \ub2e4\ub9c8 \uac8c\uc784\uacfc \ub2ec\ub9ac \ub9d0\uc774 \ub300\uac01\uc120\uc73c\ub85c \uc774\ub3d9\ud560 \uc218 \uc5c6\uace0, \uc55e\uc73c\ub85c \ub610\ub294 \uc606\uc73c\ub85c\ub9cc \uc774\ub3d9\ud560 \uc218 \uc788\ub3c4\ub85d \uc81c\ud55c\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uace0\uc720\ud55c \uaddc\uce59\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \ub354 \uc2e0\uc911\ud558\uac8c \uc218\ub97c \uacc4\ud68d\ud574\uc57c \ud558\ubbc0\ub85c \uc804\ub7b5\uc131\uc744 \ub354\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, E5\uc5d0 \uc788\ub294 \ub9d0\uc740 \ub2e4\ub978 \ub2e4\ub9c8 \uac8c\uc784\uc5d0\uc11c \uac00\ub2a5\ud55c D6 \ub610\ub294 F6\uc73c\ub85c \uc774\ub3d9\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uc774 \uc81c\ud55c\uc740 \ud50c\ub808\uc774\uc5b4\uac00 \uc704\uce58\uc640 \ud3ec\ud68d\uc5d0 \ub300\ud574 \ub2e4\ub978 \ubc29\uc2dd\uc73c\ub85c \uc0dd\uac01\ud558\ub3c4\ub85d \uc7a5\ub824\ud569\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\ubc95 \ube44\uad50]"}, {"question": "100\uc2dc\uac04\uc758 \ud50c\ub808\uc774 \ud6c4 \ud130\ud0a4 \ub2e4\ub9c8\uc5d0\uc11c \ud3ec\ud68d \uc804\ub7b5\uc744 \uc5b4\ub5bb\uac8c \uac1c\uc120\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ud130\ud0a4 \ub2e4\ub9c8\uc5d0\uc11c \ud3ec\ud68d \uc804\ub7b5\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub824\uba74 \ub2e4\uc74c \ub2e8\uacc4\ub97c \ub530\ub974\uc2ed\uc2dc\uc624. \ub2e8\uacc4 1: \ud56d\uc0c1 \ud55c \ubc88\uc758 \uc774\ub3d9\uc73c\ub85c \uc5ec\ub7ec \ud3ec\ud68d \uae30\ud68c\ub97c \ucc3e\uc73c\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \ubcf4\ub4dc \uc911\uc559\uc744 \uc9c0\ubc30\ud558\uae30 \uc704\ud574 \ub9d0\uc744 \ubc30\uce58\ud558\uc5ec \ud3ec\ud68d \uac00\ub2a5\uc131\uc744 \ub192\uc774\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \uc655\uc88c\uc758 \ub9d0\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc0ac\uc6a9\ud558\uc5ec \uc55e\ub4a4\ub85c \uc6c0\uc9c1\uc77c \uc218 \uc788\ub294 \ub2a5\ub825\uc744 \ud65c\uc6a9\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, C3\uc5d0 \uc788\ub294 \uc655\uc88c\ub294 \uc5ec\ub7ec \ubc29\ud5a5\uc73c\ub85c \ub9d0\uc744 \ud3ec\ud68d\ud560 \uc218 \uc788\uc5b4 \uc804\ub7b5\uc801\uc778 \uc635\uc158\uc744 \ub298\ub9bd\ub2c8\ub2e4. [\ud750\ub984\ub3c4]"}, {"question": "\ud130\ud0a4 \ub2e4\ub9c8 \uc911\ubc18\uc804\uc744 \uc9c0\ubc30\ud558\uae30 \uc704\ud574 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \uace0\uae09 \uc804\uc220\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud130\ud0a4 \ub2e4\ub9c8 \uc911\ubc18\uc804\uc5d0\uc11c \ub2e4\uc74c \uc804\uc220\uc5d0 \uc9d1\uc911\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 1: \uc0c1\ub300\ubc29\uc758 \uc774\ub3d9 \uc635\uc158\uc744 \uc81c\ud55c\ud558\uae30 \uc704\ud574 \uc8fc\uc694 \uce78\uc744 \uc9c0\ubc30\ud558\uc2ed\uc2dc\uc624. \ub2e8\uacc4 2: \ub2e4\uc74c \uc218\ub97c \uacc4\ud68d\ud558\uba74\uc11c \ub9d0\uc744 \ubcf4\ud638\ud558\uae30 \uc704\ud574 \uac15\ub825\ud55c \ubc29\uc5b4 \ub77c\uc778\uc744 \ub9cc\ub4dc\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \ub9d0\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc5ec\ub7ec \ud3ec\ud68d\uc744 \ud5c8\uc6a9\ud558\ub294 '\ub2e4\ub9ac'\ub97c \ub9cc\ub4dc\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, E4\uc5d0 \ub9d0\uc744 \ub193\uc73c\uba74 \uc0c1\ub300\ubc29\uc744 \ub9c9\uc73c\uba74\uc11c \ub3d9\uc2dc\uc5d0 E6\uc5d0\uc11c \uc7a0\uc7ac\uc801\uc778 \ud3ec\ud68d\uc744 \uc124\uc815\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\ubc95 \ube44\uad50]"}, {"question": "\ud130\ud0a4 \ub2e4\ub9c8 \uc885\ubc18\uc804\uc5d0\uc11c \uac00\uc7a5 \ud6a8\uacfc\uc801\uc778 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud130\ud0a4 \ub2e4\ub9c8 \uc885\ubc18\uc804\uc5d0\uc11c \ud6a8\uacfc\uc801\uc778 \uc804\ub7b5\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4 1: \ub9d0\uc744 \uc655\uc88c\ub85c \uc2b9\uc9c4\uc2dc\ud0a4\ub294 \uac83\uc744 \uc6b0\uc120\uc2dc\ud558\uc2ed\uc2dc\uc624. \uc65c\ub0d0\ud558\uba74 \uc655\uc88c\ub294 \uc774\ub3d9\uc131\uc774 \ub354 \ub6f0\uc5b4\ub098\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. \ub2e8\uacc4 2: \uc655\uc88c\ub97c \uc0ac\uc6a9\ud558\uc5ec \ubcf4\ub4dc\ub97c \uc9c0\ubc30\ud558\uace0 \uc0c1\ub300\ubc29\uc744 \uad6c\uc11d\uc73c\ub85c \ubab0\uc544\ub123\uc73c\uc2ed\uc2dc\uc624. \ub2e8\uacc4 3: \uc0c1\ub300\ubc29\uc5d0\uac8c \ud569\ubc95\uc801\uc778 \uc774\ub3d9 \uc218\uac00 \uc804\ud600 \ub0a8\uc9c0 \uc54a\ub3c4\ub85d \uc218\ub97c \uacc4\ud68d\ud558\uc2ed\uc2dc\uc624. \uc608\ub97c \ub4e4\uc5b4, G7\uc5d0 \uc788\ub294 \uc655\uc88c\ub294 \uc804\uccb4 \ud589\uc744 \ud1b5\uc81c\ud560 \uc218 \uc788\uc73c\ubbc0\ub85c \uc0c1\ub300\ubc29\uc758 \uc635\uc158\uc744 \uc81c\ud55c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ud750\ub984\ub3c4]"}, {"question": "\ud130\ud0a4 \ub2e4\ub9c8\uc5d0\uc11c \uc655 \uc774\ub3d9 \uba54\ucee4\ub2c8\uc998\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud569\ub2c8\uae4c?", "answer": "\ud130\ud0a4 \ub2e4\ub9c8\uc5d0\uc11c \ub9d0\uc740 \uc0c1\ub300\ubc29 \ud3b8\uc758 \ub9c8\uc9c0\ub9c9 \uc904\uc5d0 \ub3c4\ucc29\ud558\uba74 \uc655\uc88c\uac00 \ub429\ub2c8\ub2e4. \uc655\uc88c\ub294 \uc55e\ub4a4, \uc606\uc73c\ub85c \uc6c0\uc9c1\uc77c \uc218 \uc788\uc9c0\ub9cc, \ub300\uac01\uc120\uc73c\ub85c\ub294 \uc6c0\uc9c1\uc77c \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, D8\uc5d0 \uc788\ub294 \uc655\uc88c\ub294 C8, D7 \ub610\ub294 E8\ub85c \uc774\ub3d9\ud560 \uc218 \uc788\uc5b4 \uc720\uc5f0\uc131\uacfc \uc804\ub7b5\uc801 \uc635\uc158\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4. \uc774 \uba54\ucee4\ub2c8\uc998\uc740 \ub354\uc6b1 \uc5ed\ub3d9\uc801\uc778 \uac8c\uc784 \ud50c\ub808\uc774\uc640 \ubcf5\uc7a1\ud55c \uc804\ub7b5\uc744 \uac00\ub2a5\ud558\uac8c \ud569\ub2c8\ub2e4. [\uad6c\uc131\ud45c]"}, {"question": "\ud130\ud0a4 \ub2e4\ub9c8\uc5d0\uc11c '\ube44\ud589 \uc655\uc88c' \uaddc\uce59\uc758 \uc911\uc694\uc131\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud130\ud0a4 \ub2e4\ub9c8\uc758 '\ube44\ud589 \uc655\uc88c' \uaddc\uce59\uc740 \uc655\uc88c\uac00 \uacbd\ub85c\uac00 \uae68\ub057\ud558\ub2e4\uba74 \uc9c1\uc120\uc73c\ub85c \uc5ec\ub7ec \uce78\uc744 \uc774\ub3d9\ud560 \uc218 \uc788\ub3c4\ub85d \ud5c8\uc6a9\ud569\ub2c8\ub2e4. \uc774 \uaddc\uce59\uc740 \uc655\uc88c\uc758 \ud798\uacfc \uc804\ub7b5\uc801 \uac00\uce58\ub97c \ud06c\uac8c \ud5a5\uc0c1\uc2dc\ud0b5\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4 A1\uc5d0 \uc788\ub294 \uc655\uc88c\ub294 \uc911\uac04 \ubaa8\ub4e0 \uce78\uc774 \ube44\uc5b4 \uc788\uc73c\uba74 H1\ub85c \uc9c1\uc811 \uc774\ub3d9\ud558\uc5ec \ube60\ub974\uac8c \uc704\uce58\ub97c \uc7ac\uc870\uc815\ud558\uace0 \uc5ec\ub7ec \ud3ec\ud68d \uae30\ud68c\ub97c \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85]"}, {"question": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc \uac04\uc5d0 \ud130\ud0a4 \ub2e4\ub9c8 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc5b4\ub5bb\uac8c \uc804\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\uae4c?", "answer": "\ub2e4\ub978 \ud50c\ub7ab\ud3fc \uac04\uc758 \ud130\ud0a4 \ub2e4\ub9c8 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc804\uc1a1\ud558\ub824\uba74 \uc77c\ubc18\uc801\uc778 \ud504\ub85c\ud544(\uc608: Google Play \ub610\ub294 Apple Game Center)\uacfc \uac8c\uc784 \uacc4\uc815\uc744 \uc5f0\uacb0\ud569\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, \ubaa8\ubc14\uc77c \ubc0f PC\uc5d0\uc11c \ubaa8\ub450 \uac8c\uc784\uc744 \ud50c\ub808\uc774\ud558\ub294 \uacbd\uc6b0 \ub450 \uae30\uae30 \ubaa8\ub450 \ub3d9\uc77c\ud55c \uacc4\uc815\uc5d0 \ub85c\uadf8\uc778\ud558\uc5ec \uc9c4\ud589 \uc0c1\ud669\uc744 \ub3d9\uae30\ud654\ud558\uc2ed\uc2dc\uc624. \uc77c\ubd80 \ud50c\ub7ab\ud3fc\uc740 \ub370\uc774\ud130 \ub9c8\uc774\uadf8\ub808\uc774\uc158\uc744 \uc704\ud574 \uc218\ub3d9 \uc800\uc7a5/\ub85c\ub4dc \uc635\uc158\uc744 \uc81c\uacf5\ud560 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. [\ub2e4\uc591\ud55c \ubc29\ubc95 \ube44\uad50]"}, {"question": "\uc0c1\ub300\ubc29\uc744 \ub180\ub77c\uac8c \ud558\uae30 \uc704\ud55c \ud130\ud0a4 \ub2e4\ub9c8\uc758 \uc228\uaca8\uc9c4 \uc804\ub7b5\uc740 \ubb34\uc5c7\uc785\ub2c8\uae4c?", "answer": "\ud130\ud0a4 \ub2e4\ub9c8\uc758 \uc228\uaca8\uc9c4 \uc804\ub7b5 \uc911 \ud558\ub098\ub294 '\ud76c\uc0dd \ud568\uc815'\uc785\ub2c8\ub2e4. \uc989, \uc758\ub3c4\uc801\uc73c\ub85c \ub9d0\uc744 \ud76c\uc0dd\ud558\uc5ec \uc5ec\ub7ec \ud3ec\ud68d\uc744 \uc124\uc815\ud558\ub294 \uac83\uc785\ub2c8\ub2e4. \uc608\ub97c \ub4e4\uc5b4, E5\ub85c \ub9d0\uc744 \uc774\ub3d9\ud558\ub294 \uac83\uc740 \uc190\uc2e4\ucc98\ub7fc \ubcf4\uc77c \uc218 \uc788\uc9c0\ub9cc, \ub2e4\uc74c \uc218\ub85c \uc0c1\ub300\ubc29\uc758 \ub9d0 \uc138 \uac1c\ub97c \ud3ec\ud68d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc804\uc220\uc740 \uc815\ud655\ud55c \uacc4\ud68d\uc774 \ud544\uc694\ud558\uace0 \uc0c1\ub300\ubc29\uc744 \uc758\uc678\ub85c \ub180\ub77c\uac8c \ud558\uc5ec \uac8c\uc784\uc758 \ud750\ub984\uc744 \ubc14\uafc0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. [\ube44\uc720 \uc124\uba85]"}]
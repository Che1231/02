[{"question": "\u30c8\u30eb\u30b3\u5c06\u68cb\u3092\u521d\u5fc3\u8005\u3068\u3057\u3066\u3069\u306e\u3088\u3046\u306b\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7\u3059\u308c\u3070\u3088\u3044\u3067\u3059\u304b\uff1f", "answer": "\u30c8\u30eb\u30b3\u5c06\u68cb\u306e\u76e4\u9762\u3092\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7\u3059\u308b\u306b\u306f\u30018x8\u306e\u99d2\u76e4\u304c\u5fc5\u8981\u3067\u3059\u3002\u5404\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u3001\u81ea\u5206\u306e16\u679a\u306e\u99d2\u3092\u81ea\u5206\u306b\u8fd1\u30442\u884c\u76ee\u30683\u884c\u76ee\u306b\u7f6e\u304d\u3001\u6697\u3044\u8272\u306e\u30de\u30b9\u306b\u4e26\u3079\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30d7\u30ec\u30a4\u30e4\u30fc1\u306f\u99d2\u30921\u884c\u76ee\u30682\u884c\u76ee\u306b\u7f6e\u304d\u3001\u30d7\u30ec\u30a4\u30e4\u30fc2\u306f\u99d2\u30927\u884c\u76ee\u30688\u884c\u76ee\u306b\u7f6e\u304d\u307e\u3059\u3002\u3053\u3046\u3059\u308b\u3053\u3068\u3067\u3001\u4e21\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u6226\u7565\u7684\u306a\u4f4d\u7f6e\u306b\u540c\u3058\u6570\u306e\u99d2\u3092\u30b9\u30bf\u30fc\u30c8\u3067\u304d\u307e\u3059\u3002[\u8a2d\u5b9a\u4e00\u89a7]"}, {"question": "\u30c8\u30eb\u30b3\u5c06\u68cb\u306e\u57fa\u672c\u7684\u306a\u79fb\u52d5\u30eb\u30fc\u30eb\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30c8\u30eb\u30b3\u5c06\u68cb\u3067\u306f\u3001\u99d2\u306f\u96a3\u63a5\u3059\u308b\u6697\u3044\u8272\u306e\u30de\u30b9\u306b\u524d\u5f8c\u306b\u6a2a\u306b\u79fb\u52d5\u3057\u307e\u3059\u304c\u3001\u5bfe\u89d2\u7dda\u4e0a\u306b\u79fb\u52d5\u3067\u304d\u307e\u305b\u3093\u3002\u305f\u3068\u3048\u3070\u3001D4\u306e\u99d2\u306f\u3001\u305d\u308c\u3089\u306e\u30de\u30b9\u304c\u7a7a\u3044\u3066\u3044\u308b\u5834\u5408\u3001C4\u3001D5\u3001\u307e\u305f\u306fE4\u306b\u79fb\u52d5\u3067\u304d\u307e\u3059\u3002\u6355\u7372\u306f\u3001\u76f8\u624b\u306e\u99d2\u3092\u98db\u3073\u8d8a\u3048\u3066\u3001\u305d\u306e\u3059\u3050\u5411\u3053\u3046\u306e\u30de\u30b9\u306b\u79fb\u52d5\u3059\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u884c\u308f\u308c\u307e\u3059\u3002\u3053\u306e\u30eb\u30fc\u30eb\u306f\u3001\u524d\u5f8c\u306b\u6a2a\u306b\u3082\u9069\u7528\u3055\u308c\u307e\u3059\u3002[\u4f8b\u793a]"}, {"question": "\u306a\u305c\u30c8\u30eb\u30b3\u5c06\u68cb\u3067\u306f\u99d2\u3092\u5bfe\u89d2\u7dda\u4e0a\u306b\u79fb\u52d5\u3067\u304d\u306a\u3044\u306e\u3067\u3059\u304b\uff1f", "answer": "\u30c8\u30eb\u30b3\u5c06\u68cb\u306f\u4ed6\u306e\u5c06\u68cb\u3068\u7570\u306a\u308a\u3001\u5bfe\u89d2\u7dda\u4e0a\u3078\u306e\u79fb\u52d5\u3067\u306f\u306a\u304f\u3001\u524d\u5f8c\u5de6\u53f3\u3078\u306e\u79fb\u52d5\u306e\u307f\u3092\u8a31\u53ef\u3057\u3066\u3044\u307e\u3059\u3002\u3053\u306e\u72ec\u81ea\u306e\u30eb\u30fc\u30eb\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u304c\u81ea\u5206\u306e\u52d5\u304d\u3092\u3088\u308a\u614e\u91cd\u306b\u8a08\u753b\u3057\u306a\u3051\u308c\u3070\u306a\u3089\u306a\u3044\u305f\u3081\u3001\u6226\u7565\u6027\u3092\u9ad8\u3081\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001E5\u306e\u99d2\u306f\u3001\u4ed6\u306e\u5c06\u68cb\u30b2\u30fc\u30e0\u3067\u53ef\u80fd\u306aD6\u307e\u305f\u306fF6\u306b\u79fb\u52d5\u3067\u304d\u307e\u305b\u3093\u3002\u3053\u306e\u5236\u9650\u306f\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u306b\u914d\u7f6e\u3068\u6355\u7372\u306b\u3064\u3044\u3066\u7570\u306a\u308b\u65b9\u6cd5\u3067\u8003\u3048\u308b\u3088\u3046\u306b\u4fc3\u3057\u307e\u3059\u3002[\u6bd4\u8f03\u691c\u8a0e]"}, {"question": "100\u6642\u9593\u30d7\u30ec\u30a4\u3057\u305f\u5f8c\u3001\u30c8\u30eb\u30b3\u5c06\u68cb\u3067\u6355\u7372\u6226\u7565\u3092\u3069\u306e\u3088\u3046\u306b\u6539\u5584\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u30c8\u30eb\u30b3\u5c06\u68cb\u306e\u6355\u7372\u6226\u7565\u3092\u5f37\u5316\u3059\u308b\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u624b\u9806\u306b\u5f93\u3044\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u5e38\u306b\u30011\u56de\u306e\u79fb\u52d5\u3067\u8907\u6570\u306e\u6355\u7372\u3092\u751f\u307f\u51fa\u3059\u6a5f\u4f1a\u3092\u63a2\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u99d2\u3092\u76e4\u306e\u4e2d\u592e\u306b\u914d\u7f6e\u3057\u3066\u3001\u6355\u7372\u306e\u6a5f\u4f1a\u3092\u591a\u304f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u81ea\u5206\u306e\u738b\u69d8\u99d2\u3092\u52b9\u679c\u7684\u306b\u4f7f\u3044\u3001\u524d\u5f8c\u4e21\u65b9\u306e\u79fb\u52d5\u80fd\u529b\u3092\u6d3b\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3068\u3048\u3070\u3001C3\u306e\u738b\u69d8\u99d2\u306f\u3001\u8907\u6570\u306e\u65b9\u5411\u306b\u99d2\u3092\u6355\u7372\u3057\u3001\u6226\u7565\u7684\u306a\u9078\u629e\u80a2\u3092\u5897\u3084\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u624b\u9806\u56f3]"}, {"question": "\u30c8\u30eb\u30b3\u5c06\u68cb\u306e\u4e2d\u76e4\u6226\u3067\u512a\u4f4d\u306b\u7acb\u3064\u305f\u3081\u306b\u4f7f\u7528\u3067\u304d\u308b\u9ad8\u5ea6\u306a\u6226\u8853\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30c8\u30eb\u30b3\u5c06\u68cb\u306e\u4e2d\u76e4\u6226\u3067\u306f\u3001\u4ee5\u4e0b\u306e\u6226\u8853\u306b\u7126\u70b9\u3092\u5f53\u3066\u307e\u3057\u3087\u3046\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u76f8\u624b\u306e\u79fb\u52d5\u624b\u6bb5\u3092\u5236\u9650\u3059\u308b\u305f\u3081\u306b\u91cd\u8981\u306a\u30de\u30b9\u3092\u652f\u914d\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u81ea\u5206\u306e\u99d2\u3092\u5b88\u308a\u306a\u304c\u3089\u6b21\u306e\u624b\u3092\u8a08\u753b\u3059\u308b\u305f\u3081\u306b\u3001\u5f37\u529b\u306a\u9632\u5fa1\u7dda\u3092\u69cb\u7bc9\u3057\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u99d2\u3092\u3064\u306a\u3052\u3066\u8907\u6570\u6355\u7372\u3067\u304d\u308b\u300c\u6a4b\u300d\u3092\u4f5c\u308a\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001E4\u306b\u99d2\u3092\u7f6e\u304f\u3053\u3068\u3067\u3001\u76f8\u624b\u3092\u963b\u6b62\u3057\u3064\u3064\u3001E6\u3067\u6355\u7372\u3059\u308b\u53ef\u80fd\u6027\u3092\u4f5c\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u6bd4\u8f03\u691c\u8a0e]"}, {"question": "\u30c8\u30eb\u30b3\u5c06\u68cb\u306e\u7d42\u76e4\u6226\u3067\u6700\u3082\u52b9\u679c\u7684\u306a\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30c8\u30eb\u30b3\u5c06\u68cb\u306e\u7d42\u76e4\u6226\u3067\u52b9\u679c\u7684\u306a\u6226\u7565\u306f\u4ee5\u4e0b\u306e\u901a\u308a\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d71\uff1a\u99d2\u3092\u738b\u69d8\u99d2\u306b\u6607\u683c\u3055\u305b\u308b\u3053\u3068\u3092\u512a\u5148\u3057\u307e\u3059\u3002\u738b\u69d8\u99d2\u306f\u79fb\u52d5\u304c\u3088\u308a\u5e83\u3044\u304b\u3089\u3067\u3059\u3002\u30b9\u30c6\u30c3\u30d72\uff1a\u738b\u69d8\u99d2\u3092\u4f7f\u3063\u3066\u76e4\u9762\u3092\u652f\u914d\u3057\u3001\u76f8\u624b\u3092\u8ffd\u3044\u8a70\u3081\u307e\u3059\u3002\u30b9\u30c6\u30c3\u30d73\uff1a\u76f8\u624b\u306b\u5408\u6cd5\u7684\u306a\u624b\u304c\u306a\u304f\u306a\u308b\u72b6\u6cc1\u3092\u4f5c\u308b\u3088\u3046\u306b\u624b\u3092\u8a08\u753b\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001G7\u306e\u738b\u69d8\u99d2\u306f\u3001\u6574\u5217\u3092\u652f\u914d\u3057\u3001\u76f8\u624b\u306e\u9078\u629e\u80a2\u3092\u5236\u9650\u3067\u304d\u307e\u3059\u3002[\u624b\u9806\u56f3]"}, {"question": "\u30c8\u30eb\u30b3\u5c06\u68cb\u306e\u738b\u69d8\u99d2\u306e\u79fb\u52d5\u30e1\u30ab\u30cb\u30ba\u30e0\u306f\u3069\u306e\u3088\u3046\u306b\u6a5f\u80fd\u3057\u307e\u3059\u304b\uff1f", "answer": "\u30c8\u30eb\u30b3\u5c06\u68cb\u3067\u3001\u738b\u69d8\u99d2\u306f\u3001\u76f8\u624b\u306e\u6700\u7d42\u884c\u306b\u99d2\u304c\u5230\u9054\u3059\u308b\u3068\u4f5c\u6210\u3055\u308c\u307e\u3059\u3002\u738b\u69d8\u99d2\u306f\u3001\u524d\u5f8c\u5de6\u53f3\u306b\u79fb\u52d5\u3067\u304d\u307e\u3059\u304c\u3001\u5bfe\u89d2\u7dda\u4e0a\u306b\u79fb\u52d5\u3067\u304d\u307e\u305b\u3093\u3002\u305f\u3068\u3048\u3070\u3001D8\u306e\u738b\u69d8\u99d2\u306f\u3001C8\u3001D7\u3001\u307e\u305f\u306fE8\u306b\u79fb\u52d5\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u67d4\u8edf\u6027\u304c\u5411\u4e0a\u3057\u3001\u3088\u308a\u8907\u96d1\u306a\u6226\u7565\u304c\u53ef\u80fd\u306b\u306a\u308a\u307e\u3059\u3002[\u8a2d\u5b9a\u4e00\u89a7]"}, {"question": "\u30c8\u30eb\u30b3\u5c06\u68cb\u306b\u304a\u3051\u308b\u300c\u98db\u7fd4\u738b\u300d\u30eb\u30fc\u30eb\u306f\u3069\u306e\u3088\u3046\u306a\u91cd\u8981\u6027\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u304b\uff1f", "answer": "\u30c8\u30eb\u30b3\u5c06\u68cb\u306e\u300c\u98db\u7fd4\u738b\u300d\u30eb\u30fc\u30eb\u3067\u306f\u3001\u738b\u69d8\u99d2\u306f\u3001\u901a\u8def\u304c\u7a7a\u3044\u3066\u3044\u308b\u9650\u308a\u3001\u4efb\u610f\u306e\u6570\u306e\u30de\u30b9\u3092\u307e\u3063\u3059\u3050\u306b\u79fb\u52d5\u3067\u304d\u307e\u3059\u3002\u3053\u306e\u30eb\u30fc\u30eb\u306f\u3001\u738b\u69d8\u99d2\u306e\u529b\u3068\u6226\u7565\u7684\u306a\u4fa1\u5024\u3092\u5927\u5e45\u306b\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001A1\u306e\u738b\u69d8\u99d2\u306f\u3001\u3059\u3079\u3066\u306e\u9593\u306e\u30de\u30b9\u304c\u7a7a\u3044\u3066\u3044\u308c\u3070\u3001H1\u306b\u76f4\u63a5\u79fb\u52d5\u3067\u304d\u307e\u3059\u3002\u3053\u308c\u306b\u3088\u308a\u3001\u8fc5\u901f\u306a\u518d\u914d\u7f6e\u3068\u8907\u6570\u306e\u6355\u7372\u6a5f\u4f1a\u304c\u5b9f\u73fe\u3057\u307e\u3059\u3002[\u4f8b\u793a]"}, {"question": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u30c8\u30eb\u30b3\u5c06\u68cb\u306e\u9032\u6357\u72b6\u6cc1\u3092\u3069\u306e\u3088\u3046\u306b\u79fb\u884c\u3067\u304d\u307e\u3059\u304b\uff1f", "answer": "\u7570\u306a\u308b\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u9593\u3067\u30c8\u30eb\u30b3\u5c06\u68cb\u306e\u9032\u6357\u72b6\u6cc1\u3092\u79fb\u884c\u3059\u308b\u306b\u306f\u3001\u901a\u5e38\u3001Google Play\u307e\u305f\u306fApple Game Center\u306a\u3069\u306e\u30e6\u30cb\u30d0\u30fc\u30b5\u30eb\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u306b\u30b2\u30fc\u30e0\u30a2\u30ab\u30a6\u30f3\u30c8\u3092\u30ea\u30f3\u30af\u3057\u307e\u3059\u3002\u305f\u3068\u3048\u3070\u3001\u30e2\u30d0\u30a4\u30eb\u3068PC\u306e\u4e21\u65b9\u3067\u30d7\u30ec\u30a4\u3059\u308b\u5834\u5408\u3001\u4e21\u65b9\u306e\u30c7\u30d0\u30a4\u30b9\u304c\u540c\u3058\u30a2\u30ab\u30a6\u30f3\u30c8\u306b\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u3001\u9032\u6357\u72b6\u6cc1\u3092\u540c\u671f\u3057\u307e\u3059\u3002\u4e00\u90e8\u306e\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u3067\u306f\u3001\u30c7\u30fc\u30bf\u79fb\u884c\u306e\u305f\u3081\u306b\u624b\u52d5\u306e\u4fdd\u5b58/\u8aad\u307f\u8fbc\u307f\u30aa\u30d7\u30b7\u30e7\u30f3\u3082\u63d0\u4f9b\u3055\u308c\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002[\u6bd4\u8f03\u691c\u8a0e]"}, {"question": "\u76f8\u624b\u3092\u9a5a\u304b\u305b\u308b\u305f\u3081\u3001\u30c8\u30eb\u30b3\u5c06\u68cb\u3067\u96a0\u3055\u308c\u305f\u6226\u7565\u306f\u4f55\u3067\u3059\u304b\uff1f", "answer": "\u30c8\u30eb\u30b3\u5c06\u68cb\u306e\u96a0\u3055\u308c\u305f\u6226\u7565\u306e1\u3064\u306f\u3001\u300c\u72a0\u7272\u306e\u7f60\u300d\u3067\u3059\u3002\u3053\u308c\u306f\u3001\u610f\u56f3\u7684\u306b\u99d2\u3092\u72a0\u7272\u306b\u3057\u3066\u8907\u6570\u306e\u6355\u7372\u3092\u751f\u307f\u51fa\u3059\u6226\u7565\u3067\u3059\u3002\u305f\u3068\u3048\u3070\u3001E5\u306b\u99d2\u3092\u79fb\u52d5\u3059\u308b\u3053\u3068\u306f\u640d\u5931\u306e\u3088\u3046\u306b\u898b\u3048\u307e\u3059\u304c\u3001\u6b21\u306e\u79fb\u52d5\u30673\u3064\u306e\u76f8\u624b\u306e\u99d2\u3092\u6355\u7372\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3053\u306e\u6226\u8853\u306f\u6b63\u78ba\u306a\u8a08\u753b\u304c\u5fc5\u8981\u3067\u3059\u3002\u76f8\u624b\u3092\u6cb9\u65ad\u3055\u305b\u3066\u3001\u30b2\u30fc\u30e0\u306e\u6d41\u308c\u3092\u5909\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002[\u4f8b\u793a]"}]
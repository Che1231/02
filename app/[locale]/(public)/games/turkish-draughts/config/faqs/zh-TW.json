[{"question": "\u5982\u4f55\u8a2d\u5b9a\u571f\u8033\u5176\u8df3\u68cb\u68cb\u76e4\uff0c\u4f5c\u70ba\u65b0\u624b\uff1f", "answer": "\u8981\u8a2d\u5b9a\u571f\u8033\u5176\u8df3\u68cb\u68cb\u76e4\uff0c\u60a8\u9700\u8981\u4e00\u500b8x8\u7684\u68cb\u76e4\u3002\u6bcf\u500b\u73a9\u5bb6\u5c07\u4ed6\u5011\u768416\u500b\u68cb\u5b50\u653e\u5728\u96e2\u4ed6\u5011\u6700\u8fd1\u7684\u7b2c\u4e8c\u6392\u548c\u7b2c\u4e09\u6392\uff0c\u586b\u6eff\u6df1\u8272\u65b9\u683c\u3002\u4f8b\u5982\uff0c\u73a9\u5bb61\u5c07\u68cb\u5b50\u653e\u5728\u7b2c1\u6392\u548c\u7b2c2\u6392\uff0c\u800c\u73a9\u5bb62\u5c07\u68cb\u5b50\u653e\u5728\u7b2c7\u6392\u548c\u7b2c8\u6392\u3002\u9019\u78ba\u4fdd\u4e86\u96d9\u65b9\u90fd\u4ee5\u540c\u7b49\u6578\u91cf\uff0c\u4e26\u5728\u6230\u7565\u4f4d\u7f6e\u4e0a\u958b\u59cb\u3002[\u914d\u7f6e\u5c0d\u7167\u8868]"}, {"question": "\u571f\u8033\u5176\u8df3\u68cb\u7684\u57fa\u672c\u79fb\u52d5\u898f\u5247\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u571f\u8033\u5176\u8df3\u68cb\u4e2d\uff0c\u68cb\u5b50\u5411\u524d\u6216\u5411\u5074\u9762\u79fb\u52d5\u5230\u76f8\u9130\u7684\u6df1\u8272\u65b9\u584a\uff0c\u4f46\u4e0d\u80fd\u5c0d\u89d2\u79fb\u52d5\u3002\u4f8b\u5982\uff0c\u4f4d\u65bcD4\u7684\u68cb\u5b50\u53ef\u4ee5\u79fb\u52d5\u5230C4\u3001D5\u6216E4\uff0c\u5982\u679c\u9019\u4e9b\u65b9\u584a\u662f\u7a7a\u7684\u3002\u6355\u7372\u5247\u901a\u904e\u8df3\u904e\u5c0d\u624b\u7684\u68cb\u5b50\uff0c\u4e26\u843d\u5728\u5176\u5f8c\u65b9\u7684\u65b9\u584a\u4e2d\u5b8c\u6210\u3002\u6b64\u898f\u5247\u9069\u7528\u65bc\u524d\u9032\u548c\u5074\u9762\u3002[\u6bd4\u55bb\u8aaa\u660e]"}, {"question": "\u70ba\u4ec0\u9ebc\u571f\u8033\u5176\u8df3\u68cb\u4e2d\u68cb\u5b50\u4e0d\u80fd\u5c0d\u89d2\u79fb\u52d5\uff1f", "answer": "\u571f\u8033\u5176\u8df3\u68cb\u8207\u5176\u4ed6\u8df3\u68cb\u8b8a\u9ad4\u4e0d\u540c\u4e4b\u8655\u5728\u65bc\uff0c\u5b83\u53ea\u5141\u8a31\u5411\u524d\u548c\u5411\u5074\u9762\u7684\u79fb\u52d5\uff0c\u800c\u4e0d\u662f\u5c0d\u89d2\u7dda\u79fb\u52d5\u3002\u9019\u9805\u7368\u7279\u7684\u898f\u5247\u589e\u52a0\u4e86\u7b56\u7565\u5c64\uff0c\u56e0\u70ba\u73a9\u5bb6\u5fc5\u9808\u66f4\u4ed4\u7d30\u5730\u8a08\u5283\u4ed6\u5011\u7684\u52d5\u4f5c\u3002\u4f8b\u5982\uff0c\u4f4d\u65bcE5\u7684\u68cb\u5b50\u4e0d\u80fd\u79fb\u52d5\u5230D6\u6216F6\uff0c\u9019\u5728\u5176\u4ed6\u8df3\u68cb\u904a\u6232\u4e2d\u662f\u53ef\u4ee5\u7684\u3002\u9019\u500b\u9650\u5236\u9f13\u52f5\u73a9\u5bb6\u4ee5\u4e0d\u540c\u7684\u65b9\u5f0f\u601d\u8003\u4f4d\u7f6e\u548c\u6355\u7372\u3002[\u591a\u65b9\u6848\u6bd4\u8f03]"}, {"question": "\u5728\u73a9\u4e86100\u5c0f\u6642\u7684\u571f\u8033\u5176\u8df3\u68cb\u5f8c\uff0c\u5982\u4f55\u6539\u9032\u6211\u7684\u6355\u7372\u7b56\u7565\uff1f", "answer": "\u8981\u589e\u5f37\u5728\u571f\u8033\u5176\u8df3\u68cb\u4e2d\u7684\u6355\u7372\u7b56\u7565\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a\u6b65\u9a5f1\uff1a\u59cb\u7d42\u5c0b\u627e\u55ae\u4e00\u52d5\u4f5c\u4e2d\u5275\u5efa\u591a\u500b\u6355\u7372\u7684\u6a5f\u6703\u3002\u6b65\u9a5f2\uff1a\u5c07\u68cb\u5b50\u64fa\u653e\u5728\u68cb\u76e4\u4e2d\u592e\uff0c\u56e0\u70ba\u9019\u6703\u589e\u52a0\u60a8\u7684\u6355\u7372\u6a5f\u7387\u3002\u6b65\u9a5f3\uff1a\u6709\u6548\u5229\u7528\u4f60\u7684\u738b\u68cb\u5b50\uff0c\u5229\u7528\u5b83\u5011\u53ef\u4ee5\u524d\u5f8c\u79fb\u52d5\u7684\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u4f4d\u65bcC3\u7684\u738b\u68cb\u5b50\u53ef\u4ee5\u6355\u6349\u591a\u500b\u65b9\u5411\u7684\u68cb\u5b50\uff0c\u589e\u52a0\u60a8\u7684\u6230\u7565\u9078\u64c7\u3002[\u6d41\u7a0b\u5716\u89e3]"}, {"question": "\u5728\u571f\u8033\u5176\u8df3\u68cb\u7684\u4e2d\u5c40\u4e2d\uff0c\u6211\u53ef\u4ee5\u7528\u54ea\u4e9b\u5148\u9032\u7684\u7b56\u7565\u4f86\u638c\u63a7\u5c40\u9762\uff1f", "answer": "\u5728\u571f\u8033\u5176\u8df3\u68cb\u7684\u4e2d\u5c40\u4e2d\uff0c\u8acb\u95dc\u6ce8\u9019\u4e9b\u7b56\u7565\uff1a\u6b65\u9a5f1\uff1a\u63a7\u5236\u95dc\u9375\u65b9\u584a\uff0c\u4ee5\u9650\u5236\u5c0d\u624b\u79fb\u52d5\u7684\u9078\u64c7\u3002\u6b65\u9a5f2\uff1a\u5efa\u7acb\u5805\u56fa\u7684\u9632\u79a6\u7dda\uff0c\u4fdd\u8b77\u4f60\u7684\u68cb\u5b50\uff0c\u540c\u6642\u8a08\u5283\u4f60\u7684\u4e0b\u4e00\u6b65\u68cb\u3002\u6b65\u9a5f3\uff1a\u4f7f\u7528\u68cb\u5b50\u5275\u9020\u4e00\u689d\u300c\u6a4b\u6a11\u300d\uff0c\u5141\u8a31\u9032\u884c\u591a\u6b21\u6355\u7372\u3002\u4f8b\u5982\uff0c\u5c07\u68cb\u5b50\u653e\u5728E4\u4e0a\u53ef\u4ee5\u963b\u64cb\u5c0d\u624b\uff0c\u540c\u6642\u8a2d\u5b9a\u5728E6\u4e0a\u7684\u6f5b\u5728\u6355\u7372\u3002[\u591a\u65b9\u6848\u6bd4\u8f03]"}, {"question": "\u5728\u571f\u8033\u5176\u8df3\u68cb\u7684\u7d42\u5c40\u4e2d\uff0c\u54ea\u4e9b\u7b56\u7565\u6700\u6709\u6548\uff1f", "answer": "\u571f\u8033\u5176\u8df3\u68cb\u7d42\u5c40\u4e2d\u7684\u6709\u6548\u7b56\u7565\u5305\u62ec\uff1a\u6b65\u9a5f1\uff1a\u512a\u5148\u5c07\u4f60\u7684\u68cb\u5b50\u63d0\u5347\u70ba\u738b\u68cb\uff0c\u56e0\u70ba\u5b83\u5011\u5177\u6709\u66f4\u5927\u7684\u79fb\u52d5\u6027\u3002\u6b65\u9a5f2\uff1a\u4f7f\u7528\u4f60\u7684\u738b\u68cb\u5b50\u63a7\u5236\u68cb\u76e4\uff0c\u4e26\u5c07\u5c0d\u624b\u903c\u5165\u89d2\u843d\u3002\u6b65\u9a5f3\uff1a\u8a08\u5283\u4f60\u7684\u52d5\u4f5c\uff0c\u5275\u9020\u5c0d\u624b\u6c92\u6709\u5408\u6cd5\u79fb\u52d5\u7684\u5c40\u9762\u3002\u4f8b\u5982\uff0c\u4f4d\u65bcG7\u7684\u738b\u68cb\u5b50\u53ef\u4ee5\u63a7\u5236\u6574\u500b\u9019\u4e00\u6392\uff0c\u9650\u5236\u5c0d\u624b\u7684\u9078\u64c7\u3002[\u6d41\u7a0b\u5716\u89e3]"}, {"question": "\u571f\u8033\u5176\u8df3\u68cb\u4e2d\u7684\u738b\u68cb\u79fb\u52d5\u6a5f\u5236\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff1f", "answer": "\u5728\u571f\u8033\u5176\u8df3\u68cb\u4e2d\uff0c\u7576\u68cb\u5b50\u5230\u9054\u5c0d\u624b\u4e00\u65b9\u7684\u6700\u5f8c\u4e00\u884c\u6642\uff0c\u5c31\u6703\u8b8a\u6210\u738b\u68cb\u3002\u738b\u68cb\u53ef\u4ee5\u524d\u5f8c\u4ee5\u53ca\u5de6\u53f3\u79fb\u52d5\uff0c\u4f46\u4ecd\u7136\u4e0d\u80fd\u5c0d\u89d2\u79fb\u52d5\u3002\u4f8b\u5982\uff0c\u4f4d\u65bcD8\u7684\u738b\u68cb\u53ef\u4ee5\u79fb\u52d5\u5230C8\u3001D7\u6216E8\uff0c\u63d0\u4f9b\u66f4\u5927\u7684\u9748\u6d3b\u6027\u53ca\u7b56\u7565\u9078\u9805\u3002\u6b64\u6a5f\u5236\u5141\u8a31\u66f4\u52d5\u614b\u7684\u904a\u6232\u73a9\u6cd5\u548c\u66f4\u8907\u96dc\u7684\u7b56\u7565\u3002[\u914d\u7f6e\u5c0d\u7167\u8868]"}, {"question": "\u571f\u8033\u5176\u8df3\u68cb\u4e2d\u300e\u98db\u7fd4\u738b\u300f\u898f\u5247\u7684\u610f\u7fa9\u662f\u4ec0\u9ebc\uff1f", "answer": "\u571f\u8033\u5176\u8df3\u68cb\u4e2d\u7684\u300e\u98db\u7fd4\u738b\u300f\u898f\u5247\u5141\u8a31\u738b\u68cb\u6cbf\u76f4\u7dda\u79fb\u52d5\u4efb\u610f\u6578\u91cf\u7684\u65b9\u683c\uff0c\u53ea\u8981\u8def\u7dda\u66a2\u901a\u3002\u6b64\u898f\u5247\u986f\u8457\u5730\u63d0\u5347\u4e86\u738b\u68cb\u7684\u5a01\u529b\u548c\u6230\u7565\u50f9\u503c\u3002\u4f8b\u5982\uff0c\u4f4d\u65bcA1\u7684\u738b\u68cb\u53ef\u4ee5\u76f4\u63a5\u79fb\u52d5\u5230H1\uff0c\u5982\u679c\u6240\u6709\u4e2d\u9593\u65b9\u683c\u90fd\u662f\u7a7a\u7684\uff0c\u5c31\u80fd\u5920\u5feb\u901f\u91cd\u65b0\u5b9a\u4f4d\u548c\u591a\u6b21\u6355\u7372\u6a5f\u6703\u3002[\u6bd4\u55bb\u8aaa\u660e]"}, {"question": "\u5982\u4f55\u5c07\u6211\u7684\u571f\u8033\u5176\u8df3\u68cb\u9032\u5ea6\u8f49\u79fb\u5230\u4e0d\u540c\u7684\u5e73\u53f0\uff1f", "answer": "\u5c07\u60a8\u7684\u571f\u8033\u5176\u8df3\u68cb\u9032\u5ea6\u8f49\u79fb\u5230\u4e0d\u540c\u7684\u5e73\u53f0\uff0c\u901a\u5e38\u9700\u8981\u5c07\u60a8\u7684\u904a\u6232\u5e33\u6236\u9023\u7d50\u5230\u901a\u7528\u6a94\u6848\uff0c\u4f8b\u5982Google Play\u6216Apple Game Center\u3002\u4f8b\u5982\uff0c\u5982\u679c\u60a8\u5728\u624b\u6a5f\u548c\u5e73\u677f\u96fb\u8166\u4e0a\u73a9\u904a\u6232\uff0c\u8acb\u78ba\u4fdd\u5169\u500b\u88dd\u7f6e\u90fd\u767b\u9304\u5230\u540c\u4e00\u500b\u5e33\u6236\uff0c\u4ee5\u540c\u6b65\u60a8\u7684\u9032\u5ea6\u3002\u67d0\u4e9b\u5e73\u53f0\u4e5f\u53ef\u80fd\u63d0\u4f9b\u624b\u52d5\u5132\u5b58/\u8f09\u5165\u9078\u9805\uff0c\u7528\u65bc\u8cc7\u6599\u9077\u79fb\u3002[\u591a\u65b9\u6848\u6bd4\u8f03]"}, {"question": "\u6211\u80fd\u5728\u571f\u8033\u5176\u8df3\u68cb\u4e2d\u767c\u73fe\u54ea\u4e9b\u96b1\u85cf\u7b56\u7565\u4f86\u7d66\u5c0d\u624b\u5e36\u4f86\u9a5a\u559c\uff1f", "answer": "\u571f\u8033\u5176\u8df3\u68cb\u4e2d\u7684\u96b1\u85cf\u7b56\u7565\u4e4b\u4e00\u662f\u300e\u72a7\u7272\u9677\u9631\u300f\uff0c\u60a8\u6545\u610f\u72a7\u7272\u4e00\u9846\u68cb\u5b50\uff0c\u8a2d\u5b9a\u4e00\u500b\u591a\u91cd\u6355\u7372\u7684\u67b6\u69cb\u3002\u4f8b\u5982\uff0c\u79fb\u52d5\u68cb\u5b50\u5230E5\u53ef\u80fd\u770b\u8d77\u4f86\u50cf\u662f\u640d\u5931\uff0c\u4f46\u5b83\u53ef\u80fd\u5728\u4e0b\u4e00\u56de\u5408\u4e2d\u5c0e\u81f4\u6355\u7372\u4e09\u500b\u5c0d\u624b\u68cb\u5b50\u3002\u6b64\u7b56\u7565\u9700\u8981\u7cbe\u78ba\u7684\u8a08\u5283\uff0c\u4e26\u53ef\u80fd\u8b93\u5c0d\u624b\u63aa\u624b\u4e0d\u53ca\uff0c\u626d\u8f49\u904a\u6232\u7684\u8da8\u52e2\u3002[\u6bd4\u55bb\u8aaa\u660e]"}]
[{"question": "\u521d\u5b66\u8005\u5982\u4f55\u8bbe\u7f6e\u571f\u8033\u5176\u8df3\u68cb\u68cb\u76d8\uff1f", "answer": "\u8981\u8bbe\u7f6e\u571f\u8033\u5176\u8df3\u68cb\u68cb\u76d8\uff0c\u4f60\u9700\u8981\u4e00\u4e2a8x8\u7684\u68cb\u76d8\u3002\u6bcf\u4e2a\u73a9\u5bb6\u5c06\u5404\u81ea\u768416\u4e2a\u68cb\u5b50\u653e\u5728\u79bb\u81ea\u5df1\u6700\u8fd1\u7684\u7b2c\u4e8c\u6392\u548c\u7b2c\u4e09\u6392\uff0c\u586b\u5145\u9ed1\u8272\u65b9\u683c\u3002\u4f8b\u5982\uff0c\u73a9\u5bb61\u5c06\u68cb\u5b50\u653e\u57281\u6392\u548c2\u6392\uff0c\u800c\u73a9\u5bb62\u5c06\u68cb\u5b50\u653e\u57287\u6392\u548c8\u6392\u3002\u8fd9\u786e\u4fdd\u4e86\u53cc\u65b9\u90fd\u4ee5\u76f8\u540c\u6570\u91cf\u7684\u68cb\u5b50\u5f00\u59cb\uff0c\u5e76\u5904\u4e8e\u6709\u5229\u7684\u6218\u7565\u4f4d\u7f6e\u3002[\u914d\u7f6e\u5bf9\u7167\u8868]"}, {"question": "\u571f\u8033\u5176\u8df3\u68cb\u7684\u57fa\u672c\u79fb\u52a8\u89c4\u5219\u662f\u4ec0\u4e48\uff1f", "answer": "\u5728\u571f\u8033\u5176\u8df3\u68cb\u4e2d\uff0c\u68cb\u5b50\u53ea\u80fd\u5411\u524d\u6216\u5411\u65c1\u8fb9\u79fb\u52a8\u5230\u76f8\u90bb\u7684\u9ed1\u8272\u65b9\u683c\uff0c\u4f46\u4e0d\u80fd\u5bf9\u89d2\u79fb\u52a8\u3002\u4f8b\u5982\uff0c\u4f4d\u4e8eD4\u7684\u68cb\u5b50\u53ef\u4ee5\u79fb\u52a8\u5230C4\u3001D5\u6216E4\uff0c\u5982\u679c\u8fd9\u4e9b\u65b9\u683c\u662f\u7a7a\u7684\u3002\u901a\u8fc7\u8df3\u8fc7\u5bf9\u624b\u7684\u68cb\u5b50\u5e76\u843d\u5230\u5176\u540e\u9762\u7684\u65b9\u683c\u4e0a\u8fdb\u884c\u6355\u83b7\u3002\u6b64\u89c4\u5219\u9002\u7528\u4e8e\u5411\u524d\u548c\u5411\u65c1\u8fb9\u79fb\u52a8\u3002[\u6bd4\u55bb\u8bf4\u660e]"}, {"question": "\u4e3a\u4ec0\u4e48\u571f\u8033\u5176\u8df3\u68cb\u7684\u68cb\u5b50\u4e0d\u80fd\u5bf9\u89d2\u79fb\u52a8\uff1f", "answer": "\u571f\u8033\u5176\u8df3\u68cb\u4e0e\u5176\u4ed6\u8df3\u68cb\u53d8\u4f53\u4e0d\u540c\u4e4b\u5904\u5728\u4e8e\uff0c\u5b83\u53ea\u5141\u8bb8\u68cb\u5b50\u5411\u524d\u548c\u5411\u65c1\u8fb9\u79fb\u52a8\uff0c\u800c\u4e0d\u80fd\u5bf9\u89d2\u79fb\u52a8\u3002\u8fd9\u6761\u72ec\u7279\u7684\u89c4\u5219\u589e\u52a0\u4e86\u7b56\u7565\u6027\uff0c\u56e0\u4e3a\u73a9\u5bb6\u5fc5\u987b\u66f4\u4ed4\u7ec6\u5730\u8ba1\u5212\u4ed6\u4eec\u7684\u8d70\u6cd5\u3002\u4f8b\u5982\uff0c\u4f4d\u4e8eE5\u7684\u68cb\u5b50\u4e0d\u80fd\u79fb\u52a8\u5230D6\u6216F6\uff0c\u5728\u5176\u4ed6\u8df3\u68cb\u6e38\u620f\u4e2d\u8fd9\u662f\u53ef\u80fd\u7684\u3002\u6b64\u9650\u5236\u9f13\u52b1\u73a9\u5bb6\u4ee5\u4e0d\u540c\u7684\u65b9\u5f0f\u601d\u8003\u68cb\u5b50\u7684\u6446\u653e\u548c\u6355\u83b7\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4]"}, {"question": "\u5728\u73a9\u4e86100\u4e2a\u5c0f\u65f6\u7684\u571f\u8033\u5176\u8df3\u68cb\u540e\uff0c\u5982\u4f55\u6539\u8fdb\u6211\u7684\u6355\u83b7\u7b56\u7565\uff1f", "answer": "\u4e3a\u4e86\u589e\u5f3a\u4f60\u5728\u571f\u8033\u5176\u8df3\u68cb\u4e2d\u7684\u6355\u83b7\u7b56\u7565\uff0c\u8bf7\u6309\u7167\u4ee5\u4e0b\u6b65\u9aa4\u64cd\u4f5c\uff1a\u6b65\u9aa41\uff1a\u59cb\u7ec8\u5bfb\u627e\u4e00\u6b21\u79fb\u52a8\u4e2d\u521b\u5efa\u591a\u6b21\u6355\u83b7\u7684\u673a\u4f1a\u3002\u6b65\u9aa42\uff1a\u5c06\u4f60\u7684\u68cb\u5b50\u6446\u653e\u5230\u63a7\u5236\u68cb\u76d8\u4e2d\u5fc3\u7684 \u4f4d\u7f6e\uff0c\u8fd9\u4f1a\u589e\u52a0\u4f60\u7684\u6355\u83b7\u673a\u4f1a\u3002\u6b65\u9aa43\uff1a\u6709\u6548\u5730\u4f7f\u7528\u4f60\u7684\u738b\u724c\u68cb\u5b50\uff0c\u5229\u7528\u5b83\u4eec\u65e2\u53ef\u4ee5\u5411\u524d\u79fb\u52a8\u53c8\u53ef\u4ee5\u5411\u540e\u79fb\u52a8\u7684\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u4f4d\u4e8eC3\u7684\u738b\u724c\u68cb\u5b50\u53ef\u4ee5\u5411\u591a\u4e2a\u65b9\u5411\u6355\u83b7\u68cb\u5b50\uff0c\u589e\u52a0\u4f60\u7684\u6218\u7565\u9009\u62e9\u3002[\u6d41\u7a0b\u56fe\u89e3]"}, {"question": "\u5728\u571f\u8033\u5176\u8df3\u68cb\u7684\u4e2d\u5c40\u4e2d\uff0c\u6211\u53ef\u4ee5\u4f7f\u7528\u54ea\u4e9b\u9ad8\u7ea7\u6218\u672f\u6765\u5360\u636e\u4f18\u52bf\uff1f", "answer": "\u5728\u571f\u8033\u5176\u8df3\u68cb\u7684\u4e2d\u5c40\u4e2d\uff0c\u8bf7\u5173\u6ce8\u4ee5\u4e0b\u7b56\u7565\uff1a\u6b65\u9aa41\uff1a\u63a7\u5236\u5173\u952e\u65b9\u683c\u4ee5\u9650\u5236\u5bf9\u624b\u7684\u79fb\u52a8\u9009\u9879\u3002\u6b65\u9aa42\uff1a\u5efa\u7acb\u5f3a\u5927\u7684\u9632\u5fa1\u7ebf\u6765\u4fdd\u62a4\u4f60\u7684\u68cb\u5b50\u5e76\u8ba1\u5212\u4f60\u7684\u4e0b\u4e00\u6b65\u52a8\u4f5c\u3002\u6b65\u9aa43\uff1a\u4f7f\u7528\u4f60\u7684\u68cb\u5b50\u521b\u5efa\u4e00\u4e2a\u201c\u6865\u6881\u201d\uff0c\u5141\u8bb8\u8fdb\u884c\u591a\u6b21\u6355\u83b7\u3002\u4f8b\u5982\uff0c\u5c06\u68cb\u5b50\u653e\u5728E4\u4e0a\u53ef\u4ee5\u963b\u6b62\u4f60\u7684\u5bf9\u624b\uff0c\u540c\u65f6\u5efa\u7acb\u5728E6\u4e0a\u8fdb\u884c\u6f5c\u5728\u6355\u83b7\u7684\u53ef\u80fd\u6027\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4]"}, {"question": "\u5728\u571f\u8033\u5176\u8df3\u68cb\u7684\u7ec8\u5c40\u4e2d\uff0c\u54ea\u4e9b\u7b56\u7565\u6700\u6709\u6548\uff1f", "answer": "\u571f\u8033\u5176\u8df3\u68cb\u7684\u6709\u6548\u7ec8\u5c40\u7b56\u7565\u5305\u62ec\uff1a\u6b65\u9aa41\uff1a\u4f18\u5148\u5c06\u4f60\u7684\u68cb\u5b50\u63d0\u5347\u4e3a\u738b\u724c\u68cb\u5b50\uff0c\u56e0\u4e3a\u5b83\u4eec\u62e5\u6709\u66f4\u5927\u7684\u673a\u52a8\u6027\u3002\u6b65\u9aa42\uff1a\u4f7f\u7528\u738b\u724c\u68cb\u5b50\u63a7\u5236\u68cb\u76d8\u5e76\u8feb\u4f7f\u4f60\u7684\u5bf9\u624b\u9677\u5165\u56f0\u5883\u3002\u6b65\u9aa43\uff1a\u8ba1\u5212\u4f60\u7684\u8d70\u6cd5\uff0c\u5236\u9020\u5bf9\u624b\u6ca1\u6709\u5408\u6cd5\u8d70\u6cd5\u7684\u5c40\u9762\u3002\u4f8b\u5982\uff0c\u4f4d\u4e8eG7\u7684\u738b\u724c\u68cb\u5b50\u53ef\u4ee5\u63a7\u5236\u6574\u4e2a\u884c\uff0c\u9650\u5236\u4f60\u7684\u5bf9\u624b\u7684\u9009\u62e9\u3002[\u6d41\u7a0b\u56fe\u89e3]"}, {"question": "\u571f\u8033\u5176\u8df3\u68cb\u4e2d\u7684\u738b\u68cb\u79fb\u52a8\u673a\u5236\u662f\u5982\u4f55\u8fd0\u4f5c\u7684\uff1f", "answer": "\u5728\u571f\u8033\u5176\u8df3\u68cb\u4e2d\uff0c\u5f53\u68cb\u5b50\u5230\u8fbe\u5bf9\u624b\u4e00\u65b9\u7684\u6700\u540e\u4e00\u884c\u65f6\uff0c\u5c31\u4f1a\u53d8\u6210\u738b\u724c\u68cb\u5b50\u3002\u738b\u724c\u68cb\u5b50\u53ef\u4ee5\u5411\u524d\u548c\u5411\u540e\u79fb\u52a8\uff0c\u4ee5\u53ca\u5411\u65c1\u8fb9\u79fb\u52a8\uff0c\u4f46\u4ecd\u7136\u4e0d\u80fd\u5bf9\u89d2\u79fb\u52a8\u3002\u4f8b\u5982\uff0c\u4f4d\u4e8eD8\u7684\u738b\u724c\u68cb\u5b50\u53ef\u4ee5\u79fb\u52a8\u5230C8\u3001D7\u6216E8\uff0c\u63d0\u4f9b\u66f4\u5927\u7684\u7075\u6d3b\u6027\u53ca\u6218\u7565\u9009\u62e9\u3002\u8be5\u673a\u5236\u80fd\u591f\u5b9e\u73b0\u66f4\u5177\u52a8\u6001\u6027\u7684\u6e38\u620f\u548c\u66f4\u590d\u6742\u7684\u7b56\u7565\u3002[\u914d\u7f6e\u5bf9\u7167\u8868]"}, {"question": "\u571f\u8033\u5176\u8df3\u68cb\u4e2d\"\u98de\u738b\"\u89c4\u5219\u7684\u610f\u4e49\u662f\u4ec0\u4e48\uff1f", "answer": "\u571f\u8033\u5176\u8df3\u68cb\u4e2d\u7684\"\u98de\u738b\"\u89c4\u5219\u5141\u8bb8\u738b\u724c\u68cb\u5b50\u6cbf\u76f4\u7ebf\u79fb\u52a8\u4efb\u610f\u6570\u91cf\u7684\u65b9\u683c\uff0c\u524d\u63d0\u662f\u8def\u5f84\u7545\u901a\u3002\u8fd9\u6761\u89c4\u5219\u663e\u8457\u589e\u5f3a\u4e86\u738b\u724c\u68cb\u5b50\u7684\u529b\u91cf\u548c\u6218\u7565\u4ef7\u503c\u3002\u4f8b\u5982\uff0c\u4f4d\u4e8eA1\u7684\u738b\u724c\u68cb\u5b50\u53ef\u4ee5\u76f4\u63a5\u79fb\u52a8\u5230H1\uff0c\u5982\u679c\u6240\u6709\u4e2d\u95f4\u65b9\u683c\u90fd\u662f\u7a7a\u7684\uff0c\u5219\u80fd\u591f\u5feb\u901f\u91cd\u65b0\u5b9a\u4f4d\u5e76\u8fdb\u884c\u591a\u6b21\u6355\u83b7\u673a\u4f1a\u3002[\u6bd4\u55bb\u8bf4\u660e]"}, {"question": "\u5982\u4f55\u5c06\u6211\u7684\u571f\u8033\u5176\u8df3\u68cb\u8fdb\u5ea6\u5728\u4e0d\u540c\u7684\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\uff1f", "answer": "\u5728\u4e0d\u540c\u5e73\u53f0\u4e4b\u95f4\u8f6c\u79fb\u4f60\u7684\u571f\u8033\u5176\u8df3\u68cb\u8fdb\u5ea6\u901a\u5e38\u6d89\u53ca\u5c06\u4f60\u7684\u6e38\u620f\u8d26\u6237\u94fe\u63a5\u5230\u901a\u7528\u4e2a\u4eba\u8d44\u6599\uff0c\u4f8b\u5982 Google Play \u6216 Apple \u6e38\u620f\u4e2d\u5fc3\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u79fb\u52a8\u8bbe\u5907\u548c\u4e2a\u4eba\u7535\u8111\u4e0a\u90fd\u73a9\u6e38\u620f\uff0c\u8bf7\u786e\u4fdd\u4e24\u4e2a\u8bbe\u5907\u90fd\u767b\u5f55\u5230\u540c\u4e00\u4e2a\u5e10\u6237\u4ee5\u540c\u6b65\u4f60\u7684\u8fdb\u5ea6\u3002\u67d0\u4e9b\u5e73\u53f0\u4e5f\u53ef\u80fd\u63d0\u4f9b\u624b\u52a8\u4fdd\u5b58/\u52a0\u8f7d\u9009\u9879\u4ee5\u8fdb\u884c\u6570\u636e\u8fc1\u79fb\u3002[\u591a\u65b9\u6848\u5bf9\u6bd4]"}, {"question": "\u4e3a\u4e86\u7ed9\u5bf9\u624b\u5e26\u6765\u60ca\u559c\uff0c\u5728\u571f\u8033\u5176\u8df3\u68cb\u4e2d\uff0c\u6211\u6709\u4ec0\u4e48\u9690\u85cf\u7684\u7b56\u7565\u53ef\u4ee5\u53d1\u73b0\uff1f", "answer": "\u571f\u8033\u5176\u8df3\u68cb\u4e2d\u4e00\u4e2a\u9690\u85cf\u7684\u7b56\u7565\u662f\u201c\u727a\u7272\u9677\u9631\u201d\uff0c\u5373\u6545\u610f\u727a\u7272\u4e00\u679a\u68cb\u5b50\u6765\u8bbe\u7f6e\u591a\u6b21\u6355\u83b7\u3002\u4f8b\u5982\uff0c\u5c06\u4e00\u679a\u68cb\u5b50\u79fb\u52a8\u5230E5\u53ef\u80fd\u770b\u8d77\u6765\u50cf\u662f\u4e00\u79cd\u635f\u5931\uff0c\u4f46\u8fd9\u53ef\u80fd\u4f1a\u5bfc\u81f4\u4e0b\u4e00\u6b21\u79fb\u52a8\u6355\u83b7\u4e09\u4e2a\u5bf9\u624b\u68cb\u5b50\u3002\u8fd9\u79cd\u7b56\u7565\u9700\u8981\u7cbe\u786e\u7684\u8ba1\u5212\uff0c\u5e76\u4e14\u53ef\u4ee5\u51fa\u5176\u4e0d\u610f\u5730\u6293\u4f4f\u5bf9\u624b\uff0c\u626d\u8f6c\u6bd4\u8d5b\u5c40\u52bf\u3002[\u6bd4\u55bb\u8bf4\u660e]"}]
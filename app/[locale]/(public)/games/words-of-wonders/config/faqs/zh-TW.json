[{"question": "\u5982\u4f55\u8b93\u65b0\u73a9\u5bb6\u5feb\u901f\u5b78\u7fd2\u300a\u6587\u5b57\u5947\u8e5f\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff1f", "answer": "\u8981\u5feb\u901f\u5b78\u7fd2\u300a\u6587\u5b57\u5947\u8e5f\u300b\u7684\u57fa\u672c\u64cd\u4f5c\uff0c\u8acb\u9075\u5faa\u4ee5\u4e0b\u6b65\u9a5f\uff1a**\u6b65\u9a5f1** - \u5f9e\u6559\u5b78\u958b\u59cb\uff0c\u5b83\u6703\u4ecb\u7d39\u6838\u5fc3\u6a5f\u5236\uff0c\u4f8b\u5982\u7528\u6ed1\u52d5\u4f86\u9023\u63a5\u5b57\u6bcd\u3002**\u6b65\u9a5f2** - \u5728\u65e9\u671f\u95dc\u5361\u7df4\u7fd2\u7d44\u6210\u7c21\u55ae\u7684\u8a5e\u5f59\uff0c\u4f8b\u5982\u300e\u8c93\u300f\u6216\u300e\u72d7\u300f\uff0c\u4ee5\u719f\u6089\u4ecb\u9762\u3002**\u6b65\u9a5f3** - \u8b39\u614e\u4f7f\u7528\u63d0\u793a\u7cfb\u7d71\uff0c\u4f86\u4e86\u89e3\u904a\u6232\u5982\u4f55\u5efa\u8b70\u53ef\u80fd\u7684\u55ae\u5b57\u3002\u4f8b\u5982\uff0c\u5728\u95dc\u5361 1\uff0c\u904a\u6232\u53ef\u80fd\u6703\u63d0\u793a\u300e\u8759\u8760\u300f\u9019\u500b\u5b57\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u6559\u5b78\u60f3\u6210\u4e00\u5f35\u5730\u5716\uff0c\u5f15\u5c0e\u4f60\u7a7f\u8d8a\u904a\u6232\u7684\u5730\u5f62\u3002]"}, {"question": "\u70ba\u4ec0\u9ebc\u5728\u300a\u6587\u5b57\u5947\u8e5f\u300b\u4e2d\u7b56\u7565\u6027\u5730\u4f7f\u7528\u5f37\u529b\u9053\u5177\u5f88\u91cd\u8981\uff1f", "answer": "\u5728\u300a\u6587\u5b57\u5947\u8e5f\u300b\u4e2d\u7b56\u7565\u6027\u5730\u4f7f\u7528\u5f37\u529b\u9053\u5177\u81f3\u95dc\u91cd\u8981\uff0c\u56e0\u70ba\u5b83\u5011\u53ef\u4ee5\u986f\u8457\u63d0\u5347\u4f60\u7684\u9032\u5ea6\u3002**\u6b65\u9a5f1** - \u5c07\u50cf\u662f\u300e\u91cd\u65b0\u6d17\u724c\u300f\u7684\u5f37\u529b\u9053\u5177\u5132\u5b58\u8d77\u4f86\uff0c\u7528\u65bc\u4f60\u5361\u95dc\u3001\u9762\u5c0d\u56f0\u96e3\u5b57\u6bcd\u7d44\u5408\u7684\u95dc\u5361\u3002**\u6b65\u9a5f2** - \u5728\u5feb\u8981\u5b8c\u6210\u95dc\u5361\u4f46\u9700\u8981\u6700\u5f8c\u4e00\u500b\u55ae\u5b57\u6642\uff0c\u4f7f\u7528\u300e\u986f\u793a\u55ae\u5b57\u300f\u5f37\u529b\u9053\u5177\u3002**\u6b65\u9a5f3** - \u70ba\u4e86\u9054\u5230\u6700\u5927\u6548\u679c\uff0c\u7d44\u5408\u4f7f\u7528\u5f37\u529b\u9053\u5177\uff1b\u4f8b\u5982\uff0c\u4f7f\u7528\u300e\u91cd\u65b0\u6d17\u724c\u300f\u63a5\u8457\u300e\u986f\u793a\u55ae\u5b57\u300f\u53ef\u4ee5\u5feb\u901f\u89e3\u6c7a\u8907\u96dc\u7684\u8b0e\u984c\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u96d6\u7136\u6709\u4e9b\u73a9\u5bb6\u559c\u6b61\u63d0\u524d\u4f7f\u7528\u5f37\u529b\u9053\u5177\uff0c\u4f46\u5c07\u5b83\u5011\u5132\u5b58\u8d77\u4f86\u7528\u65bc\u66f4\u96e3\u7684\u95dc\u5361\u901a\u5e38\u6703\u5e36\u4f86\u66f4\u597d\u7684\u7d50\u679c\u3002]"}, {"question": "\u300a\u6587\u5b57\u5947\u8e5f\u300b\u4e2d\u7684\u6bcf\u65e5\u6311\u6230\u548c\u666e\u901a\u95dc\u5361\u4e4b\u9593\u6709\u4ec0\u9ebc\u4e3b\u8981\u5dee\u7570\uff1f", "answer": "\u300a\u6587\u5b57\u5947\u8e5f\u300b\u4e2d\u7684\u6bcf\u65e5\u6311\u6230\u548c\u666e\u901a\u95dc\u5361\u4e4b\u9593\u7684\u95dc\u9375\u5dee\u7570\u662f\uff1a**1** - \u6bcf\u65e5\u6311\u6230\u63d0\u4f9b\u7368\u7279\u7684\u734e\u52f5\uff0c\u5982\u786c\u5e63\u548c\u5f37\u529b\u9053\u5177\uff0c\u800c\u666e\u901a\u95dc\u5361\u5247\u63d0\u4f9b\u661f\u661f\u548c\u9032\u5ea6\u3002**2** - \u6bcf\u65e5\u6311\u6230\u6642\u9593\u6709\u9650\uff0c\u9f13\u52f5\u73a9\u5bb6\u6bcf\u5929\u56de\u6b78\u904a\u6232\uff0c\u800c\u666e\u901a\u95dc\u5361\u5247\u53ef\u4ee5\u5728\u4efb\u4f55\u6642\u9593\u904a\u73a9\u3002**3** - \u6bcf\u65e5\u6311\u6230\u7684\u96e3\u5ea6\u901a\u5e38\u8f03\u9ad8\uff0c\u65e8\u5728\u6e2c\u8a66\u4f60\u5728\u58d3\u529b\u4e0b\u62fc\u5b57\u7684\u80fd\u529b\u3002\u4f8b\u5982\uff0c\u6bcf\u65e5\u6311\u6230\u53ef\u80fd\u9700\u8981\u5728 3 \u5206\u9418\u5167\u7d44\u6210 10 \u500b\u55ae\u5b57\uff0c\u800c\u666e\u901a\u95dc\u5361\u5247\u53ef\u80fd\u5141\u8a31\u7121\u9650\u6642\u9593\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u6bcf\u65e5\u6311\u6230\u8207\u666e\u901a\u95dc\u5361 | \u734e\u52f5: \u786c\u5e63\u8207\u661f\u661f | \u6642\u9593\u9650\u5236: \u662f\u8207\u5426 | \u96e3\u6613\u5ea6: \u9ad8\u8207\u53ef\u8b8a]"}, {"question": "\u300a\u6587\u5b57\u5947\u8e5f\u300b\u7684\u8a08\u5206\u7cfb\u7d71\u662f\u5982\u4f55\u904b\u4f5c\u7684\uff0c\u4ee5\u53ca\u54ea\u4e9b\u56e0\u7d20\u6703\u5f71\u97ff\u5b83\uff1f", "answer": "\u300a\u6587\u5b57\u5947\u8e5f\u300b\u7684\u8a08\u5206\u7cfb\u7d71\u53d7\u5e7e\u500b\u56e0\u7d20\u5f71\u97ff\uff1a**1** - \u55ae\u5b57\u9577\u5ea6\uff1a\u55ae\u5b57\u8d8a\u9577\uff0c\u5f97\u5206\u8d8a\u9ad8\u3002\u4f8b\u5982\uff0c\u300e\u5927\u8c61\u300f\u7684\u5f97\u5206\u9ad8\u65bc\u300e\u8c93\u300f\u3002**2** - \u5b57\u6bcd\u7a00\u6709\u5ea6\uff1a\u4f7f\u7528\u4e0d\u592a\u5e38\u898b\u7684\u5b57\u6bcd\uff0c\u4f8b\u5982\u300eQ\u300f\u6216\u300eZ\u300f\uff0c\u6703\u589e\u52a0\u4f60\u7684\u5f97\u5206\u3002**3** - \u734e\u52f5\u78c1\u78da\uff1a\u843d\u5728\u734e\u52f5\u78c1\u78da\u4e0a\uff0c\u4f8b\u5982\u96d9\u500d\u6216\u4e09\u500d\u5b57\u6bcd\u5f97\u5206\uff0c\u6703\u5c07\u4f60\u7684\u5206\u6578\u4e58\u4ee5\u500d\u6578\u3002**\u6b65\u9a5f1** - \u76e1\u53ef\u80fd\u5f62\u6210\u6700\u9577\u7684\u55ae\u5b57\u3002**\u6b65\u9a5f2** - \u5728\u6709\u7a7a\u7684\u6642\u5019\uff0c\u512a\u5148\u4f7f\u7528\u7a00\u6709\u5b57\u6bcd\u3002**\u6b65\u9a5f3** - \u7b56\u7565\u6027\u5730\u9396\u5b9a\u734e\u52f5\u78c1\u78da\u4f86\u6700\u5927\u5316\u4f60\u7684\u5f97\u5206\u3002[\u6d41\u7a0b\u5716\u89e3: \u55ae\u5b57\u7d44\u6210 \u2192 \u5b57\u6bcd\u7a00\u6709\u5ea6\u6aa2\u67e5 \u2192 \u734e\u52f5\u78c1\u78da\u555f\u7528 \u2192 \u6700\u7d42\u5f97\u5206\u8a08\u7b97]"}, {"question": "\u54ea\u4e9b\u7b56\u7565\u53ef\u4ee5\u5e6b\u52a9\u9ad8\u7d1a\u73a9\u5bb6\u6700\u5927\u5316\u4ed6\u5011\u5728\u300a\u6587\u5b57\u5947\u8e5f\u300b\u4e2d\u7684\u6548\u7387\uff1f", "answer": "\u9ad8\u7d1a\u73a9\u5bb6\u53ef\u4ee5\u900f\u904e\u4ee5\u4e0b\u65b9\u5f0f\u6700\u5927\u5316\u5728\u300a\u6587\u5b57\u5947\u8e5f\u300b\u4e2d\u7684\u6548\u7387\uff1a**\u6b65\u9a5f1** - \u8a18\u4f4f\u5e38\u898b\u7684\u55ae\u5b57\u6a21\u5f0f\u548c\u5b57\u9996/\u5b57\u5c3e\uff0c\u4f8b\u5982\u300e\u672a-\u300f\u6216\u300e-ING\u300f\uff0c\u4ee5\u5feb\u901f\u7d44\u6210\u55ae\u5b57\u3002**\u6b65\u9a5f2** - \u5229\u7528\u300e\u91cd\u65b0\u6d17\u724c\u300f\u5f37\u529b\u9053\u5177\u4f86\u91cd\u65b0\u6392\u5217\u5b57\u6bcd\uff0c\u66f4\u5bb9\u6613\u627e\u5230\u96b1\u85cf\u7684\u55ae\u5b57\u3002**\u6b65\u9a5f3** - \u5728\u884c\u52d5\u524d\u5148\u6383\u63cf\u68cb\u76e4\uff0c\u5c0b\u627e\u6f5b\u5728\u7684\u55ae\u5b57\u7d44\u5408\u3002\u4f8b\u5982\uff0c\u5728\u95dc\u5361 50 \u4e2d\uff0c\u63d0\u524d\u627e\u5230\u300e\u7b56\u7565\u300f\u9019\u500b\u5b57\u53ef\u4ee5\u7701\u4e0b\u6642\u9593\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u904a\u6232\u68cb\u76e4\u60f3\u50cf\u6210\u68cb\u76e4\uff0c\u63d0\u524d\u898f\u5283\u662f\u7372\u52dd\u7684\u95dc\u9375\u3002]"}, {"question": "\u5728\u300a\u6587\u5b57\u5947\u8e5f\u300b\u4e2d\u6709\u6548\u7ba1\u7406\u904a\u6232\u5167\u8ca8\u5e63\u7684\u6700\u4f73\u505a\u6cd5\u662f\u4ec0\u9ebc\uff1f", "answer": "\u5728\u300a\u6587\u5b57\u5947\u8e5f\u300b\u4e2d\u6709\u6548\u7ba1\u7406\u904a\u6232\u5167\u8ca8\u5e63\u7684\u65b9\u6cd5\u5305\u62ec\uff1a**\u6b65\u9a5f1** - \u512a\u5148\u4f7f\u7528\u786c\u5e63\u8cfc\u8cb7\u5fc5\u8981\u7684\u5f37\u529b\u9053\u5177\uff0c\u4f8b\u5982\u300e\u91cd\u65b0\u6d17\u724c\u300f\u548c\u300e\u986f\u793a\u55ae\u5b57\u300f\u3002**\u6b65\u9a5f2** - \u5728\u62e5\u6709\u8212\u9002\u7684\u786c\u5e63\u5132\u5099\u4e4b\u524d\uff0c\u907f\u514d\u4e0d\u5fc5\u8981\u7684\u8cfc\u8cb7\uff0c\u4f8b\u5982\u5316\u599d\u54c1\u9805\u76ee\u3002**\u6b65\u9a5f3** - \u5b8c\u6210\u6bcf\u65e5\u6311\u6230\u4e26\u89c0\u770b\u5ee3\u544a\u4ee5\u7372\u5f97\u514d\u8cbb\u786c\u5e63\uff0c\u5728\u4e0d\u82b1\u771f\u9322\u7684\u60c5\u6cc1\u4e0b\uff0c\u7d2f\u7a4d\u4f60\u7684\u8ca8\u5e63\u3002\u4f8b\u5982\uff0c\u5b8c\u6210\u6bcf\u65e5\u6311\u6230\u53ef\u80fd\u6703\u734e\u52f5\u4f60 50 \u679a\u786c\u5e63\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u96d6\u7136\u6709\u4e9b\u73a9\u5bb6\u6703\u7acb\u5373\u82b1\u8cbb\u786c\u5e63\uff0c\u4f46\u5c07\u5b83\u5011\u5132\u5b58\u8d77\u4f86\u7528\u65bc\u66f4\u96e3\u7684\u95dc\u5361\u901a\u5e38\u6703\u5e36\u4f86\u66f4\u597d\u7684\u7d50\u679c\u3002]"}, {"question": "\u300a\u6587\u5b57\u5947\u8e5f\u300b\u4e2d\u7684\u95dc\u5361\u9032\u5ea6\u7cfb\u7d71\u5982\u4f55\u78ba\u4fdd\u5e73\u8861\u7684\u96e3\u5ea6\u66f2\u7dda\uff1f", "answer": "\u300a\u6587\u5b57\u5947\u8e5f\u300b\u4e2d\u7684\u95dc\u5361\u9032\u5ea6\u7cfb\u7d71\u900f\u904e\u4ee5\u4e0b\u65b9\u5f0f\u78ba\u4fdd\u5e73\u8861\u7684\u96e3\u5ea6\u66f2\u7dda\uff1a**1** - \u9010\u6f38\u5f15\u5165\u65b0\u7684\u5b57\u6bcd\u7d44\u5408\u548c\u55ae\u5b57\u9577\u5ea6\u3002**2** - \u5728\u66f4\u9ad8\u95dc\u5361\u4e2d\u52a0\u5165\u734e\u52f5\u78c1\u78da\u548c\u969c\u7919\u7269\u4f86\u589e\u52a0\u8907\u96dc\u6027\u3002**3** - \u6839\u64da\u73a9\u5bb6\u7684\u8868\u73fe\u8abf\u6574\u8a08\u5206\u9700\u6c42\u3002\u4f8b\u5982\uff0c\u95dc\u5361 10 \u53ef\u80fd\u9700\u8981\u7d44\u6210 15 \u500b\u55ae\u5b57\uff0c\u800c\u95dc\u5361 20 \u5247\u9700\u8981\u7d44\u6210 20 \u500b\u66f4\u9577\u7684\u55ae\u5b57\u3002[\u914d\u7f6e\u5c0d\u7167\u8868: \u95dc\u5361 1 \u8207\u95dc\u5361 20 | \u55ae\u5b57\u9577\u5ea6: \u77ed\u8207\u9577 | \u734e\u52f5\u78c1\u78da: \u7121\u8207\u591a | \u8a08\u5206\u8981\u6c42: \u4f4e\u8207\u9ad8]"}, {"question": "\u5728\u591a\u500b\u88dd\u7f6e\u4e0a\u904a\u73a9\u300a\u6587\u5b57\u5947\u8e5f\u300b\u9700\u8981\u54ea\u4e9b\u6280\u8853\u8981\u6c42\uff1f", "answer": "\u5728\u591a\u500b\u88dd\u7f6e\u4e0a\u904a\u73a9\u300a\u6587\u5b57\u5947\u8e5f\u300b\u9700\u8981\uff1a**1** - \u7a69\u5b9a\u7684\u7db2\u8def\u9023\u7dda\u4f86\u540c\u6b65\u8de8\u88dd\u7f6e\u7684\u9032\u5ea6\u3002**2** - \u5728\u6240\u6709\u88dd\u7f6e\u4e0a\u5b89\u88dd\u904a\u6232\uff0c\u53ef\u5728 iOS \u548c Android \u5e73\u53f0\u4f7f\u7528\u3002**3** - \u767b\u5165\u6bcf\u500b\u88dd\u7f6e\u4e0a\u7684\u540c\u4e00\u5e33\u6236\uff0c\u4ee5\u78ba\u4fdd\u8cc7\u6599\u4e00\u81f4\u6027\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u624b\u6a5f\u4e0a\u958b\u59cb\u4e00\u500b\u95dc\u5361\uff0c\u53ef\u4ee5\u5728\u5e73\u677f\u96fb\u8166\u4e0a\u7e7c\u7e8c\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u4f60\u7684\u904a\u6232\u9032\u5ea6\u60f3\u50cf\u6210\u96f2\u7aef\u6587\u4ef6\uff0c\u53ef\u5f9e\u4efb\u4f55\u5177\u6709\u6b63\u78ba\u767b\u5165\u8cc7\u8a0a\u7684\u88dd\u7f6e\u5b58\u53d6\u3002]"}, {"question": "\u73a9\u5bb6\u5982\u4f55\u5728\u300a\u6587\u5b57\u5947\u8e5f\u300b\u4e2d\u767c\u73fe\u96b1\u85cf\u7684\u5f69\u86cb\u6216\u79d8\u5bc6\u5167\u5bb9\uff1f", "answer": "\u73a9\u5bb6\u53ef\u4ee5\u900f\u904e\u4ee5\u4e0b\u65b9\u5f0f\u5728\u300a\u6587\u5b57\u5947\u8e5f\u300b\u4e2d\u767c\u73fe\u96b1\u85cf\u7684\u5f69\u86cb\u6216\u79d8\u5bc6\u5167\u5bb9\uff1a**\u6b65\u9a5f1** - \u63a2\u7d22\u4e0d\u986f\u773c\u7684\u55ae\u5b57\u7d44\u5408\uff0c\u4f8b\u5982\u5728\u55ae\u500b\u55ae\u5b57\u4e2d\u4f7f\u7528\u6240\u6709\u6bcd\u97f3\u3002**\u6b65\u9a5f2** - \u6ce8\u610f\u95dc\u5361\u7684\u4e3b\u984c\u548c\u63d0\u793a\uff0c\u9019\u4e9b\u63d0\u793a\u53ef\u80fd\u6697\u793a\u96b1\u85cf\u7684\u55ae\u5b57\u3002**\u6b65\u9a5f3** - \u8207\u793e\u7fa4\u4e92\u52d5\uff0c\u5206\u4eab\u548c\u767c\u73fe\u79d8\u5bc6\u3002\u4f8b\u5982\uff0c\u5728\u4ee5\u81ea\u7136\u70ba\u4e3b\u984c\u7684\u95dc\u5361\u4e2d\uff0c\u5f62\u6210\u300e\u5f69\u8679\u300f\u9019\u500b\u5b57\u53ef\u80fd\u6703\u89f8\u767c\u7279\u6b8a\u52d5\u756b\u3002[\u6bd4\u55bb\u8aaa\u660e: \u5c07\u5f69\u86cb\u60f3\u50cf\u6210\u57cb\u85cf\u7684\u5bf6\u85cf\uff0c\u9700\u8981\u8010\u5fc3\u548c\u5275\u9020\u529b\u624d\u80fd\u767c\u73fe\u3002]"}, {"question": "\u5728\u300a\u6587\u5b57\u5947\u8e5f\u300b\u4e2d\u5982\u4f55\u6709\u6548\u5730\u5f9e\u9023\u7e8c\u5931\u6557\u4e2d\u6062\u5fa9\uff1f", "answer": "\u5728\u300a\u6587\u5b57\u5947\u8e5f\u300b\u4e2d\u5f9e\u9023\u7e8c\u5931\u6557\u4e2d\u6062\u5fa9\u7684\u65b9\u6cd5\uff1a**\u6b65\u9a5f1** - \u4f11\u606f\u4e00\u4e0b\uff0c\u653e\u7a7a\u4f60\u7684\u982d\u8166\uff0c\u4ee5\u5168\u65b0\u7684\u89c0\u9ede\u56de\u6b78\u904a\u6232\u3002**\u6b65\u9a5f2** - \u56de\u9867\u904e\u53bb\u7684\u95dc\u5361\uff0c\u627e\u51fa\u4f60\u55ae\u5b57\u9078\u64c7\u7684\u6a21\u5f0f\u6216\u932f\u8aa4\u3002**\u6b65\u9a5f3** - \u7b56\u7565\u6027\u5730\u4f7f\u7528\u5f37\u529b\u9053\u5177\u4f86\u514b\u670d\u56f0\u96e3\u7684\u95dc\u5361\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4f60\u5728\u95dc\u5361 25 \u5361\u95dc\uff0c\u4f7f\u7528\u300e\u91cd\u65b0\u6d17\u724c\u300f\u5f37\u529b\u9053\u5177\u53ef\u80fd\u6703\u63ed\u793a\u4e00\u500b\u96b1\u85cf\u7684\u55ae\u5b57\uff0c\u4f8b\u5982\u300e\u6e2c\u9a57\u300f\u3002[\u591a\u65b9\u6848\u5c0d\u6bd4: \u96d6\u7136\u6709\u4e9b\u73a9\u5bb6\u559c\u6b61\u5805\u6301\u4e0b\u53bb\uff0c\u4f46\u4f11\u606f\u4e00\u4e0b\u901a\u5e38\u6703\u5e36\u4f86\u66f4\u597d\u7684\u7d50\u679c\u3002]"}]